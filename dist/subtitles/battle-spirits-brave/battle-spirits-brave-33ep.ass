Dialogue: 0,0:00:40.79,0:00:45.80,Default,,0,0,0,,♪♪『ｆｒｅｅ』
Dialogue: 0,0:00:45.80,0:00:51.79,Default,,0,0,0,,♪♪～
Dialogue: 0,0:00:51.79,0:01:02.80,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:02.80,0:01:11.79,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:11.79,0:01:30.79,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:30.79,0:01:40.79,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:40.79,0:01:56.79,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:56.79,0:02:05.79,Default,,0,0,0,,♪♪～
Dialogue: 0,0:03:23.79,0:03:26.81,Default,,0,0,0,,≪(Золдер) Дэн Умагами Тыңдап жатырсыз ба?
Dialogue: 0,0:03:26.81,0:03:30.80,Default,,0,0,0,,Уф... А, мен тыңдап тұрмын, Зольдер.
Dialogue: 0,0:03:30.80,0:03:34.80,Default,,0,0,0,,Қазір дайындал, Эй! Бұл шайқас!
Dialogue: 0,0:03:41.79,0:03:44.80,Default,,0,0,0,,<«Әдемі София» және «Рухани жүзбасы» →
Dialogue: 0,0:03:44.80,0:03:48.80,Default,,0,0,0,,Мен жын патшайыммен кездесу үшін Октоға бара жатыр едім>
Dialogue: 0,0:03:52.80,0:03:57.79,Default,,0,0,0,,<“Зак”, кезінде Барон басқарған Рим азаматы>
Dialogue: 0,0:03:57.79,0:03:59.79,Default,,0,0,0,,<Оған жұмбақ адам сеніп тапсырған→
Dialogue: 0,0:03:59.79,0:04:04.80,Default,,0,0,0,,Баронға «Қасиетті жарық қылыш» картасын беру үшін Римнен қашу→
Dialogue: 0,0:04:04.80,0:04:09.79,Default,,0,0,0,,Енді мен осы «рухты жүзбасымын» >
Dialogue: 0,0:04:09.79,0:04:11.79,Default,,0,0,0,,≪(Золдер) Сіз де дайындалыңыз! Ах!
Dialogue: 0,0:04:11.79,0:04:14.79,Default,,0,0,0,,Мен ешқашан ұрысамын деп айтқан емеспін.
Dialogue: 0,0:04:14.79,0:04:18.80,Default,,0,0,0,,Түсіндім, сен Умашин Данды жеңе алатыныңа сенімді емессің...
Dialogue: 0,0:04:18.80,0:04:24.80,Default,,0,0,0,,Жоқ! Мен де карт бальгермін, майданнан қашпаймын! Тек...
Dialogue: 0,0:04:24.80,0:04:28.79,Default,,0,0,0,,≪(Золдер) Мен сенің Дэнге ренжігеніңді жақсы білемін.
Dialogue: 0,0:04:28.79,0:04:32.79,Default,,0,0,0,,Ондай жағдайда оны шайқаста талқандаңыз!
Dialogue: 0,0:04:32.79,0:04:34.80,Default,,0,0,0,,≪(Барон) Егер бұл карта жауынгері болса... Ах!
Dialogue: 0,0:04:34.80,0:04:36.80,Default,,0,0,0,,Шайқастағы қарсыласыңызды біліңіз
Dialogue: 0,0:04:36.80,0:04:44.79,Default,,0,0,0,,«Картаның қозғалысы» және «стратегия»... Сол жерден қарсыласыңыздың шынайы болмысын түсініңіз.
Dialogue: 0,0:04:44.79,0:04:47.79,Default,,0,0,0,,Барон мырза...
Dialogue: 0,0:04:47.79,0:04:52.80,Default,,0,0,0,,《Барон-сама жылқы құдайы Данның әділдігін мақұлдайды...》
Dialogue: 0,0:04:52.80,0:04:55.80,Default,,0,0,0,,《Мен оны өз көзіммен көремін》
Dialogue: 0,0:04:55.80,0:04:57.80,Default,,0,0,0,,Негізгі оқтар туралы не деуге болады?
Dialogue: 0,0:04:57.80,0:05:00.79,Default,,0,0,0,,Иә! кел!
Dialogue: 0,0:05:00.79,0:05:06.79,Default,,0,0,0,,♪♪～
Dialogue: 0,0:05:06.79,0:05:10.80,Default,,0,0,0,,≪(Clacky) Хмм... Зак па?
Dialogue: 0,0:05:10.80,0:05:14.80,Default,,0,0,0,,Ол Дэнді жек көретіні анық.
Dialogue: 0,0:05:14.80,0:05:18.79,Default,,0,0,0,,Дұрыс! Жаса! Мұны істеу керек, Жастар!
Dialogue: 0,0:05:18.79,0:05:21.81,Default,,0,0,0,,Жоқ... бұл не? Біз де соғысамыз ба?
Dialogue: 0,0:05:21.81,0:05:25.80,Default,,0,0,0,,Жоқ! Бұл күндері жастар күшейіп келеді!
Dialogue: 0,0:05:25.80,0:05:29.80,Default,,0,0,0,,Егер Зольдер: «Шайқасайық» десе, бұл бірдеңені білдіруі керек.
Dialogue: 0,0:05:29.80,0:05:31.82,Default,,0,0,0,,Оны тоқтатудың қажеті жоқ.
Dialogue: 0,0:05:31.82,0:05:34.79,Default,,0,0,0,,Кейде бір-бірімізді тек шайқас арқылы ғана түсіне аламыз.
Dialogue: 0,0:05:34.79,0:05:37.79,Default,,0,0,0,,≪(Қоңырау үні) Ах! Дан
Dialogue: 0,0:05:37.79,0:05:39.79,Default,,0,0,0,,Бір минут күтіңіз! Иә?
Dialogue: 0,0:05:39.79,0:05:42.80,Default,,0,0,0,,Мен Бароннан хабарлама алдым.
Dialogue: 0,0:05:42.80,0:05:44.80,Default,,0,0,0,,Барон?
Dialogue: 0,0:05:47.80,0:05:50.80,Default,,0,0,0,,Рух! Бар!
Dialogue: 0,0:05:53.79,0:05:57.79,Default,,0,0,0,,Қақпа ашық! Трансляция!
Dialogue: 0,0:05:57.79,0:06:14.80,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:14.80,0:06:30.79,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:30.79,0:06:35.80,Default,,0,0,0,,Мен Умагами Данның қандай адам екенін білу үшін келдім.
Dialogue: 0,0:06:35.80,0:06:40.79,Default,,0,0,0,,Олай болса, сенің де қандай адам екеніңді көрсетемін!
Dialogue: 0,0:06:40.79,0:06:43.79,Default,,0,0,0,,Қадамды бастаңыз! Қадам сызыңыз!
Dialogue: 0,0:06:43.79,0:06:47.79,Default,,0,0,0,,Негізгі қадам! Игуа Баггиді 2-деңгейге шақырыңыз!
Dialogue: 0,0:06:49.80,0:06:51.80,Default,,0,0,0,,Кезеңнің соңы!
Dialogue: 0,0:06:53.80,0:06:57.79,Default,,0,0,0,,Бароне-саманың соққысы Зигвурмді жеңген сіз болсаңыз→
Dialogue: 0,0:06:57.79,0:07:01.79,Default,,0,0,0,,Мен бұл жындарға қарсы күресетін адамдардың үміті деп ойладым.
Dialogue: 0,0:07:01.79,0:07:03.79,Default,,0,0,0,,Мен жалғыз емеспін!
Dialogue: 0,0:07:03.79,0:07:09.80,Default,,0,0,0,,Барлық адамдар саған үміт артады!
Dialogue: 0,0:07:09.80,0:07:11.80,Default,,0,0,0,,Сіз тағы да өзімшіл бірдеңе айтып отырсыз.
Dialogue: 0,0:07:11.80,0:07:16.80,Default,,0,0,0,,Жоқ...бірақ көбісі шынымен солай ойлайтын шығар.
Dialogue: 0,0:07:18.79,0:07:23.80,Default,,0,0,0,,Солай болуы мүмкін, бірақ жындар патшайымымен қол ұстасу...
Dialogue: 0,0:07:23.80,0:07:25.80,Default,,0,0,0,,Негізгі қадам!
Dialogue: 0,0:07:25.80,0:07:29.80,Default,,0,0,0,,«Бүргіленген кесіртке», «Кесіртке жиегі» және екі «Дино Никсав»!
Dialogue: 0,0:07:29.80,0:07:32.80,Default,,0,0,0,,«Рейндлді» шақырыңыз!
Dialogue: 0,0:07:35.79,0:07:37.79,Default,,0,0,0,,(үру)
Dialogue: 0,0:07:37.79,0:07:42.80,Default,,0,0,0,,Үміт көрсеткенде, көңіліміз қалай қалғанын білесіз бе?
Dialogue: 0,0:07:42.80,0:07:47.79,Default,,0,0,0,,Шабуыл қадамы! Frilled Lizard көмегімен шабуыл жасаңыз!
Dialogue: 0,0:07:47.79,0:07:49.79,Default,,0,0,0,,Өмірмен бірге қабылдаңыз!
Dialogue: 0,0:07:53.79,0:07:56.80,Default,,0,0,0,,Бұл дәуірге не үшін келдің?
Dialogue: 0,0:07:56.80,0:08:01.80,Default,,0,0,0,,Ол адамзатты құтқаратын құтқарушы болуға талпынған жоқ па?
Dialogue: 0,0:08:01.80,0:08:06.79,Default,,0,0,0,,Қарғыс атсын! Lizard Edge-ді жалғастырыңыз!
Dialogue: 0,0:08:06.79,0:08:08.79,Default,,0,0,0,,Өмірмен бірге қабылдаңыз!
Dialogue: 0,0:08:13.80,0:08:16.80,Default,,0,0,0,,Тағы екі Дино Никсомен шабуыл!
Dialogue: 0,0:08:16.80,0:08:19.80,Default,,0,0,0,,Бізді әрқашан жын-шайтан езді.
Dialogue: 0,0:08:19.80,0:08:22.79,Default,,0,0,0,,Бірақ мен оны бір адам → деп күткен жоқпын
Dialogue: 0,0:08:22.79,0:08:26.81,Default,,0,0,0,,Мен бір адамды тастаймын деп ешқашан ойламаппын!
Dialogue: 0,0:08:26.81,0:08:28.81,Default,,0,0,0,,Өмірмен бірге қабылдаңыз!
Dialogue: 0,0:08:35.80,0:08:38.79,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:08:38.79,0:08:41.79,Default,,0,0,0,,Сен сатқынсың!
Dialogue: 0,0:08:41.79,0:08:46.80,Default,,0,0,0,,Әлгі жігіт өте қызу шайқас жасайды, солай емес пе?
Dialogue: 0,0:08:46.80,0:08:48.80,Default,,0,0,0,,«Көзді ашып-жұмғанша»→
Dialogue: 0,0:08:48.80,0:08:51.80,Default,,0,0,0,,Данның бір ғана өмірі қалды.
Dialogue: 0,0:08:51.80,0:08:56.80,Default,,0,0,0,,Дэн оның барлық ойларын қабылдайды.
Dialogue: 0,0:08:58.79,0:09:02.80,Default,,0,0,0,,<Лугаинді туған әкесі Дюк елден қуып шықты→
Dialogue: 0,0:09:02.80,0:09:08.80,Default,,0,0,0,,Ол қайтып ораламын деген үмітпен отбасы мүшелерімен саяхатын жалғастырды＞
Dialogue: 0,0:09:08.80,0:09:10.79,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:10.79,0:09:12.79,Default,,0,0,0,,Жарайсың! Ах!
Dialogue: 0,0:09:17.79,0:09:20.79,Default,,0,0,0,,Бұл кеме туралы не деуге болады?
Dialogue: 0,0:09:23.80,0:09:26.80,Default,,0,0,0,,Лугаин! Біраз уақыт өтті
Dialogue: 0,0:09:26.80,0:09:29.79,Default,,0,0,0,,Жастар айтқандай болды (Жастар) А?
Dialogue: 0,0:09:29.79,0:09:33.79,Default,,0,0,0,,Өйткені мен «Лугаин жақсы болады» деп сендім.
Dialogue: 0,0:09:33.79,0:09:36.81,Default,,0,0,0,,Жоқ... Капитан! Хехе!
Dialogue: 0,0:09:36.81,0:09:39.80,Default,,0,0,0,,Рахмет (Жастар) Мен бұрынғыдай емеспін...
Dialogue: 0,0:09:39.80,0:09:43.80,Default,,0,0,0,,Барон, сіздің осында екеніңізге таң қалдым.
Dialogue: 0,0:09:43.80,0:09:46.79,Default,,0,0,0,,Біз Октоға бара жатырмыз.
Dialogue: 0,0:09:46.79,0:09:48.79,Default,,0,0,0,,Октоға дейін?
Dialogue: 0,0:09:48.79,0:09:53.80,Default,,0,0,0,,Мәртебелі патшайыммен Тозақ айдаһар корпусын талқылау керек пе?
Dialogue: 0,0:09:53.80,0:09:57.80,Default,,0,0,0,,Дұрыс, Дэн мен Барон келіседі.
Dialogue: 0,0:09:57.80,0:09:59.80,Default,,0,0,0,,Біз ол жаққа бірге барамыз.
Dialogue: 0,0:09:59.80,0:10:07.79,Default,,0,0,0,,Уайымдама, мен сенің әкең Дакты міндетті түрде қайтарамын.
Dialogue: 0,0:10:07.79,0:10:12.80,Default,,0,0,0,,Жоқ, мен әкем үшін алаңдамаймын. (Барон) Иә?
Dialogue: 0,0:10:12.80,0:10:16.80,Default,,0,0,0,,Сапарымда мен айтпаған өсек естідім.
Dialogue: 0,0:10:16.80,0:10:19.79,Default,,0,0,0,,Өсек деген не?
Dialogue: 0,0:10:19.79,0:10:22.79,Default,,0,0,0,,``Жылқы құдайы Дэн мен Мәртебелі патшайым күш біріктірді →
Dialogue: 0,0:10:22.79,0:10:24.79,Default,,0,0,0,,Өйткені біз ғана құтқарыла аламыз».
Dialogue: 0,0:10:24.79,0:10:28.80,Default,,0,0,0,,«Көптеген жындар мен адамдар жердің қалпына келуімен қайта туады→
Dialogue: 0,0:10:28.80,0:10:32.80,Default,,0,0,0,,Мені тастап кету тағдырым.'' (Барон) Ақымақ
Dialogue: 0,0:10:32.80,0:10:36.81,Default,,0,0,0,,Дэнді жек көретіндер көп пе?
Dialogue: 0,0:10:36.81,0:10:39.79,Default,,0,0,0,,Адамдар да, жындар да...
Dialogue: 0,0:10:39.79,0:10:44.79,Default,,0,0,0,,Машын Дан өте қауіпті жағдайда.
Dialogue: 0,0:10:50.80,0:10:53.79,Default,,0,0,0,,Мәртебелі не ойлайды?
Dialogue: 0,0:10:53.79,0:10:58.80,Default,,0,0,0,,Адамдармен қол ұстасып, Тозақ айдаһар корпусы сияқты бұзақыларды таратыңыз →
Dialogue: 0,0:10:58.80,0:11:01.80,Default,,0,0,0,,Мен өзімді енді ``есі дұрыс'' деп ойламаймын!
Dialogue: 0,0:11:01.80,0:11:07.79,Default,,0,0,0,,Ол X Rare 12 сарайын монополиялап, өзін құтқаруға тырысса керек!
Dialogue: 0,0:11:07.79,0:11:09.79,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:11:12.79,0:11:15.79,Default,,0,0,0,,Сол адамға айтыңыз.
Dialogue: 0,0:11:20.80,0:11:22.80,Default,,0,0,0,,Қадам сызыңыз!
Dialogue: 0,0:11:22.80,0:11:24.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:24.79,0:11:27.79,Default,,0,0,0,,Негізгі қадам! Igua Buggy-ді 1-деңгейге дейін төмендетіңіз
Dialogue: 0,0:11:29.79,0:11:33.80,Default,,0,0,0,,2-деңгейге «Айдың айдаһарының соққысы Зигврм» шақырыңыз!
Dialogue: 0,0:11:33.80,0:11:35.80,Default,,0,0,0,,Не!?
Dialogue: 0,0:11:37.80,0:11:43.79,Default,,0,0,0,,(үру)
Dialogue: 0,0:11:43.79,0:11:47.79,Default,,0,0,0,,«Айдың айдаһары Зигврмға соққы береді»!
Dialogue: 0,0:13:05.79,0:13:09.79,Default,,0,0,0,,«Меха керемет!» Ол маған ұнайды!
Dialogue: 0,0:13:09.79,0:13:11.80,Default,,0,0,0,,Сүйемін! Жақсы көреді!
Dialogue: 0,0:13:11.80,0:13:13.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:17.80,0:13:19.80,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:13:19.80,0:13:22.79,Default,,0,0,0,,)
Dialogue: 0,0:13:22.79,0:13:24.79,Default,,0,0,0,,Неліктен олай істедің?
Dialogue: 0,0:13:24.79,0:13:28.80,Default,,0,0,0,,Лорд Барон, оған Барон сеніп тапсырған!?
Dialogue: 0,0:13:28.80,0:13:33.80,Default,,0,0,0,,Ай сәулесі Барон «менің досым» деп атаған Зигврмға соққы беріңіз.
Dialogue: 0,0:13:33.80,0:13:36.82,Default,,0,0,0,,Адам ат құдайы Данға!?
Dialogue: 0,0:13:36.82,0:13:40.79,Default,,0,0,0,,Шабуыл қадамы! Барыңыз, «Айдың айдаһарының Зигврм соққысы»!
Dialogue: 0,0:13:40.79,0:13:43.79,Default,,0,0,0,,(үру)
Dialogue: 0,0:13:45.80,0:13:48.80,Default,,0,0,0,,La… Оны өмірде қабыл алыңыз!
Dialogue: 0,0:13:52.80,0:13:56.79,Default,,0,0,0,,Қарғыс атсын! Зигвурмның ауыруы?
Dialogue: 0,0:13:56.79,0:14:00.79,Default,,0,0,0,,Неліктен? Неліктен Барон-сама...
Dialogue: 0,0:14:00.79,0:14:02.80,Default,,0,0,0,,Кезеңнің соңы!
Dialogue: 0,0:14:02.80,0:14:07.80,Default,,0,0,0,,<4-бұрылыс... Зак жаңбырлы инелі кесірткені 2-деңгейге көтерді>
Dialogue: 0,0:14:10.79,0:14:16.79,Default,,0,0,0,,《Жын Бароне-сама кілт рухын адамға сеніп тапсырды ма? 》
Dialogue: 0,0:14:16.79,0:14:18.80,Default,,0,0,0,,Бұрылыстың соңы
Dialogue: 0,0:14:18.80,0:14:22.80,Default,,0,0,0,,<5-бұрылыс...Дан Strike Siegwurm-ді 3-деңгейге жеткізеді→
Dialogue: 0,0:14:22.80,0:14:24.80,Default,,0,0,0,,Igua Buggy-ді 2-деңгейге дейін жаңартыңыз! ＞
Dialogue: 0,0:14:24.80,0:14:28.79,Default,,0,0,0,,Бұрылудың соңы
Dialogue: 0,0:14:28.79,0:14:30.79,Default,,0,0,0,,Өйткені Зактың қолы көбейіп кетті→
Dialogue: 0,0:14:30.79,0:14:35.80,Default,,0,0,0,,Мен Strike Siegwurm есептегішімен жойылып кетуінен қорқамын.
Dialogue: 0,0:14:35.80,0:14:39.80,Default,,0,0,0,,Мен Жастардан күткендей көремін! (Жастар) Бұл не!
Dialogue: 0,0:14:41.82,0:14:43.80,Default,,0,0,0,,Негізгі қадам!
Dialogue: 0,0:14:43.80,0:14:48.79,Default,,0,0,0,,Frilled Lizard 1-деңгейге дейін төмендетіңіз! Дино Никсавты 2 деңгейге дейін жаңартыңыз!
Dialogue: 0,0:14:48.79,0:14:51.79,Default,,0,0,0,,《Мистер Барон осы уақытқа дейін кетті→
Dialogue: 0,0:14:51.79,0:14:54.80,Default,,0,0,0,,Сіз ол адамға сенемін дейсіз бе!?
Dialogue: 0,0:14:54.80,0:14:57.80,Default,,0,0,0,,《Адам ат құдайы Дан...》
Dialogue: 0,0:14:57.80,0:14:59.80,Default,,0,0,0,,Бұрылыстың соңы
Dialogue: 0,0:14:59.80,0:15:03.79,Default,,0,0,0,,<7-бұрылыс... Дэн ештеңе істемейді және бұрылысты аяқтайды>
Dialogue: 0,0:15:03.79,0:15:06.79,Default,,0,0,0,,Шайқас тоқтап қалды (жарық) Дан тағы →
Dialogue: 0,0:15:06.79,0:15:09.80,Default,,0,0,0,,Олар бірден шабуылға ұшыраудан қорқатын шығар.
Dialogue: 0,0:15:09.80,0:15:15.80,Default,,0,0,0,,Сонымен қатар, тамаша қорғанысқа ие Strike Siegwurm бар.
Dialogue: 0,0:15:15.80,0:15:21.79,Default,,0,0,0,,Менің ойымша, олар оларды шақырудың қажеті жоқ деп шешті.
Dialogue: 0,0:15:21.79,0:15:25.80,Default,,0,0,0,,<8-бұрылыс... Зак Рэйнді 1-деңгейге түсіреді>
Dialogue: 0,0:15:25.80,0:15:29.80,Default,,0,0,0,,<Және «Қосымша тарту» сиқырын қолданыңыз>
Dialogue: 0,0:15:29.80,0:15:34.79,Default,,0,0,0,,<Палубаңыздан 2 картаны тартыңыз, оларды қолыңызға қосыңыз және тағы 1 картаны ашыңыз>
Dialogue: 0,0:15:34.79,0:15:38.79,Default,,0,0,0,,<Егер бұл қызыл рух болса, оны қолыңызға қосуға болады>
Dialogue: 0,0:15:38.79,0:15:42.81,Default,,0,0,0,,＜ Дегенмен, ол тартқан карта Сиқырлы «Қазба»→
Dialogue: 0,0:15:42.81,0:15:45.80,Default,,0,0,0,,Мен оны палубаға сол күйінде қайтардым >
Dialogue: 0,0:15:45.80,0:15:47.80,Default,,0,0,0,,Бұрылыстың соңы
Dialogue: 0,0:15:48.80,0:15:53.79,Default,,0,0,0,,《Бароне-сама сенетін жылқы құдайы Данның әділдігі қандай? 》
Dialogue: 0,0:15:53.79,0:15:55.79,Default,,0,0,0,,Негізгі қадам! Ах!
Dialogue: 0,0:15:55.79,0:15:58.79,Default,,0,0,0,,Сабер акуласын шақырыңыз!
Dialogue: 0,0:16:03.80,0:16:06.80,Default,,0,0,0,,Сабер акула! Бұл да Бароне-саманыкі ме?
Dialogue: 0,0:16:06.80,0:16:10.79,Default,,0,0,0,,Ах! Сабершарктың шақыру әсері белсендіріледі!
Dialogue: 0,0:16:10.79,0:16:12.79,Default,,0,0,0,,Осы айналымның соңына дейін →
Dialogue: 0,0:16:12.79,0:16:17.80,Default,,0,0,0,,Сіздің рухыңыздың блоктау әсері шабуыл эффектісі ретінде іске қосылды!
Dialogue: 0,0:16:17.80,0:16:20.80,Default,,0,0,0,,үшінның үмітіне айналуға ниетім жоқ!
Dialogue: 0,0:16:20.80,0:16:25.79,Default,,0,0,0,,Мен тек осы жерді құтқарғым келеді! Жер?
Dialogue: 0,0:16:25.79,0:16:27.79,Default,,0,0,0,,Кеттік! Ах!
Dialogue: 0,0:16:27.79,0:16:31.79,Default,,0,0,0,,«Сабер акуласынан» «Айдың айдаһарының Зигвурмға соққысы» Батыл!
Dialogue: 0,0:16:35.80,0:16:38.80,Default,,0,0,0,,(үру)
Dialogue: 0,0:16:41.80,0:16:43.79,Default,,0,0,0,,Батыл!
Dialogue: 0,0:16:43.79,0:16:48.80,Default,,0,0,0,,Шабуыл қадамы! Бар, батыл шабуыл!
Dialogue: 0,0:16:48.80,0:16:50.80,Default,,0,0,0,,Өмірмен бірге қабылдаңыз!
Dialogue: 0,0:16:50.80,0:16:59.79,Default,,0,0,0,,♪♪～
Dialogue: 0,0:16:59.79,0:17:04.79,Default,,0,0,0,,《Бароне-сама маған бірдеңе айтқысы келіп тұр ма?》
Dialogue: 0,0:17:04.79,0:17:09.80,Default,,0,0,0,,《Жылқы құдайы Данмен соғысу арқылы бірдеңе көре аласыз ба? 》
Dialogue: 0,0:17:09.80,0:17:13.80,Default,,0,0,0,,«Айдың айдаһарының Зигврм соққысының» батыл әсері іске қосылды!
Dialogue: 0,0:17:13.80,0:17:18.79,Default,,0,0,0,,Қадамның басында батыл емес бір қарсыластың рухын белгілеңіз.
Dialogue: 0,0:17:18.79,0:17:22.80,Default,,0,0,0,,Рух әрқашан мүмкін болса шабуыл жасайды
Dialogue: 0,0:17:22.80,0:17:25.80,Default,,0,0,0,,Диониксоны көрсетіңіз!
Dialogue: 0,0:17:25.80,0:17:28.80,Default,,0,0,0,,Қарғыс атсын! Дино Никсаумен шабуыл жасаңыз!
Dialogue: 0,0:17:28.80,0:17:32.79,Default,,0,0,0,,«Айдың айдаһарының Зигврм соққысы» 1-деңгей әсері іске қосылды!
Dialogue: 0,0:17:32.79,0:17:36.79,Default,,0,0,0,,Қарсыластың рухы шабуыл жасағанда, бұл рух қалпына келеді!
Dialogue: 0,0:17:41.81,0:17:44.80,Default,,0,0,0,,《Мен бұл адаммен неге ұрысып жатырмын? 》
Dialogue: 0,0:17:44.80,0:17:48.81,Default,,0,0,0,,《Бароне-саманың картасын осы адаммен бірге қолданыңыз! 》
Dialogue: 0,0:17:48.81,0:17:52.79,Default,,0,0,0,,Жарқыл уақыты! Сиқырлы «Қазбаны» қолданыңыз!
Dialogue: 0,0:17:52.79,0:17:55.80,Default,,0,0,0,,Дино Никсоның қан қысымы +3000!
Dialogue: 0,0:17:55.80,0:17:59.80,Default,,0,0,0,,Қосымша жарқыл уақыты! Сиқырлы «Бастер Лэнсті» қолданыңыз!
Dialogue: 0,0:17:59.80,0:18:02.80,Default,,0,0,0,,Дионикусоға BP+3000!
Dialogue: 0,0:18:04.79,0:18:08.79,Default,,0,0,0,,Әлі жоқ! Жарқыл уақыты! Сиқырлы «Бастер Лэнсті» қолданыңыз!
Dialogue: 0,0:18:08.79,0:18:11.79,Default,,0,0,0,,Дионикусоға BP+3000 қосылды!
Dialogue: 0,0:18:11.79,0:18:15.79,Default,,0,0,0,,Дино Никсоның қан қысымы барлығы 13 000!
Dialogue: 0,0:18:23.79,0:18:26.79,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:18:26.79,0:18:31.80,Default,,0,0,0,,《Неге мен адаммын, адамдармен соғысып жатырмын? 》
Dialogue: 0,0:18:31.80,0:18:34.80,Default,,0,0,0,,Кеттік! Ray Needle көмегімен шабуыл жасаңыз!
Dialogue: 0,0:18:34.80,0:18:39.79,Default,,0,0,0,,Жарқыл уақыты! Сиқырлы «Оңтүстік крест алауын» қолданыңыз!
Dialogue: 0,0:18:39.79,0:18:43.79,Default,,0,0,0,,BP4000 немесе одан төмен барлық рухтарды жойыңыз!
Dialogue: 0,0:18:45.80,0:18:49.80,Default,,0,0,0,,Ааа
Dialogue: 0,0:18:49.80,0:18:54.79,Default,,0,0,0,,Негізгі қадам! 1-деңгейде Бладераны және 2-деңгейде Игуа Баггиді шақырыңыз!
Dialogue: 0,0:18:54.79,0:18:57.81,Default,,0,0,0,,(үру)
Dialogue: 0,0:18:57.81,0:19:02.80,Default,,0,0,0,,《Мен лорд Баронмен тең дәрежеде күрескен жылқы құдайы Данға үміт арттым.》
Dialogue: 0,0:19:02.80,0:19:07.80,Default,,0,0,0,,《Бұл үміт сөнгеннен кейін мен лорд Баронға жүгіндім.》
Dialogue: 0,0:19:07.80,0:19:14.80,Default,,0,0,0,,Жүгір! «Күн айдаһар көтерілген Аполлон айдаһары» Құдайдың атымен қызыл айдаһарды шақырады!
Dialogue: 0,0:19:17.79,0:19:20.80,Default,,0,0,0,,《Күшті біреу→
Dialogue: 0,0:19:20.80,0:19:24.80,Default,,0,0,0,,Бізді мына пәледен құтқарарсың деп ойладым.
Dialogue: 0,0:19:26.80,0:19:29.79,Default,,0,0,0,,(үру)
Dialogue: 0,0:19:29.79,0:19:33.81,Default,,0,0,0,,Шабуыл қадамы! Бладераға шабуыл жасаңыз!
Dialogue: 0,0:19:33.81,0:19:37.80,Default,,0,0,0,,Өмірмен бірге қабылдаңыз! Уф!
Dialogue: 0,0:19:37.80,0:19:39.80,Default,,0,0,0,,《Мен не істеп жатырмын? 》
Dialogue: 0,0:19:39.80,0:19:42.80,Default,,0,0,0,,《Умашин Данға ашумен шайқас》
Dialogue: 0,0:19:42.80,0:19:47.79,Default,,0,0,0,,《Бұл сандырақпен күресуді жалғастыратын жындармен бірдей! 》
Dialogue: 0,0:19:47.79,0:19:49.79,Default,,0,0,0,,...
Dialogue: 0,0:19:54.80,0:19:56.80,Default,,0,0,0,,Өмірмен бірге қабылдаңыз!
Dialogue: 0,0:20:00.80,0:20:03.79,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:20:03.79,0:20:07.81,Default,,0,0,0,,Енді менің қолымнан келетіні – шайқас! Ах!
Dialogue: 0,0:20:07.81,0:20:11.80,Default,,0,0,0,,Ал жындардың қажетсіз қақтығыстарды қайталауын тоқтату үшін→
Dialogue: 0,0:20:11.80,0:20:15.80,Default,,0,0,0,,Октоға барып, жын патшайыммен сөйлесіңіз.
Dialogue: 0,0:20:15.80,0:20:20.79,Default,,0,0,0,,Мен жындарды да, адамдарды да құтқарамын!
Dialogue: 0,0:20:20.79,0:20:24.79,Default,,0,0,0,,Ах! Бұл сіздің әділдігіңіз бе?
Dialogue: 0,0:20:24.79,0:20:27.80,Default,,0,0,0,,«Күн Шенрон көтерілген Аполлон айдаһары» шабуылы!
Dialogue: 0,0:20:27.80,0:20:29.80,Default,,0,0,0,,(үру)
Dialogue: 0,0:20:31.80,0:20:33.80,Default,,0,0,0,,Өмірде... Ах...
Dialogue: 0,0:20:36.79,0:20:42.79,Default,,0,0,0,,《Түсініп тұрмын... Бұл Данның жылқы құдайының әділдігі...》
Dialogue: 0,0:20:48.80,0:20:51.80,Default,,0,0,0,,≪(Zolder) Йо! Ах...
Dialogue: 0,0:20:51.80,0:20:55.79,Default,,0,0,0,,Сіз үлкен рух беріп, жақсы шайқастасыз, солай емес пе?
Dialogue: 0,0:20:55.79,0:20:59.80,Default,,0,0,0,,Мен оны өзімнің «Центурион» жауынгерлік бөліміне саламын.
Dialogue: 0,0:20:59.80,0:21:01.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:01.80,0:21:06.80,Default,,0,0,0,,≪(ұшып бара жатқан құстардың дыбысы)
Dialogue: 0,0:21:06.80,0:21:10.79,Default,,0,0,0,,Менің шешімім қабылданды.
Dialogue: 0,0:21:10.79,0:21:13.79,Default,,0,0,0,,Не істеу керек? Сіз Зольдердің Центурионына қосыласыз ба?
Dialogue: 0,0:21:13.79,0:21:18.80,Default,,0,0,0,,Жоқ... Жер қалпына келгенше уақытымыз жоқ.
Dialogue: 0,0:21:18.80,0:21:20.80,Default,,0,0,0,,Сіз айтқандай →
Dialogue: 0,0:21:20.80,0:21:24.79,Default,,0,0,0,,Енді жындар мен адамдар арасында пайдасыз ұрысқа уақыт жоқ.
Dialogue: 0,0:21:24.79,0:21:30.79,Default,,0,0,0,,Мен жындармен ынтымақтасамын және жерді құтқарудың өз жолын табамын.
Dialogue: 0,0:21:30.79,0:21:34.80,Default,,0,0,0,,Бұл менің әділдігім, солай ма?
Dialogue: 0,0:21:34.80,0:21:39.80,Default,,0,0,0,,≪Менімен бірге келгің келе ме? сен?
Dialogue: 0,0:21:39.80,0:21:43.79,Default,,0,0,0,,Луген... Ол Дюктің ұлы. Ол «Түрме командирі Дук па?»
Dialogue: 0,0:21:43.79,0:21:46.81,Default,,0,0,0,,Мен әкемнің кім екенін білемін.
Dialogue: 0,0:21:46.81,0:21:49.80,Default,,0,0,0,,Софиядағы адамдар сияқты →
Dialogue: 0,0:21:49.80,0:21:52.80,Default,,0,0,0,,Біз жерді құтқаратын күш болғымыз келеді.
Dialogue: 0,0:21:52.80,0:21:54.80,Default,,0,0,0,,Бұл қалай жұмыс істейді?
Dialogue: 0,0:21:54.80,0:21:58.79,Default,,0,0,0,,Мен жындар мен адамдар ынтымақтасатын ел құрғым келеді.
Dialogue: 0,0:21:58.79,0:22:03.79,Default,,0,0,0,,Ел болып бірігіп, Жерді қалпына келтірмеу үшін күш болайық.
Dialogue: 0,0:22:03.79,0:22:05.80,Default,,0,0,0,,Лугаин!
Dialogue: 0,0:22:05.80,0:22:09.80,Default,,0,0,0,,Маған көмек бере аласыз ба? Иә?
Dialogue: 0,0:22:09.80,0:22:12.80,Default,,0,0,0,,Егер сіз және Бароне-сама мұны істей алар едіңіз →
Dialogue: 0,0:22:12.80,0:22:15.79,Default,,0,0,0,,Менің де қолымнан келетініне сенімдімін.
Dialogue: 0,0:22:15.79,0:22:17.79,Default,,0,0,0,,Әй... Әй!
Dialogue: 0,0:22:19.79,0:22:24.79,Default,,0,0,0,,үшінн жолға қойыңыз! Бірге жұмыс жасайық
Dialogue: 0,0:22:26.80,0:22:29.80,Default,,0,0,0,,Иә? Көбелек!
Dialogue: 0,0:22:29.80,0:22:33.81,Default,,0,0,0,,Чо! «Махаббат сүйкімді»!
Dialogue: 0,0:22:33.81,0:22:37.79,Default,,0,0,0,,Не? Флораның хабаршысы
Dialogue: 0,0:22:37.79,0:22:42.80,Default,,0,0,0,,Барон мырза, Сиқырлы жарық залы үлкен қиындыққа ұшырады.
Dialogue: 0,0:22:42.80,0:22:47.80,Default,,0,0,0,,Мәртебелі мырзаны жауапқа тарту үшін жындар бірінен соң бірі ағылып жатыр.
Dialogue: 0,0:22:47.80,0:22:51.81,Default,,0,0,0,,Қосымша ақпаратты күтіңіз
Dialogue: 0,0:22:51.81,0:22:53.79,Default,,0,0,0,,Жындар қайтадан бөлініп кетті ме?
Dialogue: 0,0:22:53.79,0:22:56.81,Default,,0,0,0,,Тезірек барғанымыз жөн сияқты (Золдер) Ах!
Dialogue: 0,0:22:56.81,0:22:58.80,Default,,0,0,0,,Біз сенімен бірге боламыз.
Dialogue: 0,0:22:58.80,0:23:02.80,Default,,0,0,0,,Жоқ, бұл жерге өзіміз барғанымыз дұрыс деп ойлаймын.
Dialogue: 0,0:23:02.80,0:23:05.79,Default,,0,0,0,,Бірақ жағдай қауіпті. Мен саған көмектесемін.
Dialogue: 0,0:23:05.79,0:23:12.80,Default,,0,0,0,,Егер бізге бірдеңе болса, сіз өз қолыңызға аласыз.
Dialogue: 0,0:23:12.80,0:23:15.80,Default,,0,0,0,,Барон мырза... Түсінікті.
Dialogue: 0,0:23:15.80,0:23:17.80,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:23:22.79,0:23:25.79,Default,,0,0,0,,Сіз кез келген уақытта бір басу арқылы ұшып кете аласыз!
Dialogue: 0,0:23:25.79,0:23:29.80,Default,,0,0,0,,Жастар... Ал сіз ше? (Жастар) Жарайды
Dialogue: 0,0:23:29.80,0:23:34.80,Default,,0,0,0,,《Дэнді қорлайтын қауесет және Сиқырлы залдағы шатасушылық》
Dialogue: 0,0:23:34.80,0:23:38.79,Default,,0,0,0,,《Мен мұны біреу ұйымдастырып жатыр деп ойлаймын.》
Dialogue: 0,0:23:38.79,0:23:41.79,Default,,0,0,0,,Ах! Дан...
Dialogue: 0,0:23:41.79,0:23:44.79,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:23:44.79,0:23:47.80,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:23:47.80,0:23:50.80,Default,,0,0,0,,«Әдемі София» ұшады!
Dialogue: 0,0:23:59.79,0:24:02.80,Default,,0,0,0,,Қалай болғанда да, мен Мәртебелі патшайыммен жеке кездесуім керек!
Dialogue: 0,0:24:02.80,0:24:04.80,Default,,0,0,0,,Шындықты тексеріңіз!
Dialogue: 0,0:24:04.80,0:24:06.80,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:24:06.80,0:24:10.80,Default,,0,0,0,,Бұл Demon Light залы басталғаннан бергі ең үлкен хаос.
Dialogue: 0,0:24:10.80,0:24:14.79,Default,,0,0,0,,Осылай жалғаса берсе, Мәртебелі мырзаның денсаулығына қауіп төнеді...
Dialogue: 0,0:24:14.79,0:24:18.79,Default,,0,0,0,,Қозғала бастаған берілістерді ешкім тоқтата алмайды.
Dialogue: 0,0:24:18.79,0:24:21.80,Default,,0,0,0,,Бұл рас... қорқынышты.
Dialogue: 0,0:24:21.80,0:24:26.80,Default,,0,0,0,,≪(күлкі)
Dialogue: 0,0:24:32.79,0:24:37.80,Default,,0,0,0,,<3-деңгейде батылдық танытқанда, «Айдың айдаһарының Зигврм соққысы»→
Dialogue: 0,0:24:37.80,0:24:41.80,Default,,0,0,0,,Сіз бір қарсыластың рухын шабуылға мәжбүрлей аласыз →
Dialogue: 0,0:24:41.80,0:24:43.80,Default,,0,0,0,,Қорқынышты Х сирек>
Dialogue: 0,0:25:46.80,0:25:52.79,Default,,0,0,0,,♪♪『Ынталы ЖАУАП』
Dialogue: 0,0:25:52.79,0:26:10.79,Default,,0,0,0,,♪♪～
Dialogue: 0,0:26:10.79,0:26:30.79,Default,,0,0,0,,♪♪～
Dialogue: 0,0:26:30.79,0:26:50.80,Default,,0,0,0,,♪♪～
Dialogue: 0,0:26:50.80,0:27:06.80,Default,,0,0,0,,♪♪～
Dialogue: 0,0:27:06.80,0:27:11.80,Default,,0,0,0,,♪♪～
Dialogue: 0,0:30:32.28,0:30:34.25,Default,,0,0,0,,〈Үлкен қуат алу үшін→
Dialogue: 0,0:30:34.25,0:30:37.12,Default,,0,0,0,,Джо өзінің шайқасын алдыңғы Шинкен Қызыл Каорумен бастайды.
Dialogue: 0,0:30:37.12,0:30:39.22,Default,,0,0,0,,<Бірақ содан кейін Зангяк шабуыл жасады →
Dialogue: 0,0:30:39.22,0:30:42.21,Default,,0,0,0,,Жан түршігерлік факт анықталды! 〉
Dialogue: 0,0:30:42.21,0:30:44.33,Default,,0,0,0,,〈Арнайы қызметкер Баризорг→
Dialogue: 0,0:30:44.33,0:30:46.27,Default,,0,0,0,,Бұл менің бұрынғы ағам Сид болатын! 〉
Dialogue: 0,0:30:46.27,0:30:51.39,Default,,0,0,0,,〈Бір түннен кейін Джо жоғалып кетті...〉
Dialogue: 0,0:30:51.39,0:30:54.22,Default,,0,0,0,,Не болды, Джо? А~ мен уайымдап тұрмын.
Dialogue: 0,0:30:54.22,0:30:56.21,Default,,0,0,0,,Мен мұнда қайтып келгенде де →
Dialogue: 0,0:30:56.21,0:30:59.16,Default,,0,0,0,,Бұл әдеттегіден өзгеше болды. Уф.
Dialogue: 0,0:31:00.66,0:31:06.66,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
