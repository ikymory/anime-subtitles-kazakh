Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.75,0:00:04.08,Default,,0,0,0,,Бейблейд
Dialogue: 0,0:00:04.17,0:00:08.13,Default,,0,0,0,,Мықты болуды мақсат еткен ұлдардың арманының жемісі.
Dialogue: 0,0:00:08.96,0:00:12.17,Default,,0,0,0,,Енді супер Цетсу дәуірі басталады.
Dialogue: 0,0:00:12.55,0:00:16.80,Default,,0,0,0,,Металл сауытыңызды киіңіз де, Беймен шытырман оқиғаға аттаныңыз!
Dialogue: 0,0:00:16.93,0:00:19.26,Default,,0,0,0,,Әлем чемпионы болуды мақсат етіңіз!
Dialogue: 0,0:00:19.39,0:00:23.69,Default,,0,0,0,,Super Zetsu Super Zetsu Super Zetsu!
Dialogue: 0,0:00:24.27,0:00:27.90,Default,,0,0,0,,Ең күшті және жеңілмейтін атағын алатын адам сенсің!
Dialogue: 0,0:00:32.49,0:00:34.07,Default,,0,0,0,,Мен Қызыл жүз Айгамын
Dialogue: 0,0:00:34.78,0:00:37.99,Default,,0,0,0,,Мен Барто Аои есімді таңғажайып жүзді кездестірдім.
Dialogue: 0,0:00:38.28,0:00:40.49,Default,,0,0,0,,Мен Бэйді ойнағым келеді...
Dialogue: 0,0:00:40.62,0:00:43.12,Default,,0,0,0,,Мен Z Ахиллесті өзім жасадым
Dialogue: 0,0:00:43.75,0:00:46.58,Default,,0,0,0,,Ал біз бірінші рет шайқастық!
Dialogue: 0,0:00:50.75,0:00:51.96,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:00:52.30,0:00:53.47,Default,,0,0,0,,Жасайық
Dialogue: 0,0:00:59.80,0:01:00.81,Default,,0,0,0,,Не?
Dialogue: 0,0:01:03.02,0:01:04.27,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:04.48,0:01:05.31,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:05.69,0:01:07.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:07.40,0:01:08.48,Default,,0,0,0,,Айға
Dialogue: 0,0:01:12.03,0:01:13.82,Default,,0,0,0,,Сондай-ақ сиқыр сенің ерніңе де әсер етсін…
Dialogue: 0,0:01:15.74,0:01:18.57,Default,,0,0,0,,Валькириден жеңілгеніме қатты көңілім қалды, бірақ...
Dialogue: 0,0:01:18.70,0:01:21.49,Default,,0,0,0,,Күн қатты қызып барады!
Dialogue: 0,0:01:26.12,0:01:29.25,Default,,0,0,0,,Содан кейін мен Z Ахиллеспен қатарынан жеңіске жеттім!
Dialogue: 0,0:01:30.04,0:01:33.13,Default,,0,0,0,,Бұл қалада енді жау жоқ!
Dialogue: 0,0:01:38.97,0:01:42.68,Default,,0,0,0,,Мен Super Zetsu, ең күшті және жеңілмейтінмін!
Dialogue: 0,0:01:43.52,0:01:49.52,Default,,0,0,0,,♪~
Dialogue: 0,0:03:06.14,0:03:12.15,Default,,0,0,0,,~♪
Dialogue: 0,0:03:13.15,0:03:16.32,Default,,0,0,0,,«Ахиллес Форнеусқа қарсы!!»
Dialogue: 0,0:03:17.78,0:03:19.32,Default,,0,0,0,,Сәлем! Айга
Dialogue: 0,0:03:19.44,0:03:21.53,Default,,0,0,0,,Мені жай ғана атыммен атама!
Dialogue: 0,0:03:22.03,0:03:24.03,Default,,0,0,0,,Өзіңді аса жоғары, аса биік сезініп тұрсың.
Dialogue: 0,0:03:24.12,0:03:26.83,Default,,0,0,0,,Өйткені мен өте күштімін.
Dialogue: 0,0:03:26.95,0:03:29.16,Default,,0,0,0,,Мен сені бұл жолы үрлеймін!
Dialogue: 0,0:03:29.29,0:03:31.66,Default,,0,0,0,,Қолыңнан келсе, істе!
Dialogue: 0,0:03:33.37,0:03:35.50,Default,,0,0,0,,Шайқастар 2 ұпайға негізделген.
Dialogue: 0,0:03:35.96,0:03:38.71,Default,,0,0,0,,Аяқтау Айналдыру 1 ұпайға тең
Dialogue: 0,0:03:39.38,0:03:41.01,Default,,0,0,0,,Жедел мәре – 2 ұпай
Dialogue: 0,0:03:41.76,0:03:44.09,Default,,0,0,0,,Ендеше екеуміз шығанақты тексерейік.
Dialogue: 0,0:03:46.39,0:03:49.35,Default,,0,0,0,,Z Ахиллес теңгерімді түрі
Dialogue: 0,0:03:49.47,0:03:50.93,Default,,0,0,0,,4 жүзді қабат
Dialogue: 0,0:03:51.06,0:03:53.44,Default,,0,0,0,,Драйверді он бір дискіге дейін кеңейтіңіз
Dialogue: 0,0:03:53.81,0:03:56.69,Default,,0,0,0,,Қанша қарасам да әлсіздік жоқ.
Dialogue: 0,0:03:57.32,0:03:58.44,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:03:59.19,0:04:02.07,Default,,0,0,0,,Z Ахиллес Кеттік!
Dialogue: 0,0:04:02.78,0:04:04.57,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:04:05.20,0:04:08.33,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:04:08.79,0:04:11.08,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:04:11.33,0:04:12.33,Default,,0,0,0,,Ох… Уф~ Мен қатты ашпын.
Dialogue: 0,0:04:16.04,0:04:17.71,Default,,0,0,0,,Мен орталықты алдым!
Dialogue: 0,0:04:17.84,0:04:19.09,Default,,0,0,0,,Мен оны алуға рұқсат етемін!
Dialogue: 0,0:04:19.63,0:04:21.59,Default,,0,0,0,,Жүр!
Dialogue: 0,0:04:23.51,0:04:24.47,Default,,0,0,0,,Ей!
Dialogue: 0,0:04:25.64,0:04:27.10,Default,,0,0,0,,Әй, не болды!
Dialogue: 0,0:04:27.30,0:04:28.72,Default,,0,0,0,,Айга күшті
Dialogue: 0,0:04:29.01,0:04:29.93,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:04:30.01,0:04:32.93,Default,,0,0,0,,Егер сендер енді маған тең келе алмасаңдар~
Dialogue: 0,0:04:33.10,0:04:36.06,Default,,0,0,0,,Есіңізде болсын, ақымақ!
Dialogue: 0,0:04:36.19,0:04:38.73,Default,,0,0,0,,Сені ақымақ десе, ақымақ!
Dialogue: 0,0:04:41.23,0:04:45.41,Default,,0,0,0,,Алға! Валькирия!
Dialogue: 0,0:04:48.20,0:04:50.54,Default,,0,0,0,,Иә! Ах!
Dialogue: 0,0:04:51.16,0:04:52.54,Default,,0,0,0,,Куууу…
Dialogue: 0,0:04:54.83,0:04:59.67,Default,,0,0,0,,Балт Аои, менімен жарыс!
Dialogue: 0,0:05:04.47,0:05:07.14,Default,,0,0,0,,Бұл Айганың қатарынан 88 жеңісі
Dialogue: 0,0:05:07.76,0:05:08.72,Default,,0,0,0,,Сіз тыңдайсыз ба?
Dialogue: 0,0:05:08.93,0:05:10.93,Default,,0,0,0,,Маңызды емес! иә?
Dialogue: 0,0:05:11.43,0:05:13.85,Default,,0,0,0,,Қанша ұтқаныңыз маңызды емес!
Dialogue: 0,0:05:14.23,0:05:16.02,Default,,0,0,0,,(Нарудың жылағаны)
Dialogue: 0,0:05:16.14,0:05:18.19,Default,,0,0,0,,А? Уф...
Dialogue: 0,0:05:18.94,0:05:21.73,Default,,0,0,0,,Мен есеп жүргізуге қиналсам да.
Dialogue: 0,0:05:22.40,0:05:23.90,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:05:23.99,0:05:25.36,Default,,0,0,0,,Ах, кешіріңіз! кешіріңіз!
Dialogue: 0,0:05:28.20,0:05:30.16,Default,,0,0,0,,Сол үшін кешірдім дедім, а?
Dialogue: 0,0:05:30.28,0:05:32.91,Default,,0,0,0,,Жарайды! Ұлдар мен қыздар!
Dialogue: 0,0:05:32.99,0:05:33.95,Default,,0,0,0,,Сіз шайқасып жатырсыз ба? Bay News уақыты келді!
Dialogue: 0,0:05:33.95,0:05:34.75,Default,,0,0,0,,Сіз шайқасып жатырсыз ба? Bay News уақыты келді!
Dialogue: 0,0:05:33.95,0:05:34.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:34.75,0:05:37.50,Default,,0,0,0,,Сіз шайқасып жатырсыз ба? Bay News уақыты келді!
Dialogue: 0,0:05:37.83,0:05:41.50,Default,,0,0,0,,Бүгін біз Super Zetsubei императоры Форнеус туралы сөйлесеміз!
Dialogue: 0,0:05:41.96,0:05:44.26,Default,,0,0,0,,Император Форней?
Dialogue: 0,0:05:44.96,0:05:49.47,Default,,0,0,0,,12 қабатты дөңгелек пышақтар барлық шабуылдардан аулақ болады
Dialogue: 0,0:05:49.55,0:05:52.51,Default,,0,0,0,,Нөлдік диск және аула жүргізушісі-
Dialogue: 0,0:05:52.60,0:05:55.27,Default,,0,0,0,,Өте тұрақты айналу жасайды
Dialogue: 0,0:05:55.35,0:05:56.89,Default,,0,0,0,,Қорғаныстың соңғы түрі.
Dialogue: 0,0:05:57.56,0:05:59.77,Default,,0,0,0,,Бұл салқын шығанақта...
Dialogue: 0,0:05:59.85,0:06:04.07,Default,,0,0,0,,Бұл Фубуки Суми, Йонекома Гакуэн Бей клубының капитаны!
Dialogue: 0,0:06:04.15,0:06:05.78,Default,,0,0,0,,Сәлем! Әдемі!
Dialogue: 0,0:06:05.86,0:06:10.91,Default,,0,0,0,,Йонекома академиясы мықты командаларға толы ұлттық турнирде қайтадан жеңіске жете ме?
Dialogue: 0,0:06:10.99,0:06:13.20,Default,,0,0,0,,Мен оны қазір асыға күтемін!
Dialogue: 0,0:06:13.28,0:06:14.29,Default,,0,0,0,,Жалынды диктор
Dialogue: 0,0:06:14.74,0:06:16.70,Default,,0,0,0,,Анами айтты!
Dialogue: 0,0:06:16.79,0:06:18.62,Default,,0,0,0,,Келесі кездескенше!
Dialogue: 0,0:06:20.37,0:06:22.42,Default,,0,0,0,,Йонекома академиясы?
Dialogue: 0,0:06:23.17,0:06:26.46,Default,,0,0,0,,Барто Аои оқыған бастауыш мектепке ұқсайды.
Dialogue: 0,0:06:26.59,0:06:27.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:27.67,0:06:31.59,Default,,0,0,0,,Фубуки Сумие Балтоның мұрагері деп айтылатын сияқты.
Dialogue: 0,0:06:31.68,0:06:32.80,Default,,0,0,0,,Мұрагер?
Dialogue: 0,0:06:33.22,0:06:35.81,Default,,0,0,0,,Бұл келесі чемпионға үміткер емес пе?
Dialogue: 0,0:06:36.52,0:06:38.39,Default,,0,0,0,,Чемпионға үміткер
Dialogue: 0,0:06:40.10,0:06:43.23,Default,,0,0,0,,Мен күштірек біреумен күресуім керек.
Dialogue: 0,0:06:43.36,0:06:44.61,Default,,0,0,0,,Маған аударуға рұқсат етіңіз!
Dialogue: 0,0:06:44.94,0:06:46.23,Default,,0,0,0,,Қайда?
Dialogue: 0,0:06:46.36,0:06:47.78,Default,,0,0,0,,Йонекома академиясы!
Dialogue: 0,0:06:47.90,0:06:49.11,Default,,0,0,0,,Жарайсың ба? әке
Dialogue: 0,0:06:49.82,0:06:51.07,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:06:51.16,0:06:52.62,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:06:53.12,0:06:54.99,Default,,0,0,0,,Жақсы емес, жақсы емес!
Dialogue: 0,0:06:55.41,0:06:57.50,Default,,0,0,0,,Әке!
Dialogue: 0,0:06:59.00,0:07:01.25,Default,,0,0,0,,(Сиырдың улауы)
Dialogue: 0,0:07:01.83,0:07:04.25,Default,,0,0,0,,Неге болмайды?
Dialogue: 0,0:07:05.09,0:07:08.51,Default,,0,0,0,,Ахиллес Мықты жігітпен төбелескіңіз келеді, солай ма?
Dialogue: 0,0:07:11.30,0:07:13.97,Default,,0,0,0,,Мен Ахиллеспен сөйлесіп тұрмын.
Dialogue: 0,0:07:16.22,0:07:19.23,Default,,0,0,0,,Айганың Бейге ғашық болғаны――
Dialogue: 0,0:07:19.35,0:07:21.02,Default,,0,0,0,,Сіз шынымен бақыттысыз ба?
Dialogue: 0,0:07:21.77,0:07:24.77,Default,,0,0,0,,Мен сенің уайымдап жатқаныңды білемін.
Dialogue: 0,0:07:25.15,0:07:26.02,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:07:26.11,0:07:28.40,Default,,0,0,0,,Айға мен көрген адамнан артық...
Dialogue: 0,0:07:28.86,0:07:31.78,Default,,0,0,0,,Super Zetsubei-мен күшті резонанс
Dialogue: 0,0:07:32.36,0:07:33.53,Default,,0,0,0,,Бұл жақсы нәрсе, солай ма?
Dialogue: 0,0:07:34.16,0:07:35.87,Default,,0,0,0,,Резонанстық қуат тым күшті...
Dialogue: 0,0:07:36.45,0:07:39.04,Default,,0,0,0,,Кейбір қалақшалар шығанаққа алынады.
Dialogue: 0,0:07:40.04,0:07:42.25,Default,,0,0,0,,Мен адамдардың осыдан зардап шеккенін көрдім.
Dialogue: 0,0:07:43.37,0:07:46.88,Default,,0,0,0,,Мен Айғаның бұл жолмен жүргенін қаламаймын.
Dialogue: 0,0:07:47.59,0:07:52.22,Default,,0,0,0,,Бірақ сіз Айғаға би құруға рұқсат бердіңіз.
Dialogue: 0,0:07:53.05,0:07:57.05,Default,,0,0,0,,Мен Айғаның мұны істегенін қалаймын.
Dialogue: 0,0:07:57.64,0:07:58.68,Default,,0,0,0,,Канна…
Dialogue: 0,0:07:59.72,0:08:01.48,Default,,0,0,0,,Қатты! Айга!
Dialogue: 0,0:08:01.93,0:08:02.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:03.23,0:08:04.02,Default,,0,0,0,,Ха...
Dialogue: 0,0:08:04.60,0:08:06.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:07.32,0:08:08.98,Default,,0,0,0,,Айга! иә?
Dialogue: 0,0:08:09.78,0:08:11.24,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:08:11.61,0:08:13.70,Default,,0,0,0,,О? О!
Dialogue: 0,0:08:17.24,0:08:18.95,Default,,0,0,0,,Үйден қашуды жоспарлап отырсыз ба?
Dialogue: 0,0:08:19.45,0:08:21.45,Default,,0,0,0,,Мен баруды шештім.
Dialogue: 0,0:08:22.21,0:08:23.21,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:23.79,0:08:25.37,Default,,0,0,0,,Оны тоқтатудың қажеті жоқ!
Dialogue: 0,0:08:25.83,0:08:27.08,Default,,0,0,0,,Вагон тежегішті басады!
Dialogue: 0,0:08:27.34,0:08:28.88,Default,,0,0,0,,Мен шешіп қойдым!
Dialogue: 0,0:08:29.42,0:08:30.88,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,0:08:32.76,0:08:34.84,Default,,0,0,0,,Не? Жаңа ғана не ұстадыңыз?
Dialogue: 0,0:08:35.51,0:08:37.35,Default,,0,0,0,,Жүр! Айга
Dialogue: 0,0:08:38.47,0:08:40.35,Default,,0,0,0,,Бірақ әке...
Dialogue: 0,0:08:41.14,0:08:45.56,Default,,0,0,0,,Әкем Айғаның сезімін басқаларға қарағанда жақсы түсінеді деп ойлаймын.
Dialogue: 0,0:08:47.61,0:08:48.90,Default,,0,0,0,,Куу~!
Dialogue: 0,0:08:49.52,0:08:53.24,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:08:57.07,0:08:57.53,Default,,0,0,0,,(Құстардың сайрауы)
Dialogue: 0,0:08:57.53,0:08:59.78,Default,,0,0,0,,(Құстардың сайрауы)
Dialogue: 0,0:08:57.53,0:08:59.78,Default,,0,0,0,,Тамағыңызды дұрыс жеңіз, жарай ма?
Dialogue: 0,0:09:00.37,0:09:01.41,Default,,0,0,0,,жеп ал
Dialogue: 0,0:09:02.54,0:09:04.41,Default,,0,0,0,,Ал... Мен білемін!
Dialogue: 0,0:09:04.50,0:09:07.21,Default,,0,0,0,,А? Бір минут күтіңіз!
Dialogue: 0,0:09:07.92,0:09:09.13,Default,,0,0,0,,Айга...
Dialogue: 0,0:09:14.84,0:09:16.47,Default,,0,0,0,,♬~
Dialogue: 0,0:09:17.47,0:09:18.93,Default,,0,0,0,,Хаха...
Dialogue: 0,0:09:19.01,0:09:21.18,Default,,0,0,0,,Хамф... Хамф! Хмм...
Dialogue: 0,0:09:26.64,0:09:29.27,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:09:29.27,0:09:30.90,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:09:29.27,0:09:30.90,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:09:30.90,0:09:31.52,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:09:36.65,0:09:39.66,Default,,0,0,0,,Одан да алыс жүріңіз, хехехе~
Dialogue: 0,0:09:41.08,0:09:43.95,Default,,0,0,0,,Айга! Мен сенің жеңістен қашуыңа жол бермеймін!
Dialogue: 0,0:09:44.04,0:09:45.16,Default,,0,0,0,,Мен сені кешірмеймін!
Dialogue: 0,0:09:45.66,0:09:48.00,Default,,0,0,0,,Менің сендермен айналысатын уақытым жоқ.
Dialogue: 0,0:09:48.08,0:09:51.09,Default,,0,0,0,,О? Ей, шайқасайық!
Dialogue: 0,0:09:52.17,0:09:54.59,Default,,0,0,0,,Бұл жерден өтпейінше бір қадам да жасамаңыз!
Dialogue: 0,0:09:56.47,0:09:58.05,Default,,0,0,0,,Мен мұны істеуім керек
Dialogue: 0,0:09:58.26,0:09:59.05,Default,,0,0,0,,Жарайды! Барлығыңыз бірге келіңіздер!
Dialogue: 0,0:09:58.26,0:09:59.05,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:09:59.05,0:10:00.34,Default,,0,0,0,,Жарайды! Барлығыңыз бірге келіңіздер!
Dialogue: 0,0:10:01.93,0:10:03.39,Default,,0,0,0,,Battle Royale
Dialogue: 0,0:10:03.51,0:10:05.43,Default,,0,0,0,,Тірі қалған би жеңеді.
Dialogue: 0,0:10:05.77,0:10:09.31,Default,,0,0,0,,«Аман қалу»? Бұны ұнатамын!
Dialogue: 0,0:10:09.48,0:10:11.81,Default,,0,0,0,,Біз міндетті түрде жеңеміз! (2 адам) О!
Dialogue: 0,0:10:12.36,0:10:14.32,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:10:14.61,0:10:16.57,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:10:17.28,0:10:20.32,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:10:20.78,0:10:23.33,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:23.41,0:10:24.70,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:10:27.71,0:10:30.37,Default,,0,0,0,,Уау! Мен оны ұшырып жіберемін!
Dialogue: 0,0:10:32.46,0:10:33.38,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:36.46,0:10:40.01,Default,,0,0,0,,Z Ахиллес! Ілгері жүру!
Dialogue: 0,0:10:42.68,0:10:43.89,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:10:44.31,0:10:46.89,Default,,0,0,0,,Ва~хахаха!
Dialogue: 0,0:10:47.02,0:10:49.85,Default,,0,0,0,,Енді сен маған тең келмейтініңді білдің, солай ма?
Dialogue: 0,0:10:51.19,0:10:52.48,Default,,0,0,0,,Сонда кездескенше~
Dialogue: 0,0:10:53.02,0:10:54.73,Default,,0,0,0,,Барма... А?
Dialogue: 0,0:10:55.27,0:10:59.11,Default,,0,0,0,,Мен сені ұрсам, баруды қоярсың деп ойладым.
Dialogue: 0,0:11:01.41,0:11:03.91,Default,,0,0,0,,Айгамен көбірек шайқас!
Dialogue: 0,0:11:04.03,0:11:05.74,Default,,0,0,0,,Мен де! (Бала С) Мен де!
Dialogue: 0,0:11:07.29,0:11:08.29,Default,,0,0,0,,Omeh және т.б.
Dialogue: 0,0:11:10.00,0:11:12.38,Default,,0,0,0,,Барлығына! Күшті бол!
Dialogue: 0,0:11:12.50,0:11:13.63,Default,,0,0,0,,Сол сұм Боинго! Ең болмағанда қазір! Мылтығым➡
Dialogue: 0,0:11:13.96,0:11:16.63,Default,,0,0,0,,Қайда? Огимото-яда екен ғой.
Dialogue: 0,0:11:20.22,0:11:21.22,Default,,0,0,0,,Айға
Dialogue: 0,0:11:21.30,0:11:23.05,Default,,0,0,0,,Эй... жылама.
Dialogue: 0,0:11:23.18,0:11:24.72,Default,,0,0,0,,Мен жыламаймын, иә?
Dialogue: 0,0:11:25.18,0:11:27.39,Default,,0,0,0,,Эххе, сен білесің...
Dialogue: 0,0:11:27.68,0:11:31.27,Default,,0,0,0,,(дыбыс жоқ)
Dialogue: 0,0:11:32.31,0:11:34.73,Default,,0,0,0,,Мен сені естімеймін... Мен сені естімеймін.
Dialogue: 0,0:11:36.15,0:11:40.15,Default,,0,0,0,,Нару~! Сау болыңыз!
Dialogue: 0,0:11:42.15,0:11:44.66,Default,,0,0,0,,Мм... ол қайда?
Dialogue: 0,0:11:45.12,0:11:46.45,Default,,0,0,0,,Йонекома академиясы
Dialogue: 0,0:11:47.08,0:11:49.12,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:11:49.25,0:11:50.25,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:50.70,0:11:51.79,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:11:51.91,0:11:53.75,Default,,0,0,0,,Жоғалтпа! (Бенимару) Жақсы, жақсы!
Dialogue: 0,0:11:54.38,0:11:56.75,Default,,0,0,0,,Жарайсыңдар! Бар! (Джонси) Жарайды! Міне!
Dialogue: 0,0:11:56.84,0:11:58.00,Default,,0,0,0,,Бұл – Огимотоя.
Dialogue: 0,0:11:58.09,0:11:59.26,Default,,0,0,0,,Бұл жерде?
Dialogue: 0,0:12:02.76,0:12:05.64,Default,,0,0,0,,Burst Finish Тобисуке жеңеді
Dialogue: 0,0:12:06.18,0:12:08.06,Default,,0,0,0,,Тыныш! (Джонси) Ух...
Dialogue: 0,0:12:08.14,0:12:10.02,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:10.85,0:12:13.02,Default,,0,0,0,,О! Мен Бэйді ойнадым.
Dialogue: 0,0:12:13.60,0:12:14.73,Default,,0,0,0,,Теме деген кім?
Dialogue: 0,0:12:15.23,0:12:18.19,Default,,0,0,0,,Мен бе? Мен Қызыл жүз Айгамын
Dialogue: 0,0:12:18.32,0:12:20.32,Default,,0,0,0,,Сіз Йонекома академиясындасыз ба?
Dialogue: 0,0:12:20.44,0:12:21.99,Default,,0,0,0,,Сонда не болды?
Dialogue: 0,0:12:22.11,0:12:22.78,Default,,0,0,0,,Фубуки Суми деген жігіт бар, солай ма?
Dialogue: 0,0:12:22.78,0:12:23.53,Default,,0,0,0,,Фубуки Суми деген жігіт бар, солай ма?
Dialogue: 0,0:12:22.78,0:12:23.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:23.53,0:12:24.41,Default,,0,0,0,,Фубуки Суми деген жігіт бар, солай ма?
Dialogue: 0,0:12:24.66,0:12:26.20,Default,,0,0,0,,Бұл жерде қалмаңыз!
Dialogue: 0,0:12:26.28,0:12:28.66,Default,,0,0,0,,Ол Bay Club!
Dialogue: 0,0:12:28.74,0:12:30.62,Default,,0,0,0,,Біз Ранбей тобымыз!
Dialogue: 0,0:12:30.70,0:12:31.75,Default,,0,0,0,,Ran Bay тобы?
Dialogue: 0,0:12:32.16,0:12:34.37,Default,,0,0,0,,Бэй клубы тіпті осар емес!
Dialogue: 0,0:12:34.46,0:12:36.04,Default,,0,0,0,,Шықыңдар!
Dialogue: 0,0:12:36.13,0:12:37.08,Default,,0,0,0,,Бенимару!
Dialogue: 0,0:12:37.54,0:12:38.50,Default,,0,0,0,,О!
Dialogue: 0,0:12:39.09,0:12:41.88,Default,,0,0,0,,Міне... Тей!
Dialogue: 0,0:12:42.55,0:12:44.09,Default,,0,0,0,,Маған да рұқсат етіңіз!
Dialogue: 0,0:12:44.55,0:12:45.63,Default,,0,0,0,,Не?
Dialogue: 0,0:12:45.76,0:12:48.47,Default,,0,0,0,,Бірге жұмыс істегенімізге 100 жыл болды!
Dialogue: 0,0:12:48.93,0:12:51.02,Default,,0,0,0,,Менімен мұны істеуге қорқасың ба?
Dialogue: 0,0:12:51.14,0:12:52.10,Default,,0,0,0,,Э?
Dialogue: 0,0:12:52.18,0:12:53.85,Default,,0,0,0,,Мен саған ештеңе айтып тұрған жоқпын.
Dialogue: 0,0:12:54.48,0:12:58.11,Default,,0,0,0,,Мен саған айтамын, мен шынымен күштімін.
Dialogue: 0,0:12:58.65,0:13:01.57,Default,,0,0,0,,Жарайды, бұл тамаша. Мен жасаймын!
Dialogue: 0,0:13:02.19,0:13:05.07,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:10.08,0:13:12.91,Default,,0,0,0,,Га~хахахаха!
Dialogue: 0,0:13:13.04,0:13:15.21,Default,,0,0,0,,Мен қаншалықты күштімін?
Dialogue: 0,0:13:15.41,0:13:17.67,Default,,0,0,0,,Super Zetsu, ең күшті және жеңілмейтін!
Dialogue: 0,0:13:17.75,0:13:20.54,Default,,0,0,0,,Ва~хахаха!
Dialogue: 0,0:13:22.55,0:13:24.59,Default,,0,0,0,,Барлығы өлтірілді дейсіз бе?
Dialogue: 0,0:13:25.34,0:13:28.47,Default,,0,0,0,,Бұл керемет күшті жігіт...
Dialogue: 0,0:13:28.84,0:13:30.97,Default,,0,0,0,,Тағы да Ранбей тобы!
Dialogue: 0,0:13:31.51,0:13:33.06,Default,,0,0,0,,Кешіріңіз! Келесі...
Dialogue: 0,0:13:33.18,0:13:34.81,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:13:38.69,0:13:39.90,Default,,0,0,0,,Сочо
Dialogue: 0,0:13:40.73,0:13:45.69,Default,,0,0,0,,Мен сізге Ранбей тобының қаншалықты қорқынышты екенін айтуым керек.
Dialogue: 0,0:13:46.65,0:13:47.95,Default,,0,0,0,,Мен бұны киемін… жетімдер үйінде өткізген күндерімді ұмытпау үшін.
Dialogue: 0,0:13:48.03,0:13:49.03,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:13:49.57,0:13:51.53,Default,,0,0,0,,Бұл Йонекома академиясы!
Dialogue: 0,0:13:51.62,0:13:53.04,Default,,0,0,0,,Мен бұны киемін… жетімдер үйінде өткізген күндерімді ұмытпау үшін.
Dialogue: 0,0:13:56.71,0:13:59.54,Default,,0,0,0,,Эй, мен істеп жатырмын! Мен істеп жатырмын!
Dialogue: 0,0:13:59.67,0:14:01.96,Default,,0,0,0,,(Оқушы айқайлайды)
Dialogue: 0,0:14:02.50,0:14:04.13,Default,,0,0,0,,Осы жерде немесе Бей клубында ма?
Dialogue: 0,0:14:04.30,0:14:05.63,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:14:07.13,0:14:08.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:08.80,0:14:14.14,Default,,0,0,0,,Суми Фубуки! Күресейік!
Dialogue: 0,0:14:14.22,0:14:15.72,Default,,0,0,0,,Кенеттен не болды?
Dialogue: 0,0:14:15.81,0:14:17.94,Default,,0,0,0,,Капитан әлі келген жоқ па?
Dialogue: 0,0:14:18.48,0:14:21.86,Default,,0,0,0,,Жарайды, мен сені күтемін.
Dialogue: 0,0:14:22.06,0:14:23.82,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:14:23.94,0:14:26.03,Default,,0,0,0,,Мен Қызыл жүз Айгамын!
Dialogue: 0,0:14:26.15,0:14:27.11,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:27.24,0:14:31.57,Default,,0,0,0,,Фубуки келгенше неге менімен ұрыспайсыңдар?
Dialogue: 0,0:14:31.78,0:14:32.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:33.03,0:14:34.91,Default,,0,0,0,,Мүмкін ауысатын студент шығар?
Dialogue: 0,0:14:35.04,0:14:37.37,Default,,0,0,0,,Бұл шайқастан кейін шешіледі.
Dialogue: 0,0:14:37.71,0:14:40.42,Default,,0,0,0,,Мен не айтып тұрғаныңызды түсінбедім...
Dialogue: 0,0:14:40.54,0:14:45.71,Default,,0,0,0,,Маған сәйкес мектеп болса, онда мен оған бара аламын.
Dialogue: 0,0:14:45.84,0:14:47.80,Default,,0,0,0,,Ол біртүрлі жігіт~
Dialogue: 0,0:14:49.01,0:14:50.63,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:14:53.93,0:14:54.97,Default,,0,0,0,,Ахх...хехе
Dialogue: 0,0:14:55.39,0:14:57.22,Default,,0,0,0,,Мен Коджи-кунды жарып жібердім.
Dialogue: 0,0:14:57.35,0:14:58.35,Default,,0,0,0,,Бұл Агент Твайлайт басқаратын академия ма?
Dialogue: 0,0:14:58.73,0:15:01.85,Default,,0,0,0,,Жарайды, келіңіз!
Dialogue: 0,0:15:07.74,0:15:11.32,Default,,0,0,0,,Ва~хахахаха! Алдағы уақытта!
Dialogue: 0,0:15:12.91,0:15:14.33,Default,,0,0,0,,Капитан!
Dialogue: 0,0:15:14.78,0:15:17.37,Default,,0,0,0,,Біртүрлі жігіт жаттығу алаңында жабайы жүгіріп келеді.
Dialogue: 0,0:15:17.70,0:15:19.08,Default,,0,0,0,,Тыныш болыңыз
Dialogue: 0,0:15:19.50,0:15:23.08,Default,,0,0,0,,Зейінін шоғырландырған Фубукиге ештеңе айтудың қажеті жоқ.
Dialogue: 0,0:15:23.46,0:15:24.75,Default,,0,0,0,,Суо мырза
Dialogue: 0,0:15:24.84,0:15:26.46,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:15:30.17,0:15:31.22,Default,,0,0,0,,Буси!
Dialogue: 0,0:15:39.85,0:15:41.81,Default,,0,0,0,,♬~
Dialogue: 0,0:15:41.89,0:15:45.02,Default,,0,0,0,,Керемет... Қазірдің өзінде 85 адам
Dialogue: 0,0:15:45.98,0:15:48.11,Default,,0,0,0,,О, мен істеп жатырмын.
Dialogue: 0,0:15:48.19,0:15:49.36,Default,,0,0,0,,Директор!
Dialogue: 0,0:15:49.49,0:15:52.45,Default,,0,0,0,,Иә? Ол менің шәкіртім емес сияқты...
Dialogue: 0,0:15:52.57,0:15:56.53,Default,,0,0,0,,Иә, бізде Бейбатт болады және ауысу немесе бермеу туралы шешім қабылдаймыз.
Dialogue: 0,0:15:57.12,0:15:58.08,Default,,0,0,0,,Хо
Dialogue: 0,0:16:01.79,0:16:03.17,Default,,0,0,0,,♬~
Dialogue: 0,0:16:03.17,0:16:05.00,Default,,0,0,0,,♬~
Dialogue: 0,0:16:03.17,0:16:05.00,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:05.46,0:16:07.09,Default,,0,0,0,,Мен бұны киемін… жетімдер үйінде өткізген күндерімді ұмытпау үшін.
Dialogue: 0,0:16:07.17,0:16:09.13,Default,,0,0,0,,Келесі кім?
Dialogue: 0,0:16:09.67,0:16:11.42,Default,,0,0,0,,Қазір 99 адам
Dialogue: 0,0:16:12.01,0:16:13.01,Default,,0,0,0,,Мәңгілік жаз?
Dialogue: 0,0:16:14.80,0:16:16.72,Default,,0,0,0,,Мен Цунека Аоимын
Dialogue: 0,0:16:17.01,0:16:18.01,Default,,0,0,0,,Корпус мүшелеріне бір-біріне негізсіз қылыш кезенуге мүлде болмайды!
Dialogue: 0,0:16:18.47,0:16:19.47,Default,,0,0,0,,Aoi?
Dialogue: 0,0:16:19.89,0:16:22.56,Default,,0,0,0,,О, сіздің Аои Бартомен қарым-қатынасыңыз бар ма?
Dialogue: 0,0:16:22.98,0:16:24.94,Default,,0,0,0,,Балто менің үлкен ағам.
Dialogue: 0,0:16:25.31,0:16:26.40,Default,,0,0,0,,Я~
Dialogue: 0,0:16:26.52,0:16:28.82,Default,,0,0,0,,Сонда менің ойымша, бұл сәл күштірек.
Dialogue: 0,0:16:29.19,0:16:30.73,Default,,0,0,0,,Егер сіз тырыссаңыз, түсінесіз
Dialogue: 0,0:16:31.40,0:16:34.28,Default,,0,0,0,,Мен сені бұрандалы тридентпен жеңемін!
Dialogue: 0,0:16:35.07,0:16:36.82,Default,,0,0,0,,Оның інісі?
Dialogue: 0,0:16:37.57,0:16:39.83,Default,,0,0,0,,Супер мотивация шығады!
Dialogue: 0,0:16:40.20,0:16:41.83,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:16:42.62,0:16:45.58,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:16:45.83,0:16:48.17,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:16:48.42,0:16:49.50,Default,,0,0,0,,♬~
Dialogue: 0,0:16:53.92,0:16:55.30,Default,,0,0,0,,Ахиллес! Шешіңіз!
Dialogue: 0,0:17:00.06,0:17:01.43,Default,,0,0,0,,Сіз шеше аласыз!
Dialogue: 0,0:17:01.81,0:17:05.27,Default,,0,0,0,,Триденттің резеңкесі барлық бағыттағы шабуылдардан қорғайды.
Dialogue: 0,0:17:05.39,0:17:07.31,Default,,0,0,0,,Оны айналу күшіне айналдыруға болады!
Dialogue: 0,0:17:08.65,0:17:10.57,Default,,0,0,0,,Бұрандалы есептегіш!
Dialogue: 0,0:17:17.70,0:17:18.70,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:17:18.78,0:17:20.08,Default,,0,0,0,,Бұрандалы үшбұрыш
Dialogue: 0,0:17:20.16,0:17:22.29,Default,,0,0,0,,Артық мәре үшін 1 ұпай
Dialogue: 0,0:17:23.25,0:17:24.29,Default,,0,0,0,,Жасайық
Dialogue: 0,0:17:24.79,0:17:26.42,Default,,0,0,0,,Келесі - жарылыс
Dialogue: 0,0:17:27.42,0:17:28.42,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:17:28.92,0:17:32.55,Default,,0,0,0,,«Барлық бағыттағы шабуылдарды қабылдау»…
Dialogue: 0,0:17:33.76,0:17:35.63,Default,,0,0,0,,Бұл туралы не деуге болады...?
Dialogue: 0,0:17:36.18,0:17:37.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:37.55,0:17:39.43,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:17:39.97,0:17:43.18,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:43.56,0:17:45.89,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:46.10,0:17:47.10,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:51.57,0:17:53.11,Default,,0,0,0,,Мен бұл жолы шешемін!
Dialogue: 0,0:17:56.45,0:17:58.53,Default,,0,0,0,,А, резеңке жақсы жұмыс істемейді.
Dialogue: 0,0:18:01.20,0:18:02.62,Default,,0,0,0,,Кеңейтілген драйвер
Dialogue: 0,0:18:03.33,0:18:07.08,Default,,0,0,0,,Биікті арттыру арқылы қарсыласқа жоғарыдан шабуыл жасауға болады.
Dialogue: 0,0:18:11.00,0:18:14.51,Default,,0,0,0,,Z Buster!
Dialogue: 0,0:18:16.34,0:18:17.42,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:17.97,0:18:20.43,Default,,0,0,0,,Z Ахиллестің жарылуы
Dialogue: 0,0:18:20.64,0:18:22.18,Default,,0,0,0,,Қызыл жүз Айганың жеңісі!
Dialogue: 0,0:18:22.97,0:18:24.68,Default,,0,0,0,,Қазір 100 адам
Dialogue: 0,0:18:25.02,0:18:27.23,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:18:27.35,0:18:28.77,Default,,0,0,0,,Тоқта! (Ичи) Ә? Мұнда ма?
Dialogue: 0,0:18:28.89,0:18:31.19,Default,,0,0,0,,Мұнда 200 адамды қалдырыңыз!
Dialogue: 0,0:18:33.44,0:18:35.82,Default,,0,0,0,,А... Капитан!
Dialogue: 0,0:18:37.07,0:18:38.65,Default,,0,0,0,,Ол шықты.
Dialogue: 0,0:18:39.40,0:18:40.82,Default,,0,0,0,,Суми Фубуки!
Dialogue: 0,0:18:40.95,0:18:42.57,Default,,0,0,0,,Мен Қызыл жүз Айгамын
Dialogue: 0,0:18:42.95,0:18:45.29,Default,,0,0,0,,Бұл менің серіктесім З Ахиллес
Dialogue: 0,0:18:45.45,0:18:46.91,Default,,0,0,0,,Менімен күрес!
Dialogue: 0,0:18:47.20,0:18:50.33,Default,,0,0,0,,Омені жеңіп, Жапонияда бірінші болыңыз.
Dialogue: 0,0:18:50.46,0:18:54.29,Default,,0,0,0,,Әрі қарай, әлемде Аои Балтты жеңіңіз!
Dialogue: 0,0:18:54.38,0:18:55.17,Default,,0,0,0,,Жаңа велосипедтің қуанышына ештеңе жетпейді, иә?
Dialogue: 0,0:18:55.63,0:18:56.88,Default,,0,0,0,,Bal-nii?
Dialogue: 0,0:18:58.26,0:19:00.88,Default,,0,0,0,,Мен көп сөйлейтін адамдарды жек көремін.
Dialogue: 0,0:19:01.51,0:19:04.72,Default,,0,0,0,,Мен бұл сенімді бөлшектеймін!
Dialogue: 0,0:19:04.81,0:19:07.22,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:10.10,0:19:15.07,Default,,0,0,0,,Фубукидің мұндай өрескел қарсыласпен шайқасуы сирек.
Dialogue: 0,0:19:16.53,0:19:18.65,Default,,0,0,0,,Бір-бірлеріңнің ұяшықтарын тексеріңдер
Dialogue: 0,0:19:22.20,0:19:24.07,Default,,0,0,0,,Император Форнеус
Dialogue: 0,0:19:24.87,0:19:26.91,Default,,0,0,0,,Акуланың бетіне ұқсайды
Dialogue: 0,0:19:28.41,0:19:32.58,Default,,0,0,0,,Ахиллес - мен жасаған ең күшті, жеңілмейтін, супер Зецубей.
Dialogue: 0,0:19:32.71,0:19:34.50,Default,,0,0,0,,Сіз орындадыңыз ба?
Dialogue: 0,0:19:34.75,0:19:35.75,Default,,0,0,0,,Хехе
Dialogue: 0,0:19:37.88,0:19:39.01,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:19:39.42,0:19:41.30,Default,,0,0,0,,Мен сені құртамын
Dialogue: 0,0:19:42.13,0:19:43.76,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:19:44.55,0:19:47.47,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:19:47.89,0:19:50.35,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:19:50.60,0:19:51.60,Default,,0,0,0,,♬~
Dialogue: 0,0:19:54.44,0:19:56.57,Default,,0,0,0,,Форнеус! Орталықты алыңыз!
Dialogue: 0,0:19:56.69,0:19:57.86,Default,,0,0,0,,Маған мұны істеуге рұқсат етіңіз!
Dialogue: 0,0:20:02.91,0:20:04.07,Default,,0,0,0,,Император гвардиясы!
Dialogue: 0,0:20:11.29,0:20:13.25,Default,,0,0,0,,Капитан, мінсіз қорғаныс.
Dialogue: 0,0:20:13.71,0:20:16.00,Default,,0,0,0,,Барлық шабуылдардың алдын алады
Dialogue: 0,0:20:17.63,0:20:18.50,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:19.25,0:20:21.26,Default,,0,0,0,,Сәттілік Ахиллес! сурет?
Dialogue: 0,0:20:21.72,0:20:23.76,Default,,0,0,0,,Жүр! Жоғалтпа!
Dialogue: 0,0:20:24.43,0:20:25.76,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:20:26.30,0:20:28.26,Default,,0,0,0,,Айга! Ұрысқа шоғырланыңыз!
Dialogue: 0,0:20:28.81,0:20:30.02,Default,,0,0,0,,Т… Мені ешкім қудалап жүрген жоқ еді.
Dialogue: 0,0:20:30.85,0:20:32.77,Default,,0,0,0,,Бұл осы жерден, Ахиллес!
Dialogue: 0,0:20:35.65,0:20:38.77,Default,,0,0,0,,Мен қылыш пен қалқанды қолдануға жарамдымын.
Dialogue: 0,0:20:38.90,0:20:40.73,Default,,0,0,0,,Сізде бар ма?
Dialogue: 0,0:20:41.36,0:20:42.36,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:42.49,0:20:45.49,Default,,0,0,0,,♬~
Dialogue: 0,0:20:50.12,0:20:52.45,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:20:52.54,0:20:53.54,Default,,0,0,0,,Ох… Уф~ Мен қатты ашпын.
Dialogue: 0,0:20:53.71,0:20:55.87,Default,,0,0,0,,Уау! Форнеус!
Dialogue: 0,0:20:59.92,0:21:02.05,Default,,0,0,0,,(айқай)
Dialogue: 0,0:21:03.59,0:21:05.05,Default,,0,0,0,,Z Ату!
Dialogue: 0,0:21:07.93,0:21:10.72,Default,,0,0,0,,♬~
Dialogue: 0,0:21:13.73,0:21:14.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:17.69,0:21:19.11,Default,,0,0,0,,Ха! Ах
Dialogue: 0,0:21:19.52,0:21:21.36,Default,,0,0,0,,А... Аа!
Dialogue: 0,0:21:22.03,0:21:24.49,Default,,0,0,0,,Z Ахиллес аяқталды
Dialogue: 0,0:21:24.61,0:21:26.24,Default,,0,0,0,,1-ден 0-ге дейінгі нүктелер
Dialogue: 0,0:21:26.32,0:21:27.74,Default,,0,0,0,,(дірілдеген дауыс)
Dialogue: 0,0:21:28.62,0:21:31.49,Default,,0,0,0,,Иә! Айга жеңді!
Dialogue: 0,0:21:31.62,0:21:33.29,Default,,0,0,0,,Сәйкестік 2 ұпай.
Dialogue: 0,0:21:33.41,0:21:37.67,Default,,0,0,0,,100 адамсыз шаршаған қандай жігіт.
Dialogue: 0,0:21:38.17,0:21:39.63,Default,,0,0,0,,Тағы бір нүкте!
Dialogue: 0,0:21:39.75,0:21:40.71,Default,,0,0,0,,О!
Dialogue: 0,0:21:43.76,0:21:46.38,Default,,0,0,0,,Қызыл жүз Айга...
Dialogue: 0,0:21:48.47,0:21:53.22,Default,,0,0,0,,Мен Super Zetsu, ең күшті және жеңілмейтінмін!
Dialogue: 0,0:21:54.77,0:22:00.77,Default,,0,0,0,,♪~
Dialogue: 0,0:23:16.77,0:23:22.77,Default,,0,0,0,,~♪
Dialogue: 0,0:23:25.19,0:23:28.11,Default,,0,0,0,,Дуэль! дуэль! Бұл дуэль!
Dialogue: 0,0:23:28.44,0:23:31.74,Default,,0,0,0,,Мен Ранбей тобының жетекшісі Ранжиро Киямамен шайқасамын!
Dialogue: 0,0:23:32.32,0:23:35.20,Default,,0,0,0,,Президент тіпті Фубукиді жеңген адам.
Dialogue: 0,0:23:35.53,0:23:37.24,Default,,0,0,0,,Ең күштісі қандай?
Dialogue: 0,0:23:37.49,0:23:40.75,Default,,0,0,0,,Рагнарук апатқа ұшырады! Бұл тіпті осар емес!
Dialogue: 0,0:23:40.91,0:23:43.29,Default,,0,0,0,,Келесі жолы «Beyblade Burst Super Zetsu»
Dialogue: 0,0:23:43.42,0:23:45.00,Default,,0,0,0,,«Күн бату дуэлі!!»
Dialogue: 0,0:23:45.54,0:23:46.96,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.05,0:23:48.80,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:50.30,0:23:56.30,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory