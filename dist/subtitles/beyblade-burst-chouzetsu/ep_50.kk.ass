Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.62,0:00:04.04,Default,,0,0,0,,Бейблейд
Dialogue: 0,0:00:04.17,0:00:08.17,Default,,0,0,0,,Мықты болуды мақсат еткен ұлдардың арманының жемісі.
Dialogue: 0,0:00:08.75,0:00:12.47,Default,,0,0,0,,Ал қазір супер Цетсу дәуірі қызып келеді.
Dialogue: 0,0:00:12.76,0:00:17.10,Default,,0,0,0,,Металл сауыт киіп, Беймен шытырман оқиғаға барыңыз!
Dialogue: 0,0:00:17.22,0:00:19.56,Default,,0,0,0,,Әлем чемпионы болуды мақсат етіңіз!
Dialogue: 0,0:00:19.68,0:00:23.64,Default,,0,0,0,,Super Zetsu Super Zetsu Super Zetsu!
Dialogue: 0,0:00:24.60,0:00:28.40,Default,,0,0,0,,Ең күшті және жеңілмейтін атағын алатын адам сенсің!
Dialogue: 0,0:00:31.32,0:00:35.20,Default,,0,0,0,,Осы Battle Burst матчында орындауға сұрау
Dialogue: 0,0:00:35.32,0:00:36.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:36.87,0:00:40.79,Default,,0,0,0,,Айғаны әбден қинамақшы.
Dialogue: 0,0:00:41.16,0:00:44.54,Default,,0,0,0,,Фи Ахиллесті құртуға тырысты!
Dialogue: 0,0:00:45.75,0:00:47.21,Default,,0,0,0,,Өлі үзіліс!
Dialogue: 0,0:00:52.59,0:00:54.55,Default,,0,0,0,,Ахиллді таң қалдырды!
Dialogue: 0,0:00:54.72,0:00:57.76,Default,,0,0,0,,Уууу!
Dialogue: 0,0:00:57.89,0:01:00.47,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:01:00.68,0:01:01.51,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:01:02.14,0:01:05.69,Default,,0,0,0,,Super Z Shield!
Dialogue: 0,0:01:11.69,0:01:14.03,Default,,0,0,0,,Мен сені құртамын!
Dialogue: 0,0:01:14.65,0:01:18.07,Default,,0,0,0,,Біз тек адамбыз; бәрі біз қалағандай бола бермейді.
Dialogue: 0,0:01:18.62,0:01:22.54,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:01:22.66,0:01:23.50,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:01:29.83,0:01:31.17,Default,,0,0,0,,Уау! Алақай!
Dialogue: 0,0:01:31.29,0:01:33.55,Default,,0,0,0,,Жоқ, жоқ! Бұл басқаша! Жоқ!
Dialogue: 0,0:01:33.67,0:01:34.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:34.67,0:01:36.67,Default,,0,0,0,,Жарылып кетпейді!
Dialogue: 0,0:01:36.80,0:01:40.09,Default,,0,0,0,,Феникстің сауыты енді ғана шешілді!
Dialogue: 0,0:01:42.18,0:01:44.64,Default,,0,0,0,,Не? Сол жарық
Dialogue: 0,0:01:46.52,0:01:48.27,Default,,0,0,0,,Қызықты
Dialogue: 0,0:01:49.35,0:01:55.36,Default,,0,0,0,,♪~
Dialogue: 0,0:03:12.69,0:03:18.69,Default,,0,0,0,,~♪
Dialogue: 0,0:03:23.78,0:03:25.24,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:03:25.37,0:03:27.49,Default,,0,0,0,,Қызыл жүз Айга аяқталды!
Dialogue: 0,0:03:27.62,0:03:30.08,Default,,0,0,0,,Бірақ бұл матч!
Dialogue: 0,0:03:30.20,0:03:32.46,Default,,0,0,0,,Ұпайлар әлі де 0-0.
Dialogue: 0,0:03:32.58,0:03:35.42,Default,,0,0,0,,Екі жақ бір-біріне көнбейді!
Dialogue: 0,0:03:36.50,0:03:38.63,Default,,0,0,0,,Бұл біздің байланысымыз!
Dialogue: 0,0:03:40.84,0:03:43.89,Default,,0,0,0,,Облигациялар! Бұл жақсы сөз
Dialogue: 0,0:03:44.18,0:03:47.14,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:03:47.64,0:03:49.64,Default,,0,0,0,,Ой… Бұл сәл ағаттық болды.
Dialogue: 0,0:03:49.93,0:03:52.14,Default,,0,0,0,,(Файдың күлкісі)
Dialogue: 0,0:03:52.77,0:03:55.27,Default,,0,0,0,,Не... бұл не?
Dialogue: 0,0:03:55.40,0:03:56.90,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:03:57.02,0:03:58.40,Default,,0,0,0,,Сіз ашуланған шығарсыз, солай ма?
Dialogue: 0,0:03:58.78,0:03:59.78,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:59.90,0:04:00.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:01.15,0:04:02.90,Default,,0,0,0,,Әлі де орын бар.
Dialogue: 0,0:04:05.24,0:04:06.45,Default,,0,0,0,,Феникс
Dialogue: 0,0:04:07.87,0:04:09.70,Default,,0,0,0,,Өйткені, Ахиллес
Dialogue: 0,0:04:09.83,0:04:13.46,Default,,0,0,0,,Бей сенімен ойнауға лайықты адам сияқты.
Dialogue: 0,0:04:14.58,0:04:18.63,Default,,0,0,0,,Мақтаймыз! Жақсы жұмыс, сен соншалықты күшті болып кеттің.
Dialogue: 0,0:04:19.50,0:04:22.88,Default,,0,0,0,,Бірақ Ахиллес екеуіңнің араларыңдағы байланыс
Dialogue: 0,0:04:23.51,0:04:25.64,Default,,0,0,0,,Бұл жерде кесіледі.
Dialogue: 0,0:04:25.89,0:04:28.64,Default,,0,0,0,,Мен және Феникс!
Dialogue: 0,0:04:30.43,0:04:31.89,Default,,0,0,0,,Не!
Dialogue: 0,0:04:32.14,0:04:35.14,Default,,0,0,0,,Бұл жолы мен оны қатты құртамын.
Dialogue: 0,0:04:36.52,0:04:37.65,Default,,0,0,0,,Ахиллес…
Dialogue: 0,0:04:37.77,0:04:39.77,Default,,0,0,0,,Бәрі жақсы болатынына сенімдімін.
Dialogue: 0,0:04:41.11,0:04:42.74,Default,,0,0,0,,Әзілдеме!
Dialogue: 0,0:04:42.86,0:04:45.49,Default,,0,0,0,,Айга! Бутчигире~!
Dialogue: 0,0:04:45.61,0:04:46.78,Default,,0,0,0,,Иә.
Dialogue: 0,0:04:46.91,0:04:48.03,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:04:48.41,0:04:50.87,Default,,0,0,0,,A-I-GA! Ааааааааааааааааа!
Dialogue: 0,0:04:50.99,0:04:53.33,Default,,0,0,0,,Оме және т.б. Сочоға барыңыз!
Dialogue: 0,0:04:53.45,0:04:54.29,Default,,0,0,0,,О!
Dialogue: 0,0:04:54.41,0:04:55.54,Default,,0,0,0,,A-I-GA!
Dialogue: 0,0:04:56.17,0:05:01.55,Default,,0,0,0,,Ах! Ааааааааааааааааа! Ааааааааааааааааа!
Dialogue: 0,0:05:04.22,0:05:05.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:08.14,0:05:11.26,Default,,0,0,0,,Барлығы сені жақтайды.
Dialogue: 0,0:05:13.18,0:05:14.23,Default,,0,0,0,,Сіз бақыттысыз ба?
Dialogue: 0,0:05:14.39,0:05:15.77,Default,,0,0,0,,Түсіндіңіз!
Dialogue: 0,0:05:16.64,0:05:20.48,Default,,0,0,0,,Жарайды, тағы да дәмін татыңыз.
Dialogue: 0,0:05:20.86,0:05:23.65,Default,,0,0,0,,Бұл соңғы рет болады!
Dialogue: 0,0:05:23.90,0:05:25.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:29.07,0:05:29.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:31.53,0:05:36.21,Default,,0,0,0,,Сіздің барлық нұрыңызды Феникс жұтып қояды.
Dialogue: 0,0:05:36.33,0:05:37.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:38.46,0:05:41.25,Default,,0,0,0,,Бұл... қандай сезімде?
Dialogue: 0,0:05:41.50,0:05:42.80,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:43.76,0:05:45.38,Default,,0,0,0,,Мен...
Dialogue: 0,0:05:50.55,0:05:52.68,Default,,0,0,0,,Қорықпа, Айға!
Dialogue: 0,0:05:55.43,0:05:56.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:58.39,0:06:00.19,Default,,0,0,0,,Өзің сияқты күрес!
Dialogue: 0,0:06:01.11,0:06:04.44,Default,,0,0,0,,Ахиллеспен шайқастан ләззат алыңыз!
Dialogue: 0,0:06:05.28,0:06:07.32,Default,,0,0,0,,Ахиллестің дауысын көбірек тыңдаңыз
Dialogue: 0,0:06:07.82,0:06:09.53,Default,,0,0,0,,Оған төзе алатыныңызға сенімдімін.
Dialogue: 0,0:06:09.86,0:06:12.62,Default,,0,0,0,,Жылама! Ақымақ, Косей! Енді мен де…
Dialogue: 0,0:06:13.74,0:06:14.62,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:14.74,0:06:17.91,Default,,0,0,0,,Мен жұтылып кете ме деп қорқамын!
Dialogue: 0,0:06:19.96,0:06:23.63,Default,,0,0,0,,Біздің байланысымыз ешқашан үзілмейді
Dialogue: 0,0:06:24.09,0:06:25.63,Default,,0,0,0,,Мүлдем!
Dialogue: 0,0:06:26.67,0:06:27.63,Default,,0,0,0,,Күшті шайқас
Dialogue: 0,0:06:28.17,0:06:29.55,Default,,0,0,0,,Осымен жүр!
Dialogue: 0,0:06:37.60,0:06:42.40,Default,,0,0,0,,Түсіндім... Сіз бақыттысыз ба? Өлі Феникс
Dialogue: 0,0:06:45.86,0:06:47.78,Default,,0,0,0,,Айга жүргізушіні көтерді
Dialogue: 0,0:06:48.53,0:06:50.28,Default,,0,0,0,,Мен стратегиямды өзгертемін!
Dialogue: 0,0:06:50.40,0:06:52.41,Default,,0,0,0,,Оны қорғау керек емес пе?
Dialogue: 0,0:06:52.53,0:06:56.16,Default,,0,0,0,,Олай болса, арнайы дайындықтан өтудің қажеті жоқ.
Dialogue: 0,0:06:57.37,0:06:59.08,Default,,0,0,0,,Сіз не ойладыңыз!
Dialogue: 0,0:06:59.54,0:07:01.54,Default,,0,0,0,,Не? Ол жігіт...
Dialogue: 0,0:07:01.67,0:07:02.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:02.63,0:07:03.79,Default,,0,0,0,,Күлімсіреу
Dialogue: 0,0:07:04.04,0:07:05.17,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:07:05.88,0:07:07.46,Default,,0,0,0,,Бұл Айға
Dialogue: 0,0:07:07.84,0:07:08.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:09.67,0:07:11.59,Default,,0,0,0,,Мен интуиция бойынша әрекет етемін.
Dialogue: 0,0:07:12.55,0:07:16.18,Default,,0,0,0,,Ол сондай-ақ осындай кездерде ең күшті болды.
Dialogue: 0,0:07:20.39,0:07:21.94,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:07:22.48,0:07:25.69,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:07:25.86,0:07:28.99,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:07:29.19,0:07:30.15,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:38.16,0:07:41.21,Default,,0,0,0,,Super Z түсірілімі!
Dialogue: 0,0:07:43.83,0:07:46.92,Default,,0,0,0,,Бұл жолы Ахиллес шабуыл жасады!
Dialogue: 0,0:07:47.04,0:07:49.67,Default,,0,0,0,,Шабуыл шабуыл шабуылы!
Dialogue: 0,0:07:50.80,0:07:52.68,Default,,0,0,0,,Барлығымыз
Dialogue: 0,0:07:52.80,0:07:54.59,Default,,0,0,0,,Бұл шабуылды қолданыңыз!
Dialogue: 0,0:08:01.48,0:08:04.48,Default,,0,0,0,,Дұрыс, көбірек шабуыл жасаңыз!
Dialogue: 0,0:08:04.60,0:08:06.98,Default,,0,0,0,,Феникс бақытты!
Dialogue: 0,0:08:07.15,0:08:08.94,Default,,0,0,0,,Жүр!
Dialogue: 0,0:08:09.19,0:08:10.57,Default,,0,0,0,,Жақсы, Айга!
Dialogue: 0,0:08:10.69,0:08:12.57,Default,,0,0,0,,Тек шешіңіз!
Dialogue: 0,0:08:13.07,0:08:14.82,Default,,0,0,0,,Бұл жаман (2 адам) Иә?
Dialogue: 0,0:08:15.20,0:08:18.33,Default,,0,0,0,,Феникс Super Z-Wing-ге ұмтылуда
Dialogue: 0,0:08:25.58,0:08:27.21,Default,,0,0,0,,Финал жақындап қалды!
Dialogue: 0,0:08:27.46,0:08:29.21,Default,,0,0,0,,Мен осылай өтемін!
Dialogue: 0,0:08:29.59,0:08:31.34,Default,,0,0,0,,Ахиллес~!
Dialogue: 0,0:08:33.22,0:08:37.39,Default,,0,0,0,,Ват! Феникстің сауыты шешілді!
Dialogue: 0,0:08:40.56,0:08:41.72,Default,,0,0,0,,Феникс!
Dialogue: 0,0:08:44.81,0:08:46.27,Default,,0,0,0,,(Феникс Роар)
Dialogue: 0,0:08:49.77,0:08:51.07,Default,,0,0,0,,Өлі Стингер!
Dialogue: 0,0:08:53.57,0:08:55.03,Default,,0,0,0,,Феникс Өлі Стингер
Dialogue: 0,0:08:55.15,0:08:57.07,Default,,0,0,0,,Ахиллеске бет алды!
Dialogue: 0,0:08:57.24,0:08:59.33,Default,,0,0,0,,Бұл болжам!
Dialogue: 0,0:08:59.99,0:09:01.41,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:09:01.70,0:09:04.75,Default,,0,0,0,,Super Z Shield!
Dialogue: 0,0:09:10.75,0:09:11.59,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:09:12.05,0:09:14.59,Default,,0,0,0,,Бірақ Ахиллес таң қалдырады!
Dialogue: 0,0:09:14.84,0:09:15.68,Default,,0,0,0,,(жүрек соғысы)
Dialogue: 0,0:09:15.88,0:09:19.76,Default,,0,0,0,,Феникстің жойылуы!
Dialogue: 0,0:09:20.85,0:09:23.98,Default,,0,0,0,,Қос өлі Стингер!
Dialogue: 0,0:09:24.14,0:09:24.98,Default,,0,0,0,,Келе жатыр!
Dialogue: 0,0:09:25.35,0:09:27.90,Default,,0,0,0,,Додж!
Dialogue: 0,0:09:30.36,0:09:31.44,Default,,0,0,0,,Уф!Қарғыс атқыр...
Dialogue: 0,0:09:31.65,0:09:33.86,Default,,0,0,0,,Өлі Стингер Пресс!
Dialogue: 0,0:09:33.99,0:09:34.90,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:09:35.44,0:09:37.45,Default,,0,0,0,,Фи осыны мақсат етті!
Dialogue: 0,0:09:37.57,0:09:40.99,Default,,0,0,0,,Бұл жойылу құдайының балғасы!
Dialogue: 0,0:09:45.62,0:09:47.21,Default,,0,0,0,,(Феникс Роар)
Dialogue: 0,0:09:52.30,0:09:54.80,Default,,0,0,0,,Ахиллес~!
Dialogue: 0,0:09:58.26,0:09:59.09,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:59.43,0:10:01.10,Default,,0,0,0,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:10:02.26,0:10:04.89,Default,,0,0,0,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:10:05.02,0:10:07.77,Default,,0,0,0,,Шешілді! (Файдың күлуі)
Dialogue: 0,0:10:07.89,0:10:08.73,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:09.73,0:10:11.15,Default,,0,0,0,,Ха... а...
Dialogue: 0,0:10:14.90,0:10:17.40,Default,,0,0,0,,Не! Жарылу емес!
Dialogue: 0,0:10:17.90,0:10:20.07,Default,,0,0,0,,Мен аман қалдым!
Dialogue: 0,0:10:20.74,0:10:21.66,Default,,0,0,0,,Бұл менің орта мектептегі алғашқы күнім еді және мен қатты қобалжыдым…
Dialogue: 0,0:10:21.91,0:10:25.08,Default,,0,0,0,,Өлі Феникс аяқталды
Dialogue: 0,0:10:25.79,0:10:29.33,Default,,0,0,0,,Ұпайлар 0-ден 0-ге дейін. Шайқас жалғасуда!
Dialogue: 0,0:10:29.50,0:10:30.67,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:10:30.96,0:10:31.79,Default,,0,0,0,,Хаа…
Dialogue: 0,0:10:31.92,0:10:34.17,Default,,0,0,0,,Мен ұрып қалдым деп ойладым.
Dialogue: 0,0:10:34.30,0:10:35.67,Default,,0,0,0,,Attaimo...
Dialogue: 0,0:10:35.80,0:10:38.30,Default,,0,0,0,,Енді... не болды?
Dialogue: 0,0:10:38.80,0:10:43.47,Default,,0,0,0,,Келіңіздер! Ағымдағы шайқасты баяу қозғалыста қайта көрейік!
Dialogue: 0,0:10:43.60,0:10:47.18,Default,,0,0,0,,Феникстің өлі шаншуы Ахиллеске жақындады
Dialogue: 0,0:10:47.31,0:10:49.10,Default,,0,0,0,,Бітті деп ойлаған кезде
Dialogue: 0,0:10:49.23,0:10:52.73,Default,,0,0,0,,О? Ахиллес осында қатты сүйенеді
Dialogue: 0,0:10:52.86,0:10:55.90,Default,,0,0,0,,Жүргізуші стадионды қатты теуіп,...
Dialogue: 0,0:10:56.03,0:10:57.82,Default,,0,0,0,,Кенет үдеу!
Dialogue: 0,0:10:57.94,0:10:59.57,Default,,0,0,0,,Шабуылдан әрең құтылыңыз
Dialogue: 0,0:10:59.70,0:11:03.07,Default,,0,0,0,,Сол соққы мен екпінмен мен стадионнан тіке ұшып кеттім!
Dialogue: 0,0:11:03.32,0:11:05.95,Default,,0,0,0,,Ол жүргізушіні жоғарылату үшін жұмыс істеді.
Dialogue: 0,0:11:06.08,0:11:08.75,Default,,0,0,0,,Бұл Айғаның түйсігі
Dialogue: 0,0:11:08.87,0:11:09.71,Default,,0,0,0,,Иә
Dialogue: 0,0:11:10.62,0:11:14.17,Default,,0,0,0,,Ахиллес, сен керемет жұмыс жасадың.
Dialogue: 0,0:11:26.31,0:11:28.43,Default,,0,0,0,,Қызыл жүз... Айга
Dialogue: 0,0:11:30.18,0:11:31.44,Default,,0,0,0,,Бесінші шайқас
Dialogue: 0,0:11:33.23,0:11:34.31,Default,,0,0,0,,Феникс
Dialogue: 0,0:11:35.77,0:11:39.94,Default,,0,0,0,,Жүрегіңнің жойылуынан ләззат ал
Dialogue: 0,0:11:40.90,0:11:42.07,Default,,0,0,0,,Ахиллес
Dialogue: 0,0:11:43.24,0:11:44.82,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:11:49.62,0:11:52.50,Default,,0,0,0,,Уууу!
Dialogue: 0,0:11:53.46,0:11:55.42,Default,,0,0,0,,Хехе... Жақсы.
Dialogue: 0,0:11:56.09,0:11:57.42,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:11:58.09,0:12:01.17,Default,,0,0,0,,Уууу!
Dialogue: 0,0:12:01.30,0:12:04.18,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:09.64,0:12:12.60,Default,,0,0,0,,Айга шайқасы қызықты ма?
Dialogue: 0,0:12:13.27,0:12:15.23,Default,,0,0,0,,Ой, қызық екен.
Dialogue: 0,0:12:16.19,0:12:17.48,Default,,0,0,0,,Мен де
Dialogue: 0,0:12:19.32,0:12:23.36,Default,,0,0,0,,Сіз Оменің қылыш пен қалқанын жақсы пайдаланасыз, солай ма?
Dialogue: 0,0:12:23.49,0:12:24.32,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:26.12,0:12:26.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:27.37,0:12:30.45,Default,,0,0,0,,Сіз көп нәрсені жасай алуыңыз керек.
Dialogue: 0,0:12:40.59,0:12:41.46,Default,,0,0,0,,О
Dialogue: 0,0:12:42.01,0:12:45.13,Default,,0,0,0,,Біз көп нәрсені істей аламыз!
Dialogue: 0,0:12:52.85,0:12:54.48,Default,,0,0,0,,Мен ең күшті және жеңілмейтін боламын!
Dialogue: 0,0:12:54.60,0:12:57.73,Default,,0,0,0,,Ахиллес Мен сені міндетті түрде күшейтемін.
Dialogue: 0,0:12:57.86,0:13:01.32,Default,,0,0,0,,Ахиллді сындырған мен едім.
Dialogue: 0,0:13:01.44,0:13:05.45,Default,,0,0,0,,Дұрыс, бұл сіздің Бейблейдіңіз!
Dialogue: 0,0:13:11.37,0:13:13.00,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:13:13.83,0:13:15.12,Default,,0,0,0,,Бітті
Dialogue: 0,0:13:19.67,0:13:21.25,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:13:21.71,0:13:25.01,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:13:25.22,0:13:27.59,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:28.05,0:13:29.14,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:32.77,0:13:34.60,Default,,0,0,0,,Жүр!
Dialogue: 0,0:13:35.56,0:13:36.81,Default,,0,0,0,,Өлі үзіліс!
Dialogue: 0,0:13:39.27,0:13:42.48,Default,,0,0,0,,Super Z Buster!
Dialogue: 0,0:13:44.11,0:13:47.78,Default,,0,0,0,,Екі шығанақ қатты соқтығысты!
Dialogue: 0,0:13:49.87,0:13:51.53,Default,,0,0,0,,Мен Жоюдың Құдайымын
Dialogue: 0,0:13:51.66,0:13:55.16,Default,,0,0,0,,Құдайды ештеңе жеңе алмайды! Феникс!
Dialogue: 0,0:13:59.63,0:14:02.29,Default,,0,0,0,,Уууу!
Dialogue: 0,0:14:02.42,0:14:04.67,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:14:05.84,0:14:08.47,Default,,0,0,0,,Ооо...
Dialogue: 0,0:14:08.59,0:14:09.43,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:09.72,0:14:12.76,Default,,0,0,0,,Super Z қорғанысы!
Dialogue: 0,0:14:16.23,0:14:17.31,Default,,0,0,0,,Ахиллес
Dialogue: 0,0:14:17.43,0:14:19.94,Default,,0,0,0,,Феникс сауыты кері қайтарылды!
Dialogue: 0,0:14:20.65,0:14:23.23,Default,,0,0,0,,Қос өлі Стингер!
Dialogue: 0,0:14:26.53,0:14:29.61,Default,,0,0,0,,Алланың алдында бас иіңдер!
Dialogue: 0,0:14:35.54,0:14:37.12,Default,,0,0,0,,Ах! Не...
Dialogue: 0,0:14:37.29,0:14:38.12,Default,,0,0,0,,Жылау
Dialogue: 0,0:14:38.54,0:14:42.75,Default,,0,0,0,,Diving Dead Stinger Press!
Dialogue: 0,0:14:43.79,0:14:45.00,Default,,0,0,0,,Сенгісіз!
Dialogue: 0,0:14:45.50,0:14:50.51,Default,,0,0,0,,Мынау... Қиратушы құдайдың құдіреті осы ма?
Dialogue: 0,0:15:02.15,0:15:04.15,Default,,0,0,0,,Біздің байланысымыз...
Dialogue: 0,0:15:04.57,0:15:06.44,Default,,0,0,0,,Ол жойылмайды!
Dialogue: 0,0:15:10.03,0:15:13.78,Default,,0,0,0,,Super Z Shield!
Dialogue: 0,0:15:17.66,0:15:20.00,Default,,0,0,0,,Уууу!
Dialogue: 0,0:15:20.46,0:15:23.38,Default,,0,0,0,,Ахиллес пен Феникс қақтығысады!
Dialogue: 0,0:15:23.58,0:15:24.63,Default,,0,0,0,,Жарылу!
Dialogue: 0,0:15:24.75,0:15:27.88,Default,,0,0,0,,Ахиллес қайтадан созылды!
Dialogue: 0,0:15:28.01,0:15:31.88,Default,,0,0,0,,Ал Феникс қайтадан қалықтады!
Dialogue: 0,0:15:32.43,0:15:37.10,Default,,0,0,0,,Қызыл жүз Айга~!
Dialogue: 0,0:15:39.68,0:15:46.57,Default,,0,0,0,,Соңғы өлі әсер!
Dialogue: 0,0:15:51.74,0:15:53.61,Default,,0,0,0,,Уууу!
Dialogue: 0,0:15:56.83,0:15:57.66,Default,,0,0,0,,Не!
Dialogue: 0,0:15:57.91,0:15:59.20,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:15:59.58,0:16:00.54,Default,,0,0,0,,Сонымен бірге ол фонды да бір уақытта салып жатыр!
Dialogue: 0,0:16:05.17,0:16:07.29,Default,,0,0,0,,Кеттік, Айға!
Dialogue: 0,0:16:07.42,0:16:08.63,Default,,0,0,0,,О!
Dialogue: 0,0:16:10.05,0:16:14.05,Default,,0,0,0,,(Танжиро) Ал, баста! (Үшеуі) Бар күшіңді сал!
Dialogue: 0,0:16:19.31,0:16:21.93,Default,,0,0,0,,Жүр!
Dialogue: 0,0:16:22.31,0:16:26.86,Default,,0,0,0,,Super Z қылыш!
Dialogue: 0,0:16:27.06,0:16:27.90,Default,,0,0,0,,Әй!
Dialogue: 0,0:16:36.12,0:16:38.95,Default,,0,0,0,,Гяааах!
Dialogue: 0,0:16:42.50,0:16:44.16,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:16:44.29,0:16:46.71,Default,,0,0,0,,Жарылыс! Жарылыс~!
Dialogue: 0,0:16:46.83,0:16:51.01,Default,,0,0,0,,(Тікелей түсініктеменің жаңғырық дыбысы)
Dialogue: 0,0:16:52.34,0:16:53.17,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:16:54.05,0:16:57.01,Default,,0,0,0,,Super Z Ахиллестің жарылуы
Dialogue: 0,0:16:57.39,0:16:59.14,Default,,0,0,0,,Қызыл жүз Айганың жеңісі!
Dialogue: 0,0:16:59.26,0:17:01.35,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:01.60,0:17:04.10,Default,,0,0,0,,Ахиллес жеңді!
Dialogue: 0,0:17:04.23,0:17:08.23,Default,,0,0,0,,Бұл қызыл супер Цетсу бала, Айга Акабане~!
Dialogue: 0,0:17:09.06,0:17:10.48,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:10.86,0:17:12.40,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:17:12.53,0:17:13.99,Default,,0,0,0,,Мен таң қалдым!
Dialogue: 0,0:17:14.32,0:17:15.40,Default,,0,0,0,,Өте ақылсыз
Dialogue: 0,0:17:15.53,0:17:17.24,Default,,0,0,0,,Тым қауіпті!
Dialogue: 0,0:17:17.49,0:17:18.91,Default,,0,0,0,,Керемет Айга!
Dialogue: 0,0:17:19.03,0:17:20.74,Default,,0,0,0,,Саған жақсы, Нару.
Dialogue: 0,0:17:21.37,0:17:23.12,Default,,0,0,0,,Оу! Екінші оқ сәл қалды!
Dialogue: 0,0:17:23.25,0:17:24.83,Default,,0,0,0,,Буси!
Dialogue: 0,0:17:26.62,0:17:29.84,Default,,0,0,0,,Мен сіздің Бейблейдіңізді таптым.
Dialogue: 0,0:17:31.09,0:17:32.21,Default,,0,0,0,,Айга…
Dialogue: 0,0:17:33.21,0:17:34.59,Default,,0,0,0,,Жақсы
Dialogue: 0,0:17:35.72,0:17:39.09,Default,,0,0,0,,Мұның бәрі Ахиллеспен байланыс үшін...
Dialogue: 0,0:17:41.81,0:17:45.06,Default,,0,0,0,,Айға, сен шынымен күшті болып кеттің.
Dialogue: 0,0:17:45.18,0:17:46.19,Default,,0,0,0,,О
Dialogue: 0,0:17:48.35,0:17:50.11,Default,,0,0,0,,Көңілім көтеріліп барады.
Dialogue: 0,0:17:52.32,0:17:55.44,Default,,0,0,0,,Рахмет, Ахиллес.
Dialogue: 0,0:17:58.24,0:17:59.45,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:17:59.57,0:18:03.20,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:06.08,0:18:09.67,Default,,0,0,0,,Неліктен? Неге... мен жеңілдім
Dialogue: 0,0:18:10.46,0:18:12.34,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:18:12.59,0:18:14.96,Default,,0,0,0,,Мен және Ахиллес!
Dialogue: 0,0:18:16.09,0:18:18.22,Default,,0,0,0,,Super Zetsu - ең күшті...
Dialogue: 0,0:18:18.63,0:18:20.22,Default,,0,0,0,,Жеңілмейтін!
Dialogue: 0,0:18:20.47,0:18:22.22,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:22.47,0:18:26.23,Default,,0,0,0,,Бізге керемет шайқас көрсеткен екі жүзге
Dialogue: 0,0:18:26.35,0:18:27.73,Default,,0,0,0,,Қол шапалақтау!
Dialogue: 0,0:18:27.85,0:18:30.15,Default,,0,0,0,,Рахмет! Кездескенше!
Dialogue: 0,0:18:35.40,0:18:36.36,Default,,0,0,0,,Phi!
Dialogue: 0,0:18:45.08,0:18:46.20,Default,,0,0,0,,Мен ұмытып қалдым.
Dialogue: 0,0:18:50.96,0:18:51.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:56.09,0:18:56.92,Default,,0,0,0,,Phi!
Dialogue: 0,0:19:00.43,0:19:02.80,Default,,0,0,0,,Мен, бұл қызық болды!
Dialogue: 0,0:19:11.10,0:19:11.98,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:19:14.69,0:19:16.32,Default,,0,0,0,,Бұл жақсы келісім
Dialogue: 0,0:19:16.94,0:19:18.82,Default,,0,0,0,,Сен мұнда күлу үшін келдің бе?
Dialogue: 0,0:19:18.94,0:19:23.24,Default,,0,0,0,,А... Бұл өте аянышты, тіпті күлгім де келмейді.
Dialogue: 0,0:19:23.70,0:19:24.53,Default,,0,0,0,,Не!
Dialogue: 0,0:19:24.91,0:19:27.62,Default,,0,0,0,,Жоғалтып, өз шығанағыңызды соғыңыз ба?
Dialogue: 0,0:19:27.74,0:19:29.54,Default,,0,0,0,,Ол кішкентай жігіт.
Dialogue: 0,0:19:29.83,0:19:30.66,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:30.79,0:19:34.54,Default,,0,0,0,,Неліктен жеңілгеніңізді әлі түсінбейсіз.
Dialogue: 0,0:19:34.67,0:19:36.04,Default,,0,0,0,,Оның сізге қатысы жоқ!
Dialogue: 0,0:19:36.17,0:19:37.55,Default,,0,0,0,,Бұл байланысты!
Dialogue: 0,0:19:39.42,0:19:41.05,Default,,0,0,0,,Өлі Фениксте бар
Dialogue: 0,0:19:41.76,0:19:44.30,Default,,0,0,0,,Онда Аидтың бір бөлігі бар!
Dialogue: 0,0:19:45.43,0:19:49.39,Default,,0,0,0,,Түсіндің бе? Менің жеңілісімнің себебі
Dialogue: 0,0:19:49.52,0:19:52.94,Default,,0,0,0,,Хе! өзің ойла
Dialogue: 0,0:19:57.65,0:19:59.19,Default,,0,0,0,,Айга~!
Dialogue: 0,0:20:00.03,0:20:01.86,Default,,0,0,0,,Айга~!
Dialogue: 0,0:20:03.78,0:20:05.99,Default,,0,0,0,,Әй, Айға!
Dialogue: 0,0:20:09.95,0:20:13.33,Default,,0,0,0,,Айға! Мен сені іздедім.
Dialogue: 0,0:20:13.71,0:20:14.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:15.13,0:20:18.25,Default,,0,0,0,,Сіз ұйықтап жатырсыз ба? Мен көмектесе алмаймын
Dialogue: 0,0:20:20.84,0:20:21.80,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:22.09,0:20:25.51,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:20:33.60,0:20:34.69,Default,,0,0,0,,Нару
Dialogue: 0,0:20:35.65,0:20:39.86,Default,,0,0,0,,Айға менің ағам болғанына өте қуаныштымын.
Dialogue: 0,0:20:43.78,0:20:45.24,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:20:47.24,0:20:48.33,Default,,0,0,0,,Хехе
Dialogue: 0,0:20:48.99,0:20:49.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:51.45,0:20:52.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:52.66,0:20:54.12,Default,,0,0,0,,Тынш!
Dialogue: 0,0:21:04.97,0:21:08.10,Default,,0,0,0,,Әй... Айга, оян!
Dialogue: 0,0:21:08.35,0:21:09.97,Default,,0,0,0,,Wake up!
Dialogue: 0,0:21:10.31,0:21:14.77,Default,,0,0,0,,Уф... не деген, мен ұйықтап жатырмын~
Dialogue: 0,0:21:15.31,0:21:17.69,Default,,0,0,0,,Келесі матч анықталды!
Dialogue: 0,0:21:17.81,0:21:19.48,Default,,0,0,0,,Иә! қазірдің өзінде?
Dialogue: 0,0:21:19.90,0:21:22.57,Default,,0,0,0,,Келесі кезекте әлем чемпионы үшін матч.
Dialogue: 0,0:21:22.78,0:21:26.74,Default,,0,0,0,,А... Мен Балтомен біргемін бе?
Dialogue: 0,0:21:28.28,0:21:29.99,Default,,0,0,0,,Куууу…
Dialogue: 0,0:21:38.04,0:21:39.17,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:21:39.84,0:21:42.67,Default,,0,0,0,,Уууу!
Dialogue: 0,0:21:42.80,0:21:45.47,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:21:54.47,0:22:00.48,Default,,0,0,0,,♪~
Dialogue: 0,0:23:17.97,0:23:23.98,Default,,0,0,0,,~♪
Dialogue: 0,0:23:25.32,0:23:28.28,Default,,0,0,0,,Не? Валькири: Сіз өтірік айтасыз, солай ма?
Dialogue: 0,0:23:29.32,0:23:33.70,Default,,0,0,0,,Мен және Балто арасындағы титулдық кездесу күтпеген супер шайқас болады!
Dialogue: 0,0:23:34.53,0:23:38.12,Default,,0,0,0,,Мен супер Цетсу боламын, ең күшті және жеңілмейтін!
Dialogue: 0,0:23:39.33,0:23:41.75,Default,,0,0,0,,Келесі жолы «Beyblade Burst Super Zetsu»
