Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.75,0:00:04.04,Default,,0,0,0,,Бейблейд
Dialogue: 0,0:00:04.17,0:00:08.13,Default,,0,0,0,,Мықты болуды мақсат еткен ұлдардың арманының жемісі.
Dialogue: 0,0:00:08.96,0:00:12.42,Default,,0,0,0,,Енді супер Цетсу дәуірі басталады.
Dialogue: 0,0:00:12.55,0:00:16.80,Default,,0,0,0,,Металл сауытыңызды киіңіз де, Беймен шытырман оқиғаға аттаныңыз!
Dialogue: 0,0:00:16.93,0:00:19.26,Default,,0,0,0,,Әлем чемпионы болуды мақсат етіңіз!
Dialogue: 0,0:00:19.39,0:00:23.69,Default,,0,0,0,,Super Zetsu Super Zetsu Super Zetsu!
Dialogue: 0,0:00:24.27,0:00:27.90,Default,,0,0,0,,Ең күшті және жеңілмейтін атағын алатын адам сенсің!
Dialogue: 0,0:00:42.20,0:00:45.62,Default,,0,0,0,,«Егер қалағаныңды қаласаң, шығысқа қарай жүр».
Dialogue: 0,0:00:50.75,0:00:52.80,Default,,0,0,0,,Мен сәттілікке қол жеткіздім.
Dialogue: 0,0:00:53.92,0:00:55.43,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:00:57.18,0:00:58.01,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:01:03.93,0:01:06.14,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:01:23.37,0:01:29.38,Default,,0,0,0,,♪~
Dialogue: 0,0:02:46.12,0:02:52.13,Default,,0,0,0,,~♪
Dialogue: 0,0:02:53.21,0:02:55.80,Default,,0,0,0,,«Super Zetsu финалы»
Dialogue: 0,0:02:56.80,0:02:59.84,Default,,0,0,0,,Жарайды! ұлдар мен қыздар
Dialogue: 0,0:02:59.92,0:03:01.47,Default,,0,0,0,,Көңіліңіз толқып тұр ма?
Dialogue: 0,0:03:01.72,0:03:04.01,Default,,0,0,0,,Super Beyblade титулының сәйкестігі
Dialogue: 0,0:03:04.10,0:03:06.85,Default,,0,0,0,,Чемпион Балт Аои В.С
Dialogue: 0,0:03:06.93,0:03:11.27,Default,,0,0,0,,Біз сізге қарсылас Сиско Карлайлдың жекпе-жегін ұсынамыз!
Dialogue: 0,0:03:11.35,0:03:13.56,Default,,0,0,0,,Ұпай 2-ден 1-ге дейін. Күтуге қарама-қайшы...
Dialogue: 0,0:03:13.65,0:03:15.86,Default,,0,0,0,,Cisco Carlyle жетекші орында
Dialogue: 0,0:03:15.94,0:03:17.19,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:03:17.73,0:03:19.90,Default,,0,0,0,,Эль-Санто өркендеп келеді.
Dialogue: 0,0:03:20.24,0:03:22.41,Default,,0,0,0,,Аа, сен маған тамырлассың.
Dialogue: 0,0:03:22.70,0:03:24.78,Default,,0,0,0,,Бұл менмін. Бұл мен.
Dialogue: 0,0:03:25.16,0:03:27.49,Default,,0,0,0,,Екеуің бір командадасыңдар, солай ма?
Dialogue: 0,0:03:27.58,0:03:30.83,Default,,0,0,0,,А, Сочоның ағасы да сонда, Б.С. Соль.
Dialogue: 0,0:03:30.91,0:03:32.75,Default,,0,0,0,,Командаластың қарсыласуы?
Dialogue: 0,0:03:33.12,0:03:35.79,Default,,0,0,0,,Аои Балт бұрышта тұр.
Dialogue: 0,0:03:36.04,0:03:38.30,Default,,0,0,0,,Cisco көбірек серпінге ие.
Dialogue: 0,0:03:38.63,0:03:39.67,Default,,0,0,0,,Бар-нии (Хинацу Аои) Нии-чан
Dialogue: 0,0:03:40.13,0:03:42.43,Default,,0,0,0,,Балалар сендер мүлде түсінбейсіңдер.
Dialogue: 0,0:03:42.88,0:03:43.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:44.14,0:03:46.30,Default,,0,0,0,,Cisco - бұл бұрышта.
Dialogue: 0,0:03:46.64,0:03:48.43,Default,,0,0,0,,Оны итеріп тұрған – Балто.
Dialogue: 0,0:03:48.64,0:03:49.68,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:03:50.23,0:03:51.94,Default,,0,0,0,,Айға дұрыс айтады.
Dialogue: 0,0:03:52.60,0:03:55.36,Default,,0,0,0,,Балт-сенпайда әлі біраз күш бар.
Dialogue: 0,0:03:55.69,0:03:57.23,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:03:57.32,0:04:00.24,Default,,0,0,0,,Мен сені жеңгенше жеңілуге ​​жол бермеймін.
Dialogue: 0,0:04:01.32,0:04:02.36,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:04:04.16,0:04:05.87,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:04:06.24,0:04:09.49,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:04:09.70,0:04:12.00,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:04:12.37,0:04:13.37,Default,,0,0,0,,Ох… Уф~ Мен қатты ашпын.
Dialogue: 0,0:04:15.88,0:04:17.38,Default,,0,0,0,,Тез ату!
Dialogue: 0,0:04:17.46,0:04:18.84,Default,,0,0,0,,Валькирия
Dialogue: 0,0:04:18.96,0:04:21.34,Default,,0,0,0,,Орталықтағы Шайтанға шабуыл Шабуыл~!
Dialogue: 0,0:04:21.42,0:04:22.17,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:04:22.38,0:04:23.17,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:04:23.80,0:04:26.34,Default,,0,0,0,,Жеңімпаз ату!
Dialogue: 0,0:04:26.64,0:04:28.68,Default,,0,0,0,,Валькиридің траекториясы өзгерді
Dialogue: 0,0:04:28.76,0:04:32.10,Default,,0,0,0,,Вулкандық жүргізуші азу тістерін ашады!
Dialogue: 0,0:04:32.77,0:04:35.52,Default,,0,0,0,,Урья! Ролик дрейф!
Dialogue: 0,0:04:36.94,0:04:38.65,Default,,0,0,0,,Шайтан жалтарып кетті!
Dialogue: 0,0:04:38.73,0:04:39.61,Default,,0,0,0,,А... иә?
Dialogue: 0,0:04:41.86,0:04:42.74,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:43.19,0:04:45.86,Default,,0,0,0,,Жеңіс реактивті ату!
Dialogue: 0,0:04:46.11,0:04:47.53,Default,,0,0,0,,Жүр!
Dialogue: 0,0:04:55.00,0:04:55.83,Default,,0,0,0,,Мен оны бетіңе орап тастаймын да, біраз уақыт бойы шешіп ала алмайтындай қылып қоямын!
Dialogue: 0,0:04:56.21,0:04:57.04,Default,,0,0,0,,Не!
Dialogue: 0,0:05:00.88,0:05:01.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:05.51,0:05:07.68,Default,,0,0,0,,Valkyrie Burst Finish жеңімпазы
Dialogue: 0,0:05:07.76,0:05:11.14,Default,,0,0,0,,3-тен 2 ұпайға дейінгі жеңімпаз: Барто Аои
Dialogue: 0,0:05:11.22,0:05:12.68,Default,,0,0,0,,Burst Burst
Dialogue: 0,0:05:12.77,0:05:13.64,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:05:15.18,0:05:18.35,Default,,0,0,0,,Бұл менің Жеңімпаз Валькириім.
Dialogue: 0,0:05:18.86,0:05:21.36,Default,,0,0,0,,Жеңімпаз Барто Аои болды!
Dialogue: 0,0:05:21.44,0:05:25.11,Default,,0,0,0,,Чемпионның сәтті қорғанысы Құттықтаймыз!
Dialogue: 0,0:05:25.19,0:05:26.11,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:26.20,0:05:28.99,Default,,0,0,0,,Мен жеңдім, Аои Барто
Dialogue: 0,0:05:29.45,0:05:31.74,Default,,0,0,0,,Керемет жеңіс
Dialogue: 0,0:05:32.95,0:05:35.46,Default,,0,0,0,,Бірақ ақырында чемпион атағы...
Dialogue: 0,0:05:35.54,0:05:37.29,Default,,0,0,0,,Мен қабылдаймын және аламын
Dialogue: 0,0:05:37.67,0:05:40.13,Default,,0,0,0,,Ой, не болып жатыр? Иә?
Dialogue: 0,0:05:37.67,0:05:40.13,Default,,0,0,0,,(микрофонның айқайлаған дыбысы)
Dialogue: 0,0:05:40.13,0:05:40.21,Default,,0,0,0,,(микрофонның айқайлаған дыбысы)
Dialogue: 0,0:05:40.21,0:05:41.21,Default,,0,0,0,,(микрофонның айқайлаған дыбысы)
Dialogue: 0,0:05:40.21,0:05:41.21,Default,,0,0,0,,
Dialogue: 0,0:05:41.21,0:05:42.38,Default,,0,0,0,,
Dialogue: 0,0:05:42.46,0:05:44.88,Default,,0,0,0,,Не? О? Уф
Dialogue: 0,0:05:52.31,0:05:53.97,Default,,0,0,0,,Не... не... не!
Dialogue: 0,0:05:54.60,0:05:56.48,Default,,0,0,0,,Бұл Фи!
Dialogue: 0,0:05:56.56,0:05:58.98,Default,,0,0,0,,Қазір барлық кездесулерде жеңіліссіз әлемдік рейтингке көтеріліп келеді.
Dialogue: 0,0:05:59.44,0:06:02.36,Default,,0,0,0,,Чемпионнан күшті дейтін адам бар...
Dialogue: 0,0:06:02.44,0:06:05.78,Default,,0,0,0,,Кенет ұрыс сахнасында пайда болды!
Dialogue: 0,0:06:07.74,0:06:09.20,Default,,0,0,0,,Сіз Phiсіз бе?
Dialogue: 0,0:06:09.45,0:06:10.74,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:06:12.45,0:06:13.95,Default,,0,0,0,,Мен ойнауға келдім.
Dialogue: 0,0:06:14.83,0:06:16.50,Default,,0,0,0,,Ол Фи ма?
Dialogue: 0,0:06:16.62,0:06:18.58,Default,,0,0,0,,Сочо Сіз білесіз бе?
Dialogue: 0,0:06:18.71,0:06:21.00,Default,,0,0,0,,А, мен сенің атыңды естідім.
Dialogue: 0,0:06:21.54,0:06:24.00,Default,,0,0,0,,Фи - метеориттен жасалған супер Ццубей.
Dialogue: 0,0:06:24.09,0:06:26.01,Default,,0,0,0,,Менде Фениксті жандандыру бар.
Dialogue: 0,0:06:26.09,0:06:29.97,Default,,0,0,0,,Бұл метеорит құлаған орманнан пайда болған өлмес жүзік сияқты.
Dialogue: 0,0:06:30.13,0:06:33.30,Default,,0,0,0,,Метеорит? Өлмейтін бе? Шынайы ма?
Dialogue: 0,0:06:33.47,0:06:35.26,Default,,0,0,0,,Мүмкін шетелдіктер шығар?
Dialogue: 0,0:06:35.68,0:06:38.18,Default,,0,0,0,,Мен сенімен шайқасқым келді.
Dialogue: 0,0:06:38.77,0:06:40.27,Default,,0,0,0,,Кез келген уақыт жақсы.
Dialogue: 0,0:06:41.02,0:06:44.02,Default,,0,0,0,,Ол неге сонша бастық?
Dialogue: 0,0:06:46.53,0:06:50.28,Default,,0,0,0,,Барто Аои Жою керек сияқты.
Dialogue: 0,0:06:51.07,0:06:53.53,Default,,0,0,0,,Сенгісіз мама Миа!
Dialogue: 0,0:06:53.62,0:06:55.83,Default,,0,0,0,,Титулдық матчы жақында ғана аяқталған чемпионға...
Dialogue: 0,0:06:56.12,0:06:58.00,Default,,0,0,0,,Фи арандатуы!
Dialogue: 0,0:06:58.45,0:06:59.71,Default,,0,0,0,,Fi…
Dialogue: 0,0:06:59.91,0:07:02.42,Default,,0,0,0,,♬~
Dialogue: 0,0:07:04.84,0:07:07.51,Default,,0,0,0,,Балтоны жеңетін менмін!
Dialogue: 0,0:07:07.71,0:07:10.26,Default,,0,0,0,,♬~
Dialogue: 0,0:07:12.09,0:07:13.97,Default,,0,0,0,,Айга керемет...
Dialogue: 0,0:07:14.05,0:07:16.14,Default,,0,0,0,,Мен бұл сезімді түсінемін.
Dialogue: 0,0:07:16.39,0:07:19.64,Default,,0,0,0,,Маған осындай нәрсені көрсетті. Оның күйіп кетпеуі мүмкін емес.
Dialogue: 0,0:07:19.77,0:07:20.73,Default,,0,0,0,,Мен де істеймін
Dialogue: 0,0:07:21.23,0:07:22.23,Default,,0,0,0,,Айга ауыстыру
Dialogue: 0,0:07:22.40,0:07:25.06,Default,,0,0,0,,Маған кедергі жасама! (Ранджиро) Маған да жасауға рұқсат етіңіз.
Dialogue: 0,0:07:25.52,0:07:27.90,Default,,0,0,0,,А~ тағы?
Dialogue: 0,0:07:25.52,0:07:27.90,Default,,0,0,0,,(Айга мен Ранжироның сөйлейтін дауысы)
Dialogue: 0,0:07:28.03,0:07:29.78,Default,,0,0,0,,Екеуіңіз де ағаңыздың титулдық кездесуінен шабыттандыңыз.
Dialogue: 0,0:07:28.03,0:07:29.78,Default,,0,0,0,,Олай болса тас, қағаз, қайшы ойнаймыз.
Dialogue: 0,0:07:29.78,0:07:29.86,Default,,0,0,0,,Менің ойымша, екеуі де ағасының титулдық кездесуінен шабыттанды.
Dialogue: 0,0:07:29.86,0:07:30.65,Default,,0,0,0,,Менің ойымша, екеуі де ағасының титулдық кездесуінен шабыттанды.
Dialogue: 0,0:07:29.86,0:07:30.65,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:07:30.65,0:07:30.95,Default,,0,0,0,,Екеуің де ағаңның титулдық кездесуінен шабыттандыңдар.
Dialogue: 0,0:07:30.95,0:07:31.95,Default,,0,0,0,,Менің ойымша, екеуі де ағасының титулдық кездесуінен шабыттанды.
Dialogue: 0,0:07:30.95,0:07:31.95,Default,,0,0,0,,
Dialogue: 0,0:07:31.95,0:07:32.03,Default,,0,0,0,,
Dialogue: 0,0:07:32.03,0:07:34.20,Default,,0,0,0,,
Dialogue: 0,0:07:32.03,0:07:34.20,Default,,0,0,0,,Мен Бал-ниді жеңуді жоспарлап отырмын.
Dialogue: 0,0:07:34.41,0:07:34.53,Default,,0,0,0,,Оған дейін менің бір ісім бар.
Dialogue: 0,0:07:34.53,0:07:37.41,Default,,0,0,0,,Оған дейін менің бір ісім бар.
Dialogue: 0,0:07:34.53,0:07:37.41,Default,,0,0,0,,(Айга мен Ранжироның сөйлейтін дауысы)
Dialogue: 0,0:07:37.41,0:07:37.58,Default,,0,0,0,,(Айга мен Ранжироның сөйлейтін дауысы)
Dialogue: 0,0:07:37.58,0:07:38.45,Default,,0,0,0,,(Айга мен Ранжироның сөйлейтін дауысы)
Dialogue: 0,0:07:37.58,0:07:38.45,Default,,0,0,0,,Айга!
Dialogue: 0,0:07:38.58,0:07:41.21,Default,,0,0,0,,Лонгинус кубогының финалы ертең.
Dialogue: 0,0:07:41.75,0:07:42.87,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:07:44.42,0:07:45.46,Default,,0,0,0,,Бірінші, Суох
Dialogue: 0,0:07:45.88,0:07:47.21,Default,,0,0,0,,Содан кейін Луи
Dialogue: 0,0:07:47.59,0:07:48.63,Default,,0,0,0,,және phi
Dialogue: 0,0:07:48.88,0:07:49.71,Default,,0,0,0,,Барт
Dialogue: 0,0:07:50.80,0:07:52.51,Default,,0,0,0,,Мен бәрін жеңемін!
Dialogue: 0,0:07:53.09,0:07:58.14,Default,,0,0,0,,Мен ең күшті және жеңілмейтін Super Zetsu боламын!
Dialogue: 0,0:07:58.97,0:08:01.14,Default,,0,0,0,,(Құстардың сайрауы)
Dialogue: 0,0:08:04.27,0:08:05.69,Default,,0,0,0,,Лорд Суо
Dialogue: 0,0:08:06.56,0:08:09.36,Default,,0,0,0,,Фубуки Суми мырза осында.
Dialogue: 0,0:08:12.78,0:08:15.70,Default,,0,0,0,,Суо, менің сенен бір жақсылығым бар.
Dialogue: 0,0:08:16.37,0:08:17.62,Default,,0,0,0,,Сіз жақсылық сұрайсыз ба?
Dialogue: 0,0:08:18.45,0:08:20.12,Default,,0,0,0,,Мен сенен жеңілдім
Dialogue: 0,0:08:20.62,0:08:23.96,Default,,0,0,0,,Бірақ мен сені досым деп санаймын.
Dialogue: 0,0:08:24.54,0:08:25.54,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:08:25.67,0:08:27.13,Default,,0,0,0,,Мені тыңда.
Dialogue: 0,0:08:27.67,0:08:29.42,Default,,0,0,0,,Бұл көріксіз, Фубуки.
Dialogue: 0,0:08:33.97,0:08:35.76,Default,,0,0,0,,Жақсы көріне бастады.
Dialogue: 0,0:08:35.89,0:08:36.76,Default,,0,0,0,,О
Dialogue: 0,0:08:36.84,0:08:39.18,Default,,0,0,0,,Ертең жеңіңіз, а
Dialogue: 0,0:08:39.60,0:08:42.10,Default,,0,0,0,,Өйткені Темені жеңетін менмін.
Dialogue: 0,0:08:42.18,0:08:43.98,Default,,0,0,0,,Ей, мәңгілік айт.
Dialogue: 0,0:08:44.06,0:08:45.35,Default,,0,0,0,,Конояро
Dialogue: 0,0:08:47.52,0:08:48.90,Default,,0,0,0,,Қазір жасаңыз!
Dialogue: 0,0:08:48.98,0:08:50.23,Default,,0,0,0,,Тариме!
Dialogue: 0,0:08:50.32,0:08:52.32,Default,,0,0,0,,Хмм!
Dialogue: 0,0:08:52.40,0:08:53.57,Default,,0,0,0,,​​О?
Dialogue: 0,0:08:55.40,0:08:56.41,Default,,0,0,0,,Фубуки
Dialogue: 0,0:08:59.78,0:09:02.41,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар
Dialogue: 0,0:09:02.50,0:09:04.91,Default,,0,0,0,,Бұл күн де ​​келді!
Dialogue: 0,0:09:05.33,0:09:08.38,Default,,0,0,0,,Бұл Лонгинус кубогының финалы!
Dialogue: 0,0:09:08.46,0:09:10.63,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:09:10.96,0:09:12.17,Default,,0,0,0,,Көк бұрыш
Dialogue: 0,0:09:12.26,0:09:18.14,Default,,0,0,0,,Гошуин Сух жартылай финалда бей-клубтар арасындағы шайқаста жеңіске жетті!
Dialogue: 0,0:09:18.72,0:09:23.60,Default,,0,0,0,,Керемет иемото енді үлкен гүлге айналады.
Dialogue: 0,0:09:24.06,0:09:25.39,Default,,0,0,0,,Қызыл бұрыш
Dialogue: 0,0:09:25.52,0:09:30.11,Default,,0,0,0,,Бұл адам турнир басталмайынша мүлдем беймәлім болды.
Dialogue: 0,0:09:30.36,0:09:35.36,Default,,0,0,0,,Жылдам ілгерілеу - бұл нақты нәрсенің дәлелі, Қызыл жүз Айга!
Dialogue: 0,0:09:36.40,0:09:38.16,Default,,0,0,0,,Енді осы матчта жеңіске жеткен адамға...
Dialogue: 0,0:09:38.24,0:09:41.28,Default,,0,0,0,,Ширасаги сарайы Руимен матч болады деп уәде етілген.
Dialogue: 0,0:09:42.45,0:09:45.16,Default,,0,0,0,,Маған мақтау айтасың деп күтпедім.
Dialogue: 0,0:09:45.33,0:09:48.54,Default,,0,0,0,,Аа, мен де дәл солай айтайын деп едім.
Dialogue: 0,0:09:48.67,0:09:50.46,Default,,0,0,0,,​​О?
Dialogue: 0,0:09:50.92,0:09:52.17,Default,,0,0,0,,Әй, күте тұрыңыз... бұл өтірік!
Dialogue: 0,0:09:52.25,0:09:55.55,Default,,0,0,0,,Луи жаңа ғана алаңға келді!
Dialogue: 0,0:09:55.67,0:09:59.47,Default,,0,0,0,,Мені жалықтырмаңыз хахахаха!
Dialogue: 0,0:10:00.14,0:10:01.14,Default,,0,0,0,,Луис мырза
Dialogue: 0,0:10:01.64,0:10:04.14,Default,,0,0,0,,Мен міндетті түрде Омемен жұдырықтасамын.
Dialogue: 0,0:10:04.89,0:10:07.77,Default,,0,0,0,,Финал 3 балдық жүйе бойынша өтеді.
Dialogue: 0,0:10:07.98,0:10:09.77,Default,,0,0,0,,Бір-бірінің ұяшықтарын тексеру
Dialogue: 0,0:10:13.44,0:10:16.11,Default,,0,0,0,,Z Ахиллес теңгерімді түрі
Dialogue: 0,0:10:16.69,0:10:19.61,Default,,0,0,0,,Шабуыл, қорғаныс және төзімділікті біріктіру.
Dialogue: 0,0:10:19.70,0:10:23.28,Default,,0,0,0,,Extend драйвері биіктікті өзгерте алады
Dialogue: 0,0:10:24.29,0:10:27.91,Default,,0,0,0,,Денсаулық Саламандр Солға айналу балансының түрі
Dialogue: 0,0:10:28.50,0:10:31.83,Default,,0,0,0,,Қабатты 5 қалақ пен 10 қалақшаға өзгертуге болады.
Dialogue: 0,0:10:31.92,0:10:34.21,Default,,0,0,0,,Оператор драйверінің осін ауыстыру арқылы...
Dialogue: 0,0:10:34.30,0:10:37.21,Default,,0,0,0,,Қорғау режимі мен шабуыл режимі арасында таңдауға болады.
Dialogue: 0,0:10:37.88,0:10:41.51,Default,,0,0,0,,Екі беті бар шабуыл және қорғаныс бейі
Dialogue: 0,0:10:42.18,0:10:43.26,Default,,0,0,0,,шығанақты қайтарыңыз
Dialogue: 0,0:10:46.77,0:10:48.52,Default,,0,0,0,,Мен Луимен соғысып жатқан адаммын.
Dialogue: 0,0:10:49.06,0:10:52.40,Default,,0,0,0,,Луимен күресуге әлі 100 жыл ерте.
Dialogue: 0,0:10:53.27,0:10:54.40,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:10:55.07,0:10:58.03,Default,,0,0,0,,Солға айналу Луи Лонгинуспен бірдей
Dialogue: 0,0:10:58.82,0:11:01.53,Default,,0,0,0,,Оме – Луиді жеңер алдында денені қыздыру жаттығуы.
Dialogue: 0,0:11:02.16,0:11:04.37,Default,,0,0,0,,Айга жүргізушіні көтерді
Dialogue: 0,0:11:04.66,0:11:06.79,Default,,0,0,0,,Шабуыл – ең жақсы қорғаныс.
Dialogue: 0,0:11:09.25,0:11:11.58,Default,,0,0,0,,Су да жүргізушіні ауыстырды.
Dialogue: 0,0:11:11.67,0:11:12.92,Default,,0,0,0,,Шабуыл режимі
Dialogue: 0,0:11:13.29,0:11:17.88,Default,,0,0,0,,Шабуыл – шабуыл. Ей, мына жігіт жанып жатыр.
Dialogue: 0,0:11:17.96,0:11:20.05,Default,,0,0,0,,Сәттілік Айға!
Dialogue: 0,0:11:22.43,0:11:24.05,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:11:24.60,0:11:27.68,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:11:28.18,0:11:30.48,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:11:33.27,0:11:35.15,Default,,0,0,0,,Саламандер жалтарып кетті!
Dialogue: 0,0:11:35.40,0:11:36.40,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:11:39.28,0:11:40.15,Default,,0,0,0,,(Сирена қосылады)
Dialogue: 0,0:11:42.95,0:11:44.78,Default,,0,0,0,,Саламандар да шабуылға шықты.
Dialogue: 0,0:11:45.07,0:11:47.37,Default,,0,0,0,,5 жүзді қабат азу тістерін көрсетеді!
Dialogue: 0,0:11:47.62,0:11:49.62,Default,,0,0,0,,Ахиллестің көңілі ұшып кетті
Dialogue: 0,0:11:50.12,0:11:51.37,Default,,0,0,0,,Жасай бер, Саламандер!
Dialogue: 0,0:11:51.75,0:11:53.21,Default,,0,0,0,,Қарғыс атсын, Ахиллес!
Dialogue: 0,0:12:01.01,0:12:03.34,Default,,0,0,0,,Z Ахиллес аяқталды
Dialogue: 0,0:12:03.47,0:12:04.80,Default,,0,0,0,,1-ден 0-ге дейінгі нүктелер
Dialogue: 0,0:12:05.30,0:12:08.01,Default,,0,0,0,,Бірінші шайқаста Айга Акабане жеңіске жетті!
Dialogue: 0,0:12:08.56,0:12:10.18,Default,,0,0,0,,Суох жеңілді
Dialogue: 0,0:12:10.68,0:12:13.14,Default,,0,0,0,,Менен ұпай алғанына сене алар емеспін.
Dialogue: 0,0:12:16.69,0:12:17.57,Default,,0,0,0,,Суо
Dialogue: 0,0:12:22.40,0:12:25.32,Default,,0,0,0,,Мен сіздің капитан болғаныңызды қалаймын.
Dialogue: 0,0:12:25.82,0:12:27.70,Default,,0,0,0,,Не?
Dialogue: 0,0:12:28.24,0:12:32.50,Default,,0,0,0,,Мені капитандар немесе достар қызықтырмайды.
Dialogue: 0,0:12:33.41,0:12:38.21,Default,,0,0,0,,Енді мен сені жеңгеннен кейін маған енді Бей клубында болудың қажеті жоқ.
Dialogue: 0,0:12:38.63,0:12:40.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:40.55,0:12:41.46,Default,,0,0,0,,Үйге қайт
Dialogue: 0,0:12:42.51,0:12:43.34,Default,,0,0,0,,Құт
Dialogue: 0,0:12:45.30,0:12:48.10,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:12:48.22,0:12:49.60,Default,,0,0,0,,әртүрлі арналардың Кира өкілдері мен үкімет хабарламалары арасындағы әдеттегі тартыс қайта басталды, иә?
Dialogue: 0,0:12:50.89,0:12:52.39,Default,,0,0,0,,Сондықтан мен жеңілдім
Dialogue: 0,0:12:55.48,0:13:00.82,Default,,0,0,0,,Суо, сен мен туралы не Бей Клуб туралы не ойласаң да, сен менің досымсың.
Dialogue: 0,0:13:01.23,0:13:02.94,Default,,0,0,0,,Мен сізді қолдаймын
Dialogue: 0,0:13:03.61,0:13:05.28,Default,,0,0,0,,Суо, осы жерден.
Dialogue: 0,0:13:05.40,0:13:06.95,Default,,0,0,0,,Осы жерден Осы жерден!
Dialogue: 0,0:13:07.36,0:13:09.37,Default,,0,0,0,,Айганың жағдайы
Dialogue: 0,0:13:09.49,0:13:11.16,Default,,0,0,0,,Барлығын бірден итеріңіз!
Dialogue: 0,0:13:12.04,0:13:13.16,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:13:14.29,0:13:19.00,Default,,0,0,0,,Бұл сіз бұрын көздеген қарсы соққы болды ма?
Dialogue: 0,0:13:20.09,0:13:23.30,Default,,0,0,0,,Жоқ, бұл жігіт ештеңені ойламайды.
Dialogue: 0,0:13:24.05,0:13:27.51,Default,,0,0,0,,Бұрын болған оқиға кездейсоқтық болды. Бұл екі рет қайталанбайды.
Dialogue: 0,0:13:31.18,0:13:32.06,Default,,0,0,0,,Ах
Dialogue: 0,0:13:34.48,0:13:37.06,Default,,0,0,0,,Мен оны 10 жүзді қорғаныс режиміне қойдым.
Dialogue: 0,0:13:37.69,0:13:39.90,Default,,0,0,0,,Сонда да біз осында шабуыл жасаймыз.
Dialogue: 0,0:13:40.19,0:13:41.90,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:13:42.57,0:13:45.49,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:13:46.03,0:13:48.16,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:48.45,0:13:49.32,Default,,0,0,0,,Ухммм… ммм…
Dialogue: 0,0:13:54.70,0:13:56.12,Default,,0,0,0,,Ахиллесті ұшырып жіберіңіз
Dialogue: 0,0:13:56.54,0:13:58.62,Default,,0,0,0,,Z Ату!
Dialogue: 0,0:13:59.67,0:14:02.00,Default,,0,0,0,,Гүлдерің шашылады
Dialogue: 0,0:14:02.42,0:14:03.92,Default,,0,0,0,,Қып-қызыл тозақ!
Dialogue: 0,0:14:07.01,0:14:07.84,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:08.30,0:14:10.34,Default,,0,0,0,,Тозақтың отымен жан!
Dialogue: 0,0:14:11.26,0:14:15.64,Default,,0,0,0,,Вау! Саламандердің күшті қорғанысы
Dialogue: 0,0:14:15.98,0:14:18.89,Default,,0,0,0,,Ахиллес Мен саған мүлдем жақындай алмаймын!
Dialogue: 0,0:14:19.35,0:14:20.56,Default,,0,0,0,,Бұл техника дегеніміз не?
Dialogue: 0,0:14:20.69,0:14:22.52,Default,,0,0,0,,Мүмкіндік жоқ
Dialogue: 0,0:14:22.69,0:14:23.69,Default,,0,0,0,,Керемет
Dialogue: 0,0:14:24.07,0:14:26.74,Default,,0,0,0,,Қарсыласыңыздың шыдамдылығын жойыңыз.
Dialogue: 0,0:14:28.40,0:14:30.66,Default,,0,0,0,,Мен мұнда жаңа трюк ойлап таптым.
Dialogue: 0,0:14:31.53,0:14:33.91,Default,,0,0,0,,Күткендей, Сух данышпан.
Dialogue: 0,0:14:34.79,0:14:40.33,Default,,0,0,0,,Уау! Z Ахиллес тозақ отында жанып кетті!
Dialogue: 0,0:14:41.00,0:14:43.34,Default,,0,0,0,,Денсаулық Саламандр Айналдыру
Dialogue: 0,0:14:43.50,0:14:45.09,Default,,0,0,0,,1-1 тармақтар
Dialogue: 0,0:14:45.17,0:14:48.47,Default,,0,0,0,,Келесі жолы мен оны жарып жіберемін
Dialogue: 0,0:14:52.39,0:14:54.05,Default,,0,0,0,,Сақтықты түсірме, Суо
Dialogue: 0,0:14:54.72,0:14:58.06,Default,,0,0,0,,Айға Ақаба бұлай болатын жігіт емес.
Dialogue: 0,0:15:00.23,0:15:01.77,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:02.10,0:15:03.02,Default,,0,0,0,,Айға
Dialogue: 0,0:15:03.52,0:15:04.94,Default,,0,0,0,,Бей клубына келіңіз.
Dialogue: 0,0:15:05.32,0:15:08.07,Default,,0,0,0,,Иә? Мен оны түсінбеймін
Dialogue: 0,0:15:08.32,0:15:11.74,Default,,0,0,0,,Егер сіз қосылсаңыз, Bay Club одан да күшті болады.
Dialogue: 0,0:15:12.16,0:15:15.33,Default,,0,0,0,,Дұрыс, өйткені мен ең күштімін.
Dialogue: 0,0:15:15.41,0:15:16.62,Default,,0,0,0,,А, бірақ неге?
Dialogue: 0,0:15:17.20,0:15:20.62,Default,,0,0,0,,Мен жай ғана Bay Club-ты күшейткім келеді, барлығы осы.
Dialogue: 0,0:15:21.29,0:15:22.25,Default,,0,0,0,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:15:22.63,0:15:23.46,Default,,0,0,0,,Айга...
Dialogue: 0,0:15:24.13,0:15:25.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:25.67,0:15:28.30,Default,,0,0,0,,Мен бұл мектепке Оменің арқасында келдім.
Dialogue: 0,0:15:29.05,0:15:31.01,Default,,0,0,0,,Менің күшті болуым үшін
Dialogue: 0,0:15:31.63,0:15:32.64,Default,,0,0,0,,Ха...
Dialogue: 0,0:15:33.59,0:15:36.72,Default,,0,0,0,,Мен мұнда Ome's Bay клубын күшейту үшін келген жоқпын.
Dialogue: 0,0:15:41.89,0:15:45.02,Default,,0,0,0,,Бәрі де менің күшті болуым үшін
Dialogue: 0,0:15:49.28,0:15:50.28,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:15:50.57,0:15:52.95,Default,,0,0,0,,Енді нүктелер 1:1
Dialogue: 0,0:15:53.03,0:15:55.78,Default,,0,0,0,,Егер біреуі жарылса, шайқас шешіледі.
Dialogue: 0,0:15:56.16,0:15:58.79,Default,,0,0,0,,Мен сені тозақ отымен өртеп жіберемін
Dialogue: 0,0:15:59.16,0:16:01.12,Default,,0,0,0,,Ох… Уф~ Мен қатты ашпын.
Dialogue: 0,0:16:01.83,0:16:03.62,Default,,0,0,0,,Қызғылт қызыл тозақ
Dialogue: 0,0:16:04.21,0:16:06.88,Default,,0,0,0,,Егер сіз бұны бұзбасаңыз, жеңу мүмкіндігі жоқ.
Dialogue: 0,0:16:08.71,0:16:11.05,Default,,0,0,0,,Не істеуім керек... Ах?
Dialogue: 0,0:16:15.51,0:16:17.97,Default,,0,0,0,,Ахиллес, айтшы.
Dialogue: 0,0:16:18.85,0:16:21.14,Default,,0,0,0,,Сіз маған айтуыңыз керек еді
Dialogue: 0,0:16:21.64,0:16:23.56,Default,,0,0,0,,Сіз ең күшті және жеңілмейтін болғаныңызда
Dialogue: 0,0:16:24.19,0:16:27.06,Default,,0,0,0,,Мен айтқанымдай, мен не істерімді білмеймін.
Dialogue: 0,0:16:27.98,0:16:31.36,Default,,0,0,0,,Ең күшті және жеңілмейтін жолды өзіңіз табыңыз.
Dialogue: 0,0:16:32.57,0:16:33.74,Default,,0,0,0,,Өзіңіз бе?
Dialogue: 0,0:16:44.12,0:16:47.08,Default,,0,0,0,,Оны өзіңіз табыңыз?
Dialogue: 0,0:16:47.54,0:16:48.38,Default,,0,0,0,,Ах
Dialogue: 0,0:16:49.34,0:16:52.01,Default,,0,0,0,,Ахиллестің қаруы – қылыш пен қалқан
Dialogue: 0,0:16:52.67,0:16:54.13,Default,,0,0,0,,Шабуыл және қорғаныс
Dialogue: 0,0:16:55.09,0:16:57.09,Default,,0,0,0,,Екеуін де меңгеремін.
Dialogue: 0,0:17:00.18,0:17:02.47,Default,,0,0,0,,Сіз жүргізушіні түсірдіңіз бе?
Dialogue: 0,0:17:02.73,0:17:04.18,Default,,0,0,0,,Бұл пайдасыз күрес
Dialogue: 0,0:17:04.89,0:17:06.77,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:17:07.15,0:17:10.19,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:10.69,0:17:12.86,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:13.24,0:17:14.07,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:16.70,0:17:18.53,Default,,0,0,0,,Жүр!
Dialogue: 0,0:17:19.07,0:17:21.04,Default,,0,0,0,,Не істесең де, пайдасы жоқ!
Dialogue: 0,0:17:21.83,0:17:24.75,Default,,0,0,0,,Екеуі де орталықты алуға ниетті.
Dialogue: 0,0:17:26.54,0:17:28.04,Default,,0,0,0,,Z Қорғаныс!
Dialogue: 0,0:17:33.71,0:17:36.26,Default,,0,0,0,,Орталықты бірінші болып Ахиллес алды!
Dialogue: 0,0:17:36.93,0:17:38.30,Default,,0,0,0,,Қып-қызыл тозақ!
Dialogue: 0,0:17:41.47,0:17:46.35,Default,,0,0,0,,Қақтығыс! Бұл тозақ оты мен нұр қалқаны арасындағы шайқас!
Dialogue: 0,0:17:46.85,0:17:48.10,Default,,0,0,0,,Оны атамаңыз!
Dialogue: 0,0:17:52.32,0:17:53.19,Default,,0,0,0,,Бұл осы жерден.
Dialogue: 0,0:17:53.69,0:17:55.82,Default,,0,0,0,,Жабайы жүр, Ахиллес!
Dialogue: 0,0:17:57.45,0:17:58.95,Default,,0,0,0,,Саламандр!
Dialogue: 0,0:18:04.33,0:18:05.79,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:18:06.66,0:18:09.88,Default,,0,0,0,,Өрт құйын Гекирин!
Dialogue: 0,0:18:12.71,0:18:16.01,Default,,0,0,0,,Мен жеңілмеймін!
Dialogue: 0,0:18:21.22,0:18:22.97,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:18:23.06,0:18:24.14,Default,,0,0,0,,Даа~!
Dialogue: 0,0:18:24.60,0:18:27.27,Default,,0,0,0,,Z Slash!
Dialogue: 0,0:18:38.61,0:18:39.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:40.28,0:18:42.95,Default,,0,0,0,,Z Ахиллестің жарылуы аяқталуы
Dialogue: 0,0:18:43.33,0:18:46.95,Default,,0,0,0,,Жеңімпаз: Қызыл жүз Айга 3-тен 1 ұпайға дейін.
Dialogue: 0,0:18:47.08,0:18:49.25,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:49.75,0:18:55.25,Default,,0,0,0,,Burst Burst Burst! Ол шешілді!
Dialogue: 0,0:18:55.80,0:19:01.09,Default,,0,0,0,,Мен супер Цетсумын, ең күшті және жеңілмейтінмін~!
Dialogue: 0,0:19:01.80,0:19:05.35,Default,,0,0,0,,Лонгинус кубогының жеңімпазы - Қызыл жүз Айга!
Dialogue: 0,0:19:05.72,0:19:08.10,Default,,0,0,0,,Бұл тамаша жекпе-жек болды.
Dialogue: 0,0:19:08.56,0:19:10.23,Default,,0,0,0,,Ширасаги сарайы Луис!
Dialogue: 0,0:19:10.39,0:19:12.15,Default,,0,0,0,,Келесі - Ome
Dialogue: 0,0:19:12.73,0:19:15.73,Default,,0,0,0,,Бұл қызық болды, Айға Ақаба
Dialogue: 0,0:19:16.15,0:19:18.82,Default,,0,0,0,,Мен сенімен шайқасты асыға күтемін.
Dialogue: 0,0:19:19.61,0:19:20.99,Default,,0,0,0,,Хехехе
Dialogue: 0,0:19:21.86,0:19:22.99,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:25.62,0:19:26.79,Default,,0,0,0,,(Қабырғаға соғылған дыбыс)
Dialogue: 0,0:19:27.33,0:19:29.37,Default,,0,0,0,,Неліктен жеңілдіңіз?
Dialogue: 0,0:19:30.41,0:19:33.42,Default,,0,0,0,,Мен неге жеңілдім?
Dialogue: 0,0:19:33.67,0:19:35.34,Default,,0,0,0,,Суоу?
Dialogue: 0,0:19:38.17,0:19:41.18,Default,,0,0,0,,Енді оның пайдасы болмауы керек.
Dialogue: 0,0:19:43.22,0:19:46.31,Default,,0,0,0,,Мен Йонекома академиясынан кетемін
Dialogue: 0,0:19:50.48,0:19:52.23,Default,,0,0,0,,Күшті болу
Dialogue: 0,0:20:00.24,0:20:01.45,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,0:20:10.20,0:20:11.46,Default,,0,0,0,,Капитан (Хика) Фубуки-сенпай
Dialogue: 0,0:20:13.83,0:20:16.25,Default,,0,0,0,,Күте тұрыңыз (Хикару) Бұл нені білдіреді?
Dialogue: 0,0:20:16.34,0:20:18.46,Default,,0,0,0,,Йонекома академиясынан кету
Dialogue: 0,0:20:19.76,0:20:21.34,Default,,0,0,0,,Мен Америкаға барамын
Dialogue: 0,0:20:21.72,0:20:23.68,Default,,0,0,0,,Не? (Хаяо Ашида) Міне...
Dialogue: 0,0:20:23.76,0:20:26.26,Default,,0,0,0,,Капитан кеткенде, біз...
Dialogue: 0,0:20:27.85,0:20:28.72,Default,,0,0,0,,Мәңгілік жаз
Dialogue: 0,0:20:29.26,0:20:30.14,Default,,0,0,0,,Иә
Dialogue: 0,0:20:31.31,0:20:32.89,Default,,0,0,0,,Мен лавр шаянына тапсырыс бердім.
Dialogue: 0,0:20:33.31,0:20:34.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:36.19,0:20:37.19,Default,,0,0,0,,Иә
Dialogue: 0,0:20:38.32,0:20:39.40,Default,,0,0,0,,Не! Гваааах!
Dialogue: 0,0:20:49.12,0:20:49.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:53.16,0:20:54.83,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:55.12,0:20:56.83,Default,,0,0,0,,Гао!
Dialogue: 0,0:21:00.96,0:21:02.92,Default,,0,0,0,,Ахахха! а?
Dialogue: 0,0:21:03.01,0:21:05.13,Default,,0,0,0,,Омэкчи, бұл қызық хахаха
Dialogue: 0,0:21:05.22,0:21:06.09,Default,,0,0,0,,Не?
Dialogue: 0,0:21:06.76,0:21:08.26,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:21:08.47,0:21:11.52,Default,,0,0,0,,Мен Лабан Лабан Ваномын
Dialogue: 0,0:21:12.22,0:21:14.94,Default,,0,0,0,,«Егер қалағаныңды қаласаң, шығысқа қарай жүр».
Dialogue: 0,0:21:15.85,0:21:18.15,Default,,0,0,0,,«Барсаң, үрген адамды кездестіресің».
Dialogue: 0,0:21:18.52,0:21:20.44,Default,,0,0,0,,Болжам айтқандай болды.
Dialogue: 0,0:21:21.61,0:21:23.15,Default,,0,0,0,,Мұнда қауіпті…
Dialogue: 0,0:21:23.74,0:21:26.82,Default,,0,0,0,,Айға екеуміздің тағдырымыз жолығып еді.
Dialogue: 0,0:21:27.24,0:21:28.03,Default,,0,0,0,,Әй?
Dialogue: 0,0:21:28.24,0:21:29.66,Default,,0,0,0,,Жеңісіңіз құтты болсын!
Dialogue: 0,0:21:29.78,0:21:31.45,Default,,0,0,0,,О!
Dialogue: 0,0:21:31.83,0:21:33.45,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:21:33.83,0:21:36.00,Default,,0,0,0,,Не... Бұл не?
Dialogue: 0,0:21:36.12,0:21:38.54,Default,,0,0,0,,Біз жақсы араласатын сияқтымыз
Dialogue: 0,0:21:39.08,0:21:41.09,Default,,0,0,0,,Сонымен бұл не?
Dialogue: 0,0:21:42.46,0:21:45.34,Default,,0,0,0,,Мен ең күшті көріпкелмін
Dialogue: 0,0:21:47.43,0:21:53.43,Default,,0,0,0,,♪~
Dialogue: 0,0:23:10.09,0:23:16.10,Default,,0,0,0,,~♪
Dialogue: 0,0:23:17.68,0:23:19.77,Default,,0,0,0,,Луимен күресетін күн келді.
Dialogue: 0,0:23:20.52,0:23:22.19,Default,,0,0,0,,Мен оның күшті екенін білемін.
Dialogue: 0,0:23:22.44,0:23:25.40,Default,,0,0,0,,Бірақ мен супер Цетсумын, ең күштімін және жеңілмейтінмін.
Dialogue: 0,0:23:25.69,0:23:28.03,Default,,0,0,0,,Мен сені жеңемін! Мен сені жеңемін!
Dialogue: 0,0:23:28.11,0:23:31.53,Default,,0,0,0,,Луи, Омейдің ақымақ күлуін тоқтат!
Dialogue: 0,0:23:31.95,0:23:34.20,Default,,0,0,0,,Келесі жолы «Beyblade Burst Super Zetsu»
Dialogue: 0,0:23:34.28,0:23:36.79,Default,,0,0,0,,"Зұлым айдаһар! Қанды Лонгинус!!"
Dialogue: 0,0:23:37.20,0:23:38.75,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:38.87,0:23:40.62,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:42.12,0:23:48.12,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory