Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.13,0:00:07.50,Default,,0,0,0,,Сиқырлы сарай Өлі Гран!
Dialogue: 0,0:00:08.29,0:00:11.55,Default,,0,0,0,,Сіз бұрын-соңды көрмеген супер шайқасқа тап боласыз.
Dialogue: 0,0:00:11.76,0:00:15.84,Default,,0,0,0,,Қорқынышты жау, Күшті би жолыңда тұр.
Dialogue: 0,0:00:17.51,0:00:21.85,Default,,0,0,0,,Challenge Challenge Challenge!
Dialogue: 0,0:00:22.27,0:00:26.15,Default,,0,0,0,,Оны жеңіп, ертең қолға ал
Dialogue: 0,0:00:26.31,0:00:30.03,Default,,0,0,0,,Сіз Бейблейдтің болашағысыз!
Dialogue: 0,0:00:32.49,0:00:34.82,Default,,0,0,0,,Менің және Өлі Грандқа келген Сочоның алдымда
Dialogue: 0,0:00:35.11,0:00:37.24,Default,,0,0,0,,Елес ұры граф Найт пайда болады.
Dialogue: 0,0:00:38.03,0:00:40.37,Default,,0,0,0,,Мен саған айналамды көрсете аламын.
Dialogue: 0,0:00:40.79,0:00:44.66,Default,,0,0,0,,Осы Тұтылумен күресіп, жеңіске жетсем деп тілеймін.
Dialogue: 0,0:00:45.12,0:00:47.67,Default,,0,0,0,,Эрл Найттың тұтылуы дегеніміз не?
Dialogue: 0,0:00:47.79,0:00:51.34,Default,,0,0,0,,Бұл Аполлос пен Артемиданы біріктіру арқылы жасалған біріктірілген шығанақ болды!
Dialogue: 0,0:00:52.80,0:00:55.18,Default,,0,0,0,,Ахиллесті қабылдаңыз және алыңыз!
Dialogue: 0,0:00:55.43,0:00:56.76,Default,,0,0,0,,Өлі гравитация!
Dialogue: 0,0:01:00.72,0:01:05.89,Default,,0,0,0,,Жақсы, Ахиллес, әрі қарай жүр, әрі қарай жүр!
Dialogue: 0,0:01:08.02,0:01:10.86,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:12.57,0:01:14.57,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:14.74,0:01:18.53,Default,,0,0,0,,Жүр! Z сүңгу!
Dialogue: 0,0:01:25.21,0:01:28.75,Default,,0,0,0,,Мен Eclipse-ді соққымен жеңдім.
Dialogue: 0,0:01:29.79,0:01:32.67,Default,,0,0,0,,Сырттан тағы бір бұзушы келген сияқты.
Dialogue: 0,0:01:33.21,0:01:34.46,Default,,0,0,0,,Зиянкесуші?
Dialogue: 0,0:01:36.22,0:01:39.22,Default,,0,0,0,,Жүректерді іздеп жүргенімде, алдымнан шыққан адам...
Dialogue: 0,0:01:41.85,0:01:43.47,Default,,0,0,0,,О... О...
Dialogue: 0,0:01:44.93,0:01:46.64,Default,,0,0,0,,Бенишу!
Dialogue: 0,0:01:49.02,0:01:55.03,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:03:11.35,0:03:17.36,Default,,0,0,0,,~♪
Dialogue: 0,0:03:25.62,0:03:28.41,Default,,0,0,0,,Неліктен Куришуу мұнда?
Dialogue: 0,0:03:29.08,0:03:30.79,Default,,0,0,0,,Мен сені көруге келдім.
Dialogue: 0,0:03:32.00,0:03:32.83,Default,,0,0,0,,Мен үшін?
Dialogue: 0,0:03:33.50,0:03:37.05,Default,,0,0,0,,Қызыл жүз Айга, сен Ахиллды өлтірдің
Dialogue: 0,0:03:37.63,0:03:38.96,Default,,0,0,0,,Өлтіру?
Dialogue: 0,0:03:39.51,0:03:42.30,Default,,0,0,0,,Неліктен мен Ахилласты өлтіруім керек?
Dialogue: 0,0:03:42.43,0:03:43.80,Default,,0,0,0,,Біртүрлі сөздер айтпа!
Dialogue: 0,0:03:45.14,0:03:46.01,Default,,0,0,0,,Айга!
Dialogue: 0,0:03:47.35,0:03:49.85,Default,,0,0,0,,Фубуки! Омеге қалай келдіңіз...
Dialogue: 0,0:03:49.97,0:03:54.56,Default,,0,0,0,,Айга~! Тем:осында болды ма?
Dialogue: 0,0:03:55.02,0:03:58.94,Default,,0,0,0,,Фубуки! Әй, Шу-сенпай!
Dialogue: 0,0:03:59.82,0:04:01.40,Default,,0,0,0,,Хуаншанның інісі?
Dialogue: 0,0:04:01.78,0:04:05.16,Default,,0,0,0,,Аа, Ранжиро, танысқаныма қуаныштымын!
Dialogue: 0,0:04:05.91,0:04:10.20,Default,,0,0,0,,Жүректерден ұтылған ойынды Айға Шу тамашалады.
Dialogue: 0,0:04:10.33,0:04:12.08,Default,,0,0,0,,Ол уайымдағандықтан келді.
Dialogue: 0,0:04:12.21,0:04:14.42,Default,,0,0,0,,Жоқ, бұл жарамайды. Қаш! Жылдам!
Dialogue: 0,0:04:14.71,0:04:18.59,Default,,0,0,0,,Хахахаха! Сізге уайымдаудың қажеті жоқ
Dialogue: 0,0:04:18.71,0:04:21.17,Default,,0,0,0,,Содан бері мен күшейе түстім.
Dialogue: 0,0:04:21.30,0:04:23.93,Default,,0,0,0,,Мені күштірек ететін резонанс.
Dialogue: 0,0:04:25.47,0:04:27.05,Default,,0,0,0,,Сіз қателесесіз
Dialogue: 0,0:04:27.68,0:04:28.51,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:28.97,0:04:32.39,Default,,0,0,0,,Сіздің резонансыңыз – шайтанның резонанс.
Dialogue: 0,0:04:32.52,0:04:35.19,Default,,0,0,0,,Жындық... резонанс?
Dialogue: 0,0:04:35.65,0:04:37.65,Default,,0,0,0,,Өйткені мен күшті болғым келеді
Dialogue: 0,0:04:37.77,0:04:40.48,Default,,0,0,0,,Ахиллесті күшпен басқаруға тырысу
Dialogue: 0,0:04:41.11,0:04:42.53,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:04:42.86,0:04:45.86,Default,,0,0,0,,Резонанс – Беймен байланыс.
Dialogue: 0,0:04:45.99,0:04:48.99,Default,,0,0,0,,Ахиллес екеуіңде байланыс бар ма?
Dialogue: 0,0:04:49.53,0:04:51.20,Default,,0,0,0,,Мен бар екеніне сенімдімін!
Dialogue: 0,0:04:51.33,0:04:53.41,Default,,0,0,0,,Ахиллес екеуміздің рухымыз бір!
Dialogue: 0,0:04:54.12,0:04:57.88,Default,,0,0,0,,Соның дәлелі ретінде мен Ахиллестің азабын сеземін!
Dialogue: 0,0:04:58.79,0:05:03.76,Default,,0,0,0,,Бұл ауырсыну Ахиллестің сізге қауіп төніп тұрғанының белгісі.
Dialogue: 0,0:05:04.05,0:05:05.63,Default,,0,0,0,,Сіз мұны түсінбейсіз бе?
Dialogue: 0,0:05:06.01,0:05:08.55,Default,,0,0,0,,Түсінбейтін Оме.
Dialogue: 0,0:05:08.68,0:05:12.02,Default,,0,0,0,,Мен - Ахиллес Ахиллес - мен!
Dialogue: 0,0:05:12.81,0:05:15.23,Default,,0,0,0,,Менің айтқаным дұрыс емес пе?
Dialogue: 0,0:05:15.44,0:05:17.02,Default,,0,0,0,,Ахиллестен сұраңыз!
Dialogue: 0,0:05:17.52,0:05:20.36,Default,,0,0,0,,Куришу менімен шайқас!
Dialogue: 0,0:05:20.86,0:05:23.44,Default,,0,0,0,,Шу-сан сенімен шайқасқа келмеді!
Dialogue: 0,0:05:24.28,0:05:25.28,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:05:25.65,0:05:26.90,Default,,0,0,0,,Шу мырза...
Dialogue: 0,0:05:27.32,0:05:30.58,Default,,0,0,0,,Айғаны түсінудің жалғыз жолы – шайқас.
Dialogue: 0,0:05:31.45,0:05:34.62,Default,,0,0,0,,Бұл менің Бей Super Z Spriggan.
Dialogue: 0,0:05:35.41,0:05:37.37,Default,,0,0,0,,Super Z Spriggan
Dialogue: 0,0:05:37.87,0:05:40.08,Default,,0,0,0,,Кел, Қызыл жүз Айга!
Dialogue: 0,0:05:40.88,0:05:42.21,Default,,0,0,0,,Хаха~
Dialogue: 0,0:05:42.34,0:05:46.22,Default,,0,0,0,,Мен бұл жерден Қызыл жүз Айга мен Күрішудың шайқасын көремін деп ойламадым.
Dialogue: 0,0:05:46.97,0:05:48.80,Default,,0,0,0,,Мен түсіндім
Dialogue: 0,0:05:49.22,0:05:51.60,Default,,0,0,0,,Айғаны шақыру себебіңіз
Dialogue: 0,0:05:51.72,0:05:52.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:52.89,0:05:54.47,Default,,0,0,0,,Айға жем болсаң
Dialogue: 0,0:05:54.60,0:05:57.85,Default,,0,0,0,,Куришу сияқты аңыздар жиналады.
Dialogue: 0,0:05:58.27,0:06:00.90,Default,,0,0,0,,Сонда сіз оны басынан бастап есептедіңіз бе?
Dialogue: 0,0:06:01.23,0:06:05.07,Default,,0,0,0,,Хехе, бұл есеп емес, тағдыр.
Dialogue: 0,0:06:05.53,0:06:07.20,Default,,0,0,0,,Бей Бейді шақырады
Dialogue: 0,0:06:07.32,0:06:09.95,Default,,0,0,0,,Blader деп аталатын Blader.
Dialogue: 0,0:06:10.53,0:06:13.87,Default,,0,0,0,,Доктор Айбел, деректерді дұрыс алыңыз.
Dialogue: 0,0:06:13.99,0:06:17.16,Default,,0,0,0,,Уақытымды алып, ләззат аламын.
Dialogue: 0,0:06:19.92,0:06:21.63,Default,,0,0,0,,Фубуки төрешісін сұраңыз
Dialogue: 0,0:06:21.75,0:06:22.59,Default,,0,0,0,,Иә
Dialogue: 0,0:06:28.42,0:06:32.18,Default,,0,0,0,,Super Z Spriggan? Ол қандай шығанақ?
Dialogue: 0,0:06:33.30,0:06:37.35,Default,,0,0,0,,Бір екенімізді Шуға түсіндіремін.
Dialogue: 0,0:06:37.98,0:06:40.23,Default,,0,0,0,,Шабуыл режиміндегі шайқас!
Dialogue: 0,0:06:43.19,0:06:44.02,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:44.15,0:06:49.95,Default,,0,0,0,,Айга! Алдыңғы спригган сағат тілімен де, сағат тіліне қарсы да айнала алады.
Dialogue: 0,0:06:50.07,0:06:52.24,Default,,0,0,0,,Неліктен келесі жоғалтуды елемейсіз?
Dialogue: 0,0:06:52.99,0:06:54.62,Default,,0,0,0,,Егер сіз мұны түсінсеңіз!
Dialogue: 0,0:06:54.99,0:06:56.54,Default,,0,0,0,,Бұл бәрі емес.
Dialogue: 0,0:06:56.87,0:06:59.00,Default,,0,0,0,,Шабуылға төзімділік қорғанысы
Dialogue: 0,0:06:59.12,0:07:01.33,Default,,0,0,0,,Кез келген режимге ауысуға болады.
Dialogue: 0,0:07:02.04,0:07:05.21,Default,,0,0,0,,Әрқайсысы тітіркендіргіш! Шоғырлан!
Dialogue: 0,0:07:07.67,0:07:09.42,Default,,0,0,0,,Қандай режимге кірсеңіз де
Dialogue: 0,0:07:09.55,0:07:12.64,Default,,0,0,0,,Бұл мен және Ахиллес арасындағы резонансқа сәйкес келе ме?
Dialogue: 0,0:07:13.59,0:07:14.76,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:07:15.60,0:07:18.39,Default,,0,0,0,,Спригган - соңғы теңдестірілген тип.
Dialogue: 0,0:07:19.02,0:07:21.73,Default,,0,0,0,,Спригган дәл қалай өзгерді?
Dialogue: 0,0:07:21.85,0:07:25.15,Default,,0,0,0,,Мен Super Z Spriggan-ды асыға күтемін.
Dialogue: 0,0:07:29.94,0:07:31.57,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:07:32.03,0:07:35.32,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:07:35.66,0:07:38.08,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:07:38.45,0:07:41.21,Default,,0,0,0,,Супер оңтүстік крест атуы!
Dialogue: 0,0:07:43.33,0:07:44.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:44.96,0:07:46.34,Default,,0,0,0,,Super Zetsuwing
Dialogue: 0,0:07:49.59,0:07:51.22,Default,,0,0,0,,Super Zetsuwing?
Dialogue: 0,0:07:51.80,0:07:54.05,Default,,0,0,0,,Қабаттан үлкен жүзі секірді.
Dialogue: 0,0:07:54.47,0:07:56.01,Default,,0,0,0,,О~ Монду
Dialogue: 0,0:07:59.68,0:08:01.64,Default,,0,0,0,,Оң жақ айналумен төзімділік режимі
Dialogue: 0,0:08:04.40,0:08:06.23,Default,,0,0,0,,Кеттік, Ахиллес!
Dialogue: 0,0:08:06.52,0:08:09.03,Default,,0,0,0,,Super Z түсірілімі!
Dialogue: 0,0:08:10.82,0:08:12.53,Default,,0,0,0,,Супер қарсы үзіліс!
Dialogue: 0,0:08:17.66,0:08:18.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:21.20,0:08:22.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:22.46,0:08:24.92,Default,,0,0,0,,Super Z Spriggan Burst Finish
Dialogue: 0,0:08:25.67,0:08:27.04,Default,,0,0,0,,Бенишудың жеңісі
Dialogue: 0,0:08:27.34,0:08:31.09,Default,,0,0,0,,Бір соққыда жарылыс? Не болды? Эвел
Dialogue: 0,0:08:31.42,0:08:35.76,Default,,0,0,0,,Жасырын пышақ Спригганның үлкен айналу күші әсерінен шығып кетті.
Dialogue: 0,0:08:36.43,0:08:40.01,Default,,0,0,0,,Бұл шабуыл күшінің кенеттен артқанын білдіре ме?
Dialogue: 0,0:08:40.14,0:08:42.48,Default,,0,0,0,,Ах, бірақ бұл бәрі емес.
Dialogue: 0,0:08:43.35,0:08:46.10,Default,,0,0,0,,Әлі де жасырылған құпия болуы керек.
Dialogue: 0,0:08:46.40,0:08:48.06,Default,,0,0,0,,Ку... (Сочо) Айга
Dialogue: 0,0:08:48.61,0:08:52.36,Default,,0,0,0,,Мен аздап қателесіппін. Мен жақсы резонанс жасай алмадым.
Dialogue: 0,0:08:53.15,0:08:54.57,Default,,0,0,0,,Тағы бір шайқас.
Dialogue: 0,0:08:55.03,0:08:57.41,Default,,0,0,0,,Айға, сен жеңілдің.
Dialogue: 0,0:08:57.66,0:09:00.70,Default,,0,0,0,,Мен дұрыс резонанс жасай алсам, мен жарылыспен жеңер едім!
Dialogue: 0,0:09:01.12,0:09:03.41,Default,,0,0,0,,Олай болса маған тағы бір рет орындауға рұқсат етіңіз!
Dialogue: 0,0:09:04.54,0:09:06.62,Default,,0,0,0,,Фубукидің екінші шайқасы
Dialogue: 0,0:09:06.96,0:09:08.33,Default,,0,0,0,,Ах, Шу-сан.
Dialogue: 0,0:09:08.96,0:09:10.96,Default,,0,0,0,,Мен саған түсіндіремін
Dialogue: 0,0:09:11.09,0:09:14.34,Default,,0,0,0,,Мені резонанспен жеңе алмайсың!
Dialogue: 0,0:09:14.67,0:09:17.18,Default,,0,0,0,,Мен оны келесі жолы міндетті түрде үрлеймін!
Dialogue: 0,0:09:17.97,0:09:19.05,Default,,0,0,0,,Қызыл жүзді Айга
Dialogue: 0,0:09:19.18,0:09:23.18,Default,,0,0,0,,Ол сіздің резонанс күшіңізді шығаратын ең жақсы серіктес.
Dialogue: 0,0:09:23.72,0:09:26.44,Default,,0,0,0,,Маған максималды көрсетіңіз
Dialogue: 0,0:09:28.56,0:09:29.90,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:09:30.86,0:09:34.11,Default,,0,0,0,,Қараңдар, мен оны міндетті түрде жарып жіберемін.
Dialogue: 0,0:09:36.61,0:09:38.24,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:09:38.53,0:09:41.99,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:09:42.33,0:09:45.00,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:09:45.20,0:09:46.16,Default,,0,0,0,,Даа!
Dialogue: 0,0:09:54.30,0:09:57.01,Default,,0,0,0,,Бұл жолы сағат тіліне қарсы айналмалы қорғаныс режимі?
Dialogue: 0,0:09:57.38,0:09:59.47,Default,,0,0,0,,Керемет жоғарғы түсірілім!
Dialogue: 0,0:10:02.97,0:10:04.14,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:04.72,0:10:08.48,Default,,0,0,0,,Ахиллес ондай емес!
Dialogue: 0,0:10:14.86,0:10:18.32,Default,,0,0,0,,Аяқтаңыз! Super Z кесіндісі!
Dialogue: 0,0:10:22.45,0:10:23.58,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:10:26.12,0:10:26.95,Default,,0,0,0,,Не?
Dialogue: 0,0:10:27.62,0:10:29.71,Default,,0,0,0,,Super Z Slash жұмыс істемейді ме?
Dialogue: 0,0:10:30.42,0:10:33.46,Default,,0,0,0,,Себебі Super Zetsu ояту жүйесі іске қосылған.
Dialogue: 0,0:10:35.92,0:10:39.68,Default,,0,0,0,,Super Zetsuwing өшірілген кезде ол жарылып кетпейтін сияқты.
Dialogue: 0,0:10:39.80,0:10:41.22,Default,,0,0,0,,Егер ол жарылып кетпесе ше?
Dialogue: 0,0:10:41.68,0:10:44.10,Default,,0,0,0,,Ахиллес тағы да
Dialogue: 0,0:10:44.22,0:10:47.43,Default,,0,0,0,,Super Z Slash!
Dialogue: 0,0:10:50.02,0:10:51.10,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:10:59.74,0:11:01.61,Default,,0,0,0,,Шабуыл режимін өзгертіңіз!
Dialogue: 0,0:11:05.99,0:11:06.83,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:11:07.75,0:11:10.04,Default,,0,0,0,,Спригган шабуыл режиміне ауыстырылды
Dialogue: 0,0:11:10.16,0:11:11.46,Default,,0,0,0,,Не?
Dialogue: 0,0:11:12.08,0:11:13.92,Default,,0,0,0,,Жоғары! Спригган!
Dialogue: 0,0:11:18.88,0:11:21.22,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:22.13,0:11:23.09,Default,,0,0,0,,Айга!
Dialogue: 0,0:11:23.43,0:11:27.97,Default,,0,0,0,,Жақсы, Ахиллес, әрі қарай жүр, әрі қарай жүр!
Dialogue: 0,0:11:28.35,0:11:31.69,Default,,0,0,0,,Ахиллес қарғыс атсын!
Dialogue: 0,0:11:34.19,0:11:37.61,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:41.95,0:11:45.32,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:11:45.99,0:11:49.29,Default,,0,0,0,,Хаха~! Бұл жақсы, бұл жақсы!
Dialogue: 0,0:11:49.79,0:11:53.42,Default,,0,0,0,,Мұқият қара, Айға, бұл жаңғырық!
Dialogue: 0,0:11:53.92,0:11:55.33,Default,,0,0,0,,Спригган!
Dialogue: 0,0:12:00.30,0:12:01.72,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:12:02.13,0:12:05.18,Default,,0,0,0,,Super Spriggan Slash!
Dialogue: 0,0:12:13.69,0:12:14.52,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:14.81,0:12:15.77,Default,,0,0,0,,Уф... Уау!
Dialogue: 0,0:12:16.19,0:12:17.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:25.66,0:12:26.49,Default,,0,0,0,,Айға
Dialogue: 0,0:12:27.07,0:12:28.28,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:12:29.12,0:12:31.37,Default,,0,0,0,,Балаларға арналған тағам.
Dialogue: 0,0:12:32.91,0:12:35.50,Default,,0,0,0,,Мен жеңілдім бе?
Dialogue: 0,0:12:36.04,0:12:38.09,Default,,0,0,0,,Мені танымайсың ба?
Dialogue: 0,0:12:38.21,0:12:39.67,Default,,0,0,0,,Жарылыс жоғалту
Dialogue: 0,0:12:40.34,0:12:41.38,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:12:44.80,0:12:47.68,Default,,0,0,0,,Жарылыс жоғалту... Түсінемін.
Dialogue: 0,0:12:48.55,0:12:49.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:50.14,0:12:51.06,Default,,0,0,0,,Шу!
Dialogue: 0,0:12:52.64,0:12:56.31,Default,,0,0,0,,Фубуки Ранжиро, мені Айгамен оңаша қалдыршы.
Dialogue: 0,0:12:56.77,0:12:59.11,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:13:08.74,0:13:10.83,Default,,0,0,0,,Айга мен саған...
Dialogue: 0,0:13:10.95,0:13:15.33,Default,,0,0,0,,Менің соққым Спригганның жарылуына себеп болды.
Dialogue: 0,0:13:16.21,0:13:17.25,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:13:21.09,0:13:21.92,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:13:25.38,0:13:27.80,Default,,0,0,0,,Неліктен бұл ...
Dialogue: 0,0:13:28.51,0:13:31.93,Default,,0,0,0,,Өйткені Super Zetsu ояту жүйесі іске қосылды.
Dialogue: 0,0:13:32.68,0:13:34.31,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:34.98,0:13:39.19,Default,,0,0,0,,Спригган екеуміз резонанс тудырған кезде мен ең жақсы соққыны жасай алдым.
Dialogue: 0,0:13:39.65,0:13:41.73,Default,,0,0,0,,Super Zetsuwing шығады
Dialogue: 0,0:13:41.90,0:13:44.78,Default,,0,0,0,,Бұл Super Zetsu ояту жүйесі.
Dialogue: 0,0:13:46.28,0:13:50.49,Default,,0,0,0,,Super Zetsuwing пайда болғанда, шабуыл күші күрт артады.
Dialogue: 0,0:13:50.62,0:13:52.95,Default,,0,0,0,,Оның үстіне, егер бұл бөлік шығарылған болса
Dialogue: 0,0:13:53.49,0:13:55.70,Default,,0,0,0,,шығанақ ешқашан жарылмайды
Dialogue: 0,0:13:56.08,0:13:58.21,Default,,0,0,0,,Жарылыс жоқ па?
Dialogue: 0,0:13:58.79,0:14:00.13,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:14:01.79,0:14:02.63,Default,,0,0,0,,Хо
Dialogue: 0,0:14:03.13,0:14:06.76,Default,,0,0,0,,Дегенмен, Super Zetsu ояту жүйесін белсендіретін нәрсе
Dialogue: 0,0:14:06.88,0:14:08.68,Default,,0,0,0,,Бұл оңай емес
Dialogue: 0,0:14:08.80,0:14:11.76,Default,,0,0,0,,Бұл Беймен қарым-қатынасты қажет етеді.
Dialogue: 0,0:14:13.68,0:14:16.64,Default,,0,0,0,,Сіз біздің облигациямыз жоқ дейсіз бе?
Dialogue: 0,0:14:17.14,0:14:19.14,Default,,0,0,0,,Әй, әуре болма!
Dialogue: 0,0:14:19.85,0:14:23.90,Default,,0,0,0,,Super Zetsu-да не бар! Мен бұны құртамын!
Dialogue: 0,0:14:24.02,0:14:25.03,Default,,0,0,0,,Мен сені екеуіңді де жақсы көремін, сондықтан оны өзім бергім келеді.
Dialogue: 0,0:14:25.15,0:14:26.36,Default,,0,0,0,,Жібер!
Dialogue: 0,0:14:26.49,0:14:28.65,Default,,0,0,0,,Ей Шу, тағы ұрыс!
Dialogue: 0,0:14:29.15,0:14:30.53,Default,,0,0,0,,Айғаны тыңда
Dialogue: 0,0:14:30.91,0:14:32.49,Default,,0,0,0,,Оның алдында шайқас бар!
Dialogue: 0,0:14:33.20,0:14:34.08,Default,,0,0,0,,Тыңдаңыз!
Dialogue: 0,0:14:34.58,0:14:35.58,Default,,0,0,0,,Ах
Dialogue: 0,0:14:37.04,0:14:38.33,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:14:39.83,0:14:43.34,Default,,0,0,0,,Өзімді Қызыл көз деп атаған кезім болды.
Dialogue: 0,0:14:43.92,0:14:45.34,Default,,0,0,0,,Қызыл көз?
Dialogue: 0,0:14:45.92,0:14:48.05,Default,,0,0,0,,Өйткені мен күшті болғым келеді
Dialogue: 0,0:14:48.17,0:14:50.34,Default,,0,0,0,,Куришуу есімді жүзді тастап кетті.
Dialogue: 0,0:14:52.60,0:14:56.60,Default,,0,0,0,,Ең үлкен күш - шығанақты жою
Dialogue: 0,0:14:58.48,0:14:59.56,Default,,0,0,0,,Жоғал!
Dialogue: 0,0:15:02.10,0:15:04.36,Default,,0,0,0,,Қарсы үзіліс! (Спригган айқайлайды)
Dialogue: 0,0:15:12.36,0:15:16.41,Default,,0,0,0,,Ең мықты болу үшін Спригганға үстемдік етуге тырысу
Dialogue: 0,0:15:16.54,0:15:19.37,Default,,0,0,0,,Керісінше, жұтылды
Dialogue: 0,0:15:21.21,0:15:23.54,Default,,0,0,0,,Егер біз сол күйімізбен жалғастырсақ, мүмкін
Dialogue: 0,0:15:23.67,0:15:26.17,Default,,0,0,0,,Ол Blader ретінде жойылған болуы керек.
Dialogue: 0,0:15:26.71,0:15:27.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:28.92,0:15:32.05,Default,,0,0,0,,Бірақ менің достарым болды.
Dialogue: 0,0:15:32.18,0:15:35.68,Default,,0,0,0,,Мені одан құтқарған досым бар еді.
Dialogue: 0,0:15:37.01,0:15:41.44,Default,,0,0,0,,Уау! Балтық!
Dialogue: 0,0:15:41.73,0:15:45.73,Default,,0,0,0,,Сен менің ең жақын досымсың, сондықтан...
Dialogue: 0,0:15:45.86,0:15:51.32,Default,,0,0,0,,Сондықтан өлсем де сенен жеңіле алмаймын.
Dialogue: 0,0:15:52.03,0:15:54.28,Default,,0,0,0,,Біз жеңілуге ​​шыдай алмаймыз!
Dialogue: 0,0:15:54.87,0:15:56.20,Default,,0,0,0,,Мен де...
Dialogue: 0,0:15:56.62,0:16:00.33,Default,,0,0,0,,Шу Себебі сен Шусың
Dialogue: 0,0:16:00.75,0:16:03.46,Default,,0,0,0,,Мен міндетті түрде жеңемін!
Dialogue: 0,0:16:06.46,0:16:09.80,Default,,0,0,0,,Шу!
Dialogue: 0,0:16:13.26,0:16:16.76,Default,,0,0,0,,Шыу!
Dialogue: 0,0:16:19.72,0:16:25.19,Default,,0,0,0,,Бүкіл ойларын шығанаққа салып, бар күшімен маған жеткізді.
Dialogue: 0,0:16:26.27,0:16:29.86,Default,,0,0,0,,Нағыз күш - резонанс!
Dialogue: 0,0:16:35.57,0:16:36.95,Default,,0,0,0,,Жетеді
Dialogue: 0,0:16:37.78,0:16:40.08,Default,,0,0,0,,Керемет! Ақыры…!
Dialogue: 0,0:16:40.24,0:16:41.29,Default,,0,0,0,,Айға
Dialogue: 0,0:16:42.20,0:16:43.83,Default,,0,0,0,,Мен Қызыл көз емеспін
Dialogue: 0,0:16:43.96,0:16:44.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:45.50,0:16:47.04,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:16:47.54,0:16:52.17,Default,,0,0,0,,Ахиллес екеуміз көбірек резонанс тудырып, одан сайын күшейеміз!
Dialogue: 0,0:16:52.30,0:16:54.88,Default,,0,0,0,,Мен супер Цетсу, ең күшті және жеңілмейтін боламын!
Dialogue: 0,0:16:56.30,0:16:58.30,Default,,0,0,0,,Күте тұрыңыз, Айга! Жіберу!
Dialogue: 0,0:16:58.51,0:17:01.06,Default,,0,0,0,,Сенің маған деген көзқарасыңды естуді шыдамаймын!
Dialogue: 0,0:17:01.18,0:17:03.48,Default,,0,0,0,,О, мен түсінбедім, Барса!
Dialogue: 0,0:17:04.60,0:17:08.19,Default,,0,0,0,,Мен сені ақымақ деп айттым ба? Сені ақымақ десе, ақымақ.
Dialogue: 0,0:17:08.31,0:17:10.86,Default,,0,0,0,,Мен сені ақымақ деп атадым, өйткені сен ақымақсың!
Dialogue: 0,0:17:11.07,0:17:14.19,Default,,0,0,0,,Сонда Сочо ақымақ, өйткені ол ақымақ!
Dialogue: 0,0:17:14.99,0:17:15.82,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:18.49,0:17:19.45,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:23.91,0:17:24.91,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:17:32.63,0:17:34.38,Default,,0,0,0,,Ах! О, менің!
Dialogue: 0,0:17:35.09,0:17:37.09,Default,,0,0,0,,О! Айга!
Dialogue: 0,0:17:37.76,0:17:40.35,Default,,0,0,0,,Барто Аои Сенпай
Dialogue: 0,0:17:41.26,0:17:42.14,Default,,0,0,0,,Балто!
Dialogue: 0,0:17:43.27,0:17:44.10,Default,,0,0,0,,Шу!
Dialogue: 0,0:17:45.18,0:17:46.31,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:17:46.77,0:17:47.77,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:17:47.90,0:17:50.40,Default,,0,0,0,,Сіз де Айгаға алаңдай бастадыңыз ба?
Dialogue: 0,0:17:51.02,0:17:52.57,Default,,0,0,0,,Алдын ала...
Dialogue: 0,0:17:53.98,0:17:57.07,Default,,0,0,0,,Иә, балалар қарндарың аш, солай ма?
Dialogue: 0,0:17:58.45,0:17:59.53,Default,,0,0,0,,Олай болса!
Dialogue: 0,0:18:00.20,0:18:03.33,Default,,0,0,0,,Бұл анам жасаған Ахиллес наны!
Dialogue: 0,0:18:03.54,0:18:05.00,Default,,0,0,0,,Сізге ұнады, солай ма?
Dialogue: 0,0:18:05.41,0:18:08.50,Default,,0,0,0,,О! Дәмді көрінеді!
Dialogue: 0,0:18:10.67,0:18:11.88,Default,,0,0,0,,Сіз де жеңіз!
Dialogue: 0,0:18:12.42,0:18:15.55,Default,,0,0,0,,Мен гот боламын! Мен мұны ұнатамын
Dialogue: 0,0:18:16.09,0:18:17.38,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:18.05,0:18:21.60,Default,,0,0,0,,Менің анам жасаған нан әлемдегі ең жақсы нан!
Dialogue: 0,0:18:21.85,0:18:23.35,Default,,0,0,0,,Балто иә?
Dialogue: 0,0:18:23.85,0:18:28.10,Default,,0,0,0,,Егер сіз осында болсаңыз, соңында оны аяқтадыңыз.
Dialogue: 0,0:18:28.52,0:18:30.40,Default,,0,0,0,,Шу, сен де?
Dialogue: 0,0:18:30.52,0:18:32.31,Default,,0,0,0,,Аа, баяғыда
Dialogue: 0,0:18:32.44,0:18:35.86,Default,,0,0,0,,Куу~! Мен тағы да оздым.
Dialogue: 0,0:18:36.24,0:18:38.86,Default,,0,0,0,,Хаха~ Жүректер!
Dialogue: 0,0:18:39.24,0:18:43.16,Default,,0,0,0,,Оларда Dead Grand Show үшін ең жақсы актерлар бар сияқты.
Dialogue: 0,0:18:43.28,0:18:44.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:44.99,0:18:47.25,Default,,0,0,0,,Уау! (Сочо) Жер сілкінісі?
Dialogue: 0,0:18:51.00,0:18:52.25,Default,,0,0,0,,Баспалдақтар...
Dialogue: 0,0:18:56.59,0:18:57.59,Default,,0,0,0,,Ах
Dialogue: 0,0:18:58.67,0:19:03.39,Default,,0,0,0,,Барто Аой, Шу күреңай, бәрің кіріңдер!
Dialogue: 0,0:19:03.68,0:19:06.89,Default,,0,0,0,,Ей, менімен болған шайқасты ұмытпа!
Dialogue: 0,0:19:07.68,0:19:12.40,Default,,0,0,0,,Уайымдама, Айға Ақаба, мен саған алдымен тамақ дайындаймын.
Dialogue: 0,0:19:13.40,0:19:16.53,Default,,0,0,0,,Жарайсыңдар! Қанекей мынаны істейік!
Dialogue: 0,0:19:16.65,0:19:17.48,Default,,0,0,0,,Эй!
Dialogue: 0,0:19:18.44,0:19:20.36,Default,,0,0,0,,Осы уақытқа дейін есептегенімді білмедім...
Dialogue: 0,0:19:20.49,0:19:21.32,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:21.45,0:19:23.24,Default,,0,0,0,,Барто Аои мен Шуу Куренаи
Dialogue: 0,0:19:23.37,0:19:29.25,Default,,0,0,0,,Екі адам назар аударып тұрған қызыл жүзді Айганы көз алдында толығымен жойыңыз.
Dialogue: 0,0:19:29.37,0:19:32.00,Default,,0,0,0,,Бұл сіздің мақсатыңыз болды ма?
Dialogue: 0,0:19:32.12,0:19:36.00,Default,,0,0,0,,Бұл есеп емес, тағдыр дедім ғой.
Dialogue: 0,0:19:36.42,0:19:39.92,Default,,0,0,0,,Тағдырдай қатыгез, тамаша қойылым жоқ.
Dialogue: 0,0:19:42.05,0:19:46.14,Default,,0,0,0,,Хаха~ Блейдерлер бүкіл әлем бойынша!
Dialogue: 0,0:19:46.26,0:19:51.39,Default,,0,0,0,,Енді менің өлі ұлы шоуымның басы!
Dialogue: 0,0:19:51.52,0:19:54.90,Default,,0,0,0,,Атақты меннен Айға Ақаба тартып алды.
Dialogue: 0,0:19:55.31,0:19:58.40,Default,,0,0,0,,Өкінбей, қайта тырысты.
Dialogue: 0,0:19:58.65,0:20:02.45,Default,,0,0,0,,Жер асты әлемінің жын иесі Жүрек-сама мен жеңілген Қызыл жүз Айға.
Dialogue: 0,0:20:02.57,0:20:05.78,Default,,0,0,0,,Қызықты шайқастан ләззат алыңыз!
Dialogue: 0,0:20:05.91,0:20:07.41,Default,,0,0,0,,Жұмсақ…
Dialogue: 0,0:20:07.91,0:20:09.33,Default,,0,0,0,,Айға матч.
Dialogue: 0,0:20:09.45,0:20:10.91,Default,,0,0,0,,Соңында Жүректермен ойнау
Dialogue: 0,0:20:12.37,0:20:13.42,Default,,0,0,0,,Айга...
Dialogue: 0,0:20:17.34,0:20:21.30,Default,,0,0,0,,Ухэхехе Жаман ұлдар мен қыздар
Dialogue: 0,0:20:21.67,0:20:26.09,Default,,0,0,0,,Тозақтан тікелей түсініктеме Кезек Демон мырзаға келді!
Dialogue: 0,0:20:26.39,0:20:28.22,Default,,0,0,0,,Ақыры, Қызыл жүз Айга
Dialogue: 0,0:20:28.35,0:20:31.48,Default,,0,0,0,,Мен Өлі Колизейге келдім.
Dialogue: 0,0:20:31.60,0:20:32.56,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:34.77,0:20:36.56,Default,,0,0,0,,Сәттілік Айға!
Dialogue: 0,0:20:36.77,0:20:37.94,Default,,0,0,0,,Дохья!
Dialogue: 0,0:20:38.07,0:20:43.65,Default,,0,0,0,,Қызыл Жүрек Айға Жүрек-саманың олжасына айналады.
Dialogue: 0,0:20:44.49,0:20:45.32,Default,,0,0,0,,Әй?
Dialogue: 0,0:20:46.57,0:20:48.62,Default,,0,0,0,,Ах, Бал-нии.
Dialogue: 0,0:20:48.87,0:20:49.70,Default,,0,0,0,,Аға?
Dialogue: 0,0:20:50.58,0:20:51.41,Default,,0,0,0,,Фубуки!
Dialogue: 0,0:20:51.54,0:20:54.54,Default,,0,0,0,,Әй, қасымдағы адам... (Хика) Шу!
Dialogue: 0,0:20:55.54,0:20:56.71,Default,,0,0,0,,Мен де осындамын!
Dialogue: 0,0:20:57.21,0:20:58.46,Default,,0,0,0,,Уау, сочо!
Dialogue: 0,0:20:58.92,0:21:00.50,Default,,0,0,0,,Бүгін де керемет көрінесің!
Dialogue: 0,0:21:00.63,0:21:01.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:03.13,0:21:05.26,Default,,0,0,0,,Жаман ұлдар мен қыздар
Dialogue: 0,0:21:05.38,0:21:09.64,Default,,0,0,0,,Жер асты әлемінің жын иесі, Жүрек, міне!
Dialogue: 0,0:21:09.93,0:21:10.81,Default,,0,0,0,,Шута!
Dialogue: 0,0:21:10.93,0:21:14.27,Default,,0,0,0,,Хаха~ Өзіңізді дайындаңыз!
Dialogue: 0,0:21:14.39,0:21:17.65,Default,,0,0,0,,Мен сені тозаққа құлатамын!
Dialogue: 0,0:21:18.11,0:21:22.65,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:23.61,0:21:25.11,Default,,0,0,0,,Жүректерді жеңу
Dialogue: 0,0:21:25.24,0:21:29.16,Default,,0,0,0,,Шу мен Балтаға резонансымызды көрсетейік.
Dialogue: 0,0:21:32.20,0:21:36.04,Default,,0,0,0,,Иә, Ахиллес, бұл жақсы.
Dialogue: 0,0:21:36.83,0:21:37.67,Default,,0,0,0,,Ha
Dialogue: 0,0:21:38.38,0:21:40.67,Default,,0,0,0,,Дайын болыңдар, жүректер!
Dialogue: 0,0:21:41.30,0:21:45.38,Default,,0,0,0,,Мен және Ахиллес Омені құртпақпыз.
Dialogue: 0,0:21:54.68,0:22:00.69,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:16.93,0:23:22.94,Default,,0,0,0,,~♪
Dialogue: 0,0:23:24.61,0:23:26.61,Default,,0,0,0,,Істі Жүрекпен шешейік!
Dialogue: 0,0:23:27.11,0:23:29.65,Default,,0,0,0,,Мен және Ахиллес біртұтас болдық.
Dialogue: 0,0:23:29.78,0:23:32.45,Default,,0,0,0,,Міндетті түрде Айды құртамыз, біз
Dialogue: 0,0:23:32.57,0:23:35.87,Default,,0,0,0,,Мен сенің супер Цетсу, ең күшті және жеңілмейтін екеніңді түсіндіремін!
Dialogue: 0,0:23:35.99,0:23:39.75,Default,,0,0,0,,Соңында әлем чемпионы үшін матч басталады.
Dialogue: 0,0:23:40.25,0:23:42.75,Default,,0,0,0,,Келесі жолы «Beyblade Burst Super Zetsu»
Dialogue: 0,0:23:42.87,0:23:44.92,Default,,0,0,0,,«Айга: Қараңғылықпен күрес!»
Dialogue: 0,0:23:45.04,0:23:46.88,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.00,0:23:49.01,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:50.51,0:23:56.51,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory