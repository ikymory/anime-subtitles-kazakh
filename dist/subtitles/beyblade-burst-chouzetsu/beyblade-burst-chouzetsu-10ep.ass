Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.75,0:00:04.04,Default,,0,0,0,,Бейблейд
Dialogue: 0,0:00:04.25,0:00:08.13,Default,,0,0,0,,Мықты болуды мақсат еткен ұлдардың арманының жемісі.
Dialogue: 0,0:00:08.92,0:00:12.38,Default,,0,0,0,,Енді супер Цетсу дәуірі басталады.
Dialogue: 0,0:00:12.51,0:00:16.85,Default,,0,0,0,,Металл сауытыңызды киіңіз де, Беймен шытырман оқиғаға аттаныңыз!
Dialogue: 0,0:00:16.97,0:00:19.31,Default,,0,0,0,,Әлем чемпионы болуды мақсат етіңіз!
Dialogue: 0,0:00:19.43,0:00:23.69,Default,,0,0,0,,Super Zetsu Super Zetsu Super Zetsu!
Dialogue: 0,0:00:24.31,0:00:28.11,Default,,0,0,0,,Ең күшті және жеңілмейтін атағын алатын адам сенсің!
Dialogue: 0,0:00:38.62,0:00:40.66,Default,,0,0,0,,Жарайды... мен істеймін.
Dialogue: 0,0:00:41.29,0:00:43.96,Default,,0,0,0,,Суу-кун мен... Сал
Dialogue: 0,0:00:44.29,0:00:46.29,Default,,0,0,0,,Мен бұл туралы жақсы сезінемін.
Dialogue: 0,0:00:48.17,0:00:49.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:51.13,0:00:56.05,Default,,0,0,0,,Сенгісіз! Гошуин Суоның келбеті өзгерді!
Dialogue: 0,0:00:59.80,0:01:00.68,Default,,0,0,0,,Фу…
Dialogue: 0,0:01:01.01,0:01:03.35,Default,,0,0,0,,Өрт құйын Гекирин!
Dialogue: 0,0:01:04.89,0:01:06.85,Default,,0,0,0,,Лонгинус кубогының екінші кезеңі
Dialogue: 0,0:01:06.94,0:01:11.36,Default,,0,0,0,,Гошуин Суоның саламандры керемет күшті болды!
Dialogue: 0,0:01:11.57,0:01:12.48,Default,,0,0,0,,Айга...
Dialogue: 0,0:01:12.78,0:01:16.32,Default,,0,0,0,,Ал екінші раундты бүкіл әлем бойынша бағындырған жүзушілер...
Dialogue: 0,0:01:16.70,0:01:19.53,Default,,0,0,0,,Біз Жапонияға ширек финалға келдік!
Dialogue: 0,0:01:19.95,0:01:21.62,Default,,0,0,0,,Оу Хоуи.
Dialogue: 0,0:01:22.08,0:01:23.75,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:01:23.83,0:01:25.54,Default,,0,0,0,,Айтайын дегенім, не істеп жатырсың?!
Dialogue: 0,0:01:25.62,0:01:26.50,Default,,0,0,0,,Тазалау
Dialogue: 0,0:01:31.17,0:01:33.46,Default,,0,0,0,,Қарғыс атсын... Мен қалпын жоғалта алмаймын.
Dialogue: 0,0:01:33.92,0:01:36.22,Default,,0,0,0,,Бұл Арчер Геркулес
Dialogue: 0,0:01:39.76,0:01:41.47,Default,,0,0,0,,Шексіз айналу!
Dialogue: 0,0:01:44.56,0:01:45.23,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:52.44,0:01:53.32,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:01:54.98,0:01:56.15,Default,,0,0,0,,(дыбыс жоқ)
Dialogue: 0,0:01:56.53,0:01:59.36,Default,,0,0,0,,Барған сайын қызық болып барады!
Dialogue: 0,0:02:00.49,0:02:06.45,Default,,0,0,0,,♪~
Dialogue: 0,0:03:23.11,0:03:29.16,Default,,0,0,0,,~♪
Dialogue: 0,0:03:29.83,0:03:32.62,Default,,0,0,0,,«Ахиллес Рагнарукқа қарсы!!»
Dialogue: 0,0:03:34.67,0:03:36.00,Default,,0,0,0,,(Құстардың сайрауы)
Dialogue: 0,0:03:36.09,0:03:37.96,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:03:40.76,0:03:43.05,Default,,0,0,0,,Айга Керемет түсірілім!
Dialogue: 0,0:03:43.18,0:03:44.47,Default,,0,0,0,,Жақсы ату
Dialogue: 0,0:03:45.14,0:03:49.39,Default,,0,0,0,,Ширек финалдан қарсыластар лотерея арқылы кездейсоқ анықталады.
Dialogue: 0,0:03:49.68,0:03:52.10,Default,,0,0,0,,Келесі жолы мен жауап алуым мүмкін.
Dialogue: 0,0:03:53.14,0:03:54.48,Default,,0,0,0,,Мен жеңдім
Dialogue: 0,0:03:54.81,0:03:58.11,Default,,0,0,0,,Хе... Мені ұрмайынша жеңілмейсің.
Dialogue: 0,0:03:58.23,0:04:00.90,Default,,0,0,0,,Мен сені міндетті түрде жеңемін.
Dialogue: 0,0:04:00.99,0:04:01.86,Default,,0,0,0,,Хе
Dialogue: 0,0:04:02.45,0:04:03.86,Default,,0,0,0,,Айгамона
Dialogue: 0,0:04:04.11,0:04:04.99,Default,,0,0,0,,Хун
Dialogue: 0,0:04:05.57,0:04:07.74,Default,,0,0,0,,Күліп жатқан шығарсың?
Dialogue: 0,0:04:07.83,0:04:08.66,Default,,0,0,0,,О
Dialogue: 0,0:04:08.74,0:04:10.25,Default,,0,0,0,,Түсіну қиын!
Dialogue: 0,0:04:15.46,0:04:17.67,Default,,0,0,0,,Менің келесі жоспарларым бар.
Dialogue: 0,0:04:20.00,0:04:20.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:20.96,0:04:22.42,Default,,0,0,0,,Жүгіру?
Dialogue: 0,0:04:22.51,0:04:23.63,Default,,0,0,0,,Мен де барамын!
Dialogue: 0,0:04:30.64,0:04:31.47,Default,,0,0,0,,Міне, келдік
Dialogue: 0,0:04:31.81,0:04:32.68,Default,,0,0,0,,Жарайды
Dialogue: 0,0:04:33.81,0:04:34.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:37.56,0:04:38.56,Default,,0,0,0,,бірақ ол да маған күдікпен қарады…
Dialogue: 0,0:04:39.48,0:04:42.61,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:04:42.78,0:04:44.74,Default,,0,0,0,,О! (Ранджиро Кияма) Хмм... аа?
Dialogue: 0,0:04:45.82,0:04:47.99,Default,,0,0,0,,Уа, бұл не?
Dialogue: 0,0:04:48.57,0:04:50.70,Default,,0,0,0,,Кенет айғайлады
Dialogue: 0,0:04:50.95,0:04:52.08,Default,,0,0,0,,Howi…
Dialogue: 0,0:04:52.20,0:04:53.87,Default,,0,0,0,,А? Бұл не?
Dialogue: 0,0:04:56.83,0:04:58.21,Default,,0,0,0,,Адам ұрлау
Dialogue: 0,0:04:58.54,0:04:59.67,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:05:00.17,0:05:01.42,Default,,0,0,0,,Хоуи!
Dialogue: 0,0:05:01.80,0:05:02.96,Default,,0,0,0,,Оған көмектесу мүмкін емес!
Dialogue: 0,0:05:06.88,0:05:08.68,Default,,0,0,0,,Хоуи~!
Dialogue: 0,0:05:08.80,0:05:11.81,Default,,0,0,0,,Тоқта! Сол көлік!
Dialogue: 0,0:05:13.89,0:05:16.10,Default,,0,0,0,,Мен бұны киемін… жетімдер үйінде өткізген күндерімді ұмытпау үшін.
Dialogue: 0,0:05:16.52,0:05:18.56,Default,,0,0,0,,А... қашып кетейін!
Dialogue: 0,0:05:18.65,0:05:19.65,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:05:20.61,0:05:21.44,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:22.48,0:05:23.78,Default,,0,0,0,,Уууу!
Dialogue: 0,0:05:23.90,0:05:24.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:25.40,0:05:27.82,Default,,0,0,0,,Ол жылдам жігіт.
Dialogue: 0,0:05:28.07,0:05:30.07,Default,,0,0,0,,Сочо! (Ранджиро) Әй?
Dialogue: 0,0:05:31.33,0:05:33.24,Default,,0,0,0,,Не болды? Сочо
Dialogue: 0,0:05:33.33,0:05:34.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:34.79,0:05:35.62,Default,,0,0,0,,(тамақты тазартады)
Dialogue: 0,0:05:35.96,0:05:39.08,Default,,0,0,0,,Теме және т.б. Сіз дұрыс жерге келдіңіз.
Dialogue: 0,0:05:39.83,0:05:43.38,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:05:44.17,0:05:46.05,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:05:46.17,0:05:49.14,Default,,0,0,0,,Ақыры... таптым.
Dialogue: 0,0:05:51.47,0:05:52.47,Default,,0,0,0,,Ха… Жылдам ашып көр.
Dialogue: 0,0:05:53.06,0:05:56.23,Default,,0,0,0,,Теменің жақсы нәрселерге ие болуына жол берме.
Dialogue: 0,0:05:56.43,0:06:00.31,Default,,0,0,0,,Сочо, мен қазір кетемін, мені күте тұрыңыз...
Dialogue: 0,0:06:00.52,0:06:01.52,Default,,0,0,0,,(дыбыс жоқ)
Dialogue: 0,0:06:04.07,0:06:05.65,Default,,0,0,0,,Олар ма?
Dialogue: 0,0:06:05.94,0:06:07.24,Default,,0,0,0,,Сөз жоқ
Dialogue: 0,0:06:07.70,0:06:10.36,Default,,0,0,0,,Иә, мен жақсы нәрсе ойладым.
Dialogue: 0,0:06:10.49,0:06:11.37,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:11.78,0:06:12.91,Default,,0,0,0,,Маған құлағыңды бер
Dialogue: 0,0:06:14.95,0:06:16.16,Default,,0,0,0,,(шұңқырлар соқтығысқан дыбыс)
Dialogue: 0,0:06:16.25,0:06:17.08,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:18.96,0:06:20.75,Default,,0,0,0,,Уах уа уа...
Dialogue: 0,0:06:21.00,0:06:23.00,Default,,0,0,0,,Қазір! (Ранджиро) Каре~!
Dialogue: 0,0:06:23.09,0:06:25.25,Default,,0,0,0,,Уууу!
Dialogue: 0,0:06:25.92,0:06:27.13,Default,,0,0,0,,Уряа! (Саябақ) Ах!
Dialogue: 0,0:06:28.55,0:06:29.84,Default,,0,0,0,,Сіз ұрлаушы!
Dialogue: 0,0:06:29.97,0:06:31.14,Default,,0,0,0,,Бұл қандай жігіттер...
Dialogue: 0,0:06:31.47,0:06:33.85,Default,,0,0,0,,Тоқта! Мен алға қарай алмаймын...
Dialogue: 0,0:06:33.93,0:06:35.64,Default,,0,0,0,,Мен көмектесуге келдім! Қалай~!
Dialogue: 0,0:06:37.85,0:06:38.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:38.98,0:06:40.31,Default,,0,0,0,,Ұшып кет…
Dialogue: 0,0:06:40.44,0:06:42.86,Default,,0,0,0,,Мен Темеге көмектесуге келдім!
Dialogue: 0,0:06:45.15,0:06:46.28,Default,,0,0,0,,Көмек беру үшін?
Dialogue: 0,0:06:46.61,0:06:48.95,Default,,0,0,0,,Ол ұрланған жоқ па?
Dialogue: 0,0:06:49.07,0:06:51.03,Default,,0,0,0,,Бұл түсінбеушілік, балалар...
Dialogue: 0,0:06:51.61,0:06:54.37,Default,,0,0,0,,Жібер, бұл менің жаттықтырушым.
Dialogue: 0,0:06:54.70,0:06:55.74,Default,,0,0,0,,Ал...
Dialogue: 0,0:06:55.87,0:06:57.33,Default,,0,0,0,,Жаттықтырушы?
Dialogue: 0,0:06:57.45,0:07:00.25,Default,,0,0,0,,Бұл садақ ату жаттығу алаңы.
Dialogue: 0,0:07:00.83,0:07:02.00,Default,,0,0,0,,үшін? (Ранджиро) Әй?
Dialogue: 0,0:07:02.46,0:07:05.13,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:07:05.25,0:07:06.13,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:07:23.35,0:07:24.77,Default,,0,0,0,,Уаһ…
Dialogue: 0,0:07:25.11,0:07:26.27,Default,,0,0,0,,Қателер жоқ
Dialogue: 0,0:07:26.36,0:07:27.57,Default,,0,0,0,,Панай
Dialogue: 0,0:07:27.73,0:07:29.65,Default,,0,0,0,,Барлығы ортада...
Dialogue: 0,0:07:33.36,0:07:34.99,Default,,0,0,0,,Сіз де түсіріп көргіңіз келе ме?
Dialogue: 0,0:07:35.12,0:07:36.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:36.24,0:07:38.04,Default,,0,0,0,,Мен мұны істеймін.
Dialogue: 0,0:07:38.20,0:07:41.16,Default,,0,0,0,,Хмм... Қызық, әуесқой түсіре ала ма?
Dialogue: 0,0:07:41.50,0:07:43.42,Default,,0,0,0,,Сочоны бағалама!
Dialogue: 0,0:07:43.50,0:07:45.04,Default,,0,0,0,,Жарылыспен шешіңіз!
Dialogue: 0,0:07:45.38,0:07:47.34,Default,,0,0,0,,Чоро, мұндай нәрсе
Dialogue: 0,0:07:47.46,0:07:48.30,Default,,0,0,0,,Хмф!
Dialogue: 0,0:07:49.63,0:07:50.59,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:51.38,0:07:53.47,Default,,0,0,0,,Уф! Қарғыс атқыр...
Dialogue: 0,0:07:53.76,0:07:56.51,Default,,0,0,0,,Куууу…
Dialogue: 0,0:07:57.43,0:07:59.39,Default,,0,0,0,,Жүр! Сочо!
Dialogue: 0,0:07:59.47,0:08:00.10,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:03.31,0:08:04.15,Default,,0,0,0,,Tsk
Dialogue: 0,0:08:04.27,0:08:05.48,Default,,0,0,0,,Ихихихи…
Dialogue: 0,0:08:05.86,0:08:07.44,Default,,0,0,0,,Аняру…
Dialogue: 0,0:08:07.57,0:08:08.73,Default,,0,0,0,,Дөңмай
Dialogue: 0,0:08:09.48,0:08:11.74,Default,,0,0,0,,Жарайды, келесі мен.
Dialogue: 0,0:08:11.94,0:08:13.99,Default,,0,0,0,,Бұл мүмкін емес, тоқтат!
Dialogue: 0,0:08:14.07,0:08:15.24,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:08:15.66,0:08:17.87,Default,,0,0,0,,Әй, осылай шықты.
Dialogue: 0,0:08:18.45,0:08:20.50,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:20.83,0:08:22.75,Default,,0,0,0,,Иә! Uso...
Dialogue: 0,0:08:26.04,0:08:28.25,Default,,0,0,0,,Жақсы концентрацияға ие
Dialogue: 0,0:08:32.42,0:08:33.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:33.84,0:08:34.80,Default,,0,0,0,,О...
Dialogue: 0,0:08:34.93,0:08:37.76,Default,,0,0,0,,Бала оны бірінші рет болжаған...
Dialogue: 0,0:08:38.10,0:08:40.10,Default,,0,0,0,,Хехе, бұл қандай нәрсе?
Dialogue: 0,0:08:40.22,0:08:42.23,Default,,0,0,0,,Тексеріңіз... Бұл Магрет Магрет
Dialogue: 0,0:08:42.35,0:08:45.48,Default,,0,0,0,,Мен де Лонгинус кубогының дәл ортасында жұдырықтаймын!
Dialogue: 0,0:08:47.86,0:08:49.36,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:50.69,0:08:51.73,Default,,0,0,0,,Ооо...
Dialogue: 0,0:08:51.94,0:08:53.53,Default,,0,0,0,,Бұл магрет емес пе?
Dialogue: 0,0:08:51.94,0:08:53.53,Default,,0,0,0,,(жебенің түсу дыбысы)
Dialogue: 0,0:08:53.53,0:08:53.99,Default,,0,0,0,,Бұл магрет емес пе?
Dialogue: 0,0:08:54.45,0:08:56.49,Default,,0,0,0,,Магрет Магрет Ух...
Dialogue: 0,0:08:56.57,0:08:58.95,Default,,0,0,0,,Магре Магре
Dialogue: 0,0:08:59.33,0:09:01.66,Default,,0,0,0,,Сіз зейінді жоғалттыңыз ба? (5 адам) Магрет...
Dialogue: 0,0:09:04.21,0:09:05.46,Default,,0,0,0,,(Құстардың сайрауы)
Dialogue: 0,0:09:05.54,0:09:07.63,Default,,0,0,0,,Айга! Ол шешілді!
Dialogue: 0,0:09:07.79,0:09:09.38,Default,,0,0,0,,Хмм... не?
Dialogue: 0,0:09:09.71,0:09:12.38,Default,,0,0,0,,Лонгинус кубогындағы келесі қарсылас
Dialogue: 0,0:09:12.51,0:09:13.76,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:09:14.67,0:09:17.51,Default,,0,0,0,,Сочоның қарсыласы - Қызыл жүз Айга
Dialogue: 0,0:09:17.59,0:09:19.26,Default,,0,0,0,,Хмм…
Dialogue: 0,0:09:20.68,0:09:21.97,Default,,0,0,0,,Айга?
Dialogue: 0,0:09:23.77,0:09:24.64,Default,,0,0,0,,Фу…
Dialogue: 0,0:09:24.93,0:09:26.73,Default,,0,0,0,,Сочо?
Dialogue: 0,0:09:28.02,0:09:28.90,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:30.15,0:09:30.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:31.94,0:09:33.36,Default,,0,0,0,,Менің қарсыласым кім?
Dialogue: 0,0:09:33.94,0:09:35.49,Default,,0,0,0,,Ал...
Dialogue: 0,0:09:35.86,0:09:36.61,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:09:37.36,0:09:39.07,Default,,0,0,0,,Дхаула Гири Үндістанда!
Dialogue: 0,0:09:39.41,0:09:40.74,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:43.12,0:09:44.33,Default,,0,0,0,,Не болды?
Dialogue: 0,0:09:44.70,0:09:47.92,Default,,0,0,0,,Мен... Мен жыландарды ұнатпаймын.
Dialogue: 0,0:09:48.54,0:09:50.54,Default,,0,0,0,,Сіз қорқып тұрған шығарсыз?
Dialogue: 0,0:09:50.71,0:09:52.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:52.21,0:09:53.25,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:09:53.34,0:09:55.59,Default,,0,0,0,,Күлімдеген кездегідей емес пе?
Dialogue: 0,0:10:05.77,0:10:08.64,Default,,0,0,0,,Мен шіріген гүлдерді кесемін.
Dialogue: 0,0:10:09.40,0:10:10.48,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:10:12.44,0:10:14.94,Default,,0,0,0,,Жарайды! Ұлдар мен қыздар!
Dialogue: 0,0:10:15.03,0:10:17.95,Default,,0,0,0,,Лонгинус кубогының 1/4 финалының өтетін орны
Dialogue: 0,0:10:18.03,0:10:19.82,Default,,0,0,0,,Bay Arena!
Dialogue: 0,0:10:19.99,0:10:24.45,Default,,0,0,0,,Ал Балт пен Луис матчында қираған стадион...
Dialogue: 0,0:10:24.54,0:10:26.00,Default,,0,0,0,,Жаңарту!
Dialogue: 0,0:10:26.08,0:10:30.33,Default,,0,0,0,,Ол Super Zetsu стадионы ретінде қайта құрылды!
Dialogue: 0,0:10:31.17,0:10:35.30,Default,,0,0,0,,Екінші раундтан өткен әлемнің түкпір-түкпірінен келген сегіз пышақ...
Dialogue: 0,0:10:35.38,0:10:39.30,Default,,0,0,0,,Сәйкестеніңіз және қызу шайқас қайта басталады!
Dialogue: 0,0:10:39.55,0:10:41.43,Default,,0,0,0,,Император Дрифт!
Dialogue: 0,0:10:43.43,0:10:44.35,Default,,0,0,0,,Жарайды
Dialogue: 0,0:10:44.68,0:10:48.02,Default,,0,0,0,,Кенран тозақтан құлады!
Dialogue: 0,0:10:49.14,0:10:49.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:50.56,0:10:53.36,Default,,0,0,0,,Burst Burst Burst~!
Dialogue: 0,0:10:54.11,0:10:57.19,Default,,0,0,0,,Йонекома академиясының Фубуки Суми - Қытайдың Чен!
Dialogue: 0,0:10:57.94,0:10:59.11,Default,,0,0,0,,Гошуин Суо -
Dialogue: 0,0:10:59.20,0:11:01.86,Default,,0,0,0,,Сауд Арабиясынан келген Әлиді жеңіп, жеңіске жетті!
Dialogue: 0,0:11:02.28,0:11:05.37,Default,,0,0,0,,Өте қызып тұрған жер!
Dialogue: 0,0:11:05.49,0:11:06.37,Default,,0,0,0,,Және…
Dialogue: 0,0:11:06.66,0:11:10.08,Default,,0,0,0,,Келесі матч фавориттердің бірі
Dialogue: 0,0:11:10.16,0:11:12.54,Default,,0,0,0,,Оу Хоуи келді Келіңіздер!
Dialogue: 0,0:11:12.54,0:11:13.25,Default,,0,0,0,,Оу Хоуи келді Келіңіздер!
Dialogue: 0,0:11:12.54,0:11:13.25,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:11:13.25,0:11:13.50,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:11:13.50,0:11:15.75,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:11:13.50,0:11:15.75,Default,,0,0,0,,Қарсылас - Үндістандық Даура Гири!
Dialogue: 0,0:11:17.92,0:11:19.01,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:19.47,0:11:20.93,Default,,0,0,0,,О? ше?
Dialogue: 0,0:11:21.01,0:11:22.89,Default,,0,0,0,,Оу Хоуи біртүрлі әрекет етеді!
Dialogue: 0,0:11:23.22,0:11:24.85,Default,,0,0,0,,Ол қозғалмайды.
Dialogue: 0,0:11:25.10,0:11:27.64,Default,,0,0,0,,Хоуи! Мықты болыңыз!
Dialogue: 0,0:11:27.85,0:11:28.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:29.60,0:11:30.48,Default,,0,0,0,,Айга…
Dialogue: 0,0:11:30.81,0:11:32.98,Default,,0,0,0,,Бей назар аударылған!
Dialogue: 0,0:11:33.44,0:11:34.86,Default,,0,0,0,,Шоғырлану…
Dialogue: 0,0:11:37.11,0:11:38.65,Default,,0,0,0,,Маған не болды...
Dialogue: 0,0:11:41.15,0:11:43.20,Default,,0,0,0,,Айга сізге нені үйрете алады
Dialogue: 0,0:11:46.33,0:11:49.58,Default,,0,0,0,,Айға... Мен сенімен төбелесемін.
Dialogue: 0,0:11:51.21,0:11:52.29,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:11:54.88,0:11:56.29,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:11:58.30,0:11:59.96,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:12:00.34,0:12:03.34,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:12:03.76,0:12:06.10,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:12:06.18,0:12:07.10,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:12:11.52,0:12:13.48,Default,,0,0,0,,Уууу!
Dialogue: 0,0:12:15.44,0:12:16.90,Default,,0,0,0,,Гуга...
Dialogue: 0,0:12:17.31,0:12:21.19,Default,,0,0,0,,Садақшы Геркулес Керемет күш!
Dialogue: 0,0:12:21.28,0:12:23.32,Default,,0,0,0,,Секундта өлтіріңіз! Тезек
Dialogue: 0,0:12:23.53,0:12:25.20,Default,,0,0,0,,Бұл қай бет?
Dialogue: 0,0:12:25.28,0:12:26.95,Default,,0,0,0,,Мен шынымен бақыттымын.
Dialogue: 0,0:12:27.53,0:12:29.45,Default,,0,0,0,,Келесі кезекте Айға.
Dialogue: 0,0:12:29.79,0:12:30.87,Default,,0,0,0,,О
Dialogue: 0,0:12:34.62,0:12:36.25,Default,,0,0,0,,Қызыл бұрыш
Dialogue: 0,0:12:36.33,0:12:38.04,Default,,0,0,0,,Комета тәрізді пайда болуы
Dialogue: 0,0:12:38.13,0:12:42.05,Default,,0,0,0,,Бұл адам күтпеген жерден чемпиондыққа үміткер болды.
Dialogue: 0,0:12:42.13,0:12:44.88,Default,,0,0,0,,Қызыл жүз Айга! (қуаныш)
Dialogue: 0,0:12:45.34,0:12:46.76,Default,,0,0,0,,Көк бұрыш
Dialogue: 0,0:12:46.84,0:12:49.05,Default,,0,0,0,,Сондай-ақ жеңімпаз кандидаттардың бірі
Dialogue: 0,0:12:49.14,0:12:51.85,Default,,0,0,0,,Ранжиро Кияма осы жерде ұсынылады! (қуаныш)
Dialogue: 0,0:12:51.97,0:12:52.22,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:52.22,0:12:53.48,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:52.22,0:12:53.48,Default,,0,0,0,,Се-жоқ...
Dialogue: 0,0:12:53.48,0:12:53.60,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:53.60,0:12:55.52,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:53.60,0:12:55.52,Default,,0,0,0,,Сочо!
Dialogue: 0,0:12:56.06,0:12:58.90,Default,,0,0,0,,Зед Ахиллес пен Краш Рагнарук-
Dialogue: 0,0:12:58.98,0:13:03.53,Default,,0,0,0,,Бұл супер Zetsubei соқтығысатын өте назар аударатын шайқас!
Dialogue: 0,0:13:04.11,0:13:06.86,Default,,0,0,0,,Бұл шайқас қыза түседі.
Dialogue: 0,0:13:07.07,0:13:07.99,Default,,0,0,0,,Иә
Dialogue: 0,0:13:10.37,0:13:11.83,Default,,0,0,0,,Қызыл жүз Айга!
Dialogue: 0,0:13:12.12,0:13:15.04,Default,,0,0,0,,Темені жеңгеніме өте қуаныштымын.
Dialogue: 0,0:13:15.50,0:13:16.67,Default,,0,0,0,,Мен де!
Dialogue: 0,0:13:16.79,0:13:20.04,Default,,0,0,0,,Сенің жүзіңді үрлей алатыныма өте қуаныштымын!
Dialogue: 0,0:13:20.59,0:13:22.88,Default,,0,0,0,,Айга! Іске сәт!
Dialogue: 0,0:13:26.59,0:13:28.68,Default,,0,0,0,,Сіз жүргізушіні жоғарылаттыңыз ба?
Dialogue: 0,0:13:29.55,0:13:31.01,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:13:32.85,0:13:34.64,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:13:35.14,0:13:38.02,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:13:38.48,0:13:40.65,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:40.94,0:13:41.94,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:44.86,0:13:47.28,Default,,0,0,0,,Керемет кадр жасалды!
Dialogue: 0,0:13:47.61,0:13:50.32,Default,,0,0,0,,Оны үрлеп тастаңыз! Ахиллес!
Dialogue: 0,0:13:51.74,0:13:53.95,Default,,0,0,0,,Мен олардың шабуыл жасайтынын білемін!
Dialogue: 0,0:13:54.95,0:13:58.96,Default,,0,0,0,,Рагнарук Ахиллестен жалтарып, орталықты алды!
Dialogue: 0,0:13:59.21,0:14:01.13,Default,,0,0,0,,Желді металл қанаттарымен кесіңіз!
Dialogue: 0,0:14:01.79,0:14:05.17,Default,,0,0,0,,Рагнарук тайфуны!
Dialogue: 0,0:14:06.13,0:14:08.47,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:14:08.59,0:14:11.01,Default,,0,0,0,,Z Түсіріңіз!
Dialogue: 0,0:14:13.72,0:14:18.23,Default,,0,0,0,,Ахиллестің шабуылдары бірінен соң бірі шешіледі!
Dialogue: 0,0:14:18.35,0:14:21.86,Default,,0,0,0,,Сіз Рагнарук орталығын бересіз бе?
Dialogue: 0,0:14:22.44,0:14:24.07,Default,,0,0,0,,О... бұл ақылсыз
Dialogue: 0,0:14:24.19,0:14:25.53,Default,,0,0,0,,Тайфун...
Dialogue: 0,0:14:29.03,0:14:29.86,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:14:29.99,0:14:32.78,Default,,0,0,0,,Менің Crash Рагнарук осы жерден!
Dialogue: 0,0:14:37.12,0:14:39.92,Default,,0,0,0,,Дауылға қарсы құрал!
Dialogue: 0,0:14:42.25,0:14:43.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:45.17,0:14:47.84,Default,,0,0,0,,Crash Ragnaruk Overfinish
Dialogue: 0,0:14:48.26,0:14:50.47,Default,,0,0,0,,Ранжиро Кияма бір ұпай!
Dialogue: 0,0:14:50.55,0:14:52.97,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:14:53.26,0:14:55.47,Default,,0,0,0,,Қуанбаңыз! (5 адам) Ух...
Dialogue: 0,0:14:55.85,0:14:56.97,Default,,0,0,0,,Ран Бейруле
Dialogue: 0,0:14:57.06,0:14:58.85,Default,,0,0,0,,Жеңіске жетудің жалғыз жолы - жару
Dialogue: 0,0:14:59.56,0:15:01.35,Default,,0,0,0,,Дұрыс, Сочо!
Dialogue: 0,0:15:01.48,0:15:03.11,Default,,0,0,0,,Жарылыспен шешіңіз!
Dialogue: 0,0:15:03.19,0:15:04.98,Default,,0,0,0,,Burst Burst~
Dialogue: 0,0:15:05.32,0:15:08.94,Default,,0,0,0,,Фубуки-сенпай, не болды?
Dialogue: 0,0:15:09.07,0:15:11.86,Default,,0,0,0,,Рагнаруктың есептегіші шешілді.
Dialogue: 0,0:15:12.91,0:15:17.20,Default,,0,0,0,,Рагнаруктың жақтауында әртүрлі биіктіктегі екі жүзі бар.
Dialogue: 0,0:15:17.58,0:15:20.25,Default,,0,0,0,,Қарсылас қай биіктіктен шабуыл жасаса да...
Dialogue: 0,0:15:20.33,0:15:23.13,Default,,0,0,0,,Есептегішті олардың кез келгенімен шешуге болады.
Dialogue: 0,0:15:25.09,0:15:27.42,Default,,0,0,0,,Хуанзанның көздегені осы еді.
Dialogue: 0,0:15:28.01,0:15:30.38,Default,,0,0,0,,Жаңа ғана әдемі болды.
Dialogue: 0,0:15:30.51,0:15:33.68,Default,,0,0,0,,Оны мойындайық Ранжиро Кияма
Dialogue: 0,0:15:33.89,0:15:36.14,Default,,0,0,0,,Бұл осы жерден! Айга!
Dialogue: 0,0:15:36.26,0:15:37.43,Default,,0,0,0,,Айга...
Dialogue: 0,0:15:38.02,0:15:41.69,Default,,0,0,0,,Хмф, келесі жолы мен жарылып кетемін!
Dialogue: 0,0:15:43.60,0:15:45.90,Default,,0,0,0,,Аа... Сочо
Dialogue: 0,0:15:45.98,0:15:48.36,Default,,0,0,0,,Бұлай болмаса қызық болмас еді
Dialogue: 0,0:15:48.65,0:15:50.90,Default,,0,0,0,,Бұл керемет емес пе, Рагнарук!
Dialogue: 0,0:15:51.36,0:15:52.40,Default,,0,0,0,,Не?
Dialogue: 0,0:15:52.95,0:15:56.28,Default,,0,0,0,,Менің Z-Shotымды қайтаруға қалай дәтің бар!
Dialogue: 0,0:15:57.08,0:15:58.12,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,0:15:58.54,0:16:01.96,Default,,0,0,0,,А... Мен қатты күйіп қалдым.
Dialogue: 0,0:16:02.21,0:16:04.00,Default,,0,0,0,,Қарсы шабуыл басталды!
Dialogue: 0,0:16:06.21,0:16:08.34,Default,,0,0,0,,Сондықтан бұл Айға.
Dialogue: 0,0:16:08.46,0:16:09.34,Default,,0,0,0,,Иә
Dialogue: 0,0:16:09.96,0:16:11.59,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:16:12.72,0:16:14.51,Default,,0,0,0,,Әрі қарай не болады?
Dialogue: 0,0:16:15.22,0:16:17.05,Default,,0,0,0,,Мен бұрын жеңілдім.
Dialogue: 0,0:16:17.93,0:16:21.39,Default,,0,0,0,,Ондай жағдайда мен осы жолмен барамын.
Dialogue: 0,0:16:22.18,0:16:23.60,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:16:23.98,0:16:25.60,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:16:26.27,0:16:29.23,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:16:29.69,0:16:31.69,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:16:31.94,0:16:32.86,Default,,0,0,0,,Егер ағам мен әпкем әлі тірі болса…
Dialogue: 0,0:16:33.74,0:16:36.53,Default,,0,0,0,,Екі ойыншы да атуға шешім қабылдады!
Dialogue: 0,0:16:37.28,0:16:39.49,Default,,0,0,0,,Ахиллес жүргізушісі төмен
Dialogue: 0,0:16:39.95,0:16:41.62,Default,,0,0,0,,Келдің бе?
Dialogue: 0,0:16:42.20,0:16:44.42,Default,,0,0,0,,Келіңіздер! Екеуі айналады...
Dialogue: 0,0:16:44.50,0:16:47.42,Default,,0,0,0,,Біз бірте-бірте орталыққа жақындап келеміз!
Dialogue: 0,0:16:47.50,0:16:51.01,Default,,0,0,0,,Екі ойыншы да орталық үшін күресіп, қатты соқтығысуда!
Dialogue: 0,0:16:51.46,0:16:53.26,Default,,0,0,0,,Жақсы, Айга!
Dialogue: 0,0:16:53.34,0:16:54.93,Default,,0,0,0,,Ахиллеске қауіп төніп тұр
Dialogue: 0,0:16:55.01,0:16:55.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:56.47,0:16:58.93,Default,,0,0,0,,шығанақ дұрыс емес жерге түсірілді
Dialogue: 0,0:16:59.60,0:17:01.64,Default,,0,0,0,,Ахиллес, өзіңді қорға!
Dialogue: 0,0:17:01.97,0:17:04.27,Default,,0,0,0,,Рагнарук жүр!
Dialogue: 0,0:17:08.94,0:17:11.48,Default,,0,0,0,,Екеуі де бір уақытта аяқтайды
Dialogue: 0,0:17:11.73,0:17:12.61,Default,,0,0,0,,Ұтыс!
Dialogue: 0,0:17:12.69,0:17:13.65,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:14.28,0:17:16.49,Default,,0,0,0,,Уф... тең түсті ме?
Dialogue: 0,0:17:16.95,0:17:17.99,Default,,0,0,0,,Аа...
Dialogue: 0,0:17:18.70,0:17:20.24,Default,,0,0,0,,Кім жеңеді?
Dialogue: 0,0:17:20.33,0:17:21.83,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:17:22.45,0:17:25.62,Default,,0,0,0,,Хуаншан оқу стратегияларын жақсы меңгерген.
Dialogue: 0,0:17:25.96,0:17:27.88,Default,,0,0,0,,Менің жолым дәл қазір болды.
Dialogue: 0,0:17:28.58,0:17:32.67,Default,,0,0,0,,Бірақ оны идеалды күйге түсірмесеңіз, келесі жолы оны қорғай алмайсыз.
Dialogue: 0,0:17:32.76,0:17:33.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:34.42,0:17:37.38,Default,,0,0,0,,Айғаның концентрациясы таусылып барады.
Dialogue: 0,0:17:37.59,0:17:38.97,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:39.22,0:17:41.89,Default,,0,0,0,,Осылай жүре берсек, жеңілеміз.
Dialogue: 0,0:17:42.22,0:17:45.52,Default,,0,0,0,,Сочо! Жарылыспен шешіңіз!
Dialogue: 0,0:17:45.60,0:17:47.98,Default,,0,0,0,,Сочо! Сочо!
Dialogue: 0,0:17:48.06,0:17:52.07,Default,,0,0,0,,Сочо! Сочо! Сочо! Сочо!
Dialogue: 0,0:17:53.73,0:17:56.03,Default,,0,0,0,,Мықты бол, Сочо
Dialogue: 0,0:17:56.53,0:17:59.78,Default,,0,0,0,,Мен Айга Теманы танимын.
Dialogue: 0,0:17:59.95,0:18:01.16,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:18:01.66,0:18:04.41,Default,,0,0,0,,Мен үшінші шайқасқа шығамын!
Dialogue: 0,0:18:05.00,0:18:06.41,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:18:06.50,0:18:08.92,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:09.79,0:18:11.79,Default,,0,0,0,,Ол келесі жолы шабуылдауы керек.
Dialogue: 0,0:18:12.54,0:18:13.88,Default,,0,0,0,,Ахиллес…
Dialogue: 0,0:18:14.92,0:18:15.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:23.14,0:18:24.39,Default,,0,0,0,,Ахиллес…
Dialogue: 0,0:18:24.72,0:18:25.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:26.56,0:18:29.48,Default,,0,0,0,,Төбелесетін сенсің.
Dialogue: 0,0:18:29.90,0:18:30.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:31.19,0:18:32.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:39.03,0:18:42.07,Default,,0,0,0,,Хе... Жарайды.
Dialogue: 0,0:18:42.16,0:18:43.83,Default,,0,0,0,,Мен шешемін!
Dialogue: 0,0:18:44.16,0:18:46.79,Default,,0,0,0,,Айғаның шоғырлануы қайта оралды.
Dialogue: 0,0:18:46.91,0:18:47.83,Default,,0,0,0,,Айга!
Dialogue: 0,0:18:48.25,0:18:49.21,Default,,0,0,0,,Ол...
Dialogue: 0,0:18:49.58,0:18:50.58,Default,,0,0,0,,Хо…
Dialogue: 0,0:18:50.96,0:18:52.50,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:18:53.88,0:18:55.34,Default,,0,0,0,,Шоғырлану
Dialogue: 0,0:19:01.68,0:19:03.35,Default,,0,0,0,,Мақсат осында!
Dialogue: 0,0:19:03.64,0:19:05.47,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:19:05.93,0:19:09.10,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:19:09.27,0:19:11.73,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:19:12.02,0:19:12.90,Default,,0,0,0,,Уф, оқ-дәрі астында қалып қоюдың өзі бір әлем екен
Dialogue: 0,0:19:16.23,0:19:18.53,Default,,0,0,0,,Не? Орталыққа ұмтылу!
Dialogue: 0,0:19:18.99,0:19:20.03,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,0:19:23.37,0:19:27.16,Default,,0,0,0,,Орталықты бірден алған – З Ахиллес!
Dialogue: 0,0:19:27.83,0:19:30.41,Default,,0,0,0,,Рагнарук апаты бірінші болды!
Dialogue: 0,0:19:30.71,0:19:33.13,Default,,0,0,0,,Орталықты ұрлаңыз! Рагнарук!
Dialogue: 0,0:19:36.00,0:19:37.75,Default,,0,0,0,,Z Қорғаныс!
Dialogue: 0,0:19:44.30,0:19:47.51,Default,,0,0,0,,Ахиллестің күшті қорғанысы!
Dialogue: 0,0:19:47.60,0:19:49.60,Default,,0,0,0,,Қалқан тәрізді қабат
Dialogue: 0,0:19:49.68,0:19:52.69,Default,,0,0,0,,Бұл Рагнаруктың шабуылын залалсыздандырды!
Dialogue: 0,0:19:53.35,0:19:57.40,Default,,0,0,0,,Нақты соққылар мінсіз қорғаныс қалпын жасайды
Dialogue: 0,0:19:57.57,0:19:59.40,Default,,0,0,0,,Керемет! Айга~!
Dialogue: 0,0:19:59.74,0:20:03.07,Default,,0,0,0,,Керемет ұшыңыз! Рагнарук!
Dialogue: 0,0:20:06.03,0:20:07.66,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:20:08.49,0:20:12.58,Default,,0,0,0,,Рагнарук тайфуны!
Dialogue: 0,0:20:14.50,0:20:17.29,Default,,0,0,0,,Рагнаруктың жасырын күшін біл!
Dialogue: 0,0:20:23.80,0:20:27.18,Default,,0,0,0,,Уууу!
Dialogue: 0,0:20:28.18,0:20:29.97,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:20:32.94,0:20:35.27,Default,,0,0,0,,Ооо...
Dialogue: 0,0:20:35.77,0:20:37.86,Default,,0,0,0,,Уууу!
Dialogue: 0,0:20:43.82,0:20:48.24,Default,,0,0,0,,Z Buster!
Dialogue: 0,0:20:57.29,0:20:58.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:59.25,0:21:01.96,Default,,0,0,0,,Z Ахиллестің жарылуы аяқталуы
Dialogue: 0,0:21:02.05,0:21:04.88,Default,,0,0,0,,Red Blade Aiga 2-ден 1 ұпаймен жеңеді!
Dialogue: 0,0:21:04.97,0:21:07.59,Default,,0,0,0,,Burst Burst Burst~!
Dialogue: 0,0:21:04.97,0:21:07.59,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:07.97,0:21:09.10,Default,,0,0,0,,Crash Ragnaruk жарылды!
Dialogue: 0,0:21:07.97,0:21:09.10,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:21:09.10,0:21:10.35,Default,,0,0,0,,Crash Ragnaruk жарылды!
Dialogue: 0,0:21:10.43,0:21:14.56,Default,,0,0,0,,Тірі қалған – З Ахиллес~!
Dialogue: 0,0:21:10.43,0:21:14.56,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:14.56,0:21:16.27,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:16.44,0:21:18.11,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:21:18.40,0:21:20.69,Default,,0,0,0,,Иә! Мен жеңдім!
Dialogue: 0,0:21:20.82,0:21:23.24,Default,,0,0,0,,Ахаха, аз ғана жеңіс болды.
Dialogue: 0,0:21:29.87,0:21:31.24,Default,,0,0,0,,Сочо
Dialogue: 0,0:21:32.29,0:21:35.00,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:21:35.08,0:21:36.12,Default,,0,0,0,,Айға
Dialogue: 0,0:21:36.58,0:21:37.87,Default,,0,0,0,,Сочо
Dialogue: 0,0:21:40.96,0:21:43.76,Default,,0,0,0,,Енді мен сенімен көбірек шайқасқым келеді.
Dialogue: 0,0:21:45.13,0:21:46.01,Default,,0,0,0,,Heh...
Dialogue: 0,0:21:47.63,0:21:48.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:48.97,0:21:51.05,Default,,0,0,0,,Мен мұны кез келген уақытта жасаймын!
Dialogue: 0,0:21:54.39,0:22:00.40,Default,,0,0,0,,♪~
Dialogue: 0,0:23:16.22,0:23:22.23,Default,,0,0,0,,~♪
Dialogue: 0,0:23:25.07,0:23:27.69,Default,,0,0,0,,Лонгинус кубогының жартылай финалы
Dialogue: 0,0:23:27.94,0:23:30.32,Default,,0,0,0,,Фубуки мен Суудың қақтығысы!
Dialogue: 0,0:23:30.70,0:23:33.99,Default,,0,0,0,,Саламандр немесе Форнеус қайсысы күшті?
Dialogue: 0,0:23:34.70,0:23:38.62,Default,,0,0,0,,Әрине, менің Ахиллесім ең мықты екені сөзсіз!
Dialogue: 0,0:23:38.83,0:23:41.25,Default,,0,0,0,,Келесі жолы «Beyblade Burst Super Zetsu»
Dialogue: 0,0:23:41.37,0:23:42.75,Default,,0,0,0,,«Сатқындықтың кескілескен шайқасы!»
Dialogue: 0,0:23:43.21,0:23:45.34,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:45.46,0:23:47.46,Default,,0,0,0,,Бар, ат!
