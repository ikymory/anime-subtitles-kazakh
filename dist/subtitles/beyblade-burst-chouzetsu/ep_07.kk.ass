Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.54,0:00:04.08,Default,,0,0,0,,Бейблейд
Dialogue: 0,0:00:04.17,0:00:08.13,Default,,0,0,0,,Мықты болуды мақсат еткен ұлдардың арманының жемісі.
Dialogue: 0,0:00:08.96,0:00:12.17,Default,,0,0,0,,Енді супер Цетсу дәуірі басталады.
Dialogue: 0,0:00:12.55,0:00:16.59,Default,,0,0,0,,Металл сауытыңызды киіңіз де, Беймен шытырман оқиғаға аттаныңыз!
Dialogue: 0,0:00:16.93,0:00:19.01,Default,,0,0,0,,Әлем чемпионы болуды мақсат етіңіз!
Dialogue: 0,0:00:19.39,0:00:23.64,Default,,0,0,0,,Super Zetsu Super Zetsu Super Zetsu!
Dialogue: 0,0:00:24.27,0:00:27.90,Default,,0,0,0,,Ең күшті және жеңілмейтін атағын алатын адам сенсің!
Dialogue: 0,0:00:31.40,0:00:33.53,Default,,0,0,0,,Кел, Луи, шайқасайық!
Dialogue: 0,0:00:33.65,0:00:35.78,Default,,0,0,0,,Ұрысайық!
Dialogue: 0,0:00:39.91,0:00:40.91,Default,,0,0,0,,Иә
Dialogue: 0,0:00:41.54,0:00:43.41,Default,,0,0,0,,Император Форнейге...
Dialogue: 0,0:00:44.04,0:00:45.83,Default,,0,0,0,,Рагнарук апаты
Dialogue: 0,0:00:46.46,0:00:48.71,Default,,0,0,0,,Барлығы супер цецубей.
Dialogue: 0,0:00:49.25,0:00:50.67,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:00:50.92,0:00:53.76,Default,,0,0,0,,Мен де ақымақ болып, сендермен ойнаймын.
Dialogue: 0,0:00:53.88,0:00:56.22,Default,,0,0,0,,Мен, Сочо және Фубуки
Dialogue: 0,0:00:56.34,0:00:58.22,Default,,0,0,0,,Мен Луимен күресуді шештім.
Dialogue: 0,0:00:58.39,0:00:59.89,Default,,0,0,0,,Бұл корольдік ойын!
Dialogue: 0,0:01:00.14,0:01:03.43,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:01:03.98,0:01:06.52,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:01:06.73,0:01:07.77,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:01:09.44,0:01:11.61,Default,,0,0,0,,Жүр!
Dialogue: 0,0:01:13.15,0:01:14.90,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:01:16.57,0:01:17.41,Default,,0,0,0,,Фу…
Dialogue: 0,0:01:17.78,0:01:21.41,Default,,0,0,0,,Қан жаусын, Лонгинус!
Dialogue: 0,0:01:22.24,0:01:24.25,Default,,0,0,0,,Қанды қоңырау
Dialogue: 0,0:01:28.50,0:01:29.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:30.00,0:01:32.55,Default,,0,0,0,,Үшеуміз бірге бардық.
Dialogue: 0,0:01:33.17,0:01:35.42,Default,,0,0,0,,Біз Луиге тең келе алмадық.
Dialogue: 0,0:01:35.67,0:01:37.80,Default,,0,0,0,,Бүгінгі ойын аяқталды.
Dialogue: 0,0:01:37.93,0:01:40.60,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:01:40.72,0:01:43.64,Default,,0,0,0,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:01:44.31,0:01:50.31,Default,,0,0,0,,♪~
Dialogue: 0,0:03:07.14,0:03:13.15,Default,,0,0,0,,~♪
Dialogue: 0,0:03:14.11,0:03:16.98,Default,,0,0,0,,"Бастау! Лонгинус кубогы!!"
Dialogue: 0,0:03:19.69,0:03:21.20,Default,,0,0,0,,Әй, айтшы!
Dialogue: 0,0:03:21.45,0:03:23.45,Default,,0,0,0,,Бал-ни не істеді?
Dialogue: 0,0:03:23.70,0:03:26.33,Default,,0,0,0,,Лонгинус кубогы басталғанша
Dialogue: 0,0:03:26.45,0:03:27.83,Default,,0,0,0,,Сіз күшті бола аласыз.
Dialogue: 0,0:03:28.20,0:03:30.20,Default,,0,0,0,,Мен бұл сезімді түсінемін, бірақ...
Dialogue: 0,0:03:30.62,0:03:33.71,Default,,0,0,0,,Бальто шынымен де басынан-ақ күшті болды ма?
Dialogue: 0,0:03:33.96,0:03:34.79,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:03:34.92,0:03:37.21,Default,,0,0,0,,Бауырым, сен басында әлсіз едің.
Dialogue: 0,0:03:37.34,0:03:39.42,Default,,0,0,0,,Не, не, Балто?
Dialogue: 0,0:03:39.92,0:03:40.76,Default,,0,0,0,,Иә
Dialogue: 0,0:03:42.43,0:03:45.64,Default,,0,0,0,,Басында, аға, мен жай ғана Бей-
Dialogue: 0,0:03:45.72,0:03:47.68,Default,,0,0,0,,Мен мүлде жаттыққан жоқпын.
Dialogue: 0,0:03:48.22,0:03:50.14,Default,,0,0,0,,Кумичо мұны айтты ма?
Dialogue: 0,0:03:50.27,0:03:52.73,Default,,0,0,0,,«Бұл жай ойын, өзіңе ұнайтыныңды айтасың!»
Dialogue: 0,0:03:53.81,0:03:56.73,Default,,0,0,0,,Сондықтан мен шарасыздан арнайы дайындықты бастадым.
Dialogue: 0,0:03:59.53,0:04:01.03,Default,,0,0,0,,Арнайы дайындық...
Dialogue: 0,0:04:01.28,0:04:02.15,Default,,0,0,0,,Барлығы осы ма?
Dialogue: 0,0:04:02.90,0:04:07.45,Default,,0,0,0,,Ол достасуда данышпан болды...
Dialogue: 0,0:04:08.03,0:04:10.33,Default,,0,0,0,,Менің ағам Bay Club жасады
Dialogue: 0,0:04:10.95,0:04:13.96,Default,,0,0,0,,Осыдан кейін ол күшейе түсті.
Dialogue: 0,0:04:14.46,0:04:17.04,Default,,0,0,0,,Бауырым, қолыңнан келгеннің бәрін істедің.
Dialogue: 0,0:04:18.09,0:04:20.34,Default,,0,0,0,,Бұл қазір де өзгерген жоқ.
Dialogue: 0,0:04:20.67,0:04:22.01,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:04:22.13,0:04:25.26,Default,,0,0,0,,Бірақ Бал-ниге ең көп әсер еткені...
Dialogue: 0,0:04:25.39,0:04:26.76,Default,,0,0,0,,Бұл әрқашан Шу-кун болатын.
Dialogue: 0,0:04:26.89,0:04:27.72,Default,,0,0,0,,Шу?
Dialogue: 0,0:04:27.97,0:04:30.22,Default,,0,0,0,,Иә! Куришу-кун!
Dialogue: 0,0:04:31.06,0:04:34.39,Default,,0,0,0,,Ол Бал-нидің ең жақын досы және біз әрқашан қарсылас болдық.
Dialogue: 0,0:04:35.23,0:04:39.19,Default,,0,0,0,,Бар-нии Шуу-кунның арқасында күшейді деп ойлаймын.
Dialogue: 0,0:04:40.53,0:04:41.90,Default,,0,0,0,,Қарсылас?
Dialogue: 0,0:04:42.15,0:04:43.90,Default,,0,0,0,,Бұл өте керемет!
Dialogue: 0,0:04:44.03,0:04:46.03,Default,,0,0,0,,Мен сенен гөрі салқынмын.
Dialogue: 0,0:04:46.16,0:04:47.28,Default,,0,0,0,,Мүлдем емес
Dialogue: 0,0:04:47.41,0:04:48.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:48.78,0:04:51.29,Default,,0,0,0,,Айга салқынырақ
Dialogue: 0,0:04:51.49,0:04:53.20,Default,,0,0,0,,Мен, ол жігітпен танысыңыз.
Dialogue: 0,0:04:53.33,0:04:55.08,Default,,0,0,0,,Ол жігітті өзіңізбен бірге алыңыз!
Dialogue: 0,0:04:55.16,0:04:55.96,Default,,0,0,0,,Ол L-дің атын білген бойда мен тергеу штабын түгел жоямын.
Dialogue: 0,0:04:56.08,0:04:58.17,Default,,0,0,0,,Шу, сен Жапонияда емессің.
Dialogue: 0,0:04:58.67,0:05:00.25,Default,,0,0,0,,Не...
Dialogue: 0,0:05:01.30,0:05:02.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:03.17,0:05:05.43,Default,,0,0,0,,Жарайды, ең алдымен, арнайы дайындық!
Dialogue: 0,0:05:05.55,0:05:06.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:07.09,0:05:09.10,Default,,0,0,0,,Мен де арнайы жаттығу жасаймын!
Dialogue: 0,0:05:12.47,0:05:13.39,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:05:14.27,0:05:16.48,Default,,0,0,0,,Әке! Анашым!
Dialogue: 0,0:05:18.35,0:05:19.86,Default,,0,0,0,,Дәл қазір!
Dialogue: 0,0:05:20.36,0:05:22.23,Default,,0,0,0,,Кенеттен не болды?
Dialogue: 0,0:05:23.53,0:05:25.15,Default,,0,0,0,,Мен мұны жасағым келеді
Dialogue: 0,0:05:25.65,0:05:27.53,Default,,0,0,0,,Бұл не...?
Dialogue: 0,0:05:27.95,0:05:29.70,Default,,0,0,0,,Бұл арнайы жаттығу машинасы.
Dialogue: 0,0:05:29.82,0:05:32.29,Default,,0,0,0,,Ху~ Тайга түсінеді.
Dialogue: 0,0:05:33.66,0:05:36.00,Default,,0,0,0,,Әке, маған күш беріңізші.
Dialogue: 0,0:05:38.37,0:05:39.21,Default,,0,0,0,,Иә
Dialogue: 0,0:05:39.33,0:05:41.46,Default,,0,0,0,,Жарайсыңдар! Хехе
Dialogue: 0,0:05:42.84,0:05:46.76,Default,,0,0,0,,Бұл сымды шығаруға арналған тұтқа ма?
Dialogue: 0,0:05:47.51,0:05:48.34,Default,,0,0,0,,О
Dialogue: 0,0:05:48.47,0:05:51.10,Default,,0,0,0,,Луи бірден үшеуін суырып алды.
Dialogue: 0,0:05:51.76,0:05:54.39,Default,,0,0,0,,Уууу!
Dialogue: 0,0:05:56.52,0:05:57.64,Default,,0,0,0,,Сонымен менің...
Dialogue: 0,0:05:57.77,0:06:00.23,Default,,0,0,0,,Оны одан да керемет етіңіз!
Dialogue: 0,0:06:02.65,0:06:04.44,Default,,0,0,0,,Сіз жеңілдіңіз бе? Соған
Dialogue: 0,0:06:04.53,0:06:05.32,Default,,0,0,0,,А...
Dialogue: 0,0:06:05.65,0:06:08.11,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,0:06:09.49,0:06:10.24,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:10.49,0:06:11.66,Default,,0,0,0,,(Жерге тиген дыбыс)
Dialogue: 0,0:06:12.74,0:06:14.49,Default,,0,0,0,,Қазірше мұндадан кет.
Dialogue: 0,0:06:14.62,0:06:15.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:15.66,0:06:16.50,Default,,0,0,0,,Аа...
Dialogue: 0,0:06:17.12,0:06:18.16,Default,,0,0,0,,Келесі жолы жеңіңіз
Dialogue: 0,0:06:19.67,0:06:22.38,Default,,0,0,0,,Ах! Мен міндетті түрде жеңемін!
Dialogue: 0,0:06:23.17,0:06:27.92,Default,,0,0,0,,(металлға соғылған дыбыс)
Dialogue: 0,0:06:28.47,0:06:31.30,Default,,0,0,0,,Айга мен Папа жынды сияқты істеп жатыр.
Dialogue: 0,0:06:31.43,0:06:33.26,Default,,0,0,0,,Хехе, иә.
Dialogue: 0,0:06:34.68,0:06:37.02,Default,,0,0,0,,Айға мен көрген адамнан артық...
Dialogue: 0,0:06:37.27,0:06:39.85,Default,,0,0,0,,Super Zetsubei-мен күшті резонанс
Dialogue: 0,0:06:40.48,0:06:41.77,Default,,0,0,0,,Бұл жақсы нәрсе емес пе?
Dialogue: 0,0:06:42.48,0:06:44.23,Default,,0,0,0,,Резонанстық қуат тым күшті...
Dialogue: 0,0:06:44.36,0:06:47.15,Default,,0,0,0,,Кейбір қалақшалар шығанаққа алынады.
Dialogue: 0,0:06:47.94,0:06:50.11,Default,,0,0,0,,Мен адамдардың осыдан зардап шеккенін көрдім.
Dialogue: 0,0:06:51.28,0:06:53.41,Default,,0,0,0,,Сіз мұны айтқан болсаңыз да
Dialogue: 0,0:06:53.78,0:06:56.74,Default,,0,0,0,,Айға мен Бейді ойнағаныңызға қуаныштымын.
Dialogue: 0,0:07:06.25,0:07:07.34,Default,,0,0,0,,Айга, жарай ма?
Dialogue: 0,0:07:07.46,0:07:08.46,Default,,0,0,0,,Жарайды
Dialogue: 0,0:07:08.63,0:07:10.30,Default,,0,0,0,,Ал...
Dialogue: 0,0:07:13.39,0:07:14.39,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:14.60,0:07:16.06,Default,,0,0,0,,Ой
Dialogue: 0,0:07:16.22,0:07:18.43,Default,,0,0,0,,Ой... Уау!
Dialogue: 0,0:07:18.56,0:07:19.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:21.27,0:07:22.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:22.23,0:07:23.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:24.15,0:07:26.11,Default,,0,0,0,,Бухахаха!
Dialogue: 0,0:07:26.23,0:07:29.61,Default,,0,0,0,,(Тайга мен Айғаның күлкісі)
Dialogue: 0,0:07:31.24,0:07:32.61,Default,,0,0,0,,Пуха~!
Dialogue: 0,0:07:33.49,0:07:34.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:39.16,0:07:42.46,Default,,0,0,0,,Ахиллес Омеге уәде еткендей...
Dialogue: 0,0:07:43.04,0:07:47.50,Default,,0,0,0,,Мен сөзсіз супер Цецу, ең күшті және жеңілмейтін боламын!
Dialogue: 0,0:07:49.05,0:07:51.59,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:07:52.26,0:07:54.34,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:07:58.60,0:08:01.14,Default,,0,0,0,,Сіз не істеп жатырсыз? Неғұрлым байсалды болыңыз!
Dialogue: 0,0:08:01.85,0:08:02.69,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:02.85,0:08:04.02,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:08:04.65,0:08:05.81,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:08:08.77,0:08:09.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:10.86,0:08:12.20,Default,,0,0,0,,Әлі де жеткіліксіз
Dialogue: 0,0:08:15.24,0:08:16.28,Default,,0,0,0,,Уау
Dialogue: 0,0:08:16.99,0:08:18.62,Default,,0,0,0,,Толығырақ...
Dialogue: 0,0:08:19.54,0:08:20.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:20.70,0:08:21.79,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:08:22.16,0:08:23.33,Default,,0,0,0,,Уф
Dialogue: 0,0:08:28.13,0:08:29.13,Default,,0,0,0,,Керемет!
Dialogue: 0,0:08:29.25,0:08:31.55,Default,,0,0,0,,Коджи-кун капитанмен соғысып жатыр.
Dialogue: 0,0:08:31.63,0:08:34.30,Default,,0,0,0,,Коудзи Айга Акабадан жеңілген күннен бастап
Dialogue: 0,0:08:34.43,0:08:36.22,Default,,0,0,0,,Өйткені көздерінің түсі әртүрлі.
Dialogue: 0,0:08:37.22,0:08:39.97,Default,,0,0,0,,Император Дрейф!
Dialogue: 0,0:08:43.35,0:08:44.52,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:45.27,0:08:49.98,Default,,0,0,0,,Мен ол кісіні міндетті түрде қуып жетемін!
Dialogue: 0,0:08:50.61,0:08:54.24,Default,,0,0,0,,488 489... (Ранджиро) А... Уф!
Dialogue: 0,0:08:55.03,0:08:58.99,Default,,0,0,0,,490 491… (Рандзиро) Иә…
Dialogue: 0,0:08:59.62,0:09:01.29,Default,,0,0,0,,492…
Dialogue: 0,0:09:01.37,0:09:03.79,Default,,0,0,0,,Уф... (Харуми Хиджиката) Өзіңізді қатты итермеңіз.
Dialogue: 0,0:09:04.29,0:09:06.00,Default,,0,0,0,,494… (Ранджиро) Иә…
Dialogue: 0,0:09:06.12,0:09:08.50,Default,,0,0,0,,Сочо, жақсысың ба?
Dialogue: 0,0:09:09.29,0:09:13.26,Default,,0,0,0,,496 497... (Рандзиро) Ух... уф!
Dialogue: 0,0:09:14.59,0:09:18.01,Default,,0,0,0,,Қазір жаттыға берме, қашан жаттығасың!
Dialogue: 0,0:09:18.93,0:09:20.47,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:09:20.56,0:09:21.47,Default,,0,0,0,,Шу!
Dialogue: 0,0:09:21.60,0:09:22.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:22.56,0:09:24.73,Default,,0,0,0,,Әй, Сочо!
Dialogue: 0,0:09:24.85,0:09:25.69,Default,,0,0,0,,Хаа…
Dialogue: 0,0:09:26.27,0:09:27.23,Default,,0,0,0,,Не!
Dialogue: 0,0:09:27.81,0:09:30.69,Default,,0,0,0,,Мектепке біртүрлі нәрсе келе жатыр!
Dialogue: 0,0:09:31.19,0:09:32.19,Default,,0,0,0,,Біртүрлі ме?
Dialogue: 0,0:09:44.29,0:09:46.04,Default,,0,0,0,,Бұл не туралы?
Dialogue: 0,0:09:46.16,0:09:47.29,Default,,0,0,0,,Не! Гваааах!
Dialogue: 0,0:09:47.50,0:09:49.92,Default,,0,0,0,,Бұл құпия қару сияқты.
Dialogue: 0,0:09:50.04,0:09:51.67,Default,,0,0,0,,Құпия қару?
Dialogue: 0,0:09:52.17,0:09:54.34,Default,,0,0,0,,Әке, бәрі үшін рахмет!
Dialogue: 0,0:09:54.46,0:09:55.30,Default,,0,0,0,,О
Dialogue: 0,0:09:55.55,0:09:57.17,Default,,0,0,0,,Әке, кездескенше~
Dialogue: 0,0:09:57.30,0:09:58.30,Default,,0,0,0,,Мен... Мен ондай жігіттерді шын жек көремін!
Dialogue: 0,0:09:58.97,0:10:02.05,Default,,0,0,0,,Ол кісі Айға Ақабаның әкесі.
Dialogue: 0,0:10:02.22,0:10:04.43,Default,,0,0,0,,Super Zetsubei жасаған адам...
Dialogue: 0,0:10:10.44,0:10:11.81,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:16.57,0:10:17.40,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:18.20,0:10:19.45,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:10:19.78,0:10:22.87,Default,,0,0,0,,Уууу!
Dialogue: 0,0:10:26.41,0:10:28.58,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:10:34.05,0:10:35.17,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:10:35.80,0:10:37.30,Default,,0,0,0,,Мен таң қалдым~
Dialogue: 0,0:10:37.42,0:10:39.05,Default,,0,0,0,,Ол тағы!
Dialogue: 0,0:10:41.89,0:10:44.39,Default,,0,0,0,,Куу~ Бұл жұмыс істейді!
Dialogue: 0,0:10:44.56,0:10:46.77,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:10:46.97,0:10:48.06,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:48.93,0:10:50.39,Default,,0,0,0,,Ғрр! Б-бұл жігіт…
Dialogue: 0,0:10:51.19,0:10:52.73,Default,,0,0,0,,А? Сен не істеп жатырсың?
Dialogue: 0,0:10:52.98,0:10:56.07,Default,,0,0,0,,Мектепке осындай нәрсені әкелу дегенді қалай түсінесіңдер?
Dialogue: 0,0:10:56.19,0:10:58.82,Default,,0,0,0,,Оны көргенде білесің! Біз арнайы дайындықтан өттік!
Dialogue: 0,0:10:58.94,0:11:02.07,Default,,0,0,0,,Бұл қандай арнайы дайындық?
Dialogue: 0,0:11:02.20,0:11:03.57,Default,,0,0,0,,Қоқыс туралы не деуге болады?
Dialogue: 0,0:11:03.70,0:11:06.70,Default,,0,0,0,,Бұл әкем екеуміз жасаған арнайы жаттығу машинасы.
Dialogue: 0,0:11:06.83,0:11:08.83,Default,,0,0,0,,Оның аты - Super Zetsu Special!
Dialogue: 0,0:11:09.29,0:11:11.29,Default,,0,0,0,,Хмф, сіз кедергісіз!
Dialogue: 0,0:11:11.54,0:11:12.92,Default,,0,0,0,,Тоқта, Коудзи!
Dialogue: 0,0:11:13.25,0:11:14.17,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:14.67,0:11:15.54,Default,,0,0,0,,Не! Гваааах!
Dialogue: 0,0:11:16.80,0:11:17.80,Default,,0,0,0,,Маған орындауға рұқсат етіңіз
Dialogue: 0,0:11:18.09,0:11:18.92,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:11:19.05,0:11:20.59,Default,,0,0,0,,Эй, мені жібер!
Dialogue: 0,0:11:21.01,0:11:22.26,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:23.30,0:11:25.05,Default,,0,0,0,,Мұндай нәрселерде ешқандай мағына жоқ
Dialogue: 0,0:11:25.64,0:11:27.35,Default,,0,0,0,,Барлығымыз, жаттығуды жалғастырайық!
Dialogue: 0,0:11:27.85,0:11:28.77,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:29.68,0:11:30.60,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:33.31,0:11:34.69,Default,,0,0,0,,Аняру…
Dialogue: 0,0:11:35.02,0:11:36.44,Default,,0,0,0,,Бұл мағынасыз ба?
Dialogue: 0,0:11:36.57,0:11:39.32,Default,,0,0,0,,Мен сізге Longinus кубогымен өз стилімді көрсетемін!
Dialogue: 0,0:11:40.49,0:11:43.20,Default,,0,0,0,,Кеттік, Super Zetsu Special!
Dialogue: 0,0:11:43.32,0:11:46.74,Default,,0,0,0,,Уууу!
Dialogue: 0,0:11:48.08,0:11:50.75,Default,,0,0,0,,Жарайды! Ұлдар мен қыздар!
Dialogue: 0,0:11:51.00,0:11:54.75,Default,,0,0,0,,Лонгинус кубогының іріктеу кезеңдері басталды!
Dialogue: 0,0:11:55.00,0:12:00.42,Default,,0,0,0,,Бұл алдын ала жарыстар бүкіл Азияда бір уақытта өтеді!
Dialogue: 0,0:12:00.92,0:12:02.17,Default,,0,0,0,,Қытай
Dialogue: 0,0:12:02.55,0:12:03.68,Default,,0,0,0,,Оңтүстік Корея
Dialogue: 0,0:12:04.09,0:12:05.18,Default,,0,0,0,,Тайланд
Dialogue: 0,0:12:05.30,0:12:06.35,Default,,0,0,0,,Үндістан
Dialogue: 0,0:12:06.47,0:12:09.56,Default,,0,0,0,,Басқалар Көптеген пышақшылар қатысуда!
Dialogue: 0,0:12:09.72,0:12:13.94,Default,,0,0,0,,Бұл турнирде және Ширасаги сарайы Руимен шайқаста кім жеңе алады?
Dialogue: 0,0:12:14.15,0:12:16.48,Default,,0,0,0,,Сен кімсің?
Dialogue: 0,0:12:16.56,0:12:18.07,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:12:18.57,0:12:22.57,Default,,0,0,0,,Енді бірінші іріктеу туры - жіпті тарту күші.
Dialogue: 0,0:12:22.70,0:12:26.20,Default,,0,0,0,,Басқаша айтқанда, атыс күші жеңісті немесе жеңілісті анықтайды.
Dialogue: 0,0:12:26.91,0:12:29.41,Default,,0,0,0,,Жарайды, келіңдер!
Dialogue: 0,0:12:30.08,0:12:34.75,Default,,0,0,0,,
Dialogue: 0,0:12:38.50,0:12:39.55,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:40.25,0:12:41.38,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:41.76,0:12:43.63,Default,,0,0,0,,Бейбаттл емес пе?
Dialogue: 0,0:12:44.09,0:12:49.93,Default,,0,0,0,,Енді өлшеуіш машинаның үстіндегі электронды дисплей тақтасына назар аударыңыз!
Dialogue: 0,0:12:51.35,0:12:54.52,Default,,0,0,0,,Егер сіз бұл жіпті мүмкіндігінше қатты тартсаңыз...
Dialogue: 0,0:12:54.60,0:12:55.90,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:13:00.48,0:13:02.11,Default,,0,0,0,,Ха! А... А?
Dialogue: 0,0:13:02.61,0:13:06.74,Default,,0,0,0,,Сонымен... Сол қуатпен шамдар әртүрлі түстермен жанады!
Dialogue: 0,0:13:07.16,0:13:10.24,Default,,0,0,0,,Егер сіз көк сызықты кесіп өтсеңіз, сіз алдын ала тапсырмаларды орындадыңыз.
Dialogue: 0,0:13:10.58,0:13:14.54,Default,,0,0,0,,Кәне, бәріміз, өлшеуіш аппараттың алдында тұрыңдар!
Dialogue: 0,0:13:16.00,0:13:19.13,Default,,0,0,0,,Бастайық!
Dialogue: 0,0:13:19.25,0:13:20.63,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:13:24.09,0:13:25.76,Default,,0,0,0,,Уау... Уау!
Dialogue: 0,0:13:25.88,0:13:27.38,Default,,0,0,0,,Бірінші қарсылас
Dialogue: 0,0:13:27.51,0:13:30.64,Default,,0,0,0,,Сахнадан бірде-бір пышақ өткен жоқ!
Dialogue: 0,0:13:30.76,0:13:33.14,Default,,0,0,0,,Бұл өте қиын!
Dialogue: 0,0:13:34.18,0:13:36.89,Default,,0,0,0,,Ей, мен мұны тартып алуым керек деп ойлаймын.
Dialogue: 0,0:13:37.81,0:13:38.85,Default,,0,0,0,,Жарайды
Dialogue: 0,0:13:39.36,0:13:41.69,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:45.15,0:13:46.24,Default,,0,0,0,,Уау! (Барлығы) О...
Dialogue: 0,0:13:46.32,0:13:49.03,Default,,0,0,0,,Ақырында, алдын ала дайындықты тазартқан пышақ пайда болды!
Dialogue: 0,0:13:49.62,0:13:51.12,Default,,0,0,0,,Хмф!
Dialogue: 0,0:13:51.70,0:13:52.99,Default,,0,0,0,,Сочодан күткендей! (Бенимару) Керемет...
Dialogue: 0,0:13:53.12,0:13:55.87,Default,,0,0,0,,1-орын барлық орындарды қосқанда!
Dialogue: 0,0:13:56.33,0:13:58.37,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:13:58.75,0:14:00.29,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:14:04.17,0:14:06.80,Default,,0,0,0,,Йонекома Гакуэн Бэй Клубының Блэдерлері -
Dialogue: 0,0:14:06.88,0:14:08.93,Default,,0,0,0,,Алдын ала кезеңдерден бірінен соң бірі өтті!
Dialogue: 0,0:14:09.22,0:14:12.18,Default,,0,0,0,,Республикалық турнирде жеңімпаз атанған мектептен күткендей!
Dialogue: 0,0:14:12.47,0:14:13.72,Default,,0,0,0,,Басқа орындарда-
Dialogue: 0,0:14:13.85,0:14:16.77,Default,,0,0,0,,Алдын ала кезеңнен өткен блейдерлер бірінен соң бірі пайда болуда!
Dialogue: 0,0:14:16.89,0:14:19.40,Default,,0,0,0,,Бірақ жоғарыдан өту...
Dialogue: 0,0:14:19.48,0:14:23.19,Default,,0,0,0,,Оны Йонекома Гакуэннің Ранжиро Кияма сақтап қалды!
Dialogue: 0,0:14:23.57,0:14:24.57,Default,,0,0,0,,Жарайды
Dialogue: 0,0:14:24.69,0:14:27.07,Default,,0,0,0,,Мен биікте қалатыныма сенімдімін.
Dialogue: 0,0:14:27.19,0:14:28.40,Default,,0,0,0,,Күтілгендей!
Dialogue: 0,0:14:28.57,0:14:30.32,Default,,0,0,0,,Бұл ақылсыз, Сочо
Dialogue: 0,0:14:30.57,0:14:33.24,Default,,0,0,0,,Сәттілік Айға!
Dialogue: 0,0:14:33.95,0:14:34.87,Default,,0,0,0,,О!
Dialogue: 0,0:14:34.95,0:14:38.58,Default,,0,0,0,,Мен сізге Super Zetsu Special бағдарламасының арнайы жаттығу әсерін көрсетемін!
Dialogue: 0,0:14:40.12,0:14:42.46,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:14:47.42,0:14:49.22,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:14:49.38,0:14:51.39,Default,,0,0,0,,Айга керемет!
Dialogue: 0,0:14:51.47,0:14:52.51,Default,,0,0,0,,Не?
Dialogue: 0,0:14:52.64,0:14:53.47,Default,,0,0,0,,Панель...
Dialogue: 0,0:14:53.80,0:14:54.81,Default,,0,0,0,,Керемет!
Dialogue: 0,0:14:54.93,0:14:59.64,Default,,0,0,0,,Ең жоғары рекордқа қол жеткізген адам – Айга, ол өзінің алғашқы ресми көрінісін жасаған қызыл жүз!
Dialogue: 0,0:14:59.73,0:15:01.52,Default,,0,0,0,,Кенет ғажайып күш көрсетті
Dialogue: 0,0:15:01.69,0:15:04.27,Default,,0,0,0,,Бұл бүгінгі ең жақсы рекорд бола ма?
Dialogue: 0,0:15:05.90,0:15:09.99,Default,,0,0,0,,Қызыл жүз Айга... Мен сенен жоғары барамын.
Dialogue: 0,0:15:10.32,0:15:12.70,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:15:16.49,0:15:18.33,Default,,0,0,0,,Керемет!
Dialogue: 0,0:15:18.45,0:15:20.16,Default,,0,0,0,,Жоғарғы жағы қайтадан өзгерді!
Dialogue: 0,0:15:20.25,0:15:22.71,Default,,0,0,0,,Йонекома Гакуэннен келген Коудзи Конта көзге түседі.
Dialogue: 0,0:15:22.79,0:15:25.50,Default,,0,0,0,,Bay Club Пауэр Blader-тен күткендей!
Dialogue: 0,0:15:25.59,0:15:27.38,Default,,0,0,0,,Маған да біреуін оқып бер
Dialogue: 0,0:15:28.05,0:15:30.88,Default,,0,0,0,,Сіздің арнайы дайындықыңыздың мағынасы жоқ!
Dialogue: 0,0:15:31.13,0:15:32.26,Default,,0,0,0,,Не!
Dialogue: 0,0:15:32.89,0:15:35.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:35.43,0:15:36.81,Default,,0,0,0,,Ой?
Dialogue: 0,0:15:37.01,0:15:40.43,Default,,0,0,0,,Кореяда жүйе қатесі орын алған сияқты!
Dialogue: 0,0:15:40.56,0:15:42.65,Default,,0,0,0,,Нақты не болды?
Dialogue: 0,0:15:44.56,0:15:46.07,Default,,0,0,0,,Мынау кім...
Dialogue: 0,0:15:46.19,0:15:47.44,Default,,0,0,0,,Деке!
Dialogue: 0,0:15:47.98,0:15:49.78,Default,,0,0,0,,Бұл қуық...
Dialogue: 0,0:15:49.99,0:15:51.24,Default,,0,0,0,,О Хоуи!
Dialogue: 0,0:15:51.36,0:15:52.40,Default,,0,0,0,,Құжатқа сәйкес-
Dialogue: 0,0:15:52.53,0:15:56.45,Default,,0,0,0,,Ол керемет жүзуші ғана емес, сонымен қатар ол керемет садақшы!
Dialogue: 0,0:15:56.58,0:16:00.37,Default,,0,0,0,,Не болды? Бейнені ойнатайық!
Dialogue: 0,0:16:00.79,0:16:03.08,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:16:03.33,0:16:05.25,Default,,0,0,0,,Ах! О құдайым-ай!
Dialogue: 0,0:16:05.38,0:16:09.71,Default,,0,0,0,,Күштің күшті болғаны сонша, өлшеуіш машинаны сындырды!
Dialogue: 0,0:16:10.01,0:16:12.38,Default,,0,0,0,,Бұл қорқынышты ақымақтық.
Dialogue: 0,0:16:13.97,0:16:16.89,Default,,0,0,0,,Уф... Қайталап көрейік.
Dialogue: 0,0:16:18.01,0:16:20.89,Default,,0,0,0,,Оу Хоуи Қайталап көруге болады.
Dialogue: 0,0:16:21.02,0:16:21.98,Default,,0,0,0,,Не?
Dialogue: 0,0:16:22.23,0:16:24.48,Default,,0,0,0,,Йо... Іріктеу кезеңінен өттім.
Dialogue: 0,0:16:25.10,0:16:27.27,Default,,0,0,0,,(Қате дыбыс)
Dialogue: 0,0:16:29.57,0:16:30.65,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:16:31.07,0:16:33.78,Default,,0,0,0,,Бұл сөзсіз-
Dialogue: 0,0:16:34.66,0:16:36.66,Default,,0,0,0,,Алдын ала кезеңдердің үздіктері!
Dialogue: 0,0:16:37.49,0:16:39.28,Default,,0,0,0,,Оу Хоуи…
Dialogue: 0,0:16:39.79,0:16:41.54,Default,,0,0,0,,Бұл таңғажайып қуық
Dialogue: 0,0:16:41.79,0:16:44.92,Default,,0,0,0,,О... мен істеймін.
Dialogue: 0,0:16:46.63,0:16:48.96,Default,,0,0,0,,Айға, алдын ала кезеңнен өткеніңмен құттықтаймыз
Dialogue: 0,0:16:49.38,0:16:51.09,Default,,0,0,0,,Мен ерекше бақытты емеспін.
Dialogue: 0,0:16:51.42,0:16:52.67,Default,,0,0,0,,Сіз ашулысыз ба?
Dialogue: 0,0:16:53.17,0:16:54.05,Default,,0,0,0,,Ашуланба!
Dialogue: 0,0:16:54.17,0:16:55.63,Default,,0,0,0,,Бұл көңілсіз.
Dialogue: 0,0:16:55.76,0:16:58.43,Default,,0,0,0,,Мен Коудзи мен Хоуиден олардың ату күші үшін жеңілдім.
Dialogue: 0,0:16:58.76,0:17:00.76,Default,,0,0,0,,Уф, бұл көңілсіз...
Dialogue: 0,0:17:00.89,0:17:03.85,Default,,0,0,0,,Жарайды, тіліңді тісте!
Dialogue: 0,0:17:03.93,0:17:04.85,Default,,0,0,0,,Хехе
Dialogue: 0,0:17:05.14,0:17:06.44,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:17:06.56,0:17:10.07,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:17:10.90,0:17:13.99,Default,,0,0,0,,Bay Club-тан 6 адам қалды ма?
Dialogue: 0,0:17:14.49,0:17:16.49,Default,,0,0,0,,Тағы да қалды деп ойладым.
Dialogue: 0,0:17:16.61,0:17:18.20,Default,,0,0,0,,Коджи-кун, сен істедің.
Dialogue: 0,0:17:18.66,0:17:19.91,Default,,0,0,0,,Екінші орын.
Dialogue: 0,0:17:20.03,0:17:22.45,Default,,0,0,0,,Мен де жеңіске жетуді мақсат етіп отырмын.
Dialogue: 0,0:17:22.62,0:17:23.45,Default,,0,0,0,,Иә
Dialogue: 0,0:17:23.58,0:17:27.00,Default,,0,0,0,,Коудзи айтқандай, бұдан былай барлығы бәсекелес!
Dialogue: 0,0:17:27.21,0:17:28.00,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:34.09,0:17:36.01,Default,,0,0,0,,Неліктен мен ғана сәтсіздікке ұшырадым?
Dialogue: 0,0:17:36.13,0:17:37.22,Default,,0,0,0,,Қабілет
Dialogue: 0,0:17:37.68,0:17:38.18,Default,,0,0,0,,Чи…
Dialogue: 0,0:17:38.30,0:17:39.14,Default,,0,0,0,,Тынш!
Dialogue: 0,0:17:43.35,0:17:45.77,Default,,0,0,0,,Мен шыңды аламын!
Dialogue: 0,0:17:47.23,0:17:51.11,Default,,0,0,0,,Жарайды! Ұлдар мен қыздар!
Dialogue: 0,0:17:51.23,0:17:53.61,Default,,0,0,0,,Бірінші тур басталады!
Dialogue: 0,0:17:53.90,0:17:57.74,Default,,0,0,0,,Ал... Оған дейін, іріктеу кезеңінен өткен барлық жүзушілерге.
Dialogue: 0,0:17:57.86,0:18:01.08,Default,,0,0,0,,Ширасадиджо Луиден хабарлама!
Dialogue: 0,0:18:01.66,0:18:02.74,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:03.33,0:18:05.62,Default,,0,0,0,,Хабар? Ха...
Dialogue: 0,0:18:05.70,0:18:07.50,Default,,0,0,0,,А, сәл күте тұрыңыз...
Dialogue: 0,0:18:07.58,0:18:08.83,Default,,0,0,0,,Бір ғана сөз!
Dialogue: 0,0:18:09.58,0:18:12.34,Default,,0,0,0,,Мені тек мықты жігіттер қызықтырады.
Dialogue: 0,0:18:12.96,0:18:14.38,Default,,0,0,0,,Әлгі жігіт!
Dialogue: 0,0:18:15.01,0:18:16.88,Default,,0,0,0,,Ширасаги сарайы Луис…
Dialogue: 0,0:18:18.01,0:18:19.13,Default,,0,0,0,,Луис мырза...
Dialogue: 0,0:18:19.51,0:18:20.55,Default,,0,0,0,,Луи!
Dialogue: 0,0:18:21.35,0:18:22.97,Default,,0,0,0,,Әлсіздерді қалдырыңыз
Dialogue: 0,0:18:23.26,0:18:25.27,Default,,0,0,0,,Ал мені қуант!
Dialogue: 0,0:18:26.06,0:18:26.81,Default,,0,0,0,,Осымен
Dialogue: 0,0:18:31.02,0:18:32.44,Default,,0,0,0,,Бұл не өзі! Олар кішірейіп кеткен—
Dialogue: 0,0:18:32.94,0:18:37.03,Default,,0,0,0,,Ал... Енді Бейбаттлді бастайық!
Dialogue: 0,0:18:40.24,0:18:43.45,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:43.83,0:18:45.74,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:47.96,0:18:48.91,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:18:49.62,0:18:50.96,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:51.08,0:18:53.29,Default,,0,0,0,,Азиядағы орындардан…
Dialogue: 0,0:18:55.92,0:18:58.30,Default,,0,0,0,,Сіз жарылыстың дыбысын естисіз!
Dialogue: 0,0:19:00.63,0:19:03.55,Default,,0,0,0,,Қызықты болып барады! қызықты!
Dialogue: 0,0:19:03.80,0:19:07.06,Default,,0,0,0,,Олай болса, келіңіз, келесі жүзік!
Dialogue: 0,0:19:07.89,0:19:10.27,Default,,0,0,0,,Бұл бірінші ресми матч
Dialogue: 0,0:19:10.39,0:19:12.31,Default,,0,0,0,,Бұл қандай пышақ?
Dialogue: 0,0:19:13.11,0:19:14.57,Default,,0,0,0,,Қызыл пышақ Айга!
Dialogue: 0,0:19:14.69,0:19:15.52,Default,,0,0,0,,Жылама! Ақымақ, Косей! Енді мен де…
Dialogue: 0,0:19:15.90,0:19:17.36,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:19:18.07,0:19:19.07,Default,,0,0,0,,Сіздің қарсыласыңыз
Dialogue: 0,0:19:19.19,0:19:21.36,Default,,0,0,0,,Күшті Йонекома Гакуэн Бей клубы-
Dialogue: 0,0:19:21.45,0:19:23.16,Default,,0,0,0,,Ең қуатты Blader
Dialogue: 0,0:19:23.87,0:19:25.12,Default,,0,0,0,,Коджи Конта!
Dialogue: 0,0:19:25.24,0:19:26.33,Default,,0,0,0,,Жылама! Ақымақ, Косей! Енді мен де…
Dialogue: 0,0:19:26.70,0:19:29.41,Default,,0,0,0,,Ұлттық құрама жарысының жеңімпазы
Dialogue: 0,0:19:29.54,0:19:31.37,Default,,0,0,0,,Алдын ала ойындар Оу Хойдан кейін.
Dialogue: 0,0:19:31.50,0:19:33.96,Default,,0,0,0,,Біз екінші орынға шықтық!
Dialogue: 0,0:19:34.54,0:19:35.79,Default,,0,0,0,,Кожи-кун!
Dialogue: 0,0:19:35.92,0:19:37.05,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:19:37.75,0:19:39.09,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:19:42.30,0:19:46.01,Default,,0,0,0,,Мен сізге мұндай арнайы дайындықтың мағынасыз екенін көрсетемін!
Dialogue: 0,0:19:51.56,0:19:54.15,Default,,0,0,0,,Мен міндетті түрде жеңемін!
Dialogue: 0,0:19:54.44,0:19:56.32,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:19:57.02,0:19:59.94,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:20:00.82,0:20:02.91,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:20:03.32,0:20:04.16,Default,,0,0,0,,(Изуку) Ах! (Гран Торино) Уа!
Dialogue: 0,0:20:04.57,0:20:05.91,Default,,0,0,0,,Бұл шайқас
Dialogue: 0,0:20:06.03,0:20:09.29,Default,,0,0,0,,Күштердің қақтығысы болатын сияқты!
Dialogue: 0,0:20:10.37,0:20:11.71,Default,,0,0,0,,Тағы бір рет!
Dialogue: 0,0:20:12.00,0:20:13.67,Default,,0,0,0,,Келесі жолы мен оны жарып жіберемін!
Dialogue: 0,0:20:14.67,0:20:17.42,Default,,0,0,0,,Қуат жұп па?
Dialogue: 0,0:20:18.00,0:20:20.88,Default,,0,0,0,,Онда осы жерде бөлісейік.
Dialogue: 0,0:20:21.92,0:20:24.55,Default,,0,0,0,,Z Buster!
Dialogue: 0,0:20:30.14,0:20:31.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:32.52,0:20:35.60,Default,,0,0,0,,Z Ахиллестің жарылуы аяқталды!
Dialogue: 0,0:20:35.85,0:20:38.77,Default,,0,0,0,,Red Blade Aiga 2-0 ұпаймен жеңеді!
Dialogue: 0,0:20:38.98,0:20:41.74,Default,,0,0,0,,Ал, мен жеңдім!
Dialogue: 0,0:20:42.36,0:20:43.95,Default,,0,0,0,,Шешілді!
Dialogue: 0,0:20:44.07,0:20:45.91,Default,,0,0,0,,Коджи Конта Пауэр Blader-
Dialogue: 0,0:20:46.03,0:20:47.37,Default,,0,0,0,,Күшпен жеңді!
Dialogue: 0,0:20:47.57,0:20:48.66,Default,,0,0,0,,Қызыл жүзді Айга
Dialogue: 0,0:20:48.78,0:20:51.37,Default,,0,0,0,,Керемет қуық пайда болды!
Dialogue: 0,0:20:51.62,0:20:53.16,Default,,0,0,0,,Мектеп оқушысы үшін ол өзімен бірге таңғаларлықтай 50 000 йен алып жүр
Dialogue: 0,0:20:53.58,0:20:55.12,Default,,0,0,0,,Да~хахаха!
Dialogue: 0,0:20:55.58,0:20:58.09,Default,,0,0,0,,Осындай жігітке... Уф!
Dialogue: 0,0:20:58.50,0:21:01.59,Default,,0,0,0,,Қызу шайқас жалғасып жатқан Лонгинус кубогынан
Dialogue: 0,0:21:01.92,0:21:04.17,Default,,0,0,0,,Мен сенен көзімді ала алмаймын!
Dialogue: 0,0:21:04.30,0:21:08.14,Default,,0,0,0,,Кім жеңіске жетеді?
Dialogue: 0,0:21:14.14,0:21:15.52,Default,,0,0,0,,Әлсіздер кетсін
Dialogue: 0,0:21:16.02,0:21:18.23,Default,,0,0,0,,Ал мені қуант!
Dialogue: 0,0:21:19.31,0:21:21.32,Default,,0,0,0,,Көңіл көтеруге болмайды
Dialogue: 0,0:21:22.53,0:21:26.74,Default,,0,0,0,,499 500... (Ранджиро) Арх! Хмм...
Dialogue: 0,0:21:28.28,0:21:30.28,Default,,0,0,0,,501... (Ранджиро) Уф...
Dialogue: 0,0:21:32.24,0:21:36.16,Default,,0,0,0,,Луидің Яроуы Сіз енді тек күле аласыз!
Dialogue: 0,0:21:39.71,0:21:42.21,Default,,0,0,0,,Уууу!
Dialogue: 0,0:21:43.63,0:21:46.80,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:21:46.93,0:21:48.76,Default,,0,0,0,,Күте тұрыңыз, Луис.
Dialogue: 0,0:21:48.89,0:21:50.51,Default,,0,0,0,,Омені жеңу үшін...
Dialogue: 0,0:21:50.64,0:21:52.01,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:21:54.64,0:22:00.65,Default,,0,0,0,,♪~
Dialogue: 0,0:23:17.89,0:23:23.90,Default,,0,0,0,,~♪
Dialogue: 0,0:23:25.19,0:23:27.90,Default,,0,0,0,,Гошуин Суо супер Зецубей алды ма?
Dialogue: 0,0:23:28.19,0:23:30.49,Default,,0,0,0,,Тозақтың жалын айдаһары? Бұл не?
Dialogue: 0,0:23:30.86,0:23:32.82,Default,,0,0,0,,Және Ранбей тобына шабуыл жасайды.
Dialogue: 0,0:23:33.41,0:23:36.16,Default,,0,0,0,,Мен білетін Суох басқа адам.
Dialogue: 0,0:23:36.24,0:23:38.87,Default,,0,0,0,,Не! Бей де өзгерді
Dialogue: 0,0:23:39.58,0:23:41.96,Default,,0,0,0,,Келесі жолы «Beyblade Burst Super Zetsu»
Dialogue: 0,0:23:42.21,0:23:43.92,Default,,0,0,0,,"Трансформация! Тозақ Саламандар!!"
Dialogue: 0,0:23:44.00,0:23:45.92,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:46.04,0:23:48.05,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:49.55,0:23:55.55,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
