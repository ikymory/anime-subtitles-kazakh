Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.62,0:00:04.04,Default,,0,0,0,,Бейблейд
Dialogue: 0,0:00:04.17,0:00:08.09,Default,,0,0,0,,Мықты болуды мақсат еткен ұлдардың арманының жемісі.
Dialogue: 0,0:00:08.75,0:00:12.51,Default,,0,0,0,,Ал қазір супер Цетсу дәуірі қызып келеді.
Dialogue: 0,0:00:12.76,0:00:17.05,Default,,0,0,0,,Металл сауыт киіп, Беймен шытырман оқиғаға барыңыз!
Dialogue: 0,0:00:17.26,0:00:19.51,Default,,0,0,0,,Әлем чемпионы болуды мақсат етіңіз!
Dialogue: 0,0:00:19.64,0:00:23.64,Default,,0,0,0,,Super Zetsu Super Zetsu Super Zetsu!
Dialogue: 0,0:00:24.73,0:00:28.57,Default,,0,0,0,,Ең күшті және жеңілмейтін атағын алатын адам сенсің!
Dialogue: 0,0:00:32.40,0:00:34.65,Default,,0,0,0,,Менің алдымда ұрысқа дайындалып жатырмын
Dialogue: 0,0:00:34.78,0:00:37.41,Default,,0,0,0,,Спригганды жөндегеннен кейін Шу пайда болады.
Dialogue: 0,0:00:37.78,0:00:40.04,Default,,0,0,0,,Балалар сендермен және мына жігітпен
Dialogue: 0,0:00:40.16,0:00:42.91,Default,,0,0,0,,Айгаға Фи күшін сезінсін
Dialogue: 0,0:00:43.46,0:00:46.67,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:00:46.92,0:00:49.21,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:00:49.59,0:00:50.42,Default,,0,0,0,,(4 адам айғайлайды)
Dialogue: 0,0:00:53.42,0:00:54.26,Default,,0,0,0,,Сочо
Dialogue: 0,0:00:55.55,0:00:56.59,Default,,0,0,0,,Фубуки
Dialogue: 0,0:00:57.14,0:00:58.14,Default,,0,0,0,,Суо
Dialogue: 0,0:00:58.60,0:01:01.81,Default,,0,0,0,,Менің арнайы тренингіме барлық достарым қатысты.
Dialogue: 0,0:01:01.93,0:01:02.77,Default,,0,0,0,,Және…
Dialogue: 0,0:01:02.93,0:01:06.56,Default,,0,0,0,,Super Z қылыш!
Dialogue: 0,0:01:10.98,0:01:13.61,Default,,0,0,0,,Грррр!
Dialogue: 0,0:01:13.78,0:01:15.61,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:01:17.53,0:01:18.36,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:22.66,0:01:23.83,Default,,0,0,0,,Ти!
Dialogue: 0,0:01:35.01,0:01:37.38,Default,,0,0,0,,Айга жеңді...
Dialogue: 0,0:01:37.55,0:01:40.01,Default,,0,0,0,,Ақырында... Мен мұны істедім!
Dialogue: 0,0:01:40.89,0:01:42.39,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:42.76,0:01:44.39,Default,,0,0,0,,(қуаныш дыбыстары)
Dialogue: 0,0:01:46.14,0:01:49.98,Default,,0,0,0,,Жарайды, мен Файмен күресе аламын!
Dialogue: 0,0:01:51.44,0:01:57.45,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:03:14.69,0:03:20.70,Default,,0,0,0,,~♪
Dialogue: 0,0:03:29.54,0:03:33.12,Default,,0,0,0,,Мен Omeh Super Z-Wing-ге ұмтылатынын білемін.
Dialogue: 0,0:03:33.50,0:03:35.29,Default,,0,0,0,,Мен оны міндетті түрде қайтарамын!
Dialogue: 0,0:03:40.97,0:03:43.72,Default,,0,0,0,,Құдайдың еркіне қарсы тұруға болмайды
Dialogue: 0,0:03:46.43,0:03:47.64,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:50.48,0:03:54.90,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:57.23,0:03:59.32,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:00.65,0:04:01.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:02.07,0:04:02.99,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:03.15,0:04:04.86,Default,,0,0,0,,Айға ақыры оянды
Dialogue: 0,0:04:04.99,0:04:06.91,Default,,0,0,0,,Мен... мұнда неге келдің?
Dialogue: 0,0:04:07.41,0:04:10.66,Default,,0,0,0,,Нарудың фаршынан жасалған котлет бутерброды Қарын тоқ болған соң
Dialogue: 0,0:04:10.79,0:04:12.29,Default,,0,0,0,,Мен жаңа ғана ұйықтап қалдым.
Dialogue: 0,0:04:12.41,0:04:13.29,Default,,0,0,0,,Сен кімсің? Және неге Буггаратиды білесің?
Dialogue: 0,0:04:18.50,0:04:22.01,Default,,0,0,0,,Ах~ Уми! жеді жеді
Dialogue: 0,0:04:22.42,0:04:23.76,Default,,0,0,0,,Тамақтанып болған соң, ұйықта!
Dialogue: 0,0:04:23.88,0:04:25.30,Default,,0,0,0,,Ах (Хинацу)... енді?
Dialogue: 0,0:04:25.55,0:04:30.06,Default,,0,0,0,,
Dialogue: 0,0:04:30.68,0:04:32.64,Default,,0,0,0,,Түсіндім, хехе
Dialogue: 0,0:04:32.77,0:04:34.35,Default,,0,0,0,,Йотто... ах
Dialogue: 0,0:04:34.89,0:04:41.23,Default,,0,0,0,,
Dialogue: 0,0:04:41.48,0:04:43.36,Default,,0,0,0,,Барлығы да шаршады.
Dialogue: 0,0:04:43.49,0:04:45.66,Default,,0,0,0,,Мен соншалықты ерекше дайындықтан өттім.
Dialogue: 0,0:04:46.11,0:04:48.74,Default,,0,0,0,,Жарайды, жарайды, Айга!
Dialogue: 0,0:04:48.99,0:04:50.62,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:04:50.87,0:04:52.37,Default,,0,0,0,,Әлі де...
Dialogue: 0,0:04:52.75,0:04:54.62,Default,,0,0,0,,Артық емес...
Dialogue: 0,0:04:55.75,0:04:58.29,Default,,0,0,0,,Барлығыңызға рахмет
Dialogue: 0,0:05:03.63,0:05:05.26,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:06.09,0:05:07.30,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:10.14,0:05:11.26,Default,,0,0,0,,(Ақ) Адамнан тыс қабілеттері бар данышпан қыз
Dialogue: 0,0:05:13.81,0:05:15.77,Default,,0,0,0,,Неліктен мұндай арман?
Dialogue: 0,0:05:16.02,0:05:17.35,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:05:18.02,0:05:20.52,Default,,0,0,0,,Айға Жарайды, солай ма?
Dialogue: 0,0:05:21.27,0:05:23.86,Default,,0,0,0,,Біз қолдан келгеннің бәрін жасадық.
Dialogue: 0,0:05:24.15,0:05:25.03,Default,,0,0,0,,Иә
Dialogue: 0,0:05:25.28,0:05:28.16,Default,,0,0,0,,Оның орындауы ғана қалды.
Dialogue: 0,0:05:28.91,0:05:30.16,Default,,0,0,0,,Айга…
Dialogue: 0,0:05:31.45,0:05:32.41,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:32.74,0:05:33.79,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:34.45,0:05:37.29,Default,,0,0,0,,Не істеймін… не істеймін!
Dialogue: 0,0:05:37.75,0:05:40.79,Default,,0,0,0,,Мен Пхиді міндетті түрде жеңемін!
Dialogue: 0,0:05:41.09,0:05:43.30,Default,,0,0,0,,Жанып тұр Айга Уау!
Dialogue: 0,0:05:43.59,0:05:45.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:45.92,0:05:49.26,Default,,0,0,0,,Мен міндетті түрде жеңемін! Айга, төмен түс!
Dialogue: 0,0:05:49.39,0:05:50.22,Default,,0,0,0,,Әй?
Dialogue: 0,0:05:50.51,0:05:52.10,Default,,0,0,0,,Асығыңыз, асығыңыз!
Dialogue: 0,0:05:52.35,0:05:54.10,Default,,0,0,0,,Не?
Dialogue: 0,0:05:54.43,0:05:56.31,Default,,0,0,0,,Йошитто...
Dialogue: 0,0:05:56.56,0:05:57.69,Default,,0,0,0,,Жинақ?
Dialogue: 0,0:05:57.94,0:06:00.94,Default,,0,0,0,,Айга: Ертең мен Файмен жұмыс істеймін.
Dialogue: 0,0:06:01.19,0:06:02.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:02.15,0:06:04.69,Default,,0,0,0,,Үлкен аға Үлкен аға, қосылдық (2 адам) Иә?
Dialogue: 0,0:06:04.82,0:06:06.19,Default,,0,0,0,,Айга ұсталды!
Dialogue: 0,0:06:06.32,0:06:08.61,Default,,0,0,0,,Сәлем! Мен Шудан сұрадым
Dialogue: 0,0:06:09.07,0:06:13.08,Default,,0,0,0,,Super Z-ояту әрекеті тоқтатылғаннан кейін де қайта оралған сияқтысыз.
Dialogue: 0,0:06:13.20,0:06:14.04,Default,,0,0,0,,О!
Dialogue: 0,0:06:14.16,0:06:16.12,Default,,0,0,0,,Super Zetsu Бұл керемет болды.
Dialogue: 0,0:06:16.37,0:06:18.25,Default,,0,0,0,,Менің де көргім келді!
Dialogue: 0,0:06:18.37,0:06:19.33,Default,,0,0,0,,Мен де!
Dialogue: 0,0:06:19.58,0:06:22.34,Default,,0,0,0,,Мен сөйлесіп тұрғанда сөзімді бөлме!
Dialogue: 0,0:06:22.46,0:06:24.09,Default,,0,0,0,,Себебі мен де сенімен сөйлескім келеді.
Dialogue: 0,0:06:24.25,0:06:26.71,Default,,0,0,0,,Сәл күте тұрыңыз...
Dialogue: 0,0:06:26.84,0:06:28.84,Default,,0,0,0,,Оны байланыстырған менмін. Мен біріншімін!
Dialogue: 0,0:06:28.97,0:06:30.84,Default,,0,0,0,,Не? Бұл екі адам
Dialogue: 0,0:06:30.97,0:06:33.60,Default,,0,0,0,,Сенің маған қатысың бар шығар!
Dialogue: 0,0:06:33.85,0:06:34.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:34.81,0:06:36.97,Default,,0,0,0,,Бар болса, тез айтыңызшы.
Dialogue: 0,0:06:37.10,0:06:38.35,Default,,0,0,0,,Шынымен жоқ Иә.
Dialogue: 0,0:06:38.68,0:06:40.77,Default,,0,0,0,,Иә? Не? Жоқ?
Dialogue: 0,0:06:40.98,0:06:43.02,Default,,0,0,0,,Мен сенің дауысыңды естігім келді.
Dialogue: 0,0:06:43.23,0:06:44.73,Default,,0,0,0,,Бәрі осы ма?
Dialogue: 0,0:06:44.98,0:06:49.40,Default,,0,0,0,,Аа, дұрыс, ертеңгі матчта сен сияқты күрес.
Dialogue: 0,0:06:49.65,0:06:52.91,Default,,0,0,0,,Ахиллеспен шайқастан ләззат алыңыз.
Dialogue: 0,0:06:53.03,0:06:53.95,Default,,0,0,0,,Мен өлсем бола ма?
Dialogue: 0,0:06:54.08,0:06:55.08,Default,,0,0,0,,Сонда кездескенше! иә?
Dialogue: 0,0:06:55.83,0:06:58.75,Default,,0,0,0,,Ах! Мен әлі сөйлескім келді!
Dialogue: 0,0:06:58.87,0:07:01.17,Default,,0,0,0,,Кешіріңіз, мен оны үздім.
Dialogue: 0,0:07:01.29,0:07:03.84,Default,,0,0,0,,Хехехе... Үлкен аға!
Dialogue: 0,0:07:04.96,0:07:06.88,Default,,0,0,0,,Дәл қазір не болды?
Dialogue: 0,0:07:07.00,0:07:07.84,Default,,0,0,0,,Иә...
Dialogue: 0,0:07:18.18,0:07:21.06,Default,,0,0,0,,Сіз маған бірдеңе айтар едіңіз емес пе?
Dialogue: 0,0:07:21.39,0:07:23.23,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:07:23.94,0:07:26.07,Default,,0,0,0,,Мен жай ғана Айга мен Нарудың жүзін көргім келді.
Dialogue: 0,0:07:26.44,0:07:30.28,Default,,0,0,0,,Қайтып келуімді өтінгенде, бірдеңе дұрыс емес деп ойладым.
Dialogue: 0,0:07:30.49,0:07:32.86,Default,,0,0,0,,Бірақ ол арнайы жаттығуларға да қатысты.
Dialogue: 0,0:07:32.99,0:07:34.95,Default,,0,0,0,,Маған қолдау көрсету хабарламасын жіберіңіз
Dialogue: 0,0:07:35.24,0:07:38.49,Default,,0,0,0,,Шу да, Балто да өте жақсы ағалар.
Dialogue: 0,0:07:39.45,0:07:42.83,Default,,0,0,0,,Барлығы сені уайымдайды, солай емес пе?
Dialogue: 0,0:07:43.08,0:07:45.42,Default,,0,0,0,,Барлығы тым көп уайымдайды.
Dialogue: 0,0:07:45.54,0:07:48.63,Default,,0,0,0,,Дұрыс, қазір Айғаның жағдайы жақсы.
Dialogue: 0,0:07:48.75,0:07:50.97,Default,,0,0,0,,О, түсіндің, солай ма?
Dialogue: 0,0:07:51.09,0:07:53.47,Default,,0,0,0,,Super Zetsu ең күшті және жеңілмейтін!
Dialogue: 0,0:07:53.59,0:07:54.97,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:55.09,0:07:56.35,Default,,0,0,0,,Жол!
Dialogue: 0,0:07:56.72,0:07:58.51,Default,,0,0,0,,Үйден қашуды жоспарлап отырсыз ба?
Dialogue: 0,0:07:58.97,0:08:00.89,Default,,0,0,0,,Мен баруды шештім.
Dialogue: 0,0:08:01.39,0:08:02.48,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:02.89,0:08:04.52,Default,,0,0,0,,Оны тоқтатудың қажеті жоқ!
Dialogue: 0,0:08:05.23,0:08:06.36,Default,,0,0,0,,Вагон тежегішті басады!
Dialogue: 0,0:08:06.56,0:08:08.07,Default,,0,0,0,,Мен шешіп қойдым!
Dialogue: 0,0:08:08.57,0:08:10.11,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,0:08:11.86,0:08:14.03,Default,,0,0,0,,Не? Жаңа ғана не ұстадыңыз?
Dialogue: 0,0:08:14.41,0:08:16.53,Default,,0,0,0,,Айга жүр
Dialogue: 0,0:08:17.66,0:08:20.41,Default,,0,0,0,,Мен жақсы адамдарды кездестіргеніме қуаныштымын.
Dialogue: 0,0:08:20.66,0:08:21.75,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:22.29,0:08:23.96,Default,,0,0,0,,Осы жігітке рахмет
Dialogue: 0,0:08:24.29,0:08:26.79,Default,,0,0,0,,Ахиллес маған бәрімен кездесуге рұқсат етіңіз!
Dialogue: 0,0:08:27.54,0:08:28.67,Default,,0,0,0,,Айга!
Dialogue: 0,0:08:28.84,0:08:30.13,Default,,0,0,0,,Не? әке
Dialogue: 0,0:08:30.80,0:08:33.05,Default,,0,0,0,,Енді әкеммен бірге жасаймыз ба?
Dialogue: 0,0:08:33.30,0:08:34.30,Default,,0,0,0,,Не!
Dialogue: 0,0:08:35.97,0:08:38.14,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:08:38.55,0:08:40.81,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:08:47.94,0:08:49.65,Default,,0,0,0,,О... Жарайды!
Dialogue: 0,0:08:49.94,0:08:51.44,Default,,0,0,0,,Гррр…
Dialogue: 0,0:08:51.78,0:08:53.61,Default,,0,0,0,,Тағы да, Айға!
Dialogue: 0,0:08:56.49,0:08:58.87,Default,,0,0,0,,Неліктен мен жеңе алмаймын?
Dialogue: 0,0:09:01.70,0:09:03.50,Default,,0,0,0,,Гррр…
Dialogue: 0,0:09:03.75,0:09:05.25,Default,,0,0,0,,Тағы бір рет!
Dialogue: 0,0:09:05.37,0:09:06.21,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:09:06.33,0:09:09.00,Default,,0,0,0,,Уф... тағы бір рет!
Dialogue: 0,0:09:09.25,0:09:12.38,Default,,0,0,0,,Бұл Айгаға жаттығу үшін пайдасыз.
Dialogue: 0,0:09:12.63,0:09:15.38,Default,,0,0,0,,Әкем де күшті болған.
Dialogue: 0,0:09:15.68,0:09:16.51,Default,,0,0,0,,(шұңқырлар соқтығысқан дыбыс)
Dialogue: 0,0:09:16.63,0:09:17.89,Default,,0,0,0,,Вууууу!
Dialogue: 0,0:09:18.01,0:09:21.64,Default,,0,0,0,,Тағы бір рет... Тағы бір рет, өтінемін.
Dialogue: 0,0:09:23.85,0:09:26.89,Default,,0,0,0,,Бұл қарыз жинаушы ма екен...?
Dialogue: 0,0:09:27.06,0:09:28.90,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:09:29.11,0:09:31.40,Default,,0,0,0,,Әке, тағы бір рет!
Dialogue: 0,0:09:31.77,0:09:33.82,Default,,0,0,0,,Уф... ой!
Dialogue: 0,0:09:42.20,0:09:44.29,Default,,0,0,0,,Өте жақсы резонанс.
Dialogue: 0,0:09:45.33,0:09:47.87,Default,,0,0,0,,Ахиллестің бақытты екенін көруге болады.
Dialogue: 0,0:09:48.37,0:09:50.75,Default,,0,0,0,,Айға күшейе түсті.
Dialogue: 0,0:09:57.97,0:10:03.18,Default,,0,0,0,,Ахиллес әкеммен шайқас өте қызықты болды.
Dialogue: 0,0:10:09.81,0:10:11.56,Default,,0,0,0,,Мен де көңілді болдым
Dialogue: 0,0:10:12.82,0:10:17.78,Default,,0,0,0,,Негізі мен Файмен жекпе-жекке шығудан аздап қорқамын.
Dialogue: 0,0:10:18.24,0:10:21.70,Default,,0,0,0,,Ол Омені де жоюы мүмкін.
Dialogue: 0,0:10:22.41,0:10:24.16,Default,,0,0,0,,Қорықпа...
Dialogue: 0,0:10:26.04,0:10:29.25,Default,,0,0,0,,Сізде қорқатын ештеңе жоқ
Dialogue: 0,0:10:35.09,0:10:37.59,Default,,0,0,0,,Түсіндім, Ахиллес!
Dialogue: 0,0:10:41.47,0:10:45.10,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:10:46.14,0:10:49.94,Default,,0,0,0,,Жарайды! Ұлдар мен қыздар!
Dialogue: 0,0:10:50.06,0:10:52.94,Default,,0,0,0,,Neobay Arena ойынына қош келдіңіз!
Dialogue: 0,0:10:53.06,0:10:55.11,Default,,0,0,0,,Күн де келді
Dialogue: 0,0:10:55.23,0:10:57.82,Default,,0,0,0,,Super Zetsu Challenge матчы!
Dialogue: 0,0:10:57.94,0:11:01.45,Default,,0,0,0,,Өлі Феникс көптеген шығанақтарды жоюды жалғастыруда
Dialogue: 0,0:11:01.57,0:11:03.45,Default,,0,0,0,,Super Z Ахиллес сізге қарсы тұр!
Dialogue: 0,0:11:03.87,0:11:06.41,Default,,0,0,0,,Ахиллес жойылу тізбегін тоқтата ала ма?
Dialogue: 0,0:11:06.54,0:11:10.29,Default,,0,0,0,,Әлде Феникс қайтадан ашулана ма?
Dialogue: 0,0:11:10.41,0:11:13.88,Default,,0,0,0,,Бұл қиян-кескі ұрыс болары сөзсіз!
Dialogue: 0,0:11:15.25,0:11:18.84,Default,,0,0,0,,Көк бұрыш! Бұл жерде жойылу Құдайы түседі
Dialogue: 0,0:11:19.47,0:11:21.34,Default,,0,0,0,,Phi!
Dialogue: 0,0:11:23.97,0:11:26.85,Default,,0,0,0,,Қызыл бұрыш! қызыл супер цетсу бала
Dialogue: 0,0:11:27.68,0:11:30.02,Default,,0,0,0,,Қызыл пышақ Айга!
Dialogue: 0,0:11:30.73,0:11:33.98,Default,,0,0,0,,Сәттілік Айға!
Dialogue: 0,0:11:34.90,0:11:35.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:36.90,0:11:37.73,Default,,0,0,0,,Фу…
Dialogue: 0,0:11:38.40,0:11:42.45,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:11:48.58,0:11:50.20,Default,,0,0,0,,Төзе бер, шыдай бер!
Dialogue: 0,0:11:54.33,0:11:57.46,Default,,0,0,0,,Мен сенің жүрегіңді қолымда сеземін.
Dialogue: 0,0:11:57.59,0:12:02.72,Default,,0,0,0,,Ахиллес қиратылып кете ме деп қорқып дірілдеп тұр.
Dialogue: 0,0:12:03.09,0:12:04.01,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:12:05.01,0:12:06.72,Default,,0,0,0,,Жұлдыз болған сияқты
Dialogue: 0,0:12:06.85,0:12:09.18,Default,,0,0,0,,Мен саған оны жоюға ешқашан жол бермеймін!
Dialogue: 0,0:12:09.35,0:12:13.31,Default,,0,0,0,,Осы Battle Burst матчында орындауға сұрау
Dialogue: 0,0:12:13.44,0:12:14.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:15.10,0:12:16.19,Default,,0,0,0,,Не...
Dialogue: 0,0:12:16.31,0:12:19.28,Default,,0,0,0,,Фаи кенеттен матчты сұрады!
Dialogue: 0,0:12:19.98,0:12:21.49,Default,,0,0,0,,Жарық матч?
Dialogue: 0,0:12:21.74,0:12:23.61,Default,,0,0,0,,Ұпайлар тек жарылыс үшін берілген!
Dialogue: 0,0:12:23.74,0:12:25.32,Default,,0,0,0,,Айналдыру аяқталуы
Dialogue: 0,0:12:25.45,0:12:27.24,Default,,0,0,0,,Есепсіз ерекше ереже.
Dialogue: 0,0:12:27.62,0:12:29.99,Default,,0,0,0,,Басқаша айтқанда, бұл Ран Бейруле.
Dialogue: 0,0:12:30.12,0:12:32.50,Default,,0,0,0,,Бұл жақсы емес пе? Ран Бейрул!
Dialogue: 0,0:12:32.83,0:12:34.33,Default,,0,0,0,,Жоқ, Сочо.
Dialogue: 0,0:12:34.79,0:12:36.13,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:12:36.71,0:12:39.21,Default,,0,0,0,,Оны мұқият қорғаудың стратегиясын ойлап таппадың ба?
Dialogue: 0,0:12:39.42,0:12:42.42,Default,,0,0,0,,Сіз Super Z-Оянғанға дейін жарылып кетпейсіз.
Dialogue: 0,0:12:42.55,0:12:45.18,Default,,0,0,0,,Ахиллес әлдеқайда тиімді емес пе?
Dialogue: 0,0:12:45.89,0:12:49.81,Default,,0,0,0,,Айғаны әбден қинамақшы.
Dialogue: 0,0:12:49.93,0:12:50.97,Default,,0,0,0,,Иносукэ… Иносукэ, өзіңді жина! Иносукэ!
Dialogue: 0,0:12:55.06,0:12:57.44,Default,,0,0,0,,Жасайық! Жарқын матч!
Dialogue: 0,0:12:57.61,0:12:59.77,Default,,0,0,0,,Не? (Сочо) Ол оны қабылдады.
Dialogue: 0,0:12:59.98,0:13:01.53,Default,,0,0,0,,Бұл қауіпті емес пе?
Dialogue: 0,0:13:01.78,0:13:03.07,Default,,0,0,0,,Айга…
Dialogue: 0,0:13:03.74,0:13:05.78,Default,,0,0,0,,Қарқынды матч шешілді!
Dialogue: 0,0:13:06.07,0:13:08.70,Default,,0,0,0,,Бұл шайқаста не болады?
Dialogue: 0,0:13:09.58,0:13:12.08,Default,,0,0,0,,Үмітсіздікті сезіну
Dialogue: 0,0:13:14.54,0:13:18.00,Default,,0,0,0,,Барто Аои... Қарап отырғаныңызға сенімдімін.
Dialogue: 0,0:13:18.67,0:13:22.96,Default,,0,0,0,,Енді мен бұл жігіттің жүрегін жарып жіберемін.
Dialogue: 0,0:13:23.30,0:13:26.01,Default,,0,0,0,,Маған қайта тұруға жол берме
Dialogue: 0,0:13:29.30,0:13:30.47,Default,,0,0,0,,Fi…
Dialogue: 0,0:13:32.01,0:13:33.06,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:13:33.47,0:13:34.35,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:13:34.98,0:13:38.27,Default,,0,0,0,,Онымен күресудің бірден-бір жолы - оны мұқият қорғау.
Dialogue: 0,0:13:39.06,0:13:41.94,Default,,0,0,0,,Әрине, олар Super Z оянуын шығаруды мақсат етеді.
Dialogue: 0,0:13:42.53,0:13:46.53,Default,,0,0,0,,Шабуылға төтеп бер, қорға, қорға, қорға.
Dialogue: 0,0:13:46.65,0:13:48.28,Default,,0,0,0,,Жеңістің сәтті мүмкіндігін пайдаланыңыз
Dialogue: 0,0:13:48.99,0:13:50.87,Default,,0,0,0,,Бұл Фиді жеңудің жалғыз жолы
Dialogue: 0,0:13:52.28,0:13:55.45,Default,,0,0,0,,Мен Шудың маған ойлап тапқан стратегиясымен барамын.
Dialogue: 0,0:13:56.08,0:13:57.83,Default,,0,0,0,,Қорғау стратегиясы?
Dialogue: 0,0:13:58.42,0:14:00.67,Default,,0,0,0,,Сіз осылай ойлайсыз.
Dialogue: 0,0:14:00.92,0:14:02.67,Default,,0,0,0,,Мен сіздің болжамыңызды көремін дейсіз бе?
Dialogue: 0,0:14:03.30,0:14:06.17,Default,,0,0,0,,Бұл сіздің сүйікті сөйлеміңіз болды.
Dialogue: 0,0:14:06.30,0:14:07.42,Default,,0,0,0,,Осылай жалғаса берсе, бұл тағдыр ғой, иә?
Dialogue: 0,0:14:07.55,0:14:10.68,Default,,0,0,0,,Мен саған барлығын ысырап екенін көрсетемін.
Dialogue: 0,0:14:14.68,0:14:16.02,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:14:16.48,0:14:19.65,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:14:20.06,0:14:22.40,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:14:23.07,0:14:23.90,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:27.65,0:14:31.12,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:14:31.24,0:14:33.95,Default,,0,0,0,,Енді екеуің де күшті соққы екенсіңдер!
Dialogue: 0,0:14:34.49,0:14:36.41,Default,,0,0,0,,Ахиллес ортаға қарай бет алды
Dialogue: 0,0:14:36.54,0:14:38.87,Default,,0,0,0,,Феникс Ол қалай пайда болады?
Dialogue: 0,0:14:41.71,0:14:43.09,Default,,0,0,0,,Өлі үзіліс!
Dialogue: 0,0:14:46.88,0:14:48.84,Default,,0,0,0,,Super Z қорғанысы!
Dialogue: 0,0:14:51.51,0:14:53.14,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:14:53.26,0:14:55.35,Default,,0,0,0,,Өлі Феникстің күшті шабуылы
Dialogue: 0,0:14:55.47,0:14:57.56,Default,,0,0,0,,Ахиллес бірінен соң бірі таңдалады!
Dialogue: 0,0:14:58.18,0:15:00.02,Default,,0,0,0,,Ахиллеске шыда!
Dialogue: 0,0:15:00.27,0:15:02.40,Default,,0,0,0,,Жарайды, солай!
Dialogue: 0,0:15:02.52,0:15:03.94,Default,,0,0,0,,Жақсы төзімді
Dialogue: 0,0:15:04.15,0:15:05.52,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:15:06.07,0:15:10.03,Default,,0,0,0,,Феникстің үздіксіз шабуылы Ахиллес қашып құтыла алмайды!
Dialogue: 0,0:15:10.95,0:15:13.16,Default,,0,0,0,,Сіз бұған шыдауға тырысасыз ба?
Dialogue: 0,0:15:13.41,0:15:15.91,Default,,0,0,0,,Мүмкіндік әрқашан келеді
Dialogue: 0,0:15:16.12,0:15:17.41,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:15:18.37,0:15:21.42,Default,,0,0,0,,Ой! Ахиллес шыдай алмайды
Dialogue: 0,0:15:21.71,0:15:23.42,Default,,0,0,0,,Қызық!
Dialogue: 0,0:15:25.54,0:15:27.80,Default,,0,0,0,,Әлі жарылып кетпеңіз
Dialogue: 0,0:15:34.18,0:15:36.76,Default,,0,0,0,,Өлі Феникс аяқталды
Dialogue: 0,0:15:36.97,0:15:39.77,Default,,0,0,0,,Бұл жекпе-жек жекпе-жек болып табылады.
Dialogue: 0,0:15:39.89,0:15:42.77,Default,,0,0,0,,Дұрыс, артық орындағаныңыз үшін ұпай алмайсыз!
Dialogue: 0,0:15:42.94,0:15:43.94,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:44.90,0:15:48.03,Default,,0,0,0,,Сізде әлі де үмітсіздік жоқ.
Dialogue: 0,0:15:48.15,0:15:49.69,Default,,0,0,0,,Келесі! Келесі!
Dialogue: 0,0:15:49.82,0:15:51.45,Default,,0,0,0,,Қуаныңыз!
Dialogue: 0,0:15:51.57,0:15:54.03,Default,,0,0,0,,Айга! Терең тыныс ал!
Dialogue: 0,0:15:54.37,0:15:55.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:56.41,0:16:00.75,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:16:02.50,0:16:05.08,Default,,0,0,0,,Жарайды, зейініңді жина.
Dialogue: 0,0:16:06.96,0:16:08.21,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:16:08.67,0:16:10.17,Default,,0,0,0,,Жасайық
Dialogue: 0,0:16:10.38,0:16:13.22,Default,,0,0,0,,Мен сені міндетті түрде жарып жіберемін!
Dialogue: 0,0:16:13.88,0:16:16.18,Default,,0,0,0,,Маған бұл сезім ұнайды
Dialogue: 0,0:16:16.55,0:16:20.68,Default,,0,0,0,,Мен энергияның жоғалғанын көрейін.
Dialogue: 0,0:16:22.39,0:16:23.94,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:16:24.60,0:16:27.06,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:16:27.56,0:16:30.36,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:16:37.62,0:16:40.08,Default,,0,0,0,,Ахиллес аяқталуға жақын.
Dialogue: 0,0:16:40.54,0:16:41.75,Default,,0,0,0,,Өлі үзіліс!
Dialogue: 0,0:16:47.67,0:16:49.17,Default,,0,0,0,,Аяқталмаған
Dialogue: 0,0:16:49.29,0:16:51.38,Default,,0,0,0,,Super Z қорғанысы!
Dialogue: 0,0:16:53.55,0:16:54.97,Default,,0,0,0,,Не істеймін… не істеймін!
Dialogue: 0,0:16:55.09,0:16:58.05,Default,,0,0,0,,Бұл бұрынғыдай даму.
Dialogue: 0,0:16:58.18,0:17:00.22,Default,,0,0,0,,Феникстің тынымсыз шабуылы!
Dialogue: 0,0:17:00.47,0:17:04.10,Default,,0,0,0,,Super Z-Owakening және т.б. Феникске еш қатысы жоқ.
Dialogue: 0,0:17:04.23,0:17:05.23,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:17:05.73,0:17:10.98,Default,,0,0,0,,Сіздің бекіңіздің соңғы көрінісін есте сақтаңыз.
Dialogue: 0,0:17:11.28,0:17:15.74,Default,,0,0,0,,Феникс Ахиллесті қинағандай шабуылын жалғастыруда!
Dialogue: 0,0:17:16.11,0:17:16.99,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:17.36,0:17:20.66,Default,,0,0,0,,Қаттырақ кел, күштірек шабуыл жаса!
Dialogue: 0,0:17:20.83,0:17:23.41,Default,,0,0,0,,Ахиллесті жеңу мүмкін емес!
Dialogue: 0,0:17:26.29,0:17:28.17,Default,,0,0,0,,Күрестің босқа кеткені!
Dialogue: 0,0:17:31.13,0:17:34.76,Default,,0,0,0,,Ах! Мен қатты соққы алдым!
Dialogue: 0,0:17:34.88,0:17:37.13,Default,,0,0,0,,Бұл жұмыс істеді ме? Ахиллес
Dialogue: 0,0:17:37.55,0:17:40.10,Default,,0,0,0,,Ах, Ахиллес тоқтады!
Dialogue: 0,0:17:40.80,0:17:42.43,Default,,0,0,0,,Әлі жарылып кетпеңіз
Dialogue: 0,0:17:42.56,0:17:43.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:44.02,0:17:45.48,Default,,0,0,0,,
Dialogue: 0,0:17:45.98,0:17:48.06,Default,,0,0,0,,Өлі Феникстің айналуы
Dialogue: 0,0:17:48.56,0:17:51.90,Default,,0,0,0,,Хахаха... Кез келген уақытта жасай аласыз.
Dialogue: 0,0:17:52.57,0:17:54.19,Default,,0,0,0,,Жарық матч ережелеріне байланысты
Dialogue: 0,0:17:54.32,0:17:57.07,Default,,0,0,0,,Ұпайлар әлі де 0-0!
Dialogue: 0,0:17:57.32,0:17:59.57,Default,,0,0,0,,Тоқта...
Dialogue: 0,0:17:59.91,0:18:02.28,Default,,0,0,0,,Сіз қалай ойлайсыз? Үмітсіздік дәмі
Dialogue: 0,0:18:02.41,0:18:04.33,Default,,0,0,0,,Мен үміт үзбеймін!
Dialogue: 0,0:18:04.83,0:18:08.08,Default,,0,0,0,,Бұл менмендік қанша уақытқа созылады?
Dialogue: 0,0:18:08.50,0:18:10.79,Default,,0,0,0,,Сәлем, Барто Аои
Dialogue: 0,0:18:15.21,0:18:17.34,Default,,0,0,0,,Сәттілік Айға!
Dialogue: 0,0:18:17.84,0:18:20.09,Default,,0,0,0,,Қайта серпіл, Айға!
Dialogue: 0,0:18:21.30,0:18:22.22,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:18:23.43,0:18:25.85,Default,,0,0,0,,Біз берілмейміз
Dialogue: 0,0:18:25.97,0:18:27.60,Default,,0,0,0,,Ахиллес Тағы бір рет!
Dialogue: 0,0:18:28.39,0:18:29.60,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:29.90,0:18:31.94,Default,,0,0,0,,Кешегі тайга сияқты
Dialogue: 0,0:18:32.06,0:18:32.90,Default,,0,0,0,,О
Dialogue: 0,0:18:33.61,0:18:36.61,Default,,0,0,0,,Бала бұл шайқастан ләззат алады.
Dialogue: 0,0:18:37.11,0:18:40.86,Default,,0,0,0,,Феникс мұны тезірек аяқтағысы келетін сияқты.
Dialogue: 0,0:18:40.99,0:18:42.70,Default,,0,0,0,,Біз мұны істедік делік.
Dialogue: 0,0:18:43.03,0:18:44.37,Default,,0,0,0,,Жою
Dialogue: 0,0:18:44.62,0:18:47.62,Default,,0,0,0,,Мен мұны істей аламын, мен оны қорғай аламын.
Dialogue: 0,0:18:47.96,0:18:48.87,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:18:49.12,0:18:51.25,Default,,0,0,0,,Мүмкіндіктер әрқашан келеді!
Dialogue: 0,0:18:51.67,0:18:53.46,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:18:54.21,0:18:57.09,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:57.51,0:19:00.51,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:19:00.63,0:19:01.76,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:07.77,0:19:09.18,Default,,0,0,0,,Өлі үзіліс!
Dialogue: 0,0:19:12.90,0:19:15.36,Default,,0,0,0,,Super Z-қорғаныс!
Dialogue: 0,0:19:16.19,0:19:17.82,Default,,0,0,0,,Бұл босқа!
Dialogue: 0,0:19:18.24,0:19:19.53,Default,,0,0,0,,Феникс
Dialogue: 0,0:19:19.65,0:19:22.78,Default,,0,0,0,,Біз міндетті түрде Ахиллестің супер Z-қанатына ұмтыламыз!
Dialogue: 0,0:19:23.12,0:19:25.78,Default,,0,0,0,,Super Z-Owakening енді жұмыс істемейді
Dialogue: 0,0:19:28.12,0:19:30.04,Default,,0,0,0,,Ахиллді таң қалдырды!
Dialogue: 0,0:19:30.21,0:19:33.33,Default,,0,0,0,,Уууу!
Dialogue: 0,0:19:33.46,0:19:36.17,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:19:37.46,0:19:40.80,Default,,0,0,0,,(Ахиллестің айқайы)
Dialogue: 0,0:19:45.01,0:19:48.06,Default,,0,0,0,,Не! Ахиллес шыдады!
Dialogue: 0,0:19:48.27,0:19:49.35,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:19:49.98,0:19:53.98,Default,,0,0,0,,Super Z Shield!
Dialogue: 0,0:19:54.35,0:19:55.19,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:55.31,0:19:58.28,Default,,0,0,0,,Ахиллестің Super Z қалқаны осында!
Dialogue: 0,0:19:58.40,0:20:00.94,Default,,0,0,0,,Феникс сонда жүгіреді!
Dialogue: 0,0:20:03.36,0:20:06.87,Default,,0,0,0,,Кел, маған нағыз үмітсіздік сыйла.
Dialogue: 0,0:20:07.03,0:20:08.41,Default,,0,0,0,,Феникс!
Dialogue: 0,0:20:11.71,0:20:13.17,Default,,0,0,0,,(Феникс Роар)
Dialogue: 0,0:20:20.92,0:20:22.26,Default,,0,0,0,,Бұл маңызды емес, иә?
Dialogue: 0,0:20:23.93,0:20:26.14,Default,,0,0,0,,Мен сені құртамын!
Dialogue: 0,0:20:26.97,0:20:30.18,Default,,0,0,0,,Біз тек адамбыз; бәрі біз қалағандай бола бермейді.
Dialogue: 0,0:20:31.02,0:20:34.44,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:20:34.98,0:20:35.90,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:20:55.33,0:20:56.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:57.75,0:20:59.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:00.21,0:21:01.63,Default,,0,0,0,,Құлайтындай… Бұл қылыш…
Dialogue: 0,0:21:02.17,0:21:05.55,Default,,0,0,0,,Жарайды! Бұл жарылыс!
Dialogue: 0,0:21:05.68,0:21:08.55,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:08.93,0:21:10.06,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:10.18,0:21:12.47,Default,,0,0,0,,Жоқ, жоқ! Бұл басқаша! Жоқ!
Dialogue: 0,0:21:12.60,0:21:13.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:13.64,0:21:15.56,Default,,0,0,0,,Жарылып кетпейді!
Dialogue: 0,0:21:15.73,0:21:19.02,Default,,0,0,0,,Феникстің сауыты енді ғана шешілді!
Dialogue: 0,0:21:19.73,0:21:22.73,Default,,0,0,0,,Super Z Ахиллес аяқталды
Dialogue: 0,0:21:23.07,0:21:24.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:24.44,0:21:25.49,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:21:26.45,0:21:28.28,Default,,0,0,0,,Жоқ, бұл жақсы.
Dialogue: 0,0:21:29.83,0:21:30.91,Default,,0,0,0,,Айга!
Dialogue: 0,0:21:31.33,0:21:35.58,Default,,0,0,0,,Ұпайлар әлі де 0-0!
Dialogue: 0,0:21:38.08,0:21:40.59,Default,,0,0,0,,Не? Сол жарық
Dialogue: 0,0:21:42.42,0:21:44.05,Default,,0,0,0,,Қызықты
Dialogue: 0,0:21:47.55,0:21:50.76,Default,,0,0,0,,Фи Тағы бір рет!
Dialogue: 0,0:21:55.27,0:22:01.27,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:18.73,0:23:24.73,Default,,0,0,0,,~♪
Dialogue: 0,0:23:25.90,0:23:27.90,Default,,0,0,0,,Фимен соңғы шайқас
Dialogue: 0,0:23:28.03,0:23:32.03,Default,,0,0,0,,Бізді қолдаған адамдардың даусын естіп тұрмын.
Dialogue: 0,0:23:32.36,0:23:35.95,Default,,0,0,0,,Біз қосылдық. Біз бірге күресеміз!
Dialogue: 0,0:23:36.28,0:23:40.62,Default,,0,0,0,,Бұл сезімді күшке айналдыр, Ахилл, кеттік!
Dialogue: 0,0:23:40.87,0:23:43.46,Default,,0,0,0,,Келесі жолы «Beyblade Burst Super Zetsu»
Dialogue: 0,0:23:43.58,0:23:45.71,Default,,0,0,0,,«Айга, супер Цетсу резонансы!!»
Dialogue: 0,0:23:45.84,0:23:47.59,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.75,0:23:49.59,Default,,0,0,0,,Бар, ат!
