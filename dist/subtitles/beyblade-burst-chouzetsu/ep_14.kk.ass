Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.75,0:00:04.04,Default,,0,0,0,,Бейблейд
Dialogue: 0,0:00:04.17,0:00:08.55,Default,,0,0,0,,Мықты болуды мақсат еткен ұлдардың арманының жемісі.
Dialogue: 0,0:00:08.96,0:00:12.42,Default,,0,0,0,,Енді супер Цетсу дәуірі басталады.
Dialogue: 0,0:00:12.55,0:00:16.80,Default,,0,0,0,,Металл сауытыңызды киіңіз де, Беймен шытырман оқиғаға аттаныңыз!
Dialogue: 0,0:00:16.93,0:00:19.26,Default,,0,0,0,,Әлем чемпионы болуды мақсат етіңіз!
Dialogue: 0,0:00:19.39,0:00:23.69,Default,,0,0,0,,Super Zetsu Super Zetsu Super Zetsu!
Dialogue: 0,0:00:24.27,0:00:27.90,Default,,0,0,0,,Ең күшті және жеңілмейтін атағын алатын адам сенсің!
Dialogue: 0,0:00:35.74,0:00:39.70,Default,,0,0,0,,Сол жігіт кенет Балтоның алдынан шықты.
Dialogue: 0,0:00:40.20,0:00:41.70,Default,,0,0,0,,Сіз Phiсіз бе?
Dialogue: 0,0:00:41.87,0:00:43.33,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:00:44.91,0:00:46.54,Default,,0,0,0,,Мен ойнауға келдім.
Dialogue: 0,0:00:47.96,0:00:49.84,Default,,0,0,0,,Лонгинус кубогының финалы
Dialogue: 0,0:00:50.42,0:00:53.05,Default,,0,0,0,,Су мен екеуміздің арамыздағы шайқас басталды.
Dialogue: 0,0:00:56.43,0:00:58.97,Default,,0,0,0,,Z Slash!
Dialogue: 0,0:01:07.69,0:01:08.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:10.98,0:01:13.57,Default,,0,0,0,,Ақыры мен Суохты жеңдім!
Dialogue: 0,0:01:13.74,0:01:16.99,Default,,0,0,0,,Келесіде Ширасаги сарайы Луис!
Dialogue: 0,0:01:20.70,0:01:21.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:24.79,0:01:26.46,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:26.62,0:01:28.42,Default,,0,0,0,,Гао!
Dialogue: 0,0:01:30.04,0:01:32.00,Default,,0,0,0,,Ахахха! а?
Dialogue: 0,0:01:32.09,0:01:34.05,Default,,0,0,0,,Омэкчи Бұл қызық хахаха
Dialogue: 0,0:01:34.13,0:01:35.47,Default,,0,0,0,,Не?
Dialogue: 0,0:01:35.84,0:01:37.43,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:01:37.55,0:01:40.68,Default,,0,0,0,,Мен Лабан Лабан Ваномын
Dialogue: 0,0:01:41.01,0:01:41.93,Default,,0,0,0,,Әй?
Dialogue: 0,0:01:42.01,0:01:43.56,Default,,0,0,0,,Жеңісіңіз құтты болсын!
Dialogue: 0,0:01:43.64,0:01:45.31,Default,,0,0,0,,О!
Dialogue: 0,0:01:45.39,0:01:47.31,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:01:47.64,0:01:49.85,Default,,0,0,0,,Не... Бұл не?
Dialogue: 0,0:01:49.94,0:01:52.52,Default,,0,0,0,,Мен жақсы араласа аламыз деп ойлаймын.
Dialogue: 0,0:01:52.90,0:01:54.94,Default,,0,0,0,,Сонымен бұл не?
Dialogue: 0,0:01:56.24,0:01:59.11,Default,,0,0,0,,Мен ең күшті көріпкелмін
Dialogue: 0,0:02:00.41,0:02:06.41,Default,,0,0,0,,♪~
Dialogue: 0,0:03:23.11,0:03:29.12,Default,,0,0,0,,~♪
Dialogue: 0,0:03:30.00,0:03:32.96,Default,,0,0,0,,"Зұлым айдаһар! Қанды Лонгинус!!"
Dialogue: 0,0:03:35.67,0:03:37.71,Default,,0,0,0,,Ниннин Ниннин
Dialogue: 0,0:03:37.80,0:03:39.92,Default,,0,0,0,,Гуру Гуру~ Гуру Гуру~
Dialogue: 0,0:03:44.64,0:03:46.14,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:48.18,0:03:49.06,Default,,0,0,0,,Не!
Dialogue: 0,0:03:49.14,0:03:52.23,Default,,0,0,0,,Уа, ау! Ах~! (құлап түскен дыбыс)
Dialogue: 0,0:03:52.85,0:03:54.60,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:03:55.73,0:03:58.48,Default,,0,0,0,,Қал... А?
Dialogue: 0,0:04:00.28,0:04:01.32,Default,,0,0,0,,(қауіпті дыбыс)
Dialogue: 0,0:04:01.40,0:04:02.82,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:08.79,0:04:11.91,Default,,0,0,0,,Иә? Менен көмек сұрап тұрсың ба?
Dialogue: 0,0:04:12.83,0:04:14.42,Default,,0,0,0,,Жарайды, жел болжау.
Dialogue: 0,0:04:15.04,0:04:17.75,Default,,0,0,0,,Жел, маған жол көрсет.
Dialogue: 0,0:04:23.34,0:04:25.18,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:04:28.30,0:04:30.47,Default,,0,0,0,,Хаха...
Dialogue: 0,0:04:30.77,0:04:32.73,Default,,0,0,0,,♬~
Dialogue: 0,0:04:32.81,0:04:36.48,Default,,0,0,0,,ше? Апыр-ай!
Dialogue: 0,0:04:36.65,0:04:37.48,Default,,0,0,0,,О!
Dialogue: 0,0:04:38.11,0:04:39.82,Default,,0,0,0,,Оме, күннің көріпкелі!
Dialogue: 0,0:04:39.94,0:04:41.19,Default,,0,0,0,,Уау! сурет?
Dialogue: 0,0:04:41.28,0:04:45.32,Default,,0,0,0,,Хмм! Мені назардан тыс қалдырмаңыз!
Dialogue: 0,0:04:46.24,0:04:48.41,Default,,0,0,0,,Shtatata… Уау!
Dialogue: 0,0:04:52.04,0:04:53.62,Default,,0,0,0,,Shtatata... Уау!
Dialogue: 0,0:04:55.37,0:04:56.29,Default,,0,0,0,,Жап! Иә!
Dialogue: 0,0:04:56.50,0:04:58.63,Default,,0,0,0,,Shtatata... Уау!
Dialogue: 0,0:05:05.26,0:05:07.30,Default,,0,0,0,,Shtatata... Уау!
Dialogue: 0,0:05:08.34,0:05:12.31,Default,,0,0,0,,(Екі адам ауыр тыныс алуда)
Dialogue: 0,0:05:12.60,0:05:14.89,Default,,0,0,0,,Омэкки, сен мені қаншаға дейін ілесесің?
Dialogue: 0,0:05:14.98,0:05:16.31,Default,,0,0,0,,Мен жеңгенше
Dialogue: 0,0:05:16.39,0:05:18.19,Default,,0,0,0,,Мен сенімен дәл қазір айналысқым келмейді.
Dialogue: 0,0:05:18.27,0:05:19.48,Default,,0,0,0,,Уа! а?
Dialogue: 0,0:05:22.11,0:05:22.98,Default,,0,0,0,,Мен... Мен ондай жігіттерді шын жек көремін!
Dialogue: 0,0:05:23.07,0:05:24.49,Default,,0,0,0,,Ах! Сіз күте аласыз ба!
Dialogue: 0,0:05:25.24,0:05:26.15,Default,,0,0,0,,Сочо!
Dialogue: 0,0:05:26.24,0:05:28.74,Default,,0,0,0,,Бұл қиын! Ол қатты! Бұл шынымен қиын!
Dialogue: 0,0:05:29.16,0:05:30.49,Default,,0,0,0,,Бөтен планеталық?
Dialogue: 0,0:05:30.62,0:05:33.24,Default,,0,0,0,,Иә? Тағы да айтасың ба?
Dialogue: 0,0:05:33.33,0:05:34.25,Default,,0,0,0,,Дари
Dialogue: 0,0:05:34.58,0:05:36.54,Default,,0,0,0,,Мен оны шынымен көрдім!
Dialogue: 0,0:05:36.62,0:05:40.25,Default,,0,0,0,,Мына жігіт сондай, жанып жатыр, күйіп жатыр...
Dialogue: 0,0:05:40.33,0:05:43.55,Default,,0,0,0,,Жарайды, жарайды, жаттығуды жалғастырайық.
Dialogue: 0,0:05:43.63,0:05:44.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:44.88,0:05:47.34,Default,,0,0,0,,Сочо, маған сеніңіз~
Dialogue: 0,0:05:47.43,0:05:48.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:51.14,0:05:51.97,Default,,0,0,0,,Иә
Dialogue: 0,0:05:52.14,0:05:54.68,Default,,0,0,0,,Күте тұрыңыз! Бенимару өтірік айтпа
Dialogue: 0,0:05:54.93,0:05:55.93,Default,,0,0,0,,Э~?
Dialogue: 0,0:05:56.39,0:05:58.85,Default,,0,0,0,,Келіңіздер, шетелдіктерді іздеу тобын құрайық!
Dialogue: 0,0:05:58.94,0:05:59.85,Default,,0,0,0,,Дари
Dialogue: 0,0:05:59.94,0:06:02.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:03.15,0:06:04.94,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:06:05.32,0:06:06.61,Default,,0,0,0,,(Шың) Мен… мен біттім. Мен аяқталдым.
Dialogue: 0,0:06:09.95,0:06:10.95,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:06:11.28,0:06:13.70,Default,,0,0,0,,Не... онда ештеңе жоқ.
Dialogue: 0,0:06:13.79,0:06:15.20,Default,,0,0,0,,Да... daii
Dialogue: 0,0:06:15.29,0:06:17.08,Default,,0,0,0,,Сонымен... сочо
Dialogue: 0,0:06:17.16,0:06:18.08,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:06:23.67,0:06:25.34,Default,,0,0,0,,Міне! (Барлығы) Уау!
Dialogue: 0,0:06:25.51,0:06:27.92,Default,,0,0,0,,Уф... не? Ах
Dialogue: 0,0:06:28.26,0:06:29.76,Default,,0,0,0,,Теме Сол кезде!
Dialogue: 0,0:06:29.84,0:06:31.64,Default,,0,0,0,,Нуо~! ау
Dialogue: 0,0:06:31.89,0:06:33.51,Default,,0,0,0,,Уа, ау!
Dialogue: 0,0:06:33.60,0:06:35.56,Default,,0,0,0,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:06:35.64,0:06:36.52,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:36.85,0:06:38.52,Default,,0,0,0,,(Қол Перісі) Құтқарып болмайды… Соңғы көргенім – демон өлтірушінің жүзі болар деп кім ойлаған…
Dialogue: 0,0:06:39.23,0:06:40.69,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:06:40.77,0:06:42.81,Default,,0,0,0,,Теме, не істеп жатырсың!
Dialogue: 0,0:06:42.90,0:06:46.65,Default,,0,0,0,,Шашың жұмақ құсына ұқсайды.
Dialogue: 0,0:06:46.73,0:06:47.94,Default,,0,0,0,,Жұмақ құсы кім?
Dialogue: 0,0:06:48.03,0:06:49.32,Default,,0,0,0,,Ах
Dialogue: 0,0:06:49.40,0:06:50.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:50.66,0:06:52.95,Default,,0,0,0,,Сочо сияқты нәрсе бар.
Dialogue: 0,0:06:53.03,0:06:53.91,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:54.28,0:06:56.37,Default,,0,0,0,,Е... Бұл бөтен адам~
Dialogue: 0,0:06:56.45,0:06:57.33,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:06:58.12,0:06:59.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:01.62,0:07:02.38,Default,,0,0,0,,Ей!
Dialogue: 0,0:07:02.63,0:07:04.34,Default,,0,0,0,,Бұл шықты!
Dialogue: 0,0:07:05.50,0:07:07.71,Default,,0,0,0,,Қарғыс атсын (Джонси) Жоқ, бұл...
Dialogue: 0,0:07:08.01,0:07:09.80,Default,,0,0,0,,Шетелдік емес
Dialogue: 0,0:07:10.88,0:07:12.97,Default,,0,0,0,,Бұл қырлы кесіртке!
Dialogue: 0,0:07:13.26,0:07:14.80,Default,,0,0,0,,Бұрылған кесіртке?
Dialogue: 0,0:07:14.89,0:07:15.97,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:16.22,0:07:18.22,Default,,0,0,0,,(қауіпті дыбыс)
Dialogue: 0,0:07:22.52,0:07:23.48,Default,,0,0,0,,Ах! Мен жүгірдім!
Dialogue: 0,0:07:23.65,0:07:25.23,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:25.94,0:07:26.77,Default,,0,0,0,,Хи хи
Dialogue: 0,0:07:27.44,0:07:29.36,Default,,0,0,0,,(қауіпті дыбыс)
Dialogue: 0,0:07:29.65,0:07:31.11,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:35.45,0:07:36.62,Default,,0,0,0,,Хехе
Dialogue: 0,0:07:42.08,0:07:43.12,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:07:43.54,0:07:45.21,Default,,0,0,0,,Уау! қолға үйретілген
Dialogue: 0,0:07:45.29,0:07:47.17,Default,,0,0,0,,Теме, онымен не істеуіміз керек?
Dialogue: 0,0:07:47.55,0:07:49.17,Default,,0,0,0,,Мен сені үйге апарамын
Dialogue: 0,0:07:49.51,0:07:52.34,Default,,0,0,0,,Дәлірек айтсақ, бұл кім?
Dialogue: 0,0:07:52.84,0:07:54.80,Default,,0,0,0,,Ең күшті көріпкел
Dialogue: 0,0:07:54.89,0:07:57.85,Default,,0,0,0,,Бұл баланың осы жерге келетінін көріпкелден білдім.
Dialogue: 0,0:07:58.31,0:08:01.35,Default,,0,0,0,,Болжам? Бұл жалған, солай емес пе?
Dialogue: 0,0:08:02.10,0:08:03.94,Default,,0,0,0,,Маған сенбейсіз бе?
Dialogue: 0,0:08:04.19,0:08:08.07,Default,,0,0,0,,Олай болса, келесі қарсыласым Руи Ширасагиге айтайын ба?
Dialogue: 0,0:08:08.19,0:08:10.11,Default,,0,0,0,,Мүмкін сіз стратегияны анықтай аласыз ба?
Dialogue: 0,0:08:10.44,0:08:12.28,Default,,0,0,0,,Болжаудың қажеті жоқ
Dialogue: 0,0:08:12.40,0:08:14.74,Default,,0,0,0,,Стратегия дәл осында мен үшін.
Dialogue: 0,0:08:15.49,0:08:17.74,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:08:19.16,0:08:22.33,Default,,0,0,0,,Жер, маған жол көрсет.
Dialogue: 0,0:08:22.41,0:08:23.29,Default,,0,0,0,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,0:08:25.88,0:08:27.59,Default,,0,0,0,,Хмф, см... (барлығы) О?
Dialogue: 0,0:08:27.96,0:08:30.51,Default,,0,0,0,,Жарайды, мен бұл баланың үйін білемін.
Dialogue: 0,0:08:31.09,0:08:32.13,Default,,0,0,0,,Мен... Мен ондай жігіттерді шын жек көремін!
Dialogue: 0,0:08:33.63,0:08:36.93,Default,,0,0,0,,А... бұл не болды?
Dialogue: 0,0:08:41.52,0:08:43.48,Default,,0,0,0,,♬~
Dialogue: 0,0:08:45.52,0:08:46.48,Default,,0,0,0,,Сәлем Айга
Dialogue: 0,0:08:46.56,0:08:49.52,Default,,0,0,0,,Ширасаги қамал Луи үшін қандай стратегия бар?
Dialogue: 0,0:08:49.73,0:08:52.94,Default,,0,0,0,,Хехехе Луи Лонгинус солға бұрылады
Dialogue: 0,0:08:53.57,0:08:56.61,Default,,0,0,0,,Мен жеңген Тозақ Саламандармен бірдей.
Dialogue: 0,0:08:57.66,0:08:58.62,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:08:58.70,0:09:02.20,Default,,0,0,0,,Егер сіз Суохты жеңген кезде қолданған стратегияңызды қолдансаңыз, сіз мінсіз боласыз.
Dialogue: 0,0:09:02.29,0:09:03.58,Default,,0,0,0,,Мүмкін солай шығар.
Dialogue: 0,0:09:03.66,0:09:04.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:05.08,0:09:06.29,Default,,0,0,0,,Сочо
Dialogue: 0,0:09:06.71,0:09:09.42,Default,,0,0,0,,Менің ойымша, бұл оңай емес.
Dialogue: 0,0:09:09.67,0:09:10.96,Default,,0,0,0,,Қалғандар да дәл қазір барын салып еңбек етіп жатқан болар.
Dialogue: 0,0:09:11.05,0:09:14.17,Default,,0,0,0,,Луидің күші Сухтан күшті.
Dialogue: 0,0:09:14.63,0:09:16.68,Default,,0,0,0,,Онда арнайы дайындықтан өтуден басқа амалымыз жоқ.
Dialogue: 0,0:09:17.26,0:09:19.01,Default,,0,0,0,,Ах! О?
Dialogue: 0,0:09:19.26,0:09:21.18,Default,,0,0,0,,Иә? (Оу Хоуи) Эйгер!
Dialogue: 0,0:09:21.43,0:09:23.18,Default,,0,0,0,,Эйгер! Хоуи!
Dialogue: 0,0:09:23.56,0:09:24.93,Default,,0,0,0,,Мынаны қараңыз!
Dialogue: 0,0:09:25.18,0:09:26.06,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:26.14,0:09:27.94,Default,,0,0,0,,Бұл садақ ату ма?
Dialogue: 0,0:09:28.31,0:09:29.98,Default,,0,0,0,,О, мен жеңдім.
Dialogue: 0,0:09:30.06,0:09:31.36,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:09:31.44,0:09:32.90,Default,,0,0,0,,Керемет! Керемет!
Dialogue: 0,0:09:32.98,0:09:35.36,Default,,0,0,0,,Ал, сен Жапонияға қашан келдің?
Dialogue: 0,0:09:35.44,0:09:36.78,Default,,0,0,0,,Дәл қазір
Dialogue: 0,0:09:37.20,0:09:38.91,Default,,0,0,0,,Келесі кезекте Айға
Dialogue: 0,0:09:39.24,0:09:41.70,Default,,0,0,0,,Ширасаги сарайын Луис жеңіңіз! Оу!
Dialogue: 0,0:09:42.20,0:09:45.41,Default,,0,0,0,,Жарайды! Олай болса, үшеуміз тағы да оқу-жаттығу жиынын өткіземіз.
Dialogue: 0,0:09:45.50,0:09:48.83,Default,,0,0,0,,Менің шатырымда тағы ұйықтайсың ба?
Dialogue: 0,0:09:49.17,0:09:52.04,Default,,0,0,0,,Үш адам бірге көңілді
Dialogue: 0,0:09:52.30,0:09:55.80,Default,,0,0,0,,Иә? Мүмкін күлетін шығарсың?
Dialogue: 0,0:09:56.30,0:09:58.30,Default,,0,0,0,,О, мен күліп тұрмын.
Dialogue: 0,0:09:58.63,0:10:01.47,Default,,0,0,0,,Түсіну әлі қиын~
Dialogue: 0,0:10:02.68,0:10:04.43,Default,,0,0,0,,Хмм.
Dialogue: 0,0:10:04.64,0:10:07.69,Default,,0,0,0,,Күшімді арттыру үшін не істеуім керек?
Dialogue: 0,0:10:08.19,0:10:09.40,Default,,0,0,0,,Хмм.
Dialogue: 0,0:10:17.24,0:10:19.24,Default,,0,0,0,,Өйткені, шоғырлану маңызды
Dialogue: 0,0:10:19.66,0:10:22.16,Default,,0,0,0,,Міне, осы ғана
Dialogue: 0,0:10:22.37,0:10:23.99,Default,,0,0,0,,Концентрация?
Dialogue: 0,0:10:24.20,0:10:26.25,Default,,0,0,0,,Шоғырлану.
Dialogue: 0,0:10:28.46,0:10:29.33,Default,,0,0,0,,Иә
Dialogue: 0,0:10:29.96,0:10:30.88,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:30.96,0:10:33.63,Default,,0,0,0,,Кептірілген жемістер, жаңғақтар, шоколад
Dialogue: 0,0:10:33.84,0:10:36.38,Default,,0,0,0,,Олардың барлығы зейінді жақсартатын сияқты.
Dialogue: 0,0:10:36.46,0:10:38.22,Default,,0,0,0,,Қараңдар! жеу жеу
Dialogue: 0,0:10:38.30,0:10:39.22,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:10:39.55,0:10:41.30,Default,,0,0,0,,Тамақ ішейік!
Dialogue: 0,0:10:45.39,0:10:46.60,Default,,0,0,0,,Хмм?
Dialogue: 0,0:10:48.98,0:10:51.85,Default,,0,0,0,,Хаа~ Мен жедім! Мен жедім!
Dialogue: 0,0:10:51.94,0:10:53.27,Default,,0,0,0,,Сіз тым көп жеп жатырсыз!
Dialogue: 0,0:10:53.56,0:10:55.78,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:11:01.03,0:11:02.28,Default,,0,0,0,,Жүр! Ахиллес!
Dialogue: 0,0:11:05.45,0:11:07.16,Default,,0,0,0,,Желді темір қанаттарымен кес!
Dialogue: 0,0:11:07.66,0:11:10.75,Default,,0,0,0,,Рагнарук тайфуны!
Dialogue: 0,0:11:19.63,0:11:20.47,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:21.55,0:11:23.97,Default,,0,0,0,,Маған әлі де шыдам мен күш жетпейді.
Dialogue: 0,0:11:24.10,0:11:27.18,Default,,0,0,0,,Бізді жеңе алмасаң, Лонгинусты жеңе алмайсың.
Dialogue: 0,0:11:27.68,0:11:28.68,Default,,0,0,0,,Тағы да
Dialogue: 0,0:11:29.14,0:11:30.94,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:11:31.35,0:11:34.56,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:11:34.90,0:11:36.94,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:11:43.20,0:11:44.03,Default,,0,0,0,,Ах
Dialogue: 0,0:11:51.50,0:11:52.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:52.96,0:11:53.75,Default,,0,0,0,,Әй!
Dialogue: 0,0:11:57.34,0:12:00.42,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:12:01.51,0:12:02.51,Default,,0,0,0,,Куу~!
Dialogue: 0,0:12:03.05,0:12:05.30,Default,,0,0,0,,Неліктен мен жеңе алмаймын?
Dialogue: 0,0:12:05.43,0:12:06.51,Default,,0,0,0,,Көбірек шоғырланыңыз! Шүкір~!
Dialogue: 0,0:12:06.85,0:12:07.85,Default,,0,0,0,,Концентрат!
Dialogue: 0,0:12:07.93,0:12:09.52,Default,,0,0,0,,Айтпастан істеп жатырмын!
Dialogue: 0,0:12:09.72,0:12:11.77,Default,,0,0,0,,Мен мұны істей алмайтындықтан айтып отырмын.
Dialogue: 0,0:12:11.85,0:12:13.77,Default,,0,0,0,,Не! (Ранджиро) Бұл не?
Dialogue: 0,0:12:13.94,0:12:15.19,Default,,0,0,0,,Ұрысуға болмайды!
Dialogue: 0,0:12:15.44,0:12:16.61,Default,,0,0,0,,Ұрыс болмайды!
Dialogue: 0,0:12:17.61,0:12:18.86,Default,,0,0,0,,Егер... жақсы.
Dialogue: 0,0:12:19.28,0:12:20.78,Default,,0,0,0,,Жақсы! Тағы бір рет
Dialogue: 0,0:12:21.28,0:12:22.15,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:12:22.45,0:12:25.16,Default,,0,0,0,,Уау! Шоғырлан! Шоғырлан!
Dialogue: 0,0:12:25.95,0:12:28.03,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:12:28.45,0:12:29.95,Default,,0,0,0,,(Шығанақ шығаратын дыбыс)
Dialogue: 0,0:12:31.25,0:12:32.16,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:12:32.41,0:12:35.17,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:12:38.63,0:12:39.67,Default,,0,0,0,,Тағы да
Dialogue: 0,0:12:40.13,0:12:42.30,Default,,0,0,0,,Бүгінгі күн деп атаған дұрыс.
Dialogue: 0,0:12:42.38,0:12:43.67,Default,,0,0,0,,Мен сені екеуіңді де жақсы көремін, сондықтан оны өзім бергім келеді.
Dialogue: 0,0:12:43.76,0:12:45.59,Default,,0,0,0,,Мені Айғаның дене күші алаңдатады.
Dialogue: 0,0:12:46.09,0:12:48.22,Default,,0,0,0,,Бұндай ештеңе жоқ.
Dialogue: 0,0:12:48.72,0:12:50.72,Default,,0,0,0,,Тіпті шоғырланудың да шегі бар.
Dialogue: 0,0:12:50.93,0:12:52.98,Default,,0,0,0,,Мен мұны әлі істей аламын!
Dialogue: 0,0:12:53.43,0:12:54.31,Default,,0,0,0,,Сіз Титантардың бір-бірімен шайқасып жатқанын айтасыз ба?
Dialogue: 0,0:12:54.73,0:12:57.81,Default,,0,0,0,,Сіз бұл супер Zetsubei қолданбасын пайдаланудың қажеті жоқ.
Dialogue: 0,0:12:58.86,0:13:01.98,Default,,0,0,0,,Мен жеңілуге ​​шыдай алмаймын!
Dialogue: 0,0:13:02.28,0:13:05.36,Default,,0,0,0,,Уф... денеңізді демалу да маңызды.
Dialogue: 0,0:13:05.74,0:13:09.37,Default,,0,0,0,,Сен... Луи сенің қарсыласың болғандықтан тым қобалжып тұрсың.
Dialogue: 0,0:13:09.74,0:13:10.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:11.16,0:13:13.54,Default,,0,0,0,,Жеңілу туралы ойламаңыз.
Dialogue: 0,0:13:13.66,0:13:15.66,Default,,0,0,0,,Алға ұмтылудан басқа амалымыз жоқ!
Dialogue: 0,0:13:15.87,0:13:18.13,Default,,0,0,0,,Қызыл жүз Айга сияқты шайқас!
Dialogue: 0,0:13:18.50,0:13:19.84,Default,,0,0,0,,Мен сияқтысыз ба?
Dialogue: 0,0:13:20.92,0:13:23.38,Default,,0,0,0,,Күн батады, бітті
Dialogue: 0,0:13:25.26,0:13:26.88,Default,,0,0,0,,Олай болса, соңғы рет.
Dialogue: 0,0:13:28.68,0:13:29.85,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:30.39,0:13:31.89,Default,,0,0,0,,Ол маған мотоцикл мен соққан көлік туралы уайымдама, тек қайта кел деп айтты.
Dialogue: 0,0:13:32.26,0:13:33.39,Default,,0,0,0,,Олай болса, кеттік.
Dialogue: 0,0:13:35.60,0:13:36.85,Default,,0,0,0,,Дәл мен сияқты...
Dialogue: 0,0:13:44.11,0:13:46.15,Default,,0,0,0,,(Ахиллестің айқайы)
Dialogue: 0,0:13:46.57,0:13:48.41,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:13:48.99,0:13:51.99,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:13:52.45,0:13:54.75,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:55.04,0:13:56.00,Default,,0,0,0,,♬~
Dialogue: 0,0:14:02.71,0:14:05.26,Default,,0,0,0,,Не! Жылдамдығы бұрынғысынан басқаша
Dialogue: 0,0:14:05.80,0:14:09.43,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл менмін!
Dialogue: 0,0:14:12.47,0:14:13.35,Default,,0,0,0,,Не!
Dialogue: 0,0:14:19.69,0:14:20.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:20.90,0:14:23.27,Default,,0,0,0,,Өте өкінішті! Бұл сәл артық болды
Dialogue: 0,0:14:23.57,0:14:24.94,Default,,0,0,0,,Қарғыс атсын... (Ранджиро) А...
Dialogue: 0,0:14:25.11,0:14:26.74,Default,,0,0,0,,А-а... (Ранджиро) Иә? Эй!
Dialogue: 0,0:14:26.82,0:14:27.78,Default,,0,0,0,,Айга?
Dialogue: 0,0:14:28.07,0:14:30.78,Default,,0,0,0,,Амансың ба? Ха ха ха...
Dialogue: 0,0:14:31.03,0:14:34.12,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:14:35.62,0:14:36.79,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:14:39.29,0:14:40.25,Default,,0,0,0,,Иә
Dialogue: 0,0:14:40.58,0:14:44.00,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:14:45.80,0:14:48.88,Default,,0,0,0,,Мен саған көп көңіл бөлемін.
Dialogue: 0,0:14:48.97,0:14:50.09,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:14:51.14,0:14:53.76,Default,,0,0,0,,
Dialogue: 0,0:15:00.23,0:15:01.27,Default,,0,0,0,,Кез келген адам жақсы.
Dialogue: 0,0:15:01.52,0:15:04.06,Default,,0,0,0,,Мені жеңсең, жеңесің.
Dialogue: 0,0:15:04.19,0:15:05.40,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:15:05.65,0:15:06.48,Default,,0,0,0,,Иә
Dialogue: 0,0:15:06.69,0:15:09.90,Default,,0,0,0,,Жаңбырдың қаны, Лонгинус!
Dialogue: 0,0:15:10.24,0:15:14.45,Default,,0,0,0,,Бүгінгі ойын аяқталды хахахаха!
Dialogue: 0,0:15:23.96,0:15:26.75,Default,,0,0,0,,Мен міндетті түрде жеңемін
Dialogue: 0,0:15:28.09,0:15:33.30,Default,,0,0,0,,(өткізу орнындағы шу)
Dialogue: 0,0:15:33.72,0:15:36.06,Default,,0,0,0,,Папа! Анашым! (Қызыл жүзді тайга) Иә?
Dialogue: 0,0:15:36.31,0:15:38.56,Default,,0,0,0,,Сәлем! Міне, міне~
Dialogue: 0,0:15:39.52,0:15:41.27,Default,,0,0,0,,Нару, сен жақсы көрінесің.
Dialogue: 0,0:15:41.35,0:15:44.15,Default,,0,0,0,,Иә! Айганың жағдайы әдеттегідей жақсы.
Dialogue: 0,0:15:44.23,0:15:46.40,Default,,0,0,0,,Мен сол қыздың шайқасын асыға күтемін.
Dialogue: 0,0:15:46.65,0:15:48.82,Default,,0,0,0,,Біз жақын арада осында боламыз...
Dialogue: 0,0:15:49.36,0:15:51.61,Default,,0,0,0,,Айга керемет~
Dialogue: 0,0:15:51.74,0:15:53.95,Default,,0,0,0,,Ұлымыз күткендей.
Dialogue: 0,0:15:54.03,0:15:55.99,Default,,0,0,0,,Ах, дұрыс.
Dialogue: 0,0:15:56.41,0:15:59.12,Default,,0,0,0,,Жарайды! ұлдар мен қыздар
Dialogue: 0,0:15:59.20,0:16:02.71,Default,,0,0,0,,Ақырында көптен күткен шайқас басталады!
Dialogue: 0,0:16:02.79,0:16:05.33,Default,,0,0,0,,Лонгинус кубогының иегері Айга Акаба...
Dialogue: 0,0:16:05.71,0:16:08.38,Default,,0,0,0,,«Ақ тиран» Ширасагижоруиді шақыр
Dialogue: 0,0:16:08.67,0:16:11.34,Default,,0,0,0,,Қызыл жүз Айга Алып жұлдыз құлай ма?
Dialogue: 0,0:16:14.30,0:16:17.97,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:16:18.18,0:16:19.47,Default,,0,0,0,,Ширасаги сарайы Луис
Dialogue: 0,0:16:19.97,0:16:21.48,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:16:21.93,0:16:23.98,Default,,0,0,0,,Мен саған кеңес беруге келдім.
Dialogue: 0,0:16:24.35,0:16:27.48,Default,,0,0,0,,Кеңес? Маған бұл керек емес
Dialogue: 0,0:16:28.36,0:16:29.73,Default,,0,0,0,,«Басыңызды бақылаңыз»
Dialogue: 0,0:16:31.15,0:16:32.49,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:32.78,0:16:36.12,Default,,0,0,0,,Омэккидің тағдырын болжау арқылы ашты
Dialogue: 0,0:16:36.53,0:16:40.74,Default,,0,0,0,,Хехе... хахахаха!
Dialogue: 0,0:16:40.87,0:16:42.16,Default,,0,0,0,,Қызықты
Dialogue: 0,0:16:42.29,0:16:46.00,Default,,0,0,0,,Онда мен сенің тағдырыңды өзгертемін.
Dialogue: 0,0:16:51.09,0:16:53.63,Default,,0,0,0,,Менің болжамым абсолютті
Dialogue: 0,0:16:54.68,0:16:56.97,Default,,0,0,0,,Келіңіздер! Ақырында -
Dialogue: 0,0:16:57.09,0:17:02.81,Default,,0,0,0,,Ең ыстық екі Блейдер осында!
Dialogue: 0,0:17:04.48,0:17:08.23,Default,,0,0,0,,Біріншіден, Жаңа Жұлдыз өзінің орасан зор алға жылжуын жалғастыруда
Dialogue: 0,0:17:08.36,0:17:11.15,Default,,0,0,0,,Тоймайтын жұлдыз, Қызыл жүз Айға!
Dialogue: 0,0:17:11.23,0:17:12.15,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:12.61,0:17:14.15,Default,,0,0,0,,Оны жең!
Dialogue: 0,0:17:14.24,0:17:16.16,Default,,0,0,0,,Айга! Бұл шоғырлану
Dialogue: 0,0:17:16.66,0:17:19.83,Default,,0,0,0,,Әлем чемпионы Барто Аоимен
Dialogue: 0,0:17:19.91,0:17:22.87,Default,,0,0,0,,Біз көптеген кескілескен шайқастарды өткіздік.
Dialogue: 0,0:17:22.95,0:17:27.17,Default,,0,0,0,,«Ақ тиран» Ширасаги сарайы Руи!
Dialogue: 0,0:17:27.25,0:17:29.21,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:29.33,0:17:35.67,Default,,0,0,0,,Көптен күткен шайқас ақыры басталады!
Dialogue: 0,0:17:36.59,0:17:39.68,Default,,0,0,0,,Менің ойымша, сен мені көңіл көтеруге дайынсың.
Dialogue: 0,0:17:40.26,0:17:43.18,Default,,0,0,0,,А, бүгін мен сені міндетті түрде құртамын.
Dialogue: 0,0:17:43.72,0:17:45.77,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:17:45.93,0:17:49.06,Default,,0,0,0,,Енді үлкен мәміле жасайтын уақыт.
Dialogue: 0,0:17:49.44,0:17:52.73,Default,,0,0,0,,Әй, бұл ақымақ күлкінің уақыты келді.
Dialogue: 0,0:17:52.82,0:17:53.69,Default,,0,0,0,,Иә
Dialogue: 0,0:17:55.53,0:17:57.36,Default,,0,0,0,,Айга керемет!
Dialogue: 0,0:17:57.45,0:17:59.32,Default,,0,0,0,,Ол қыз міндетті түрде жеңеді.
Dialogue: 0,0:17:59.57,0:18:00.45,Default,,0,0,0,,О
Dialogue: 0,0:18:01.08,0:18:04.83,Default,,0,0,0,,Маған қанша өскеніңізді көрсетіңіз
Dialogue: 0,0:18:05.58,0:18:09.33,Default,,0,0,0,,Ширасаги сарайы Руи Әдеттегідей ұлы рух
Dialogue: 0,0:18:09.42,0:18:11.71,Default,,0,0,0,,Бірақ Айға да жеңілген жоқ.
Dialogue: 0,0:18:11.79,0:18:12.59,Default,,0,0,0,,О
Dialogue: 0,0:18:14.84,0:18:17.51,Default,,0,0,0,,Мен сонда болуым керек еді.
Dialogue: 0,0:18:18.09,0:18:20.09,Default,,0,0,0,,Луи-сан сен сияқты...
Dialogue: 0,0:18:24.56,0:18:28.06,Default,,0,0,0,,Луи «Басыңызды бақылаңыз»
Dialogue: 0,0:18:28.48,0:18:31.56,Default,,0,0,0,,Бұл шайқас 3 ұпай бойынша бірінші болып жеңіске жетеді.
Dialogue: 0,0:18:31.98,0:18:35.15,Default,,0,0,0,,Соңында Ширасаги сарайы Руи мен Қызыл жүз Айга...
Dialogue: 0,0:18:35.23,0:18:37.07,Default,,0,0,0,,Шешуші шайқас басталады.
Dialogue: 0,0:18:37.32,0:18:40.78,Default,,0,0,0,,Ахиллес Мен алдымен осымен барамын.
Dialogue: 0,0:18:43.24,0:18:44.33,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:18:47.20,0:18:49.08,Default,,0,0,0,,(Ахиллестің айқайы)
Dialogue: 0,0:18:49.33,0:18:50.58,Default,,0,0,0,,Хехехе
Dialogue: 0,0:18:50.87,0:18:52.58,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:18:53.13,0:18:56.21,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:56.71,0:18:59.05,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:59.26,0:19:00.30,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:08.31,0:19:09.56,Default,,0,0,0,,О! Керемет!
Dialogue: 0,0:19:09.64,0:19:10.56,Default,,0,0,0,,Z Ахиллес
Dialogue: 0,0:19:10.64,0:19:12.77,Default,,0,0,0,,Биліктегі Қанды Лонгинуспен тең!
Dialogue: 0,0:19:13.36,0:19:15.02,Default,,0,0,0,,Жарайсыңдар! Басыңыз!
Dialogue: 0,0:19:15.27,0:19:17.65,Default,,0,0,0,,Керемет Айга! (Хинацу) Мен бара аламын!
Dialogue: 0,0:19:21.32,0:19:23.41,Default,,0,0,0,,Сіз аздап өскен сияқтысыз.
Dialogue: 0,0:19:23.70,0:19:26.74,Default,,0,0,0,,Бұл аз ғана емес, ол өте жылдам өсті!
Dialogue: 0,0:19:26.83,0:19:28.79,Default,,0,0,0,,Жүр! Ахиллес!
Dialogue: 0,0:19:33.79,0:19:36.46,Default,,0,0,0,,Лонгинусты бұл деңгейде жеңу мүмкін емес.
Dialogue: 0,0:19:36.63,0:19:37.84,Default,,0,0,0,,Жасай бер! longinus
Dialogue: 0,0:19:44.30,0:19:47.60,Default,,0,0,0,,Эй, сен не күтіп тұрғанын көресің!
Dialogue: 0,0:19:47.85,0:19:48.72,Default,,0,0,0,,Не?
Dialogue: 0,0:19:53.77,0:19:57.15,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:19:57.23,0:19:58.32,Default,,0,0,0,,Даа~!
Dialogue: 0,0:19:58.82,0:19:59.65,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:00.78,0:20:02.82,Default,,0,0,0,,Қанды қоңырау
Dialogue: 0,0:20:06.12,0:20:08.95,Default,,0,0,0,,Мен бұрынғыдай шабуылмен қарызымды өтеуге ниеттемін.
Dialogue: 0,0:20:11.87,0:20:14.33,Default,,0,0,0,,♬~
Dialogue: 0,0:20:14.50,0:20:18.13,Default,,0,0,0,,Жүр! Z сүңгу!
Dialogue: 0,0:20:14.50,0:20:18.13,Default,,0,0,0,,(Ахиллестің айқайы)
Dialogue: 0,0:20:21.92,0:20:23.47,Default,,0,0,0,,«Басыңыздан абай болыңыз»
Dialogue: 0,0:20:24.01,0:20:25.76,Default,,0,0,0,,Ол Лонгинус!
Dialogue: 0,0:20:28.35,0:20:30.22,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:20:35.19,0:20:37.44,Default,,0,0,0,,(Ахиллестің ырылдауы)
Dialogue: 0,0:20:38.07,0:20:38.94,Default,,0,0,0,,Оны атамаңыз!
Dialogue: 0,0:20:40.40,0:20:41.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:41.65,0:20:43.74,Default,,0,0,0,,Сіз өз тағдырыңызды шынымен өзгерттіңіз бе?
Dialogue: 0,0:20:48.12,0:20:48.99,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:20:49.33,0:20:51.58,Default,,0,0,0,,Ахиллес тепе-теңдігін жоғалтты!
Dialogue: 0,0:20:52.70,0:20:57.17,Default,,0,0,0,,Айдаһар айқайын бөліп тастаңыз!
Dialogue: 0,0:21:04.09,0:21:05.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:06.93,0:21:09.64,Default,,0,0,0,,Bloody Longinus Burst Finish
Dialogue: 0,0:21:10.10,0:21:12.43,Default,,0,0,0,,Shirasagi Castle Louis үшін 2 ұпай
Dialogue: 0,0:21:12.85,0:21:14.73,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:14.85,0:21:15.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:16.35,0:21:17.27,Default,,0,0,0,,Батырлар дереу қажет!
Dialogue: 0,0:21:18.69,0:21:23.11,Default,,0,0,0,,Көбірек, мені көбірек қызықтырыңыз.
Dialogue: 0,0:21:25.86,0:21:29.12,Default,,0,0,0,,Бұл қандай күшті, ол басқа деңгейде
Dialogue: 0,0:21:29.66,0:21:31.99,Default,,0,0,0,,Тыныс алуым қиындап тұрғандай.
Dialogue: 0,0:21:32.45,0:21:35.41,Default,,0,0,0,,Бұл кісі өлтіру ниеті, иә?
Dialogue: 0,0:21:35.54,0:21:36.50,Default,,0,0,0,,Айга...
Dialogue: 0,0:21:36.96,0:21:41.75,Default,,0,0,0,,Осы қарқынды кісі өлтіру ниеті бар адаммен қалай бетпе-бет келуді жоспарлайсыз?
Dialogue: 0,0:21:42.34,0:21:43.17,Default,,0,0,0,,Айға
Dialogue: 0,0:21:44.17,0:21:45.34,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:21:46.05,0:21:47.76,Default,,0,0,0,,Хехехе
Dialogue: 0,0:21:48.84,0:21:52.85,Default,,0,0,0,,(Луидің қатты күлкісі)
Dialogue: 0,0:21:54.39,0:22:00.40,Default,,0,0,0,,♪~
Dialogue: 0,0:23:16.43,0:23:22.44,Default,,0,0,0,,~♪
Dialogue: 0,0:23:24.94,0:23:27.40,Default,,0,0,0,,Мен Луимен теңесе алмаймын ба?
Dialogue: 0,0:23:27.48,0:23:28.86,Default,,0,0,0,,Жеңіске жетсек ғажайып болар ма еді?
Dialogue: 0,0:23:29.03,0:23:30.53,Default,,0,0,0,,Мұны кім айтады?
Dialogue: 0,0:23:31.07,0:23:32.66,Default,,0,0,0,,Жасайық, Ахиллес.
Dialogue: 0,0:23:33.03,0:23:34.91,Default,,0,0,0,,Мен Омеге сенемін
Dialogue: 0,0:23:35.12,0:23:38.16,Default,,0,0,0,,Жарайды! Кеттік, Ширасаги сарайы Луис!
Dialogue: 0,0:23:38.83,0:23:40.91,Default,,0,0,0,,Келесі жолы «Beyblade Burst Super Zetsu»
Dialogue: 0,0:23:41.50,0:23:43.00,Default,,0,0,0,,«Луиді жеңіңіз!»
Dialogue: 0,0:23:43.08,0:23:45.00,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:45.09,0:23:46.96,Default,,0,0,0,,Бар, ат!
