Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.92,0:00:06.29,Default,,0,0,0,,Жауынгерлік кеме круизі!
Dialogue: 0,0:00:06.42,0:00:09.50,Default,,0,0,0,,Біз қазір борттағы Бладерлермен бірге жүземіз.
Dialogue: 0,0:00:13.43,0:00:17.76,Default,,0,0,0,,Сізді супер Цетсудың жарқыраған теңізі күтіп тұр
Dialogue: 0,0:00:17.93,0:00:21.89,Default,,0,0,0,,Алда ең күшті және жеңілмейтін атақ күтіп тұр.
Dialogue: 0,0:00:22.48,0:00:27.19,Default,,0,0,0,,Жүр, Бейблейдпен шытырман оқиғаға барайық.
Dialogue: 0,0:00:27.31,0:00:29.94,Default,,0,0,0,,Super Zetsu-дан басқа!
Dialogue: 0,0:00:31.99,0:00:34.95,Default,,0,0,0,,Бұл New York Bulls жаттығу залы.
Dialogue: 0,0:00:35.24,0:00:36.70,Default,,0,0,0,,О~
Dialogue: 0,0:00:36.87,0:00:39.37,Default,,0,0,0,,Ол мұны керемет жерде істеп жатыр.
Dialogue: 0,0:00:40.49,0:00:42.95,Default,,0,0,0,,Бей патшайымы Нью-Йоркте тоқтады...
Dialogue: 0,0:00:43.04,0:00:46.12,Default,,0,0,0,,Біз Фубукиді біраз уақыттан кейін бірінші рет кездестірдік.
Dialogue: 0,0:00:46.96,0:00:49.04,Default,,0,0,0,,Дайын!
Dialogue: 0,0:00:49.13,0:00:51.21,Default,,0,0,0,,Иә! Ха! (Ранджиро Кияма) Ой...
Dialogue: 0,0:00:51.67,0:00:53.01,Default,,0,0,0,,Уау... (Тобисуке) Фубуки, тезірек.
Dialogue: 0,0:00:53.92,0:00:55.38,Default,,0,0,0,,Аңызға айналған Блейдер
Dialogue: 0,0:00:55.47,0:00:57.55,Default,,0,0,0,,Бенишудың шәкірті болған Фубуки...
Dialogue: 0,0:00:58.09,0:01:00.14,Default,,0,0,0,,Сеніммен жарқырайды
Dialogue: 0,0:01:00.72,0:01:01.64,Default,,0,0,0,,Ал не!
Dialogue: 0,0:01:02.47,0:01:06.85,Default,,0,0,0,,Міне, соңғы жүзік бортқа келеді.
Dialogue: 0,0:01:08.52,0:01:12.15,Default,,0,0,0,,Нью-Йорк Буллс суперновасы Фубуки Суми!
Dialogue: 0,0:01:13.28,0:01:14.94,Default,,0,0,0,,9-шы жүзші ретінде-
Dialogue: 0,0:01:15.03,0:01:17.45,Default,,0,0,0,,Мен жауынгерлік кемеге бардым.
Dialogue: 0,0:01:17.66,0:01:20.28,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:01:20.58,0:01:21.58,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:01:25.58,0:01:26.87,Default,,0,0,0,,Жою.
Dialogue: 0,0:01:39.97,0:01:41.43,Default,,0,0,0,,Мен сені құртамын!
Dialogue: 0,0:01:42.18,0:01:44.06,Default,,0,0,0,,Фениксті жеңетін менмін.
Dialogue: 0,0:01:51.06,0:01:51.94,Default,,0,0,0,,Не!
Dialogue: 0,0:01:52.77,0:01:54.07,Default,,0,0,0,,Battle Royale ойынында
Dialogue: 0,0:01:54.15,0:01:56.40,Default,,0,0,0,,Мен де, Фубуки де Файдан жеңілді...
Dialogue: 0,0:01:56.90,0:01:58.57,Default,,0,0,0,,Енді шайқас басталады!
Dialogue: 0,0:01:58.66,0:02:01.74,Default,,0,0,0,,Біз қайтып ораламыз және жеңеміз!
Dialogue: 0,0:02:03.45,0:02:09.46,Default,,0,0,0,,♪~
Dialogue: 0,0:03:26.70,0:03:32.71,Default,,0,0,0,,~♪
Dialogue: 0,0:03:33.63,0:03:36.13,Default,,0,0,0,,"Бірлескен күрес! ​​Тег шайқасы!!"
Dialogue: 0,0:03:41.22,0:03:43.55,Default,,0,0,0,,Сәлеметсіздер ме, пышақшылар!
Dialogue: 0,0:03:44.22,0:03:46.68,Default,,0,0,0,,Келесі сынақ шайқасы - тег шайқасы.
Dialogue: 0,0:03:47.22,0:03:50.10,Default,,0,0,0,,Бұл тағы бір тег шайқасы. Мен бұл жолы жеңілмеймін.
Dialogue: 0,0:03:50.18,0:03:52.27,Default,,0,0,0,,Айғаның өзі қолынан келгенін жасаса да.
Dialogue: 0,0:03:52.35,0:03:52.94,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:53.39,0:03:56.94,Default,,0,0,0,,Екі адам бірге жұмыс істемейінше, тег шайқасында жеңе алмайсыз.
Dialogue: 0,0:03:57.07,0:03:59.19,Default,,0,0,0,,Мәселе кіммен серіктес болғаныңызда.
Dialogue: 0,0:03:59.69,0:04:01.28,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:04:01.78,0:04:05.28,Default,,0,0,0,,Енді мен командалық комбинацияларды жариялаймын.
Dialogue: 0,0:04:05.41,0:04:06.62,Default,,0,0,0,,Қолымды жазып бергенімдегі жақсылығымды ұмытып қалдың ба…
Dialogue: 0,0:04:06.74,0:04:09.29,Default,,0,0,0,,Қызыл жүз Айга және Суми Фубуки
Dialogue: 0,0:04:09.70,0:04:11.50,Default,,0,0,0,,О, сен Фубукимен біргесің бе?
Dialogue: 0,0:04:11.83,0:04:16.75,Default,,0,0,0,,Келесі... Гошуин Суу және Кияма Ранжиро
Dialogue: 0,0:04:17.29,0:04:18.54,Default,,0,0,0,,Сол жігітпен...
Dialogue: 0,0:04:19.34,0:04:21.80,Default,,0,0,0,,Жан Богард және Кайл Хаким
Dialogue: 0,0:04:23.55,0:04:25.22,Default,,0,0,0,,Мен сенімен тағы да бірлесе аламын ба?
Dialogue: 0,0:04:25.30,0:04:26.43,Default,,0,0,0,,Бұл мүлде ақау…
Dialogue: 0,0:04:26.80,0:04:31.64,Default,,0,0,0,,Соңында Лабан Вано мен Оу Хоуи.
Dialogue: 0,0:04:32.27,0:04:35.73,Default,,0,0,0,,Сонымен қатар, соңғы Батл Роялда жеңіске жеткен Фи...
Dialogue: 0,0:04:35.81,0:04:37.98,Default,,0,0,0,,Бұл жолы қоштасу болады.
Dialogue: 0,0:04:43.90,0:04:44.74,Default,,0,0,0,,Иә
Dialogue: 0,0:04:45.91,0:04:47.24,Default,,0,0,0,,О, Фубуки!
Dialogue: 0,0:04:47.53,0:04:49.70,Default,,0,0,0,,Бірінші ойын...
Dialogue: 0,0:04:49.91,0:04:52.58,Default,,0,0,0,,Жан Богард Кайл Хаким командасы VS
Dialogue: 0,0:04:52.66,0:04:55.33,Default,,0,0,0,,Гошуин Суоу Кизан Ранжиро командасы
Dialogue: 0,0:04:55.42,0:04:56.87,Default,,0,0,0,,Ал екінші ойын
Dialogue: 0,0:04:56.96,0:04:59.38,Default,,0,0,0,,Red Blade Aiga Sumie Fubuki Team VS
Dialogue: 0,0:04:59.46,0:05:01.92,Default,,0,0,0,,Лабан Вано Оу Хой командасы
Dialogue: 0,0:05:02.01,0:05:04.88,Default,,0,0,0,,Бұл жекпе-жек те ұпайларды шегеретін жүйе болып табылады.
Dialogue: 0,0:05:05.01,0:05:08.18,Default,,0,0,0,,Жеңілген команда бір Baystar алады.
Dialogue: 0,0:05:08.26,0:05:10.76,Default,,0,0,0,,Егер сізде көп жұлдыз қалмаса, бар күшіңізді салыңыз.
Dialogue: 0,0:05:11.14,0:05:12.85,Default,,0,0,0,,Мен туралы айтып тұрсың ба?
Dialogue: 0,0:05:12.93,0:05:15.48,Default,,0,0,0,,Сочо: Суохпен бірігіп жатырсың ба?
Dialogue: 0,0:05:16.02,0:05:17.90,Default,,0,0,0,,Бұл менің шешімім емес еді.
Dialogue: 0,0:05:17.98,0:05:19.61,Default,,0,0,0,,Аздап көңіл көтергіңіз келе ме?
Dialogue: 0,0:05:19.73,0:05:20.61,Default,,0,0,0,,Йосе
Dialogue: 0,0:05:21.40,0:05:25.70,Default,,0,0,0,,Жете алмасақ та, жеңу үшін бірге жұмыс істеуден басқа амалымыз жоқ.
Dialogue: 0,0:05:26.03,0:05:27.36,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:05:28.66,0:05:31.49,Default,,0,0,0,,Бірлессек, Цетсу ең күшті және жеңілмейтін болады!
Dialogue: 0,0:05:31.58,0:05:32.45,Default,,0,0,0,,О
Dialogue: 0,0:05:33.12,0:05:36.25,Default,,0,0,0,,Не, саған менімен топтасу ұнамайды ма?
Dialogue: 0,0:05:36.37,0:05:38.54,Default,,0,0,0,,Жоқ, бұл жай ғана...
Dialogue: 0,0:05:38.62,0:05:42.92,Default,,0,0,0,,Мен жауынгерлік роялда жеңілген Фай алдындағы қарызымды өтегім келді.
Dialogue: 0,0:05:44.26,0:05:47.68,Default,,0,0,0,,Келесі жолы мен оның жұлдызын міндетті түрде алып тастаймын.
Dialogue: 0,0:05:48.51,0:05:52.51,Default,,0,0,0,,Кішкентай ханзада, екі рет топтасу үлкен мәртебе.
Dialogue: 0,0:05:52.60,0:05:53.64,Default,,0,0,0,,Сені ұрып-соғып тастауға тура келуі – нағыз азап қой—
Dialogue: 0,0:05:53.72,0:05:55.06,Default,,0,0,0,,Сені ұрып-соғып тастауға тура келуі – нағыз азап қой—
Dialogue: 0,0:05:55.77,0:05:59.27,Default,,0,0,0,,Мен сені жек көремін. Саған бірдеңе дұрыс емес.
Dialogue: 0,0:05:59.60,0:06:02.98,Default,,0,0,0,,Соған қарамастан біз соңғы рет жеңіске жеттік.
Dialogue: 0,0:06:03.19,0:06:05.74,Default,,0,0,0,,Менің ойымша, олар жақсы сәйкестік.
Dialogue: 0,0:06:06.28,0:06:07.82,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:06:08.03,0:06:10.91,Default,,0,0,0,,Бірақ мен сенің бақытты екеніңді мойындаймын.
Dialogue: 0,0:06:11.07,0:06:13.12,Default,,0,0,0,,Менімен екі рет команда құра аласыз.
Dialogue: 0,0:06:13.49,0:06:16.00,Default,,0,0,0,,Мен ризамын және бақыттымын.
Dialogue: 0,0:06:16.45,0:06:19.58,Default,,0,0,0,,Менің артымнан жүр фуфуфу иә
Dialogue: 0,0:06:22.21,0:06:26.55,Default,,0,0,0,,«Сақ болыңдар, қараңғылықтан тағы біреуі шығады».
Dialogue: 0,0:06:26.63,0:06:28.09,Default,,0,0,0,,​​О?
Dialogue: 0,0:06:29.09,0:06:30.93,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:31.89,0:06:34.47,Default,,0,0,0,,Менің уақытым жоқ. Маған бірден жаттығу керек.
Dialogue: 0,0:06:34.60,0:06:36.72,Default,,0,0,0,,Күте тұрыңыз, мынаны қараңыз.
Dialogue: 0,0:06:37.14,0:06:38.56,Default,,0,0,0,,Қайтадан болжау?
Dialogue: 0,0:06:39.39,0:06:43.56,Default,,0,0,0,,Онда: «Абайлаңыз, қараңғылықтан басқа біреу шығады» делінген.
Dialogue: 0,0:06:44.07,0:06:45.44,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:45.90,0:06:48.95,Default,,0,0,0,,Бұл кенеттен басқа жаудың пайда болғанын білдіреді.
Dialogue: 0,0:06:50.20,0:06:53.95,Default,,0,0,0,,Мүмкін Омэкки кенеттен жау болып қалар ма?
Dialogue: 0,0:06:54.78,0:06:59.29,Default,,0,0,0,,Мен соңына дейін сенің жаныңда боламын. Маған болжаудан гөрі сеніңіз.
Dialogue: 0,0:06:59.37,0:07:02.42,Default,,0,0,0,,（）
Dialogue: 0,0:07:02.92,0:07:07.09,Default,,0,0,0,,Уа! Омэкки мен жағында, сәуегейлік айтады.
Dialogue: 0,0:07:07.26,0:07:08.26,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:07:08.42,0:07:09.72,Default,,0,0,0,,(шишиодоши дыбысы)
Dialogue: 0,0:07:09.80,0:07:12.01,Default,,0,0,0,,Неліктен Фубуки тағы да...
Dialogue: 0,0:07:14.43,0:07:16.26,Default,,0,0,0,,Шешім қабылданған
Dialogue: 0,0:07:17.14,0:07:19.64,Default,,0,0,0,,Ол зат енді ешқашан гүлдемейді.
Dialogue: 0,0:07:20.94,0:07:22.19,Default,,0,0,0,,Уф, ыстық қой! Демім тарылып барады!
Dialogue: 0,0:07:22.85,0:07:26.32,Default,,0,0,0,,Уф, ыстық қой! Демім тарылып барады!
Dialogue: 0,0:07:27.32,0:07:28.19,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:07:28.69,0:07:31.82,Default,,0,0,0,,Эй Суо, бірге жаттығу жасайық.
Dialogue: 0,0:07:34.28,0:07:36.99,Default,,0,0,0,,Бұл тег шайқасы. Екі адаммен жаттығу жасаған дұрыс...
Dialogue: 0,0:07:37.08,0:07:39.54,Default,,0,0,0,,Мұның қажеті жоқ (Ранджиро) Ой?
Dialogue: 0,0:07:40.12,0:07:42.12,Default,,0,0,0,,Қарсыластар – Жан мен Кайл.
Dialogue: 0,0:07:42.33,0:07:45.79,Default,,0,0,0,,Мен Экскалибурды да, Кербеусты да жеңе аламын.
Dialogue: 0,0:07:46.29,0:07:48.30,Default,,0,0,0,,Сізге кедергі болмайынша (Ранджиро) Ух...
Dialogue: 0,0:07:48.42,0:07:49.59,Default,,0,0,0,,Не?
Dialogue: 0,0:07:50.26,0:07:51.92,Default,,0,0,0,,Олай болса... (электронды дыбыс)
Dialogue: 0,0:07:52.18,0:07:52.76,Default,,0,0,0,,Әй!
Dialogue: 0,0:07:52.93,0:07:55.26,Default,,0,0,0,,Әңгімені жай ғана аяқтамаңыз
Dialogue: 0,0:07:58.76,0:08:01.14,Default,,0,0,0,,Мен мұны әрі қарай талқылағым келмейді.
Dialogue: 0,0:08:01.43,0:08:04.19,Default,,0,0,0,,Егер сіз осында болғыңыз келсе, өз қалауыңыз бойынша жасаңыз.
Dialogue: 0,0:08:04.27,0:08:05.15,Default,,0,0,0,,Уф
Dialogue: 0,0:08:07.11,0:08:10.53,Default,,0,0,0,,Сіз әлгі мыңжапырақ Сочоға мазасызданғандай қарадыңыз.
Dialogue: 0,0:08:10.69,0:08:11.69,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:08:12.49,0:08:16.41,Default,,0,0,0,,Бұл жерде шыдамдылық қажет, бұл тег шайқасы.
Dialogue: 0,0:08:16.95,0:08:20.24,Default,,0,0,0,,Маған оның 100% беруі керек.
Dialogue: 0,0:08:20.33,0:08:23.04,Default,,0,0,0,,Ха, мен жеңетін ойында да жеңе алмаймын.
Dialogue: 0,0:08:26.04,0:08:28.17,Default,,0,0,0,,Маған қалдырыңыз (Тобисуке) Иә?
Dialogue: 0,0:08:28.84,0:08:31.13,Default,,0,0,0,,Менің ойымша, мен Сууды осылай сезіндірсем, жақсы болар еді.
Dialogue: 0,0:08:31.67,0:08:32.92,Default,,0,0,0,,Сіз алмайсыз ба?
Dialogue: 0,0:08:33.01,0:08:35.51,Default,,0,0,0,,Бұл аздап қиын, бірақ мен тырысамын.
Dialogue: 0,0:08:36.22,0:08:37.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:38.10,0:08:40.18,Default,,0,0,0,,Амансың ба? Ол
Dialogue: 0,0:08:53.65,0:08:54.82,Default,,0,0,0,,Суоу…
Dialogue: 0,0:08:56.70,0:08:57.62,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:59.16,0:09:01.24,Default,,0,0,0,,Мен ұмытқан жоқпын.
Dialogue: 0,0:09:01.49,0:09:04.75,Default,,0,0,0,,Ранбей тобына кіргенде не болды?
Dialogue: 0,0:09:07.46,0:09:10.29,Default,,0,0,0,,Бей клубының жігіті не істеді?
Dialogue: 0,0:09:11.59,0:09:15.80,Default,,0,0,0,,Сол жолы жеңісіңді атаған Атай еді.
Dialogue: 0,0:09:21.22,0:09:25.18,Default,,0,0,0,,B... Burst Finish Гошуин Суо жеңді
Dialogue: 0,0:09:25.94,0:09:27.98,Default,,0,0,0,,Мен қатты толқыдым.
Dialogue: 0,0:09:28.31,0:09:32.61,Default,,0,0,0,,Сіз шынымен күштісіз, солай емес пе? Мен қатты толқып тұрмын.
Dialogue: 0,0:09:33.73,0:09:34.57,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:09:35.61,0:09:39.57,Default,,0,0,0,,Егер ол адам болса, мені кісі өлтіру айыбымен айыптайтын еді—
Dialogue: 0,0:09:41.70,0:09:47.04,Default,,0,0,0,,Мен сізді қолдаймын, сондықтан тег шайқасында бар күшіңізді салыңыз.
Dialogue: 0,0:09:49.58,0:09:53.13,Default,,0,0,0,,Кіммен біріксеңіз де, тег шайқасында әрқашан жеңесіз.
Dialogue: 0,0:09:53.21,0:09:54.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:54.67,0:09:57.76,Default,,0,0,0,,Олай болса мен сенен бір нәрсе сұрасам болады ма?
Dialogue: 0,0:09:59.01,0:10:01.43,Default,,0,0,0,,О... өтінемін?
Dialogue: 0,0:10:01.97,0:10:04.35,Default,,0,0,0,,Енді маған жақындама!
Dialogue: 0,0:10:05.18,0:10:07.27,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:10:10.10,0:10:12.48,Default,,0,0,0,,Жынды болма, Барса!
Dialogue: 0,0:10:13.94,0:10:15.36,Default,,0,0,0,,Бұл жарылыс жоғалту.
Dialogue: 0,0:10:28.12,0:10:31.67,Default,,0,0,0,,Күшті болдың, Айға.
Dialogue: 0,0:10:35.17,0:10:37.84,Default,,0,0,0,,Сіз өзіңіздің қабілеттеріңізді түсінбейсіз бе?
Dialogue: 0,0:10:38.17,0:10:38.80,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:39.34,0:10:41.43,Default,,0,0,0,,Мен оны батл-роялда көрдім...
Dialogue: 0,0:10:42.14,0:10:43.68,Default,,0,0,0,,Ахиллестің жарқырауын қараңыз
Dialogue: 0,0:10:46.77,0:10:48.06,Default,,0,0,0,,Ахиллес?
Dialogue: 0,0:10:48.39,0:10:51.44,Default,,0,0,0,,Бұл сізге резонанс тудырды дегенді білдірмейді ме?
Dialogue: 0,0:10:51.52,0:10:52.77,Default,,0,0,0,,Резонанс?
Dialogue: 0,0:10:52.86,0:10:54.44,Default,,0,0,0,,Сіз бұл туралы ешқашан естімегенсіз бе?
Dialogue: 0,0:10:55.78,0:10:57.07,Default,,0,0,0,,Айтып тұрғасын...
Dialogue: 0,0:10:57.78,0:10:59.49,Default,,0,0,0,,Фаи да дәл осылай деді.
Dialogue: 0,0:10:59.86,0:11:01.36,Default,,0,0,0,,Кираның қамауға алынуына әкеледі
Dialogue: 0,0:11:01.74,0:11:03.32,Default,,0,0,0,,Резонанс дегеніміз не?
Dialogue: 0,0:11:05.16,0:11:07.83,Default,,0,0,0,,Уақытыңды босқа өткізбей, маған айт, Фубуки.
Dialogue: 0,0:11:08.54,0:11:10.46,Default,,0,0,0,,Шу мырзадан естігенім осы.
Dialogue: 0,0:11:10.54,0:11:12.00,Default,,0,0,0,,Резонанс дегеніміз...
Dialogue: 0,0:11:12.08,0:11:15.09,Default,,0,0,0,,Бидің күшін барынша шығаратын сияқты.
Dialogue: 0,0:11:15.54,0:11:17.00,Default,,0,0,0,,Иә, шынымен бе?
Dialogue: 0,0:11:17.55,0:11:20.42,Default,,0,0,0,,Сізде ондай күш жоқ па?
Dialogue: 0,0:11:21.30,0:11:22.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:22.84,0:11:24.22,Default,,0,0,0,,Резонанс?
Dialogue: 0,0:11:31.27,0:11:32.85,Default,,0,0,0,,(Іштік дыбыс)
Dialogue: 0,0:11:35.06,0:11:35.98,Default,,0,0,0,,Мынау не? Менің Қорекқұмарлық Жаным (Шексіз Жұтым)
Dialogue: 0,0:11:36.40,0:11:37.65,Default,,0,0,0,,Хоуи
Dialogue: 0,0:11:37.73,0:11:40.49,Default,,0,0,0,,Стратегия ойлап тапқан дұрыс емес пе?
Dialogue: 0,0:11:40.61,0:11:42.49,Default,,0,0,0,,Мен Айғамен жарысамын
Dialogue: 0,0:11:42.91,0:11:43.82,Default,,0,0,0,,Мен ше?
Dialogue: 0,0:11:44.74,0:11:46.53,Default,,0,0,0,,Фубукимен айналысу керек.
Dialogue: 0,0:11:46.95,0:11:50.29,Default,,0,0,0,,Айғаны жеңсем, мен саған көмектесемін.
Dialogue: 0,0:11:50.79,0:11:54.67,Default,,0,0,0,,Бірақ мен алдымен Фубукиді жеңетініме сенімдімін.
Dialogue: 0,0:11:54.96,0:11:56.88,Default,,0,0,0,,Олай болса мен саған бірдеңе беремін...
Dialogue: 0,0:11:58.55,0:12:00.80,Default,,0,0,0,,Маған тиіспе, иә?
Dialogue: 0,0:12:01.55,0:12:03.97,Default,,0,0,0,,Айға екеуміздің ұрысқа араласпаңдар.
Dialogue: 0,0:12:04.30,0:12:06.30,Default,,0,0,0,,Мен Айғаны жеңемін.
Dialogue: 0,0:12:07.01,0:12:10.31,Default,,0,0,0,,Хаа... бұл керемет көрінеді, омэкчи
Dialogue: 0,0:12:10.85,0:12:14.06,Default,,0,0,0,,Үш есе әсер ету! (соққы дыбысы)
Dialogue: 0,0:12:15.81,0:12:17.15,Default,,0,0,0,,Бұл туралы айтудың қажеті жоқ
Dialogue: 0,0:12:17.36,0:12:19.23,Default,,0,0,0,,Демек, сіз барынша тырысып жатырсыз ба?
Dialogue: 0,0:12:19.48,0:12:22.11,Default,,0,0,0,,Ханзада тым күшті.
Dialogue: 0,0:12:22.19,0:12:26.03,Default,,0,0,0,,Хахаха мен мұны басынан білдім.
Dialogue: 0,0:12:26.70,0:12:29.37,Default,,0,0,0,,Бірақ менің күшім ондай емес.
Dialogue: 0,0:12:29.79,0:12:31.08,Default,,0,0,0,,Тег шайқасында-
Dialogue: 0,0:12:31.16,0:12:33.87,Default,,0,0,0,,Мен саған ерекше қимыл көрсетемін, ол сенің санаңды елең еткізеді.
Dialogue: 0,0:12:34.29,0:12:36.50,Default,,0,0,0,,Күшпен әсер ету?
Dialogue: 0,0:12:36.58,0:12:40.21,Default,,0,0,0,,Ақымақ! Күшпен әсер ету - бұл жай ғана өту нүктесі.
Dialogue: 0,0:12:40.96,0:12:43.72,Default,,0,0,0,,Excalibur әлі де даму үстінде.
Dialogue: 0,0:12:44.63,0:12:46.30,Default,,0,0,0,,Оны асыға күтіңіз
Dialogue: 0,0:12:47.09,0:12:50.93,Default,,0,0,0,,Маған дәл қазір сол техниканы көрсете аласыз ба?
Dialogue: 0,0:12:51.47,0:12:54.81,Default,,0,0,0,,Ашкөз жігіт, оны шынымен көргің келе ме?
Dialogue: 0,0:12:54.98,0:12:56.48,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:12:56.65,0:12:58.86,Default,,0,0,0,,Күш әсерінен асатын арнайы қозғалыс
Dialogue: 0,0:12:59.11,0:13:02.11,Default,,0,0,0,,Өтінемін, менің Cerbeus сенің серіктесің болсын.
Dialogue: 0,0:13:02.32,0:13:04.61,Default,,0,0,0,,Жарайды, ол туралы ше?
Dialogue: 0,0:13:05.49,0:13:06.95,Default,,0,0,0,,Бұл қанжар жақтау.
Dialogue: 0,0:13:08.03,0:13:09.62,Default,,0,0,0,,Қанжар жақтауы?
Dialogue: 0,0:13:13.08,0:13:14.29,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:13:15.29,0:13:17.17,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:13:17.92,0:13:18.92,Default,,0,0,0,,Хо
Dialogue: 0,0:13:20.88,0:13:24.92,Default,,0,0,0,,Бұл Бесінші әсердің жаңа арнайы қозғалысы.
Dialogue: 0,0:13:25.30,0:13:28.68,Default,,0,0,0,,Қылыштың бір соққысымен барлық шығанақтарды еніп, жойыңыз.
Dialogue: 0,0:13:28.89,0:13:31.56,Default,,0,0,0,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:13:31.64,0:13:33.64,Default,,0,0,0,,Бесінші әсер…
Dialogue: 0,0:13:34.23,0:13:38.52,Default,,0,0,0,,Бұл жігіт сөзсіз керемет, хехе...
Dialogue: 0,0:13:41.19,0:13:44.82,Default,,0,0,0,,Еееееей ұлдар қыздарды аяқтайды
Dialogue: 0,0:13:44.94,0:13:48.36,Default,,0,0,0,,Әлемнің түкпір-түкпірінен келген жүзшілер бір жерге жиналды ма?
Dialogue: 0,0:13:49.20,0:13:52.16,Default,,0,0,0,,Жарайды, бүгін тағы да Бей патшайымынан...
Dialogue: 0,0:13:52.24,0:13:55.37,Default,,0,0,0,,Біз сізге өмір сүру үшін күрделі шайқас әкелеміз.
Dialogue: 0,0:13:55.58,0:13:58.58,Default,,0,0,0,,Бүгін Super Zetsu стадионындағы шайқас.
Dialogue: 0,0:13:58.67,0:14:02.00,Default,,0,0,0,,Өзіңіздің күш-қуатыңызды көңіліңізден шыққанша көрсетіңіз.
Dialogue: 0,0:14:02.25,0:14:05.42,Default,,0,0,0,,Қызықты тег шайқасын жіберіп алмаңыз
Dialogue: 0,0:14:05.51,0:14:07.63,Default,,0,0,0,,Таң сағындым!
Dialogue: 0,0:14:07.97,0:14:11.14,Default,,0,0,0,,Уау! Фубуки-сенпай Айгамен бірігіп келеді.
Dialogue: 0,0:14:11.22,0:14:12.51,Default,,0,0,0,,Сәттілік капитан
Dialogue: 0,0:14:12.97,0:14:15.14,Default,,0,0,0,,Сочо Суохпен біріге ме?
Dialogue: 0,0:14:15.22,0:14:16.60,Default,,0,0,0,,Аа.
Dialogue: 0,0:14:16.68,0:14:18.77,Default,,0,0,0,,Сочо жақсы.
Dialogue: 0,0:14:19.56,0:14:23.57,Default,,0,0,0,,Бірінші ойын Жан Богард-Кайл Хаким командасына қарсы болды.
Dialogue: 0,0:14:23.69,0:14:27.28,Default,,0,0,0,,Ранжиро Кияма Бұл Гошуин Сух командасының қақтығысы.
Dialogue: 0,0:14:27.70,0:14:29.20,Default,,0,0,0,,Сочоға сәттілік!
Dialogue: 0,0:14:29.28,0:14:30.87,Default,,0,0,0,,Суохты үрлеп жіберіңізші.
Dialogue: 0,0:14:30.95,0:14:31.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:32.32,0:14:35.24,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Суо біз жақта.
Dialogue: 0,0:14:35.33,0:14:37.04,Default,,0,0,0,,Мен сенің жауыңмын
Dialogue: 0,0:14:37.12,0:14:39.42,Default,,0,0,0,,Хаа~ Бұл өте маңызды.
Dialogue: 0,0:14:42.42,0:14:43.29,Default,,0,0,0,,Иә
Dialogue: 0,0:14:43.79,0:14:45.55,Default,,0,0,0,,Не? Болды
Dialogue: 0,0:14:45.71,0:14:50.18,Default,,0,0,0,,Excalibur шабуылдың күшін одан әрі арттырады ма?
Dialogue: 0,0:14:50.80,0:14:51.68,Default,,0,0,0,,Жаман адамдар жоқ, және бұл оның басқа ерліктерімен салыстырғанда біршама қарапайым—
Dialogue: 0,0:14:54.60,0:14:56.18,Default,,0,0,0,,Бұл ойын
Dialogue: 0,0:14:57.18,0:15:00.19,Default,,0,0,0,,Шайқасқа дайын жиынтық тег
Dialogue: 0,0:15:00.73,0:15:03.77,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:15:04.23,0:15:07.40,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:15:14.95,0:15:17.45,Default,,0,0,0,,Желді металл қанаттарымен кесіңіз
Dialogue: 0,0:15:17.79,0:15:20.54,Default,,0,0,0,,Рагнарук тайфуны!
Dialogue: 0,0:15:24.13,0:15:27.80,Default,,0,0,0,,Рагнарк тайфунымен кенеттен қуат жарылуы
Dialogue: 0,0:15:27.88,0:15:29.63,Default,,0,0,0,,Кербеус тойтарыс берді!
Dialogue: 0,0:15:29.80,0:15:32.13,Default,,0,0,0,,О, Сочо!
Dialogue: 0,0:15:32.84,0:15:33.89,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:15:35.85,0:15:37.14,Default,,0,0,0,,Саламандр
Dialogue: 0,0:15:39.48,0:15:41.64,Default,,0,0,0,,Теме Бұл кенеттен болды ма?
Dialogue: 0,0:15:41.73,0:15:43.02,Default,,0,0,0,,Уф… Қолымды қозғалтсам.
Dialogue: 0,0:15:45.81,0:15:47.65,Default,,0,0,0,,А, сен не істеп жатырсың?
Dialogue: 0,0:15:50.19,0:15:51.74,Default,,0,0,0,,Сіз одақтасыңызды ұшырып жібердіңіз.
Dialogue: 0,0:15:51.82,0:15:54.74,Default,,0,0,0,,Ах! Рагнарук дірілдеп тұр!
Dialogue: 0,0:15:55.20,0:15:57.37,Default,,0,0,0,,Excalibur Жолыңызға кедергі келтіретіндерден құтылыңыз
Dialogue: 0,0:16:00.96,0:16:02.29,Default,,0,0,0,,Хехехе… Біраз мақтанып қояйын
Dialogue: 0,0:16:02.50,0:16:04.21,Default,,0,0,0,,Сочо!
Dialogue: 0,0:16:04.42,0:16:07.80,Default,,0,0,0,,Судың ақымақ! Қалағаныңды істеме!
Dialogue: 0,0:16:08.13,0:16:09.76,Default,,0,0,0,,Мен шайқас туралы шешім қабылдаймын
Dialogue: 0,0:16:10.30,0:16:13.51,Default,,0,0,0,,Саламандер Бұл жолы біз Сербеусқа көз тіктік!
Dialogue: 0,0:16:13.59,0:16:15.34,Default,,0,0,0,,Батырдың кезегі
Dialogue: 0,0:16:15.43,0:16:17.43,Default,,0,0,0,,Жүр! экскалибур
Dialogue: 0,0:16:19.01,0:16:20.98,Default,,0,0,0,,Өте қызықты!
Dialogue: 0,0:16:21.06,0:16:24.60,Default,,0,0,0,,Экскалибур шайқасқа ерлікпен кірді!
Dialogue: 0,0:16:28.73,0:16:30.78,Default,,0,0,0,,О! Ол аударылды!
Dialogue: 0,0:16:31.24,0:16:33.03,Default,,0,0,0,,Саламандр!
Dialogue: 0,0:16:41.16,0:16:43.37,Default,,0,0,0,,Excalibur!
Dialogue: 0,0:16:50.21,0:16:53.59,Default,,0,0,0,,Кенран тозақтан құлады!
Dialogue: 0,0:16:55.72,0:16:59.22,Default,,0,0,0,,Бесінші әсер!
Dialogue: 0,0:17:05.64,0:17:05.89,Default,,0,0,0,,О!
Dialogue: 0,0:17:05.89,0:17:06.73,Default,,0,0,0,,О!
Dialogue: 0,0:17:05.89,0:17:06.73,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:17:06.73,0:17:07.27,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:17:10.90,0:17:13.24,Default,,0,0,0,,А, Сәлемендер жарылып жатыр.
Dialogue: 0,0:17:13.94,0:17:18.49,Default,,0,0,0,,Тег шайқасы Жан Богард-Кайл Хаким командасының жеңісі
Dialogue: 0,0:17:18.87,0:17:20.20,Default,,0,0,0,,Не... не?
Dialogue: 0,0:17:20.28,0:17:21.70,Default,,0,0,0,,Бастер Экскалибурдың бесінші әсері
Dialogue: 0,0:17:21.70,0:17:22.79,Default,,0,0,0,,Бастер Экскалибурдың бесінші әсері
Dialogue: 0,0:17:21.70,0:17:22.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:22.79,0:17:23.25,Default,,0,0,0,,Бастер Экскалибурдың бесінші әсері
Dialogue: 0,0:17:23.33,0:17:24.00,Default,,0,0,0,,Орасан зор жойқын күш
Dialogue: 0,0:17:24.00,0:17:25.62,Default,,0,0,0,,Аса жойқын күш.
Dialogue: 0,0:17:24.00,0:17:25.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:25.62,0:17:26.08,Default,,0,0,0,,Аса жойқын күш.
Dialogue: 0,0:17:26.17,0:17:27.62,Default,,0,0,0,,Бесінші әсер…
Dialogue: 0,0:17:28.29,0:17:33.42,Default,,0,0,0,,Қабаттың екі қылыш Диск жақтауы Драйвердің ауыр бөлігі
Dialogue: 0,0:17:33.51,0:17:35.22,Default,,0,0,0,,Осы бесеу бір-біріне сәйкес келгенде...
Dialogue: 0,0:17:35.30,0:17:40.22,Default,,0,0,0,,Ең үлкен жойқын күшпен соққы бере алады...?
Dialogue: 0,0:17:40.85,0:17:43.68,Default,,0,0,0,,Фуфуфу~! Алғашқы ойынның қызуы әлі сейілген жоқ
Dialogue: 0,0:17:43.77,0:17:45.52,Default,,0,0,0,,Екінші ойынның уақыты келді!
Dialogue: 0,0:17:45.60,0:17:46.94,Default,,0,0,0,,Кейінгі қақтығыс болды-
Dialogue: 0,0:17:47.19,0:17:49.98,Default,,0,0,0,,Red Blade Aiga Sumie Fubuki Team VS
Dialogue: 0,0:17:50.06,0:17:52.44,Default,,0,0,0,,Лабан Вано Оу Хоуи командасы.
Dialogue: 0,0:17:52.57,0:17:55.94,Default,,0,0,0,,Бұл ойын Айга! Әй, жүр!
Dialogue: 0,0:17:56.40,0:17:58.20,Default,,0,0,0,,Айга концентраты!
Dialogue: 0,0:17:59.32,0:18:00.20,Default,,0,0,0,,Тег шайқасы
Dialogue: 0,0:18:00.78,0:18:02.83,Default,,0,0,0,,Кеттік, Фубуки.
Dialogue: 0,0:18:04.20,0:18:05.08,Default,,0,0,0,,Тұтқындарға арналған екінші жатақхана.
Dialogue: 0,0:18:05.66,0:18:07.08,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:18:07.79,0:18:10.75,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:11.38,0:18:13.50,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:13.80,0:18:14.67,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:25.81,0:18:28.14,Default,,0,0,0,,Ахиллес қарғыс атсын!
Dialogue: 0,0:18:28.69,0:18:30.52,Default,,0,0,0,,Геракл жүр!
Dialogue: 0,0:18:31.06,0:18:34.40,Default,,0,0,0,,Ахиллес пен Геркулестің қақтығысы!
Dialogue: 0,0:18:34.53,0:18:38.53,Default,,0,0,0,,Бұл уақытта Форнеус пен Барс бір-біріне қарап тұр.
Dialogue: 0,0:18:39.15,0:18:42.41,Default,,0,0,0,,Фубуки мен Лабан бір-бірін бақылауда ұстайды.
Dialogue: 0,0:18:47.33,0:18:50.25,Default,,0,0,0,,Садақшының соққысы!
Dialogue: 0,0:18:51.58,0:18:54.21,Default,,0,0,0,,Z Slash!
Dialogue: 0,0:19:02.55,0:19:04.01,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:19:04.30,0:19:06.06,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:06.14,0:19:07.77,Default,,0,0,0,,Айга қауіпті! сурет?
Dialogue: 0,0:19:07.85,0:19:10.02,Default,,0,0,0,,Айқайлап шағып!
Dialogue: 0,0:19:12.65,0:19:13.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:17.86,0:19:19.28,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:19:19.90,0:19:23.20,Default,,0,0,0,,Ахиллеспен сөйлесіңіз, сөйлесіңіз, сөйлесіңіз!
Dialogue: 0,0:19:23.28,0:19:26.08,Default,,0,0,0,,Леопардтың Ахиллеске жасаған хайуандық шабуылы өте қиын жағдайда!
Dialogue: 0,0:19:26.08,0:19:27.54,Default,,0,0,0,,Леопардтың Ахиллеске жасаған хайуандық шабуылы өте қиын жағдайда!
Dialogue: 0,0:19:26.08,0:19:27.54,Default,,0,0,0,,Бұл маңызды емес, иә?
Dialogue: 0,0:19:27.87,0:19:30.96,Default,,0,0,0,,Оны жыртып тастаңыз Howling Bite!
Dialogue: 0,0:19:33.83,0:19:34.96,Default,,0,0,0,,Форнеус!
Dialogue: 0,0:19:42.47,0:19:43.59,Default,,0,0,0,,О! Ах~!
Dialogue: 0,0:19:44.09,0:19:44.97,Default,,0,0,0,,Иә
Dialogue: 0,0:19:45.60,0:19:46.93,Default,,0,0,0,,Тег шайқасы
Dialogue: 0,0:19:47.93,0:19:50.23,Default,,0,0,0,,Red Blade Aiga Sumie Fubuki командасы жеңді!
Dialogue: 0,0:19:50.89,0:19:54.31,Default,,0,0,0,,Қандай күтпеген және керемет аяқталды
Dialogue: 0,0:19:54.86,0:19:55.81,Default,,0,0,0,,Форнеус...
Dialogue: 0,0:19:55.90,0:19:58.98,Default,,0,0,0,,Барсты өзінің одақтасы Ахиллеспен бірге жарылды
Dialogue: 0,0:19:59.07,0:20:00.44,Default,,0,0,0,,Сенгісіз!
Dialogue: 0,0:20:00.86,0:20:03.20,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:20:03.57,0:20:05.49,Default,,0,0,0,,Күткендей, Фубуки-сенпай
Dialogue: 0,0:20:05.57,0:20:07.95,Default,,0,0,0,,Айғаны аздап аяймын.
Dialogue: 0,0:20:08.41,0:20:11.04,Default,,0,0,0,,Ол Ахиллді де ұшырып жібермейді.
Dialogue: 0,0:20:11.16,0:20:14.04,Default,,0,0,0,,Біз жеңуіміз керек. Бұл біздің жеңісіміз.
Dialogue: 0,0:20:14.12,0:20:16.46,Default,,0,0,0,,Мен оны ұшырып, жеңгім келді!
Dialogue: 0,0:20:19.50,0:20:22.34,Default,,0,0,0,,Сәттілік маған айтқандай болды ғой, солай ма?
Dialogue: 0,0:20:23.13,0:20:26.18,Default,,0,0,0,,Қараңғыдан кенет тағы бір адам шықты.
Dialogue: 0,0:20:26.64,0:20:31.43,Default,,0,0,0,,Сіз жай ғана сақтығыңызды түсірдіңіз. Мен көріпкелдікке сенбеймін.
Dialogue: 0,0:20:31.64,0:20:34.48,Default,,0,0,0,,Хаа... Сен сондай қыңырсың.
Dialogue: 0,0:20:35.31,0:20:37.61,Default,,0,0,0,,Тег шайқасы аяқталды.
Dialogue: 0,0:20:37.81,0:20:40.86,Default,,0,0,0,,Мен қазіргі Байстар санын хабарлаймын.
Dialogue: 0,0:20:41.28,0:20:42.57,Default,,0,0,0,,Phi – 4
Dialogue: 0,0:20:42.99,0:20:46.57,Default,,0,0,0,,Қызыл жүз Айга Жан Богард Кайл Хаким 3 жаста
Dialogue: 0,0:20:47.20,0:20:49.87,Default,,0,0,0,,Суми Фубуки Лабан Вано - 2
Dialogue: 0,0:20:50.12,0:20:53.96,Default,,0,0,0,,Оу Хоуи Гошуин Суоу Кияма Ранжиро - 1
Dialogue: 0,0:20:54.58,0:20:57.75,Default,,0,0,0,,Бір ғана қалды. Бұл ақылсыз.
Dialogue: 0,0:20:58.21,0:21:00.71,Default,,0,0,0,,Сәттілік саған жардың шетінде.
Dialogue: 0,0:21:01.30,0:21:02.13,Default,,0,0,0,,Құт
Dialogue: 0,0:21:10.47,0:21:12.27,Default,,0,0,0,,Бүгінгі шайқас жақсы өтті
Dialogue: 0,0:21:12.64,0:21:13.85,Default,,0,0,0,,Омехана!
Dialogue: 0,0:21:15.48,0:21:19.40,Default,,0,0,0,,Тегтер шайқасында жеңіске жеткен себебім, мен сіздермен бірге болдым.
Dialogue: 0,0:21:21.02,0:21:23.49,Default,,0,0,0,,Сіз бәрібір өзгердіңіз.
Dialogue: 0,0:21:24.11,0:21:25.61,Default,,0,0,0,,Сол кездегідей
Dialogue: 0,0:21:25.90,0:21:29.20,Default,,0,0,0,,Мен мықты Блейдер болуды мақсат етемін.
Dialogue: 0,0:21:29.83,0:21:31.20,Default,,0,0,0,,Бұл өзгермейді
Dialogue: 0,0:21:31.62,0:21:32.62,Default,,0,0,0,,Фубуки
Dialogue: 0,0:21:33.66,0:21:36.62,Default,,0,0,0,,Мен осы кемеде барлығын жеңу үшін келдім.
Dialogue: 0,0:21:39.42,0:21:40.38,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:41.17,0:21:44.30,Default,,0,0,0,,Ал мен Балт Аоиды жеңемін.
Dialogue: 0,0:21:54.77,0:22:00.77,Default,,0,0,0,,♪~
Dialogue: 0,0:23:16.64,0:23:22.65,Default,,0,0,0,,~♪
Dialogue: 0,0:23:25.36,0:23:27.94,Default,,0,0,0,,Мен Файды еркін шайқасқа шақырдым.
Dialogue: 0,0:23:28.19,0:23:29.78,Default,,0,0,0,,Мен бұл жолы жеңілмеймін!
Dialogue: 0,0:23:30.49,0:23:34.16,Default,,0,0,0,,Ал келесі сынақ шайқасы - 3 (үш) Бей шайқасы.
Dialogue: 0,0:23:34.28,0:23:36.91,Default,,0,0,0,,Super Zetsu Соңғы минуттық шайқас жалғасуда
Dialogue: 0,0:23:37.16,0:23:39.37,Default,,0,0,0,,Кім оқудан шығады?
Dialogue: 0,0:23:39.66,0:23:41.83,Default,,0,0,0,,Келесі жолы «Beyblade Burst Super Zetsu»
Dialogue: 0,0:23:41.92,0:23:44.00,Default,,0,0,0,,«Үш-бейдің шайқасы!»
Dialogue: 0,0:23:44.08,0:23:46.25,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:46.38,0:23:48.51,Default,,0,0,0,,Бар, ат!
