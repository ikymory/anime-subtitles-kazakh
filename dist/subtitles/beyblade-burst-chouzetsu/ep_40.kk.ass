Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.62,0:00:04.04,Default,,0,0,0,,Бейблейд
Dialogue: 0,0:00:04.17,0:00:08.29,Default,,0,0,0,,Мықты болуды мақсат еткен ұлдардың арманының жемісі.
Dialogue: 0,0:00:08.84,0:00:12.47,Default,,0,0,0,,Ал қазір супер Цетсу дәуірі қызып келеді.
Dialogue: 0,0:00:12.76,0:00:16.76,Default,,0,0,0,,Металл сауыт киіп, Беймен шытырман оқиғаға барыңыз!
Dialogue: 0,0:00:17.22,0:00:19.51,Default,,0,0,0,,Әлем чемпионы болуды мақсат етіңіз!
Dialogue: 0,0:00:19.64,0:00:23.64,Default,,0,0,0,,Super Zetsu Super Zetsu Super Zetsu!
Dialogue: 0,0:00:24.77,0:00:28.48,Default,,0,0,0,,Ең күшті және жеңілмейтін атағын алатын адам сенсің!
Dialogue: 0,0:00:36.53,0:00:37.91,Default,,0,0,0,,Кек алу!
Dialogue: 0,0:00:38.03,0:00:41.62,Default,,0,0,0,,Мен Super Z Ахиллесті жүректермен тағы бір рет күресу үшін қолдандым!
Dialogue: 0,0:00:42.91,0:00:43.91,Default,,0,0,0,,Айга!
Dialogue: 0,0:00:44.25,0:00:45.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:47.88,0:00:49.17,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:00:50.92,0:00:53.38,Default,,0,0,0,,Қазір қолыңызда бардың бәрін шығарыңыз
Dialogue: 0,0:00:54.22,0:00:56.47,Default,,0,0,0,,Мен саған сенемін
Dialogue: 0,0:00:58.97,0:01:00.93,Default,,0,0,0,,Түсіндім, досым.
Dialogue: 0,0:01:04.48,0:01:06.69,Default,,0,0,0,,Жақсы! Super Z-Wing шықты!
Dialogue: 0,0:01:06.94,0:01:09.44,Default,,0,0,0,,Хаха~! Келді, келді, келді!
Dialogue: 0,0:01:11.94,0:01:15.70,Default,,0,0,0,,Super Z Buster!
Dialogue: 0,0:01:25.79,0:01:28.12,Default,,0,0,0,,Губааа~!
Dialogue: 0,0:01:28.71,0:01:30.63,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:01:31.09,0:01:34.30,Default,,0,0,0,,Мен Айғамен шайқасқым келеді.
Dialogue: 0,0:01:38.22,0:01:41.10,Default,,0,0,0,,Сіз де, солай ма? ауа түні
Dialogue: 0,0:01:43.39,0:01:49.40,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:03:06.68,0:03:12.69,Default,,0,0,0,,~♪
Dialogue: 0,0:03:18.11,0:03:20.15,Default,,0,0,0,,Айга Жарайсың!
Dialogue: 0,0:03:20.78,0:03:22.41,Default,,0,0,0,,Кек алу – сәтті.
Dialogue: 0,0:03:22.53,0:03:24.53,Default,,0,0,0,,Super Zetsu керемет болды!
Dialogue: 0,0:03:24.66,0:03:26.91,Default,,0,0,0,,Super Z Awakening Мен оны түсіндім.
Dialogue: 0,0:03:27.49,0:03:30.04,Default,,0,0,0,,О! Бұл өте жақсы сезіледі
Dialogue: 0,0:03:30.16,0:03:31.66,Default,,0,0,0,,Гах ха ха!
Dialogue: 0,0:03:31.79,0:03:33.75,Default,,0,0,0,,Алаңдамаңыз
Dialogue: 0,0:03:33.88,0:03:35.71,Default,,0,0,0,,Мен мұны бір рет қана орындадым.
Dialogue: 0,0:03:36.29,0:03:37.55,Default,,0,0,0,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:03:37.67,0:03:39.05,Default,,0,0,0,,Жалқау...
Dialogue: 0,0:03:39.59,0:03:40.59,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:03:40.72,0:03:41.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:46.64,0:03:48.56,Default,,0,0,0,,Мен бұл туралы жақсы сезіндім.
Dialogue: 0,0:03:49.31,0:03:52.39,Default,,0,0,0,,Ахиллес саған сенбейді.
Dialogue: 0,0:03:54.19,0:03:55.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:57.77,0:03:58.69,Default,,0,0,0,,Айга…
Dialogue: 0,0:03:59.65,0:04:00.65,Default,,0,0,0,,Тақырып
Dialogue: 0,0:04:02.65,0:04:03.49,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:04.07,0:04:04.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:05.20,0:04:06.53,Default,,0,0,0,,Бұл не? сурет?
Dialogue: 0,0:04:06.66,0:04:07.49,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:13.37,0:04:14.58,Default,,0,0,0,,Жинақ?
Dialogue: 0,0:04:14.75,0:04:16.50,Default,,0,0,0,,Ол не істеп жатыр?
Dialogue: 0,0:04:19.25,0:04:20.21,Default,,0,0,0,,Ой?
Dialogue: 0,0:04:20.34,0:04:22.76,Default,,0,0,0,,Дельтаплан мінген адам аспанда билейді
Dialogue: 0,0:04:23.34,0:04:26.05,Default,,0,0,0,,Blader, жел пайдаланушыларының рыцарлары ретінде белгілі
Dialogue: 0,0:04:26.18,0:04:28.35,Default,,0,0,0,,Бұл Кит Лопес!
Dialogue: 0,0:04:28.47,0:04:30.56,Default,,0,0,0,,А... (Тесікке қарап) Ой!
Dialogue: 0,0:04:31.31,0:04:33.48,Default,,0,0,0,,Кит аспаннан түсті!
Dialogue: 0,0:04:35.94,0:04:36.94,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:39.94,0:04:42.11,Default,,0,0,0,,Теме, бұл қауіпті емес пе!
Dialogue: 0,0:04:42.74,0:04:45.49,Default,,0,0,0,,Жарайды, мен ұшуға үйреніп қалдым.
Dialogue: 0,0:04:45.99,0:04:47.99,Default,,0,0,0,,Олай айтпа!
Dialogue: 0,0:04:48.45,0:04:50.91,Default,,0,0,0,,Айға Мен матчты бұрын көрдім.
Dialogue: 0,0:04:51.66,0:04:53.08,Default,,0,0,0,,Жеңісіңіз құтты болсын
Dialogue: 0,0:04:53.45,0:04:57.21,Default,,0,0,0,,Жүректерді жеңген Super Z ояту таңғажайып болды
Dialogue: 0,0:04:57.33,0:04:58.17,Default,,0,0,0,,О!
Dialogue: 0,0:04:59.54,0:05:01.92,Default,,0,0,0,,Айга мен және Эйр Найт...
Dialogue: 0,0:05:02.67,0:05:04.13,Default,,0,0,0,,Тапсырманы қабылдаңыз!
Dialogue: 0,0:05:04.80,0:05:06.01,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:06.43,0:05:07.93,Default,,0,0,0,,Нуванто!
Dialogue: 0,0:05:08.05,0:05:10.31,Default,,0,0,0,,Knight of Wind пайдаланушы жинағы Лопес
Dialogue: 0,0:05:10.43,0:05:13.35,Default,,0,0,0,,Қызыл жүз Айгаға шақыру берілді!
Dialogue: 0,0:05:18.81,0:05:20.61,Default,,0,0,0,,Не? Бұл...
Dialogue: 0,0:05:21.07,0:05:24.78,Default,,0,0,0,,Ең мықты Super Zetsu болуды мақсат еткен жалғыз сіз емессіз.
Dialogue: 0,0:05:25.24,0:05:27.11,Default,,0,0,0,,Менімен күрес, Айға!
Dialogue: 0,0:05:30.62,0:05:33.54,Default,,0,0,0,,Ха, мен істеймін!
Dialogue: 0,0:05:33.66,0:05:35.62,Default,,0,0,0,,Мен оны алдым!
Dialogue: 0,0:05:35.79,0:05:38.88,Default,,0,0,0,,Red Blade Aiga Кит Лопеске қарсы шығады
Dialogue: 0,0:05:39.00,0:05:41.71,Default,,0,0,0,,Мен мұны байыппен қабылдадым!
Dialogue: 0,0:05:43.76,0:05:46.59,Default,,0,0,0,,Жарайды! Жапониядан тосын жаңалық
Dialogue: 0,0:05:46.72,0:05:47.88,Default,,0,0,0,,Біз оны сізге жеткіземіз!
Dialogue: 0,0:05:48.51,0:05:49.76,Default,,0,0,0,,wbba.
Dialogue: 0,0:05:49.89,0:05:53.72,Default,,0,0,0,,Айга Акаба мен Кит Лопес арасындағы матч туралы хабарландыру!
Dialogue: 0,0:05:53.85,0:05:57.52,Default,,0,0,0,,Чемпион Балт Аоиға қарсы шығу құқығы үшін шайқас басталады.
Dialogue: 0,0:05:57.64,0:06:00.81,Default,,0,0,0,,Дене қызуы көтерілді ме? Өте қызықты!
Dialogue: 0,0:06:00.94,0:06:02.65,Default,,0,0,0,,Кім жеңеді?
Dialogue: 0,0:06:03.40,0:06:04.32,Default,,0,0,0,,Жинақ…
Dialogue: 0,0:06:05.57,0:06:09.03,Default,,0,0,0,,Жинақ Айгаға қарсы өте жақсы болар еді.
Dialogue: 0,0:06:09.45,0:06:12.45,Default,,0,0,0,,Бірақ мен сақтығымды түсіре алмаймын, жігітім.
Dialogue: 0,0:06:12.58,0:06:14.79,Default,,0,0,0,,Ол Барт пен Бүргенің шәкірті.
Dialogue: 0,0:06:15.04,0:06:17.91,Default,,0,0,0,,Маңызды емес! Оны жарып жіберейік
Dialogue: 0,0:06:18.62,0:06:19.67,Default,,0,0,0,,О
Dialogue: 0,0:06:24.71,0:06:25.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:26.96,0:06:29.43,Default,,0,0,0,,Жинақ сөзсіз резонанс тудырады.
Dialogue: 0,0:06:30.18,0:06:32.43,Default,,0,0,0,,Ол... күшті!
Dialogue: 0,0:06:32.80,0:06:36.06,Default,,0,0,0,,Содан кейін жаттығу керек.
Dialogue: 0,0:06:36.56,0:06:38.18,Default,,0,0,0,,Гумита қоңырауы!
Dialogue: 0,0:06:38.68,0:06:40.69,Default,,0,0,0,,Екеуің кеттік.
Dialogue: 0,0:06:42.94,0:06:43.98,Default,,0,0,0,,О!
Dialogue: 0,0:06:44.57,0:06:46.19,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:06:46.78,0:06:49.95,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:06:50.32,0:06:52.57,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:06:53.07,0:06:53.91,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:57.66,0:07:00.04,Default,,0,0,0,,Не болды? Оянба!
Dialogue: 0,0:07:00.41,0:07:01.54,Default,,0,0,0,,Мен білемін!
Dialogue: 0,0:07:04.79,0:07:08.80,Default,,0,0,0,,Желді темір қанаттарымен айналдыр!
Dialogue: 0,0:07:09.01,0:07:12.30,Default,,0,0,0,,Рагнарук дауылы!
Dialogue: 0,0:07:14.97,0:07:17.52,Default,,0,0,0,,Жүр!
Dialogue: 0,0:07:18.52,0:07:19.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:19.85,0:07:22.44,Default,,0,0,0,,Ахиллес екеуіңде байланыс бар ма?
Dialogue: 0,0:07:27.02,0:07:31.28,Default,,0,0,0,,Мен әлі де Super Z Ахиллеспен байланыс орната алмадым.
Dialogue: 0,0:07:35.95,0:07:40.00,Default,,0,0,0,,Super Z Awakening бағдарламасын әлі меңгерген жоқсыз ба?
Dialogue: 0,0:07:41.87,0:07:45.00,Default,,0,0,0,,Біздің резонанс жақсырақ.
Dialogue: 0,0:07:46.09,0:07:48.25,Default,,0,0,0,,(шұңқырлар соқтығысқан дыбыс)
Dialogue: 0,0:07:53.97,0:07:54.80,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:07:55.97,0:07:57.05,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:07:59.93,0:08:02.06,Default,,0,0,0,,Неліктен мен жеңе алмаймын?
Dialogue: 0,0:08:02.77,0:08:04.06,Default,,0,0,0,,Неге!
Dialogue: 0,0:08:08.73,0:08:09.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:11.82,0:08:13.57,Default,,0,0,0,,Эйр Найттан сұраңыз.
Dialogue: 0,0:08:14.45,0:08:15.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:16.32,0:08:17.33,Default,,0,0,0,,Жинақ
Dialogue: 0,0:08:17.45,0:08:19.83,Default,,0,0,0,,Сіз Air Knight-қа сенесіз бе?
Dialogue: 0,0:08:20.29,0:08:22.04,Default,,0,0,0,,Мен, әрине, сенемін.
Dialogue: 0,0:08:23.16,0:08:24.92,Default,,0,0,0,,Air Knight туралы не деуге болады?
Dialogue: 0,0:08:25.33,0:08:26.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:26.58,0:08:29.63,Default,,0,0,0,,Әріптесіңіздің дауысын көбірек тыңдаңыз.
Dialogue: 0,0:08:30.59,0:08:33.51,Default,,0,0,0,,Бұл Беймен резонанс тудырады.
Dialogue: 0,0:08:34.43,0:08:35.55,Default,,0,0,0,,Жоқ, біз бұлай істей алмаймыз!
Dialogue: 0,0:08:47.15,0:08:48.77,Default,,0,0,0,,А? Ах... Кит!
Dialogue: 0,0:08:49.15,0:08:51.94,Default,,0,0,0,,Теме, сіз біздің жаттығуымызды көрдіңіз бе?
Dialogue: 0,0:08:52.07,0:08:52.90,Default,,0,0,0,,О
Dialogue: 0,0:08:53.03,0:08:54.03,Default,,0,0,0,,Сіз шпионсыз ба?
Dialogue: 0,0:08:54.40,0:08:58.57,Default,,0,0,0,,Ұрыс алдында қарсыласыңызды зерттеу табиғи нәрсе.
Dialogue: 0,0:08:59.03,0:09:02.91,Default,,0,0,0,,Кит, мен саған мен туралы бәрін айтып беремін.
Dialogue: 0,0:09:03.08,0:09:03.91,Default,,0,0,0,,Фу…
Dialogue: 0,0:09:04.62,0:09:06.67,Default,,0,0,0,,Айға менің сенен бір жақсылығым бар.
Dialogue: 0,0:09:06.87,0:09:08.88,Default,,0,0,0,,Мен саған барғым келеді.
Dialogue: 0,0:09:09.75,0:09:10.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:10.96,0:09:12.34,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:12.46,0:09:16.68,Default,,0,0,0,,Мен сіз туралы көбірек білгім келеді, менде өте маңызды нәрсе бар.
Dialogue: 0,0:09:16.80,0:09:18.26,Default,,0,0,0,,Кеттік! Ой... ой
Dialogue: 0,0:09:18.39,0:09:20.47,Default,,0,0,0,,Сіз күштеп жатырсыз! Ах...
Dialogue: 0,0:09:20.60,0:09:23.47,Default,,0,0,0,,Күте тұрыңыз! Нару да барады!
Dialogue: 0,0:09:27.77,0:09:29.90,Default,,0,0,0,,Жақсы сезінемін!
Dialogue: 0,0:09:30.27,0:09:31.65,Default,,0,0,0,,Ең жақсысы емес пе?
Dialogue: 0,0:09:32.02,0:09:33.99,Default,,0,0,0,,Иә! Ең жақсы!
Dialogue: 0,0:09:34.11,0:09:35.44,Default,,0,0,0,,Дұрыс? Дұрыс па?
Dialogue: 0,0:09:35.57,0:09:37.28,Default,,0,0,0,,Сәлем! иә?
Dialogue: 0,0:09:38.78,0:09:41.78,Default,,0,0,0,,Жігіттермен ғана ұшып кету ақылсыз!
Dialogue: 0,0:09:42.41,0:09:45.29,Default,,0,0,0,,Тек 2 адам мінеді!
Dialogue: 0,0:09:45.79,0:09:47.46,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:09:51.04,0:09:52.50,Default,,0,0,0,,Бұл керемет...
Dialogue: 0,0:09:52.63,0:09:55.13,Default,,0,0,0,,Өйткені бұл орман Айғаның бағы
Dialogue: 0,0:09:55.76,0:09:59.84,Default,,0,0,0,,Оның дене күші осында жаттықты ма?
Dialogue: 0,0:10:06.68,0:10:09.73,Default,,0,0,0,,Фриланс өз денесін басқаларға қарағанда көбірек жаттықтырады.
Dialogue: 0,0:10:10.90,0:10:14.44,Default,,0,0,0,,Біз сізден асып түсуіміз үшін одан да көп нәрсе істеуіміз керек.
Dialogue: 0,0:10:15.57,0:10:18.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:23.28,0:10:24.99,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:29.75,0:10:31.79,Default,,0,0,0,,Не істеймін… не істеймін!
Dialogue: 0,0:10:32.96,0:10:36.46,Default,,0,0,0,,Бірақ сіз ғана жаттыққан емессіз!
Dialogue: 0,0:10:36.92,0:10:39.55,Default,,0,0,0,,Не... Уау!
Dialogue: 0,0:10:40.01,0:10:41.64,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:10:41.76,0:10:44.31,Default,,0,0,0,,Жарыста сені ешкім жеңе алмайды!
Dialogue: 0,0:10:44.56,0:10:47.06,Default,,0,0,0,,Мен тіпті Балтонды жеңдім, хмф!
Dialogue: 0,0:10:47.43,0:10:48.43,Default,,0,0,0,,Не!
Dialogue: 0,0:10:48.85,0:10:49.98,Default,,0,0,0,,Сіз мұны істейсіз бе?
Dialogue: 0,0:10:50.10,0:10:51.02,Default,,0,0,0,,Әрине!
Dialogue: 0,0:10:51.15,0:10:53.06,Default,,0,0,0,,Кеттік! Оу!
Dialogue: 0,0:10:53.44,0:10:56.23,Default,,0,0,0,,Наруды артта қалдырмаңыз!
Dialogue: 0,0:10:56.44,0:10:59.24,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:11:00.24,0:11:01.95,Default,,0,0,0,,Нууууу...
Dialogue: 0,0:11:04.28,0:11:05.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:05.45,0:11:07.83,Default,,0,0,0,,Нууууу...
Dialogue: 0,0:11:08.50,0:11:11.75,Default,,0,0,0,,Уау! Жоқ!
Dialogue: 0,0:11:11.87,0:11:12.71,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:14.25,0:11:15.09,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:16.88,0:11:18.38,Default,,0,0,0,,Аха…
Dialogue: 0,0:11:18.51,0:11:19.72,Default,,0,0,0,,Қырықша… әрине!
Dialogue: 0,0:11:19.84,0:11:24.22,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:11:24.60,0:11:30.39,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:11:30.52,0:11:32.10,Default,,0,0,0,,Мен жеңдім.
Dialogue: 0,0:11:32.23,0:11:33.69,Default,,0,0,0,,Біз жеңеміз!
Dialogue: 0,0:11:33.81,0:11:34.65,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:11:35.19,0:11:36.15,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:37.73,0:11:38.61,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:38.78,0:11:40.15,Default,,0,0,0,,Бұл өте қызық болды
Dialogue: 0,0:11:41.28,0:11:42.49,Default,,0,0,0,,Жоғарыдағылар не ойлап отыр екен? Трост ауданына кіру – тек бекер өлімге апарады.
Dialogue: 0,0:11:43.66,0:11:45.32,Default,,0,0,0,,Қош келдіңіз Айга
Dialogue: 0,0:11:45.45,0:11:46.28,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:11:47.12,0:11:48.54,Default,,0,0,0,,Достар?
Dialogue: 0,0:11:48.74,0:11:50.96,Default,,0,0,0,,О, ол Кит деп аталады.
Dialogue: 0,0:11:51.08,0:11:53.75,Default,,0,0,0,,Мүмкін келесі жолы Айғамен төбелесетін шығарсың?
Dialogue: 0,0:11:54.13,0:11:56.50,Default,,0,0,0,,Сәлем, мен Кит Лопеспін.
Dialogue: 0,0:11:56.92,0:11:59.00,Default,,0,0,0,,Менің әкем мен анам
Dialogue: 0,0:11:59.13,0:12:00.01,Default,,0,0,0,,Қан жарылысы!
Dialogue: 0,0:12:00.13,0:12:01.26,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:12:02.09,0:12:03.55,Default,,0,0,0,,Зороның атасына
Dialogue: 0,0:12:03.68,0:12:07.14,Default,,0,0,0,,Ағам маған Әуе Рыцарьын көрсетуімді өтінді.
Dialogue: 0,0:12:08.14,0:12:09.52,Default,,0,0,0,,Маған Зоро?
Dialogue: 0,0:12:10.14,0:12:12.94,Default,,0,0,0,,Тайга - ең жақсы жаттықтырушы
Dialogue: 0,0:12:13.10,0:12:15.65,Default,,0,0,0,,Сәлем! Менің досыма қара
Dialogue: 0,0:12:17.15,0:12:18.19,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:12:21.19,0:12:23.95,Default,,0,0,0,,Air Knight Stamina түрі
Dialogue: 0,0:12:24.99,0:12:29.33,Default,,0,0,0,,Бұл Super Zetsubei ішіндегі ең үлкен қабаттардың бірі ме?
Dialogue: 0,0:12:29.95,0:12:32.79,Default,,0,0,0,,Бұл күшті жоғарғы күш тудырады.
Dialogue: 0,0:12:33.62,0:12:37.17,Default,,0,0,0,,Бейдің төзімділігі де, күші де бар.
Dialogue: 0,0:12:37.33,0:12:39.34,Default,,0,0,0,,Мен жасадым, иә?
Dialogue: 0,0:12:39.92,0:12:40.84,Default,,0,0,0,,Сіз?
Dialogue: 0,0:12:41.09,0:12:43.55,Default,,0,0,0,,Мен атамнан көмек сұрадым.
Dialogue: 0,0:12:43.84,0:12:46.34,Default,,0,0,0,,Эй, бұл ең жақсы супер Zetsubei, солай ма?
Dialogue: 0,0:12:46.59,0:12:48.60,Default,,0,0,0,,О, бұл тамаша.
Dialogue: 0,0:12:49.01,0:12:49.93,Default,,0,0,0,,Хехе...
Dialogue: 0,0:12:50.06,0:12:53.52,Default,,0,0,0,,Бірақ мен бұл дискіге жақтауды қоймас едім.
Dialogue: 0,0:12:53.64,0:12:54.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:55.10,0:12:58.77,Default,,0,0,0,,Жақтаудың пішініне байланысты күштірек жоғарғы күш
Dialogue: 0,0:12:58.90,0:13:00.98,Default,,0,0,0,,Өндіре алатын болады
Dialogue: 0,0:13:01.69,0:13:03.07,Default,,0,0,0,,Кадр…
Dialogue: 0,0:13:04.11,0:13:04.99,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,0:13:05.45,0:13:07.49,Default,,0,0,0,,Айға! Маған құралдарды қарызға беріңіз
Dialogue: 0,0:13:07.62,0:13:08.45,Default,,0,0,0,,Әй?
Dialogue: 0,0:13:08.57,0:13:09.91,Default,,0,0,0,,А, осылай!
Dialogue: 0,0:13:11.20,0:13:13.25,Default,,0,0,0,,Сіз оны бірден жасауды жоспарлап отырсыз ба?
Dialogue: 0,0:13:13.66,0:13:17.00,Default,,0,0,0,,Айға екеуің шынымен өзгердіңдер.
Dialogue: 0,0:13:17.67,0:13:20.17,Default,,0,0,0,,Мен күресетін адам күшейсе де
Dialogue: 0,0:13:20.29,0:13:22.13,Default,,0,0,0,,Маған қол ұшын бере аласыз ба?
Dialogue: 0,0:13:22.38,0:13:25.26,Default,,0,0,0,,Бұл жақсы жағы.
Dialogue: 0,0:13:25.97,0:13:28.34,Default,,0,0,0,,Қарсылас неғұрлым күшті болса, соғұрлым көп
Dialogue: 0,0:13:28.64,0:13:30.55,Default,,0,0,0,,Айға күшейе түседі
Dialogue: 0,0:13:30.76,0:13:35.27,Default,,0,0,0,,Айғада достарымның көп болғанына өте қуаныштымын.
Dialogue: 0,0:13:36.56,0:13:37.81,Default,,0,0,0,,Ванна…
Dialogue: 0,0:13:37.94,0:13:38.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:38.90,0:13:40.11,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:13:40.23,0:13:41.94,Default,,0,0,0,,Қош келдіңіз Нару
Dialogue: 0,0:13:48.20,0:13:49.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:50.07,0:13:51.41,Default,,0,0,0,,Орындалды!
Dialogue: 0,0:13:52.62,0:13:55.20,Default,,0,0,0,,Мына жақтау жақсы емес пе?
Dialogue: 0,0:13:58.50,0:14:01.13,Default,,0,0,0,,Енді Air Knight - ең күшті!
Dialogue: 0,0:14:01.25,0:14:04.30,Default,,0,0,0,,Ей, жеңуге тұрарлық!
Dialogue: 0,0:14:05.55,0:14:06.51,Default,,0,0,0,,Хехе
Dialogue: 0,0:14:08.18,0:14:09.22,Default,,0,0,0,,Хехе
Dialogue: 0,0:14:10.59,0:14:12.76,Default,,0,0,0,,Жарайды! Ұлдар мен қыздар!
Dialogue: 0,0:14:13.56,0:14:16.10,Default,,0,0,0,,Барлығына! Қарап тұрсың ба?
Dialogue: 0,0:14:16.23,0:14:18.02,Default,,0,0,0,,Кім жеңсе де, болашақ өзгереді
Dialogue: 0,0:14:18.14,0:14:20.65,Default,,0,0,0,,Бейблейд әлемінің болашағын болжайтын шайқас
Dialogue: 0,0:14:20.77,0:14:22.73,Default,,0,0,0,,Ха~жима~рузэ~и!
Dialogue: 0,0:14:22.98,0:14:25.73,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:14:26.44,0:14:27.74,Default,,0,0,0,,Қызыл бұрыштан
Dialogue: 0,0:14:28.24,0:14:29.74,Default,,0,0,0,,Жау жүректеріңізді жеңіңіз
Dialogue: 0,0:14:30.24,0:14:33.20,Default,,0,0,0,,Super Zetsu Blader импульсті айдауда
Dialogue: 0,0:14:33.83,0:14:36.79,Default,,0,0,0,,Қызыл супернова Қызыл жүз Айга!
Dialogue: 0,0:14:36.91,0:14:37.75,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:14:38.12,0:14:41.00,Default,,0,0,0,,Айга! Көңіл-күйлеріңіз көтеріңкі болсын!
Dialogue: 0,0:14:41.13,0:14:42.75,Default,,0,0,0,,Сөзсіз жеңіңіз!
Dialogue: 0,0:14:43.59,0:14:45.21,Default,,0,0,0,,Көк бұрыштан
Dialogue: 0,0:14:45.34,0:14:49.05,Default,,0,0,0,,Жел рыцарь Испаниядан соққан дауыл сияқты көрінді.
Dialogue: 0,0:14:49.17,0:14:52.14,Default,,0,0,0,,Кит Лопес!
Dialogue: 0,0:14:53.64,0:14:56.52,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:14:59.98,0:15:03.52,Default,,0,0,0,,Жел пайдаланушы рыцарь... бұл керемет емес пе?
Dialogue: 0,0:15:03.94,0:15:07.15,Default,,0,0,0,,Қызыл супернова да керемет
Dialogue: 0,0:15:07.90,0:15:11.11,Default,,0,0,0,,Мен оны қалай пайдаланатыныңызды асыға күтемін!
Dialogue: 0,0:15:12.11,0:15:15.78,Default,,0,0,0,,Айга... Әуе рыцарының жасаған жоғарғы күші
Dialogue: 0,0:15:15.91,0:15:19.58,Default,,0,0,0,,Бұл сіз бұрын ешқашан бастан өткермеген нәрсе болатыны сөзсіз.
Dialogue: 0,0:15:21.75,0:15:22.83,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:15:23.50,0:15:26.59,Default,,0,0,0,,Super Z Ахиллес, барымызды салайық
Dialogue: 0,0:15:27.17,0:15:29.09,Default,,0,0,0,,Төмен баланс режимі!
Dialogue: 0,0:15:30.22,0:15:32.59,Default,,0,0,0,,Рамкамен сен ең мықтысың.
Dialogue: 0,0:15:33.43,0:15:35.72,Default,,0,0,0,,Мен саған сенемін, Әуе рыцарь.
Dialogue: 0,0:15:37.26,0:15:38.97,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:15:39.39,0:15:42.60,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:15:43.10,0:15:45.36,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:15:45.81,0:15:46.69,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:50.32,0:15:52.61,Default,,0,0,0,,Жақсы! Super Z-Wing шықты!
Dialogue: 0,0:15:52.74,0:15:53.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:54.37,0:15:56.16,Default,,0,0,0,,Не? Күте тұрыңыз... Әуе түні
Dialogue: 0,0:15:56.28,0:15:58.45,Default,,0,0,0,,Сіз шынымен ауада ұшып жүрсіз бе?
Dialogue: 0,0:15:58.79,0:15:59.95,Default,,0,0,0,,Бұл не? Ах...
Dialogue: 0,0:16:04.21,0:16:05.79,Default,,0,0,0,,Бұл маңызды емес!
Dialogue: 0,0:16:06.21,0:16:08.50,Default,,0,0,0,,Ахиллес, сындыр!
Dialogue: 0,0:16:08.80,0:16:10.42,Default,,0,0,0,,Ауа ату!
Dialogue: 0,0:16:14.68,0:16:15.51,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:16:17.72,0:16:19.01,Default,,0,0,0,,Алда көп нәрсе бар!
Dialogue: 0,0:16:19.60,0:16:21.85,Default,,0,0,0,,Ахиллеске шабуыл жасаңыз!
Dialogue: 0,0:16:22.98,0:16:26.36,Default,,0,0,0,,Эйр рыцарь Ахиллесті босата береді!
Dialogue: 0,0:16:26.48,0:16:28.27,Default,,0,0,0,,Темірдей күзетші!
Dialogue: 0,0:16:29.02,0:16:30.90,Default,,0,0,0,,Ах (Токонацу) Мен мұндай нәрсе болады деп күтпедім...
Dialogue: 0,0:16:35.78,0:16:38.20,Default,,0,0,0,,Жел тек қорғаныс үшін ғана емес.
Dialogue: 0,0:16:38.78,0:16:39.66,Default,,0,0,0,,Әуе түні!
Dialogue: 0,0:16:44.42,0:16:46.38,Default,,0,0,0,,Жүр!
Dialogue: 0,0:16:46.67,0:16:49.42,Default,,0,0,0,,Super Z Slash!
Dialogue: 0,0:16:54.88,0:16:56.30,Default,,0,0,0,,Маған да біреуін оқып бер
Dialogue: 0,0:16:56.64,0:16:58.51,Default,,0,0,0,,Мен оның келе жатқанын білдім.
Dialogue: 0,0:16:58.64,0:16:59.47,Default,,0,0,0,,Не!
Dialogue: 0,0:16:59.76,0:17:02.14,Default,,0,0,0,,Түнгі ұшқыш!
Dialogue: 0,0:17:04.94,0:17:05.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:05.98,0:17:10.27,Default,,0,0,0,,Әуе рыцарь аспанға соғып жатыр... Ол ауада қалықтап тұр!
Dialogue: 0,0:17:10.40,0:17:14.03,Default,,0,0,0,,Осымен Ахиллестің шабуылы Air Knight-қа тимейді!
Dialogue: 0,0:17:14.36,0:17:17.78,Default,,0,0,0,,Ахиллес шыдамдылығын тез жоғалтады!
Dialogue: 0,0:17:18.20,0:17:19.03,Default,,0,0,0,,Әзірге үш минут
Dialogue: 0,0:17:23.70,0:17:25.00,Default,,0,0,0,,Оле!
Dialogue: 0,0:17:25.54,0:17:27.67,Default,,0,0,0,,Түнгі ауада айналдыру аяқталуы
Dialogue: 0,0:17:27.88,0:17:29.79,Default,,0,0,0,,1-ден 0-ге дейінгі нүктелер!
Dialogue: 0,0:17:29.92,0:17:32.55,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:33.51,0:17:34.76,Default,,0,0,0,,Тағы да әуеніңді бұздың! Қанша рет айтуым керек саған түсіну үшін!—
Dialogue: 0,0:17:35.13,0:17:36.84,Default,,0,0,0,,Бұл жел пайдаланушысы ма?
Dialogue: 0,0:17:37.51,0:17:38.51,Default,,0,0,0,,Айга…
Dialogue: 0,0:17:38.64,0:17:40.01,Default,,0,0,0,,Тағы бір нүкте
Dialogue: 0,0:17:40.14,0:17:41.51,Default,,0,0,0,,Осы жерден
Dialogue: 0,0:17:41.64,0:17:44.52,Default,,0,0,0,,Айғаны екеуің де қолдайсыңдар ма?
Dialogue: 0,0:17:44.64,0:17:45.98,Default,,0,0,0,,Әрине, солай ма?
Dialogue: 0,0:17:46.39,0:17:49.86,Default,,0,0,0,,Кит – дос, Айға – серік.
Dialogue: 0,0:17:52.48,0:17:54.49,Default,,0,0,0,,Жақсы ағын, жинақ.
Dialogue: 0,0:17:55.11,0:17:58.61,Default,,0,0,0,,Бірақ... Айға осы жерден келеді.
Dialogue: 0,0:17:59.95,0:18:01.12,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:18:01.78,0:18:04.87,Default,,0,0,0,,Мен Super Z-Awaken мүмкіндігіне ие болсам да, неге?
Dialogue: 0,0:18:05.41,0:18:06.79,Default,,0,0,0,,Ахиллес…
Dialogue: 0,0:18:10.25,0:18:12.38,Default,,0,0,0,,Асығыссың, Айға.
Dialogue: 0,0:18:13.05,0:18:15.09,Default,,0,0,0,,Екінші шайқаста шешіңіз!
Dialogue: 0,0:18:15.96,0:18:19.26,Default,,0,0,0,,Маған резонансымызды көрсетейін.
Dialogue: 0,0:18:20.18,0:18:22.89,Default,,0,0,0,,Айға Жеңілісіңді ұстама
Dialogue: 0,0:18:23.97,0:18:25.02,Default,,0,0,0,,Қайта құру
Dialogue: 0,0:18:26.68,0:18:28.52,Default,,0,0,0,,Келесі - жоғары шабуыл.
Dialogue: 0,0:18:31.40,0:18:34.53,Default,,0,0,0,,Сол желдің қабырғасын қиратайық.
Dialogue: 0,0:18:35.15,0:18:37.40,Default,,0,0,0,,Айга жүргізушіні көтерді
Dialogue: 0,0:18:37.82,0:18:39.91,Default,,0,0,0,,Мен тез ұрысамын.
Dialogue: 0,0:18:40.11,0:18:41.53,Default,,0,0,0,,Олай етпе!
Dialogue: 0,0:18:41.99,0:18:43.53,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:18:43.95,0:18:47.29,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:47.62,0:18:50.04,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:50.54,0:18:51.38,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:54.75,0:18:56.88,Default,,0,0,0,,Жақсы! Біз осылайша шабуыл жасай аламыз!
Dialogue: 0,0:19:01.14,0:19:03.64,Default,,0,0,0,,Әуе түні! Түнгі мега соққы!
Dialogue: 0,0:19:07.85,0:19:08.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:09.39,0:19:11.15,Default,,0,0,0,,Бұл әуе рыцарь!
Dialogue: 0,0:19:11.60,0:19:12.90,Default,,0,0,0,,Нуван және не!
Dialogue: 0,0:19:13.02,0:19:16.61,Default,,0,0,0,,Air Knight айналасында орасан зор ауа ағыны жүріп жатыр!
Dialogue: 0,0:19:16.73,0:19:17.69,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:19:18.03,0:19:20.32,Default,,0,0,0,,Ахиллес ауа ағынының құйынына түсті.
Dialogue: 0,0:19:20.45,0:19:22.87,Default,,0,0,0,,А... мені жұтып жатыр!
Dialogue: 0,0:19:23.95,0:19:27.29,Default,,0,0,0,,Ахиллес Эйр Найттың бақылауында болды!
Dialogue: 0,0:19:27.70,0:19:28.54,Default,,0,0,0,,Не!
Dialogue: 0,0:19:29.12,0:19:33.04,Default,,0,0,0,,Эйр Найт Ахиллесті басқаратын сияқты!
Dialogue: 0,0:19:33.63,0:19:35.54,Default,,0,0,0,,Ах... (Сочо) Бұл ақылсыз!
Dialogue: 0,0:19:35.92,0:19:39.01,Default,,0,0,0,,Ахиллес Бұлай берілме!
Dialogue: 0,0:19:39.92,0:19:42.09,Default,,0,0,0,,Оны шайқаңыз!
Dialogue: 0,0:19:44.43,0:19:48.06,Default,,0,0,0,,О, Ахиллес! Мен Air Night бағдарламасынан шықтым!
Dialogue: 0,0:19:48.22,0:19:50.52,Default,,0,0,0,,Уууу!
Dialogue: 0,0:19:51.23,0:19:53.81,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:19:55.77,0:19:57.86,Default,,0,0,0,,Ооо...
Dialogue: 0,0:19:58.07,0:19:59.11,Default,,0,0,0,,Әй!
Dialogue: 0,0:19:59.69,0:20:03.11,Default,,0,0,0,,Ал нысанаға бекітіңіз!
Dialogue: 0,0:20:03.86,0:20:05.20,Default,,0,0,0,,Бұлай етпе Айға
Dialogue: 0,0:20:05.62,0:20:07.62,Default,,0,0,0,,Бірақ біз жеңілмейміз!
Dialogue: 0,0:20:08.24,0:20:12.41,Default,,0,0,0,,Уау! Әуе түні!
Dialogue: 0,0:20:17.67,0:20:20.09,Default,,0,0,0,,Super Z Buster!
Dialogue: 0,0:20:20.55,0:20:23.63,Default,,0,0,0,,Әуе рыцарь Желмен жүр!
Dialogue: 0,0:20:24.22,0:20:27.76,Default,,0,0,0,,Ват! Air Knight қабылданбады!
Dialogue: 0,0:20:27.89,0:20:29.81,Default,,0,0,0,,Ал... Ахилл де ұшты!
Dialogue: 0,0:20:29.93,0:20:32.43,Default,,0,0,0,,Бұл бір уақытта аяқтау ма?
Dialogue: 0,0:20:32.68,0:20:34.69,Default,,0,0,0,,Ахиллес, отыр!
Dialogue: 0,0:20:35.19,0:20:36.94,Default,,0,0,0,,Ұш! Әуе түні!
Dialogue: 0,0:20:37.61,0:20:39.73,Default,,0,0,0,,Түнгі ұшқыш!
Dialogue: 0,0:20:40.94,0:20:43.70,Default,,0,0,0,,Бұл мен және Эйр Найт арасындағы резонанс!
Dialogue: 0,0:20:48.37,0:20:49.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:50.49,0:20:51.70,Default,,0,0,0,,Оле!
Dialogue: 0,0:20:52.50,0:20:54.87,Default,,0,0,0,,Аяқтаудағы түн
Dialogue: 0,0:20:55.00,0:20:58.71,Default,,0,0,0,,Кит Лопес 2-0 ұпаймен жеңді!
Dialogue: 0,0:20:58.84,0:21:00.59,Default,,0,0,0,,Не, не
Dialogue: 0,0:21:00.71,0:21:04.42,Default,,0,0,0,,Super Z Ахиллес әуе рыцарына айналды!
Dialogue: 0,0:21:04.55,0:21:07.47,Default,,0,0,0,,Кит Лопес керемет!
Dialogue: 0,0:21:07.59,0:21:10.72,Default,,0,0,0,,Жел қолданушының рыцарь мақтан тұтады!
Dialogue: 0,0:21:10.85,0:21:13.73,Default,,0,0,0,,Super Z Ахиллес сәтті өлтірілді!
Dialogue: 0,0:21:14.31,0:21:18.73,Default,,0,0,0,,Үлкен ағаға қарсы шығу құқығы маған және Эйр Найтқа беріледі.
Dialogue: 0,0:21:19.56,0:21:20.40,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:21:29.24,0:21:32.16,Default,,0,0,0,,Әуе түні көңілді болды
Dialogue: 0,0:21:37.87,0:21:40.92,Default,,0,0,0,,Әлі де жетпейді... біз
Dialogue: 0,0:21:42.71,0:21:47.38,Default,,0,0,0,,Мен саған лайық жүзім екенімді көрсетемін.
Dialogue: 0,0:21:55.18,0:22:01.19,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:18.68,0:23:24.69,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.36,0:23:29.74,Default,,0,0,0,,Фи мен жүректер ақыры соқтығысты!
Dialogue: 0,0:23:30.03,0:23:31.28,Default,,0,0,0,,Ал біз
Dialogue: 0,0:23:31.40,0:23:33.78,Default,,0,0,0,,Біз қорқынышты шайқас көреміз.
Dialogue: 0,0:23:34.24,0:23:36.20,Default,,0,0,0,,Ағайындылар соншалықты барады ма?
Dialogue: 0,0:23:36.54,0:23:38.66,Default,,0,0,0,,Олардың өткенінде не болды?
Dialogue: 0,0:23:39.66,0:23:42.17,Default,,0,0,0,,Келесі жолы «Beyblade Burst Super Zetsu»
Dialogue: 0,0:23:42.29,0:23:44.00,Default,,0,0,0,,«Жын патшасы (Жүректер) Құдайға қарсы !!»
Dialogue: 0,0:23:44.63,0:23:46.50,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:46.75,0:23:48.84,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:50.34,0:23:56.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory