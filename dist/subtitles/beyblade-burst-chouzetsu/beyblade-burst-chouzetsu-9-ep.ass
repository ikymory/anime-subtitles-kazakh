Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.71,0:00:04.25,Default,,0,0,0,,Бейблейд
Dialogue: 0,0:00:04.33,0:00:08.13,Default,,0,0,0,,Мықты болуды мақсат еткен ұлдардың арманының жемісі.
Dialogue: 0,0:00:08.92,0:00:12.42,Default,,0,0,0,,Енді супер Цетсу дәуірі басталады.
Dialogue: 0,0:00:12.55,0:00:16.80,Default,,0,0,0,,Металл сауытыңызды киіңіз де, Беймен шытырман оқиғаға аттаныңыз!
Dialogue: 0,0:00:16.97,0:00:19.10,Default,,0,0,0,,Әлем чемпионы болуды мақсат етіңіз!
Dialogue: 0,0:00:19.35,0:00:23.69,Default,,0,0,0,,Super Zetsu Super Zetsu Super Zetsu!
Dialogue: 0,0:00:24.31,0:00:28.15,Default,,0,0,0,,Ең күшті және жеңілмейтін атағын алатын адам сенсің!
Dialogue: 0,0:00:32.61,0:00:37.03,Default,,0,0,0,,Goshuin Suoh's Bay Health Salamander аяқталды!
Dialogue: 0,0:00:42.33,0:00:44.46,Default,,0,0,0,,Өрт құйын Гекирин
Dialogue: 0,0:00:53.97,0:00:55.30,Default,,0,0,0,,Рагнарук апаты -
Dialogue: 0,0:00:55.38,0:00:59.01,Default,,0,0,0,,Металл қанат жабылып, жарылып қалды!
Dialogue: 0,0:01:00.68,0:01:03.31,Default,,0,0,0,,Суоу! Менің Ахиллесіммен жарысатын кез келді!
Dialogue: 0,0:01:03.89,0:01:05.64,Default,,0,0,0,,Менің қалағаным осы
Dialogue: 0,0:01:09.11,0:01:10.94,Default,,0,0,0,,Иә! Ха...
Dialogue: 0,0:01:12.94,0:01:16.45,Default,,0,0,0,,Кенран тозақтан құлады!
Dialogue: 0,0:01:18.74,0:01:19.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:22.24,0:01:24.70,Default,,0,0,0,,Ширасадиджо Луимен шайқас алдында
Dialogue: 0,0:01:24.79,0:01:27.04,Default,,0,0,0,,Ұратын біреу бар!
Dialogue: 0,0:01:27.25,0:01:31.67,Default,,0,0,0,,Қараңдар, мен бәріңді құртамын!
Dialogue: 0,0:01:32.46,0:01:38.47,Default,,0,0,0,,♪~
Dialogue: 0,0:02:55.13,0:03:01.13,Default,,0,0,0,,~♪
Dialogue: 0,0:03:01.89,0:03:04.43,Default,,0,0,0,,«От құйын Гекирин!»
Dialogue: 0,0:03:06.64,0:03:08.68,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:03:13.81,0:03:16.27,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:03:16.77,0:03:18.28,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:03:18.82,0:03:22.53,Default,,0,0,0,,Келесі жолы мен ол бейбақты міндетті түрде жеңемін!
Dialogue: 0,0:03:22.61,0:03:23.57,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:03:24.37,0:03:25.28,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:27.16,0:03:28.08,Default,,0,0,0,,Айга~!
Dialogue: 0,0:03:28.54,0:03:29.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:29.50,0:03:31.92,Default,,0,0,0,,Bay News басталады~
Dialogue: 0,0:03:32.25,0:03:33.21,Default,,0,0,0,,О
Dialogue: 0,0:03:33.63,0:03:35.79,Default,,0,0,0,,Иә Орамал Рахмет
Dialogue: 0,0:03:37.92,0:03:40.26,Default,,0,0,0,,Жарайды! Ұлдар мен қыздар!
Dialogue: 0,0:03:40.84,0:03:42.76,Default,,0,0,0,,Bay News уақыты келді!
Dialogue: 0,0:03:43.34,0:03:45.35,Default,,0,0,0,,Лонгинус кубогының екінші кезеңі -
Dialogue: 0,0:03:45.43,0:03:48.22,Default,,0,0,0,,Бұл бүкіл Азияда өте қызықты.
Dialogue: 0,0:03:48.39,0:03:52.73,Default,,0,0,0,,Қызу шайқаста екінші раундтан тез өткен Блейдер
Dialogue: 0,0:03:52.81,0:03:56.27,Default,,0,0,0,,Иә, оның аты – Оу Хоуи!
Dialogue: 0,0:03:56.40,0:03:58.48,Default,,0,0,0,,Ол садақ ату әлемінде әйгілі...
Dialogue: 0,0:03:58.57,0:04:02.07,Default,,0,0,0,,Бейблейдпен де керемет күшті көрсетеді
Dialogue: 0,0:04:02.20,0:04:05.07,Default,,0,0,0,,Ол Бладерстің арманы.
Dialogue: 0,0:04:05.20,0:04:09.45,Default,,0,0,0,,Айга Бұл адам алдын ала жарыста керемет рекордқа ие болды, солай ма?
Dialogue: 0,0:04:09.58,0:04:12.58,Default,,0,0,0,,Хе! Менен онша айырмашылығы жоқ.
Dialogue: 0,0:04:12.66,0:04:16.50,Default,,0,0,0,,Нағыз харизматикалық! Оу Хоуи - жеңіске жетудің бірінші фавориті!
Dialogue: 0,0:04:16.58,0:04:19.75,Default,,0,0,0,,Бар жақсылықты тілеймін. Қайта кездескенше!
Dialogue: 0,0:04:20.09,0:04:21.97,Default,,0,0,0,,Сіз жеңімпаз кандидатсыз ба?
Dialogue: 0,0:04:22.09,0:04:25.26,Default,,0,0,0,,Мен міндетті түрде жеңетін адаммын!
Dialogue: 0,0:04:27.93,0:04:30.64,Default,,0,0,0,,Мен ешқашан Сууды қарсыласым деп ойламадым.
Dialogue: 0,0:04:30.97,0:04:32.52,Default,,0,0,0,,Сәттілік жоқ.
Dialogue: 0,0:04:32.64,0:04:34.39,Default,,0,0,0,,Біз әлі жеңілген жоқпыз.
Dialogue: 0,0:04:34.85,0:04:36.27,Default,,0,0,0,,Мәңгілік жаз…
Dialogue: 0,0:04:36.40,0:04:37.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:37.44,0:04:39.07,Default,,0,0,0,,Қаттырақ бол, Саламандер!
Dialogue: 0,0:04:42.65,0:04:44.20,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:04:44.82,0:04:46.86,Default,,0,0,0,,Трайденттің ең үлкен қаруы-
Dialogue: 0,0:04:46.95,0:04:50.33,Default,,0,0,0,,Бұл жерде қарсыластың шабуылы айналмалы күшке айналады.
Dialogue: 0,0:04:50.45,0:04:51.37,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:04:51.62,0:04:52.45,Default,,0,0,0,,Иә
Dialogue: 0,0:04:52.83,0:04:55.67,Default,,0,0,0,,Басқаша айтқанда, ортаны саламандрге қарағанда тезірек алыңыз.
Dialogue: 0,0:04:55.75,0:04:58.75,Default,,0,0,0,,Егер сіз оны төзімділік шайқасына айналдырсаңыз, сізде жеңіске жету мүмкіндігі болады.
Dialogue: 0,0:04:58.84,0:04:59.75,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:05:00.09,0:05:02.26,Default,,0,0,0,,Мен осы мақсат үшін арнайы дайындықты қалаймын.
Dialogue: 0,0:05:03.26,0:05:04.26,Default,,0,0,0,,Жарайды
Dialogue: 0,0:05:05.13,0:05:06.55,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:05:07.22,0:05:08.09,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:05:08.97,0:05:10.14,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:05:11.93,0:05:13.60,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:05:14.02,0:05:17.19,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:05:17.81,0:05:20.11,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:05:20.44,0:05:21.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:30.49,0:05:31.24,Default,,0,0,0,,Гррр…
Dialogue: 0,0:05:31.58,0:05:34.37,Default,,0,0,0,,Император Форнейдің жарылуы аяқталды
Dialogue: 0,0:05:36.04,0:05:39.08,Default,,0,0,0,,Орталыққа жетуге тым кеш. Тезірек жасаңыз.
Dialogue: 0,0:05:39.63,0:05:41.59,Default,,0,0,0,,Тағы бір рет, өтінемін!
Dialogue: 0,0:05:43.00,0:05:44.80,Default,,0,0,0,,Түсіру жағдайына көбірек назар аударыңыз!
Dialogue: 0,0:05:45.05,0:05:46.97,Default,,0,0,0,,Уф... тағы бір рет!
Dialogue: 0,0:05:48.51,0:05:51.43,Default,,0,0,0,,Ату кезінде төменгі денеңізге көбірек қуат беріңіз!
Dialogue: 0,0:05:54.27,0:05:55.35,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:55.48,0:05:56.56,Default,,0,0,0,,Мәңгілік жаз…
Dialogue: 0,0:05:57.73,0:05:58.85,Default,,0,0,0,,Барлығы осы
Dialogue: 0,0:05:59.23,0:06:00.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:00.48,0:06:03.23,Default,,0,0,0,,Ату формасын өз бетінше жасай алмайды
Dialogue: 0,0:06:05.28,0:06:06.44,Default,,0,0,0,,Тс… Тағы да кірлеп кетті.
Dialogue: 0,0:06:07.99,0:06:10.91,Default,,0,0,0,,Жауапты өзіңіз анықтауыңыз керек.
Dialogue: 0,0:06:13.91,0:06:15.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:18.37,0:06:21.33,Default,,0,0,0,,Бұл машина мұны істей алады.
Dialogue: 0,0:06:21.46,0:06:23.50,Default,,0,0,0,,Осының көмегімен шығанақ бұлшықеттерін жаттықтырыңыз!
Dialogue: 0,0:06:24.00,0:06:26.05,Default,,0,0,0,,Я~
Dialogue: 0,0:06:26.13,0:06:26.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:27.30,0:06:29.26,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:06:34.68,0:06:35.81,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:47.32,0:06:50.32,Default,,0,0,0,,Токонацу-кун, біртүрлі болып қалды.
Dialogue: 0,0:06:50.49,0:06:51.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:51.74,0:06:54.20,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:06:57.70,0:06:58.79,Default,,0,0,0,,Мәңгілік жаз…
Dialogue: 0,0:06:58.87,0:07:00.29,Default,,0,0,0,,Не болды, Токонацу Аой!
Dialogue: 0,0:07:00.29,0:07:00.75,Default,,0,0,0,,Не болды, Токонацу Аой!
Dialogue: 0,0:07:00.29,0:07:00.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:00.75,0:07:01.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:01.46,0:07:03.25,Default,,0,0,0,,Ол жеңіл атлетика үйірмесіне өзгерді ме?
Dialogue: 0,0:07:03.33,0:07:05.63,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:07:06.17,0:07:07.34,Default,,0,0,0,,Хаха
Dialogue: 0,0:07:08.21,0:07:10.13,Default,,0,0,0,,Бұл қандай бет?
Dialogue: 0,0:07:10.34,0:07:13.47,Default,,0,0,0,,Екінші раундтағы қарсыласың Суох болғандықтан қорқасың ба?
Dialogue: 0,0:07:13.59,0:07:15.35,Default,,0,0,0,,Цубаки суық тигізіп алды ма!?
Dialogue: 0,0:07:15.47,0:07:17.60,Default,,0,0,0,,Мен капитанға арнайы дайындықты тапсырдым, бірақ...
Dialogue: 0,0:07:17.68,0:07:18.98,Default,,0,0,0,,Йосе Хинацу
Dialogue: 0,0:07:19.64,0:07:22.94,Default,,0,0,0,,Жауабын өзің табу керек
Dialogue: 0,0:07:23.94,0:07:25.27,Default,,0,0,0,,Хмм.
Dialogue: 0,0:07:25.77,0:07:29.11,Default,,0,0,0,,Жақсы! Мен де тәжірибелік серіктес іздедім.
Dialogue: 0,0:07:29.44,0:07:30.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:30.40,0:07:31.57,Default,,0,0,0,,Біраз уақыт қыдырайық!
Dialogue: 0,0:07:32.49,0:07:35.45,Default,,0,0,0,,Мен Сукунды бірінші рет көріп тұрмын.
Dialogue: 0,0:07:35.58,0:07:38.49,Default,,0,0,0,,Қорқатын ештеңе жоқ.
Dialogue: 0,0:07:38.62,0:07:39.70,Default,,0,0,0,,Саламандр болса да
Dialogue: 0,0:07:39.79,0:07:42.54,Default,,0,0,0,,Шабуыл мен қорғаныс құралдарын ауыстыра білу...
Dialogue: 0,0:07:42.62,0:07:44.63,Default,,0,0,0,,Екінші жағынан, сіз саңылау жасай аласыз.
Dialogue: 0,0:07:44.88,0:07:48.75,Default,,0,0,0,,Шабуыл режимінде қорғаныс пен төзімділік әлсіз нүктеге айналады...
Dialogue: 0,0:07:48.84,0:07:52.51,Default,,0,0,0,,Қорғаныс режимінде сіздің шабуыл күшіңіз сіздің әлсіздігіңізге айналады.
Dialogue: 0,0:07:52.59,0:07:55.26,Default,,0,0,0,,Шатаспаңыз, бастайық!
Dialogue: 0,0:07:58.56,0:07:59.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:59.68,0:08:01.77,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:01.89,0:08:05.73,Default,,0,0,0,,Түсіру жылдамдығын арттырып, ортаға тез жетіңіз
Dialogue: 0,0:08:06.23,0:08:08.07,Default,,0,0,0,,Мен мұны істеуге тырысамын...
Dialogue: 0,0:08:08.69,0:08:10.99,Default,,0,0,0,,Тыңда, үштұмсық – шыдамды.
Dialogue: 0,0:08:11.11,0:08:14.45,Default,,0,0,0,,Бұл Salamander бір-бірімен үйлесімді шабуылдармен келеді дегенді білдіреді.
Dialogue: 0,0:08:14.57,0:08:17.78,Default,,0,0,0,,Оның шабуылы өте күшті.
Dialogue: 0,0:08:17.87,0:08:21.62,Default,,0,0,0,,Егер сіз оны айналу күшін арттыру үшін қолдансаңыз, ол сіздікі!
Dialogue: 0,0:08:22.04,0:08:25.12,Default,,0,0,0,,Бірақ бұл шабуылға төтеп беру мүмкін емес деп ойлаймын...
Dialogue: 0,0:08:25.46,0:08:27.92,Default,,0,0,0,,Бастамас бұрын берілме
Dialogue: 0,0:08:28.04,0:08:29.59,Default,,0,0,0,,Қараңдар! Тағы бір рет
Dialogue: 0,0:08:31.17,0:08:33.38,Default,,0,0,0,,Мен Суохты міндетті түрде жеңемін!
Dialogue: 0,0:08:33.84,0:08:36.51,Default,,0,0,0,,Менің қарсыласым – мен.
Dialogue: 0,0:08:36.59,0:08:40.01,Default,,0,0,0,,Мен бұны киемін… жетімдер үйінде өткізген күндерімді ұмытпау үшін.
Dialogue: 0,0:08:45.10,0:08:46.10,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:08:46.48,0:08:48.94,Default,,0,0,0,,Келесі жолы мен мүлде жеңілмеймін!
Dialogue: 0,0:08:49.27,0:08:51.82,Default,,0,0,0,,Мен бұны киемін… жетімдер үйінде өткізген күндерімді ұмытпау үшін.
Dialogue: 0,0:08:53.74,0:08:54.65,Default,,0,0,0,,О...
Dialogue: 0,0:08:54.74,0:08:57.11,Default,,0,0,0,,Әй, қалғандарына не болды?
Dialogue: 0,0:08:57.24,0:08:59.28,Default,,0,0,0,,Барлық зейнетке шыққандар орта жолда.
Dialogue: 0,0:08:59.41,0:09:01.33,Default,,0,0,0,,Сочо! (2 адам) Иә?
Dialogue: 0,0:08:59.41,0:09:01.33,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:09:01.33,0:09:01.41,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:09:01.41,0:09:02.70,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:09:01.41,0:09:02.70,Default,,0,0,0,,Ха... Ақыры жеттім.
Dialogue: 0,0:09:02.70,0:09:03.70,Default,,0,0,0,,Ха... Ақыры жеттім.
Dialogue: 0,0:09:04.04,0:09:06.42,Default,,0,0,0,,Егер мен төте жолды қолдансам, жақсы жаттығу болмас еді!
Dialogue: 0,0:09:07.17,0:09:09.09,Default,,0,0,0,,Хехе, білдің бе?
Dialogue: 0,0:09:09.21,0:09:10.17,Default,,0,0,0,,Дари…
Dialogue: 0,0:09:11.50,0:09:12.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:13.26,0:09:14.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:14.63,0:09:16.13,Default,,0,0,0,,Жақсы аулау!
Dialogue: 0,0:09:16.59,0:09:17.64,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:17.76,0:09:20.39,Default,,0,0,0,,Теме мен басқалардың шайқаста жүргенін сирек кездестіруге болады.
Dialogue: 0,0:09:20.72,0:09:23.98,Default,,0,0,0,,Мен Гошуин Суудан жеңіске жету үшін арнайы дайындық жүргіздім.
Dialogue: 0,0:09:24.10,0:09:25.81,Default,,0,0,0,,Қараңыз (Токонацу) Рахмет
Dialogue: 0,0:09:26.06,0:09:29.11,Default,,0,0,0,,Бұл жігітпен арнайы жаттығу сізге жақсылық әкелмейді.
Dialogue: 0,0:09:29.23,0:09:31.27,Default,,0,0,0,,Шу шығарыңыз! Менің тарапымнан сөйлеме!
Dialogue: 0,0:09:31.69,0:09:35.15,Default,,0,0,0,,Тыңдаңыз, Суох шыдамдылық түріне қарсы.
Dialogue: 0,0:09:35.28,0:09:36.74,Default,,0,0,0,,Ол шабуыл режимінде болуы керек.
Dialogue: 0,0:09:36.82,0:09:38.70,Default,,0,0,0,,Мен мұны жоғарыда айттым.
Dialogue: 0,0:09:38.78,0:09:41.03,Default,,0,0,0,,Сөздердің салмағы тақырыптан өзгеше.
Dialogue: 0,0:09:41.12,0:09:42.24,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:42.70,0:09:44.33,Default,,0,0,0,,Саламандр шабуылынан аман қалу
Dialogue: 0,0:09:44.45,0:09:46.54,Default,,0,0,0,,Егер сіз оны төзімділік шайқасына айналдырсаңыз, сізде мүмкіндік бар.
Dialogue: 0,0:09:46.66,0:09:49.71,Default,,0,0,0,,Тыңдаңыз, тек шыдамдылық танытыңыз!
Dialogue: 0,0:09:49.83,0:09:50.71,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:09:51.04,0:09:54.80,Default,,0,0,0,,Айғаның кеңесі жақсырақ сияқты.
Dialogue: 0,0:09:54.88,0:09:55.84,Default,,0,0,0,,Аа…
Dialogue: 0,0:09:56.05,0:09:57.97,Default,,0,0,0,,Жарайды, нағыз шайқас болсын!
Dialogue: 0,0:09:58.05,0:09:59.72,Default,,0,0,0,,Маған кедергі жасама!
Dialogue: 0,0:10:00.18,0:10:02.14,Default,,0,0,0,,Кедергі болма, Теме.
Dialogue: 0,0:10:02.22,0:10:03.68,Default,,0,0,0,,Ахиллестің шабуылы жақсырақ
Dialogue: 0,0:10:03.76,0:10:04.52,Default,,0,0,0,,Қарқынды...
Dialogue: 0,0:10:04.60,0:10:06.39,Default,,0,0,0,,А? Мен пайдалырақпын.
Dialogue: 0,0:10:06.48,0:10:07.39,Default,,0,0,0,,Көресіңдер әлі
Dialogue: 0,0:10:07.60,0:10:10.10,Default,,0,0,0,,Мен Рагнаруктың күштірек екеніне сенімдімін!
Dialogue: 0,0:10:10.19,0:10:11.11,Default,,0,0,0,,Тіпті Ахиллес!
Dialogue: 0,0:10:11.56,0:10:13.44,Default,,0,0,0,,Оны ауыстыру ретінде орындау керек.
Dialogue: 0,0:10:11.56,0:10:13.44,Default,,0,0,0,,Не? Бұл не?
Dialogue: 0,0:10:13.44,0:10:13.52,Default,,0,0,0,,Мұны тек сіздің атыңыздан жасаңыз.
Dialogue: 0,0:10:13.52,0:10:14.07,Default,,0,0,0,,Сіз оны ауыстыру банкі ретінде жасай аласыз.
Dialogue: 0,0:10:13.52,0:10:14.07,Default,,0,0,0,,(аргумент)
Dialogue: 0,0:10:14.07,0:10:14.19,Default,,0,0,0,,(аргумент)
Dialogue: 0,0:10:14.19,0:10:15.36,Default,,0,0,0,,(аргумент)
Dialogue: 0,0:10:14.19,0:10:15.36,Default,,0,0,0,,Сіз жассыз.
Dialogue: 0,0:10:15.36,0:10:16.65,Default,,0,0,0,,(аргумент)
Dialogue: 0,0:10:16.65,0:10:18.61,Default,,0,0,0,,(аргумент)
Dialogue: 0,0:10:16.65,0:10:18.61,Default,,0,0,0,,(Бүкіл Құдірет-тың ауыр демі)
Dialogue: 0,0:10:18.70,0:10:19.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:19.66,0:10:22.49,Default,,0,0,0,,Мен Су-кунды міндетті түрде жеңемін.
Dialogue: 0,0:10:23.16,0:10:24.33,Default,,0,0,0,,Бізді ешкім қумайды. Жүрейік.
Dialogue: 0,0:10:24.45,0:10:27.25,Default,,0,0,0,,Анау тәкаппар жігітке көпіршіктерді үрлейік!
Dialogue: 0,0:10:27.50,0:10:29.46,Default,,0,0,0,,Жарайсыңдар, арнайы тренинг жалғасуда!
Dialogue: 0,0:10:29.58,0:10:30.58,Default,,0,0,0,,Менен бастаңыз.
Dialogue: 0,0:10:30.67,0:10:31.83,Default,,0,0,0,,Мен біріншімін
Dialogue: 0,0:10:31.96,0:10:34.13,Default,,0,0,0,,Хинацу-чан, ертең кездескенше (Хинатсу) Иә.
Dialogue: 0,0:10:31.96,0:10:34.13,Default,,0,0,0,,Не? (Ранджиро) Мен бірінші...
Dialogue: 0,0:10:52.61,0:10:53.65,Default,,0,0,0,,Фу…
Dialogue: 0,0:10:54.69,0:10:57.40,Default,,0,0,0,,Жарайды! Ұлдар мен қыздар!
Dialogue: 0,0:10:57.49,0:11:00.15,Default,,0,0,0,,Лонгинус кубогының екінші кезеңі қызықты өтуде!
Dialogue: 0,0:11:00.66,0:11:04.16,Default,,0,0,0,,Екінші айналымда кім жеңеді?
Dialogue: 0,0:11:04.45,0:11:06.66,Default,,0,0,0,,Z Buster!
Dialogue: 0,0:11:08.29,0:11:09.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:09.71,0:11:11.62,Default,,0,0,0,,Сіз екінші турдан өттіңіз.
Dialogue: 0,0:11:11.87,0:11:13.04,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:13.17,0:11:14.59,Default,,0,0,0,,Айга керемет!
Dialogue: 0,0:11:14.92,0:11:17.42,Default,,0,0,0,,Желді темір қанаттарымен кесіңіз!
Dialogue: 0,0:11:17.55,0:11:20.47,Default,,0,0,0,,Рагнарук тайфуны!
Dialogue: 0,0:11:25.05,0:11:26.89,Default,,0,0,0,,Не! Ахх...
Dialogue: 0,0:11:27.35,0:11:28.43,Default,,0,0,0,,Әрине, білемін.
Dialogue: 0,0:11:28.72,0:11:30.89,Default,,0,0,0,,Жарайды (Тобисуке) Сочо күткендей!
Dialogue: 0,0:11:31.19,0:11:33.52,Default,,0,0,0,,Император Дрейф!
Dialogue: 0,0:11:35.69,0:11:36.69,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:37.82,0:11:38.69,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:11:38.78,0:11:39.99,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:11:40.07,0:11:43.86,Default,,0,0,0,,Иә! Өткізу орны өте жанды.
Dialogue: 0,0:11:44.03,0:11:45.66,Default,,0,0,0,,Келесі шайқас...
Dialogue: 0,0:11:45.74,0:11:49.12,Default,,0,0,0,,Сол әлем чемпионы Барто Аоидың інісі
Dialogue: 0,0:11:49.20,0:11:52.21,Default,,0,0,0,,Токонацу Аоимен таныстыру!
Dialogue: 0,0:11:52.29,0:11:53.29,Default,,0,0,0,,Аа...
Dialogue: 0,0:11:55.88,0:11:57.46,Default,,0,0,0,,А... еңбектеріңізге рахмет.
Dialogue: 0,0:11:57.80,0:12:00.21,Default,,0,0,0,,Екінші турдан өткеніңізбен құттықтаймыз
Dialogue: 0,0:12:01.30,0:12:03.59,Default,,0,0,0,,Сіз енді қорықпайтын сияқтысыз.
Dialogue: 0,0:12:03.93,0:12:04.93,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:05.18,0:12:06.35,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз
Dialogue: 0,0:12:10.18,0:12:11.60,Default,,0,0,0,,Токонацу, қолыңнан келгеннің бәрін жаса!
Dialogue: 0,0:12:11.85,0:12:13.69,Default,,0,0,0,,Йонекома Гакуэн шығанағы клубы -
Dialogue: 0,0:12:13.77,0:12:16.36,Default,,0,0,0,,Бұл үлкен-кіші арасындағы жекпе-жек!
Dialogue: 0,0:12:16.56,0:12:19.57,Default,,0,0,0,,Гошуин Суу пайдаланған сауықтыру саламандры
Dialogue: 0,0:12:19.65,0:12:22.49,Default,,0,0,0,,Жұмбақ Бейді іс-әрекетте бірінші рет көріп отырмыз...
Dialogue: 0,0:12:22.57,0:12:24.36,Default,,0,0,0,,Куха~! Мен оны асыға күтемін!
Dialogue: 0,0:12:26.12,0:12:28.41,Default,,0,0,0,,Трайдент жасайық
Dialogue: 0,0:12:29.20,0:12:32.79,Default,,0,0,0,,Хмм... тым болмаса әдемі етіп шашып жіберейін.
Dialogue: 0,0:12:33.16,0:12:34.25,Default,,0,0,0,,Токонацу-кун!
Dialogue: 0,0:12:34.37,0:12:35.67,Default,,0,0,0,,Жаса!
Dialogue: 0,0:12:35.79,0:12:37.54,Default,,0,0,0,,Токонацу, қолыңнан келгеннің бәрін жаса!
Dialogue: 0,0:12:37.75,0:12:39.55,Default,,0,0,0,,Оны үрлеу үшін жігеріңізді жұмсаңыз!
Dialogue: 0,0:12:41.38,0:12:43.05,Default,,0,0,0,,Денсаулық Саламандар
Dialogue: 0,0:12:43.38,0:12:46.18,Default,,0,0,0,,Сол күшті көрсетейін.
Dialogue: 0,0:12:46.68,0:12:48.18,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:12:50.06,0:12:53.93,Default,,0,0,0,,Ол қай жолмен келеді? Шабуыл немесе қорғаныс?
Dialogue: 0,0:12:54.19,0:12:55.94,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:12:56.48,0:12:59.57,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:13:00.15,0:13:02.15,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:02.49,0:13:03.36,Default,,0,0,0,,Эй!
Dialogue: 0,0:13:06.45,0:13:08.03,Default,,0,0,0,,Қорғаныс режимі дайын!
Dialogue: 0,0:13:10.16,0:13:12.24,Default,,0,0,0,,Ах! (Ранджиро) Солай ма...
Dialogue: 0,0:13:12.75,0:13:13.62,Default,,0,0,0,,Хехе
Dialogue: 0,0:13:14.04,0:13:18.63,Default,,0,0,0,,Screw Trident Мен орталықты бірінші алдым!
Dialogue: 0,0:13:18.71,0:13:19.63,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:13:19.71,0:13:21.63,Default,,0,0,0,,Doori операциясы!
Dialogue: 0,0:13:21.96,0:13:23.63,Default,,0,0,0,,Шайқас осы жерден басталады
Dialogue: 0,0:13:26.93,0:13:29.05,Default,,0,0,0,,Бұрандалы триденттің резеңке...
Dialogue: 0,0:13:29.43,0:13:31.68,Default,,0,0,0,,Тозақ Саламандердің шабуылын пайдалану -
Dialogue: 0,0:13:31.81,0:13:33.81,Default,,0,0,0,,Айналуды арттырыңыз!
Dialogue: 0,0:13:34.14,0:13:37.06,Default,,0,0,0,,Осы үздіксіз шабуылға төтеп бере аласыз ба?
Dialogue: 0,0:13:40.02,0:13:40.94,Default,,0,0,0,,Шыда!
Dialogue: 0,0:13:42.61,0:13:43.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:51.41,0:13:54.29,Default,,0,0,0,,Айналдыру финишінің екеуі де бір уақытта тартылады!
Dialogue: 0,0:13:54.50,0:13:56.79,Default,,0,0,0,,Жарайды... мен істеймін.
Dialogue: 0,0:13:57.50,0:14:00.17,Default,,0,0,0,,Суу-кун мен... Сал
Dialogue: 0,0:14:00.58,0:14:02.34,Default,,0,0,0,,Керемет Токонацу!
Dialogue: 0,0:14:02.42,0:14:05.42,Default,,0,0,0,,Жарайды, жақсы. Келесіге өтіңіз!
Dialogue: 0,0:14:05.76,0:14:08.01,Default,,0,0,0,,Мен өзімді жақсы сезінемін.
Dialogue: 0,0:14:09.68,0:14:10.55,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:10.93,0:14:11.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:13.89,0:14:18.77,Default,,0,0,0,,Сенгісіз! Гошуин Суоның келбеті өзгерді!
Dialogue: 0,0:14:20.15,0:14:21.19,Default,,0,0,0,,Суоу…
Dialogue: 0,0:14:21.81,0:14:22.90,Default,,0,0,0,,Ол шықты
Dialogue: 0,0:14:23.36,0:14:24.28,Default,,0,0,0,,мыңжапырақ!
Dialogue: 0,0:14:24.86,0:14:26.28,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:14:26.90,0:14:29.66,Default,,0,0,0,,Бұл жолы шабуыл режимі.
Dialogue: 0,0:14:31.20,0:14:31.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:32.28,0:14:35.95,Default,,0,0,0,,Сізге шабуыл режимін пайдаланудың қажеті жоқ.
Dialogue: 0,0:14:36.62,0:14:37.62,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:37.83,0:14:39.54,Default,,0,0,0,,Не? О! Жоқ!
Dialogue: 0,0:14:39.62,0:14:43.21,Default,,0,0,0,,Гошуин Суоу Сіз қарсыласыңызға қолыңыздан келетін нәрсені көрсеттіңіз!
Dialogue: 0,0:14:43.59,0:14:45.50,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:14:45.75,0:14:48.67,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:14:49.26,0:14:51.39,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:14:55.06,0:14:55.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:56.39,0:14:59.69,Default,,0,0,0,,О! Иса! Саламандер төбелесіп жатыр!
Dialogue: 0,0:14:59.89,0:15:02.81,Default,,0,0,0,,Мен Suoh's Yarrow Shoot ойынын бұздым.
Dialogue: 0,0:15:02.94,0:15:04.19,Default,,0,0,0,,Замаа
Dialogue: 0,0:15:04.32,0:15:05.27,Default,,0,0,0,,Өйткені мен тірі жеп қойылудан шын мәнінде қорқамын
Dialogue: 0,0:15:05.36,0:15:06.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:06.53,0:15:08.32,Default,,0,0,0,,Ол бір нәрсені көздеп отыр
Dialogue: 0,0:15:11.57,0:15:13.53,Default,,0,0,0,,Орталықты кім бірінші алды?
Dialogue: 0,0:15:13.87,0:15:16.49,Default,,0,0,0,,Тридентті қайтадан бұраңыз!
Dialogue: 0,0:15:16.66,0:15:17.49,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:15:17.83,0:15:19.12,Default,,0,0,0,,Мен орталықты алдым!
Dialogue: 0,0:15:19.41,0:15:21.12,Default,,0,0,0,,Токонацу мен кете аламын!
Dialogue: 0,0:15:21.29,0:15:23.08,Default,,0,0,0,,Төзімділік шайқасын бастаңыз!
Dialogue: 0,0:15:27.17,0:15:28.01,Default,,0,0,0,,Фу…
Dialogue: 0,0:15:29.01,0:15:31.43,Default,,0,0,0,,Өрт құйын Гекирин!
Dialogue: 0,0:15:35.60,0:15:36.68,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:39.85,0:15:42.44,Default,,0,0,0,,Денсаулық Саламандр жарылысының аяқталуы
Dialogue: 0,0:15:42.56,0:15:44.69,Default,,0,0,0,,Жеңімпаз Гошуин Суо!
Dialogue: 0,0:15:44.81,0:15:45.69,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:15:46.02,0:15:49.44,Default,,0,0,0,,Сіз қорғаныс режимінде осындай шабуыл жасай аласыз ба?
Dialogue: 0,0:15:49.78,0:15:52.28,Default,,0,0,0,,Бейді әдейі жабайы қылдың ба?
Dialogue: 0,0:15:52.40,0:15:54.07,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:15:55.20,0:15:56.20,Default,,0,0,0,,Суо…
Dialogue: 0,0:15:56.66,0:15:58.58,Default,,0,0,0,,Бұл ауқым ма? (Токонацу) Уа...
Dialogue: 0,0:15:58.87,0:16:00.83,Default,,0,0,0,,Барто Аоидың інісі
Dialogue: 0,0:16:01.25,0:16:02.08,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:02.41,0:16:06.09,Default,,0,0,0,,Мен бұдан да әдемі әдістерді көремін деп үміттендім...
Dialogue: 0,0:16:06.38,0:16:07.25,Default,,0,0,0,,Ой!
Dialogue: 0,0:16:07.42,0:16:08.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:08.63,0:16:10.26,Default,,0,0,0,,Үлкен ағаның бұған қатысы жоқ!
Dialogue: 0,0:16:10.34,0:16:13.68,Default,,0,0,0,,Аа, Токонацу Аои - Токонацу Аои!
Dialogue: 0,0:16:14.13,0:16:15.30,Default,,0,0,0,,Айга...
Dialogue: 0,0:16:15.93,0:16:16.89,Default,,0,0,0,,Аа...
Dialogue: 0,0:16:18.51,0:16:22.18,Default,,0,0,0,,Енді кім жеңеді?
Dialogue: 0,0:16:22.27,0:16:23.64,Default,,0,0,0,,Азияның түкпір-түкпірінен
Dialogue: 0,0:16:23.73,0:16:25.98,Default,,0,0,0,,Екінші айналымнан өткен жүзушілер...
Dialogue: 0,0:16:26.06,0:16:27.94,Default,,0,0,0,,Біз Жапонияға ұмтыламыз!
Dialogue: 0,0:16:29.27,0:16:31.69,Default,,0,0,0,,Айға Сізге көп рахмет
Dialogue: 0,0:16:32.15,0:16:33.95,Default,,0,0,0,,А? Не?
Dialogue: 0,0:16:34.41,0:16:35.95,Default,,0,0,0,,Мен менмін...
Dialogue: 0,0:16:36.28,0:16:38.95,Default,,0,0,0,,Бұл сөздер мені қуантты.
Dialogue: 0,0:16:40.04,0:16:41.70,Default,,0,0,0,,Оме - Оме, солай ма?
Dialogue: 0,0:16:41.95,0:16:43.66,Default,,0,0,0,,Нәтиже жеңіліс болғанымен...
Dialogue: 0,0:16:43.79,0:16:47.67,Default,,0,0,0,,Бірде мен Су Кунмен тең түстім.
Dialogue: 0,0:16:47.79,0:16:49.50,Default,,0,0,0,,Сіздің арқаңызда менде сенімділік пайда болды.
Dialogue: 0,0:16:50.38,0:16:53.42,Default,,0,0,0,,Мен Барто Аоидың інісі болғандықтан, бұл туралы ештеңе айта алмаймын.
Dialogue: 0,0:16:53.55,0:16:55.01,Default,,0,0,0,,Бладер болыңыз
Dialogue: 0,0:16:55.30,0:16:57.18,Default,,0,0,0,,Әй, солай ғой.
Dialogue: 0,0:16:57.30,0:16:59.35,Default,,0,0,0,,Кез келген уақытта бірге жаттығу жасайық!
Dialogue: 0,0:17:00.14,0:17:01.02,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:06.15,0:17:07.52,Default,,0,0,0,,
Dialogue: 0,0:17:07.65,0:17:09.19,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:17:10.65,0:17:11.65,Default,,0,0,0,,Не?
Dialogue: 0,0:17:16.95,0:17:18.41,Default,,0,0,0,,Сәлем...сәлем
Dialogue: 0,0:17:19.20,0:17:20.41,Default,,0,0,0,,Не болды, Нару!
Dialogue: 0,0:17:20.49,0:17:21.91,Default,,0,0,0,,Айға... бұл
Dialogue: 0,0:17:23.25,0:17:24.62,Default,,0,0,0,,Иә? Жақсы!
Dialogue: 0,0:17:28.96,0:17:30.46,Default,,0,0,0,,Әй, ау
Dialogue: 0,0:17:30.92,0:17:31.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:33.88,0:17:34.80,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:17:36.01,0:17:36.93,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:38.51,0:17:39.89,Default,,0,0,0,,Бұл адамнан тыс күш...
Dialogue: 0,0:17:40.43,0:17:41.85,Default,,0,0,0,,Оу Хоуи.
Dialogue: 0,0:17:42.10,0:17:43.72,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:17:43.85,0:17:45.85,Default,,0,0,0,,Менің айтайын дегенім, не істеп жатырсың?!
Dialogue: 0,0:17:45.98,0:17:46.85,Default,,0,0,0,,Тазалау
Dialogue: 0,0:17:47.31,0:17:48.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:48.60,0:17:51.69,Default,,0,0,0,,Сұлулық ең жақсы және сізді табиғи түрде күлдіреді
Dialogue: 0,0:17:52.11,0:17:54.11,Default,,0,0,0,,Күлімсіреу? Міне бітті?
Dialogue: 0,0:17:56.45,0:17:58.24,Default,,0,0,0,,Түсіну қиын
Dialogue: 0,0:17:58.74,0:17:59.74,Default,,0,0,0,,Қызыл жүзді Айга
Dialogue: 0,0:17:59.87,0:18:01.20,Default,,0,0,0,,Әй?Ах...
Dialogue: 0,0:18:01.33,0:18:02.49,Default,,0,0,0,,Мен дос болғым келеді
Dialogue: 0,0:18:02.62,0:18:04.70,Default,,0,0,0,,Иә! О... менімен бе?
Dialogue: 0,0:18:04.83,0:18:07.37,Default,,0,0,0,,Бейблейд Күшті деп естідім.
Dialogue: 0,0:18:07.50,0:18:09.71,Default,,0,0,0,,Ах! Super Zetsu күшті
Dialogue: 0,0:18:09.83,0:18:11.92,Default,,0,0,0,,Бірақ мен Аои Балттан жеңіліп қалдым.
Dialogue: 0,0:18:12.04,0:18:12.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:13.05,0:18:14.71,Default,,0,0,0,,Сіз қайдан білесіз?
Dialogue: 0,0:18:14.84,0:18:16.51,Default,,0,0,0,,Барто Аои сұрады
Dialogue: 0,0:18:17.05,0:18:19.01,Default,,0,0,0,,Не? Сіз Балтомен кездестіңіз бе?
Dialogue: 0,0:18:19.47,0:18:21.72,Default,,0,0,0,,Аои Барто менің таңданысым
Dialogue: 0,0:18:21.85,0:18:25.68,Default,,0,0,0,,Мен онымен күресу үшін осы супер Зецубейді жасадым.
Dialogue: 0,0:18:26.10,0:18:28.85,Default,,0,0,0,,Бұл жігіт Арчер Геркулес
Dialogue: 0,0:18:29.60,0:18:30.94,Default,,0,0,0,,Я~
Dialogue: 0,0:18:31.11,0:18:34.02,Default,,0,0,0,,Бірақ Z Ахиллес салқынырақ.
Dialogue: 0,0:18:34.61,0:18:37.32,Default,,0,0,0,,Мен Аои Балтты жеңе жаздадым.
Dialogue: 0,0:18:37.44,0:18:38.65,Default,,0,0,0,,Өте көңілсіз!
Dialogue: 0,0:18:38.78,0:18:40.66,Default,,0,0,0,,Мен сияқты ма?
Dialogue: 0,0:18:41.16,0:18:43.28,Default,,0,0,0,,Мен де жеңіп кете жаздадым.
Dialogue: 0,0:18:43.53,0:18:45.54,Default,,0,0,0,,Иә? Дәл солай ма?
Dialogue: 0,0:18:45.62,0:18:47.41,Default,,0,0,0,,Мен күштімін!
Dialogue: 0,0:18:48.08,0:18:49.79,Default,,0,0,0,,Мен күштімін
Dialogue: 0,0:18:50.04,0:18:51.29,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:18:52.67,0:18:56.05,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:18:58.51,0:19:00.30,Default,,0,0,0,,Ерте бастайық!
Dialogue: 0,0:19:00.72,0:19:03.26,Default,,0,0,0,,Қызу маңызды
Dialogue: 0,0:19:05.18,0:19:06.01,Default,,0,0,0,,Хмф!
Dialogue: 0,0:19:10.44,0:19:11.94,Default,,0,0,0,,Олай болса жасайық!
Dialogue: 0,0:19:12.06,0:19:13.06,Default,,0,0,0,,Иә
Dialogue: 0,0:19:14.77,0:19:15.65,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:16.44,0:19:17.90,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:19:18.07,0:19:20.95,Default,,0,0,0,,Бұл да қыздыру ма?
Dialogue: 0,0:19:21.49,0:19:23.37,Default,,0,0,0,,Қызық!
Dialogue: 0,0:19:28.08,0:19:29.04,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:19:29.25,0:19:30.29,Default,,0,0,0,,О!
Dialogue: 0,0:19:31.12,0:19:34.29,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:19:34.79,0:19:37.13,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:19:37.46,0:19:38.34,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:19:44.64,0:19:45.55,Default,,0,0,0,,Жарайды
Dialogue: 0,0:19:48.60,0:19:50.14,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:19:51.85,0:19:52.73,Default,,0,0,0,,Қабыл алыңыздар!
Dialogue: 0,0:19:59.82,0:20:02.11,Default,,0,0,0,,Қарғыс атсын... Қалымды жоғалта алмаймын.
Dialogue: 0,0:20:02.57,0:20:05.03,Default,,0,0,0,,Бұл Арчер Геркулес
Dialogue: 0,0:20:05.57,0:20:07.16,Default,,0,0,0,,Тоқта! (Ичи) Ә? Мұнда ма?
Dialogue: 0,0:20:08.16,0:20:11.58,Default,,0,0,0,,Қазір! Ахилл Ахиллес!
Dialogue: 0,0:20:16.50,0:20:18.34,Default,,0,0,0,,Уууу!
Dialogue: 0,0:20:18.63,0:20:19.55,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,0:20:20.30,0:20:22.13,Default,,0,0,0,,Хмм... Геркулес!
Dialogue: 0,0:20:29.72,0:20:31.93,Default,,0,0,0,,Z Buster!
Dialogue: 0,0:20:33.56,0:20:35.40,Default,,0,0,0,,Шексіз айналу!
Dialogue: 0,0:20:38.82,0:20:39.73,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:46.45,0:20:47.49,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:50.20,0:20:54.08,Default,,0,0,0,,Басың айналып кетпесін... Не деген шыдамдылық!
Dialogue: 0,0:21:06.34,0:21:07.34,Default,,0,0,0,,Ал...
Dialogue: 0,0:21:07.47,0:21:08.55,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:21:09.14,0:21:10.81,Default,,0,0,0,,Қош келдіңіз Айга
Dialogue: 0,0:21:11.22,0:21:12.89,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:13.14,0:21:15.14,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:21:15.27,0:21:16.56,Default,,0,0,0,,Осы жерде болыңыз
Dialogue: 0,0:21:16.85,0:21:17.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:18.11,0:21:19.82,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:21:19.94,0:21:20.94,Default,,0,0,0,,Э? Ах…
Dialogue: 0,0:21:21.07,0:21:22.28,Default,,0,0,0,,Міне! Бір минут күтіңіз
Dialogue: 0,0:21:22.40,0:21:22.94,Default,,0,0,0,,Бөтеннің үйінде рұқсатсыз жатпа!
Dialogue: 0,0:21:22.94,0:21:25.78,Default,,0,0,0,,Бөтеннің үйінде рұқсатсыз жатпа!
Dialogue: 0,0:21:22.94,0:21:25.78,Default,,0,0,0,,
Dialogue: 0,0:21:25.86,0:21:27.91,Default,,0,0,0,,Шық! Эй!
Dialogue: 0,0:21:27.99,0:21:29.83,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:21:30.99,0:21:33.75,Default,,0,0,0,,А... өте тітіркендіргіш!
Dialogue: 0,0:21:34.25,0:21:36.62,Default,,0,0,0,,Әзіл... бұл!
Dialogue: 0,0:21:36.75,0:21:38.75,Default,,0,0,0,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,0:21:39.46,0:21:41.21,Default,,0,0,0,,Қош келдіңіз…
Dialogue: 0,0:21:41.34,0:21:42.21,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:42.34,0:21:44.46,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:21:45.05,0:21:47.76,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:21:47.88,0:21:50.18,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:21:50.30,0:21:52.18,Default,,0,0,0,,Шық!
Dialogue: 0,0:21:54.77,0:22:00.77,Default,,0,0,0,,♪~
Dialogue: 0,0:23:16.72,0:23:22.73,Default,,0,0,0,,~♪
Dialogue: 0,0:23:25.11,0:23:27.53,Default,,0,0,0,,Лонгинус кубогының ширек финалы
Dialogue: 0,0:23:27.73,0:23:29.86,Default,,0,0,0,,Менің қарсыласым Сочо.
Dialogue: 0,0:23:30.20,0:23:33.62,Default,,0,0,0,,Өзен жағасындағы жекпе-жекте бір шешімге келе алмадық.
Dialogue: 0,0:23:33.78,0:23:35.99,Default,,0,0,0,,Бұл жолы толық есеп айырысу!
Dialogue: 0,0:23:36.16,0:23:39.16,Default,,0,0,0,,Мен сіздің бетіңізді үрлей алатыныма өте қуаныштымын!
Dialogue: 0,0:23:40.04,0:23:42.25,Default,,0,0,0,,Келесі жолы «Beyblade Burst Super Zetsu»
Dialogue: 0,0:23:42.37,0:23:44.67,Default,,0,0,0,,«Ахиллес Рагнарукқа қарсы!!»
Dialogue: 0,0:23:45.00,0:23:46.84,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:46.96,0:23:48.96,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:50.46,0:23:56.46,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
