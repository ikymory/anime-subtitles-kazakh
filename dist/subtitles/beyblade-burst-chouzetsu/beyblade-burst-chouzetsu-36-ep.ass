Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.25,0:00:07.50,Default,,0,0,0,,Сиқырлы сарай Өлі Гран!
Dialogue: 0,0:00:08.29,0:00:11.55,Default,,0,0,0,,Сіз бұрын-соңды көрмеген супер шайқасқа тап боласыз.
Dialogue: 0,0:00:11.76,0:00:15.84,Default,,0,0,0,,Қорқынышты жау, Күшті би жолыңда тұр.
Dialogue: 0,0:00:17.51,0:00:21.85,Default,,0,0,0,,Challenge Challenge Challenge!
Dialogue: 0,0:00:22.18,0:00:26.15,Default,,0,0,0,,Оны жеңіп, ертең қолға ал
Dialogue: 0,0:00:26.31,0:00:30.03,Default,,0,0,0,,Сіз Бейблейдтің болашағысыз!
Dialogue: 0,0:00:31.28,0:00:34.15,Default,,0,0,0,,Резонанс – Беймен байланыс.
Dialogue: 0,0:00:34.28,0:00:37.28,Default,,0,0,0,,Ахиллес екеуіңде байланыс бар ма?
Dialogue: 0,0:00:37.66,0:00:39.53,Default,,0,0,0,,Маған не енгізгендерін ешкім білмейді.
Dialogue: 0,0:00:39.66,0:00:41.70,Default,,0,0,0,,Ахиллес екеуміздің рухымыз бір!
Dialogue: 0,0:00:44.75,0:00:45.96,Default,,0,0,0,,Өлі әжеде
Dialogue: 0,0:00:46.08,0:00:48.92,Default,,0,0,0,,Күренай шумен төбелесіп біттім.
Dialogue: 0,0:00:49.29,0:00:52.46,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:00:53.38,0:00:56.59,Default,,0,0,0,,Super Spriggan Slash!
Dialogue: 0,0:01:03.93,0:01:06.06,Default,,0,0,0,,Оның Бей Super Z Spriggan болып табылады
Dialogue: 0,0:01:06.19,0:01:07.48,Default,,0,0,0,,Бұл керемет күшті болды!
Dialogue: 0,0:01:10.82,0:01:13.90,Default,,0,0,0,,Оның үстіне Балто Өлі Грандқа келді.
Dialogue: 0,0:01:14.53,0:01:16.32,Default,,0,0,0,,Әй, Айға!
Dialogue: 0,0:01:17.49,0:01:21.58,Default,,0,0,0,,Ақырында, Жүректерге қарсы күресетін уақыт келді.
Dialogue: 0,0:01:21.70,0:01:22.54,Default,,0,0,0,,(Бакуго) Сол жексұрын данышпан... Маған түк те керек емес!
Dialogue: 0,0:01:24.62,0:01:25.46,Default,,0,0,0,,Шута!
Dialogue: 0,0:01:25.58,0:01:28.88,Default,,0,0,0,,Хаха~! Дайын бол
Dialogue: 0,0:01:29.00,0:01:31.67,Default,,0,0,0,,Мен сені тозаққа құлатамын!
Dialogue: 0,0:01:32.30,0:01:34.67,Default,,0,0,0,,Дайын болыңдар, жүректер!
Dialogue: 0,0:01:35.34,0:01:39.68,Default,,0,0,0,,Мен Ахиллес екеуіміз Омені құртамыз.
Dialogue: 0,0:01:40.55,0:01:46.56,Default,,0,0,0,,♪~
Dialogue: 0,0:03:03.93,0:03:09.93,Default,,0,0,0,,~♪
Dialogue: 0,0:03:16.52,0:03:18.69,Default,,0,0,0,,Ии хи хи!
Dialogue: 0,0:03:18.82,0:03:22.16,Default,,0,0,0,,Сіз Bad Boys and Girls фильмін көріп жатырсыз ба?
Dialogue: 0,0:03:22.91,0:03:25.41,Default,,0,0,0,,Hearts-sama VS Red Blade Aiga
Dialogue: 0,0:03:25.53,0:03:27.66,Default,,0,0,0,,Көрнекті шайқас
Dialogue: 0,0:03:27.79,0:03:30.16,Default,,0,0,0,,Бұл ақыры басы!
Dialogue: 0,0:03:30.71,0:03:32.08,Default,,0,0,0,,Қызыл жүзді Айга
Dialogue: 0,0:03:32.21,0:03:35.17,Default,,0,0,0,,Мен бұрынғы чемпионның ниетін түсінбеймін.
Dialogue: 0,0:03:35.34,0:03:39.67,Default,,0,0,0,,Хехе~ Мен сенен тағы жеңіліп жатырмын.
Dialogue: 0,0:03:40.05,0:03:42.13,Default,,0,0,0,,Мен жеңілмеймін, Айға
Dialogue: 0,0:03:42.43,0:03:45.14,Default,,0,0,0,,Омені міндетті түрде жеңіңіз!
Dialogue: 0,0:03:48.26,0:03:49.10,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:49.47,0:03:52.48,Default,,0,0,0,,Паа! Ағаштың кішкене бөлігі
Dialogue: 0,0:03:52.64,0:03:54.98,Default,,0,0,0,,Мен Ахиллестің отшашуын шығарамын.
Dialogue: 0,0:03:55.10,0:03:56.06,Default,,0,0,0,,Хаха~!
Dialogue: 0,0:03:56.19,0:03:59.98,Default,,0,0,0,,Бұл шықты! Құрметті жүректер, бұл алдын ала қарау.
Dialogue: 0,0:04:00.32,0:04:02.70,Default,,0,0,0,,Қарғыс атсын... Тем!
Dialogue: 0,0:04:03.11,0:04:04.45,Default,,0,0,0,,Арандатушылықты пайдаланба!
Dialogue: 0,0:04:04.57,0:04:05.99,Default,,0,0,0,,Сабыр ет!
Dialogue: 0,0:04:06.16,0:04:07.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:08.24,0:04:09.45,Default,,0,0,0,,Айга…
Dialogue: 0,0:04:10.87,0:04:11.87,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:04:12.66,0:04:15.79,Default,,0,0,0,,Мен сені шабуылмен құртамын.
Dialogue: 0,0:04:16.50,0:04:18.13,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:04:18.75,0:04:21.63,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:04:21.92,0:04:24.30,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:04:24.51,0:04:25.76,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:25.97,0:04:27.14,Default,,0,0,0,,Хэхе~!
Dialogue: 0,0:04:27.26,0:04:29.89,Default,,0,0,0,,«Жүректер» шоуы басталды.
Dialogue: 0,0:04:30.22,0:04:32.14,Default,,0,0,0,,Менімен ойна, Аид!
Dialogue: 0,0:04:34.10,0:04:34.94,Default,,0,0,0,,Гррр…
Dialogue: 0,0:04:35.81,0:04:36.73,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:37.61,0:04:40.73,Default,,0,0,0,,Қатты бетпе-бет соқтығыс!
Dialogue: 0,0:04:41.15,0:04:43.74,Default,,0,0,0,,Кенет шарықтау шегі
Dialogue: 0,0:04:44.07,0:04:47.78,Default,,0,0,0,,Қатты шабуыл, Ахиллес!
Dialogue: 0,0:04:49.53,0:04:51.24,Default,,0,0,0,,Мен... Куу!
Dialogue: 0,0:04:51.37,0:04:52.62,Default,,0,0,0,,Хаха~!
Dialogue: 0,0:04:53.00,0:04:54.12,Default,,0,0,0,,Маған да біреуін оқып бер
Dialogue: 0,0:04:54.46,0:04:58.50,Default,,0,0,0,,Біраз есейіп кеткен сияқтысың, жақсы.
Dialogue: 0,0:04:58.63,0:04:59.96,Default,,0,0,0,,Бірақ бұл оның ауқымы ма?
Dialogue: 0,0:05:00.34,0:05:01.63,Default,,0,0,0,,Көбірек келіңіз!
Dialogue: 0,0:05:03.26,0:05:04.13,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:04.26,0:05:05.09,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:05.59,0:05:08.47,Default,,0,0,0,,Не болды Не болды! Қазірдің өзінде бітті ме?
Dialogue: 0,0:05:12.10,0:05:14.02,Default,,0,0,0,,Уф! Ах!
Dialogue: 0,0:05:14.14,0:05:16.35,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:16.85,0:05:19.56,Default,,0,0,0,,Міне... Міне, осындай сезім!
Dialogue: 0,0:05:20.11,0:05:21.65,Default,,0,0,0,,Ах! Ол жігіт...
Dialogue: 0,0:05:22.03,0:05:26.11,Default,,0,0,0,,Мен де Ахиллес сияқты азапты сезінуім керек.
Dialogue: 0,0:05:26.40,0:05:29.16,Default,,0,0,0,,Сіз шынымен де күшейе алмайсыз!
Dialogue: 0,0:05:30.20,0:05:31.12,Default,,0,0,0,,Айга…
Dialogue: 0,0:05:32.62,0:05:34.45,Default,,0,0,0,,Өлі импульс!
Dialogue: 0,0:05:40.88,0:05:42.46,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:05:45.09,0:05:46.09,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:46.42,0:05:47.26,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:05:48.18,0:05:50.60,Default,,0,0,0,,Өлі өлілер аяқталды
Dialogue: 0,0:05:50.72,0:05:52.01,Default,,0,0,0,,Жүректерге бір ұпай!
Dialogue: 0,0:05:52.22,0:05:55.10,Default,,0,0,0,,Яха! Hearts күткендей
Dialogue: 0,0:05:55.22,0:05:57.48,Default,,0,0,0,,Ұпайларды ерте алыңыз!
Dialogue: 0,0:05:58.10,0:05:59.48,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:59.65,0:06:02.44,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:06:02.82,0:06:04.07,Default,,0,0,0,,Хаха~!
Dialogue: 0,0:06:04.19,0:06:06.32,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл қызық, солай ма?
Dialogue: 0,0:06:06.44,0:06:07.90,Default,,0,0,0,,Мен шыдай алмаймын.
Dialogue: 0,0:06:08.28,0:06:09.20,Default,,0,0,0,,Гррр…
Dialogue: 0,0:06:09.57,0:06:11.82,Default,,0,0,0,,Бұл әлі алыс!
Dialogue: 0,0:06:11.95,0:06:14.45,Default,,0,0,0,,Резонансыңызды тереңдетіңіз!
Dialogue: 0,0:06:14.83,0:06:18.21,Default,,0,0,0,,Ұсақтау... жаншу
Dialogue: 0,0:06:18.62,0:06:21.58,Default,,0,0,0,,Омені міндетті түрде жойыңыз!
Dialogue: 0,0:06:21.92,0:06:23.67,Default,,0,0,0,,Жоқ, енді жоқ!
Dialogue: 0,0:06:23.80,0:06:25.46,Default,,0,0,0,,Тоқта, Айға~!
Dialogue: 0,0:06:25.59,0:06:26.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:26.80,0:06:27.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:28.01,0:06:31.18,Default,,0,0,0,,Олай болмаса, Теме жойылады!
Dialogue: 0,0:06:31.64,0:06:34.01,Default,,0,0,0,,Шулы! Маған кедергі жасама!
Dialogue: 0,0:06:34.47,0:06:35.52,Default,,0,0,0,,Сіз...
Dialogue: 0,0:06:35.81,0:06:36.64,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:36.77,0:06:37.77,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:06:40.65,0:06:41.48,Default,,0,0,0,,Heh...
Dialogue: 0,0:06:45.23,0:06:47.24,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:06:47.69,0:06:50.95,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:06:51.41,0:06:54.24,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:06:54.37,0:06:55.41,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:55.79,0:06:58.41,Default,,0,0,0,,Фухахаха!
Dialogue: 0,0:06:58.66,0:07:01.37,Default,,0,0,0,,Қызыл жүз Айга Пайдасыз күрес
Dialogue: 0,0:07:01.50,0:07:05.17,Default,,0,0,0,,Ақымақтан жеңілсең мен саған тағы да сүйсінемін.
Dialogue: 0,0:07:05.42,0:07:09.26,Default,,0,0,0,,Алға, Ахиллес!
Dialogue: 0,0:07:11.43,0:07:12.30,Default,,0,0,0,,(Танжиро) Бірақ құбыжықтар жалғыз жүруі керек еді ғой?
Dialogue: 0,0:07:14.01,0:07:18.27,Default,,0,0,0,,Ажал! Өлі гравитация!
Dialogue: 0,0:07:18.72,0:07:23.10,Default,,0,0,0,,Бұл шықты! Лорд Хадес Тозақтың тосқауылдары
Dialogue: 0,0:07:23.31,0:07:25.86,Default,,0,0,0,,Қалай болғанда да, бастайық!
Dialogue: 0,0:07:26.32,0:07:27.44,Default,,0,0,0,,Айга!
Dialogue: 0,0:07:29.32,0:07:30.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:31.61,0:07:32.45,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:33.16,0:07:36.95,Default,,0,0,0,,Мен енді Ахиллеспен бірмін.
Dialogue: 0,0:07:37.37,0:07:38.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:38.83,0:07:41.54,Default,,0,0,0,,Мен Ахиллеспін!
Dialogue: 0,0:07:41.66,0:07:44.88,Default,,0,0,0,,Уууу!
Dialogue: 0,0:07:49.05,0:07:51.01,Default,,0,0,0,,Ооо...
Dialogue: 0,0:07:51.51,0:07:52.55,Default,,0,0,0,,Әй!
Dialogue: 0,0:07:53.38,0:07:55.80,Default,,0,0,0,,Міне! Бұл жақсы!
Dialogue: 0,0:07:55.93,0:08:00.60,Default,,0,0,0,,Ахилл екеуіңді құртамын!
Dialogue: 0,0:08:02.64,0:08:04.52,Default,,0,0,0,,Хаха~!
Dialogue: 0,0:08:05.31,0:08:07.06,Default,,0,0,0,,Аид!
Dialogue: 0,0:08:12.45,0:08:13.49,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:08:14.36,0:08:16.66,Default,,0,0,0,,Жоқ, Айга!
Dialogue: 0,0:08:22.04,0:08:23.04,Default,,0,0,0,,Әй!
Dialogue: 0,0:08:23.16,0:08:25.04,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:25.17,0:08:27.04,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:30.51,0:08:31.80,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:08:31.92,0:08:33.42,Default,,0,0,0,,Куууу…
Dialogue: 0,0:08:35.55,0:08:36.84,Default,,0,0,0,,Айга~!
Dialogue: 0,0:08:41.14,0:08:41.97,Default,,0,0,0,,Аһ!
Dialogue: 0,0:08:42.64,0:08:45.23,Default,,0,0,0,,Өлі өлілердің жарылуы аяқталды
Dialogue: 0,0:08:45.35,0:08:48.36,Default,,0,0,0,,3-0 ұпайы бар жеңімпаз жүректер!
Dialogue: 0,0:08:48.73,0:08:51.11,Default,,0,0,0,,Burst Burst Burst
Dialogue: 0,0:08:51.48,0:08:55.70,Default,,0,0,0,,Бұл шайқаста жеңіске жеткен – біздің Жүрегіміз!
Dialogue: 0,0:08:55.82,0:08:57.87,Default,,0,0,0,,Күтілгендей!
Dialogue: 0,0:08:58.07,0:09:01.04,Default,,0,0,0,,Хаха~! Бұл ең жақсы
Dialogue: 0,0:09:01.16,0:09:03.08,Default,,0,0,0,,Бұл өте керемет!
Dialogue: 0,0:09:03.20,0:09:04.58,Default,,0,0,0,,Хаха~!
Dialogue: 0,0:09:04.71,0:09:07.75,Default,,0,0,0,,Бұл ең жақсы!
Dialogue: 0,0:09:09.25,0:09:10.50,Default,,0,0,0,,Ахиллес…
Dialogue: 0,0:09:11.09,0:09:12.34,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:14.01,0:09:15.09,Default,,0,0,0,,Айга…
Dialogue: 0,0:09:16.13,0:09:20.51,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:09:21.06,0:09:22.22,Default,,0,0,0,,Айга…
Dialogue: 0,0:09:23.43,0:09:25.10,Default,,0,0,0,,Ұф… Ұф!
Dialogue: 0,0:09:25.64,0:09:26.48,Default,,0,0,0,,Хе
Dialogue: 0,0:09:26.98,0:09:28.98,Default,,0,0,0,,Сәлем! Таку…
Dialogue: 0,0:09:31.57,0:09:32.57,Default,,0,0,0,,Жүректер!
Dialogue: 0,0:09:32.98,0:09:33.82,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:34.28,0:09:36.53,Default,,0,0,0,,Бұл сіздің Бейблейдіңіз бе?
Dialogue: 0,0:09:37.28,0:09:39.91,Default,,0,0,0,,Иә? Мен не айта аламын?
Dialogue: 0,0:09:40.03,0:09:42.16,Default,,0,0,0,,Бұрынғы чемпион
Dialogue: 0,0:09:43.37,0:09:46.66,Default,,0,0,0,,Мен саған Валькирияның күшін көрсетемін!
Dialogue: 0,0:09:47.04,0:09:49.54,Default,,0,0,0,,Не? Ақыры аяқтадым
Dialogue: 0,0:09:49.67,0:09:51.50,Default,,0,0,0,,Жасадың, ағайын!
Dialogue: 0,0:09:51.92,0:09:53.67,Default,,0,0,0,,Не, не...
Dialogue: 0,0:09:53.80,0:09:56.42,Default,,0,0,0,,Бұрынғы әлем чемпионы Барто Аои
Dialogue: 0,0:09:56.55,0:09:58.93,Default,,0,0,0,,Абайсызда соғыс жариялау
Dialogue: 0,0:09:59.30,0:10:02.05,Default,,0,0,0,,Жаңа Валькирия?
Dialogue: 0,0:10:05.27,0:10:07.06,Default,,0,0,0,,Өтінемін, Балто.
Dialogue: 0,0:10:07.64,0:10:11.15,Default,,0,0,0,,Мен сенімен көп ойнаймын.
Dialogue: 0,0:10:11.27,0:10:12.73,Default,,0,0,0,,Хаха~!
Dialogue: 0,0:10:19.74,0:10:22.49,Default,,0,0,0,,Айга! Айга~!
Dialogue: 0,0:10:23.49,0:10:26.20,Default,,0,0,0,,Хаа... қайда кетті?
Dialogue: 0,0:10:26.79,0:10:27.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:33.42,0:10:34.88,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:10:35.00,0:10:37.34,Default,,0,0,0,,Әлі де резонанс жеткіліксіз бе?
Dialogue: 0,0:10:38.01,0:10:39.09,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:10:40.34,0:10:44.10,Default,,0,0,0,,Сен неге үндемейсің? Маған бірдеңе айтыңызшы
Dialogue: 0,0:10:45.18,0:10:48.10,Default,,0,0,0,,Ахиллес Сізді қатты ренжіткен болуыңыз керек, солай емес пе?
Dialogue: 0,0:10:48.77,0:10:49.81,Default,,0,0,0,,Сочо!
Dialogue: 0,0:10:49.94,0:10:51.48,Default,,0,0,0,,Маған бір нәрсе көрсетейін.
Dialogue: 0,0:10:51.60,0:10:53.11,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:10:57.40,0:10:59.07,Default,,0,0,0,,Жарайсыңдар.
Dialogue: 0,0:10:59.40,0:11:01.57,Default,,0,0,0,,Бұл дұрыс емес! (Сочо) А?
Dialogue: 0,0:11:02.11,0:11:05.37,Default,,0,0,0,,Бұл жігітпен сөйлессем де ештеңеге жауап бермейді.
Dialogue: 0,0:11:07.75,0:11:10.16,Default,,0,0,0,,Біртұтас болғанымызбен
Dialogue: 0,0:11:12.58,0:11:15.96,Default,,0,0,0,,Мүмкін сіз және Ахиллес үйлесімді емес шығарсыз.
Dialogue: 0,0:11:16.09,0:11:16.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:17.25,0:11:20.30,Default,,0,0,0,,Олай болса, басқа да көптеген шығанақтар бар.
Dialogue: 0,0:11:21.76,0:11:22.93,Default,,0,0,0,,Сочо?
Dialogue: 0,0:11:23.51,0:11:27.18,Default,,0,0,0,,Неліктен Жапонияға оралғанда жаңасын жасамасқа?
Dialogue: 0,0:11:27.31,0:11:28.14,Default,,0,0,0,,Эй?
Dialogue: 0,0:11:30.18,0:11:31.27,Default,,0,0,0,,Оме
Dialogue: 0,0:11:31.39,0:11:32.90,Default,,0,0,0,,Айга~! иә?
Dialogue: 0,0:11:33.73,0:11:34.56,Default,,0,0,0,,Не!
Dialogue: 0,0:11:34.69,0:11:35.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:36.40,0:11:37.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:37.48,0:11:38.53,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:39.11,0:11:41.36,Default,,0,0,0,,Ха! Иә?
Dialogue: 0,0:11:43.11,0:11:46.28,Default,,0,0,0,,Мен... 2 адам~?
Dialogue: 0,0:11:48.87,0:11:52.12,Default,,0,0,0,,Бұл не... не болып жатыр?
Dialogue: 0,0:11:52.37,0:11:54.75,Default,,0,0,0,,Айға Алданба.
Dialogue: 0,0:11:54.88,0:11:56.50,Default,,0,0,0,,Бұл адам фейк!
Dialogue: 0,0:11:56.88,0:11:59.09,Default,,0,0,0,,Жоқ, жоқ, мен нағызмын!
Dialogue: 0,0:11:59.63,0:12:02.97,Default,,0,0,0,,Не? Содан кейін жауап беріп көріңіз.
Dialogue: 0,0:12:03.09,0:12:04.84,Default,,0,0,0,,Менің сүйікті тағамым қандай?
Dialogue: 0,0:12:04.97,0:12:06.72,Default,,0,0,0,,Бұл оңай.
Dialogue: 0,0:12:07.30,0:12:10.56,Default,,0,0,0,,Сиыр еті мен фуа градан жасалған балотина
Dialogue: 0,0:12:11.60,0:12:12.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:12.89,0:12:14.44,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:12:14.56,0:12:16.98,Default,,0,0,0,,Карри күріш, рамен, гамбургер стейк!
Dialogue: 0,0:12:17.11,0:12:17.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:18.57,0:12:21.94,Default,,0,0,0,,А, сау бол! Қаншалықты қарапайым!
Dialogue: 0,0:12:22.36,0:12:24.49,Default,,0,0,0,,Бұл жаман болды!
Dialogue: 0,0:12:24.61,0:12:25.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:26.07,0:12:27.95,Default,,0,0,0,,Мен оны білдім.
Dialogue: 0,0:12:28.70,0:12:32.12,Default,,0,0,0,,Мүмкін сіз және Ахиллес үйлесімді емес шығарсыз.
Dialogue: 0,0:12:32.79,0:12:35.25,Default,,0,0,0,,Сочо бұлай айтуы мүмкін емес!
Dialogue: 0,0:12:35.37,0:12:36.21,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:36.33,0:12:37.92,Default,,0,0,0,,Теме деген кім!
Dialogue: 0,0:12:38.04,0:12:38.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:39.17,0:12:41.30,Default,,0,0,0,,Қарғыс атсын... хехехе
Dialogue: 0,0:12:41.42,0:12:44.18,Default,,0,0,0,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:12:46.51,0:12:48.30,Default,,0,0,0,,Әй, ау!
Dialogue: 0,0:12:48.76,0:12:50.31,Default,,0,0,0,,Жарай, бастайық!
Dialogue: 0,0:12:50.76,0:12:53.77,Default,,0,0,0,,Жүрегіңдегі олқылықты пайдалана білдім.
Dialogue: 0,0:12:54.10,0:12:55.10,Default,,0,0,0,,Ха…
Dialogue: 0,0:12:55.56,0:12:56.56,Default,,0,0,0,,(Каэбуки) Күтпегендей, дайындықты ескерсек, аса әсерлі болған жоқ.
Dialogue: 0,0:12:59.32,0:13:00.15,Default,,0,0,0,,Фу…
Dialogue: 0,0:13:00.52,0:13:03.65,Default,,0,0,0,,Уәде етілгендей, мен оны алдым.
Dialogue: 0,0:13:03.99,0:13:05.53,Default,,0,0,0,,Конояро!
Dialogue: 0,0:13:06.16,0:13:09.66,Default,,0,0,0,,Ахиллестің жүрегі сізден әлдеқашан алыс
Dialogue: 0,0:13:10.08,0:13:11.29,Default,,0,0,0,,Не!
Dialogue: 0,0:13:12.04,0:13:14.37,Default,,0,0,0,,Өзің айтқан жоқсың ба?
Dialogue: 0,0:13:14.75,0:13:17.29,Default,,0,0,0,,Ахиллес ештеңеге жауап бермесе
Dialogue: 0,0:13:18.25,0:13:19.08,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:19.67,0:13:21.80,Default,,0,0,0,,Бей тек Ахиллес емес.
Dialogue: 0,0:13:21.92,0:13:24.22,Default,,0,0,0,,Дүние жүзінде әртүрлі шығанақтар бар.
Dialogue: 0,0:13:24.34,0:13:26.18,Default,,0,0,0,,Әрқайсысының жақсы жақтары бар.
Dialogue: 0,0:13:26.55,0:13:29.80,Default,,0,0,0,,Жағдайға байланысты ұяларды ғана пайдаланыңыз.
Dialogue: 0,0:13:29.93,0:13:32.06,Default,,0,0,0,,Бұл нағыз Blader емес пе?
Dialogue: 0,0:13:32.47,0:13:33.81,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:34.14,0:13:36.56,Default,,0,0,0,,Иә, дәл мен сияқты!
Dialogue: 0,0:13:41.48,0:13:44.57,Default,,0,0,0,,Ұрланған болуы керек, бірақ мақтаншақсың!
Dialogue: 0,0:13:45.53,0:13:48.78,Default,,0,0,0,,Мен әр шығанақтың ең жақсысын шығарамын.
Dialogue: 0,0:13:48.91,0:13:52.28,Default,,0,0,0,,Дұрыс, бұл Эрл Найт.
Dialogue: 0,0:13:52.79,0:13:54.29,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:55.04,0:13:59.42,Default,,0,0,0,,Бей мен Блэдер арасындағы байланыс
Dialogue: 0,0:13:59.88,0:14:02.17,Default,,0,0,0,,Бұл бос сөз.
Dialogue: 0,0:14:02.55,0:14:03.38,Default,,0,0,0,,Ха…
Dialogue: 0,0:14:03.55,0:14:05.34,Default,,0,0,0,,Бос сөз жоқ!
Dialogue: 0,0:14:05.63,0:14:06.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:07.05,0:14:10.39,Default,,0,0,0,,Менің Ахиллеспен тығыз байланысым бар.
Dialogue: 0,0:14:10.55,0:14:12.43,Default,,0,0,0,,Сондықтан мен күшті болдым!
Dialogue: 0,0:14:13.18,0:14:15.18,Default,,0,0,0,,Бірақ сіз жеңілдіңіз, солай емес пе?
Dialogue: 0,0:14:15.43,0:14:16.77,Default,,0,0,0,,Шу!
Dialogue: 0,0:14:16.89,0:14:20.19,Default,,0,0,0,,Мен және Ахиллес одан сайын күшейе түсті.
Dialogue: 0,0:14:20.90,0:14:23.40,Default,,0,0,0,,Super Zetsu ең күшті және жеңілмейтін болады!
Dialogue: 0,0:14:25.28,0:14:26.90,Default,,0,0,0,,Күн ыстық.
Dialogue: 0,0:14:27.03,0:14:30.24,Default,,0,0,0,,Мен бұрын-соңды сіздей жүзді кездестірген емеспін.
Dialogue: 0,0:14:30.91,0:14:31.95,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:14:32.53,0:14:35.16,Default,,0,0,0,,Мен ойымды өзгерттім, қайтарамын.
Dialogue: 0,0:14:35.79,0:14:36.62,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:37.79,0:14:39.04,Default,,0,0,0,,Қызыл жүзді Айга
Dialogue: 0,0:14:40.00,0:14:41.96,Default,,0,0,0,,Бұдан былай сен қандай жүзік боласың?
Dialogue: 0,0:14:42.71,0:14:45.88,Default,,0,0,0,,Мен сізге және Ахиллеске қарап тұрғым келді.
Dialogue: 0,0:14:48.63,0:14:49.47,Default,,0,0,0,,Иә
Dialogue: 0,0:14:52.51,0:14:55.64,Default,,0,0,0,,Қайта кездескенше Орвоир!
Dialogue: 0,0:14:56.35,0:14:58.81,Default,,0,0,0,,Сендер тым талапшылсыңдар — менің кимоном мүлдем кір емес.
Dialogue: 0,0:15:01.65,0:15:04.40,Default,,0,0,0,,Күшті болайық, солай ма?
Dialogue: 0,0:15:06.98,0:15:08.78,Default,,0,0,0,,Әй, Ахиллес!
Dialogue: 0,0:15:09.82,0:15:11.11,Default,,0,0,0,,Сіз осында болдыңыз ба?
Dialogue: 0,0:15:12.74,0:15:13.66,Default,,0,0,0,,Мынаны қараңыз
Dialogue: 0,0:15:15.03,0:15:18.08,Default,,0,0,0,,Жарайды! Ұлдар мен қыздар!
Dialogue: 0,0:15:18.33,0:15:22.17,Default,,0,0,0,,Өте керемет жаңалық жақында келді!
Dialogue: 0,0:15:22.67,0:15:23.63,Default,,0,0,0,,Не, не!
Dialogue: 0,0:15:23.75,0:15:28.17,Default,,0,0,0,,WBBA ресми әлем чемпионы атағы анықталды!
Dialogue: 0,0:15:28.55,0:15:31.18,Default,,0,0,0,,Бұл жолы Жүректерді қабылдайтын үміткер
Dialogue: 0,0:15:31.63,0:15:35.68,Default,,0,0,0,,Бұрынғы әлем чемпионы Барт Аои!
Dialogue: 0,0:15:35.80,0:15:36.93,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,0:15:37.51,0:15:40.52,Default,,0,0,0,,Шайқас кезеңі - Өлі Гран!
Dialogue: 0,0:15:40.64,0:15:45.94,Default,,0,0,0,,Жер асты әлемінің жын-шайтан сарайында қызу шайқас жүріп жатыр!
Dialogue: 0,0:15:46.07,0:15:48.19,Default,,0,0,0,,Бір секундты жіберіп алмаңыз!
Dialogue: 0,0:15:49.44,0:15:51.57,Default,,0,0,0,,Бұл тақырып сәйкестік пе?
Dialogue: 0,0:15:52.82,0:15:53.95,Default,,0,0,0,,Барт…
Dialogue: 0,0:15:59.95,0:16:02.00,Default,,0,0,0,,Балто, бұл сен туралы.
Dialogue: 0,0:16:02.75,0:16:05.21,Default,,0,0,0,,Сіз белбеуіңізді қайтарғыңыз келмейді ме?
Dialogue: 0,0:16:05.38,0:16:06.21,Default,,0,0,0,,О
Dialogue: 0,0:16:06.71,0:16:08.42,Default,,0,0,0,,Бұл қызыл жүз Айга ма?
Dialogue: 0,0:16:09.13,0:16:12.76,Default,,0,0,0,,Сіз шайқаста шайқастыңыз, солай ма? Онымен
Dialogue: 0,0:16:17.43,0:16:18.31,Default,,0,0,0,,Уф!
Dialogue: 0,0:16:20.35,0:16:21.77,Default,,0,0,0,,Бұзыңыз!
Dialogue: 0,0:16:22.98,0:16:24.27,Default,,0,0,0,,Ол қазір
Dialogue: 0,0:16:24.40,0:16:28.02,Default,,0,0,0,,Бейдің ауырсынуын сезіну резонанс деп ойлаймын.
Dialogue: 0,0:16:28.98,0:16:29.94,Default,,0,0,0,,Шу…
Dialogue: 0,0:16:31.94,0:16:32.86,Default,,0,0,0,,Иә
Dialogue: 0,0:16:35.95,0:16:38.83,Default,,0,0,0,,Уфхххххххххххххххххххххххххх!
Dialogue: 0,0:16:39.03,0:16:43.75,Default,,0,0,0,,Жаман ұлдар мен қыздар Бұл қызықты болады!
Dialogue: 0,0:16:44.08,0:16:45.42,Default,,0,0,0,,Тақырып сәйкестігі қандай болады?
Dialogue: 0,0:16:45.54,0:16:48.09,Default,,0,0,0,,Тозақтан тікелей түсініктеме Демон мырза...
Dialogue: 0,0:16:48.21,0:16:50.42,Default,,0,0,0,,Жоқ, жоқ, жоқ! Жоқ емес емес жын жоқ!
Dialogue: 0,0:16:50.55,0:16:53.80,Default,,0,0,0,,Бұдан былай, wbba.certified диктор
Dialogue: 0,0:16:53.92,0:16:56.18,Default,,0,0,0,,Сеньор Аннами оны сізге жібереді.
Dialogue: 0,0:16:56.55,0:16:59.93,Default,,0,0,0,,Жарайды! Көңіліңіз толқып тұр ма?
Dialogue: 0,0:17:00.06,0:17:02.43,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:02.93,0:17:04.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:04.89,0:17:07.40,Default,,0,0,0,,Барлық Hearts жанкүйерлері, солай ма?
Dialogue: 0,0:17:07.52,0:17:09.40,Default,,0,0,0,,Толығымен алыс па?
Dialogue: 0,0:17:09.57,0:17:13.90,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:14.36,0:17:17.28,Default,,0,0,0,,Hearts VS Balt Aoi
Dialogue: 0,0:17:17.41,0:17:19.41,Default,,0,0,0,,Ескі және жаңа чемпиондар арасындағы кездесу!
Dialogue: 0,0:17:20.08,0:17:22.87,Default,,0,0,0,,Жүрек алғашқы қорғаныс жасай ала ма?
Dialogue: 0,0:17:23.04,0:17:26.92,Default,,0,0,0,,Әлде Барто Аои шыңға орала ма?
Dialogue: 0,0:17:27.33,0:17:30.42,Default,,0,0,0,,Бұл титулдық матч бүкіл әлемнің назарын аударады.
Dialogue: 0,0:17:30.54,0:17:34.42,Default,,0,0,0,,Мен оны сізге Жүректердің туған жерінен, Өлі Грандтан жіберемін.
Dialogue: 0,0:17:36.55,0:17:38.55,Default,,0,0,0,,Сәттілік Бал-нии!
Dialogue: 0,0:17:38.68,0:17:41.18,Default,,0,0,0,,Бауырым, мен саған тамыр жаямын.
Dialogue: 0,0:17:41.35,0:17:44.64,Default,,0,0,0,,Иә! Алдымен сайыскерді енгізейік.
Dialogue: 0,0:17:44.77,0:17:45.89,Default,,0,0,0,,Кружка…
Dialogue: 0,0:17:46.27,0:17:48.10,Default,,0,0,0,,Ерік-жігер мен мақтанышпен
Dialogue: 0,0:17:48.23,0:17:51.15,Default,,0,0,0,,Мына кісі қайтадан орнынан тұрды!
Dialogue: 0,0:17:51.94,0:17:54.53,Default,,0,0,0,,«Мен сізге толық күшімді көрсетемін».
Dialogue: 0,0:17:54.65,0:17:58.66,Default,,0,0,0,,Көк супербала Балто Аои!
Dialogue: 0,0:17:58.78,0:18:01.16,Default,,0,0,0,,(буу)
Dialogue: 0,0:18:01.37,0:18:02.62,Default,,0,0,0,,Сіз ұтыласыз ба?
Dialogue: 0,0:18:02.74,0:18:05.16,Default,,0,0,0,,Балтық сенпайы!
Dialogue: 0,0:18:06.29,0:18:09.75,Default,,0,0,0,,Жеңіс құдайы жаңа Биге күлімсірей ме?
Dialogue: 0,0:18:09.88,0:18:13.46,Default,,0,0,0,,Бей пайдаланылған Super Z Valkyrie!
Dialogue: 0,0:18:15.09,0:18:16.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:17.34,0:18:19.22,Default,,0,0,0,,Жаңа шығанақ…
Dialogue: 0,0:18:19.76,0:18:22.97,Default,,0,0,0,,Енді чемпионның кіретін уақыты келді!
Dialogue: 0,0:18:23.60,0:18:25.39,Default,,0,0,0,,Бұл жұмбақ адам
Dialogue: 0,0:18:25.52,0:18:29.39,Default,,0,0,0,,Бұл кісі тозақтан шыққан деседі.
Dialogue: 0,0:18:30.27,0:18:31.73,Default,,0,0,0,,Буха! Не?
Dialogue: 0,0:18:33.15,0:18:36.74,Default,,0,0,0,,Хаха~! Бұл сізді біраз уақытқа қызықтырады, солай ма?
Dialogue: 0,0:18:36.86,0:18:39.86,Default,,0,0,0,,Сәлем, бұрынғы чемпион!
Dialogue: 0,0:18:40.66,0:18:42.45,Default,,0,0,0,,Бірақ қызық емес пе?
Dialogue: 0,0:18:42.57,0:18:46.12,Default,,0,0,0,,Не болды? Қандай көрініс!
Dialogue: 0,0:18:46.50,0:18:48.75,Default,,0,0,0,,Жер асты әлемінің жын патшасы жүректер!
Dialogue: 0,0:18:48.87,0:18:51.54,Default,,0,0,0,,Өлі өлілерді қолданыңыз!
Dialogue: 0,0:18:51.75,0:18:54.50,Default,,0,0,0,,Жарқыраған күйде көріну
Dialogue: 0,0:18:54.63,0:18:55.88,Default,,0,0,0,,Жүрек...
Dialogue: 0,0:19:00.22,0:19:03.76,Default,,0,0,0,,Сәлем! Мен бар күшімді саламын
Dialogue: 0,0:19:05.26,0:19:06.10,Default,,0,0,0,,Фу…
Dialogue: 0,0:19:06.35,0:19:08.85,Default,,0,0,0,,Бұл Super Z Valkyrie ме?
Dialogue: 0,0:19:08.98,0:19:10.85,Default,,0,0,0,,За-н-нен!
Dialogue: 0,0:19:10.98,0:19:13.86,Default,,0,0,0,,Бұл соңғы шайқас болады деп ойламадым.
Dialogue: 0,0:19:14.11,0:19:17.99,Default,,0,0,0,,Әй, байқамайынша түсінбейсің.
Dialogue: 0,0:19:18.11,0:19:19.74,Default,,0,0,0,,Сәлем досым!
Dialogue: 0,0:19:20.32,0:19:21.61,Default,,0,0,0,,Heh...
Dialogue: 0,0:19:24.37,0:19:28.00,Default,,0,0,0,,Ой, бұл қазірдің өзінде жауынгерлік рухтардың қақтығысы.
Dialogue: 0,0:19:28.54,0:19:32.25,Default,,0,0,0,,Өте қызу шайқас басталып кетті!
Dialogue: 0,0:19:32.88,0:19:36.50,Default,,0,0,0,,Титулдық матчтар үш ұпайлық біріншілік негізінде өтеді.
Dialogue: 0,0:19:40.34,0:19:41.26,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:19:41.84,0:19:42.97,Default,,0,0,0,,Оларды осы жаққа жіберіңізші.
Dialogue: 0,0:19:43.55,0:19:44.43,Default,,0,0,0,,Хе!
Dialogue: 0,0:19:46.10,0:19:47.85,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:19:48.14,0:19:51.77,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:19:52.10,0:19:54.40,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:19:54.65,0:19:55.86,Default,,0,0,0,,…баланың санасына ықпал ету үшін миына енгізілген
Dialogue: 0,0:19:56.19,0:19:57.77,Default,,0,0,0,,Енді, назар аударыңыз!
Dialogue: 0,0:19:57.90,0:20:00.11,Default,,0,0,0,,Ақырында титулдық матч басталды!
Dialogue: 0,0:20:00.24,0:20:01.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:01.20,0:20:02.99,Default,,0,0,0,,Super Z-Wing пайда болмайды!
Dialogue: 0,0:20:05.87,0:20:06.99,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:07.12,0:20:07.95,Default,,0,0,0,,Хе!
Dialogue: 0,0:20:08.74,0:20:11.83,Default,,0,0,0,,Уау! Екі шығанақ қатты соқтығысады
Dialogue: 0,0:20:11.96,0:20:12.79,Default,,0,0,0,,Бұл бітсе, бірдеңе жейміз бе? Егер қаласаң, көңіліңді көтерейін.
Dialogue: 0,0:20:12.92,0:20:15.50,Default,,0,0,0,,Мені өлі өлілердің салмағы итеріп жіберді!
Dialogue: 0,0:20:16.67,0:20:18.63,Default,,0,0,0,,Хе! Бұл солай ма?
Dialogue: 0,0:20:21.67,0:20:25.01,Default,,0,0,0,,Жүр! Валькирия!
Dialogue: 0,0:20:28.60,0:20:30.97,Default,,0,0,0,,Super Valkyrie Slash!
Dialogue: 0,0:20:32.06,0:20:33.98,Default,,0,0,0,,Өлі импульс!
Dialogue: 0,0:20:43.36,0:20:44.82,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:47.53,0:20:48.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:48.99,0:20:49.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:50.20,0:20:52.25,Default,,0,0,0,,Сіз оны әлі де пайдалана алмайсыз ба?
Dialogue: 0,0:20:52.83,0:20:54.08,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:54.87,0:20:57.25,Default,,0,0,0,,Өлі өлілер аяқталды
Dialogue: 0,0:20:57.58,0:20:59.09,Default,,0,0,0,,Жүректерге бір ұпай!
Dialogue: 0,0:20:59.21,0:21:02.38,Default,,0,0,0,,Ауыр салмақтағы Dead Hades
Dialogue: 0,0:21:02.51,0:21:06.09,Default,,0,0,0,,Super Z Valkyrie оңай қайтарылды!
Dialogue: 0,0:21:06.34,0:21:09.85,Default,,0,0,0,,Бірінші болып ұпай жинаған - Жүректер!
Dialogue: 0,0:21:10.14,0:21:14.73,Default,,0,0,0,,Эй, эй! Бұл бұрынғы әлем чемпионы ма?
Dialogue: 0,0:21:14.85,0:21:16.85,Default,,0,0,0,,Көбірек көңіл көтерейік
Dialogue: 0,0:21:19.02,0:21:20.11,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:20.32,0:21:22.23,Default,,0,0,0,,Сіз бұл жылдамдықпен ұта алмайсыз.
Dialogue: 0,0:21:22.94,0:21:24.11,Default,,0,0,0,,…
Dialogue: 0,0:21:24.99,0:21:27.16,Default,,0,0,0,,Жарайды, Бал-нии.
Dialogue: 0,0:21:27.66,0:21:30.08,Default,,0,0,0,,Не істеу керек? Балтық
Dialogue: 0,0:21:35.62,0:21:36.67,Default,,0,0,0,,Фу…
Dialogue: 0,0:21:36.79,0:21:38.58,Default,,0,0,0,,Өртеніп жатыр!
Dialogue: 0,0:21:39.58,0:21:42.09,Default,,0,0,0,,Ол... күлді!
Dialogue: 0,0:21:42.34,0:21:44.59,Default,,0,0,0,,Кеттік, жолдасым!
Dialogue: 0,0:21:45.80,0:21:48.84,Default,,0,0,0,,Хе! Мен сені құртамын.
Dialogue: 0,0:21:55.43,0:22:01.44,Default,,0,0,0,,♪~
Dialogue: 0,0:23:18.89,0:23:24.90,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.02,0:23:28.99,Default,,0,0,0,,Қарғыс атсын, Жүректер... тым күшті.
Dialogue: 0,0:23:29.11,0:23:31.45,Default,,0,0,0,,Бұл соңғы резонанс па?
Dialogue: 0,0:23:31.99,0:23:34.62,Default,,0,0,0,,Бұлай жалғаса берсе, Балто жеңіледі!
Dialogue: 0,0:23:34.87,0:23:37.24,Default,,0,0,0,,Неге күле алмайсың?
Dialogue: 0,0:23:37.45,0:23:40.25,Default,,0,0,0,,Оны шығарыңыз, Super Z-ояту!
Dialogue: 0,0:23:40.66,0:23:43.13,Default,,0,0,0,,Келесі жолы «Beyblade Burst Super Zetsu»
Dialogue: 0,0:23:43.42,0:23:46.17,Default,,0,0,0,,"Super Zetsu Clash! Сиқырлы сарайдағы шешуші шайқас!!"
Dialogue: 0,0:23:46.29,0:23:47.96,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:48.13,0:23:49.84,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:51.34,0:23:57.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory