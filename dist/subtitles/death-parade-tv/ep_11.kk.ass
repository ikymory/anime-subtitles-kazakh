Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.66,0:00:05.17,Default,,0,0,0,,Маған бір нәрсе көрсетейін.
Dialogue: 0,0:00:09.46,0:00:11.38,Default,,0,0,0,,Төрешіге…
Dialogue: 0,0:00:12.01,0:00:14.47,Default,,0,0,0,,Адамның сезімдері?
Dialogue: 0,0:00:16.51,0:00:18.01,Default,,0,0,0,,Өте рахмет! (Ол Майт) Ахахаха!
Dialogue: 0,0:00:18.10,0:00:21.64,Default,,0,0,0,,Адамдар өмір сүрмейді, өйткені олар бір күні өледі.
Dialogue: 0,0:00:22.27,0:00:25.73,Default,,0,0,0,,Мен тірі болғандықтан, мен де бір күні өлемін.
Dialogue: 0,0:00:25.81,0:00:26.65,Default,,0,0,0,,Иә
Dialogue: 0,0:00:26.73,0:00:29.57,Default,,0,0,0,,Өмір сүрудің мәні бар
Dialogue: 0,0:00:30.86,0:00:32.99,Default,,0,0,0,,Бұл үкімдерге де қатысты.
Dialogue: 0,0:00:33.74,0:00:35.36,Default,,0,0,0,,Үкім ...
Dialogue: 0,0:00:35.45,0:00:39.28,Default,,0,0,0,,Оны өмірмен де, өліммен де үйлестіру керек.
Dialogue: 0,0:00:40.62,0:00:44.66,Default,,0,0,0,,Оны адамдармен тығыз байланыста жасау керек.
Dialogue: 0,0:00:45.37,0:00:49.09,Default,,0,0,0,,Осы мақсатта адам сезімдері...
Dialogue: 0,0:00:52.17,0:00:53.67,Default,,0,0,0,,Орындалды.
Dialogue: 0,0:00:56.09,0:00:57.39,Default,,0,0,0,,Әдемі түстер...
Dialogue: 0,0:00:57.47,0:01:00.89,Default,,0,0,0,,Бір қарағанда, бірақ...
Dialogue: 0,0:01:00.97,0:01:04.89,Default,,0,0,0,,Негізінде әдемі өмір жоқ.
Dialogue: 0,0:01:05.81,0:01:07.48,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:01:09.02,0:01:13.99,Default,,0,0,0,,♪~
Dialogue: 0,0:02:23.93,0:02:28.94,Default,,0,0,0,,~♪
Dialogue: 0,0:02:29.77,0:02:31.81,Default,,0,0,0,,Әй, бұл өтірік! Харада-кун?
Dialogue: 0,0:02:32.40,0:02:35.32,Default,,0,0,0,,Сен Киом деген жерге бармадың ба?
Dialogue: 0,0:02:35.40,0:02:38.65,Default,,0,0,0,,Харада-кун! Бұл Харада-кун!
Dialogue: 0,0:02:38.74,0:02:40.16,Default,,0,0,0,,Иә? Оянбайсың ба?
Dialogue: 0,0:02:40.24,0:02:42.57,Default,,0,0,0,,Жан әлі оралған жоқ.
Dialogue: 0,0:02:43.41,0:02:47.33,Default,,0,0,0,,Жан? Не... Мен қалай ораламын?
Dialogue: 0,0:02:47.41,0:02:50.83,Default,,0,0,0,,Маған бос жерге түсу үшін алмастыратын жан керек.
Dialogue: 0,0:02:51.37,0:02:54.96,Default,,0,0,0,,Оның орнына... Жан қайтып келмесе ше?
Dialogue: 0,0:02:55.04,0:02:56.46,Default,,0,0,0,,(шу)
Dialogue: 0,0:02:58.05,0:02:59.51,Default,,0,0,0,,Міне осылай болады
Dialogue: 0,0:03:01.13,0:03:03.22,Default,,0,0,0,,Сонымен... бұл...
Dialogue: 0,0:03:05.31,0:03:07.93,Default,,0,0,0,,Қай жанды қуысқа түсірерімді шешкім келеді.
Dialogue: 0,0:03:08.02,0:03:10.48,Default,,0,0,0,,-Мен мұны істей алмаймын ба? -а?
Dialogue: 0,0:03:10.56,0:03:12.85,Default,,0,0,0,,Мен сенің орныңды алсам ғой!
Dialogue: 0,0:03:14.56,0:03:17.61,Default,,0,0,0,,Ешкімнің қандай екенін білесің бе?
Dialogue: 0,0:03:17.69,0:03:18.61,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:03:19.90,0:03:22.66,Default,,0,0,0,,Ақылсыз және түбі жоқ ақымақ...
Dialogue: 0,0:03:22.74,0:03:26.87,Default,,0,0,0,,Негізінде бұл жандардың зираты, бірақ бос кеңістік.
Dialogue: 0,0:03:26.95,0:03:29.58,Default,,0,0,0,,Тек сана ғана қалады
Dialogue: 0,0:03:29.66,0:03:32.83,Default,,0,0,0,,Қорқыныш өкініш Үмітсіздік...
Dialogue: 0,0:03:32.92,0:03:37.50,Default,,0,0,0,,Мен барлық жағымсыз эмоциялармен мәңгілікке құлап бара жатқандай сезінемін.
Dialogue: 0,0:03:38.34,0:03:40.76,Default,,0,0,0,,Бостық деген осы.
Dialogue: 0,0:03:40.84,0:03:42.88,Default,,0,0,0,,Жоқ! Мүлдем жоқ!
Dialogue: 0,0:03:42.97,0:03:44.47,Default,,0,0,0,,Мұндайды қалай байқадың, Рюзаки?
Dialogue: 0,0:03:44.55,0:03:47.18,Default,,0,0,0,,Сондықтан мен ауыстыруды дайындадым.
Dialogue: 0,0:03:48.60,0:03:51.48,Default,,0,0,0,,Кімді тастауым керек, Харада ма, әлде мына жігіт пе?
Dialogue: 0,0:03:51.56,0:03:52.89,Default,,0,0,0,,Сіз таңдайсыз
Dialogue: 0,0:03:54.48,0:03:55.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:04.36,0:04:06.66,Default,,0,0,0,,Томоюки-сан... маған
Dialogue: 0,0:04:06.74,0:04:08.95,Default,,0,0,0,,Маған бәрін айтып беріңізші
Dialogue: 0,0:04:10.75,0:04:13.16,Default,,0,0,0,,Тіпті айтайын десең де
Dialogue: 0,0:04:15.71,0:04:16.92,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:04:29.43,0:04:31.64,Default,,0,0,0,,Неліктен мен сізді таңдауым керек?
Dialogue: 0,0:04:31.72,0:04:34.56,Default,,0,0,0,,Адамдар өзін ақымақтар сияқты ұстайды
Dialogue: 0,0:04:34.64,0:04:35.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:36.02,0:04:38.73,Default,,0,0,0,,Бір күні өлетінімді ұмытсам да
Dialogue: 0,0:04:38.82,0:04:43.40,Default,,0,0,0,,Өліммен бетпе-бет келген бойда өмірге жабысамын.
Dialogue: 0,0:04:43.49,0:04:45.15,Default,,0,0,0,,Сонымен, мен
Dialogue: 0,0:04:45.24,0:04:48.83,Default,,0,0,0,,Мен ешқашан шешім қабылдауда қиындық көрген емеспін.
Dialogue: 0,0:05:06.93,0:05:09.10,Default,,0,0,0,,Сіз шешкен кезде осы түймені басыңыз
Dialogue: 0,0:05:18.48,0:05:20.11,Default,,0,0,0,,Бұл адам кім?
Dialogue: 0,0:05:20.19,0:05:23.11,Default,,0,0,0,,-Білу керек пе? -А?
Dialogue: 0,0:05:23.19,0:05:26.61,Default,,0,0,0,,Қандай адам Хараданың жоқтыққа түсуіне жол береді?
Dialogue: 0,0:05:28.61,0:05:31.24,Default,,0,0,0,,Бұл дұрыс емес
Dialogue: 0,0:05:32.33,0:05:34.25,Default,,0,0,0,,Сізде жауап бар, солай ма?
Dialogue: 0,0:06:11.70,0:06:13.66,Default,,0,0,0,,(Есіктің жабылу дыбысы)
Dialogue: 0,0:06:14.99,0:06:17.41,Default,,0,0,0,,Бұл сізге өте жарасады.
Dialogue: 0,0:06:24.00,0:06:26.42,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:06:27.59,0:06:32.18,Default,,0,0,0,,Деким патшайымға қош келдіңіз.
Dialogue: 0,0:06:34.76,0:06:37.60,Default,,0,0,0,,Менің атым бармен Деким.
Dialogue: 0,0:06:37.68,0:06:39.56,Default,,0,0,0,,Осы жерге қоңырау шалыңыз.
Dialogue: 0,0:06:46.61,0:06:48.44,Default,,0,0,0,,Қалай болды?
Dialogue: 0,0:06:49.07,0:06:51.57,Default,,0,0,0,,Мен... мен неге мұндамын?
Dialogue: 0,0:06:52.70,0:06:54.33,Default,,0,0,0,,Менің өлуім керек еді
Dialogue: 0,0:06:57.91,0:07:00.08,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:07:02.29,0:07:03.50,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:07:08.38,0:07:10.09,Default,,0,0,0,,Ол не үшін өлді?
Dialogue: 0,0:07:12.51,0:07:15.05,Default,,0,0,0,,Эй... неге?
Dialogue: 0,0:07:17.31,0:07:19.52,Default,,0,0,0,,Бұл сирек.
Dialogue: 0,0:07:19.60,0:07:22.35,Default,,0,0,0,,Ойынға бағыттау мүмкін болмады
Dialogue: 0,0:07:22.44,0:07:26.61,Default,,0,0,0,,Бұл барлау бөлімінің қателігі деп ойлаймын. Мен оны өзім реттеймін.
Dialogue: 0,0:07:26.69,0:07:28.23,Default,,0,0,0,,Өңдеу...?
Dialogue: 0,0:07:28.32,0:07:30.99,Default,,0,0,0,,Жадыңызды өшіріп, шешімді қайта бастаңыз
Dialogue: 0,0:07:31.07,0:07:32.28,Default,,0,0,0,,Әрине, солай ма?
Dialogue: 0,0:07:32.36,0:07:34.12,Default,,0,0,0,,Клавис, мені ал.
Dialogue: 0,0:07:34.20,0:07:35.62,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:07:40.20,0:07:44.25,Default,,0,0,0,,Сіз маған оны басқаруға рұқсат бере аласыз ба?
Dialogue: 0,0:07:44.33,0:07:45.75,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:07:47.92,0:07:49.26,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:07:49.84,0:07:51.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:56.10,0:08:00.64,Default,,0,0,0,,Жақсы, бірақ мен оны біраз уақытқа осында қалдырамын.
Dialogue: 0,0:08:01.27,0:08:02.85,Default,,0,0,0,,Көмекші
Dialogue: 0,0:08:37.51,0:08:38.55,Default,,0,0,0,,Мен...
Dialogue: 0,0:09:02.41,0:09:05.33,Default,,0,0,0,,Ватару!
Dialogue: 0,0:09:05.41,0:09:06.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:41.42,0:12:42.63,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:48.14,0:12:50.06,Default,,0,0,0,,Ха! Уф…
Dialogue: 0,0:12:53.35,0:12:56.90,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:13:09.45,0:13:11.87,Default,,0,0,0,,Сіз коньки тебуді ұнататынсыз.
Dialogue: 0,0:13:12.66,0:13:13.87,Default,,0,0,0,,Иә
Dialogue: 0,0:13:15.96,0:13:18.21,Default,,0,0,0,,Мен аяғымды ауыртып, ауруханаға түстім.
Dialogue: 0,0:13:20.04,0:13:24.59,Default,,0,0,0,,Біраз уақыттан кейін мен енді коньки тебе алмайтынымды түсіндім...
Dialogue: 0,0:13:25.63,0:13:28.55,Default,,0,0,0,,Мен үшін бәрі жылады...
Dialogue: 0,0:13:29.68,0:13:31.81,Default,,0,0,0,,Бірақ мен ештеңе сезбеймін...
Dialogue: 0,0:13:32.64,0:13:35.10,Default,,0,0,0,,Не айтсаң да, түсінбеймін...
Dialogue: 0,0:13:36.44,0:13:39.44,Default,,0,0,0,,Бірақ мен ешкімге айта алмадым...
Dialogue: 0,0:13:52.74,0:13:54.45,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:13:56.58,0:13:57.79,Default,,0,0,0,,Күріш.
Dialogue: 0,0:13:59.63,0:14:01.84,Default,,0,0,0,,Сіздің қарныңыз ашты ма?
Dialogue: 0,0:14:12.68,0:14:15.93,Default,,0,0,0,,Бірінші турнирдің кубогы
Dialogue: 0,0:14:17.48,0:14:19.02,Default,,0,0,0,,Ана
Dialogue: 0,0:14:19.81,0:14:22.94,Default,,0,0,0,,Мен Томоюки коньки тебуді жақсы көремін.
Dialogue: 0,0:14:24.48,0:14:27.11,Default,,0,0,0,,Жақсы өскеніңіз үшін рахмет.
Dialogue: 0,0:14:27.19,0:14:28.95,Default,,0,0,0,,Бәрінен де бақыттымын.
Dialogue: 0,0:14:30.07,0:14:31.45,Default,,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,0:14:32.20,0:14:33.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:37.96,0:14:39.46,Default,,0,0,0,,Солай емес пе...
Dialogue: 0,0:14:42.84,0:14:44.38,Default,,0,0,0,,Қазірдің өзінде шық.
Dialogue: 0,0:14:45.75,0:14:46.96,Default,,0,0,0,,Иә
Dialogue: 0,0:14:47.05,0:14:48.84,Default,,0,0,0,,(Томоюки жылайды)
Dialogue: 0,0:14:48.92,0:14:51.14,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:14:55.68,0:14:57.43,Default,,0,0,0,,Коньки тебе алмау
Dialogue: 0,0:14:57.52,0:14:59.10,Default,,0,0,0,,Бұл қиын болған шығар...
Dialogue: 0,0:15:00.06,0:15:03.15,Default,,0,0,0,,Тағы да көптеген маңызды нәрселер болды...
Dialogue: 0,0:15:03.23,0:15:05.52,Default,,0,0,0,,Отбасы, достар, т.б.
Dialogue: 0,0:15:05.61,0:15:07.99,Default,,0,0,0,,Менің коньки тебетін достарым көп...
Dialogue: 0,0:15:08.78,0:15:12.32,Default,,0,0,0,,Мен мұның соншалықты ауыр не екенін де білмедім.
Dialogue: 0,0:15:14.66,0:15:16.16,Default,,0,0,0,,Енді мен білемін
Dialogue: 0,0:15:16.91,0:15:20.12,Default,,0,0,0,,Құрметті достар, әріптестер, тіпті отбасы
Dialogue: 0,0:15:20.21,0:15:22.54,Default,,0,0,0,,Шын мәнінде, сіз бейтаныс адамсыз, солай ма?
Dialogue: 0,0:15:22.63,0:15:24.50,Default,,0,0,0,,Өйткені бұл ол емес.
Dialogue: 0,0:15:25.17,0:15:28.71,Default,,0,0,0,,Мен мұндай анық нәрсені ешқашан байқамадым...
Dialogue: 0,0:15:29.38,0:15:31.97,Default,,0,0,0,,Бұрын маңызды болған нәрсе қазір өтірік сияқты
Dialogue: 0,0:15:32.47,0:15:35.01,Default,,0,0,0,,Менде ештеңе жоқ...
Dialogue: 0,0:15:36.10,0:15:37.97,Default,,0,0,0,,Егер сіз бұл туралы ойласаңыз
Dialogue: 0,0:15:38.06,0:15:40.73,Default,,0,0,0,,Мен өзімді қатты жек көрдім.
Dialogue: 0,0:15:41.19,0:15:42.02,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:15:43.60,0:15:45.52,Default,,0,0,0,,Мен өзім өлдім.
Dialogue: 0,0:15:49.44,0:15:51.82,Default,,0,0,0,,Адамдар бір-бірін түсіне алмайды
Dialogue: 0,0:15:52.86,0:15:56.49,Default,,0,0,0,,Бір-бірімізді түсінгіміз келеді деп ойлау қате.
Dialogue: 0,0:15:59.50,0:16:03.42,Default,,0,0,0,,Өлгеннен кейін білу – жауыздық.
Dialogue: 0,0:16:04.17,0:16:05.42,Default,,0,0,0,,Өмір дегеніміз не?
Dialogue: 0,0:16:10.17,0:16:13.38,Default,,0,0,0,,Адамдар бақытты кезде күледі.
Dialogue: 0,0:16:13.47,0:16:16.43,Default,,0,0,0,,Мұңайсам көз жасым.
Dialogue: 0,0:16:16.51,0:16:20.06,Default,,0,0,0,,Томоюки-сан, қазір көңіл-күйің қалай?
Dialogue: 0,0:16:21.93,0:16:24.06,Default,,0,0,0,,Бұл қайғылы болуы керек, солай ма?
Dialogue: 0,0:16:24.14,0:16:26.86,Default,,0,0,0,,Түсінгіңіз келетін нәрсе
Dialogue: 0,0:16:26.94,0:16:28.44,Default,,0,0,0,,Бұл қате ме?
Dialogue: 0,0:16:28.52,0:16:29.73,Default,,0,0,0,,А...
Dialogue: 0,0:16:32.07,0:16:36.45,Default,,0,0,0,,Мен Томоюки-сан туралы көбірек түсінгім келеді.
Dialogue: 0,0:16:40.29,0:16:42.45,Default,,0,0,0,,Мен тіпті өлген жоқпын.
Dialogue: 0,0:16:42.54,0:16:44.37,Default,,0,0,0,,Тіпті өмір сүрмеген
Dialogue: 0,0:16:45.92,0:16:48.84,Default,,0,0,0,,Мен мұны айтудың дұрыс әдісі екенін білмеймін, бірақ...
Dialogue: 0,0:16:49.92,0:16:53.97,Default,,0,0,0,,Мен Томоюки-санмен кездескеніме өте қуаныштымын.
Dialogue: 0,0:16:54.05,0:16:55.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:59.76,0:17:00.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:05.27,0:17:06.48,Default,,0,0,0,,Осымен
Dialogue: 0,0:17:06.56,0:17:08.11,Default,,0,0,0,,Не?
Dialogue: 0,0:17:10.77,0:17:11.98,Default,,0,0,0,,Я...
Dialogue: 0,0:17:12.86,0:17:14.45,Default,,0,0,0,,Пыс, пыс… Э?
Dialogue: 0,0:17:14.53,0:17:15.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:24.54,0:17:26.75,Default,,0,0,0,,Бұл соңғы рет пе...
Dialogue: 0,0:17:28.17,0:17:29.50,Default,,0,0,0,,Қандай спирт?
Dialogue: 0,0:17:29.59,0:17:31.38,Default,,0,0,0,,Естелік Мори
Dialogue: 0,0:17:31.46,0:17:34.51,Default,,0,0,0,,«Өлім туралы ойлау» деген мағына бар сияқты.
Dialogue: 0,0:17:35.42,0:17:37.26,Default,,0,0,0,,Өлім туралы ойланыңыз
Dialogue: 0,0:17:39.34,0:17:42.43,Default,,0,0,0,,Бір күні өлетініңді ұмытпа
Dialogue: 0,0:17:42.51,0:17:45.43,Default,,0,0,0,,Міне, сондықтан мен қазір өмір сүремін
Dialogue: 0,0:17:45.52,0:17:48.27,Default,,0,0,0,,Бұл сөздер хабарламаны қамтиды
Dialogue: 0,0:17:48.85,0:17:51.32,Default,,0,0,0,,Қазір тікелей эфирде...
Dialogue: 0,0:17:52.86,0:17:54.90,Default,,0,0,0,,-Сонымен... -(Томоюки) Сәлеметсіз бе
Dialogue: 0,0:17:58.03,0:17:59.87,Default,,0,0,0,,Иә, бұл дәмді.
Dialogue: 0,0:18:03.99,0:18:06.08,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:08.29,0:18:11.00,Default,,0,0,0,,Сондықтан, егер Урарака ханым алғашқы қадамды жасаса…
Dialogue: 0,0:18:26.60,0:18:27.98,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:18:28.06,0:18:30.73,Default,,0,0,0,,Міне, Хараданың жаны.
Dialogue: 0,0:18:30.81,0:18:32.56,Default,,0,0,0,,Сіз шынымен оянып жатырсыз, солай емес пе?
Dialogue: 0,0:18:32.65,0:18:33.48,Default,,0,0,0,,О
Dialogue: 0,0:18:34.69,0:18:38.11,Default,,0,0,0,,Сізден бірдеңе сұрайыншы, Харада сіз үшін нені білдіреді?
Dialogue: 0,0:18:39.03,0:18:40.61,Default,,0,0,0,,Менің өмірім
Dialogue: 0,0:18:40.70,0:18:44.66,Default,,0,0,0,,Сонда Харадасыз сіздің өміріңіз қандай болар еді?
Dialogue: 0,0:18:45.41,0:18:47.62,Default,,0,0,0,,Сіз нені мазақ етесіз?
Dialogue: 0,0:18:47.70,0:18:50.92,Default,,0,0,0,,Жауабы. Мұның мәні неде еді?
Dialogue: 0,0:18:51.00,0:18:52.75,Default,,0,0,0,,Мен өзімді білмеймін!
Dialogue: 0,0:18:52.84,0:18:54.80,Default,,0,0,0,,Мағынасыз өмір сүру жақсы емес пе?
Dialogue: 0,0:18:54.88,0:18:57.38,Default,,0,0,0,,Мен тағы да білмеймін.
Dialogue: 0,0:18:57.46,0:18:59.47,Default,,0,0,0,,Сонда сіз ше?
Dialogue: 0,0:18:59.55,0:19:00.38,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:00.47,0:19:03.26,Default,,0,0,0,,Неге бұлай істеп жатырсың?
Dialogue: 0,0:19:03.35,0:19:07.02,Default,,0,0,0,,Оның мағынасы жоқ, мен төрешімін.
Dialogue: 0,0:19:10.14,0:19:12.52,Default,,0,0,0,,Төрешіге жаным ашиды.
Dialogue: 0,0:19:13.11,0:19:14.31,Default,,0,0,0,,Не?
Dialogue: 0,0:19:15.61,0:19:18.53,Default,,0,0,0,,Шешімді өзім қабылдадым.
Dialogue: 0,0:19:18.61,0:19:21.53,Default,,0,0,0,,Бұл ешкім мақтанбайтын өмір емес шығар, бірақ...
Dialogue: 0,0:19:21.61,0:19:24.74,Default,,0,0,0,,Мен оны Харада-кунға арнауды шештім!
Dialogue: 0,0:19:24.83,0:19:27.04,Default,,0,0,0,,Осының өзі мағыналы болуы керек!
Dialogue: 0,0:19:29.00,0:19:30.58,Default,,0,0,0,,Солай болғай.
Dialogue: 0,0:19:38.09,0:19:41.84,Default,,0,0,0,,(лифттің көтерілу және төмендеу дыбысы)
Dialogue: 0,0:19:41.93,0:19:43.30,Default,,0,0,0,,Бұл жақсы...
Dialogue: 0,0:19:49.06,0:19:51.81,Default,,0,0,0,,Ха... Бұл не?
Dialogue: 0,0:19:51.89,0:19:55.19,Default,,0,0,0,,Жоқ! Харада-кун! Харада-кун!
Dialogue: 0,0:20:19.46,0:20:20.88,Default,,0,0,0,,Харада-кун...
Dialogue: 0,0:20:42.03,0:20:47.03,Default,,0,0,0,,♪~
Dialogue: 0,0:21:48.14,0:21:51.89,Default,,0,0,0,,~♪
Dialogue: 0,0:21:51.97,0:21:53.93,Default,,0,0,0,,(телефон қоңырауы)
Dialogue: 0,0:21:55.06,0:21:57.44,Default,,0,0,0,,Иә Ақпарат бөлімі
Dialogue: 0,0:21:57.52,0:21:58.94,Default,,0,0,0,,Менің сенен бір жақсылығым бар.
Dialogue: 0,0:22:00.02,0:22:01.23,Default,,0,0,0,,Не?
Dialogue: 0,0:22:01.31,0:22:03.86,Default,,0,0,0,,Маған естеліктеріңізді жібере аласыз ба?
Dialogue: 0,0:22:06.57,0:22:09.57,Default,,0,0,0,,Міне~ Мен оны қазір тасымалдағалы жатырмын.
Dialogue: 0,0:22:10.24,0:22:12.53,Default,,0,0,0,,Түсіндім, рахмет
Dialogue: 0,0:22:17.58,0:22:19.00,Default,,0,0,0,,(Келу қоңырауы)
Dialogue: 0,0:22:23.59,0:22:25.13,Default,,0,0,0,,Қай жолмен?
Dialogue: 0,0:22:25.21,0:22:27.13,Default,,0,0,0,,Кез келген жерде жақсы.
Dialogue: 0,0:22:27.92,0:22:31.05,Default,,0,0,0,,Сіз көңілді болып көрінетін нәрсені істеп жатырсыз.
Dialogue: 0,0:22:31.14,0:22:32.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:33.60,0:22:34.85,Default,,0,0,0,,Дәл айтқанда, жоқ. Мен жартылай эльфпін.
Dialogue: 0,0:22:36.35,0:22:42.35,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory