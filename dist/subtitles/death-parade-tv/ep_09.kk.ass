Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.91,0:00:04.08,Default,,0,0,0,,Мен әпкемді аңдығаныма біраз болды.
Dialogue: 0,0:00:04.17,0:00:05.79,Default,,0,0,0,,Менің аңдыушым бар...
Dialogue: 0,0:00:06.58,0:00:08.80,Default,,0,0,0,,Мен де полицияға бардым т.б.
Dialogue: 0,0:00:09.38,0:00:11.30,Default,,0,0,0,,Мен сені қозғалта алмаймын...
Dialogue: 0,0:00:12.17,0:00:14.26,Default,,0,0,0,,Мен кешіре алмаймын
Dialogue: 0,0:00:15.39,0:00:17.14,Default,,0,0,0,,Кек алу?
Dialogue: 0,0:00:17.22,0:00:20.43,Default,,0,0,0,,Мен таң қалдым. Дәл солай.
Dialogue: 0,0:00:20.52,0:00:21.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:21.52,0:00:25.15,Default,,0,0,0,,Детективтің бұлай айтуы біртүрлі.
Dialogue: 0,0:00:26.44,0:00:27.69,Default,,0,0,0,,Мен осы жерден кеткенде...
Dialogue: 0,0:00:28.98,0:00:32.19,Default,,0,0,0,,Біреуді өлтіру...
Dialogue: 0,0:00:32.99,0:00:35.20,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:00:35.99,0:00:39.95,Default,,0,0,0,,Екі кісі өлтіруші де...
Dialogue: 0,0:00:45.04,0:00:50.05,Default,,0,0,0,,♪~
Dialogue: 0,0:01:59.91,0:02:04.91,Default,,0,0,0,,~♪
Dialogue: 0,0:02:06.04,0:02:09.17,Default,,0,0,0,,Сіздің әйеліңіз... өлтірілді ме?
Dialogue: 0,0:02:09.25,0:02:13.17,Default,,0,0,0,,А... бұл детективтердің табиғаты шығар.
Dialogue: 0,0:02:13.96,0:02:17.17,Default,,0,0,0,,Менің көзім үнемі сыртқа бағытталған.
Dialogue: 0,0:02:17.76,0:02:19.18,Default,,0,0,0,,Қорғау
Dialogue: 0,0:02:19.80,0:02:21.26,Default,,0,0,0,,Мен уәде берсем де...
Dialogue: 0,0:02:23.81,0:02:26.68,Default,,0,0,0,,Менің ағам Сады қорғайды.
Dialogue: 0,0:02:31.56,0:02:34.19,Default,,0,0,0,,- (Шимада) Ендеше кек ал - (Тацуми) Ах.
Dialogue: 0,0:02:35.32,0:02:37.69,Default,,0,0,0,,Шимада-кун қылмыскерді тапса не істейді?
Dialogue: 0,0:02:40.99,0:02:43.83,Default,,0,0,0,,Мен сенімдімін... Мен де солай сезінемін...
Dialogue: 0,0:02:43.91,0:02:47.87,Default,,0,0,0,,Жоқ, мен сені өлтіремін деп ойлаймын.
Dialogue: 0,0:02:48.83,0:02:50.58,Default,,0,0,0,,Адал
Dialogue: 0,0:02:50.67,0:02:54.34,Default,,0,0,0,,Кейбір адамдардың өлгені жақсы екені рас.
Dialogue: 0,0:02:54.42,0:02:56.09,Default,,0,0,0,,Міндетті түрде бар
Dialogue: 0,0:02:57.13,0:03:00.09,Default,,0,0,0,,Бұл... өлгендерді еске алу
Dialogue: 0,0:03:00.63,0:03:03.64,Default,,0,0,0,,Әдетте аралас естеліктер араласады
Dialogue: 0,0:03:03.72,0:03:05.10,Default,,0,0,0,,Түсіну өте қиын
Dialogue: 0,0:03:05.72,0:03:07.06,Default,,0,0,0,,Тек естеліктер
Dialogue: 0,0:03:07.14,0:03:10.14,Default,,0,0,0,,Шынайы сезімді түсіру мүмкін емес.
Dialogue: 0,0:03:11.81,0:03:14.19,Default,,0,0,0,,Өлгені жақсы адамдар...
Dialogue: 0,0:03:14.27,0:03:16.32,Default,,0,0,0,,Олар қоқыс.
Dialogue: 0,0:03:16.40,0:03:21.49,Default,,0,0,0,,Бірінші тергеу бөлімі қараған істердің көбісі таңқаларлық қатыгез және жексұрын.
Dialogue: 0,0:03:22.16,0:03:25.33,Default,,0,0,0,,Бір адам екенімізге сену қиын
Dialogue: 0,0:03:26.08,0:03:28.33,Default,,0,0,0,,Детектив ретінде емес...
Dialogue: 0,0:03:28.41,0:03:31.25,Default,,0,0,0,,Осыны адам ретінде айтайын.
Dialogue: 0,0:03:32.58,0:03:34.21,Default,,0,0,0,,Сен…
Dialogue: 0,0:03:34.88,0:03:36.71,Default,,0,0,0,,Қате емес
Dialogue: 0,0:03:37.50,0:03:38.71,Default,,0,0,0,,Мен мұндай боларын ойламаппын.
Dialogue: 0,0:03:47.89,0:03:50.68,Default,,0,0,0,,Тоқтауға рұқсат етіңіз.
Dialogue: 0,0:03:50.77,0:03:54.81,Default,,0,0,0,,Жүрегіңіздегі қараңғылық мүмкіндігінше сыртқа шығып, қабыл алыңыз.
Dialogue: 0,0:03:55.31,0:03:57.36,Default,,0,0,0,,және ұйғарым шығарыңыз
Dialogue: 0,0:03:57.44,0:04:00.53,Default,,0,0,0,,Бұл төреші.
Dialogue: 0,0:04:10.95,0:04:11.79,Default,,0,0,0,,Аһ!
Dialogue: 0,0:04:12.87,0:04:14.08,Default,,0,0,0,,(Мақсатқа кіру дыбысы)
Dialogue: 0,0:04:14.17,0:04:17.13,Default,,0,0,0,,Сен менің курткамды ұшырып, мені де ұшырып жібердің ғой!
Dialogue: 0,0:04:20.84,0:04:22.09,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:04:22.17,0:04:23.68,Default,,0,0,0,,(құлыпты ашу дыбысы)
Dialogue: 0,0:04:23.76,0:04:24.59,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:26.68,0:04:29.85,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:04:30.93,0:04:32.10,Default,,0,0,0,,Тек сол күні Миямура-кунды шақырғаныңды ұмытпа.
Dialogue: 0,0:04:33.18,0:04:35.35,Default,,0,0,0,,- (Еркек) Колла! -(Шимада) Гуг!
Dialogue: 0,0:04:35.44,0:04:36.73,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:40.65,0:04:44.82,Default,,0,0,0,,Сол жақ қолыңдағы ырғақ артта қалып жатыр
Dialogue: 0,0:04:47.95,0:04:49.12,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:04:50.16,0:04:51.49,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:52.54,0:04:54.50,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:55.08,0:04:59.50,Default,,0,0,0,,Тацуми-сан... Мен... мен оны өлтірдім.
Dialogue: 0,0:05:00.42,0:05:03.26,Default,,0,0,0,,Мен сені осылай пышақтадым.
Dialogue: 0,0:05:05.68,0:05:06.88,Default,,0,0,0,,Тек...
Dialogue: 0,0:05:08.18,0:05:11.39,Default,,0,0,0,,Мен олардың өлгенін қалаймын.
Dialogue: 0,0:05:12.68,0:05:14.02,Default,,0,0,0,,Сіз жалғыз емессіз бе?
Dialogue: 0,0:05:15.02,0:05:17.27,Default,,0,0,0,,Мен оған қарап тұрдым...
Dialogue: 0,0:05:18.06,0:05:19.56,Default,,0,0,0,,Менің ойымша, біз доспыз.
Dialogue: 0,0:05:24.36,0:05:26.15,Default,,0,0,0,,Әлі біткен жоқ...
Dialogue: 0,0:05:27.32,0:05:29.37,Default,,0,0,0,,Тағы бір адам бар.
Dialogue: 0,0:05:40.71,0:05:42.25,Default,,0,0,0,,Жүректің қараңғылығы...
Dialogue: 0,0:05:43.92,0:05:46.63,Default,,0,0,0,,Адамның ең қарапайым эмоциясы қандай?
Dialogue: 0,0:05:46.72,0:05:48.18,Default,,0,0,0,,Сіз бірдеңе білесіз бе?
Dialogue: 0,0:05:49.05,0:05:50.43,Default,,0,0,0,,Қорқыныш
Dialogue: 0,0:05:52.39,0:05:53.60,Default,,0,0,0,,Не...
Dialogue: 0,0:05:59.81,0:06:01.19,Default,,0,0,0,,Мені жеңіл санама!
Dialogue: 0,0:06:01.27,0:06:02.40,Default,,0,0,0,,Тацуми-сан!
Dialogue: 0,0:06:03.15,0:06:05.23,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:06.99,0:06:08.40,Default,,0,0,0,,Маған үзіліс беріңіз!
Dialogue: 0,0:06:09.82,0:06:12.53,Default,,0,0,0,,(ер адамның айқайы)
Dialogue: 0,0:06:17.29,0:06:20.04,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:06:20.12,0:06:23.29,Default,,0,0,0,,Юми...жау қолға түсті.
Dialogue: 0,0:06:23.38,0:06:26.46,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:06:26.55,0:06:28.05,Default,,0,0,0,,Рахмет
Dialogue: 0,0:06:31.93,0:06:33.18,Default,,0,0,0,,Осылай жалғаса берсе, бұл тағдыр ғой, иә?
Dialogue: 0,0:06:34.01,0:06:37.56,Default,,0,0,0,,Тацуми мырза? Тацуми мырза! Тацуми мырза!
Dialogue: 0,0:06:38.14,0:06:40.31,Default,,0,0,0,,Тацуми-сан біртүрлі әрекет етеді...
Dialogue: 0,0:06:40.39,0:06:42.65,Default,,0,0,0,,Ойынды жалғастыру
Dialogue: 0,0:06:43.15,0:06:44.27,Default,,0,0,0,,А... жоқ, бірақ...
Dialogue: 0,0:06:44.36,0:06:48.24,Default,,0,0,0,,Ағымдағы ұпай 4-4 тең.
Dialogue: 0,0:06:48.32,0:06:50.95,Default,,0,0,0,,Келесі бума Шимада мырзаның түсі.
Dialogue: 0,0:06:51.53,0:06:54.12,Default,,0,0,0,,Ұпай жинасаңыз, ұпай екі еселенеді.
Dialogue: 0,0:06:54.20,0:06:57.70,Default,,0,0,0,,Жеңімпаз көрсетілген ұпайға жеткеннен кейін анықталады.
Dialogue: 0,0:06:58.29,0:07:01.83,Default,,0,0,0,,Жеңімпаз? Сен не туралы айтып тұрсың?
Dialogue: 0,0:07:01.92,0:07:03.84,Default,,0,0,0,,Тацуми-санға көмектесіңізші!
Dialogue: 0,0:07:03.92,0:07:06.21,Default,,0,0,0,,Басынан бастап өмірімді қатерге тігіп\NМен сізге мұны айтуым керек еді
Dialogue: 0,0:07:06.30,0:07:08.09,Default,,0,0,0,,...
Dialogue: 0,0:07:08.17,0:07:11.05,Default,,0,0,0,,Тағы қандай мәселе бар?
Dialogue: 0,0:07:11.13,0:07:11.97,Default,,0,0,0,,Тацуми-сан...
Dialogue: 0,0:07:12.05,0:07:13.97,Default,,0,0,0,,Бұлай істеудің қажеті жоқ.
Dialogue: 0,0:07:14.05,0:07:15.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:18.27,0:07:21.98,Default,,0,0,0,,Керемет! Мен не істеймін деп ойладым...
Dialogue: 0,0:07:26.27,0:07:27.48,Default,,0,0,0,,Тацуми мырза?
Dialogue: 0,0:07:28.48,0:07:31.70,Default,,0,0,0,,Жарайды, ары қарай жалғастырайық.
Dialogue: 0,0:07:32.91,0:07:34.45,Default,,0,0,0,,Не айтып тұрсың!
Dialogue: 0,0:07:34.53,0:07:36.83,Default,,0,0,0,,Ойын қазір жақсы! Мен қалыс қаламын!
Dialogue: 0,0:07:36.91,0:07:40.37,Default,,0,0,0,,Менің ойымша, кек әлі біткен жоқ.
Dialogue: 0,0:07:40.45,0:07:43.25,Default,,0,0,0,,Бірақ мұны істегеннен кейін де мен...
Dialogue: 0,0:07:43.33,0:07:45.59,Default,,0,0,0,,- (Тацуми) Бұл жақсы емес - (Шимада) Иә?
Dialogue: 0,0:07:47.63,0:07:50.26,Default,,0,0,0,,Қойсаң қайтеді...
Dialogue: 0,0:07:50.34,0:07:51.80,Default,,0,0,0,,Мен де солай істеймін.
Dialogue: 0,0:07:53.13,0:07:55.80,Default,,0,0,0,,Бірақ... Тацумидің денесі...
Dialogue: 0,0:07:56.39,0:07:59.18,Default,,0,0,0,,Тыныс алуды толығымен тоқтату керек.
Dialogue: 0,0:07:59.27,0:08:00.56,Default,,0,0,0,,Тацуми...?
Dialogue: 0,0:08:00.64,0:08:02.94,Default,,0,0,0,,Менің не айтып тұрғанымды түсіндің бе?
Dialogue: 0,0:08:03.98,0:08:05.69,Default,,0,0,0,,Әрқашанғыдай, сенің бұл бейқам мінезің—
Dialogue: 0,0:08:09.03,0:08:11.19,Default,,0,0,0,,Жарайды, жалғастырайық.
Dialogue: 0,0:08:16.78,0:08:18.45,Default,,0,0,0,,Сіз дайынсыз ба?
Dialogue: 0,0:08:21.20,0:08:23.41,Default,,0,0,0,,Мен саған үлкен үміт артамын.
Dialogue: 0,0:08:23.50,0:08:25.92,Default,,0,0,0,,Мені ренжітпе
Dialogue: 0,0:08:26.50,0:08:27.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:27.46,0:08:30.71,Default,,0,0,0,,Мақсатымыз бір екенін білгенде, мен...
Dialogue: 0,0:08:30.80,0:08:32.30,Default,,0,0,0,,I was happy.
Dialogue: 0,0:08:32.97,0:08:35.05,Default,,0,0,0,,- (Симада) Бірақ... - (Тацуми) Кері соққы.
Dialogue: 0,0:08:35.76,0:08:36.76,Default,,0,0,0,,Мен...
Dialogue: 0,0:08:36.84,0:08:39.56,Default,,0,0,0,,Бұл сіздің әпкеңізге шабуыл жасаған адамдарды кешіресіз бе?
Dialogue: 0,0:08:39.64,0:08:41.43,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:08:41.52,0:08:44.31,Default,,0,0,0,,Неге біз күресуіміз керек!
Dialogue: 0,0:08:44.39,0:08:48.81,Default,,0,0,0,,Бір нәрсеге қол жеткізу үшін әрқашан құрбандық қажет.
Dialogue: 0,0:08:48.90,0:08:50.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:50.19,0:08:54.99,Default,,0,0,0,,Егер сізде мұндай шешім болмаса, кек алуға ешқандай мүмкіндік жоқ.
Dialogue: 0,0:08:55.07,0:08:57.57,Default,,0,0,0,,Бірінші адам сәтті болды.
Dialogue: 0,0:08:57.66,0:09:03.25,Default,,0,0,0,,Мен сенің кек үшін құрбан болуға қарсы емеспін.
Dialogue: 0,0:09:04.29,0:09:07.04,Default,,0,0,0,,Әпкеңнің кекін кетір!
Dialogue: 0,0:09:18.01,0:09:21.93,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:09:48.17,0:09:49.83,Default,,0,0,0,,Арх!
Dialogue: 0,0:10:02.05,0:10:03.64,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:10:11.31,0:10:14.36,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:10:17.45,0:10:18.86,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:20.24,0:10:21.66,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:10:22.45,0:10:24.20,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:10:27.83,0:10:31.38,Default,,0,0,0,,Шимада мырза 6-дан 4-ке дейін жеңеді.
Dialogue: 0,0:10:32.04,0:10:33.75,Default,,0,0,0,,Неге… неге мен
Dialogue: 0,0:10:36.67,0:10:38.26,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:10:39.80,0:10:41.64,Default,,0,0,0,,Шимада…
Dialogue: 0,0:10:44.72,0:10:48.23,Default,,0,0,0,,Сіз... Са Шимаданың ағасысыз ба?
Dialogue: 0,0:10:48.31,0:10:50.77,Default,,0,0,0,,Не, менің әпкемді білесің бе?
Dialogue: 0,0:10:55.98,0:10:57.78,Default,,0,0,0,,Тацуми мырза?
Dialogue: 0,0:10:57.86,0:10:59.49,Default,,0,0,0,,Жоқ, біз бұлай істей алмаймыз!
Dialogue: 0,0:10:59.57,0:11:02.45,Default,,0,0,0,,Бұл мені өлтірді дегенді білдіре ме?
Dialogue: 0,0:11:02.53,0:11:04.78,Default,,0,0,0,,-Иә - (Шимада)?
Dialogue: 0,0:11:05.41,0:11:10.04,Default,,0,0,0,,Өлгеннен кейін адамдар жұмаққа немесе тозаққа жіберіледі.
Dialogue: 0,0:11:10.12,0:11:12.79,Default,,0,0,0,,Бұл жандардың трибуналы.
Dialogue: 0,0:11:13.75,0:11:15.75,Default,,0,0,0,,Жанның үкімі?
Dialogue: 0,0:11:15.84,0:11:18.88,Default,,0,0,0,,Иә, мен төрешімін
Dialogue: 0,0:11:19.38,0:11:21.68,Default,,0,0,0,,Сізді алдағаным үшін кешіріңіз.
Dialogue: 0,0:11:22.51,0:11:24.43,Default,,0,0,0,,Төреші…
Dialogue: 0,0:11:24.51,0:11:28.93,Default,,0,0,0,,Екеуің не айтып тұрсыңдар? Сен қалжыңдап тұрсың ба?
Dialogue: 0,0:11:29.52,0:11:31.94,Default,,0,0,0,,Әлі есіңізде жоқ па?
Dialogue: 0,0:11:32.69,0:11:35.31,Default,,0,0,0,,Сен мені өлтірдің.
Dialogue: 0,0:11:35.98,0:11:38.44,Default,,0,0,0,,Әлі есімде жоқ па?
Dialogue: 0,0:11:39.28,0:11:42.11,Default,,0,0,0,,Сен мені пышақтап алдың.
Dialogue: 0,0:11:43.78,0:11:45.70,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:11:46.20,0:11:49.20,Default,,0,0,0,,А... ха... уф
Dialogue: 0,0:11:49.83,0:11:51.71,Default,,0,0,0,,(құсу дыбысы)
Dialogue: 0,0:11:53.33,0:11:54.96,Default,,0,0,0,,Я...
Dialogue: 0,0:11:55.84,0:11:58.63,Default,,0,0,0,,Тағы бір адам...
Dialogue: 0,0:12:02.80,0:12:04.47,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:12:18.32,0:12:21.11,Default,,0,0,0,,- (Тацуми) Уф - (Шимада) Ооооооо
Dialogue: 0,0:12:21.19,0:12:23.11,Default,,0,0,0,,…
Dialogue: 0,0:12:23.70,0:12:28.41,Default,,0,0,0,,(Шимаданың айқайы)
Dialogue: 0,0:12:28.49,0:12:31.12,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:12:31.20,0:12:35.00,Default,,0,0,0,,Сае... мен жасадым...
Dialogue: 0,0:12:39.63,0:12:41.76,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:12:42.67,0:12:45.89,Default,,0,0,0,,Керек болса, мені басқа пышақпен ұрып ал.
Dialogue: 0,0:12:46.43,0:12:50.68,Default,,0,0,0,,Маған әлгі бейбақтың қаны денеме кіріп кеткені ұнамайды.
Dialogue: 0,0:12:50.76,0:12:53.39,Default,,0,0,0,,Өлтіруден де артық
Dialogue: 0,0:12:56.77,0:12:58.94,Default,,0,0,0,,Неге... Тацуми-сан
Dialogue: 0,0:12:59.61,0:13:01.94,Default,,0,0,0,,Неге мұндай жерде...
Dialogue: 0,0:13:02.53,0:13:04.15,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:13:05.78,0:13:07.70,Default,,0,0,0,,Сіз сияқты
Dialogue: 0,0:13:07.78,0:13:11.20,Default,,0,0,0,,Маған ұнады. Арбитр дедіңіз.
Dialogue: 0,0:13:12.29,0:13:17.21,Default,,0,0,0,,Олар күдікті адамдарды белгілеп, бағалайды.
Dialogue: 0,0:13:17.29,0:13:21.46,Default,,0,0,0,,Әлгі адам солардың бірі еді.
Dialogue: 0,0:13:24.30,0:13:26.22,Default,,0,0,0,,Сондықтан мен бақылап отырдым
Dialogue: 0,0:13:28.01,0:13:31.35,Default,,0,0,0,,Мүмкін Тацуми-санның әпкесі...
Dialogue: 0,0:13:31.93,0:13:33.35,Default,,0,0,0,,О
Dialogue: 0,0:13:33.43,0:13:36.10,Default,,0,0,0,,Әрине, мен көрдім.
Dialogue: 0,0:13:36.19,0:13:37.77,Default,,0,0,0,,Тыныш болыңыз!
Dialogue: 0,0:13:38.69,0:13:41.11,Default,,0,0,0,,Жоқ! Маған ұнамайды...
Dialogue: 0,0:13:52.62,0:13:54.25,Default,,0,0,0,,Мен қарап тұрдым...
Dialogue: 0,0:13:55.75,0:13:57.37,Default,,0,0,0,,Менің ойымша, біз доспыз.
Dialogue: 0,0:14:01.54,0:14:02.75,Default,,0,0,0,,Неге...
Dialogue: 0,0:14:03.50,0:14:05.63,Default,,0,0,0,,Неге мені тоқтатпадың!
Dialogue: 0,0:14:05.71,0:14:10.26,Default,,0,0,0,,Қарындасыма қол көтергенде неге көмектеспедің?
Dialogue: 0,0:14:10.85,0:14:12.89,Default,,0,0,0,,Сіз мұны істей алар едіңіз!
Dialogue: 0,0:14:15.52,0:14:19.27,Default,,0,0,0,,Мен саған көмектессем, мені өлтіре алмайсың.
Dialogue: 0,0:14:22.44,0:14:25.11,Default,,0,0,0,,Не... дейсіз бе?
Dialogue: 0,0:14:25.19,0:14:28.53,Default,,0,0,0,,Жазалау... Ой, жоқ, жоқ.
Dialogue: 0,0:14:28.61,0:14:30.78,Default,,0,0,0,,Бұл үкім болды.
Dialogue: 0,0:14:31.57,0:14:35.04,Default,,0,0,0,,Үкім шығару үшін сізге жәбірленуші керек, солай ма?
Dialogue: 0,0:14:35.66,0:14:38.54,Default,,0,0,0,,Оны қазірдің өзінде тоқтатыңыз...
Dialogue: 0,0:14:39.21,0:14:43.13,Default,,0,0,0,,Егер жәбірленушіге... қажет болса...
Dialogue: 0,0:14:43.21,0:14:45.88,Default,,0,0,0,,А, бұл сөзсіз.
Dialogue: 0,0:14:48.38,0:14:50.80,Default,,0,0,0,,Сіз қандайсыз?!
Dialogue: 0,0:14:50.88,0:14:53.10,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:14:57.93,0:15:01.10,Default,,0,0,0,,Бұл не? Мен таң қалдым...
Dialogue: 0,0:15:01.19,0:15:05.11,Default,,0,0,0,,Мен әпкемді құтқара алдым!
Dialogue: 0,0:15:05.19,0:15:07.48,Default,,0,0,0,,Растау қажет болды
Dialogue: 0,0:15:07.57,0:15:10.65,Default,,0,0,0,,Сіз оны толығымен көрмейінше шешім қабылдай алмайсыз.
Dialogue: 0,0:15:10.74,0:15:12.66,Default,,0,0,0,,Пышақпен ұру мүмкіндігі болды.
Dialogue: 0,0:15:12.74,0:15:14.62,Default,,0,0,0,,Азап шегудің қажеті жоқ еді!
Dialogue: 0,0:15:14.70,0:15:15.62,Default,,0,0,0,,Сіз табандысыз!
Dialogue: 0,0:15:17.12,0:15:19.91,Default,,0,0,0,,Ол бәрібір сол әрекетті қайталайды.
Dialogue: 0,0:15:20.00,0:15:24.13,Default,,0,0,0,,Шындығында, бұл адам бір уақытта бірнеше адамды аңдыған.
Dialogue: 0,0:15:24.21,0:15:27.38,Default,,0,0,0,,Мен апаңа көмектессем де
Dialogue: 0,0:15:27.46,0:15:30.38,Default,,0,0,0,,Тағы бір әйел шабуыл жасады.
Dialogue: 0,0:15:32.01,0:15:34.72,Default,,0,0,0,,Әпкең тірі, солай ма?
Dialogue: 0,0:15:34.80,0:15:37.35,Default,,0,0,0,,Ал мен кек алуды аяқтадым...
Dialogue: 0,0:15:37.43,0:15:40.89,Default,,0,0,0,,Негізі мені сен өлтірдің, солай ма?
Dialogue: 0,0:15:40.98,0:15:44.15,Default,,0,0,0,,Мені одан әрі ренжітпе.
Dialogue: 0,0:15:48.61,0:15:50.40,Default,,0,0,0,,Мен оларды кешіре алмаймын…
Dialogue: 0,0:15:51.28,0:15:53.20,Default,,0,0,0,,Сіз не істегіңіз келеді?
Dialogue: 0,0:15:53.28,0:15:55.07,Default,,0,0,0,,Жетеді!
Dialogue: 0,0:15:55.16,0:15:57.41,Default,,0,0,0,,Сот әлі аяқталған жоқ
Dialogue: 0,0:16:00.04,0:16:01.54,Default,,0,0,0,,Дегенмен, егер Аномальды Титанға жолығып қалсақ, керемет болар еді…
Dialogue: 0,0:16:02.29,0:16:04.29,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:16:08.59,0:16:12.63,Default,,0,0,0,,Ха! Күте тұрыңыз, сіз не істейсіз? Тоқта!
Dialogue: 0,0:16:12.72,0:16:15.18,Default,,0,0,0,,Жалғыз сөзбен түсіну мүмкін емес
Dialogue: 0,0:16:15.26,0:16:19.56,Default,,0,0,0,,Шимада мырзаның әрекетін соңына дейін растауымыз керек.
Dialogue: 0,0:16:20.14,0:16:21.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:22.31,0:16:23.56,Default,,0,0,0,,Тексеру…
Dialogue: 0,0:16:30.94,0:16:33.11,Default,,0,0,0,,Сіз мені екі рет өлтірмекшісіз бе?
Dialogue: 0,0:16:33.20,0:16:37.87,Default,,0,0,0,,Адам бір рет өлсе, оны қайтадан өлтіруге болмайды.
Dialogue: 0,0:16:37.95,0:16:42.20,Default,,0,0,0,,Бірақ сіз адам төзгісіз азапқа ұшырай аласыз.
Dialogue: 0,0:16:42.71,0:16:44.12,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:52.92,0:16:54.13,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:16:55.05,0:16:56.26,Default,,0,0,0,,This...
Dialogue: 0,0:16:57.14,0:16:58.89,Default,,0,0,0,,Сот үкімі қайда!
Dialogue: 0,0:16:59.64,0:17:02.39,Default,,0,0,0,,Сенің істеп жүргенің сол жігіттікіндей!
Dialogue: 0,0:17:03.02,0:17:04.31,Default,,0,0,0,,Дәл солай ма?
Dialogue: 0,0:17:04.39,0:17:06.85,Default,,0,0,0,,Әр адам күнәнің ауыртпалығымен өмір сүреді.
Dialogue: 0,0:17:06.94,0:17:08.77,Default,,0,0,0,,Әр адамда өшпенділік бар.
Dialogue: 0,0:17:08.86,0:17:11.73,Default,,0,0,0,,Бұның үкімі қандай?
Dialogue: 0,0:17:11.82,0:17:13.90,Default,,0,0,0,,Неге бұлай істеп жатырсың?
Dialogue: 0,0:17:14.65,0:17:17.41,Default,,0,0,0,,Мен адамдардың ішінде жасырынған жүректің қараңғылығымын...
Dialogue: 0,0:17:17.49,0:17:19.41,Default,,0,0,0,,Менің жүрегімнің қараңғылығы қандай!
Dialogue: 0,0:17:19.49,0:17:21.49,Default,,0,0,0,,Я...
Dialogue: 0,0:17:21.58,0:17:23.95,Default,,0,0,0,,Мен ешқашан өмір сүрмесем де...
Dialogue: 0,0:17:24.04,0:17:27.75,Default,,0,0,0,,Басқа адамдардың мұңын да түсінбейсің.
Dialogue: 0,0:17:27.83,0:17:29.67,Default,,0,0,0,,Мен түсіндім деп ойлаймын
Dialogue: 0,0:17:30.75,0:17:32.67,Default,,0,0,0,,Тек қайғы емес
Dialogue: 0,0:17:33.51,0:17:35.92,Default,,0,0,0,,Адам қанша болса, сонша сезім бар.
Dialogue: 0,0:17:36.51,0:17:39.26,Default,,0,0,0,,Ашу салдарынан ақылын жоғалтқан адамдардың нәзіктігі
Dialogue: 0,0:17:39.34,0:17:43.18,Default,,0,0,0,,Махаббаттың арқасында бізде қорқынышты жеңетін күш бар
Dialogue: 0,0:17:43.68,0:17:46.89,Default,,0,0,0,,Мен ештеңе түсінбесем де
Dialogue: 0,0:17:48.27,0:17:52.15,Default,,0,0,0,,Сонда қалай үкім болуы мүмкін?
Dialogue: 0,0:17:53.73,0:17:56.95,Default,,0,0,0,,Мен... мен...
Dialogue: 0,0:17:57.03,0:17:58.86,Default,,0,0,0,,Сіз не істеп жатырсыз
Dialogue: 0,0:17:58.95,0:18:00.95,Default,,0,0,0,,Адамдардың қараңғылығын сүйреп шығару
Dialogue: 0,0:18:01.03,0:18:04.08,Default,,0,0,0,,Оған ешқандай өрнексіз қарап, ''О, түсіндім'' деді.
Dialogue: 0,0:18:04.16,0:18:06.41,Default,,0,0,0,,Ал... бұл дұрыс емес...
Dialogue: 0,0:18:06.50,0:18:09.12,Default,,0,0,0,,Кейде мен сені құшақтап алдап аламын...
Dialogue: 0,0:18:09.21,0:18:10.79,Default,,0,0,0,,Сіз мұны қабылдағыңыз келді ме?
Dialogue: 0,0:18:10.88,0:18:12.88,Default,,0,0,0,,Жалғыз кейіп көрсету емес
Dialogue: 0,0:18:15.38,0:18:18.51,Default,,0,0,0,,Бұл мүлдем дұрыс емес.
Dialogue: 0,0:18:18.59,0:18:21.72,Default,,0,0,0,,Сіздің істегеніңіз сот емес!
Dialogue: 0,0:18:27.35,0:18:30.81,Default,,0,0,0,,Адамды анықтайтын ештеңе жоқ.
Dialogue: 0,0:18:30.90,0:18:34.19,Default,,0,0,0,,Кез келген адам шексіз қатыгез болуы мүмкін.
Dialogue: 0,0:18:34.27,0:18:36.99,Default,,0,0,0,,Мен басқа жігіттерден сәл жақсымын.
Dialogue: 0,0:18:37.07,0:18:39.57,Default,,0,0,0,,Шекара дәл сіздің алдыңызда.
Dialogue: 0,0:18:40.20,0:18:43.45,Default,,0,0,0,,Әйелімді өлтірген бейбақтан кек алғаннан кейін —
Dialogue: 0,0:18:44.12,0:18:46.95,Default,,0,0,0,,Мен қайғы мен ашуды жеңдім
Dialogue: 0,0:18:47.58,0:18:50.04,Default,,0,0,0,,Мен қорқынышты түрде тынышталдым.
Dialogue: 0,0:18:51.50,0:18:54.63,Default,,0,0,0,,Мен әйелімнің ризашылық үнін естідім.
Dialogue: 0,0:18:55.30,0:18:58.26,Default,,0,0,0,,Сондықтан мен жәбірленушіден кек алғым келеді.
Dialogue: 0,0:18:58.34,0:18:59.97,Default,,0,0,0,,Өмір сүруге шешім қабылдады
Dialogue: 0,0:19:00.05,0:19:03.47,Default,,0,0,0,,Менің әйелім осы үшін құрбан болды.
Dialogue: 0,0:19:03.55,0:19:07.10,Default,,0,0,0,,Детектив болу шын мәнінде менің шақыруым болды.
Dialogue: 0,0:19:07.18,0:19:10.48,Default,,0,0,0,,Бейбақ табылғалы жатыр.
Dialogue: 0,0:19:10.56,0:19:12.35,Default,,0,0,0,,Сіз...
Dialogue: 0,0:19:12.44,0:19:15.36,Default,,0,0,0,,Сен аузыңды жап!
Dialogue: 0,0:19:15.44,0:19:17.36,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:19:17.94,0:19:19.36,Default,,0,0,0,,Жасаңыз
Dialogue: 0,0:19:20.70,0:19:24.91,Default,,0,0,0,,Бір нәрсеге қол жеткізу үшін әрқашан құрбандық қажет.
Dialogue: 0,0:19:24.99,0:19:27.62,Default,,0,0,0,,Мен сені өз қолыммен үйретемін.
Dialogue: 0,0:19:27.70,0:19:29.62,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,0:19:29.71,0:19:32.37,Default,,0,0,0,,Сабыр ет! Бұл үкім!
Dialogue: 0,0:19:32.46,0:19:34.25,Default,,0,0,0,,Жұмақ пен тозақ өтірік!
Dialogue: 0,0:19:34.33,0:19:37.75,Default,,0,0,0,,Бұл шынымен нигилизм немесе реинкарнация ма?
Dialogue: 0,0:19:37.84,0:19:42.43,Default,,0,0,0,,Егер мен реинкарнацияланатын болсам, әпкеммен басқа формада қайта кездесуім мүмкін.
Dialogue: 0,0:19:43.09,0:19:47.51,Default,,0,0,0,,Бұл адам сіздің әрекеттеріңізге қарап, сізді соттағысы келеді!
Dialogue: 0,0:19:47.60,0:19:50.52,Default,,0,0,0,,Бұл да шешімнің бір бөлігі ме?
Dialogue: 0,0:19:50.60,0:19:53.02,Default,,0,0,0,,Ашуыңызды басуыңызды өтінемін!
Dialogue: 0,0:19:53.10,0:19:55.44,Default,,0,0,0,,Әпкеңнің қасында қалуың керек емес пе?
Dialogue: 0,0:19:58.11,0:20:01.61,Default,,0,0,0,,Ештеңеге түссең, мүмкіндіктерің жойылады!
Dialogue: 0,0:20:16.63,0:20:20.05,Default,,0,0,0,,Танжиро~!
Dialogue: 0,0:20:27.39,0:20:29.56,Default,,0,0,0,,Балалар сендер сондай тәтті екенсіңдер.
Dialogue: 0,0:20:29.64,0:20:32.06,Default,,0,0,0,,Өзіңізді қорғай алмасаңыз
Dialogue: 0,0:20:32.14,0:20:34.39,Default,,0,0,0,,Басқа адамды өлтіруден басқа амалың жоқ.
Dialogue: 0,0:20:36.77,0:20:40.07,Default,,0,0,0,,Дүниенің жауыз болуы заңдылық.
Dialogue: 0,0:20:40.15,0:20:42.28,Default,,0,0,0,,Егер сіз әлемді өзгерте алмасаңыз...
Dialogue: 0,0:20:42.36,0:20:46.07,Default,,0,0,0,,Сіз өзгеруіңіз керек!
Dialogue: 0,0:20:48.03,0:20:53.04,Default,,0,0,0,,♪~
Dialogue: 0,0:21:50.60,0:21:55.14,Default,,0,0,0,,~♪
Dialogue: 0,0:21:59.40,0:22:00.61,Default,,0,0,0,,Sae…
Dialogue: 0,0:22:01.86,0:22:03.23,Default,,0,0,0,,Бұл алаңдатады.
Dialogue: 0,0:22:06.32,0:22:09.24,Default,,0,0,0,,Қорғау... хехехе...
Dialogue: 0,0:22:11.74,0:22:14.54,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:22:16.12,0:22:19.12,Default,,0,0,0,,Адамдар... сіз ойлағандай.
Dialogue: 0,0:22:19.21,0:22:21.04,Default,,0,0,0,,Бұл күрделі емес
Dialogue: 0,0:22:21.88,0:22:23.50,Default,,0,0,0,,Қарапайымырақ
Dialogue: 0,0:22:23.59,0:22:27.55,Default,,0,0,0,,Мен қарапайым нәрселерге қайғырамын немесе ашуланамын.
Dialogue: 0,0:22:28.18,0:22:29.84,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:22:30.55,0:22:32.97,Default,,0,0,0,,Ұсақ нәрселерден бірден әсер етеді
Dialogue: 0,0:22:33.06,0:22:35.60,Default,,0,0,0,,Оқиғаның қалай болатынын білмей өмір сүру
Dialogue: 0,0:22:38.35,0:22:39.56,Default,,0,0,0,,Міне, адамдар!
Dialogue: 0,0:22:41.06,0:22:47.06,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory