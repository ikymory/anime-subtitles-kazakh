Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.00,0:00:07.96,Default,,0,0,0,,Бұл...
Dialogue: 0,0:00:15.68,0:00:17.68,Default,,0,0,0,,Рух болуы керек
Dialogue: 0,0:00:17.80,0:00:19.06,Default,,0,0,0,,Гадиэль Ах!
Dialogue: 0,0:00:21.98,0:00:23.14,Default,,0,0,0,,Мәртебелі
Dialogue: 0,0:00:24.31,0:00:26.77,Default,,0,0,0,,Жақында Ровел ВанКруфт
Dialogue: 0,0:00:26.90,0:00:30.07,Default,,0,0,0,,Қызымен бірге сарайға келеді.
Dialogue: 0,0:00:30.19,0:00:33.45,Default,,0,0,0,,Мен де кездесуге рұқсат етемін.
Dialogue: 0,0:00:33.57,0:00:34.95,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:36.20,0:00:39.16,Default,,0,0,0,,♪～
Dialogue: 0,0:01:59.07,0:02:02.03,Default,,0,0,0,,～♪
Dialogue: 0,0:02:08.33,0:02:10.08,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:02:10.21,0:02:14.05,Default,,0,0,0,,Бұл өте сүйкімді, Ерен-чан, мен ойлағаннан да артық!
Dialogue: 0,0:02:14.76,0:02:15.80,Default,,0,0,0,,Ловелл де.
Dialogue: 0,0:02:15.92,0:02:18.30,Default,,0,0,0,,Өтінемін, бұлай айтпаңыз.
Dialogue: 0,0:02:18.43,0:02:20.14,Default,,0,0,0,,Түннің осы уақытында қайда барасың?
Dialogue: 0,0:02:20.59,0:02:22.51,Default,,0,0,0,,Арба дайын
Dialogue: 0,0:02:22.64,0:02:24.10,Default,,0,0,0,,Лорен, кешіріңіз.
Dialogue: 0,0:02:24.56,0:02:27.31,Default,,0,0,0,,Бұл жолы мен телепортация сиқырын қолданамын.
Dialogue: 0,0:02:27.43,0:02:29.64,Default,,0,0,0,,Ах... Сау болыңыз.
Dialogue: 0,0:02:30.90,0:02:33.94,Default,,0,0,0,,Тусама, мен қашып кетуді ойлаған кезде
Dialogue: 0,0:02:34.07,0:02:37.40,Default,,0,0,0,,Сіздің ойыңызша, жаттықтырушы болғаны көп қиындық тудырады ма?
Dialogue: 0,0:02:37.53,0:02:39.11,Default,,0,0,0,,Өткір екен, Ерен.
Dialogue: 0,0:02:39.24,0:02:41.45,Default,,0,0,0,,Сәттілік! Эллен!
Dialogue: 0,0:02:41.57,0:02:43.58,Default,,0,0,0,,Зұлым рухтарға берілме!
Dialogue: 0,0:02:43.70,0:02:44.95,Default,,0,0,0,,Сәттілік, ағайын!
Dialogue: 0,0:02:45.20,0:02:47.91,Default,,0,0,0,,Мен төбелеспеймін.
Dialogue: 0,0:02:50.46,0:02:53.84,Default,,0,0,0,,Еренді дұрыстап қорғаңыз.
Dialogue: 0,0:02:54.38,0:02:56.05,Default,,0,0,0,,Олай болса кеттік!
Dialogue: 0,0:02:56.21,0:02:58.38,Default,,0,0,0,,Ұрыс, Ерен-чан!
Dialogue: 0,0:02:58.51,0:02:59.47,Default,,0,0,0,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:03:12.06,0:03:14.06,Default,,0,0,0,,А, жоқ, жоқ, жоқ, жоқ...
Dialogue: 0,0:03:14.52,0:03:17.48,Default,,0,0,0,,Тосама! Қайғыланудың қажеті жоқ!
Dialogue: 0,0:03:17.61,0:03:19.57,Default,,0,0,0,,Қатамызды дұрыстап алайық!
Dialogue: 0,0:03:20.20,0:03:23.28,Default,,0,0,0,,Эллен, сен неге сонша ынталысың?
Dialogue: 0,0:03:23.41,0:03:27.83,Default,,0,0,0,,Шынымды айтсам, мен Харагуро мырзамен тікелей сөйлескім келді!
Dialogue: 0,0:03:27.95,0:03:29.25,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:03:29.54,0:03:31.75,Default,,0,0,0,,Жүр, кеттік, Тосама!
Dialogue: 0,0:03:31.87,0:03:34.96,Default,,0,0,0,,Мен оның не екенін білмеймін, менде бір қорқынышты сезім бар...
Dialogue: 0,0:03:36.71,0:03:37.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:38.05,0:03:40.63,Default,,0,0,0,,Бұл Ловелл мырза! (Қақпашы) Қақпаны ашыңыз!
Dialogue: 0,0:03:40.88,0:03:44.76,Default,,0,0,0,,Иә? Ловелл-сама бар қыз кім?
Dialogue: 0,0:03:44.89,0:03:46.56,Default,,0,0,0,,Басқаша айтқанда… бұл…➡
Dialogue: 0,0:03:48.97,0:03:51.06,Default,,0,0,0,,Мистер Ловелл келді.
Dialogue: 0,0:03:51.18,0:03:52.23,Default,,0,0,0,,Түннің осы уақытында қайда барасың?
Dialogue: 0,0:03:57.48,0:03:59.99,Default,,0,0,0,,Аа, мен сені күттім, Ловелл.
Dialogue: 0,0:04:00.15,0:04:03.95,Default,,0,0,0,,Ал кішкентай ханшайым
Dialogue: 0,0:04:13.29,0:04:17.29,Default,,0,0,0,,Танысқаныма қуаныштымын, Мәртебелі. Менің атым Эллен, Ловеллдің қызы.
Dialogue: 0,0:04:17.88,0:04:21.01,Default,,0,0,0,,Эллен, мен сенімен танысқым келді.
Dialogue: 0,0:04:21.72,0:04:22.97,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:04:24.63,0:04:25.80,Default,,0,0,0,,Бұл болар ма…
Dialogue: 0,0:04:25.93,0:04:28.64,Default,,0,0,0,,Бұл мағынада ол шынымен де Ловеллдің қызы.
Dialogue: 0,0:04:28.76,0:04:30.56,Default,,0,0,0,,Мен ұлы мәртебелі мырзадан қорқамын
Dialogue: 0,0:04:30.68,0:04:32.18,Default,,0,0,0,,Бұл күтпеген жағдай.
Dialogue: 0,0:04:32.31,0:04:33.77,Default,,0,0,0,,Қорқынышты! Бұл қорқынышты, Ерен!
Dialogue: 0,0:04:33.89,0:04:37.48,Default,,0,0,0,,Соңғы уақытта Ерен немен айналысты? Сіздің бүлікшіл кезеңіңіз ауыр емес пе?
Dialogue: 0,0:04:37.73,0:04:40.69,Default,,0,0,0,,Уф, Ту-сама жыламақшы. Ту-саманың шынайы болмысы ашылады.
Dialogue: 0,0:04:40.86,0:04:41.69,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:42.28,0:04:46.36,Default,,0,0,0,,Кукукуку Ал, отырыңыз.
Dialogue: 0,0:04:49.37,0:04:52.04,Default,,0,0,0,,Сіз шынымен соншалықты жарқын болдыңыз ба?
Dialogue: 0,0:04:53.04,0:04:56.12,Default,,0,0,0,,Кішкентай кезімнен соған шыдауға мәжбүр болдым.
Dialogue: 0,0:04:56.54,0:04:59.96,Default,,0,0,0,,Агиэльмен араласқаным үшін кешірім сұраймын.
Dialogue: 0,0:05:00.09,0:05:02.80,Default,,0,0,0,,Бірақ бұл әкемнің шешімі еді.
Dialogue: 0,0:05:02.92,0:05:06.09,Default,,0,0,0,,Енді екеуі де жоқ.
Dialogue: 0,0:05:06.22,0:05:07.05,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:05:07.47,0:05:08.51,Default,,0,0,0,,Иә
Dialogue: 0,0:05:09.05,0:05:11.18,Default,,0,0,0,,<Мәселені тудырған Агиэльмен>
Dialogue: 0,0:05:11.31,0:05:14.56,Default,,0,0,0,,<Әкем бұл мәселені өз мойнына алып, тақтан бас тартты>
Dialogue: 0,0:05:14.68,0:05:17.23,Default,,0,0,0,,<Ол даланың ортасындағы зәулім үйге көшті>
Dialogue: 0,0:05:17.35,0:05:20.23,Default,,0,0,0,,<Мен бұл жерге енді қайтып оралмаймын>
Dialogue: 0,0:05:20.36,0:05:21.90,Default,,0,0,0,,Кукукуку…
Dialogue: 0,0:05:22.57,0:05:27.41,Default,,0,0,0,,<Ол әпкесінің қиянатын пайдаланып әкесін тақтан түсірді...>
Dialogue: 0,0:05:28.07,0:05:30.87,Default,,0,0,0,,＜Күтілгендей, бұл адам қара жүрек адам＞
Dialogue: 0,0:05:30.99,0:05:33.91,Default,,0,0,0,,Бірақ Саувел де апат.
Dialogue: 0,0:05:34.04,0:05:37.50,Default,,0,0,0,,Мен оның екінші жұбайы Ағиэль сияқты әйел екенін білмедім.
Dialogue: 0,0:05:37.62,0:05:38.83,Default,,0,0,0,,Бірдей?
Dialogue: 0,0:05:39.21,0:05:41.88,Default,,0,0,0,,Сіз байқамаған боларсыз, солай ма?
Dialogue: 0,0:05:42.00,0:05:44.80,Default,,0,0,0,,Бұл қазірдің өзінде ақсүйектер арасында өсек-аяңға айналды.
Dialogue: 0,0:05:44.92,0:05:46.59,Default,,0,0,0,,Цк... Тосама...
Dialogue: 0,0:05:48.76,0:05:50.47,Default,,0,0,0,,Неліктен мұндай қауесеттер?
Dialogue: 0,0:05:51.10,0:05:53.97,Default,,0,0,0,,Бұл кішкентай ханшайым тыңдайтын әңгіме емес.
Dialogue: 0,0:05:54.10,0:05:55.43,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:05:57.02,0:06:01.98,Default,,0,0,0,,Мәртебелі мырза мен түсінетіндей сенімді сөйлеп тұр.
Dialogue: 0,0:06:03.02,0:06:06.70,Default,,0,0,0,,А, мен Альбертоны жаңа ғана сендірдім.
Dialogue: 0,0:06:07.20,0:06:08.15,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:08.36,0:06:10.66,Default,,0,0,0,,Мәртебелі тентек адам.
Dialogue: 0,0:06:10.78,0:06:12.24,Default,,0,0,0,,Альберто ағай
Dialogue: 0,0:06:12.37,0:06:15.62,Default,,0,0,0,,Ванкрефттер отбасының қиын жағдайына шын жүректен шағымданса да.
Dialogue: 0,0:06:15.75,0:06:18.83,Default,,0,0,0,,Сол әлсіздікті пайдаланып па?
Dialogue: 0,0:06:20.71,0:06:25.26,Default,,0,0,0,,Шынымды айтсам, сізден қос агент болуды өтінген болар едім.
Dialogue: 0,0:06:25.38,0:06:26.76,Default,,0,0,0,,Мен мұны тоқтаттым.
Dialogue: 0,0:06:26.97,0:06:28.34,Default,,0,0,0,,А...
Dialogue: 0,0:06:28.47,0:06:32.22,Default,,0,0,0,,Мәртебелі Альберто ағай туралы не ойлайтынын білмеймін.
Dialogue: 0,0:06:32.60,0:06:37.18,Default,,0,0,0,,Мен қарияны шпион болуға жарамайды деп ойладым, сондықтан хехехе.
Dialogue: 0,0:06:37.31,0:06:40.02,Default,,0,0,0,,Хехе, мен күткеннен де көп!
Dialogue: 0,0:06:40.15,0:06:44.40,Default,,0,0,0,,Ловелл, сен ғажапсың, сен осындай бала өсірдің!
Dialogue: 0,0:06:44.52,0:06:46.07,Default,,0,0,0,,Хаха
Dialogue: 0,0:06:46.19,0:06:48.90,Default,,0,0,0,,Сонда сіз оны білесіз бе?
Dialogue: 0,0:06:49.03,0:06:52.66,Default,,0,0,0,,Саувелдің қайта некеге тұрған серіктесі туралы қауесеттердің көзі
Dialogue: 0,0:06:52.78,0:06:54.20,Default,,0,0,0,,Сіз тырысып жатырсыз ба?
Dialogue: 0,0:06:56.41,0:07:00.21,Default,,0,0,0,,Мәртебелі қауесетті Тосамамен келіссөздер кезінде пайдаланып жатыр.
Dialogue: 0,0:07:00.33,0:07:05.42,Default,,0,0,0,,Алайда қауесеттер қазірдің өзінде таралып жатыр...
Dialogue: 0,0:07:05.55,0:07:08.92,Default,,0,0,0,,Ұлы мәртебелі тілдің тайға таңба басқандай болуы мүмкін емес.
Dialogue: 0,0:07:09.05,0:07:10.72,Default,,0,0,0,,Сонда кім?
Dialogue: 0,0:07:11.72,0:07:12.97,Default,,0,0,0,,Бұл патшайым.
Dialogue: 0,0:07:13.51,0:07:15.18,Default,,0,0,0,,Неліктен олай ойлайсың?
Dialogue: 0,0:07:15.81,0:07:20.89,Default,,0,0,0,,Әйел адам Ария апайдың әкесіне қалай қарағанын байқаған болар деп ойлаймын.
Dialogue: 0,0:07:21.02,0:07:24.69,Default,,0,0,0,,Сондай-ақ, кейінгі үйлену тойы орта жолда тоқтатылды.
Dialogue: 0,0:07:24.81,0:07:27.28,Default,,0,0,0,,Ол бірдеңе болғанын сезсе керек.
Dialogue: 0,0:07:27.94,0:07:28.94,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:07:29.07,0:07:32.36,Default,,0,0,0,,Дегенмен, герцогтық отбасы болып табылатын Ванкрефттер отбасы туралы қауесеттер бар.
Dialogue: 0,0:07:32.49,0:07:34.20,Default,,0,0,0,,Мен оны Ойзормен ойнай алмаймын.
Dialogue: 0,0:07:34.32,0:07:39.54,Default,,0,0,0,,Олай болса, өсек иесі тең немесе жоғары дәрежедегі асыл...
Dialogue: 0,0:07:39.66,0:07:43.54,Default,,0,0,0,,Сондықтан мен бұл патшайым деп ойладым.
Dialogue: 0,0:07:45.38,0:07:47.00,Default,,0,0,0,,Керемет...
Dialogue: 0,0:07:48.55,0:07:52.63,Default,,0,0,0,,Мен бір сөзді жіберіп алған жоқпын, солай ма? Ал айыптау туралы ...
Dialogue: 0,0:07:52.76,0:07:53.72,Default,,0,0,0,,Соттау?
Dialogue: 0,0:07:54.84,0:07:56.55,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:07:56.68,0:07:57.43,Default,,0,0,0,,Енді?
Dialogue: 0,0:07:58.14,0:08:02.31,Default,,0,0,0,,«Апайдың еркектерге талғамы нашар» деген өсек шығар деп ойладым.
Dialogue: 0,0:08:02.44,0:08:03.90,Default,,0,0,0,,Соттау дегеніміз не?
Dialogue: 0,0:08:04.02,0:08:06.02,Default,,0,0,0,,Вааль құдайының сотталуы
Dialogue: 0,0:08:06.44,0:08:08.36,Default,,0,0,0,,Саувелдің әйелінің білегінде
Dialogue: 0,0:08:08.48,0:08:10.61,Default,,0,0,0,,Бетіңізде тікенді көгерген жерлер қалқып тұр ма?
Dialogue: 0,0:08:11.44,0:08:13.36,Default,,0,0,0,,<Агиэль сияқты>
Dialogue: 0,0:08:14.24,0:08:17.24,Default,,0,0,0,,Жасырсаң, кейін бәлеге қаласың.
Dialogue: 0,0:08:19.41,0:08:22.00,Default,,0,0,0,,Тікеннің көгергенін көрмедім.
Dialogue: 0,0:08:22.12,0:08:26.67,Default,,0,0,0,,Қымбатты Ту, бізді патша әулеті жек көреді емес пе?
Dialogue: 0,0:08:26.84,0:08:27.75,Default,,0,0,0,,Тіпті егер
Dialogue: 0,0:08:27.88,0:08:31.09,Default,,0,0,0,,Мен мұндай негізсіз қауесеттердің таралып жатқанына сене алар емеспін.
Dialogue: 0,0:08:31.21,0:08:32.63,Default,,0,0,0,,Мен білмедім
Dialogue: 0,0:08:32.80,0:08:34.47,Default,,0,0,0,,Бұл рас, Ерен.
Dialogue: 0,0:08:34.59,0:08:36.05,Default,,0,0,0,,Бұл жағымсыз...
Dialogue: 0,0:08:36.18,0:08:37.35,Default,,0,0,0,,Енді үйге қайтайық?
Dialogue: 0,0:08:37.47,0:08:39.56,Default,,0,0,0,,Иә, мырза.
Dialogue: 0,0:08:40.89,0:08:42.60,Default,,0,0,0,,Әңгіме әлі біткен жоқ.
Dialogue: 0,0:08:44.39,0:08:47.48,Default,,0,0,0,,Мен болжамға сүйеніп айтқан сияқтымын.
Dialogue: 0,0:08:47.61,0:08:49.77,Default,,0,0,0,,Бұл үшін кешірім сұраймын.
Dialogue: 0,0:08:50.57,0:08:53.45,Default,,0,0,0,,Әйеліңізге бұл қателік екенін айтыңыз
Dialogue: 0,0:08:53.57,0:08:55.49,Default,,0,0,0,,Мұны істеу дұрыс па?
Dialogue: 0,0:08:55.99,0:08:56.95,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:08:57.07,0:09:02.41,Default,,0,0,0,,Егер өсек таратқан адам бұрынғы сөзінен бас тартса, король әулеті...
Dialogue: 0,0:09:02.95,0:09:06.25,Default,,0,0,0,,Күрсін... Осыншама жетеді деп ойламадым.
Dialogue: 0,0:09:06.37,0:09:07.88,Default,,0,0,0,,Хехе...
Dialogue: 0,0:09:08.00,0:09:11.09,Default,,0,0,0,,Бірақ оны сол күйінде қалдыру дұрыс па?
Dialogue: 0,0:09:11.38,0:09:13.92,Default,,0,0,0,,Мәртебелі әу баста осылай ойлаған жоқ па?
Dialogue: 0,0:09:14.05,0:09:16.18,Default,,0,0,0,,Өйткені өсек тарағанға дейін
Dialogue: 0,0:09:16.30,0:09:18.68,Default,,0,0,0,,Мені осында әкелуге уәде бер
Dialogue: 0,0:09:18.80,0:09:22.14,Default,,0,0,0,,Мен оны Тосамамен орнатып қойғанмын.
Dialogue: 0,0:09:22.27,0:09:23.39,Default,,0,0,0,,Сәлем Эллен
Dialogue: 0,0:09:23.52,0:09:24.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:24.85,0:09:26.94,Default,,0,0,0,,Менің қызым болғың келе ме?
Dialogue: 0,0:09:27.06,0:09:27.81,Default,,0,0,0,,Мәртебелі!
Dialogue: 0,0:09:27.94,0:09:31.15,Default,,0,0,0,,Мен сізге отбасыңызға араласуды шектеңіз деп айтқаныма сенемін!
Dialogue: 0,0:09:31.27,0:09:32.98,Default,,0,0,0,,Қалай болды?
Dialogue: 0,0:09:33.78,0:09:35.53,Default,,0,0,0,,Мен бас тартамын.
Dialogue: 0,0:09:35.65,0:09:38.49,Default,,0,0,0,,Менің То-сама тек То-сама.
Dialogue: 0,0:09:38.62,0:09:41.33,Default,,0,0,0,,Элейн! Ммм, бұл жақсы бала.
Dialogue: 0,0:09:41.45,0:09:42.20,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:42.33,0:09:46.62,Default,,0,0,0,,Бұл батырдың шынайы түрі...
Dialogue: 0,0:09:47.17,0:09:50.38,Default,,0,0,0,,Негізі мен бүгін ұлдарымды таныстырғым келеді.
Dialogue: 0,0:09:50.50,0:09:52.80,Default,,0,0,0,,Смақ!
Dialogue: 0,0:09:52.92,0:09:54.42,Default,,0,0,0,,Ұлдарыңызды осында алыңыз!
Dialogue: 0,0:09:54.55,0:09:55.38,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:55.51,0:09:58.26,Default,,0,0,0,,Эллен, саған да ұнайды деп ойлаймын.
Dialogue: 0,0:09:59.09,0:10:02.56,Default,,0,0,0,,Екеуі де басқа отбасының ханымдарына өте танымал.
Dialogue: 0,0:10:02.68,0:10:05.73,Default,,0,0,0,,Ақша мен билік қуған адамдарсың ба?
Dialogue: 0,0:10:05.85,0:10:08.73,Default,,0,0,0,,Хаха, меніңше ата-анасы солай.
Dialogue: 0,0:10:08.85,0:10:12.69,Default,,0,0,0,,Бірақ олар ұлдарын шын жақсы көреді.
Dialogue: 0,0:10:12.82,0:10:14.61,Default,,0,0,0,,Бұл өте танымал емес пе?
Dialogue: 0,0:10:14.73,0:10:17.40,Default,,0,0,0,,Онда мен саған керек емеспін.
Dialogue: 0,0:10:17.61,0:10:20.99,Default,,0,0,0,,Менің ойымша, бұл да жақсы көрінеді.
Dialogue: 0,0:10:21.12,0:10:26.33,Default,,0,0,0,,Сырт келбеті жақсы т.б. Себебі мен Тоусама мен Каасаманы көріп үйреніп қалдым.
Dialogue: 0,0:10:26.45,0:10:28.46,Default,,0,0,0,,Енді үйге қайтайық, мырза.
Dialogue: 0,0:10:28.62,0:10:29.96,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:10:30.08,0:10:31.08,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:31.21,0:10:34.42,Default,,0,0,0,,Ловелл, сенің қызың қандай?
Dialogue: 0,0:10:34.80,0:10:38.13,Default,,0,0,0,,Мәртебелі менің қызымды жеңе алмайды.
Dialogue: 0,0:10:38.80,0:10:41.34,Default,,0,0,0,,Тіпті мен, ата-ана, жеңе алмаймын.
Dialogue: 0,0:10:42.14,0:10:44.26,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:44.39,0:10:45.56,Default,,0,0,0,,Қою
Dialogue: 0,0:10:45.68,0:10:48.39,Default,,0,0,0,,Әке, кешіріңізші.
Dialogue: 0,0:10:48.52,0:10:49.56,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:49.69,0:10:51.77,Default,,0,0,0,,О, келдің бе?
Dialogue: 0,0:10:51.90,0:10:53.02,Default,,0,0,0,,Танысайық
Dialogue: 0,0:10:53.57,0:10:55.73,Default,,0,0,0,,Үлкені Ғадиел, 12 жаста.
Dialogue: 0,0:10:55.98,0:10:58.44,Default,,0,0,0,,Ең кішісі – Расул, 9 жаста.
Dialogue: 0,0:11:00.91,0:11:03.66,Default,,0,0,0,,Батыр Ловелл және оның қызы Ерен.
Dialogue: 0,0:11:03.78,0:11:04.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:08.50,0:11:10.12,Default,,0,0,0,,А...
Dialogue: 0,0:11:10.96,0:11:12.71,Default,,0,0,0,,Бұл Ловелл ВанКруфт.
Dialogue: 0,0:11:13.33,0:11:14.88,Default,,0,0,0,,Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:11:15.00,0:11:17.88,Default,,0,0,0,,Сіз шынымен де батырсыз ба?
Dialogue: 0,0:11:18.01,0:11:19.92,Default,,0,0,0,,Эй, Расул, бұл дөрекі, солай ма?
Dialogue: 0,0:11:20.05,0:11:21.93,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:11:22.05,0:11:22.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:32.85,0:11:34.36,Default,,0,0,0,,Сіз ұялшақсыз ба?
Dialogue: 0,0:11:34.73,0:11:36.11,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:38.69,0:11:39.82,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:11:40.49,0:11:42.20,Default,,0,0,0,,Өзіңізді ауырып тұрсыз ба?
Dialogue: 0,0:11:45.37,0:11:47.29,Default,,0,0,0,,Алыс болыңыз!
Dialogue: 0,0:11:51.08,0:11:52.92,Default,,0,0,0,,Ах... (Расуэль/Рависуэль) Иә?
Dialogue: 0,0:11:53.08,0:11:55.13,Default,,0,0,0,,(қорыққан дауыс)
Dialogue: 0,0:11:56.46,0:11:57.96,Default,,0,0,0,,Жақсы екеніңізге сенімдісіз бе?
Dialogue: 0,0:11:59.01,0:12:02.63,Default,,0,0,0,,Өзіңізді жақсы сезінбесеңіз, демалуға рұқсат етіңіз...
Dialogue: 0,0:12:02.76,0:12:04.22,Default,,0,0,0,,Әй!
Dialogue: 0,0:12:05.22,0:12:06.89,Default,,0,0,0,,Артқа шегін!
Dialogue: 0,0:12:07.01,0:12:11.06,Default,,0,0,0,,(Рухтардың айқайы)
Dialogue: 0,0:12:13.31,0:12:14.73,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:15.23,0:12:17.36,Default,,0,0,0,,Рух?
Dialogue: 0,0:12:18.40,0:12:20.32,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:20.82,0:12:23.20,Default,,0,0,0,,Сондықтан мен сені кездестіргеніңді қаламадым!
Dialogue: 0,0:12:23.49,0:12:24.99,Default,,0,0,0,,Не айтып тұрсың!?
Dialogue: 0,0:12:25.11,0:12:26.37,Default,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,0:12:26.49,0:12:28.03,Default,,0,0,0,,'Жоқ—ол қайта қосылып жатыр ма? Бөлініп кеткен бөліктері…'
Dialogue: 0,0:12:28.16,0:12:29.66,Default,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,0:12:31.45,0:12:33.54,Default,,0,0,0,,Ха, мүмкін...
Dialogue: 0,0:12:33.96,0:12:36.00,Default,,0,0,0,,Жолдан кет! Жолдан кет!
Dialogue: 0,0:12:36.13,0:12:38.17,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:12:38.29,0:12:41.17,Default,,0,0,0,,Анықтама...
Dialogue: 0,0:12:41.30,0:12:43.38,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:12:43.51,0:12:45.22,Default,,0,0,0,,(Рухтардың айқайы)
Dialogue: 0,0:12:45.34,0:12:47.35,Default,,0,0,0,,Уф!
Dialogue: 0,0:12:47.47,0:12:49.81,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:49.93,0:12:50.81,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:50.93,0:12:53.23,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:12:54.94,0:12:55.85,Default,,0,0,0,,Ухммм… ммм…
Dialogue: 0,0:12:55.98,0:12:56.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:56.98,0:12:58.31,Default,,0,0,0,,Уф!
Dialogue: 0,0:12:59.40,0:13:00.69,Default,,0,0,0,,Бұл...
Dialogue: 0,0:13:00.82,0:13:02.53,Default,,0,0,0,,<Рух Патша! ＞
Dialogue: 0,0:13:03.11,0:13:07.87,Default,,0,0,0,,Маған осы құбыжықты жеңу үшін күш беріңіз, Темпест!
Dialogue: 0,0:13:10.37,0:13:13.12,Default,,0,0,0,,Мен оны неге аша алмаймын...
Dialogue: 0,0:13:13.29,0:13:18.00,Default,,0,0,0,,Бұл жағдайда рухтарды шақыру үшін сиқыршыны алаяқ ретінде пайдаланыңыз!
Dialogue: 0,0:13:18.17,0:13:19.71,Default,,0,0,0,,Тоқта! (Рух шебері) Неге!
Dialogue: 0,0:13:19.84,0:13:22.30,Default,,0,0,0,,Басқа оқиға! (Рух шебері) Босатыңыз! Гррр...
Dialogue: 0,0:13:22.42,0:13:24.72,Default,,0,0,0,,Не істеу керек! (Рух) Мен көмектесуім керек!
Dialogue: 0,0:13:25.13,0:13:28.93,Default,,0,0,0,,Жақсы! Рухтарды құрбан ет!
Dialogue: 0,0:13:29.05,0:13:31.85,Default,,0,0,0,,(Аруақтардың ыңырануы)
Dialogue: 0,0:13:33.64,0:13:34.85,Default,,0,0,0,,Неге...
Dialogue: 0,0:13:34.98,0:13:36.56,Default,,0,0,0,,Ауырды...
Dialogue: 0,0:13:36.73,0:13:39.02,Default,,0,0,0,,Бұл ауырады…
Dialogue: 0,0:13:39.19,0:13:41.02,Default,,0,0,0,,Маған көмектесіңіз...
Dialogue: 0,0:13:41.15,0:13:42.53,Default,,0,0,0,,Неге...
Dialogue: 0,0:13:43.32,0:13:45.70,Default,,0,0,0,,Тоқта... Тоқта!
Dialogue: 0,0:13:45.86,0:13:47.03,Default,,0,0,0,,Эллен!
Dialogue: 0,0:13:47.57,0:13:49.49,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:49.66,0:13:51.87,Default,,0,0,0,,Гррр…
Dialogue: 0,0:13:55.41,0:13:57.12,Default,,0,0,0,,Қақпаны ашыңыз
Dialogue: 0,0:13:58.04,0:13:59.67,Default,,0,0,0,,Қақпаны ашыңыз!
Dialogue: 0,0:13:59.79,0:14:04.96,Default,,0,0,0,,Рух патшасы! Бізге тезірек күш-қуатыңызды беріңізші!
Dialogue: 0,0:14:05.09,0:14:06.72,Default,,0,0,0,,Неге...
Dialogue: 0,0:14:07.26,0:14:10.05,Default,,0,0,0,,Өкінішке орай, Амон мен Акира Кокреяда…
Dialogue: 0,0:14:10.26,0:14:13.56,Default,,0,0,0,,Ха... а...
Dialogue: 0,0:14:13.68,0:14:16.52,Default,,0,0,0,,(Рухтардың айқайы)
Dialogue: 0,0:14:16.64,0:14:18.98,Default,,0,0,0,,Ауырды...
Dialogue: 0,0:14:19.10,0:14:21.19,Default,,0,0,0,,Маған көмектесіңіз...
Dialogue: 0,0:14:21.36,0:14:23.65,Default,,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,0:14:23.78,0:14:24.78,Default,,0,0,0,,Мен...
Dialogue: 0,0:14:24.90,0:14:26.36,Default,,0,0,0,,Жоқ!!
Dialogue: 0,0:14:26.49,0:14:28.07,Default,,0,0,0,,Қызыма...
Dialogue: 0,0:14:28.20,0:14:29.82,Default,,0,0,0,,Ұстамаңыз!
Dialogue: 0,0:14:30.70,0:14:33.33,Default,,0,0,0,,Сәлем... (Рух) Маған көмектес
Dialogue: 0,0:14:33.45,0:14:35.45,Default,,0,0,0,,Өтінемін...
Dialogue: 0,0:14:35.58,0:14:41.38,Default,,0,0,0,,(Рухтардың айқайы)
Dialogue: 0,0:14:42.42,0:14:44.09,Default,,0,0,0,,Lovell…
Dialogue: 0,0:14:45.05,0:14:48.55,Default,,0,0,0,,Осы қарқынмен біз де есімізді жоғалтуымыз мүмкін.
Dialogue: 0,0:14:48.72,0:14:51.43,Default,,0,0,0,,Ловелл Бұл не нәрсе...
Dialogue: 0,0:14:51.59,0:14:53.51,Default,,0,0,0,,Сіз әлі түсінбейсіз!
Dialogue: 0,0:14:53.64,0:14:56.97,Default,,0,0,0,,Сен патша әулетіне түскен рухтың қарғысысың!
Dialogue: 0,0:14:59.77,0:15:02.40,Default,,0,0,0,,Жарайды, жарайды...
Dialogue: 0,0:15:02.52,0:15:04.82,Default,,0,0,0,,Жүр, тез үйге қайтайық (Ереннің ауыр тынысы)
Dialogue: 0,0:15:09.20,0:15:10.91,Default,,0,0,0,,Қарғыс…
Dialogue: 0,0:15:11.07,0:15:13.70,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:15:17.75,0:15:20.67,Default,,0,0,0,,♬~
Dialogue: 0,0:15:20.83,0:15:21.96,Default,,0,0,0,,Дұрыс айтпадым ба, Крюгер мырза?
Dialogue: 0,0:15:22.08,0:15:23.00,Default,,0,0,0,,Эллен! (есіктің ашылған дыбысы)
Dialogue: 0,0:15:23.38,0:15:24.84,Default,,0,0,0,,Эллен-чан
Dialogue: 0,0:15:25.96,0:15:27.38,Default,,0,0,0,,Охри!
Dialogue: 0,0:15:30.59,0:15:33.39,Default,,0,0,0,,Жарайды, қазір жақсы.
Dialogue: 0,0:15:33.51,0:15:37.14,Default,,0,0,0,,Ерен, ұйықтайық.
Dialogue: 0,0:15:39.23,0:15:42.06,Default,,0,0,0,,Жарайды ма? Ерен бұл...
Dialogue: 0,0:15:43.35,0:15:46.82,Default,,0,0,0,,Менің қызуым көтерілді, бірақ алаңдайтын ештеңе жоқ.
Dialogue: 0,0:15:46.98,0:15:48.73,Default,,0,0,0,,(Ловеллдің жеңілдеген дауысы)
Dialogue: 0,0:15:49.19,0:15:50.74,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:50.86,0:15:53.95,Default,,0,0,0,,Әлі ерте еді.
Dialogue: 0,0:15:54.07,0:15:57.41,Default,,0,0,0,,А, мен сені кездестіруге рұқсат етпеуім керек еді.
Dialogue: 0,0:15:58.74,0:16:03.00,Default,,0,0,0,,Олар да қарғысты көргендей болды...
Dialogue: 0,0:16:03.12,0:16:04.79,Default,,0,0,0,,Ерен-чан себепкер.
Dialogue: 0,0:16:05.71,0:16:08.96,Default,,0,0,0,,Қызымды аруақ таныды.
Dialogue: 0,0:16:09.17,0:16:13.43,Default,,0,0,0,,Мен Ерен-чаннан көмек сұрадым.
Dialogue: 0,0:16:13.55,0:16:18.06,Default,,0,0,0,,(Дәрігерлер сөйлейді)
Dialogue: 0,0:16:20.22,0:16:21.60,Default,,0,0,0,,Ах! Мәртебелі!
Dialogue: 0,0:16:21.73,0:16:23.60,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:16:23.77,0:16:25.65,Default,,0,0,0,,Менің ұлдарым... Уф.
Dialogue: 0,0:16:25.81,0:16:27.27,Default,,0,0,0,,Өзіңізді мәжбүрлемеңіз
Dialogue: 0,0:16:28.57,0:16:30.69,Default,,0,0,0,,Екеуіңіз ес-түссіз жатырсыздар.
Dialogue: 0,0:16:30.82,0:16:32.07,Default,,0,0,0,,Амансыңдар деп үміттенемін.
Dialogue: 0,0:16:33.40,0:16:35.07,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:17:07.40,0:17:08.81,Default,,0,0,0,,Аға
Dialogue: 0,0:17:09.48,0:17:11.11,Default,,0,0,0,,Біз де қайтайық.
Dialogue: 0,0:17:11.28,0:17:12.78,Default,,0,0,0,,О
Dialogue: 0,0:17:14.36,0:17:19.08,Default,,0,0,0,,Қызық, бұл дұға шынымен де аруақтарға жетеді ме?
Dialogue: 0,0:17:19.24,0:17:22.83,Default,,0,0,0,,Жыл сайын біз Рух фестивалінде дұға етеміз.
Dialogue: 0,0:17:22.95,0:17:25.04,Default,,0,0,0,,Бұл 200 жыл бұрын болған.
Dialogue: 0,0:17:25.16,0:17:28.79,Default,,0,0,0,,Мені кешірсеңіз жақсы деп ойлаймын...
Dialogue: 0,0:17:29.54,0:17:33.09,Default,,0,0,0,,Оның бізге еш қатысы жоқ.
Dialogue: 0,0:17:33.26,0:17:34.92,Default,,0,0,0,,Жарайды онда. Мен перделерді жауып, шамдарды өшіремін.
Dialogue: 0,0:17:36.84,0:17:38.34,Default,,0,0,0,,<Сонымен...>
Dialogue: 0,0:17:38.47,0:17:41.56,Default,,0,0,0,,<Неге рухтар патша әулетінен қашады>
Dialogue: 0,0:17:41.68,0:17:47.69,Default,,0,0,0,,<Жауап табылған жасырын бөлмедегі ескі кітапта жазылған.>
Dialogue: 0,0:17:48.35,0:17:50.44,Default,,0,0,0,,<Патша отбасы не істеді>
Dialogue: 0,0:17:50.61,0:17:54.36,Default,,0,0,0,,<Рух қабылдаған ем және...>
Dialogue: 0,0:17:55.19,0:17:59.37,Default,,0,0,0,,<Адамдар ренжітуге болмайтын нәрсені ренжіту>
Dialogue: 0,0:18:00.70,0:18:02.33,Default,,0,0,0,,<Сол кезде көргенім>
Dialogue: 0,0:18:02.58,0:18:07.12,Default,,0,0,0,,<Енді мен оның не екенін білдім>
Dialogue: 0,0:18:09.54,0:18:13.67,Default,,0,0,0,,<Бұл 200 жыл бұрын қайғылы оқиға болған жер>
Dialogue: 0,0:18:13.84,0:18:18.76,Default,,0,0,0,,<Дұғаға да, өкінуге де себеп жоқ.>
Dialogue: 0,0:18:18.93,0:18:25.18,Default,,0,0,0,,<Аруақтармен болған қиындықтардың тамыры, тыртықтар және...>
Dialogue: 0,0:18:25.35,0:18:27.94,Default,,0,0,0,,<Қабылдағышсыз айқай>
Dialogue: 0,0:18:42.03,0:18:45.62,Default,,0,0,0,,Биыл да Рух мерекесі күні келді.
Dialogue: 0,0:18:45.75,0:18:47.87,Default,,0,0,0,,Сәлем Эллен
Dialogue: 0,0:18:48.00,0:18:50.04,Default,,0,0,0,,Содан бері не істеп жүрсің?
Dialogue: 0,0:18:52.67,0:18:55.80,Default,,0,0,0,,Қарап тұрсам да, танысқым келеді.
Dialogue: 0,0:18:55.92,0:18:58.01,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,0:18:58.13,0:19:01.30,Default,,0,0,0,,Мен сізден кешірім сұрағым келеді
Dialogue: 0,0:19:04.68,0:19:07.93,Default,,0,0,0,,Бір күні аруақтарға да, саған да.
Dialogue: 0,0:19:09.19,0:19:12.40,Default,,0,0,0,,Кешірілетін күн келе ме деп ойлаймын.
Dialogue: 0,0:19:19.24,0:19:20.86,Default,,0,0,0,,Мен қайта ораламын.
Dialogue: 0,0:19:30.00,0:19:33.13,Default,,0,0,0,,(жылайды)
Dialogue: 0,0:19:41.80,0:19:43.51,Default,,0,0,0,,Ал...
Dialogue: 0,0:19:43.68,0:19:45.55,Default,,0,0,0,,Ұлы рухтар.
Dialogue: 0,0:19:45.72,0:19:50.43,Default,,0,0,0,,Олар адамдардың не істегенін түсінуін қалады.
Dialogue: 0,0:19:50.94,0:19:57.27,Default,,0,0,0,,<Сонымен, мен патшаға рухтардың айқайын есту үшін сиқырладым.>
Dialogue: 0,0:19:57.40,0:20:02.49,Default,,0,0,0,,<Ол кезде патша өле-өлгенше айғай ести берді.>
Dialogue: 0,0:20:02.61,0:20:06.83,Default,,0,0,0,,Сиқыр ол кезде тек патшаға арналған болатын.
Dialogue: 0,0:20:06.99,0:20:10.96,Default,,0,0,0,,Сондықтан оны ұрпаққа қалдыру мүмкін емес еді.
Dialogue: 0,0:20:11.08,0:20:12.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:12.33,0:20:13.92,Default,,0,0,0,,Сонда неге...
Dialogue: 0,0:20:14.25,0:20:17.46,Default,,0,0,0,,Жолдан адасып кеткен рух жандар
Dialogue: 0,0:20:17.59,0:20:21.13,Default,,0,0,0,,Мен патшаның қанын қарғадым, ол маған жабысты.
Dialogue: 0,0:20:21.51,0:20:24.59,Default,,0,0,0,,Мынау қара тұман...
Dialogue: 0,0:20:24.72,0:20:30.14,Default,,0,0,0,,Иә, сондықтан патша әулеті қарғысқа ұшырай береді.
Dialogue: 0,0:20:31.14,0:20:34.77,Default,,0,0,0,,Мен Ерен-чанның рухтар мерекесіне барғанын білемін.
Dialogue: 0,0:20:35.73,0:20:37.69,Default,,0,0,0,,Өйткені Ереннің өзі сондай
Dialogue: 0,0:20:37.86,0:20:41.40,Default,,0,0,0,,Уайымдап, қиналып, қарғысты жоюға тырысу
Dialogue: 0,0:20:42.15,0:20:45.78,Default,,0,0,0,,Сондықтан мен бұл туралы осы уақытқа дейін егжей-тегжейлі айтпадым.
Dialogue: 0,0:20:47.28,0:20:50.20,Default,,0,0,0,,Құрметті Каа, мен...
Dialogue: 0,0:20:50.33,0:20:54.92,Default,,0,0,0,,Мен тұтқында қалған бауырларымды құтқарғым келеді.
Dialogue: 0,0:20:55.17,0:20:57.17,Default,,0,0,0,,Сол кезде көрген азабым...
Dialogue: 0,0:20:57.29,0:21:01.51,Default,,0,0,0,,Қорлықтан, азаптан, ашудан
Dialogue: 0,0:21:01.63,0:21:03.38,Default,,0,0,0,,Мен сені босатқым келеді
Dialogue: 0,0:21:06.47,0:21:08.05,Default,,0,0,0,,Эллен-чан
Dialogue: 0,0:21:08.18,0:21:12.27,Default,,0,0,0,,Мейірімді қызым осылай айтады деп ойладым.
Dialogue: 0,0:21:15.19,0:21:19.73,Default,,0,0,0,,Жандарды азат ететін күшім бар ма?
Dialogue: 0,0:21:21.86,0:21:23.69,Default,,0,0,0,,Менің ойымша, бұл қиын.
Dialogue: 0,0:21:24.11,0:21:25.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:25.86,0:21:31.95,Default,,0,0,0,,Адамдар жыл сайын рухтар мерекесінде ресми дұға жасайды, солай емес пе?
Dialogue: 0,0:21:32.08,0:21:34.58,Default,,0,0,0,,Аруақтарға алғыс айту былай тұрсын
Dialogue: 0,0:21:34.71,0:21:38.71,Default,,0,0,0,,Қателік үшін өкінбейтін таңбалы әрекет.
Dialogue: 0,0:21:39.21,0:21:42.84,Default,,0,0,0,,Сондықтан әлі де рұқсат етілмейді.
Dialogue: 0,0:21:43.88,0:21:47.47,Default,,0,0,0,,Менің күйеуім ретінде Ловелл бар.
Dialogue: 0,0:21:47.59,0:21:50.68,Default,,0,0,0,,Енді қарғыс атқан адамдар немесе
Dialogue: 0,0:21:50.81,0:21:54.81,Default,,0,0,0,,Қаңғыбас рухтарды қолдама.
Dialogue: 0,0:21:55.77,0:21:59.31,Default,,0,0,0,,Рух болып, құдай боп...
Dialogue: 0,0:21:59.44,0:22:01.27,Default,,0,0,0,,Ана кеңесі
Dialogue: 0,0:22:01.44,0:22:02.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:06.61,0:22:07.86,Default,,0,0,0,,Иә...
Dialogue: 0,0:22:10.20,0:22:13.16,Default,,0,0,0,,♪～
Dialogue: 0,0:23:36.45,0:23:39.41,Default,,0,0,0,,～♪
