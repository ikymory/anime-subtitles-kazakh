Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:13.38,0:00:15.93,Default,,0,0,0,,<Еренмен соңғы кездескеніме үш жыл>
Dialogue: 0,0:00:16.60,0:00:20.14,Default,,0,0,0,,<Мен Ван Круфт отбасында талай рет болдым...>
Dialogue: 0,0:00:21.02,0:00:23.60,Default,,0,0,0,,<Бірақ...>
Dialogue: 0,0:00:23.89,0:00:25.19,Default,,0,0,0,,Мәртебелі…
Dialogue: 0,0:00:25.31,0:00:28.82,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:00:29.11,0:00:32.28,Default,,0,0,0,,Ерен-сама бүгін де жоқ.
Dialogue: 0,0:00:33.07,0:00:34.95,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:00:35.07,0:00:37.87,Default,,0,0,0,,<Мен оны ешқашан кездестірмедім>
Dialogue: 0,0:00:38.16,0:00:42.25,Default,,0,0,0,,Сіз кіріп, ішіп алғыңыз келе ме?
Dialogue: 0,0:00:42.37,0:00:43.46,Default,,0,0,0,,Рахмет
Dialogue: 0,0:00:43.58,0:00:45.71,Default,,0,0,0,,Саса осында келіңізші
Dialogue: 0,0:00:47.58,0:00:52.46,Default,,0,0,0,,<Жақында Лорен бізді сарайда қарсы ала бастады>
Dialogue: 0,0:00:53.67,0:00:56.18,Default,,0,0,0,,<Әр жолы бұрылған шығар>
Dialogue: 0,0:00:56.30,0:00:59.26,Default,,0,0,0,,<Сіз өзіңізді кінәлі сезінуіңіз керек>
Dialogue: 0,0:01:00.43,0:01:01.68,Default,,0,0,0,,<Және...>
Dialogue: 0,0:01:02.56,0:01:06.94,Default,,0,0,0,,<Оны Ереннің бұл сарайда жоқтығына сендіру үшін шығар>
Dialogue: 0,0:01:07.06,0:01:08.90,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:01:11.82,0:01:14.65,Default,,0,0,0,,Бұл әдеттегідей дәмді.
Dialogue: 0,0:01:17.24,0:01:19.99,Default,,0,0,0,,<Бір күні кездесеміз бе?>
Dialogue: 0,0:01:20.20,0:01:21.66,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:01:21.79,0:01:23.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:24.75,0:01:26.00,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:01:26.16,0:01:27.71,Default,,0,0,0,,Осы үйдің басшысы
Dialogue: 0,0:01:27.83,0:01:30.21,Default,,0,0,0,,Саувел Ванкрефттің қызы
Dialogue: 0,0:01:30.34,0:01:32.42,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:01:32.55,0:01:35.01,Default,,0,0,0,,Сіз Лореннен хабар алған жоқсыз ба?
Dialogue: 0,0:01:35.13,0:01:36.76,Default,,0,0,0,,Мен ол жайлы білмеймін.
Dialogue: 0,0:01:36.97,0:01:40.85,Default,,0,0,0,,Атам маған да, анама да ештеңе айтпайды.
Dialogue: 0,0:01:40.97,0:01:42.64,Default,,0,0,0,,не үшін қолданылады?
Dialogue: 0,0:01:43.47,0:01:46.60,Default,,0,0,0,,Хехе... біз Еренмен танысқымыз келеді.
Dialogue: 0,0:01:46.73,0:01:47.56,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:48.02,0:01:51.61,Default,,0,0,0,,Ерен тағы да? Маған сенімен кездесуге де рұқсат етпеді.
Dialogue: 0,0:01:51.73,0:01:53.86,Default,,0,0,0,,Е, сен де...
Dialogue: 0,0:01:53.98,0:01:58.49,Default,,0,0,0,,Иә! Барлығыңыз, Эллен Эллен Эллен Эллен
Dialogue: 0,0:01:58.66,0:02:01.62,Default,,0,0,0,,Ендеше неге Еренмен кездескің келеді?
Dialogue: 0,0:02:04.24,0:02:07.41,Default,,0,0,0,,Мен жеке кешірім сұрағым келеді.
Dialogue: 0,0:02:08.00,0:02:09.67,Default,,0,0,0,,Хмм…
Dialogue: 0,0:02:11.25,0:02:14.34,Default,,0,0,0,,Мүмкін үнемі сыйлық әкелетін адам шығар?
Dialogue: 0,0:02:14.46,0:02:15.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:16.17,0:02:18.43,Default,,0,0,0,,Олай болса маған да бер!
Dialogue: 0,0:02:20.26,0:02:23.51,Default,,0,0,0,,Мәртебелі, тағы шай алғыңыз келе ме?
Dialogue: 0,0:02:23.64,0:02:25.77,Default,,0,0,0,,Күте тұрыңыз! Мәртебелі дедіңіз бе?
Dialogue: 0,0:02:25.93,0:02:27.85,Default,,0,0,0,,Балалар сендер ханзада болдыңдар ма?
Dialogue: 0,0:02:27.98,0:02:28.89,Default,,0,0,0,,Лафилия-сама
Dialogue: 0,0:02:29.10,0:02:31.90,Default,,0,0,0,,Жоғары мәртебелі мырзаға не дедіңіз...хехехе
Dialogue: 0,0:02:32.02,0:02:34.15,Default,,0,0,0,,Күлме!
Dialogue: 0,0:02:34.27,0:02:35.57,Default,,0,0,0,,Олар кездескісі келеді.
Dialogue: 0,0:02:35.69,0:02:37.74,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:02:37.94,0:02:40.11,Default,,0,0,0,,Жоқ, маңызды емес.
Dialogue: 0,0:02:40.24,0:02:41.32,Default,,0,0,0,,Лафилия
Dialogue: 0,0:02:42.53,0:02:43.66,Default,,0,0,0,,Келесі жолы келемін
Dialogue: 0,0:02:44.45,0:02:46.87,Default,,0,0,0,,Мен саған сыйлық әкелемін.
Dialogue: 0,0:02:47.00,0:02:48.58,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:48.71,0:02:52.04,Default,,0,0,0,,Құрметті Рафилия! Сөзіңізді түзетіңіз!
Dialogue: 0,0:02:52.50,0:02:55.80,Default,,0,0,0,,Лорен, көмегіңіз үшін рахмет. Мен тағы келемін.
Dialogue: 0,0:02:55.92,0:02:56.76,Default,,0,0,0,,Иә
Dialogue: 0,0:02:58.67,0:03:01.09,Default,,0,0,0,,Ханзада сыйлық әкеліп жатыр!
Dialogue: 0,0:03:01.97,0:03:03.80,Default,,0,0,0,,Лафилия-сама...
Dialogue: 0,0:03:03.93,0:03:05.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:05.64,0:03:07.89,Default,,0,0,0,,Түсінгенше мен неше рет айтуым керек?
Dialogue: 0,0:03:08.02,0:03:10.27,Default,,0,0,0,,Сәлем! Кешіріңіз!
Dialogue: 0,0:03:10.39,0:03:11.48,Default,,0,0,0,,Хехе...
Dialogue: 0,0:03:11.65,0:03:14.48,Default,,0,0,0,,Иә? Бауырым, қызық болатын сияқты
Dialogue: 0,0:03:14.61,0:03:15.82,Default,,0,0,0,,О
Dialogue: 0,0:03:15.94,0:03:19.07,Default,,0,0,0,,Менімен бірінші рет осылай сөйлесті.
Dialogue: 0,0:03:19.19,0:03:22.20,Default,,0,0,0,,Бұл жай ғана өрескел емес пе...
Dialogue: 0,0:03:22.32,0:03:24.91,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:03:25.99,0:03:28.95,Default,,0,0,0,,♪～
Dialogue: 0,0:04:48.99,0:04:51.95,Default,,0,0,0,,～♪
Dialogue: 0,0:05:01.09,0:05:05.09,Default,,0,0,0,,Бүгін одан да сүйкімді көрінесің, менің ханшайымым.
Dialogue: 0,0:05:05.22,0:05:07.80,Default,,0,0,0,,Сіз көп киіндіңіз ғой, солай ма?
Dialogue: 0,0:05:07.93,0:05:10.72,Default,,0,0,0,,Мен ағайдың шахтасына амандасу үшін барамын.
Dialogue: 0,0:05:10.85,0:05:13.60,Default,,0,0,0,,Мен мұны дұрыс орындауым керек деп ойладым.
Dialogue: 0,0:05:13.73,0:05:14.77,Default,,0,0,0,,Ол келді.
Dialogue: 0,0:05:15.06,0:05:16.48,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:05:16.60,0:05:19.86,Default,,0,0,0,,Тіпті Ерен де қобалжыды, а?
Dialogue: 0,0:05:20.02,0:05:21.73,Default,,0,0,0,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,0:05:25.36,0:05:27.45,Default,,0,0,0,,Ханшайым, шығасың ба?
Dialogue: 0,0:05:27.61,0:05:29.03,Default,,0,0,0,,Ван мырза
Dialogue: 0,0:05:29.20,0:05:31.28,Default,,0,0,0,,Моффун
Dialogue: 0,0:05:32.08,0:05:37.42,Default,,0,0,0,,Мен Тосамамен ағайға көмектесуге барамын.
Dialogue: 0,0:05:37.54,0:05:39.63,Default,,0,0,0,,Жарайсың ба, ханшайым?
Dialogue: 0,0:05:39.92,0:05:41.71,Default,,0,0,0,,Мен қобалжыдым.
Dialogue: 0,0:05:41.84,0:05:44.46,Default,,0,0,0,,Олай болса мен саған еріп барамын.
Dialogue: 0,0:05:44.59,0:05:46.51,Default,,0,0,0,,Ван әлі жақсы емес.
Dialogue: 0,0:05:46.63,0:05:48.43,Default,,0,0,0,,Адамгершілікке ие болу керек.
Dialogue: 0,0:05:48.55,0:05:49.55,Default,,0,0,0,,Иә...
Dialogue: 0,0:05:49.68,0:05:51.64,Default,,0,0,0,,Жарайды, кеттік, Ерен.
Dialogue: 0,0:05:51.76,0:05:53.22,Default,,0,0,0,,Иә Тото-сама
Dialogue: 0,0:05:53.35,0:05:54.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:54.35,0:05:56.39,Default,,0,0,0,,Касама, мен барамын.
Dialogue: 0,0:05:57.23,0:05:58.73,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:06:00.27,0:06:01.77,Default,,0,0,0,,Қайта кездескенше, Ван!
Dialogue: 0,0:06:01.90,0:06:03.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:06.70,0:06:07.82,Default,,0,0,0,,♬~
Dialogue: 0,0:06:08.66,0:06:12.49,Default,,0,0,0,,<Ханшайым соңғы кездері менімен ойнамайды...>
Dialogue: 0,0:06:12.62,0:06:16.12,Default,,0,0,0,,<Мен онымен кішкентай кезімнен ойнаймын...>
Dialogue: 0,0:06:18.79,0:06:20.71,Default,,0,0,0,,Вантан!
Dialogue: 0,0:06:21.29,0:06:22.92,Default,,0,0,0,,Моффун!
Dialogue: 0,0:06:23.09,0:06:26.26,Default,,0,0,0,,Ах! Бұл қауіпті, Ерен!
Dialogue: 0,0:06:26.38,0:06:29.38,Default,,0,0,0,,Енді Ту-самамен бірге бөлмеге қайтайық.
Dialogue: 0,0:06:29.51,0:06:30.43,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:06:30.59,0:06:32.93,Default,,0,0,0,,Ханахит~! (Ровел) Біз не ойнауымыз керек?
Dialogue: 0,0:06:33.05,0:06:36.56,Default,,0,0,0,,Хмм... Хмм... (Ровел) Хмм... Жасырынбақ ойнауға әлі ерте сияқты.
Dialogue: 0,0:06:36.68,0:06:38.89,Default,,0,0,0,,А... Иә!?
Dialogue: 0,0:06:39.02,0:06:41.06,Default,,0,0,0,,Вантан!
Dialogue: 0,0:06:41.27,0:06:42.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:42.27,0:06:45.48,Default,,0,0,0,,Вантан, сен немен ойнайсың?
Dialogue: 0,0:06:45.61,0:06:48.95,Default,,0,0,0,,Жасырынбақ ше?
Dialogue: 0,0:06:49.24,0:06:51.53,Default,,0,0,0,,Телепортация сиқырын пайдаланып жатырсыз ба?
Dialogue: 0,0:06:52.62,0:06:53.87,Default,,0,0,0,,Елен!
Dialogue: 0,0:06:54.24,0:06:57.58,Default,,0,0,0,,Бұл қайда! Элейн! Ах!
Dialogue: 0,0:06:59.58,0:07:00.92,Default,,0,0,0,,Фу…
Dialogue: 0,0:07:01.04,0:07:03.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:03.42,0:07:04.34,Default,,0,0,0,,Айқай
Dialogue: 0,0:07:04.46,0:07:05.96,Default,,0,0,0,,Кюн…
Dialogue: 0,0:07:06.34,0:07:08.42,Default,,0,0,0,,Вантан!
Dialogue: 0,0:07:09.38,0:07:10.51,Default,,0,0,0,,Элейн
Dialogue: 0,0:07:10.63,0:07:13.30,Default,,0,0,0,,Totama Fly Vantan!
Dialogue: 0,0:07:13.43,0:07:15.43,Default,,0,0,0,,Мистер Ловелл (Ловелл)?
Dialogue: 0,0:07:15.60,0:07:19.94,Default,,0,0,0,,Менің баламды не істеп жатырсың?
Dialogue: 0,0:07:20.44,0:07:22.90,Default,,0,0,0,,Сіз тіпті Винтті де ұстай аласыз ба?
Dialogue: 0,0:07:23.02,0:07:25.40,Default,,0,0,0,,Осылай жасасаңыз, Ерен шығады.
Dialogue: 0,0:07:25.69,0:07:26.94,Default,,0,0,0,,Оны сыныптар бойынша айналмалы турнир деп атайды.
Dialogue: 0,0:07:27.15,0:07:30.28,Default,,0,0,0,,Балама осылай істегеніме сене алар емеспін...
Dialogue: 0,0:07:30.40,0:07:32.70,Default,,0,0,0,,Мен ешкімді кешіре алмаймын!
Dialogue: 0,0:07:32.82,0:07:34.82,Default,,0,0,0,,Кешіріңіз. Тағы да рахмет.
Dialogue: 0,0:07:34.95,0:07:36.62,Default,,0,0,0,,Кие!!
Dialogue: 0,0:07:37.58,0:07:42.58,Default,,0,0,0,,<Мм, мен тез арада адамға айналуым керек>
Dialogue: 0,0:07:43.50,0:07:45.54,Default,,0,0,0,,Корольдік мәртебелілер тағы да осында ма?
Dialogue: 0,0:07:45.75,0:07:46.63,Default,,0,0,0,,Иә
Dialogue: 0,0:07:46.75,0:07:50.51,Default,,0,0,0,,Бірақ мен оларға Еренсаманың жоқ екенін айтып, үйіне жібердім.
Dialogue: 0,0:07:50.63,0:07:53.97,Default,,0,0,0,,Бұл дұрыс, өйткені бұл шындық.
Dialogue: 0,0:07:54.09,0:07:57.06,Default,,0,0,0,,Бауырым, мен бүгін шахтаға барамын.
Dialogue: 0,0:07:57.18,0:08:00.68,Default,,0,0,0,,Бастапқыда көп күміс өндірілген.
Dialogue: 0,0:08:00.81,0:08:03.77,Default,,0,0,0,,Соңғы уақытта сома айтарлықтай төмендеді.
Dialogue: 0,0:08:04.19,0:08:08.36,Default,,0,0,0,,Еріксіз жағдайларға байланысты біз шахтаны жабу туралы шешім қабылдадық.
Dialogue: 0,0:08:08.94,0:08:11.40,Default,,0,0,0,,Мен мұны сізге айтайын.
Dialogue: 0,0:08:11.53,0:08:12.82,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:13.03,0:08:14.86,Default,,0,0,0,,Сондықтан Эллен
Dialogue: 0,0:08:14.99,0:08:18.28,Default,,0,0,0,,Шахта қауіпті, сондықтан ағаңды тастама.
Dialogue: 0,0:08:18.41,0:08:21.75,Default,,0,0,0,,Ағам Еренді жібермейді.
Dialogue: 0,0:08:22.04,0:08:24.96,Default,,0,0,0,,Әрине! Мен оны ұстай бердім!
Dialogue: 0,0:08:25.08,0:08:26.71,Default,,0,0,0,,Иә...
Dialogue: 0,0:08:26.84,0:08:29.96,Default,,0,0,0,,Мен де сенімен бірге болғым келеді...
Dialogue: 0,0:08:30.09,0:08:32.76,Default,,0,0,0,,Мен кәдесый алып қайтамын!
Dialogue: 0,0:08:32.88,0:08:34.88,Default,,0,0,0,,Біз сізді асыға күтеміз.
Dialogue: 0,0:08:35.01,0:08:38.30,Default,,0,0,0,,Айтпақшы, сенің әжең осында емес пе?
Dialogue: 0,0:08:38.64,0:08:43.14,Default,,0,0,0,,А, мен анама Ереннің бүгін келетінін айтқан жоқпын.
Dialogue: 0,0:08:43.39,0:08:45.27,Default,,0,0,0,,Не? Неліктен?
Dialogue: 0,0:08:45.40,0:08:48.23,Default,,0,0,0,,Мен сені өзіңмен бірге шахтаға апаруыңды өтінемін.
Dialogue: 0,0:08:48.40,0:08:49.77,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:08:49.90,0:08:50.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:54.40,0:08:57.24,Default,,0,0,0,,Енді ойлап қарасам, аға, мысал ретінде.
Dialogue: 0,0:08:57.37,0:08:58.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:58.91,0:09:01.66,Default,,0,0,0,,<Мен Ереннің маған берген құймасын айтып отырмын>
Dialogue: 0,0:09:02.04,0:09:03.96,Default,,0,0,0,,А... иә?
Dialogue: 0,0:09:04.08,0:09:07.33,Default,,0,0,0,,Мен олардың кейбіреулері ескі қоймадан шыққандай етіп көрсетемін.
Dialogue: 0,0:09:08.13,0:09:10.63,Default,,0,0,0,,Оған алдыңғы буын ие болған сияқты.
Dialogue: 0,0:09:10.75,0:09:13.80,Default,,0,0,0,,Патша әулеті бұл туралы естісе де, олар күдіктенбейді.
Dialogue: 0,0:09:13.92,0:09:16.68,Default,,0,0,0,,Бұл жақсы идея.
Dialogue: 0,0:09:17.89,0:09:19.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:19.14,0:09:22.18,Default,,0,0,0,,Ат арбалары өте көп, солай емес пе?
Dialogue: 0,0:09:22.31,0:09:23.60,Default,,0,0,0,,Бұл біртүрлі...
Dialogue: 0,0:09:24.93,0:09:25.81,Default,,0,0,0,,Ах
Dialogue: 0,0:09:27.35,0:09:31.15,Default,,0,0,0,,Мені алдауға әлі ерте!
Dialogue: 0,0:09:31.27,0:09:33.86,Default,,0,0,0,,Әсіресе, егер сіз оларға шахтаның жабылғаны туралы айтқыңыз келсе!
Dialogue: 0,0:09:33.99,0:09:37.20,Default,,0,0,0,,Әже! Әже де сізбен бірге болады!?
Dialogue: 0,0:09:37.36,0:09:39.78,Default,,0,0,0,,Дұрыс! Эллен!
Dialogue: 0,0:09:39.95,0:09:41.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:42.91,0:09:45.08,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:09:45.21,0:09:47.67,Default,,0,0,0,,Альберт~!
Dialogue: 0,0:09:48.33,0:09:50.42,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:09:50.92,0:09:53.88,Default,,0,0,0,,Мен Еренмен бірге шыға алатыныма қуаныштымын.
Dialogue: 0,0:09:54.01,0:09:56.63,Default,,0,0,0,,Пикникке ұқсайды, әже!
Dialogue: 0,0:09:56.76,0:09:58.68,Default,,0,0,0,,Дұрыс~
Dialogue: 0,0:09:58.80,0:10:01.22,Default,,0,0,0,,Анашым, сіз шынымен барғыңыз келеді.
Dialogue: 0,0:10:01.43,0:10:02.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:02.68,0:10:04.93,Default,,0,0,0,,Альберто (Саувел) Мен мұны сұрадым.
Dialogue: 0,0:10:06.02,0:10:07.39,Default,,0,0,0,,Иә
Dialogue: 0,0:10:07.69,0:10:10.61,Default,,0,0,0,,Не? Адамдарды жүк сияқты ұстаңыз
Dialogue: 0,0:10:10.90,0:10:13.98,Default,,0,0,0,,I Сен туылғанға дейін
Dialogue: 0,0:10:14.11,0:10:17.20,Default,,0,0,0,,Ол менің күйеуімді дала сапарларында жиі ертіп жүрді!
Dialogue: 0,0:10:17.49,0:10:18.91,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:10:19.03,0:10:20.41,Default,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,0:10:20.74,0:10:23.12,Default,,0,0,0,,Сонымен әже...
Dialogue: 0,0:10:24.04,0:10:27.96,Default,,0,0,0,,Әже, мен көйлекпен келдім.
Dialogue: 0,0:10:28.50,0:10:30.42,Default,,0,0,0,,Ерен-чан жарайды.
Dialogue: 0,0:10:30.54,0:10:33.34,Default,,0,0,0,,Ловелл сені мәңгілікке ұстайды, солай ма?
Dialogue: 0,0:10:33.46,0:10:37.01,Default,,0,0,0,,Әрине! Күткендей!
Dialogue: 0,0:10:46.77,0:10:49.81,Default,,0,0,0,,Ловелл мырза, Саувел мырза, қош келдіңіз.
Dialogue: 0,0:10:49.94,0:10:51.81,Default,,0,0,0,,Ловелл мырза, біраз уақыт болды!
Dialogue: 0,0:10:51.94,0:10:54.52,Default,,0,0,0,,Бүгін сізбен Саувел мырза болады деп естідім...
Dialogue: 0,0:10:54.69,0:10:56.86,Default,,0,0,0,,<Ақыр аяғында бұл орынсыз...>
Dialogue: 0,0:10:57.03,0:10:59.15,Default,,0,0,0,,<Мен қателік жібердім>
Dialogue: 0,0:10:59.28,0:11:02.12,Default,,0,0,0,,<Бірінші әсер - ең нашар...>
Dialogue: 0,0:11:03.12,0:11:04.08,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:11:05.03,0:11:07.04,Default,,0,0,0,,Менің атым Эллен ВанКруфт.
Dialogue: 0,0:11:07.91,0:11:09.91,Default,,0,0,0,,Ловелл ВанКруфттың қызы
Dialogue: 0,0:11:10.04,0:11:12.00,Default,,0,0,0,,О~ (Шахтер) Лавелл мырза қандай!
Dialogue: 0,0:11:12.29,0:11:14.59,Default,,0,0,0,,Бұл сүйкімді, солай емес пе?
Dialogue: 0,0:11:14.71,0:11:16.13,Default,,0,0,0,,(Кёко) Қыз ба? (Юки) Ұл ба?
Dialogue: 0,0:11:17.09,0:11:19.34,Default,,0,0,0,,Мен бүгін ағаммен келдім.
Dialogue: 0,0:11:19.51,0:11:21.59,Default,,0,0,0,,Шахтаның жабылуы туралы айту.
Dialogue: 0,0:11:23.55,0:11:26.39,Default,,0,0,0,,Қайта іске қосу әлі мүмкін емес пе...
Dialogue: 0,0:11:30.10,0:11:31.56,Default,,0,0,0,,Бәріңе сәлем!
Dialogue: 0,0:11:31.81,0:11:33.90,Default,,0,0,0,,Ханым!? (Шахтер) Изабелла ханым!?
Dialogue: 0,0:11:34.23,0:11:35.65,Default,,0,0,0,,Біраз уақыт өтті!
Dialogue: 0,0:11:35.77,0:11:37.86,Default,,0,0,0,,О, бұл сондай ностальгиялық!
Dialogue: 0,0:11:38.32,0:11:42.41,Default,,0,0,0,,Менің ұлдарыммен пікірталасқа барасың ба?
Dialogue: 0,0:11:42.53,0:11:43.53,Default,,0,0,0,,Ұрсу!
Dialogue: 0,0:11:45.45,0:11:48.87,Default,,0,0,0,,Мен сізге түскі ас ұнайды деп ойладым, сондықтан мен оны сізге дайындадым!
Dialogue: 0,0:11:49.08,0:11:52.75,Default,,0,0,0,,Әй, менің алдыңғы ағам осында болған кезі есімде.
Dialogue: 0,0:11:52.87,0:11:57.05,Default,,0,0,0,,Дұрыс, сен маған әр жолы осылай дәмді тамақ әкелесің...
Dialogue: 0,0:11:57.17,0:12:00.51,Default,,0,0,0,,Барлығы оны асыға күтті.
Dialogue: 0,0:12:00.88,0:12:03.72,Default,,0,0,0,,Әкең ренжісе керек.
Dialogue: 0,0:12:03.84,0:12:05.01,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:12:05.14,0:12:06.26,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:12:06.39,0:12:07.97,Default,,0,0,0,,Эллен-чан?
Dialogue: 0,0:12:08.31,0:12:12.31,Default,,0,0,0,,Тамақ – адамдарды тыныштандырудың ең жақсы тәсілі.
Dialogue: 0,0:12:12.44,0:12:14.40,Default,,0,0,0,,Әже...
Dialogue: 0,0:12:15.94,0:12:18.07,Default,,0,0,0,,…
Dialogue: 0,0:12:18.32,0:12:20.53,Default,,0,0,0,,...
Dialogue: 0,0:12:20.82,0:12:23.99,Default,,0,0,0,,Әдеттегідей барлығы жақсы тамақтанып жатыр.
Dialogue: 0,0:12:24.28,0:12:25.95,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:12:28.08,0:12:32.29,Default,,0,0,0,,<Олар бастапқыда күмісті осы жерден өндіргенін айтты...>
Dialogue: 0,0:12:33.62,0:12:37.00,Default,,0,0,0,,＜…＞
Dialogue: 0,0:12:37.13,0:12:38.46,Default,,0,0,0,,...
Dialogue: 0,0:12:38.84,0:12:40.30,Default,,0,0,0,,Ах... Иә!
Dialogue: 0,0:12:40.55,0:12:43.01,Default,,0,0,0,,...
Dialogue: 0,0:12:43.22,0:12:44.63,Default,,0,0,0,,Солай ма?\NСіз
Dialogue: 0,0:12:44.76,0:12:46.18,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:47.60,0:12:48.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:48.60,0:12:51.81,Default,,0,0,0,,Көп, сондықтан қалағаныңызша қараңыз.
Dialogue: 0,0:12:53.69,0:12:55.81,Default,,0,0,0,,...
Dialogue: 0,0:12:55.94,0:12:59.44,Default,,0,0,0,,Бұл жігіт сол кезде менің үлесімді де жеп қойған.
Dialogue: 0,0:12:59.57,0:13:02.03,Default,,0,0,0,,()
Dialogue: 0,0:13:02.19,0:13:03.78,Default,,0,0,0,,Айырмашылығы неде?
Dialogue: 0,0:13:03.90,0:13:06.20,Default,,0,0,0,,Қалғанын жедім деді.
Dialogue: 0,0:13:06.32,0:13:07.49,Default,,0,0,0,,<Мен...>
Dialogue: 0,0:13:08.78,0:13:11.33,Default,,0,0,0,,<Бұл барлығына арналған...>
Dialogue: 0,0:13:11.70,0:13:14.04,Default,,0,0,0,,<Аа, дұрыс! ＞
Dialogue: 0,0:13:14.33,0:13:20.04,Default,,0,0,0,,<Кварц көп болса, алтыннан күміс жақсы...>
Dialogue: 0,0:13:20.17,0:13:22.05,Default,,0,0,0,,Атомдық нөмірі 47
Dialogue: 0,0:13:22.88,0:13:24.34,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:13:24.47,0:13:26.72,Default,,0,0,0,,...
Dialogue: 0,0:13:26.84,0:13:27.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:28.26,0:13:31.56,Default,,0,0,0,,Бұрышты өзгерткенде оның жарқырауын көру қызық.
Dialogue: 0,0:13:31.68,0:13:33.85,Default,,0,0,0,,Не? Жарқырап тұр!?
Dialogue: 0,0:13:33.98,0:13:35.18,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:39.81,0:13:41.44,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:13:42.32,0:13:45.99,Default,,0,0,0,,Мырза, мына тасты сындырып, тексеріп көрейін бе?
Dialogue: 0,0:13:46.11,0:13:47.41,Default,,0,0,0,,Және қалағаныңа қол жеткізе алмасаң—
Dialogue: 0,0:13:56.62,0:13:58.83,Default,,0,0,0,,Міне!
Dialogue: 0,0:13:59.21,0:14:00.59,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:01.34,0:14:02.67,Default,,0,0,0,,Күміс
Dialogue: 0,0:14:02.80,0:14:04.30,Default,,0,0,0,,Күміс? Бұл солай ма?
Dialogue: 0,0:14:05.01,0:14:06.34,Default,,0,0,0,,Бұл күміс!
Dialogue: 0,0:14:06.47,0:14:07.55,Default,,0,0,0,,Ой
Dialogue: 0,0:14:07.68,0:14:09.68,Default,,0,0,0,,Тағы да болуы мүмкін!
Dialogue: 0,0:14:11.30,0:14:12.68,Default,,0,0,0,,Әй, сәл күте тұрыңыз!
Dialogue: 0,0:14:12.85,0:14:15.39,Default,,0,0,0,,Сіз әлі де қазуға болады! Бұл тау!
Dialogue: 0,0:14:15.52,0:14:17.06,Default,,0,0,0,,О!
Dialogue: 0,0:14:17.44,0:14:18.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:23.19,0:14:24.73,Default,,0,0,0,,<Эрен? ＞
Dialogue: 0,0:14:26.82,0:14:29.70,Default,,0,0,0,,Мырза! Ол ешқашан жабылмайды!
Dialogue: 0,0:14:29.86,0:14:32.20,Default,,0,0,0,,Бұл тау әлі... (Саувел) Күте тұр деп жатқан шығарсың!
Dialogue: 0,0:14:32.33,0:14:33.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:33.83,0:14:36.50,Default,,0,0,0,,Балалар, ұмытып кеттіңдер ме?
Dialogue: 0,0:14:37.37,0:14:40.42,Default,,0,0,0,,Бұл шахта тым көп күміс өндірді.
Dialogue: 0,0:14:40.54,0:14:42.71,Default,,0,0,0,,Сізді рух қарғысқа ұшыратады!
Dialogue: 0,0:14:43.42,0:14:44.67,Default,,0,0,0,,Қарғыс?
Dialogue: 0,0:14:44.80,0:14:46.63,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:14:54.85,0:14:56.72,Default,,0,0,0,,<Олай дейсіз бе...>
Dialogue: 0,0:14:57.89,0:14:59.77,Default,,0,0,0,,Саувел ағай
Dialogue: 0,0:14:59.89,0:15:00.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:01.56,0:15:05.40,Default,,0,0,0,,Бәріңізбен бір сәт сөйлесе аламын ба?
Dialogue: 0,0:15:05.73,0:15:09.99,Default,,0,0,0,,Менің білімім сізге пайдалы болуы мүмкін.
Dialogue: 0,0:15:12.32,0:15:13.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:15.03,0:15:16.12,Default,,0,0,0,,Қалай болғанда да, әзірге сол жерден кетіңдер
Dialogue: 0,0:15:16.66,0:15:21.37,Default,,0,0,0,,Қарғыс ентігу, жөтел және қақырық белгілерін тудырады.
Dialogue: 0,0:15:21.50,0:15:24.75,Default,,0,0,0,,Олардың кейбіреулері өмірлерінен айырылған жоқ па?
Dialogue: 0,0:15:24.92,0:15:26.09,Default,,0,0,0,,Неліктен бұл?
Dialogue: 0,0:15:26.21,0:15:29.22,Default,,0,0,0,,Менде бұл қарғыс туралы түсінік бар.
Dialogue: 0,0:15:31.97,0:15:37.35,Default,,0,0,0,,Сіз мұнда бірнеше жылдар бойы металл бөлшектерімен және шаңмен дем алып келесіз.
Dialogue: 0,0:15:37.47,0:15:40.35,Default,,0,0,0,,Бұл менің денеме кері әсер етті.
Dialogue: 0,0:15:40.81,0:15:43.81,Default,,0,0,0,,Басқаша айтқанда, бұл рухтың қарғысы емес.
Dialogue: 0,0:15:44.44,0:15:46.52,Default,,0,0,0,,Бұл пневмокониоз деп аталатын ауру.
Dialogue: 0,0:15:46.65,0:15:50.15,Default,,0,0,0,,Пневмокониоз? (Шахтер) Қарғыс емес пе?
Dialogue: 0,0:15:54.74,0:15:58.83,Default,,0,0,0,,Сонымен, пневмокониоз деп аталатын ауруды емдеуге болады ма?
Dialogue: 0,0:16:00.71,0:16:02.21,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:02.33,0:16:05.13,Default,,0,0,0,,Толық емдеу қиын
Dialogue: 0,0:16:05.25,0:16:07.04,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:07.21,0:16:09.92,Default,,0,0,0,,Бірақ... бұл уақытты қажет етеді
Dialogue: 0,0:16:10.05,0:16:12.93,Default,,0,0,0,,Бірте-бірте жақсартуға мүмкіндік беру керек.
Dialogue: 0,0:16:13.13,0:16:16.01,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:16:16.14,0:16:21.89,Default,,0,0,0,,Қаншама жылдар бойы мені мазалаған аурудан сәл де болса құтылсам...
Dialogue: 0,0:16:22.35,0:16:27.36,Default,,0,0,0,,Өтінемін, көмектесіңізші.
Dialogue: 0,0:16:27.98,0:16:29.11,Default,,0,0,0,,Ерен?
Dialogue: 0,0:16:29.48,0:16:32.99,Default,,0,0,0,,Тусама, сарайға қайтайық.
Dialogue: 0,0:16:33.11,0:16:36.28,Default,,0,0,0,,Менің сізбен талқылағым келетін бір нәрсе бар.
Dialogue: 0,0:16:36.41,0:16:37.66,Default,,0,0,0,,Ори?
Dialogue: 0,0:16:37.78,0:16:38.83,Default,,0,0,0,,Иә
Dialogue: 0,0:16:41.70,0:16:45.79,Default,,0,0,0,,Барлығыңыз, маған уақытыңызды беріңіздер.
Dialogue: 0,0:16:45.92,0:16:47.50,Default,,0,0,0,,Каа-самамен кеңесіңіз
Dialogue: 0,0:16:47.88,0:16:51.55,Default,,0,0,0,,Бұл мәселені міндетті түрде шешіңіз
Dialogue: 0,0:16:53.42,0:16:57.18,Default,,0,0,0,,Сонымен Ерен, ауруды шынымен емдеуге болады ма?
Dialogue: 0,0:16:57.60,0:16:59.01,Default,,0,0,0,,Теорияда...
Dialogue: 0,0:16:59.14,0:17:00.22,Default,,0,0,0,,Теорияда?
Dialogue: 0,0:17:00.43,0:17:04.27,Default,,0,0,0,,Барлықтарыңыз, белгілердің пайда болғанына тым көп уақыт өтті.
Dialogue: 0,0:17:04.44,0:17:08.61,Default,,0,0,0,,Егер сізде де өкпе ауруы немесе басқа ауру болса,
Dialogue: 0,0:17:08.73,0:17:11.15,Default,,0,0,0,,Мен оны емдеуге болатынын білмеймін.
Dialogue: 0,0:17:11.28,0:17:12.61,Default,,0,0,0,,Хэйхатсу?
Dialogue: 0,0:17:12.99,0:17:17.11,Default,,0,0,0,,Бірінші аурудан туындаған ауру.
Dialogue: 0,0:17:18.03,0:17:21.20,Default,,0,0,0,,Сіз көптеген қиын нәрселерді білесіз.
Dialogue: 0,0:17:21.74,0:17:23.41,Default,,0,0,0,,Сіз мұны білсеңіз де
Dialogue: 0,0:17:23.54,0:17:26.71,Default,,0,0,0,,Ауруды емдей алмасаң, пайда жоқ
Dialogue: 0,0:17:26.83,0:17:29.67,Default,,0,0,0,,Бірақ мен аламын дедім.
Dialogue: 0,0:17:30.25,0:17:33.38,Default,,0,0,0,,Ендеше менің сізге өтінішім бар.
Dialogue: 0,0:17:33.67,0:17:35.05,Default,,0,0,0,,Маған?
Dialogue: 0,0:17:35.17,0:17:36.09,Default,,0,0,0,,Иә
Dialogue: 0,0:17:36.59,0:17:39.85,Default,,0,0,0,,Мен дәрі жасауды бастаймын.
Dialogue: 0,0:17:39.97,0:17:43.56,Default,,0,0,0,,Күте тұрыңыз! Ерен де солай істей ала ма?
Dialogue: 0,0:17:44.23,0:17:47.85,Default,,0,0,0,,Егер мен өз өкілеттіктерімді пайдаланудың кейбір аспектілерін өзгертсем.
Dialogue: 0,0:17:47.98,0:17:49.77,Default,,0,0,0,,Менің ойымша, бұл мүмкін...
Dialogue: 0,0:17:50.90,0:17:52.73,Default,,0,0,0,,Бірақ сол себепті
Dialogue: 0,0:17:53.03,0:17:57.57,Default,,0,0,0,,Оның адам әлеміне қандай да бір әсер ету мүмкіндігін жоққа шығара алмаймыз.
Dialogue: 0,0:17:57.70,0:17:59.62,Default,,0,0,0,,Оли Сіз қалай ойлайсыз?
Dialogue: 0,0:17:59.74,0:18:01.20,Default,,0,0,0,,Иә.
Dialogue: 0,0:18:02.16,0:18:04.45,Default,,0,0,0,,Еренмен қалағаныңды істеу дұрыс емес пе?
Dialogue: 0,0:18:04.58,0:18:06.25,Default,,0,0,0,,Не? (Махаббат) Эй, эй!
Dialogue: 0,0:18:06.37,0:18:10.46,Default,,0,0,0,,Ерен-чанның әлі де рух ретінде жетілмегені рас.
Dialogue: 0,0:18:11.04,0:18:15.09,Default,,0,0,0,,Бірақ менің күшім бұл әлемге қалай әсер етеді?
Dialogue: 0,0:18:15.21,0:18:17.17,Default,,0,0,0,,Сіз тырыспайынша білмейсіз, солай ма?
Dialogue: 0,0:18:17.30,0:18:18.13,Default,,0,0,0,,Иә!?
Dialogue: 0,0:18:18.26,0:18:20.93,Default,,0,0,0,,Охри! Еренге бірдеңе болса...
Dialogue: 0,0:18:21.05,0:18:22.89,Default,,0,0,0,,О, жарайды.
Dialogue: 0,0:18:23.01,0:18:26.35,Default,,0,0,0,,Төтенше жағдайда адам әлеміне бару керек.
Dialogue: 0,0:18:26.48,0:18:29.10,Default,,0,0,0,,Жоқ! Мүлдем мүмкін емес!
Dialogue: 0,0:18:29.27,0:18:30.98,Default,,0,0,0,,Хе...
Dialogue: 0,0:18:31.15,0:18:34.36,Default,,0,0,0,,Эллен, бұл жақсы зерттеу.
Dialogue: 0,0:18:34.48,0:18:37.57,Default,,0,0,0,,Бәрінің алдында қолыңнан келеді деп айтқан жоқсың ба?
Dialogue: 0,0:18:37.82,0:18:39.99,Default,,0,0,0,,Содан кейін орындаңыз.
Dialogue: 0,0:18:40.11,0:18:41.28,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:41.45,0:18:45.58,Default,,0,0,0,,Дегенмен, сізде қандай да бір қиындық туындаса, бізбен кеңесіңіз.
Dialogue: 0,0:18:45.70,0:18:49.67,Default,,0,0,0,,Ана мен әке, әже мен аға
Dialogue: 0,0:18:49.79,0:18:53.92,Default,,0,0,0,,Жаныңда екенімді ұмытпа
Dialogue: 0,0:18:54.05,0:18:56.46,Default,,0,0,0,,Барлығын сыртқа шығармаңыз
Dialogue: 0,0:18:56.59,0:18:58.13,Default,,0,0,0,,Мен көмектесе алмаймын ...
Dialogue: 0,0:18:58.92,0:19:00.59,Default,,0,0,0,,Уф…
Dialogue: 0,0:19:03.35,0:19:05.89,Default,,0,0,0,,Хмм…
Dialogue: 0,0:19:06.02,0:19:08.77,Default,,0,0,0,,Хмм…
Dialogue: 0,0:19:10.35,0:19:14.73,Default,,0,0,0,,Хмм... Ммм...
Dialogue: 0,0:19:15.44,0:19:16.44,Default,,0,0,0,,Әй!
Dialogue: 0,0:19:16.69,0:19:18.03,Default,,0,0,0,,Охри!
Dialogue: 0,0:19:18.15,0:19:19.70,Default,,0,0,0,,Ерен құлыптаулы
Dialogue: 0,0:19:19.86,0:19:23.74,Default,,0,0,0,,Ол бірнеше күннен бері шықпай жатыр, бірақ оның жағдайы жақсы ма деп ойлаймын!?
Dialogue: 0,0:19:23.87,0:19:25.99,Default,,0,0,0,,Сіз тамақ ішпеген сияқтысыз...
Dialogue: 0,0:19:26.12,0:19:29.54,Default,,0,0,0,,Мен тіпті ұйықтамағаныңызға сенімдімін, мен сенімдімін!
Dialogue: 0,0:19:29.71,0:19:34.13,Default,,0,0,0,,Олар дәрі жасау үшін көп жұмыс істеп жатқан сияқты, сондықтан оларға кедергі жасамаңыз.
Dialogue: 0,0:19:34.29,0:19:35.88,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:19:36.00,0:19:40.47,Default,,0,0,0,,Жарайды. Еренге сеніп күтейік, жарай ма?
Dialogue: 0,0:19:41.30,0:19:44.68,Default,,0,0,0,,А... а...
Dialogue: 0,0:19:44.80,0:19:47.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:48.89,0:19:51.52,Default,,0,0,0,,Хмм... Ванға не болды?
Dialogue: 0,0:19:51.64,0:19:54.06,Default,,0,0,0,,Мен де кірмеуім керек...
Dialogue: 0,0:19:54.19,0:19:56.73,Default,,0,0,0,,Сіз де құлыптаулы болдыңыз ба...
Dialogue: 0,0:19:57.27,0:20:02.24,Default,,0,0,0,,Ерен әрқашан бір нәрсеге батырылған кезде айналаны көре алмайды...
Dialogue: 0,0:20:02.41,0:20:03.74,Default,,0,0,0,,Шынында да…
Dialogue: 0,0:20:03.95,0:20:06.08,Default,,0,0,0,,<Өз рухыңның күші>
Dialogue: 0,0:20:06.20,0:20:09.70,Default,,0,0,0,,<Мен элементтерді өңдеуге күшім бар екенін алғаш білгенімде...>
Dialogue: 0,0:20:11.83,0:20:14.79,Default,,0,0,0,,Кефуккафу…
Dialogue: 0,0:20:14.92,0:20:17.25,Default,,0,0,0,,Уау!? Элен!
Dialogue: 0,0:20:17.67,0:20:22.80,Default,,0,0,0,,<Мен әлі күш қолдану немесе басқару туралы көп білмедім...>
Dialogue: 0,0:20:23.18,0:20:26.47,Default,,0,0,0,,<Бүгінгі ханшайым ол кездегіден бөлек, бірақ...>
Dialogue: 0,0:20:26.60,0:20:28.26,Default,,0,0,0,,Уа, бұл дүрбелең халықты жинап қойған екен…
Dialogue: 0,0:20:28.47,0:20:33.23,Default,,0,0,0,,Ах, бірақ Ори... Бірақ мен уайымдап тұрмын.
Dialogue: 0,0:20:33.35,0:20:35.19,Default,,0,0,0,,Бірақ мен оны ашсам, бұл Ори...
Dialogue: 0,0:20:35.31,0:20:37.57,Default,,0,0,0,,Ой, мен уайымдап тұрмын! Мен уайымдап тұрмын!
Dialogue: 0,0:20:37.73,0:20:40.61,Default,,0,0,0,,Әй, ханшайым! Ханшайым!
Dialogue: 0,0:20:41.11,0:20:43.32,Default,,0,0,0,,А, қазірдің өзінде!
Dialogue: 0,0:20:43.53,0:20:46.03,Default,,0,0,0,,Өзгерту! Ван! Артық керек емес!
Dialogue: 0,0:20:47.32,0:20:48.83,Default,,0,0,0,,Не!?
Dialogue: 0,0:20:48.95,0:20:52.20,Default,,0,0,0,,А, Олли, сен тосқауыл қойдың!?
Dialogue: 0,0:20:53.16,0:20:55.67,Default,,0,0,0,,Мұндай уақыт бірлігі қалай?
Dialogue: 0,0:21:01.30,0:21:03.55,Default,,0,0,0,,<Мен бұрынғы өмірімде білген>
Dialogue: 0,0:21:03.67,0:21:07.22,Default,,0,0,0,,<Әрбір дәрінің құрылымын көрсететін химиялық формула...>
Dialogue: 0,0:21:08.47,0:21:11.18,Default,,0,0,0,,<Есіңізде қалғанша жазыңыз...>
Dialogue: 0,0:21:13.60,0:21:16.40,Default,,0,0,0,,Эллен! Қазірдің өзінде тоқтатыңыз! а!
Dialogue: 0,0:21:24.28,0:21:26.07,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:38.58,0:21:40.80,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:21:41.09,0:21:42.25,Default,,0,0,0,,Эллен!
Dialogue: 0,0:21:43.26,0:21:44.80,Default,,0,0,0,,Ханшайым!
Dialogue: 0,0:21:44.92,0:21:46.72,Default,,0,0,0,,Амансың ба, Ерен?
Dialogue: 0,0:21:47.26,0:21:49.09,Default,,0,0,0,,Дәрілер…
Dialogue: 0,0:21:51.31,0:21:53.97,Default,,0,0,0,,Орындалды...
Dialogue: 0,0:21:54.14,0:21:56.94,Default,,0,0,0,,Ах Ерен...
Dialogue: 0,0:22:00.27,0:22:03.36,Default,,0,0,0,,А, сенде қызба бар!
Dialogue: 0,0:22:05.07,0:22:07.99,Default,,0,0,0,,Бұл орын алғанша...
Dialogue: 0,0:22:10.41,0:22:13.37,Default,,0,0,0,,♪～
Dialogue: 0,0:23:36.70,0:23:39.66,Default,,0,0,0,,～♪
Dialogue: 0,0:23:41.16,0:23:47.16,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory