Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.54,0:00:05.63,Default,,0,0,0,,<Бір жерде Теңбар деген патшалық болған.>
Dialogue: 0,0:00:05.79,0:00:10.13,Default,,0,0,0,,<Ұзақ уақыт соғыс болған жоқ, бәрі бақытты өмір сүрді.>
Dialogue: 0,0:00:10.76,0:00:15.47,Default,,0,0,0,,<Алайда бір күні кенеттен құбыжықтар шыға бастады>
Dialogue: 0,0:00:15.64,0:00:20.18,Default,,0,0,0,,«Сонда патша елдегі ең жақсы рух сиқыршысы болып табылатын жас жігітке айналады».
Dialogue: 0,0:00:20.31,0:00:22.77,Default,,0,0,0,,«Мен құбыжықтарды жоюға бұйрық бердім».
Dialogue: 0,0:00:23.23,0:00:28.65,Default,,0,0,0,,<Алайда мен көптеген құбыжықтар алдында қиын шайқасқа шығуға мәжбүр болдым.>
Dialogue: 0,0:00:28.86,0:00:30.57,Default,,0,0,0,,<Бүкіл денесі жарақат алған жас жігіт>
Dialogue: 0,0:00:30.73,0:00:33.74,Default,,0,0,0,,<"Денеме не болатыны маған бәрібір">
Dialogue: 0,0:00:33.86,0:00:36.78,Default,,0,0,0,,<"Қуатыңызды босатыңыз.">
Dialogue: 0,0:00:36.91,0:00:39.83,Default,,0,0,0,,<Бірге соғысқан аруақтарға өтініш айттым>
Dialogue: 0,0:00:40.33,0:00:44.46,Default,,0,0,0,,<Бұл соңғы рет болар деп ойласам да, рух айтты>
Dialogue: 0,0:00:44.58,0:00:49.17,Default,,0,0,0,,<Мен жігітті ақырын құшақтап: «Түсіндім» дедім де, тілегін орындадым>
Dialogue: 0,0:00:49.34,0:00:54.01,Default,,0,0,0,,<Және әп-сәтте барлық құбыжықтар жойылды>
Dialogue: 0,0:00:54.26,0:00:58.01,Default,,0,0,0,,<Жігіт күші таусылып, құлады>
Dialogue: 0,0:00:58.14,0:00:59.35,Default,,0,0,0,,<"Өлуіме жол берме">
Dialogue: 0,0:01:00.06,0:01:05.06,Default,,0,0,0,,<Оны көз жасыммен айтқан соң мен оны құшақтап, рухани әлемге оралдым>
Dialogue: 0,0:01:05.56,0:01:08.31,Default,,0,0,0,,«Қала толығымен тыныштыққа оралды».
Dialogue: 0,0:01:08.44,0:01:14.44,Default,,0,0,0,,«Жігіт елді дауылдан құтқарған батыр атанды».
Dialogue: 0,0:01:14.61,0:01:18.62,Default,,0,0,0,,«Қанша жыл өтсе де, жігіт оралмады».
Dialogue: 0,0:01:18.78,0:01:23.62,Default,,0,0,0,,«Патшалықтың бәрі батырдың қауіпсіздігі үшін дұға етуді жалғастыруда».
Dialogue: 0,0:01:23.75,0:01:25.58,Default,,0,0,0,,Әй, батырға не болды?
Dialogue: 0,0:01:25.71,0:01:28.54,Default,,0,0,0,,Сіз құтқарылдыңыз, солай ма? Қашан қайтасыз?
Dialogue: 0,0:01:29.25,0:01:31.63,Default,,0,0,0,,Мен үйге баруым керек еді.
Dialogue: 0,0:01:31.75,0:01:32.71,Default,,0,0,0,,(жөтел жөтел)\NМен бұл
Dialogue: 0,0:01:32.88,0:01:34.26,Default,,0,0,0,,Эллен
Dialogue: 0,0:01:34.38,0:01:37.76,Default,,0,0,0,,Әй, кешіріңіз, мен анау екі ет шашлығын аламын ба?
Dialogue: 0,0:01:37.88,0:01:39.60,Default,,0,0,0,,Есік бар
Dialogue: 0,0:01:39.72,0:01:43.43,Default,,0,0,0,,Үйге қанша уақыт бармауды жоспарлайсыз? То-сама
Dialogue: 0,0:01:43.56,0:01:45.43,Default,,0,0,0,,Қашанға дейін?
Dialogue: 0,0:01:45.60,0:01:46.60,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:01:46.73,0:01:49.65,Default,,0,0,0,,Кешіріңіз, екі ет шашлығы (Дүкенші) Эй!
Dialogue: 0,0:01:52.77,0:01:55.44,Default,,0,0,0,,Иә, мистер Ловелл?
Dialogue: 0,0:01:55.57,0:01:56.61,Default,,0,0,0,,Еркін!
Dialogue: 0,0:01:57.32,0:01:58.74,Default,,0,0,0,,Не? Мистер Ловелл?
Dialogue: 0,0:01:58.86,0:01:59.87,Default,,0,0,0,,(Адамдардың шуы)
Dialogue: 0,0:01:59.99,0:02:02.49,Default,,0,0,0,,Уау, бұл қорқынышты! Қашайық, Ерен!
Dialogue: 0,0:02:02.62,0:02:04.75,Default,,0,0,0,,Күтілгендей! (Солдат) Күте тұрыңыз!
Dialogue: 0,0:02:12.00,0:02:13.00,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:02:14.76,0:02:16.47,Default,,0,0,0,,Сіз осындасыз!
Dialogue: 0,0:02:17.22,0:02:18.97,Default,,0,0,0,,Құрметті Ловелл!
Dialogue: 0,0:02:19.13,0:02:21.05,Default,,0,0,0,,Аман болыңыз!
Dialogue: 0,0:02:21.18,0:02:22.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:22.64,0:02:25.43,Default,,0,0,0,,Сонымен үйге келдің.
Dialogue: 0,0:02:25.56,0:02:26.68,Default,,0,0,0,,Біз оның жайлы өте аз білеміз… Бұл не, мырза Ринатаки?
Dialogue: 0,0:02:26.85,0:02:28.19,Default,,0,0,0,,Өте жақсы...
Dialogue: 0,0:02:29.69,0:02:31.44,Default,,0,0,0,,Ха
Dialogue: 0,0:02:31.56,0:02:32.90,Default,,0,0,0,,«Үлкен тұлға» — бұл тамаша ирония.
Dialogue: 0,0:02:33.02,0:02:34.94,Default,,0,0,0,,Неліктен!?
Dialogue: 0,0:02:35.65,0:02:38.61,Default,,0,0,0,,♪～
Dialogue: 0,0:03:59.40,0:04:02.36,Default,,0,0,0,,～♪
Dialogue: 0,0:04:13.71,0:04:15.54,Default,,0,0,0,,Оу! Екінші оқ сәл қалды!
Dialogue: 0,0:04:17.96,0:04:19.55,Default,,0,0,0,,Неге қашып бара жатырсың?
Dialogue: 0,0:04:19.67,0:04:21.84,Default,,0,0,0,,Бір рет үйге бар, солай ма?
Dialogue: 0,0:04:21.97,0:04:23.47,Default,,0,0,0,,Мазасыздық
Dialogue: 0,0:04:24.13,0:04:25.14,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:04:25.43,0:04:29.39,Default,,0,0,0,,Өйткені~ Сіз білмей тұрып, сіз батыр болдыңыз.
Dialogue: 0,0:04:29.51,0:04:30.85,Default,,0,0,0,,Бұл сөзсіз қиыншылық! (Ерен күрсініп)
Dialogue: 0,0:04:31.02,0:04:32.35,Default,,0,0,0,,О, маған ұнамайды.
Dialogue: 0,0:04:32.48,0:04:35.85,Default,,0,0,0,,<Осы кісі осы елді сақтап қалған батыр>
Dialogue: 0,0:04:35.98,0:04:39.15,Default,,0,0,0,,<Менің серіктесім, Ровел ВанКруфт>
Dialogue: 0,0:04:39.32,0:04:42.99,Default,,0,0,0,,<Шынында, ол әңгіменің жалғасы бар...>
Dialogue: 0,0:04:43.24,0:04:45.57,Default,,0,0,0,,<Тусама өз өкілеттігін таусылды>
Dialogue: 0,0:04:45.70,0:04:48.53,Default,,0,0,0,,<Маған бірнеше жыл оянбайтынымды айтты.>
Dialogue: 0,0:04:48.66,0:04:52.95,Default,,0,0,0,,<Менің құдайымның, Рух Патшасының бағышталуымен>
Dialogue: 0,0:04:53.08,0:04:54.83,Default,,0,0,0,,<Шамамен 1 жылдан кейін қалпына келтіру>
Dialogue: 0,0:04:55.04,0:04:56.96,Default,,0,0,0,,＜Олар бір-бірін жақсы көрді＞
Dialogue: 0,0:04:57.08,0:05:01.63,Default,,0,0,0,,<Ант бергеннен кейін Ту-сама жартылай рухқа айналды.>
Dialogue: 0,0:05:01.76,0:05:04.84,Default,,0,0,0,,<Осыған байланысты менің күшім бақыланбайтын болады>
Dialogue: 0,0:05:04.97,0:05:07.39,Default,,0,0,0,,<Біріншіден, рухани әлемде жаттықтыру>
Dialogue: 0,0:05:07.55,0:05:11.22,Default,,0,0,0,,<Бірнеше ай бұрын, күшті адам әлеміне бейімдеу>
Dialogue: 0,0:05:11.35,0:05:12.85,Default,,0,0,0,,<Ол осында келді>
Dialogue: 0,0:05:13.31,0:05:16.90,Default,,0,0,0,,<Мен сондай ана мен әкенің қызымын>
Dialogue: 0,0:05:17.02,0:05:19.19,Default,,0,0,0,,<Мен 8 жыл бұрын туылғанмын>
Dialogue: 0,0:05:19.31,0:05:21.90,Default,,0,0,0,,<Шын мәнінде, мен реинкарнацияланған адаммын...>
Dialogue: 0,0:05:22.19,0:05:26.82,Default,,0,0,0,,<Қайта туылғанға дейін Жапония деген елде ғалым болдым.>
Dialogue: 0,0:05:26.99,0:05:31.99,Default,,0,0,0,,<Заттарды синтездеу, өлшеу, прототиптеу және т.б.; жаңа заттарды іздеу>
Dialogue: 0,0:05:32.12,0:05:35.46,Default,,0,0,0,,<Мен күнімді жаңа материалдарды өңдеумен өткіздім>
Dialogue: 0,0:05:35.58,0:05:40.42,Default,,0,0,0,,<Алайда, неге екені белгісіз, бір күні кенет қайтыс болды>
Dialogue: 0,0:05:41.00,0:05:44.88,Default,,0,0,0,,＜Бір себептермен мен осы дүниеде қайта дүниеге келдім＞
Dialogue: 0,0:05:45.09,0:05:48.72,Default,,0,0,0,,<Мүмкін, менің де өткен өмірімнен естеліктер қалғандықтан шығар>
Dialogue: 0,0:05:48.84,0:05:53.97,Default,,0,0,0,,<Мен 2 жасымда өз күшімді басқара алмай, бірдеңені дұрыс істемедім>
Dialogue: 0,0:05:54.10,0:05:57.48,Default,,0,0,0,,<Сондықтан біз бірге жаттығамыз>
Dialogue: 0,0:05:57.73,0:06:01.69,Default,,0,0,0,,Мен өтпелі кезеңді көрдім, бұдан былай ол одан да қиын болады.
Dialogue: 0,0:06:01.86,0:06:05.03,Default,,0,0,0,,Мен бара алмаймын, себебі Ту-сама хабарласпады.
Dialogue: 0,0:06:05.15,0:06:07.74,Default,,0,0,0,,Неге қайтып келіп сәлем бермейсің?
Dialogue: 0,0:06:07.90,0:06:11.74,Default,,0,0,0,,Сонда сені енді қумайтын шығар.
Dialogue: 0,0:06:11.87,0:06:13.79,Default,,0,0,0,,Мм, құлағым ауырып тұр.
Dialogue: 0,0:06:14.83,0:06:15.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:15.87,0:06:18.83,Default,,0,0,0,,Бұл Мистер Ловелл күткендей болды ма?
Dialogue: 0,0:06:19.00,0:06:19.71,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:20.54,0:06:22.04,Default,,0,0,0,,О, күте тұрыңыз!
Dialogue: 0,0:06:22.21,0:06:24.17,Default,,0,0,0,,Мені тыңдаңыз!
Dialogue: 0,0:06:25.42,0:06:26.30,Default,,0,0,0,,Тосама!
Dialogue: 0,0:06:32.72,0:06:34.60,Default,,0,0,0,,Сіз Тосаманы білесіз бе?
Dialogue: 0,0:06:34.72,0:06:36.06,Default,,0,0,0,,Не? То-сама?
Dialogue: 0,0:06:36.18,0:06:39.52,Default,,0,0,0,,Альберто, менің бұрынғы күзетшім.
Dialogue: 0,0:06:39.64,0:06:43.44,Default,,0,0,0,,Бұл менің қызым! Сүйкімді емес пе? Әлемдегі ең жақсы!
Dialogue: 0,0:06:43.57,0:06:46.69,Default,,0,0,0,,Қараңдар! Оның шашы дәл осындай, жарқыраған күміс!
Dialogue: 0,0:06:46.86,0:06:49.90,Default,,0,0,0,,Көздерің асыл тастай жарқырап тұр!
Dialogue: 0,0:06:50.03,0:06:52.66,Default,,0,0,0,,Керемет емес пе? Эй?
Dialogue: 0,0:06:52.78,0:06:54.12,Default,,0,0,0,,(Кёсукэ Хори) Егер әке кетіп қалса—
Dialogue: 0,0:06:56.08,0:06:58.08,Default,,0,0,0,,ағамды тірідей шағып өлтірдім?
Dialogue: 0,0:06:58.50,0:07:00.71,Default,,0,0,0,,Сонымен не? Әңгіме қандай?
Dialogue: 0,0:07:00.83,0:07:02.63,Default,,0,0,0,,Ванкрефт герцогы
Dialogue: 0,0:07:02.75,0:07:06.67,Default,,0,0,0,,Ал бәріміз Ловелл мырзаның қайтып келуін күттік.
Dialogue: 0,0:07:07.09,0:07:08.59,Default,,0,0,0,,Герцог?
Dialogue: 0,0:07:08.72,0:07:11.05,Default,,0,0,0,,10 жыл бұрын Monster Tempest-те
Dialogue: 0,0:07:11.22,0:07:12.89,Default,,0,0,0,,Ловелл мырзаның күш-жігерінің арқасында
Dialogue: 0,0:07:13.01,0:07:15.10,Default,,0,0,0,,Ванкрефттер отбасының құрдасы жоғарылады.
Dialogue: 0,0:07:15.47,0:07:19.68,Default,,0,0,0,,Қазіргі уақытта менің інім Лорд Саувел отағасы.
Dialogue: 0,0:07:19.81,0:07:22.06,Default,,0,0,0,,Сонда үйге барудың қажеті жоқ.
Dialogue: 0,0:07:22.19,0:07:24.81,Default,,0,0,0,,Жоқ! жоқ! Қайтып оралуыңызды өтінемін!
Dialogue: 0,0:07:24.94,0:07:27.48,Default,,0,0,0,,Неліктен? Бұл қажет болмайды
Dialogue: 0,0:07:28.82,0:07:31.57,Default,,0,0,0,,Негізі әйелім Агиэль ханым...
Dialogue: 0,0:07:31.74,0:07:35.08,Default,,0,0,0,,Не, ханым? Бұл Саувелден келген әйел ме?
Dialogue: 0,0:07:35.24,0:07:36.79,Default,,0,0,0,,Иә? Иә...
Dialogue: 0,0:07:36.95,0:07:39.29,Default,,0,0,0,,Патша бұйрығымен бас тартпаған...
Dialogue: 0,0:07:39.41,0:07:42.83,Default,,0,0,0,,Ол әйел болса мен үйге бармаймын!
Dialogue: 0,0:07:42.96,0:07:44.96,Default,,0,0,0,,Бірақ... (Ловелл) Бұл мүмкін емес!
Dialogue: 0,0:07:45.09,0:07:45.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:46.67,0:07:47.59,Default,,0,0,0,,Тосама!
Dialogue: 0,0:07:48.92,0:07:52.97,Default,,0,0,0,,Мен сіздің жағдайыңызды түсінбеймін, бірақ мен сіз үшін алаңдаймын.
Dialogue: 0,0:07:53.09,0:07:57.18,Default,,0,0,0,,Жүр, үйге барып сәлем беру керек.
Dialogue: 0,0:07:57.35,0:07:58.31,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:58.43,0:08:01.35,Default,,0,0,0,,Отбасын бағаламайтын Ту-самадан көңілім қалды.
Dialogue: 0,0:08:01.89,0:08:02.94,Default,,0,0,0,,Мен оны жек көремін
Dialogue: 0,0:08:03.10,0:08:04.94,Default,,0,0,0,,Мен оны жек көремін!?
Dialogue: 0,0:08:05.06,0:08:08.07,Default,,0,0,0,,Эллен! Түсінікті! Өйткені мен түсінемін! Мен үйге барамын, Ерен!
Dialogue: 0,0:08:08.19,0:08:11.57,Default,,0,0,0,,Өтінемін, мені жек көрме~
Dialogue: 0,0:08:11.70,0:08:13.53,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:08:14.61,0:08:16.66,Default,,0,0,0,,Иә, То-сама!
Dialogue: 0,0:08:20.16,0:08:23.67,Default,,0,0,0,,Ағиэль мырза қандай адам?
Dialogue: 0,0:08:23.79,0:08:26.17,Default,,0,0,0,,Тенбару патшалығының екінші ханшайымы
Dialogue: 0,0:08:27.21,0:08:29.63,Default,,0,0,0,,Менің бұрынғы күйеу жігітім.
Dialogue: 0,0:08:30.01,0:08:31.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:31.46,0:08:35.47,Default,,0,0,0,,Мен сені Ван Круфт отбасына үйлендіретін адаммын.
Dialogue: 0,0:08:35.59,0:08:36.97,Default,,0,0,0,,Алғыс айт!
Dialogue: 0,0:08:37.43,0:08:41.60,Default,,0,0,0,,Бірақ соғысқа барар алдында келісім үзілді.
Dialogue: 0,0:08:41.73,0:08:44.48,Default,,0,0,0,,Өйткені мен оны үйге тірі жеткізе алатынымды білмедім.
Dialogue: 0,0:08:45.60,0:08:49.11,Default,,0,0,0,,Бұл бір жақты Ловелл-саманы алған Агиэль-сама еді...
Dialogue: 0,0:08:49.40,0:08:54.24,Default,,0,0,0,,Лорд Саувель де герцог болғаннан бері көзге түсті.
Dialogue: 0,0:08:56.03,0:08:57.66,Default,,0,0,0,,10 жыл...
Dialogue: 0,0:08:58.66,0:09:01.62,Default,,0,0,0,,Ловелл-саманың рухтар әлеміне кеткеніне 10 жыл болды...
Dialogue: 0,0:09:01.79,0:09:04.50,Default,,0,0,0,,Уақытыңызды қалай өткіздіңіз?
Dialogue: 0,0:09:13.09,0:09:15.63,Default,,0,0,0,,Сонда менің ол әйелден құтылғанымды қалайсың ба?
Dialogue: 0,0:09:15.76,0:09:17.30,Default,,0,0,0,,(Кёсукэ Хори) Егер әке кетіп қалса—
Dialogue: 0,0:09:17.47,0:09:22.64,Default,,0,0,0,,Шындығында, Ванкрефттер отбасы қазір лорд Агиэльдің ысырап етуіне байланысты өртеніп жатыр.
Dialogue: 0,0:09:24.85,0:09:31.65,Default,,0,0,0,,Мен үшін Саувел сол әйелге құрбан болды...
Dialogue: 0,0:09:32.19,0:09:35.86,Default,,0,0,0,,Мен баратын жерімді ауыстырғалы жатырмын. Мен алдымен тоқтайтын жер бар.
Dialogue: 0,0:09:44.08,0:09:46.33,Default,,0,0,0,,Әй
Dialogue: 0,0:09:46.58,0:09:50.67,Default,,0,0,0,,Мынау, мынау, мынау жер не болды?
Dialogue: 0,0:09:51.59,0:09:53.13,Default,,0,0,0,,Ха, мүмкін емес...
Dialogue: 0,0:09:53.42,0:09:55.59,Default,,0,0,0,,Сіз Батыр Ловелл-самасыз ба?
Dialogue: 0,0:09:55.72,0:09:56.76,Default,,0,0,0,,Мен… (Дамиан) Хм. Тек балалар ойыны ғой.
Dialogue: 0,0:09:56.93,0:09:58.89,Default,,0,0,0,,Аа, біраз уақыт болды.
Dialogue: 0,0:09:59.01,0:10:02.22,Default,,0,0,0,,Айтпақшы, мен некемді осы шіркеуге тіркей аламын ба?
Dialogue: 0,0:10:02.35,0:10:03.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:03.39,0:10:07.60,Default,,0,0,0,,Мен формуланы сол жерде бердім, бірақ мен мұнда да дәлелді алғым келді.
Dialogue: 0,0:10:07.73,0:10:09.65,Default,,0,0,0,,Не? Сен маған тұрмысқа шығасың ба?
Dialogue: 0,0:10:09.77,0:10:13.94,Default,,0,0,0,,Иә, мен неке туралы куәлік бере аламын.
Dialogue: 0,0:10:14.07,0:10:14.98,Default,,0,0,0,,Одаққа қатысты оқиғалар немесе байқаулар туралы ешқандай хабар жоқ
Dialogue: 0,0:10:15.11,0:10:17.03,Default,,0,0,0,,Бірақ сіз сенімдісіз бе?
Dialogue: 0,0:10:17.15,0:10:18.82,Default,,0,0,0,,Мистер Ловелл дворян ба?
Dialogue: 0,0:10:19.32,0:10:21.16,Default,,0,0,0,,Король астанасындағы собор емес...
Dialogue: 0,0:10:21.28,0:10:23.91,Default,,0,0,0,,Маған бәрібір. Мен бірден үйленгім келеді.
Dialogue: 0,0:10:24.04,0:10:25.16,Default,,0,0,0,,Бірақ бұл бәрін айқын көрсетті.
Dialogue: 0,0:10:25.29,0:10:27.62,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:10:27.91,0:10:30.88,Default,,0,0,0,,Тото-сама, неліктен кенет той болды?
Dialogue: 0,0:10:31.50,0:10:33.92,Default,,0,0,0,,Сол әйел үйде болғандықтан
Dialogue: 0,0:10:34.05,0:10:35.59,Default,,0,0,0,,Қолымнан келгенін ойнағым келеді.
Dialogue: 0,0:10:36.38,0:10:38.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:44.26,0:10:46.35,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:47.48,0:10:49.44,Default,,0,0,0,,Дайын
Dialogue: 0,0:10:49.60,0:10:52.98,Default,,0,0,0,,Бұл барлығын көретін егіз құдай Вор.
Dialogue: 0,0:10:53.11,0:10:56.28,Default,,0,0,0,,Бұл лорд Ваал үшін некенің дәлелі.
Dialogue: 0,0:10:57.19,0:11:00.15,Default,,0,0,0,,А... иә, сенің серігің кім?
Dialogue: 0,0:11:00.28,0:11:01.74,Default,,0,0,0,,Қазір қоңырау шалыңыз (Әке) Иә?
Dialogue: 0,0:11:01.91,0:11:03.95,Default,,0,0,0,,Ори осында кел.
Dialogue: 0,0:11:04.08,0:11:06.41,Default,,0,0,0,,Осы жерде той жасайық!
Dialogue: 0,0:11:06.54,0:11:09.41,Default,,0,0,0,,Kyaaa~ Rovel~!
Dialogue: 0,0:11:11.17,0:11:15.42,Default,,0,0,0,,Керемет! Адамзат әлемінде той жасай алатынымызға сене алар емеспін!
Dialogue: 0,0:11:16.21,0:11:19.38,Default,,0,0,0,,Бұл әсем емес, бірақ мені кешіресің бе?
Dialogue: 0,0:11:19.51,0:11:22.09,Default,,0,0,0,,Әрине сен!
Dialogue: 0,0:11:24.68,0:11:28.89,Default,,0,0,0,,Уау... Тусама, сен сондай әдемісің!!
Dialogue: 0,0:11:32.73,0:11:34.11,Default,,0,0,0,,О...
Dialogue: 0,0:11:34.23,0:11:35.98,Default,,0,0,0,,Се... Рух!?
Dialogue: 0,0:11:36.15,0:11:40.11,Default,,0,0,0,,Аа, мен қазірдің өзінде жарымжанмын.
Dialogue: 0,0:11:40.24,0:11:43.41,Default,,0,0,0,,Бұл әруақтар арасындағы той, сондықтан еш қиындық жоқ.
Dialogue: 0,0:11:43.57,0:11:46.28,Default,,0,0,0,,Хехе, біраз болды.
Dialogue: 0,0:11:46.78,0:11:47.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:09.97,0:12:11.56,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:12:12.56,0:12:15.86,Default,,0,0,0,,Иә, жақсы күнде де, жаман күнде де.
Dialogue: 0,0:12:15.98,0:12:18.44,Default,,0,0,0,,Сіз бір-біріңізді жақсы көруге уәде бересіз бе?
Dialogue: 0,0:12:18.86,0:12:20.32,Default,,0,0,0,,Ант етемін
Dialogue: 0,0:12:20.44,0:12:21.65,Default,,0,0,0,,Ант етемін
Dialogue: 0,0:12:21.78,0:12:24.57,Default,,0,0,0,,Енді неке туралы куәлікке қол қойыңыз...
Dialogue: 0,0:12:37.13,0:12:39.46,Default,,0,0,0,,Уау...
Dialogue: 0,0:12:41.09,0:12:43.34,Default,,0,0,0,,То-сама! Құрметті Каа! (Origin/Lovell) Иә?
Dialogue: 0,0:12:43.47,0:12:47.39,Default,,0,0,0,,Құттықтаймыз! Екеуің де сол қолдарыңды шығарыңдар.
Dialogue: 0,0:12:47.51,0:12:48.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:56.06,0:12:58.77,Default,,0,0,0,,<Атомдық нөмірі 78...>
Dialogue: 0,0:12:58.90,0:13:00.44,Default,,0,0,0,,<Бұл платина>
Dialogue: 0,0:13:07.32,0:13:10.49,Default,,0,0,0,,Сол қолдың сақина саусағы жүрекпен тікелей байланысқан.
Dialogue: 0,0:13:10.62,0:13:13.45,Default,,0,0,0,,Саусақ жаратылысты білдіреді дейді.
Dialogue: 0,0:13:13.58,0:13:18.42,Default,,0,0,0,,Басқа адамды жүректен қорғайтын махаббат пен бақыт, тілектердің орындалуы...
Dialogue: 0,0:13:18.96,0:13:20.71,Default,,0,0,0,,Саусақтардың мағынасы осындай!
Dialogue: 0,0:13:20.92,0:13:22.84,Default,,0,0,0,,А... әрі қарай...
Dialogue: 0,0:13:23.26,0:13:26.80,Default,,0,0,0,,<Атомдық нөмірі 6 көміртек...>
Dialogue: 0,0:13:30.85,0:13:32.10,Default,,0,0,0,,<Гауһар!!>
Dialogue: 0,0:13:34.60,0:13:37.40,Default,,0,0,0,,Ооо, гауһар...
Dialogue: 0,0:13:37.52,0:13:41.73,Default,,0,0,0,,Мәңгілік байланыс, белгілі бір нәрсе, тазалық пен кінәсіздік...
Dialogue: 0,0:13:41.86,0:13:45.24,Default,,0,0,0,,Гауһар тастар осындай!
Dialogue: 0,0:13:45.36,0:13:48.70,Default,,0,0,0,,Керемет Эллен Чан (Ровел) Ах...
Dialogue: 0,0:13:48.82,0:13:52.41,Default,,0,0,0,,Хехе, күріш душы жоқ...
Dialogue: 0,0:13:52.54,0:13:55.54,Default,,0,0,0,,Екеуіңізге гауһар тас батасын!!
Dialogue: 0,0:13:58.12,0:13:59.33,Default,,0,0,0,,О...
Dialogue: 0,0:14:00.25,0:14:05.21,Default,,0,0,0,,Қызымның осындай керемет батасын алғаныма қуаныштымын.
Dialogue: 0,0:14:05.34,0:14:08.55,Default,,0,0,0,,Иә, сіз
Dialogue: 0,0:14:11.68,0:14:14.97,Default,,0,0,0,,Құдай-ау, бұл...
Dialogue: 0,0:14:15.10,0:14:17.77,Default,,0,0,0,,Вааль әпкесі мен Вааль әпкесі де
Dialogue: 0,0:14:17.89,0:14:20.56,Default,,0,0,0,,Сен маған нығмет сыйладың!
Dialogue: 0,0:14:23.48,0:14:26.99,Default,,0,0,0,,Некеге рұқсат беруді құдай берді.
Dialogue: 0,0:14:27.11,0:14:29.41,Default,,0,0,0,,Екеуің енді ерлі-зайыптысыңдар!!
Dialogue: 0,0:14:30.53,0:14:33.66,Default,,0,0,0,,<Рух ретінде қайта туылғаннан кейінгі қабілеттерім>
Dialogue: 0,0:14:33.79,0:14:38.62,Default,,0,0,0,,<Заттардың комбинациясын және құрылымдық орналасуын қалауынша өзгерте алу>
Dialogue: 0,0:14:38.96,0:14:42.88,Default,,0,0,0,,<Иә! Менің шеберлігім алдау! ＞
Dialogue: 0,0:14:44.92,0:14:47.30,Default,,0,0,0,,Осындай ғажайыпты тудыра білу...
Dialogue: 0,0:14:48.63,0:14:51.47,Default,,0,0,0,,Бұл Ловеллдің баласы...
Dialogue: 0,0:14:55.60,0:14:57.56,Default,,0,0,0,,Бұл діни қызметкерге арналған...
Dialogue: 0,0:14:57.68,0:14:58.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:58.85,0:15:01.52,Default,,0,0,0,,Егер сізде қандай да бір қиындық болса, оны қолданыңыз!
Dialogue: 0,0:15:01.77,0:15:06.78,Default,,0,0,0,,О, тәңірім... Мейірімділігің үшін рахмет!
Dialogue: 0,0:15:06.94,0:15:08.69,Default,,0,0,0,,Хехе
Dialogue: 0,0:15:09.07,0:15:12.87,Default,,0,0,0,,Тосама! Бұл дәл қазір өте керемет болды!
Dialogue: 0,0:15:12.99,0:15:14.16,Default,,0,0,0,,Не? Шынымен!?
Dialogue: 0,0:15:14.33,0:15:16.37,Default,,0,0,0,,Эххе~
Dialogue: 0,0:15:16.66,0:15:18.62,Default,,0,0,0,,Мен қазір Тосама үшін кешірім сұраймын.
Dialogue: 0,0:15:18.75,0:15:19.83,Default,,0,0,0,,Неге!!
Dialogue: 0,0:15:20.00,0:15:23.04,Default,,0,0,0,,Ловелл Мен де ет шашлық жегім келеді.
Dialogue: 0,0:15:23.17,0:15:24.50,Default,,0,0,0,,Не? Мұнда ет шашлығы бар!?
Dialogue: 0,0:15:24.63,0:15:26.34,Default,,0,0,0,,IBN 5100 — ол
Dialogue: 0,0:15:26.46,0:15:27.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:28.46,0:15:31.05,Default,,0,0,0,,Lovell-sama Origin-sama (Lovell/Origin) Иә?
Dialogue: 0,0:15:31.47,0:15:33.85,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:15:33.97,0:15:35.60,Default,,0,0,0,,Альбертоға рахмет
Dialogue: 0,0:15:36.31,0:15:39.81,Default,,0,0,0,,Енді мен ата-анамның үйіне қайтамын.
Dialogue: 0,0:15:39.93,0:15:42.73,Default,,0,0,0,,Ори мен Ерен, рухтар әлеміне оралыңыз.
Dialogue: 0,0:15:42.85,0:15:44.36,Default,,0,0,0,,Бұл жаман емес.
Dialogue: 0,0:15:44.48,0:15:48.03,Default,,0,0,0,,Өйткені ол әйелдің саған не істейтінін білмейсің.
Dialogue: 0,0:15:49.07,0:15:52.74,Default,,0,0,0,,Ал мен сенің ол әйелдің көз алдында болғаныңды қаламаймын.
Dialogue: 0,0:15:52.91,0:15:55.95,Default,,0,0,0,,Мұны су айнасынан көруге болады.
Dialogue: 0,0:15:56.08,0:15:59.66,Default,,0,0,0,,Иә, мен де ол кісіні кездестірсем.
Dialogue: 0,0:15:59.79,0:16:02.83,Default,,0,0,0,,Саған жалынның жанын лақтырғым келеді~
Dialogue: 0,0:16:02.96,0:16:05.71,Default,,0,0,0,,Сіз жау лагеріне қарай бет алған сияқтысыз.
Dialogue: 0,0:16:05.84,0:16:09.30,Default,,0,0,0,,Дұрыс, бұл Тусаманың жауы.
Dialogue: 0,0:16:09.71,0:16:13.13,Default,,0,0,0,,Сонымен қатар, патша әулеті Ереннің бар екенін білсе ше?
Dialogue: 0,0:16:13.26,0:16:15.34,Default,,0,0,0,,Неке тәрбиесін алған болса
Dialogue: 0,0:16:15.47,0:16:17.76,Default,,0,0,0,,Мен өзімді ұстай алмаймын және жабайы кетем.
Dialogue: 0,0:16:18.22,0:16:20.35,Default,,0,0,0,,Менің ойымша, бұл аздап ойлану...
Dialogue: 0,0:16:20.48,0:16:21.39,Default,,0,0,0,,Не айту керек!!
Dialogue: 0,0:16:21.56,0:16:24.10,Default,,0,0,0,,Ерен сондай сүйкімді!!
Dialogue: 0,0:16:24.23,0:16:25.86,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:16:26.15,0:16:29.03,Default,,0,0,0,,Мен сенің не айтып тұрғаныңды түсіндім.
Dialogue: 0,0:16:29.15,0:16:31.19,Default,,0,0,0,,Сәттілік тілеймін.
Dialogue: 0,0:16:34.03,0:16:35.62,Default,,0,0,0,,Рахмет сізге Ори
Dialogue: 0,0:16:38.91,0:16:40.04,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:16:40.16,0:16:41.16,Default,,0,0,0,,Уа!
Dialogue: 0,0:16:41.29,0:16:42.75,Default,,0,0,0,,Түсінгенше көрсетемін
Dialogue: 0,0:16:42.87,0:16:44.50,Default,,0,0,0,,Хмм
Dialogue: 0,0:16:46.04,0:16:49.25,Default,,0,0,0,,О, мен оны жек көремін! Мен оны шынымен жек көремін! Мен оны қатты жек көремін!
Dialogue: 0,0:16:49.38,0:16:52.01,Default,,0,0,0,,Ақыр соңында мен Ори мен Еренмен үйге барамын!
Dialogue: 0,0:16:52.13,0:16:54.43,Default,,0,0,0,,Оны дұрыс шешу керек.
Dialogue: 0,0:16:54.55,0:16:55.84,Default,,0,0,0,,Сәттілік Тосама!
Dialogue: 0,0:16:56.01,0:16:59.35,Default,,0,0,0,,А, бұл дұрыс...
Dialogue: 0,0:16:59.47,0:17:02.31,Default,,0,0,0,,Жынға қалай сенуге болады!!
Dialogue: 0,0:17:02.48,0:17:03.85,Default,,0,0,0,,(Екі күрсіну)
Dialogue: 0,0:17:03.98,0:17:05.02,Default,,0,0,0,,Қазір...
Dialogue: 0,0:17:11.57,0:17:14.28,Default,,0,0,0,,Су айнасымен тамашалайық
Dialogue: 0,0:17:14.40,0:17:16.36,Default,,0,0,0,,Иә, Қасама!
Dialogue: 0,0:17:22.54,0:17:24.66,Default,,0,0,0,,<Маған ұнамағаны таңқаларлық емес...>
Dialogue: 0,0:17:24.79,0:17:28.92,Default,,0,0,0,,<Агиэль-саманың Ловелл-самаға жақындығы шектен тыс еді>
Dialogue: 0,0:17:29.34,0:17:32.80,Default,,0,0,0,,<Ловелл-саманың қалыңдығы болуға мәжбүр болған Агиэль-сама>
Dialogue: 0,0:17:32.92,0:17:36.47,Default,,0,0,0,,<Ол өте мақтаншақ, менмен және ысырапшыл еді.>
Dialogue: 0,0:17:36.59,0:17:39.80,Default,,0,0,0,,<Агиел-саманың құмарлығынан шаршадым.>
Dialogue: 0,0:17:39.93,0:17:43.02,Default,,0,0,0,,<Ловелл-сама жылдар өткен сайын азайып кетті>
Dialogue: 0,0:17:43.35,0:17:47.06,Default,,0,0,0,,<Ал Ловелл-сама 17 жасқа толғанда>
Dialogue: 0,0:17:47.19,0:17:49.61,Default,,0,0,0,,<Монстрлық дауыл болды>
Dialogue: 0,0:17:49.77,0:17:52.23,Default,,0,0,0,,<Себебі мен оны үйге тірі жеткізе алатынымды білмеймін>
Dialogue: 0,0:17:52.36,0:17:56.28,Default,,0,0,0,,<Мырза. Ловелл Агиэль мырзадан келісімді бұзуды сұрады>
Dialogue: 0,0:17:56.45,0:18:01.16,Default,,0,0,0,,<Агиэль-сама ашуланып, патша әулетінің мүшесі ретіндегі жағдайын пайдаланды>
Dialogue: 0,0:18:01.28,0:18:05.00,Default,,0,0,0,,<Мен Ловелл-саманы және әкеңді майдан шебіне жібердім>
Dialogue: 0,0:18:05.41,0:18:09.29,Default,,0,0,0,,Бұдан былай менің рыцарларым құбыжықтарды бағындыру міндетін алады.
Dialogue: 0,0:18:09.42,0:18:10.71,Default,,0,0,0,,Сау болыңыз!
Dialogue: 0,0:18:10.84,0:18:11.96,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:13.13,0:18:14.42,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:18:14.84,0:18:17.01,Default,,0,0,0,,Мен мұны сұрадым, Ловелл.
Dialogue: 0,0:18:18.13,0:18:20.22,Default,,0,0,0,,Әкеге сәттілік...
Dialogue: 0,0:18:21.18,0:18:23.81,Default,,0,0,0,,<Қалғаны сурет кітапшасында айтылғандай>
Dialogue: 0,0:18:24.47,0:18:26.43,Default,,0,0,0,,<Әкең өмірден өтті>
Dialogue: 0,0:18:27.02,0:18:29.94,Default,,0,0,0,,<Ловелл-сама рухтар әлеміне барады...>
Dialogue: 0,0:18:33.86,0:18:37.36,Default,,0,0,0,,<Солай болса да, ол шынымен өзгерді...>
Dialogue: 0,0:18:38.20,0:18:41.32,Default,,0,0,0,,<Мен бұрын мұндай сөз тіркестерін жасайтын адам емес едім>
Dialogue: 0,0:18:42.74,0:18:45.91,Default,,0,0,0,,<Ловелл-сама 10 жыл бұрын бақытынан айырылды>
Dialogue: 0,0:18:46.04,0:18:49.12,Default,,0,0,0,,<Ол рухани әлемде алынған болуы керек...>
Dialogue: 0,0:18:50.17,0:18:51.83,Default,,0,0,0,,<Егер...>
Dialogue: 0,0:18:52.21,0:18:53.46,Default,,0,0,0,,Мистер Ловелл...
Dialogue: 0,0:18:53.59,0:18:54.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:55.46,0:18:58.76,Default,,0,0,0,,Біз өте өкінеміз.
Dialogue: 0,0:19:03.10,0:19:05.47,Default,,0,0,0,,Сіз соғұрлым бұрышта боласыз
Dialogue: 0,0:19:05.60,0:19:09.39,Default,,0,0,0,,Мен түсінемін, ол әйел ойына келгенін істеп жатыр.
Dialogue: 0,0:19:09.52,0:19:14.11,Default,,0,0,0,,Оны 10 жылға жалғыз қалдыруға менің де кінәм бар.
Dialogue: 0,0:19:14.57,0:19:16.44,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:19:21.78,0:19:23.78,Default,,0,0,0,,Бұл жалау! (Халық) Батыр?
Dialogue: 0,0:19:23.91,0:19:27.16,Default,,0,0,0,,Батыр оралды!
Dialogue: 0,0:19:28.04,0:19:29.62,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:29.79,0:19:32.21,Default,,0,0,0,,Батыр қайтып келді?
Dialogue: 0,0:19:32.38,0:19:35.17,Default,,0,0,0,,Дұрыс!! Лавелл-сама қайтып келді!!
Dialogue: 0,0:19:35.42,0:19:38.13,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:19:39.67,0:19:41.30,Default,,0,0,0,,Фу…
Dialogue: 0,0:19:44.43,0:19:48.43,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:19:48.56,0:19:51.39,Default,,0,0,0,,Ловелл мырза! (Азаматтық) Қайтадан қош келдіңіз!
Dialogue: 0,0:20:02.61,0:20:04.49,Default,,0,0,0,,Уау! Мистер Ловелл~!
Dialogue: 0,0:20:08.41,0:20:10.70,Default,,0,0,0,,Ұзақ уақыт бойы болғаным үшін кешіріңіз.
Dialogue: 0,0:20:11.29,0:20:14.25,Default,,0,0,0,,Барлығының денсаулығы жақсы.
Dialogue: 0,0:20:14.38,0:20:18.00,Default,,0,0,0,,Мені осылай қарсы алғаныма өте қуаныштымын!!
Dialogue: 0,0:20:18.13,0:20:21.34,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:20:26.43,0:20:27.89,Default,,0,0,0,,Мистер Ловелл...
Dialogue: 0,0:20:28.01,0:20:30.85,Default,,0,0,0,,Мен сенің қайтуыңды күттім.
Dialogue: 0,0:20:31.18,0:20:33.81,Default,,0,0,0,,Сәттілік, аман болыңыз.
Dialogue: 0,0:20:35.77,0:20:38.44,Default,,0,0,0,,А... Жаңа ғана оралдым.
Dialogue: 0,0:20:38.98,0:20:42.36,Default,,0,0,0,,Саса Тезірек ішке кіріңізші!
Dialogue: 0,0:20:43.36,0:20:45.11,Default,,0,0,0,,Ааа аа!
Dialogue: 0,0:20:45.24,0:20:48.91,Default,,0,0,0,,Ловелл мырзаның үйге оралғаны рас па?
Dialogue: 0,0:20:49.79,0:20:50.91,Default,,0,0,0,,Ухммм… ммм…
Dialogue: 0,0:20:52.79,0:20:54.58,Default,,0,0,0,,(Дауыссыз айқай)
Dialogue: 0,0:20:54.75,0:20:56.54,Default,,0,0,0,,Құрметті Ловелл!
Dialogue: 0,0:21:04.55,0:21:05.68,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:21:06.93,0:21:09.10,Default,,0,0,0,,Леди Саувельдің әйелі...
Dialogue: 0,0:21:11.77,0:21:13.31,Default,,0,0,0,,Бұл Агиэль.
Dialogue: 0,0:21:13.60,0:21:15.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:15.23,0:21:19.40,Default,,0,0,0,,Мен сияқты сен де мүлде өзгерген жоқсың!
Dialogue: 0,0:21:21.48,0:21:24.32,Default,,0,0,0,,Өзінің бастапқы пішінін сақтамайды...
Dialogue: 0,0:21:24.45,0:21:25.45,Default,,0,0,0,,Құрметті Ловелл!
Dialogue: 0,0:21:25.61,0:21:29.12,Default,,0,0,0,,О, қандай керемет...
Dialogue: 0,0:21:29.28,0:21:35.00,Default,,0,0,0,,Әкем мені ініңе күйеуге мәжбүрлегенін ұмыта алмаймын.
Dialogue: 0,0:21:35.12,0:21:39.21,Default,,0,0,0,,Сіз мені алып кетуге келдіңіз!
Dialogue: 0,0:21:39.63,0:21:41.25,Default,,0,0,0,,Не айтып тұрсың!
Dialogue: 0,0:21:43.17,0:21:44.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:46.09,0:21:47.38,Default,,0,0,0,,Каасама Каасама!
Dialogue: 0,0:21:47.51,0:21:49.68,Default,,0,0,0,,Тоқта, тоқта! Құлып өртеніп жатыр!
Dialogue: 0,0:21:50.10,0:21:50.97,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:51.51,0:21:52.77,Default,,0,0,0,,сені бәсекелес деп санайтын Бакуго мен Тодороки емес
Dialogue: 0,0:21:54.35,0:21:57.19,Default,,0,0,0,,Көрдің ғой, Ерен-чан.
Dialogue: 0,0:21:58.77,0:22:01.15,Default,,0,0,0,,Бұл шошқа
Dialogue: 0,0:22:01.36,0:22:04.19,Default,,0,0,0,,Агиел есімді әйел.
Dialogue: 0,0:22:04.49,0:22:09.87,Default,,0,0,0,,Бұл адам Ту-саманың жауы!
Dialogue: 0,0:22:10.45,0:22:13.41,Default,,0,0,0,,♪～
Dialogue: 0,0:23:36.49,0:23:39.46,Default,,0,0,0,,～♪
