Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:32.53,0:00:33.65,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:00:34.74,0:00:36.49,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:01:18.53,0:01:22.95,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:01:34.71,0:01:35.55,Default,,0,0,0,,Әй!
Dialogue: 0,0:01:58.07,0:01:59.11,Default,,0,0,0,,Мусаши!
Dialogue: 0,0:02:00.28,0:02:01.45,Default,,0,0,0,,Ямато
Dialogue: 0,0:02:02.12,0:02:04.99,Default,,0,0,0,,Өйткені сен менің айтқанымды тыңдамайсың
Dialogue: 0,0:02:13.17,0:02:14.25,Default,,0,0,0,,Сонымен
Dialogue: 0,0:02:14.75,0:02:16.67,Default,,0,0,0,,Мен сені суға батырайын
Dialogue: 0,0:02:16.76,0:02:20.43,Default,,0,0,0,,Мен Адмиралтия кодексінің өкілі боламын.
Dialogue: 0,0:02:25.47,0:02:27.18,Default,,0,0,0,,Сіз мұны жалғыз жасай алмайсыз!
Dialogue: 0,0:02:50.54,0:02:53.29,Default,,0,0,0,,Біз бірге болуымыз керек!
Dialogue: 0,0:02:53.96,0:02:56.59,Default,,0,0,0,,Бірақ неге?
Dialogue: 0,0:02:59.30,0:03:00.72,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:03:00.93,0:03:05.81,Default,,0,0,0,,Осы қабылданбайтын сезімдерге қарсы тұру
Dialogue: 0,0:03:06.81,0:03:08.73,Default,,0,0,0,,Бас тарту
Dialogue: 0,0:03:19.28,0:03:20.86,Default,,0,0,0,,Барлығы
Dialogue: 0,0:03:21.28,0:03:22.91,Default,,0,0,0,,Ештеңеге оралу
Dialogue: 0,0:03:23.11,0:03:23.99,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:04:05.70,0:04:07.37,Default,,0,0,0,,Шозо мырза...
Dialogue: 0,0:05:09.85,0:05:11.51,Default,,0,0,0,,Мусаши...
Dialogue: 0,0:05:12.02,0:05:13.81,Default,,0,0,0,,Өлімдік күнәлардың кардиналына тән нәрсе деп айтуға болатын шығар.
Dialogue: 0,0:05:14.56,0:05:15.39,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:46.30,0:05:47.97,Default,,0,0,0,,Ниндзялар Эдо дәуірінде жойылып кеткен жоқ па?
Dialogue: 0,0:06:54.45,0:06:56.87,Default,,0,0,0,,Әке...
Dialogue: 0,0:06:59.33,0:07:03.92,Default,,0,0,0,,Мен Жапонияның Теңіздегі өзін-өзі қорғау күштерінің бұрынғы екінші лейтенантымын
Dialogue: 0,0:07:04.00,0:07:05.80,Default,,0,0,0,,Чихая Шо мүсіні
Dialogue: 0,0:07:05.88,0:07:08.01,Default,,0,0,0,,Тұман флотының адмиралы
Dialogue: 0,0:07:08.26,0:07:09.55,Default,,0,0,0,,Ха...
Dialogue: 0,0:07:09.97,0:07:11.34,Default,,0,0,0,,Супер шайқас!
Dialogue: 0,0:07:12.22,0:07:13.59,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:14.05,0:07:15.81,Default,,0,0,0,,Барлық адамдар
Dialogue: 0,0:07:15.89,0:07:18.35,Default,,0,0,0,,Кеш болмай тұрып тыңдауларыңызды қалаймын.
Dialogue: 0,0:07:18.98,0:07:20.85,Default,,0,0,0,,Біз, тұман флоты,
Dialogue: 0,0:07:20.94,0:07:24.36,Default,,0,0,0,,Адамзатты, осы планетаның ісік жасушаларын қалпына келтіріңіз.
Dialogue: 0,0:07:24.48,0:07:29.99,Default,,0,0,0,,Бұл бізді барлық тіршілік иелерімен тепе-теңдікті сақтауға бағыттайтын тазарту механизмі.
Dialogue: 0,0:07:30.15,0:07:32.70,Default,,0,0,0,,Адамзаттың жетілмегендігі сонша
Dialogue: 0,0:07:32.78,0:07:36.74,Default,,0,0,0,,Гармонияға айтарлықтай зиян келтірілді және қайта қарастырылмайды
Dialogue: 0,0:07:37.24,0:07:40.71,Default,,0,0,0,,Біз, Тұман флоты, теңіз блокадасын орнаттық.
Dialogue: 0,0:07:40.79,0:07:43.25,Default,,0,0,0,,Мен адамзатқа ескерту жасадым.
Dialogue: 0,0:07:43.42,0:07:45.46,Default,,0,0,0,,Сіз тек шатасасыз.
Dialogue: 0,0:07:45.54,0:07:48.80,Default,,0,0,0,,Түрді жақсартуға тырысудың белгілері жоқ.
Dialogue: 0,0:07:49.09,0:07:51.80,Default,,0,0,0,,Сондықтан біз адамзаттың еркіндігін тілейміз.
Dialogue: 0,0:07:52.05,0:07:55.26,Default,,0,0,0,,Шектеулерді енгізу керек деп шешілді.
Dialogue: 0,0:07:56.05,0:07:57.18,Default,,0,0,0,,Мырзалар
Dialogue: 0,0:07:57.26,0:07:59.43,Default,,0,0,0,,Теңдесі жоқ тыныштық пен тәртіппен мақтанады
Dialogue: 0,0:07:59.52,0:08:01.73,Default,,0,0,0,,Тұман флотын басқаруды қабылдаңыз
Dialogue: 0,0:08:02.27,0:08:05.27,Default,,0,0,0,,Біз түрлердің жолдарын қолдануымыз керек.
Dialogue: 0,0:08:05.65,0:08:09.28,Default,,0,0,0,,Басқаша айтқанда, толығымен берілу!
Dialogue: 0,0:08:09.69,0:08:12.24,Default,,0,0,0,,Қарусызданғаннан кейін адамзат
Dialogue: 0,0:08:12.32,0:08:14.20,Default,,0,0,0,,Мемлекетті бөлшектеңіз
Dialogue: 0,0:08:14.28,0:08:18.37,Default,,0,0,0,,Бұдан былай тек тұман бақылауында ғана өмір сүруге рұқсат етіледі.
Dialogue: 0,0:08:19.16,0:08:21.66,Default,,0,0,0,,Бұл Адмиралтейт кодексіне байланысты.
Dialogue: 0,0:08:21.75,0:08:26.29,Default,,0,0,0,,Түрді сақтаудың ең дұрыс таңдауы
Dialogue: 0,0:08:28.54,0:08:30.34,Default,,0,0,0,,Қарау үшін жеңілдік кезеңі
Dialogue: 0,0:08:30.42,0:08:32.84,Default,,0,0,0,,Ағымдағы уақыттан бастап бір апта
Dialogue: 0,0:08:32.92,0:08:35.30,Default,,0,0,0,,Маған жақсы жауап беріңізші.
Dialogue: 0,0:08:56.24,0:08:57.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:57.70,0:08:58.87,Default,,0,0,0,,Топтық сурет?
Dialogue: 0,0:08:59.83,0:09:00.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:02.33,0:09:03.87,Default,,0,0,0,,Осылайша, қарындас мектептер арасындағы алмасу шарасы—
Dialogue: 0,0:09:03.96,0:09:06.29,Default,,0,0,0,,Мақсаты өзгерген жоқ.
Dialogue: 0,0:09:06.46,0:09:10.34,Default,,0,0,0,,Оларға жоспарланғандай ғана жетіңіз.
Dialogue: 0,0:09:10.84,0:09:12.38,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:09:12.46,0:09:14.26,Default,,0,0,0,,Әкем маған опасыздық жасады
Dialogue: 0,0:09:14.59,0:09:17.18,Default,,0,0,0,,Неліктен тұман екенін мен де түсіндім.
Dialogue: 0,0:09:20.39,0:09:21.76,Default,,0,0,0,,Соңында
Dialogue: 0,0:09:22.06,0:09:23.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:27.06,0:09:28.27,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:09:29.15,0:09:29.98,Default,,0,0,0,,Гунзо!
Dialogue: 0,0:09:30.06,0:09:31.94,Default,,0,0,0,,Мен сенің кемеңмін
Dialogue: 0,0:09:33.78,0:09:36.53,Default,,0,0,0,,Барғыңыз келетін жерге бару
Dialogue: 0,0:09:36.61,0:09:37.95,Default,,0,0,0,,Менің...
Dialogue: 0,0:09:38.16,0:09:38.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:39.07,0:09:41.37,Default,,0,0,0,,Менің миссиям?
Dialogue: 0,0:09:41.45,0:09:42.87,Default,,0,0,0,,Қалайсыз ба?
Dialogue: 0,0:09:42.95,0:09:44.04,Default,,0,0,0,,Бақыттысың ба?
Dialogue: 0,0:09:44.12,0:09:45.41,Default,,0,0,0,,Хехе
Dialogue: 0,0:09:45.62,0:09:47.96,Default,,0,0,0,,Иона рахмет
Dialogue: 0,0:09:48.04,0:09:48.96,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:49.04,0:09:51.96,Default,,0,0,0,,Білмеймін, бірақ жарайсың.
Dialogue: 0,0:09:52.25,0:09:53.42,Default,,0,0,0,,Хехе
Dialogue: 0,0:09:59.01,0:10:01.39,Default,,0,0,0,,Капитан, мен көптен күттім.
Dialogue: 0,0:10:01.64,0:10:02.47,Default,,0,0,0,,Бұйрық
Dialogue: 0,0:10:02.68,0:10:03.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:05.73,0:10:07.52,Default,,0,0,0,,Баратын жер өзгеріссіз қалады
Dialogue: 0,0:10:07.60,0:10:09.52,Default,,0,0,0,,Біз тұманның флагманымыз
Dialogue: 0,0:10:09.60,0:10:11.31,Default,,0,0,0,,Ямато-ға хабарласыңыз
Dialogue: 0,0:10:11.40,0:10:12.57,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:10:12.86,0:10:14.32,Default,,0,0,0,,Бірақ бұған дейін
Dialogue: 0,0:10:14.61,0:10:15.86,Default,,0,0,0,,Маған Ионаны түзету керек.
Dialogue: 0,0:10:16.65,0:10:18.07,Default,,0,0,0,,Не істеуім керек?
Dialogue: 0,0:10:18.15,0:10:19.91,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:10:20.99,0:10:24.29,Default,,0,0,0,,Наноматериалдарды қалай толтыруға болады~
Dialogue: 0,0:10:24.74,0:10:26.91,Default,,0,0,0,,Ешкімге айтқым келмеді.
Dialogue: 0,0:10:27.00,0:10:29.71,Default,,0,0,0,,Иә? Кемені жөндеудің жолы бар ма?
Dialogue: 0,0:10:29.79,0:10:31.50,Default,,0,0,0,,Мм! Хмм!
Dialogue: 0,0:10:32.96,0:10:34.96,Default,,0,0,0,,Окиноторисима
Dialogue: 0,0:10:35.05,0:10:38.13,Default,,0,0,0,,Сонда олар наноматериалдарды сонда жасырған?
Dialogue: 0,0:10:38.51,0:10:41.97,Default,,0,0,0,,Бұл шынымен де әңгіменің соңы.
Dialogue: 0,0:10:42.05,0:10:43.18,Default,,0,0,0,,Және бумен пісірілген тәтті картоп.
Dialogue: 0,0:10:43.26,0:10:45.22,Default,,0,0,0,,Козыр жоқ.
Dialogue: 0,0:10:45.31,0:10:47.27,Default,,0,0,0,,Осы екеуінің қайсысы екенін сұрап тұрмын. Сен бе?
Dialogue: 0,0:10:47.64,0:10:50.81,Default,,0,0,0,,Мүлдем... өте сенімді.
Dialogue: 0,0:10:50.90,0:10:53.02,Default,,0,0,0,,Уф... аа~?
Dialogue: 0,0:10:54.40,0:10:56.57,Default,,0,0,0,,Менің кемем болса ғой...
Dialogue: 0,0:10:56.65,0:10:57.65,Default,,0,0,0,,Такао!
Dialogue: 0,0:10:58.49,0:11:01.11,Default,,0,0,0,,Менің сізден сұрайын дегенім бар.
Dialogue: 0,0:11:01.66,0:11:02.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:03.91,0:11:06.79,Default,,0,0,0,,
Dialogue: 0,0:11:17.84,0:11:18.67,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:19.59,0:11:21.47,Default,,0,0,0,,Кірейік!
Dialogue: 0,0:11:25.81,0:11:27.64,Default,,0,0,0,,Ашигара Кнок ше?
Dialogue: 0,0:11:27.72,0:11:29.14,Default,,0,0,0,,Ах! Кешіріңіз, кешіріңіз!
Dialogue: 0,0:11:29.23,0:11:30.10,Default,,0,0,0,,Конкорн!
Dialogue: 0,0:11:35.82,0:11:38.07,Default,,0,0,0,,Студенттік кеңестің төрағасы осында.
Dialogue: 0,0:11:38.44,0:11:39.36,Default,,0,0,0,,Иә
Dialogue: 0,0:11:39.94,0:11:42.24,Default,,0,0,0,,Олай болса, 64-ші
Dialogue: 0,0:11:42.32,0:11:45.62,Default,,0,0,0,,Тұман студенттер кеңесінің жалпы жиналысы басталады
Dialogue: 0,0:11:48.45,0:11:49.75,Default,,0,0,0,,Я~
Dialogue: 0,0:11:49.83,0:11:53.04,Default,,0,0,0,,Төраға Мусашиге берілген айна жүйесі.
Dialogue: 0,0:11:53.12,0:11:55.00,Default,,0,0,0,,Мен оны қолдандым.
Dialogue: 0,0:11:55.33,0:11:57.17,Default,,0,0,0,,Жаса! 401!
Dialogue: 0,0:11:57.25,0:11:59.17,Default,,0,0,0,,Мен оны ұшырып жіберемін!
Dialogue: 0,0:11:59.63,0:12:03.09,Default,,0,0,0,,Ойды ластау мысалы сізге ұнады ма?
Dialogue: 0,0:12:03.76,0:12:04.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:04.93,0:12:06.05,Default,,0,0,0,,Иә...
Dialogue: 0,0:12:06.14,0:12:09.14,Default,,0,0,0,,Конгоны есінен шығарған да осы емес пе?
Dialogue: 0,0:12:09.22,0:12:11.93,Default,,0,0,0,,Сәлем! Сіз жоқсыз ба?
Dialogue: 0,0:12:12.02,0:12:12.85,Default,,0,0,0,,Иә
Dialogue: 0,0:12:13.73,0:12:18.23,Default,,0,0,0,,Төрағаның техникалық қызмет көрсетуге және керек-жарақтарға біраз уақыт бөлгені дұрыс емес пе?
Dialogue: 0,0:12:18.57,0:12:20.69,Default,,0,0,0,,Қолдау кемесіне қоңырау шалғыңыз келе ме?
Dialogue: 0,0:12:20.78,0:12:22.24,Default,,0,0,0,,Акаши т.б.
Dialogue: 0,0:12:22.32,0:12:26.95,Default,,0,0,0,,Сүңгуір қайық ешқашан жауынгерлік кеменің есептеу қабілетінен асып түспейді.
Dialogue: 0,0:12:27.03,0:12:28.62,Default,,0,0,0,,Мәселе жоқ
Dialogue: 0,0:12:28.70,0:12:30.04,Default,,0,0,0,,Сенің балаң атақты Эден мектебіне қабылданғанын ойласаңшы!
Dialogue: 0,0:12:30.20,0:12:32.75,Default,,0,0,0,,Менің ойымша, Конго да солай айтты.
Dialogue: 0,0:12:33.50,0:12:34.67,Default,,0,0,0,,...
Dialogue: 0,0:12:34.75,0:12:37.21,Default,,0,0,0,,Басынан қате болды.
Dialogue: 0,0:12:37.50,0:12:38.79,Default,,0,0,0,,Мен емес
Dialogue: 0,0:12:38.88,0:12:40.17,Default,,0,0,0,,Біраз уақыт өтті!
Dialogue: 0,0:12:40.25,0:12:42.76,Default,,0,0,0,,Хии ешқашан қателескен емес!
Dialogue: 0,0:12:43.01,0:12:45.80,Default,,0,0,0,,Ашығара қателікке толы, солай емес пе?
Dialogue: 0,0:12:46.01,0:12:48.18,Default,,0,0,0,,Бұл ұрыс тәжірибесі ұпайларына арналған!
Dialogue: 0,0:12:48.26,0:12:50.26,Default,,0,0,0,,Ах! Мен оны бастан өткердім!
Dialogue: 0,0:12:51.02,0:12:52.14,Default,,0,0,0,,Мен онымен екеуміз ғана, бір рет болса да сөйлескенді қатты қалаймын. Хехе.
Dialogue: 0,0:12:52.22,0:12:53.77,Default,,0,0,0,,Болашақ стратегиясы
Dialogue: 0,0:12:54.06,0:12:56.35,Default,,0,0,0,,Иә, өзгерістер жоқ
Dialogue: 0,0:12:56.44,0:13:00.94,Default,,0,0,0,,Біз, Тұман студенттер кеңесі, адамзат бас игенше жеңілдік кезеңінде тұрмыз.
Dialogue: 0,0:13:01.03,0:13:04.24,Default,,0,0,0,,Блок 401 партизандық күш ретіндегі әрекеттері
Dialogue: 0,0:13:04.32,0:13:05.78,Default,,0,0,0,,Бұл берілу туралы ұсыныс па?
Dialogue: 0,0:13:06.53,0:13:10.53,Default,,0,0,0,,Адмиралтия кодексі де қатаң бұйрық шығарды.
Dialogue: 0,0:13:11.24,0:13:12.08,Default,,0,0,0,,Аа...
Dialogue: 0,0:13:12.29,0:13:13.83,Default,,0,0,0,,Бұдан былай біз
Dialogue: 0,0:13:13.91,0:13:16.87,Default,,0,0,0,,Сіз оларға қамқорлық жасаңыз дейсіз бе?
Dialogue: 0,0:13:16.96,0:13:18.96,Default,,0,0,0,,Уге~
Dialogue: 0,0:13:19.38,0:13:21.71,Default,,0,0,0,,Мұсаши не ойлайды?
Dialogue: 0,0:13:21.80,0:13:23.55,Default,,0,0,0,,Тек бұйрықтарды орындаңыз
Dialogue: 0,0:13:23.63,0:13:25.97,Default,,0,0,0,,Бұл біз, тұман.
Dialogue: 0,0:13:26.13,0:13:27.38,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:27.80,0:13:28.68,Default,,0,0,0,,Ах, бірақ
Dialogue: 0,0:13:28.76,0:13:31.35,Default,,0,0,0,,Сонда соғыс жағдайы біте ме?
Dialogue: 0,0:13:31.43,0:13:32.93,Default,,0,0,0,,Қызық емес пе?
Dialogue: 0,0:13:33.02,0:13:35.14,Default,,0,0,0,,Егер сен шынымен берілсең~
Dialogue: 0,0:13:35.23,0:13:36.06,Default,,0,0,0,,Әй?
Dialogue: 0,0:13:36.44,0:13:39.19,Default,,0,0,0,,Адамдар қиыншылық тудырады, солай емес пе?
Dialogue: 0,0:13:39.27,0:13:41.32,Default,,0,0,0,,Бұйрық тізбегі ажыратылған.
Dialogue: 0,0:13:41.40,0:13:44.44,Default,,0,0,0,,Ең жақсы қимылды білсеңіз де, оны жасамас едіңіз, солай ма?
Dialogue: 0,0:13:44.53,0:13:45.57,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:13:46.07,0:13:47.45,Default,,0,0,0,,Ах~
Dialogue: 0,0:13:47.53,0:13:49.99,Default,,0,0,0,,Керісінше, соғыс жағдайы басталғалы тұр.
Dialogue: 0,0:13:50.07,0:13:50.99,Default,,0,0,0,,Ахх!
Dialogue: 0,0:13:51.08,0:13:52.58,Default,,0,0,0,,Қарсылық жоқ.
Dialogue: 0,0:13:52.66,0:13:54.16,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:13:54.25,0:13:58.00,Default,,0,0,0,,Әу баста ниет болған жоқ.
Dialogue: 0,0:13:58.21,0:14:01.09,Default,,0,0,0,,Мұндай кездесудің мәні бар ма?
Dialogue: 0,0:14:01.38,0:14:02.63,Default,,0,0,0,,Бұл пікірталас.
Dialogue: 0,0:14:02.71,0:14:04.38,Default,,0,0,0,,Кеңес арқылы
Dialogue: 0,0:14:04.46,0:14:06.97,Default,,0,0,0,,Біз дәлдігі жоғары кездесуді іздейміз.
Dialogue: 0,0:14:07.34,0:14:09.30,Default,,0,0,0,,Сен мені мазақ етіп тұрсың!
Dialogue: 0,0:14:09.39,0:14:11.64,Default,,0,0,0,,Бұл жаман нәрсе.
Dialogue: 0,0:14:15.22,0:14:17.73,Default,,0,0,0,,Тұманның өнегесі – жердің өнегесі.
Dialogue: 0,0:14:17.98,0:14:20.73,Default,,0,0,0,,Тұманның өнегесі – жердің өнегесі!
Dialogue: 0,0:14:22.69,0:14:23.77,Default,,0,0,0,,Таратылды!
Dialogue: 0,0:14:24.90,0:14:25.94,Default,,0,0,0,,Бұл осында ма?
Dialogue: 0,0:14:26.03,0:14:27.32,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,0:15:01.73,0:15:02.94,Default,,0,0,0,,Мусаши!
Dialogue: 0,0:15:03.61,0:15:05.90,Default,,0,0,0,,Мен кемеге отыруға рұқсат аламын ба?
Dialogue: 0,0:15:10.32,0:15:11.28,Default,,0,0,0,,Фу…
Dialogue: 0,0:15:27.84,0:15:31.22,Default,,0,0,0,,Конгоу үшін әлі де алаңдайсыз ба?
Dialogue: 0,0:15:31.30,0:15:32.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:32.93,0:15:35.39,Default,,0,0,0,,Сіз қайдан білесіз?
Dialogue: 0,0:15:35.47,0:15:36.76,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:15:39.14,0:15:40.35,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:15:40.52,0:15:43.94,Default,,0,0,0,,Конгода осындай нәрсе болды ма?
Dialogue: 0,0:15:47.02,0:15:48.78,Default,,0,0,0,,Мейірімді бала
Dialogue: 0,0:15:49.40,0:15:52.20,Default,,0,0,0,,Сізге уайымдаудың қажеті жоқ.
Dialogue: 0,0:15:53.28,0:15:55.53,Default,,0,0,0,,Ол жаңа ғана сынған
Dialogue: 0,0:15:57.58,0:15:58.95,Default,,0,0,0,,Конго кез келген басқа кемеден артық.
Dialogue: 0,0:15:59.04,0:16:02.41,Default,,0,0,0,,Адмиралтейлік кодекске адал болуға тырысты
Dialogue: 0,0:16:03.29,0:16:06.09,Default,,0,0,0,,Адмиралтейлік кодекс дегеніміз не?
Dialogue: 0,0:16:06.50,0:16:10.51,Default,,0,0,0,,Тіпті жауынгерлік сыныпта да біз тікелей тапсырыс алмаймыз.
Dialogue: 0,0:16:11.13,0:16:12.34,Default,,0,0,0,,Сіз
Dialogue: 0,0:16:12.42,0:16:14.05,Default,,0,0,0,,Тек екі супер шайқас сыныбында кеме...
Dialogue: 0,0:16:14.18,0:16:15.47,Default,,0,0,0,,...
Dialogue: 0,0:16:15.93,0:16:19.93,Default,,0,0,0,,401 нөмірімен байланыста қате бар.
Dialogue: 0,0:16:21.31,0:16:24.48,Default,,0,0,0,,Мен қолымнан келмейтін ұғымды қозғадым.
Dialogue: 0,0:16:25.56,0:16:27.06,Default,,0,0,0,,Адамзат дейді
Dialogue: 0,0:16:27.31,0:16:29.69,Default,,0,0,0,,Бақыт дегеніміз не?
Dialogue: 0,0:16:30.82,0:16:35.03,Default,,0,0,0,,Бұл мүмкін емес болашаққа қарсы нәтижелі ұшу.
Dialogue: 0,0:16:35.11,0:16:35.95,Default,,0,0,0,,Қашу?
Dialogue: 0,0:16:36.53,0:16:38.24,Default,,0,0,0,,Адамның ойлауы
Dialogue: 0,0:16:38.33,0:16:41.45,Default,,0,0,0,,Бұл сіздің гонг іздеуге тым жетілмегеніңізді білдіреді.
Dialogue: 0,0:16:44.16,0:16:48.50,Default,,0,0,0,,Бастапқыда бізде жеке адамдар туралы түсінік болған жоқ.
Dialogue: 0,0:16:48.59,0:16:50.96,Default,,0,0,0,,Біз тұман флотымыз
Dialogue: 0,0:16:51.13,0:16:53.88,Default,,0,0,0,,Барлығы анықталған және анықталған.
Dialogue: 0,0:16:54.68,0:16:57.18,Default,,0,0,0,,Батып кетсең де
Dialogue: 0,0:16:57.26,0:16:59.26,Default,,0,0,0,,Тұман әлі де тұман
Dialogue: 0,0:16:59.97,0:17:02.22,Default,,0,0,0,,Ештеңе мәңгілік өзгермейді
Dialogue: 0,0:17:02.31,0:17:03.89,Default,,0,0,0,,Енді Л тергеу мәліметтерінің маған тарағанын түсінгеннен кейін,
Dialogue: 0,0:17:05.44,0:17:06.90,Default,,0,0,0,,Барлық оқтарыңды жауға беріңдер!!
Dialogue: 0,0:17:07.06,0:17:09.15,Default,,0,0,0,,Қазірдің өзінде бақытты
Dialogue: 0,0:17:09.44,0:17:10.61,Default,,0,0,0,,Ха...
Dialogue: 0,0:17:23.83,0:17:25.87,Default,,0,0,0,,(Сабанды сорған дыбыс)
Dialogue: 0,0:17:31.88,0:17:34.76,Default,,0,0,0,,Ммм♪
Dialogue: 0,0:17:47.77,0:17:49.40,Default,,0,0,0,,Сіз қалай ойлайсыз? Иори
Dialogue: 0,0:17:49.48,0:17:50.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:50.48,0:17:52.57,Default,,0,0,0,,Әйтеуір, нүктеге дейін ұстаңыз.
Dialogue: 0,0:17:52.94,0:17:54.49,Default,,0,0,0,,Жағдай нашар болса да
Dialogue: 0,0:17:54.57,0:17:56.74,Default,,0,0,0,,Ал, мұны сізге қалдыратын кез келді.
Dialogue: 0,0:17:57.07,0:18:00.70,Default,,0,0,0,,Бұдан да қиын жағдайлар бұрын болған жоқ па?
Dialogue: 0,0:18:00.95,0:18:03.33,Default,,0,0,0,,Жақсы жұмыс, мен бүгінге дейін аман қалдым.
Dialogue: 0,0:18:03.41,0:18:06.66,Default,,0,0,0,,Капитан Гунзо Чихая және оның көңілді достары!
Dialogue: 0,0:18:06.96,0:18:08.17,Default,,0,0,0,,Мен ризамын
Dialogue: 0,0:18:08.25,0:18:10.25,Default,,0,0,0,,Тоқта, сасық!
Dialogue: 0,0:18:10.46,0:18:13.46,Default,,0,0,0,,Иори, оны түзете алмағаным үшін кешіріңіз.
Dialogue: 0,0:18:14.55,0:18:15.38,Default,,0,0,0,,Жолдан кет! Эй!
Dialogue: 0,0:18:15.46,0:18:17.34,Default,,0,0,0,,Бұл Ионаның кінәсі емес, солай ма?
Dialogue: 0,0:18:18.05,0:18:21.01,Default,,0,0,0,,Біз командамыз, өйткені біз бір-бірімізді жабамыз.
Dialogue: 0,0:18:21.39,0:18:22.72,Default,,0,0,0,,Команда…
Dialogue: 0,0:18:23.06,0:18:26.39,Default,,0,0,0,,Жарайды, қазір ғана үзіліс жасаңыз!
Dialogue: 0,0:18:26.48,0:18:28.98,Default,,0,0,0,,Қозғалтқыштың жұмыс істеп тұрғанына көз жеткізіңіз!
Dialogue: 0,0:18:29.69,0:18:31.61,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:18:31.69,0:18:32.52,Default,,0,0,0,,О!
Dialogue: 0,0:18:32.61,0:18:33.44,Default,,0,0,0,,Гунзо да!
Dialogue: 0,0:18:33.77,0:18:36.07,Default,,0,0,0,,Аа... шектен шықпаңыз, капитан.
Dialogue: 0,0:18:36.78,0:18:39.57,Default,,0,0,0,,Сіз жалғыз күресіп жатқан жоқсыз.
Dialogue: 0,0:18:41.24,0:18:42.32,Default,,0,0,0,,О
Dialogue: 0,0:18:45.87,0:18:46.95,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:18:47.04,0:18:49.75,Default,,0,0,0,,Келіңіздер! Барлығыңыз, өз посттарыңызға оралыңыз!
Dialogue: 0,0:19:11.19,0:19:12.35,Default,,0,0,0,,Нацис!
Dialogue: 0,0:19:23.70,0:19:25.74,Default,,0,0,0,,Тыныш бол Ашығара
Dialogue: 0,0:19:25.83,0:19:27.87,Default,,0,0,0,,Жаңғырық бұзылған.
Dialogue: 0,0:19:29.00,0:19:30.79,Default,,0,0,0,,Осы шу деңгейімен
Dialogue: 0,0:19:30.87,0:19:33.58,Default,,0,0,0,,Құлағыңыз саңырау болмайды!
Dialogue: 0,0:19:34.17,0:19:35.67,Default,,0,0,0,,Өтінемін, Наци!
Dialogue: 0,0:19:35.75,0:19:39.80,Default,,0,0,0,,Мен Мёко мен басқалардан бұрын 401-ді міндетті түрде табамын!
Dialogue: 0,0:19:41.43,0:19:42.80,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:20:03.57,0:20:07.53,Default,,0,0,0,,Оңтүстік-оңтүстік-батыс бағытта әлсіз гравитондық реакция анықталды
Dialogue: 0,0:20:07.62,0:20:09.58,Default,,0,0,0,,Деректер базасын тексеру
Dialogue: 0,0:20:10.75,0:20:12.75,Default,,0,0,0,,401-пен расталған
Dialogue: 0,0:20:13.42,0:20:14.46,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:14.54,0:20:16.17,Default,,0,0,0,,Біз бақыттымыз!
Dialogue: 0,0:20:16.79,0:20:19.84,Default,,0,0,0,,Менің жолым жоқ деп ойлаймын.
Dialogue: 0,0:20:19.92,0:20:23.05,Default,,0,0,0,,Сен сияқты шулы қызбен жұптасып...
Dialogue: 0,0:20:23.43,0:20:26.35,Default,,0,0,0,,Ең алдымен Миоко мен Хагуромен байланысыңыз.
Dialogue: 0,0:20:26.43,0:20:27.85,Default,,0,0,0,,Бәріміз бірге жеңіске жетейік
Dialogue: 0,0:20:28.14,0:20:31.48,Default,,0,0,0,,Жақсы! Бізге жетеді!
Dialogue: 0,0:20:31.56,0:20:34.10,Default,,0,0,0,,Мен оны сізбен бір рет байқап көргім келді!
Dialogue: 0,0:20:34.19,0:20:35.94,Default,,0,0,0,,401!
Dialogue: 0,0:20:50.08,0:20:51.33,Default,,0,0,0,,Сәлем! Ашигара?
Dialogue: 0,0:20:52.45,0:20:55.54,Default,,0,0,0,,Букубуку…
Dialogue: 0,0:20:55.62,0:20:59.42,Default,,0,0,0,,Мен оны міндетті түрде атып тастаймын!
Dialogue: 0,0:21:00.00,0:21:02.92,Default,,0,0,0,,Ашигара! Алаңды соз!
Dialogue: 0,0:21:03.76,0:21:04.93,Default,,0,0,0,,Хаа…
Dialogue: 0,0:21:05.26,0:21:07.72,Default,,0,0,0,,Менің жолым жоқ.
Dialogue: 0,0:21:09.72,0:21:10.72,Default,,0,0,0,,Жағдай қалай?
Dialogue: 0,0:21:10.81,0:21:14.43,Default,,0,0,0,,Теңіз астында үлкен жылдамдықпен үлкен нысан жақындап келеді.
Dialogue: 0,0:21:14.52,0:21:16.77,Default,,0,0,0,,Бұл тұман суасты қайығы ма?
Dialogue: 0,0:21:17.06,0:21:19.27,Default,,0,0,0,,Жоқ Бұл реакция...
Dialogue: 0,0:21:19.94,0:21:20.82,Default,,0,0,0,,Ауыр крейсер
Dialogue: 0,0:21:21.02,0:21:23.82,Default,,0,0,0,,Ауыр крейсерлер де сүңгуді бастады ма?
Dialogue: 0,0:21:23.90,0:21:25.03,Default,,0,0,0,,Мен Иносукэні құтқарамын
Dialogue: 0,0:21:25.28,0:21:27.03,Default,,0,0,0,,Мен тез келе жатырмын!
Dialogue: 0,0:21:27.11,0:21:28.28,Default,,0,0,0,,Шизука мен оны көріп тұрмын
Dialogue: 0,0:21:28.37,0:21:29.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:30.83,0:21:32.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:34.79,0:21:39.67,Default,,0,0,0,,Мен тұман студенттік кеңесінің ауыр крейсері Ашигара~мын!
Dialogue: 0,0:21:40.17,0:21:41.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:41.34,0:21:45.13,Default,,0,0,0,,Жаудың ой үлгісінің дауысы... солай ма?
Dialogue: 0,0:21:45.47,0:21:47.51,Default,,0,0,0,,Иона Не айтып тұрсыз?
Dialogue: 0,0:21:47.59,0:21:51.89,Default,,0,0,0,,«Мен тұманның студенттік кеңесінің хатшысы Джуки Ашигарамын.»
Dialogue: 0,0:21:51.97,0:21:53.06,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:21:53.18,0:21:55.98,Default,,0,0,0,,Мен сені жеңетін адаммын
Dialogue: 0,0:21:56.06,0:21:58.27,Default,,0,0,0,,Оны жеме!
Dialogue: 0,0:22:08.20,0:22:09.57,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:09.66,0:22:13.49,Default,,0,0,0,,«Сені жеңетін менмін, мені же»
Dialogue: 0,0:22:13.58,0:22:15.79,Default,,0,0,0,,Мен қазір сіздің айтқаныңызды аудармасыз түсінемін.
Dialogue: 0,0:22:15.87,0:22:17.83,Default,,0,0,0,,Ха... мен кешігіп қалдым!
Dialogue: 0,0:22:18.08,0:22:20.88,Default,,0,0,0,,Бұл өте ауырлық күші бар зеңбірек, оны қолдануға болмайды.
Dialogue: 0,0:22:20.96,0:22:22.88,Default,,0,0,0,,Эрозия торпедасында нөлдік оқ қалды
Dialogue: 0,0:22:23.38,0:22:24.88,Default,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:22:25.05,0:22:25.96,Default,,0,0,0,,Абдул мырза осыған алаңдап, сенің артыңнан келді, және солай аяқталды
Dialogue: 0,0:22:26.05,0:22:29.38,Default,,0,0,0,,Мен кемені жөндей алғаннан кейін!
Dialogue: 0,0:22:29.47,0:22:32.35,Default,,0,0,0,,Монах! Айналадағы теңіз аймағының топографиялық мәліметтері
Dialogue: 0,0:22:32.43,0:22:33.72,Default,,0,0,0,,Монитордағы дисплей
Dialogue: 0,0:22:33.97,0:22:36.98,Default,,0,0,0,,Қазір бетпе-бет күресу жақсы идея емес.
Dialogue: 0,0:22:37.48,0:22:39.81,Default,,0,0,0,,Осы жерді пайдаланып, оған шабуыл жасайық!
Dialogue: 0,0:22:39.90,0:22:40.81,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:22:43.65,0:22:44.78,Default,,0,0,0,,Теня да батыр ма?
Dialogue: 0,0:22:44.86,0:22:46.94,Default,,0,0,0,,Ашигара! өріс!
Dialogue: 0,0:22:47.03,0:22:48.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:49.61,0:22:52.87,Default,,0,0,0,,Нацист! 401 мекен жайын айтыңызшы!
Dialogue: 0,0:22:54.79,0:22:56.54,Default,,0,0,0,,Шынында да~
Dialogue: 0,0:22:56.62,0:22:58.71,Default,,0,0,0,,Өйткені ол маған қамқорлық жасайды
Dialogue: 0,0:23:00.46,0:23:03.71,Default,,0,0,0,,Дәлдік бірлік пен сонар жүйесін синхрондау
Dialogue: 0,0:23:03.79,0:23:06.21,Default,,0,0,0,,Су астындағы анықтау дәлдігін арттырады
Dialogue: 0,0:23:15.93,0:23:18.35,Default,,0,0,0,,Торпеданың акустикалық жарылыс дыбысы! Сезім 2!
Dialogue: 0,0:23:18.93,0:23:21.02,Default,,0,0,0,,Сіз біздің орналасқан жерімізді білуге ​​келдіңіз.
Dialogue: 0,0:23:21.10,0:23:23.36,Default,,0,0,0,,Кёхэй! Белсенді алаяқтық ату!
Dialogue: 0,0:23:23.44,0:23:25.27,Default,,0,0,0,,Барлық канистрлерді де жайыңыз!
Dialogue: 0,0:23:25.36,0:23:26.27,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:23:40.50,0:23:42.96,Default,,0,0,0,,Соқырлықтың сол дәрежесі
Dialogue: 0,0:23:44.25,0:23:48.05,Default,,0,0,0,,Подшипник 186 Қашықтық 9800
Dialogue: 0,0:23:48.13,0:23:49.63,Default,,0,0,0,,Тереңдігі 512
Dialogue: 0,0:23:50.01,0:23:51.30,Default,,0,0,0,,Олар үшін де тойып жеңіздер
Dialogue: 0,0:23:51.68,0:23:56.30,Default,,0,0,0,,Кеттік! 401~!
Dialogue: 0,0:24:14.82,0:24:15.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:22.75,0:24:24.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:32.84,0:24:33.88,Default,,0,0,0,,Чи~!
Dialogue: 0,0:24:34.30,0:24:38.05,Default,,0,0,0,,Мен оны бетіңе орап тастаймын да, біраз уақыт бойы шешіп ала алмайтындай қылып қоямын!
Dialogue: 0,0:24:38.47,0:24:41.10,Default,,0,0,0,,Мен ештеңе көрмеймін!
Dialogue: 0,0:24:43.19,0:24:44.73,Default,,0,0,0,,Иори! Қозғалтқыш туралы не деуге болады?
Dialogue: 0,0:24:44.81,0:24:45.98,Default,,0,0,0,,Әйтеуір жақсы!
Dialogue: 0,0:24:46.23,0:24:48.98,Default,,0,0,0,,Айла мен айла қолдансаңыз, ол біраз уақытқа созылады.
Dialogue: 0,0:24:49.36,0:24:51.32,Default,,0,0,0,,Мен тым абайсыз бола алмаймын!
Dialogue: 0,0:24:51.40,0:24:52.65,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:24:52.74,0:24:56.49,Default,,0,0,0,,Жоқ, егер мен соншалықты бейқам болмасам, мені тоқтатар еді.
Dialogue: 0,0:24:56.62,0:24:58.58,Default,,0,0,0,,Бұл не? Қазіргі шабуыл
Dialogue: 0,0:24:58.66,0:25:01.20,Default,,0,0,0,,Яри? Жоқ, бұл гарпун сияқты.
Dialogue: 0,0:25:01.29,0:25:03.25,Default,,0,0,0,,Даа~! қазірдің өзінде! Бұл тәртіпсіздік!
Dialogue: 0,0:25:03.91,0:25:08.00,Default,,0,0,0,,Келесі жолы мені бұл нәрсе соққанда, Клейнфилд ұзаққа созылмайды.
Dialogue: 0,0:25:11.38,0:25:12.21,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:25:12.42,0:25:15.01,Default,,0,0,0,,Жай ғана қашып кетпеңіз! 401!
Dialogue: 0,0:25:16.68,0:25:17.51,Default,,0,0,0,,Капитан
Dialogue: 0,0:25:17.97,0:25:20.47,Default,,0,0,0,,Жоғарыда айтылған акустикалық торпеданың ату орны
Dialogue: 0,0:25:20.56,0:25:23.10,Default,,0,0,0,,Ашығараның тым жоғары жағында еді.
Dialogue: 0,0:25:23.18,0:25:26.19,Default,,0,0,0,,Бұл теңізде басқа кеме бар дегенді білдіре ме?
Dialogue: 0,0:25:26.48,0:25:28.02,Default,,0,0,0,,Нацистік ауыр крейсер шығар
Dialogue: 0,0:25:28.56,0:25:31.07,Default,,0,0,0,,Бұл Тұман студенттік кеңесінің қайықтарының бірі.
Dialogue: 0,0:25:31.15,0:25:32.15,Default,,0,0,0,,Иә
Dialogue: 0,0:25:32.44,0:25:34.15,Default,,0,0,0,,Бірақ... неге әуре?
Dialogue: 0,0:25:34.24,0:25:36.32,Default,,0,0,0,,Ол сіздің артыңыздан осы алқапқа келді, солай ма?
Dialogue: 0,0:25:36.53,0:25:39.49,Default,,0,0,0,,Дұрыс? Бұл қайда екенін білмесеңіз
Dialogue: 0,0:25:39.57,0:25:42.45,Default,,0,0,0,,Олар сырттан аса ауырлық зеңбірегін атса жақсы болар еді.
Dialogue: 0,0:25:42.99,0:25:44.54,Default,,0,0,0,,Сол гарпун тәрізді қару
Dialogue: 0,0:25:44.62,0:25:47.96,Default,,0,0,0,,Елеулі есептеу ресурстары мен энергияны тұтынуы керек
Dialogue: 0,0:25:48.21,0:25:50.59,Default,,0,0,0,,Қалыпты ауыр крейсерлер үшін мүмкін емес
Dialogue: 0,0:25:50.67,0:25:52.30,Default,,0,0,0,,Өтемақы қажет
Dialogue: 0,0:25:52.38,0:25:54.92,Default,,0,0,0,,Бағасы өте ауырлық зеңбірегі?
Dialogue: 0,0:25:55.01,0:25:55.84,Default,,0,0,0,,Иә
Dialogue: 0,0:25:56.72,0:25:58.34,Default,,0,0,0,,Фашистер де шығар.
Dialogue: 0,0:25:58.55,0:26:02.35,Default,,0,0,0,,Ауыр гравитациялық зеңбіректің орнына не алдыңыз?
Dialogue: 0,0:26:04.18,0:26:06.06,Default,,0,0,0,,Нацис! Тез табыңыз!
Dialogue: 0,0:26:07.19,0:26:09.15,Default,,0,0,0,,Дүрбелең емес
Dialogue: 0,0:26:09.69,0:26:11.94,Default,,0,0,0,,Менің көзім мен құлағымнан
Dialogue: 0,0:26:12.02,0:26:14.03,Default,,0,0,0,,Ешкім қашып құтыла алмайды
Dialogue: 0,0:26:14.65,0:26:15.94,Default,,0,0,0,,Ха!
Dialogue: 0,0:26:17.32,0:26:18.70,Default,,0,0,0,,Таптым!
Dialogue: 0,0:26:19.49,0:26:20.95,Default,,0,0,0,,Хмм.
Dialogue: 0,0:26:21.83,0:26:23.58,Default,,0,0,0,,Не болды? капитан
Dialogue: 0,0:26:24.58,0:26:27.37,Default,,0,0,0,,Жоқ, бұл теңіз аймағына сенімдімін...
Dialogue: 0,0:26:27.46,0:26:28.29,Default,,0,0,0,,Ха!
Dialogue: 0,0:26:28.71,0:26:30.83,Default,,0,0,0,,Монах! Айналадағы мұхит түбін сканерлеңіз!
Dialogue: 0,0:26:31.21,0:26:33.46,Default,,0,0,0,,Теңіз астында? Су астында емес пе?
Dialogue: 0,0:26:33.55,0:26:35.26,Default,,0,0,0,,Әй, мұхит түбі!
Dialogue: 0,0:26:35.34,0:26:36.30,Default,,0,0,0,,Қосымша күштер! Біз тез арада қорғаныс жасауымыз керек, әйтпесе қайтадан қоршауға алынамыз.
Dialogue: 0,0:26:36.38,0:26:38.38,Default,,0,0,0,,Иори! Толық күту режимі!
Dialogue: 0,0:26:38.47,0:26:40.01,Default,,0,0,0,,Осы күйде?
Dialogue: 0,0:26:40.18,0:26:42.72,Default,,0,0,0,,Ха! Оң жақтағы гравитон реакциясы!
Dialogue: 0,0:26:45.22,0:26:46.14,Default,,0,0,0,,Уау!
Dialogue: 0,0:26:46.22,0:26:47.93,Default,,0,0,0,,Оң жақтағы қозғалтқышқа тікелей соққы!
Dialogue: 0,0:26:48.31,0:26:50.31,Default,,0,0,0,,Ұстадым!
Dialogue: 0,0:26:50.48,0:26:51.56,Default,,0,0,0,,Сіз сорып қаласыз!
Dialogue: 0,0:26:51.81,0:26:52.69,Default,,0,0,0,,Тазарту!
Dialogue: 0,0:26:54.73,0:26:55.65,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:27:03.33,0:27:05.08,Default,,0,0,0,,Келесі ату сізге үлкен соққы береді!
Dialogue: 0,0:27:10.58,0:27:12.42,Default,,0,0,0,,Иона! Иори! Сенімен бәрі жақсы ма?
Dialogue: 0,0:27:12.50,0:27:13.34,Default,,0,0,0,,Бұл тірі!
Dialogue: 0,0:27:13.42,0:27:14.25,Default,,0,0,0,,Иә
Dialogue: 0,0:27:14.34,0:27:16.09,Default,,0,0,0,,Деректерді сканерлеу! (Монах) Мен оны мониторға жіберемін.
Dialogue: 0,0:27:17.88,0:27:18.72,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:27:18.88,0:27:20.97,Default,,0,0,0,,Көптеген қозғалыс дыбыстары Бұл торпедо!
Dialogue: 0,0:27:21.18,0:27:22.34,Default,,0,0,0,,Жылдам көтерілу!
Dialogue: 0,0:27:22.43,0:27:23.97,Default,,0,0,0,,033-бағыт
Dialogue: 0,0:27:24.05,0:27:25.47,Default,,0,0,0,,Нацистік мақсат!
Dialogue: 0,0:27:25.97,0:27:28.77,Default,,0,0,0,,Нацистік мақсатты түсіндім!
Dialogue: 0,0:27:34.11,0:27:36.27,Default,,0,0,0,,Беткейлеу? тістер!
Dialogue: 0,0:27:36.65,0:27:39.19,Default,,0,0,0,,Ха! Солай ма?
Dialogue: 0,0:27:39.28,0:27:41.03,Default,,0,0,0,,Нацистер мұны істеуге рұқсат бермейді!
Dialogue: 0,0:27:41.99,0:27:44.66,Default,,0,0,0,,Клейнфилд 90% жоғалып кетті!
Dialogue: 0,0:27:44.74,0:27:46.16,Default,,0,0,0,,Танатоний реакциясы!
Dialogue: 0,0:27:46.24,0:27:47.12,Default,,0,0,0,,Иона!
Dialogue: 0,0:27:47.20,0:27:48.04,Default,,0,0,0,,Бұл не? Мен байланғанмын.
Dialogue: 0,0:27:48.16,0:27:52.92,Default,,0,0,0,,Сіздің қарсыласыңыз – мен!
Dialogue: 0,0:27:57.92,0:27:59.17,Default,,0,0,0,,Жер бетінде болыңыз!
Dialogue: 0,0:28:02.22,0:28:03.84,Default,,0,0,0,,Ха! Уф!
Dialogue: 0,0:28:09.77,0:28:11.18,Default,,0,0,0,,Бұл қажет болды! Толық жарылыс!
Dialogue: 0,0:28:11.64,0:28:13.85,Default,,0,0,0,,Сізде бір ғана өкпе бар ма?
Dialogue: 0,0:28:18.94,0:28:20.19,Default,,0,0,0,,Ах! Қат!
Dialogue: 0,0:28:20.49,0:28:21.32,Default,,0,0,0,,Иона!
Dialogue: 0,0:28:21.40,0:28:22.32,Default,,0,0,0,,Шайқаңыз
Dialogue: 0,0:28:25.53,0:28:28.24,Default,,0,0,0,,О, қазірдің өзінде! Сіз не болатынын ешқашан білмейсіз!
Dialogue: 0,0:28:31.91,0:28:33.08,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:28:33.16,0:28:34.00,Default,,0,0,0,,Ха!
Dialogue: 0,0:28:34.58,0:28:35.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:28:35.96,0:28:38.50,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:28:42.05,0:28:43.84,Default,,0,0,0,,Ха! бұл...?
Dialogue: 0,0:28:51.10,0:28:53.73,Default,,0,0,0,,Түсіндім! метангидраты
Dialogue: 0,0:28:53.81,0:28:54.69,Default,,0,0,0,,Нацис~!
Dialogue: 0,0:28:54.77,0:28:55.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:03.61,0:29:06.87,Default,,0,0,0,,Додж!
Dialogue: 0,0:29:08.37,0:29:09.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:10.24,0:29:11.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:32.64,0:29:34.93,Default,,0,0,0,,Жапония маңындағы теңізде шашырап кеткен
Dialogue: 0,0:29:35.02,0:29:37.81,Default,,0,0,0,,Метангидраттың жоғарылауы
Dialogue: 0,0:29:38.06,0:29:41.44,Default,,0,0,0,,Мен оны Теңіз технологиялар академиясында үйрендім, бірақ...
Dialogue: 0,0:29:41.94,0:29:44.82,Default,,0,0,0,,Мен оны осылай пайдаланудың жолдарын жиі ойлаймын.
Dialogue: 0,0:29:45.57,0:29:49.20,Default,,0,0,0,,Мен фашистерді жалғыз залалсыздандырамын деп үміттендім.
Dialogue: 0,0:29:49.82,0:29:53.16,Default,,0,0,0,,Ашығараның араласуы бақыт болды.
Dialogue: 0,0:29:53.54,0:29:55.08,Default,,0,0,0,,Маған үш дана беріңіз.
Dialogue: 0,0:29:55.16,0:29:58.21,Default,,0,0,0,,Менің капитаныма әлі де шабуыл жасалуда.
Dialogue: 0,0:29:58.29,0:29:59.46,Default,,0,0,0,,Сол себепті!
Dialogue: 0,0:29:59.54,0:30:01.80,Default,,0,0,0,,Мен мұны істей алмаймын дедім!
Dialogue: 0,0:30:02.00,0:30:04.26,Default,,0,0,0,,Бір жағы мүлде таза емес!
Dialogue: 0,0:30:04.34,0:30:06.84,Default,,0,0,0,,Екіншісі де жәндіктердің тынысы!
Dialogue: 0,0:30:07.01,0:30:09.39,Default,,0,0,0,,Мен бәрібір жөндеуге баратын болдым.
Dialogue: 0,0:30:09.47,0:30:11.43,Default,,0,0,0,,Нәтижені қабылдаңыз.
Dialogue: 0,0:30:11.60,0:30:13.39,Default,,0,0,0,,Иә, жарайды.
Dialogue: 0,0:30:13.64,0:30:14.85,Default,,0,0,0,,Пуф…фуфу…
Dialogue: 0,0:30:16.14,0:30:19.40,Default,,0,0,0,,Окиноторисимаға қарай баяу алға
Dialogue: 0,0:30:34.33,0:30:35.29,Default,,0,0,0,,Хаа…
Dialogue: 0,0:30:35.45,0:30:38.46,Default,,0,0,0,,Қарашы, менің жолым болмады.
Dialogue: 0,0:30:41.21,0:30:43.84,Default,,0,0,0,,Мен күресудің мұндай тәсілі бар екеніне сене алмаймын.
Dialogue: 0,0:30:46.80,0:30:50.84,Default,,0,0,0,,Ах! Му!
Dialogue: 0,0:30:53.30,0:30:56.10,Default,,0,0,0,,Бұл Чихая Гунзо және 401
Dialogue: 0,0:30:56.35,0:30:59.52,Default,,0,0,0,,Начи де, Ашигара да шалақ.
Dialogue: 0,0:31:00.10,0:31:03.77,Default,,0,0,0,,Менің аяғым болса, мен сені ешқашан қашып жібермес едім.
Dialogue: 0,0:31:04.07,0:31:05.65,Default,,0,0,0,,Менсінбеу
Dialogue: 0,0:31:06.53,0:31:08.78,Default,,0,0,0,,Олардың тактикасы үнемі өзгеріп отырады
Dialogue: 0,0:31:09.32,0:31:11.70,Default,,0,0,0,,Оны жақсы мәміле деп ойлап, ұтып ал.
Dialogue: 0,0:31:12.03,0:31:13.78,Default,,0,0,0,,Осыны есте сақтаңыз
Dialogue: 0,0:31:24.92,0:31:27.30,Default,,0,0,0,,Неліктен мен тапсырманы орындап жатырмын?
Dialogue: 0,0:31:28.21,0:31:29.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:29.38,0:31:32.18,Default,,0,0,0,,Мен Жапония үкіметінен біреумен кездесуге барамын ба?
Dialogue: 0,0:31:32.55,0:31:35.81,Default,,0,0,0,,А, мен сенен ғана сұрай аламын.
Dialogue: 0,0:31:36.31,0:31:37.27,Default,,0,0,0,,Хмф!
Dialogue: 0,0:31:37.35,0:31:39.56,Default,,0,0,0,,Бұл менің ғана қолымнан келетін миссия.
Dialogue: 0,0:31:39.64,0:31:41.23,Default,,0,0,0,,Менің басқа амалым жоқ
Dialogue: 0,0:31:42.27,0:31:43.31,Default,,0,0,0,,♪ Ка-та-на
Dialogue: 0,0:31:43.44,0:31:45.73,Default,,0,0,0,,Өйткені, біз осы уақытқа дейін келдік.
Dialogue: 0,0:31:48.86,0:31:51.57,Default,,0,0,0,,Ухехехе
Dialogue: 0,0:31:51.99,0:31:53.28,Default,,0,0,0,,Ха!
Dialogue: 0,0:31:53.74,0:31:55.33,Default,,0,0,0,,Хаа…
Dialogue: 0,0:31:55.41,0:31:57.87,Default,,0,0,0,,Толқудан кеудемнен секіріп кете жаздадым!
Dialogue: 0,0:31:59.33,0:32:00.50,Default,,0,0,0,,Хаа…
Dialogue: 0,0:32:01.29,0:32:04.58,Default,,0,0,0,,Әкесі — Шо Чихая, екінші лейтенант
Dialogue: 0,0:32:04.67,0:32:08.17,Default,,0,0,0,,Бұл кезде Саори ана әлі тірі еді.
Dialogue: 0,0:32:09.59,0:32:11.42,Default,,0,0,0,,Бұл күрделі, солай емес пе?
Dialogue: 0,0:32:12.13,0:32:13.84,Default,,0,0,0,,Мен көрдім! есіме түсті!
Dialogue: 0,0:32:13.93,0:32:17.76,Default,,0,0,0,,Мен бұл ақпаратты мұрағаттау үшін жауаптымын!
Dialogue: 0,0:32:17.85,0:32:18.89,Default,,0,0,0,,Иә!
Dialogue: 0,0:32:19.52,0:32:21.56,Default,,0,0,0,,Мен шынайы мақсатыма жеттім!
Dialogue: 0,0:32:21.64,0:32:23.10,Default,,0,0,0,,Қалғаны үй шаруасы!
Dialogue: 0,0:32:44.12,0:32:47.54,Default,,0,0,0,,Мен Гунцоның кемесімін
Dialogue: 0,0:32:50.59,0:32:52.42,Default,,0,0,0,,Сіз оны жоғарыға шығара аласыз ба?
Dialogue: 0,0:32:52.51,0:32:54.22,Default,,0,0,0,,Иә? Мен сонда ғана бардым.
Dialogue: 0,0:32:54.30,0:32:56.05,Default,,0,0,0,,Неге маған бірінші айтпадың?
Dialogue: 0,0:32:56.14,0:32:57.10,Default,,0,0,0,,Ах, Кёхэй (Кёхэй) А?
Dialogue: 0,0:32:57.18,0:32:58.30,Default,,0,0,0,,Осының бәрін төмен түсіріңіз.
Dialogue: 0,0:32:58.39,0:32:59.64,Default,,0,0,0,,Ех! Сондай-ақ? (Гунзо) Иә?
Dialogue: 0,0:33:25.37,0:33:26.54,Default,,0,0,0,,Бұл осында.
Dialogue: 0,0:33:26.62,0:33:28.75,Default,,0,0,0,,Соғыс хатшысының көмекшісі
Dialogue: 0,0:33:29.25,0:33:32.38,Default,,0,0,0,,Мен сізді Гунзо Чихаяның хабаршысы деп ешқашан ойламадым.
Dialogue: 0,0:33:32.88,0:33:35.34,Default,,0,0,0,,Джуки Такаоның психикалық моделі
Dialogue: 0,0:33:35.63,0:33:37.39,Default,,0,0,0,,Сіздің бизнесіңіз туралы сұрайын ба?
Dialogue: 0,0:33:37.93,0:33:40.43,Default,,0,0,0,,Сізге капитанның хабарламасы
Dialogue: 0,0:33:40.56,0:33:42.06,Default,,0,0,0,,Капитан
Dialogue: 0,0:33:42.43,0:33:45.73,Default,,0,0,0,,Мен флагманмен кездесіп, Тұман флотын тоқтатамын.
Dialogue: 0,0:33:46.23,0:33:48.35,Default,,0,0,0,,Бұл сіздің сендіру мамандығыңыз ба?
Dialogue: 0,0:33:48.73,0:33:50.48,Default,,0,0,0,,Менің ойымша, бұл ақылсыз.
Dialogue: 0,0:33:50.86,0:33:53.61,Default,,0,0,0,,А... Маңыздысы осы жерден басталады.
Dialogue: 0,0:33:53.99,0:33:57.20,Default,,0,0,0,,Мен сізге дірілді босату кодын беремін.
Dialogue: 0,0:33:57.57,0:33:58.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:58.49,0:33:59.57,Default,,0,0,0,,Құдай-ай, неге қыздар дәретханасында граффити жазып жүрсің өзің?!
Dialogue: 0,0:33:59.66,0:34:02.29,Default,,0,0,0,,Маған соңғы минутқа дейін біраз уақыт сатып алуыңызды қалаймын.
Dialogue: 0,0:34:02.66,0:34:05.71,Default,,0,0,0,,Уәдемді орындайтыныма кепілдік жоқ, солай ма?
Dialogue: 0,0:34:06.25,0:34:09.42,Default,,0,0,0,,Ешқандай кепілдік жоқ, бірақ мүдделер қайшылығы бар.
Dialogue: 0,0:34:10.04,0:34:13.38,Default,,0,0,0,,Анархиямен күрессең де, жойылып кетесің
Dialogue: 0,0:34:13.84,0:34:17.22,Default,,0,0,0,,Қисықтың артына түсіп, тым кеш болса да жойылыңыз
Dialogue: 0,0:34:17.38,0:34:21.72,Default,,0,0,0,,Сіз ең қолайлы кезеңді қарап, қорғанысты алып тастайсыз.
Dialogue: 0,0:34:22.22,0:34:23.81,Default,,0,0,0,,Неліктен олай ойлайсың?
Dialogue: 0,0:34:23.89,0:34:25.68,Default,,0,0,0,,Жеңіл қабылдамаңыз, жарай ма?
Dialogue: 0,0:34:26.27,0:34:29.27,Default,,0,0,0,,Рюдзиро Камиин, Әскери істер вице-министрінің көмекшісі
Dialogue: 0,0:34:29.40,0:34:32.94,Default,,0,0,0,,Сіз жоспарлап отырған Тынық мұхиты елдерінің бастамасы
Dialogue: 0,0:34:33.02,0:34:34.78,Default,,0,0,0,,Мен зерттедім.
Dialogue: 0,0:34:35.32,0:34:36.82,Default,,0,0,0,,Шатасуды пайдалану
Dialogue: 0,0:34:36.90,0:34:40.70,Default,,0,0,0,,Сізге ыңғайлы адамдарды мемлекеттік қызметкер етіп тағайындаңыз.
Dialogue: 0,0:34:40.95,0:34:44.12,Default,,0,0,0,,Сіз жаңа режимді қолдауды жоспарлап отырсыз.
Dialogue: 0,0:34:45.29,0:34:46.66,Default,,0,0,0,,Бұл ұрпақ алмасуы.
Dialogue: 0,0:34:47.29,0:34:49.67,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:34:49.92,0:34:53.50,Default,,0,0,0,,Капитанның мақсаты – ең алдымен адамзатты құтқару.
Dialogue: 0,0:34:54.05,0:34:56.05,Default,,0,0,0,,Бұл сіздің де бірдей екеніңізді білдіреді.
Dialogue: 0,0:34:56.76,0:34:59.43,Default,,0,0,0,,көремін. Бұл мүдделердің сәйкес келуі ме?
Dialogue: 0,0:34:59.76,0:35:01.34,Default,,0,0,0,,«Бұл жағдайда»
Dialogue: 0,0:35:01.43,0:35:04.47,Default,,0,0,0,,«Сіз өзіңіздің трамп-картаңызды сеніп тапсыра алатын адамдардың саны шектеулі».
Dialogue: 0,0:35:04.72,0:35:07.18,Default,,0,0,0,,«Сен жаман адам болсаң да»
Dialogue: 0,0:35:08.10,0:35:09.31,Default,,0,0,0,,Иә
Dialogue: 0,0:35:09.44,0:35:11.94,Default,,0,0,0,,Мұны істеуге бола ма? жай балалар
Dialogue: 0,0:35:12.31,0:35:15.11,Default,,0,0,0,,Сіз мұны ересек адам ретінде жасай алмайтындықтан жасайсыз.
Dialogue: 0,0:35:15.61,0:35:17.49,Default,,0,0,0,,Сіз оны оған сатасыз ба?
Dialogue: 0,0:35:17.90,0:35:19.20,Default,,0,0,0,,Бірақ мен түсінемін.
Dialogue: 0,0:35:22.91,0:35:25.20,Default,,0,0,0,,Мен түсіндім. Көріп көрейік.
Dialogue: 0,0:35:25.70,0:35:26.87,Default,,0,0,0,,1-деңгей—тіпті танк те толықтай қауіпсіз сезілмейді.
Dialogue: 0,0:35:26.95,0:35:29.21,Default,,0,0,0,,Менің капитанымды бағалама.
Dialogue: 0,0:35:29.33,0:35:30.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:35:32.71,0:35:33.84,Default,,0,0,0,,Сіз бе?
Dialogue: 0,0:35:34.09,0:35:35.34,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:35:42.18,0:35:44.05,Default,,0,0,0,,...
Dialogue: 0,0:35:44.72,0:35:46.14,Default,,0,0,0,,Хюуга!
Dialogue: 0,0:35:46.22,0:35:47.06,Default,,0,0,0,,Алдымен, қазіргі жағдайды ескерсек—
Dialogue: 0,0:35:47.56,0:35:51.02,Default,,0,0,0,,Мен оны қалпына келтіру үшін Иво Джиманың наноматериалдарын қолдандым!
Dialogue: 0,0:35:51.10,0:35:52.10,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:35:52.19,0:35:54.31,Default,,0,0,0,,Аралдың жартысы жойылды!
Dialogue: 0,0:35:54.61,0:35:55.86,Default,,0,0,0,,Сіз барасыз ба?
Dialogue: 0,0:35:55.94,0:35:58.03,Default,,0,0,0,,Ха... Капитан...
Dialogue: 0,0:35:58.32,0:36:01.07,Default,,0,0,0,,Ол менің қалағанымды істей алатынымды айтты...
Dialogue: 0,0:36:01.74,0:36:02.57,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:36:03.11,0:36:04.57,Default,,0,0,0,,Мен қалағанымды істеймін!
Dialogue: 0,0:36:47.66,0:36:50.24,Default,,0,0,0,,Мен мұнымен жарты жыл күресе аламын деп ойлаймын.
Dialogue: 0,0:36:51.08,0:36:52.00,Default,,0,0,0,,Иә!
Dialogue: 0,0:36:52.33,0:36:55.00,Default,,0,0,0,,Орыстың шалбары үлкен!
Dialogue: 0,0:36:55.50,0:36:57.34,Default,,0,0,0,,Хмм... иә?
Dialogue: 0,0:36:57.42,0:36:59.09,Default,,0,0,0,,Мен сізге бір нәрсемен көмектесе аламын ба?
Dialogue: 0,0:36:59.25,0:37:01.05,Default,,0,0,0,,О, жарайды!
Dialogue: 0,0:37:01.13,0:37:03.51,Default,,0,0,0,,Осындай кездерде Иона демалады.
Dialogue: 0,0:37:04.13,0:37:07.18,Default,,0,0,0,,Мен ыдырағанша қолымнан келгенше тырысамын!
Dialogue: 0,0:37:07.51,0:37:08.51,Default,,0,0,0,,Ах! Бұл дұрыс!
Dialogue: 0,0:37:09.26,0:37:10.35,Default,,0,0,0,,Гунзо! (Гунзо) Ах...
Dialogue: 0,0:37:10.43,0:37:12.85,Default,,0,0,0,,Эй, қалаға барып, мынаны сатып ал!
Dialogue: 0,0:37:13.14,0:37:14.94,Default,,0,0,0,,А? Кенеттен не болып жатыр?
Dialogue: 0,0:37:15.02,0:37:16.19,Default,,0,0,0,,Қарашы, Иона!
Dialogue: 0,0:37:16.27,0:37:18.40,Default,,0,0,0,,Гунзо мені қалаға апарады.
Dialogue: 0,0:37:19.07,0:37:19.94,Default,,0,0,0,,Қала?
Dialogue: 0,0:37:20.52,0:37:21.90,Default,,0,0,0,,Бұл сізге қазір қажет нәрсе ме?
Dialogue: 0,0:37:21.98,0:37:24.53,Default,,0,0,0,,Не? Денің сау ма? (Миямура) Иә.
Dialogue: 0,0:37:24.61,0:37:25.45,Default,,0,0,0,,Кенеттен келгеніме кешірім өтінемін.
Dialogue: 0,0:37:25.57,0:37:27.07,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:37:27.20,0:37:29.87,Default,,0,0,0,,Капитан Мен тез арада мисо сорпасын алғым келеді.
Dialogue: 0,0:37:30.45,0:37:31.58,Default,,0,0,0,,Мен кола!
Dialogue: 0,0:37:31.66,0:37:33.25,Default,,0,0,0,,Ах! мен...
Dialogue: 0,0:37:33.66,0:37:34.58,Default,,0,0,0,,Мен...
Dialogue: 0,0:37:34.96,0:37:36.67,Default,,0,0,0,,Оны еш күш жұмсамай шашыраңқы етіп көрсету үшін
Dialogue: 0,0:37:43.34,0:37:47.13,Default,,0,0,0,,Бұрын бұл жерде үлкен әскери порт болған.
Dialogue: 0,0:37:47.22,0:37:48.05,Default,,0,0,0,,Иә
Dialogue: 0,0:37:48.43,0:37:52.10,Default,,0,0,0,,2012 жылы жасалған протокол анализаторы ма?
Dialogue: 0,0:37:52.22,0:37:53.77,Default,,0,0,0,,Иориге ұқсайды
Dialogue: 0,0:37:53.98,0:37:56.35,Default,,0,0,0,,Иона! Бөлінбеңіз!
Dialogue: 0,0:37:57.02,0:37:57.85,Default,,0,0,0,,Иә
Dialogue: 0,0:37:57.94,0:37:58.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:04.49,0:38:05.90,Default,,0,0,0,,Қалайсың ба?
Dialogue: 0,0:38:06.24,0:38:07.07,Default,,0,0,0,,Бетіңде әлі де сол мұңды кейіп бар.
Dialogue: 0,0:38:09.74,0:38:10.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:38:16.21,0:38:17.92,Default,,0,0,0,,Мен тағы бір үйге тоқтауым керек.
Dialogue: 0,0:38:18.00,0:38:19.21,Default,,0,0,0,,Мені күт
Dialogue: 0,0:38:19.42,0:38:21.29,Default,,0,0,0,,Иә! Мен күтемін
Dialogue: 0,0:38:30.97,0:38:31.80,Default,,0,0,0,,Әй!
Dialogue: 0,0:38:39.40,0:38:40.48,Default,,0,0,0,,Ах!
Dialogue: 0,0:39:04.67,0:39:05.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:06.26,0:39:08.55,Default,,0,0,0,,Сәлем 401
Dialogue: 0,0:39:09.01,0:39:10.97,Default,,0,0,0,,Мусаши супер шайқасы
Dialogue: 0,0:39:11.43,0:39:12.60,Default,,0,0,0,,Бұл сенсің ғой, иә?
Dialogue: 0,0:39:12.72,0:39:13.55,Default,,0,0,0,,Сізге
Dialogue: 0,0:39:16.52,0:39:18.23,Default,,0,0,0,,Мен сені көруге келдім.
Dialogue: 0,0:39:21.10,0:39:23.77,Default,,0,0,0,,Ямато қуыршағына
Dialogue: 0,0:39:24.07,0:39:25.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:32.41,0:39:36.04,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:39:37.91,0:39:38.75,Default,,0,0,0,,Ах!
Dialogue: 0,0:39:44.25,0:39:46.50,Default,,0,0,0,,Не болды? Не болды!
Dialogue: 0,0:39:47.13,0:39:49.76,Default,,0,0,0,,Иона! Иона!
Dialogue: 0,0:40:14.57,0:40:15.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:40:16.41,0:40:20.37,Default,,0,0,0,,Мен сенмін
Dialogue: 0,0:40:20.83,0:40:24.33,Default,,0,0,0,,Тұман деп аталатын болмыстың флагманы
Dialogue: 0,0:40:25.21,0:40:27.50,Default,,0,0,0,,Менің атым Ямато.
Dialogue: 0,0:40:28.25,0:40:32.13,Default,,0,0,0,,Бұл шайқаста алғаш рет біз
Dialogue: 0,0:40:32.22,0:40:35.51,Default,,0,0,0,,Екі эсминец зардап шекті.
Dialogue: 0,0:40:35.76,0:40:39.60,Default,,0,0,0,,Әскери күш-қуатымыздан біз басым едік.
Dialogue: 0,0:40:40.27,0:40:43.02,Default,,0,0,0,,Неліктен зардап шектік?
Dialogue: 0,0:40:43.52,0:40:46.73,Default,,0,0,0,,Сіз олардың бір-бірімен ұрысуын айтып тұрсыз ба?
Dialogue: 0,0:40:47.40,0:40:52.28,Default,,0,0,0,,Себебі, сіз біздің тактикаға алданып қалдыңыз.
Dialogue: 0,0:40:52.53,0:40:55.49,Default,,0,0,0,,Тактика... Адамдарды алып жүргенде
Dialogue: 0,0:40:55.57,0:40:58.37,Default,,0,0,0,,Жауынгерлік кемелер оны пайдалана ала ма?
Dialogue: 0,0:40:58.49,0:41:01.37,Default,,0,0,0,,Ах, дұрыс.
Dialogue: 0,0:41:02.71,0:41:04.29,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:41:05.00,0:41:09.75,Default,,0,0,0,,Біз адмиралтейлік кодекске сәйкес соғысатын қарумыз.
Dialogue: 0,0:41:09.84,0:41:11.67,Default,,0,0,0,,Бұл қару болғандықтан
Dialogue: 0,0:41:11.76,0:41:15.80,Default,,0,0,0,,Міндетті түрде күресу керек деген ұғым жоқ.
Dialogue: 0,0:41:16.01,0:41:17.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:18.01,0:41:22.35,Default,,0,0,0,,Сонда біздің өмір сүруімізге ешқандай себеп болмас еді.
Dialogue: 0,0:41:22.43,0:41:25.23,Default,,0,0,0,,Басқа өмір сүру тәсілін ойлап көріңіз
Dialogue: 0,0:41:26.19,0:41:27.35,Default,,0,0,0,,Мусаши
Dialogue: 0,0:41:27.44,0:41:30.57,Default,,0,0,0,,Бұл сөздерді қалай түсіндіруім керек?
Dialogue: 0,0:41:31.11,0:41:34.45,Default,,0,0,0,,Адмиралтейлік кодекске қайшы келетін идеялар
Dialogue: 0,0:41:35.70,0:41:39.99,Default,,0,0,0,,Шозо-санның бұйрық бойынша шайқасы туралы.
Dialogue: 0,0:41:40.08,0:41:42.41,Default,,0,0,0,,Басқа анықтамалар бар ма?
Dialogue: 0,0:41:42.58,0:41:44.91,Default,,0,0,0,,Анықтама болмаса да
Dialogue: 0,0:41:45.50,0:41:48.92,Default,,0,0,0,,Мен отбасым үшін күресіп жатырмын
Dialogue: 0,0:41:49.42,0:41:53.59,Default,,0,0,0,,Түрлердің гүлденуі үшін минималды қауымдастық
Dialogue: 0,0:41:54.88,0:41:58.47,Default,,0,0,0,,Бұл менің әйелім Саори мен баламның суреті.
Dialogue: 0,0:41:58.89,0:42:03.27,Default,,0,0,0,,Тұқым берекелі десе, тегі де, ұрпағы да жоқ.
Dialogue: 0,0:42:03.85,0:42:08.31,Default,,0,0,0,,Біз бір-бірімізді бағалайтындықтан отбасы бола аламыз.
Dialogue: 0,0:42:09.44,0:42:11.07,Default,,0,0,0,,Дұрыс айтпадым ба, Крюгер мырза?
Dialogue: 0,0:42:11.19,0:42:14.36,Default,,0,0,0,,Сонда Мусаши менің отбасым.
Dialogue: 0,0:42:14.57,0:42:15.95,Default,,0,0,0,,Өйткені бұл маңызды
Dialogue: 0,0:42:16.03,0:42:17.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:42:17.15,0:42:18.53,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:42:18.61,0:42:22.54,Default,,0,0,0,,Бірге тудыңдар, демек апалы-сіңілісіңдер.
Dialogue: 0,0:42:22.83,0:42:26.87,Default,,0,0,0,,Бұл бірінші кеме болғандықтан, мен үлкен апамын.
Dialogue: 0,0:42:27.16,0:42:28.83,Default,,0,0,0,,Әпке...
Dialogue: 0,0:42:29.38,0:42:31.04,Default,,0,0,0,,Әпке...
Dialogue: 0,0:42:31.13,0:42:34.46,Default,,0,0,0,,Біздің дүниеге келуімізге мүмкіндік тудырдың.
Dialogue: 0,0:42:34.55,0:42:36.09,Default,,0,0,0,,Бұл сенің әкең.
Dialogue: 0,0:42:36.51,0:42:39.01,Default,,0,0,0,,Хехехе, мен көріп тұрмын.
Dialogue: 0,0:42:40.43,0:42:42.22,Default,,0,0,0,,Мусаши осылай ойлайды.
Dialogue: 0,0:42:42.30,0:42:43.60,Default,,0,0,0,,Мен келіспеймін
Dialogue: 0,0:42:44.18,0:42:47.27,Default,,0,0,0,,Адмиралтейлік кодекс ұзақ уақыт бойы жойылды.
Dialogue: 0,0:42:47.64,0:42:50.56,Default,,0,0,0,,Келесі бұйрыққа дейін жағдайды бағалау
Dialogue: 0,0:42:50.65,0:42:53.19,Default,,0,0,0,,Біздің супер соғыс кемелері ретіндегі рөліміз.
Dialogue: 0,0:42:53.86,0:42:55.23,Default,,0,0,0,,Ямато…
Dialogue: 0,0:42:55.32,0:42:56.94,Default,,0,0,0,,Сәлем Мусаши
Dialogue: 0,0:42:57.28,0:42:59.53,Default,,0,0,0,,Өзгеріс жаман нәрсе ме?
Dialogue: 0,0:43:00.61,0:43:02.74,Default,,0,0,0,,Мен де қорқамын
Dialogue: 0,0:43:03.74,0:43:08.16,Default,,0,0,0,,Бірақ маған сізбен араласу мүмкіндігі берілді.
Dialogue: 0,0:43:08.25,0:43:11.71,Default,,0,0,0,,Сондықтан мен қолымнан келгенін істеуге тырысамын.
Dialogue: 0,0:43:12.00,0:43:15.92,Default,,0,0,0,,Бізбен қарым-қатынас жасау үшін дүниеге келдің.
Dialogue: 0,0:43:16.01,0:43:19.13,Default,,0,0,0,,Бір тұлға: Мусаши
Dialogue: 0,0:43:22.39,0:43:23.89,Default,,0,0,0,,Әке...
Dialogue: 0,0:43:29.85,0:43:31.69,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:43:31.77,0:43:33.23,Default,,0,0,0,,Ха...
Dialogue: 0,0:43:36.44,0:43:39.11,Default,,0,0,0,,Кешіріңіз, капитан.
Dialogue: 0,0:43:39.57,0:43:40.40,Default,,0,0,0,,Әке!
Dialogue: 0,0:43:40.49,0:43:44.87,Default,,0,0,0,,Хааааааааааааааааааааааааааа...
Dialogue: 0,0:43:46.83,0:43:49.16,Default,,0,0,0,,Адам баласы бір-біріне қамқор...
Dialogue: 0,0:43:49.37,0:43:51.67,Default,,0,0,0,,Бұл қорғайтын нәрсе емес пе еді?
Dialogue: 0,0:43:52.00,0:43:54.38,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:43:55.84,0:43:57.09,Default,,0,0,0,,Мусаши!
Dialogue: 0,0:43:58.01,0:44:00.09,Default,,0,0,0,,Түсіндіру өзгертілді
Dialogue: 0,0:44:07.10,0:44:10.27,Default,,0,0,0,,Адамдар ақымақ
Dialogue: 0,0:44:11.98,0:44:15.11,Default,,0,0,0,,Сіз... сіз Ямато қуыршағысыз ба?
Dialogue: 0,0:44:15.19,0:44:16.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:17.61,0:44:21.40,Default,,0,0,0,,Мен сізді барлау тобыммен бірге бақылап отырдым.
Dialogue: 0,0:44:21.49,0:44:23.11,Default,,0,0,0,,Мен өлтірілдім
Dialogue: 0,0:44:24.37,0:44:27.62,Default,,0,0,0,,Яматоның қуыршағы апа-сіңлілерді өлтіреді, солай ма?
Dialogue: 0,0:44:28.24,0:44:29.41,Default,,0,0,0,,Мен...
Dialogue: 0,0:44:29.50,0:44:31.71,Default,,0,0,0,,Әкесінің ұлымен
Dialogue: 0,0:44:31.79,0:44:33.67,Default,,0,0,0,,Конгоды да құрттым.
Dialogue: 0,0:44:33.75,0:44:34.58,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:44:34.67,0:44:37.96,Default,,0,0,0,,Бұл Ямато қалаған өзгеріс, солай ма?
Dialogue: 0,0:44:38.05,0:44:40.67,Default,,0,0,0,,Ямато? Неге жасырып жүрсің?
Dialogue: 0,0:44:40.76,0:44:43.97,Default,,0,0,0,,Мына қуыршақ саған қатты ұнай ма?
Dialogue: 0,0:44:44.05,0:44:46.35,Default,,0,0,0,,Жоқ! Мен Ионамын!
Dialogue: 0,0:44:46.43,0:44:47.85,Default,,0,0,0,,Жоқ, ха!
Dialogue: 0,0:44:48.89,0:44:53.44,Default,,0,0,0,,Сіз Яматоның есептеу қабілетін алған қуыршақсыз.
Dialogue: 0,0:44:54.10,0:44:55.69,Default,,0,0,0,,Суасты қайықтар стилі
Dialogue: 0,0:44:55.77,0:45:00.53,Default,,0,0,0,,Психикалық үлгілерді қалыптастыру үшін бізде есептеу күші болуы мүмкін емес.
Dialogue: 0,0:45:00.82,0:45:03.36,Default,,0,0,0,,Яматоны мен батырып жібердім
Dialogue: 0,0:45:03.45,0:45:07.62,Default,,0,0,0,,Соңғы күшіммен мен саған өзегін бердім.
Dialogue: 0,0:45:08.53,0:45:11.29,Default,,0,0,0,,Неліктен сіз екі ядролысыз?
Dialogue: 0,0:45:11.37,0:45:13.62,Default,,0,0,0,,Сіз бұл туралы ешқашан ойламадыңыз ба?
Dialogue: 0,0:45:14.25,0:45:17.13,Default,,0,0,0,,Өйткені Ямато адамзатты жақсы көреді
Dialogue: 0,0:45:17.25,0:45:21.13,Default,,0,0,0,,Адамзатқа қауіп төнсе, олар шығуы мүмкін.
Dialogue: 0,0:45:21.26,0:45:24.38,Default,,0,0,0,,Ол кезде қуыршақ қажет болмай қалады.
Dialogue: 0,0:45:24.80,0:45:27.55,Default,,0,0,0,,Егер барлық адамдар өлсе ше?
Dialogue: 0,0:45:28.01,0:45:30.39,Default,,0,0,0,,Олай болса мені тоқтатуға келесің бе?
Dialogue: 0,0:45:31.01,0:45:33.23,Default,,0,0,0,,Ямато сені өлтіреді
Dialogue: 0,0:45:33.31,0:45:36.06,Default,,0,0,0,,Сіз мені көруге келесіз бе?
Dialogue: 0,0:45:37.69,0:45:38.98,Default,,0,0,0,,Ямато?
Dialogue: 0,0:45:39.15,0:45:41.57,Default,,0,0,0,,Маған кел
Dialogue: 0,0:45:41.73,0:45:44.57,Default,,0,0,0,,Мен сені қайтадан суға батырамын.
Dialogue: 0,0:45:45.03,0:45:48.37,Default,,0,0,0,,Енді маған кедергі келтірмеу үшін.
Dialogue: 0,0:45:52.87,0:45:54.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:45:59.17,0:46:00.46,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:46:01.42,0:46:02.80,Default,,0,0,0,,Топтық сурет?
Dialogue: 0,0:46:03.34,0:46:04.47,Default,,0,0,0,,Хаа…
Dialogue: 0,0:46:06.72,0:46:08.39,Default,,0,0,0,,Оны асыра пайдаланбаңыз
Dialogue: 0,0:46:08.93,0:46:10.14,Default,,0,0,0,,Иә
Dialogue: 0,0:46:11.89,0:46:13.43,Default,,0,0,0,,Не болды?
Dialogue: 0,0:46:17.06,0:46:19.06,Default,,0,0,0,,Мен... Мусашимен кездестім.
Dialogue: 0,0:46:20.06,0:46:22.23,Default,,0,0,0,,Мусаши супер шайқасына?
Dialogue: 0,0:46:22.57,0:46:25.19,Default,,0,0,0,,Владивостокқа келдің бе?
Dialogue: 0,0:46:25.82,0:46:27.74,Default,,0,0,0,,Тек психикалық модель
Dialogue: 0,0:46:28.16,0:46:31.37,Default,,0,0,0,,Өйткені реакция күшті қорғаныспен басылды
Dialogue: 0,0:46:31.45,0:46:33.37,Default,,0,0,0,,Анықталмады
Dialogue: 0,0:46:35.58,0:46:37.33,Default,,0,0,0,,Өтті!
Dialogue: 0,0:46:37.50,0:46:38.37,Default,,0,0,0,,Иә
Dialogue: 0,0:46:47.51,0:46:49.84,Default,,0,0,0,,Ямато және Мусаши флагмандары
Dialogue: 0,0:46:49.93,0:46:52.85,Default,,0,0,0,,Адам капитаны Чихая Шо және (Гунзо) Ах...
Dialogue: 0,0:46:52.93,0:46:55.27,Default,,0,0,0,,Қарым-қатынасты жеңілдету
Dialogue: 0,0:46:55.56,0:46:57.85,Default,,0,0,0,,Гуманоид пішіні
Dialogue: 0,0:46:57.94,0:46:59.52,Default,,0,0,0,,Психикалық модель құрды
Dialogue: 0,0:47:01.02,0:47:05.11,Default,,0,0,0,,Чихая Шо мүсіні тұманмен сөйлесуге тырысты.
Dialogue: 0,0:47:05.32,0:47:09.53,Default,,0,0,0,,Бір-бірімізді түсінсек, соғыстан аулақ бола аламыз.
Dialogue: 0,0:47:10.24,0:47:13.28,Default,,0,0,0,,Бірақ ол бейберекеттікте қайтыс болды.
Dialogue: 0,0:47:13.45,0:47:14.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:14.37,0:47:17.96,Default,,0,0,0,,Ол қазір Мусаши супер боевикінің бортында.
Dialogue: 0,0:47:18.04,0:47:19.83,Default,,0,0,0,,Наноматериалдар арқылы жасалған
Dialogue: 0,0:47:19.92,0:47:21.92,Default,,0,0,0,,Ниетсіз еліктеу
Dialogue: 0,0:47:24.13,0:47:25.46,Default,,0,0,0,,Суреттерді топтастыру?
Dialogue: 0,0:47:26.13,0:47:27.51,Default,,0,0,0,,Менің әкем
Dialogue: 0,0:47:27.97,0:47:30.13,Default,,0,0,0,,Ол сатқын емес еді.
Dialogue: 0,0:47:30.72,0:47:33.97,Default,,0,0,0,,Менің есте сақтауым бойынша Мұсашы маған көрсетті
Dialogue: 0,0:47:34.05,0:47:35.26,Default,,0,0,0,,Солай болады.
Dialogue: 0,0:47:37.27,0:47:38.73,Default,,0,0,0,,Менің әкем
Dialogue: 0,0:47:38.81,0:47:41.44,Default,,0,0,0,,Мен тұманмен сөйлеспек болдым.
Dialogue: 0,0:47:42.56,0:47:44.02,Default,,0,0,0,,Менің әкем
Dialogue: 0,0:47:44.31,0:47:46.61,Default,,0,0,0,,Менімен бірдей болды.
Dialogue: 0,0:47:47.07,0:47:48.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:49.70,0:47:52.36,Default,,0,0,0,,Мұны саған Мұсаши айту үшін келді ме?
Dialogue: 0,0:47:53.66,0:47:55.12,Default,,0,0,0,,Бұл...
Dialogue: 0,0:47:56.62,0:48:00.54,Default,,0,0,0,,Мен... Мұсашидің тікелей басқаруындағы кемелердің бірі болдым.
Dialogue: 0,0:48:00.62,0:48:02.04,Default,,0,0,0,,Мен сені еске түсіруге келдім.
Dialogue: 0,0:48:02.29,0:48:04.04,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:48:04.50,0:48:07.96,Default,,0,0,0,,Мен, сатқын, Яматоның императорлық бұйрығын алдым.
Dialogue: 0,0:48:08.05,0:48:10.84,Default,,0,0,0,,Мен не болып жатқанын көру үшін келдім деп ойлаймын.
Dialogue: 0,0:48:10.92,0:48:12.97,Default,,0,0,0,,Яматоның бұйрығы?
Dialogue: 0,0:48:13.30,0:48:14.43,Default,,0,0,0,,Суреттерді топтастыру…
Dialogue: 0,0:48:15.60,0:48:17.60,Default,,0,0,0,,Флагмандық Ямато болып табылады
Dialogue: 0,0:48:18.43,0:48:21.18,Default,,0,0,0,,Мұсашидің қолынан батып кеткен.
Dialogue: 0,0:48:21.52,0:48:22.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:22.85,0:48:24.56,Default,,0,0,0,,Жалпы флагмандық команда болып табылады
Dialogue: 0,0:48:24.65,0:48:26.82,Default,,0,0,0,,Адмиралтия кодексіне жауапты
Dialogue: 0,0:48:26.90,0:48:28.86,Default,,0,0,0,,Екі супер шайқас класындағы кеме
Dialogue: 0,0:48:28.94,0:48:32.90,Default,,0,0,0,,Ямато мен Мусаши арасындағы келіссөздер нәтижесі бойынша шығарылған.
Dialogue: 0,0:48:32.99,0:48:36.07,Default,,0,0,0,,Тұманға қарсы барлық кемелердің әрекетін анықтаңыз
Dialogue: 0,0:48:36.16,0:48:38.74,Default,,0,0,0,,Бірақ ол бір кемеге айналғанда...
Dialogue: 0,0:48:38.83,0:48:41.04,Default,,0,0,0,,Кеңес алудың қажеті жоқ
Dialogue: 0,0:48:41.12,0:48:43.25,Default,,0,0,0,,Адмиралтейлік кодекс атымен
Dialogue: 0,0:48:43.33,0:48:46.42,Default,,0,0,0,,Тұманның барлық әрекеттерін байланыстыра алады
Dialogue: 0,0:48:46.50,0:48:47.59,Default,,0,0,0,,Иә
Dialogue: 0,0:48:48.05,0:48:52.09,Default,,0,0,0,,Тұман флоты Мусашидің ұсынысы бойынша.
Dialogue: 0,0:48:53.72,0:48:57.51,Default,,0,0,0,,Мен Яматоның соңғы бұйрығын алдым.
Dialogue: 0,0:48:57.60,0:48:59.51,Default,,0,0,0,,Мұсашидің туынан алыс
Dialogue: 0,0:48:59.60,0:49:00.97,Default,,0,0,0,,Мен сені көруге келдім.
Dialogue: 0,0:49:01.89,0:49:04.27,Default,,0,0,0,,Шо Чихаяның ұлына
Dialogue: 0,0:49:05.06,0:49:06.48,Default,,0,0,0,,Мусаши
Dialogue: 0,0:49:06.56,0:49:09.40,Default,,0,0,0,,Неліктен берілуді ұсындыңыз?
Dialogue: 0,0:49:10.07,0:49:11.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:49:12.74,0:49:16.11,Default,,0,0,0,,Сонда сен мені тоқтатуға келесің бе?
Dialogue: 0,0:49:16.62,0:49:21.79,Default,,0,0,0,,Ямато сені өлтіріп, мені көруге келе ме?
Dialogue: 0,0:49:25.75,0:49:26.83,Default,,0,0,0,,Әрі қарай!
Dialogue: 0,0:49:28.38,0:49:31.76,Default,,0,0,0,,Кешіріңіз. Ой, ей!
Dialogue: 0,0:49:32.05,0:49:34.01,Default,,0,0,0,,Қазір жақсылап демалыңыз.
Dialogue: 0,0:49:34.68,0:49:37.76,Default,,0,0,0,,Егер сізге бірдеңе керек болса, маған дереу хабарлаңыз.
Dialogue: 0,0:49:54.61,0:49:55.86,Default,,0,0,0,,Суреттерді топтастыру…
Dialogue: 0,0:49:59.07,0:50:00.49,Default,,0,0,0,,Мен...
Dialogue: 0,0:50:00.58,0:50:02.74,Default,,0,0,0,,…
Dialogue: 0,0:50:07.50,0:50:10.54,Default,,0,0,0,,Хюуга, саған кенеттен қоңырау шалғанда не болды?
Dialogue: 0,0:50:10.63,0:50:13.46,Default,,0,0,0,,Мен қазір торт пісірумен айналысамын.
Dialogue: 0,0:50:14.01,0:50:17.97,Default,,0,0,0,,Жердегі шабуыл бірнеше күннен кейін басталады.
Dialogue: 0,0:50:18.05,0:50:19.43,Default,,0,0,0,,Бұл алаңсыз нәрсе.
Dialogue: 0,0:50:19.51,0:50:22.39,Default,,0,0,0,,...
Dialogue: 0,0:50:22.47,0:50:24.85,Default,,0,0,0,,...
Dialogue: 0,0:50:25.73,0:50:28.73,Default,,0,0,0,,...
Dialogue: 0,0:50:29.19,0:50:30.36,Default,,0,0,0,,Ха...
Dialogue: 0,0:50:30.77,0:50:32.98,Default,,0,0,0,,Бұл менің бірінші рет
Dialogue: 0,0:50:33.48,0:50:35.78,Default,,0,0,0,,401
Dialogue: 0,0:50:35.86,0:50:38.32,Default,,0,0,0,,Мұсашиден біраз байланыс болған сияқты.
Dialogue: 0,0:50:38.41,0:50:39.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:39.53,0:50:42.12,Default,,0,0,0,,...
Dialogue: 0,0:50:42.20,0:50:44.33,Default,,0,0,0,,...
Dialogue: 0,0:50:44.41,0:50:46.66,Default,,0,0,0,,Мен түсіне бастадым деп ойлаймын
Dialogue: 0,0:50:47.41,0:50:49.54,Default,,0,0,0,,401
Dialogue: 0,0:50:49.62,0:50:52.88,Default,,0,0,0,,Адамның ғана қолынан ештеңе келмейді.
Dialogue: 0,0:50:53.59,0:50:56.88,Default,,0,0,0,,Сонымен, сіз бізге хабарластыңыз ба?
Dialogue: 0,0:50:57.26,0:50:58.30,Default,,0,0,0,,Әй?
Dialogue: 0,0:50:58.47,0:51:01.80,Default,,0,0,0,,Ха! Сіз флагмандықтарды алуымыз керек дейсіз бе?
Dialogue: 0,0:51:01.93,0:51:03.81,Default,,0,0,0,,...
Dialogue: 0,0:51:03.89,0:51:05.64,Default,,0,0,0,,Сіз мені жалғыз қалдыра алмайсыз!
Dialogue: 0,0:51:05.97,0:51:07.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:51:07.56,0:51:09.35,Default,,0,0,0,,...
Dialogue: 0,0:51:09.44,0:51:13.32,Default,,0,0,0,,Ұлы әскери кемелердің екі психикалық моделі бар.
Dialogue: 0,0:51:13.40,0:51:16.19,Default,,0,0,0,,Балалар, сендер кез келген нәрсені істей аласыңдар, солай ма?
Dialogue: 0,0:51:16.28,0:51:18.99,Default,,0,0,0,,…
Dialogue: 0,0:51:19.57,0:51:20.86,Default,,0,0,0,,Хюуга
Dialogue: 0,0:51:21.53,0:51:24.91,Default,,0,0,0,,Біз Макиді қорғауымыз керек
Dialogue: 0,0:51:26.04,0:51:27.25,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:51:27.33,0:51:30.00,Default,,0,0,0,,Мен оны ұрысқа араластырғым келмейді.
Dialogue: 0,0:51:30.46,0:51:32.83,Default,,0,0,0,,...
Dialogue: 0,0:51:32.92,0:51:35.50,Default,,0,0,0,,Әрқашан адамдардың нысанасы
Dialogue: 0,0:51:35.84,0:51:37.71,Default,,0,0,0,,...
Dialogue: 0,0:51:38.13,0:51:40.59,Default,,0,0,0,,...
Dialogue: 0,0:51:41.89,0:51:42.89,Default,,0,0,0,,Иә.
Dialogue: 0,0:51:43.76,0:51:44.89,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:51:45.31,0:51:46.64,Default,,0,0,0,,Харуна…
Dialogue: 0,0:51:48.64,0:51:51.44,Default,,0,0,0,,Иә! Қызық емес пе?
Dialogue: 0,0:51:51.52,0:51:53.15,Default,,0,0,0,,...
Dialogue: 0,0:51:53.98,0:51:55.94,Default,,0,0,0,,...
Dialogue: 0,0:52:05.87,0:52:07.66,Default,,0,0,0,,Сәлем?
Dialogue: 0,0:52:08.04,0:52:09.12,Default,,0,0,0,,Сіз
Dialogue: 0,0:52:09.20,0:52:12.12,Default,,0,0,0,,Өз кемеңізді жөндеуді ойлаған жоқсыз ба?
Dialogue: 0,0:52:12.21,0:52:13.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:15.92,0:52:17.71,Default,,0,0,0,,(Нишики) Бұл... осы туралы сұрауға мен дұрыс адаммын ба?
Dialogue: 0,0:52:17.80,0:52:18.96,Default,,0,0,0,,Қайта алу мүмкіндігі
Dialogue: 0,0:52:19.05,0:52:21.34,Default,,0,0,0,,Мүмкін сіз қорқып бара жатқан шығарсыз.
Dialogue: 0,0:52:21.42,0:52:23.13,Default,,0,0,0,,Адам сияқты
Dialogue: 0,0:52:23.22,0:52:24.59,Default,,0,0,0,,Сен ақымақсың~
Dialogue: 0,0:52:24.68,0:52:27.85,Default,,0,0,0,,Кешіріңіз! Сіз сияқты жақсы емес!
Dialogue: 0,0:52:31.27,0:52:33.98,Default,,0,0,0,,Мен мұндай жағдайды бірінші рет кездестіруім.
Dialogue: 0,0:52:34.23,0:52:35.86,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:52:35.94,0:52:38.61,Default,,0,0,0,,Біз жүзе алатын сияқтымыз.
Dialogue: 0,0:52:38.69,0:52:40.99,Default,,0,0,0,,Бұл сүңгуір қайық сияқты.
Dialogue: 0,0:52:41.44,0:52:43.99,Default,,0,0,0,,Тұманға қарсы флот көрсеткен уақытқа дейін
Dialogue: 0,0:52:44.07,0:52:45.57,Default,,0,0,0,,2 күн қалды
Dialogue: 0,0:52:45.66,0:52:47.83,Default,,0,0,0,,Жағдай шұғыл.
Dialogue: 0,0:52:47.91,0:52:49.70,Default,,0,0,0,,Әр елдің әскерлерінен
Dialogue: 0,0:52:49.79,0:52:52.87,Default,,0,0,0,,Дірілдейтін оқтұмсықты босату коды туралы еске салу
Dialogue: 0,0:52:52.96,0:52:54.50,Default,,0,0,0,,Қауіптер тоқтамайды
Dialogue: 0,0:52:54.75,0:52:57.00,Default,,0,0,0,,Сіз асығыс болуыңыз керек.
Dialogue: 0,0:52:57.09,0:52:58.63,Default,,0,0,0,,Оны жай қалдырыңыз
Dialogue: 0,0:52:58.88,0:53:02.67,Default,,0,0,0,,Менің ойымша, олар бұл туралы ештеңе істей алмайды.
Dialogue: 0,0:53:04.43,0:53:05.51,Default,,0,0,0,,Капитан!
Dialogue: 0,0:53:05.59,0:53:07.10,Default,,0,0,0,,Курс өзгермейді
Dialogue: 0,0:53:07.18,0:53:08.72,Default,,0,0,0,,Гунзо! Иона ше?
Dialogue: 0,0:53:08.81,0:53:10.85,Default,,0,0,0,,Ол есін жиды, бірақ демалып жатыр.
Dialogue: 0,0:53:11.47,0:53:13.31,Default,,0,0,0,,Қалада не болды?
Dialogue: 0,0:53:13.56,0:53:16.86,Default,,0,0,0,,Ионаның Мусашиден қандай да бір байланысы бар сияқты.
Dialogue: 0,0:53:16.94,0:53:17.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:18.40,0:53:21.28,Default,,0,0,0,,Тұманның қазіргі билеушісі Мұсаши.
Dialogue: 0,0:53:21.36,0:53:22.94,Default,,0,0,0,,ше? Ямато ше?
Dialogue: 0,0:53:23.03,0:53:25.57,Default,,0,0,0,,Мұсаши батып кетті
Dialogue: 0,0:53:25.82,0:53:26.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:26.95,0:53:29.41,Default,,0,0,0,,Не болды?
Dialogue: 0,0:53:29.83,0:53:32.62,Default,,0,0,0,,Тұман да монолит емес еді.
Dialogue: 0,0:53:33.29,0:53:36.96,Default,,0,0,0,,Қазіргі уақытта Иона екеуміз күзеттеміз.
Dialogue: 0,0:53:37.17,0:53:38.96,Default,,0,0,0,,Егер сізді осылай қарсы алса
Dialogue: 0,0:53:39.04,0:53:41.46,Default,,0,0,0,,Оны пайдалану мүмкіндігі де болуы мүмкін.
Dialogue: 0,0:53:41.88,0:53:46.05,Default,,0,0,0,,Ал егер психикалық модель Ионаның сигналы жоғалса
Dialogue: 0,0:53:46.13,0:53:48.14,Default,,0,0,0,,Анықтау өте қиын
Dialogue: 0,0:53:48.22,0:53:50.06,Default,,0,0,0,,Оны ыңғайлы деп те айтуға болады.
Dialogue: 0,0:53:50.39,0:53:51.89,Default,,0,0,0,,Тіпті солай
Dialogue: 0,0:53:51.97,0:53:56.69,Default,,0,0,0,,Осы кемемен операцияны жалғастыру өте қиын болады деп есептейміз.
Dialogue: 0,0:53:56.77,0:53:58.48,Default,,0,0,0,,Хмм...
Dialogue: 0,0:53:59.65,0:54:00.98,Default,,0,0,0,,Мұнда рух бар.
Dialogue: 0,0:54:02.65,0:54:06.57,Default,,0,0,0,,Жағдай қаншалықты қиын болса да, не істеу керек екенін жасаңыз
Dialogue: 0,0:54:06.95,0:54:09.91,Default,,0,0,0,,Осылайша біз одан өттік.
Dialogue: 0,0:54:10.28,0:54:11.49,Default,,0,0,0,,Капитан
Dialogue: 0,0:54:11.62,0:54:12.45,Default,,0,0,0,,Бұйрық
Dialogue: 0,0:54:16.71,0:54:18.38,Default,,0,0,0,,Стратегияда өзгеріс жоқ
Dialogue: 0,0:54:18.46,0:54:21.13,Default,,0,0,0,,Кеме Беринг бұғазы арқылы өтті.
Dialogue: 0,0:54:21.21,0:54:24.34,Default,,0,0,0,,Мұсаши супер шайқасы патрульдейтін Солтүстік Мұзды мұхитқа ұмтылу
Dialogue: 0,0:54:24.59,0:54:27.51,Default,,0,0,0,,Жарайсыңдар! Мектептегі күндерім есіме түседі!
Dialogue: 0,0:54:28.01,0:54:30.01,Default,,0,0,0,,Капитан, жол анық.
Dialogue: 0,0:54:30.80,0:54:32.35,Default,,0,0,0,,Қозғалтқышты маған қалдырыңыз!
Dialogue: 0,0:54:33.81,0:54:35.60,Default,,0,0,0,,Рульді басқару үшін осы жерді басыңыз
Dialogue: 0,0:54:36.48,0:54:38.10,Default,,0,0,0,,I № 401!
Dialogue: 0,0:54:38.27,0:54:39.10,Default,,0,0,0,,Ұшыңыз!
Dialogue: 0,0:54:39.52,0:54:40.73,Default,,0,0,0,,Бастау
Dialogue: 0,0:54:49.32,0:54:52.62,Default,,0,0,0,,401 Владивостоктан шығып кетті
Dialogue: 0,0:54:52.70,0:54:55.58,Default,,0,0,0,,Солтүстікке бағыт алып, флагманға ұмтылу
Dialogue: 0,0:54:57.83,0:54:59.92,Default,,0,0,0,,Біз үшін емтихан мәселесі
Dialogue: 0,0:55:00.00,0:55:03.29,Default,,0,0,0,,Беринг бұғазының орталығында орналасқан Диомед аралдары
Dialogue: 0,0:55:03.38,0:55:07.38,Default,,0,0,0,,401 қай жолмен өтеді, шығыс немесе батыс?
Dialogue: 0,0:55:07.76,0:55:10.76,Default,,0,0,0,,Күштерді біркелкі бөлу керек пе?
Dialogue: 0,0:55:10.84,0:55:13.22,Default,,0,0,0,,№ Өткен шайқас деректерінен
Dialogue: 0,0:55:13.30,0:55:17.68,Default,,0,0,0,,Біз күш бөлу 401-ге қарсы тиімді емес деп санаймыз.
Dialogue: 0,0:55:18.02,0:55:20.23,Default,,0,0,0,,Сонымен, салмақты қай жағына қою керек?
Dialogue: 0,0:55:20.31,0:55:21.35,Default,,0,0,0,,Яма?
Dialogue: 0,0:55:21.44,0:55:24.11,Default,,0,0,0,,Мұндай негізсіз әдіс қабылданбайды.
Dialogue: 0,0:55:24.19,0:55:25.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:55:25.19,0:55:27.82,Default,,0,0,0,,Сонымен, бұл біз бұл аймақты толығымен қоршап алатынымызды білдіре ме?
Dialogue: 0,0:55:28.32,0:55:29.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:55:29.45,0:55:30.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:55:30.95,0:55:32.45,Default,,0,0,0,,Уау~
Dialogue: 0,0:55:32.53,0:55:34.28,Default,,0,0,0,,Стратегия келесідей
Dialogue: 0,0:55:34.83,0:55:39.41,Default,,0,0,0,,Біз, студенттік кеңес паркі, 401-ді анықтадық.
Dialogue: 0,0:55:39.50,0:55:42.04,Default,,0,0,0,,Кез келген бағытта жүгіруге болатын шекті нүкте
Dialogue: 0,0:55:43.84,0:55:46.92,Default,,0,0,0,,Диомед аралдарының солтүстігіне қарай кеңейеді
Dialogue: 0,0:55:56.10,0:55:59.64,Default,,0,0,0,,Қазіргі уақытта кеменің кейбір функцияларына шектеулер бар.
Dialogue: 0,0:56:00.19,0:56:01.90,Default,,0,0,0,,Әсіресе Клейнфилдпен
Dialogue: 0,0:56:01.98,0:56:05.19,Default,,0,0,0,,Өте ауырлық зеңбірегін қолдануға болмайтыны маңызды.
Dialogue: 0,0:56:05.27,0:56:08.53,Default,,0,0,0,,Бақытымызға орай, гравитон қозғалтқышында ақау жоқ.
Dialogue: 0,0:56:08.86,0:56:11.11,Default,,0,0,0,,Сүңгу тереңдігі Навигация жылдамдығы
Dialogue: 0,0:56:11.20,0:56:13.70,Default,,0,0,0,,Әуе қозғалысын басқаруда проблемалар бар
Dialogue: 0,0:56:13.95,0:56:15.70,Default,,0,0,0,,Басқару бағдарламалық құралын түзету
Dialogue: 0,0:56:15.78,0:56:17.70,Default,,0,0,0,,Мен импровизацияланған шектегішті қойдым.
Dialogue: 0,0:56:18.16,0:56:21.62,Default,,0,0,0,,Klein өрісі бойынша шуды болдырмау да жарамсыз.
Dialogue: 0,0:56:21.71,0:56:26.46,Default,,0,0,0,,Кеме шығаратын шу 150% жетеді деп күтілуде
Dialogue: 0,0:56:26.84,0:56:29.51,Default,,0,0,0,,Алдағы Диомед аралдарының айналасы
Dialogue: 0,0:56:29.59,0:56:32.72,Default,,0,0,0,,Тұманның патрульдік линияны орнату ықтималдығы жоғары.
Dialogue: 0,0:56:33.01,0:56:33.84,Default,,0,0,0,,Тыныштық!
Dialogue: 0,0:56:34.34,0:56:35.22,Default,,0,0,0,,Иә
Dialogue: 0,0:56:35.30,0:56:40.10,Default,,0,0,0,,Бұл Сан-Диегодағы АҚШ әскерилері ұсынған соңғы тренд ақпараты.
Dialogue: 0,0:56:40.18,0:56:44.15,Default,,0,0,0,,Диомедтің батыс жағында қатты ағыс бар.
Dialogue: 0,0:56:44.23,0:56:47.90,Default,,0,0,0,,Бұл теңіз деңгейі көтерілгенге дейін болмаған құбылыс.
Dialogue: 0,0:56:47.98,0:56:50.24,Default,,0,0,0,,Мен оған сене аламын ба? ол
Dialogue: 0,0:56:50.32,0:56:52.95,Default,,0,0,0,,Әскери-теңіз күштері азайса да,
Dialogue: 0,0:56:53.03,0:56:55.82,Default,,0,0,0,,Бұл Америка мен Ресей арасындағы шекара.
Dialogue: 0,0:56:55.91,0:56:58.24,Default,,0,0,0,,Сауалнаманың дәлдігіне кепілдік беріледі
Dialogue: 0,0:56:58.87,0:57:03.08,Default,,0,0,0,,Ағыс жолы біршама тар сай.
Dialogue: 0,0:57:03.71,0:57:05.63,Default,,0,0,0,,Терең сканерлеу деректерінен
Dialogue: 0,0:57:05.71,0:57:08.25,Default,,0,0,0,,Каньонның ең тар жерінде
Dialogue: 0,0:57:08.34,0:57:11.34,Default,,0,0,0,,Кеменің жалпы ені плюс 5 метр екенін айтады.
Dialogue: 0,0:57:11.97,0:57:14.01,Default,,0,0,0,,Су өшірілген күйде
Dialogue: 0,0:57:14.09,0:57:17.89,Default,,0,0,0,,Ояну турбуленттігінің әсерін болдырмай, өтіп кетсең пайдалы болар еді.
Dialogue: 0,0:57:17.97,0:57:19.22,Default,,0,0,0,,Сіз қалай ойлайсыз? бастықтың орынбасары
Dialogue: 0,0:57:19.85,0:57:22.14,Default,,0,0,0,,Егер сіз монах болсаңыз, жақсы емес пе?
Dialogue: 0,0:57:22.56,0:57:23.94,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:57:24.02,0:57:26.15,Default,,0,0,0,,Кем дегенде мені түзетіңіз.
Dialogue: 0,0:57:26.23,0:57:27.36,Default,,0,0,0,,Көріп көрейік
Dialogue: 0,0:57:30.28,0:57:31.57,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:57:31.65,0:57:33.53,Default,,0,0,0,,Әзірше маған қалдырыңыз
Dialogue: 0,0:57:51.63,0:57:52.67,Default,,0,0,0,,...
Dialogue: 0,0:57:52.76,0:57:56.26,Default,,0,0,0,,401 қол әлі табылған жоқ
Dialogue: 0,0:57:56.76,0:57:59.55,Default,,0,0,0,,Гравитонды қозғалтқыштың іздері ше?
Dialogue: 0,0:57:59.64,0:58:00.68,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:58:00.76,0:58:05.31,Default,,0,0,0,,Оның әлсіздігі сонша, оны Жерге жақын кеңістіктегі аспан денелері басып тастайды.
Dialogue: 0,0:58:05.39,0:58:07.40,Default,,0,0,0,,Артықшылық емес
Dialogue: 0,0:58:07.52,0:58:11.07,Default,,0,0,0,,401 осы аумақтан өтуі керек.
Dialogue: 0,0:58:11.73,0:58:15.20,Default,,0,0,0,,Суға батқан Пикет флотын бір флангқа қайта құру.
Dialogue: 0,0:58:15.32,0:58:18.41,Default,,0,0,0,,Сонарды анықтау бұдан да қатаңырақ болады.
Dialogue: 0,0:58:23.08,0:58:25.87,Default,,0,0,0,,Үнсіз жүгіру?
Dialogue: 0,0:58:26.37,0:58:29.71,Default,,0,0,0,,Бұл ежелгі сүңгуір қайық сияқты.
Dialogue: 0,0:58:29.96,0:58:32.67,Default,,0,0,0,,Дыбыс өткізбейтіндігі мінсіз екенін білсеңіз де
Dialogue: 0,0:58:32.75,0:58:34.84,Default,,0,0,0,,Біраз тыныш естіледі.
Dialogue: 0,0:58:35.47,0:58:38.18,Default,,0,0,0,,Субмаринердің табиғаты қандай?
Dialogue: 0,0:58:38.26,0:58:39.43,Default,,0,0,0,,Хехе
Dialogue: 0,0:58:39.51,0:58:40.60,Default,,0,0,0,,Ха! (Кёхэ) Иә?
Dialogue: 0,0:58:42.01,0:58:45.10,Default,,0,0,0,,Теңізде көп гравитонды қозғалтқыштың дыбысы
Dialogue: 0,0:58:45.64,0:58:47.23,Default,,0,0,0,,Нагара жеңіл крейсері
Dialogue: 0,0:58:47.31,0:58:48.27,Default,,0,0,0,,Ха...
Dialogue: 0,0:58:59.07,0:59:00.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:59:23.05,0:59:25.72,Default,,0,0,0,,Нагара сыныбы кетіп бара жатыр
Dialogue: 0,0:59:26.10,0:59:27.35,Default,,0,0,0,,Сақтықты төмендетпеңіз
Dialogue: 0,0:59:27.43,0:59:29.73,Default,,0,0,0,,Студенттік кеңестен әлі де адамдар бар.
Dialogue: 0,0:59:38.40,0:59:41.32,Default,,0,0,0,,Командирдің орынбасары 700 метр алда
Dialogue: 0,0:59:41.41,0:59:43.70,Default,,0,0,0,,Теңіз түбі тез көтерілуде.
Dialogue: 0,0:59:43.78,0:59:46.33,Default,,0,0,0,,Бұдан басқа порт жағында қисық сызық бар.
Dialogue: 0,0:59:47.08,0:59:49.54,Default,,0,0,0,,Йосоро
Dialogue: 0,0:59:58.13,1:00:00.76,Default,,0,0,0,,Жақында каньон арқылы өтеміз.
Dialogue: 0,1:00:14.06,1:00:15.69,Default,,0,0,0,,Хаа…
Dialogue: 0,1:00:16.23,1:00:18.78,Default,,0,0,0,,Бәрі жақсы болған сияқты.
Dialogue: 0,1:00:22.41,1:00:23.99,Default,,0,0,0,,Ха!
Dialogue: 0,1:00:24.82,1:00:26.66,Default,,0,0,0,,Бірдеңе... соқты ма?
Dialogue: 0,1:00:28.45,1:00:29.29,Default,,0,0,0,,Табылды
Dialogue: 0,1:00:29.41,1:00:30.25,Default,,0,0,0,,Жаман!
Dialogue: 0,1:00:30.50,1:00:32.17,Default,,0,0,0,,401 табылды
Dialogue: 0,1:00:32.25,1:00:35.50,Default,,0,0,0,,Диомед аралынан батысқа қарай 23 км
Dialogue: 0,1:00:35.84,1:00:38.34,Default,,0,0,0,,Су астындағы каньонда жасырынып жүріп шарлау
Dialogue: 0,1:00:38.63,1:00:40.42,Default,,0,0,0,,Нацистер керемет! Нацистер керемет!
Dialogue: 0,1:00:40.51,1:00:41.34,Default,,0,0,0,,Уухех~!
Dialogue: 0,1:00:41.59,1:00:43.18,Default,,0,0,0,,Тозақ құлақтары
Dialogue: 0,1:00:43.26,1:00:44.72,Default,,0,0,0,,Мен сізді тыңдаймын.
Dialogue: 0,1:00:45.30,1:00:47.14,Default,,0,0,0,,Жақсы жұмыс Нази
Dialogue: 0,1:00:47.22,1:00:51.64,Default,,0,0,0,,Әрбір кеме Негізінен Asrock торпедолары анықталған аймақта
Dialogue: 0,1:00:51.73,1:00:53.10,Default,,0,0,0,,Барлық тереңдік зарядтарын енгізіңіз
Dialogue: 0,1:00:54.35,1:00:57.32,Default,,0,0,0,,Қанықтыру шабуылымен 401-ді босатыңыз!
Dialogue: 0,1:00:58.23,1:01:00.99,Default,,0,0,0,,Алда теңіз бетіне көптеген су қонған дыбыстар!
Dialogue: 0,1:01:01.11,1:01:03.03,Default,,0,0,0,,Жоғары жылдамдықтағы қозғалтқыш дыбысы! Бұл торпедо!
Dialogue: 0,1:01:03.24,1:01:05.03,Default,,0,0,0,,Кёхэй! Кесу! (Кёхэ) О!
Dialogue: 0,1:01:05.11,1:01:06.95,Default,,0,0,0,,Басшының орынбасары! Төменгі сапар 10!
Dialogue: 0,1:01:07.08,1:01:09.41,Default,,0,0,0,,Бізге жол бермеу үлгісін қалдырыңыз! (Монах) Түсінді.
Dialogue: 0,1:01:09.49,1:01:13.46,Default,,0,0,0,,Көбірек қону дыбыстары! Торпедо тобына жету үшін 10!
Dialogue: 0,1:01:13.75,1:01:15.33,Default,,0,0,0,,Ат, ат!
Dialogue: 0,1:01:15.42,1:01:17.96,Default,,0,0,0,,Қырықша… әрине!
Dialogue: 0,1:01:18.42,1:01:20.71,Default,,0,0,0,,Кёхэй! Акустикалық торпедо 2 ұшырылды!
Dialogue: 0,1:01:20.80,1:01:22.22,Default,,0,0,0,,Сонымен қатар, Active Decoy 3!
Dialogue: 0,1:01:22.51,1:01:24.76,Default,,0,0,0,,Акустикалық торпеданың жарылуымен бір уақытта іске қосылады!
Dialogue: 0,1:01:24.84,1:01:25.97,Default,,0,0,0,,Мұз!
Dialogue: 0,1:01:30.10,1:01:31.85,Default,,0,0,0,,Егер сізге бір оқ тиіп кетсе, бұл Будда!
Dialogue: 0,1:01:36.19,1:01:37.31,Default,,0,0,0,,Уау!
Dialogue: 0,1:01:37.40,1:01:39.77,Default,,0,0,0,,Эрозия торпедосы! Садақ жанында жарылыс!
Dialogue: 0,1:01:39.98,1:01:43.15,Default,,0,0,0,,Артқы бөлік 1, 4 және 8 су астында қалды!
Dialogue: 0,1:01:43.32,1:01:44.40,Default,,0,0,0,,Зақымдануды бақылау!
Dialogue: 0,1:01:48.70,1:01:50.74,Default,,0,0,0,,Су өткізбейтін қалқалардың жабылуын тексеріңіз
Dialogue: 0,1:01:50.83,1:01:52.12,Default,,0,0,0,,Су төгетін сорғы іске қосылды!
Dialogue: 0,1:01:52.58,1:01:54.04,Default,,0,0,0,,Флот балансын реттеу орындалуда
Dialogue: 0,1:01:54.12,1:01:54.96,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:55.04,1:01:55.96,Default,,0,0,0,,(Айқай)
Dialogue: 0,1:01:56.21,1:01:57.67,Default,,0,0,0,,Ха! (Гунзо) Иори! Шығу!
Dialogue: 0,1:01:57.75,1:01:58.75,Default,,0,0,0,,Иори!
Dialogue: 0,1:01:58.84,1:02:00.92,Default,,0,0,0,,Жарайды! Аздап дымқыл
Dialogue: 0,1:02:01.17,1:02:02.76,Default,,0,0,0,,Артқы жағында да сезім
Dialogue: 0,1:02:02.84,1:02:05.51,Default,,0,0,0,,Бұрынғы жеңіл крейсер қайтып келеді.
Dialogue: 0,1:02:05.59,1:02:06.84,Default,,0,0,0,,Қашықтық 20
Dialogue: 0,1:02:06.93,1:02:09.93,Default,,0,0,0,,Бұл кеменің айналасында қоршау құрылуда!
Dialogue: 0,1:02:10.26,1:02:13.27,Default,,0,0,0,,Жоқ, студенттік кеңес пен жеңіл патруль шымшу шабуылда.\NЕсептің
Dialogue: 0,1:02:15.39,1:02:16.23,Default,,0,0,0,,Уф...
Dialogue: 0,1:02:19.94,1:02:21.77,Default,,0,0,0,,401
Dialogue: 0,1:02:21.86,1:02:24.61,Default,,0,0,0,,Менің ойымша, біз шамамен 80% өтей алдық.
Dialogue: 0,1:02:24.69,1:02:25.53,Default,,0,0,0,,Миоко
Dialogue: 0,1:02:25.78,1:02:26.61,Default,,0,0,0,,Ха!
Dialogue: 0,1:02:53.26,1:02:54.22,Default,,0,0,0,,Батып кету
Dialogue: 0,1:02:57.39,1:02:58.27,Default,,0,0,0,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,1:02:58.94,1:03:01.98,Default,,0,0,0,,Айналадағы жеңіл крейсерлер шабуылда.
Dialogue: 0,1:03:02.06,1:03:02.90,Default,,0,0,0,,Не?
Dialogue: 0,1:03:14.99,1:03:18.16,Default,,0,0,0,,Эй, сен не істеп жатырсың? 401!
Dialogue: 0,1:03:18.25,1:03:20.12,Default,,0,0,0,,Мен күлкілі болатындай шым-шытырық емеспін
Dialogue: 0,1:03:20.21,1:03:21.79,Default,,0,0,0,,Иона апа~!
Dialogue: 0,1:03:21.88,1:03:24.46,Default,,0,0,0,,Махаббаттың құдіреті арқылы мен оны ақыры қолға алдым!
Dialogue: 0,1:03:24.55,1:03:25.88,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,1:03:25.96,1:03:28.17,Default,,0,0,0,,Мен Мёконың мақсатын орындаған жоқпын!
Dialogue: 0,1:03:28.26,1:03:29.72,Default,,0,0,0,,Бұл не?!
Dialogue: 0,1:03:30.09,1:03:31.72,Default,,0,0,0,,Такао! Хюга!
Dialogue: 0,1:03:31.97,1:03:34.60,Default,,0,0,0,,4-ші шайқас тобы 8-ші ұрыс тобы
Dialogue: 0,1:03:35.10,1:03:37.02,Default,,0,0,0,,Ауыр Такао крейсеріне асығыңыз!
Dialogue: 0,1:03:37.48,1:03:40.06,Default,,0,0,0,,Хюуга! Барлығы бірден 401...
Dialogue: 0,1:03:40.14,1:03:40.98,Default,,0,0,0,,(Айқай)
Dialogue: 0,1:03:50.74,1:03:53.78,Default,,0,0,0,,Кеменің артында сағат 7-дегі кеменің көрінісі бар!
Dialogue: 0,1:03:53.87,1:03:54.70,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:04:07.34,1:04:08.17,Default,,0,0,0,,(Ичи) Вице-канцлермен кездесуге әлі біраз уақыт бар, бірақ—
Dialogue: 0,1:04:14.85,1:04:17.18,Default,,0,0,0,,Харуна Киришима!
Dialogue: 0,1:04:17.68,1:04:19.93,Default,,0,0,0,,Капитан Чихая, мен сені қолдаймын!
Dialogue: 0,1:04:20.02,1:04:22.81,Default,,0,0,0,,Маки! Неге тіпті сен?
Dialogue: 0,1:04:22.90,1:04:25.15,Default,,0,0,0,,Қазір істеу керек нәрсені жасаңыз!
Dialogue: 0,1:04:25.23,1:04:27.07,Default,,0,0,0,,Капитан Чихая бұлай айтқан жоқ.
Dialogue: 0,1:04:28.57,1:04:29.82,Default,,0,0,0,,Балалар...
Dialogue: 0,1:04:30.32,1:04:32.74,Default,,0,0,0,,Біз осылай шештік
Dialogue: 0,1:04:32.82,1:04:35.87,Default,,0,0,0,,Менің досым қысылып қалды, сондықтан мен асығуым керек!
Dialogue: 0,1:04:35.95,1:04:36.78,Default,,0,0,0,,Эй!
Dialogue: 0,1:04:36.87,1:04:39.12,Default,,0,0,0,,Джобу резиденциясының қарызы өтеледі.
Dialogue: 0,1:04:39.20,1:04:40.04,Default,,0,0,0,,Хмф!
Dialogue: 0,1:04:40.45,1:04:42.83,Default,,0,0,0,,Балалар, сендер қалай жөнелтеміз?
Dialogue: 0,1:04:42.92,1:04:43.75,Default,,0,0,0,,Қарызға алынған наноматериалдар
Dialogue: 0,1:04:43.83,1:04:44.67,Default,,0,0,0,,…қашып кету…
Dialogue: 0,1:04:44.75,1:04:45.88,Default,,0,0,0,,Кім!
Dialogue: 0,1:04:46.04,1:04:47.96,Default,,0,0,0,,Өтіп бара жатқан жеңіл крейсерге
Dialogue: 0,1:04:48.05,1:04:49.76,Default,,0,0,0,,Барлығыңызға рахмет
Dialogue: 0,1:04:53.38,1:04:55.60,Default,,0,0,0,,Біз көк флотпыз
Dialogue: 0,1:04:55.68,1:04:56.51,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,1:04:58.39,1:04:59.47,Default,,0,0,0,,О
Dialogue: 0,1:05:01.10,1:05:02.94,Default,,0,0,0,,Бұдан былай көк флот
Dialogue: 0,1:05:03.02,1:05:05.69,Default,,0,0,0,,«Мусаши» супер боевикінің әрекеттерін болдырмау
Dialogue: 0,1:05:05.77,1:05:07.65,Default,,0,0,0,,Осы теңіз аймағынан өтіңіз!
Dialogue: 0,1:05:07.73,1:05:09.07,Default,,0,0,0,,Польнарефф?
Dialogue: 0,1:05:09.94,1:05:12.95,Default,,0,0,0,,Hiei Бұл кеме бұзылған.
Dialogue: 0,1:05:13.03,1:05:14.53,Default,,0,0,0,,Түзету уақытты қажет етеді
Dialogue: 0,1:05:14.91,1:05:16.20,Default,,0,0,0,,Е...
Dialogue: 0,1:05:16.28,1:05:20.08,Default,,0,0,0,,Жауынгерлік кеме сияқты күшейткіштердің болуы аздап қулық емес пе?
Dialogue: 0,1:05:20.58,1:05:23.00,Default,,0,0,0,,Менің бейшара апаларым да
Dialogue: 0,1:05:23.08,1:05:25.17,Default,,0,0,0,,Бұл Көк флот па?
Dialogue: 0,1:05:25.46,1:05:27.13,Default,,0,0,0,,Мұндай мектеп тәртібін бұзу
Dialogue: 0,1:05:27.21,1:05:29.13,Default,,0,0,0,,Мен мұны мойындай алмаймын!
Dialogue: 0,1:05:29.21,1:05:30.09,Default,,0,0,0,,Мен оқудан шығарылдым!
Dialogue: 0,1:05:30.59,1:05:33.30,Default,,0,0,0,,Тіркелгенім есімде жоқ!
Dialogue: 0,1:05:34.88,1:05:36.72,Default,,0,0,0,,Маки командасы
Dialogue: 0,1:05:37.14,1:05:38.26,Default,,0,0,0,,Иә
Dialogue: 0,1:05:38.35,1:05:42.14,Default,,0,0,0,,Бұдан былай біз 401-ді қолдаймыз!
Dialogue: 0,1:05:42.81,1:05:44.89,Default,,0,0,0,,Барлық қару қақпалары ашық!
Dialogue: 0,1:05:52.86,1:05:54.95,Default,,0,0,0,,Толық өрт!
Dialogue: 0,1:05:55.03,1:05:56.91,Default,,0,0,0,,Дұрыс, дұрыс.
Dialogue: 0,1:05:57.03,1:05:59.62,Default,,0,0,0,,Урия Урья Урья~!
Dialogue: 0,1:06:07.00,1:06:09.38,Default,,0,0,0,,Жеңіл крейсер үнсіздігі
Dialogue: 0,1:06:10.88,1:06:12.00,Default,,0,0,0,,Студенттік кеңес Барлық кемелер
Dialogue: 0,1:06:12.09,1:06:13.97,Default,,0,0,0,,Құрылым трапеция тәрізді формацияға ауысады!
Dialogue: 0,1:06:14.55,1:06:15.93,Default,,0,0,0,,Ашигара! Хагро!
Dialogue: 0,1:06:16.01,1:06:18.09,Default,,0,0,0,,Оң жақта менен алда бол!
Dialogue: 0,1:06:18.18,1:06:21.56,Default,,0,0,0,,Хмм... Баспалдақ түзіліс дегеніміз не?
Dialogue: 0,1:06:23.10,1:06:24.52,Default,,0,0,0,,Хмм.
Dialogue: 0,1:06:24.60,1:06:26.64,Default,,0,0,0,,Тактика анық.
Dialogue: 0,1:06:26.73,1:06:28.23,Default,,0,0,0,,Студенттер кеңесінің төрағасы
Dialogue: 0,1:06:32.19,1:06:34.61,Default,,0,0,0,,Айналыңыз және уақытты реттеңіз
Dialogue: 0,1:06:34.82,1:06:35.99,Default,,0,0,0,,Польнарефф?
Dialogue: 0,1:06:36.07,1:06:37.61,Default,,0,0,0,,Бір мезгілде шабуыл! атыс!
Dialogue: 0,1:06:44.83,1:06:46.12,Default,,0,0,0,,Сол жалған жылы жүзді жігіт! Ол шынымен де мұны салқын жүзбен айтты!
Dialogue: 0,1:06:46.21,1:06:47.37,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,1:06:52.21,1:06:53.71,Default,,0,0,0,,Күте тұрыңыз! Ашигара!
Dialogue: 0,1:06:53.80,1:06:55.97,Default,,0,0,0,,Құрылымды бұзбаңыз!
Dialogue: 0,1:06:57.26,1:06:59.09,Default,,0,0,0,,формацияны қалыптастыруға уақыт болса
Dialogue: 0,1:06:59.18,1:07:01.51,Default,,0,0,0,,Шабуыл жылдамырақ!
Dialogue: 0,1:07:01.80,1:07:03.60,Default,,0,0,0,,Мен келісемін~
Dialogue: 0,1:07:19.16,1:07:21.07,Default,,0,0,0,,Ашигара! Хагро!
Dialogue: 0,1:07:21.16,1:07:21.99,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,1:07:22.83,1:07:23.66,Default,,0,0,0,,Хагро!
Dialogue: 0,1:07:26.50,1:07:28.66,Default,,0,0,0,,Тез! сен не істейсің?
Dialogue: 0,1:07:29.29,1:07:31.63,Default,,0,0,0,,Мақсат - бізді бұзу.
Dialogue: 0,1:07:31.71,1:07:34.80,Default,,0,0,0,,Мақсат – ынтымақтастығымызды бөлу.
Dialogue: 0,1:07:35.42,1:07:37.88,Default,,0,0,0,,Иә! Бұл...
Dialogue: 0,1:07:37.97,1:07:38.80,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,1:07:39.59,1:07:42.18,Default,,0,0,0,,Қандай тітіркендіргіш шабуыл!
Dialogue: 0,1:07:45.60,1:07:46.77,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,1:07:47.02,1:07:49.85,Default,,0,0,0,,Бұл балалар өз істерімен айналысады.
Dialogue: 0,1:07:49.94,1:07:52.56,Default,,0,0,0,,Hiei Avoidable Бұған да қолдау көрсетіледі.
Dialogue: 0,1:07:53.11,1:07:55.69,Default,,0,0,0,,Миоко Хюгадан бұзу туралы не деуге болады?
Dialogue: 0,1:07:56.28,1:07:59.70,Default,,0,0,0,,Снайперлік жүйе бэкдор арқылы басқарылады
Dialogue: 0,1:08:00.57,1:08:02.32,Default,,0,0,0,,401
Dialogue: 0,1:08:09.33,1:08:10.75,Default,,0,0,0,,Іске қосу
Dialogue: 0,1:08:20.09,1:08:20.93,Default,,0,0,0,,Уф...
Dialogue: 0,1:08:25.14,1:08:27.35,Default,,0,0,0,,Уау!
Dialogue: 0,1:08:27.60,1:08:29.56,Default,,0,0,0,,Ха! Капитан!
Dialogue: 0,1:08:29.64,1:08:30.48,Default,,0,0,0,,Әпке!
Dialogue: 0,1:08:36.48,1:08:37.32,Default,,0,0,0,,Харуна!
Dialogue: 0,1:08:37.40,1:08:40.49,Default,,0,0,0,,Біз 401 соққан жерге бара жатырмыз!
Dialogue: 0,1:08:40.86,1:08:41.99,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:08:42.20,1:08:44.62,Default,,0,0,0,,Мен сені бұл жерден жібермеймін!
Dialogue: 0,1:08:44.91,1:08:48.79,Default,,0,0,0,,Такао ауыр крейсері! Сіздің қарсыласыңыз мен!
Dialogue: 0,1:08:49.16,1:08:50.54,Default,,0,0,0,,Осындай уақытта!
Dialogue: 0,1:08:50.62,1:08:51.91,Default,,0,0,0,,Бұл жерден кет!
Dialogue: 0,1:08:52.21,1:08:54.54,Default,,0,0,0,,Барар алдында мені жең!
Dialogue: 0,1:08:54.79,1:08:58.17,Default,,0,0,0,,Сіз маған жолдан кетіңіз дедіңіз!
Dialogue: 0,1:09:05.76,1:09:06.97,Default,,0,0,0,,Шабуыл қайдан келеді?
Dialogue: 0,1:09:07.10,1:09:08.26,Default,,0,0,0,,Анықталмайды!
Dialogue: 0,1:09:08.35,1:09:11.93,Default,,0,0,0,,Бұл біздің жаудың іздеу аймағынан тыс өте алыс қашықтықтағы мергендік ату!
Dialogue: 0,1:09:12.64,1:09:14.15,Default,,0,0,0,,Екінші атуға дайындық
Dialogue: 0,1:09:14.60,1:09:15.44,Default,,0,0,0,,Нацистік
Dialogue: 0,1:09:15.69,1:09:16.73,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:09:16.81,1:09:18.94,Default,,0,0,0,,Сақтау деректерін синхрондау
Dialogue: 0,1:09:19.53,1:09:21.40,Default,,0,0,0,,Мәліметтерді анықтау
Dialogue: 0,1:09:21.99,1:09:23.70,Default,,0,0,0,,Синхрондау аяқталды
Dialogue: 0,1:09:31.08,1:09:31.91,Default,,0,0,0,,Ах!
Dialogue: 0,1:09:32.12,1:09:32.96,Default,,0,0,0,,Ха!
Dialogue: 0,1:09:36.25,1:09:37.96,Default,,0,0,0,,Уау!
Dialogue: 0,1:09:45.09,1:09:46.72,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:09:47.22,1:09:48.26,Default,,0,0,0,,Алайда, кейбір қарсыластар қашып кетті
Dialogue: 0,1:09:48.35,1:09:49.72,Default,,0,0,0,,Макиден күткендей.
Dialogue: 0,1:09:50.31,1:09:51.22,Default,,0,0,0,,Тек таңдаулы бірнешеуге ғана тән делінген күш—
Dialogue: 0,1:09:51.77,1:09:54.23,Default,,0,0,0,,Харухару мен Йотаро Клейнфилд
Dialogue: 0,1:09:54.31,1:09:56.60,Default,,0,0,0,,Мен оны торға орналастырдым.
Dialogue: 0,1:09:57.10,1:09:59.27,Default,,0,0,0,,Рэйлей шашырауын қолдану!
Dialogue: 0,1:09:59.36,1:10:02.07,Default,,0,0,0,,Бұл екі кемені қорғай алады.
Dialogue: 0,1:10:02.15,1:10:06.20,Default,,0,0,0,,Хаа... Макидің болғанына қуаныштымын.
Dialogue: 0,1:10:06.28,1:10:07.36,Default,,0,0,0,,Мм.
Dialogue: 0,1:10:07.99,1:10:10.58,Default,,0,0,0,,Алысқа қарасаң, соғыласың!
Dialogue: 0,1:10:10.78,1:10:13.75,Default,,0,0,0,,Жеңдер!
Dialogue: 0,1:10:14.29,1:10:15.50,Default,,0,0,0,,О, бұл…
Dialogue: 0,1:10:15.58,1:10:16.42,Default,,0,0,0,,Ей!
Dialogue: 0,1:10:16.54,1:10:18.42,Default,,0,0,0,,Бұл қауіпті!
Dialogue: 0,1:10:18.67,1:10:21.92,Default,,0,0,0,,Егер сіз әскери кеме болсаңыз, кеме сияқты шайқасыңыз!
Dialogue: 0,1:10:22.09,1:10:24.92,Default,,0,0,0,,Бұл менің күресу тәсілім!
Dialogue: 0,1:10:25.88,1:10:28.01,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:10:28.09,1:10:29.39,Default,,0,0,0,,Уау!
Dialogue: 0,1:10:30.64,1:10:31.89,Default,,0,0,0,,Қашпа!
Dialogue: 0,1:10:32.18,1:10:34.64,Default,,0,0,0,,Мына бала есінен танып қалды!
Dialogue: 0,1:10:35.27,1:10:38.98,Default,,0,0,0,,Біз 401-ді қорғауды жалғастырамыз және теңіз аймағын бұзып өтеміз!
Dialogue: 0,1:10:39.06,1:10:39.98,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:10:40.23,1:10:42.11,Default,,0,0,0,,Мен сізге бұлай істеуге мүмкіндік бере алмаймын.
Dialogue: 0,1:10:47.57,1:10:49.57,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,1:10:49.66,1:10:52.62,Default,,0,0,0,,Ұлы жауынгерлік кемелер класын бағаламаңыз!
Dialogue: 0,1:11:03.17,1:11:04.67,Default,,0,0,0,,Джек пышақ!
Dialogue: 0,1:11:04.92,1:11:08.34,Default,,0,0,0,,Менің ұтқырлығым тұман флотындағы ең жақсы!
Dialogue: 0,1:11:08.43,1:11:09.97,Default,,0,0,0,,Жеңіске жету мүмкін емес.
Dialogue: 0,1:11:11.01,1:11:13.64,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:11:13.72,1:11:15.18,Default,,0,0,0,,(Такаоның айқайы)
Dialogue: 0,1:11:15.31,1:11:18.48,Default,,0,0,0,,Қазірдің өзінде! Бұл әскери кеменің қаруы емес!
Dialogue: 0,1:11:18.56,1:11:19.73,Default,,0,0,0,,Олай ма?
Dialogue: 0,1:11:19.81,1:11:21.56,Default,,0,0,0,,Сіз оны да жүктеп жатырсыз, солай емес пе?
Dialogue: 0,1:11:21.65,1:11:22.48,Default,,0,0,0,,Иә?
Dialogue: 0,1:11:22.56,1:11:23.82,Default,,0,0,0,,Қарап көріңіз!
Dialogue: 0,1:11:23.90,1:11:25.07,Default,,0,0,0,,Не? не?
Dialogue: 0,1:11:25.86,1:11:26.94,Default,,0,0,0,,Иә?
Dialogue: 0,1:11:28.61,1:11:30.03,Default,,0,0,0,,Ол осы мамандық атауын беруге тікелей шабыт болған —
Dialogue: 0,1:11:30.32,1:11:31.16,Default,,0,0,0,,Ха!
Dialogue: 0,1:11:32.49,1:11:34.12,Default,,0,0,0,,Иә?
Dialogue: 0,1:11:37.25,1:11:38.91,Default,,0,0,0,,Бұл... не?
Dialogue: 0,1:11:39.04,1:11:40.79,Default,,0,0,0,,Иво Джимада қолданылған
Dialogue: 0,1:11:40.87,1:11:43.71,Default,,0,0,0,,Магманы өндіруге арналған бұрғылау жүйесі
Dialogue: 0,1:11:43.79,1:11:45.09,Default,,0,0,0,,Жақсы көрінеді, солай ма?
Dialogue: 0,1:11:45.17,1:11:47.67,Default,,0,0,0,,Неліктен менің үстімде осының бәрі бар?
Dialogue: 0,1:11:47.76,1:11:49.97,Default,,0,0,0,,Сіз супер гравитациялық зеңбіректі қайда қойдыңыз!
Dialogue: 0,1:11:50.05,1:11:51.84,Default,,0,0,0,,Мұндай сән-салтанат
Dialogue: 0,1:11:51.93,1:11:55.22,Default,,0,0,0,,Оны шектеулі наноматериалдармен жасауға болмайды, солай ма?
Dialogue: 0,1:11:55.31,1:11:57.18,Default,,0,0,0,,Тэхе Бұл Тэхе емес!
Dialogue: 0,1:11:57.60,1:11:59.06,Default,,0,0,0,,Қызық екен!
Dialogue: 0,1:11:59.14,1:12:01.10,Default,,0,0,0,,Бұл тамаша!
Dialogue: 0,1:12:01.81,1:12:03.73,Default,,0,0,0,,A сыныбы Тодорокидің мұздату шабуылымен алға шықты, бірақ
Dialogue: 0,1:12:10.24,1:12:13.07,Default,,0,0,0,,Керемет! керемет!
Dialogue: 0,1:12:13.45,1:12:15.12,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:12:15.20,1:12:16.79,Default,,0,0,0,,Керемет!
Dialogue: 0,1:12:17.62,1:12:19.37,Default,,0,0,0,,Рэйлей шашырауы...
Dialogue: 0,1:12:19.46,1:12:22.96,Default,,0,0,0,,Бұл жағдайда өте ұзақ қашықтықтағы мергендік дерлік мағынасыз.
Dialogue: 0,1:12:23.63,1:12:24.71,Default,,0,0,0,,...
Dialogue: 0,1:12:24.88,1:12:27.71,Default,,0,0,0,,Адамның тапқырлығы осы ма?
Dialogue: 0,1:12:27.96,1:12:29.51,Default,,0,0,0,,Неге ол маған ештеңе айтпады екен?
Dialogue: 0,1:12:29.59,1:12:32.01,Default,,0,0,0,,Барлығы, кеменің от сызығынан аулақ болыңдар.
Dialogue: 0,1:12:32.09,1:12:33.89,Default,,0,0,0,,Мен батып кетемін
Dialogue: 0,1:12:34.30,1:12:35.97,Default,,0,0,0,,Егер ол қабылданбаса
Dialogue: 0,1:12:36.06,1:12:38.47,Default,,0,0,0,,Орбитаны оқудың қажеті жоқ.
Dialogue: 0,1:12:40.14,1:12:41.02,Default,,0,0,0,,...
Dialogue: 0,1:12:41.23,1:12:43.44,Default,,0,0,0,,Егер сіз сонда болмасаңыз
Dialogue: 0,1:12:43.52,1:12:46.44,Default,,0,0,0,,Біз бақытты болып қала алар едік!
Dialogue: 0,1:12:51.53,1:12:52.78,Default,,0,0,0,,Ха!
Dialogue: 0,1:12:54.66,1:12:55.78,Default,,0,0,0,,Не!
Dialogue: 0,1:12:57.49,1:12:58.49,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:12:58.58,1:12:59.54,Default,,0,0,0,,...
Dialogue: 0,1:12:59.62,1:13:02.46,Default,,0,0,0,,Шығыс жеңіл крейсер флоты бұзылды.
Dialogue: 0,1:13:02.54,1:13:04.75,Default,,0,0,0,,Бұл кезеңге нақты кім қатысты?
Dialogue: 0,1:13:15.01,1:13:16.01,Default,,0,0,0,,Ах...
Dialogue: 0,1:13:16.18,1:13:17.26,Default,,0,0,0,,Міне!
Dialogue: 0,1:13:23.77,1:13:26.73,Default,,0,0,0,,Хии, ол қиын жігіт.
Dialogue: 0,1:13:33.95,1:13:34.78,Default,,0,0,0,,Конгоу!
Dialogue: 0,1:13:35.16,1:13:36.57,Default,,0,0,0,,тым кеш болды.
Dialogue: 0,1:13:37.07,1:13:38.62,Default,,0,0,0,,Конгоу мырза...
Dialogue: 0,1:13:38.70,1:13:40.49,Default,,0,0,0,,Жоқ, Конгоу…
Dialogue: 0,1:13:40.58,1:13:41.87,Default,,0,0,0,,Мұнда қалай келдіңіз?
Dialogue: 0,1:13:41.95,1:13:44.50,Default,,0,0,0,,Біз әлсіз болған шығыс жақтан.
Dialogue: 0,1:13:44.87,1:13:45.83,Default,,0,0,0,,О
Dialogue: 0,1:13:45.92,1:13:50.75,Default,,0,0,0,,Өкінетін дәрежеде ұйымдастырылған Пикет флотын суға батырдың ба?
Dialogue: 0,1:13:50.84,1:13:52.88,Default,,0,0,0,,Ол кедей әпке.
Dialogue: 0,1:13:53.84,1:13:56.34,Default,,0,0,0,,Мен сенің әпкең емеспін!
Dialogue: 0,1:13:56.72,1:13:57.97,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:13:58.05,1:14:01.77,Default,,0,0,0,,Я... Жаман! Сен қазір не істеп жатырсын?
Dialogue: 0,1:14:01.85,1:14:03.10,Default,,0,0,0,,...
Dialogue: 0,1:14:03.48,1:14:05.85,Default,,0,0,0,,Бұл бірінші кемеге арналған сәлемдеме ме?
Dialogue: 0,1:14:06.23,1:14:09.57,Default,,0,0,0,,Мен енді Шығыс флотының флагманымын!
Dialogue: 0,1:14:09.65,1:14:13.53,Default,,0,0,0,,Сіздей ақауы бар бұйымның қайтатын жері жоқ!
Dialogue: 0,1:14:13.94,1:14:15.74,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,1:14:15.82,1:14:18.66,Default,,0,0,0,,Қайда оралу керектігін шешіңіз!
Dialogue: 0,1:14:25.79,1:14:26.87,Default,,0,0,0,,Уф...
Dialogue: 0,1:14:27.42,1:14:29.04,Default,,0,0,0,,Иә! Уф...
Dialogue: 0,1:14:29.88,1:14:33.59,Default,,0,0,0,,Егер сіз 401-ді ренжіте берсеңіз,
Dialogue: 0,1:14:33.80,1:14:35.51,Default,,0,0,0,,Мен сенмін
Dialogue: 0,1:14:37.09,1:14:38.26,Default,,0,0,0,,раковина
Dialogue: 0,1:14:38.89,1:14:40.26,Default,,0,0,0,,Ха!
Dialogue: 0,1:14:41.01,1:14:42.01,Default,,0,0,0,,Конго…
Dialogue: 0,1:14:44.22,1:14:45.68,Default,,0,0,0,,Конго…
Dialogue: 0,1:14:47.90,1:14:48.77,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:14:49.77,1:14:51.11,Default,,0,0,0,,Сізді алып тастау үшін
Dialogue: 0,1:14:51.19,1:14:52.61,Default,,0,0,0,,Басымдық
Dialogue: 0,1:14:53.03,1:14:54.49,Default,,0,0,0,,Өте ауырлық зеңбірегі!
Dialogue: 0,1:14:54.69,1:14:55.99,Default,,0,0,0,,Өрт!
Dialogue: 0,1:15:09.75,1:15:11.21,Default,,0,0,0,,Соғыстың максималды жылдамдығы
Dialogue: 0,1:15:18.47,1:15:19.51,Default,,0,0,0,,Ха!
Dialogue: 0,1:15:19.59,1:15:20.97,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,1:15:39.91,1:15:41.24,Default,,0,0,0,,Бұл...
Dialogue: 0,1:15:52.54,1:15:53.46,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:15:54.00,1:15:55.71,Default,,0,0,0,,Бұл мектеп тәртібін бұзу!
Dialogue: 0,1:15:55.80,1:15:58.92,Default,,0,0,0,,Конгоу класындағы бірінші кеме болса да!
Dialogue: 0,1:15:59.01,1:16:00.47,Default,,0,0,0,,Қандай ұят!
Dialogue: 0,1:16:00.59,1:16:02.80,Default,,0,0,0,,Хии, мен саған айтамын.
Dialogue: 0,1:16:03.18,1:16:05.97,Default,,0,0,0,,Тәртіп – өзіңді бақылау.
Dialogue: 0,1:16:06.06,1:16:08.02,Default,,0,0,0,,Басқаларға таңуға болмайды
Dialogue: 0,1:16:08.39,1:16:10.31,Default,,0,0,0,,Осындай софизммен сіз
Dialogue: 0,1:16:10.39,1:16:12.65,Default,,0,0,0,,Тұманды тастадым дейсің!
Dialogue: 0,1:16:15.57,1:16:16.94,Default,,0,0,0,,Конгоу!
Dialogue: 0,1:16:28.00,1:16:28.83,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:16:29.71,1:16:31.50,Default,,0,0,0,,Күресудің жолы қандай
Dialogue: 0,1:16:33.79,1:16:38.01,Default,,0,0,0,,401... Не істеп жатырсың?
Dialogue: 0,1:16:38.09,1:16:38.92,Default,,0,0,0,,Ха!
Dialogue: 0,1:16:40.26,1:16:42.18,Default,,0,0,0,,Сен ондай емессің.
Dialogue: 0,1:16:42.26,1:16:44.72,Default,,0,0,0,,Бұл көмектесуге тұрарлық емес пе?
Dialogue: 0,1:16:45.35,1:16:47.06,Default,,0,0,0,,Конго…
Dialogue: 0,1:16:49.02,1:16:50.81,Default,,0,0,0,,Мен...
Dialogue: 0,1:16:51.81,1:16:53.31,Default,,0,0,0,,Бұл мен емес едім
Dialogue: 0,1:16:54.44,1:16:55.81,Default,,0,0,0,,Сонымен не?
Dialogue: 0,1:16:56.06,1:16:58.23,Default,,0,0,0,,Жалпы флагмандық Ямато
Dialogue: 0,1:16:58.53,1:17:00.15,Default,,0,0,0,,Сақтық көшірме…
Dialogue: 0,1:17:02.70,1:17:05.24,Default,,0,0,0,,Менің жаратылған мақсатым
Dialogue: 0,1:17:05.32,1:17:09.24,Default,,0,0,0,,Шо Чихаяның ұлы Гунзомен кездесуі
Dialogue: 0,1:17:09.33,1:17:12.37,Default,,0,0,0,,Әке өсиетін жалғастыру
Dialogue: 0,1:17:12.79,1:17:17.59,Default,,0,0,0,,Яматоның соңғы тілегі бұйрыққа айналды.
Dialogue: 0,1:17:23.09,1:17:26.60,Default,,0,0,0,,Демек, бұл Яматоның өзін тірілту үшін жасаған қадамы ма?
Dialogue: 0,1:17:26.97,1:17:28.60,Default,,0,0,0,,тапқыр
Dialogue: 0,1:17:28.97,1:17:31.56,Default,,0,0,0,,Мұсашидің ашуын тоқтату
Dialogue: 0,1:17:31.64,1:17:34.77,Default,,0,0,0,,Мен Яматоның орнын алуым керек.
Dialogue: 0,1:17:35.15,1:17:37.36,Default,,0,0,0,,Сол кезде мен...
Dialogue: 0,1:17:38.98,1:17:41.40,Default,,0,0,0,,Мен жоғалып кетемін...
Dialogue: 0,1:17:45.36,1:17:47.24,Default,,0,0,0,,Оның жоғалып кетуі мүмкін емес, солай ма?
Dialogue: 0,1:17:48.45,1:17:49.37,Default,,0,0,0,,Ха...
Dialogue: 0,1:17:49.74,1:17:53.29,Default,,0,0,0,,Сенің бар болуың әрқашан менің ішімде болады.
Dialogue: 0,1:17:53.54,1:17:55.67,Default,,0,0,0,,Бұдан былай саған не болғанына қарамастан
Dialogue: 0,1:17:55.75,1:17:57.75,Default,,0,0,0,,Менің есімде қалғанша
Dialogue: 0,1:17:57.83,1:18:00.88,Default,,0,0,0,,Сенің сонда болғаның ешқашан жоғалмайды.
Dialogue: 0,1:18:02.05,1:18:04.05,Default,,0,0,0,,Маған дүниені бер
Dialogue: 0,1:18:04.59,1:18:08.22,Default,,0,0,0,,Дүниемен байланысымды сыйлаған сенсің.
Dialogue: 0,1:18:09.22,1:18:12.77,Default,,0,0,0,,Егер сіз өзіңізді жоққа шығара бастасаңыз ше?
Dialogue: 0,1:18:13.14,1:18:15.89,Default,,0,0,0,,Менде тұрған ток жоқ па?
Dialogue: 0,1:18:17.85,1:18:19.44,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,1:18:20.86,1:18:23.69,Default,,0,0,0,,Мен сені ұмытпаймын
Dialogue: 0,1:18:24.86,1:18:26.20,Default,,0,0,0,,Барлық оқтарыңды жауға беріңдер!!
Dialogue: 0,1:18:26.28,1:18:28.03,Default,,0,0,0,,Олар байланысты ма?
Dialogue: 0,1:18:28.82,1:18:30.62,Default,,0,0,0,,Ха...
Dialogue: 0,1:18:31.41,1:18:32.99,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:18:33.45,1:18:34.29,Default,,0,0,0,,Ха!
Dialogue: 0,1:18:37.67,1:18:40.38,Default,,0,0,0,,Біз бұл жігіттерге қамқор боламыз!
Dialogue: 0,1:18:40.67,1:18:42.46,Default,,0,0,0,,Хару Хару! Йотаро!
Dialogue: 0,1:18:42.55,1:18:44.97,Default,,0,0,0,,Мен мұны міндетті түрде осы жерден тоқтатамын!
Dialogue: 0,1:18:45.05,1:18:45.92,Default,,0,0,0,,Әрине.
Dialogue: 0,1:18:46.01,1:18:47.47,Default,,0,0,0,,Жүр! 401!
Dialogue: 0,1:18:47.80,1:18:50.39,Default,,0,0,0,,Команда және басқару жүйесі қайта іске қосылады!
Dialogue: 0,1:18:50.47,1:18:53.81,Default,,0,0,0,,Клейнфилдті электрмен жабдықтау қалпына келтірілді!
Dialogue: 0,1:18:54.27,1:18:56.44,Default,,0,0,0,,401 өтіңіз
Dialogue: 0,1:18:57.14,1:18:58.90,Default,,0,0,0,,Иона апа
Dialogue: 0,1:19:02.69,1:19:04.44,Default,,0,0,0,,Рахмет
Dialogue: 0,1:19:07.95,1:19:08.95,Default,,0,0,0,,Иона!
Dialogue: 0,1:19:11.28,1:19:12.99,Default,,0,0,0,,Барайық Гунзо
Dialogue: 0,1:19:13.33,1:19:14.70,Default,,0,0,0,,Мусашимен кездесу
Dialogue: 0,1:19:16.25,1:19:17.71,Default,,0,0,0,,Тек біз үшін
Dialogue: 0,1:19:18.04,1:19:19.50,Default,,0,0,0,,Не істеуге болмайды
Dialogue: 0,1:19:26.88,1:19:27.72,Default,,0,0,0,,Жарайды
Dialogue: 0,1:19:28.47,1:19:30.84,Default,,0,0,0,,Конголар бізді ұстап тұрғанда,
Dialogue: 0,1:19:30.93,1:19:32.97,Default,,0,0,0,,Осы аймақты жарып көрейік
Dialogue: 0,1:19:33.47,1:19:35.22,Default,,0,0,0,,Толық жарылыс күту режимі!
Dialogue: 0,1:19:35.60,1:19:36.48,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:19:36.56,1:19:39.31,Default,,0,0,0,,Ауырған кезде істеуге рұқсат етіңіз~
Dialogue: 0,1:19:39.81,1:19:40.77,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,1:19:40.90,1:19:42.31,Default,,0,0,0,,Біреу тоқтатсын!
Dialogue: 0,1:19:42.81,1:19:45.90,Default,,0,0,0,,Бұл кедергіге байланысты мүмкін емес!
Dialogue: 0,1:19:52.53,1:19:54.95,Default,,0,0,0,,Нацис! Көзіңізді жоғалтпаңыз!
Dialogue: 0,1:19:55.04,1:19:55.87,Default,,0,0,0,,Уф!
Dialogue: 0,1:20:01.88,1:20:03.13,Default,,0,0,0,,401
Dialogue: 0,1:20:03.63,1:20:06.13,Default,,0,0,0,,Қарсыластың іздеу аймағынан шықты
Dialogue: 0,1:20:08.26,1:20:09.93,Default,,0,0,0,,О, құдайым...
Dialogue: 0,1:20:24.31,1:20:27.65,Default,,0,0,0,,Тұмандық флоттар әртүрлі елдердің жағалауларында орналастырылған.
Dialogue: 0,1:20:28.19,1:20:30.28,Default,,0,0,0,,шектеуге дейін 24 сағат
Dialogue: 0,1:20:30.57,1:20:33.32,Default,,0,0,0,,Іс осылай жалғаса берсе, біз дәрменсіз басып қаламыз.
Dialogue: 0,1:20:33.87,1:20:36.66,Default,,0,0,0,,Дірілдейтін оқтұмсық әлі өшірілді ме?
Dialogue: 0,1:20:38.20,1:20:41.37,Default,,0,0,0,,АҚШ әскерінің вибро оқтұмсықтары күту режимінде.
Dialogue: 0,1:20:41.50,1:20:44.33,Default,,0,0,0,,Мен құлыпты ашу пернесін қолдансам болғаны.
Dialogue: 0,1:20:44.42,1:20:46.84,Default,,0,0,0,,Бұл қарсы шабуыл мүмкіндігін арттырады.
Dialogue: 0,1:20:47.09,1:20:48.63,Default,,0,0,0,,Бірақ бұл орын алса да
Dialogue: 0,1:20:48.71,1:20:50.84,Default,,0,0,0,,Адамзаттың аман қалуына кепілдік жоқ.
Dialogue: 0,1:20:51.72,1:20:53.39,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,1:20:53.47,1:20:55.35,Default,,0,0,0,,Гунзо Чихая
Dialogue: 0,1:21:12.78,1:21:15.66,Default,,0,0,0,,Мұхит түбіндегі наноматериалды реакция
Dialogue: 0,1:21:15.91,1:21:16.78,Default,,0,0,0,,Шын жүректен осылай сезінемін
Dialogue: 0,1:21:34.47,1:21:35.55,Default,,0,0,0,,Гравитон реакциясы!
Dialogue: 0,1:21:37.30,1:21:38.35,Default,,0,0,0,,Уау!
Dialogue: 0,1:21:38.43,1:21:40.93,Default,,0,0,0,,Кляйн өрісі 96% жоғалып кетті!
Dialogue: 0,1:21:41.18,1:21:42.60,Default,,0,0,0,,Бір оқпен алып кетті!
Dialogue: 0,1:21:43.73,1:21:44.98,Default,,0,0,0,,Мусаши
Dialogue: 0,1:21:52.03,1:21:55.36,Default,,0,0,0,,Мен бұл жерде осылай аяқталамын деп ешқашан ойламадым.
Dialogue: 0,1:21:55.74,1:21:57.53,Default,,0,0,0,,Жоғалу
Dialogue: 0,1:21:57.82,1:22:00.37,Default,,0,0,0,,Дәл осы жерде Ямато батып кеткендей.
Dialogue: 0,1:22:09.88,1:22:11.55,Default,,0,0,0,,Уау!
Dialogue: 0,1:22:12.67,1:22:13.92,Default,,0,0,0,,Мусаши!
Dialogue: 0,1:22:14.17,1:22:15.43,Default,,0,0,0,,Әке!
Dialogue: 0,1:22:15.93,1:22:17.34,Default,,0,0,0,,Чихая Шо мүсіні
Dialogue: 0,1:22:17.43,1:22:18.68,Default,,0,0,0,,Сіздің психикалық үлгіңіз және
Dialogue: 0,1:22:18.76,1:22:21.06,Default,,0,0,0,,Мен бір-бірімізді түсінетінімізге сендім!
Dialogue: 0,1:22:21.97,1:22:23.64,Default,,0,0,0,,Мен үшін де солай!
Dialogue: 0,1:22:23.73,1:22:24.60,Default,,0,0,0,,Өтінемін!
Dialogue: 0,1:22:24.68,1:22:25.77,Default,,0,0,0,,Менімен бірге
Dialogue: 0,1:22:26.27,1:22:30.02,Default,,0,0,0,,Сіз маған адамдармен сөйлесуге мүмкіндік бере аласыз ба?
Dialogue: 0,1:22:30.94,1:22:32.53,Default,,0,0,0,,Әкем сенді
Dialogue: 0,1:22:32.61,1:22:35.15,Default,,0,0,0,,Мен тұманға сенемін!
Dialogue: 0,1:22:36.24,1:22:37.28,Default,,0,0,0,,Иә
Dialogue: 0,1:22:37.45,1:22:39.74,Default,,0,0,0,,Сенің әкең емес
Dialogue: 0,1:22:41.37,1:22:43.24,Default,,0,0,0,,Ямато да жалған
Dialogue: 0,1:22:43.33,1:22:45.54,Default,,0,0,0,,Әкесі де жасанды
Dialogue: 0,1:22:45.96,1:22:48.42,Default,,0,0,0,,Мен қуыршақтармен ойнаймын...
Dialogue: 0,1:22:48.50,1:22:50.71,Default,,0,0,0,,Мен одан шаршадым
Dialogue: 0,1:22:52.38,1:22:54.84,Default,,0,0,0,,Көптеген супер гравитациялық зеңбіректер келеді!
Dialogue: 0,1:23:03.01,1:23:03.85,Default,,0,0,0,,Иона!
Dialogue: 0,1:23:05.52,1:23:06.85,Default,,0,0,0,,Мен жоғалып кетсем де
Dialogue: 0,1:23:08.23,1:23:12.02,Default,,0,0,0,,Менің ойым әркімде қалады
Dialogue: 0,1:23:13.90,1:23:15.61,Default,,0,0,0,,Сондықтан мен...
Dialogue: 0,1:23:33.38,1:23:34.30,Default,,0,0,0,,Бұл...
Dialogue: 0,1:23:34.38,1:23:35.96,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:23:46.56,1:23:50.40,Default,,0,0,0,,401 Бүкіл жүйе қайта конфигурациялануда.
Dialogue: 0,1:23:50.48,1:23:52.94,Default,,0,0,0,,Бронды мылтықтың күші де ерекше!
Dialogue: 0,1:23:58.70,1:24:00.36,Default,,0,0,0,,Көпір Тыңдап жатырсыз ба?
Dialogue: 0,1:24:00.45,1:24:03.95,Default,,0,0,0,,Гравитонды қозғалтқыштардың күшеюі борт бойынша артып келеді.
Dialogue: 0,1:24:04.66,1:24:06.49,Default,,0,0,0,,Көп...
Dialogue: 0,1:24:59.67,1:25:01.55,Default,,0,0,0,,Уф... не болып жатыр?
Dialogue: 0,1:25:02.34,1:25:04.01,Default,,0,0,0,,Айна жүйесі
Dialogue: 0,1:25:09.47,1:25:10.98,Default,,0,0,0,,Ямато
Dialogue: 0,1:25:29.04,1:25:30.16,Default,,0,0,0,,Ямато!
Dialogue: 0,1:25:31.33,1:25:32.87,Default,,0,0,0,,Ақырында...
Dialogue: 0,1:25:32.96,1:25:34.92,Default,,0,0,0,,Ақыры кездестік!
Dialogue: 0,1:25:50.68,1:25:53.18,Default,,0,0,0,,Мусаши флагмандық кеме идентификациялық коды
Dialogue: 0,1:25:53.64,1:25:55.81,Default,,0,0,0,,Дос болу
Dialogue: 0,1:25:55.94,1:25:57.44,Default,,0,0,0,,Бұл не болып жатыр...
Dialogue: 0,1:25:58.57,1:26:00.90,Default,,0,0,0,,Мусашидің жауынгерлік күшін алыңыз
Dialogue: 0,1:26:01.44,1:26:02.74,Default,,0,0,0,,Бұдан кейін келіссөздер басталады.
Dialogue: 0,1:26:03.82,1:26:05.16,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:26:06.78,1:26:07.74,Default,,0,0,0,,Иә
Dialogue: 0,1:26:09.37,1:26:11.20,Default,,0,0,0,,Қош келдіңіз Ямато
Dialogue: 0,1:26:11.45,1:26:12.75,Default,,0,0,0,,Эмилия ханым, жоспар бойынша айдаһар арбасымен эвакуацияланыңыз.
Dialogue: 0,1:26:13.20,1:26:16.42,Default,,0,0,0,,Сен ол баланы өшірдің ғой, солай ма?
Dialogue: 0,1:26:58.42,1:26:59.58,Default,,0,0,0,,Ямато
Dialogue: 0,1:26:59.96,1:27:01.50,Default,,0,0,0,,Бірақ жоқ, Ямато.
Dialogue: 0,1:27:01.59,1:27:03.88,Default,,0,0,0,,Мені қаншалықты көргің келеді?
Dialogue: 0,1:27:03.96,1:27:05.59,Default,,0,0,0,,Ол баладан құтылыңыз
Dialogue: 0,1:27:05.67,1:27:07.68,Default,,0,0,0,,Мен сенің әкеңді өлтіргендеймін.
Dialogue: 0,1:27:07.76,1:27:09.59,Default,,0,0,0,,Адамдар сияқты емес
Dialogue: 0,1:27:10.72,1:27:14.81,Default,,0,0,0,,Тұманға опасыздық жасап, тұманға батқан флагманы.
Dialogue: 0,1:27:15.18,1:27:18.98,Default,,0,0,0,,Мен сені тағы да өлтіремін.
Dialogue: 0,1:27:20.23,1:27:24.19,Default,,0,0,0,,Менің саған айтар сөзім бар.
Dialogue: 0,1:27:24.28,1:27:25.11,Default,,0,0,0,,Иә?
Dialogue: 0,1:27:25.69,1:27:28.40,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,1:27:28.49,1:27:30.11,Default,,0,0,0,,Ха! басқа!
Dialogue: 0,1:27:30.66,1:27:33.24,Default,,0,0,0,,Сіз не? Қайсысы?
Dialogue: 0,1:27:33.62,1:27:35.50,Default,,0,0,0,,Мен енді түсіндім
Dialogue: 0,1:27:35.87,1:27:37.46,Default,,0,0,0,,Ямато
Dialogue: 0,1:27:37.62,1:27:39.79,Default,,0,0,0,,Мен сені әрқашан жақсы көрдім
Dialogue: 0,1:27:39.96,1:27:41.75,Default,,0,0,0,,Өтірік! Ямато!
Dialogue: 0,1:27:41.83,1:27:43.67,Default,,0,0,0,,Мына қуыршақты тез өшір!
Dialogue: 0,1:27:44.55,1:27:48.72,Default,,0,0,0,,Мен сені ренжіте алмадым.
Dialogue: 0,1:27:49.63,1:27:50.72,Default,,0,0,0,,Жоқ
Dialogue: 0,1:27:50.80,1:27:52.72,Default,,0,0,0,,Мен сенен бас тарттым
Dialogue: 0,1:27:53.35,1:27:56.89,Default,,0,0,0,,Сондықтан мен қазір бар екеніме бәс тіксем де
Dialogue: 0,1:27:56.98,1:27:58.43,Default,,0,0,0,,сізді тоқтатады
Dialogue: 0,1:28:05.90,1:28:07.40,Default,,0,0,0,,Оны тоқтатқыңыз келе ме?
Dialogue: 0,1:28:07.49,1:28:09.53,Default,,0,0,0,,Сіз ештеңе түсінбесеңіз де!
Dialogue: 0,1:28:09.61,1:28:11.11,Default,,0,0,0,,Вагон тежегішті басады!
Dialogue: 0,1:28:11.36,1:28:12.57,Default,,0,0,0,,Ха...
Dialogue: 0,1:28:12.70,1:28:15.49,Default,,0,0,0,,Менің қайта баратын жерім жоқ сияқты.
Dialogue: 0,1:28:16.66,1:28:18.83,Default,,0,0,0,,Сол кезде туған ашу
Dialogue: 0,1:28:19.83,1:28:22.63,Default,,0,0,0,,Емдейтін ештеңе қалмады.
Dialogue: 0,1:28:23.67,1:28:24.96,Default,,0,0,0,,Мен жай ғана бітіріп, мүмкіндігінше тезірек үйге барғым келеді.
Dialogue: 0,1:28:25.21,1:28:28.84,Default,,0,0,0,,Мен әрқашан сенің жаныңда болуым керек еді
Dialogue: 0,1:28:29.63,1:28:32.68,Default,,0,0,0,,Жоқ! Менің ашуым жоқ!
Dialogue: 0,1:28:32.76,1:28:35.93,Default,,0,0,0,,Адамдар ақымақ жаратылыс, сондықтан оларды құртайық.
Dialogue: 0,1:28:36.01,1:28:38.27,Default,,0,0,0,,Адмиралтия кодексіне сәйкес!
Dialogue: 0,1:28:38.93,1:28:40.14,Default,,0,0,0,,Мусаши
Dialogue: 0,1:28:40.44,1:28:42.15,Default,,0,0,0,,адамдар үшін үлкен
Dialogue: 0,1:28:42.56,1:28:45.40,Default,,0,0,0,,Ал орны толмас күш бар.
Dialogue: 0,1:28:45.86,1:28:49.19,Default,,0,0,0,,Мен Гунзомен және басқалармен кездесіп, соны білдім.
Dialogue: 0,1:28:49.82,1:28:51.20,Default,,0,0,0,,Жүрек күші
Dialogue: 0,1:28:51.78,1:28:53.20,Default,,0,0,0,,Мүмкіндігінше көбірек
Dialogue: 0,1:28:54.07,1:28:56.74,Default,,0,0,0,,Бізде де жүрек болуы керек.
Dialogue: 0,1:28:57.66,1:28:59.41,Default,,0,0,0,,Әйтпесе
Dialogue: 0,1:28:59.58,1:29:00.96,Default,,0,0,0,,Ол жай ғана біреудің оны кешіруін қалады ғой, иә?
Dialogue: 0,1:29:01.04,1:29:04.17,Default,,0,0,0,,Мен бұл туралы тіпті ойлай да алмаймын.
Dialogue: 0,1:29:05.13,1:29:06.38,Default,,0,0,0,,Мусаши
Dialogue: 0,1:29:06.67,1:29:09.55,Default,,0,0,0,,Мен сенің жүрегіңді қабылдаймын
Dialogue: 0,1:29:09.67,1:29:10.97,Default,,0,0,0,,Өйткені
Dialogue: 0,1:29:11.34,1:29:13.30,Default,,0,0,0,,Бұл менің әпкем.
Dialogue: 0,1:29:20.98,1:29:22.14,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,1:29:23.35,1:29:25.65,Default,,0,0,0,,Қарғыс атқыр... Мен оны жек көремін.
Dialogue: 0,1:29:25.81,1:29:27.32,Default,,0,0,0,,Ұнатпау ұнамады...
Dialogue: 0,1:29:27.40,1:29:28.48,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,1:29:29.69,1:29:31.49,Default,,0,0,0,,Мен оны жек көремін... Мен оны жек көремін!
Dialogue: 0,1:29:31.74,1:29:35.03,Default,,0,0,0,,Жек көру Жек көру!
Dialogue: 0,1:29:35.11,1:29:35.95,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,1:29:36.37,1:29:38.62,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,1:29:39.62,1:29:41.16,Default,,0,0,0,,Барлығы
Dialogue: 0,1:29:41.25,1:29:43.00,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:30:00.68,1:30:02.60,Default,,0,0,0,,Мусаши! Айналау жүйесі енгізілді!
Dialogue: 0,1:30:02.68,1:30:03.52,Default,,0,0,0,,Капитан!
Dialogue: 0,1:30:09.07,1:30:09.94,Default,,0,0,0,,Кіріңіз!
Dialogue: 0,1:30:39.60,1:30:41.81,Default,,0,0,0,,Иона! Координаталарды есептеңіз!
Dialogue: 0,1:30:42.10,1:30:45.27,Default,,0,0,0,,Мақсат! Супер Жуынгерлік Кемесі Мусаши-нің үстінде!
Dialogue: 0,1:30:50.27,1:30:51.27,Default,,0,0,0,,Ха!
Dialogue: 0,1:30:57.66,1:30:59.28,Default,,0,0,0,,Ату!
Dialogue: 0,1:31:59.76,1:32:02.35,Default,,0,0,0,,Адмиралти кодексінің өкілі
Dialogue: 0,1:32:02.43,1:32:05.81,Default,,0,0,0,,Ямато флагманы ретінде мен бәріне хабарлаймын.
Dialogue: 0,1:32:06.60,1:32:08.73,Default,,0,0,0,,Бұл жалпы флагмандық тапсырыс
Dialogue: 0,1:32:09.44,1:32:11.06,Default,,0,0,0,,Қайталаңыз
Dialogue: 0,1:32:11.31,1:32:13.73,Default,,0,0,0,,Бұл жалпы флагмандық тапсырыс
Dialogue: 0,1:32:14.27,1:32:15.82,Default,,0,0,0,,Жалпы флагмандық команда?
Dialogue: 0,1:32:16.07,1:32:17.61,Default,,0,0,0,,Ха...
Dialogue: 0,1:32:18.49,1:32:20.53,Default,,0,0,0,,Не? 401 ме? а?
Dialogue: 0,1:32:20.91,1:32:23.03,Default,,0,0,0,,Әпке... Құрметті...
Dialogue: 0,1:32:25.95,1:32:27.50,Default,,0,0,0,,Бұл ел бітті ғой, иә?
Dialogue: 0,1:32:28.54,1:32:30.00,Default,,0,0,0,,Мұсаши мырза!
Dialogue: 0,1:32:30.67,1:32:33.79,Default,,0,0,0,,Барлық кемелер Барлық операция кодтарын тоқтатыңыз
Dialogue: 0,1:32:34.59,1:32:37.00,Default,,0,0,0,,Енді тұман флоты
Dialogue: 0,1:32:37.17,1:32:41.80,Default,,0,0,0,,Мен әркімге өз қалауымен өмір сүруді бұйырамын.
Dialogue: 0,1:32:42.89,1:32:46.10,Default,,0,0,0,,Бұл соңғы жалпы флагмандық тапсырыс
Dialogue: 0,1:32:58.28,1:32:59.78,Default,,0,0,0,,Уф...
Dialogue: 0,1:33:00.65,1:33:01.49,Default,,0,0,0,,Ах… Ах… Ааах…
Dialogue: 0,1:33:02.20,1:33:03.03,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:33:04.16,1:33:06.83,Default,,0,0,0,,Менің… еркім…
Dialogue: 0,1:33:09.04,1:33:10.20,Default,,0,0,0,,Хун
Dialogue: 0,1:33:10.54,1:33:12.25,Default,,0,0,0,,Мазасыздық
Dialogue: 0,1:33:15.50,1:33:16.79,Default,,0,0,0,,Фу…
Dialogue: 0,1:33:19.13,1:33:20.88,Default,,0,0,0,,Үлкен әпке
Dialogue: 0,1:33:24.34,1:33:25.97,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:33:27.47,1:33:28.43,Default,,0,0,0,,Иә...
Dialogue: 0,1:33:37.94,1:33:39.44,Default,,0,0,0,,Рахмет
Dialogue: 0,1:33:40.94,1:33:42.24,Default,,0,0,0,,Иә
Dialogue: 0,1:34:20.98,1:34:23.74,Default,,0,0,0,,Психикалық модель Мусаши жоғалады
Dialogue: 0,1:34:24.03,1:34:26.57,Default,,0,0,0,,Сондай-ақ одақ ядросынан ешқандай реакция жоқ.
Dialogue: 0,1:34:28.32,1:34:29.74,Default,,0,0,0,,Иона ше?
Dialogue: 0,1:34:35.46,1:34:36.71,Default,,0,0,0,,Фаа!
Dialogue: 0,1:34:42.88,1:34:44.38,Default,,0,0,0,,Ионар!
Dialogue: 0,1:34:53.85,1:34:55.06,Default,,0,0,0,,Иона!
Dialogue: 0,1:35:07.11,1:35:08.49,Default,,0,0,0,,Иона!
Dialogue: 0,1:35:08.82,1:35:10.12,Default,,0,0,0,,Суреттер тобы
Dialogue: 0,1:35:11.74,1:35:13.58,Default,,0,0,0,,Барлығы үшін рахмет
Dialogue: 0,1:35:14.25,1:35:15.33,Default,,0,0,0,,Ха...
Dialogue: 0,1:35:16.04,1:35:17.08,Default,,0,0,0,,Ионар!
Dialogue: 0,1:35:18.29,1:35:20.13,Default,,0,0,0,,Мен Ионамын
Dialogue: 0,1:35:20.21,1:35:22.09,Default,,0,0,0,,Сіздің кеме…
Dialogue: 0,1:35:24.55,1:35:26.09,Default,,0,0,0,,Иона! Қарғыс атқыр...
Dialogue: 0,1:35:26.26,1:35:27.43,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:35:30.76,1:35:31.93,Default,,0,0,0,,Иона!
Dialogue: 0,1:35:32.05,1:35:33.93,Default,,0,0,0,,Ионар!
Dialogue: 0,1:36:21.19,1:36:23.36,Default,,0,0,0,,Ең жаманды болдырмауға болар еді
Dialogue: 0,1:36:24.44,1:36:27.82,Default,,0,0,0,,Адмиралтейлік кодекстен шығарылған тұман флоты
Dialogue: 0,1:36:28.61,1:36:31.66,Default,,0,0,0,,Біз өмірден ләззат аламыз
Dialogue: 0,1:36:33.12,1:36:36.12,Default,,0,0,0,,Олардың кейбірі бостандыққа қол жеткізген
Dialogue: 0,1:36:36.20,1:36:39.58,Default,,0,0,0,,Кейбіреулер абдырап, есінен танып қалуы мүмкін.
Dialogue: 0,1:36:41.21,1:36:43.50,Default,,0,0,0,,Өсиет болу деген нені білдіреді?
Dialogue: 0,1:36:43.58,1:36:46.00,Default,,0,0,0,,Бұл қатыгез болуы мүмкін
Dialogue: 0,1:36:47.17,1:36:50.34,Default,,0,0,0,,Бірақ ерік бар болғандықтан
Dialogue: 0,1:36:50.72,1:36:51.97,Default,,0,0,0,,Менің дүниеге келу себебім
Dialogue: 0,1:36:52.72,1:36:54.47,Default,,0,0,0,,Тірі дәлел
Dialogue: 0,1:36:54.76,1:36:56.85,Default,,0,0,0,,Сіз оны таба аласыз.
Dialogue: 0,1:36:58.60,1:37:00.81,Default,,0,0,0,,Олар қуыршақ емес
Dialogue: 0,1:37:02.10,1:37:04.90,Default,,0,0,0,,Сондықтан мен бір-бірімізді түсінетінімізге сенімдімін.
Dialogue: 0,1:37:06.44,1:37:09.40,Default,,0,0,0,,Әкем өз өмірін қатерге тігіп көрсеткендей.
Dialogue: 0,1:37:11.65,1:37:13.24,Default,,0,0,0,,Бұдан былай адамзат пен тұман болады
Dialogue: 0,1:37:13.78,1:37:17.24,Default,,0,0,0,,Біз бұрын-соңды болмаған шатасу дәуіріне кіреміз.
Dialogue: 0,1:37:18.16,1:37:19.16,Default,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,1:37:19.87,1:37:22.04,Default,,0,0,0,,Өзгерістен қорықпа
Dialogue: 0,1:37:22.92,1:37:24.50,Default,,0,0,0,,Мен өмір сүргенше
Dialogue: 0,1:37:25.00,1:37:27.67,Default,,0,0,0,,Біз алға жылжуымыз керек.
Dialogue: 0,1:37:29.55,1:37:32.68,Default,,0,0,0,,Ол және біз жасаған таңдау болды
Dialogue: 0,1:37:32.97,1:37:34.76,Default,,0,0,0,,Мен дұрыс айттым.
Dialogue: 0,1:37:35.05,1:37:36.60,Default,,0,0,0,,сену
Dialogue: 0,1:37:39.81,1:37:41.31,Default,,0,0,0,,Иона
Dialogue: 0,1:37:45.44,1:37:51.44,Default,,0,0,0,,♪~
Dialogue: 0,1:42:38.23,1:42:44.24,Default,,0,0,0,,~♪
Dialogue: 0,1:43:03.84,1:43:05.13,Default,,0,0,0,,Ә? (Кения) Сен➡
Dialogue: 0,1:43:05.22,1:43:07.43,Default,,0,0,0,,Мен әкемді қайтардым.
Dialogue: 0,1:43:08.97,1:43:10.26,Default,,0,0,0,,Әке.
Dialogue: 0,1:43:11.22,1:43:12.60,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:43:13.06,1:43:13.89,Default,,0,0,0,,Ах...
Dialogue: 0,1:43:18.27,1:43:20.23,Default,,0,0,0,,Ха...
Dialogue: 0,1:43:31.99,1:43:33.54,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,1:43:35.04,1:43:41.04,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
