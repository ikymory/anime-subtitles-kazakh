Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:57.16,0:03:00.99,Default,,0,0,0,,Адам туралы аңыз осы жерден туған.
Dialogue: 0,0:03:00.99,0:03:03.56,Default,,0,0,0,,Қиыншылықта
Dialogue: 0,0:03:03.56,0:03:07.07,Default,,0,0,0,,Күрес күрес күрес
Dialogue: 0,0:03:07.07,0:03:11.57,Default,,0,0,0,,Бірнеше рет төмен итеріліп, қайтадан жоғары көтерілу
Dialogue: 0,0:03:11.57,0:03:16.28,Default,,0,0,0,,Күресіп, қайтадан алға ұмтылу
Dialogue: 0,0:03:16.28,0:03:18.61,Default,,0,0,0,,Аңызға айналған Бурай
Dialogue: 0,0:03:18.61,0:03:24.51,Default,,0,0,0,,Ер адамның аты Кайдзи Ито!
Dialogue: 0,0:03:27.89,0:03:32.79,Default,,0,0,0,,Кайджи, күн сайын орташа өмір сүрген және өзін-өзі қорлайтын адам.
Dialogue: 0,0:03:32.79,0:03:35.00,Default,,0,0,0,,Сіз өзіңізге қарыз аласыз.
Dialogue: 0,0:03:35.00,0:03:37.13,Default,,0,0,0,,Endo коллекторы орнатқан
Dialogue: 0,0:03:37.13,0:03:41.50,Default,,0,0,0,,Қарызды түпкілікті өтеуге апаратын жол
Dialogue: 0,0:03:41.50,0:03:44.30,Default,,0,0,0,,Мацуда! Бұл бала ойыны емес
Dialogue: 0,0:03:44.30,0:03:48.68,Default,,0,0,0,,Қалаған люкс круиздік кеме Espoir
Dialogue: 0,0:03:48.68,0:03:52.11,Default,,0,0,0,,Қайдзи сияқты жеңілгендер жиналды.
Dialogue: 0,0:03:52.11,0:03:54.15,Default,,0,0,0,,Қоқыс тобы
Dialogue: 0,0:03:54.15,0:03:56.75,Default,,0,0,0,,Онда түнгі круиздер ұйымдастырылды
Dialogue: 0,0:03:56.75,0:04:00.45,Default,,0,0,0,,Аңыздың басы
Dialogue: 0,0:04:00.45,0:04:02.66,Default,,0,0,0,,Ерлерге таңылған ойын
Dialogue: 0,0:04:02.66,0:04:07.83,Default,,0,0,0,,Бұл шектеулі тас, қағаз, қайшы
Dialogue: 0,0:04:07.83,0:04:12.23,Default,,0,0,0,,Бір қарағанда бұл сәттілік немесе тағдыр ойыны сияқты.
Dialogue: 0,0:04:12.23,0:04:18.34,Default,,0,0,0,,Данышпанның шабыты: Үлкен хабардарлық арқылы аман болыңыз
Dialogue: 0,0:04:18.34,0:04:23.14,Default,,0,0,0,,Келесі тосқауыл күтіп тұр
Dialogue: 0,0:04:23.14,0:04:25.91,Default,,0,0,0,,Тозақ Эспоирден де үлкен
Dialogue: 0,0:04:25.91,0:04:29.15,Default,,0,0,0,,Батыл ерлер жолы
Dialogue: 0,0:04:29.15,0:04:34.09,Default,,0,0,0,,Тікелей елестетпейтін өлімге апаратын ойын: Болат өткел
Dialogue: 0,0:04:34.09,0:04:39.19,Default,,0,0,0,,Қадамыңды жіберіп алсаң, тік құлайсың.
Dialogue: 0,0:04:43.20,0:04:47.07,Default,,0,0,0,,Бірақ тек бір Кайдзи өте алады.
Dialogue: 0,0:04:47.07,0:04:50.74,Default,,0,0,0,,Тағдыр тағы бір шайқасқа шақырады
Dialogue: 0,0:04:50.74,0:04:55.34,Default,,0,0,0,,Пайда болған адам Teiai тобының төрағасы болды.
Dialogue: 0,0:04:55.34,0:05:00.14,Default,,0,0,0,,Казутака Хиодо
Dialogue: 0,0:05:02.15,0:05:05.79,Default,,0,0,0,,Қараңғылық әлемінде билік ететін құбыжық
Dialogue: 0,0:05:05.79,0:05:09.76,Default,,0,0,0,,Және сол Хиодо жіберді
Dialogue: 0,0:05:09.76,0:05:15.96,Default,,0,0,0,,Бұл адам Юкио Тонегава
Dialogue: 0,0:05:18.77,0:05:23.54,Default,,0,0,0,,Ғажайып түсінік Жынның ақыл-ой күшімен жабдықталған
Dialogue: 0,0:05:23.54,0:05:27.94,Default,,0,0,0,,Teiai тобы №2
Dialogue: 0,0:05:30.74,0:05:34.71,Default,,0,0,0,,Тонегава Кайджиді біржақты жеңеді
Dialogue: 0,0:05:34.71,0:05:38.18,Default,,0,0,0,,Бір миллиметр саңылау жоқ, бәрі есептелген.
Dialogue: 0,0:05:38.18,0:05:40.72,Default,,0,0,0,,Бір жағын толтырыңыз
Dialogue: 0,0:05:40.72,0:05:43.79,Default,,0,0,0,,Бірақ ол қаншалықты өткір
Dialogue: 0,0:05:43.79,0:05:47.33,Default,,0,0,0,,Керісінше, жау
Dialogue: 0,0:05:47.33,0:05:50.63,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:50.63,0:05:52.73,Default,,0,0,0,,Өте жақсы болғаныңыз үшін рахмет.
Dialogue: 0,0:05:57.24,0:06:02.24,Default,,0,0,0,,Күтпеген жеңіліс Төраға ашулы
Dialogue: 0,0:06:04.31,0:06:06.98,Default,,0,0,0,,Тонегава өзінің тамашалығы үшін жеңілді
Dialogue: 0,0:06:06.98,0:06:11.08,Default,,0,0,0,,Ашу үшін кешірім сұрау
Dialogue: 0,0:06:11.08,0:06:14.22,Default,,0,0,0,,Мацуда! Бұл бала ойыны емес
Dialogue: 0,0:06:14.22,0:06:19.16,Default,,0,0,0,,Якидогеза
Dialogue: 0,0:06:19.16,0:06:22.20,Default,,0,0,0,,Иә, ол аты аңызға айналған адам Кайдзи Ито.
Dialogue: 0,0:06:22.20,0:06:26.70,Default,,0,0,0,,Юкио Тонегава, жетекші тұлға және көлеңкелі аңыз
Dialogue: 0,0:06:29.77,0:06:32.87,Default,,0,0,0,,Перде Тон өзенінен басталады.
Dialogue: 0,0:06:32.87,0:06:36.28,Default,,0,0,0,,Бұл менің Кайджимен кездескенге дейінгі оқиға.
Dialogue: 0,0:06:36.28,0:06:39.88,Default,,0,0,0,,Түнде қашып құтылдың ба? Мен саған қиындық туғыздым.
Dialogue: 0,0:06:39.88,0:06:43.82,Default,,0,0,0,,Мен түнде қашқанша ақшаны уақытында қайтарғанды ​​жөн көремін.
Dialogue: 0,0:06:43.82,0:06:48.79,Default,,0,0,0,,Қазір бүкіл отбасы шөпті тауларда немесе Жапон теңізінде.
Dialogue: 0,0:06:48.79,0:06:51.39,Default,,0,0,0,,Кез келген жағдайда... а
Dialogue: 0,0:06:53.69,0:06:56.09,Default,,0,0,0,,Енді Келесі Келесі
Dialogue: 0,0:06:58.93,0:07:02.37,Default,,0,0,0,,Менеджер, мен Марутоми Шоджи келісімшартына барамын.
Dialogue: 0,0:07:02.37,0:07:04.97,Default,,0,0,0,,О, мен оны сұрадым.
Dialogue: 0,0:07:04.97,0:07:07.64,Default,,0,0,0,,Әй, бұл тамаша сағат.
Dialogue: 0,0:07:07.64,0:07:10.44,Default,,0,0,0,,А, бұл арзан. Сонда кездескенше.
Dialogue: 0,0:07:10.44,0:07:12.55,Default,,0,0,0,,Сіз әрқашан салқынсыз, солай емес пе?
Dialogue: 0,0:07:12.55,0:07:17.12,Default,,0,0,0,,Басқарушы директордың қызымен некеге тұру туралы келіссөздер де жүріп жатыр деп естідім.
Dialogue: 0,0:07:17.12,0:07:19.15,Default,,0,0,0,,Әй, бұл жақсы кеңсе.
Dialogue: 0,0:07:19.15,0:07:21.82,Default,,0,0,0,,Мынау... Мен қиналып тұрмын. Мен жұмысқа келе алмаймын.
Dialogue: 0,0:07:21.82,0:07:24.56,Default,,0,0,0,,Бұл да жұмыс, солай ма?
Dialogue: 0,0:07:24.56,0:07:27.43,Default,,0,0,0,,Бұл арзан. 300 мыңға жуық?
Dialogue: 0,0:07:27.43,0:07:31.87,Default,,0,0,0,,Сыртқы түрі маңызды, бірақ қарызды қайтармау жаман.
Dialogue: 0,0:07:31.87,0:07:34.20,Default,,0,0,0,,Сіз айналаңызды таза ұстауыңыз керек.
Dialogue: 0,0:07:34.20,0:07:37.64,Default,,0,0,0,,Сіздің асыл үйлену туралы ұсынысыңыз бұзылады.
Dialogue: 0,0:07:37.64,0:07:41.24,Default,,0,0,0,,бұл... төлеймін мен төлеймін!
Dialogue: 0,0:07:45.71,0:07:48.52,Default,,0,0,0,,Менің тырнақ қабылдауыма дейін әлі уақыт бар.
Dialogue: 0,0:07:48.52,0:07:50.92,Default,,0,0,0,,Косметика, қарастырайық.
Dialogue: 0,0:07:54.25,0:07:57.09,Default,,0,0,0,,Морикоши әмбебап дүкені Ах, Морикоши
Dialogue: 0,0:07:57.09,0:08:00.56,Default,,0,0,0,,Жаяу жүру жылдамырақ, сондықтан барыңыз.
Dialogue: 0,0:08:00.56,0:08:02.73,Default,,0,0,0,,Ой, балалар, сендер қандайсыңдар?
Dialogue: 0,0:08:02.73,0:08:05.37,Default,,0,0,0,,Ханым, сіз көп сауда жасадыңыз.
Dialogue: 0,0:08:05.37,0:08:09.20,Default,,0,0,0,,Бұл ақша қайдан келді? Яғни... яғни
Dialogue: 0,0:08:09.20,0:08:12.27,Default,,0,0,0,,Менің төлемдерім біраз уақытқа кешіктірілді.
Dialogue: 0,0:08:12.27,0:08:14.87,Default,,0,0,0,,Мен бұл таксиге қатысты бірдеңе істеуім керек.
Dialogue: 0,0:08:14.87,0:08:17.38,Default,,0,0,0,,Морикоши әмбебап дүкені жақын емес.
Dialogue: 0,0:08:17.38,0:08:21.08,Default,,0,0,0,,Сізге әлдеқайда көп жүру керек.
Dialogue: 0,0:08:21.08,0:08:25.78,Default,,0,0,0,,Аа, кешіріңіз. Мен оны қайтарамын. Мен оны қайтарамын!
Dialogue: 0,0:08:28.29,0:08:31.62,Default,,0,0,0,,Дом Пери! Дон Пери!
Dialogue: 0,0:08:31.62,0:08:34.99,Default,,0,0,0,,Күтілгендей, Азусаның қасында отыру - ең ыңғайлы орын.
Dialogue: 0,0:08:34.99,0:08:37.30,Default,,0,0,0,,Табиғи болуы мүмкін бе деп ойлаймын.
Dialogue: 0,0:08:37.30,0:08:41.40,Default,,0,0,0,,Мен бақыттымын Азуса менің мінсіз
Dialogue: 0,0:08:41.40,0:08:44.40,Default,,0,0,0,,Мен саған қалталы ақша беремін, ал Дон Пери.
Dialogue: 0,0:08:44.40,0:08:46.74,Default,,0,0,0,,Иә, мен Dom Peri қосымшасын алдым!
Dialogue: 0,0:08:46.74,0:08:50.58,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:08:50.58,0:08:53.71,Default,,0,0,0,,Хи-хи, сәл оғаш.
Dialogue: 0,0:08:53.71,0:08:56.75,Default,,0,0,0,,Не істеп жатырсың! Хмм
Dialogue: 0,0:08:56.75,0:08:59.09,Default,,0,0,0,,Бұл әлі де жеткіліксіз, иә?
Dialogue: 0,0:08:59.09,0:09:01.89,Default,,0,0,0,,Әй, сәл күте тұрыңыз.
Dialogue: 0,0:09:04.66,0:09:07.49,Default,,0,0,0,,6-3-те толық соманы төлеуден аулақ болған дұрыс.
Dialogue: 0,0:09:07.49,0:09:10.80,Default,,0,0,0,,Не…
Dialogue: 0,0:09:10.80,0:09:14.50,Default,,0,0,0,,Мен осындай керексіз заттарды ғана сатып алғандықтан, қарызым көбейіп барады.
Dialogue: 0,0:09:14.50,0:09:19.51,Default,,0,0,0,,Оны канализацияға лақтырмас бұрын... Иә... Иә.
Dialogue: 0,0:09:19.51,0:09:22.91,Default,,0,0,0,,Ол кісі көзін әбден ашты.
Dialogue: 0,0:09:22.91,0:09:28.72,Default,,0,0,0,,Егер сіз бұл пайда табу немесе заңсыз деп ойласаңыз, сіз жылайсыз.
Dialogue: 0,0:09:28.72,0:09:30.82,Default,,0,0,0,,Жылы
Dialogue: 0,0:09:30.82,0:09:33.89,Default,,0,0,0,,Жоқ, сіз оны қайтармаймын деп айтқан жоқсыз.
Dialogue: 0,0:09:33.89,0:09:35.99,Default,,0,0,0,,Факт: Мен оны қайтармас едім.
Dialogue: 0,0:09:35.99,0:09:39.26,Default,,0,0,0,,Бірақ бұл қызығушылық кенеттен тым артып кеткендіктен.
Dialogue: 0,0:09:39.26,0:09:41.46,Default,,0,0,0,,Пайыз мөлшерлемесі келісім-шарт жасау кезінде расталады
Dialogue: 0,0:09:41.46,0:09:43.90,Default,,0,0,0,,Қарыз алғанда мен де асығамын.
Dialogue: 0,0:09:43.90,0:09:48.10,Default,,0,0,0,,Мен мұқият қараған жоқпын. Эй, тым тартылып қалма.
Dialogue: 0,0:09:48.10,0:09:51.40,Default,,0,0,0,,Бұлай өмір сүру жақсы емес пе?
Dialogue: 0,0:09:51.40,0:09:56.34,Default,,0,0,0,,Егер ол шықса ше? Жарайды. Үйдегілер қиналып жатқан жоқ па?
Dialogue: 0,0:09:56.34,0:10:00.85,Default,,0,0,0,,Дұрыс. Сіздің үйіңіздің пайыздық мөлшерлемесі шектен тыс.
Dialogue: 0,0:10:00.85,0:10:04.18,Default,,0,0,0,,Әйтеуір, күнде келсең де, бәрібір мәселе.
Dialogue: 0,0:10:04.18,0:10:06.19,Default,,0,0,0,,Мұнда да бизнес қиын.
Dialogue: 0,0:10:06.19,0:10:09.29,Default,,0,0,0,,Мен сіздің жағдайыңызды естіген жоқпын.
Dialogue: 0,0:10:14.83,0:10:17.03,Default,,0,0,0,,Ах... ах
Dialogue: 0,0:10:17.03,0:10:19.40,Default,,0,0,0,,Сәлем
Dialogue: 0,0:10:19.40,0:10:22.70,Default,,0,0,0,,Бізге сөз емес, ақша керек.
Dialogue: 0,0:10:30.61,0:10:33.58,Default,,0,0,0,,Сол президент ақыры тұтқынға алынды.
Dialogue: 0,0:10:33.58,0:10:37.18,Default,,0,0,0,,Аа, мен күлдім де, осылай сенің үстіңнен өтіп кетемін деп ойладым.
Dialogue: 0,0:10:39.19,0:10:42.26,Default,,0,0,0,,Тіркеу куәлігі және құқық куәлігі Иә.
Dialogue: 0,0:10:42.26,0:10:45.79,Default,,0,0,0,,А... сен бастықсың, солай ма? Тағы біраз күтіңіз.
Dialogue: 0,0:10:45.79,0:10:49.03,Default,,0,0,0,,Мен төлеуге дайынмын.
Dialogue: 0,0:10:49.03,0:10:53.73,Default,,0,0,0,,Сезімдер тіпті бір есепшоттың салмағын да көтермейді
Dialogue: 0,0:10:53.73,0:10:56.13,Default,,0,0,0,,Барайық Ах, иә.
Dialogue: 0,0:10:59.21,0:11:01.21,Default,,0,0,0,,Қап, дүние жаман.
Dialogue: 0,0:11:01.21,0:11:03.84,Default,,0,0,0,,Дүние мені көбірек таныса
Dialogue: 0,0:11:03.84,0:11:05.88,Default,,0,0,0,,Тәтті!
Dialogue: 0,0:11:05.88,0:11:10.58,Default,,0,0,0,,Ей, масқара, дүние анаң деп ойлайсың ба?
Dialogue: 0,0:11:16.46,0:11:19.03,Default,,0,0,0,,Тонегава алтын сөздері
Dialogue: 0,0:11:19.03,0:11:22.03,Default,,0,0,0,,«Әлем сенің анаң емес».
Dialogue: 0,0:11:22.03,0:11:26.90,Default,,0,0,0,,Айтқан сөзінен үнемі сабақ алып, жетілдіретін адам
Dialogue: 0,0:11:26.90,0:11:30.20,Default,,0,0,0,,Бұл Юкио Тонегава
Dialogue: 0,0:11:30.20,0:11:33.04,Default,,0,0,0,,Теяй тобы Көптеген хаос арқылы өту
Dialogue: 0,0:11:33.04,0:11:37.14,Default,,0,0,0,,Екіге көтерілген адам
Dialogue: 0,0:11:50.79,0:11:54.09,Default,,0,0,0,,Teiai Finance әрқашан сіздің қасыңызда
Dialogue: 0,0:12:12.21,0:12:15.28,Default,,0,0,0,,Тонегава мырза, төраға қоңырау шалып жатыр.
Dialogue: 0,0:12:15.28,0:12:17.52,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:12:17.52,0:12:20.72,Default,,0,0,0,,Юкио Тонегава Жалғыз қабырға
Dialogue: 0,0:12:20.72,0:12:24.22,Default,,0,0,0,,Бұл ол жұмыс істейтін компания: Императорлық махаббат императоры
Dialogue: 0,0:12:24.22,0:12:26.53,Default,,0,0,0,,Диктатор және тиран
Dialogue: 0,0:12:26.53,0:12:29.93,Default,,0,0,0,,Төраға Казутака Хиодо
Dialogue: 0,0:12:33.43,0:12:35.53,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:38.84,0:12:42.01,Default,,0,0,0,,Жалқаулық
Dialogue: 0,0:12:42.01,0:12:44.41,Default,,0,0,0,,Шаршадым...
Dialogue: 0,0:12:47.55,0:12:51.45,Default,,0,0,0,,Тонегава инстинктивті түрде түсінеді
Dialogue: 0,0:12:51.45,0:12:55.45,Default,,0,0,0,,Осы штаттағы президент келесі кезде сөйлейді.
Dialogue: 0,0:12:55.45,0:12:58.72,Default,,0,0,0,,Асураға жолды ашыңыз
Dialogue: 0,0:12:58.72,0:13:02.03,Default,,0,0,0,,Түбі жоқ батпақ
Dialogue: 0,0:13:02.03,0:13:06.50,Default,,0,0,0,,Өлім кезінде құдай түсетін тозақтың қақпасы
Dialogue: 0,0:13:06.50,0:13:11.17,Default,,0,0,0,,Теледидар, фильмдер және музыканың бәрі жалған.
Dialogue: 0,0:13:11.17,0:13:14.77,Default,,0,0,0,,Бұл махаббат, бұл махаббат, бұл «жалғыз емес»
Dialogue: 0,0:13:14.77,0:13:19.81,Default,,0,0,0,,«Мен сені көргім келеді» немесе «Мен сені шынымен көргім келмейді»
Dialogue: 0,0:13:19.81,0:13:23.62,Default,,0,0,0,,«Мен сенімен кездескім келеді» немесе «Мен шашымды тым көп кесіп алдым»
Dialogue: 0,0:13:23.62,0:13:27.72,Default,,0,0,0,,«Тығыз джинсы» немесе «бұрандалы»
Dialogue: 0,0:13:29.76,0:13:34.09,Default,,0,0,0,,Адам табиғатын ешкім түсінбейді.
Dialogue: 0,0:13:34.09,0:13:37.43,Default,,0,0,0,,Контрафактілік
Dialogue: 0,0:13:37.43,0:13:40.03,Default,,0,0,0,,Мен нақты нәрсені көргім келеді
Dialogue: 0,0:13:45.67,0:13:51.04,Default,,0,0,0,,Арнайы орындықта адам баласының қара сезімдері
Dialogue: 0,0:13:51.04,0:13:56.18,Default,,0,0,0,,Табиғат, жойылу, үмітсіздік және өлім
Dialogue: 0,0:13:56.18,0:14:01.12,Default,,0,0,0,,Бұл нағыз ойын-сауық, ләззат
Dialogue: 0,0:14:01.12,0:14:05.69,Default,,0,0,0,,Сіз олай ойламайсыз ба? Енді, Тонегава.
Dialogue: 0,0:14:05.69,0:14:07.86,Default,,0,0,0,,Иә, мен солай ойлаймын.
Dialogue: 0,0:14:07.86,0:14:10.96,Default,,0,0,0,,Кукуку онда...
Dialogue: 0,0:14:14.87,0:14:19.07,Default,,0,0,0,,Тозақтың есігін аш
Dialogue: 0,0:14:19.07,0:14:22.38,Default,,0,0,0,,Жоспар
Dialogue: 0,0:14:22.38,0:14:24.91,Default,,0,0,0,,Қан қайнаған той
Dialogue: 0,0:14:24.91,0:14:27.75,Default,,0,0,0,,Бүркіт жасушаларын белсендіретін нәрсе.
Dialogue: 0,0:14:27.75,0:14:31.05,Default,,0,0,0,,Өз өмірі үшін күрескен ақымақтар
Dialogue: 0,0:14:42.76,0:14:45.16,Default,,0,0,0,,Я, мен абдырап қалдым.
Dialogue: 0,0:14:45.16,0:14:49.27,Default,,0,0,0,,Тон өзені Демалыс қарсаңында көк түстен ағып жатқан болт
Dialogue: 0,0:14:49.27,0:14:51.84,Default,,0,0,0,,Сынақтар келе жатыр
Dialogue: 0,0:14:51.84,0:14:55.81,Default,,0,0,0,,Бұл бағыныштылардың көп санын басқаратын басшы болса да,
Dialogue: 0,0:14:55.81,0:14:59.88,Default,,0,0,0,,Тиран Төраға Хиодо әрқашан жақсы көңіл-күйде болсын
Dialogue: 0,0:14:59.88,0:15:01.91,Default,,0,0,0,,әрқашан әрқашан
Dialogue: 0,0:15:01.91,0:15:04.42,Default,,0,0,0,,Ең таныс және алаңдату керек
Dialogue: 0,0:15:04.42,0:15:10.09,Default,,0,0,0,,Орташа басшылық қызметтегі адам, былайша айтқанда.
Dialogue: 0,0:15:10.09,0:15:13.96,Default,,0,0,0,,Ку... Тағы да көпіршіктер
Dialogue: 0,0:15:13.96,0:15:16.96,Default,,0,0,0,,Демалыс күндері гольф
Dialogue: 0,0:15:16.96,0:15:19.00,Default,,0,0,0,,Пар!
Dialogue: 0,0:15:19.00,0:15:22.84,Default,,0,0,0,,Өз лауазымы үшін азап шегіп, күрескен ұлы аңызға айналған адам.
Dialogue: 0,0:15:22.84,0:15:28.54,Default,,0,0,0,,Юкио Тонегаваның шағын әңгімесі.
Dialogue: 0,0:16:59.53,0:17:03.60,Default,,0,0,0,,Юкио Тонегава, Teiai Group-тың бас атқарушы директоры
Dialogue: 0,0:17:03.60,0:17:06.80,Default,,0,0,0,,Төрағаның оң қолымын деп мақтанатын адам
Dialogue: 0,0:17:12.88,0:17:17.58,Default,,0,0,0,,Хиодоның бұйрығымен жаңа жоба тобы құрылды.
Dialogue: 0,0:17:17.58,0:17:21.32,Default,,0,0,0,,Әр бөлімнен қара түсті киімдер таңдалды.
Dialogue: 0,0:17:21.32,0:17:28.13,Default,,0,0,0,,Олардың барлығы Тон өзеніне жаңадан келген.
Dialogue: 0,0:17:28.13,0:17:30.50,Default,,0,0,0,,Міне, сондықтан
Dialogue: 0,0:17:30.50,0:17:35.33,Default,,0,0,0,,Жаңа жобаны бастау. Сәтсіздік опция емес.
Dialogue: 0,0:17:35.33,0:17:38.77,Default,,0,0,0,,Төрағаның көңілін көтеру үшін шайтандық ойын-сауық ойыны
Dialogue: 0,0:17:38.77,0:17:41.57,Default,,0,0,0,,Мен идеяларды сұрағым келеді.
Dialogue: 0,0:17:41.57,0:17:44.94,Default,,0,0,0,,Бірақ бұл кейінірек
Dialogue: 0,0:17:44.94,0:17:48.18,Default,,0,0,0,,Оған дейін, бірінші
Dialogue: 0,0:17:48.18,0:17:51.85,Default,,0,0,0,,Өзін-өзі таныстыру Ах
Dialogue: 0,0:17:51.85,0:17:55.72,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:17:55.72,0:17:58.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:58.42,0:18:00.66,Default,,0,0,0,,Кейбір адамдар әрқашан ұқсас
Dialogue: 0,0:18:00.66,0:18:03.66,Default,,0,0,0,,Біркелкі немесе дәлірек айтқанда, индивидуалистік?
Dialogue: 0,0:18:03.66,0:18:06.67,Default,,0,0,0,,30-ға жуық ер адамдар тобы
Dialogue: 0,0:18:06.67,0:18:10.30,Default,,0,0,0,,Баяғы қара киім, сол көзілдірік
Dialogue: 0,0:18:10.30,0:18:12.64,Default,,0,0,0,,Айырмашылық
Dialogue: 0,0:18:12.64,0:18:15.77,Default,,0,0,0,,Ол киім патша махаббатының ережесі.
Dialogue: 0,0:18:15.77,0:18:18.71,Default,,0,0,0,,Төраға Хиододан басқа ешкім белгілеген саясат
Dialogue: 0,0:18:18.71,0:18:21.45,Default,,0,0,0,,Ендеше, енді азаматтық киімді ауыстыр.
Dialogue: 0,0:18:21.45,0:18:24.32,Default,,0,0,0,,Мен бұндай нәрсеге тапсырыс бере алмаймын.
Dialogue: 0,0:18:24.32,0:18:27.75,Default,,0,0,0,,Юкио Тонегава ортаңғы менеджері
Dialogue: 0,0:18:27.75,0:18:31.49,Default,,0,0,0,,Егер қолыңнан келмесе, тым болмаса өзіңді таныстыр.
Dialogue: 0,0:18:31.49,0:18:35.26,Default,,0,0,0,,Аты және басқа хоббиі және арнайы дағдылары Тәртіппен
Dialogue: 0,0:18:35.26,0:18:38.00,Default,,0,0,0,,Сізден бастайық, иә?
Dialogue: 0,0:18:38.00,0:18:42.27,Default,,0,0,0,,Тез істе Ах... Иә.
Dialogue: 0,0:18:42.27,0:18:45.44,Default,,0,0,0,,Есімде болса, бұл жігіт бұрын төраға болған.
Dialogue: 0,0:18:45.44,0:18:48.01,Default,,0,0,0,,Ямадзаки Бұл Кенджи Ямадзаки.
Dialogue: 0,0:18:48.01,0:18:50.68,Default,,0,0,0,,Менің хоббиім боулинг.
Dialogue: 0,0:18:50.68,0:18:53.45,Default,,0,0,0,,Ямадзаки Ямадзаки
Dialogue: 0,0:18:53.45,0:18:56.32,Default,,0,0,0,,Сіз келесіде Ямадзаки Йошисыз
Dialogue: 0,0:18:56.32,0:19:00.02,Default,,0,0,0,,бұл... Иә, бұл Сабуро Джиро Саемон.
Dialogue: 0,0:19:02.96,0:19:05.46,Default,,0,0,0,,Не? Менің хоббиім боулинг
Dialogue: 0,0:19:05.46,0:19:08.76,Default,,0,0,0,,Күте тұрыңыз! Қазір екі адам
Dialogue: 0,0:19:08.76,0:19:11.63,Default,,0,0,0,,2-дей адамның атын айтпадың ба?
Dialogue: 0,0:19:11.63,0:19:14.97,Default,,0,0,0,,Сабуро Широ немесе комедиялық дуэт сияқты нәрсе.
Dialogue: 0,0:19:14.97,0:19:19.64,Default,,0,0,0,,Жоқ, Сабуро Саймон менің фамилиям, сонымен қатар менің атым Джиро.
Dialogue: 0,0:19:19.64,0:19:22.31,Default,,0,0,0,,Бұл Джиро Саэмон Сабуро.
Dialogue: 0,0:19:22.31,0:19:24.71,Default,,0,0,0,,Уф... не?
Dialogue: 0,0:19:24.71,0:19:28.61,Default,,0,0,0,,Мазасыз! Мен көп есімдерді есіме түсіруге тырысқанда,
Dialogue: 0,0:19:28.61,0:19:30.88,Default,,0,0,0,,Фамилия қандай қиыншылық
Dialogue: 0,0:19:30.88,0:19:33.82,Default,,0,0,0,,Жақсы, Сабуро Саймон
Dialogue: 0,0:19:33.82,0:19:36.42,Default,,0,0,0,,Екінші жағынан, егер сіздің фамилияңыз біртүрлі болса,
Dialogue: 0,0:19:39.43,0:19:42.33,Default,,0,0,0,,Оны есте сақтау таңқаларлық оңай болуы мүмкін.
Dialogue: 0,0:19:42.33,0:19:45.40,Default,,0,0,0,,Императорлық махаббат патшасы, төраға Хиодо
Dialogue: 0,0:19:45.40,0:19:49.13,Default,,0,0,0,,Қара киімнің атын есте сақтаудың қажеті жоқ
Dialogue: 0,0:19:49.13,0:19:51.77,Default,,0,0,0,,Сәлем, иә!
Dialogue: 0,0:19:51.77,0:19:56.71,Default,,0,0,0,,Дегенмен, орта буын менеджері Тонегава басқаша.
Dialogue: 0,0:19:56.71,0:20:00.55,Default,,0,0,0,,Өйткені ол көп қара киімдерді басқарып, қадағалай алады.
Dialogue: 0,0:20:00.55,0:20:04.38,Default,,0,0,0,,Мен сізге төрағадай дөрекі қарай алмаймын.
Dialogue: 0,0:20:04.38,0:20:09.59,Default,,0,0,0,,Іс жүзінде ілгерілеу үшін бағыныштылардың ынтымақтастығы маңызды.
Dialogue: 0,0:20:09.59,0:20:12.22,Default,,0,0,0,,Тонегава үшін қара жамылғандардың сеніміне ие болу деген сөз
Dialogue: 0,0:20:12.22,0:20:14.93,Default,,0,0,0,,Қызметінің жоғарылауына қажетті жағдайлар
Dialogue: 0,0:20:14.93,0:20:16.93,Default,,0,0,0,,Есіңде болсын
Dialogue: 0,0:20:16.93,0:20:21.00,Default,,0,0,0,,Қара костюмнің түсініксіз атын үнсіз жатта
Dialogue: 0,0:20:21.00,0:20:24.54,Default,,0,0,0,,Юкио Тонегава ортаңғы менеджері
Dialogue: 0,0:20:24.54,0:20:27.77,Default,,0,0,0,,Келесі! Бұл Тосимаса Кавасаки.
Dialogue: 0,0:20:27.77,0:20:31.28,Default,,0,0,0,,Менің хоббиім боулинг. Рақмет сізге.
Dialogue: 0,0:20:31.28,0:20:36.18,Default,,0,0,0,,Кавасаки Кавасаки Жарайды. Егер бұл қалыпты атау болса ...
Dialogue: 0,0:20:36.18,0:20:39.95,Default,,0,0,0,,Уф, жоқ, бұл жаман. Кавасаки жаман.
Dialogue: 0,0:20:39.95,0:20:44.06,Default,,0,0,0,,Бірінші адамның аты – Ямадзаки, ол күтпеген жерден «Саки» деп айтылады.
Dialogue: 0,0:20:44.06,0:20:46.53,Default,,0,0,0,,Қаншалықты түсініксіз
Dialogue: 0,0:20:46.53,0:20:49.86,Default,,0,0,0,,Немесе Коносаки Кабуриді байқамасаңыз
Dialogue: 0,0:20:49.86,0:20:52.30,Default,,0,0,0,,Мен оны оңай есте сақтай алатын шығармын.
Dialogue: 0,0:20:52.30,0:20:57.60,Default,,0,0,0,,Байқаудан туындаған шатасу
Dialogue: 0,0:20:57.60,0:21:00.71,Default,,0,0,0,,Бірақ Тонегава байқап қалды
Dialogue: 0,0:21:00.71,0:21:03.84,Default,,0,0,0,,Жоқ, сіз байқайсыз.
Dialogue: 0,0:21:03.84,0:21:07.38,Default,,0,0,0,,Өйткені ол көптеген қырғын шайқастарға қатысқан.
Dialogue: 0,0:21:07.38,0:21:11.38,Default,,0,0,0,,Осы іске асыру арқылы жеңген жеңімпаздар
Dialogue: 0,0:21:11.38,0:21:13.39,Default,,0,0,0,,Үздіктің арқасында хабардар болу
Dialogue: 0,0:21:13.39,0:21:15.59,Default,,0,0,0,,Келесі! Иә
Dialogue: 0,0:21:15.59,0:21:18.96,Default,,0,0,0,,Келіңіздер, фамилияны есте сақтау оңай
Dialogue: 0,0:21:18.96,0:21:21.83,Default,,0,0,0,,Тонегава есіне алады және...
Dialogue: 0,0:21:21.83,0:21:25.73,Default,,0,0,0,,Кейичи Огино Менің хоббиім боулинг.
Dialogue: 0,0:21:25.73,0:21:27.93,Default,,0,0,0,,Жарайды, аян, дәл!
Dialogue: 0,0:21:27.93,0:21:31.57,Default,,0,0,0,,Огино Сіз Огиносыз, иә... ха.
Dialogue: 0,0:21:31.57,0:21:33.61,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:21:33.61,0:21:39.08,Default,,0,0,0,,Огиноның бұл жерге келуі шын мәнінде бақыт, үміт нұры жанып тұр.
Dialogue: 0,0:21:39.08,0:21:41.15,Default,,0,0,0,,Келесі
Dialogue: 0,0:21:41.15,0:21:45.72,Default,,0,0,0,,Гах... Енді не болып жатыр?
Dialogue: 0,0:21:45.72,0:21:50.22,Default,,0,0,0,,Тон өзеніне белгісіз суық кенеттен шабуыл жасайды
Dialogue: 0,0:21:50.22,0:21:52.32,Default,,0,0,0,,Оған не себеп болғанын білмеймін.
Dialogue: 0,0:21:52.32,0:21:58.96,Default,,0,0,0,,Бірақ бір жаман сезім желкеме жабысып тұр.
Dialogue: 0,0:21:58.96,0:22:01.83,Default,,0,0,0,,Не... Не болды, Тонегава мырза?
Dialogue: 0,0:22:01.83,0:22:05.54,Default,,0,0,0,,Жоқ, жоқ, ештеңе. Жарайды, келесі.
Dialogue: 0,0:22:05.54,0:22:08.21,Default,,0,0,0,,Бұл менің қиялым болуы керек Бұл менің қиялым болуы керек
Dialogue: 0,0:22:08.21,0:22:13.15,Default,,0,0,0,,Жаман ескертудің шынайы табиғаты бірден ашылды
Dialogue: 0,0:22:13.15,0:22:15.61,Default,,0,0,0,,Хагио Бұл Джуничи Хагио.
Dialogue: 0,0:22:15.61,0:22:17.61,Default,,0,0,0,,Nuo
Dialogue: 0,0:22:19.65,0:22:21.65,Default,,0,0,0,,Менің хоббиім боулинг... Ах!
Dialogue: 0,0:22:21.65,0:22:26.36,Default,,0,0,0,,Хагинодан кейін Оджио? Қандай кездейсоқтық!
Dialogue: 0,0:22:26.36,0:22:28.69,Default,,0,0,0,,Ал... Доктор Тонегава О?
Dialogue: 0,0:22:28.69,0:22:32.36,Default,,0,0,0,,Бұл керісінше. Бұл Огино мен Хагио. Иә иә.
Dialogue: 0,0:22:32.36,0:22:37.37,Default,,0,0,0,,Тон өзені жарылып жатыр! бірдеңе құлайды
Dialogue: 0,0:22:37.37,0:22:42.01,Default,,0,0,0,,Тон өзенінде шу шығару
Dialogue: 0,0:22:42.01,0:22:45.48,Default,,0,0,0,,Сіз мұны білесіз бе? Жеңіл жүріңіз
Dialogue: 0,0:22:45.48,0:22:49.18,Default,,0,0,0,,Әркім өз есімдерін маған есте сақтауға оңай етіп өзгертуі керек.
Dialogue: 0,0:22:49.18,0:22:53.12,Default,,0,0,0,,Иә? Менің атым ғана емес, менің хоббиім де
Dialogue: 0,0:22:53.12,0:22:56.26,Default,,0,0,0,,Бірлескен боулинг Боулинг Боулинг
Dialogue: 0,0:22:56.26,0:23:00.93,Default,,0,0,0,,Сіз орта мектеп оқушыларысыз ба немесе Боулинг ауылының тұрғындарысыз ба?
Dialogue: 0,0:23:00.93,0:23:05.73,Default,,0,0,0,,Мен саған айтамын, Гартер, сенің барлық есімдерің Гартер.
Dialogue: 0,0:23:08.43,0:23:10.84,Default,,0,0,0,,Нөл ұпай
Dialogue: 0,0:23:10.84,0:23:13.44,Default,,0,0,0,,Онда ешкім жоқ па? Соққы
Dialogue: 0,0:23:13.44,0:23:16.84,Default,,0,0,0,,Бүркіттің мидағы есте сақтау қабілеті
Dialogue: 0,0:23:16.84,0:23:20.41,Default,,0,0,0,,Польнареффтің қылышынан да жылдам болды. Құдай-ай!》
Dialogue: 0,0:23:20.41,0:23:22.82,Default,,0,0,0,,Бірдеңе айт, Кавасаки, бұл Ямадзаки.
Dialogue: 0,0:23:22.82,0:23:25.05,Default,,0,0,0,,Ах!
Dialogue: 0,0:23:25.05,0:23:28.29,Default,,0,0,0,,Бүгінгі отырыс төбелеспен аяқталды.
Dialogue: 0,0:23:28.29,0:23:31.19,Default,,0,0,0,,Ешбір прогресссіз аяқтаңыз
Dialogue: 0,0:23:31.19,0:23:34.86,Default,,0,0,0,,Тонегава кешіріңіз
Dialogue: 0,0:23:34.86,0:23:37.80,Default,,0,0,0,,Гартер, Тонегава мырза ашуланды.
Dialogue: 0,0:23:37.80,0:23:40.50,Default,,0,0,0,,Бұл жаман. Иә, бұл рас.
Dialogue: 0,0:23:40.50,0:23:44.07,Default,,0,0,0,,Жарайды, кеттік. Боулингке барайық па?
Dialogue: 0,0:23:44.07,0:23:46.67,Default,,0,0,0,,Кем дегенде барлық қосалқы бөлшектерді жібермеңіз.
Dialogue: 0,0:23:49.11,0:23:51.44,Default,,0,0,0,,Менің қарамағындағылардың бәрі де кешірім сұрайды.
Dialogue: 0,0:23:51.44,0:23:56.48,Default,,0,0,0,,Сонда да бар күшіңді сал, Тонегава Жоғалтпа, Тонегава
Dialogue: 0,0:23:56.48,0:24:01.59,Default,,0,0,0,,Бұл бастық, төраға және оның қарамағындағылар арасында, қара киім.
Dialogue: 0,0:24:01.59,0:24:05.49,Default,,0,0,0,,Күрес Бұл бір адамның әңгімесі.
Dialogue: 0,0:24:05.49,0:24:09.79,Default,,0,0,0,,Юкио Тонегава орта менеджері
Dialogue: 0,0:25:44.42,0:25:46.72,Default,,0,0,0,,Келесі жолы «Содон»
Dialogue: 0,0:28:30.26,0:28:32.62,Default,,0,0,0,,Юкио Тонегава
Dialogue: 0,0:28:32.62,0:28:36.06,Default,,0,0,0,,Teiai тобы №2 Ашуланған адам
Dialogue: 0,0:28:36.06,0:28:38.63,Default,,0,0,0,,Кайджиді шегіне дейін итермелеу
Dialogue: 0,0:28:38.63,0:28:42.33,Default,,0,0,0,,Оның жақсылығын пайдаланып, жеңіліске ұшырады.
Dialogue: 0,0:28:42.33,0:28:46.04,Default,,0,0,0,,Төраға Казутака Хиодоның оң қолы ретінде
Dialogue: 0,0:28:46.04,0:28:50.54,Default,,0,0,0,,Тәкаппарлығын төбеге қондырған азаматтың қадір-қасиетін көрсету
Dialogue: 0,0:28:50.54,0:28:54.15,Default,,0,0,0,,Бұл Кайджимен кездескенге дейін болды.
Dialogue: 0,0:28:54.15,0:28:56.45,Default,,0,0,0,,Оның аңыз бен даңқының көлеңкесінде
Dialogue: 0,0:28:56.45,0:29:01.72,Default,,0,0,0,,Мен орта буын менеджері ретінде жасырын түрде қиналып, күресемін.
Dialogue: 0,0:29:01.72,0:29:08.62,Default,,0,0,0,,Ұлы адамның шағын әңгімесі.
Dialogue: 0,0:30:44.99,0:30:51.03,Default,,0,0,0,,Тейай тобының патшасы Хиодо төрағасының тікелей бұйрығымен.
Dialogue: 0,0:30:51.03,0:30:53.93,Default,,0,0,0,,Біз өлімнің шайтандық ойынын жоспарлауды шештік.
Dialogue: 0,0:30:53.93,0:30:58.23,Default,,0,0,0,,Teiai атқарушы Юкио Тонегава
Dialogue: 0,0:31:00.24,0:31:02.64,Default,,0,0,0,,Бірден жоба тобын құрды
Dialogue: 0,0:31:02.64,0:31:05.84,Default,,0,0,0,,Бірінші жоспарлау жиналысы өтті
Dialogue: 0,0:31:05.84,0:31:09.15,Default,,0,0,0,,Бірақ мен бірінші күннен сүріндім.
Dialogue: 0,0:31:09.15,0:31:13.18,Default,,0,0,0,,Қара киім мен күннен қорғайтын көзілдірік кигендіктен де айту қиын.
Dialogue: 0,0:31:13.18,0:31:16.96,Default,,0,0,0,,Және Ямадзаки Кавасаки Огино Хагио
Dialogue: 0,0:31:16.96,0:31:21.59,Default,,0,0,0,,Шатастырылған атаулар
Dialogue: 0,0:31:21.59,0:31:24.63,Default,,0,0,0,,Толқу, экстаз, ашу
Dialogue: 0,0:31:24.63,0:31:29.50,Default,,0,0,0,,Тонегава қол астындағылардың көзінше кенет есінен танып қалады.
Dialogue: 0,0:31:29.50,0:31:32.24,Default,,0,0,0,,Айырмашылық
Dialogue: 0,0:31:32.24,0:31:35.44,Default,,0,0,0,,Әрине, қара киімді адамдар абдырап қалды.
Dialogue: 0,0:31:35.44,0:31:39.34,Default,,0,0,0,,Тон өзені сәтсіз басталды
Dialogue: 0,0:31:43.38,0:31:45.78,Default,,0,0,0,,Ал келесі күні
Dialogue: 0,0:32:02.97,0:32:06.27,Default,,0,0,0,,Тағы да үшінші мәжіліс залы
Dialogue: 0,0:32:15.28,0:32:20.25,Default,,0,0,0,,Міне, енді біз бұл жобаның өзегіне жеттік.
Dialogue: 0,0:32:20.25,0:32:24.16,Default,,0,0,0,,Біз қандай ойын ойнайтынымызды арнайы талқылаймыз.
Dialogue: 0,0:32:24.16,0:32:29.03,Default,,0,0,0,,Ол үшін ең алдымен 1 және 2 үшін идеялар.
Dialogue: 0,0:32:29.03,0:32:32.23,Default,,0,0,0,,Идеялар
Dialogue: 0,0:32:32.23,0:32:36.70,Default,,0,0,0,,Төрағаның көңілін шайтандық ойын-сауық ретінде келтіретін оғаш ой.
Dialogue: 0,0:32:36.70,0:32:40.17,Default,,0,0,0,,Ойыңызға келгенше көп жариялауыңызды қалаймын.
Dialogue: 0,0:32:40.17,0:32:44.84,Default,,0,0,0,,Тонегава кеше ешқашан болмағандай жалынды сөз айтады.
Dialogue: 0,0:32:44.84,0:32:46.84,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:32:58.72,0:33:03.46,Default,,0,0,0,,Тыныштық О...
Dialogue: 0,0:33:03.46,0:33:07.00,Default,,0,0,0,,Дыбыс та, жарық та жете алмайтын терең теңіз түбіндей.
Dialogue: 0,0:33:07.00,0:33:09.70,Default,,0,0,0,,Абсолютті тыныштық
Dialogue: 0,0:33:11.77,0:33:16.67,Default,,0,0,0,,...
Dialogue: 0,0:33:23.35,0:33:27.79,Default,,0,0,0,,Қара киімділер иық тіресіп үнсіз тұрғанда.
Dialogue: 0,0:33:27.79,0:33:30.09,Default,,0,0,0,,Ояну сияқты
Dialogue: 0,0:33:39.36,0:33:44.46,Default,,0,0,0,,...
Dialogue: 0,0:33:48.07,0:33:50.58,Default,,0,0,0,,Гррр…
Dialogue: 0,0:33:50.58,0:33:53.34,Default,,0,0,0,,Төраға туралы қауіпті әзіл
Dialogue: 0,0:33:53.34,0:33:55.81,Default,,0,0,0,,Айтсам да жауап жоқ
Dialogue: 0,0:33:55.81,0:33:58.88,Default,,0,0,0,,...
Dialogue: 0,0:33:58.88,0:34:02.39,Default,,0,0,0,,...
Dialogue: 0,0:34:02.39,0:34:04.42,Default,,0,0,0,,Тон өзенінің жақындап келе жатқан қысымы
Dialogue: 0,0:34:04.42,0:34:08.63,Default,,0,0,0,,Орынсыз бірдеңені айта алмаймын деп қатты қорқу
Dialogue: 0,0:34:08.63,0:34:11.13,Default,,0,0,0,,Қатты шиеленіс жағдайында
Dialogue: 0,0:34:11.13,0:34:15.17,Default,,0,0,0,,...
Dialogue: 0,0:34:15.17,0:34:19.37,Default,,0,0,0,,«Мен ұлу болғым келеді».
Dialogue: 0,0:34:21.57,0:34:24.47,Default,,0,0,0,,Күте тұрыңыз! Бүркіт туралы айту...
Dialogue: 0,0:34:26.78,0:34:30.45,Default,,0,0,0,,Оған шыдай алмаған Қара киімділер Тон өзенінен мүлде бас тартты.
Dialogue: 0,0:34:30.45,0:34:32.52,Default,,0,0,0,,Ерекшелік Елемеу
Dialogue: 0,0:34:32.52,0:34:34.92,Default,,0,0,0,,Оқшауланған Тон өзені
Dialogue: 0,0:34:34.92,0:34:37.92,Default,,0,0,0,,Арх!
Dialogue: 0,0:34:43.36,0:34:47.57,Default,,0,0,0,,...
Dialogue: 0,0:34:47.57,0:34:49.57,Default,,0,0,0,,Сонда!
Dialogue: 0,0:34:49.57,0:34:52.47,Default,,0,0,0,,А, мен бір нәрсені айтуды ұмытып кетіппін.
Dialogue: 0,0:34:52.47,0:34:54.87,Default,,0,0,0,,...
Dialogue: 0,0:34:54.87,0:34:57.78,Default,,0,0,0,,々
Dialogue: 0,0:34:57.78,0:35:01.48,Default,,0,0,0,,...
Dialogue: 0,0:35:01.48,0:35:04.78,Default,,0,0,0,,...
Dialogue: 0,0:35:04.78,0:35:07.08,Default,,0,0,0,,Қанша рет айтсаң да түсінбейтін ақымақтар әрқашан болады.
Dialogue: 0,0:35:10.86,0:35:15.66,Default,,0,0,0,,...
Dialogue: 0,0:35:15.66,0:35:18.30,Default,,0,0,0,,Өйткені мен оны ұсынамын!
Dialogue: 0,0:35:18.30,0:35:22.50,Default,,0,0,0,,...
Dialogue: 0,0:35:22.50,0:35:25.90,Default,,0,0,0,,Жоғарыға тікелей есеп беру
Dialogue: 0,0:35:28.31,0:35:33.51,Default,,0,0,0,,Тон өзені толқып тұр! Одан да жігерлендіріңіз!
Dialogue: 0,0:35:33.51,0:35:36.38,Default,,0,0,0,,Дәлелдерді есіме түсірдім
Dialogue: 0,0:35:36.38,0:35:39.08,Default,,0,0,0,,Әрқайсыларыңыздың бет-әлпеттеріңіз бен есімдеріңіз.
Dialogue: 0,0:35:39.08,0:35:41.42,Default,,0,0,0,,Ямадзаки! иә
Dialogue: 0,0:35:41.42,0:35:43.49,Default,,0,0,0,,Кавасаки! иә
Dialogue: 0,0:35:43.49,0:35:46.19,Default,,0,0,0,,Сабуро Саймон! иә!
Dialogue: 0,0:35:46.19,0:35:49.19,Default,,0,0,0,,Гонда Наката Иә
Dialogue: 0,0:35:49.19,0:35:52.33,Default,,0,0,0,,Дошита Нагата Иә
Dialogue: 0,0:35:52.33,0:35:54.33,Default,,0,0,0,,Кикучи Иә
Dialogue: 0,0:35:54.33,0:35:59.04,Default,,0,0,0,,Сіз Хагиосыз! Иә
Dialogue: 0,0:35:59.04,0:36:02.64,Default,,0,0,0,,Сіз Огиносыз.
Dialogue: 0,0:36:02.64,0:36:06.84,Default,,0,0,0,,Сіз емес Ogino Иә.
Dialogue: 0,0:36:06.84,0:36:09.88,Default,,0,0,0,,Сіз Ogio Иәсіз.
Dialogue: 0,0:36:09.88,0:36:12.95,Default,,0,0,0,,Керемет, Тонегава мырза.
Dialogue: 0,0:36:12.95,0:36:14.95,Default,,0,0,0,,Хун
Dialogue: 0,0:36:18.82,0:36:22.16,Default,,0,0,0,,Ах
Dialogue: 0,0:36:22.16,0:36:24.96,Default,,0,0,0,,минуттық дыбысты ескерту
Dialogue: 0,0:36:24.96,0:36:28.13,Default,,0,0,0,,Жүректің моменттік ауытқуы
Dialogue: 0,0:36:28.13,0:36:32.34,Default,,0,0,0,,Осының бәрінен кейін сіз оны әлі түсінбей жүрсіз бе?
Dialogue: 0,0:36:32.34,0:36:34.57,Default,,0,0,0,,Бұл мүмкіндік
Dialogue: 0,0:36:34.57,0:36:39.17,Default,,0,0,0,,Бұл біз үшін қатарда ілгерілеу үшін бұрын-соңды болмаған мүмкіндік.
Dialogue: 0,0:36:43.18,0:36:46.05,Default,,0,0,0,,Тонегаваның сыбырларына
Dialogue: 0,0:36:46.05,0:36:49.55,Default,,0,0,0,,Әуелде қара киімдер басып кетті, бірақ
Dialogue: 0,0:36:49.55,0:36:52.65,Default,,0,0,0,,Қозғалыңыз!
Dialogue: 0,0:36:54.69,0:36:56.79,Default,,0,0,0,,Ах
Dialogue: 0,0:37:06.97,0:37:09.07,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:37:11.78,0:37:15.91,Default,,0,0,0,,Хехехе, жол ашатын, батыр.
Dialogue: 0,0:37:15.91,0:37:19.62,Default,,0,0,0,,Сабуро Саймон, тыңдауға рұқсат етіңіз.
Dialogue: 0,0:37:19.62,0:37:24.02,Default,,0,0,0,,Тас, қағаз, қайшыға негізделген ойын ше?
Dialogue: 0,0:37:26.36,0:37:29.36,Default,,0,0,0,,А? Тас, қағаз, қайшы?
Dialogue: 0,0:37:32.03,0:37:35.93,Default,,0,0,0,,А, жоқ, бұл қандай ойын болатынын әлі ойлаған жоқпын.
Dialogue: 0,0:37:35.93,0:37:41.07,Default,,0,0,0,,Менің ойымша, тасты, қағазды, қайшыны ерекше ережелерге ауыстырсақ, қызық болар еді Ахаха
Dialogue: 0,0:37:41.07,0:37:43.11,Default,,0,0,0,,Тонегава ойланып қалды
Dialogue: 0,0:37:43.11,0:37:46.81,Default,,0,0,0,,«Сол арнайы ереже туралы маған түсінік беріңіз».
Dialogue: 0,0:37:49.08,0:37:51.48,Default,,0,0,0,,Бірақ мен мұны осында айтсам
Dialogue: 0,0:37:51.48,0:37:55.72,Default,,0,0,0,,Біз жасау үшін көп еңбек еткен атмосфера бұзылды.
Dialogue: 0,0:37:55.72,0:37:58.26,Default,,0,0,0,,Аузыңызды қайтадан жауып тұрыңыз
Dialogue: 0,0:37:58.26,0:38:01.06,Default,,0,0,0,,Барлық су көпіршіктері
Dialogue: 0,0:38:03.09,0:38:05.66,Default,,0,0,0,,Қызық па?
Dialogue: 0,0:38:05.66,0:38:10.00,Default,,0,0,0,,Мен көремін. Тас-қағаз-қайшыда ережелерді білмейтін адам жоқ.
Dialogue: 0,0:38:10.00,0:38:14.44,Default,,0,0,0,,Басқаша айтқанда, ойыншылар арасында біртүрлі теңсіздік сезімін тудыру қиын.
Dialogue: 0,0:38:14.44,0:38:18.31,Default,,0,0,0,,Сәлем Эбитани Иә.
Dialogue: 0,0:38:18.31,0:38:21.21,Default,,0,0,0,,Кенеттен тамаша ой келді.
Dialogue: 0,0:38:21.21,0:38:24.08,Default,,0,0,0,,Ах... Рахмет!
Dialogue: 0,0:38:24.08,0:38:26.18,Default,,0,0,0,,Басқалар ше?
Dialogue: 0,0:38:30.42,0:38:33.52,Default,,0,0,0,,Иә! иә!
Dialogue: 0,0:38:33.52,0:38:35.86,Default,,0,0,0,,Иә, бұл
Dialogue: 0,0:38:35.86,0:38:38.90,Default,,0,0,0,,Қанға қауіп төнетін махжонг туралы не деуге болады?
Dialogue: 0,0:38:38.90,0:38:40.93,Default,,0,0,0,,Жындық идеялар
Dialogue: 0,0:38:40.93,0:38:44.54,Default,,0,0,0,,Жыртқыш аңмен бетпе-бет келу деген нені білдіреді? Өте жақсы
Dialogue: 0,0:38:44.54,0:38:46.54,Default,,0,0,0,,Электрлік арқанның жаңалығы
Dialogue: 0,0:38:46.54,0:38:48.64,Default,,0,0,0,,Адам денесінің тамашалығы
Dialogue: 0,0:38:48.64,0:38:53.04,Default,,0,0,0,,Мақтау Қандай жағдайда да мақтау!
Dialogue: 0,0:38:53.04,0:38:56.75,Default,,0,0,0,,Қолдануға болмайтын идея болса да
Dialogue: 0,0:38:56.75,0:38:58.78,Default,,0,0,0,,Мен тағы бір нәрсені есіме түсірдім, мысалы, профессор Тонегава...
Dialogue: 0,0:38:58.78,0:39:01.55,Default,,0,0,0,,Менің тағы бір ойым бар. Ойлап қарасам, бұл ескі ойын...
Dialogue: 0,0:39:01.55,0:39:07.46,Default,,0,0,0,,Көптеген адамдар бастықтарынан мақтау алу үшін қара киім идеясын ұсынады.
Dialogue: 0,0:39:07.46,0:39:12.73,Default,,0,0,0,,Фуфуфу Гя Гя Гя Дәл құстың баласы сияқты
Dialogue: 0,0:39:12.73,0:39:17.67,Default,,0,0,0,,Ата-анасынан ас сұраған жас бұлбұл
Dialogue: 0,0:39:17.67,0:39:19.90,Default,,0,0,0,,Бірақ жақсы.
Dialogue: 0,0:39:19.90,0:39:22.94,Default,,0,0,0,,Жиналыста көптеген идеяларды қалай шығаруға болады
Dialogue: 0,0:39:22.94,0:39:26.18,Default,,0,0,0,,Ең алдымен айту оңай болатындай жағдай жасау маңызды.
Dialogue: 0,0:39:26.18,0:39:31.25,Default,,0,0,0,,Ал ең соңғысы – юмор
Dialogue: 0,0:39:31.25,0:39:34.15,Default,,0,0,0,,Тонегава мырза, Тонегава мырза
Dialogue: 0,0:39:34.15,0:39:37.25,Default,,0,0,0,,Ханзада Шотоку! Эх...
Dialogue: 0,0:39:39.36,0:39:42.46,Default,,0,0,0,,Бірден көп адаммен сөйлесу
Dialogue: 0,0:39:42.46,0:39:45.66,Default,,0,0,0,,Бұл Шотоку ханзада ма?
Dialogue: 0,0:39:55.61,0:39:58.11,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:40:03.51,0:40:08.25,Default,,0,0,0,,Жарайды, жарайды, мен ағынды ұстадым.
Dialogue: 0,0:40:08.25,0:40:12.52,Default,,0,0,0,,Әзіл - тот басқан дөңгелектің майлаушысы
Dialogue: 0,0:40:12.52,0:40:17.80,Default,,0,0,0,,Олай болса, бірігіп, алға ұмтылу ғана қалады.
Dialogue: 0,0:40:17.80,0:40:22.40,Default,,0,0,0,,Иә? Бұл кім? Жолдан кет! Сізді басып алғыңыз келе ме?
Dialogue: 0,0:40:25.14,0:40:27.34,Default,,0,0,0,,Уф
Dialogue: 0,0:40:29.31,0:40:34.05,Default,,0,0,0,,Осы кезде Тон өзеніне сөзбен жеткізгісіз салқын соғады.
Dialogue: 0,0:40:34.05,0:40:38.75,Default,,0,0,0,,Сұмдық, өлім құдайы артта қалғандай.
Dialogue: 0,0:40:43.02,0:40:46.52,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:40:46.52,0:40:48.62,Default,,0,0,0,,Уф...
Dialogue: 0,0:40:59.10,0:41:02.77,Default,,0,0,0,,(Көрермен) Мен оны мінген күйдегі шайқасқа дейін қызықты жігіт деп ойладым…
Dialogue: 0,0:41:02.77,0:41:04.87,Default,,0,0,0,,Төраға Хиодо
Dialogue: 0,0:41:14.95,0:41:17.05,Default,,0,0,0,,Уау
Dialogue: 0,0:41:17.05,0:41:20.39,Default,,0,0,0,,Императордың келуі Төраға Хиодоның пайда болуымен
Dialogue: 0,0:41:20.39,0:41:23.39,Default,,0,0,0,,Толығымен өзгеретін үшінші конференц-зал
Dialogue: 0,0:41:23.39,0:41:27.70,Default,,0,0,0,,Шиеленісті атмосфера, шиеленіске толы
Dialogue: 0,0:41:27.70,0:41:30.84,Default,,0,0,0,,Мен жай ғана сені тексеруге келдім.
Dialogue: 0,0:41:30.84,0:41:33.04,Default,,0,0,0,,Бұл кедергі болды ма?
Dialogue: 0,0:41:33.04,0:41:35.97,Default,,0,0,0,,Жоқ...жоқ, бұл дұрыс емес.
Dialogue: 0,0:41:35.97,0:41:38.88,Default,,0,0,0,,-де? Қалай жағдай?
Dialogue: 0,0:41:38.88,0:41:42.85,Default,,0,0,0,,Қазіргі уақытта менде ойын тақырыптары бойынша идеялар бар.
Dialogue: 0,0:41:42.85,0:41:45.12,Default,,0,0,0,,Өшіруді аяқтағаннан кейін
Dialogue: 0,0:41:45.12,0:41:48.45,Default,,0,0,0,,А, бұл идея, ол қайсысы?
Dialogue: 0,0:41:48.45,0:41:51.56,Default,,0,0,0,,Ақыр соңында
Dialogue: 0,0:41:51.56,0:41:55.09,Default,,0,0,0,,Осылардың қайсысын таңдайсыз?
Dialogue: 0,0:41:55.09,0:41:58.83,Default,,0,0,0,,Ей, қазір істейік.
Dialogue: 0,0:41:58.83,0:42:01.90,Default,,0,0,0,,Қазір бастайсыз ба? Иә
Dialogue: 0,0:42:01.90,0:42:07.91,Default,,0,0,0,,Уф, төраға болса, алған ағымымыз бұзылады.
Dialogue: 0,0:42:07.91,0:42:11.81,Default,,0,0,0,,Мен төрағаның бөлмеден тезірек кетуін қалаймын.
Dialogue: 0,0:42:11.81,0:42:14.38,Default,,0,0,0,,Төраға, өтінемін...
Dialogue: 0,0:42:14.38,0:42:17.38,Default,,0,0,0,,Е, ол қайда?
Dialogue: 0,0:42:21.55,0:42:25.66,Default,,0,0,0,,Ебия!
Dialogue: 0,0:42:25.66,0:42:29.93,Default,,0,0,0,,Эбитани атмосфераны оқи алмайды
Dialogue: 0,0:42:29.93,0:42:34.33,Default,,0,0,0,,Жалғастыру иә
Dialogue: 0,0:42:34.33,0:42:36.37,Default,,0,0,0,,Қателерге жол берілмейді
Dialogue: 0,0:42:36.37,0:42:41.17,Default,,0,0,0,,Қатты шиеленіс пен қорқыныш Қара киімге шабуыл жасайды.
Dialogue: 0,0:42:41.17,0:42:45.37,Default,,0,0,0,,Тон өзені болса да, бұл жерде шатассаң, сырттасың.
Dialogue: 0,0:42:52.55,0:42:57.15,Default,,0,0,0,,Сонымен, осы уақытқа дейін айтылған барлық идеялардың ішінде қайсысы жақсы?
Dialogue: 0,0:42:57.15,0:43:00.46,Default,,0,0,0,,Әр адамның пікірі тыңдалсын
Dialogue: 0,0:43:00.46,0:43:03.36,Default,,0,0,0,,Yamazaki Иә!
Dialogue: 0,0:43:03.36,0:43:06.96,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:43:06.96,0:43:11.44,Default,,0,0,0,,Профессор Тонегаваның көтермелеуімен менде әртүрлі идеялар пайда болды.
Dialogue: 0,0:43:11.44,0:43:15.04,Default,,0,0,0,,Қайталап қарасаңыз, барлығы бір-біріне ұқсас ойлар.
Dialogue: 0,0:43:15.04,0:43:17.21,Default,,0,0,0,,Қайсысы жақсы?
Dialogue: 0,0:43:17.21,0:43:21.01,Default,,0,0,0,,Не болды? Тез жауап беріңіз. Ха... Иә.
Dialogue: 0,0:43:32.99,0:43:38.33,Default,,0,0,0,,Тез жауап бермесеңіз, иә.
Dialogue: 0,0:43:38.33,0:43:42.80,Default,,0,0,0,,Тас, қағаз, қайшыға негізделген ойын ше?
Dialogue: 0,0:43:42.80,0:43:47.00,Default,,0,0,0,,Бұл қызық. Бұл кенеттен келген идея.
Dialogue: 0,0:43:49.01,0:43:53.58,Default,,0,0,0,,Мен...тас-қағаз-қайшы жақсырақ деп ойлаймын.
Dialogue: 0,0:43:53.58,0:43:56.91,Default,,0,0,0,,Иә, тас-қағаз-қайшы?
Dialogue: 0,0:43:56.91,0:43:58.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:58.98,0:44:01.35,Default,,0,0,0,,Ха... Қабылданбады
Dialogue: 0,0:44:01.35,0:44:04.86,Default,,0,0,0,,Тас-қағаз-қайшыдан бас тарту, т.б.
Dialogue: 0,0:44:04.86,0:44:07.32,Default,,0,0,0,,Ал... Мен мұны бұрын жақсы идея деп ойладым.
Dialogue: 0,0:44:07.32,0:44:10.93,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,0:44:10.93,0:44:15.60,Default,,0,0,0,,Сонымен… бұл адам денесінің жұмбағы ма?
Dialogue: 0,0:44:15.60,0:44:18.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:18.24,0:44:20.84,Default,,0,0,0,,А, бұл идея жақсы емес.
Dialogue: 0,0:44:20.84,0:44:24.88,Default,,0,0,0,,Қол тигізбейтін
Dialogue: 0,0:44:24.88,0:44:28.85,Default,,0,0,0,,Гуде десу, өмірлік өлшем Сугороку
Dialogue: 0,0:44:28.85,0:44:30.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:38.59,0:44:42.86,Default,,0,0,0,,Бұл қандай өрнек?
Dialogue: 0,0:44:42.86,0:44:47.63,Default,,0,0,0,,Бұл тіпті көп жылдар бойы Хиодо төрағасының оң қолы болған Тонегава болатын.
Dialogue: 0,0:44:47.63,0:44:49.67,Default,,0,0,0,,Сіз бұрын ешқашан көрмеген өрнек
Dialogue: 0,0:44:49.67,0:44:52.10,Default,,0,0,0,,Не істеу керек Тон өзені
Dialogue: 0,0:44:52.10,0:44:56.14,Default,,0,0,0,,Қайсысы жақсы немесе нашар?
Dialogue: 0,0:44:56.14,0:45:00.81,Default,,0,0,0,,Соңғысы шығар. Бұл, әрине, жақсы реакция емес.
Dialogue: 0,0:45:00.81,0:45:04.81,Default,,0,0,0,,Бұл да қабылданбады. Қабылданбады! Қабылданбады!
Dialogue: 0,0:45:08.42,0:45:11.82,Default,,0,0,0,,Не... бұл көздер қандай?
Dialogue: 0,0:45:11.82,0:45:15.33,Default,,0,0,0,,Қайсысы! не?
Dialogue: 0,0:45:15.33,0:45:20.10,Default,,0,0,0,,Егер сіз соншалықты көп айтсаңыз, сізге қайсысы ұнайды, Тонегава мырза?
Dialogue: 0,0:45:20.10,0:45:24.40,Default,,0,0,0,,Жоқ... бұл...
Dialogue: 0,0:45:24.40,0:45:28.27,Default,,0,0,0,,Бұл... бұл Кавасаки, жоқ, Ямадзаки
Dialogue: 0,0:45:28.27,0:45:32.37,Default,,0,0,0,,Қайсысын ұмытып қалдым, бірақ мынау.
Dialogue: 0,0:45:35.55,0:45:38.55,Default,,0,0,0,,Иә
Dialogue: 0,0:45:38.55,0:45:41.95,Default,,0,0,0,,Мен... мен саған бердім.
Dialogue: 0,0:45:41.95,0:45:45.62,Default,,0,0,0,,Уақытты бомба
Dialogue: 0,0:45:45.62,0:45:52.03,Default,,0,0,0,,Үй жануары болса да, азу тістері жалаңаш
Dialogue: 0,0:45:52.03,0:45:56.40,Default,,0,0,0,,Неліктен қыран қара киіммен шықты?
Dialogue: 0,0:45:56.40,0:46:00.20,Default,,0,0,0,,Иә, қайсысы?
Dialogue: 0,0:46:00.20,0:46:03.91,Default,,0,0,0,,Қайсысы дұрыс жауап?
Dialogue: 0,0:46:03.91,0:46:08.65,Default,,0,0,0,,Білмеймін, мүлде түсінбеймін
Dialogue: 0,0:46:08.65,0:46:11.65,Default,,0,0,0,,Сізге бір ғана мүмкіндік беріледі, ешқашан екі рет болмайды.
Dialogue: 0,0:46:11.65,0:46:14.22,Default,,0,0,0,,Егер сіз бұл жерде шатассаңыз, сіз ұшып кетесіз.
Dialogue: 0,0:46:14.22,0:46:19.32,Default,,0,0,0,,Осы уақытқа дейінгі мансап, сенімділік, танымалдық, бәрі!
Dialogue: 0,0:46:19.32,0:46:21.42,Default,,0,0,0,,Уф
Dialogue: 0,0:46:30.10,0:46:33.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:46:36.01,0:46:38.11,Default,,0,0,0,,Тонегава мырза
Dialogue: 0,0:46:40.81,0:46:42.91,Default,,0,0,0,,Сіз мені тыңдай аласыз ба, Тонегава мырза?
Dialogue: 0,0:46:42.91,0:46:45.81,Default,,0,0,0,,Шарап! Ах
Dialogue: 0,0:46:51.19,0:46:55.06,Default,,0,0,0,,Үрме, ит!
Dialogue: 0,0:46:55.06,0:46:57.70,Default,,0,0,0,,Не айтсаң да айтамын
Dialogue: 0,0:46:57.70,0:46:59.86,Default,,0,0,0,,Менің жауабым
Dialogue: 0,0:46:59.86,0:47:02.80,Default,,0,0,0,,Міне!
Dialogue: 0,0:47:02.80,0:47:04.90,Default,,0,0,0,,Ах
Dialogue: 0,0:47:08.47,0:47:11.64,Default,,0,0,0,,Нуа ноа
Dialogue: 0,0:47:11.64,0:47:15.05,Default,,0,0,0,,Тонегава мырза! Не!
Dialogue: 0,0:47:15.05,0:47:17.21,Default,,0,0,0,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,0:47:17.21,0:47:21.82,Default,,0,0,0,,Бұлардың арасынан таңдауға ештеңе жоқ.
Dialogue: 0,0:47:21.82,0:47:25.62,Default,,0,0,0,,Барлық дұрыс жауаптар жойылады
Dialogue: 0,0:47:28.13,0:47:31.43,Default,,0,0,0,,Иә, қате таңдау жасамаңыз
Dialogue: 0,0:47:31.43,0:47:37.00,Default,,0,0,0,,Жалғыз дұрыс жауап – оны таңдамау.
Dialogue: 0,0:47:37.00,0:47:39.00,Default,,0,0,0,,Nu
Dialogue: 0,0:47:42.14,0:47:44.44,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:47:44.44,0:47:48.35,Default,,0,0,0,,Өйткені ол дәл қазір жарық емес еді!
Dialogue: 0,0:47:48.35,0:47:51.72,Default,,0,0,0,,Бұл жоба оңай алға жылжи алады.
Dialogue: 0,0:47:51.72,0:47:54.42,Default,,0,0,0,,Жарық емес
Dialogue: 0,0:47:54.42,0:47:58.76,Default,,0,0,0,,Керемет идеялар көбірек болуы керек
Dialogue: 0,0:47:58.76,0:48:02.26,Default,,0,0,0,,Бұл дұрыс және тәуекелден аулақ болудан алыс
Dialogue: 0,0:48:02.26,0:48:04.30,Default,,0,0,0,,Апелляция
Dialogue: 0,0:48:04.30,0:48:09.60,Default,,0,0,0,,Дағдарысты мүмкіндікке айналдырудың тамаша әдістемесі
Dialogue: 0,0:48:11.57,0:48:15.37,Default,,0,0,0,,Ultra C!
Dialogue: 0,0:48:15.37,0:48:18.47,Default,,0,0,0,,Сіз солай ойлайсыз ба, төраға?
Dialogue: 0,0:48:21.38,0:48:26.78,Default,,0,0,0,,Қараңызшы, төраға да басын изеп жатыр...
Dialogue: 0,0:48:26.78,0:48:29.38,Default,,0,0,0,,А? Ах!
Dialogue: 0,0:48:44.23,0:48:49.24,Default,,0,0,0,,Шындығында, бұл уақытта сағат 10-дар шамасында болатын.
Dialogue: 0,0:48:49.24,0:48:53.38,Default,,0,0,0,,Бұл қазірдің өзінде қарттардың ұйықтау уақыты.
Dialogue: 0,0:48:53.38,0:48:59.72,Default,,0,0,0,,Иә, империялық махаббат патшасы, Казутака Хиодо, бірақ ата.
Dialogue: 0,0:48:59.72,0:49:02.65,Default,,0,0,0,,Ата
Dialogue: 0,0:49:02.65,0:49:07.06,Default,,0,0,0,,Мен енді тамақ жей алмаймын, о...
Dialogue: 0,0:49:07.06,0:49:09.39,Default,,0,0,0,,Сіз ренжідіңіз бе?
Dialogue: 0,0:49:09.39,0:49:12.59,Default,,0,0,0,,қатты ұйықтап жатыр
Dialogue: 0,0:49:15.23,0:49:19.20,Default,,0,0,0,,Тонегава Бірінші шаршыға қайта оралу
Dialogue: 0,0:49:19.20,0:49:24.64,Default,,0,0,0,,Сонда да барыңды сал, Тонегава Жоғалтпа, Тонегава
Dialogue: 0,0:49:24.64,0:49:30.75,Default,,0,0,0,,Бұл бастық, төраға және бағыныштылар арасында, қара киім.
Dialogue: 0,0:49:30.75,0:49:36.32,Default,,0,0,0,,Күрес Бұл бір адамның әңгімесі.
Dialogue: 0,0:49:36.32,0:49:41.12,Default,,0,0,0,,Юкио Тонегава ортаңғы менеджері
Dialogue: 0,0:51:19.26,0:51:21.86,Default,,0,0,0,,Келесі жолы «Теппаняки»
Dialogue: 0,0:54:06.02,0:54:08.83,Default,,0,0,0,,Якидогеза
Dialogue: 0,0:54:08.83,0:54:13.40,Default,,0,0,0,,Догеза күйіп тұрған темір табаққа
Dialogue: 0,0:54:13.40,0:54:17.83,Default,,0,0,0,,Әрине, қолынан келетін адам жоқ.
Dialogue: 0,0:54:17.83,0:54:20.57,Default,,0,0,0,,Бірақ мен сенің қашып кетуіңе жол бермеймін
Dialogue: 0,0:54:20.57,0:54:25.21,Default,,0,0,0,,Догеза күш машинасы
Dialogue: 0,0:54:25.21,0:54:29.21,Default,,0,0,0,,Бірақ бұл адам басқаша болды.
Dialogue: 0,0:54:31.25,0:54:34.75,Default,,0,0,0,,Жолдан шығыңыз Ол машинаны жолдан шығарыңыз
Dialogue: 0,0:54:37.85,0:54:41.89,Default,,0,0,0,,Якидогеза
Dialogue: 0,0:54:41.89,0:54:45.13,Default,,0,0,0,,Түннен бастап бұл таңқаларлық аңыз дүниеге келді
Dialogue: 0,0:54:45.13,0:54:47.83,Default,,0,0,0,,Уақыт кері кетеді
Dialogue: 0,0:54:50.07,0:54:54.27,Default,,0,0,0,,Teiai тобы Казутака Хиодоның қалауы бойынша
Dialogue: 0,0:54:54.27,0:54:59.38,Default,,0,0,0,,Тонегава өлімнің шайтан ойынын жоспарлауды шешеді.
Dialogue: 0,0:54:59.38,0:55:02.01,Default,,0,0,0,,Бағыныңқылардың шатастырылған есімдерін еске түсіру
Dialogue: 0,0:55:02.01,0:55:05.95,Default,,0,0,0,,Бірлігімізді нығайтқаннан кейін...
Dialogue: 0,0:55:05.95,0:55:09.65,Default,,0,0,0,,Бүркіт жоғалған шығар
Dialogue: 0,0:55:09.65,0:55:13.32,Default,,0,0,0,,Бағыныштылардың танымалдылығы мен сенімі
Dialogue: 0,0:55:13.32,0:55:18.06,Default,,0,0,0,,Олардың ойлап тапқан идеялары таңқаларлық емес
Dialogue: 0,0:55:18.06,0:55:20.66,Default,,0,0,0,,Мені қатты мақтаңыз
Dialogue: 0,0:55:23.17,0:55:26.27,Default,,0,0,0,,Алақанның қайтарылуы Өзін-өзі қорғау
Dialogue: 0,0:55:26.27,0:55:31.84,Default,,0,0,0,,Өшіру өшіру жасыру
Dialogue: 0,0:55:31.84,0:55:34.71,Default,,0,0,0,,Хехехе, дәл солай.
Dialogue: 0,0:55:34.71,0:55:39.12,Default,,0,0,0,,Өткенде мен жек көретін кәдімгі қоқыс сияқты.
Dialogue: 0,0:55:39.12,0:55:42.32,Default,,0,0,0,,Өзіңізді алдамаңыз! Бүркіттер әртүрлі
Dialogue: 0,0:55:42.32,0:55:45.16,Default,,0,0,0,,Teiai тобын құру
Dialogue: 0,0:55:45.16,0:55:49.46,Default,,0,0,0,,Мен оны жылдар бойы жинақтап келемін!
Dialogue: 0,0:55:49.46,0:55:53.73,Default,,0,0,0,,Осы жерден қалпына келтіріңіз
Dialogue: 0,0:55:53.73,0:55:55.93,Default,,0,0,0,,Ар-намыс және абыройсыздық
Dialogue: 0,0:56:04.81,0:56:11.28,Default,,0,0,0,,Teiai Group алып компаниясының №2 Юкио Тонегава
Dialogue: 0,0:56:11.28,0:56:17.58,Default,,0,0,0,,Саяси және іскерлік әлемде үстемдік ететін құбыжық, Хиодо Төрағаның оң қолы болған ашулы адам.
Dialogue: 0,0:56:19.56,0:56:22.76,Default,,0,0,0,,Бұл оның аңызының және даңқының астарында жатыр
Dialogue: 0,0:56:22.76,0:56:27.63,Default,,0,0,0,,Мен орта буын менеджері ретінде жасырын түрде қиналып, күресемін.
Dialogue: 0,0:56:27.63,0:56:34.93,Default,,0,0,0,,Бұл ұлы адам туралы шағын әңгіме.
Dialogue: 0,0:58:10.50,0:58:15.31,Default,,0,0,0,,Бұл жолы күнделікті күш-жігеріңіз үшін алғыс айтамын.
Dialogue: 0,0:58:15.31,0:58:20.34,Default,,0,0,0,,Мен шағын болса да бір түн, екі күндік компания сапарын жоспарладым.
Dialogue: 0,0:58:20.34,0:58:22.81,Default,,0,0,0,,А, осы сапар арқылы
Dialogue: 0,0:58:22.81,0:58:26.25,Default,,0,0,0,,Ұжымымыздың достығын тереңдету арқылы
Dialogue: 0,0:58:26.25,0:58:29.82,Default,,0,0,0,,Бұл өз кезегінде осы жобаның одан әрі дамуына және табысты болуына ықпал етеді.
Dialogue: 0,0:58:29.82,0:58:35.36,Default,,0,0,0,,Байланысқа ықпал ететін фактор болса жақсы болар еді.
Dialogue: 0,0:58:35.36,0:58:37.46,Default,,0,0,0,,Уф
Dialogue: 0,0:58:50.17,0:58:55.35,Default,,0,0,0,,Қол астындағыларымызбен арадағы жыртық Жер жарылып барады
Dialogue: 0,0:58:55.35,0:58:57.51,Default,,0,0,0,,ұша алатын қашықтық
Dialogue: 0,0:58:57.51,0:59:01.25,Default,,0,0,0,,Тонегава ойланбастан алға
Dialogue: 0,0:59:01.25,0:59:04.72,Default,,0,0,0,,Тек алға!
Dialogue: 0,0:59:04.72,0:59:09.33,Default,,0,0,0,,Міне, осындай ресми мақсат бар.
Dialogue: 0,0:59:09.33,0:59:14.60,Default,,0,0,0,,Қолыңыздағы саяхат кітапшасының 3 бетіне назар аударыңыз.
Dialogue: 0,0:59:14.60,0:59:16.67,Default,,0,0,0,,Ах
Dialogue: 0,0:59:16.67,0:59:20.57,Default,,0,0,0,,ойын-сауық ойын-сауық ойын-сауық басынан аяғына дейін ойын-сауық
Dialogue: 0,0:59:20.57,0:59:22.87,Default,,0,0,0,,және бос уақыт
Dialogue: 0,0:59:22.87,0:59:25.64,Default,,0,0,0,,Соңғы екі күнде жұмысты ұмытып, өзіңізді еркін сезініңіз.
Dialogue: 0,0:59:25.64,0:59:28.48,Default,,0,0,0,,Қанатыңды көп жайғаныңды қалаймын.
Dialogue: 0,0:59:28.48,0:59:31.41,Default,,0,0,0,,Күйеуім іссапармен кеткен, бір аптаға дейін келмейді
Dialogue: 0,0:59:31.41,0:59:35.52,Default,,0,0,0,,Бұл анық, Ямадзаки мырза.
Dialogue: 0,0:59:35.52,0:59:39.66,Default,,0,0,0,,Олардың бізді кіргізгісі келетіні көрініп тұр.
Dialogue: 0,0:59:39.66,0:59:42.69,Default,,0,0,0,,Әйтеуір, соңғы кездесудегі орынсыз әрекет...
Dialogue: 0,0:59:42.69,0:59:45.73,Default,,0,0,0,,Менің ойымша, сіз оның орнын толтыруға тырысып жатырсыз.
Dialogue: 0,0:59:45.73,0:59:48.30,Default,,0,0,0,,Жағымсыз әсер Уф
Dialogue: 0,0:59:48.30,0:59:50.60,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:59:50.60,0:59:53.80,Default,,0,0,0,,Қол астындағылар қанат жая алатын компанияға саяхат
Dialogue: 0,0:59:53.80,0:59:55.84,Default,,0,0,0,,Бізде бастық болғанша, біз
Dialogue: 0,0:59:55.84,0:59:59.01,Default,,0,0,0,,Бұл туралы басынан аяғына дейін уайымдауға тура келетініне сенімдімін.
Dialogue: 0,0:59:59.01,1:00:03.38,Default,,0,0,0,,Цк, не деген мазасыз, асыл мерекеде.
Dialogue: 0,1:00:03.38,1:00:08.18,Default,,0,0,0,,Ол төмендей ме? Осындай нәрсемен біздің ішу әдетіміз төмендейді.
Dialogue: 0,1:00:13.29,1:00:16.86,Default,,0,0,0,,Көк аспан, таза ауа
Dialogue: 0,1:00:16.86,1:00:21.23,Default,,0,0,0,,Үстірттің керемет табиғатымен өрілген керемет панорама
Dialogue: 0,1:00:21.23,1:00:25.07,Default,,0,0,0,,Оның үстінде жын-шайтандарға арналған орын бар.
Dialogue: 0,1:00:25.07,1:00:28.10,Default,,0,0,0,,Аты Хакучосо
Dialogue: 0,1:00:28.10,1:00:31.40,Default,,0,0,0,,А... бұл жерде күн ашық.
Dialogue: 0,1:00:34.51,1:00:37.21,Default,,0,0,0,,Хехе, қалай?
Dialogue: 0,1:00:37.21,1:00:41.08,Default,,0,0,0,,Сондай-ақ, маджонг үстелі, бильярд үстелі және үстел теннисі үстелі бар.
Dialogue: 0,1:00:41.08,1:00:43.89,Default,,0,0,0,,Сондай-ақ дартс және караоке бөлмесі бар.
Dialogue: 0,1:00:43.89,1:00:47.52,Default,,0,0,0,,Сонымен қатар, сіз оны жалға беріп, қалағаныңызша ойнай аласыз.
Dialogue: 0,1:00:47.52,1:00:49.83,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:49.83,1:00:53.53,Default,,0,0,0,,Боулинг бар ма?
Dialogue: 0,1:00:53.53,1:00:57.13,Default,,0,0,0,,Сіңлім!
Dialogue: 0,1:00:57.13,1:00:59.20,Default,,0,0,0,,Жоқ...
Dialogue: 0,1:00:59.20,1:01:01.47,Default,,0,0,0,,Осы кезеңде бұл адам
Dialogue: 0,1:01:01.47,1:01:05.44,Default,,0,0,0,,Сіз әлі де боулингпен айналысқыңыз келе ме?
Dialogue: 0,1:01:05.44,1:01:07.81,Default,,0,0,0,,Ашудың күшеюі
Dialogue: 0,1:01:07.81,1:01:11.65,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,1:01:11.65,1:01:13.85,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,1:01:16.39,1:01:20.09,Default,,0,0,0,,Кешіріңіз, бұл жерде боулинг алаңы жоқ.
Dialogue: 0,1:01:20.09,1:01:23.46,Default,,0,0,0,,Егер сіз көлікті тастап кетсеңіз, оған бірнеше минут кетеді.
Dialogue: 0,1:01:23.46,1:01:28.53,Default,,0,0,0,,Ой, жоқ, жарайды, кешіріңіз, ұмытыңыз.
Dialogue: 0,1:01:28.53,1:01:32.17,Default,,0,0,0,,Шынымен бе? Tsk
Dialogue: 0,1:01:32.17,1:01:35.57,Default,,0,0,0,,Үйірме іс-әрекеті сияқты
Dialogue: 0,1:01:35.57,1:01:38.37,Default,,0,0,0,,Кеңесші рұқсатсыз жоспарлаған ғибадатхана лагерінде.
Dialogue: 0,1:01:38.37,1:01:42.78,Default,,0,0,0,,Боулинг клубының мүшелері күшпен әкелінді
Dialogue: 0,1:01:42.78,1:01:45.72,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:01:45.72,1:01:49.52,Default,,0,0,0,,Жоғалған сенімді қалпына келтіруге болады
Dialogue: 0,1:01:51.59,1:01:56.79,Default,,0,0,0,,Ямадзаки мырза, Тонегава мырза, сіз алаңда кездесуді айттыңыз.
Dialogue: 0,1:01:56.79,1:01:59.00,Default,,0,0,0,,Сіз не істеуге мәжбүр болдыңыз?
Dialogue: 0,1:01:59.00,1:02:02.33,Default,,0,0,0,,Я, мен түсінуге мүмкіндік жоқ.
Dialogue: 0,1:02:02.33,1:02:04.80,Default,,0,0,0,,Мұндай ақылсыз адам не ойлайды?
Dialogue: 0,1:02:04.80,1:02:07.77,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,1:02:07.77,1:02:10.47,Default,,0,0,0,,Әрине олай емес.
Dialogue: 0,1:02:12.54,1:02:17.85,Default,,0,0,0,,Бастыққа көңілі толмау
Dialogue: 0,1:02:17.85,1:02:23.05,Default,,0,0,0,,Компанияның қарапайым сапарларымен жабылмайтын сенімсіздік сезімі, т.б.
Dialogue: 0,1:02:27.29,1:02:30.46,Default,,0,0,0,,О, бәрі сонда ма? Ах
Dialogue: 0,1:02:30.46,1:02:33.16,Default,,0,0,0,,Қолыңыз болмаса, қолыңызды көтеріңіз
Dialogue: 0,1:02:35.73,1:02:38.80,Default,,0,0,0,,Хехехе
Dialogue: 0,1:02:38.80,1:02:40.94,Default,,0,0,0,,Иә, бәрі.
Dialogue: 0,1:02:40.94,1:02:44.34,Default,,0,0,0,,Олай болса, бастайық.
Dialogue: 0,1:02:46.74,1:02:50.55,Default,,0,0,0,,Ой
Dialogue: 0,1:02:50.55,1:02:54.78,Default,,0,0,0,,Егер сіз оны мейрамханада жесеңіз, 100 грамм он мың иен тұрады.
Dialogue: 0,1:02:54.78,1:02:58.32,Default,,0,0,0,,Ең жақсы Коби сиыры
Dialogue: 0,1:02:58.32,1:03:01.56,Default,,0,0,0,,Толық жеуге болатын барбекю
Dialogue: 0,1:03:01.56,1:03:03.73,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,1:03:03.73,1:03:06.23,Default,,0,0,0,,Уау! Коби сиыр еті!
Dialogue: 0,1:03:06.23,1:03:09.77,Default,,0,0,0,,Сәттілік Сәттілік!
Dialogue: 0,1:03:09.77,1:03:13.64,Default,,0,0,0,,Тіпті гурмандардың да аузынан ағып кететін шайтандық мәрмәр
Dialogue: 0,1:03:13.64,1:03:16.54,Default,,0,0,0,,Және одан әрі соққылар
Dialogue: 0,1:03:18.47,1:03:22.85,Default,,0,0,0,,Жүздеген мың шарап пен шампан ше?
Dialogue: 0,1:03:22.85,1:03:25.85,Default,,0,0,0,,Менің жертөлемнен таңдап алып келді.
Dialogue: 0,1:03:25.85,1:03:30.49,Default,,0,0,0,,Сіз өзіңізге ұнайтын кез келген брендті аша аласыз. Маған бәрібір...
Dialogue: 0,1:03:30.49,1:03:32.92,Default,,0,0,0,,Ой!
Dialogue: 0,1:03:32.92,1:03:35.83,Default,,0,0,0,,Жарқыраған күн астында шөліңді сула
Dialogue: 0,1:03:35.83,1:03:38.33,Default,,0,0,0,,Мұздай салқын премиум саке
Dialogue: 0,1:03:38.33,1:03:43.30,Default,,0,0,0,,Альфа толқындары керемет релаксация
Dialogue: 0,1:03:43.30,1:03:45.30,Default,,0,0,0,,Хехехе
Dialogue: 0,1:03:53.34,1:03:55.88,Default,,0,0,0,,Тон өзені ақыры ашылады
Dialogue: 0,1:03:55.88,1:04:00.38,Default,,0,0,0,,Өзіңізге сеніңіз: абыройыңызды қайтару үшін серпіліс
Dialogue: 0,1:04:00.38,1:04:03.59,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:03.59,1:04:07.06,Default,,0,0,0,,Сізде сыра бар ма?
Dialogue: 0,1:04:07.06,1:04:09.29,Default,,0,0,0,,Барбекюде сыра әрқашан қажет.
Dialogue: 0,1:04:09.29,1:04:12.06,Default,,0,0,0,,Тағы да ақымақ...
Dialogue: 0,1:04:12.06,1:04:14.50,Default,,0,0,0,,Фуфуфу жақсы жақсы
Dialogue: 0,1:04:14.50,1:04:18.64,Default,,0,0,0,,Сыра дүңгіршекте сатылады, сондықтан алып келуге батылым бармады.
Dialogue: 0,1:04:18.64,1:04:22.01,Default,,0,0,0,,Оны қазір сатып алыңыз, қалағаныңызша, қалағаныңызша...
Dialogue: 0,1:04:22.01,1:04:26.28,Default,,0,0,0,,А-а, үлкен қарын.
Dialogue: 0,1:04:26.28,1:04:29.68,Default,,0,0,0,,Ryo... Түбіртекті алушы Теяй ме?
Dialogue: 0,1:04:29.68,1:04:33.02,Default,,0,0,0,,А? Бұл нәрсені кеспеңіз, иә?
Dialogue: 0,1:04:33.02,1:04:37.52,Default,,0,0,0,,Дегенмен, бұл сыра. Мен уыты төмен сыраны немесе басқа нәрсені қабылдамаймын.
Dialogue: 0,1:04:37.52,1:04:40.76,Default,,0,0,0,,Ал... Тонегава мырза
Dialogue: 0,1:04:40.76,1:04:44.49,Default,,0,0,0,,Тез жүр!
Dialogue: 0,1:04:44.49,1:04:48.63,Default,,0,0,0,,Іске қосу Қара киімдердің сенімін қайтаруға бағытталған
Dialogue: 0,1:04:48.63,1:04:52.04,Default,,0,0,0,,Жандану барбекюі
Dialogue: 0,1:04:52.04,1:04:56.34,Default,,0,0,0,,Бірақ бір ғана адам Тонегаваға ашулы
Dialogue: 0,1:04:56.34,1:05:00.61,Default,,0,0,0,,Ямадзаки, әлі суымаған адам
Dialogue: 0,1:05:00.61,1:05:02.81,Default,,0,0,0,,Екінші жартысында жалғасы
Dialogue: 0,1:05:04.98,1:05:09.65,Default,,0,0,0,,Ол сіздің денеңізге сіңеді!
Dialogue: 0,1:05:09.65,1:05:11.65,Default,,0,0,0,,Бай табиғат
Dialogue: 0,1:05:11.65,1:05:15.69,Default,,0,0,0,,Күпірлік еткендей құмарлықтың құйын.
Dialogue: 0,1:05:15.69,1:05:20.43,Default,,0,0,0,,Ет Спирт Спирт және Ет!
Dialogue: 0,1:05:20.43,1:05:24.43,Default,,0,0,0,,Тонегава үлгісіндегі банкет басталады
Dialogue: 0,1:05:26.77,1:05:29.87,Default,,0,0,0,,Уау, қақаған аяз.
Dialogue: 0,1:05:29.87,1:05:32.94,Default,,0,0,0,,Профессор Тонегава, мен бұл партаны қайда қоюым керек?
Dialogue: 0,1:05:32.94,1:05:36.31,Default,,0,0,0,,А, сен мені осының қасына тұрғыза аласың ба?
Dialogue: 0,1:05:36.31,1:05:38.35,Default,,0,0,0,,Ха, Тонегава мырза
Dialogue: 0,1:05:38.35,1:05:40.35,Default,,0,0,0,,А? Бұл газет ше?
Dialogue: 0,1:05:40.35,1:05:42.99,Default,,0,0,0,,А, мен оны ұшқынға айналдырамын, сондықтан оны қатты бұраңыз.
Dialogue: 0,1:05:42.99,1:05:46.52,Default,,0,0,0,,Мені бірден көмірдің арасына сала аласыз ба?
Dialogue: 0,1:05:46.52,1:05:49.23,Default,,0,0,0,,Мұғалім, мен су тартуға бардым.
Dialogue: 0,1:05:49.23,1:05:52.20,Default,,0,0,0,,О, оны сол жерде қалдырыңыз.
Dialogue: 0,1:05:52.20,1:05:55.06,Default,,0,0,0,,Өрмектей өрілген тағдырлар
Dialogue: 0,1:05:55.06,1:05:58.90,Default,,0,0,0,,Жарайсыңдар ма?
Dialogue: 0,1:05:58.90,1:06:01.90,Default,,0,0,0,,Ет пен ішімдік үшін мені оңай кешіресің бе?
Dialogue: 0,1:06:01.90,1:06:03.91,Default,,0,0,0,,Бұрынғы негізсіз
Dialogue: 0,1:06:03.91,1:06:07.51,Default,,0,0,0,,Ямадзаки Кешіріңіз, бірақ бос уақытым болса.
Dialogue: 0,1:06:07.51,1:06:10.25,Default,,0,0,0,,Маған пешке арналған тор әкеліп бере аласыз ба?
Dialogue: 0,1:06:10.25,1:06:13.72,Default,,0,0,0,,А, дәл қазір.
Dialogue: 0,1:06:13.72,1:06:18.35,Default,,0,0,0,,Хе, қарашы, не айтсаң да, нұсқау беріп бітесің.
Dialogue: 0,1:06:18.35,1:06:20.75,Default,,0,0,0,,Еңбек құны дегеніміз не?
Dialogue: 0,1:06:23.33,1:06:26.60,Default,,0,0,0,,Цк, бұл ма?
Dialogue: 0,1:06:26.60,1:06:28.70,Default,,0,0,0,,Әй?
Dialogue: 0,1:06:34.44,1:06:37.64,Default,,0,0,0,,Жарайды, жылу жақсы температураға жетті.
Dialogue: 0,1:06:37.64,1:06:40.84,Default,,0,0,0,,Міне, профессор Тонегава.
Dialogue: 0,1:06:40.84,1:06:44.38,Default,,0,0,0,,Кешіріңіз Ямазаки, оны осында қойыңыз.
Dialogue: 0,1:06:44.38,1:06:46.55,Default,,0,0,0,,Бұл... а?
Dialogue: 0,1:06:46.55,1:06:49.69,Default,,0,0,0,,Ямадзаки мырза, асығыңыз.
Dialogue: 0,1:06:49.69,1:06:54.96,Default,,0,0,0,,Мына темір табақ тот басқан.
Dialogue: 0,1:06:54.96,1:06:57.16,Default,,0,0,0,,Осы сияқты Wow
Dialogue: 0,1:06:59.36,1:07:02.37,Default,,0,0,0,,А, а... бәрі?
Dialogue: 0,1:07:02.37,1:07:05.80,Default,,0,0,0,,Осыған қарамастан, бұл екі карта бұрынғысынша жақсырақ.
Dialogue: 0,1:07:05.80,1:07:08.10,Default,,0,0,0,,Басқалары көбірек тозған
Dialogue: 0,1:07:10.71,1:07:14.54,Default,,0,0,0,,Осы кезде бізде бас тартудан басқа амал жоқ.
Dialogue: 0,1:07:14.54,1:07:17.45,Default,,0,0,0,,Барбекю Уф
Dialogue: 0,1:07:17.45,1:07:19.88,Default,,0,0,0,,Ах...
Dialogue: 0,1:07:19.88,1:07:22.25,Default,,0,0,0,,Оу? Оооох!
Dialogue: 0,1:07:22.25,1:07:27.12,Default,,0,0,0,,Темір табақ болмаса, бұл ет жай суретті торт болар еді
Dialogue: 0,1:07:27.12,1:07:29.93,Default,,0,0,0,,Қол астындағылардың үмітін барынша қоздырыңыз
Dialogue: 0,1:07:29.93,1:07:34.16,Default,,0,0,0,,Етті гриль жасау уақыты келгенде темір табақ тот басып, мүмкін болмай қалды.
Dialogue: 0,1:07:34.16,1:07:38.77,Default,,0,0,0,,Бұл көңілсіздікке, көңілсіздікке, шиеленіске және әлсіреуге әкеледі.
Dialogue: 0,1:07:38.77,1:07:42.67,Default,,0,0,0,,Әркімнің сенімі мен танымалдылығын қайтару мүмкін емес
Dialogue: 0,1:07:49.68,1:07:51.71,Default,,0,0,0,,Уау
Dialogue: 0,1:07:51.71,1:07:54.72,Default,,0,0,0,,Бізге Токио ұнайды! (Фушигуро) Ә?
Dialogue: 0,1:07:54.72,1:07:57.72,Default,,0,0,0,,Уау
Dialogue: 0,1:08:02.53,1:08:06.73,Default,,0,0,0,,Қарғыс атсын Сабуро Ямадзаки
Dialogue: 0,1:08:06.73,1:08:08.83,Default,,0,0,0,,Ха, отты қарашы
Dialogue: 0,1:08:08.83,1:08:11.37,Default,,0,0,0,,Бүркіт орнына адам іздейді
Dialogue: 0,1:08:11.37,1:08:13.70,Default,,0,0,0,,Қандай нұсқалар бар?
Dialogue: 0,1:08:13.70,1:08:16.01,Default,,0,0,0,,Саана
Dialogue: 0,1:08:16.01,1:08:18.51,Default,,0,0,0,,Я, мен оны таба алмаймын.
Dialogue: 0,1:08:18.51,1:08:22.41,Default,,0,0,0,,Міне, бұл ыңғайлы.
Dialogue: 0,1:08:26.32,1:08:31.02,Default,,0,0,0,,Ямадзаки мырза, көмірді көбірек қосу керек пе?
Dialogue: 0,1:08:31.02,1:08:34.99,Default,,0,0,0,,Менің ойымша, бұл енді қажет емес, солай ма?
Dialogue: 0,1:08:34.99,1:08:40.30,Default,,0,0,0,,Уф, мен Коби сиырын жей алмаймын.
Dialogue: 0,1:08:40.30,1:08:43.30,Default,,0,0,0,,Әрине, бұл біраз көңіл көншітеді.
Dialogue: 0,1:08:43.30,1:08:46.60,Default,,0,0,0,,Неліктен мына Кобе сиырын жеуге болмайды
Dialogue: 0,1:08:46.60,1:08:48.74,Default,,0,0,0,,Бірақ бұған көмектесу мүмкін емес.
Dialogue: 0,1:08:48.74,1:08:51.54,Default,,0,0,0,,Өзіндік себеп-салдар
Dialogue: 0,1:08:51.54,1:08:54.61,Default,,0,0,0,,Аа, Тонегава мырза!
Dialogue: 0,1:08:54.61,1:08:57.61,Default,,0,0,0,,...
Dialogue: 0,1:08:57.61,1:08:59.71,Default,,0,0,0,,Уф
Dialogue: 0,1:09:02.92,1:09:05.52,Default,,0,0,0,,Хехехехе
Dialogue: 0,1:09:05.52,1:09:10.36,Default,,0,0,0,,Дүние мүлдем белгісіз.
Dialogue: 0,1:09:10.36,1:09:13.56,Default,,0,0,0,,А... бірдеңе.
Dialogue: 0,1:09:13.56,1:09:17.06,Default,,0,0,0,,Іздесең бәрі мүмкін
Dialogue: 0,1:09:22.37,1:09:24.74,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:09:24.74,1:09:26.84,Default,,0,0,0,,Хехе, білмеймін.
Dialogue: 0,1:09:26.84,1:09:32.05,Default,,0,0,0,,Мен білмеймін, бірақ қалай қарасаңыз да, бұл өте үлкен якинику табақ.
Dialogue: 0,1:09:32.05,1:09:35.59,Default,,0,0,0,,Бұл жаңалық, о
Dialogue: 0,1:09:35.59,1:09:38.09,Default,,0,0,0,,Мен оны сол қоймадан таптым.
Dialogue: 0,1:09:38.09,1:09:40.89,Default,,0,0,0,,Күтілгендей, профессор Тонегава, күткендей.
Dialogue: 0,1:09:40.89,1:09:43.03,Default,,0,0,0,,Күткендей!
Dialogue: 0,1:09:43.03,1:09:45.63,Default,,0,0,0,,Үлкен өлшемді Якинику табақшасы?
Dialogue: 0,1:09:47.73,1:09:51.37,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,1:09:51.37,1:09:53.37,Default,,0,0,0,,Бұлардың ішінде жалғыз мен ғанамын
Dialogue: 0,1:09:53.37,1:09:57.81,Default,,0,0,0,,Мен бір кездері Хиодо төрағасының қарамағында қара киім кигенмін.
Dialogue: 0,1:09:57.81,1:10:02.21,Default,,0,0,0,,Төраға сол кезде сұраған арнайы бұйрық тармағы.
Dialogue: 0,1:10:02.21,1:10:05.72,Default,,0,0,0,,Догезаға арналған темір табақ
Dialogue: 0,1:10:05.72,1:10:09.05,Default,,0,0,0,,Мен нақты нәрсені көрмей тұрып, мені ауыстырды.
Dialogue: 0,1:10:09.05,1:10:13.05,Default,,0,0,0,,Мен нақты айта алмаймын, бірақ бұл үлкен...
Dialogue: 0,1:10:25.94,1:10:28.47,Default,,0,0,0,,Мұғалім, бұл мені жылытады.
Dialogue: 0,1:10:28.47,1:10:33.41,Default,,0,0,0,,Жарайды, кеттік. Есте қаларлық жаңа табақтың бірінші лақтырылуы.
Dialogue: 0,1:10:33.41,1:10:37.18,Default,,0,0,0,,Менен иә
Dialogue: 0,1:10:37.18,1:10:39.32,Default,,0,0,0,,Уау, келіңдер.
Dialogue: 0,1:10:39.32,1:10:42.92,Default,,0,0,0,,Балалар, сендер де бара беріңдер, еркін жүріңдер.
Dialogue: 0,1:10:46.46,1:10:51.49,Default,,0,0,0,,...
Dialogue: 0,1:10:51.49,1:10:55.97,Default,,0,0,0,,Бір қызығы, бұл шын мәнінде үлкен өлшемді якинику пластинасы болуы мүмкін.
Dialogue: 0,1:10:55.97,1:10:58.47,Default,,0,0,0,,Жарайды, кешіріңіз, 2-3 адам.
Dialogue: 0,1:10:58.47,1:11:00.94,Default,,0,0,0,,Менің артымнан қоймаға дейін бара аласыз ба?
Dialogue: 0,1:11:00.94,1:11:05.14,Default,,0,0,0,,Ал, мен аздап қызықты нәрсе таптым.
Dialogue: 0,1:11:12.62,1:11:15.42,Default,,0,0,0,,Енді ше?
Dialogue: 0,1:11:18.39,1:11:21.89,Default,,0,0,0,,Жолдан кет, дәл сол жерде.
Dialogue: 0,1:11:29.87,1:11:33.30,Default,,0,0,0,,Уф! Мүмкін солай шығар?
Dialogue: 0,1:11:33.30,1:11:37.07,Default,,0,0,0,,Профессор Тонегава, бұл не үшін қолданылады?
Dialogue: 0,1:11:37.07,1:11:41.18,Default,,0,0,0,,Хахаха, анау орамжапырақ пен пышақты сол жерден ал.
Dialogue: 0,1:11:41.18,1:11:45.05,Default,,0,0,0,,Га
Dialogue: 0,1:11:45.05,1:11:47.25,Default,,0,0,0,,Өтінемін, өтінемін.
Dialogue: 0,1:11:49.42,1:11:52.05,Default,,0,0,0,,Хмф
Dialogue: 0,1:11:52.05,1:11:54.42,Default,,0,0,0,,Жарайды хехехе
Dialogue: 0,1:11:54.42,1:11:58.03,Default,,0,0,0,,Енді бәріміз мұқият қарайық.
Dialogue: 0,1:11:58.03,1:12:01.60,Default,,0,0,0,,Ой
Dialogue: 0,1:12:01.60,1:12:04.97,Default,,0,0,0,,Даа!
Dialogue: 0,1:12:04.97,1:12:06.97,Default,,0,0,0,,Уа, функционалды
Dialogue: 0,1:12:06.97,1:12:11.27,Default,,0,0,0,,Мен бір түртуді көремін
Dialogue: 0,1:12:11.27,1:12:14.81,Default,,0,0,0,,Мұғалім, бұл жер крестке ұқсайды.
Dialogue: 0,1:12:14.81,1:12:16.81,Default,,0,0,0,,Оның қандай да бір мағынасы бар ма?
Dialogue: 0,1:12:16.81,1:12:19.35,Default,,0,0,0,,Сонымен... міне, солай.
Dialogue: 0,1:12:19.35,1:12:22.69,Default,,0,0,0,,Бұл қысқыш. О, ыңғайлы.
Dialogue: 0,1:12:22.69,1:12:25.02,Default,,0,0,0,,Жоқ! Яғни
Dialogue: 0,1:12:25.02,1:12:28.79,Default,,0,0,0,,Догеза күш машинасы
Dialogue: 0,1:12:28.79,1:12:32.83,Default,,0,0,0,,Әйтпесе, бұл белдікті түсіндіру мүмкін емес.
Dialogue: 0,1:12:32.83,1:12:36.23,Default,,0,0,0,,Қарғыс атқыр, мына темір табақ мысалдағыдай.
Dialogue: 0,1:12:36.23,1:12:39.60,Default,,0,0,0,,Дәмді! Коби сиыр етінен күткендей
Dialogue: 0,1:12:39.60,1:12:42.77,Default,,0,0,0,,Керемет Керемет Керемет Керемет Өте жақсы!
Dialogue: 0,1:12:42.77,1:12:47.71,Default,,0,0,0,,Фуфуфу Шамадан тыс от күші Керемет гриль жасау
Dialogue: 0,1:12:47.71,1:12:52.35,Default,,0,0,0,,Бұл темір табақпен кездесу шынымен аян болды.
Dialogue: 0,1:12:52.35,1:12:55.15,Default,,0,0,0,,Ұстаз, мен көбірек пісірсем қарсы боласыз ба?
Dialogue: 0,1:12:55.15,1:12:58.09,Default,,0,0,0,,Әй, жанжан, жүр, ха!
Dialogue: 0,1:12:58.09,1:13:02.06,Default,,0,0,0,,Мен оны қазір айта алмаймын.
Dialogue: 0,1:13:02.06,1:13:04.26,Default,,0,0,0,,Ха Ямазаки
Dialogue: 0,1:13:08.33,1:13:14.07,Default,,0,0,0,,Мм... Өткен күні кешіріңіз.
Dialogue: 0,1:13:14.07,1:13:18.07,Default,,0,0,0,,Бұл менің кешірім сұрауымның белгісі. Өтінемін кетіңіз.
Dialogue: 0,1:13:23.31,1:13:26.38,Default,,0,0,0,,Енді не болып жатыр?
Dialogue: 0,1:13:26.38,1:13:28.38,Default,,0,0,0,,және өзімнің ашуымнан адасуда болдым.
Dialogue: 0,1:13:45.87,1:13:48.50,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,1:13:48.50,1:13:51.94,Default,,0,0,0,,Дәмді екен...хехе
Dialogue: 0,1:13:51.94,1:13:55.58,Default,,0,0,0,,Осылайша, Ямадзакидің ойына қайшы,
Dialogue: 0,1:13:55.58,1:13:58.15,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:13:58.15,1:14:02.85,Default,,0,0,0,,Үлкен жетістік! Абырой мен стигма қайта оралды
Dialogue: 0,1:14:05.05,1:14:09.69,Default,,0,0,0,,Тонегава, қайсар рухпен, шыңыраудың тереңінен көтеріледі
Dialogue: 0,1:14:09.69,1:14:12.23,Default,,0,0,0,,Ғажайып тірі қалу
Dialogue: 0,1:14:12.23,1:14:18.93,Default,,0,0,0,,Тонегава командасы үшінші кездесудің алдында бірікті
Dialogue: 0,1:14:18.93,1:14:22.77,Default,,0,0,0,,Бірлігімізді одан әрі нығайту
Dialogue: 0,1:14:22.77,1:14:25.27,Default,,0,0,0,,Ойын-сауық Ойын-сауық
Dialogue: 0,1:14:25.27,1:14:30.28,Default,,0,0,0,,Ойын-сауық құрамы
Dialogue: 0,1:14:30.28,1:14:34.28,Default,,0,0,0,,Соңғы қорытынды, әрине
Dialogue: 0,1:14:34.28,1:14:36.48,Default,,0,0,0,,Боулинг
Dialogue: 0,1:14:45.76,1:14:49.30,Default,,0,0,0,,Иә, барлығыңыз күліңіздер.
Dialogue: 0,1:14:49.30,1:14:52.97,Default,,0,0,0,,Әсіресе ортасында
Dialogue: 0,1:14:52.97,1:14:57.97,Default,,0,0,0,,Хаха, маған табиғи күлкі сыйлашы.
Dialogue: 0,1:14:57.97,1:15:00.71,Default,,0,0,0,,Иә, дәл солай.
Dialogue: 0,1:15:00.71,1:15:03.68,Default,,0,0,0,,Суретке түсіру
Dialogue: 0,1:15:03.68,1:15:10.15,Default,,0,0,0,,Бұл бастық, төраға және оның қарамағындағылар арасындағы қара киім.
Dialogue: 0,1:15:10.15,1:15:14.96,Default,,0,0,0,,Күрес Бұл бір адамның әңгімесі.
Dialogue: 0,1:15:14.96,1:15:19.46,Default,,0,0,0,,Юкио Тонегава ортаңғы менеджері
Dialogue: 0,1:16:54.12,1:16:56.62,Default,,0,0,0,,Келесі жолы «Ересектер»
Dialogue: 0,1:19:47.13,1:19:50.03,Default,,0,0,0,,Төраға Хиодо жеке
Dialogue: 0,1:19:50.03,1:19:55.54,Default,,0,0,0,,Тонегаваға өлімнің шайтандық ойынын жоспарлау бұйырылды.
Dialogue: 0,1:19:55.54,1:20:00.98,Default,,0,0,0,,Қайталанатын өрескел қателіктерден қол астындағылардың сенімі жойылғалы тұр.
Dialogue: 0,1:20:00.98,1:20:04.55,Default,,0,0,0,,Ар-намысты қалпына келтіру үшін қайта туылу әрекеті
Dialogue: 0,1:20:04.55,1:20:08.12,Default,,0,0,0,,Бағыныңқылармен бірге жырықтан аттап өту
Dialogue: 0,1:20:08.12,1:20:11.62,Default,,0,0,0,,Ұйымдастырылған компания саяхаты
Dialogue: 0,1:20:11.62,1:20:16.42,Default,,0,0,0,,Бұл үлкен жетістік болды!
Dialogue: 0,1:20:20.16,1:20:23.47,Default,,0,0,0,,Тонегаваның сенімін қалпына келтіру
Dialogue: 0,1:20:23.47,1:20:26.10,Default,,0,0,0,,Шынымен Феникс
Dialogue: 0,1:20:26.10,1:20:28.14,Default,,0,0,0,,Иә
Dialogue: 0,1:20:28.14,1:20:33.14,Default,,0,0,0,,Бастық биігіне қайта оралды.
Dialogue: 0,1:20:44.59,1:20:47.49,Default,,0,0,0,,Хун
Dialogue: 0,1:20:47.49,1:20:52.76,Default,,0,0,0,,Үстеме жұмыс: Тиімсіз жұмыс істейтіндердің шіркін
Dialogue: 0,1:20:52.76,1:20:57.00,Default,,0,0,0,,Компанияда жұмыс істеу сіздің жұмысыңызды алға жылжытады деген дұрыс емес.
Dialogue: 0,1:20:57.00,1:21:00.14,Default,,0,0,0,,Күтілгендей, менің командамда артық жұмыс істейтін адамдар бар.
Dialogue: 0,1:21:00.14,1:21:02.14,Default,,0,0,0,,Ол жоқ сияқты көрінді.
Dialogue: 0,1:21:02.14,1:21:06.17,Default,,0,0,0,,Менің командамның бағыныштылары...
Dialogue: 0,1:21:06.17,1:21:10.08,Default,,0,0,0,,Нуо ах Сенсей Тонегава
Dialogue: 0,1:21:10.08,1:21:12.41,Default,,0,0,0,,Үйдесің бе? О
Dialogue: 0,1:21:12.41,1:21:15.65,Default,,0,0,0,,Сіз әлі үйге бармайсыз ба?
Dialogue: 0,1:21:15.65,1:21:19.15,Default,,0,0,0,,Иә, мен артық жұмыс істедім. Ерен еңбегіңіз үшін рахмет.
Dialogue: 0,1:21:22.02,1:21:24.02,Default,,0,0,0,,Цк
Dialogue: 0,1:21:27.30,1:21:32.83,Default,,0,0,0,,Осы қарқынмен ертеңгі жиналыста одан көп нәрсе күте алмаймын.
Dialogue: 0,1:21:32.83,1:21:37.41,Default,,0,0,0,,Тонегава Бүгін де қосымша уақыт жоқ
Dialogue: 0,1:21:37.41,1:21:40.14,Default,,0,0,0,,"Ол жағдайды өз әдісімен шешуге тырысты."
Dialogue: 0,1:21:40.14,1:21:42.14,Default,,0,0,0,,Мен телефонымды ұмытып қалдым
Dialogue: 0,1:21:45.85,1:21:52.22,Default,,0,0,0,,Teiai Group алып компаниясының №2 Юкио Тонегава
Dialogue: 0,1:21:52.22,1:21:58.52,Default,,0,0,0,,Саяси және іскерлік әлемде үстемдік ететін құбыжық, Хиодо Төрағаның оң қолы болған ашулы адам.
Dialogue: 0,1:22:00.50,1:22:03.63,Default,,0,0,0,,Бұл оның аңызының және даңқының астарында жатыр
Dialogue: 0,1:22:03.63,1:22:08.57,Default,,0,0,0,,Мен орта буын менеджері ретінде жасырын түрде қиналып, күресемін.
Dialogue: 0,1:22:08.57,1:22:15.57,Default,,0,0,0,,Ұлы адамның шағын, шағын әңгімесі.
Dialogue: 0,1:23:53.64,1:23:58.31,Default,,0,0,0,,Бұлай болса, басқа адамдар да шыға ма?
Dialogue: 0,1:23:58.31,1:24:01.25,Default,,0,0,0,,Серпінді идея
Dialogue: 0,1:24:01.25,1:24:05.45,Default,,0,0,0,,Егер келмесең, жиналыс қайтадан өтеді.
Dialogue: 0,1:24:08.39,1:24:11.19,Default,,0,0,0,,Вокзалдың алдына тоқтаңыз, а?
Dialogue: 0,1:24:17.60,1:24:20.77,Default,,0,0,0,,Мен өзімді ойлауым керек
Dialogue: 0,1:24:20.77,1:24:24.97,Default,,0,0,0,,Осы толып жатқан тобырда бір меңзеу болуы мүмкін.
Dialogue: 0,1:24:37.15,1:24:39.39,Default,,0,0,0,,Эй, оларды дұрыстап сапқа тұрғыз, Иә?
Dialogue: 0,1:24:39.39,1:24:41.79,Default,,0,0,0,,О? Бұл не, адам?
Dialogue: 0,1:24:41.79,1:24:43.86,Default,,0,0,0,,Менеджерге не айтуым керек?
Dialogue: 0,1:24:43.86,1:24:48.06,Default,,0,0,0,,Ештеңе етпейді, хабар берме, ол тек жолға түседі.
Dialogue: 0,1:24:48.06,1:24:50.47,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Сіз басқа нәрсеге уәде бердіңіз.
Dialogue: 0,1:24:50.47,1:24:53.03,Default,,0,0,0,,Бұл мені қатты тітіркендіреді.
Dialogue: 0,1:24:53.03,1:24:55.64,Default,,0,0,0,,Бір қарағанда реттелген қатар
Dialogue: 0,1:24:55.64,1:25:00.04,Default,,0,0,0,,Оның ішінде жеке адамдардың жұмысы мен шынайы сезімдері де ұшқыр.
Dialogue: 0,1:25:00.04,1:25:03.38,Default,,0,0,0,,Ойланып қарасаң біртүрлі көрініс
Dialogue: 0,1:25:03.38,1:25:06.35,Default,,0,0,0,,Жақында 5-платформаға пойыз келеді.
Dialogue: 0,1:25:06.35,1:25:10.09,Default,,0,0,0,,Бұл қауіпті, сондықтан сары жолдың ішінде болыңыз.
Dialogue: 0,1:25:10.09,1:25:13.29,Default,,0,0,0,,Бұл да адам қоғамының микрокосмасы
Dialogue: 0,1:25:17.33,1:25:20.46,Default,,0,0,0,,Ой, Аян!
Dialogue: 0,1:25:20.46,1:25:23.73,Default,,0,0,0,,Найзағай сияқты жарық сәті
Dialogue: 0,1:25:23.73,1:25:26.13,Default,,0,0,0,,Қазір бірдеңе...
Dialogue: 0,1:25:37.25,1:25:40.28,Default,,0,0,0,,Маған бірдеңе жауып тұрғаны анық.
Dialogue: 0,1:25:40.28,1:25:43.72,Default,,0,0,0,,Жалпы: Бұл понзу соусымен бе? Эй, понзу соусымен
Dialogue: 0,1:25:43.72,1:25:45.89,Default,,0,0,0,,Пон? Сонымен мұнда
Dialogue: 0,1:25:45.89,1:25:49.32,Default,,0,0,0,,Қанша айтсаң да, пайдасы жоқ. Дәлел дәлелден гөрі жақсырақ.
Dialogue: 0,1:25:49.32,1:25:52.23,Default,,0,0,0,,Рон! Мен мұны сұраған жоқпын
Dialogue: 0,1:25:52.23,1:25:54.83,Default,,0,0,0,,Бұл Отоши!
Dialogue: 0,1:25:56.90,1:25:59.53,Default,,0,0,0,,Күйеуім, тамақ ішпейсің бе?
Dialogue: 0,1:25:59.53,1:26:01.94,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:26:01.94,1:26:04.04,Default,,0,0,0,,Уау
Dialogue: 0,1:26:06.98,1:26:11.31,Default,,0,0,0,,Шабыт қараңғылыққа түседі
Dialogue: 0,1:26:11.31,1:26:15.71,Default,,0,0,0,,Ашық серпіліс!
Dialogue: 0,1:26:20.69,1:26:24.96,Default,,0,0,0,,Хехехе, қария, бұл агари.
Dialogue: 0,1:26:24.96,1:26:27.43,Default,,0,0,0,,Не? Сіз алкогольге дайынсыз ба?
Dialogue: 0,1:26:27.43,1:26:29.86,Default,,0,0,0,,А, енді бұл агари.
Dialogue: 0,1:26:29.86,1:26:32.63,Default,,0,0,0,,Иә, Агари, әкел.
Dialogue: 0,1:26:32.63,1:26:38.24,Default,,0,0,0,,Мен мұнда өзім секіруім керек пе?
Dialogue: 0,1:26:38.24,1:26:41.24,Default,,0,0,0,,Егер сіз алдымен өлемін деп секіріп кірсеңіз,
Dialogue: 0,1:26:41.24,1:26:43.24,Default,,0,0,0,,Сондай-ақ қалқымалы рапидтер де бар.
Dialogue: 0,1:26:50.02,1:26:52.52,Default,,0,0,0,,Уау
Dialogue: 0,1:26:58.56,1:27:01.43,Default,,0,0,0,,«Өлсең, құтқарыласың».
Dialogue: 0,1:27:01.43,1:27:06.37,Default,,0,0,0,,Тонегава табылды, өлген кезде тірі
Dialogue: 0,1:27:06.37,1:27:09.07,Default,,0,0,0,,Тіркелмеген Арнайы Сынып па?
Dialogue: 0,1:27:11.04,1:27:14.51,Default,,0,0,0,,Ал келесі күні
Dialogue: 0,1:27:14.51,1:27:19.05,Default,,0,0,0,,Үшінші мәжіліс залы үш дәрежелі
Dialogue: 0,1:27:19.05,1:27:22.88,Default,,0,0,0,,Аа, мен бүгін сендерден сұрағымды жалғастырамын.
Dialogue: 0,1:27:22.88,1:27:28.52,Default,,0,0,0,,Төраға Хиодоның көңілін көтеретін жаңашыл идеяларды ұсынғаныңызды қалаймын.
Dialogue: 0,1:27:28.52,1:27:31.02,Default,,0,0,0,,Мен мұны айтқым келеді
Dialogue: 0,1:27:33.19,1:27:37.39,Default,,0,0,0,,Бүркіт кеше түнде түсті
Dialogue: 0,1:27:39.90,1:27:42.37,Default,,0,0,0,,Аян
Dialogue: 0,1:27:42.37,1:27:45.37,Default,,0,0,0,,Керемет шабыт
Dialogue: 0,1:27:45.37,1:27:49.41,Default,,0,0,0,,Менің бір ойым бар...
Dialogue: 0,1:27:49.41,1:27:51.41,Default,,0,0,0,,Оны га-ға салыңыз
Dialogue: 0,1:27:55.92,1:28:00.92,Default,,0,0,0,,Хехе, мен оны асығыс жасадым, сондықтан оны жасау сәл арзан.
Dialogue: 0,1:28:00.92,1:28:03.09,Default,,0,0,0,,Бұл сүйкімді
Dialogue: 0,1:28:03.09,1:28:07.63,Default,,0,0,0,,Мен ойлап тапқан шайтандық ойынның мәні осында.
Dialogue: 0,1:28:07.63,1:28:10.00,Default,,0,0,0,,Ах...хехехе
Dialogue: 0,1:28:10.00,1:28:12.10,Default,,0,0,0,,Эй, ха!
Dialogue: 0,1:28:15.47,1:28:17.87,Default,,0,0,0,,Иә
Dialogue: 0,1:28:17.87,1:28:19.87,Default,,0,0,0,,Иә? Атау тегі?
Dialogue: 0,1:28:23.48,1:28:26.31,Default,,0,0,0,,Ештеңе ойлай алмайсыз ба? ештеңе
Dialogue: 0,1:28:26.31,1:28:30.42,Default,,0,0,0,,Хигаши мырза? Бәрі осы ма?
Dialogue: 0,1:28:30.42,1:28:33.66,Default,,0,0,0,,Шығыс
Dialogue: 0,1:28:33.66,1:28:35.79,Default,,0,0,0,,Эх хехехе
Dialogue: 0,1:28:35.79,1:28:40.10,Default,,0,0,0,,Осы уақытқа дейін тек бір адам ғана игерді.
Dialogue: 0,1:28:40.10,1:28:42.10,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:28:45.53,1:28:49.43,Default,,0,0,0,,Көп презентациядан бастау
Dialogue: 0,1:28:52.14,1:28:56.34,Default,,0,0,0,,Адам... Маджонг
Dialogue: 0,1:28:56.34,1:29:01.05,Default,,0,0,0,,Хехехе, көп борышкерлердің қоқысын тақтайшаға теңеген.
Dialogue: 0,1:29:01.05,1:29:03.55,Default,,0,0,0,,Шамадан тыс шкала
Dialogue: 0,1:29:03.55,1:29:06.59,Default,,0,0,0,,Адамдық маджонг!
Dialogue: 0,1:29:06.59,1:29:09.59,Default,,0,0,0,,Адамдық маджонг
Dialogue: 0,1:29:09.59,1:29:13.13,Default,,0,0,0,,Тонегава ұсынған шайтандық ойын
Dialogue: 0,1:29:13.13,1:29:17.77,Default,,0,0,0,,Адамдық маджонг!
Dialogue: 0,1:29:17.77,1:29:20.47,Default,,0,0,0,,Ережелер кәдімгі маджонг сияқты
Dialogue: 0,1:29:20.47,1:29:25.11,Default,,0,0,0,,Алдымен қатысушыларды 13 адамнан тұратын төрт командаға бөліңіз.
Dialogue: 0,1:29:25.11,1:29:29.14,Default,,0,0,0,,Басқаша айтқанда, маджонгта тақтайшалардың орналасуы
Dialogue: 0,1:29:29.14,1:29:31.41,Default,,0,0,0,,Қолда 13 тақтайша
Dialogue: 0,1:29:31.41,1:29:35.42,Default,,0,0,0,,Қалған борышкерлер ортада бүктеледі
Dialogue: 0,1:29:35.42,1:29:37.72,Default,,0,0,0,,Үйіндіде күту
Dialogue: 0,1:29:37.72,1:29:41.32,Default,,0,0,0,,Иә, бастайық.
Dialogue: 0,1:29:41.32,1:29:47.30,Default,,0,0,0,,Әр топ кезекпен үйіндіден адам тақтайшаларын таңдайды.
Dialogue: 0,1:29:47.30,1:29:49.66,Default,,0,0,0,,Енді маңызды бөлік келді
Dialogue: 0,1:29:49.66,1:29:54.07,Default,,0,0,0,,Қай плитканың басталатынын шешу
Dialogue: 0,1:29:54.07,1:29:56.40,Default,,0,0,0,,Алып тастау жиналысы
Dialogue: 0,1:29:56.40,1:29:58.94,Default,,0,0,0,,Плитка таңдап, өзенге лақтырылды
Dialogue: 0,1:29:58.94,1:30:02.81,Default,,0,0,0,,Яғни борышкер дивиденд ала алмайды.
Dialogue: 0,1:30:02.81,1:30:04.85,Default,,0,0,0,,Табиғи шарасыз
Dialogue: 0,1:30:04.85,1:30:07.32,Default,,0,0,0,,Ақымақ болма, бұл жасырын драма болуы мүмкін.
Dialogue: 0,1:30:07.32,1:30:11.05,Default,,0,0,0,,Қиылмауға тырысу
Dialogue: 0,1:30:11.05,1:30:13.92,Default,,0,0,0,,Мына қарғыс атқан плитканың мәні неде...
Dialogue: 0,1:30:13.92,1:30:17.09,Default,,0,0,0,,Сіз оны ойнамауыңыз керек еді.
Dialogue: 0,1:30:17.09,1:30:20.90,Default,,0,0,0,,Ұжым деген атаудан басқа ештеңе емес, жан-жақтан да сын.
Dialogue: 0,1:30:20.90,1:30:25.50,Default,,0,0,0,,Егер сіздің командаңызда осындай тұлға болуы мүмкін болса
Dialogue: 0,1:30:25.50,1:30:29.34,Default,,0,0,0,,Бұл үш адам бірігіп, дос бола алады.
Dialogue: 0,1:30:29.34,1:30:32.31,Default,,0,0,0,,Жарайды, үшеуміздің тағдырымыз ортақ.
Dialogue: 0,1:30:32.31,1:30:34.81,Default,,0,0,0,,Бөлінбейтін тұлға Иә
Dialogue: 0,1:30:34.81,1:30:39.28,Default,,0,0,0,,Достар Бір адамда үш адам
Dialogue: 0,1:30:39.28,1:30:43.08,Default,,0,0,0,,Бірақ егер...
Dialogue: 0,1:30:46.96,1:30:49.29,Default,,0,0,0,,Уф
Dialogue: 0,1:30:49.29,1:30:52.49,Default,,0,0,0,,Балалар сендер оны қимаймын деп уәде бердіңдер.
Dialogue: 0,1:30:52.49,1:30:55.40,Default,,0,0,0,,Біз доспыз, Таняо.
Dialogue: 0,1:30:55.40,1:30:59.07,Default,,0,0,0,,Е, Таняо
Dialogue: 0,1:30:59.07,1:31:04.34,Default,,0,0,0,,Таняо 19 таңбалы тақтайшаларды қолданбай жасалған қозғалыс
Dialogue: 0,1:31:04.34,1:31:08.18,Default,,0,0,0,,Таняо қосылды Ах, балалар!
Dialogue: 0,1:31:08.18,1:31:11.98,Default,,0,0,0,,Сол түтік Таняоға кедергі!
Dialogue: 0,1:31:11.98,1:31:15.72,Default,,0,0,0,,Адамның инстинкті: Жалаңаш жындық Махжонг
Dialogue: 0,1:31:15.72,1:31:19.42,Default,,0,0,0,,Иә, адамдық маджонг
Dialogue: 0,1:31:19.42,1:31:22.92,Default,,0,0,0,,Маджонг адам ба, әлде адам маджон ба?
Dialogue: 0,1:31:22.92,1:31:25.43,Default,,0,0,0,,Өте керемет
Dialogue: 0,1:31:25.43,1:31:30.70,Default,,0,0,0,,Хехехе, сатқындық, алдау, достарды бөлу
Dialogue: 0,1:31:30.70,1:31:33.07,Default,,0,0,0,,Біреуді тепкілеп, құлату
Dialogue: 0,1:31:33.07,1:31:35.50,Default,,0,0,0,,Олар ұқсас деп ойлайсың ба?
Dialogue: 0,1:31:35.50,1:31:40.51,Default,,0,0,0,,Біздің қоғамға
Dialogue: 0,1:31:40.51,1:31:45.68,Default,,0,0,0,,Хехехе, төраға жақсы көретін шығар.
Dialogue: 0,1:31:45.68,1:31:51.02,Default,,0,0,0,,Дәл солай, шіркін төбелес
Dialogue: 0,1:31:51.02,1:31:54.96,Default,,0,0,0,,кукукуку шынайы шынайы
Dialogue: 0,1:31:54.96,1:31:57.49,Default,,0,0,0,,Бұл адамның табиғаты
Dialogue: 0,1:31:57.49,1:32:00.16,Default,,0,0,0,,Кукукукукуку
Dialogue: 0,1:32:00.16,1:32:03.83,Default,,0,0,0,,Бұл нағыз ойын-сауық, ләззат
Dialogue: 0,1:32:03.83,1:32:07.57,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,1:32:07.57,1:32:10.67,Default,,0,0,0,,Сонымен... тамаша. Соңғы кездесуде.
Dialogue: 0,1:32:10.67,1:32:13.34,Default,,0,0,0,,Барлық туындаған идеяларды жойыңыз
Dialogue: 0,1:32:13.34,1:32:15.34,Default,,0,0,0,,Жолақты көтеру...
Dialogue: 0,1:32:19.08,1:32:23.02,Default,,0,0,0,,Уау! Тонегава мырзаның өзі еңсерді
Dialogue: 0,1:32:23.02,1:32:25.72,Default,,0,0,0,,Бастық ретінде көрсетті
Dialogue: 0,1:32:25.72,1:32:28.16,Default,,0,0,0,,Хмм... Ах.
Dialogue: 0,1:32:28.16,1:32:31.66,Default,,0,0,0,,Сендер жиналасыңдар ма? Қатысушылар өте көп.
Dialogue: 0,1:32:31.66,1:32:34.16,Default,,0,0,0,,Жоқ, бір адам!
Dialogue: 0,1:32:36.06,1:32:38.06,Default,,0,0,0,,Уф
Dialogue: 0,1:32:40.23,1:32:42.23,Default,,0,0,0,,Екі рет басу
Dialogue: 0,1:32:46.01,1:32:48.14,Default,,0,0,0,,Саймон сен ақымақ
Dialogue: 0,1:32:48.14,1:32:50.58,Default,,0,0,0,,Маған бәрібір, соны айт.
Dialogue: 0,1:32:50.58,1:32:56.95,Default,,0,0,0,,Жоқ, бұл 136 маджонг тақтайшасы үшін борышкерлерді жинау туралы.
Dialogue: 0,1:32:56.95,1:32:59.99,Default,,0,0,0,,Мүмкін емес пе?
Dialogue: 0,1:32:59.99,1:33:02.49,Default,,0,0,0,,Уф
Dialogue: 0,1:33:02.49,1:33:07.56,Default,,0,0,0,,Сондай-ақ, маджонг ережелерін білмейтіндер аз емес.
Dialogue: 0,1:33:07.56,1:33:11.06,Default,,0,0,0,,Әділетсіз немесе дұрысы әділетсіз
Dialogue: 0,1:33:13.84,1:33:16.60,Default,,0,0,0,,Ал... Каа, сен қандайсың?
Dialogue: 0,1:33:16.60,1:33:18.84,Default,,0,0,0,,Егер мұндай мәселе болса да...
Dialogue: 0,1:33:18.84,1:33:22.94,Default,,0,0,0,,Тоқтаңыз, Ямадзаки Тонегава мырза.
Dialogue: 0,1:33:22.94,1:33:25.48,Default,,0,0,0,,Саймонның ойы ең маңызды
Dialogue: 0,1:33:25.48,1:33:28.65,Default,,0,0,0,,Бұл дәл белгіде. Бұл дәл. Уф.
Dialogue: 0,1:33:28.65,1:33:33.05,Default,,0,0,0,,Бірақ егер сіз басқалардың пікіріне соншалықты сараң болсаңыз...
Dialogue: 0,1:33:33.05,1:33:37.53,Default,,0,0,0,,Әрине, оны жаңадан көрсету керек.
Dialogue: 0,1:33:37.53,1:33:40.33,Default,,0,0,0,,Баламалар
Dialogue: 0,1:33:40.33,1:33:42.86,Default,,0,0,0,,Бұл да мен көрсеткен мәселе.
Dialogue: 0,1:33:42.86,1:33:45.00,Default,,0,0,0,,Тазартылған сияқты... Иә.
Dialogue: 0,1:33:45.00,1:33:47.20,Default,,0,0,0,,Бар.
Dialogue: 0,1:33:47.20,1:33:49.40,Default,,0,0,0,,Бір ғана
Dialogue: 0,1:33:49.40,1:33:52.87,Default,,0,0,0,,Цк эй шығыс га
Dialogue: 0,1:33:52.87,1:33:56.24,Default,,0,0,0,,Жаңа тақтаны дайында.
Dialogue: 0,1:33:56.24,1:33:58.24,Default,,0,0,0,,Әзірге осы жеткілікті болар.
Dialogue: 0,1:34:03.32,1:34:06.89,Default,,0,0,0,,Иә?
Dialogue: 0,1:34:06.89,1:34:09.56,Default,,0,0,0,,Мен шамдарды сөндіремін.
Dialogue: 0,1:34:09.56,1:34:11.56,Default,,0,0,0,,Иә
Dialogue: 0,1:34:14.46,1:34:16.46,Default,,0,0,0,,Цк
Dialogue: 0,1:34:20.77,1:34:24.14,Default,,0,0,0,,А, ә, сонда.
Dialogue: 0,1:34:24.14,1:34:27.48,Default,,0,0,0,,Мен менмен болсам да, мен Заемон Сабуромын.
Dialogue: 0,1:34:27.48,1:34:31.51,Default,,0,0,0,,Мен революциялық тас-қағаз-қайшы ойыны туралы презентацияны бастағым келеді.
Dialogue: 0,1:34:31.51,1:34:33.51,Default,,0,0,0,,Тас, қағаз, қайшы
Dialogue: 0,1:34:33.51,1:34:37.12,Default,,0,0,0,,Бұл өткен күні айтқан бірінші идеяңыз жойылды емес пе?
Dialogue: 0,1:34:37.12,1:34:41.46,Default,,0,0,0,,Ең алдымен, уф.
Dialogue: 0,1:34:41.46,1:34:45.23,Default,,0,0,0,,Жаңа идеялар қалай пайда болады?
Dialogue: 0,1:34:45.23,1:34:47.23,Default,,0,0,0,,Бұл...
Dialogue: 0,1:34:49.66,1:34:52.10,Default,,0,0,0,,Уау, бар идеялар мен
Dialogue: 0,1:34:52.10,1:34:56.10,Default,,0,0,0,,Бұрыннан бар идеялардың қосылуынан туған дейді.
Dialogue: 0,1:34:56.10,1:34:58.84,Default,,0,0,0,,Сонымен, соны ескере отырып, И
Dialogue: 0,1:34:58.84,1:35:00.98,Default,,0,0,0,,Тас, қағаз, қайшы туралы бар ойға
Dialogue: 0,1:35:00.98,1:35:03.98,Default,,0,0,0,,Сіз қандай идеяларды біріктірдіңіз?
Dialogue: 0,1:35:03.98,1:35:05.98,Default,,0,0,0,,Бұл...
Dialogue: 0,1:35:09.52,1:35:11.75,Default,,0,0,0,,Карточка ойыны
Dialogue: 0,1:35:11.75,1:35:14.92,Default,,0,0,0,,Эй, мен бұны күтпедім...
Dialogue: 0,1:35:14.92,1:35:18.23,Default,,0,0,0,,Жоқ, сөзсіз Powerpoint
Dialogue: 0,1:35:18.23,1:35:22.10,Default,,0,0,0,,Saemon PowerPoint бағдарламасын ашу
Dialogue: 0,1:35:22.10,1:35:25.53,Default,,0,0,0,,Менің ойыма сараң болған осы жігіт еді.
Dialogue: 0,1:35:25.53,1:35:28.74,Default,,0,0,0,,Сіз мұны жариялағыңыз келгендіктен жасадыңыз ба?
Dialogue: 0,1:35:28.74,1:35:31.91,Default,,0,0,0,,Сіз жай ғана өзін көрсеткіңіз келді ме?
Dialogue: 0,1:35:31.91,1:35:34.41,Default,,0,0,0,,Иә, ақымақ.
Dialogue: 0,1:35:34.41,1:35:38.45,Default,,0,0,0,,Қанша киінсең де, затың болмаса, жарамайды.
Dialogue: 0,1:35:38.45,1:35:42.32,Default,,0,0,0,,Папье-маше жолбарысы Боялған күріш торты
Dialogue: 0,1:35:42.32,1:35:46.42,Default,,0,0,0,,Тонегава ғана емес, барлығы, соның ішінде басқа қара киімдер.
Dialogue: 0,1:35:46.42,1:35:49.96,Default,,0,0,0,,Команданың ең жас мүшесі Сабуро Саймон карта, тас, қағаз, қайшы ойнайды.
Dialogue: 0,1:35:49.96,1:35:53.23,Default,,0,0,0,,Ешкім үлкен үміт күтпейді
Dialogue: 0,1:35:53.23,1:35:57.00,Default,,0,0,0,,…жылдам бітеді!
Dialogue: 0,1:35:57.00,1:35:59.00,Default,,0,0,0,,12 карточкалар
Dialogue: 0,1:35:59.00,1:36:02.67,Default,,0,0,0,,Әр қатысушыда 4 дана гуо қағазы болады.
Dialogue: 0,1:36:02.67,1:36:05.87,Default,,0,0,0,,Демек, бұл шектеудің мағынасы.
Dialogue: 0,1:36:05.87,1:36:09.38,Default,,0,0,0,,Бұл мәселенің өзегі.
Dialogue: 0,1:36:09.38,1:36:13.28,Default,,0,0,0,,Презентация барысында бірте-бірте анық болады
Dialogue: 0,1:36:13.28,1:36:15.98,Default,,0,0,0,,Оның керемет кемелдігі
Dialogue: 0,1:36:18.09,1:36:22.62,Default,,0,0,0,,Рок-қағаз қайшысын карталарға айналдыру арқылы жасалған ойыншыларға шектеулер
Dialogue: 0,1:36:22.62,1:36:25.89,Default,,0,0,0,,Тас-қағаз-қайшы деп аталатын қарапайым және әділ ойын
Dialogue: 0,1:36:25.89,1:36:29.26,Default,,0,0,0,,Бір қарағанда бұл сәттілік немесе данышпандық ойыны сияқты...
Dialogue: 0,1:36:29.26,1:36:32.40,Default,,0,0,0,,Жоқ, шын мәнінде стратегиялық
Dialogue: 0,1:36:32.40,1:36:34.80,Default,,0,0,0,,Түрлі тактикадан тұрады
Dialogue: 0,1:36:34.80,1:36:38.81,Default,,0,0,0,,Стратегиялық ойынға айналдырылды!
Dialogue: 0,1:36:38.81,1:36:43.41,Default,,0,0,0,,Маджонгтен айырмашылығы, барлығы тас-қағаз-қайшы туралы біледі.
Dialogue: 0,1:36:43.41,1:36:48.35,Default,,0,0,0,,Бірнеше ондаған немесе одан да көп қатысушылар жиналса, орналастыруға болады.
Dialogue: 0,1:36:48.35,1:36:53.62,Default,,0,0,0,,Өте шынайы және жын
Dialogue: 0,1:36:53.62,1:36:58.76,Default,,0,0,0,,Басқаша айтқанда, тапсырыс беруші, Төраға Хиодо,
Dialogue: 0,1:36:58.76,1:37:01.90,Default,,0,0,0,,Өте ризамын!
Dialogue: 0,1:37:01.90,1:37:05.07,Default,,0,0,0,,О... тамаша.
Dialogue: 0,1:37:05.07,1:37:07.10,Default,,0,0,0,,Көп күтпестен
Dialogue: 0,1:37:07.10,1:37:10.57,Default,,0,0,0,,Мен бұл қызықсыз презентация деп ойладым.
Dialogue: 0,1:37:10.57,1:37:13.17,Default,,0,0,0,,Біз көбірек түсіндірмелер қоса береміз
Dialogue: 0,1:37:13.17,1:37:16.78,Default,,0,0,0,,Қолыңыздағы тақтайшалар тез өзгереді
Dialogue: 0,1:37:16.78,1:37:21.55,Default,,0,0,0,,Осы пішіндегі қоқыс қолдары
Dialogue: 0,1:37:21.55,1:37:25.92,Default,,0,0,0,,Тенпай Джунчан Саншики Эпеко
Dialogue: 0,1:37:25.92,1:37:28.89,Default,,0,0,0,,Мен ешқашан кесілмеймін деп ойладым.
Dialogue: 0,1:37:28.89,1:37:31.26,Default,,0,0,0,,Сонымен, Қызыл Айдаһардың Тонегава мырзасы
Dialogue: 0,1:37:31.26,1:37:34.93,Default,,0,0,0,,Бұл пішінге келгенде кедергі болады, иә?
Dialogue: 0,1:37:34.93,1:37:37.33,Default,,0,0,0,,Оны қиюдан басқа амалым жоқ. Эй.
Dialogue: 0,1:37:39.90,1:37:42.44,Default,,0,0,0,,Негізі мұнда барлығы қара киінген
Dialogue: 0,1:37:42.44,1:37:45.81,Default,,0,0,0,,Жоқ, тіпті Азума-сан.
Dialogue: 0,1:37:45.81,1:37:48.71,Default,,0,0,0,,Саймонның ұсынысына негізделген шешімнің көңіл-күйі
Dialogue: 0,1:37:50.85,1:37:55.05,Default,,0,0,0,,Иә, иә.
Dialogue: 0,1:37:55.05,1:37:58.65,Default,,0,0,0,,Мұның бәрі менің презентациям үшін. Рақмет сізге.
Dialogue: 0,1:38:05.23,1:38:08.00,Default,,0,0,0,,Билікті жүзеге асыру
Dialogue: 0,1:38:08.00,1:38:11.40,Default,,0,0,0,,Доктор Тонегава оны өткен жолғыдай күшпен қабылдамады.
Dialogue: 0,1:38:11.40,1:38:14.60,Default,,0,0,0,,Сондай-ақ, сіз өз идеяларыңызды жүзеге асыра аласыз.
Dialogue: 0,1:38:18.44,1:38:20.68,Default,,0,0,0,,Ең кішінің пікірі үшін
Dialogue: 0,1:38:20.68,1:38:23.71,Default,,0,0,0,,Бастықтың өз идеяларынан бас тарту және т.б.
Dialogue: 0,1:38:23.71,1:38:26.11,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,1:38:28.38,1:38:32.19,Default,,0,0,0,,Тонегава Сол жолды қайта басамыз ба?
Dialogue: 0,1:38:32.19,1:38:36.92,Default,,0,0,0,,Егер бәрі бұрынғыдай жалғаса берсе, компания сапарлары қайтадан өткізіледі.
Dialogue: 0,1:38:36.92,1:38:39.46,Default,,0,0,0,,Хехе...
Dialogue: 0,1:38:39.46,1:38:45.17,Default,,0,0,0,,Қоғам шынымен қызықты нәрсе.
Dialogue: 0,1:38:45.17,1:38:48.10,Default,,0,0,0,,Сабуро Саймон Иә
Dialogue: 0,1:38:48.10,1:38:52.37,Default,,0,0,0,,Әр адам үшін көшірмелерді алыңыз.
Dialogue: 0,1:38:52.37,1:38:55.24,Default,,0,0,0,,Карточка, тас, қағаз, қайшы ұсынысы ше?
Dialogue: 0,1:38:55.24,1:38:57.71,Default,,0,0,0,,Қызықты
Dialogue: 0,1:38:57.71,1:39:01.42,Default,,0,0,0,,Мен жұмысқа қабылдандым. Ха, рахмет.
Dialogue: 0,1:39:01.42,1:39:06.55,Default,,0,0,0,,Ал... Доктор Тонегава өз ойын қиып алды.
Dialogue: 0,1:39:06.55,1:39:11.13,Default,,0,0,0,,Карточкадан секіру
Dialogue: 0,1:39:11.13,1:39:15.33,Default,,0,0,0,,Ересек адам шығарған үкім
Dialogue: 0,1:39:15.33,1:39:17.90,Default,,0,0,0,,Ересектер өзіңізді кесіңіз
Dialogue: 0,1:39:17.90,1:39:21.80,Default,,0,0,0,,Бұл ересек бастықтың идеалы
Dialogue: 0,1:39:21.80,1:39:27.24,Default,,0,0,0,,Компанияның бәсекеге қабілетті тозағында туылған жұмақ.
Dialogue: 0,1:39:27.24,1:39:31.68,Default,,0,0,0,,Рахмет Рахмет!
Dialogue: 0,1:39:31.68,1:39:36.45,Default,,0,0,0,,Бірақ бір нәрсе туралы не деуге болады?
Dialogue: 0,1:39:36.45,1:39:38.99,Default,,0,0,0,,Карта Жанкен деген атпен
Dialogue: 0,1:39:38.99,1:39:41.69,Default,,0,0,0,,Бұл бастауыш мектеп ойыны сияқты
Dialogue: 0,1:39:43.69,1:39:46.79,Default,,0,0,0,,Кішкене тығыз
Dialogue: 0,1:39:46.79,1:39:51.37,Default,,0,0,0,,Аа, дұрыс...
Dialogue: 0,1:39:51.37,1:39:54.90,Default,,0,0,0,,Хмм шектеулі
Dialogue: 0,1:39:54.90,1:39:57.81,Default,,0,0,0,,«Шектеулі тас қағаз қайшымен» анықталған!
Dialogue: 0,1:39:57.81,1:40:00.14,Default,,0,0,0,,Ах
Dialogue: 0,1:40:00.14,1:40:04.68,Default,,0,0,0,,Ал... Тонегава мырза күшпен бұрылды
Dialogue: 0,1:40:04.68,1:40:07.55,Default,,0,0,0,,Тек атауы хехехе
Dialogue: 0,1:40:07.55,1:40:11.25,Default,,0,0,0,,Шектеулі тас-қағаз-қайшы жарылысы!
Dialogue: 0,1:40:18.36,1:40:21.86,Default,,0,0,0,,Олай болса, маджонг ойнау арқылы келесі айдың кестесін анықтайық.
Dialogue: 0,1:40:21.86,1:40:26.23,Default,,0,0,0,,Мен маджонгты түсінбеймін, иә? Мен көмектесе алмаймын
Dialogue: 0,1:40:26.23,1:40:29.47,Default,,0,0,0,,Олай болса тас, қағаз, қайшы, мейірімділікпен ойнап шешейік.
Dialogue: 0,1:40:29.47,1:40:31.47,Default,,0,0,0,,Иә
Dialogue: 0,1:40:31.47,1:40:34.04,Default,,0,0,0,,Юкио Тонегава
Dialogue: 0,1:40:34.04,1:40:37.41,Default,,0,0,0,,Teiai тобы №2 адам
Dialogue: 0,1:40:37.41,1:40:43.68,Default,,0,0,0,,Бұл бастық, төраға және оның қарамағындағылар арасындағы қара киім.
Dialogue: 0,1:40:43.68,1:40:48.79,Default,,0,0,0,,Күрес Бұл бір адамның әңгімесі.
Dialogue: 0,1:40:48.79,1:40:54.09,Default,,0,0,0,,Юкио Тонегава ортаңғы менеджері
Dialogue: 0,1:42:29.02,1:42:31.62,Default,,0,0,0,,Келесі жолы «Сейши»
Dialogue: 0,1:45:15.56,1:45:19.39,Default,,0,0,0,,Шайтандық жоспар ақыры аяқталды
Dialogue: 0,1:45:19.39,1:45:22.56,Default,,0,0,0,,«Шектеулі тас қағаз қайшы»
Dialogue: 0,1:45:22.56,1:45:25.16,Default,,0,0,0,,Бұл Тонегава. Кешіріңіз.
Dialogue: 0,1:45:28.77,1:45:31.21,Default,,0,0,0,,Жалқаулық
Dialogue: 0,1:45:31.21,1:45:34.84,Default,,0,0,0,,Жалықтырғыш
Dialogue: 0,1:45:34.84,1:45:36.84,Default,,0,0,0,,Шаршадым
Dialogue: 0,1:45:39.15,1:45:44.65,Default,,0,0,0,,Жаса, бұл жақсы, бұл дос, бұл желіден тыс кездесу.
Dialogue: 0,1:45:44.65,1:45:49.29,Default,,0,0,0,,Жазу, жою, ретвиттеу
Dialogue: 0,1:45:49.29,1:45:54.23,Default,,0,0,0,,Мұның бәрі бос сөз.
Dialogue: 0,1:45:54.23,1:45:59.13,Default,,0,0,0,,Сіз олай ойламайсыз ба? Тон өзені
Dialogue: 0,1:45:59.13,1:46:03.14,Default,,0,0,0,,Иә, дәл солай.
Dialogue: 0,1:46:03.14,1:46:07.27,Default,,0,0,0,,Негізінде, төраға, шайтандық жоспар туралы.
Dialogue: 0,1:46:07.27,1:46:11.81,Default,,0,0,0,,Қазір ұсыныс жіберудің тамаша уақыты
Dialogue: 0,1:46:11.81,1:46:14.78,Default,,0,0,0,,Аяқталған ұсыныс осында...
Dialogue: 0,1:46:14.78,1:46:18.29,Default,,0,0,0,,Бұл фильм. Мен фильм көргім келеді.
Dialogue: 0,1:46:18.29,1:46:22.49,Default,,0,0,0,,Мені қанағаттандыратын фильмдер
Dialogue: 0,1:46:24.59,1:46:29.90,Default,,0,0,0,,Не? Жоқ, Тонегава, мен көнбеймін.
Dialogue: 0,1:46:29.90,1:46:33.53,Default,,0,0,0,,Төраға, сізге кино ұнайды ма?
Dialogue: 0,1:46:33.53,1:46:37.07,Default,,0,0,0,,Каккакка Бұл маған ұнамайды.
Dialogue: 0,1:46:37.07,1:46:41.07,Default,,0,0,0,,Фильмдер негізінен нонсенс.
Dialogue: 0,1:46:41.07,1:46:45.25,Default,,0,0,0,,Бұл уақытты өлтірудің бір жолы, ол жоқтан жақсы.
Dialogue: 0,1:46:45.25,1:46:48.72,Default,,0,0,0,,Мәселе жоқ.
Dialogue: 0,1:46:48.72,1:46:52.69,Default,,0,0,0,,Сирек болса да, белгілі бір дәрежеде көрінеді.
Dialogue: 0,1:46:52.69,1:46:57.12,Default,,0,0,0,,Бұл қыранды қуанта алатын нәрселер аз.
Dialogue: 0,1:46:57.12,1:47:01.23,Default,,0,0,0,,Мысалы, Хичкок немесе Акира Курокава.
Dialogue: 0,1:47:01.23,1:47:04.36,Default,,0,0,0,,Сіз Акира Куросавасыз ба?
Dialogue: 0,1:47:04.36,1:47:08.27,Default,,0,0,0,,Е... гах, екеуі де жақсы. Соған ұқсас нәрсе.
Dialogue: 0,1:47:08.27,1:47:10.27,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,1:47:21.55,1:47:24.95,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,1:47:24.95,1:47:27.09,Default,,0,0,0,,Мен сізге шектеулі тас, қағаз, қайшы ұсынысын көрсетуіңізді сұрадым.
Dialogue: 0,1:47:27.09,1:47:29.86,Default,,0,0,0,,Маған айтатын шығар деп бардым.
Dialogue: 0,1:47:29.86,1:47:33.43,Default,,0,0,0,,Мен білмеймін. Мен Тейайда көптен бері жүрмін.
Dialogue: 0,1:47:33.43,1:47:37.23,Default,,0,0,0,,Тек осы төрағаның қыңырлығы
Dialogue: 0,1:47:37.23,1:47:40.23,Default,,0,0,0,,Бірнеше ондаған минуттар өтті
Dialogue: 0,1:47:45.57,1:47:49.28,Default,,0,0,0,,Бұл ең соңында шарықтау шегі ме?
Dialogue: 0,1:47:49.28,1:47:52.85,Default,,0,0,0,,Ии!
Dialogue: 0,1:47:52.85,1:47:56.02,Default,,0,0,0,,Ұйықтау!
Dialogue: 0,1:47:56.02,1:47:58.92,Default,,0,0,0,,Мен сені оятуым керек пе? Жоқ.
Dialogue: 0,1:47:58.92,1:48:03.09,Default,,0,0,0,,Бірақ мен сені осындай терең ұйқыдан оятсам ше?
Dialogue: 0,1:48:03.09,1:48:06.59,Default,,0,0,0,,Оқиғаның шарықтау шегі бар
Dialogue: 0,1:48:06.59,1:48:10.73,Default,,0,0,0,,Бірақ мен сені оятпасам, мені оятпадың деп айғайлайсың.
Dialogue: 0,1:48:10.73,1:48:13.17,Default,,0,0,0,,Сөзсіз
Dialogue: 0,1:48:13.17,1:48:15.54,Default,,0,0,0,,Мен сені оятсам да, оятпасам да
Dialogue: 0,1:48:15.54,1:48:18.14,Default,,0,0,0,,Тозақтың мәні неде?
Dialogue: 0,1:48:23.51,1:48:26.45,Default,,0,0,0,,Алға жүру – тозақ, шегіну – тозақ.
Dialogue: 0,1:48:26.45,1:48:29.95,Default,,0,0,0,,Шарасыз таңдау
Dialogue: 0,1:48:29.95,1:48:33.29,Default,,0,0,0,,Жоқ, күте тұрыңыз, эй, аа
Dialogue: 0,1:48:33.29,1:48:38.19,Default,,0,0,0,,Төраға оянғанға дейін уақытша тоқтату.
Dialogue: 0,1:48:38.19,1:48:42.00,Default,,0,0,0,,Хехехе, осылай төрағаны оятпаймын және
Dialogue: 0,1:48:42.00,1:48:45.20,Default,,0,0,0,,Климаксты жіберіп алу туралы уайымдаудың қажеті жоқ
Dialogue: 0,1:48:48.27,1:48:51.27,Default,,0,0,0,,Мен мұны шарасыз жағдайда таптым.
Dialogue: 0,1:48:51.27,1:48:53.57,Default,,0,0,0,,Негізсіз ең жақсы әдіс
Dialogue: 0,1:48:58.28,1:49:02.95,Default,,0,0,0,,Хехехе, күте тұрыңыз.
Dialogue: 0,1:49:02.95,1:49:07.85,Default,,0,0,0,,Президент табиғи түрде оянғанда
Dialogue: 0,1:49:07.85,1:49:11.09,Default,,0,0,0,,Және бір сағат
Dialogue: 0,1:49:11.09,1:49:13.89,Default,,0,0,0,,(Төрағаның ұйқы туралы әңгімесі)
Dialogue: 0,1:49:13.89,1:49:16.20,Default,,0,0,0,,Бұл оңайлықпен бола бермейді
Dialogue: 0,1:49:16.20,1:49:18.20,Default,,0,0,0,,Сіз әбден шаршаған болуыңыз керек.
Dialogue: 0,1:49:20.33,1:49:23.27,Default,,0,0,0,,Және тағы 30 минут
Dialogue: 0,1:49:23.27,1:49:26.57,Default,,0,0,0,,Ha
Dialogue: 0,1:49:26.57,1:49:30.51,Default,,0,0,0,,Ахх!
Dialogue: 0,1:49:30.51,1:49:34.28,Default,,0,0,0,,Бүркіттің қасында ұйықтап қалдым.
Dialogue: 0,1:49:34.28,1:49:36.32,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,1:49:36.32,1:49:39.29,Default,,0,0,0,,Оның үстіне, мен ең қызықты шарықтау шегін жіберіп алдым.
Dialogue: 0,1:49:39.29,1:49:42.29,Default,,0,0,0,,Қандай ақымақтық!
Dialogue: 0,1:49:42.29,1:49:44.86,Default,,0,0,0,,Санкциялар! Ой!
Dialogue: 0,1:49:44.86,1:49:48.70,Default,,0,0,0,,Цк, ұйықта! Тонегава Фукаку
Dialogue: 0,1:49:48.70,1:49:54.30,Default,,0,0,0,,Өлімге әкелетін қателік: шектеулі тас, қағаз, қайшы ұсынысын жіберу мүмкін емес
Dialogue: 0,1:49:54.30,1:49:59.10,Default,,0,0,0,,Мен тіпті күнделікті өмірден шаршадым.
Dialogue: 0,1:51:31.80,1:51:37.07,Default,,0,0,0,,Тонегава ұсынысты беру мерзіміне дейін 5 күн қалды
Dialogue: 0,1:51:37.07,1:51:42.31,Default,,0,0,0,,Бұл 5 күн ішінде болуы керек Жобаны жіберу уақыты
Dialogue: 0,1:51:42.31,1:51:45.95,Default,,0,0,0,,Абсолютті мүмкіндік
Dialogue: 0,1:51:45.95,1:51:49.85,Default,,0,0,0,,Тонегава мырза ертең кететін сияқты.
Dialogue: 0,1:51:49.85,1:51:53.12,Default,,0,0,0,,Төраға Гавайиге 10 күнге барады
Dialogue: 0,1:51:53.12,1:51:56.26,Default,,0,0,0,,Не? Ха, Гавайи ше?
Dialogue: 0,1:51:56.26,1:52:00.73,Default,,0,0,0,,Иә, бұл бүгін ұсынысты жіберудің жалғыз уақыты екенін білдіреді.
Dialogue: 0,1:52:00.73,1:52:06.73,Default,,0,0,0,,Жоқ... ақымақ, неге Гавайи бұл уақытта?
Dialogue: 0,1:52:09.50,1:52:13.97,Default,,0,0,0,,Императорлық махаббат Доны Казутака Хиодо Бостандық
Dialogue: 0,1:52:13.97,1:52:17.41,Default,,0,0,0,,Қазір шығарып алайық Дәл қазір шығаруға барсақ...
Dialogue: 0,1:52:17.41,1:52:22.48,Default,,0,0,0,,Жоқ, мен оны бере алмаймын, бірақ бұл өте кездейсоқ дегенді білдірмейді.
Dialogue: 0,1:52:22.48,1:52:25.65,Default,,0,0,0,,Бірақ... хмм, мүмкін.
Dialogue: 0,1:52:25.65,1:52:29.05,Default,,0,0,0,,Төрағаның көңіл-күйі бұзылған кезде бірдеңені тапсырсаң...
Dialogue: 0,1:52:31.12,1:52:33.42,Default,,0,0,0,,Ах! Ах...
Dialogue: 0,1:52:36.30,1:52:41.10,Default,,0,0,0,,Болжамға негізделген жобаны қабылдамау. Мұндай негізсіз үкім.
Dialogue: 0,1:52:41.10,1:52:44.50,Default,,0,0,0,,Егер бұл орын алса, сізде көпіршіктер пайда болады...
Dialogue: 0,1:52:44.50,1:52:48.18,Default,,0,0,0,,Шегі бүгін болғандықтан алуға асықсаңыз да.
Dialogue: 0,1:52:48.18,1:52:50.88,Default,,0,0,0,,Өтпесе мағынасыз.
Dialogue: 0,1:52:50.88,1:52:54.48,Default,,0,0,0,,Сонда мен оны қашан өшіруім керек?
Dialogue: 0,1:52:54.48,1:52:56.95,Default,,0,0,0,,А... бұл...
Dialogue: 0,1:52:56.95,1:53:01.99,Default,,0,0,0,,Ямазаки! Сіз менің командама тағайындалғанға дейін сенімдімін ...
Dialogue: 0,1:53:01.99,1:53:06.43,Default,,0,0,0,,Иә, мен Төраға Хиодоға қызмет еттім.
Dialogue: 0,1:53:06.43,1:53:09.40,Default,,0,0,0,,Түсінбейсіз бе? иә?
Dialogue: 0,1:53:09.40,1:53:12.63,Default,,0,0,0,,Төраға салыстырмалы түрде жақсы көңіл-күйде болған уақыт
Dialogue: 0,1:53:12.63,1:53:15.20,Default,,0,0,0,,ммм
Dialogue: 0,1:53:15.20,1:53:18.00,Default,,0,0,0,,Көңіл-күйдің жақсы кезі десең де
Dialogue: 0,1:53:18.00,1:53:21.61,Default,,0,0,0,,Әй, төрағаның басынан аяғына дейін көңіл-күйі жоқ еді.
Dialogue: 0,1:53:21.61,1:53:26.41,Default,,0,0,0,,Базаның көңіл-күйі нашар, мүмкін олар табиғи түрде нашар көңіл-күйде.
Dialogue: 0,1:53:26.41,1:53:29.62,Default,,0,0,0,,Оның үстіне, ол қисынсыз және эмоционалды күйзелістерге ие.
Dialogue: 0,1:53:29.62,1:53:32.45,Default,,0,0,0,,Болжауға болмайтын дерлік Уф
Dialogue: 0,1:53:32.45,1:53:36.49,Default,,0,0,0,,Сонымен, төраға салыстырмалы түрде жақсы көңіл-күйде болғанда...
Dialogue: 0,1:53:36.49,1:53:38.99,Default,,0,0,0,,Ах!
Dialogue: 0,1:53:38.99,1:53:43.76,Default,,0,0,0,,Не болды? Бір сәтке
Dialogue: 0,1:53:43.76,1:53:47.60,Default,,0,0,0,,Иә? Бұл қысқа, бірақ бар
Dialogue: 0,1:53:47.60,1:53:52.34,Default,,0,0,0,,Төраға салыстырмалы түрде жақсы көңіл-күйде деп есептелетін алтын уақыт
Dialogue: 0,1:53:52.34,1:53:54.61,Default,,0,0,0,,Маған тыңдауға рұқсат етіңіз, Ямадаки
Dialogue: 0,1:53:54.61,1:53:56.61,Default,,0,0,0,,Және…
Dialogue: 0,1:53:58.95,1:54:02.05,Default,,0,0,0,,21:00. сол күні Teiai штаб-пәтері
Dialogue: 0,1:54:02.05,1:54:07.19,Default,,0,0,0,,Король моншасының алдындағы Казусон Хиодоға арналған үлкен қоғамдық монша
Dialogue: 0,1:54:07.19,1:54:12.06,Default,,0,0,0,,Жарайды, ол жаңа ғана шомылып жатқан сияқты.
Dialogue: 0,1:54:12.06,1:54:16.00,Default,,0,0,0,,Ол бірнеше минут ішінде шығуы мүмкін.
Dialogue: 0,1:54:16.00,1:54:18.06,Default,,0,0,0,,Сол сәтті мақсат етіңіз
Dialogue: 0,1:54:18.06,1:54:21.57,Default,,0,0,0,,Төрағаның алтын уақыты
Dialogue: 0,1:54:21.57,1:54:23.84,Default,,0,0,0,,Ванна қабылдағаннан кейін! ванна?
Dialogue: 0,1:54:23.84,1:54:27.04,Default,,0,0,0,,Иә, қара костюмді бөлмеде төрағаның қызметшісімен.
Dialogue: 0,1:54:27.04,1:54:29.04,Default,,0,0,0,,Ол салыстырмалы түрде танымал.
Dialogue: 0,1:54:29.04,1:54:32.88,Default,,0,0,0,,Негізі, төраға ваннаны қатты жақсы көреді.
Dialogue: 0,1:54:32.88,1:54:36.45,Default,,0,0,0,,Төрағаның жалпы көңіл-күйі басынан аяғына дейін нашар, бірақ ваннаға түскеннен кейін ғана.
Dialogue: 0,1:54:36.45,1:54:40.15,Default,,0,0,0,,Көбінесе салыстырмалы түрде тыныш. О!
Dialogue: 0,1:54:40.15,1:54:43.42,Default,,0,0,0,,Бірақ бір сәт төраға моншадан шықты.
Dialogue: 0,1:54:43.42,1:54:46.09,Default,,0,0,0,,Мен жатын бөлмеге кірген бойда бірнеше метр жерде.
Dialogue: 0,1:54:46.09,1:54:48.09,Default,,0,0,0,,Шығар! О...
Dialogue: 0,1:54:48.09,1:54:52.10,Default,,0,0,0,,Төраға әрқашан ваннаға түскеннен кейін тікелей жатын бөлмеге барады.
Dialogue: 0,1:54:52.10,1:54:56.60,Default,,0,0,0,,Демек, уақыт небәрі 20 секунд.
Dialogue: 0,1:54:56.60,1:55:01.88,Default,,0,0,0,,Ыстық жыпылықтайды, бу шықты, бір сәттік алтын уақыт
Dialogue: 0,1:55:01.88,1:55:05.81,Default,,0,0,0,,Әй, анау төраға неге моншадан шықты?
Dialogue: 0,1:55:05.81,1:55:08.62,Default,,0,0,0,,Сіз бұл салыстырмалы түрде тыныш екенін түсінесіз бе?
Dialogue: 0,1:55:08.62,1:55:12.25,Default,,0,0,0,,Әй, бұл қастың бұрышы.
Dialogue: 0,1:55:12.25,1:55:14.89,Default,,0,0,0,,Қас бұрышы? Иә
Dialogue: 0,1:55:14.89,1:55:19.36,Default,,0,0,0,,Бұл да төрағаның қара униформасына ортақ.
Dialogue: 0,1:55:19.36,1:55:25.23,Default,,0,0,0,,Президенттің көңіл-күйін оның қасының бұрышынан белгілі бір дәрежеде анықтауға болады.
Dialogue: 0,1:55:25.23,1:55:29.74,Default,,0,0,0,,Егер қастың бұрышы 0 градус пен 40 градус немесе одан төмен болса, салыстырмалы түрде жақсырақ.
Dialogue: 0,1:55:29.74,1:55:33.01,Default,,0,0,0,,Қауіпсіздік аймағы
Dialogue: 0,1:55:33.01,1:55:36.91,Default,,0,0,0,,Алайда, егер температура 40 градустан асса, сіз қызыл аймақтасыз.
Dialogue: 0,1:55:36.91,1:55:41.01,Default,,0,0,0,,Әрине, бұл ереженің дұрыс болуы міндетті емес.
Dialogue: 0,1:55:41.01,1:55:45.12,Default,,0,0,0,,Кейде ерекше жағдайлар болады, бірақ біз жалпы
Dialogue: 0,1:55:45.12,1:55:48.25,Default,,0,0,0,,Төрағаның көңіл-күйін осылай сұрадым.
Dialogue: 0,1:55:48.25,1:55:53.26,Default,,0,0,0,,Керемет! Ямадзаки мырза: Жуынған соң баруға болады!
Dialogue: 0,1:55:53.26,1:55:57.26,Default,,0,0,0,,Бірақ соған қарамастан, ықтималдық 50/50 болуы мүмкін.
Dialogue: 0,1:55:57.26,1:56:00.03,Default,,0,0,0,,Жоқ, тіпті бес минут та болмауы мүмкін.
Dialogue: 0,1:56:00.03,1:56:03.20,Default,,0,0,0,,Иә, алтын уақыт деп аталса да.
Dialogue: 0,1:56:03.20,1:56:07.44,Default,,0,0,0,,Салыстырмалы түрде тыныш болуы ықтималдығы жоғары.
Dialogue: 0,1:56:07.44,1:56:11.58,Default,,0,0,0,,Жуынған соң көңіл-күйім жиі болады.
Dialogue: 0,1:56:11.58,1:56:15.92,Default,,0,0,0,,Сонымен, доктор Тонегава, ваннаға түскеннен кейінгі президенттің сөйлеген сөзінің өзі...
Dialogue: 0,1:56:15.92,1:56:18.25,Default,,0,0,0,,Бір қарағанда қалыпты болып көрінсе де
Dialogue: 0,1:56:18.25,1:56:21.55,Default,,0,0,0,,Мұны жасамас бұрын, бір рет тексеріңіз.
Dialogue: 0,1:56:21.55,1:56:24.62,Default,,0,0,0,,Қастардың бұрышын реттеңіз...
Dialogue: 0,1:56:24.62,1:56:26.89,Default,,0,0,0,,Gi…
Dialogue: 0,1:56:26.89,1:56:31.10,Default,,0,0,0,,Ал егер бұрыш 40 градустан үлкен болса
Dialogue: 0,1:56:31.10,1:56:35.17,Default,,0,0,0,,Оны тартыңыз! Эй!
Dialogue: 0,1:56:35.17,1:56:40.17,Default,,0,0,0,,Бұл нәзік принцип, бірақ дана, профессор Тонегава.
Dialogue: 0,1:56:40.17,1:56:43.04,Default,,0,0,0,,Шынында да, нәзік принцип
Dialogue: 0,1:56:43.04,1:56:47.48,Default,,0,0,0,,Ямадзаки айтқан ештеңе анық емес.
Dialogue: 0,1:56:47.48,1:56:49.52,Default,,0,0,0,,Бұл жай ғана болжам Ах!\NМаған қазір
Dialogue: 0,1:56:49.52,1:56:54.12,Default,,0,0,0,,жеткілікті.
Dialogue: 0,1:56:54.12,1:56:57.89,Default,,0,0,0,,Дәлірек айтқанда, менде шыдамдылықтан басқа амал жоқ.
Dialogue: 0,1:56:57.89,1:57:02.16,Default,,0,0,0,,Үрсең ұшатын өрмекші жібек болса да
Dialogue: 0,1:57:02.16,1:57:04.23,Default,,0,0,0,,Ах
Dialogue: 0,1:57:04.23,1:57:06.90,Default,,0,0,0,,Уф
Dialogue: 0,1:57:06.90,1:57:10.14,Default,,0,0,0,,Төраға келді
Dialogue: 0,1:57:10.14,1:57:12.21,Default,,0,0,0,,Ақырында аян уақыты келді
Dialogue: 0,1:57:12.21,1:57:15.61,Default,,0,0,0,,Жарық пен қараңғылықты ажырататын соңғы үкім
Dialogue: 0,1:57:17.54,1:57:20.31,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,1:57:20.31,1:57:23.02,Default,,0,0,0,,Бұрыш
Dialogue: 0,1:57:23.02,1:57:25.12,Default,,0,0,0,,Қастар!
Dialogue: 0,1:57:25.12,1:57:27.12,Default,,0,0,0,,Бөлек көздер!
Dialogue: 0,1:57:27.12,1:57:29.12,Default,,0,0,0,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,1:57:33.59,1:57:36.86,Default,,0,0,0,,Нуо! Жоқ! Жоқ!
Dialogue: 0,1:57:36.86,1:57:42.04,Default,,0,0,0,,Ақымақ! Неліктен бет пакеті!
Dialogue: 0,1:57:42.04,1:57:45.51,Default,,0,0,0,,Бұл қасыңның бұрышын былай қойғанда, көп нәрсені білдірмейді.
Dialogue: 0,1:57:45.51,1:57:49.51,Default,,0,0,0,,Шындығында, мен қазірдің өзінде
Dialogue: 0,1:57:49.51,1:57:52.38,Default,,0,0,0,,Маусым қазан айының ортасында болды.
Dialogue: 0,1:57:52.38,1:57:55.78,Default,,0,0,0,,Ауа құрғай бастағанда жыл мезгілдерінің ауысуы
Dialogue: 0,1:57:55.78,1:58:01.52,Default,,0,0,0,,Қарт адамдар үшін құрғақ тері қазірдің өзінде алаңдаушылық тудырады.
Dialogue: 0,1:58:01.52,1:58:06.29,Default,,0,0,0,,Иә, Тейай тобының патшасы Казутака Хиодо.
Dialogue: 0,1:58:06.29,1:58:08.93,Default,,0,0,0,,Ата
Dialogue: 0,1:58:08.93,1:58:12.30,Default,,0,0,0,,Тіпті патшаға да тері күтімі керек
Dialogue: 0,1:58:12.30,1:58:16.00,Default,,0,0,0,,Ааааааааааааа...
Dialogue: 0,1:58:27.18,1:58:30.38,Default,,0,0,0,,Вааах!
Dialogue: 0,1:58:30.38,1:58:35.38,Default,,0,0,0,,Тонегава тағы да жоспарды жібере алмады
Dialogue: 0,1:58:38.19,1:58:40.19,Default,,0,0,0,,Санкциялар!
Dialogue: 0,1:58:42.46,1:58:45.27,Default,,0,0,0,,Сәтсіздік...
Dialogue: 0,1:58:45.27,1:58:51.24,Default,,0,0,0,,Тонегава белгіленген мерзімге 5 күн қалғанда ұсынысты ұсына алмады.
Dialogue: 0,1:58:51.24,1:58:54.07,Default,,0,0,0,,Оның үстіне ол күткендей кетеді.
Dialogue: 0,1:58:54.07,1:58:58.17,Default,,0,0,0,,Төраға: Гавайиге күтпеген 10 күндік сапар
Dialogue: 0,1:59:07.52,1:59:11.82,Default,,0,0,0,,Ал үш күннен кейін үшінші конференц-залда.
Dialogue: 0,1:59:11.82,1:59:15.92,Default,,0,0,0,,Мен де Гавайиге бардым.
Dialogue: 0,1:59:19.17,1:59:24.37,Default,,0,0,0,,Әрине, ұсынысты төрағаға беру
Dialogue: 0,1:59:24.37,1:59:26.57,Default,,0,0,0,,Тонегава мырза
Dialogue: 0,1:59:26.57,1:59:28.57,Default,,0,0,0,,Нәтижелер…
Dialogue: 0,1:59:30.81,1:59:35.72,Default,,0,0,0,,Аман-есен өтті. Шектеулі тас, қағаз, қайшы туралы шешім қабылданды.
Dialogue: 0,1:59:35.72,1:59:38.22,Default,,0,0,0,,Ха, мен жасадым!
Dialogue: 0,1:59:38.22,1:59:40.99,Default,,0,0,0,,Уау!
Dialogue: 0,1:59:40.99,1:59:44.66,Default,,0,0,0,,Хехехе... Көңіл-күйім ойлағаннан да жақсы.
Dialogue: 0,1:59:44.66,1:59:46.66,Default,,0,0,0,,Гавайидегі төраға
Dialogue: 0,1:59:49.96,1:59:53.26,Default,,0,0,0,,Мен де қастың бұрышын тексердім.
Dialogue: 0,1:59:57.84,2:00:00.71,Default,,0,0,0,,Иә
Dialogue: 0,2:00:00.71,2:00:02.71,Default,,0,0,0,,Эй!
Dialogue: 0,2:00:08.38,2:00:13.22,Default,,0,0,0,,Е, профессор Тонегава, бұл не?
Dialogue: 0,2:00:13.22,2:00:16.52,Default,,0,0,0,,Хехе, ақыры жоспар орындалды.
Dialogue: 0,2:00:16.52,2:00:19.99,Default,,0,0,0,,Ешбір мерекесіз келесі талқылауға тікелей өтпеңіз.
Dialogue: 0,2:00:19.99,2:00:22.23,Default,,0,0,0,,Бұл біраз жалғыздық болуы керек.
Dialogue: 0,2:00:22.23,2:00:26.83,Default,,0,0,0,,Сонымен, біз бүгін осы конференц-залда бастаймыз.
Dialogue: 0,2:00:26.83,2:00:29.90,Default,,0,0,0,,Уау!
Dialogue: 0,2:00:29.90,2:00:33.64,Default,,0,0,0,,Сәлем! Хехехе
Dialogue: 0,2:00:33.64,2:00:36.48,Default,,0,0,0,,Мүмкін қазір жоба сәтті болатын уақыт шығар.
Dialogue: 0,2:00:36.48,2:00:39.98,Default,,0,0,0,,Мүмкіндігінше жылдам қозғалатын маңызды сәт
Dialogue: 0,2:00:39.98,2:00:44.12,Default,,0,0,0,,Сондықтан біз оны қазір іске қосып жатырмыз.
Dialogue: 0,2:00:44.12,2:00:47.92,Default,,0,0,0,,Себебі жоба қиынға соғады.
Dialogue: 0,2:00:47.92,2:00:51.22,Default,,0,0,0,,Мен шиеленісті босатуға батылым бармын
Dialogue: 0,2:00:51.22,2:00:53.83,Default,,0,0,0,,Өткір! Фуфу
Dialogue: 0,2:00:53.83,2:00:56.50,Default,,0,0,0,,Сонымен қатар, мен үнемі өткізілетін орынды әдейі пайдаланамын.
Dialogue: 0,2:00:56.50,2:01:00.10,Default,,0,0,0,,Мен үшін осы конференц-залды таңдау ақылды идея болды.
Dialogue: 0,2:01:00.10,2:01:03.44,Default,,0,0,0,,Ұжым қалай бір-бірімен жақындасып, біртұтас жұмыс істей алады?
Dialogue: 0,2:01:03.44,2:01:05.91,Default,,0,0,0,,Ең жақсы жер
Dialogue: 0,2:01:05.91,2:01:08.01,Default,,0,0,0,,Тонегава сенімі
Dialogue: 0,2:01:08.01,2:01:12.21,Default,,0,0,0,,Қол астындағыларыңыздың жүрегін толығымен басқарыңыз және байланысты тереңдетіңіз
Dialogue: 0,2:01:12.21,2:01:15.01,Default,,0,0,0,,Ямадзаки Мен бұл жолы құтқарылдым.
Dialogue: 0,2:01:15.01,2:01:17.35,Default,,0,0,0,,Міне... Тонегава мырза
Dialogue: 0,2:01:17.35,2:01:21.05,Default,,0,0,0,,Әй, сусын ше? Кавасаки: Аа, кешіріңіз.
Dialogue: 0,2:01:21.05,2:01:23.36,Default,,0,0,0,,Сіз ішесіз бе? Хагио Иә!
Dialogue: 0,2:01:23.36,2:01:26.63,Default,,0,0,0,,Ogino Мынаны да жеп қойыңыз, рахмет.
Dialogue: 0,2:01:26.63,2:01:28.80,Default,,0,0,0,,Мұғалім, өте жақсы.
Dialogue: 0,2:01:28.80,2:01:31.93,Default,,0,0,0,,Енді сіз біздің есімдерімізді және бет-жүзімізді білесіз.
Dialogue: 0,2:01:31.93,2:01:35.47,Default,,0,0,0,,Ия, әрине, профессор Тонегава.
Dialogue: 0,2:01:35.47,2:01:38.87,Default,,0,0,0,,Не істеуім керек? Осыдан кейін Наката
Dialogue: 0,2:01:38.87,2:01:42.48,Default,,0,0,0,,Боулинг? Сіз білесіз деп ойлаймын
Dialogue: 0,2:01:42.48,2:01:46.15,Default,,0,0,0,,192 Менің ең жақсы ұпайым
Dialogue: 0,2:01:46.15,2:01:49.78,Default,,0,0,0,,Не? Мен бүгін жеңілмеймін. Барайық. Барайық.
Dialogue: 0,2:01:49.78,2:01:53.85,Default,,0,0,0,,Я, жарайды! О!
Dialogue: 0,2:01:53.85,2:01:57.76,Default,,0,0,0,,Бірақ ұмытпа, ертең таңғы 9-да жиналысымыз бар.
Dialogue: 0,2:01:57.76,2:02:00.79,Default,,0,0,0,,Сонымен модерацияда Иә!
Dialogue: 0,2:02:00.79,2:02:05.93,Default,,0,0,0,,Одан әрі қуаныш мерекесі
Dialogue: 0,2:02:05.93,2:02:09.93,Default,,0,0,0,,Ал келесі күні таңертең үшінші конференц-зал
Dialogue: 0,2:02:23.95,2:02:29.15,Default,,0,0,0,,Біз сізге сағат 9:22:10-да хабарлаймыз.
Dialogue: 0,2:02:31.52,2:02:36.23,Default,,0,0,0,,Уақытта күмән жоқ...
Dialogue: 0,2:02:36.23,2:02:38.46,Default,,0,0,0,,(Телефон қоңырау үні)
Dialogue: 0,2:02:38.46,2:02:42.20,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,2:02:42.20,2:02:46.54,Default,,0,0,0,,Негізі осыдан кейін мен жай ғана қызып кеттім.
Dialogue: 0,2:02:46.54,2:02:50.41,Default,,0,0,0,,Мен білмей тұрып, таңертең бәріміз жұмысқа аттандық...
Dialogue: 0,2:02:50.41,2:02:52.48,Default,,0,0,0,,Жетеді! иә?
Dialogue: 0,2:02:52.48,2:02:56.72,Default,,0,0,0,,Келе аласыз! Қазірдің өзінде бүгін! Тон өзені…
Dialogue: 0,2:02:56.72,2:03:00.25,Default,,0,0,0,,Тонегаваның ашуы
Dialogue: 0,2:03:00.25,2:03:05.16,Default,,0,0,0,,Партаға оралыңыз және үйге баруға дайындалыңыз, уақытты жоғалту
Dialogue: 0,2:03:05.16,2:03:07.99,Default,,0,0,0,,Ей, ақымақтар, мәңгілік ойнаңдар.
Dialogue: 0,2:03:07.99,2:03:13.50,Default,,0,0,0,,Ал мен құнды мүмкіндіктерді жоғалтып аламын
Dialogue: 0,2:03:13.50,2:03:19.44,Default,,0,0,0,,Иә? Кешіріңіз, Тонегава-сенсэй!
Dialogue: 0,2:03:19.44,2:03:21.81,Default,,0,0,0,,Тс!
Dialogue: 0,2:03:21.81,2:03:24.68,Default,,0,0,0,,Баланың өзі кешірім сұрай алады.
Dialogue: 0,2:03:24.68,2:03:27.61,Default,,0,0,0,,Кешірім сұрау қоғамда табиғи құбылыс.
Dialogue: 0,2:03:27.61,2:03:31.65,Default,,0,0,0,,Ең бастысы - оны іс-әрекетпен шешу.
Dialogue: 0,2:03:31.65,2:03:35.42,Default,,0,0,0,,Хаха... Иә?
Dialogue: 0,2:03:35.42,2:03:40.59,Default,,0,0,0,,Осы кезде Тон өзеніне қорқынышты сұмдық кенеттен шабуыл жасайды.
Dialogue: 0,2:03:40.59,2:03:42.60,Default,,0,0,0,,Қайғылы жайсыздық
Dialogue: 0,2:03:42.60,2:03:45.30,Default,,0,0,0,,Мен сенің осылай айтарыңа сенімді болдым.
Dialogue: 0,2:03:45.30,2:03:48.40,Default,,0,0,0,,Егер Тонегава мырза
Dialogue: 0,2:03:48.40,2:03:51.14,Default,,0,0,0,,Бұл кім?
Dialogue: 0,2:03:51.14,2:03:55.64,Default,,0,0,0,,Күтілгендей, біз бұл мәселені мұқият қарастырып жатырмыз.
Dialogue: 0,2:03:55.64,2:04:00.38,Default,,0,0,0,,Бірдей бет! Тонегава ыңғайсыздықтың себебін байқайды
Dialogue: 0,2:04:00.38,2:04:05.25,Default,,0,0,0,,Іс осылай жалғаса берсе, менде мұғалімдікіне сәйкес келетін бет болмайды.
Dialogue: 0,2:04:05.25,2:04:09.22,Default,,0,0,0,,Тағы да солай! Сондықтан мен бұл туралы ойладым
Dialogue: 0,2:04:09.22,2:04:12.49,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,2:04:12.49,2:04:16.63,Default,,0,0,0,,Мен бұл шынайы ойға қалай форма бере аламын?
Dialogue: 0,2:04:16.63,2:04:20.30,Default,,0,0,0,,Жоқ, балалар
Dialogue: 0,2:04:20.30,2:04:24.34,Default,,0,0,0,,Әрі қарай сол беттің себебіне назар аударыңыз
Dialogue: 0,2:04:24.34,2:04:29.34,Default,,0,0,0,,Иә! Біз басымызды айналдырдық!
Dialogue: 0,2:04:29.34,2:04:32.45,Default,,0,0,0,,Ик! (Адамдар айқайлап жатыр)
Dialogue: 0,2:04:32.45,2:04:36.35,Default,,0,0,0,,Әрине, бұл бас тек пішінге ғана емес, сонымен бірге мен қазірден бастап істейтін жұмысыма да арналған.
Dialogue: 0,2:04:36.35,2:04:38.92,Default,,0,0,0,,Қайтаруға бел байладым...хехехе
Dialogue: 0,2:04:38.92,2:04:42.59,Default,,0,0,0,,Көрдім, бұл шын сияқты.
Dialogue: 0,2:04:42.59,2:04:47.03,Default,,0,0,0,,Профессор Тонегава, сіз шынымен солайсыз
Dialogue: 0,2:04:47.03,2:04:49.46,Default,,0,0,0,,Үлкен ақымақ! иә?
Dialogue: 0,2:04:49.46,2:04:52.47,Default,,0,0,0,,Сіздің ұқсас жүздеріңіз есімде.
Dialogue: 0,2:04:52.47,2:04:55.40,Default,,0,0,0,,Мен неден көп кеңес алдым?
Dialogue: 0,2:04:55.40,2:04:58.57,Default,,0,0,0,,Бұл шаш үлгісі болды! Бірақ сендер жігіттер
Dialogue: 0,2:04:58.57,2:05:01.14,Default,,0,0,0,,Бір костюм және бірдей күннен қорғайтын көзілдірік киген ерлер
Dialogue: 0,2:05:01.14,2:05:04.81,Default,,0,0,0,,Егер бәріміз бірдей шаш үлгісін жасасақ ше?
Dialogue: 0,2:05:04.81,2:05:08.31,Default,,0,0,0,,Бұл енді ерекшеленбейді! Мүмкін емес!
Dialogue: 0,2:05:10.32,2:05:13.12,Default,,0,0,0,,Матрица!
Dialogue: 0,2:05:13.12,2:05:17.09,Default,,0,0,0,,А... Иә? «матрица»?
Dialogue: 0,2:05:17.09,2:05:19.43,Default,,0,0,0,,Сіз білесіз бе? О, жоқ
Dialogue: 0,2:05:19.43,2:05:23.10,Default,,0,0,0,,Идиот! Қараңызшы, «Матрица» сияқты!
Dialogue: 0,2:05:23.10,2:05:25.53,Default,,0,0,0,,Ух... кешіріңіз.
Dialogue: 0,2:05:25.53,2:05:28.00,Default,,0,0,0,,Ертең барлығымыз көрсетілімге барайық.
Dialogue: 0,2:05:28.00,2:05:32.57,Default,,0,0,0,,Идиот! Сен ақымақсың ба? ақымақ! Бұл қалай болуы мүмкін!
Dialogue: 0,2:05:32.57,2:05:38.01,Default,,0,0,0,,Сондықтан мен профессор Тонегаваның бұл деңгейге көңілі толмайтынын айттым.
Dialogue: 0,2:05:38.01,2:05:40.85,Default,,0,0,0,,Кикучи: Мен қатты өкінемін.
Dialogue: 0,2:05:40.85,2:05:44.08,Default,,0,0,0,,Жүрегім тоқ болса, кетуім керек еді.
Dialogue: 0,2:05:44.08,2:05:47.69,Default,,0,0,0,,Соңғы минутта көбірек
Dialogue: 0,2:05:47.69,2:05:50.99,Default,,0,0,0,,Бес адамға дейін, ақымақ!
Dialogue: 0,2:05:50.99,2:05:54.69,Default,,0,0,0,,Соңында бет-әлпет пен есімді қара түспен еске түсіруге тырыстым.
Dialogue: 0,2:05:54.69,2:05:58.30,Default,,0,0,0,,Нөлге дейін қайта жазылды
Dialogue: 0,2:05:58.30,2:06:02.47,Default,,0,0,0,,Тонегава осында келді және күтпеген жерден қайта жүктелді
Dialogue: 0,2:06:02.47,2:06:04.67,Default,,0,0,0,,Күтпеген сүріну
Dialogue: 0,2:06:07.27,2:06:14.08,Default,,0,0,0,,Сонда да бар күшіңді сал, Тонегава Жоғалтпа, Тонегава
Dialogue: 0,2:06:14.08,2:06:18.58,Default,,0,0,0,,О! Бұл менің бастығыммен, төрағамен.
Dialogue: 0,2:06:18.58,2:06:20.75,Default,,0,0,0,,Қара киімдегі қарамағындағылар арасында
Dialogue: 0,2:06:20.75,2:06:25.09,Default,,0,0,0,,Бұл күресіп, күресіп жүрген бір адамның әңгімесі.
Dialogue: 0,2:06:25.09,2:06:29.39,Default,,0,0,0,,Юкио Тонегава ортаңғы менеджері
Dialogue: 0,2:08:05.52,2:08:08.02,Default,,0,0,0,,Келесі жолы «Өзін-өзі өлтіру»
Dialogue: 0,2:10:50.96,2:10:53.06,Default,,0,0,0,,Болат өткел
Dialogue: 0,2:10:53.06,2:10:57.50,Default,,0,0,0,,Бұл Теяй ойнайтын ақылсыз ойын.
Dialogue: 0,2:10:57.50,2:11:00.93,Default,,0,0,0,,Жеңсең көп ақша аласың, ұтсаң ұтылып қаласың.
Dialogue: 0,2:11:00.93,2:11:04.54,Default,,0,0,0,,Еш ойланбастан өлім
Dialogue: 0,2:11:04.54,2:11:08.51,Default,,0,0,0,,Әлі де ер адамдар жалғастыру керек
Dialogue: 0,2:11:08.51,2:11:13.45,Default,,0,0,0,,Бір-біріміздің болмысымызда біз үміттің әлсіз нұрын табамыз.
Dialogue: 0,2:11:13.45,2:11:18.75,Default,,0,0,0,,Сол қорқынышты түннен бері уақыт кері кетті.
Dialogue: 0,2:11:18.75,2:11:25.32,Default,,0,0,0,,Талай қиындықтардан кейін шектеулі тас, қағаз, қайшы жоспары өтті.
Dialogue: 0,2:11:25.32,2:11:29.02,Default,,0,0,0,,Қуанышқа толы тост
Dialogue: 0,2:11:31.06,2:11:35.63,Default,,0,0,0,,Қара кигендердің бәрі кешігіп келді.
Dialogue: 0,2:11:35.63,2:11:39.24,Default,,0,0,0,,Келесі күнгі жиналыс, күтпеген өкініш, қырылған бас
Dialogue: 0,2:11:39.24,2:11:46.08,Default,,0,0,0,,Ақыры қайта жүктелген тұлға мен есімді есіне түсірді
Dialogue: 0,2:11:46.08,2:11:48.78,Default,,0,0,0,,Қайта есте сақтау
Dialogue: 0,2:11:48.78,2:11:55.19,Default,,0,0,0,,Teiai Group алып компаниясының №2 Юкио Тонегава
Dialogue: 0,2:11:55.19,2:12:01.49,Default,,0,0,0,,Саяси және іскерлік әлемде үстемдік ететін құбыжық, Хиодо Төрағаның оң қолы болған ессіз адам.
Dialogue: 0,2:12:03.53,2:12:06.63,Default,,0,0,0,,Бұл оның аңызының және даңқының астарында жатыр
Dialogue: 0,2:12:06.63,2:12:11.57,Default,,0,0,0,,Мен орта буын менеджері ретінде жасырын түрде қиналып, күресемін.
Dialogue: 0,2:12:11.57,2:12:18.77,Default,,0,0,0,,Ұлы адамның шағын, шағын әңгімесі.
Dialogue: 0,2:13:48.60,2:13:51.97,Default,,0,0,0,,Хмм.
Dialogue: 0,2:13:51.97,2:13:56.88,Default,,0,0,0,,Осы жолмен? Жоқ, күткендей...
Dialogue: 0,2:13:56.88,2:13:59.48,Default,,0,0,0,,Бұл Ямадзаки... Уф
Dialogue: 0,2:13:59.48,2:14:01.48,Default,,0,0,0,,Түсінесіз бе!
Dialogue: 0,2:14:04.15,2:14:06.25,Default,,0,0,0,,Жобаның сәттілігі үшін
Dialogue: 0,2:14:06.25,2:14:09.76,Default,,0,0,0,,Саған қамшы ғана емес, кәмпит керек деп ойладым.
Dialogue: 0,2:14:09.76,2:14:13.99,Default,,0,0,0,,Нәтижесі Мен бүлінген, бейқам тудым.
Dialogue: 0,2:14:13.99,2:14:16.76,Default,,0,0,0,,Мен сенің анаң емеспін
Dialogue: 0,2:14:16.76,2:14:19.83,Default,,0,0,0,,Былайша айтқанда, сіз өзіңіздің қол астыңыздағыларды шебер басқарасыз.
Dialogue: 0,2:14:19.83,2:14:23.70,Default,,0,0,0,,Жобаның табысына жетелейтін жокей
Dialogue: 0,2:14:23.70,2:14:28.84,Default,,0,0,0,,Бұл өрескел емдеу, бірақ бұл оларды оятуға жақсы мүмкіндік.
Dialogue: 0,2:14:28.84,2:14:33.68,Default,,0,0,0,,Иә! Иә, жоқ, жоқ, жоқ!
Dialogue: 0,2:14:33.68,2:14:39.65,Default,,0,0,0,,Саясатты өзгертудің шамадан тыс қамшылау режимі
Dialogue: 0,2:14:39.65,2:14:43.52,Default,,0,0,0,,Ал келесі күні үшінші конференц-зал
Dialogue: 0,2:14:43.52,2:14:47.36,Default,,0,0,0,,Міне, бүгіннен бастап біз ақыры дайындаламыз.
Dialogue: 0,2:14:47.36,2:14:51.76,Default,,0,0,0,,Шектеулі тас, қағаз, қайшы оқиғасына дайындалу үшін көп нәрсе істеу керек.
Dialogue: 0,2:14:51.76,2:14:56.97,Default,,0,0,0,,Біріншіден, өткізу орны. Шайтан ойынын өткізуге қолайлы жер.
Dialogue: 0,2:14:56.97,2:15:00.31,Default,,0,0,0,,Бұл шешім қабылданбаса, жабдық пен масштабты шешу мүмкін емес.
Dialogue: 0,2:15:00.31,2:15:04.21,Default,,0,0,0,,Мен барлығының ынтымақтаса отырып, жақсы идеяларды ұсынғанын қалаймын.
Dialogue: 0,2:15:04.21,2:15:07.41,Default,,0,0,0,,Ха! Мен соны айтқым келеді
Dialogue: 0,2:15:07.41,2:15:10.18,Default,,0,0,0,,Бұл жолы сайыс.
Dialogue: 0,2:15:10.18,2:15:12.65,Default,,0,0,0,,Ко жарыс?
Dialogue: 0,2:15:12.65,2:15:15.35,Default,,0,0,0,,Иә, бұл жарыс.
Dialogue: 0,2:15:15.35,2:15:19.39,Default,,0,0,0,,Әрқайсысы үш күннен кейін жиналыста баяндама жасау керек.
Dialogue: 0,2:15:19.39,2:15:22.63,Default,,0,0,0,,Жынның орын туралы ұсынысы
Dialogue: 0,2:15:22.63,2:15:28.00,Default,,0,0,0,,Конкурста таңдалған бір адам ғана жеңімпаз болып табылады
Dialogue: 0,2:15:28.00,2:15:31.30,Default,,0,0,0,,Айналаңыздағыларды ұрып тастаңыз! Уф
Dialogue: 0,2:15:33.47,2:15:36.34,Default,,0,0,0,,Таң қалдырыңыз! Егер сіз жеңбесеңіз, сіз қоқыссыз!
Dialogue: 0,2:15:36.34,2:15:39.51,Default,,0,0,0,,Бұл жерде жеңілгендердің аман қалуына жол жоқ.
Dialogue: 0,2:15:39.51,2:15:41.51,Default,,0,0,0,,Жеңіс!
Dialogue: 0,2:15:44.82,2:15:51.59,Default,,0,0,0,,Бірлік пен ынтымақтастықта жақсы ештеңе жоқ, тіпті бізге рұқсат етсеңіз де.
Dialogue: 0,2:15:51.59,2:15:55.43,Default,,0,0,0,,Тонегава елестетті
Dialogue: 0,2:15:55.43,2:15:59.93,Default,,0,0,0,,Менің аяғымның астынан көрінетін жол
Dialogue: 0,2:15:59.93,2:16:06.81,Default,,0,0,0,,Айналамызда қара киім киген адамдар өз жолдарымен кетіп жатыр.
Dialogue: 0,2:16:06.81,2:16:09.54,Default,,0,0,0,,Бір-бірімізге көмектесуге тырыссақ та, бір-бірімізден алыстамыз
Dialogue: 0,2:16:09.54,2:16:14.48,Default,,0,0,0,,Ешқашан жетпе, ешқашан кездеспе
Dialogue: 0,2:16:14.48,2:16:18.65,Default,,0,0,0,,Аспанда бірінен соң бірі ұшқан 11 шам
Dialogue: 0,2:16:18.65,2:16:23.29,Default,,0,0,0,,Әркім өз жолымен жүреді
Dialogue: 0,2:16:23.29,2:16:27.29,Default,,0,0,0,,Қысқасы, барлығы негізінен бір адам.
Dialogue: 0,2:16:27.29,2:16:31.49,Default,,0,0,0,,Оларды біріктіруге әрекет жасау қателік болды.
Dialogue: 0,2:16:33.77,2:16:36.27,Default,,0,0,0,,Жарыс туралы не деуге болады?
Dialogue: 0,2:16:41.94,2:16:46.98,Default,,0,0,0,,Ал үш күннен кейін алдағы жарыс күні.
Dialogue: 0,2:16:46.98,2:16:51.25,Default,,0,0,0,,Ал, мен, Ямадзаки, ұсынатын орын
Dialogue: 0,2:16:51.25,2:16:53.59,Default,,0,0,0,,TI Event Hall
Dialogue: 0,2:16:53.59,2:16:56.22,Default,,0,0,0,,Бұл Чуо Уордтағы оқиға алаңы.
Dialogue: 0,2:16:56.22,2:16:59.56,Default,,0,0,0,,Ауданы 450 шаршы метр
Dialogue: 0,2:16:59.56,2:17:03.66,Default,,0,0,0,,Оның үстіне, иесі Теяйдің ықпалындағы компанияның шенеунігі болып табылады.
Dialogue: 0,2:17:03.66,2:17:07.37,Default,,0,0,0,,Құпиялылыққа қатысты мәселе жоқ. Сіз қалай ойлайсыз?
Dialogue: 0,2:17:07.37,2:17:12.07,Default,,0,0,0,,Иә, жаман емес, бірақ аздап орташа.
Dialogue: 0,2:17:12.07,2:17:15.61,Default,,0,0,0,,Жын элементі Таң қалмайды Уф
Dialogue: 0,2:17:15.61,2:17:17.84,Default,,0,0,0,,Келесі! Ха...ха!
Dialogue: 0,2:17:17.84,2:17:20.18,Default,,0,0,0,,Бірақ одан кейін де
Dialogue: 0,2:17:20.18,2:17:24.02,Default,,0,0,0,,Мен бастауыш мектептің ойын алаңын ұсынамын.
Dialogue: 0,2:17:24.02,2:17:26.79,Default,,0,0,0,,Тосын, бірақ құпиялылық жоқ
Dialogue: 0,2:17:26.79,2:17:29.15,Default,,0,0,0,,Спорт күні! Келесі!
Dialogue: 0,2:17:29.15,2:17:34.29,Default,,0,0,0,,Әй, ә... жақсырақ, құпиялылық жеткілікті осы конференц-залда ма?
Dialogue: 0,2:17:34.29,2:17:36.63,Default,,0,0,0,,Кең емес, дәлірек айтсақ
Dialogue: 0,2:17:36.63,2:17:39.33,Default,,0,0,0,,Сіз жақсы идея ойлап таптыңыз. А... О, жоқ.
Dialogue: 0,2:17:39.33,2:17:42.80,Default,,0,0,0,,Келесі! Менің сүйікті жерім - еліктіретін жер
Dialogue: 0,2:17:42.80,2:17:45.00,Default,,0,0,0,,Түнде зират туралы не айтасыз?
Dialogue: 0,2:17:45.00,2:17:47.41,Default,,0,0,0,,Сонда бұл жабылған мектеп ғимараты.
Dialogue: 0,2:17:47.41,2:17:50.58,Default,,0,0,0,,Соңғы пойыздан кейінгі ұшқышсыз станция болса, сізді байқамайды.
Dialogue: 0,2:17:50.58,2:17:54.11,Default,,0,0,0,,Боулинг аллеясында жабылғаннан кейін мен...
Dialogue: 0,2:17:54.11,2:17:56.91,Default,,0,0,0,,Гартер!
Dialogue: 0,2:17:59.82,2:18:02.75,Default,,0,0,0,,Боулинг ойыны туралы күтпеген ой пайда болғанымен.
Dialogue: 0,2:18:02.75,2:18:05.36,Default,,0,0,0,,Түпкілікті жоспар әзірленбеген
Dialogue: 0,2:18:05.36,2:18:07.89,Default,,0,0,0,,Екі адам қалды
Dialogue: 0,2:18:07.89,2:18:11.93,Default,,0,0,0,,Бір адам - тас-қағаз-қайшы шектеулі ойынды ойлап тапқан ең жас Үміт.
Dialogue: 0,2:18:11.93,2:18:14.40,Default,,0,0,0,,Сабуро Саймон
Dialogue: 0,2:18:14.40,2:18:19.57,Default,,0,0,0,,Екіншісі - Эбитани.
Dialogue: 0,2:18:19.57,2:18:22.07,Default,,0,0,0,,Келесі Саймон га
Dialogue: 0,2:18:25.48,2:18:30.42,Default,,0,0,0,,Иә? Ойлап қарасам, шашы қырылған жалғыз сен емессің.
Dialogue: 0,2:18:30.42,2:18:33.82,Default,,0,0,0,,Не? Иә, мен жұмыста жіберген қателіктерім
Dialogue: 0,2:18:33.82,2:18:36.22,Default,,0,0,0,,Оны жұмыс арқылы қайтарған дұрыс па?
Dialogue: 0,2:18:38.29,2:18:40.29,Default,,0,0,0,,Цк
Dialogue: 0,2:18:45.43,2:18:47.43,Default,,0,0,0,,Меніңше... олар әлі өздерін жинастыра алмай, қиналып жатыр.
Dialogue: 0,2:18:49.43,2:18:52.23,Default,,0,0,0,,Келдің бе? Пауэр point
Dialogue: 0,2:19:06.32,2:19:11.06,Default,,0,0,0,,Сонымен, мен ұсынып отырған орын дәл
Dialogue: 0,2:19:11.06,2:19:14.56,Default,,0,0,0,,Espoir сәнді круиздік кемесі!
Dialogue: 0,2:19:14.56,2:19:17.60,Default,,0,0,0,,Кеме? Иә, қайықты жалға алыңыз
Dialogue: 0,2:19:17.60,2:19:21.10,Default,,0,0,0,,Біз оны тас, қағаз, қайшы шектеулі орынға айналдыруды ойлап жатырмыз.
Dialogue: 0,2:19:21.10,2:19:24.57,Default,,0,0,0,,Мұнда шолуды мұқият қарап шығыңыз.
Dialogue: 0,2:19:24.57,2:19:27.61,Default,,0,0,0,,Азума мырза
Dialogue: 0,2:19:27.61,2:19:30.48,Default,,0,0,0,,Espoir салмағы шамамен 60 000 тонна.
Dialogue: 0,2:19:30.48,2:19:35.38,Default,,0,0,0,,Жалпы ұзындығы 300 метрлік ультра-люкс круиздік кеме
Dialogue: 0,2:19:35.38,2:19:38.48,Default,,0,0,0,,Әдемі Дәл шынайы нәрсе сияқты
Dialogue: 0,2:19:38.48,2:19:42.49,Default,,0,0,0,,Оның үстіне бұл Teiai еншілес кәсіпорны Курогане Кайунға тиесілі кеме.
Dialogue: 0,2:19:42.49,2:19:44.76,Default,,0,0,0,,Құпиялылық проблема емес
Dialogue: 0,2:19:44.76,2:19:48.29,Default,,0,0,0,,Еден кеңістігі де 400 шаршы метрден асады.
Dialogue: 0,2:19:48.29,2:19:52.60,Default,,0,0,0,,Мен бұны күтпедім...
Dialogue: 0,2:19:52.60,2:19:54.80,Default,,0,0,0,,４Ｋ！
Dialogue: 0,2:19:54.80,2:19:58.20,Default,,0,0,0,,Және құмар ойын круизінің күтпегендігі
Dialogue: 0,2:19:58.20,2:20:03.11,Default,,0,0,0,,Мүлдем құтылу мүмкін емес, шайтанның орисы үміт пен үмітсіздікке толы
Dialogue: 0,2:20:03.11,2:20:06.41,Default,,0,0,0,,Басқаша айтқанда, төраға да қуанады.
Dialogue: 0,2:20:12.75,2:20:15.79,Default,,0,0,0,,Өте жақсы көремін.
Dialogue: 0,2:20:15.79,2:20:20.19,Default,,0,0,0,,Құмар ойындарға арналған круиз дегеніміз не? Ақылға сыймайтын идея, керемет
Dialogue: 0,2:20:20.19,2:20:24.83,Default,,0,0,0,,Explosion Powerpoint бағдарламасына тағы да рахмет
Dialogue: 0,2:20:24.83,2:20:29.47,Default,,0,0,0,,және 4K!
Dialogue: 0,2:20:29.47,2:20:33.87,Default,,0,0,0,,Осы кезде Тонегава ғана емес, қара киімділердің барлығы, соның ішінде Хигаши мырза,
Dialogue: 0,2:20:33.87,2:20:37.34,Default,,0,0,0,,Мен Саймонның жоспары шешім қабылдағанына сенімдімін.
Dialogue: 0,2:20:37.34,2:20:40.65,Default,,0,0,0,,Жарайды, соңғысы Эбитани га.
Dialogue: 0,2:20:40.65,2:20:45.45,Default,,0,0,0,,Иә, бір адамнан басқа.
Dialogue: 0,2:20:45.45,2:20:48.42,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз. Мен сізге материалдарды қазір жіберемін.
Dialogue: 0,2:20:48.42,2:20:51.12,Default,,0,0,0,,Біз таратамыз
Dialogue: 0,2:20:54.26,2:20:58.83,Default,,0,0,0,,Иә, көріп отырғаныңыздай, мен ұсынғым келетін орын
Dialogue: 0,2:20:58.83,2:21:02.27,Default,,0,0,0,,Минами Аоямадағы «Такуми» жапондық асханасы
Dialogue: 0,2:21:02.27,2:21:04.27,Default,,0,0,0,,Жапон тағамдары?
Dialogue: 0,2:21:06.44,2:21:08.87,Default,,0,0,0,,Келесі бетті қараңыз
Dialogue: 0,2:21:08.87,2:21:13.18,Default,,0,0,0,,Нағыз шебер шебер, жапондық тамақ әлемін басқаратын темір адам
Dialogue: 0,2:21:13.18,2:21:15.98,Default,,0,0,0,,Менеджер Джунпей Маруока
Dialogue: 0,2:21:15.98,2:21:19.78,Default,,0,0,0,,Ол ас әзірлеуге берілген, қисық болғанды жек көретін қыңыр қария.
Dialogue: 0,2:21:19.78,2:21:23.09,Default,,0,0,0,,Пикайчи ас әзірлеу дағдылары
Dialogue: 0,2:21:23.09,2:21:25.92,Default,,0,0,0,,Жақсы жерде болса да, 120 шаршы метрлік дүкен... Е, Эбитани...
Dialogue: 0,2:21:25.92,2:21:28.06,Default,,0,0,0,,Сәлем...
Dialogue: 0,2:21:28.06,2:21:32.36,Default,,0,0,0,,Қаланың қарбаласын ұмытуға болатын емдік кеңістік
Dialogue: 0,2:21:32.36,2:21:35.20,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,2:21:35.20,2:21:39.87,Default,,0,0,0,,Осы кезде, орын үшін қажетті үш шарт бар.
Dialogue: 0,2:21:39.87,2:21:43.27,Default,,0,0,0,,Ештеңені қанағаттандырмайды
Dialogue: 0,2:21:46.18,2:21:51.18,Default,,0,0,0,,Эбитани теріс хет-трик
Dialogue: 0,2:21:51.18,2:21:53.69,Default,,0,0,0,,Ойлап қарашы, мына асшаян алқабы
Dialogue: 0,2:21:53.69,2:21:58.69,Default,,0,0,0,,Мен жоқтау кезінде маған біртүрлі агрессивті жаңа жылдық ашықхат жіберген жалғыз адам.
Dialogue: 0,2:21:58.69,2:22:04.63,Default,,0,0,0,,Мен Иншунь Тейайдың №2 лауазымына жету үшін бар күшімді саламын.
Dialogue: 0,2:22:04.63,2:22:08.10,Default,,0,0,0,,Жоқ! Бұл тығыздықтың жылу мәні
Dialogue: 0,2:22:08.10,2:22:11.70,Default,,0,0,0,,Иә, менде қызу бар, бірақ...
Dialogue: 0,2:22:11.70,2:22:16.11,Default,,0,0,0,,Менің «Такумиді» №27 ұсынатын себебім
Dialogue: 0,2:22:16.11,2:22:18.81,Default,,0,0,0,,Түтін бөлу өшірулі!
Dialogue: 0,2:22:18.81,2:22:23.01,Default,,0,0,0,,Бұл Эбитани есімді адамның жеңетін бірдеңесі бар.
Dialogue: 0,2:22:23.01,2:22:27.71,Default,,0,0,0,,Негізінен! 28-бөлім Хориготацу
Dialogue: 0,2:22:29.79,2:22:33.09,Default,,0,0,0,,99-бөлім Мұрын атақты
Dialogue: 0,2:22:41.37,2:22:44.80,Default,,0,0,0,,Иә...
Dialogue: 0,2:22:44.80,2:22:46.91,Default,,0,0,0,,Эбитани иә?
Dialogue: 0,2:22:46.91,2:22:50.34,Default,,0,0,0,,Мұғалім Сіз осынша кеш жұмыс істеп жатырсыз ба?
Dialogue: 0,2:22:50.34,2:22:54.41,Default,,0,0,0,,Жарайды... бүгінгі жарыс ұят болды.
Dialogue: 0,2:22:54.41,2:22:58.02,Default,,0,0,0,,Ах, бұл... хехехе...
Dialogue: 0,2:22:58.02,2:23:01.29,Default,,0,0,0,,Осыдан кейін ішсек қайтеді?
Dialogue: 0,2:23:01.29,2:23:03.29,Default,,0,0,0,,Тіпті Минами Аоямада
Dialogue: 0,2:23:15.47,2:23:18.50,Default,,0,0,0,,Мен түсіндім, бұл сөзсіз жақсы дүкен.
Dialogue: 0,2:23:18.50,2:23:23.44,Default,,0,0,0,,Иә, солай ма? Иә, бұл жақсы дүкен.
Dialogue: 0,2:23:23.44,2:23:26.61,Default,,0,0,0,,Тым тар Ах... иә
Dialogue: 0,2:23:26.61,2:23:31.22,Default,,0,0,0,,Ең сорақысы – «қисық нәрселерді жек көретін дүкен меңгерушісі».
Dialogue: 0,2:23:31.22,2:23:33.55,Default,,0,0,0,,ше? Неліктен?
Dialogue: 0,2:23:33.55,2:23:36.49,Default,,0,0,0,,Бұл ақымақтардың әрекеті
Dialogue: 0,2:23:36.49,2:23:39.76,Default,,0,0,0,,Өте заңсыз құмар ойындар
Dialogue: 0,2:23:39.76,2:23:42.73,Default,,0,0,0,,түбірден қисық
Dialogue: 0,2:23:42.73,2:23:47.00,Default,,0,0,0,,Ах... Кеңдік Құпиялылық Күтпегендік
Dialogue: 0,2:23:47.00,2:23:50.74,Default,,0,0,0,,Бұл үш нәрсе маңызды Жиналыстың барысы
Dialogue: 0,2:23:50.74,2:23:54.31,Default,,0,0,0,,Сіз байқамадыңыз ба? Ах... кешіріңіз.
Dialogue: 0,2:23:54.31,2:23:59.58,Default,,0,0,0,,Хехехе Бір мағынада күтпеген жағдай ең жақсы болды.
Dialogue: 0,2:23:59.58,2:24:04.15,Default,,0,0,0,,Хехе, рахмет, ақымақ, алданып қалма.
Dialogue: 0,2:24:04.15,2:24:06.45,Default,,0,0,0,,Бұл жаман тосын, иә?
Dialogue: 0,2:24:06.45,2:24:11.09,Default,,0,0,0,,100 себебі бірінші кезекте оның тым көп болуы мүмкін
Dialogue: 0,2:24:11.09,2:24:13.83,Default,,0,0,0,,А... Төраға шетке.
Dialogue: 0,2:24:13.83,2:24:17.26,Default,,0,0,0,,Жеңілсең үлкен пәле болады.
Dialogue: 0,2:24:17.26,2:24:21.33,Default,,0,0,0,,Темекі шегуге арналған бөлек орындар немесе жуғыштар қажет емес.
Dialogue: 0,2:24:21.33,2:24:26.71,Default,,0,0,0,,Кешіріңіз, хаа... Отырыңыз.
Dialogue: 0,2:24:26.71,2:24:32.74,Default,,0,0,0,,Мен соңғы уақытта біртүрлі мазасызданып жүрмін...
Dialogue: 0,2:24:32.74,2:24:34.81,Default,,0,0,0,,Саймон, иә?
Dialogue: 0,2:24:34.81,2:24:38.31,Default,,0,0,0,,Сіз асығыссыз ба? Оның жетістігіне
Dialogue: 0,2:24:40.69,2:24:46.32,Default,,0,0,0,,Уф... Ол менен кіші, бірақ мен онымен құрдаспын.
Dialogue: 0,2:24:46.32,2:24:50.36,Default,,0,0,0,,Мен сені ұнатпайтын өзін-өзі ұстайтын жігіт деп ойладым.
Dialogue: 0,2:24:50.36,2:24:53.77,Default,,0,0,0,,Менен де қымбаттап бара жатырсың.
Dialogue: 0,2:24:53.77,2:24:58.14,Default,,0,0,0,,Эбитани Маған ондай ұнамайды, мен өз-өзіммен жүретін жігітпін.
Dialogue: 0,2:24:58.14,2:25:01.14,Default,,0,0,0,,Араларыңызда қандай айырмашылық бар? иә?
Dialogue: 0,2:25:01.14,2:25:04.18,Default,,0,0,0,,Хм, шаш үлгісі?
Dialogue: 0,2:25:04.18,2:25:08.45,Default,,0,0,0,,Жоқ. Бұл таразы. Таразы?
Dialogue: 0,2:25:08.45,2:25:11.55,Default,,0,0,0,,Иә, ол идеяларды ұсынғанда.
Dialogue: 0,2:25:11.55,2:25:15.72,Default,,0,0,0,,Мен бюджетке келгенде егжей-тегжейлі ойламаймын.
Dialogue: 0,2:25:15.72,2:25:18.92,Default,,0,0,0,,Екінші жағынан, гориготацуда дегенді қалай түсінесіңдер?
Dialogue: 0,2:25:18.92,2:25:22.56,Default,,0,0,0,,Бұл ұшыру орны туралы әңгіме тыңдау сияқты.
Dialogue: 0,2:25:22.56,2:25:25.23,Default,,0,0,0,,Шағын масштаб
Dialogue: 0,2:25:25.23,2:25:29.23,Default,,0,0,0,,Сол жеті қиыншылықты ойлама.
Dialogue: 0,2:25:29.23,2:25:32.77,Default,,0,0,0,,Мына қыран бірдеңе жасайды
Dialogue: 0,2:25:32.77,2:25:36.21,Default,,0,0,0,,Бастықтың еркелігін көрсетіңіз
Dialogue: 0,2:25:36.21,2:25:40.95,Default,,0,0,0,,Келесісі бір аптадан кейін рок, қағаз, қайшы карталарын жобалау бойынша шектеулі конкурс болады
Dialogue: 0,2:25:40.95,2:25:44.62,Default,,0,0,0,,Ой... Мені таң қалдыр!
Dialogue: 0,2:25:44.62,2:25:47.72,Default,,0,0,0,,Тонегава мырза
Dialogue: 0,2:25:47.72,2:25:51.82,Default,,0,0,0,,Иә, бұл жігіттің орны жоқ шығар.
Dialogue: 0,2:25:51.82,2:25:55.69,Default,,0,0,0,,Менің күш-қуатым басқаларға қарағанда көп, бірақ мақсатым аз.
Dialogue: 0,2:25:55.69,2:25:58.80,Default,,0,0,0,,Ұят, былайша айтқанда.
Dialogue: 0,2:25:58.80,2:26:00.80,Default,,0,0,0,,Бұлай емес! Сіз қайда мақсат етіп отырсыз?
Dialogue: 0,2:26:00.80,2:26:04.47,Default,,0,0,0,,Эй, мына жерде.
Dialogue: 0,2:26:04.47,2:26:08.94,Default,,0,0,0,,Дұрыс бағытталмаған зеңбірек, бірақ ол дұрыс бағытталған болса
Dialogue: 0,2:26:08.94,2:26:14.71,Default,,0,0,0,,Саймон және екеуің топты басқара алатын күшке айнала аласыңдар.
Dialogue: 0,2:26:14.71,2:26:19.42,Default,,0,0,0,,Профессор Тонегава, бүгінгі кеш үшін сізге көп рахмет.
Dialogue: 0,2:26:19.42,2:26:24.36,Default,,0,0,0,,Бар күшімді саламын, таң қалдырамын, сенімдімін
Dialogue: 0,2:26:24.36,2:26:26.36,Default,,0,0,0,,Хехехе мен көріп тұрмын.
Dialogue: 0,2:26:26.36,2:26:28.96,Default,,0,0,0,,Мен оны асыға күтемін Иә.
Dialogue: 0,2:26:31.80,2:26:34.13,Default,,0,0,0,,Осы жарысқа қатысты
Dialogue: 0,2:26:34.13,2:26:38.77,Default,,0,0,0,,Тонегава ойындағы бейне
Dialogue: 0,2:26:38.77,2:26:40.87,Default,,0,0,0,,11 шамдар
Dialogue: 0,2:26:40.87,2:26:46.41,Default,,0,0,0,,Әр адам өзгермейтін тура жол екені рас.
Dialogue: 0,2:26:46.41,2:26:51.28,Default,,0,0,0,,Бірақ сіз жасай алатын жалғыз нәрсе
Dialogue: 0,2:26:51.28,2:26:53.85,Default,,0,0,0,,Ах... байланыс
Dialogue: 0,2:26:53.85,2:26:58.39,Default,,0,0,0,,Қараңғыда тоғысқан сөздер, олардың шексіз алмасуы
Dialogue: 0,2:26:58.39,2:27:03.39,Default,,0,0,0,,Жолымыз қиылыспаса да, сөз алмаса аламыз.
Dialogue: 0,2:27:08.37,2:27:10.60,Default,,0,0,0,,Ах...
Dialogue: 0,2:27:10.60,2:27:15.07,Default,,0,0,0,,Әрине, шынымен келді ме, жоқ па, білмеймін.
Dialogue: 0,2:27:15.07,2:27:17.58,Default,,0,0,0,,Ешкім білмейді
Dialogue: 0,2:27:17.58,2:27:21.15,Default,,0,0,0,,байланыс арқылы өзгертуге болады
Dialogue: 0,2:27:21.15,2:27:23.25,Default,,0,0,0,,Адамдар – адамдар
Dialogue: 0,2:27:25.28,2:27:29.05,Default,,0,0,0,,Тонегава мырза! Не болды, шулы
Dialogue: 0,2:27:29.05,2:27:31.36,Default,,0,0,0,,Бұл Эбидани.
Dialogue: 0,2:27:31.36,2:27:34.19,Default,,0,0,0,,Жұмысқа келмедің бе, Эбитани?
Dialogue: 0,2:27:34.19,2:27:37.10,Default,,0,0,0,,А, сосын маған хабарласты.
Dialogue: 0,2:27:37.10,2:27:40.40,Default,,0,0,0,,Жеке себептерге байланысты жұмысқа келмейтін сияқты.
Dialogue: 0,2:27:40.40,2:27:45.97,Default,,0,0,0,,Бірақ кешегі презентацияңыздың сәтсіздігінен көңіліңіз түсіп кетті ме деп алаңдаймын...
Dialogue: 0,2:27:45.97,2:27:49.04,Default,,0,0,0,,Бұл жеңімпаздың маржасы ма? Саймон
Dialogue: 0,2:27:49.04,2:27:51.24,Default,,0,0,0,,Уф
Dialogue: 0,2:27:51.24,2:27:55.18,Default,,0,0,0,,Мен мұны осылай елестете аламын.
Dialogue: 0,2:27:55.18,2:27:59.08,Default,,0,0,0,,Хехехе... ол қазір
Dialogue: 0,2:27:59.08,2:28:01.59,Default,,0,0,0,,Тозақ қазанының түбінде
Dialogue: 0,2:28:01.59,2:28:05.29,Default,,0,0,0,,Ол жеңу мүмкіндігін іздеп жүр ме деп ойлаймын.
Dialogue: 0,2:28:05.29,2:28:08.99,Default,,0,0,0,,Карточка дизайны бойынша келесі конкурс болуы мүмкін
Dialogue: 0,2:28:08.99,2:28:13.06,Default,,0,0,0,,Туды Ебиядан барлығын таң қалдыр
Dialogue: 0,2:28:13.06,2:28:16.86,Default,,0,0,0,,Жындық идея Уф!
Dialogue: 0,2:28:19.00,2:28:22.44,Default,,0,0,0,,А... Мен бұл туралы ешқашан ойламаппын.
Dialogue: 0,2:28:22.44,2:28:24.44,Default,,0,0,0,,Пайғамбар сияқты
Dialogue: 0,2:28:24.44,2:28:30.65,Default,,0,0,0,,Хехехехе мен өзімнің қарамағындағылардың психологиясымен таныспын.
Dialogue: 0,2:28:30.65,2:28:34.89,Default,,0,0,0,,Төраға Хиодоның Гавайиден оралатын уақыты жақындап қалды.
Dialogue: 0,2:28:34.89,2:28:37.79,Default,,0,0,0,,Мен сізді әуежайдан күтіп алуым керек.
Dialogue: 0,2:28:37.79,2:28:40.96,Default,,0,0,0,,Тонегава Көбірек көрсету
Dialogue: 0,2:28:40.96,2:28:43.76,Default,,0,0,0,,Бастықтың сенімділігі
Dialogue: 0,2:28:51.00,2:28:56.34,Default,,0,0,0,,Егер төрағаның көңіл-күйі жақсы болса, кеше шешілген орын туралы ұсыныс беріңіз.
Dialogue: 0,2:28:56.34,2:29:01.25,Default,,0,0,0,,Ең нашар жағдайда қол тигізбейтін
Dialogue: 0,2:29:01.25,2:29:04.15,Default,,0,0,0,,Сіз жұмыстан босатылдыңыз! А... міне!
Dialogue: 0,2:29:04.15,2:29:06.85,Default,,0,0,0,,Сол ұшқыш жұмыстан шығарылды! Ха!
Dialogue: 0,2:29:06.85,2:29:10.36,Default,,0,0,0,,Егер ол қатты шайқалса, бұл жай ғана турбуленттілік.
Dialogue: 0,2:29:10.36,2:29:12.96,Default,,0,0,0,,Ха, тез арада келісім жаса, әрине.
Dialogue: 0,2:29:12.96,2:29:18.33,Default,,0,0,0,,Нашар Қастың бұрышы - төрағаның көңіл-күйінің көрсеткіші
Dialogue: 0,2:29:18.33,2:29:20.93,Default,,0,0,0,,40 градустық қауіпсіз аймақтан алыс
Dialogue: 0,2:29:20.93,2:29:24.30,Default,,0,0,0,,Қатты наразылықтың қызыл аймағы
Dialogue: 0,2:29:24.30,2:29:29.21,Default,,0,0,0,,Бұл жерде ештеңе істемей, келесі мүмкіндікті күткен дұрыс.
Dialogue: 0,2:29:29.21,2:29:32.94,Default,,0,0,0,,Ха ха ха... а?
Dialogue: 0,2:29:32.94,2:29:37.82,Default,,0,0,0,,Ебия, мұнда неге келдің?
Dialogue: 0,2:29:37.82,2:29:41.82,Default,,0,0,0,,Тонегаваның кеудесінде қатты қобалжу пайда болады
Dialogue: 0,2:29:41.82,2:29:45.69,Default,,0,0,0,,Жүрегімді екі суық қол ұстап алғандай.
Dialogue: 0,2:29:45.69,2:29:48.06,Default,,0,0,0,,Мұндай салқындық
Dialogue: 0,2:29:48.06,2:29:51.93,Default,,0,0,0,,А, эй, күте тұрыңыз! Ха ха ха...
Dialogue: 0,2:29:51.93,2:29:54.57,Default,,0,0,0,,Не, сен!
Dialogue: 0,2:29:54.57,2:29:58.04,Default,,0,0,0,,Төраға Хиодо, мен, Эбитани
Dialogue: 0,2:29:58.04,2:30:00.74,Default,,0,0,0,,Мен сенен жақсылық сұрауға келдім.
Dialogue: 0,2:30:00.74,2:30:04.64,Default,,0,0,0,,Гу Чоки Пар Төрағасының қол ізінің үш түрі
Dialogue: 0,2:30:04.64,2:30:07.78,Default,,0,0,0,,Мен оны шектеулі тас, қағаз, қайшы картасы ретінде пайдаланғым келеді.
Dialogue: 0,2:30:07.78,2:30:11.55,Default,,0,0,0,,Сәлем! өтінемін!
Dialogue: 0,2:30:11.55,2:30:15.72,Default,,0,0,0,,Төрағаның қол ізі... карточкада?
Dialogue: 0,2:30:15.72,2:30:17.72,Default,,0,0,0,,Ха!
Dialogue: 0,2:30:22.53,2:30:25.83,Default,,0,0,0,,Уф, жұмыстан босатылдың!
Dialogue: 0,2:30:25.83,2:30:29.77,Default,,0,0,0,,Иә? Эбитани бір оқпен атылды
Dialogue: 0,2:30:29.77,2:30:33.40,Default,,0,0,0,,Сонымен ... және ...
Dialogue: 0,2:30:33.40,2:30:37.58,Default,,0,0,0,,Тонегава мырза! Ақымақ! Мұнда қарамаңыз
Dialogue: 0,2:30:37.58,2:30:40.48,Default,,0,0,0,,Иә? Жақсы! Аа, төраға
Dialogue: 0,2:30:40.48,2:30:43.18,Default,,0,0,0,,Гавайи қалай болды?
Dialogue: 0,2:30:43.18,2:30:45.62,Default,,0,0,0,,Уф, жалақының төмендеуі!
Dialogue: 0,2:30:45.62,2:30:47.62,Default,,0,0,0,,Ga!
Dialogue: 0,2:30:47.62,2:30:51.19,Default,,0,0,0,,Қарым-қатынас арқылы өзгертілген мақсат
Dialogue: 0,2:30:51.19,2:30:54.96,Default,,0,0,0,,А? Күтпеген жерден қашу
Dialogue: 0,2:30:54.96,2:30:58.33,Default,,0,0,0,,Уау! Өзін-өзі жою!
Dialogue: 0,2:30:58.33,2:31:01.50,Default,,0,0,0,,Уау... уф...
Dialogue: 0,2:31:01.50,2:31:05.70,Default,,0,0,0,,А, иә...? иә?
Dialogue: 0,2:31:05.70,2:31:08.81,Default,,0,0,0,,11 10-ға дейін жанады
Dialogue: 0,2:31:08.81,2:31:11.48,Default,,0,0,0,,Уф...
Dialogue: 0,2:31:11.48,2:31:14.08,Default,,0,0,0,,Тонегаваның үлкен қателігі
Dialogue: 0,2:31:14.08,2:31:17.68,Default,,0,0,0,,Бұл тым таңқаларлық, ақымақ!
Dialogue: 0,2:31:25.32,2:31:28.49,Default,,0,0,0,,Аа, ұстаз, қайырлы таң.
Dialogue: 0,2:31:28.49,2:31:31.96,Default,,0,0,0,,Сен ақымақсың ба? Өзің кінәлісің!
Dialogue: 0,2:31:31.96,2:31:36.60,Default,,0,0,0,,Бұл мүлдем дұрыс емес. Әлде айту керек пе
Dialogue: 0,2:31:36.60,2:31:40.64,Default,,0,0,0,,Бұл мен бүркенгенді қалаймын!
Dialogue: 0,2:31:40.64,2:31:45.08,Default,,0,0,0,,Уф... жоғалып кет, тез жоғал!
Dialogue: 0,2:31:45.08,2:31:49.35,Default,,0,0,0,,Енді ешқашан менің алдымда көрінбе! Сен не туралы айтып тұрсың? Тонегава мырза
Dialogue: 0,2:31:49.35,2:31:52.48,Default,,0,0,0,,Жоғал! Тез жоғалып кет! Бұл менің бастығыммен, төрағамен.
Dialogue: 0,2:31:52.48,2:31:57.66,Default,,0,0,0,,Менің қарамағымда болған қара киімді аруақтар арасында күресу.
Dialogue: 0,2:31:57.66,2:32:00.36,Default,,0,0,0,,Бұл бір адамның әңгімесі.
Dialogue: 0,2:32:00.36,2:32:04.36,Default,,0,0,0,,Юкио Тонегава орта менеджері жоғалып кетті!
Dialogue: 0,2:33:40.46,2:33:42.66,Default,,0,0,0,,Келесі жолы «Инвазия»
Dialogue: 0,2:36:26.22,2:36:29.22,Default,,0,0,0,,Бағынышты Эбитани күтпеген жерден қашып кетті
Dialogue: 0,2:36:32.56,2:36:35.80,Default,,0,0,0,,Эбитани оқ атылды
Dialogue: 0,2:36:35.80,2:36:38.20,Default,,0,0,0,,Ии!
Dialogue: 0,2:36:38.20,2:36:42.04,Default,,0,0,0,,Тонегаваның қатаң жазасы, жалақысының төмендеуі
Dialogue: 0,2:36:42.04,2:36:44.38,Default,,0,0,0,,Жалақы төмендетілді! Гррр...
Dialogue: 0,2:36:44.38,2:36:47.14,Default,,0,0,0,,Мына кісінің айлығы қысқартылды!
Dialogue: 0,2:36:47.14,2:36:49.78,Default,,0,0,0,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,2:36:49.78,2:36:56.22,Default,,0,0,0,,Teiai Group алып компаниясының №2 Юкио Тонегава
Dialogue: 0,2:36:56.22,2:37:02.52,Default,,0,0,0,,Саяси және іскерлік әлемде үстемдік ететін құбыжық, Хиодо Төрағаның оң қолы болған ессіз адам.
Dialogue: 0,2:37:04.56,2:37:07.67,Default,,0,0,0,,Бұл оның аңызының және даңқының астарында жатыр
Dialogue: 0,2:37:07.67,2:37:12.60,Default,,0,0,0,,Мен орта буын менеджері ретінде жасырын түрде қиналып, күресемін.
Dialogue: 0,2:37:12.60,2:37:19.60,Default,,0,0,0,,Ұлы адамның шағын, шағын әңгімесі.
Dialogue: 0,2:38:49.83,2:38:54.27,Default,,0,0,0,,Шектеулі тас-қағаз-қайшы іс-шарасын өткізуге арналған негізгі орын
Dialogue: 0,2:38:54.27,2:38:57.58,Default,,0,0,0,,Оны Espoir люкс круиздік кемесіне ауыстыру мәселесі қауіпсіз.
Dialogue: 0,2:38:57.58,2:39:00.95,Default,,0,0,0,,Хиодоның рұқсатын алу
Dialogue: 0,2:39:00.95,2:39:05.08,Default,,0,0,0,,Жобаның өзі бірқалыпты жүріп жатыр
Dialogue: 0,2:39:05.08,2:39:10.29,Default,,0,0,0,,Бұл конструкциялар бірінші жаттығу күнінен кері есептелген.
Dialogue: 0,2:39:10.29,2:39:14.29,Default,,0,0,0,,Кем дегенде бір апта ішінде шешілуі керек
Dialogue: 0,2:39:16.56,2:39:19.40,Default,,0,0,0,,Сан біреуге азайған сайын қатысушы зейнетке шығады.
Dialogue: 0,2:39:19.40,2:39:22.83,Default,,0,0,0,,Басқаша айтқанда, тозаққа бару жақындап келеді.
Dialogue: 0,2:39:22.83,2:39:24.84,Default,,0,0,0,,Жүрек белгісі туралы не деуге болады?
Dialogue: 0,2:39:24.84,2:39:28.24,Default,,0,0,0,,Аа, менің өмірімді алып жатқандай.
Dialogue: 0,2:39:28.24,2:39:32.74,Default,,0,0,0,,Бірақ сіз үш белгі қоюдан бастайсыз, солай ма?
Dialogue: 0,2:39:36.71,2:39:39.95,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,2:39:39.95,2:39:42.89,Default,,0,0,0,,Үйленген неке сияқты көрінуі жиіркенішті емес пе?
Dialogue: 0,2:39:42.89,2:39:45.52,Default,,0,0,0,,Хм, шоттар ше?
Dialogue: 0,2:39:45.52,2:39:49.33,Default,,0,0,0,,А, бұл шын, солай емес пе? Бұл өте айқын.
Dialogue: 0,2:39:49.33,2:39:52.16,Default,,0,0,0,,Менің ойымша, қарапайым жұлдыз жақсы болар еді.
Dialogue: 0,2:39:52.16,2:39:56.50,Default,,0,0,0,,Әй, жеңілсең, үміттің жұлдыздары азаяды, солай ма?
Dialogue: 0,2:39:56.50,2:40:01.00,Default,,0,0,0,,Аа, бұл клише, бірақ бұл ең сенімді.
Dialogue: 0,2:40:03.67,2:40:07.71,Default,,0,0,0,,Бұл ойын болғандықтан, оны түсінуге оңай етіп жасаған дұрыс деп ойлаймын.
Dialogue: 0,2:40:07.71,2:40:11.05,Default,,0,0,0,,Иә, гу – тас, қайшы – қайшы.
Dialogue: 0,2:40:11.05,2:40:13.05,Default,,0,0,0,,Параны қағазға айналдырғың келе ме?
Dialogue: 0,2:40:13.05,2:40:16.45,Default,,0,0,0,,Керісінше, түсіну қиын емес пе?
Dialogue: 0,2:40:16.45,2:40:19.49,Default,,0,0,0,,Гу - ер, пар - әйел
Dialogue: 0,2:40:19.49,2:40:22.49,Default,,0,0,0,,Екеуінің қосындысы таяқша түрінде өрнектеледі.
Dialogue: 0,2:40:22.49,2:40:25.49,Default,,0,0,0,,Алдыңғыға шығарылған ойнақылық... Мағынасы жоқ!
Dialogue: 0,2:40:28.60,2:40:33.47,Default,,0,0,0,,Қарапайым болыңыз, бірақ қатысушылардың психологиясын түсініңіз
Dialogue: 0,2:40:33.47,2:40:38.11,Default,,0,0,0,,Ойындықтағы психологиялық қысым Оңбау
Dialogue: 0,2:40:38.11,2:40:41.11,Default,,0,0,0,,Бұл дизайн. Иә!
Dialogue: 0,2:40:43.98,2:40:49.12,Default,,0,0,0,,Ал, мен ойлап тапқан дизайн идеясы
Dialogue: 0,2:40:49.12,2:40:52.99,Default,,0,0,0,,Мынау...
Dialogue: 0,2:40:52.99,2:40:57.39,Default,,0,0,0,,Рентген аппараты
Dialogue: 0,2:40:57.39,2:41:00.06,Default,,0,0,0,,Оны рентгенге ұқсас конструкцияға айналдыру арқылы
Dialogue: 0,2:41:00.06,2:41:03.27,Default,,0,0,0,,Қорқынышты сезім тудырады
Dialogue: 0,2:41:03.27,2:41:06.57,Default,,0,0,0,,Міне келдің! Идея қабылданады.
Dialogue: 0,2:41:06.57,2:41:10.91,Default,,0,0,0,,Ха, көп рахмет.
Dialogue: 0,2:41:10.91,2:41:13.38,Default,,0,0,0,,Карточка дизайны бойынша ұсыныс шешілді
Dialogue: 0,2:41:13.38,2:41:17.58,Default,,0,0,0,,Ақырында шектеулі тасты, қағазды, қайшыны ұстауға қарай жылжи бастады
Dialogue: 0,2:41:17.58,2:41:19.98,Default,,0,0,0,,Басталуы
Dialogue: 0,2:41:22.42,2:41:25.59,Default,,0,0,0,,Келесі күн туралы.
Dialogue: 0,2:41:25.59,2:41:29.59,Default,,0,0,0,,(жөтел)
Dialogue: 0,2:41:29.59,2:41:33.60,Default,,0,0,0,,Ұжым бір, бір ғана мақсат
Dialogue: 0,2:41:33.60,2:41:37.63,Default,,0,0,0,,Ойын жасау Шайтан ойынын өткізу
Dialogue: 0,2:41:37.63,2:41:40.87,Default,,0,0,0,,Бірақ көп нәрсе болады
Dialogue: 0,2:41:40.87,2:41:43.07,Default,,0,0,0,,Қолыңды суретке түсірсем не істеуім керек?
Dialogue: 0,2:41:43.07,2:41:45.44,Default,,0,0,0,,Сәлем... Кешіріңіз.
Dialogue: 0,2:41:45.44,2:41:49.11,Default,,0,0,0,,Дизайнерге қоңырау шалыңыз. Иә!
Dialogue: 0,2:41:49.11,2:41:51.75,Default,,0,0,0,,Тонегава мырза өткізілетін орынды тексерді...
Dialogue: 0,2:41:51.75,2:41:53.75,Default,,0,0,0,,Келесі аптаның басы
Dialogue: 0,2:41:53.75,2:41:57.25,Default,,0,0,0,,Доктор Тонегава, қапшық өндірушісі не істеуі керек?
Dialogue: 0,2:41:57.25,2:42:00.19,Default,,0,0,0,,Бұл біздің қолшатырымыздағы зауыт болатынына сенімдімін.
Dialogue: 0,2:42:00.19,2:42:03.26,Default,,0,0,0,,Тонегава мырзаның бір күндік түскі ас қорабы...
Dialogue: 0,2:42:03.26,2:42:05.73,Default,,0,0,0,,Қажет емес!
Dialogue: 0,2:42:05.73,2:42:08.63,Default,,0,0,0,,Иә, мүлде
Dialogue: 0,2:42:08.63,2:42:11.77,Default,,0,0,0,,Нұсқау күтіп тұрған адамдар, сендер кімсіңдер?
Dialogue: 0,2:42:11.77,2:42:14.27,Default,,0,0,0,,Менен сұрамайынша қозғала алмайсың ба?
Dialogue: 0,2:42:14.27,2:42:19.31,Default,,0,0,0,,Бүркіт осыған ұқсас нәрседен құласа не болар еді?
Dialogue: 0,2:42:19.31,2:42:21.91,Default,,0,0,0,,Тонегава мырза! Не?
Dialogue: 0,2:42:21.91,2:42:24.45,Default,,0,0,0,,Ішек
Dialogue: 0,2:42:24.45,2:42:27.05,Default,,0,0,0,,Кавасаки-кун
Dialogue: 0,2:42:27.05,2:42:30.55,Default,,0,0,0,,Менің қатты қызбам бар.
Dialogue: 0,2:42:30.55,2:42:34.42,Default,,0,0,0,,Не? Ал әзірге демалыс бөлмесінде...
Dialogue: 0,2:42:34.42,2:42:38.50,Default,,0,0,0,,Идиот! Мені ауруханаға апарыңыз! Иә!
Dialogue: 0,2:42:38.50,2:42:44.00,Default,,0,0,0,,Уф... Мені Тон өзені біраз уайымдап тұр.
Dialogue: 0,2:42:46.44,2:42:50.64,Default,,0,0,0,,Өзіңіздің физикалық жағдайыңызды басқара алмау қандай болады?
Dialogue: 0,2:42:50.64,2:42:53.61,Default,,0,0,0,,Хмм… 1 сағат?
Dialogue: 0,2:42:53.61,2:42:56.65,Default,,0,0,0,,А, қалай болды?
Dialogue: 0,2:42:56.65,2:43:00.58,Default,,0,0,0,,Иә, солай.
Dialogue: 0,2:43:00.58,2:43:04.86,Default,,0,0,0,,Кавасаки-кун тұмаумен ауырған сияқты.
Dialogue: 0,2:43:04.86,2:43:07.83,Default,,0,0,0,,Иә?
Dialogue: 0,2:43:07.83,2:43:10.43,Default,,0,0,0,,Мазасыздық
Dialogue: 0,2:43:10.43,2:43:12.73,Default,,0,0,0,,Қорқыныш
Dialogue: 0,2:43:12.73,2:43:18.57,Default,,0,0,0,,Тонегаваның санасында «инвазия» деген екі сөз өтеді.
Dialogue: 0,2:43:18.57,2:43:22.24,Default,,0,0,0,,Сіз не істейсіз? Тонегава мырза
Dialogue: 0,2:43:22.24,2:43:25.74,Default,,0,0,0,,Не істесең де, не істесең де
Dialogue: 0,2:43:25.74,2:43:28.71,Default,,0,0,0,,Барып алудан басқа амалым жоқ.
Dialogue: 0,2:43:28.71,2:43:32.12,Default,,0,0,0,,Сіз оны алып кетесіз бе? Не?
Dialogue: 0,2:43:32.12,2:43:35.92,Default,,0,0,0,,Вакцинациялар қазір басталады
Dialogue: 0,2:43:38.99,2:43:41.99,Default,,0,0,0,,Қазірдің өзінде қыстың биігі
Dialogue: 0,2:43:46.16,2:43:51.77,Default,,0,0,0,,Бірақ біз күресеміз, Тонегава командасы
Dialogue: 0,2:43:51.77,2:43:54.77,Default,,0,0,0,,Маған бәрібір! Ха!
Dialogue: 0,2:43:54.77,2:43:59.07,Default,,0,0,0,,Аа, бұл күннен басталады.
Dialogue: 0,2:44:05.45,2:44:10.82,Default,,0,0,0,,Тонегаваның гигиенасын мұқият басқару
Dialogue: 0,2:44:10.82,2:44:14.42,Default,,0,0,0,,Әзірге төрағаның мәжіліс залына кіру мүмкіндігі жоқ.
Dialogue: 0,2:44:14.42,2:44:17.39,Default,,0,0,0,,Мен сенен бұлай істемеуіңді өтіндім.
Dialogue: 0,2:44:17.39,2:44:20.20,Default,,0,0,0,,Бетпердеңізді еш уақытта шешпеңіз
Dialogue: 0,2:44:20.20,2:44:23.53,Default,,0,0,0,,Тыңдаңыз, вакцинация антиденелер пайда болғанша жасалады.
Dialogue: 0,2:44:23.53,2:44:28.11,Default,,0,0,0,,Бұл 1-2 аптаға созылады.
Dialogue: 0,2:44:28.11,2:44:32.84,Default,,0,0,0,,Басқаша айтқанда, сақтықты төмендетпеңіз.
Dialogue: 0,2:44:32.84,2:44:37.01,Default,,0,0,0,,Құдай тұмау вирусын дәл осылай атады.
Dialogue: 0,2:44:37.01,2:44:40.81,Default,,0,0,0,,Абсолюттік қорғаныс шебін қорғайтын шабуыл және қорғаныс
Dialogue: 0,2:44:45.29,2:44:49.69,Default,,0,0,0,,Мойыңды әрі қарай, ол тамағыңа терең енгенше.
Dialogue: 0,2:44:57.57,2:45:01.27,Default,,0,0,0,,Жарайды, көбіктеніп кетті, енді уақыты келді...
Dialogue: 0,2:45:03.74,2:45:07.34,Default,,0,0,0,,Жоқ! Эй... Тонегава мырза
Dialogue: 0,2:45:07.34,2:45:10.34,Default,,0,0,0,,Натторан хаа сияқты
Dialogue: 0,2:45:13.58,2:45:16.55,Default,,0,0,0,,Қолды жуу – бұл жай көбік шығару.
Dialogue: 0,2:45:16.55,2:45:21.26,Default,,0,0,0,,Оны сумен шайып тастау оңай емес.
Dialogue: 0,2:45:21.26,2:45:25.96,Default,,0,0,0,,Саусақтардың арасында, тырнақтарда
Dialogue: 0,2:45:25.96,2:45:28.87,Default,,0,0,0,,Бұл тек қолдар туралы емес.
Dialogue: 0,2:45:28.87,2:45:33.04,Default,,0,0,0,,Бар, әрең! О!
Dialogue: 0,2:45:33.04,2:45:37.71,Default,,0,0,0,,Шынтаққа дейін Ууу хи Шынтақ па?
Dialogue: 0,2:45:37.71,2:45:41.61,Default,,0,0,0,,Иә, бұл дәл Құдайды өліммен қарсы алу сияқты.
Dialogue: 0,2:45:41.61,2:45:43.91,Default,,0,0,0,,Асура сияқты шабуыл және қорғаныс
Dialogue: 0,2:45:43.91,2:45:48.55,Default,,0,0,0,,Тұмаудың шабуылын сабынды дезинфекция деп аталатын қалқан қарсы алады
Dialogue: 0,2:45:48.55,2:45:51.55,Default,,0,0,0,,Шаю деп аталатын қылыш
Dialogue: 0,2:45:53.52,2:45:58.50,Default,,0,0,0,,Осы уақытқа дейін біз қазір жартымыз
Dialogue: 0,2:45:58.50,2:46:01.90,Default,,0,0,0,,Жалқау болма, қолыңды жу
Dialogue: 0,2:46:11.07,2:46:13.08,Default,,0,0,0,,Ум... а?
Dialogue: 0,2:46:13.08,2:46:16.35,Default,,0,0,0,,Тонегава мырза, не болды, Саймон?
Dialogue: 0,2:46:16.35,2:46:20.25,Default,,0,0,0,,Жоқ, үш күн болды.
Dialogue: 0,2:46:20.25,2:46:23.79,Default,,0,0,0,,Оны алып тастай аламын ба? маска
Dialogue: 0,2:46:23.79,2:46:28.13,Default,,0,0,0,,Иә? Идиот, бұл жақсы нәрсе... Бұлтты!
Dialogue: 0,2:46:28.13,2:46:31.29,Default,,0,0,0,,Бұлтты ма? Маска мен ылғалдандырғыштың арқасында
Dialogue: 0,2:46:31.29,2:46:33.63,Default,,0,0,0,,күннен қорғайтын көзілдірік! Уф
Dialogue: 0,2:46:33.63,2:46:36.80,Default,,0,0,0,,Қалың тұмандағыдай
Dialogue: 0,2:46:36.80,2:46:39.37,Default,,0,0,0,,Қараңғыда тұман сияқты
Dialogue: 0,2:46:39.37,2:46:42.27,Default,,0,0,0,,Бұл маған ешқандай жұмыс әкелмейді!
Dialogue: 0,2:46:42.27,2:46:44.57,Default,,0,0,0,,Хмм... мм
Dialogue: 0,2:46:44.57,2:46:46.94,Default,,0,0,0,,Доктор Тонегава: Мен де бұлттымын...
Dialogue: 0,2:46:46.94,2:46:49.61,Default,,0,0,0,,Мен де өтінемін.
Dialogue: 0,2:46:49.61,2:46:53.92,Default,,0,0,0,,Мұғалім айтқандай, мен шайқаймын, қолымды жақсылап жуамын.
Dialogue: 0,2:46:53.92,2:46:56.65,Default,,0,0,0,,Жұмыстан келген соң, шықпадым.
Dialogue: 0,2:46:56.65,2:47:01.86,Default,,0,0,0,,Содан бері ешкім ауырған жоқ.
Dialogue: 0,2:47:01.86,2:47:05.93,Default,,0,0,0,,Хмм, түсіндім, мойындаймын.
Dialogue: 0,2:47:05.93,2:47:09.13,Default,,0,0,0,,Уау! Алақай!
Dialogue: 0,2:47:09.13,2:47:13.74,Default,,0,0,0,,Цк, жарайды, Кавасакиден кейін ешкім қызықпайды.
Dialogue: 0,2:47:13.74,2:47:17.71,Default,,0,0,0,,Бірақ, бұлай қобалжудың қажеті жоқ екені рас...
Dialogue: 0,2:47:17.71,2:47:20.34,Default,,0,0,0,,А...
Dialogue: 0,2:47:20.34,2:47:24.65,Default,,0,0,0,,Не, Тонегава-сан!
Dialogue: 0,2:47:24.65,2:47:28.75,Default,,0,0,0,,Тон өзенінен шыққан бірінші жөтел дыбысы
Dialogue: 0,2:47:32.79,2:47:36.79,Default,,0,0,0,,Өлгеннен кейін Құдайдың белгісі
Dialogue: 0,2:47:40.60,2:47:42.60,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,2:47:46.90,2:47:49.21,Default,,0,0,0,,Ах
Dialogue: 0,2:47:49.21,2:47:52.41,Default,,0,0,0,,Гонда мырза, қалай болды? Тонегава мырза
Dialogue: 0,2:47:54.38,2:47:56.48,Default,,0,0,0,,Шығар! Ахх
Dialogue: 0,2:47:56.48,2:48:01.02,Default,,0,0,0,,Тонегава мырза, күтпеген тұмау
Dialogue: 0,2:48:01.02,2:48:03.45,Default,,0,0,0,,Үйде емдеу Уф
Dialogue: 0,2:48:03.45,2:48:08.69,Default,,0,0,0,,Міне осылай... Тонегава мырзасыз жобаны қалай жалғастырамыз...
Dialogue: 0,2:48:08.69,2:48:11.53,Default,,0,0,0,,Қандай жағдай болмасын, бұл мүмкін емес. Бұл мүмкін емес.
Dialogue: 0,2:48:11.53,2:48:13.53,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,2:48:13.53,2:48:16.10,Default,,0,0,0,,Төраға Хиододан сұрайсыз ба?
Dialogue: 0,2:48:16.10,2:48:20.10,Default,,0,0,0,,Бұл ақылсыз. Соңында Эбитани сияқты болу керек.
Dialogue: 0,2:48:20.10,2:48:24.21,Default,,0,0,0,,Профессор Тонегава оралмайынша, жобаны тоқтатудан басқа амалымыз жоқ.
Dialogue: 0,2:48:24.21,2:48:27.51,Default,,0,0,0,,Бірақ репетиция күні белгіленген.
Dialogue: 0,2:48:27.51,2:48:30.25,Default,,0,0,0,,Сонымен не істейміз?
Dialogue: 0,2:48:30.25,2:48:32.72,Default,,0,0,0,,Не істеу керек? Бұл мүмкін емес еді
Dialogue: 0,2:48:32.72,2:48:35.89,Default,,0,0,0,,Мүмкін емес! Мынадай нәрсе...
Dialogue: 0,2:48:35.89,2:48:38.69,Default,,0,0,0,,Нан! Ха
Dialogue: 0,2:48:38.69,2:48:41.32,Default,,0,0,0,,Гонда мырза
Dialogue: 0,2:48:41.32,2:48:44.22,Default,,0,0,0,,Шу шығармаңдар, бәйбішелер
Dialogue: 0,2:48:47.83,2:48:52.77,Default,,0,0,0,,Тонегава мырза кеткен бойда Гьяа Гяа Гяа Гяа
Dialogue: 0,2:48:52.77,2:48:57.37,Default,,0,0,0,,Тонегава ханым сіздің анаңыз емес.
Dialogue: 0,2:49:00.11,2:49:04.18,Default,,0,0,0,,Уайымдама, мен... жоқ
Dialogue: 0,2:49:04.18,2:49:08.52,Default,,0,0,0,,Мен Тонегава мырзаның орнын аламын.
Dialogue: 0,2:49:08.52,2:49:11.52,Default,,0,0,0,,Ха! Иә
Dialogue: 0,2:49:17.86,2:49:20.80,Default,,0,0,0,,Мм... жақсысың ба?
Dialogue: 0,2:49:20.80,2:49:22.97,Default,,0,0,0,,Жарайды!
Dialogue: 0,2:49:22.97,2:49:26.27,Default,,0,0,0,,Маған қалдырыңыз... маған!
Dialogue: 0,2:49:26.27,2:49:30.21,Default,,0,0,0,,Иә, мен тағайындалдым.
Dialogue: 0,2:49:30.21,2:49:34.48,Default,,0,0,0,,Гонда Бүркіт қайтып келгенше
Dialogue: 0,2:49:34.48,2:49:38.52,Default,,0,0,0,,Сіз менің орныма келуіңіз керек.
Dialogue: 0,2:49:38.52,2:49:42.25,Default,,0,0,0,,Мен? Бұл дұрыс
Dialogue: 0,2:49:42.25,2:49:46.02,Default,,0,0,0,,Бірақ мен үшін бұл өте...
Dialogue: 0,2:49:46.02,2:49:48.79,Default,,0,0,0,,Мен сұрадым, үлкені.
Dialogue: 0,2:49:48.79,2:49:51.29,Default,,0,0,0,,Және… Тонегава мырза!
Dialogue: 0,2:49:56.50,2:50:02.51,Default,,0,0,0,,Мен Тонегава мырзаның үмітін ақтауым керек.
Dialogue: 0,2:50:02.51,2:50:05.44,Default,,0,0,0,,Осылайша кабинет асығыс құрылды.
Dialogue: 0,2:50:05.44,2:50:09.84,Default,,0,0,0,,Гонданың әдеттен тыс әкімшілігі басталды
Dialogue: 0,2:50:17.45,2:50:20.62,Default,,0,0,0,,Мм, Гонда мырза?
Dialogue: 0,2:50:20.62,2:50:23.46,Default,,0,0,0,,Сіз темекі шектіңіз бе?
Dialogue: 0,2:50:23.46,2:50:25.76,Default,,0,0,0,,Не? Ах...
Dialogue: 0,2:50:28.60,2:50:31.37,Default,,0,0,0,,Профессор Тонегаваның орнында болса да.
Dialogue: 0,2:50:31.37,2:50:34.17,Default,,0,0,0,,Пішінге еліктеудің қажеті жоқ, солай ма?
Dialogue: 0,2:50:34.17,2:50:38.88,Default,,0,0,0,,Мм... иә, дұрыс.
Dialogue: 0,2:50:38.88,2:50:41.88,Default,,0,0,0,,Кешіріңіз, Гонда мырза. иә?
Dialogue: 0,2:50:41.88,2:50:46.42,Default,,0,0,0,,Тас, қағаз, қайшы карталарының қанша жиынтығына тапсырыс беруім керек?
Dialogue: 0,2:50:46.42,2:50:51.55,Default,,0,0,0,,Е, бұл... у...
Dialogue: 0,2:50:51.55,2:50:55.53,Default,,0,0,0,,Уф, ең сорақысы жетіспейтін үлгі.
Dialogue: 0,2:50:55.53,2:50:58.46,Default,,0,0,0,,Тағы да осы жерде
Dialogue: 0,2:50:58.46,2:51:01.16,Default,,0,0,0,,Иә, 10 000! иә? иә?
Dialogue: 0,2:51:01.16,2:51:04.07,Default,,0,0,0,,А, ой... ой, ой, ой, 9000, 9000!
Dialogue: 0,2:51:04.07,2:51:08.31,Default,,0,0,0,,Аа... Түсіндім, 9000.
Dialogue: 0,2:51:08.31,2:51:11.47,Default,,0,0,0,,Ах... Гонда мырза!
Dialogue: 0,2:51:11.47,2:51:16.01,Default,,0,0,0,,Бұл борышкердің кассасы, бірақ... иә.
Dialogue: 0,2:51:16.01,2:51:19.45,Default,,0,0,0,,Ол матадан жасалады ма? Оның былғарыдан жасалғанын қалайсыз ба?
Dialogue: 0,2:51:19.45,2:51:21.82,Default,,0,0,0,,Ах... былғары!
Dialogue: 0,2:51:21.82,2:51:25.39,Default,,0,0,0,,Қандай теріні қалайсыз? Ууууу...
Dialogue: 0,2:51:25.39,2:51:28.96,Default,,0,0,0,,Уф, сиыр!
Dialogue: 0,2:51:28.96,2:51:31.46,Default,,0,0,0,,Түс ше!
Dialogue: 0,2:51:31.46,2:51:34.60,Default,,0,0,0,,Уау, о...
Dialogue: 0,2:51:34.60,2:51:37.40,Default,,0,0,0,,Ча ча қоңыр...
Dialogue: 0,2:51:37.40,2:51:40.77,Default,,0,0,0,,Қоңыр! Мен түссіндім.
Dialogue: 0,2:51:40.77,2:51:43.71,Default,,0,0,0,,Күте тұрыңыз! иә?
Dialogue: 0,2:51:43.71,2:51:46.21,Default,,0,0,0,,Өйткені, бұл қара!
Dialogue: 0,2:51:46.21,2:51:49.38,Default,,0,0,0,,Бұл қайсысы? Қара?
Dialogue: 0,2:51:49.38,2:51:51.55,Default,,0,0,0,,Қара түспен жүр!
Dialogue: 0,2:51:51.55,2:51:54.05,Default,,0,0,0,,Иә, қара түсті.
Dialogue: 0,2:51:58.99,2:52:01.52,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,2:52:01.52,2:52:03.99,Default,,0,0,0,,Не?
Dialogue: 0,2:52:03.99,2:52:06.00,Default,,0,0,0,,Гонда мырзада
Dialogue: 0,2:52:06.00,2:52:09.03,Default,,0,0,0,,Ол 2000 жылдан бері ең үлкені.
Dialogue: 0,2:52:09.03,2:52:12.27,Default,,0,0,0,,Жүрегімдегі уайым сыртқа шығып барады.
Dialogue: 0,2:52:12.27,2:52:14.90,Default,,0,0,0,,Мен мұны адамдарға түсіндірмеуге тырысамын.
Dialogue: 0,2:52:14.90,2:52:17.37,Default,,0,0,0,,Бұл мені алаңдатады.
Dialogue: 0,2:52:17.37,2:52:22.65,Default,,0,0,0,,Бірақ эй, ол мұны өзі жасаймын деді.
Dialogue: 0,2:52:22.65,2:52:25.75,Default,,0,0,0,,Бірақ Саймон Сабуроның уайымына қарамастан,
Dialogue: 0,2:52:25.75,2:52:31.05,Default,,0,0,0,,Gonda командасы кейбір мәселелерге қарамастан жұмыс істейді.
Dialogue: 0,2:52:33.16,2:52:35.53,Default,,0,0,0,,Бірақ екі күннен кейін
Dialogue: 0,2:52:35.53,2:52:39.90,Default,,0,0,0,,Ах...
Dialogue: 0,2:52:39.90,2:52:42.57,Default,,0,0,0,,Гонда мырза, сіз ауруханаға баруыңыз керек...
Dialogue: 0,2:52:42.57,2:52:44.57,Default,,0,0,0,,Келесі орын – оңтүстік-оңтүстік-шығыс!
Dialogue: 0,2:52:44.57,2:52:48.20,Default,,0,0,0,,Тек кенеттен дене қызуы көтеріліп, денемнің барлық буындары ауырды.
Dialogue: 0,2:52:48.20,2:52:51.07,Default,,0,0,0,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 0,2:52:51.07,2:52:53.84,Default,,0,0,0,,Эй, бұл...
Dialogue: 0,2:52:53.84,2:52:59.38,Default,,0,0,0,,Өлім құдайы, үш рет, мейірімсіз
Dialogue: 0,2:52:59.38,2:53:02.49,Default,,0,0,0,,Сөзсіз тұмау
Dialogue: 0,2:53:02.49,2:53:05.69,Default,,0,0,0,,Мен не істеуім керек? Не істеуім керек?
Dialogue: 0,2:53:05.69,2:53:09.83,Default,,0,0,0,,Үйге барғаның дұрыс.
Dialogue: 0,2:53:09.83,2:53:13.53,Default,,0,0,0,,Мұны профессор Тонегава да айтқан жоқ па? Мені кінәлама
Dialogue: 0,2:53:15.70,2:53:18.94,Default,,0,0,0,,Бұл мен жинаған нәрсе емес пе?
Dialogue: 0,2:53:18.94,2:53:22.27,Default,,0,0,0,,Сен мен сияқты сенімсізсің.
Dialogue: 0,2:53:22.27,2:53:26.27,Default,,0,0,0,,Көп қолынан келмейтін адам – көшбасшы.
Dialogue: 0,2:53:29.08,2:53:31.55,Default,,0,0,0,,Күннің аяғында тұмау
Dialogue: 0,2:53:31.55,2:53:35.55,Default,,0,0,0,,Ку… куку… Қорқытпақ
Dialogue: 0,2:53:35.55,2:53:37.62,Default,,0,0,0,,Қорқытшы да жақсы
Dialogue: 0,2:53:37.62,2:53:40.12,Default,,0,0,0,,Е, жоқ, олай емес...
Dialogue: 0,2:53:40.12,2:53:43.73,Default,,0,0,0,,Мен білемін.
Dialogue: 0,2:53:43.73,2:53:47.33,Default,,0,0,0,,Осы жылы, қара киімнің разряды кезінде
Dialogue: 0,2:53:47.33,2:53:52.77,Default,,0,0,0,,Менде бар жалғыз нәрсе - жоғарылау мүмкіндігі жоқ.
Dialogue: 0,2:53:52.77,2:53:56.57,Default,,0,0,0,,Бұл жерде ешнәрсе жоқ, мен онымен таныспын.
Dialogue: 0,2:53:56.57,2:53:59.64,Default,,0,0,0,,Адамдардың, дәлірек айтқанда, өзіміздің дәрменсіздігіміз.
Dialogue: 0,2:53:59.64,2:54:02.25,Default,,0,0,0,,А... Мен олай айтқым келген жоқ.
Dialogue: 0,2:54:02.25,2:54:05.25,Default,,0,0,0,,Бірақ бұл да менің кінәм.
Dialogue: 0,2:54:07.32,2:54:11.49,Default,,0,0,0,,Ойлап қарасам, соңғы 50 жылда мен әрқашан болдым
Dialogue: 0,2:54:11.49,2:54:15.33,Default,,0,0,0,,Мен жауапкершіліктен қаша бердім.
Dialogue: 0,2:54:15.33,2:54:17.83,Default,,0,0,0,,Әрқашан қауіпсіз болыңыз
Dialogue: 0,2:54:22.67,2:54:24.97,Default,,0,0,0,,Уф!
Dialogue: 0,2:54:24.97,2:54:27.40,Default,,0,0,0,,Қауіпсіз болу үшін!
Dialogue: 0,2:54:27.40,2:54:30.31,Default,,0,0,0,,Ах! Нәтиже
Dialogue: 0,2:54:30.31,2:54:33.54,Default,,0,0,0,,Жауапсыз, әрқашан уақытша
Dialogue: 0,2:54:33.54,2:54:37.51,Default,,0,0,0,,Тек қауіпсіздерін таңдаңыз! Уф...
Dialogue: 0,2:54:37.51,2:54:39.65,Default,,0,0,0,,Тіпті Teiai де кіреді.
Dialogue: 0,2:54:39.65,2:54:43.92,Default,,0,0,0,,Мен осы уақытқа дейін жұмыс істеп келемін.
Dialogue: 0,2:54:43.92,2:54:47.62,Default,,0,0,0,,Нәтиже - осы ағымдағы дәреже.
Dialogue: 0,2:54:47.62,2:54:50.72,Default,,0,0,0,,Мен басқалардан жоғары тұратын адам емеспін.
Dialogue: 0,2:54:52.96,2:54:56.50,Default,,0,0,0,,Жоқ, бірақ мен үшін
Dialogue: 0,2:54:56.50,2:55:00.20,Default,,0,0,0,,Басшы болуды маған сеніп тапсырды.
Dialogue: 0,2:55:00.20,2:55:02.84,Default,,0,0,0,,Тонегава мырза!
Dialogue: 0,2:55:02.84,2:55:07.74,Default,,0,0,0,,Өтінемін, орындауға рұқсат етіңіз! Ах!
Dialogue: 0,2:55:07.74,2:55:10.88,Default,,0,0,0,,Мен жауап бергім келеді, ха.
Dialogue: 0,2:55:10.88,2:55:14.85,Default,,0,0,0,,Мен бұл жерден бас тартсам, мен ешқашан қолымнан келмейді
Dialogue: 0,2:55:14.85,2:55:17.69,Default,,0,0,0,,Мен өзімді сүйе алмаймын!
Dialogue: 0,2:55:17.69,2:55:19.69,Default,,0,0,0,,Ах...
Dialogue: 0,2:55:29.03,2:55:33.24,Default,,0,0,0,,А... Менің демалуға уақытым жоқ.
Dialogue: 0,2:55:33.24,2:55:37.07,Default,,0,0,0,,А... а... Гонда мырза, қараңызшы.
Dialogue: 0,2:55:37.07,2:55:39.24,Default,,0,0,0,,Аа, Гонда мырзаға рахмет
Dialogue: 0,2:55:39.24,2:55:41.31,Default,,0,0,0,,Орындалды!
Dialogue: 0,2:55:41.31,2:55:43.48,Default,,0,0,0,,Жын қапшығы
Dialogue: 0,2:55:43.48,2:55:46.15,Default,,0,0,0,,Додошита-кун
Dialogue: 0,2:55:46.15,2:55:50.75,Default,,0,0,0,,Тонегава-сенсей қайтып келгенше, мен сізге сенемін, Көшбасшы.
Dialogue: 0,2:55:50.75,2:55:53.82,Default,,0,0,0,,Көшбасшы? Дұрыс, лидер
Dialogue: 0,2:55:53.82,2:55:56.66,Default,,0,0,0,,Мен өзімді жақсы сезінбеймін деп тұрған жоқпын.
Dialogue: 0,2:55:56.66,2:55:59.13,Default,,0,0,0,,Әлі де көп нәрсе істеу керек.
Dialogue: 0,2:55:59.13,2:56:02.73,Default,,0,0,0,,Профессор Тонегава қайтып келгенде, оны таң қалдырайық.
Dialogue: 0,2:56:02.73,2:56:05.17,Default,,0,0,0,,Мен оны міндетті түрде қарап шығамын.
Dialogue: 0,2:56:05.17,2:56:08.77,Default,,0,0,0,,Мен оны Гонда мырзаға қалдырғаныма қуаныштымын.
Dialogue: 0,2:56:08.77,2:56:12.11,Default,,0,0,0,,Барлығына! Гонда мырза қазір
Dialogue: 0,2:56:12.11,2:56:14.64,Default,,0,0,0,,Бұл өте жақсы
Dialogue: 0,2:56:14.64,2:56:16.81,Default,,0,0,0,,А... а...
Dialogue: 0,2:56:16.81,2:56:20.58,Default,,0,0,0,,Жарайды, жасайық! о!
Dialogue: 0,2:56:20.58,2:56:24.35,Default,,0,0,0,,Эмоцияны тарату, мотивацияны тарату
Dialogue: 0,2:56:24.35,2:56:29.49,Default,,0,0,0,,Гонда командасы бірігіңіз!
Dialogue: 0,2:56:29.49,2:56:31.49,Default,,0,0,0,,2 күннен кейін
Dialogue: 0,2:56:33.56,2:56:37.27,Default,,0,0,0,,Тонегаваға оралу
Dialogue: 0,2:56:37.27,2:56:42.34,Default,,0,0,0,,Гонда: Әдетте ол көшбасшы емес.
Dialogue: 0,2:56:42.34,2:56:45.07,Default,,0,0,0,,Мен оны оған қалдыруға батылым бардым.
Dialogue: 0,2:56:45.07,2:56:48.54,Default,,0,0,0,,Өзінің жауапкершілігін алу арқылы
Dialogue: 0,2:56:48.54,2:56:52.72,Default,,0,0,0,,Үстінде сенімсіз болып көрінетін адаммен,
Dialogue: 0,2:56:52.72,2:56:55.49,Default,,0,0,0,,Басқалар да өзгеруі керек еді.
Dialogue: 0,2:56:55.49,2:56:59.29,Default,,0,0,0,,Нұсқау күтетін адам болудан бас тарту керек.
Dialogue: 0,2:57:02.09,2:57:04.76,Default,,0,0,0,,Қайырлы таң... Иә?
Dialogue: 0,2:57:04.76,2:57:07.90,Default,,0,0,0,,эпидемиялық пандемия
Dialogue: 0,2:57:07.90,2:57:10.60,Default,,0,0,0,,Таратылды
Dialogue: 0,2:57:10.60,2:57:13.04,Default,,0,0,0,,Балалар сендерге не болды!
Dialogue: 0,2:57:13.04,2:57:16.17,Default,,0,0,0,,Ух... Тонегава мырза
Dialogue: 0,2:57:16.17,2:57:18.37,Default,,0,0,0,,Мен жасадым...
Dialogue: 0,2:57:18.37,2:57:21.11,Default,,0,0,0,,Гонданың энтузиазмы мен вирусы
Dialogue: 0,2:57:21.11,2:57:24.48,Default,,0,0,0,,Аһ!
Dialogue: 0,2:57:24.48,2:57:27.75,Default,,0,0,0,,Бұл сіздің бастығыңыз, төрағамен орындалады.
Dialogue: 0,2:57:27.75,2:57:32.06,Default,,0,0,0,,Қара киіммен қарамағындағылар арасында күресу
Dialogue: 0,2:57:32.06,2:57:34.82,Default,,0,0,0,,Бұл бір адамның әңгімесі.
Dialogue: 0,2:57:34.82,2:57:39.52,Default,,0,0,0,,Юкио Тонегава орта менеджері
Dialogue: 0,2:59:14.56,2:59:16.76,Default,,0,0,0,,Келесі жолы «Асшаяндар»
Dialogue: 0,3:02:10.63,3:02:13.93,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз, бұл қуырылған асшаяндар жиынтығы.
Dialogue: 0,3:02:16.21,3:02:20.81,Default,,0,0,0,,-де? Сізбен хабарласқаныма көп болды деп ойладым.
Dialogue: 0,3:02:20.81,3:02:24.11,Default,,0,0,0,,Бүркітті мұндай жерге шақырудағы мақсат қандай?
Dialogue: 0,3:02:24.11,3:02:26.12,Default,,0,0,0,,Ебия
Dialogue: 0,3:02:26.12,3:02:28.45,Default,,0,0,0,,Бұл адам Эбитани
Dialogue: 0,3:02:28.45,3:02:31.52,Default,,0,0,0,,Мен өз қателіктерім үшін Тейайдан жұмыстан шығарылдым.
Dialogue: 0,3:02:31.52,3:02:35.09,Default,,0,0,0,,Тонегаваның бұрынғы ядролық оқтұмсығы
Dialogue: 0,3:02:35.09,3:02:38.43,Default,,0,0,0,,Уф, жұмыстан босатылдың!
Dialogue: 0,3:02:38.43,3:02:41.60,Default,,0,0,0,,Иә? Эбитани бір оқпен атылды
Dialogue: 0,3:02:41.60,3:02:44.00,Default,,0,0,0,,Уф, жалақының төмендеуі!
Dialogue: 0,3:02:44.00,3:02:47.74,Default,,0,0,0,,Гах! Тон өзені ауыстырылған зеңбірекпен тікелей соққыға ұшырады
Dialogue: 0,3:02:47.74,3:02:50.81,Default,,0,0,0,,Батып кету
Dialogue: 0,3:02:50.81,3:02:53.81,Default,,0,0,0,,Енді екеуміз қайта кездесеміз
Dialogue: 0,3:02:53.81,3:02:58.51,Default,,0,0,0,,Тонегаваға не айтқыңыз келеді? Эбитани
Dialogue: 0,3:03:01.75,3:03:08.19,Default,,0,0,0,,Teiai Group алып компаниясының №2 Юкио Тонегава
Dialogue: 0,3:03:08.19,3:03:11.53,Default,,0,0,0,,Саяси және іскерлік әлемді басқаратын құбыжық, Төраға Хиодо.
Dialogue: 0,3:03:11.53,3:03:16.47,Default,,0,0,0,,Оң қол дәрежесіне көтерілген ашулы адам.
Dialogue: 0,3:03:16.47,3:03:19.60,Default,,0,0,0,,Бұл оның барлық аңызының және даңқының астарында жатыр
Dialogue: 0,3:03:19.60,3:03:24.54,Default,,0,0,0,,Мен орта буын менеджері ретінде жасырын түрде қиналып, күресемін
Dialogue: 0,3:03:24.54,3:03:31.54,Default,,0,0,0,,Ұлы адамның шағын, шағын әңгімесі.
Dialogue: 0,3:05:16.95,3:05:21.19,Default,,0,0,0,,Сонымен... бұл жолы рас.
Dialogue: 0,3:05:21.19,3:05:23.19,Default,,0,0,0,,Қарсы неге? Бүгін таңертең сен жақсылап көмектесіп жүрдің ғой, иә?
Dialogue: 0,3:05:26.03,3:05:29.50,Default,,0,0,0,,Төрағаның оқиғасы үшін тікелей кешірім сұрағым келді.
Dialogue: 0,3:05:29.50,3:05:31.87,Default,,0,0,0,,Шын жүректен кешірім сұраймын.
Dialogue: 0,3:05:31.87,3:05:34.04,Default,,0,0,0,,Өтірікші! Ах
Dialogue: 0,3:05:34.04,3:05:39.31,Default,,0,0,0,,Егер сіз шынымен солай ойласаңыз, люкс парфей сұраңыз.
Dialogue: 0,3:05:39.31,3:05:41.81,Default,,0,0,0,,Кофе желеін беріңіз
Dialogue: 0,3:05:43.91,3:05:47.05,Default,,0,0,0,,Мен... Бұл жігітті кешіріңіз.
Dialogue: 0,3:05:47.05,3:05:50.85,Default,,0,0,0,,Кешірім сұрау ниеті жоқ
Dialogue: 0,3:05:50.85,3:05:55.26,Default,,0,0,0,,Сізге ұнаса, маған керегі жоқ! Қасықты қойыңыз!
Dialogue: 0,3:05:55.26,3:05:59.73,Default,,0,0,0,,Біріншіден, сіз кешірім сұрасаңыз да, мен сіздің жалақыңызды азайтуды тоқтата алмаймын.
Dialogue: 0,3:05:59.73,3:06:02.53,Default,,0,0,0,,А... әзірге.
Dialogue: 0,3:06:02.53,3:06:05.13,Default,,0,0,0,,Мен бұл парфет үшін төлеймін.
Dialogue: 0,3:06:05.13,3:06:10.13,Default,,0,0,0,,Тиісті түрде кешірім сұрауға ниетіңіз болса, қайта оралыңыз.
Dialogue: 0,3:06:19.55,3:06:21.55,Default,,0,0,0,,Бірнеше күннен кейін
Dialogue: 0,3:06:24.65,3:06:26.86,Default,,0,0,0,,Тонегава мырза! Хехе
Dialogue: 0,3:06:26.86,3:06:29.46,Default,,0,0,0,,Эбитани қайтадан
Dialogue: 0,3:06:29.46,3:06:33.13,Default,,0,0,0,,Цк, сен мені мұндай жерге не шақырып тұрсың?
Dialogue: 0,3:06:33.13,3:06:37.70,Default,,0,0,0,,Хехехе Бүгін мен сізге кешірім сұраймын.
Dialogue: 0,3:06:37.70,3:06:40.50,Default,,0,0,0,,Сөзбен емес, іспен
Dialogue: 0,3:06:40.50,3:06:44.37,Default,,0,0,0,,Доктор Тонегава менің кесірімнен қолайсыз жағдайға тап болса да.
Dialogue: 0,3:06:44.37,3:06:48.91,Default,,0,0,0,,Жалақының қысқаруын өтеуге жететін үлкен сома.
Dialogue: 0,3:06:48.91,3:06:52.88,Default,,0,0,0,,Сіз алуға болатын әңгіме бар.
Dialogue: 0,3:06:52.88,3:06:55.22,Default,,0,0,0,,Хе хехе
Dialogue: 0,3:06:55.22,3:06:58.25,Default,,0,0,0,,Осылай, маған еріңіз.
Dialogue: 0,3:06:58.25,3:07:02.12,Default,,0,0,0,,Күндеріңіз қызықты өтіп жатыр ма?
Dialogue: 0,3:07:02.12,3:07:04.53,Default,,0,0,0,,Басқалар сияқты өмір сүр
Dialogue: 0,3:07:04.53,3:07:08.06,Default,,0,0,0,,Сіз бәрі бұрынғыдай жақсы ма деп ойлайсыз ба?
Dialogue: 0,3:07:08.06,3:07:12.10,Default,,0,0,0,,Тіпті сіздердің де жетістікке жете аласыздар!
Dialogue: 0,3:07:12.10,3:07:16.01,Default,,0,0,0,,Иә, сізде табысқа жетуге мүмкіндік бар.
Dialogue: 0,3:07:16.01,3:07:20.38,Default,,0,0,0,,Сіз жұмыссыз болсаңыз да, жоқ, өйткені сіз жұмыссызсыз.
Dialogue: 0,3:07:20.38,3:07:22.68,Default,,0,0,0,,Бұл арман емес!
Dialogue: 0,3:07:22.68,3:07:27.02,Default,,0,0,0,,Мен осы лосьонды таныстарыма сату арқылы айына 1 миллион иенден астам табыс таба аламын.
Dialogue: 0,3:07:27.02,3:07:31.02,Default,,0,0,0,,Жоқ, жоқ, 2 миллион мүмкін емес!
Dialogue: 0,3:07:31.02,3:07:34.62,Default,,0,0,0,,Бұған қалай қарасаңыз да...
Dialogue: 0,3:07:36.69,3:07:39.56,Default,,0,0,0,,Көпжақты жұмысқа қабылдау семинары!
Dialogue: 0,3:07:39.56,3:07:42.73,Default,,0,0,0,,Хехе, сен қалай ойлайсың? Тонегава мырза
Dialogue: 0,3:07:42.73,3:07:45.03,Default,,0,0,0,,Бұл революциялық бизнес үлгісі
Dialogue: 0,3:07:45.03,3:07:49.17,Default,,0,0,0,,Қарғыс атсын бұл жігіт, тіпті мен Тейайдың басшысы болсам да.
Dialogue: 0,3:07:49.17,3:07:52.78,Default,,0,0,0,,Мені қандай жерге тартқың келеді?
Dialogue: 0,3:07:52.78,3:07:56.88,Default,,0,0,0,,MLM деп аталатын құбыжық мұхитта ұя салады
Dialogue: 0,3:07:59.48,3:08:03.85,Default,,0,0,0,,Эбитани бірде Тон өзенінің алдында тірі рух ретінде пайда болды
Dialogue: 0,3:08:03.85,3:08:07.66,Default,,0,0,0,,Бұл жолы өлі рух ретінде Тон өзенін Чими Мурьюға әкеліңіз.
Dialogue: 0,3:08:07.66,3:08:09.66,Default,,0,0,0,,Сіз маған қоңырау шалып тұрсыз ба?
Dialogue: 0,3:08:09.66,3:08:12.39,Default,,0,0,0,,Тск, құтқарылмайтын ақымақ
Dialogue: 0,3:08:12.39,3:08:15.76,Default,,0,0,0,,Мен өз үмітімде қателестім.
Dialogue: 0,3:08:15.76,3:08:18.23,Default,,0,0,0,,О? Мен үйге бара жатырмын.
Dialogue: 0,3:08:18.23,3:08:21.10,Default,,0,0,0,,Ей, үйге неге бара жатырсың?
Dialogue: 0,3:08:21.10,3:08:24.27,Default,,0,0,0,,Әрине, кел, сен де!
Dialogue: 0,3:08:24.27,3:08:27.38,Default,,0,0,0,,Десе де Тон өзені Эбиданиді тастамайды
Dialogue: 0,3:08:27.38,3:08:30.71,Default,,0,0,0,,Жомарттық, жанашырлық
Dialogue: 0,3:08:30.71,3:08:34.15,Default,,0,0,0,,О? Бұл екеуіне не болды?
Dialogue: 0,3:08:34.15,3:08:39.12,Default,,0,0,0,,Не болса да, мен үйге барамын.
Dialogue: 0,3:08:39.12,3:08:42.12,Default,,0,0,0,,Не? Неге үйге барасың?
Dialogue: 0,3:08:42.12,3:08:47.03,Default,,0,0,0,,Түсіндің бе? Енді үйге бару қашу дегенді білдіреді.
Dialogue: 0,3:08:47.03,3:08:49.20,Default,,0,0,0,,Үлкен балық
Dialogue: 0,3:08:49.20,3:08:51.63,Default,,0,0,0,,Дұрыс, профессор Тонегава.
Dialogue: 0,3:08:51.63,3:08:55.30,Default,,0,0,0,,Көңіл көтеруге және ақша табуға болатын мұндай оқиға сирек кездеседі.
Dialogue: 0,3:08:55.30,3:08:58.87,Default,,0,0,0,,Идиот! Осындай тәтті әңгіме бар ма?
Dialogue: 0,3:08:58.87,3:09:01.84,Default,,0,0,0,,Иә?
Dialogue: 0,3:09:01.84,3:09:04.61,Default,,0,0,0,,Ең алдымен күш салмай
Dialogue: 0,3:09:04.61,3:09:07.75,Default,,0,0,0,,Басынан бастап көңіл көтеріп, көп ақша табуға тырысыңыз
Dialogue: 0,3:09:07.75,3:09:10.49,Default,,0,0,0,,Үлкен қате
Dialogue: 0,3:09:10.49,3:09:15.46,Default,,0,0,0,,Ай сайынғы табысы 1 миллион иен болатын дарынды адам ынтамен жұмыс істейді.
Dialogue: 0,3:09:15.46,3:09:19.80,Default,,0,0,0,,Қайталанатын күш-жігердің нәтижесінде ақыры оған жеттік.
Dialogue: 0,3:09:19.80,3:09:23.60,Default,,0,0,0,,Ахаха…
Dialogue: 0,3:09:23.60,3:09:27.70,Default,,0,0,0,,Не болды? Сіз мұны естідіңіз бе? Барлығы
Dialogue: 0,3:09:27.70,3:09:31.61,Default,,0,0,0,,Қазіргі заманда бұл кісі тынымсыз еңбек етеді.
Dialogue: 0,3:09:31.61,3:09:36.25,Default,,0,0,0,,Не деген көне, түсініксіз қария.
Dialogue: 0,3:09:36.25,3:09:39.62,Default,,0,0,0,,Тым ескі идея
Dialogue: 0,3:09:39.62,3:09:42.28,Default,,0,0,0,,Толқынның балқыған қазаны
Dialogue: 0,3:09:42.28,3:09:46.19,Default,,0,0,0,,Жұмысқа қабылдау бойынша семинарлардың үлкен толқыны
Dialogue: 0,3:09:46.19,3:09:48.82,Default,,0,0,0,,Бұл жігіттердің бәрі үшін кеш.
Dialogue: 0,3:09:48.82,3:09:53.46,Default,,0,0,0,,Қайтып келмейтін жерге дейін
Dialogue: 0,3:09:53.46,3:09:56.33,Default,,0,0,0,,Саңырауларды мазақ ету
Dialogue: 0,3:09:56.33,3:10:00.14,Default,,0,0,0,,Тонегава аяқталды
Dialogue: 0,3:10:00.14,3:10:02.81,Default,,0,0,0,,А... шынымен емес.
Dialogue: 0,3:10:02.81,3:10:07.94,Default,,0,0,0,,Сіз қалай ақша тапсаңыз да, соның салдарынан қандай азап тартсаңыз да.
Dialogue: 0,3:10:07.94,3:10:10.95,Default,,0,0,0,,Бұл мен үшін маңызды емес
Dialogue: 0,3:10:10.95,3:10:13.55,Default,,0,0,0,,Бірақ бұл ақымақ әлі де бар
Dialogue: 0,3:10:13.55,3:10:16.25,Default,,0,0,0,,Мен сізге кешірім сұраймын, иә?
Dialogue: 0,3:10:16.25,3:10:20.16,Default,,0,0,0,,Бұл көп ойыншыны жасамаңыз, дұрыс әрекет етіңіз!
Dialogue: 0,3:10:20.16,3:10:24.36,Default,,0,0,0,,Ха! Шынында да аян, Тон өзенінің шабыты
Dialogue: 0,3:10:24.36,3:10:26.66,Default,,0,0,0,,Эбиданидегі жаңғырық дауыс
Dialogue: 0,3:10:26.66,3:10:30.86,Default,,0,0,0,,Оқырман, былайша айтқанда.
Dialogue: 0,3:10:34.77,3:10:38.47,Default,,0,0,0,,Пуу Ахаха Ахахха!
Dialogue: 0,3:10:41.58,3:10:44.35,Default,,0,0,0,,Хмф, күліп жүр.
Dialogue: 0,3:10:44.35,3:10:46.55,Default,,0,0,0,,Ебитаниге барайық
Dialogue: 0,3:10:49.15,3:10:52.96,Default,,0,0,0,,Ал... Доктор Тонегава О?
Dialogue: 0,3:10:52.96,3:10:56.96,Default,,0,0,0,,Бұл көп ойыншы бизнесі емес, бұл желілік бизнес.
Dialogue: 0,3:10:56.96,3:11:00.83,Default,,0,0,0,,Тон өзеніне соққы жүгіру
Dialogue: 0,3:11:00.83,3:11:04.33,Default,,0,0,0,,Мынау... мынау да толы
Dialogue: 0,3:11:04.33,3:11:07.30,Default,,0,0,0,,Қазірдің өзінде қайтып келмейтін нүктеге дейін
Dialogue: 0,3:11:07.30,3:11:11.47,Default,,0,0,0,,Өкінішті Эбитани Өлі рухқа ұқсайды
Dialogue: 0,3:11:11.47,3:11:13.74,Default,,0,0,0,,Мен мұны шындап айтып отырмын.
Dialogue: 0,3:11:13.74,3:11:19.75,Default,,0,0,0,,Мені ескі идеялары бар ақымақ қарт деп ойлаңыз.
Dialogue: 0,3:11:19.75,3:11:25.45,Default,,0,0,0,,Тонегава Эбитаниді сендіре алмай, өкінішпен үйіне қайтады
Dialogue: 0,3:11:31.49,3:11:34.50,Default,,0,0,0,,(ﾉｯｸ)
Dialogue: 0,3:11:34.50,3:11:39.10,Default,,0,0,0,,Кешіріңіз, Тонегава мырза. Иә.
Dialogue: 0,3:11:39.10,3:11:43.40,Default,,0,0,0,,Бұл Эбитанидің хаты. иә? Бұл Эбитани ме?
Dialogue: 0,3:11:46.74,3:11:49.34,Default,,0,0,0,,Құрметті Тонегава мырза
Dialogue: 0,3:11:49.34,3:11:52.11,Default,,0,0,0,,Өткен күн үшін көп рахмет.
Dialogue: 0,3:11:52.11,3:11:54.92,Default,,0,0,0,,Одан кейін жағдайыңыз қалай?
Dialogue: 0,3:11:54.92,3:11:59.32,Default,,0,0,0,,Соңында мен бұл кәсіпті тастадым.
Dialogue: 0,3:11:59.32,3:12:01.32,Default,,0,0,0,,Хо
Dialogue: 0,3:12:01.32,3:12:04.43,Default,,0,0,0,,Профессор Тонегаваның айтқанын есіңе түсір.
Dialogue: 0,3:12:04.43,3:12:08.16,Default,,0,0,0,,Мен енді ғана ояндым.
Dialogue: 0,3:12:08.16,3:12:11.77,Default,,0,0,0,,Сен сол ақымақты шынымен байқадың ба?
Dialogue: 0,3:12:11.77,3:12:16.51,Default,,0,0,0,,Осы топқа «Зиянды коммерциялық операциялар туралы» заңды бұзды деген айып тағылды.
Dialogue: 0,3:12:16.51,3:12:21.21,Default,,0,0,0,,Бізді дөңгелетіп тастадық хехехе қара.
Dialogue: 0,3:12:21.21,3:12:24.18,Default,,0,0,0,,Профессор Тонегава айтқандай.
Dialogue: 0,3:12:24.18,3:12:27.22,Default,,0,0,0,,Бұл зиянды көп топ болған сияқты.
Dialogue: 0,3:12:27.22,3:12:29.35,Default,,0,0,0,,Егер Тонегава мырза мұнымен жақсы болса.
Dialogue: 0,3:12:29.35,3:12:33.72,Default,,0,0,0,,Тағы да шын жүректен кешірім сұрауыма рұқсат етіңіз.
Dialogue: 0,3:12:33.72,3:12:37.33,Default,,0,0,0,,Қосуға қамаудағы Эбитаниден
Dialogue: 0,3:12:37.33,3:12:42.97,Default,,0,0,0,,Уа, ақымақ! Тым кеш, оянатын кез келді
Dialogue: 0,3:12:42.97,3:12:45.77,Default,,0,0,0,,Эбитани Онава
Dialogue: 0,3:12:48.14,3:12:51.14,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,3:13:01.85,3:13:05.05,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз, бұл қуырылған асшаяндар жиынтығы.
Dialogue: 0,3:13:07.89,3:13:10.36,Default,,0,0,0,,Бірақ бұл жақсы болды.
Dialogue: 0,3:13:10.36,3:13:13.43,Default,,0,0,0,,Ебитани айыпсыз тергеу изоляторынан босатылды
Dialogue: 0,3:13:13.43,3:13:16.73,Default,,0,0,0,,Иә Митаби Эбитани
Dialogue: 0,3:13:16.73,3:13:20.40,Default,,0,0,0,,Бұл бөлім мені қатты мазалады.
Dialogue: 0,3:13:20.40,3:13:24.44,Default,,0,0,0,,Дәл осы уақыт қанша?
Dialogue: 0,3:13:24.44,3:13:27.54,Default,,0,0,0,,Айтайын, бұл өткен жолғыдай емес...
Dialogue: 0,3:13:27.54,3:13:31.31,Default,,0,0,0,,Білемін, тура сөзге көшейін.
Dialogue: 0,3:13:31.31,3:13:34.28,Default,,0,0,0,,Бұл жолы, Тонегава мырза
Dialogue: 0,3:13:34.28,3:13:37.89,Default,,0,0,0,,Мен сенен жұмыстан кетуіңді өтінуге келдім, Теяй.
Dialogue: 0,3:13:37.89,3:13:41.79,Default,,0,0,0,,Соңғы кезде мен осыған қатты қызығып жүрмін, білесің бе~
Dialogue: 0,3:13:41.79,3:13:45.29,Default,,0,0,0,,Не болды? Жоқ, жалғастыр
Dialogue: 0,3:13:45.29,3:13:50.60,Default,,0,0,0,,Иә, мен тергеу изоляторында кездескен Инуэ есімді адамнан сұрадым.
Dialogue: 0,3:13:50.60,3:13:55.90,Default,,0,0,0,,Иә, Эбитани-хан, Teiai сияқты зиянды қаржы бизнестері қазір
Dialogue: 0,3:13:55.90,3:13:57.91,Default,,0,0,0,,Төмендеу тенденциясы
Dialogue: 0,3:13:57.91,3:14:00.81,Default,,0,0,0,,Эбитани-хан жұмыстан қуылған бақытына ие.
Dialogue: 0,3:14:00.81,3:14:03.88,Default,,0,0,0,,Бұдан былай менде бір ғана идея болады
Dialogue: 0,3:14:03.88,3:14:07.68,Default,,0,0,0,,Үйге жүгіру арқылы басқаларды жеңетін уақыт келді.
Dialogue: 0,3:14:09.69,3:14:15.26,Default,,0,0,0,,Үйге жүгіру? Иә, мен мұны естігеннен кейін осындай ойға келдім.
Dialogue: 0,3:14:15.26,3:14:20.00,Default,,0,0,0,,Мұнда U... Бұл не?
Dialogue: 0,3:14:20.00,3:14:23.30,Default,,0,0,0,,Хехе, жоғары температурада қуырылған қытырлақ асшаян.
Dialogue: 0,3:14:23.30,3:14:26.13,Default,,0,0,0,,Толық матаға оралған
Dialogue: 0,3:14:26.13,3:14:31.27,Default,,0,0,0,,Оны Эбиролл деп атаңыз
Dialogue: 0,3:14:31.27,3:14:33.58,Default,,0,0,0,,Бакутан Эбирол
Dialogue: 0,3:14:33.58,3:14:38.71,Default,,0,0,0,,Асшаяндар орамы Асшаяндар орамы
Dialogue: 0,3:14:38.71,3:14:41.25,Default,,0,0,0,,Эбирол…
Dialogue: 0,3:14:41.25,3:14:44.55,Default,,0,0,0,,Біз Хараджукудағы 3000 жастан сұрадық
Dialogue: 0,3:14:44.55,3:14:47.19,Default,,0,0,0,,«Сіз асшаяндарды ұнатасыз ба?»
Dialogue: 0,3:14:47.19,3:14:51.36,Default,,0,0,0,,Иә немесе жоқ...
Dialogue: 0,3:14:51.36,3:14:54.93,Default,,0,0,0,,Сонда таңқаларлық, адамдардың 90%-дан астамы
Dialogue: 0,3:14:54.93,3:14:57.53,Default,,0,0,0,,Мен асшаяндарды жақсы көремін.
Dialogue: 0,3:14:57.53,3:15:00.80,Default,,0,0,0,,Келу: бұрын-соңды болмаған асшаяндардың бумы
Dialogue: 0,3:15:00.80,3:15:06.04,Default,,0,0,0,,Бір минут күте тұрыңыз, мүмкін сіз бе?
Dialogue: 0,3:15:06.04,3:15:09.14,Default,,0,0,0,,Сіз оны шығарып алмақшысыз ба? бүркіт
Dialogue: 0,3:15:09.14,3:15:12.38,Default,,0,0,0,,Хехехе Керемет жауап
Dialogue: 0,3:15:12.38,3:15:17.39,Default,,0,0,0,,Менің идеяларым мен Тонегава мырзаның қаражатынан бастайық.
Dialogue: 0,3:15:17.39,3:15:19.39,Default,,0,0,0,,Ebi орамы
Dialogue: 0,3:15:22.09,3:15:26.33,Default,,0,0,0,,Жарқыраған күн, шарықтаған үлкен толқындар
Dialogue: 0,3:15:26.33,3:15:30.17,Default,,0,0,0,,Енді асшаяндардың құйынын қоздыратын уақыт
Dialogue: 0,3:15:30.17,3:15:33.60,Default,,0,0,0,,Асшаяндар орамы Асшаяндар орамы
Dialogue: 0,3:15:33.60,3:15:38.67,Default,,0,0,0,,Эбигору!
Dialogue: 0,3:15:38.67,3:15:42.67,Default,,0,0,0,,Тонегава нормадан асып кеткен соққыға байланысты тілсіз қалды
Dialogue: 0,3:15:44.91,3:15:48.98,Default,,0,0,0,,Сізге қалай ұнайды? ақымақ! Бұндай ақымақтық бар ма?
Dialogue: 0,3:15:48.98,3:15:52.35,Default,,0,0,0,,Біріншіден, адамдардың көпшілігі асшаяндарды жақсы көреді.
Dialogue: 0,3:15:52.35,3:15:55.19,Default,,0,0,0,,О, мүмкін Тонегава мырзаның да асшаяндары бар шығар?
Dialogue: 0,3:15:55.19,3:15:58.33,Default,,0,0,0,,Идиот! Мен сізге дұрыс емес нәрсені сұрап жатқаныңызды айтып отырмын.
Dialogue: 0,3:15:58.33,3:16:02.26,Default,,0,0,0,,Кім мұндайды жейді? Жоқ, жоқ, алдымен оны жеп қойыңыз.
Dialogue: 0,3:16:02.26,3:16:05.23,Default,,0,0,0,,Жаңадан жасалғанын шешіңіз
Dialogue: 0,3:16:05.23,3:16:10.41,Default,,0,0,0,,Жылу мөлшеріне байланысты Эбитани
Dialogue: 0,3:16:10.41,3:16:14.88,Default,,0,0,0,,Ал келесі күні Teiai арнайы асхана бөлмесі
Dialogue: 0,3:16:14.88,3:16:17.88,Default,,0,0,0,,Йомоя асшаяндарының орамынан дәм тату шарасы
Dialogue: 0,3:16:20.55,3:16:25.12,Default,,0,0,0,,Хехехе, бәрі, көп болды. Бұл Эбитани.
Dialogue: 0,3:16:25.12,3:16:28.72,Default,,0,0,0,,Профессор Тонегавадан естіген шығарсыз.
Dialogue: 0,3:16:28.72,3:16:33.93,Default,,0,0,0,,Бұл жолы мен асшаяндарды қолданып мүлдем жаңа тағам ойлап таптым.
Dialogue: 0,3:16:33.93,3:16:37.07,Default,,0,0,0,,Барлығына Эбиролл туралы хабарлау
Dialogue: 0,3:16:37.07,3:16:39.43,Default,,0,0,0,,Осы орынды орнатқаныңыз үшін рахмет.
Dialogue: 0,3:16:39.43,3:16:43.67,Default,,0,0,0,,Tsk, сіздің ынтаңыз әдеттегідей жоғары деңгейде.
Dialogue: 0,3:16:43.67,3:16:49.38,Default,,0,0,0,,Ол өзін жайсыз сезінбейді ме? Мен жұмыстан шығарылғаннан кейін Теяйге келдім.
Dialogue: 0,3:16:49.38,3:16:52.55,Default,,0,0,0,,Ебитани сияқты...
Dialogue: 0,3:16:52.55,3:16:55.55,Default,,0,0,0,,Иә, мұндағылардың бәрі, бірінші кезекте И
Dialogue: 0,3:16:55.55,3:17:00.12,Default,,0,0,0,,Асшаяндарды орам жасауды шешкеніңіздің 15 себебі қандай?
Dialogue: 0,3:17:00.12,3:17:02.92,Default,,0,0,0,,Мұны білгеніңізді қалаймын.
Dialogue: 0,3:17:02.92,3:17:06.06,Default,,0,0,0,,Құжаттамаңызды қараңыз
Dialogue: 0,3:17:06.06,3:17:08.60,Default,,0,0,0,,Ең алдымен... кіріспе жақсы.
Dialogue: 0,3:17:08.60,3:17:11.63,Default,,0,0,0,,Тез дайындаңыз, өйткені бәрі аш.
Dialogue: 0,3:17:11.63,3:17:14.63,Default,,0,0,0,,Мен түсінемін, егер солай болса.
Dialogue: 0,3:17:17.11,3:17:20.34,Default,,0,0,0,,Ал мынау мына тайфунның көзі
Dialogue: 0,3:17:20.34,3:17:24.05,Default,,0,0,0,,Сәнді ингредиенттер Қызыл асшаян
Dialogue: 0,3:17:24.05,3:17:26.78,Default,,0,0,0,,Біреуін сатып алсаңыз, оның құны 8000 иенден асады.
Dialogue: 0,3:17:26.78,3:17:30.42,Default,,0,0,0,,Люкс ингредиенттері Қызыл омар
Dialogue: 0,3:17:30.42,3:17:33.72,Default,,0,0,0,,Пісіру уақытын бастайық
Dialogue: 0,3:17:39.19,3:17:44.77,Default,,0,0,0,,Ал 180 градус майдағы жоғары сапалы қызыл шаян.
Dialogue: 0,3:17:44.77,3:17:47.60,Default,,0,0,0,,Сол күйінде енгізілген
Dialogue: 0,3:17:47.60,3:17:51.01,Default,,0,0,0,,Уау, бұл ыстық! ыстық!
Dialogue: 0,3:17:51.01,3:17:54.34,Default,,0,0,0,,Жақсы қуырылған кезде
Dialogue: 0,3:17:54.34,3:17:57.98,Default,,0,0,0,,Күн шуақты салат жапырақтарында жаңа піскен
Dialogue: 0,3:17:57.98,3:18:00.55,Default,,0,0,0,,Татар соусын себіңіз
Dialogue: 0,3:18:00.55,3:18:03.79,Default,,0,0,0,,Бұл әрі қарай жүгері мен бидаймен араластырылды.
Dialogue: 0,3:18:03.79,3:18:07.52,Default,,0,0,0,,Бірегей мұқабамен толықтырылған
Dialogue: 0,3:18:07.52,3:18:10.33,Default,,0,0,0,,Бұл асшаяндардың орамы!
Dialogue: 0,3:18:10.33,3:18:12.33,Default,,0,0,0,,У… Уу…
Dialogue: 0,3:18:15.90,3:18:20.00,Default,,0,0,0,,Өтінемін... иә...
Dialogue: 0,3:18:20.00,3:18:22.57,Default,,0,0,0,,Кәне, келіңдер, бәрің.
Dialogue: 0,3:18:22.57,3:18:24.81,Default,,0,0,0,,тартынбаңыз...
Dialogue: 0,3:18:24.81,3:18:27.81,Default,,0,0,0,,Қараңызшы, Кикучи мырза да.
Dialogue: 0,3:18:27.81,3:18:32.15,Default,,0,0,0,,Жүріңіз, кетіңізші, профессор Тонегава.
Dialogue: 0,3:18:32.15,3:18:34.15,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,3:18:41.22,3:18:45.22,Default,,0,0,0,,Хехе, саған қалай ұнады? менің асшаянды орамым
Dialogue: 0,3:18:47.30,3:18:49.76,Default,,0,0,0,,Хехе
Dialogue: 0,3:18:49.76,3:18:51.86,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,3:18:54.17,3:18:56.54,Default,,0,0,0,,Бұл шағып жатыр, иә?
Dialogue: 0,3:18:56.54,3:18:59.24,Default,,0,0,0,,Асшаяндардың тұтас шағуы Қауіпті
Dialogue: 0,3:18:59.24,3:19:02.68,Default,,0,0,0,,Шаян аузыма кептеліп, ауырады.
Dialogue: 0,3:19:02.68,3:19:06.15,Default,,0,0,0,,Бұл мені күлдіреді, Тонегава-сан.
Dialogue: 0,3:19:06.15,3:19:08.85,Default,,0,0,0,,Басқа пісіру әдісі жақсырақ емес пе?
Dialogue: 0,3:19:08.85,3:19:12.39,Default,,0,0,0,,Дұрыс, сашими, макарон және т.б.
Dialogue: 0,3:19:12.39,3:19:16.19,Default,,0,0,0,,Жоқ, жоқ, бұл дұрыс емес, солай ма? Кавасаки мырза
Dialogue: 0,3:19:16.19,3:19:18.36,Default,,0,0,0,,Уф... Ямадзаки мырза
Dialogue: 0,3:19:18.36,3:19:21.30,Default,,0,0,0,,Ух... (кеміру дыбысы)
Dialogue: 0,3:19:21.30,3:19:23.30,Default,,0,0,0,,Иә?
Dialogue: 0,3:19:26.57,3:19:28.97,Default,,0,0,0,,Аа, Дошита мырза
Dialogue: 0,3:19:32.51,3:19:35.81,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,3:19:38.68,3:19:41.25,Default,,0,0,0,,Шешілген сияқты.
Dialogue: 0,3:19:41.25,3:19:44.49,Default,,0,0,0,,Қайнатылған шегіртке мен бақа ішегі
Dialogue: 0,3:19:44.49,3:19:47.89,Default,,0,0,0,,Дошита - ештеңе қалдырмай бәрін жейтін нашар жегіш.
Dialogue: 0,3:19:47.89,3:19:51.43,Default,,0,0,0,,Эбирол тамақ ретінде қараудан бас тартты
Dialogue: 0,3:19:51.43,3:19:54.50,Default,,0,0,0,,Уф, әрине мен де
Dialogue: 0,3:19:54.50,3:19:56.80,Default,,0,0,0,,Мен мұндай әңгімені сатып ала алмаймын.
Dialogue: 0,3:19:56.80,3:19:59.67,Default,,0,0,0,,Куу... Толық зақым
Dialogue: 0,3:19:59.67,3:20:03.34,Default,,0,0,0,,Ебияның өмірі нөл
Dialogue: 0,3:20:03.34,3:20:06.17,Default,,0,0,0,,Егер сіз жұмыстан шығарылсаңыз немесе бірдеңе болса, сәтсіздіктер жалғаса береді.
Dialogue: 0,3:20:06.17,3:20:09.71,Default,,0,0,0,,Мен мүмкіндігінше тезірек сауығып кетуге деген ұмтылысты түсінемін.
Dialogue: 0,3:20:09.71,3:20:13.31,Default,,0,0,0,,Бірақ бір оқтық кері қайтару және т.б.
Dialogue: 0,3:20:13.31,3:20:17.29,Default,,0,0,0,,Үйілгендер ғана соға алады. Жақын мақсатқа ұмтылмаңыз.
Dialogue: 0,3:20:17.29,3:20:20.22,Default,,0,0,0,,Шыдамсыз жеңіс жоқ.
Dialogue: 0,3:20:20.22,3:20:22.22,Default,,0,0,0,,Уф...
Dialogue: 0,3:20:25.16,3:20:27.86,Default,,0,0,0,,Мен оны сатып алдым, иә?
Dialogue: 0,3:20:27.86,3:20:30.90,Default,,0,0,0,,Мен мұны міндетті түрде жасай аламын деп ойладым.
Dialogue: 0,3:20:30.90,3:20:36.10,Default,,0,0,0,,200 кг мұздатылған лангустиндер
Dialogue: 0,3:20:36.10,3:20:38.97,Default,,0,0,0,,Иә?
Dialogue: 0,3:20:38.97,3:20:42.38,Default,,0,0,0,,Эбитани айқын абайсыздық
Dialogue: 0,3:20:42.38,3:20:44.91,Default,,0,0,0,,Идиот! Неге сонша!
Dialogue: 0,3:20:44.91,3:20:50.21,Default,,0,0,0,,Көбірек сатып алсаңыз, бірлік бағасы арзанырақ болады.
Dialogue: 0,3:20:52.65,3:20:56.06,Default,,0,0,0,,Біз не істейміз? Хмм...
Dialogue: 0,3:20:56.06,3:20:59.79,Default,,0,0,0,,Я...
Dialogue: 0,3:20:59.79,3:21:02.03,Default,,0,0,0,,Ha
Dialogue: 0,3:21:02.03,3:21:06.27,Default,,0,0,0,,Жақында мен асшаяндарды жегім келеді деп шештім.
Dialogue: 0,3:21:06.27,3:21:09.24,Default,,0,0,0,,Менің үйіме 30 000 иен жібер.
Dialogue: 0,3:21:09.24,3:21:14.71,Default,,0,0,0,,Уф, рахмет, Тонегава-сенсей!
Dialogue: 0,3:21:14.71,3:21:19.65,Default,,0,0,0,,Бұл дәмді, солай ма? Қызыл асшаяндардың мисо сорпасы
Dialogue: 0,3:21:19.65,3:21:24.09,Default,,0,0,0,,А, мен де алатын шығармын, құны 10 000 иен.
Dialogue: 0,3:21:24.09,3:21:27.66,Default,,0,0,0,,Гонда 20 000 иен Дошита 10 000 иен
Dialogue: 0,3:21:27.66,3:21:30.66,Default,,0,0,0,,Огино 10 000 иен Кавасаки 10 000 иен
Dialogue: 0,3:21:30.66,3:21:34.00,Default,,0,0,0,,Хагио 10 000 иен мен де 10 000 иен
Dialogue: 0,3:21:34.00,3:21:37.47,Default,,0,0,0,,Онда мен саған 10 000 иен беремін, ал Наката 5 000 иен береді.
Dialogue: 0,3:21:37.47,3:21:40.44,Default,,0,0,0,,Mi… барлығына
Dialogue: 0,3:21:40.44,3:21:43.27,Default,,0,0,0,,Рахмет!
Dialogue: 0,3:21:43.27,3:21:49.84,Default,,0,0,0,,Жанашырлықтың эмоционалдық шеңбері, Тонегава командасы арасындағы байланыс
Dialogue: 0,3:21:49.84,3:21:53.64,Default,,0,0,0,,Сатып алғаныңыз үшін рахмет!
Dialogue: 0,3:21:57.22,3:21:59.99,Default,,0,0,0,,(ﾉｯｸ)
Dialogue: 0,3:21:59.99,3:22:02.49,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,3:22:02.49,3:22:04.86,Default,,0,0,0,,Доктор Тонегава Иә.
Dialogue: 0,3:22:04.86,3:22:07.86,Default,,0,0,0,,Бұл Эбитанидің хаты. Не?
Dialogue: 0,3:22:11.07,3:22:13.64,Default,,0,0,0,,Құрметті Тонегава мырза
Dialogue: 0,3:22:13.64,3:22:16.91,Default,,0,0,0,,Өткен күн үшін көп рахмет.
Dialogue: 0,3:22:16.91,3:22:20.81,Default,,0,0,0,,Сол оқиғадан кейін мен біртүрлі батыл әрекет жасадым.
Dialogue: 0,3:22:20.81,3:22:24.88,Default,,0,0,0,,Мен өз кемшіліктерімді білдім, бұл нашар нәтижеге әкелді.
Dialogue: 0,3:22:24.88,3:22:28.78,Default,,0,0,0,,Хмф, кешігіп қалдың, ақымақ.
Dialogue: 0,3:22:28.78,3:22:30.85,Default,,0,0,0,,Ақылсыз I
Dialogue: 0,3:22:30.85,3:22:34.09,Default,,0,0,0,,Барлығының мұздатылған асшаяндарды сатып алғанын көру
Dialogue: 0,3:22:34.09,3:22:37.13,Default,,0,0,0,,Мен ақыры түсіндім
Dialogue: 0,3:22:37.13,3:22:40.80,Default,,0,0,0,,Асшаяндардың өзіндік сүйкімділігі Асшаяндардың жасырын күші
Dialogue: 0,3:22:40.80,3:22:44.20,Default,,0,0,0,,Не? Адам Эбитани
Dialogue: 0,3:22:44.20,3:22:47.07,Default,,0,0,0,,Бір тонна асшаян сатып алыңыз!
Dialogue: 0,3:22:47.07,3:22:49.64,Default,,0,0,0,,Уа! ақымақ! Қайтарыңыз
Dialogue: 0,3:22:49.64,3:22:51.71,Default,,0,0,0,,Отыз мың бүркіт!
Dialogue: 0,3:22:51.71,3:22:54.48,Default,,0,0,0,,Тон өзенінің асшаяндарының деформациясы
Dialogue: 0,3:22:54.48,3:22:59.21,Default,,0,0,0,,Сонда да бар күшіңді сал, Тонегава Берілме, Тонегава
Dialogue: 0,3:22:59.21,3:23:03.92,Default,,0,0,0,,Бұл бастық, төраға және оның қарамағындағылар, қара киім.
Dialogue: 0,3:23:03.92,3:23:07.56,Default,,0,0,0,,Кейде бұрынғы бағыныштылармен күреседі
Dialogue: 0,3:23:07.56,3:23:10.43,Default,,0,0,0,,Бұл бір адамның әңгімесі.
Dialogue: 0,3:23:10.43,3:23:14.73,Default,,0,0,0,,Юкио Тонегава ортаңғы менеджері
Dialogue: 0,3:24:50.12,3:24:52.32,Default,,0,0,0,,Келесі жолы «Катсу»
Dialogue: 0,3:24:53.82,3:24:59.82,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory