Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.74,0:00:12.74,Default,,0,0,0,,♪Жақын шайқас, бөлшектену♪
Dialogue: 0,0:00:13.27,0:00:18.01,Default,,0,0,0,,♪ Менің алдымда кім тұрсың? ♪
Dialogue: 0,0:00:24.55,0:00:27.26,Default,,0,0,0,,♪Қашуды жалғастыру мәңгілік емес♪
Dialogue: 0,0:00:27.56,0:00:30.33,Default,,0,0,0,,♪ Оны шын өмірде шайнап, жұтып қой ♪
Dialogue: 0,0:00:30.43,0:00:35.20,Default,,0,0,0,,♪Айғайлап, екіұштылықтан бас тарт♪
Dialogue: 0,0:00:35.53,0:00:38.13,Default,,0,0,0,,♪Көлеңкенің қауіптілігін білу♪
Dialogue: 0,0:00:38.20,0:00:40.77,Default,,0,0,0,,♪Тым сабырлы жүйе♪
Dialogue: 0,0:00:41.07,0:00:44.21,Default,,0,0,0,,♪ ҚОСУ немесе ӨШІРУ Қазір қайсысын таңдар едіңіз? ♪
Dialogue: 0,0:00:45.44,0:00:48.74,Default,,0,0,0,,♪Нәтиже Мен өз эмоцияларымды қанша рет өлтіремін♪
Dialogue: 0,0:00:48.81,0:00:51.28,Default,,0,0,0,,♪Жоқ, ол бірінші орында өтіп кетті♪
Dialogue: 0,0:00:51.51,0:00:54.68,Default,,0,0,0,,♪Ол жай ғана жойылды♪
Dialogue: 0,0:00:55.62,0:00:58.32,Default,,0,0,0,,♪Мені жайыма қалдыршы Craze♪
Dialogue: 0,0:00:58.39,0:01:01.79,Default,,0,0,0,,♪Мен жай ғана менмін және мен шарасызмын♪
Dialogue: 0,0:01:02.19,0:01:03.49,Default,,0,0,0,,♪иә иә♪
Dialogue: 0,0:01:03.56,0:01:06.26,Default,,0,0,0,,♪Басынан тек тәуекелдерден баста♪
Dialogue: 0,0:01:06.33,0:01:08.73,Default,,0,0,0,,♪Жынды бол♪
Dialogue: 0,0:01:08.80,0:01:11.20,Default,,0,0,0,,♪Инстинктіңізді, шынайы болмысыңызды ашыңыз♪
Dialogue: 0,0:01:11.27,0:01:14.74,Default,,0,0,0,,♪Тексеру шабуылы иә♪
Dialogue: 0,0:01:14.84,0:01:18.77,Default,,0,0,0,,♪Мені жұлып алған сен кімсің? ♪
Dialogue: 0,0:01:38.33,0:01:40.46,Default,,0,0,0,,Такеши Котобуки 17 жаста
Dialogue: 0,0:01:41.80,0:01:43.70,Default,,0,0,0,,Ол өткен күні біздің ауруханадан қашып кетті...
Dialogue: 0,0:01:43.87,0:01:47.54,Default,,0,0,0,,Бұл екі күннен кейін өз еркімен оралған бала туралы.
Dialogue: 0,0:01:48.30,0:01:48.84,Default,,0,0,0,,Шығыңыз
Dialogue: 0,0:01:49.10,0:01:51.44,Default,,0,0,0,,Мен сені екі апта бойы жауап алдым...
Dialogue: 0,0:01:51.61,0:01:53.41,Default,,0,0,0,,«Мен өзімді сыртта таптым»
Dialogue: 0,0:01:53.54,0:01:55.48,Default,,0,0,0,,«Мен түсінбеймін» бір нүктемен-
Dialogue: 0,0:01:55.61,0:01:57.41,Default,,0,0,0,,Бұл жай ғана мағынасы жоқ.
Dialogue: 0,0:01:57.58,0:01:58.85,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба?
Dialogue: 0,0:01:59.75,0:02:03.22,Default,,0,0,0,,Алайда олардың қалай қашып кеткені туралы ешқандай заттай дәлел табылған жоқ.
Dialogue: 0,0:02:03.55,0:02:06.42,Default,,0,0,0,,Қашу физикалық мүмкін емес.
Dialogue: 0,0:02:06.55,0:02:10.23,Default,,0,0,0,,Бұлай жалғаса берсе, бюджетке және ауданның беделіне әсер етеді.
Dialogue: 0,0:02:10.89,0:02:12.83,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:02:14.13,0:02:18.80,Default,,0,0,0,,Бұл материяны «ешқашан болмаған» деп көрсету нені білдіреді?
Dialogue: 0,0:02:19.60,0:02:20.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:22.30,0:02:24.81,Default,,0,0,0,,Бүгіннен бастап мен осы топтық жатақханаға кіремін.
Dialogue: 0,0:02:25.14,0:02:25.77,Default,,0,0,0,,Иә
Dialogue: 0,0:02:30.81,0:02:33.31,Default,,0,0,0,,(Есік жабылған дыбысы)
Dialogue: 0,0:02:48.93,0:02:50.37,Default,,0,0,0,,Бұл Котобуки ме?
Dialogue: 0,0:02:50.67,0:02:51.40,Default,,0,0,0,,О
Dialogue: 0,0:02:51.87,0:02:54.67,Default,,0,0,0,,Сіз қашып кеттіңіз, солай ма? Бұл қауесет
Dialogue: 0,0:02:55.34,0:02:56.87,Default,,0,0,0,,Жеке тілге қатаң тыйым салынады.
Dialogue: 0,0:02:57.74,0:02:59.47,Default,,0,0,0,,Сіз қалай шықтыңыз?
Dialogue: 0,0:03:00.74,0:03:01.68,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:03:01.94,0:03:04.31,Default,,0,0,0,,Мен білмей тұрып, мен сыртта болдым.
Dialogue: 0,0:03:04.41,0:03:05.18,Default,,0,0,0,,Иә
Dialogue: 0,0:03:05.31,0:03:06.28,Default,,0,0,0,,Себебі?
Dialogue: 0,0:03:06.58,0:03:08.18,Default,,0,0,0,,(Жігіттердің күлкісі)
Dialogue: 0,0:03:09.48,0:03:10.22,Default,,0,0,0,,Цу...!
Dialogue: 0,0:03:10.39,0:03:13.32,Default,,0,0,0,,Олай айтпа, айтшы.
Dialogue: 0,0:03:14.36,0:03:14.96,Default,,0,0,0,,Эй?
Dialogue: 0,0:03:15.69,0:03:16.32,Default,,0,0,0,,Эй
Dialogue: 0,0:03:18.69,0:03:19.66,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:03:20.76,0:03:21.53,Default,,0,0,0,,Әй
Dialogue: 0,0:03:23.60,0:03:26.90,Default,,0,0,0,,№18 толтырылды, растаңыз.
Dialogue: 0,0:03:30.31,0:03:30.91,Default,,0,0,0,,Эй
Dialogue: 0,0:03:31.81,0:03:32.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:33.34,0:03:35.58,Default,,0,0,0,,Сіз тітіркендіргішсіз
Dialogue: 0,0:03:37.58,0:03:38.58,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:03:44.39,0:03:46.75,Default,,0,0,0,,Әңгімелесейік, Котобуки.
Dialogue: 0,0:03:48.69,0:03:49.92,Default,,0,0,0,,Адамдар – адамдар.
Dialogue: 0,0:03:50.29,0:03:52.66,Default,,0,0,0,,100 жыл өмір сүресің бе, 10 жыл өмір сүресің бе...
Dialogue: 0,0:03:52.73,0:03:54.40,Default,,0,0,0,,Ол өзгермейді деп ойлаймын.
Dialogue: 0,0:03:54.56,0:03:57.27,Default,,0,0,0,,Сіз бәрібір өлесіз, солай ма?
Dialogue: 0,0:03:57.63,0:03:59.87,Default,,0,0,0,,Аа, дұрыс айтасыз.
Dialogue: 0,0:04:01.64,0:04:02.94,Default,,0,0,0,,Қап…
Dialogue: 0,0:04:03.64,0:04:05.01,Default,,0,0,0,,Айтайын дегенім...
Dialogue: 0,0:04:05.61,0:04:07.91,Default,,0,0,0,,Жақында оның туған күні келе жатыр.
Dialogue: 0,0:04:09.54,0:04:10.58,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:04:11.78,0:04:14.52,Default,,0,0,0,,Түсінбедім, мен қызбын.
Dialogue: 0,0:04:14.58,0:04:15.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:16.32,0:04:16.95,Default,,0,0,0,,...иә...
Dialogue: 0,0:04:17.99,0:04:19.55,Default,,0,0,0,,Енді түсіндің бе?
Dialogue: 0,0:04:20.29,0:04:24.43,Default,,0,0,0,,Боқ... Мен қашуға тырысуды тоқтатуым керек еді.
Dialogue: 0,0:04:24.69,0:04:26.43,Default,,0,0,0,,Шығудың жолы бар ма?
Dialogue: 0,0:04:26.59,0:04:27.83,Default,,0,0,0,,Біреу бар ма?
Dialogue: 0,0:04:28.43,0:04:31.00,Default,,0,0,0,,Мұны бәріміз білуіміз керек.
Dialogue: 0,0:04:31.43,0:04:33.74,Default,,0,0,0,,Ол қабырғадан ешкім өте алмайды.
Dialogue: 0,0:04:33.84,0:04:35.97,Default,,0,0,0,,Сонымен, сізге біреу нұсқау берді ме?
Dialogue: 0,0:04:36.34,0:04:38.27,Default,,0,0,0,,Бұл ең мүмкін емес нәрсе.
Dialogue: 0,0:04:38.41,0:04:40.44,Default,,0,0,0,,Көшіп жүргендерде шлам бар.
Dialogue: 0,0:04:40.61,0:04:41.48,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:04:42.41,0:04:43.31,Default,,0,0,0,,(бас соғу дыбысы)
Dialogue: 0,0:04:45.05,0:04:47.38,Default,,0,0,0,,Сонда қалай шықтың?
Dialogue: 0,0:04:48.38,0:04:50.45,Default,,0,0,0,,Маған қаншалықты қатты ұрғаның маған бәрібір...
Dialogue: 0,0:04:50.85,0:04:52.99,Default,,0,0,0,,Мұны үлкен мәселеге айналдырмаңыз.
Dialogue: 0,0:04:53.66,0:04:54.72,Default,,0,0,0,,Өйткені бұл қиындық тудырады.
Dialogue: 0,0:04:56.36,0:04:56.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:57.99,0:04:58.73,Default,,0,0,0,,Эй
Dialogue: 0,0:04:59.56,0:05:01.33,Default,,0,0,0,,Кайто сен мені мазалайсың ба?
Dialogue: 0,0:05:01.40,0:05:03.53,Default,,0,0,0,,Жоқ, бірақ бұл біржақты емес.
Dialogue: 0,0:05:03.63,0:05:05.00,Default,,0,0,0,,3-тен 2-ге тең, солай ма?
Dialogue: 0,0:05:05.63,0:05:07.47,Default,,0,0,0,,3-тен 1-ге дейін, солай ма?
Dialogue: 0,0:05:08.40,0:05:09.50,Default,,0,0,0,,Мені кіргізбе
Dialogue: 0,0:05:10.31,0:05:11.44,Default,,0,0,0,,Датоса (тепкі дыбысы)
Dialogue: 0,0:05:12.07,0:05:17.75,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:05:17.81,0:05:18.71,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:05:18.95,0:05:19.91,Default,,0,0,0,,Бұл дау ма?
Dialogue: 0,0:05:20.42,0:05:23.99,Default,,0,0,0,,Ештеңе емес, бұл жігіт жай ғана өзін жақсы сезінбейді.
Dialogue: 0,0:05:24.69,0:05:25.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:27.39,0:05:28.89,Default,,0,0,0,,Бөлмеңізге қазір оралыңыз!
Dialogue: 0,0:05:29.09,0:05:29.96,Default,,0,0,0,,Иә
Dialogue: 0,0:05:32.66,0:05:34.90,Default,,0,0,0,,Келесі жолы жолыма түссең, мен сені өлтіремін.
Dialogue: 0,0:05:44.67,0:05:48.98,Default,,0,0,0,,Кеше түнде ми ғылымдары институтының директоры Кейта Ивасаки және...
Dialogue: 0,0:05:49.51,0:05:51.48,Default,,0,0,0,,Бірнеше полиция қызметкері күзетте тұрған...
Dialogue: 0,0:05:51.55,0:05:53.51,Default,,0,0,0,,Біреу өлтірген
Dialogue: 0,0:05:54.12,0:05:54.95,Default,,0,0,0,,Ивасаки мырза
Dialogue: 0,0:05:55.02,0:05:56.38,Default,,0,0,0,,«AJIN.net» тізімі-
Dialogue: 0,0:05:56.52,0:05:57.69,Default,,0,0,0,,Есімдері аталды -
Dialogue: 0,0:05:57.82,0:06:01.06,Default,,0,0,0,,Полиция Сато қылмысқа жауапты деп санайды және тергеуді жалғастырады.
Dialogue: 0,0:06:02.42,0:06:02.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:04.86,0:06:09.06,Default,,0,0,0,,Мүмкін сіз біреуге көмектескіңіз келетін шығар, бірақ бұл ыңғайсыздық.
Dialogue: 0,0:06:09.73,0:06:10.67,Default,,0,0,0,,(тілді шертеді)
Dialogue: 0,0:06:11.73,0:06:15.90,Default,,0,0,0,,Бұл сенсің, деми-адамның досын құтқарып, қашып кеткен.
Dialogue: 0,0:06:17.84,0:06:18.57,Default,,0,0,0,,О
Dialogue: 0,0:06:19.44,0:06:23.54,Default,,0,0,0,,Бұл сізге бірдеңе жасады ма?
Dialogue: 0,0:06:28.72,0:06:29.48,Default,,0,0,0,,Кей?
Dialogue: 0,0:06:29.82,0:06:30.79,Default,,0,0,0,,Кей!
Dialogue: 0,0:06:31.15,0:06:31.95,Default,,0,0,0,,Таа...
Dialogue: 0,0:06:39.83,0:06:40.80,Default,,0,0,0,,Артында қалды
Dialogue: 0,0:06:41.10,0:06:43.40,Default,,0,0,0,,Хмм, менің ойымша.
Dialogue: 0,0:06:44.40,0:06:46.77,Default,,0,0,0,,Жасаған жақсылығың қайтарылады дейді...
Dialogue: 0,0:06:46.90,0:06:48.97,Default,,0,0,0,,Болуы мүмкін емес шындық.
Dialogue: 0,0:06:50.07,0:06:51.47,Default,,0,0,0,,Мен де солай болдым.
Dialogue: 0,0:06:51.64,0:06:52.14,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:53.64,0:06:56.08,Default,,0,0,0,,Одан кейін, мойыныңызды сыртқа шығарсаңыз, сізге жетпейтін нәрсе ...
Dialogue: 0,0:06:56.58,0:07:00.08,Default,,0,0,0,,Тек ұстау мерзімін ұзарту және кейінгі салдары бар ауыр жарақат.
Dialogue: 0,0:07:02.82,0:07:04.65,Default,,0,0,0,,Мен де саған ештеңе бермеймін.
Dialogue: 0,0:07:05.89,0:07:09.52,Default,,0,0,0,,Саған көмектесуге күшім жетсе де
Dialogue: 0,0:07:17.50,0:07:18.50,Default,,0,0,0,,（）
Dialogue: 0,0:07:29.54,0:07:33.48,Default,,0,0,0,,(Кей мен Шабуылдың тыныс алуының тарылуы)
Dialogue: 0,0:07:40.12,0:07:41.06,Default,,0,0,0,,Соңғы жаңалықтар
Dialogue: 0,0:07:41.46,0:07:43.09,Default,,0,0,0,,Дәл қазір Минато Уордтағы қонақүйде.
Dialogue: 0,0:07:43.16,0:07:44.89,Default,,0,0,0,,Қарулы шабуыл жасалды.
Dialogue: 0,0:07:45.49,0:07:47.80,Default,,0,0,0,,Қаза тапқан адам Forge Safety компаниясының президенті болды.
Dialogue: 0,0:07:48.10,0:07:49.66,Default,,0,0,0,,Кейичи Кай мырза және -
Dialogue: 0,0:07:49.76,0:07:51.63,Default,,0,0,0,,Бұл Наоми Ли, президенттің хатшысы.
Dialogue: 0,0:07:52.60,0:07:54.77,Default,,0,0,0,,Оқиға орнында жарты адам Сато болып көрінетін адам...
Dialogue: 0,0:07:54.84,0:07:56.14,Default,,0,0,0,,Куә болған деп айтылады.
Dialogue: 0,0:07:56.77,0:07:58.54,Default,,0,0,0,,Қаза тапқандардың екеуі де...
Dialogue: 0,0:07:58.74,0:08:01.24,Default,,0,0,0,,Өйткені оның аты Сатоның кісі өлтіру тізімінде.
Dialogue: 0,0:08:01.68,0:08:03.81,Default,,0,0,0,,Полиция қылмысты Сато жасады деген қорытындыға келді
Dialogue: 0,0:08:04.15,0:08:06.51,Default,,0,0,0,,Енді жеті ғана министр қалды.
Dialogue: 0,0:08:06.85,0:08:09.18,Default,,0,0,0,,Операцияның аяқталуына аз ғана уақыт қалды.
Dialogue: 0,0:08:10.05,0:08:13.25,Default,,0,0,0,,Барлық жаттығуларда дәлдікті арттырыңыз, жарай ма?
Dialogue: 0,0:08:15.22,0:08:18.53,Default,,0,0,0,,Жарайды, оны жүктеп салайық.
Dialogue: 0,0:08:19.86,0:08:21.76,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:08:23.20,0:08:27.80,Default,,0,0,0,,Әй, біраз болды. Бұл Аджиндегі Сато.
Dialogue: 0,0:08:29.14,0:08:31.87,Default,,0,0,0,,Тізім үштен астам, бірақ...
Dialogue: 0,0:08:32.51,0:08:35.68,Default,,0,0,0,,Жапон үкіметінен әлі жауап келген жоқ.
Dialogue: 0,0:08:37.68,0:08:40.15,Default,,0,0,0,,Біз негізсіз талаптар қойып жатырмыз ба?
Dialogue: 0,0:08:40.65,0:08:41.98,Default,,0,0,0,,Иә, бұл Каваджири.
Dialogue: 0,0:08:42.25,0:08:46.82,Default,,0,0,0,,Деми-адамдар ретінде біз ең төменгі қажеттіліктеріміздің орындалғанын қалаймыз.
Dialogue: 0,0:08:47.72,0:08:51.83,Default,,0,0,0,,Осы уақытқа дейін үкімет пен тиісті компаниялар...
Dialogue: 0,0:08:51.99,0:08:55.56,Default,,0,0,0,,Деми-адамдарға және-
Dialogue: 0,0:08:55.96,0:09:01.07,Default,,0,0,0,,Осы арқылы алынған пайданы ресми және егжей-тегжейлі жариялау және -
Dialogue: 0,0:09:01.74,0:09:04.21,Default,,0,0,0,,Деми-адамдарға азаматтық беру
Dialogue: 0,0:09:04.54,0:09:05.57,Default,,0,0,0,,Бұл екеуі.
Dialogue: 0,0:09:06.11,0:09:09.71,Default,,0,0,0,,Біздің алға жылжуымыз жылдам емес, бірақ...
Dialogue: 0,0:09:09.81,0:09:12.25,Default,,0,0,0,,Бірақ ол ешқашан тоқтамайды
Dialogue: 0,0:09:12.85,0:09:15.25,Default,,0,0,0,,Зардап шеккендердің алдын алу үшін...
Dialogue: 0,0:09:15.32,0:09:17.72,Default,,0,0,0,,Мен мүмкіндігінше тезірек жауап алғым келеді.
Dialogue: 0,0:09:19.09,0:09:20.92,Default,,0,0,0,,Жақсы жауап күту
Dialogue: 0,0:09:24.73,0:09:27.93,Default,,0,0,0,,Үкімет жігіттері не істейді?
Dialogue: 0,0:09:28.73,0:09:30.20,Default,,0,0,0,,Бұл олай емес.
Dialogue: 0,0:09:30.87,0:09:33.30,Default,,0,0,0,,Олардың әрқашан бір ғана жауабы бар
Dialogue: 0,0:09:34.70,0:09:36.57,Default,,0,0,0,,Премьер-министр, бірдеңе айтыңызшы. (Репортер) Сатоның өтінішіне қатысты...
Dialogue: 0,0:09:36.64,0:09:37.84,Default,,0,0,0,,Сіз қалай жауап беруді жоспарлайсыз?
Dialogue: 0,0:09:37.91,0:09:40.88,Default,,0,0,0,,Адамның эксперименті деген нәрсе болмағандықтан...
Dialogue: 0,0:09:41.04,0:09:42.91,Default,,0,0,0,,Тек қатаң көзқараспен қарсы алыңыз
Dialogue: 0,0:09:42.98,0:09:43.95,Default,,0,0,0,,Бірақ шын мәнінде-
Dialogue: 0,0:09:44.01,0:09:45.78,Default,,0,0,0,,Үкімет қорғауында болған Танака...
Dialogue: 0,0:09:45.85,0:09:48.78,Default,,0,0,0,,Сонымен, сіз адам экспериментінің фактісін ұсынасыз, солай ма?
Dialogue: 0,0:09:49.18,0:09:50.79,Default,,0,0,0,,Кез келген жағдайда-
Dialogue: 0,0:09:51.12,0:09:54.09,Default,,0,0,0,,Үкімет терроризмге көнбейді.
Dialogue: 0,0:09:54.36,0:09:58.16,Default,,0,0,0,,Біздің қолымыздан келетіні - бұл мәселені тезірек шешу және қатаң ұстаным.
Dialogue: 0,0:10:01.20,0:10:03.30,Default,,0,0,0,,Ештеңе күту бекер
Dialogue: 0,0:10:03.70,0:10:05.17,Default,,0,0,0,,Басы шығып жатыр.
Dialogue: 0,0:10:05.60,0:10:06.93,Default,,0,0,0,,Маған солай қарама.
Dialogue: 0,0:10:07.60,0:10:11.81,Default,,0,0,0,,Қарсы тарап солай айтса, біз онымен батыл түрде өтуіміз керек.
Dialogue: 0,0:10:12.94,0:10:15.11,Default,,0,0,0,,Сато мырза, қарсы боласыз ба?
Dialogue: 0,0:10:15.94,0:10:17.14,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:10:19.18,0:10:22.18,Default,,0,0,0,,Бұл не? Мен мұны көптен бері істеп келемін
Dialogue: 0,0:10:22.65,0:10:26.62,Default,,0,0,0,,Иә? Хехе, бұл құпия қару.
Dialogue: 0,0:10:36.96,0:10:38.80,Default,,0,0,0,,Ол әлдеқайда жақсы көріне бастады.
Dialogue: 0,0:10:38.97,0:10:41.07,Default,,0,0,0,,Сіз өз денеңізді қорлайсыз.
Dialogue: 0,0:10:41.84,0:10:42.67,Default,,0,0,0,,（）
Dialogue: 0,0:10:43.34,0:10:46.04,Default,,0,0,0,,Бұл мүлде мүмкін болар еді
Dialogue: 0,0:10:46.87,0:10:47.71,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:50.34,0:10:53.01,Default,,0,0,0,,(Кей мен шабуылдың тыныс алуының тарылуы)
Dialogue: 0,0:10:53.08,0:10:54.18,Default,,0,0,0,,Мысал қандай?
Dialogue: 0,0:10:54.82,0:10:55.78,Default,,0,0,0,,Ертең
Dialogue: 0,0:10:55.88,0:10:59.22,Default,,0,0,0,,Енді дайын болған кезде келесі кезеңге өтіңіз.
Dialogue: 0,0:10:59.72,0:11:00.19,Default,,0,0,0,,Иә
Dialogue: 0,0:11:00.86,0:11:01.79,Default,,0,0,0,,Тозаки мырза
Dialogue: 0,0:11:02.42,0:11:04.69,Default,,0,0,0,,Согабе мырза маған хабарласты.
Dialogue: 0,0:11:05.03,0:11:06.99,Default,,0,0,0,,Түстен кейін кезектен тыс жиналыс болатын сияқты.
Dialogue: 0,0:11:07.06,0:11:08.10,Default,,0,0,0,,Кезектен тыс жиналыс?
Dialogue: 0,0:11:09.00,0:11:10.36,Default,,0,0,0,,Бұл ұстахананың қауіпсіздігіне қатысты ма?
Dialogue: 0,0:11:10.67,0:11:12.13,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:11:12.30,0:11:15.70,Default,,0,0,0,,АҚШ қорғаныс министрлігінен біреу келе жатқан сияқты.
Dialogue: 0,0:11:15.90,0:11:16.40,Default,,0,0,0,,Фалько…
Dialogue: 0,0:11:26.38,0:11:30.02,Default,,0,0,0,,Мен бұл басқару комитетінің отырысы деп ойламаймын.
Dialogue: 0,0:11:30.12,0:11:31.85,Default,,0,0,0,,Қорғаныс министрлігі, солай ма?
Dialogue: 0,0:11:32.29,0:11:35.82,Default,,0,0,0,,Әджиндерге қарсы кеңестеріңіз бар шығар.
Dialogue: 0,0:11:36.12,0:11:40.33,Default,,0,0,0,,Кеңес? Хм, бұл араша түскен қателік емес пе?
Dialogue: 0,0:11:41.26,0:11:43.43,Default,,0,0,0,,Согабеден ештеңе естіген жоқсың ба?
Dialogue: 0,0:11:43.86,0:11:47.47,Default,,0,0,0,,Согабе мырза да егжей-тегжейден хабардар болмаған сияқты...
Dialogue: 0,0:11:48.80,0:11:50.14,Default,,0,0,0,,Өтінемін, осы.
Dialogue: 0,0:11:53.84,0:11:55.18,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:11:55.71,0:11:58.38,Default,,0,0,0,,Бұл АҚШ Қорғаныс министрлігінен.
Dialogue: 0,0:11:58.48,0:12:01.45,Default,,0,0,0,,Дуглас Алмейда және Карли Майерс мырза.
Dialogue: 0,0:12:02.45,0:12:03.35,Default,,0,0,0,,Міне, келдіңіз.
Dialogue: 0,0:12:04.19,0:12:07.32,Default,,0,0,0,,Ең алдымен, уақытыңызды бөліп келгеніңізге рахмет.
Dialogue: 0,0:12:07.92,0:12:10.02,Default,,0,0,0,,Бұл жолы бізді жіберді...
Dialogue: 0,0:12:10.16,0:12:14.40,Default,,0,0,0,,Өткен күні Сатоның шабуылы кезінде өлтірілген доктор Огурамен...
Dialogue: 0,0:12:14.73,0:12:17.87,Default,,0,0,0,,Оның күзетшісінің өлімінің мән-жайын анықтау.
Dialogue: 0,0:12:17.97,0:12:18.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:19.77,0:12:22.87,Default,,0,0,0,,Сондықтан бүгін мен сол күні ғылыми-зерттеу институтында болғандардың барлығына алғысымды білдіргім келеді.
Dialogue: 0,0:12:22.94,0:12:24.44,Default,,0,0,0,,Келгендеріңізге рахмет.
Dialogue: 0,0:12:25.11,0:12:27.04,Default,,0,0,0,,Мұндағы сот-медициналық сараптама нәтижелері бойынша-
Dialogue: 0,0:12:27.17,0:12:30.18,Default,,0,0,0,,Бұл екеуін Сато өлтіргеніне күмән жоқ.
Dialogue: 0,0:12:30.91,0:12:32.88,Default,,0,0,0,,Қосымша тергеу қажет пе?
Dialogue: 0,0:12:32.95,0:12:36.78,Default,,0,0,0,,О, мұнда құпия ақпарат көп.
Dialogue: 0,0:12:36.85,0:12:38.52,Default,,0,0,0,,Мені иіскеп жібергім келмейді.
Dialogue: 0,0:12:39.15,0:12:43.06,Default,,0,0,0,,Бұл жапон үкіметі мақұлдаған жоба.
Dialogue: 0,0:12:43.32,0:12:45.89,Default,,0,0,0,,Цк, мен бос емес кезде...
Dialogue: 0,0:12:46.33,0:12:48.40,Default,,0,0,0,,Басқа елдегі ғылыми мекемеде -
Dialogue: 0,0:12:48.50,0:12:51.47,Default,,0,0,0,,Америка үкіметінің қызметкерлері өлтірілуде...
Dialogue: 0,0:12:51.53,0:12:53.53,Default,,0,0,0,,Бұл өте сирек кездесетін жағдай.
Dialogue: 0,0:12:54.20,0:12:56.17,Default,,0,0,0,,Қорғаныс министрлігі...
Dialogue: 0,0:12:56.24,0:12:59.27,Default,,0,0,0,,Өлімнің егжей-тегжейлі мән-жайларын түсіну қажет
Dialogue: 0,0:12:59.84,0:13:02.94,Default,,0,0,0,,Зерттеу кезеңінде сол күні болған оқиғаны айтып береміз.
Dialogue: 0,0:13:03.01,0:13:05.28,Default,,0,0,0,,Мен оны тыңдаймын, сондықтан...
Dialogue: 0,0:13:05.48,0:13:07.15,Default,,0,0,0,,Ынтымақтастық үшін рахмет.
Dialogue: 0,0:13:07.41,0:13:09.38,Default,,0,0,0,,Тағы бір мәселе туындады.
Dialogue: 0,0:13:19.29,0:13:20.19,Default,,0,0,0,,Тозаки мырза
Dialogue: 0,0:13:21.00,0:13:22.36,Default,,0,0,0,,Шаралар... (Тозаки) Мәселе жоқ.
Dialogue: 0,0:13:22.83,0:13:26.37,Default,,0,0,0,,Мен күзетшіні түсірген кездегі бақылау камерасының жазбасын өшірдім.
Dialogue: 0,0:13:26.47,0:13:30.07,Default,,0,0,0,,Ол сондай-ақ оны дәрігерге ауыстырған зерттеушінің стоматологиялық жазбаларын бұрмалаған.
Dialogue: 0,0:13:32.11,0:13:36.08,Default,,0,0,0,,Бірақ сізге мұқабаны құрастыру керек.
Dialogue: 0,0:13:36.91,0:13:39.21,Default,,0,0,0,,Күннің барлық жазбаларын дайындаңыз
Dialogue: 0,0:13:39.81,0:13:40.58,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:13:50.39,0:13:53.26,Default,,0,0,0,,Қарғыс атсын, осындай уақытта.
Dialogue: 0,0:14:02.10,0:14:07.34,Default,,0,0,0,,IBM көрінбейді, бірақ оны танудың жолдары бар.
Dialogue: 0,0:14:10.61,0:14:11.91,Default,,0,0,0,,Сіз жаяу жүре аласыз.
Dialogue: 0,0:14:12.88,0:14:14.22,Default,,0,0,0,,Қараңыз, міне осы ғой?
Dialogue: 0,0:14:14.28,0:14:18.02,Default,,0,0,0,,(Сынған әйнекті басқан дыбыс)
Dialogue: 0,0:14:18.19,0:14:19.15,Default,,0,0,0,,Накано
Dialogue: 0,0:14:19.35,0:14:20.32,Default,,0,0,0,,Мен қарсыласымды өлтіру үшін келген жоқпын
Dialogue: 0,0:14:24.26,0:14:26.23,Default,,0,0,0,,О!
Dialogue: 0,0:14:26.63,0:14:28.30,Default,,0,0,0,,Жеке кездессек...
Dialogue: 0,0:14:29.26,0:14:31.00,Default,,0,0,0,,Оны тастаудың жолы бар.
Dialogue: 0,0:14:32.23,0:14:34.20,Default,,0,0,0,,Қыздар сияқты
Dialogue: 0,0:14:35.07,0:14:39.04,Default,,0,0,0,,Бірақ нақты шайқаста бұл оңай емес.
Dialogue: 0,0:14:40.14,0:14:44.25,Default,,0,0,0,,Ең сенімдісі – негізгі денені ұйықтату.
Dialogue: 0,0:14:46.18,0:14:51.02,Default,,0,0,0,,Егер ол қалыпты IBM болса, онда ол жұмысын тоқтатар еді.
Dialogue: 0,0:14:57.63,0:15:00.09,Default,,0,0,0,,Сіз оны біршама қолға алған сияқтысыз.
Dialogue: 0,0:15:00.39,0:15:01.10,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:11.94,0:15:12.51,Default,,0,0,0,,(іштің дірілдеген дыбысы)
Dialogue: 0,0:15:12.97,0:15:13.51,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:15.04,0:15:18.68,Default,,0,0,0,,Оян, Котобуки, бұл менің соңғы өтінішім.
Dialogue: 0,0:15:20.11,0:15:24.69,Default,,0,0,0,,Өзіңді тәртіпке сал, бейбақ. Сіз де әйелдерді мазаламайсыз ба?
Dialogue: 0,0:15:25.22,0:15:25.95,Default,,0,0,0,,Хун
Dialogue: 0,0:15:36.43,0:15:37.97,Default,,0,0,0,,(Такешидің айқайы)
Dialogue: 0,0:15:41.57,0:15:44.67,Default,,0,0,0,,Ертең оның туған күні.
Dialogue: 0,0:15:46.34,0:15:50.24,Default,,0,0,0,,Енді біраз уақыт көшеге шыға алмайсың.
Dialogue: 0,0:15:50.61,0:15:54.48,Default,,0,0,0,,Маған бәрібір, бүгін көрсетудің пайдасы жоқ.
Dialogue: 0,0:15:58.55,0:16:01.16,Default,,0,0,0,,Сен оған көп қиындық көрсеттің ғой, иә?
Dialogue: 0,0:16:02.16,0:16:03.16,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:16:04.26,0:16:05.43,Default,,0,0,0,,(Кения) Бірақ білесің бе, біз оны Саторудың аурухана шығындарын жабуға көмектеседі деп ойладық➡
Dialogue: 0,0:16:06.43,0:16:10.97,Default,,0,0,0,,Сіз осылайша көз жұма аласыз.
Dialogue: 0,0:16:14.13,0:16:15.50,Default,,0,0,0,,Мен адасып қалдым...
Dialogue: 0,0:16:17.71,0:16:24.55,Default,,0,0,0,,2 күннен кейін мен наразылық білдіремін! Орналасқан жері Денсаулық сақтау, еңбек және әл-ауқат министрлігінің алдында!
Dialogue: 0,0:16:25.65,0:16:29.28,Default,,0,0,0,,Бұл толық алдау болды...
Dialogue: 0,0:16:30.22,0:16:35.16,Default,,0,0,0,,Келгендеріңізге рахмет. Мен сізге нақты кездесу орнын айтамын.
Dialogue: 0,0:16:36.09,0:16:38.29,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:16:38.66,0:16:39.69,Default,,0,0,0,,баллоннан ауа ағады.
Dialogue: 0,0:16:41.76,0:16:44.03,Default,,0,0,0,,Не істеу керек? мен...
Dialogue: 0,0:16:45.60,0:16:49.10,Default,,0,0,0,,Мм... қайта жиналу туралы. Сен барасың ба?
Dialogue: 0,0:16:49.17,0:16:52.67,Default,,0,0,0,,Не? Жоқ, бұл қиыншылық сияқты...
Dialogue: 0,0:16:54.31,0:16:55.58,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:17:00.58,0:17:03.18,Default,,0,0,0,,Уайымдама, айтпасаң өлемін.
Dialogue: 0,0:17:04.18,0:17:04.65,Default,,0,0,0,,(Түкіру дыбысы)
Dialogue: 0,0:17:05.02,0:17:05.55,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:17:11.49,0:17:16.70,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:17:17.80,0:17:18.50,Default,,0,0,0,,Гррр…
Dialogue: 0,0:17:20.03,0:17:20.77,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:17:21.70,0:17:23.14,Default,,0,0,0,,Сәлем
Dialogue: 0,0:17:24.41,0:17:25.67,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:17:26.17,0:17:27.67,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:17:29.34,0:17:32.18,Default,,0,0,0,,Мына жігіт ақымақ па?
Dialogue: 0,0:17:46.36,0:17:49.53,Default,,0,0,0,,А, бұл жігіт ақымақ емес.
Dialogue: 0,0:17:53.73,0:17:55.37,Default,,0,0,0,,Сен өте ақымақсың
Dialogue: 0,0:17:59.64,0:18:03.34,Default,,0,0,0,,Ой... уф...
Dialogue: 0,0:18:06.85,0:18:10.32,Default,,0,0,0,,Мен сені өлтіремін дедім.
Dialogue: 0,0:18:14.42,0:18:17.79,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:18:25.17,0:18:25.83,Default,,0,0,0,,Аһ...!
Dialogue: 0,0:18:31.24,0:18:32.81,Default,,0,0,0,,(Жіңішке тыныс дыбысы)
Dialogue: 0,0:18:34.31,0:18:35.51,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:55.50,0:18:57.16,Default,,0,0,0,,Негізгі дайындық аяқталды.
Dialogue: 0,0:18:59.17,0:19:00.70,Default,,0,0,0,,Бүгін жұмыс орнында оқытудан бастаңыз
Dialogue: 0,0:19:01.17,0:19:02.20,Default,,0,0,0,,Уау...
Dialogue: 0,0:19:05.44,0:19:06.47,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:19:07.24,0:19:10.31,Default,,0,0,0,,Уау, бұл таңқаларлық.
Dialogue: 0,0:19:10.84,0:19:14.28,Default,,0,0,0,,Егер сіз мұны істей алсаңыз, бұл өте қызық болады.
Dialogue: 0,0:19:14.68,0:19:19.32,Default,,0,0,0,,Менің ойымша, басқа ешкім бұлай ойламайды.
Dialogue: 0,0:19:20.32,0:19:24.16,Default,,0,0,0,,Бірақ оны жасау үшін көп жарылғыш заттар қажет.
Dialogue: 0,0:19:24.53,0:19:25.86,Default,,0,0,0,,Онда ешқандай проблема жоқ
Dialogue: 0,0:19:26.59,0:19:30.50,Default,,0,0,0,,Өткен күні Некозава мырзадан сатып алғанымның қалғаны менде әлі бар.
Dialogue: 0,0:19:31.73,0:19:33.33,Default,,0,0,0,,♪ Ка-та-на
Dialogue: 0,0:19:35.60,0:19:41.54,Default,,0,0,0,,Екінші жартысында құпия қаруды алуға бірден барасыз ба?
Dialogue: 0,0:19:50.72,0:19:51.59,Default,,0,0,0,,Йо
Dialogue: 0,0:19:52.69,0:19:53.42,Default,,0,0,0,,Сора?
Dialogue: 0,0:19:57.22,0:20:01.36,Default,,0,0,0,,Олар жеке бөлмеге бара жатыр. Олар біразға дейін шыға алмайды.
Dialogue: 0,0:20:04.33,0:20:07.50,Default,,0,0,0,,Жабдықтаушылар құпия болып табылады. Тереңдетпе.
Dialogue: 0,0:20:23.88,0:20:27.35,Default,,0,0,0,,Әй, Кей Нағай қандай адам?
Dialogue: 0,0:20:30.92,0:20:34.43,Default,,0,0,0,,Кей ... досым.
Dialogue: 0,0:20:35.73,0:20:36.66,Default,,0,0,0,,Бірінші рет
Dialogue: 0,0:20:37.00,0:20:40.67,Default,,0,0,0,,Бірақ артта қалды, солай ма? Бұл жиіркенішті емес пе?
Dialogue: 0,0:20:41.70,0:20:43.94,Default,,0,0,0,,Егер ол мұны қаламайды десе, мен кері кетемін.
Dialogue: 0,0:20:45.74,0:20:47.71,Default,,0,0,0,,Бірақ оған бірдеңе болса...
Dialogue: 0,0:20:48.84,0:20:50.34,Default,,0,0,0,,Міндетті түрде көмектесіңіз
Dialogue: 0,0:20:51.31,0:20:51.85,Default,,0,0,0,,Иә
Dialogue: 0,0:20:53.41,0:20:56.25,Default,,0,0,0,,Сіз шынымен тітіркендіргішсіз.
Dialogue: 0,0:20:58.02,0:21:00.62,Default,,0,0,0,,Мен олардың қазіргі күйінде Элкияны құтқара алатынына сенбеймін.
Dialogue: 0,0:21:07.59,0:21:09.63,Default,,0,0,0,,Мүмкін Кайто
Dialogue: 0,0:21:10.86,0:21:14.00,Default,,0,0,0,,Болашақта Кей Нагайға бірдеңе болса ше...
Dialogue: 0,0:21:14.77,0:21:19.71,Default,,0,0,0,,Осы сұмдық жерден кеткіңіз келсе, маған хабарлаңыз.
Dialogue: 0,0:21:21.01,0:21:21.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:24.31,0:21:28.42,Default,,0,0,0,,Мен саған бұл қабырғадан бір рет өтуге рұқсат етемін.
Dialogue: 0,0:21:40.49,0:21:46.63,Default,,0,0,0,,♪Мен одан шаршадым, енді ауыстырайық♪
Dialogue: 0,0:21:46.83,0:21:52.01,Default,,0,0,0,,♪Сізде бар қалыпты♪
Dialogue: 0,0:21:53.34,0:21:59.38,Default,,0,0,0,,♪Жарқыраған Құдай картасы♪
Dialogue: 0,0:21:59.65,0:22:04.69,Default,,0,0,0,,♪Дұрыс қағаз картасы♪
Dialogue: 0,0:22:05.95,0:22:09.99,Default,,0,0,0,,♪Келесі жолы менің үйіме келесің♪
Dialogue: 0,0:22:12.39,0:22:16.50,Default,,0,0,0,,♪Мен саған бәрін көрсетемін♪
Dialogue: 0,0:22:16.83,0:22:18.63,Default,,0,0,0,,♪Себебі♪
Dialogue: 0,0:22:18.77,0:22:25.04,Default,,0,0,0,,♪Екі адам мектеп ауласының бұрышында, жел соғып тұр♪
Dialogue: 0,0:22:25.11,0:22:28.94,Default,,0,0,0,,♪Қазір айта аламын ба деп ойлаймын♪
Dialogue: 0,0:22:31.65,0:22:37.48,Default,,0,0,0,,♪Ешкімге айтпайтын сөздер♪
Dialogue: 0,0:22:37.95,0:22:44.09,Default,,0,0,0,,♪«Мен саған жақсы боламын, сондықтан маған қонаққа кел»♪
Dialogue: 0,0:22:44.42,0:22:50.00,Default,,0,0,0,,♪«Мен саған бәрін беремін, эй»♪
Dialogue: 0,0:22:50.83,0:23:00.14,Default,,0,0,0,,♪"Мәңгілік дос болайық"♪
Dialogue: 0,0:23:01.64,0:23:07.64,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
