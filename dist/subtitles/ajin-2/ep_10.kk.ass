Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.77,0:00:11.61,Default,,0,0,0,,♪Осы баратын жерге көзіңізді оятыңыз♪
Dialogue: 0,0:00:12.04,0:00:15.01,Default,,0,0,0,,♪Егер қашып құтыла алмасаң♪
Dialogue: 0,0:00:15.14,0:00:20.75,Default,,0,0,0,,♪ Бәрін жұтып, дұрыс-бұрысты, ұрыс-керіс ♪
Dialogue: 0,0:00:27.59,0:00:33.56,Default,,0,0,0,,♪Жүректің қараңғылығын басқаратын қауіп шу шығарады♪
Dialogue: 0,0:00:33.76,0:00:39.63,Default,,0,0,0,,♪Ақылынан айырылғалы тұрған адамдар туралы шындық♪
Dialogue: 0,0:00:40.14,0:00:45.74,Default,,0,0,0,,♪Мен оның мағынасыздығын білемін♪
Dialogue: 0,0:00:46.27,0:00:52.35,Default,,0,0,0,,♪Тіпті жалған тыныштық бұзылса♪
Dialogue: 0,0:00:52.41,0:01:03.63,Default,,0,0,0,,♪ Қарсы болатын көлеңке түсіру ♪
Dialogue: 0,0:01:04.53,0:01:07.60,Default,,0,0,0,,♪Бұл қашып кетудің соңы♪
Dialogue: 0,0:01:07.66,0:01:10.63,Default,,0,0,0,,♪Себебі бұл жалғыз жол♪
Dialogue: 0,0:01:10.70,0:01:16.77,Default,,0,0,0,,♪ Мен көздеген кішкентай үмітке ♪ жет
Dialogue: 0,0:01:17.07,0:01:20.11,Default,,0,0,0,,♪Сол созылған қолдан♪
Dialogue: 0,0:01:20.21,0:01:23.24,Default,,0,0,0,,♪Төгілген әлсіздік♪
Dialogue: 0,0:01:23.34,0:01:29.55,Default,,0,0,0,,♪Дұрыс-бұрыс бәрін жұтып, жынды болдым♪
Dialogue: 0,0:01:38.83,0:01:41.30,Default,,0,0,0,,Біз даладан хабарлауды жалғастырамыз.
Dialogue: 0,0:01:41.56,0:01:43.30,Default,,0,0,0,,Байланысты тараптардың ақпараты бойынша--
Dialogue: 0,0:01:43.47,0:01:45.27,Default,,0,0,0,,Адамзатсыз Сатоның зұлымдығына байланысты...
Dialogue: 0,0:01:45.40,0:01:47.84,Default,,0,0,0,,Musashi Heavy Industries ойыншысы Хашигучи өлтірілді.
Dialogue: 0,0:01:48.14,0:01:50.41,Default,,0,0,0,,Одан да ерекше анти-Аджин топтары.
Dialogue: 0,0:01:50.47,0:01:51.51,Default,,0,0,0,,ОМОН мүшесі...
Dialogue: 0,0:01:51.57,0:01:52.81,Default,,0,0,0,,Құрбандыққа шалынды дейді.
Dialogue: 0,0:01:53.41,0:01:57.45,Default,,0,0,0,,Екінші жағынан, қашып кеткен Сато мен оның достарының қайда екені әлі белгісіз.
Dialogue: 0,0:01:57.61,0:02:00.52,Default,,0,0,0,,Полиция олардың қайда екенін анықтау үшін қолдан келгеннің бәрін жасап жатқанын айтады...
Dialogue: 0,0:02:00.58,0:02:01.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:08.62,0:02:11.69,Default,,0,0,0,,Сіз шынымен жерлеуге барған сияқтысыз.
Dialogue: 0,0:02:20.50,0:02:23.51,Default,,0,0,0,,Ішінде не болды! ? Сатоға неге қашып кетуге мүмкіндік бердіңіз? ?
Dialogue: 0,0:02:24.14,0:02:25.14,Default,,0,0,0,,Эй, Тозаки-сан!
Dialogue: 0,0:02:25.21,0:02:27.38,Default,,0,0,0,,Артымнан еріп жүрсең де, ұят! ?
Dialogue: 0,0:02:27.71,0:02:30.41,Default,,0,0,0,,Сіздің IBM Sato-ны жасай алар еді!
Dialogue: 0,0:02:30.55,0:02:31.51,Default,,0,0,0,,Жоқ! ?
Dialogue: 0,0:02:31.91,0:02:33.62,Default,,0,0,0,,Бірдеңе айт! (Шабуыл) Ах!
Dialogue: 0,0:02:33.68,0:02:35.55,Default,,0,0,0,,Тосаки-сан, сабыр ет.
Dialogue: 0,0:02:36.25,0:02:39.62,Default,,0,0,0,,Жалғыз Нағайға кінә арту – жауыздық.
Dialogue: 0,0:02:40.22,0:02:42.16,Default,,0,0,0,,Сузумура мырза дұрыс айтады.
Dialogue: 0,0:02:42.26,0:02:43.86,Default,,0,0,0,,Нагай-күн, бұл тек сенің кінәң емес.
Dialogue: 0,0:02:43.93,0:02:44.69,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:02:45.79,0:02:47.23,Default,,0,0,0,,Бұл менің кінәм...
Dialogue: 0,0:02:47.50,0:02:48.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:50.23,0:02:52.50,Default,,0,0,0,,Сато мырзаны тоқтата алмаған себебім...
Dialogue: 0,0:02:52.70,0:02:54.84,Default,,0,0,0,,Хирасава-сан және басқалары да өлтірілді...
Dialogue: 0,0:02:56.70,0:02:58.44,Default,,0,0,0,,Бәріне менің кінәм
Dialogue: 0,0:03:01.84,0:03:02.88,Default,,0,0,0,,Сіз дайынсыз ба?
Dialogue: 0,0:03:05.71,0:03:07.35,Default,,0,0,0,,Сәлем Нагай!
Dialogue: 0,0:03:07.85,0:03:09.45,Default,,0,0,0,,Оқиға орнынан жеткізілді.
Dialogue: 0,0:03:09.92,0:03:10.85,Default,,0,0,0,,Сонымен қатар полиция...
Dialogue: 0,0:03:11.32,0:03:12.95,Default,,0,0,0,,Аджин басқару комитетіне жатады.
Dialogue: 0,0:03:13.22,0:03:16.22,Default,,0,0,0,,Ю Тозаки Изуми Шимомураның қайда екені де іздестіріліп жатыр.
Dialogue: 0,0:03:16.39,0:03:18.19,Default,,0,0,0,,Ха! Тозаки мырза...
Dialogue: 0,0:03:18.79,0:03:21.66,Default,,0,0,0,,Га, әрине.
Dialogue: 0,0:03:22.73,0:03:24.23,Default,,0,0,0,,Не істеуіміз керек, Тозаки-сан?
Dialogue: 0,0:03:24.30,0:03:26.33,Default,,0,0,0,,Сен әлі ақымақсың.
Dialogue: 0,0:03:26.40,0:03:27.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:37.51,0:03:38.75,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:42.25,0:03:44.39,Default,,0,0,0,,Мен ештеңе істей алмаймын
Dialogue: 0,0:03:45.25,0:03:48.66,Default,,0,0,0,,Енді бәрі бітті.
Dialogue: 0,0:03:54.23,0:03:56.30,Default,,0,0,0,,Иә, жоқ-
Dialogue: 0,0:03:56.93,0:03:59.43,Default,,0,0,0,,Ең жаман ақымақ – мен.
Dialogue: 0,0:03:59.77,0:04:01.97,Default,,0,0,0,,Деми-адамдармен бірікпе.
Dialogue: 0,0:04:02.57,0:04:03.94,Default,,0,0,0,,Бұл нәтиже
Dialogue: 0,0:04:04.37,0:04:06.37,Default,,0,0,0,,Сіз жаңа ғана жұмысыңыздан айырылдыңыз ба?
Dialogue: 0,0:04:06.74,0:04:08.68,Default,,0,0,0,,Ол үлкен қылмыскер болған.
Dialogue: 0,0:04:10.78,0:04:16.58,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:04:17.82,0:04:22.02,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:04:23.36,0:04:24.63,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:27.46,0:04:28.46,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:04:28.96,0:04:31.97,Default,,0,0,0,,Сіз үшін басқа адамдардың өліп жатқанына қалай қарайсыз?
Dialogue: 0,0:04:32.87,0:04:33.87,Default,,0,0,0,,(Хирасаваның ыңырануы)
Dialogue: 0,0:04:33.94,0:04:36.54,Default,,0,0,0,,Өтінемін... Елес!
Dialogue: 0,0:04:38.04,0:04:40.51,Default,,0,0,0,,Шық!
Dialogue: 0,0:04:41.38,0:04:42.31,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:57.06,0:04:58.63,Default,,0,0,0,,(камера дыбысы)
Dialogue: 0,0:05:03.67,0:05:05.43,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:05:06.07,0:05:09.64,Default,,0,0,0,,Иә... бәрін Сато ұрлап кеткен...
Dialogue: 0,0:05:10.94,0:05:11.67,Default,,0,0,0,,Лейденшафтличтің солтүстік-шығысында—
Dialogue: 0,0:05:12.07,0:05:13.88,Default,,0,0,0,,Премьер-министрге дереу хабарлаңыз
Dialogue: 0,0:05:21.32,0:05:24.55,Default,,0,0,0,,Премьер-министр, егер бұл мәселе сыртқы әлемге тарап кетсе...
Dialogue: 0,0:05:24.62,0:05:26.89,Default,,0,0,0,,Бүкіл Жапония дүрбелеңге түседі
Dialogue: 0,0:05:27.66,0:05:30.59,Default,,0,0,0,,Бұл қауіпті ме?
Dialogue: 0,0:05:31.03,0:05:32.99,Default,,0,0,0,,Ұрланғанның бәрін пайдалансаңыз...
Dialogue: 0,0:05:33.06,0:05:36.43,Default,,0,0,0,,Теориялық тұрғыдан барлық азаматтарды үш рет өлтіруге болады.
Dialogue: 0,0:05:37.87,0:05:38.93,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:05:39.43,0:05:41.94,Default,,0,0,0,,Премьер-министр: Ең нашар сценарийді болжасақ...
Dialogue: 0,0:05:42.00,0:05:43.87,Default,,0,0,0,,Есеп айырысу жоспарын дайындаған дұрыс...
Dialogue: 0,0:05:47.71,0:05:48.81,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:05:49.58,0:05:52.98,Default,,0,0,0,,Сатоны іздеуді де жалғастырыңыз.
Dialogue: 0,0:05:53.05,0:05:53.78,Default,,0,0,0,,Иә Иә
Dialogue: 0,0:05:56.62,0:06:00.39,Default,,0,0,0,,Көріп отырғаныңыздай, кері санақ аяқталды.
Dialogue: 0,0:06:00.92,0:06:05.63,Default,,0,0,0,,Алайда, соңында үкіметтен жауап келмеді.
Dialogue: 0,0:06:06.89,0:06:08.93,Default,,0,0,0,,Бұл өте өкінішті...
Dialogue: 0,0:06:09.43,0:06:10.87,Default,,0,0,0,,Мен бұрын айтқанымдай-
Dialogue: 0,0:06:10.93,0:06:13.00,Default,,0,0,0,,Біздің прогресс тоқтайды...
Dialogue: 0,0:06:13.53,0:06:15.04,Default,,0,0,0,,Мүлдем жоқ
Dialogue: 0,0:06:15.84,0:06:17.81,Default,,0,0,0,,Сондықтан біз-
Dialogue: 0,0:06:18.51,0:06:20.48,Default,,0,0,0,,3-ші толқын 10 күн ішінде
Dialogue: 0,0:06:20.98,0:06:22.94,Default,,0,0,0,,Соңғы шайқасты бастаңыз
Dialogue: 0,0:06:23.88,0:06:25.85,Default,,0,0,0,,Осы уақытқа дейін келсең де...
Dialogue: 0,0:06:25.91,0:06:29.68,Default,,0,0,0,,Әлі де туыс емеспін деп жүрген адамдар.
Dialogue: 0,0:06:30.79,0:06:33.92,Default,,0,0,0,,Қазір қашатын жер жоқ.
Dialogue: 0,0:06:34.56,0:06:36.39,Default,,0,0,0,,Жаңа көргендеріңіз...
Dialogue: 0,0:06:36.72,0:06:38.43,Default,,0,0,0,,Сіз қаншалықты алысқа баруға дайынсыз?
Dialogue: 0,0:06:39.39,0:06:40.73,Default,,0,0,0,,Мен шынымен қалжыңдап тұрмын.
Dialogue: 0,0:06:42.76,0:06:44.77,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:06:45.07,0:06:46.47,Default,,0,0,0,,Даусыңды естігім келді. Сені көргім келді.
Dialogue: 0,0:06:46.53,0:06:47.57,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:06:48.40,0:06:50.40,Default,,0,0,0,,Сақ болуларыңызды сұраймын.
Dialogue: 0,0:06:50.61,0:06:53.91,Default,,0,0,0,,Өйткені өмірден айырмашылығы оны алмастыру мүмкін емес.
Dialogue: 0,0:07:03.82,0:07:04.65,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:06.02,0:07:08.66,Default,,0,0,0,,Сато мырза жай ғана ойнап тұр.
Dialogue: 0,0:07:09.42,0:07:12.79,Default,,0,0,0,,Мен деми-адамдардың болашағы туралы ойламаймын да!
Dialogue: 0,0:07:14.10,0:07:16.73,Default,,0,0,0,,Не болды? Ессіз күйде
Dialogue: 0,0:07:16.80,0:07:17.57,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:07:17.83,0:07:20.60,Default,,0,0,0,,Сіз тіпті тамақ туралы ойладыңыз ба?
Dialogue: 0,0:07:20.77,0:07:22.60,Default,,0,0,0,,О, эй!
Dialogue: 0,0:07:25.01,0:07:27.01,Default,,0,0,0,,Сәлем Танака-сан
Dialogue: 0,0:07:27.18,0:07:27.94,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:28.98,0:07:29.98,Default,,0,0,0,,Ум...
Dialogue: 0,0:07:31.95,0:07:34.55,Default,,0,0,0,,Сато мырза шынымен де біздің...
Dialogue: 0,0:07:34.68,0:07:35.78,Default,,0,0,0,,Деми-адамдар туралы ойлау...
Dialogue: 0,0:07:35.85,0:07:37.19,Default,,0,0,0,,Ай-ай-ай!
Dialogue: 0,0:07:38.12,0:07:40.59,Default,,0,0,0,,Сато мырзаға сенуден басқа амалым жоқ.
Dialogue: 0,0:07:41.69,0:07:42.69,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:43.76,0:07:47.13,Default,,0,0,0,,Қалай болғанда да, келесісі соңғысы.
Dialogue: 0,0:07:47.73,0:07:49.50,Default,,0,0,0,,Солай емес пе, Танака мырза?
Dialogue: 0,0:07:49.90,0:07:50.67,Default,,0,0,0,,О
Dialogue: 0,0:07:51.60,0:07:54.04,Default,,0,0,0,,Бұл... соңы.\NМен бұл
Dialogue: 0,0:07:55.60,0:07:56.64,Default,,0,0,0,,Міне
Dialogue: 0,0:07:58.71,0:08:00.61,Default,,0,0,0,,деп үміттенемін ...
Dialogue: 0,0:08:03.81,0:08:06.95,Default,,0,0,0,,(Сатоның гуілдеуі)
Dialogue: 0,0:08:09.12,0:08:10.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:13.02,0:08:15.56,Default,,0,0,0,,Мен сәулет сызбаларының үлгісін алдым.
Dialogue: 0,0:08:16.66,0:08:19.63,Default,,0,0,0,,Жер асты өткеліне тек су төгетін жерден деректерді импорттау қажет.
Dialogue: 0,0:08:19.69,0:08:20.80,Default,,0,0,0,,Бүгін жасауға болады
Dialogue: 0,0:08:20.90,0:08:23.73,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:08:26.00,0:08:27.27,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:29.64,0:08:31.71,Default,,0,0,0,,Иә, жақсы
Dialogue: 0,0:08:33.64,0:08:34.88,Default,,0,0,0,,Ол жақта ше?
Dialogue: 0,0:08:35.28,0:08:36.98,Default,,0,0,0,,Мен оны уақытында орындаймын деп ойлаймын.
Dialogue: 0,0:08:37.18,0:08:38.98,Default,,0,0,0,,Окуяма мырза күткендей
Dialogue: 0,0:08:39.71,0:08:42.08,Default,,0,0,0,,Ал, енді тағы қызық болады.
Dialogue: 0,0:08:43.89,0:08:45.82,Default,,0,0,0,,Келесісі соңғысы, солай ма?
Dialogue: 0,0:08:45.99,0:08:48.22,Default,,0,0,0,,Бұл екінші жағында не болатынына байланысты.
Dialogue: 0,0:08:48.79,0:08:49.69,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:08:49.96,0:08:52.73,Default,,0,0,0,,Жоқ, ерекше себеп жоқ...
Dialogue: 0,0:08:54.20,0:08:55.06,Default,,0,0,0,,Иә
Dialogue: 0,0:08:56.83,0:08:58.53,Default,,0,0,0,,Бірақ сіз сенімді бола аласыз.
Dialogue: 0,0:08:58.67,0:09:02.00,Default,,0,0,0,,Келесі жолы мен үкіметпен келіссөздер жүргізуді жоспарлап отырмын.
Dialogue: 0,0:09:02.70,0:09:06.64,Default,,0,0,0,,Сондықтан мен оны Musashi Heavy Industries компаниясынан алдым.
Dialogue: 0,0:09:07.07,0:09:09.01,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:09:09.28,0:09:10.71,Default,,0,0,0,,Бірақ бұл дұрыс.
Dialogue: 0,0:09:10.88,0:09:13.95,Default,,0,0,0,,Біз бұл соғысты мәңгілік ойнай алмаймыз.
Dialogue: 0,0:09:14.25,0:09:15.88,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:09:18.22,0:09:21.72,Default,,0,0,0,,А, жұмысқа қайта оралайық.
Dialogue: 0,0:09:29.66,0:09:31.60,Default,,0,0,0,,Тергеу нәтижесінде доктор Огура...
Dialogue: 0,0:09:31.67,0:09:34.00,Default,,0,0,0,,Аджин Сато ұрлап кетті деген күдік пайда болды.
Dialogue: 0,0:09:34.27,0:09:38.04,Default,,0,0,0,,Дәл осы кезде қауіпсіз үйге кенеттен Сато шабуыл жасады.
Dialogue: 0,0:09:38.57,0:09:41.24,Default,,0,0,0,,Алдымен, өз қауіпсіздігіңізді қамтамасыз етіп, бізге қайта хабарласыңыз.
Dialogue: 0,0:09:41.91,0:09:44.15,Default,,0,0,0,,Қорытындылай келе, бұл келесідей
Dialogue: 0,0:09:44.85,0:09:46.28,Default,,0,0,0,,Соңында, бұл электрондық пошта-
Dialogue: 0,0:09:46.71,0:09:47.82,Default,,0,0,0,,Дуглас Альмейдамен-
Dialogue: 0,0:09:47.88,0:09:49.92,Default,,0,0,0,,Карли Майерс жоғалып кетті...
Dialogue: 0,0:09:50.08,0:09:52.25,Default,,0,0,0,,Оның қайда екені күні бүгінге дейін белгісіз.
Dialogue: 0,0:09:52.89,0:09:55.22,Default,,0,0,0,,Қауіпсіз үйдегі қауіпсіздік қызметкерлерімен сұхбат.
Dialogue: 0,0:09:55.36,0:09:59.06,Default,,0,0,0,,Оларға бірнеше әскер, соның ішінде деми-адамдар шабуыл жасағаны айтылды.
Dialogue: 0,0:09:59.13,0:10:01.10,Default,,0,0,0,,Кейінірек қауіпсіз үйдің айналасында...
Dialogue: 0,0:10:01.20,0:10:04.07,Default,,0,0,0,,Біз сондай-ақ көлік қуу туралы хабарларды алдық.
Dialogue: 0,0:10:04.30,0:10:07.74,Default,,0,0,0,,Жағдайды ескере отырып, Сато оны өшіріп тастады деп ойлаудан басқа амалым жоқ.
Dialogue: 0,0:10:08.14,0:10:12.07,Default,,0,0,0,,Демек, доктор Огура әлі де Сатоның қолында...
Dialogue: 0,0:10:12.64,0:10:14.68,Default,,0,0,0,,Жапон үкіметі тергеуді талап ете ме?
Dialogue: 0,0:10:14.74,0:10:15.68,Default,,0,0,0,,Сен жай ғана... отты қайта тұтаттың, иә?
Dialogue: 0,0:10:15.91,0:10:18.38,Default,,0,0,0,,Менің ойымша, олар Сато туралы ештеңе істей алмайды.
Dialogue: 0,0:10:18.81,0:10:19.91,Default,,0,0,0,,Алайда...
Dialogue: 0,0:10:19.98,0:10:24.22,Default,,0,0,0,,Қайтадан топ жіберсек те, екеуіміз бірдей болып қалуымыз мүмкін.
Dialogue: 0,0:10:24.62,0:10:25.15,Default,,0,0,0,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:10:26.62,0:10:29.66,Default,,0,0,0,,Сатоның келесі лаңкестік әрекетін күту әлі де кеш емес.
Dialogue: 0,0:10:30.09,0:10:33.83,Default,,0,0,0,,Масштабына қарай әскери араласу да мүмкін болуы мүмкін.
Dialogue: 0,0:10:33.89,0:10:34.90,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:35.13,0:10:37.87,Default,,0,0,0,,Егер бұл орын алса, Жапонияның деми-адамдары заңды түрде...
Dialogue: 0,0:10:37.93,0:10:39.70,Default,,0,0,0,,Сіз оны қорғай аласыз.
Dialogue: 0,0:10:39.77,0:10:40.94,Default,,0,0,0,,Осымен
Dialogue: 0,0:10:41.64,0:10:43.77,Default,,0,0,0,,Мен директорға есеп беремін.
Dialogue: 0,0:10:49.71,0:10:50.68,Default,,0,0,0,,(Директордың күрсінуі)
Dialogue: 0,0:11:18.91,0:11:20.44,Default,,0,0,0,,Иә?Не?
Dialogue: 0,0:11:30.25,0:11:31.72,Default,,0,0,0,,Не? (мылтық)
Dialogue: 0,0:11:42.86,0:11:45.70,Default,,0,0,0,,Бүгін ауа-райы жақсы.
Dialogue: 0,0:11:45.77,0:11:48.27,Default,,0,0,0,,Ешқандай айласыз фронтальды серпіліс.
Dialogue: 0,0:11:49.37,0:11:52.24,Default,,0,0,0,,Бұл тамаша шоу болады
Dialogue: 0,0:11:54.91,0:11:56.88,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:12:08.09,0:12:10.26,Default,,0,0,0,,Төтенше жағдай орын алды! Төтенше жағдай орын алды!
Dialogue: 0,0:12:10.39,0:12:13.13,Default,,0,0,0,,Қатты қаруланған террористер басып кірді! Мылтық журналы жарылды
Dialogue: 0,0:12:13.36,0:12:15.46,Default,,0,0,0,,Күзетшілер дереу 04 пунктіне баруы керек.
Dialogue: 0,0:12:15.80,0:12:16.76,Default,,0,0,0,,Террористер қаруланған
Dialogue: 0,0:12:16.83,0:12:18.87,Default,,0,0,0,,Автоматты винтовка мен зымыран тасығыштарды пайдалану расталды
Dialogue: 0,0:12:19.03,0:12:21.04,Default,,0,0,0,,Бас ғимаратта патрондарды алғаннан кейін басқа мүшелер...
Dialogue: 0,0:12:21.17,0:12:22.27,Default,,0,0,0,,Жауап беруге дайын болыңыз
Dialogue: 0,0:12:22.34,0:12:25.47,Default,,0,0,0,,Бұл жаттығу жаттығуы емес! қайталаңыз! Бұл жаттығу емес!
Dialogue: 0,0:12:25.74,0:12:27.27,Default,,0,0,0,,Жауынгерлік машиналарды пайдалана алмаймыз ба?
Dialogue: 0,0:12:27.34,0:12:28.41,Default,,0,0,0,,Оқ - бұл ұнтақ журналы!
Dialogue: 0,0:12:30.91,0:12:33.31,Default,,0,0,0,,(Мылтық дыбысы)
Dialogue: 0,0:12:38.02,0:12:40.09,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:53.77,0:12:55.10,Default,,0,0,0,,Бұл не? Бұл жігіттер
Dialogue: 0,0:12:55.17,0:12:56.37,Default,,0,0,0,,Олар ішке кіріп келеді.
Dialogue: 0,0:12:58.07,0:12:59.51,Default,,0,0,0,,Оны бейтараптандырыңыз.
Dialogue: 0,0:13:00.37,0:13:01.41,Default,,0,0,0,,Сізге...
Dialogue: 0,0:13:02.88,0:13:04.85,Default,,0,0,0,,Бізді тоқтату мүмкін емес
Dialogue: 0,0:13:08.45,0:13:09.78,Default,,0,0,0,,Жүр! Бар! Бар!
Dialogue: 0,0:13:09.85,0:13:12.15,Default,,0,0,0,,(Демиадамдардың айқайы)
Dialogue: 0,0:13:13.25,0:13:14.12,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:13:14.19,0:13:15.22,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:13:22.86,0:13:23.33,Default,,0,0,0,,Га
Dialogue: 0,0:13:27.27,0:13:28.10,Default,,0,0,0,,Не! ?
Dialogue: 0,0:13:28.94,0:13:29.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:35.58,0:13:37.14,Default,,0,0,0,,Гах…
Dialogue: 0,0:13:37.91,0:13:40.38,Default,,0,0,0,,Мылтық қоймасынан кейін қару-жарақ қоймасы да басып алынды.
Dialogue: 0,0:13:40.45,0:13:41.92,Default,,0,0,0,,Жау жарты адам деген хабар бар.
Dialogue: 0,0:13:42.18,0:13:45.42,Default,,0,0,0,,Не! Қарғыс атқыр, Орталық жедел әрекет ету күштері әлі жоқ! ?
Dialogue: 0,0:13:45.49,0:13:48.46,Default,,0,0,0,,Мен қазір жол үстіндемін, бірақ келгенше біраз уақыт болады!
Dialogue: 0,0:13:48.52,0:13:49.42,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:13:49.89,0:13:51.26,Default,,0,0,0,,Сіз не қарап отырсыз...
Dialogue: 0,0:13:51.33,0:13:55.46,Default,,0,0,0,,Бұл басқару комитеті дайындаған Сатомен есеп айырысу жоспарының жобасы.
Dialogue: 0,0:13:56.03,0:13:58.03,Default,,0,0,0,,Премьер-министр, төтенше жағдай жарияланды.
Dialogue: 0,0:13:58.10,0:14:01.14,Default,,0,0,0,,Құрлықтағы өзін-өзі қорғау күштерінің гарнизонына Сато шабуыл жасауда.
Dialogue: 0,0:14:01.20,0:14:02.34,Default,,0,0,0,,Не!
Dialogue: 0,0:14:04.84,0:14:07.51,Default,,0,0,0,,Мынау Танака, біз бұл жерді бағындырдық.
Dialogue: 0,0:14:07.98,0:14:11.88,Default,,0,0,0,,Түсіндім, содан кейін затты сол жерге апарыңыз.
Dialogue: 0,0:14:12.31,0:14:14.45,Default,,0,0,0,,Мұны да жақын арада анықтаймыз.
Dialogue: 0,0:14:14.52,0:14:15.88,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:14:15.95,0:14:17.42,Default,,0,0,0,,Күте тұрыңыз, Сато мырза!
Dialogue: 0,0:14:17.92,0:14:19.45,Default,,0,0,0,,Жақында тазартылмайды!
Dialogue: 0,0:14:23.46,0:14:25.09,Default,,0,0,0,,Олардың жақындауына жол берме! (SDF) Оқ-дәрі...
Dialogue: 0,0:14:25.16,0:14:27.16,Default,,0,0,0,,Қолдау келгенше ұстаңыз!
Dialogue: 0,0:14:32.00,0:14:33.17,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:14:33.33,0:14:34.34,Default,,0,0,0,,Нақты ату
Dialogue: 0,0:14:34.40,0:14:37.17,Default,,0,0,0,,Террористерді өлтіруді жалғастырыңыз!
Dialogue: 0,0:14:37.64,0:14:39.24,Default,,0,0,0,,Уау
Dialogue: 0,0:14:40.44,0:14:42.58,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:14:43.64,0:14:45.41,Default,,0,0,0,,Жоқ... не?! ?
Dialogue: 0,0:14:53.22,0:14:54.02,Default,,0,0,0,,Біріншіден, аяқтарыңыздың астындағы қорапқа қараңыздар
Dialogue: 0,0:14:54.46,0:14:56.32,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:14:58.39,0:15:01.10,Default,,0,0,0,,Иә, сіз оны тез тазаладыңыз, солай ма?
Dialogue: 0,0:15:01.26,0:15:02.90,Default,,0,0,0,,А... иә
Dialogue: 0,0:15:02.96,0:15:06.97,Default,,0,0,0,,Жарайды, тез бақылауды қолға алайық.
Dialogue: 0,0:15:07.27,0:15:08.24,Default,,0,0,0,,Иә
Dialogue: 0,0:15:15.04,0:15:15.68,Default,,0,0,0,,Хью
Dialogue: 0,0:15:16.24,0:15:19.35,Default,,0,0,0,,Менің ойымша, бұл мен ойлағаннан оңайырақ.
Dialogue: 0,0:15:19.58,0:15:21.95,Default,,0,0,0,,Өзін-өзі қорғау күштері заңмен байланысты.
Dialogue: 0,0:15:22.02,0:15:24.35,Default,,0,0,0,,Дереу жауап ретінде қолдануға болатын қаруға шектеулер бар.
Dialogue: 0,0:15:24.55,0:15:28.06,Default,,0,0,0,,Біріншіден, мылтық журналы мен қару-жарақ қоймасын басып алу стратегиясы жеңіс болды деп ойлаймын.
Dialogue: 0,0:15:28.66,0:15:31.66,Default,,0,0,0,,Нагай! Нагай!
Dialogue: 0,0:15:32.06,0:15:33.96,Default,,0,0,0,,Хаа... Нагай!
Dialogue: 0,0:15:34.09,0:15:34.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:36.63,0:15:38.03,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:15:38.10,0:15:39.10,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:40.30,0:15:41.97,Default,,0,0,0,,Сато мырзаның видеосы...
Dialogue: 0,0:15:48.48,0:15:51.25,Default,,0,0,0,,Қараңыз! Жылдам әрекет ету күштерін қолдау үшін -
Dialogue: 0,0:15:51.35,0:15:53.25,Default,,0,0,0,,Бұл жерді еш нәрсеге қарамастан қорғаңыз!
Dialogue: 0,0:15:53.31,0:15:53.98,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:58.35,0:15:59.52,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:16:04.22,0:16:05.06,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:16:10.40,0:16:11.50,Default,,0,0,0,,Хигучи расталды.
Dialogue: 0,0:16:18.41,0:16:20.67,Default,,0,0,0,,Сіздерге де қиын болуы керек...
Dialogue: 0,0:16:21.41,0:16:24.35,Default,,0,0,0,,Бұл сәл жеңіл режим болды...
Dialogue: 0,0:16:29.22,0:16:30.02,Default,,0,0,0,,Премьер-министр
Dialogue: 0,0:16:30.48,0:16:32.49,Default,,0,0,0,,Қолбасшылық ғимараты басып алынған сияқты.
Dialogue: 0,0:16:32.65,0:16:34.46,Default,,0,0,0,,Атымды айтып қойсам зияны жоқ шығар».
Dialogue: 0,0:16:34.52,0:16:36.42,Default,,0,0,0,,Жағдай қандай?
Dialogue: 0,0:16:36.62,0:16:39.66,Default,,0,0,0,,Маңызды нысандар нақты бақылауда.
Dialogue: 0,0:16:40.03,0:16:42.76,Default,,0,0,0,,Қазіргі жағдайда ұрысты жалғастыру тек шығынды арттырады.
Dialogue: 0,0:16:43.30,0:16:45.43,Default,,0,0,0,,Әскерлерді қайта құру үшін уақытша шығарылды
Dialogue: 0,0:16:45.53,0:16:47.60,Default,,0,0,0,,Олар қалағанын істесін бе?
Dialogue: 0,0:16:47.67,0:16:49.04,Default,,0,0,0,,Мен саған бұлай істеуге рұқсат бермеймін.
Dialogue: 0,0:16:49.17,0:16:51.27,Default,,0,0,0,,Жылдам әрекет ету күштері қазірдің өзінде периметрдің айналасында орналастырылған.
Dialogue: 0,0:16:51.34,0:16:53.31,Default,,0,0,0,,Бірден қарсы шабуылға шыға алмайсыз ба?
Dialogue: 0,0:16:53.61,0:16:55.48,Default,,0,0,0,,Химиялық қару да болуы мүмкін
Dialogue: 0,0:16:55.61,0:16:57.58,Default,,0,0,0,,Мұқият жауап беріңіз.
Dialogue: 0,0:17:04.45,0:17:06.39,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:06.49,0:17:07.55,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:17:11.79,0:17:14.09,Default,,0,0,0,,Сато мырза, жиын дайын.
Dialogue: 0,0:17:14.36,0:17:17.06,Default,,0,0,0,,Окуяма-кун станоктарда өте жақсы.
Dialogue: 0,0:17:17.40,0:17:20.43,Default,,0,0,0,,Бұл үлкен мәселе емес, бұл стандартты өнім.
Dialogue: 0,0:17:22.70,0:17:26.54,Default,,0,0,0,,Бұл керемет көрінеді, бірақ мен оны жақсы жеңе аламын ба?
Dialogue: 0,0:17:27.34,0:17:29.81,Default,,0,0,0,,Бұл барлық кадрларды түсіру мүмкіндігі бар соңғы үлгі.
Dialogue: 0,0:17:30.08,0:17:33.28,Default,,0,0,0,,Не? Хехе, енді Окуяманы қайтадан көшіріп жатырсың ба?
Dialogue: 0,0:17:33.71,0:17:36.62,Default,,0,0,0,,(Такахаши мен Геннің күлкісі)
Dialogue: 0,0:17:42.22,0:17:44.12,Default,,0,0,0,,Мергендер тобын орналастыру аяқталды
Dialogue: 0,0:17:44.29,0:17:45.19,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:17:45.69,0:17:47.49,Default,,0,0,0,,Террористер адамдарды кепілге алуда
Dialogue: 0,0:17:47.59,0:17:49.83,Default,,0,0,0,,Ішкі жағдайды түсінгенше кіруді күтіңіз.
Dialogue: 0,0:17:50.23,0:17:50.83,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:55.27,0:17:58.61,Default,,0,0,0,,Сато мырза, зымыран орнату аяқталды.
Dialogue: 0,0:17:59.44,0:18:00.57,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:18:01.51,0:18:03.78,Default,,0,0,0,,Showtime жалғастырылды делік.
Dialogue: 0,0:18:11.09,0:18:13.25,Default,,0,0,0,,Сөзге тікелей көшейік.
Dialogue: 0,0:18:13.62,0:18:15.19,Default,,0,0,0,,Қазіргі уақытта оны қоса алғанда -
Dialogue: 0,0:18:15.26,0:18:18.26,Default,,0,0,0,,Өлтіретін газы бар жиырма зымыран...
Dialogue: 0,0:18:18.56,0:18:20.56,Default,,0,0,0,,Іске қосуға дайын
Dialogue: 0,0:18:21.36,0:18:24.40,Default,,0,0,0,,Оның қаншалықты тиімді екенін білу керек.
Dialogue: 0,0:18:24.80,0:18:27.73,Default,,0,0,0,,Бұл кісі өлтіру қаруы үкіметтің нұсқауымен қолданылған.
Dialogue: 0,0:18:28.17,0:18:30.80,Default,,0,0,0,,Musashi Heavy Industries жасырын түрде әзірленген
Dialogue: 0,0:18:31.54,0:18:34.34,Default,,0,0,0,,Танака-кунды теңіз шошқасы ретінде пайдаланыңыз.
Dialogue: 0,0:18:35.71,0:18:38.68,Default,,0,0,0,,біз өз талаптарымызды айтамыз.
Dialogue: 0,0:18:39.58,0:18:41.82,Default,,0,0,0,,Бір аптадан кейін сағат 12-ге дейін -
Dialogue: 0,0:18:42.22,0:18:44.42,Default,,0,0,0,,Мен Жапонияның берілуін қалаймын.
Dialogue: 0,0:18:46.22,0:18:49.86,Default,,0,0,0,,Біз сол жерде тәуелсіз деми-адамзат ұлтын жасаймыз.
Dialogue: 0,0:18:50.16,0:18:51.76,Default,,0,0,0,,Жапонияның берілгенін қалайсыз ба?
Dialogue: 0,0:18:51.83,0:18:53.56,Default,,0,0,0,,Қандай ақымақ нәрсе...
Dialogue: 0,0:18:53.83,0:18:57.73,Default,,0,0,0,,Әрине, бұл негізсіз өтініш екенін білемін.
Dialogue: 0,0:18:58.47,0:19:00.47,Default,,0,0,0,,Бірақ үкімет қандай болса да...
Dialogue: 0,0:19:00.53,0:19:03.87,Default,,0,0,0,,Деми-адамдардың азаматтығының мойындалуы екіталай.
Dialogue: 0,0:19:04.20,0:19:05.71,Default,,0,0,0,,Бұған көмектесу мүмкін емес
Dialogue: 0,0:19:06.24,0:19:08.31,Default,,0,0,0,,Тек күш қолданыңыз.
Dialogue: 0,0:19:08.41,0:19:09.44,Default,,0,0,0,,Жақсы (Такахаши)
Dialogue: 0,0:19:10.31,0:19:12.35,Default,,0,0,0,,Осы өлтіретін газбен-
Dialogue: 0,0:19:12.41,0:19:15.25,Default,,0,0,0,,Осы елде тұратын барлық адамдарды өлтіріңіз
Dialogue: 0,0:19:15.32,0:19:19.15,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:19:20.39,0:19:24.83,Default,,0,0,0,,Иә, бұл әскери араласуға жеткілікті себеп.
Dialogue: 0,0:19:25.79,0:19:29.63,Default,,0,0,0,,Иә, біз оны жапон үкіметіне бере алмаймыз.
Dialogue: 0,0:19:30.53,0:19:34.37,Default,,0,0,0,,Бүкіл халық білетін шығар...
Dialogue: 0,0:19:35.47,0:19:38.51,Default,,0,0,0,,Мен байсалдымын
Dialogue: 0,0:19:43.78,0:19:44.58,Default,,0,0,0,,Сузумура
Dialogue: 0,0:19:44.65,0:19:45.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:45.81,0:19:47.68,Default,,0,0,0,,Мен сізден қару сатып алуыңызды сұрай аламын ба?
Dialogue: 0,0:19:47.75,0:19:48.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:49.65,0:19:50.78,Default,,0,0,0,,Қаруды сатып алу
Dialogue: 0,0:19:51.39,0:19:54.92,Default,,0,0,0,,Жарайды... бұл мүмкін, бірақ неге тағы...
Dialogue: 0,0:19:55.19,0:19:56.36,Default,,0,0,0,,Ол қазірдің өзінде шешілді.
Dialogue: 0,0:19:56.72,0:19:57.93,Default,,0,0,0,,Сатоны тоқтатыңыз
Dialogue: 0,0:19:58.26,0:19:58.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:59.39,0:20:00.59,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:20:01.20,0:20:03.36,Default,,0,0,0,,Бізде енді қолдау жоқ...
Dialogue: 0,0:20:03.43,0:20:04.57,Default,,0,0,0,,Сәйкес емес
Dialogue: 0,0:20:05.30,0:20:08.70,Default,,0,0,0,,Сато осы уақытқа дейін көптеген адамдарды өлтірді.
Dialogue: 0,0:20:09.70,0:20:12.51,Default,,0,0,0,,Ол еш ойланбастан өрт түймесін басатын.
Dialogue: 0,0:20:13.84,0:20:14.88,Default,,0,0,0,,Маған...
Dialogue: 0,0:20:19.55,0:20:23.32,Default,,0,0,0,,Жоқ... бұл енді маған ғана қатысты емес.
Dialogue: 0,0:20:23.82,0:20:25.72,Default,,0,0,0,,Судумурадан сұраңыз
Dialogue: 0,0:20:26.69,0:20:30.79,Default,,0,0,0,,«Мен бұйрықтарды орындаймын, басқа ештеңе жоқ».
Dialogue: 0,0:20:31.66,0:20:33.33,Default,,0,0,0,,Хирасава мырза осылай айтар еді.
Dialogue: 0,0:20:33.66,0:20:34.43,Default,,0,0,0,,Иә
Dialogue: 0,0:20:35.53,0:20:36.30,Default,,0,0,0,,Иә
Dialogue: 0,0:20:37.53,0:20:39.23,Default,,0,0,0,,Мен шынымен де түсінбеймін.
Dialogue: 0,0:20:39.43,0:20:40.83,Default,,0,0,0,,Сіз бәрібір Сатоны жеңесіз, солай ма?
Dialogue: 0,0:20:40.90,0:20:41.60,Default,,0,0,0,,Иә.
Dialogue: 0,0:20:41.84,0:20:44.81,Default,,0,0,0,,Жақсы! Қарттардың өшін ал!
Dialogue: 0,0:20:44.97,0:20:45.77,Default,,0,0,0,,Иә
Dialogue: 0,0:20:46.81,0:20:47.61,Default,,0,0,0,,Нагай
Dialogue: 0,0:20:48.38,0:20:49.51,Default,,0,0,0,,Мен мұны істемеймін
Dialogue: 0,0:20:50.58,0:20:51.58,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:21:04.86,0:21:11.00,Default,,0,0,0,,♪Мен одан шаршадым, енді ауыстырайық♪
Dialogue: 0,0:21:11.37,0:21:16.50,Default,,0,0,0,,♪Сізде бар қалыпты♪
Dialogue: 0,0:21:17.64,0:21:23.71,Default,,0,0,0,,♪Жарқыраған Құдай картасы♪
Dialogue: 0,0:21:23.98,0:21:29.02,Default,,0,0,0,,♪Дұрыс қағаз картасы♪
Dialogue: 0,0:21:30.48,0:21:34.49,Default,,0,0,0,,♪Келесі жолы менің үйіме келесің♪
Dialogue: 0,0:21:36.79,0:21:40.86,Default,,0,0,0,,♪Мен саған бәрін көрсетемін♪
Dialogue: 0,0:21:41.36,0:21:43.00,Default,,0,0,0,,♪Себебі♪
Dialogue: 0,0:21:43.30,0:21:49.50,Default,,0,0,0,,♪Екі адам мектеп ауласының бұрышында, жел соғып тұр♪
Dialogue: 0,0:21:49.57,0:21:53.37,Default,,0,0,0,,♪Қазір айта аламын ба деп ойлаймын♪
Dialogue: 0,0:21:56.01,0:22:01.78,Default,,0,0,0,,♪Ешкімге айтпайтын сөздер♪
Dialogue: 0,0:22:02.52,0:22:08.56,Default,,0,0,0,,♪«Мен саған жақсы боламын, сондықтан маған қонаққа кел»♪
Dialogue: 0,0:22:08.82,0:22:14.49,Default,,0,0,0,,♪«Мен саған бәрін беремін, эй»♪
Dialogue: 0,0:22:15.33,0:22:24.64,Default,,0,0,0,,♪"Мәңгілік дос болайық"♪
Dialogue: 0,0:22:26.14,0:22:32.14,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
