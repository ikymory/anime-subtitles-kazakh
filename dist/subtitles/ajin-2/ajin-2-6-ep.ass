Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.51,0:00:12.74,Default,,0,0,0,,♪Жақын шайқас, бөлшектену♪
Dialogue: 0,0:00:13.21,0:00:17.78,Default,,0,0,0,,♪ Менің алдымда кім тұрсың? ♪
Dialogue: 0,0:00:24.52,0:00:27.22,Default,,0,0,0,,♪Қашуды жалғастыру мәңгілік емес♪
Dialogue: 0,0:00:27.49,0:00:30.23,Default,,0,0,0,,♪ Оны шын өмірде шайнап, жұтып қой ♪
Dialogue: 0,0:00:30.33,0:00:35.20,Default,,0,0,0,,♪Айғайлап, екіұштылықтан бас тарт♪
Dialogue: 0,0:00:35.43,0:00:38.10,Default,,0,0,0,,♪Көлеңкенің қауіптілігін білу♪
Dialogue: 0,0:00:38.17,0:00:40.74,Default,,0,0,0,,♪Тым сабырлы жүйе♪
Dialogue: 0,0:00:41.04,0:00:44.21,Default,,0,0,0,,♪ ҚОСУ немесе ӨШІРУ Қазір қайсысын таңдар едіңіз? ♪
Dialogue: 0,0:00:45.34,0:00:48.68,Default,,0,0,0,,♪Нәтиже Мен өз эмоцияларымды қанша рет өлтіремін♪
Dialogue: 0,0:00:48.74,0:00:51.25,Default,,0,0,0,,♪Жоқ, ол бірінші орында өтіп кетті♪
Dialogue: 0,0:00:51.48,0:00:54.62,Default,,0,0,0,,♪Ол жай ғана жойылды♪
Dialogue: 0,0:00:55.58,0:00:58.09,Default,,0,0,0,,♪Мені жайыма қалдыршы Craze♪
Dialogue: 0,0:00:58.19,0:01:01.66,Default,,0,0,0,,♪Мен жай ғана менмін және мен шарасызмын♪
Dialogue: 0,0:01:02.16,0:01:03.39,Default,,0,0,0,,♪иә иә♪
Dialogue: 0,0:01:03.46,0:01:06.23,Default,,0,0,0,,♪Басынан тек тәуекелдерден баста♪
Dialogue: 0,0:01:06.29,0:01:08.70,Default,,0,0,0,,♪Жынды бол♪
Dialogue: 0,0:01:08.76,0:01:11.10,Default,,0,0,0,,♪Инстинктіңізді, шынайы болмысыңызды ашыңыз♪
Dialogue: 0,0:01:11.17,0:01:14.54,Default,,0,0,0,,♪Тексеру шабуылы иә♪
Dialogue: 0,0:01:14.77,0:01:18.74,Default,,0,0,0,,♪Мені жұлып алған сен кімсің? ♪
Dialogue: 0,0:01:54.34,0:01:56.41,Default,,0,0,0,,Бұл Йоко Тайнака ма?
Dialogue: 0,0:02:02.68,0:02:04.65,Default,,0,0,0,,Өгей әкесі - Сатоси Тайнака
Dialogue: 0,0:02:05.12,0:02:08.22,Default,,0,0,0,,Сіздің биологиялық әкеңіз сіз 15 жасыңызда жазатайым оқиғадан қайтыс болды.
Dialogue: 0,0:02:08.62,0:02:10.59,Default,,0,0,0,,Анасы - Савако Тайнака
Dialogue: 0,0:02:11.39,0:02:12.73,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:02:16.36,0:02:17.60,Default,,0,0,0,,Шық...
Dialogue: 0,0:02:19.30,0:02:20.84,Default,,0,0,0,,Мұндай атау...
Dialogue: 0,0:02:22.37,0:02:24.27,Default,,0,0,0,,Оны естігім келмейді...
Dialogue: 0,0:02:25.41,0:02:28.44,Default,,0,0,0,,Сіз «деми-адам анықталмаған адам» ретінде тіркелдіңіз.
Dialogue: 0,0:02:29.34,0:02:31.45,Default,,0,0,0,,Кешіріңіз, бірақ мен мұны істей алмаймын.
Dialogue: 0,0:02:33.88,0:02:38.42,Default,,0,0,0,,А... а... анау жігіт...
Dialogue: 0,0:02:42.92,0:02:44.53,Default,,0,0,0,,Әлгі әйел...
Dialogue: 0,0:02:51.67,0:02:53.20,Default,,0,0,0,,Телефонды қойыңыз!
Dialogue: 0,0:02:53.67,0:02:54.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:56.24,0:02:59.17,Default,,0,0,0,,Савако! Ойлан
Dialogue: 0,0:02:59.71,0:03:02.28,Default,,0,0,0,,Оның денесін алтынға айналдыруға болады!
Dialogue: 0,0:03:02.68,0:03:04.88,Default,,0,0,0,,Бізге енді жұмыс істеудің қажеті жоқ! ?
Dialogue: 0,0:03:07.45,0:03:08.95,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:03:10.62,0:03:11.95,Default,,0,0,0,,Ана...?
Dialogue: 0,0:03:12.65,0:03:14.92,Default,,0,0,0,,Иә иә иә иә
Dialogue: 0,0:03:15.79,0:03:16.96,Default,,0,0,0,,Иә
Dialogue: 0,0:03:18.76,0:03:20.63,Default,,0,0,0,,Сіз мені сатпақшы болдыңыз...
Dialogue: 0,0:03:21.63,0:03:24.67,Default,,0,0,0,,Мама, әлгі бейбақ айтқанын тағы істейсің бе?
Dialogue: 0,0:03:26.43,0:03:27.24,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:32.34,0:03:33.44,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:03:53.29,0:03:56.73,Default,,0,0,0,,(көктемгі жөтел)
Dialogue: 0,0:03:58.83,0:04:02.47,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:04:08.01,0:04:09.51,Default,,0,0,0,,Жеңілмейтін автопилот, Шир Харт Аттак—
Dialogue: 0,0:04:11.85,0:04:13.72,Default,,0,0,0,,Сол әйелдің кесірінен...
Dialogue: 0,0:04:16.28,0:04:17.02,Default,,0,0,0,,(Ватару) Ой, расымен бе? Мен ойлағаннан кіші екен.
Dialogue: 0,0:04:18.99,0:04:21.29,Default,,0,0,0,,Әлі де сол бейбақпен...
Dialogue: 0,0:04:23.83,0:04:25.46,Default,,0,0,0,,Танысқаныма қуаныштымын...
Dialogue: 0,0:04:25.53,0:04:30.03,Default,,0,0,0,,Жоқ, сенің өгей әкең мен шешең өлген.
Dialogue: 0,0:04:35.37,0:04:40.78,Default,,0,0,0,,Қызымды сатқаны үшін жаза...
Dialogue: 0,0:04:42.31,0:04:42.98,Default,,0,0,0,,Жоқ
Dialogue: 0,0:04:45.01,0:04:48.65,Default,,0,0,0,,Мен көп нәрсе болды деп ойлаймын, бірақ бұл дұрыс емес.
Dialogue: 0,0:04:50.42,0:04:51.75,Default,,0,0,0,,Саған не болды...
Dialogue: 0,0:04:52.05,0:04:54.76,Default,,0,0,0,,Полицияда хабарламаның жазбасы болды.
Dialogue: 0,0:04:55.86,0:04:58.66,Default,,0,0,0,,Бұл сіз үйден шыққаннан кейін болған болуы керек.
Dialogue: 0,0:05:00.83,0:05:02.93,Default,,0,0,0,,Бұл жарты адам ашылғаны туралы есеп пе?
Dialogue: 0,0:05:03.00,0:05:03.93,Default,,0,0,0,,Иә
Dialogue: 0,0:05:04.97,0:05:08.47,Default,,0,0,0,,Әджин немесе Әджин Менің балам Ажин
Dialogue: 0,0:05:09.97,0:05:12.97,Default,,0,0,0,,А? Не?
Dialogue: 0,0:05:15.61,0:05:16.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:17.78,0:05:21.85,Default,,0,0,0,,Анау бала, анау бала... менің балам.
Dialogue: 0,0:05:21.98,0:05:22.85,Default,,0,0,0,,Гах…
Dialogue: 0,0:05:23.65,0:05:24.99,Default,,0,0,0,,Эй!
Dialogue: 0,0:05:25.09,0:05:28.59,Default,,0,0,0,,Тек сол күні Миямура-кунды шақырғаныңды ұмытпа.
Dialogue: 0,0:05:29.66,0:05:30.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:35.56,0:05:36.83,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:05:38.83,0:05:40.07,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:05:41.07,0:05:42.37,Default,,0,0,0,,А... уф
Dialogue: 0,0:05:46.11,0:05:47.81,Default,,0,0,0,,Кешіріңіз... Хм...
Dialogue: 0,0:05:50.08,0:05:51.05,Default,,0,0,0,,Ян… Бала…
Dialogue: 0,0:05:54.62,0:05:55.45,Default,,0,0,0,,Иә
Dialogue: 0,0:05:56.98,0:05:58.85,Default,,0,0,0,,Тыңдаңыз...
Dialogue: 0,0:06:00.99,0:06:02.89,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:06:03.79,0:06:05.56,Default,,0,0,0,,Сіз қателесесіз.
Dialogue: 0,0:06:09.76,0:06:10.83,Default,,0,0,0,,Кеш болды
Dialogue: 0,0:06:16.74,0:06:18.74,Default,,0,0,0,,О... солай...
Dialogue: 0,0:06:26.75,0:06:33.65,Default,,0,0,0,,(Электрокардиограф дабылы)
Dialogue: 0,0:06:43.53,0:06:44.17,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:50.61,0:06:51.47,Default,,0,0,0,,Тозаки мырза!
Dialogue: 0,0:06:53.67,0:06:54.48,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:06:56.14,0:06:58.91,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:06:59.81,0:07:02.85,Default,,0,0,0,,Гах... хаа ха...
Dialogue: 0,0:07:02.98,0:07:04.82,Default,,0,0,0,,Мен ұлттық мемлекеттік қызметшімін.
Dialogue: 0,0:07:05.59,0:07:06.85,Default,,0,0,0,,Мен мұны істегенім үшін кешіріледі деп ойладым...
Dialogue: 0,0:07:06.92,0:07:09.06,Default,,0,0,0,,Огура Икуя қайда?
Dialogue: 0,0:07:09.12,0:07:10.66,Default,,0,0,0,,Мен не айтып тұрғаныңызды түсінбеймін...
Dialogue: 0,0:07:10.73,0:07:12.56,Default,,0,0,0,,Гуааа...
Dialogue: 0,0:07:12.63,0:07:13.63,Default,,0,0,0,,Сол күні-
Dialogue: 0,0:07:13.90,0:07:16.43,Default,,0,0,0,,Сіз оққағарды атып өлтірдіңіз...
Dialogue: 0,0:07:16.66,0:07:18.67,Default,,0,0,0,,Доктор Огураны ұрлап кетті
Dialogue: 0,0:07:19.03,0:07:21.44,Default,,0,0,0,,Ол әлі бір жерде қамауда.
Dialogue: 0,0:07:21.50,0:07:22.87,Default,,0,0,0,,Мен неге олай жасадым...
Dialogue: 0,0:07:22.94,0:07:26.94,Default,,0,0,0,,Гах...
Dialogue: 0,0:07:27.01,0:07:29.64,Default,,0,0,0,,Гах...
Dialogue: 0,0:07:30.21,0:07:34.48,Default,,0,0,0,,Дәрігер – біздің елдегі жарты адам зерттеушілерінің бірі.
Dialogue: 0,0:07:35.12,0:07:38.65,Default,,0,0,0,,Бізге оның үйге қайтуы керек.
Dialogue: 0,0:07:38.72,0:07:40.76,Default,,0,0,0,,Егер сіздің шағымыңыз болса, Сатоға айтыңыз.
Dialogue: 0,0:07:41.46,0:07:42.46,Default,,0,0,0,,Ол өлтірді...
Dialogue: 0,0:07:42.52,0:07:43.93,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:07:44.59,0:07:47.83,Default,,0,0,0,,Гах... Гах...
Dialogue: 0,0:07:48.00,0:07:52.03,Default,,0,0,0,,Ах... уф...
Dialogue: 0,0:07:52.13,0:07:55.64,Default,,0,0,0,,Хаа… хаа… хаа…
Dialogue: 0,0:07:55.74,0:08:00.14,Default,,0,0,0,,Ғұн, бұл фарс, Тозаки мырза.
Dialogue: 0,0:08:00.74,0:08:02.61,Default,,0,0,0,,Дәрігер қайда... (Тосаки) Сондықтан да!
Dialogue: 0,0:08:05.75,0:08:08.92,Default,,0,0,0,,Сіз білмеймін дейсіз...
Dialogue: 0,0:08:12.75,0:08:16.99,Default,,0,0,0,,Бұл олардың білмегені емес, ұмытып кеткені емес пе?
Dialogue: 0,0:08:21.50,0:08:22.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:23.06,0:08:24.63,Default,,0,0,0,,Еске сала кетейін
Dialogue: 0,0:08:25.17,0:08:26.90,Default,,0,0,0,,(Кёсукэ Хори) Егер әке кетіп қалса—
Dialogue: 0,0:08:37.18,0:08:40.62,Default,,0,0,0,,Жоқ... не істейсің?
Dialogue: 0,0:08:40.98,0:08:43.15,Default,,0,0,0,,Айтыңызшы, Майерс.
Dialogue: 0,0:08:43.78,0:08:45.69,Default,,0,0,0,,Сіз бәрін білесіз
Dialogue: 0,0:08:46.69,0:08:48.09,Default,,0,0,0,,Джан Глайд
Dialogue: 0,0:08:48.92,0:08:54.00,Default,,0,0,0,,Диафрагманың салдануы, баяу тұншығу сезімі
Dialogue: 0,0:08:55.06,0:08:56.60,Default,,0,0,0,,Жоқ... тоқта...
Dialogue: 0,0:08:57.23,0:08:58.03,Default,,0,0,0,,(шприцтің шаншу дыбысы)
Dialogue: 0,0:08:58.60,0:08:59.23,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:09:00.10,0:09:02.84,Default,,0,0,0,,Демиадамдарды бейтараптандыру үшін қолданылатын препарат.
Dialogue: 0,0:09:03.57,0:09:08.31,Default,,0,0,0,,Егер сіз дозаны реттесеңіз, сіз өлтірілмейсіз, бірақ мәңгілік азап шегесіз.
Dialogue: 0,0:09:08.81,0:09:12.31,Default,,0,0,0,,Ха ха...
Dialogue: 0,0:09:12.65,0:09:16.68,Default,,0,0,0,,Хааххх...
Dialogue: 0,0:09:16.92,0:09:22.62,Default,,0,0,0,,Хаа...
Dialogue: 0,0:09:24.86,0:09:26.99,Default,,0,0,0,,Орын бастапқы жоспардан өзгергенімен...
Dialogue: 0,0:09:27.13,0:09:28.83,Default,,0,0,0,,Негізгі проблемалар жоқ
Dialogue: 0,0:09:28.93,0:09:32.23,Default,,0,0,0,,Негізінде мен бұрын жасаған В үлгісінің стратегиясын қолдандым.
Dialogue: 0,0:09:32.30,0:09:33.57,Default,,0,0,0,,Кеңейту
Dialogue: 0,0:09:33.87,0:09:36.64,Default,,0,0,0,,Өзгертілген бөліктер қызыл түспен жазылады.
Dialogue: 0,0:09:36.77,0:09:38.97,Default,,0,0,0,,Тек сол жердегі қозғалысты тексеріңіз.
Dialogue: 0,0:09:39.11,0:09:41.81,Default,,0,0,0,,Накано, сіз кейінірек сынақтан өтесіз.
Dialogue: 0,0:09:41.88,0:09:43.34,Default,,0,0,0,,Цубаки горилла емес—
Dialogue: 0,0:09:44.61,0:09:46.68,Default,,0,0,0,,Эй, Изуми-сан, кешігіп қалдың ба?
Dialogue: 0,0:09:47.21,0:09:49.65,Default,,0,0,0,,Қызық, Тозаки-санмен кешкі ас ішіп отырсың ба?
Dialogue: 0,0:09:49.88,0:09:52.12,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:09:52.59,0:09:54.69,Default,,0,0,0,,Ах, Изуми мырза, қош келдіңіз!
Dialogue: 0,0:09:54.99,0:09:57.06,Default,,0,0,0,,Мына киімде не болды?
Dialogue: 0,0:09:57.59,0:09:58.83,Default,,0,0,0,,Министрдің жұмыс кестесі...
Dialogue: 0,0:09:58.89,0:10:00.19,Default,,0,0,0,,Тозаки мырзаны ұрлап әкетті.
Dialogue: 0,0:10:00.26,0:10:02.10,Default,,0,0,0,,Доктор Огураның қамауда болуы әшкере болды.
Dialogue: 0,0:10:02.16,0:10:03.26,Default,,0,0,0,,Қорғаныс департаментінің қызметкерлеріне
Dialogue: 0,0:10:03.60,0:10:04.37,Default,,0,0,0,,Иә...
Dialogue: 0,0:10:04.87,0:10:07.03,Default,,0,0,0,,Мен енді Тозаки мырзаны құтқарамын.
Dialogue: 0,0:10:07.30,0:10:08.94,Default,,0,0,0,,Нагай-кун, стратегияңды жоспарла...
Dialogue: 0,0:10:09.00,0:10:10.00,Default,,0,0,0,,Хирасава мырза
Dialogue: 0,0:10:10.14,0:10:12.17,Default,,0,0,0,,Дереу тығылатын жер дайындаңыз.
Dialogue: 0,0:10:12.24,0:10:14.81,Default,,0,0,0,,Оны уақытша жасауға бола ма?
Dialogue: 0,0:10:14.88,0:10:17.78,Default,,0,0,0,,А, бұл мүмкін, бірақ...
Dialogue: 0,0:10:17.88,0:10:19.68,Default,,0,0,0,,Накано, жабдықты жина.
Dialogue: 0,0:10:19.75,0:10:21.88,Default,,0,0,0,,Не? Жабдық? Неге... (Кей) Тезірек!
Dialogue: 0,0:10:21.95,0:10:23.32,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:10:23.38,0:10:25.82,Default,,0,0,0,,Нагай-кун, не істеп жатырсың... (Кей) Манабе-сан мен Куроки-сан...
Dialogue: 0,0:10:25.89,0:10:27.96,Default,,0,0,0,,Қажетті заттарды көлікке салыңыз
Dialogue: 0,0:10:28.22,0:10:29.92,Default,,0,0,0,,Сузумура мырза – доктор Огура.
Dialogue: 0,0:10:30.22,0:10:32.03,Default,,0,0,0,,Менің бос отыратын уақытым жоқ.
Dialogue: 0,0:10:32.09,0:10:33.19,Default,,0,0,0,,Өтінемін, асығыңыз...
Dialogue: 0,0:10:33.93,0:10:36.06,Default,,0,0,0,,Нагай-кун! Сен не істеп жатырсың?
Dialogue: 0,0:10:36.16,0:10:39.40,Default,,0,0,0,,Не? Біз жасырынған жерді жылжытуға дайындалып жатырмыз.
Dialogue: 0,0:10:39.73,0:10:41.94,Default,,0,0,0,,ше? Жоқ, бұл дұрыс емес!
Dialogue: 0,0:10:42.00,0:10:43.10,Default,,0,0,0,,Біріншіден, Тозаки-сан...
Dialogue: 0,0:10:43.17,0:10:45.01,Default,,0,0,0,,Дұрыс, Нагай!
Dialogue: 0,0:10:45.07,0:10:47.04,Default,,0,0,0,,Тозаки-санды аяймын!
Dialogue: 0,0:10:47.11,0:10:48.21,Default,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,0:10:48.94,0:10:50.75,Default,,0,0,0,,Тозаки мырза қайда қамалды?
Dialogue: 0,0:10:50.81,0:10:52.15,Default,,0,0,0,,Иә? Жоқ, бұл...
Dialogue: 0,0:10:52.25,0:10:54.92,Default,,0,0,0,,Біздің басты мақсатымыз - Сатоны тоқтату.
Dialogue: 0,0:10:54.98,0:10:56.08,Default,,0,0,0,,Бірақ Тозаки-сан...
Dialogue: 0,0:10:56.18,0:10:58.69,Default,,0,0,0,,Алдымен Тозаки мырза жауап алады.
Dialogue: 0,0:10:58.85,0:11:01.36,Default,,0,0,0,,Аузыңды ашсаң, осы жерде нысанаға түсесің.
Dialogue: 0,0:11:02.06,0:11:03.92,Default,,0,0,0,,Егер бұл орын алса, біз аяқтадық.
Dialogue: 0,0:11:04.06,0:11:05.36,Default,,0,0,0,,Бірақ...!
Dialogue: 0,0:11:06.76,0:11:07.76,Default,,0,0,0,,Хирасава мырза!
Dialogue: 0,0:11:08.76,0:11:09.70,Default,,0,0,0,,Нагай…
Dialogue: 0,0:11:09.86,0:11:12.77,Default,,0,0,0,,Хирасава мырза, мен мұны бұрын айттым ғой, солай ма?
Dialogue: 0,0:11:13.00,0:11:15.87,Default,,0,0,0,,Мұнда этика мен эмоцияны үзу туралы шешім...
Dialogue: 0,0:11:15.94,0:11:17.74,Default,,0,0,0,,Бұл міндетті түрде қажет
Dialogue: 0,0:11:17.91,0:11:19.27,Default,,0,0,0,,Қазір уақыт.
Dialogue: 0,0:11:19.67,0:11:20.27,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:20.71,0:11:22.81,Default,,0,0,0,,Біріншіден, біздің қауіпсіздігімізді қамтамасыз етіңіз.
Dialogue: 0,0:11:22.88,0:11:25.21,Default,,0,0,0,,Содан кейін болашақ шараларды жоспарлаңыз
Dialogue: 0,0:11:25.31,0:11:28.88,Default,,0,0,0,,Рационалды ойлау, бұл дәл қазір жасай алатын ең жақсы нәрсе.
Dialogue: 0,0:11:29.42,0:11:32.69,Default,,0,0,0,,Жоқ, бірақ Тозаки мырза...
Dialogue: 0,0:11:34.26,0:11:36.22,Default,,0,0,0,,Егер жағдай керісінше болса--
Dialogue: 0,0:11:37.09,0:11:39.73,Default,,0,0,0,,Тозаки мырза да дәл осындай шешім қабылдаған болар еді.
Dialogue: 0,0:11:40.69,0:11:41.43,Default,,0,0,0,,Бұл...
Dialogue: 0,0:11:41.70,0:11:42.30,Default,,0,0,0,,Жылжыту
Dialogue: 0,0:11:48.87,0:11:52.84,Default,,0,0,0,,Бұл сіз бен менің жеке арамыздағы келісім-шарт.
Dialogue: 0,0:11:55.88,0:11:57.08,Default,,0,0,0,,Ұйым білмейді
Dialogue: 0,0:11:57.38,0:11:58.81,Default,,0,0,0,,Сіздің жұмысыңыз қандай?
Dialogue: 0,0:11:59.15,0:12:02.98,Default,,0,0,0,,«Менің өмірімді деми-адамдардың белгісіз қауіпінен қорғау үшін».
Dialogue: 0,0:12:04.29,0:12:05.99,Default,,0,0,0,,«Йоко Тайнака» өлді
Dialogue: 0,0:12:06.29,0:12:08.72,Default,,0,0,0,,Жаңа өмірді бүгіннен бастау
Dialogue: 0,0:12:10.02,0:12:12.16,Default,,0,0,0,,Алдымен бүркеншік есімді таңдаңыз.
Dialogue: 0,0:12:12.83,0:12:13.76,Default,,0,0,0,,Бүркеншік ат?
Dialogue: 0,0:12:14.30,0:12:17.36,Default,,0,0,0,,Жаңа өмір жаңа есімді қажет етеді
Dialogue: 0,0:12:17.83,0:12:19.33,Default,,0,0,0,,Алыстағы нәрсенің орнына...
Dialogue: 0,0:12:19.43,0:12:22.04,Default,,0,0,0,,Егер заттар бір-бірімен байланысты болса, оларға үйрену оңайырақ.
Dialogue: 0,0:12:24.91,0:12:29.08,Default,,0,0,0,,Сонда әкемнің тегі «Шимомура»...
Dialogue: 0,0:12:30.28,0:12:33.08,Default,,0,0,0,,Анамның "Изуми" атымен
Dialogue: 0,0:12:34.42,0:12:35.32,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:12:37.15,0:12:41.79,Default,,0,0,0,,Кеттік, сіз суық тиіп қаласыз, «Изуми Шимомура»
Dialogue: 0,0:12:46.06,0:12:46.89,Default,,0,0,0,,Жо-жоқ… мүмкін емес… осы сөмкенің ішінде не бар!
Dialogue: 0,0:12:47.93,0:12:49.46,Default,,0,0,0,,Мен қайталап көремін
Dialogue: 0,0:12:51.13,0:12:54.20,Default,,0,0,0,,Бұл жолы мен соңына дейін қашпаймын
Dialogue: 0,0:12:56.24,0:12:59.21,Default,,0,0,0,,Нагай Орын бекіттім, кез келген уақытта көшіп кете аламын.
Dialogue: 0,0:12:59.94,0:13:01.24,Default,,0,0,0,,Рахмет... Уф...
Dialogue: 0,0:13:08.55,0:13:09.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:09.52,0:13:13.52,Default,,0,0,0,,Егер мен Сатоның орнында болсам, сен өмір бойы қамауға алар едің.
Dialogue: 0,0:13:13.82,0:13:15.86,Default,,0,0,0,,Қараңғы және тар жерде.
Dialogue: 0,0:13:17.22,0:13:20.93,Default,,0,0,0,,Бірақ сіз Сато мырза емессіз.
Dialogue: 0,0:13:21.06,0:13:24.40,Default,,0,0,0,,Мені жеңе алмай тұрғанда Сатоны қалай тоқтатасың?
Dialogue: 0,0:13:24.50,0:13:27.23,Default,,0,0,0,,Сатоны жеңуге бізде бір ғана мүмкіндік бар.
Dialogue: 0,0:13:27.94,0:13:30.91,Default,,0,0,0,,Министрге шабуыл жасаған Сатоның жолын кесуден басқа амалым жоқ, бірақ...
Dialogue: 0,0:13:32.51,0:13:34.94,Default,,0,0,0,,Оның қашан болатынын тек Тозаки-сан ғана біледі.
Dialogue: 0,0:13:35.01,0:13:36.28,Default,,0,0,0,,Рационалды ойлау
Dialogue: 0,0:13:36.51,0:13:40.85,Default,,0,0,0,,Америкамен жекпе-жек таңдау, қалай қарасаңыз да, ақылға қонымсыз.
Dialogue: 0,0:13:43.22,0:13:45.19,Default,,0,0,0,,Мен жүктерімді салып бітірдім, Нагай.
Dialogue: 0,0:13:54.09,0:13:56.13,Default,,0,0,0,,Барлық багажды түсіріңіз.
Dialogue: 0,0:13:56.23,0:13:58.10,Default,,0,0,0,,ше? (Кей) Жоспарлар өзгерді.
Dialogue: 0,0:13:58.83,0:14:00.97,Default,,0,0,0,,Енді біз Тозаки-санды құтқарамыз.
Dialogue: 0,0:14:01.17,0:14:02.37,Default,,0,0,0,,Нагай!
Dialogue: 0,0:14:02.50,0:14:03.47,Default,,0,0,0,,Нагай мырза…
Dialogue: 0,0:14:06.87,0:14:10.98,Default,,0,0,0,,Егер сіз американдықтарға қарсы ойнасаңыз, бұл практикалық жаттығулардың дұрыс түрі.
Dialogue: 0,0:14:12.18,0:14:13.05,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:13.11,0:14:15.02,Default,,0,0,0,,Сізге алғыс айтуға уақытым жоқ.
Dialogue: 0,0:14:15.25,0:14:17.25,Default,,0,0,0,,Алдымен қамау орнын анықтау керек.
Dialogue: 0,0:14:18.22,0:14:19.39,Default,,0,0,0,,Минамиазабу
Dialogue: 0,0:14:19.45,0:14:20.22,Default,,0,0,0,,Не? (Изуми) Иә?
Dialogue: 0,0:14:20.52,0:14:23.29,Default,,0,0,0,,Мен соңғы рет пайдаланған қауіпсіз үй бар.
Dialogue: 0,0:14:24.12,0:14:26.53,Default,,0,0,0,,Мүмкін көзілдірік сонда шығар.
Dialogue: 0,0:14:27.16,0:14:29.16,Default,,0,0,0,,Сен маған мұны неге айтып тұрсың?
Dialogue: 0,0:14:29.96,0:14:31.57,Default,,0,0,0,,Огура мырза сол жақтан, солай ма?
Dialogue: 0,0:14:31.63,0:14:37.14,Default,,0,0,0,,Ха, мына асыл үлгінің алдында қиналып үйге қайтайын ба?
Dialogue: 0,0:14:37.44,0:14:38.21,Default,,0,0,0,,Иә
Dialogue: 0,0:14:38.97,0:14:41.91,Default,,0,0,0,,Минами-Азабуға бір сағаттан аз уақыт ішінде жете аласыз.
Dialogue: 0,0:14:42.44,0:14:43.88,Default,,0,0,0,,Қазір кетейік
Dialogue: 0,0:14:43.94,0:14:46.91,Default,,0,0,0,,Жарайды Сузумура, Огура-санды жылжыту керек.
Dialogue: 0,0:14:47.01,0:14:48.25,Default,,0,0,0,,Орналасқан жері реттелген.
Dialogue: 0,0:14:48.42,0:14:49.12,Default,,0,0,0,,Иә
Dialogue: 0,0:14:49.18,0:14:50.65,Default,,0,0,0,,Наканодағы жабдықты жүктеңіз
Dialogue: 0,0:14:50.92,0:14:52.02,Default,,0,0,0,,Ха! иә
Dialogue: 0,0:14:52.09,0:14:53.39,Default,,0,0,0,,Га
Dialogue: 0,0:14:56.12,0:14:56.66,Default,,0,0,0,,Нагай…
Dialogue: 0,0:14:56.92,0:14:59.06,Default,,0,0,0,,Егер бұл стратегия болса, оны қозғалыс кезінде орнатуға болады.
Dialogue: 0,0:15:00.23,0:15:01.30,Default,,0,0,0,,Кеттік, Изуми-сан!
Dialogue: 0,0:15:19.05,0:15:20.35,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:15:22.42,0:15:24.49,Default,,0,0,0,,Мен... білмеймін.
Dialogue: 0,0:15:25.32,0:15:28.09,Default,,0,0,0,,Мен... ештеңе
Dialogue: 0,0:15:29.66,0:15:30.49,Default,,0,0,0,,Майерс
Dialogue: 0,0:15:30.56,0:15:33.36,Default,,0,0,0,,Жүрек соғу жиілігі айтарлықтай төмендеді. Артық емес...
Dialogue: 0,0:15:33.43,0:15:36.40,Default,,0,0,0,,Мен сіздің пікіріңізді тыңдамаймын. Жаса.
Dialogue: 0,0:15:37.23,0:15:38.07,Default,,0,0,0,,Иә
Dialogue: 0,0:15:42.24,0:15:44.94,Default,,0,0,0,,Үй жануарына ие болу... қиын.
Dialogue: 0,0:15:49.28,0:15:50.04,Default,,0,0,0,,Ха!?
Dialogue: 0,0:15:54.62,0:15:55.48,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:16:01.22,0:16:03.69,Default,,0,0,0,,Біз тағы қанша IBM пайдалана аламыз?
Dialogue: 0,0:16:04.12,0:16:05.39,Default,,0,0,0,,Мүмкін нөл.
Dialogue: 0,0:16:05.46,0:16:07.43,Default,,0,0,0,,Мен Тозаки мырзаның уайымдап тұрғанын түсінемін, бірақ...
Dialogue: 0,0:16:08.13,0:16:10.13,Default,,0,0,0,,Сабыр сақтаңыз.
Dialogue: 0,0:16:10.73,0:16:11.73,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:16:14.03,0:16:15.50,Default,,0,0,0,,Қиямет! Бұл бұзушы!
Dialogue: 0,0:16:15.57,0:16:17.34,Default,,0,0,0,,Төтенше қуат көзі туралы не деуге болады?
Dialogue: 0,0:16:25.41,0:16:26.71,Default,,0,0,0,,Уф
Dialogue: 0,0:16:29.15,0:16:30.35,Default,,0,0,0,,(Цубаки) Косей! Уф!
Dialogue: 0,0:16:30.42,0:16:32.15,Default,,0,0,0,,Бұл қауіпсіздік құралы, ақымақ!
Dialogue: 0,0:16:32.22,0:16:33.15,Default,,0,0,0,,Және қалағаныңа қол жеткізе алмасаң—
Dialogue: 0,0:16:35.12,0:16:35.69,Default,,0,0,0,,О...
Dialogue: 0,0:16:38.56,0:16:39.39,Default,,0,0,0,,Ой…
Dialogue: 0,0:16:46.00,0:16:46.77,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:16:52.21,0:16:55.01,Default,,0,0,0,,Бұл Bravo One, қонақ бөлме жаулап алынды.
Dialogue: 0,0:16:56.24,0:16:58.58,Default,,0,0,0,,Хехе мен жасадым...
Dialogue: 0,0:16:59.15,0:17:00.18,Default,,0,0,0,,Ято деген құдай?
Dialogue: 0,0:17:01.18,0:17:03.02,Default,,0,0,0,,(баспалдақпен көтерілу дыбысы)
Dialogue: 0,0:17:03.08,0:17:04.72,Default,,0,0,0,,К-кешір!
Dialogue: 0,0:17:05.25,0:17:07.32,Default,,0,0,0,,(баспалдақпен көтерілу дыбысы)
Dialogue: 0,0:17:07.62,0:17:09.02,Default,,0,0,0,,Қарғыс атсын... Ат!
Dialogue: 0,0:17:11.33,0:17:12.06,Default,,0,0,0,,Не!
Dialogue: 0,0:17:18.43,0:17:20.33,Default,,0,0,0,,(Күзетшілер еңіреп)
Dialogue: 0,0:17:27.27,0:17:28.31,Default,,0,0,0,,Бақылауды қолға алыңыз!
Dialogue: 0,0:17:33.75,0:17:35.18,Default,,0,0,0,,C бөлмесі таза!
Dialogue: 0,0:17:35.38,0:17:36.52,Default,,0,0,0,,D бөлмесі таза
Dialogue: 0,0:17:36.72,0:17:38.59,Default,,0,0,0,,Қалғандары Е және F бөлмелері.
Dialogue: 0,0:17:38.75,0:17:40.35,Default,,0,0,0,,Альфа бірін түсінді
Dialogue: 0,0:17:42.12,0:17:43.36,Default,,0,0,0,,Мазасыз болмаңыз!
Dialogue: 0,0:17:44.22,0:17:45.16,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:17:47.53,0:17:50.70,Default,,0,0,0,,Бүгін екеуміздің де жолымыз болмады.
Dialogue: 0,0:17:56.80,0:17:57.77,Default,,0,0,0,,Тозаки мырза!
Dialogue: 0,0:17:58.11,0:17:58.71,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:18:13.15,0:18:14.39,Default,,0,0,0,,Өтінемін, байлау құралдарын әкеліңдер!
Dialogue: 0,0:18:14.46,0:18:15.22,Default,,0,0,0,,Ха! (Изуми) Ах!
Dialogue: 0,0:18:18.53,0:18:19.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:25.20,0:18:26.27,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:18:27.37,0:18:28.17,Default,,0,0,0,,Гррр…
Dialogue: 0,0:18:28.60,0:18:29.60,Default,,0,0,0,,Елес!
Dialogue: 0,0:18:32.77,0:18:33.77,Default,,0,0,0,,Жүр!
Dialogue: 0,0:18:38.81,0:18:40.11,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:18:40.31,0:18:41.82,Default,,0,0,0,,Менің орным неге бұзылды?
Dialogue: 0,0:18:42.35,0:18:43.48,Default,,0,0,0,,Ең алдымен туған елім...
Dialogue: 0,0:18:43.55,0:18:46.89,Default,,0,0,0,,Аузыңды жап, анау әйелдің қашып кетуіне жол бересің.
Dialogue: 0,0:18:47.62,0:18:50.29,Default,,0,0,0,,Мен сенің жазаңды алатыныңды қадағалаймын.
Dialogue: 0,0:18:50.79,0:18:52.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:53.89,0:18:57.50,Default,,0,0,0,,Цк, тіпті лайықты жолды таңдай алмайсың...
Dialogue: 0,0:18:57.63,0:19:00.23,Default,,0,0,0,,Мен сізге дәл қазір укол салғым келеді.
Dialogue: 0,0:19:06.71,0:19:07.57,Default,,0,0,0,,Олар кімдер?
Dialogue: 0,0:19:10.31,0:19:12.45,Default,,0,0,0,,Әлі қауіпсіз үйдің қасында жолда!
Dialogue: 0,0:19:12.78,0:19:16.15,Default,,0,0,0,,Сіз жаңа ғана екінші жолды оң жақта ұстадыңыз, бірақ асықпаңыз.
Dialogue: 0,0:19:16.22,0:19:17.68,Default,,0,0,0,,Балалар, мені «тазалауды» сұрайсыңдар (Манабе) Түсінемін.
Dialogue: 0,0:19:18.15,0:19:20.62,Default,,0,0,0,,Алдын алу және қысқыш шабуыл... (Изуми) Менің бұған уақытым жоқ!
Dialogue: 0,0:19:21.72,0:19:22.56,Default,,0,0,0,,Теня да батыр ма?
Dialogue: 0,0:19:41.58,0:19:43.58,Default,,0,0,0,,Цк, сондықтан айттым!
Dialogue: 0,0:19:44.51,0:19:46.21,Default,,0,0,0,,Изуми-сан, жақсысың ба? ?
Dialogue: 0,0:19:46.31,0:19:47.68,Default,,0,0,0,,Оң жаққа бұрылыңыз.
Dialogue: 0,0:19:48.48,0:19:49.58,Default,,0,0,0,,Изуми мырза!
Dialogue: 0,0:19:52.42,0:19:53.42,Default,,0,0,0,,Тозаки мырза ше?
Dialogue: 0,0:19:53.52,0:19:55.86,Default,,0,0,0,,Мен қазір сені қуып келемін. Сіз жете аласыз ба? Нагай! ?
Dialogue: 0,0:19:56.62,0:19:58.49,Default,,0,0,0,,Әй, Нагай! (Кей) Тыныш!
Dialogue: 0,0:19:58.93,0:20:02.46,Default,,0,0,0,,Бұл жаман, Хирасава-сан, олар қайда бара жатыр?
Dialogue: 0,0:20:03.76,0:20:05.33,Default,,0,0,0,,Америка елшілігі
Dialogue: 0,0:20:05.57,0:20:07.94,Default,,0,0,0,,Бұл мүмкін болатын ең нашар даму.
Dialogue: 0,0:20:08.20,0:20:10.47,Default,,0,0,0,,Не? неге?
Dialogue: 0,0:20:10.54,0:20:12.77,Default,,0,0,0,,Елшілік толығымен экстерриториялық
Dialogue: 0,0:20:12.94,0:20:16.61,Default,,0,0,0,,Полиция болсын, өзін-өзі қорғау күштері болсын, ешкім араласа алмайды.
Dialogue: 0,0:20:16.68,0:20:19.81,Default,,0,0,0,,Егер олар қашып кетсе, мұның соңы.
Dialogue: 0,0:20:19.88,0:20:21.25,Default,,0,0,0,,Неліктен! ?
Dialogue: 0,0:20:21.35,0:20:22.52,Default,,0,0,0,,Тек аузыңды жап!
Dialogue: 0,0:20:35.40,0:20:41.47,Default,,0,0,0,,♪Мен одан шаршадым, енді ауыстырайық♪
Dialogue: 0,0:20:41.74,0:20:46.91,Default,,0,0,0,,♪Сізде бар қалыпты♪
Dialogue: 0,0:20:48.01,0:20:54.31,Default,,0,0,0,,♪Жарқыраған Құдай картасы♪
Dialogue: 0,0:20:54.55,0:20:59.62,Default,,0,0,0,,♪Дұрыс қағаз картасы♪
Dialogue: 0,0:21:00.85,0:21:04.93,Default,,0,0,0,,♪Келесі жолы менің үйіме келесің♪
Dialogue: 0,0:21:07.36,0:21:11.40,Default,,0,0,0,,♪Мен саған бәрін көрсетемін♪
Dialogue: 0,0:21:11.73,0:21:13.53,Default,,0,0,0,,♪Себебі♪
Dialogue: 0,0:21:13.70,0:21:19.94,Default,,0,0,0,,♪Екі адам мектеп ауласының бұрышында, жел соғып тұр♪
Dialogue: 0,0:21:20.01,0:21:23.81,Default,,0,0,0,,♪Қазір айта аламын ба деп ойлаймын♪
Dialogue: 0,0:21:26.55,0:21:32.35,Default,,0,0,0,,♪Ешкімге айтпайтын сөздер♪
Dialogue: 0,0:21:32.85,0:21:38.99,Default,,0,0,0,,♪«Мен саған жақсы боламын, сондықтан маған қонаққа кел»♪
Dialogue: 0,0:21:39.36,0:21:44.80,Default,,0,0,0,,♪«Мен саған бәрін беремін, эй»♪
Dialogue: 0,0:21:45.70,0:21:55.08,Default,,0,0,0,,♪"Мәңгілік дос болайық"♪
Dialogue: 0,0:21:56.58,0:22:02.58,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
