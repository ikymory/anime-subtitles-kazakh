Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.57,0:00:04.33,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:00:04.47,0:00:05.33,Default,,0,0,0,,Ой
Dialogue: 0,0:00:05.57,0:00:08.67,Default,,0,0,0,,Сіз...адамдарды ойламайсыз ба?
Dialogue: 0,0:00:09.04,0:00:11.71,Default,,0,0,0,,Саған қашуға көмектескен досың ше?
Dialogue: 0,0:00:12.31,0:00:14.21,Default,,0,0,0,,Маған бұл енді керек емес
Dialogue: 0,0:00:15.08,0:00:16.58,Default,,0,0,0,,Аузыңды жап! (Кей) Уау...
Dialogue: 0,0:00:17.18,0:00:20.35,Default,,0,0,0,,Ақымақ, ақымақ, ақымақ, ақымақ
Dialogue: 0,0:00:20.45,0:00:22.18,Default,,0,0,0,,Ақымақ - ақымақ
Dialogue: 0,0:00:22.28,0:00:23.79,Default,,0,0,0,,Ханедадан Наха әуежайына дейін -
Dialogue: 0,0:00:24.09,0:00:25.49,Default,,0,0,0,,TA рейсі 167...
Dialogue: 0,0:00:25.62,0:00:27.52,Default,,0,0,0,,Мен Сидзуока префектурасының жағалауына шұғыл қондым.
Dialogue: 0,0:00:28.32,0:00:31.76,Default,,0,0,0,,Бұл Сато, сөзсіз.
Dialogue: 0,0:00:33.23,0:00:35.20,Default,,0,0,0,,Күзетшіні ату
Dialogue: 0,0:00:35.46,0:00:36.23,Default,,0,0,0,,(CA-ның айқайы)
Dialogue: 0,0:00:36.46,0:00:39.30,Default,,0,0,0,,Осыдан кейін...Сакурай-сан.
Dialogue: 0,0:00:41.37,0:00:42.17,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:00:42.27,0:00:45.74,Default,,0,0,0,,Сосын есік жарылып кетті...
Dialogue: 0,0:00:47.41,0:00:49.24,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:00:49.78,0:00:52.28,Default,,0,0,0,,Вакай мен Сакурай мырзаны өлтіру
Dialogue: 0,0:00:52.65,0:00:56.35,Default,,0,0,0,,Сато, осы оқиғалар сериясының ұйымдастырушысы...
Dialogue: 0,0:00:56.75,0:01:00.16,Default,,0,0,0,,Біз, полицейлер, өзіміздің абыройымыз бен мақтанышымызды желге қоямыз...
Dialogue: 0,0:01:00.52,0:01:03.09,Default,,0,0,0,,Мен сізді тұтқындаймын.
Dialogue: 0,0:01:07.10,0:01:08.83,Default,,0,0,0,,Алда әлі көп...
Dialogue: 0,0:01:09.40,0:01:13.17,Default,,0,0,0,,Сіз оны түсінген кездегі жетістік сезімі ерекше.
Dialogue: 0,0:01:14.77,0:01:16.17,Default,,0,0,0,,Көңілді болайық
Dialogue: 0,0:01:26.51,0:01:28.68,Default,,0,0,0,,♪Жақын шайқас, бөлшектену♪
Dialogue: 0,0:01:29.18,0:01:33.76,Default,,0,0,0,,♪ Менің алдымда кім тұрсың? ♪
Dialogue: 0,0:01:40.50,0:01:43.20,Default,,0,0,0,,♪Қашуды жалғастыру мәңгілік емес♪
Dialogue: 0,0:01:43.50,0:01:46.27,Default,,0,0,0,,♪Нағыз нәрсені шайнап, жұту♪
Dialogue: 0,0:01:46.33,0:01:51.17,Default,,0,0,0,,♪Айғайлап, түсініксіздікті кесіп таста♪
Dialogue: 0,0:01:51.44,0:01:54.11,Default,,0,0,0,,♪Көлеңкенің қауіптілігін білу♪
Dialogue: 0,0:01:54.18,0:01:56.78,Default,,0,0,0,,♪Тым сабырлы жүйе♪
Dialogue: 0,0:01:56.85,0:02:00.15,Default,,0,0,0,,♪ ҚОСУ немесе ӨШІРУ Қазір қайсысын таңдар едіңіз? ♪
Dialogue: 0,0:02:01.42,0:02:04.69,Default,,0,0,0,,♪Нәтиже Мен өз эмоцияларымды қанша рет өлтіремін♪
Dialogue: 0,0:02:04.75,0:02:07.39,Default,,0,0,0,,♪Жоқ, ол бірінші орында өтіп кетті♪
Dialogue: 0,0:02:07.46,0:02:10.63,Default,,0,0,0,,♪Ол жай ғана жойылды♪
Dialogue: 0,0:02:11.63,0:02:14.26,Default,,0,0,0,,♪Мені жалғыз қалдыршы Craze♪
Dialogue: 0,0:02:14.33,0:02:17.77,Default,,0,0,0,,♪Мен жай ғана менмін және мен шарасызмын♪
Dialogue: 0,0:02:18.23,0:02:19.43,Default,,0,0,0,,♪иә иә♪
Dialogue: 0,0:02:19.50,0:02:22.24,Default,,0,0,0,,♪Басынан тек тәуекелдерден баста♪
Dialogue: 0,0:02:22.34,0:02:24.67,Default,,0,0,0,,♪Жынды болыңыз♪
Dialogue: 0,0:02:24.74,0:02:26.88,Default,,0,0,0,,♪Инстинктіңізді, шынайы болмысыңызды ашыңыз♪
Dialogue: 0,0:02:27.14,0:02:30.68,Default,,0,0,0,,♪Тексеру шабуылы иә♪
Dialogue: 0,0:02:30.81,0:02:35.15,Default,,0,0,0,,♪Мені жұлып алған сен кімсің? ♪
Dialogue: 0,0:03:01.68,0:03:03.48,Default,,0,0,0,,(Түтін шығару дыбысы)
Dialogue: 0,0:03:05.45,0:03:06.28,Default,,0,0,0,,Огура мырза
Dialogue: 0,0:03:07.75,0:03:09.48,Default,,0,0,0,,Егер бұл темекі болса, мен оны істемеймін.
Dialogue: 0,0:03:09.88,0:03:11.75,Default,,0,0,0,,Бұл менің теломерам
Dialogue: 0,0:03:12.22,0:03:13.32,Default,,0,0,0,,Темекі?
Dialogue: 0,0:03:14.26,0:03:16.22,Default,,0,0,0,,Бұл хромосоманың соңғы бөлігі ме?
Dialogue: 0,0:03:16.49,0:03:17.89,Default,,0,0,0,,Сіз мені өте жақсы білесіз.
Dialogue: 0,0:03:18.53,0:03:21.43,Default,,0,0,0,,Өйткені, мен медициналық институтқа түскім келді.
Dialogue: 0,0:03:22.40,0:03:24.73,Default,,0,0,0,,Құқық бұзушы болғың келеді, солай ма?
Dialogue: 0,0:03:26.77,0:03:29.24,Default,,0,0,0,,Мен мұнда темекі сұрау үшін келген жоқпын.
Dialogue: 0,0:03:29.67,0:03:31.37,Default,,0,0,0,,Сонда оның мәні неде?
Dialogue: 0,0:03:36.88,0:03:38.35,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:03:39.55,0:03:40.98,Default,,0,0,0,,Мұнда шатыры бар. Садақ пен жебелер осында болуы мүмкін.
Dialogue: 0,0:03:43.22,0:03:46.45,Default,,0,0,0,,Соңғы кездері соншалықты жомарт болдың ба?
Dialogue: 0,0:03:47.66,0:03:51.79,Default,,0,0,0,,Итіңіз үшін қобалжу - бұл ауыр әзіл.
Dialogue: 0,0:03:54.30,0:03:58.27,Default,,0,0,0,,Бақылай алмасаң, көп шығарсаң да пайдасы жоқ.
Dialogue: 0,0:03:58.73,0:03:59.93,Default,,0,0,0,,Оның себебі неде?
Dialogue: 0,0:04:08.41,0:04:11.98,Default,,0,0,0,,Көшенің арғы бетіндегі әйелді бір бала семіз деп атады.
Dialogue: 0,0:04:12.41,0:04:14.65,Default,,0,0,0,,Иә? Бірақ ол жаман бала емес.
Dialogue: 0,0:04:14.82,0:04:17.79,Default,,0,0,0,,Мен анамның үйреншікті ғайбатына еліктедім.
Dialogue: 0,0:04:18.25,0:04:20.56,Default,,0,0,0,,Айова деми-адамдар жағдайында көріп отырғанымыздай:
Dialogue: 0,0:04:20.69,0:04:25.43,Default,,0,0,0,,Тәуелсіз IBM әрекеті иесінің табиғатына байланысты.
Dialogue: 0,0:04:25.99,0:04:29.36,Default,,0,0,0,,Мысалы, егер сіз адамдарды жек көрсеңіз...
Dialogue: 0,0:04:29.46,0:04:32.93,Default,,0,0,0,,Зорлық-зомбылық әрекеттерін тудырады
Dialogue: 0,0:04:34.30,0:04:35.90,Default,,0,0,0,,IBM өзгерткіңіз келсе-
Dialogue: 0,0:04:36.77,0:04:38.61,Default,,0,0,0,,Өзіңізді өзгертіңіз
Dialogue: 0,0:04:40.98,0:04:42.71,Default,,0,0,0,,Адамдар өзгермейді
Dialogue: 0,0:04:42.88,0:04:43.91,Default,,0,0,0,,Жақсы
Dialogue: 0,0:04:45.55,0:04:46.38,Default,,0,0,0,,Нагай
Dialogue: 0,0:04:47.85,0:04:49.32,Default,,0,0,0,,Тозаки мырза қоңырау шалып жатыр.
Dialogue: 0,0:04:49.42,0:04:50.72,Default,,0,0,0,,А... иә
Dialogue: 0,0:04:54.56,0:04:56.86,Default,,0,0,0,,Бұл не? Бұл дұрыс емес.
Dialogue: 0,0:05:03.87,0:05:05.43,Default,,0,0,0,,13 адам кетті
Dialogue: 0,0:05:05.87,0:05:08.47,Default,,0,0,0,,Жау әрқашан бір жерде пайда болады.
Dialogue: 0,0:05:08.64,0:05:10.87,Default,,0,0,0,,Сондықтан буксирлеу жақсы идея.
Dialogue: 0,0:05:11.44,0:05:13.71,Default,,0,0,0,,Сұрақ: кімге баруым керек...
Dialogue: 0,0:05:13.81,0:05:15.61,Default,,0,0,0,,Келесі жаға біреу болуы керек.
Dialogue: 0,0:05:15.84,0:05:17.55,Default,,0,0,0,,Біздің енді өлтіруге шамасы жоқ, солай ма?
Dialogue: 0,0:05:17.65,0:05:18.48,Default,,0,0,0,,Қабылданбады.
Dialogue: 0,0:05:18.61,0:05:20.95,Default,,0,0,0,,Киши-сенсэй әлдеқашан бір жерде жасырынып жүр...
Dialogue: 0,0:05:21.05,0:05:22.95,Default,,0,0,0,,Жақын күзет астында
Dialogue: 0,0:05:23.05,0:05:25.72,Default,,0,0,0,,Оның қайда екені маған да айтылмады.
Dialogue: 0,0:05:26.32,0:05:28.82,Default,,0,0,0,,Егер Тозаки мырза тізімде болса, оны жем ретінде пайдалануға болар еді.
Dialogue: 0,0:05:28.89,0:05:30.49,Default,,0,0,0,,Нагайдың аузын жап
Dialogue: 0,0:05:30.89,0:05:34.50,Default,,0,0,0,,Бірақ сонда бір ғана адам қалды, солай ма?
Dialogue: 0,0:05:35.06,0:05:37.67,Default,,0,0,0,,Иә, шарттарға сай келетіндер...
Dialogue: 0,0:05:38.53,0:05:40.33,Default,,0,0,0,,14 мақсат…
Dialogue: 0,0:05:41.04,0:05:43.54,Default,,0,0,0,,Бұл денсаулық сақтау, еңбек және әл-ауқат министрі (шабуыл) иә?
Dialogue: 0,0:05:43.77,0:05:45.81,Default,,0,0,0,,Сонда қалғандарың өлесің! ?
Dialogue: 0,0:05:46.04,0:05:47.34,Default,,0,0,0,,Барлық мақсаттар -
Dialogue: 0,0:05:47.41,0:05:49.51,Default,,0,0,0,,Полиция қорғауында болумен қатар...
Dialogue: 0,0:05:49.68,0:05:52.01,Default,,0,0,0,,Шабуылдың қашан және қай жерде болатыны белгісіз.
Dialogue: 0,0:05:52.41,0:05:53.95,Default,,0,0,0,,Біз көмектесе алмаймыз
Dialogue: 0,0:05:54.05,0:05:55.72,Default,,0,0,0,,Ах… Ух…
Dialogue: 0,0:05:57.12,0:06:00.82,Default,,0,0,0,,Бірақ егер сіз министр болсаңыз, Тозаки мырза сіздің кестеңізді біле алады.
Dialogue: 0,0:06:01.06,0:06:02.06,Default,,0,0,0,,Егер сіз мұны түсінсеңіз...
Dialogue: 0,0:06:02.36,0:06:05.36,Default,,0,0,0,,Сіз шабуылдың күнін, уақытын және орнын болжай аласыз.
Dialogue: 0,0:06:05.79,0:06:06.89,Default,,0,0,0,,Министр өлтірілгенге дейін...
Dialogue: 0,0:06:07.36,0:06:10.36,Default,,0,0,0,,Сато мырзаның шабуыл тенденциялары туралы да біле аласыз.
Dialogue: 0,0:06:10.47,0:06:11.00,Default,,0,0,0,,О
Dialogue: 0,0:06:11.60,0:06:13.67,Default,,0,0,0,,Олай болса, қалғаны менде...
Dialogue: 0,0:06:13.80,0:06:16.77,Default,,0,0,0,,Ұрысқа араласуға мүмкіндік беретін шараларды қабылдаңыз
Dialogue: 0,0:06:17.00,0:06:20.74,Default,,0,0,0,,Осы уақытта шабуылдар болуы мүмкін ықтимал орындар.
Dialogue: 0,0:06:20.94,0:06:22.48,Default,,0,0,0,,Мен біразын алдым
Dialogue: 0,0:06:22.64,0:06:25.95,Default,,0,0,0,,Сонымен, сіз әр орынға стратегия дайындайсыз ба?
Dialogue: 0,0:06:26.51,0:06:29.62,Default,,0,0,0,,Қалай күресу керек деген сұрақ қалады.
Dialogue: 0,0:06:29.92,0:06:31.45,Default,,0,0,0,,Үш жарты адам бар.
Dialogue: 0,0:06:31.79,0:06:34.76,Default,,0,0,0,,Жаудан сан жағынан кем болсақ та, алдын ала дайындала аламыз.
Dialogue: 0,0:06:34.82,0:06:36.56,Default,,0,0,0,,Бұл жерде географиялық артықшылық бар ма?
Dialogue: 0,0:06:36.66,0:06:39.73,Default,,0,0,0,,Үш адам? Сіз Шимомура мырзаны пайдалана алмайсыз.
Dialogue: 0,0:06:39.79,0:06:40.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:42.03,0:06:44.03,Default,,0,0,0,,Қандай кемшіліктер бар? (Шабуыл) Мұндай қауіпті нәрсе...
Dialogue: 0,0:06:44.10,0:06:45.77,Default,,0,0,0,,Сіз мені әйел ете аласыз ба?
Dialogue: 0,0:06:47.54,0:06:49.84,Default,,0,0,0,,Бізде спорт күні жоқ.
Dialogue: 0,0:06:50.04,0:06:53.07,Default,,0,0,0,,Сіз баласыз ба, мейлі қарт адам болсаңыз да, қолыңыздан келгенді пайдаланыңыз.
Dialogue: 0,0:06:53.41,0:06:54.11,Default,,0,0,0,,Сіз!
Dialogue: 0,0:06:54.44,0:06:56.88,Default,,0,0,0,,Накано-кун, мен бақыттымын, бірақ бұл тітіркендіргіш.
Dialogue: 0,0:06:57.15,0:06:59.58,Default,,0,0,0,,Жұмысты өткізіп жіберуге ниетім жоқ.
Dialogue: 0,0:07:00.52,0:07:01.85,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:02.58,0:07:03.82,Default,,0,0,0,,Әрине, білемін.
Dialogue: 0,0:07:05.99,0:07:07.66,Default,,0,0,0,,Хмм... мм
Dialogue: 0,0:07:10.12,0:07:12.53,Default,,0,0,0,,Жарайды, әзірше үзіліс жасайық.
Dialogue: 0,0:07:12.96,0:07:15.16,Default,,0,0,0,,Менің де электрондық поштам бар, оны қайтаруым керек.
Dialogue: 0,0:07:15.43,0:07:18.03,Default,,0,0,0,,Тозаки-сан, бұлай ұзақ уақыт алу дұрыс па?
Dialogue: 0,0:07:18.47,0:07:20.54,Default,,0,0,0,,Асыққаннан кейін жай ғана жайбарақат болады.
Dialogue: 0,0:07:20.60,0:07:24.11,Default,,0,0,0,,Тіпті Сато үшін Киши-сенсэйдің қайда екенін анықтау оңай емес.
Dialogue: 0,0:07:26.61,0:07:27.88,Default,,0,0,0,,Содан кейін, Накано
Dialogue: 0,0:07:27.98,0:07:28.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:28.84,0:07:30.58,Default,,0,0,0,,Мен Тосакимін
Dialogue: 0,0:07:31.01,0:07:32.15,Default,,0,0,0,,Мұқият есте сақтаңыз
Dialogue: 0,0:07:32.45,0:07:32.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:33.85,0:07:34.52,Default,,0,0,0,,Е... хехе
Dialogue: 0,0:07:35.22,0:07:35.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:37.72,0:07:38.45,Default,,0,0,0,,А...
Dialogue: 0,0:07:43.22,0:07:45.83,Default,,0,0,0,,Әй, бұл мүмкін емес деген не? Бұл мүмкін емес пе?
Dialogue: 0,0:07:46.06,0:07:48.13,Default,,0,0,0,,Егер сізде ондай болса, сіз бәрін жасай аласыз...
Dialogue: 0,0:07:48.20,0:07:49.70,Default,,0,0,0,,Мақтанатын болдыңыз ғой, солай ма?
Dialogue: 0,0:07:49.96,0:07:51.63,Default,,0,0,0,,Жалпы ереже бойынша заттар...
Dialogue: 0,0:07:51.73,0:07:54.50,Default,,0,0,0,,Сіз жасай алатын және жасай алмайтын нәрселер бар.
Dialogue: 0,0:07:55.64,0:07:57.51,Default,,0,0,0,,Ей, сіз қандай да бір жетістіктерге жеттіңіз бе?
Dialogue: 0,0:07:57.91,0:07:59.04,Default,,0,0,0,,Сізге сәттілік жетіспеді.
Dialogue: 0,0:07:59.21,0:08:02.48,Default,,0,0,0,,Басқару комитеті мен Денсаулық сақтау, Еңбек және әл-ауқат министрлігінің серверлері Мен оны келесі күні сынап көрдім...
Dialogue: 0,0:08:02.58,0:08:03.64,Default,,0,0,0,,Ол жай ғана шықпайды.
Dialogue: 0,0:08:04.08,0:08:06.71,Default,,0,0,0,,Жақсырақ, жағадан өтіңіз...
Dialogue: 0,0:08:06.81,0:08:08.95,Default,,0,0,0,,Алдымен Кейта Ивасакиді ойнағыңыз келе ме?
Dialogue: 0,0:08:09.82,0:08:10.99,Default,,0,0,0,,Қабылданбаған.
Dialogue: 0,0:08:11.72,0:08:14.09,Default,,0,0,0,,Бұл жолы ретімен орындауды жөн көрдім.
Dialogue: 0,0:08:14.52,0:08:15.96,Default,,0,0,0,,Ережелерді орындаңыз
Dialogue: 0,0:08:16.06,0:08:17.23,Default,,0,0,0,,Ойынмен бірдей
Dialogue: 0,0:08:17.73,0:08:20.80,Default,,0,0,0,,Бірақ сіз қайда екеніңізді білмесеңіз, осында тұрып қалдыңыз.
Dialogue: 0,0:08:22.00,0:08:24.87,Default,,0,0,0,,Ойындар трюкпен келеді, солай ма?
Dialogue: 0,0:08:25.20,0:08:27.20,Default,,0,0,0,,Киши-санның қайда екенін білмесем де...
Dialogue: 0,0:08:27.70,0:08:30.07,Default,,0,0,0,,Сізге тек сізді күзететін полицияның орналасқан жерін білу қажет.
Dialogue: 0,0:08:30.17,0:08:30.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:31.64,0:08:34.81,Default,,0,0,0,,Иә, елордалық полиция департаментін бұзыңыз.
Dialogue: 0,0:08:36.78,0:08:39.08,Default,,0,0,0,,Жоқ, бұл «орындауға болатын нәрселерге» жатады.
Dialogue: 0,0:08:39.68,0:08:42.75,Default,,0,0,0,,Әрине, нөлден бастау бірнеше күн алады...
Dialogue: 0,0:08:42.85,0:08:44.99,Default,,0,0,0,,Денсаулық сақтау, Еңбек және әл-ауқат министрлігі сияқты, сонымен қатар Елордалық полиция департаментінің серверінде.
Dialogue: 0,0:08:45.05,0:08:46.52,Default,,0,0,0,,Дағдарысты басқару инженерлері
Dialogue: 0,0:08:46.59,0:08:48.09,Default,,0,0,0,,Олар артқы есікті орнатқан болуы керек.
Dialogue: 0,0:08:48.22,0:08:49.79,Default,,0,0,0,,Бар болғаны қарызға алсаңыз болғаны...
Dialogue: 0,0:08:49.89,0:08:51.06,Default,,0,0,0,,Егер тауып алсаңыз, артқы есіктен өтіңіз...
Dialogue: 0,0:08:51.16,0:08:52.59,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:08:53.76,0:08:55.83,Default,,0,0,0,,...Журналдар да өшіріледі, сондықтан кіру іздері болмайды...
Dialogue: 0,0:08:55.96,0:08:58.20,Default,,0,0,0,,Қысқасы, бұл қулық, солай ма?
Dialogue: 0,0:09:05.87,0:09:07.01,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:09:08.21,0:09:10.11,Default,,0,0,0,,Қорғау нысанасы - Юджи Киши.
Dialogue: 0,0:09:10.58,0:09:12.15,Default,,0,0,0,,ОМОН екі бөлімшеге бөлінген
Dialogue: 0,0:09:12.25,0:09:15.75,Default,,0,0,0,,Жол қозғалысы бөлімі мен Тіршілік қауіпсіздігі бөлімі шақырылды.
Dialogue: 0,0:09:16.05,0:09:19.85,Default,,0,0,0,,Жау да олай болып көріне алмайтын сияқты.
Dialogue: 0,0:09:20.66,0:09:21.32,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:09:24.13,0:09:25.56,Default,,0,0,0,,Тауда
Dialogue: 0,0:09:29.66,0:09:31.07,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:09:35.07,0:09:37.14,Default,,0,0,0,,Сәл тынышталсаңыз қалай болады?
Dialogue: 0,0:09:37.71,0:09:39.57,Default,,0,0,0,,Бұдан былай бұл ұзаққа созылмайды.
Dialogue: 0,0:09:41.61,0:09:42.91,Default,,0,0,0,,Шинигами қалай өледі екен.
Dialogue: 0,0:09:48.68,0:09:49.12,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:09:50.62,0:09:51.19,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:09:53.82,0:09:55.16,Default,,0,0,0,,Ха... а...
Dialogue: 0,0:09:57.83,0:09:58.69,Default,,0,0,0,,Бұл елес.
Dialogue: 0,0:09:59.03,0:09:59.89,Default,,0,0,0,,Уау...
Dialogue: 0,0:10:01.33,0:10:02.63,Default,,0,0,0,,(шағу дыбысы)
Dialogue: 0,0:10:04.77,0:10:06.63,Default,,0,0,0,,(ОМОН қызметкерлері айқайлайды)
Dialogue: 0,0:10:07.13,0:10:09.07,Default,,0,0,0,,(ОМОН қызметкерлерінің ішке кіріп келе жатқан дыбысы)
Dialogue: 0,0:10:09.20,0:10:10.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:19.95,0:10:23.65,Default,,0,0,0,,IBM жоюдың екі жолы бар.
Dialogue: 0,0:10:24.65,0:10:26.02,Default,,0,0,0,,Конвергенцияны күту керек пе?
Dialogue: 0,0:10:26.69,0:10:29.62,Default,,0,0,0,,IBM компаниясының басына тиген соққы.
Dialogue: 0,0:10:35.66,0:10:37.93,Default,,0,0,0,,Егер IBM бір-бірімен соқтығысса -
Dialogue: 0,0:10:38.03,0:10:41.34,Default,,0,0,0,,Ақпараты әртүрлі бөлшектер араласады
Dialogue: 0,0:10:42.40,0:10:44.81,Default,,0,0,0,,Бұл, былайша айтқанда, өзара тілдесудің күйі.
Dialogue: 0,0:10:45.74,0:10:49.21,Default,,0,0,0,,Рекомбинациялануы керек бөлшектермен байланыс жоғалады...
Dialogue: 0,0:10:49.64,0:10:52.38,Default,,0,0,0,,Нәтижені ауыстыру
Dialogue: 0,0:10:53.11,0:10:54.75,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:10:55.15,0:10:57.95,Default,,0,0,0,,Сабақ кезінде көзілдірікті өшіріңіз.
Dialogue: 0,0:10:58.02,0:10:58.82,Default,,0,0,0,,Бұл Тозаки.
Dialogue: 0,0:11:00.35,0:11:01.29,Default,,0,0,0,,Не! ?
Dialogue: 0,0:11:02.22,0:11:03.16,Default,,0,0,0,,Неліктен білдің?
Dialogue: 0,0:11:05.93,0:11:07.80,Default,,0,0,0,,А, мен мұны сізге қалдырамын.
Dialogue: 0,0:11:08.33,0:11:09.83,Default,,0,0,0,,Мен де жақында қайтамын.
Dialogue: 0,0:11:12.03,0:11:13.13,Default,,0,0,0,,Сіз Киши-сансыз ба?
Dialogue: 0,0:11:13.80,0:11:15.44,Default,,0,0,0,,О, мен жеңілдім.
Dialogue: 0,0:11:15.74,0:11:16.17,Default,,0,0,0,,Бұл тек менің қиялым ғана болды.
Dialogue: 0,0:11:16.84,0:11:19.44,Default,,0,0,0,,Қауіпсіздікті күшейткен бойда мені IBM өлтірді.
Dialogue: 0,0:11:20.31,0:11:20.98,Default,,0,0,0,,Өзіңді тым биік ұстама
Dialogue: 0,0:11:21.38,0:11:23.24,Default,,0,0,0,,Сіздің тұрған жеріңіз неліктен белгілі болды?
Dialogue: 0,0:11:23.38,0:11:24.25,Default,,0,0,0,,Белгісіз
Dialogue: 0,0:11:25.35,0:11:27.28,Default,,0,0,0,,Егер сіз білмесеңіз...
Dialogue: 0,0:11:27.38,0:11:29.85,Default,,0,0,0,,Қайда жасырсам да, пайдасы жоқ.
Dialogue: 0,0:11:30.08,0:11:31.72,Default,,0,0,0,,Уақытты сатып ала алмайсыз.
Dialogue: 0,0:11:31.89,0:11:35.06,Default,,0,0,0,,Біздің артықшылығымыз біреуге азайды.
Dialogue: 0,0:11:38.16,0:11:43.30,Default,,0,0,0,,Соңғы кездері IBM-де оқуды өткізіп жібергеніңізді естідім.
Dialogue: 0,0:11:44.83,0:11:48.27,Default,,0,0,0,,Біздің ең үлкен күшіміз - сіздің IBM.
Dialogue: 0,0:11:48.97,0:11:51.14,Default,,0,0,0,,Оны қалай пайдалану керектігін мүмкіндігінше тезірек үйреніңіз.
Dialogue: 0,0:11:51.27,0:11:52.14,Default,,0,0,0,,Тек жалаңаш, бос жер учаскесін қалдырады…
Dialogue: 0,0:12:00.28,0:12:04.39,Default,,0,0,0,,Сіз осы топтың теломерасы сияқтысыз.
Dialogue: 0,0:12:08.06,0:12:10.09,Default,,0,0,0,,(Оқ тиген дыбыс)
Dialogue: 0,0:12:10.99,0:12:12.36,Default,,0,0,0,,Жау қарулы
Dialogue: 0,0:12:12.83,0:12:15.46,Default,,0,0,0,,Ең болмағанда атыс қаруын қалай қолдану керектігін есте сақтаңыз.
Dialogue: 0,0:12:15.96,0:12:16.73,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:12:18.50,0:12:19.73,Default,,0,0,0,,Алдымен оны алыңыз.
Dialogue: 0,0:12:20.77,0:12:21.34,Default,,0,0,0,,Келесі…
Dialogue: 0,0:12:25.37,0:12:26.91,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:12:26.97,0:12:28.44,Default,,0,0,0,,(Оқ тиген дыбыс)
Dialogue: 0,0:12:29.18,0:12:30.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:31.48,0:12:34.15,Default,,0,0,0,,Машиналар сіздің айтқаныңызды тыңдайды, сондықтан маған ұнайды.
Dialogue: 0,0:12:34.92,0:12:35.32,Default,,0,0,0,,Фу…
Dialogue: 0,0:12:35.78,0:12:36.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:36.88,0:12:37.95,Default,,0,0,0,,Жылдам өрт түймесі жоқ па?
Dialogue: 0,0:12:38.05,0:12:40.86,Default,,0,0,0,,Шулы! Жарайды, алдымен қарап ал.
Dialogue: 0,0:12:41.92,0:12:43.92,Default,,0,0,0,,Ах, о!
Dialogue: 0,0:12:47.29,0:12:49.06,Default,,0,0,0,,Иә? Мен шыға алмаймын
Dialogue: 0,0:12:49.93,0:12:50.80,Default,,0,0,0,,Маған қарызға бер
Dialogue: 0,0:12:52.87,0:12:53.37,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:12:54.07,0:12:54.90,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:12:57.00,0:12:57.47,Default,,0,0,0,,Хехе
Dialogue: 0,0:12:58.84,0:12:59.31,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:12:59.37,0:13:00.41,Default,,0,0,0,,Dowa! Эй!
Dialogue: 0,0:13:00.51,0:13:02.88,Default,,0,0,0,,Ей, ақымақ, неге жібересің?
Dialogue: 0,0:13:03.34,0:13:04.48,Default,,0,0,0,,Менің қолым қолымда.
Dialogue: 0,0:13:05.21,0:13:06.41,Default,,0,0,0,,Сіз әйелсіз бе?
Dialogue: 0,0:13:06.78,0:13:07.98,Default,,0,0,0,,Сіз айттыңыз...
Dialogue: 0,0:13:08.08,0:13:09.52,Default,,0,0,0,,Оған көмектесу мүмкін емес, солай ма?
Dialogue: 0,0:13:09.82,0:13:10.22,Default,,0,0,0,,(тілді шертеді)
Dialogue: 0,0:13:16.49,0:13:17.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:18.96,0:13:20.83,Default,,0,0,0,,Бұл сәл жақсы...
Dialogue: 0,0:13:21.23,0:13:21.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:22.53,0:13:25.10,Default,,0,0,0,,Нагай, саған бірдеңе керек пе?
Dialogue: 0,0:13:26.10,0:13:26.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:28.10,0:13:28.80,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:13:30.14,0:13:32.11,Default,,0,0,0,,Кейінірек болады.
Dialogue: 0,0:13:43.25,0:13:46.42,Default,,0,0,0,,Мен Манабеден естідім, бірақ бұл бір нәрсе үшін болды ма?
Dialogue: 0,0:13:48.12,0:13:50.93,Default,,0,0,0,,Салмақ пен бой туралы деректер болған дұрыс.
Dialogue: 0,0:13:50.99,0:13:52.06,Default,,0,0,0,,Ойланып қалдым
Dialogue: 0,0:13:52.46,0:13:54.40,Default,,0,0,0,,Бірақ онсыз өте жақсы.
Dialogue: 0,0:13:54.83,0:13:55.83,Default,,0,0,0,,Бұл жақсы болар еді...
Dialogue: 0,0:13:57.50,0:14:00.13,Default,,0,0,0,,Сіз жалғызсыз ба?
Dialogue: 0,0:14:00.27,0:14:01.20,Default,,0,0,0,,Ха! ?
Dialogue: 0,0:14:01.84,0:14:02.87,Default,,0,0,0,,Кейін қонақтар келеді
Dialogue: 0,0:14:04.27,0:14:07.04,Default,,0,0,0,,Сонда адасып қалған шығарсың.
Dialogue: 0,0:14:11.61,0:14:14.48,Default,,0,0,0,,Өз сөзіңіз бен іс-әрекетіңізде басқалардың сезімін ескермеңіз.
Dialogue: 0,0:14:14.58,0:14:17.22,Default,,0,0,0,,Мен оның шынымен дұрыс екеніне сенімді емеспін.
Dialogue: 0,0:14:18.49,0:14:20.09,Default,,0,0,0,,«Біз өзгеруіміз керек емес пе?»
Dialogue: 0,0:14:21.99,0:14:23.39,Default,,0,0,0,,Жоқ? (Кей) Жоқ!
Dialogue: 0,0:14:25.26,0:14:28.90,Default,,0,0,0,,Мен бірде-бір ретсіз сөз айтқан жоқпын.
Dialogue: 0,0:14:29.00,0:14:31.10,Default,,0,0,0,,Мен жай ғана ұтымды шешім қабылдап жатырмын.
Dialogue: 0,0:14:31.47,0:14:33.50,Default,,0,0,0,,Нені өзгерту керек! ?
Dialogue: 0,0:14:35.17,0:14:37.94,Default,,0,0,0,,Ах, дәл солай.
Dialogue: 0,0:14:38.87,0:14:39.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:40.94,0:14:42.34,Default,,0,0,0,,Накано деген кім?
Dialogue: 0,0:14:42.44,0:14:44.88,Default,,0,0,0,,Басқалардың сеніміне ие
Dialogue: 0,0:14:45.01,0:14:47.58,Default,,0,0,0,,Бір сыныпта оқитын болсақ, ол батыр болар еді.
Dialogue: 0,0:14:48.12,0:14:50.35,Default,,0,0,0,,Сен жәй ақымақсың ғой, солай ма?
Dialogue: 0,0:14:51.42,0:14:53.45,Default,,0,0,0,,Бірақ бұл мектеп емес.
Dialogue: 0,0:14:54.46,0:14:58.46,Default,,0,0,0,,Осы кезде сіз өз этикаңызды және эмоцияларыңызды үзу туралы шешім қабылдауыңыз керек болады.
Dialogue: 0,0:14:59.96,0:15:00.63,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:15:01.60,0:15:02.63,Default,,0,0,0,,Сізге...
Dialogue: 0,0:15:03.16,0:15:04.40,Default,,0,0,0,,Бұл мүмкін
Dialogue: 0,0:15:06.00,0:15:06.67,Default,,0,0,0,,(тілді шертеді)
Dialogue: 0,0:15:08.07,0:15:10.04,Default,,0,0,0,,Мен мұны білемін...
Dialogue: 0,0:15:10.94,0:15:14.61,Default,,0,0,0,,Дұрыс, онда бұл менің қателігім.
Dialogue: 0,0:15:19.91,0:15:21.68,Default,,0,0,0,,Менің әкем тамаша хирург болған.
Dialogue: 0,0:15:23.62,0:15:25.35,Default,,0,0,0,,Пациенттерге жанашырлық танытыңыз
Dialogue: 0,0:15:25.52,0:15:28.39,Default,,0,0,0,,Жыл сайын маған ауруханадан шыққан адамдардан хат келеді.
Dialogue: 0,0:15:28.66,0:15:31.49,Default,,0,0,0,,Бірақ... бұл ең үлкен кемшілік болды.
Dialogue: 0,0:15:32.69,0:15:34.23,Default,,0,0,0,,Мен 9 жасымда-
Dialogue: 0,0:15:34.36,0:15:37.36,Default,,0,0,0,,Донор таба алмаған бүйрек жеткіліксіздігі бар науқасты құтқаруға тырысу.
Dialogue: 0,0:15:37.46,0:15:39.30,Default,,0,0,0,,Мен «ағзаларды сатумен» айналыстым
Dialogue: 0,0:15:40.33,0:15:42.37,Default,,0,0,0,,Нәтижесінде әкем бәрінен айырылды.
Dialogue: 0,0:15:45.04,0:15:46.47,Default,,0,0,0,,Дәл сол қателікті жасамаңыз
Dialogue: 0,0:15:47.44,0:15:48.71,Default,,0,0,0,,Мен ақымақ емеспін
Dialogue: 0,0:15:50.14,0:15:52.61,Default,,0,0,0,,Ми қабілеті еңбек өтіліне негізделмейді.
Dialogue: 0,0:15:53.55,0:15:54.98,Default,,0,0,0,,Өзіңіз қалағандай әрекет етіңіз
Dialogue: 0,0:15:55.98,0:15:58.25,Default,,0,0,0,,Біз тек жоспарды орындаймыз.
Dialogue: 0,0:16:02.56,0:16:03.22,Default,,0,0,0,,Фу…
Dialogue: 0,0:16:07.06,0:16:09.26,Default,,0,0,0,,Бұл пікірлерді жинақтау арқылы жасалды.
Dialogue: 0,0:16:09.40,0:16:11.47,Default,,0,0,0,,Сатоға қарсы стратегиялық нұсқаулар
Dialogue: 0,0:16:11.97,0:16:13.57,Default,,0,0,0,,Барлығыңыз, осыны есте сақтаңыздар
Dialogue: 0,0:16:13.63,0:16:14.27,Default,,0,0,0,,Иә...
Dialogue: 0,0:16:14.60,0:16:15.60,Default,,0,0,0,,Накано (Шабуыл) Иә?
Dialogue: 0,0:16:15.70,0:16:17.34,Default,,0,0,0,,Сіз әсіресе
Dialogue: 0,0:16:18.41,0:16:19.54,Default,,0,0,0,,Сіз мұнда не оқисыз?
Dialogue: 0,0:16:20.11,0:16:20.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:21.44,0:16:24.14,Default,,0,0,0,,«Шинко» (Шабуыл) Ах... Ах!
Dialogue: 0,0:16:24.48,0:16:25.41,Default,,0,0,0,,Хэхе (Изуми) Ия...
Dialogue: 0,0:16:25.68,0:16:28.68,Default,,0,0,0,,Эй, эй, сен мұны істейсің бе?
Dialogue: 0,0:16:28.98,0:16:30.52,Default,,0,0,0,,Біз жарты адам емеспіз.
Dialogue: 0,0:16:31.12,0:16:33.25,Default,,0,0,0,,Нагай Бұл сіздің идеяңыз.
Dialogue: 0,0:16:34.25,0:16:35.09,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:16:36.36,0:16:36.76,Default,,0,0,0,,Иә
Dialogue: 0,0:16:38.69,0:16:40.29,Default,,0,0,0,,Бұл қызық емес пе?
Dialogue: 0,0:16:42.50,0:16:43.16,Default,,0,0,0,,Иә
Dialogue: 0,0:16:52.37,0:16:53.04,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:16:55.31,0:16:56.41,Default,,0,0,0,,Не?
Dialogue: 0,0:16:57.14,0:16:58.11,Default,,0,0,0,,Сіз...
Dialogue: 0,0:16:59.55,0:17:01.35,Default,,0,0,0,,Өлудің жақсы жолын білмейсіз бе?
Dialogue: 0,0:17:01.65,0:17:02.68,Default,,0,0,0,,ше? (Шабуыл) Жоқ-
Dialogue: 0,0:17:02.75,0:17:04.59,Default,,0,0,0,,Маған доктор.
Dialogue: 0,0:17:05.62,0:17:08.22,Default,,0,0,0,,IBM-тің пайда болуы, былайша айтқанда, «сәттілік»
Dialogue: 0,0:17:08.36,0:17:09.02,Default,,0,0,0,,О
Dialogue: 0,0:17:09.19,0:17:13.19,Default,,0,0,0,,Деми-адам IBM бөлшектері қайта тірілу кезінде ең жоғары концентрациясына жетеді.
Dialogue: 0,0:17:13.26,0:17:13.73,Default,,0,0,0,,О
Dialogue: 0,0:17:14.03,0:17:17.30,Default,,0,0,0,,Сол кезде қандай да бір ерекше әсер болуы мүмкін (шабуыл) Ах.
Dialogue: 0,0:17:17.56,0:17:19.30,Default,,0,0,0,,Оны туннель эффектісі деп атауға болады.
Dialogue: 0,0:17:19.60,0:17:21.20,Default,,0,0,0,,Мен қай туннельге баруым керек?
Dialogue: 0,0:17:21.30,0:17:21.74,Default,,0,0,0,,А...
Dialogue: 0,0:17:25.07,0:17:27.47,Default,,0,0,0,,Сен ақырет өміріне барасың.
Dialogue: 0,0:17:28.74,0:17:32.21,Default,,0,0,0,,Егер IBM манифестациясының жолы болса, ол не?
Dialogue: 0,0:17:32.58,0:17:35.15,Default,,0,0,0,,«Өл»
Dialogue: 0,0:17:35.25,0:17:38.69,Default,,0,0,0,,Бұл өте өлі.
Dialogue: 0,0:17:38.79,0:17:43.56,Default,,0,0,0,,Оны ондаған, жүздеген рет тарту керек. Сіз Гавайиге сапар ұтып алмайсыз.
Dialogue: 0,0:17:49.80,0:17:52.47,Default,,0,0,0,,Осы арқылы сіз аз шығынмен автоматты түрде өле аласыз.
Dialogue: 0,0:17:52.57,0:17:53.77,Default,,0,0,0,,Ұйықтау жақсы
Dialogue: 0,0:17:54.50,0:17:55.70,Default,,0,0,0,,Ең бастысы, ауырсыну жоқ
Dialogue: 0,0:18:02.11,0:18:03.11,Default,,0,0,0,,(Дауыс жігерлендіреді)
Dialogue: 0,0:18:03.61,0:18:06.11,Default,,0,0,0,,Жарайды... орындаймыз ба?
Dialogue: 0,0:18:06.35,0:18:07.82,Default,,0,0,0,,Қорқатын ештеңе жоқ.
Dialogue: 0,0:18:08.28,0:18:11.42,Default,,0,0,0,,Хаха, бұлай ойланбастан өлуге болады ғой?
Dialogue: 0,0:18:11.52,0:18:13.12,Default,,0,0,0,,Сіз де істеп жатырсыз, солай ма?
Dialogue: 0,0:18:13.22,0:18:14.49,Default,,0,0,0,,Мен үнемі қорқамын
Dialogue: 0,0:18:15.32,0:18:17.46,Default,,0,0,0,,Мүмкін?
Dialogue: 0,0:18:18.13,0:18:20.29,Default,,0,0,0,,Келесі жолы мен өмірге оралмауым мүмкін.
Dialogue: 0,0:18:21.60,0:18:23.30,Default,,0,0,0,,Дерек көзі тек қауесет, бірақ...
Dialogue: 0,0:18:23.73,0:18:25.20,Default,,0,0,0,,Қытайдың жарты адамы
Dialogue: 0,0:18:25.40,0:18:27.67,Default,,0,0,0,,Оның 2000 рет өлгені туралы жазба бар.
Dialogue: 0,0:18:28.20,0:18:29.57,Default,,0,0,0,,Ол әлі де жаңартылуда ма?
Dialogue: 0,0:18:30.30,0:18:31.81,Default,,0,0,0,,Сіз жақсы жұмыс істеп жатырсыз
Dialogue: 0,0:18:32.44,0:18:33.57,Default,,0,0,0,,Мен бәрін істеймін
Dialogue: 0,0:18:34.68,0:18:36.48,Default,,0,0,0,,Әйтпесе алға жылжи алмаймыз.
Dialogue: 0,0:18:37.48,0:18:39.15,Default,,0,0,0,,Қорқудың қажеті жоқ
Dialogue: 0,0:18:40.28,0:18:42.82,Default,,0,0,0,,Сіз... кереметсіз
Dialogue: 0,0:18:44.69,0:18:46.55,Default,,0,0,0,,Жарайды, тез өл.
Dialogue: 0,0:18:47.15,0:18:47.82,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:49.42,0:18:51.26,Default,,0,0,0,,Не, барасың ба?
Dialogue: 0,0:18:51.36,0:18:54.26,Default,,0,0,0,,Сіз баласыз ба? Мен бос емеспін.
Dialogue: 0,0:18:54.36,0:18:56.33,Default,,0,0,0,,Қазірдің өзінде суық.
Dialogue: 0,0:19:09.44,0:19:11.78,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:19:13.18,0:19:16.88,Default,,0,0,0,,Иә, қорқудың қажеті жоқ.
Dialogue: 0,0:19:36.34,0:19:37.47,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені жасаңыз!
Dialogue: 0,0:19:44.31,0:19:47.75,Default,,0,0,0,,Мен енді шу көтермеймін, сондықтан қалағаныңды істей аласың.
Dialogue: 0,0:19:49.25,0:19:54.52,Default,,0,0,0,,Цк, мен мұны білемін.
Dialogue: 0,0:19:55.22,0:19:57.36,Default,,0,0,0,,Мен ақымақ емеспін
Dialogue: 0,0:19:58.89,0:19:59.93,Default,,0,0,0,,(ағашты соққан дыбыс)
Dialogue: 0,0:20:00.23,0:20:04.20,Default,,0,0,0,,...Олардың бәрі ақымақ.
Dialogue: 0,0:20:06.80,0:20:07.43,Default,,0,0,0,,Иә
Dialogue: 0,0:20:09.20,0:20:09.84,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:10.40,0:20:11.91,Default,,0,0,0,,Замамиро
Dialogue: 0,0:20:12.21,0:20:13.37,Default,,0,0,0,,Бұл сенсің!
Dialogue: 0,0:20:14.31,0:20:15.28,Default,,0,0,0,,(ағашты соққан дыбыс)
Dialogue: 0,0:20:30.66,0:20:31.53,Default,,0,0,0,,Лейденшафтличтің солтүстік-шығысында—
Dialogue: 0,0:20:32.23,0:20:33.33,Default,,0,0,0,,Басқа орындардың кез келген саны...
Dialogue: 0,0:20:33.43,0:20:35.53,Default,,0,0,0,,Сіздің досыңыз кәмелетке толмағандар изоляторында.
Dialogue: 0,0:20:36.33,0:20:36.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:37.63,0:20:38.53,Default,,0,0,0,,Сол күні-
Dialogue: 0,0:20:40.27,0:20:42.54,Default,,0,0,0,,Сізді институтқа жіберген күн
Dialogue: 0,0:20:44.74,0:20:46.97,Default,,0,0,0,,Оны полиция қамауға алды
Dialogue: 0,0:20:50.54,0:20:52.81,Default,,0,0,0,,Неге қазір олай сөйлеп тұрсың?
Dialogue: 0,0:20:58.25,0:21:00.59,Default,,0,0,0,,Саған опасыздық жасайтындай әрекет етсем...
Dialogue: 0,0:21:01.72,0:21:03.82,Default,,0,0,0,,Сіз мені қорқыту үшін Кайтоны қолданғыңыз келе ме?
Dialogue: 0,0:21:03.96,0:21:07.26,Default,,0,0,0,,Менің күйеуімді пайдаланғаныңыздай.
Dialogue: 0,0:21:07.69,0:21:08.30,Default,,0,0,0,,Иә
Dialogue: 0,0:21:09.63,0:21:11.90,Default,,0,0,0,,Қолыңызды көрсетпейтіндіктен жарамды.
Dialogue: 0,0:21:12.37,0:21:13.43,Default,,0,0,0,,Сол дос...
Dialogue: 0,0:21:13.73,0:21:15.37,Default,,0,0,0,,«Маған бұл енді керек емес», солай ма?
Dialogue: 0,0:21:15.57,0:21:16.30,Default,,0,0,0,,(тілді шертеді)
Dialogue: 0,0:21:17.74,0:21:21.04,Default,,0,0,0,,Мен бұл енді жарамды қол емес деп шештім.
Dialogue: 0,0:21:24.04,0:21:26.68,Default,,0,0,0,,Сондай-ақ, арықтаған кезде бұл заттарды жеуге болмайды.
Dialogue: 0,0:21:26.75,0:21:27.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:29.78,0:21:31.05,Default,,0,0,0,,Қорқынышты
Dialogue: 0,0:21:35.32,0:21:36.72,Default,,0,0,0,,Кәмелетке толмағандарды дайындау мектебі?
Dialogue: 0,0:21:38.56,0:21:40.43,Default,,0,0,0,,Мен Кайға жамандық жасадым.
Dialogue: 0,0:21:41.73,0:21:42.50,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:21:43.03,0:21:44.90,Default,,0,0,0,,Егер сіз не істейтініңізді ойласаңыз...
Dialogue: 0,0:21:47.57,0:21:49.60,Default,,0,0,0,,Мүмкін ең қауіпсіз жер
Dialogue: 0,0:22:06.09,0:22:07.99,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:22:08.09,0:22:09.92,Default,,0,0,0,,Бүгіннен бастап бұл топтық жатақхана.
Dialogue: 0,0:22:12.89,0:22:15.00,Default,,0,0,0,,(Есік жабылған дыбысы)
Dialogue: 0,0:22:24.47,0:22:30.58,Default,,0,0,0,,♪Мен одан шаршадым, ауыстырайық♪
Dialogue: 0,0:22:30.78,0:22:35.92,Default,,0,0,0,,♪Сізде бар қалыпты♪
Dialogue: 0,0:22:37.05,0:22:43.39,Default,,0,0,0,,♪Жарқыраған Құдай картасы♪
Dialogue: 0,0:22:43.59,0:22:48.70,Default,,0,0,0,,♪Дұрыс қағаз картасы♪
Dialogue: 0,0:22:49.90,0:22:53.87,Default,,0,0,0,,♪Келесі жолы менің үйіме келесің♪
Dialogue: 0,0:22:56.40,0:23:00.44,Default,,0,0,0,,♪Мен саған бәрін көрсетемін♪
Dialogue: 0,0:23:00.74,0:23:02.51,Default,,0,0,0,,♪Себебі♪
Dialogue: 0,0:23:02.74,0:23:08.95,Default,,0,0,0,,♪Екі адам мектеп ауласының бұрышында, жел соғып тұр♪
Dialogue: 0,0:23:09.02,0:23:12.79,Default,,0,0,0,,♪Қазір айта алар ма екенмін♪
Dialogue: 0,0:23:15.62,0:23:21.50,Default,,0,0,0,,♪Ешкімге айтпайтын сөздер♪
Dialogue: 0,0:23:21.93,0:23:28.07,Default,,0,0,0,,♪«Мен саған жақсы боламын, сондықтан маған қонаққа кел»♪
Dialogue: 0,0:23:28.44,0:23:33.97,Default,,0,0,0,,♪«Мен саған бәрін беремін, эй»♪
Dialogue: 0,0:23:34.78,0:23:44.18,Default,,0,0,0,,♪"Мәңгілік дос болайық"♪
