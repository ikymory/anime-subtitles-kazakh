Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.17,0:00:06.43,Default,,0,0,0,,Бұл сіздің ультиматумыңыз
Dialogue: 0,0:00:07.07,0:00:10.41,Default,,0,0,0,,Бұл елге, Жапонияға беріл.
Dialogue: 0,0:00:10.51,0:00:12.27,Default,,0,0,0,,Бұл улы газ бомбасы ма?
Dialogue: 0,0:00:12.44,0:00:15.38,Default,,0,0,0,,Үкімет барлық азаматтарға өз орнында баспана алуды тапсырды...
Dialogue: 0,0:00:15.44,0:00:17.75,Default,,0,0,0,,Шатасулар әр жерде бірінен соң бірі болып жатқан сияқты.
Dialogue: 0,0:00:18.01,0:00:19.25,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:00:19.35,0:00:21.42,Default,,0,0,0,,Бұл шынымен соғыс емес пе?
Dialogue: 0,0:00:21.48,0:00:23.52,Default,,0,0,0,,Не айтып тұрсың, Танака-кун?
Dialogue: 0,0:00:23.59,0:00:25.09,Default,,0,0,0,,Сіз мұны басынан бастап айттыңыз, солай ма?
Dialogue: 0,0:00:25.45,0:00:27.19,Default,,0,0,0,,Бұл соғыс
Dialogue: 0,0:00:27.69,0:00:30.56,Default,,0,0,0,,Сатоның жігіті мүлде ақылсыз...
Dialogue: 0,0:00:30.66,0:00:32.36,Default,,0,0,0,,Біз қазір не істейміз?
Dialogue: 0,0:00:32.46,0:00:34.20,Default,,0,0,0,,Сонда менде бір ой бар.
Dialogue: 0,0:00:34.50,0:00:35.70,Default,,0,0,0,,Нагай!
Dialogue: 0,0:00:36.03,0:00:36.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:36.73,0:00:38.10,Default,,0,0,0,,Неге оралдың?
Dialogue: 0,0:00:38.37,0:00:39.47,Default,,0,0,0,,Ол қазірдің өзінде шешілді.
Dialogue: 0,0:00:39.63,0:00:43.14,Default,,0,0,0,,Сатоны тоқтату үшін менің күшім қажет болады.
Dialogue: 0,0:00:43.30,0:00:44.34,Default,,0,0,0,,Вааах!
Dialogue: 0,0:00:44.47,0:00:46.21,Default,,0,0,0,,Енді не істей аласыз? ?
Dialogue: 0,0:00:46.47,0:00:49.51,Default,,0,0,0,,Сіз маған сенбейтініңізді білемін...
Dialogue: 0,0:00:49.68,0:00:52.08,Default,,0,0,0,,Жарай берсін… Мен сенің артыңнан ұрлана жүріп келемін
Dialogue: 0,0:00:52.78,0:00:53.48,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:00:56.15,0:00:57.79,Default,,0,0,0,,Мен Сатоны тоқтатамын
Dialogue: 0,0:00:58.69,0:01:00.16,Default,,0,0,0,,Сізге керек
Dialogue: 0,0:01:02.09,0:01:03.36,Default,,0,0,0,,Нагай-кун! (Шабуыл) Сен!
Dialogue: 0,0:01:05.76,0:01:06.63,Default,,0,0,0,,Ах
Dialogue: 0,0:01:07.40,0:01:08.30,Default,,0,0,0,,Ах (Изуми) Ах
Dialogue: 0,0:01:10.47,0:01:11.73,Default,,0,0,0,,Бұл жарылыс.
Dialogue: 0,0:01:12.23,0:01:15.64,Default,,0,0,0,,Бұл Аджин Сато басып алған өзін-өзі қорғау күштерінің базасында ма?
Dialogue: 0,0:01:15.74,0:01:17.64,Default,,0,0,0,,Кенет жарылған сияқты!
Dialogue: 0,0:01:18.14,0:01:19.77,Default,,0,0,0,,Сіз мұны керемет түрде жасайсыз.
Dialogue: 0,0:01:20.08,0:01:20.81,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:01:21.84,0:01:25.81,Default,,0,0,0,,Чит (мобильді қоңырау үні)
Dialogue: 0,0:01:26.38,0:01:26.85,Default,,0,0,0,,Иә
Dialogue: 0,0:01:28.68,0:01:29.82,Default,,0,0,0,,Мен сөйлескім келеді
Dialogue: 0,0:01:40.46,0:01:43.26,Default,,0,0,0,,♪Осы баратын жерге көзіңізді оятыңыз♪
Dialogue: 0,0:01:43.53,0:01:46.47,Default,,0,0,0,,♪Егер қашып құтыла алмасаң♪
Dialogue: 0,0:01:46.60,0:01:52.41,Default,,0,0,0,,♪ Бәрін жұтып, дұрыс-бұрысты, ұрыс-керіс ♪
Dialogue: 0,0:01:59.28,0:02:05.35,Default,,0,0,0,,♪Жүректің қараңғылығын басқаратын қауіп шу шығарады♪
Dialogue: 0,0:02:05.45,0:02:11.29,Default,,0,0,0,,♪Ақылынан айырылғалы тұрған адамдар туралы шындық♪
Dialogue: 0,0:02:11.59,0:02:17.67,Default,,0,0,0,,♪Мен оның мағынасыздығын білемін♪
Dialogue: 0,0:02:17.77,0:02:23.81,Default,,0,0,0,,♪Тіпті жалған тыныштық бұзылса♪
Dialogue: 0,0:02:23.91,0:02:35.35,Default,,0,0,0,,♪ Қарсы болатын көлеңке түсіру ♪
Dialogue: 0,0:02:35.92,0:02:39.22,Default,,0,0,0,,♪Бұл қашып кетудің соңы♪
Dialogue: 0,0:02:39.32,0:02:42.29,Default,,0,0,0,,♪Себебі бұл жалғыз жол♪
Dialogue: 0,0:02:42.39,0:02:48.46,Default,,0,0,0,,♪ Мен көздеген кішкентай үмітке ♪ жет
Dialogue: 0,0:02:48.56,0:02:51.53,Default,,0,0,0,,♪Сол созылған қолдан♪
Dialogue: 0,0:02:51.63,0:02:54.74,Default,,0,0,0,,♪Төгілген әлсіздік♪
Dialogue: 0,0:02:54.80,0:03:01.48,Default,,0,0,0,,♪Дұрыс-бұрыс бәрін жұтып, жынды болдым♪
Dialogue: 0,0:03:19.83,0:03:20.66,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:03:22.73,0:03:24.80,Default,,0,0,0,,Қалпына келтіру аяқталды. Барлауға барыңыз.
Dialogue: 0,0:03:25.37,0:03:25.90,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:03:28.74,0:03:30.44,Default,,0,0,0,,Оны кез келген шығынмен түсіріңіз
Dialogue: 0,0:03:30.94,0:03:35.34,Default,,0,0,0,,Біз мүкке айналғанда не болатынын білейік.
Dialogue: 0,0:03:38.68,0:03:43.42,Default,,0,0,0,,Олар күлкі болғанды ​​бәрінен де жек көреді.
Dialogue: 0,0:03:43.95,0:03:46.42,Default,,0,0,0,,Бұл сізді байсалды етеді.
Dialogue: 0,0:03:47.99,0:03:51.33,Default,,0,0,0,,Хмм, мен оны асыға күтемін, Танака-кун.
Dialogue: 0,0:03:51.99,0:03:52.69,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:52.79,0:03:57.23,Default,,0,0,0,,АҚШ әскерінің ашуын тудыратын жалғыз адам - ​​Сато мырза.
Dialogue: 0,0:04:00.94,0:04:04.67,Default,,0,0,0,,Бірақ бұл өлтіруші газды жіберген дұрыс болды ма?
Dialogue: 0,0:04:05.27,0:04:09.34,Default,,0,0,0,,Қарсылық көрсетпейтін адамдарды улы газбен өлтіру қызық емес пе?
Dialogue: 0,0:04:11.55,0:04:14.82,Default,,0,0,0,,Олар өлтіру ниетімен келмесе, оларды өлтірудің мәні жоқ.
Dialogue: 0,0:04:15.02,0:04:15.82,Default,,0,0,0,,(Танака күрсініп)
Dialogue: 0,0:04:20.56,0:04:24.83,Default,,0,0,0,,(ағынды сулардың ағу дыбысы)
Dialogue: 0,0:04:24.93,0:04:25.96,Default,,0,0,0,,Бұл барлау тобы.
Dialogue: 0,0:04:26.56,0:04:28.40,Default,,0,0,0,,Сатоның қашу жолын тапты
Dialogue: 0,0:04:28.63,0:04:30.30,Default,,0,0,0,,Қолдау тобын дереу жіберіңіз
Dialogue: 0,0:04:31.73,0:04:33.84,Default,,0,0,0,,Полковник, Пентагоннан.
Dialogue: 0,0:04:35.54,0:04:35.97,Default,,0,0,0,,Иә
Dialogue: 0,0:04:37.57,0:04:39.34,Default,,0,0,0,,Иә, барлық ұшақтар қауіпсіз.
Dialogue: 0,0:04:39.57,0:04:40.98,Default,,0,0,0,,Барлауды қазірдің өзінде бастадым...
Dialogue: 0,0:04:42.38,0:04:42.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:43.65,0:04:46.98,Default,,0,0,0,,Жоқ, жоқ, бірақ мұны істесеңіз...
Dialogue: 0,0:04:48.68,0:04:52.52,Default,,0,0,0,,Мен... Жарайды, онда.
Dialogue: 0,0:04:53.35,0:04:54.39,Default,,0,0,0,,(Ұялы телефонның өшірілген дыбысы)
Dialogue: 0,0:04:54.79,0:04:55.82,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:04:58.39,0:04:59.59,Default,,0,0,0,,Мен Архитектуралық дизайн бөлімінен Отомын; сіз маған қоңырау шалған едіңіз.
Dialogue: 0,0:05:02.03,0:05:03.30,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:05:03.53,0:05:05.03,Default,,0,0,0,,Мені премьер-министрдің кеңсесіне қосыңыз.
Dialogue: 0,0:05:10.34,0:05:10.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:11.61,0:05:13.34,Default,,0,0,0,,Яғни...
Dialogue: 0,0:05:13.51,0:05:15.98,Default,,0,0,0,,Қалпына келтірілген жүйке газын жер астына таратыңыз...
Dialogue: 0,0:05:16.08,0:05:18.48,Default,,0,0,0,,Сіз Сатоны бейтараптандырғыңыз келе ме?
Dialogue: 0,0:05:18.58,0:05:21.62,Default,,0,0,0,,Сатоны басып алып, жағдайды бақылауға алу үшін
Dialogue: 0,0:05:21.75,0:05:23.69,Default,,0,0,0,,Бұл жалғыз нұсқа екені анықталды.
Dialogue: 0,0:05:24.49,0:05:26.49,Default,,0,0,0,,Бірақ бұл операцияда...
Dialogue: 0,0:05:26.62,0:05:28.72,Default,,0,0,0,,Тұрғындарды эвакуациялауға көп уақыт кетті.
Dialogue: 0,0:05:28.82,0:05:30.36,Default,,0,0,0,,Сол уақытта қашып кету қаупі де бар...
Dialogue: 0,0:05:30.46,0:05:30.89,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:05:35.43,0:05:38.03,Default,,0,0,0,,Сато оны анықтауға жол бермеу үшін-
Dialogue: 0,0:05:38.63,0:05:40.90,Default,,0,0,0,,Тұрғындарды эвакуациялау мүмкін емес
Dialogue: 0,0:05:41.04,0:05:43.57,Default,,0,0,0,,Сіз кепілге зиян келтіремін дейсіз бе? ?
Dialogue: 0,0:05:43.67,0:05:47.88,Default,,0,0,0,,Әрине, бұл Сатоның лаңкестік әрекеті ретінде қарастырылады және ол барлық кінәні өз мойнына алады...
Dialogue: 0,0:05:48.01,0:05:50.34,Default,,0,0,0,,Бұл сыртқы көріністе емес!
Dialogue: 0,0:05:50.45,0:05:52.55,Default,,0,0,0,,Қалай ойлайсыңдар, адамдар қандай?
Dialogue: 0,0:05:53.65,0:05:57.55,Default,,0,0,0,,Де-факто командалық қазірдің өзінде АҚШ әскеріне берілді
Dialogue: 0,0:05:58.39,0:06:00.05,Default,,0,0,0,,Біздің вето құқығымыз жоқ.
Dialogue: 0,0:06:00.66,0:06:01.96,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:03.69,0:06:04.69,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:06:14.07,0:06:16.54,Default,,0,0,0,,Операцияның орындалуына 7 сағат қалды.
Dialogue: 0,0:06:16.84,0:06:19.71,Default,,0,0,0,,Егер Сато сол уақытқа дейін тұтқынға алынса, ешқандай тарау болмайды.
Dialogue: 0,0:06:20.41,0:06:24.01,Default,,0,0,0,,Бұл бізде жалғыз нұсқа.
Dialogue: 0,0:06:24.45,0:06:26.81,Default,,0,0,0,,Жоқ, бірақ... (Министрлер кабинетінің бас хатшысы) Мен мұны айтуым керек еді.
Dialogue: 0,0:06:26.98,0:06:31.12,Default,,0,0,0,,Бұл сіздің, басқару комитетінің, оны бақылаусыз қалдыруды жалғастыруыңыздың нәтижесі.
Dialogue: 0,0:06:33.05,0:06:34.96,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:36.82,0:06:42.93,Default,,0,0,0,,(Көлік жүрген дыбыс)
Dialogue: 0,0:06:44.60,0:06:45.70,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:06:48.17,0:06:49.70,Default,,0,0,0,,Тағы да...
Dialogue: 0,0:06:51.57,0:06:58.15,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:07:02.68,0:07:04.52,Default,,0,0,0,,Алаңдаудың қажеті жоқ.
Dialogue: 0,0:07:04.72,0:07:06.62,Default,,0,0,0,,Менің тұзаққа түсемін деген ниетім жоқ.
Dialogue: 0,0:07:08.79,0:07:11.49,Default,,0,0,0,,Неліктен бізбен байланысу керек?
Dialogue: 0,0:07:12.06,0:07:15.20,Default,,0,0,0,,Сіз Сато мырзамен екі рет кездестіңіз және әлі тірісіз.
Dialogue: 0,0:07:15.86,0:07:18.63,Default,,0,0,0,,Мен бұл менің жалғыз қарсыласым деп шештім.
Dialogue: 0,0:07:19.90,0:07:22.44,Default,,0,0,0,,Мен Сато мырзаны тоқтату үшін күш бергім келеді.
Dialogue: 0,0:07:25.67,0:07:26.61,Default,,0,0,0,,Оның орнына не?
Dialogue: 0,0:07:29.11,0:07:30.21,Default,,0,0,0,,Сато мырза
Dialogue: 0,0:07:30.61,0:07:33.01,Default,,0,0,0,,Мен сатқынды тірі қалдыратын адам емеспін.
Dialogue: 0,0:07:36.12,0:07:37.89,Default,,0,0,0,,Сіз үшеусіз бе?
Dialogue: 0,0:07:38.72,0:07:41.02,Default,,0,0,0,,Сіз Musashi Heavy Industries компаниясында жұмыс істеген кезде, одан да көп болды, солай емес пе?
Dialogue: 0,0:07:41.69,0:07:42.76,Default,,0,0,0,,үшін қашып кетті.
Dialogue: 0,0:07:43.12,0:07:45.73,Default,,0,0,0,,Сато-санмен күресу ақылсыздық.
Dialogue: 0,0:07:46.73,0:07:49.70,Default,,0,0,0,,Мен сізбен келісемін.
Dialogue: 0,0:07:50.60,0:07:51.70,Default,,0,0,0,,Танака мырза да?
Dialogue: 0,0:07:51.77,0:07:53.67,Default,,0,0,0,,Жоқ, ол адам...
Dialogue: 0,0:07:53.90,0:07:56.87,Default,,0,0,0,,Сонда сіз Сато мырзамен қалдыңыз ба?
Dialogue: 0,0:07:57.17,0:07:59.07,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:07:59.57,0:08:03.14,Default,,0,0,0,,Сатоны тоқтатқыңыз келсе, бізбен бірігуден басқа амалыңыз жоқ.
Dialogue: 0,0:08:03.24,0:08:06.71,Default,,0,0,0,,Танака мырза айтқандай, ол салқын нәрселерді ұнатпайтын бала.
Dialogue: 0,0:08:06.78,0:08:08.58,Default,,0,0,0,,Үніңді жап, масқара.
Dialogue: 0,0:08:08.78,0:08:10.52,Default,,0,0,0,,Сіз сияқты террористер...
Dialogue: 0,0:08:10.65,0:08:12.12,Default,,0,0,0,,Маған оңай сену мүмкін емес.
Dialogue: 0,0:08:12.49,0:08:14.96,Default,,0,0,0,,Ах! Бұл не сұмдық?
Dialogue: 0,0:08:15.22,0:08:16.76,Default,,0,0,0,,Бізді бұлай еткен не...
Dialogue: 0,0:08:16.86,0:08:19.56,Default,,0,0,0,,Бұл Темераның деми-адамдарға эксперименталды жануарлар сияқты қарайтындығынан болса керек!
Dialogue: 0,0:08:19.66,0:08:20.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:20.19,0:08:20.83,Default,,0,0,0,,(Мылтық шығарылған дыбыс)
Dialogue: 0,0:08:22.80,0:08:25.83,Default,,0,0,0,,Не істеу керек? Сіз оны біріктіресіз бе? Оны жинамайсың ба?
Dialogue: 0,0:08:27.54,0:08:32.67,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:08:33.57,0:08:34.54,Default,,0,0,0,,Оның мойны… кесіліп қалған жоқ па?
Dialogue: 0,0:08:37.21,0:08:37.85,Default,,0,0,0,,Иә
Dialogue: 0,0:08:38.75,0:08:40.82,Default,,0,0,0,,Сенпай, мәміле жасағың келе ме?
Dialogue: 0,0:08:40.92,0:08:42.75,Default,,0,0,0,,О... Согабе! ?
Dialogue: 0,0:08:43.68,0:08:46.29,Default,,0,0,0,,Өте жағымсыз жағдай туындады.
Dialogue: 0,0:08:49.09,0:08:51.29,Default,,0,0,0,,Неге шаруаңды тез айтпайсың?
Dialogue: 0,0:08:51.69,0:08:54.70,Default,,0,0,0,,Цк, сіз осындай уақытта ұзақ телефон соғып жатырсыз ба?
Dialogue: 0,0:08:59.90,0:09:03.17,Default,,0,0,0,,Фу... Балалар, сендер Сатоның қайда екенін білесіңдер ме? ?
Dialogue: 0,0:09:03.24,0:09:04.87,Default,,0,0,0,,Ол өзінің жер астындағы жасырынуында болуы керек.
Dialogue: 0,0:09:04.94,0:09:05.57,Default,,0,0,0,,Менің артымнан жүр!
Dialogue: 0,0:09:05.81,0:09:06.81,Default,,0,0,0,,О? (Кей) ше?
Dialogue: 0,0:09:07.58,0:09:09.91,Default,,0,0,0,,Не істеп жатырсың! ? Бұзбаңыз!
Dialogue: 0,0:09:11.08,0:09:18.62,Default,,0,0,0,,(Көлік жүрген дыбыс)
Dialogue: 0,0:09:19.55,0:09:21.62,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:09:22.06,0:09:23.62,Default,,0,0,0,,Қош келдіңіз, Изуми мырза
Dialogue: 0,0:09:23.72,0:09:24.59,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:09:26.83,0:09:27.56,Default,,0,0,0,,Айтпақшы, сіз кімсіз өзі?
Dialogue: 0,0:09:29.56,0:09:30.90,Default,,0,0,0,,Сіз шынымен лаңкестермен жұмыс жасайсыз ба?
Dialogue: 0,0:09:31.17,0:09:34.80,Default,,0,0,0,,Аа, басқа амалым жоқ, уақытым да жоқ.
Dialogue: 0,0:09:35.00,0:09:36.27,Default,,0,0,0,,(Жүк машинасының ашылған дыбысы)
Dialogue: 0,0:09:37.74,0:09:40.68,Default,,0,0,0,,Такахаши мырза, генерал мырза және Окуяма мырза.
Dialogue: 0,0:09:40.98,0:09:41.91,Default,,0,0,0,,Уссу
Dialogue: 0,0:09:42.28,0:09:42.91,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:45.25,0:09:46.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:46.91,0:09:48.15,Default,,0,0,0,,Бұл геноцид.
Dialogue: 0,0:09:48.32,0:09:49.68,Default,,0,0,0,,Ху (Такахаши) Хахаха...
Dialogue: 0,0:09:49.78,0:09:50.75,Default,,0,0,0,,Уау! (Шабуыл) Қария!
Dialogue: 0,0:09:50.85,0:09:51.75,Default,,0,0,0,,Сіз дұрыс түсіндіңіз!
Dialogue: 0,0:09:54.89,0:09:58.03,Default,,0,0,0,,Балалар! Сен бейбақ! О иә!
Dialogue: 0,0:09:59.13,0:10:01.63,Default,,0,0,0,,Ей, ақымақ, тоқтат!
Dialogue: 0,0:10:01.73,0:10:03.97,Default,,0,0,0,,Қария қайда? Оны қайда жасырдың?
Dialogue: 0,0:10:04.13,0:10:05.97,Default,,0,0,0,,О, тынышталыңыз.
Dialogue: 0,0:10:06.07,0:10:07.34,Default,,0,0,0,,Мен оларды босататын едім.
Dialogue: 0,0:10:08.64,0:10:10.77,Default,,0,0,0,,дұрыс па?
Dialogue: 0,0:10:10.91,0:10:13.34,Default,,0,0,0,,А, менің отбасым осында болуы керек еді.
Dialogue: 0,0:10:13.77,0:10:15.38,Default,,0,0,0,,Түсіндім бе, ақымақ?
Dialogue: 0,0:10:15.91,0:10:19.71,Default,,0,0,0,,Бұл бейбақ қандай ақымақ? (Кей) Ендеше тоқтат!
Dialogue: 0,0:10:20.35,0:10:25.12,Default,,0,0,0,,(Қақтығыс дауыстары)
Dialogue: 0,0:10:26.82,0:10:30.32,Default,,0,0,0,,Мен осыншама деми-адамдар бір жерге жиналады деп ешқашан күтпедім.
Dialogue: 0,0:10:30.66,0:10:32.66,Default,,0,0,0,,Гарем сияқты (Сузумура) Хух.
Dialogue: 0,0:10:32.73,0:10:33.76,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:10:33.86,0:10:35.70,Default,,0,0,0,,А, мен мұны сізге қалдырамын.
Dialogue: 0,0:10:35.80,0:10:38.77,Default,,0,0,0,,(Қақтығыс дауыстары)
Dialogue: 0,0:10:38.87,0:10:42.34,Default,,0,0,0,,Уайымдамаңыздар, балалар! Тез ішке кіріңіз!
Dialogue: 0,0:10:45.07,0:10:46.81,Default,,0,0,0,,О, сәл күте тұрыңыз.
Dialogue: 0,0:10:47.34,0:10:47.94,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:49.08,0:10:50.65,Default,,0,0,0,,(магистральдың ашылған дыбысы)
Dialogue: 0,0:10:50.98,0:10:53.05,Default,,0,0,0,,Сізге ұнайды деп үміттенемін.
Dialogue: 0,0:10:53.75,0:10:54.82,Default,,0,0,0,,О...
Dialogue: 0,0:10:57.69,0:11:00.35,Default,,0,0,0,,Егер сіз мұны жасағыңыз келсе, ол жарқыраған болуы керек.
Dialogue: 0,0:11:01.22,0:11:04.79,Default,,0,0,0,,(Компьютерде теру дыбысы)
Dialogue: 0,0:11:05.69,0:11:08.86,Default,,0,0,0,,Қазіргі уақытта АҚШ әскері өзін-өзі қорғау күштерінің гарнизондарының айналасында шоғырланған.
Dialogue: 0,0:11:08.96,0:11:10.43,Default,,0,0,0,,Бұл аймақ жабық.
Dialogue: 0,0:11:11.37,0:11:14.30,Default,,0,0,0,,Олар бүкіл аймақты құрбан етті...
Dialogue: 0,0:11:14.37,0:11:15.97,Default,,0,0,0,,Мен Сатоны қолға түсіруді көздеп отырмын.
Dialogue: 0,0:11:16.10,0:11:18.74,Default,,0,0,0,,Gi құрбандық шалу...
Dialogue: 0,0:11:18.97,0:11:21.24,Default,,0,0,0,,Нерв газын жер астына шашу.
Dialogue: 0,0:11:21.84,0:11:24.21,Default,,0,0,0,,Әрине, ондаған мың құрбандар болады.
Dialogue: 0,0:11:24.35,0:11:24.98,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:11:26.15,0:11:27.98,Default,,0,0,0,,Іс-шара сағат 3:00-де өтеді.
Dialogue: 0,0:11:28.25,0:11:29.88,Default,,0,0,0,,Шамамен 4 сағат қалды.
Dialogue: 0,0:11:30.28,0:11:34.06,Default,,0,0,0,,Бұған дейін Сатоны қалай болса да басып ал, жарай ма?
Dialogue: 0,0:11:34.22,0:11:36.12,Default,,0,0,0,,Аа, әрине.
Dialogue: 0,0:11:36.86,0:11:40.69,Default,,0,0,0,,Алайда Аджинге қарсы арнайы топ Сатоны қорғау үшін де жұмыс істеп жатыр.
Dialogue: 0,0:11:41.13,0:11:45.00,Default,,0,0,0,,Операция бұған кедергі жасамай орындалады деп болжанады.
Dialogue: 0,0:11:49.14,0:11:51.41,Default,,0,0,0,,Енді стратегия туралы...
Dialogue: 0,0:11:52.27,0:11:56.41,Default,,0,0,0,,Бұл Окуяма мырза жасаған Токионың жерасты өткелдерінің картасы.
Dialogue: 0,0:11:57.21,0:12:00.05,Default,,0,0,0,,Сато мырзаның жасырынатын жері осында
Dialogue: 0,0:12:00.98,0:12:04.45,Default,,0,0,0,,Сато мырза мұнда АҚШ әскерін әкеліп, оларға шабуыл жасамақ болды.
Dialogue: 0,0:12:04.75,0:12:07.39,Default,,0,0,0,,Басқаша айтқанда, кез келген нәрсеге шабуыл жасауға дайын болыңыз...
Dialogue: 0,0:12:07.46,0:12:09.22,Default,,0,0,0,,Ол реттелгенін білдіреді.
Dialogue: 0,0:12:10.93,0:12:13.43,Default,,0,0,0,,Сатон жер бетінде не жоспарлап отыр?
Dialogue: 0,0:12:14.16,0:12:16.76,Default,,0,0,0,,Азаматтық та, тәуелсіз мемлекеттілік те кездейсоқ болды.
Dialogue: 0,0:12:17.40,0:12:19.30,Default,,0,0,0,,Оның мақсаты қандай?
Dialogue: 0,0:12:19.40,0:12:21.17,Default,,0,0,0,,(Үру)
Dialogue: 0,0:12:21.40,0:12:23.37,Default,,0,0,0,,Тозаки мырза ойын ойнағанда -
Dialogue: 0,0:12:23.47,0:12:25.77,Default,,0,0,0,,Сіз мұны «Мен ханшайымға көмектесемін» деп ойлағандықтан жасайсыз ба?
Dialogue: 0,0:12:26.04,0:12:28.78,Default,,0,0,0,,ше? Бұл не?
Dialogue: 0,0:12:29.18,0:12:31.11,Default,,0,0,0,,Әңгіме керек, бірақ...
Dialogue: 0,0:12:31.35,0:12:34.08,Default,,0,0,0,,Сіз мұны тасбақаларды таптау қызық болғандықтан жасайсыз, солай ма?
Dialogue: 0,0:12:34.15,0:12:36.82,Default,,0,0,0,,Мен білмеймін. Мен ойын ойнамаймын.
Dialogue: 0,0:12:37.89,0:12:40.75,Default,,0,0,0,,Сато мырза қарапайым адам.
Dialogue: 0,0:12:41.32,0:12:44.19,Default,,0,0,0,,Бұл адам революционер де, стратег те емес.
Dialogue: 0,0:12:45.09,0:12:46.76,Default,,0,0,0,,Жай ойыншы
Dialogue: 0,0:12:47.23,0:12:50.83,Default,,0,0,0,,Сондықтан оны қосуға мүмкіндік бар.
Dialogue: 0,0:12:51.23,0:12:52.50,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:12:55.20,0:12:56.34,Default,,0,0,0,,Тірідей көму
Dialogue: 0,0:12:57.97,0:13:02.04,Default,,0,0,0,,(Ойын дыбысы)
Dialogue: 0,0:13:02.18,0:13:05.51,Default,,0,0,0,,Танака-кун, мен ол жауды саған қалдырамын.
Dialogue: 0,0:13:05.81,0:13:09.35,Default,,0,0,0,,Е-е, жоқ, кенеттен солай айтсаң да...
Dialogue: 0,0:13:09.85,0:13:11.22,Default,,0,0,0,,Ах... өлді.
Dialogue: 0,0:13:12.09,0:13:16.49,Default,,0,0,0,,Аа, дәл түсіргендей, жақсы болмайсың.
Dialogue: 0,0:13:17.02,0:13:19.53,Default,,0,0,0,,Кешіріңіз, мен өте нашармын.
Dialogue: 0,0:13:20.39,0:13:22.83,Default,,0,0,0,,Ха ха… (Шабуыл) Ха ха… (Изуми) Ха ха…
Dialogue: 0,0:13:22.93,0:13:25.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:25.20,0:13:27.10,Default,,0,0,0,,Ой, қонақ келді.
Dialogue: 0,0:13:28.07,0:13:30.44,Default,,0,0,0,,Бұл түн ортасы кеші.
Dialogue: 0,0:13:31.27,0:13:35.54,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:13:36.38,0:13:39.25,Default,,0,0,0,,Уау, бұл қызықты.
Dialogue: 0,0:13:39.38,0:13:43.22,Default,,0,0,0,,Өйткені, біздің қарсыласымыз әлемдегі ең күшті әскер.
Dialogue: 0,0:13:43.32,0:13:45.92,Default,,0,0,0,,Өзіңе дұрыс қарау керек.
Dialogue: 0,0:13:48.86,0:13:51.89,Default,,0,0,0,,Бұл сіздің мақсатыңыз болды ма?
Dialogue: 0,0:13:51.99,0:13:52.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:53.06,0:13:53.86,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:13:54.46,0:13:56.26,Default,,0,0,0,,АҚШ әскері созылып жатыр
Dialogue: 0,0:13:57.26,0:13:59.87,Default,,0,0,0,,Сондықтан маған көмектесіп, достар жинадың...
Dialogue: 0,0:14:00.27,0:14:01.57,Default,,0,0,0,,Сіз теракт жасадыңыз ба?
Dialogue: 0,0:14:01.87,0:14:03.40,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:14:03.94,0:14:07.58,Default,,0,0,0,,Соңғы бастықтың кім екенін басынан бастап білсеңіз, қызық болмай ма?
Dialogue: 0,0:14:07.88,0:14:08.54,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:14:09.28,0:14:11.55,Default,,0,0,0,,Сонымен бұл соңы ма?
Dialogue: 0,0:14:11.91,0:14:12.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:12.45,0:14:16.45,Default,,0,0,0,,А... жоқ, соңғы бастықты жеңгеннен кейін бәрі бітеді, солай ма? Ойын қандай?
Dialogue: 0,0:14:16.92,0:14:20.09,Default,,0,0,0,,Не айтып тұрсың, Танака-кун?
Dialogue: 0,0:14:20.89,0:14:23.49,Default,,0,0,0,,Ойынның дәмі екінші ойыннан басталады.
Dialogue: 0,0:14:23.59,0:14:25.06,Default,,0,0,0,,(Есіктің соғылған дыбысы)
Dialogue: 0,0:14:27.90,0:14:29.20,Default,,0,0,0,,Кешіріңіз? (Сато) Иә?
Dialogue: 0,0:14:32.27,0:14:34.30,Default,,0,0,0,,Мен сенің көңіл көтеруіңді үздім.
Dialogue: 0,0:14:34.87,0:14:35.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:36.14,0:14:37.94,Default,,0,0,0,,Нагай болды ма?
Dialogue: 0,0:14:38.27,0:14:40.94,Default,,0,0,0,,Бұл тез. Сіз бұл ойды дұрыс түсіндіңіз.
Dialogue: 0,0:14:41.21,0:14:42.94,Default,,0,0,0,,Кәрізге сүңгіп кетсең де...
Dialogue: 0,0:14:43.14,0:14:46.05,Default,,0,0,0,,Қанішердің иісін жасыра алмайсың.
Dialogue: 0,0:14:46.35,0:14:49.88,Default,,0,0,0,,Ах, Окуяма-кун және басқалар...
Dialogue: 0,0:14:50.05,0:14:52.92,Default,,0,0,0,,Бұл, әрине, күтпеген жағдай болды.
Dialogue: 0,0:14:53.32,0:14:56.09,Default,,0,0,0,,Бірақ менің ойымша, бұл қызықты, сондықтан жақсы.
Dialogue: 0,0:14:56.16,0:14:58.23,Default,,0,0,0,,Бұл қызықтырақ
Dialogue: 0,0:14:58.93,0:15:00.56,Default,,0,0,0,,Сато мырза АҚШ әскерін күтуде...
Dialogue: 0,0:15:00.96,0:15:03.50,Default,,0,0,0,,Айтпақшы, Нагай-күн, есіңде ме?
Dialogue: 0,0:15:04.16,0:15:08.20,Default,,0,0,0,,Мен маған кедергі келтіргенді ұнатпаймын дедім.
Dialogue: 0,0:15:08.40,0:15:09.40,Default,,0,0,0,,Сол жігіт пен оның адамдарының бәрі Стэнд қолданушылары сияқты
Dialogue: 0,0:15:10.27,0:15:12.04,Default,,0,0,0,,Бірақ Сато мырза...
Dialogue: 0,0:15:12.21,0:15:13.31,Default,,0,0,0,,Менің өміріме араласу...
Dialogue: 0,0:15:13.47,0:15:16.94,Default,,0,0,0,,Естеріңізде ме деп сұраймын!
Dialogue: 0,0:15:17.04,0:15:19.05,Default,,0,0,0,,Сұрақтарға жауап беріңіз!
Dialogue: 0,0:15:19.45,0:15:23.08,Default,,0,0,0,,Сато мырза сияқты біреуді қорлаудың үш жолы бар.
Dialogue: 0,0:15:24.08,0:15:26.12,Default,,0,0,0,,1 Арандатушылық
Dialogue: 0,0:15:26.25,0:15:28.56,Default,,0,0,0,,Ку...келе жатыр! (мылтық дыбысы)
Dialogue: 0,0:15:28.66,0:15:32.03,Default,,0,0,0,,Жүр, елес! Өлтір!
Dialogue: 0,0:15:36.00,0:15:38.37,Default,,0,0,0,,2 Тексерулер
Dialogue: 0,0:15:38.67,0:15:41.30,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:15:42.67,0:15:45.14,Default,,0,0,0,,Өшіру өте өкінішті.
Dialogue: 0,0:15:47.17,0:15:48.04,Default,,0,0,0,,(төмен итеру дыбысы)
Dialogue: 0,0:15:48.14,0:15:49.48,Default,,0,0,0,,(Мылтық дыбысы)
Dialogue: 0,0:15:49.58,0:15:50.95,Default,,0,0,0,,Гах! (Изуми) Гах...
Dialogue: 0,0:15:51.28,0:15:52.38,Default,,0,0,0,,Елес!
Dialogue: 0,0:15:53.98,0:15:55.45,Default,,0,0,0,,Үздіксіз бе?
Dialogue: 0,0:15:55.55,0:15:58.72,Default,,0,0,0,,Әдеттегідей таңқаларлық
Dialogue: 0,0:16:02.02,0:16:05.56,Default,,0,0,0,,3 Қауіпті сезіну, ол мені...
Dialogue: 0,0:16:06.43,0:16:07.13,Default,,0,0,0,,Қашу
Dialogue: 0,0:16:10.60,0:16:12.43,Default,,0,0,0,,Қарғыс атсын, мен қазір тартамын.
Dialogue: 0,0:16:12.53,0:16:13.67,Default,,0,0,0,,Гах... (Изуми) Гах...
Dialogue: 0,0:16:15.14,0:16:18.27,Default,,0,0,0,,Мен сені бүгін қашып кетуге жол бермеймін.
Dialogue: 0,0:16:20.57,0:16:24.98,Default,,0,0,0,,А... ха... ха...
Dialogue: 0,0:16:25.28,0:16:28.32,Default,,0,0,0,,Сато мырзаны осы жерге жетелей алсам...
Dialogue: 0,0:16:28.75,0:16:32.15,Default,,0,0,0,,Төбені жарып, тірідей көму ғана қалды.
Dialogue: 0,0:16:32.35,0:16:33.42,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:33.69,0:16:36.32,Default,,0,0,0,,Тірідей көмсең, қанша тірілсең де, қозғала алмайсың.
Dialogue: 0,0:16:36.52,0:16:39.49,Default,,0,0,0,,Иә, біз жеңдік.
Dialogue: 0,0:16:44.03,0:16:44.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:45.20,0:16:46.13,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:16:46.23,0:16:47.37,Default,,0,0,0,,(Адам ізімен)
Dialogue: 0,0:16:48.44,0:16:50.44,Default,,0,0,0,,Елес!
Dialogue: 0,0:16:52.01,0:16:53.64,Default,,0,0,0,,Өлетіндей тоқта!
Dialogue: 0,0:16:54.07,0:16:56.11,Default,,0,0,0,,Цубаки горилла емес—
Dialogue: 0,0:16:57.28,0:17:00.35,Default,,0,0,0,,Бұл бейбақ қанша дене жасай алады? ?
Dialogue: 0,0:17:01.28,0:17:05.19,Default,,0,0,0,,Нагай-кунның қара түсі көп болғандықтан, хаха.
Dialogue: 0,0:17:07.32,0:17:08.46,Default,,0,0,0,,(төмен итеру дыбысы)
Dialogue: 0,0:17:10.09,0:17:11.06,Default,,0,0,0,,О...
Dialogue: 0,0:17:11.69,0:17:15.70,Default,,0,0,0,,Хахаха Болса да, оларды бір уақытта шығаруға болмайды.
Dialogue: 0,0:17:17.20,0:17:20.17,Default,,0,0,0,,Ой, қарғыс атсын, мені ұстап қалды.
Dialogue: 0,0:17:20.27,0:17:22.70,Default,,0,0,0,,Сіз елестерді біраз уақытқа дейін пайдалана алмайсыз! Асығыңыз!
Dialogue: 0,0:17:23.30,0:17:27.34,Default,,0,0,0,,Қалған мәселе - сіз Сато мырзаны қуып жете аласыз ба?
Dialogue: 0,0:17:27.47,0:17:29.71,Default,,0,0,0,,Мен елестермен бірдеңе істеймін.
Dialogue: 0,0:17:30.11,0:17:34.11,Default,,0,0,0,,Сіз өзіңіздің стратегияңызды жоспарлау және ойлау үдерісі бойынша Сато мырзаға өте ұқсассыз...
Dialogue: 0,0:17:34.35,0:17:36.58,Default,,0,0,0,,Жалғыз айырмашылығы - бос оралған бөліктер.
Dialogue: 0,0:17:38.05,0:17:39.32,Default,,0,0,0,,Гах...
Dialogue: 0,0:17:39.42,0:17:41.69,Default,,0,0,0,,(Кейдің ыңырсыуы)
Dialogue: 0,0:17:41.79,0:17:42.52,Default,,0,0,0,,Нагай!
Dialogue: 0,0:17:42.62,0:17:46.13,Default,,0,0,0,,(Кейдің ыңырсыуы)
Dialogue: 0,0:17:46.23,0:17:49.36,Default,,0,0,0,,Оған көмектесу мүмкін емес, мен сақтандыруды аламын.
Dialogue: 0,0:17:50.53,0:17:53.20,Default,,0,0,0,,Мәселе... Жоқ
Dialogue: 0,0:17:53.50,0:17:55.40,Default,,0,0,0,,(ұшқышсыз ұшақтың дыбысы)
Dialogue: 0,0:17:55.50,0:17:56.54,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:18:00.74,0:18:02.11,Default,,0,0,0,,Ха (Танака) Ах!
Dialogue: 0,0:18:05.75,0:18:07.51,Default,,0,0,0,,(ұшқышсыз ұшақтың дыбысы)
Dialogue: 0,0:18:08.08,0:18:11.59,Default,,0,0,0,,Өйткені, бұл сенсің, Окуяма-кун.
Dialogue: 0,0:18:12.65,0:18:15.69,Default,,0,0,0,,Бірге көп нәрсені жасау қызық болды.
Dialogue: 0,0:18:16.12,0:18:16.62,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:16.86,0:18:17.46,Default,,0,0,0,,(пернені басу дыбысы)
Dialogue: 0,0:18:18.26,0:18:20.26,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:18:25.13,0:18:25.83,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:18:27.10,0:18:29.14,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:18:29.50,0:18:33.81,Default,,0,0,0,,Хехе, мен мақтанатын ойыншығыма өкінемін, Окуяма.
Dialogue: 0,0:18:34.17,0:18:37.18,Default,,0,0,0,,Әй, сен қашан сонша жақсы болдың?
Dialogue: 0,0:18:38.28,0:18:42.55,Default,,0,0,0,,«үшін тәжірибе». Барғың келе ме?
Dialogue: 0,0:18:42.88,0:18:46.29,Default,,0,0,0,,Аа, жалғастырыңыз.
Dialogue: 0,0:18:46.69,0:18:48.56,Default,,0,0,0,,Хахаха…
Dialogue: 0,0:18:48.79,0:18:49.82,Default,,0,0,0,,Көріп тұрмын, Нағай.
Dialogue: 0,0:18:50.42,0:18:51.43,Default,,0,0,0,,Бар
Dialogue: 0,0:18:51.86,0:18:53.26,Default,,0,0,0,,келді
Dialogue: 0,0:18:53.83,0:18:55.36,Default,,0,0,0,,Куро-чан... (Кей) Күте тұрыңыз.
Dialogue: 0,0:18:55.76,0:18:58.17,Default,,0,0,0,,Жаман жолда қалып қоймаған дұрыс...
Dialogue: 0,0:18:58.30,0:18:59.57,Default,,0,0,0,,(Изуми) Аххх (Шабуыл) Ахх
Dialogue: 0,0:18:59.70,0:19:02.17,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:19:02.27,0:19:04.57,Default,,0,0,0,,Осылай жарып шығайық!
Dialogue: 0,0:19:07.81,0:19:10.54,Default,,0,0,0,,(Сатоның күлкісі)
Dialogue: 0,0:19:10.64,0:19:13.85,Default,,0,0,0,,Бұл деми-адамдарға ғана тән, хехе.
Dialogue: 0,0:19:18.15,0:19:19.45,Default,,0,0,0,,Не?
Dialogue: 0,0:19:25.63,0:19:30.76,Default,,0,0,0,,Жоғарыда айтқанымды жалғастырсам... Сато мырза!
Dialogue: 0,0:19:31.37,0:19:32.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:32.70,0:19:36.80,Default,,0,0,0,,Қанша күтсек те...АҚШ әскері келмейді.
Dialogue: 0,0:19:37.47,0:19:38.41,Default,,0,0,0,,Олар...
Dialogue: 0,0:19:39.41,0:19:43.58,Default,,0,0,0,,Мен сені жүйке газымен қабілетсіз етемін!
Dialogue: 0,0:19:43.84,0:19:48.32,Default,,0,0,0,,Ой... қалжыңдап тұрсың ба?
Dialogue: 0,0:19:48.55,0:19:49.85,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:19:50.38,0:19:52.69,Default,,0,0,0,,Ойыныңызға еріп жүру үшін...
Dialogue: 0,0:19:53.49,0:19:55.76,Default,,0,0,0,,Мен одан шаршадым!
Dialogue: 0,0:19:55.82,0:19:56.49,Default,,0,0,0,,(Ұялы телефон түймесі басылған дыбыс)
Dialogue: 0,0:19:56.56,0:19:57.82,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:19:59.46,0:20:00.29,Default,,0,0,0,,Уау
Dialogue: 0,0:20:00.76,0:20:02.76,Default,,0,0,0,,Тірідей жерленген...
Dialogue: 0,0:20:03.40,0:20:04.63,Default,,0,0,0,,Сато мырза!
Dialogue: 0,0:20:04.73,0:20:06.67,Default,,0,0,0,,Мен бұл туралы ойладым.
Dialogue: 0,0:20:07.47,0:20:08.27,Default,,0,0,0,,Бірақ-
Dialogue: 0,0:20:08.74,0:20:11.37,Default,,0,0,0,,Мен жеңдім деп ойлаған сәт -
Dialogue: 0,0:20:12.71,0:20:16.24,Default,,0,0,0,,Адамдар аяғынан сыпырылды.
Dialogue: 0,0:20:16.31,0:20:17.95,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:20:22.95,0:20:26.85,Default,,0,0,0,,(Қоқыстың құлаған дыбысы)
Dialogue: 0,0:20:29.26,0:20:30.52,Default,,0,0,0,,А...
Dialogue: 0,0:20:32.33,0:20:32.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:34.26,0:20:34.73,Default,,0,0,0,,Жарайды
Dialogue: 0,0:20:35.73,0:20:37.43,Default,,0,0,0,,Согабеге хабарласыңыз
Dialogue: 0,0:20:38.37,0:20:39.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:43.44,0:20:44.50,Default,,0,0,0,,К-кешір!
Dialogue: 0,0:20:45.57,0:20:46.27,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:20:46.77,0:20:48.64,Default,,0,0,0,,Жығылу? (Такахаши) Мен шектен шығып кеттім бе?
Dialogue: 0,0:20:48.91,0:20:50.38,Default,,0,0,0,,Жоқ, сөз!
Dialogue: 0,0:20:50.61,0:20:51.95,Default,,0,0,0,,Құлау (Изуми) Тозаки мырза!
Dialogue: 0,0:20:53.38,0:20:54.51,Default,,0,0,0,,Ах! Уф...
Dialogue: 0,0:20:54.65,0:20:55.85,Default,,0,0,0,,Қ-қарай берсең де, мен жылап тұрғаным жоқ
Dialogue: 0,0:20:55.95,0:20:56.78,Default,,0,0,0,,Не?!
Dialogue: 0,0:20:56.95,0:20:59.59,Default,,0,0,0,,Уау... (Кей) Уау...
Dialogue: 0,0:21:04.96,0:21:07.66,Default,,0,0,0,,35 минуттан аз уақыт қалды.
Dialogue: 0,0:21:10.83,0:21:11.47,Default,,0,0,0,,(Согабенің тілін шертеді)
Dialogue: 0,0:21:12.40,0:21:13.40,Default,,0,0,0,,(Екі адам күрсінді)
Dialogue: 0,0:21:21.88,0:21:27.48,Default,,0,0,0,,Мен бәріңді өлтіремін
Dialogue: 0,0:21:32.45,0:21:33.59,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:38.66,0:21:41.96,Default,,0,0,0,,(Мылтық көтеріліп жатқан дыбыс)
Dialogue: 0,0:21:43.30,0:21:46.37,Default,,0,0,0,,(Тосакидің ыңырсыуы)
Dialogue: 0,0:21:46.47,0:21:47.60,Default,,0,0,0,,Ха! Тозаки мырза!
Dialogue: 0,0:21:48.07,0:21:49.74,Default,,0,0,0,,Жақсысың ба? ?
Dialogue: 0,0:21:50.44,0:21:52.74,Default,,0,0,0,,(қиыршықтарды көтеру дыбысы)
Dialogue: 0,0:21:53.01,0:21:53.97,Default,,0,0,0,,Ха...
Dialogue: 0,0:21:57.08,0:21:57.71,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:57.98,0:22:03.32,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:22:04.82,0:22:05.72,Default,,0,0,0,,Ха!
Dialogue: 0,0:22:06.05,0:22:10.82,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:22:12.63,0:22:15.73,Default,,0,0,0,,Ойын басталып жатыр!
Dialogue: 0,0:22:18.67,0:22:19.77,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:22:24.50,0:22:30.71,Default,,0,0,0,,♪Мен одан шаршадым, енді ауыстырайық♪
Dialogue: 0,0:22:30.81,0:22:36.02,Default,,0,0,0,,♪Сізде бар қалыпты♪
Dialogue: 0,0:22:37.08,0:22:43.46,Default,,0,0,0,,♪Жарқыраған Құдай картасы♪
Dialogue: 0,0:22:43.66,0:22:48.73,Default,,0,0,0,,♪Дұрыс қағаз картасы♪
Dialogue: 0,0:22:49.96,0:22:54.03,Default,,0,0,0,,♪Келесі жолы менің үйіме келесің♪
Dialogue: 0,0:22:56.47,0:23:00.57,Default,,0,0,0,,♪Мен саған бәрін көрсетемін♪
Dialogue: 0,0:23:00.81,0:23:02.68,Default,,0,0,0,,♪Себебі♪
Dialogue: 0,0:23:02.81,0:23:08.95,Default,,0,0,0,,♪Екі адам мектеп ауласының бұрышында, жел соғып тұр♪
Dialogue: 0,0:23:09.05,0:23:12.95,Default,,0,0,0,,♪Қазір айта аламын ба деп ойлаймын♪
Dialogue: 0,0:23:15.69,0:23:21.63,Default,,0,0,0,,♪Ешкімге айтпайтын сөздер♪
Dialogue: 0,0:23:21.96,0:23:28.10,Default,,0,0,0,,♪«Мен саған жақсы боламын, сондықтан маған қонаққа кел»♪
Dialogue: 0,0:23:28.47,0:23:34.01,Default,,0,0,0,,♪ «Мен саған бәрін беремін, эй» ♪
Dialogue: 0,0:23:34.81,0:23:44.45,Default,,0,0,0,,♪"Мәңгілік дос болайық"♪
Dialogue: 0,0:23:45.95,0:23:51.95,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
