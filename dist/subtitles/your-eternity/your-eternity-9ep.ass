Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.83,0:00:04.74,Narration,,0,0,0,,Фуши Гугу және басқалармен бірге тұрады.
Dialogue: 0,00:00:02.87,00:00:05.63,JPN TOP,,0,0,0,,Гу Гу және достарымен бірге тұру
Dialogue: 0,0:00:05.86,0:00:12.42,Narration,,0,0,0,,Күнделікті әрекеттері арқылы ол баяу ынталандыруға ие болады.
Dialogue: 0,00:00:06.88,00:00:10.51,JPN TOP,,0,0,0,,Күнделікті өмірдегі шағын тітіркендіргіштер
Dialogue: 0,00:00:11.09,00:00:13.51,JPN TOP,,0,0,0,,Балықтарда жинақталған
Dialogue: 0,0:00:14.66,0:00:17.12,Narration,,0,0,0,,Гугумен келіспеушіліктен кейін,
Dialogue: 0,00:00:15.72,00:00:18.01,JPN TOP,,0,0,0,,Фуши Гу Гумен жанжалдасып қалды.
Dialogue: 0,0:00:17.85,0:00:23.38,Narration,,0,0,0,,Фуши Пиоранның кеңесін алып, оны тауып алу үшін...
Dialogue: 0,00:00:18.81,00:00:21.18,JPN TOP,,0,0,0,,Пиоранның кеңесін алыңыз
Dialogue: 0,00:00:21.73,00:00:24.27,JPN TOP,,0,0,0,,Үйден қашып кеткен Гу Гуды іздеуге барыңыз.
Dialogue: 0,0:00:31.30,0:00:33.63,Narration,,0,0,0,,Және олар қайта қосылады.
Dialogue: 0,00:00:32.40,00:00:34.53,JPN TOP,,0,0,0,,Біз тағы да кездестік
Dialogue: 0,00:00:37.03,00:00:41.79,JPN TOP,,0,0,0,,♪~
Dialogue: 0,00:02:01.91,00:02:06.87,JPN TOP,,0,0,0,,~♪
Dialogue: 0,0:02:06.81,0:02:08.88,Main,,0,0,0,,Қараңыз. Мынау деп естідім.
Dialogue: 0,00:02:07.87,00:02:10.17,JPN TOP,,0,0,0,,Эй, міне, осында.
Dialogue: 0,0:02:09.35,0:02:11.77,Main,,0,0,0,,Құбыжық осы жерде тұрады?
Dialogue: 0,00:02:10.29,00:02:12.67,JPN TOP,,0,0,0,,Құбыжық осы жерде тұрады
Dialogue: 0,0:02:11.92,0:02:13.52,Main,,0,0,0,,Мен мұнда ешкімді көрмеймін.
Dialogue: 0,00:02:12.79,00:02:14.30,JPN TOP,,0,0,0,,Онда ешкім жоқ, солай ма?
Dialogue: 0,0:02:13.52,0:02:15.27,Main,,0,0,0,,содан кейін өзіңіз бен Фантомның арасында сызық сызып көріңіз.
Dialogue: 0,00:02:14.42,00:02:16.17,JPN TOP,,0,0,0,,Бұл қорқынышты
Dialogue: 0,00:02:16.26,00:02:17.80,JPN TOP,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,00:02:16.92,00:02:17.80,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,00:02:17.92,00:02:19.30,JPN TOP,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:02:18.70,0:02:19.86,Main,,0,0,0,,Міне!
Dialogue: 0,00:02:19.43,00:02:20.76,JPN TOP,,0,0,0,,(Үш адам айғайлайды)
Dialogue: 0,0:02:19.86,0:02:21.39,Main,,0,0,0,,Бұл құбыжық!
Dialogue: 0,00:02:20.89,00:02:22.26,JPN TOP,,0,0,0,,Уау, міне! (адам) маған көмектес
Dialogue: 0,0:02:22.45,0:02:24.19,Main,,0,0,0,,Керемет, Фуши!
Dialogue: 0,00:02:23.51,00:02:24.93,JPN TOP,,0,0,0,,Жарайсың Фуши
Dialogue: 0,00:02:25.06,00:02:26.02,JPN TOP,,0,0,0,,Хи хи
Dialogue: 0,0:02:25.38,0:02:30.12,Narration,,0,0,0,,Тітіркену неғұрлым күшті болса, соғұрлым ол жадта тереңірек сақталады.
Dialogue: 0,00:02:26.14,00:02:31.02,JPN TOP,,0,0,0,,Тітіркендіргіш неғұрлым күшті болса, соғұрлым ол жадқа тереңірек жазылады.
Dialogue: 0,0:02:30.63,0:02:34.12,Narration,,0,0,0,,Мысалы, құбыжықпен кездесу.
Dialogue: 0,00:02:31.73,00:02:35.02,JPN TOP,,0,0,0,,Мысалы, құбыжықпен кездесу
Dialogue: 0,00:02:35.15,00:02:37.03,JPN TOP,,0,0,0,,(Фушидің айқайы мен адамдардың айқайы)
Dialogue: 0,00:02:37.15,00:02:38.53,JPN TOP,,0,0,0,,Уау (әйел) Ах...
Dialogue: 0,00:02:38.65,00:02:39.61,JPN TOP,,0,0,0,,(Әйелдің айғайы)
Dialogue: 0,00:02:39.74,00:02:40.86,JPN TOP,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:02:42.74,0:02:47.09,Narration,,0,0,0,,Бір бала құбыжықпен ағайынды.
Dialogue: 0,00:02:43.49,00:02:48.25,JPN TOP,,0,0,0,,Бала құбыжықпен ағайынды.
Dialogue: 0,00:02:48.37,00:02:53.46,JPN TOP,,0,0,0,,Хахаха... Мына жүзді көрдіңіз бе? Бұл күлкілі
Dialogue: 0,0:02:49.28,0:02:51.15,Main,,0,0,0,,Сіз бұл бетті көрдіңіз бе?
Dialogue: 0,0:02:51.15,0:02:52.62,Main,,0,0,0,,Бұл күлкілі болды.
Dialogue: 0,0:02:52.62,0:02:53.63,Main,,0,0,0,,Гугу.
Dialogue: 0,00:02:53.59,00:02:55.50,JPN TOP,,0,0,0,,Гоу гу (гу гу) иә?
Dialogue: 0,0:02:54.60,0:02:58.02,Main,,0,0,0,,Сіз Booze Man орнына қайтып бармайсыз ба?
Dialogue: 0,00:02:55.63,00:02:59.05,JPN TOP,,0,0,0,,Үйге бармайсың ба? Сакеджидің орны...
Dialogue: 0,0:03:00.67,0:03:01.84,Main,,0,0,0,,Мүмкін емес.
Dialogue: 0,00:03:01.76,00:03:02.93,JPN TOP,,0,0,0,,Мүмкін емес
Dialogue: 0,0:03:03.24,0:03:07.74,Main,,0,0,0,,Сіз естіген жоқсыз ба? Beer Gramps маған ішімдік ішті.
Dialogue: 0,00:03:04.26,00:03:05.89,JPN TOP,,0,0,0,,Сіз естіген жоқсыз ба?
Dialogue: 0,00:03:06.01,00:03:08.64,JPN TOP,,0,0,0,,Саке қарт мені арақ ішуге мәжбүр етті.
Dialogue: 0,00:03:09.27,00:03:10.06,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:03:13.11,0:03:14.08,Main,,0,0,0,,Гугу!
Dialogue: 0,00:03:13.86,00:03:14.98,JPN TOP,,0,0,0,,Жарайсың!
Dialogue: 0,0:03:14.36,0:03:16.26,Main,,0,0,0,,Біртүрлі...
Dialogue: 0,00:03:15.11,00:03:17.15,JPN TOP,,0,0,0,,Не...?
Dialogue: 0,0:03:16.26,0:03:19.90,Main,,0,0,0,,Мен денемді қозғалта алмаймын.
Dialogue: 0,00:03:17.28,00:03:20.99,JPN TOP,,0,0,0,,Денеме ешқандай күш кіре алмаймын...
Dialogue: 0,0:03:20.09,0:03:24.09,Episode_Title,,0,0,0,,Терең естеліктер
Dialogue: 0,00:03:25.12,00:03:29.00,JPN TOP,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:03:28.09,0:03:31.11,Main,,0,0,0,,Мен көптен бері тамақ ішкен жоқпын.
Dialogue: 0,00:03:29.12,00:03:32.00,JPN TOP,,0,0,0,,Мен көптен бері ештеңе жеген жоқпын.
Dialogue: 0,0:03:31.38,0:03:34.31,Main,,0,0,0,,Фуши, сенде бірдеңе бар ма?
Dialogue: 0,00:03:32.12,00:03:35.17,JPN TOP,,0,0,0,,Фуши Сізде бірдеңе бар ма?
Dialogue: 0,0:03:34.31,0:03:35.74,Main,,0,0,0,,Ессіздік балалары 'ЖОҚ' жағын бөгеп, жояды
Dialogue: 0,00:03:35.29,00:03:36.63,JPN TOP,,0,0,0,,Менде жоқ
Dialogue: 0,0:03:35.93,0:03:37.21,Main,,0,0,0,,Алдымен, ортаңғы және көрсеткі саусақтарыңызды осылайша қосыңыз,
Dialogue: 0,00:03:36.75,00:03:38.55,JPN TOP,,0,0,0,,Мен...
Dialogue: 0,00:03:38.67,00:03:40.88,JPN TOP,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,00:03:43.51,00:03:47.14,JPN TOP,,0,0,0,,Фу фу фу...
Dialogue: 0,0:03:56.96,0:03:57.90,Main,,0,0,0,,Менде біраз нәрсе бар!
Dialogue: 0,0:03:57.90,0:03:59.46,Main,,0,0,0,,Мен біраз алдым, Гугу!
Dialogue: 0,00:03:57.98,00:04:00.15,JPN TOP,,0,0,0,,Бұл шықты! Гу Гу шықты
Dialogue: 0,0:03:59.46,0:04:01.34,Main,,0,0,0,,Күте тұрыңыз, мен көбірек жасаймын.
Dialogue: 0,00:04:00.28,00:04:02.24,JPN TOP,,0,0,0,,Күте тұрыңыз, мен оны қайтадан жасаймын.
Dialogue: 0,00:04:04.07,00:04:05.24,JPN TOP,,0,0,0,,Ах (жұт) Иә?
Dialogue: 0,0:04:04.26,0:04:05.92,Main,,0,0,0,,Мен жасадым! Жеңдер!
Dialogue: 0,00:04:05.37,00:04:07.49,JPN TOP,,0,0,0,,Орындалды! Кружканы жеп қойыңыз...
Dialogue: 0,0:04:06.75,0:04:07.89,Main,,0,0,0,,Иә!
Dialogue: 0,00:04:07.62,00:04:08.95,JPN TOP,,0,0,0,,Тамаша!
Dialogue: 0,0:04:08.83,0:04:11.29,Main,,0,0,0,,Мен сенің де тамақ жасай алатыныңды білмедім.
Dialogue: 0,00:04:09.95,00:04:12.04,JPN TOP,,0,0,0,,Сіз тіпті тамақ жасай аласыз ба?
Dialogue: 0,0:04:11.29,0:04:17.35,Narration,,0,0,0,,Бір нәрсе оны неғұрлым ынталандырса, соғұрлым оны жасау оңай болды.
Dialogue: 0,00:04:12.16,00:04:15.75,JPN TOP,,0,0,0,,Тітіркену неғұрлым күшті болса, соғұрлым көп болады
Dialogue: 0,00:04:15.88,00:04:18.63,JPN TOP,,0,0,0,,Жасалуы оңай болды.
Dialogue: 0,0:04:17.01,0:04:19.63,Main - Top,,0,0,0,,Уау, бұл керемет. Тағы не жасай аласыз?
Dialogue: 0,0:04:17.70,0:04:21.35,Narration,,0,0,0,,Тітіркену неғұрлым күшті болса, соғұрлым ол жадта тереңірек сақталады.
Dialogue: 0,00:04:18.75,00:04:22.63,JPN TOP,,0,0,0,,Тітіркендіргіш неғұрлым күшті болса, соғұрлым ол жадқа тереңірек жазылады.
Dialogue: 0,0:04:19.63,0:04:20.77,Main - Top,,0,0,0,,Тек осы.
Dialogue: 0,0:04:20.77,0:04:21.73,Main - Top,,0,0,0,,О, жарайды...
Dialogue: 0,0:04:22.34,0:04:25.45,Narration,,0,0,0,,Бірақ оның алға қарай өсуіне байланысты,
Dialogue: 0,00:04:23.42,00:04:26.30,JPN TOP,,0,0,0,,Алайда болашақ өсімге байланысты
Dialogue: 0,0:04:25.45,0:04:28.76,Narration,,0,0,0,,ол заттарды жақсы еске түсіріп, қайта жасай алады
Dialogue: 0,00:04:26.43,00:04:31.47,JPN TOP,,0,0,0,,Тіпті аздаған ынталандыру арқылы алынған заттар да жақсы есте сақталады.
Dialogue: 0,0:04:28.76,0:04:33.08,Narration,,0,0,0,,ол тіпті шамалы ынталандыру арқылы алған.
Dialogue: 0,00:04:31.60,00:04:35.52,JPN TOP,,0,0,0,,оята алатын болады
Dialogue: 0,00:04:31.60,00:04:35.52,JPN TOP,,0,0,0,,Мен оны енді жей алмаймын.
Dialogue: 0,0:04:32.27,0:04:34.39,Main - Top,,0,0,0,,Толып кеттім.
Dialogue: 0,00:04:36.35,00:04:37.15,JPN TOP,,0,0,0,,Әй
Dialogue: 0,00:04:38.11,00:04:39.73,JPN TOP,,0,0,0,,(ит үреді)
Dialogue: 0,00:04:39.86,00:04:40.98,JPN TOP,,0,0,0,,Кезек
Dialogue: 0,0:04:40.95,0:04:42.03,Main,,0,0,0,,Джоан.
Dialogue: 0,00:04:41.86,00:04:43.19,JPN TOP,,0,0,0,,Джоан…
Dialogue: 0,0:04:42.39,0:04:43.22,Main,,0,0,0,,Меер!
Dialogue: 0,00:04:43.32,00:04:46.95,JPN TOP,,0,0,0,,Тамақ! Ол тағы да үйден жасырынып шықты ма?
Dialogue: 0,0:04:43.51,0:04:46.00,Main,,0,0,0,,Сіз тағы да үйден қашып кеттіңіз бе?
Dialogue: 0,0:04:46.00,0:04:46.98,Main,,0,0,0,,Джоан.
Dialogue: 0,0:04:46.98,0:04:48.47,Main,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,00:04:47.07,00:04:47.87,JPN TOP,,0,0,0,,Джоан
Dialogue: 0,00:04:47.99,00:04:52.12,JPN TOP,,0,0,0,,Жоқ, бұл Мир Линнің иті.
Dialogue: 0,0:04:48.47,0:04:51.11,Main,,0,0,0,,Бұл Рианның иті Меер.
Dialogue: 0,0:04:51.94,0:04:53.76,Main,,0,0,0,,Сіз айтқан «Джоан» дегеніміз не?
Dialogue: 0,00:04:53.08,00:04:54.83,JPN TOP,,0,0,0,,Джоан дегеніміз не?
Dialogue: 0,00:04:54.96,00:04:57.33,JPN TOP,,0,0,0,,Хмм... Джоан...
Dialogue: 0,0:04:55.23,0:04:56.16,Main,,0,0,0,,Джоан...
Dialogue: 0,0:04:56.89,0:05:00.85,Main,,0,0,0,,Біреу бетімді көргенде солай деді.
Dialogue: 0,00:04:57.92,00:05:01.75,JPN TOP,,0,0,0,,Біреу бетімді көргенде солай атады
Dialogue: 0,0:05:00.85,0:05:03.83,Main,,0,0,0,,Бұл сіздің атыңыз болуы керек.
Dialogue: 0,00:05:01.88,00:05:04.72,JPN TOP,,0,0,0,,Онда бұл сіздің атыңыз болуы керек.
Dialogue: 0,0:05:03.83,0:05:05.96,Main,,0,0,0,,Сені осылай атаған ата-анаң ба?
Dialogue: 0,00:05:04.84,00:05:07.30,JPN TOP,,0,0,0,,Сізді ата-анаңыз шақырды ма?
Dialogue: 0,0:05:06.31,0:05:07.87,Main,,0,0,0,,Тик-так, сағат тілі тик-так
Dialogue: 0,00:05:07.43,00:05:08.76,JPN TOP,,0,0,0,,Шынында да. Мен оны жеңілдетіп бағаладым. Шынында да жеңілдетіп бағаладым
Dialogue: 0,0:05:07.87,0:05:11.60,Main,,0,0,0,,Бірақ ол адам менің бірінші адамым болды.
Dialogue: 0,00:05:08.89,00:05:12.56,JPN TOP,,0,0,0,,Бірақ ол адам менің бірінші адамым болды.
Dialogue: 0,0:05:11.60,0:05:17.37,Main,,0,0,0,,Қозғалысын қойып, бос қалды, сондықтан мен оған айналдым.
Dialogue: 0,00:05:12.68,00:05:15.98,JPN TOP,,0,0,0,,Өйткені ол қозғалуды тоқтатты және мазмұны жойылды.
Dialogue: 0,00:05:16.10,00:05:18.27,JPN TOP,,0,0,0,,Мен сол адамға айналдым.
Dialogue: 0,0:05:19.02,0:05:20.63,Main,,0,0,0,,Б... бір сызық
Dialogue: 0,00:05:20.11,00:05:21.52,JPN TOP,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,0:05:20.83,0:05:26.53,Main,,0,0,0,,Демек, сенің қазіргі түрің басқа біреудікі, ал ол адам қазір өлді.
Dialogue: 0,00:05:21.65,00:05:25.19,JPN TOP,,0,0,0,,Сіздің қазіргі келбетіңіз біреуге негізделген.
Dialogue: 0,00:05:25.32,00:05:27.57,JPN TOP,,0,0,0,,Бұл оның өлгенін білдіре ме?
Dialogue: 0,0:05:27.01,0:05:28.26,Main,,0,0,0,,Өлді ме?
Dialogue: 0,00:05:28.11,00:05:29.28,JPN TOP,,0,0,0,,Шинда?
Dialogue: 0,0:05:28.26,0:05:29.30,Main,,0,0,0,,Оқу, оқу
Dialogue: 0,0:05:29.30,0:05:30.63,Main,,0,0,0,,Олардың уақыты келді.
Dialogue: 0,00:05:29.41,00:05:31.95,JPN TOP,,0,0,0,,А, мен өлімді кездестірдім.
Dialogue: 0,0:05:30.98,0:05:33.51,Main,,0,0,0,,Сіз де қыз бола аласыз, солай ма?
Dialogue: 0,00:05:32.08,00:05:34.41,JPN TOP,,0,0,0,,Сіз де қыз бола аласыз.
Dialogue: 0,0:05:33.76,0:05:35.90,Main,,0,0,0,,Сол қыз да өлді ме?
Dialogue: 0,00:05:34.54,00:05:36.79,JPN TOP,,0,0,0,,Қыз да өлді ме?
Dialogue: 0,0:05:37.88,0:05:40.60,Main,,0,0,0,,Ал анау үлкен аю мен қасқыр?
Dialogue: 0,00:05:38.92,00:05:41.50,JPN TOP,,0,0,0,,Сол үлкен аюлар мен қасқырлар ше?
Dialogue: 0,0:05:42.01,0:05:43.72,Main,,0,0,0,,«Өлім» деген не?
Dialogue: 0,00:05:43.05,00:05:44.63,JPN TOP,,0,0,0,,«Ши» бірдеңені білдіреді ме?
Dialogue: 0,0:05:43.98,0:05:46.90,Main,,0,0,0,,Бұл сіз бос болу деп атайтын нәрсе.
Dialogue: 0,00:05:44.76,00:05:47.84,JPN TOP,,0,0,0,,Сіз бос болады дейсіз.
Dialogue: 0,0:05:46.90,0:05:50.41,Main,,0,0,0,,Бұл орын алған соң, бұрынғы күйіңізге қайта алмайсыз.
Dialogue: 0,00:05:47.97,00:05:51.30,JPN TOP,,0,0,0,,Бұл орын алған соң, сіз ешқашан қайтып орала алмайсыз.
Dialogue: 0,0:05:50.41,0:05:51.86,Main,,0,0,0,,Өлім деген осы.
Dialogue: 0,00:05:51.43,00:05:52.76,JPN TOP,,0,0,0,,Бұл өлім
Dialogue: 0,0:05:54.12,0:05:58.63,Main,,0,0,0,,Сіз ауырсынуға реакция ретінде жаңа нәрселер жасайсыз, солай ма?
Dialogue: 0,00:05:54.89,00:05:59.52,JPN TOP,,0,0,0,,Сіз жаңа нәрсе жасау арқылы ауырсынуға жауап бересіз.
Dialogue: 0,0:05:58.94,0:06:02.49,Main,,0,0,0,,Менің ойымша, бұл сіздің эмоционалды ауырсынуға жауап беретініңізді білдіреді ме?
Dialogue: 0,00:05:59.65,00:06:03.40,JPN TOP,,0,0,0,,Бұл да эмоционалды ауырсынуға жауап бере ме деп ойлаймын.
Dialogue: 0,0:06:02.93,0:06:08.32,Main,,0,0,0,,Мысалы, мен өлсем, сен ренжісең, сен мен бола аласың.
Dialogue: 0,00:06:04.03,00:06:06.28,JPN TOP,,0,0,0,,Мысалы, мен өлгендіктен
Dialogue: 0,00:06:06.40,00:06:09.24,JPN TOP,,0,0,0,,Сен шошып кетсең, мен де аламын.
Dialogue: 0,0:06:08.32,0:06:09.82,Main,,0,0,0,,Бұл осылай жұмыс істейді, солай емес пе?
Dialogue: 0,00:06:09.36,00:06:11.12,JPN TOP,,0,0,0,,Айтқыңыз келгені осы емес пе?
Dialogue: 0,0:06:10.18,0:06:11.13,Main,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,00:06:11.24,00:06:12.03,JPN TOP,,0,0,0,,Мүмкін
Dialogue: 0,0:06:11.41,0:06:14.24,Main,,0,0,0,,Уау, бұл керемет. Маған бұл өте ұнайды.
Dialogue: 0,00:06:12.58,00:06:15.08,JPN TOP,,0,0,0,,Жақсы, бұл өте жақсы.
Dialogue: 0,0:06:14.24,0:06:15.39,Main,,0,0,0,,Тағы бір қосымша сабақ па, қазірден-ақ?
Dialogue: 0,00:06:15.20,00:06:16.29,JPN TOP,,0,0,0,,Неліктен?
Dialogue: 0,0:06:15.63,0:06:21.39,Main,,0,0,0,,Мен өлсем де сен мені ойлайсың.
Dialogue: 0,00:06:16.41,00:06:18.33,JPN TOP,,0,0,0,,Мен өлсем де
Dialogue: 0,00:06:18.46,00:06:22.29,JPN TOP,,0,0,0,,Мен туралы тек сен ғана ойлайсың деген сөз емес пе?
Dialogue: 0,0:06:22.71,0:06:23.41,Main,,0,0,0,,Оқу, оқу
Dialogue: 0,0:06:23.41,0:06:25.86,Main,,0,0,0,,Мен жалғызбын, білесің бе.
Dialogue: 0,00:06:23.50,00:06:24.30,JPN TOP,,0,0,0,,Иә
Dialogue: 0,00:06:24.42,00:06:27.09,JPN TOP,,0,0,0,,Өйткені мен жалғызбын
Dialogue: 0,0:06:26.21,0:06:32.03,Main,,0,0,0,,Егер мен кәдімгі отбасында дүниеге келсем, мен ешқашан тамақты жіберіп алмас едім.
Dialogue: 0,00:06:27.22,00:06:30.09,JPN TOP,,0,0,0,,Бұл қалыпты отбасында өскен бала болса.
Dialogue: 0,00:06:30.22,00:06:32.93,JPN TOP,,0,0,0,,Күнде міндетті түрде күрішті жеңіз.
Dialogue: 0,0:06:32.03,0:06:34.78,Main,,0,0,0,,Менің ұйықтайтын жерім жұмсақ болар еді.
Dialogue: 0,00:06:33.05,00:06:35.68,JPN TOP,,0,0,0,,Сізге үлпілдек төсек дайындаңыз.
Dialogue: 0,0:06:35.08,0:06:38.54,Main,,0,0,0,,Қызып кетсем, Маған анам болар еді,
Dialogue: 0,00:06:35.81,00:06:39.44,JPN TOP,,0,0,0,,Қызып кетсем қарайтын анам бар.
Dialogue: 0,0:06:38.88,0:06:42.08,Main,,0,0,0,,және әкесі: «Көңіл-күйіңіз қалай?»
Dialogue: 0,00:06:39.56,00:06:42.98,JPN TOP,,0,0,0,,Менің әкем бар, ол менен: «Қалайсың?» деп сұрайды.
Dialogue: 0,0:06:42.33,0:06:46.43,Main,,0,0,0,,Жаман болуы мүмкін, бірақ менімен ойнауға уақыт табатын егіз ағалар.
Dialogue: 0,00:06:43.11,00:06:47.32,JPN TOP,,0,0,0,,Менің егіз әпкем бар, ол жаман, бірақ менімен ойнайды.
Dialogue: 0,0:06:46.77,0:06:50.42,Main,,0,0,0,,Ал маған бір нәрсе үйрететін аға.
Dialogue: 0,00:06:47.44,00:06:51.32,JPN TOP,,0,0,0,,Маған көп нәрсені үйрететін үлкен ағам бар...
Dialogue: 0,0:06:50.42,0:06:55.80,Main,,0,0,0,,Қалыпты өмір - бұл көптеген адамдар сіз туралы ойлайтын өмір, солай ма?
Dialogue: 0,00:06:51.45,00:06:54.24,JPN TOP,,0,0,0,,Көпшілік бағалаған өмір
Dialogue: 0,00:06:54.37,00:06:56.91,JPN TOP,,0,0,0,,Бұл «қалыпты» емес пе?
Dialogue: 0,0:06:56.43,0:07:02.27,Main,,0,0,0,,Ал... Сосын, бір күні мен бірдеңе дұрыс емес екенін байқадым.
Dialogue: 0,00:06:57.45,00:06:59.96,JPN TOP,,0,0,0,,Сонымен... болды
Dialogue: 0,00:07:00.08,00:07:03.17,JPN TOP,,0,0,0,,Бірақ бір күні мен бірдеңе дұрыс емес екенін түсіндім.
Dialogue: 0,0:07:02.51,0:07:04.15,Flashback,,0,0,0,,Келіңдер, балалар.
Dialogue: 0,00:07:03.29,00:07:05.00,JPN TOP,,0,0,0,,Келіңдер, балалар.
Dialogue: 0,0:07:04.15,0:07:05.71,Flashback,,0,0,0,,Бізде торт бар.
Dialogue: 0,00:07:05.13,00:07:07.88,JPN TOP,,0,0,0,,Мен торт алдым. Оны бірге жейік.
Dialogue: 0,0:07:05.71,0:07:06.98,Flashback,,0,0,0,,Бірге тамақтанайық.
Dialogue: 0,0:07:06.98,0:07:08.47,Flashback,,0,0,0,,Иә!
Dialogue: 0,00:07:08.01,00:07:11.55,JPN TOP,,0,0,0,,Иә! Сен менің уәдемді есіңе түсірдің.
Dialogue: 0,0:07:08.47,0:07:10.70,Flashback,,0,0,0,,Біздің уәдемізді есіңе түсірдің!
Dialogue: 0,0:07:10.70,0:07:12.38,Flashback,,0,0,0,,Шие торты, солай ма?
Dialogue: 0,00:07:11.68,00:07:14.51,JPN TOP,,0,0,0,,Бұл шие торты, солай ма? Мен оны жақсы көремін!
Dialogue: 0,0:07:12.38,0:07:13.62,Flashback,,0,0,0,,Мен шие тортын жақсы көремін!
Dialogue: 0,0:07:14.58,0:07:15.81,Flashback,,0,0,0,,Күте тұрыңыз, Гугу.
Dialogue: 0,00:07:14.64,00:07:15.56,JPN TOP,,0,0,0,,Ахаха
Dialogue: 0,00:07:15.68,00:07:17.01,JPN TOP,,0,0,0,,Тоқта, гу гу (гу гу) А?
Dialogue: 0,0:07:16.75,0:07:17.63,Flashback,,0,0,0,,Сен оларды сондай-ақ тастап жібересің.
Dialogue: 0,00:07:17.14,00:07:18.85,JPN TOP,,0,0,0,,Иә? Күте тұрыңыз
Dialogue: 0,0:07:18.43,0:07:19.76,Flashback,,0,0,0,,Бұл ереже.
Dialogue: 0,00:07:19.48,00:07:20.64,JPN TOP,,0,0,0,,Бұл ереже
Dialogue: 0,0:07:19.76,0:07:23.14,Flashback,,0,0,0,,Екеуің не күтіп тұрсыңдар?
Dialogue: 0,00:07:20.77,00:07:24.02,JPN TOP,,0,0,0,,Ой, балалар, неге ұстайсыңдар?
Dialogue: 0,0:07:23.14,0:07:24.22,Flashback,,0,0,0,,Оқу, оқу
Dialogue: 0,00:07:24.15,00:07:26.90,JPN TOP,,0,0,0,,Иә, осында келіп тамақтан.
Dialogue: 0,0:07:24.22,0:07:26.01,Flashback,,0,0,0,,Мына жерге келіп тамақтан.
Dialogue: 0,0:07:26.01,0:07:28.25,Flashback,,0,0,0,,Жарайды. Рақмет сізге.
Dialogue: 0,00:07:27.02,00:07:29.15,JPN TOP,,0,0,0,,Иә, рақмет.
Dialogue: 0,0:07:28.45,0:07:34.02,Main,,0,0,0,,Біраз уақыттан кейін әкемнің жұмысына байланысты біздің отбасы көшіп келді.
Dialogue: 0,00:07:29.28,00:07:30.74,JPN TOP,,0,0,0,,Біраз уақыттан кейін
Dialogue: 0,00:07:30.86,00:07:34.91,JPN TOP,,0,0,0,,Әкесінің жұмысына байланысты отбасы көшуге мәжбүр болды.
Dialogue: 0,0:07:36.36,0:07:39.89,Main,,0,0,0,,Бірақ олар бізді өздерімен бірге алып кетпеді.
Dialogue: 0,00:07:37.37,00:07:40.79,JPN TOP,,0,0,0,,Бірақ олар бізді ала алмады.
Dialogue: 0,0:07:40.73,0:07:43.27,Flashback,,0,0,0,,Екеуміз ғана қалдық.
Dialogue: 0,00:07:41.79,00:07:44.38,JPN TOP,,0,0,0,,Бұл екеуміз ғана...
Dialogue: 0,0:07:43.79,0:07:46.37,Flashback,,0,0,0,,Ал, енді қайда жұмыс істеуіміз керек?
Dialogue: 0,00:07:44.92,00:07:47.25,JPN TOP,,0,0,0,,Енді, бұдан былай қайда жұмыс істейсің?
Dialogue: 0,0:07:48.50,0:07:52.94,Main,,0,0,0,,Мен отбасымыз деп ойлаған адамдар біздің жұмыс берушілер еді.
Dialogue: 0,00:07:49.38,00:07:52.09,JPN TOP,,0,0,0,,Мен отбасы деп ойлаған адамдар
Dialogue: 0,00:07:52.22,00:07:54.05,JPN TOP,,0,0,0,,Ол жай ғана жұмыс беруші болды.
Dialogue: 0,0:07:53.60,0:07:57.90,Main,,0,0,0,,Мені ойлаған жалғыз ағам еді.
Dialogue: 0,00:07:54.68,00:07:58.93,JPN TOP,,0,0,0,,Мені ойлайтын бір ғана адам бар, ағайын.
Dialogue: 0,0:07:58.39,0:08:01.99,Main,,0,0,0,,Екеуміз ғана болған кезде де ағам маған жақсы қарады.
Dialogue: 0,00:07:59.47,00:08:02.89,JPN TOP,,0,0,0,,Екеуміз болған соң да ағам маған мейіріммен қарайтын.
Dialogue: 0,0:08:03.09,0:08:05.49,Main,,0,0,0,,Бірақ бұл да бітті.
Dialogue: 0,00:08:04.19,00:08:06.40,JPN TOP,,0,0,0,,Бірақ бәрі бітті
Dialogue: 0,0:08:05.92,0:08:08.41,Main,,0,0,0,,Оқиғалар болды, енді мен жалғызбын.
Dialogue: 0,00:08:07.02,00:08:09.32,JPN TOP,,0,0,0,,Неге екені белгісіз, соңында бір ғана адам болды.
Dialogue: 0,0:08:08.83,0:08:11.26,Main,,0,0,0,,Бірақ сіз қазір осындасыз.
Dialogue: 0,00:08:09.90,00:08:12.32,JPN TOP,,0,0,0,,Бірақ қазір сіз осындасыз
Dialogue: 0,0:08:12.03,0:08:14.33,Main,,0,0,0,,Өткен күн үшін кешіріңіз, Фуши.
Dialogue: 0,00:08:13.11,00:08:15.20,JPN TOP,,0,0,0,,Өткен күн үшін кешіріңіз.
Dialogue: 0,0:08:14.33,0:08:16.67,Main,,0,0,0,,Сені ренжіткені үшін.
Dialogue: 0,00:08:15.32,00:08:17.58,JPN TOP,,0,0,0,,Сізге зиян тигізетін нәрсені жасаңыз...
Dialogue: 0,0:08:18.10,0:08:21.32,Main,,0,0,0,,Мен өлсем, мен бол, Фуши.
Dialogue: 0,00:08:19.16,00:08:22.21,JPN TOP,,0,0,0,,Мен өлсем, мен бол, Фуши.
Dialogue: 0,0:08:23.22,0:08:23.93,Main,,0,0,0,,Алдымен, ортаңғы және көрсеткі саусақтарыңызды осылайша қосыңыз,
Dialogue: 0,00:08:24.04,00:08:24.83,JPN TOP,,0,0,0,,Иә
Dialogue: 0,00:08:24.96,00:08:26.83,JPN TOP,,0,0,0,,Хаха...
Dialogue: 0,0:08:26.63,0:08:29.05,Main,,0,0,0,,Менің ұйқым қашады.
Dialogue: 0,00:08:27.67,00:08:29.96,JPN TOP,,0,0,0,,Мен аздап ұйықтап жатырмын.
Dialogue: 0,0:08:29.26,0:08:30.75,Main,,0,0,0,,Сіз көп жедіңіз бе?
Dialogue: 0,00:08:30.09,00:08:31.80,JPN TOP,,0,0,0,,Тым көп жейсіз бе?
Dialogue: 0,0:08:30.91,0:08:34.63,Main,,0,0,0,,Мен қазір шынымен бақыттымын.
Dialogue: 0,00:08:31.92,00:08:35.80,JPN TOP,,0,0,0,,Мен... Мен қазір шынымен бақыттымын.
Dialogue: 0,0:08:35.23,0:08:41.53,Main,,0,0,0,,Сен ғана мен үшін уайымдап келдің.
Dialogue: 0,00:08:36.34,00:08:37.93,JPN TOP,,0,0,0,,Өйткені сіз...
Dialogue: 0,00:08:38.05,00:08:40.26,JPN TOP,,0,0,0,,Мен үшін тек сен ғана алаңдайсың
Dialogue: 0,00:08:40.39,00:08:42.43,JPN TOP,,0,0,0,,Мені ойлап келгеніңіз үшін рахмет...
Dialogue: 0,0:08:42.06,0:08:46.13,Main,,0,0,0,,Біз нағыз отбасымыз десек те болады.
Dialogue: 0,00:08:43.14,00:08:47.23,JPN TOP,,0,0,0,,Нағыз жанұядай сезінеді.
Dialogue: 0,00:08:50.86,00:08:53.95,JPN TOP,,0,0,0,,(Гу-Гудың ұйқысы)
Dialogue: 0,0:08:59.82,0:09:01.85,Main,,0,0,0,,Гугу?
Dialogue: 0,00:09:00.91,00:09:02.95,JPN TOP,,0,0,0,,Жақсы ма?
Dialogue: 0,0:09:13.92,0:09:16.25,Main,,0,0,0,,Міне, сіз! Шығу мұнда!
Dialogue: 0,00:09:14.97,00:09:17.13,JPN TOP,,0,0,0,,Міне болды! Осындай жерде
Dialogue: 0,0:09:16.86,0:09:17.95,Main,,0,0,0,,Реан!
Dialogue: 0,00:09:17.26,00:09:18.84,JPN TOP,,0,0,0,,Иә? Арық?
Dialogue: 0,0:09:17.95,0:09:20.49,Main,,0,0,0,,Шиш. Білесің бе, мен сені әр жерден іздедім.
Dialogue: 0,00:09:18.97,00:09:21.31,JPN TOP,,0,0,0,,Қазірдің өзінде! Мен көптен бері іздеп жүрмін.
Dialogue: 0,0:09:20.49,0:09:22.35,Main,,0,0,0,,Менің осында екенімді қайдан білдің?
Dialogue: 0,00:09:21.43,00:09:23.22,JPN TOP,,0,0,0,,Сіз мұны қайдан білдіңіз?
Dialogue: 0,0:09:22.35,0:09:24.29,Main,,0,0,0,,Мен Меердің үргенін естідім.
Dialogue: 0,00:09:23.35,00:09:25.10,JPN TOP,,0,0,0,,Мен Мирдің дауысын естідім.
Dialogue: 0,0:09:24.29,0:09:26.95,Main,,0,0,0,,Үйден қашатын әдеті бар.
Dialogue: 0,00:09:25.23,00:09:27.85,JPN TOP,,0,0,0,,Бұл баланың қашатын әдеті бар ғой, солай ма?
Dialogue: 0,00:09:27.98,00:09:29.65,JPN TOP,,0,0,0,,Кю…
Dialogue: 0,00:09:35.11,00:09:36.49,JPN TOP,,0,0,0,,Хмм...
Dialogue: 0,00:09:36.61,00:09:37.74,JPN TOP,,0,0,0,,Күрсін...
Dialogue: 0,00:09:37.86,00:09:38.99,JPN TOP,,0,0,0,,Нуу…
Dialogue: 0,0:09:38.27,0:09:39.98,Main,,0,0,0,,Неге қайтып келмейсің?!
Dialogue: 0,00:09:39.12,00:09:40.87,JPN TOP,,0,0,0,,Неге үйге бармайсың?
Dialogue: 0,0:09:39.98,0:09:42.41,Main,,0,0,0,,Неге маған қайтып кет деп айтасың?!
Dialogue: 0,00:09:40.99,00:09:43.29,JPN TOP,,0,0,0,,Неге маған үйге барайын деп тұрсың?
Dialogue: 0,0:09:42.41,0:09:44.18,Main,,0,0,0,,Мен құрбанмын!
Dialogue: 0,00:09:43.41,00:09:45.08,JPN TOP,,0,0,0,,Мен құрбанмын
Dialogue: 0,0:09:44.18,0:09:47.42,Main,,0,0,0,,Қария кешірім сұраймын дейді.
Dialogue: 0,00:09:45.20,00:09:48.29,JPN TOP,,0,0,0,,Кәрі екенсің, өкініпсің.
Dialogue: 0,0:09:47.42,0:09:50.04,Main,,0,0,0,,He says he'll take the thing out of your stomach.
Dialogue: 0,00:09:48.42,00:09:51.96,JPN TOP,,0,0,0,,I'll take what's in your stomach for free.
Dialogue: 0,0:09:50.04,0:09:51.06,Main,,0,0,0,,Тегін!
Dialogue: 0,0:09:51.06,0:09:52.63,Main,,0,0,0,,Тегін?!
Dialogue: 0,00:09:52.09,00:09:54.67,JPN TOP,,0,0,0,,Тегін? Бұл анық!
Dialogue: 0,0:09:52.63,0:09:53.76,Main,,0,0,0,,Әрине тегін болады!
Dialogue: 0,0:09:54.13,0:09:56.04,Main,,0,0,0,,Сонымен, сіз қайтып келесіз, солай ма?
Dialogue: 0,00:09:55.21,00:09:58.01,JPN TOP,,0,0,0,,Сіз кетесіз, солай ма? Тез барайық
Dialogue: 0,0:09:56.04,0:09:57.16,Main,,0,0,0,,Вент одан әрі ашылмауына қол жеткіздік.
Dialogue: 0,0:09:57.16,0:09:58.27,Main,,0,0,0,,Сен оларды сондай-ақ тастап жібересің.
Dialogue: 0,00:09:58.13,00:09:59.18,JPN TOP,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:09:58.50,0:10:01.12,Main,,0,0,0,,Бұл бәрі мені қайтарғысы келеді дегенді білдіре ме?
Dialogue: 0,00:09:59.30,00:10:02.93,JPN TOP,,0,0,0,,Менің қайтып оралғанымды қалайсыз ба? Неліктен?
Dialogue: 0,0:10:01.12,0:10:02.03,Main,,0,0,0,,Тағы бір қосымша сабақ па, қазірден-ақ?
Dialogue: 0,0:10:03.41,0:10:05.96,Main,,0,0,0,,Сен бәріне керексің.
Dialogue: 0,00:10:04.43,00:10:08.52,JPN TOP,,0,0,0,,Сен бәрімізге керексің, өйткені біз сені жақсы көреміз.
Dialogue: 0,0:10:06.31,0:10:07.61,Main,,0,0,0,,Біз сені жақсы көреміз.
Dialogue: 0,0:10:07.61,0:10:09.86,Main,,0,0,0,,R-Шынымен бе?
Dialogue: 0,00:10:08.64,00:10:11.02,JPN TOP,,0,0,0,,О... шынымен бе?
Dialogue: 0,0:10:10.78,0:10:12.13,Main,,0,0,0,,Тіпті сен бе?
Dialogue: 0,00:10:11.77,00:10:13.02,JPN TOP,,0,0,0,,Лин мырза да?
Dialogue: 0,0:10:12.39,0:10:13.34,Main,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,00:10:13.15,00:10:14.36,JPN TOP,,0,0,0,,Иә
Dialogue: 0,0:10:13.87,0:10:17.13,Flashback,,0,0,0,,Grandfather, Grandmother, I've made lunch.
Dialogue: 0,00:10:14.90,00:10:18.03,JPN TOP,,0,0,0,,Ата мен әже, мен күріш жасадым.
Dialogue: 0,00:10:18.15,00:10:19.49,JPN TOP,,0,0,0,,Мен бүкіл әлемді араладым.
Dialogue: 0,00:10:19.61,00:10:21.07,JPN TOP,,0,0,0,,Мазуфехе
Dialogue: 0,0:10:20.19,0:10:22.97,Flashback,,0,0,0,,Why don't you cook for yourselves if you have complaints?
Dialogue: 0,00:10:21.20,00:10:23.83,JPN TOP,,0,0,0,,If you're going to complain, why don't you make it yourself?
Dialogue: 0,0:10:22.97,0:10:24.62,Flashback,,0,0,0,,Қаламаймын.
Dialogue: 0,00:10:23.95,00:10:25.45,JPN TOP,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:10:24.62,0:10:26.33,Flashback,,0,0,0,,Тым көп жұмыс.
Dialogue: 0,00:10:25.58,00:10:27.79,JPN TOP,,0,0,0,,Бұл түтіккен...
Dialogue: 0,0:10:26.89,0:10:29.89,Flashback,,0,0,0,,Мен ол екеуіне бала күтпеймін!
Dialogue: 0,00:10:27.91,00:10:30.79,JPN TOP,,0,0,0,,I'm sorry for putting so much weight on those two people.
Dialogue: 0,0:10:33.14,0:10:34.65,Main,,0,0,0,,Мен қайтып оралмаймын.
Dialogue: 0,00:10:34.21,00:10:35.38,JPN TOP,,0,0,0,,Бірақ мен үйге бармаймын
Dialogue: 0,00:10:35.50,00:10:36.55,JPN TOP,,0,0,0,,Уф… Ах…
Dialogue: 0,0:10:36.38,0:10:38.86,Main,,0,0,0,,Мен маскамды лақтырып жібердім.
Dialogue: 0,00:10:37.51,00:10:39.76,JPN TOP,,0,0,0,,Мен масканы лақтырып жібердім
Dialogue: 0,0:10:38.86,0:10:42.12,Main,,0,0,0,,Бұл мен адам болып өмірімді тастадым деген сөз.
Dialogue: 0,00:10:39.88,00:10:43.01,JPN TOP,,0,0,0,,Бұл адам ретінде өмірден бас тартуды білдіреді.
Dialogue: 0,0:10:42.98,0:10:45.99,Main,,0,0,0,,Мен маска тұтынушыларды тартуға арналған деп ойладым.
Dialogue: 0,00:10:43.14,00:10:46.89,JPN TOP,,0,0,0,,Иә? Бұл маска тұтынушыларды тартуға арналған еді, солай емес пе?
Dialogue: 0,0:10:45.99,0:10:49.16,Main,,0,0,0,,Кешіріңіз. Мен өтірік айттым.
Dialogue: 0,00:10:47.02,00:10:50.10,JPN TOP,,0,0,0,,Кешіріңіз, өтірік айттым.
Dialogue: 0,0:10:49.16,0:10:52.00,Main,,0,0,0,,Бұл маска бетімнің жарақатын жасыруға арналған.
Dialogue: 0,00:10:50.23,00:10:52.90,JPN TOP,,0,0,0,,Бұл оның бетіндегі жарақатты жасыру үшін.
Dialogue: 0,0:10:52.00,0:10:53.80,Main,,0,0,0,,Бейшара.
Dialogue: 0,00:10:53.02,00:10:57.07,JPN TOP,,0,0,0,,Кешіріңіз... сол себепті тығылып отырсыз.
Dialogue: 0,0:10:53.80,0:10:55.91,Main,,0,0,0,,Сондықтан сіз жасырып отырсыз.
Dialogue: 0,00:10:57.61,00:10:58.94,JPN TOP,,0,0,0,,Ха! (жұт) А?
Dialogue: 0,0:10:59.70,0:11:01.68,Main,,0,0,0,,Не істеп жатырсың?!
Dialogue: 0,00:11:00.78,00:11:02.57,JPN TOP,,0,0,0,,Не... не істеп жатырсың?
Dialogue: 0,00:11:02.70,00:11:03.78,JPN TOP,,0,0,0,,Ха! (жұт) Эй!
Dialogue: 0,0:11:02.88,0:11:05.14,Main,,0,0,0,,Сіз сұмдықсыз! Бұзық! Төмен өмір!
Dialogue: 0,00:11:03.91,00:11:06.04,JPN TOP,,0,0,0,,Қорқынышты бұзық!
Dialogue: 0,0:11:05.51,0:11:08.48,Main,,0,0,0,,Не істеп жатырсың, әлгі ағашқа қаптағандай жабысып?
Dialogue: 0,00:11:06.16,00:11:09.29,JPN TOP,,0,0,0,,Не, сен жәндік сияқты ағашқа жабысып қалдың ба?
Dialogue: 0,0:11:08.48,0:11:10.89,Main,,0,0,0,,Маған сенің жүзің бәрібір.
Dialogue: 0,00:11:09.41,00:11:11.79,JPN TOP,,0,0,0,,Маған сенің жүзің бәрібір
Dialogue: 0,0:11:11.05,0:11:13.05,Main,,0,0,0,,Маған бәрібір!
Dialogue: 0,00:11:11.92,00:11:13.88,JPN TOP,,0,0,0,,Маған бәрібір!
Dialogue: 0,0:11:13.05,0:11:15.12,Main,,0,0,0,,Мен оны адамдардың көргенін қаламаймын!
Dialogue: 0,00:11:14.00,00:11:17.05,JPN TOP,,0,0,0,,Менің көрінгім келмейді! саған
Dialogue: 0,0:11:15.12,0:11:16.15,Main,,0,0,0,,Әсіресе сіз.
Dialogue: 0,0:11:16.15,0:11:19.28,Main,,0,0,0,,Осы уақыт бойы бетіңізді көрсетіп жүрдіңіз.
Dialogue: 0,00:11:17.17,00:11:21.01,JPN TOP,,0,0,0,,Бет Мен оны осы уақыт бойы көрсетіп келемін, неге?
Dialogue: 0,0:11:19.28,0:11:20.19,Main,,0,0,0,,Тағы бір қосымша сабақ па, қазірден-ақ?
Dialogue: 0,0:11:20.19,0:11:22.01,Main,,0,0,0,,Бір секундқа тыныш болыңыз.
Dialogue: 0,00:11:21.13,00:11:22.80,JPN TOP,,0,0,0,,Жоқ, аузыңды жап.
Dialogue: 0,0:11:22.01,0:11:22.99,Main,,0,0,0,,Жер
Dialogue: 0,00:11:22.93,00:11:26.85,JPN TOP,,0,0,0,,Не? Бұл менің алдымда жүзіңді көрсетпейсің дегенді білдіре ме?
Dialogue: 0,0:11:22.99,0:11:26.16,Main,,0,0,0,,Маған бетіңізді көрсетпеймін дейсіз бе?
Dialogue: 0,0:11:26.16,0:11:27.91,Main,,0,0,0,,Жоқ, бұл шынымен емес...
Dialogue: 0,00:11:26.97,00:11:28.81,JPN TOP,,0,0,0,,Жоқ, олай емес...
Dialogue: 0,0:11:27.91,0:11:29.46,Main,,0,0,0,,Жақсы.
Dialogue: 0,00:11:28.93,00:11:33.73,JPN TOP,,0,0,0,,Жарайды, маска сізді қате ойнаудан сақтайды, солай ма?
Dialogue: 0,0:11:29.46,0:11:32.91,Main,,0,0,0,,Маскаңыз болса, өзіңізді қателік сияқты көрсетуді доғарасыз, солай ма?
Dialogue: 0,0:11:32.91,0:11:33.98,Main,,0,0,0,,Мен барып аламын.
Dialogue: 0,00:11:33.85,00:11:36.40,JPN TOP,,0,0,0,,Мен барып аламын, оны қайда тастағаныңды айт.
Dialogue: 0,0:11:33.98,0:11:35.49,Main,,0,0,0,,Оны қайда лақтырғаныңызды айтыңыз.
Dialogue: 0,0:11:35.49,0:11:38.66,Main,,0,0,0,,Ой, есімде жоқ.
Dialogue: 0,00:11:36.52,00:11:39.40,JPN TOP,,0,0,0,,Енді... ол қайда болды?
Dialogue: 0,0:11:38.66,0:11:39.47,Main,,0,0,0,,Гугу.
Dialogue: 0,0:11:39.47,0:11:40.88,Main,,0,0,0,,Не-не?
Dialogue: 0,00:11:39.53,00:11:40.36,JPN TOP,,0,0,0,,Гу Гу
Dialogue: 0,00:11:40.49,00:11:41.78,JPN TOP,,0,0,0,,Не... не?
Dialogue: 0,00:11:45.62,00:11:47.12,JPN TOP,,0,0,0,,Иә? ау
Dialogue: 0,0:11:46.38,0:11:50.48,Main,,0,0,0,,Гугу, Реанмен сөйлескен сайын кеудең ауырады.
Dialogue: 0,00:11:47.24,00:11:51.37,JPN TOP,,0,0,0,,Мен Гу Гу Линмен сөйлескенде, мен әрқашан кеудемде ауырсынуды сезінемін.
Dialogue: 0,00:11:51.50,00:11:52.37,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:11:51.60,0:11:53.99,Main,,0,0,0,,Егер сізде маска болса, ол тоқтай ма?
Dialogue: 0,00:11:52.50,00:11:54.88,JPN TOP,,0,0,0,,Маска сізді емдей алады ма?
Dialogue: 0,0:11:53.99,0:11:56.02,Main,,0,0,0,,Wh-Wh-Сіздің мәселеңіз қандай?!
Dialogue: 0,00:11:55.00,00:11:56.88,JPN TOP,,0,0,0,,Нанана... Бұл не?
Dialogue: 0,0:11:56.02,0:11:57.99,Main,,0,0,0,,Та-да!
Dialogue: 0,00:11:57.00,00:11:58.88,JPN TOP,,0,0,0,,Сіз не айтып тұрсыз?
Dialogue: 0,0:11:59.74,0:12:02.29,Main,,0,0,0,,Мен оны тауып алайын!
Dialogue: 0,00:12:00.76,00:12:02.17,JPN TOP,,0,0,0,,Мен сені іздеймін!
Dialogue: 0,0:12:01.20,0:12:04.11,Main,,0,0,0,,H-Эй! Мені осында қалдырмаңыз!
Dialogue: 0,00:12:02.30,00:12:05.01,JPN TOP,,0,0,0,,О... Әй! Мені қалдырма!
Dialogue: 0,0:12:04.33,0:12:05.85,Main,,0,0,0,,Қандай қызық адам.
Dialogue: 0,00:12:05.14,00:12:09.27,JPN TOP,,0,0,0,,Біртүрлі адам екен, хаха, бірақ мейірімді.
Dialogue: 0,0:12:06.96,0:12:08.36,Main,,0,0,0,,Бірақ ол мейірімді.
Dialogue: 0,0:12:13.36,0:12:17.49,Main,,0,0,0,,Эй, менің жарамды көргің келе ме?
Dialogue: 0,00:12:14.40,00:12:18.40,JPN TOP,,0,0,0,,Эй, мен саған тыртықтарымды көрсете аламын ба?
Dialogue: 0,0:12:18.51,0:12:19.41,Main,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,00:12:18.52,00:12:20.23,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:12:19.41,0:12:21.63,Main,,0,0,0,,Бұл өте ауыр жара.
Dialogue: 0,00:12:20.36,00:12:22.53,JPN TOP,,0,0,0,,Менің тыртықтарым қорқынышты.
Dialogue: 0,0:12:21.84,0:12:27.60,Main,,0,0,0,,Бұл сіздікі соншалықты жаман емес екенін түсінуге мүмкіндік береді.
Dialogue: 0,00:12:22.65,00:12:26.78,JPN TOP,,0,0,0,,Мүмкін сіздің тыртықтарыңыз жасыруға жарамсыз шығар?
Dialogue: 0,00:12:26.91,00:12:28.49,JPN TOP,,0,0,0,,Сіз солай ойлауыңыз мүмкін.
Dialogue: 0,0:12:27.60,0:12:29.14,Main,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,00:12:28.62,00:12:30.20,JPN TOP,,0,0,0,,Рух толқыны ма?
Dialogue: 0,0:12:35.19,0:12:36.21,Main,,0,0,0,,Ф-Фатирлеу ештеңе әкелмейді.
Dialogue: 0,00:12:36.21,00:12:38.84,JPN TOP,,0,0,0,,Әй, бұл қорқынышты емес пе?
Dialogue: 0,0:12:36.69,0:12:37.95,Main,,0,0,0,,Жаман емес пе?
Dialogue: 0,0:12:39.33,0:12:40.94,Main,,0,0,0,,Бұл ештеңе емес!
Dialogue: 0,00:12:40.34,00:12:41.84,JPN TOP,,0,0,0,,Мүлде жоқ!
Dialogue: 0,0:12:40.94,0:12:42.06,Main,,0,0,0,,Ештеңе емес пе?!
Dialogue: 0,00:12:41.96,00:12:42.97,JPN TOP,,0,0,0,,Барлығы...
Dialogue: 0,0:12:42.06,0:12:43.73,Main,,0,0,0,,Бұл сұмдық!
Dialogue: 0,00:12:43.09,00:12:46.26,JPN TOP,,0,0,0,,Сәлем... Бұл қорқынышты! Мен шынымен уайымдадым
Dialogue: 0,0:12:43.73,0:12:45.43,Main,,0,0,0,,Бұл маған қатты ауыр тиді!
Dialogue: 0,0:12:45.43,0:12:48.49,Main,,0,0,0,,Менікімен салыстырғанда бұл бір доп!
Dialogue: 0,00:12:46.39,00:12:49.39,JPN TOP,,0,0,0,,Менің жарақаттарыммен салыстырғанда, сіз бугерге ұқсайсыз.
Dialogue: 0,0:12:48.49,0:12:51.99,Main,,0,0,0,,О, шынымен бе? Сендікін көрейік, онда!
Dialogue: 0,00:12:49.51,00:12:52.89,JPN TOP,,0,0,0,,Не! Сосын маған да өзіңдікін көрсет.
Dialogue: 0,00:12:49.51,00:12:52.89,JPN TOP,,0,0,0,,Жоқ... жоқ, жоқ!
Dialogue: 0,0:12:52.26,0:12:56.83,Main,,0,0,0,,Тыңдаңыз, сіздің жараңыз толығымен дерлік жазылды!
Dialogue: 0,00:12:53.02,00:12:54.39,JPN TOP,,0,0,0,,Мен көремін.
Dialogue: 0,00:12:54.52,00:12:57.81,JPN TOP,,0,0,0,,Бұл жара дерлік жазылды, солай ма?
Dialogue: 0,0:12:56.83,0:12:59.13,Main,,0,0,0,,Осыны уайымдап жүргенің ақымақсың!
Dialogue: 0,00:12:57.94,00:13:00.02,JPN TOP,,0,0,0,,Мұндай нәрсеге алаңдау - ақымақтық.
Dialogue: 0,0:12:59.13,0:13:00.49,Main,,0,0,0,,Ақымақ!
Dialogue: 0,00:13:00.15,00:13:03.24,JPN TOP,,0,0,0,,Сен ақымақсың, ақымақсың! Асыра сілтеудің де шегі бар
Dialogue: 0,0:13:00.49,0:13:02.33,Main,,0,0,0,,Сіз соншалықты драмалық бола алмайсыз!
Dialogue: 0,0:13:03.02,0:13:04.84,Main,,0,0,0,,Сіз қалай...
Dialogue: 0,00:13:04.15,00:13:05.74,JPN TOP,,0,0,0,,Не...
Dialogue: 0,0:13:07.23,0:13:10.21,Main,,0,0,0,,Сіз анам мен әкемнің айтқанын айтасыз.
Dialogue: 0,00:13:07.24,00:13:08.20,JPN TOP,,0,0,0,,Иә
Dialogue: 0,00:13:08.32,00:13:11.12,JPN TOP,,0,0,0,,Сіз ана мен әкенің сөзін айтасыз.
Dialogue: 0,00:13:11.24,00:13:15.25,JPN TOP,,0,0,0,,Ах... Кешіріңіз, мм...
Dialogue: 0,0:13:11.40,0:13:14.31,Main,,0,0,0,,Кешіріңіз... Мм...
Dialogue: 0,0:13:14.31,0:13:17.23,Main,,0,0,0,,Күте тұрыңыз, ата-анаңыздың жағдайы жақсы емес пе?
Dialogue: 0,00:13:15.37,00:13:18.13,JPN TOP,,0,0,0,,Не? Сіз ата-анаңызбен жақсы араласпайсыз ба?
Dialogue: 0,0:13:17.23,0:13:19.69,Main,,0,0,0,,Мен үшін алаңдама.
Dialogue: 0,00:13:18.25,00:13:20.63,JPN TOP,,0,0,0,,Мен үшін алаңдама.
Dialogue: 0,0:13:19.69,0:13:21.35,Main,,0,0,0,,Мен жай ғана драмалық болып жатырмын.
Dialogue: 0,00:13:20.75,00:13:22.25,JPN TOP,,0,0,0,,Бұл бәрібір асыра сілтеу.
Dialogue: 0,0:13:21.35,0:13:23.29,Main,,0,0,0,,Бірақ... Менің айтайын дегенім...
Dialogue: 0,00:13:22.38,00:13:26.80,JPN TOP,,0,0,0,,Жоқ, бірақ... Хахаха, жылама
Dialogue: 0,0:13:24.16,0:13:25.73,Main,,0,0,0,,Жылама.
Dialogue: 0,0:13:26.39,0:13:28.98,Main,,0,0,0,,Қайтып кел, Фуши.
Dialogue: 0,00:13:27.47,00:13:29.89,JPN TOP,,0,0,0,,Фуши, тезірек оралыңыз.
Dialogue: 0,0:13:29.19,0:13:33.91,Main,,0,0,0,,Ол адамдар мені үй жануарым деп ойлайды.
Dialogue: 0,00:13:30.01,00:13:34.81,JPN TOP,,0,0,0,,Ол адамдар мені үй жануарым деп ойлайды.
Dialogue: 0,0:13:33.91,0:13:36.13,Main,,0,0,0,,Олар менің бәрін айтқанымдай істегенімді қалайды.
Dialogue: 0,00:13:34.93,00:13:37.02,JPN TOP,,0,0,0,,Мен бәрі өз жолыммен болғанын қалаймын
Dialogue: 0,0:13:36.58,0:13:38.31,Main,,0,0,0,,Олар қорқынышты.
Dialogue: 0,00:13:37.65,00:13:41.90,JPN TOP,,0,0,0,,Бұл өте қорқынышты, тіпті мен күлгін түсті ұнатамын.
Dialogue: 0,0:13:38.31,0:13:44.68,Main,,0,0,0,,Маған күлгін түсті ұнайды, бірақ олар маған жасыл түсті заттарды сатып алады, себебі бұл отбасылық түс.
Dialogue: 0,00:13:42.02,00:13:45.61,JPN TOP,,0,0,0,,Мен әрқашан жасыл түсті заттарды үйімнің түсі болғандықтан сатып аламын.
Dialogue: 0,0:13:44.68,0:13:47.18,Main,,0,0,0,,Иә? Маған жасыл түсті ұнайды.
Dialogue: 0,00:13:45.74,00:13:47.99,JPN TOP,,0,0,0,,үшін? Жарайды, жасыл
Dialogue: 0,0:13:47.18,0:13:48.77,Main,,0,0,0,,Бұл бәрі емес.
Dialogue: 0,00:13:48.11,00:13:49.66,JPN TOP,,0,0,0,,Бұл бәрі емес.
Dialogue: 0,0:13:49.12,0:13:53.08,Main,,0,0,0,,Анам мұғалім жалдаған кезде мен сурет салып жүрдім.
Dialogue: 0,00:13:49.78,00:13:53.99,JPN TOP,,0,0,0,,Мен сурет салып жүргенімде, анам мұғалімді жалдады.
Dialogue: 0,0:13:53.08,0:13:57.77,Main,,0,0,0,,Маған бұл ұнамады, сондықтан мен тоқуды бастадым, содан кейін анам тоқу мұғалімін жалдады.
Dialogue: 0,00:13:54.12,00:13:58.67,JPN TOP,,0,0,0,,Маған бұл ұнамады, сондықтан мен тігіншілікті бастадым, бұл жолы тігін мұғалімін жалдадым.
Dialogue: 0,0:13:58.24,0:14:00.58,Main,,0,0,0,,Мен жай ғана еркін болғым келеді.
Dialogue: 0,00:13:59.38,00:14:01.67,JPN TOP,,0,0,0,,Мен мұны еркін орындағым келеді...
Dialogue: 0,0:14:01.01,0:14:05.27,Main,,0,0,0,,Бірақ менің айналамда үнемі үлкендер болды.
Dialogue: 0,00:14:01.79,00:14:06.17,JPN TOP,,0,0,0,,Иә, айналамда әрқашан үлкендер болатын.
Dialogue: 0,0:14:05.97,0:14:09.67,Main,,0,0,0,,Мен түшкірсем де, маған біреу келеді.
Dialogue: 0,00:14:07.09,00:14:10.76,JPN TOP,,0,0,0,,Мен түшкірсем, маған үнемі біреу келеді.
Dialogue: 0,0:14:10.79,0:14:14.40,Main,,0,0,0,,Мен аш емеспін десем де, мені тамақтандыратын.
Dialogue: 0,00:14:11.80,00:14:15.31,JPN TOP,,0,0,0,,Мен қаламаймын десем де күріш жеуге мәжбүрлейді.
Dialogue: 0,0:14:14.74,0:14:17.37,Main,,0,0,0,,Олар шашымды күніне төрт рет тарайтын.
Dialogue: 0,00:14:15.85,00:14:18.27,JPN TOP,,0,0,0,,Менің шашымды күніне төрт рет тарайды.
Dialogue: 0,0:14:17.70,0:14:22.50,Main,,0,0,0,,Ал мен ауырып далаға шықсам да менімен бірге қызметші келетін.
Dialogue: 0,00:14:18.81,00:14:20.90,JPN TOP,,0,0,0,,Маған ондай үй ұнамайды, сондықтан сыртқа шықсам да
Dialogue: 0,00:14:21.02,00:14:23.23,JPN TOP,,0,0,0,,Қызметші әрқашан соңынан ереді.
Dialogue: 0,0:14:22.50,0:14:25.87,Main,,0,0,0,,Өмірімде өзіме-өзім уақыт таппадым.
Dialogue: 0,00:14:23.36,00:14:26.99,JPN TOP,,0,0,0,,Менің өмірімде жалғыздық деген жоқ.
Dialogue: 0,0:14:27.90,0:14:31.60,Main,,0,0,0,,Олар мені жеке тұлға ретінде қабылдамаған сияқты.
Dialogue: 0,00:14:28.95,00:14:32.83,JPN TOP,,0,0,0,,Мені адам ретінде танымаған сияқты.
Dialogue: 0,0:14:31.89,0:14:33.98,Main,,0,0,0,,Мен сол үйде болғанша...
Dialogue: 0,00:14:32.95,00:14:34.95,JPN TOP,,0,0,0,,Мен ол үйде болғанша
Dialogue: 0,0:14:33.98,0:14:35.39,Main,,0,0,0,,Бұл өте ақымақ.
Dialogue: 0,00:14:35.08,00:14:38.21,JPN TOP,,0,0,0,,Күлкілі, олар жақсы ата-ана емес пе?
Dialogue: 0,0:14:35.39,0:14:37.04,Main,,0,0,0,,Олар жақсы ата-ана сияқты.
Dialogue: 0,0:14:37.96,0:14:39.92,Main,,0,0,0,,Сіз сұмдықсыз.
Dialogue: 0,00:14:39.04,00:14:40.79,JPN TOP,,0,0,0,,Бұл сен кінәлі.
Dialogue: 0,0:14:39.92,0:14:45.91,Main,,0,0,0,,Адамдардың мейірімін бақытсыздық санап, налығандай мақтанасың.
Dialogue: 0,00:14:40.92,00:14:44.09,JPN TOP,,0,0,0,,Біреудің жанашырлығын өз бақытсыздығыңның бірі деп санама.
Dialogue: 0,00:14:44.21,00:14:46.80,JPN TOP,,0,0,0,,Мақтанышпен шағымданады
Dialogue: 0,0:14:45.91,0:14:47.74,Main,,0,0,0,,Маған солай көрінеді.
Dialogue: 0,00:14:46.92,00:14:48.63,JPN TOP,,0,0,0,,Маған солай көрінеді.
Dialogue: 0,0:14:47.93,0:14:49.79,Main,,0,0,0,,Сіз дұрыс емес ойға келдіңіз!
Dialogue: 0,00:14:48.76,00:14:50.59,JPN TOP,,0,0,0,,Мені қате түсінбеңіз!
Dialogue: 0,0:14:49.79,0:14:53.82,Main,,0,0,0,,Мен де сіздің құндылықтарыңызбен бөлісе аламын деп ойламадым.
Dialogue: 0,00:14:50.72,00:14:54.68,JPN TOP,,0,0,0,,Мен де сіздің құндылықтарыңызды бөлісе алмаймын деп ойлаймын.
Dialogue: 0,0:14:53.82,0:14:57.75,Main,,0,0,0,,Егер мен сол отбасында туылмасам, бұл жараны ешқашан алмас едім.
Dialogue: 0,00:14:54.81,00:14:58.64,JPN TOP,,0,0,0,,Мен ол үйде туылмасам, бұл тыртықты алмас едім.
Dialogue: 0,0:14:57.75,0:14:58.77,Main,,0,0,0,,Жер
Dialogue: 0,00:14:58.77,00:14:59.89,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:15:00.89,0:15:03.38,Main,,0,0,0,,Артымнан біреу итеріп жіберді.
Dialogue: 0,00:15:01.94,00:15:04.27,JPN TOP,,0,0,0,,Артымнан біреу итеріп жіберді.
Dialogue: 0,0:15:03.38,0:15:08.17,Main,,0,0,0,,Адамдар бұл әкемді жек көретін адам болуы керек дейді.
Dialogue: 0,00:15:04.40,00:15:09.03,JPN TOP,,0,0,0,,Айналадағылар бұл әкеме ренжіген адамның ісі болса керек дейді.
Dialogue: 0,0:15:08.17,0:15:12.02,Main,,0,0,0,,Мен үшін ешкім алаңдамайды.
Dialogue: 0,00:15:09.15,00:15:13.16,JPN TOP,,0,0,0,,Сонда да сен мен үшін мүлдем алаңдамайсың.
Dialogue: 0,0:15:15.88,0:15:17.15,Main,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,00:15:16.66,00:15:18.04,JPN TOP,,0,0,0,,Жоқ.
Dialogue: 0,00:15:18.16,00:15:19.46,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:15:18.55,0:15:20.60,Main,,0,0,0,,Сіз менің қателескенімді айттыңыз ба?
Dialogue: 0,00:15:19.58,00:15:21.42,JPN TOP,,0,0,0,,Сіз жай ғана «жоқ» дедіңіз бе?
Dialogue: 0,0:15:20.60,0:15:21.48,Main,,0,0,0,,Ақыры заман мені қуып жетті ме?
Dialogue: 0,0:15:21.48,0:15:23.53,Main,,0,0,0,,Мен сен ақымақсың дедім.
Dialogue: 0,00:15:21.54,00:15:24.59,JPN TOP,,0,0,0,,Жоқ... Мен сені ақымақ дедім.
Dialogue: 0,0:15:24.61,0:15:25.80,Main,,0,0,0,,Бір сәт те жоғалтуға болмайды.
Dialogue: 0,00:15:25.67,00:15:29.09,JPN TOP,,0,0,0,,Сәлем! Бүгін ғана сені ақымақ деп қанша рет айттым?
Dialogue: 0,0:15:25.80,0:15:28.19,Main,,0,0,0,,Сіз мені бір күнде неше рет ақымақ деп айта аласыз?
Dialogue: 0,00:15:29.21,00:15:30.09,JPN TOP,,0,0,0,,Ha
Dialogue: 0,00:15:37.22,00:15:42.10,JPN TOP,,0,0,0,,(Гу-Гу жылайды)
Dialogue: 0,00:15:46.73,00:15:48.07,JPN TOP,,0,0,0,,Кю
Dialogue: 0,0:15:47.15,0:15:48.76,Main,,0,0,0,,Эй, Меер...
Dialogue: 0,00:15:48.19,00:15:51.86,JPN TOP,,0,0,0,,Эй Мир, мен қорқынышты нәрсе айттым ба?
Dialogue: 0,0:15:48.76,0:15:50.96,Main,,0,0,0,,Менің айтқаным соншалықты қорқынышты болды ма?
Dialogue: 0,0:15:51.41,0:15:52.90,Main,,0,0,0,,Олай емес!
Dialogue: 0,00:15:52.53,00:15:54.11,JPN TOP,,0,0,0,,«Айтпаған адам»
Dialogue: 0,0:15:54.38,0:15:57.23,Main,,0,0,0,,Әй, бетіңді қалай жараладың?
Dialogue: 0,00:15:55.41,00:15:58.12,JPN TOP,,0,0,0,,Әй, сен неге бетіңді жараладың?
Dialogue: 0,0:15:57.82,0:15:59.12,Main,,0,0,0,,Мен айтпаймын.
Dialogue: 0,00:15:58.87,00:16:01.87,JPN TOP,,0,0,0,,Айтпа, өйткені айтсаң сені жек көреді
Dialogue: 0,0:15:59.12,0:16:00.96,Main,,0,0,0,,Мен жек көрсем, мені жек көресің.
Dialogue: 0,0:16:01.85,0:16:03.47,Main,,0,0,0,,Мұнымен нені айтасыз?
Dialogue: 0,00:16:02.92,00:16:04.38,JPN TOP,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:16:06.48,0:16:08.62,Main,,0,0,0,,Мен саған ұнайсың ба?
Dialogue: 0,00:16:07.50,00:16:09.51,JPN TOP,,0,0,0,,Мен саған ұнайсың ба?
Dialogue: 0,0:16:10.47,0:16:11.82,Main,,0,0,0,,Мен айтпаймын.
Dialogue: 0,00:16:11.51,00:16:14.47,JPN TOP,,0,0,0,,Айтпа, өйткені айтсаң жек көретін боласың.
Dialogue: 0,0:16:11.82,0:16:13.57,Main,,0,0,0,,Мен жек көрсем, мені жек көресің.
Dialogue: 0,0:16:13.81,0:16:16.19,Main,,0,0,0,,Сіз маған ештеңе айтпайсыз, иә?
Dialogue: 0,00:16:14.59,00:16:17.10,JPN TOP,,0,0,0,,Сен маған ештеңе айтпайсың.
Dialogue: 0,0:16:18.18,0:16:20.17,Main,,0,0,0,,Мен ақымақпын.
Dialogue: 0,00:16:19.22,00:16:21.14,JPN TOP,,0,0,0,,Мен құбыжықпын
Dialogue: 0,0:16:20.53,0:16:22.50,Main,,0,0,0,,Бұл сізге білу керек.
Dialogue: 0,00:16:21.68,00:16:23.60,JPN TOP,,0,0,0,,Бұл жеткілікті
Dialogue: 0,00:16:24.73,00:16:26.36,JPN TOP,,0,0,0,,Хмм…
Dialogue: 0,00:16:28.94,00:16:31.57,JPN TOP,,0,0,0,,Хмм...
Dialogue: 0,0:16:29.20,0:16:30.59,Main,,0,0,0,,Олар дәл қашан осы үйдің бір бөлігіне айналды?
Dialogue: 0,0:16:30.59,0:16:32.07,Main,,0,0,0,,Ол дәрігер кабинетінде қалып қойғаны дұрыс.
Dialogue: 0,00:16:31.69,00:16:33.90,JPN TOP,,0,0,0,,А, бұл! бұл маска
Dialogue: 0,0:16:32.07,0:16:33.06,Main,,0,0,0,,Маска!
Dialogue: 0,0:16:33.06,0:16:36.47,Main,,0,0,0,,Мен мұны саған сыйлық ретінде әкелдім.
Dialogue: 0,00:16:34.03,00:16:37.37,JPN TOP,,0,0,0,,Бұл мен саған сыйлық ретінде әкелген нәрсем еді.
Dialogue: 0,0:16:36.66,0:16:40.79,Main,,0,0,0,,Қарт бұл дәстүрлі тайпадан дейді.
Dialogue: 0,00:16:37.49,00:16:41.70,JPN TOP,,0,0,0,,Атам аңызға айналған тайпаға жатады дейді.
Dialogue: 0,0:16:40.79,0:16:42.31,Main,,0,0,0,,Бұл таңқаларлық емес пе?
Dialogue: 0,00:16:41.83,00:16:44.87,JPN TOP,,0,0,0,,Бұл таңқаларлық. Қаласаңыз, пайдаланыңыз.
Dialogue: 0,0:16:42.31,0:16:43.77,Main,,0,0,0,,Қаласаңыз, оны пайдалана аласыз.
Dialogue: 0,0:16:47.58,0:16:50.34,Main,,0,0,0,,Маған бұл керек емес!
Dialogue: 0,00:16:48.63,00:16:51.51,JPN TOP,,0,0,0,,Мен... Маған бұл керек емес.
Dialogue: 0,0:16:51.89,0:16:53.87,Main,,0,0,0,,Сен өте ақымақсың.
Dialogue: 0,00:16:53.01,00:16:54.76,JPN TOP,,0,0,0,,Сен ақымақ сияқтысың
Dialogue: 0,00:16:56.80,00:16:58.01,JPN TOP,,0,0,0,,Эххе
Dialogue: 0,0:16:59.58,0:17:04.00,Main,,0,0,0,,Маған бәрібір сен құбыжықсың ба, адамсың ба.
Dialogue: 0,00:17:00.35,00:17:04.94,JPN TOP,,0,0,0,,Маған сенің құбыжықсың ба, адамсың ба бәрібір.
Dialogue: 0,0:17:04.00,0:17:06.63,Main,,0,0,0,,Сіз әлі де солайсыз, солай емес пе?
Dialogue: 0,00:17:05.06,00:17:07.69,JPN TOP,,0,0,0,,Бірақ екеуі де сен емес пе?
Dialogue: 0,0:17:08.45,0:17:10.69,Main,,0,0,0,,Маған сенің біртүрлі екеніңді ұнатамын,
Dialogue: 0,00:17:09.48,00:17:13.86,JPN TOP,,0,0,0,,Мен бәрін әшкерелеймін, сен де, Жасырмасқа амалым жоқ, сен де
Dialogue: 0,0:17:10.69,0:17:14.96,Main,,0,0,0,,ішегіңді төгіп жатырсың ба, әлде бәрін жасырмай тұра алмайсың.
Dialogue: 0,00:17:13.99,00:17:15.86,JPN TOP,,0,0,0,,Екеуі де біртүрлі, маған ұнайды.
Dialogue: 0,0:17:15.23,0:17:16.97,Main,,0,0,0,,Бұл сенсің.
Dialogue: 0,00:17:15.99,00:17:19.24,JPN TOP,,0,0,0,,Бұл сенсің, сен сенсің
Dialogue: 0,0:17:16.97,0:17:18.33,Main,,0,0,0,,Сіз өзіңізсіз.
Dialogue: 0,0:17:18.79,0:17:20.78,Main,,0,0,0,,шығыңыз.
Dialogue: 0,00:17:19.83,00:17:21.62,JPN TOP,,0,0,0,,Эй, шықшы.
Dialogue: 0,0:17:20.78,0:17:23.75,Main,,0,0,0,,Сен маған өмір бойы қараудан қашпайсың, солай ма?
Dialogue: 0,00:17:21.74,00:17:24.87,JPN TOP,,0,0,0,,Сіз шынымен менімен өмір бойы көз тигізбеуді жоспарлап жүрсіз бе?
Dialogue: 0,0:17:25.03,0:17:28.35,Main,,0,0,0,,Мен сенімен жақынырақ танысқым келеді.
Dialogue: 0,00:17:26.12,00:17:29.71,JPN TOP,,0,0,0,,Мен сені жақсы білгім келеді.
Dialogue: 0,0:17:28.74,0:17:31.98,Main,,0,0,0,,Бетіңді жасыру керек болса да.
Dialogue: 0,00:17:29.84,00:17:32.88,JPN TOP,,0,0,0,,Бетперде кию керек болса да.
Dialogue: 0,0:17:34.84,0:17:37.99,Main,,0,0,0,,Әй, жел жақсы.
Dialogue: 0,00:17:35.51,00:17:38.89,JPN TOP,,0,0,0,,Ей, жел жақсы сезінеді.
Dialogue: 0,00:17:40.14,00:17:41.26,JPN TOP,,0,0,0,,Хехе
Dialogue: 0,0:17:43.08,0:17:44.93,Main,,0,0,0,,Фуши-сан уақытын алып жатыр, иә?
Dialogue: 0,00:17:44.22,00:17:47.69,JPN TOP,,0,0,0,,Фуши мырза, сіз кешігіп қалдыңыз. Күткіңіз келе ме? іздеу?
Dialogue: 0,0:17:44.93,0:17:46.76,Main,,0,0,0,,Күту керек пе? Әлде оны іздеуіміз керек пе?
Dialogue: 0,0:17:47.14,0:17:48.04,Main,,0,0,0,,Вент одан әрі ашылмауына қол жеткіздік.
Dialogue: 0,00:17:48.23,00:17:49.27,JPN TOP,,0,0,0,,Кеттік
Dialogue: 0,0:17:49.23,0:17:52.28,Main,,0,0,0,,Бұрын айтқан қорқынышты сөздерім үшін кешіріңіз.
Dialogue: 0,00:17:50.31,00:17:53.15,JPN TOP,,0,0,0,,Ертерек сұмдық айтқаным үшін кешіріңіз.
Dialogue: 0,0:17:52.28,0:17:53.47,Main,,0,0,0,,Бұл тағы не болды?
Dialogue: 0,00:17:53.28,00:17:54.61,JPN TOP,,0,0,0,,Солай ма! Онда саған ұнайды екен!
Dialogue: 0,00:18:01.99,00:18:05.87,JPN TOP,,0,0,0,,（）
Dialogue: 0,0:18:05.84,0:18:06.85,Main,,0,0,0,,Таптым!
Dialogue: 0,00:18:06.91,00:18:08.12,JPN TOP,,0,0,0,,Атта!
Dialogue: 0,0:18:12.09,0:18:14.81,Main,,0,0,0,,Сізге адам болып ойнау ұнайды ма?
Dialogue: 0,00:18:13.17,00:18:15.88,JPN TOP,,0,0,0,,Адам ойнау қызық па?
Dialogue: 0,00:18:24.56,00:18:25.35,JPN TOP,,0,0,0,,Хмм.
Dialogue: 0,0:18:27.57,0:18:30.39,Main,,0,0,0,,Жау әрқашан мүмкіндік іздейді.
Dialogue: 0,00:18:28.39,00:18:31.27,JPN TOP,,0,0,0,,Жау әрқашан мүмкіндік іздейді.
Dialogue: 0,00:18:32.40,00:18:33.19,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:18:32.72,0:18:34.28,Main,,0,0,0,,Сақ болыңыз.
Dialogue: 0,00:18:33.82,00:18:35.40,JPN TOP,,0,0,0,,Абайлаңыз
Dialogue: 0,0:18:35.72,0:18:38.41,Main,,0,0,0,,Мен маскамды осылай лақтырып жібердім.
Dialogue: 0,00:18:36.86,00:18:39.28,JPN TOP,,0,0,0,,Осы кезде мен маскамды лақтырып жібердім.
Dialogue: 0,0:18:38.41,0:18:40.68,Main,,0,0,0,,Сонымен Фуши де осында болуы керек.
Dialogue: 0,00:18:39.40,00:18:41.57,JPN TOP,,0,0,0,,Сонымен Фуши де сол жерде болуы керек.
Dialogue: 0,0:18:40.84,0:18:42.73,Main,,0,0,0,,Бір-бірімізді сағынып қалмаймыз ба?
Dialogue: 0,00:18:41.70,00:18:43.66,JPN TOP,,0,0,0,,Сіз шатасып кетпейсіз бе?
Dialogue: 0,0:18:42.73,0:18:44.09,Main,,0,0,0,,Не бұл, Хиёри? Жаңа жылдық әзіл ме?
Dialogue: 0,00:18:43.78,00:18:47.41,JPN TOP,,0,0,0,,Жарайды, ол бізді табады.
Dialogue: 0,0:18:44.09,0:18:46.52,Main,,0,0,0,,Ол бізді табады.
Dialogue: 0,0:18:46.52,0:18:48.05,Main,,0,0,0,,Сіз қайдан білесіз?
Dialogue: 0,00:18:47.54,00:18:48.91,JPN TOP,,0,0,0,,Сіз қайдан білесіз?
Dialogue: 0,0:18:48.05,0:18:50.66,Main,,0,0,0,,Жақсы, өйткені ол, әрине.
Dialogue: 0,00:18:49.04,00:18:51.58,JPN TOP,,0,0,0,,Жарайды, себебі ол сол жігіт.
Dialogue: 0,0:18:50.66,0:18:52.59,Main,,0,0,0,,Не айт? Бұл мағынасыз.
Dialogue: 0,00:18:51.71,00:18:54.13,JPN TOP,,0,0,0,,Бұл не? Мен түсінбеймін...
Dialogue: 0,0:18:54.19,0:18:55.57,Main,,0,0,0,,Реан-сама.
Dialogue: 0,00:18:54.25,00:18:55.09,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,00:18:55.21,00:18:57.84,JPN TOP,,0,0,0,,Лиан мырза, үйге қайтайық.
Dialogue: 0,0:18:55.57,0:18:57.09,Main,,0,0,0,,Қазір үйге қайтайық.
Dialogue: 0,0:18:57.09,0:18:58.76,Main,,0,0,0,,Жоқ! Мені жіберіңізші!
Dialogue: 0,00:18:57.97,00:18:59.34,JPN TOP,,0,0,0,,Жоқ, жіберіңізші!
Dialogue: 0,0:18:58.76,0:19:00.44,Main,,0,0,0,,Бұл жігіт кім?
Dialogue: 0,00:18:59.47,00:19:01.34,JPN TOP,,0,0,0,,Не... ол қандай адам?
Dialogue: 0,0:19:00.44,0:19:02.82,Main,,0,0,0,,Ол жалданған бұзақы!
Dialogue: 0,00:19:01.47,00:19:03.55,JPN TOP,,0,0,0,,Ақшаға жалданған қаскөй.
Dialogue: 0,0:19:02.82,0:19:06.09,Main,,0,0,0,,Мені ұстап алғаны үшін қанша ақша тауып жатқаны қызық!
Dialogue: 0,00:19:03.68,00:19:06.97,JPN TOP,,0,0,0,,Мені ұстағаныңыз үшін қанша ақша аласыз деп ойлаймын!
Dialogue: 0,0:19:06.33,0:19:08.20,Main,,0,0,0,,Ол Кроппстың қызы.
Dialogue: 0,00:19:07.52,00:19:09.18,JPN TOP,,0,0,0,,Клопптар отбасының қызы
Dialogue: 0,0:19:08.20,0:19:11.36,Main,,0,0,0,,Не, ол тағы да үйден қашып кетті ме?
Dialogue: 0,00:19:09.31,00:19:12.31,JPN TOP,,0,0,0,,Не, үйден тағы қашып кеттің бе?
Dialogue: 0,0:19:10.08,0:19:11.36,Main,,0,0,0,,Мені жіберіңізші!
Dialogue: 0,00:19:11.10,00:19:13.48,JPN TOP,,0,0,0,,Жібер, жібер!
Dialogue: 0,0:19:11.36,0:19:13.83,Main,,0,0,0,,Мені жіберіңізші!
Dialogue: 0,00:19:12.44,00:19:13.48,JPN TOP,,0,0,0,,Ha
Dialogue: 0,00:19:13.48,00:19:14.73,JPN TOP,,0,0,0,,Жібер, жібер!
Dialogue: 0,0:19:14.05,0:19:16.55,Main,,0,0,0,,(Тик-так, сағаттың көрсеткіштері тик-так)
Dialogue: 0,00:19:14.86,00:19:16.98,JPN TOP,,0,0,0,,Жоқ!
Dialogue: 0,00:19:18.03,00:19:19.19,JPN TOP,,0,0,0,,(Жедел жүзген қайықтың дыбысы)
Dialogue: 0,0:19:20.75,0:19:21.86,Main,,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,00:19:21.78,00:19:22.95,JPN TOP,,0,0,0,,Жүгіру!
Dialogue: 0,00:19:29.79,00:19:32.92,JPN TOP,,0,0,0,,(Гу Гу мен Линнің ауыр тыныс алуы)
Dialogue: 0,0:19:32.35,0:19:34.84,Main,,0,0,0,,Әй, сен үйден қашып бара жатырсың ба?
Dialogue: 0,00:19:33.04,00:19:35.17,JPN TOP,,0,0,0,,Әй, сен үйден қаштың ба?
Dialogue: 0,0:19:34.84,0:19:36.48,Main,,0,0,0,,Иә, дұрыс.
Dialogue: 0,00:19:35.88,00:19:37.42,JPN TOP,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:19:36.48,0:19:40.02,Main,,0,0,0,,Әкем кем дегенде жиырма адамды жұмысқа алды деп ойлаймын.
Dialogue: 0,00:19:37.55,00:19:40.97,JPN TOP,,0,0,0,,Менің әкем туралы болғандықтан, ол 20 адамды жұмыспен қамтамасыз етеді деп ойлаймын.
Dialogue: 0,0:19:40.42,0:19:45.25,Main,,0,0,0,,Олар мені табу үшін қаланы аралап жүр.
Dialogue: 0,00:19:41.51,00:19:46.05,JPN TOP,,0,0,0,,Олар мені табу үшін қаланы аралап жүр.
Dialogue: 0,0:19:45.25,0:19:46.66,Main,,0,0,0,,Неге үйден кеттің?
Dialogue: 0,00:19:46.18,00:19:49.35,JPN TOP,,0,0,0,,Үйден неге қашып кеттің? Маған бәрін айт
Dialogue: 0,0:19:46.90,0:19:48.54,Main,,0,0,0,,Маған бәрін айт.
Dialogue: 0,0:19:48.54,0:19:50.79,Main,,0,0,0,,Не? Мен саған айттым ғой.
Dialogue: 0,00:19:49.47,00:19:51.69,JPN TOP,,0,0,0,,Әй, мен саған бұрын айттым ғой.
Dialogue: 0,0:19:50.99,0:19:52.61,Main,,0,0,0,,Сіз маған бұрын не айттыңыз?
Dialogue: 0,00:19:51.81,00:19:54.44,JPN TOP,,0,0,0,,Бұрынғы оқиға туралы не деуге болады? Бұл не?
Dialogue: 0,0:19:52.61,0:19:53.55,Main,,0,0,0,,Солай ма?
Dialogue: 0,0:19:53.84,0:19:55.88,Main,,0,0,0,,Не? Бұл біртүрлі ме?
Dialogue: 0,00:19:54.56,00:19:56.77,JPN TOP,,0,0,0,,Не, бұл біртүрлі ме?
Dialogue: 0,0:19:55.88,0:19:57.07,Main,,0,0,0,,9-эпизод
Dialogue: 0,00:19:56.90,00:19:58.03,JPN TOP,,0,0,0,,Жоқ…
Dialogue: 0,0:19:58.04,0:20:01.25,Main,,0,0,0,,Бұл маска сізді таппауы үшін болды ма?
Dialogue: 0,00:19:59.07,00:20:02.15,JPN TOP,,0,0,0,,Мүмкін бұл маска табылмас үшін шығар?
Dialogue: 0,0:20:02.58,0:20:04.17,Main,,0,0,0,,Өте талғампаз болма.
Dialogue: 0,00:20:03.61,00:20:04.99,JPN TOP,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:20:04.17,0:20:07.45,Main,,0,0,0,,Екеуіңді тапқанша үйге сүйреп апарғым келмеді.
Dialogue: 0,00:20:05.12,00:20:08.49,JPN TOP,,0,0,0,,Мен сендерді таппай тұрып, мені қайтарып алғым келмейді.
Dialogue: 0,0:20:08.30,0:20:11.27,Main,,0,0,0,,Кешіріңіз, мен оны сыйлық деп өтірік айттым.
Dialogue: 0,00:20:09.04,00:20:12.16,JPN TOP,,0,0,0,,Кешіріңіз, мен сыйлық туралы өтірік айттым.
Dialogue: 0,0:20:12.36,0:20:13.72,Main,,0,0,0,,Көңіліңіз қалды ма?
Dialogue: 0,00:20:13.50,00:20:14.83,JPN TOP,,0,0,0,,Көңіліңіз қалды ма?
Dialogue: 0,00:20:16.04,00:20:17.00,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:20:20.11,0:20:21.27,Main,,0,0,0,,Оны қайтарыңыз.
Dialogue: 0,00:20:21.13,00:20:22.17,JPN TOP,,0,0,0,,Мен оны қайтарамын
Dialogue: 0,0:20:24.23,0:20:26.92,Main,,0,0,0,,Маған маска бергеніңіз үшін рахмет.
Dialogue: 0,00:20:25.39,00:20:28.22,JPN TOP,,0,0,0,,Маған масканы бергеніңіз үшін рахмет.
Dialogue: 0,0:20:27.28,0:20:30.16,Main,,0,0,0,,Мен сізді енді жақсырақ түсінемін.
Dialogue: 0,00:20:28.35,00:20:31.27,JPN TOP,,0,0,0,,Сіздің арқаңызда мен сіз туралы аздап білдім.
Dialogue: 0,0:20:36.11,0:20:39.29,Main,,0,0,0,,Уайымдама, мен саған қарамаймын.
Dialogue: 0,00:20:37.19,00:20:40.19,JPN TOP,,0,0,0,,Уайымдама, мен саған қарамаймын.
Dialogue: 0,0:20:39.74,0:20:41.32,Main,,0,0,0,,Бұл енді маңызды емес.
Dialogue: 0,00:20:40.82,00:20:42.28,JPN TOP,,0,0,0,,Әсіресе...
Dialogue: 0,0:20:44.79,0:20:46.16,Main,,0,0,0,,Хиёри, қош келдің.
Dialogue: 0,00:20:45.82,00:20:47.12,JPN TOP,,0,0,0,,Рахмет
Dialogue: 0,0:20:55.21,0:20:56.55,Main,,0,0,0,,Мен түсіндім!
Dialogue: 0,00:20:56.08,00:20:57.75,JPN TOP,,0,0,0,,Мен түсіндім! (жұт) Уау
Dialogue: 0,0:20:56.86,0:20:57.89,Main,,0,0,0,,Фуши-сан!
Dialogue: 0,00:20:57.88,00:20:58.79,JPN TOP,,0,0,0,,Фуши мырза
Dialogue: 0,0:21:01.38,0:21:04.41,Main,,0,0,0,,Жарайды, ішімдіктің орнына қайтайық.
Dialogue: 0,00:21:02.46,00:21:05.22,JPN TOP,,0,0,0,,Жүр, Сәке қарттың орнына қайтайық.
Dialogue: 0,0:21:04.41,0:21:05.74,Main,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,00:21:05.34,00:21:08.89,JPN TOP,,0,0,0,,Иә, жақсы ма? Тек үйге барғым келмеді
Dialogue: 0,0:21:05.74,0:21:08.00,Main,,0,0,0,,Сіз бұрын қайтып оралғыңыз келмейтінін айттыңыз.
Dialogue: 0,0:21:08.00,0:21:11.28,Main,,0,0,0,,Бұл сіз үшін ең жақсы жер, солай емес пе?
Dialogue: 0,00:21:09.01,00:21:12.18,JPN TOP,,0,0,0,,Бұл сіз үшін ең жақсы жер емес пе?
Dialogue: 0,0:21:11.28,0:21:12.30,Main,,0,0,0,,Оқу, оқу
Dialogue: 0,00:21:12.31,00:21:13.81,JPN TOP,,0,0,0,,Иә...
Dialogue: 0,0:21:12.94,0:21:15.93,Main,,0,0,0,,Бірақ сен енді қартқа ашуланбайсың ба?
Dialogue: 0,00:21:13.93,00:21:16.81,JPN TOP,,0,0,0,,Бірақ сен енді атаңа ренжімейсің бе?
Dialogue: 0,0:21:16.20,0:21:18.30,Main,,0,0,0,,Маған енді бәрібір,
Dialogue: 0,00:21:16.94,00:21:19.15,JPN TOP,,0,0,0,,Бұл енді маңызды емес
Dialogue: 0,0:21:18.30,0:21:21.74,Main,,0,0,0,,ол маған не істегені немесе мен өзімді қалай сезінгенім туралы.
Dialogue: 0,00:21:19.27,00:21:22.69,JPN TOP,,0,0,0,,Маған не болды және мен қандай сезімде болдым?
Dialogue: 0,0:21:21.74,0:21:24.56,Main,,0,0,0,,Мен оны кешіргенім емес...
Dialogue: 0,00:21:22.82,00:21:25.45,JPN TOP,,0,0,0,,Мен сені кешірген сияқты емеспін...
Dialogue: 0,00:21:25.99,00:21:28.91,JPN TOP,,0,0,0,,(Мирдің ойнақы дауысы)
Dialogue: 0,0:21:27.98,0:21:31.76,Main,,0,0,0,,Бірақ мен өз жағдайларыма қызығушылықты жоғалттым.
Dialogue: 0,00:21:29.03,00:21:32.83,JPN TOP,,0,0,0,,Мен жай ғана өз жағдайыма қызығушылықты жоғалттым.
Dialogue: 0,0:21:32.29,0:21:33.40,Main,,0,0,0,,Мен сен тұрған жерге дүрлігіп барамын
Dialogue: 0,00:21:33.45,00:21:34.29,JPN TOP,,0,0,0,,Барлығы осы
Dialogue: 0,0:21:33.81,0:21:35.36,Main,,0,0,0,,Сондықтан мен қазір қайтып кете аламын.
Dialogue: 0,00:21:34.91,00:21:37.67,JPN TOP,,0,0,0,,Ендеше біз қазір үйге бара аламыз. Үйге барайық.
Dialogue: 0,0:21:35.76,0:21:36.76,Main,,0,0,0,,Вент одан әрі ашылмауына қол жеткіздік.
Dialogue: 0,0:21:40.77,0:21:41.80,Main,,0,0,0,,Алдымен, ортаңғы және көрсеткі саусақтарыңызды осылайша қосыңыз,
Dialogue: 0,00:21:41.80,00:21:42.92,JPN TOP,,0,0,0,,Иә!
Dialogue: 0,00:21:52.89,00:21:53.68,JPN TOP,,0,0,0,,Ha
Dialogue: 0,0:21:53.20,0:21:54.79,Main,,0,0,0,,Жас ханым!
Dialogue: 0,00:21:54.31,00:21:55.68,JPN TOP,,0,0,0,,Ханым!
Dialogue: 0,0:21:55.03,0:21:57.79,Main,,0,0,0,,Яғни, Ято-чан мен басқалар қайта оралды ма?
Dialogue: 0,00:21:55.81,00:21:59.19,JPN TOP,,0,0,0,,Қайда кеттіңіз!?
Dialogue: 0,0:21:57.79,0:22:01.04,Main,,0,0,0,,Сіз бұл маскамен мені алдамайсыз.
Dialogue: 0,00:21:59.31,00:22:01.94,JPN TOP,,0,0,0,,Маскамен жасыруға тырыссаңыз да, ол жұмыс істемейді.
Dialogue: 0,0:22:01.04,0:22:02.32,Main,,0,0,0,,Үйге қайтайық.
Dialogue: 0,00:22:02.07,00:22:06.07,JPN TOP,,0,0,0,,Енді үйге қайтайық. Әкелерің сені уайымдайды.
Dialogue: 0,0:22:02.32,0:22:05.20,Main,,0,0,0,,Әкең де, басқаларың да сені уайымдайды.
Dialogue: 0,0:22:05.20,0:22:07.25,Main,,0,0,0,,Сізде қате адам болуы керек.
Dialogue: 0,00:22:06.19,00:22:09.91,JPN TOP,,0,0,0,,Бұл дұрыс емес адам ба? Мен арық туралы білмеймін.
Dialogue: 0,0:22:07.25,0:22:09.16,Main,,0,0,0,,Мен Реан туралы білмеймін.
Dialogue: 0,00:22:10.03,00:22:13.58,JPN TOP,,0,0,0,,Хохохо... әдеттегідей сүйкімді
Dialogue: 0,0:22:10.34,0:22:12.70,Main,,0,0,0,,Сіз бұрынғыдай сүйкімдісіз.
Dialogue: 0,0:22:12.70,0:22:15.94,Main,,0,0,0,,Мен ешқашан «Рейн» деп айтқан емеспін.
Dialogue: 0,00:22:13.70,00:22:16.83,JPN TOP,,0,0,0,,Мен арық туралы ешқашан ештеңе айтқан емеспін.
Dialogue: 0,0:22:16.34,0:22:18.39,Main,,0,0,0,,Енді беріл, үйге қайтайық.
Dialogue: 0,00:22:16.96,00:22:19.25,JPN TOP,,0,0,0,,Енді ойланып үйге қайтайық.
Dialogue: 0,0:22:18.39,0:22:21.55,Main,,0,0,0,,Мүмкін емес. Бұл сондай азап.
Dialogue: 0,00:22:19.37,00:22:22.46,JPN TOP,,0,0,0,,Жоқ, бұл ауыртпалық...
Dialogue: 0,0:22:23.10,0:22:24.74,Main,,0,0,0,,Оған мән бермеңіз!
Dialogue: 0,00:22:24.00,00:22:25.71,JPN TOP,,0,0,0,,А-а (жұт) Оны елемеңіз!
Dialogue: 0,00:22:26.26,00:22:28.93,JPN TOP,,0,0,0,,(Гу-гу мен Линнің ауыр тыныс алуы)
Dialogue: 0,0:22:28.00,0:22:29.56,Main,,0,0,0,,Жас ханым!
Dialogue: 0,00:22:29.05,00:22:32.14,JPN TOP,,0,0,0,,Ханым... Ханым!
Dialogue: 0,0:22:30.00,0:22:31.65,Main,,0,0,0,,Жас ханым!
Dialogue: 0,0:22:31.65,0:22:33.95,Main,,0,0,0,,О, жоқ! Ол әлі мені аңдып жүр!
Dialogue: 0,00:22:32.76,00:22:34.77,JPN TOP,,0,0,0,,Жоқ, мен сенімен бірге келемін.
Dialogue: 0,0:22:33.95,0:22:36.31,Main,,0,0,0,,Ол үйге артымыздан еретін болса, қиыншылық болады.
Dialogue: 0,00:22:34.89,00:22:37.52,JPN TOP,,0,0,0,,Менің үйіме біреу келсе қиын болар еді.
Dialogue: 0,0:22:36.62,0:22:38.21,Main,,0,0,0,,Фуши, оған қамқор бол.
Dialogue: 0,00:22:37.64,00:22:39.64,JPN TOP,,0,0,0,,Фуши өтінемін! Иә
Dialogue: 0,0:22:38.21,0:22:38.74,Main,,0,0,0,,Алдымен, ортаңғы және көрсеткі саусақтарыңызды осылайша қосыңыз,
Dialogue: 0,0:22:38.74,0:22:39.98,Main,,0,0,0,,Шынымен
Dialogue: 0,00:22:39.77,00:22:42.69,JPN TOP,,0,0,0,,Күте тұрыңыз... Ха, жас ханым...
Dialogue: 0,0:22:40.75,0:22:42.36,Main,,0,0,0,,Жас ла—
Dialogue: 0,00:22:42.81,00:22:44.32,JPN TOP,,0,0,0,,Cuckoo...
Dialogue: 0,00:22:44.44,00:22:47.15,JPN TOP,,0,0,0,,Ита... Мынау не қыз?
Dialogue: 0,0:22:45.01,0:22:46.88,Main,,0,0,0,,Who is this child?
Dialogue: 0,00:22:47.28,00:22:49.15,JPN TOP,,0,0,0,,Уф...
Dialogue: 0,0:22:48.71,0:22:51.32,Main,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,00:22:49.78,00:22:52.24,JPN TOP,,0,0,0,,Ал, біз не істеуіміз керек?
Dialogue: 0,00:22:49.78,00:22:53.53,JPN TOP,,0,0,0,,Мен...
Dialogue: 0,0:22:51.32,0:22:52.42,Main,,0,0,0,,It hurts.
Dialogue: 0,0:22:52.64,0:22:56.05,Main - Top,,0,0,0,,Ауырды. Ол аурады.
Dialogue: 0,00:22:52.78,00:22:54.16,JPN TOP,,0,0,0,,Ах!
Dialogue: 0,0:22:53.55,0:22:56.06,Main,,0,0,0,,Қансырап жатыр! О, жоқ!
Dialogue: 0,00:22:53.66,00:22:56.95,JPN TOP,,0,0,0,,Мен...
Dialogue: 0,00:22:54.28,00:22:56.95,JPN TOP,,0,0,0,,Қан шығып жатыр... Сұмдық!
Dialogue: 0,00:22:57.08,00:22:58.33,JPN TOP,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:22:57.31,0:22:59.32,Main,,0,0,0,,Міне! We're almost home!
Dialogue: 0,00:22:58.46,00:23:00.21,JPN TOP,,0,0,0,,Мен оны көріп тұрмын! Мен үйге жақындадым
Dialogue: 0,0:22:59.59,0:23:01.37,Main,,0,0,0,,Эй, Фуши-сан ше?
Dialogue: 0,00:23:00.33,00:23:02.21,JPN TOP,,0,0,0,,Эй, Фуши мырза ше?
Dialogue: 0,0:23:01.37,0:23:03.20,Main,,0,0,0,,Уайымдамаңыз. He'll be right with us.
Dialogue: 0,00:23:02.33,00:23:04.09,JPN TOP,,0,0,0,,Жарайды, мен бірден келемін.
Dialogue: 0,0:23:03.71,0:23:07.06,Main,,0,0,0,,Мен бұл туралы білмеймін.
Dialogue: 0,00:23:04.80,00:23:08.13,JPN TOP,,0,0,0,,Енді... сіз қалай ойлайсыз?
Dialogue: 0,0:23:09.20,0:23:11.12,Main,,0,0,0,,Менің ойымша, ол болмайды.
Dialogue: 0,00:23:10.22,00:23:12.18,JPN TOP,,0,0,0,,Бәлкім, артқа қайтпайтын шығар
Dialogue: 0,0:23:11.83,0:23:13.70,Main,,0,0,0,,Екі себеп бойынша.
Dialogue: 0,00:23:12.72,00:23:14.93,JPN TOP,,0,0,0,,Екі себеп бар.
Dialogue: 0,0:23:14.07,0:23:20.20,Main,,0,0,0,,Біріншіден, ол соңғы шайқастан бері ешнәрсеге ие болған жоқ.
Dialogue: 0,00:23:15.06,00:23:16.52,JPN TOP,,0,0,0,,Бірінші
Dialogue: 0,00:23:16.64,00:23:21.10,JPN TOP,,0,0,0,,Мен соңғы шайқастан бері пайдалы ештеңе алған жоқпын.
Dialogue: 0,0:23:20.66,0:23:24.19,Main,,0,0,0,,Екіншіден, ол бірінші қадамды жасады.
Dialogue: 0,00:23:21.73,00:23:24.61,JPN TOP,,0,0,0,,Екіншіден, бірінші қадам жасалды.
Dialogue: 0,00:23:29.69,00:23:32.11,JPN TOP,,0,0,0,,Не? Кя!
Dialogue: 0,0:23:32.11,0:23:33.80,Main,,0,0,0,,Бұл айқай ма?
Dialogue: 0,00:23:32.24,00:23:33.07,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,00:23:33.20,00:23:34.66,JPN TOP,,0,0,0,,Дәл қазір айқай ма?
Dialogue: 0,0:23:33.80,0:23:36.23,Main,,0,0,0,,Фуши міндетті түрде көрініс жасап жатыр.
Dialogue: 0,00:23:34.78,00:23:37.12,JPN TOP,,0,0,0,,Сіз мұны керемет түрде жасайсыз, Фуси.
Dialogue: 0,0:23:36.23,0:23:38.73,Main - Top,,0,0,0,,Біреу! Біреу көмектес!
Dialogue: 0,00:23:37.24,00:23:40.12,JPN TOP,,0,0,0,,Біреу...біреу маған көмектесші, бұл құбыжық!
Dialogue: 0,0:23:38.73,0:23:40.42,Main - Top,,0,0,0,,Бұл құбыжық!
Dialogue: 0,0:23:39.85,0:23:41.14,Main,,0,0,0,,Құбыжық?
Dialogue: 0,00:23:40.25,00:23:42.04,JPN TOP,,0,0,0,,Не? (Арық) Құбыжық па?
Dialogue: 0,0:23:41.14,0:23:43.39,Main,,0,0,0,,Мен барып қарап көрейін. Үйге бар, мен сол жерде боламын.
Dialogue: 0,00:23:42.17,00:23:44.17,JPN TOP,,0,0,0,,Мен қараймын. Алдымен үйге бар.
Dialogue: 0,0:23:43.39,0:23:44.21,Main,,0,0,0,,Шынымен
Dialogue: 0,0:23:44.21,0:23:45.52,Main,,0,0,0,,Мені жалғыз қалдырмаңыз!
Dialogue: 0,00:23:44.29,00:23:46.21,JPN TOP,,0,0,0,,Күте тұрыңыз! Мені жалғыз қалдыр...
Dialogue: 0,0:23:45.52,0:23:46.23,Main,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,00:23:46.34,00:23:47.13,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:23:47.21,0:23:50.48,Main,,0,0,0,,Мен өзім қайта аламын дедім.
Dialogue: 0,00:23:47.25,00:23:51.38,JPN TOP,,0,0,0,,А... Мен үйге жалғыз бара аламын дедім...
Dialogue: 0,0:23:50.48,0:23:53.15,Main,,0,0,0,,Оң. Аман есен орал.
Dialogue: 0,00:23:51.51,00:23:54.39,JPN TOP,,0,0,0,,Иә, абай болыңыз.
Dialogue: 0,0:23:54.15,0:23:56.28,Main,,0,0,0,,Жарайды. Сен де.
Dialogue: 0,00:23:55.26,00:23:57.35,JPN TOP,,0,0,0,,Иә, сен де!
Dialogue: 0,00:23:58.14,00:23:59.52,JPN TOP,,0,0,0,,Хахаха...
Dialogue: 0,0:23:59.06,0:24:00.04,Italics,,0,0,0,,Фуши!
Dialogue: 0,00:24:00.18,00:24:01.10,JPN TOP,,0,0,0,,Фуши!
Dialogue: 0,0:24:02.44,0:24:04.67,Main,,0,0,0,,Бұл не... Бұл қан еді?
Dialogue: 0,00:24:02.77,00:24:05.40,JPN TOP,,0,0,0,,Ой, бұл не? Қан?
Dialogue: 0,00:24:05.52,00:24:06.40,JPN TOP,,0,0,0,,Ах
Dialogue: 0,0:24:06.27,0:24:07.14,Main,,0,0,0,,Фуши!
Dialogue: 0,00:24:07.02,00:24:08.19,JPN TOP,,0,0,0,,Фуши!
Dialogue: 0,0:24:08.18,0:24:09.14,Main,,0,0,0,,Фуши!
Dialogue: 0,00:24:09.03,00:24:11.90,JPN TOP,,0,0,0,,Фуши! Фуши! Фуши!
Dialogue: 0,0:24:09.48,0:24:11.00,Main,,0,0,0,,Фуши! Фуши!
Dialogue: 0,00:24:15.03,00:24:15.91,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:24:17.57,0:24:19.01,Main,,0,0,0,,Бұл не болып жатыр өзі?!
Dialogue: 0,00:24:18.62,00:24:19.91,JPN TOP,,0,0,0,,Бұл не?
Dialogue: 0,00:24:25.04,00:24:26.17,JPN TOP,,0,0,0,,Жоқ…
Dialogue: 0,0:24:29.99,0:24:51.01,sign_35245_236_Preview,,0,0,0,,Алдын ала қарау
Dialogue: 0,0:24:31.23,0:24:35.86,Narration,,0,0,0,,Белгісіз жау тағы келді.
Dialogue: 0,00:24:32.26,00:24:36.93,JPN TOP,,0,0,0,,Жұмбақ жау қайтадан пайда болады
Dialogue: 0,0:24:36.97,0:24:40.67,Narration,,0,0,0,,Орманда Фушиге қатты шабуыл жасалды.
Dialogue: 0,00:24:38.10,00:24:41.68,JPN TOP,,0,0,0,,Фуши орманда шабуылға ұшырады
Dialogue: 0,0:24:41.20,0:24:43.45,Narration,,0,0,0,,Гугу көмекке асығады.
Dialogue: 0,00:24:42.23,00:24:44.56,JPN TOP,,0,0,0,,Гу Гу көмекке жүгіреді
Dialogue: 0,0:24:44.63,0:24:50.55,Narration,,0,0,0,,Ағайындылар арасындағы байланыс өлімнен тар қашуды ұсынады.
Dialogue: 0,00:24:45.69,00:24:51.65,JPN TOP,,0,0,0,,Бауырластық байланыстар жаңа өмірге әкеледі.
Dialogue: 0,0:24:51.01,0:24:55.03,Episode_Title,,0,0,0,,Жаңа отбасы
Dialogue: 0,0:24:56.53,0:25:02.53,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory