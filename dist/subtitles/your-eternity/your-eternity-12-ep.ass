Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.40,0:00:06.64,Narration,,0,0,0,,Фуши төрт жыл бойы өзін отбасы деп санауға болатын нәрсеге арнады
Dialogue: 0,00:00:02.37,00:00:07.71,JPN TOP,,0,0,0,,Күнімді отбасыма арнаумен өткен төрт жыл.
Dialogue: 0,0:00:07.25,0:00:10.86,Narration,,0,0,0,,оның адам болып өсуіне себепші болды.
Dialogue: 0,00:00:08.25,00:00:11.88,JPN TOP,,0,0,0,,Фушиді адам сияқты өсірді.
Dialogue: 0,0:00:12.62,0:00:15.44,Narration,,0,0,0,,Олардың досы Реан шақырды,
Dialogue: 0,00:00:13.63,00:00:15.89,JPN TOP,,0,0,0,,Менің досым Линна шақырды
Dialogue: 0,0:00:16.21,0:00:22.02,Narration,,0,0,0,,Фуши Гугудың туған күніне қатысады.
Dialogue: 0,00:00:17.22,00:00:23.14,JPN TOP,,0,0,0,,Фуши Гуо Гуомен бірге туған күн кешіне қатысады
Dialogue: 0,0:00:24.83,0:00:25.99,Main,,0,0,0,,Ой, Хиёри-я! Жаңа жылды әзілмен бастап жатырсың ғой, иә?
Dialogue: 0,00:00:25.85,00:00:27.27,JPN TOP,,0,0,0,,Мен...
Dialogue: 0,00:00:28.65,00:00:29.52,JPN TOP,,0,0,0,,Қақпақ
Dialogue: 0,0:00:31.88,0:00:32.73,Narration,,0,0,0,,Қазір тек екеуміз ғана қалдық.
Dialogue: 0,00:00:32.78,00:00:34.15,JPN TOP,,0,0,0,,Бірақ...
Dialogue: 0,00:00:36.03,00:00:40.79,JPN TOP,,0,0,0,,♪~
Dialogue: 0,00:02:00.91,00:02:05.87,JPN TOP,,0,0,0,,~♪
Dialogue: 0,0:02:05.93,0:02:06.86,Main,,0,0,0,,Олар осында.
Dialogue: 0,0:02:06.86,0:02:08.03,Main,,0,0,0,,Бұл Ноккерлер.
Dialogue: 0,00:02:07.04,00:02:09.21,JPN TOP,,0,0,0,,Міне, тықылдағыш келеді.
Dialogue: 0,00:02:11.84,00:02:12.88,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:02:13.45,0:02:16.00,Main,,0,0,0,,Оның өзегі жер астында.
Dialogue: 0,00:02:14.55,00:02:17.09,JPN TOP,,0,0,0,,Оның өзегі мына жерде.
Dialogue: 0,0:02:16.66,0:02:19.74,Main,,0,0,0,,Ол өзінің тамырын бүкіл аймаққа таратқан.
Dialogue: 0,00:02:17.72,00:02:20.64,JPN TOP,,0,0,0,,Бұл аймақта тамырлар тараған
Dialogue: 0,0:02:20.30,0:02:23.04,Main,,0,0,0,,Жақында бұл жерді қиратады.
Dialogue: 0,00:02:21.34,00:02:24.01,JPN TOP,,0,0,0,,Олар жақын арада бұл жерді қиратады.
Dialogue: 0,00:02:26.22,00:02:28.56,JPN TOP,,0,0,0,,(Қонақтардың айқайы)
Dialogue: 0,0:02:27.82,0:02:28.86,Main,,0,0,0,,Ал оның Регалияларының көбі шын мәнінде Нора болып шықты.
Dialogue: 0,00:02:28.69,00:02:29.64,JPN TOP,,0,0,0,,Не!
Dialogue: 0,0:02:28.86,0:02:30.17,Main,,0,0,0,,Мен қорқамын!
Dialogue: 0,00:02:29.77,00:02:31.06,JPN TOP,,0,0,0,,Қорқынышты!
Dialogue: 0,0:02:31.19,0:02:32.96,Main,,0,0,0,,Барлығыңыз сыртқа шығыңыздар! Жүгір!
Dialogue: 0,00:02:32.27,00:02:33.86,JPN TOP,,0,0,0,,Барлығы сыртқа шығыңыз! Жүгіріп кету!
Dialogue: 0,0:02:37.50,0:02:38.38,Main,,0,0,0,,Меерді алыңыз.
Dialogue: 0,00:02:38.53,00:02:39.99,JPN TOP,,0,0,0,,Мир (Ер) Әй?
Dialogue: 0,0:02:39.46,0:02:41.09,Main,,0,0,0,,Сен кет!
Dialogue: 0,00:02:40.11,00:02:42.16,JPN TOP,,0,0,0,,Ей, сен де қаш!
Dialogue: 0,00:02:43.53,00:02:44.58,JPN TOP,,0,0,0,,Мықтырақ!
Dialogue: 0,00:02:45.37,00:02:47.50,JPN TOP,,0,0,0,,(Фуши үреді)
Dialogue: 0,0:02:46.55,0:02:49.43,Main,,0,0,0,,Енді, әлі де мүмкіндігіңіз бар!
Dialogue: 0,00:02:47.62,00:02:49.83,JPN TOP,,0,0,0,,Қазір...
Dialogue: 0,00:02:49.96,00:02:51.17,JPN TOP,,0,0,0,,(Айқай)
Dialogue: 0,0:02:50.27,0:02:54.27,Episode_Title,,0,0,0,,Ояну
Dialogue: 0,00:02:55.30,00:02:58.17,JPN TOP,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:02:57.71,0:02:58.95,Main,,0,0,0,,Гугу!
Dialogue: 0,00:02:58.30,00:02:59.84,JPN TOP,,0,0,0,,Жарайсың!
Dialogue: 0,00:02:59.97,00:03:01.09,JPN TOP,,0,0,0,,Адамдар өте оңай өліп қалады, иә?
Dialogue: 0,0:03:02.80,0:03:03.90,Main,,0,0,0,,Біреу!
Dialogue: 0,00:03:03.93,00:03:06.60,JPN TOP,,0,0,0,,Біреу...біреу маған көмектессін!
Dialogue: 0,0:03:04.33,0:03:05.69,Main,,0,0,0,,Біреу көмектессін!
Dialogue: 0,0:03:06.08,0:03:07.93,Main,,0,0,0,,Бұл не деген сұмдық?
Dialogue: 0,00:03:07.22,00:03:10.69,JPN TOP,,0,0,0,,Бұл не... жабысқақ.
Dialogue: 0,0:03:07.93,0:03:09.78,Main,,0,0,0,,Бұл өте жабысқақ.
Dialogue: 0,00:03:10.81,00:03:13.06,JPN TOP,,0,0,0,,Уау! Ол тірі зат па?
Dialogue: 0,0:03:10.85,0:03:12.16,Main,,0,0,0,,Тірі ме?!
Dialogue: 0,00:03:15.73,00:03:16.94,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:03:17.59,0:03:19.16,Main,,0,0,0,,Мынаны алыңыз!
Dialogue: 0,00:03:17.69,00:03:18.57,JPN TOP,,0,0,0,,Ішек
Dialogue: 0,00:03:18.69,00:03:20.49,JPN TOP,,0,0,0,,Мынаны ұстаңыз!
Dialogue: 0,00:03:20.61,00:03:22.03,JPN TOP,,0,0,0,,Уф...
Dialogue: 0,00:03:23.91,00:03:26.24,JPN TOP,,0,0,0,,Grrgh... grrgh
Dialogue: 0,00:03:27.62,00:03:30.50,JPN TOP,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:03:29.60,0:03:30.85,Main,,0,0,0,,Маған көмектес...
Dialogue: 0,00:03:30.62,00:03:31.92,JPN TOP,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:03:31.37,0:03:32.18,Main,,0,0,0,,Оқу, оқу
Dialogue: 0,00:03:32.46,00:03:34.83,JPN TOP,,0,0,0,,Осы екеуінің қайсысы екенін сұрап тұрмын. Сен бе?
Dialogue: 0,0:03:32.56,0:03:33.93,Main,,0,0,0,,Хиёри, қош келдің.
Dialogue: 0,0:03:33.93,0:03:35.50,Main,,0,0,0,,Менде тек сызаттар бар.
Dialogue: 0,00:03:34.96,00:03:37.96,JPN TOP,,0,0,0,,Бұл жай ғана сызат. Сіздің аман қалғаныңызға қуаныштымын.
Dialogue: 0,0:03:35.50,0:03:36.64,Main,,0,0,0,,Сіз құтқарушысыз.
Dialogue: 0,0:03:37.36,0:03:39.98,Main,,0,0,0,,Құдайға шүкір, Гугу.
Dialogue: 0,00:03:38.09,00:03:40.88,JPN TOP,,0,0,0,,Жақсы Гу Гу
Dialogue: 0,0:03:41.00,0:03:43.29,Main,,0,0,0,,Не болды?
Dialogue: 0,00:03:42.05,00:03:44.18,JPN TOP,,0,0,0,,Не болды?
Dialogue: 0,0:03:43.29,0:03:44.32,Main,,0,0,0,,Тик-так, сағат тілі тик-так
Dialogue: 0,00:03:44.30,00:03:47.85,JPN TOP,,0,0,0,,Енді... сарай кенет құлай бастады.
Dialogue: 0,0:03:44.67,0:03:46.98,Main,,0,0,0,,Үй енді ғана құлай бастады.
Dialogue: 0,0:03:47.91,0:03:49.22,Main,,0,0,0,,Бұл мүмкін емес...
Dialogue: 0,00:03:47.97,00:03:50.06,JPN TOP,,0,0,0,,(Әйел турист 1) Санта-Киара шіркеуіне қалай жетуге болады?
Dialogue: 0,0:03:51.00,0:03:52.32,Main,,0,0,0,,Гугу!
Dialogue: 0,00:03:52.02,00:03:53.23,JPN TOP,,0,0,0,,Goo Goo!
Dialogue: 0,00:03:54.40,00:03:58.19,JPN TOP,,0,0,0,,Хахахаха... Фуши?
Dialogue: 0,0:03:56.24,0:03:57.29,Main,,0,0,0,,Фуши!
Dialogue: 0,0:03:57.78,0:04:00.28,Main,,0,0,0,,Гугу, кешіріңіз.
Dialogue: 0,00:03:58.32,00:04:01.32,JPN TOP,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:00.80,0:04:04.02,Main,,0,0,0,,Бұл жерде болғанына мен кінәлімін.
Dialogue: 0,00:04:01.86,00:04:04.82,JPN TOP,,0,0,0,,Мен осылай айтамын.
Dialogue: 0,0:04:04.02,0:04:05.45,Main,,0,0,0,,Мен оны білдім.
Dialogue: 0,00:04:04.95,00:04:06.37,JPN TOP,,0,0,0,,Күтілгендей
Dialogue: 0,0:04:05.45,0:04:07.29,Main,,0,0,0,,Барлығы қашып кетті.
Dialogue: 0,00:04:06.49,00:04:08.62,JPN TOP,,0,0,0,,Минна қашып кетті
Dialogue: 0,0:04:07.68,0:04:11.23,Main,,0,0,0,,Сол екеуі ғана қалды.
Dialogue: 0,00:04:08.74,00:04:12.12,JPN TOP,,0,0,0,,Ато - бұл екеуі ғана.
Dialogue: 0,0:04:11.42,0:04:13.75,Main,,0,0,0,,Ұстаңыз!
Dialogue: 0,00:04:12.25,00:04:15.04,JPN TOP,,0,0,0,,Ей, өзіңізді ұстаңыз!
Dialogue: 0,0:04:14.13,0:04:17.04,Main,,0,0,0,,Бірақ екеуі де жараланған.
Dialogue: 0,00:04:15.17,00:04:17.54,JPN TOP,,0,0,0,,Бірақ екеуі де ашулы...
Dialogue: 0,00:04:16.38,00:04:17.54,JPN TOP,,0,0,0,,Эй!
Dialogue: 0,0:04:17.51,0:04:19.04,Main,,0,0,0,,Иә, маған қалдыр.
Dialogue: 0,00:04:17.54,00:04:18.17,JPN TOP,,0,0,0,,Бірақ екеуі де ашулы...
Dialogue: 0,00:04:18.29,00:04:21.63,JPN TOP,,0,0,0,,Тез... Тездетуім керек.
Dialogue: 0,0:04:19.04,0:04:20.74,Main,,0,0,0,,Уақыт жоқ.
Dialogue: 0,0:04:22.72,0:04:24.65,Main,,0,0,0,,Бәле! Құлап жатыр!
Dialogue: 0,00:04:23.51,00:04:25.55,JPN TOP,,0,0,0,,Бұл қауіпті, ол құлап қалады!
Dialogue: 0,00:04:26.51,00:04:29.06,JPN TOP,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,00:04:31.22,00:04:33.56,JPN TOP,,0,0,0,,(Гу-Гудың ауыр тыныс алуы)
Dialogue: 0,0:04:34.38,0:04:36.58,Main,,0,0,0,,Әке! Анашым!
Dialogue: 0,00:04:35.48,00:04:37.69,JPN TOP,,0,0,0,,Әке! Анашым!
Dialogue: 0,00:04:37.81,00:04:40.02,JPN TOP,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын...
Dialogue: 0,0:04:43.70,0:04:44.85,Main,,0,0,0,,Сен оларды сондай-ақ тастап жібересің.
Dialogue: 0,00:04:44.82,00:04:48.49,JPN TOP,,0,0,0,,Күте тұрыңыз! Барма
Dialogue: 0,0:04:44.85,0:04:47.61,Main,,0,0,0,,Гугу... Барма.
Dialogue: 0,0:04:49.05,0:04:52.45,Main,,0,0,0,,Сіз білуіңіз керек, мен...
Dialogue: 0,00:04:49.12,00:04:51.45,JPN TOP,,0,0,0,,Мен... мен...
Dialogue: 0,00:04:52.12,00:04:53.66,JPN TOP,,0,0,0,,Сіз туралы...
Dialogue: 0,00:04:59.00,00:05:00.38,JPN TOP,,0,0,0,,Ах
Dialogue: 0,00:05:06.76,00:05:11.72,JPN TOP,,0,0,0,,(Гу-Гудың ауыр тыныс алуы)
Dialogue: 0,0:05:10.81,0:05:12.19,Main,,0,0,0,,Фуши!
Dialogue: 0,00:05:11.85,00:05:13.27,JPN TOP,,0,0,0,,Фуши!
Dialogue: 0,0:05:14.13,0:05:15.41,Main,,0,0,0,,Қайдасың?
Dialogue: 0,00:05:15.23,00:05:16.48,JPN TOP,,0,0,0,,әжесі келіп, оны алып кетуге асығып тұрғандай.
Dialogue: 0,00:05:17.31,00:05:19.02,JPN TOP,,0,0,0,,(Қоқыстың құлаған дыбысы)
Dialogue: 0,00:05:20.94,00:05:25.32,JPN TOP,,0,0,0,,Уф хахахаха...
Dialogue: 0,0:05:25.40,0:05:26.56,Main,,0,0,0,,Фуши!
Dialogue: 0,00:05:25.45,00:05:27.41,JPN TOP,,0,0,0,,О, Фуши!
Dialogue: 0,0:05:26.56,0:05:27.72,Main,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,00:05:27.53,00:05:31.16,JPN TOP,,0,0,0,,О, құдай-ау, артыма қарасам, біттім...
Dialogue: 0,0:05:27.72,0:05:29.77,Main,,0,0,0,,Сіз бұрынғыдайсыз.
Dialogue: 0,0:05:30.24,0:05:31.60,Main,,0,0,0,,Хиёри, қош келдің.
Dialogue: 0,00:05:31.28,00:05:32.49,JPN TOP,,0,0,0,,Рахмет
Dialogue: 0,0:05:31.60,0:05:32.85,Main,,0,0,0,,Жау қайда?
Dialogue: 0,00:05:32.62,00:05:35.58,JPN TOP,,0,0,0,,Жау қайда? Мен сені құртамын
Dialogue: 0,0:05:33.22,0:05:34.73,Main,,0,0,0,,Мен оны өлтіремін.
Dialogue: 0,0:05:34.73,0:05:36.28,Main,,0,0,0,,Мен оны әлі көрген жоқпын.
Dialogue: 0,00:05:35.71,00:05:38.25,JPN TOP,,0,0,0,,Әлі көрмедім Жасырын
Dialogue: 0,0:05:36.28,0:05:37.35,Main,,0,0,0,,Ол жасырынып жатыр.
Dialogue: 0,00:05:38.37,00:05:39.75,JPN TOP,,0,0,0,,(шу)
Dialogue: 0,00:05:39.88,00:05:41.71,JPN TOP,,0,0,0,,(қабығу)
Dialogue: 0,0:05:41.12,0:05:42.32,Main,,0,0,0,,Міне.
Dialogue: 0,00:05:41.84,00:05:44.09,JPN TOP,,0,0,0,,Болды, қаш!
Dialogue: 0,0:05:42.56,0:05:43.17,Main,,0,0,0,,Жылжы!
Dialogue: 0,00:05:44.21,00:05:45.38,JPN TOP,,0,0,0,,Уф
Dialogue: 0,0:05:46.92,0:05:50.11,Main,,0,0,0,,Бұрынғыдай қолын соза алмайды.
Dialogue: 0,00:05:48.01,00:05:50.93,JPN TOP,,0,0,0,,Мына жігіт бұрынғыдай қолын соза алмайды ма?
Dialogue: 0,0:05:50.11,0:05:51.40,Main,,0,0,0,,Жақсы нәрсе.
Dialogue: 0,00:05:51.05,00:05:52.31,JPN TOP,,0,0,0,,Бұл көмектеседі.
Dialogue: 0,0:05:51.40,0:05:52.41,Main,,0,0,0,,Мынаны ал!
Dialogue: 0,00:05:52.43,00:05:55.02,JPN TOP,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:05:56.83,0:05:57.84,Main,,0,0,0,,Гугу...
Dialogue: 0,00:05:57.89,00:05:58.73,JPN TOP,,0,0,0,,Гу Гу
Dialogue: 0,0:05:59.29,0:06:02.02,Main,,0,0,0,,Бұл соңғысымен бірдей емес.
Dialogue: 0,00:06:00.31,00:06:03.15,JPN TOP,,0,0,0,,Бұл алдыңғысынан өзгеше.
Dialogue: 0,00:06:04.36,00:06:07.49,JPN TOP,,0,0,0,,Ах... жалын жұмыс істемейді.
Dialogue: 0,0:06:04.67,0:06:06.46,Main,,0,0,0,,Өрт жұмыс істемейді.
Dialogue: 0,0:06:07.50,0:06:09.28,Main,,0,0,0,,Бұл тас сауыт.
Dialogue: 0,00:06:08.28,00:06:10.20,JPN TOP,,0,0,0,,Тас сауыт?
Dialogue: 0,00:06:10.78,00:06:12.99,JPN TOP,,0,0,0,,(тықылдау)
Dialogue: 0,00:06:13.79,00:06:15.41,JPN TOP,,0,0,0,,Уау
Dialogue: 0,0:06:16.01,0:06:17.64,Main,,0,0,0,,Не болып жатыр?!
Dialogue: 0,00:06:16.41,00:06:18.41,JPN TOP,,0,0,0,,Ку... Не болып жатыр!
Dialogue: 0,0:06:17.64,0:06:18.78,Main,,0,0,0,,Ұста, Гугу!
Dialogue: 0,00:06:18.54,00:06:20.37,JPN TOP,,0,0,0,,Күте тұрыңыз, жақсы!
Dialogue: 0,0:06:23.19,0:06:24.99,Main,,0,0,0,,Бұл тағы да бұралған заттар.
Dialogue: 0,00:06:24.25,00:06:28.51,JPN TOP,,0,0,0,,қайтадан Юнён! Бұл жігіт шынымен оны жылжытып жатыр ма?
Dialogue: 0,0:06:24.99,0:06:27.60,Main,,0,0,0,,Бұл нәрсе оларды басқара ма?
Dialogue: 0,0:06:30.76,0:06:32.20,Main,,0,0,0,,Олар жабылып жатыр.
Dialogue: 0,00:06:31.84,00:06:34.47,JPN TOP,,0,0,0,,Жақындау! Мен сені қысуға тырысамын
Dialogue: 0,0:06:32.20,0:06:33.58,Main,,0,0,0,,Бұл бізді басып-жаншуға тырысады!
Dialogue: 0,0:06:33.82,0:06:35.74,Main,,0,0,0,,Фуши, сен бірінші бар!
Dialogue: 0,00:06:34.60,00:06:36.47,JPN TOP,,0,0,0,,Фуши Алдымен барыңыз!
Dialogue: 0,0:06:35.74,0:06:36.55,Main,,0,0,0,,Ә... ә... білесің бе...
Dialogue: 0,00:06:36.60,00:06:38.48,JPN TOP,,0,0,0,,Иә!
Dialogue: 0,00:06:38.60,00:06:39.94,JPN TOP,,0,0,0,,Әй
Dialogue: 0,00:06:40.06,00:06:41.44,JPN TOP,,0,0,0,,Хмм...
Dialogue: 0,00:06:42.11,00:06:43.23,JPN TOP,,0,0,0,,Уф...
Dialogue: 0,0:06:42.24,0:06:44.37,Main,,0,0,0,,Не істейміз, Гугу?
Dialogue: 0,00:06:43.36,00:06:45.44,JPN TOP,,0,0,0,,Мен не істеуім керек? Жарайсың...
Dialogue: 0,0:06:46.21,0:06:50.01,Main,,0,0,0,,Мен оны қалай жеңетінімді білмеймін.
Dialogue: 0,00:06:47.24,00:06:50.95,JPN TOP,,0,0,0,,Мен... Мен қалай жеңерімді білмеймін
Dialogue: 0,0:06:54.20,0:06:56.15,Main,,0,0,0,,Ол заттың ішінде бірдеңе бар.
Dialogue: 0,00:06:55.28,00:06:58.37,JPN TOP,,0,0,0,,Оның ішінде бірдеңе бар, солай ма?
Dialogue: 0,0:06:56.15,0:06:57.50,Main,,0,0,0,,Бұл дұрыс емес пе?
Dialogue: 0,0:06:57.50,0:06:58.20,Main,,0,0,0,,Оқу, оқу
Dialogue: 0,00:06:58.50,00:06:59.33,JPN TOP,,0,0,0,,Иә
Dialogue: 0,0:06:58.72,0:07:00.18,Main,,0,0,0,,Бұл дегеніміз...
Dialogue: 0,00:06:59.87,00:07:03.25,JPN TOP,,0,0,0,,Олай болса, ол бет тас.
Dialogue: 0,0:07:00.18,0:07:02.29,Main,,0,0,0,,Оның беті тастан жасалған,
Dialogue: 0,0:07:02.29,0:07:04.74,Main,,0,0,0,,бірақ бұл күрделі мүсін немесе басқа нәрсе емес.
Dialogue: 0,00:07:03.38,00:07:05.63,JPN TOP,,0,0,0,,Бірақ бұл нақты ою емес.
Dialogue: 0,0:07:04.74,0:07:06.84,Main,,0,0,0,,Бұл бір-бірінен езілген тастардың шоғыры ғана.
Dialogue: 0,00:07:05.75,00:07:07.76,JPN TOP,,0,0,0,,Жай ғана тастар жинағы
Dialogue: 0,0:07:06.84,0:07:08.52,Main,,0,0,0,,Ал іштей бұл жай ғана ет.
Dialogue: 0,00:07:07.88,00:07:09.42,JPN TOP,,0,0,0,,Ішінде жай ғана ет
Dialogue: 0,0:07:08.89,0:07:11.15,Main,,0,0,0,,Оның үстіне шығып, осал жерін табайық!
Dialogue: 0,00:07:09.55,00:07:12.05,JPN TOP,,0,0,0,,Оған көтеріліп, бос орын ізде!
Dialogue: 0,0:07:11.43,0:07:12.42,Main,,0,0,0,,Түсіндім.
Dialogue: 0,00:07:12.18,00:07:13.55,JPN TOP,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,00:07:20.02,00:07:23.40,JPN TOP,,0,0,0,,Ku… U… Ku…
Dialogue: 0,00:07:23.52,00:07:25.36,JPN TOP,,0,0,0,,Хмм... уф
Dialogue: 0,0:07:24.66,0:07:27.45,Main,,0,0,0,,Іші өте қалың.
Dialogue: 0,00:07:25.48,00:07:28.36,JPN TOP,,0,0,0,,Ішінде әбден кептеліп қалған.
Dialogue: 0,0:07:27.90,0:07:29.91,Main,,0,0,0,,Фуши! Маған таяқ беріңіз!
Dialogue: 0,00:07:28.48,00:07:30.86,JPN TOP,,0,0,0,,Фуши Маған таяқшаны беріңіз!
Dialogue: 0,0:07:33.00,0:07:34.47,Main,,0,0,0,,Мен оны ашамын.
Dialogue: 0,00:07:34.07,00:07:35.37,JPN TOP,,0,0,0,,Мен оны ашамын
Dialogue: 0,0:07:35.23,0:07:37.17,Main,,0,0,0,,Маған көбірек керек! Тағы біреуін беріңізші!
Dialogue: 0,00:07:35.49,00:07:38.20,JPN TOP,,0,0,0,,Әлі жоқ! Маған көбірек беріңіз
Dialogue: 0,00:07:43.42,00:07:45.88,JPN TOP,,0,0,0,,.
Dialogue: 0,00:07:45.00,00:07:45.88,JPN TOP,,0,0,0,,Ах!
Dialogue: 0,0:07:45.20,0:07:47.16,Main,,0,0,0,,Міне! Оның іші!
Dialogue: 0,00:07:46.00,00:07:48.38,JPN TOP,,0,0,0,,Ол сонда болды!
Dialogue: 0,0:07:48.60,0:07:50.94,Main,,0,0,0,,Бұл жақсы және жұмсақ. Жақсы күйіп кететініне сенімдімін.
Dialogue: 0,00:07:49.51,00:07:51.84,JPN TOP,,0,0,0,,Ол жұмсақ және жақсы күйіп кететін сияқты!
Dialogue: 0,00:07:51.97,00:07:53.38,JPN TOP,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:08:03.51,0:08:04.81,Main,,0,0,0,,(Тик-так, тик-так соғады сағат)
Dialogue: 0,00:08:04.60,00:08:05.77,JPN TOP,,0,0,0,,Иә!
Dialogue: 0,00:08:09.78,00:08:10.57,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,00:08:26.08,00:08:28.38,JPN TOP,,0,0,0,,Ха, солай істе!
Dialogue: 0,0:08:26.35,0:08:27.47,Main,,0,0,0,,Түсініңіз!
Dialogue: 0,00:08:31.84,00:08:33.09,JPN TOP,,0,0,0,,Ei
Dialogue: 0,00:08:33.88,00:08:34.97,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,00:08:36.34,00:08:38.76,JPN TOP,,0,0,0,,Ой... уф
Dialogue: 0,00:08:38.89,00:08:39.85,JPN TOP,,0,0,0,,Ах
Dialogue: 0,00:08:40.68,00:08:43.23,JPN TOP,,0,0,0,,Әйтеуір, ол жақында ғана қорқынышты сынақтан өтті
Dialogue: 0,0:08:42.26,0:08:44.04,Main,,0,0,0,,Амансың ба, Фуши?
Dialogue: 0,00:08:43.35,00:08:45.14,JPN TOP,,0,0,0,,Жақсысың ба, Фуши?
Dialogue: 0,0:08:44.63,0:08:45.41,Main,,0,0,0,,Оқу, оқу
Dialogue: 0,00:08:45.27,00:08:46.31,JPN TOP,,0,0,0,,Иә...
Dialogue: 0,0:08:46.17,0:08:49.80,Main,,0,0,0,,Бірақ бұл біздің мүмкіндігіміз болды, мен оны жіберіп алдым.
Dialogue: 0,00:08:47.40,00:08:50.69,JPN TOP,,0,0,0,,Бірақ мүмкіндігім болып, қашып кеттім.
Dialogue: 0,0:08:51.33,0:08:53.96,Main,,0,0,0,,Міне, біздің күштіміз.
Dialogue: 0,00:08:52.40,00:08:54.90,JPN TOP,,0,0,0,,Міне, біз мықтымыз.
Dialogue: 0,0:08:53.96,0:08:55.48,Main,,0,0,0,,Біз мұны істедік, Фуши.
Dialogue: 0,00:08:55.03,00:08:56.36,JPN TOP,,0,0,0,,Жарайсың Фуши!
Dialogue: 0,0:08:57.03,0:08:58.95,Main,,0,0,0,,Рахмет, Гугу.
Dialogue: 0,00:08:58.07,00:08:59.83,JPN TOP,,0,0,0,,Рахмет Гу Гу
Dialogue: 0,0:08:58.95,0:09:01.94,Main,,0,0,0,,Сенсіз жеңіліп қалар едім.
Dialogue: 0,00:08:59.95,00:09:03.25,JPN TOP,,0,0,0,,Егер Гу Гу болмаса, біз тағы жеңіліп қалар едік.
Dialogue: 0,0:09:02.32,0:09:05.47,Main,,0,0,0,,Мен өлмейтін адам үшін өте әлсізмін.
Dialogue: 0,00:09:03.37,00:09:06.37,JPN TOP,,0,0,0,,Мен Фудзими болсам да, мен әлсізмін...
Dialogue: 0,0:09:06.66,0:09:09.63,Main,,0,0,0,,Көмек керек кезде мен әрқашан сенің арқаңды аламын.
Dialogue: 0,00:09:07.71,00:09:10.50,JPN TOP,,0,0,0,,Қиындыққа тап болсаң, қолымнан келгенше көмектесемін.
Dialogue: 0,0:09:09.63,0:09:11.90,Main,,0,0,0,,Ағайынды болу деген осы.
Dialogue: 0,00:09:10.63,00:09:12.80,JPN TOP,,0,0,0,,Ағайындылар деген осы.
Dialogue: 0,00:09:20.05,00:09:21.18,JPN TOP,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,00:09:28.02,00:09:31.57,JPN TOP,,0,0,0,,Фу... Фуши! Фуши!
Dialogue: 0,0:09:28.16,0:09:29.22,Main,,0,0,0,,Фуши!
Dialogue: 0,0:09:29.53,0:09:30.67,Main,,0,0,0,,Фуши!
Dialogue: 0,0:09:39.86,0:09:42.37,Main,,0,0,0,,Иә! Дәл уақытында!
Dialogue: 0,00:09:40.91,00:09:43.20,JPN TOP,,0,0,0,,Ия, сіз оны уақытында орындадыңыз!
Dialogue: 0,0:09:42.37,0:09:43.17,Main,,0,0,0,,Реан?!
Dialogue: 0,00:09:43.33,00:09:46.58,JPN TOP,,0,0,0,,Арық? Мен... Сен қашаннан бері жүрсің?
Dialogue: 0,0:09:43.49,0:09:45.36,Main,,0,0,0,,Қашан келдіңіз?
Dialogue: 0,0:09:45.36,0:09:47.30,Main,,0,0,0,,Сіз бұл жерде бола алмайсыз!
Dialogue: 0,00:09:46.71,00:09:48.21,JPN TOP,,0,0,0,,Жақсы емес, кел!
Dialogue: 0,0:09:47.70,0:09:50.54,Main,,0,0,0,,Менің де сенен сұрайын дегенім көп.
Dialogue: 0,00:09:48.79,00:09:51.42,JPN TOP,,0,0,0,,Менің де сізден сұрайын дегенім көп.
Dialogue: 0,0:09:50.54,0:09:53.06,Main,,0,0,0,,Бірақ алдымен бұл жерден кетуіміз керек.
Dialogue: 0,00:09:51.54,00:09:53.96,JPN TOP,,0,0,0,,Бірақ алдымен бұл жерден кетейік.
Dialogue: 0,0:09:55.13,0:09:56.90,Main,,0,0,0,,Келіңіздер. Бұл жолмен.
Dialogue: 0,00:09:56.22,00:09:58.18,JPN TOP,,0,0,0,,Жүр, осы жаққа!
Dialogue: 0,0:09:58.11,0:09:59.04,Italics,,0,0,0,,Фуши...
Dialogue: 0,00:09:59.18,00:10:00.30,JPN TOP,,0,0,0,,Фуши…
Dialogue: 0,00:10:00.43,00:10:01.68,JPN TOP,,0,0,0,,(соққы дыбысы)
Dialogue: 0,00:10:01.80,00:10:03.68,JPN TOP,,0,0,0,,Қақпақ
Dialogue: 0,0:10:03.05,0:10:04.31,Main,,0,0,0,,Ол құлап жатыр!
Dialogue: 0,00:10:03.81,00:10:05.60,JPN TOP,,0,0,0,,Бөліну
Dialogue: 0,0:10:04.65,0:10:05.62,Main,,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,00:10:05.73,00:10:06.68,JPN TOP,,0,0,0,,Жүгірейік!
Dialogue: 0,00:10:07.56,00:10:08.94,JPN TOP,,0,0,0,,(Екі адам ауыр тыныс алуда)
Dialogue: 0,00:10:17.40,00:10:20.41,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:10:24.03,0:10:26.79,Main,,0,0,0,,Бұл шаң бұлт не?
Dialogue: 0,00:10:25.04,00:10:27.71,JPN TOP,,0,0,0,,Бұл шаң бұлт не?
Dialogue: 0,0:10:27.12,0:10:29.50,Main,,0,0,0,,Менде бұл туралы жағымсыз сезім бар.
Dialogue: 0,00:10:28.25,00:10:30.54,JPN TOP,,0,0,0,,Менің кеудем дүрсілдеп тұр.
Dialogue: 0,00:10:32.75,00:10:37.13,JPN TOP,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,00:10:37.26,00:10:39.30,JPN TOP,,0,0,0,,Я...
Dialogue: 0,00:10:40.26,00:10:43.47,JPN TOP,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,00:10:43.60,00:10:46.14,JPN TOP,,0,0,0,,Мм... Уф.
Dialogue: 0,00:10:46.81,00:10:48.14,JPN TOP,,0,0,0,,Фу
Dialogue: 0,00:10:48.77,00:10:52.27,JPN TOP,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,00:10:48.98,00:10:52.27,JPN TOP,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:10:52.07,0:10:53.71,Main,,0,0,0,,Гугу...
Dialogue: 0,00:10:53.19,00:10:55.52,JPN TOP,,0,0,0,,Жақсы…
Dialogue: 0,00:10:59.07,00:11:01.03,JPN TOP,,0,0,0,,Ах, білсін деп айтайын, біз ағалы-сіңліміз, сондықтан бұл шын мәнінде…
Dialogue: 0,00:11:07.45,00:11:10.58,JPN TOP,,0,0,0,,Уф... уф...
Dialogue: 0,00:11:11.92,00:11:16.38,JPN TOP,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:11:15.69,0:11:19.48,Main,,0,0,0,,Бұл менің ауруым емес.
Dialogue: 0,00:11:16.50,00:11:18.09,JPN TOP,,0,0,0,,Бұл...
Dialogue: 0,00:11:18.63,00:11:20.38,JPN TOP,,0,0,0,,Бұл менің ауруым емес
Dialogue: 0,0:11:19.97,0:11:21.70,Main,,0,0,0,,Эй, бұл не?
Dialogue: 0,00:11:20.51,00:11:22.55,JPN TOP,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,00:11:21.09,00:11:22.55,JPN TOP,,0,0,0,,Эй, бұл не?
Dialogue: 0,0:11:21.70,0:11:22.75,Main,,0,0,0,,Бұл жаман.
Dialogue: 0,00:11:22.55,00:11:23.64,JPN TOP,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,00:11:22.68,00:11:23.64,JPN TOP,,0,0,0,,Бұл қауіпті!
Dialogue: 0,0:11:22.99,0:11:24.65,Main,,0,0,0,,Қызымыз қайда?
Dialogue: 0,00:11:23.76,00:11:25.47,JPN TOP,,0,0,0,,Эй, мына бала ше?
Dialogue: 0,0:11:24.65,0:11:25.49,Main,,0,0,0,,Реан...
Dialogue: 0,00:11:25.60,00:11:26.39,JPN TOP,,0,0,0,,Арық?
Dialogue: 0,0:11:26.15,0:11:27.46,Main,,0,0,0,,Реан!
Dialogue: 0,00:11:27.26,00:11:28.56,JPN TOP,,0,0,0,,Арық!
Dialogue: 0,0:11:36.73,0:11:40.34,Main,,0,0,0,,А-Сенде бәрі жақсы ма, Реан?
Dialogue: 0,00:11:37.73,00:11:41.45,JPN TOP,,0,0,0,,Бұл... Жақсысың ба, Линна?
Dialogue: 0,0:11:42.24,0:11:43.23,Main,,0,0,0,,Оқу, оқу
Dialogue: 0,00:11:43.28,00:11:44.41,JPN TOP,,0,0,0,,Иә
Dialogue: 0,00:11:47.54,00:11:48.91,JPN TOP,,0,0,0,,Уф...
Dialogue: 0,00:11:50.29,00:11:51.58,JPN TOP,,0,0,0,,(Көрермен) Мен оны мінген күйдегі шайқасқа дейін қызықты жігіт деп ойладым…
Dialogue: 0,0:11:52.54,0:11:54.97,Main,,0,0,0,,Мен асығуым керек.
Dialogue: 0,00:11:53.62,00:11:55.88,JPN TOP,,0,0,0,,Егер сіз асықпасаңыз...
Dialogue: 0,00:11:56.46,00:11:58.34,JPN TOP,,0,0,0,,(соққы дыбысы)
Dialogue: 0,00:12:00.46,00:12:01.88,JPN TOP,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:12:00.92,0:12:03.44,Main,,0,0,0,,Сыртта өте шулы.
Dialogue: 0,00:12:02.01,00:12:04.34,JPN TOP,,0,0,0,,Сыртта шу.
Dialogue: 0,0:12:04.10,0:12:07.18,Main,,0,0,0,,I-Ол ауыр емес пе?
Dialogue: 0,00:12:05.18,00:12:08.47,JPN TOP,,0,0,0,,Ой... ауыр екен ғой?
Dialogue: 0,0:12:07.52,0:12:10.20,Main,,0,0,0,,Жоқ. Бұл соншалықты жаман емес.
Dialogue: 0,00:12:08.60,00:12:11.31,JPN TOP,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:12:10.96,0:12:12.38,Main,,0,0,0,,Демалу.
Dialogue: 0,00:12:12.06,00:12:15.10,JPN TOP,,0,0,0,,Уайымдамаңыз... Жақында көмек келеді...
Dialogue: 0,0:12:12.38,0:12:16.07,Main,,0,0,0,,Көмек... жолда.
Dialogue: 0,00:12:15.98,00:12:17.15,JPN TOP,,0,0,0,,Мен келемін
Dialogue: 0,0:12:17.07,0:12:18.21,Main,,0,0,0,,Гугу...
Dialogue: 0,00:12:18.15,00:12:21.36,JPN TOP,,0,0,0,,Гоу, өзіңді қатты итерме.
Dialogue: 0,0:12:18.86,0:12:20.17,Main,,0,0,0,,Мұны істеудің қажеті жоқ.
Dialogue: 0,0:12:20.97,0:12:23.67,Main,,0,0,0,,Th-Гүл...
Dialogue: 0,00:12:22.11,00:12:24.86,JPN TOP,,0,0,0,,бұл... гүлдер...
Dialogue: 0,00:12:25.53,00:12:26.37,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,00:12:27.32,00:12:28.28,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,00:12:29.16,00:12:31.12,JPN TOP,,0,0,0,,Куу... hmph
Dialogue: 0,00:12:32.00,00:12:33.08,JPN TOP,,0,0,0,,Уау
Dialogue: 0,0:12:32.51,0:12:36.98,Main,,0,0,0,,Мен... ертең саған жаңасын сатып аламын.
Dialogue: 0,00:12:33.62,00:12:38.04,JPN TOP,,0,0,0,,Ах... Ертең тағы сатып аламын.
Dialogue: 0,0:12:37.75,0:12:40.22,Main,,0,0,0,,D-Уайымдама.
Dialogue: 0,00:12:38.84,00:12:41.30,JPN TOP,,0,0,0,,Бұл... Жарайды...
Dialogue: 0,0:12:42.06,0:12:44.03,Main,,0,0,0,,Жоқ, Гугу.
Dialogue: 0,00:12:43.17,00:12:45.22,JPN TOP,,0,0,0,,Уф, ғо
Dialogue: 0,0:12:44.77,0:12:46.89,Main,,0,0,0,,Бірге барайық.
Dialogue: 0,00:12:45.89,00:12:47.93,JPN TOP,,0,0,0,,Барайық, бірге терейік.
Dialogue: 0,00:12:48.47,00:12:51.10,JPN TOP,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:12:50.76,0:12:56.51,Main,,0,0,0,,Мен сол гүлдер өсетін бір ғана жерді білемін.
Dialogue: 0,00:12:51.81,00:12:55.64,JPN TOP,,0,0,0,,I Мына гүлдің жайқалған жері
Dialogue: 0,00:12:55.77,00:12:57.65,JPN TOP,,0,0,0,,Мен бір ғана нәрсені білемін
Dialogue: 0,0:12:57.44,0:12:59.26,Main,,0,0,0,,Сіз де солай етесіз.
Dialogue: 0,00:12:58.48,00:13:00.57,JPN TOP,,0,0,0,,Сіз мұны да білесіз бе?
Dialogue: 0,00:13:01.61,00:13:02.57,JPN TOP,,0,0,0,,Иә
Dialogue: 0,0:13:02.60,0:13:04.48,Main,,0,0,0,,Әрине.
Dialogue: 0,00:13:03.78,00:13:05.74,JPN TOP,,0,0,0,,Мочи… Рон…
Dialogue: 0,0:13:05.78,0:13:08.67,Main,,0,0,0,,W-Біз міндетті түрде барамыз.
Dialogue: 0,00:13:06.86,00:13:09.58,JPN TOP,,0,0,0,,Келейік... міндетті түрде барамыз.
Dialogue: 0,0:13:26.06,0:13:26.97,Main,,0,0,0,,Реан...
Dialogue: 0,00:13:27.18,00:13:28.18,JPN TOP,,0,0,0,,Арық
Dialogue: 0,0:13:28.40,0:13:30.04,Main,,0,0,0,,Мен сені жақсы көремін.
Dialogue: 0,00:13:29.51,00:13:31.01,JPN TOP,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,00:13:49.53,00:13:50.66,JPN TOP,,0,0,0,,Гухаа
Dialogue: 0,00:14:13.81,00:14:14.60,JPN TOP,,0,0,0,,Уф!
Dialogue: 0,00:14:14.72,00:14:17.98,JPN TOP,,0,0,0,,(Спирт түкірген дыбыс)
Dialogue: 0,00:14:18.10,00:14:22.36,JPN TOP,,0,0,0,,(тықылдау)
Dialogue: 0,00:14:22.48,00:14:25.36,JPN TOP,,0,0,0,,(тоқылдақ аяқ дыбысы)
Dialogue: 0,00:14:25.48,00:14:27.86,JPN TOP,,0,0,0,,Уф... уф...
Dialogue: 0,00:14:29.49,00:14:31.41,JPN TOP,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:14:40.63,0:14:41.70,Main,,0,0,0,,Ессіздік балалары 'ЖОҚ' жағын бөгеп, жояды
Dialogue: 0,00:14:41.79,00:14:44.04,JPN TOP,,0,0,0,,Өтірік... Өтірік!
Dialogue: 0,0:14:42.15,0:14:43.14,Main,,0,0,0,,(Тик-так, сағаттың көрсеткіштері тик-так)
Dialogue: 0,0:14:44.01,0:14:46.12,Main,,0,0,0,,Гугу өлген жоқ!
Dialogue: 0,00:14:45.17,00:14:47.17,JPN TOP,,0,0,0,,Гу Гу өлген жоқ!
Dialogue: 0,0:14:46.43,0:14:48.23,Main,,0,0,0,,Гугу өлген жоқ!
Dialogue: 0,00:14:47.30,00:14:49.59,JPN TOP,,0,0,0,,Гу Гу өлген жоқ!
Dialogue: 0,0:14:48.52,0:14:49.98,Main,,0,0,0,,Ол өлген жоқ!
Dialogue: 0,00:14:49.72,00:14:52.47,JPN TOP,,0,0,0,,Өлі емес... Өлі емес!
Dialogue: 0,0:14:50.11,0:14:51.58,Main,,0,0,0,,Ол өлген жоқ!
Dialogue: 0,0:14:51.58,0:14:52.82,Main,,0,0,0,,Ол өлген жоқ!
Dialogue: 0,00:14:52.60,00:14:55.47,JPN TOP,,0,0,0,,Өлген жоқ! Өлі емес!
Dialogue: 0,0:14:53.03,0:14:54.58,Main,,0,0,0,,Ол өлген жоқ!
Dialogue: 0,00:15:03.52,00:15:04.77,JPN TOP,,0,0,0,,Пухат
Dialogue: 0,00:15:18.62,00:15:19.83,JPN TOP,,0,0,0,,Гррр…
Dialogue: 0,0:15:49.84,0:15:50.97,Main,,0,0,0,,Ол қашып кетті.
Dialogue: 0,00:15:50.95,00:15:52.03,JPN TOP,,0,0,0,,қашып кетті
Dialogue: 0,0:15:51.86,0:15:53.88,Main,,0,0,0,,Ол шығысқа қарай жүреді.
Dialogue: 0,00:15:52.95,00:15:56.45,JPN TOP,,0,0,0,,Батысқа қарай жылжып, менің артымнан жүр
Dialogue: 0,0:15:54.26,0:15:55.33,Main,,0,0,0,,Оның соңынан жүріңіз.
Dialogue: 0,0:15:56.74,0:15:58.39,Main,,0,0,0,,Үйіндіні жылжытыңыз!
Dialogue: 0,00:15:57.79,00:15:59.50,JPN TOP,,0,0,0,,Тасты жылжытыңыз!
Dialogue: 0,0:16:00.07,0:16:02.27,Main,,0,0,0,,Сәлем! Көбірек адам жинаңыз!
Dialogue: 0,00:16:01.21,00:16:03.71,JPN TOP,,0,0,0,,Әй, көбірек адамдарды шақыр.
Dialogue: 0,0:16:02.82,0:16:03.30,Main,,0,0,0,,Иә, сэр.
Dialogue: 0,00:16:03.83,00:16:04.79,JPN TOP,,0,0,0,,Иә!
Dialogue: 0,0:16:07.41,0:16:08.51,Main,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,00:16:08.46,00:16:09.59,JPN TOP,,0,0,0,,Жарайды ма?
Dialogue: 0,0:16:09.57,0:16:14.17,Main,,0,0,0,,Ол сенің бір бөлігіңмен қашып кетті.
Dialogue: 0,00:16:10.59,00:16:15.14,JPN TOP,,0,0,0,,Бұл қашып шыққан ядроның ішінде сіздің бір бөлігіңіз бар.
Dialogue: 0,00:16:17.81,00:16:19.22,JPN TOP,,0,0,0,,Жұмсақ, ақырын...
Dialogue: 0,00:16:21.35,00:16:23.23,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,00:16:26.94,00:16:31.24,JPN TOP,,0,0,0,,(жүгірген аяқ дыбысы)
Dialogue: 0,00:16:31.36,00:16:34.24,JPN TOP,,0,0,0,,Хахаха...
Dialogue: 0,00:16:37.37,00:16:38.99,JPN TOP,,0,0,0,,Ах!
Dialogue: 0,00:16:48.92,00:16:49.88,JPN TOP,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,00:16:50.88,00:16:52.05,JPN TOP,,0,0,0,,Жарайды
Dialogue: 0,0:17:03.22,0:17:04.07,Main,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,00:17:04.27,00:17:05.27,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:17:04.89,0:17:05.98,Main,,0,0,0,,Сіз ояусыз ба?
Dialogue: 0,00:17:05.98,00:17:07.19,JPN TOP,,0,0,0,,Сіз ояндыңыз ба?
Dialogue: 0,0:17:06.90,0:17:09.49,Main,,0,0,0,,Ни-чан? Сен не істеп жатырсың?
Dialogue: 0,00:17:07.98,00:17:10.40,JPN TOP,,0,0,0,,Бауырым! Сен не істеп жатырсың?
Dialogue: 0,0:17:09.49,0:17:11.14,Main,,0,0,0,,Сіз көрмейсіз бе?
Dialogue: 0,00:17:10.52,00:17:13.86,JPN TOP,,0,0,0,,Көріп тұрсың, мен сені көтеріп жүрмін.
Dialogue: 0,0:17:11.14,0:17:12.82,Main,,0,0,0,,Мен сені алып бара жатырмын.
Dialogue: 0,0:17:13.60,0:17:16.90,Main,,0,0,0,,Сәлем! Үйге қош келдіңіз, Гугу.
Dialogue: 0,00:17:14.40,00:17:17.78,JPN TOP,,0,0,0,,Эй, Гу Гу қош келдіңіз
Dialogue: 0,0:17:17.38,0:17:20.08,Main,,0,0,0,,Бәріңіз жақсырақ сияқтысыз.
Dialogue: 0,00:17:18.41,00:17:20.99,JPN TOP,,0,0,0,,Денеңіз жақсы сияқты.
Dialogue: 0,00:17:21.12,00:17:22.58,JPN TOP,,0,0,0,,О!
Dialogue: 0,0:17:21.65,0:17:26.09,Main,,0,0,0,,Барлық жарақаттарыңыз жойылды. Сіз жаңа сияқты жақсысыз!
Dialogue: 0,00:17:22.70,00:17:26.79,JPN TOP,,0,0,0,,Барлық жарақаттар жазылады және әдемі болады!
Dialogue: 0,00:17:26.92,00:17:27.88,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:17:28.23,0:17:29.65,Main,,0,0,0,,Дұрыс айтасыз.
Dialogue: 0,00:17:29.21,00:17:30.54,JPN TOP,,0,0,0,,Бұл рас!
Dialogue: 0,0:17:29.86,0:17:31.66,Main,,0,0,0,,Сен кереметсің, Гугу!
Dialogue: 0,00:17:30.67,00:17:32.55,JPN TOP,,0,0,0,,Керемет Гу Гу!
Dialogue: 0,0:17:32.36,0:17:33.41,Main,,0,0,0,,Реан.
Dialogue: 0,00:17:33.38,00:17:34.51,JPN TOP,,0,0,0,,Арық
Dialogue: 0,0:17:34.29,0:17:37.65,Main,,0,0,0,,Енді уәдеңде тұруың керек.
Dialogue: 0,00:17:35.38,00:17:38.72,JPN TOP,,0,0,0,,Келіңіздер! Өтінемін, маған берген уәдеңді орында
Dialogue: 0,0:17:38.13,0:17:40.85,Main,,0,0,0,,Біз бірге гүл теруге барамыз.
Dialogue: 0,00:17:39.26,00:17:41.89,JPN TOP,,0,0,0,,Мен қазір сендермен бірге гүл теруге барамын.
Dialogue: 0,0:17:41.82,0:17:42.63,Main,,0,0,0,,Алдымен, ортаңғы және көрсеткі саусақтарыңызды осылайша қосыңыз,
Dialogue: 0,00:17:42.89,00:17:43.85,JPN TOP,,0,0,0,,Иә!
Dialogue: 0,0:17:46.39,0:17:47.20,Main,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,00:17:47.44,00:17:48.40,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:17:48.18,0:17:49.73,Main,,0,0,0,,Жауға не болды?
Dialogue: 0,00:17:49.27,00:17:51.11,JPN TOP,,0,0,0,,Жауға не болды?
Dialogue: 0,0:17:50.16,0:17:52.53,Main,,0,0,0,,Біз бұл үлкен нәрсені түсірдік пе?
Dialogue: 0,00:17:51.23,00:17:53.57,JPN TOP,,0,0,0,,Сол үлкен жігітті жеңдің бе?
Dialogue: 0,0:17:53.09,0:17:54.29,Main,,0,0,0,,Фуши қайда?
Dialogue: 0,00:17:54.19,00:17:56.53,JPN TOP,,0,0,0,,Фуши ше? Ол қайда?
Dialogue: 0,0:17:54.29,0:17:55.64,Main,,0,0,0,,Ол қайда?
Dialogue: 0,00:18:26.68,00:18:29.56,JPN TOP,,0,0,0,,А... Түсіндім...
Dialogue: 0,0:18:27.33,0:18:28.66,Italics,,0,0,0,,Б... бір сызық
Dialogue: 0,0:18:44.69,0:18:47.60,Main,,0,0,0,,Сен шынымен кетесің бе, Фуси?
Dialogue: 0,00:18:45.66,00:18:48.50,JPN TOP,,0,0,0,,Сен шынымен кетесің бе, Фуси?
Dialogue: 0,0:18:48.15,0:18:48.93,Main,,0,0,0,,Оқу, оқу
Dialogue: 0,00:18:49.21,00:18:50.42,JPN TOP,,0,0,0,,Иә
Dialogue: 0,0:18:49.73,0:18:52.41,Main,,0,0,0,,Бұлай асықпау керек.
Dialogue: 0,00:18:50.54,00:18:53.29,JPN TOP,,0,0,0,,Ештеңе Сіз сонша асығыс болсаңыз да...
Dialogue: 0,0:18:52.77,0:18:55.05,Main,,0,0,0,,Жау маған келеді.
Dialogue: 0,00:18:53.92,00:18:56.21,JPN TOP,,0,0,0,,Маған жау келеді
Dialogue: 0,0:18:55.68,0:18:58.72,Main,,0,0,0,,Мен үшін өзгенің өлгенін қаламаймын.
Dialogue: 0,00:18:56.76,00:18:59.80,JPN TOP,,0,0,0,,Мен үшін ешкімнің өлгенін қаламаймын.
Dialogue: 0,00:18:59.93,00:19:01.30,JPN TOP,,0,0,0,,Хмм...
Dialogue: 0,0:19:01.35,0:19:05.04,Main,,0,0,0,,Шин қазірден бастап көмектесемін дейді.
Dialogue: 0,00:19:02.47,00:19:05.97,JPN TOP,,0,0,0,,Қалғанына Шин маған көмектеседі.
Dialogue: 0,0:19:05.04,0:19:05.92,Main,,0,0,0,,Тек сен ғана, Хиёри-чан, осы жаққа келуге рұқсат
Dialogue: 0,00:19:06.10,00:19:09.73,JPN TOP,,0,0,0,,Сонымен... мен кетсем де болады
Dialogue: 0,0:19:06.37,0:19:08.84,Main,,0,0,0,,Менсіз жақсы боласыз.
Dialogue: 0,0:19:08.84,0:19:10.50,Main,,0,0,0,,Шин-сан, уақыт келді.
Dialogue: 0,00:19:09.89,00:19:11.40,JPN TOP,,0,0,0,,Шин мырза, уақыт келді.
Dialogue: 0,0:19:10.50,0:19:11.43,Main,,0,0,0,,Дұрыс.
Dialogue: 0,00:19:11.52,00:19:12.31,JPN TOP,,0,0,0,,О
Dialogue: 0,00:19:12.48,00:19:14.31,JPN TOP,,0,0,0,,Олай болса, өтінемін.
Dialogue: 0,0:19:13.66,0:19:15.31,Main,,0,0,0,,Сіз буға пісірілген тоқаштарды көп сатып алдыңыз.
Dialogue: 0,00:19:14.44,00:19:16.19,JPN TOP,,0,0,0,,Мен қанша тоқаш сатып алдым.
Dialogue: 0,0:19:15.31,0:19:17.05,Main,,0,0,0,,Оларды қайда апарып жатырсың?
Dialogue: 0,00:19:16.32,00:19:17.94,JPN TOP,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:19:17.05,0:19:18.68,Main,,0,0,0,,Менің бала ініме.
Dialogue: 0,00:19:18.07,00:19:19.57,JPN TOP,,0,0,0,,Бұл менің ағамның орны.
Dialogue: 0,0:19:18.68,0:19:21.36,Main,,0,0,0,,Осының бәрін ініңіз жейді дейсіз бе?
Dialogue: 0,00:19:19.70,00:19:22.24,JPN TOP,,0,0,0,,Жоқ... мұның бәрі сенің ағаң болды ма?
Dialogue: 0,0:19:21.97,0:19:23.92,Main,,0,0,0,,Иә. Ол сөзсіз.
Dialogue: 0,00:19:22.99,00:19:24.99,JPN TOP,,0,0,0,,О, мен оны жеймін.
Dialogue: 0,0:19:24.43,0:19:26.85,Main,,0,0,0,,Ол менен үлкенірек.
Dialogue: 0,00:19:25.53,00:19:28.20,JPN TOP,,0,0,0,,Ол менен үлкен.
Dialogue: 0,00:19:28.95,00:19:30.25,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,00:19:30.37,00:19:31.50,JPN TOP,,0,0,0,,Ha
Dialogue: 0,0:19:30.82,0:19:31.92,Main,,0,0,0,,Гугу...
Dialogue: 0,00:19:31.62,00:19:33.25,JPN TOP,,0,0,0,,Goo Goo!
Dialogue: 0,0:19:33.33,0:19:34.61,Main,,0,0,0,,Реан-сама!
Dialogue: 0,00:19:33.38,00:19:35.50,JPN TOP,,0,0,0,,А... Лин-сама?
Dialogue: 0,00:19:35.63,00:19:38.26,JPN TOP,,0,0,0,,(Лайнның ауыр тыныс алуы)
Dialogue: 0,0:19:37.33,0:19:40.10,Main,,0,0,0,,Мен түс көрдім.
Dialogue: 0,00:19:38.38,00:19:41.01,JPN TOP,,0,0,0,,Мен түс көрдім
Dialogue: 0,0:19:40.59,0:19:42.36,Main,,0,0,0,,Бұл таза бақыт еді.
Dialogue: 0,00:19:41.13,00:19:45.43,JPN TOP,,0,0,0,,Бақыттың өзі идеал болды
Dialogue: 0,0:19:42.36,0:19:44.25,Main,,0,0,0,,Сіз қалағанның бәрі.
Dialogue: 0,0:19:45.05,0:19:46.80,Main,,0,0,0,,Бірақ бірдеңе жетіспеді.
Dialogue: 0,00:19:46.14,00:19:47.93,JPN TOP,,0,0,0,,Бірақ бірдеңе жетіспеді.
Dialogue: 0,0:19:47.54,0:19:51.29,Main,,0,0,0,,Мен бұл менің шынайы болмысым екенін түсіндім.
Dialogue: 0,00:19:48.60,00:19:52.35,JPN TOP,,0,0,0,,Мен бұл менің шынайы болмысым екенін түсіндім.
Dialogue: 0,0:19:54.83,0:19:59.42,Main,,0,0,0,,Фуши, менде өкініш жоқ, жарай ма?
Dialogue: 0,00:19:55.94,00:20:00.53,JPN TOP,,0,0,0,,Фуши Менде еш өкініш жоқ.
Dialogue: 0,00:20:08.16,00:20:09.41,JPN TOP,,0,0,0,,Ах!
Dialogue: 0,0:20:08.95,0:20:10.38,Main,,0,0,0,,Не болды, Фуши?
Dialogue: 0,00:20:10.08,00:20:11.29,JPN TOP,,0,0,0,,Не болды, Фуши?
Dialogue: 0,0:20:13.12,0:20:14.15,Main,,0,0,0,,О, жоқ...
Dialogue: 0,00:20:13.92,00:20:16.79,JPN TOP,,0,0,0,,Бұл фигураны не істеуім керек...
Dialogue: 0,0:20:14.45,0:20:15.89,Main,,0,0,0,,Мен бұл формада бола алмаймын.
Dialogue: 0,0:20:15.89,0:20:18.40,Main,,0,0,0,,О, жоқ. О, жоқ. О, жоқ...
Dialogue: 0,00:20:16.92,00:20:20.38,JPN TOP,,0,0,0,,Мен не істеуім керек? Не істеуім керек? Не істеуім керек?
Dialogue: 0,0:20:20.88,0:20:21.91,Main,,0,0,0,,Гугу!
Dialogue: 0,00:20:21.88,00:20:22.80,JPN TOP,,0,0,0,,Жарайсың!
Dialogue: 0,0:20:26.90,0:20:29.96,Main,,0,0,0,,Құдайға шүкір. Сенде бәрі жақсы.
Dialogue: 0,00:20:27.89,00:20:31.02,JPN TOP,,0,0,0,,Мен қуаныштымын... сен амансың!
Dialogue: 0,0:20:31.62,0:20:34.01,Main,,0,0,0,,Гугу, мен сені жақсы көремін.
Dialogue: 0,00:20:32.64,00:20:35.19,JPN TOP,,0,0,0,,Мен Гу Гуды жақсы көремін!
Dialogue: 0,0:20:42.17,0:20:45.48,Italics,,0,0,0,,Мен неге менмін?
Dialogue: 0,00:20:43.20,00:20:46.82,JPN TOP,,0,0,0,,Мен неге менмін?
Dialogue: 0,00:20:49.03,00:20:52.41,JPN TOP,,0,0,0,,Иә? Жақсысың ба, Гу Гу?
Dialogue: 0,0:20:49.05,0:20:51.17,Main,,0,0,0,,Сенде бәрі жақсы ма, Гугу?
Dialogue: 0,0:20:52.65,0:20:54.88,Main,,0,0,0,,И-Иә, менде бәрі жақсы.
Dialogue: 0,00:20:53.75,00:20:55.79,JPN TOP,,0,0,0,,Иә, бәрібір
Dialogue: 0,0:20:57.23,0:20:59.65,Main,,0,0,0,,О, иә! Фуши-сан қайда?
Dialogue: 0,00:20:57.92,00:21:01.80,JPN TOP,,0,0,0,,Иә, Фуши мырза? Бар, иә?
Dialogue: 0,0:20:59.65,0:21:00.89,Main,,0,0,0,,Ол осында, солай емес пе?
Dialogue: 0,0:21:02.55,0:21:04.76,Main,,0,0,0,,Фуши қайтыс болды.
Dialogue: 0,00:21:03.59,00:21:06.13,JPN TOP,,0,0,0,,Фуши... өлді.
Dialogue: 0,00:21:06.26,00:21:07.26,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:21:08.56,0:21:09.60,Main,,0,0,0,,Ессіздік балалары 'ЖОҚ' жағын бөгеп, жояды
Dialogue: 0,00:21:09.64,00:21:12.85,JPN TOP,,0,0,0,,Бұл өтірік... Солай болуы керек...
Dialogue: 0,0:21:10.25,0:21:11.69,Main,,0,0,0,,Бұл мүмкін емес...
Dialogue: 0,0:21:20.90,0:21:23.32,Main,,0,0,0,,Көрдіңіз бе? Бұл оның моласы.
Dialogue: 0,00:21:21.53,00:21:24.40,JPN TOP,,0,0,0,,Қараңдаршы, мынау қабір.
Dialogue: 0,0:21:27.97,0:21:34.87,Main,,0,0,0,,Ол сондай батыл, тамаша адам еді.
Dialogue: 0,00:21:29.03,00:21:32.83,JPN TOP,,0,0,0,,Ол өте... батыл...
Dialogue: 0,00:21:34.00,00:21:35.91,JPN TOP,,0,0,0,,Ол керемет адам еді.
Dialogue: 0,00:21:39.04,00:21:42.42,JPN TOP,,0,0,0,,(Леннің айқайы)
Dialogue: 0,0:21:44.70,0:21:48.74,Main,,0,0,0,,Енді, Гугу, біз оған қамқор боламыз.
Dialogue: 0,00:21:45.84,00:21:49.80,JPN TOP,,0,0,0,,Жүр, Гу Гу, қалғанын бізге қалдыр.
Dialogue: 0,0:21:48.74,0:21:51.50,Main,,0,0,0,,Сізге бару керек емес пе?
Dialogue: 0,00:21:49.93,00:21:52.39,JPN TOP,,0,0,0,,Менің жақында баруым керек шығар?
Dialogue: 0,0:21:52.04,0:21:54.50,Main,,0,0,0,,О-О... Иә.
Dialogue: 0,00:21:53.18,00:21:55.39,JPN TOP,,0,0,0,,Ах... иә
Dialogue: 0,0:21:54.67,0:21:55.85,Main,,0,0,0,,Дұрыс айтасыз.
Dialogue: 0,00:21:55.52,00:21:56.94,JPN TOP,,0,0,0,,Бұл болды
Dialogue: 0,0:21:57.40,0:21:58.56,Main,,0,0,0,,Жер
Dialogue: 0,0:21:58.56,0:21:59.75,Main,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,00:21:58.56,00:22:00.65,JPN TOP,,0,0,0,,Не? Қайда бара жатырсың?
Dialogue: 0,0:22:00.18,0:22:01.24,Main,,0,0,0,,Олар дәл қашан осы үйдің бір бөлігіне айналды?
Dialogue: 0,00:22:01.23,00:22:04.15,JPN TOP,,0,0,0,,Мм... аа, шоппинг.
Dialogue: 0,0:22:01.99,0:22:03.25,Main,,0,0,0,,Сауда.
Dialogue: 0,0:22:03.89,0:22:05.66,Main,,0,0,0,,Мен сенімен бірге келемін.
Dialogue: 0,00:22:05.19,00:22:07.65,JPN TOP,,0,0,0,,Мен де барамын! Мен саған көмектесемін
Dialogue: 0,0:22:05.66,0:22:06.77,Main,,0,0,0,,Мен көмектесемін.
Dialogue: 0,0:22:07.02,0:22:09.39,Main,,0,0,0,,Ол өздігінен жүре алады.
Dialogue: 0,00:22:07.78,00:22:10.24,JPN TOP,,0,0,0,,Жалғыз болған дұрыс
Dialogue: 0,0:22:09.39,0:22:12.04,Main,,0,0,0,,Кейін кездескенше, Реан.
Dialogue: 0,00:22:10.37,00:22:13.16,JPN TOP,,0,0,0,,Lean See you later
Dialogue: 0,0:22:14.94,0:22:16.58,Main,,0,0,0,,О-Окей.
Dialogue: 0,00:22:16.04,00:22:19.04,JPN TOP,,0,0,0,,Олай болса... Сосын қайтып келгенде...
Dialogue: 0,0:22:16.58,0:22:20.78,Main,,0,0,0,,Сен қайтқанда гүл теруге барайық.
Dialogue: 0,00:22:19.79,00:22:21.96,JPN TOP,,0,0,0,,Гүлдерді бірге терейік
Dialogue: 0,0:22:21.13,0:22:22.99,Main,,0,0,0,,Біз уәде еткен жерде орындаймыз.
Dialogue: 0,00:22:22.09,00:22:24.21,JPN TOP,,0,0,0,,Біз уәде еткен жерде!
Dialogue: 0,0:22:24.55,0:22:27.77,Main,,0,0,0,,Мен сонда күтемін.
Dialogue: 0,00:22:25.63,00:22:28.88,JPN TOP,,0,0,0,,Мен алға барып, күтемін.
Dialogue: 0,0:22:29.58,0:22:31.98,Main,,0,0,0,,Есеп бер.
Dialogue: 0,00:22:30.68,00:22:33.06,JPN TOP,,0,0,0,,Ух... иә
Dialogue: 0,0:22:32.69,0:22:34.17,Main,,0,0,0,,Yay!
Dialogue: 0,00:22:33.81,00:22:36.52,JPN TOP,,0,0,0,,Yay! Мен сені күттім!
Dialogue: 0,0:22:34.17,0:22:35.62,Main,,0,0,0,,Мен сені сонда көремін.
Dialogue: 0,0:22:36.91,0:22:38.77,Main,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,00:22:37.98,00:22:39.64,JPN TOP,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:22:38.77,0:22:41.71,Main,,0,0,0,,Мен сізге бір нәрсені қайтаруым керек.
Dialogue: 0,00:22:39.77,00:22:42.61,JPN TOP,,0,0,0,,Саған қайтып оралуым керек еді.
Dialogue: 0,0:22:42.31,0:22:43.71,Main,,0,0,0,,Жер
Dialogue: 0,00:22:43.36,00:22:46.82,JPN TOP,,0,0,0,,Иә, бұл... Мен оны ағамнан алдым.
Dialogue: 0,0:22:43.71,0:22:45.93,Main,,0,0,0,,Оны ағаң маған қалдырды.
Dialogue: 0,0:22:45.93,0:22:47.43,Main,,0,0,0,,Естеріңізде, солай емес пе?
Dialogue: 0,00:22:46.94,00:22:48.32,JPN TOP,,0,0,0,,Есіңде ме?
Dialogue: 0,0:22:47.62,0:22:48.74,Main,,0,0,0,,Шекара сызықтары?
Dialogue: 0,00:22:48.45,00:22:49.82,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:22:50.04,0:22:51.83,Main,,0,0,0,,Сен оны ұста, Реан.
Dialogue: 0,00:22:51.16,00:22:54.37,JPN TOP,,0,0,0,,Lean-де бұл бар және ол жақсырақ...
Dialogue: 0,0:22:51.83,0:22:53.46,Main,,0,0,0,,Бұл Гуды есте сақтауға көмектеседі
Dialogue: 0,0:22:53.88,0:22:56.68,Main,,0,0,0,,Бұл мені есте сақтауға көмектеседі.
Dialogue: 0,00:22:54.99,00:22:57.58,JPN TOP,,0,0,0,,Сіз мені есіңе түсіресіз, солай ма?
Dialogue: 0,0:22:58.54,0:23:00.77,Main,,0,0,0,,Okay. Мен оны бағалаймын.
Dialogue: 0,00:22:59.62,00:23:03.04,JPN TOP,,0,0,0,,Иә! I'm happy thank you
Dialogue: 0,0:23:00.77,0:23:01.94,Main,,0,0,0,,Кел де жуынып ал.
Dialogue: 0,0:23:02.70,0:23:06.11,Main,,0,0,0,,Енді, Гугу, мынаны ал.
Dialogue: 0,00:23:03.71,00:23:07.17,JPN TOP,,0,0,0,,Жүр, Гу Гу, мынаны ал.
Dialogue: 0,0:23:07.61,0:23:10.89,Main,,0,0,0,,Бұл көп емес, бірақ бұл тамақ пен ақша.
Dialogue: 0,00:23:08.76,00:23:11.93,JPN TOP,,0,0,0,,Бұл көп емес, бірақ бұл тамақ пен ақша.
Dialogue: 0,0:23:12.90,0:23:14.69,Main,,0,0,0,,Абайлаңыз.
Dialogue: 0,00:23:13.93,00:23:15.60,JPN TOP,,0,0,0,,Абайлаңыз
Dialogue: 0,0:23:17.16,0:23:18.14,Main,,0,0,0,,Хиёри, қош келдің.
Dialogue: 0,00:23:18.23,00:23:19.31,JPN TOP,,0,0,0,,Рахмет
Dialogue: 0,0:23:39.21,0:23:40.48,Main,,0,0,0,,Rean!
Dialogue: 0,00:23:40.29,00:23:41.54,JPN TOP,,0,0,0,,Lean!
Dialogue: 0,0:23:41.36,0:23:43.98,Main,,0,0,0,,Реан! Біз сені барлық жерден іздедік.
Dialogue: 0,00:23:42.54,00:23:44.88,JPN TOP,,0,0,0,,Лиан, мен көптен бері іздеп жүрмін.
Dialogue: 0,0:23:44.78,0:23:46.16,Main,,0,0,0,,Honestly...
Dialogue: 0,00:23:45.92,00:23:47.09,JPN TOP,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:23:46.16,0:23:50.53,Main,,0,0,0,,Ақырында ояндың, міне, түнде өте кеш.
Dialogue: 0,00:23:47.21,00:23:48.71,JPN TOP,,0,0,0,,Мен ақыры ояндым деп ойлаған кезде
Dialogue: 0,00:23:48.84,00:23:51.47,JPN TOP,,0,0,0,,Түннің бір уағына дейін осындай жерде...
Dialogue: 0,0:23:50.53,0:23:52.44,Main,,0,0,0,,Сіз ауырып қаласыз.
Dialogue: 0,00:23:51.59,00:23:53.34,JPN TOP,,0,0,0,,Бұл сіздің денеңізге зиян емес пе?
Dialogue: 0,0:23:53.06,0:23:54.57,Main,,0,0,0,,Енді үйге қайтайық.
Dialogue: 0,00:23:54.14,00:23:55.64,JPN TOP,,0,0,0,,Жүр, үйге қайтайық.
Dialogue: 0,0:23:55.65,0:23:57.95,Main,,0,0,0,,Әке, мен...
Dialogue: 0,00:23:56.72,00:23:58.85,JPN TOP,,0,0,0,,Әке, бұл мен...
Dialogue: 0,0:23:58.84,0:24:00.96,Main,,0,0,0,,Мен үйленбеймін.
Dialogue: 0,00:23:59.81,00:24:02.10,JPN TOP,,0,0,0,,Мен үйленуді тоқтатамын.
Dialogue: 0,0:24:03.41,0:24:05.26,Main,,0,0,0,,Мен біреуге ғашықпын.
Dialogue: 0,00:24:04.44,00:24:06.27,JPN TOP,,0,0,0,,Мен өзіме ұнайтын адамды таптым
Dialogue: 0,0:24:08.17,0:24:09.76,Main,,0,0,0,,Сіз ғашықсыз ба?
Dialogue: 0,00:24:09.23,00:24:10.82,JPN TOP,,0,0,0,,Сізге кім ұнайды?
Dialogue: 0,0:24:10.44,0:24:13.46,Main,,0,0,0,,Кіммен? Онымен бірден кездесуге рұқсат етіңіз.
Dialogue: 0,00:24:11.53,00:24:14.36,JPN TOP,,0,0,0,,Бұл кім? тезірек көруге рұқсат етіңіз
Dialogue: 0,0:24:14.67,0:24:15.93,Main,,0,0,0,,Бұл ...
Dialogue: 0,00:24:15.74,00:24:17.08,JPN TOP,,0,0,0,,Бұл...
Dialogue: 0,0:24:17.19,0:24:19.31,Main,,0,0,0,,Ол енді мұнда жоқ.
Dialogue: 0,00:24:18.20,00:24:20.33,JPN TOP,,0,0,0,,Мен енді мұнда емеспін
Dialogue: 0,00:24:21.58,00:24:22.37,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:24:23.59,0:24:27.79,Main,,0,0,0,,Оның қасында екеніне сенімдімін.
Dialogue: 0,00:24:24.67,00:24:25.88,JPN TOP,,0,0,0,,(Ватару) Ой, расымен бе? Мен ойлағаннан кіші екен.
Dialogue: 0,00:24:26.71,00:24:28.92,JPN TOP,,0,0,0,,Мен онымен біргемін.
Dialogue: 0,0:24:29.99,0:24:51.01,sign_35245_236_Preview,,0,0,0,,Алдын ала қарау
Dialogue: 0,0:24:31.86,0:24:39.49,Narration,,0,0,0,,Құдіретті күш одан дәрменсіз алынған өмір мен естеліктер.
Dialogue: 0,00:24:32.97,00:24:35.34,JPN TOP,,0,0,0,,Ұлы державаның алдында
Dialogue: 0,00:24:35.93,00:24:40.39,JPN TOP,,0,0,0,,Көмексіз алынған өмір мен есте сақтау
Dialogue: 0,0:24:40.34,0:24:44.94,Narration,,0,0,0,,Фуши қиналып, қиналған кезінде оған бір адам көмекке келеді.
Dialogue: 0,00:24:41.43,00:24:46.06,JPN TOP,,0,0,0,,Фушидің қасында уайыммен күресіп жүрген біреу болды.
Dialogue: 0,0:24:45.98,0:24:52.59,Narration,,0,0,0,,Белгілі, олар жолға шығады және оларды жаңа адамдар қарсы алады.
Dialogue: 0,00:24:47.06,00:24:50.15,JPN TOP,,0,0,0,,Жүрегінде жігермен кеткен фушилерге
