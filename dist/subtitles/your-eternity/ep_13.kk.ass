Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.07,0:00:08.81,Main,,0,0,0,,Мен неге менмін?
Dialogue: 0,00:00:06.17,00:00:09.80,JPN TOP,,0,0,0,,Мен неге менмін?
Dialogue: 0,0:00:12.01,0:00:13.17,Main,,0,0,0,,Мен алмадым...
Dialogue: 0,00:00:13.09,00:00:17.30,JPN TOP,,0,0,0,,Ештеңе... Мен ештеңе істей алмадым.
Dialogue: 0,0:00:14.50,0:00:16.27,Main,,0,0,0,,Мен ештеңе істей алмадым.
Dialogue: 0,0:00:18.68,0:00:19.73,Main,,0,0,0,,Гугу...
Dialogue: 0,00:00:19.72,00:00:22.52,JPN TOP,,0,0,0,,Кешіріңіз
Dialogue: 0,0:00:20.21,0:00:21.47,Main,,0,0,0,,Мұнда.
Dialogue: 0,0:00:24.50,0:00:26.66,Main,,0,0,0,,тым кеш.
Dialogue: 0,00:00:25.56,00:00:27.69,JPN TOP,,0,0,0,,Енді кеш қалды.
Dialogue: 0,00:00:31.69,00:00:33.90,JPN TOP,,0,0,0,,(Найзағай)
Dialogue: 0,00:00:34.03,00:00:38.78,JPN TOP,,0,0,0,,♪~
Dialogue: 0,00:01:58.91,00:02:03.87,JPN TOP,,0,0,0,,~♪
Dialogue: 0,0:02:04.41,0:02:08.33,Narration,,0,0,0,,Фушидің Боуз Манның үйінен кеткеніне төрт жарым күн болды.
Dialogue: 0,00:02:05.41,00:02:09.29,JPN TOP,,0,0,0,,Саке қарияның үйінен шыққаннан кейін төрт жарым күн өткенде.
Dialogue: 0,0:02:08.81,0:02:11.99,Narration,,0,0,0,,Фуши үнсіз жалғыз жүрді.
Dialogue: 0,00:02:09.83,00:02:12.88,JPN TOP,,0,0,0,,Фуши үнсіз жалғыз келе жатты.
Dialogue: 0,0:02:12.73,0:02:16.33,Narration,,0,0,0,,Жолда ол көптеген өрнектерді қолданып көрді.
Dialogue: 0,00:02:13.84,00:02:17.26,JPN TOP,,0,0,0,,Жолда Фуши түрлі өрнектер жасады.
Dialogue: 0,0:02:17.24,0:02:21.33,Narration,,0,0,0,,Ол өзінің эмоцияларын өңдеуге тырысуы керек.
Dialogue: 0,00:02:18.34,00:02:22.43,JPN TOP,,0,0,0,,Ол өзінің ішкі ойларымен күресуге тырысатын шығар.
Dialogue: 0,0:02:23.56,0:02:28.83,Narration,,0,0,0,,Гугудың өлімімен ол көзге көрінбейтін нәрсеге ие болған сияқты.
Dialogue: 0,00:02:24.64,00:02:26.68,JPN TOP,,0,0,0,,Гу Гу қайтыс болғаннан кейін
Dialogue: 0,00:02:26.81,00:02:30.02,JPN TOP,,0,0,0,,Көзге көрінбейтін нәрсені мен де алған сияқтымын.
Dialogue: 0,0:02:30.86,0:02:33.28,Main,,0,0,0,,Шық, қара зат.
Dialogue: 0,00:02:31.94,00:02:34.27,JPN TOP,,0,0,0,,Әй, шық, қара.
Dialogue: 0,0:02:33.81,0:02:37.06,Main,,0,0,0,,«Қара нәрсе» демекші, мені ме?
Dialogue: 0,00:02:34.82,00:02:37.94,JPN TOP,,0,0,0,,«Қара» маған қатысты ма?
Dialogue: 0,0:02:39.76,0:02:40.81,Main,,0,0,0,,Не болды?
Dialogue: 0,00:02:40.86,00:02:41.95,JPN TOP,,0,0,0,,Не?
Dialogue: 0,0:02:41.52,0:02:44.28,Main,,0,0,0,,Сіз маған бірінші рет қоңырау шалып отырсыз.
Dialogue: 0,00:02:42.57,00:02:45.45,JPN TOP,,0,0,0,,Бірінші рет шақырылуда
Dialogue: 0,0:02:44.56,0:02:48.56,Episode_Title,,0,0,0,,Жоғары көтерілуге ұмтылу
Dialogue: 0,0:02:49.12,0:02:51.81,Main,,0,0,0,,Енді мен не істеуім керек?
Dialogue: 0,00:02:50.25,00:02:53.25,JPN TOP,,0,0,0,,Енді не істеуім керек?
Dialogue: 0,0:02:52.30,0:02:54.11,Main,,0,0,0,,Алға қарай жалғастыру.
Dialogue: 0,00:02:53.38,00:02:54.96,JPN TOP,,0,0,0,,Жалғастыру
Dialogue: 0,0:02:54.11,0:02:58.95,Main,,0,0,0,,Өзіңізден алынған бөлікті қайтарып алу үшін күштірек болыңыз.
Dialogue: 0,00:02:55.09,00:03:00.13,JPN TOP,,0,0,0,,Сізден ұрланған бөлігіңізді қайтару үшін күшті болыңыз.
Dialogue: 0,0:02:59.85,0:03:02.79,Main,,0,0,0,,Не... Мен қандаймын?
Dialogue: 0,00:03:00.97,00:03:04.10,JPN TOP,,0,0,0,,Мен қандаймын... мен қандаймын?
Dialogue: 0,0:03:03.07,0:03:05.16,Main,,0,0,0,,Менен не қалайсың?
Dialogue: 0,00:03:04.22,00:03:06.06,JPN TOP,,0,0,0,,Менен не қалайсың?
Dialogue: 0,0:03:05.49,0:03:07.72,Main,,0,0,0,,Бұл мен бұрын айтқанымдай.
Dialogue: 0,00:03:06.60,00:03:09.06,JPN TOP,,0,0,0,,Мен бұрын айтқанымдай.
Dialogue: 0,0:03:08.10,0:03:14.02,Main,,0,0,0,,Сіз бұл жер туралы ақпаратты жинау және сақтау механизмісіз.
Dialogue: 0,00:03:09.18,00:03:12.40,JPN TOP,,0,0,0,,Сіз осы орын туралы ақпарат жинадыңыз.
Dialogue: 0,00:03:12.52,00:03:14.94,JPN TOP,,0,0,0,,Бұл сақтау құрылғысы.
Dialogue: 0,0:03:14.02,0:03:16.74,Main,,0,0,0,,Ал мен сені жаратқанмын.
Dialogue: 0,00:03:15.06,00:03:17.69,JPN TOP,,0,0,0,,Оны жасаған менмін.
Dialogue: 0,0:03:17.17,0:03:20.50,Main,,0,0,0,,Мен сенің ата-анаңмын.
Dialogue: 0,00:03:18.23,00:03:21.40,JPN TOP,,0,0,0,,Мен сенің ата-анаң сияқтымын, былайша айтқанда.
Dialogue: 0,0:03:20.50,0:03:23.90,Main,,0,0,0,,Жоқ. Сіз менің ата-анам емессіз.
Dialogue: 0,00:03:21.53,00:03:24.82,JPN TOP,,0,0,0,,Жоқ, сіз менің ата-анам емессіз.
Dialogue: 0,0:03:23.90,0:03:25.61,Main,,0,0,0,,My parent was...
Dialogue: 0,00:03:24.95,00:03:26.74,JPN TOP,,0,0,0,,My parents are...
Dialogue: 0,0:03:28.55,0:03:29.97,Main,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,00:03:29.70,00:03:31.16,JPN TOP,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:03:35.72,0:03:37.82,Main,,0,0,0,,Неліктен мен жалғыз тірімін?
Dialogue: 0,00:03:36.75,00:03:39.13,JPN TOP,,0,0,0,,Неге жалғыз мен ғана тірімін...
Dialogue: 0,0:03:38.25,0:03:41.61,Main,,0,0,0,,Неліктен Гугу өлуге мәжбүр болды?
Dialogue: 0,00:03:39.26,00:03:42.51,JPN TOP,,0,0,0,,Гу Гу өлуі керек пе?
Dialogue: 0,0:03:42.14,0:03:44.45,Main,,0,0,0,,Бұл жай ғана табиғаттағы айырмашылық.
Dialogue: 0,00:03:43.26,00:03:45.35,JPN TOP,,0,0,0,,Бұл тек табиғаттағы айырмашылық.
Dialogue: 0,0:03:44.93,0:03:46.62,Main,,0,0,0,,Мен сенің не айтып тұрғаныңды түсінбеймін.
Dialogue: 0,00:03:46.05,00:03:47.51,JPN TOP,,0,0,0,,Ол Киригумо-суги деп аталатын өте жеңіл ағаш түрінен жасалған
Dialogue: 0,0:03:47.15,0:03:49.62,Main,,0,0,0,,Сіз түсінуге әлі ерте.
Dialogue: 0,00:03:48.22,00:03:50.64,JPN TOP,,0,0,0,,Білуге әлі ерте
Dialogue: 0,0:03:50.20,0:03:54.35,Main,,0,0,0,,Бірақ сіз сұрақтар қоя алатыныңызға қуаныштымын.
Dialogue: 0,00:03:51.31,00:03:54.40,JPN TOP,,0,0,0,,Бірақ күмәндана бастағаныңызға қуаныштымын...
Dialogue: 0,0:03:53.74,0:03:54.92,Main,,0,0,0,,Менімен мылқау ойнама.
Dialogue: 0,00:03:54.52,00:03:56.86,JPN TOP,,0,0,0,,Алдама, бәрін айт
Dialogue: 0,0:03:54.92,0:03:55.97,Main,,0,0,0,,Маған бәрін айт!
Dialogue: 0,0:03:56.49,0:03:59.10,Main,,0,0,0,,Барлығы жойылады.
Dialogue: 0,00:03:57.57,00:04:00.03,JPN TOP,,0,0,0,,All things perish
Dialogue: 0,0:03:59.10,0:04:01.42,Main,,0,0,0,,Сондықтан сізге керек.
Dialogue: 0,00:04:00.15,00:04:02.32,JPN TOP,,0,0,0,,Сондықтан маған сен керексің
Dialogue: 0,0:04:01.70,0:04:05.52,Main,,0,0,0,,Сіз бұл әлемдегі жалғыз ерекше тұлғасыз.
Dialogue: 0,00:04:02.86,00:04:06.45,JPN TOP,,0,0,0,,Сен бұл дүниедегі жалғыз ерекше жаратылыссың.
Dialogue: 0,0:04:05.96,0:04:10.73,Main,,0,0,0,,Сол себепті дұшпандар, ноккерлер сізді басқарғысы келетін сияқты.
Dialogue: 0,00:04:06.99,00:04:11.79,JPN TOP,,0,0,0,,Жау... Нокер сізді басқарғысы келетін сияқты.
Dialogue: 0,0:04:11.24,0:04:15.35,Main,,0,0,0,,Мен болмасам, Ноккерлер келуді тоқтатады ма?
Dialogue: 0,00:04:12.33,00:04:16.25,JPN TOP,,0,0,0,,Нокер... енді мен болмасам, келмейсің бе?
Dialogue: 0,0:04:15.85,0:04:17.42,Main,,0,0,0,,Бұл жақсы болар еді.
I wish it was
Dialogue: 0,00:04:16.96,00:04:18.54,JPN TOP,,0,0,0,,...
Dialogue: 0,0:04:18.93,0:04:20.07,Main,,0,0,0,,Мен жасап көремін.
Dialogue: 0,00:04:20.00,00:04:21.38,JPN TOP,,0,0,0,,Өтіп бара жатыр, өтіп бара жатыр
Dialogue: 0,00:04:36.31,00:04:37.61,JPN TOP,,0,0,0,,Уау
Dialogue: 0,00:04:38.19,00:04:39.19,JPN TOP,,0,0,0,,Құт
Dialogue: 0,0:04:38.55,0:04:42.55,Main,,0,0,0,,Бұл форманы алу өзіңізді тастап кеткеніңізді білдірмейді.
Dialogue: 0,00:04:39.32,00:04:43.44,JPN TOP,,0,0,0,,Бұл мен сенен бас тарттым дегенді білдірмейді.
Dialogue: 0,0:04:43.09,0:04:47.29,Main,,0,0,0,,Егер сіз осы формада болған кезде Ноккерлер келсе, олар жай ғана сізбен бірге болады.
Dialogue: 0,00:04:44.11,00:04:48.20,JPN TOP,,0,0,0,,Егер осы уақыт ішінде тықыршы келсе, ол қалағанын жасайды.
Dialogue: 0,0:04:47.57,0:04:54.40,Main,,0,0,0,,Егер сіз ұтыла берсеңіз, сіз ештеңе күйіне ораласыз — шарға қайта ораласыз.
Dialogue: 0,00:04:48.32,00:04:52.33,JPN TOP,,0,0,0,,Егер сіз соққыға жығсаңыз, сіз нөлде боласыз...
Dialogue: 0,00:04:52.87,00:04:55.29,JPN TOP,,0,0,0,,Сонымен, сфераға қайта оралу
Dialogue: 0,0:04:55.14,0:04:58.72,Main,,0,0,0,,Ал сіз қазіргі күйіңізге ешқашан оралмайсыз.
Dialogue: 0,00:04:56.21,00:04:59.59,JPN TOP,,0,0,0,,Егер бұл орын алса, сіз ешқашан қазіргі күйіңізге оралмайсыз.
Dialogue: 0,0:04:58.72,0:05:00.81,Main,,0,0,0,,Сіз жасай алмайсыз.
Dialogue: 0,00:04:59.71,00:05:01.75,JPN TOP,,0,0,0,,Жоқ, мен қайта алмаймын.
Dialogue: 0,0:05:00.81,0:05:04.65,Main,,0,0,0,,Мен қарсы емес едім, бірақ сіз қарсы болатыныңызға сенімдімін.
Dialogue: 0,00:05:01.88,00:05:05.47,JPN TOP,,0,0,0,,Мен қиналмаймын, бірақ сен қиналасың.
Dialogue: 0,0:05:04.65,0:05:07.88,Main,,0,0,0,,Ендеше неге ұрыспайсың?
Dialogue: 0,00:05:05.59,00:05:08.80,JPN TOP,,0,0,0,,Осыншама көп айтайын десең, күресу керек!
Dialogue: 0,0:05:07.88,0:05:11.16,Main,,0,0,0,,Сен мені басқара алатындай күштісің, солай ма?
Dialogue: 0,00:05:08.93,00:05:12.06,JPN TOP,,0,0,0,,Сен мені жеңетіндей күштісің, солай ма?
Dialogue: 0,0:05:11.66,0:05:14.49,Main,,0,0,0,,Иә. Бұл шынымен қарапайым болар еді.
Dialogue: 0,00:05:12.77,00:05:15.39,JPN TOP,,0,0,0,,Аа, бұл әрине оңай.
Dialogue: 0,0:05:14.97,0:05:19.50,Main,,0,0,0,,Бірақ мен сіздің денеңізді басқара алсам да, ақыл-ойыңызды басқара алмаймын.
Dialogue: 0,00:05:15.98,00:05:20.57,JPN TOP,,0,0,0,,Бірақ денені басқара алсаң да, сананы басқара алмайсың.
Dialogue: 0,0:05:20.07,0:05:21.37,Main,,0,0,0,,Ноккерлер...
Dialogue: 0,00:05:21.15,00:05:22.44,JPN TOP,,0,0,0,,Тоққыш
Dialogue: 0,0:05:21.93,0:05:28.35,Main,,0,0,0,,Олардың бізді өлтіру мақсаты жойылмайынша, шабуылдар жалғаса береді.
Dialogue: 0,00:05:23.03,00:05:27.49,JPN TOP,,0,0,0,,Біз олардың «бізді өлтіру» мақсатын жоймағанша
Dialogue: 0,00:05:27.61,00:05:29.57,JPN TOP,,0,0,0,,Шабуыл жалғасуда
Dialogue: 0,0:05:28.67,0:05:32.08,Main,,0,0,0,,Оларды тоқтататын мен емес, сен боламын.
Dialogue: 0,00:05:29.70,00:05:33.04,JPN TOP,,0,0,0,,Оны мен емес, сен тоқтататынсың.
Dialogue: 0,0:05:32.78,0:05:35.10,Main,,0,0,0,,Бір күні мен бұл жерде болмаймын.
Dialogue: 0,00:05:33.58,00:05:36.37,JPN TOP,,0,0,0,,Мен бір күні жоқ боламын
Dialogue: 0,0:05:35.45,0:05:41.59,Main,,0,0,0,,Сол уақыт келгенде оларды өз бетінше жеңуге дайындалу керек.
Dialogue: 0,00:05:36.50,00:05:38.08,JPN TOP,,0,0,0,,Сол уақытқа
Dialogue: 0,00:05:38.21,00:05:42.59,JPN TOP,,0,0,0,,Жалғыз жеңе білу керек.
Dialogue: 0,0:05:42.03,0:05:46.36,Main,,0,0,0,,Сіз менің мақсатыма жетудегі маңызды қадамсыз.
Dialogue: 0,00:05:43.13,00:05:47.09,JPN TOP,,0,0,0,,Мақсатыма жетудегі маңызды баспалдақ ретінде...
Dialogue: 0,0:05:46.36,0:05:47.15,Main,,0,0,0,,Бұл сіздің проблемаңыз!
Dialogue: 0,00:05:47.22,00:05:50.01,JPN TOP,,0,0,0,,Бұл сізге байланысты! Мен бұл туралы білмеймін!
Dialogue: 0,0:05:47.60,0:05:49.10,Main,,0,0,0,,Маған бәрібір!
Dialogue: 0,00:05:51.01,00:05:52.56,JPN TOP,,0,0,0,,Ах... Уф!
Dialogue: 0,0:05:52.16,0:05:53.78,Main,,0,0,0,,Жақсы қайғы.
Dialogue: 0,00:05:53.26,00:05:57.52,JPN TOP,,0,0,0,,Әй... көп еңбекті қажет ететін нәрсеге айналды.
Dialogue: 0,0:05:53.78,0:05:56.63,Main,,0,0,0,,Сіз өте қиын болып өстіңіз.
Dialogue: 0,0:05:57.77,0:05:58.63,Main,,0,0,0,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 0,00:05:58.73,00:05:59.52,JPN TOP,,0,0,0,,Ақымақ
Dialogue: 0,0:05:59.76,0:06:02.74,Main,,0,0,0,,Гугуды ештеңе қайтара алмайды.
Dialogue: 0,00:06:00.86,00:06:03.94,JPN TOP,,0,0,0,,Қанша тырыссаң да, Гу Гу қайтып келмейді.
Dialogue: 0,0:06:03.32,0:06:05.47,Main,,0,0,0,,Сондықтан маған енді бәрібір.
Dialogue: 0,00:06:04.48,00:06:06.49,JPN TOP,,0,0,0,,Дакара Моу Маған бәрібір.
Dialogue: 0,0:06:05.94,0:06:09.18,Main,,0,0,0,,Маған не басқа біреуге не болғаны маңызды емес.
Dialogue: 0,00:06:07.07,00:06:10.07,JPN TOP,,0,0,0,,…
Dialogue: 0,0:06:09.56,0:06:12.21,Main,,0,0,0,,Are you sure about that?
Dialogue: 0,00:06:10.20,00:06:13.16,JPN TOP,,0,0,0,,...
Dialogue: 0,00:06:14.45,00:06:18.08,JPN TOP,,0,0,0,,（）
Dialogue: 0,0:06:27.53,0:06:29.45,Italics,,0,0,0,,This scent... Why?
Dialogue: 0,00:06:28.63,00:06:30.34,JPN TOP,,0,0,0,,…
Dialogue: 0,00:06:33.60,00:06:34.76,JPN TOP,,0,0,0,,...
Dialogue: 0,0:06:34.67,0:06:36.05,Main,,0,0,0,,Pioran!
Dialogue: 0,00:06:35.77,00:06:38.10,JPN TOP,,0,0,0,,...
Dialogue: 0,0:06:36.05,0:06:36.94,Main,,0,0,0,,Бір сәт те жоғалтуға болмайды.
Dialogue: 0,0:06:39.01,0:06:41.05,Main,,0,0,0,,I realized something.
Dialogue: 0,00:06:40.10,00:06:41.94,JPN TOP,,0,0,0,,...
Dialogue: 0,0:06:41.51,0:06:45.95,Main,,0,0,0,,I came to Takunaha hoping I could help you,
Dialogue: 0,00:06:42.56,00:06:46.86,JPN TOP,,0,0,0,,...
Dialogue: 0,0:06:45.95,0:06:49.43,Main,,0,0,0,,but in the end, I couldn't do anything for you,
Dialogue: 0,00:06:46.98,00:06:50.53,JPN TOP,,0,0,0,,...
Dialogue: 0,0:06:49.94,0:06:53.31,Main,,0,0,0,,so I decided to travel with you again.
Dialogue: 0,00:06:51.07,00:06:54.20,JPN TOP,,0,0,0,,...
Dialogue: 0,0:06:53.58,0:06:55.32,Main,,0,0,0,,содан кейін өзіңіз бен Фантомның арасында сызық сызып көріңіз.
Dialogue: 0,00:06:54.33,00:06:56.16,JPN TOP,,0,0,0,,… …
Dialogue: 0,0:06:55.32,0:06:57.47,Main,,0,0,0,,Wh-What about the old man and the others?
Dialogue: 0,00:06:56.29,00:06:58.37,JPN TOP,,0,0,0,,…
Dialogue: 0,0:06:57.47,0:06:59.18,Main,,0,0,0,,Не бұл, Хиёри? Жаңа жылдық әзіл ме?
Dialogue: 0,00:06:58.50,00:07:02.96,JPN TOP,,0,0,0,,...
Dialogue: 0,0:06:59.18,0:07:02.07,Main,,0,0,0,,I've told them all about what I'm doing.
Dialogue: 0,0:07:02.07,0:07:06.24,Main,,0,0,0,,Rean and Shin said they'd keep the business going for us.
Dialogue: 0,00:07:03.08,00:07:07.13,JPN TOP,,0,0,0,,...
Dialogue: 0,0:07:06.65,0:07:10.73,Main,,0,0,0,,Rean had figured out what happened to you and Gugu.
Dialogue: 0,00:07:07.76,00:07:11.63,JPN TOP,,0,0,0,,...
Dialogue: 0,0:07:10.98,0:07:15.39,Main,,0,0,0,,I think that's why she let me leave.
Dialogue: 0,00:07:11.76,00:07:16.56,JPN TOP,,0,0,0,,...
Dialogue: 0,0:07:18.80,0:07:19.97,Main,,0,0,0,,Pioran...
Dialogue: 0,00:07:19.85,00:07:20.85,JPN TOP,,0,0,0,,Пиоран
Dialogue: 0,0:07:20.89,0:07:21.91,Main,,0,0,0,,Go home.
Dialogue: 0,00:07:22.02,00:07:22.81,JPN TOP,,0,0,0,,...
Dialogue: 0,0:07:22.67,0:07:24.02,Main,,0,0,0,,Сіз қалай батылсыз?!
Dialogue: 0,00:07:22.94,00:07:24.94,JPN TOP,,0,0,0,,...
Dialogue: 0,0:07:24.02,0:07:26.93,Main,,0,0,0,,You're turning down an innocent old lady's wish?
Dialogue: 0,00:07:25.06,00:07:27.82,JPN TOP,,0,0,0,,...
Dialogue: 0,0:07:27.49,0:07:29.91,Main,,0,0,0,,You know what follows me.
Dialogue: 0,00:07:28.53,00:07:31.82,JPN TOP,,0,0,0,,...
Dialogue: 0,0:07:29.91,0:07:30.91,Main,,0,0,0,,It's dangerous.
Dialogue: 0,0:07:31.61,0:07:34.02,Main,,0,0,0,,I've thought it through.
Dialogue: 0,00:07:32.74,00:07:34.99,JPN TOP,,0,0,0,,...
Dialogue: 0,0:07:34.02,0:07:38.31,Main,,0,0,0,,How do I give meaning to what little time I have left in this life?
Dialogue: 0,00:07:35.12,00:07:39.58,JPN TOP,,0,0,0,,Қартайған кезде қысқа өмірімізге қалай мән бере аламыз?
Dialogue: 0,0:07:38.69,0:07:40.93,Main,,0,0,0,,Мен сенің таяғың боламын.
Dialogue: 0,00:07:39.70,00:07:42.12,JPN TOP,,0,0,0,,Аз ғана болса, жақсы.
Dialogue: 0,0:07:41.18,0:07:43.90,Main,,0,0,0,,Мен бір дюймдік бұтақ болсам да.
Dialogue: 0,00:07:42.25,00:07:44.79,JPN TOP,,0,0,0,,Сені қолдайтын таяқ болайық
Dialogue: 0,0:07:44.31,0:07:46.30,Main,,0,0,0,,Міне, мен мұны істегім келеді.
Dialogue: 0,00:07:45.38,00:07:47.38,JPN TOP,,0,0,0,,Мен солай ойладым.
Dialogue: 0,0:07:46.90,0:07:48.85,Main,,0,0,0,,Мен сені үйге сүйреп барамын!
Dialogue: 0,00:07:47.92,00:07:49.76,JPN TOP,,0,0,0,,Мен сені үйге апарамын О, жоқ!
Dialogue: 0,0:07:49.37,0:07:51.90,Main,,0,0,0,,Оларға сен сол үйде керексің, Пиоран!
Dialogue: 0,00:07:49.88,00:07:52.80,JPN TOP,,0,0,0,,Бұл үйге Пиоран керек!
Dialogue: 0,0:07:52.11,0:07:53.16,Main,,0,0,0,,Ой!
Dialogue: 0,00:07:52.93,00:07:54.05,JPN TOP,,0,0,0,,Ита
Dialogue: 0,00:07:54.18,00:07:56.10,JPN TOP,,0,0,0,,(Екі адам ауыр тыныс алуда)
Dialogue: 0,0:07:55.10,0:07:57.55,Main,,0,0,0,,Неге мені тыңдамайсың?
Dialogue: 0,00:07:56.22,00:07:58.43,JPN TOP,,0,0,0,,Менің айтқанымды неге тыңдамайсың?
Dialogue: 0,0:07:58.03,0:08:00.68,Main,,0,0,0,,Мен енді ешкімнің жылағанын қаламаймын.
Dialogue: 0,00:07:59.14,00:08:01.48,JPN TOP,,0,0,0,,Мен енді ешкімнің жылағанын қаламаймын.
Dialogue: 0,0:08:00.68,0:08:02.93,Main,,0,0,0,,A-Мен де оны көргім келмейді.
Dialogue: 0,00:08:01.60,00:08:03.98,JPN TOP,,0,0,0,,Мен мұны көргенді жек көремін.
Dialogue: 0,0:08:02.93,0:08:04.84,Main,,0,0,0,,Өтінемін, үйге қайт!
Dialogue: 0,00:08:04.10,00:08:07.32,JPN TOP,,0,0,0,,Ендеше үйге қайт! Мен үшін қайтып кел!
Dialogue: 0,0:08:04.84,0:08:06.42,Main,,0,0,0,,Мен үшін үйге қайт!
Dialogue: 0,0:08:06.42,0:08:07.46,Main,,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,00:08:07.44,00:08:09.73,JPN TOP,,0,0,0,,Менің өмірім шулы!
Dialogue: 0,0:08:07.46,0:08:08.87,Main,,0,0,0,,Бұл менің өмірім!
Dialogue: 0,00:08:08.27,00:08:10.78,JPN TOP,,0,0,0,,Уф, ауырып тұр...
Dialogue: 0,0:08:08.87,0:08:11.26,Main,,0,0,0,,Қалағанымды істеуге рұқсат етіңіз!
Dialogue: 0,00:08:09.86,00:08:12.07,JPN TOP,,0,0,0,,Мен қалаған нәрсені істе!
Dialogue: 0,00:08:12.20,00:08:14.74,JPN TOP,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:08:19.02,0:08:20.52,Main,,0,0,0,,Өзіңізге жарасыңыз.
Dialogue: 0,00:08:20.08,00:08:21.62,JPN TOP,,0,0,0,,Қалағаныңды істе
Dialogue: 0,0:08:29.52,0:08:30.73,Main,,0,0,0,,Міне, картоп алыңыз.
Dialogue: 0,00:08:30.25,00:08:31.63,JPN TOP,,0,0,0,,Қарашы, Имо.
Dialogue: 0,0:08:31.57,0:08:32.48,Main,,0,0,0,,Оны қаламаймын.
Dialogue: 0,00:08:32.59,00:08:33.38,JPN TOP,,0,0,0,,Бетіңде әлі де сол мұңды кейіп бар.
Dialogue: 0,0:08:42.80,0:08:44.00,Main,,0,0,0,,Міне, шай ішіңіз.
Dialogue: 0,00:08:43.60,00:08:44.89,JPN TOP,,0,0,0,,Міне, шай
Dialogue: 0,0:08:44.23,0:08:45.28,Main,,0,0,0,,Оны қаламаймын.
Dialogue: 0,00:08:45.02,00:08:46.19,JPN TOP,,0,0,0,,Бетіңде әлі де сол мұңды кейіп бар.
Dialogue: 0,0:08:46.95,0:08:48.28,Main,,0,0,0,,Міне, балық ал.
Dialogue: 0,00:08:47.81,00:08:49.19,JPN TOP,,0,0,0,,Балықты қараңыз
Dialogue: 0,0:08:48.28,0:08:49.97,Main,,0,0,0,,Мен мұны қаламаймын дедім!
Dialogue: 0,00:08:49.32,00:08:50.86,JPN TOP,,0,0,0,,Маған керек емес!
Dialogue: 0,0:08:50.34,0:08:52.10,Main,,0,0,0,,Сіз суық болуыңыз керек.
Dialogue: 0,00:08:50.98,00:08:52.99,JPN TOP,,0,0,0,,Суық...
Dialogue: 0,0:08:58.88,0:09:02.52,Main,,0,0,0,,Пиоран, маған бір нәрсеге уәде бер.
Dialogue: 0,00:08:59.95,00:09:03.37,JPN TOP,,0,0,0,,Пиолан, маған бір нәрсеге уәде бер.
Dialogue: 0,0:09:02.52,0:09:03.94,Main,,0,0,0,,түн
Dialogue: 0,00:09:03.50,00:09:04.83,JPN TOP,,0,0,0,,Не?
Dialogue: 0,0:09:04.95,0:09:06.37,Main,,0,0,0,,Өлме.
Dialogue: 0,00:09:05.96,00:09:07.38,JPN TOP,,0,0,0,,«Оқыттым» деген сөз дәл келмейді—
Dialogue: 0,00:09:10.13,00:09:11.09,JPN TOP,,0,0,0,,Хмм
Dialogue: 0,0:09:14.61,0:09:15.87,Main,,0,0,0,,Қарау.
Dialogue: 0,00:09:15.72,00:09:18.30,JPN TOP,,0,0,0,,Әй, қарашы, бұл қала.
Dialogue: 0,0:09:15.87,0:09:17.18,Main,,0,0,0,,Бұл қала.
Dialogue: 0,0:09:18.46,0:09:20.04,Main,,0,0,0,,Мен аштан өліп жатырмын.
Dialogue: 0,00:09:19.47,00:09:23.02,JPN TOP,,0,0,0,,Менің қарным ашты, енді біраз демалып алайық.
Dialogue: 0,0:09:20.04,0:09:22.28,Main,,0,0,0,,Бұл үзіліс үшін жақсы уақыт!
Dialogue: 0,00:09:23.14,00:09:24.23,JPN TOP,,0,0,0,,Жасайық
Dialogue: 0,0:09:23.66,0:09:24.83,Main,,0,0,0,,Пиоран!
Dialogue: 0,00:09:24.77,00:09:26.10,JPN TOP,,0,0,0,,Пиолан?
Dialogue: 0,00:09:26.64,00:09:28.15,JPN TOP,,0,0,0,,(кеспенің шырылдаған дыбысы)
Dialogue: 0,0:09:27.47,0:09:29.57,Main,,0,0,0,,Пиоран, кеттік.
Dialogue: 0,00:09:28.27,00:09:30.40,JPN TOP,,0,0,0,,Пиоран, тез кетейік.
Dialogue: 0,0:09:29.57,0:09:30.62,Main,,0,0,0,,Капипа
Dialogue: 0,00:09:30.52,00:09:31.44,JPN TOP,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:09:31.51,0:09:34.91,Main,,0,0,0,,Мен көптен бері тамақ жемегенмін! Дәмді!
Dialogue: 0,00:09:31.57,00:09:35.82,JPN TOP,,0,0,0,,Ка~ Мен кеспе жемегеніме көп болды. Бұл дәмді!
Dialogue: 0,0:09:35.93,0:09:40.02,Main,,0,0,0,,Бұл ауыл қайтып келсе, қорғай алмаймын.
Dialogue: 0,00:09:36.78,00:09:40.91,JPN TOP,,0,0,0,,Ол келсе, мен бұл қаланы қорғай алмаймын.
Dialogue: 0,0:09:41.57,0:09:43.84,Main,,0,0,0,,Жақсы. Маған бір секунд беріңізші.
Dialogue: 0,00:09:42.62,00:09:44.70,JPN TOP,,0,0,0,,Бұл аз ғана болды.
Dialogue: 0,0:09:43.84,0:09:45.78,Main,,0,0,0,,Эй, адам! Сізде ішімдік бар ма?
Dialogue: 0,00:09:44.83,00:09:46.62,JPN TOP,,0,0,0,,Нии-сан, сенде алкоголь бар ма?
Dialogue: 0,0:09:45.78,0:09:46.68,Main,,0,0,0,,Әрине.
Dialogue: 0,0:09:46.68,0:09:48.13,Main,,0,0,0,,Пиоран!
Dialogue: 0,00:09:46.75,00:09:47.67,JPN TOP,,0,0,0,,Мен қарсыласымды өлтіру үшін келген жоқпын
Dialogue: 0,00:09:47.79,00:09:49.04,JPN TOP,,0,0,0,,Пиоран!
Dialogue: 0,0:09:53.21,0:09:56.42,Main,,0,0,0,,Эй, ноккерлер қазір қайда?
Dialogue: 0,00:09:54.26,00:09:57.30,JPN TOP,,0,0,0,,Эй, Нокер қазір қайда?
Dialogue: 0,0:09:56.80,0:09:59.46,Main,,0,0,0,,Осы жерден солтүстік-батысқа қарай алты шақырым жерде.
Dialogue: 0,00:09:57.43,00:10:00.76,JPN TOP,,0,0,0,,Осы жерден солтүстік-батысқа қарай алты шақырым.
Dialogue: 0,0:09:59.89,0:10:04.55,Main,,0,0,0,,Мен оның соңғы төрт күннен бері қозғалғанын сезбедім, өйткені ол топыраққа батып кеткен.
Dialogue: 0,00:10:00.89,00:10:05.81,JPN TOP,,0,0,0,,Мен соңғы төрт күн бойы жер астында болдым, мен ешқандай қозғалысты сезген жоқпын.
Dialogue: 0,0:10:04.89,0:10:06.42,Main,,0,0,0,,Сезінді ме?
Dialogue: 0,00:10:05.93,00:10:07.27,JPN TOP,,0,0,0,,Сіз мұны сезінесіз бе?
Dialogue: 0,0:10:06.42,0:10:08.55,Main,,0,0,0,,Сіз әрқашан олардың қайда екенін білесіз бе?
Dialogue: 0,00:10:07.39,00:10:09.44,JPN TOP,,0,0,0,,Сіз әрқашан жаудың орналасқан жерін біле аласыз ба?
Dialogue: 0,0:10:09.02,0:10:11.91,Main,,0,0,0,,Олар денеңде жорғалап жүрген жәндіктер сияқты.
Dialogue: 0,00:10:10.02,00:10:13.15,JPN TOP,,0,0,0,,Бұл сіздің денеңізде жорғалап жүрген қате сияқты.
Dialogue: 0,0:10:12.27,0:10:15.75,Main,,0,0,0,,Сіз оларды кішкентай жұмыртқа болған кезде байқамайсыз,
Dialogue: 0,00:10:13.27,00:10:16.61,JPN TOP,,0,0,0,,Ұсақ жұмыртқа күйінде байқалмаса да
Dialogue: 0,0:10:15.75,0:10:19.56,Main,,0,0,0,,, бірақ олар жұмыртқадан шығып, қозғала бастағанда, олар қатты қолайсыздықты тудырады.
Dialogue: 0,00:10:16.74,00:10:20.45,JPN TOP,,0,0,0,,Олар жұмыртқадан шығып, қозғала бастағанда, олар өте жайсыз сезінеді.
Dialogue: 0,0:10:20.50,0:10:23.01,Main,,0,0,0,,Мен түсінетіндей түсіндіре алмайсыз ба?
Dialogue: 0,00:10:20.57,00:10:23.99,JPN TOP,,0,0,0,,Иә? Маған көбірек түсінуге көмектесіңізші.
Dialogue: 0,0:10:23.01,0:10:25.11,Main,,0,0,0,,Сіз кіммен сөйлесесіз?
Dialogue: 0,00:10:24.12,00:10:26.37,JPN TOP,,0,0,0,,Сіз кіммен сөйлеспексіз?
Dialogue: 0,0:10:25.67,0:10:27.77,Main,,0,0,0,,О, жақсы...
Dialogue: 0,00:10:26.50,00:10:28.58,JPN TOP,,0,0,0,,Ах... бұл...
Dialogue: 0,0:10:28.66,0:10:30.99,Main,,0,0,0,,Міне сенің тамағың.
Dialogue: 0,00:10:28.71,00:10:29.62,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,00:10:29.75,00:10:31.88,JPN TOP,,0,0,0,,Қара, бұл сенің тамағың.
Dialogue: 0,0:10:31.64,0:10:32.47,Main,,0,0,0,,Фуши.
Dialogue: 0,00:10:32.59,00:10:33.38,JPN TOP,,0,0,0,,Фуши
Dialogue: 0,00:10:34.00,00:10:35.38,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:10:35.23,0:10:37.07,Main,,0,0,0,,Маған кез келген нәрсені айта аласыз.
Dialogue: 0,00:10:36.30,00:10:38.30,JPN TOP,,0,0,0,,Кез келген нәрсені айтыңыз
Dialogue: 0,0:10:38.63,0:10:40.70,Main,,0,0,0,,Қара киімді адам?
Dialogue: 0,00:10:39.63,00:10:41.59,JPN TOP,,0,0,0,,Қара адам...
Dialogue: 0,0:10:40.97,0:10:44.69,Main,,0,0,0,,Ал ол саған күштірек бол деп жатыр ма?
Dialogue: 0,00:10:41.72,00:10:45.60,JPN TOP,,0,0,0,,Ол саған мықты бол дейді.
Dialogue: 0,0:10:44.69,0:10:47.14,Main,,0,0,0,,Ноккерлерді қуып жіберу үшін бе?
Dialogue: 0,00:10:45.72,00:10:47.81,JPN TOP,,0,0,0,,Соққышты кері айдау
Dialogue: 0,0:10:47.14,0:10:48.00,Main,,0,0,0,,Оқу, оқу
Dialogue: 0,00:10:47.93,00:10:48.89,JPN TOP,,0,0,0,,Иә
Dialogue: 0,0:10:48.24,0:10:50.96,Main,,0,0,0,,Сонымен, не істегіңіз келеді?
Dialogue: 0,00:10:49.02,00:10:51.85,JPN TOP,,0,0,0,,Сонымен не істегіңіз келеді?
Dialogue: 0,0:10:50.96,0:10:51.79,Main,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,00:10:51.98,00:10:52.94,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:10:52.88,0:10:55.63,Italics,,0,0,0,,Мен оның айтқанын орындағым келмейді.
Dialogue: 0,00:10:54.02,00:10:56.73,JPN TOP,,0,0,0,,Оның айтқанын орындағым келмейді.
Dialogue: 0,0:10:56.32,0:10:59.18,Italics,,0,0,0,,Бірақ егер Ноккерлер келсе...
Dialogue: 0,00:10:57.40,00:11:00.20,JPN TOP,,0,0,0,,Бірақ егер тоқпақшы шабуыл жасаса...
Dialogue: 0,0:10:59.72,0:11:03.71,Italics,,0,0,0,,Пиоранды қорғай алатын жалғыз мен болар едім.
Dialogue: 0,00:11:00.74,00:11:04.62,JPN TOP,,0,0,0,,Ол кезде Пиоранды қорғай алатын жалғыз мен ғанамын.
Dialogue: 0,0:11:04.06,0:11:06.68,Italics,,0,0,0,,Қара киген адам дұрыс айтады. Мен оларды жеңе алмаймын.
Dialogue: 0,00:11:04.74,00:11:07.66,JPN TOP,,0,0,0,,Қара айтқандай, мен жеңе алмаймын.
Dialogue: 0,0:11:06.68,0:11:08.15,Italics,,0,0,0,,Қазір мен сияқты емес.
Dialogue: 0,00:11:07.79,00:11:09.25,JPN TOP,,0,0,0,,Мен қазіргідей...
Dialogue: 0,0:11:09.31,0:11:11.59,Italics,,0,0,0,,Сонда мен күшті болуым керек.
Dialogue: 0,00:11:10.41,00:11:12.71,JPN TOP,,0,0,0,,Сіз жасай алатын жалғыз нәрсе - күштірек болу...
Dialogue: 0,00:11:13.29,00:11:14.09,JPN TOP,,0,0,0,,Ах
Dialogue: 0,0:11:13.40,0:11:14.52,Italics,,0,0,0,,Әлгі бейбақ!
Dialogue: 0,0:11:14.52,0:11:18.28,Italics,,0,0,0,,Менімен осылай болатынын біліп, ол мені Пиоранмен соқтығыстырды!
Dialogue: 0,00:11:14.63,00:11:17.17,JPN TOP,,0,0,0,,Ол! Бұл менің басымнан өтетінін білдім
Dialogue: 0,00:11:17.30,00:11:19.34,JPN TOP,,0,0,0,,Сіз мені Пиоранмен әдейі кездестірдіңіз.
Dialogue: 0,0:11:19.11,0:11:21.30,Main,,0,0,0,,Айт, Фуши...
Dialogue: 0,00:11:20.22,00:11:22.30,JPN TOP,,0,0,0,,...
Dialogue: 0,0:11:21.30,0:11:24.46,Main,,0,0,0,,Мен сенен мені қорғайды деп күтпеймін.
Dialogue: 0,00:11:22.43,00:11:25.35,JPN TOP,,0,0,0,,Мен сенен мені қорғайды деп күтпеймін.
Dialogue: 0,00:11:25.47,00:11:26.47,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:11:26.62,0:11:30.61,Main,,0,0,0,,Шетте өмір сүрудің де тартымдылығы бар.
Dialogue: 0,00:11:27.68,00:11:31.48,JPN TOP,,0,0,0,,Қалқымалы арамшөп сияқты өмір сүру жақсы емес...
Dialogue: 0,0:11:30.61,0:11:31.50,Main,,0,0,0,,Сіз естідіңіз бе?
Dialogue: 0,00:11:31.60,00:11:32.40,JPN TOP,,0,0,0,,Ноу?
Dialogue: 0,0:11:32.17,0:11:32.99,Main,,0,0,0,,Оқу, оқу
Dialogue: 0,00:11:33.23,00:11:34.19,JPN TOP,,0,0,0,,Иә
Dialogue: 0,0:11:33.73,0:11:35.90,Italics,,0,0,0,,Бұл шынымен де жеткілікті ме?
Dialogue: 0,00:11:34.81,00:11:36.98,JPN TOP,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:11:36.50,0:11:39.32,Italics,,0,0,0,,Мен бір нәрсені ұмытып бара жатқандай сезінемін.
Dialogue: 0,00:11:37.53,00:11:40.61,JPN TOP,,0,0,0,,Мен бір нәрсені ұмытып бара жатқандай сезінемін.
Dialogue: 0,0:11:39.76,0:11:42.56,Main,,0,0,0,,Бұл жемістер дәмді көрінеді!
Dialogue: 0,00:11:40.74,00:11:43.57,JPN TOP,,0,0,0,,О, бұл дәмді көрінетін жеміс.
Dialogue: 0,0:11:42.56,0:11:45.15,Main,,0,0,0,,Фуши, көтеріліп, мен үшін оларды ұстап ал.
Dialogue: 0,00:11:43.70,00:11:46.03,JPN TOP,,0,0,0,,Фуши, жоғары көтеріліп, оны алыңыз.
Dialogue: 0,0:11:45.15,0:11:47.16,Main,,0,0,0,,Мен мұны істеудің қажеті жоқ.
Dialogue: 0,00:11:46.16,00:11:49.25,JPN TOP,,0,0,0,,Бұлай істеудің қажеті жоқ...көрдің бе?
Dialogue: 0,0:11:47.52,0:11:48.35,Main,,0,0,0,,Ф-Фатирлеу ештеңе әкелмейді.
Dialogue: 0,0:11:48.35,0:11:50.32,Main,,0,0,0,,Өрескел!
Dialogue: 0,00:11:49.37,00:11:51.08,JPN TOP,,0,0,0,,Уеккишой!
Dialogue: 0,0:11:50.32,0:11:52.61,Main,,0,0,0,,Мен оны жемеймін.
Dialogue: 0,00:11:51.21,00:11:53.50,JPN TOP,,0,0,0,,Мен ондай ештеңе жемеймін.
Dialogue: 0,0:11:52.61,0:11:55.31,Main,,0,0,0,,О, жақсы.
Dialogue: 0,00:11:53.62,00:11:56.46,JPN TOP,,0,0,0,,Хмм... Мен көмектесе алмаймын...
Dialogue: 0,0:11:56.50,0:11:57.18,Main,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,00:11:57.55,00:11:59.55,JPN TOP,,0,0,0,,Иә? Уф
Dialogue: 0,0:11:58.55,0:12:01.20,Main,,0,0,0,,Не болды? Бұл аянышты болды.
Dialogue: 0,00:11:59.67,00:12:02.13,JPN TOP,,0,0,0,,Қаншалықты аянышты?
Dialogue: 0,0:12:01.20,0:12:05.47,Main,,0,0,0,,Наурыз формасына қайта оралыңыз. Бұл қаншалықты қиын болуы мүмкін?
Dialogue: 0,00:12:02.26,00:12:05.59,JPN TOP,,0,0,0,,Бұрынғыдай наурыз түрінде орындасаңыз оңай болар еді.
Dialogue: 0,0:12:05.47,0:12:06.44,Main,,0,0,0,,наурыз?
Dialogue: 0,00:12:06.39,00:12:07.35,JPN TOP,,0,0,0,,наурыз?
Dialogue: 0,0:12:08.46,0:12:12.08,Main,,0,0,0,,М-наурыз! Сіз оны танисыз, солай емес пе?
Dialogue: 0,00:12:09.47,00:12:11.68,JPN TOP,,0,0,0,,Сіз... наурыз.
Dialogue: 0,00:12:11.81,00:12:14.60,JPN TOP,,0,0,0,,Сіз бұл кішкентай нәрсені білесіз.
Dialogue: 0,0:12:12.08,0:12:13.82,Main,,0,0,0,,Кішкентай.
Dialogue: 0,0:12:13.82,0:12:14.97,Main,,0,0,0,,Сіз кім туралы айтып отырсыз?
Dialogue: 0,00:12:14.73,00:12:16.02,JPN TOP,,0,0,0,,Сіз кім туралы айтып отырсыз?
Dialogue: 0,0:12:15.88,0:12:19.11,Main,,0,0,0,,Сіз оған бірнеше рет өзгердіңіз!
Dialogue: 0,00:12:16.94,00:12:20.07,JPN TOP,,0,0,0,,Сен талай рет ол қызға айналдың.
Dialogue: 0,0:12:19.11,0:12:20.31,Main,,0,0,0,,Оны есте сақта!
Dialogue: 0,00:12:20.19,00:12:23.74,JPN TOP,,0,0,0,,Есте сақта! Ұмытып қалдым деп айтпа!
Dialogue: 0,0:12:20.31,0:12:22.66,Main,,0,0,0,,Сен маған оны ұмыттың деп айтуға батылы барма!
Dialogue: 0,00:12:30.95,00:12:31.91,JPN TOP,,0,0,0,,Уф
Dialogue: 0,0:12:31.93,0:12:33.41,Main,,0,0,0,,есімде.
Dialogue: 0,00:12:33.00,00:12:37.17,JPN TOP,,0,0,0,,Есімде, ағашқа өрмелей алғаным есімде.
Dialogue: 0,0:12:33.41,0:12:36.26,Main,,0,0,0,,Ағаштарға өрмелей алғаным есімде.
Dialogue: 0,0:12:36.26,0:12:38.26,Flashback,,0,0,0,,Фуши! Сен бірінші бар!
Dialogue: 0,00:12:37.29,00:12:39.17,JPN TOP,,0,0,0,,Фуши Алдымен барыңыз!
Dialogue: 0,0:12:38.26,0:12:40.57,Flashback,,0,0,0,,Фуши! Маған таяқ беріңіз!
Dialogue: 0,00:12:39.30,00:12:41.46,JPN TOP,,0,0,0,,Фуши Маған таяқшаны беріңіз!
Dialogue: 0,0:12:40.92,0:12:42.52,Main,,0,0,0,,Мен...
Dialogue: 0,00:12:42.01,00:12:43.76,JPN TOP,,0,0,0,,Шынында да…
Dialogue: 0,0:12:43.17,0:12:45.42,Main,,0,0,0,,Сізді тонап кетті.
Dialogue: 0,00:12:44.30,00:12:49.01,JPN TOP,,0,0,0,,Сізді ұрлап кетті, тықыршыға қарай жүріңіз
Dialogue: 0,0:12:45.69,0:12:47.83,Main,,0,0,0,,Ноккерлер наурызды сенен тартып алды.
Dialogue: 0,0:12:48.98,0:12:52.55,Main,,0,0,0,,Біреу маған көп нәрсе берді.
Dialogue: 0,00:12:50.06,00:12:53.52,JPN TOP,,0,0,0,,Маған көп нәрсе берген адам болды.
Dialogue: 0,0:12:53.42,0:12:55.28,Flashback,,0,0,0,,«Рахмет» деп айтыңыз.
Dialogue: 0,00:12:54.52,00:12:56.19,JPN TOP,,0,0,0,,Қараңыз, «Рахмет».
Dialogue: 0,0:12:55.81,0:12:57.67,Flashback,,0,0,0,,Көңілді күшік!
Dialogue: 0,00:12:56.90,00:12:58.56,JPN TOP,,0,0,0,,Біртүрлі ит!
Dialogue: 0,0:12:58.16,0:13:01.64,Flashback,,0,0,0,,Өсе білу – бәрін білу, солай ма?
Dialogue: 0,00:12:59.27,00:13:02.53,JPN TOP,,0,0,0,,Өсе келе көп үйрену деген сөз, солай ма?
Dialogue: 0,0:13:02.32,0:13:03.38,Main,,0,0,0,,Бұл...
Dialogue: 0,00:13:03.40,00:13:06.86,JPN TOP,,0,0,0,,Бұл... наурыз ма?
Dialogue: 0,0:13:03.78,0:13:05.98,Main,,0,0,0,,Бұл наурыз ма?
Dialogue: 0,0:13:07.62,0:13:11.40,Main,,0,0,0,,Ол мен үшін шынымен маңызды емес пе еді?
Dialogue: 0,00:13:08.74,00:13:12.41,JPN TOP,,0,0,0,,Бұл өте маңызды болуы керек...
Dialogue: 0,0:13:12.34,0:13:14.48,Main,,0,0,0,,Сіз түсіндіңіз.
Dialogue: 0,00:13:13.41,00:13:15.79,JPN TOP,,0,0,0,,Сіз түсіндіңіз бе?
Dialogue: 0,0:13:14.84,0:13:16.35,Main,,0,0,0,,Мен сізді кінәлай алмаймын.
Dialogue: 0,00:13:15.92,00:13:20.63,JPN TOP,,0,0,0,,Қолымнан келмейді, тіпті не жоғалтқанымды есіме түсіре алмаймын.
Dialogue: 0,0:13:16.35,0:13:19.58,Main,,0,0,0,,Бір нәрсені жоғалтқаннан кейін оны есіне түсіре алмайсыз.
Dialogue: 0,0:13:25.70,0:13:27.24,Main,,0,0,0,,Б... бір сызық
Dialogue: 0,00:13:26.80,00:13:28.14,JPN TOP,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:27.24,0:13:30.65,Main,,0,0,0,,Жау сіздің естеліктеріңізді де алады.
Dialogue: 0,00:13:28.26,00:13:31.56,JPN TOP,,0,0,0,,Жадыларыңды да тартып алар ма?
Dialogue: 0,0:13:31.08,0:13:34.61,Main,,0,0,0,,Егер ол сізді Гугу кейпінде болған кезде өлтірсе,
Dialogue: 0,00:13:32.18,00:13:35.48,JPN TOP,,0,0,0,,Егер сіз өзіңіздің гу-гу формаңызда өлтірілсеңіз.
Dialogue: 0,0:13:34.61,0:13:37.41,Main,,0,0,0,,сіз де Гугу туралы естеліктеріңізді жоғалтасыз.
Dialogue: 0,00:13:35.60,00:13:38.31,JPN TOP,,0,0,0,,Гу Гу туралы естеліктеріңізді де жоғалтпаңыз.
Dialogue: 0,0:13:37.81,0:13:38.67,Main,,0,0,0,,Оқу, оқу
Dialogue: 0,00:13:38.94,00:13:39.90,JPN TOP,,0,0,0,,Иә
Dialogue: 0,0:13:40.42,0:13:43.18,Main,,0,0,0,,Бұл екінші өлім сияқты.
Dialogue: 0,00:13:41.44,00:13:44.07,JPN TOP,,0,0,0,,Бұл екінші өлім сияқты.
Dialogue: 0,00:13:44.19,00:13:45.32,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:13:44.42,0:13:48.88,Main,,0,0,0,,Реан мен Буз адам, Нинаннаның Паронасы...
Dialogue: 0,00:13:45.44,00:13:48.03,JPN TOP,,0,0,0,,Еңкейіп, сау қарт
Dialogue: 0,00:13:48.16,00:13:51.70,JPN TOP,,0,0,0,,Парона Нинанна және мен де...
Dialogue: 0,0:13:48.88,0:13:50.73,Main,,0,0,0,,Мен де.
Dialogue: 0,0:13:50.73,0:13:56.18,Main,,0,0,0,,Біз ұмытылғаннан кейін ғана шынымен өлеміз.
Dialogue: 0,00:13:51.83,00:13:54.41,JPN TOP,,0,0,0,,Тек ұмытылғаннан кейін
Dialogue: 0,00:13:54.54,00:13:57.08,JPN TOP,,0,0,0,,Мен сөздің шын мағынасында өліп жатырмын деп ойлаймын.
Dialogue: 0,0:13:57.57,0:13:59.34,Main,,0,0,0,,Мен бұған жол бермеймін.
Dialogue: 0,00:13:58.62,00:14:02.50,JPN TOP,,0,0,0,,Мен саған бұлай істеуге рұқсат бермеймін. Мен күштірек боламын.
Dialogue: 0,0:13:59.34,0:14:01.43,Main,,0,0,0,,Мен күшейемін.
Dialogue: 0,0:14:04.82,0:14:07.36,Italics,,0,0,0,,Енді мен шешім қабылдадым, мен ойлануым керек.
Dialogue: 0,00:14:05.88,00:14:08.38,JPN TOP,,0,0,0,,Енді мен шешім қабылдадым, мен бұл туралы ойлануым керек.
Dialogue: 0,0:14:07.81,0:14:10.59,Italics,,0,0,0,,Қара заттың қолына тура ойнасам да.
Dialogue: 0,00:14:08.93,00:14:11.47,JPN TOP,,0,0,0,,...
Dialogue: 0,0:14:10.84,0:14:15.46,Flashback,,0,0,0,,You make new things in reaction to pain, right?
Dialogue: 0,00:14:11.60,00:14:16.35,JPN TOP,,0,0,0,,...
Dialogue: 0,0:14:16.59,0:14:17.42,Italics,,0,0,0,,Pain...
Dialogue: 0,00:14:17.69,00:14:20.94,JPN TOP,,0,0,0,,…
Dialogue: 0,0:14:17.98,0:14:20.06,Italics,,0,0,0,,I just have to stimulate myself.
Dialogue: 0,0:14:20.06,0:14:21.07,Italics,,0,0,0,,It's easy.
Dialogue: 0,00:14:21.06,00:14:22.15,JPN TOP,,0,0,0,,Бұл оңай
Dialogue: 0,0:14:22.26,0:14:25.09,Italics,,0,0,0,,But I can't turn myself into rock.
Dialogue: 0,00:14:23.32,00:14:25.99,JPN TOP,,0,0,0,,...
Dialogue: 0,0:14:25.09,0:14:26.51,Italics,,0,0,0,,I'll lose awareness.
Dialogue: 0,00:14:26.11,00:14:27.74,JPN TOP,,0,0,0,,...
Dialogue: 0,0:14:27.37,0:14:29.66,Italics,,0,0,0,,The problem is that, as far as living things go,
Dialogue: 0,00:14:28.45,00:14:30.70,JPN TOP,,0,0,0,,...
Dialogue: 0,0:14:30.20,0:14:33.09,Italics,,0,0,0,,I can't transform while the subject is still alive.
Dialogue: 0,00:14:31.28,00:14:33.99,JPN TOP,,0,0,0,,...
Dialogue: 0,0:14:33.65,0:14:35.14,Italics,,0,0,0,,What a nasty thought.
Dialogue: 0,0:14:34.08,0:14:36.06,Main,,0,0,0,,A crab flower!
Dialogue: 0,00:14:34.74,00:14:36.08,JPN TOP,,0,0,0,,...
Dialogue: 0,00:14:34.74,00:14:37.00,JPN TOP,,0,0,0,,...
Dialogue: 0,0:14:36.06,0:14:37.55,Main,,0,0,0,,These things are sweet.
Dialogue: 0,00:14:37.12,00:14:38.46,JPN TOP,,0,0,0,,...
Dialogue: 0,0:14:37.82,0:14:40.53,Main,,0,0,0,,The eyes are made of bugs, so we don't eat them.
Dialogue: 0,00:14:38.58,00:14:41.42,JPN TOP,,0,0,0,,...
Dialogue: 0,0:14:40.53,0:14:44.84,Main,,0,0,0,,The flower is delicious, so we'll make salad out of it later.
Dialogue: 0,00:14:41.54,00:14:46.01,JPN TOP,,0,0,0,,...
Dialogue: 0,0:14:45.51,0:14:48.65,Main,,0,0,0,,And we boil it live with plenty of salt.
Dialogue: 0,00:14:46.55,00:14:49.55,JPN TOP,,0,0,0,,...
Dialogue: 0,0:14:49.40,0:14:50.79,Main,,0,0,0,,What's wrong, Fushi?
Dialogue: 0,00:14:49.68,00:14:52.30,JPN TOP,,0,0,0,,…
Dialogue: 0,0:14:51.35,0:14:54.12,Main,,0,0,0,,When I'm near something, I feel what it feels.
Dialogue: 0,00:14:52.43,00:14:54.97,JPN TOP,,0,0,0,,...
Dialogue: 0,0:14:54.12,0:14:57.05,Main,,0,0,0,,Pain and suffering and stuff.
Dialogue: 0,00:14:55.10,00:14:57.98,JPN TOP,,0,0,0,,…
Dialogue: 0,0:14:57.05,0:14:58.21,Main,,0,0,0,,Уау.
Dialogue: 0,00:14:58.10,00:15:01.52,JPN TOP,,0,0,0,,...
Dialogue: 0,0:14:58.21,0:15:00.58,Main,,0,0,0,,Has it always been like that?
Dialogue: 0,0:15:00.58,0:15:01.44,Main,,0,0,0,,Оқу, оқу
Dialogue: 0,00:15:01.65,00:15:02.81,JPN TOP,,0,0,0,,Иә
Dialogue: 0,0:15:01.84,0:15:06.92,Main,,0,0,0,,That's why I always had Gugu gut the fish and crabs.
Dialogue: 0,00:15:02.94,00:15:05.48,JPN TOP,,0,0,0,,...
Dialogue: 0,00:15:05.61,00:15:08.11,JPN TOP,,0,0,0,,...
Dialogue: 0,0:15:07.26,0:15:08.78,Main,,0,0,0,,I never knew.
Dialogue: 0,00:15:08.24,00:15:09.95,JPN TOP,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:09.86,0:15:11.88,Main,,0,0,0,,There, it's ready.
Dialogue: 0,00:15:10.95,00:15:12.78,JPN TOP,,0,0,0,,Қараңызшы, бұл орындалды.
Dialogue: 0,0:15:12.35,0:15:13.33,Main,,0,0,0,,Иә!
Dialogue: 0,0:15:13.33,0:15:14.36,Main,,0,0,0,,Иә, жақсы.
Dialogue: 0,00:15:13.53,00:15:15.24,JPN TOP,,0,0,0,,Дәмді! Иә, дәмді
Dialogue: 0,0:15:14.80,0:15:17.60,Italics,,0,0,0,,Шаян болуға әлі батылым жетпейді.
Dialogue: 0,00:15:15.87,00:15:18.50,JPN TOP,,0,0,0,,Шаян болуға әлі батылым жетпейді.
Dialogue: 0,0:15:20.68,0:15:22.85,Italics,,0,0,0,,Мен тек мәйітті ғана жасай аламын.
Dialogue: 0,00:15:21.71,00:15:23.96,JPN TOP,,0,0,0,,Шигай жасай аласыз ба?
Dialogue: 0,0:15:23.59,0:15:26.00,Italics,,0,0,0,,Менің ойымша, мен Гугуды да жасай алатын шығармын.
Dialogue: 0,00:15:24.63,00:15:27.05,JPN TOP,,0,0,0,,Мен сенің де гу-гу жасай алатыныңа сенімдімін.
Dialogue: 0,0:15:26.68,0:15:29.68,Italics,,0,0,0,,Ақсақ, қимылсыз Гугу.
Dialogue: 0,00:15:27.76,00:15:30.72,JPN TOP,,0,0,0,,Гу Гу шаршап, қозғалмайды...
Dialogue: 0,0:15:30.85,0:15:32.53,Main,,0,0,0,,Айтыңызшы, Фуши...
Dialogue: 0,00:15:31.93,00:15:33.43,JPN TOP,,0,0,0,,Ноу Фуши.
Dialogue: 0,0:15:32.94,0:15:37.42,Main,,0,0,0,,Соңғы рет ноккерлермен соғысқанда оларды қалай жеңдіңіз?
Dialogue: 0,00:15:34.01,00:15:36.56,JPN TOP,,0,0,0,,Сіз Нокермен соңғы рет жекпе-жекке шықтыңыз
Dialogue: 0,00:15:36.68,00:15:38.35,JPN TOP,,0,0,0,,Сіз қалай жеңдіңіз?
Dialogue: 0,00:15:38.47,00:15:43.15,JPN TOP,,0,0,0,,Не? А... мен мұны шынымен түсінбеймін.
Dialogue: 0,0:15:39.07,0:15:42.15,Main,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:15:42.15,0:15:45.75,Main,,0,0,0,,Гугу оған от шашып, ол суға секірді,
Dialogue: 0,00:15:43.27,00:15:46.61,JPN TOP,,0,0,0,,Оттың шуылдап суға түскенде
Dialogue: 0,0:15:45.75,0:15:47.74,Main,,0,0,0,,және оның денесіндегі тастар ыдырап кетті.
Dialogue: 0,00:15:46.73,00:15:48.65,JPN TOP,,0,0,0,,Денемдегі тас жарылып кетті...
Dialogue: 0,0:15:47.91,0:15:49.17,Main,,0,0,0,,Міне!
Dialogue: 0,00:15:48.78,00:15:50.15,JPN TOP,,0,0,0,,​​Олай болса!
Dialogue: 0,0:15:49.17,0:15:52.38,Main,,0,0,0,,Қыздырылған тас тез салқындаған кезде сынғыш болады.
Dialogue: 0,00:15:50.28,00:15:53.28,JPN TOP,,0,0,0,,Қызған тас кенет салқындатылса, ол сынғыш болады.
Dialogue: 0,00:15:58.41,00:15:59.58,JPN TOP,,0,0,0,,Ах!
Dialogue: 0,0:16:04.33,0:16:07.16,Main,,0,0,0,,Бұл жақсы жұмыс істеді.
Dialogue: 0,00:16:05.54,00:16:08.05,JPN TOP,,0,0,0,,Бұл, әрине, сәтті болды, бірақ
Dialogue: 0,0:16:07.66,0:16:09.57,Main,,0,0,0,,Бірақ келесі жолы туралы білмеймін.
Dialogue: 0,00:16:08.71,00:16:11.01,JPN TOP,,0,0,0,,Әрі қарай не болады...
Dialogue: 0,0:16:10.06,0:16:12.67,Main,,0,0,0,,Мені сілкіп тастаса, мен өлемін.
Dialogue: 0,00:16:11.13,00:16:13.55,JPN TOP,,0,0,0,,Селкініп кетсең, өлесің.
Dialogue: 0,0:16:12.95,0:16:16.83,Main,,0,0,0,,Жақын жерде су бар деп сене алмайсыз.
Dialogue: 0,00:16:13.68,00:16:17.68,JPN TOP,,0,0,0,,Су әрқашан қолайлы бола бермейді.
Dialogue: 0,0:16:16.83,0:16:19.88,Main,,0,0,0,,Сіз күрескен кезде жан-жақты болуды үйренуіңіз керек.
Dialogue: 0,00:16:17.81,00:16:21.06,JPN TOP,,0,0,0,,Маған икемді түрде күресе білу керек.
Dialogue: 0,0:16:20.48,0:16:21.69,Main,,0,0,0,,Жүріңдер, асығыңдар, жігіттер
Dialogue: 0,00:16:21.60,00:16:24.56,JPN TOP,,0,0,0,,Дұрыс! Жақсы жер бар, Фуши.
Dialogue: 0,0:16:21.69,0:16:23.65,Main,,0,0,0,,Керемет жер бар, Фуши!
Dialogue: 0,0:16:25.82,0:16:31.22,Main,,0,0,0,,Алда порттан Сарлнинге бара жатқан кеме бар.
Dialogue: 0,00:16:26.86,00:16:28.77,JPN TOP,,0,0,0,,Алдағы порттан
Dialogue: 0,00:16:28.90,00:16:32.15,JPN TOP,,0,0,0,,Сарнай джунглиіне қайық кетіп бара жатыр.
Dialogue: 0,0:16:31.22,0:16:34.55,Main,,0,0,0,,Бұл жануарлар жұмақ.
Dialogue: 0,00:16:32.28,00:16:35.41,JPN TOP,,0,0,0,,Бұл тек жануарларға арналған жұмақ.
Dialogue: 0,0:16:34.55,0:16:36.09,Main,,0,0,0,,Оған ешкім жақындамайды.
Dialogue: 0,00:16:35.53,00:16:36.99,JPN TOP,,0,0,0,,Адамдар жақындамайды
Dialogue: 0,0:16:36.48,0:16:39.69,Main,,0,0,0,,Онда сіз өз қалауыңыз бойынша жаттыға аласыз.
Dialogue: 0,00:16:37.53,00:16:40.49,JPN TOP,,0,0,0,,Сіз қалағаныңызша көп қуат ала аласыз.
Dialogue: 0,0:16:39.69,0:16:40.82,Main,,0,0,0,,Кеме...
Dialogue: 0,00:16:40.62,00:16:43.96,JPN TOP,,0,0,0,,Кеме... Тақылдақ келсе, қиын болады.
Dialogue: 0,0:16:40.82,0:16:43.04,Main,,0,0,0,,Ноккерлер келсе, кеме қауіпті болар еді.
Dialogue: 0,0:16:43.04,0:16:45.18,Main,,0,0,0,,Бұған шыдауға болмайды!
Dialogue: 0,00:16:44.08,00:16:46.08,JPN TOP,,0,0,0,,Кішкене шыдамдылық!
Dialogue: 0,0:16:45.18,0:16:49.24,Main,,0,0,0,,Мазасыздықты тоқтатпасаң, мәңгілік құрсауға түсесің.
Dialogue: 0,00:16:46.21,00:16:50.34,JPN TOP,,0,0,0,,Егер сіз осындай нәрселерге алаңдасаңыз, сіз ешқашан қозғала алмайсыз.
Dialogue: 0,0:16:51.25,0:16:52.44,Main,,0,0,0,,Вент ашылғалы үш күн өтті
Dialogue: 0,00:16:52.34,00:16:53.34,JPN TOP,,0,0,0,,Түсіндім
Dialogue: 0,0:16:53.05,0:16:53.89,Main,,0,0,0,,Вент одан әрі ашылмауына қол жеткіздік.
Dialogue: 0,00:16:54.09,00:16:55.05,JPN TOP,,0,0,0,,Кеттік
Dialogue: 0,0:16:59.41,0:17:00.44,Main,,0,0,0,,Міне келдік!
Dialogue: 0,00:17:00.22,00:17:02.85,JPN TOP,,0,0,0,,Міне, бұл кемеде болды.
Dialogue: 0,0:17:00.44,0:17:01.76,Main,,0,0,0,,Бұл кеме.
Dialogue: 0,0:17:01.76,0:17:05.10,Main,,0,0,0,,Ханым, бұл кеме толып қалды.
Dialogue: 0,00:17:02.98,00:17:04.18,JPN TOP,,0,0,0,,Тұтынушылар!
Dialogue: 0,00:17:04.31,00:17:07.98,JPN TOP,,0,0,0,,Бұл кеме толы, сондықтан біз сізді басқа кемеге апарамыз.
Dialogue: 0,0:17:05.10,0:17:07.07,Main,,0,0,0,,Маған сол жақтағы кемені көрсетуге рұқсат етіңіз.
Dialogue: 0,0:17:07.51,0:17:08.92,Main,,0,0,0,,Осылай өтінемін.
Dialogue: 0,00:17:08.61,00:17:11.61,JPN TOP,,0,0,0,,Өтінемін, осында кел, мен есекті ұстаймын.
Dialogue: 0,0:17:08.92,0:17:10.73,Main,,0,0,0,,Мен сенің есегіңді бағып аламын.
Dialogue: 0,0:17:10.73,0:17:11.85,Main,,0,0,0,,Хиёри, қош келдің.
Dialogue: 0,00:17:11.73,00:17:12.99,JPN TOP,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,00:17:13.11,00:17:16.28,JPN TOP,,0,0,0,,Ху~ Мереке жоқ, мереке жоқ.
Dialogue: 0,0:17:13.21,0:17:15.29,Main,,0,0,0,,Үзіліс уақыты.
Dialogue: 0,0:17:15.29,0:17:17.73,Main,,0,0,0,,Әйелдер менімен бірге, өтінемін.
Dialogue: 0,00:17:16.41,00:17:18.53,JPN TOP,,0,0,0,,Әйелдер, мына жерді басыңыз
Dialogue: 0,0:17:18.62,0:17:20.80,Main,,0,0,0,,Бұл ереже ме?
Dialogue: 0,00:17:18.66,00:17:21.70,JPN TOP,,0,0,0,,? Ондай ереже бар ма?
Dialogue: 0,0:17:20.80,0:17:22.63,Main,,0,0,0,,Бұл аймақ қауіпті.
Dialogue: 0,00:17:21.83,00:17:24.46,JPN TOP,,0,0,0,,Бұл жерде көп қиындық бар... Кешіріңіз.
Dialogue: 0,0:17:22.63,0:17:23.56,Main,,0,0,0,,Мұнда.
Dialogue: 0,0:17:24.06,0:17:26.69,Main,,0,0,0,,Олай болса, Фуши, мен сені сонда көремін.
Dialogue: 0,00:17:25.12,00:17:27.54,JPN TOP,,0,0,0,,Олай болса, Фуши, біз келгенде.
Dialogue: 0,0:17:26.69,0:17:27.56,Main,,0,0,0,,Оқу, оқу
Dialogue: 0,00:17:27.67,00:17:28.46,JPN TOP,,0,0,0,,Иә
Dialogue: 0,0:17:31.68,0:17:33.79,Main,,0,0,0,,Кел, сен менімен біргесің.
Dialogue: 0,00:17:32.80,00:17:34.67,JPN TOP,,0,0,0,,Енді осындасың!
Dialogue: 0,0:17:34.04,0:17:35.28,Main,,0,0,0,,Мұнда.
Dialogue: 0,00:17:34.80,00:17:36.18,JPN TOP,,0,0,0,,Міне! Эх...
Dialogue: 0,0:17:35.53,0:17:36.32,Main,,0,0,0,,Сен сияқты жеңілген адамға ешкім мән бермейді.
Dialogue: 0,00:17:36.30,00:17:37.59,JPN TOP,,0,0,0,,Енгізіңіз!
Dialogue: 0,00:17:37.72,00:17:38.59,JPN TOP,,0,0,0,,Ha
Dialogue: 0,00:17:38.72,00:17:41.10,JPN TOP,,0,0,0,,Ей, күте тұр, күте тұр, (еркек) Мен сені шығарып жіберемін деп жатырмын.
Dialogue: 0,0:17:40.43,0:17:42.54,Main,,0,0,0,,Мен билеттеріңді таратамын.
Dialogue: 0,00:17:41.22,00:17:43.43,JPN TOP,,0,0,0,,Мен сізге билетті қазір беремін.
Dialogue: 0,00:17:41.22,00:17:45.02,JPN TOP,,0,0,0,,（）
Dialogue: 0,0:17:42.54,0:17:44.12,Main,,0,0,0,,Each of you, put your hand out.
Dialogue: 0,00:17:43.56,00:17:45.02,JPN TOP,,0,0,0,,１
Dialogue: 0,00:17:45.14,00:17:49.02,JPN TOP,,0,0,0,,(Ерлердің айқайы)
Dialogue: 0,0:17:48.33,0:17:49.12,Main,,0,0,0,,Next!
Dialogue: 0,00:17:49.15,00:17:51.52,JPN TOP,,0,0,0,,...
Dialogue: 0,0:17:49.33,0:17:50.11,Main,,0,0,0,,Сіз!
Dialogue: 0,00:17:53.15,00:17:56.03,JPN TOP,,0,0,0,,…
Dialogue: 0,0:17:56.09,0:17:57.19,Main,,0,0,0,,Next!
Dialogue: 0,00:17:56.15,00:17:57.15,JPN TOP,,0,0,0,,Ha
Dialogue: 0,00:17:57.28,00:18:00.03,JPN TOP,,0,0,0,,（）…
Dialogue: 0,0:17:59.63,0:18:00.92,Main,,0,0,0,,Next!
Dialogue: 0,00:18:00.16,00:18:02.53,JPN TOP,,0,0,0,,… （）
Dialogue: 0,00:18:00.16,00:18:02.53,JPN TOP,,0,0,0,,（）
Dialogue: 0,00:18:02.66,00:18:05.00,JPN TOP,,0,0,0,,...
Dialogue: 0,00:18:02.66,00:18:05.00,JPN TOP,,0,0,0,,...
Dialogue: 0,0:18:02.83,0:18:04.09,Italics,,0,0,0,,Pioran!
Dialogue: 0,0:18:04.32,0:18:06.64,Main,,0,0,0,,Welcome, prisoners!
Dialogue: 0,00:18:05.12,00:18:07.54,JPN TOP,,0,0,0,,...
Dialogue: 0,0:18:06.64,0:18:09.11,Main,,0,0,0,,Starting today, you're all family!
Dialogue: 0,00:18:07.66,00:18:10.00,JPN TOP,,0,0,0,,...
Dialogue: 0,0:18:09.40,0:18:16.02,Main,,0,0,0,,You're all headed for the one place in the world that'll accept trash like you.
Dialogue: 0,00:18:10.54,00:18:11.96,JPN TOP,,0,0,0,,...
Dialogue: 0,00:18:12.09,00:18:14.84,JPN TOP,,0,0,0,,⸺
Dialogue: 0,00:18:14.96,00:18:16.92,JPN TOP,,0,0,0,,...
Dialogue: 0,0:18:16.37,0:18:19.64,Main,,0,0,0,,There is where your last life begins.
Dialogue: 0,00:18:17.47,00:18:20.80,JPN TOP,,0,0,0,,...
Dialogue: 0,0:18:20.14,0:18:21.73,Main,,0,0,0,,Welcome to heaven...
Dialogue: 0,00:18:20.93,00:18:25.52,JPN TOP,,0,0,0,,...
Dialogue: 0,0:18:21.73,0:18:24.48,Main,,0,0,0,,Jananda Island!
Dialogue: 0,0:18:36.31,0:18:38.43,Italics,,0,0,0,,What is going on?
Dialogue: 0,00:18:36.94,00:18:39.32,JPN TOP,,0,0,0,,...
Dialogue: 0,0:18:42.91,0:18:44.55,Italics,,0,0,0,,Where's Pioran?
Dialogue: 0,00:18:43.99,00:18:45.83,JPN TOP,,0,0,0,,...
Dialogue: 0,0:18:48.43,0:18:49.84,Main,,0,0,0,,You, hold it.
Dialogue: 0,00:18:49.50,00:18:52.42,JPN TOP,,0,0,0,,...
Dialogue: 0,0:18:49.84,0:18:51.49,Main,,0,0,0,,Where are your shackles?
Dialogue: 0,0:18:52.37,0:18:53.90,Main,,0,0,0,,Your brand is missing, too.
Dialogue: 0,00:18:52.54,00:18:54.96,JPN TOP,,0,0,0,,（）
Dialogue: 0,0:18:54.26,0:18:55.15,Main,,0,0,0,,That's odd...
Dialogue: 0,00:18:55.09,00:18:56.05,JPN TOP,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:18:55.54,0:18:58.52,Main,,0,0,0,,Did you get on with the prisoners by mistake?
Dialogue: 0,00:18:56.63,00:18:59.51,JPN TOP,,0,0,0,,...
Dialogue: 0,0:18:58.52,0:19:00.38,Main,,0,0,0,,I'm sorry, boss!
Dialogue: 0,00:18:59.63,00:19:01.55,JPN TOP,,0,0,0,,Кешіріңіз, бастық! (Топ жетекшісі) Иә?
Dialogue: 0,0:19:00.65,0:19:02.39,Main,,0,0,0,,Мен қателік жібердім.
Dialogue: 0,00:19:01.68,00:19:03.43,JPN TOP,,0,0,0,,Бұл менің қателігім болды!
Dialogue: 0,0:19:03.13,0:19:04.14,Main,,0,0,0,,Б... бір сызық
Dialogue: 0,0:19:04.14,0:19:06.05,Main,,0,0,0,,Бұдан былай сақ болыңыз.
Dialogue: 0,00:19:04.18,00:19:06.93,JPN TOP,,0,0,0,,Иә, келесі жолы абай болыңыз.
Dialogue: 0,0:19:06.05,0:19:08.62,Main,,0,0,0,,Сенім біздің бизнес үшін маңызды.
Dialogue: 0,00:19:07.06,00:19:09.52,JPN TOP,,0,0,0,,Мұндай жағдайда сенім маңызды.
Dialogue: 0,0:19:08.86,0:19:09.51,Main,,0,0,0,,Вент ашылғалы үш күн өтті
Dialogue: 0,0:19:09.51,0:19:11.11,Main,,0,0,0,,Мен оны қайтарамын.
Dialogue: 0,00:19:09.64,00:19:12.02,JPN TOP,,0,0,0,,Иә! Мен оны сізге жіберемін
Dialogue: 0,0:19:12.03,0:19:13.22,Main,,0,0,0,,Осы жолмен.
Dialogue: 0,00:19:13.11,00:19:14.36,JPN TOP,,0,0,0,,Міне, міне, уау...
Dialogue: 0,0:19:19.00,0:19:20.42,Main,,0,0,0,,Пиоран қайда?
Dialogue: 0,00:19:20.15,00:19:23.37,JPN TOP,,0,0,0,,Pioran қайда орналасқан? менімен бірге болған адам
Dialogue: 0,0:19:20.42,0:19:22.53,Main,,0,0,0,,Менімен бірге болған әйел?
Dialogue: 0,0:19:22.53,0:19:23.55,Main,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,00:19:23.49,00:19:26.99,JPN TOP,,0,0,0,,Келіңіздер... Мен оның қамауда отырғанына сенімдімін.
Dialogue: 0,0:19:23.55,0:19:26.11,Main,,0,0,0,,Ол қазірдің өзінде қабылданып қойған шығар.
Dialogue: 0,0:19:26.93,0:19:28.15,Main,,0,0,0,,Не бұл, Хиёри? Жаңа жылдық әзіл ме?
Dialogue: 0,00:19:27.12,00:19:29.08,JPN TOP,,0,0,0,,Не? сенімді болыңыз
Dialogue: 0,0:19:28.15,0:19:31.87,Main,,0,0,0,,Мұнда келгендердің бәрі ақырында күлуді үйренеді.
Dialogue: 0,00:19:29.20,00:19:32.88,JPN TOP,,0,0,0,,Мұнда келгендердің бәрі бірте-бірте күлімсірей бастайды.
Dialogue: 0,0:19:32.38,0:19:34.74,Main,,0,0,0,,Неліктен деп ойлаймын.
Dialogue: 0,00:19:33.42,00:19:35.63,JPN TOP,,0,0,0,,Бірақ бұл нені білдіреді?
Dialogue: 0,0:19:35.02,0:19:36.39,Main,,0,0,0,,Олар мұнда бақытты болғандықтан ба?
Dialogue: 0,00:19:35.75,00:19:37.25,JPN TOP,,0,0,0,,Бұл қызық болғандықтан ба?
Dialogue: 0,0:19:36.39,0:19:40.02,Main,,0,0,0,,Әлде олар бақытты әрекет етпесе, олар есінен танып қалады ма?
Dialogue: 0,00:19:37.38,00:19:41.13,JPN TOP,,0,0,0,,Әлде бақытты әрекет етпейінше өтпейтіндіктен бе?
Dialogue: 0,0:19:41.74,0:19:42.74,Main,,0,0,0,,Шынымен
Dialogue: 0,00:19:42.01,00:19:43.64,JPN TOP,,0,0,0,,Ах... эй!
Dialogue: 0,0:19:43.58,0:19:46.20,Main,,0,0,0,,Жай ғана адасып кетпеңіз!
Dialogue: 0,00:19:44.68,00:19:47.10,JPN TOP,,0,0,0,,Рұқсатсыз ешқайда шықпаңыз!
Dialogue: 0,0:19:46.64,0:19:47.70,Main,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,00:19:47.68,00:19:48.60,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,00:19:49.47,00:19:52.73,JPN TOP,,0,0,0,,Хмм... қандай қиын!
Dialogue: 0,0:19:50.00,0:19:51.67,Main,,0,0,0,,Қандай азап.
Dialogue: 0,0:20:03.20,0:20:04.49,Main,,0,0,0,,Сол жерде.
Dialogue: 0,00:20:04.28,00:20:05.53,JPN TOP,,0,0,0,,Бұдан әрі...
Dialogue: 0,0:20:07.36,0:20:09.79,Italics,,0,0,0,,Кіреберіс қай жерде?
Dialogue: 0,00:20:08.49,00:20:12.29,JPN TOP,,0,0,0,,Кіреберіс қай жерде? табылмады
Dialogue: 0,0:20:09.79,0:20:11.21,Italics,,0,0,0,,Мен оны таба алмаймын.
Dialogue: 0,0:20:13.42,0:20:15.45,Italics,,0,0,0,,Мен қазып ала алмаймын.
Dialogue: 0,00:20:14.42,00:20:16.34,JPN TOP,,0,0,0,,Төменгі... Қазу мүмкін емес
Dialogue: 0,00:20:16.46,00:20:17.29,JPN TOP,,0,0,0,,Ei
Dialogue: 0,0:20:16.78,0:20:19.43,Italics,,0,0,0,,Мен осы жолмен көтеріле аламын ба?
Dialogue: 0,00:20:17.92,00:20:20.59,JPN TOP,,0,0,0,,Біз мұнымен қандай да бір жолмен шыңға жете аламыз ба?
Dialogue: 0,00:20:21.63,00:20:22.72,JPN TOP,,0,0,0,,Ішек
Dialogue: 0,00:20:23.76,00:20:24.72,JPN TOP,,0,0,0,,Хмм
Dialogue: 0,00:20:25.59,00:20:26.55,JPN TOP,,0,0,0,,Уф
Dialogue: 0,00:20:27.35,00:20:28.72,JPN TOP,,0,0,0,,(Қатты желдің дыбысы)
Dialogue: 0,00:20:29.60,00:20:30.43,JPN TOP,,0,0,0,,Ах!
Dialogue: 0,00:20:32.56,00:20:33.52,JPN TOP,,0,0,0,,(Жерге құлаған дыбыс)
Dialogue: 0,00:20:34.31,00:20:35.35,JPN TOP,,0,0,0,,Уф
Dialogue: 0,00:20:35.48,00:20:36.44,JPN TOP,,0,0,0,,Инд өзені дельта аймағында орналасқан—
Dialogue: 0,00:20:38.82,00:20:39.98,JPN TOP,,0,0,0,,Иә
Dialogue: 0,0:20:39.03,0:20:39.80,Main,,0,0,0,,Мен іздемеймін!
Dialogue: 0,00:20:40.11,00:20:41.32,JPN TOP,,0,0,0,,Қарама!
Dialogue: 0,0:20:42.90,0:20:44.56,Main,,0,0,0,,Сәлеметсіз бе...
Dialogue: 0,00:20:43.95,00:20:45.45,JPN TOP,,0,0,0,,Сәлем... Чиваа
Dialogue: 0,00:20:45.57,00:20:46.62,JPN TOP,,0,0,0,,Ha
Dialogue: 0,0:20:46.22,0:20:48.23,Main,,0,0,0,,Сіз... мұны көрдіңіз бе?
Dialogue: 0,00:20:47.28,00:20:49.12,JPN TOP,,0,0,0,,Сіз... дәл қазір көрдіңіз бе?
Dialogue: 0,0:20:48.56,0:20:49.74,Main,,0,0,0,,Ято-чанға бұны қолдануға тым кеш.
Dialogue: 0,00:20:49.24,00:20:50.58,JPN TOP,,0,0,0,,Мен көрдім!
Dialogue: 0,0:20:49.74,0:20:51.49,Main,,0,0,0,,Бұл керемет болды!
Dialogue: 0,00:20:50.70,00:20:52.54,JPN TOP,,0,0,0,,Бұл керемет болды!
Dialogue: 0,0:20:52.58,0:20:54.77,Main,,0,0,0,,Әй, оны құпия сақтау керек пе?
Dialogue: 0,00:20:53.66,00:20:55.67,JPN TOP,,0,0,0,,Аа, оны құпия сақтағың келе ме?
Dialogue: 0,0:20:59.74,0:21:01.88,Main,,0,0,0,,Мына садақты маған бер.
Dialogue: 0,00:21:00.84,00:21:02.80,JPN TOP,,0,0,0,,Маған садақ беріңіз...
Dialogue: 0,00:21:02.92,00:21:05.18,JPN TOP,,0,0,0,,Не? иә
Dialogue: 0,0:21:03.42,0:21:04.28,Main,,0,0,0,,Жер
Dialogue: 0,0:21:06.00,0:21:08.65,Italics,,0,0,0,,Иә? Сіз бұл заттарды қайтадан қалай пайдаланасыз?
Dialogue: 0,00:21:07.05,00:21:09.72,JPN TOP,,0,0,0,,Мм... мұны қалай істеймін?
Dialogue: 0,0:21:09.50,0:21:11.25,Italics,,0,0,0,,Дұрыс, осылай.
Dialogue: 0,00:21:10.31,00:21:12.14,JPN TOP,,0,0,0,,А, міне, солай!
Dialogue: 0,0:21:11.56,0:21:14.65,Italics,,0,0,0,,Егер менде құс болса, мен сонда жете аламын.
Dialogue: 0,00:21:12.68,00:21:15.69,JPN TOP,,0,0,0,,Сол құсты алсаң, сол жаққа баруға болады.
Dialogue: 0,0:21:15.24,0:21:16.41,Italics,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,00:21:16.31,00:21:17.65,JPN TOP,,0,0,0,,Менің мұны істеуден басқа амалым жоқ.
Dialogue: 0,0:21:17.61,0:21:18.49,Main,,0,0,0,,Алдымен, ортаңғы және көрсеткі саусақтарыңызды осылайша қосыңыз,
Dialogue: 0,00:21:18.56,00:21:19.48,JPN TOP,,0,0,0,,Жарайды
Dialogue: 0,0:21:19.12,0:21:20.47,Main,,0,0,0,,«Жарайды» емес!
Dialogue: 0,00:21:20.02,00:21:21.36,JPN TOP,,0,0,0,,Жарайды... «жақсы» емес!
Dialogue: 0,00:21:21.48,00:21:24.61,JPN TOP,,0,0,0,,Эй... не істеп жатырсың!?
Dialogue: 0,0:21:21.84,0:21:23.71,Main,,0,0,0,,Бұл не үшін болды?!
Dialogue: 0,0:21:24.13,0:21:26.43,Main,,0,0,0,,Бұл менің серіктесім.
Dialogue: 0,00:21:25.20,00:21:27.28,JPN TOP,,0,0,0,,Бұл менің серіктесім.
Dialogue: 0,0:21:26.43,0:21:28.69,Main,,0,0,0,,Сіз мұны істей алмайсыз.
Dialogue: 0,00:21:27.41,00:21:29.57,JPN TOP,,0,0,0,,Жоқ, олай істеме.
Dialogue: 0,0:21:28.69,0:21:30.71,Main,,0,0,0,,Садағымды қайтар.
Dialogue: 0,00:21:29.70,00:21:31.62,JPN TOP,,0,0,0,,Әй, садағыңды қайтар.
Dialogue: 0,0:21:35.12,0:21:37.19,Main,,0,0,0,,H-Эй! Асылу!
Dialogue: 0,00:21:36.16,00:21:38.08,JPN TOP,,0,0,0,,Әй... Әй, күт!
Dialogue: 0,0:21:37.19,0:21:40.78,Main,,0,0,0,,Сіз сияқты адамдар жалғыз қалғанда ойыншықтармен ойнайды!
Dialogue: 0,00:21:38.21,00:21:41.92,JPN TOP,,0,0,0,,Егер сен сияқты біреу жалғыз болса, сен ойыншыққа айналасың.
Dialogue: 0,0:21:41.49,0:21:43.24,Main,,0,0,0,,Мен күтемін, айтшы...
Dialogue: 0,00:21:42.55,00:21:44.13,JPN TOP,,0,0,0,,Мен сізге айтамын.
Dialogue: 0,0:21:44.20,0:21:46.64,Main,,0,0,0,,Мен сонда қалай көтерілемін?
Dialogue: 0,00:21:45.26,00:21:47.68,JPN TOP,,0,0,0,,Ол жерге жету үшін не істеуім керек?
Dialogue: 0,0:21:47.72,0:21:49.54,Main,,0,0,0,,Мен білмеймін.
Dialogue: 0,00:21:48.80,00:21:50.47,JPN TOP,,0,0,0,,Жүр, мен білмеймін.
Dialogue: 0,0:21:49.54,0:21:50.45,Main,,0,0,0,,Мен де емес.
Dialogue: 0,0:21:50.45,0:21:51.70,Main,,0,0,0,,Мен де.
Dialogue: 0,00:21:50.60,00:21:52.68,JPN TOP,,0,0,0,,Мен де
Dialogue: 0,0:21:52.18,0:21:55.19,Main,,0,0,0,,Сіз өзіңіздің досыңыз Пиоранды іздеп жүрсіз, солай ма?
Dialogue: 0,00:21:53.27,00:21:56.10,JPN TOP,,0,0,0,,Менің ойымша, сіз Пиоран есімді серіктес іздеп жүрсіз.
Dialogue: 0,0:21:55.45,0:21:57.37,Main,,0,0,0,,Бұл өкінішті.
Dialogue: 0,00:21:56.23,00:21:58.27,JPN TOP,,0,0,0,,Бұл ұят болар еді.
Dialogue: 0,0:21:57.37,0:22:00.73,Main,,0,0,0,,Сіз оны тапсаңыз да, ол шықпайды.
Dialogue: 0,00:21:58.40,00:22:01.19,JPN TOP,,0,0,0,,Біз оны кездестірсек те, ол көшеге шыға алмайды.
Dialogue: 0,00:22:01.31,00:22:02.11,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:22:01.51,0:22:03.77,Main,,0,0,0,,Қатыгез, өтелмейтін кісі өлтірушілер әкелінді
Dialogue: 0,00:22:02.23,00:22:03.57,JPN TOP,,0,0,0,,Бұл арал
Dialogue: 0,00:22:03.69,00:22:08.11,JPN TOP,,0,0,0,,Біз әлемнің түкпір-түкпірінен тәртіпсіз, қатыгез кісі өлтірушілерді жинап жатырмыз.
Dialogue: 0,0:22:03.77,0:22:06.82,Main,,0,0,0,,осы аралда сақтау керек барлық жерден.
Dialogue: 0,0:22:07.23,0:22:09.47,Main,,0,0,0,,Бұл түрме аралы.
Dialogue: 0,00:22:08.24,00:22:10.49,JPN TOP,,0,0,0,,Түрме аралы, былайша айтқанда.
Dialogue: 0,0:22:09.47,0:22:14.47,Main,,0,0,0,,Бұл жерде тұтқын болған соң, шығу мүмкін емес.
Dialogue: 0,00:22:10.62,00:22:12.83,JPN TOP,,0,0,0,,Бірде сіз мұнда тұтқын ретінде болғансыз
Dialogue: 0,00:22:12.95,00:22:15.37,JPN TOP,,0,0,0,,Сіз енді ешқашан көшеге шыға алмайсыз.
Dialogue: 0,0:22:14.80,0:22:17.10,Main,,0,0,0,,Олар сіздің қолыңызды таңбалаған кезде есіңізде ме?
Dialogue: 0,00:22:15.50,00:22:18.00,JPN TOP,,0,0,0,,Сіз қолыңызды брендке алдыңыз, солай ма?
Dialogue: 0,0:22:17.10,0:22:19.03,Main,,0,0,0,,Бұл сізді тұтқын ретінде көрсетеді.
Dialogue: 0,00:22:18.12,00:22:20.42,JPN TOP,,0,0,0,,Бұл тұтқынның белгісі.
Dialogue: 0,0:22:19.46,0:22:23.60,Main,,0,0,0,,Оның бренді бар болса, ол мұнда тұтқын.
Dialogue: 0,00:22:20.54,00:22:24.50,JPN TOP,,0,0,0,,Бұл белгі бар болса, ол осында тұрады.
Dialogue: 0,0:22:23.80,0:22:26.99,Main,,0,0,0,,Тұтқын?! Бізді осында әкелген сен едің!
Dialogue: 0,00:22:24.63,00:22:27.88,JPN TOP,,0,0,0,,Сіз тұтқынды әкелдіңіз, солай ма?
Dialogue: 0,0:22:27.24,0:22:28.38,Main,,0,0,0,,Менің жаманым!
Dialogue: 0,00:22:28.01,00:22:31.55,JPN TOP,,0,0,0,,Кешіріңіз, кешіріңіз! Мен қателестім, шынымен.
Dialogue: 0,0:22:28.38,0:22:30.66,Main,,0,0,0,,Бұл қате болды, ант етемін.
Dialogue: 0,0:22:30.66,0:22:31.91,Main,,0,0,0,,Мені ренжітпе.
Dialogue: 0,00:22:31.68,00:22:34.26,JPN TOP,,0,0,0,,Алданбаңыз! Ондай нәрсе бар ма?
Dialogue: 0,0:22:31.91,0:22:33.36,Main,,0,0,0,,Бұл қате болмады!
Dialogue: 0,0:22:38.96,0:22:41.22,Main,,0,0,0,,Олай болса мен сізге өтеуге рұқсат етіңіз.
Dialogue: 0,00:22:40.02,00:22:42.56,JPN TOP,,0,0,0,,Олай болса, кешірім сұрауыма рұқсат етіңіз.
Dialogue: 0,0:22:41.64,0:22:46.84,Main,,0,0,0,,Мен сізге тілегіңізді орындаудың бір нақты әдісін айтайын.
Dialogue: 0,00:22:42.69,00:22:48.15,JPN TOP,,0,0,0,,Мен сізге тілектеріңізді орындаудың жалғыз нақты жолын көрсетемін.
Dialogue: 0,0:22:50.43,0:22:51.66,Main,,0,0,0,,Міне!
Dialogue: 0,00:22:51.28,00:22:52.70,JPN TOP,,0,0,0,,Міне!
Dialogue: 0,0:22:53.45,0:22:56.49,Main,,0,0,0,,Бұл алаңда жеңіске жету керек.
Dialogue: 0,00:22:54.49,00:22:57.58,JPN TOP,,0,0,0,,...
Dialogue: 0,00:23:01.04,00:23:06.00,JPN TOP,,0,0,0,,♪~
Dialogue: 0,00:24:25.92,00:24:30.88,JPN TOP,,0,0,0,,~♪
Dialogue: 0,0:24:29.99,0:24:51.01,sign_35245_236_Preview,,0,0,0,,Алдын ала қарау
