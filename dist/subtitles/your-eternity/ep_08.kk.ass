Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.06,0:00:06.38,Main,,0,0,0,,Рахмет! Pioran сізге сыйлық әкелді!
Dialogue: 0,00:00:02.08,00:00:04.67,JPN TOP,,0,0,0,,Бұл Pioran сізге арналған.
Dialogue: 0,00:00:04.75,00:00:07.50,JPN TOP,,0,0,0,,Мен саған кәдесый әкелдім.
Dialogue: 0,0:00:07.19,0:00:10.08,Main,,0,0,0,,Өлмейтін ақымақ!
Dialogue: 0,00:00:08.00,00:00:11.21,JPN TOP,,0,0,0,,Бұл өлмейтін құбыжық.
Dialogue: 0,0:00:12.18,0:00:17.21,Narration,,0,0,0,,Фуши Такунаха жерінде бір баланы кездестіреді.
Dialogue: 0,00:00:13.51,00:00:15.05,JPN TOP,,0,0,0,,Такнач жерінде
Dialogue: 0,00:00:15.14,00:00:18.43,JPN TOP,,0,0,0,,Фуши бір баланы кездестіреді
Dialogue: 0,0:00:18.15,0:00:20.48,Narration,,0,0,0,,Оның есімі Гугу.
Dialogue: 0,00:00:19.18,00:00:21.64,JPN TOP,,0,0,0,,Оның есімі Гу Гу
Dialogue: 0,0:00:21.83,0:00:25.85,Narration,,0,0,0,,Жарақат алған бетін масканың артына жасырады
Dialogue: 0,00:00:22.81,00:00:27.02,JPN TOP,,0,0,0,,Гу Гу жарақат алған бетін маскамен жасырды.
Dialogue: 0,0:00:26.83,0:00:29.45,Narration,,0,0,0,,және өзін құбыжық деп атайды.
Dialogue: 0,00:00:27.90,00:00:30.61,JPN TOP,,0,0,0,,Өзіңізді құбыжық деп атаңыз
Dialogue: 0,0:00:30.36,0:00:33.58,Narration,,0,0,0,,Ол Фушиге інісіндей қамқорлық жасайды.
Dialogue: 0,00:00:31.23,00:00:34.53,JPN TOP,,0,0,0,,Мен Фушиді інімдей жақсы көрдім.
Dialogue: 0,0:00:37.05,0:00:42.76,Narration,,0,0,0,,Фушидің Гугу, Пиоран және Буузмен бірге тұратын уақыты,
Dialogue: 0,00:00:38.16,00:00:43.71,JPN TOP,,0,0,0,,Гу Гу Пиоран Саке қартпен бірге тұрады
Dialogue: 0,0:00:43.96,0:00:51.70,Narration,,0,0,0,,, сондай-ақ оның Реанмен достығы оны одан әрі ынталандыруға мүмкіндік береді.
Dialogue: 0,00:00:45.00,00:00:48.54,JPN TOP,,0,0,0,,Және Линмен әрекеттесу
Dialogue: 0,00:00:49.04,00:00:52.84,JPN TOP,,0,0,0,,Фушиге қосымша ынталандыру
Dialogue: 0,00:00:58.05,00:01:02.85,JPN TOP,,0,0,0,,♪~
Dialogue: 0,00:02:22.93,00:02:27.93,JPN TOP,,0,0,0,,~♪
Dialogue: 0,0:02:28.89,0:02:30.95,Main,,0,0,0,,Менде тамаша идея бар!
Dialogue: 0,00:02:29.94,00:02:31.90,JPN TOP,,0,0,0,,Мен жақсы нәрсе ойладым.
Dialogue: 0,0:02:30.95,0:02:33.47,Main,,0,0,0,,Мен де осында жұмыс істеймін.
Dialogue: 0,00:02:31.98,00:02:34.40,JPN TOP,,0,0,0,,Мен де осында жұмыс істеймін!
Dialogue: 0,00:02:34.48,00:02:37.86,JPN TOP,,0,0,0,,Аа... Шынымен, кішкентай қыз?
Dialogue: 0,0:02:34.96,0:02:36.91,Main,,0,0,0,,Сіз сенімдісіз бе, жас ханым?
Dialogue: 0,0:02:37.13,0:02:37.95,Main,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,00:02:37.94,00:02:41.49,JPN TOP,,0,0,0,,Иә, мен сізден сұрайын дегенім бар.
Dialogue: 0,0:02:37.95,0:02:40.56,Main,,0,0,0,,Менің де өтінішім бар.
Dialogue: 0,0:02:40.88,0:02:43.51,Main,,0,0,0,,Маған осында тұруға рұқсат бересіз бе?
Dialogue: 0,00:02:41.99,00:02:44.53,JPN TOP,,0,0,0,,Маған осында тұруға рұқсат бересіз бе?
Dialogue: 0,00:02:44.62,00:02:45.74,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:02:44.97,0:02:47.39,Main,,0,0,0,,Мен төлем сұрамаймын.
Dialogue: 0,00:02:45.83,00:02:48.33,JPN TOP,,0,0,0,,Маған бос ақша керек емес.
Dialogue: 0,0:02:47.39,0:02:51.45,Main,,0,0,0,,Мен осындай сүйкімді қыздың бізбен жұмыс істегеніне қуанышты болар едім.
Dialogue: 0,00:02:48.41,00:02:52.33,JPN TOP,,0,0,0,,Менің осындай сүйкімді қызға деген тілегім орындалады.
Dialogue: 0,0:02:51.45,0:02:52.68,Main,,0,0,0,,Енді шешілді!
Dialogue: 0,00:02:52.42,00:02:56.21,JPN TOP,,0,0,0,,Шешілді! Онда дайындал, мен ертең қайтамын.
Dialogue: 0,0:02:52.68,0:02:55.28,Main,,0,0,0,,Мен дайындалып, ертең қайтамын!
Dialogue: 0,00:02:58.13,00:02:59.47,JPN TOP,,0,0,0,,Хе...
Dialogue: 0,0:02:59.34,0:03:03.03,Main,,0,0,0,,Оның осында болатынына сенімдісің бе, Бооз адам?
Dialogue: 0,00:03:00.38,00:03:03.89,JPN TOP,,0,0,0,,Сіз бұл қызды Саке-одзи деп атағаныңызға сенімдісіз бе?
Dialogue: 0,0:03:03.03,0:03:05.51,Main,,0,0,0,,Неліктен жоқ? Бізде бөлмелер жеткілікті.
Dialogue: 0,00:03:03.97,00:03:06.35,JPN TOP,,0,0,0,,Ей, орын жеткілікті.
Dialogue: 0,0:03:05.51,0:03:07.40,Main,,0,0,0,,Болмаудың басқа себебі бар ма?
Dialogue: 0,00:03:06.43,00:03:08.31,JPN TOP,,0,0,0,,Басқа мәселелер бар ма?
Dialogue: 0,0:03:07.40,0:03:10.08,Main,,0,0,0,,N-Жоқ, маған бәрібір.
Dialogue: 0,00:03:08.39,00:03:11.06,JPN TOP,,0,0,0,,Жоқ... жоқ, мен емес...
Dialogue: 0,0:03:10.78,0:03:15.76,Main,,0,0,0,,Айтыңызшы, Фуши, оның алдында қабілеттеріңізді жасырғаныңыз жөн.
Dialogue: 0,00:03:11.56,00:03:13.44,JPN TOP,,0,0,0,,Ал сіз ше?
Dialogue: 0,00:03:13.52,00:03:16.69,JPN TOP,,0,0,0,,Сол қыздың алдында қабілеттеріңізді жасырыңыз.
Dialogue: 0,0:03:15.76,0:03:16.81,Main,,0,0,0,,Тағы бір қосымша сабақ па, қазірден-ақ?
Dialogue: 0,00:03:16.77,00:03:17.73,JPN TOP,,0,0,0,,Неліктен?
Dialogue: 0,0:03:17.18,0:03:21.42,Main,,0,0,0,,Мен оны таң қалдырып, дүкеннің беделін түсіре алмаймын.
Dialogue: 0,00:03:18.23,00:03:22.32,JPN TOP,,0,0,0,,Мен таңғалып, дүкеннің аты жаман болып кетсе, көмектесе алмаймын.
Dialogue: 0,0:03:21.42,0:03:23.68,Main,,0,0,0,,Бұл әрқашан жаман болды.
Dialogue: 0,00:03:22.41,00:03:24.57,JPN TOP,,0,0,0,,Басынан жаман шығар.
Dialogue: 0,00:03:24.66,00:03:27.74,JPN TOP,,0,0,0,,Хахахаха... Мен солай айтамын~
Dialogue: 0,0:03:26.18,0:03:27.82,Main - Top,,0,0,0,,Ой!
Dialogue: 0,0:03:26.76,0:03:32.21,Italics,,0,0,0,,Ертеңнен бастап қуанарымды немесе бақытсыз болатынымды білмеймін.
Dialogue: 0,00:03:27.83,00:03:30.91,JPN TOP,,0,0,0,,Мен ертеңнен бастап бақытты боламын ба?
Dialogue: 0,00:03:31.00,00:03:33.42,JPN TOP,,0,0,0,,Әлде қиындай ма?
Dialogue: 0,0:03:33.23,0:03:37.23,Episode_Title,,0,0,0,,Құбыжық ағайындылар
Dialogue: 0,0:03:39.68,0:03:41.64,Main,,0,0,0,,Дайын тағамдар.
Dialogue: 0,00:03:40.76,00:03:42.51,JPN TOP,,0,0,0,,Пластинаның соңы
Dialogue: 0,0:03:41.64,0:03:42.32,Main,,0,0,0,,Алдымен, ортаңғы және көрсеткі саусақтарыңызды осылайша қосыңыз,
Dialogue: 0,00:03:42.59,00:03:43.64,JPN TOP,,0,0,0,,О
Dialogue: 0,00:03:43.72,00:03:48.35,JPN TOP,,0,0,0,,Аа, сыртқы түріңді өзгертуден басқа не істей аласың?
Dialogue: 0,0:03:43.76,0:03:47.41,Main,,0,0,0,,Әй, пішінді өзгертуден басқа не істей аласың?
Dialogue: 0,0:03:47.64,0:03:49.24,Main,,0,0,0,,Тик-так, сағат тілі тик-так
Dialogue: 0,00:03:48.43,00:03:50.14,JPN TOP,,0,0,0,,Шынында да. Мен оны жеңілдетіп бағаладым. Шынында да жеңілдетіп бағаладым
Dialogue: 0,0:03:49.24,0:03:51.42,Main,,0,0,0,,Мен мұны естуден шаршадым.
Dialogue: 0,00:03:50.23,00:03:52.31,JPN TOP,,0,0,0,,Мен бұл жауапты естуден шаршадым.
Dialogue: 0,0:03:51.42,0:03:54.21,Main,,0,0,0,,Маған бұрын көрмеген нәрсені көрсетіңіз.
Dialogue: 0,00:03:52.39,00:03:55.36,JPN TOP,,0,0,0,,Маған әлі көрмеген нәрсені көрсетіңіз
Dialogue: 0,0:04:00.62,0:04:02.70,Main,,0,0,0,,Ой! Найза!
Dialogue: 0,00:04:01.74,00:04:03.86,JPN TOP,,0,0,0,,Керемет! Бұл найза
Dialogue: 0,0:04:03.03,0:04:05.84,Main,,0,0,0,,Сіз қашаннан бері мұны істей алдыңыз?
Dialogue: 0,00:04:03.95,00:04:06.78,JPN TOP,,0,0,0,,Бұл қашаннан бері мүмкін болды?
Dialogue: 0,0:04:06.17,0:04:07.53,Main,,0,0,0,,Тик-так, сағат тілі тик-так
Dialogue: 0,00:04:07.28,00:04:08.83,JPN TOP,,0,0,0,,Шынында да. Мен оны жеңілдетіп бағаладым. Шынында да жеңілдетіп бағаладым
Dialogue: 0,0:04:07.96,0:04:11.07,Main,,0,0,0,,Мен w-қалаған кезде шығады.
Dialogue: 0,00:04:08.91,00:04:12.00,JPN TOP,,0,0,0,,Хо... мен қалаған кезде шығады.
Dialogue: 0,0:04:11.33,0:04:13.02,Main,,0,0,0,,Уау.
Dialogue: 0,00:04:12.08,00:04:13.87,JPN TOP,,0,0,0,,А...
Dialogue: 0,0:04:13.02,0:04:16.57,Main,,0,0,0,,Олай болса, мына тостағанды ​​жасай аласыз ба?
Dialogue: 0,00:04:13.96,00:04:17.50,JPN TOP,,0,0,0,,Мәселен, сіз мына тостағанды ​​жасай аласыз ба?
Dialogue: 0,0:04:16.90,0:04:18.14,Main,,0,0,0,,Мен алмаймын.
Dialogue: 0,00:04:18.00,00:04:19.00,JPN TOP,,0,0,0,,Жасалмайды
Dialogue: 0,0:04:18.14,0:04:19.05,Main,,0,0,0,,Неге болмайды?
Dialogue: 0,00:04:19.09,00:04:20.46,JPN TOP,,0,0,0,,Неліктен?
Dialogue: 0,0:04:19.45,0:04:20.70,Main,,0,0,0,,Тик-так, сағат тілі тик-так
Dialogue: 0,00:04:20.55,00:04:21.63,JPN TOP,,0,0,0,,Шынында да. Мен оны жеңілдетіп бағаладым. Шынында да жеңілдетіп бағаладым
Dialogue: 0,0:04:21.01,0:04:24.73,Main,,0,0,0,,Ей, мен сенің өлмейтін нәрсе істегеніңді әлі көрмедім.
Dialogue: 0,00:04:22.13,00:04:24.13,JPN TOP,,0,0,0,,Ах, сен өлмейтін сияқтысың.
Dialogue: 0,00:04:24.22,00:04:25.68,JPN TOP,,0,0,0,,Оны әлі көрген жоқпын
Dialogue: 0,00:04:28.01,00:04:28.85,JPN TOP,,0,0,0,,Иә...
Dialogue: 0,0:04:31.53,0:04:32.67,Main,,0,0,0,,Ой.
Dialogue: 0,00:04:32.60,00:04:33.60,JPN TOP,,0,0,0,,Мен қалаймын
Dialogue: 0,0:04:33.60,0:04:36.15,Main,,0,0,0,,Уау! Сіздің жараңыз жабылады.
Dialogue: 0,00:04:34.64,00:04:37.31,JPN TOP,,0,0,0,,Керемет! Жара жазылады!
Dialogue: 0,00:04:38.77,00:04:39.61,JPN TOP,,0,0,0,,Ах!
Dialogue: 0,0:04:39.88,0:04:42.43,Main,,0,0,0,,Дәл солай! Сіз заттарды жасай аласыз!
Dialogue: 0,00:04:40.94,00:04:43.36,JPN TOP,,0,0,0,,Дәл солай! Сіз жасай аласыз, солай ма?
Dialogue: 0,0:04:43.00,0:04:44.38,Main,,0,0,0,,Мен біреуін жасадым.
Dialogue: 0,00:04:44.28,00:04:45.32,JPN TOP,,0,0,0,,Жасалған
Dialogue: 0,0:04:44.81,0:04:47.12,Main,,0,0,0,,Мен оның жұмыс істеуіне не себеп болды деп ойлаймын.
Dialogue: 0,00:04:45.86,00:04:48.03,JPN TOP,,0,0,0,,Қандай шарттар бар?
Dialogue: 0,0:04:47.12,0:04:49.86,Main,,0,0,0,,Жарақат алған кезде ме, әлде бірдеңе ме?
Dialogue: 0,00:04:48.12,00:04:50.99,JPN TOP,,0,0,0,,Сіз бұл ауруға жауап береді деп ойладыңыз ба?
Dialogue: 0,0:04:51.44,0:04:52.86,Main,,0,0,0,,Мысалы, осылай.
Dialogue: 0,00:04:52.50,00:04:53.79,JPN TOP,,0,0,0,,Мысалы, бұл
Dialogue: 0,0:04:53.31,0:04:56.10,Main,,0,0,0,,Егер ол ыстық болса, от жаға аласыз ба?
Dialogue: 0,00:04:54.37,00:04:57.04,JPN TOP,,0,0,0,,Ыстық сезінсеңіз, сіз де от жаға аласыз ба?
Dialogue: 0,0:04:58.02,0:04:59.52,Main,,0,0,0,,Тәжірибе жасайық.
Dialogue: 0,00:04:59.09,00:05:01.75,JPN TOP,,0,0,0,,Кішігірім тәжірибе... Әй!
Dialogue: 0,00:05:08.30,00:05:09.43,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:05:08.84,0:05:10.18,Main,,0,0,0,,Тек таяқша ма?
Dialogue: 0,00:05:09.93,00:05:12.97,JPN TOP,,0,0,0,,Жай ғана таяқ па? Сіз от жаға алмайсыз ба?
Dialogue: 0,0:05:10.18,0:05:12.03,Main,,0,0,0,,Сіз от жаға алмайсыз ба?
Dialogue: 0,0:05:12.03,0:05:15.79,Main,,0,0,0,,Бұл от жағуды жеңілдететін еді.
Dialogue: 0,00:05:13.06,00:05:16.89,JPN TOP,,0,0,0,,Мен мұны істей алсам, от жағу оңайырақ болар еді.
Dialogue: 0,00:05:19.15,00:05:22.69,JPN TOP,,0,0,0,,Иә? Бұл қандай бет?
Dialogue: 0,0:05:19.55,0:05:21.76,Main,,0,0,0,,Бет немен байланысты?
Dialogue: 0,0:05:22.02,0:05:23.55,Main,,0,0,0,,Бұл сені өлтіретін сияқты емес.
Dialogue: 0,00:05:22.78,00:05:26.20,JPN TOP,,0,0,0,,Өлмейсің, неге көңіл-күйің жоқ?
Dialogue: 0,0:05:23.55,0:05:25.25,Main,,0,0,0,,Неге сонша ренжідің?
Dialogue: 0,0:05:25.63,0:05:29.07,Main,,0,0,0,,Бірдеңені тоқтатқың келсе айт, ақымақ.
Dialogue: 0,00:05:26.74,00:05:30.07,JPN TOP,,0,0,0,,Ұнамаса, жоқ деп айт, ақымақ.
Dialogue: 0,0:05:29.07,0:05:31.01,Main,,0,0,0,,Ия, бұл жай ғана эксперимент.
Dialogue: 0,00:05:30.16,00:05:31.95,JPN TOP,,0,0,0,,Тек эксперимент
Dialogue: 0,0:05:32.24,0:05:34.36,Main,,0,0,0,,Жарайды. Түсіндім.
Dialogue: 0,00:05:33.24,00:05:36.71,JPN TOP,,0,0,0,,Иә, түсіндім, есімде.
Dialogue: 0,0:05:34.36,0:05:35.77,Main,,0,0,0,,Мен үйрендім.
Dialogue: 0,0:06:04.85,0:06:06.12,Main,,0,0,0,,Міне, мен!
Dialogue: 0,00:06:05.94,00:06:09.99,JPN TOP,,0,0,0,,Міне! Бүгіннен бастап сіздермен жұмыс істеуді асыға күтеміз!
Dialogue: 0,0:06:06.49,0:06:09.15,Main,,0,0,0,,Мен осында жұмыс істеуді асыға күтемін.
Dialogue: 0,0:06:09.15,0:06:10.89,Main,,0,0,0,,Иә? Фуши-сан қайда?
Dialogue: 0,00:06:10.07,00:06:11.82,JPN TOP,,0,0,0,,Иә? Фуши ше?
Dialogue: 0,0:06:10.89,0:06:13.36,Main,,0,0,0,,Білмеймін. Мен оны күні бойы көрмедім.
Dialogue: 0,00:06:11.91,00:06:14.24,JPN TOP,,0,0,0,,Жарайды, таңнан бері көрмедім.
Dialogue: 0,0:06:13.36,0:06:16.10,Main,,0,0,0,,Түскі асқа дейін қайтып келетініне сенімдімін.
Dialogue: 0,00:06:14.33,00:06:17.04,JPN TOP,,0,0,0,,Менің ойымша, сіз кешкі асқа дейін қайтасыз.
Dialogue: 0,0:06:16.10,0:06:18.96,Main,,0,0,0,,Біз бүгін оның сүйікті ет тағамдарын жасаймыз.
Dialogue: 0,00:06:17.12,00:06:20.00,JPN TOP,,0,0,0,,Бүгін Фушидің сүйікті ет тағамы.
Dialogue: 0,0:06:18.96,0:06:20.86,Main,,0,0,0,,Шынымен бе? Мен қуаныштымын.
Dialogue: 0,00:06:20.08,00:06:21.79,JPN TOP,,0,0,0,,Иә, бұл жақсы болды.
Dialogue: 0,0:06:21.17,0:06:24.22,Main,,0,0,0,,Бұл туралы айтатын болсақ, қолыңыздағы жарақат қалай?
Dialogue: 0,00:06:22.29,00:06:25.09,JPN TOP,,0,0,0,,Айтпақшы, қолыңдағы жараға не болды?
Dialogue: 0,0:06:24.22,0:06:27.17,Main,,0,0,0,,Менің ойымша, кетуге біраз уақыт кетеді.
Dialogue: 0,00:06:25.17,00:06:28.17,JPN TOP,,0,0,0,,Жоғалу үшін біраз уақыт қажет сияқты.
Dialogue: 0,0:06:27.17,0:06:30.77,Main,,0,0,0,,Бірақ маған берген тәтті қиярлар дәмді болды.
Dialogue: 0,00:06:28.26,00:06:31.93,JPN TOP,,0,0,0,,Бірақ мен алған тәтті маринадталған тағам өте дәмді болды.
Dialogue: 0,0:06:31.62,0:06:33.70,Main,,0,0,0,,Бұл жара үш ай бұрын болған, солай ма?
Dialogue: 0,00:06:32.64,00:06:36.89,JPN TOP,,0,0,0,,Үш ай бұрынғы жара болса, оны тез арада жабу керек емес пе?
Dialogue: 0,0:06:33.70,0:06:35.98,Main,,0,0,0,,Менің ойымша, ол тезірек сауығып кетуі керек.
Dialogue: 0,0:06:35.98,0:06:37.87,Main,,0,0,0,,Ол әлі жоқ дейді.
Dialogue: 0,00:06:36.97,00:06:40.39,JPN TOP,,0,0,0,,Бірақ мен бұл туралы бірдеңе істегім келеді.
Dialogue: 0,0:06:37.87,0:06:39.69,Main,,0,0,0,,Мен оған көмектескім келеді.
Dialogue: 0,0:06:40.30,0:06:41.84,Main,,0,0,0,,Менде бір нәрсе бар.
Dialogue: 0,00:06:40.48,00:06:43.94,JPN TOP,,0,0,0,,Хмм... Менде жақсы нәрсе бар. Онда отырыңыз.
Dialogue: 0,0:06:41.84,0:06:43.00,Main,,0,0,0,,Онда отырыңыз.
Dialogue: 0,0:06:44.51,0:06:45.82,Main,,0,0,0,,Мұның бәрі тек менің алаңдаған жүрегімді жылдамдатты
Dialogue: 0,00:06:44.69,00:06:46.86,JPN TOP,,0,0,0,,Иә? Сен не істеп жатырсың?
Dialogue: 0,00:06:52.03,00:06:52.91,JPN TOP,,0,0,0,,Мен қай жерде жаттығып жүргенімді ойлайсың?
Dialogue: 0,00:07:02.50,00:07:04.63,JPN TOP,,0,0,0,,А... а...
Dialogue: 0,0:07:05.33,0:07:06.37,Main,,0,0,0,,түн
Dialogue: 0,00:07:06.38,00:07:07.30,JPN TOP,,0,0,0,,Шабуыл
Dialogue: 0,0:07:06.98,0:07:09.20,Main,,0,0,0,,Жоғары дистилденген спирт.
Dialogue: 0,00:07:08.05,00:07:10.17,JPN TOP,,0,0,0,,Жоғары таза спирт
Dialogue: 0,0:07:09.20,0:07:12.10,Main,,0,0,0,,Мұны Реанның жарасына жағыңыз.
Dialogue: 0,00:07:10.26,00:07:13.05,JPN TOP,,0,0,0,,Мұны Линнің жараларына жағыңыз.
Dialogue: 0,0:07:12.10,0:07:14.56,Main,,0,0,0,,Неге-Неге меннен шықты?!
Dialogue: 0,00:07:13.14,00:07:15.47,JPN TOP,,0,0,0,,Ех! Неге мен?
Dialogue: 0,0:07:14.56,0:07:16.62,Main,,0,0,0,,Мен саған мүше қостым.
Dialogue: 0,00:07:15.56,00:07:17.56,JPN TOP,,0,0,0,,Бір мүшені ұлғайтты
Dialogue: 0,0:07:16.85,0:07:21.90,Main,,0,0,0,,Мен әрқашан адам ағзасында ішімдік сақтаған кезде не болатынын көргім келді.
Dialogue: 0,00:07:17.64,00:07:20.64,JPN TOP,,0,0,0,,Адамның ішінде сақталған спиртпен не болады?
Dialogue: 0,00:07:20.73,00:07:22.85,JPN TOP,,0,0,0,,Мен әрқашан білгім келді
Dialogue: 0,0:07:21.90,0:07:25.13,Main,,0,0,0,,Бұл сирек кездесетін нәрсе! Тіпті энтузиастарға сату ойымда да жоқ.
Dialogue: 0,00:07:22.94,00:07:26.07,JPN TOP,,0,0,0,,Бұл сирек кездеседі. Мен оны энтузиастарға сатқым келмейді.
Dialogue: 0,0:07:25.13,0:07:26.55,Main,,0,0,0,,Бұл менің ойым емес.
Dialogue: 0,00:07:26.15,00:07:27.44,JPN TOP,,0,0,0,,Олай емес!
Dialogue: 0,0:07:26.55,0:07:29.62,Main,,0,0,0,,Маған неге олай істедің деп сұраймын!
Dialogue: 0,00:07:27.53,00:07:30.57,JPN TOP,,0,0,0,,Маған неге олай істедің деп сұрайсың ба?
Dialogue: 0,0:07:29.81,0:07:32.44,Main,,0,0,0,,Әзіл мен шабыттың көрінісі.
Dialogue: 0,00:07:30.65,00:07:33.32,JPN TOP,,0,0,0,,Әзілге және шабытқа жету
Dialogue: 0,0:07:32.44,0:07:35.01,Main,,0,0,0,,Қызығушылығыма ердім деуге болады.
Dialogue: 0,00:07:33.41,00:07:35.91,JPN TOP,,0,0,0,,Бұл қызығушылыққа ұмтылу туралы.
Dialogue: 0,0:07:35.01,0:07:37.39,Main,,0,0,0,,Сенде бәрі жақсы. Ол сені өлтірмейді.
Dialogue: 0,00:07:35.99,00:07:38.33,JPN TOP,,0,0,0,,Жарайды, мен өлмеймін.
Dialogue: 0,00:07:40.37,00:07:42.04,JPN TOP,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,00:07:42.12,00:07:44.00,JPN TOP,,0,0,0,,(Гу-Гудың ауыр тыныс алуы)
Dialogue: 0,0:07:42.98,0:07:44.01,Main,,0,0,0,,Құдайым, маған көмектес
Dialogue: 0,0:07:44.01,0:07:46.70,Main,,0,0,0,,Мен бұл қарғыс атқыр жерден кетемін!
Dialogue: 0,00:07:44.08,00:07:44.96,JPN TOP,,0,0,0,,Не болды!
Dialogue: 0,00:07:45.04,00:07:47.63,JPN TOP,,0,0,0,,Мен бұл жерден кетемін!
Dialogue: 0,0:07:46.70,0:07:48.23,Main,,0,0,0,,Дүкенші мырза!
Dialogue: 0,00:07:47.71,00:07:49.51,JPN TOP,,0,0,0,,Қызметкер!
Dialogue: 0,00:07:55.97,00:07:58.10,JPN TOP,,0,0,0,,
Dialogue: 0,0:08:04.74,0:08:06.51,Main,,0,0,0,,Сіз оның ішегіне спирт жасадыңыз ба?
Dialogue: 0,00:08:05.77,00:08:08.94,JPN TOP,,0,0,0,,Асқазанда алкоголь бар ма? Неге олай істедің?
Dialogue: 0,0:08:06.51,0:08:08.00,Main,,0,0,0,,Неліктен мұндай әрекетке барар едіңіз?
Dialogue: 0,0:08:08.29,0:08:12.44,Main,,0,0,0,,Мен оны өлім аузында көргенде қарсы тұра алмадым.
Dialogue: 0,00:08:09.03,00:08:13.32,JPN TOP,,0,0,0,,Өлім аузында тұрған әлгі жігітті көргенде мен өз қалауымды баса алмадым.
Dialogue: 0,0:08:12.44,0:08:16.06,Main,,0,0,0,,Мен бұл менің әрқашан армандаған арманымды орындау мүмкіндігім деп ойладым.
Dialogue: 0,00:08:13.40,00:08:16.95,JPN TOP,,0,0,0,,Өмір бойғы арманын орындауға мүмкіндік деп ойладым.
Dialogue: 0,0:08:16.06,0:08:19.64,Main,,0,0,0,,Бұл бала сіздің жаңа ойыншығыңыз болды.
Dialogue: 0,00:08:17.03,00:08:20.58,JPN TOP,,0,0,0,,Ол сенің жаңа ойыншығың болды.
Dialogue: 0,0:08:19.87,0:08:21.05,Main,,0,0,0,,Сіз сұмдықсыз!
Dialogue: 0,00:08:20.66,00:08:21.95,JPN TOP,,0,0,0,,Бұл қорқынышты!
Dialogue: 0,0:08:21.05,0:08:24.02,Main,,0,0,0,,Оның артынан барыңыз да, дәл қазір ішіндегі затты алып тастаңыз!
Dialogue: 0,00:08:22.04,00:08:24.96,JPN TOP,,0,0,0,,Дәл қазір мені қуып, ішімдегіні ал.
Dialogue: 0,0:08:24.29,0:08:25.80,Main,,0,0,0,,Мен білмеймін...
Dialogue: 0,00:08:25.04,00:08:26.71,JPN TOP,,0,0,0,,Бірақ...
Dialogue: 0,0:08:25.80,0:08:28.32,Main,,0,0,0,,Менің жұмысым бар.
Dialogue: 0,00:08:26.79,00:08:29.13,JPN TOP,,0,0,0,,Менің жұмысым бар.
Dialogue: 0,0:08:28.32,0:08:30.31,Main,,0,0,0,,Сіздің жұмысыңыз тозақ болсын!
Dialogue: 0,00:08:29.21,00:08:31.13,JPN TOP,,0,0,0,,Не, жұмыс!
Dialogue: 0,0:08:30.31,0:08:32.49,Main,,0,0,0,,Мен үшін баруға қарсы боласыз ба?
Dialogue: 0,00:08:31.21,00:08:33.42,JPN TOP,,0,0,0,,Ханым, келе аласыз ба?
Dialogue: 0,0:08:33.35,0:08:34.80,Main,,0,0,0,,Мен?
Dialogue: 0,00:08:33.51,00:08:35.68,JPN TOP,,0,0,0,,Не, мен?
Dialogue: 0,00:08:35.76,00:08:38.60,JPN TOP,,0,0,0,,Хмм... Маған ұнамайды.
Dialogue: 0,0:08:35.86,0:08:37.71,Main,,0,0,0,,Мен қарсы емес едім, бірақ...
Dialogue: 0,0:08:37.71,0:08:40.04,Main,,0,0,0,,Мен Шопбой мырзаны жақсы білмеймін.
Dialogue: 0,00:08:38.68,00:08:40.97,JPN TOP,,0,0,0,,Мен кеңсе қызметкерін онша танымаймын...
Dialogue: 0,0:08:40.47,0:08:43.46,Main,,0,0,0,,Неліктен мен баруым керек?
Dialogue: 0,00:08:41.06,00:08:44.39,JPN TOP,,0,0,0,,Негізі не үшін баруым керек?
Dialogue: 0,00:08:44.48,00:08:45.85,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,00:08:45.02,00:08:45.85,JPN TOP,,0,0,0,,
Dialogue: 0,0:08:45.51,0:08:47.71,Main,,0,0,0,,Шопбой мырза үйден қашып кетті.
Dialogue: 0,00:08:46.60,00:08:48.61,JPN TOP,,0,0,0,,Қызметші үйден қашып кетті.
Dialogue: 0,0:08:47.71,0:08:49.43,Main,,0,0,0,,Сіз онымен жақынсыз, солай емес пе?
Dialogue: 0,00:08:48.69,00:08:50.36,JPN TOP,,0,0,0,,Фуши мырза, сіз жақсы араласасыз, солай ма?
Dialogue: 0,0:08:49.43,0:08:50.85,Main,,0,0,0,,Оны тауып алайық.
Dialogue: 0,00:08:50.44,00:08:52.78,JPN TOP,,0,0,0,,Неге оны іздемейсің? Уайымдайсыз ба?
Dialogue: 0,0:08:50.85,0:08:51.83,Main,,0,0,0,,Сіз уайымдамайсыз ба?
Dialogue: 0,0:08:52.17,0:08:53.10,Main,,0,0,0,,Қаламаймын.
Dialogue: 0,00:08:52.86,00:08:55.53,JPN TOP,,0,0,0,,Маған ұнамайды, мұңаймаймын.
Dialogue: 0,0:08:53.10,0:08:54.59,Main,,0,0,0,,Мен уайымдамаймын.
Dialogue: 0,0:08:55.31,0:08:56.81,Main,,0,0,0,,Сіз ұрысып қалдыңыз ба?
Dialogue: 0,00:08:55.61,00:08:57.74,JPN TOP,,0,0,0,,А... ұрысып қалдың ба?
Dialogue: 0,0:08:57.07,0:08:58.71,Main,,0,0,0,,О, адам...
Dialogue: 0,00:08:57.82,00:08:59.62,JPN TOP,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:08:58.71,0:09:01.75,Main,,0,0,0,,Сол ішімдік құнды.
Dialogue: 0,00:08:59.70,00:09:02.70,JPN TOP,,0,0,0,,Бұл затта сирек кездесетін алкоголь болса да.
Dialogue: 0,0:09:01.75,0:09:03.04,Main,,0,0,0,,Мұны қалай айта аласыз?!
Dialogue: 0,00:09:02.79,00:09:06.00,JPN TOP,,0,0,0,,Мен таң қалдым! Сол үшін кетіп бара жатырмын.
Dialogue: 0,0:09:03.04,0:09:05.05,Main,,0,0,0,,Оның үйден кеткені таңқаларлық емес!
Dialogue: 0,0:09:05.29,0:09:09.64,Main,,0,0,0,,Біздің тамағымды Гугусыз кім дайындайды?
Dialogue: 0,00:09:06.08,00:09:10.55,JPN TOP,,0,0,0,,Гу Гу болмаса, кім тамақтандыруға кезекші болады?
Dialogue: 0,0:09:09.64,0:09:10.74,Main,,0,0,0,,Мен?
Dialogue: 0,00:09:10.63,00:09:11.67,JPN TOP,,0,0,0,,Мен бе?
Dialogue: 0,0:09:11.53,0:09:13.23,Main,,0,0,0,,Мен тамақ дайындаймын.
Dialogue: 0,00:09:12.59,00:09:14.17,JPN TOP,,0,0,0,,Мен жасаймын
Dialogue: 0,00:09:19.76,00:09:20.68,JPN TOP,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:09:27.63,0:09:29.21,Main,,0,0,0,,Бұл сұмдық!
Dialogue: 0,00:09:27.77,00:09:30.15,JPN TOP,,0,0,0,,OMG, бұл қорқынышты.
Dialogue: 0,0:09:29.59,0:09:30.92,Main,,0,0,0,,Біздің руға шабуыл жасаған Маскалылар Эбису-саманың…
Dialogue: 0,00:09:30.69,00:09:34.65,JPN TOP,,0,0,0,,Жақсы, бұл қарапайым халықтың талғамы емес.
Dialogue: 0,0:09:30.92,0:09:33.71,Main,,0,0,0,,Бұл қарапайым адамдар жейтін нәрсе емес, иә?
Dialogue: 0,0:09:33.71,0:09:35.42,Main,,0,0,0,,Бәрі жақсы, Фуши-сан.
Dialogue: 0,00:09:34.74,00:09:36.32,JPN TOP,,0,0,0,,Жарайды, Фуши-сан.
Dialogue: 0,0:09:35.42,0:09:37.88,Main,,0,0,0,,Тұзбен жақсы болады.
Dialogue: 0,00:09:36.40,00:09:38.99,JPN TOP,,0,0,0,,Тұз оны дәмді етеді.
Dialogue: 0,0:09:41.05,0:09:44.28,Main,,0,0,0,,Гугудың тағамы ең жақсы болды.
Dialogue: 0,00:09:42.08,00:09:45.16,JPN TOP,,0,0,0,,Гу Гудың тамағы ең жақсы болды
Dialogue: 0,0:09:44.28,0:09:46.58,Main,,0,0,0,,Мен оның қазір не істеп жатқанына таңғаламын.
Dialogue: 0,00:09:45.25,00:09:47.50,JPN TOP,,0,0,0,,Сіз бұл күндері не істеп жатырсыз?
Dialogue: 0,0:09:46.58,0:09:50.24,Main,,0,0,0,,Сіз айтасыз, бірақ оны ешкім іздемейді.
Dialogue: 0,00:09:47.58,00:09:51.17,JPN TOP,,0,0,0,,Өйткені, сені ешкім алып кетпейді.
Dialogue: 0,0:09:54.91,0:09:57.36,Main,,0,0,0,,Артымнан ешкім келе жатқан жоқ.
Dialogue: 0,00:09:55.76,00:09:58.30,JPN TOP,,0,0,0,,Менің артымнан ешкім жүрмейді
Dialogue: 0,0:09:58.80,0:09:59.93,Main,,0,0,0,,Жақсы!
Dialogue: 0,00:09:59.89,00:10:02.81,JPN TOP,,0,0,0,,Жақсы! Өйткені мен жалғыз тұратын боламын
Dialogue: 0,0:09:59.93,0:10:01.68,Main,,0,0,0,,Мен өзім өмір сүремін.
Dialogue: 0,0:10:02.83,0:10:05.98,Main,,0,0,0,,Мына ішімдікті ішімнен шығаруым керек.
Dialogue: 0,00:10:03.93,00:10:07.14,JPN TOP,,0,0,0,,Одан да мен бұл ішімдікті шығаруым керек.
Dialogue: 0,0:10:13.05,0:10:14.74,Main,,0,0,0,,Шық! Шығу!
Dialogue: 0,00:10:14.15,00:10:16.15,JPN TOP,,0,0,0,,Шық! Шығу!
Dialogue: 0,00:10:16.24,00:10:18.15,JPN TOP,,0,0,0,,Хмф… уф…
Dialogue: 0,00:10:18.24,00:10:20.82,JPN TOP,,0,0,0,,Уа-уай-ау
Dialogue: 0,00:10:20.91,00:10:22.99,JPN TOP,,0,0,0,,Хмм...
Dialogue: 0,0:10:21.97,0:10:22.98,Italics,,0,0,0,,Міне!
Dialogue: 0,00:10:23.08,00:10:24.08,JPN TOP,,0,0,0,,Міне, осы
Dialogue: 0,0:10:24.08,0:10:25.53,Italics,,0,0,0,,Маған мұны шығару керек.
Dialogue: 0,00:10:25.12,00:10:26.29,JPN TOP,,0,0,0,,Мен мұны алсам болды...
Dialogue: 0,00:10:26.37,00:10:29.29,JPN TOP,,0,0,0,,(Гу-Гудың айқайы)
Dialogue: 0,00:10:29.37,00:10:30.58,JPN TOP,,0,0,0,,Уау
Dialogue: 0,00:10:30.67,00:10:34.55,JPN TOP,,0,0,0,,Гухахахахаха...
Dialogue: 0,0:10:45.77,0:10:46.95,Main,,0,0,0,,Жақсы.
Dialogue: 0,00:10:46.81,00:10:48.14,JPN TOP,,0,0,0,,Жарайды
Dialogue: 0,0:10:47.36,0:10:50.72,Main,,0,0,0,,Мен ақша табамын, оны шығару үшін дәрігер шақырамын.
Dialogue: 0,00:10:48.23,00:10:51.94,JPN TOP,,0,0,0,,Ақша табыңыз және оны дәрігерге апарыңыз
Dialogue: 0,0:10:54.44,0:10:56.76,Main,,0,0,0,,Қараңыз. Барлығы кім туралы айтады.
Dialogue: 0,00:10:55.57,00:10:57.57,JPN TOP,,0,0,0,,Қараңызшы, бұл қауесет.
Dialogue: 0,0:10:56.76,0:10:57.71,Main,,0,0,0,,Ғажайып.
Dialogue: 0,00:10:57.65,00:10:58.65,JPN TOP,,0,0,0,,Құбыжық
Dialogue: 0,0:10:57.92,0:10:59.89,Main,,0,0,0,,Тш, ол сені естиді.
Dialogue: 0,00:10:58.74,00:11:00.86,JPN TOP,,0,0,0,,Тшш, мен оны естимін.
Dialogue: 0,0:10:59.89,0:11:03.23,Main,,0,0,0,,Бұл? Ол мүлдем қорқынышты емес.
Dialogue: 0,00:11:00.95,00:11:04.16,JPN TOP,,0,0,0,,Бұл шынымен солай ма? Бұл мүлдем қорқынышты емес
Dialogue: 0,0:11:03.23,0:11:06.22,Main,,0,0,0,,Оның түрін көрсең өлтіретін сияқты.
Dialogue: 0,00:11:04.24,00:11:07.16,JPN TOP,,0,0,0,,Менің шынайы бетімді көрсең өлтіретін сияқтысың.
Dialogue: 0,0:11:07.13,0:11:10.64,Main,,0,0,0,,Бұл шынымен сен бе, Гугу?
Dialogue: 0,00:11:08.04,00:11:11.58,JPN TOP,,0,0,0,,Сіз шынымен кереметсіз бе?
Dialogue: 0,0:11:10.85,0:11:12.65,Main,,0,0,0,,Иә, ұстаз!
Dialogue: 0,00:11:11.67,00:11:13.58,JPN TOP,,0,0,0,,Иә, сэр!
Dialogue: 0,0:11:12.88,0:11:17.82,Main,,0,0,0,,Сенің мұнда жұмыс істеуіңе қарсы емеспін, бірақ бетпердеде не бар?
Dialogue: 0,00:11:13.67,00:11:15.92,JPN TOP,,0,0,0,,Мұнда жұмыс істеу жақсы, бірақ
Dialogue: 0,00:11:16.00,00:11:18.80,JPN TOP,,0,0,0,,Мына маскамен не болып жатыр?
Dialogue: 0,0:11:17.82,0:11:20.19,Main,,0,0,0,,Мен апатқа ұшырадым.
Dialogue: 0,00:11:18.88,00:11:21.09,JPN TOP,,0,0,0,,Мен апатқа ұшырадым...
Dialogue: 0,0:11:20.19,0:11:22.14,Main,,0,0,0,,Менің жағдайым жақсы.
Dialogue: 0,00:11:21.18,00:11:23.09,JPN TOP,,0,0,0,,Бірақ менің денем жақсы!
Dialogue: 0,00:11:23.89,00:11:24.85,JPN TOP,,0,0,0,,Ei
Dialogue: 0,00:11:25.76,00:11:26.60,JPN TOP,,0,0,0,,Ei
Dialogue: 0,00:11:27.52,00:11:28.81,JPN TOP,,0,0,0,,Фу…
Dialogue: 0,00:11:28.89,00:11:30.02,JPN TOP,,0,0,0,,(күлкі)
Dialogue: 0,0:11:29.12,0:11:30.15,Main,,0,0,0,,Мынаны қараңыз.
Dialogue: 0,00:11:30.10,00:11:31.10,JPN TOP,,0,0,0,,Мынаны қараңыз.
Dialogue: 0,0:11:30.37,0:11:33.34,Main,,0,0,0,,Мынау әлсіреген бала құбыжық па?
Dialogue: 0,00:11:31.19,00:11:34.61,JPN TOP,,0,0,0,,Құбыжық сияқты нәзік нәрсе ме?
Dialogue: 0,0:11:33.65,0:11:35.68,Main,,0,0,0,,Ендеше араласпайық.
Dialogue: 0,00:11:34.69,00:11:36.19,JPN TOP,,0,0,0,,Менің араласқым келмейді.
Dialogue: 0,00:11:35.27,00:11:36.19,JPN TOP,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,00:11:36.19,00:11:36.94,JPN TOP,,0,0,0,,Менің араласқым келмейді.
Dialogue: 0,00:11:36.73,00:11:37.57,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:11:36.94,0:11:38.64,Main,,0,0,0,,Жақсы жұмыс.
Dialogue: 0,00:11:38.03,00:11:41.57,JPN TOP,,0,0,0,,Еңбегіңіз үшін рахмет. Неге кешкі асты бірге ішпейміз?
Dialogue: 0,0:11:38.64,0:11:40.63,Main,,0,0,0,,Кешкі асқа бізге қосылғыңыз келе ме?
Dialogue: 0,0:11:41.96,0:11:43.29,Main - Top,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:11:42.06,0:11:44.14,Main,,0,0,0,,Сәлем! Отыр!
Dialogue: 0,00:11:42.07,00:11:45.07,JPN TOP,,0,0,0,,Хахаха… күте тұрыңыз
Dialogue: 0,00:11:43.16,00:11:45.07,JPN TOP,,0,0,0,,Жүр, тез отыр.
Dialogue: 0,0:11:44.14,0:11:45.47,Main,,0,0,0,,Алдымен, ортаңғы және көрсеткі саусақтарыңызды осылайша қосыңыз,
Dialogue: 0,00:11:45.16,00:11:46.28,JPN TOP,,0,0,0,,Yes
Dialogue: 0,0:11:45.47,0:11:46.18,Main,,0,0,0,,Эй...
Dialogue: 0,00:11:46.37,00:11:47.58,JPN TOP,,0,0,0,,Эй (жұт) А?
Dialogue: 0,0:11:46.84,0:11:48.84,Main,,0,0,0,,Неге оны киіп жүрсің?
Dialogue: 0,00:11:47.66,00:11:49.79,JPN TOP,,0,0,0,,Неге оны киіп жүрсің?
Dialogue: 0,0:11:48.84,0:11:50.39,Main,,0,0,0,,О, бұл?
Dialogue: 0,00:11:49.87,00:11:51.33,JPN TOP,,0,0,0,,А, бұл...
Dialogue: 0,0:11:50.63,0:11:52.33,Main,,0,0,0,,Ол жарақат алды.
Dialogue: 0,00:11:51.41,00:11:53.25,JPN TOP,,0,0,0,,Мен жарақат алдым.
Dialogue: 0,0:11:52.33,0:11:53.40,Main,,0,0,0,,Көрейін.
Dialogue: 0,00:11:53.33,00:11:54.63,JPN TOP,,0,0,0,,Маған көрсет
Dialogue: 0,0:11:53.73,0:11:55.85,Main,,0,0,0,,Жоқ, сіз оны көргіңіз келмейді.
Dialogue: 0,00:11:54.71,00:11:56.79,JPN TOP,,0,0,0,,Жоқ, қарамаған дұрыс...
Dialogue: 0,0:11:55.85,0:12:00.77,Main,,0,0,0,,Әй, Гугу, Шин ағаңнан айырылғалы жалғыз қалдың ғой, солай ма?
Dialogue: 0,00:11:56.88,00:11:58.34,JPN TOP,,0,0,0,,Дұрыс Гу Гу
Dialogue: 0,00:11:58.42,00:12:01.72,JPN TOP,,0,0,0,,Шын ағаң кеткен соң жалғызсың, солай ма?
Dialogue: 0,0:12:00.77,0:12:03.92,Main,,0,0,0,,Неліктен сіз отбасы ретінде бізбен бірге тұрмайсыз?
Dialogue: 0,00:12:01.80,00:12:04.89,JPN TOP,,0,0,0,,Менің отбасым ретінде осында тұруға не жетсін?
Dialogue: 0,0:12:04.62,0:12:06.33,Main,,0,0,0,,R-Шынымен бе?
Dialogue: 0,00:12:04.97,00:12:07.22,JPN TOP,,0,0,0,,Ех! Расында ма?
Dialogue: 0,0:12:06.33,0:12:07.99,Main,,0,0,0,,Сіз байсалдысыз ба, әке?
Dialogue: 0,00:12:07.30,00:12:10.77,JPN TOP,,0,0,0,,Шынымды айтсам, әке, жоқ, мен осындаймын!
Dialogue: 0,0:12:07.99,0:12:09.85,Main,,0,0,0,,Мен бұл баламен тұрғым келмейді.
Dialogue: 0,0:12:09.85,0:12:12.51,Main,,0,0,0,,Қала тұрғындары оны құбыжық деп атайды.
Dialogue: 0,00:12:10.85,00:12:13.69,JPN TOP,,0,0,0,,Бұл жігітті қалада құбыжық дейді.
Dialogue: 0,0:12:12.76,0:12:14.60,Main,,0,0,0,,Бұл жеткілікті!
Dialogue: 0,00:12:13.77,00:12:15.48,JPN TOP,,0,0,0,,Түннің осы уақытында қайда барасың?
Dialogue: 0,0:12:14.60,0:12:16.92,Main,,0,0,0,,Мұндай сөзді айтуға ұялмайсың ба?
Dialogue: 0,00:12:15.56,00:12:17.86,JPN TOP,,0,0,0,,Сіз бұлай айтуға ұялмайсыз ба?
Dialogue: 0,0:12:17.19,0:12:20.77,Main,,0,0,0,,Қаладағы адамдар Гугу деп атайтыны оның мәселесі емес.
Dialogue: 0,00:12:17.94,00:12:21.61,JPN TOP,,0,0,0,,Көшеде сені қалай атаса да, Гу Гуға бәрібір.
Dialogue: 0,0:12:20.77,0:12:22.75,Main,,0,0,0,,Бірақ ол маған ұнамайды!
Dialogue: 0,00:12:21.69,00:12:23.53,JPN TOP,,0,0,0,,Бірақ маған ұнамайтын нәрсе ұнамайды!
Dialogue: 0,0:12:23.18,0:12:24.45,Main,,0,0,0,,Мастер...
Dialogue: 0,00:12:23.61,00:12:25.61,JPN TOP,,0,0,0,,Иә? (жұт) Күйеу
Dialogue: 0,0:12:25.26,0:12:27.48,Main,,0,0,0,,Чан-кун дұрыс айтады.
Dialogue: 0,00:12:26.37,00:12:28.87,JPN TOP,,0,0,0,,Чанның айтқаны дұрыс.
Dialogue: 0,0:12:27.91,0:12:32.55,Main,,0,0,0,,Отбасы бола аласың ба, жоқ па, бір-біріңді сүйе аласың ба, жоқ па соған байланысты.
Dialogue: 0,00:12:28.95,00:12:30.33,JPN TOP,,0,0,0,,Отбасы дегеніміз не?
Dialogue: 0,00:12:30.41,00:12:33.50,JPN TOP,,0,0,0,,Негізгі алғышарт - сен сүйе аласың ба, жоқ па.
Dialogue: 0,0:12:34.27,0:12:36.34,Main,,0,0,0,,Мен де соны қалаймын.
Dialogue: 0,00:12:35.29,00:12:37.33,JPN TOP,,0,0,0,,Мен де соны қалаймын
Dialogue: 0,0:12:36.79,0:12:39.45,Main,,0,0,0,,Ендеше мен сенің жасап көргім келеді.
Dialogue: 0,00:12:37.84,00:12:42.51,JPN TOP,,0,0,0,,Ендеше, байқап көрулеріңізді қалаймын, менің бетіме қараңыз...
Dialogue: 0,0:12:40.06,0:12:44.75,Main,,0,0,0,,Менің жүзіме қара, сен мені сүйе аласың ба.
Dialogue: 0,00:12:44.22,00:12:46.05,JPN TOP,,0,0,0,,Сүйе аласың ба, жоқ па
Dialogue: 0,00:12:48.93,00:12:50.76,JPN TOP,,0,0,0,,Уф...
Dialogue: 0,00:12:50.85,00:12:52.48,JPN TOP,,0,0,0,,Уф...
Dialogue: 0,00:12:52.56,00:12:54.60,JPN TOP,,0,0,0,,(Чанның інісінің жылауы)
Dialogue: 0,0:12:53.67,0:12:56.30,Main,,0,0,0,,Көрдіңіз бе?! Мен оның құбыжық екенін білдім!
Dialogue: 0,00:12:54.69,00:12:57.19,JPN TOP,,0,0,0,,Қараңызшы, бұл құбыжық.
Dialogue: 0,00:12:57.27,00:13:01.73,JPN TOP,,0,0,0,,(Чанның інісі жылай береді)
Dialogue: 0,0:13:02.90,0:13:03.98,Main,,0,0,0,,Гугу!
Dialogue: 0,00:13:03.99,00:13:05.24,JPN TOP,,0,0,0,,Гу Гу
Dialogue: 0,0:13:04.49,0:13:07.05,Main,,0,0,0,,Кешіріңіз. Ол мұнымен ештеңе айтқысы келмеді.
Dialogue: 0,00:13:05.32,00:13:08.32,JPN TOP,,0,0,0,,Кешіріңіз, мен ешқандай зиян келтірген жоқпын.
Dialogue: 0,0:13:07.39,0:13:09.30,Main,,0,0,0,,Ертең жұмысқа қайта келіңіз.
Dialogue: 0,00:13:08.41,00:13:10.24,JPN TOP,,0,0,0,,Ертең де жұмысқа келіңізші.
Dialogue: 0,0:13:09.68,0:13:13.11,Main,,0,0,0,,I don't want you to hate us because of this.
Dialogue: 0,00:13:10.78,00:13:14.25,JPN TOP,,0,0,0,,Бұл үшін бізді жек көрмейсің деп үміттенемін.
Dialogue: 0,0:13:14.48,0:13:17.13,Main,,0,0,0,,Гугу, бірдеңе айтшы.
Dialogue: 0,00:13:15.54,00:13:18.25,JPN TOP,,0,0,0,,Гоу, бірдеңе айт.
Dialogue: 0,0:13:19.12,0:13:20.37,Main,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,00:13:20.25,00:13:23.26,JPN TOP,,0,0,0,,Жарайды, мен қазір күлемін.
Dialogue: 0,0:13:20.37,0:13:22.31,Main,,0,0,0,,Мен қазір күліп тұрмын.
Dialogue: 0,0:13:22.58,0:13:23.83,Main,,0,0,0,,Иә?
Dialogue: 0,00:13:23.34,00:13:24.76,JPN TOP,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:23.83,0:13:25.14,Main,,0,0,0,,Ертең кездескенше.
Dialogue: 0,00:13:24.84,00:13:27.64,JPN TOP,,0,0,0,,Ертең кездескенше.
Dialogue: 0,0:13:25.14,0:13:26.71,Main,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,00:13:32.39,00:13:33.89,JPN TOP,,0,0,0,,Хе (ішіп) Уау...
Dialogue: 0,0:13:33.25,0:13:34.36,Main,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:13:34.36,0:13:35.58,Main,,0,0,0,,Қорқынышты!
Dialogue: 0,00:13:34.39,00:13:36.06,JPN TOP,,0,0,0,,Мен оны алдым! (Еркек) Қорқынышты...
Dialogue: 0,0:13:34.91,0:13:37.33,Main - Top,,0,0,0,,Жүгіру! Ол сені өлтірмекші!
Dialogue: 0,00:13:36.14,00:13:37.94,JPN TOP,,0,0,0,,Қаш, сені өлтіреді!
Dialogue: 0,00:13:38.02,00:13:38.90,JPN TOP,,0,0,0,,(күлкі)
Dialogue: 0,00:13:38.98,00:13:41.07,JPN TOP,,0,0,0,,Әй, мына нәрсені таста!
Dialogue: 0,00:13:41.15,00:13:42.94,JPN TOP,,0,0,0,,Барып ал.
Dialogue: 0,0:13:43.19,0:13:44.63,Main,,0,0,0,,Капыпа
Dialogue: 0,00:13:44.24,00:13:45.57,JPN TOP,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:13:44.80,0:13:46.15,Main,,0,0,0,,Бұл не үшін болды?
Dialogue: 0,00:13:45.65,00:13:48.78,JPN TOP,,0,0,0,,Бұл не, ақымақтар?
Dialogue: 0,0:13:46.15,0:13:47.61,Main,,0,0,0,,Не деген сұмырайлар.
Dialogue: 0,0:13:47.88,0:13:50.55,Main,,0,0,0,,Маған бұл маска керек...
Dialogue: 0,00:13:48.86,00:13:51.66,JPN TOP,,0,0,0,,Маған бұл маска керек...
Dialogue: 0,00:13:52.49,00:13:53.33,JPN TOP,,0,0,0,,Ах
Dialogue: 0,0:13:53.17,0:13:54.86,Main,,0,0,0,,Бұл маска маған не үшін керек?
Dialogue: 0,00:13:54.25,00:13:56.08,JPN TOP,,0,0,0,,Ол несіз?
Dialogue: 0,0:13:55.47,0:13:57.51,Main,,0,0,0,,Онсыз мен адам болмаймын ба?
Dialogue: 0,00:13:56.58,00:13:58.67,JPN TOP,,0,0,0,,Сіз адам бола алмаймын дейсіз бе?
Dialogue: 0,00:13:59.29,00:14:02.21,JPN TOP,,0,0,0,,Хм! Сол қол
Dialogue: 0,00:14:08.05,00:14:10.01,JPN TOP,,0,0,0,,(әдемі күлкі)
Dialogue: 0,0:14:14.55,0:14:15.98,Main,,0,0,0,,Бұл не?!
Dialogue: 0,00:14:15.02,00:14:18.94,JPN TOP,,0,0,0,,(Қаладағы адамдардың шуы)
Dialogue: 0,0:14:16.42,0:14:17.32,Main,,0,0,0,,Иә!
Dialogue: 0,00:14:19.02,00:14:20.69,JPN TOP,,0,0,0,,Иә? Уау
Dialogue: 0,00:14:20.77,00:14:21.86,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,00:14:21.94,00:14:23.07,JPN TOP,,0,0,0,,Сәлем...
Dialogue: 0,00:14:23.15,00:14:28.07,JPN TOP,,0,0,0,,(Адамдардың қорқатын дыбысы)
Dialogue: 0,0:14:24.60,0:14:26.09,Main,,0,0,0,,Ол неге олай?
Dialogue: 0,0:14:27.37,0:14:29.60,Main,,0,0,0,,Гугу, сенің маскаңа не болды?
Dialogue: 0,00:14:28.15,00:14:30.53,JPN TOP,,0,0,0,,Гу Гу Маскаға не болды?
Dialogue: 0,0:14:29.60,0:14:31.34,Main,,0,0,0,,Мен оны лақтырып жібердім.
Dialogue: 0,00:14:30.61,00:14:32.20,JPN TOP,,0,0,0,,Мен оны лақтырып жібердім
Dialogue: 0,0:14:31.34,0:14:32.36,Main,,0,0,0,,Тағы бір қосымша сабақ па, қазірден-ақ?
Dialogue: 0,00:14:32.28,00:14:33.28,JPN TOP,,0,0,0,,Неліктен?
Dialogue: 0,0:14:32.36,0:14:35.51,Main,,0,0,0,,Ауыр болды. Онсыз өзімді жақсы сезінемін.
Dialogue: 0,00:14:33.37,00:14:36.45,JPN TOP,,0,0,0,,Ыстық, онсыз өзімді жақсы сезінемін.
Dialogue: 0,0:14:36.95,0:14:39.01,Main,,0,0,0,,Иә, дұрыс айтасыз деп ойлаймын.
Dialogue: 0,00:14:38.00,00:14:39.96,JPN TOP,,0,0,0,,Тәрбиесіз бала мен әдепсіз ақымақ.
Dialogue: 0,0:14:39.48,0:14:41.78,Main,,0,0,0,,Мен бүгін сіздердің еңбектеріңізге сенемін.
Dialogue: 0,00:14:40.58,00:14:42.54,JPN TOP,,0,0,0,,Бүгін де бар күшіңізді салыңыз.
Dialogue: 0,0:14:41.78,0:14:42.52,Main,,0,0,0,,Иә, сэр!
Dialogue: 0,00:14:42.63,00:14:43.46,JPN TOP,,0,0,0,,Иә!
Dialogue: 0,0:14:44.52,0:14:47.72,Main,,0,0,0,,Таңертең тазалау. Таңертең тазалау.
Dialogue: 0,00:14:45.55,00:14:48.80,JPN TOP,,0,0,0,,Таңертеңгілік тазалық Таңертеңгілік тазалық
Dialogue: 0,0:14:51.19,0:14:52.19,Main,,0,0,0,,Орындалды.
Dialogue: 0,00:14:52.26,00:14:53.14,JPN TOP,,0,0,0,,Соңы
Dialogue: 0,00:14:53.22,00:14:54.10,JPN TOP,,0,0,0,,(ұйықтау)
Dialogue: 0,0:14:53.96,0:14:55.40,Main,,0,0,0,,Бұл кім еді?!
Dialogue: 0,00:14:54.18,00:14:56.35,JPN TOP,,0,0,0,,Уа! Ол кім?
Dialogue: 0,0:14:58.25,0:14:59.05,Main,,0,0,0,,Тұз.
Dialogue: 0,00:14:59.14,00:14:59.98,JPN TOP,,0,0,0,,Шио!
Dialogue: 0,00:15:02.06,00:15:03.44,JPN TOP,,0,0,0,,Обе... Гах!
Dialogue: 0,0:15:02.88,0:15:05.04,Main,,0,0,0,,Тұз көп!
Dialogue: 0,00:15:03.94,00:15:05.98,JPN TOP,,0,0,0,,Тұз көп!
Dialogue: 0,0:15:06.76,0:15:10.79,Main,,0,0,0,,Түске дейін егістікте жұмыс істе. Түске дейін егістікте жұмыс жасаңыз.
Dialogue: 0,00:15:07.57,00:15:11.74,JPN TOP,,0,0,0,,Хируға дейін дала жұмысы Егістік жұмысына дейін
Dialogue: 0,00:15:12.70,00:15:16.16,JPN TOP,,0,0,0,,А... неге сонша ретсіз?
Dialogue: 0,0:15:12.92,0:15:15.22,Main,,0,0,0,,Неге бәрі ұрып-соғып жатыр?!
Dialogue: 0,0:15:15.45,0:15:18.94,Main,,0,0,0,,Дүкенді түстен кейін бақылаңыз. Түстен кейін дүкенді қараңыз.
Dialogue: 0,00:15:16.24,00:15:19.66,JPN TOP,,0,0,0,,Gogoha shopban Gogowa shopban
Dialogue: 0,00:15:19.75,00:15:21.17,JPN TOP,,0,0,0,,(арық жөтел)
Dialogue: 0,00:15:21.25,00:15:22.92,JPN TOP,,0,0,0,,Кя!
Dialogue: 0,00:15:21.25,00:15:22.92,JPN TOP,,0,0,0,,(Қазанның сынған дыбысы)
Dialogue: 0,00:15:23.00,00:15:24.67,JPN TOP,,0,0,0,,Пуппу
Dialogue: 0,00:15:28.09,00:15:29.51,JPN TOP,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:15:28.53,0:15:29.63,Main,,0,0,0,,Пиоран.
Dialogue: 0,00:15:29.59,00:15:30.47,JPN TOP,,0,0,0,,Пиоран
Dialogue: 0,00:15:30.55,00:15:31.55,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:15:31.43,0:15:32.80,Main,,0,0,0,,Не-не?
Dialogue: 0,00:15:32.22,00:15:33.93,JPN TOP,,0,0,0,,Не... не?
Dialogue: 0,0:15:33.61,0:15:37.53,Italics,,0,0,0,,Ол мені қашаннан бастап атыммен атай алады?
Dialogue: 0,00:15:34.64,00:15:39.10,JPN TOP,,0,0,0,,Менің атымды қашан атай алдың?
Dialogue: 0,0:15:38.40,0:15:43.29,Main,,0,0,0,,Маған үй жинауды, тамақ пісіруді, жұмыс істеуді үйрет.
Dialogue: 0,00:15:39.18,00:15:41.39,JPN TOP,,0,0,0,,Айтыңызшы
Dialogue: 0,00:15:41.48,00:15:44.23,JPN TOP,,0,0,0,,Тазалық жұмыстары
Dialogue: 0,0:15:43.51,0:15:44.83,Main,,0,0,0,,Тағы бір қосымша сабақ па, қазірден-ақ?
Dialogue: 0,00:15:44.31,00:15:46.02,JPN TOP,,0,0,0,,Неліктен?
Dialogue: 0,0:15:45.15,0:15:47.80,Main,,0,0,0,,Себебі мен ештеңе істей алмаймын.
Dialogue: 0,00:15:46.11,00:15:48.73,JPN TOP,,0,0,0,,Себебі мен ештеңе істей алмаймын
Dialogue: 0,0:15:48.07,0:15:49.13,Main,,0,0,0,,Ақыры заман мені қуып жетті ме?
Dialogue: 0,00:15:48.82,00:15:50.07,JPN TOP,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:15:49.33,0:15:50.25,Main,,0,0,0,,Тағы бір қосымша сабақ па, қазірден-ақ?
Dialogue: 0,00:15:50.15,00:15:51.20,JPN TOP,,0,0,0,,Неліктен?
Dialogue: 0,0:15:50.61,0:15:53.62,Main,,0,0,0,,Барып Гугуды тауып, оны саған үйретуін сұра.
Dialogue: 0,00:15:51.70,00:15:54.91,JPN TOP,,0,0,0,,Гу Гуды тауып, ол туралы айтып беруін сұраңыз.
Dialogue: 0,0:15:53.96,0:15:56.26,Main,,0,0,0,,Ол бәрінен де жақсы біледі.
Dialogue: 0,00:15:54.99,00:15:57.20,JPN TOP,,0,0,0,,Ол жақсы біледі
Dialogue: 0,0:16:03.01,0:16:06.46,Main,,0,0,0,,Бұл менің ойымды өзгертпейді.
Dialogue: 0,00:16:04.04,00:16:07.63,JPN TOP,,0,0,0,,Мен мұндай нәрсені алсам да, маған ұнамайды.
Dialogue: 0,00:16:08.34,00:16:09.51,JPN TOP,,0,0,0,,Хмм…
Dialogue: 0,0:16:14.14,0:16:16.01,Main,,0,0,0,,Сен оны неге итеріп жатырсың?
Dialogue: 0,00:16:15.18,00:16:17.30,JPN TOP,,0,0,0,,Неге мені итеріп жібересің?
Dialogue: 0,0:16:16.39,0:16:17.98,Main,,0,0,0,,Мен оны бұза алмаймын.
Dialogue: 0,00:16:17.39,00:16:18.93,JPN TOP,,0,0,0,,Оны бүлдірмеңіз
Dialogue: 0,0:16:18.24,0:16:21.62,Main,,0,0,0,,Ол тез адам болып қалыптасуы керек.
Dialogue: 0,00:16:19.01,00:16:22.56,JPN TOP,,0,0,0,,Ол тез арада адам болуы керек.
Dialogue: 0,0:16:22.00,0:16:23.20,Main,,0,0,0,,Адам?
Dialogue: 0,00:16:23.06,00:16:24.31,JPN TOP,,0,0,0,,Адам?
Dialogue: 0,00:16:27.31,00:16:31.07,JPN TOP,,0,0,0,,Хмф, сағ, сағ...
Dialogue: 0,00:16:31.15,00:16:33.07,JPN TOP,,0,0,0,,(Қызметшілердің күлкісі)
Dialogue: 0,0:16:32.13,0:16:34.34,Main,,0,0,0,,Ол көп жұмыс істейді.
Dialogue: 0,00:16:33.15,00:16:35.11,JPN TOP,,0,0,0,,Мен қатты тырысамын Мен қатты тырысамын
Dialogue: 0,0:16:34.34,0:16:36.19,Main,,0,0,0,,Ол сондай асшаян.
Dialogue: 0,00:16:35.61,00:16:37.41,JPN TOP,,0,0,0,,Бұл кішкентай.
Dialogue: 0,00:16:38.20,00:16:39.58,JPN TOP,,0,0,0,,Фу…
Dialogue: 0,0:16:40.08,0:16:41.64,Main - Top,,0,0,0,,Жалғасын, балам.
Dialogue: 0,0:16:40.98,0:16:42.08,Main,,0,0,0,,Жер
Dialogue: 0,00:16:42.08,00:16:42.91,JPN TOP,,0,0,0,,Не?
Dialogue: 0,00:16:43.00,00:16:44.16,JPN TOP,,0,0,0,,Ой…
Dialogue: 0,00:16:49.13,00:16:50.09,JPN TOP,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:16:50.01,0:16:52.06,Main,,0,0,0,,Әркім бұл туралы үлкен мәміле жасайды.
Dialogue: 0,00:16:51.13,00:16:53.01,JPN TOP,,0,0,0,,Барлығы асыра айтып жатыр.
Dialogue: 0,0:16:52.52,0:16:54.86,Main,,0,0,0,,Мен шынымен де қорқыныштымын ба?
Dialogue: 0,00:16:53.59,00:16:55.97,JPN TOP,,0,0,0,,Менен сонша қорқасың ба?
Dialogue: 0,0:16:55.60,0:16:57.00,Main,,0,0,0,,Сол жүздер...
Dialogue: 0,00:16:56.47,00:16:58.35,JPN TOP,,0,0,0,,Бұл бет...
Dialogue: 0,0:16:57.59,0:16:59.24,Main,,0,0,0,,Олар маған қарағанда күлкілі көрінді.
Dialogue: 0,00:16:58.43,00:17:00.35,JPN TOP,,0,0,0,,Бұл маған қарағанда қызық
Dialogue: 0,00:17:00.43,00:17:02.47,JPN TOP,,0,0,0,,Хахаха
Dialogue: 0,0:17:03.35,0:17:05.52,Main,,0,0,0,,Мен бұлшық еттім.
Dialogue: 0,00:17:04.44,00:17:08.27,JPN TOP,,0,0,0,,Менің бұлшық еттерім бұрынғыға қарағанда көбірек болды, аздап қисық болдым.
Dialogue: 0,0:17:05.52,0:17:07.32,Main,,0,0,0,,Дөңес кетіп бара жатыр.
Dialogue: 0,0:17:07.32,0:17:08.37,Main,,0,0,0,,Вент ашылғалы үш күн өтті
Dialogue: 0,00:17:08.36,00:17:09.31,JPN TOP,,0,0,0,,Жарайды!
Dialogue: 0,00:17:11.48,00:17:14.74,JPN TOP,,0,0,0,,Хмф, сағ, сағ...
Dialogue: 0,00:17:15.36,00:17:18.12,JPN TOP,,0,0,0,,Хмф, сағ, сағ...
Dialogue: 0,00:17:15.36,00:17:18.12,JPN TOP,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,00:17:18.20,00:17:19.45,JPN TOP,,0,0,0,,Уау
Dialogue: 0,0:17:19.87,0:17:21.19,Main,,0,0,0,,Не-не?!
Dialogue: 0,00:17:20.91,00:17:23.37,JPN TOP,,0,0,0,,Не... не? Чан мырза!
Dialogue: 0,0:17:21.56,0:17:22.42,Main,,0,0,0,,Чан-кун!
Dialogue: 0,0:17:22.94,0:17:24.64,Main,,0,0,0,,Енді жұмысқа келме.
Dialogue: 0,00:17:24.04,00:17:25.58,JPN TOP,,0,0,0,,Енді жұмысқа келме
Dialogue: 0,00:17:25.66,00:17:26.83,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:17:25.92,0:17:28.31,Main,,0,0,0,,Сіз бізді ұятқа қалдырасыз.
Dialogue: 0,00:17:26.92,00:17:29.25,JPN TOP,,0,0,0,,Бұл ұят! сен келгенде
Dialogue: 0,0:17:30.14,0:17:32.31,Main,,0,0,0,,Сіз суық адамсыз.
Dialogue: 0,00:17:31.25,00:17:33.21,JPN TOP,,0,0,0,,Сіз суық адамсыз.
Dialogue: 0,0:17:32.31,0:17:34.78,Main,,0,0,0,,Әсіресе сенің әкеңнің мейірімділігі үшін.
Dialogue: 0,00:17:33.30,00:17:35.72,JPN TOP,,0,0,0,,Әкем сондай жақсы адам болса да
Dialogue: 0,0:17:35.02,0:17:37.26,Main,,0,0,0,,Иә, ол жақсы әке.
Dialogue: 0,00:17:35.80,00:17:38.18,JPN TOP,,0,0,0,,Әй, сен жақсы әке екенсің.
Dialogue: 0,0:17:37.26,0:17:39.34,Main,,0,0,0,,Сондықтан оған бұдан былай қиындық туғызба.
Dialogue: 0,00:17:38.26,00:17:42.39,JPN TOP,,0,0,0,,Ендеше қиындық тудырма, біз сирек кездесетін жануарлар сарайы емеспіз.
Dialogue: 0,0:17:39.34,0:17:41.23,Main,,0,0,0,,Біз таңқаларлық шоу емеспіз.
Dialogue: 0,0:17:49.47,0:17:51.77,Main,,0,0,0,,Иә? Құбыжық мұнда жоқ па?
Dialogue: 0,00:17:50.31,00:17:52.69,JPN TOP,,0,0,0,,Не, құбыжық келмеді?
Dialogue: 0,0:17:51.77,0:17:53.71,Main,,0,0,0,,Иә. Ол тастап кеткен болуы керек.
Dialogue: 0,00:17:52.78,00:17:54.57,JPN TOP,,0,0,0,,О, сен тастадың.
Dialogue: 0,0:17:53.71,0:17:54.95,Main,,0,0,0,,Өте жаман.
Dialogue: 0,00:17:54.65,00:17:57.70,JPN TOP,,0,0,0,,Не қызық болды?
Dialogue: 0,0:17:54.95,0:17:56.81,Main,,0,0,0,,Оның айналасында болғаны соншалықты қызықты болды.
Dialogue: 0,0:17:56.81,0:17:58.20,Main,,0,0,0,,Ах, таңертең ерте келіп жұмыс істегеніңе рахмет.
Dialogue: 0,00:17:57.78,00:17:59.70,JPN TOP,,0,0,0,,Бұл рас (қызметші)
Dialogue: 0,0:17:58.20,0:17:58.75,Main,,0,0,0,,Ұзақ жұмыс күнінен кейін бір шыныаяқ сакэ ішуден артық ештеңе жоқ!
Dialogue: 0,00:18:10.33,00:18:11.17,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:18:14.64,0:18:16.57,Italics,,0,0,0,,Рахмет, ұстаз.
Dialogue: 0,00:18:15.67,00:18:17.67,JPN TOP,,0,0,0,,Рахмет, сэр.
Dialogue: 0,0:18:17.48,0:18:22.80,Italics,,0,0,0,,Айналаңда сен сияқты адамдардың болуы мені жынды болудан сақтайды.
Dialogue: 0,00:18:18.26,00:18:21.60,JPN TOP,,0,0,0,,Күйеуім сияқты адам болғанына рахмет
Dialogue: 0,00:18:21.68,00:18:23.85,JPN TOP,,0,0,0,,Мен жынды емеспін
Dialogue: 0,00:18:24.68,00:18:25.77,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:18:26.40,0:18:28.75,Main,,0,0,0,,Менде бар ақша осы...
Dialogue: 0,00:18:27.48,00:18:29.69,JPN TOP,,0,0,0,,Осының бәрі ақша үшін ме?
Dialogue: 0,00:18:29.77,00:18:31.94,JPN TOP,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:18:30.93,0:18:32.76,Main,,0,0,0,,(Тик-так, сағаттың көрсеткіштері тик-так)
Dialogue: 0,00:18:32.02,00:18:33.69,JPN TOP,,0,0,0,,Негізінен, біз қашамыз.
Dialogue: 0,0:18:33.03,0:18:34.20,Main,,0,0,0,,Хиёри, мұнда жақынлама.
Dialogue: 0,00:18:33.77,00:18:36.03,JPN TOP,,0,0,0,,Ах... ых... (Фермер) Иә? Уау
Dialogue: 0,0:18:35.32,0:18:38.35,Main,,0,0,0,,Жұмысыңыз бар ма? Мен бәрін істеймін.
Dialogue: 0,00:18:36.11,00:18:39.20,JPN TOP,,0,0,0,,Сіздің жұмысыңыз бар ма? Мен бәрін істеймін
Dialogue: 0,0:18:38.35,0:18:40.54,Main,,0,0,0,,Менде ақша жоқ!
Dialogue: 0,00:18:39.28,00:18:41.41,JPN TOP,,0,0,0,,Немесе... ақша жоқ!
Dialogue: 0,00:18:41.49,00:18:42.53,JPN TOP,,0,0,0,,Я...
Dialogue: 0,0:18:41.94,0:18:43.63,Main,,0,0,0,,Кешіріңіз, мм...
Dialogue: 0,00:18:43.03,00:18:44.45,JPN TOP,,0,0,0,,Кешіріңіз, мм...
Dialogue: 0,0:18:43.63,0:18:46.10,Main,,0,0,0,,Кім-Не деген сұмсың?! Алыс болыңыз!
Dialogue: 0,00:18:44.54,00:18:47.04,JPN TOP,,0,0,0,,Не... Бұл не? Келме
Dialogue: 0,0:18:46.33,0:18:47.29,Main,,0,0,0,,Олар дәл қашан осы үйдің бір бөлігіне айналды?
Dialogue: 0,00:18:47.12,00:18:50.04,JPN TOP,,0,0,0,,Мм... (Дүкенші) Кет! Тынш
Dialogue: 0,0:18:47.68,0:18:49.09,Main,,0,0,0,,Кет! Шоу! Шоу!
Dialogue: 0,00:18:51.21,00:18:52.04,JPN TOP,,0,0,0,,Я...
Dialogue: 0,00:18:56.63,00:18:57.63,JPN TOP,,0,0,0,,(жұтыну дыбысы)
Dialogue: 0,00:19:00.68,00:19:04.22,JPN TOP,,0,0,0,,А... ақыры Суккаракан?
Dialogue: 0,0:19:00.82,0:19:03.20,Main,,0,0,0,,Ал енді мен бәрінен шықтым.
Dialogue: 0,00:19:05.51,00:19:06.35,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,00:19:09.98,00:19:11.52,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:19:11.44,0:19:16.23,Flashback,,0,0,0,,Мұны сатыңыз, сонда көкөністерді ешқашан сатудың қажеті болмайды.
Dialogue: 0,00:19:12.52,00:19:15.19,JPN TOP,,0,0,0,,Осыны сатсам, көкөніс сататын жұмысым болмайды.
Dialogue: 0,00:19:15.27,00:19:17.36,JPN TOP,,0,0,0,,Сізге мәңгі өмір сүрудің қажеті жоқ.
Dialogue: 0,00:19:18.61,00:19:20.57,JPN TOP,,0,0,0,,
Dialogue: 0,0:19:19.64,0:19:20.82,Main,,0,0,0,,Қош келдіңіз
Dialogue: 0,00:19:20.65,00:19:22.87,JPN TOP,,0,0,0,,Қош келдіңіз... иә?
Dialogue: 0,0:19:21.93,0:19:24.62,Main,,0,0,0,,Бұл үшін қанша төлер едіңіз?
Dialogue: 0,00:19:22.95,00:19:25.37,JPN TOP,,0,0,0,,Бұны қаншаға сатып аласың?
Dialogue: 0,00:19:25.45,00:19:26.49,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:19:26.34,0:19:27.34,Main,,0,0,0,,Бұл...
Dialogue: 0,00:19:27.37,00:19:30.91,JPN TOP,,0,0,0,,Бұл! Мұны қайдан алдың?
Dialogue: 0,0:19:27.52,0:19:29.99,Main,,0,0,0,,Бұны қайдан таптың?!
Dialogue: 0,0:19:32.13,0:19:34.21,Main,,0,0,0,,Қарсы емес. рахмет.
Dialogue: 0,00:19:33.00,00:19:35.46,JPN TOP,,0,0,0,,Жақсы, рахмет.
Dialogue: 0,0:19:34.98,0:19:35.99,Main,,0,0,0,,Мырза!
Dialogue: 0,00:19:35.54,00:19:36.92,JPN TOP,,0,0,0,,Тұтынушы!
Dialogue: 0,0:19:37.04,0:19:41.11,Italics,,0,0,0,,Мен нені қорғауға тырысамын?
Dialogue: 0,00:19:38.17,00:19:42.18,JPN TOP,,0,0,0,,Мен нені қорғауға тырысамын?
Dialogue: 0,0:19:41.89,0:19:47.05,Italics,,0,0,0,,Менің адам ретінде кім екенімді еске түсіретін бірдеңе бар ма?
Dialogue: 0,00:19:42.97,00:19:48.14,JPN TOP,,0,0,0,,Мені... адам ретінде еске түсіретін нәрсе?
Dialogue: 0,00:19:49.77,00:19:50.81,JPN TOP,,0,0,0,,(Сынған нәрсенің дыбысы)
Dialogue: 0,0:19:49.78,0:19:52.78,Main,,0,0,0,,Шин! Сізге қайтып келуге тыйым салынды!
Dialogue: 0,00:19:50.89,00:19:53.77,JPN TOP,,0,0,0,,Шин! Сізге кіруге немесе шығуға тыйым салынады!
Dialogue: 0,00:19:54.27,00:19:55.19,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:20:05.66,0:20:06.77,Main,,0,0,0,,Нии-чан...
Dialogue: 0,00:20:06.62,00:20:07.70,JPN TOP,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:20:07.44,0:20:09.41,Main,,0,0,0,,Сіз өте арық болып кеттіңіз.
Dialogue: 0,00:20:08.54,00:20:10.70,JPN TOP,,0,0,0,,Жұқа...
Dialogue: 0,0:20:10.45,0:20:12.46,Main,,0,0,0,,Сіз сондай аянышты көрінесіз.
Dialogue: 0,00:20:11.50,00:20:13.58,JPN TOP,,0,0,0,,Қандай аянышты
Dialogue: 0,0:20:19.40,0:20:23.14,Main,,0,0,0,,Мынаны сат, сонда жейсің.
Dialogue: 0,00:20:20.46,00:20:24.26,JPN TOP,,0,0,0,,Осыны сатсам, көп тамақ жей аламын.
Dialogue: 0,00:20:28.18,00:20:31.35,JPN TOP,,0,0,0,,Хмм... Гоу?
Dialogue: 0,0:20:28.79,0:20:30.22,Main,,0,0,0,,Гугу...
Dialogue: 0,0:20:36.21,0:20:38.53,Main,,0,0,0,,Менің ағам жоқ.
Dialogue: 0,00:20:37.36,00:20:39.69,JPN TOP,,0,0,0,,Менің ағам жоқ
Dialogue: 0,00:20:44.91,00:20:46.82,JPN TOP,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:20:46.49,0:20:50.90,Italics,,0,0,0,,Сол жүзікті сатсам да, мен әрқашан құбыжық болып қала беремін.
Dialogue: 0,00:20:47.53,00:20:49.83,JPN TOP,,0,0,0,,Мен сол сақинаны пайдалансам да
Dialogue: 0,00:20:49.91,00:20:51.83,JPN TOP,,0,0,0,,Бәрібір құбыжық
Dialogue: 0,0:20:51.50,0:20:56.78,Italics,,0,0,0,,Бірақ Нии Чан жеңілген адамнан лайықты адамға айналуы мүмкін.
Dialogue: 0,00:20:52.54,00:20:53.83,JPN TOP,,0,0,0,,Егер бұл менің ағам болса
Dialogue: 0,00:20:53.91,00:20:57.92,JPN TOP,,0,0,0,,Сіз қарапайым бейбақтан лайықты адам бола аласыз.
Dialogue: 0,0:20:58.65,0:21:01.90,Italics,,0,0,0,,Бұл сақинаның ессіз адамға пайдасы жоқ.
Dialogue: 0,00:20:59.71,00:21:02.84,JPN TOP,,0,0,0,,Құбыжықтарға бұл сақина қажет емес.
Dialogue: 0,0:21:03.58,0:21:05.89,Italics,,0,0,0,,Мен ақымақпын ба?
Dialogue: 0,00:21:04.63,00:21:06.84,JPN TOP,,0,0,0,,Мен ақымақпын ба?
Dialogue: 0,0:21:10.29,0:21:12.92,Italics,,0,0,0,,Жақсы. Бұл жақсы.
Dialogue: 0,00:21:11.35,00:21:13.93,JPN TOP,,0,0,0,,Жақсы, бұл жақсы.
Dialogue: 0,0:21:13.42,0:21:18.02,Italics,,0,0,0,,Бұл Құбыжық Гугудың өмірі... менің өз өмірім.
Dialogue: 0,00:21:14.43,00:21:19.15,JPN TOP,,0,0,0,,Бұл құбыжық Гу Гудың өмір жолы...
Dialogue: 0,00:21:21.28,00:21:22.11,JPN TOP,,0,0,0,,Уау
Dialogue: 0,0:21:22.77,0:21:24.31,Main,,0,0,0,,Кім-Не?!
Dialogue: 0,00:21:23.82,00:21:25.40,JPN TOP,,0,0,0,,Мен Йошикагэні қорғаймын!
Dialogue: 0,0:21:24.83,0:21:25.85,Main - Top,,0,0,0,,Мені шығарыңыз!
Dialogue: 0,0:21:25.85,0:21:28.04,Main - Top,,0,0,0,,Сәлем! Мені шығарыңыз!
Dialogue: 0,00:21:25.90,00:21:29.24,JPN TOP,,0,0,0,,Шығар! Эй, мені шығар
Dialogue: 0,0:21:26.14,0:21:28.98,Main,,0,0,0,,Сонымен, ол қаншаға сатады деп ойлайсыз?
Dialogue: 0,00:21:27.20,00:21:29.87,JPN TOP,,0,0,0,,Енді оның құны қанша?
Dialogue: 0,0:21:28.98,0:21:32.02,Main,,0,0,0,,Қажетті жерлерді іздесек, сұраныс бар.
Dialogue: 0,00:21:29.95,00:21:31.70,JPN TOP,,0,0,0,,Мені шығарыңыз!
Dialogue: 0,00:21:29.95,00:21:33.20,JPN TOP,,0,0,0,,Қайда барсаң да сұраныс көп.
Dialogue: 0,0:21:32.51,0:21:34.93,Main,,0,0,0,,Тоқта! Мені шығарыңыз!
Dialogue: 0,00:21:33.29,00:21:35.87,JPN TOP,,0,0,0,,Тоқта, мені жібер!
Dialogue: 0,0:21:35.23,0:21:37.77,Main,,0,0,0,,Сіз бәрін жасайсыз, солай емес пе?
Dialogue: 0,00:21:36.37,00:21:38.75,JPN TOP,,0,0,0,,Сіз бәрін жасайсыз, солай ма?
Dialogue: 0,00:21:37.08,00:21:40.09,JPN TOP,,0,0,0,,Эй, мені шығар!
Dialogue: 0,0:21:37.77,0:21:40.45,Main,,0,0,0,,Менде сіз үшін тамаша жұмыс бар.
Dialogue: 0,00:21:38.83,00:21:41.38,JPN TOP,,0,0,0,,Мен сені тамаша жұмыспен таныстырамын.
Dialogue: 0,0:21:40.69,0:21:41.70,Main,,0,0,0,,Біреу!
Dialogue: 0,00:21:41.46,00:21:43.88,JPN TOP,,0,0,0,,Яғни, мен қызмын ғой.
Dialogue: 0,00:21:41.46,00:21:46.88,JPN TOP,,0,0,0,,Біреу...біреу маған көмектессін! Нгг...
Dialogue: 0,0:21:42.10,0:21:44.78,Main,,0,0,0,,Маған біреу көмектессін!
Dialogue: 0,00:21:45.47,00:21:46.88,JPN TOP,,0,0,0,,(соққы дыбысы)
Dialogue: 0,00:21:48.93,00:21:50.35,JPN TOP,,0,0,0,,Уф... (ішіп) Уау.
Dialogue: 0,00:21:53.43,00:21:55.35,JPN TOP,,0,0,0,,(Фуши ырылдады)
Dialogue: 0,0:21:54.64,0:21:56.69,Main,,0,0,0,,Бұл ит не болды?
Dialogue: 0,00:21:55.85,00:21:57.64,JPN TOP,,0,0,0,,Не... мына ит не?
Dialogue: 0,0:21:56.69,0:21:57.54,Main,,0,0,0,,Жолдан кет!
Dialogue: 0,00:21:57.73,00:21:59.86,JPN TOP,,0,0,0,,Бұл ыңғайсыздық! Кетіңіз
Dialogue: 0,0:21:57.74,0:21:58.93,Main,,0,0,0,,Жоғалыңыз!
Dialogue: 0,00:22:00.36,00:22:02.48,JPN TOP,,0,0,0,,Аа... Фуши!
Dialogue: 0,0:22:00.62,0:22:01.55,Main,,0,0,0,,Фуши!
Dialogue: 0,0:22:03.04,0:22:05.22,Main,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,00:22:03.82,00:22:06.36,JPN TOP,,0,0,0,,Сіз маған еліктегіңіз келеді.
Dialogue: 0,00:22:06.45,00:22:08.86,JPN TOP,,0,0,0,,Тұрғындар балық аулау мен егіншілікпен күнкөреді—
Dialogue: 0,00:22:10.66,00:22:11.87,JPN TOP,,0,0,0,,Иә...
Dialogue: 0,00:22:11.95,00:22:13.87,JPN TOP,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,00:22:13.95,00:22:16.58,JPN TOP,,0,0,0,,Уау... Эй (адам) міне!
Dialogue: 0,00:22:16.66,00:22:18.58,JPN TOP,,0,0,0,,(Ерлердің айқайы)
Dialogue: 0,00:22:18.67,00:22:20.88,JPN TOP,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,0:22:22.10,0:22:23.16,Main,,0,0,0,,Фуши!
Dialogue: 0,00:22:23.17,00:22:24.09,JPN TOP,,0,0,0,,Фуши!
Dialogue: 0,0:22:23.83,0:22:26.46,Main,,0,0,0,,Сен мұнда жалғыз келдің бе?
Dialogue: 0,00:22:24.96,00:22:29.09,JPN TOP,,0,0,0,,Сен мұнда жалғыз келдің бе? Сіз орманнан қорықпайсыз ба?
Dialogue: 0,0:22:26.46,0:22:28.15,Main,,0,0,0,,Орманнан қорықпайсың ба?
Dialogue: 0,0:22:29.06,0:22:30.19,Main,,0,0,0,,Мен қорқамын...
Dialogue: 0,00:22:30.14,00:22:33.10,JPN TOP,,0,0,0,,Қорқынышты...
Dialogue: 0,0:22:30.65,0:22:32.15,Main,,0,0,0,,бірақ мен осындамын.
Dialogue: 0,00:22:33.18,00:22:34.06,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:22:33.76,0:22:34.99,Main,,0,0,0,,Мен үйрендім.
Dialogue: 0,00:22:34.56,00:22:36.35,JPN TOP,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:22:35.41,0:22:40.99,Main,,0,0,0,,Мен сенсіз өсе алмаймын.
Dialogue: 0,00:22:36.43,00:22:41.94,JPN TOP,,0,0,0,,Мен сенсіз ересек бола алмаймын.
Dialogue: 0,0:22:42.63,0:22:43.85,Main,,0,0,0,,Сіз білесіз...
Dialogue: 0,00:22:43.73,00:22:46.19,JPN TOP,,0,0,0,,Сен... сен
Dialogue: 0,0:22:44.13,0:22:49.08,Main,,0,0,0,,Сіз құбыжық болғаныңызда әлдеқайда кереметсіз.
Dialogue: 0,00:22:46.90,00:22:50.16,JPN TOP,,0,0,0,,Ол құбыжық болғанда салқынырақ
Dialogue: 0,0:22:54.36,0:22:57.23,Main,,0,0,0,,Құбыжықтар үшін ура!
Dialogue: 0,00:22:55.04,00:22:58.46,JPN TOP,,0,0,0,,Құбыжық Банзай!
Dialogue: 0,00:23:01.04,00:23:06.05,JPN TOP,,0,0,0,,♪~
Dialogue: 0,00:24:25.92,00:24:30.92,JPN TOP,,0,0,0,,~♪
Dialogue: 0,0:24:29.98,0:24:51.01,sign_35245_236_Preview,,0,0,0,,Алдын ала қарау
Dialogue: 0,0:24:30.89,0:24:35.48,Narration,,0,0,0,,Фуши ағайындыларға жақын адамдарды тапты.
Dialogue: 0,00:24:31.97,00:24:36.43,JPN TOP,,0,0,0,,Фуши ағайынды өмірге ие болды.
Dialogue: 0,0:24:36.35,0:24:41.99,Narration,,0,0,0,,Санасына сіңіп қалған өткен күннің мұңын сөйлейтін Гугу,
Dialogue: 0,00:24:37.39,00:24:42.93,JPN TOP,,0,0,0,,Гу Гу өткен естеліктерінде сақталған жүрегіндегі ауырсыну туралы айтады.
Dialogue: 0,0:24:43.25,0:24:46.40,Narration,,0,0,0,,және оның еркіндігінің жоқтығына ренжіген Реан.
Dialogue: 0,00:24:44.27,00:24:47.52,JPN TOP,,0,0,0,,Лиан өзінің қолайсыз жағдайларына өкінеді
Dialogue: 0,0:24:47.39,0:24:53.87,Narration,,0,0,0,,Үшеуі бір-бірімен байланыс орната бастағанда, сұмдық көлеңке жасырылады.
Dialogue: 0,00:24:48.15,00:24:51.94,JPN TOP,,0,0,0,,Бір-бірімен сөйлесе бастаған үш адамның қасында
Dialogue: 0,0:24:51.01,0:24:55.01,Episode_Title,,0,0,0,,Терең естеліктер
Dialogue: 0,00:24:52.69,00:24:54.99,JPN TOP,,0,0,0,,Мазасыз көлеңке болды
Dialogue: 0,0:24:56.51,0:25:02.51,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory