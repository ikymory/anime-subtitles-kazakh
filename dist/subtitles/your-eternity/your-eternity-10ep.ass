Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.36,0:00:06.34,Narration,,0,0,0,,Барлық тіршілік иелері тіршілік ету барысында,
Dialogue: 0,00:00:03.42,00:00:07.21,JPN TOP,,0,0,0,,Кез келген адам тірі болғанда, процесте
Dialogue: 0,0:00:06.34,0:00:10.10,Narration,,0,0,0,,олардың әрі қарай өмір сүруіне кедергі жасайтындар кездеседі.
Dialogue: 0,00:00:07.34,00:00:11.21,JPN TOP,,0,0,0,,Көбінесе оған араласатын біреу пайда болады.
Dialogue: 0,0:00:11.47,0:00:18.15,Narration,,0,0,0,,Олар өздеріне кіретін нәрсені алып, жояды, істей алатындарын шектейді.
Dialogue: 0,00:00:12.55,00:00:16.05,JPN TOP,,0,0,0,,Өзін құрайтын нәрсені алып тастау
Dialogue: 0,00:00:16.18,00:00:19.26,JPN TOP,,0,0,0,,Үзілу, таңдауды болдырмау
Dialogue: 0,0:00:19.90,0:00:22.53,Narration,,0,0,0,,Мен бұл туралы жоғары ойламаймын.
Dialogue: 0,00:00:20.93,00:00:23.60,JPN TOP,,0,0,0,,Маған бұл ұнамайды
Dialogue: 0,0:00:23.80,0:00:29.76,Narration,,0,0,0,,Таңдау еркіндігі баршаға берілуі тиіс қасиетті нәрсе.
Dialogue: 0,00:00:24.85,00:00:30.82,JPN TOP,,0,0,0,,Таңдау еркіндігі – әрбір адам ие болуы тиіс құнды нәрсе.
Dialogue: 0,00:00:33.03,00:00:37.78,JPN TOP,,0,0,0,,♪~
Dialogue: 0,00:01:57.90,00:02:02.87,JPN TOP,,0,0,0,,~♪
Dialogue: 0,00:02:07.12,00:02:08.62,JPN TOP,,0,0,0,,Не!
Dialogue: 0,00:02:13.29,00:02:14.50,JPN TOP,,0,0,0,,Уау
Dialogue: 0,0:02:16.07,0:02:20.07,Episode_Title,,0,0,0,,Жаңа отбасы
Dialogue: 0,0:02:20.20,0:02:21.37,Main,,0,0,0,,Фуши!
Dialogue: 0,00:02:21.09,00:02:22.43,JPN TOP,,0,0,0,,Фуши!
Dialogue: 0,0:02:24.93,0:02:26.88,Main,,0,0,0,,Гугу! Жүгір!
Dialogue: 0,00:02:26.06,00:02:27.98,JPN TOP,,0,0,0,,Гуу кет кет
Dialogue: 0,00:02:30.10,00:02:31.44,JPN TOP,,0,0,0,,Ах
Dialogue: 0,00:02:35.94,00:02:37.61,JPN TOP,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:02:37.34,0:02:38.93,Main,,0,0,0,,Бұл емес пе...
Dialogue: 0,00:02:38.49,00:02:39.82,JPN TOP,,0,0,0,,Ол жігіт...
Dialogue: 0,0:02:39.18,0:02:43.03,Flashback,,0,0,0,,Бізге орманда белгісіз бір нәрсе шабуыл жасады.
Dialogue: 0,00:02:39.95,00:02:43.91,JPN TOP,,0,0,0,,Маған орманда жұмбақ адам шабуыл жасады.
Dialogue: 0,0:02:43.03,0:02:46.14,Flashback,,0,0,0,,Бұл ағашқа ұқсайды.
Dialogue: 0,00:02:44.03,00:02:47.04,JPN TOP,,0,0,0,,Бұл нәрсе ағашқа ұқсайды.
Dialogue: 0,0:02:46.45,0:02:48.42,Main,,0,0,0,,Жүгіру! Асығыңыз!
Dialogue: 0,00:02:47.16,00:02:49.29,JPN TOP,,0,0,0,,Тез қашыңыз
Dialogue: 0,0:02:48.42,0:02:50.51,Main,,0,0,0,,Жоқ! Мен саған көмектескім келеді.
Dialogue: 0,00:02:49.41,00:02:51.42,JPN TOP,,0,0,0,,Жоқ! Мен саған көмектескім келеді!
Dialogue: 0,00:02:53.84,00:02:54.67,JPN TOP,,0,0,0,,италиялықтарға тән —
Dialogue: 0,00:02:54.79,00:02:55.67,JPN TOP,,0,0,0,,Уау
Dialogue: 0,00:03:02.72,00:03:03.93,JPN TOP,,0,0,0,,(Фуши үреді)
Dialogue: 0,00:03:04.05,00:03:06.26,JPN TOP,,0,0,0,,Уау... уф...
Dialogue: 0,0:03:06.97,0:03:07.99,Main,,0,0,0,,Фуши!
Dialogue: 0,00:03:08.02,00:03:08.89,JPN TOP,,0,0,0,,Фуши!
Dialogue: 0,00:03:10.77,00:03:12.90,JPN TOP,,0,0,0,,(Фушидің қатты тыныс алуы)
Dialogue: 0,00:03:17.53,00:03:18.32,JPN TOP,,0,0,0,,Хамф!
Dialogue: 0,00:03:20.86,00:03:21.99,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:03:22.05,0:03:23.72,Main,,0,0,0,,(Тик-так, тик-так соғады сағат)
Dialogue: 0,00:03:23.20,00:03:26.33,JPN TOP,,0,0,0,,Жарайсыңдар! Уау...
Dialogue: 0,00:03:28.04,00:03:31.37,JPN TOP,,0,0,0,,Не? Эх... Уау...
Dialogue: 0,0:03:31.12,0:03:32.31,Main,,0,0,0,,Гугу!
Dialogue: 0,00:03:32.17,00:03:33.33,JPN TOP,,0,0,0,,Жарайсың!
Dialogue: 0,00:03:34.00,00:03:35.00,JPN TOP,,0,0,0,,Гррр…
Dialogue: 0,00:03:40.09,00:03:44.18,JPN TOP,,0,0,0,,Уау... уф... уф...
Dialogue: 0,00:03:44.30,00:03:47.56,JPN TOP,,0,0,0,,Уф... уф...
Dialogue: 0,00:03:47.68,00:03:50.06,JPN TOP,,0,0,0,,(жөтел)
Dialogue: 0,0:03:49.09,0:03:50.64,Main,,0,0,0,,Ішімдік...
Dialogue: 0,00:03:50.18,00:03:52.56,JPN TOP,,0,0,0,,Алкоголь...
Dialogue: 0,0:03:53.65,0:03:54.83,Main,,0,0,0,,Фуши...
Dialogue: 0,00:03:54.69,00:03:56.23,JPN TOP,,0,0,0,,Фуши…
Dialogue: 0,0:03:55.60,0:03:58.61,Main,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,00:03:56.77,00:03:59.73,JPN TOP,,0,0,0,,Мен не істеуім керек...
Dialogue: 0,0:04:00.60,0:04:01.66,Main,,0,0,0,,Әй, ыстық!
Dialogue: 0,00:04:01.57,00:04:03.11,JPN TOP,,0,0,0,,Атчи
Dialogue: 0,0:04:03.04,0:04:04.43,Main,,0,0,0,,Бұл от қайдан шықты?
Dialogue: 0,00:04:04.07,00:04:05.49,JPN TOP,,0,0,0,,Неліктен өрт шықты?
Dialogue: 0,00:04:06.16,00:04:06.95,JPN TOP,,0,0,0,,Ах!
Dialogue: 0,0:04:07.73,0:04:09.03,Main,,0,0,0,,Мен түсіндім.
Dialogue: 0,00:04:08.79,00:04:10.12,JPN TOP,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:09.85,0:04:13.22,Main,,0,0,0,,Бұл өрт мен ішкен ішімдікке тарады.
Dialogue: 0,00:04:11.00,00:04:14.33,JPN TOP,,0,0,0,,Мен шашқан спирт осы отты тұтандырды...
Dialogue: 0,0:04:15.42,0:04:16.88,Main,,0,0,0,,Менде бір идея бар!
Dialogue: 0,00:04:15.46,00:04:18.09,JPN TOP,,0,0,0,,А, менде бір идея бар!
Dialogue: 0,00:04:18.21,00:04:20.59,JPN TOP,,0,0,0,,(Гу-Гудың ауыр тыныс алуы)
Dialogue: 0,0:04:28.36,0:04:30.79,Main,,0,0,0,,Оны дәл қазір Фуши алаңдатып отыр.
Dialogue: 0,00:04:29.22,00:04:31.89,JPN TOP,,0,0,0,,Оның назарын Фуши аударып жіберді.
Dialogue: 0,0:04:32.72,0:04:33.69,Main,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,00:04:33.81,00:04:34.60,JPN TOP,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:04:35.14,0:04:39.47,Main,,0,0,0,,Ішімнен шыдап, құсамын.
Dialogue: 0,00:04:36.19,00:04:38.61,JPN TOP,,0,0,0,,Ішіңізді қатайтыңыз...
Dialogue: 0,00:04:38.73,00:04:40.36,JPN TOP,,0,0,0,,Бірден құсу керек!
Dialogue: 0,00:04:41.36,00:04:43.32,JPN TOP,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:04:42.31,0:04:44.43,Main,,0,0,0,,Иә? Неліктен?
Dialogue: 0,00:04:43.44,00:04:45.32,JPN TOP,,0,0,0,,Неліктен?
Dialogue: 0,0:04:44.62,0:04:47.17,Main,,0,0,0,,Ол ертерек жақсы жұмыс істеді.
Dialogue: 0,00:04:45.45,00:04:47.41,JPN TOP,,0,0,0,,Дәл қазір күшті шыққанымен
Dialogue: 0,00:04:47.53,00:04:49.95,JPN TOP,,0,0,0,,Ха! Гохо…
Dialogue: 0,0:04:51.17,0:04:53.72,Main,,0,0,0,,Жоқ... Мен боспын ба?
Dialogue: 0,00:04:51.95,00:04:55.33,JPN TOP,,0,0,0,,Жоқ... бос па?
Dialogue: 0,00:04:55.46,00:04:57.04,JPN TOP,,0,0,0,,Бұзушылық жоқ! (жұт) Уау
Dialogue: 0,00:04:57.17,00:04:58.58,JPN TOP,,0,0,0,,Гах...
Dialogue: 0,0:04:59.12,0:05:00.16,Main,,0,0,0,,Фуши!
Dialogue: 0,00:05:00.21,00:05:01.05,JPN TOP,,0,0,0,,Фуши!
Dialogue: 0,0:05:00.31,0:05:03.11,Main,,0,0,0,,Жүгір, әйтпесе ашуланамын!
Dialogue: 0,00:05:01.17,00:05:05.30,JPN TOP,,0,0,0,,Сен қашпасаң, мен жынданып қаламын. Жоқ, мұнда!
Dialogue: 0,0:05:03.11,0:05:04.40,Main,,0,0,0,,Осы жерден кетіңіз!
Dialogue: 0,00:05:05.43,00:05:07.72,JPN TOP,,0,0,0,,Ку… Гуруруру…
Dialogue: 0,0:05:06.74,0:05:07.90,Main,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,00:05:07.84,00:05:08.80,JPN TOP,,0,0,0,,Асығыңыз!
Dialogue: 0,00:05:10.01,00:05:11.39,JPN TOP,,0,0,0,,Уф
Dialogue: 0,0:05:10.77,0:05:12.83,Main,,0,0,0,,Онда тұрыңыз. Мен бес минуттан кейін қайтамын.
Dialogue: 0,00:05:11.51,00:05:13.73,JPN TOP,,0,0,0,,Шыда! Мен 5 минуттан кейін қайтамын
Dialogue: 0,0:05:12.83,0:05:13.81,Main,,0,0,0,,(Тик-так, сағаттың көрсеткіштері тик-так)
Dialogue: 0,0:05:13.81,0:05:15.57,Main,,0,0,0,,Қайт, мен сені тістеймін!
Dialogue: 0,00:05:13.85,00:05:16.48,JPN TOP,,0,0,0,,Жоқ! Қайтып келгенде тістеймін.
Dialogue: 0,0:05:15.84,0:05:17.52,Main,,0,0,0,,Мен үшін жұмыс істейді!
Dialogue: 0,00:05:16.60,00:05:18.31,JPN TOP,,0,0,0,,Бұл жоғары деңгей!
Dialogue: 0,00:05:18.86,00:05:20.73,JPN TOP,,0,0,0,,(Гу-Гудың ауыр тыныс алуы)
Dialogue: 0,0:05:20.07,0:05:22.61,Italics,,0,0,0,,Мен бір минуттан кейін Booze Man орнына ораламын
Dialogue: 0,00:05:20.86,00:05:23.48,JPN TOP,,0,0,0,,Бір минутта Саке қарияның үйіне бар.
Dialogue: 0,0:05:22.61,0:05:25.45,Italics,,0,0,0,,және бір ішімдікті екіге бөліп қайтып келіңіз.
Dialogue: 0,00:05:23.61,00:05:26.74,JPN TOP,,0,0,0,,Ол 2 минуттан кейін ішегінде спиртпен оралады.
Dialogue: 0,0:05:26.07,0:05:28.01,Italics,,0,0,0,,Күте тұрыңыз, Фуши.
Dialogue: 0,00:05:26.86,00:05:29.03,JPN TOP,,0,0,0,,Күте тұрыңыз, Фуши!
Dialogue: 0,00:05:30.58,00:05:31.74,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,00:05:33.29,00:05:34.16,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:05:35.08,0:05:36.98,Main,,0,0,0,,Не болды?
Dialogue: 0,00:05:35.87,00:05:37.83,JPN TOP,,0,0,0,,What... what?
Dialogue: 0,00:05:38.37,00:05:41.17,JPN TOP,,0,0,0,,Ку… мм… Га!
Dialogue: 0,0:05:40.62,0:05:43.36,Italics,,0,0,0,,Дұрыс, бұл ішімдік.
Dialogue: 0,00:05:41.75,00:05:44.26,JPN TOP,,0,0,0,,Түсінемін, алкогольдің кесірінен...
Dialogue: 0,0:05:44.29,0:05:45.31,Italics,,0,0,0,,Тұр.
Dialogue: 0,00:05:45.38,00:05:46.42,JPN TOP,,0,0,0,,Тұру
Dialogue: 0,0:05:46.32,0:05:47.77,Italics,,0,0,0,,Менің кетуім керек.
Dialogue: 0,00:05:47.55,00:05:48.89,JPN TOP,,0,0,0,,Кеттік
Dialogue: 0,0:05:50.51,0:05:56.54,Italics,,0,0,0,,Фушиді құтқаратын жалғыз сенсің, Гугу!
Dialogue: 0,00:05:50.93,00:05:55.77,JPN TOP,,0,0,0,,Фушиді құтқаратын жалғыз адам сенсің!
Dialogue: 0,00:05:56.48,00:05:57.60,JPN TOP,,0,0,0,,Жарайсың!
Dialogue: 0,00:05:57.73,00:06:00.90,JPN TOP,,0,0,0,,(Гу-Гудың ауыр тыныс алуы)
Dialogue: 0,0:06:00.46,0:06:02.99,Italics,,0,0,0,,Міне. Бар.
Dialogue: 0,00:06:01.56,00:06:04.03,JPN TOP,,0,0,0,,Иә, барыңыз.
Dialogue: 0,0:06:04.64,0:06:05.81,Italics,,0,0,0,,Қасиетті орындарым қалайша күйреді.
Dialogue: 0,00:06:05.74,00:06:06.94,JPN TOP,,0,0,0,,Біз жарты жолды өтіп қойдық — бізді тежеме, жарай ма?
Dialogue: 0,0:06:06.54,0:06:09.78,Italics,,0,0,0,,Сіз жақындап қалдыңыз...
Dialogue: 0,00:06:07.61,00:06:08.74,JPN TOP,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,00:06:09.45,00:06:10.78,JPN TOP,,0,0,0,,Кішкене!
Dialogue: 0,00:06:18.79,00:06:20.04,JPN TOP,,0,0,0,,Ах!
Dialogue: 0,0:06:19.53,0:06:22.40,Main,,0,0,0,,Реан-самамен бірге болған сенсің.
Dialogue: 0,00:06:20.58,00:06:23.34,JPN TOP,,0,0,0,,Лианна-самамен бірге болған сіз едіңіз.
Dialogue: 0,0:06:22.40,0:06:23.33,Main,,0,0,0,,Жер
Dialogue: 0,00:06:23.46,00:06:25.05,JPN TOP,,0,0,0,,Не? (Леннің әкесі) Не!
Dialogue: 0,0:06:24.11,0:06:28.08,Main,,0,0,0,,Менің қызымды алдаған сен бе?
Dialogue: 0,00:06:25.17,00:06:28.97,JPN TOP,,0,0,0,,Қызымды азғырған сен бе?
Dialogue: 0,0:06:28.34,0:06:30.59,Main,,0,0,0,,Мен айттым ғой!
Dialogue: 0,00:06:29.09,00:06:31.43,JPN TOP,,0,0,0,,Сіз мұны біраздан бері айтып жүрсіз!
Dialogue: 0,0:06:30.59,0:06:32.85,Main,,0,0,0,,Мен үйден өз бетіммен шықтым!
Dialogue: 0,00:06:31.55,00:06:33.76,JPN TOP,,0,0,0,,Мен үйден рұқсатсыз қашып кеттім.
Dialogue: 0,0:06:32.85,0:06:35.28,Main,,0,0,0,,Олардың бұған қатысы жоқ!
Dialogue: 0,00:06:33.89,00:06:36.14,JPN TOP,,0,0,0,,Бұл адамдардың бұған қатысы жоқ!
Dialogue: 0,0:06:35.28,0:06:37.75,Main,,0,0,0,,Сіз! Менің қызыма не істедің?
Dialogue: 0,00:06:36.27,00:06:38.85,JPN TOP,,0,0,0,,Сіз! Балама не істедің?
Dialogue: 0,0:06:39.01,0:06:43.08,Main,,0,0,0,,Кешіріңіз. Мен әкем осында келеді деп ойламадым.
Dialogue: 0,00:06:40.06,00:06:43.90,JPN TOP,,0,0,0,,Кешіріңіз, әкелеріңіз осыншалықты келеді деп ойламадым.
Dialogue: 0,00:06:44.02,00:06:46.23,JPN TOP,,0,0,0,,Хмм...
Dialogue: 0,0:06:45.61,0:06:47.66,Main,,0,0,0,,Оны қалдырайық, қымбаттым.
Dialogue: 0,00:06:46.36,00:06:50.24,JPN TOP,,0,0,0,,Жарайды, кешігіп жатырсың.
Dialogue: 0,0:06:47.66,0:06:49.33,Main,,0,0,0,,Кеш батты.
Dialogue: 0,00:06:50.36,00:06:52.32,JPN TOP,,0,0,0,,Уау...
Dialogue: 0,0:06:51.36,0:06:53.85,Main,,0,0,0,,Не болды, Гугу?
Dialogue: 0,00:06:52.45,00:06:56.08,JPN TOP,,0,0,0,,Не болды? Гоу, бәрі біртүрлі.
Dialogue: 0,0:06:53.85,0:06:55.49,Main,,0,0,0,,Сізде бірдеңе дұрыс емес сияқты.
Dialogue: 0,00:06:56.20,00:06:57.54,JPN TOP,,0,0,0,,Иә
Dialogue: 0,0:06:58.08,0:07:00.07,Main,,0,0,0,,Маған ішімдік беріңізші, қария!
Dialogue: 0,00:06:58.33,00:07:00.92,JPN TOP,,0,0,0,,Ху... Джи-шан, маған алкоголь берші!
Dialogue: 0,0:07:00.07,0:07:02.80,Main,,0,0,0,,Өте күшті нәрсе!
Dialogue: 0,00:07:01.04,00:07:03.71,JPN TOP,,0,0,0,,Иә, мықты бол!
Dialogue: 0,00:07:03.84,00:07:04.96,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,00:07:05.09,00:07:06.21,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,00:07:06.34,00:07:07.71,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,00:07:07.84,00:07:09.22,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,00:07:09.34,00:07:13.72,JPN TOP,,0,0,0,,Уи~ Хи хи хи...
Dialogue: 0,0:07:13.27,0:07:15.28,Main,,0,0,0,,Арақ ішуді қалайсыз ба?
Dialogue: 0,00:07:13.85,00:07:16.10,JPN TOP,,0,0,0,,Маған алкоголь беріңізші?
Dialogue: 0,0:07:15.28,0:07:17.45,Main,,0,0,0,,Саған не болып жатыр, Гугу?
Dialogue: 0,00:07:16.22,00:07:18.35,JPN TOP,,0,0,0,,Не болды, Гу Гу?
Dialogue: 0,0:07:17.45,0:07:18.82,Main,,0,0,0,,Қараңыз, қаншама Ято-ра бар
Dialogue: 0,00:07:18.47,00:07:21.31,JPN TOP,,0,0,0,,Әйтеуір, ішімдегі ішімдік
Dialogue: 0,0:07:18.82,0:07:23.34,Main,,0,0,0,,Менің ішімдегі ішімдік бітті!
Dialogue: 0,00:07:21.44,00:07:24.23,JPN TOP,,0,0,0,,Ол бос!
Dialogue: 0,0:07:23.58,0:07:26.48,Main,,0,0,0,,Маған ішімдік бермеңіз.
Dialogue: 0,00:07:24.36,00:07:27.36,JPN TOP,,0,0,0,,Қараңызшы, бұл жай ғана алкоголь емес!
Dialogue: 0,0:07:26.48,0:07:29.21,Main,,0,0,0,,Маған ең күшті бок беріңіз!
Dialogue: 0,00:07:27.48,00:07:30.11,JPN TOP,,0,0,0,,Маған ең жаманы үшін қызмет ет!
Dialogue: 0,0:07:29.63,0:07:31.89,Main,,0,0,0,,Қандай сұмдық бала!
Dialogue: 0,00:07:30.65,00:07:33.11,JPN TOP,,0,0,0,,Жақсы! Қандай бала
Dialogue: 0,0:07:32.21,0:07:37.00,Main - Top,,0,0,0,,Мен ең жақсы нәрсені қалаймын!
Dialogue: 0,0:07:32.50,0:07:34.67,Main,,0,0,0,,Сәлем! Саған не болды?
Dialogue: 0,00:07:33.24,00:07:35.45,JPN TOP,,0,0,0,,Эй, не болып жатыр?
Dialogue: 0,0:07:34.67,0:07:37.00,Main,,0,0,0,,Не болды? Фуши-сан қайда?
Dialogue: 0,00:07:35.58,00:07:37.83,JPN TOP,,0,0,0,,Не болды? Фуши ше?
Dialogue: 0,00:07:37.95,00:07:38.95,JPN TOP,,0,0,0,,Мені тыңда!
Dialogue: 0,0:07:38.48,0:07:41.15,Main,,0,0,0,,Фуши орманда, бум сияқты!
Dialogue: 0,00:07:39.62,00:07:41.96,JPN TOP,,0,0,0,,Фуши орманда жарқырайды!
Dialogue: 0,0:07:41.15,0:07:43.44,Main,,0,0,0,,Ввум, ввум!
Dialogue: 0,00:07:42.08,00:07:44.33,JPN TOP,,0,0,0,,Буон Буон
Dialogue: 0,0:07:43.44,0:07:46.87,Main,,0,0,0,,Сондықтан мен бірден оралуым керек.
Dialogue: 0,00:07:44.46,00:07:47.75,JPN TOP,,0,0,0,,Сондықтан мен бірден қайтуым керек.
Dialogue: 0,0:07:46.87,0:07:49.89,Main,,0,0,0,,Ақсақал, мен осының қамын жасайын.
Dialogue: 0,00:07:47.88,00:07:50.80,JPN TOP,,0,0,0,,Ата, мұны маған қалдырыңыз.
Dialogue: 0,0:07:49.89,0:07:52.84,Main,,0,0,0,,Оның айтқанын орындаңыз. Ешқандай сұрақ қоймаңыз.
Dialogue: 0,00:07:50.92,00:07:53.80,JPN TOP,,0,0,0,,Тек аузыңды жап, Гу Гуның айтқанын істе.
Dialogue: 0,0:07:52.84,0:07:55.16,Main,,0,0,0,,A-Жарайды.
Dialogue: 0,00:07:53.93,00:07:56.05,JPN TOP,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:07:58.41,0:08:01.23,Main,,0,0,0,,Бұл ішімдік қайта-қайта тазартылған.
Dialogue: 0,00:07:59.43,00:08:01.98,JPN TOP,,0,0,0,,Бұл қайта-қайта тазартылды⸺
Dialogue: 0,0:08:01.23,0:08:04.27,Main,,0,0,0,,Бұл біздегі ең күштісі.
Dialogue: 0,00:08:02.10,00:08:05.44,JPN TOP,,0,0,0,,Бұл біздің дүкендегі ең күшті ішімдік.
Dialogue: 0,00:08:06.52,00:08:07.69,JPN TOP,,0,0,0,,Иә
Dialogue: 0,00:08:07.82,00:08:11.69,JPN TOP,,0,0,0,,(тұншықтырған дауыс)
Dialogue: 0,0:08:10.95,0:08:12.52,Main,,0,0,0,,Мен солай ойладым.
Dialogue: 0,00:08:11.82,00:08:16.45,JPN TOP,,0,0,0,,Өйткені, ол бір жерде зақымдалған болуы мүмкін.
Dialogue: 0,0:08:12.52,0:08:15.55,Main,,0,0,0,,Бір жерде жарылған болуы мүмкін.
Dialogue: 0,0:08:15.92,0:08:18.00,Main,,0,0,0,,You need to do something about it, or you'll die.
Dialogue: 0,00:08:16.99,00:08:18.99,JPN TOP,,0,0,0,,Осылай жүрсең өлесің.
Dialogue: 0,0:08:18.81,0:08:21.27,Main,,0,0,0,,Бұл үшін сәл кеш!
Dialogue: 0,00:08:19.91,00:08:22.08,JPN TOP,,0,0,0,,Бұл қазір қай ауыз?
Dialogue: 0,0:08:21.27,0:08:22.98,Main,,0,0,0,,Тезірек оны маған құй!
Dialogue: 0,00:08:22.21,00:08:23.87,JPN TOP,,0,0,0,,Қазір кіріңіз!
Dialogue: 0,0:08:23.15,0:08:25.27,Main - Top,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,00:08:24.00,00:08:25.29,JPN TOP,,0,0,0,,Жүр, асығыңыз!
Dialogue: 0,0:08:24.22,0:08:25.79,Main,,0,0,0,,Біз кетеміз, Реан.
Dialogue: 0,00:08:25.42,00:08:27.25,JPN TOP,,0,0,0,,Мен үйге бара жатырмын, Линна.
Dialogue: 0,00:08:27.38,00:08:31.17,JPN TOP,,0,0,0,,Жоқ! Маған бұл жер ұнайды!
Dialogue: 0,0:08:27.44,0:08:30.27,Main,,0,0,0,,Жоқ! Маған бұл жер ұнайды!
Dialogue: 0,0:08:30.27,0:08:31.97,Main,,0,0,0,,Бұл жеткілікті.
Dialogue: 0,00:08:31.30,00:08:35.13,JPN TOP,,0,0,0,,Бейқам болмаңыз. Бұл жердегі адамдарға қиындық тудырады.
Dialogue: 0,0:08:31.97,0:08:34.06,Main,,0,0,0,,You're causing trouble for the people here, too.
Dialogue: 0,0:08:35.11,0:08:40.07,Main,,0,0,0,,She throws tantrums when she doesn't get her way.
Dialogue: 0,00:08:36.14,00:08:38.39,JPN TOP,,0,0,0,,Менің жолым болмаса⸺
Dialogue: 0,00:08:38.51,00:08:41.06,JPN TOP,,0,0,0,,Тынысы кеткен бала.
Dialogue: 0,0:08:40.07,0:08:41.74,Main,,0,0,0,,Сол себепті ол да үйден кетіп қалды.
Dialogue: 0,00:08:41.18,00:08:43.10,JPN TOP,,0,0,0,,Үйден қашу да солай.
Dialogue: 0,0:08:42.18,0:08:44.36,Main,,0,0,0,,Бірақ бұл проблема емес.
Dialogue: 0,00:08:43.23,00:08:45.44,JPN TOP,,0,0,0,,Бірақ проблема жоқ
Dialogue: 0,0:08:45.78,0:08:50.37,Main,,0,0,0,,Don't you think the problem is that you don't see a problem with that?
Dialogue: 0,00:08:46.85,00:08:51.28,JPN TOP,,0,0,0,,Isn't what you think is not a problem the problem?
Dialogue: 0,00:08:51.86,00:08:52.82,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:08:53.41,0:08:55.14,Main,,0,0,0,,Кел, кеттік.
Dialogue: 0,00:08:54.40,00:08:56.03,JPN TOP,,0,0,0,,Енді үйге қайт.
Dialogue: 0,0:08:56.98,0:08:59.27,Main,,0,0,0,,Жоқ! Мен үйге бармаймын!
Dialogue: 0,00:08:58.03,00:09:00.16,JPN TOP,,0,0,0,,Жоқ! Мен үйге бармаймын!
Dialogue: 0,0:08:59.49,0:09:01.33,Main,,0,0,0,,Эгоизмді доғар!
Dialogue: 0,00:09:00.28,00:09:03.25,JPN TOP,,0,0,0,,Өзімшіл болма (Арық) Жоқ, жібер!
Dialogue: 0,0:09:00.53,0:09:02.94,Main,,0,0,0,,Жоқ! Мені жіберіңізші!
Dialogue: 0,00:09:03.37,00:09:04.16,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:09:03.44,0:09:05.76,Main,,0,0,0,,Үйге бара алмайсың.
Dialogue: 0,00:09:04.29,00:09:06.62,JPN TOP,,0,0,0,,Үйге барма
Dialogue: 0,0:09:05.76,0:09:07.47,Main,,0,0,0,,Бұл сіздің шаруаңыз емес.
Dialogue: 0,00:09:06.75,00:09:09.42,JPN TOP,,0,0,0,,It has nothing to do with you, just let it go.
Dialogue: 0,0:09:07.47,0:09:08.53,Main,,0,0,0,,Кетілді!
Dialogue: 0,0:09:08.71,0:09:12.89,Main,,0,0,0,,Сіз бара алмайсыз!
Dialogue: 0,00:09:09.54,00:09:13.80,JPN TOP,,0,0,0,,Не болса да, Рам!
Dialogue: 0,0:09:12.89,0:09:14.90,Main,,0,0,0,,Мен жоқ дедім!
Dialogue: 0,00:09:13.92,00:09:15.80,JPN TOP,,0,0,0,,Қалай болғанда да, жақсы емес!
Dialogue: 0,0:09:17.25,0:09:19.36,Main,,0,0,0,,Сіздің шағымыңыз қандай?
Dialogue: 0,00:09:17.39,00:09:18.18,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,00:09:18.30,00:09:20.26,JPN TOP,,0,0,0,,Не нәрсеге көңіліңіз толмайды?
Dialogue: 0,0:09:19.71,0:09:24.90,Main,,0,0,0,,Біз сенің мақтаншақ ересек адам болуың үшін бәрін жасамадық па?
Dialogue: 0,00:09:20.39,00:09:21.68,JPN TOP,,0,0,0,,Барлық оқтарыңды жауға беріңдер!!
Dialogue: 0,00:09:21.81,00:09:25.69,JPN TOP,,0,0,0,,Мен сені болашақта ұятқа қалдырмау үшін қолымнан келгеннің бәрін жасадым деп ойладым.
Dialogue: 0,0:09:24.90,0:09:26.01,Main,,0,0,0,,Дәл солай!
Dialogue: 0,00:09:25.81,00:09:27.48,JPN TOP,,0,0,0,,Міне! (Әке) А?
Dialogue: 0,0:09:26.88,0:09:29.01,Main,,0,0,0,,Мен көбірек еркіндікті қалаймын.
Dialogue: 0,00:09:28.02,00:09:31.69,JPN TOP,,0,0,0,,Мен еркін өмір сүргім келеді...
Dialogue: 0,0:09:29.01,0:09:30.80,Main,,0,0,0,,Мен ебедейсіз өмір сүргім келеді.
Dialogue: 0,0:09:30.80,0:09:32.88,Main,,0,0,0,,Ұят болғаны соншалық.
Dialogue: 0,00:09:31.82,00:09:33.78,JPN TOP,,0,0,0,,Бұл ұятқа қалды!
Dialogue: 0,0:09:36.11,0:09:38.70,Main,,0,0,0,,Жарайды. Мен түсінемін.
Dialogue: 0,00:09:36.90,00:09:39.57,JPN TOP,,0,0,0,,Жарайды, солай.
Dialogue: 0,0:09:38.70,0:09:42.18,Main,,0,0,0,,Кімге үйленетініңді таңдағанымыз ұнамады.
Dialogue: 0,00:09:39.70,00:09:43.16,JPN TOP,,0,0,0,,Біреу сіздің жарыңызды рұқсатсыз шешкені сізге ұнамады, солай ма?
Dialogue: 0,0:09:43.14,0:09:45.13,Main,,0,0,0,,Жоқ!
Dialogue: 0,00:09:43.33,00:09:45.96,JPN TOP,,0,0,0,,Ха... жоқ.
Dialogue: 0,00:09:46.08,00:09:49.04,JPN TOP,,0,0,0,,Нухахаха... Шынымен бе?
Dialogue: 0,0:09:47.09,0:09:48.13,Main,,0,0,0,,Шынайы ма?
Dialogue: 0,0:09:48.51,0:09:51.82,Main,,0,0,0,,Реан-санның күйеуі сапқа тұрды ма?
Dialogue: 0,00:09:49.58,00:09:52.50,JPN TOP,,0,0,0,,Лин-Чан, сіз некелік жарыңызды әлі шештіңіз бе?
Dialogue: 0,0:09:51.82,0:09:53.71,Main,,0,0,0,,Жоқ, бұл...
Dialogue: 0,00:09:52.63,00:09:54.80,JPN TOP,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:09:56.37,0:09:59.16,Main,,0,0,0,,Мен жігіттің кім екенін білмеймін,
Dialogue: 0,00:09:57.17,00:10:00.05,JPN TOP,,0,0,0,,Мен қайда екенін білмеймін.
Dialogue: 0,0:09:59.47,0:10:05.40,Main,,0,0,0,,бірақ Реан-санды ең жақсы көретін мен, Гугу.
Dialogue: 0,00:10:00.18,00:10:06.31,JPN TOP,,0,0,0,,Лин Чанды ең жақсы көретін адам - ​​мен... Гу Гу.
Dialogue: 0,00:10:06.93,00:10:07.81,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:10:08.57,0:10:10.54,Main,,0,0,0,,Әйтеуір, мен қазір барамын.
Dialogue: 0,00:10:09.56,00:10:13.02,JPN TOP,,0,0,0,,Жарайды, мен кетейін. Рақмет сізге!
Dialogue: 0,0:10:10.54,0:10:11.89,Main,,0,0,0,,Онымен айналысыңыз!
Dialogue: 0,0:10:18.85,0:10:20.58,Main,,0,0,0,,Біз де кетеміз.
Dialogue: 0,00:10:19.95,00:10:21.66,JPN TOP,,0,0,0,,Біз де үйге барамыз.
Dialogue: 0,00:10:31.96,00:10:33.09,JPN TOP,,0,0,0,,Ах
Dialogue: 0,00:10:40.43,00:10:41.68,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,00:10:42.72,00:10:46.02,JPN TOP,,0,0,0,,(Гу-Гудың ауыр тыныс алуы)
Dialogue: 0,0:10:45.03,0:10:47.37,Main,,0,0,0,,Фуши! Мен қайтып келдім!
Dialogue: 0,00:10:46.14,00:10:48.35,JPN TOP,,0,0,0,,Фуши қайтып келді!
Dialogue: 0,0:10:47.86,0:10:49.45,Main,,0,0,0,,Жау қайда?
Dialogue: 0,00:10:49.02,00:10:50.35,JPN TOP,,0,0,0,,Жау қайда?
Dialogue: 0,0:10:51.57,0:10:52.74,Main,,0,0,0,,Фуши...
Dialogue: 0,00:10:52.65,00:10:53.81,JPN TOP,,0,0,0,,Фуши?
Dialogue: 0,00:10:56.94,00:10:58.36,JPN TOP,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,00:10:58.49,00:11:03.37,JPN TOP,,0,0,0,,(ағаштардың сынған дыбысы)
Dialogue: 0,0:11:02.65,0:11:04.71,Main,,0,0,0,,Сен амансың, Фуси!
Dialogue: 0,00:11:03.49,00:11:05.79,JPN TOP,,0,0,0,,Амансың ба? Фуши!
Dialogue: 0,0:11:06.26,0:11:07.46,Main,,0,0,0,,Ақыры заман мені қуып жетті ме?
Dialogue: 0,00:11:06.37,00:11:09.79,JPN TOP,,0,0,0,,Аа, жоқ... бұл Фуши емес.
Dialogue: 0,0:11:07.46,0:11:08.78,Main,,0,0,0,,Бұл Фуши емес.
Dialogue: 0,0:11:13.56,0:11:15.63,Main,,0,0,0,,Фуши, сен қайдасың?
Dialogue: 0,00:11:14.63,00:11:17.88,JPN TOP,,0,0,0,,Фуши Қай жерде? Фуши!
Dialogue: 0,0:11:16.08,0:11:16.97,Main,,0,0,0,,Фуши!
Dialogue: 0,00:11:22.01,00:11:24.89,JPN TOP,,0,0,0,,(қорқынышты дауыс)
Dialogue: 0,0:11:24.54,0:11:27.89,Main,,0,0,0,,Фушиді қайда апардың?! Сен бейбақ!
Dialogue: 0,00:11:25.68,00:11:28.93,JPN TOP,,0,0,0,,Фушиді қайда жібердің? Сен бейбақ!
Dialogue: 0,00:11:29.77,00:11:31.39,JPN TOP,,0,0,0,,Уау...
Dialogue: 0,0:11:32.16,0:11:33.99,Main,,0,0,0,,Фушиді қайтарыңыз!
Dialogue: 0,00:11:32.94,00:11:34.56,JPN TOP,,0,0,0,,Таяқшаны қайтарыңыз!
Dialogue: 0,00:11:38.53,00:11:40.07,JPN TOP,,0,0,0,,(айқай)
Dialogue: 0,00:11:40.19,00:11:41.28,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,00:11:41.45,00:11:42.57,JPN TOP,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,00:11:44.87,00:11:47.54,JPN TOP,,0,0,0,,Уау Уау...
Dialogue: 0,0:11:49.95,0:11:51.52,Main,,0,0,0,,Сіз не істеп жатыр деп ойлайсыз?
Dialogue: 0,00:11:51.04,00:11:53.54,JPN TOP,,0,0,0,,Қандай ақша? Кетіңіз
Dialogue: 0,0:11:51.52,0:11:52.63,Main,,0,0,0,,Жолдан кетіңізші.
Dialogue: 0,00:11:59.59,00:12:00.51,JPN TOP,,0,0,0,,Құт
Dialogue: 0,00:12:03.05,00:12:05.68,JPN TOP,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,00:12:06.60,00:12:08.14,JPN TOP,,0,0,0,,Су... Уау!
Dialogue: 0,00:12:16.15,00:12:17.02,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,00:12:17.15,00:12:18.27,JPN TOP,,0,0,0,,Ах!
Dialogue: 0,0:12:24.55,0:12:26.13,Main,,0,0,0,,Менде көбірек!
Dialogue: 0,00:12:24.78,00:12:27.03,JPN TOP,,0,0,0,,Шыу!
Dialogue: 0,00:12:25.61,00:12:27.03,JPN TOP,,0,0,0,,Тоқта! (Ичи) Ә? Мұнда ма?
Dialogue: 0,00:12:27.16,00:12:28.49,JPN TOP,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,00:12:30.87,00:12:32.66,JPN TOP,,0,0,0,,Жәй ғана кішкентай сызат жеткілікті.
Dialogue: 0,0:12:37.76,0:12:38.85,Main,,0,0,0,,Ол жанып жатыр...
Dialogue: 0,00:12:38.75,00:12:41.42,JPN TOP,,0,0,0,,Жанып жатыр... Жанып жатыр!
Dialogue: 0,0:12:39.14,0:12:40.31,Main,,0,0,0,,Жанып жатыр!
Dialogue: 0,0:12:41.52,0:12:42.92,Main,,0,0,0,,Гугу...
Dialogue: 0,00:12:42.76,00:12:44.26,JPN TOP,,0,0,0,,Гу Гу
Dialogue: 0,0:12:56.19,0:12:58.62,Main,,0,0,0,,Фуши... Қайда бардың?
Dialogue: 0,00:12:57.15,00:12:59.69,JPN TOP,,0,0,0,,Фуши, сен қайда бардың?
Dialogue: 0,0:13:01.40,0:13:03.25,Main,,0,0,0,,Сіз сындыңыз ба?
Dialogue: 0,00:13:02.44,00:13:06.28,JPN TOP,,0,0,0,,Сізді жеп қойдыңыз ба? Сен өлмейтін болсаң да...
Dialogue: 0,0:13:03.64,0:13:05.19,Main,,0,0,0,,Мен сені өлмейтін деп ойладым.
Dialogue: 0,00:13:07.24,00:13:08.57,JPN TOP,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:13:08.34,0:13:11.86,Main,,0,0,0,,Мен мұнда сенімен өте көңілді болдым.
Dialogue: 0,00:13:09.45,00:13:13.08,JPN TOP,,0,0,0,,Сізге рахмет, көңілді өтті.
Dialogue: 0,0:13:12.52,0:13:14.16,Main,,0,0,0,,Мен өте қуаныштымын.
Dialogue: 0,00:13:13.62,00:13:15.58,JPN TOP,,0,0,0,,Мен бақытты болдым...
Dialogue: 0,0:13:14.69,0:13:18.88,Main,,0,0,0,,Сіз маған мен болған дұрыс сияқты сезіндірдіңіз.
Dialogue: 0,00:13:15.71,00:13:20.00,JPN TOP,,0,0,0,,Мен жай ғана мен болғаным дұрыс деп ойладым.
Dialogue: 0,0:13:20.87,0:13:23.17,Main,,0,0,0,,Кешіріңіз, Фуши.
Dialogue: 0,00:13:21.92,00:13:26.30,JPN TOP,,0,0,0,,Кешіріңіз, Фуши, мен дәрменсіз ағамын...
Dialogue: 0,0:13:23.57,0:13:25.26,Main,,0,0,0,,Кешіріңіз, мен қажетсіз ағамын.
Dialogue: 0,00:13:35.31,00:13:36.19,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:13:39.96,0:13:41.69,Main,,0,0,0,,Сол жарық...
Dialogue: 0,00:13:41.11,00:13:42.82,JPN TOP,,0,0,0,,Бұл жарық ше?
Dialogue: 0,00:14:03.21,00:14:04.17,JPN TOP,,0,0,0,,О
Dialogue: 0,0:14:21.87,0:14:23.13,Main,,0,0,0,,Тас?
Dialogue: 0,00:14:22.98,00:14:24.02,JPN TOP,,0,0,0,,Тас…
Dialogue: 0,0:14:24.40,0:14:27.66,Main,,0,0,0,,Менің жақсылығым, Фуши.
Dialogue: 0,00:14:25.44,00:14:30.53,JPN TOP,,0,0,0,,Жарайды, Фуши, сен бақыттысың.
Dialogue: 0,0:14:27.66,0:14:29.63,Main,,0,0,0,,Сіз бақытты жансыз.
Dialogue: 0,0:14:30.48,0:14:37.35,Main,,0,0,0,,Бұл болмыс - сынғыш, бірақ әлсіз емес - сізді одан да күшті етеді.
Dialogue: 0,00:14:31.53,00:14:34.99,JPN TOP,,0,0,0,,Нәзік, бірақ әлсіз емес болмыс
Dialogue: 0,00:14:35.12,00:14:38.41,JPN TOP,,0,0,0,,Бұл сізді одан да күшті етеді.
Dialogue: 0,0:14:39.18,0:14:40.25,Main,,0,0,0,,Уақыт бойынша.
Dialogue: 0,00:14:40.21,00:14:41.33,JPN TOP,,0,0,0,,Жақында...
Dialogue: 0,00:14:49.68,00:14:50.97,JPN TOP,,0,0,0,,Уау
Dialogue: 0,00:14:52.22,00:14:53.43,JPN TOP,,0,0,0,,Уф... уф
Dialogue: 0,0:14:55.46,0:14:56.62,Main,,0,0,0,,Фуши!
Dialogue: 0,00:14:56.56,00:14:57.77,JPN TOP,,0,0,0,,Фуши!
Dialogue: 0,0:14:58.19,0:15:00.33,Main,,0,0,0,,Жауды құлаттым.
Dialogue: 0,00:14:59.31,00:15:02.06,JPN TOP,,0,0,0,,Жауды мен жеңдім.
Dialogue: 0,0:15:00.33,0:15:01.18,Main,,0,0,0,,Мен жасадым.
Dialogue: 0,0:15:02.61,0:15:03.83,Main,,0,0,0,,Мен бір қолымда оқ жалғанған винтовка ұстап тұрмын
Dialogue: 0,00:15:03.73,00:15:04.94,JPN TOP,,0,0,0,,Шынымен бе?
Dialogue: 0,0:15:04.28,0:15:05.19,Main,,0,0,0,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 0,00:15:05.07,00:15:06.32,JPN TOP,,0,0,0,,Иә!
Dialogue: 0,00:15:09.07,00:15:10.28,JPN TOP,,0,0,0,,Хехе
Dialogue: 0,0:15:12.50,0:15:15.17,Main,,0,0,0,,Бұл ауырады, есек!
Dialogue: 0,00:15:13.07,00:15:16.29,JPN TOP,,0,0,0,,Ауырды, бейбақ!
Dialogue: 0,00:15:18.25,00:15:20.21,JPN TOP,,0,0,0,,(жақсы күлкі)
Dialogue: 0,0:15:21.97,0:15:24.51,Main,,0,0,0,,Рахмет, Гугу.
Dialogue: 0,00:15:23.04,00:15:25.59,JPN TOP,,0,0,0,,Рахмет, Гу Гу
Dialogue: 0,0:15:35.46,0:15:36.92,Main,,0,0,0,,Олар қайтып келді!
Dialogue: 0,00:15:36.51,00:15:37.81,JPN TOP,,0,0,0,,Мен қайтып келдім!
Dialogue: 0,0:15:37.25,0:15:39.91,Main,,0,0,0,,Эй, не болды?
Dialogue: 0,00:15:38.35,00:15:40.81,JPN TOP,,0,0,0,,Эй, не болды?
Dialogue: 0,0:15:40.96,0:15:42.56,Main,,0,0,0,,Юкине, сонда ісіңді бітірген соң дүкенге бар.
Dialogue: 0,00:15:42.02,00:15:43.65,JPN TOP,,0,0,0,,Ештеңе!
Dialogue: 0,00:15:44.44,00:15:47.94,JPN TOP,,0,0,0,,О, Гу Гу күткендей
Dialogue: 0,0:15:45.42,0:15:47.65,Main,,0,0,0,,Бұл менің Гугуым!
Dialogue: 0,00:15:48.07,00:15:51.32,JPN TOP,,0,0,0,,Хэхе! Мен оны жеймін
Dialogue: 0,0:15:48.09,0:15:50.44,Main,,0,0,0,,Мен бұны бұзамын!
Dialogue: 0,0:15:51.44,0:15:52.51,Main,,0,0,0,,Иә!
Dialogue: 0,00:15:52.45,00:15:56.45,JPN TOP,,0,0,0,,Дәмді! Өйткені, Гу Гудың тамағы ең жақсы!
Dialogue: 0,0:15:52.51,0:15:55.54,Main,,0,0,0,,Гугу әрқашан ең жақсы тағам жасайды!
Dialogue: 0,0:15:55.79,0:15:58.40,Main,,0,0,0,,Қайтып келгеніңізге рахмет.
Dialogue: 0,00:15:56.58,00:15:59.20,JPN TOP,,0,0,0,,Қайтып келгеніңізге рахмет!
Dialogue: 0,0:15:58.40,0:16:00.92,Main,,0,0,0,,Сен мені кешірдің, солай ма?
Dialogue: 0,00:15:59.33,00:16:01.83,JPN TOP,,0,0,0,,Сен мені кешірдің, солай емес пе?
Dialogue: 0,0:16:01.21,0:16:02.73,Main,,0,0,0,,Жоқ, менде жоқ.
Dialogue: 0,00:16:01.96,00:16:03.62,JPN TOP,,0,0,0,,Жоқ, мен рұқсат бермеймін.
Dialogue: 0,00:16:03.75,00:16:05.63,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:16:04.72,0:16:07.16,Main,,0,0,0,,Мен сені енді ішімдік деп атамаймын.
Dialogue: 0,00:16:05.75,00:16:08.00,JPN TOP,,0,0,0,,Ендеше, бұдан былай мен саке қарт болмаймын.
Dialogue: 0,0:16:07.16,0:16:09.60,Main,,0,0,0,,Мен сені Бооз Шитхед деп атаймын.
Dialogue: 0,00:16:08.13,00:16:10.51,JPN TOP,,0,0,0,,Мен сені ішімдік ішетін қария деймін
Dialogue: 0,0:16:09.86,0:16:11.31,Main,,0,0,0,,Ау...
Dialogue: 0,00:16:10.63,00:16:12.51,JPN TOP,,0,0,0,,Гарн…
Dialogue: 0,0:16:11.81,0:16:15.01,Main,,0,0,0,,Бірақ сен менің өмірімді сақтап қалдың.
Dialogue: 0,00:16:12.63,00:16:15.84,JPN TOP,,0,0,0,,Бірақ бұған дейін бұл құтқарушы.
Dialogue: 0,0:16:15.01,0:16:18.12,Main,,0,0,0,,Ендеше мен «боқ» бөлімін тастап, сізді «Боз адам» деп атаймын.
Dialogue: 0,00:16:15.97,00:16:19.01,JPN TOP,,0,0,0,,Сондықтан мен «блять» сөзін шығарып, оны Сакеджижи деп атадым.
Dialogue: 0,0:16:18.36,0:16:20.92,Main,,0,0,0,,Г-Гугу...
Dialogue: 0,00:16:19.14,00:16:21.81,JPN TOP,,0,0,0,,Гу… Гу Гу Гу
Dialogue: 0,0:16:21.18,0:16:25.34,Main,,0,0,0,,Сәлем! Үлкендермен олай сөйлеспе.
Dialogue: 0,00:16:21.93,00:16:26.23,JPN TOP,,0,0,0,,Міне! Қарттарды «қарт» демеңіз.
Dialogue: 0,0:16:25.65,0:16:27.55,Main,,0,0,0,,Ау
Dialogue: 0,00:16:26.36,00:16:28.82,JPN TOP,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:16:27.84,0:16:29.19,Main,,0,0,0,,Білесің бе, қымбаттым...
Dialogue: 0,00:16:28.94,00:16:32.15,JPN TOP,,0,0,0,,Ей, сен, бұл бала жақсы жүр.
Dialogue: 0,0:16:29.19,0:16:31.27,Main,,0,0,0,,Бұл бала өте жақсы.
Dialogue: 0,0:16:31.53,0:16:33.84,Main,,0,0,0,,Ол біздің аспазымыздан жақсы.
Dialogue: 0,00:16:32.28,00:16:34.61,JPN TOP,,0,0,0,,Менің аспазымнан жақсы
Dialogue: 0,00:16:34.74,00:16:35.61,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:16:36.58,0:16:38.27,Main,,0,0,0,,О, менің.
Dialogue: 0,00:16:37.62,00:16:39.16,JPN TOP,,0,0,0,,Атымды айтып қойсам зияны жоқ шығар».
Dialogue: 0,0:16:38.85,0:16:40.22,Main,,0,0,0,,Сәлем, Гугу?
Dialogue: 0,00:16:39.83,00:16:41.12,JPN TOP,,0,0,0,,Эй Гу Гу
Dialogue: 0,00:16:41.25,00:16:42.54,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:16:41.60,0:16:43.27,Main,,0,0,0,,Фуши-сан қайда кетті?
Dialogue: 0,00:16:42.66,00:16:44.29,JPN TOP,,0,0,0,,Фуши мырзаға не болды?
Dialogue: 0,0:16:43.27,0:16:46.07,Main,,0,0,0,,О, мен одан су алуын өтіндім.
Dialogue: 0,00:16:44.42,00:16:46.92,JPN TOP,,0,0,0,,А... Мен су сұрап тұрмын.
Dialogue: 0,0:16:46.07,0:16:47.48,Main,,0,0,0,,Ол тезірек оралуы керек.
Dialogue: 0,00:16:47.04,00:16:48.38,JPN TOP,,0,0,0,,Жақында келеді
Dialogue: 0,0:16:54.67,0:16:58.49,Main,,0,0,0,,Фуши, бұл жерден кет.
Dialogue: 0,00:16:55.76,00:16:59.39,JPN TOP,,0,0,0,,Фуши, бұл жерден кет.
Dialogue: 0,0:17:00.49,0:17:01.59,Main,,0,0,0,,Тағы бір қосымша сабақ па, қазірден-ақ?
Dialogue: 0,00:17:01.56,00:17:02.68,JPN TOP,,0,0,0,,Неліктен?
Dialogue: 0,0:17:02.90,0:17:06.64,Main,,0,0,0,,Күшті болудың жолы бар.
Dialogue: 0,00:17:03.98,00:17:07.77,JPN TOP,,0,0,0,,Сізде күштірек болу жолы бар.
Dialogue: 0,0:17:07.47,0:17:11.07,Main,,0,0,0,,Бір орында тұрмау.
Dialogue: 0,00:17:08.56,00:17:12.19,JPN TOP,,0,0,0,,Бір орында тұрмау туралы.
Dialogue: 0,0:17:11.69,0:17:13.71,Main,,0,0,0,,Түсінбедім.
Dialogue: 0,00:17:12.74,00:17:14.86,JPN TOP,,0,0,0,,Мен білмеймін
Dialogue: 0,0:17:15.55,0:17:20.80,Main,,0,0,0,,Ноккерлер, мен оларды атауға шешім қабылдадым ...
Dialogue: 0,00:17:16.66,00:17:17.91,JPN TOP,,0,0,0,,«Тоққылау»
Dialogue: 0,00:17:18.45,00:17:21.74,JPN TOP,,0,0,0,,Мен оларды осылай атаймын деп шештім.
Dialogue: 0,0:17:21.39,0:17:25.88,Main,,0,0,0,,Олар осы дүниенің жойылуын жоспарлап отыр.
Dialogue: 0,00:17:22.49,00:17:27.08,JPN TOP,,0,0,0,,Нокер – бұл дүниенің жойылуын жоспарлайтын тіршілік иесі.
Dialogue: 0,0:17:26.19,0:17:28.51,Main,,0,0,0,,Олар үйренеді.
Dialogue: 0,00:17:27.21,00:17:29.42,JPN TOP,,0,0,0,,Олар үйренеді
Dialogue: 0,0:17:28.51,0:17:33.12,Main,,0,0,0,,Олар бұл жолы жеңілген болуы мүмкін, бірақ келесі жолы жеңіске жету үшін қадамдар жасайды.
Dialogue: 0,00:17:29.54,00:17:34.17,JPN TOP,,0,0,0,,Осы жолы жеңілсем, келесі жолы жеңу үшін бірдеңе істеймін.
Dialogue: 0,0:17:34.11,0:17:37.27,Main,,0,0,0,,Сіздің қазіргі күйіңізде сіз міндетті түрде ұтыласыз.
Dialogue: 0,00:17:35.17,00:17:38.43,JPN TOP,,0,0,0,,Қазіргідей сіз жеңе алмайсыз.
Dialogue: 0,0:17:38.03,0:17:44.14,Main,,0,0,0,,Ішіңді қайтадан алады, мүк пен тасқа қайтасың.
Dialogue: 0,00:17:39.14,00:17:42.31,JPN TOP,,0,0,0,,Мазмұны осы жолы ұрланған.
Dialogue: 0,00:17:42.43,00:17:45.18,JPN TOP,,0,0,0,,Мүк пен тастар дегенге қайта келу
Dialogue: 0,0:17:44.66,0:17:46.01,Main,,0,0,0,,Сіз түсінесіз, солай емес пе?
Dialogue: 0,00:17:45.77,00:17:47.02,JPN TOP,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,0:17:46.62,0:17:49.66,Main,,0,0,0,,Гугу жауды жеңеді.
Dialogue: 0,00:17:47.73,00:17:50.52,JPN TOP,,0,0,0,,Гу Гу сені жеңеді.
Dialogue: 0,0:17:49.66,0:17:51.42,Main,,0,0,0,,Гугу күшті.
Dialogue: 0,00:17:50.65,00:17:52.52,JPN TOP,,0,0,0,,Гоу күшті
Dialogue: 0,0:17:54.54,0:17:56.91,Main,,0,0,0,,Маған Гугу керек.
Dialogue: 0,00:17:55.61,00:17:59.24,JPN TOP,,0,0,0,,Мен оны жеңе алмаймын!
Dialogue: 0,0:17:56.91,0:17:58.15,Main,,0,0,0,,Мен тұрамын.
Dialogue: 0,0:18:01.12,0:18:03.20,Main,,0,0,0,,Бұл да нұсқа.
Dialogue: 0,00:18:02.16,00:18:04.24,JPN TOP,,0,0,0,,Бұл да жақсы болар еді.
Dialogue: 0,0:18:04.14,0:18:07.93,Main,,0,0,0,,Соңын көргің келсе, мен сені тоқтатпаймын.
Dialogue: 0,00:18:05.20,00:18:08.71,JPN TOP,,0,0,0,,Соңын көргің келсе, мен сені тоқтатпаймын
Dialogue: 0,0:18:07.93,0:18:08.92,Main,,0,0,0,,Фуши.
Dialogue: 0,00:18:08.83,00:18:09.83,JPN TOP,,0,0,0,,Фуши?
Dialogue: 0,00:18:09.96,00:18:10.75,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:18:13.99,0:18:17.21,Main,,0,0,0,,Не болып жатыр? Осы уақыт бойы сіз өзіңізбен сөйлесіп жүрдіңіз.
Dialogue: 0,00:18:15.09,00:18:18.09,JPN TOP,,0,0,0,,Не, сен енді ғана өзіңмен сөйлесіп тұрсың ба?
Dialogue: 0,0:18:17.21,0:18:18.96,Main,,0,0,0,,Бұл сізге ұқсамайды.
Dialogue: 0,00:18:18.22,00:18:20.18,JPN TOP,,0,0,0,,Мен сеннен дәл осындайды күттім, аға
Dialogue: 0,0:18:20.75,0:18:22.21,Main,,0,0,0,,Сіз көрмейсіз бе?
Dialogue: 0,00:18:21.85,00:18:23.10,JPN TOP,,0,0,0,,Сіз оны көрмейсіз бе?
Dialogue: 0,0:18:22.88,0:18:24.19,Main,,0,0,0,,Нені көрдіңіз?
Dialogue: 0,00:18:23.97,00:18:25.10,JPN TOP,,0,0,0,,Не?
Dialogue: 0,0:18:25.43,0:18:27.70,Main,,0,0,0,,Мұнда қазірдің өзінде кіріңіз.
Dialogue: 0,00:18:26.48,00:18:28.60,JPN TOP,,0,0,0,,Әй, тез кел.
Dialogue: 0,0:18:27.98,0:18:30.02,Main,,0,0,0,,Барлығы тамақтанып жатыр.
Dialogue: 0,00:18:28.73,00:18:31.10,JPN TOP,,0,0,0,,Барлығы тамақтанып үлгерді.
Dialogue: 0,00:18:47.75,00:18:50.00,JPN TOP,,0,0,0,,Не, үйге барасың ба?
Dialogue: 0,0:18:47.82,0:18:49.09,Main,,0,0,0,,Үйге барасың ба?
Dialogue: 0,0:18:49.41,0:18:50.38,Main,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,00:18:50.12,00:18:53.17,JPN TOP,,0,0,0,,Иә, көптен бері көмегіңіз үшін рахмет.
Dialogue: 0,0:18:50.38,0:18:52.37,Main,,0,0,0,,Мен сіздің барлық жасағаныңызды бағалаймын.
Dialogue: 0,0:18:52.37,0:18:54.47,Main,,0,0,0,,A- Дегенмен сенімдісіз бе?
Dialogue: 0,00:18:53.29,00:18:55.34,JPN TOP,,0,0,0,,Бірақ... бұл дұрыс па?
Dialogue: 0,0:18:54.47,0:18:57.16,Main,,0,0,0,,Айтайын дегенім... ата-анаңмен және барлығымен...
Dialogue: 0,00:18:55.46,00:18:58.26,JPN TOP,,0,0,0,,Мм... ата-анаң туралы.
Dialogue: 0,0:18:58.05,0:19:03.00,Main,,0,0,0,,Мен олармен бірге үйге бармайынша, олар бұл жерден төсбелгі салмайды.
Dialogue: 0,00:18:59.13,00:19:03.89,JPN TOP,,0,0,0,,Өйткені мен үйге жеткенше бұл жерден рычагты жылжытпаймын.
Dialogue: 0,0:19:03.60,0:19:08.14,Main,,0,0,0,,Оның үстіне маған енді бәрібір
Dialogue: 0,00:19:04.68,00:19:06.22,JPN TOP,,0,0,0,,Және...
Dialogue: 0,00:19:06.85,00:19:10.81,JPN TOP,,0,0,0,,Мен өз жағдайыма енді мән бермеймін.
Dialogue: 0,0:19:08.14,0:19:09.91,Main,,0,0,0,,менің жеке жағдайым туралы.
Dialogue: 0,0:19:12.29,0:19:16.67,Main,,0,0,0,,Екеуміздің ортақ нәрсеміз бар сияқты.
Dialogue: 0,00:19:13.31,00:19:17.73,JPN TOP,,0,0,0,,Бізде бір ортақ нәрсе бар сияқты.
Dialogue: 0,0:19:17.81,0:19:22.24,Main,,0,0,0,,Бізді тірі қалдыратын адамдар міндетті түрде жақсы адамдар емес.
Dialogue: 0,00:19:18.82,00:19:23.07,JPN TOP,,0,0,0,,Сізді тірі қалдыратын адам міндетті түрде жақсы адам емес.
Dialogue: 0,0:19:22.58,0:19:26.38,Main,,0,0,0,,Бірақ біз шыдай алмайтындай әлсіз емеспіз.
Dialogue: 0,00:19:23.62,00:19:27.49,JPN TOP,,0,0,0,,Бірақ... Мен шыдай алмайтындай әлсіз емеспін.
Dialogue: 0,0:19:37.31,0:19:42.48,Main,,0,0,0,,Қайта кездескенше, қарт, кемпір, Фуши, дүкенші мырза.
Dialogue: 0,00:19:38.38,00:19:42.09,JPN TOP,,0,0,0,,Көріскенше, ата, әже, Фуши-сан.
Dialogue: 0,00:19:42.22,00:19:43.39,JPN TOP,,0,0,0,,Клерк!
Dialogue: 0,00:19:43.51,00:19:45.89,JPN TOP,,0,0,0,,Иә? Клерк?
Dialogue: 0,0:19:43.60,0:19:44.99,Main,,0,0,0,,Дүкенші?
Dialogue: 0,0:19:46.39,0:19:48.72,Main,,0,0,0,,Мен әзілдеп тұрмын, Гугу.
Dialogue: 0,00:19:46.72,00:19:49.89,JPN TOP,,0,0,0,,Хехе, әзілдеп жатырмын, гу-у
Dialogue: 0,00:19:53.90,00:19:55.36,JPN TOP,,0,0,0,,Хехехе
Dialogue: 0,0:19:56.97,0:19:59.25,Main,,0,0,0,,Дүкен ашу уақыты келді.
Dialogue: 0,00:19:58.03,00:20:00.11,JPN TOP,,0,0,0,,Жүр, дүкен ашуға дайындалайық.
Dialogue: 0,0:19:59.25,0:20:01.82,Main,,0,0,0,,Мен қайтадан ұйықтаймын.
Dialogue: 0,00:20:00.24,00:20:02.74,JPN TOP,,0,0,0,,Мен бүгін ұйықтаймын
Dialogue: 0,0:20:01.82,0:20:03.53,Main,,0,0,0,,Дұрыс, Гугу...
Dialogue: 0,00:20:02.86,00:20:04.45,JPN TOP,,0,0,0,,Дұрыс Гу Гу
Dialogue: 0,0:20:03.53,0:20:05.13,Main,,0,0,0,,Иә? Бұл не?
Dialogue: 0,00:20:04.57,00:20:06.03,JPN TOP,,0,0,0,,Иә?Не?
Dialogue: 0,0:20:05.33,0:20:07.99,Main,,0,0,0,,Маған тамақ пісіруді үйретші.
Dialogue: 0,00:20:06.16,00:20:08.79,JPN TOP,,0,0,0,,Маған қалай айту керектігін айтыңыз
Dialogue: 0,0:20:08.42,0:20:11.78,Main,,0,0,0,,Не болды? Енді маған қарап тұрсың ба?
Dialogue: 0,00:20:08.91,00:20:12.87,JPN TOP,,0,0,0,,Ой, кенет не болды? Маған тәнті болдыңыз ба?
Dialogue: 0,0:20:19.48,0:20:20.65,Main,,0,0,0,,Қош келдіңіз.
Dialogue: 0,00:20:20.55,00:20:21.55,JPN TOP,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:20:21.00,0:20:22.58,Main,,0,0,0,,Маған соңғы рет алғанымды беріңіз.
Dialogue: 0,00:20:21.67,00:20:23.68,JPN TOP,,0,0,0,,Бұрынғыдай
Dialogue: 0,0:20:23.17,0:20:25.15,Main,,0,0,0,,Мен оны бір жұтып көрсем болады ма?
Dialogue: 0,00:20:24.22,00:20:26.05,JPN TOP,,0,0,0,,Мен оның дәмін татсам болады ма?
Dialogue: 0,0:20:25.58,0:20:26.59,Main,,0,0,0,,Әрине.
Dialogue: 0,00:20:26.64,00:20:27.72,JPN TOP,,0,0,0,,Әрине
Dialogue: 0,0:20:28.40,0:20:30.99,Main,,0,0,0,,Бұл жерде ішімдік жақсы болып жатыр, иә?
Dialogue: 0,00:20:29.47,00:20:31.89,JPN TOP,,0,0,0,,Мұндағы сакенің дәмі жақсырақ, солай емес пе?
Dialogue: 0,0:20:30.99,0:20:32.17,Main,,0,0,0,,Кел де жуынып ал.
Dialogue: 0,00:20:32.02,00:20:33.06,JPN TOP,,0,0,0,,Рахмет
Dialogue: 0,0:20:33.37,0:20:35.66,Main,,0,0,0,,Сіз мұнда біраз уақыт болдыңыз, солай емес пе?
Dialogue: 0,00:20:34.48,00:20:36.56,JPN TOP,,0,0,0,,Сіз де көптен бері келдіңіз ғой, солай емес пе?
Dialogue: 0,0:20:36.49,0:20:38.36,Main,,0,0,0,,Неше жыл болды?
Dialogue: 0,00:20:37.48,00:20:42.03,JPN TOP,,0,0,0,,Неше жыл болды? мм... 4 жыл?
Dialogue: 0,0:20:39.87,0:20:41.19,Main,,0,0,0,,Төрт жыл болды ма?
Dialogue: 0,0:20:41.53,0:20:42.29,Main,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,00:20:42.57,00:20:43.53,JPN TOP,,0,0,0,,Иә
Dialogue: 0,0:20:42.63,0:20:45.43,Main,,0,0,0,,Гугу, маған қол ұшын берші.
Dialogue: 0,00:20:43.65,00:20:46.32,JPN TOP,,0,0,0,,Гу гу, маған көмектесіңізші.
Dialogue: 0,0:20:45.57,0:20:48.17,Main,,0,0,0,,Неліктен оны осында жоғарылаттың?
Dialogue: 0,00:20:46.45,00:20:49.08,JPN TOP,,0,0,0,,Өйткені ол сондай биік жерде орналасқан
Dialogue: 0,0:20:48.67,0:20:50.82,Main,,0,0,0,,Неліктен көп нәрсені біріктірдің?
Dialogue: 0,00:20:49.70,00:20:51.70,JPN TOP,,0,0,0,,Өйткені мен көп сала аламын
Dialogue: 0,0:20:51.14,0:20:54.40,Main,,0,0,0,,Сіз өте күшті болдыңыз, иә?
Dialogue: 0,00:20:52.25,00:20:55.25,JPN TOP,,0,0,0,,Сіз күшті болдыңыз.
Dialogue: 0,0:20:54.40,0:20:57.56,Main,,0,0,0,,Сен мұнда келгенде өте кішкентай едің.
Dialogue: 0,00:20:55.37,00:20:58.46,JPN TOP,,0,0,0,,Ол мұнда келгенде өте кішкентай еді.
Dialogue: 0,0:20:58.12,0:21:00.17,Italics,,0,0,0,,Мен неге менмін?
Dialogue: 0,00:20:59.17,00:21:01.30,JPN TOP,,0,0,0,,Неліктен мен кіммін?
Dialogue: 0,0:21:01.48,0:21:04.39,Italics,,0,0,0,,Менің ойымша, бұл бұрын менде болатын сұрақ.
Dialogue: 0,00:21:02.59,00:21:05.47,JPN TOP,,0,0,0,,Сіз бұрын не ойладыңыз?
Dialogue: 0,0:21:07.14,0:21:11.12,Italics,,0,0,0,,Мен ол кезде өзімді жек көретінмін.
Dialogue: 0,00:21:08.22,00:21:12.18,JPN TOP,,0,0,0,,Мен ол кезде өзімді жек көретінмін.
Dialogue: 0,0:21:11.90,0:21:16.08,Italics,,0,0,0,,Ал қазір, Гугу, төрт жылдан кейін өзіңді қалай сезінесің?
Dialogue: 0,00:21:12.72,00:21:17.15,JPN TOP,,0,0,0,,Енді ше, Гу Гу? Төрт жылдан кейін сіз...
Dialogue: 0,0:21:22.27,0:21:24.21,Main,,0,0,0,,Сәлеметсіз бе.
Dialogue: 0,00:21:23.36,00:21:25.11,JPN TOP,,0,0,0,,Қиындық тудырғаным үшін кешір.
Dialogue: 0,0:21:24.21,0:21:27.96,Main,,0,0,0,,Н-Сәлем, Реан. Тағы да үйден қашып жүрсіз бе?
Dialogue: 0,00:21:25.24,00:21:28.87,JPN TOP,,0,0,0,,О... Сәлем Лианна, сен тағы да үйден қашып барасың ба?
Dialogue: 0,0:21:27.96,0:21:30.35,Main,,0,0,0,,Иә, осы айда екінші рет.
Dialogue: 0,00:21:28.99,00:21:31.28,JPN TOP,,0,0,0,,Иә, осы айда екінші рет.
Dialogue: 0,0:21:30.35,0:21:32.14,Main,,0,0,0,,Бұл жолы қандай ақтауға болады?
Dialogue: 0,00:21:31.41,00:21:33.41,JPN TOP,,0,0,0,,Бұл жолы қандай сылтау айтасыз?
Dialogue: 0,0:21:32.51,0:21:35.56,Main,,0,0,0,,Мен Фуси-санның қолөнерге деген қызығушылығын естідім.
Dialogue: 0,00:21:33.54,00:21:36.50,JPN TOP,,0,0,0,,Фуши мырза, сізді тігіншілікке қызықты деп естідім.
Dialogue: 0,0:21:35.56,0:21:37.99,Main,,0,0,0,,Сонымен мен үйден бір топ заттар әкелдім.
Dialogue: 0,00:21:36.62,00:21:38.88,JPN TOP,,0,0,0,,Сонымен мен үйден біраз заттар әкелдім.
Dialogue: 0,0:21:38.36,0:21:40.78,Main,,0,0,0,,Фуши қазір түскі ас әзірлеп жатыр.
Dialogue: 0,00:21:39.46,00:21:41.67,JPN TOP,,0,0,0,,Егер бұл Фуши болса, мен саған түскі ас әзірлеймін.
Dialogue: 0,0:21:40.78,0:21:42.22,Main,,0,0,0,,Жоғарыда, сонда?
Dialogue: 0,00:21:41.80,00:21:43.34,JPN TOP,,0,0,0,,Содан кейін екінші қабатқа өтіңіз.
Dialogue: 0,0:21:43.18,0:21:45.19,Main,,0,0,0,,Бұл дәмді көрінеді.
Dialogue: 0,00:21:44.26,00:21:46.38,JPN TOP,,0,0,0,,Дәмді көрінеді!
Dialogue: 0,0:21:45.88,0:21:48.78,Main,,0,0,0,,Фуши-санның тамақ әзірлеуі өте жақсы.
Dialogue: 0,00:21:46.97,00:21:49.59,JPN TOP,,0,0,0,,Сіз шынымен де жақсардыңыз, Фуси мырза.
Dialogue: 0,0:21:48.78,0:21:50.58,Main,,0,0,0,,Сіз қалып, тамақ ішуіңіз керек.
Dialogue: 0,00:21:49.72,00:21:51.64,JPN TOP,,0,0,0,,Қаласаңыз жеп қойыңыз.
Dialogue: 0,0:21:52.39,0:21:54.75,Main,,0,0,0,,Фуши мұнда емес пе?
Dialogue: 0,00:21:53.02,00:21:55.64,JPN TOP,,0,0,0,,Фуши жоқ па?
Dialogue: 0,0:21:54.98,0:21:57.41,Main,,0,0,0,,Фуши жуынуға кетті.
Dialogue: 0,00:21:55.77,00:21:58.31,JPN TOP,,0,0,0,,Егер бұл Фуши болса, мен шомыламын.
Dialogue: 0,0:21:57.93,0:22:01.57,Main,,0,0,0,,Қане, кемпір! Сіз өз бетіңізше тамақтануды бастай алмайсыз!
Dialogue: 0,00:21:58.98,00:22:02.44,JPN TOP,,0,0,0,,Баа-сан, ол қайтадан өзі жей бастады!
Dialogue: 0,0:22:01.57,0:22:04.72,Main,,0,0,0,,Мен бәріміз үстел басында болғанша күте тұрыңдар деп айтамын!
Dialogue: 0,00:22:02.57,00:22:05.53,JPN TOP,,0,0,0,,Бәрі бірге болған соң осылай айта бермейсің бе?
Dialogue: 0,0:22:04.72,0:22:05.83,Main,,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,00:22:05.65,00:22:09.82,JPN TOP,,0,0,0,,Дауыс! Тағамды қайнатып алсаңыз, суып кетеді.
Dialogue: 0,0:22:05.83,0:22:08.92,Main,,0,0,0,,Мен күтсем, тамақ суып қалады!
Dialogue: 0,00:22:16.00,00:22:16.83,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,00:22:20.54,00:22:21.33,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:22:25.38,0:22:27.22,Main,,0,0,0,,Жүр, Фуши, тезірек.
Dialogue: 0,00:22:26.42,00:22:29.84,JPN TOP,,0,0,0,,Эй, Фуши, тезірек, бәріміз тамақтанамыз.
Dialogue: 0,0:22:27.22,0:22:28.95,Main,,0,0,0,,Бәріміз тамақтанып жатырмыз.
Dialogue: 0,0:22:29.61,0:22:31.57,Main,,0,0,0,,Иә, мен дәл сол жерде боламын.
Dialogue: 0,00:22:30.72,00:22:32.55,JPN TOP,,0,0,0,,Иә, мен қазір барамын.
Dialogue: 0,0:22:32.27,0:22:34.76,Main,,0,0,0,,Неге сонша үңіліп қарадың?
Dialogue: 0,00:22:33.35,00:22:35.68,JPN TOP,,0,0,0,,Неге соншалықты мұқият қарадың?
Dialogue: 0,0:22:34.76,0:22:36.88,Main,,0,0,0,,Барлық осы цитаттарды шығарыңыз.
Dialogue: 0,00:22:35.81,00:22:37.85,JPN TOP,,0,0,0,,Бөртпелерді жаншу үшін бар күшіңізді салыңыз.
Dialogue: 0,0:22:36.88,0:22:40.00,Main,,0,0,0,,Жоқ, иегімде шаш өсіп тұр.
Dialogue: 0,00:22:37.98,00:22:40.77,JPN TOP,,0,0,0,,Жоқ... иегімнен шаш өсіп жатыр...
Dialogue: 0,0:22:40.54,0:22:41.51,Main,,0,0,0,,Сақал?
Dialogue: 0,00:22:40.90,00:22:42.40,JPN TOP,,0,0,0,,О, сақал!
Dialogue: 0,0:22:41.86,0:22:43.73,Main,,0,0,0,,Мен өсіп келе жатқан сияқтымын.
Dialogue: 0,00:22:42.98,00:22:44.65,JPN TOP,,0,0,0,,Дәл ересек адам сияқты
Dialogue: 0,0:22:43.73,0:22:46.20,Main,,0,0,0,,Иә. Құттықтаймын, Фуши.
Dialogue: 0,00:22:44.78,00:22:47.40,JPN TOP,,0,0,0,,А, құттықтаймын Фуши
Dialogue: 0,00:23:01.04,00:23:06.00,JPN TOP,,0,0,0,,♪~
Dialogue: 0,00:24:25.92,00:24:30.88,JPN TOP,,0,0,0,,~♪
Dialogue: 0,0:24:29.99,0:24:51.01,sign_35245_236_Preview,,0,0,0,,Алдын ала қарау
Dialogue: 0,0:24:30.78,0:24:35.61,Narration,,0,0,0,,Ноккерлермен шайқастан бері төрт жыл өтті.
Dialogue: 0,00:24:31.92,00:24:36.51,JPN TOP,,0,0,0,,Нокермен болған қанды шайқастан бері төрт жыл өтті.
Dialogue: 0,0:24:36.25,0:24:40.73,Narration,,0,0,0,,Бірақ татулық ұзаққа бармайды.
Dialogue: 0,00:24:37.35,00:24:41.73,JPN TOP,,0,0,0,,Бірақ бейбіт өмір ұзаққа бармайды.
Dialogue: 0,0:24:41.21,0:24:46.22,Narration,,0,0,0,,Гугудың жоғалған ағасы Шин шығады,
Dialogue: 0,00:24:42.31,00:24:47.11,JPN TOP,,0,0,0,,Гу Гудың ажырасқан ағасы Шин келген кезде.
Dialogue: 0,0:24:46.63,0:24:53.65,Narration,,0,0,0,,Гугу мен Реанның тағдырларының дөңгелектерін қозғалысқа келтіру.
Dialogue: 0,00:24:47.65,00:24:51.90,JPN TOP,,0,0,0,,Гу Гу мен Линнің тағдыры да
Dialogue: 0,0:24:51.01,0:24:55.01,Episode_Title,,0,0,0,,Өткеннен сыйлық
Dialogue: 0,00:24:52.03,00:24:54.82,JPN TOP,,0,0,0,,Біртіндеп айналуды бастаңыз
Dialogue: 0,0:24:56.51,0:25:02.51,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory