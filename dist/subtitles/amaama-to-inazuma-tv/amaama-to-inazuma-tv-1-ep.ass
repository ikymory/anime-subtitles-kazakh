Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.08,0:00:07.09,Default,,0,0,0,,(оятар дыбысы)
Dialogue: 0,0:00:27.94,0:00:30.32,Default,,0,0,0,,Қайырлы таң, Отосан!
Dialogue: 0,0:00:37.03,0:00:39.53,Default,,0,0,0,,Ух мм...
Dialogue: 0,0:00:41.04,0:00:42.83,Default,,0,0,0,,Қайырлы таң... Ах!
Dialogue: 0,0:00:43.12,0:00:44.21,Default,,0,0,0,,А... тоқта
Dialogue: 0,0:00:44.71,0:00:45.54,Default,,0,0,0,,Әй?
Dialogue: 0,0:00:47.21,0:00:49.04,Default,,0,0,0,,Бұл келесі викторина.
Dialogue: 0,0:00:49.13,0:00:50.13,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:00:50.21,0:00:52.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:53.47,0:00:54.51,Default,,0,0,0,,Күріш…
Dialogue: 0,0:00:55.47,0:00:58.47,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:21.01,0:02:24.01,Default,,0,0,0,,~♪
Dialogue: 0,0:02:45.87,0:02:49.25,Default,,0,0,0,,Ото-сан, мен «Сиқырлы» фильмін көре аламын ба?
Dialogue: 0,0:02:49.54,0:02:52.42,Default,,0,0,0,,Иә, оны тамақ ішіп отырып көруге болады.
Dialogue: 0,0:02:52.75,0:02:53.59,Default,,0,0,0,,О
Dialogue: 0,0:02:57.88,0:02:59.01,Default,,0,0,0,,Хаха~
Dialogue: 0,0:02:59.97,0:03:02.05,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:03:07.93,0:03:09.14,Default,,0,0,0,,Осылайша...
Dialogue: 0,0:03:12.48,0:03:14.06,Default,,0,0,0,,Ах, шие қызанақтары...
Dialogue: 0,0:03:14.73,0:03:18.19,Default,,0,0,0,,А, таусылып қалдың ба? Хаа...
Dialogue: 0,0:03:23.45,0:03:25.33,Default,,0,0,0,,Үшеуі де дәл бірдей жағдайда қаза тапты.
Dialogue: 0,0:03:28.41,0:03:31.54,Default,,0,0,0,,Хм, дәл кешегідей.
Dialogue: 0,0:03:31.62,0:03:33.08,Default,,0,0,0,,Отосан (жәрмеңке) иә?
Dialogue: 0,0:03:35.21,0:03:36.04,Default,,0,0,0,,Не болды?
Dialogue: 0,0:03:36.13,0:03:38.05,Default,,0,0,0,,Қызғылт сиқырлы Ешкім жоқ.
Dialogue: 0,0:03:38.13,0:03:40.13,Default,,0,0,0,,О, сәл күте тұрыңыз.
Dialogue: 0,0:03:41.80,0:03:43.22,Default,,0,0,0,,Ах~
Dialogue: 0,0:03:43.30,0:03:44.43,Default,,0,0,0,,Увааах! Уф!
Dialogue: 0,0:03:44.51,0:03:46.93,Default,,0,0,0,,Бұл ел бір шымшым... шымшым?
Dialogue: 0,0:03:47.01,0:03:50.02,Default,,0,0,0,,Менде сары сиқырлы жейде болса ғой...
Dialogue: 0,0:03:51.14,0:03:53.56,Default,,0,0,0,,Сары Сиқырлы да күшті емес пе?
Dialogue: 0,0:03:54.19,0:03:56.23,Default,,0,0,0,,Жақсы Иә.
Dialogue: 0,0:03:56.31,0:03:59.61,Default,,0,0,0,,Жексенбі - үлкен кір жуу тойы. Жақсы!
Dialogue: 0,0:04:04.20,0:04:06.62,Default,,0,0,0,,Otosan финиш (жәрмеңке)
Dialogue: 0,0:04:08.20,0:04:10.62,Default,,0,0,0,,I~ Ui~ U~
Dialogue: 0,0:04:10.70,0:04:12.79,Default,,0,0,0,,Иә, фин сүйкімді
Dialogue: 0,0:04:13.08,0:04:15.83,Default,,0,0,0,,Отосанның мойыны шықпайды.
Dialogue: 0,0:04:16.75,0:04:19.30,Default,,0,0,0,,Түймелерін ашқаннан кейін оны қоймасаңыз
Dialogue: 0,0:04:19.50,0:04:20.46,Default,,0,0,0,,(Танжиро) Бұған дейін кірген жебелер мені бұрын-соңды болмағандай күшпен тартып жатыр.
Dialogue: 0,0:04:21.67,0:04:22.88,Default,,0,0,0,,Ааа~
Dialogue: 0,0:04:26.47,0:04:28.01,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:04:37.48,0:04:38.73,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:04:38.82,0:04:41.73,Default,,0,0,0,,Қайырлы таң (балабақша тәрбиеленушісі) Цумуги-чан Қайырлы таң~
Dialogue: 0,0:04:41.82,0:04:44.36,Default,,0,0,0,,Сағат 4-те күтуші алып кетуге келеді, сондықтан...
Dialogue: 0,0:04:44.45,0:04:45.66,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:04:46.32,0:04:48.78,Default,,0,0,0,,Бұл ұзартылған балабақша. Кәне.
Dialogue: 0,0:04:48.87,0:04:49.95,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:04:54.54,0:04:56.25,Default,,0,0,0,,Инузука мырза!
Dialogue: 0,0:04:56.42,0:04:58.54,Default,,0,0,0,,Ертеңгі сәлемдесу кеші ше?
Dialogue: 0,0:04:59.13,0:05:02.34,Default,,0,0,0,,Аа, кешіріңіз, мен күткендей болмадым.
Dialogue: 0,0:05:02.42,0:05:04.26,Default,,0,0,0,,Е-е, не деген ұят!
Dialogue: 0,0:05:04.34,0:05:07.47,Default,,0,0,0,,Көмек болмас, қызым, ол әлі жас.
Dialogue: 0,0:05:07.55,0:05:08.39,Default,,0,0,0,,Эй
Dialogue: 0,0:05:08.64,0:05:10.47,Default,,0,0,0,,Тіпті балаңызбен бірге!
Dialogue: 0,0:05:10.56,0:05:11.85,Default,,0,0,0,,Бұл паб, солай ма?
Dialogue: 0,0:05:12.02,0:05:13.85,Default,,0,0,0,,Инузука-сенсей! (Әділ) Иә?
Dialogue: 0,0:05:13.93,0:05:16.19,Default,,0,0,0,,Сіз дұрыс тамақтанып жатырсыз ба? (Әділеттілік) Ха...
Dialogue: 0,0:05:17.73,0:05:19.61,Default,,0,0,0,,Сіз тым арықсыз.
Dialogue: 0,0:05:19.69,0:05:22.98,Default,,0,0,0,,Саған қарасам, мен сені толтыру үшін бірдеңе беруім керек сияқты.
Dialogue: 0,0:05:23.07,0:05:25.11,Default,,0,0,0,,Мен парыз сезімін сезінемін.
Dialogue: 0,0:05:25.19,0:05:26.70,Default,,0,0,0,,Күлсін... (Құмағай) Момодани мырза
Dialogue: 0,0:05:26.78,0:05:28.32,Default,,0,0,0,,Бұл қосымша қамқорлық.
Dialogue: 0,0:05:28.49,0:05:31.70,Default,,0,0,0,,Уайымдама, мен басында көп жемеймін.
Dialogue: 0,0:05:31.87,0:05:33.04,Default,,0,0,0,,Ммм
Dialogue: 0,0:05:33.12,0:05:35.29,Default,,0,0,0,,Сіз тамақты өзіңіз жасайсыз ба?
Dialogue: 0,0:05:35.37,0:05:38.08,Default,,0,0,0,,Иә, мен оны бір рет көрдім...
Dialogue: 0,0:05:38.17,0:05:41.96,Default,,0,0,0,,Бұл менің қызымның жүзінен бұрын көрмеген өрнекті көрсетті.
Dialogue: 0,0:05:42.05,0:05:43.21,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,0:05:44.05,0:05:46.59,Default,,0,0,0,,Тіпті қазір бенто дүкені де бар...
Dialogue: 0,0:05:46.67,0:05:49.72,Default,,0,0,0,,Мен калорияларды санау сияқты нәрселерге өте мұқиятмын.
Dialogue: 0,0:05:49.89,0:05:51.35,Default,,0,0,0,,Иә, бұл пайдалы.
Dialogue: 0,0:05:51.55,0:05:53.60,Default,,0,0,0,,Қызым, саған не ұнайды?
Dialogue: 0,0:05:53.68,0:05:55.77,Default,,0,0,0,,Не? Бұл дұрыс...
Dialogue: 0,0:05:56.48,0:05:59.06,Default,,0,0,0,,Бұл гамбургер ме, әлде ет соусы ма?
Dialogue: 0,0:05:59.15,0:06:01.36,Default,,0,0,0,,Әй, бұл патша жолы емес пе?
Dialogue: 0,0:06:01.44,0:06:03.94,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:06:04.07,0:06:06.36,Default,,0,0,0,,Менде 1 кезең сыныбы бар.
Dialogue: 0,0:06:09.16,0:06:10.74,Default,,0,0,0,,Мен қайтадан тасталдым
Dialogue: 0,0:06:10.82,0:06:12.37,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:06:12.45,0:06:14.16,Default,,0,0,0,,Жарты жылдай ғана болды.
Dialogue: 0,0:06:14.74,0:06:16.20,Default,,0,0,0,,Әйелім қайтыс болды...
Dialogue: 0,0:06:25.21,0:06:26.34,Default,,0,0,0,,Мен үйдемін~
Dialogue: 0,0:06:26.46,0:06:27.97,Default,,0,0,0,,Қош келдіңіз, Отосан
Dialogue: 0,0:06:40.44,0:06:42.44,Default,,0,0,0,,Үшеуі де дәл бірдей жағдайда қаза тапты.
Dialogue: 0,0:06:44.02,0:06:46.23,Default,,0,0,0,,Осы демалыс күндері ауа райы жақсы болады.
Dialogue: 0,0:06:46.90,0:06:51.07,Default,,0,0,0,,Туристік бағыттар шие гүлін тамашалаған адамдарға толы сияқты.
Dialogue: 0,0:06:51.82,0:06:53.78,Default,,0,0,0,,Цумуги Мен бұл гүлді білемін.
Dialogue: 0,0:06:54.12,0:06:55.74,Default,,0,0,0,,Оны шие гүлі деп атайды.
Dialogue: 0,0:06:55.91,0:06:58.50,Default,,0,0,0,,О, сен мені жақсы білесің, иә!
Dialogue: 0,0:07:02.21,0:07:03.17,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:07:18.89,0:07:20.02,Default,,0,0,0,,Шие гүлін көру?
Dialogue: 0,0:07:20.85,0:07:22.85,Default,,0,0,0,,Жүр! (әділ) жарайды, жарайды
Dialogue: 0,0:07:23.06,0:07:27.57,Default,,0,0,0,,Содан кейін ұзын және қысқа инелерді жоғарғы жағына жабысқанша тазалаңыз.
Dialogue: 0,0:07:27.65,0:07:29.78,Default,,0,0,0,,Мен сізге көмектесе аламын ба? Кім алады?
Dialogue: 0,0:07:29.86,0:07:30.70,Default,,0,0,0,,Хахи!
Dialogue: 0,0:07:39.37,0:07:40.71,Default,,0,0,0,,Ахаха хехехе...
Dialogue: 0,0:07:49.42,0:07:52.59,Default,,0,0,0,,Ото-сан, кеудеңе сал.
Dialogue: 0,0:07:52.68,0:07:53.68,Default,,0,0,0,,Осы уақытқа дейін Миста өте еркін өмір сүрді
Dialogue: 0,0:07:56.64,0:07:59.43,Default,,0,0,0,,(көрермендердің күлкісін тамашалаған шие гүлі)
Dialogue: 0,0:08:00.35,0:08:02.27,Default,,0,0,0,,Ол өте көп.
Dialogue: 0,0:08:02.52,0:08:03.69,Default,,0,0,0,,Мұны тіпті ақымақ та түсінетіндей етіп түсіндірейін.
Dialogue: 0,0:08:07.15,0:08:08.98,Default,,0,0,0,,Амансың ба? Иә.
Dialogue: 0,0:08:09.23,0:08:13.61,Default,,0,0,0,,(көрермендердің күлкісін тамашалаған шие гүлі)
Dialogue: 0,0:08:14.20,0:08:16.07,Default,,0,0,0,,Адамдар көп.
Dialogue: 0,0:08:16.62,0:08:19.33,Default,,0,0,0,,Адамдарға емес, гүлдерге қара
Dialogue: 0,0:08:19.74,0:08:20.58,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:24.96,0:08:25.83,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:08:39.68,0:08:40.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:40.77,0:08:43.02,Default,,0,0,0,,Отосан, түс (жәрмеңке)? Иә
Dialogue: 0,0:08:46.10,0:08:48.06,Default,,0,0,0,,Амансың ба? (Иида Котори) Иә?
Dialogue: 0,0:08:49.77,0:08:50.82,Default,,0,0,0,,Цумуги!
Dialogue: 0,0:08:50.90,0:08:54.20,Default,,0,0,0,,Кешіріңіз, Цумуги, таң қалуыңыз керек.
Dialogue: 0,0:08:54.40,0:08:55.24,Default,,0,0,0,,(Танжиро) Бұған дейін кірген жебелер мені бұрын-соңды болмағандай күшпен тартып жатыр.
Dialogue: 0,0:08:55.66,0:08:56.66,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:08:56.74,0:08:57.57,Default,,0,0,0,,Иә? (Әділет) А...
Dialogue: 0,0:08:58.57,0:09:00.41,Default,,0,0,0,,Дәмді екен деп жылап отырмын
Dialogue: 0,0:09:00.62,0:09:01.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:01.58,0:09:04.79,Default,,0,0,0,,Ал... Мен жалғыз немесе жалғыз емеспін.
Dialogue: 0,0:09:05.83,0:09:08.25,Default,,0,0,0,,Бұл бір порция емес—
Dialogue: 0,0:09:08.33,0:09:11.09,Default,,0,0,0,,Ол бастапқыда екі адамға арналған.
Dialogue: 0,0:09:11.25,0:09:12.09,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:09:12.84,0:09:15.42,Default,,0,0,0,,Анам кенеттен уәдемнен бас тартты...
Dialogue: 0,0:09:15.51,0:09:16.88,Default,,0,0,0,,Соңғы минутта бас тарту!
Dialogue: 0,0:09:16.97,0:09:20.43,Default,,0,0,0,,Иә! Сол себепті мен басында ашуландым
Dialogue: 0,0:09:21.26,0:09:22.10,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:22.56,0:09:25.60,Default,,0,0,0,,Түскі ас қораптары жалғыз тамақтанса да дәмді болады.
Dialogue: 0,0:09:26.23,0:09:29.15,Default,,0,0,0,,Олар мұны қалай жасады деп ойлаймын...
Dialogue: 0,0:09:29.36,0:09:31.27,Default,,0,0,0,,Мен сіздің бос емес екеніңізді білемін.
Dialogue: 0,0:09:31.65,0:09:32.48,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:09:32.90,0:09:35.49,Default,,0,0,0,,Тамақ ішкен сайын есіме көбірек түседі.
Dialogue: 0,0:09:37.45,0:09:39.99,Default,,0,0,0,,Қандай да бір себептермен жылағым келеді
Dialogue: 0,0:09:41.28,0:09:42.54,Default,,0,0,0,,Моги мырза, жоспар бойынша, қабылдағышты Хигучиге қойыңыз.
Dialogue: 0,0:09:42.91,0:09:43.83,Default,,0,0,0,,Дәмді
Dialogue: 0,0:09:44.04,0:09:45.41,Default,,0,0,0,,Бұл шынымен дәмді ме?
Dialogue: 0,0:09:45.71,0:09:47.21,Default,,0,0,0,,Бұл өте дәмді
Dialogue: 0,0:09:47.37,0:09:49.42,Default,,0,0,0,,Бұл қаншалықты дәмді?
Dialogue: 0,0:09:49.63,0:09:51.63,Default,,0,0,0,,Бұл өте дәмді.
Dialogue: 0,0:09:51.71,0:09:52.75,Default,,0,0,0,,мен Токио вокзалына дейін шамамен бір жарым сағат Шинкансенге отырдым
Dialogue: 0,0:09:54.92,0:09:56.42,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:09:56.51,0:09:58.09,Default,,0,0,0,,Мен бәрін жеп қойдым... аа
Dialogue: 0,0:09:59.43,0:10:01.76,Default,,0,0,0,,Жалғыз ба? (Кішкентай құс) Мен жалғызбын.
Dialogue: 0,0:10:03.18,0:10:05.81,Default,,0,0,0,,А, м... сонда...
Dialogue: 0,0:10:05.89,0:10:08.39,Default,,0,0,0,,Бұл менің анамның дүкені.
Dialogue: 0,0:10:08.48,0:10:10.98,Default,,0,0,0,,Қаласаңыз, келесі жолы келіп тамақтаныңыз.
Dialogue: 0,0:10:12.15,0:10:13.69,Default,,0,0,0,,Отосан, маған көрсет! (Әділет) Ааа...
Dialogue: 0,0:10:14.90,0:10:17.53,Default,,0,0,0,,Ah «Күріш дүкені»
Dialogue: 0,0:10:30.29,0:10:32.42,Default,,0,0,0,,Азық-түлік сатып алып, үйге қайтайық?
Dialogue: 0,0:10:36.13,0:10:37.72,Default,,0,0,0,,Бүгін түскі ас қорабы?
Dialogue: 0,0:10:37.97,0:10:39.43,Default,,0,0,0,,Бізде отбасылық мейрамхана бар ма?
Dialogue: 0,0:10:40.34,0:10:41.34,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:42.22,0:10:43.47,Default,,0,0,0,,Уууу… Уф!
Dialogue: 0,0:10:51.90,0:10:53.90,Default,,0,0,0,,Иә? Тамақ үшін рахмет~
Dialogue: 0,0:10:55.48,0:10:57.32,Default,,0,0,0,,Түскі асыңыз дәмді болды ма?
Dialogue: 0,0:10:57.53,0:10:58.65,Default,,0,0,0,,Бұл әйелдің Қанды Пері Шығармасы ма?
Dialogue: 0,0:10:59.40,0:11:00.40,Default,,0,0,0,,Осыншама
Dialogue: 0,0:11:01.32,0:11:02.28,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:11:03.45,0:11:04.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:06.12,0:11:06.95,Default,,0,0,0,,О
Dialogue: 0,0:11:07.04,0:11:09.29,Default,,0,0,0,,Өзіңізді жақсы сезінесіз бе? (Әділ) Ахаха
Dialogue: 0,0:11:09.91,0:11:12.12,Default,,0,0,0,,Рахмет, мен өзімді жақсы сезінемін~
Dialogue: 0,0:11:12.21,0:11:14.50,Default,,0,0,0,,Саған орнына бірдеңе беремін~ Кяха~
Dialogue: 0,0:11:19.63,0:11:22.22,Default,,0,0,0,,Кездесу ұзаққа созылды. Иә.
Dialogue: 0,0:11:22.30,0:11:25.89,Default,,0,0,0,,Мен 6:30-да қайтамын, сондықтан есікті құлыптаңыз.
Dialogue: 0,0:11:25.97,0:11:26.89,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:29.10,0:11:31.89,Default,,0,0,0,,Мен үйдемін~ Кешіктіргенім үшін кешіріңіз.
Dialogue: 0,0:11:32.06,0:11:33.52,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:11:34.94,0:11:36.94,Default,,0,0,0,,Бұл тамаша қысымды пеш
Dialogue: 0,0:11:37.02,0:11:41.11,Default,,0,0,0,,Тез және оңай дайындалады және бұл етті қараңыз
Dialogue: 0,0:11:41.20,0:11:42.24,Default,,0,0,0,,Ет…
Dialogue: 0,0:11:42.49,0:11:44.99,Default,,0,0,0,,Қараңызшы, бұл өте жұмсақ
Dialogue: 0,0:11:45.07,0:11:46.49,Default,,0,0,0,,Жұмсақ~
Dialogue: 0,0:11:46.58,0:11:48.70,Default,,0,0,0,,Дәмді~ Аузыңда балқып тұр
Dialogue: 0,0:11:48.79,0:11:50.25,Default,,0,0,0,,Еріп кететін сияқты~
Dialogue: 0,0:11:51.50,0:11:52.42,Default,,0,0,0,,Цумуги…
Dialogue: 0,0:11:53.29,0:11:54.25,Default,,0,0,0,,Otosan!
Dialogue: 0,0:11:54.46,0:11:55.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:55.50,0:11:58.05,Default,,0,0,0,,Анаңызға осыны жасауын өтініп хат жазыңыз.
Dialogue: 0,0:11:58.46,0:11:59.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:59.59,0:12:03.80,Default,,0,0,0,,Анашым, қызық, сіз етті осындай дәмді жасай аласыз ба?
Dialogue: 0,0:12:08.60,0:12:11.02,Default,,0,0,0,,(телефонның қоңырау үні)
Dialogue: 0,0:12:13.35,0:12:14.56,Default,,0,0,0,,Иә «Мегуми»
Dialogue: 0,0:12:14.65,0:12:18.19,Default,,0,0,0,,Менің атым Инузука, мен сіздің визиткаңызды бір күні алдым.
Dialogue: 0,0:12:18.65,0:12:20.44,Default,,0,0,0,,Мен сізден бір нәрсе сұрайын деп едім...
Dialogue: 0,0:12:20.53,0:12:22.90,Default,,0,0,0,,Не? Қазір ме? Бүгін...
Dialogue: 0,0:12:22.99,0:12:24.86,Default,,0,0,0,,Өтінемін, қызым...
Dialogue: 0,0:12:25.53,0:12:28.24,Default,,0,0,0,,Мен қызыма дәмді тамақ бергім келді.
Dialogue: 0,0:12:30.24,0:12:31.37,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:12:32.46,0:12:33.50,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:12:34.00,0:12:35.17,Default,,0,0,0,,Осы жолы сен жұмсаған күшіңе сай нәтижеге қол жеткіздің—
Dialogue: 0,0:12:35.50,0:12:38.71,Default,,0,0,0,,Бүгін дәмді тағам жеп алайық.
Dialogue: 0,0:12:39.21,0:12:40.59,Default,,0,0,0,,Дәмді тағам?
Dialogue: 0,0:12:41.21,0:12:42.05,Default,,0,0,0,,Иә
Dialogue: 0,0:12:42.63,0:12:44.97,Default,,0,0,0,,А, Отосан, сағат неше болды?
Dialogue: 0,0:12:45.38,0:12:47.51,Default,,0,0,0,,Сиқырлы болса, жазылады.
Dialogue: 0,0:12:48.10,0:12:51.56,Default,,0,0,0,,♪ Magi Magic Magi Gal Magi Gal
Dialogue: 0,0:12:51.64,0:12:54.81,Default,,0,0,0,,♪ Міндетті түрде барамын, Мажигал, Мажигал...
Dialogue: 0,0:12:54.89,0:12:56.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:58.11,0:12:59.94,Default,,0,0,0,,Әкем де ән айтады~
Dialogue: 0,0:13:00.02,0:13:01.11,Default,,0,0,0,,Оу!
Dialogue: 0,0:13:01.19,0:13:04.95,Default,,0,0,0,,♪ Үміт нұрына сиқырлы Сиқырлы
Dialogue: 0,0:13:24.09,0:13:25.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:26.30,0:13:27.47,Default,,0,0,0,,Қайырлы кеш
Dialogue: 0,0:13:28.09,0:13:30.60,Default,,0,0,0,,Кешіріңіз, мен сізге ертерек қоңырау шалдым...
Dialogue: 0,0:13:30.68,0:13:31.51,Default,,0,0,0,,Ах! (әділ) Уау
Dialogue: 0,0:13:31.60,0:13:34.27,Default,,0,0,0,,«Бұл дәмді» ханым
Dialogue: 0,0:13:34.35,0:13:35.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:35.89,0:13:38.15,Default,,0,0,0,,Сіз бұрынғы адамсыз ба?
Dialogue: 0,0:13:38.35,0:13:39.31,Default,,0,0,0,,Иә
Dialogue: 0,0:13:39.98,0:13:43.98,Default,,0,0,0,,Негізі... анам бүгін іспен кетті.
Dialogue: 0,0:13:44.07,0:13:47.49,Default,,0,0,0,,Не? (Котори) Демек, бұл демалыс күні...
Dialogue: 0,0:13:47.74,0:13:49.24,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:13:49.53,0:13:50.99,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:53.16,0:13:54.41,Default,,0,0,0,,Кешкі ас ше?
Dialogue: 0,0:13:54.62,0:13:55.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:56.54,0:13:58.33,Default,,0,0,0,,Иә, кешіріңіз.
Dialogue: 0,0:13:58.42,0:14:00.08,Default,,0,0,0,,Сізде дәмді тағам жоқ па?
Dialogue: 0,0:14:00.17,0:14:03.09,Default,,0,0,0,,Иә, басқа дүкенге барайық.
Dialogue: 0,0:14:04.05,0:14:05.05,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:06.09,0:14:07.84,Default,,0,0,0,,Бізде дәмді тағам бар!
Dialogue: 0,0:14:08.01,0:14:10.97,Default,,0,0,0,,Не? Бірақ сенің анаң жоқ.
Dialogue: 0,0:14:11.30,0:14:14.01,Default,,0,0,0,,А... мен де...
Dialogue: 0,0:14:16.23,0:14:17.98,Default,,0,0,0,,Күріш туралы пісіре алады.
Dialogue: 0,0:14:18.60,0:14:19.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:19.52,0:14:20.98,Default,,0,0,0,,Қазан күріш?
Dialogue: 0,0:14:21.48,0:14:23.82,Default,,0,0,0,,Бұл өте дәмді тағам.
Dialogue: 0,0:14:23.90,0:14:24.90,Default,,0,0,0,,Уау
Dialogue: 0,0:14:25.32,0:14:27.24,Default,,0,0,0,,Отосан, бұл қазан күріш.
Dialogue: 0,0:14:27.32,0:14:28.15,Default,,0,0,0,,Ал...
Dialogue: 0,0:14:28.24,0:14:30.82,Default,,0,0,0,,Қандай дәмді тағам!
Dialogue: 0,0:14:31.03,0:14:32.66,Default,,0,0,0,,Маған қоңырау шалыңыз.
Dialogue: 0,0:14:32.91,0:14:33.74,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:35.91,0:14:38.33,Default,,0,0,0,,Мен бұл дәмді тағам дедім.
Dialogue: 0,0:14:38.41,0:14:40.25,Default,,0,0,0,,Мұғалім де өтінемін (әділ) Иә?
Dialogue: 0,0:14:42.71,0:14:46.05,Default,,0,0,0,,Отосан, қара, қара, каллиграфия
Dialogue: 0,0:15:27.38,0:15:28.38,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:15:29.92,0:15:31.30,Default,,0,0,0,,Бір сәт кешіріңіз.
Dialogue: 0,0:15:34.80,0:15:37.51,Default,,0,0,0,,Мен мұндай дүкенді бірінші рет көріп тұрмын.
Dialogue: 0,0:15:38.02,0:15:39.77,Default,,0,0,0,,Иә... дұрыс.
Dialogue: 0,0:15:40.31,0:15:41.52,Default,,0,0,0,,Әкемнің әжетханасы
Dialogue: 0,0:15:43.40,0:15:44.23,Default,,0,0,0,,Тәжік пе?
Dialogue: 0,0:15:44.31,0:15:45.31,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:15:47.90,0:15:49.23,Default,,0,0,0,,Анамның ақымақ
Dialogue: 0,0:15:49.61,0:15:52.03,Default,,0,0,0,,Неліктен балшық құмыраларда күріш пісіруге арналған таразы болмайды?
Dialogue: 0,0:15:52.11,0:15:54.24,Default,,0,0,0,,Қолыңнан келеді деп салқын айттың.
Dialogue: 0,0:15:54.32,0:15:56.53,Default,,0,0,0,,1 кесе дегеніміз не? Қанша?
Dialogue: 0,0:15:56.78,0:15:58.87,Default,,0,0,0,,Егер сіз мұны естісеңіз, маған қоңырау шалыңыз, өтінемін...
Dialogue: 0,0:16:01.87,0:16:03.04,Default,,0,0,0,,Сіз дәрет алдыңыз ба?
Dialogue: 0,0:16:03.33,0:16:04.42,Default,,0,0,0,,Мен бас тарттым.
Dialogue: 0,0:16:05.13,0:16:05.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:07.29,0:16:08.75,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:16:09.00,0:16:11.63,Default,,0,0,0,,Мм... жақсысың ба? (Кішкентай құс) Бұл не?
Dialogue: 0,0:16:11.72,0:16:13.59,Default,,0,0,0,,Жоқ... әртүрлі заттар.
Dialogue: 0,0:16:20.77,0:16:21.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:25.60,0:16:27.61,Default,,0,0,0,,Не істеп жатырсың?
Dialogue: 0,0:16:27.98,0:16:30.94,Default,,0,0,0,,Біз лагерьдегі суды осылай өлшедік.
Dialogue: 0,0:16:31.78,0:16:33.07,Default,,0,0,0,,Солай ма...?
Dialogue: 0,0:16:35.66,0:16:38.33,Default,,0,0,0,,Біраз күтіңіз, себебі ол суды сіңіреді.
Dialogue: 0,0:16:38.45,0:16:40.83,Default,,0,0,0,,Иә! Цумуги менің сурет салуымды күтіп тұр!
Dialogue: 0,0:16:41.08,0:16:43.58,Default,,0,0,0,,(Цумугидің гуілдеуі)
Dialogue: 0,0:16:52.26,0:16:53.63,Default,,0,0,0,,Өзіңізді әлі де жақсы сезінбейсіз бе?
Dialogue: 0,0:16:54.13,0:16:56.59,Default,,0,0,0,,Маған алаңдайтын бірнеше нәрсе бар...
Dialogue: 0,0:16:57.47,0:16:59.72,Default,,0,0,0,,Кешкі ас ішпегеніме көп болды.
Dialogue: 0,0:17:00.26,0:17:01.97,Default,,0,0,0,,Кешкі ас іштің бе?
Dialogue: 0,0:17:02.73,0:17:03.89,Default,,0,0,0,,Ал...
Dialogue: 0,0:17:04.44,0:17:07.35,Default,,0,0,0,,Мен сенімен тамақтанбағалы біраз болды.
Dialogue: 0,0:17:09.57,0:17:11.28,Default,,0,0,0,,Сонымен... болды ма?
Dialogue: 0,0:17:16.78,0:17:17.61,Default,,0,0,0,,Шабуыл
Dialogue: 0,0:17:17.70,0:17:20.83,Default,,0,0,0,,Сакені араластырса, дәмін жақсартады. Мен сенімдімін...
Dialogue: 0,0:17:20.91,0:17:23.58,Default,,0,0,0,,Бірақ ішімдік... балалар оны жейді.
Dialogue: 0,0:17:23.66,0:17:26.04,Default,,0,0,0,,Жарайды, мұғалім (әділ) А?
Dialogue: 0,0:17:26.42,0:17:29.46,Default,,0,0,0,,Пісіру кезінде ыстықтың әсерінен спирт буланып кетеді.
Dialogue: 0,0:17:30.00,0:17:30.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:33.30,0:17:34.26,Default,,0,0,0,,Ум...
Dialogue: 0,0:17:35.13,0:17:39.18,Default,,0,0,0,,Сіз біздің мектептен шыққан форманы киіп жүрсіз бе?
Dialogue: 0,0:17:39.89,0:17:42.85,Default,,0,0,0,,Иә, есіңізде жоқ шығар.
Dialogue: 0,0:17:43.89,0:17:46.31,Default,,0,0,0,,Бұл 1А сыныбынан келген Котори Иида.
Dialogue: 0,0:17:46.39,0:17:48.19,Default,,0,0,0,,Сынып жетекшісінің орынбасары Инузука мырза
Dialogue: 0,0:17:48.40,0:17:51.11,Default,,0,0,0,,Хе! Ах... Кешіріңіз (Kotori) А, жоқ.
Dialogue: 0,0:17:51.77,0:17:52.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:01.91,0:18:04.16,Default,,0,0,0,,(таймер дыбысы)
Dialogue: 0,0:18:05.16,0:18:06.12,Default,,0,0,0,,Сіз мұны жасадыңыз ба?
Dialogue: 0,0:18:06.87,0:18:09.25,Default,,0,0,0,,Әлі жоқ, мен оны қазір бумен пісіремін.
Dialogue: 0,0:18:23.14,0:18:27.02,Default,,0,0,0,,Цумуги ~ Әділдік ~ Кешкі ас ~
Dialogue: 0,0:18:27.77,0:18:30.94,Default,,0,0,0,,Сіз оны жасау үшін әрқашан көп күш жұмсамасаңыз да
Dialogue: 0,0:18:31.02,0:18:33.86,Default,,0,0,0,,Кохэй мырза, мен мүлде жемеймін.
Dialogue: 0,0:18:34.90,0:18:37.07,Default,,0,0,0,,Бұл бір реттік тамақ.
Dialogue: 0,0:18:37.15,0:18:39.32,Default,,0,0,0,,Мен сенің дәмді тамақтанғаныңды қалаймын.
Dialogue: 0,0:18:40.03,0:18:42.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:43.20,0:18:44.03,Default,,0,0,0,,Әй?
Dialogue: 0,0:18:47.50,0:18:50.17,Default,,0,0,0,,Фуфуфу…
Dialogue: 0,0:19:06.22,0:19:09.52,Default,,0,0,0,,Күріш... піскен!
Dialogue: 0,0:19:11.44,0:19:13.27,Default,,0,0,0,,Мүмкіндігінше тамақтаныңыз.
Dialogue: 0,0:19:13.56,0:19:15.69,Default,,0,0,0,,Ах~ Менің қарным қатты ашты.
Dialogue: 0,0:19:15.90,0:19:18.44,Default,,0,0,0,,Қараңызшы, жылтыр емес пе?
Dialogue: 0,0:19:18.57,0:19:21.95,Default,,0,0,0,,Райс тұрып, «сәлеметсіз бе» дейді
Dialogue: 0,0:19:22.07,0:19:23.66,Default,,0,0,0,,Жылтыр~
Dialogue: 0,0:19:25.70,0:19:26.62,Default,,0,0,0,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:19:26.70,0:19:29.20,Default,,0,0,0,,Мен қазір осындамын
Dialogue: 0,0:19:34.00,0:19:38.38,Default,,0,0,0,,Хмм, дәмді! Шағымдарыңызды бір-бірден жеткізіңіз...
Dialogue: 0,0:19:38.80,0:19:40.97,Default,,0,0,0,,Бұл таңқаларлық емес пе?
Dialogue: 0,0:19:41.13,0:19:42.55,Default,,0,0,0,,Дәмді
Dialogue: 0,0:19:45.76,0:19:48.02,Default,,0,0,0,,Отосан: Дәмді!
Dialogue: 0,0:19:48.31,0:19:49.14,Default,,0,0,0,,О...
Dialogue: 0,0:19:50.14,0:19:52.02,Default,,0,0,0,,Менің тамақтануымды бақылаңыз
Dialogue: 0,0:19:54.86,0:19:57.44,Default,,0,0,0,,Өте дәмді~
Dialogue: 0,0:19:57.65,0:19:58.57,Default,,0,0,0,,Конверт пе?
Dialogue: 0,0:20:01.61,0:20:02.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:05.53,0:20:06.91,Default,,0,0,0,,(Исуми Миямура) Ишикава-кун, сенде абсурдтай көп зат бар, иә?
Dialogue: 0,0:20:07.20,0:20:08.41,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:20:10.70,0:20:12.46,Default,,0,0,0,,Отосан да жейді.
Dialogue: 0,0:20:12.83,0:20:14.58,Default,,0,0,0,,Сіз оны қолданып көргіңіз келе ме? эй?
Dialogue: 0,0:20:23.80,0:20:24.72,Default,,0,0,0,,Дәмді
Dialogue: 0,0:20:26.43,0:20:28.47,Default,,0,0,0,,Бұл өте дәмді, солай емес пе?
Dialogue: 0,0:20:28.97,0:20:29.81,Default,,0,0,0,,Иә
Dialogue: 0,0:20:33.52,0:20:35.69,Default,,0,0,0,,Бұл өте дәмді
Dialogue: 0,0:20:48.37,0:20:51.41,Default,,0,0,0,,Цумуги мен уәде беремін.
Dialogue: 0,0:20:52.08,0:20:55.21,Default,,0,0,0,,Мынадай дәмді нәрсе—
Dialogue: 0,0:20:55.92,0:20:57.88,Default,,0,0,0,,Әкем қазірден бастап жасайды.
Dialogue: 0,0:20:59.04,0:21:00.71,Default,,0,0,0,,Әке, мен бар күшімді саламын.
Dialogue: 0,0:21:01.59,0:21:02.92,Default,,0,0,0,,Бірге тамақтанайық
Dialogue: 0,0:21:03.17,0:21:04.09,Default,,0,0,0,,Бір ай бойы бірдей нәрсені естіп жүрсең, ештеңе сезбей қаласың.
Dialogue: 0,0:21:04.68,0:21:05.51,Default,,0,0,0,,О
Dialogue: 0,0:21:07.05,0:21:09.72,Default,,0,0,0,,Отосанмен Мен Отосанмен біргемін~
Dialogue: 0,0:21:09.81,0:21:11.68,Default,,0,0,0,,О, оны маған қалдырыңыз!
Dialogue: 0,0:21:11.97,0:21:13.43,Default,,0,0,0,,Нене Нене Ахаха (Әділеттілік) Кішкене Цумуги
Dialogue: 0,0:21:13.52,0:21:15.27,Default,,0,0,0,,Әй, қауіпті... Дәмді екен. Алақай!
Dialogue: 0,0:21:15.35,0:21:16.48,Default,,0,0,0,,Ум...
Dialogue: 0,0:21:17.52,0:21:20.44,Default,,0,0,0,,Менің тамағым дәмді болды ма?
Dialogue: 0,0:21:20.82,0:21:23.57,Default,,0,0,0,,Иә, көп рахмет.
Dialogue: 0,0:21:24.36,0:21:26.41,Default,,0,0,0,,Сенің мұнда келгеніңе қуаныштымын.
Dialogue: 0,0:21:29.45,0:21:30.99,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:21:31.45,0:21:35.79,Default,,0,0,0,,Олай болса Инузука мырза, менің өтінішім бар.
Dialogue: 0,0:21:36.16,0:21:37.37,Default,,0,0,0,,Өтінемін?
Dialogue: 0,0:21:39.42,0:21:41.88,Default,,0,0,0,,Менімен кешкі ас ішкіңіз келе ме?
Dialogue: 0,0:21:42.80,0:21:44.05,Default,,0,0,0,,ше? иә?
Dialogue: 0,0:21:44.42,0:21:47.55,Default,,0,0,0,,Мұғалім, менімен бірге кешкі ас әзірлеп, жегің келе ме?
Dialogue: 0,0:21:47.63,0:21:48.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:52.26,0:21:53.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:54.02,0:21:54.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:56.27,0:22:00.27,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:28.40,0:23:32.41,Default,,0,0,0,,~♪
