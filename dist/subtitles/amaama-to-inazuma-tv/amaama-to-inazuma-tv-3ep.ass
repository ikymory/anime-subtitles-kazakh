Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.67,0:00:05.67,Default,,0,0,0,,(оятар дыбысы)
Dialogue: 0,0:00:23.77,0:00:25.48,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:00:30.40,0:00:31.57,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:00:32.36,0:00:35.16,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:38.70,0:00:40.95,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:00:42.79,0:00:44.29,Default,,0,0,0,,Қайырлы таң~
Dialogue: 0,0:00:50.00,0:00:51.50,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:01:00.51,0:01:01.47,Default,,0,0,0,,Аха!
Dialogue: 0,0:01:05.19,0:01:06.35,Default,,0,0,0,,Ас болсын!
Dialogue: 0,0:01:07.90,0:01:08.73,Default,,0,0,0,,Алдау екенін біліп тұрып, не болып жатқанын маған неге айтпадың?
Dialogue: 0,0:01:10.57,0:01:12.15,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:01:15.78,0:01:19.91,Default,,0,0,0,,«Бүгін 7:15-тен тікелей эфир».
Dialogue: 0,0:01:22.58,0:01:24.37,Default,,0,0,0,,Сонымен... енді?
Dialogue: 0,0:01:24.87,0:01:25.91,Default,,0,0,0,,Тікелей эфир?
Dialogue: 0,0:01:27.54,0:01:30.21,Default,,0,0,0,,Дүйсенбі, 24 сәуір
Dialogue: 0,0:01:30.29,0:01:32.59,Default,,0,0,0,,Уақыт 7:15.
Dialogue: 0,0:01:32.67,0:01:33.51,Default,,0,0,0,,Хехе
Dialogue: 0,0:01:33.80,0:01:36.34,Default,,0,0,0,,Хабар бүгін кешкі сағат 19:00-де
Dialogue: 0,0:01:36.42,0:01:38.59,Default,,0,0,0,,«Арнайы Gakuen Chiechie викторинасынан»—
Dialogue: 0,0:01:38.84,0:01:40.35,Default,,0,0,0,,Арнайы қонақтар
Dialogue: 0,0:01:40.43,0:01:42.06,Default,,0,0,0,,Қайырлы таң (2-ер адам) Сәлем.
Dialogue: 0,0:01:42.89,0:01:44.68,Default,,0,0,0,,Сен кішкентай құсты көріп тұрсың ба?
Dialogue: 0,0:01:44.77,0:01:47.02,Default,,0,0,0,,Анашым, мен барымды саламын~
Dialogue: 0,0:01:50.36,0:01:53.36,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:03:14.94,0:03:18.69,Default,,0,0,0,,~♪
Dialogue: 0,0:03:25.62,0:03:26.45,Default,,0,0,0,,Уау
Dialogue: 0,0:03:29.70,0:03:31.79,Default,,0,0,0,,Адам, күйіп қалды.
Dialogue: 0,0:03:32.04,0:03:34.21,Default,,0,0,0,,Біз бұл үшін жауапкершілікті аламыз.
Dialogue: 0,0:03:36.04,0:03:37.09,Default,,0,0,0,,Ас болсын!
Dialogue: 0,0:03:37.80,0:03:40.17,Default,,0,0,0,,О... мисо сорпасына ше?
Dialogue: 0,0:03:40.34,0:03:41.72,Default,,0,0,0,,Ол аздап қайнады, бірақ—
Dialogue: 0,0:03:41.80,0:03:44.59,Default,,0,0,0,,Шошқа сорпасын еске түсіріп дәмдеу...
Dialogue: 0,0:03:47.60,0:03:49.68,Default,,0,0,0,,Уау, қуырылған тофу өте ұзақ
Dialogue: 0,0:03:50.39,0:03:53.02,Default,,0,0,0,,Дұрыс Цумуги... Дұрыс.
Dialogue: 0,0:03:53.27,0:03:55.65,Default,,0,0,0,,Біреуі бар ма? Сою бар ма?
Dialogue: 0,0:03:56.44,0:03:57.73,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:03:58.65,0:04:01.19,Default,,0,0,0,,Фу Фу
Dialogue: 0,0:04:07.16,0:04:08.41,Default,,0,0,0,,Дәмді~
Dialogue: 0,0:04:08.87,0:04:10.79,Default,,0,0,0,,Иа... хех
Dialogue: 0,0:04:12.58,0:04:16.21,Default,,0,0,0,,Гаригари-чан үлпілдек.
Dialogue: 0,0:04:19.21,0:04:22.05,Default,,0,0,0,,Ах... Цумуги, сәл күте тұрыңыз.
Dialogue: 0,0:04:26.05,0:04:26.89,Default,,0,0,0,,Уау
Dialogue: 0,0:04:29.85,0:04:30.68,Default,,0,0,0,,Жарайды
Dialogue: 0,0:04:35.23,0:04:38.31,Default,,0,0,0,,Ммммммммм
Dialogue: 0,0:04:38.40,0:04:39.32,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:39.44,0:04:40.48,Default,,0,0,0,,Отосан
Dialogue: 0,0:04:40.65,0:04:43.07,Default,,0,0,0,,Тазалау, рахмет Цумуги
Dialogue: 0,0:04:43.61,0:04:44.65,Default,,0,0,0,,Хехехе
Dialogue: 0,0:04:45.03,0:04:47.74,Default,,0,0,0,,Қалғанын әкем үйге келгенде істеймін.
Dialogue: 0,0:04:49.45,0:04:50.91,Default,,0,0,0,,...tto газеті
Dialogue: 0,0:05:02.42,0:05:04.26,Default,,0,0,0,,Таңертең теледидарды қосқанда—
Dialogue: 0,0:05:04.80,0:05:07.43,Default,,0,0,0,,Анам матрос костюмін киген...
Dialogue: 0,0:05:08.80,0:05:09.64,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:05:09.72,0:05:11.81,Default,,0,0,0,,Күтілгендей, олай емес!
Dialogue: 0,0:05:13.43,0:05:14.35,Default,,0,0,0,,де!
Dialogue: 0,0:05:14.43,0:05:18.10,Default,,0,0,0,,Теледидар болса да, жақсылық пен жамандық бар.
Dialogue: 0,0:05:19.61,0:05:22.19,Default,,0,0,0,,Мен де ешқашан матрос костюмін киген емеспін.
Dialogue: 0,0:05:22.32,0:05:24.32,Default,,0,0,0,,Оның үстіне, ол сізге өте жарасады.
Dialogue: 0,0:05:24.69,0:05:27.74,Default,,0,0,0,,Анаңның қолы бос емес пе?
Dialogue: 0,0:05:29.57,0:05:30.41,Default,,0,0,0,,Иә
Dialogue: 0,0:05:30.49,0:05:33.58,Default,,0,0,0,,Мен атақты болған сияқты емеспін.
Dialogue: 0,0:05:34.29,0:05:35.12,Default,,0,0,0,,Аа сода
Dialogue: 0,0:05:35.33,0:05:36.71,Default,,0,0,0,,Қалай болды? Таңғы
Dialogue: 0,0:05:37.67,0:05:40.00,Default,,0,0,0,,Аралас жұмыртқалар өртенді
Dialogue: 0,0:05:40.08,0:05:41.54,Default,,0,0,0,,А... міне, солай.
Dialogue: 0,0:05:41.96,0:05:44.42,Default,,0,0,0,,Бірақ мисо сорпасы дайын емес пе?
Dialogue: 0,0:05:44.96,0:05:46.38,Default,,0,0,0,,Miso қосқаннан кейін—
Dialogue: 0,0:05:46.47,0:05:48.72,Default,,0,0,0,,Біраз уақыт отқа қойсаңыз, қайнап кетеді.
Dialogue: 0,0:05:49.14,0:05:50.97,Default,,0,0,0,,Ыстық сумен сұйылтылған
Dialogue: 0,0:05:51.76,0:05:53.51,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:05:54.60,0:05:57.27,Default,,0,0,0,,Мұғалім, қайнатып алудан қорқасыз ба?
Dialogue: 0,0:05:57.60,0:05:59.94,Default,,0,0,0,,Не? Бұл дұрыс
Dialogue: 0,0:06:00.40,0:06:03.65,Default,,0,0,0,,Асқазанның ауыруы қиын, сондықтан Цумуги
Dialogue: 0,0:06:04.94,0:06:05.78,Default,,0,0,0,,Иә
Dialogue: 0,0:06:10.53,0:06:12.74,Default,,0,0,0,,Иә... Иә...
Dialogue: 0,0:06:21.71,0:06:24.84,Default,,0,0,0,,Цумуги-чан ойнайық
Dialogue: 0,0:06:25.46,0:06:27.01,Default,,0,0,0,,Келесі жолы
Dialogue: 0,0:06:27.72,0:06:29.38,Default,,0,0,0,,Не? Сен не істеп жатырсың?
Dialogue: 0,0:06:29.76,0:06:31.51,Default,,0,0,0,,Сіз гамбургер жасайсыз ба?
Dialogue: 0,0:06:31.93,0:06:34.01,Default,,0,0,0,,Бұл менің әкеме арналған.
Dialogue: 0,0:06:39.19,0:06:40.23,Default,,0,0,0,,Ол келді.
Dialogue: 0,0:06:43.11,0:06:46.40,Default,,0,0,0,,Егер сіз оны жасасаңыз, сізге тәрелкелер, таяқшалар, қасықтар және т.б.
Dialogue: 0,0:06:46.48,0:06:48.53,Default,,0,0,0,,Жасам деп балшық таусылды.
Dialogue: 0,0:06:48.90,0:06:50.53,Default,,0,0,0,,Уау, бұл қиын.
Dialogue: 0,0:06:51.24,0:06:52.07,Default,,0,0,0,,Иә
Dialogue: 0,0:06:52.41,0:06:53.53,Default,,0,0,0,,Иә, бұл
Dialogue: 0,0:06:55.62,0:06:57.54,Default,,0,0,0,,Жақсы, қолданыңыз.
Dialogue: 0,0:06:57.75,0:06:58.70,Default,,0,0,0,,Мен де
Dialogue: 0,0:06:58.79,0:07:00.79,Default,,0,0,0,,Шынымен бе? Сенімен бәрі жақсы ма?
Dialogue: 0,0:07:01.08,0:07:03.88,Default,,0,0,0,,Мен бұл күндері балшықпен ойнамаймын, сондықтан жақсы.
Dialogue: 0,0:07:04.50,0:07:05.63,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:07.09,0:07:10.22,Default,,0,0,0,,Барлығымыз~ Қазір жинап алайық.
Dialogue: 0,0:07:10.38,0:07:11.93,Default,,0,0,0,,Иә
Dialogue: 0,0:07:15.89,0:07:19.10,Default,,0,0,0,,Цумуги-чан, сен бүгін менің үйімде ойнайсың ба?
Dialogue: 0,0:07:19.60,0:07:23.31,Default,,0,0,0,,Иә, әкесі: «Өтінемін», - деді.
Dialogue: 0,0:07:24.65,0:07:27.86,Default,,0,0,0,,Цумуги-чан, бұл ауыр емес пе?
Dialogue: 0,0:07:27.94,0:07:29.03,Default,,0,0,0,,Жақсы жұмыс
Dialogue: 0,0:07:29.90,0:07:32.03,Default,,0,0,0,,О, не болды? саз
Dialogue: 0,0:07:32.95,0:07:34.49,Default,,0,0,0,,Білесіз бе, мен түсіндім.
Dialogue: 0,0:07:34.74,0:07:36.16,Default,,0,0,0,,Уау Зури! иә?
Dialogue: 0,0:07:36.70,0:07:38.45,Default,,0,0,0,,Мұғалім, мына жігіт~
Dialogue: 0,0:07:38.54,0:07:40.87,Default,,0,0,0,,Сіз адам сазын алып жатырсыз ба?
Dialogue: 0,0:07:41.25,0:07:43.54,Default,,0,0,0,,Жоқ, түсіндім.
Dialogue: 0,0:07:43.75,0:07:45.17,Default,,0,0,0,,Иә
Dialogue: 0,0:07:45.63,0:07:49.51,Default,,0,0,0,,Бірақ келіңдер, бір ғана адам бар.
Dialogue: 0,0:07:49.67,0:07:50.72,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:07:50.84,0:07:53.38,Default,,0,0,0,,Енді менде бар, бұл Цумуги!
Dialogue: 0,0:07:53.51,0:07:55.97,Default,,0,0,0,,Уау, оны қайтару керек.
Dialogue: 0,0:07:56.14,0:07:58.18,Default,,0,0,0,,Бұл ұры.
Dialogue: 0,0:07:58.43,0:07:59.27,Default,,0,0,0,,Э? Тұр... не?
Dialogue: 0,0:08:04.02,0:08:04.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:06.90,0:08:07.73,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:08.23,0:08:09.57,Default,,0,0,0,,Инузука мырза?
Dialogue: 0,0:08:09.82,0:08:11.07,Default,,0,0,0,,Иә
Dialogue: 0,0:08:11.24,0:08:12.99,Default,,0,0,0,,Жақсы нәрсе болды ма?
Dialogue: 0,0:08:13.11,0:08:15.36,Default,,0,0,0,,Не? Неліктен?
Dialogue: 0,0:08:15.82,0:08:17.99,Default,,0,0,0,,Бұл біршама (әділ) бірақ...
Dialogue: 0,0:08:18.08,0:08:20.33,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:08:20.62,0:08:22.58,Default,,0,0,0,,Иә, Инузука.
Dialogue: 0,0:08:23.41,0:08:24.25,Default,,0,0,0,,Иә
Dialogue: 0,0:08:25.50,0:08:26.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:26.42,0:08:27.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:27.63,0:08:29.00,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:08:29.21,0:08:31.21,Default,,0,0,0,,Иә, мен сені алып кетейін.
Dialogue: 0,0:08:31.80,0:08:33.63,Default,,0,0,0,,Иә... кешіріңіз.
Dialogue: 0,0:08:35.34,0:08:37.89,Default,,0,0,0,,Не болды? (Әділет) А...
Dialogue: 0,0:08:38.68,0:08:41.77,Default,,0,0,0,,Менің қызым біраз қиналып жатқан сияқты.
Dialogue: 0,0:08:44.69,0:08:45.69,Default,,0,0,0,,Цумуги
Dialogue: 0,0:08:46.10,0:08:48.56,Default,,0,0,0,,Кешіріңіз, Инузука-сан, маған қоңырау шалыңыз.
Dialogue: 0,0:08:48.90,0:08:50.15,Default,,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,0:08:50.36,0:08:52.32,Default,,0,0,0,,Сонымен Цумуги мен Микио ше?
Dialogue: 0,0:08:52.44,0:08:53.49,Default,,0,0,0,,Ол сол жерде.
Dialogue: 0,0:08:58.66,0:08:59.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:00.37,0:09:02.62,Default,,0,0,0,,Цумуги-чан мені тырнап алды
Dialogue: 0,0:09:02.70,0:09:04.71,Default,,0,0,0,,Цумуги тырналмаған
Dialogue: 0,0:09:06.12,0:09:07.67,Default,,0,0,0,,Микио-кун мені итеріп жіберді...
Dialogue: 0,0:09:07.75,0:09:09.92,Default,,0,0,0,,Цумуги-чанның қолы маған тиді, солай ма?
Dialogue: 0,0:09:10.25,0:09:12.51,Default,,0,0,0,,Әдейі емес, ұстаз, мен қарап отырдым.
Dialogue: 0,0:09:12.59,0:09:13.88,Default,,0,0,0,,Бірақ мен мұны істедім!
Dialogue: 0,0:09:14.26,0:09:16.59,Default,,0,0,0,,Цумуги Түсіндіңіз бе?
Dialogue: 0,0:09:16.68,0:09:18.43,Default,,0,0,0,,Цумуги Мен мұны істеген жоқпын!
Dialogue: 0,0:09:18.72,0:09:19.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:20.22,0:09:21.43,Default,,0,0,0,,Микио! (Әділет) А
Dialogue: 0,0:09:22.68,0:09:25.14,Default,,0,0,0,,Қызды тағы да жылаттың ба?
Dialogue: 0,0:09:25.35,0:09:26.48,Default,,0,0,0,,Жоқ... мені жылат...
Dialogue: 0,0:09:26.56,0:09:27.85,Default,,0,0,0,,Сонымен не болды?
Dialogue: 0,0:09:28.02,0:09:29.73,Default,,0,0,0,,Тынышталыңыз.
Dialogue: 0,0:09:30.44,0:09:33.23,Default,,0,0,0,,Мен соққанда, мен сені бастадым...
Dialogue: 0,0:09:33.73,0:09:36.49,Default,,0,0,0,,Ол қолын сермеп, мені ұрды
Dialogue: 0,0:09:36.70,0:09:37.91,Default,,0,0,0,,Мені басып кетті...
Dialogue: 0,0:09:38.32,0:09:40.53,Default,,0,0,0,,Мұны бірінші болып Микио жасады, солай ма?
Dialogue: 0,0:09:40.99,0:09:42.54,Default,,0,0,0,,Жарайды, кешірім сұрау керек.
Dialogue: 0,0:09:42.74,0:09:43.62,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:46.91,0:09:47.75,Default,,0,0,0,,Ах
Dialogue: 0,0:09:47.92,0:09:50.25,Default,,0,0,0,,Қараңдар, біз жақсы бітісеміз.
Dialogue: 0,0:09:51.67,0:09:53.59,Default,,0,0,0,,Эмма! Рэй!
Dialogue: 0,0:09:53.92,0:09:54.80,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:09:55.97,0:09:57.38,Default,,0,0,0,,О... жоқ!
Dialogue: 0,0:09:58.38,0:09:59.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:00.09,0:10:02.60,Default,,0,0,0,,Цумуги Микио-кун, кешірім сұраймын.
Dialogue: 0,0:10:02.85,0:10:05.10,Default,,0,0,0,,Цумуги-чан, менің әңгімемді тыңда.
Dialogue: 0,0:10:05.56,0:10:07.89,Default,,0,0,0,,Мен оны мүлдем жек көремін!
Dialogue: 0,0:10:16.53,0:10:19.70,Default,,0,0,0,,Үйде бір сәт сөйлесе аламыз ба?
Dialogue: 0,0:10:25.04,0:10:26.08,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:26.16,0:10:27.00,Default,,0,0,0,,Иә
Dialogue: 0,0:10:29.75,0:10:31.46,Default,,0,0,0,,Қош бол Цумуги-чан
Dialogue: 0,0:10:33.63,0:10:34.59,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:34.88,0:10:36.55,Default,,0,0,0,,Келесі жолы тағы ойнайық.
Dialogue: 0,0:11:07.54,0:11:08.45,Default,,0,0,0,,Цумуги
Dialogue: 0,0:11:09.12,0:11:10.92,Default,,0,0,0,,Қазір қария ғана қалды.
Dialogue: 0,0:11:16.59,0:11:18.46,Default,,0,0,0,,Сазды алдың ба?
Dialogue: 0,0:11:18.59,0:11:19.42,Default,,0,0,0,,Иә
Dialogue: 0,0:11:19.88,0:11:21.55,Default,,0,0,0,,Мен ұры емеспін
Dialogue: 0,0:11:21.68,0:11:22.51,Default,,0,0,0,,Иә
Dialogue: 0,0:11:23.68,0:11:24.97,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:11:25.39,0:11:26.85,Default,,0,0,0,,Цумуги ұры емес
Dialogue: 0,0:11:31.89,0:11:33.60,Default,,0,0,0,,Сіз маған жағымсыз нәрсе айттыңыз.
Dialogue: 0,0:11:33.90,0:11:34.73,Default,,0,0,0,,Иә
Dialogue: 0,0:11:36.52,0:11:37.48,Default,,0,0,0,,Жоқ, біз бұлай істей алмаймыз!
Dialogue: 0,0:11:38.28,0:11:41.40,Default,,0,0,0,,Үйден балшық сатып алып, бәріне қайтаруым керек пе?
Dialogue: 0,0:11:42.07,0:11:42.95,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:11:43.78,0:11:46.49,Default,,0,0,0,,Әке де, түсінбеушілік болса да...
Dialogue: 0,0:11:46.58,0:11:49.62,Default,,0,0,0,,Мен Цумугиді ұры деп атағанын қаламаймын.
Dialogue: 0,0:11:57.50,0:11:58.50,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:11:59.55,0:12:00.67,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:12:01.76,0:12:02.59,Default,,0,0,0,,Иә
Dialogue: 0,0:12:10.77,0:12:11.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:17.44,0:12:18.40,Default,,0,0,0,,Цумуги-чан
Dialogue: 0,0:12:18.61,0:12:20.73,Default,,0,0,0,,Бүгін бұл жаңа піскен гамбургер стейк.
Dialogue: 0,0:12:23.07,0:12:23.95,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:12:30.54,0:12:32.62,Default,,0,0,0,,Сіз қатты күйзеліске түскен сияқтысыз.
Dialogue: 0,0:12:32.71,0:12:33.54,Default,,0,0,0,,Иә
Dialogue: 0,0:12:35.04,0:12:37.79,Default,,0,0,0,,Мен онымен бүгін таңертең татуласып кеттім, бірақ...
Dialogue: 0,0:12:39.34,0:12:41.01,Default,,0,0,0,,Мен өзімді сергек сезінбеймін.
Dialogue: 0,0:12:43.51,0:12:44.68,Default,,0,0,0,,Сондықтан
Dialogue: 0,0:12:44.93,0:12:47.01,Default,,0,0,0,,гамбургер стейкімен көңіл-күйіңізді көтерейік
Dialogue: 0,0:12:47.14,0:12:48.97,Default,,0,0,0,,Жарайды, қолдан келгеннің бәрін жасайық.
Dialogue: 0,0:12:51.27,0:12:54.35,Default,,0,0,0,,Бірақ гамбургерлер үшін жылуды бақылау қиын емес пе?
Dialogue: 0,0:12:54.48,0:12:57.40,Default,,0,0,0,,Аа, болды, бұқтырайық.
Dialogue: 0,0:12:57.69,0:12:58.73,Default,,0,0,0,,Бұқтыру?
Dialogue: 0,0:12:59.61,0:13:01.11,Default,,0,0,0,,Бұқтырылған гамбургер стейк
Dialogue: 0,0:13:01.19,0:13:04.24,Default,,0,0,0,,Осылайша, орталық аз пісірілмейді.
Dialogue: 0,0:13:04.32,0:13:05.15,Default,,0,0,0,,Бұл дәмді
Dialogue: 0,0:13:05.28,0:13:06.49,Default,,0,0,0,,Мен асығып тұрмын—есеп-шотты беріңізші.
Dialogue: 0,0:13:06.70,0:13:07.87,Default,,0,0,0,,Сонымен (әділдік) Ах.
Dialogue: 0,0:13:08.28,0:13:11.58,Default,,0,0,0,,Енді мен мұғалімнен оны кесіп беруін өтінемін.
Dialogue: 0,0:13:12.08,0:13:12.91,Default,,0,0,0,,Иә, бұл
Dialogue: 0,0:13:13.00,0:13:14.79,Default,,0,0,0,,Ал мынау және мынау
Dialogue: 0,0:13:15.87,0:13:16.71,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:16.96,0:13:19.17,Default,,0,0,0,,Сенің көзің қатты қиналатын сияқты.
Dialogue: 0,0:13:19.67,0:13:20.88,Default,,0,0,0,,Керемет нәрсе ме?
Dialogue: 0,0:13:21.30,0:13:23.34,Default,,0,0,0,,Ым, қышиды ма? ол аурады?
Dialogue: 0,0:13:23.88,0:13:25.67,Default,,0,0,0,,Әрқашан көзіңізді қорғаңыз
Dialogue: 0,0:13:25.84,0:13:29.18,Default,,0,0,0,,Бірақ... ол менің көзілдірігімнің үстінде қалқып тұрады.
Dialogue: 0,0:13:30.47,0:13:32.81,Default,,0,0,0,,Қараңызшы, мен сәл күліп тұрмын.
Dialogue: 0,0:13:33.14,0:13:34.10,Default,,0,0,0,,Эмма мен басқалары – мен бұрын-соңды көрген де, сөйлескен де алғашқы адамдар еді.
Dialogue: 0,0:13:34.77,0:13:36.48,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:13:37.48,0:13:38.31,Default,,0,0,0,,Иә
Dialogue: 0,0:13:39.94,0:13:41.19,Default,,0,0,0,,Міне кеттік! (Кішкентай құс) Хмм...
Dialogue: 0,0:13:43.19,0:13:44.19,Default,,0,0,0,,Ум...
Dialogue: 0,0:13:44.61,0:13:46.65,Default,,0,0,0,,Оны қалай кесуге болады...
Dialogue: 0,0:13:46.99,0:13:47.82,Default,,0,0,0,,Ах
Dialogue: 0,0:13:48.61,0:13:50.78,Default,,0,0,0,,Пайдалы ма білмеймін, бірақ...
Dialogue: 0,0:13:51.24,0:13:54.08,Default,,0,0,0,,Мен анамның рецептін жазып алдым.
Dialogue: 0,0:13:58.96,0:14:01.96,Default,,0,0,0,,Бір қарағанда не айтып тұрғаныңызды түсінбеймін...
Dialogue: 0,0:14:02.04,0:14:04.84,Default,,0,0,0,,Кешіріңіз, мен мұны істей алмайтын сияқтымын.
Dialogue: 0,0:14:06.76,0:14:09.97,Default,,0,0,0,,Алдымен пиязды аршып аламыз.
Dialogue: 0,0:14:11.72,0:14:14.97,Default,,0,0,0,,жартысын кесіңіз
Dialogue: 0,0:14:16.35,0:14:17.18,Default,,0,0,0,,Уф
Dialogue: 0,0:14:18.02,0:14:20.69,Default,,0,0,0,,Мен бүгін өте сенімді емеспін, сондықтан...
Dialogue: 0,0:14:20.90,0:14:22.57,Default,,0,0,0,,Біреудің зардап шеккенін көрмеген дұрыс.
Dialogue: 0,0:14:22.69,0:14:24.32,Default,,0,0,0,,Біз оларды қашып құтылуға ешқашан жол бермейміз
Dialogue: 0,0:14:24.57,0:14:28.86,Default,,0,0,0,,Бүйірден бастаңыз... осында қалдырыңыз.
Dialogue: 0,0:14:29.41,0:14:31.37,Default,,0,0,0,,А... бұл қиын.
Dialogue: 0,0:14:32.28,0:14:35.83,Default,,0,0,0,,Менде таңғыштар көп.
Dialogue: 0,0:14:36.58,0:14:37.96,Default,,0,0,0,,Келесі, тігінен...
Dialogue: 0,0:14:41.00,0:14:44.30,Default,,0,0,0,,Оны айналдырып, жоғарыдан кесіңіз...
Dialogue: 0,0:14:46.30,0:14:48.59,Default,,0,0,0,,О! Ол туралған
Dialogue: 0,0:14:55.47,0:14:59.73,Default,,0,0,0,,О! Бұл керемет. Бұл сиқырлы амал сияқты.
Dialogue: 0,0:15:00.85,0:15:01.69,Default,,0,0,0,,Иә
Dialogue: 0,0:15:02.23,0:15:03.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:05.44,0:15:08.19,Default,,0,0,0,,Ұсақ туралған пияз —
Dialogue: 0,0:15:08.40,0:15:10.45,Default,,0,0,0,,Қызарғанша қуырыңыз.
Dialogue: 0,0:15:12.16,0:15:13.62,Default,,0,0,0,,Сары түс дегеніміз не?
Dialogue: 0,0:15:14.58,0:15:18.62,Default,,0,0,0,,Бұл ақшыл мөлдір қоңыр сияқты дәмді түс.
Dialogue: 0,0:15:19.83,0:15:21.83,Default,,0,0,0,,Оны күйдірмеу үшін абай болыңыз.
Dialogue: 0,0:15:23.42,0:15:25.50,Default,,0,0,0,,Қараңдаршы, оның иісі жақсы.
Dialogue: 0,0:15:30.17,0:15:34.09,Default,,0,0,0,,Ал, нанның үгіндісі сүтке малынған...
Dialogue: 0,0:15:34.43,0:15:35.26,Default,,0,0,0,,Иә
Dialogue: 0,0:15:35.85,0:15:39.10,Default,,0,0,0,,Мен ойлағаннан да аз ингредиенттер бар.
Dialogue: 0,0:15:39.60,0:15:42.27,Default,,0,0,0,,Бұл мереке, бірақ бұл қарапайым.
Dialogue: 0,0:15:42.65,0:15:45.52,Default,,0,0,0,,Бірақ мен окара мен тофу сияқты нәрселерді де араластырдым.
Dialogue: 0,0:15:45.65,0:15:48.53,Default,,0,0,0,,Кейбіреулер киви немесе сол сияқтыларды қосады.
Dialogue: 0,0:15:49.23,0:15:50.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:51.70,0:15:54.37,Default,,0,0,0,,Киви ингредиенттері етті жұмсақ етеді.
Dialogue: 0,0:15:54.62,0:15:56.33,Default,,0,0,0,,Ол жұмсақ әрі жұмсақ болады.
Dialogue: 0,0:15:56.49,0:15:57.49,Default,,0,0,0,,Міне.
Dialogue: 0,0:15:57.66,0:16:00.25,Default,,0,0,0,,Бұл тәтті және қышқыл шошқа етіне ананас қосумен бірдей.
Dialogue: 0,0:16:01.46,0:16:04.50,Default,,0,0,0,,Ха... Цумуги, мен саған көмектесе аламын ба?
Dialogue: 0,0:16:06.67,0:16:10.59,Default,,0,0,0,,Енді етті пішінге келтіреміз... Саған балшық ұнайды, солай ма?
Dialogue: 0,0:16:11.80,0:16:12.88,Default,,0,0,0,,Жоқ
Dialogue: 0,0:16:13.47,0:16:14.39,Default,,0,0,0,,Цумуги
Dialogue: 0,0:16:14.80,0:16:16.43,Default,,0,0,0,,Менің көңіл-күйімді қалай көтеруге болады?
Dialogue: 0,0:16:19.26,0:16:24.06,Default,,0,0,0,,Өйткені мен өзімді жаман нәрсе істегендей сезінемін.
Dialogue: 0,0:16:24.52,0:16:25.35,Default,,0,0,0,,Ах
Dialogue: 0,0:16:26.19,0:16:28.15,Default,,0,0,0,,Цумуги ұры емес
Dialogue: 0,0:16:28.44,0:16:30.82,Default,,0,0,0,,Әке, мен түсіндім дедім.
Dialogue: 0,0:16:31.82,0:16:33.45,Default,,0,0,0,,Мен сыныпқа барып қарап келейін.
Dialogue: 0,0:16:33.74,0:16:35.32,Default,,0,0,0,,Мен сыныпқа барып қарап келейін.
Dialogue: 0,0:16:37.66,0:16:38.49,Default,,0,0,0,,Ах
Dialogue: 0,0:16:38.78,0:16:43.12,Default,,0,0,0,,Ұстаз, көбірек тырысыңыз, мұқият тыңдаңыз...
Dialogue: 0,0:16:45.87,0:16:46.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:49.96,0:16:52.13,Default,,0,0,0,,Ах... ах
Dialogue: 0,0:16:56.93,0:16:57.76,Default,,0,0,0,,Цумуги
Dialogue: 0,0:17:04.77,0:17:05.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:08.27,0:17:10.15,Default,,0,0,0,,Мен ұры емеспін, бірақ...
Dialogue: 0,0:17:11.32,0:17:16.45,Default,,0,0,0,,Сазды көп алдым, қайтармадым.
Dialogue: 0,0:17:17.45,0:17:19.91,Default,,0,0,0,,Цумуги ол жаман қыз ба?
Dialogue: 0,0:17:20.33,0:17:21.16,Default,,0,0,0,,Га
Dialogue: 0,0:17:27.08,0:17:27.96,Default,,0,0,0,,Цумуги!
Dialogue: 0,0:17:28.67,0:17:30.63,Default,,0,0,0,,Цумуги жаман қыз емес!
Dialogue: 0,0:17:31.00,0:17:33.13,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:17:33.42,0:17:35.84,Default,,0,0,0,,Әке, мен Цумугидің жақсы қыз екенін білемін.
Dialogue: 0,0:17:36.30,0:17:39.60,Default,,0,0,0,,Цумуги мейірімді және айтқанын орындайды.
Dialogue: 0,0:17:39.68,0:17:41.89,Default,,0,0,0,,Ол тіпті маған көмектеседі.
Dialogue: 0,0:17:42.31,0:17:44.10,Default,,0,0,0,,Сонымен қатар... Және де.
Dialogue: 0,0:17:44.68,0:17:46.35,Default,,0,0,0,,Менің әкемнің цумугиі көп...
Dialogue: 0,0:17:46.48,0:17:48.27,Default,,0,0,0,,Бұл маған үлкен қуат береді.
Dialogue: 0,0:17:48.85,0:17:51.23,Default,,0,0,0,,Әке, мен Цумугиді жақсы көремін.
Dialogue: 0,0:17:56.70,0:17:57.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:02.70,0:18:04.75,Default,,0,0,0,,Гамбургер жасаймыз ба?
Dialogue: 0,0:18:05.79,0:18:06.62,Default,,0,0,0,,Иә
Dialogue: 0,0:18:08.04,0:18:08.87,Default,,0,0,0,,Хехе
Dialogue: 0,0:18:11.92,0:18:15.30,Default,,0,0,0,,Енді мына иленген, иленген, иленген тұқымды алайық...
Dialogue: 0,0:18:15.51,0:18:18.72,Default,,0,0,0,,Пішінді осылай реттеу кезінде—
Dialogue: 0,0:18:20.14,0:18:22.30,Default,,0,0,0,,Ауаны шығарыңыз
Dialogue: 0,0:18:22.51,0:18:23.85,Default,,0,0,0,,Цумуги иә?
Dialogue: 0,0:18:24.60,0:18:25.52,Default,,0,0,0,,Жарайды, келіңіз.
Dialogue: 0,0:18:26.39,0:18:27.23,Default,,0,0,0,,Иә
Dialogue: 0,0:18:27.56,0:18:29.10,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:29.90,0:18:31.52,Default,,0,0,0,,Сен жақсысың, Цумуги.
Dialogue: 0,0:18:33.48,0:18:34.32,Default,,0,0,0,,Қосымша
Dialogue: 0,0:18:39.74,0:18:41.07,Default,,0,0,0,,Ол күйіп барады.
Dialogue: 0,0:18:41.74,0:18:42.62,Default,,0,0,0,,Оның артында не жатыр?
Dialogue: 0,0:18:42.83,0:18:46.20,Default,,0,0,0,,Осыдан кейін ол қайнатылады, сондықтан ол қызарса жақсы.
Dialogue: 0,0:18:46.41,0:18:47.66,Default,,0,0,0,,Оны шығарып алайық
Dialogue: 0,0:18:51.75,0:18:52.92,Default,,0,0,0,,Хехе
Dialogue: 0,0:18:53.50,0:18:56.13,Default,,0,0,0,,Тұздық жай ғана консервіленген қызанақ негізінде жасалған.
Dialogue: 0,0:18:56.42,0:18:59.55,Default,,0,0,0,,Вустершир соусын және кетчупты қосыңыз
Dialogue: 0,0:19:00.38,0:19:02.51,Default,,0,0,0,,Соңында қатты сорпаны қосыңыз.
Dialogue: 0,0:19:05.18,0:19:06.64,Default,,0,0,0,,және осында
Dialogue: 0,0:19:13.90,0:19:14.98,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:19:15.11,0:19:17.19,Default,,0,0,0,,Тек қайнатуға рұқсат етіңіз және дайын болды.
Dialogue: 0,0:19:17.44,0:19:19.28,Default,,0,0,0,,Енді соңғы нүктеге келейік.
Dialogue: 0,0:19:19.40,0:19:20.70,Default,,0,0,0,,Не? Аяқтап жатырсыз ба?
Dialogue: 0,0:19:24.74,0:19:26.66,Default,,0,0,0,,Сонымен... орындалды~
Dialogue: 0,0:19:26.79,0:19:30.29,Default,,0,0,0,,Бұл бұрын-соңды болмаған көрінетін нәрсе.
Dialogue: 0,0:19:31.25,0:19:32.75,Default,,0,0,0,,Оматаза Цумуги
Dialogue: 0,0:19:33.00,0:19:33.96,Default,,0,0,0,,Уау...
Dialogue: 0,0:19:34.17,0:19:36.04,Default,,0,0,0,,Енді тамақтанайық!
Dialogue: 0,0:19:36.75,0:19:37.59,Default,,0,0,0,,Иә
Dialogue: 0,0:19:39.17,0:19:41.09,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:19:47.56,0:19:49.81,Default,,0,0,0,,Ах, Цумуги, менің шашым...
Dialogue: 0,0:19:51.02,0:19:51.85,Default,,0,0,0,,Хаха
Dialogue: 0,0:19:57.73,0:19:58.57,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:59.44,0:20:01.53,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,0:20:02.40,0:20:03.28,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:03.45,0:20:04.41,Default,,0,0,0,,Цумуги?
Dialogue: 0,0:20:05.99,0:20:07.20,Default,,0,0,0,,...
Dialogue: 0,0:20:07.83,0:20:11.91,Default,,0,0,0,,Уау~ Ах~
Dialogue: 0,0:20:17.75,0:20:19.05,Default,,0,0,0,,Кешіріңіз, Цумуги
Dialogue: 0,0:20:20.21,0:20:22.01,Default,,0,0,0,,Ол әрқашан жақсы қыз болды.
Dialogue: 0,0:20:24.13,0:20:24.97,Default,,0,0,0,,Бірақ
Dialogue: 0,0:20:26.64,0:20:30.64,Default,,0,0,0,,Цумуги қандай бала болса да, әкесі оны жақсы көреді.
Dialogue: 0,0:20:31.48,0:20:32.48,Default,,0,0,0,,Я~
Dialogue: 0,0:20:36.98,0:20:38.23,Default,,0,0,0,,Дәмді~
Dialogue: 0,0:20:38.90,0:20:40.36,Default,,0,0,0,,Өте жұмсақ
Dialogue: 0,0:20:40.61,0:20:42.36,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:20:42.53,0:20:43.36,Default,,0,0,0,,♬~
Dialogue: 0,0:20:44.57,0:20:46.62,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:20:46.91,0:20:49.20,Default,,0,0,0,,Бүгін тағы бір үлкен жетістік емес пе?
Dialogue: 0,0:20:49.41,0:20:50.24,Default,,0,0,0,,Хаха
Dialogue: 0,0:20:51.58,0:20:52.41,Default,,0,0,0,,Әй!
Dialogue: 0,0:20:52.70,0:20:54.37,Default,,0,0,0,,Дұрыс, Цумуги-чан.
Dialogue: 0,0:20:54.58,0:20:56.54,Default,,0,0,0,,Сіз балшықтан не жасамақ болдыңыз?
Dialogue: 0,0:20:56.88,0:20:58.92,Default,,0,0,0,,Отосанның туған күні алдындағы (жәрмеңке)?
Dialogue: 0,0:20:59.17,0:21:00.21,Default,,0,0,0,,Туғанға дейін?
Dialogue: 0,0:21:01.26,0:21:03.09,Default,,0,0,0,,Иә, ұмытып қалдым.
Dialogue: 0,0:21:03.34,0:21:05.38,Default,,0,0,0,,Ото-сан, бүгін сенің туған күнің ғой, солай емес пе?
Dialogue: 0,0:21:05.68,0:21:06.84,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:21:06.93,0:21:07.76,Default,,0,0,0,,(Масато) Денең болмауы біраз қиын ғой, иә?
Dialogue: 0,0:21:08.01,0:21:10.81,Default,,0,0,0,,Бұл 4-ші, 2-ші және 5-ші күн.
Dialogue: 0,0:21:19.82,0:21:21.73,Default,,0,0,0,,Мен кішкентай жігітке айналдым, бірақ...
Dialogue: 0,0:21:21.86,0:21:23.74,Default,,0,0,0,,Мен саған балшықтан жасалған гамбургер беремін.
Dialogue: 0,0:21:23.94,0:21:24.82,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:25.28,0:21:26.41,Default,,0,0,0,,Рақмет.
Dialogue: 0,0:21:26.99,0:21:30.20,Default,,0,0,0,,Мұғалім, бүгін сенің туған күнің бе?
Dialogue: 0,0:21:31.37,0:21:33.66,Default,,0,0,0,,Дұрыс, хехе
Dialogue: 0,0:21:34.71,0:21:35.87,Default,,0,0,0,,Мен үшін қазір...
Dialogue: 0,0:21:36.42,0:21:37.46,Default,,0,0,0,,Бұл жалғыз нәрсе...
Dialogue: 0,0:21:39.25,0:21:41.46,Default,,0,0,0,,Бұл қайнап жатқан қоспа, бәлкім,
Dialogue: 0,0:21:41.55,0:21:43.17,Default,,0,0,0,,Ең дәмді бөлігі...
Dialogue: 0,0:21:43.38,0:21:46.05,Default,,0,0,0,,Мен саған беремін! Бұл сыйлық!
Dialogue: 0,0:21:46.30,0:21:47.30,Default,,0,0,0,,(Шоко) Есікті ашамын. Киініп жатқанда да апат болуы мүмкін, білесің бе.
Dialogue: 0,0:21:47.80,0:21:49.47,Default,,0,0,0,,Маған керегі жоқ (Кішкентай құс) Е!
Dialogue: 0,0:21:50.26,0:21:53.47,Default,,0,0,0,,Келесі жолы мен одан да дәмді нәрсе жасаймын~
Dialogue: 0,0:21:53.56,0:21:55.77,Default,,0,0,0,,Хи хи хи хи
Dialogue: 0,0:21:56.02,0:21:59.02,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:28.57,0:23:32.24,Default,,0,0,0,,~♪
