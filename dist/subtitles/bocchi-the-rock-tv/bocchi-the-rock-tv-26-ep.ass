Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.21,0:00:05.71,Default,,0,0,0,,Ха ха ха ха…
Dialogue: 0,0:00:01.21,0:00:05.71,Default,,0,0,0,,Can Queen
Dialogue: 0,0:00:15.22,0:00:17.22,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:00:19.22,0:00:24.22,Default,,0,0,0,,Ух... у... Уау~
Dialogue: 0,0:00:26.90,0:00:33.30,Default,,0,0,0,,20 минут қалды 20 минут қалды 20 минут қалды...
Dialogue: 0,0:02:09.21,0:02:11.21,Default,,0,0,0,,Мен… (Дамиан) Хм. Тек балалар ойыны ғой.
Dialogue: 0,0:02:11.21,0:02:13.21,Default,,0,0,0,,《Кеше Нижика-чаннан...》
Dialogue: 0,0:02:13.21,0:02:16.55,Default,,0,0,0,,((Нижика: Топтың болашақ қызметі туралы
Dialogue: 0,0:02:13.21,0:02:16.55,Default,,0,0,0,,Бірге талқылайық!
Dialogue: 0,0:02:16.55,0:02:18.55,Default,,0,0,0,,Жұлдыз ертең кездеседі!
Dialogue: 0,0:02:18.55,0:02:21.72,Default,,0,0,0,,《және отбасынан тыс
Dialogue: 0,0:02:18.55,0:02:21.72,Default,,0,0,0,,LOINE➡︎ ішінде қалқымалы
Dialogue: 0,0:02:21.72,0:02:24.23,Default,,0,0,0,,Болған оқиға жақсы болды, бірақ...
Dialogue: 0,0:02:24.23,0:02:26.73,Default,,0,0,0,,Мынадай картоп қыз кіріп келсе➡︎
Dialogue: 0,0:02:26.73,0:02:30.23,Default,,0,0,0,,Мынау кім? көзбен
Dialogue: 0,0:02:26.73,0:02:30.23,Default,,0,0,0,,Ол көрінеді
Dialogue: 0,0:02:30.23,0:02:34.74,Default,,0,0,0,,Себебі мен бұрын Ниджика-чанмен бірге болдым.
Dialogue: 0,0:02:30.23,0:02:34.74,Default,,0,0,0,,Мен оны қойдым, бірақ...
Dialogue: 0,0:02:34.74,0:02:38.24,Default,,0,0,0,,Біреу кіреді ме екен...》
Dialogue: 0,0:02:40.41,0:02:44.75,Default,,0,0,0,,《Мен біреумен кіргім келеді.
Dialogue: 0,0:02:44.75,0:02:49.42,Default,,0,0,0,,5 минут... 5 минут қалды
Dialogue: 0,0:02:44.75,0:02:49.42,Default,,0,0,0,,Міндетті түрде кіріңіз
Dialogue: 0,0:02:49.42,0:02:56.19,Default,,0,0,0,,Жоқ, 10 минут...
Dialogue: 0,0:02:49.42,0:02:56.19,Default,,0,0,0,,15 минут Мүлдем 15 минуттан кейін》
Dialogue: 0,0:02:56.19,0:02:59.36,Default,,0,0,0,,Сіз не істеп жатырсыз? мен...
Dialogue: 0,0:02:59.36,0:03:01.86,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:02:59.36,0:03:01.86,Default,,0,0,0,,Мен көбірек көргім келеді
Dialogue: 0,0:03:01.86,0:03:05.87,Default,,0,0,0,,Оны көруді тоқтатыңыз
Dialogue: 0,0:03:01.86,0:03:05.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:05.87,0:03:07.87,Default,,0,0,0,,Иә! Сонымен ➡︎
Dialogue: 0,0:03:07.87,0:03:12.71,Default,,0,0,0,,1-ші оркестр мүшелерінің жиналысы
Dialogue: 0,0:03:07.87,0:03:12.71,Default,,0,0,0,,Ол өтеді! Қол шапалақтау!
Dialogue: 0,0:03:12.71,0:03:17.71,Default,,0,0,0,,Шырылдау... Шырылдау...
Dialogue: 0,0:03:12.71,0:03:17.71,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:03:17.71,0:03:21.88,Default,,0,0,0,,Ойланып қарасаңыз, біз мүлде жақсы дос емеспіз.
Dialogue: 0,0:03:17.71,0:03:21.88,Default,,0,0,0,,Мен не айтарымды білмеймін.
Dialogue: 0,0:03:21.88,0:03:23.89,Default,,0,0,0,,《Дене немесе қақпақ жоқ! 》
Dialogue: 0,0:03:23.89,0:03:28.22,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:03:23.89,0:03:28.22,Default,,0,0,0,,Осыған ұқсас нәрсе
Dialogue: 0,0:03:23.89,0:03:28.22,Default,,0,0,0,,Ұнады!
Dialogue: 0,0:03:28.22,0:03:30.89,Default,,0,0,0,,《Қауіпті болып көрінетін нәрсе.
Dialogue: 0,0:03:28.22,0:03:30.89,Default,,0,0,0,,Олар қиылысады, бірақ...》
Dialogue: 0,0:03:30.89,0:03:34.90,Default,,0,0,0,,Иә! «Қызық, не шығады?
Dialogue: 0,0:03:30.89,0:03:34.90,Default,,0,0,0,,Не шығады деп ойлаймын».
Dialogue: 0,0:03:34.90,0:03:37.90,Default,,0,0,0,,«Деденден Дедедеден Дон»
Dialogue: 0,0:03:37.90,0:03:41.24,Default,,0,0,0,,Мектеп оқиғасы! Қысқасы Гакобана!
Dialogue: 0,0:03:41.24,0:03:43.57,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:03:41.24,0:03:43.57,Default,,0,0,0,,О, қой, қоя бер
Dialogue: 0,0:03:43.57,0:03:49.24,Default,,0,0,0,,Ал, а... ойланып көріңізші
Dialogue: 0,0:03:43.57,0:03:49.24,Default,,0,0,0,,Екеуі бір мектепте оқыған...
Dialogue: 0,0:03:49.24,0:03:53.01,Default,,0,0,0,,Иә! төменгі биіктік
Dialogue: 0,0:03:49.24,0:03:53.01,Default,,0,0,0,,Үйге жақын болғандықтан екеуін таңдадым.
Dialogue: 0,0:03:53.01,0:03:55.68,Default,,0,0,0,,Ах, мен Шимокитазавада тұрамын.
Dialogue: 0,0:03:55.68,0:03:58.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:55.68,0:03:58.19,Default,,0,0,0,,Бокчи-чан, Шука орта мектебі, солай ма?
Dialogue: 0,0:03:58.19,0:04:00.19,Default,,0,0,0,,Сіздің үйіңіз осы жерде емес пе?
Dialogue: 0,0:04:00.19,0:04:03.52,Default,,0,0,0,,Жоқ
Dialogue: 0,0:04:00.19,0:04:03.52,Default,,0,0,0,,Префектураның сыртында бір бағытқа 2 сағат кетеді.
Dialogue: 0,0:04:03.52,0:04:05.53,Default,,0,0,0,,Бұл оның әр жерде кенеттен пайда болып жүруін түсіндірер еді, иә?
Dialogue: 0,0:04:03.52,0:04:05.53,Default,,0,0,0,,(Джозеф Джоэстар) Бақытына орай, Авдолдың мойнындағы жара маңызды нүктеден тыс қалған, сондықтан—
Dialogue: 0,0:04:05.53,0:04:09.86,Default,,0,0,0,,Орта мектепте ешкім өткенін еске алмайды.
Dialogue: 0,0:04:05.53,0:04:09.86,Default,,0,0,0,,Мен белгісіз жерге барғым келеді
Dialogue: 0,0:04:09.86,0:04:11.87,Default,,0,0,0,,Иә, алшақтық бітті!
Dialogue: 0,0:04:11.87,0:04:15.54,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:04:11.87,0:04:15.54,Default,,0,0,0,,Тіпті орта мектепте сен негізінен жалғызсың ➡︎
Dialogue: 0,0:04:15.54,0:04:20.71,Default,,0,0,0,,Бұл... көңілді және күлкілі оқиға
Dialogue: 0,0:04:15.54,0:04:20.71,Default,,0,0,0,,Мен тіпті біреуін де бере алмаймын...
Dialogue: 0,0:04:20.71,0:04:23.88,Default,,0,0,0,,Жарайды, жарайды! Рё... Рё да.
Dialogue: 0,0:04:20.71,0:04:23.88,Default,,0,0,0,,Менің ондай достарым жоқ.
Dialogue: 0,0:04:23.88,0:04:26.21,Default,,0,0,0,,Иә. Тек Нижика
Dialogue: 0,0:04:26.21,0:04:28.22,Default,,0,0,0,,Е... Докун
Dialogue: 0,0:04:28.22,0:04:32.22,Default,,0,0,0,,《Роу-сан менімен бірдей...》
Dialogue: 0,0:04:32.22,0:04:35.72,Default,,0,0,0,,Демалыс күндері
Dialogue: 0,0:04:32.22,0:04:35.72,Default,,0,0,0,,Үйінділерді жалғыз зерттеу➡︎
Dialogue: 0,0:04:35.72,0:04:38.06,Default,,0,0,0,,Екінші қолдағы киім дүкендеріне бару
Dialogue: 0,0:04:38.06,0:04:43.73,Default,,0,0,0,,《Жоқ, жоқ! Райо мырза
Dialogue: 0,0:04:38.06,0:04:43.73,Default,,0,0,0,,Ол жалғыз болғанды ұнатады!
Dialogue: 0,0:04:43.73,0:04:47.74,Default,,0,0,0,,Комми синдромы бар адамдар киім дүкеніне жалғыз кіре алмайды!
Dialogue: 0,0:04:47.74,0:04:49.90,Default,,0,0,0,,Бокки мен жалғыздық арасында➡︎
Dialogue: 0,0:04:49.90,0:04:54.68,Default,,0,0,0,,Ешқашан толтырылмайды
Dialogue: 0,0:04:49.90,0:04:54.68,Default,,0,0,0,,Терең және үлкен ойық...
Dialogue: 0,0:04:54.68,0:04:58.18,Default,,0,0,0,,Қауіпті
Dialogue: 0,0:04:54.68,0:04:58.18,Default,,0,0,0,,тұзаққа түсіп кете жаздады》
Dialogue: 0,0:04:58.18,0:05:00.68,Default,,0,0,0,,Бокчи-чан, әңгімеден ләззат алайық!
Dialogue: 0,0:05:02.68,0:05:05.69,Default,,0,0,0,,Енді менің сүйікті музыкам туралы сөйлесейік!
Dialogue: 0,0:05:05.69,0:05:08.19,Default,,0,0,0,,Қысқартылған!
Dialogue: 0,0:05:05.69,0:05:08.19,Default,,0,0,0,,Автобана
Dialogue: 0,0:05:08.19,0:05:10.19,Default,,0,0,0,,О… Отобана
Dialogue: 0,0:05:10.19,0:05:14.20,Default,,0,0,0,,Мен Мелокоамын.
Dialogue: 0,0:05:10.19,0:05:14.20,Default,,0,0,0,,Менің ойымша, бұл жапондық панк деп аталады.
Dialogue: 0,0:05:14.20,0:05:18.87,Default,,0,0,0,,Маған техно әндер ұнайды.
Dialogue: 0,0:05:14.20,0:05:18.87,Default,,0,0,0,,Жақында мен Сауд Арабиясының хит-парадтарын жасап жүрмін...
Dialogue: 0,0:05:18.87,0:05:21.20,Default,,0,0,0,,Мен оны ол жерден таба алмаймын.
Dialogue: 0,0:05:18.87,0:05:21.20,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:05:21.20,0:05:24.04,Default,,0,0,0,,Бокчи-чан ше?
Dialogue: 0,0:05:21.20,0:05:24.04,Default,,0,0,0,,Мені атыммен атап тұрсың ба?
Dialogue: 0,0:05:24.04,0:05:28.88,Default,,0,0,0,,Жастар кешендерін ынталандыратын әндерден басқа.
Dialogue: 0,0:05:24.04,0:05:28.88,Default,,0,0,0,,Кез келген нәрсе...
Dialogue: 0,0:05:28.88,0:05:31.21,Default,,0,0,0,,Иә? Жастар кешені?
Dialogue: 0,0:05:31.21,0:05:33.21,Default,,0,0,0,,Түсіндірейін!
Dialogue: 0,0:05:33.21,0:05:36.38,Default,,0,0,0,,Жастар кешендерін қозғайтын әндер дегеніміз не?➡︎
Dialogue: 0,0:05:36.38,0:05:40.39,Default,,0,0,0,,Жаз және көк теңіз
Dialogue: 0,0:05:36.38,0:05:40.39,Default,,0,0,0,,Отшашу, ақшыл махаббат сияқты➡︎
Dialogue: 0,0:05:40.39,0:05:44.06,Default,,0,0,0,,Тек мектеп өмірінде
Dialogue: 0,0:05:40.39,0:05:44.06,Default,,0,0,0,,Бір-бірімен байланысы жоқ сөздер тым көп➡︎
Dialogue: 0,0:05:44.06,0:05:48.23,Default,,0,0,0,,Жылтырмен қапталған
Dialogue: 0,0:05:44.06,0:05:48.23,Default,,0,0,0,,Бұл сергітетін ән!
Dialogue: 0,0:05:48.23,0:05:51.83,Default,,0,0,0,,《Осындай ән сөздерін тыңдасам
Dialogue: 0,0:05:48.23,0:05:51.83,Default,,0,0,0,,Депрессия сезімі》
Dialogue: 0,0:05:48.23,0:05:51.83,Default,,0,0,0,,Эй
Dialogue: 0,0:05:51.83,0:05:55.67,Default,,0,0,0,,Керісінше, жастық шақтың депрессиясы
Dialogue: 0,0:05:51.83,0:05:55.67,Default,,0,0,0,,Ән мәтінінде қолданылған топ➡︎
Dialogue: 0,0:05:55.67,0:05:58.67,Default,,0,0,0,,Бұл сіздің сүйіктіңіз, солай ма?
Dialogue: 0,0:05:55.67,0:05:58.67,Default,,0,0,0,,Сәлем?
Dialogue: 0,0:05:55.67,0:05:58.67,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:05:58.67,0:06:03.34,Default,,0,0,0,,Бірақ менің сүйікті тобым мектеп кезімнен бері болды.
Dialogue: 0,0:05:58.67,0:06:03.34,Default,,0,0,0,,Кімнің танымал екенін білсеңіз➡︎
Dialogue: 0,0:06:03.34,0:06:07.01,Default,,0,0,0,,Кенеттен алыстау
Dialogue: 0,0:06:03.34,0:06:07.01,Default,,0,0,0,,Мен ойлана бастадым
Dialogue: 0,0:06:07.01,0:06:10.52,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:06:07.01,0:06:10.52,Default,,0,0,0,,Бір адамның әлеміне кірме!
Dialogue: 0,0:06:10.52,0:06:13.85,Default,,0,0,0,,Рокты жеңілгендер айтады.
Dialogue: 0,0:06:10.52,0:06:13.85,Default,,0,0,0,,Жүрегімді тебірентеді➡︎
Dialogue: 0,0:06:13.85,0:06:16.19,Default,,0,0,0,,Табысты адамдар ән айтса
Dialogue: 0,0:06:13.85,0:06:16.19,Default,,0,0,0,,Бұл әлдеқашан құлып...
Dialogue: 0,0:06:13.85,0:06:16.19,Default,,0,0,0,,Эй!
Dialogue: 0,0:06:16.19,0:06:20.19,Default,,0,0,0,,Барлығыңыз, бірігіңіздер!
Dialogue: 0,0:06:16.19,0:06:20.19,Default,,0,0,0,,Тек байлау жолақтары үшін
Dialogue: 0,0:06:20.19,0:06:24.20,Default,,0,0,0,,Жақсы
Dialogue: 0,0:06:20.19,0:06:24.20,Default,,0,0,0,,Менің алғашқы өмірім аспаптық ➡︎ болды
Dialogue: 0,0:06:24.20,0:06:28.04,Default,,0,0,0,,Келесі жолы вокал қосқым келеді.
Dialogue: 0,0:06:24.20,0:06:28.04,Default,,0,0,0,,О, солай ма?
Dialogue: 0,0:06:28.04,0:06:31.71,Default,,0,0,0,,Қашып кеткен бала гитарист екен.
Dialogue: 0,0:06:28.04,0:06:31.71,Default,,0,0,0,,Мен ән айтуым керек еді...
Dialogue: 0,0:06:31.71,0:06:34.71,Default,,0,0,0,,Ол бала қайда кетті?
Dialogue: 0,0:06:34.71,0:06:38.21,Default,,0,0,0,,《Гитара алып қашқан бала...
Dialogue: 0,0:06:38.21,0:06:42.05,Default,,0,0,0,,Мүмкін оның да мен сияқты комми синдромы болған шығар.
Dialogue: 0,0:06:42.05,0:06:46.89,Default,,0,0,0,,Жоқ, жоқ! Нағыз комми синдромы
Dialogue: 0,0:06:42.05,0:06:46.89,Default,,0,0,0,,Сіз қаша алмайсыз! 》
Dialogue: 0,0:06:46.89,0:06:49.56,Default,,0,0,0,,Вокал Мен оны қайтадан іздеуім керек
Dialogue: 0,0:06:49.56,0:06:53.66,Default,,0,0,0,,Мен ән айтуда жақсы емеспін
Dialogue: 0,0:06:49.56,0:06:53.66,Default,,0,0,0,,Бокчи-чан ше?
Dialogue: 0,0:06:53.66,0:06:56.66,Default,,0,0,0,,Ахаха... солай ма?
Dialogue: 0,0:06:56.66,0:06:59.67,Default,,0,0,0,,А, мына Рё-сан ше?
Dialogue: 0,0:06:59.67,0:07:02.34,Default,,0,0,0,,Фронтман➡︎-ге жеткенде
Dialogue: 0,0:07:02.34,0:07:05.17,Default,,0,0,0,,Менің адамым бол
Dialogue: 0,0:07:02.34,0:07:05.17,Default,,0,0,0,,Жолақты ұсақтау
Dialogue: 0,0:07:05.17,0:07:07.17,Default,,0,0,0,,Сізден шыққан бұл сенім қандай?
Dialogue: 0,0:07:07.17,0:07:11.18,Default,,0,0,0,,《Қызғаныш
Dialogue: 0,0:07:07.17,0:07:11.18,Default,,0,0,0,,Осы сеніммен бөліскеніңізді қалаймын》
Dialogue: 0,0:07:11.18,0:07:14.52,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:11.18,0:07:14.52,Default,,0,0,0,,Вокал тапсаң, ән шығарайық!
Dialogue: 0,0:07:14.52,0:07:17.52,Default,,0,0,0,,Мен музыка шығара аламын.
Dialogue: 0,0:07:14.52,0:07:17.52,Default,,0,0,0,,Ән мәтінінде тыйым салынған сөздер көп болса➡︎
Dialogue: 0,0:07:17.52,0:07:21.19,Default,,0,0,0,,Бокчи-чан оны жазуы керек.
Dialogue: 0,0:07:17.52,0:07:21.19,Default,,0,0,0,,《Не, мен!?》
Dialogue: 0,0:07:21.19,0:07:23.19,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл тамаша идея емес пе?
Dialogue: 0,0:07:23.19,0:07:27.19,Default,,0,0,0,,《Бастауыш және орта мектептің 9 жылдық үзіліс уақыты
Dialogue: 0,0:07:23.19,0:07:27.19,Default,,0,0,0,,Кітапханада уақыт өткізуді жалғастырдым➡︎
Dialogue: 0,0:07:27.19,0:07:29.20,Default,,0,0,0,,Бұған дайындық? 》
Dialogue: 0,0:07:29.20,0:07:32.70,Default,,0,0,0,,Нижика не істейді?
Dialogue: 0,0:07:29.20,0:07:32.70,Default,,0,0,0,,Ах
Dialogue: 0,0:07:32.70,0:07:35.70,Default,,0,0,0,,Ei
Dialogue: 0,0:07:35.70,0:07:37.87,Default,,0,0,0,,Келесі Норманың әңгімесі!
Dialogue: 0,0:07:37.87,0:07:39.87,Default,,0,0,0,,Абыроймен сыпырылды
Dialogue: 0,0:07:39.87,0:07:42.88,Default,,0,0,0,,Ах... бұл Норма...
Dialogue: 0,0:07:42.88,0:07:46.21,Default,,0,0,0,,Кеше шыққан тікелей шоу болды
Dialogue: 0,0:07:42.88,0:07:46.21,Default,,0,0,0,,Ол Live Booking➡︎ деп аталады
Dialogue: 0,0:07:46.21,0:07:48.38,Default,,0,0,0,,Жанды үй жағынан жолақ жағына➡︎
Dialogue: 0,0:07:48.38,0:07:51.78,Default,,0,0,0,,Тұтынушыларды тартуға кепілдік беру
Dialogue: 0,0:07:48.38,0:07:51.78,Default,,0,0,0,,Билет нормасы белгіленеді...
Dialogue: 0,0:07:58.16,0:08:00.83,Default,,0,0,0,,Қалыпты мөлшерден ➡︎ сатылған сома үшін
Dialogue: 0,0:08:00.83,0:08:03.83,Default,,0,0,0,,Жанды үй және топ жағында
Dialogue: 0,0:08:00.83,0:08:03.83,Default,,0,0,0,,Біз бөлісеміз...
Dialogue: 0,0:08:07.67,0:08:10.67,Default,,0,0,0,,Клиенттерді тарта алмасаңыз➡︎
Dialogue: 0,0:08:10.67,0:08:13.67,Default,,0,0,0,,Бұл сома
Dialogue: 0,0:08:10.67,0:08:13.67,Default,,0,0,0,,Сіз өз қалтаңыздан төлеуіңіз керек.
Dialogue: 0,0:08:13.67,0:08:16.18,Default,,0,0,0,,Басқаша айтқанда, ол сатылғанша көп ақша жұмсайды.
Dialogue: 0,0:08:16.18,0:08:18.18,Default,,0,0,0,,《Қорытынды》
Dialogue: 0,0:08:18.18,0:08:21.35,Default,,0,0,0,,Кешегі тікелей эфир болды
Dialogue: 0,0:08:18.18,0:08:21.35,Default,,0,0,0,,Менің көптеген достарым келді ➡︎
Dialogue: 0,0:08:21.35,0:08:23.68,Default,,0,0,0,,Мен билет сатып алдым, бірақ...
Dialogue: 0,0:08:23.68,0:08:27.69,Default,,0,0,0,,Бұл қойылыммен мен екінші рет оралмаймын.
Dialogue: 0,0:08:23.68,0:08:27.69,Default,,0,0,0,,Дұрыс?
Dialogue: 0,0:08:27.69,0:08:31.19,Default,,0,0,0,,Өйткені Рионың достары жоқ.
Dialogue: 0,0:08:27.69,0:08:31.19,Default,,0,0,0,,Сіз тұтынушыларды тартуға сене алмайсыз...
Dialogue: 0,0:08:31.19,0:08:33.19,Default,,0,0,0,,Бокчи-чан...
Dialogue: 0,0:08:33.19,0:08:37.03,Default,,0,0,0,,Иә, кешіріңіз! Өйткені бәрі жақсы
Dialogue: 0,0:08:33.19,0:08:37.03,Default,,0,0,0,,Өлі балық көздерін тоқтатыңыз
Dialogue: 0,0:08:37.03,0:08:40.70,Default,,0,0,0,,Қиялы дос болсаң
Dialogue: 0,0:08:37.03,0:08:40.70,Default,,0,0,0,,Өте көп》
Dialogue: 0,0:08:40.70,0:08:44.04,Default,,0,0,0,,Хитори-чан - ең жақсы!
Dialogue: 0,0:08:40.70,0:08:44.04,Default,,0,0,0,,Ей, тірі халық қазынасы!
Dialogue: 0,0:08:44.04,0:08:48.71,Default,,0,0,0,,Әзірше
Dialogue: 0,0:08:44.04,0:08:48.71,Default,,0,0,0,,Әрбір жанды орындау он мыңдаған иен➡︎ тұрады
Dialogue: 0,0:08:48.71,0:08:53.48,Default,,0,0,0,,Ақша табу мақсатында құрал-жабдықтың ақысы және т.б.
Dialogue: 0,0:08:48.71,0:08:53.48,Default,,0,0,0,,Толық емес жұмыс күні болсын!
Dialogue: 0,0:08:53.48,0:08:55.82,Default,,0,0,0,,Иә... Толық емес жұмыс күні!?
Dialogue: 0,0:08:55.82,0:08:57.82,Default,,0,0,0,,Сен бүгін қатты сөйледің.
Dialogue: 0,0:08:57.82,0:09:01.16,Default,,0,0,0,,《Мен жұмыс істегім келмейді. Мен қорқып тұрмын.
Dialogue: 0,0:09:01.16,0:09:03.16,Default,,0,0,0,,Қоғам қорқынышты! 》
Dialogue: 0,0:09:05.16,0:09:07.49,Default,,0,0,0,,А? Шошқа мырза?
Dialogue: 0,0:09:07.49,0:09:12.83,Default,,0,0,0,,Әй, анам.
Dialogue: 0,0:09:07.49,0:09:12.83,Default,,0,0,0,,Менің үйлену тойым үшін ақша үнемдегеніңіз үшін рахмет.
Dialogue: 0,0:09:12.83,0:09:15.84,Default,,0,0,0,,Енді, өтінемін, толық емес жұмыс күні...
Dialogue: 0,0:09:15.84,0:09:17.84,Default,,0,0,0,,Сен бізді жынға айналдырғың келе ме?
Dialogue: 0,0:09:15.84,0:09:17.84,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:17.84,0:09:20.17,Default,,0,0,0,,Мен оны жақсы пайдаландым...
Dialogue: 0,0:09:17.84,0:09:20.17,Default,,0,0,0,,Мен алмаймын, алмаймын!
Dialogue: 0,0:09:20.17,0:09:22.84,Default,,0,0,0,,Мен ол қымбат ақшаны пайдалана алмаймын!
Dialogue: 0,0:09:22.84,0:09:25.18,Default,,0,0,0,,Ух... а... бірақ...
Dialogue: 0,0:09:25.18,0:09:28.18,Default,,0,0,0,,《Мен жұмыс істегім келмейді! Өйткені…》
Dialogue: 0,0:09:28.18,0:09:31.19,Default,,0,0,0,,Ой... ау, қош келдіңіз.
Dialogue: 0,0:09:31.19,0:09:34.19,Default,,0,0,0,,《Міндетті түрде осылай болады...》
Dialogue: 0,0:09:34.19,0:09:37.19,Default,,0,0,0,,Ой... ау, қош келдіңіз.
Dialogue: 0,0:09:37.19,0:09:39.19,Default,,0,0,0,,《Мынау болды...》
Dialogue: 0,0:09:39.19,0:09:44.03,Default,,0,0,0,,Тұтынушыларға ыңғайсыздық тудырғаны үшін сыйлық берілмейді.
Dialogue: 0,0:09:39.19,0:09:44.03,Default,,0,0,0,,Өлім жазасын сұраймыз!
Dialogue: 0,0:09:44.03,0:09:47.20,Default,,0,0,0,,Олай болса, үкім... өлім жазасы!
Dialogue: 0,0:09:47.20,0:09:51.21,Default,,0,0,0,,《Бұл міндетті түрде болады! 》
Dialogue: 0,0:09:51.21,0:09:53.87,Default,,0,0,0,,Бокчи-чан Бокчи-чан!
Dialogue: 0,0:09:53.87,0:09:57.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:53.87,0:09:57.54,Default,,0,0,0,,Менің айтқанымды естімедің, солай ма?
Dialogue: 0,0:09:57.54,0:10:01.22,Default,,0,0,0,,Ой... Кешіріңіз.
Dialogue: 0,0:09:57.54,0:10:01.22,Default,,0,0,0,,Не туралы айтып тұрсың...
Dialogue: 0,0:10:01.22,0:10:04.05,Default,,0,0,0,,Мен де осында толық емес жұмыс күнімен жұмыс істеймін.
Dialogue: 0,0:10:04.05,0:10:07.22,Default,,0,0,0,,Міне... Иә?
Dialogue: 0,0:10:07.22,0:10:09.72,Default,,0,0,0,,Мен және Райо осындамыз, сондықтан қорықпаңыз.
Dialogue: 0,0:10:09.72,0:10:12.73,Default,,0,0,0,,Үйде
Dialogue: 0,0:10:09.72,0:10:12.73,Default,,0,0,0,,Ыңғайлы жұмыс орны
Dialogue: 0,0:10:12.73,0:10:16.23,Default,,0,0,0,,А... иә...
Dialogue: 0,0:10:12.73,0:10:16.23,Default,,0,0,0,,Сусын дайындап, тазалау кезінде...
Dialogue: 0,0:10:16.23,0:10:18.23,Default,,0,0,0,,《Мен жұмыс істегім келмейді, жұмыс істегім келмейді》
Dialogue: 0,0:10:18.23,0:10:21.24,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:10:18.23,0:10:21.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:21.24,0:10:28.74,Default,,0,0,0,,《Өзіңнен бас тарт! Бас тартыңыз!
Dialogue: 0,0:10:21.24,0:10:28.74,Default,,0,0,0,,Бас тартыңыз! 》
Dialogue: 0,0:10:28.74,0:10:31.75,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе
Dialogue: 0,0:10:28.74,0:10:31.75,Default,,0,0,0,,Шынымен!? Рақмет сізге!
Dialogue: 0,0:10:31.75,0:10:33.75,Default,,0,0,0,,《Кешіріңіз...
Dialogue: 0,0:10:33.75,0:10:36.25,Default,,0,0,0,,Бас тартуға батылыңыз жетсе
Dialogue: 0,0:10:33.75,0:10:36.25,Default,,0,0,0,,Менде комми синдромы жоқ》
Dialogue: 0,0:10:36.25,0:10:39.42,Default,,0,0,0,,Және
Dialogue: 0,0:10:36.25,0:10:39.42,Default,,0,0,0,,Мен топтың шығындарын басқарамын.
Dialogue: 0,0:10:39.42,0:10:43.26,Default,,0,0,0,,А, әлгі Рио-санға?
Dialogue: 0,0:10:39.42,0:10:43.26,Default,,0,0,0,,Оны сол жерде қалдырған дұрыс...
Dialogue: 0,0:10:43.26,0:10:45.26,Default,,0,0,0,,Сіз нені айтып тұрсыз!
Dialogue: 0,0:10:45.26,0:10:48.26,Default,,0,0,0,,Білесің бе, Бокчи-чан?
Dialogue: 0,0:10:45.26,0:10:48.26,Default,,0,0,0,,Рио осылай көрінеді➡︎
Dialogue: 0,0:10:48.26,0:10:50.86,Default,,0,0,0,,Ол көп шығындаушы.
Dialogue: 0,0:10:48.26,0:10:50.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:50.86,0:10:53.70,Default,,0,0,0,,Бай болу, қалталы болу
Dialogue: 0,0:10:50.86,0:10:53.70,Default,,0,0,0,,Мен көп ақша аламын➡︎
Dialogue: 0,0:10:53.70,0:10:57.20,Default,,0,0,0,,Маған үнемі ақша жетіспейді, өйткені мен бар ақшамды музыкалық аспаптарға жұмсаймын.
Dialogue: 0,0:10:57.20,0:10:59.21,Default,,0,0,0,,Теле…
Dialogue: 0,0:10:59.21,0:11:01.21,Default,,0,0,0,,Қай жерде комплимент сияқты естіледі?
Dialogue: 0,0:11:01.21,0:11:05.21,Default,,0,0,0,,Жақында
Dialogue: 0,0:11:01.21,0:11:05.21,Default,,0,0,0,,Жанды дауыста қайтадан өнер көрсетуге бар күшімізді салайық!
Dialogue: 0,0:11:05.21,0:11:08.05,Default,,0,0,0,,Жоғары мектеп оқушысы ретіндегі негізгі дебют!
Dialogue: 0,0:11:08.05,0:11:10.38,Default,,0,0,0,,Толық емес жұмыс келесі аптада басталады.
Dialogue: 0,0:11:10.38,0:11:14.39,Default,,0,0,0,,Сабақтан кейін тікелей менің үйіме бар.
Dialogue: 0,0:11:10.38,0:11:14.39,Default,,0,0,0,,Сау болыңыз
Dialogue: 0,0:11:14.39,0:11:16.39,Default,,0,0,0,,Иә))
Dialogue: 0,0:11:16.39,0:11:22.23,Default,,0,0,0,,《Сол толық емес жұмыс күнінің бірінші күні болды
Dialogue: 0,0:11:16.39,0:11:22.23,Default,,0,0,0,,Ертең жақындап қалды...
Dialogue: 0,0:11:22.23,0:11:27.23,Default,,0,0,0,,Мен 30 минут бойы жібідім.
Dialogue: 0,0:11:22.23,0:11:27.23,Default,,0,0,0,,Сіз міндетті түрде суық тиіп қалдыңыз, солай ма?
Dialogue: 0,0:11:27.23,0:11:32.07,Default,,0,0,0,,Ақыл-есіңді сақта.
Dialogue: 0,0:11:27.23,0:11:32.07,Default,,0,0,0,,Толық емес жұмыс күнімнен басқа қолымнан келгеннің бәрін жасаймын...》
Dialogue: 0,0:11:32.07,0:11:36.08,Default,,0,0,0,,Әй, анашым!
Dialogue: 0,0:11:32.07,0:11:36.08,Default,,0,0,0,,Үлкен апа батып бара жатыр!
Dialogue: 0,0:11:36.08,0:11:38.91,Default,,0,0,0,,♬︎(Гитара)
Dialogue: 0,0:11:38.91,0:11:43.25,Default,,0,0,0,,《Уау! суық тию суық тию
Dialogue: 0,0:11:38.91,0:11:43.25,Default,,0,0,0,,Суық ұстағыш Суық ұстағыш Суық ұстағыш➡︎
Dialogue: 0,0:11:43.25,0:11:47.25,Default,,0,0,0,,Суық тиіп қал! 》
Dialogue: 0,0:11:50.19,0:11:52.19,Default,,0,0,0,,(термометр дыбысы)
Dialogue: 0,0:11:52.19,0:11:54.19,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:54.19,0:11:56.86,Default,,0,0,0,,《Мен күшті денемді жек көремін.
Dialogue: 0,0:11:56.86,0:12:00.76,Default,,0,0,0,,Егер ол қазірдің өзінде солай болса
Dialogue: 0,0:11:56.86,0:12:00.76,Default,,0,0,0,,Ауырғандай кейіп көрсету...》
Dialogue: 0,0:11:56.86,0:12:00.76,Default,,0,0,0,,[Сыртында:063C95566807D5E7B51AB706426BEDF9]
Dialogue: 0,0:12:02.70,0:12:05.21,Default,,0,0,0,,《Ах Нижика-чан》
Dialogue: 0,0:12:05.21,0:12:08.21,Default,,0,0,0,,«Қайырлы таң! Бүгін менің толық емес жұмыс күнімнің бірінші күні.
Dialogue: 0,0:12:08.21,0:12:10.21,Default,,0,0,0,,Уайымдап жатқаныңызға сенімдімін.
Dialogue: 0,0:12:08.21,0:12:10.21,Default,,0,0,0,,Мен сізге дұрыс қараймын➡︎
Dialogue: 0,0:12:10.21,0:12:12.21,Default,,0,0,0,,Барымызды бірге жасайық! »
Dialogue: 0,0:12:12.21,0:12:18.22,Default,,0,0,0,,《Толық емес жұмыс күнімнің сақтық көшірмесін жасауға тырысатын маған
Dialogue: 0,0:12:12.21,0:12:18.22,Default,,0,0,0,,Осындай жылы сөздер》
Dialogue: 0,0:12:18.22,0:12:21.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:18.22,0:12:21.22,Default,,0,0,0,,[Сыртында:063C95566807D5E7B51AB706426BEDF9]
Dialogue: 0,0:12:23.22,0:12:26.89,Default,,0,0,0,,«Мен қандай ақымақпын.
Dialogue: 0,0:12:23.22,0:12:26.89,Default,,0,0,0,,Мен мұны байқадым
Dialogue: 0,0:12:26.89,0:12:29.90,Default,,0,0,0,,Мені түсінгені үшін
Dialogue: 0,0:12:26.89,0:12:29.90,Default,,0,0,0,,Мені лайықты адам еткені үшін➡︎
Dialogue: 0,0:12:29.90,0:12:32.90,Default,,0,0,0,,Сізге көп рахмет».
Dialogue: 0,0:12:32.90,0:12:35.30,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:12:38.26,0:12:41.26,Default,,0,0,0,,《Мен келдім...
Dialogue: 0,0:12:41.26,0:12:46.27,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе, барыңды істе
Dialogue: 0,0:12:41.26,0:12:46.27,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе, барын істе.》
Dialogue: 0,0:12:46.27,0:12:48.27,Default,,0,0,0,,Билеттерді сату
Dialogue: 0,0:12:46.27,0:12:48.27,Default,,0,0,0,,Сағат 5-те басталады.
Dialogue: 0,0:12:48.27,0:12:50.20,Default,,0,0,0,,Иә!?
Dialogue: 0,0:12:50.20,0:12:52.21,Default,,0,0,0,,Әзірге дайындық үстінде
Dialogue: 0,0:12:52.21,0:12:56.71,Default,,0,0,0,,《Мистер Қызметкерлер? А... Мен күдіктенемін
Dialogue: 0,0:12:52.21,0:12:56.71,Default,,0,0,0,,Мен түсінбеушілікті жоюым керек》
Dialogue: 0,0:12:56.71,0:12:58.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:58.71,0:13:01.88,Default,,0,0,0,,А, у... бір рет.
Dialogue: 0,0:12:58.71,0:13:01.88,Default,,0,0,0,,Очи Очи Очи Тынышталыңыз
Dialogue: 0,0:13:01.88,0:13:04.38,Default,,0,0,0,,Тынышталыңыз.
Dialogue: 0,0:13:04.38,0:13:08.22,Default,,0,0,0,,Сіз жаңа толық емес жұмыс күнінсіз бе?
Dialogue: 0,0:13:04.38,0:13:08.22,Default,,0,0,0,,Олай болса, басынан бастап айт.
Dialogue: 0,0:13:08.22,0:13:12.73,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:13:08.22,0:13:12.73,Default,,0,0,0,,Мен мұнда менеджермін, танысқаныма қуаныштымын.
Dialogue: 0,0:13:12.73,0:13:15.23,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:13:15.23,0:13:19.90,Default,,0,0,0,,《Менеджер, бұл аздап қорқынышты...
Dialogue: 0,0:13:15.23,0:13:19.90,Default,,0,0,0,,Мен бұл түрге жақсы емеспін. Ниджика-чан, өтінемін, тез кел.
Dialogue: 0,0:13:19.90,0:13:21.90,Default,,0,0,0,,Иә? Бұл...
Dialogue: 0,0:13:21.90,0:13:24.57,Default,,0,0,0,,Дәлірек айтсам, мен картон қорапта тікелей эфирге шықтым.
Dialogue: 0,0:13:21.90,0:13:24.57,Default,,0,0,0,,Ол гитарада ойнайтын бала.
Dialogue: 0,0:13:24.57,0:13:27.74,Default,,0,0,0,,Мен сенімдімін... Манго маскасы?
Dialogue: 0,0:13:27.74,0:13:31.91,Default,,0,0,0,,《Жаңа лақап ат?
Dialogue: 0,0:13:27.74,0:13:31.91,Default,,0,0,0,,Мен менеджерді жақсы көремін! 》
Dialogue: 0,0:13:31.91,0:13:34.92,Default,,0,0,0,,Мама... Бұл Манго Камен. Эххехе...
Dialogue: 0,0:13:34.92,0:13:36.92,Default,,0,0,0,,Бұл атау емес!
Dialogue: 0,0:13:36.92,0:13:40.25,Default,,0,0,0,,Үлкен әпке де
Dialogue: 0,0:13:36.92,0:13:40.25,Default,,0,0,0,,Маған кездейсоқ лақап аттарды бермеңіз
Dialogue: 0,0:13:40.25,0:13:42.92,Default,,0,0,0,,Біреу? Ниджика-чанның әпкесі!?
Dialogue: 0,0:13:42.92,0:13:47.09,Default,,0,0,0,,Мен мұны бұрын түсіндірдім бе?
Dialogue: 0,0:13:42.92,0:13:47.09,Default,,0,0,0,,Қараңдаршы, Старли қашан келеді
Dialogue: 0,0:13:42.92,0:13:47.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:47.09,0:13:50.86,Default,,0,0,0,,((Мен бүгін өнер көрсететін жанды үй
Dialogue: 0,0:13:47.09,0:13:50.86,Default,,0,0,0,,Жұлдызды➡︎ деп аталады
Dialogue: 0,0:13:50.86,0:13:54.20,Default,,0,0,0,,Менің әпкем
Dialogue: 0,0:13:50.86,0:13:54.20,Default,,0,0,0,,Мен ол жерде дүкен меңгерушісі болдым...
Dialogue: 0,0:13:54.20,0:13:57.70,Default,,0,0,0,,Дәлірек айтқанда, дүкеннің үстіндегі пәтерде.
Dialogue: 0,0:13:54.20,0:13:57.70,Default,,0,0,0,,Мен отбасыммен осында тұрамыз...
Dialogue: 0,0:13:57.70,0:14:00.54,Default,,0,0,0,,Ах
Dialogue: 0,0:13:57.70,0:14:00.54,Default,,0,0,0,,Жүрегім дүрсілдеп тыңдай алмадым))
Dialogue: 0,0:14:00.54,0:14:02.71,Default,,0,0,0,,Сонымен... Сонымен... Дұрыс.
Dialogue: 0,0:14:02.71,0:14:06.21,Default,,0,0,0,,Сондықтан
Dialogue: 0,0:14:02.71,0:14:06.21,Default,,0,0,0,,Бұлай қобалжымаңыз~
Dialogue: 0,0:14:06.21,0:14:09.72,Default,,0,0,0,,Сәлем, әпке
Dialogue: 0,0:14:06.21,0:14:09.72,Default,,0,0,0,,Сіз мені осы жерден менеджер деп атай аласыз.
Dialogue: 0,0:14:09.72,0:14:12.39,Default,,0,0,0,,Сондай-ақ, жұмысыңызға жеке сезімдеріңізді қоспаңыз.
Dialogue: 0,0:14:09.72,0:14:12.39,Default,,0,0,0,,Сәлем
Dialogue: 0,0:14:12.39,0:14:15.22,Default,,0,0,0,,Енді мені қорқытпа!
Dialogue: 0,0:14:15.22,0:14:19.06,Default,,0,0,0,,Ал, алдымен кестені тазалап алайық.
Dialogue: 0,0:14:19.06,0:14:25.23,Default,,0,0,0,,Осыдан кейін оны сүртіңіз...
Dialogue: 0,0:14:19.06,0:14:25.23,Default,,0,0,0,,Не? Ал Бокчи Чан ше?
Dialogue: 0,0:14:25.23,0:14:30.40,Default,,0,0,0,,Кешіріңіз, қараңғы және тар жерде.
Dialogue: 0,0:14:25.23,0:14:30.40,Default,,0,0,0,,Мен дем алғым келеді
Dialogue: 0,0:14:30.40,0:14:32.74,Default,,0,0,0,,Тыныс алыңыз!
Dialogue: 0,0:14:32.74,0:14:36.24,Default,,0,0,0,,Сонда, Бокчи-чан?
Dialogue: 0,0:14:32.74,0:14:36.24,Default,,0,0,0,,Осы жерде ішу керек пе?
Dialogue: 0,0:14:36.24,0:14:41.92,Default,,0,0,0,,Тоник суы осы жерден басталады
Dialogue: 0,0:14:36.24,0:14:41.92,Default,,0,0,0,,Сыра осы серверден.
Dialogue: 0,0:14:41.92,0:14:44.25,Default,,0,0,0,,Коктейльдер артқы сөреде...
Dialogue: 0,0:14:41.92,0:14:44.25,Default,,0,0,0,,Не?!
Dialogue: 0,0:14:44.25,0:14:46.75,Default,,0,0,0,,《Е, есімде жоқ, бұл өте жылдам!
Dialogue: 0,0:14:46.75,0:14:49.92,Default,,0,0,0,,Бір минут күтіңіз...
Dialogue: 0,0:14:49.92,0:14:54.19,Default,,0,0,0,,Уф, оны әнге айналдырыңыз
Dialogue: 0,0:14:49.92,0:14:54.19,Default,,0,0,0,,Сіз жасай алатын жалғыз нәрсе - денеңіз оны есте сақтауға мүмкіндік береді.
Dialogue: 0,0:14:54.19,0:14:56.20,Default,,0,0,0,,Е, оны қайдан алдың?
Dialogue: 0,0:14:56.20,0:14:59.03,Default,,0,0,0,,♬︎“Коктейль бұл…”
Dialogue: 0,0:14:56.20,0:14:59.03,Default,,0,0,0,,Е, қорқынышты, қорқынышты!
Dialogue: 0,0:14:59.03,0:15:01.03,Default,,0,0,0,,Миссия аяқталды
Dialogue: 0,0:14:59.03,0:15:01.03,Default,,0,0,0,,Сіз ➡︎ есте сақтағыңыз келеді
Dialogue: 0,0:15:01.03,0:15:04.71,Default,,0,0,0,,Мен қуаныштымын
Dialogue: 0,0:15:01.03,0:15:04.71,Default,,0,0,0,,Гитараны әзірше салайық.
Dialogue: 0,0:15:04.71,0:15:09.21,Default,,0,0,0,,А... алдыңғы тікелей эфир болды
Dialogue: 0,0:15:04.71,0:15:09.21,Default,,0,0,0,,Мен бұл жаман идея деп ойладым, бірақ...
Dialogue: 0,0:15:09.21,0:15:11.55,Default,,0,0,0,,Сен жақсысың~
Dialogue: 0,0:15:11.55,0:15:15.72,Default,,0,0,0,,《Нижика оны тоқтатуға тырысады.
Dialogue: 0,0:15:11.55,0:15:15.72,Default,,0,0,0,,Сіз байқамаған сияқтысыз➡︎
Dialogue: 0,0:15:15.72,0:15:19.22,Default,,0,0,0,,Бұл спектакльдің бір жердегі сезімі...》
Dialogue: 0,0:15:19.22,0:15:21.89,Default,,0,0,0,,Жұмыс
Dialogue: 0,0:15:19.22,0:15:21.89,Default,,0,0,0,,Неге мен?
Dialogue: 0,0:15:21.89,0:15:24.06,Default,,0,0,0,,Сусын қызметкерлері –➡︎
Dialogue: 0,0:15:24.06,0:15:26.39,Default,,0,0,0,,Тапсырыс берілген сусынды құйыңыз
Dialogue: 0,0:15:24.06,0:15:26.39,Default,,0,0,0,,Маған беріңізші
Dialogue: 0,0:15:26.39,0:15:28.40,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:15:28.40,0:15:30.90,Default,,0,0,0,,Билет бағасынан басқа
Dialogue: 0,0:15:28.40,0:15:30.90,Default,,0,0,0,,Сіз оны 500 иен ➡︎ төлеу арқылы ала аласыз
Dialogue: 0,0:15:30.90,0:15:33.23,Default,,0,0,0,,Бұл сусын билеті.
Dialogue: 0,0:15:33.23,0:15:38.24,Default,,0,0,0,,《Бір кесе 500 иен?
Dialogue: 0,0:15:33.23,0:15:38.24,Default,,0,0,0,,Неліктен таяқша жүйесі?
Dialogue: 0,0:15:38.24,0:15:41.24,Default,,0,0,0,,Өте ашық
Dialogue: 0,0:15:38.24,0:15:41.24,Default,,0,0,0,,Жалықтырған сияқты болма
Dialogue: 0,0:15:41.24,0:15:45.58,Default,,0,0,0,,Шын мәнінде, тірі үй
Dialogue: 0,0:15:41.24,0:15:45.58,Default,,0,0,0,,Бұл мейрамхана ретінде қарастырылады.
Dialogue: 0,0:15:41.24,0:15:45.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:45.58,0:15:49.08,Default,,0,0,0,,Мен шынымен түсінбеймін.
Dialogue: 0,0:15:45.58,0:15:49.08,Default,,0,0,0,,Тек өмір сүруге болатын жер➡︎
Dialogue: 0,0:15:49.08,0:15:52.02,Default,,0,0,0,,Кәсіпкерлік лицензия алу
Dialogue: 0,0:15:49.08,0:15:52.02,Default,,0,0,0,,Бұл өте қиын.
Dialogue: 0,0:15:52.02,0:15:55.52,Default,,0,0,0,,Сабыр сақта… Тек сабыр сақтасаң болғаны!
Dialogue: 0,0:15:52.02,0:15:55.52,Default,,0,0,0,,Сондықтан сусынды ұсыныңыз➡︎
Dialogue: 0,0:15:55.52,0:15:58.53,Default,,0,0,0,,Тек мейрамхана ретінде
Dialogue: 0,0:15:55.52,0:15:58.53,Default,,0,0,0,,Ол дүкен ашып жатыр.
Dialogue: 0,0:15:58.53,0:16:01.19,Default,,0,0,0,,Тыңдап отырсың ба?
Dialogue: 0,0:16:01.19,0:16:05.20,Default,,0,0,0,,《Мен... Мен мұны білмей тұрып
Dialogue: 0,0:16:01.19,0:16:05.20,Default,,0,0,0,,Көп күш жұмсауды талап ететін мейрамханадағы толық емес дебют➡︎
Dialogue: 0,0:16:05.20,0:16:07.20,Default,,0,0,0,,Не орындалды?
Dialogue: 0,0:16:07.20,0:16:10.54,Default,,0,0,0,,Мен өсіп жатырмын ба!?》
Dialogue: 0,0:16:10.54,0:16:14.88,Default,,0,0,0,,Аа, мен білмей тұрып
Dialogue: 0,0:16:10.54,0:16:14.88,Default,,0,0,0,,Тұтынушы кірді.
Dialogue: 0,0:16:14.88,0:16:19.05,Default,,0,0,0,,Бокчи-чан
Dialogue: 0,0:16:14.88,0:16:19.05,Default,,0,0,0,,Мен қазір бос боламын.
Dialogue: 0,0:16:14.88,0:16:19.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:19.05,0:16:23.22,Default,,0,0,0,,《Не? Сіз кенеттен тұтынушыларға қызмет көрсете бастадыңыз ба?
Dialogue: 0,0:16:19.05,0:16:23.22,Default,,0,0,0,,Мен не айтуым керек?
Dialogue: 0,0:16:23.22,0:16:27.39,Default,,0,0,0,,Бүгін күн жақсы.
Dialogue: 0,0:16:23.22,0:16:27.39,Default,,0,0,0,,Біздің дүкенге келіңіз... бұл басқаша!
Dialogue: 0,0:16:27.39,0:16:29.72,Default,,0,0,0,,Бір рет болса да құрғақ жүгіріс жасайық...
Dialogue: 0,0:16:29.72,0:16:32.23,Default,,0,0,0,,Аа, жоқ
Dialogue: 0,0:16:29.72,0:16:32.23,Default,,0,0,0,,Эй, күте тұр, күт! 》
Dialogue: 0,0:16:32.23,0:16:34.73,Default,,0,0,0,,Га
Dialogue: 0,0:16:32.23,0:16:34.73,Default,,0,0,0,,Бітті!
Dialogue: 0,0:16:34.73,0:16:37.40,Default,,0,0,0,,Кешіріңіз, кола беріңізші.
Dialogue: 0,0:16:37.40,0:16:39.90,Default,,0,0,0,,Иә. Бокчи-чан, кола!
Dialogue: 0,0:16:39.90,0:16:42.07,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:42.07,0:16:45.74,Default,,0,0,0,,I Джинджаел
Dialogue: 0,0:16:42.07,0:16:45.74,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:45.74,0:16:48.41,Default,,0,0,0,,Бокчи-чан
Dialogue: 0,0:16:45.74,0:16:48.41,Default,,0,0,0,,Бұл тұтынушыларға дөрекі!
Dialogue: 0,0:16:48.41,0:16:50.68,Default,,0,0,0,,Міне, міне, міне... Мен ойша дайындалдым...
Dialogue: 0,0:16:50.68,0:16:53.85,Default,,0,0,0,,《Тірі үйдің қараңғы атмосферасы
Dialogue: 0,0:16:50.68,0:16:53.85,Default,,0,0,0,,Жоғалған...》
Dialogue: 0,0:16:53.85,0:16:56.85,Default,,0,0,0,,Улонг шайы және хайбол
Dialogue: 0,0:16:56.85,0:16:58.85,Default,,0,0,0,,Дәретхана...
Dialogue: 0,0:16:58.85,0:17:00.85,Default,,0,0,0,,Артқы оң жаққа өтіңіз. Ол сол жақта!
Dialogue: 0,0:17:00.85,0:17:03.69,Default,,0,0,0,,《Соңында ештеңе жоқ
Dialogue: 0,0:17:00.85,0:17:03.69,Default,,0,0,0,,Ешқандай өсім болған жоқ.
Dialogue: 0,0:17:03.69,0:17:05.79,Default,,0,0,0,,Бокчи-чан, қарашы, қарашы!
Dialogue: 0,0:17:03.69,0:17:05.79,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:17:08.53,0:17:12.20,Default,,0,0,0,,Сәлем, бұл Александр!
Dialogue: 0,0:17:08.53,0:17:12.20,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:17:12.20,0:17:16.20,Default,,0,0,0,,Бұл топ өте жақсы, солай емес пе?
Dialogue: 0,0:17:12.20,0:17:16.20,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:17:16.20,0:17:20.37,Default,,0,0,0,,Демалуға болады
Dialogue: 0,0:17:16.20,0:17:20.37,Default,,0,0,0,,Тікелей эфир басталғаннан кейін менің бос уақытым болады.
Dialogue: 0,0:17:20.37,0:17:22.38,Default,,0,0,0,,А...
Dialogue: 0,0:17:20.37,0:17:22.38,Default,,0,0,0,,Ха... Уф...
Dialogue: 0,0:17:22.38,0:17:24.71,Default,,0,0,0,,Жақсы жұмыс! Қабылдау ше?
Dialogue: 0,0:17:24.71,0:17:27.21,Default,,0,0,0,,Дүкен менеджері мені ауыстырды.
Dialogue: 0,0:17:24.71,0:17:27.21,Default,,0,0,0,,
Dialogue: 0,0:17:27.21,0:17:29.22,Default,,0,0,0,,Бүгінгі топ
Dialogue: 0,0:17:27.21,0:17:29.22,Default,,0,0,0,,Олардың барлығы танымал➡︎
Dialogue: 0,0:17:29.22,0:17:31.22,Default,,0,0,0,,Көріңіз, себебі бұл тәрбиелік мәні бар.
Dialogue: 0,0:17:31.22,0:17:33.22,Default,,0,0,0,,Менің әпкем ол➡︎
Dialogue: 0,0:17:33.22,0:17:37.89,Default,,0,0,0,,Цун цун… цун тун тун тун тун тун тун тун тун тун тун
Dialogue: 0,0:17:33.22,0:17:37.89,Default,,0,0,0,,Ұнады ма...?
Dialogue: 0,0:17:37.89,0:17:40.06,Default,,0,0,0,,Цун көп
Dialogue: 0,0:17:37.89,0:17:40.06,Default,,0,0,0,,Техе
Dialogue: 0,0:17:40.06,0:17:43.56,Default,,0,0,0,,Сусу… Кешіріңіз.
Dialogue: 0,0:17:40.06,0:17:43.56,Default,,0,0,0,,Соғыс күші болудан алыс ➡︎
Dialogue: 0,0:17:43.56,0:17:45.90,Default,,0,0,0,,Мен тұтынушымен көз жанаса алмаймын.
Dialogue: 0,0:17:45.90,0:17:49.24,Default,,0,0,0,,Сіз мұны пайдаланасыз ба? Бұл манга емес
Dialogue: 0,0:17:49.24,0:17:51.17,Default,,0,0,0,,Қолданбаңыз Қолданбаңыз
Dialogue: 0,0:17:51.17,0:17:53.17,Default,,0,0,0,,Га
Dialogue: 0,0:17:53.17,0:17:57.68,Default,,0,0,0,,Жарайды! Бүгін бірінші күн
Dialogue: 0,0:17:53.17,0:17:57.68,Default,,0,0,0,,Тез үйреніп кетесің!
Dialogue: 0,0:17:57.68,0:18:00.85,Default,,0,0,0,,Уау... мен сияқты миджаның астында➡︎
Dialogue: 0,0:18:00.85,0:18:05.19,Default,,0,0,0,,Неліктен бұлай?
Dialogue: 0,0:18:00.85,0:18:05.19,Default,,0,0,0,,Маған мейірімді боласың ба?
Dialogue: 0,0:18:05.19,0:18:10.52,Default,,0,0,0,,Маған, мына тірі үй ұнайды.
Dialogue: 0,0:18:10.52,0:18:13.19,Default,,0,0,0,,Сондықтан тірі үйдегі қызметкерлер➡︎
Dialogue: 0,0:18:13.19,0:18:16.20,Default,,0,0,0,,Тұтынушылармен өзара әрекеттесу
Dialogue: 0,0:18:13.19,0:18:16.20,Default,,0,0,0,,Бұл жай ғана және қабылдау аймағы ➡︎
Dialogue: 0,0:18:16.20,0:18:20.20,Default,,0,0,0,,Бұл жақсы қорап болды.
Dialogue: 0,0:18:16.20,0:18:20.20,Default,,0,0,0,,Мен туралы ойлағаныңды қалаймын ➡︎
Dialogue: 0,0:18:20.20,0:18:22.20,Default,,0,0,0,,Әрқашан...
Dialogue: 0,0:18:22.20,0:18:26.54,Default,,0,0,0,,Сусу… Кешіріңіз.
Dialogue: 0,0:18:22.20,0:18:26.54,Default,,0,0,0,,Мұндай жерде тұтынушыларға нашар қызмет көрсету
Dialogue: 0,0:18:26.54,0:18:31.38,Default,,0,0,0,,Жоқ, жоқ... олай емес.
Dialogue: 0,0:18:26.54,0:18:31.38,Default,,0,0,0,,Мен де, Бокчи-чан➡︎
Dialogue: 0,0:18:31.38,0:18:33.71,Default,,0,0,0,,Бұл жақсы қорап болды.
Dialogue: 0,0:18:31.38,0:18:33.71,Default,,0,0,0,,Ойлануларыңызды қалаймын
Dialogue: 0,0:18:33.71,0:18:35.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:35.72,0:18:40.72,Default,,0,0,0,,Толық емес жұмыс уақытыңыздан ләззат алыңыз
Dialogue: 0,0:18:35.72,0:18:40.72,Default,,0,0,0,,Мен бірге... бірге көңіл көтергім келеді.
Dialogue: 0,0:18:40.72,0:18:43.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:43.72,0:18:47.73,Default,,0,0,0,,Бір күні мен күлемін
Dialogue: 0,0:18:43.72,0:18:47.73,Default,,0,0,0,,Тұтынушыларға қызмет көрсете білу➡︎
Dialogue: 0,0:18:47.73,0:18:50.66,Default,,0,0,0,,Мен мұны қалайтын нәрселер бар.
Dialogue: 0,0:18:50.66,0:18:53.17,Default,,0,0,0,,Ах! Бокчи-чан, басталып жатыр!
Dialogue: 0,0:18:53.17,0:18:59.01,Default,,0,0,0,,♬︎«Бүгін кешке де жазғы тілектеріңізді айтыңыз».
Dialogue: 0,0:18:59.01,0:19:02.18,Default,,0,0,0,,♬︎«Сиқырлы болып көріну».
Dialogue: 0,0:19:02.18,0:19:07.68,Default,,0,0,0,,《Өтетін жер біртұтас
Dialogue: 0,0:19:02.18,0:19:07.68,Default,,0,0,0,,Көрермендер де, орындаушылар да көңіл көтеріп жүргендей
Dialogue: 0,0:19:07.68,0:19:11.69,Default,,0,0,0,,Онымен салыстырғанда, менің өмірім...
Dialogue: 0,0:19:11.69,0:19:16.19,Default,,0,0,0,,Тұтынушы 2000 иен төледі.
Dialogue: 0,0:19:11.69,0:19:16.19,Default,,0,0,0,,Сіз оны көру үшін келдіңіз, солай ма?
Dialogue: 0,0:19:16.19,0:19:20.69,Default,,0,0,0,,Сол адамдарға
Dialogue: 0,0:19:16.19,0:19:20.69,Default,,0,0,0,,Мен қазіргідей➡︎
Dialogue: 0,0:19:20.69,0:19:25.37,Default,,0,0,0,,Келесі жолы да олардың тікелей эфирде тамаша шоу болатынына сенімдімін.
Dialogue: 0,0:19:25.37,0:19:31.20,Default,,0,0,0,,Біртіндеп өзгертуге күш салыңыз
Dialogue: 0,0:19:25.37,0:19:31.20,Default,,0,0,0,,Мен бірге көңіл көтергім келеді》
Dialogue: 0,0:19:31.20,0:19:33.21,Default,,0,0,0,,Кешіріңіз. Апельсин шырыны
Dialogue: 0,0:19:33.21,0:19:35.71,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:19:47.22,0:19:53.23,Default,,0,0,0,,《Күлімсіреп
Dialogue: 0,0:19:47.22,0:19:53.23,Default,,0,0,0,,Тұтынушының көзіне қараңыз... Тұтынушыға қызмет көрсету
Dialogue: 0,0:19:53.23,0:19:59.23,Default,,0,0,0,,Күлімсіреп
Dialogue: 0,0:19:53.23,0:19:59.23,Default,,0,0,0,,Тұтынушының көзіне қараңыз...Тұтынушыға қызмет көрсету》
Dialogue: 0,0:19:59.23,0:20:02.24,Default,,0,0,0,,Не... өтінемін...
Dialogue: 0,0:20:02.24,0:20:04.57,Default,,0,0,0,,Бокчи-чан! Көздер!
Dialogue: 0,0:20:04.57,0:20:06.57,Default,,0,0,0,,Рахмет Фуфу
Dialogue: 0,0:20:06.57,0:20:10.08,Default,,0,0,0,,Фу
Dialogue: 0,0:20:06.57,0:20:10.08,Default,,0,0,0,,Уау, мен қатты толқыдым.
Dialogue: 0,0:20:10.08,0:20:14.25,Default,,0,0,0,,Бірақ бұл таңқаларлық! Есептегіштен
Dialogue: 0,0:20:10.08,0:20:14.25,Default,,0,0,0,,Сіз өз бетіңізді көрсетіп, тұтынушыларға дұрыс қызмет көрсете алдыңыз.
Dialogue: 0,0:20:14.25,0:20:17.25,Default,,0,0,0,,А, мен қолымнан келгеннің бәрін жасадым.
Dialogue: 0,0:20:14.25,0:20:17.25,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:17.25,0:20:19.25,Default,,0,0,0,,Бокчи-чанға рахмет➡︎
Dialogue: 0,0:20:19.25,0:20:22.26,Default,,0,0,0,,Бүгінгі тікелей эфирге сенімдімін
Dialogue: 0,0:20:19.25,0:20:22.26,Default,,0,0,0,,Менде көбірек қызықты естеліктер бар.
Dialogue: 0,0:20:22.26,0:20:25.76,Default,,0,0,0,,Бокчи-чан да алға қадам.
Dialogue: 0,0:20:25.76,0:20:28.26,Default,,0,0,0,,Бір қадам…
Dialogue: 0,0:20:28.26,0:20:31.26,Default,,0,0,0,,(Қатты желдің дыбысы)
Dialogue: 0,0:20:31.26,0:20:34.26,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:20:36.77,0:20:38.94,Default,,0,0,0,,《Бір қадам!?
Dialogue: 0,0:20:38.94,0:20:42.44,Default,,0,0,0,,1000-ға жуық қадам
Dialogue: 0,0:20:38.94,0:20:42.44,Default,,0,0,0,,Мен әрі қарай қозғалуды ойладым~》
Dialogue: 0,0:20:42.44,0:20:45.14,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:47.28,0:20:50.22,Default,,0,0,0,,Олай болса, сен бүгін шаршадың.
Dialogue: 0,0:20:47.28,0:20:50.22,Default,,0,0,0,,(Ашидо) Хе-хе, Брекинг, Брекинг!
Dialogue: 0,0:20:50.22,0:20:52.72,Default,,0,0,0,,Сау болыңыз
Dialogue: 0,0:20:50.22,0:20:52.72,Default,,0,0,0,,Аа, еңбегіңіз үшін рахмет.
Dialogue: 0,0:20:52.72,0:20:54.72,Default,,0,0,0,,Не? Рау қайтып келмей ме?
Dialogue: 0,0:20:54.72,0:20:56.72,Default,,0,0,0,,Иә. Біраз уақыттан кейін үйде боламын.
Dialogue: 0,0:20:56.72,0:20:58.73,Default,,0,0,0,,Бокчи-чан!
Dialogue: 0,0:20:56.72,0:20:58.73,Default,,0,0,0,,А, иә, иә!
Dialogue: 0,0:20:58.73,0:21:05.23,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:20:58.73,0:21:05.23,Default,,0,0,0,,Иә. Ертең кездескенше.
Dialogue: 0,0:21:05.23,0:21:08.23,Default,,0,0,0,,《О, бітті~!
Dialogue: 0,0:21:08.23,0:21:10.74,Default,,0,0,0,,Әйтеуір күнімнен өттім!
Dialogue: 0,0:21:10.74,0:21:13.24,Default,,0,0,0,,Толық емес жұмыс күні күтпеген жерден
Dialogue: 0,0:21:10.74,0:21:13.24,Default,,0,0,0,,Мен мұны істей алатындай сезінемін.
Dialogue: 0,0:21:13.24,0:21:15.91,Default,,0,0,0,,Мен де ертең бар күшімді саламын! 》
Dialogue: 0,0:21:15.91,0:21:19.25,Default,,0,0,0,,Хакшин! иә?
Dialogue: 0,0:21:19.25,0:21:22.25,Default,,0,0,0,,Біз көп жұмыс жасадық.
Dialogue: 0,0:21:22.25,0:21:26.75,Default,,0,0,0,,Дұрыс~｡ Және
Dialogue: 0,0:21:22.25,0:21:26.75,Default,,0,0,0,,«Ертең кездескенше» дедіңіз
Dialogue: 0,0:21:26.75,0:21:28.76,Default,,0,0,0,,Иә
Dialogue: 0,0:21:28.76,0:21:31.26,Default,,0,0,0,,Топ құра алғанымызға қуаныштымын.
Dialogue: 0,0:21:31.26,0:21:34.59,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:31.26,0:21:34.59,Default,,0,0,0,,Бокчи-чанға арналған LOINE
Dialogue: 0,0:21:34.59,0:21:37.26,Default,,0,0,0,,Ертеңгі күнді де жасайық
Dialogue: 0,0:21:37.26,0:21:39.27,Default,,0,0,0,,(жөтел дауысы)
Dialogue: 0,0:21:39.27,0:21:44.27,Default,,0,0,0,,Хмм, қатты қызба.
Dialogue: 0,0:21:39.27,0:21:44.27,Default,,0,0,0,,Папа, маған мұз жастық жасап берші.
Dialogue: 0,0:21:44.27,0:21:46.27,Default,,0,0,0,,Мен сені ауруханаға апаруым керек пе?
Dialogue: 0,0:21:46.27,0:21:49.78,Default,,0,0,0,,《Мен... дәл қазір қызуым көтеріліп тұр...》
Dialogue: 0,0:21:46.27,0:21:49.78,Default,,0,0,0,,(жөтел дауысы)
Dialogue: 0,0:21:49.78,0:21:52.88,Default,,0,0,0,,Бокчи-чан да
Dialogue: 0,0:21:49.78,0:21:52.88,Default,,0,0,0,,Бұл сіздің ынтымақтастығыңызды білдіреді➡︎
Dialogue: 0,0:21:52.88,0:21:54.88,Default,,0,0,0,,Дегенмен, енді ғана не болды?
Dialogue: 0,0:21:54.88,0:21:58.22,Default,,0,0,0,,Жаңа вокалды табыңыз!
Dialogue: 0,0:21:58.22,0:22:00.72,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:22:00.72,0:22:04.22,Default,,0,0,0,,Иә, иә, мен, мен!
Dialogue: 0,0:22:05.72,0:22:11.72,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
