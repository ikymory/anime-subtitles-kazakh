Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:03:24.28,0:03:27.31,Default,,0,0,0,,Қарауға болады!
Dialogue: 0,0:03:27.31,0:03:31.51,Default,,0,0,0,,Хехехе, менің денем өсті!
Dialogue: 0,0:03:31.51,0:03:33.04,Default,,0,0,0,,Уфуфу...!
Dialogue: 0,0:03:33.04,0:03:36.74,Default,,0,0,0,,Mii Өте қызық!
Dialogue: 0,0:03:36.74,0:03:39.09,Default,,0,0,0,,Хехе, қызық болды!
Dialogue: 0,0:03:39.09,0:03:41.29,Default,,0,0,0,,Mii Келесі Мен алдамын!
Dialogue: 0,0:03:41.29,0:03:45.99,Default,,0,0,0,,Иә? Неліктен? Маған арқам ұнамайды!
Dialogue: 0,0:03:45.99,0:03:49.19,Default,,0,0,0,,Е, артта қалудан шаршадым!
Dialogue: 0,0:03:49.19,0:03:59.46,Default,,0,0,0,,«Свит сэр костюм сэр»
Dialogue: 0,0:03:59.46,0:04:04.34,Default,,0,0,0,,«Кунекуне даласы жасылға толы»
Dialogue: 0,0:04:04.34,0:04:09.06,Default,,0,0,0,,«Қара ешкінің лағы алғаш рет аспанға...»
Dialogue: 0,0:04:09.06,0:04:11.58,Default,,0,0,0,,О, дұрыс.
Dialogue: 0,0:04:11.58,0:04:15.79,Default,,0,0,0,,Қара теке мырза, сәби дүниеге келді.
Dialogue: 0,0:04:15.79,0:04:18.15,Default,,0,0,0,,Мен тойлауға баруым керек!
Dialogue: 0,0:04:18.15,0:04:22.36,Default,,0,0,0,,«Сары тәждер тізілген»
Dialogue: 0,0:04:22.36,0:04:27.41,Default,,0,0,0,,«Конкон Ояма Одуванчик Поппо»
Dialogue: 0,0:04:27.41,0:04:31.12,Default,,0,0,0,,Биыл да Конкон тауында бәйшешек гүлдеп тұрған сияқты.
Dialogue: 0,0:04:31.12,0:04:34.48,Default,,0,0,0,,Ертең барайық.
Dialogue: 0,0:04:34.48,0:04:39.36,Default,,0,0,0,,Ахаха бәрі қызық болатын сияқты!
Dialogue: 0,0:04:39.36,0:04:42.72,Default,,0,0,0,,Қарлығаш біз білмейтін нәрселерді біледі→
Dialogue: 0,0:04:42.72,0:04:44.91,Default,,0,0,0,,Бұл сізге көп нәрсені үйретеді!
Dialogue: 0,0:04:44.91,0:04:48.12,Default,,0,0,0,,Сонымен қатар, адамдар ешқашан өтірік айтпайды.
Dialogue: 0,0:04:48.12,0:04:50.47,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:04:50.47,0:04:54.47,Default,,0,0,0,,Әй, тағы ән айт!
Dialogue: 0,0:04:57.21,0:05:02.09,Default,,0,0,0,,Қарлығаш мырза Қарлығаш мырза Ей, ән сал, ән сал!
Dialogue: 0,0:05:02.09,0:05:06.46,Default,,0,0,0,,Хахаха... Мүмкін емес Мүмкін емес!
Dialogue: 0,0:05:06.46,0:05:09.17,Default,,0,0,0,,Олар бізді мүлде тыңдамайды.
Dialogue: 0,0:05:09.17,0:05:12.17,Default,,0,0,0,,Иә? Неліктен? Мен білмеймін.
Dialogue: 0,0:05:16.73,0:05:19.60,Default,,0,0,0,,Біз ән айтқымыз келгенде ән айтамыз.
Dialogue: 0,0:05:19.60,0:05:23.14,Default,,0,0,0,,Сол кезде Қарлығаштың көп әндерін тыңдай аласыз!
Dialogue: 0,0:05:23.14,0:05:27.01,Default,,0,0,0,,Рас! ? Қандай ән екенін асыға күтемін!
Dialogue: 0,0:05:27.01,0:05:29.01,Default,,0,0,0,,Хехехе, дәл солай!
Dialogue: 0,0:05:33.07,0:05:36.27,Default,,0,0,0,,Әй, қарлығаш әні ше?
Dialogue: 0,0:05:36.27,0:05:39.29,Default,,0,0,0,,Ғабу туралы естімедің бе?
Dialogue: 0,0:05:39.29,0:05:41.65,Default,,0,0,0,,Жоқ. Мен қарлығашты жедім ...
Dialogue: 0,0:05:41.65,0:05:45.03,Default,,0,0,0,,О, жоқ, мен қарлығашпен ешқашан сөйлескен емеспін!
Dialogue: 0,0:05:45.03,0:05:50.58,Default,,0,0,0,,Хехехе Құстар ән салады, бірақ көп сөйлемейді.
Dialogue: 0,0:05:50.58,0:05:52.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:52.43,0:05:56.80,Default,,0,0,0,,Біз бұл жерден қатар жүре алмаймыз.
Dialogue: 0,0:05:56.80,0:05:58.82,Default,,0,0,0,,Мэйден келіңізші.
Dialogue: 0,0:05:58.82,0:06:02.03,Default,,0,0,0,,Сіз сенімдісіз бе? Өтінемін, өтінемін!
Dialogue: 0,0:06:02.03,0:06:06.03,Default,,0,0,0,,《Бұл сәтсіз аяқталды》
Dialogue: 0,0:06:09.26,0:06:12.26,Default,,0,0,0,,《Мм... Дәмді көрінеді! 》
Dialogue: 0,0:06:14.65,0:06:19.03,Default,,0,0,0,,《Даа! Дос болып көрінуге қалай батылы бардың! 》
Dialogue: 0,0:06:19.03,0:06:21.55,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:06:21.55,0:06:24.91,Default,,0,0,0,,《Жоқ! Бұл не қоңырау? 》
Dialogue: 0,0:06:24.91,0:06:28.95,Default,,0,0,0,,Бұл жігіт! Бұл жақсы емес! (Іштің ырылдаған дыбысы)
Dialogue: 0,0:06:28.95,0:06:31.65,Default,,0,0,0,,Не болды? осу?
Dialogue: 0,0:06:31.65,0:06:33.01,Default,,0,0,0,,Ах, бұл...
Dialogue: 0,0:06:33.01,0:06:38.22,Default,,0,0,0,,мамыр! Мен, досым, сені ешқашан мұңайтпаймын.
Dialogue: 0,0:06:38.22,0:06:40.74,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:06:40.74,0:06:43.26,Default,,0,0,0,,Мен мүлдем...
Dialogue: 0,0:06:43.26,0:06:46.96,Default,,0,0,0,,Мен білемін. осу?
Dialogue: 0,0:06:46.96,0:06:48.48,Default,,0,0,0,,Мен нақты білемін.
Dialogue: 0,0:06:48.48,0:06:52.02,Default,,0,0,0,,Ғабу достарын ренжітетін ештеңе жасамайды.
Dialogue: 0,0:06:52.02,0:06:55.89,Default,,0,0,0,,Ғабу мейірімді.
Dialogue: 0,0:06:55.89,0:06:58.75,Default,,0,0,0,,Сіз білесіз бе? Иә мен білемін.
Dialogue: 0,0:06:58.75,0:07:00.61,Default,,0,0,0,,Біз дос емеспіз бе?
Dialogue: 0,0:07:00.61,0:07:03.61,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:07:13.56,0:07:17.77,Default,,0,0,0,,Уау! Қандай тамаша көрініс!
Dialogue: 0,0:07:17.77,0:07:20.31,Default,,0,0,0,,Жақсы сезінеді.
Dialogue: 0,0:07:20.31,0:07:26.70,Default,,0,0,0,,«Хюруру, хюруру, мен суық тиіп қалдым».
Dialogue: 0,0:07:26.70,0:07:31.92,Default,,0,0,0,,«Хюруру, хюруру, тіпті оны көрмесең де»
Dialogue: 0,0:07:31.92,0:07:37.14,Default,,0,0,0,,«Хюруру, хюруру, мен суық тиіп қалдым».
Dialogue: 0,0:07:37.14,0:07:43.14,Default,,0,0,0,,«Хюуруру, мен әрқашан сенің жаныңдамын».
Dialogue: 0,0:07:45.06,0:07:49.93,Default,,0,0,0,,«Хюруру Хюруру төбеде ән айту»
Dialogue: 0,0:07:49.93,0:07:51.95,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:51.95,0:07:55.32,Default,,0,0,0,,«Мей мен Ғабу төбеде ән салады»
Dialogue: 0,0:07:55.32,0:07:59.19,Default,,0,0,0,,«Ғаб – қасқыр, Мей – ешкі»
Dialogue: 0,0:07:59.19,0:08:03.06,Default,,0,0,0,,«Мей мен Ғабу жақсы достар».
Dialogue: 0,0:08:03.06,0:08:06.10,Default,,0,0,0,,«Свит сэр костюм сэр»
Dialogue: 0,0:08:06.10,0:08:09.63,Default,,0,0,0,,ше? Ол қатты! сурет? Бұл қиын!
Dialogue: 0,0:08:09.63,0:08:12.49,Default,,0,0,0,,Сәл күте тұрыңдар, қарлығаштар!
Dialogue: 0,0:08:12.49,0:08:15.69,Default,,0,0,0,,Сіз бұл әнді айтатыныңызға сенімдісіз бе?
Dialogue: 0,0:08:15.69,0:08:19.23,Default,,0,0,0,,«Қасқыр мен ешкі жақсы дос».
Dialogue: 0,0:08:19.23,0:08:23.94,Default,,0,0,0,,Жоқ. Бұл басқаша.
Dialogue: 0,0:08:23.94,0:08:25.96,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:08:25.96,0:08:29.16,Default,,0,0,0,,«Мей мен Ғабу Ғабу мен Мей»
Dialogue: 0,0:08:29.16,0:08:31.35,Default,,0,0,0,,Қараңдар, қараңдар!
Dialogue: 0,0:08:31.35,0:08:35.22,Default,,0,0,0,,Дәмді көрінетін ешкі, мен сені жеймін!
Dialogue: 0,0:08:35.22,0:08:38.08,Default,,0,0,0,,Кя, жоқ! маған көмектесші!
Dialogue: 0,0:08:38.08,0:08:41.78,Default,,0,0,0,,Тоқта, күт! Кя, мен жей аламын!
Dialogue: 0,0:08:41.78,0:08:45.49,Default,,0,0,0,,«Өзіміз айта алатын әнді айтайық».
Dialogue: 0,0:08:45.49,0:08:49.69,Default,,0,0,0,,«Чичи мен Пиппи әнін айтайық»
Dialogue: 0,0:08:49.69,0:08:51.54,Default,,0,0,0,,Міне... күтіңіз!
Dialogue: 0,0:08:51.54,0:08:53.54,Default,,0,0,0,,Барма!
Dialogue: 0,0:09:02.99,0:09:06.53,Default,,0,0,0,,Қайда? Қайда бардың?
Dialogue: 0,0:09:06.53,0:09:09.06,Default,,0,0,0,,«Мей мен Ғабу жақсы достар».
Dialogue: 0,0:09:09.06,0:09:11.08,Default,,0,0,0,,Сол ән...
Dialogue: 0,0:09:11.08,0:09:13.10,Default,,0,0,0,,Кеттік, Ғабу.
Dialogue: 0,0:09:13.10,0:09:15.29,Default,,0,0,0,,мамыр! сурет?
Dialogue: 0,0:09:15.29,0:09:18.48,Default,,0,0,0,,Бөлініп, ізденуіміз керек.
Dialogue: 0,0:09:18.48,0:09:20.83,Default,,0,0,0,,Бұл жақсы. сурет?
Dialogue: 0,0:09:20.83,0:09:24.71,Default,,0,0,0,,Бірге ізденсек, дос болып кеттік.
Dialogue: 0,0:09:24.71,0:09:26.06,Default,,0,0,0,,Ах.
Dialogue: 0,0:09:26.06,0:09:28.58,Default,,0,0,0,,Кездесуді сәл қалдырған дұрыс.
Dialogue: 0,0:09:28.58,0:09:31.94,Default,,0,0,0,,Бұл жақсы болуы мүмкін.
Dialogue: 0,0:09:31.94,0:09:34.14,Default,,0,0,0,,А... Иә, солай.
Dialogue: 0,0:09:34.14,0:09:38.01,Default,,0,0,0,,Мен сол қарлығашты міндетті түрде табамын.
Dialogue: 0,0:09:38.01,0:09:41.38,Default,,0,0,0,,Жарайды, мен де табамын.
Dialogue: 0,0:09:41.38,0:09:45.75,Default,,0,0,0,,«Өзіміз айта алатын әнді айтайық».
Dialogue: 0,0:09:45.75,0:09:49.75,Default,,0,0,0,,«Чичи мен Пиппи әнін айтайық»
Dialogue: 0,0:09:51.81,0:09:53.67,Default,,0,0,0,,Мии!
Dialogue: 0,0:09:53.67,0:09:56.86,Default,,0,0,0,,Қарлығаштарды көрмедің бе? Уф.
Dialogue: 0,0:09:56.86,0:10:01.07,Default,,0,0,0,,Ей, ағып жатқан ағысқа барайық. Кеттік, кеттік!
Dialogue: 0,0:10:01.07,0:10:05.78,Default,,0,0,0,,Ах... менде бәрі жақсы. Өйткені баратын жерім бар.
Dialogue: 0,0:10:05.78,0:10:07.14,Default,,0,0,0,,Иә, бұл ұят.
Dialogue: 0,0:10:07.14,0:10:10.17,Default,,0,0,0,,Мұнда қарлығаш көп жиналып тұрған сияқты.
Dialogue: 0,0:10:10.17,0:10:12.52,Default,,0,0,0,,Қарлығаш?
Dialogue: 0,0:10:12.52,0:10:15.39,Default,,0,0,0,,Ах. Қызық ән тыңдайтын сияқтымын
Dialogue: 0,0:10:15.39,0:10:17.41,Default,,0,0,0,,үшін өз жолында.
Dialogue: 0,0:10:17.41,0:10:20.43,Default,,0,0,0,,Қызықты әндер тыңдай аламын деп ойлайсың ба?
Dialogue: 0,0:10:20.43,0:10:22.79,Default,,0,0,0,,А... Мамыр?
Dialogue: 0,0:10:22.79,0:10:24.14,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:24.14,0:10:28.84,Default,,0,0,0,,Онда біз асығуымыз керек!
Dialogue: 0,0:10:28.84,0:10:30.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:36.59,0:10:39.45,Default,,0,0,0,,Тоқта, күт, күт!
Dialogue: 0,0:10:39.45,0:10:42.32,Default,,0,0,0,,О, Мэй Чан. Ол қазірдің өзінде басталды.
Dialogue: 0,0:10:42.32,0:10:46.19,Default,,0,0,0,,Иә? Басталды ма?
Dialogue: 0,0:10:46.19,0:10:51.57,Default,,0,0,0,,«Свит сэр костюм сэр»
Dialogue: 0,0:10:51.57,0:10:53.60,Default,,0,0,0,,«Қара ешкі мырза осылай дейді».
Dialogue: 0,0:10:53.60,0:10:56.13,Default,,0,0,0,,«Қазіргі уақытта сәнді: оң қолмен ағын»
Dialogue: 0,0:10:56.13,0:10:58.13,Default,,0,0,0,,О, дұрыс айтасың.
Dialogue: 0,0:11:01.01,0:11:04.71,Default,,0,0,0,,О, бұл балалар емес еді.
Dialogue: 0,0:11:04.71,0:11:07.74,Default,,0,0,0,,А, жақсы.
Dialogue: 0,0:11:07.74,0:11:10.77,Default,,0,0,0,,Ха, жоқ, бұл мүлдем жақсы емес!
Dialogue: 0,0:11:10.77,0:11:13.80,Default,,0,0,0,,Ах.
Dialogue: 0,0:11:13.80,0:11:16.66,Default,,0,0,0,,Ғаб, қайда бара жатырсың? Барри мырза!
Dialogue: 0,0:11:16.66,0:11:20.70,Default,,0,0,0,,Эй, мен аң аулауға барамын.
Dialogue: 0,0:11:20.70,0:11:24.74,Default,,0,0,0,,Аңға алдын ала қарауды іздеп жүрсіз бе? Сосын мен сенімен барамын.
Dialogue: 0,0:11:24.74,0:11:29.79,Default,,0,0,0,,Жоқ, мен барып тексеремін.
Dialogue: 0,0:11:29.79,0:11:31.82,Default,,0,0,0,,О? сондықтан?
Dialogue: 0,0:11:31.82,0:11:35.52,Default,,0,0,0,,Сонымен бірге... а?
Dialogue: 0,0:11:35.52,0:11:38.89,Default,,0,0,0,,Мм, Барри. Не?
Dialogue: 0,0:11:38.89,0:11:42.58,Default,,0,0,0,,Маған құстарды ұстаудың жақсы әдісін үйретсеңші.
Dialogue: 0,0:11:42.58,0:11:46.96,Default,,0,0,0,,Құс? Сіз құстарды жегіңіз келе ме? сен.
Dialogue: 0,0:11:46.96,0:11:50.66,Default,,0,0,0,,Эй, мен қызықпын.
Dialogue: 0,0:11:50.66,0:11:54.71,Default,,0,0,0,,Мм, құстарды ұстау қиын.
Dialogue: 0,0:11:54.71,0:11:57.90,Default,,0,0,0,,Дәмі жаман емес.
Dialogue: 0,0:11:57.90,0:12:00.27,Default,,0,0,0,,Жоқ, эй, сен.
Dialogue: 0,0:12:00.27,0:12:03.80,Default,,0,0,0,,Құстарды іздеуге барғың келе ме?
Dialogue: 0,0:12:03.80,0:12:06.80,Default,,0,0,0,,Мәселе мынада.
Dialogue: 0,0:12:11.38,0:12:18.78,Default,,0,0,0,,«Хюруру Хюруру төбеде ән айту»
Dialogue: 0,0:12:18.78,0:12:26.52,Default,,0,0,0,,«Мей мен Ғабу төбеде ән салады»
Dialogue: 0,0:12:26.52,0:12:34.45,Default,,0,0,0,,«Мей мен Ғабу төбеде ән салады»
Dialogue: 0,0:12:34.45,0:12:43.19,Default,,0,0,0,,«Мей мен Ғабу жақсы достар».
Dialogue: 0,0:12:43.19,0:12:45.39,Default,,0,0,0,,Қарлығаш мырза, бұл дұрыс емес!
Dialogue: 0,0:12:45.39,0:12:48.08,Default,,0,0,0,,Бұл ән дұрыс емес.
Dialogue: 0,0:12:48.08,0:12:53.46,Default,,0,0,0,,Қасқыр дегеніміз не? Мен қасқырмен дос емеспін.
Dialogue: 0,0:12:53.46,0:12:56.46,Default,,0,0,0,,Сондықтан ол әнді айтпа!
Dialogue: 0,0:12:59.36,0:13:03.23,Default,,0,0,0,,«Чичи мен Пиппи әнін айтайық»
Dialogue: 0,0:13:03.23,0:13:08.45,Default,,0,0,0,,«Hyururu Hyururu әнін айтайық»
Dialogue: 0,0:13:08.45,0:13:12.45,Default,,0,0,0,,Күте тұрыңыз! Күте тұрыңыз!
Dialogue: 0,0:13:18.71,0:13:22.42,Default,,0,0,0,,Бұл иіс қоян!
Dialogue: 0,0:13:22.42,0:13:24.78,Default,,0,0,0,,Қоян! (Іштің ырылдаған дыбысы)
Dialogue: 0,0:13:24.78,0:13:27.47,Default,,0,0,0,,Жоқ, жоқ, жоқ.
Dialogue: 0,0:13:27.47,0:13:30.47,Default,,0,0,0,,Қоянды қуатын кез емес, енді қарлығаш бірінші келеді.
Dialogue: 0,0:15:08.65,0:15:15.38,Default,,0,0,0,,«Мей мен Ғабу төбеде ән салады»
Dialogue: 0,0:15:15.38,0:15:18.92,Default,,0,0,0,,Қарлығаш мырза! Ал, тыңда.
Dialogue: 0,0:15:18.92,0:15:21.45,Default,,0,0,0,,Мен қасқырлармен дос емеспін.
Dialogue: 0,0:15:21.45,0:15:25.99,Default,,0,0,0,,«Ешкі қасқырдың достары»
Dialogue: 0,0:15:25.99,0:15:30.53,Default,,0,0,0,,«Қасқыр ешкі ешкі әні»
Dialogue: 0,0:15:30.53,0:15:33.23,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:15:33.23,0:15:36.93,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:15:36.93,0:15:38.95,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:38.95,0:15:46.85,Default,,0,0,0,,Мені тыңдаңыз, Қарлығаш мырза...
Dialogue: 0,0:15:46.85,0:15:48.85,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:15:53.09,0:15:56.96,Default,,0,0,0,,Әй, қария... (Іштің дірілдеген дыбысы)
Dialogue: 0,0:15:56.96,0:15:59.15,Default,,0,0,0,,Бұл ешкі!
Dialogue: 0,0:15:59.15,0:16:02.68,Default,,0,0,0,,Сонымен, жоқ, жоқ, жоқ!
Dialogue: 0,0:16:02.68,0:16:05.55,Default,,0,0,0,,Енді мен қарлығаштарды қуып келемін!
Dialogue: 0,0:16:05.55,0:16:08.74,Default,,0,0,0,,Иә? ешкі?
Dialogue: 0,0:16:08.74,0:16:12.62,Default,,0,0,0,,«Габ — қасқыр, ешкі — Мей»
Dialogue: 0,0:16:12.62,0:16:16.66,Default,,0,0,0,,«Ғажайып, таңқаларлық, таңқаларлық Мэй»
Dialogue: 0,0:16:16.66,0:16:21.37,Default,,0,0,0,,«Жоқ, жоқ, жоқ».
Dialogue: 0,0:16:21.37,0:16:24.24,Default,,0,0,0,,иә иә….
Dialogue: 0,0:16:24.24,0:16:27.27,Default,,0,0,0,,Тек мені тыңдаңыз!
Dialogue: 0,0:16:27.27,0:16:32.15,Default,,0,0,0,,«Жұмбақ, жұмбақ, Бороборомай»
Dialogue: 0,0:16:32.15,0:16:35.02,Default,,0,0,0,,«Жұмбақ, ғажап, жапырақты ешкі»
Dialogue: 0,0:16:35.02,0:16:39.05,Default,,0,0,0,,«Жапырақ ешкі жапырағы ешкі»
Dialogue: 0,0:16:39.05,0:16:42.76,Default,,0,0,0,,«Бороборо Мей - жапырақ ешкі».
Dialogue: 0,0:16:42.76,0:16:46.29,Default,,0,0,0,,Хмф, мен жапырақ ешкіге қарсы емеспін.
Dialogue: 0,0:16:46.29,0:16:49.83,Default,,0,0,0,,Бірақ бұл ән басқа.
Dialogue: 0,0:16:49.83,0:16:53.86,Default,,0,0,0,,Қасқыр мен достығым туралы ән →
Dialogue: 0,0:16:53.86,0:16:55.72,Default,,0,0,0,,Бұл қате.
Dialogue: 0,0:16:55.72,0:16:57.07,Default,,0,0,0,,Сондықтан ән айтпа.
Dialogue: 0,0:16:57.07,0:17:03.46,Default,,0,0,0,,«Мей мен Ғабу төбеде ән салады»
Dialogue: 0,0:17:03.46,0:17:06.16,Default,,0,0,0,,Сондықтан ол басқаша!
Dialogue: 0,0:17:06.16,0:17:11.05,Default,,0,0,0,,«Қасқыр мен ешкі ешкі ешкі Қасқыр Мей мен Ғабу»
Dialogue: 0,0:17:11.05,0:17:16.26,Default,,0,0,0,,Өйткені қасқыр мен ешкі дос бола алмайды!
Dialogue: 0,0:17:16.26,0:17:19.79,Default,,0,0,0,,Қасқыр ешкіні жейді, солай ма?
Dialogue: 0,0:17:19.79,0:17:22.99,Default,,0,0,0,,Біз қалай дос бола аламыз?
Dialogue: 0,0:17:22.99,0:17:26.19,Default,,0,0,0,,«Габ - қасқыр, Киба Гирара»
Dialogue: 0,0:17:26.19,0:17:29.39,Default,,0,0,0,,«Габ – қасқыр, ешкі – жем»
Dialogue: 0,0:17:29.39,0:17:32.42,Default,,0,0,0,,«Ғаб – қасқыр, Мей – жем».
Dialogue: 0,0:17:32.42,0:17:35.95,Default,,0,0,0,,«Габ қасқыр Мейді жейді»
Dialogue: 0,0:17:35.95,0:17:39.16,Default,,0,0,0,,«Габ менің досым, Мей жейді».
Dialogue: 0,0:17:39.16,0:17:46.89,Default,,0,0,0,,«Мей - дәмді габ тағамы».
Dialogue: 0,0:17:46.89,0:17:49.76,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:17:49.76,0:17:53.80,Default,,0,0,0,,Уайымдамаңыз! Ғабу туралы көп білмесем де.
Dialogue: 0,0:17:53.80,0:17:56.66,Default,,0,0,0,,«Сіз білмесеңіз де?»
Dialogue: 0,0:17:56.66,0:17:59.69,Default,,0,0,0,,«Бұл Ғабу болса да?»
Dialogue: 0,0:17:59.69,0:18:03.06,Default,,0,0,0,,Ғабу мейірімді, өте мейірімді →
Dialogue: 0,0:18:03.06,0:18:08.11,Default,,0,0,0,,Ол қамқор және менің ең қымбатты досым!
Dialogue: 0,0:18:08.11,0:18:11.47,Default,,0,0,0,,«Маңызды, маңызды»
Dialogue: 0,0:18:11.47,0:18:15.18,Default,,0,0,0,,«Габ Мей үшін маңызды»
Dialogue: 0,0:18:15.18,0:18:20.90,Default,,0,0,0,,Уау! Жоқ, қазір басқаша!
Dialogue: 0,0:18:20.90,0:18:23.76,Default,,0,0,0,,"А?
Dialogue: 0,0:18:23.76,0:18:25.12,Default,,0,0,0,,«Ритм қышиды...»
Dialogue: 0,0:18:25.12,0:18:29.15,Default,,0,0,0,,Ум... 1 2/3!
Dialogue: 0,0:18:29.15,0:18:31.18,Default,,0,0,0,,Мен сені жібермеймін.
Dialogue: 0,0:18:31.18,0:18:39.58,Default,,0,0,0,,«Ғабу қасқыр ма, қасқыр ешкі ме?».
Dialogue: 0,0:18:39.58,0:18:41.28,Default,,0,0,0,,Бірдеңе дұрыс емес пе?
Dialogue: 0,0:18:41.28,0:18:44.64,Default,,0,0,0,,Біртүрлі нәрсе бар ма?
Dialogue: 0,0:18:44.64,0:18:47.00,Default,,0,0,0,,Иә? Міне, анау, мынау! ?
Dialogue: 0,0:18:47.00,0:18:49.00,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:55.25,0:18:57.77,Default,,0,0,0,,Уф.
Dialogue: 0,0:18:57.77,0:19:02.82,Default,,0,0,0,,(Алау)
Dialogue: 0,0:19:02.82,0:19:06.52,Default,,0,0,0,,А, бұл дауыс. Амал жоқ, амал жоқ….
Dialogue: 0,0:19:06.52,0:19:09.52,Default,,0,0,0,,Чичи қасқыр! О, күт!
Dialogue: 0,0:19:11.07,0:19:13.43,Default,,0,0,0,,Читчи читчи!
Dialogue: 0,0:19:13.43,0:19:15.28,Default,,0,0,0,,(Алау)
Dialogue: 0,0:19:15.28,0:19:19.28,Default,,0,0,0,,Менің достарым мені алып кетуге келеді деп үміттенемін.
Dialogue: 0,0:19:23.86,0:19:26.55,Default,,0,0,0,,Ах. Аа, ояусың ба?
Dialogue: 0,0:19:26.55,0:19:28.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:28.08,0:19:31.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:31.44,0:19:35.31,Default,,0,0,0,,Оянсаң, мені тыңдағаныңды қалаймын.
Dialogue: 0,0:19:35.31,0:19:38.51,Default,,0,0,0,,Сол әнді айтуды доғарса екен.
Dialogue: 0,0:19:38.51,0:19:40.03,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:19:40.03,0:19:42.72,Default,,0,0,0,,Ах! А... жоқ жоқ, бәрі жақсы.
Dialogue: 0,0:19:42.72,0:19:46.59,Default,,0,0,0,,Мен сені жемеймін.
Dialogue: 0,0:19:46.59,0:19:48.11,Default,,0,0,0,,Егер мен сені жесем...
Dialogue: 0,0:19:48.11,0:19:53.83,Default,,0,0,0,,Читчи читчи! Пиппи пиппи!
Dialogue: 0,0:19:53.83,0:19:55.02,Default,,0,0,0,,Чичи!
Dialogue: 0,0:19:55.02,0:20:00.90,Default,,0,0,0,,«Міне, міне, сен жараланыпсың».
Dialogue: 0,0:20:00.90,0:20:05.95,Default,,0,0,0,,«Чичи жақсы, ауырмайды».
Dialogue: 0,0:20:05.95,0:20:09.49,Default,,0,0,0,,«Мен қасқырдың қорқынышты дауысын естідім».
Dialogue: 0,0:20:09.49,0:20:13.53,Default,,0,0,0,,«Чичиге қасқыр шабуыл жасады».
Dialogue: 0,0:20:13.53,0:20:16.55,Default,,0,0,0,,«Бітті.»
Dialogue: 0,0:20:16.55,0:20:20.43,Default,,0,0,0,,«Мен жылап жатырмын, сені енді көре алмаймын».
Dialogue: 0,0:20:20.43,0:20:22.12,Default,,0,0,0,,«Мен сені енді көре алмаймын»
Dialogue: 0,0:20:22.12,0:20:27.33,Default,,0,0,0,,«Қасқыр кездессем, сені енді ешқашан көрмеймін».
Dialogue: 0,0:20:27.33,0:20:31.87,Default,,0,0,0,,«Бірақ біртүрлі, бірақ біртүрлі».
Dialogue: 0,0:20:31.87,0:20:36.75,Default,,0,0,0,,«Қасқырлар қорқынышты, олар шабуыл жасамайды».
Dialogue: 0,0:20:36.75,0:20:40.96,Default,,0,0,0,,«Мен қорқамын, бірақ маған шабуыл жасамайсың ба?
Dialogue: 0,0:20:40.96,0:20:45.96,Default,,0,0,0,,«Қорқынышты қасқыр, жұмсақ қасқыр»
Dialogue: 0,0:20:47.20,0:20:49.39,Default,,0,0,0,,А, мен таптым!
Dialogue: 0,0:20:49.39,0:20:53.93,Default,,0,0,0,,«Достар қайғырады, оларға шабуыл жасамаңыз».
Dialogue: 0,0:20:53.93,0:20:59.98,Default,,0,0,0,,Тыңдашы, өтінемін, ол әнді айтпа.
Dialogue: 0,0:20:59.98,0:21:03.19,Default,,0,0,0,,«Чичи ән айтады, мен ән айтқым келеді».
Dialogue: 0,0:21:03.19,0:21:08.57,Default,,0,0,0,,«Пиппи де достық әнін айтады»
Dialogue: 0,0:21:08.57,0:21:10.43,Default,,0,0,0,,Қарлығаш мырза.
Dialogue: 0,0:21:10.43,0:21:13.43,Default,,0,0,0,,Уау! Қандай эпикалық эпизод!
Dialogue: 0,0:21:17.84,0:21:20.53,Default,,0,0,0,,Е! ? Шынымен бе?
Dialogue: 0,0:21:20.53,0:21:25.74,Default,,0,0,0,,Ертең қарлығаштар аттанғанда жаңа ән айта ма?
Dialogue: 0,0:21:25.74,0:21:27.43,Default,,0,0,0,,Иә, ертең болуы мүмкін.
Dialogue: 0,0:21:27.43,0:21:30.79,Default,,0,0,0,,Ханымдар қуана әңгімелесіп отырды.
Dialogue: 0,0:21:30.79,0:21:33.49,Default,,0,0,0,,Мен әрқашан осы жерде жаңа әндерді үйренемін.
Dialogue: 0,0:21:33.49,0:21:35.01,Default,,0,0,0,,Олар ән айтып жатқанда ұшып кетеді.
Dialogue: 0,0:21:35.01,0:21:38.54,Default,,0,0,0,,Міне!
Dialogue: 0,0:21:38.54,0:21:41.54,Default,,0,0,0,,Иә? Әй, Мамыр!
Dialogue: 0,0:21:50.66,0:21:53.53,Default,,0,0,0,,Иә? Мэй ше?
Dialogue: 0,0:21:53.53,0:21:57.40,Default,,0,0,0,,Бір жерге кетіп қалды. сурет? Солай ма?
Dialogue: 0,0:21:57.40,0:22:00.26,Default,,0,0,0,,Қарлығаштың жаңа әнін тыңдамайсың ба?
Dialogue: 0,0:22:00.26,0:22:02.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:06.66,0:22:10.69,Default,,0,0,0,,Не болды? Сені тез көргім келетініне сене алар емеспін.
Dialogue: 0,0:22:10.69,0:22:13.06,Default,,0,0,0,,Габ! Қарлығаштар бұл әнді айтады!
Dialogue: 0,0:22:13.06,0:22:16.76,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:22:16.76,0:22:18.95,Default,,0,0,0,,Мен оны барлығына тыңдауға мүмкіндік беретін шығармын.
Dialogue: 0,0:22:18.95,0:22:21.48,Default,,0,0,0,,Міне! Мен қиындыққа тап болдым!
Dialogue: 0,0:22:21.48,0:22:26.53,Default,,0,0,0,,Мен қиындыққа тап болдым. Бізге не болады?
Dialogue: 0,0:22:26.53,0:22:29.89,Default,,0,0,0,,Қалай... Түсінбедім.
Dialogue: 0,0:22:29.89,0:22:33.76,Default,,0,0,0,,Мен қиындыққа тап болдым. Мен қиындыққа тап болдым.
Dialogue: 0,0:22:33.76,0:22:35.95,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:22:35.95,0:22:39.65,Default,,0,0,0,,Мэй екеуміз... Ах!
Dialogue: 0,0:22:39.65,0:22:41.65,Default,,0,0,0,,Міне! иә?
Dialogue: 0,0:22:45.71,0:22:50.60,Default,,0,0,0,,«Мен бұл туралы ол қызбен кездескен кезде ғана білдім».
Dialogue: 0,0:22:50.60,0:22:56.82,Default,,0,0,0,,«Мен ол баламен кездесе алмаймын.
Dialogue: 0,0:22:56.82,0:23:00.87,Default,,0,0,0,,«Бұл бала әрқашан».
Dialogue: 0,0:23:00.87,0:23:06.93,Default,,0,0,0,,«Сіз маған сенесіз».
Dialogue: 0,0:23:06.93,0:23:14.67,Default,,0,0,0,,«Мына баланың күлкісіне қараңызшы».
Dialogue: 0,0:23:14.67,0:23:22.08,Default,,0,0,0,,«Менің ішім бос, ұмытып кеттім».
Dialogue: 0,0:23:22.08,0:23:29.48,Default,,0,0,0,,«Мен ол қызды кездестірдім және түсіндім».
Dialogue: 0,0:23:29.48,0:23:36.06,Default,,0,0,0,,«Мен көп нәрсені түсінемін».
Dialogue: 0,0:23:36.06,0:23:43.96,Default,,0,0,0,,«Нәзік сезім, күшті сезім»
Dialogue: 0,0:23:43.96,0:23:51.54,Default,,0,0,0,,«Себебі сен маған көп нәрсені үйреттің».
Dialogue: 0,0:23:51.54,0:24:00.13,Default,,0,0,0,,«Менің ең жақын досымның әні»
Dialogue: 0,0:24:00.13,0:24:06.52,Default,,0,0,0,,Хехе, қарлығаштың әні керемет болды емес пе?
Dialogue: 0,0:24:06.52,0:24:10.22,Default,,0,0,0,,Иә! Өйткені бұрынғыдан мүлде басқа ән →
Dialogue: 0,0:24:10.22,0:24:12.41,Default,,0,0,0,,Басында біраз таң қалдым.
Dialogue: 0,0:24:12.41,0:24:16.28,Default,,0,0,0,,Иә! Бірақ жақсы болды.
Dialogue: 0,0:24:16.28,0:24:18.81,Default,,0,0,0,,Иә!
Dialogue: 0,0:24:18.81,0:24:23.69,Default,,0,0,0,,Ей, Ғабу, менімен кездесе алмағаныңа мұң болды ма?
Dialogue: 0,0:24:23.69,0:24:25.88,Default,,0,0,0,,Әрине! Мэй ше?
Dialogue: 0,0:24:25.88,0:24:28.57,Default,,0,0,0,,Жоқ, мен қайғырған жоқпын.
Dialogue: 0,0:24:28.57,0:24:30.10,Default,,0,0,0,,Иә? Хехехе!
Dialogue: 0,0:24:30.10,0:24:36.82,Default,,0,0,0,,Ғабу мені мұңайтпаймын деді ғой, солай ма?
Dialogue: 0,0:24:36.82,0:24:38.82,Default,,0,0,0,,Өйткені мен сендім.
