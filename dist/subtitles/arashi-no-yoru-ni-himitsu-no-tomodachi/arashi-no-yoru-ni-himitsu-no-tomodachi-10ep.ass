Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:57.79,0:02:59.79,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,0:03:05.70,0:03:07.70,Default,,0000,0000,0000,,(сыбырлау)
Dialogue: 0,0:03:10.25,0:03:13.25,Default,,0000,0000,0000,,Бүгін бұл жерден шығу оңай болды.
Dialogue: 0,0:03:20.36,0:03:24.40,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:24.40,0:03:27.59,Default,,0000,0000,0000,,Мүмкін мен сәл ерте келген шығармын?
Dialogue: 0,0:03:27.59,0:03:33.32,Default,,0000,0000,0000,,(сыбырлау)
Dialogue: 0,0:03:33.32,0:03:35.32,Default,,0000,0000,0000,,Уау, бұл...
Dialogue: 0,0:03:37.36,0:03:41.23,Default,,0000,0000,0000,,Иә! Ха! Фуфуфу….
Dialogue: 0,0:03:41.23,0:03:43.25,Default,,0000,0000,0000,,Жіңішке мүйіздер.
Dialogue: 0,0:03:43.25,0:03:47.25,Default,,0000,0000,0000,,Әй, қызық, Ғабу кигізсе не болады?
Dialogue: 0,0:03:52.51,0:03:55.51,Default,,0000,0000,0000,,Мынаны Ғабуға сыйлыққа берейік.
Dialogue: 0,0:04:00.25,0:04:05.25,Default,,0000,0000,0000,,Уау, бұл сирек! Қандай жасыл гүл...
Dialogue: 0,0:04:21.80,0:04:25.34,Default,,0000,0000,0000,,2 адам: Уау!
Dialogue: 0,0:04:25.34,0:04:27.03,Default,,0000,0000,0000,,Қандай әдемі!
Dialogue: 0,0:04:27.03,0:04:29.55,Default,,0000,0000,0000,,Бұл әдемі.
Dialogue: 0,0:04:29.55,0:04:33.25,Default,,0000,0000,0000,,Сізге қай түсті көбірек ұнатасыз?
Dialogue: 0,0:04:33.25,0:04:35.43,Default,,0000,0000,0000,,Бұл ең жақсысы ма?
Dialogue: 0,0:04:35.43,0:04:38.13,Default,,0000,0000,0000,,Хмм... бәрі әдемі.
Dialogue: 0,0:04:38.13,0:04:42.67,Default,,0000,0000,0000,,Дұрыс.Ең бастысы жасыл.
Dialogue: 0,0:04:42.67,0:04:44.03,Default,,0000,0000,0000,,Эй, жасыл?
Dialogue: 0,0:04:44.03,0:04:46.55,Default,,0000,0000,0000,,Көктем келсе, бәрі бірден
Dialogue: 0,0:04:46.55,0:04:49.91,Default,,0000,0000,0000,,Ашық жасыл жапырақтар өсіп тұр ма?
Dialogue: 0,0:04:49.91,0:04:55.64,Default,,0000,0000,0000,,Сол түсті көргенде мен өзімді сергек, жарқын сезінемін.
Dialogue: 0,0:04:55.64,0:04:57.64,Default,,0000,0000,0000,,Сен екеуің алда барыңдар!
Dialogue: 0,0:05:02.87,0:05:06.75,Default,,0000,0000,0000,,Желдің бағытына байланысты.
Dialogue: 0,0:05:06.75,0:05:09.78,Default,,0000,0000,0000,,Маған орман жағынан айналу пішіні ұнайды.
Dialogue: 0,0:05:09.78,0:05:11.97,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:05:11.97,0:05:14.83,Default,,0000,0000,0000,,Сонда біз өзеннен болдық.
Dialogue: 0,0:05:14.83,0:05:17.19,Default,,0000,0000,0000,,Әй, Ғабу! Иә, иә!
Dialogue: 0,0:05:17.19,0:05:21.06,Default,,0000,0000,0000,,Бұрынғыдай араласпа.
Dialogue: 0,0:05:21.06,0:05:24.92,Default,,0000,0000,0000,,Жақсы! Эй, солай...
Dialogue: 0,0:05:24.92,0:05:26.92,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,0:05:29.47,0:05:32.51,Default,,0000,0000,0000,,Келесі жолы олар Соросоло тауында ешкі ауламақшы.
Dialogue: 0,0:05:32.51,0:05:35.71,Default,,0000,0000,0000,,Уау, мен өте қуаныштымын! Мен ешкілерді жақсы көремін!
Dialogue: 0,0:05:35.71,0:05:37.89,Default,,0000,0000,0000,,Мен де!
Dialogue: 0,0:05:37.89,0:05:42.94,Default,,0000,0000,0000,,Өйткені, менің идеалды түрім – Мистер Джило.
Dialogue: 0,0:05:42.94,0:05:45.14,Default,,0000,0000,0000,,Иә! Джиро-сан күшті және керемет.
Dialogue: 0,0:05:45.14,0:05:49.68,Default,,0000,0000,0000,,Мен сенің не ойлайтыныңды білмеймін және бұл аздап қорқынышты.
Dialogue: 0,0:05:49.68,0:05:52.71,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз? Мәселе осы емес пе?
Dialogue: 0,0:05:52.71,0:05:56.41,Default,,0000,0000,0000,,Бұл бір жұмбақ... Эй, Лала?
Dialogue: 0,0:05:56.41,0:06:00.11,Default,,0000,0000,0000,,Сіз қалай ойлайсыз? Мен шынымен түсінбеймін.
Dialogue: 0,0:06:00.11,0:06:02.81,Default,,0000,0000,0000,,Өйткені, сіз Фурараға қол жеткізе аласыз.
Dialogue: 0,0:06:02.81,0:06:05.17,Default,,0000,0000,0000,,Міне қандай әдемі.
Dialogue: 0,0:06:05.17,0:06:09.21,Default,,0000,0000,0000,,Дәлірек айтсақ, Лала ағаның баласы.
Dialogue: 0,0:06:09.21,0:06:12.57,Default,,0000,0000,0000,,2 саны ағайын болса
Dialogue: 0,0:06:12.57,0:06:15.10,Default,,0000,0000,0000,,Әрине, сіздің идеалдарыңыз да жоғары болады.
Dialogue: 0,0:06:15.10,0:06:18.10,Default,,0000,0000,0000,,Иә? Бұл дұрыс емес.
Dialogue: 0,0:06:23.19,0:06:25.87,Default,,0000,0000,0000,,Сәлем Лала!
Dialogue: 0,0:06:25.87,0:06:28.57,Default,,0000,0000,0000,,Сен әдеттегідей әдемісің, Лала-сан.
Dialogue: 0,0:06:28.57,0:06:31.43,Default,,0000,0000,0000,,Камado Танжиро.
Dialogue: 0,0:06:31.43,0:06:34.96,Default,,0000,0000,0000,,Ол мистер Барриге ұқсамайды.
Dialogue: 0,0:06:34.96,0:06:36.65,Default,,0000,0000,0000,,Бірдеңе айттыңыз ба?
Dialogue: 0,0:06:36.65,0:06:39.65,Default,,0000,0000,0000,,А, жоқ... ештеңе.
Dialogue: 0,0:06:49.61,0:06:52.81,Default,,0000,0000,0000,,Тағы да. не?
Dialogue: 0,0:06:52.81,0:06:57.52,Default,,0000,0000,0000,,Ол әлдебір күдікпен, жасырынып жүр...
Dialogue: 0,0:06:57.52,0:07:00.72,Default,,0000,0000,0000,,Ол кім?
Dialogue: 0,0:07:00.72,0:07:05.10,Default,,0000,0000,0000,,Ғабу, сен бұл күндері бір жаққа жалғыз шығасың, солай ма?
Dialogue: 0,0:07:05.10,0:07:07.63,Default,,0000,0000,0000,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:07:07.63,0:07:11.99,Default,,0000,0000,0000,,Білмеймін... Маған мүлдем қызық емес.
Dialogue: 0,0:07:11.99,0:07:14.02,Default,,0000,0000,0000,,Біреу, басқа топтың қызы сияқты.
Dialogue: 0,0:07:14.02,0:07:16.55,Default,,0000,0000,0000,,Ол маған қонаққа келе жатқандай сезіндім.
Dialogue: 0,0:07:16.55,0:07:18.24,Default,,0000,0000,0000,,Мүмкін емес...
Dialogue: 0,0:07:18.24,0:07:23.45,Default,,0000,0000,0000,,Әлсіз, әлсіреген, әбден зеріктіретін адам ше?
Dialogue: 0,0:07:23.45,0:07:26.98,Default,,0000,0000,0000,,Мүмкін емес. (2 адам) Ахаха!
Dialogue: 0,0:07:26.98,0:07:28.98,Default,,0000,0000,0000,,Сондықтан. (2 адам) Лала?
Dialogue: 0,0:07:33.54,0:07:35.54,Default,,0000,0000,0000,,Сасаса!
Dialogue: 0,0:07:38.10,0:07:40.29,Default,,0000,0000,0000,,Мен музыка колледжінде Саки Аримамен бір курс болғанмын, сондықтан→
Dialogue: 0,0:07:40.29,0:07:43.82,Default,,0000,0000,0000,,Қайда бара жатырсың? шеңбер! сурет?
Dialogue: 0,0:07:43.82,0:07:45.34,Default,,0000,0000,0000,,Лара мырза?
Dialogue: 0,0:07:45.34,0:07:49.37,Default,,0000,0000,0000,,Жалықсаң Лала жақсы.
Dialogue: 0,0:07:49.37,0:07:51.39,Default,,0000,0000,0000,,Жоқ, хаха... бірақ….
Dialogue: 0,0:07:51.39,0:07:57.12,Default,,0000,0000,0000,,Бұлай сөйлескенімізге көп болды, тек екеуміз.
Dialogue: 0,0:07:57.12,0:08:01.12,Default,,0000,0000,0000,,А, мен солай ойлаймын.
Dialogue: 0,0:08:03.02,0:08:05.54,Default,,0000,0000,0000,,Бэри: Сенің кезегің, Габи!
Dialogue: 0,0:08:05.54,0:08:07.06,Default,,0000,0000,0000,,Асығыңыз!
Dialogue: 0,0:08:07.06,0:08:10.08,Default,,0000,0000,0000,,Сіз шынымен қорқасыз ба? (Бэрри) Сен жалқаусың, Габ!
Dialogue: 0,0:08:10.08,0:08:12.77,Default,,0000,0000,0000,,Күн батып барады.
Dialogue: 0,0:08:12.77,0:08:14.96,Default,,0000,0000,0000,,Тез секір, Ғабу!
Dialogue: 0,0:08:14.96,0:08:17.96,Default,,0000,0000,0000,,Ахх...
Dialogue: 0,0:08:21.69,0:08:23.21,Default,,0000,0000,0000,,Күтілгендей, жоқ!
Dialogue: 0,0:08:23.21,0:08:26.91,Default,,0000,0000,0000,,Ой-ой!
Dialogue: 0,0:08:26.91,0:08:28.91,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:08:33.15,0:08:36.68,Default,,0000,0000,0000,,Хахаха, жоқ, Габу.
Dialogue: 0,0:08:36.68,0:08:41.06,Default,,0000,0000,0000,,Сен әлі қасқырсың ба? Барлығымыз барайық.
Dialogue: 0,0:08:41.06,0:08:43.42,Default,,0000,0000,0000,,Құлайтындай… Бұл қылыш…
Dialogue: 0,0:08:43.42,0:08:45.42,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:08:59.75,0:09:04.29,Default,,0000,0000,0000,,Секіре алмасаң жақсы. сурет?
Dialogue: 0,0:09:04.29,0:09:06.82,Default,,0000,0000,0000,,Бүгін секіре алмасам да→
Dialogue: 0,0:09:06.82,0:09:11.03,Default,,0000,0000,0000,,Ертең немесе келесі күні секіру үшін бар күшімді сала алсам →
Dialogue: 0,0:09:11.03,0:09:14.73,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:09:14.73,0:09:17.73,Default,,0000,0000,0000,,Күте тұрыңыз, ағайын!
Dialogue: 0,0:09:21.13,0:09:24.49,Default,,0000,0000,0000,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:09:24.49,0:09:27.52,Default,,0000,0000,0000,,Шынында да, сол уақыттан бері →
Dialogue: 0,0:09:27.52,0:09:31.22,Default,,0000,0000,0000,,Біз ешқашан жалғыз сөйлескен емеспіз.
Dialogue: 0,0:09:31.22,0:09:34.76,Default,,0000,0000,0000,,Әй, қайда бара жатырсың? сурет?
Dialogue: 0,0:09:34.76,0:09:36.61,Default,,0000,0000,0000,,Менің қайда бара жатқанымды сұрап тұрсың ба?
Dialogue: 0,0:09:36.61,0:09:41.16,Default,,0000,0000,0000,,Ааа, еш жерде емес...
Dialogue: 0,0:09:41.16,0:09:42.34,Default,,0000,0000,0000,,Біраз жабайы нәрсе.
Dialogue: 0,0:09:42.34,0:09:45.87,Default,,0000,0000,0000,,Мен де сенімен бірге барғым келеді.
Dialogue: 0,0:09:45.87,0:09:48.06,Default,,0000,0000,0000,,Не? Неге бұлай істеп жатырсың?
Dialogue: 0,0:09:48.06,0:09:52.10,Default,,0000,0000,0000,,Мен сенімен барғым келеді дедім.
Dialogue: 0,0:09:52.10,0:09:54.96,Default,,0000,0000,0000,,Сіздермен бірге! ? Бірге шығамыз ба?
Dialogue: 0,0:09:54.96,0:09:59.51,Default,,0000,0000,0000,,Хэхехе! Габи: Басқа ешкім жоқ.
Dialogue: 0,0:09:59.51,0:10:03.04,Default,,0000,0000,0000,,А, бұл...
Dialogue: 0,0:10:03.04,0:10:08.09,Default,,0000,0000,0000,,А, жоқ, бұл жақсы емес.
Dialogue: 0,0:10:08.09,0:10:11.46,Default,,0000,0000,0000,,Жоқ? Неліктен?
Dialogue: 0,0:10:11.46,0:10:15.66,Default,,0000,0000,0000,,Жоқ, мен не айтарымды білмеймін...
Dialogue: 0,0:10:15.66,0:10:20.22,Default,,0000,0000,0000,,Түсіндім, сенің мен айта алмайтын құпия себебің бар.
Dialogue: 0,0:10:20.22,0:10:25.76,Default,,0000,0000,0000,,Құпия! ? Құпия деген мүлдем жоқ.
Dialogue: 0,0:10:25.76,0:10:27.79,Default,,0000,0000,0000,,Онда неге болмасқа?
Dialogue: 0,0:10:27.79,0:10:30.65,Default,,0000,0000,0000,,Міне...
Dialogue: 0,0:10:30.65,0:10:33.85,Default,,0000,0000,0000,,Шынында да...
Dialogue: 0,0:10:33.85,0:10:36.21,Default,,0000,0000,0000,,Ах! Шын мәнінде, мен →
Dialogue: 0,0:10:36.21,0:10:39.57,Default,,0000,0000,0000,,Мен аңыз бойынша тек ер адамдар бару керек деген жерге барамын.
Dialogue: 0,0:10:39.57,0:10:41.76,Default,,0000,0000,0000,,Тек ер адамдар?
Dialogue: 0,0:10:41.76,0:10:44.62,Default,,0000,0000,0000,,Иә, тек ер адамдар.
Dialogue: 0,0:10:44.62,0:10:46.65,Default,,0000,0000,0000,,Мен мұндай аңызды естімеппін.
Dialogue: 0,0:10:46.65,0:10:49.67,Default,,0000,0000,0000,,Бұл туралы тек ер адамдар біледі.
Dialogue: 0,0:10:49.67,0:10:53.38,Default,,0000,0000,0000,,Уау, бұл керемет. сурет?
Dialogue: 0,0:10:53.38,0:10:57.08,Default,,0000,0000,0000,,Бұл өте қауіпті жер болуы керек.
Dialogue: 0,0:10:57.08,0:11:00.11,Default,,0000,0000,0000,,Мұндай жерге жалғыз қалай баруға болады?→
Dialogue: 0,0:11:00.11,0:11:05.50,Default,,0000,0000,0000,,Бұл күшті. А, жоқ, онша емес.
Dialogue: 0,0:11:05.50,0:11:07.02,Default,,0000,0000,0000,,Ғабумен бірге барғым келді→
Dialogue: 0,0:11:07.02,0:11:10.22,Default,,0000,0000,0000,,Олай болса, оған көмектесу мүмкін емес деп ойлаймын. Ха.
Dialogue: 0,0:11:10.22,0:11:13.75,Default,,0000,0000,0000,,Олай болса, маған кәдесый беріңізші.
Dialogue: 0,0:11:13.75,0:11:16.44,Default,,0000,0000,0000,,ше? Сіз оны кәдесый ретінде алғыңыз келе ме?
Dialogue: 0,0:11:16.44,0:11:20.98,Default,,0000,0000,0000,,Сізге бұл ұнамайды ма? Мен оны ұнатпайтыныма сене алар емеспін.
Dialogue: 0,0:11:20.98,0:11:24.69,Default,,0000,0000,0000,,Олай болса, маған уәде бер. Иә, бұл уәде.
Dialogue: 0,0:11:24.69,0:11:29.69,Default,,0000,0000,0000,,Кешке тағы да осында. Мен кешке тағы боламын.
Dialogue: 0,0:11:33.44,0:11:36.64,Default,,0000,0000,0000,,Ғабтың қайда бара жатқанын сұрамағаныңа қуандың ба?
Dialogue: 0,0:11:36.64,0:11:40.68,Default,,0000,0000,0000,,Неліктен кәдесыйлармен алаңдадың?
Dialogue: 0,0:11:40.68,0:11:43.88,Default,,0000,0000,0000,,Мен оны жүзуге мәжбүр еттім. (2 адам) Иә?
Dialogue: 0,0:11:43.88,0:11:46.88,Default,,0000,0000,0000,,Хэхехе! (2 адам) Лала!
Dialogue: 0,0:11:58.19,0:12:00.71,Default,,0000,0000,0000,,Хэхехе!
Dialogue: 0,0:12:00.71,0:12:02.71,Default,,0000,0000,0000,,Уау~ Фуфуфуфу!
Dialogue: 0,0:12:09.81,0:12:15.20,Default,,0000,0000,0000,,Хмм, Ғабу, саған ұнайды деген үміттемін. Хехехе!
Dialogue: 0,0:12:15.20,0:12:19.40,Default,,0000,0000,0000,,мамыр! Габ!
Dialogue: 0,0:12:19.40,0:12:22.60,Default,,0000,0000,0000,,Хахаха! Хехехе!
Dialogue: 0,0:12:22.60,0:12:24.79,Default,,0000,0000,0000,,Жоқ, мен қатты шаршадым...
Dialogue: 0,0:12:24.79,0:12:28.33,Default,,0000,0000,0000,,Ой, қасқыр ғой!
Dialogue: 0,0:12:28.33,1179:59:56.65447,Default,,0000,0000,0000,,Ей, мен келдім, Май!
Dialogue: 0,1179:59:56.65447,1179:59:58.65449,Default,,0000,0000,0000,,Хэхехе!
Dialogue: 0,1179:59:58.65449,1180:00:01.65501,Default,,0000,0000,0000,,Әй, сен бүгін осылай айтып тұрсың ба?
Dialogue: 0,1180:00:01.65501,1180:00:03.65487,Default,,0000,0000,0000,,Әрине мен қасқырмын.
Dialogue: 0,1180:00:03.65487,1180:00:06.65507,Default,,0000,0000,0000,,Гао! маған көмектесші!
Dialogue: 0,1180:00:06.65507,1180:00:11.65528,Default,,0000,0000,0000,,Маған біреу көмектессін! Мен сенің қашуыңа жол бермеймін!
Dialogue: 0,1180:00:11.65528,1180:00:13.65480,Default,,0000,0000,0000,,Ешкі аулауды бастады!
Dialogue: 0,1180:00:13.65480,1180:00:17.65451,Default,,0000,0000,0000,,Бір ғана адам? Керемет Уау!
Dialogue: 0,1180:00:17.65451,1180:00:20.65451,Default,,0000,0000,0000,,Лалаға арналған кәдесый?
Dialogue: 0,1180:01:58.65452,1180:02:00.65521,Default,,0000,0000,0000,,Гао! Кя!
Dialogue: 0,1180:02:00.65521,1180:02:04.65525,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1180:02:04.65525,1180:02:07.65478,Default,,0000,0000,0000,,Гао! Хахаха Уау! !
Dialogue: 0,1180:02:07.65478,1180:02:10.65514,Default,,0000,0000,0000,,Эй, маған көмектес!
Dialogue: 0,1180:02:10.65514,1180:02:14.65485,Default,,0000,0000,0000,,Лараға кәдесый үшін.
Dialogue: 0,1180:02:14.65485,1180:02:17.65471,Default,,0000,0000,0000,,Өз бетімен ешкі аулау.
Dialogue: 0,1180:02:17.65471,1180:02:19.65440,Default,,0000,0000,0000,,Уау! не?
Dialogue: 0,1180:02:19.65440,1180:02:22.65509,Default,,0000,0000,0000,,Жақсы, жақсы, Лара.
Dialogue: 0,1180:02:22.65509,1180:02:24.65445,Default,,0000,0000,0000,,Балалар мен сендерге де беремін.
Dialogue: 0,1180:02:24.65445,1180:02:26.65464,Default,,0000,0000,0000,,Шынымен! ?
Dialogue: 0,1180:02:26.65464,1180:02:28.65516,Default,,0000,0000,0000,,Мен ешкілерді жақсы көремін, бірақ→
Dialogue: 0,1180:02:28.65516,1180:02:31.65518,Default,,0000,0000,0000,,Мен жалғыз балықты жей алмаймын.
Dialogue: 0,1180:02:31.65518,1180:02:36.65457,Default,,0000,0000,0000,,Өте бақытты! Күткендей, Лала - ең жақсы!
Dialogue: 0,1180:02:36.65457,1180:02:40.65444,Default,,0000,0000,0000,,Өтінемін, Ғабу! Хехехе.
Dialogue: 0,1180:02:40.65444,1180:02:43.65513,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1180:02:43.65513,1180:02:49.65453,Default,,0000,0000,0000,,Кя! ! Апыр-ай! Гао Гао! !
Dialogue: 0,1180:02:49.65453,1180:02:51.65522,Default,,0000,0000,0000,,Гао! Кя! !
Dialogue: 0,1180:02:51.65522,1180:02:55.65522,Default,,0000,0000,0000,,Ұсталды! Алақай! Жақсы, Ғабу.
Dialogue: 0,1180:02:57.65494,1180:03:00.65497,Default,,0000,0000,0000,,Ах! Мен қашып құтылдым. Бұл жақсы емес, Ғабе.
Dialogue: 0,1180:03:00.65497,1180:03:04.65518,Default,,0000,0000,0000,,Сәттілік! Берілме балам.
Dialogue: 0,1180:03:04.65518,1180:03:07.65518,Default,,0000,0000,0000,,Кя! ! Гао! Күте тұрыңыз.
Dialogue: 0,1180:03:16.65513,1180:03:18.65449,Default,,0000,0000,0000,,Кяаааааааааа! ! Гао!
Dialogue: 0,1180:03:18.65449,1180:03:21.65501,Default,,0000,0000,0000,,Иә! ? Қанекей жүгірейік.
Dialogue: 0,1180:03:21.65501,1180:03:23.65520,Default,,0000,0000,0000,,Габу? Гао!
Dialogue: 0,1180:03:23.65520,1180:03:25.65489,Default,,0000,0000,0000,,Осылай жүгіруді жалғастырыңыз→
Dialogue: 0,1180:03:25.65489,1180:03:28.65458,Default,,0000,0000,0000,,Жар астындағы үңгірге тығылу.
Dialogue: 0,1180:03:28.65458,1180:03:30.65458,Default,,0000,0000,0000,,Иә, түсіндім.
Dialogue: 0,1180:03:37.65517,1180:03:40.65504,Default,,0000,0000,0000,,Әй, мен Ғабудың ізін жоғалттым.
Dialogue: 0,1180:03:40.65504,1180:03:43.65504,Default,,0000,0000,0000,,Арғы бетке барамыз ба? Иә.
Dialogue: 0,1180:03:50.65,1180:03:53.65,Default,,0000,0000,0000,,Сен қайда бардың? Иә….
Dialogue: 0,1180:03:53.65,1180:03:55.00,Default,,0000,0000,0000,,Менің таңдауым жоқ. Мен оралып, күтуім керек пе?
Dialogue: 0,1180:03:55.00,1180:03:59.65507,Default,,0000,0000,0000,,А, мен сол аңшылықты көргім келді.
Dialogue: 0,1180:03:59.65507,1180:04:01.65525,Default,,0000,0000,0000,,Балалар, байқадыңдар, солай ма?
Dialogue: 0,1180:04:01.65525,1180:04:06.65530,Default,,0000,0000,0000,,Мм... сіз қалай ойлайсыз?
Dialogue: 0,1180:04:06.65530,1180:04:08.65482,Default,,0000,0000,0000,,Бірақ сен көп нәрсе істейсің, Ғабу.
Dialogue: 0,1180:04:08.65482,1180:04:11.65518,Default,,0000,0000,0000,,Менің ойымша, бұл таңқаларлық керемет болды.
Dialogue: 0,1180:04:11.65518,1180:04:14.65438,Default,,0000,0000,0000,,Лара үшін ешкіні қатты қу.
Dialogue: 0,1180:04:14.65438,1180:04:17.65441,Default,,0000,0000,0000,,Еркек, солай емес пе?
Dialogue: 0,1180:04:17.65441,1180:04:21.65445,Default,,0000,0000,0000,,Мен Ғабу туралы қайта ойлаған болармын.
Dialogue: 0,1180:04:21.65445,1180:04:25.65445,Default,,0000,0000,0000,,Лала күткендей, сіз оны дәл көрдіңіз. Хехехе.
Dialogue: 0,1180:04:27.65534,1180:04:30.65520,Default,,0000,0000,0000,,Күрсін... Қазір бәрі жақсы.
Dialogue: 0,1180:04:30.65520,1180:04:33.65457,Default,,0000,0000,0000,,Сізді қорқытқаным үшін кешіріңіз.
Dialogue: 0,1180:04:33.65457,1180:04:35.65459,Default,,0000,0000,0000,,Бұл не болды? Қазір не болды?
Dialogue: 0,1180:04:35.65459,1180:04:37.65528,Default,,0000,0000,0000,,Бұл менің кінәм.
Dialogue: 0,1180:04:37.65528,1180:04:41.65482,Default,,0000,0000,0000,,Маған байланғанына сенімдімін, бірақ байқамадым...
Dialogue: 0,1180:04:41.65482,1180:04:45.65518,Default,,0000,0000,0000,,Ол қосылды! ? Бұл дұрыс.
Dialogue: 0,1180:04:45.65518,1180:04:48.65472,Default,,0000,0000,0000,,Мен кәдімгідей жасырын шығып кетейін деп қалдым.
Dialogue: 0,1180:04:48.65472,1180:04:51.65475,Default,,0000,0000,0000,,Лала-сан мені көрді.
Dialogue: 0,1180:04:51.65475,1180:04:53.65460,Default,,0000,0000,0000,,Лара мырза? Бұл дұрыс.
Dialogue: 0,1180:04:53.65460,1180:04:57.65447,Default,,0000,0000,0000,,Қайда бара жатырсың? Мен де барғым келеді дедім.
Dialogue: 0,1180:04:57.65447,1180:05:01.65535,Default,,0000,0000,0000,,Мен шарасыз бас тарттым... Бірақ?
Dialogue: 0,1180:05:01.65535,1180:05:06.65490,Default,,0000,0000,0000,,Бірақ мен саған кәдесый беріп, уәде беруімді өтінді... Ах!
Dialogue: 0,1180:05:06.65490,1180:05:08.65442,Default,,0000,0000,0000,,Сіз уәде бердіңіз.
Dialogue: 0,1180:05:08.65442,1180:05:10.65461,Default,,0000,0000,0000,,Хмм... Дұрыс.
Dialogue: 0,1180:05:10.65461,1180:05:14.65531,Default,,0000,0000,0000,,Күрсін... Түсіндім. Бұл жақсы.
Dialogue: 0,1180:05:14.65531,1180:05:16.65483,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,1180:05:16.65483,1180:05:18.65519,Default,,0000,0000,0000,,Сіз ашулысыз ба?
Dialogue: 0,1180:05:18.65519,1180:05:21.65488,Default,,0000,0000,0000,,Жоқ.Неге ашуланасың?
Dialogue: 0,1180:05:21.65488,1180:05:24.65458,Default,,0000,0000,0000,,Сіз ашулы болуыңыз керек.
Dialogue: 0,1180:05:24.65458,1180:05:30.65530,Default,,0000,0000,0000,,Олай болса, Лала-санға кәдесый – мен, Ғабу.
Dialogue: 0,1180:05:30.65530,1180:05:35.65452,Default,,0000,0000,0000,,А... жоқ, олай болуы мүмкін емес.
Dialogue: 0,1180:05:35.65452,1180:05:38.65455,Default,,0000,0000,0000,,Барлығы осылай ойлады.
Dialogue: 0,1180:05:38.65455,1180:05:43.65461,Default,,0000,0000,0000,,Не? Лала және басқа қасқырлар да.
Dialogue: 0,1180:05:43.65461,1180:05:46.65464,Default,,0000,0000,0000,,Бұлай болуы мүмкін емес.
Dialogue: 0,1180:05:46.65464,1180:05:50.65484,Default,,0000,0000,0000,,Ғаб... Міне, солай.
Dialogue: 0,1180:05:50.65484,1180:05:53.65486,Default,,0000,0000,0000,,Өйткені мен ешкімін.
Dialogue: 0,1180:05:53.65486,1180:05:56.65486,Default,,0000,0000,0000,,Ах! Аа….
Dialogue: 0,1180:06:00.65527,1180:06:06.65533,Default,,0000,0000,0000,,Бірақ сыр... Құпиямыздың ашылмағанына қуанамын.
Dialogue: 0,1180:06:06.65533,1180:06:08.65502,Default,,0000,0000,0000,,Хэхе! Эй!
Dialogue: 0,1180:06:08.65502,1180:06:11.65522,Default,,0000,0000,0000,,Иә, дұрыс.
Dialogue: 0,1180:06:11.65522,1180:06:14.65475,Default,,0000,0000,0000,,-дағы Ғабу туралы не деуге болады?
Dialogue: 0,1180:06:14.65475,1180:06:19.65463,Default,,0000,0000,0000,,Иә? Сізге Лала ұнай ма?
Dialogue: 0,1180:06:19.65463,1180:06:23.65517,Default,,0000,0000,0000,,Неліктен бұлай сұрайсыз?
Dialogue: 0,1180:06:23.65517,1180:06:25.65452,Default,,0000,0000,0000,,Әлде сен оны жек көресің бе?
Dialogue: 0,1180:06:25.65452,1180:06:29.65523,Default,,0000,0000,0000,,Ұнату немесе ұнатпау→
Dialogue: 0,1180:06:29.65523,1180:06:31.65442,Default,,0000,0000,0000,,Мен бұл туралы ешқашан ойламадым ...
Dialogue: 0,1180:06:31.65442,1180:06:35.65495,Default,,0000,0000,0000,,Секіре алмасаң жақсы.
Dialogue: 0,1180:06:35.65495,1180:06:38.65465,Default,,0000,0000,0000,,Бүгін секіре алмасам да...
Dialogue: 0,1180:06:38.65465,1180:06:43.65504,Default,,0000,0000,0000,,Ертең немесе келесі күні секіру үшін бар күшімді сала алсам →
Dialogue: 0,1180:06:43.65504,1180:06:45.65456,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,1180:06:45.65456,1180:06:47.65491,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1180:06:47.65491,1180:06:50.65494,Default,,0000,0000,0000,,Аа, мен бала кезімде қателесетінмін →
Dialogue: 0,1180:06:50.65494,1180:06:52.65463,Default,,0000,0000,0000,,Бірде ол мені жігерлендірді.
Dialogue: 0,1180:06:52.65463,1180:06:54.65515,Default,,0000,0000,0000,,Ах.
Dialogue: 0,1180:06:54.65515,1180:06:58.65485,Default,,0000,0000,0000,,Бұл Лала-санның менен бірінші рет жақсылық сұрап отыр→
Dialogue: 0,1180:06:58.65485,1180:07:04.65491,Default,,0000,0000,0000,,Сондықтан маған кәдесый ұсынғанда бас тарта алмадым...
Dialogue: 0,1180:07:04.65491,1180:07:07.65477,Default,,0000,0000,0000,,Сонымен менмін.
Dialogue: 0,1180:07:07.65477,1180:07:09.65479,Default,,0000,0000,0000,,О, күте тұрыңыз!
Dialogue: 0,1180:07:09.65479,1180:07:12.65465,Default,,0000,0000,0000,,Хэхе! Жай ойнам айттым.
Dialogue: 0,1180:07:12.65465,1180:07:14.65485,Default,,0000,0000,0000,,А... әзілдеп тұрмын.
Dialogue: 0,1180:07:14.65485,1180:07:17.65454,Default,,0000,0000,0000,,Олай болса, кеттік. бару?
Dialogue: 0,1180:07:17.65454,1180:07:20.65507,Default,,0000,0000,0000,,Мен кәдесыйлар іздеймін. иә?
Dialogue: 0,1180:07:20.65507,1180:07:24.65527,Default,,0000,0000,0000,,Олар қасқыр мен ешкі, бірақ екеуі бір қыз.
Dialogue: 0,1180:07:24.65527,1180:07:27.65464,Default,,0000,0000,0000,,Мен не алуға қуанышты болатынымды түсінемін.
Dialogue: 0,1180:07:27.65464,1180:07:30.65533,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,1180:07:30.65533,1180:07:32.65533,Default,,0000,0000,0000,,мамыр!
Dialogue: 0,1180:07:39.65493,1180:07:44.65497,Default,,0000,0000,0000,,Кеш болды... Ақыр соңында, мен оны жіберіп қойғанмын.
Dialogue: 0,1180:07:44.65497,1180:07:48.65468,Default,,0000,0000,0000,,Мен оны асыға күттім. жаңа піскен ешкі.
Dialogue: 0,1180:07:48.65468,1180:07:50.65437,Default,,0000,0000,0000,,Мен бұл мүлдем мүмкін емес деп ойладым.
Dialogue: 0,1180:07:50.65437,1180:07:53.65507,Default,,0000,0000,0000,,Сол гоблин жалғыз өзі ешкіні қалай бағындырады?
Dialogue: 0,1180:07:53.65507,1180:07:56.65460,Default,,0000,0000,0000,,Күрсін... Мен қазір баруым керек сияқты. барайық.
Dialogue: 0,1180:07:56.65460,1180:07:58.65460,Default,,0000,0000,0000,,Лара ше?
Dialogue: 0,1180:08:00.65514,1180:08:04.65484,Default,,0000,0000,0000,,Лала жақсы емес пе? Өйткені күткім келеді.
Dialogue: 0,1180:08:04.65484,1180:08:08.65438,Default,,0000,0000,0000,,Сіз оны шынымен жегіңіз келеді. жаңа піскен ешкі.
Dialogue: 0,1180:08:08.65438,1180:08:12.65526,Default,,0000,0000,0000,,Лараның күткені →
Dialogue: 0,1180:08:12.65526,1180:08:16.65479,Default,,0000,0000,0000,,Ешкі емес, қарлығаш емес пе?
Dialogue: 0,1180:08:16.65479,1180:08:18.65498,Default,,0000,0000,0000,,Мүмкін емес!
Dialogue: 0,1180:08:18.65498,1180:08:21.65451,Default,,0000,0000,0000,,Дұрыс! (күлкі)
Dialogue: 0,1180:08:21.65451,1180:08:23.65451,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,1180:08:38.65502,1180:08:42.65506,Default,,0000,0000,0000,,Қош келдіңіз Ғабу. Кешіріңіз, кеш болды.
Dialogue: 0,1180:08:42.65506,1180:08:48.65478,Default,,0000,0000,0000,,Бұл кәдесый. Уау, рахмет!
Dialogue: 0,1180:08:48.65478,1180:08:53.65533,Default,,0000,0000,0000,,Ал, сүйкімді сүйектер! Және қызықты тастар!
Dialogue: 0,1180:08:53.65533,1180:08:58.65438,Default,,0000,0000,0000,,Рахмет Ғабу. Жоқ, не... хехехе.
Dialogue: 0,1180:08:58.65438,1180:09:00.65438,Default,,0000,0000,0000,,Иә? а?
Dialogue: 0,1180:09:02.65459,1180:09:07.65481,Default,,0000,0000,0000,,А, сәттілік! Менің жейтін ештеңем жоқ.
Dialogue: 0,1180:09:07.65481,1180:09:11.65534,Default,,0000,0000,0000,,Мен ешкіні қуып көрдім, бірақ болмады.
Dialogue: 0,1180:09:11.65534,1180:09:13.65453,Default,,0000,0000,0000,,Шынымен бе?
Dialogue: 0,1180:09:13.65453,1180:09:15.65455,Default,,0000,0000,0000,,А... не! ?
Dialogue: 0,1180:09:15.65455,1180:09:17.65491,Default,,0000,0000,0000,,Мен оны қарап отырдым.
Dialogue: 0,1180:09:17.65491,1180:09:19.65493,Default,,0000,0000,0000,,Сіз не істемексіз? ?
Dialogue: 0,1180:09:19.65493,1180:09:21.65528,Default,,0000,0000,0000,,Ғабу ешкіні қуып келеді.
Dialogue: 0,1180:09:21.65528,1180:09:24.65480,Default,,0000,0000,0000,,Бұл мені тоқтатуға жеткілікті болды.
Dialogue: 0,1180:09:24.65480,1180:09:26.65500,Default,,0000,0000,0000,,А... міне, солай.
Dialogue: 0,1180:09:26.65500,1180:09:29.65503,Default,,0000,0000,0000,,Сіз сәтсіздікке ұшырадыңыз ба? Шынымен.
Dialogue: 0,1180:09:29.65503,1180:09:31.65455,Default,,0000,0000,0000,,Жоқ, дұрыс.
Dialogue: 0,1180:09:31.65455,1180:09:34.65441,Default,,0000,0000,0000,,Мен қашуға бір қадам ғана қалдым...
Dialogue: 0,1180:09:34.65441,1180:09:39.65512,Default,,0000,0000,0000,,Сіз ебедейсіз және үнемі сәтсіздікке ұшырайсыз→
Dialogue: 0,1180:09:39.65512,1180:09:42.65532,Default,,0000,0000,0000,,Бұл рас суясен.
Dialogue: 0,1180:09:42.65532,1180:09:44.65451,Default,,0000,0000,0000,,Не! иә?
Dialogue: 0,1180:09:44.65451,1180:09:47.65471,Default,,0000,0000,0000,,Уфуфу Мен жұтқанда, ештеңе өзгерген жоқ.
Dialogue: 0,1180:09:47.65471,1180:09:52.65509,Default,,0000,0000,0000,,Бұрынғыдай. Мен уайымдап ақша жоғалттым.
Dialogue: 0,1180:09:52.65509,1180:09:55.65479,Default,,0000,0000,0000,,Иә? Сәтсіздіктер көп болғаны дұрыс.
Dialogue: 0,1180:09:55.65479,1180:10:00.65483,Default,,0000,0000,0000,,Келесі жолы сәтсіздікке ұшырамауға тырысыңыз.
Dialogue: 0,1180:10:00.65483,1180:10:02.65518,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,1180:10:02.65518,1180:10:04.65518,Default,,0000,0000,0000,,Эй?
Dialogue: 0,1180:10:11.65445,1180:10:18.65501,Default,,0000,0000,0000,,Өтірік! ? Иә, мен толықпын!
Dialogue: 0,1180:10:18.65501,1180:10:21.65454,Default,,0000,0000,0000,,Бұл тым жасырын!
Dialogue: 0,1180:10:21.65454,1180:10:26.65442,Default,,0000,0000,0000,,Қане, өсек айтсаң! Габ!
Dialogue: 0,1180:10:26.65442,1180:10:28.65512,Default,,0000,0000,0000,,Уфуфу Қайырлы таң Габу!
Dialogue: 0,1180:10:28.65512,1180:10:30.65530,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,1180:10:30.65530,1180:10:33.65500,Default,,0000,0000,0000,,Келесі жолы маған кәдесый әкеліңізші!
Dialogue: 0,1180:10:33.65500,1180:10:36.65500,Default,,0000,0000,0000,,Түсіндім.
Dialogue: 0,1180:10:39.65456,1180:10:41.65475,Default,,0000,0000,0000,,《Сол гүл...》
Dialogue: 0,1180:10:41.65475,1180:10:45.65511,Default,,0000,0000,0000,,Бұл жеткілікті.
Dialogue: 0,1180:10:45.65511,1180:10:48.65448,Default,,0000,0000,0000,,Мен солай ойлаймын. Май, рахмет!
Dialogue: 0,1180:10:48.65448,1180:10:53.65470,Default,,0000,0000,0000,,Мен сенің бақытты болатыныңа сенімдімін! Солай ма?
Dialogue: 0,1180:10:53.65470,1180:10:57.65458,Default,,0000,0000,0000,,Хм, бірдеңе жетіспейтін сияқты.
Dialogue: 0,1180:10:57.65458,1180:10:59.65460,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1180:10:59.65460,1180:11:03.65460,Default,,0000,0000,0000,,Менде бұл болуы керек! Ухуху
Dialogue: 0,1180:11:07.65500,1180:11:10.65500,Default,,0000,0000,0000,,《Мэй маған сыйлаған гүлдермен》
Dialogue: 0,1180:11:12.65488,1180:11:16.65488,Default,,0000,0000,0000,,Габтың сүйікті ашық жасыл Уфуфуфу!
Dialogue: 0,1180:11:32.65475,1180:11:35.65512,Default,,0000,0000,0000,,Рахмет... Деянсу.
Dialogue: 0,1180:11:35.65512,1180:11:39.65512,Default,,0000,0000,0000,,А-а-а-а-а-а!
Dialogue: 0,1180:11:41.15,1180:11:47.15,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
