Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:03:13.76,0:03:16.76,Default,,0000,0000,0000,,Хэхехе.
Dialogue: 0,0:03:20.50,0:03:22.50,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:03:27.23,0:03:30.77,Default,,0000,0000,0000,,Бүгін мені қайда апарасың деп қызық.
Dialogue: 0,0:03:30.77,0:03:33.77,Default,,0000,0000,0000,,Хэхехе….
Dialogue: 0,0:03:57.36,0:03:59.36,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:04:05.28,0:04:39.28,Default,,0000,0000,0000,,～
Dialogue: 0,0:04:41.64,0:04:44.64,Default,,0000,0000,0000,,Кеш болды, деп ойладым.
Dialogue: 0,0:04:49.39,0:04:53.39,Default,,0000,0000,0000,,Мен үйге бара жатырмын. О иә.
Dialogue: 0,0:04:58.14,0:05:00.14,Default,,0000,0000,0000,,Ги Гиро мырза.
Dialogue: 0,0:05:04.20,0:05:06.88,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:06.88,0:05:08.24,Default,,0000,0000,0000,,Әй, Ғабу! Иә.
Dialogue: 0,0:05:08.24,0:05:13.96,Default,,0000,0000,0000,,Айтар сөзің жоқ па?
Dialogue: 0,0:05:13.96,0:05:15.65,Default,,0000,0000,0000,,Не? жоқ….
Dialogue: 0,0:05:15.65,0:05:20.20,Default,,0000,0000,0000,,Сіз мен және Мистер Гилодан бірдеңені жасырғыңыз келе ме?
Dialogue: 0,0:05:20.20,0:05:24.73,Default,,0000,0000,0000,,Е! ? Жазыңыз….
Dialogue: 0,0:05:24.73,0:05:28.11,Default,,0000,0000,0000,,《Мен бұл құпия деп ешқашан ойламаппын...》
Dialogue: 0,0:05:28.11,0:05:30.97,Default,,0000,0000,0000,,Ах! Сіз қалай ойлайсыз? ?
Dialogue: 0,0:05:30.97,0:05:33.97,Default,,0000,0000,0000,,《Ух... жоқ.
Dialogue: 0,0:05:35.02,0:05:39.38,Default,,0000,0000,0000,,Мен сіз бен Мэй туралы білдім...》
Dialogue: 0,0:05:39.38,0:05:42.75,Default,,0000,0000,0000,,Сәлем! О... жоқ.
Dialogue: 0,0:05:42.75,0:05:45.28,Default,,0000,0000,0000,,Біз... иә?
Dialogue: 0,0:05:45.28,0:05:47.97,Default,,0000,0000,0000,,Ах…. иә?
Dialogue: 0,0:05:47.97,0:05:49.32,Default,,0000,0000,0000,,Біз... иә?
Dialogue: 0,0:05:49.32,0:05:52.85,Default,,0000,0000,0000,,Эй... Өзіңді нашар сезініп тұрған шығарсың! ?
Dialogue: 0,0:05:52.85,0:05:54.20,Default,,0000,0000,0000,,Ура! ? Ахх! ?
Dialogue: 0,0:05:54.20,0:05:58.57,Default,,0000,0000,0000,,Үндемей қалсаң, түсінбейсің! Иә, дұрыс.
Dialogue: 0,0:05:58.57,0:06:04.80,Default,,0000,0000,0000,,Біраз уақыттан бері ішім ауырып жүр, сондықтан мен оны ұстай алмаймын.
Dialogue: 0,0:06:04.80,0:06:07.66,Default,,0000,0000,0000,,Мен солай ойладым.
Dialogue: 0,0:06:07.66,0:06:09.51,Default,,0000,0000,0000,,Қанша ебедейсіз болсаң да→
Dialogue: 0,0:06:09.51,0:06:14.90,Default,,0000,0000,0000,,Осындай сәтсіздіктердің көп болуы біртүрлі.
Dialogue: 0,0:06:14.90,0:06:17.43,Default,,0000,0000,0000,,Хехе... Кешіріңіз.
Dialogue: 0,0:06:17.43,0:06:21.30,Default,,0000,0000,0000,,Ішің ауырса, дереу құтылу үшін шөп жеп ал.
Dialogue: 0,0:06:21.30,0:06:24.17,Default,,0000,0000,0000,,Иә, бұл оңай. Фу.
Dialogue: 0,0:06:24.17,0:06:28.54,Default,,0000,0000,0000,,Габ. Иә.
Dialogue: 0,0:06:28.54,0:06:34.27,Default,,0000,0000,0000,,Мен сізді бірден сылтау айтпағаныңыз үшін мақтаймын.
Dialogue: 0,0:06:34.27,0:06:38.64,Default,,0000,0000,0000,,Алайда байыпты бола алмағандар аңға қосылады→
Dialogue: 0,0:06:38.64,0:06:45.54,Default,,0000,0000,0000,,Бұл достарыңызға қауіп төндірумен бірдей.
Dialogue: 0,0:06:45.54,0:06:50.54,Default,,0000,0000,0000,,Түсіндің бе? Иә, түсінемін.
Dialogue: 0,0:06:55.14,0:06:58.34,Default,,0000,0000,0000,,Сіз бұл туралы ештеңе істей алмайтын адамсыз.
Dialogue: 0,0:06:58.34,0:07:01.71,Default,,0000,0000,0000,,Іш ауруын рухпен емдеуге болады.
Dialogue: 0,0:07:01.71,0:07:05.24,Default,,0000,0000,0000,,Мотивация болса, мүмкін емес.
Dialogue: 0,0:07:05.24,0:07:07.26,Default,,0000,0000,0000,,Менің ойымша, сіз бәрібір біртүрлі нәрсе жедіңіз.
Dialogue: 0,0:07:07.26,0:07:10.30,Default,,0000,0000,0000,,Hmph, бақалар және т.б. о иә.
Dialogue: 0,0:07:10.30,0:07:15.34,Default,,0000,0000,0000,,Бақалар улы, ақ сұйықтық шығады →
Dialogue: 0,0:07:15.34,0:07:17.03,Default,,0000,0000,0000,,Ондай нәрсені жеуге болмайды!
Dialogue: 0,0:07:17.03,0:07:21.91,Default,,0000,0000,0000,,Хамф, онда бұл улы кесіртке. Иә иә.
Dialogue: 0,0:07:21.91,0:07:23.26,Default,,0000,0000,0000,,Улы кесірткелер де улы →
Dialogue: 0,0:07:23.26,0:07:25.28,Default,,0000,0000,0000,,Шырылдаған сары сұйықтық шықты →
Dialogue: 0,0:07:25.28,0:07:28.14,Default,,0000,0000,0000,,Бұл сондай жақсы сезім болды→
Dialogue: 0,0:07:28.14,0:07:30.00,Default,,0000,0000,0000,,Өлетін шығарсың!
Dialogue: 0,0:07:30.00,0:07:36.38,Default,,0000,0000,0000,,Ғаб Оны тез тауып жеп қойыңыз. Ха… иә….
Dialogue: 0,0:07:36.38,0:07:38.41,Default,,0000,0000,0000,,Сіз немен оралдыңыз? Мен үйге бара жатырмын.
Dialogue: 0,0:07:38.41,0:07:41.27,Default,,0000,0000,0000,,Сәлеметсіз бе.
Dialogue: 0,0:07:41.27,0:07:44.27,Default,,0000,0000,0000,,күрсіну. Уф… жақсы….
Dialogue: 0,0:07:47.33,0:07:49.52,Default,,0000,0000,0000,,Ах, а...
Dialogue: 0,0:07:49.52,0:07:52.52,Default,,0000,0000,0000,,Уау! Ах!
Dialogue: 0,0:07:54.40,0:07:56.25,Default,,0000,0000,0000,,Габ~!
Dialogue: 0,0:07:56.25,0:07:59.12,Default,,0000,0000,0000,,Мен кешігіп қалдым. Сіз уайымдағансыз, солай емес пе?
Dialogue: 0,0:07:59.12,0:08:05.68,Default,,0000,0000,0000,,Бірдеңе болды ма? иә? Жоқ... ештеңе... ештеңе.
Dialogue: 0,0:08:05.68,0:08:10.06,Default,,0000,0000,0000,,Шынымен бе? Жақсы, әсіресе...
Dialogue: 0,0:08:10.06,0:08:12.24,Default,,0000,0000,0000,,Габ…. иә?
Dialogue: 0,0:08:12.24,0:08:15.11,Default,,0000,0000,0000,,Амансың ба? Эх! ?
Dialogue: 0,0:08:15.11,0:08:18.64,Default,,0000,0000,0000,,Бұл әдеттегіден басқаша көрінеді...
Dialogue: 0,0:08:18.64,0:08:22.35,Default,,0000,0000,0000,,Жоқ... бұл дұрыс емес...
Dialogue: 0,0:08:22.35,0:08:26.38,Default,,0000,0000,0000,,Мен одан ертерек кетемін.
Dialogue: 0,0:08:26.38,0:08:28.38,Default,,0000,0000,0000,,Жақсы….
Dialogue: 0,0:08:30.59,0:08:33.63,Default,,0000,0000,0000,,Өзіңізді жақсы сезінбейтін сияқтысыз...
Dialogue: 0,0:08:33.63,0:08:36.98,Default,,0000,0000,0000,,Бұл дұрыс емес...
Dialogue: 0,0:08:36.98,0:08:39.85,Default,,0000,0000,0000,,Мұның жақсы екеніне сенімдісіз бе?
Dialogue: 0,0:08:39.85,0:08:42.38,Default,,0000,0000,0000,,Сондай-ақ... әрине.
Dialogue: 0,0:08:42.38,0:08:44.23,Default,,0000,0000,0000,,Мен солай ойлаймын.
Dialogue: 0,0:08:44.23,0:08:46.25,Default,,0000,0000,0000,,Ах! О!
Dialogue: 0,0:08:46.25,0:08:49.28,Default,,0000,0000,0000,,Қауіп-қатерге ұшырамаңыз. Мен алға қарап, дұрыс жүруім керек.
Dialogue: 0,0:08:49.28,0:08:51.80,Default,,0000,0000,0000,,Мүмкін емес...
Dialogue: 0,0:08:51.80,0:08:53.82,Default,,0000,0000,0000,,Иә? Не... неге бұлай істеп жатырсың?
Dialogue: 0,0:08:53.82,0:08:57.03,Default,,0000,0000,0000,,Менен бірдеңе жасырып жатқаныңызға сенімдісіз бе?
Dialogue: 0,0:08:57.03,0:09:01.57,Default,,0000,0000,0000,,Е! ? Жасыратыным осы...
Dialogue: 0,0:09:01.57,0:09:04.10,Default,,0000,0000,0000,,Балалар сендер жасырын достар емессіңдер ме?
Dialogue: 0,0:09:04.10,0:09:07.63,Default,,0000,0000,0000,,Құпия болса да, құпия...
Dialogue: 0,0:09:07.63,0:09:10.66,Default,,0000,0000,0000,,Ал, тағы да...
Dialogue: 0,0:09:10.66,0:09:13.53,Default,,0000,0000,0000,,Бұл күрделі... Эй...
Dialogue: 0,0:09:13.53,0:09:17.73,Default,,0000,0000,0000,,Күрсін, бұл түсінікті, шын мәнінде...
Dialogue: 0,0:09:17.73,0:09:19.92,Default,,0000,0000,0000,,Шынымен?
Dialogue: 0,0:09:19.92,0:09:22.78,Default,,0000,0000,0000,,Негізінде… уағыз….
Dialogue: 0,0:09:22.78,0:09:24.96,Default,,0000,0000,0000,,Уағыз?
Dialogue: 0,0:09:24.96,0:09:26.98,Default,,0000,0000,0000,,Хмм, мен уағызымды аяқтадым!
Dialogue: 0,0:09:26.98,0:09:28.18,Default,,0000,0000,0000,,Иә? Не айтқың келеді?
Dialogue: 0,0:09:28.18,0:09:32.38,Default,,0000,0000,0000,,Жақында топта мүлде байсалды бола алмайтын біреу болды→
Dialogue: 0,0:09:32.38,0:09:35.08,Default,,0000,0000,0000,,Сіз бәріне қиындық тудырып жатырсыз.
Dialogue: 0,0:09:35.08,0:09:38.60,Default,,0000,0000,0000,,Мен сені бұлай жалғыз қалдыра алмаймын→
Dialogue: 0,0:09:38.60,0:09:42.32,Default,,0000,0000,0000,,Мен сізге аздап қатты айттым.
Dialogue: 0,0:09:42.32,0:09:44.17,Default,,0000,0000,0000,,Хмм... Негізі уағыз деген жоқ...
Dialogue: 0,0:09:44.17,0:09:47.19,Default,,0000,0000,0000,,Мүмкін... Иә?
Dialogue: 0,0:09:47.19,0:09:50.40,Default,,0000,0000,0000,,Ғабу қасқыр бастық па?
Dialogue: 0,0:09:50.40,0:09:53.76,Default,,0000,0000,0000,,Бастық! ? Солай емес пе?
Dialogue: 0,0:09:53.76,0:09:58.14,Default,,0000,0000,0000,,А... жоқ... бастық... бірақ...
Dialogue: 0,0:09:58.14,0:10:02.84,Default,,0000,0000,0000,,Онда келесі бастық! Хехехе!
Dialogue: 0,0:10:02.84,0:10:04.03,Default,,0000,0000,0000,,Иә? Эй?
Dialogue: 0,0:10:04.03,0:10:07.73,Default,,0000,0000,0000,,Ал... солай...
Dialogue: 0,0:10:07.73,0:10:11.93,Default,,0000,0000,0000,,Уау~ Күткендей~!
Dialogue: 0,0:10:11.93,0:10:13.63,Default,,0000,0000,0000,,Габу Сооо!
Dialogue: 0,0:10:13.63,0:10:17.49,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:10:17.49,0:10:21.70,Default,,0000,0000,0000,,Олай болса, бүгін мені қайда апарасың?
Dialogue: 0,0:10:21.70,0:10:26.25,Default,,0000,0000,0000,,Келесі бастық. Хм... Осы жерде жасайық!
Dialogue: 0,0:10:26.25,0:10:32.31,Default,,0000,0000,0000,,Уау~ Мен мұндайды ешқашан көрген емеспін~!
Dialogue: 0,0:10:32.31,0:10:36.85,Default,,0000,0000,0000,,Өте әдемі!
Dialogue: 0,0:10:36.85,0:10:39.72,Default,,0000,0000,0000,,«Габ — бастық, келесі бастық»
Dialogue: 0,0:10:39.72,0:10:44.93,Default,,0000,0000,0000,,«Сіз әдетте өте мейірімді болсаңыз да».
Dialogue: 0,0:10:44.93,0:10:46.95,Default,,0000,0000,0000,,«Мен сені жалғыз қалдыруым керек».
Dialogue: 0,0:10:46.95,0:10:48.64,Default,,0000,0000,0000,,«Мен уағыздаймын».
Dialogue: 0,0:10:48.64,0:10:52.68,Default,,0000,0000,0000,,Уфуфуфу Бүгін көңілді болды.
Dialogue: 0,0:10:52.68,0:10:55.71,Default,,0000,0000,0000,,Ал, ертең біз одан да ғажайып жерге барамыз.
Dialogue: 0,0:10:55.71,0:10:59.09,Default,,0000,0000,0000,,Иә! ? Қандай жер! ? бұл….
Dialogue: 0,0:10:59.09,0:11:02.44,Default,,0000,0000,0000,,Иә? а….
Dialogue: 0,0:11:02.44,0:11:05.64,Default,,0000,0000,0000,,Ертеңгі күнді асыға күтемін!
Dialogue: 0,0:11:05.64,0:11:08.83,Default,,0000,0000,0000,,Эх!
Dialogue: 0,0:11:08.83,0:11:11.70,Default,,0000,0000,0000,,Олай болса, ертең де осында кездесеміз.
Dialogue: 0,0:11:11.70,0:11:13.05,Default,,0000,0000,0000,,Түсінікті.
Dialogue: 0,0:11:13.05,0:11:15.58,Default,,0000,0000,0000,,А, бірақ... сурет?
Dialogue: 0,0:11:15.58,0:11:18.27,Default,,0000,0000,0000,,Ертең кешікпеңіз.
Dialogue: 0,0:11:18.27,0:11:21.97,Default,,0000,0000,0000,,Егер кешігіп қалсаңыз, мен үйге баруым керек.
Dialogue: 0,0:11:21.97,0:11:24.66,Default,,0000,0000,0000,,Келесі бастық болса да, ол жұмыс істемейді.
Dialogue: 0,0:11:24.66,0:11:26.66,Default,,0000,0000,0000,,Бұл тұйыққа тіреледі.
Dialogue: 0,0:11:30.39,0:11:32.75,Default,,0000,0000,0000,,Не! Түсіну оңай болды.
Dialogue: 0,0:11:32.75,0:11:35.11,Default,,0000,0000,0000,,Не? Мен ешқашан кешікпеймін.
Dialogue: 0,0:11:35.11,0:11:38.98,Default,,0000,0000,0000,,Қасқырдың айтар сөзі жоқ!
Dialogue: 0,0:11:38.98,0:11:41.00,Default,,0000,0000,0000,,Габу?
Dialogue: 0,0:11:41.00,0:11:48.00,Default,,0000,0000,0000,,А... келесі бастық? Мен?
Dialogue: 0,0:11:50.93,0:11:55.98,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:11:55.98,0:11:59.68,Default,,0000,0000,0000,,Қатты! Мен кешігіп қаламын.
Dialogue: 0,0:11:59.68,0:12:01.87,Default,,0000,0000,0000,,мамыр!
Dialogue: 0,0:12:01.87,0:12:04.06,Default,,0000,0000,0000,,Осы жолы сен жұмсаған күшіңе сай нәтижеге қол жеткіздің—
Dialogue: 0,0:12:04.06,0:12:07.93,Default,,0000,0000,0000,,Аа... Әй, досымның үйінде.
Dialogue: 0,0:12:07.93,0:12:11.64,Default,,0000,0000,0000,,Сіздің достарыңыз соңғы кезде көріп жүрген достарыңыз ба?
Dialogue: 0,0:12:11.64,0:12:14.83,Default,,0000,0000,0000,,А... Иә, жақсы...
Dialogue: 0,0:12:14.83,0:12:17.87,Default,,0000,0000,0000,,Мии де барады! Менің баратын жолым жоқ.
Dialogue: 0,0:12:17.87,0:12:19.05,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:12:19.05,0:12:23.59,Default,,0000,0000,0000,,Мей де, қасқырдан сақ бол!
Dialogue: 0,0:12:23.59,0:12:26.62,Default,,0000,0000,0000,,Абайлаңыз! Мии!
Dialogue: 0,0:12:26.62,0:12:28.31,Default,,0000,0000,0000,,Иә? не?
Dialogue: 0,0:12:28.31,0:12:30.66,Default,,0000,0000,0000,,Иә? не? Жоқ!
Dialogue: 0,0:12:30.66,0:12:34.86,Default,,0000,0000,0000,,Мен мұны талай рет айттым. Қасқыр деген не?
Dialogue: 0,0:12:34.86,0:12:37.90,Default,,0000,0000,0000,,Ол шынымен де қорқынышты!
Dialogue: 0,0:12:37.90,0:12:39.25,Default,,0000,0000,0000,,Әй, эй, Мэй!
Dialogue: 0,0:12:39.25,0:12:41.94,Default,,0000,0000,0000,,Әлі біткен жоқ!
Dialogue: 0,0:12:41.94,0:12:43.94,Default,,0000,0000,0000,,Мен асығып тұрмын.
Dialogue: 0,0:12:45.15,0:12:49.18,Default,,0000,0000,0000,,Мен бүгін кешікпеймін.
Dialogue: 0,0:12:49.18,0:12:51.18,Default,,0000,0000,0000,,Әй, Ғабу! Ха!
Dialogue: 0,0:14:29.18,0:14:31.54,Default,,0000,0000,0000,,Әй, Ғабу! иә?
Dialogue: 0,0:14:31.54,0:14:35.74,Default,,0000,0000,0000,,Не, әлі ішің ауырып тұр ма?
Dialogue: 0,0:14:35.74,0:14:39.28,Default,,0000,0000,0000,,А... жоқ, қазір бәрі жақсы.
Dialogue: 0,0:14:39.28,0:14:41.63,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:14:41.63,0:14:45.00,Default,,0000,0000,0000,,Олай болса кеттік. сурет?
Dialogue: 0,0:14:45.00,0:14:49.54,Default,,0000,0000,0000,,Гило мырза сізге қамқорлық жасауымды өтінді.
Dialogue: 0,0:14:49.54,0:14:51.90,Default,,0000,0000,0000,,Жүр, кеттік.
Dialogue: 0,0:14:51.90,0:14:55.94,Default,,0000,0000,0000,,Мм... қайда бара жатырсың?
Dialogue: 0,0:14:55.94,0:14:58.64,Default,,0000,0000,0000,,Менің ойымша, біз аң аулауымыз керек.
Dialogue: 0,0:14:58.64,0:15:03.52,Default,,0000,0000,0000,,А... Иә.
Dialogue: 0,0:15:03.52,0:15:05.04,Default,,0000,0000,0000,,Мен тез кетуім керек...
Dialogue: 0,0:15:05.04,0:15:10.92,Default,,0000,0000,0000,,Бұл не? Сіз шындап тыңдағыңыз келмейді ме?
Dialogue: 0,0:15:10.92,0:15:14.30,Default,,0000,0000,0000,,Мен тыңдаймын. Егер бірдеңе болса→
Dialogue: 0,0:15:14.30,0:15:17.99,Default,,0000,0000,0000,,Мен, үлкен аға, ұрысады!
Dialogue: 0,0:15:17.99,0:15:19.85,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,0:15:19.85,0:15:21.20,Default,,0000,0000,0000,,Амансың ба?
Dialogue: 0,0:15:21.20,0:15:25.23,Default,,0000,0000,0000,,Жарайды, мен де барамын! Алақай!
Dialogue: 0,0:15:25.23,0:15:27.26,Default,,0000,0000,0000,,Иә! Ол шешілді!
Dialogue: 0,0:15:27.26,0:15:30.46,Default,,0000,0000,0000,,Жарайды, кеттік! Моро, сен де кел!
Dialogue: 0,0:15:30.46,0:15:33.82,Default,,0000,0000,0000,,Е, мен әлі тамақтанып жатырмын.
Dialogue: 0,0:15:33.82,0:15:38.20,Default,,0000,0000,0000,,Ах~ Сіз әрқашан тым көп жейсіз! Барайық!
Dialogue: 0,0:15:38.20,0:15:41.06,Default,,0000,0000,0000,,Міне, Мамыр!
Dialogue: 0,0:15:41.06,0:15:43.06,Default,,0000,0000,0000,,мамыр~!
Dialogue: 0,0:15:47.62,0:15:51.67,Default,,0000,0000,0000,,Уақытында үлгермеу. Мен уәде берсем де...
Dialogue: 0,0:15:51.67,0:15:53.86,Default,,0000,0000,0000,,Сіз мені күте аласыз ба?
Dialogue: 0,0:15:53.86,0:15:56.05,Default,,0000,0000,0000,,О? Не? Күте тұрыңыз ба?
Dialogue: 0,0:15:56.05,0:16:00.05,Default,,0000,0000,0000,,О, жоқ, ештеңе... бұл ештеңе емес!
Dialogue: 0,0:16:02.44,0:16:04.30,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:04.30,0:16:06.32,Default,,0000,0000,0000,,Габу?
Dialogue: 0,0:16:06.32,0:16:09.32,Default,,0000,0000,0000,,Күрсін... Бұл жерде жоқ.
Dialogue: 0,0:16:13.05,0:16:15.57,Default,,0000,0000,0000,,Ах! Не?
Dialogue: 0,0:16:15.57,0:16:17.26,Default,,0000,0000,0000,,Онда!
Dialogue: 0,0:16:17.26,0:16:19.94,Default,,0000,0000,0000,,Бұл ешкі!
Dialogue: 0,0:16:19.94,0:16:23.15,Default,,0000,0000,0000,,Ууу~ Ааа~.
Dialogue: 0,0:16:23.15,0:16:25.84,Default,,0000,0000,0000,,Сондай-ақ сиқыр сенің ерніңе де әсер етсін…
Dialogue: 0,0:16:25.84,0:16:28.53,Default,,0000,0000,0000,,Ги… Джиро мырза….
Dialogue: 0,0:16:28.53,0:16:30.53,Default,,0000,0000,0000,,Уау! !
Dialogue: 0,0:16:33.75,0:16:36.75,Default,,0000,0000,0000,,Әй, Гило мырза! Күте тұрыңыз!
Dialogue: 0,0:16:40.65,0:16:42.01,Default,,0000,0000,0000,,(сыбырлау)
Dialogue: 0,0:16:42.01,0:16:44.53,Default,,0000,0000,0000,,Уау! Хехе.
Dialogue: 0,0:16:44.53,0:16:46.22,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:16:46.22,0:16:48.24,Default,,0000,0000,0000,,Иә?иә?
Dialogue: 0,0:16:48.24,0:17:03.89,Default,,0000,0000,0000,,～
Dialogue: 0,0:17:03.89,0:17:05.89,Default,,0000,0000,0000,,Э? Естімеймін.
Dialogue: 0,0:17:10.12,0:17:13.48,Default,,0000,0000,0000,,Gi…. Гило мырза!
Dialogue: 0,0:17:13.48,0:17:15.67,Default,,0000,0000,0000,,Гило мырза!
Dialogue: 0,0:17:15.67,0:17:18.87,Default,,0000,0000,0000,,Барри Габу-нии мырза!
Dialogue: 0,0:17:18.87,0:17:22.91,Default,,0000,0000,0000,,А-а... Джило мырза, Гило мырза...
Dialogue: 0,0:17:22.91,0:17:25.77,Default,,0000,0000,0000,,Аа, тынышталыңыз. Не болды?
Dialogue: 0,0:17:25.77,0:17:28.97,Default,,0000,0000,0000,,Сойсойо асуында... Мм... Сойсойо асуы! ?
Dialogue: 0,0:17:28.97,0:17:31.33,Default,,0000,0000,0000,,Шулы! Мені тыңда.
Dialogue: 0,0:17:31.33,0:17:33.86,Default,,0000,0000,0000,,Сонымен не болды?
Dialogue: 0,0:17:33.86,0:17:36.89,Default,,0000,0000,0000,,Ол жерде бір ақ ешкі бар еді, соны айттым...
Dialogue: 0,0:17:36.89,0:17:41.93,Default,,0000,0000,0000,,Ақ ешкі! Бұл өте тітіркендіргіш!
Dialogue: 0,0:17:41.93,0:17:44.93,Default,,0000,0000,0000,,Сосын, мистер Джило кенеттен...
Dialogue: 0,0:17:46.65,0:17:49.02,Default,,0000,0000,0000,,О, габ! Габу-нии! Ол жігіт...
Dialogue: 0,0:17:49.02,0:17:53.55,Default,,0000,0000,0000,,《Қиын, Гило мырза...》
Dialogue: 0,0:17:53.55,0:17:56.08,Default,,0000,0000,0000,,(Хироко) Һм? О…
Dialogue: 0,0:17:56.08,0:18:00.45,Default,,0000,0000,0000,,Сонымен... Мен бәрібір сені қуамын. иә.
Dialogue: 0,0:18:00.45,0:18:03.16,Default,,0000,0000,0000,,Гило мырза Қорқынышты болды... кенеттен.
Dialogue: 0,0:18:03.16,0:18:05.67,Default,,0000,0000,0000,,Мен бірдеңені дұрыс істемедім бе?
Dialogue: 0,0:18:05.67,0:18:07.36,Default,,0000,0000,0000,,Жоқ, уайымдамаңыз.
Dialogue: 0,0:18:07.36,0:18:10.36,Default,,0000,0000,0000,,Гило мырза баяғыда...
Dialogue: 0,0:18:12.90,0:18:14.92,Default,,0000,0000,0000,,Жоқ, ештеңе.
Dialogue: 0,0:18:14.92,0:18:18.30,Default,,0000,0000,0000,,А... (Бэрри) Тезірек! Иә!
Dialogue: 0,0:18:18.30,0:18:36.31,Default,,0000,0000,0000,,～
Dialogue: 0,0:18:36.31,0:18:38.34,Default,,0000,0000,0000,,Уау, бұл тез.
Dialogue: 0,0:18:38.34,0:18:50.96,Default,,0000,0000,0000,,～
Dialogue: 0,0:18:50.96,0:18:53.31,Default,,0000,0000,0000,,《Мамыр… мамыр….
Dialogue: 0,0:18:53.31,0:18:56.84,Default,,0000,0000,0000,,Өтінемін.
Dialogue: 0,0:18:56.84,0:18:59.05,Default,,0000,0000,0000,,Егер кешіксең, мен үйге барамын.
Dialogue: 0,0:18:59.05,0:19:02.40,Default,,0000,0000,0000,,《Сен мұны істей аласың! мамыр!
Dialogue: 0,0:19:02.40,0:19:04.09,Default,,0000,0000,0000,,Мен үйге ерте барамын! 》
Dialogue: 0,0:19:04.09,0:19:07.12,Default,,0000,0000,0000,,Бұл ажырасу.
Dialogue: 0,0:19:07.12,0:19:11.12,Default,,0000,0000,0000,,Екеуміз ажырассақ та жарайды!
Dialogue: 0,0:19:23.62,0:19:33.62,Default,,0000,0000,0000,,～
Dialogue: 0,0:19:42.64,0:19:45.83,Default,,0000,0000,0000,,Ұят болды...
Dialogue: 0,0:19:45.83,0:19:48.70,Default,,0000,0000,0000,,Сіздің сүйікті ақ ешкі жоғалып кетті.
Dialogue: 0,0:19:48.70,0:19:52.70,Default,,0000,0000,0000,,Бірақ бұл жақсы жүгіру болды.
Dialogue: 0,0:19:56.28,0:19:58.14,Default,,0000,0000,0000,,Ех! ? Бұл не? ?
Dialogue: 0,0:19:58.14,0:20:04.52,Default,,0000,0000,0000,,Әйтеуір... Сіз кенет байыпты болып кеттіңіз.
Dialogue: 0,0:20:04.52,0:20:08.57,Default,,0000,0000,0000,,Мен Гило мырзадан өтемін деп ешқашан ойламадым.
Dialogue: 0,0:20:08.57,0:20:12.77,Default,,0000,0000,0000,,Мүмкін сіз →
Dialogue: 0,0:20:12.77,0:20:14.79,Default,,0000,0000,0000,,Мүмкін сіз келесі бастық бола аласыз ба?
Dialogue: 0,0:20:14.79,0:20:17.79,Default,,0000,0000,0000,,Хаха.
Dialogue: 0,0:20:23.22,0:20:26.24,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:20:26.24,0:20:30.95,Default,,0000,0000,0000,,Мэй құтқарылды.
Dialogue: 0,0:20:30.95,0:20:34.49,Default,,0000,0000,0000,,Бірақ... енді бітті.
Dialogue: 0,0:20:34.49,0:20:36.01,Default,,0000,0000,0000,,Мэй жоқ →
Dialogue: 0,0:20:36.01,0:20:38.87,Default,,0000,0000,0000,,Сондықтан мен үйге қайттым.
Dialogue: 0,0:20:38.87,0:20:41.23,Default,,0000,0000,0000,,Бұл тұйыққа тірелді!
Dialogue: 0,0:20:41.23,0:20:44.93,Default,,0000,0000,0000,,Сондықтан.
Dialogue: 0,0:20:44.93,0:20:49.93,Default,,0000,0000,0000,,Бұл енді бір-бірімізді ешқашан көрмейтінімізді білдіреді.
Dialogue: 0,0:20:51.33,0:20:58.23,Default,,0000,0000,0000,,Мэй Мэй….
Dialogue: 0,0:20:58.23,0:21:03.12,Default,,0000,0000,0000,,мамыр~!
Dialogue: 0,0:21:03.12,0:21:06.14,Default,,0000,0000,0000,,Ум...
Dialogue: 0,0:21:06.14,0:21:09.67,Default,,0000,0000,0000,,Не? иә! ?
Dialogue: 0,0:21:09.67,0:21:16.74,Default,,0000,0000,0000,,мамыр! Неге мұндасың? ? Ах... кешіріңіз.
Dialogue: 0,0:21:16.74,0:21:18.76,Default,,0000,0000,0000,,Мей неге кешірім сұрайды?
Dialogue: 0,0:21:18.76,0:21:21.30,Default,,0000,0000,0000,,Өйткені мен үйге рұқсатсыз бардым.
Dialogue: 0,0:21:21.30,0:21:24.99,Default,,0000,0000,0000,,Себебі кешігіп қалдым→
Dialogue: 0,0:21:24.99,0:21:26.85,Default,,0000,0000,0000,,Мен ашуланып қалдым... Сіз ашулысыз ба?
Dialogue: 0,0:21:26.85,0:21:30.89,Default,,0000,0000,0000,,Иә? Мен қайттым →
Dialogue: 0,0:21:30.89,0:21:33.92,Default,,0000,0000,0000,,Мен осында күтіп отырдым →
Dialogue: 0,0:21:33.92,0:21:38.47,Default,,0000,0000,0000,,Менің досым келді, сондықтан онымен үйге барудан басқа амалым қалмады.
Dialogue: 0,0:21:38.47,0:21:43.52,Default,,0000,0000,0000,,Кешіріңіз. Сол үшін солай істедің бе?
Dialogue: 0,0:21:43.52,0:21:46.55,Default,,0000,0000,0000,,Маған ашуланғанымды айтып, үйге кеттім.
Dialogue: 0,0:21:46.55,0:21:49.74,Default,,0000,0000,0000,,Мен кеткенде неге сонша ашуланамын?
Dialogue: 0,0:21:49.74,0:21:51.26,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:21:51.26,0:21:57.49,Default,,0000,0000,0000,,Тіпті келесі бастық істемейді, бұл тұйыққа тіреледі!
Dialogue: 0,0:21:57.49,0:21:59.17,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:21:59.17,0:22:02.37,Default,,0000,0000,0000,,Бұл солай ма? Міне бітті.
Dialogue: 0,0:22:02.37,0:22:07.92,Default,,0000,0000,0000,,Ах, бұл. Иә, сол.
Dialogue: 0,0:22:07.92,0:22:12.30,Default,,0000,0000,0000,,Бұл әзіл. Ой, әзіл! ?
Dialogue: 0,0:22:12.30,0:22:15.00,Default,,0000,0000,0000,,Бәрін естіген жоқсың ғой?
Dialogue: 0,0:22:15.00,0:22:18.04,Default,,0000,0000,0000,,Не? Түсіну оңай болды!
Dialogue: 0,0:22:18.04,0:22:24.26,Default,,0000,0000,0000,,Аа... Мен де бүгін сәл кешігіп қалдым.
Dialogue: 0,0:22:24.26,0:22:28.30,Default,,0000,0000,0000,,Мэй де? Өйткені біз →
Dialogue: 0,0:22:28.30,0:22:32.17,Default,,0000,0000,0000,,Көп нәрсе бар, солай емес пе? әртүрлі?
Dialogue: 0,0:22:32.17,0:22:36.71,Default,,0000,0000,0000,,Біз жасырын доспыз ғой!
Dialogue: 0,0:22:36.71,0:22:50.68,Default,,0000,0000,0000,,～
Dialogue: 0,0:22:50.68,0:22:54.39,Default,,0000,0000,0000,,Күрсіну~ Бірақ бүгін біз қоштасуымыз керек.
Dialogue: 0,0:22:54.39,0:22:59.45,Default,,0000,0000,0000,,Дұрыс. Сонда енді қашан кездесеміз?
Dialogue: 0,0:22:59.45,0:23:06.51,Default,,0000,0000,0000,,Бұл тағы бір сигнал. Иә, мен оны асыға күтемін.
Dialogue: 0,0:23:06.51,0:23:10.38,Default,,0000,0000,0000,,Хехехе. Келесі жолы қайда барасыз?
Dialogue: 0,0:23:10.38,0:23:12.73,Default,,0000,0000,0000,,Келесі бастық Габу-сан?
Dialogue: 0,0:23:12.73,0:23:15.73,Default,,0000,0000,0000,,Болашақ бастық Габу-сан.
Dialogue: 0,0:23:17.95,0:23:21.66,Default,,0000,0000,0000,,Ләззат алу үшін сол жерге жеткенше күту керек.
Dialogue: 0,0:23:21.66,0:23:25.04,Default,,0000,0000,0000,,Енді маған айтпайсың ба?
Dialogue: 0,0:23:25.04,0:23:29.41,Default,,0000,0000,0000,,Мүмкін емес. Маған бірдеңе айтыңызшы.
Dialogue: 0,0:23:29.41,0:23:34.29,Default,,0000,0000,0000,,Өтінемін! Жақсы →
Dialogue: 0,0:23:34.29,0:23:36.29,Default,,0000,0000,0000,,А, Ғабу?
Dialogue: 0,0:23:40.85,0:23:44.89,Default,,0000,0000,0000,,Көру үшін тым жарық. Эх...
Dialogue: 0,0:23:44.89,0:23:48.43,Default,,0000,0000,0000,,Ол сол жерде көлеңкеде.
Dialogue: 0,0:23:48.43,0:23:52.97,Default,,0000,0000,0000,,Осы уақытқа дейін? Бұл дұрыс.
Dialogue: 0,0:23:52.97,0:23:57.36,Default,,0000,0000,0000,,Бұл таңқаларлық. Келесі бастық күткендей.
Dialogue: 0,0:23:57.36,0:24:02.74,Default,,0000,0000,0000,,Иә! ? Өйткені ол соншалықты алысқа баруы мүмкін.
Dialogue: 0,0:24:02.74,0:24:06.95,Default,,0000,0000,0000,,Аа, дұрыс. Бұл керемет Ғабу.
Dialogue: 0,0:24:06.95,0:24:09.97,Default,,0000,0000,0000,,Сіз одан да көп саяхаттадыңыз, солай ма?
Dialogue: 0,0:24:09.97,0:24:13.35,Default,,0000,0000,0000,,Аа, алысқа бару оңай.
Dialogue: 0,0:24:13.35,0:24:17.22,Default,,0000,0000,0000,,Бұл үлкен мәселе емес. Керемет.
Dialogue: 0,0:24:17.22,0:24:20.25,Default,,0000,0000,0000,,Жоқ, бұл ерекше ештеңе емес.
Dialogue: 0,0:24:20.25,0:24:24.63,Default,,0000,0000,0000,,Бұл керемет. Ендігі бастық Ғабу ғой.
Dialogue: 0,0:24:24.63,0:24:29.34,Default,,0000,0000,0000,,Ал, бастық дегеніміз не? Ах~!
Dialogue: 0,0:24:29.34,0:24:32.04,Default,,0000,0000,0000,,Әй Ғабу! ?
Dialogue: 0,0:24:32.04,0:24:38.04,Default,,0000,0000,0000,,Хахаха…. Хахаха….
Dialogue: 0,0:24:39.54,0:24:45.54,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
