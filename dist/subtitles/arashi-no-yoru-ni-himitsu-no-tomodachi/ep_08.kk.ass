Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:03:23.15,0:03:28.37,Default,,0000,0000,0000,,Уау, бұл ағынның суы әрқашан дәмді.
Dialogue: 0,0:03:28.37,0:03:32.24,Default,,0000,0000,0000,,Аа, егер сіз Мэймен бірге болсаңыз...
Dialogue: 0,0:03:32.24,0:03:37.46,Default,,0000,0000,0000,,Мэй: мм, дәмді екен, Ғабу.
Dialogue: 0,0:03:37.46,0:03:41.67,Default,,0000,0000,0000,,Дұрыс, Мамыр.
Dialogue: 0,0:03:41.67,0:03:46.38,Default,,0000,0000,0000,,Бұл одан да жақсы.
Dialogue: 0,0:03:46.38,0:03:49.75,Default,,0000,0000,0000,,Барри: Неліктен мұнда ешкілер бар?
Dialogue: 0,0:03:49.75,0:03:52.44,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:03:52.44,0:03:57.66,Default,,0000,0000,0000,,Мейді осында алып келсек, үлкен қиындыққа тап боламыз.
Dialogue: 0,0:03:57.66,0:04:01.37,Default,,0000,0000,0000,,Ах~ Жарқырап тұр.
Dialogue: 0,0:04:01.37,0:04:03.39,Default,,0000,0000,0000,,Ah~.
Dialogue: 0,0:04:03.39,0:04:06.39,Default,,0000,0000,0000,,2 адам: Хахаха!
Dialogue: 0,0:04:11.30,0:04:13.99,Default,,0000,0000,0000,,Мен шошып кеттім.
Dialogue: 0,0:04:13.99,0:04:17.02,Default,,0000,0000,0000,,Үш күн мүлде ұйықтамадым.
Dialogue: 0,0:04:17.02,0:04:20.39,Default,,0000,0000,0000,,Менің тісім қатты ауырып тұр.
Dialogue: 0,0:04:20.39,0:04:25.27,Default,,0000,0000,0000,,Күрсініңіз, бірақ менің ойымша, ауырсыну ақыры басылды.
Dialogue: 0,0:04:25.27,0:04:28.30,Default,,0000,0000,0000,,Габ! Аа, үйге қош келдіңіз.
Dialogue: 0,0:04:28.30,0:04:32.51,Default,,0000,0000,0000,,Сіздің тістеріңіз ше? О, қазір әлдеқайда оңай.
Dialogue: 0,0:04:32.51,0:04:35.38,Default,,0000,0000,0000,,Жарайды, көңіліңіз сәл қалды.
Dialogue: 0,0:04:35.38,0:04:40.42,Default,,0000,0000,0000,,Дұрыс, сәл жылдамырақ болуы керек. иә?
Dialogue: 0,0:04:40.42,0:04:42.61,Default,,0000,0000,0000,,Бүгін өте жақсы аң болды.
Dialogue: 0,0:04:42.61,0:04:45.14,Default,,0000,0000,0000,,Расында, сен аянышты екенсің.
Dialogue: 0,0:04:45.14,0:04:47.16,Default,,0000,0000,0000,,Тісім ауырғандықтан үйде қалуым керек.
Dialogue: 0,0:04:47.16,0:04:50.03,Default,,0000,0000,0000,,Күрсін, мен тойып қалдым.
Dialogue: 0,0:04:50.03,0:04:53.72,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:04:53.72,0:04:55.41,Default,,0000,0000,0000,,Бұл өте жаман, Ғаби.
Dialogue: 0,0:04:55.41,0:04:57.93,Default,,0000,0000,0000,,Ah~.
Dialogue: 0,0:04:57.93,0:05:02.93,Default,,0000,0000,0000,,Ұйқы алатын шығармын. Күрсін.
Dialogue: 0,0:05:11.73,0:05:14.26,Default,,0000,0000,0000,,Иә, иә, иә, барлығы.
Dialogue: 0,0:05:14.26,0:05:18.97,Default,,0000,0000,0000,,Иә, сапқа тұр.
Dialogue: 0,0:05:18.97,0:05:21.97,Default,,0000,0000,0000,,Міне! Колла!
Dialogue: 0,0:05:24.20,0:05:28.41,Default,,0000,0000,0000,,Дұрыс сапқа тұрыңыз.
Dialogue: 0,0:05:28.41,0:05:34.13,Default,,0000,0000,0000,,А, міне, міне... Барлығы дұрыс сапқа тұрыңдар.
Dialogue: 0,0:05:34.13,0:05:37.83,Default,,0000,0000,0000,,Әй, Мей Чан танымал.
Dialogue: 0,0:05:37.83,0:05:40.03,Default,,0000,0000,0000,,Уау! Қараңдар, қараңдар, бәрі→
Dialogue: 0,0:05:40.03,0:05:45.07,Default,,0000,0000,0000,,Мұғалімді тыңдап, осы жерде сапқа тұр.
Dialogue: 0,0:05:45.07,0:05:48.93,Default,,0000,0000,0000,,Иә, Мэй-нечан.
Dialogue: 0,0:05:48.93,0:05:52.15,Default,,0000,0000,0000,,Қайырлы таң баршаңызға.
Dialogue: 0,0:05:52.15,0:05:56.18,Default,,0000,0000,0000,,Қайырлы таң, мұғалім.
Dialogue: 0,0:05:56.18,0:05:58.87,Default,,0000,0000,0000,,Бүгін ауа райы өте жақсы.
Dialogue: 0,0:05:58.87,0:06:01.07,Default,,0000,0000,0000,,Бұл экскурсия үшін тамаша күн болды.
Dialogue: 0,0:06:01.07,0:06:06.45,Default,,0000,0000,0000,,Сыртқа шықпас бұрын мұғалім сізге үш сұрақ қояды→
Dialogue: 0,0:06:06.45,0:06:11.33,Default,,0000,0000,0000,,Барлығыңыз, дауыстап, көңілді жауап беріңіздер.
Dialogue: 0,0:06:11.33,0:06:13.69,Default,,0000,0000,0000,,Иә, түсіндім.
Dialogue: 0,0:06:13.69,0:06:15.88,Default,,0000,0000,0000,,Сонымен, бірінші нәрсе.
Dialogue: 0,0:06:15.88,0:06:20.75,Default,,0000,0000,0000,,Саяхат кезінде дәмді көрінетін шөп тапсаңыз→
Dialogue: 0,0:06:20.75,0:06:22.61,Default,,0000,0000,0000,,Барлығың не істейсіңдер?
Dialogue: 0,0:06:22.61,0:06:24.80,Default,,0000,0000,0000,,Тамақтану.
Dialogue: 0,0:06:24.80,0:06:27.99,Default,,0000,0000,0000,,Жоқ, Мичикуса жақсы емес.
Dialogue: 0,0:06:27.99,0:06:31.03,Default,,0000,0000,0000,,Тамағыңызды сол жерге келгеннен кейін ішіңіз.
Dialogue: 0,0:06:31.03,0:06:34.39,Default,,0000,0000,0000,,Енді екінші сұрағыңызға.
Dialogue: 0,0:06:34.39,0:06:38.10,Default,,0000,0000,0000,,Жолда жаңбыр жауатын сияқты болса, не істейсің?
Dialogue: 0,0:06:38.10,0:06:43.49,Default,,0000,0000,0000,,Үйге қайт! Иә, жақсы.
Dialogue: 0,0:06:43.49,0:06:46.35,Default,,0000,0000,0000,,Жаңбырда суланып, суық тиіп қалмас бұрын
Dialogue: 0,0:06:46.35,0:06:49.21,Default,,0000,0000,0000,,Тез үйге қайтайық.
Dialogue: 0,0:06:49.21,0:06:53.75,Default,,0000,0000,0000,,Енді үшінші және соңғы сұрақ.
Dialogue: 0,0:06:53.75,0:06:58.97,Default,,0000,0000,0000,,Саяхатта қасқыр келіп қалса, не істер едің?
Dialogue: 0,0:06:58.97,0:07:02.51,Default,,0000,0000,0000,,Қаш! жүгіріп кету!
Dialogue: 0,0:07:02.51,0:07:04.03,Default,,0000,0000,0000,,Ол Дзётаромен бірге.
Dialogue: 0,0:07:04.03,0:07:07.56,Default,,0000,0000,0000,,Иә, иә, иә, дұрыс.
Dialogue: 0,0:07:07.56,0:07:11.93,Default,,0000,0000,0000,,Қашыңыз және жеңіңіз. Бар күшіңізді салып қашыңыз.
Dialogue: 0,0:07:11.93,0:07:13.95,Default,,0000,0000,0000,,Иә, қаш!
Dialogue: 0,0:07:13.95,0:07:19.01,Default,,0000,0000,0000,,Иә, содан кейін қатарға тұрыңыз. Иә!
Dialogue: 0,0:07:19.01,0:07:22.54,Default,,0000,0000,0000,,Иә, кеттік.
Dialogue: 0,0:07:22.54,0:07:24.40,Default,,0000,0000,0000,,Ичи Ни Ичи Ни!
Dialogue: 0,0:07:24.40,0:07:32.31,Default,,0000,0000,0000,,Ичи Ни Ичи Ни! Ичи Ни Ичи Ни!
Dialogue: 0,0:07:32.31,0:07:35.83,Default,,0000,0000,0000,,Уау, бұл сүйкімді.
Dialogue: 0,0:07:35.83,0:07:37.02,Default,,0000,0000,0000,,Рас.
Dialogue: 0,0:07:37.02,0:07:41.23,Default,,0000,0000,0000,,Күлсін...біз де сүйкімді едік.
Dialogue: 0,0:07:41.23,0:07:43.92,Default,,0000,0000,0000,,Біз? Біз.
Dialogue: 0,0:07:43.92,0:07:48.13,Default,,0000,0000,0000,,Уфуфу, сондай сүйкімді!
Dialogue: 0,0:07:48.13,0:07:52.17,Default,,0000,0000,0000,,Хмм... мүлде сүйкімді емес.
Dialogue: 0,0:07:52.17,0:07:54.86,Default,,0000,0000,0000,,Мүлдем сүйкімді емес пе?
Dialogue: 0,0:07:54.86,0:08:00.59,Default,,0000,0000,0000,,Иә, отты жайлауларға аттанайық!
Dialogue: 0,0:08:00.59,0:08:02.11,Default,,0000,0000,0000,,Иә! ? Не? ше?
Dialogue: 0,0:08:02.11,0:08:05.63,Default,,0000,0000,0000,,Бұл әрқашан шабындық, солай ма?
Dialogue: 0,0:08:05.63,0:08:07.49,Default,,0000,0000,0000,,Әрқашан? Сонымен →
Dialogue: 0,0:08:07.49,0:08:10.02,Default,,0000,0000,0000,,Жыл сайынғы бірлескен экскурсия. Ха! ?
Dialogue: 0,0:08:10.02,0:08:13.55,Default,,0000,0000,0000,,Шөпті жазықтарға бірлескен экскурсия?
Dialogue: 0,0:08:13.55,0:08:17.76,Default,,0000,0000,0000,,Не, Мэй, сен неге таң қалдың?
Dialogue: 0,0:08:17.76,0:08:21.63,Default,,0000,0000,0000,,А... Мен таң қалған жоқпын.
Dialogue: 0,0:08:21.63,0:08:24.66,Default,,0000,0000,0000,,Отты жайлауларға бірлескен экскурсия...
Dialogue: 0,0:08:24.66,0:08:26.85,Default,,0000,0000,0000,,Бірлескен экскурсия
Dialogue: 0,0:08:26.85,0:08:33.42,Default,,0000,0000,0000,,Савасава, Парапарагахара және Сузусузу үстіртінің кішкентай балалары жиналды.
Dialogue: 0,0:08:33.42,0:08:38.30,Default,,0000,0000,0000,,Түскі ас ішу, жүгіру, жарысу
Dialogue: 0,0:08:38.30,0:08:42.30,Default,,0000,0000,0000,,Ойнау және жақсы нәрселерді алу. Ха! ?
Dialogue: 0,0:08:47.06,0:08:51.27,Default,,0000,0000,0000,,Күрсін! Күн сары.
Dialogue: 0,0:08:51.27,0:08:54.63,Default,,0000,0000,0000,,Менің басым айналады.
Dialogue: 0,0:08:54.63,0:09:00.68,Default,,0000,0000,0000,,Аа, қарным ашты, тура жүре алмаймын.
Dialogue: 0,0:09:00.68,0:09:05.07,Default,,0000,0000,0000,,Хмм, Мэй әлі келген жоқ.
Dialogue: 0,0:09:05.07,0:09:08.10,Default,,0000,0000,0000,,Әзірше...
Dialogue: 0,0:09:08.10,0:09:11.10,Default,,0000,0000,0000,,Ой... бұл жақсы емес.
Dialogue: 0,0:09:13.31,0:09:16.51,Default,,0000,0000,0000,,А, тезірек мамыр...
Dialogue: 0,0:09:16.51,0:09:19.37,Default,,0000,0000,0000,,А, мен қазір ұйықтап жатырмын.
Dialogue: 0,0:09:19.37,0:09:21.40,Default,,0000,0000,0000,,Менің де қарным ашты.
Dialogue: 0,0:09:21.40,0:09:28.80,Default,,0000,0000,0000,,Мен тезірек Мэймен кездескім келеді.
Dialogue: 0,0:09:28.80,0:09:31.33,Default,,0000,0000,0000,,Ха! ? Саяхатқа барасыз ба?
Dialogue: 0,0:09:31.33,0:09:35.70,Default,,0000,0000,0000,,Неліктен Мэй балалардың артынан жүруі керек?
Dialogue: 0,0:09:35.70,0:09:39.91,Default,,0000,0000,0000,,Жарайды, өйткені мен барғым келеді.
Dialogue: 0,0:09:39.91,0:09:43.12,Default,,0000,0000,0000,,Жақсы емес! Мэй енді кішкентай бала емес.
Dialogue: 0,0:09:43.12,0:09:47.66,Default,,0000,0000,0000,,《Ой, мен түртсем...》
Dialogue: 0,0:09:47.66,0:09:49.66,Default,,0000,0000,0000,,Мейдің ол жаққа барғаны жақсы емес.
Dialogue: 0,0:09:51.36,0:10:15.27,Default,,0000,0000,0000,,Ичи ни! Ичи ни!
Dialogue: 0,0:10:15.27,0:10:20.49,Default,,0000,0000,0000,,Әй, яхо! Мерекелер келе жатыр!
Dialogue: 0,0:10:20.49,0:10:23.52,Default,,0000,0000,0000,,Ичи ни! Ичи ни!
Dialogue: 0,0:10:23.52,0:10:27.73,Default,,0000,0000,0000,,Оу! Барлығы жасыл және жасыл!
Dialogue: 0,0:10:27.73,0:10:33.95,Default,,0000,0000,0000,,Ичи Ни Ичи Ни!
Dialogue: 0,0:10:33.95,0:10:37.32,Default,,0000,0000,0000,,Жоқ! Бұл өте дәмді көрінеді!
Dialogue: 0,0:10:37.32,0:10:42.37,Default,,0000,0000,0000,,Әй, мен төрт күннен бері ештеңе жеген жоқпын.
Dialogue: 0,0:10:42.37,0:10:48.77,Default,,0000,0000,0000,,Ахаха! Ичи! Ахаха! Ni! Ахаха!
Dialogue: 0,0:10:48.77,0:10:50.62,Default,,0000,0000,0000,,Жақсы, бұл көмектесті!
Dialogue: 0,0:10:50.62,0:10:54.82,Default,,0000,0000,0000,,Олай болса, көп рахмет...
Dialogue: 0,0:10:54.82,0:10:56.18,Default,,0000,0000,0000,,Құлайтындай… Бұл қылыш…
Dialogue: 0,0:10:56.18,0:11:00.21,Default,,0000,0000,0000,,Сіз не ойлап отырсыз?
Dialogue: 0,0:11:00.21,0:11:04.76,Default,,0000,0000,0000,,Эй, мен ант бердім! Мен енді ешқашан ешкі жемеймін.
Dialogue: 0,0:11:04.76,0:11:07.79,Default,,0000,0000,0000,,Жоқ, жоқ! Жоқ, жоқ!
Dialogue: 0,0:11:07.79,0:11:10.32,Default,,0000,0000,0000,,Мүлдем жоқ!
Dialogue: 0,0:11:10.32,0:11:12.01,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:11:12.01,0:11:17.39,Default,,0000,0000,0000,,Ичи Ни Ичи Ни!
Dialogue: 0,0:11:17.39,0:11:20.08,Default,,0000,0000,0000,,Ичи Ни Ичи Ни!
Dialogue: 0,0:11:20.08,0:11:24.46,Default,,0000,0000,0000,,О, құдайым.
Dialogue: 0,0:11:24.46,0:11:28.50,Default,,0000,0000,0000,,Ичи ни! Ичи ни! иә?
Dialogue: 0,0:11:28.50,0:11:32.71,Default,,0000,0000,0000,,Ичи Ни Ичи Ни! а? а?
Dialogue: 0,0:11:32.71,0:11:38.43,Default,,0000,0000,0000,,Ичи Ни Ичи Ни!
Dialogue: 0,0:11:38.43,0:11:42.14,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:11:42.14,0:11:44.33,Default,,0000,0000,0000,,Ах... у...
Dialogue: 0,0:11:44.33,0:11:46.68,Default,,0000,0000,0000,,Мұнда кел!
Dialogue: 0,0:11:46.68,0:11:52.90,Default,,0000,0000,0000,,Ичи Ни Ичи Ни! Хм... Иә?
Dialogue: 0,0:11:52.90,0:11:54.60,Default,,0000,0000,0000,,Ичи Ни Ичи Ни!
Dialogue: 0,0:11:54.60,0:11:58.80,Default,,0000,0000,0000,,Неге?
Dialogue: 0,0:11:58.80,0:12:04.52,Default,,0000,0000,0000,,Ичи Ни Ичи Ни!
Dialogue: 0,0:12:04.52,0:12:09.91,Default,,0000,0000,0000,,Неге бұлай істеп жатырсың? Мұнда кел, мені қағып ал!
Dialogue: 0,0:12:09.91,0:12:14.62,Default,,0000,0000,0000,,Кет! Иә, ол тоқтайды. Ичи ни!
Dialogue: 0,0:12:14.62,0:12:16.81,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:12:16.81,0:12:18.17,Default,,0000,0000,0000,,Иә, қауіпсіз...
Dialogue: 0,0:12:18.17,0:12:21.03,Default,,0000,0000,0000,,Біз отты далаға келдік.
Dialogue: 0,0:12:21.03,0:12:24.89,Default,,0000,0000,0000,,Барлығымыз, ойнайық!
Dialogue: 0,0:12:24.89,0:12:27.25,Default,,0000,0000,0000,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:12:27.25,0:12:29.25,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:12:32.64,0:12:36.85,Default,,0000,0000,0000,,Кет! Біраз уақыт өтті.
Dialogue: 0,0:12:36.85,0:12:40.71,Default,,0000,0000,0000,,Сіз жақсы көрінесіз. Ол мүлдем өзгермейді.
Dialogue: 0,0:12:40.71,0:12:42.57,Default,,0000,0000,0000,,Әлі де...
Dialogue: 0,0:12:42.57,0:12:44.59,Default,,0000,0000,0000,,Түс... Жылтыр...
Dialogue: 0,0:12:44.59,0:12:49.47,Default,,0000,0000,0000,,Жақсы иіс... (3 адам) Мұндағы шөп ең жақсы.
Dialogue: 0,0:12:49.47,0:12:52.34,Default,,0000,0000,0000,,А... Жоқ, мен ол жаққа бармаймын.
Dialogue: 0,0:12:52.34,0:12:57.39,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:12:57.39,0:13:05.63,Default,,0000,0000,0000,,～
Dialogue: 0,0:13:05.63,0:13:09.63,Default,,0000,0000,0000,,А, мені қоршап алды!
Dialogue: 0,0:14:44.96,0:14:53.04,Default,,0000,0000,0000,,(көңілді дауыс)
Dialogue: 0,0:14:53.04,0:14:55.06,Default,,0000,0000,0000,,Мен түсінбеймін.
Dialogue: 0,0:14:55.06,0:14:59.78,Default,,0000,0000,0000,,Иә, иә, бәрің, қарныңдарыңыз ашты ма?
Dialogue: 0,0:14:59.78,0:15:02.30,Default,,0000,0000,0000,,Менің қарным ашты!
Dialogue: 0,0:15:02.30,0:15:04.49,Default,,0000,0000,0000,,Менің қарным ашты!
Dialogue: 0,0:15:04.49,0:15:06.18,Default,,0000,0000,0000,,Иә Иә Иә!
Dialogue: 0,0:15:06.18,0:15:08.37,Default,,0000,0000,0000,,Ал, бәріңе, бәріңе!
Dialogue: 0,0:15:08.37,0:15:10.72,Default,,0000,0000,0000,,Түскі ас ішуді қалайсыз ба?
Dialogue: 0,0:15:10.72,0:15:13.41,Default,,0000,0000,0000,,Әрине, қалаймын.
Dialogue: 0,0:15:13.41,0:15:16.61,Default,,0000,0000,0000,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:15:16.61,0:15:18.63,Default,,0000,0000,0000,,Қасқыр келсе ше →
Dialogue: 0,0:15:18.63,0:15:21.66,Default,,0000,0000,0000,,Сен оны мына мүйізбен пышақтайсың.
Dialogue: 0,0:15:21.66,0:15:24.19,Default,,0000,0000,0000,,Сыртынан қарағанда, оның аяқтары күшті және күшті→
Dialogue: 0,0:15:24.19,0:15:26.05,Default,,0000,0000,0000,,Осылай орындаңыз →
Dialogue: 0,0:15:26.05,0:15:28.05,Default,,0000,0000,0000,,Ха... Уау!
Dialogue: 0,0:15:30.42,0:15:34.96,Default,,0000,0000,0000,,Itatata... Иә? Мэй?
Dialogue: 0,0:15:34.96,0:15:38.83,Default,,0000,0000,0000,,Иә, иә! Бастайық!
Dialogue: 0,0:15:38.83,0:15:41.52,Default,,0000,0000,0000,,Түскі спорт күні!
Dialogue: 0,0:15:41.52,0:15:46.41,Default,,0000,0000,0000,,Иә! Алақай!
Dialogue: 0,0:15:46.41,0:15:49.11,Default,,0000,0000,0000,,Спорт күні?
Dialogue: 0,0:15:49.11,0:15:52.63,Default,,0000,0000,0000,,Енді 100-ге дейін санайық!
Dialogue: 0,0:15:52.63,0:15:55.00,Default,,0000,0000,0000,,Мұнда бірінші келген команда!
Dialogue: 0,0:15:55.00,0:16:01.40,Default,,0000,0000,0000,,Жеңіс! Олай болса, жүр!
Dialogue: 0,0:16:01.40,0:16:12.34,Default,,0000,0000,0000,,１ ２ ３ ４ ５ ６ ７ ８ ９ １０！
Dialogue: 0,0:16:12.34,0:16:21.92,Default,,0000,0000,0000,,１１ １２ １３ １４ １５ １６ １７…。
Dialogue: 0,0:16:21.92,0:16:23.92,Default,,0000,0000,0000,,Спорт күні….
Dialogue: 0,0:16:27.15,0:16:32.37,Default,,0000,0000,0000,,４８ ４９ ５０ ５１！
Dialogue: 0,0:16:32.37,0:16:40.62,Default,,0000,0000,0000,,５２ ５３ ５４ ５５ ５６ ５７！
Dialogue: 0,0:16:40.62,0:16:44.65,Default,,0000,0000,0000,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:16:44.65,0:16:46.01,Default,,0000,0000,0000,,Бұл керемет!
Dialogue: 0,0:16:46.01,0:16:51.22,Default,,0000,0000,0000,,Мереке өз алдына!
Dialogue: 0,0:16:51.22,0:16:52.74,Default,,0000,0000,0000,,Өте көп!
Dialogue: 0,0:16:52.74,0:16:57.29,Default,,0000,0000,0000,,Ta…ta…→
Dialogue: 0,0:16:57.29,0:17:00.65,Default,,0000,0000,0000,,Барлығын жеуге болады! ?
Dialogue: 0,0:17:00.65,0:17:05.03,Default,,0000,0000,0000,,А... аа....
Dialogue: 0,0:17:05.03,0:17:11.26,Default,,0000,0000,0000,,Енді жоқ, енді ешкі жемеймін деп ант еттім→
Dialogue: 0,0:17:11.26,0:17:17.15,Default,,0000,0000,0000,,Бұл жай ғана ақ ешкі болуы мүмкін.
Dialogue: 0,0:17:17.15,0:17:21.15,Default,,0000,0000,0000,,Міне, солай болуы керек екеніне сенімдімін!
Dialogue: 0,0:17:23.55,0:17:27.25,Default,,0000,0000,0000,,Егер бұл және осы →
Dialogue: 0,0:17:27.25,0:17:29.61,Default,,0000,0000,0000,,Мен жақсы болғандай сезінемін.
Dialogue: 0,0:17:29.61,0:17:32.46,Default,,0000,0000,0000,,Құлайтындай… Бұл қылыш…
Dialogue: 0,0:17:32.46,0:17:34.46,Default,,0000,0000,0000,,Бірақ... бірақ.
Dialogue: 0,0:17:48.30,0:17:51.82,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:17:51.82,0:17:54.86,Default,,0000,0000,0000,,О, мен қалайша осылай ойлай аламын?
Dialogue: 0,0:17:54.86,0:17:56.88,Default,,0000,0000,0000,,Мен, мен….
Dialogue: 0,0:17:56.88,0:18:00.74,Default,,0000,0000,0000,,Мен ақымақ болдым.
Dialogue: 0,0:18:00.74,0:18:04.45,Default,,0000,0000,0000,,Бакагабу Бакагабу! Ақымақ, ақымақ, ақымақ!
Dialogue: 0,0:18:04.45,0:18:11.19,Default,,0000,0000,0000,,９６ ９７ ９８ ９９ １００！
Dialogue: 0,0:18:11.19,0:18:14.72,Default,,0000,0000,0000,,Бәріңе сәлем. тоқта.
Dialogue: 0,0:18:14.72,0:18:17.08,Default,,0000,0000,0000,,Ақымақ, ақымақ! мұғалім!
Dialogue: 0,0:18:17.08,0:18:20.95,Default,,0000,0000,0000,,Ішінде біреу бар ма? Иә?
Dialogue: 0,0:18:20.95,0:18:22.14,Default,,0000,0000,0000,,Мен бір дауысты естідім. Не?
Dialogue: 0,0:18:22.14,0:18:26.17,Default,,0000,0000,0000,,Мен сені ақымақ деп естідім. Шынымен бе?
Dialogue: 0,0:18:26.17,0:18:29.37,Default,,0000,0000,0000,,《Ах! Жақсы, жаман емес.
Dialogue: 0,0:18:29.37,0:18:31.73,Default,,0000,0000,0000,,Оған көз салмаңыз.
Dialogue: 0,0:18:31.73,0:18:34.25,Default,,0000,0000,0000,,Бұл қауіпті》
Dialogue: 0,0:18:34.25,0:18:36.94,Default,,0000,0000,0000,,А, иә, иә, иә, иә.
Dialogue: 0,0:18:36.94,0:18:38.46,Default,,0000,0000,0000,,Қайсысы жақсы болды?
Dialogue: 0,0:18:38.46,0:18:40.48,Default,,0000,0000,0000,,Ішінде бірдеңе бар ма?
Dialogue: 0,0:18:40.48,0:18:42.67,Default,,0000,0000,0000,,Мен бір дауысты естідім. Бұл күдікті.
Dialogue: 0,0:18:42.67,0:18:45.03,Default,,0000,0000,0000,,Иә, иә, тоқтаған жеріңізге оралыңыз. Жарайды, жарайды.
Dialogue: 0,0:18:45.03,0:18:48.06,Default,,0000,0000,0000,,Сіз мұны жасырдыңыз, солай ма?
Dialogue: 0,0:18:48.06,0:18:50.41,Default,,0000,0000,0000,,Сен иіс арқылы білесің бе?
Dialogue: 0,0:18:50.41,0:18:53.94,Default,,0000,0000,0000,,Жарайды. иіскеу!
Dialogue: 0,0:18:53.94,0:18:55.80,Default,,0000,0000,0000,,Оның қатты иісі бар емес пе?
Dialogue: 0,0:18:55.80,0:18:58.32,Default,,0000,0000,0000,,Дұрыс. о иә.
Dialogue: 0,0:18:58.32,0:19:00.34,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:19:00.34,0:19:02.86,Default,,0000,0000,0000,,А... мұрнын иіскемейді.
Dialogue: 0,0:19:02.86,0:19:04.38,Default,,0000,0000,0000,,Тез оралыңыз.
Dialogue: 0,0:19:04.38,0:19:06.90,Default,,0000,0000,0000,,Иә, иә, ең жақсысы қай жерде болды?
Dialogue: 0,0:19:06.90,0:19:08.09,Default,,0000,0000,0000,,Менің ойымша, бұл шамамен бірдей болды ма?
Dialogue: 0,0:19:08.09,0:19:10.28,Default,,0000,0000,0000,,Солай көрінеді.
Dialogue: 0,0:19:10.28,0:19:14.99,Default,,0000,0000,0000,,Иә, онда түскі спорт күні.
Dialogue: 0,0:19:14.99,0:19:16.51,Default,,0000,0000,0000,,Ұтыс!
Dialogue: 0,0:19:16.51,0:19:20.21,Default,,0000,0000,0000,,Уау! сызу!
Dialogue: 0,0:19:20.21,0:19:22.57,Default,,0000,0000,0000,,Ұтыс!
Dialogue: 0,0:19:22.57,0:19:25.77,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:19:25.77,0:19:28.77,Default,,0000,0000,0000,,Ха ха ха….
Dialogue: 0,0:19:33.68,0:19:36.68,Default,,0000,0000,0000,,Ха ха ха….
Dialogue: 0,0:19:39.23,0:19:41.25,Default,,0000,0000,0000,,Габ!
Dialogue: 0,0:19:41.25,0:19:44.25,Default,,0000,0000,0000,,Ха ха ха….
Dialogue: 0,0:19:48.16,0:19:49.84,Default,,0000,0000,0000,,《Габ? 》
Dialogue: 0,0:19:49.84,0:19:51.84,Default,,0000,0000,0000,,Хакушон!
Dialogue: 0,0:19:54.05,0:19:57.09,Default,,0000,0000,0000,,Хаааах! Гүх!
Dialogue: 0,0:19:57.09,0:20:00.28,Default,,0000,0000,0000,,Мен таң қалдым. не болды?
Dialogue: 0,0:20:00.28,0:20:05.50,Default,,0000,0000,0000,,О, жоқ, у...
Dialogue: 0,0:20:05.50,0:20:08.19,Default,,0000,0000,0000,,Бұл Мэй-оне-чан! Бұл Мэй-Нечан!
Dialogue: 0,0:20:08.19,0:20:11.89,Default,,0000,0000,0000,,Сәлем, бәріңе.
Dialogue: 0,0:20:11.89,0:20:13.74,Default,,0000,0000,0000,,《Мамыр! 》
Dialogue: 0,0:20:13.74,0:20:15.59,Default,,0000,0000,0000,,Иә, бұл соңғы ойын.
Dialogue: 0,0:20:15.59,0:20:19.14,Default,,0000,0000,0000,,Оны атаңыз және оның ішінде не бар екенін қараңыз! Ойын!
Dialogue: 0,0:20:19.14,0:20:21.99,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:20:21.99,0:20:24.02,Default,,0000,0000,0000,,《Ойында не бар? 》
Dialogue: 0,0:20:24.02,0:20:29.23,Default,,0000,0000,0000,,Мына бұталарда не жасырылған?
Dialogue: 0,0:20:29.23,0:20:32.43,Default,,0000,0000,0000,,Кәне, бәріміз болжап көрейік.
Dialogue: 0,0:20:32.43,0:20:34.78,Default,,0000,0000,0000,,Уф… Ах…
Dialogue: 0,0:20:34.78,0:20:36.31,Default,,0000,0000,0000,,О, анау кемпір. не?
Dialogue: 0,0:20:36.31,0:20:39.34,Default,,0000,0000,0000,,Басқа ойын ойнағыңыз келе ме?
Dialogue: 0,0:20:39.34,0:20:43.88,Default,,0000,0000,0000,,Сойосойо бұрыштық ойыны. Бұл не?
Dialogue: 0,0:20:43.88,0:20:46.08,Default,,0000,0000,0000,,Барлығымыз шетіне қарай жүгіреміз.
Dialogue: 0,0:20:46.08,0:20:50.11,Default,,0000,0000,0000,,Фуфуфуфу жарыс па? Иә жақсы.
Dialogue: 0,0:20:50.11,0:20:53.81,Default,,0000,0000,0000,,Бұл көңілді көрінеді, бірақ кешіріңіз.
Dialogue: 0,0:20:53.81,0:20:56.84,Default,,0000,0000,0000,,Бүгінгі ойын аяқталды.
Dialogue: 0,0:20:56.84,0:20:59.87,Default,,0000,0000,0000,,Сонымен қатар, жауап жасырылған.
Dialogue: 0,0:20:59.87,0:21:01.39,Default,,0000,0000,0000,,《Ол жасырын ба? 》 Бұл жасырын ба?
Dialogue: 0,0:21:01.39,0:21:03.08,Default,,0000,0000,0000,,Балғын және дәмді
Dialogue: 0,0:21:03.08,0:21:05.60,Default,,0000,0000,0000,,Мені барлығы табу керек.
Dialogue: 0,0:21:05.60,0:21:08.12,Default,,0000,0000,0000,,《Дәмді ме? «дәмді?
Dialogue: 0,0:21:08.12,0:21:10.65,Default,,0000,0000,0000,,Сонымен, бәрің дайынсыңдар ма?
Dialogue: 0,0:21:10.65,0:21:12.67,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,0:21:12.67,0:21:16.87,Default,,0000,0000,0000,,Сонымен ойында не бар?
Dialogue: 0,0:21:16.87,0:21:19.40,Default,,0000,0000,0000,,Эй Дон!
Dialogue: 0,0:21:19.40,0:21:21.25,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:21:21.25,0:21:23.25,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:21:27.65,0:21:30.17,Default,,0000,0000,0000,,Уау, уау.
Dialogue: 0,0:21:30.17,0:21:32.53,Default,,0000,0000,0000,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:21:32.53,0:21:34.53,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:21:40.78,0:21:43.81,Default,,0000,0000,0000,,Жұмсақ!
Dialogue: 0,0:21:43.81,0:21:45.33,Default,,0000,0000,0000,,Не? Жұмсақ па?
Dialogue: 0,0:21:45.33,0:21:49.70,Default,,0000,0000,0000,,Үлкен! сурет? үлкен?
Dialogue: 0,0:21:49.70,0:21:53.70,Default,,0000,0000,0000,,Ұзақ! иә? Ұзақ?
Dialogue: 0,0:22:06.21,0:22:09.91,Default,,0000,0000,0000,,Мен өз шегімдемін!
Dialogue: 0,0:22:09.91,0:22:13.91,Default,,0000,0000,0000,,Хмм! Уау!
Dialogue: 0,0:22:19.33,0:22:21.33,Default,,0000,0000,0000,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:22:25.06,0:22:27.91,Default,,0000,0000,0000,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:22:27.91,0:22:29.43,Default,,0000,0000,0000,,О, ау!
Dialogue: 0,0:22:29.43,0:22:32.64,Default,,0000,0000,0000,,Сен таптың, Тироль-чан. Шие.
Dialogue: 0,0:22:32.64,0:22:36.01,Default,,0000,0000,0000,,Не? бұл? иә?
Dialogue: 0,0:22:36.01,0:22:41.89,Default,,0000,0000,0000,,Иә, барлығы, Тироль-чан тапты.
Dialogue: 0,0:22:41.89,0:22:45.59,Default,,0000,0000,0000,,Жауабы шие.
Dialogue: 0,0:22:45.59,0:22:48.29,Default,,0000,0000,0000,,Шие?
Dialogue: 0,0:22:48.29,0:22:50.64,Default,,0000,0000,0000,,Иә. Иә.
Dialogue: 0,0:22:50.64,0:22:54.85,Default,,0000,0000,0000,,Ойында не бар екенін болжаудың жеңімпазы - Тироль.
Dialogue: 0,0:22:54.85,0:22:56.71,Default,,0000,0000,0000,,Шие сенікі.
Dialogue: 0,0:22:56.71,0:22:59.90,Default,,0000,0000,0000,,Уау! Не, шие?
Dialogue: 0,0:22:59.90,0:23:02.10,Default,,0000,0000,0000,,Бірақ мен қоңыр шашты ұстадым.
Dialogue: 0,0:23:02.10,0:23:05.79,Default,,0000,0000,0000,,Тайғақ және жылы болды.
Dialogue: 0,0:23:05.79,0:23:07.49,Default,,0000,0000,0000,,Мен де!
Dialogue: 0,0:23:07.49,0:23:11.35,Default,,0000,0000,0000,,Иә иә иә Тиін тиді ме?
Dialogue: 0,0:23:11.35,0:23:16.23,Default,,0000,0000,0000,,Иә, бірақ жауап шие.
Dialogue: 0,0:23:16.23,0:23:18.76,Default,,0000,0000,0000,,Е.
Dialogue: 0,0:23:18.76,0:23:20.11,Default,,0000,0000,0000,,Жүгіру, жүгіру, жүгіру.
Dialogue: 0,0:23:20.11,0:23:22.47,Default,,0000,0000,0000,,Уау! Апыр-ай!
Dialogue: 0,0:23:22.47,0:23:25.16,Default,,0000,0000,0000,,Ой, жаңбыр жауатын сияқты!
Dialogue: 0,0:23:25.16,0:23:30.71,Default,,0000,0000,0000,,Жаңбыр жауатын сияқты болса, бәрің не істер едің?
Dialogue: 0,0:23:30.71,0:23:32.40,Default,,0000,0000,0000,,Үйге қайт!
Dialogue: 0,0:23:32.40,0:23:34.42,Default,,0000,0000,0000,,Иә, дұрыс!
Dialogue: 0,0:23:34.42,0:23:37.61,Default,,0000,0000,0000,,Үйге қайт!
Dialogue: 0,0:23:37.61,0:23:39.97,Default,,0000,0000,0000,,Олай болса тезірек үйге қайтайық.
Dialogue: 0,0:23:39.97,0:23:42.33,Default,,0000,0000,0000,,Иә, барлығы сапқа тұрады.
Dialogue: 0,0:23:42.33,0:23:45.20,Default,,0000,0000,0000,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:23:45.20,0:23:47.05,Default,,0000,0000,0000,,Иә, түсіндім!
Dialogue: 0,0:23:47.05,0:23:50.58,Default,,0000,0000,0000,,Келесі жылы кездескенше.
Dialogue: 0,0:23:50.58,0:23:53.10,Default,,0000,0000,0000,,Бірлескен саяхатта кездескенше.
Dialogue: 0,0:23:53.10,0:23:54.79,Default,,0000,0000,0000,,Иә, келесі жылы кездескенше.
Dialogue: 0,0:23:54.79,0:23:59.17,Default,,0000,0000,0000,,Ичи Ни Ичи Ни!
Dialogue: 0,0:23:59.17,0:24:02.86,Default,,0000,0000,0000,,күрсіну.
Dialogue: 0,0:24:02.86,0:24:04.72,Default,,0000,0000,0000,,Бір кезде мен не болар екен деп ойладым.
Dialogue: 0,0:24:04.72,0:24:07.08,Default,,0000,0000,0000,,Ах. (Іштің ырылдаған дыбысы)
Dialogue: 0,0:24:07.08,0:24:10.78,Default,,0000,0000,0000,,О? Ухуху.
Dialogue: 0,0:24:10.78,0:24:13.14,Default,,0000,0000,0000,,Тамақтанғыңыз келе ме? (Іштің ырылдаған дыбысы)
Dialogue: 0,0:24:13.14,0:24:14.66,Default,,0000,0000,0000,,Ах. Хехе.
Dialogue: 0,0:24:14.66,0:24:17.18,Default,,0000,0000,0000,,Өтінемін. Жарайды ма?
Dialogue: 0,0:24:17.18,0:24:19.53,Default,,0000,0000,0000,,Әрине.
Dialogue: 0,0:24:19.53,0:24:22.39,Default,,0000,0000,0000,,Онда мен аламын!
Dialogue: 0,0:24:22.39,0:24:24.75,Default,,0000,0000,0000,,Хмм, дәмді!
Dialogue: 0,0:24:24.75,0:24:27.78,Default,,0000,0000,0000,,Аа, сізге жақсы.
Dialogue: 0,0:24:27.78,0:24:29.13,Default,,0000,0000,0000,,Ах. а!
Dialogue: 0,0:24:29.13,0:24:31.82,Default,,0000,0000,0000,,Жаңбыр жауып тұр.
Dialogue: 0,0:24:31.82,0:24:34.85,Default,,0000,0000,0000,,Амансың ба? (Іштің ырылдаған дыбысы)
Dialogue: 0,0:24:34.85,0:24:37.85,Default,,0000,0000,0000,,Хаха, мен мұндай нәрсеге үйреніп қалдым!
