Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:31.15,0:00:33.15,Default,,0,0,0,,Аспан әлі қара болған кезде —
Dialogue: 0,0:00:33.99,0:00:37.03,Default,,0,0,0,,Бұл дүние аспанға қарай созылған жартастармен қоршалған.
Dialogue: 0,0:00:37.70,0:00:40.87,Default,,0,0,0,,Таңнан кешке дейін бұл дүниені түтін басып жатыр...
Dialogue: 0,0:00:41.58,0:00:44.21,Default,,0,0,0,,Сыртқы дүниені білмейтін бұл дүние...
Dialogue: 0,0:00:44.83,0:00:47.17,Default,,0,0,0,,Жұлдызды аспанды білмейтін бұл әлем
Dialogue: 0,0:00:47.75,0:00:50.55,Default,,0,0,0,,Менің әкем оны «Энтоцу қаласы» деп атады.
Dialogue: 0,0:00:52.21,0:00:54.76,Default,,0,0,0,,Өйткені онда тұрған бұршақ көп.
Dialogue: 0,0:00:56.55,0:00:57.93,Default,,0,0,0,,(велосипед дыбысы)
Dialogue: 0,0:00:59.22,0:01:01.06,Default,,0,0,0,,Не болды! Не болды!
Dialogue: 0,0:01:02.06,0:01:05.52,Default,,0,0,0,,Әй, міне, мінекей!
Dialogue: 0,0:01:05.60,0:01:06.98,Default,,0,0,0,,Йоишото
Dialogue: 0,0:01:07.06,0:01:09.11,Default,,0,0,0,,Келіңіздер! иә!
Dialogue: 0,0:01:11.07,0:01:13.44,Default,,0,0,0,,Демалыс күні әкем...
Dialogue: 0,0:01:13.53,0:01:17.62,Default,,0,0,0,,Мен қаладағылардың бәріне тамақсыз дүние туралы айттым.
Dialogue: 0,0:01:17.70,0:01:20.08,Default,,0,0,0,,Түнгі қаладағы соңғы түн
Dialogue: 0,0:01:20.16,0:01:23.04,Default,,0,0,0,,Бұл Бруно Камишибайдың басы.
Dialogue: 0,0:01:25.08,0:01:27.00,Default,,0,0,0,,Қара түтіннің арғы жағында
Dialogue: 0,0:01:27.08,0:01:29.21,Default,,0,0,0,,Жарқыраған дүние туралы әңгіме.
Dialogue: 0,0:01:30.59,0:01:33.13,Default,,0,0,0,,Сізге рахмет, әкем мені өтірікші деп атады.
Dialogue: 0,0:01:34.01,0:01:38.22,Default,,0,0,0,,Ешкім маған жұлдыз жоқ сияқты қараған жоқ.
Dialogue: 0,0:01:39.47,0:01:42.97,Default,,0,0,0,,Бұл қала сол қоқысшымен кездескенше
Dialogue: 0,0:01:44.23,0:01:48.40,Default,,0,0,0,,Бұл түнгі қаладағы соңғы түннің оқиғасы.
Dialogue: 0,0:01:50.06,0:01:52.27,Default,,0,0,0,,Лубитч~!
Dialogue: 0,0:01:52.78,0:01:57.03,Default,,0,0,0,,Тек төбеге қарасаң, аяғыңды сағынып, құлайсың!
Dialogue: 0,0:01:57.53,0:01:59.32,Default,,0,0,0,,Не? Апыр-ай!
Dialogue: 0,0:01:59.41,0:02:01.41,Default,,0,0,0,,♪~
Dialogue: 0,0:02:34.90,0:02:35.57,Default,,0,0,0,,Немесе 'Akiba's●lip'
Dialogue: 0,0:02:44.24,0:02:45.83,Default,,0,0,0,,Немесе 'Akiba's●lip'
Dialogue: 0,0:03:07.77,0:03:09.85,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:03:16.03,0:03:18.03,Default,,0,0,0,,~♪
Dialogue: 0,0:03:18.11,0:03:19.61,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:03:29.66,0:03:32.75,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:03:34.34,0:03:35.34,Default,,0,0,0,,Хаа…
Dialogue: 0,0:03:37.96,0:03:38.84,Default,,0,0,0,,Хаа…
Dialogue: 0,0:03:38.92,0:03:40.47,Default,,0,0,0,,（）
Dialogue: 0,0:03:44.89,0:03:46.43,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:47.60,0:03:48.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:50.81,0:03:55.02,Default,,0,0,0,,♪ Ла ла ла… Хэллоуин кеші
Dialogue: 0,0:03:55.11,0:03:57.19,Default,,0,0,0,,♪ Ла ла ла…
Dialogue: 0,0:03:57.27,0:03:59.03,Default,,0,0,0,,♪ Алдап көрейік!
Dialogue: 0,0:04:16.13,0:04:20.34,Default,,0,0,0,,♪ Жылына бір рет қорқынышты кеш,
Dialogue: 0,0:04:20.97,0:04:25.01,Default,,0,0,0,,♪ Біз өзімізді көрсететін түн
Dialogue: 0,0:04:25.09,0:04:29.43,Default,,0,0,0,,♪ Жасырмаңыз, маған тәттілер беруіңіз керек.
Dialogue: 0,0:04:29.52,0:04:33.14,Default,,0,0,0,,♪ Мен барлық еркеліктерді жасаймын.
Dialogue: 0,0:04:33.81,0:04:35.98,Default,,0,0,0,,♪ Кракен де!
Dialogue: 0,0:04:36.06,0:04:37.69,Default,,0,0,0,,♪ Гидраға қараңыз!
Dialogue: 0,0:04:37.77,0:04:42.11,Default,,0,0,0,,♪ Көрпеден шығып тұрған аяғым менің сүйікті тағамым.
Dialogue: 0,0:04:42.19,0:04:46.32,Default,,0,0,0,,♪ Ваннада! Төсектің астында!
Dialogue: 0,0:04:46.41,0:04:50.70,Default,,0,0,0,,♪ Тістері қайраңдап күттім.
Dialogue: 0,0:04:50.79,0:04:53.29,Default,,0,0,0,,♪ Бүгін кеш - Хэллоуин!
Dialogue: 0,0:04:53.37,0:04:55.21,Default,,0,0,0,,♪ Мұнда келіңіз
Dialogue: 0,0:04:55.29,0:04:57.54,Default,,0,0,0,,♪ Мен қорықпаймын.
Dialogue: 0,0:04:57.63,0:05:00.63,Default,,0,0,0,,♪ Мен қара мысықпын, ал айғай - мысық.
Dialogue: 0,0:05:00.71,0:05:01.26,Default,,0,0,0,,♪ Мияу!!
Dialogue: 0,0:05:01.34,0:05:05.68,Default,,0,0,0,,♪ Ла ла ла… Хэллоуин кеші
Dialogue: 0,0:05:05.76,0:05:08.05,Default,,0,0,0,,♪ Ла ла ла…
Dialogue: 0,0:05:08.14,0:05:09.85,Default,,0,0,0,,♪ Алдап көрейік!
Dialogue: 0,0:05:10.93,0:05:12.14,Default,,0,0,0,,♪ Трик-не-treat!
Dialogue: 0,0:05:12.22,0:05:13.39,Default,,0,0,0,,♪ Кәмпиттер, печенье,
Dialogue: 0,0:05:13.48,0:05:15.48,Default,,0,0,0,,♪ Донуттарды беріңізші
Dialogue: 0,0:05:15.56,0:05:16.40,Default,,0,0,0,,♪ Трик-не-treat!
Dialogue: 0,0:05:16.48,0:05:18.19,Default,,0,0,0,,♪ Шоколад, желе бұршақтары,
Dialogue: 0,0:05:18.27,0:05:19.52,Default,,0,0,0,,♪ бәліш
Dialogue: 0,0:05:19.61,0:05:20.98,Default,,0,0,0,,♪ Трик-не-treat!
Dialogue: 0,0:05:21.07,0:05:22.57,Default,,0,0,0,,♪ Кола, шейк және шай,
Dialogue: 0,0:05:22.65,0:05:23.78,Default,,0,0,0,,♪ Артық емес
Dialogue: 0,0:05:23.86,0:05:25.95,Default,,0,0,0,,♪ Трик-не-treat! Күте тұрыңыз...
Dialogue: 0,0:05:26.03,0:05:28.37,Default,,0,0,0,,♪ Трик-не-treat! Жоқ! Жоқ!
Dialogue: 0,0:05:28.45,0:05:29.49,Default,,0,0,0,,♪ Трик-не-treat!
Dialogue: 0,0:05:29.58,0:05:30.41,Default,,0,0,0,,♪ Жоқ! Жоқ! Жоқ! Жоқ!
Dialogue: 0,0:05:30.49,0:05:32.54,Default,,0,0,0,,♪ Трик-не-treat! Аххх~!!
Dialogue: 0,0:05:32.62,0:05:36.37,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:05:40.71,0:05:42.30,Default,,0,0,0,,Барлығы, егін қандай?
Dialogue: 0,0:05:42.38,0:05:43.51,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:05:43.59,0:05:45.13,Default,,0,0,0,,Мен мынамын
Dialogue: 0,0:05:45.22,0:05:46.76,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:05:46.84,0:05:47.63,Default,,0,0,0,,О!
Dialogue: 0,0:05:48.26,0:05:49.43,Default,,0,0,0,,Қоқысшылар ше?
Dialogue: 0,0:05:52.18,0:05:53.35,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:05:53.43,0:05:54.68,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:05:54.77,0:05:56.85,Default,,0,0,0,,Биылғы жылдың ең үздік ойыншысы - сіз.
Dialogue: 0,0:05:56.94,0:05:59.31,Default,,0,0,0,,Хе хехе
Dialogue: 0,0:06:00.15,0:06:01.40,Default,,0,0,0,,Ах! иә?
Dialogue: 0,0:06:01.48,0:06:04.44,Default,,0,0,0,,Бірақ мен сені қоқыс адам деп ойладым.
Dialogue: 0,0:06:05.03,0:06:07.91,Default,,0,0,0,,Қоқыс тауына дейін барып, қоқыс жинадың ба?
Dialogue: 0,0:06:07.99,0:06:09.99,Default,,0,0,0,,А? (Қоқыс адам) Бұл...
Dialogue: 0,0:06:12.28,0:06:13.20,Default,,0,0,0,,Уау
Dialogue: 0,0:06:13.29,0:06:14.83,Default,,0,0,0,,Сіз қоқыс ретінде киіне аласыз ба?
Dialogue: 0,0:06:14.91,0:06:16.41,Default,,0,0,0,,Муримури (қыз) уфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфу
Dialogue: 0,0:06:17.33,0:06:20.88,Default,,0,0,0,,Не? Барлығы... Иә?
Dialogue: 0,0:06:22.29,0:06:23.55,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:06:23.63,0:06:24.55,Default,,0,0,0,,А... Иә?
Dialogue: 0,0:06:25.21,0:06:26.59,Default,,0,0,0,,(Эмма) Барлығың жақсысыңдар ма? (Дон) Иә
Dialogue: 0,0:06:26.67,0:06:27.38,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:29.13,0:06:30.64,Default,,0,0,0,,Әй, ыстық!
Dialogue: 0,0:06:30.72,0:06:31.93,Default,,0,0,0,,Келесі жылы ауа райы жақсы болады...
Dialogue: 0,0:06:32.01,0:06:33.10,Default,,0,0,0,,Ah... of...
Dialogue: 0,0:06:33.18,0:06:34.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:34.10,0:06:35.43,Default,,0,0,0,,Жоқ, иә...
Dialogue: 0,0:06:35.52,0:06:37.52,Default,,0,0,0,,Неге қазір киіміңді шешпейсің?
Dialogue: 0,0:06:37.60,0:06:39.52,Default,,0,0,0,,Дұрыс, сондай сасық костюм.
Dialogue: 0,0:06:39.60,0:06:41.65,Default,,0,0,0,,Оны қазір шешіңіз (Қоқыс адамы) Мм...
Dialogue: 0,0:06:42.52,0:06:43.36,Default,,0,0,0,,Әй!
Dialogue: 0,0:06:44.11,0:06:45.03,Default,,0,0,0,,Кенеттен келгеніме кешірім өтінемін.
Dialogue: 0,0:06:45.11,0:06:46.40,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:06:46.49,0:06:48.57,Default,,0,0,0,,Иә? (Қоқыс адамы) О, жоқ...
Dialogue: 0,0:06:48.65,0:06:49.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:50.86,0:06:51.49,Default,,0,0,0,,Хмм?
Dialogue: 0,0:06:53.33,0:06:56.08,Default,,0,0,0,,Ха! Кя~!
Dialogue: 0,0:06:56.16,0:06:56.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:56.79,0:07:00.33,Default,,0,0,0,,Бұл... бұл жігіт костюм емес, ол нағыз Смоки.
Dialogue: 0,0:07:00.42,0:07:02.00,Default,,0,0,0,,Ах! (Қоқыс адам) Жоқ...
Dialogue: 0,0:07:02.08,0:07:03.17,Default,,0,0,0,,Кет! (Қоқыс адам) Эй...
Dialogue: 0,0:07:03.25,0:07:04.92,Default,,0,0,0,,Қоқыс адамы? (Қала тұрғыны) Бұл костюм емес пе?
Dialogue: 0,0:07:05.00,0:07:06.42,Default,,0,0,0,,Бұл елес Бұл елес!
Dialogue: 0,0:07:06.51,0:07:07.92,Default,,0,0,0,,бидғат! (Қаладағылар) Мені тістемейсің бе?
Dialogue: 0,0:07:08.01,0:07:10.26,Default,,0,0,0,,Бұл елес! (Қала тұрғындары) Хабарлаңыз!
Dialogue: 0,0:07:10.34,0:07:12.05,Default,,0,0,0,,Күте тұрыңыз, мен...
Dialogue: 0,0:07:12.64,0:07:14.56,Default,,0,0,0,,Сіз біздің достарымыздың бірісіз бе? Мен білмеймін
Dialogue: 0,0:07:14.64,0:07:15.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:15.22,0:07:17.06,Default,,0,0,0,,Мен сізге рұқсатсыз ердім.
Dialogue: 0,0:07:17.14,0:07:18.27,Default,,0,0,0,,Ум...
Dialogue: 0,0:07:18.35,0:07:19.73,Default,,0,0,0,,Мұнда келме (қоқысшы) А?
Dialogue: 0,0:07:20.35,0:07:24.36,Default,,0,0,0,,Егер инквизитор мені сенің қасыңда көрсе, қиналып қалар едім.
Dialogue: 0,0:07:24.44,0:07:25.65,Default,,0,0,0,,Кеттік (қоқысшы) А... мм.
Dialogue: 0,0:07:25.73,0:07:29.15,Default,,0,0,0,,Кешіріңіз, күте тұрыңыз.
Dialogue: 0,0:07:29.24,0:07:31.66,Default,,0,0,0,,Екеуміз жабысып қалғандықтан—
Dialogue: 0,0:07:32.32,0:07:34.24,Default,,0,0,0,,Уау! О...
Dialogue: 0,0:07:35.83,0:07:36.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:36.87,0:07:37.37,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:37.45,0:07:38.75,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:07:40.08,0:07:41.25,Default,,0,0,0,,Бұл!
Dialogue: 0,0:07:41.33,0:07:42.88,Default,,0,0,0,,Қаш (қоқыс адам) Иә?
Dialogue: 0,0:07:42.96,0:07:44.21,Default,,0,0,0,,Инквизитор
Dialogue: 0,0:07:44.29,0:07:45.54,Default,,0,0,0,,Жоқ... (Дороти) Тезірек!
Dialogue: 0,0:07:45.63,0:07:46.50,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:48.13,0:07:49.88,Default,,0,0,0,,Сай Сай Сай Сай Сай Сай Сай Сай Сай
Dialogue: 0,0:07:49.97,0:07:52.26,Default,,0,0,0,,Сай Сай Сай Сай Сай Сай Сай Сай Сай
Dialogue: 0,0:07:53.01,0:07:54.22,Default,,0,0,0,,Ол сол жаққа қашып кетті.
Dialogue: 0,0:07:54.30,0:07:56.05,Default,,0,0,0,,Сай Сай Сай Сай Сай Сай Сай Сай Сай
Dialogue: 0,0:07:59.14,0:08:02.56,Default,,0,0,0,,Хаа хии фуу фуу...
Dialogue: 0,0:08:02.64,0:08:03.52,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:05.11,0:08:06.73,Default,,0,0,0,,Сонда... Уф...
Dialogue: 0,0:08:06.82,0:08:08.73,Default,,0,0,0,,А? Ммммммм
Dialogue: 0,0:08:08.82,0:08:09.53,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:10.07,0:08:11.65,Default,,0,0,0,,Қарғыс атсын! Ойшо
Dialogue: 0,0:08:15.32,0:08:16.74,Default,,0,0,0,,Сай Сай Сай Сай
Dialogue: 0,0:08:16.83,0:08:18.95,Default,,0,0,0,,Сай Сай Сай Сай Сай Сай Сай Сай Сай
Dialogue: 0,0:08:19.45,0:08:19.95,Default,,0,0,0,,Хмм
Dialogue: 0,0:08:20.04,0:08:22.00,Default,,0,0,0,,Сай Сай Сай Сай Сай Сай Сай Сай Сай
Dialogue: 0,0:08:22.08,0:08:23.87,Default,,0,0,0,,Хаа…
Dialogue: 0,0:08:23.96,0:08:25.75,Default,,0,0,0,,Бұл қан сенікі емес; бұл Абдулдің қаны.
Dialogue: 0,0:08:26.54,0:08:29.21,Default,,0,0,0,,Уау~ Ах!
Dialogue: 0,0:08:29.30,0:08:31.72,Default,,0,0,0,,Ааа~
Dialogue: 0,0:08:31.80,0:08:33.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:33.84,0:08:34.72,Default,,0,0,0,,Сендер-ай, шіркін!
Dialogue: 0,0:08:34.80,0:08:37.01,Default,,0,0,0,,Не? иә? Ах...
Dialogue: 0,0:08:42.68,0:08:43.60,Default,,0,0,0,,Буха!
Dialogue: 0,0:08:49.11,0:08:51.03,Default,,0,0,0,,А? а?
Dialogue: 0,0:08:51.78,0:08:52.95,Default,,0,0,0,,Сырт келбеті өзгергенімен, ата-ана мен бала арасындағы байланыс бізді біріктіреді.
Dialogue: 0,0:08:53.74,0:08:54.49,Default,,0,0,0,,О...
Dialogue: 0,0:09:01.37,0:09:04.21,Default,,0,0,0,,Егер сіз жай ғана аспанға қарасаңыз ше?
Dialogue: 0,0:09:04.29,0:09:08.00,Default,,0,0,0,,Асбұршақ тазалау – өмірге қауіпті жұмыс.
Dialogue: 0,0:09:08.09,0:09:09.96,Default,,0,0,0,,Егер бірдеңе болса...
Dialogue: 0,0:09:10.05,0:09:12.21,Default,,0,0,0,,Анам жалғыз қалады.
Dialogue: 0,0:09:13.47,0:09:14.88,Default,,0,0,0,,Ойланып көрші, Любич
Dialogue: 0,0:09:14.97,0:09:17.22,Default,,0,0,0,,Хэллоуинге бармағаныңызға қуаныштысыз ба?
Dialogue: 0,0:09:17.30,0:09:19.93,Default,,0,0,0,,Маған кеспе тазалау ұнайды.
Dialogue: 0,0:09:20.01,0:09:22.47,Default,,0,0,0,,Кәмпит күйеден жақсы
Dialogue: 0,0:09:23.56,0:09:25.98,Default,,0,0,0,,Сен оларға бүгін жұмысқа келгеніңді айттың ба?
Dialogue: 0,0:09:26.73,0:09:27.52,Default,,0,0,0,,Анама –
Dialogue: 0,0:09:27.60,0:09:29.86,Default,,0,0,0,,Хэллоуин болғандықтан, мен достарыммен араласуды шештім.
Dialogue: 0,0:09:29.94,0:09:31.28,Default,,0,0,0,,О ла ла ла ля~
Dialogue: 0,0:09:32.15,0:09:35.15,Default,,0,0,0,,Ол күйемен жабылған.
Dialogue: 0,0:09:35.24,0:09:35.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:35.90,0:09:37.49,Default,,0,0,0,,Сіз қалай алдайсыз?
Dialogue: 0,0:09:38.82,0:09:39.99,Default,,0,0,0,,О ха ха ха
Dialogue: 0,0:09:40.08,0:09:41.49,Default,,0,0,0,,Мен бұл туралы қазір ойланамын
Dialogue: 0,0:09:42.16,0:09:43.33,Default,,0,0,0,,Бұдан былай...
Dialogue: 0,0:09:43.41,0:09:45.83,Default,,0,0,0,,Сіздің достарыңыз бар...
Dialogue: 0,0:09:46.42,0:09:47.42,Default,,0,0,0,,Эй (Сью) Ах.
Dialogue: 0,0:09:57.88,0:09:58.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:00.76,0:10:02.31,Default,,0,0,0,,Маған көмектесіңізші
Dialogue: 0,0:10:02.89,0:10:03.52,Default,,0,0,0,,​​О?
Dialogue: 0,0:10:05.64,0:10:09.06,Default,,0,0,0,,Маған көмектесіңізші!
Dialogue: 0,0:10:09.15,0:10:09.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:22.78,0:10:23.79,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:10:23.87,0:10:25.66,Default,,0,0,0,,(Ескерту дыбысы)
Dialogue: 0,0:10:25.75,0:10:29.00,Default,,0,0,0,,Эй, о...
Dialogue: 0,0:10:31.17,0:10:33.80,Default,,0,0,0,,Эй... Нһ...
Dialogue: 0,0:10:33.88,0:10:35.51,Default,,0,0,0,,Қауіпті Қауіпті
Dialogue: 0,0:10:35.59,0:10:37.47,Default,,0,0,0,,Ура! Кешіріңіз, кешіріңіз
Dialogue: 0,0:10:37.55,0:10:39.26,Default,,0,0,0,,Иә! баспалдақтар баспалдақтар
Dialogue: 0,0:10:39.34,0:10:40.30,Default,,0,0,0,,О-о!
Dialogue: 0,0:10:40.39,0:10:43.35,Default,,0,0,0,,Ah ho ho ho he? Біреу болды!
Dialogue: 0,0:10:43.43,0:10:46.43,Default,,0,0,0,,(Ескерту дыбысы)
Dialogue: 0,0:10:46.52,0:10:49.35,Default,,0,0,0,,(қоқыс адамның ыңырсыуы)
Dialogue: 0,0:10:49.44,0:10:53.48,Default,,0,0,0,,Ой! эй эй эй эй эй эй эй эй эй эй эй эй эй эй эй эй эй эй эй эй эй эй эй эй ей эй эй эй эй эй эй эй эй эй эй эй эй эй эй эй эй эй эй эй эй эй эй эй эй эй эй эй эй эй эй кенде
Dialogue: 0,0:10:53.57,0:10:55.36,Default,,0,0,0,,Ой! эй эй эй эй эй эй эй
Dialogue: 0,0:10:55.44,0:10:58.40,Default,,0,0,0,,(Ескерту дыбысы)
Dialogue: 0,0:10:58.49,0:11:01.37,Default,,0,0,0,,О~
Dialogue: 0,0:11:01.45,0:11:03.58,Default,,0,0,0,,Эй, эй, эй!
Dialogue: 0,0:11:05.08,0:11:06.37,Default,,0,0,0,,Мазалағаным үшін кешіріңіз!
Dialogue: 0,0:11:07.29,0:11:09.37,Default,,0,0,0,,Мазалағаным үшін кешіріңіз! баспалдақтар баспалдақтар
Dialogue: 0,0:11:09.46,0:11:11.00,Default,,0,0,0,,(Көлікте ойнайтын музыка)
Dialogue: 0,0:11:11.08,0:11:12.46,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:11:12.54,0:11:15.05,Default,,0,0,0,,Менің артымда біреу бар!
Dialogue: 0,0:11:15.63,0:11:17.05,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:11:17.13,0:11:18.05,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:11:19.51,0:11:21.09,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:11:23.18,0:11:26.60,Default,,0,0,0,,Хаа һаа һаа һаа…
Dialogue: 0,0:11:26.68,0:11:27.35,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:28.68,0:11:29.43,Default,,0,0,0,,Хаа
Dialogue: 0,0:11:32.65,0:11:33.90,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:11:33.98,0:11:36.15,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:11:38.28,0:11:39.61,Default,,0,0,0,,Ууууууууууууууу (қоқысшы) Кешіріңіз.
Dialogue: 0,0:11:39.69,0:11:41.45,Default,,0,0,0,,Уггугугу аа!
Dialogue: 0,0:11:44.45,0:11:46.58,Default,,0,0,0,,Унунуну... (Қоқыс адам) Ооооо~
Dialogue: 0,0:11:46.66,0:11:47.54,Default,,0,0,0,,Агагага!
Dialogue: 0,0:11:48.20,0:11:49.62,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:49.70,0:11:52.50,Default,,0,0,0,,Уау! Құбыжық!
Dialogue: 0,0:11:52.58,0:11:53.50,Default,,0,0,0,,Әй!
Dialogue: 0,0:11:53.58,0:11:55.63,Default,,0,0,0,,Зұлым рухтарды қуыңыз! (Қоқыс адам) Ауырады, ауырады
Dialogue: 0,0:11:55.71,0:11:57.63,Default,,0,0,0,,Қиын кезде ауырады. Қиын... Ауырды!
Dialogue: 0,0:11:57.71,0:11:59.01,Default,,0,0,0,,Не... сен несің!?
Dialogue: 0,0:11:59.09,0:12:02.76,Default,,0,0,0,,Кешіріңіз, мен... айтамын...
Dialogue: 0,0:12:02.84,0:12:04.76,Default,,0,0,0,,А, Хэллоуин костюмі?
Dialogue: 0,0:12:04.85,0:12:06.97,Default,,0,0,0,,Жоқ, олай емес сияқты...
Dialogue: 0,0:12:07.06,0:12:07.89,Default,,0,0,0,,Олай емес пе?
Dialogue: 0,0:12:07.97,0:12:10.43,Default,,0,0,0,,Мен әлі кішкентаймын...
Dialogue: 0,0:12:10.52,0:12:11.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:11.10,0:12:12.48,Default,,0,0,0,,О? не? Ах~!
Dialogue: 0,0:12:15.56,0:12:17.15,Default,,0,0,0,,Бұл жаман емес пе?
Dialogue: 0,0:12:17.23,0:12:19.40,Default,,0,0,0,,Жаман, тез түсуім керек.
Dialogue: 0,0:12:19.48,0:12:21.11,Default,,0,0,0,,Уау! (Қоқыс адам) Әй? не?
Dialogue: 0,0:12:21.19,0:12:22.32,Default,,0,0,0,,Алдымен, қазіргі жағдайды ескерсек—
Dialogue: 0,0:12:22.40,0:12:23.53,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:12:23.61,0:12:25.74,Default,,0,0,0,,«Сіз не істемексіз?» Жоқ!
Dialogue: 0,0:12:25.82,0:12:28.12,Default,,0,0,0,,Маған оны шығаруға көмектесіңіз, тез!
Dialogue: 0,0:12:28.20,0:12:29.49,Default,,0,0,0,,Ах... ха... иә.
Dialogue: 0,0:12:33.58,0:12:36.75,Default,,0,0,0,,Иә! (Қоқыс адам) Нунунуну...
Dialogue: 0,0:12:36.84,0:12:38.17,Default,,0,0,0,,Уф!
Dialogue: 0,0:12:38.71,0:12:41.05,Default,,0,0,0,,...
Dialogue: 0,0:12:41.13,0:12:42.01,Default,,0,0,0,,А? (Қоқыс адам) Әй?
Dialogue: 0,0:12:47.43,0:12:48.64,Default,,0,0,0,,Ааааааааааааааааааааааааа
Dialogue: 0,0:12:48.72,0:12:51.10,Default,,0,0,0,,Қауіпті Қауіпті Қауіпті
Dialogue: 0,0:12:51.18,0:12:52.98,Default,,0,0,0,,Қиындыққа тап болдым Қиындыққа!
Dialogue: 0,0:12:53.73,0:12:56.35,Default,,0,0,0,,Ах! Сыртқа шығып кетті... иә?
Dialogue: 0,0:12:56.44,0:12:58.36,Default,,0,0,0,,Бұл қауіпті, бұл қауіпті, бұл қауіпті
Dialogue: 0,0:12:58.44,0:12:59.65,Default,,0,0,0,,Мектепке қабылдау сыйы ретінде маған берілген тау велосипеді
Dialogue: 0,0:13:02.74,0:13:04.36,Default,,0,0,0,,Қауіпті Қауіпті Қауіпті
Dialogue: 0,0:13:04.45,0:13:05.41,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:05.49,0:13:06.41,Default,,0,0,0,,Нунуну~!
Dialogue: 0,0:13:07.99,0:13:09.49,Default,,0,0,0,,Міне! Ха!
Dialogue: 0,0:13:09.58,0:13:10.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:10.49,0:13:11.91,Default,,0,0,0,,Жоғары
Dialogue: 0,0:13:12.00,0:13:13.16,Default,,0,0,0,,Қорқынышты
Dialogue: 0,0:13:13.25,0:13:14.41,Default,,0,0,0,,Арх! Апыр-ай!
Dialogue: 0,0:13:14.50,0:13:15.54,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:13:15.62,0:13:16.42,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:13:16.50,0:13:18.67,Default,,0,0,0,,Екеуіміз асылып қалсақ, сынамыз.
Dialogue: 0,0:13:18.75,0:13:19.88,Default,,0,0,0,,Дәлірек айтсақ, сіз кімсіз?
Dialogue: 0,0:13:19.96,0:13:21.09,Default,,0,0,0,,Мен қоқысшымын
Dialogue: 0,0:13:21.17,0:13:21.88,Default,,0,0,0,,Қоқыс сол жерде
Dialogue: 0,0:13:21.96,0:13:23.84,Default,,0,0,0,,Жанбайтын қоқыстар да араласады.
Dialogue: 0,0:13:23.92,0:13:25.51,Default,,0,0,0,,Жағымсыз иіс
Dialogue: 0,0:13:25.59,0:13:27.68,Default,,0,0,0,,Енді маңызды емес пе?
Dialogue: 0,0:13:27.76,0:13:30.01,Default,,0,0,0,,Бұл қауіпті, мен тез арғы бетке өтуім керек.
Dialogue: 0,0:13:30.10,0:13:30.85,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:13:30.93,0:13:32.10,Default,,0,0,0,,Бірге емес.
Dialogue: 0,0:13:32.18,0:13:33.60,Default,,0,0,0,,Сіз мұны басқара аласыз ба?
Dialogue: 0,0:13:33.68,0:13:35.44,Default,,0,0,0,,Ей, шайқама, сынып қалады.
Dialogue: 0,0:13:36.65,0:13:37.69,Default,,0,0,0,,Көрдің бе?
Dialogue: 0,0:13:37.77,0:13:41.73,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:41.82,0:13:42.57,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:42.65,0:13:44.57,Default,,0,0,0,,Уа, ау!
Dialogue: 0,0:13:44.65,0:13:45.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:45.82,0:13:47.03,Default,,0,0,0,,Нонононо
Dialogue: 0,0:13:49.41,0:13:49.95,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:13:50.83,0:13:52.41,Default,,0,0,0,,Кууууууу!
Dialogue: 0,0:13:53.04,0:13:53.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:57.79,0:13:59.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:00.71,0:14:02.17,Default,,0,0,0,,Иә! (Қоқыс адам) Айта
Dialogue: 0,0:14:04.38,0:14:05.72,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:07.51,0:14:08.43,Default,,0,0,0,,Нунонононо
Dialogue: 0,0:14:08.51,0:14:10.26,Default,,0,0,0,,Ачачачача!
Dialogue: 0,0:14:11.35,0:14:12.01,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:13.60,0:14:15.06,Default,,0,0,0,,...
Dialogue: 0,0:14:15.14,0:14:16.77,Default,,0,0,0,,Ой-ау
Dialogue: 0,0:14:16.85,0:14:18.65,Default,,0,0,0,,Йойоёё…
Dialogue: 0,0:14:18.73,0:14:19.60,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:14:19.69,0:14:20.86,Default,,0,0,0,,Хаа... (қоқыс адам) А...
Dialogue: 0,0:14:27.70,0:14:28.61,Default,,0,0,0,,Әй?
Dialogue: 0,0:14:28.70,0:14:29.61,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:14:30.99,0:14:34.12,Default,,0,0,0,,Уау! (Қоқыс адам) Уау!
Dialogue: 0,0:14:36.08,0:14:37.12,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:37.21,0:14:37.87,Default,,0,0,0,,Ах
Dialogue: 0,0:14:38.71,0:14:40.08,Default,,0,0,0,,Хаа... (Қоқыс адамы) Иә?
Dialogue: 0,0:14:41.96,0:14:42.63,Default,,0,0,0,,Бұл тамаша!
Dialogue: 0,0:14:42.71,0:14:44.96,Default,,0,0,0,,Неліктен мен осыдан өтуім керек?
Dialogue: 0,0:14:45.05,0:14:46.72,Default,,0,0,0,,Мен саған айтамын, бәріне сен кінәлісің.
Dialogue: 0,0:14:46.80,0:14:49.80,Default,,0,0,0,,Біріншіден, мен біреуге көмектесемін деп қоқысқа секірдім...
Dialogue: 0,0:14:49.88,0:14:51.72,Default,,0,0,0,,Адамдар емес, қоқыс адамдар
Dialogue: 0,0:14:52.22,0:14:54.51,Default,,0,0,0,,Егер бұл қоқыс болса, оны сақтаудың қажеті жоқ еді.
Dialogue: 0,0:14:54.60,0:14:57.18,Default,,0,0,0,,Мен түсінбейтін жағдайға жеттім.
Dialogue: 0,0:14:57.27,0:14:59.27,Default,,0,0,0,,Сіз жауапкершілікті қалай аласыз?
Dialogue: 0,0:15:00.31,0:15:01.81,Default,,0,0,0,,Бұдан былай сен кінәлісің.
Dialogue: 0,0:15:01.90,0:15:02.98,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:03.69,0:15:04.61,Default,,0,0,0,,О, құдайым
Dialogue: 0,0:15:04.69,0:15:05.61,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:07.07,0:15:08.11,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:08.95,0:15:11.11,Default,,0,0,0,,Иә? Мен бірдеңе алдым
Dialogue: 0,0:15:16.95,0:15:19.96,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:15:20.04,0:15:22.92,Default,,0,0,0,,Аааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:15:23.00,0:15:25.30,Default,,0,0,0,,Ахх!
Dialogue: 0,0:15:25.38,0:15:27.96,Default,,0,0,0,,Бұрылу Бұрылысы
Dialogue: 0,0:15:28.05,0:15:30.63,Default,,0,0,0,,Вау-а-а-а-а
Dialogue: 0,0:15:33.80,0:15:37.47,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:38.06,0:15:39.31,Default,,0,0,0,,Әй, ау!
Dialogue: 0,0:15:46.02,0:15:46.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:48.82,0:15:50.74,Default,,0,0,0,,Тегіс тері
Dialogue: 0,0:15:51.70,0:15:52.24,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:15:55.37,0:15:57.45,Default,,0,0,0,,Иә? Хмм?
Dialogue: 0,0:15:57.54,0:15:58.62,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:58.70,0:16:00.75,Default,,0,0,0,,Қауіпті шығар.
Dialogue: 0,0:16:02.96,0:16:05.13,Default,,0,0,0,,Оңға қарай жылжытыңыз!
Dialogue: 0,0:16:05.21,0:16:07.13,Default,,0,0,0,,Біз тек адамбыз; бәрі біз қалағандай бола бермейді.
Dialogue: 0,0:16:14.97,0:16:15.97,Default,,0,0,0,,Хаа…
Dialogue: 0,0:16:16.05,0:16:16.97,Default,,0,0,0,,Енді керісінше!
Dialogue: 0,0:16:17.06,0:16:18.14,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:18.22,0:16:19.39,Default,,0,0,0,,(Барабан соғу дыбысы)
Dialogue: 0,0:16:25.86,0:16:26.77,Default,,0,0,0,,(Барабан соғу дыбысы)
Dialogue: 0,0:16:26.86,0:16:27.98,Default,,0,0,0,,Сол жақта
Dialogue: 0,0:16:28.07,0:16:30.32,Default,,0,0,0,,Жат! (Қоқыс адам) Өтінемін, жат!
Dialogue: 0,0:16:30.40,0:16:31.78,Default,,0,0,0,,(Танжиро) Уф… (Барабан соғу дыбысы)
Dialogue: 0,0:16:31.86,0:16:33.11,Default,,0,0,0,,(Барабан соғу дыбысы)
Dialogue: 0,0:16:33.20,0:16:34.66,Default,,0,0,0,,Фугия~! (2 адам) Шулы!
Dialogue: 0,0:16:34.74,0:16:36.87,Default,,0,0,0,,Мияу Мияу Мияу
Dialogue: 0,0:16:38.49,0:16:38.99,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:39.08,0:16:40.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:40.33,0:16:41.50,Default,,0,0,0,,О! Уф
Dialogue: 0,0:16:45.08,0:16:45.92,Default,,0,0,0,,Әйтеуір, ол жақында ғана қорқынышты сынақтан өтті
Dialogue: 0,0:16:46.00,0:16:47.59,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:16:47.67,0:16:48.55,Default,,0,0,0,,Ах
Dialogue: 0,0:16:50.00,0:16:51.26,Default,,0,0,0,,ше? Уау
Dialogue: 0,0:16:53.88,0:16:55.76,Default,,0,0,0,,Уау, аа...
Dialogue: 0,0:16:57.14,0:16:59.85,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:17:12.49,0:17:15.78,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:17:21.45,0:17:24.87,Default,,0,0,0,,Хаа... Шаршаған аяғы ауырады
Dialogue: 0,0:17:24.96,0:17:27.17,Default,,0,0,0,,Мен қашан шыға аламын?
Dialogue: 0,0:17:28.29,0:17:30.80,Default,,0,0,0,,Анашым, сіз уайымдап жатқан боларсыз.
Dialogue: 0,0:17:33.30,0:17:34.72,Default,,0,0,0,,Неге менің артымнан келе жатырсың?
Dialogue: 0,0:17:35.68,0:17:37.43,Default,,0,0,0,,Бір жол
Dialogue: 0,0:17:39.14,0:17:40.97,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:17:41.06,0:17:43.10,Default,,0,0,0,,Әзірге шығуда
Dialogue: 0,0:17:46.10,0:17:48.19,Default,,0,0,0,,Қайтаратын жеріңіз жоқ па?
Dialogue: 0,0:17:49.06,0:17:49.98,Default,,0,0,0,,Иә
Dialogue: 0,0:17:52.03,0:17:53.69,Default,,0,0,0,,Бұдан кейін қандай жоспарларыңыз бар?
Dialogue: 0,0:17:54.94,0:17:55.90,Default,,0,0,0,,Әсіресе
Dialogue: 0,0:17:57.16,0:17:58.87,Default,,0,0,0,,Сіз жалғызсыз ба?
Dialogue: 0,0:17:59.78,0:18:00.53,Default,,0,0,0,,Иә
Dialogue: 0,0:18:02.91,0:18:03.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:09.83,0:18:10.75,Default,,0,0,0,,Менің өтінішім бар!
Dialogue: 0,0:18:10.84,0:18:11.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:13.71,0:18:15.84,Default,,0,0,0,,Өтінемін, менімен дос бол!
Dialogue: 0,0:18:16.84,0:18:20.05,Default,,0,0,0,,Өтінемін, өтінемін, досым болшы, өтінемін!
Dialogue: 0,0:18:20.72,0:18:22.31,Default,,0,0,0,,Достар?
Dialogue: 0,0:18:22.39,0:18:24.10,Default,,0,0,0,,Иә дос
Dialogue: 0,0:18:25.35,0:18:27.81,Default,,0,0,0,,Томодачи дегеніміз не?
Dialogue: 0,0:18:27.89,0:18:31.06,Default,,0,0,0,,Ух... мм... менің қасымда тұрған біреу.
Dialogue: 0,0:18:31.15,0:18:32.82,Default,,0,0,0,,Міне, дәл осылай мүлдем әлсіз болу дегенді айтады, иә, Польнарефф?
Dialogue: 0,0:18:32.90,0:18:36.90,Default,,0,0,0,,Мен анама бүгін достарыммен ойнайтынымды айтып жатырмын.
Dialogue: 0,0:18:36.99,0:18:40.41,Default,,0,0,0,,Қараңызшы, Хэллоуинге дейін жұмыс істесеңіз, мен уайымдаймын.
Dialogue: 0,0:18:41.37,0:18:43.70,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:18:44.41,0:18:49.33,Default,,0,0,0,,Бүгін бірге ойнаған досым ретінде қасымда қалсаңшы.
Dialogue: 0,0:18:49.42,0:18:51.33,Default,,0,0,0,,Қасыңда болғаным дұрыс па?
Dialogue: 0,0:18:51.42,0:18:53.21,Default,,0,0,0,,Ей, оян.
Dialogue: 0,0:18:54.96,0:18:56.34,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:18:57.51,0:18:59.88,Default,,0,0,0,,Достар, мен бар күшімді саламын.
Dialogue: 0,0:18:59.97,0:19:01.14,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:19:01.22,0:19:02.68,Default,,0,0,0,,А... жоқ
Dialogue: 0,0:19:03.26,0:19:04.89,Default,,0,0,0,,Мен Любичпін, сіз ше?
Dialogue: 0,0:19:05.52,0:19:06.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:06.56,0:19:07.48,Default,,0,0,0,,Өтінемін, есікті ашыңдар
Dialogue: 0,0:19:08.14,0:19:08.77,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:19:09.27,0:19:10.27,Default,,0,0,0,,Бар емес пе?
Dialogue: 0,0:19:11.23,0:19:12.23,Default,,0,0,0,,Иә
Dialogue: 0,0:19:12.31,0:19:13.27,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:13.77,0:19:15.61,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:19:17.11,0:19:19.32,Default,,0,0,0,,Олай болса, Поупель
Dialogue: 0,0:19:20.57,0:19:22.37,Default,,0,0,0,,P…pe…le?
Dialogue: 0,0:19:22.45,0:19:23.78,Default,,0,0,0,,Иә Поупель
Dialogue: 0,0:19:23.87,0:19:26.91,Default,,0,0,0,,Өйткені ол Хэллоуин түнінде Хэллоуин Поупеллде пайда болды
Dialogue: 0,0:19:27.00,0:19:28.20,Default,,0,0,0,,Бұл сіздің атыңыз.
Dialogue: 0,0:19:29.46,0:19:31.71,Default,,0,0,0,,Хэллоуин мерекесі…
Dialogue: 0,0:19:31.79,0:19:34.38,Default,,0,0,0,,Бұл менің атым ба?
Dialogue: 0,0:19:35.09,0:19:37.96,Default,,0,0,0,,Иә, үйге бірге барайық, Поупель.
Dialogue: 0,0:19:38.05,0:19:40.76,Default,,0,0,0,,Мен де жуынбайынша үйге кіре алмаймын.
Dialogue: 0,0:19:40.84,0:19:43.43,Default,,0,0,0,,Сасық денеңді де жуайын.
Dialogue: 0,0:19:46.47,0:19:48.52,Default,,0,0,0,,Уау! Бұл не?
Dialogue: 0,0:19:50.35,0:19:52.19,Default,,0,0,0,,Иә? осында қосылған
Dialogue: 0,0:19:52.27,0:19:53.98,Default,,0,0,0,,Карта дұрыс емес.
Dialogue: 0,0:19:54.06,0:19:55.02,Default,,0,0,0,,Марконың бейбақы
Dialogue: 0,0:19:55.11,0:19:58.11,Default,,0,0,0,,Жоқ, жоқ, мүмкін компас істен шыққан шығар?
Dialogue: 0,0:19:58.19,0:20:00.57,Default,,0,0,0,,Екі мүмкіндік бар.
Dialogue: 0,0:20:00.65,0:20:01.78,Default,,0,0,0,,Эй, күте тұрыңыз.
Dialogue: 0,0:20:01.86,0:20:03.45,Default,,0,0,0,,Егер олардың біреуі ақылсыз болса —
Dialogue: 0,0:20:03.53,0:20:06.49,Default,,0,0,0,,Енді тереңірек қазған кезде мен неге сүйенуім керек?
Dialogue: 0,0:20:06.58,0:20:07.54,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:09.50,0:20:10.54,Default,,0,0,0,,Балалар сендер кімсіңдер!
Dialogue: 0,0:20:10.62,0:20:12.50,Default,,0,0,0,,Бұл жерге бейбіт тұрғындардың кіруіне тыйым салынады.
Dialogue: 0,0:20:12.58,0:20:15.21,Default,,0,0,0,,Неліктен шахтада бейбіт тұрғындар бар?
Dialogue: 0,0:20:15.29,0:20:17.05,Default,,0,0,0,,Түсіндім, түсіндім. Бұл себеп пе?
Dialogue: 0,0:20:17.13,0:20:19.63,Default,,0,0,0,,Шахтаның жабылу уақыты өтіп кетсе де, жүгіріп жүрсің...
Dialogue: 0,0:20:19.71,0:20:22.68,Default,,0,0,0,,Сіз шахта қазып жатырсыз. Сен менің қалтамды бопсалауға келдің.
Dialogue: 0,0:20:22.76,0:20:25.80,Default,,0,0,0,,Сен маған үндеме, ақша бер деп тұрсың ба?
Dialogue: 0,0:20:25.89,0:20:28.51,Default,,0,0,0,,Немесе мен алған түтінсіз мылтық
Dialogue: 0,0:20:28.60,0:20:30.39,Default,,0,0,0,,Бұл сіз бөлгіңіз келетін өлшем ме?
Dialogue: 0,0:20:30.48,0:20:32.14,Default,,0,0,0,,Әлде олар да ұры ма?
Dialogue: 0,0:20:32.23,0:20:35.90,Default,,0,0,0,,Сендер мен сияқтысыңдар, шахтаны жабуды мақсат тұтқан шахта ұрылары.
Dialogue: 0,0:20:35.98,0:20:39.36,Default,,0,0,0,,Ұры мен ұры Готцун Готцун Готцункомен кездесіп қалады
Dialogue: 0,0:20:39.44,0:20:42.65,Default,,0,0,0,,Мүмкіндіктер осы үшеуінің бірі.
Dialogue: 0,0:20:42.74,0:20:44.11,Default,,0,0,0,,Эй, сәл күте тұрыңыз.
Dialogue: 0,0:20:44.20,0:20:47.16,Default,,0,0,0,,Мен жаңа ғана өте маңызды үш құпияны айттым.
Dialogue: 0,0:20:47.24,0:20:48.08,Default,,0,0,0,,Мен үшін не істей аласың?
Dialogue: 0,0:20:48.16,0:20:49.16,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:20:49.24,0:20:50.58,Default,,0,0,0,,Үшеуі де өшірулі.
Dialogue: 0,0:20:50.66,0:20:52.71,Default,,0,0,0,,О, құдай-ау, үшеуі де өшірілді ме?
Dialogue: 0,0:20:52.79,0:20:54.12,Default,,0,0,0,,Олай болса балалар, сендер кімсіңдер?
Dialogue: 0,0:20:54.21,0:20:57.71,Default,,0,0,0,,Аа, сендерге тек өз атыңды айту дұрыс емес. Кешіріңіз.
Dialogue: 0,0:20:57.79,0:20:59.30,Default,,0,0,0,,Менің атым Скуп
Dialogue: 0,0:20:59.38,0:21:01.80,Default,,0,0,0,,Барлығы мені ``әңгімелейтін күрек'' деп атайды.
Dialogue: 0,0:21:01.88,0:21:04.72,Default,,0,0,0,,Менің ойымша, ол ауызды, бірақ оның кәсібі көмірші...
Dialogue: 0,0:21:04.80,0:21:05.72,Default,,0,0,0,,А, жоқ, олай емес.
Dialogue: 0,0:21:05.80,0:21:07.47,Default,,0,0,0,,Сіз шындықты айттыңыз ба?
Dialogue: 0,0:21:07.55,0:21:09.06,Default,,0,0,0,,Дұрыс, менің ұры.
Dialogue: 0,0:21:09.14,0:21:11.81,Default,,0,0,0,,Біріншіден, мен бүгін әлі қазбағанымды айтқым келеді.
Dialogue: 0,0:21:11.89,0:21:13.31,Default,,0,0,0,,Қаз және қаз, қаз және қаз —
Dialogue: 0,0:21:13.39,0:21:16.73,Default,,0,0,0,,Көріп отырғаныңыздай тек өсімдік қалдықтары ғана кездеседі.
Dialogue: 0,0:21:16.81,0:21:17.81,Default,,0,0,0,,Ах, кешіріңіз.
Dialogue: 0,0:21:17.90,0:21:20.98,Default,,0,0,0,,Ойлап қарасаң, жер бетінде тұратындар өсімдіктерді білмейсіңдер.
Dialogue: 0,0:21:21.07,0:21:22.74,Default,,0,0,0,,Жерде өсімдіктер жоқ.
Dialogue: 0,0:21:22.82,0:21:25.53,Default,,0,0,0,,Дегенмен, ерте заманда жер бетінде де өсімдіктер болған сияқты.
Dialogue: 0,0:21:25.61,0:21:28.91,Default,,0,0,0,,Біріншіден, өсімдіктер... О, күтіңіз, жоқ.
Dialogue: 0,0:21:28.99,0:21:30.03,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:21:30.12,0:21:31.83,Default,,0,0,0,,Мені қанша сөйлетесің?
Dialogue: 0,0:21:31.91,0:21:33.41,Default,,0,0,0,,Өзіңді неге тез таныстырмайсың?
Dialogue: 0,0:21:33.50,0:21:35.04,Default,,0,0,0,,Маған рұқсат етіңізші
Dialogue: 0,0:21:35.12,0:21:37.08,Default,,0,0,0,,Мен Лубичпін, бұршақ тазалаушымын.
Dialogue: 0,0:21:37.17,0:21:39.46,Default,,0,0,0,,Halloween Poupelle Қоқыс Адам
Dialogue: 0,0:21:39.54,0:21:40.96,Default,,0,0,0,,Қоқыс адамдары?
Dialogue: 0,0:21:41.80,0:21:44.05,Default,,0,0,0,,А, мен бүгін Хэллоуин болатын.
Dialogue: 0,0:21:44.13,0:21:46.80,Default,,0,0,0,,Бұл Хэллоуинде туылған қоқыс адамының көрінісі ме?
Dialogue: 0,0:21:46.88,0:21:48.22,Default,,0,0,0,,Орнату? Мен түсінемін.
Dialogue: 0,0:21:48.30,0:21:49.80,Default,,0,0,0,,Хэллоуин кешінде шу шығарғанда—
Dialogue: 0,0:21:49.89,0:21:51.39,Default,,0,0,0,,Міне сондықтан мен адасып қалдым.
Dialogue: 0,0:21:51.47,0:21:54.23,Default,,0,0,0,,Инквизитор сізді тапқанша асығыңыз және үйге жетіңіз.
Dialogue: 0,0:21:54.31,0:21:56.23,Default,,0,0,0,,Жоқ, сәл күте тұрыңыз, бұл біртүрлі емес пе?
Dialogue: 0,0:21:56.31,0:21:57.60,Default,,0,0,0,,Сіз кіммен сөйлесесіз?
Dialogue: 0,0:21:57.69,0:21:59.52,Default,,0,0,0,,Бұлай қоштасу дұрыс емес.
Dialogue: 0,0:21:59.61,0:22:01.65,Default,,0,0,0,,Өйткені дәл қазір мен сізге өте маңызды құпияны айтамын...
Dialogue: 0,0:22:01.73,0:22:03.23,Default,,0,0,0,,Мен үш нәрсені айтуға мәжбүр болдым.
Dialogue: 0,0:22:03.32,0:22:03.86,Default,,0,0,0,,Ал...
Dialogue: 0,0:22:03.94,0:22:06.07,Default,,0,0,0,,Жарайды, онда Лубитч Поупель Адамды орындайық
Dialogue: 0,0:22:06.15,0:22:07.20,Default,,0,0,0,,Бұл сәл басқаша.
Dialogue: 0,0:22:07.28,0:22:08.57,Default,,0,0,0,,Кел, мәміле жасайық
Dialogue: 0,0:22:08.66,0:22:11.91,Default,,0,0,0,,Жаңа ғана сіз маған өте маңызды үш құпияны айттыңыз.
Dialogue: 0,0:22:11.99,0:22:13.79,Default,,0,0,0,,Құпияны бәрінен жасыру.
Dialogue: 0,0:22:13.87,0:22:16.54,Default,,0,0,0,,Егер солай болса, сізге бір ғана өтініш сұрауға рұқсат етіңіз.
Dialogue: 0,0:22:16.62,0:22:17.67,Default,,0,0,0,,Жоқ, үш сұрақ қояйық.
Dialogue: 0,0:22:17.75,0:22:19.58,Default,,0,0,0,,Бұл тек жақсы нәрсе.
Dialogue: 0,0:22:19.67,0:22:21.04,Default,,0,0,0,,Мүмкін ол жақсы адам шығар
Dialogue: 0,0:22:21.13,0:22:22.42,Default,,0,0,0,,Жүр, тілегіңді айт.
Dialogue: 0,0:22:23.00,0:22:25.42,Default,,0,0,0,,А, өтінемін, мені шығуға апара аласыз ба?
Dialogue: 0,0:22:25.51,0:22:27.47,Default,,0,0,0,,Бұл арзан. Осы жолмен жүрейік.
Dialogue: 0,0:22:28.18,0:22:29.97,Default,,0,0,0,,Бұл қабырға, оны бұзыңыз.
Dialogue: 0,0:22:30.93,0:22:32.64,Default,,0,0,0,,(Бұрғылау дыбысы)
Dialogue: 0,0:22:33.31,0:22:35.93,Default,,0,0,0,,Бұл менің сауда құралым: түтінсіз мылтық
Dialogue: 0,0:22:42.27,0:22:44.86,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:22:47.95,0:22:50.70,Default,,0,0,0,,Көріп отырғаныңыздай, бұл түтін шығармайтын тамаша өнім.
Dialogue: 0,0:22:50.78,0:22:54.24,Default,,0,0,0,,Қарапайым мылтықты қолданғаннан оңай, бірақ мылтық мөлшерінде шамалы қателік жіберсеңіз...
Dialogue: 0,0:22:55.33,0:22:56.41,Default,,0,0,0,,Ауырсыну сезімі
Dialogue: 0,0:22:56.50,0:22:58.37,Default,,0,0,0,,Әуесқойлар оған тиіспеуі керек.
Dialogue: 0,0:22:59.54,0:23:00.54,Default,,0,0,0,,Қандай күн
Dialogue: 0,0:23:06.46,0:23:07.84,Default,,0,0,0,,
Dialogue: 0,0:23:13.89,0:23:14.97,Default,,0,0,0,,Мен үйдемін!
Dialogue: 0,0:23:15.68,0:23:17.60,Default,,0,0,0,,Қалай ойлайсың, сағат неше?
Dialogue: 0,0:23:17.68,0:23:19.14,Default,,0,0,0,,Мен досыммен ойнадым.
Dialogue: 0,0:23:19.23,0:23:21.27,Default,,0,0,0,,Не? дос?
Dialogue: 0,0:23:26.53,0:23:28.95,Default,,0,0,0,,Биылғы костюм үшін 1-ші сыйлық
Dialogue: 0,0:23:29.03,0:23:30.20,Default,,0,0,0,,Мен сені мазалап жүрмін
Dialogue: 0,0:23:30.82,0:23:34.45,Default,,0,0,0,,Бұл мен бүгін ойнаған досым.
Dialogue: 0,0:23:35.16,0:23:36.04,Default,,0,0,0,,Иә
Dialogue: 0,0:23:36.70,0:23:39.91,Default,,0,0,0,,Сізбен ұзақ болғаным үшін кешіріңіз.
Dialogue: 0,0:23:40.50,0:23:42.67,Default,,0,0,0,,Иісі қорқынышты, сондықтан мен оны жуамын.
Dialogue: 0,0:23:42.75,0:23:45.13,Default,,0,0,0,,Әлі де сасып тұр. Неліктен бұл жағымсыз иіс?
Dialogue: 0,0:23:45.21,0:23:47.51,Default,,0,0,0,,Енді үйрене аласыз ба?
Dialogue: 0,0:23:52.84,0:23:55.81,Default,,0,0,0,,Мен де сенің достарыңа кешкі ас әзірлеймін.
Dialogue: 0,0:23:56.43,0:23:57.43,Default,,0,0,0,,Иә
Dialogue: 0,0:23:58.31,0:23:59.14,Default,,0,0,0,,Иә
Dialogue: 0,0:23:59.23,0:24:00.43,Default,,0,0,0,,Жарайды
Dialogue: 0,0:24:00.52,0:24:01.56,Default,,0,0,0,,Жарайды
Dialogue: 0,0:24:05.31,0:24:07.44,Default,,0,0,0,,Иә~ Иә!
Dialogue: 0,0:24:07.53,0:24:08.82,Default,,0,0,0,,Рақмет сізге Поупель
Dialogue: 0,0:24:08.90,0:24:10.95,Default,,0,0,0,,Достар, бәрі жақсы өтті.
Dialogue: 0,0:24:11.03,0:24:12.45,Default,,0,0,0,,Иә, жұмыс істеді.
Dialogue: 0,0:24:12.53,0:24:14.95,Default,,0,0,0,,Менің досым жақсы болуы мүмкін.
Dialogue: 0,0:24:15.03,0:24:16.41,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:24:20.54,0:24:23.21,Default,,0,0,0,,
Dialogue: 0,0:24:29.26,0:24:31.84,Default,,0,0,0,,Оправкаға осылай орап жатқан жоқсың ба?
Dialogue: 0,0:24:32.88,0:24:35.76,Default,,0,0,0,,оны пішіндеу үшін—
Dialogue: 0,0:24:36.80,0:24:38.14,Default,,0,0,0,,Таңдаулы үлгіні қосыңыз
Dialogue: 0,0:24:38.22,0:24:39.43,Default,,0,0,0,,«Қажет болса», – дейді Джосуке. «Жарайды».
Dialogue: 0,0:24:40.35,0:24:41.39,Default,,0,0,0,,Воила!
Dialogue: 0,0:24:42.14,0:24:43.27,Default,,0,0,0,,Хо-хо-хо
Dialogue: 0,0:24:43.35,0:24:45.23,Default,,0,0,0,,Әрекетті жалғастырыңыз
Dialogue: 0,0:24:45.31,0:24:46.31,Default,,0,0,0,,Уау
Dialogue: 0,0:24:46.40,0:24:47.61,Default,,0,0,0,,Кішкентай, бірге жасайық.
Dialogue: 0,0:24:47.69,0:24:48.73,Default,,0,0,0,,Бұл Лубич.
Dialogue: 0,0:24:49.48,0:24:52.24,Default,,0,0,0,,А, бұл қиын.
Dialogue: 0,0:24:54.11,0:24:56.20,Default,,0,0,0,,Бруно айтты ма?
Dialogue: 0,0:24:56.28,0:24:58.99,Default,,0,0,0,,Иә, бұл есте сақтау туралы сияқты.
Dialogue: 0,0:25:02.50,0:25:04.75,Default,,0,0,0,,Неліктен түтін көтеріледі?
Dialogue: 0,0:25:04.83,0:25:08.42,Default,,0,0,0,,Иә? Ыстық болғандықтан ба?
Dialogue: 0,0:25:08.50,0:25:09.71,Default,,0,0,0,,Ыстық болғандықтан ба?
Dialogue: 0,0:25:09.80,0:25:12.55,Default,,0,0,0,,Әй, ыстықта ауа не болады?
Dialogue: 0,0:25:12.63,0:25:14.76,Default,,0,0,0,,Ол кеңейіп, жеңілірек болады.
Dialogue: 0,0:25:14.84,0:25:16.30,Default,,0,0,0,,Хмм.
Dialogue: 0,0:25:16.39,0:25:19.22,Default,,0,0,0,,Мен мектептегі достарыммен жақсы араласа алмайтын сияқтымын.
Dialogue: 0,0:25:19.85,0:25:21.77,Default,,0,0,0,,Инелік білезігі —
Dialogue: 0,0:25:21.85,0:25:24.44,Default,,0,0,0,,Бір күні Любич алға жылжиды.
Dialogue: 0,0:25:25.94,0:25:27.27,Default,,0,0,0,,Денеңіз қалай?
Dialogue: 0,0:25:27.36,0:25:29.36,Default,,0,0,0,,Иә, бұл өте жақсы.
Dialogue: 0,0:25:29.44,0:25:31.53,Default,,0,0,0,,Жұлдызша көрсеткішіңіз жиі дәл.
Dialogue: 0,0:25:31.61,0:25:32.78,Default,,0,0,0,,Мен қуаныштымын
Dialogue: 0,0:25:34.32,0:25:36.74,Default,,0,0,0,,Бірақ Бруноның науқас әйелі бар...
Dialogue: 0,0:25:36.82,0:25:39.20,Default,,0,0,0,,Сіз күнде кешке шығасыз, солай ма?
Dialogue: 0,0:25:39.28,0:25:40.53,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:25:40.62,0:25:43.66,Default,,0,0,0,,Тігіншінің жұмысы жақсы орындалған.
Dialogue: 0,0:25:43.75,0:25:46.37,Default,,0,0,0,,Мен қалтамды көрсеттім~
Dialogue: 0,0:25:59.85,0:26:02.97,Default,,0,0,0,,Бүгін түстен кейін Мандала қиылысының жанында—
Dialogue: 0,0:26:03.06,0:26:06.77,Default,,0,0,0,,Денесінде қоқыс бар күдікті адам пайда болды.
Dialogue: 0,0:26:06.85,0:26:11.57,Default,,0,0,0,,Төтенше жағдайларды басқару комитеті бидғат туралы ескерту жариялады.
Dialogue: 0,0:26:11.65,0:26:14.90,Default,,0,0,0,,Оны тапқан бойда дереу хабарлаңыз.
Dialogue: 0,0:26:14.99,0:26:16.32,Default,,0,0,0,,Қайталау…
Dialogue: 0,0:26:26.16,0:26:27.54,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:26:28.50,0:26:30.50,Default,,0,0,0,,Қоқыс қозғалады. (Тазалаушы) Шынайы ма?
Dialogue: 0,0:26:30.58,0:26:32.55,Default,,0,0,0,,Бұл қауіпті емес пе? (Тазалаушы) Бұл қауіпті.
Dialogue: 0,0:26:32.63,0:26:34.80,Default,,0,0,0,,Ху~ (Сью мырза) Хохо~
Dialogue: 0,0:26:34.88,0:26:37.72,Default,,0,0,0,,Бұл адамдар да Любич мырзаның достары ма?
Dialogue: 0,0:26:38.22,0:26:41.35,Default,,0,0,0,,Төбе тазалаушы Менің әріптесім.
Dialogue: 0,0:26:41.97,0:26:46.18,Default,,0,0,0,,Бұл инквизитор іздеп жүрген жігіт, қоқыс.
Dialogue: 0,0:26:46.27,0:26:47.77,Default,,0,0,0,,Оны қайдан таптың?
Dialogue: 0,0:26:47.85,0:26:49.65,Default,,0,0,0,,Мен бұл туралы хабарлауым керек.
Dialogue: 0,0:26:51.02,0:26:52.02,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:26:52.11,0:26:55.07,Default,,0,0,0,,Мен оған көмектесіп, оның атын Поупелл деп қойдым.
Dialogue: 0,0:26:55.15,0:26:56.61,Default,,0,0,0,,Бұл шын ба? Цун
Dialogue: 0,0:26:56.69,0:26:58.70,Default,,0,0,0,,Сәлем! Бұл қочобай
Dialogue: 0,0:26:58.78,0:26:59.78,Default,,0,0,0,,Дан!
Dialogue: 0,0:27:03.95,0:27:04.79,Default,,0,0,0,,Әй?
Dialogue: 0,0:27:05.87,0:27:07.29,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:27:07.37,0:27:08.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:27:10.62,0:27:13.09,Default,,0,0,0,,Сіз мені осында жасыра аласыз ба?
Dialogue: 0,0:27:13.17,0:27:14.75,Default,,0,0,0,,Мені осында жұмысқа аласың ба?
Dialogue: 0,0:27:17.55,0:27:19.76,Default,,0,0,0,,Сен ақымақтығыңды әкеңнен алғансың.
Dialogue: 0,0:27:19.84,0:27:22.64,Default,,0,0,0,,Қоқысшылардан тазалауды сұрайтын тұтынушылар қайда?
Dialogue: 0,0:27:22.72,0:27:23.80,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:27:23.89,0:27:24.76,Default,,0,0,0,,Қандай байланыс бар?
Dialogue: 0,0:27:26.56,0:27:27.77,Default,,0,0,0,,Біз доспыз.
Dialogue: 0,0:27:29.85,0:27:32.02,Default,,0,0,0,,Мен сені мұнда жұмыс істеуге рұқсат ете алмаймын.
Dialogue: 0,0:27:32.10,0:27:32.90,Default,,0,0,0,,Дан!
Dialogue: 0,0:27:32.98,0:27:34.44,Default,,0,0,0,,Постыңызға тез өтіңіз.
Dialogue: 0,0:27:35.32,0:27:37.23,Default,,0,0,0,,Қалғанын осында шешемін.
Dialogue: 0,0:27:37.32,0:27:38.36,Default,,0,0,0,,Уууууууу!!
Dialogue: 0,0:27:41.36,0:27:42.74,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:27:45.99,0:27:48.04,Default,,0,0,0,,Менің артымнан жүр, хаа
Dialogue: 0,0:28:09.52,0:28:11.85,Default,,0,0,0,,Хун хун хун~♪
Dialogue: 0,0:28:17.69,0:28:19.03,Default,,0,0,0,,А?
Dialogue: 0,0:28:23.16,0:28:24.87,Default,,0,0,0,,Олардың да отбасылары бар.
Dialogue: 0,0:28:25.53,0:28:28.83,Default,,0,0,0,,Маған осыдан көбірек назар аударылса, бұл қиын болады.
Dialogue: 0,0:28:34.83,0:28:38.34,Default,,0,0,0,,Мінезі дұрыс болмағандықтан, жұмыс киімдері тез бұзылады.
Dialogue: 0,0:28:39.34,0:28:40.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:40.34,0:28:41.72,Default,,0,0,0,,Моттайнай
Dialogue: 0,0:28:41.80,0:28:44.18,Default,,0,0,0,,Егер мұқият тігіп алсаңыз, ол қайта оралады.
Dialogue: 0,0:28:45.09,0:28:45.85,Default,,0,0,0,,Ах!
Dialogue: 0,0:28:46.68,0:28:47.85,Default,,0,0,0,,Тігін машинасын үйрену
Dialogue: 0,0:28:48.89,0:28:49.72,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:28:49.81,0:28:53.48,Default,,0,0,0,,Мұнда ешкімді кездестірудің қажеті жоқ. Тұрғын ретінде жұмыс жасаңыз.
Dialogue: 0,0:28:54.81,0:28:56.73,Default,,0,0,0,,Алдын ала төлеңіз. Ол бұзылмай тұрып жұмсаңыз.
Dialogue: 0,0:28:58.65,0:29:01.15,Default,,0,0,0,,Мұндағы дүкенші бір жыл бұрын қайтыс болды.
Dialogue: 0,0:29:01.90,0:29:03.32,Default,,0,0,0,,Оны еркін пайдалана аласыз.
Dialogue: 0,0:29:03.40,0:29:05.07,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:29:06.62,0:29:10.33,Default,,0,0,0,,Ол бірінші рет досын алып келді.
Dialogue: 0,0:29:11.12,0:29:13.21,Default,,0,0,0,,Рахмет, қоқысшы.
Dialogue: 0,0:29:13.29,0:29:14.58,Default,,0,0,0,,Эххе
Dialogue: 0,0:29:15.33,0:29:17.33,Default,,0,0,0,,А, бір ғана нәрсе, иә?
Dialogue: 0,0:29:17.42,0:29:19.84,Default,,0,0,0,,Сол денені шүберекпен немесе басқа нәрсемен жабыңыз.
Dialogue: 0,0:29:19.92,0:29:20.88,Default,,0,0,0,,Ах!
Dialogue: 0,0:29:21.67,0:29:22.80,Default,,0,0,0,,Мен...
Dialogue: 0,0:29:24.34,0:29:25.59,Default,,0,0,0,,Мен елестерді ұнатпаймын
Dialogue: 0,0:29:26.93,0:29:28.26,Default,,0,0,0,,Өте қорқынышты
Dialogue: 0,0:29:29.05,0:29:29.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:29:30.51,0:29:31.56,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:29:39.11,0:29:39.61,Default,,0,0,0,,Хаа…
Dialogue: 0,0:29:39.69,0:29:41.03,Default,,0,0,0,,Ах~
Dialogue: 0,0:29:41.11,0:29:43.78,Default,,0,0,0,,Дэн-санға қалдырсаңыз, бәрі жақсы болады.
Dialogue: 0,0:29:47.28,0:29:52.24,Default,,0,0,0,,(Тігін машинасының жұмыс дыбысы)
Dialogue: 0,0:30:05.63,0:30:06.43,Default,,0,0,0,,Хмм.
Dialogue: 0,0:30:06.51,0:30:07.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:12.10,0:30:14.77,Default,,0,0,0,,Удагава аймағында бір еретик ұсталды.
Dialogue: 0,0:30:14.85,0:30:18.44,Default,,0,0,0,,Сол көріпкел жұлдызды оқудың ұрпағы еді.
Dialogue: 0,0:30:18.52,0:30:20.19,Default,,0,0,0,,Жою
Dialogue: 0,0:30:20.27,0:30:21.27,Default,,0,0,0,,Хмм.
Dialogue: 0,0:30:21.36,0:30:24.32,Default,,0,0,0,,Сіз мұны қанша уақытқа дейін жалғастыра бересіз?
Dialogue: 0,0:30:24.40,0:30:28.16,Default,,0,0,0,,Еретиктермен қатаң түрде күресу керек
Dialogue: 0,0:30:28.86,0:30:30.45,Default,,0,0,0,,Сіздің ата-бабаларыңыз! (Хат) Сәлем...
Dialogue: 0,0:30:31.37,0:30:34.33,Default,,0,0,0,,250 жыл бойы біз қорғаған бұл жер...
Dialogue: 0,0:30:34.41,0:30:38.75,Default,,0,0,0,,Оны кейінгі ұрпаққа жеткізу – біздің парызымыз.
Dialogue: 0,0:30:40.33,0:30:41.79,Default,,0,0,0,,Хмм...
Dialogue: 0,0:30:45.92,0:30:48.22,Default,,0,0,0,,Сыртқы дүние жоқ
Dialogue: 0,0:30:48.30,0:30:50.01,Default,,0,0,0,,Бұл әлем
Dialogue: 0,0:30:53.35,0:30:56.85,Default,,0,0,0,,Көрінетін көшірме жасағандар жазаланады.
Dialogue: 0,0:31:09.32,0:31:10.86,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:31:13.78,0:31:15.66,Default,,0,0,0,,Ах! Бұл мен лақтырып жіберген шалбарлар.
Dialogue: 0,0:31:15.74,0:31:16.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:16.66,0:31:18.91,Default,,0,0,0,,Бұл менің көйлегім! (Тазалаушы) Бұл менің курткам!
Dialogue: 0,0:31:19.00,0:31:20.71,Default,,0,0,0,,Әй, менікі! (Тазалаушы) О, менікі де!
Dialogue: 0,0:31:20.79,0:31:21.79,Default,,0,0,0,,Мұны кім жасады?
Dialogue: 0,0:31:23.17,0:31:24.92,Default,,0,0,0,,Әй, Поупель!
Dialogue: 0,0:31:25.59,0:31:26.26,Default,,0,0,0,,Шабуыл
Dialogue: 0,0:31:26.96,0:31:28.26,Default,,0,0,0,,Бұл плащ.
Dialogue: 0,0:31:28.76,0:31:31.26,Default,,0,0,0,,Мен оны өзім тіктіріп алдым
Dialogue: 0,0:31:31.34,0:31:32.22,Default,,0,0,0,,Бұл да?
Dialogue: 0,0:31:32.30,0:31:34.89,Default,,0,0,0,,Дэн мырза маған пост берді.
Dialogue: 0,0:31:35.47,0:31:37.06,Default,,0,0,0,,Бұл жер асты сауда орталығындағы тігін цехы.
Dialogue: 0,0:31:37.14,0:31:39.64,Default,,0,0,0,,Аа, тігінші...
Dialogue: 0,0:31:39.73,0:31:42.19,Default,,0,0,0,,Тігін машинасы Мен оны жақсы меңгерген шығармын
Dialogue: 0,0:31:42.27,0:31:43.19,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:31:44.57,0:31:47.61,Default,,0,0,0,,Эй, Поупель, мен саған жұмыс орнымды көрсетемін.
Dialogue: 0,0:31:47.69,0:31:49.78,Default,,0,0,0,,Мен бұршақтарды тазалаған кезде менімен бірге кел.
Dialogue: 0,0:31:49.86,0:31:52.74,Default,,0,0,0,,Бірақ бәрі көрсе...
Dialogue: 0,0:31:53.45,0:31:55.58,Default,,0,0,0,,Жарайды, менде жақсы ой бар.
Dialogue: 0,0:31:57.79,0:31:59.46,Default,,0,0,0,,...
Dialogue: 0,0:32:00.37,0:32:01.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:02.00,0:32:03.75,Default,,0,0,0,,А, бұл менмін.
Dialogue: 0,0:32:04.59,0:32:05.59,Default,,0,0,0,,Хакушон! Бұл менмін
Dialogue: 0,0:32:05.67,0:32:07.50,Default,,0,0,0,,Бұл мен де Хекционмын
Dialogue: 0,0:32:12.38,0:32:13.30,Default,,0,0,0,,Лубитч!
Dialogue: 0,0:32:13.39,0:32:15.14,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:32:16.60,0:32:19.14,Default,,0,0,0,,Кешегі қоқысшыға не болды?
Dialogue: 0,0:32:19.22,0:32:22.27,Default,,0,0,0,,Дэн мырза жұмыс істеп жатыр... (Сью мырза) Хо Соке Соке
Dialogue: 0,0:32:22.35,0:32:25.69,Default,,0,0,0,,Шамасы, инквизитор жан-жағын иіскеп отыр.
Dialogue: 0,0:32:25.77,0:32:27.94,Default,,0,0,0,,Қатыспағаның дұрыс.
Dialogue: 0,0:32:28.03,0:32:28.65,Default,,0,0,0,,Лубитч мырза?
Dialogue: 0,0:32:28.73,0:32:30.03,Default,,0,0,0,,Мазалағаныңызға рахмет...
Dialogue: 0,0:32:30.11,0:32:31.40,Default,,0,0,0,,Лубитч мырза? (Мистер Сью) Ой?
Dialogue: 0,0:32:31.49,0:32:32.99,Default,,0,0,0,,Бұл ма? Лубитч мырза
Dialogue: 0,0:32:33.07,0:32:34.37,Default,,0,0,0,,Ах! (Мистер Сью) Иә?
Dialogue: 0,0:32:34.45,0:32:37.37,Default,,0,0,0,,Жоқ, бұл туралы алаңдамаңыз.
Dialogue: 0,0:32:37.45,0:32:38.70,Default,,0,0,0,,Лубитч мырза?
Dialogue: 0,0:32:40.16,0:32:41.29,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:32:49.17,0:32:50.09,Default,,0,0,0,,Өтірік
Dialogue: 0,0:32:51.34,0:32:52.42,Default,,0,0,0,,Өтірік!
Dialogue: 0,0:32:53.22,0:32:54.13,Default,,0,0,0,,Өтірік өтірік
Dialogue: 0,0:32:54.22,0:32:55.39,Default,,0,0,0,,Не?
Dialogue: 0,0:32:55.47,0:32:59.56,Default,,0,0,0,,Сіз биіктіктен қорқасыз ба, Любич мырза?
Dialogue: 0,0:33:00.43,0:33:03.19,Default,,0,0,0,,А, сен қалтырап тұрған жоқсың ба?
Dialogue: 0,0:33:03.27,0:33:04.02,Default,,0,0,0,,Мен дірілдеп тұрған жоқпын!
Dialogue: 0,0:33:06.94,0:33:09.36,Default,,0,0,0,,төмен қарамаңыз
Dialogue: 0,0:33:09.44,0:33:10.98,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:33:11.07,0:33:12.90,Default,,0,0,0,,Ештеңені түсіріп алмаңыз.
Dialogue: 0,0:33:13.53,0:33:16.62,Default,,0,0,0,,Сіз бірдеңені жоғалтып алдыңыз ба?
Dialogue: 0,0:33:17.41,0:33:18.66,Default,,0,0,0,,Білезік
Dialogue: 0,0:33:19.16,0:33:20.41,Default,,0,0,0,,Білезік?
Dialogue: 0,0:33:21.12,0:33:22.91,Default,,0,0,0,,Әкем сыйлаған білезік...
Dialogue: 0,0:33:23.00,0:33:24.96,Default,,0,0,0,,Мен оны осы жерден тастадым.
Dialogue: 0,0:33:25.62,0:33:30.25,Default,,0,0,0,,Неліктен жұмысқа сонша маңызды нәрсені әкелдің?
Dialogue: 0,0:33:30.34,0:33:32.80,Default,,0,0,0,,Тамақты тазалау үшін білезік қажет емес.
Dialogue: 0,0:33:34.34,0:33:36.34,Default,,0,0,0,,Жоғалтып алмас бұрын айт.
Dialogue: 0,0:33:43.35,0:33:46.69,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:33:47.31,0:33:49.27,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:33:49.36,0:33:51.44,Default,,0,0,0,,Мен биік жерлерден қорқамын
Dialogue: 0,0:33:51.53,0:33:53.61,Default,,0,0,0,,Бірақ мен көтерілгенімде өте қызық болды...
Dialogue: 0,0:33:53.69,0:33:55.03,Default,,0,0,0,,Менің жүрегім дүрсілдеп тұр
Dialogue: 0,0:33:55.11,0:33:57.91,Default,,0,0,0,,Иә, мен қазір істеп жатырмын.
Dialogue: 0,0:34:00.58,0:34:02.70,Default,,0,0,0,,Бірақ біз
Dialogue: 0,0:34:02.79,0:34:05.46,Default,,0,0,0,,Мен бұл тесіктен жоғары көтеріле алмаймын.
Dialogue: 0,0:34:05.54,0:34:08.17,Default,,0,0,0,,Поупель Сіз жұлдыздар туралы білесіз бе?
Dialogue: 0,0:34:09.08,0:34:09.96,Default,,0,0,0,,Хоши?
Dialogue: 0,0:34:11.04,0:34:12.21,Default,,0,0,0,,Иә?иә?
Dialogue: 0,0:34:14.13,0:34:15.80,Default,,0,0,0,,Түтіннің үстінде —
Dialogue: 0,0:34:16.72,0:34:18.97,Default,,0,0,0,,Жарқыраған жұлдыз қалқып тұр
Dialogue: 0,0:34:19.05,0:34:21.18,Default,,0,0,0,,А, шынымен бе?
Dialogue: 0,0:34:22.47,0:34:23.39,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:34:23.47,0:34:24.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:25.02,0:34:28.15,Default,,0,0,0,,Бірақ мен жұлдыздардың жоқ екенін де білмеймін
Dialogue: 0,0:34:29.10,0:34:31.65,Default,,0,0,0,,Бұл әкем жасаған ертегі.
Dialogue: 0,0:34:32.65,0:34:35.07,Default,,0,0,0,,«Энтоцу қаласы Энтоцуға толы»
Dialogue: 0,0:34:35.15,0:34:39.20,Default,,0,0,0,,«Барлық жерде түтін көтеріліп жатыр, менің басымның үстінде түтін келеке».
Dialogue: 0,0:34:39.28,0:34:43.95,Default,,0,0,0,,«Таңнан кешке дейін қара түтінмен мазақ мок»
Dialogue: 0,0:34:44.04,0:34:48.17,Default,,0,0,0,,«Энтоцу қаласында тұратын адамдар қара түтінге оранған».
Dialogue: 0,0:34:48.25,0:34:53.34,Default,,0,0,0,,«Мен көк аспанды білмеймін, жарқыраған жұлдыздарды білмеймін»
Dialogue: 0,0:34:54.42,0:34:56.59,Default,,0,0,0,,Бұл тамаша ертегі
Dialogue: 0,0:34:57.72,0:34:59.84,Default,,0,0,0,,Басында бәрі осылай деді.
Dialogue: 0,0:35:00.59,0:35:02.64,Default,,0,0,0,,«Қарауды тастаған қалада...»
Dialogue: 0,0:35:02.72,0:35:05.06,Default,,0,0,0,,«Бір адам жоғары қарады».
Dialogue: 0,0:35:05.14,0:35:07.18,Default,,0,0,0,,Ол мұнымен қанша уақыт айналысады?
Dialogue: 0,0:35:07.27,0:35:09.10,Default,,0,0,0,,Не? Жұлдыз дегеніміз не?
Dialogue: 0,0:35:09.19,0:35:10.19,Default,,0,0,0,,Сәлем Бруно!
Dialogue: 0,0:35:10.27,0:35:13.27,Default,,0,0,0,,Егер сіз ақымақ нәрсе айтсаңыз, инквизитор сізді байқайды.
Dialogue: 0,0:35:13.36,0:35:15.03,Default,,0,0,0,,Келіңдер, балалар.
Dialogue: 0,0:35:15.11,0:35:17.82,Default,,0,0,0,,Неге әйеліңе бірдеңе айтпайсың?
Dialogue: 0,0:35:17.90,0:35:20.41,Default,,0,0,0,,Ертегілерді ойлап тауып, қалағаныңызды жасаңыз.
Dialogue: 0,0:35:20.49,0:35:22.87,Default,,0,0,0,,Күйеу күйеу болса, әйел де әйел.
Dialogue: 0,0:35:23.78,0:35:25.37,Default,,0,0,0,,Сондықтан үйлендік.
Dialogue: 0,0:35:25.45,0:35:28.75,Default,,0,0,0,,Иә? Хехехехе
Dialogue: 0,0:35:29.33,0:35:32.42,Default,,0,0,0,,«Басын көтеруден бас тартқан қалада бір адам жоғары қарады».
Dialogue: 0,0:35:32.50,0:35:37.51,Default,,0,0,0,,«Қаланы қаптаған қара түтін адамды ойландырды...»
Dialogue: 0,0:35:37.59,0:35:39.84,Default,,0,0,0,,Мен жоғары қарасам, ештеңе көрмеймін.
Dialogue: 0,0:35:39.93,0:35:42.89,Default,,0,0,0,,Шындыққа қараңызшы, есеймейсіз.
Dialogue: 0,0:35:42.97,0:35:43.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:35:44.30,0:35:44.85,Default,,0,0,0,,Ах!
Dialogue: 0,0:35:46.97,0:35:47.64,Default,,0,0,0,,Эй
Dialogue: 0,0:35:48.85,0:35:49.85,Default,,0,0,0,,Ха…
Dialogue: 0,0:35:49.94,0:35:50.77,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,0:35:50.85,0:35:52.90,Default,,0,0,0,,Мен туралы қанша сөз айтсаң да...
Dialogue: 0,0:35:52.98,0:35:53.77,Default,,0,0,0,,Мен қарсы емеспін.
Dialogue: 0,0:35:53.86,0:35:54.48,Default,,0,0,0,,Иә... Ян?
Dialogue: 0,0:35:54.57,0:35:57.44,Default,,0,0,0,,Бұл жігіттің болашағы, балалар...
Dialogue: 0,0:35:57.53,0:35:59.40,Default,,0,0,0,,Шешпе!
Dialogue: 0,0:35:59.49,0:36:00.32,Default,,0,0,0,,Эй, сен істедің!
Dialogue: 0,0:36:00.40,0:36:02.28,Default,,0,0,0,,Өтірікші! (Қала адамы А) Алаңдамаңыз!
Dialogue: 0,0:36:03.45,0:36:04.83,Default,,0,0,0,,Не болды? (Лаура) Иә?
Dialogue: 0,0:36:04.91,0:36:06.37,Default,,0,0,0,,Қалыпты жүргізу
Dialogue: 0,0:36:06.45,0:36:07.37,Default,,0,0,0,,Бұл ауырады
Dialogue: 0,0:36:07.45,0:36:11.67,Default,,0,0,0,,Менің кішкентай жігітім нені таңдайды, ол сенің шаруаң емес.
Dialogue: 0,0:36:11.75,0:36:13.13,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:36:13.21,0:36:15.09,Default,,0,0,0,,Бұл ақымақтық.
Dialogue: 0,0:36:15.17,0:36:16.80,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:36:17.55,0:36:18.55,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:36:18.63,0:36:22.80,Default,,0,0,0,,Қарғыс атсын... Мен жеңілдім.
Dialogue: 0,0:36:22.89,0:36:25.14,Default,,0,0,0,,Басынан бастап жеңіске жету мүмкіндігі болған жоқ.
Dialogue: 0,0:36:25.22,0:36:26.81,Default,,0,0,0,,Ау, ауырып тұр...
Dialogue: 0,0:36:27.31,0:36:29.77,Default,,0,0,0,,Сіз маған ұятсыз қырыңызды көрсеттіңіз.
Dialogue: 0,0:36:30.60,0:36:31.31,Default,,0,0,0,,Хаа…
Dialogue: 0,0:36:31.89,0:36:35.81,Default,,0,0,0,,Әй, қолыңды ашшы, кішкентайым.
Dialogue: 0,0:36:39.40,0:36:41.82,Default,,0,0,0,,Олар мұны жарқыраған түрде орындады.
Dialogue: 0,0:36:42.32,0:36:43.70,Default,,0,0,0,,Әкем оны басты.
Dialogue: 0,0:36:43.78,0:36:44.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:45.37,0:36:45.95,Default,,0,0,0,,Хаа…
Dialogue: 0,0:36:47.08,0:36:47.78,Default,,0,0,0,,Хмм...
Dialogue: 0,0:36:48.54,0:36:49.24,Default,,0,0,0,,О
Dialogue: 0,0:36:52.04,0:36:53.58,Default,,0,0,0,,Не? иә?
Dialogue: 0,0:36:53.67,0:36:56.67,Default,,0,0,0,,Әй, бұл шынымен де көлемді.
Dialogue: 0,0:36:56.75,0:36:57.63,Default,,0,0,0,,Бүгінгі кешірім
Dialogue: 0,0:36:57.71,0:37:01.05,Default,,0,0,0,,Сізді ұятқа қалдырғаным үшін кешіріңіз.
Dialogue: 0,0:37:01.84,0:37:02.67,Default,,0,0,0,,Хехе
Dialogue: 0,0:37:02.76,0:37:05.05,Default,,0,0,0,,(Лаураның жөтелі)
Dialogue: 0,0:37:06.35,0:37:08.60,Default,,0,0,0,,Дәрігер менің белгілерім жақсармай жатқанын айтты.
Dialogue: 0,0:37:08.68,0:37:09.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:11.06,0:37:12.94,Default,,0,0,0,,Жарайды, мама күшті.
Dialogue: 0,0:37:13.52,0:37:16.15,Default,,0,0,0,,Дәрігер ем жоқ дейді.
Dialogue: 0,0:37:16.23,0:37:19.44,Default,,0,0,0,,Ол сыртқы әлемде болуы мүмкін.
Dialogue: 0,0:37:19.52,0:37:20.78,Default,,0,0,0,,Жоғарыға қараңыз
Dialogue: 0,0:37:23.49,0:37:27.49,Default,,0,0,0,,Түтіннің арасынан жұлдыздар көрінсе де...
Dialogue: 0,0:37:27.57,0:37:28.99,Default,,0,0,0,,Бір сәт
Dialogue: 0,0:37:29.08,0:37:32.66,Default,,0,0,0,,Егер сіз сол сәтті сағынсаңыз, оны көре алмайсыз.
Dialogue: 0,0:37:32.75,0:37:36.29,Default,,0,0,0,,Жұлдыздарды көру үшін сол сәтті жіберіп алмаңыз.
Dialogue: 0,0:37:36.38,0:37:41.13,Default,,0,0,0,,Мен басқаларға қарағанда ұзақ уақыт бойы жоғары қарауым керек.
Dialogue: 0,0:37:41.21,0:37:43.55,Default,,0,0,0,,Сенуді жалғастыру керек
Dialogue: 0,0:37:44.76,0:37:46.30,Default,,0,0,0,,төмен қара
Dialogue: 0,0:37:46.39,0:37:50.18,Default,,0,0,0,,Анаңыздың ауруын емдеу мүмкіндігін жіберіп алуыңыз мүмкін.
Dialogue: 0,0:37:51.52,0:37:54.14,Default,,0,0,0,,Оны ешкім көрмеуі керек.
Dialogue: 0,0:37:55.10,0:37:59.48,Default,,0,0,0,,Қара түтіннің арғы жағында, жарыққа сенсең...
Dialogue: 0,0:37:59.56,0:38:03.82,Default,,0,0,0,,Әрекет ет, есіңе ал, парасаттылыққа берілме
Dialogue: 0,0:38:04.49,0:38:07.41,Default,,0,0,0,,Жалғыз болсаңыз да өзіңізге сеніңіз
Dialogue: 0,0:38:08.16,0:38:12.91,Default,,0,0,0,,Жалғыз болсаң да, сеніп, жоғары қара.
Dialogue: 0,0:38:13.00,0:38:17.25,Default,,0,0,0,,Сол кезде сенімен бірге саған қарайтын жолдас шығады.
Dialogue: 0,0:38:18.92,0:38:20.09,Default,,0,0,0,,Біз доспыз.
Dialogue: 0,0:38:24.09,0:38:27.01,Default,,0,0,0,,Түтіннің арғы жағында не болып жатыр деп ойлаймын
Dialogue: 0,0:38:27.72,0:38:28.22,Default,,0,0,0,,Ах!
Dialogue: 0,0:38:28.30,0:38:28.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:29.80,0:38:31.76,Default,,0,0,0,,Бұл әңгіме бәріне бірдей арналмаған.
Dialogue: 0,0:38:31.85,0:38:33.43,Default,,0,0,0,,Себебі сізді мазақ етеді
Dialogue: 0,0:38:33.52,0:38:35.73,Default,,0,0,0,,Неліктен? Бұл керемет
Dialogue: 0,0:38:35.81,0:38:38.19,Default,,0,0,0,,Жоқ! Мүлдем жоқ!
Dialogue: 0,0:38:38.27,0:38:40.27,Default,,0,0,0,,♪~
Dialogue: 0,0:38:44.69,0:38:49.66,Default,,0,0,0,,♪ Менде бұл басталатын сияқты.
Dialogue: 0,0:38:49.74,0:38:52.87,Default,,0,0,0,,♪ Желді кесетін қадамдар
Dialogue: 0,0:38:52.95,0:38:59.00,Default,,0,0,0,,♪ Мен сені таптым, сен менің досымсың
Dialogue: 0,0:38:59.67,0:39:04.59,Default,,0,0,0,,♪ Жүрегімнің соғуы жиілеп барады
Dialogue: 0,0:39:04.67,0:39:07.92,Default,,0,0,0,,♪ Жүгіріп өткендей болыңыз
Dialogue: 0,0:39:08.01,0:39:14.10,Default,,0,0,0,,♪ Енді мен ештеңеден қорықпаймын
Dialogue: 0,0:39:14.18,0:39:18.35,Default,,0,0,0,,♪ Дүние күлсін,
Dialogue: 0,0:39:18.44,0:39:22.40,Default,,0,0,0,,♪ Өйткені мен сенемін
Dialogue: 0,0:39:23.07,0:39:29.65,Default,,0,0,0,,♪ Дәл осы дауыс
Dialogue: 0,0:39:30.41,0:39:37.25,Default,,0,0,0,,♪ Дада бұл жолы
Dialogue: 0,0:39:37.79,0:39:44.80,Default,,0,0,0,,♪ Түннен бері біз армандауға ант еттік
Dialogue: 0,0:39:46.46,0:39:52.39,Default,,0,0,0,,♪ Барлығы ғажайып болады
Dialogue: 0,0:39:58.14,0:40:00.14,Default,,0,0,0,,~♪
Dialogue: 0,0:40:01.31,0:40:02.27,Default,,0,0,0,,Бұл үлкен болды.
Dialogue: 0,0:40:02.35,0:40:04.27,Default,,0,0,0,,Ахахаха?
Dialogue: 0,0:40:05.48,0:40:07.36,Default,,0,0,0,,Эй, бұл ол.
Dialogue: 0,0:40:08.74,0:40:10.99,Default,,0,0,0,,А, күте тұрыңыз!
Dialogue: 0,0:40:15.12,0:40:16.37,Default,,0,0,0,,Әй, қоқысшы адам
Dialogue: 0,0:40:16.45,0:40:17.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:17.12,0:40:18.33,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:40:19.12,0:40:20.50,Default,,0,0,0,,Жұмыс...
Dialogue: 0,0:40:20.58,0:40:21.92,Default,,0,0,0,,Жұмыс?
Dialogue: 0,0:40:22.00,0:40:24.33,Default,,0,0,0,,Сіз Любич сияқты нәрселерді айтасыз.
Dialogue: 0,0:40:24.42,0:40:26.84,Default,,0,0,0,,Сіз Любич мырзаны білесіз бе?
Dialogue: 0,0:40:26.92,0:40:29.59,Default,,0,0,0,,Не? Сіз Лубитшпен таныссыз ба?
Dialogue: 0,0:40:29.67,0:40:33.59,Default,,0,0,0,,Жоқ, мен таныс емеспін, мен доспын.
Dialogue: 0,0:40:33.68,0:40:34.89,Default,,0,0,0,,Иә
Dialogue: 0,0:40:34.97,0:40:37.68,Default,,0,0,0,,Қоқысшылармен ойнауға уақыт болды ма?
Dialogue: 0,0:40:37.76,0:40:40.85,Default,,0,0,0,,Әкем қайтыс болғаннан кейін мен тек жұмыс деп ойладым.
Dialogue: 0,0:40:40.93,0:40:41.94,Default,,0,0,0,,Өлді ме?
Dialogue: 0,0:40:42.02,0:40:44.19,Default,,0,0,0,,Не? Сіз естіген жоқсыз ба?
Dialogue: 0,0:40:44.27,0:40:45.73,Default,,0,0,0,,Сіз білмейсіз
Dialogue: 0,0:40:45.81,0:40:47.61,Default,,0,0,0,,Оны атам көрген.
Dialogue: 0,0:40:48.90,0:40:53.32,Default,,0,0,0,,Тыйым салынған жағалауға кірген Бруно бейнесі және—
Dialogue: 0,0:40:53.41,0:40:58.91,Default,,0,0,0,,Үлкен толқын шашырауымен теңізге жоғалып бара жатқан құбыжықтың көлеңкесі.
Dialogue: 0,0:41:01.83,0:41:03.50,Default,,0,0,0,,Кайбутсу?
Dialogue: 0,0:41:03.58,0:41:06.04,Default,,0,0,0,,Бруно сол түні жоғалып кетті.
Dialogue: 0,0:41:06.13,0:41:09.21,Default,,0,0,0,,Мас болып, теңізге құладым, құбыжық жеп қалды.
Dialogue: 0,0:41:09.30,0:41:12.51,Default,,0,0,0,,Ол күн сайын кешке дейін ішіп жүрген көрінеді.
Dialogue: 0,0:41:12.59,0:41:14.05,Default,,0,0,0,,Бұл менің кінәм.
Dialogue: 0,0:41:14.68,0:41:17.26,Default,,0,0,0,,А... біз бұл туралы қашан айтамыз?
Dialogue: 0,0:41:17.35,0:41:18.47,Default,,0,0,0,,Бір жыл бұрын
Dialogue: 0,0:41:19.18,0:41:21.98,Default,,0,0,0,,Дүкенші бір жыл бұрын қайтыс болды.
Dialogue: 0,0:41:22.73,0:41:24.94,Default,,0,0,0,,Ата-анасыз болу қиын, өйткені жұмыс істеу керек.
Dialogue: 0,0:41:25.52,0:41:27.36,Default,,0,0,0,,Неліктен тігін ісін қолға алмадың?
Dialogue: 0,0:41:27.44,0:41:30.69,Default,,0,0,0,,Өйткені, бұл ақша. Кәсіпкерлер ақшаны жақсы көреді.
Dialogue: 0,0:41:30.78,0:41:33.49,Default,,0,0,0,,Мен «Хошиді» көруге тырысамын!
Dialogue: 0,0:41:34.95,0:41:37.91,Default,,0,0,0,,Любич мырза Хошиді көргісі келеді.
Dialogue: 0,0:41:37.99,0:41:39.58,Default,,0,0,0,,Әкеммен
Dialogue: 0,0:41:40.16,0:41:43.08,Default,,0,0,0,,Сондықтан мен әдемі көрінісі бар жұмыс орнын таңдадым.
Dialogue: 0,0:41:43.16,0:41:45.62,Default,,0,0,0,,Мен биіктікте жақсы болмасам да
Dialogue: 0,0:41:45.71,0:41:49.42,Default,,0,0,0,,Сонда да мен күнде тауға шығамын!
Dialogue: 0,0:41:49.50,0:41:53.72,Default,,0,0,0,,Ахахаха! Бұл қатал әзіл
Dialogue: 0,0:41:53.80,0:41:56.51,Default,,0,0,0,,Бруноның хикаялық шоуында жұлдыздар пайда болды, иә?
Dialogue: 0,0:41:56.59,0:41:57.30,Default,,0,0,0,,Бұл өтірік емес пе?
Dialogue: 0,0:41:57.39,0:41:58.64,Default,,0,0,0,,Иә, дұрыс!
Dialogue: 0,0:41:58.72,0:42:02.43,Default,,0,0,0,,Мен де Хошиді Любич мырзамен бірге көргім келеді!
Dialogue: 0,0:42:02.97,0:42:04.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:06.31,0:42:07.44,Default,,0,0,0,,Жоқ, яғни, ол қайда…
Dialogue: 0,0:42:08.65,0:42:10.07,Default,,0,0,0,,Ng…
Dialogue: 0,0:42:10.15,0:42:12.32,Default,,0,0,0,,Жұлдыздар жоқ!
Dialogue: 0,0:42:12.40,0:42:16.03,Default,,0,0,0,,Мифтерді байыппен қабылдамаңыз!
Dialogue: 0,0:42:16.11,0:42:18.20,Default,,0,0,0,,Сәлем Антонио! Жалған қауесет тарату -
Dialogue: 0,0:42:18.28,0:42:20.66,Default,,0,0,0,,Сіз бізді шатастырғыңыз келе ме?
Dialogue: 0,0:42:21.62,0:42:23.54,Default,,0,0,0,,Жұлдыздар жоқ!
Dialogue: 0,0:42:23.62,0:42:24.83,Default,,0,0,0,,Цезарь жастығын да, болашағын да босқа өткізді
Dialogue: 0,0:42:24.91,0:42:26.79,Default,,0,0,0,,Мен... Кешіріңіз, тоқтатыңыз!
Dialogue: 0,0:42:26.87,0:42:29.46,Default,,0,0,0,,Сіз тым көп істеп жатырсыз! Бұл жөнінде уайымдамаңыз!
Dialogue: 0,0:42:30.04,0:42:32.50,Default,,0,0,0,,Дүние сенімен ластанған!
Dialogue: 0,0:42:35.05,0:42:37.76,Default,,0,0,0,,Құбыжық сізді де жұтып қоймасын!
Dialogue: 0,0:42:39.84,0:42:43.43,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:42:49.85,0:42:51.44,Default,,0,0,0,,Ах
Dialogue: 0,0:42:52.07,0:42:53.94,Default,,0,0,0,,Мен біраз бұрын осында болдым, бірақ...
Dialogue: 0,0:42:55.03,0:42:56.03,Default,,0,0,0,,Қашып кетті...
Dialogue: 0,0:42:56.86,0:42:59.61,Default,,0,0,0,,Қоқысшы жұлдыздар туралы айтып отырды.
Dialogue: 0,0:43:00.41,0:43:02.28,Default,,0,0,0,,Любичпен жұлдыздарға қарау
Dialogue: 0,0:43:02.37,0:43:03.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:43:09.58,0:43:10.67,Default,,0,0,0,,Хаа... Ха~
Dialogue: 0,0:43:10.75,0:43:11.75,Default,,0,0,0,,Хаа…
Dialogue: 0,0:43:29.02,0:43:29.89,Default,,0,0,0,,Не болды?
Dialogue: 0,0:43:31.02,0:43:32.48,Default,,0,0,0,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:43:32.56,0:43:35.73,Default,,0,0,0,,Енді түтіннің ішінде бірдеңе...
Dialogue: 0,0:43:38.11,0:43:40.78,Default,,0,0,0,,Жоқ, ештеңе.
Dialogue: 0,0:43:50.21,0:43:53.00,Default,,0,0,0,,Поупелл! Мен шынтағымды сындырдым.
Dialogue: 0,0:43:54.42,0:43:55.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:56.55,0:43:57.13,Default,,0,0,0,,Ах
Dialogue: 0,0:43:59.97,0:44:00.72,Default,,0,0,0,,Лубитч?
Dialogue: 0,0:44:01.63,0:44:02.68,Default,,0,0,0,,Сот?
Dialogue: 0,0:44:02.76,0:44:05.97,Default,,0,0,0,,Аа, солай деп ойлаймын.
Dialogue: 0,0:44:06.06,0:44:09.73,Default,,0,0,0,,Эй, сен сол қоқыс адамымен әлі кездесіп жүрсің бе?
Dialogue: 0,0:44:10.77,0:44:14.11,Default,,0,0,0,,Барлығының киімдері түзеліп оралды.
Dialogue: 0,0:44:14.19,0:44:17.07,Default,,0,0,0,,А, бұл қоқысшылардың ісі ме?
Dialogue: 0,0:44:17.15,0:44:18.86,Default,,0,0,0,,Поупель жақсы жігіт.
Dialogue: 0,0:44:20.07,0:44:21.36,Default,,0,0,0,,Түсіну
Dialogue: 0,0:44:21.45,0:44:24.20,Default,,0,0,0,,Бұл постты қоқыс жәшігіндегі адамға берген себебім...
Dialogue: 0,0:44:24.28,0:44:25.28,Default,,0,0,0,,Дан-сан?
Dialogue: 0,0:44:25.95,0:44:29.16,Default,,0,0,0,,Дан-сан өте қамқор.
Dialogue: 0,0:44:29.25,0:44:29.91,Default,,0,0,0,,Иә!
Dialogue: 0,0:44:30.00,0:44:32.67,Default,,0,0,0,,Дэн де әкеме көмектесті.
Dialogue: 0,0:44:32.75,0:44:35.17,Default,,0,0,0,,О, Бруно да.
Dialogue: 0,0:44:35.96,0:44:37.46,Default,,0,0,0,,Соке Соке
Dialogue: 0,0:44:38.09,0:44:39.34,Default,,0,0,0,,Тек Лубич
Dialogue: 0,0:44:39.92,0:44:43.05,Default,,0,0,0,,Бұл дүние ешқашан бидғатты қабылдамайды.
Dialogue: 0,0:44:43.55,0:44:47.60,Default,,0,0,0,,Егер сіз қоқыспен айналысатын болсаңыз, инквизитордан сақ болыңыз.
Dialogue: 0,0:44:48.43,0:44:49.39,Default,,0,0,0,,Иә
Dialogue: 0,0:44:54.31,0:44:57.02,Default,,0,0,0,,Поупель қайда кетті?
Dialogue: 0,0:44:57.11,0:44:57.94,Default,,0,0,0,,Ах
Dialogue: 0,0:45:04.86,0:45:05.87,Default,,0,0,0,,Сүйегім сынды!
Dialogue: 0,0:45:05.95,0:45:07.87,Default,,0,0,0,,Бізге Токио ұнайды! (Фушигуро) Ә?
Dialogue: 0,0:45:08.45,0:45:10.37,Default,,0,0,0,,Несі қайғылы?
Dialogue: 0,0:45:10.45,0:45:12.87,Default,,0,0,0,,Менің қалпағым ұшып кетті.
Dialogue: 0,0:45:12.96,0:45:14.37,Default,,0,0,0,,Төбеде емес пе?
Dialogue: 0,0:45:14.46,0:45:16.08,Default,,0,0,0,,Бұлай болуы мүмкін емес.
Dialogue: 0,0:45:16.17,0:45:17.29,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,0:45:17.38,0:45:19.34,Default,,0,0,0,,Қарамай-ақ айта аласыз
Dialogue: 0,0:45:20.00,0:45:21.30,Default,,0,0,0,,Ақымақ.
Dialogue: 0,0:45:21.38,0:45:23.09,Default,,0,0,0,,Тексермейінше білмейсіз.
Dialogue: 0,0:45:23.17,0:45:24.68,Default,,0,0,0,,Тез тексеріңіз.
Dialogue: 0,0:45:25.26,0:45:27.64,Default,,0,0,0,,Қараңдар! Сәттілік Чиби
Dialogue: 0,0:45:27.72,0:45:29.68,Default,,0,0,0,,Міне. Тағы сәл ғана!
Dialogue: 0,0:45:30.47,0:45:31.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:45:31.10,0:45:33.64,Default,,0,0,0,,Ақымақ, төмен қарасаң дірілдейді.
Dialogue: 0,0:45:33.73,0:45:34.98,Default,,0,0,0,,Жоғарыға қараңыз
Dialogue: 0,0:45:37.81,0:45:39.61,Default,,0,0,0,,Ах ха...
Dialogue: 0,0:45:41.53,0:45:42.99,Default,,0,0,0,,Ха! (Бруно) Төмен қарама.
Dialogue: 0,0:45:43.07,0:45:45.70,Default,,0,0,0,,Орындады, тек төбеге қараңыз, бар күшіңізді салыңыз
Dialogue: 0,0:45:48.03,0:45:49.83,Default,,0,0,0,,А, мінеки!
Dialogue: 0,0:45:49.91,0:45:51.16,Default,,0,0,0,,Түсіндім, бұл тамаша!
Dialogue: 0,0:45:51.87,0:45:52.87,Default,,0,0,0,,Уау!
Dialogue: 0,0:46:00.21,0:46:02.59,Default,,0,0,0,,Ол қиын бала.
Dialogue: 0,0:46:02.67,0:46:03.30,Default,,0,0,0,,Ах
Dialogue: 0,0:46:06.59,0:46:09.14,Default,,0,0,0,,Ер адамдар жыламауы керек
Dialogue: 0,0:46:11.93,0:46:13.43,Default,,0,0,0,,Қолыңнан келгеннің бәрін жасадың, кішкентайым.
Dialogue: 0,0:46:14.60,0:46:15.77,Default,,0,0,0,,Бұл Лубич.
Dialogue: 0,0:46:19.11,0:46:21.77,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:46:23.32,0:46:24.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:26.74,0:46:28.36,Default,,0,0,0,,Ух... а...
Dialogue: 0,0:46:28.45,0:46:29.32,Default,,0,0,0,,Поупель? Ах...
Dialogue: 0,0:46:29.41,0:46:30.12,Default,,0,0,0,,Уау
Dialogue: 0,0:46:30.70,0:46:33.87,Default,,0,0,0,,Ах, Любич мырза, сіз осында болдыңыз ба?
Dialogue: 0,0:46:33.95,0:46:35.41,Default,,0,0,0,,...
Dialogue: 0,0:46:35.50,0:46:37.37,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:46:37.46,0:46:39.25,Default,,0,0,0,,Оны айтып жеткізу мүмкін емес.
Dialogue: 0,0:46:39.33,0:46:40.17,Default,,0,0,0,,Не болды?
Dialogue: 0,0:46:41.17,0:46:44.80,Default,,0,0,0,,Дүние менімен бірге ластанған сияқты.
Dialogue: 0,0:46:44.88,0:46:46.51,Default,,0,0,0,,Мұны кім жасайды...
Dialogue: 0,0:46:48.64,0:46:50.05,Default,,0,0,0,,Құлағыңыз ести ме?
Dialogue: 0,0:46:50.14,0:46:53.10,Default,,0,0,0,,Мен сізді осы жақтан естимін, сондықтан жақсы.
Dialogue: 0,0:46:55.18,0:46:58.52,Default,,0,0,0,,Иә? Иә
Dialogue: 0,0:47:00.10,0:47:02.07,Default,,0,0,0,,Егер сіз оларды біріктірсеңіз...
Dialogue: 0,0:47:02.15,0:47:04.65,Default,,0,0,0,,Мен оны қолданып көрдім, бірақ ол жұмыс істемеді.
Dialogue: 0,0:47:05.24,0:47:07.07,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:47:07.15,0:47:12.12,Default,,0,0,0,,Амал жоқ, мен құбыжықпын.
Dialogue: 0,0:47:24.88,0:47:25.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:47:30.93,0:47:32.35,Default,,0,0,0,,Лубитш қайда орналасқан?
Dialogue: 0,0:47:32.43,0:47:34.64,Default,,0,0,0,,Бұл сызық.
Dialogue: 0,0:47:34.72,0:47:37.35,Default,,0,0,0,,Осы сағатта сен қайда жүрсің?
Dialogue: 0,0:47:37.43,0:47:39.56,Default,,0,0,0,,Любичтің қоқысшымен бірге болған көрінісі...
Dialogue: 0,0:47:39.64,0:47:41.35,Default,,0,0,0,,Көп рет көрген
Dialogue: 0,0:47:41.44,0:47:43.27,Default,,0,0,0,,Қандай байланыс бар?
Dialogue: 0,0:47:43.86,0:47:47.94,Default,,0,0,0,,Ол Хэллоуинде қалған қоқысты жинау туралы бірдеңе айтты.
Dialogue: 0,0:47:48.03,0:47:51.49,Default,,0,0,0,,Ол ерікті рухы бар жақсы ұл, солай ма?
Dialogue: 0,0:47:54.70,0:47:57.75,Default,,0,0,0,,Любич жұлдыздарды көруге тырысатын сияқты.
Dialogue: 0,0:47:57.83,0:47:58.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:58.58,0:47:59.25,Default,,0,0,0,,Ха!
Dialogue: 0,0:48:00.67,0:48:01.87,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:48:01.96,0:48:05.21,Default,,0,0,0,,Егер сіз одан да нашар жасасаңыз, теңізге батып кетесіз.
Dialogue: 0,0:48:05.30,0:48:06.75,Default,,0,0,0,,Бруно сияқты бол
Dialogue: 0,0:48:07.46,0:48:09.55,Default,,0,0,0,,Жоқ... сендер балалар
Dialogue: 0,0:48:10.22,0:48:11.55,Default,,0,0,0,,Бруноны сен өлтірдің бе?
Dialogue: 0,0:48:12.22,0:48:13.68,Default,,0,0,0,,Балалар, сендер Бруносыңдар!
Dialogue: 0,0:48:13.76,0:48:15.47,Default,,0,0,0,,Тым көп ойламаңыз
Dialogue: 0,0:48:15.56,0:48:16.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:48:19.10,0:48:22.19,Default,,0,0,0,,(Лаураның ауыр тыныс алуы)
Dialogue: 0,0:48:22.27,0:48:23.27,Default,,0,0,0,,Ана
Dialogue: 0,0:48:24.44,0:48:26.23,Default,,0,0,0,,Әке, сіз олармен біргесіз бе?
Dialogue: 0,0:48:32.24,0:48:35.45,Default,,0,0,0,,Енді... мұндай көзге түсетін еліктеулерді доғар.
Dialogue: 0,0:48:38.37,0:48:42.75,Default,,0,0,0,,Мен енді отбасы мүшелерін жоғалтқым келмейді.
Dialogue: 0,0:48:50.55,0:48:53.22,Default,,0,0,0,,Құрметті хат, ол ғана қалды.
Dialogue: 0,0:48:54.14,0:48:55.30,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:48:56.30,0:48:59.14,Default,,0,0,0,,Көрінбей орындаңыз.
Dialogue: 0,0:48:59.22,0:48:59.72,Default,,0,0,0,,Иә
Dialogue: 0,0:49:00.64,0:49:06.27,Default,,0,0,0,,Ұят болды, ол жаман жігіт емес еді.
Dialogue: 0,0:49:06.36,0:49:07.82,Default,,0,0,0,,Бірақ жақсы
Dialogue: 0,0:49:07.90,0:49:10.53,Default,,0,0,0,,Сыртқы әлемді білуге тырысу -
Dialogue: 0,0:49:10.61,0:49:12.36,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:49:13.57,0:49:15.57,Default,,0,0,0,,Жоғалсын
Dialogue: 0,0:49:34.22,0:49:35.05,Default,,0,0,0,,(Үлдеген дыбыс)
Dialogue: 0,0:49:35.13,0:49:35.76,Default,,0,0,0,,Әй!
Dialogue: 0,0:49:41.27,0:49:43.02,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,0:49:45.31,0:49:46.69,Default,,0,0,0,,Иә?Ах!
Dialogue: 0,0:49:48.77,0:49:50.36,Default,,0,0,0,,Күйеуім іссапармен кеткен, бір аптаға дейін келмейді
Dialogue: 0,0:49:52.53,0:49:54.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:49:54.61,0:49:55.70,Default,,0,0,0,,Ах! (Тазалаушы) Ах!
Dialogue: 0,0:50:03.16,0:50:04.79,Default,,0,0,0,,Дан! (Тазалаушы) Дэн мырза!
Dialogue: 0,0:50:06.08,0:50:07.67,Default,,0,0,0,,Амансың ба? (Тазалаушы) Бұл қиын.
Dialogue: 0,0:50:10.34,0:50:11.25,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:50:11.34,0:50:12.76,Default,,0,0,0,,(Жедел жәрдем сигналы)
Dialogue: 0,0:50:13.34,0:50:14.47,Default,,0,0,0,,Жедел жәрдем қазірдің өзінде бар ма?
Dialogue: 0,0:50:14.55,0:50:16.72,Default,,0,0,0,,Эй, мынау! (Қала тұрғыны) Тезірек!
Dialogue: 0,0:50:21.85,0:50:23.60,Default,,0,0,0,,Кетіңіз!
Dialogue: 0,0:50:23.68,0:50:25.48,Default,,0,0,0,,Алыс болыңыз! Кет!
Dialogue: 0,0:50:27.81,0:50:28.31,Default,,0,0,0,,Ах
Dialogue: 0,0:50:31.32,0:50:33.11,Default,,0,0,0,,Кет! Дороти?
Dialogue: 0,0:50:33.19,0:50:35.28,Default,,0,0,0,,Оны тез алып жүруге көмектесіңізші!
Dialogue: 0,0:50:35.36,0:50:36.53,Default,,0,0,0,,Әй, сен не істеп жатырсың!
Dialogue: 0,0:50:36.61,0:50:38.66,Default,,0,0,0,,Тоқта! Мен әр сәт үшін жарысамын
Dialogue: 0,0:50:38.74,0:50:39.87,Default,,0,0,0,,Дан-сан осында сақталады!
Dialogue: 0,0:50:39.95,0:50:41.66,Default,,0,0,0,,Не? Сен не істеп жатырсың?
Dialogue: 0,0:50:43.24,0:50:44.83,Default,,0,0,0,,Сәлем! Күте тұрыңыз!
Dialogue: 0,0:50:44.91,0:50:45.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:47.50,0:50:48.42,Default,,0,0,0,,Фу…
Dialogue: 0,0:51:00.01,0:51:02.10,Default,,0,0,0,,Дэн ата ше?
Dialogue: 0,0:51:02.18,0:51:05.27,Default,,0,0,0,,Бұл қауіпті жағдай болды, бірақ мен қазір өзімді қауіпсіз сезінемін.
Dialogue: 0,0:51:05.35,0:51:07.06,Default,,0,0,0,,Әйтеуір асудан өтті.
Dialogue: 0,0:51:07.14,0:51:08.02,Default,,0,0,0,,Жақсы
Dialogue: 0,0:51:08.10,0:51:09.56,Default,,0,0,0,,О, мүлде
Dialogue: 0,0:51:10.44,0:51:13.86,Default,,0,0,0,,Дэн мырза аяғы тайып кететін адам емес!
Dialogue: 0,0:51:18.07,0:51:22.33,Default,,0,0,0,,Бұрынғы жігіттер төтенше жағдай қызметкерлері емес еді.
Dialogue: 0,0:51:23.12,0:51:25.20,Default,,0,0,0,,Дэн мырзаны нысанаға алған болатын.
Dialogue: 0,0:51:26.12,0:51:27.25,Default,,0,0,0,,Ол қоқыс адам.
Dialogue: 0,0:51:28.54,0:51:31.92,Default,,0,0,0,,Любич бізге осындай құбыжықты әкелгендіктен...
Dialogue: 0,0:51:32.00,0:51:32.84,Default,,0,0,0,,Осылайша
Dialogue: 0,0:51:32.92,0:51:33.71,Default,,0,0,0,,Тек тоқтаңыз!
Dialogue: 0,0:51:33.80,0:51:35.42,Default,,0,0,0,,Себебі сіз өзіңізбен бірге қоқыс шығарған адамды алып келдіңіз!
Dialogue: 0,0:51:36.80,0:51:38.80,Default,,0,0,0,,Себебі мені осында Лубич әкелді!
Dialogue: 0,0:51:39.30,0:51:40.64,Default,,0,0,0,,Бәріңе сәлем!
Dialogue: 0,0:51:42.26,0:51:44.31,Default,,0,0,0,,Топпо мырза, бірдеңе айтыңызшы!
Dialogue: 0,0:51:46.14,0:51:47.02,Default,,0,0,0,,Эй!
Dialogue: 0,0:51:52.23,0:51:53.11,Default,,0,0,0,,Лубитч!
Dialogue: 0,0:51:56.61,0:51:58.40,Default,,0,0,0,,Қоқысшыға не болды?
Dialogue: 0,0:51:58.49,0:52:00.70,Default,,0,0,0,,Қоқыс тауында шайылып кетті.
Dialogue: 0,0:52:00.78,0:52:02.62,Default,,0,0,0,,Қайтадан пайда болса, не істейсіз?
Dialogue: 0,0:52:03.37,0:52:04.49,Default,,0,0,0,,Ах
Dialogue: 0,0:52:08.04,0:52:08.79,Default,,0,0,0,,Эй
Dialogue: 0,0:52:10.54,0:52:13.04,Default,,0,0,0,,Соңғы кездері астмамен ауыратындар көбейіп кеткен сияқты.
Dialogue: 0,0:52:13.67,0:52:15.92,Default,,0,0,0,,Қоқыс адамының микробтары себеп болуы мүмкін.
Dialogue: 0,0:52:16.88,0:52:18.76,Default,,0,0,0,,Менің анаммен бірдей ауру.
Dialogue: 0,0:52:19.34,0:52:20.93,Default,,0,0,0,,Себеп - бұршақ түтіні.
Dialogue: 0,0:52:21.72,0:52:23.43,Default,,0,0,0,,Попеллада микробтар жоқ
Dialogue: 0,0:52:23.51,0:52:25.51,Default,,0,0,0,,Күн сайын денемді дұрыс жуамын.
Dialogue: 0,0:52:26.01,0:52:27.85,Default,,0,0,0,,Үлкен өтірік айту
Dialogue: 0,0:52:27.93,0:52:30.56,Default,,0,0,0,,Сол қоқыс адам кеше де сасып кеткен.
Dialogue: 0,0:52:31.31,0:52:33.90,Default,,0,0,0,,Күнде денемді жуамын деген өтірік.
Dialogue: 0,0:52:33.98,0:52:36.61,Default,,0,0,0,,Сіздің отбасыңыздағы ата-ана мен балаларыңыздың бәрі өтірікші.
Dialogue: 0,0:52:37.48,0:52:40.57,Default,,0,0,0,,Ей, ол жігітпен араласпа.
Dialogue: 0,0:52:40.65,0:52:41.70,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:52:41.78,0:52:43.57,Default,,0,0,0,,Кез келген жағдайда атмосфераны оқыңыз.
Dialogue: 0,0:52:44.41,0:52:45.74,Default,,0,0,0,,Оу? Оооох!
Dialogue: 0,0:52:45.83,0:52:48.20,Default,,0,0,0,,Сіз әлі де жұлдыздарды іздеп жүрсіз бе?
Dialogue: 0,0:52:48.29,0:52:50.45,Default,,0,0,0,,Әлгі қоқысшы осылай деді.
Dialogue: 0,0:52:50.54,0:52:53.58,Default,,0,0,0,,Жұлдыздарды іздеп жүргеніңіз
Dialogue: 0,0:52:54.88,0:52:55.96,Default,,0,0,0,,Поупель?
Dialogue: 0,0:52:56.04,0:52:58.80,Default,,0,0,0,,Әй, таза сөйлеп тұрды.
Dialogue: 0,0:53:02.09,0:53:03.26,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:53:08.51,0:53:10.93,Default,,0,0,0,,Бұл өте ауыр соққы.
Dialogue: 0,0:53:11.56,0:53:13.69,Default,,0,0,0,,Өйткені мен ешқашан берілмеймін
Dialogue: 0,0:53:13.77,0:53:15.10,Default,,0,0,0,,Неге сонша?
Dialogue: 0,0:53:20.53,0:53:24.11,Default,,0,0,0,,(Тігін машинасының жұмыс дыбысы)
Dialogue: 0,0:53:28.62,0:53:31.41,Default,,0,0,0,,А, келдің.
Dialogue: 0,0:53:32.96,0:53:34.04,Default,,0,0,0,,Міне
Dialogue: 0,0:53:35.92,0:53:39.71,Default,,0,0,0,,Бүгін ол қару саудагерін тұтқындауға барды
Dialogue: 0,0:53:41.55,0:53:43.38,Default,,0,0,0,,Қайтадан иіс шығып жатыр, солай емес пе?
Dialogue: 0,0:53:43.47,0:53:44.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:45.01,0:53:49.35,Default,,0,0,0,,Денемді күнде жусам да, неге тез иіс шығады?
Dialogue: 0,0:53:50.22,0:53:51.64,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:53:52.48,0:53:54.73,Default,,0,0,0,,Сол үшін мені өтірікші деп атады.
Dialogue: 0,0:53:55.85,0:53:59.40,Default,,0,0,0,,Қанша жусаң да денеңнен сасық.
Dialogue: 0,0:54:00.57,0:54:02.23,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:54:03.74,0:54:06.11,Default,,0,0,0,,Сіз Антониоға және басқаларға жұлдыздар туралы айттыңыз ба?
Dialogue: 0,0:54:06.20,0:54:06.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:07.62,0:54:09.74,Default,,0,0,0,,Маған айтпауға уәде бердің!
Dialogue: 0,0:54:09.83,0:54:14.00,Default,,0,0,0,,А, жоқ, жоқ, жоқ, олай емес...
Dialogue: 0,0:54:14.08,0:54:16.29,Default,,0,0,0,,Сен де мені мазақ қылдың ғой, солай ма?
Dialogue: 0,0:54:16.37,0:54:18.67,Default,,0,0,0,,Жоқ... Жоқ. Жоқ... Мм...
Dialogue: 0,0:54:18.75,0:54:20.17,Default,,0,0,0,,Дэн мырза ыдыстан құлап түсті.
Dialogue: 0,0:54:21.17,0:54:21.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:23.80,0:54:26.72,Default,,0,0,0,,Қоқысшымен бірге болу қателік болды.
Dialogue: 0,0:54:27.93,0:54:30.47,Default,,0,0,0,,Сізбен бірге болу барлығын бақытсыз етеді.
Dialogue: 0,0:54:31.97,0:54:34.39,Default,,0,0,0,,Неге менің алдымда көріндің!
Dialogue: 0,0:54:38.19,0:54:40.90,Default,,0,0,0,,Жоқ… жоқ…
Dialogue: 0,0:54:40.98,0:54:43.28,Default,,0,0,0,,Ах... жоқ.
Dialogue: 0,0:54:43.36,0:54:45.78,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:54:46.86,0:54:48.45,Default,,0,0,0,,Лубитч мырза
Dialogue: 0,0:54:55.04,0:54:57.04,Default,,0,0,0,,♪~
Dialogue: 0,0:55:04.34,0:55:08.93,Default,,0,0,0,,♪ Маңызды нәрсе жасалғанда
Dialogue: 0,0:55:09.64,0:55:13.60,Default,,0,0,0,,♪ Себебі мен оны алып кеткенін қаламаймын
Dialogue: 0,0:55:15.02,0:55:19.23,Default,,0,0,0,,♪ Бала болғанды ешкім жақсы көрмейді
Dialogue: 0,0:55:19.31,0:55:20.73,Default,,0,0,0,,♪ Әлі де
Dialogue: 0,0:55:20.81,0:55:26.11,Default,,0,0,0,,♪ Армандар аспанда қалықтап қалатыны сөзсіз
Dialogue: 0,0:55:30.28,0:55:34.95,Default,,0,0,0,,♪ Ей, сен екеуміз екеуміз.
Dialogue: 0,0:55:35.04,0:55:39.92,Default,,0,0,0,,♪ Бір күні мен салған жолмен жүрейік
Dialogue: 0,0:55:40.42,0:55:44.59,Default,,0,0,0,,♪ Бұл сізге қалай көрінеді деп ойлаймын
Dialogue: 0,0:55:44.67,0:55:49.93,Default,,0,0,0,,♪ Өйткені бірінші сенетін адам - өзің
Dialogue: 0,0:55:50.01,0:55:54.93,Default,,0,0,0,,♪ Түннен де қараңғы бұл жүректе
Dialogue: 0,0:55:55.01,0:56:00.31,Default,,0,0,0,,♪ Мен әлі де жұлдыздарды іздеймін
Dialogue: 0,0:56:00.39,0:56:02.48,Default,,0,0,0,,♪ Бұл сенсің
Dialogue: 0,0:56:02.56,0:56:04.90,Default,,0,0,0,,♪ Өйткені мен сенемін
Dialogue: 0,0:56:04.98,0:56:09.74,Default,,0,0,0,,♪ Мені сәл ғана ұстаңыз
Dialogue: 0,0:56:10.32,0:56:16.16,Default,,0,0,0,,♪ Мен айтпаған нәрсе бар.
Dialogue: 0,0:56:23.50,0:56:28.46,Default,,0,0,0,,♪ Неге жұмыс істемейді деп ойлаймын...
Dialogue: 0,0:56:30.88,0:56:35.35,Default,,0,0,0,,♪ Неге жұмыс істемейді деп ойлаймын...
Dialogue: 0,0:56:38.64,0:56:42.73,Default,,0,0,0,,♪ Неге жұмыс істемейді деп ойлаймын...
Dialogue: 0,0:56:42.81,0:56:43.60,Default,,0,0,0,,♪ Мен сізге айтқым келеді
Dialogue: 0,0:56:43.69,0:56:50.65,Default,,0,0,0,,♪ Қоқыс сияқты ақыл
Dialogue: 0,0:56:51.15,0:56:56.53,Default,,0,0,0,,♪ Қанша нәрсе өзгеріссіз қалады?
Dialogue: 0,0:56:56.62,0:57:01.08,Default,,0,0,0,,♪ Екі қолға сыйды ма?
Dialogue: 0,0:57:02.25,0:57:06.04,Default,,0,0,0,,♪ Мені қазіргідей ешкім жақсы көрмейді
Dialogue: 0,0:57:06.13,0:57:07.88,Default,,0,0,0,,♪ Таңдау
Dialogue: 0,0:57:07.96,0:57:12.63,Default,,0,0,0,,♪ Көріңіз немесе орындаңыз, өз қолыңызбен
Dialogue: 0,0:57:12.72,0:57:16.93,Default,,0,0,0,,♪ Менің жүрегім айқайлайды
Dialogue: 0,0:57:17.01,0:57:21.98,Default,,0,0,0,,♪ Бірін-бірі толықтырады деп ойлаймын
Dialogue: 0,0:57:22.64,0:57:26.90,Default,,0,0,0,,♪ Мен туылғанға дейін шығар
Dialogue: 0,0:57:26.98,0:57:31.82,Default,,0,0,0,,♪ Мен жеткілікті армандадым
Dialogue: 0,0:57:33.24,0:57:38.12,Default,,0,0,0,,♪ Біз ғана көре алатын дүние
Dialogue: 0,0:57:38.20,0:57:43.41,Default,,0,0,0,,♪ Мен белгісіз болса да сенгім келеді
Dialogue: 0,0:57:43.50,0:57:48.17,Default,,0,0,0,,♪ Басқа біреу үшін мағынасы болмаса да
Dialogue: 0,0:57:48.25,0:57:53.13,Default,,0,0,0,,♪ Мен әлі күнге дейін армандарымды жібере алмаймын
Dialogue: 0,0:57:53.22,0:58:00.22,Default,,0,0,0,,♪ Мұнда жарық бөлшегі бар
Dialogue: 0,0:58:04.89,0:58:06.90,Default,,0,0,0,,~♪
Dialogue: 0,0:58:08.19,0:58:10.90,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:58:10.98,0:58:12.36,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:58:12.44,0:58:13.65,Default,,0,0,0,,Ах
Dialogue: 0,0:58:26.79,0:58:27.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:58:29.04,0:58:30.50,Default,,0,0,0,,Жоқ, мен әйеліммен ұрсысып қалдым.
Dialogue: 0,0:58:30.59,0:58:33.71,Default,,0,0,0,,Мен мұнда кешірім сұрау үшін келген жоқпын.
Dialogue: 0,0:58:36.01,0:58:38.51,Default,,0,0,0,,Мен сізге бір нәрсе бергім келді.
Dialogue: 0,0:58:39.55,0:58:40.85,Default,,0,0,0,,Арық өзеніндегі қоқыс-
Dialogue: 0,0:58:40.93,0:58:43.97,Default,,0,0,0,,Ол қоқыс үйіндісіне жуылды, сондықтан мен оны сонда деп ойладым.
Dialogue: 0,0:58:45.73,0:58:47.14,Default,,0,0,0,,Білезік
Dialogue: 0,0:58:48.19,0:58:52.61,Default,,0,0,0,,Мен қоқыс үйіндісінде туғанмын, сондықтан қоқыс жинауға үйренгенмін.
Dialogue: 0,0:58:54.19,0:58:58.61,Default,,0,0,0,,Мен оны бірден тауып алып, келесі күні сізге беремін деп жоспарлап едім, бірақ...
Dialogue: 0,0:58:59.82,0:59:01.58,Default,,0,0,0,,Табылмады
Dialogue: 0,0:59:03.29,0:59:05.08,Default,,0,0,0,,Қайтадан иіс шығып жатыр, солай емес пе?
Dialogue: 0,0:59:05.16,0:59:09.21,Default,,0,0,0,,Денемді күнде жусам да, неге тез иіс шығады?
Dialogue: 0,0:59:10.63,0:59:13.42,Default,,0,0,0,,Сонымен сіздің денеңіз...
Dialogue: 0,0:59:13.50,0:59:15.13,Default,,0,0,0,,Сиқыр формуласын ашу
Dialogue: 0,0:59:15.21,0:59:18.80,Default,,0,0,0,,Мен ештеңе білмедім, саған бір сұмдық жасадым.
Dialogue: 0,0:59:19.64,0:59:21.55,Default,,0,0,0,,Мәселе жоқ
Dialogue: 0,0:59:22.10,0:59:24.06,Default,,0,0,0,,Өйткені біз доспыз
Dialogue: 0,0:59:28.44,0:59:32.15,Default,,0,0,0,,Бұл қоқыс үйіндісінде болған жоқ.
Dialogue: 0,0:59:41.91,0:59:43.58,Default,,0,0,0,,Мен ақымақпын
Dialogue: 0,0:59:43.66,0:59:45.54,Default,,0,0,0,,Тезірек байқаған жөн еді
Dialogue: 0,0:59:47.37,0:59:49.54,Default,,0,0,0,,Ол әрқашан осында болды.
Dialogue: 0,0:59:50.17,0:59:51.33,Default,,0,0,0,,Ах
Dialogue: 0,0:59:51.42,0:59:55.38,Default,,0,0,0,,Мен өз денемді іздеуді мүлдем ұмытып кеттім.
Dialogue: 0,0:59:57.55,0:59:58.51,Default,,0,0,0,,Мен оны сізге қайтарамын.
Dialogue: 0,0:59:58.59,0:59:59.76,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:00:00.59,1:00:01.93,Default,,0,0,0,,Оны қабылдамаңыз
Dialogue: 0,1:00:02.01,1:00:04.89,Default,,0,0,0,,Бұл білезік сіздің миыңыз емес пе?
Dialogue: 0,1:00:04.97,1:00:06.47,Default,,0,0,0,,Егер сіз оны алып кетсеңіз, сіз...
Dialogue: 0,1:00:06.56,1:00:08.48,Default,,0,0,0,,Босатыңыз
Dialogue: 0,1:00:08.56,1:00:11.40,Default,,0,0,0,,Менде болса, оны біреу жұлып алар еді...
Dialogue: 0,1:00:11.48,1:00:14.02,Default,,0,0,0,,Бұл жолы ол шынымен де жоғалады
Dialogue: 0,1:00:16.53,1:00:17.78,Default,,0,0,0,,…
Dialogue: 0,1:00:18.99,1:00:21.28,Default,,0,0,0,,Неге біз бірге қашпаймыз?
Dialogue: 0,1:00:22.11,1:00:23.41,Default,,0,0,0,,Жоқ.
Dialogue: 0,1:00:23.49,1:00:25.91,Default,,0,0,0,,Мені қасыңда көрсең...
Dialogue: 0,1:00:25.99,1:00:28.95,Default,,0,0,0,,Любич мырза тағы да қиындыққа тап болады.
Dialogue: 0,1:00:29.04,1:00:32.42,Default,,0,0,0,,Любич мырза менімен бірге болмауы керек.
Dialogue: 0,1:00:32.50,1:00:34.71,Default,,0,0,0,,Менің болашағымды ерікті түрде шешпе!
Dialogue: 0,1:00:37.05,1:00:39.72,Default,,0,0,0,,Мен сенімен бірге болғым келді.
Dialogue: 0,1:00:39.80,1:00:41.30,Default,,0,0,0,,Бірге болайық
Dialogue: 0,1:00:43.84,1:00:48.06,Default,,0,0,0,,Осылайша мен әкемнің білезігін күнде көре аламын.
Dialogue: 0,1:00:53.90,1:00:55.69,Default,,0,0,0,,Ендеше бірге болайық
Dialogue: 0,1:00:56.40,1:01:00.53,Default,,0,0,0,,Рахмет. Мен аздап ұялып тұрмын.
Dialogue: 0,1:01:07.83,1:01:08.95,Default,,0,0,0,,Әке?
Dialogue: 0,1:01:12.25,1:01:13.71,Default,,0,0,0,,Бұл сенің әкең бе?
Dialogue: 0,1:01:15.25,1:01:16.67,Default,,0,0,0,,Бұл сенің әкең, солай ма?
Dialogue: 0,1:01:16.75,1:01:18.25,Default,,0,0,0,,Лубитч мырза?
Dialogue: 0,1:01:21.22,1:01:23.13,Default,,0,0,0,,Сіз қайтып келдіңіз бе?
Dialogue: 0,1:01:25.39,1:01:28.01,Default,,0,0,0,,Неге кенет жоғалып кеттің?
Dialogue: 0,1:01:28.10,1:01:29.26,Default,,0,0,0,,Ах...
Dialogue: 0,1:01:31.39,1:01:34.73,Default,,0,0,0,,Мен сізбен сөйлескім келеді, әке.
Dialogue: 0,1:01:35.69,1:01:37.98,Default,,0,0,0,,Әкемді құбыжық жеп қойды ма?
Dialogue: 0,1:01:38.07,1:01:40.11,Default,,0,0,0,,Әлде өлтірілді ме?
Dialogue: 0,1:01:45.20,1:01:47.62,Default,,0,0,0,,Әкем не істеді? Маған жауап бер
Dialogue: 0,1:01:51.58,1:01:53.71,Default,,0,0,0,,Кешіріңіз, Любич мырза.
Dialogue: 0,1:01:53.79,1:01:56.17,Default,,0,0,0,,Мен Хэллоуин Поупеллмін
Dialogue: 0,1:01:58.29,1:02:00.30,Default,,0,0,0,,Мен қоқысшымын
Dialogue: 0,1:02:00.96,1:02:02.42,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:02:04.09,1:02:07.18,Default,,0,0,0,,Мен ештеңе білмеймін
Dialogue: 0,1:02:08.10,1:02:09.68,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:02:11.35,1:02:12.85,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:02:13.98,1:02:17.48,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:02:20.98,1:02:21.78,Default,,0,0,0,,Не!
Dialogue: 0,1:02:21.86,1:02:22.86,Default,,0,0,0,,Немесе 'Akiba's●lip'
Dialogue: 0,1:02:22.94,1:02:23.78,Default,,0,0,0,,Ах! Уф
Dialogue: 0,1:02:24.78,1:02:26.91,Default,,0,0,0,,Уау! Уф...
Dialogue: 0,1:02:26.99,1:02:28.07,Default,,0,0,0,,О!
Dialogue: 0,1:02:28.16,1:02:29.03,Default,,0,0,0,,Қарт әже, кіріп келемін.
Dialogue: 0,1:02:29.12,1:02:31.70,Default,,0,0,0,,Уау... Түсінбедім.
Dialogue: 0,1:02:31.79,1:02:32.66,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:02:32.74,1:02:34.04,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,1:02:34.12,1:02:37.92,Default,,0,0,0,,Бірақ жүрегім мені сондай күшті күшпен шақырады!
Dialogue: 0,1:02:38.00,1:02:38.83,Default,,0,0,0,,Қый!
Dialogue: 0,1:02:38.92,1:02:42.09,Default,,0,0,0,,Бұл қоқыс, бұл шынымен де үлкен...
Dialogue: 0,1:02:42.67,1:02:43.92,Default,,0,0,0,,Ах!
Dialogue: 0,1:02:44.47,1:02:51.47,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,1:03:04.15,1:03:06.20,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:03:25.05,1:03:31.60,Default,,0,0,0,,
Dialogue: 0,1:03:33.18,1:03:35.31,Default,,0,0,0,,Поупель Сен оны қалай атадың?
Dialogue: 0,1:03:35.39,1:03:37.06,Default,,0,0,0,,...
Dialogue: 0,1:03:44.02,1:03:45.61,Default,,0,0,0,,Бұл құбыжық.
Dialogue: 0,1:03:46.90,1:03:48.53,Default,,0,0,0,,Ах… Ах…
Dialogue: 0,1:03:58.58,1:04:00.42,Default,,0,0,0,,Теңіз құбыжығы
Dialogue: 0,1:04:02.79,1:04:04.00,Default,,0,0,0,,Бұл —
Dialogue: 0,1:04:04.09,1:04:05.67,Default,,0,0,0,,Құбыжық емес
Dialogue: 0,1:04:06.80,1:04:07.63,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:08.51,1:04:09.84,Default,,0,0,0,,Есіңде жоқ па?
Dialogue: 0,1:04:10.80,1:04:11.34,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:13.10,1:04:14.60,Default,,0,0,0,,Неліктен? иә?
Dialogue: 0,1:04:16.18,1:04:18.27,Default,,0,0,0,,Неліктен бұл жерде?
Dialogue: 0,1:04:19.10,1:04:20.35,Default,,0,0,0,,Лубитч мырза?
Dialogue: 0,1:04:20.44,1:04:22.06,Default,,0,0,0,,Жолды босатыңыз
Dialogue: 0,1:04:24.23,1:04:30.36,Default,,0,0,0,,Сай Сай Сай Сай Сай Сай Сай Сай Сай
Dialogue: 0,1:04:34.95,1:04:36.12,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:04:36.20,1:04:38.33,Default,,0,0,0,,Оны толқын алып кетіп, қайта оралған сияқты.
Dialogue: 0,1:04:38.41,1:04:41.96,Default,,0,0,0,,Неліктен суға батқан кемені толқын шайып кетті?
Dialogue: 0,1:04:42.04,1:04:43.08,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,1:04:43.71,1:04:45.75,Default,,0,0,0,,Бұл туралы шыншыл болған дұрыс...
Dialogue: 0,1:04:45.84,1:04:47.96,Default,,0,0,0,,Сенімді болыңыз, хат мырза.
Dialogue: 0,1:04:48.05,1:04:51.88,Default,,0,0,0,,Олар кеменің бар екенін білмейді, сондықтан біз оны сонда қалдырамыз...
Dialogue: 0,1:04:51.97,1:04:56.76,Default,,0,0,0,,Теңізге деген қорқынышты бұдан да көбірек ұялату жақсы болар ма екен деп ойлаймын.
Dialogue: 0,1:04:56.85,1:04:59.77,Default,,0,0,0,,Сыртқы дүние жоқ
Dialogue: 0,1:05:01.06,1:05:01.77,Default,,0,0,0,,О
Dialogue: 0,1:05:03.35,1:05:04.73,Default,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,1:05:06.90,1:05:10.65,Default,,0,0,0,,Әкемнің суретті әңгімесі ертегі емес еді.
Dialogue: 0,1:05:10.74,1:05:13.61,Default,,0,0,0,,Бұл кеме әкемнің хикаялық шоуында пайда болды!
Dialogue: 0,1:05:13.70,1:05:14.36,Default,,0,0,0,,Иә!
Dialogue: 0,1:05:17.70,1:05:21.66,Default,,0,0,0,,Сол суретті-әңгіме, бұл менің әкемнің әңгімесі.
Dialogue: 0,1:05:23.46,1:05:25.71,Default,,0,0,0,,Әкем шынымен көрген шығар.
Dialogue: 0,1:05:25.79,1:05:26.63,Default,,0,0,0,,Поупелл!
Dialogue: 0,1:05:26.71,1:05:27.96,Default,,0,0,0,,Ах ха... иә!
Dialogue: 0,1:05:28.80,1:05:30.46,Default,,0,0,0,,Маған күшіңді бер
Dialogue: 0,1:05:31.76,1:05:33.72,Default,,0,0,0,,Әкем маған не айтқысы келді—
Dialogue: 0,1:05:33.80,1:05:35.05,Default,,0,0,0,,Оны барлығына жеткізіңіз
Dialogue: 0,1:05:35.80,1:05:38.31,Default,,0,0,0,,Хошиді көруге барасыз ба?
Dialogue: 0,1:05:39.06,1:05:40.64,Default,,0,0,0,,Оны көрмеңіз.
Dialogue: 0,1:05:40.72,1:05:42.64,Default,,0,0,0,,Оны қаладағы барлық адамдарға көрсетіңіз!
Dialogue: 0,1:05:47.56,1:05:49.98,Default,,0,0,0,,Fa~a
Dialogue: 0,1:05:53.24,1:05:56.91,Default,,0,0,0,,Хаха, не болып жатыр? Таңертеңнен бері уайымдап жүрсің.
Dialogue: 0,1:05:56.99,1:06:00.54,Default,,0,0,0,,Менің сырымды білетіндіктен мені тағы бопсалауға келдің бе?
Dialogue: 0,1:06:00.62,1:06:01.83,Default,,0,0,0,,Қойшы.
Dialogue: 0,1:06:01.91,1:06:04.33,Default,,0,0,0,,Сол күні мен бәріңді шығарып салдым.
Dialogue: 0,1:06:04.41,1:06:05.87,Default,,0,0,0,,Мәміле жасалуы керек еді.
Dialogue: 0,1:06:06.58,1:06:08.50,Default,,0,0,0,,Тағы екі қалдыру керек еді.
Dialogue: 0,1:06:09.25,1:06:11.59,Default,,0,0,0,,Менен бірдеңе сұраңыз
Dialogue: 0,1:06:15.84,1:06:17.80,Default,,0,0,0,,Шынында да, екеуі қалды.
Dialogue: 0,1:06:17.89,1:06:19.97,Default,,0,0,0,,Түтінсіз ұнтақты бөлек алыңыз!
Dialogue: 0,1:06:22.10,1:06:23.77,Default,,0,0,0,,Жоқ, бұл мүмкін емес.
Dialogue: 0,1:06:23.85,1:06:26.02,Default,,0,0,0,,Мен сіздің тілектеріңізді тыңдаймын дедім.
Dialogue: 0,1:06:26.10,1:06:28.02,Default,,0,0,0,,Бұл жігіт сауданың құралы болғаны ғой.
Dialogue: 0,1:06:28.61,1:06:29.56,Default,,0,0,0,,Оның белгіленген мақсаты бар.
Dialogue: 0,1:06:29.65,1:06:31.15,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,1:06:31.23,1:06:32.90,Default,,0,0,0,,Бұл менің сенімдерімді айтудың жақсы мүмкіндігі.
Dialogue: 0,1:06:32.98,1:06:34.90,Default,,0,0,0,,Осындай қауіпті мылтықты қолдану —
Dialogue: 0,1:06:34.99,1:06:36.78,Default,,0,0,0,,Олардан табылып қалуға тәуекел етпеңіз.
Dialogue: 0,1:06:36.86,1:06:38.62,Default,,0,0,0,,Мен не үшін ор қазып жатырмын?
Dialogue: 0,1:06:38.70,1:06:41.58,Default,,0,0,0,,Оның бір себебі бар: оның ішінде романтика бар.
Dialogue: 0,1:06:42.20,1:06:43.66,Default,,0,0,0,,Жерде мүлдем еркіндік жоқ.
Dialogue: 0,1:06:43.75,1:06:45.50,Default,,0,0,0,,Кең ауқымды инквизитор
Dialogue: 0,1:06:45.58,1:06:48.13,Default,,0,0,0,,Қажетсіз еліктеу жасасаңыз, бұл бірден болады.
Dialogue: 0,1:06:48.21,1:06:49.88,Default,,0,0,0,,Тар екен, ешкім үндемейді.
Dialogue: 0,1:06:50.54,1:06:52.13,Default,,0,0,0,,Екінші жағынан, мұнда романтика бар.
Dialogue: 0,1:06:52.21,1:06:53.84,Default,,0,0,0,,Тарих топырақпен көмілген
Dialogue: 0,1:06:53.92,1:06:57.01,Default,,0,0,0,,Бұл ашылулар тізбегі. Бұл бізге көп нәрсені үйретеді.
Dialogue: 0,1:06:57.59,1:07:00.14,Default,,0,0,0,,Сіздің шахта ұры болғаныңыз ақшаға ынталы екеніңізді білдірмейді.
Dialogue: 0,1:07:00.72,1:07:02.14,Default,,0,0,0,,Мен толқығым келеді
Dialogue: 0,1:07:02.22,1:07:04.22,Default,,0,0,0,,Мен бұл жігітпен қызыққым келеді
Dialogue: 0,1:07:04.31,1:07:06.31,Default,,0,0,0,,Мен сізге болмашы нәрселер үшін қарызға ақша бере алмаймын.
Dialogue: 0,1:07:07.94,1:07:09.69,Default,,0,0,0,,Аспандағы түтінді үрле
Dialogue: 0,1:07:12.77,1:07:13.69,Default,,0,0,0,,(құбырдың құлаған дыбысы)
Dialogue: 0,1:07:13.78,1:07:17.07,Default,,0,0,0,,Осы қаланы жауып тұрған түтінді түтінсіз мылтықпен үрлеңіз.
Dialogue: 0,1:07:17.15,1:07:20.07,Default,,0,0,0,,Сонда сіз түтіннің үстіндегі әлемді көре аласыз.
Dialogue: 0,1:07:21.95,1:07:24.45,Default,,0,0,0,,Бұл дүниенің сырынан хабардар екенсің.
Dialogue: 0,1:07:25.12,1:07:27.83,Default,,0,0,0,,Әкем маған суретті әңгіме арқылы үйретті.
Dialogue: 0,1:07:29.79,1:07:32.42,Default,,0,0,0,,Түсіндім, сен Бруноның ұлысың.
Dialogue: 0,1:07:32.50,1:07:33.50,Default,,0,0,0,,Шедевр
Dialogue: 0,1:07:33.59,1:07:35.59,Default,,0,0,0,,Бұл қан, мен бұл жігітке қарсы тұра алмаймын.
Dialogue: 0,1:07:36.80,1:07:38.72,Default,,0,0,0,,Оның қаншалықты рас екенін білмеймін, бірақ...
Dialogue: 0,1:07:38.80,1:07:41.68,Default,,0,0,0,,Көміршілер арасында бір әңгіме бар.
Dialogue: 0,1:07:43.26,1:07:44.01,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:44.77,1:07:47.06,Default,,0,0,0,,Бұл қаланың қалай құрылғаны туралы әңгіме.
Dialogue: 0,1:07:48.60,1:07:49.77,Default,,0,0,0,,Маған хабарлаңыз
Dialogue: 0,1:07:51.94,1:07:53.73,Default,,0,0,0,,250 жыл бұрын—
Dialogue: 0,1:07:53.82,1:07:56.94,Default,,0,0,0,,Теңіздің арғы жағында өте өрескел қала бар еді.
Dialogue: 0,1:07:57.03,1:07:59.45,Default,,0,0,0,,Ұрлық пен кісі өлтіру әдеттегідей
Dialogue: 0,1:07:59.53,1:08:03.12,Default,,0,0,0,,Адамдардың өмірін ақша, жүрегін ақша басқарады.
Dialogue: 0,1:08:03.20,1:08:05.79,Default,,0,0,0,,Ақыры олар бір-біріне ұрыса бастады.
Dialogue: 0,1:08:05.87,1:08:08.62,Default,,0,0,0,,Сильвио хаты осы үрдіске қосылды.
Dialogue: 0,1:08:08.71,1:08:10.08,Default,,0,0,0,,Ол қаланың экономисі.
Dialogue: 0,1:08:10.92,1:08:13.63,Default,,0,0,0,,Барлық әріптер уақыт өте келе шіріп кетеді.
Dialogue: 0,1:08:13.71,1:08:16.00,Default,,0,0,0,,Құнының төмендеуіне қарамастан—
Dialogue: 0,1:08:16.09,1:08:18.92,Default,,0,0,0,,Мәселе тек ақшаның шірімейтінінде болды.
Dialogue: 0,1:08:19.76,1:08:24.10,Default,,0,0,0,,Осыған байланысты ақшасы барлар ет пен балыққа қарағанда көбірек билікке ие.
Dialogue: 0,1:08:24.18,1:08:27.18,Default,,0,0,0,,Ол ақша үшін күрес басталатынын айтты.
Dialogue: 0,1:08:27.93,1:08:29.18,Default,,0,0,0,,Осылайша хат жасалды -
Dialogue: 0,1:08:29.27,1:08:32.02,Default,,0,0,0,,«L» ақшасы уақыт өте келе шіриді.
Dialogue: 0,1:08:32.10,1:08:34.15,Default,,0,0,0,,«L» уақыт өткен сайын нашарлайды.
Dialogue: 0,1:08:34.23,1:08:35.98,Default,,0,0,0,,Мән төмендей береді
Dialogue: 0,1:08:36.73,1:08:38.40,Default,,0,0,0,,Бұл жігіт джекпотты соқты
Dialogue: 0,1:08:38.49,1:08:40.49,Default,,0,0,0,,Оны жинасаң да, бәрібір шіріп кетеді...
Dialogue: 0,1:08:40.57,1:08:44.45,Default,,0,0,0,,Адамдар «L» әрпін белсенді қолданып, қала өте жанданды.
Dialogue: 0,1:08:44.53,1:08:47.79,Default,,0,0,0,,Бірақ бұл ұзаққа созылмады
Dialogue: 0,1:08:47.87,1:08:52.54,Default,,0,0,0,,Тез бұзылатын ақшаның таралуынан ыңғайсыздыққа ұшырағандар болды.
Dialogue: 0,1:08:52.62,1:08:53.92,Default,,0,0,0,,Орталық банк.
Dialogue: 0,1:08:54.79,1:08:57.38,Default,,0,0,0,,Бұл қала ақшаның құлдығынан құтылды.
Dialogue: 0,1:08:57.46,1:08:59.63,Default,,0,0,0,,Мен бостандыққа қол жеткіздім
Dialogue: 0,1:08:59.71,1:09:01.42,Default,,0,0,0,,Оны не үшін алып кету керек?
Dialogue: 0,1:09:01.51,1:09:03.68,Default,,0,0,0,,Бізден жауап сұрамаңыз
Dialogue: 0,1:09:03.76,1:09:05.68,Default,,0,0,0,,Бұл орталық ерік.
Dialogue: 0,1:09:06.35,1:09:07.47,Default,,0,0,0,,Ақымақ
Dialogue: 0,1:09:07.56,1:09:09.77,Default,,0,0,0,,Тым көп ойламаңыз
Dialogue: 0,1:09:09.85,1:09:11.98,Default,,0,0,0,,Сіздің де отбасыңыз бар, солай ма?
Dialogue: 0,1:09:12.06,1:09:13.56,Default,,0,0,0,,Менімен бірге жүріңізші.
Dialogue: 0,1:09:13.65,1:09:14.65,Default,,0,0,0,,Сенде ондай мақсат болса да…
Dialogue: 0,1:09:15.77,1:09:18.90,Default,,0,0,0,,Қаланы сақтап қалған «L» ғажайып валютасы жойылды
Dialogue: 0,1:09:18.98,1:09:21.95,Default,,0,0,0,,Хат елде тәртіпсіздік туғызғаны үшін орындалды.
Dialogue: 0,1:09:22.03,1:09:23.45,Default,,0,0,0,,Қала тағы да қаңырап қалды.
Dialogue: 0,1:09:24.16,1:09:26.53,Default,,0,0,0,,Сол кезде Хаттың баласы орнынан тұрды.
Dialogue: 0,1:09:27.16,1:09:31.20,Default,,0,0,0,,Оның жан-жағындағы жанұясы мен жолдастары «L» әрпін жандандыруға ант берді.
Dialogue: 0,1:09:31.29,1:09:33.79,Default,,0,0,0,,Олар «L» енді ешқашан ұсақталмайтынына көз жеткізеді.
Dialogue: 0,1:09:33.87,1:09:37.29,Default,,0,0,0,,Орталық банктердің қолы жетпейтін жерлерді іздеуге шешім қабылдады.
Dialogue: 0,1:09:38.21,1:09:40.13,Default,,0,0,0,,Бұл осында ма?
Dialogue: 0,1:09:40.21,1:09:41.59,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,1:09:41.67,1:09:44.09,Default,,0,0,0,,Олар осы жерге қала салуға шешім қабылдады —
Dialogue: 0,1:09:44.18,1:09:48.05,Default,,0,0,0,,Теңізге шығуға тыйым салынады және сыртқы әлеммен байланыс толығымен үзіледі
Dialogue: 0,1:09:48.76,1:09:51.43,Default,,0,0,0,,Теңіздегі құбыжықтар...
Dialogue: 0,1:09:51.52,1:09:55.23,Default,,0,0,0,,Бұл қаладағы адамдарды тоқтату үшін жасалған өтірік болса керек.
Dialogue: 0,1:09:55.31,1:09:58.77,Default,,0,0,0,,Олар сыртқы әлемге әсер етуден өте қорқады.
Dialogue: 0,1:09:58.86,1:10:00.07,Default,,0,0,0,,Сыртқы әлем туралы білгенде—
Dialogue: 0,1:10:00.15,1:10:03.70,Default,,0,0,0,,Сыртқа шыққысы келген адам пайда болып, алмасу туады.
Dialogue: 0,1:10:03.78,1:10:06.41,Default,,0,0,0,,Өйткені орталық банк анықтайтын болады.
Dialogue: 0,1:10:07.03,1:10:10.74,Default,,0,0,0,,Хаттар отбасының ұрпақтар бойы жалғастырып келе жатқан бір ғана жұмысы бар.
Dialogue: 0,1:10:10.83,1:10:14.66,Default,,0,0,0,,Қала тұрғындарына сыртқы дүниені ұмыттыру.
Dialogue: 0,1:10:15.50,1:10:16.42,Default,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,1:10:17.00,1:10:18.75,Default,,0,0,0,,Мен түтін жақтым!
Dialogue: 0,1:10:19.34,1:10:22.34,Default,,0,0,0,,Бұршақтарды мұнда-мұнда қондырып, Аспанды түтінге тұншықтырды.
Dialogue: 0,1:10:22.42,1:10:24.34,Default,,0,0,0,,Мен сыртқы әлемнен айырылдым
Dialogue: 0,1:10:26.34,1:10:28.76,Default,,0,0,0,,Атам бұл туралы ешкімге айтпа деп...
Dialogue: 0,1:10:28.85,1:10:30.56,Default,,0,0,0,,Мен шегеленген болсам да...
Dialogue: 0,1:10:30.64,1:10:33.85,Default,,0,0,0,,Мен барда мас болдым, енді ғана сөйлесе бастадық.
Dialogue: 0,1:10:33.93,1:10:35.19,Default,,0,0,0,,Кімге?
Dialogue: 0,1:10:35.27,1:10:36.85,Default,,0,0,0,,Бұл сенің әкең.
Dialogue: 0,1:10:39.19,1:10:40.19,Default,,0,0,0,,Лубитч
Dialogue: 0,1:10:40.27,1:10:42.78,Default,,0,0,0,,Жарылыс орталықта болмаса, оның мағынасы жоқ.
Dialogue: 0,1:10:43.49,1:10:44.28,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,1:10:45.24,1:10:45.90,Default,,0,0,0,,Иә
Dialogue: 0,1:10:49.74,1:10:50.41,Default,,0,0,0,,Мылтық —
Dialogue: 0,1:10:53.37,1:10:55.04,Default,,0,0,0,,Бұл жеткілікті ме?
Dialogue: 0,1:10:57.17,1:10:59.54,Default,,0,0,0,,Уау...
Dialogue: 0,1:11:00.71,1:11:01.38,Default,,0,0,0,,Лубич
Dialogue: 0,1:11:02.46,1:11:04.55,Default,,0,0,0,,Түтіннің арғы жағында не бар?
Dialogue: 0,1:11:05.17,1:11:06.05,Default,,0,0,0,,Бұл жұлдыз
Dialogue: 0,1:11:08.39,1:11:09.72,Default,,0,0,0,,Бұл қызықты емес пе?
Dialogue: 0,1:11:10.39,1:11:13.22,Default,,0,0,0,,♪ Егер сенгің келетін арман болса
Dialogue: 0,1:11:13.31,1:11:16.98,Default,,0,0,0,,♪ Менде бұрыннан бар
Dialogue: 0,1:11:17.06,1:11:23.82,Default,,0,0,0,,♪ Сізге тек сену үшін батылдық қажет
Dialogue: 0,1:11:23.90,1:11:30.49,Default,,0,0,0,,♪ Мықты болу сенің әлсіз болғаның емес.
Dialogue: 0,1:11:30.57,1:11:35.83,Default,,0,0,0,,♪ Сізді алдай алмайсыз
Dialogue: 0,1:11:35.91,1:11:40.17,Default,,0,0,0,,♪ Мұнда емес
Dialogue: 0,1:11:42.84,1:11:47.01,Default,,0,0,0,,♪ бір жерде
Dialogue: 0,1:11:51.22,1:11:57.85,Default,,0,0,0,,♪ Болашақты өзгертуге болатыны
Dialogue: 0,1:11:57.93,1:12:04.15,Default,,0,0,0,,♪ Барып тексерейік (аспанға)
Dialogue: 0,1:12:04.23,1:12:08.74,Default,,0,0,0,,♪ Асылмайтын қабырғаның арғы жағында
Dialogue: 0,1:12:08.82,1:12:11.24,Default,,0,0,0,,♪ Әрине тағдыр
Dialogue: 0,1:12:11.32,1:12:13.37,Default,,0,0,0,,♪ Бізді күтуде
Dialogue: 0,1:12:13.45,1:12:17.12,Default,,0,0,0,,♪ Сіз оянған сәтте
Dialogue: 0,1:12:17.20,1:12:22.08,Default,,0,0,0,,♪ Қате жібермеу дұрыс па?
Dialogue: 0,1:12:22.17,1:12:24.75,Default,,0,0,0,,♪ Бұл дұрыс болуы мүмкін емес.
Dialogue: 0,1:12:24.84,1:12:31.84,Default,,0,0,0,,♪ Қорқақтық тек кедергі, сондықтан оны артта қалдырайық.
Dialogue: 0,1:12:33.47,1:12:36.06,Default,,0,0,0,,♪ (Алдын ала)
Dialogue: 0,1:12:36.14,1:12:38.52,Default,,0,0,0,,Мен қай жерде жаттығып жүргенімді ойлайсың?
Dialogue: 0,1:12:40.69,1:12:43.19,Default,,0,0,0,,Табылды! Жарайды... мен әлі дайын емеспін...
Dialogue: 0,1:12:43.27,1:12:45.98,Default,,0,0,0,,
Dialogue: 0,1:12:46.07,1:12:47.98,Default,,0,0,0,,Инквизиция мүшелері жиналып жатқан сияқты.
Dialogue: 0,1:12:48.57,1:12:50.24,Default,,0,0,0,,Бұл құмды жағажай. (Қала тұрғыны) Не болды?
Dialogue: 0,1:12:50.32,1:12:52.70,Default,,0,0,0,,Қоқысшы табылды.
Dialogue: 0,1:12:52.78,1:12:55.41,Default,,0,0,0,,Сай Сай Сай Сай Сай
Dialogue: 0,1:12:56.08,1:12:57.04,Default,,0,0,0,,Түсіру
Dialogue: 0,1:12:57.62,1:13:00.29,Default,,0,0,0,,Сай Сай Сай Сай Сай Сай Сай Сай Сай
Dialogue: 0,1:13:00.37,1:13:02.00,Default,,0,0,0,,Бізге асығу керек!
Dialogue: 0,1:13:02.08,1:13:03.50,Default,,0,0,0,,Жарайды, иә?
Dialogue: 0,1:13:06.34,1:13:07.63,Default,,0,0,0,,Ой, кешіріңіз.
Dialogue: 0,1:13:07.71,1:13:08.63,Default,,0,0,0,,Әй?
Dialogue: 0,1:13:08.71,1:13:11.22,Default,,0,0,0,,Сіз жұмысшы құмырсқалардың қандай екенін білесіз бе? Білесің бе.
Dialogue: 0,1:13:11.30,1:13:13.01,Default,,0,0,0,,Дегенмен, мен егжей-тегжейлерді білмеймін деп ойлаймын.
Dialogue: 0,1:13:13.09,1:13:14.43,Default,,0,0,0,,Оның аты осындай болғандықтан...
Dialogue: 0,1:13:14.51,1:13:16.10,Default,,0,0,0,,Сіз көп жұмыс істеймін деп ойлайсыз, солай емес пе?
Dialogue: 0,1:13:16.18,1:13:18.85,Default,,0,0,0,,Хмм, өкінішке орай, жұмысшы құмырсқалардың 20% жұмыс істемейді.
Dialogue: 0,1:13:18.93,1:13:19.97,Default,,0,0,0,,Басқаша айтқанда, сіз NEETсіз.
Dialogue: 0,1:13:20.06,1:13:21.73,Default,,0,0,0,,Мүйізтұмсық?
Dialogue: 0,1:13:22.31,1:13:24.06,Default,,0,0,0,,Төтенше жағдайда сатып алу уақыты
Dialogue: 0,1:13:24.15,1:13:25.48,Default,,0,0,0,,Үшінші сұрау
Dialogue: 0,1:13:25.56,1:13:28.53,Default,,0,0,0,,100 жұмысшы құмырсқаны жинап, оларды бақылаңыз. Бұл қызықты.
Dialogue: 0,1:13:28.61,1:13:32.53,Default,,0,0,0,,20% ауыр жұмыс істейді, 60% қалыпты жұмыс істейді, ал қалған 20% жиі босаңсытады.
Dialogue: 0,1:13:32.61,1:13:34.32,Default,,0,0,0,,Қоқыс адамы? Бір сәт...
Dialogue: 0,1:13:34.41,1:13:35.95,Default,,0,0,0,,Лубитч?
Dialogue: 0,1:13:36.03,1:13:38.03,Default,,0,0,0,,Бұл жолы ауыр жұмыс істейтін жұмысшылардың 20%-ы ғана...
Dialogue: 0,1:13:38.12,1:13:38.99,Default,,0,0,0,,Поупелл! Иә!
Dialogue: 0,1:13:39.08,1:13:41.45,Default,,0,0,0,,Бұл 20 жануар, сондықтан сол 20 жануардың ішінен—
Dialogue: 0,1:13:41.54,1:13:46.21,Default,,0,0,0,,20% ауыр жұмыс істейді, 60% қалыпты жұмыс істейді, ал қалған 20% жиі босаңсытады.
Dialogue: 0,1:13:46.29,1:13:47.59,Default,,0,0,0,,Кез келген уақытта және кез келген жағдайда —
Dialogue: 0,1:13:47.67,1:13:49.09,Default,,0,0,0,,Топты қалай ұйымдастырғаныңызға қарамастан—
Dialogue: 0,1:13:49.17,1:13:52.01,Default,,0,0,0,,Қатты жұмыс істейтін құмырсқалар, қалыпты жұмыс істейтін құмырсқалар және жиі босаңсыған құмырсқалар.
Dialogue: 0,1:13:52.09,1:13:54.18,Default,,0,0,0,,Бұл 2:6:2 қатынасы өзгеріссіз қалады.
Dialogue: 0,1:13:54.26,1:13:56.85,Default,,0,0,0,,Ал осы заң бойынша әрекет ететін құмырсқалар жойылған жоқ, солай ма?
Dialogue: 0,1:13:56.93,1:13:58.72,Default,,0,0,0,,Басқаша айтқанда, жиі әлсірейтін 20% ...
Dialogue: 0,1:13:58.81,1:14:01.43,Default,,0,0,0,,Бұл тұқымды сақтау үшін қажет деп ойлаймын.
Dialogue: 0,1:14:01.52,1:14:03.43,Default,,0,0,0,,Неліктен балалар, аздап босаңсуға болмайды?
Dialogue: 0,1:14:04.85,1:14:07.44,Default,,0,0,0,,Ықылықты тоқтатудың ең тиімді әдісін білесіз бе?
Dialogue: 0,1:14:07.52,1:14:08.98,Default,,0,0,0,,Маңызды күн немесе маңызды кездесу
Dialogue: 0,1:14:09.07,1:14:11.69,Default,,0,0,0,,Егер сіз осындай жағдайда ықыласты тоқтата алмасаңыз, сіз қиындыққа тап боласыз.
Dialogue: 0,1:14:11.78,1:14:12.94,Default,,0,0,0,,Мұндай жағдайда мына әдісті қолданыңыз...
Dialogue: 0,1:14:13.03,1:14:14.90,Default,,0,0,0,,Сәлем! Ол жерден кет!
Dialogue: 0,1:14:14.99,1:14:17.37,Default,,0,0,0,,О, кешіріңіз. Бұл тақырып сізді қызықтырмады ма?
Dialogue: 0,1:14:17.45,1:14:19.33,Default,,0,0,0,,Олай болса, қабырғадағы мен ілмекпен жасаған тесік...
Dialogue: 0,1:14:19.41,1:14:21.62,Default,,0,0,0,,Оны таза пломбалаудың амалын айтайық.
Dialogue: 0,1:14:21.70,1:14:24.21,Default,,0,0,0,,Бұл ыңғайсыздық! Олар теңізге шықпақшы!
Dialogue: 0,1:14:24.29,1:14:25.92,Default,,0,0,0,,ше? не айтып тұрсың
Dialogue: 0,1:14:26.00,1:14:27.33,Default,,0,0,0,,Олар теңізге бармайды
Dialogue: 0,1:14:27.42,1:14:29.59,Default,,0,0,0,,Мен сендерге жұлдыздарды көрсетуге барамын.
Dialogue: 0,1:14:32.17,1:14:33.26,Default,,0,0,0,,Жоқ
Dialogue: 0,1:14:33.34,1:14:35.09,Default,,0,0,0,,Не? (Бала) Жұлдыз?
Dialogue: 0,1:14:36.43,1:14:37.51,Default,,0,0,0,,Сай Сай
Dialogue: 0,1:14:38.09,1:14:39.97,Default,,0,0,0,,Сіз сөйлестіңіз.
Dialogue: 0,1:14:40.05,1:14:40.93,Default,,0,0,0,,Тезірек барайық
Dialogue: 0,1:14:43.85,1:14:46.52,Default,,0,0,0,,Жұлдыз...?
Dialogue: 0,1:14:46.60,1:14:48.81,Default,,0,0,0,,Ал, мен не айтайын...
Dialogue: 0,1:14:48.90,1:14:50.48,Default,,0,0,0,,Менің жұмысым осында аяқталады.
Dialogue: 0,1:14:50.57,1:14:52.23,Default,,0,0,0,,Бұл күрек болды
Dialogue: 0,1:14:52.82,1:14:54.36,Default,,0,0,0,,(Бұрғылау дыбысы)
Dialogue: 0,1:14:55.82,1:14:56.86,Default,,0,0,0,,Жұлдыз?
Dialogue: 0,1:14:56.95,1:14:58.20,Default,,0,0,0,,Жұлдыз дегеніміз не?
Dialogue: 0,1:14:58.28,1:15:01.66,Default,,0,0,0,,Хаа һаа һаа һаа…
Dialogue: 0,1:15:03.49,1:15:05.46,Default,,0,0,0,,Га... Лубич
Dialogue: 0,1:15:05.54,1:15:06.92,Default,,0,0,0,,Қараңдаршы қандай жұлдыздар?
Dialogue: 0,1:15:07.00,1:15:09.71,Default,,0,0,0,,Бұл Бруноның сурет-әңгіме шоуындағы емес пе?
Dialogue: 0,1:15:09.79,1:15:11.17,Default,,0,0,0,,Сіз оны көруге шындап қарайсыз ба?
Dialogue: 0,1:15:11.25,1:15:14.05,Default,,0,0,0,,Ха, олай болуы мүмкін емес. Оян.
Dialogue: 0,1:15:14.13,1:15:15.38,Default,,0,0,0,,Уф!
Dialogue: 0,1:15:15.47,1:15:17.76,Default,,0,0,0,,Түс көрмеңіз және оғаш нәрселерді айтпаңыз
Dialogue: 0,1:15:17.84,1:15:20.72,Default,,0,0,0,,Ол жұлдыздарды көруге тырысып жатқан сияқты.
Dialogue: 0,1:15:20.80,1:15:24.52,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба? Мұндай нәрсенің болуы мүмкін емес.
Dialogue: 0,1:15:24.60,1:15:25.56,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,1:15:25.64,1:15:26.60,Default,,0,0,0,,Иә?
Dialogue: 0,1:15:28.35,1:15:29.48,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,1:15:30.44,1:15:31.86,Default,,0,0,0,,Бұл ыңғайсыздық!
Dialogue: 0,1:15:31.94,1:15:33.07,Default,,0,0,0,,Иә!
Dialogue: 0,1:15:34.07,1:15:36.07,Default,,0,0,0,,Оны біреу көрді ме?
Dialogue: 0,1:15:38.32,1:15:41.66,Default,,0,0,0,,Сол түтіннің арғы жағында не бар екенін біреу көрді ме?
Dialogue: 0,1:15:41.74,1:15:43.24,Default,,0,0,0,,Ешкім қарап тұрған жоқ.
Dialogue: 0,1:15:44.33,1:15:46.00,Default,,0,0,0,,Сонда сіз әлі білмейсіз!
Dialogue: 0,1:15:46.62,1:15:50.12,Default,,0,0,0,,Жұлдыздар бар ма білмеймін, жоқ па білмеймін
Dialogue: 0,1:15:50.96,1:15:53.09,Default,,0,0,0,,Түсінбеген нәрсеге қақпақ қойсаңыз...
Dialogue: 0,1:15:53.17,1:15:55.00,Default,,0,0,0,,Егер мен қақпақты мәңгілік жабық ұстасам...
Dialogue: 0,1:15:56.84,1:15:59.09,Default,,0,0,0,,Ештеңе басталмайды!
Dialogue: 0,1:16:04.18,1:16:05.81,Default,,0,0,0,,Хаа ха...
Dialogue: 0,1:16:05.89,1:16:08.60,Default,,0,0,0,,Ой... Кешіріңіз.
Dialogue: 0,1:16:08.69,1:16:09.81,Default,,0,0,0,,Кешірім сұрама!
Dialogue: 0,1:16:12.98,1:16:14.77,Default,,0,0,0,,Кешірім сұрама, Любич.
Dialogue: 0,1:16:15.65,1:16:18.95,Default,,0,0,0,,Қашан қателестің?
Dialogue: 0,1:16:23.53,1:16:25.49,Default,,0,0,0,,Сенің әкең сондай мейірімді емес пе?
Dialogue: 0,1:16:27.45,1:16:28.33,Default,,0,0,0,,Ана
Dialogue: 0,1:16:29.04,1:16:31.25,Default,,0,0,0,,Ата-аналар мен балалар бірге не істеп жатыр?
Dialogue: 0,1:16:32.29,1:16:33.96,Default,,0,0,0,,Бармайынша білмейсің бе?
Dialogue: 0,1:16:34.59,1:16:35.84,Default,,0,0,0,,Мен жартылай ұйықтау туралы айтып тұрған жоқпын.
Dialogue: 0,1:16:36.96,1:16:38.34,Default,,0,0,0,,Сіздің әкеңіз –
Dialogue: 0,1:16:38.84,1:16:43.18,Default,,0,0,0,,Қуанғанда дауыстап күл, мұңайғанда дауыстап жыла...
Dialogue: 0,1:16:43.26,1:16:47.18,Default,,0,0,0,,Қарным ашса, еңкейемін. Мен ашуланған кезде, мен адамдарға жұдырықтаймын.
Dialogue: 0,1:16:47.27,1:16:48.98,Default,,0,0,0,,Ол үмітсіз ақымақ.
Dialogue: 0,1:16:50.81,1:16:53.15,Default,,0,0,0,,Ондай ақымаққа өтірік айту мүмкін емес.
Dialogue: 0,1:16:53.23,1:16:54.11,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:54.98,1:16:57.28,Default,,0,0,0,,Егер әкем жұлдыздар бар десе...
Dialogue: 0,1:16:59.44,1:17:00.99,Default,,0,0,0,,Жұлдыздар бар
Dialogue: 0,1:17:04.57,1:17:06.62,Default,,0,0,0,,Сен әкеңнің баласысың.
Dialogue: 0,1:17:07.41,1:17:10.25,Default,,0,0,0,,Егер сіз осы уақытқа дейін келген болсаңыз, тоқтау мағынасыз болар еді.
Dialogue: 0,1:17:10.33,1:17:12.46,Default,,0,0,0,,Мен жақсы білемін
Dialogue: 0,1:17:14.63,1:17:17.25,Default,,0,0,0,,Сонша барғың келсе, бар.
Dialogue: 0,1:17:18.63,1:17:20.42,Default,,0,0,0,,Бірақ бұл менің анамның бұйрығы.
Dialogue: 0,1:17:23.09,1:17:26.26,Default,,0,0,0,,Мен міндетті түрде қайтамын!
Dialogue: 0,1:17:27.35,1:17:28.26,Default,,0,0,0,,Иә!
Dialogue: 0,1:17:30.77,1:17:31.56,Default,,0,0,0,,Аа...
Dialogue: 0,1:17:33.60,1:17:35.69,Default,,0,0,0,,Не істеп жатырсың! Есейтті ұстаңыз!
Dialogue: 0,1:17:35.77,1:17:37.77,Default,,0,0,0,,Сай Сай Сай Сай Сай Сай Сай Сай Сай
Dialogue: 0,1:17:40.61,1:17:42.15,Default,,0,0,0,,Сай Сай Сай Сай
Dialogue: 0,1:17:42.24,1:17:43.40,Default,,0,0,0,,Оған қол тигізбеңіз!
Dialogue: 0,1:17:48.66,1:17:50.41,Default,,0,0,0,,(Айқай)
Dialogue: 0,1:17:50.50,1:17:51.20,Default,,0,0,0,,Ах!
Dialogue: 0,1:17:52.66,1:17:55.00,Default,,0,0,0,,Сіздің ойыңызша, мұндай нәрсеге рұқсат етілген бе?
Dialogue: 0,1:17:55.08,1:17:56.21,Default,,0,0,0,,Мына адамды да қолға түсір!
Dialogue: 0,1:17:56.29,1:17:58.09,Default,,0,0,0,,Сай Сай Сай Сай Сай Сай Сай Сай Сай
Dialogue: 0,1:18:01.51,1:18:02.55,Default,,0,0,0,,Көз...
Dialogue: 0,1:18:04.51,1:18:05.64,Default,,0,0,0,,Гува!
Dialogue: 0,1:18:07.64,1:18:09.39,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:18:09.47,1:18:11.39,Default,,0,0,0,,Еретиктер мұқият жойылады.
Dialogue: 0,1:18:11.47,1:18:12.64,Default,,0,0,0,,бидғат?
Dialogue: 0,1:18:13.43,1:18:15.02,Default,,0,0,0,,Бұл сәл басқаша.
Dialogue: 0,1:18:15.90,1:18:22.24,Default,,0,0,0,,Мен бұл туралы біртүрлі нәрсені сезінгендіктен ұзақ уақыт бойы ешқандай әрекет жасай алмадым.
Dialogue: 0,1:18:23.11,1:18:24.86,Default,,0,0,0,,Барлығының дауысы!
Dialogue: 0,1:18:26.41,1:18:27.57,Default,,0,0,0,,Cy…
Dialogue: 0,1:18:35.54,1:18:36.96,Default,,0,0,0,,Мммм (хат) Ах...
Dialogue: 0,1:18:41.05,1:18:42.59,Default,,0,0,0,,Менің жүрегім дүрсілдеп тұр.
Dialogue: 0,1:18:43.30,1:18:45.17,Default,,0,0,0,,Ұстаңыз!
Dialogue: 0,1:18:45.26,1:18:47.09,Default,,0,0,0,,Сай Сай Сай Сай Сай Сай Сай Сай Сай
Dialogue: 0,1:18:47.18,1:18:49.97,Default,,0,0,0,,Уау!
Dialogue: 0,1:18:52.77,1:18:53.85,Default,,0,0,0,,Ах!
Dialogue: 0,1:18:58.31,1:19:00.19,Default,,0,0,0,,Хо хо хо хо
Dialogue: 0,1:19:07.11,1:19:08.28,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:19:09.87,1:19:13.41,Default,,0,0,0,,(Инквизитордың айқайы)
Dialogue: 0,1:19:36.73,1:19:38.44,Default,,0,0,0,,Біз сізді қуып жетеміз. Тез жүріңіз!
Dialogue: 0,1:19:40.19,1:19:42.57,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:19:45.03,1:19:46.57,Default,,0,0,0,,Егер жұлдыз табылса...
Dialogue: 0,1:19:47.36,1:19:48.91,Default,,0,0,0,,Егер жұлдыз табылса—
Dialogue: 0,1:19:49.74,1:19:52.53,Default,,0,0,0,,Сол күні бас тартқаныңыз үшін өзіңізді ақымақ сезінбейсіз бе?
Dialogue: 0,1:19:52.62,1:19:53.58,Default,,0,0,0,,Уг!?
Dialogue: 0,1:19:55.91,1:19:58.04,Default,,0,0,0,,Жарайды, жұлдыздар бар.
Dialogue: 0,1:19:58.12,1:19:59.83,Default,,0,0,0,,Мен оны өз көзіммен көрдім.
Dialogue: 0,1:20:00.42,1:20:02.00,Default,,0,0,0,,Тез тексеріңіз.
Dialogue: 0,1:20:02.08,1:20:04.09,Default,,0,0,0,,Жалқау болмаңыз!
Dialogue: 0,1:20:04.17,1:20:04.71,Default,,0,0,0,,Ха…
Dialogue: 0,1:20:07.30,1:20:09.97,Default,,0,0,0,,Ақымақ! Менің жылайтын уақытым жоқ
Dialogue: 0,1:20:10.05,1:20:10.93,Default,,0,0,0,,Сондай-ақ сиқыр сенің ерніңе де әсер етсін…
Dialogue: 0,1:20:11.89,1:20:12.47,Default,,0,0,0,,Жарайсың!
Dialogue: 0,1:20:12.55,1:20:15.31,Default,,0,0,0,,Бәріміз бірге жасасақ, сәл жылдамырақ болады.
Dialogue: 0,1:20:15.39,1:20:16.22,Default,,0,0,0,,Уф!
Dialogue: 0,1:20:22.10,1:20:22.73,Default,,0,0,0,,Ах
Dialogue: 0,1:20:26.65,1:20:27.90,Default,,0,0,0,,Сондай-ақ сиқыр сенің ерніңе де әсер етсін…
Dialogue: 0,1:20:35.03,1:20:36.70,Default,,0,0,0,,Сондай-ақ сиқыр сенің ерніңе де әсер етсін…
Dialogue: 0,1:20:39.83,1:20:42.21,Default,,0,0,0,,Сай Сай Сай Сай Сай Сай Сай Сай Сай
Dialogue: 0,1:20:42.29,1:20:43.08,Default,,0,0,0,,(Айқай)
Dialogue: 0,1:20:43.67,1:20:44.29,Default,,0,0,0,,Ах!
Dialogue: 0,1:20:45.75,1:20:47.09,Default,,0,0,0,,Грррр!
Dialogue: 0,1:20:47.17,1:20:49.09,Default,,0,0,0,,Сондай-ақ сиқыр сенің ерніңе де әсер етсін…
Dialogue: 0,1:20:57.31,1:20:58.14,Default,,0,0,0,,Ах!
Dialogue: 0,1:20:58.68,1:20:59.98,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,1:21:01.81,1:21:02.81,Default,,0,0,0,,Антонио!
Dialogue: 0,1:21:03.98,1:21:04.61,Default,,0,0,0,,Лубич!
Dialogue: 0,1:21:15.03,1:21:16.37,Default,,0,0,0,,Жарайсыңдар! (Инквизитор) А...
Dialogue: 0,1:21:24.46,1:21:25.79,Default,,0,0,0,,Барайық Поупель
Dialogue: 0,1:21:27.63,1:21:29.26,Default,,0,0,0,,Әкем көрген табиғатқа
Dialogue: 0,1:21:29.88,1:21:30.97,Default,,0,0,0,,Иә!
Dialogue: 0,1:21:35.39,1:21:36.80,Default,,0,0,0,,Польнарефф?
Dialogue: 0,1:21:36.89,1:21:38.18,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,1:21:43.23,1:21:45.27,Default,,0,0,0,,（）
Dialogue: 0,1:22:27.44,1:22:30.69,Default,,0,0,0,,Ах! Апыр-ай! Апыр-ай!
Dialogue: 0,1:22:33.19,1:22:35.45,Default,,0,0,0,,Уау~
Dialogue: 0,1:22:35.53,1:22:37.95,Default,,0,0,0,,Уау! Уа, ау...
Dialogue: 0,1:22:50.21,1:22:51.30,Default,,0,0,0,,А, аа!
Dialogue: 0,1:22:54.17,1:22:55.13,Default,,0,0,0,,Ах...
Dialogue: 0,1:22:55.22,1:22:57.30,Default,,0,0,0,,Ши... мықтап ұстаңыз!
Dialogue: 0,1:22:58.30,1:22:59.55,Default,,0,0,0,,Уау!
Dialogue: 0,1:23:00.60,1:23:03.22,Default,,0,0,0,,Уа, ау... Ах!
Dialogue: 0,1:23:03.72,1:23:04.85,Default,,0,0,0,,Ах!
Dialogue: 0,1:23:10.02,1:23:12.48,Default,,0,0,0,,Әке, бұл жолы қандай оқиға болды?
Dialogue: 0,1:23:12.57,1:23:13.65,Default,,0,0,0,,О
Dialogue: 0,1:23:13.73,1:23:16.95,Default,,0,0,0,,Бұл дүниеде теңізге шығуға тыйым салынған, солай ма?
Dialogue: 0,1:23:17.03,1:23:18.07,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,1:23:18.16,1:23:21.12,Default,,0,0,0,,Осы кезде бір адам кеме жасап, теңізге шықты.
Dialogue: 0,1:23:21.20,1:23:23.62,Default,,0,0,0,,Поупельдің шытырман оқиғалы драмасы
Dialogue: 0,1:23:24.12,1:23:28.71,Default,,0,0,0,,Поупель қайықпен теңізге шығып, ақыры оны табады.
Dialogue: 0,1:23:28.79,1:23:31.04,Default,,0,0,0,,Шексіз кеңейетін сыртқы әлем
Dialogue: 0,1:23:31.13,1:23:33.92,Default,,0,0,0,,Қаланы басып тұрған түтіннің арғы жағына қарау
Dialogue: 0,1:23:34.00,1:23:35.30,Default,,0,0,0,,Бізде не бар?
Dialogue: 0,1:23:35.80,1:23:36.76,Default,,0,0,0,,Бұл жұлдыз
Dialogue: 0,1:23:38.55,1:23:41.60,Default,,0,0,0,,«Энтоцу қаласы Энтоцуға толы»
Dialogue: 0,1:23:41.68,1:23:47.27,Default,,0,0,0,,«Әр жерден түтін шығады, менің басымнан келеке түтін».
Dialogue: 0,1:23:47.35,1:23:52.98,Default,,0,0,0,,«Қара түтінмен мазақ мок, таңнан кешке дейін мазақ мок»
Dialogue: 0,1:23:53.98,1:23:58.65,Default,,0,0,0,,«Энтоцу қаласында тұратын адамдар қара түтіннің астында қалды».
Dialogue: 0,1:23:58.74,1:24:04.37,Default,,0,0,0,,«Мен көк аспанды білмеймін, жарқыраған жұлдыздарды білмеймін»
Dialogue: 0,1:24:04.99,1:24:09.58,Default,,0,0,0,,«Жоғары қараудан бас тартқан қалада бір адам жоғары қарады».
Dialogue: 0,1:24:10.29,1:24:15.67,Default,,0,0,0,,«Қаланы қаптаған қара түтін адамды ойландырды...»
Dialogue: 0,1:24:15.76,1:24:18.30,Default,,0,0,0,,«Мен барда кездестірген сөйлейтін мең...»
Dialogue: 0,1:24:18.38,1:24:21.01,Default,,0,0,0,,«Сіз маған айтқан арман оқиғасы»
Dialogue: 0,1:24:21.09,1:24:23.85,Default,,0,0,0,,«Түтіннің арғы жағындағы әлем туралы әңгіме»
Dialogue: 0,1:24:23.93,1:24:26.81,Default,,0,0,0,,«Жарқыраған дүниенің тарихы»
Dialogue: 0,1:24:26.89,1:24:32.10,Default,,0,0,0,,«Мен бұл екіталай деп ойладым, бірақ мүлде мүмкін емес деп айта алмаймын».
Dialogue: 0,1:24:32.19,1:24:34.86,Default,,0,0,0,,«Ешкім кеткен жоқ»
Dialogue: 0,1:24:35.52,1:24:37.94,Default,,0,0,0,,«Ешкімде жауап жоқ»
Dialogue: 0,1:24:38.57,1:24:41.61,Default,,0,0,0,,«Сосын адам күндіз-түні жүрді...»
Dialogue: 0,1:24:41.70,1:24:47.54,Default,,0,0,0,,«Мен түтіннің арғы жағындағы әлем туралы қайта-қайта айқайладым, бірақ...»
Dialogue: 0,1:24:48.41,1:24:51.46,Default,,0,0,0,,«Маған ақымақпын деп жатыр, мен ақымақпын...»
Dialogue: 0,1:24:51.54,1:24:54.59,Default,,0,0,0,,«Мені жігіт ретінде жұмыстан шығарды».
Dialogue: 0,1:24:55.17,1:24:58.59,Default,,0,0,0,,«Адам не істеді?»
Dialogue: 0,1:24:58.67,1:25:01.18,Default,,0,0,0,,«Адам кімді ренжітті?»
Dialogue: 0,1:25:01.26,1:25:03.84,Default,,0,0,0,,«Оған ешқандай себеп жоқ».
Dialogue: 0,1:25:04.43,1:25:09.60,Default,,0,0,0,,«Қараудан бас тартқан қалада «Көрінбейтін» қатты хоры.
Dialogue: 0,1:25:11.10,1:25:15.52,Default,,0,0,0,,«Сіз жоғары қараудан бас тартқан қалада, армандарыңыз туралы айтсаңыз, сізді күлкіге айналдырады».
Dialogue: 0,1:25:15.61,1:25:18.03,Default,,0,0,0,,«Әрекет етсең, сынға ұшырайсың»
Dialogue: 0,1:25:19.15,1:25:24.24,Default,,0,0,0,,«Қара түтін қаланы басып жатыр, тіпті кішкене жарықтың жарқырауына жол бермейді».
Dialogue: 0,1:25:24.91,1:25:30.33,Default,,0,0,0,,«Қара түтін адамдарды жалмап, барлық батылдыққа жол бермейді».
Dialogue: 0,1:25:31.00,1:25:36.34,Default,,0,0,0,,«Әйтеуір, ер адам дауысын көтеріп, дірілдеген тізесін жасырды».
Dialogue: 0,1:25:36.42,1:25:38.92,Default,,0,0,0,,«Мен кемеге мініп, теңізге шықтым».
Dialogue: 0,1:25:40.01,1:25:42.30,Default,,0,0,0,,«Мен қараңғы және қорқынышты теңізге шықтым»
Dialogue: 0,1:25:43.63,1:25:45.30,Default,,0,0,0,,«Мен ешкімсіз теңізге шықтым»
Dialogue: 0,1:25:46.26,1:25:48.93,Default,,0,0,0,,«Мен ешкіммен бірге теңізге шықтым»
Dialogue: 0,1:25:49.68,1:25:52.18,Default,,0,0,0,,«Түтіннің арғы жағындағы әлем туралы әңгіме»
Dialogue: 0,1:25:53.44,1:25:55.77,Default,,0,0,0,,«Жарқыраған дүниенің тарихы»
Dialogue: 0,1:25:56.98,1:26:02.57,Default,,0,0,0,,«Мен бұл екіталай деп ойладым, бірақ мүлде мүмкін емес деп айта алмаймын».
Dialogue: 0,1:26:03.20,1:26:05.57,Default,,0,0,0,,«Ешкім кеткен жоқ»
Dialogue: 0,1:26:07.32,1:26:09.70,Default,,0,0,0,,«Ешкімде жауап жоқ»
Dialogue: 0,1:26:12.00,1:26:16.79,Default,,0,0,0,,«Өз көзіңмен көрмес бұрын, жауап беру керек пе?»
Dialogue: 0,1:26:17.38,1:26:20.21,Default,,0,0,0,,«Сізді түтін жұтқанда не болады?»
Dialogue: 0,1:26:20.30,1:26:21.30,Default,,0,0,0,,Хаа... Иә...
Dialogue: 0,1:26:21.38,1:26:24.26,Default,,0,0,0,,«Бір толқынның үстінде, екі толқынның үстінде...»
Dialogue: 0,1:26:24.34,1:26:27.30,Default,,0,0,0,,«Дауыл соғып, уайымға салынды...»
Dialogue: 0,1:26:27.39,1:26:30.51,Default,,0,0,0,,«Қайту үшін порт жоқ.»
Dialogue: 0,1:26:31.31,1:26:34.31,Default,,0,0,0,,«Сенетін достарыңды емдеме».
Dialogue: 0,1:26:34.89,1:26:38.11,Default,,0,0,0,,«Егер байқасаңыз, кеменің түбі тесіктерге толы».
Dialogue: 0,1:26:39.52,1:26:43.28,Default,,0,0,0,,«Егер есуді тоқтатсаң, батып кетесің».
Dialogue: 0,1:26:44.15,1:26:47.11,Default,,0,0,0,,«Әрең жүзетін тозығы жеткен кеме».
Dialogue: 0,1:26:48.12,1:26:51.33,Default,,0,0,0,,«Ұзақ уақыт бойы ешқандай прогресс болған жоқ».
Dialogue: 0,1:26:52.04,1:26:55.04,Default,,0,0,0,,«Осы жерде аяқталады ма?»
Dialogue: 0,1:26:56.54,1:26:59.34,Default,,0,0,0,,«Осы жерде аяқталады ма?»
Dialogue: 0,1:27:00.71,1:27:03.38,Default,,0,0,0,,«Осы жерде аяқталады ма?»
Dialogue: 0,1:27:05.97,1:27:08.43,Default,,0,0,0,,«Адам батылдығын жинайды...»
Dialogue: 0,1:27:09.47,1:27:11.97,Default,,0,0,0,,«Жүк жіптерін шешіңіз...»
Dialogue: 0,1:27:12.06,1:27:13.68,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,1:27:13.77,1:27:16.39,Default,,0,0,0,,«Теңізде мұны істей алмайтын себептерді тастаңыз...»
Dialogue: 0,1:27:17.60,1:27:19.81,Default,,0,0,0,,«Кешіріңіз, оракулыңызды теңізге лақтырыңыз...»
Dialogue: 0,1:27:21.15,1:27:26.74,Default,,0,0,0,,«Аз мөлшердегі тағамды және белгілі бір шешімді қалдыру —»
Dialogue: 0,1:27:28.41,1:27:31.03,Default,,0,0,0,,«Толқындарға қайтадан бетпе-бет келу»
Dialogue: 0,1:27:31.78,1:27:33.33,Default,,0,0,0,,Вертолёт қонды.
Dialogue: 0,1:27:34.16,1:27:35.58,Default,,0,0,0,,Кішкене ғана
Dialogue: 0,1:27:37.16,1:27:40.75,Default,,0,0,0,,Төмен қарасаңыз, шайқалады. Жоғары қара!
Dialogue: 0,1:27:41.46,1:27:43.80,Default,,0,0,0,,Ақымақ, төмен қарасаң дірілдейді.
Dialogue: 0,1:27:43.88,1:27:45.09,Default,,0,0,0,,Жоғарыға қараңыз!
Dialogue: 0,1:28:07.44,1:28:09.74,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,1:28:09.82,1:28:10.49,Default,,0,0,0,,Ах!
Dialogue: 0,1:28:14.99,1:28:15.66,Default,,0,0,0,,Ах...
Dialogue: 0,1:28:20.83,1:28:21.92,Default,,0,0,0,,Сәттілік
Dialogue: 0,1:28:25.21,1:28:26.71,Default,,0,0,0,,Сәттілік
Dialogue: 0,1:28:32.59,1:28:33.64,Default,,0,0,0,,Әй!
Dialogue: 0,1:28:40.10,1:28:42.77,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,1:28:42.86,1:28:43.61,Default,,0,0,0,,Уф!
Dialogue: 0,1:28:47.23,1:28:48.53,Default,,0,0,0,,Қызықты…
Dialogue: 0,1:28:48.61,1:28:50.49,Default,,0,0,0,,Ки-иииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииии
Dialogue: 0,1:28:50.57,1:28:52.66,Default,,0,0,0,,Түн ортасында әлі де 36 сағат.
Dialogue: 0,1:28:52.74,1:28:53.32,Default,,0,0,0,,Ах!
Dialogue: 0,1:28:53.82,1:28:56.58,Default,,0,0,0,,Уау~
Dialogue: 0,1:28:56.66,1:28:58.75,Default,,0,0,0,,(Изуку) Ах. (Каибуки) Керо.
Dialogue: 0,1:28:59.71,1:29:01.87,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,1:29:02.67,1:29:03.75,Default,,0,0,0,,Уау!
Dialogue: 0,1:29:06.38,1:29:07.00,Default,,0,0,0,,Уф!
Dialogue: 0,1:29:08.96,1:29:11.26,Default,,0,0,0,,«Ханымдар мен мырзалар»
Dialogue: 0,1:29:11.34,1:29:14.26,Default,,0,0,0,,«Тоқтап, қараңыз.»
Dialogue: 0,1:29:14.76,1:29:17.06,Default,,0,0,0,,«Өтінемін, бәріміз сізді қарсы алуға рұқсат етіңіздер».
Dialogue: 0,1:29:17.14,1:29:20.02,Default,,0,0,0,,«Бүгін қала түні...»
Dialogue: 0,1:29:20.77,1:29:25.27,Default,,0,0,0,,«Бұл соңғы түн!»
Dialogue: 0,1:29:37.12,1:29:38.87,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:29:49.17,1:29:53.55,Default,,0,0,0,,«Адам қараңғы түннің арғы жағына қарай бет алды»
Dialogue: 0,1:29:53.63,1:29:58.26,Default,,0,0,0,,«Қайықта тек бір адам жүзеді».
Dialogue: 0,1:29:58.35,1:30:01.93,Default,,0,0,0,,«Сену, сену, сену...»
Dialogue: 0,1:30:02.64,1:30:07.19,Default,,0,0,0,,«Алға ұмтылған кеме...»
Dialogue: 0,1:30:07.27,1:30:12.32,Default,,0,0,0,,«Мен қара түтінді жарып, жарық теңізіне секірдім».
Dialogue: 0,1:30:12.40,1:30:13.07,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,1:30:13.15,1:30:16.16,Default,,0,0,0,,«Қандай керемет көрініс!»
Dialogue: 0,1:30:16.91,1:30:19.08,Default,,0,0,0,,«Қандай жарқыраған жарық!»
Dialogue: 0,1:30:20.91,1:30:22.58,Default,,0,0,0,,«Бұл болашақтың туылуы—»
Dialogue: 0,1:30:24.08,1:30:26.79,Default,,0,0,0,,«Шексіз әлем...»
Dialogue: 0,1:30:27.46,1:30:28.92,Default,,0,0,0,,«Әсер —»
Dialogue: 0,1:30:29.00,1:30:32.55,Default,,0,0,0,,«Біз өзгеретін дәуірде тұрмыз».
Dialogue: 0,1:30:33.92,1:30:36.55,Default,,0,0,0,,«Бұл сіз өзіңізге сақтайтын нәрсе ме?»
Dialogue: 0,1:30:37.18,1:30:38.97,Default,,0,0,0,,«Қаладағылардың бәріне айтайық»
Dialogue: 0,1:30:39.56,1:30:41.72,Default,,0,0,0,,«Қаладағылардың бәріне айтайық»
Dialogue: 0,1:30:43.02,1:30:46.35,Default,,0,0,0,,«Энтоцу қаласы Энтоцуға толы»
Dialogue: 0,1:30:46.44,1:30:52.36,Default,,0,0,0,,«Барлық жерде түтін көтеріліп жатыр, менің басымның үстінде түтін келеке».
Dialogue: 0,1:30:52.44,1:30:58.28,Default,,0,0,0,,«Таңнан кешке дейін қара түтінмен мазақ мок»
Dialogue: 0,1:30:59.16,1:31:02.79,Default,,0,0,0,,«Бірақ Энтоцу қаласының түтінінің үстінде...»
Dialogue: 0,1:31:03.62,1:31:06.29,Default,,0,0,0,,«Көк аспан болды».
Dialogue: 0,1:31:07.17,1:31:11.42,Default,,0,0,0,,«Жарқыраған жұлдыз болды».
Dialogue: 0,1:31:12.92,1:31:15.26,Default,,0,0,0,,Уау...
Dialogue: 0,1:31:19.05,1:31:21.81,Default,,0,0,0,,Ол қиын бала.
Dialogue: 0,1:31:21.89,1:31:22.56,Default,,0,0,0,,Ах...
Dialogue: 0,1:31:23.93,1:31:26.39,Default,,0,0,0,,А... а...
Dialogue: 0,1:31:33.44,1:31:34.61,Default,,0,0,0,,Ах...
Dialogue: 0,1:31:43.12,1:31:45.75,Default,,0,0,0,,Ер адамдар жыламауы керек
Dialogue: 0,1:31:54.42,1:31:56.01,Default,,0,0,0,,Қолыңнан келгеннің бәрін жасадың, кішкентайым.
Dialogue: 0,1:32:02.05,1:32:03.43,Default,,0,0,0,,Бұл Лубич.
Dialogue: 0,1:32:04.39,1:32:07.18,Default,,0,0,0,,Уф...
Dialogue: 0,1:32:58.90,1:33:00.36,Default,,0,0,0,,Немесе 'Akiba's●lip'
Dialogue: 0,1:33:03.78,1:33:05.12,Default,,0,0,0,,Немесе 'Akiba's●lip'
Dialogue: 0,1:33:07.70,1:33:08.95,Default,,0,0,0,,Уау...
Dialogue: 0,1:33:49.20,1:33:51.79,Default,,0,0,0,,Рахмет, әке.
Dialogue: 0,1:33:56.79,1:33:58.55,Default,,0,0,0,,Лубитч! (Дороти) Лубитч!
Dialogue: 0,1:33:59.30,1:34:02.13,Default,,0,0,0,,(қуаныштан айқайлаған адамдардың дыбыстары)
Dialogue: 0,1:34:02.22,1:34:02.72,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,1:34:02.80,1:34:04.01,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,1:34:05.89,1:34:06.47,Default,,0,0,0,,Қараңыз
Dialogue: 0,1:34:07.76,1:34:09.18,Default,,0,0,0,,Құрметті хат
Dialogue: 0,1:34:09.26,1:34:10.31,Default,,0,0,0,,Хмм
Dialogue: 0,1:34:10.39,1:34:13.48,Default,,0,0,0,,(қуанышты адамдардың дыбысы)
Dialogue: 0,1:34:16.81,1:34:18.27,Default,,0,0,0,,Темекі шегуді тоқтатыңыз
Dialogue: 0,1:34:20.15,1:34:20.94,Default,,0,0,0,,(Fat Gum) Егер оны қатты күшейтсек—
Dialogue: 0,1:34:21.90,1:34:23.28,Default,,0,0,0,,Болашақты қарсы алыңыз
Dialogue: 0,1:34:53.68,1:34:55.10,Default,,0,0,0,,Уф...
Dialogue: 0,1:34:55.19,1:34:57.10,Default,,0,0,0,,Уау... Уау...
