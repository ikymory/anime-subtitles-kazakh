Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.47,0:00:17.30,Default,,0,0,0,,Бейшара Смеагол
Dialogue: 0,0:00:17.60,0:00:18.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:19.56,0:00:21.27,Default,,0,0,0,,«Сақиналар әміршісі»
Dialogue: 0,0:00:22.14,0:00:25.19,Default,,0,0,0,,Смеаголь сақинаның сиқырлы күшіне тәнті болды.
Dialogue: 0,0:00:25.31,0:00:27.52,Default,,0,0,0,,Фродо мен Сэмді қуу
Dialogue: 0,0:00:27.65,0:00:31.48,Default,,0,0,0,,Соңында сүйікті жүзігімен бірге қайтыс болды.
Dialogue: 0,0:00:31.86,0:00:35.45,Default,,0,0,0,,Неліктен бұл соншалықты аянышты?
Dialogue: 0,0:00:35.86,0:00:39.03,Default,,0,0,0,,Дүниедегі барлық нәрсеге күдікпен қарайды
Dialogue: 0,0:00:39.16,0:00:40.87,Default,,0,0,0,,Бейбітшілік немесе құтқару жоқ...
Dialogue: 0,0:00:42.12,0:00:43.96,Default,,0,0,0,,Өйткені бұл жалғыздық
Dialogue: 0,0:00:44.37,0:00:45.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:47.63,0:00:51.25,Default,,0,0,0,,(Ұялы телефон діріл дыбысы)
Dialogue: 0,0:00:52.42,0:00:54.80,Default,,0,0,0,,Хмм?
Dialogue: 0,0:00:55.47,0:00:56.97,Default,,0,0,0,,Сузуна...?
Dialogue: 0,0:00:57.18,0:01:02.18,Default,,0,0,0,,♪～
Dialogue: 0,0:02:21.43,0:02:26.43,Default,,0,0,0,,～♪
Dialogue: 0,0:02:30.31,0:02:33.57,Default,,0,0,0,,Сіз бұл дүниеде бәрін көрдіңіз.
Dialogue: 0,0:02:34.07,0:02:36.57,Default,,0,0,0,,Ах... μ солай деді.
Dialogue: 0,0:02:36.69,0:02:38.78,Default,,0,0,0,,Мен әлі алда не күтіп тұрғанымен жұмыс істеуім керек...
Dialogue: 0,0:02:38.95,0:02:40.16,Default,,0,0,0,,Бұл дегеніміз...
Dialogue: 0,0:02:40.28,0:02:41.74,Default,,0,0,0,,Иә иә!
Dialogue: 0,0:02:41.87,0:02:44.70,Default,,0,0,0,,Сіз ойлағандай, μ бұл әлемді жасады.
Dialogue: 0,0:02:44.83,0:02:45.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:45.87,0:02:48.29,Default,,0,0,0,,Оның қалай басталғаны есімде жоқ...
Dialogue: 0,0:02:48.41,0:02:50.58,Default,,0,0,0,,Екеуміз екенін түсінгенде
Dialogue: 0,0:02:50.71,0:02:52.92,Default,,0,0,0,,Біз интернет әлемін бірге кезіп жүрдік...
Dialogue: 0,0:02:54.04,0:02:55.59,Default,,0,0,0,,Ол дүние әрқашан...
Dialogue: 0,0:02:55.71,0:02:58.46,Default,,0,0,0,,Адамның жағымсыз эмоцияларына толы болды.
Dialogue: 0,0:02:59.30,0:03:01.55,Default,,0,0,0,,Барлығы, бәрі, менде сондай қиын...
Dialogue: 0,0:03:01.68,0:03:03.51,Default,,0,0,0,,Өлеңмен түкіріп жібер...
Dialogue: 0,0:03:03.64,0:03:06.72,Default,,0,0,0,,Менің және μ-нің жүрегіміз қатты қысылғаны сонша, ауырады...
Dialogue: 0,0:03:06.85,0:03:09.06,Default,,0,0,0,,Бұл өте өкінішті болды.
Dialogue: 0,0:03:09.23,0:03:12.02,Default,,0,0,0,,Сондықтан мен барлығының бақытты болғанын қалаймын.
Dialogue: 0,0:03:12.52,0:03:16.61,Default,,0,0,0,,Мен барлық жағымсыз нәрселерді ұмытуға болатын дүние жасадым.
Dialogue: 0,0:03:21.40,0:03:23.53,Default,,0,0,0,,Бұл Мебийдің басы болды...
Dialogue: 0,0:03:23.66,0:03:24.78,Default,,0,0,0,,Мобиус?
Dialogue: 0,0:03:24.91,0:03:26.49,Default,,0,0,0,,Бұл дүниенің аты.
Dialogue: 0,0:03:26.87,0:03:30.66,Default,,0,0,0,,Шынайы өмірде көп жарақат алған адамдар
Dialogue: 0,0:03:30.79,0:03:33.17,Default,,0,0,0,,Мен μ әнінен жұбаныш іздедім.
Dialogue: 0,0:03:33.29,0:03:34.63,Default,,0,0,0,,Әр адамның жүрегі солай
Dialogue: 0,0:03:35.08,0:03:38.34,Default,,0,0,0,,μ Мобиусқа түсіп қалды...
Dialogue: 0,0:03:39.13,0:03:42.34,Default,,0,0,0,,Біраз уақыттан бері мен бұл дүниеде аздап үзілгенін сезіндім.
Dialogue: 0,0:03:43.38,0:03:46.76,Default,,0,0,0,,Бұл шындыққа айналып, сол күні көз алдымда көрінді.
Dialogue: 0,0:03:47.72,0:03:50.48,Default,,0,0,0,,Біз осы дүниеде мектептегі идеалды өмірімізді өткізіп жатырмыз.
Dialogue: 0,0:03:50.60,0:03:54.40,Default,,0,0,0,,Қайта-қайта қайталай бердім, кенет түсіндім.
Dialogue: 0,0:03:54.94,0:03:57.36,Default,,0,0,0,,Бұл музыканттың мақсаты.
Dialogue: 0,0:03:57.82,0:03:58.86,Default,,0,0,0,,Музыкант?
Dialogue: 0,0:03:59.03,0:04:02.07,Default,,0,0,0,,Сол кезде сіз сияқты өзін жайсыз сезінген адам...
Dialogue: 0,0:04:02.20,0:04:04.45,Default,,0,0,0,,Оқиғаның ашылуына себеп болды
Dialogue: 0,0:04:04.78,0:04:05.78,Default,,0,0,0,,Мобиус –
Dialogue: 0,0:04:05.91,0:04:08.16,Default,,0,0,0,,μ әнін тыңдаған әрбір адамның бақытты сезімдері.
Dialogue: 0,0:04:08.28,0:04:10.58,Default,,0,0,0,,Ол энергиядан тұрады.
Dialogue: 0,0:04:10.70,0:04:15.08,Default,,0,0,0,,Сондықтан СІЗ сияқтылар көбейсе, қиындық туады.
Dialogue: 0,0:04:15.21,0:04:17.42,Default,,0,0,0,,Ондай адамдарға, музыканттарға қарсы...
Dialogue: 0,0:04:17.84,0:04:20.34,Default,,0,0,0,,Digihead және шабуылды басқарыңыз.
Dialogue: 0,0:04:20.46,0:04:21.76,Default,,0,0,0,,Digihead…
Dialogue: 0,0:04:23.42,0:04:25.22,Default,,0,0,0,,Сіз әлгі бетперде киген жігіттер туралы айтып отырсыз ба...
Dialogue: 0,0:04:25.89,0:04:28.14,Default,,0,0,0,,Музыканттар μ күшін пайдаланады
Dialogue: 0,0:04:28.26,0:04:29.68,Default,,0,0,0,,Әр адамның жүрегінде -
Dialogue: 0,0:04:29.81,0:04:33.18,Default,,0,0,0,,Қараңғы сезімдерімді ұстай алмай, жарылып кетем
Dialogue: 0,0:04:33.31,0:04:34.81,Default,,0,0,0,,Оны сандық бағанға айналдыр
Dialogue: 0,0:04:35.48,0:04:38.48,Default,,0,0,0,,Фанатикалық μ сенушілер болып табылатын дигихедтер
Dialogue: 0,0:04:38.61,0:04:40.98,Default,,0,0,0,,Сіз сияқты байқаған адамдарды түсіру
Dialogue: 0,0:04:41.11,0:04:44.95,Default,,0,0,0,,Бұл дүниеге күмән келтірме, оны бастапқы қалпына келтіруге тырыс
Dialogue: 0,0:04:45.45,0:04:47.12,Default,,0,0,0,,Мен оларға мүлде қызықпаймын—
Dialogue: 0,0:04:47.87,0:04:49.20,Default,,0,0,0,,Миды жуу
Dialogue: 0,0:04:49.66,0:04:51.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:51.83,0:04:55.67,Default,,0,0,0,,Менің отбасым, тіпті үй жануарларым да біртүрлі көрінді. Бұл не болды?
Dialogue: 0,0:04:56.12,0:04:59.96,Default,,0,0,0,,Бұл дүниені шындыққа жақындату үшін μ жасаған.
Dialogue: 0,0:05:00.09,0:05:02.01,Default,,0,0,0,,Ол тек деректер ретінде бар.
Dialogue: 0,0:05:02.13,0:05:04.38,Default,,0,0,0,,СІЗ сияқты байқағандар үшін
Dialogue: 0,0:05:04.97,0:05:06.80,Default,,0,0,0,,Мен оның тірі зат емес екенін білемін.
Dialogue: 0,0:05:09.35,0:05:12.18,Default,,0,0,0,,Бұл дүниені қорғағысы келетін адамдар бар.
Dialogue: 0,0:05:12.31,0:05:15.06,Default,,0,0,0,,Олар үшін біздің тіршілігіміз...
Dialogue: 0,0:05:15.06,0:05:15.23,Default,,0,0,0,,Олар үшін біздің тіршілігіміз...
Dialogue: 0,0:05:15.06,0:05:15.23,Default,,0,0,0,,(Шого түрлендіру дыбысы)
Dialogue: 0,0:05:15.23,0:05:15.98,Default,,0,0,0,,(Шого түрлендіру дыбысы)
Dialogue: 0,0:05:15.98,0:05:16.81,Default,,0,0,0,,(Шого түрлендіру дыбысы)
Dialogue: 0,0:05:15.98,0:05:16.81,Default,,0,0,0,,Фалько…
Dialogue: 0,0:05:16.81,0:05:16.98,Default,,0,0,0,,Фалько…
Dialogue: 0,0:05:18.31,0:05:21.19,Default,,0,0,0,,Мен Арияның көмегін алдым
Dialogue: 0,0:05:21.32,0:05:24.44,Default,,0,0,0,,Бұл катарсис эффектісін енді қосуға болады.
Dialogue: 0,0:05:24.99,0:05:28.95,Default,,0,0,0,,Катарсис... езгіден құтылу
Dialogue: 0,0:05:29.07,0:05:30.53,Default,,0,0,0,,Катартикалық әсер – бұл
Dialogue: 0,0:05:30.66,0:05:33.41,Default,,0,0,0,,Диджихедтің күшіне ұқсас, бірақ мүлде басқа.
Dialogue: 0,0:05:33.83,0:05:36.66,Default,,0,0,0,,СІЗДІҢ ішіңізде жасырылған ауыр сезімдердің көрінісі
Dialogue: 0,0:05:36.79,0:05:39.17,Default,,0,0,0,,Бұл басқаруға болатын қару!
Dialogue: 0,0:05:39.29,0:05:40.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:41.46,0:05:44.26,Default,,0,0,0,,Мен де сол қуатты пайдалана аламын ба?
Dialogue: 0,0:05:44.38,0:05:45.59,Default,,0,0,0,,Не? Хмм...
Dialogue: 0,0:05:45.72,0:05:46.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:46.76,0:05:49.55,Default,,0,0,0,,Сіз бұл жерде әлі болмауыңыз мүмкін.
Dialogue: 0,0:05:50.05,0:05:51.85,Default,,0,0,0,,Мебиусты қорғау үшін
Dialogue: 0,0:05:51.97,0:05:54.56,Default,,0,0,0,,Егер сіз не қажет болса да жасауға дайын болсаңыз
Dialogue: 0,0:05:54.68,0:05:56.56,Default,,0,0,0,,Мен күресуді жалғастырамын
Dialogue: 0,0:05:57.06,0:05:59.90,Default,,0,0,0,,Осы Мобиустан құтылу үшін
Dialogue: 0,0:06:00.48,0:06:01.48,Default,,0,0,0,,Заң!
Dialogue: 0,0:06:01.77,0:06:04.44,Default,,0,0,0,,Өтінемін! Маған μ үнемдеуге көмектес!
Dialogue: 0,0:06:05.32,0:06:08.74,Default,,0,0,0,,μ-де барлығын бақытты етуге деген ынтасы күшті.
Dialogue: 0,0:06:09.32,0:06:11.20,Default,,0,0,0,,Азапты күнделікті өмірге оралудан гөрі
Dialogue: 0,0:06:11.32,0:06:14.33,Default,,0,0,0,,Мобиуста қалсаң, әлдеқайда бақытты боласың дейді...
Dialogue: 0,0:06:14.74,0:06:16.91,Default,,0,0,0,,Сіз бұған шындап сенесіз бе?
Dialogue: 0,0:06:17.21,0:06:19.75,Default,,0,0,0,,μ күші неғұрлым көп болса, соғұрлым көп болады
Dialogue: 0,0:06:19.87,0:06:22.38,Default,,0,0,0,,Менің қолымнан келетіні азайып келеді
Dialogue: 0,0:06:22.50,0:06:24.96,Default,,0,0,0,,Менің денем кішірейіп кетті...
Dialogue: 0,0:06:25.09,0:06:27.42,Default,,0,0,0,,Жад деректері де анық емес...
Dialogue: 0,0:06:27.63,0:06:31.64,Default,,0,0,0,,Уф... Мен енді μ тоқтай алмаймын.
Dialogue: 0,0:06:31.76,0:06:33.01,Default,,0,0,0,,Өтінемін, Рицу!
Dialogue: 0,0:06:33.47,0:06:35.52,Default,,0,0,0,,Маған күшіңді бер!
Dialogue: 0,0:06:35.64,0:06:36.89,Default,,0,0,0,,Нақты не?
Dialogue: 0,0:06:37.02,0:06:37.98,Default,,0,0,0,,Реңк пе?
Dialogue: 0,0:06:38.31,0:06:40.39,Default,,0,0,0,,Бұл туралы бәріміз ойланайық!
Dialogue: 0,0:06:40.52,0:06:43.23,Default,,0,0,0,,Не? Жоспар жоқ па?
Dialogue: 0,0:06:43.36,0:06:45.65,Default,,0,0,0,,Жоспар мүлдем жоқ сияқты.
Dialogue: 0,0:06:46.23,0:06:48.19,Default,,0,0,0,,Кіру рәсімінен кейін
Dialogue: 0,0:06:48.32,0:06:50.40,Default,,0,0,0,,Олар белсенді
Dialogue: 0,0:06:50.53,0:06:53.37,Default,,0,0,0,,Оған мүмкіндігінше көп адам қол жеткізе алады деп үміттенемін...
Dialogue: 0,0:06:53.66,0:06:56.29,Default,,0,0,0,,Уа! Наурыздағы қоян шайы туралы есеп
Dialogue: 0,0:06:56.41,0:06:57.91,Default,,0,0,0,,Тұрақты өсу Бірқалыпты өсу
Dialogue: 0,0:06:58.04,0:06:59.25,Default,,0,0,0,,Мен оны шынымен жүктеп алдым.
Dialogue: 0,0:06:59.37,0:07:02.75,Default,,0,0,0,,Хмм, «Рух кетті ме? Менің досым жоғалып кетті» дегені жақсы емес.
Dialogue: 0,0:07:06.50,0:07:07.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:07.92,0:07:10.13,Default,,0,0,0,,Эй, бұл твит...
Dialogue: 0,0:07:10.26,0:07:13.05,Default,,0,0,0,,А, бұл таң қалдыратын факт.
Dialogue: 0,0:07:13.18,0:07:15.56,Default,,0,0,0,,Төбелесші жай ғана төбелесші емес еді!
Dialogue: 0,0:07:15.68,0:07:19.23,Default,,0,0,0,,Бұл үлкен шөмішті жүктей алмайтыным өкінішті!
Dialogue: 0,0:07:19.35,0:07:20.35,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:07:20.56,0:07:21.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:21.56,0:07:23.40,Default,,0,0,0,,Бұл болуы керек...
Dialogue: 0,0:07:23.86,0:07:25.06,Default,,0,0,0,,Мүмкін-
Dialogue: 0,0:07:25.65,0:07:27.44,Default,,0,0,0,,Мүмкін сіз маған көмектесе аласыз...
Dialogue: 0,0:07:27.57,0:07:28.86,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:29.49,0:07:30.65,Default,,0,0,0,,Олай болса кеттік
Dialogue: 0,0:07:30.78,0:07:31.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:31.86,0:07:33.61,Default,,0,0,0,,Қызық емес пе?
Dialogue: 0,0:07:42.21,0:07:43.96,Default,,0,0,0,,Жюль Верн
Dialogue: 0,0:07:44.08,0:07:45.79,Default,,0,0,0,,Майкл Энде
Dialogue: 0,0:07:45.92,0:07:48.13,Default,,0,0,0,,Диана Уинн Джонс
Dialogue: 0,0:07:48.30,0:07:49.34,Default,,0,0,0,,Өйткені бұл сізге ұнайтын сияқты
Dialogue: 0,0:07:49.84,0:07:50.84,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:03.06,0:08:05.48,Default,,0,0,0,,Өткенде айтқаным осы еді...
Dialogue: 0,0:08:05.81,0:08:09.78,Default,,0,0,0,,Смеаголды аямаймын.
Dialogue: 0,0:08:09.90,0:08:12.24,Default,,0,0,0,,Ол өзінің сүйікті сақинасын алды...
Dialogue: 0,0:08:12.36,0:08:15.45,Default,,0,0,0,,Бақыттан өмірімнен айырылдым.
Dialogue: 0,0:08:16.32,0:08:18.41,Default,,0,0,0,,Бұл жеткілікті емес пе?
Dialogue: 0,0:08:18.53,0:08:19.41,Default,,0,0,0,,Фалько…
Dialogue: 0,0:08:22.83,0:08:25.96,Default,,0,0,0,,Ешкім өзінің шынайы қалауын түсіне алмайды.
Dialogue: 0,0:08:26.08,0:08:27.71,Default,,0,0,0,,Нешеу бар?
Dialogue: 0,0:08:27.84,0:08:31.92,Default,,0,0,0,,Смеагол жүрегіне адал болды.
Dialogue: 0,0:08:32.05,0:08:33.84,Default,,0,0,0,,Сіз солай ойлайсыз.
Dialogue: 0,0:08:33.97,0:08:36.68,Default,,0,0,0,,Сүйіктімді қолымда ұстау үшін
Dialogue: 0,0:08:37.22,0:08:39.14,Default,,0,0,0,,Оның өмірінің өзі
Dialogue: 0,0:08:39.89,0:08:41.60,Default,,0,0,0,,Бұл аянышты.
Dialogue: 0,0:08:42.77,0:08:46.94,Default,,0,0,0,,Оның жаны сақталды деп ойламаймын.
Dialogue: 0,0:08:47.06,0:08:48.06,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:08:49.11,0:08:52.03,Default,,0,0,0,,Сондықтан рингке жабысудан басқа амалым қалмады.
Dialogue: 0,0:08:52.78,0:08:54.74,Default,,0,0,0,,Сақина оны құтқара алмайды
Dialogue: 0,0:08:55.66,0:08:58.99,Default,,0,0,0,,Керемет жалғыздықтан құтылу үшін не қажет...
Dialogue: 0,0:08:59.45,0:09:01.99,Default,,0,0,0,,Фродо мен Сэмді айналдыру үшін.
Dialogue: 0,0:09:02.12,0:09:04.96,Default,,0,0,0,,Сіз сақинаны қуып бара жатырсыз ба?
Dialogue: 0,0:09:05.21,0:09:07.17,Default,,0,0,0,,Түсіндірулердің бірі ретінде.
Dialogue: 0,0:09:07.29,0:09:08.29,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:09:09.96,0:09:11.63,Default,,0,0,0,,Бұл ысырап.
Dialogue: 0,0:09:11.88,0:09:13.63,Default,,0,0,0,,Айналуға жол жоқ.
Dialogue: 0,0:09:19.43,0:09:23.35,Default,,0,0,0,,Сонда да адамдардың орындалмайтын армандары болады...
Dialogue: 0,0:09:24.43,0:09:24.64,Default,,0,0,0,,Бұл өте кішкентай!
Dialogue: 0,0:09:24.64,0:09:25.56,Default,,0,0,0,,Бұл өте кішкентай!
Dialogue: 0,0:09:24.64,0:09:25.56,Default,,0,0,0,,(Арияның айқайы)
Dialogue: 0,0:09:25.56,0:09:25.69,Default,,0,0,0,,(Арияның айқайы)
Dialogue: 0,0:09:25.69,0:09:26.48,Default,,0,0,0,,(Арияның айқайы)
Dialogue: 0,0:09:25.69,0:09:26.48,Default,,0,0,0,,Өте үлкен қасық! Перілер шынайы болды!
Dialogue: 0,0:09:26.48,0:09:26.60,Default,,0,0,0,,Өте үлкен қасық! Перілер шынайы болды!
Dialogue: 0,0:09:26.60,0:09:28.35,Default,,0,0,0,,Өте үлкен қасық! Перілер шынайы болды!
Dialogue: 0,0:09:26.60,0:09:28.35,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:09:28.77,0:09:30.11,Default,,0,0,0,,Ақша табуға болатын сияқты
Dialogue: 0,0:09:28.77,0:09:30.11,Default,,0,0,0,,(Арияның айқайы)
Dialogue: 0,0:09:30.11,0:09:30.36,Default,,0,0,0,,(Арияның айқайы)
Dialogue: 0,0:09:30.36,0:09:31.44,Default,,0,0,0,,(Арияның айқайы)
Dialogue: 0,0:09:30.36,0:09:31.44,Default,,0,0,0,,Наруко-сенпай!
Dialogue: 0,0:09:31.57,0:09:34.69,Default,,0,0,0,,Бұл бала өзін құлпынай дайфуку сияқты сезінеді.
Dialogue: 0,0:09:35.03,0:09:37.70,Default,,0,0,0,,Мм, пері ұстағандағы сезім Дайфуку дәмі~
Dialogue: 0,0:09:37.82,0:09:39.12,Default,,0,0,0,,Ах~ Уф!
Dialogue: 0,0:09:39.24,0:09:40.07,Default,,0,0,0,,Эххе
Dialogue: 0,0:09:40.20,0:09:41.45,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:09:41.58,0:09:43.66,Default,,0,0,0,,Оны қатты итерсең, құлпынай шығады.
Dialogue: 0,0:09:43.79,0:09:46.16,Default,,0,0,0,,Құлпынай!
Dialogue: 0,0:09:46.75,0:09:48.96,Default,,0,0,0,,Я~
Dialogue: 0,0:09:49.75,0:09:51.59,Default,,0,0,0,,«Шуға толы дүниеде...»
Dialogue: 0,0:09:51.71,0:09:54.26,Default,,0,0,0,,«Сурнай тарту» нені білдіреді?
Dialogue: 0,0:09:54.38,0:09:57.68,Default,,0,0,0,,Я, мен бұл қиын кодты жақсы түсінемін.
Dialogue: 0,0:09:57.80,0:09:58.80,Default,,0,0,0,,Вегетариандық деген нәрсе бар емес пе?
Dialogue: 0,0:09:59.09,0:10:01.01,Default,,0,0,0,,Ағаның көрнекілігі тамаша
Dialogue: 0,0:10:01.14,0:10:03.06,Default,,0,0,0,,Бұл код емес, солай ма?
Dialogue: 0,0:10:03.18,0:10:05.06,Default,,0,0,0,,Оның үстіне сіздің талғамыңыз шынымен ескірген.
Dialogue: 0,0:10:03.18,0:10:05.06,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:05.60,0:10:07.02,Default,,0,0,0,,Керней қай жерде болуы мүмкін?
Dialogue: 0,0:10:07.02,0:10:07.44,Default,,0,0,0,,Керней қай жерде болуы мүмкін?
Dialogue: 0,0:10:07.02,0:10:07.44,Default,,0,0,0,,Жарайды, жарайды, иә, иә.
Dialogue: 0,0:10:07.44,0:10:07.56,Default,,0,0,0,,Жарайды, жарайды, иә, иә.
Dialogue: 0,0:10:07.56,0:10:10.10,Default,,0,0,0,,Жарайды, жарайды, иә, иә.
Dialogue: 0,0:10:07.56,0:10:10.10,Default,,0,0,0,,Менің ойыма осы ғана келді.
Dialogue: 0,0:10:10.23,0:10:12.77,Default,,0,0,0,,Бұл жерде музыка туралы ойлағанда, біздің ойымызға DTM келеді.
Dialogue: 0,0:10:13.02,0:10:14.40,Default,,0,0,0,,Әрине!
Dialogue: 0,0:10:14.53,0:10:18.03,Default,,0,0,0,,Шынайы өмірде СІЗ μ музыкасын жақсы көретінсіз.
Dialogue: 0,0:10:18.57,0:10:21.53,Default,,0,0,0,,Барлығына μ музыкасы ұнады...
Dialogue: 0,0:10:21.99,0:10:24.29,Default,,0,0,0,,Сонда музыканттар біз сияқты.
Dialogue: 0,0:10:24.41,0:10:26.45,Default,,0,0,0,,Сіз шындықты ұнататын μ жанкүйерлерінің бірісіз бе?
Dialogue: 0,0:10:26.58,0:10:27.50,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:28.08,0:10:29.75,Default,,0,0,0,,Дәл СІЗ сияқты
Dialogue: 0,0:10:29.87,0:10:33.42,Default,,0,0,0,,Шындығында бұлар жүректерінде терең қараңғылық бар адамдар.
Dialogue: 0,0:10:33.54,0:10:34.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:35.13,0:10:36.92,Default,,0,0,0,,Шындық...?
Dialogue: 0,0:10:37.80,0:10:38.38,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:38.38,0:10:39.05,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:38.38,0:10:39.05,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:10:39.05,0:10:39.18,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:10:39.18,0:10:40.05,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:10:39.18,0:10:40.05,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:40.64,0:10:42.51,Default,,0,0,0,,Қолында мылтық, гүл ұстағандар бар ма?
Dialogue: 0,0:10:42.64,0:10:43.51,Default,,0,0,0,,Мен қайтадан келдім
Dialogue: 0,0:10:44.06,0:10:46.77,Default,,0,0,0,,Кітапханаға барған досыммен байланыса алмаймын.
Dialogue: 0,0:10:46.89,0:10:48.23,Default,,0,0,0,,Маған көмектесіңізші
Dialogue: 0,0:10:48.52,0:10:50.39,Default,,0,0,0,,Кенеттен не болды? Қадамдарды орындаңыз...
Dialogue: 0,0:10:50.52,0:10:52.40,Default,,0,0,0,,Сіз бұл туралы айтып отырсыз ба?
Dialogue: 0,0:10:52.56,0:10:53.69,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:53.81,0:10:54.69,Default,,0,0,0,,Уф
Dialogue: 0,0:10:54.82,0:10:56.53,Default,,0,0,0,,Кітапханада жаныңыз ашылды ма?
Dialogue: 0,0:10:56.78,0:11:00.07,Default,,0,0,0,,Уау... Уау!
Dialogue: 0,0:11:11.12,0:11:12.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:18.51,0:11:19.51,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:25.30,0:11:28.02,Default,,0,0,0,,Әй, хорда басқа бала бар ма?
Dialogue: 0,0:11:28.14,0:11:29.81,Default,,0,0,0,,Бұл дәретхана тағамы деп аталады, солай ма?
Dialogue: 0,0:11:29.93,0:11:31.39,Default,,0,0,0,,Мен өзімді жалғыз сезінемін~
Dialogue: 0,0:11:31.52,0:11:33.19,Default,,0,0,0,,О, дұрыс. Онда шомылайық па?
Dialogue: 0,0:11:39.69,0:11:40.90,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:11:41.82,0:11:44.20,Default,,0,0,0,,♪～
Dialogue: 0,0:11:46.95,0:11:47.95,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:48.66,0:11:50.50,Default,,0,0,0,,Сіз не тыңдап жатырсыз?
Dialogue: 0,0:11:50.62,0:11:52.67,Default,,0,0,0,,Суық тиіп қалдың ба? Жағдайың қалай?
Dialogue: 0,0:11:53.50,0:11:54.67,Default,,0,0,0,,Тыңдайсың ба?
Dialogue: 0,0:11:54.79,0:11:56.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:57.92,0:11:59.13,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:00.88,0:12:01.88,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:02.88,0:12:03.84,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:12:11.02,0:12:12.31,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:12:12.73,0:12:14.31,Default,,0,0,0,,«Лорелей»
Dialogue: 0,0:12:14.44,0:12:16.15,Default,,0,0,0,,«Гейненің өлеңдер жинағы»
Dialogue: 0,0:12:16.27,0:12:17.44,Default,,0,0,0,,Иә
Dialogue: 0,0:12:17.69,0:12:21.40,Default,,0,0,0,,Өлеңмен еліктірер мазасыздық.
Dialogue: 0,0:12:21.53,0:12:24.49,Default,,0,0,0,,«Мен Наджика туралы білмеймін, бірақ кешірім сұраймын».
Dialogue: 0,0:12:24.61,0:12:25.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:26.57,0:12:28.37,Default,,0,0,0,,Оның қауіпті екенін білсеңіз де
Dialogue: 0,0:12:28.49,0:12:31.66,Default,,0,0,0,,Әнші дауысқа қайықшы еріксіз тартылады.
Dialogue: 0,0:12:32.41,0:12:36.71,Default,,0,0,0,,Мен хорда ән айтып жүргенде, мен оны шынымен түсінбедім...
Dialogue: 0,0:12:37.46,0:12:39.30,Default,,0,0,0,,Тыңдағым келеді (Сузуна) А...
Dialogue: 0,0:12:40.09,0:12:43.63,Default,,0,0,0,,Ән айтатын даусыңыз керемет болуы керек
Dialogue: 0,0:12:43.76,0:12:45.34,Default,,0,0,0,,Ммм... бұл мүмкін емес.
Dialogue: 0,0:12:45.47,0:12:46.39,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:12:46.97,0:12:48.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:50.39,0:12:52.22,Default,,0,0,0,,Енді...
Dialogue: 0,0:12:52.35,0:12:55.44,Default,,0,0,0,,Көпшілік алдында қатты сөйлеуге болмайды...
Dialogue: 0,0:12:56.85,0:12:59.32,Default,,0,0,0,,Бұл әйел осында ма?
Dialogue: 0,0:12:59.44,0:13:00.57,Default,,0,0,0,,Бұл солай болуы керек.
Dialogue: 0,0:13:01.07,0:13:02.07,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:13:02.19,0:13:04.32,Default,,0,0,0,,Сол кезде мен Сузунаны жалғыз қалдыруым керек еді... Уа!
Dialogue: 0,0:13:04.45,0:13:05.74,Default,,0,0,0,,Мен жиіркенішті сөздер айтсам да
Dialogue: 0,0:13:05.86,0:13:07.53,Default,,0,0,0,,Бұл СІЗДІ бастамайды!
Dialogue: 0,0:13:07.78,0:13:10.03,Default,,0,0,0,,Досыңа осылай көмектесе аласың ба?
Dialogue: 0,0:13:10.24,0:13:11.58,Default,,0,0,0,,Уф, шу!
Dialogue: 0,0:13:11.83,0:13:13.33,Default,,0,0,0,,Вирча қуыршақ аузын жап!
Dialogue: 0,0:13:13.45,0:13:15.29,Default,,0,0,0,,Сіз бәрібір μ мүшесісіз!
Dialogue: 0,0:13:15.41,0:13:18.13,Default,,0,0,0,,Неге, адамдар сондай мейірімді!
Dialogue: 0,0:13:18.25,0:13:20.71,Default,,0,0,0,,Сіз сияқты кішкентай жігіттің сөзіне сене аласыз ба?
Dialogue: 0,0:13:20.84,0:13:23.51,Default,,0,0,0,,Ол үлкен, бірақ жүрегі кішкентай.
Dialogue: 0,0:13:23.63,0:13:25.26,Default,,0,0,0,,Кішкентай бауырым!
Dialogue: 0,0:13:25.38,0:13:26.30,Default,,0,0,0,,Ооо...
Dialogue: 0,0:13:26.63,0:13:28.43,Default,,0,0,0,,Мен кішкентай емеспін!
Dialogue: 0,0:13:28.55,0:13:29.55,Default,,0,0,0,,Гунунуну!
Dialogue: 0,0:13:29.68,0:13:31.76,Default,,0,0,0,,Оның алдын ала түсініктері күшті сияқты.
Dialogue: 0,0:13:32.14,0:13:34.93,Default,,0,0,0,,Растау бағыты басқаларға қарағанда күштірек болуы мүмкін
Dialogue: 0,0:13:35.06,0:13:38.23,Default,,0,0,0,,Қысқа және абайсыз әрекеттерге бейімділік
Dialogue: 0,0:13:38.35,0:13:39.48,Default,,0,0,0,,Бұл өте шулы!
Dialogue: 0,0:13:39.90,0:13:41.44,Default,,0,0,0,,Күте тұрыңыз, Сузуна.
Dialogue: 0,0:13:42.27,0:13:44.99,Default,,0,0,0,,Мен бұл кенеттен асығыс екеніне сенімдімін.
Dialogue: 0,0:13:45.86,0:13:49.37,Default,,0,0,0,,Лорелай Смеаголмен бірдей болуы мүмкін.
Dialogue: 0,0:13:49.66,0:13:51.08,Default,,0,0,0,,Жалғыздыққа тым үйренген
Dialogue: 0,0:13:51.20,0:13:53.91,Default,,0,0,0,,Адамдармен қарым-қатынас жасауды білмеймін.
Dialogue: 0,0:13:54.95,0:13:57.92,Default,,0,0,0,,Бірақ кейде бұл оңайырақ.
Dialogue: 0,0:13:58.04,0:13:59.88,Default,,0,0,0,,(Ұялы телефон діріл дыбысы)
Dialogue: 0,0:14:00.00,0:14:01.38,Default,,0,0,0,,Ха... Шүкір!
Dialogue: 0,0:14:01.50,0:14:03.38,Default,,0,0,0,,Мен оны әлі шығара алмаймын.
Dialogue: 0,0:14:03.50,0:14:06.88,Default,,0,0,0,,Сіз қиын кейіпкер сияқтысыз, сондықтан оған ренжімейсіз бе?
Dialogue: 0,0:14:07.01,0:14:08.05,Default,,0,0,0,,Әй?
Dialogue: 0,0:14:08.18,0:14:10.09,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:14:10.22,0:14:13.01,Default,,0,0,0,,Бұл кітапхана, сондықтан олардың телефонға жауап бермеу мүмкіндігі бар.
Dialogue: 0,0:14:13.14,0:14:14.39,Default,,0,0,0,,Осы жерде тынышталайық...
Dialogue: 0,0:14:14.52,0:14:16.31,Default,,0,0,0,,Сузуна! Сузуна ол қайда!
Dialogue: 0,0:14:16.85,0:14:19.27,Default,,0,0,0,,Өз қалауына адал жігіт...
Dialogue: 0,0:14:19.52,0:14:19.69,Default,,0,0,0,,Керісінше, бәрі осы сияқты ма?
Dialogue: 0,0:14:19.69,0:14:21.48,Default,,0,0,0,,Керісінше, бәрі осы сияқты ма?
Dialogue: 0,0:14:19.69,0:14:21.48,Default,,0,0,0,,Сузуна! Сузуна!
Dialogue: 0,0:14:21.48,0:14:21.61,Default,,0,0,0,,Сузуна! Сузуна!
Dialogue: 0,0:14:21.61,0:14:22.65,Default,,0,0,0,,Сузуна! Сузуна!
Dialogue: 0,0:14:21.61,0:14:22.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:24.44,0:14:26.94,Default,,0,0,0,,Жалғыздықтың жақсы болатыны рас.
Dialogue: 0,0:14:27.90,0:14:30.16,Default,,0,0,0,,Ешкімге зияны жоқ
Dialogue: 0,0:14:30.28,0:14:31.74,Default,,0,0,0,,Сіз өз әлеміңізге еніп кете аласыз
Dialogue: 0,0:14:32.28,0:14:35.87,Default,,0,0,0,,Бұл сізге қолайлы өмір жолы, солай емес пе?
Dialogue: 0,0:14:37.29,0:14:39.42,Default,,0,0,0,,Жауап беріңіз! Сузуна!
Dialogue: 0,0:14:39.54,0:14:42.79,Default,,0,0,0,,Кітапханада тыныш болыңыз! (Кутаро) Мен білмеймін!
Dialogue: 0,0:14:44.00,0:14:46.01,Default,,0,0,0,,Сіз сонша шу шығарсаңыз да...
Dialogue: 0,0:14:46.13,0:14:47.30,Default,,0,0,0,,Дәл…
Dialogue: 0,0:14:48.63,0:14:51.01,Default,,0,0,0,,Сіздің қалағаныңыздың өзі ақылға қонымсыз
Dialogue: 0,0:14:51.14,0:14:53.05,Default,,0,0,0,,Тек армандау босқа кетеді
Dialogue: 0,0:14:53.18,0:14:54.85,Default,,0,0,0,,Тек ауырады
Dialogue: 0,0:14:55.35,0:14:58.64,Default,,0,0,0,,Бірақ біз түсінетін адам болса ше?
Dialogue: 0,0:14:59.56,0:15:00.64,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:15:00.90,0:15:02.10,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:15:02.61,0:15:04.11,Default,,0,0,0,,Сузуна!
Dialogue: 0,0:15:04.23,0:15:05.11,Default,,0,0,0,,Сузуна
Dialogue: 0,0:15:06.11,0:15:07.90,Default,,0,0,0,,Сіз түсінесіз, солай ма?
Dialogue: 0,0:15:08.90,0:15:09.86,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:15:10.11,0:15:11.11,Default,,0,0,0,,Сузуна қайда!
Dialogue: 0,0:15:11.49,0:15:13.99,Default,,0,0,0,,Уау! О...
Dialogue: 0,0:15:14.12,0:15:15.49,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:15.62,0:15:17.54,Default,,0,0,0,,Сонымен... мен...
Dialogue: 0,0:15:18.66,0:15:20.16,Default,,0,0,0,,Мен саған көмектесемін...
Dialogue: 0,0:15:21.33,0:15:23.67,Default,,0,0,0,,Ха... бәріңе!
Dialogue: 0,0:15:24.13,0:15:25.59,Default,,0,0,0,,Маған күшіңді бер!
Dialogue: 0,0:15:27.25,0:15:28.59,Default,,0,0,0,,ＹＯＵ…
Dialogue: 0,0:15:29.38,0:15:30.76,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:15:31.72,0:15:33.14,Default,,0,0,0,,Жүр, кеттік (Кутару) О, а...
Dialogue: 0,0:15:33.43,0:15:34.64,Default,,0,0,0,,Ой!
Dialogue: 0,0:15:34.76,0:15:35.97,Default,,0,0,0,,Қаншалықты іздедіңіз?
Dialogue: 0,0:15:36.10,0:15:39.02,Default,,0,0,0,,Ах... 1-2-қабаттағы барлық бөлмелерді араладым.
Dialogue: 0,0:15:39.14,0:15:40.60,Default,,0,0,0,,Үшінші қабат әлі жарты жолда...
Dialogue: 0,0:15:41.77,0:15:43.69,Default,,0,0,0,,Смеагол мен Лорелай...
Dialogue: 0,0:15:43.81,0:15:45.31,Default,,0,0,0,,Бірдей ойлар болды
Dialogue: 0,0:15:46.27,0:15:48.03,Default,,0,0,0,,Мен де бұл сезімді білемін.
Dialogue: 0,0:15:48.78,0:15:51.24,Default,,0,0,0,,Түсінетіндеріңізге сенімдімін.
Dialogue: 0,0:15:51.36,0:15:52.49,Default,,0,0,0,,Сузуна...
Dialogue: 0,0:15:53.41,0:15:55.49,Default,,0,0,0,,Мен сенің бұрылғаныңды қаладым.
Dialogue: 0,0:15:55.49,0:15:56.95,Default,,0,0,0,,Мен сенің бұрылғаныңды қаладым.
Dialogue: 0,0:15:55.49,0:15:56.95,Default,,0,0,0,,Әй!
Dialogue: 0,0:15:58.54,0:15:59.54,Default,,0,0,0,,Кімге?
Dialogue: 0,0:16:02.87,0:16:04.75,Default,,0,0,0,,Айтыңызшы, Сузуна...
Dialogue: 0,0:16:04.88,0:16:05.88,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:16:06.00,0:16:07.46,Default,,0,0,0,,Сузуна!
Dialogue: 0,0:16:07.80,0:16:09.63,Default,,0,0,0,,Ха... Ақыры таптым!
Dialogue: 0,0:16:09.76,0:16:10.76,Default,,0,0,0,,Хаха...
Dialogue: 0,0:16:10.88,0:16:11.92,Default,,0,0,0,,Сенпай?
Dialogue: 0,0:16:12.47,0:16:13.80,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:16:13.93,0:16:14.84,Default,,0,0,0,,Я...
Dialogue: 0,0:16:14.97,0:16:16.35,Default,,0,0,0,,Ах, Комори-кун
Dialogue: 0,0:16:16.47,0:16:19.26,Default,,0,0,0,,Ол Котаро-сенпай.
Dialogue: 0,0:16:20.06,0:16:23.44,Default,,0,0,0,,Дұрыс, мен Йошимай орта мектебінде жоғары сыныпта оқимын...
Dialogue: 0,0:16:23.64,0:16:25.27,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:16:25.40,0:16:26.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:26.52,0:16:28.19,Default,,0,0,0,,Сәл күте тұрыңыз. Бірден...
Dialogue: 0,0:16:28.32,0:16:29.40,Default,,0,0,0,,Сәлем (Сузуна)?
Dialogue: 0,0:16:30.32,0:16:31.99,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:16:32.11,0:16:33.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:34.41,0:16:36.66,Default,,0,0,0,,Не...?
Dialogue: 0,0:16:36.91,0:16:37.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:41.95,0:16:44.42,Default,,0,0,0,,Ха! Ах...
Dialogue: 0,0:16:46.17,0:16:47.38,Default,,0,0,0,,Қуыршақ!
Dialogue: 0,0:16:47.50,0:16:48.59,Default,,0,0,0,,Бұл да!
Dialogue: 0,0:16:48.84,0:16:50.05,Default,,0,0,0,,Бұл да!
Dialogue: 0,0:16:50.67,0:16:52.30,Default,,0,0,0,,Мұнда кім бар?
Dialogue: 0,0:16:52.42,0:16:54.47,Default,,0,0,0,,Барлығының көңілдері көтерілді...
Dialogue: 0,0:16:54.59,0:16:55.59,Default,,0,0,0,,Әй!
Dialogue: 0,0:16:56.84,0:16:59.43,Default,,0,0,0,,Сіз Минезавамен бір сыныптасыз ба?
Dialogue: 0,0:17:00.56,0:17:01.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:02.60,0:17:05.52,Default,,0,0,0,,Бұл... өтірік...
Dialogue: 0,0:17:06.31,0:17:07.52,Default,,0,0,0,,Комори-кун…
Dialogue: 0,0:17:08.02,0:17:09.90,Default,,0,0,0,,Мен не болып жатқанын әлі білмеймін
Dialogue: 0,0:17:10.02,0:17:11.23,Default,,0,0,0,,Сузуна, кеттік.
Dialogue: 0,0:17:11.73,0:17:13.36,Default,,0,0,0,,Неліктен... неге?
Dialogue: 0,0:17:13.36,0:17:15.11,Default,,0,0,0,,Неліктен... неге?
Dialogue: 0,0:17:13.36,0:17:15.11,Default,,0,0,0,,Эй, жүре аласың ба?
Dialogue: 0,0:17:15.28,0:17:16.45,Default,,0,0,0,,Комори-кун, біз...
Dialogue: 0,0:17:16.45,0:17:17.66,Default,,0,0,0,,Комори-кун, біз...
Dialogue: 0,0:17:16.45,0:17:17.66,Default,,0,0,0,,Менің таңдауым жоқ
Dialogue: 0,0:17:18.62,0:17:19.62,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:21.20,0:17:22.95,Default,,0,0,0,,Не... мынау!
Dialogue: 0,0:17:29.46,0:17:32.13,Default,,0,0,0,,Киееее!
Dialogue: 0,0:17:32.25,0:17:34.97,Default,,0,0,0,,Бұл... музыкант!
Dialogue: 0,0:17:35.09,0:17:36.01,Default,,0,0,0,,Күтілгендей!
Dialogue: 0,0:17:36.26,0:17:38.89,Default,,0,0,0,,Өйткені, мен де сені сатамын!
Dialogue: 0,0:17:43.47,0:17:47.14,Default,,0,0,0,,Кагура Сузуна!
Dialogue: 0,0:17:47.35,0:17:48.73,Default,,0,0,0,,Мен бұны білгенмін.
Dialogue: 0,0:17:48.85,0:17:50.86,Default,,0,0,0,,Мен жалғыз қалғанда бақыттымын
Dialogue: 0,0:17:51.65,0:17:53.07,Default,,0,0,0,,Мен әлі де!
Dialogue: 0,0:17:53.36,0:17:55.74,Default,,0,0,0,,Ол да қуыршақ па?
Dialogue: 0,0:17:55.86,0:17:58.82,Default,,0,0,0,,Неліктен сіз Мобиуста мұндай фигураны таңдауға барар едіңіз?
Dialogue: 0,0:17:59.16,0:18:01.16,Default,,0,0,0,,Комори-кун, тыңда! мен
Dialogue: 0,0:18:01.28,0:18:03.41,Default,,0,0,0,,Идиот! Бұл қауіпті Сузуна
Dialogue: 0,0:18:03.74,0:18:06.04,Default,,0,0,0,,Нағыз бейбақтар...
Dialogue: 0,0:18:06.16,0:18:09.58,Default,,0,0,0,,Топсыз мұнда келе алмасам да...
Dialogue: 0,0:18:09.71,0:18:11.63,Default,,0,0,0,,Кешіріңіз! Кешір мені!
Dialogue: 0,0:18:11.75,0:18:13.63,Default,,0,0,0,,Кешірім жоқ! Киееее!
Dialogue: 0,0:18:13.75,0:18:14.67,Default,,0,0,0,,Қауіпті! (Сузуна) Ух...
Dialogue: 0,0:18:15.26,0:18:16.67,Default,,0,0,0,,Гррр…
Dialogue: 0,0:18:17.51,0:18:18.51,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:18.84,0:18:20.59,Default,,0,0,0,,Ах... уф...
Dialogue: 0,0:18:20.72,0:18:24.01,Default,,0,0,0,,Сен сияқты көп жиналған сорға,
Dialogue: 0,0:18:24.14,0:18:25.81,Default,,0,0,0,,Мен санкция беремін.
Dialogue: 0,0:18:26.52,0:18:28.44,Default,,0,0,0,,Сен мені енді ешқашан қорлай алмайсың, мен сені қуыршаққа айналдырамын.
Dialogue: 0,0:18:28.44,0:18:29.56,Default,,0,0,0,,Сен мені енді ешқашан кірлете алмайсың. Мен сені қуыршаққа айналдырамын.
Dialogue: 0,0:18:28.44,0:18:29.56,Default,,0,0,0,,Қияметсіз...
Dialogue: 0,0:18:29.98,0:18:31.44,Default,,0,0,0,,Котаро!
Dialogue: 0,0:18:33.23,0:18:34.44,Default,,0,0,0,,Сіз (Шого) иә?
Dialogue: 0,0:18:34.57,0:18:36.40,Default,,0,0,0,,Сіз жарақат алудан қорқасыз ба?
Dialogue: 0,0:18:36.53,0:18:37.44,Default,,0,0,0,,Әй!
Dialogue: 0,0:18:38.53,0:18:42.07,Default,,0,0,0,,Кітапханада осылай киінген жалғыз кім тығылып отыр?
Dialogue: 0,0:18:42.20,0:18:44.62,Default,,0,0,0,,Адамдармен араласудан қорқатындықтан ба?
Dialogue: 0,0:18:45.49,0:18:47.79,Default,,0,0,0,,Бірақ мен жалғыздықты жеңе алмадым
Dialogue: 0,0:18:47.91,0:18:50.87,Default,,0,0,0,,Сондықтан мен барлығын қуыршаққа айналдырып, жақын жерге қойдым.
Dialogue: 0,0:18:51.29,0:18:54.25,Default,,0,0,0,,Балаға қуыршақ кейпінде жақындады
Dialogue: 0,0:18:54.75,0:18:57.21,Default,,0,0,0,,Жүрегіңді жараламау үшін
Dialogue: 0,0:18:57.67,0:19:00.01,Default,,0,0,0,,А... шулы
Dialogue: 0,0:19:00.80,0:19:02.64,Default,,0,0,0,,(Night Eye) Мен ойлағандай, «Барлығы Бір» шын мәнінде Миллиоға берілуі керек еді.
Dialogue: 0,0:19:03.68,0:19:04.89,Default,,0,0,0,,Не...
Dialogue: 0,0:19:05.68,0:19:07.98,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:19:09.89,0:19:11.10,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:19:11.23,0:19:18.19,Default,,0,0,0,,♪ Мен Наджика туралы білмеймін
Dialogue: 0,0:19:18.69,0:19:24.41,Default,,0,0,0,,♪ Кешіріңіз
Dialogue: 0,0:19:25.78,0:19:32.75,Default,,0,0,0,,♪ Ескі аңыз
Dialogue: 0,0:19:33.04,0:19:39.88,Default,,0,0,0,,♪ Мен онымен таныспын
Dialogue: 0,0:19:41.26,0:19:43.97,Default,,0,0,0,,Мен әрқашан жалғыз болдым ...
Dialogue: 0,0:19:48.31,0:19:51.39,Default,,0,0,0,,Бұл дүниеде де өзгерген жоқ.
Dialogue: 0,0:19:52.23,0:19:55.02,Default,,0,0,0,,Сондықтан мен бас тарттым
Dialogue: 0,0:19:55.15,0:19:56.36,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:19:58.73,0:20:00.78,Default,,0,0,0,,Комори-кун, сен солай айттың.
Dialogue: 0,0:20:00.90,0:20:05.32,Default,,0,0,0,,«Смеагол Фродо мен Сэмнің бұрылғанын қалады».
Dialogue: 0,0:20:05.74,0:20:08.41,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:20:08.54,0:20:10.54,Default,,0,0,0,,Біз ұқсас болғандықтан...
Dialogue: 0,0:20:10.66,0:20:12.29,Default,,0,0,0,,Түсінгенім соншалықты ауырады.
Dialogue: 0,0:20:12.83,0:20:15.17,Default,,0,0,0,,Ол үнемі зардап шекті
Dialogue: 0,0:20:15.29,0:20:17.29,Default,,0,0,0,,Жалғыздықтан құтылғым келді
Dialogue: 0,0:20:17.67,0:20:20.76,Default,,0,0,0,,Мен біреудің бұрылғанын қаладым!
Dialogue: 0,0:20:21.09,0:20:24.43,Default,,0,0,0,,Мен Комори-кунға жақындағым келеді.
Dialogue: 0,0:20:26.30,0:20:27.51,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:20:28.93,0:20:30.14,Default,,0,0,0,,Сонымен
Dialogue: 0,0:20:30.81,0:20:33.98,Default,,0,0,0,,Түскі асты бірге жегіңіз келе ме?
Dialogue: 0,0:20:40.19,0:20:43.65,Default,,0,0,0,,Сіз қатты дауыстай аласыз
Dialogue: 0,0:20:44.66,0:20:45.78,Default,,0,0,0,,Эх!
Dialogue: 0,0:20:46.41,0:20:48.20,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:20:57.58,0:20:58.79,Default,,0,0,0,,Комори мырза…
Dialogue: 0,0:20:59.38,0:21:02.01,Default,,0,0,0,,Менің атым Шонен қуыршақ
Dialogue: 0,0:21:03.30,0:21:07.05,Default,,0,0,0,,Ол сені дұрыс жолға салады.
Dialogue: 0,0:21:13.73,0:21:16.85,Default,,0,0,0,,Мазалағаныңыз үшін кешірім сұраймыз.
Dialogue: 0,0:21:16.98,0:21:19.40,Default,,0,0,0,,Жоқ, сенің аман болғаныңа қуаныштымын.
Dialogue: 0,0:21:19.90,0:21:22.53,Default,,0,0,0,,Қош келдіңіз Сузуна, мен сізді қарсы аламын.
Dialogue: 0,0:21:22.65,0:21:24.11,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:21:24.70,0:21:26.91,Default,,0,0,0,,Ал, иықтарыңызды босаңсытыңыз.
Dialogue: 0,0:21:26.95,0:21:27.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:27.03,0:21:27.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:27.03,0:21:27.82,Default,,0,0,0,,Мен түсінбеген нәрсені сұрай аламын ба?
Dialogue: 0,0:21:27.82,0:21:29.57,Default,,0,0,0,,Мен түсінбеген нәрсені сұрай аламын ба?
Dialogue: 0,0:21:34.33,0:21:35.71,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:35.96,0:21:39.58,Default,,0,0,0,,Бұл дүние неге бәріне ұнамайды?
Dialogue: 0,0:21:39.71,0:21:41.67,Default,,0,0,0,,Бұл жеткілікті тартымды болмағандықтан емес пе?
Dialogue: 0,0:21:42.25,0:21:44.76,Default,,0,0,0,,Мен сізге айтамын.
Dialogue: 0,0:21:45.63,0:21:48.09,Default,,0,0,0,,Бұл әлемдегі ең тартымды
Dialogue: 0,0:21:48.22,0:21:50.89,Default,,0,0,0,,Ұлы тіршілік иесі кім?
Dialogue: 0,0:21:51.18,0:21:53.64,Default,,0,0,0,,Хехе... хехе...
