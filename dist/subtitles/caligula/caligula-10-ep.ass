Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.04,0:00:04.37,Default,,0,0,0,,(Есік қаққан орындық дыбысы)
Dialogue: 0,0:00:04.58,0:00:07.59,Default,,0,0,0,,Ei Ei Ei!
Dialogue: 0,0:00:08.55,0:00:11.76,Default,,0,0,0,,Сәлем! Ха...
Dialogue: 0,0:00:11.97,0:00:13.47,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:00:14.05,0:00:15.93,Default,,0,0,0,,Не болып жатыр!
Dialogue: 0,0:00:16.14,0:00:21.14,Default,,0,0,0,,♪～
Dialogue: 0,0:01:40.26,0:01:45.27,Default,,0,0,0,,～♪
Dialogue: 0,0:01:46.73,0:01:49.65,Default,,0,0,0,,Сәлем! Ха... Шүкір!
Dialogue: 0,0:01:49.94,0:01:52.77,Default,,0,0,0,,Эй, қазірдің өзінде...
Dialogue: 0,0:01:52.90,0:01:54.48,Default,,0,0,0,,Мен бас тартсам ше?
Dialogue: 0,0:01:54.78,0:01:56.44,Default,,0,0,0,,Сізге кету керек пе?
Dialogue: 0,0:01:56.86,0:01:59.28,Default,,0,0,0,,Кішкене үндемеңіз (Кутару) А?
Dialogue: 0,0:01:59.41,0:02:00.70,Default,,0,0,0,,Егер бұл Ария болса...
Dialogue: 0,0:02:00.82,0:02:03.74,Default,,0,0,0,,Сіз бұл туралы бірдеңе істей алдыңыз деп үміттенемін.
Dialogue: 0,0:02:03.87,0:02:07.41,Default,,0,0,0,,«Мен күш-қуатымды қайтардым» деген сияқты бірдеңе айтты.
Dialogue: 0,0:02:07.62,0:02:10.25,Default,,0,0,0,,Ария Сіз директормен біргесіз бе?
Dialogue: 0,0:02:10.38,0:02:12.96,Default,,0,0,0,,Мүмкін олар маған опасыздық жасаған шығар...?
Dialogue: 0,0:02:13.29,0:02:15.76,Default,,0,0,0,,Бізді осындай жерге қамап қоюға қалай дәтің бар!
Dialogue: 0,0:02:17.55,0:02:20.59,Default,,0,0,0,,Жоқ адам туралы осылай айтасың...
Dialogue: 0,0:02:20.93,0:02:22.85,Default,,0,0,0,,Менің ойымша, бұл күдікті болғандықтан шығар (Сузуна) Уау!
Dialogue: 0,0:02:22.97,0:02:25.47,Default,,0,0,0,,Жарайды, тынышталып, жоспар құр...
Dialogue: 0,0:02:25.60,0:02:26.85,Default,,0,0,0,,Сіз тыныштала аласыз ба?
Dialogue: 0,0:02:26.98,0:02:28.60,Default,,0,0,0,,Ендеше бәріміз бірге ойланайық.
Dialogue: 0,0:02:28.73,0:02:29.69,Default,,0,0,0,,Шу!
Dialogue: 0,0:02:29.81,0:02:31.44,Default,,0,0,0,,Бұл адам туралы айтатын ештеңе жоқ...
Dialogue: 0,0:02:31.56,0:02:33.31,Default,,0,0,0,,Не? Теме! (P пернесі) Тоқта!
Dialogue: 0,0:02:33.44,0:02:34.69,Default,,0,0,0,,Бұл туралы
Dialogue: 0,0:02:35.02,0:02:38.78,Default,,0,0,0,,Әй, Шого-сенпай, бірдеңе айтшы.
Dialogue: 0,0:02:39.15,0:02:41.16,Default,,0,0,0,,Бұл да маңызды...
Dialogue: 0,0:02:41.49,0:02:44.12,Default,,0,0,0,,Бірақ кім және қандай мақсатта...
Dialogue: 0,0:02:44.33,0:02:46.83,Default,,0,0,0,,Шпион бар деп айтқаным сол үшін...!
Dialogue: 0,0:02:46.95,0:02:48.29,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:02:48.41,0:02:50.75,Default,,0,0,0,,Себебі Shadow Pnife осылай аяқталды...
Dialogue: 0,0:02:50.87,0:02:51.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:51.25,0:02:51.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:51.25,0:02:51.88,Default,,0,0,0,,Мені ұруды доғар
Dialogue: 0,0:02:51.88,0:02:52.63,Default,,0,0,0,,Мені ұруды доғар
Dialogue: 0,0:02:52.75,0:02:53.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:54.00,0:02:55.96,Default,,0,0,0,,Аа, кешіріңіз...
Dialogue: 0,0:02:56.42,0:02:57.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:57.55,0:02:59.47,Default,,0,0,0,,Сол кезде көлеңкелі пышақ...
Dialogue: 0,0:02:59.59,0:03:02.68,Default,,0,0,0,,Олар бізге буксирленгендей болды.
Dialogue: 0,0:03:02.80,0:03:05.64,Default,,0,0,0,,Мұнарада ешкім болмады...
Dialogue: 0,0:03:05.76,0:03:09.43,Default,,0,0,0,,Бұл жақтағы іс-әрекеттер шеңберден шығып кеткендей болды.
Dialogue: 0,0:03:11.06,0:03:12.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:12.19,0:03:13.86,Default,,0,0,0,,Мен бе?
Dialogue: 0,0:03:13.98,0:03:16.61,Default,,0,0,0,,Себебі сіз ақпаратты әкелдіңіз.
Dialogue: 0,0:03:16.73,0:03:19.44,Default,,0,0,0,,Кейсуке тыңшы ғой!
Dialogue: 0,0:03:20.32,0:03:23.36,Default,,0,0,0,,Шпион болсаң не істер едің?
Dialogue: 0,0:03:25.03,0:03:28.70,Default,,0,0,0,,Неге осы ақымақ әңгімені тоқтатпайсың?
Dialogue: 0,0:03:28.91,0:03:30.16,Default,,0,0,0,,Өзіңізді алдамаңыз! Теме!
Dialogue: 0,0:03:30.16,0:03:31.12,Default,,0,0,0,,Өзіңізді алдамаңыз! Теме!
Dialogue: 0,0:03:30.16,0:03:31.12,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,0:03:31.12,0:03:31.25,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,0:03:31.25,0:03:31.62,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,0:03:31.25,0:03:31.62,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:31.62,0:03:32.33,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:32.46,0:03:33.29,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:33.83,0:03:36.13,Default,,0,0,0,,Бір-бірімізге осылай күмәндансақ та...
Dialogue: 0,0:03:36.25,0:03:38.76,Default,,0,0,0,,Мен бұл жерден кете алмаймын...
Dialogue: 0,0:03:38.88,0:03:40.22,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:40.47,0:03:42.51,Default,,0,0,0,,(Экхарт) Кторигалга басып кірген бейбітшілікке қарсы күштер—
Dialogue: 0,0:03:42.80,0:03:43.64,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:03:43.76,0:03:45.39,Default,,0,0,0,,Уф! Бұл...
Dialogue: 0,0:03:47.01,0:03:49.35,Default,,0,0,0,,Маған күмәндануға болады.
Dialogue: 0,0:03:49.81,0:03:52.10,Default,,0,0,0,,Мен де осында қамалып қалдым.
Dialogue: 0,0:03:52.23,0:03:54.10,Default,,0,0,0,,Құтқарушы
Dialogue: 0,0:03:54.23,0:03:55.23,Default,,0,0,0,,Суда шын мәнінде өз мүмкіндігін көрсететін техникалар бар!
Dialogue: 0,0:03:55.36,0:03:59.19,Default,,0,0,0,,Ах, Рицу-сенпай осында болса ғой.
Dialogue: 0,0:04:02.53,0:04:04.32,Default,,0,0,0,,Әй, Шого-сенпай
Dialogue: 0,0:04:04.45,0:04:07.66,Default,,0,0,0,,Директор мен Ария олардың қайда екенін білмейсіз бе?
Dialogue: 0,0:04:10.33,0:04:13.12,Default,,0,0,0,,Сізден бір нәрсе сұрасам болады ма?
Dialogue: 0,0:04:13.25,0:04:16.08,Default,,0,0,0,,Торн атты музыкант мұнарада пайда болған кезде...
Dialogue: 0,0:04:16.46,0:04:18.25,Default,,0,0,0,,Жаман адам...
Dialogue: 0,0:04:18.42,0:04:19.71,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:20.13,0:04:22.67,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:04:23.38,0:04:24.63,Default,,0,0,0,,Сіз мұны бұрын білетінсіз...
Dialogue: 0,0:04:25.43,0:04:27.35,Default,,0,0,0,,Сол адам туралы
Dialogue: 0,0:04:27.85,0:04:30.81,Default,,0,0,0,,Мүмкін емес пе? Шого сен...
Dialogue: 0,0:04:30.93,0:04:34.56,Default,,0,0,0,,Әй, бірдеңе айтшы, Шого-сенпай!
Dialogue: 0,0:04:34.69,0:04:36.60,Default,,0,0,0,,Мені кінәлама! (Котоно, Морита, Мифуэ) Ах...
Dialogue: 0,0:04:39.82,0:04:40.53,Default,,0,0,0,,Мм... не болды? Барлығы
Dialogue: 0,0:04:40.53,0:04:42.03,Default,,0,0,0,,Мм... не болды? Барлығы
Dialogue: 0,0:04:40.53,0:04:42.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:42.03,0:04:43.19,Default,,0,0,0,,Мм... не болды? Барлығы
Dialogue: 0,0:04:43.32,0:04:44.15,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:04:44.78,0:04:47.12,Default,,0,0,0,,А, бұл менмін.
Dialogue: 0,0:04:47.66,0:04:49.58,Default,,0,0,0,,Мари-чан? (Мари) Иә.
Dialogue: 0,0:04:49.70,0:04:52.25,Default,,0,0,0,,Сәлем! Біз тұзаққа түстік!
Dialogue: 0,0:04:52.37,0:04:53.79,Default,,0,0,0,,Мені бұл жерден кетіріңіз!
Dialogue: 0,0:04:53.91,0:04:55.04,Default,,0,0,0,,Не? Ішінде-
Dialogue: 0,0:04:55.16,0:04:57.13,Default,,0,0,0,,Құлыптаулы емес пе?
Dialogue: 0,0:04:57.25,0:04:58.46,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:04:58.84,0:05:01.42,Default,,0,0,0,,Ол мүлде қозғалмайды...
Dialogue: 0,0:05:02.21,0:05:03.84,Default,,0,0,0,,Бұл не болып жатыр?
Dialogue: 0,0:05:03.97,0:05:04.80,Default,,0,0,0,,Қияметсіз...
Dialogue: 0,0:05:04.92,0:05:07.89,Default,,0,0,0,,Мм... Рицу-сенпай, мен сенің қайда екеніңді білмеймін?
Dialogue: 0,0:05:08.01,0:05:11.26,Default,,0,0,0,,Не? Шикишима-кун, сен сонда емессің бе?
Dialogue: 0,0:05:11.39,0:05:13.77,Default,,0,0,0,,Әй, анау бейбақ...
Dialogue: 0,0:05:13.89,0:05:15.56,Default,,0,0,0,,Мен уайымдап тұрмын.
Dialogue: 0,0:05:15.69,0:05:17.19,Default,,0,0,0,,Өтінемін, Рицу, мені тауып бер!
Dialogue: 0,0:05:17.19,0:05:17.40,Default,,0,0,0,,Өтінемін, Рицу, мені тауып берші!
Dialogue: 0,0:05:17.19,0:05:17.40,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:05:17.40,0:05:17.52,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:05:17.52,0:05:18.60,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:05:17.52,0:05:18.60,Default,,0,0,0,,Ах! Ах...
Dialogue: 0,0:05:18.73,0:05:18.94,Default,,0,0,0,,(Маридің қашып бара жатқан дыбысы)
Dialogue: 0,0:05:18.94,0:05:21.32,Default,,0,0,0,,(Маридің қашып бара жатқан дыбысы)
Dialogue: 0,0:05:18.94,0:05:21.32,Default,,0,0,0,,Ах, Мари-чан, күте тұр!
Dialogue: 0,0:05:22.32,0:05:23.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:23.94,0:05:25.53,Default,,0,0,0,,Мен бардым...
Dialogue: 0,0:05:28.91,0:05:32.24,Default,,0,0,0,,Мари-сенпай қайтып келмейді~
Dialogue: 0,0:05:32.45,0:05:34.37,Default,,0,0,0,,Котаро-сенпай ойланбастан
Dialogue: 0,0:05:34.50,0:05:36.91,Default,,0,0,0,,Мен сізді менеджерді табуға жіберемін...
Dialogue: 0,0:05:37.04,0:05:38.54,Default,,0,0,0,,Қашудың жолы бар ма?
Dialogue: 0,0:05:38.67,0:05:40.92,Default,,0,0,0,,Бұл болуы мүмкін.
Dialogue: 0,0:05:41.04,0:05:43.21,Default,,0,0,0,,Оны өзіңізбен бірге алып келсеңіз, бәрі түсінікті болады.
Dialogue: 0,0:05:44.67,0:05:47.18,Default,,0,0,0,,Бір ай бұрын болған шайқаста...
Dialogue: 0,0:05:47.55,0:05:48.97,Default,,0,0,0,,Кейбір менеджер және μ
Dialogue: 0,0:05:49.09,0:05:52.10,Default,,0,0,0,,Сіз бір-біріңізді біраз уақыттан бері білетіндей сезінбейсіз бе?
Dialogue: 0,0:05:52.68,0:05:53.85,Default,,0,0,0,,Шынында да…
Dialogue: 0,0:05:53.97,0:05:56.85,Default,,0,0,0,,Менеджер бізді әу бастан алдап жүрді.
Dialogue: 0,0:05:59.10,0:06:01.02,Default,,0,0,0,,Мүмкін солай шығар...
Dialogue: 0,0:06:01.65,0:06:03.73,Default,,0,0,0,,Бұл менеджерге сене алмайтыныңызды білдіре ме?
Dialogue: 0,0:06:04.19,0:06:06.19,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:06:06.82,0:06:08.70,Default,,0,0,0,,Мұндағы адамдар туралы
Dialogue: 0,0:06:08.82,0:06:11.66,Default,,0,0,0,,Мен ешкімге сене алмаймын...
Dialogue: 0,0:06:12.28,0:06:13.62,Default,,0,0,0,,Өйткені, солай ма?
Dialogue: 0,0:06:14.04,0:06:15.66,Default,,0,0,0,,Біз бәріміз
Dialogue: 0,0:06:15.79,0:06:19.00,Default,,0,0,0,,Өйткені мен шынайы әлемде лас өмір сүрдім...
Dialogue: 0,0:06:19.62,0:06:23.84,Default,,0,0,0,,Ол жерден қашып, Мебиусқа келетін адам.
Dialogue: 0,0:06:24.63,0:06:26.84,Default,,0,0,0,,Сенбейсің бе?
Dialogue: 0,0:06:26.96,0:06:30.05,Default,,0,0,0,,Үйге қайту клубынан Мебиуспен дос болған адам...
Dialogue: 0,0:06:30.18,0:06:31.76,Default,,0,0,0,,Сенесің бе?
Dialogue: 0,0:06:31.89,0:06:32.80,Default,,0,0,0,,А...?
Dialogue: 0,0:06:32.93,0:06:34.51,Default,,0,0,0,,Соңында біз...
Dialogue: 0,0:06:34.64,0:06:37.35,Default,,0,0,0,,Сіз бұл жерден де қашып кеткіңіз келгендіктен, қыдырып жүрсіз.
Dialogue: 0,0:06:37.48,0:06:40.27,Default,,0,0,0,,Егер сіз бұлай десеңіз, сіз мүлдем түсініксіз боласыз.
Dialogue: 0,0:06:40.39,0:06:41.52,Default,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,0:06:41.65,0:06:44.57,Default,,0,0,0,,Бірақ бұл менің шынайы сезімім...
Dialogue: 0,0:06:44.73,0:06:47.03,Default,,0,0,0,,Шо... Шоғо-сенпай
Dialogue: 0,0:06:47.15,0:06:50.99,Default,,0,0,0,,Сіз де солай ойлайсыз ба?
Dialogue: 0,0:06:55.33,0:06:57.12,Default,,0,0,0,,Бәрібір айт!
Dialogue: 0,0:06:58.96,0:07:01.75,Default,,0,0,0,,Өткен күн бізге мәңгі ілеседі
Dialogue: 0,0:07:01.87,0:07:03.13,Default,,0,0,0,,Қанша қашсаң да...
Dialogue: 0,0:07:03.96,0:07:05.67,Default,,0,0,0,,Қайда жүгірсеңіз де...
Dialogue: 0,0:07:05.80,0:07:08.80,Default,,0,0,0,,Мен...
Dialogue: 0,0:07:08.92,0:07:11.43,Default,,0,0,0,,Сіз қашып құтыла алмайсыз! Тіпті Мобиус емес!
Dialogue: 0,0:07:11.68,0:07:12.51,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:07:13.39,0:07:17.01,Default,,0,0,0,,Ақырында, шындық та, Мобиус та ақымақ!
Dialogue: 0,0:07:17.14,0:07:20.73,Default,,0,0,0,,Мен енді ештеңеге сене алмаймын!
Dialogue: 0,0:07:20.89,0:07:22.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:22.85,0:07:23.69,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:23.81,0:07:25.73,Default,,0,0,0,,Кашиваха мен Сатаке дұрыс айтады.
Dialogue: 0,0:07:26.36,0:07:27.73,Default,,0,0,0,,Өйткені, бұл...
Dialogue: 0,0:07:27.86,0:07:30.70,Default,,0,0,0,,Бұл шын мәнінде азап шеккен адамдар үйіндісі...
Dialogue: 0,0:07:31.20,0:07:32.57,Default,,0,0,0,,μ ойлайды―
Dialogue: 0,0:07:32.70,0:07:34.66,Default,,0,0,0,,Бақыт деп аталатын жылы ваннада
Dialogue: 0,0:07:35.12,0:07:37.41,Default,,0,0,0,,Оларды тірі қалдырып жатыр...
Dialogue: 0,0:07:37.99,0:07:41.21,Default,,0,0,0,,Бірақ бұл да фантастика...
Dialogue: 0,0:07:42.75,0:07:45.38,Default,,0,0,0,,Жарайды, мұны істегіңіз келе ме?
Dialogue: 0,0:07:45.75,0:07:48.25,Default,,0,0,0,,Сенбеймін деп айтудан бұрын сеніңіз
Dialogue: 0,0:07:48.38,0:07:51.88,Default,,0,0,0,,Біз бір-бірімізді мүлде танымаймыз, солай ма?
Dialogue: 0,0:07:52.01,0:07:54.34,Default,,0,0,0,,Өзімді тағы да таныстырып өтейін.
Dialogue: 0,0:07:54.59,0:07:56.05,Default,,0,0,0,,Өзін-өзі таныстыру?
Dialogue: 0,0:07:56.30,0:07:59.18,Default,,0,0,0,,Иә, бәрің мұнда қалай келдіңдер?
Dialogue: 0,0:07:59.31,0:08:01.68,Default,,0,0,0,,Мені қатты қызықтырады.
Dialogue: 0,0:08:01.81,0:08:04.31,Default,,0,0,0,,Уақытты өлтіру үшін тамаша емес пе?
Dialogue: 0,0:08:04.90,0:08:06.06,Default,,0,0,0,,Я...
Dialogue: 0,0:08:06.56,0:08:08.90,Default,,0,0,0,,Егер қылмыскерді осылай танитын болсаңыз...
Dialogue: 0,0:08:09.28,0:08:11.94,Default,,0,0,0,,Енді кірісу керек пе, жоқ па...
Dialogue: 0,0:08:12.28,0:08:14.86,Default,,0,0,0,,Мұндағы әр адамның жүрегіндегі қараңғылыққа...
Dialogue: 0,0:08:18.70,0:08:21.79,Default,,0,0,0,,Хмм... қалай? Сенпай
Dialogue: 0,0:08:24.25,0:08:26.83,Default,,0,0,0,,Егер естігің келсе, мен айтамын.
Dialogue: 0,0:08:27.13,0:08:29.71,Default,,0,0,0,,Ең ауыр кісі өлтіру туралы айтып беріңізші...
Dialogue: 0,0:08:29.96,0:08:32.38,Default,,0,0,0,,Сіз мұны бұрын айттыңыз.
Dialogue: 0,0:08:32.51,0:08:34.18,Default,,0,0,0,,мүмкіндігінше тезірек сол бағытта тергеу жүргізуіміз керек деп ойлаймын
Dialogue: 0,0:08:34.55,0:08:38.22,Default,,0,0,0,,Мен ол әйелді білемін.
Dialogue: 0,0:08:38.60,0:08:41.22,Default,,0,0,0,,Шын аты - Казурин Саотоме
Dialogue: 0,0:08:41.77,0:08:43.94,Default,,0,0,0,,Орта мектепте сыныптас болдық...
Dialogue: 0,0:08:44.35,0:08:46.52,Default,,0,0,0,,Ол біртүрлі болды.
Dialogue: 0,0:08:46.65,0:08:51.44,Default,,0,0,0,,Ол мен күліп, сөйлесетін санаулы достарымның бірі еді...
Dialogue: 0,0:08:51.73,0:08:54.74,Default,,0,0,0,,Ол да, мен де сабақта қалқып жүрдік...
Dialogue: 0,0:08:54.86,0:08:56.57,Default,,0,0,0,,Жасыруға тырысайық...
Dialogue: 0,0:08:56.70,0:08:59.28,Default,,0,0,0,,Қалғандардың бәрі түкке тұрғысыз...
Dialogue: 0,0:08:59.41,0:09:01.87,Default,,0,0,0,,Бұл дүниенің өзі түкке тұрғысыз...
Dialogue: 0,0:09:02.54,0:09:05.21,Default,,0,0,0,,Екеуміз осындай нәрселер туралы сөйлесетінбіз...
Dialogue: 0,0:09:05.33,0:09:10.00,Default,,0,0,0,,Бірақ ол уақыт бәрінен де маңызды болды.
Dialogue: 0,0:09:10.55,0:09:11.88,Default,,0,0,0,,(Пошта қоңырау үні)
Dialogue: 0,0:09:12.21,0:09:14.76,Default,,0,0,0,,Бір күні маған электрондық хат келді.
Dialogue: 0,0:09:15.63,0:09:18.93,Default,,0,0,0,,Бірақ мен қорқамын... қорқамын...
Dialogue: 0,0:09:19.72,0:09:20.93,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:09:23.77,0:09:26.77,Default,,0,0,0,,Ол жалғыз өзін мұнарадан лақтырды...
Dialogue: 0,0:09:27.31,0:09:30.44,Default,,0,0,0,,Мен... жалғыз өлсін.
Dialogue: 0,0:09:30.69,0:09:32.78,Default,,0,0,0,,Сонымен, кісі өлтіру...
Dialogue: 0,0:09:32.90,0:09:35.15,Default,,0,0,0,,Шоға-сенпайдың кінәсі емес!
Dialogue: 0,0:09:35.49,0:09:36.57,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:09:37.03,0:09:40.74,Default,,0,0,0,,Айнымас достың тілегін тыңдамадым.
Dialogue: 0,0:09:40.87,0:09:43.66,Default,,0,0,0,,Ичиринге опасыздық жасағаным үшін...
Dialogue: 0,0:09:44.41,0:09:46.54,Default,,0,0,0,,Мен оны өлтіргендей болдым...
Dialogue: 0,0:09:46.54,0:09:47.54,Default,,0,0,0,,Мен оны өлтіргендей болдым...
Dialogue: 0,0:09:46.54,0:09:47.54,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:47.54,0:09:47.75,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:48.12,0:09:50.25,Default,,0,0,0,,Сонда неге бармадың деп ойлаймын!
Dialogue: 0,0:09:50.67,0:09:53.25,Default,,0,0,0,,Қатты өкінемін, Өкінемін...!
Dialogue: 0,0:09:53.80,0:09:57.30,Default,,0,0,0,,Сосын үйден де шыға алмай қалдым.
Dialogue: 0,0:09:57.80,0:10:00.30,Default,,0,0,0,,Одан кейін мен тұйыққа айналдым.
Dialogue: 0,0:10:00.43,0:10:03.01,Default,,0,0,0,,Мен үмітсіз қорқақпын!
Dialogue: 0,0:10:07.60,0:10:09.48,Default,,0,0,0,,Осындай кезде...
Dialogue: 0,0:10:09.77,0:10:12.65,Default,,0,0,0,,Интернеттен тапқан μ әніне ғашық болдым...
Dialogue: 0,0:10:12.77,0:10:15.19,Default,,0,0,0,,Ол кішкентай ғана еді
Dialogue: 0,0:10:15.82,0:10:18.07,Default,,0,0,0,,Ол менің жаралы жүрегімді емдеді.
Dialogue: 0,0:10:18.24,0:10:20.24,Default,,0,0,0,,Мебиусқа солай...
Dialogue: 0,0:10:20.36,0:10:21.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:21.82,0:10:23.74,Default,,0,0,0,,Мебиус дәл менің қалағаным.
Dialogue: 0,0:10:23.87,0:10:26.08,Default,,0,0,0,,Өшірілген ауыр естеліктер
Dialogue: 0,0:10:26.54,0:10:29.04,Default,,0,0,0,,Бірақ кенет өлді деген Ичирин пайда болады.
Dialogue: 0,0:10:29.17,0:10:30.79,Default,,0,0,0,,Бәрі есімде
Dialogue: 0,0:10:31.46,0:10:32.67,Default,,0,0,0,,Бұл бәрі емес...
Dialogue: 0,0:10:32.79,0:10:36.67,Default,,0,0,0,,Мені кінәлағандай қайта-қайта алдымда
Dialogue: 0,0:10:36.80,0:10:39.43,Default,,0,0,0,,Ол секіре береді...
Dialogue: 0,0:10:39.55,0:10:42.76,Default,,0,0,0,,Мен өзімді жынданып бара жатқандай сезінемін...
Dialogue: 0,0:10:43.01,0:10:45.10,Default,,0,0,0,,Ендеше шындыққа оралайық
Dialogue: 0,0:10:45.22,0:10:46.35,Default,,0,0,0,,О
Dialogue: 0,0:10:46.47,0:10:49.23,Default,,0,0,0,,Осылайша мен өзім сияқты адамдарды іздей бастадым...
Dialogue: 0,0:10:49.73,0:10:53.81,Default,,0,0,0,,Мен сендерді қабылдау рәсімінен таптым...
Dialogue: 0,0:10:54.44,0:10:57.78,Default,,0,0,0,,Менің ағам: «Мен ұзақ уақыт бойы жабық болдым», - деді.
Dialogue: 0,0:10:57.90,0:10:58.99,Default,,0,0,0,,Сіздің жасыңыз нешеде?
Dialogue: 0,0:11:00.07,0:11:01.70,Default,,0,0,0,,30...
Dialogue: 0,0:11:02.07,0:11:03.57,Default,,0,0,0,,Бұл меннен екі есе үлкен!
Dialogue: 0,0:11:03.70,0:11:04.58,Default,,0,0,0,,рет?
Dialogue: 0,0:11:04.70,0:11:06.04,Default,,0,0,0,,Сондықтан олар жауапкершілікті маған жүктеді.
Dialogue: 0,0:11:06.49,0:11:09.04,Default,,0,0,0,,Не? Котаро-сенпай: Кіші мектеп оқушысы?
Dialogue: 0,0:11:09.16,0:11:10.54,Default,,0,0,0,,Ішінде қайда орналасқан?
Dialogue: 0,0:11:10.67,0:11:11.75,Default,,0,0,0,,Сен мені мазақ етіп тұрсың ба?
Dialogue: 0,0:11:12.00,0:11:13.25,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:11:13.67,0:11:15.42,Default,,0,0,0,,Иә! Олай болса, келесі жолы...
Dialogue: 0,0:11:15.54,0:11:18.30,Default,,0,0,0,,Мен Котаро-сенпайға сөз берейін бе?
Dialogue: 0,0:11:18.42,0:11:19.59,Default,,0,0,0,,Жарайды, менікі...
Dialogue: 0,0:11:19.72,0:11:21.55,Default,,0,0,0,,Жарайды, олай айтпа.
Dialogue: 0,0:11:21.68,0:11:23.22,Default,,0,0,0,,Мен білгім келеді.
Dialogue: 0,0:11:23.34,0:11:26.31,Default,,0,0,0,,Неліктен Котаро-сенпай «әділдік одақтасы» болып табылады?
Dialogue: 0,0:11:26.43,0:11:28.14,Default,,0,0,0,,Сіз бұл туралы ерекшесіз бе?
Dialogue: 0,0:11:30.02,0:11:31.60,Default,,0,0,0,,Мен жай ғана...
Dialogue: 0,0:11:32.73,0:11:36.90,Default,,0,0,0,,Менің қариям құтқарушылар тобында өте жақсы болды...
Dialogue: 0,0:11:37.02,0:11:38.69,Default,,0,0,0,,Үлкен және күшті...
Dialogue: 0,0:11:39.24,0:11:41.03,Default,,0,0,0,,Бірақ мен...
Dialogue: 0,0:11:41.15,0:11:44.66,Default,,0,0,0,,Шындығында мен кішкентаймын, бастауыш сынып оқушысы сияқты...
Dialogue: 0,0:11:45.24,0:11:48.37,Default,,0,0,0,,Кейбір адамдар басқаларға қарағанда кеш өседі.
Dialogue: 0,0:11:48.62,0:11:50.12,Default,,0,0,0,,Мүмкін солай шығар.
Dialogue: 0,0:11:50.25,0:11:52.54,Default,,0,0,0,,Онда сіз құтқару тобы бола алмайсыз.
Dialogue: 0,0:11:53.96,0:11:57.13,Default,,0,0,0,,Бұл апат болды, әкем мен анам...
Dialogue: 0,0:11:57.63,0:11:59.00,Default,,0,0,0,,Ол өлді...
Dialogue: 0,0:11:59.17,0:12:00.34,Default,,0,0,0,,Е...
Dialogue: 0,0:12:00.46,0:12:05.09,Default,,0,0,0,,Сосын мені туыстарым алып кетті... Уф...
Dialogue: 0,0:12:05.34,0:12:09.14,Default,,0,0,0,,Менің денем мен ойым әлі әлсіз...
Dialogue: 0,0:12:10.10,0:12:14.27,Default,,0,0,0,,Мен әкем сияқты тез үлкен және күшті болғым келеді...
Dialogue: 0,0:12:15.02,0:12:16.81,Default,,0,0,0,,Содан кейін I
Dialogue: 0,0:12:16.94,0:12:20.36,Default,,0,0,0,,Мен жалғыз емес екенімді сезінемін.
Dialogue: 0,0:12:20.86,0:12:23.15,Default,,0,0,0,,Бірақ мен үлкен бола алмаймын.
Dialogue: 0,0:12:24.41,0:12:26.41,Default,,0,0,0,,Тек осындай нәрселер туралы ойлау
Dialogue: 0,0:12:26.53,0:12:28.49,Default,,0,0,0,,Мен қаланы аралап жүрдім...
Dialogue: 0,0:12:29.33,0:12:31.58,Default,,0,0,0,,Дүкен сөресінен μ музыкасын естимін...
Dialogue: 0,0:12:32.41,0:12:34.29,Default,,0,0,0,,А, бұл жақсы...
Dialogue: 0,0:12:34.42,0:12:37.79,Default,,0,0,0,,Бұл ән мені олар мені жақсы көретіндей сезінеді.
Dialogue: 0,0:12:38.29,0:12:40.13,Default,,0,0,0,,Мен мұны білмей тұрып, мұнда ...
Dialogue: 0,0:12:41.51,0:12:43.67,Default,,0,0,0,,Бұл жерде әрине қызық.
Dialogue: 0,0:12:43.80,0:12:44.97,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:12:45.38,0:12:48.51,Default,,0,0,0,,Мебиде мәңгілік...
Dialogue: 0,0:12:48.64,0:12:52.27,Default,,0,0,0,,Құтқарушылар өсе алмайды...
Dialogue: 0,0:12:52.39,0:12:55.19,Default,,0,0,0,,Сондықтан мен шындыққа оралғым келеді...
Dialogue: 0,0:12:55.56,0:12:58.69,Default,,0,0,0,,Бірақ қайтып барсам, бұрынғыдай...
Dialogue: 0,0:12:58.98,0:13:00.48,Default,,0,0,0,,Дене...
Dialogue: 0,0:13:00.61,0:13:03.24,Default,,0,0,0,,Бірақ мен басқаша сезінемін...
Dialogue: 0,0:13:03.78,0:13:07.53,Default,,0,0,0,,Енді мен ештеңеге қарамастан қолымнан келгеннің бәрін жасай алатындай сезінемін.
Dialogue: 0,0:13:07.74,0:13:11.24,Default,,0,0,0,,А... Мен бұл сезімді түсінемін.
Dialogue: 0,0:13:11.54,0:13:12.62,Default,,0,0,0,,О, содан кейін...
Dialogue: 0,0:13:12.62,0:13:13.87,Default,,0,0,0,,О, содан кейін...
Dialogue: 0,0:13:12.62,0:13:13.87,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:13:14.00,0:13:15.12,Default,,0,0,0,,Уа, ау!
Dialogue: 0,0:13:15.25,0:13:18.58,Default,,0,0,0,,Басқалардың айтқанын тыңдамай, өзің туралы айт!
Dialogue: 0,0:13:18.71,0:13:20.38,Default,,0,0,0,,Мен бе...
Dialogue: 0,0:13:20.50,0:13:22.76,Default,,0,0,0,,Бұл соншалықты үлкен мәміле емес.
Dialogue: 0,0:13:22.88,0:13:25.88,Default,,0,0,0,,Қарапайым ортада керемет талант жоқ...
Dialogue: 0,0:13:26.22,0:13:27.59,Default,,0,0,0,,Маған тыңдауға рұқсат етіңіз!
Dialogue: 0,0:13:27.72,0:13:28.76,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:13:29.09,0:13:32.97,Default,,0,0,0,,Менің ата-анам қарапайым адамдар, кез келген жерден таба аласыз...
Dialogue: 0,0:13:33.10,0:13:37.44,Default,,0,0,0,,Кішкентай кезімнен бұлай болғым келмеді.
Dialogue: 0,0:13:37.56,0:13:40.69,Default,,0,0,0,,Әдеттен тыс жұмыста жұмыс істегісі келетінін ойлау...
Dialogue: 0,0:13:40.81,0:13:44.36,Default,,0,0,0,,Егер сіз композитор болғыңыз келсе және «Мен музыкалық колледжге түсу емтиханын тапсырамын» десеңіз
Dialogue: 0,0:13:44.49,0:13:46.49,Default,,0,0,0,,Ата-анам маған жағдай жасады.
Dialogue: 0,0:13:46.95,0:13:49.32,Default,,0,0,0,,Мен ешқашан фортепианода жақсы ойнамаған болсам да.
Dialogue: 0,0:13:49.45,0:13:51.70,Default,,0,0,0,,Айтқаныңыз туралы шындап ойланып жүрсіз бе?
Dialogue: 0,0:13:52.91,0:13:54.16,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:13:54.29,0:13:58.12,Default,,0,0,0,,Ондай жағдайда бір ғана ән жеткілікті. Оны дұрыс құрастырып көріңіз.
Dialogue: 0,0:13:59.21,0:14:01.42,Default,,0,0,0,,Ронин
Dialogue: 0,0:14:01.54,0:14:03.50,Default,,0,0,0,,Мен мұны ақыры түсіндім
Dialogue: 0,0:14:03.63,0:14:06.97,Default,,0,0,0,,Мен тек салқын ыдысты қалаймын.
Dialogue: 0,0:14:07.09,0:14:09.51,Default,,0,0,0,,Іші бос...
Dialogue: 0,0:14:09.80,0:14:11.97,Default,,0,0,0,,Алайда мен Мобиусқа келген бойда...
Dialogue: 0,0:14:12.10,0:14:14.56,Default,,0,0,0,,Маған музыкант ретінде үлкен лауазым берілді...
Dialogue: 0,0:14:14.68,0:14:16.73,Default,,0,0,0,,Тамаша ән жасай алдым.
Dialogue: 0,0:14:16.85,0:14:19.90,Default,,0,0,0,,Оның үстіне бәрі сиқырланып тыңдайды...
Dialogue: 0,0:14:20.02,0:14:22.69,Default,,0,0,0,,Жоқ, бұл жақсы болды.
Dialogue: 0,0:14:22.82,0:14:26.28,Default,,0,0,0,,Бұл орындалған арман. Неліктен үйге келу клубына дейін бардыңыз?
Dialogue: 0,0:14:26.44,0:14:28.03,Default,,0,0,0,,Міне, солай емес пе?
Dialogue: 0,0:14:28.20,0:14:31.45,Default,,0,0,0,,Сол кезде өзіңізді қалпына келтіру үшін
Dialogue: 0,0:14:31.78,0:14:35.20,Default,,0,0,0,,Мен сіздің шындыққа оралуға тырысқаныңызды көргенде
Dialogue: 0,0:14:35.33,0:14:37.50,Default,,0,0,0,,Мен жаңа ғана байқадым.
Dialogue: 0,0:14:37.71,0:14:41.46,Default,,0,0,0,,Ақырында, мен Мобиус болсам да, мен босмын.
Dialogue: 0,0:14:41.63,0:14:42.84,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:42.96,0:14:44.50,Default,,0,0,0,,Сіз шынымен жеңілсіз!
Dialogue: 0,0:14:44.50,0:14:44.71,Default,,0,0,0,,Сіз шынымен жеңілсіз!
Dialogue: 0,0:14:44.50,0:14:44.71,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:44.71,0:14:44.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:44.84,0:14:45.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:44.84,0:14:45.96,Default,,0,0,0,,Сіз ешқашан шынайы өмірде де, Мебиуста да тозақты көрген емессіз!
Dialogue: 0,0:14:45.96,0:14:47.63,Default,,0,0,0,,Сіз ешқашан шынайы өмірде де, Мебиуста да тозақты көрген емессіз!
Dialogue: 0,0:14:47.76,0:14:48.80,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:48.92,0:14:52.60,Default,,0,0,0,,Адам қанша болса, тозақ да сонша.
Dialogue: 0,0:14:52.89,0:14:57.85,Default,,0,0,0,,Менің ағамның тозағы мен тозағым бөлек.
Dialogue: 0,0:14:59.14,0:15:00.90,Default,,0,0,0,,Енді ол тек кедергі келтіреді.
Dialogue: 0,0:15:01.02,0:15:02.56,Default,,0,0,0,,Ой... иә!
Dialogue: 0,0:15:02.73,0:15:03.86,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:15:04.23,0:15:06.28,Default,,0,0,0,,Келесі - Мифуэ-чан.
Dialogue: 0,0:15:06.40,0:15:11.07,Default,,0,0,0,,Егер есімде дұрыс болса, сіз μ-ден анаңызды ауыстыруды сұрадыңыз.
Dialogue: 0,0:15:11.20,0:15:12.28,Default,,0,0,0,,Бұл... (Морита) Бұл дұрыс емес!
Dialogue: 0,0:15:12.62,0:15:15.28,Default,,0,0,0,,Мифуэ-чанның айтқысы келгені бұл емес.
Dialogue: 0,0:15:15.41,0:15:17.66,Default,,0,0,0,,μ дұрыс түсінбедім... (Мифуэ) Жоқ.
Dialogue: 0,0:15:18.45,0:15:20.87,Default,,0,0,0,,Соңында анаңды ренжіткен адам
Dialogue: 0,0:15:21.00,0:15:22.88,Default,,0,0,0,,Шындықта немесе Мобиус
Dialogue: 0,0:15:23.00,0:15:24.96,Default,,0,0,0,,Басқа ешкім жоқ...
Dialogue: 0,0:15:25.09,0:15:26.09,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:15:26.21,0:15:27.80,Default,,0,0,0,,Эй, эй, бұл Мифуэ-чанның анасы ма?
Dialogue: 0,0:15:27.92,0:15:29.05,Default,,0,0,0,,Өте семіз
Dialogue: 0,0:15:29.38,0:15:33.14,Default,,0,0,0,,Менің өмірдегі анам өте семіз.
Dialogue: 0,0:15:33.26,0:15:36.10,Default,,0,0,0,,Мен анам сияқты семіремін бе деп қорқамын.
Dialogue: 0,0:15:36.22,0:15:37.31,Default,,0,0,0,,Мен қорқып кеттім...
Dialogue: 0,0:15:38.10,0:15:41.73,Default,,0,0,0,,Сонда күрішті мүлде жей алмадым.
Dialogue: 0,0:15:41.85,0:15:43.40,Default,,0,0,0,,Байқаған жағдайда ауруханаға жатқызу
Dialogue: 0,0:15:43.94,0:15:47.11,Default,,0,0,0,,Мебиусқа келгенде сау денені табасың...
Dialogue: 0,0:15:47.23,0:15:50.53,Default,,0,0,0,,Менің алдымда арық ана тұрды.
Dialogue: 0,0:15:51.03,0:15:52.82,Default,,0,0,0,,Бірақ бірінші ана...
Dialogue: 0,0:15:52.95,0:15:55.78,Default,,0,0,0,,Мен үшін тамақ ішпейтіндіктен арықсың...
Dialogue: 0,0:15:56.33,0:15:57.95,Default,,0,0,0,,Мен Бұл жолы...
Dialogue: 0,0:15:58.08,0:16:01.04,Default,,0,0,0,,Мен сенімен кешкі ас ішкім келеді деп ойладым...
Dialogue: 0,0:16:01.58,0:16:04.58,Default,,0,0,0,,μ бұл тілекті тез орындады.
Dialogue: 0,0:16:05.04,0:16:06.79,Default,,0,0,0,,Менің тілегім...
Dialogue: 0,0:16:06.92,0:16:08.17,Default,,0,0,0,,Жоқ
Dialogue: 0,0:16:08.30,0:16:11.22,Default,,0,0,0,,μ менің өзімшіл армандарымды орындады...
Dialogue: 0,0:16:11.34,0:16:14.51,Default,,0,0,0,,Бірақ Мобиустағы бірінші ана...
Dialogue: 0,0:16:14.64,0:16:16.76,Default,,0,0,0,,Мен… Мен…
Dialogue: 0,0:16:17.14,0:16:20.22,Default,,0,0,0,,Бірақ Мифуэ-чан, сен анаңнан дұрыстап кешірім сұрадың!
Dialogue: 0,0:16:20.35,0:16:22.18,Default,,0,0,0,,Бұл жеткілікті
Dialogue: 0,0:16:22.31,0:16:23.35,Default,,0,0,0,,Жоқ, әлі жоқ!
Dialogue: 0,0:16:23.35,0:16:24.19,Default,,0,0,0,,Жоқ, әлі жоқ!
Dialogue: 0,0:16:23.35,0:16:24.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:25.19,0:16:28.11,Default,,0,0,0,,Мен қинап жүрген нағыз анама
Dialogue: 0,0:16:28.23,0:16:31.19,Default,,0,0,0,,Мен әлі дұрыс кешірім сұраған жоқпын.
Dialogue: 0,0:16:31.32,0:16:34.45,Default,,0,0,0,,Сол себепті мен қайтқым келеді. Мен қайтуым керек!
Dialogue: 0,0:16:34.70,0:16:35.99,Default,,0,0,0,,Енді тоқтайық
Dialogue: 0,0:16:36.12,0:16:39.12,Default,,0,0,0,,Адамдардың бақытсыздықтары жайдан-жай еститін нәрсе емес!
Dialogue: 0,0:16:39.33,0:16:42.16,Default,,0,0,0,,Наруко-сенпай, сен не айтасың?
Dialogue: 0,0:16:42.29,0:16:45.62,Default,,0,0,0,,Сіз басқалардың заттарын иіскеп, интернетке жариялайсыз, солай ма?
Dialogue: 0,0:16:45.75,0:16:47.04,Default,,0,0,0,,Бұл...
Dialogue: 0,0:16:47.17,0:16:50.13,Default,,0,0,0,,Жарайды, келесі кезекте Наруко-сенпай.
Dialogue: 0,0:16:52.72,0:16:56.76,Default,,0,0,0,,Шынайы өмірде μ видеоларын бұзатынмын.
Dialogue: 0,0:16:56.89,0:16:59.60,Default,,0,0,0,,Содан кейін оны Мобиус басып алды, солай ма?
Dialogue: 0,0:17:00.01,0:17:01.93,Default,,0,0,0,,Интернет сізге ұнай ма?
Dialogue: 0,0:17:02.22,0:17:04.69,Default,,0,0,0,,Жоқ, мүмкін мен оны жек көрген шығармын...
Dialogue: 0,0:17:04.81,0:17:05.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:05.89,0:17:08.90,Default,,0,0,0,,Менің әкем газет тілшісі.
Dialogue: 0,0:17:09.31,0:17:13.11,Default,,0,0,0,,Мектептегілердің бәрі мені «жаппай қоқыс қыз» деп атайтын.
Dialogue: 0,0:17:13.24,0:17:14.86,Default,,0,0,0,,Мені мазақ етті...
Dialogue: 0,0:17:15.36,0:17:17.74,Default,,0,0,0,,Интернетте жағымсыз пікірлер жазылды.
Dialogue: 0,0:17:17.87,0:17:19.58,Default,,0,0,0,,Бұл өте ауыр болды.
Dialogue: 0,0:17:20.12,0:17:23.04,Default,,0,0,0,,Бірақ мен де жасырын түрде бастадым.
Dialogue: 0,0:17:26.58,0:17:28.50,Default,,0,0,0,,Интернет біртүрлі ғой, солай емес пе?
Dialogue: 0,0:17:28.63,0:17:30.54,Default,,0,0,0,,Мен мұны білмей тұрып, түбегейлі нәрселер жаза бастадым.
Dialogue: 0,0:17:30.67,0:17:32.92,Default,,0,0,0,,Бұл өте жақсы сезіледі
Dialogue: 0,0:17:33.05,0:17:36.51,Default,,0,0,0,,Сол кезде менің жазғаным ұнаған біреу келді.
Dialogue: 0,0:17:36.88,0:17:38.51,Default,,0,0,0,,Мен қазірдің өзінде бақыттымын
Dialogue: 0,0:17:39.09,0:17:41.51,Default,,0,0,0,,Ақыры мен кез келген нәрсе туралы сөйлесе алатын дос таптым.
Dialogue: 0,0:17:41.64,0:17:42.89,Default,,0,0,0,,Жоғары көтерілу
Dialogue: 0,0:17:43.22,0:17:44.89,Default,,0,0,0,,Бірақ оның шынайы тұлғасы қандай?
Dialogue: 0,0:17:45.52,0:17:49.06,Default,,0,0,0,,Ол мен туралы жаман сөздер жазған топтан еді, солай ма?
Dialogue: 0,0:17:49.19,0:17:51.57,Default,,0,0,0,,Хаха... күлкілі
Dialogue: 0,0:17:52.52,0:17:55.65,Default,,0,0,0,,Мебиуста мен өсек туралы көп жаздым.
Dialogue: 0,0:17:55.78,0:17:57.86,Default,,0,0,0,,Менің ойымша, сіз көңілді болдыңыз.
Dialogue: 0,0:17:58.07,0:18:01.33,Default,,0,0,0,,Неліктен үйге барғың келеді? сен
Dialogue: 0,0:18:01.78,0:18:04.24,Default,,0,0,0,,Котаро-сенпай дұрыс айтады.
Dialogue: 0,0:18:04.66,0:18:07.29,Default,,0,0,0,,Басқа адамдарды иіскеп, өсекшілерге беру.
Dialogue: 0,0:18:07.41,0:18:10.00,Default,,0,0,0,,Мен тек кіру санына алаңдадым.
Dialogue: 0,0:18:10.54,0:18:12.04,Default,,0,0,0,,Адамдар олай айтпайды...
Dialogue: 0,0:18:12.17,0:18:14.46,Default,,0,0,0,,Баға алмасам да жақсы деп ойлаймын...
Dialogue: 0,0:18:15.30,0:18:18.51,Default,,0,0,0,,Сондықтан өсекші болуды қойған дұрыс деп ойлаймын...
Dialogue: 0,0:18:18.88,0:18:20.72,Default,,0,0,0,,Күте тұрыңыз (Морита) Иә?
Dialogue: 0,0:18:20.84,0:18:22.93,Default,,0,0,0,,Оны жою керек емес пе?
Dialogue: 0,0:18:23.06,0:18:24.22,Default,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,0:18:24.35,0:18:26.77,Default,,0,0,0,,Менің де әдемі суреттерім қалды деп ойлаймын.
Dialogue: 0,0:18:27.23,0:18:29.02,Default,,0,0,0,,Жарайды, алдымен осыны оқимын, бітірген соң екіншісін де оқимыз ба?
Dialogue: 0,0:18:29.14,0:18:31.27,Default,,0,0,0,,...Демек, сен орта мектеп оқушысысың, солай ма?
Dialogue: 0,0:18:31.40,0:18:33.07,Default,,0,0,0,,Құрмет сөздерін қолданыңыз.
Dialogue: 0,0:18:33.19,0:18:34.02,Default,,0,0,0,,Ой!
Dialogue: 0,0:18:34.48,0:18:35.57,Default,,0,0,0,,Фу…
Dialogue: 0,0:18:36.24,0:18:37.82,Default,,0,0,0,,Ах, у... (P пернесі) Иә?
Dialogue: 0,0:18:37.95,0:18:40.24,Default,,0,0,0,,Келесі мен жақсы ма?
Dialogue: 0,0:18:40.36,0:18:41.45,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:18:41.74,0:18:43.70,Default,,0,0,0,,Мен... мен...
Dialogue: 0,0:18:43.83,0:18:47.16,Default,,0,0,0,,Мобиус пен шындықтың айырмашылығы жоқтың қасы.
Dialogue: 0,0:18:47.83,0:18:50.67,Default,,0,0,0,,Көптен бері достарым жоқ.
Dialogue: 0,0:18:50.79,0:18:52.71,Default,,0,0,0,,Мен әрқашан жалғыз болдым
Dialogue: 0,0:18:52.84,0:18:56.26,Default,,0,0,0,,Бірақ бір күні сен мені түсінесің...
Dialogue: 0,0:18:56.38,0:19:01.05,Default,,0,0,0,,Маған жанашыр досым болса екен...
Dialogue: 0,0:19:01.34,0:19:02.55,Default,,0,0,0,,Бірақ өте...
Dialogue: 0,0:19:02.68,0:19:05.01,Default,,0,0,0,,«Менімен кешкі ас ішкіңіз келе ме?» деп айта алмаймын...
Dialogue: 0,0:19:06.39,0:19:08.89,Default,,0,0,0,,Сонымен сіз және қуыршақ бала...
Dialogue: 0,0:19:09.31,0:19:13.65,Default,,0,0,0,,Комори-кун менің бірінші досым болды.
Dialogue: 0,0:19:14.19,0:19:17.73,Default,,0,0,0,,Сондықтан біз бірге өте қызық болдық.
Dialogue: 0,0:19:18.07,0:19:19.15,Default,,0,0,0,,Тіпті Патраш те мені осылай өліп қалсам жалғыз тастап кетпес еді.
Dialogue: 0,0:19:19.28,0:19:22.36,Default,,0,0,0,,Сол оқиғаға байланысты И
Dialogue: 0,0:19:22.49,0:19:23.99,Default,,0,0,0,,Қазір қайтсем де
Dialogue: 0,0:19:24.12,0:19:27.45,Default,,0,0,0,,Мен бір ғана қадам жасай алатындай сезінемін.
Dialogue: 0,0:19:28.33,0:19:30.91,Default,,0,0,0,,Сіз қадам жасай аласыз ба... Әрине
Dialogue: 0,0:19:31.04,0:19:32.58,Default,,0,0,0,,Ой! Бұрын...
Dialogue: 0,0:19:32.71,0:19:36.42,Default,,0,0,0,,«Бұл да өтірік», - дедіңіз.
Dialogue: 0,0:19:36.55,0:19:39.01,Default,,0,0,0,,IkeP айтты...
Dialogue: 0,0:19:39.13,0:19:42.89,Default,,0,0,0,,«Өтірік болса да, бұл оның әділдігі».
Dialogue: 0,0:19:43.09,0:19:45.10,Default,,0,0,0,,Айтпақшы, IkeP
Dialogue: 0,0:19:45.22,0:19:49.02,Default,,0,0,0,,Мені үнемі Изуру-сенпайдың жүзі мазалайтын.
Dialogue: 0,0:19:49.14,0:19:51.31,Default,,0,0,0,,Мұндай беттің мәні жоқ.
Dialogue: 0,0:19:51.44,0:19:53.65,Default,,0,0,0,,Бұл тек жағымсыз сезімдерді қосады.
Dialogue: 0,0:19:54.56,0:19:58.03,Default,,0,0,0,,Шындығында мені анам басқарады.
Dialogue: 0,0:19:58.15,0:20:01.61,Default,,0,0,0,,Өз еркімен әрекет етуге болмайды
Dialogue: 0,0:20:01.74,0:20:05.91,Default,,0,0,0,,Мен өз бетімше ештеңе істей алмайтын едім...
Dialogue: 0,0:20:06.99,0:20:08.74,Default,,0,0,0,,Бірақ тек бір рет...
Dialogue: 0,0:20:08.87,0:20:10.70,Default,,0,0,0,,(Шыны сынып жатқан дыбыс)
Dialogue: 0,0:20:14.46,0:20:17.29,Default,,0,0,0,,Өз еркіммен жасаған жалғыз әрекетім.
Dialogue: 0,0:20:19.34,0:20:23.76,Default,,0,0,0,,Менің бетімдегі тыртық бұл мен екенімді дәлелдеді.
Dialogue: 0,0:20:24.89,0:20:28.01,Default,,0,0,0,,Бірақ μ бұл жарақат деп ойлады.
Dialogue: 0,0:20:28.43,0:20:31.06,Default,,0,0,0,,Мен оны қанша қаласам, сонша қайтарамын.
Dialogue: 0,0:20:31.48,0:20:34.65,Default,,0,0,0,,Бірақ менде әлі де тыртық жоқ...
Dialogue: 0,0:20:34.77,0:20:36.44,Default,,0,0,0,,Мен тірімін деп айта алмаймын.
Dialogue: 0,0:20:39.19,0:20:41.78,Default,,0,0,0,,Сіздің сезіміңіз әр адамда әр түрлі болады.
Dialogue: 0,0:20:42.40,0:20:46.49,Default,,0,0,0,,Соңында біз бір-бірімізді түсіне алмаймыз.
Dialogue: 0,0:20:46.62,0:20:47.57,Default,,0,0,0,,Бірақ
Dialogue: 0,0:20:48.12,0:20:50.74,Default,,0,0,0,,Шындыққа қайта оралуға деген бірдей ұмтылыс
Dialogue: 0,0:20:50.87,0:20:52.41,Default,,0,0,0,,Егер сізде осы бір ғана ұпай болса
Dialogue: 0,0:20:52.54,0:20:56.92,Default,,0,0,0,,Бірге әрекет ету керек деп ойлаймын.
Dialogue: 0,0:20:57.21,0:20:58.67,Default,,0,0,0,,Мен көремін...
Dialogue: 0,0:20:58.79,0:21:00.59,Default,,0,0,0,,Ал, соңғысы Котоно Сенпай.
Dialogue: 0,0:21:00.59,0:21:01.84,Default,,0,0,0,,Ал, соңғысы - Котоно Сенпай.
Dialogue: 0,0:21:00.59,0:21:01.84,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:01.96,0:21:05.88,Default,,0,0,0,,Бұл күлкілі әңгіме, бірақ бәрі тыңдай ма?
Dialogue: 0,0:21:06.01,0:21:09.76,Default,,0,0,0,,Біреу мұны айтса, тыңдағың келеді...
Dialogue: 0,0:21:09.89,0:21:11.97,Default,,0,0,0,,Рицу-сенпайдың айтқанына сенімдімін...
Dialogue: 0,0:21:12.10,0:21:13.64,Default,,0,0,0,,Калигула эффектісі... Иә?
Dialogue: 0,0:21:13.81,0:21:14.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:14.94,0:21:16.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:17.65,0:21:18.94,Default,,0,0,0,,Мизугучи, сен керемет жұмыс жасадың!
Dialogue: 0,0:21:19.06,0:21:20.36,Default,,0,0,0,,Оны қалай аштыңыз?
Dialogue: 0,0:21:20.48,0:21:22.78,Default,,0,0,0,,Аузыңды жап (Мифуе) А?
Dialogue: 0,0:21:23.07,0:21:24.44,Default,,0,0,0,,Мен одан шаршадым
Dialogue: 0,0:21:24.57,0:21:27.70,Default,,0,0,0,,Бұл сізді жылататын ашық шайқас сияқты фарс...
Dialogue: 0,0:21:27.82,0:21:29.57,Default,,0,0,0,,Менің ішім пысып жатыр~
Dialogue: 0,0:21:32.83,0:21:34.29,Default,,0,0,0,,Кешірім сұрау керек адам мен болар едім. Сіз жақсысыз ба?
Dialogue: 0,0:21:37.75,0:21:39.71,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:42.09,0:21:44.34,Default,,0,0,0,,(Барлығы жөтеледі)
Dialogue: 0,0:21:44.46,0:21:46.01,Default,,0,0,0,,Мари-чан?
Dialogue: 0,0:21:46.43,0:21:47.84,Default,,0,0,0,,Өлме!
Dialogue: 0,0:21:52.18,0:21:53.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:54.81,0:21:55.81,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:56.39,0:22:01.40,Default,,0,0,0,,♪～
Dialogue: 0,0:23:21.81,0:23:26.82,Default,,0,0,0,,～♪
Dialogue: 0,0:23:36.91,0:23:39.37,Default,,0,0,0,,Бұл шынымен ауырады.
Dialogue: 0,0:23:40.87,0:23:46.87,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory