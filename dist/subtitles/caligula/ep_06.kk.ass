Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.37,0:00:05.50,Default,,0,0,0,,Жүр, оларға жол көрсет.
Dialogue: 0,0:00:05.63,0:00:07.46,Default,,0,0,0,,Әнші дауысыңмен
Dialogue: 0,0:00:07.59,0:00:09.42,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:00:09.84,0:00:10.88,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:11.38,0:00:14.76,Default,,0,0,0,,Бірақ Торн, маған бір нәрсеге уәде бер.
Dialogue: 0,0:00:15.39,0:00:17.93,Default,,0,0,0,,Мен бәріне қорқынышты ештеңе жасамаймын.
Dialogue: 0,0:00:18.14,0:00:19.14,Default,,0,0,0,,Фу…
Dialogue: 0,0:00:19.47,0:00:21.39,Default,,0,0,0,,Иә, әрине.
Dialogue: 0,0:00:21.56,0:00:22.98,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:00:25.65,0:00:30.65,Default,,0,0,0,,♪～
Dialogue: 0,0:00:37.16,0:00:42.54,Default,,0,0,0,,(μ ән айту дауысы)
Dialogue: 0,0:00:54.92,0:00:55.93,Default,,0,0,0,,Гвуу…
Dialogue: 0,0:01:05.23,0:01:07.56,Default,,0,0,0,,Жақсы да жоқ, кеттік!
Dialogue: 0,0:01:08.56,0:01:10.23,Default,,0,0,0,,Ұшып кет…
Dialogue: 0,0:01:10.36,0:01:11.52,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:11.65,0:01:12.90,Default,,0,0,0,,Кеттік (Сузуна) Ах!
Dialogue: 0,0:01:13.03,0:01:15.03,Default,,0,0,0,,Иә, иә... (IkeP) Тағдыр!
Dialogue: 0,0:01:15.53,0:01:17.24,Default,,0,0,0,,Мен сені осында кездестіретініме сене алар емеспін.
Dialogue: 0,0:01:17.53,0:01:20.20,Default,,0,0,0,,Нағыз бұзық Тағдыр!
Dialogue: 0,0:01:20.78,0:01:22.70,Default,,0,0,0,,Сәлем Минезава
Dialogue: 0,0:01:23.24,0:01:25.12,Default,,0,0,0,,Сіз кімсіз...
Dialogue: 0,0:01:25.46,0:01:26.83,Default,,0,0,0,,Фу…
Dialogue: 0,0:01:28.92,0:01:30.29,Default,,0,0,0,,Не...
Dialogue: 0,0:01:30.46,0:01:32.75,Default,,0,0,0,,Бұл не? бұл!
Dialogue: 0,0:01:35.55,0:01:36.84,Default,,0,0,0,,Анам…
Dialogue: 0,0:01:36.97,0:01:39.43,Default,,0,0,0,,Бүгін сізбен кездескеніме қуаныштымын...
Dialogue: 0,0:01:39.55,0:01:41.22,Default,,0,0,0,,Мифу…
Dialogue: 0,0:01:42.01,0:01:45.31,Default,,0,0,0,,Бүгін сені кездестіргеніме қуаныштымын, Мифу...
Dialogue: 0,0:01:45.43,0:01:45.81,Default,,0,0,0,,Бұл қауіпті көрінеді, кеттік!
Dialogue: 0,0:01:45.81,0:01:48.23,Default,,0,0,0,,Бұл қауіпті көрінеді, кеттік!
Dialogue: 0,0:01:45.81,0:01:48.23,Default,,0,0,0,,Бүгін сізбен кездескеніме қуаныштымын...
Dialogue: 0,0:01:48.35,0:01:49.44,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:01:48.35,0:01:49.44,Default,,0,0,0,,Суасты кемесі ме?
Dialogue: 0,0:01:53.27,0:01:55.61,Default,,0,0,0,,Сонда кездескенше... Анашым
Dialogue: 0,0:01:56.07,0:01:58.24,Default,,0,0,0,,Ал... онда...
Dialogue: 0,0:01:58.36,0:01:59.57,Default,,0,0,0,,Ал... онда...
Dialogue: 0,0:02:03.58,0:02:04.99,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:02:05.12,0:02:06.08,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:06.62,0:02:09.75,Default,,0,0,0,,Анашым... Кешіріңіз!
Dialogue: 0,0:02:10.58,0:02:11.75,Default,,0,0,0,,Уф... уф!
Dialogue: 0,0:02:11.88,0:02:13.88,Default,,0,0,0,,Хаха...
Dialogue: 0,0:02:21.80,0:02:22.85,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:02:22.97,0:02:23.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:24.14,0:02:24.97,Default,,0,0,0,,Әй!
Dialogue: 0,0:02:27.93,0:02:30.56,Default,,0,0,0,,Хаха...
Dialogue: 0,0:02:35.86,0:02:37.24,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:02:40.57,0:02:41.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:41.82,0:02:45.03,Default,,0,0,0,,Сәлем, Сенпай
Dialogue: 0,0:02:46.66,0:02:49.96,Default,,0,0,0,,Дайында, қызым!
Dialogue: 0,0:02:50.75,0:02:51.75,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:53.17,0:02:58.17,Default,,0,0,0,,♪～
Dialogue: 0,0:04:17.42,0:04:22.42,Default,,0,0,0,,～♪
Dialogue: 0,0:04:23.47,0:04:24.34,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:04:24.47,0:04:26.01,Default,,0,0,0,,Котоно!
Dialogue: 0,0:04:26.68,0:04:27.72,Default,,0,0,0,,Әй!
Dialogue: 0,0:04:28.81,0:04:29.93,Default,,0,0,0,,Сіз сондай тәкаппарсыз!
Dialogue: 0,0:04:30.06,0:04:31.06,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:31.47,0:04:33.48,Default,,0,0,0,,Иә! (Котоно) Ха...
Dialogue: 0,0:04:34.27,0:04:35.14,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:04:35.27,0:04:37.06,Default,,0,0,0,,Иә! (Котоно) Уф! Уф...
Dialogue: 0,0:04:40.78,0:04:41.61,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:04:47.24,0:04:48.57,Default,,0,0,0,,Ха...
Dialogue: 0,0:04:51.33,0:04:52.70,Default,,0,0,0,,Ол келді.
Dialogue: 0,0:04:52.83,0:04:54.79,Default,,0,0,0,,Қандай ұятсыз еліктеу...
Dialogue: 0,0:04:54.91,0:04:56.58,Default,,0,0,0,,Бұл тегін бүлдіреді.
Dialogue: 0,0:04:56.71,0:04:58.67,Default,,0,0,0,,Тосизо, үндеме
Dialogue: 0,0:04:58.79,0:05:00.00,Default,,0,0,0,,Иә
Dialogue: 0,0:05:01.84,0:05:04.38,Default,,0,0,0,,Егер сіз аквариумда жүзіп жүрсеңіз
Dialogue: 0,0:05:04.51,0:05:06.30,Default,,0,0,0,,Уайымдамайтын нәрсе...
Dialogue: 0,0:05:06.72,0:05:09.85,Default,,0,0,0,,Осындай кішкентай әлемде құрсау болып қалу
Dialogue: 0,0:05:09.97,0:05:11.26,Default,,0,0,0,,Сіз бақыттымын деп айта аласыз ба?
Dialogue: 0,0:05:11.72,0:05:12.72,Default,,0,0,0,,Фу…
Dialogue: 0,0:05:13.10,0:05:17.44,Default,,0,0,0,,Мына балықтар мен маржандардың бәрі өтірік...
Dialogue: 0,0:05:18.02,0:05:21.27,Default,,0,0,0,,Нағыз балықтар нағыз теңізде жүзгісі келеді
Dialogue: 0,0:05:21.44,0:05:23.61,Default,,0,0,0,,Иә! Сол теңіз-
Dialogue: 0,0:05:23.74,0:05:26.74,Default,,0,0,0,,Сіз лай басқан лас теңізде де айта аласыз ба?
Dialogue: 0,0:05:27.49,0:05:30.16,Default,,0,0,0,,μ жасаған осы әдемі әлемде
Dialogue: 0,0:05:30.28,0:05:32.58,Default,,0,0,0,,Ешқандай ауыртпалық пен азапты сезбестен
Dialogue: 0,0:05:32.70,0:05:34.58,Default,,0,0,0,,Өмір сүру дұрыс емес пе?
Dialogue: 0,0:05:34.70,0:05:37.46,Default,,0,0,0,,Мұны неге білмейсің?
Dialogue: 0,0:05:38.04,0:05:40.33,Default,,0,0,0,,Сен ақымақсың, солай ма?
Dialogue: 0,0:05:41.75,0:05:43.88,Default,,0,0,0,,Хаха...
Dialogue: 0,0:05:44.13,0:05:45.97,Default,,0,0,0,,Эй, не істеуіміз керек?
Dialogue: 0,0:05:44.13,0:05:45.97,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:05:45.97,0:05:46.09,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:05:46.09,0:05:47.84,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:05:46.09,0:05:47.84,Default,,0,0,0,,Аа, енді жауап жоқ.
Dialogue: 0,0:05:47.84,0:05:47.97,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:05:47.97,0:05:48.18,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:05:47.97,0:05:48.18,Default,,0,0,0,,Қазір музыканттармен кім бәсекелесе алады?
Dialogue: 0,0:05:48.18,0:05:49.68,Default,,0,0,0,,Қазір музыканттармен кім бәсекеге түсе алады?
Dialogue: 0,0:05:49.80,0:05:52.39,Default,,0,0,0,,Шоғо-сенпай жалғыз қалғанымен!
Dialogue: 0,0:05:52.64,0:05:54.85,Default,,0,0,0,,Ой, бұл қиын~
Dialogue: 0,0:05:56.73,0:05:58.39,Default,,0,0,0,,Көптен бері көрмедім~
Dialogue: 0,0:05:58.52,0:06:00.27,Default,,0,0,0,,Гунуну... Тағы да осында.
Dialogue: 0,0:06:00.40,0:06:01.31,Default,,0,0,0,,Қой!
Dialogue: 0,0:06:01.56,0:06:02.86,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:02.98,0:06:05.49,Default,,0,0,0,,Мені бұл атпен шақыруды доғар!
Dialogue: 0,0:06:05.61,0:06:06.74,Default,,0,0,0,,Яда жақсы!
Dialogue: 0,0:06:06.86,0:06:07.07,Default,,0,0,0,,Маған қоңырау шалғаныңызды қаламаймын.
Dialogue: 0,0:06:07.07,0:06:09.99,Default,,0,0,0,,Маған қоңырау шалғаныңызды қаламаймын.
Dialogue: 0,0:06:07.07,0:06:09.99,Default,,0,0,0,,Ол сүйкімді, бірақ ол Ниджоиннан!
Dialogue: 0,0:06:10.20,0:06:12.62,Default,,0,0,0,,Сондықтан мені олай атамау керек!
Dialogue: 0,0:06:12.78,0:06:15.12,Default,,0,0,0,,Жоқ! Бұл өткір (Мифуэ) Иә?
Dialogue: 0,0:06:15.24,0:06:18.92,Default,,0,0,0,,Мен әлгі тітіркендіргіш ауызды жауып тастаймын!
Dialogue: 0,0:06:19.21,0:06:21.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:21.92,0:06:23.00,Default,,0,0,0,,Мектепке қабылдау сыйы ретінде маған берілген тау велосипеді
Dialogue: 0,0:06:23.38,0:06:25.71,Default,,0,0,0,,Күткім келеді... бірақ күте алмаймын!
Dialogue: 0,0:06:25.84,0:06:27.05,Default,,0,0,0,,Бухахаха!
Dialogue: 0,0:06:27.17,0:06:29.05,Default,,0,0,0,,Сіз туралы дөрекілік...
Dialogue: 0,0:06:29.18,0:06:30.93,Default,,0,0,0,,Өсекшіге көтеруім керек пе?
Dialogue: 0,0:06:31.05,0:06:32.47,Default,,0,0,0,,Сіз қолжетімділікті арттырғыңыз келеді, солай ма?
Dialogue: 0,0:06:32.76,0:06:33.89,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:34.35,0:06:35.60,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:06:35.72,0:06:36.64,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:36.77,0:06:37.81,Default,,0,0,0,,Сонда сіз...
Dialogue: 0,0:06:37.93,0:06:39.64,Default,,0,0,0,,«Кешіріңіз» деп айта алдыңыз ба?
Dialogue: 0,0:06:39.77,0:06:40.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:41.27,0:06:44.11,Default,,0,0,0,,Бұл дүниенің алғашқы анасына...
Dialogue: 0,0:06:44.23,0:06:45.15,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:45.27,0:06:46.98,Default,,0,0,0,,Дұрыс түсіндірдің бе?
Dialogue: 0,0:06:47.11,0:06:49.95,Default,,0,0,0,,Неліктен семіз адамдарды жек көресің?
Dialogue: 0,0:06:50.07,0:06:52.78,Default,,0,0,0,,Сонымен... мен анама айттым...
Dialogue: 0,0:06:52.91,0:06:56.04,Default,,0,0,0,,Сіз кешірім сұрадыңыз, солай ма? Мен өзімді ақымақ сияқты сезінемін!
Dialogue: 0,0:06:56.20,0:06:57.75,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,0:06:58.20,0:07:00.75,Default,,0,0,0,,Бұл дүние керемет
Dialogue: 0,0:07:00.87,0:07:02.63,Default,,0,0,0,,Сіз кез келген нәрсені ала аласыз.
Dialogue: 0,0:07:02.75,0:07:05.55,Default,,0,0,0,,Ендеше, миыңызды шайып аламын деп уайымдамаңыз.
Dialogue: 0,0:07:05.80,0:07:08.71,Default,,0,0,0,,Қанша миымды шайқасам да, байқамаймын
Dialogue: 0,0:07:08.84,0:07:10.43,Default,,0,0,0,,Мүлдем!
Dialogue: 0,0:07:13.22,0:07:17.35,Default,,0,0,0,,Менің айтқанымды орындамасаң, сені балыққа жегіземін.
Dialogue: 0,0:07:17.77,0:07:19.89,Default,,0,0,0,,Ханым, сөздеріңіз тым көп.
Dialogue: 0,0:07:20.02,0:07:21.31,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:07:21.44,0:07:22.40,Default,,0,0,0,,Иә
Dialogue: 0,0:07:22.73,0:07:24.98,Default,,0,0,0,,Мен саған жол бермеймін!
Dialogue: 0,0:07:25.31,0:07:26.40,Default,,0,0,0,,A сыныбы Тодорокидің мұздату шабуылымен алға шықты, бірақ
Dialogue: 0,0:07:26.69,0:07:27.90,Default,,0,0,0,,Әй!
Dialogue: 0,0:07:28.73,0:07:29.57,Default,,0,0,0,,Әй!
Dialogue: 0,0:07:29.90,0:07:30.74,Default,,0,0,0,,Хамф!
Dialogue: 0,0:07:31.32,0:07:32.24,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:07:32.49,0:07:34.66,Default,,0,0,0,,Ария мен бірдеңе істеуім керек!
Dialogue: 0,0:07:34.78,0:07:36.33,Default,,0,0,0,,Маған да қару беріңіз!
Dialogue: 0,0:07:36.45,0:07:39.25,Default,,0,0,0,,Хмм, бұл оңай емес.
Dialogue: 0,0:07:39.54,0:07:41.71,Default,,0,0,0,,Котаро үшін бұл әлі мүмкін емес.
Dialogue: 0,0:07:41.91,0:07:45.54,Default,,0,0,0,,Қат! Мен ештеңе істей алмаймын!
Dialogue: 0,0:07:46.63,0:07:47.46,Default,,0,0,0,,Әй!
Dialogue: 0,0:07:48.25,0:07:49.42,Default,,0,0,0,,Ех!
Dialogue: 0,0:07:49.55,0:07:51.47,Default,,0,0,0,,Ах... Котаро, қаш.
Dialogue: 0,0:07:51.59,0:07:53.01,Default,,0,0,0,,Иә, бірақ мен...
Dialogue: 0,0:07:54.93,0:07:56.76,Default,,0,0,0,,Жарайды, қазір қаш.
Dialogue: 0,0:07:57.26,0:07:58.35,Default,,0,0,0,,Мен сенің қашып кетуіңе жол бермеймін!
Dialogue: 0,0:07:58.51,0:07:59.64,Default,,0,0,0,,Хмф! (Шого) Қарғыс атсын...
Dialogue: 0,0:07:59.77,0:08:01.27,Default,,0,0,0,,Хамф!
Dialogue: 0,0:08:01.39,0:08:04.02,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:04.15,0:08:06.02,Default,,0,0,0,,О… Сабыр сақта.
Dialogue: 0,0:08:06.15,0:08:08.94,Default,,0,0,0,,Амансың ба? аға
Dialogue: 0,0:08:09.28,0:08:13.53,Default,,0,0,0,,Бүгін мен барлық жақсы достарымнан айырылдым.
Dialogue: 0,0:08:14.16,0:08:17.87,Default,,0,0,0,,«Жақсы достар»? Бұл жалаң сөз.
Dialogue: 0,0:08:19.08,0:08:20.29,Default,,0,0,0,,Бұл сен-
Dialogue: 0,0:08:20.41,0:08:23.16,Default,,0,0,0,,Біз осы миниатюралық бақ тәрізді әлемде үйшік ойнап жүрміз бе?
Dialogue: 0,0:08:23.96,0:08:26.92,Default,,0,0,0,,Өмір бойы солай істе! Тек сендер емес жігіттер!
Dialogue: 0,0:08:27.04,0:08:28.63,Default,,0,0,0,,Бұл қорқынышты!
Dialogue: 0,0:08:28.75,0:08:31.30,Default,,0,0,0,,Мен біраз ренжіген шығармын.
Dialogue: 0,0:08:32.05,0:08:34.22,Default,,0,0,0,,Урааа! Ахахха!
Dialogue: 0,0:08:34.34,0:08:35.76,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:36.26,0:08:38.18,Default,,0,0,0,,Эй... Эй, Торн.
Dialogue: 0,0:08:38.30,0:08:41.93,Default,,0,0,0,,Барлығы ауырып тұрған сияқты, бірақ бәрі жақсы, солай ма?
Dialogue: 0,0:08:42.06,0:08:44.39,Default,,0,0,0,,Бұл олар үшін.
Dialogue: 0,0:08:44.77,0:08:46.94,Default,,0,0,0,,Маған дұрыс жол көрсетпесең
Dialogue: 0,0:08:47.06,0:08:50.19,Default,,0,0,0,,Одан да нашарлайды.
Dialogue: 0,0:08:51.19,0:08:53.11,Default,,0,0,0,,Иә... дұрыс...
Dialogue: 0,0:08:53.69,0:08:54.70,Default,,0,0,0,,Иә...
Dialogue: 0,0:08:55.03,0:08:56.20,Default,,0,0,0,,Фу…
Dialogue: 0,0:08:56.61,0:08:59.62,Default,,0,0,0,,♪～
Dialogue: 0,0:09:01.66,0:09:04.62,Default,,0,0,0,,Хаха...
Dialogue: 0,0:09:04.75,0:09:05.71,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:09:05.83,0:09:07.29,Default,,0,0,0,,Не? Иә...
Dialogue: 0,0:09:07.42,0:09:08.25,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:08.38,0:09:09.21,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:09:09.50,0:09:12.05,Default,,0,0,0,,Бұл ұят болды. Уа!
Dialogue: 0,0:09:13.09,0:09:14.09,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:14.22,0:09:16.47,Default,,0,0,0,,Мәселе мынада.
Dialogue: 0,0:09:16.80,0:09:20.47,Default,,0,0,0,,Төмендегілердің қайсысы мені қатты тітіркендіреді?
Dialogue: 0,0:09:20.89,0:09:21.81,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:09:21.93,0:09:24.52,Default,,0,0,0,,1 Өте керемет жігіт
Dialogue: 0,0:09:25.60,0:09:27.23,Default,,0,0,0,,2 Бұл керемет емес ...
Dialogue: 0,0:09:27.35,0:09:30.06,Default,,0,0,0,,Жақсы боламын деп еңбектенетін жігіт.
Dialogue: 0,0:09:30.31,0:09:32.73,Default,,0,0,0,,3 Салқын болудың құндылығы...
Dialogue: 0,0:09:32.86,0:09:34.90,Default,,0,0,0,,Түсінбегендер...
Dialogue: 0,0:09:35.03,0:09:36.36,Default,,0,0,0,,Иә деп жауап береді
Dialogue: 0,0:09:37.57,0:09:39.28,Default,,0,0,0,,Маған бәрібір...
Dialogue: 0,0:09:39.53,0:09:42.54,Default,,0,0,0,,Ха... бұл жауап емес.
Dialogue: 0,0:09:42.66,0:09:45.79,Default,,0,0,0,,Дұрыс жауап №3. Бұл сіз туралы.
Dialogue: 0,0:09:46.41,0:09:49.67,Default,,0,0,0,,Мен сізді біраз уақыттан бері уайымдап жүрмін.
Dialogue: 0,0:09:52.42,0:09:53.63,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:57.26,0:10:01.05,Default,,0,0,0,,Мен осында қалсам, бұрынғыдай әсем өмір сүре аламын!
Dialogue: 0,0:10:01.18,0:10:03.43,Default,,0,0,0,,Бұған араласпа! Қарғыс атқыр әйел!
Dialogue: 0,0:10:03.56,0:10:07.31,Default,,0,0,0,,Міне осылай өтірік айтып, өзіме қарсы қаштым.
Dialogue: 0,0:10:07.69,0:10:10.48,Default,,0,0,0,,Мен қазір өкінемін!
Dialogue: 0,0:10:11.15,0:10:12.73,Default,,0,0,0,,Котоно...
Dialogue: 0,0:10:13.02,0:10:13.65,Default,,0,0,0,,Тоқта! Тоқта!
Dialogue: 0,0:10:13.65,0:10:14.90,Default,,0,0,0,,Тоқта! Тоқта!
Dialogue: 0,0:10:13.65,0:10:14.90,Default,,0,0,0,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,0:10:14.90,0:10:15.57,Default,,0,0,0,,Тоқта! Тоқта!
Dialogue: 0,0:10:16.82,0:10:18.49,Default,,0,0,0,,Сіз танылғыңыз келеді, солай ма?
Dialogue: 0,0:10:18.61,0:10:20.74,Default,,0,0,0,,Сонымен... сізді таңдандырғыңыз келеді, солай ма?
Dialogue: 0,0:10:20.91,0:10:22.91,Default,,0,0,0,,Сен не білесің?
Dialogue: 0,0:10:23.08,0:10:23.37,Default,,0,0,0,,Мен!
Dialogue: 0,0:10:23.37,0:10:24.12,Default,,0,0,0,,Мен!
Dialogue: 0,0:10:23.37,0:10:24.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:24.12,0:10:24.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:24.24,0:10:24.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:24.24,0:10:24.62,Default,,0,0,0,,Сіз түсінесіз деп ойлаймын.
Dialogue: 0,0:10:24.62,0:10:24.74,Default,,0,0,0,,Сіз түсінесіз деп ойлаймын.
Dialogue: 0,0:10:24.74,0:10:26.00,Default,,0,0,0,,Сіз түсінесіз деп ойлаймын.
Dialogue: 0,0:10:24.74,0:10:26.00,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:26.00,0:10:26.50,Default,,0,0,0,,Сіз түсінбейсіз деп ойлаймын.
Dialogue: 0,0:10:27.33,0:10:30.12,Default,,0,0,0,,Мен өзімді қайта алғым келеді, менің сезімдерім
Dialogue: 0,0:10:30.50,0:10:32.25,Default,,0,0,0,,Сіз шынымен кімсіз?
Dialogue: 0,0:10:32.38,0:10:34.13,Default,,0,0,0,,Мен осындай салқын жүзге ие болу үшін қиындық көрдім.
Dialogue: 0,0:10:34.25,0:10:36.17,Default,,0,0,0,,Мен оны μ-ден алсам да
Dialogue: 0,0:10:36.51,0:10:38.59,Default,,0,0,0,,Қараңғы жер асты әлеміндей
Dialogue: 0,0:10:38.72,0:10:41.05,Default,,0,0,0,,Сол шындыққа қайта оралғыңыз келе ме?
Dialogue: 0,0:10:41.22,0:10:42.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:42.60,0:10:44.39,Default,,0,0,0,,Шынымен... (Изуру) А?
Dialogue: 0,0:10:44.93,0:10:46.77,Default,,0,0,0,,Бұл шынымен де солай ма?
Dialogue: 0,0:10:47.77,0:10:51.02,Default,,0,0,0,,Себебі мен Мебиусқа келдім
Dialogue: 0,0:10:51.15,0:10:52.44,Default,,0,0,0,,Кішкене ғана...
Dialogue: 0,0:10:52.94,0:10:55.48,Default,,0,0,0,,Мен шындықпен бетпе-бет келу керек сияқты болдым.
Dialogue: 0,0:10:55.61,0:10:56.78,Default,,0,0,0,,Чи…
Dialogue: 0,0:10:57.15,0:10:58.49,Default,,0,0,0,,(Кения) Бірақ білесің бе, біз оны Саторудың аурухана шығындарын жабуға көмектеседі деп ойладық➡
Dialogue: 0,0:10:58.94,0:11:00.61,Default,,0,0,0,,Міне, мен...
Dialogue: 0,0:11:01.16,0:11:02.62,Default,,0,0,0,,Мен өмір сүре алмаймын
Dialogue: 0,0:11:04.24,0:11:06.91,Default,,0,0,0,,Мен әркімнің сезімін сезіне аламын
Dialogue: 0,0:11:07.04,0:11:08.95,Default,,0,0,0,,Бұл қоқыс! (Котоно) Уау!
Dialogue: 0,0:11:09.12,0:11:10.29,Default,,0,0,0,,Уф! Кяах!
Dialogue: 0,0:11:10.41,0:11:11.50,Default,,0,0,0,,Ария!
Dialogue: 0,0:11:11.58,0:11:11.87,Default,,0,0,0,,～♪
Dialogue: 0,0:11:11.87,0:11:14.00,Default,,0,0,0,,～♪
Dialogue: 0,0:11:11.87,0:11:14.00,Default,,0,0,0,,Ха! Ария?
Dialogue: 0,0:11:14.00,0:11:14.59,Default,,0,0,0,,～♪
Dialogue: 0,0:11:15.29,0:11:16.46,Default,,0,0,0,,Хаха...
Dialogue: 0,0:11:16.59,0:11:17.96,Default,,0,0,0,,Мен орта мектепте оқып жүргенде бір сыныптасымның —
Dialogue: 0,0:11:18.59,0:11:21.05,Default,,0,0,0,,Сәлем Ария
Dialogue: 0,0:11:21.18,0:11:22.18,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:22.51,0:11:24.55,Default,,0,0,0,,Хмф, сен қалтырап тұрсың.
Dialogue: 0,0:11:24.68,0:11:27.14,Default,,0,0,0,,Қорқыныштысың, әлсіз.
Dialogue: 0,0:11:27.35,0:11:29.35,Default,,0,0,0,,Мен әлсіз емеспін.
Dialogue: 0,0:11:29.48,0:11:30.89,Default,,0,0,0,,Мен...
Dialogue: 0,0:11:31.14,0:11:32.35,Default,,0,0,0,,Мен...
Dialogue: 0,0:11:33.40,0:11:34.73,Default,,0,0,0,,Бір мүйізбен осындай күш.
Dialogue: 0,0:11:35.23,0:11:37.69,Default,,0,0,0,,Мен қандай дәрменсізмін...
Dialogue: 0,0:11:38.36,0:11:39.44,Default,,0,0,0,,Мен...
Dialogue: 0,0:11:39.57,0:11:40.69,Default,,0,0,0,,Мен...
Dialogue: 0,0:11:41.45,0:11:42.78,Default,,0,0,0,,Шын мәнінде...
Dialogue: 0,0:11:43.24,0:11:44.32,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:44.99,0:11:47.45,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:47.58,0:11:49.29,Default,,0,0,0,,Иә! Котаро?
Dialogue: 0,0:11:50.29,0:11:53.62,Default,,0,0,0,,Уф уф...
Dialogue: 0,0:11:53.75,0:11:57.13,Default,,0,0,0,,Келді, мінекей, бауырым.
Dialogue: 0,0:11:57.25,0:11:59.05,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:59.17,0:12:00.38,Default,,0,0,0,,Ария…
Dialogue: 0,0:12:00.51,0:12:02.01,Default,,0,0,0,,Я...
Dialogue: 0,0:12:02.76,0:12:03.80,Default,,0,0,0,,Маған күш беріңіз!
Dialogue: 0,0:12:04.22,0:12:06.14,Default,,0,0,0,,Иә! Ихи!
Dialogue: 0,0:12:08.81,0:12:11.81,Default,,0,0,0,,Эй, СЕН мені естисің, солай ма?
Dialogue: 0,0:12:11.98,0:12:13.98,Default,,0,0,0,,Барлығыңыз, маған еріңіздер!
Dialogue: 0,0:12:14.31,0:12:16.11,Default,,0,0,0,,ＯＫ～？
Dialogue: 0,0:12:17.11,0:12:18.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:18.73,0:12:21.11,Default,,0,0,0,,Хаха...
Dialogue: 0,0:12:21.82,0:12:24.86,Default,,0,0,0,,Сіз шынымен өкінесіз, солай ма?
Dialogue: 0,0:12:24.99,0:12:26.82,Default,,0,0,0,,Мен дұрыс таппадым...
Dialogue: 0,0:12:27.87,0:12:31.04,Default,,0,0,0,,Мен ешкімге шындықты айта алмаймын...
Dialogue: 0,0:12:31.83,0:12:35.37,Default,,0,0,0,,Сіз өміріңізді бәрін өзіңізге сақтап өмір сүрдіңіз...
Dialogue: 0,0:12:36.33,0:12:38.50,Default,,0,0,0,,Бұл ауыр болды...
Dialogue: 0,0:12:38.63,0:12:40.34,Default,,0,0,0,,Бұл қиын болды...
Dialogue: 0,0:12:41.80,0:12:45.47,Default,,0,0,0,,Келіңіздер, терең ойларыңызды шығарыңыз
Dialogue: 0,0:12:45.89,0:12:47.39,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:48.14,0:12:49.39,Default,,0,0,0,,Зеницу, мені ойлама.
Dialogue: 0,0:12:49.85,0:12:51.22,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:51.81,0:12:52.89,Default,,0,0,0,,Жақсы істедің, Иносукэ!
Dialogue: 0,0:12:53.31,0:12:55.02,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:12:55.52,0:12:57.40,Default,,0,0,0,,Ууууах!
Dialogue: 0,0:12:57.90,0:12:59.48,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:13:00.65,0:13:02.11,Default,,0,0,0,,Толып жатыр...
Dialogue: 0,0:13:02.23,0:13:03.82,Default,,0,0,0,,Толып жатыр...
Dialogue: 0,0:13:03.94,0:13:06.20,Default,,0,0,0,,Әр адамның жүрегінде бір қараңғылық бар!
Dialogue: 0,0:13:06.32,0:13:07.45,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:07.74,0:13:08.57,Default,,0,0,0,,А…?
Dialogue: 0,0:13:08.91,0:13:11.04,Default,,0,0,0,,СІЗ де мұны сезінесіз!
Dialogue: 0,0:13:11.29,0:13:14.00,Default,,0,0,0,,Барлық сезімдеріңізді сыртқа шығарыңыз!
Dialogue: 0,0:13:14.71,0:13:16.71,Default,,0,0,0,,Ауырсынатын немесе ауыртатын заттар
Dialogue: 0,0:13:17.17,0:13:21.00,Default,,0,0,0,,Енді мен мұның бәрін билікке айналдырамын!
Dialogue: 0,0:13:22.71,0:13:23.71,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:13:23.88,0:13:25.38,Default,,0,0,0,,Жоғары...
Dialogue: 0,0:13:25.59,0:13:26.93,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:25.59,0:13:26.93,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:13:27.05,0:13:29.09,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:29.35,0:13:29.76,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:13:29.76,0:13:30.64,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:13:29.76,0:13:30.64,Default,,0,0,0,,Гуаааааааааааааааааааааааааааааааааааааааааааа...
Dialogue: 0,0:13:30.64,0:13:32.01,Default,,0,0,0,,Гууууууууууу...
Dialogue: 0,0:13:32.14,0:13:33.52,Default,,0,0,0,,Ақымақ! Хе-хе-хе! ➡
Dialogue: 0,0:13:33.77,0:13:34.31,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:13:34.31,0:13:34.98,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:13:34.31,0:13:34.98,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:34.98,0:13:36.19,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:36.31,0:13:36.48,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:13:36.48,0:13:37.52,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:13:36.48,0:13:37.52,Default,,0,0,0,,Кууууууууу!
Dialogue: 0,0:13:37.52,0:13:38.19,Default,,0,0,0,,Кууууууу!
Dialogue: 0,0:13:38.65,0:13:40.90,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:13:41.02,0:13:42.15,Default,,0,0,0,,Хокс та керемет болды.
Dialogue: 0,0:13:45.99,0:13:48.61,Default,,0,0,0,,Мен бұны ешқашан күтпеген едім...
Dialogue: 0,0:13:49.03,0:13:52.49,Default,,0,0,0,,Иә! Бұл СІЗДІҢ жүрегіңіздің пішіні!
Dialogue: 0,0:13:52.87,0:13:55.20,Default,,0,0,0,,Бұл тек СІЗ үшін ғана күш!
Dialogue: 0,0:13:55.79,0:13:58.62,Default,,0,0,0,,Менің өз күшім...
Dialogue: 0,0:13:59.00,0:14:00.58,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:14:01.92,0:14:02.92,Default,,0,0,0,,Фу…
Dialogue: 0,0:14:03.75,0:14:04.96,Default,,0,0,0,,Хехе...
Dialogue: 0,0:14:06.55,0:14:07.88,Default,,0,0,0,,Ария да...
Dialogue: 0,0:14:08.01,0:14:10.43,Default,,0,0,0,,Барлығы да Неге...
Dialogue: 0,0:14:10.89,0:14:12.10,Default,,0,0,0,,Неге...
Dialogue: 0,0:14:12.22,0:14:13.35,Default,,0,0,0,,Неге...
Dialogue: 0,0:14:13.47,0:14:16.48,Default,,0,0,0,,Неге түсінбейсің?
Dialogue: 0,0:14:17.77,0:14:21.02,Default,,0,0,0,,Бұл... катарсис эффектісі
Dialogue: 0,0:14:21.19,0:14:23.61,Default,,0,0,0,,Хаха... Енді мен де күресе аламын!
Dialogue: 0,0:14:25.32,0:14:26.44,Default,,0,0,0,,Гү!
Dialogue: 0,0:14:26.86,0:14:28.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:28.99,0:14:31.70,Default,,0,0,0,,А, бұл қазірдің өзінде тітіркендіргіш.
Dialogue: 0,0:14:31.91,0:14:33.03,Default,,0,0,0,,Рас
Dialogue: 0,0:14:33.16,0:14:35.87,Default,,0,0,0,,Айтқаныңды үнсіз тыңдасам ғой.
Dialogue: 0,0:14:36.00,0:14:37.16,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:14:37.29,0:14:39.67,Default,,0,0,0,,Қызық болып барады~
Dialogue: 0,0:14:39.79,0:14:41.17,Default,,0,0,0,,Үш минут.
Dialogue: 0,0:14:41.29,0:14:45.00,Default,,0,0,0,,Жоқ, балалар бір минутта жұмаққа барасыңдар!
Dialogue: 0,0:14:45.34,0:14:46.67,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:14:48.09,0:14:49.47,Default,,0,0,0,,Зеницу, мені ойлама.
Dialogue: 0,0:14:49.72,0:14:50.97,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:14:51.43,0:14:53.55,Default,,0,0,0,,Мен олардың бәрін тегістеймін!
Dialogue: 0,0:14:53.68,0:14:55.35,Default,,0,0,0,,Ей, арсыз брат!
Dialogue: 0,0:14:56.02,0:14:56.85,Default,,0,0,0,,Гррр…
Dialogue: 0,0:14:57.06,0:14:58.56,Default,,0,0,0,,Сен сондай ақылсызсың!
Dialogue: 0,0:14:59.06,0:15:01.52,Default,,0,0,0,,Ораораораора...!
Dialogue: 0,0:15:02.86,0:15:03.98,Default,,0,0,0,,Әй!
Dialogue: 0,0:15:04.40,0:15:06.07,Default,,0,0,0,,Кутчичи…
Dialogue: 0,0:15:06.32,0:15:07.15,Default,,0,0,0,,Қарғыс атсын... (Изуру) Хмф!
Dialogue: 0,0:15:07.94,0:15:08.78,Default,,0,0,0,,(Масато) Денең болмауы біраз қиын ғой, иә?
Dialogue: 0,0:15:08.90,0:15:10.28,Default,,0,0,0,,Ахх!
Dialogue: 0,0:15:10.61,0:15:12.03,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:15:12.66,0:15:15.16,Default,,0,0,0,,Мұндай жалпақ белді не істейсің?
Dialogue: 0,0:15:15.28,0:15:16.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:16.45,0:15:18.95,Default,,0,0,0,,Сізде олқылықтар көп емес пе?
Dialogue: 0,0:15:19.12,0:15:20.46,Default,,0,0,0,,Адамды басынан-ақ жаман деп есептеу дұрыс емес деп ойлаймын.
Dialogue: 0,0:15:21.42,0:15:22.42,Default,,0,0,0,,Аһ!
Dialogue: 0,0:15:22.54,0:15:24.34,Default,,0,0,0,,Уау! Хаха!
Dialogue: 0,0:15:24.54,0:15:26.38,Default,,0,0,0,,Ауылдың қарапайым адамдары көбейіп кеткен сияқты.
Dialogue: 0,0:15:27.05,0:15:30.84,Default,,0,0,0,,Ақымақтарда билік болған кезде, ол басқаруға болмайды!
Dialogue: 0,0:15:30.97,0:15:32.64,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:34.30,0:15:35.51,Default,,0,0,0,,А…?
Dialogue: 0,0:15:36.72,0:15:39.48,Default,,0,0,0,,Мен де күресе аламын!
Dialogue: 0,0:15:40.27,0:15:43.40,Default,,0,0,0,,Сонда ұл баладан кейін қыз бала?
Dialogue: 0,0:15:43.52,0:15:44.94,Default,,0,0,0,,Маған бәрібір... Ах.
Dialogue: 0,0:15:46.48,0:15:47.78,Default,,0,0,0,,Мен қыңырмын.
Dialogue: 0,0:15:48.40,0:15:49.78,Default,,0,0,0,,Бірге серуенейік!
Dialogue: 0,0:15:49.90,0:15:50.74,Default,,0,0,0,,Әй!
Dialogue: 0,0:15:50.86,0:15:52.91,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:15:53.03,0:15:54.03,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:55.12,0:15:56.95,Default,,0,0,0,,Айтыңызшы
Dialogue: 0,0:15:57.08,0:15:59.91,Default,,0,0,0,,Неліктен шындыққа қайта оралғыңыз келеді?
Dialogue: 0,0:16:00.45,0:16:02.08,Default,,0,0,0,,Бұл...
Dialogue: 0,0:16:02.54,0:16:04.63,Default,,0,0,0,,Өйткені мен кісі өлтірушімін!
Dialogue: 0,0:16:08.38,0:16:09.34,Default,,0,0,0,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,0:16:09.71,0:16:12.05,Default,,0,0,0,,Бля, сендерді алаяқтар!
Dialogue: 0,0:16:13.34,0:16:14.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:16.26,0:16:17.47,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:18.89,0:16:20.35,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:16:28.61,0:16:29.82,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:16:29.94,0:16:31.78,Default,,0,0,0,,Неге... Иә?
Dialogue: 0,0:16:33.57,0:16:34.74,Default,,0,0,0,,Неге...
Dialogue: 0,0:16:34.86,0:16:36.82,Default,,0,0,0,,Қатты...
Dialogue: 0,0:16:38.03,0:16:40.49,Default,,0,0,0,,Оларды сонша қозғайтын не?
Dialogue: 0,0:16:41.66,0:16:43.58,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:16:43.71,0:16:47.67,Default,,0,0,0,,Бұл әркім қайта алған шындық туралы естеліктер.
Dialogue: 0,0:16:47.79,0:16:50.67,Default,,0,0,0,,Маған жетіспейтіндіктен бе...
Dialogue: 0,0:16:51.05,0:16:53.05,Default,,0,0,0,,Немесе басқа...
Dialogue: 0,0:16:53.42,0:16:54.68,Default,,0,0,0,,Заң…
Dialogue: 0,0:16:54.80,0:16:57.09,Default,,0,0,0,,Менің де басымнан өту керек еді.
Dialogue: 0,0:16:58.22,0:17:01.68,Default,,0,0,0,,Бұл өте ауыр болуы мүмкін.
Dialogue: 0,0:17:01.81,0:17:04.31,Default,,0,0,0,,Бұл өте ауыр, мен онымен тікелей бетпе-бет келгім келмейді...
Dialogue: 0,0:17:04.44,0:17:06.02,Default,,0,0,0,,Бірақ мен сөзсіз...
Dialogue: 0,0:17:06.98,0:17:09.44,Default,,0,0,0,,Рицу Шикишима бар әлем
Dialogue: 0,0:17:10.15,0:17:11.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:12.40,0:17:15.70,Default,,0,0,0,,Мен кіммін...
Dialogue: 0,0:17:17.61,0:17:18.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:19.91,0:17:24.91,Default,,0,0,0,,(μ-ның ән айту дауысы)
Dialogue: 0,0:17:32.00,0:17:33.71,Default,,0,0,0,,Ах! μ!
Dialogue: 0,0:17:36.80,0:17:40.14,Default,,0,0,0,,♪～
Dialogue: 0,0:17:40.26,0:17:41.10,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:17:41.56,0:17:43.31,Default,,0,0,0,,Неге бұлай істеп жатырсың?
Dialogue: 0,0:17:43.64,0:17:46.27,Default,,0,0,0,,Бұл дүниеде не болды?
Dialogue: 0,0:17:46.56,0:17:48.65,Default,,0,0,0,,Сондай-ақ барлық музыканттарға.
Dialogue: 0,0:17:48.77,0:17:51.27,Default,,0,0,0,,«Мен сенен қорқынышты ештеңе жасамауыңды өтіндім»!
Dialogue: 0,0:17:51.69,0:17:55.86,Default,,0,0,0,,Ешкім... мені ешкім тыңдамайды!
Dialogue: 0,0:17:56.07,0:17:59.62,Default,,0,0,0,,Сәлем μ! Мен сөйлескім келетін нәрсе бар.
Dialogue: 0,0:17:59.74,0:18:01.95,Default,,0,0,0,,Тыңдаңыз! (μ) Бұл шулы!
Dialogue: 0,0:18:02.08,0:18:03.45,Default,,0,0,0,,Шулы Шулы!
Dialogue: 0,0:18:03.74,0:18:06.62,Default,,0,0,0,,Шулы, шулы, шулы, шулы...!
Dialogue: 0,0:18:07.08,0:18:10.50,Default,,0,0,0,,Әркімнің ойы, әркімнің бақыты
Dialogue: 0,0:18:10.63,0:18:13.55,Default,,0,0,0,,Мен мұның бәрін орындай аламын!
Dialogue: 0,0:18:13.67,0:18:14.67,Default,,0,0,0,,Сәлем μ!
Dialogue: 0,0:18:14.80,0:18:19.51,Default,,0,0,0,,(μ-ның ән айту дауысы)
Dialogue: 0,0:18:33.77,0:18:37.36,Default,,0,0,0,,Эй, эй! Не болып жатыр!
Dialogue: 0,0:18:37.69,0:18:40.03,Default,,0,0,0,,Эй, бұл аздап қауіпті емес пе?
Dialogue: 0,0:18:40.16,0:18:41.99,Default,,0,0,0,,μ-ге не болды?
Dialogue: 0,0:18:42.32,0:18:45.24,Default,,0,0,0,,Балалар, бұл жерден кетіңдер!
Dialogue: 0,0:18:48.29,0:18:52.04,Default,,0,0,0,,Сәлем! Неге сонша шатасып кеттіңіз? Каги П, асығыңыз!
Dialogue: 0,0:18:55.96,0:18:58.84,Default,,0,0,0,,Ария μ не болып жатыр?
Dialogue: 0,0:18:59.01,0:19:01.39,Default,,0,0,0,,Мен өз күшімді басқара алмаймын...
Dialogue: 0,0:19:01.51,0:19:02.55,Default,,0,0,0,,Бақылау?
Dialogue: 0,0:19:03.01,0:19:05.81,Default,,0,0,0,,Осы уақытқа дейін мен оны өз денемнің ішінде ұстадым.
Dialogue: 0,0:19:05.93,0:19:06.85,Default,,0,0,0,,Барлығы қара-
Dialogue: 0,0:19:06.97,0:19:09.18,Default,,0,0,0,,Лайланған сезімдерім толып жатыр
Dialogue: 0,0:19:09.52,0:19:11.85,Default,,0,0,0,,Азап, қайғы, ашу...
Dialogue: 0,0:19:11.98,0:19:14.82,Default,,0,0,0,,Сол жағымсыз эмоциялар бақылаудан шығып барады.
Dialogue: 0,0:19:14.94,0:19:17.86,Default,,0,0,0,,μ! Жоқ, мықты бол!
Dialogue: 0,0:19:17.99,0:19:19.82,Default,,0,0,0,,Өзіңді жоғалтпа!
Dialogue: 0,0:19:19.95,0:19:23.24,Default,,0,0,0,,Бұлай жалғаса берсе, μ енді μ болмайды!
Dialogue: 0,0:19:24.03,0:19:26.58,Default,,0,0,0,,(μ-ның ән айту дауысы)
Dialogue: 0,0:19:33.88,0:19:35.79,Default,,0,0,0,,μ！
Dialogue: 0,0:19:52.52,0:19:53.73,Default,,0,0,0,,μ…
Dialogue: 0,0:19:53.85,0:19:55.81,Default,,0,0,0,,Мен шештім...
Dialogue: 0,0:19:56.02,0:19:57.77,Default,,0,0,0,,Мен не істеуім керек!
Dialogue: 0,0:19:58.07,0:20:00.24,Default,,0,0,0,,Ууууах!
Dialogue: 0,0:20:02.28,0:20:03.20,Default,,0,0,0,,Заң!
Dialogue: 0,0:20:03.45,0:20:05.87,Default,,0,0,0,,Әлгі жігіт Арияның көмегінсіз...
Dialogue: 0,0:20:05.99,0:20:07.74,Default,,0,0,0,,Катартикалық әсер!
Dialogue: 0,0:20:08.95,0:20:12.37,Default,,0,0,0,,μ! Мен ненің дұрыс екенін де білмеймін!
Dialogue: 0,0:20:12.71,0:20:15.88,Default,,0,0,0,,Бірақ бұл дүние дұрыс емес!
Dialogue: 0,0:20:19.13,0:20:20.88,Default,,0,0,0,,Сонымен μ…
Dialogue: 0,0:20:21.22,0:20:23.63,Default,,0,0,0,,Мен Мебиусқа қарсы тұрамын!
Dialogue: 0,0:20:26.72,0:20:28.64,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:20:30.27,0:20:33.27,Default,,0,0,0,,～♪
Dialogue: 0,0:20:41.65,0:20:42.99,Default,,0,0,0,,μ…
Dialogue: 0,0:20:45.28,0:20:46.70,Default,,0,0,0,,Тыңдап тұрсың ба?
Dialogue: 0,0:20:47.91,0:20:49.91,Default,,0,0,0,,Заңның ақымақ...
Dialogue: 0,0:20:50.58,0:20:55.58,Default,,0,0,0,,♪～
Dialogue: 0,0:22:15.91,0:22:20.92,Default,,0,0,0,,～♪
Dialogue: 0,0:22:22.09,0:22:24.38,Default,,0,0,0,,Бір мақсаттағы адамдар -
Dialogue: 0,0:22:24.50,0:22:27.17,Default,,0,0,0,,Бірге жұмыс істеуіміз керек
Dialogue: 0,0:22:27.30,0:22:29.55,Default,,0,0,0,,Сондықтан мен үйірме жұмыстарын жамылғы ретінде қолдандым.
Dialogue: 0,0:22:29.68,0:22:32.01,Default,,0,0,0,,Әрекетті жалғастыру туралы не айтасыз?
Dialogue: 0,0:22:32.14,0:22:33.35,Default,,0,0,0,,Клуб қызметі?
Dialogue: 0,0:22:33.47,0:22:35.31,Default,,0,0,0,,А... аты...
Dialogue: 0,0:22:35.43,0:22:36.89,Default,,0,0,0,,Бір минут күте тұрыңыз!
Dialogue: 0,0:22:37.02,0:22:40.06,Default,,0,0,0,,Сенпайдың ат қою мағынасы... біртүрлі.
Dialogue: 0,0:22:40.19,0:22:41.48,Default,,0,0,0,,Уф... (4 адам) Хехе...
Dialogue: 0,0:22:41.61,0:22:42.90,Default,,0,0,0,,Үйге қайту клубы (барлығы) Иә?
Dialogue: 0,0:22:43.57,0:22:45.86,Default,,0,0,0,,Олай болса, үйге келу клубы ше?
Dialogue: 0,0:22:46.28,0:22:50.24,Default,,0,0,0,,Мұндағылардың барлығы шындыққа қайта оралғысы келеді, солай ма?
Dialogue: 0,0:22:50.36,0:22:52.07,Default,,0,0,0,,Керемет есім!
Dialogue: 0,0:22:52.20,0:22:54.53,Default,,0,0,0,,Сонымен, мен менеджермін...
Dialogue: 0,0:22:54.66,0:22:56.58,Default,,0,0,0,,Өйткені, Шоуго сонда...
Dialogue: 0,0:22:56.83,0:22:59.71,Default,,0,0,0,,Жоқ, мен Гала емеспін...
Dialogue: 0,0:23:00.08,0:23:02.00,Default,,0,0,0,,Заң: Сіз мұны істейсіз.
Dialogue: 0,0:23:02.13,0:23:05.46,Default,,0,0,0,,Е, сәл күте тұрыңыз, одан да білікті біреу бар...
Dialogue: 0,0:23:09.59,0:23:11.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:11.22,0:23:13.76,Default,,0,0,0,,Міне. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:23:13.89,0:23:15.22,Default,,0,0,0,,Менеджер
Dialogue: 0,0:23:16.14,0:23:18.68,Default,,0,0,0,,Осылайша бақытты дүниенің өтірігі...
Dialogue: 0,0:23:18.81,0:23:21.06,Default,,0,0,0,,Біз түсіндік...
Dialogue: 0,0:23:21.19,0:23:25.27,Default,,0,0,0,,Жәннатқа сатқын болды, Алаяқ аталды...
Dialogue: 0,0:23:26.77,0:23:32.77,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory