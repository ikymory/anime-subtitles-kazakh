Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.77,0:00:18.16,Default,,0,0,0,,Os iusti meditabitur sapientiam,
Dialogue: 0,0:00:18.16,0:00:27.29,Default,,0,0,0,,Et lingua eius loquetur indicium.
Dialogue: 0,0:00:27.29,0:00:38.55,Default,,0,0,0,,Beatus vir qui азап шегеді,
Dialogue: 0,0:00:38.55,0:00:49.15,Default,,0,0,0,,Quoniqm cum probaes fuerit accipient coronam vitae.
Dialogue: 0,0:00:49.15,0:01:02.24,Default,,0,0,0,,Кири, ignis divine, eleison.
Dialogue: 0,0:01:02.62,0:01:13.71,Default,,0,0,0,,О quam sancta, quam serena,
Dialogue: 0,0:01:13.71,0:01:28.31,Default,,0,0,0,,Куам-беигма, квам амоена,
Dialogue: 0,0:01:48.60,0:01:49.49,Default,,0,0,0,,Қауіпке барма.
Dialogue: 0,0:01:50.12,0:01:51.36,Default,,0,0,0,,Оны тез тоқтатыңыз
Dialogue: 0,0:01:51.96,0:01:52.88,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:01:53.08,0:01:55.77,Default,,0,0,0,,Менің ойымша, бұл апа сізді өлтіретін жалғыз адам.
Dialogue: 0,0:01:56.48,0:01:57.85,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:01:58.08,0:02:01.48,Default,,0,0,0,,Егер солай болса, мен оны бірден өлтірсем, босқа кетеді.
Dialogue: 0,0:02:14.32,0:02:15.89,Default,,0,0,0,,Ах, менің аяғым. .
Dialogue: 0,0:02:16.32,0:02:19.69,Default,,0,0,0,,Маған ұнамайды. Маған енді ауырсыну ұнамайды.
Dialogue: 0,0:02:26.28,0:02:29.09,Default,,0,0,0,,Ол енді жұмыс істемейді.
Dialogue: 0,0:02:29.80,0:02:31.45,Default,,0,0,0,,Сіз тек бір адамды өлтіре аласыз
Dialogue: 0,0:02:31.92,0:02:32.68,Default,,0,0,0,,Жалықтырғыш
Dialogue: 0,0:02:38.64,0:02:39.97,Default,,0,0,0,,Бұл баланың ойыны
Dialogue: 0,0:02:40.84,0:02:42.73,Default,,0,0,0,,Бұл жәндіктің қанатын ұстаумен бірдей.
Dialogue: 0,0:02:53.08,0:02:55.56,Default,,0,0,0,,Әй, әпке.
Dialogue: 0,0:02:55.96,0:02:57.20,Default,,0,0,0,,Бәрі бітті ме?
Dialogue: 0,0:02:58.36,0:02:59.96,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:03:17.72,0:03:19.37,Default,,0,0,0,,. . . Бұл не?
Dialogue: 0,0:03:43.64,0:03:46.41,Default,,0,0,0,,№ 35 Тоқта!
Dialogue: 0,0:03:49.76,0:03:50.89,Default,,0,0,0,,Жетеді
Dialogue: 0,0:03:51.28,0:03:52.41,Default,,0,0,0,,Мен жалықтым
Dialogue: 0,0:03:59.60,0:04:00.28,Default,,0,0,0,,Нана
Dialogue: 0,0:04:02.76,0:04:03.25,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:04:04.04,0:04:05.28,Default,,0,0,0,,Сіз жасырын түрде қайда кірдіңіз?
Dialogue: 0,0:04:05.88,0:04:07.37,Default,,0,0,0,,Қауіпсіздік тобы не істейді?
Dialogue: 0,0:04:10.16,0:04:11.92,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,0:04:12.88,0:04:14.17,Default,,0,0,0,,Сол бір бөтелкеге ​​не болды?
Dialogue: 0,0:04:14.92,0:04:16.84,Default,,0,0,0,,Неге келдің?
Dialogue: 0,0:04:17.84,0:04:19.41,Default,,0,0,0,,Ол 7 санымен таныс сияқты.
Dialogue: 0,0:04:19.76,0:04:22.97,Default,,0,0,0,,Әй, сен де анау ағаны өлтіргің келе ме?
Dialogue: 0,0:04:22.96,0:04:27.49,Default,,0,0,0,,Күте тұрыңыз, менің ойымша, мән-жайды сұрау керек.
Dialogue: 0,0:04:31.52,0:04:33.25,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:37.04,0:04:39.01,Default,,0,0,0,,Бұл адамға тиіспеңіз
Dialogue: 0,0:04:39.24,0:04:40.89,Default,,0,0,0,,Нана, сен ше?
Dialogue: 0,0:04:41.40,0:04:46.04,Default,,0,0,0,,Әй, анау аға сенің апаңның досы ғой.
Dialogue: 0,0:04:46.52,0:04:48.25,Default,,0,0,0,,Әй, тез қаш.
Dialogue: 0,0:04:48.24,0:04:49.81,Default,,0,0,0,,Сізді өлтіреді
Dialogue: 0,0:04:50.64,0:04:51.29,Default,,0,0,0,,Өлтірілді ме?
Dialogue: 0,0:04:51.80,0:04:52.80,Default,,0,0,0,,Тіпті қазір де жағдай осылай,
Dialogue: 0,0:04:52.80,0:04:53.56,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:53.92,0:04:56.57,Default,,0,0,0,,Камакура жағындағы барлық қауіпсіздік тобы құлап кеткен сияқты.
Dialogue: 0,0:04:57.12,0:04:58.45,Default,,0,0,0,,Қарапайым халық та жинап жатыр
Dialogue: 0,0:04:59.04,0:04:59.77,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:05:00.56,0:05:02.69,Default,,0,0,0,,Егер тұрақты емес жағдай әлі жалғаса берсе,
Dialogue: 0,0:05:05.16,0:05:05.92,Default,,0,0,0,,Ширакава
Dialogue: 0,0:05:06.28,0:05:07.69,Default,,0,0,0,,Мен ол қызбен сөйлесемін.
Dialogue: 0,0:05:08.16,0:05:09.57,Default,,0,0,0,,Өзіңізге еліктемеңіз
Dialogue: 0,0:05:09.80,0:05:12.09,Default,,0,0,0,,Біздің міндетіміз жеті санын жою.
Dialogue: 0,0:05:12.28,0:05:15.52,Default,,0,0,0,,Қарапайым адамдар мен Диклониус байланысады.
Dialogue: 0,0:05:16.04,0:05:17.41,Default,,0,0,0,,Өлтірмей істеудің жолы болуы керек.
Dialogue: 0,0:05:17.80,0:05:19.69,Default,,0,0,0,,Мицугу Ширакава
Dialogue: 0,0:05:20.44,0:05:22.44,Default,,0,0,0,,№ 35 № 7 өлтіру
Dialogue: 0,0:05:23.08,0:05:23.65,Default,,0,0,0,,Иә
Dialogue: 0,0:05:23.64,0:05:24.69,Default,,0,0,0,,Тоқта
Dialogue: 0,0:05:31.08,0:05:31.84,Default,,0,0,0,,Қауіпті
Dialogue: 0,0:05:45.20,0:05:46.36,Default,,0,0,0,,Мен кешіре алмаймын
Dialogue: 0,0:05:46.72,0:05:49.56,Default,,0,0,0,,Мен сияқты болсаң да, сенің достарың бар екеніне сене алмаймын.
Dialogue: 0,0:06:06.48,0:06:07.32,Default,,0,0,0,,Нана
Dialogue: 0,0:06:07.56,0:06:08.89,Default,,0,0,0,,Кота
Dialogue: 0,0:06:11.12,0:06:12.61,Default,,0,0,0,,7 саны теңізге құлады
Dialogue: 0,0:06:13.08,0:06:14.61,Default,,0,0,0,,Теңізді дереу іздеңіз.
Dialogue: 0,0:06:14.88,0:06:16.25,Default,,0,0,0,,Кота
Dialogue: 0,0:06:16.64,0:06:21.60,Default,,0,0,0,,Жақсы. . Люси болмайды
Dialogue: 0,0:06:29.36,0:06:30.85,Default,,0,0,0,,Нюу Жақсысың ба?
Dialogue: 0,0:06:31.08,0:06:32.37,Default,,0,0,0,,Сіз бара алмайсыз.
Dialogue: 0,0:06:32.52,0:06:34.52,Default,,0,0,0,,Сіз не істейсіз? Жіберу.
Dialogue: 0,0:06:34.52,0:06:36.52,Default,,0,0,0,,Жоқ, сені өлтіреді.
Dialogue: 0,0:06:36.72,0:06:38.72,Default,,0,0,0,,Сіз не айтып едіңіз? Жіберу.
Dialogue: 0,0:06:38.72,0:06:40.25,Default,,0,0,0,,Нюу Нюу
Dialogue: 0,0:06:40.48,0:06:41.64,Default,,0,0,0,,Кота
Dialogue: 0,0:06:42.28,0:06:44.73,Default,,0,0,0,,Сіз не істеп жатырсыз? 35. Тезірек Люсиді алыңыз.
Dialogue: 0,0:06:45.12,0:06:45.93,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:46.04,0:06:46.64,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:06:46.64,0:06:48.28,Default,,0,0,0,,Бұл Люси емес
Dialogue: 0,0:06:48.28,0:06:48.29,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Асықшы.
Dialogue: 0,0:06:48.29,0:06:50.28,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Асықшы.
Dialogue: 0,0:06:50.28,0:06:51.28,Default,,0,0,0,,Сіз қашып кете аласыз.
Dialogue: 0,0:06:51.28,0:06:53.41,Default,,0,0,0,,Ширакава Бұл туралы уайымдамаңыз.
Dialogue: 0,0:06:53.40,0:06:54.16,Default,,0,0,0,,Кота
Dialogue: 0,0:06:56.16,0:06:57.69,Default,,0,0,0,,Ах. . . сен
Dialogue: 0,0:07:01.24,0:07:04.40,Default,,0,0,0,,Ол шықпайды. Менің қолым шықпайды.
Dialogue: 0,0:07:04.40,0:07:05.24,Default,,0,0,0,,Тіпті қазір де жағдай осылай,
Dialogue: 0,0:07:06.40,0:07:07.89,Default,,0,0,0,,35 санын жинаңыз
Dialogue: 0,0:07:08.40,0:07:09.05,Default,,0,0,0,,Га
Dialogue: 0,0:07:09.56,0:07:11.13,Default,,0,0,0,,Ұстамдылық туралы ұмытпаңыз
Dialogue: 0,0:07:12.80,0:07:13.77,Default,,0,0,0,,Не. . Ол нені білдіреді?
Dialogue: 0,0:07:14.04,0:07:15.04,Default,,0,0,0,,Жаңа, қаш.
Dialogue: 0,0:07:15.76,0:07:16.44,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:07:16.44,0:07:19.44,Default,,0,0,0,,Шықпайды Шықпайды
Dialogue: 0,0:07:19.80,0:07:21.56,Default,,0,0,0,,Төтенше жағдайда
Dialogue: 0,0:07:22.64,0:07:23.80,Default,,0,0,0,,Люсидің қашып кетуіне жол берме
Dialogue: 0,0:07:24.56,0:07:27.20,Default,,0,0,0,,Күте тұрыңыз, Люси қазір Люси болды.
Dialogue: 0,0:07:27.20,0:07:27.21,Default,,0,0,0,,Түсіру
Dialogue: 0,0:07:27.21,0:07:27.96,Default,,0,0,0,,Түсіру
Dialogue: 0,0:07:31.72,0:07:32.96,Default,,0,0,0,,Тоқта
Dialogue: 0,0:07:33.28,0:07:35.17,Default,,0,0,0,,Куәгерлерді ешбір жағдайда тірі қалдыруға болмайды.
Dialogue: 0,0:07:35.52,0:07:36.93,Default,,0,0,0,,Шегіну
Dialogue: 0,0:07:37.20,0:07:38.69,Default,,0,0,0,,Ескерту атуларының мағынасы жоқ.
Dialogue: 0,0:07:39.20,0:07:41.73,Default,,0,0,0,,Егер сіз тартынсаңыз, өзіңізді өлтіре аласыз.
Dialogue: 0,0:07:42.32,0:07:43.48,Default,,0,0,0,,Сөзсіз
Dialogue: 0,0:07:43.96,0:07:44.72,Default,,0,0,0,,Мақсат
Dialogue: 0,0:07:45.80,0:07:47.72,Default,,0,0,0,,Бұл. . . өлтірілу
Dialogue: 0,0:07:48.08,0:07:49.16,Default,,0,0,0,,Кота
Dialogue: 0,0:07:49.16,0:07:50.56,Default,,0,0,0,,Қаш, қаш.
Dialogue: 0,0:07:50.56,0:07:50.57,Default,,0,0,0,,Кота
Dialogue: 0,0:07:50.57,0:07:51.56,Default,,0,0,0,,Кота
Dialogue: 0,0:07:51.84,0:07:52.84,Default,,0,0,0,,Түсіру
Dialogue: 0,0:07:53.68,0:07:55.49,Default,,0,0,0,,Кота
Dialogue: 0,0:07:59.56,0:08:01.45,Default,,0,0,0,,Мен бір нәрсені түсінбеймін.
Dialogue: 0,0:08:01.68,0:08:04.97,Default,,0,0,0,,Нана-чан мен Ню-чанға да солай.
Dialogue: 0,0:08:05.56,0:08:07.56,Default,,0,0,0,,Оның Котаға қатысы жоқ.
Dialogue: 0,0:08:08.60,0:08:09.36,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:08:09.72,0:08:12.37,Default,,0,0,0,,Мен туралы да
Dialogue: 0,0:08:13.48,0:08:14.21,Default,,0,0,0,,Маю-чан?
Dialogue: 0,0:08:15.36,0:08:17.44,Default,,0,0,0,,Мен мұны Нанамен бірге болған кезде сезіндім.
Dialogue: 0,0:08:17.84,0:08:21.21,Default,,0,0,0,,Кота-санды дүние тастап кеткен сияқты.
Dialogue: 0,0:08:21.36,0:08:24.13,Default,,0,0,0,,Олар бізді бірден қабылдады.
Dialogue: 0,0:08:24.36,0:08:25.85,Default,,0,0,0,,Жақсы айта алмаймын, бірақ
Dialogue: 0,0:08:26.08,0:08:31.01,Default,,0,0,0,,Қандай да бір қиналып, мұңайған адамды жалғыз қалдыра алмайтын сияқтысың.
Dialogue: 0,0:08:31.00,0:08:34.13,Default,,0,0,0,,Жоқ. Менің ойымша, мұны істеуіміздің себебі бар.
Dialogue: 0,0:08:34.76,0:08:35.57,Default,,0,0,0,,Сен дұрыс айтасың — сені өліміңе мен себеп болдым.
Dialogue: 0,0:08:38.20,0:08:41.44,Default,,0,0,0,,Оның сол оқиғаға қатысы бар ма деп ойлаймын.
Dialogue: 0,0:08:41.80,0:08:42.80,Default,,0,0,0,,Оқиға?
Dialogue: 0,0:08:43.32,0:08:44.81,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:08:46.68,0:08:49.33,Default,,0,0,0,,Котаға қандай себеп болғаны маңызды емес.
Dialogue: 0,0:08:49.56,0:08:53.17,Default,,0,0,0,,Менің ойымша, бұл Каэде сарайы мендегі жалғыз үй.
Dialogue: 0,0:08:53.68,0:08:56.33,Default,,0,0,0,,Ню-сан мен Нана-сан аға мен әпке сияқты.
Dialogue: 0,0:08:56.52,0:08:58.09,Default,,0,0,0,,Менің де ата-анам бар.
Dialogue: 0,0:08:58.84,0:08:59.60,Default,,0,0,0,,Ата-аналар?
Dialogue: 0,0:09:00.92,0:09:04.72,Default,,0,0,0,,Кота - Каэдесудың әкесі, Юка - анасы.
Dialogue: 0,0:09:05.32,0:09:06.85,Default,,0,0,0,,Менің ойымша, бұл.
Dialogue: 0,0:09:07.20,0:09:09.73,Default,,0,0,0,,Маю-чан, сен не айтып тұрсың?
Dialogue: 0,0:09:10.68,0:09:15.85,Default,,0,0,0,,Сондықтан бәрі жақын арада қайтып келетініне сенімдімін.
Dialogue: 0,0:09:23.80,0:09:25.01,Default,,0,0,0,,Жер бетінде не бар? . .
Dialogue: 0,0:09:26.96,0:09:28.25,Default,,0,0,0,,Бұл ақымақтық
Dialogue: 0,0:09:36.12,0:09:38.12,Default,,0,0,0,,Мен Люсиді көріп тұрмын.
Dialogue: 0,0:09:38.76,0:09:40.89,Default,,0,0,0,,Тұлға бөлінеді, сондықтан
Dialogue: 0,0:09:42.76,0:09:44.36,Default,,0,0,0,,Жаңа, не болды?
Dialogue: 0,0:09:44.76,0:09:45.73,Default,,0,0,0,,Тыңдау
Dialogue: 0,0:09:46.32,0:09:48.77,Default,,0,0,0,,Ол сіз білетін адам емес
Dialogue: 0,0:09:49.00,0:09:50.89,Default,,0,0,0,,Ол Люси
Dialogue: 0,0:09:54.96,0:09:57.12,Default,,0,0,0,,Мені кешіріңіз, бастық.
Dialogue: 0,0:10:04.40,0:10:05.24,Default,,0,0,0,,Жыл бойы шорт киетін ұрғашы горилла ма!?
Dialogue: 0,0:10:08.28,0:10:09.17,Default,,0,0,0,,Әзірше осы.
Dialogue: 0,0:10:09.76,0:10:10.36,Default,,0,0,0,,Кира — бұл жолы тым ыңғайлы болып кетті — мен Жапон тергеу басқармасы арасындағы сөйлесулерге қарағанда,
Dialogue: 0,0:10:11.16,0:10:14.29,Default,,0,0,0,,Қорықпа. Барлығын бірден ататын болсаңыз, олар сізге тосқауыл қоя алмайды.
Dialogue: 0,0:10:15.24,0:10:16.13,Default,,0,0,0,,Өлгің келе ме?
Dialogue: 0,0:10:17.40,0:10:18.29,Default,,0,0,0,,Ал, қалай ойлайсың, Армин?
Dialogue: 0,0:10:25.28,0:10:28.28,Default,,0,0,0,,Түсіру. Енді бейбіт тұрғындарды тартуға алаңдаудың қажеті жоқ.
Dialogue: 0,0:10:33.80,0:10:34.80,Default,,0,0,0,,Мені атып таста
Dialogue: 0,0:10:36.28,0:10:37.41,Default,,0,0,0,,Бұл құбыжық
Dialogue: 0,0:10:50.96,0:10:54.09,Default,,0,0,0,,Иә, бұл бала.
Dialogue: 0,0:11:02.56,0:11:05.20,Default,,0,0,0,,Қарашы, қарашы, Юка-чан ебедейсіз.
Dialogue: 0,0:11:05.20,0:11:05.21,Default,,0,0,0,,Егер солай болса, қанша рет тырыссаңыз да, бәрі бірдей.
Dialogue: 0,0:11:05.21,0:11:07.60,Default,,0,0,0,,Егер солай болса, қанша рет тырыссаңыз да, бәрі бірдей.
Dialogue: 0,0:11:08.28,0:11:11.57,Default,,0,0,0,,Не? Мен оны ұнатпаймын. Мен оны ұнатпаймын.
Dialogue: 0,0:11:11.68,0:11:13.57,Default,,0,0,0,,Осындай жерде жүрген идиот
Dialogue: 0,0:11:14.04,0:11:17.09,Default,,0,0,0,,Мен сені келесі жазға дейін көргім келмейді.
Dialogue: 0,0:11:17.84,0:11:19.84,Default,,0,0,0,,Ол қыз келмеді.
Dialogue: 0,0:11:22.04,0:11:23.45,Default,,0,0,0,,Жүр, жылауыңды доғар.
Dialogue: 0,0:11:23.60,0:11:25.05,Default,,0,0,0,,Өйткені сен бала емессің
Dialogue: 0,0:11:25.80,0:11:26.37,Default,,0,0,0,,Иә
Dialogue: 0,0:11:27.32,0:11:29.85,Default,,0,0,0,,Кана қайда кетті?
Dialogue: 0,0:11:30.60,0:11:32.73,Default,,0,0,0,,Мен адаспаймын деп үміттенемін.
Dialogue: 0,0:11:38.12,0:11:40.01,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:11:40.36,0:11:42.00,Default,,0,0,0,,Юка Кота
Dialogue: 0,0:11:42.00,0:11:42.01,Default,,0,0,0,,Ағай
Dialogue: 0,0:11:42.01,0:11:42.97,Default,,0,0,0,,Ағай
Dialogue: 0,0:11:44.48,0:11:47.21,Default,,0,0,0,,Жақсы, жақсы болдыңыз ба?
Dialogue: 0,0:11:48.24,0:11:49.00,Default,,0,0,0,,Канае. .
Dialogue: 0,0:11:49.52,0:11:50.85,Default,,0,0,0,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:11:51.48,0:11:52.61,Default,,0,0,0,,Канэйге не болды?
Dialogue: 0,0:11:52.96,0:11:54.49,Default,,0,0,0,,Бөлініп қалды
Dialogue: 0,0:11:55.12,0:11:57.12,Default,,0,0,0,,Не болса да мен Канайды іздеймін.
Dialogue: 0,0:11:58.52,0:12:00.49,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:00.64,0:12:02.96,Default,,0,0,0,,Сол жерде бомба жарылса керек.
Dialogue: 0,0:12:02.96,0:12:03.88,Default,,0,0,0,,Бомба?
Dialogue: 0,0:12:05.40,0:12:06.29,Default,,0,0,0,,Ах.
Dialogue: 0,0:12:06.76,0:12:08.29,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:12:09.00,0:12:10.05,Default,,0,0,0,,Канае
Dialogue: 0,0:12:10.40,0:12:15.65,Default,,0,0,0,,Канэй-чан, сенің үстінде қан бар.
Dialogue: 0,0:12:15.64,0:12:16.48,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:12:17.76,0:12:20.53,Default,,0,0,0,,Көптеген адамдар қаза тапты.
Dialogue: 0,0:12:20.52,0:12:21.65,Default,,0,0,0,,Өлтірілді ме?
Dialogue: 0,0:12:22.24,0:12:26.93,Default,,0,0,0,,Мен оны көрдім.
Dialogue: 0,0:12:27.76,0:12:29.65,Default,,0,0,0,,Әйтеуір, тез үйге қайтайық.
Dialogue: 0,0:12:31.88,0:12:34.17,Default,,0,0,0,,Сіз қайтадан келесіз.
Dialogue: 0,0:12:35.44,0:12:38.57,Default,,0,0,0,,Бұл сөзсіз уәде.
Dialogue: 0,0:12:40.52,0:12:42.44,Default,,0,0,0,,Өйткені маған Юка-чан ұнайды
Dialogue: 0,0:12:42.80,0:12:44.20,Default,,0,0,0,,Сондықтан күте тұрыңыз.
Dialogue: 0,0:12:44.20,0:12:44.21,Default,,0,0,0,,Иә, күтемін. Мен сені күттім.
Dialogue: 0,0:12:44.21,0:12:47.57,Default,,0,0,0,,Иә, күтемін. Мен сені күттім.
Dialogue: 0,0:12:47.68,0:12:50.33,Default,,0,0,0,,Сондықтан мені ұмытпа
Dialogue: 0,0:12:50.68,0:12:51.44,Default,,0,0,0,,Бұл болды
Dialogue: 0,0:12:51.64,0:12:53.05,Default,,0,0,0,,Сен не істеп жүрсің, Кана?
Dialogue: 0,0:12:56.20,0:12:58.09,Default,,0,0,0,,Канэй Чанның да жағдайы жақсы деп үміттенемін.
Dialogue: 0,0:13:00.08,0:13:01.32,Default,,0,0,0,,Канаэ Кора
Dialogue: 0,0:13:01.64,0:13:02.64,Default,,0,0,0,,Кеттік
Dialogue: 0,0:13:06.40,0:13:09.45,Default,,0,0,0,,Ақырында ол бала келмеді.
Dialogue: 0,0:13:09.60,0:13:10.20,Default,,0,0,0,,Кота
Dialogue: 0,0:13:10.44,0:13:11.44,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:13:25.80,0:13:27.85,Default,,0,0,0,,Кана, не болды?
Dialogue: 0,0:13:28.08,0:13:30.32,Default,,0,0,0,,Үлкен ағаның ақымақ
Dialogue: 0,0:13:30.32,0:13:33.48,Default,,0,0,0,,Менің ағамды мүйізді қыз өлтіреді.
Dialogue: 0,0:13:34.72,0:13:35.85,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:13:36.56,0:13:38.01,Default,,0,0,0,,Мен оны фестивальде көрдім.
Dialogue: 0,0:13:38.36,0:13:41.73,Default,,0,0,0,,Мүйізді қыз барлығын бір-ақ өлтірді.
Dialogue: 0,0:13:42.60,0:13:43.84,Default,,0,0,0,,Біртүрлі сөздер айтпа
Dialogue: 0,0:13:44.24,0:13:45.48,Default,,0,0,0,,Ондай нәрсе бар ма?
Dialogue: 0,0:13:45.88,0:13:46.88,Default,,0,0,0,,Дегенмен, менің ойымша, бұл жақсы жоспар.
Dialogue: 0,0:13:46.88,0:13:47.85,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:13:48.08,0:13:49.49,Default,,0,0,0,,Мен көрдім.
Dialogue: 0,0:13:49.96,0:13:52.36,Default,,0,0,0,,Мен олай өтірік айтатындарды ұнатпаймын.
Dialogue: 0,0:13:55.76,0:13:59.77,Default,,0,0,0,,Ақымақ, ақымақ, Канае өтірікші емес.
Dialogue: 0,0:13:59.76,0:14:00.76,Default,,0,0,0,,Әй, сен неге үндемейсің?
Dialogue: 0,0:14:01.64,0:14:05.36,Default,,0,0,0,,Оны мүйізді қыз шынымен өлтірді.
Dialogue: 0,0:14:17.84,0:14:19.17,Default,,0,0,0,,Канаэ Кора
Dialogue: 0,0:14:19.52,0:14:21.36,Default,,0,0,0,,О сен
Dialogue: 0,0:14:21.76,0:14:23.05,Default,,0,0,0,,Сіз де бортта болдыңыз.
Dialogue: 0,0:14:23.52,0:14:26.25,Default,,0,0,0,,Сен келмеген соң, мен не болды деп ойладым.
Dialogue: 0,0:14:26.92,0:14:29.13,Default,,0,0,0,,Бауырым, не айтып тұрсың?
Dialogue: 0,0:14:29.40,0:14:31.80,Default,,0,0,0,,Тез, тез қашуымыз керек.
Dialogue: 0,0:14:32.16,0:14:33.00,Default,,0,0,0,,Жыл бойы шорт киетін ұрғашы горилла ма!?
Dialogue: 0,0:14:36.12,0:14:41.13,Default,,0,0,0,,Ертең бірге баратын Котаның жеңгелері ұл мен қыз.
Dialogue: 0,0:14:46.12,0:14:47.17,Default,,0,0,0,,Бұл ұл бала
Dialogue: 0,0:14:48.68,0:14:49.65,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:51.28,0:14:56.08,Default,,0,0,0,,Ертең Ертең түнде мен Котаны вокзалдан шығарып салуға барамын.
Dialogue: 0,0:14:56.92,0:14:57.44,Default,,0,0,0,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:15:00.44,0:15:02.65,Default,,0,0,0,,ұзын мойын ұзын мойын
Dialogue: 0,0:15:03.28,0:15:06.57,Default,,0,0,0,,Ей, сенің ұзын мойның керемет.
Dialogue: 0,0:15:08.96,0:15:11.93,Default,,0,0,0,,Бұл не? Үлкен үлкен үлкен
Dialogue: 0,0:15:12.32,0:15:14.53,Default,,0,0,0,,Өте үлкен нәрсе
Dialogue: 0,0:15:35.04,0:15:37.49,Default,,0,0,0,,Су салқын, өзін жақсы сезінеді
Dialogue: 0,0:15:43.84,0:15:45.57,Default,,0,0,0,,Бетіңіз лас.
Dialogue: 0,0:16:00.24,0:16:02.13,Default,,0,0,0,,Енді әдемірек емес пе?
Dialogue: 0,0:16:05.12,0:16:06.61,Default,,0,0,0,,Өз кезегінде
Dialogue: 0,0:16:07.08,0:16:08.53,Default,,0,0,0,,Менің ойымша, бұл бірінші орында.
Dialogue: 0,0:16:20.04,0:16:22.52,Default,,0,0,0,,Киім кепкенше автобусқа отыра алмаймын.
Dialogue: 0,0:16:31.40,0:16:33.29,Default,,0,0,0,,. . Ауырды
Dialogue: 0,0:16:35.04,0:16:37.17,Default,,0,0,0,,Аа, кешіріңіз, жақсысыз ба?
Dialogue: 0,0:16:39.56,0:16:41.13,Default,,0,0,0,,А, мен таң қалдым.
Dialogue: 0,0:16:41.88,0:16:42.80,Default,,0,0,0,,Бұл менің кесірім.
Dialogue: 0,0:16:45.36,0:16:45.93,Default,,0,0,0,,Кота
Dialogue: 0,0:16:47.64,0:16:48.77,Default,,0,0,0,,Сұранысыңыз бар ма?
Dialogue: 0,0:16:49.44,0:16:53.57,Default,,0,0,0,,Егер мен көп адамдарды өлтіре бастасам
Dialogue: 0,0:17:01.88,0:17:03.21,Default,,0,0,0,,Құрмет
Dialogue: 0,0:17:11.92,0:17:16.77,Default,,0,0,0,,Кота, Кота мені өлтірді.
Dialogue: 0,0:17:17.52,0:17:21.68,Default,,0,0,0,,Бұл өтірік. Мынадай. Мынадай.
Dialogue: 0,0:17:41.08,0:17:42.53,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:17:42.76,0:17:45.81,Default,,0,0,0,,Камакурада мұндай дүкендер көп.
Dialogue: 0,0:17:49.08,0:17:51.08,Default,,0,0,0,,Мұны сатып алуым керек пе?
Dialogue: 0,0:17:53.32,0:17:56.09,Default,,0,0,0,,Ән көңілді естілсе. . .
Dialogue: 0,0:17:56.40,0:17:57.64,Default,,0,0,0,,Бұл менің таңдауым.
Dialogue: 0,0:17:57.92,0:17:59.57,Default,,0,0,0,,Өйткені бұл ән маған ұнады
Dialogue: 0,0:18:18.60,0:18:19.20,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:18:20.56,0:18:22.05,Default,,0,0,0,,Өйткені мен оны үнемі қарап отырдым
Dialogue: 0,0:18:23.32,0:18:26.93,Default,,0,0,0,,Әдемі ән екен деп ойладым.
Dialogue: 0,0:18:27.32,0:18:28.13,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:18:28.80,0:18:30.61,Default,,0,0,0,,Мен үшін алаңдама
Dialogue: 0,0:18:31.12,0:18:33.36,Default,,0,0,0,,Ей, менімен дос бол.
Dialogue: 0,0:18:36.08,0:18:37.68,Default,,0,0,0,,Қай жерде сурет салдыңыз?
Dialogue: 0,0:18:38.44,0:18:40.76,Default,,0,0,0,,Иә, тауда
Dialogue: 0,0:18:41.24,0:18:43.08,Default,,0,0,0,,Біртүрлі бала еді.
Dialogue: 0,0:18:43.76,0:18:44.97,Default,,0,0,0,,Біртүрлі бала ма?
Dialogue: 0,0:18:44.96,0:18:50.00,Default,,0,0,0,,Үлкен аға, мен көп снарядтарды жинадым, қара!
Dialogue: 0,0:18:51.52,0:18:52.33,Default,,0,0,0,,(Роко) Һм? (Масато) Хехехе
Dialogue: 0,0:18:53.60,0:18:56.37,Default,,0,0,0,,Егер бұл мүйізді ұнатпасаңыз, оны жасырыңыз.
Dialogue: 0,0:18:59.24,0:19:00.08,Default,,0,0,0,,Жыл бойы шорт киетін ұрғашы горилла ма!?
Dialogue: 0,0:19:01.40,0:19:02.37,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:19:02.36,0:19:03.17,Default,,0,0,0,,Канае
Dialogue: 0,0:19:04.96,0:19:08.65,Default,,0,0,0,,Үлкен аға, қашу керек, тез қашу керек.
Dialogue: 0,0:19:11.40,0:19:13.29,Default,,0,0,0,,Не істеп жатырсың, ақымақ?
Dialogue: 0,0:19:13.48,0:19:15.37,Default,,0,0,0,,Бұл бала не істеді?
Dialogue: 0,0:19:15.72,0:19:17.04,Default,,0,0,0,,Дұрыс кешірім сұрау
Dialogue: 0,0:19:17.04,0:19:17.05,Default,,0,0,0,,Әйтпесе, мен Канайды жек көремін.
Dialogue: 0,0:19:17.05,0:19:19.80,Default,,0,0,0,,Әйтпесе, мен Канайды жек көремін.
Dialogue: 0,0:19:20.80,0:19:25.17,Default,,0,0,0,,Жоқ, аға, өтінемін, Канайды жек көрмеңіз.
Dialogue: 0,0:19:49.92,0:19:51.97,Default,,0,0,0,,Кота, сен нені шулатып тұрсың? . .
Dialogue: 0,0:20:01.32,0:20:04.40,Default,,0,0,0,,Мұның бәрін сіз жасадыңыз.
Dialogue: 0,0:20:05.32,0:20:07.05,Default,,0,0,0,,Неге бұлай істеп жатырсың?
Dialogue: 0,0:20:07.20,0:20:09.20,Default,,0,0,0,,Біз дос емеспіз
Dialogue: 0,0:20:10.32,0:20:11.48,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:20:11.72,0:20:14.17,Default,,0,0,0,,Сен мені дос болғанымыз үшін өлтірмеген шығарсың.
Dialogue: 0,0:20:20.20,0:20:22.17,Default,,0,0,0,,Келесі - бұл әйел.
Dialogue: 0,0:20:24.96,0:20:26.69,Default,,0,0,0,,Әйел Юка
Dialogue: 0,0:20:44.00,0:20:45.49,Default,,0,0,0,,Оны қазірдің өзінде тоқтатыңыз.
Dialogue: 0,0:20:46.64,0:20:50.96,Default,,0,0,0,,Тоқта, тоқта, тоқта!
Dialogue: 0,0:20:51.64,0:20:54.77,Default,,0,0,0,,Тоқта, тоқта
Dialogue: 0,0:20:54.76,0:20:56.76,Default,,0,0,0,,Оны қазірдің өзінде тоқтатыңыз.
Dialogue: 0,0:21:00.08,0:21:01.61,Default,,0,0,0,,Оны қазірдің өзінде тоқтатыңыз.
Dialogue: 0,0:21:11.88,0:21:13.77,Default,,0,0,0,,Қауіпті, бұл өрт қаупі.
Dialogue: 0,0:21:19.28,0:21:21.81,Default,,0,0,0,,Мен есімде қалдым Бәрі есімде
Dialogue: 0,0:21:23.40,0:21:26.29,Default,,0,0,0,,Сіз сегіз жыл бұрын сол кезде болдыңыз.
Dialogue: 0,0:21:47.56,0:21:52.81,Default,,0,0,0,,Айтшы, сен кімсің?
Dialogue: 0,0:21:54.80,0:21:57.09,Default,,0,0,0,,Осы сияқты әдеттен тыс нәрселер көп болып жатыр.
Dialogue: 0,0:21:57.44,0:21:59.44,Default,,0,0,0,,Сіз әрқашан ортадасыз
Dialogue: 0,0:21:59.76,0:22:01.09,Default,,0,0,0,,Білгеннен не пайда?
Dialogue: 0,0:22:01.44,0:22:04.08,Default,,0,0,0,,Мұның сізге еш қатысы жоқ.
Dialogue: 0,0:22:04.08,0:22:04.09,Default,,0,0,0,,Иә, болуы керек.
Dialogue: 0,0:22:04.09,0:22:08.56,Default,,0,0,0,,Иә, болуы керек.
Dialogue: 0,0:22:12.60,0:22:16.92,Default,,0,0,0,,Менің әпкем мен әкемді өлтірдің.
Dialogue: 0,0:22:23.60,0:22:24.44,Default,,0,0,0,,Кота
Dialogue: 0,0:22:28.60,0:22:32.72,Default,,0,0,0,,Мен аң аулауды өтінген олжаны аулайтын сүйікті адам болады деп ойламаппын.
Dialogue: 0,0:22:32.72,0:22:32.73,Default,,0,0,0,,Көзімнің, қолымның жауы. Мен өлемін.
Dialogue: 0,0:22:32.73,0:22:35.49,Default,,0,0,0,,Көзімнің, қолымның жауы. Мен өлемін.
Dialogue: 0,0:22:44.36,0:22:46.84,Default,,0,0,0,,Қашпа, күрес!
Dialogue: 0,0:22:48.00,0:22:50.08,Default,,0,0,0,,Мені сол тас баспалдақта күт.
Dialogue: 0,0:22:53.64,0:22:54.48,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:24:34.68,0:24:36.84,Default,,0,0,0,,Дұғалар ақыры қабыл болмайды
Dialogue: 0,0:24:37.32,0:24:39.85,Default,,0,0,0,,Мойындаудың енді мағынасы жоқ
Dialogue: 0,0:24:40.96,0:24:42.93,Default,,0,0,0,,Бір-бірінің жеке сөздері, жақсылығы
Dialogue: 0,0:24:43.36,0:24:46.01,Default,,0,0,0,,Махаббаттың да ұсақ-түйек болудан басқа амалы жоқ
Dialogue: 0,0:24:46.96,0:24:50.12,Default,,0,0,0,,Ертегі жырындай
Dialogue: 0,0:24:50.44,0:24:53.36,Default,,0,0,0,,Мұңды жыр сияқты, Эфемерлі
Dialogue: 0,0:24:54.48,0:24:57.13,Default,,0,0,0,,Келесі жолы Elfen Lied соңғы эпизоды
Dialogue: 0,0:24:57.64,0:24:58.45,Default,,0,0,0,,Қайтаруға жатпайды
Dialogue: 0,0:24:59.95,0:25:05.95,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory