Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.77,0:00:18.16,Default,,0,0,0,,Os iusti meditabitur sapientiam,
Dialogue: 0,0:00:18.16,0:00:27.29,Default,,0,0,0,,Et lingua eius loquetur indicium.
Dialogue: 0,0:00:27.29,0:00:38.55,Default,,0,0,0,,Beatus vir qui азап шегеді,
Dialogue: 0,0:00:38.55,0:00:49.15,Default,,0,0,0,,Quoniqm cum probaes fuerit accipient coronam vitae.
Dialogue: 0,0:00:49.15,0:01:02.24,Default,,0,0,0,,Кири, ignis divine, eleison.
Dialogue: 0,0:01:02.62,0:01:13.71,Default,,0,0,0,,О quam sancta, quam serena,
Dialogue: 0,0:01:13.71,0:01:28.31,Default,,0,0,0,,Куам-беигма, квам амоена,
Dialogue: 0,0:01:31.20,0:01:32.85,Default,,0,0,0,,Көзіңізді баяу ашыңыз.
Dialogue: 0,0:01:35.72,0:01:36.56,Default,,0,0,0,,Ал ше?
Dialogue: 0,0:01:38.08,0:01:39.57,Default,,0,0,0,,Бұлыңғыр
Dialogue: 0,0:01:40.12,0:01:41.36,Default,,0,0,0,,Көрінбейтін
Dialogue: 0,0:01:42.20,0:01:44.85,Default,,0,0,0,,Егер үйреніп алсаң, біраз қалпына келу керек.
Dialogue: 0,0:01:45.36,0:01:47.57,Default,,0,0,0,,Тағы да
Dialogue: 0,0:01:49.12,0:01:51.12,Default,,0,0,0,,Ең соңғы миоэлектрлік протездік қол
Dialogue: 0,0:01:52.44,0:01:53.89,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:01:54.88,0:01:56.85,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасадым.
Dialogue: 0,0:01:57.72,0:02:00.85,Default,,0,0,0,,Менің допымның орнына, солай ма?
Dialogue: 0,0:02:02.76,0:02:03.73,Default,,0,0,0,,Осылайша
Dialogue: 0,0:02:04.76,0:02:05.36,Default,,0,0,0,,Не?
Dialogue: 0,0:02:05.88,0:02:06.77,Default,,0,0,0,,Тыныштандыратын дәрілер
Dialogue: 0,0:02:07.88,0:02:09.88,Default,,0,0,0,,Біз кесу операциясын жасағалы жатырмыз.
Dialogue: 0,0:02:10.92,0:02:12.57,Default,,0,0,0,,Бірден барайық.
Dialogue: 0,0:02:13.28,0:02:13.80,Default,,0,0,0,,На
Dialogue: 0,0:02:14.24,0:02:14.81,Default,,0,0,0,,Иә
Dialogue: 0,0:02:15.52,0:02:18.65,Default,,0,0,0,,How long can this toy last?
Dialogue: 0,0:02:19.44,0:02:21.65,Default,,0,0,0,,Ол 50 кг салмаққа шыдайды.
Dialogue: 0,0:02:22.64,0:02:24.93,Default,,0,0,0,,Сыртқы қысым сияқты соққылар да айтарлықтай ауыр.
Dialogue: 0,0:02:33.20,0:02:35.28,Default,,0,0,0,,Бұл өте жаман!
Dialogue: 0,0:02:38.44,0:02:40.44,Default,,0,0,0,,It's definitely a nice toy.
Dialogue: 0,0:02:46.32,0:02:46.92,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:02:47.72,0:02:50.04,Default,,0,0,0,,SAT идентификаторы әлі тірі болғанда қару
Dialogue: 0,0:03:03.60,0:03:05.73,Default,,0,0,0,,Кота, сен қайда барасың?
Dialogue: 0,0:03:06.36,0:03:08.57,Default,,0,0,0,,Because I'm worried about Nyuu
Dialogue: 0,0:03:09.00,0:03:10.81,Default,,0,0,0,,Мүмкін мектеп?
Dialogue: 0,0:03:12.12,0:03:15.84,Default,,0,0,0,,Осы сағатта әлі де профессорлар болуы мүмкін.
Dialogue: 0,0:03:16.24,0:03:18.13,Default,,0,0,0,,Жақсы. . . Сосын мен де
Dialogue: 0,0:03:18.24,0:03:18.76,Default,,0,0,0,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:03:20.72,0:03:22.61,Default,,0,0,0,,Мен жалғыз барамын.
Dialogue: 0,0:03:23.24,0:03:23.89,Default,,0,0,0,,Өйткені
Dialogue: 0,0:03:24.12,0:03:25.77,Default,,0,0,0,,It's quite cold outside.
Dialogue: 0,0:03:26.48,0:03:28.48,Default,,0,0,0,,Су салқын болса, суық тиіп қаласың.
Dialogue: 0,0:03:29.88,0:03:30.48,Default,,0,0,0,,Бірақ
Dialogue: 0,0:03:32.64,0:03:35.88,Default,,0,0,0,,It's okay, Yuka, please wait.
Dialogue: 0,0:03:36.64,0:03:37.21,Default,,0,0,0,,Иә
Dialogue: 0,0:03:44.36,0:03:44.77,Default,,0,0,0,,Иә…♡
Dialogue: 0,0:03:46.76,0:03:48.29,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:03:51.64,0:03:52.77,Default,,0,0,0,,Мұғалім?
Dialogue: 0,0:03:54.64,0:03:59.93,Default,,0,0,0,,Көп адамға телефон соғатыным сонша, тіпті жуынып үлгермей қалдым.
Dialogue: 0,0:04:01.92,0:04:02.81,Default,,0,0,0,,Соңында ол табысқа жете ме, жетпей ме
Dialogue: 0,0:04:06.52,0:04:08.68,Default,,0,0,0,,It's a ribbon, right?
Dialogue: 0,0:04:15.28,0:04:16.25,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:16.72,0:04:20.28,Default,,0,0,0,,Не? . . Мен таң қалдым
Dialogue: 0,0:04:20.88,0:04:22.48,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:04:24.28,0:04:25.52,Default,,0,0,0,,Professor Kadozawa
Dialogue: 0,0:04:26.16,0:04:29.24,Default,,0,0,0,,Мұғалім үшін? Осындай уақытта?
Dialogue: 0,0:04:29.76,0:04:30.97,Default,,0,0,0,,Иә, жақсы
Dialogue: 0,0:04:31.52,0:04:32.60,Default,,0,0,0,,Иә
Dialogue: 0,0:04:34.84,0:04:35.49,Default,,0,0,0,,Бұл
Dialogue: 0,0:04:36.16,0:04:38.05,Default,,0,0,0,,I think he's probably underground.
Dialogue: 0,0:04:38.52,0:04:39.17,Default,,0,0,0,,Жер асты?
Dialogue: 0,0:04:39.60,0:04:41.01,Default,,0,0,0,,Зертхана бар ма?
Dialogue: 0,0:04:42.28,0:04:45.28,Default,,0,0,0,,Бұл мұғалім жиі үндемейді.
Dialogue: 0,0:04:48.16,0:04:50.40,Default,,0,0,0,,Мұғалімнің қандай пайдасы бар?
Dialogue: 0,0:04:51.16,0:04:56.04,Default,,0,0,0,,Мен өз профессорыммен кім екенін білмейтін қызды қалдырдым.
Dialogue: 0,0:04:57.04,0:04:59.04,Default,,0,0,0,,Мен аздап уайымдап тұрмын
Dialogue: 0,0:05:00.88,0:05:02.33,Default,,0,0,0,,Мен бұл туралы алаңдаймын.
Dialogue: 0,0:05:02.80,0:05:06.57,Default,,0,0,0,,Баланы профессордың інісінің қызы дейді.
Dialogue: 0,0:05:07.44,0:05:09.41,Default,,0,0,0,,Сізді алдап кетті.
Dialogue: 0,0:05:10.76,0:05:13.08,Default,,0,0,0,,Ол кісінің інісі жоқ.
Dialogue: 0,0:05:14.68,0:05:15.44,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:05:18.08,0:05:22.69,Default,,0,0,0,,Мен шаршадым. Мүмкін мен бұл толық емес жұмыс күнін таңдамаған шығармын.
Dialogue: 0,0:05:23.84,0:05:25.52,Default,,0,0,0,,Мен барынша тырысамын.
Dialogue: 0,0:05:26.20,0:05:29.84,Default,,0,0,0,,Дүкен менеджері тек сенің бөксеңе қарап отыр. Бұл жыныстық қудалау.
Dialogue: 0,0:05:30.32,0:05:33.45,Default,,0,0,0,,А, мен сұрағанды ​​ұнатпаймын.
Dialogue: 0,0:05:39.32,0:05:42.09,Default,,0,0,0,,Профессор мұнда қандай зерттеу жүргізіп жатыр?
Dialogue: 0,0:05:43.08,0:05:45.69,Default,,0,0,0,,Менің басымда мүйіз өсетін біртүрлі ауру бар.
Dialogue: 0,0:05:46.60,0:05:48.49,Default,,0,0,0,,. . . Не?
Dialogue: 0,0:05:49.68,0:05:50.97,Default,,0,0,0,,Бұл Шехер астрономиялық басқармасы—
Dialogue: 0,0:05:53.36,0:05:58.37,Default,,0,0,0,,Профессор Какузава аурумен күресу үшін вакцина жасауда.
Dialogue: 0,0:05:58.84,0:06:00.73,Default,,0,0,0,,Have you ever heard of such a disease?
Dialogue: 0,0:06:01.36,0:06:03.60,Default,,0,0,0,,Бұл өте жұқпалы.
Dialogue: 0,0:06:04.36,0:06:06.97,Default,,0,0,0,,Мүйізі бар адамдар бірден оқшауланады.
Dialogue: 0,0:06:08.00,0:06:09.37,Default,,0,0,0,,Егер бұл орын алса
Dialogue: 0,0:06:10.48,0:06:11.64,Default,,0,0,0,,Не болады?
Dialogue: 0,0:06:15.00,0:06:15.97,Default,,0,0,0,,Бұл осында.
Dialogue: 0,0:06:31.00,0:06:32.65,Default,,0,0,0,,Әлі жоқ.
Dialogue: 0,0:06:36.52,0:06:38.05,Default,,0,0,0,,Мұғалім жоқ.
Dialogue: 0,0:06:38.60,0:06:40.41,Default,,0,0,0,,Бірақ электр жарығы қосулы.
Dialogue: 0,0:06:41.16,0:06:42.37,Default,,0,0,0,,Жаңа
Dialogue: 0,0:06:42.52,0:06:43.28,Default,,0,0,0,,Жаңа ма?
Dialogue: 0,0:06:43.52,0:06:44.73,Default,,0,0,0,,Бар ма?
Dialogue: 0,0:06:51.16,0:06:52.29,Default,,0,0,0,,Мұғалім?
Dialogue: 0,0:06:54.76,0:06:56.81,Default,,0,0,0,,Сіз қайда болдыңыз?
Dialogue: 0,0:07:00.92,0:07:02.41,Default,,0,0,0,,Бұл сегізаяқ бала қандай?
Dialogue: 0,0:07:03.52,0:07:06.13,Default,,0,0,0,,What else are you surprised about?
Dialogue: 0,0:07:06.40,0:07:08.00,Default,,0,0,0,,Біртүрлі дыбыстар шығармаңыз
Dialogue: 0,0:07:25.28,0:07:29.21,Default,,0,0,0,,Дұрыс, өлтірудің бұл жолы әлі де бар.
Dialogue: 0,0:07:31.84,0:07:33.08,Default,,0,0,0,,Сіз қашып кеткен сияқтысыз.
Dialogue: 0,0:07:33.44,0:07:35.52,Default,,0,0,0,,The professor has horns.
Dialogue: 0,0:07:35.84,0:07:37.97,Default,,0,0,0,,There's no way you'd know
Dialogue: 0,0:07:38.80,0:07:44.20,Default,,0,0,0,,Сіз бұрын меннен мүйізді адамдарды оқшауласақ, не істейтінімізді сұрадыңыз.
Dialogue: 0,0:07:45.32,0:07:45.92,Default,,0,0,0,,Иә
Dialogue: 0,0:07:47.48,0:07:49.56,Default,,0,0,0,,Isolate them and kill them.
Dialogue: 0,0:07:51.56,0:07:54.48,Default,,0,0,0,,Әйтпесе, сені осылай өлтіреді.
Dialogue: 0,0:07:55.36,0:07:58.44,Default,,0,0,0,,Неліктен, неге мұғалімнің мүйізі бар?
Dialogue: 0,0:07:58.48,0:07:59.72,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:08:02.00,0:08:04.00,Default,,0,0,0,,Жаңа емес
Dialogue: 0,0:08:08.84,0:08:12.97,Default,,0,0,0,,Сен үйге бара бер, қалғанын мен істеймін.
Dialogue: 0,0:08:14.00,0:08:16.24,Default,,0,0,0,,Оқушыларды жұмысқа тарту да қиын.
Dialogue: 0,0:08:17.36,0:08:18.33,Default,,0,0,0,,Үйге қайт
Dialogue: 0,0:08:19.60,0:08:20.20,Default,,0,0,0,,Иә
Dialogue: 0,0:08:21.60,0:08:25.65,Default,,0,0,0,,Эй, маған бұл туралы айтпа, жарай ма?
Dialogue: 0,0:08:28.24,0:08:29.89,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:08:30.96,0:08:34.04,Default,,0,0,0,,Ал, мен бұл шок екенін білемін.
Dialogue: 0,0:08:34.92,0:08:36.29,Default,,0,0,0,,Мынаны қараңыз
Dialogue: 0,0:08:37.04,0:08:39.33,Default,,0,0,0,,Мен ауырып қалсам не істеуім керек?
Dialogue: 0,0:08:41.44,0:08:44.81,Default,,0,0,0,,Біріншіден, бұл полиция емес, бірінші орында.
Dialogue: 0,0:08:49.32,0:08:50.56,Default,,0,0,0,,Қош келдің үйге.
Dialogue: 0,0:08:52.28,0:08:55.52,Default,,0,0,0,,Өйткені, профессор да, Ню-чан да жоқ.
Dialogue: 0,0:08:56.40,0:08:58.29,Default,,0,0,0,,Менің бір қыз мұғалімім болды.
Dialogue: 0,0:08:59.16,0:09:01.97,Default,,0,0,0,,Ертең мектепте Кадозава мырзадан сұраңыз.
Dialogue: 0,0:09:03.40,0:09:04.16,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:09:05.20,0:09:05.96,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:06.16,0:09:12.33,Default,,0,0,0,,Өйткені Кадозава мырза. . . Какузава мырза. . .
Dialogue: 0,0:09:13.20,0:09:14.25,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:09:17.84,0:09:20.61,Default,,0,0,0,,Сіз не айтқыңыз келді?
Dialogue: 0,0:09:22.60,0:09:24.25,Default,,0,0,0,,Сіз түсінуге мүмкіндік жоқ.
Dialogue: 0,0:09:25.36,0:09:27.57,Default,,0,0,0,,Кешіріңіз, мен бүгін ұйықтаймын.
Dialogue: 0,0:09:28.36,0:09:30.25,Default,,0,0,0,,Мен өзімді ауырып тұрмын.
Dialogue: 0,0:09:39.36,0:09:41.25,Default,,0,0,0,,Менің ұлым қайтыс болды.
Dialogue: 0,0:09:42.00,0:09:43.37,Default,,0,0,0,,Есеп алынды
Dialogue: 0,0:09:44.64,0:09:47.77,Default,,0,0,0,,Әдіске сүйенсек, бұл Люсидің жұмысы екеніне күмән жоқ.
Dialogue: 0,0:09:49.60,0:09:51.36,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:09:52.12,0:09:56.52,Default,,0,0,0,,Жетінші шайқастан бері жақын жерде ешкім күдікті түрде өлген жоқ.
Dialogue: 0,0:09:56.88,0:09:58.77,Default,,0,0,0,,Мен аяғымды таба алмадым
Dialogue: 0,0:09:59.60,0:10:03.61,Default,,0,0,0,,Гилперит саған қатты бауыр басып қалған деп естідім.
Dialogue: 0,0:10:04.52,0:10:06.12,Default,,0,0,0,,Диспозиция аяқталды
Dialogue: 0,0:10:06.36,0:10:10.92,Default,,0,0,0,,Мен ешқашан адамдарға векторды бағыттамағанмын.
Dialogue: 0,0:10:11.36,0:10:13.01,Default,,0,0,0,,7 саны да ерекшелік емес.
Dialogue: 0,0:10:13.64,0:10:16.29,Default,,0,0,0,,Тасымалдаушылардан туған Диклоний және т.б.
Dialogue: 0,0:10:16.80,0:10:21.25,Default,,0,0,0,,Оның көбею қабілеті жоқ және адамдарды өлтіретін қауіпті өлтіруші.
Dialogue: 0,0:10:22.64,0:10:25.12,Default,,0,0,0,,Зерттеу ауылынан басқа ештеңе жоқ
Dialogue: 0,0:10:26.76,0:10:28.57,Default,,0,0,0,,Мені қате түсінбе, Курама.
Dialogue: 0,0:10:29.56,0:10:30.56,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:35.04,0:10:35.93,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:10:38.52,0:10:39.65,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:10:42.80,0:10:46.93,Default,,0,0,0,,Өз ұлым өлсе де, жүзі мүлде өзгермеді.
Dialogue: 0,0:10:49.32,0:10:52.80,Default,,0,0,0,,Директор, мен сізден сұрайын деп едім.
Dialogue: 0,0:10:53.64,0:10:54.28,Default,,0,0,0,,Не?
Dialogue: 0,0:10:55.20,0:10:56.69,Default,,0,0,0,,Директордың отбасы туралы не айтасыз?
Dialogue: 0,0:11:05.52,0:11:07.28,Default,,0,0,0,,Қызым қайтыс болды
Dialogue: 0,0:11:10.60,0:11:11.80,Default,,0,0,0,,Дегенмен, 11 жасыңдағы кезіңмен салыстырғанда бетің біраз өзгерген болар
Dialogue: 0,0:11:12.84,0:11:14.28,Default,,0,0,0,,Өз қолыммен өлтірдім
Dialogue: 0,0:11:16.48,0:11:18.48,Default,,0,0,0,,Мұны көрген әйелі де өз-өзіне қол жұмсады.
Dialogue: 0,0:11:19.96,0:11:21.08,Default,,0,0,0,,Басқа сұрағыңыз келетін нәрсе бар ма?
Dialogue: 0,0:11:22.48,0:11:23.04,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:33.08,0:11:35.00,Default,,0,0,0,,Ню-чан, сен оны іздейсің бе?
Dialogue: 0,0:11:35.72,0:11:36.36,Default,,0,0,0,,Иә
Dialogue: 0,0:11:36.56,0:11:39.56,Default,,0,0,0,,Өйткені Ню-чан мұғалімге барды.
Dialogue: 0,0:11:39.88,0:11:41.88,Default,,0,0,0,,Ню сол жерден қашып кетті.
Dialogue: 0,0:11:42.56,0:11:43.48,Default,,0,0,0,,Сіз қайдан білесіз?
Dialogue: 0,0:11:45.76,0:11:46.36,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:11:47.72,0:11:48.76,Default,,0,0,0,,Бірақ мен солай сезінемін.
Dialogue: 0,0:11:52.12,0:11:52.96,Default,,0,0,0,,Осымен
Dialogue: 0,0:11:53.36,0:11:54.12,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:11:55.40,0:11:59.29,Default,,0,0,0,,Неге мен сенімен бірге Ню-чанды іздемеймін?
Dialogue: 0,0:12:00.12,0:12:02.52,Default,,0,0,0,,Иә, бірге барайық.
Dialogue: 0,0:12:02.88,0:12:05.40,Default,,0,0,0,,Шынымен бе? Мен сенімен бара аламын ба?
Dialogue: 0,0:12:06.16,0:12:07.16,Default,,0,0,0,,It's obvious
Dialogue: 0,0:12:08.36,0:12:11.40,Default,,0,0,0,,Ым, Ню-сан жоқ па?
Dialogue: 0,0:12:11.64,0:12:13.29,Default,,0,0,0,,Иә, бәрібір
Dialogue: 0,0:12:14.00,0:12:16.04,Default,,0,0,0,,Мен бұрын дұрыстап оралдым.
Dialogue: 0,0:12:16.40,0:12:18.24,Default,,0,0,0,,Уайымдамаңыз.
Dialogue: 0,0:12:18.64,0:12:20.36,Default,,0,0,0,,Иә, мен барамын.
Dialogue: 0,0:12:29.76,0:12:31.28,Default,,0,0,0,,Ах. . . Сол адам
Dialogue: 0,0:12:39.56,0:12:42.16,Default,,0,0,0,,Теңіз бұрынғыдай лас.
Dialogue: 0,0:12:43.56,0:12:45.80,Default,,0,0,0,,Әке шын мәнінде дәрігер емес
Dialogue: 0,0:12:46.64,0:12:47.88,Default,,0,0,0,,Сонда сіз қауіпсіз болдыңыз ба?
Dialogue: 0,0:12:49.44,0:12:52.20,Default,,0,0,0,,Сіз сол кездегі әйелсіз бе?
Dialogue: 0,0:12:54.56,0:12:56.44,Default,,0,0,0,,Эй, сен байсалдысың ба?
Dialogue: 0,0:12:57.32,0:13:00.32,Default,,0,0,0,,Мені осындай нәрсе құтқарды ма?
Dialogue: 0,0:13:01.92,0:13:05.32,Default,,0,0,0,,Сіздің жарақатыңыз жазылды ма? Мен қуаныштымын.
Dialogue: 0,0:13:05.80,0:13:08.20,Default,,0,0,0,,Бұл сіз білетін нәрсе ме?
Dialogue: 0,0:13:10.16,0:13:11.20,Default,,0,0,0,,Менің не істегенімді қалайсың?
Dialogue: 0,0:13:12.44,0:13:15.17,Default,,0,0,0,,Менде қарыз болмау саясаты бар.
Dialogue: 0,0:13:15.92,0:13:18.04,Default,,0,0,0,,Әсіресе осындай балаға.
Dialogue: 0,0:13:18.44,0:13:20.09,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:13:20.60,0:13:24.36,Default,,0,0,0,,Шуй, бұл сенің мәселең емес, менікі.
Dialogue: 0,0:13:28.96,0:13:29.60,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:13:31.80,0:13:34.12,Default,,0,0,0,,Бұл телефон нөмірі ме?
Dialogue: 0,0:13:34.36,0:13:35.44,Default,,0,0,0,,Байланыс ақпараты
Dialogue: 0,0:13:35.72,0:13:36.80,Default,,0,0,0,,Байланыс?
Dialogue: 0,0:13:37.44,0:13:39.32,Default,,0,0,0,,Қиын кезде маған қоңырау шалыңыз
Dialogue: 0,0:13:39.88,0:13:41.32,Default,,0,0,0,,Мен олардың бәрін өлтіремін
Dialogue: 0,0:13:42.24,0:13:44.76,Default,,0,0,0,,Тыңдаңыз, қарыз немесе несие жоқ.
Dialogue: 0,0:13:46.00,0:13:46.56,Default,,0,0,0,,Иә
Dialogue: 0,0:13:48.76,0:13:49.56,Default,,0,0,0,,Осы үшін оны мектептен шығарып жіберсе жақсы болар еді.
Dialogue: 0,0:13:50.76,0:13:52.20,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:13:52.76,0:13:55.88,Default,,0,0,0,,Мына жерде мүйізді әйел бар ма?
Dialogue: 0,0:13:56.52,0:13:58.12,Default,,0,0,0,,Ню-сан дейсің бе?
Dialogue: 0,0:14:05.40,0:14:06.12,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:14:08.64,0:14:10.16,Default,,0,0,0,,Butt muddy
Dialogue: 0,0:14:10.76,0:14:12.52,Default,,0,0,0,,Кенет жаңбыр жауды.
Dialogue: 0,0:14:13.60,0:14:15.17,Default,,0,0,0,,Жаңбырдан мына жерде пана алайық.
Dialogue: 0,0:14:33.80,0:14:35.76,Default,,0,0,0,,Біраз уақытқа тоқтамайтын сияқты.
Dialogue: 0,0:14:40.00,0:14:40.76,Default,,0,0,0,,Салқындап қалдыңыз ба?
Dialogue: 0,0:14:41.56,0:14:42.44,Default,,0,0,0,,Жарайды
Dialogue: 0,0:14:42.80,0:14:44.24,Default,,0,0,0,,Сіз дірілдеп жатқан болуыңыз керек
Dialogue: 0,0:14:44.56,0:14:45.92,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:14:52.04,0:14:54.04,Default,,0,0,0,,Бұл оны сәл жылытады.
Dialogue: 0,0:14:55.08,0:14:58.08,Default,,0,0,0,,Бірақ бөкселеріңе лай түседі.
Dialogue: 0,0:14:59.68,0:15:01.09,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:15:19.40,0:15:20.16,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:15:21.20,0:15:22.92,Default,,0,0,0,,Na. . . Кез келген нәрсе
Dialogue: 0,0:15:29.08,0:15:30.60,Default,,0,0,0,,Сәлем Кота
Dialogue: 0,0:15:33.36,0:15:36.36,Default,,0,0,0,,Мен саған ұнайсың ба?
Dialogue: 0,0:15:40.36,0:15:41.96,Default,,0,0,0,,Мен сізден дәл қазір не сұрамадым
Dialogue: 0,0:15:42.84,0:15:45.57,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:15:46.36,0:15:51.36,Default,,0,0,0,,Соңғы рет Юкамен қашан ойнағаным есімде жоқ.
Dialogue: 0,0:15:52.00,0:15:52.88,Default,,0,0,0,,Кота
Dialogue: 0,0:15:53.88,0:15:58.88,Default,,0,0,0,,Бірақ мен Юканы жақсы көрдім және әлі де сүйемін.
Dialogue: 0,0:16:12.00,0:16:13.84,Default,,0,0,0,,Ойды оқи алатын экстрасенс
Dialogue: 0,0:16:14.00,0:16:16.36,Default,,0,0,0,,Айтыңызшы, ол қайда?
Dialogue: 0,0:16:16.96,0:16:21.88,Default,,0,0,0,,Мен оны өлтіру үшін осында қайтып келдім.
Dialogue: 0,0:16:22.40,0:16:25.52,Default,,0,0,0,,Маған шындықты айтпасаң, мен де сені өлтіремін.
Dialogue: 0,0:16:26.00,0:16:27.65,Default,,0,0,0,,Уау. . . Мен түсінбеймін
Dialogue: 0,0:16:27.88,0:16:30.88,Default,,0,0,0,,Менің ағам мектепте осындай адамды көрді.
Dialogue: 0,0:16:32.80,0:16:36.69,Default,,0,0,0,,Сіз шынымен мені кездейсоқ нәрселермен алдай аласыз деп ойлайсыз ба?
Dialogue: 0,0:16:37.80,0:16:40.00,Default,,0,0,0,,«Нюу-сан» деп бұрын айтпадың ба?
Dialogue: 0,0:16:40.28,0:16:43.56,Default,,0,0,0,,Қыздарға аямаймын.
Dialogue: 0,0:16:44.44,0:16:45.28,Default,,0,0,0,,Еліктеудің қандай түрі?
Dialogue: 0,0:16:45.88,0:16:49.80,Default,,0,0,0,,Мен қазір қатты қысылып тұрмын, көмектесіңізші.
Dialogue: 0,0:16:50.16,0:16:54.76,Default,,0,0,0,,Маған міндетті түрде көмектесемін деп бұрын айтпадың ба?
Dialogue: 0,0:16:55.04,0:16:58.04,Default,,0,0,0,,Өтірік болды ма? Ол еркек.
Dialogue: 0,0:17:01.08,0:17:04.20,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:17:06.12,0:17:07.88,Default,,0,0,0,,Бұл бетті енді ешқашан көрсетпеңіз.
Dialogue: 0,0:17:11.64,0:17:14.88,Default,,0,0,0,,Неліктен Ню-сан?
Dialogue: 0,0:17:23.80,0:17:26.00,Default,,0,0,0,,Ұмытқан кезде жек көремін.
Dialogue: 0,0:17:28.12,0:17:31.04,Default,,0,0,0,,Бөлінгенді одан сайын жек көремін.
Dialogue: 0,0:17:32.16,0:17:34.81,Default,,0,0,0,,Мен Котаның жеке заттарымен жақсымын.
Dialogue: 0,0:17:35.16,0:17:37.81,Default,,0,0,0,,Сондықтан мен әрқашан сенің жаныңда боламын
Dialogue: 0,0:17:58.28,0:18:00.08,Default,,0,0,0,,Ол бұрын көтерілген.
Dialogue: 0,0:18:00.96,0:18:02.04,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:18:05.08,0:18:05.72,Default,,0,0,0,,Юка!
Dialogue: 0,0:18:10.16,0:18:11.68,Default,,0,0,0,,. . жолақтар
Dialogue: 0,0:18:13.36,0:18:14.72,Default,,0,0,0,,Жоқ, бұл
Dialogue: 0,0:18:16.56,0:18:18.08,Default,,0,0,0,,. . . неге
Dialogue: 0,0:18:23.56,0:18:26.08,Default,,0,0,0,,Мен шалшықта тайып кеткенімде солай болды.
Dialogue: 0,0:18:26.08,0:18:27.00,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:18:27.24,0:18:28.48,Default,,0,0,0,,Пыс, пыс… Э?
Dialogue: 0,0:18:30.36,0:18:32.84,Default,,0,0,0,,Қараңдаршы, жаңбырдан дымқыл, сондықтан мен тайып тұрмын.
Dialogue: 0,0:18:33.12,0:18:34.61,Default,,0,0,0,,Ә? Жоқ, мен ештеңе істеген жоқпын…
Dialogue: 0,0:18:35.12,0:18:36.88,Default,,0,0,0,,Енді қайда қарауым керек?
Dialogue: 0,0:18:37.20,0:18:39.72,Default,,0,0,0,,Вокзалдағы сияқты ма?
Dialogue: 0,0:18:41.08,0:18:45.21,Default,,0,0,0,,Ол қайда және не істеп жатыр? Мен қатты уайымдап тұрмын.
Dialogue: 0,0:18:50.64,0:18:52.00,Default,,0,0,0,,Оны қазірдің өзінде тоқтатыңыз.
Dialogue: 0,0:18:57.64,0:18:58.28,Default,,0,0,0,,Жаңа
Dialogue: 0,0:19:00.48,0:19:01.28,Default,,0,0,0,,Жаңа
Dialogue: 0,0:19:02.60,0:19:04.48,Default,,0,0,0,,Сіз қайда болдыңыз?
Dialogue: 0,0:19:06.76,0:19:09.28,Default,,0,0,0,,Түсіндім, сұрасаң да сөйлей алмайсың.
Dialogue: 0,0:19:11.28,0:19:12.36,Default,,0,0,0,,Егер ол белгілі бір дәрежеде бар күшін салмайтын болса—
Dialogue: 0,0:19:12.92,0:19:15.28,Default,,0,0,0,,Бұл сөзді қайдан үйрендің?
Dialogue: 0,0:19:15.88,0:19:17.92,Default,,0,0,0,,Бұл жерде оғаш ештеңе жоқ шығар.
Dialogue: 0,0:19:20.36,0:19:20.92,Default,,0,0,0,,Юка!
Dialogue: 0,0:19:22.40,0:19:24.00,Default,,0,0,0,,Сол себепті сырғып жатыр.
Dialogue: 0,0:19:24.92,0:19:28.28,Default,,0,0,0,,Жоқ, мені кенет бірдеңе басып қалды.
Dialogue: 0,0:19:28.40,0:19:33.80,Default,,0,0,0,,Бұл не? Эй, эй, жылама. Сен маған күлесің.
Dialogue: 0,0:19:37.16,0:19:38.12,Default,,0,0,0,,Кота
Dialogue: 0,0:19:41.76,0:19:42.80,Default,,0,0,0,,Қайда барасың?
Dialogue: 0,0:19:43.00,0:19:45.76,Default,,0,0,0,,Үйге бара жатып, бәрі есіме түсті.
Dialogue: 0,0:19:46.20,0:19:47.56,Default,,0,0,0,,Сіздің жадыңыз қалпына келді ме?
Dialogue: 0,0:19:48.68,0:19:50.33,Default,,0,0,0,,Сол үшін қоштастым
Dialogue: 0,0:19:50.76,0:19:53.76,Default,,0,0,0,,Ақымақ болма, қайтып барар жер жоқ.
Dialogue: 0,0:19:56.32,0:20:02.44,Default,,0,0,0,,Сіз өзіңіздің орыныңызды жасай аласыз. Оның саған қатысы жоқ.
Dialogue: 0,0:20:05.52,0:20:08.96,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Kaede Manor - сіздің орныңыз.
Dialogue: 0,0:20:11.20,0:20:12.08,Default,,0,0,0,,Кота
Dialogue: 0,0:20:14.92,0:20:16.36,Default,,0,0,0,,Ештеңе емес. . .
Dialogue: 0,0:20:19.36,0:20:20.08,Default,,0,0,0,,Мен
Dialogue: 0,0:20:23.20,0:20:25.68,Default,,0,0,0,,Мен сенімен бірге болуға лайық емеспін.
Dialogue: 0,0:20:26.20,0:20:27.04,Default,,0,0,0,,Біліктілік?
Dialogue: 0,0:20:28.60,0:20:29.60,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:20:30.24,0:20:32.68,Default,,0,0,0,,Ню-чан, сен жылап тұрсың ба?
Dialogue: 0,0:20:33.72,0:20:38.24,Default,,0,0,0,,Өйткені сегіз жыл бұрын мен Котамен таныстым.
Dialogue: 0,0:20:40.72,0:20:42.48,Default,,0,0,0,,Екеуің не туралы айтып тұрсыңдар?
Dialogue: 0,0:20:45.88,0:20:48.88,Default,,0,0,0,,Жаңа Кота Кота
Dialogue: 0,0:20:50.00,0:20:52.65,Default,,0,0,0,,Менің ойымша, ол бастапқы күйіне оралды.
Dialogue: 0,0:20:53.00,0:20:54.36,Default,,0,0,0,,ұқсайды
Dialogue: 0,0:20:54.52,0:20:55.32,Default,,0,0,0,,Құшақтау
Dialogue: 0,0:20:56.08,0:20:57.49,Default,,0,0,0,,Кота
Dialogue: 0,0:21:00.12,0:21:03.28,Default,,0,0,0,,Жақсы, мен сені бүгін сағынуға рұқсат етемін.
Dialogue: 0,0:21:19.40,0:21:20.40,Default,,0,0,0,,Кота
Dialogue: 0,0:21:21.04,0:21:23.93,Default,,0,0,0,,Жарайды, мен әрқашан жаныңда боламын.
Dialogue: 0,0:21:24.80,0:21:27.04,Default,,0,0,0,,Үйімізге алысқа қайтайық
Dialogue: 0,0:21:32.00,0:21:34.00,Default,,0,0,0,,Сіз мұны қанша уақыттан бері істеп жүрсіз?
Dialogue: 0,0:21:34.16,0:21:36.36,Default,,0,0,0,,Жақсы деп айтсам да.
Dialogue: 0,0:21:36.36,0:21:38.44,Default,,0,0,0,,Жарайды, кет.
Dialogue: 0,0:21:53.08,0:21:54.16,Default,,0,0,0,,Мұнда қайда?
Dialogue: 0,0:21:54.80,0:21:55.32,Default,,0,0,0,,Нана
Dialogue: 0,0:21:55.56,0:21:56.44,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:21:56.80,0:21:59.56,Default,,0,0,0,,Директор маған сені өлтіруді бұйырды.
Dialogue: 0,0:22:00.44,0:22:04.16,Default,,0,0,0,,Бірақ мен бұрылып қашамын
Dialogue: 0,0:22:05.64,0:22:07.84,Default,,0,0,0,,Сол мүшелерді қозғалта білу керек.
Dialogue: 0,0:22:13.44,0:22:16.17,Default,,0,0,0,,Багтың біраз уақыт өмір сүруге жеткілікті ақшасы бар.
Dialogue: 0,0:22:17.32,0:22:20.84,Default,,0,0,0,,Мүмкіндігінше алыс қашып, тыныш өмір сүріңіз.
Dialogue: 0,0:22:24.36,0:22:25.56,Default,,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:22:26.44,0:22:29.36,Default,,0,0,0,,Жақсы қыз болсаң мен сені міндетті түрде алып кетемін.
Dialogue: 0,0:22:30.48,0:22:32.96,Default,,0,0,0,,Мен қанша жылдан кейін екенін білмеймін, бірақ мен сенімдімін
Dialogue: 0,0:22:34.08,0:22:36.20,Default,,0,0,0,,Оған дейін сау болыңыз.
Dialogue: 0,0:22:42.44,0:22:44.44,Default,,0,0,0,,Идиот әкемнің ақымақ
Dialogue: 0,0:22:44.72,0:22:46.96,Default,,0,0,0,,Осылай жасасаң, менің әкем боласың.
Dialogue: 0,0:22:47.56,0:22:51.77,Default,,0,0,0,,Әй, сенің басыңда не өсіп тұр?
Dialogue: 0,0:22:55.00,0:22:57.44,Default,,0,0,0,,Бұл өзгеріске байланысты. Бұл жеткіліксіз.
Dialogue: 0,0:24:33.60,0:24:35.09,Default,,0,0,0,,Өз болмысыңның құндылығын жоғалт
Dialogue: 0,0:24:35.56,0:24:36.72,Default,,0,0,0,,Өмірдің де мәні
Dialogue: 0,0:24:36.92,0:24:38.49,Default,,0,0,0,,Қалай өмір сүретінін білмей
Dialogue: 0,0:24:38.84,0:24:41.49,Default,,0,0,0,,Айналаңдап жүрген кішкентай жан
Dialogue: 0,0:24:42.60,0:24:44.01,Default,,0,0,0,,Тіпті адамдармен кездесу
Dialogue: 0,0:24:44.20,0:24:47.56,Default,,0,0,0,,Бұл бір-бірінің денесін жаралаудың бір жолы болды.
Dialogue: 0,0:24:48.88,0:24:50.96,Default,,0,0,0,,Сүртуге болмайтын қан мен жас арқылы
Dialogue: 0,0:24:51.48,0:24:53.76,Default,,0,0,0,,Қыз жануарға айналады
Dialogue: 0,0:24:55.08,0:24:57.32,Default,,0,0,0,,Келесі жолы Эльфен өтірік айтты 7-бөлім
Dialogue: 0,0:24:57.76,0:24:58.76,Default,,0,0,0,,Жиналыс
Dialogue: 0,0:25:00.26,0:25:06.26,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory