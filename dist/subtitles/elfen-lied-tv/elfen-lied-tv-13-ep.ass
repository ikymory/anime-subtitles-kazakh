Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.77,0:00:18.16,Default,,0,0,0,,Os iusti meditabitur sapientiam,
Dialogue: 0,0:00:18.16,0:00:27.29,Default,,0,0,0,,Et lingua eius loquetur indicium.
Dialogue: 0,0:00:27.29,0:00:38.55,Default,,0,0,0,,Beatus vir qui азап шегеді,
Dialogue: 0,0:00:38.55,0:00:49.15,Default,,0,0,0,,Quoniqm cum probaes fuerit accipient coronam vitae.
Dialogue: 0,0:00:49.15,0:01:02.24,Default,,0,0,0,,Кири, ignis divine, eleison.
Dialogue: 0,0:01:02.62,0:01:13.71,Default,,0,0,0,,О quam sancta, quam serena,
Dialogue: 0,0:01:13.71,0:01:28.31,Default,,0,0,0,,Куам-беигма, квам амоена,
Dialogue: 0,0:01:46.48,0:01:47.24,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:01:47.72,0:01:49.25,Default,,0,0,0,,Бұл әке, бұл әке
Dialogue: 0,0:01:50.56,0:01:52.61,Default,,0,0,0,,Бұл жерде жақсы Сіз оны дыбысынан байқауға болады
Dialogue: 0,0:01:57.96,0:01:58.85,Default,,0,0,0,,Нана
Dialogue: 0,0:02:00.12,0:02:02.25,Default,,0,0,0,,Сәл кешігіп келсеңіз
Dialogue: 0,0:02:04.60,0:02:06.73,Default,,0,0,0,,Мен саған алыс жерде тұр дедім.
Dialogue: 0,0:02:08.16,0:02:09.69,Default,,0,0,0,,Мм, бұл. . .
Dialogue: 0,0:02:10.28,0:02:13.52,Default,,0,0,0,,Оның үстіне әке неге мұнда?
Dialogue: 0,0:02:17.52,0:02:18.68,Default,,0,0,0,,Қ–… Сен, порноман!
Dialogue: 0,0:02:19.28,0:02:22.44,Default,,0,0,0,,Сен менің олжамсың.
Dialogue: 0,0:02:23.56,0:02:27.45,Default,,0,0,0,,Мен оны міндетті түрде өз қолыммен аяқтаймын.
Dialogue: 0,0:02:27.92,0:02:29.16,Default,,0,0,0,,Сырттан қараған адамға бұл қызғаныштың өзі сияқты көрінуі тиіс.
Dialogue: 0,0:02:29.16,0:02:29.97,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:02:33.04,0:02:35.85,Default,,0,0,0,,Сіз мені енді ешқашан көрмейсіз
Dialogue: 0,0:02:43.16,0:02:45.29,Default,,0,0,0,,Күтіңіз, күтіңіз.
Dialogue: 0,0:02:55.20,0:02:57.60,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:02:59.48,0:03:00.24,Default,,0,0,0,,Денеңде осындай жарақаттармен қаза таптың, иә?
Dialogue: 0,0:03:00.48,0:03:01.08,Default,,0,0,0,,Иә
Dialogue: 0,0:03:02.04,0:03:08.61,Default,,0,0,0,,Котаның әкесі мен сіңлісі Канае өлтірілді.
Dialogue: 0,0:03:10.00,0:03:11.45,Default,,0,0,0,,Котаның алдында
Dialogue: 0,0:03:14.36,0:03:18.57,Default,,0,0,0,,Бұл бастапқы мәселе болды және Кота бір жылға жуық ауруханада жатты.
Dialogue: 0,0:03:20.48,0:03:22.61,Default,,0,0,0,,Ол кезде біз әлі бала едік.
Dialogue: 0,0:03:24.88,0:03:27.01,Default,,0,0,0,,Мен мұның бәрін кейін естідім.
Dialogue: 0,0:03:27.24,0:03:28.65,Default,,0,0,0,,. . Кінәлі
Dialogue: 0,0:03:31.00,0:03:33.00,Default,,0,0,0,,Басқа да көптеген құрбандар бар.
Dialogue: 0,0:03:34.00,0:03:36.13,Default,,0,0,0,,Полиция ұзақ уақыт бойы тергеу жүргізді.
Dialogue: 0,0:03:38.64,0:03:41.25,Default,,0,0,0,,Мен Кота-санмен мұндай оқиға болғанына сене алар емеспін.
Dialogue: 0,0:03:41.76,0:03:45.53,Default,,0,0,0,,Кота Ол кез туралы ештеңе есіңде жоқ сияқты.
Dialogue: 0,0:03:47.64,0:03:49.88,Default,,0,0,0,,Маю-чанның әңгімесін тыңдадым.
Dialogue: 0,0:03:51.04,0:03:55.76,Default,,0,0,0,,Ол басқа қыздарға мейірімді ме деп ойлаймын, себебі оның басынан осындай жағдай болған.
Dialogue: 0,0:03:56.92,0:04:00.24,Default,,0,0,0,,Котаға бәрі Канаэ-чан сияқты.
Dialogue: 0,0:04:02.52,0:04:03.41,Default,,0,0,0,,Бірақ мен
Dialogue: 0,0:04:05.04,0:04:07.17,Default,,0,0,0,,Мен әрқашан якимочиді рұқсатсыз гриль жасаймын.
Dialogue: 0,0:04:07.92,0:04:10.13,Default,,0,0,0,,Әр кезде ашуланып, жылайтынмын.
Dialogue: 0,0:04:11.92,0:04:15.29,Default,,0,0,0,,Мен керемет ана емеспін.
Dialogue: 0,0:04:17.12,0:04:18.01,Default,,0,0,0,,Юка-сан
Dialogue: 0,0:04:21.52,0:04:25.84,Default,,0,0,0,,Юка-сан шынымен Кота-санды ұнатады, солай ма?
Dialogue: 0,0:04:31.36,0:04:33.17,Default,,0,0,0,,Ширакаваны Люси жеңді
Dialogue: 0,0:04:34.84,0:04:38.29,Default,,0,0,0,,Иә, неге пайда болды?
Dialogue: 0,0:04:39.16,0:04:40.65,Default,,0,0,0,,Мен үшін де солай. . .
Dialogue: 0,0:04:41.28,0:04:47.05,Default,,0,0,0,,-ден кейін мен неге екенін білмеймін, бірақ 35 саны векторды енді шығару мүмкін емес.
Dialogue: 0,0:04:47.48,0:04:49.48,Default,,0,0,0,,Операция толығымен сәтсіздікке ұшырады.
Dialogue: 0,0:04:51.28,0:04:52.65,Default,,0,0,0,,Бірақ басқа да нұсқалар бар. . .
Dialogue: 0,0:04:52.92,0:04:57.93,Default,,0,0,0,,Вектор пайда болмаса да, 35 санының әлі де қолданысы болуы керек.
Dialogue: 0,0:04:58.88,0:05:00.64,Default,,0,0,0,,Тіпті саған автограф қойып, қолыңды да қысып қояйын
Dialogue: 0,0:05:03.44,0:05:06.65,Default,,0,0,0,,Мүмкін ол адам адам емес шығар.
Dialogue: 0,0:05:07.92,0:05:11.89,Default,,0,0,0,,Мен мұндай құбыжықты Құрама бастықтың қызы болады деп күтпедім.
Dialogue: 0,0:05:14.44,0:05:15.77,Default,,0,0,0,,Ол себеп пен салдарға байланысты.
Dialogue: 0,0:05:25.72,0:05:29.09,Default,,0,0,0,,Сақтықты түсірме, қандай жағдай болса да, тартынба.
Dialogue: 0,0:05:30.08,0:05:30.60,Default,,0,0,0,,Иә
Dialogue: 0,0:05:31.96,0:05:33.09,Default,,0,0,0,,Курама
Dialogue: 0,0:05:34.44,0:05:36.20,Default,,0,0,0,,Мен бар екеніне сенімдімін, Нана.
Dialogue: 0,0:05:36.72,0:05:39.17,Default,,0,0,0,,Иә, мен ояумын.
Dialogue: 0,0:05:39.96,0:05:41.04,Default,,0,0,0,,Бірақ неге?
Dialogue: 0,0:05:41.48,0:05:44.09,Default,,0,0,0,,Неліктен әкем бұл баланы өлтіруге мәжбүр болды?
Dialogue: 0,0:05:45.16,0:05:46.61,Default,,0,0,0,,Өйткені ол менің нағыз қызым
Dialogue: 0,0:05:46.84,0:05:48.73,Default,,0,0,0,,Мен мұны түсінбеймін.
Dialogue: 0,0:05:50.36,0:05:50.85,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:51.44,0:05:52.60,Default,,0,0,0,,Бұл Люси.
Dialogue: 0,0:05:52.84,0:05:54.84,Default,,0,0,0,,Люси де жақындап келеді.
Dialogue: 0,0:05:55.60,0:05:56.60,Default,,0,0,0,,Люси
Dialogue: 0,0:06:03.60,0:06:04.60,Default,,0,0,0,,Мен байқадым.
Dialogue: 0,0:06:06.00,0:06:08.08,Default,,0,0,0,,Мені өлтіргім келеді
Dialogue: 0,0:06:34.24,0:06:35.89,Default,,0,0,0,,Емделген сияқты
Dialogue: 0,0:06:36.60,0:06:40.37,Default,,0,0,0,,Мен оны қолданып көрдім, ол менің қолыммен жақсы шықты.
Dialogue: 0,0:06:42.88,0:06:45.01,Default,,0,0,0,,Люси осы жолмен келе жатыр.
Dialogue: 0,0:07:00.04,0:07:03.17,Default,,0,0,0,,Күшейтуге тағы 30 минут кетеді.
Dialogue: 0,0:07:03.80,0:07:06.12,Default,,0,0,0,,Құбыжықтар бір-бірімен жай ғана араласуы керек.
Dialogue: 0,0:07:07.04,0:07:08.33,Default,,0,0,0,,Енді құрбандық шалмайды
Dialogue: 0,0:07:08.68,0:07:09.76,Default,,0,0,0,,Төтенше жағдайда
Dialogue: 0,0:07:25.68,0:07:26.68,Default,,0,0,0,,​​Неге келдің?
Dialogue: 0,0:07:27.96,0:07:30.85,Default,,0,0,0,,Әу бастан нысана мен болсам керек.
Dialogue: 0,0:07:32.08,0:07:34.08,Default,,0,0,0,,Үлкен апа сенімге толы.
Dialogue: 0,0:07:35.08,0:07:37.73,Default,,0,0,0,,Мен енді ешкімді тартқым келмейді.
Dialogue: 0,0:07:56.24,0:07:57.48,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:19.36,0:08:22.25,Default,,0,0,0,,Енді мен сені мына тозақтан тез арада босатамын.
Dialogue: 0,0:08:30.76,0:08:33.92,Default,,0,0,0,,Өлтіру? Әпкең мені іздеп жүр ме?
Dialogue: 0,0:08:34.88,0:08:36.69,Default,,0,0,0,,Бұл қалжың ба, әлде бір нәрсе ме, білмеймін.
Dialogue: 0,0:08:37.52,0:08:39.76,Default,,0,0,0,,Мені ешкім өлтіре алмайды
Dialogue: 0,0:09:05.08,0:09:07.73,Default,,0,0,0,,Сіз жеңдіңіз. Енді Люсиді ұстауға болады.
Dialogue: 0,0:09:13.36,0:09:16.84,Default,,0,0,0,,Мен мұны істедім. Енді менің орным сенімді.
Dialogue: 0,0:09:17.32,0:09:18.21,Default,,0,0,0,,Осыдан кейін. . .
Dialogue: 0,0:09:22.12,0:09:25.00,Default,,0,0,0,,Бұл бәрі қорқатын Люси.
Dialogue: 0,0:09:25.00,0:09:25.01,Default,,0,0,0,,Марико
Dialogue: 0,0:09:25.01,0:09:25.84,Default,,0,0,0,,Марико
Dialogue: 0,0:09:28.48,0:09:29.13,Default,,0,0,0,,Аристократтар академиясына сұхбат
Dialogue: 0,0:09:36.60,0:09:38.09,Default,,0,0,0,,. . Бастық Курама
Dialogue: 0,0:09:38.76,0:09:39.49,Default,,0,0,0,,Курама
Dialogue: 0,0:09:41.96,0:09:42.77,Default,,0,0,0,,Әке?
Dialogue: 0,0:09:43.88,0:09:44.77,Default,,0,0,0,,Марико?
Dialogue: 0,0:09:46.84,0:09:47.84,Default,,0,0,0,,Әкем
Dialogue: 0,0:09:58.40,0:10:01.17,Default,,0,0,0,,Әке, мен Марикомен танысқым келді.
Dialogue: 0,0:10:11.24,0:10:12.37,Default,,0,0,0,,Әкем
Dialogue: 0,0:10:30.16,0:10:34.77,Default,,0,0,0,,Марико, мен оны көптен күттім.
Dialogue: 0,0:10:35.68,0:10:37.81,Default,,0,0,0,,Сол қараңғы бөлмеде
Dialogue: 0,0:10:40.64,0:10:49.56,Default,,0,0,0,,Мәңгі, мәңгі, бір күні әкем мен шешем мені алып кетуге келеді.
Dialogue: 0,0:10:50.44,0:10:54.68,Default,,0,0,0,,Мариконы бұл бөлмеден шығарыңыз.
Dialogue: 0,0:10:55.68,0:10:59.05,Default,,0,0,0,,Сонда үшеуміз бірге тұра аламыз.
Dialogue: 0,0:10:59.32,0:11:02.29,Default,,0,0,0,,Соған қарамастан, соған қарамастан
Dialogue: 0,0:11:03.52,0:11:05.33,Default,,0,0,0,,Ақыры кездескенімізге қарамастан
Dialogue: 0,0:11:05.68,0:11:08.45,Default,,0,0,0,,Әке әке
Dialogue: 0,0:11:09.16,0:11:11.85,Default,,0,0,0,,Әкем
Dialogue: 0,0:11:13.16,0:11:18.56,Default,,0,0,0,,Мен көп адамның баласын өлтірсем де,
Dialogue: 0,0:11:19.48,0:11:24.49,Default,,0,0,0,,Сен менің қызым болғаның үшін мен сені пайдалана бердім.
Dialogue: 0,0:11:25.80,0:11:28.96,Default,,0,0,0,,Бәріне менің кінәм.
Dialogue: 0,0:11:29.60,0:11:36.56,Default,,0,0,0,,Сонда Марико, сен осы уақытқа дейін не үшін өмір сүрдің?
Dialogue: 0,0:11:36.56,0:11:37.89,Default,,0,0,0,,Бұл қауіпті
Dialogue: 0,0:11:39.24,0:11:41.24,Default,,0,0,0,,Әке, қашу керек.
Dialogue: 0,0:11:41.56,0:11:47.49,Default,,0,0,0,,Әке? Неге, неге анау апа сізді әке деп атайды?
Dialogue: 0,0:11:48.36,0:11:51.01,Default,,0,0,0,,Мен Мариконы жалғыз қалдырдым
Dialogue: 0,0:11:51.20,0:11:52.25,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:11:58.00,0:12:00.40,Default,,0,0,0,,Әкем қашып кетті. . .
Dialogue: 0,0:12:01.52,0:12:02.76,Default,,0,0,0,,Сәлем, әке.
Dialogue: 0,0:12:04.48,0:12:06.64,Default,,0,0,0,,Үлкен апа өлсе, қайғырасың ба?
Dialogue: 0,0:12:09.12,0:12:12.01,Default,,0,0,0,,Жауап бере алмасаңыз, мен тырысамын.
Dialogue: 0,0:12:31.16,0:12:34.69,Default,,0,0,0,,Келме, Келме
Dialogue: 0,0:12:41.04,0:12:42.77,Default,,0,0,0,,Жылулық, махаббат
Dialogue: 0,0:12:44.44,0:12:46.81,Default,,0,0,0,,Бәрін алып кеткен менмін.
Dialogue: 0,0:12:49.44,0:12:50.17,Default,,0,0,0,,Марико
Dialogue: 0,0:12:51.92,0:12:57.05,Default,,0,0,0,,Мен сені бір сәтке де ұмытпадым.
Dialogue: 0,0:12:58.44,0:12:59.28,Default,,0,0,0,,Әкем
Dialogue: 0,0:13:00.20,0:13:02.28,Default,,0,0,0,,Марико, кешіріңіз.
Dialogue: 0,0:13:07.32,0:13:09.32,Default,,0,0,0,,Бұдан былай біз мәңгі бірге боламыз.
Dialogue: 0,0:13:10.04,0:13:11.09,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:13:11.56,0:13:12.40,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:13:13.56,0:13:14.56,Default,,0,0,0,,Кез келген уақытта
Dialogue: 0,0:13:14.72,0:13:15.96,Default,,0,0,0,,. . . бастық
Dialogue: 0,0:13:17.56,0:13:19.85,Default,,0,0,0,,Сіз әу бастан солай істеуді ойладыңыз ба?
Dialogue: 0,0:13:20.72,0:13:23.09,Default,,0,0,0,,Директормен қанша жыл жұмыс істеп келе жатырсыз деп ойлайсыз?
Dialogue: 0,0:13:23.96,0:13:25.96,Default,,0,0,0,,Ол кісі осылай ойлайтын.
Dialogue: 0,0:13:32.68,0:13:33.36,Default,,0,0,0,,Нана
Dialogue: 0,0:13:34.60,0:13:36.44,Default,,0,0,0,,Тек сен бақытты болуың керек
Dialogue: 0,0:13:38.08,0:13:38.84,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:13:40.44,0:13:41.44,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:14:01.24,0:14:03.85,Default,,0,0,0,,Бұйрықты орындамасаң, мен өлтіремін.
Dialogue: 0,0:14:05.28,0:14:07.28,Default,,0,0,0,,Өтінемін, бұл туралы ренжімеңіз.
Dialogue: 0,0:14:09.00,0:14:10.16,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:14:19.36,0:14:20.41,Default,,0,0,0,,Әкем
Dialogue: 0,0:14:22.00,0:14:22.89,Default,,0,0,0,,Марико
Dialogue: 0,0:14:23.76,0:14:28.13,Default,,0,0,0,,Мен сені кездестіргенімде осыны айтқым келген.
Dialogue: 0,0:14:29.40,0:14:34.57,Default,,0,0,0,,Анаң сені соңына дейін жақсы көрді.
Dialogue: 0,0:14:36.92,0:14:41.80,Default,,0,0,0,,Біз сені шын сүйдік
Dialogue: 0,0:15:21.92,0:15:26.37,Default,,0,0,0,,Маған бұл ұнамайды.
Dialogue: 0,0:15:27.72,0:15:29.05,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:15:36.84,0:15:40.21,Default,,0,0,0,,Енді сен ғана қалдың. Енді бұл менмін. .
Dialogue: 0,0:15:43.84,0:15:44.73,Default,,0,0,0,,Люси
Dialogue: 0,0:15:45.48,0:15:49.96,Default,,0,0,0,,Адамдар ақымақ
Dialogue: 0,0:15:50.12,0:15:54.21,Default,,0,0,0,,Ондай нәрсе жоқ. Әке - әке
Dialogue: 0,0:15:56.12,0:15:58.25,Default,,0,0,0,,Сол үйде Котамен бірге тұрыңыз.
Dialogue: 0,0:16:02.24,0:16:03.65,Default,,0,0,0,,Мен не істей алмаймын
Dialogue: 0,0:16:05.08,0:16:06.49,Default,,0,0,0,,Мен сенен қалаймын
Dialogue: 0,0:16:07.52,0:16:08.76,Default,,0,0,0,,Люси
Dialogue: 0,0:16:16.40,0:16:20.41,Default,,0,0,0,,Люсиді ұстау үшін SAT-тың толық күшін жұмылдырыңыз.
Dialogue: 0,0:16:21.16,0:16:23.37,Default,,0,0,0,,Тек мойын мен торсы қалуы керек
Dialogue: 0,0:16:25.04,0:16:26.72,Default,,0,0,0,,Өйткені, мен оны аяймын.
Dialogue: 0,0:16:27.16,0:16:29.61,Default,,0,0,0,,Толық жиынтыққа ие болу өзін-өзі жоюға бола ма?
Dialogue: 0,0:16:30.24,0:16:33.48,Default,,0,0,0,,Бұл. . . Жуынатын кез келді
Dialogue: 0,0:16:38.00,0:16:40.48,Default,,0,0,0,,Жоспарлау енді ғана басталды
Dialogue: 0,0:16:41.28,0:16:42.88,Default,,0,0,0,,Асықпаңыз
Dialogue: 0,0:16:59.92,0:17:00.92,Default,,0,0,0,,Жара
Dialogue: 0,0:17:01.80,0:17:03.33,Default,,0,0,0,,Үлкен мәселе емес
Dialogue: 0,0:17:07.92,0:17:11.72,Default,,0,0,0,,Бала кезімізде бірге ойнаған қыздар
Dialogue: 0,0:17:12.92,0:17:15.65,Default,,0,0,0,,Бұл да сен бе деп ойлаймын
Dialogue: 0,0:17:17.40,0:17:22.77,Default,,0,0,0,,Мен адамдарды жою үшін дүниеге келдім
Dialogue: 0,0:17:24.52,0:17:28.45,Default,,0,0,0,,5 жыл. 5 жыл.
Dialogue: 0,0:17:29.56,0:17:34.17,Default,,0,0,0,,Біз отбасымызда туылған балалардың көпшілігін жасай аламыз.
Dialogue: 0,0:17:35.92,0:17:37.89,Default,,0,0,0,,Бірақ дүние солай болып кетсе
Dialogue: 0,0:17:40.68,0:17:42.41,Default,,0,0,0,,Сен де тірі болмас едің.
Dialogue: 0,0:17:43.44,0:17:50.45,Default,,0,0,0,,Мына тозақта кенет менің алдымда Кота пайда болды.
Dialogue: 0,0:17:52.28,0:17:53.69,Default,,0,0,0,,Бұл өткінші арман
Dialogue: 0,0:17:55.80,0:18:00.20,Default,,0,0,0,,Тек сені кездестірген сол күндер
Dialogue: 0,0:18:01.68,0:18:02.44,Default,,0,0,0,,Менің. . .
Dialogue: 0,0:18:06.20,0:18:10.73,Default,,0,0,0,,Мен әрқашан Котадан кешірім сұрағым келді.
Dialogue: 0,0:18:12.36,0:18:13.57,Default,,0,0,0,,Мен жай ғана
Dialogue: 0,0:18:14.48,0:18:16.72,Default,,0,0,0,,Сол үшін мәңгі шыда
Dialogue: 0,0:18:17.84,0:18:18.92,Default,,0,0,0,,Аман қалды
Dialogue: 0,0:18:31.96,0:18:33.01,Default,,0,0,0,,18-ші эпизод: Венецияға!
Dialogue: 0,0:18:33.72,0:18:35.85,Default,,0,0,0,,Неге, мен сенің отбасыңнан айырылдым.
Dialogue: 0,0:18:35.84,0:18:36.84,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:18:38.88,0:18:43.89,Default,,0,0,0,,Мен сені Кана мен әкеңді өлтіргеніңді кешіре алмаймын.
Dialogue: 0,0:18:46.00,0:18:47.37,Default,,0,0,0,,Бірақ
Dialogue: 0,0:18:48.00,0:18:49.60,Default,,0,0,0,,Егер сіз әлі де біреуді ренжітсеңіз
Dialogue: 0,0:18:50.00,0:18:55.40,Default,,0,0,0,,Мен әлі де мәңгі өкінетініме сенімдімін.
Dialogue: 0,0:18:59.88,0:19:03.89,Default,,0,0,0,,Балаларымның қасында болсам да, Жалғыз қыз болсам да
Dialogue: 0,0:19:05.00,0:19:08.40,Default,,0,0,0,,Өйткені мен де сені жақсы көремін
Dialogue: 0,0:19:09.04,0:19:09.85,Default,,0,0,0,,Кота
Dialogue: 0,0:20:19.80,0:20:21.37,Default,,0,0,0,,Барлығын ұмыт
Dialogue: 0,0:20:22.60,0:20:25.25,Default,,0,0,0,,Мен жай ғана Котаның қасында болғым келді.
Dialogue: 0,0:20:26.24,0:20:27.13,Default,,0,0,0,,Жаңа
Dialogue: 0,0:20:28.24,0:20:32.25,Default,,0,0,0,,Мені көп мұңды ойлар тудырды.
Dialogue: 0,0:20:33.48,0:20:34.32,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:37.00,0:20:37.89,Default,,0,0,0,,Тіпті сен де
Dialogue: 0,0:20:40.84,0:20:41.89,Default,,0,0,0,,Тіпті сіз
Dialogue: 0,0:20:43.60,0:20:47.76,Default,,0,0,0,,Сізде көптеген қайғылы сезімдер болды, солай емес пе?
Dialogue: 0,0:21:26.12,0:21:27.12,Default,,0,0,0,,Мен үйге баруым керек
Dialogue: 0,0:21:28.40,0:21:29.53,Default,,0,0,0,,Мен үйге баруым керек
Dialogue: 0,0:21:31.00,0:21:32.24,Default,,0,0,0,,Мен үйге баруым керек
Dialogue: 0,0:21:32.48,0:21:33.05,Default,,0,0,0,,Тұрыс
Dialogue: 0,0:21:39.88,0:21:43.81,Default,,0,0,0,,Мен әркімнің үйіне баруым керек.
Dialogue: 0,0:21:48.56,0:21:49.56,Default,,0,0,0,,Түсіру
Dialogue: 0,0:22:07.80,0:22:11.85,Default,,0,0,0,,Бұл мен оны ұзақ уақыт бойы тазаламағандықтан орын алды.
Dialogue: 0,0:22:12.16,0:22:13.97,Default,,0,0,0,,Егер сіз асықпасаңыз, түскі асты өткізіп жіберуге тура келеді.
Dialogue: 0,0:22:13.96,0:22:15.56,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:22:22.68,0:22:23.49,Default,,0,0,0,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:22:23.72,0:22:24.96,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:22:29.08,0:22:31.45,Default,,0,0,0,,Нана-сан, шеберлігің жақсарды.
Dialogue: 0,0:22:31.44,0:22:34.36,Default,,0,0,0,,Маған ұнамайды. Бұл винерді гриль жасау сияқты.
Dialogue: 0,0:22:34.68,0:22:36.84,Default,,0,0,0,,Өйткені ол көмірге айналмаған.
Dialogue: 0,0:22:36.84,0:22:38.37,Default,,0,0,0,,Орташа
Dialogue: 0,0:22:48.88,0:22:52.49,Default,,0,0,0,,Юка, сенде тағы бір тостаған бар.
Dialogue: 0,0:22:53.00,0:22:57.21,Default,,0,0,0,,Өйткені оның да жегісі келді.
Dialogue: 0,0:22:58.36,0:22:59.77,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:23:04.00,0:23:05.53,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,0:23:10.24,0:23:11.24,Default,,0,0,0,,Дәмді
Dialogue: 0,0:23:11.64,0:23:14.53,Default,,0,0,0,,Бұл менің бірінші рет сынап көруім.
Dialogue: 0,0:23:15.00,0:23:18.29,Default,,0,0,0,,Иә, мен соңғы рет тамақ ішпей қалдым.
Dialogue: 0,0:23:26.48,0:23:29.13,Default,,0,0,0,,Ғажайып дүниелер көп болса да
Dialogue: 0,0:23:31.68,0:23:33.36,Default,,0,0,0,,Көп
Dialogue: 0,0:23:39.00,0:23:39.89,Default,,0,0,0,,Нана-сан
Dialogue: 0,0:23:43.04,0:23:44.88,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:23:45.92,0:23:47.24,Default,,0,0,0,,тамақ ішейік
Dialogue: 0,0:23:47.24,0:23:47.25,Default,,0,0,0,,Саса Көп жемесең, үлкен болмайсың.
Dialogue: 0,0:23:47.25,0:23:50.88,Default,,0,0,0,,Саса Көп жемесең, үлкен болмайсың.
Dialogue: 0,0:23:54.56,0:23:56.32,Default,,0,0,0,,Бұл тұтынушы ма?
Dialogue: 0,0:23:56.76,0:23:57.52,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:24:22.16,0:24:25.72,Default,,0,0,0,,Бұл қозғалады.
Dialogue: 0,0:24:27.22,0:24:33.22,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory