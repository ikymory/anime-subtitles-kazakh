Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.77,0:00:18.16,Default,,0,0,0,,Os iusti meditabitur sapientiam,
Dialogue: 0,0:00:18.16,0:00:27.29,Default,,0,0,0,,Et lingua eius loquetur indicium.
Dialogue: 0,0:00:27.29,0:00:38.55,Default,,0,0,0,,Beatus vir qui азап шегеді,
Dialogue: 0,0:00:38.55,0:00:49.15,Default,,0,0,0,,Quoniqm cum probaes fuerit accipient coronam vitae.
Dialogue: 0,0:00:49.15,0:01:02.24,Default,,0,0,0,,Кири, ignis divine, eleison.
Dialogue: 0,0:01:02.62,0:01:13.71,Default,,0,0,0,,О quam sancta, quam serena,
Dialogue: 0,0:01:13.71,0:01:28.31,Default,,0,0,0,,Куам-беигма, квам амоена,
Dialogue: 0,0:01:57.48,0:01:59.48,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:03:14.80,0:03:18.60,Default,,0,0,0,,Кисараги-сан да қиналып жатыр. Chief Kurama's secretary
Dialogue: 0,0:03:19.36,0:03:21.36,Default,,0,0,0,,Не?
Dialogue: 0,0:03:21.36,0:03:23.49,Default,,0,0,0,,Оның көздері де қалыпты емес.
Dialogue: 0,0:03:23.88,0:03:25.12,Default,,0,0,0,,Жотаро, бұл сенің Стар Платинум.
Dialogue: 0,0:03:25.76,0:03:28.65,Default,,0,0,0,,Иә, сен мейірімді адамсың.
Dialogue: 0,0:03:29.32,0:03:32.64,Default,,0,0,0,,Бірақ мен көп көмектесе алмаймын.
Dialogue: 0,0:03:33.00,0:03:34.97,Default,,0,0,0,,Әрқашан сәтсіздікке ұшырайды
Dialogue: 0,0:03:36.08,0:03:38.73,Default,,0,0,0,,Бірақ Кисараги барын салып жатыр.
Dialogue: 0,0:03:39.40,0:03:41.52,Default,,0,0,0,,Төтенше жағдай дабылы берілді.
Dialogue: 0,0:03:41.64,0:03:44.84,Default,,0,0,0,,Close underground research block after 60 seconds
Dialogue: 0,0:03:45.16,0:03:47.00,Default,,0,0,0,,Қызметкерлер, дереу эвакуациялаңыз.
Dialogue: 0,0:03:47.48,0:03:48.28,Default,,0,0,0,,Repetition
Dialogue: 0,0:03:48.76,0:03:50.64,Default,,0,0,0,,Төтенше жағдай дабылы берілді.
Dialogue: 0,0:03:51.04,0:03:53.61,Default,,0,0,0,,Close underground research block after 60 seconds
Dialogue: 0,0:03:54.24,0:03:55.65,Default,,0,0,0,,Қызметкерлер дереу эвакуациялансын. . .
Dialogue: 0,0:04:02.80,0:04:03.76,Default,,0,0,0,,Дүрбелең емес!
Dialogue: 0,0:04:04.04,0:04:07.40,Default,,0,0,0,,Нұсқаулықта 2 метрден артық жерде тұрсаңыз, қауіп жоқ деп жазылған.
Dialogue: 0,0:04:08.28,0:04:10.88,Default,,0,0,0,,Сонымен қатар заттарды еденге түсірмеңіз.
Dialogue: 0,0:06:37.72,0:06:38.64,Default,,0,0,0,,Kisaragi
Dialogue: 0,0:06:39.04,0:06:40.04,Default,,0,0,0,,Chief Kurama
Dialogue: 0,0:06:40.24,0:06:42.40,Default,,0,0,0,,Excuse me again. .
Dialogue: 0,0:06:42.40,0:06:43.40,Default,,0,0,0,,Кисарагиден қашыңыз
Dialogue: 0,0:06:43.76,0:06:45.28,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:45.28,0:06:46.16,Default,,0,0,0,,Кенеттен татами төсегі жарылып кетті.
Dialogue: 0,0:06:46.28,0:06:47.04,Default,,0,0,0,,Не болды, Ниа?
Dialogue: 0,0:06:50.16,0:06:51.81,Default,,0,0,0,,Stop it, Lucy.
Dialogue: 0,0:06:57.28,0:06:58.56,Default,,0,0,0,,Shoot to death
Dialogue: 0,0:07:18.68,0:07:19.80,Default,,0,0,0,,Ату және ату
Dialogue: 0,0:07:19.80,0:07:20.80,Default,,0,0,0,,It's a bullet
Dialogue: 0,0:07:23.96,0:07:25.08,Default,,0,0,0,,Олар әжептәуір алысқа қашып кеткен болар...
Dialogue: 0,0:07:25.20,0:07:25.68,Default,,0,0,0,,Барма!
Dialogue: 0,0:07:41.96,0:07:43.08,Default,,0,0,0,,Апаттық шығуға бет алды
Dialogue: 0,0:07:43.32,0:07:45.60,Default,,0,0,0,,Қақпаны түсіріп, оны ішке бекітіңіз.
Dialogue: 0,0:08:08.96,0:08:10.56,Default,,0,0,0,,Сыртқы қалқа ашылды ма?
Dialogue: 0,0:08:11.00,0:08:11.96,Default,,0,0,0,,Don't be stupid
Dialogue: 0,0:08:12.88,0:08:15.00,Default,,0,0,0,,Бұл жақсы сылтау. Bring on the sniper.
Dialogue: 0,0:08:19.88,0:08:20.88,Default,,0,0,0,,Бір оқпен өлтіру
Dialogue: 0,0:08:21.52,0:08:23.76,Default,,0,0,0,,Ол сені екінші оқпен ұратын адам емес.
Dialogue: 0,0:08:24.20,0:08:26.77,Default,,0,0,0,,50 Банкай танкіге қарсы винтовка
Dialogue: 0,0:08:27.20,0:08:30.52,Default,,0,0,0,,Тіпті оның «қолдары» да бұл жігітті жұлқылай алмайды.
Dialogue: 0,0:08:30.88,0:08:31.72,Default,,0,0,0,,Бұл бастың артқы жағы.
Dialogue: 0,0:08:32.24,0:08:32.92,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:08:46.76,0:08:48.96,Default,,0,0,0,,Жоқ. Әлі біткен жоқ.
Dialogue: 0,0:09:53.96,0:09:56.72,Default,,0,0,0,,Кота-кун. . . Дұрыс па?
Dialogue: 0,0:09:58.52,0:10:00.40,Default,,0,0,0,,Иә, иә?
Dialogue: 0,0:10:01.36,0:10:02.36,Default,,0,0,0,,Бұл Юка
Dialogue: 0,0:10:03.00,0:10:04.04,Default,,0,0,0,,Кузендікі. . .
Dialogue: 0,0:10:05.12,0:10:05.88,Default,,0,0,0,,Юка-чан
Dialogue: 0,0:10:08.04,0:10:08.76,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:10:09.76,0:10:12.16,Default,,0,0,0,,Бұл вокзалда емес еді, мен оны іздедім.
Dialogue: 0,0:10:12.76,0:10:13.88,Default,,0,0,0,,Өтінемін. . Кешіріңіз
Dialogue: 0,0:10:19.52,0:10:21.64,Default,,0,0,0,,Бірақ ол осында.
Dialogue: 0,0:10:22.24,0:10:24.92,Default,,0,0,0,,Кота: Сізге осы жерден теңіз қарау ұнады ма?
Dialogue: 0,0:10:25.56,0:10:26.68,Default,,0,0,0,,Есіңізде болсын
Dialogue: 0,0:10:28.04,0:10:30.77,Default,,0,0,0,,Бала кезімнен мүлде өзгерген жоқ.
Dialogue: 0,0:10:32.04,0:10:34.32,Default,,0,0,0,,Бір жерде университет болады деп ойламаппын.
Dialogue: 0,0:10:35.44,0:10:37.32,Default,,0,0,0,,Теңізді көруге уақыт бөлейік.
Dialogue: 0,0:10:38.68,0:10:39.56,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:39.64,0:10:41.80,Default,,0,0,0,,Жарайды, уақытыңызды жақсы өткіздіңіз.
Dialogue: 0,0:10:51.56,0:10:53.40,Default,,0,0,0,,Сіз мұнда көп ойнадыңыз, солай емес пе?
Dialogue: 0,0:10:55.08,0:10:57.20,Default,,0,0,0,,Соңғы күні де Кана екеуміз
Dialogue: 0,0:11:00.40,0:11:01.52,Default,,0,0,0,,Канэ-чан
Dialogue: 0,0:11:02.32,0:11:06.45,Default,,0,0,0,,Ол мұнда снарядтарды жинап жатыр.
Dialogue: 0,0:11:16.80,0:11:18.96,Default,,0,0,0,,Онии-чан
Dialogue: 0,0:11:19.36,0:11:22.44,Default,,0,0,0,,Мен бір топ снарядтарды алдым, қара!
Dialogue: 0,0:11:22.80,0:11:24.48,Default,,0,0,0,,Бұл өте әдемі емес.
Dialogue: 0,0:11:33.60,0:11:34.12,Default,,0,0,0,,Кота
Dialogue: 0,0:11:34.24,0:11:34.72,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:11:35.24,0:11:36.57,Default,,0,0,0,,Екінші жаққа қараған
Dialogue: 0,0:11:40.96,0:11:41.96,Default,,0,0,0,,. . . Бұл не?
Dialogue: 0,0:11:41.96,0:11:43.61,Default,,0,0,0,,Сіз түсінуге мүмкіндік жоқ.
Dialogue: 0,0:12:03.00,0:12:03.88,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:12:07.64,0:12:08.60,Default,,0,0,0,,Жақсы. .
Dialogue: 0,0:12:21.16,0:12:23.04,Default,,0,0,0,,Кота Әзірше киіміңді шеш.
Dialogue: 0,0:12:23.88,0:12:25.37,Default,,0,0,0,,Жарайды, шешіңіз.
Dialogue: 0,0:12:29.40,0:12:32.16,Default,,0,0,0,,Тілді түсінбейтін сияқтымын.
Dialogue: 0,0:12:32.56,0:12:33.68,Default,,0,0,0,,Әй, қарашы
Dialogue: 0,0:12:34.12,0:12:34.92,Default,,0,0,0,,Ауыр жарақат
Dialogue: 0,0:12:39.68,0:12:42.33,Default,,0,0,0,,Сол шаш әшекейі Шиноны көргім келеді.
Dialogue: 0,0:12:43.64,0:12:45.40,Default,,0,0,0,,Өтірік Ол тікелей өседі
Dialogue: 0,0:12:52.68,0:12:53.68,Default,,0,0,0,,Жыл бойы шорт киетін ұрғашы горилла ма!?
Dialogue: 0,0:12:54.28,0:12:55.32,Default,,0,0,0,,Кота
Dialogue: 0,0:12:56.08,0:12:57.08,Default,,0,0,0,,Кота
Dialogue: 0,0:12:57.44,0:12:58.96,Default,,0,0,0,,Эй, мен Коутамын.
Dialogue: 0,0:13:00.52,0:13:01.96,Default,,0,0,0,,Не?
Dialogue: 0,0:13:02.68,0:13:05.41,Default,,0,0,0,,Екеуміз жинала алмасақ, Коутаны қайда апару керектігін айтамын.
Dialogue: 0,0:13:05.92,0:13:07.16,Default,,0,0,0,,Мен қайдамын?
Dialogue: 0,0:13:07.28,0:13:08.56,Default,,0,0,0,,Where to live from now on
Dialogue: 0,0:13:09.08,0:13:10.92,Default,,0,0,0,,Өйткені ол осылай қала берсе
Dialogue: 0,0:13:14.56,0:13:17.60,Default,,0,0,0,,It's okay, don't worry.
Dialogue: 0,0:13:47.48,0:13:48.24,Default,,0,0,0,,Жаңа
Dialogue: 0,0:13:48.88,0:13:50.48,Default,,0,0,0,,In a house that is rented to you. . .
Dialogue: 0,0:13:50.88,0:13:51.48,Default,,0,0,0,,Бұл?
Dialogue: 0,0:13:51.72,0:13:52.96,Default,,0,0,0,,Бұл мейрамхана болды.
Dialogue: 0,0:13:53.24,0:13:55.08,Default,,0,0,0,,We're not open at the moment.
Dialogue: 0,0:13:55.72,0:13:58.96,Default,,0,0,0,,Анаң күнде үй жинаса, жарайды.
Dialogue: 0,0:13:59.40,0:14:00.00,Default,,0,0,0,,Осымен
Dialogue: 0,0:14:00.40,0:14:01.08,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:14:01.24,0:14:03.20,Default,,0,0,0,,Мен мұнда қанша бөлме бар деп ойлаймын.
Dialogue: 0,0:14:03.84,0:14:06.76,Default,,0,0,0,,I think it was 10 rooms.
Dialogue: 0,0:14:07.00,0:14:09.84,Default,,0,0,0,,Бәрін өзім тазалаймын.
Dialogue: 0,0:14:10.00,0:14:10.84,Default,,0,0,0,,Бақша да
Dialogue: 0,0:14:11.12,0:14:14.52,Default,,0,0,0,,Қысқасы, маған бос тұрған үйді басқару тағайындалды.
Dialogue: 0,0:14:16.48,0:14:17.12,Default,,0,0,0,,Жақсы
Dialogue: 0,0:14:17.76,0:14:21.48,Default,,0,0,0,,Олар: «Егер оларда ешкім тұрмаса, ғимараттар тез бұзылады» дейді.
Dialogue: 0,0:14:22.92,0:14:23.64,Default,,0,0,0,,Жаңа
Dialogue: 0,0:14:27.92,0:14:29.28,Default,,0,0,0,,(Кёко Хори) Иә, әлі де өзімді жақсы сезінбеймін.
Dialogue: 0,0:14:33.16,0:14:36.16,Default,,0,0,0,,Уау, бұл антиквариат.
Dialogue: 0,0:14:36.92,0:14:40.00,Default,,0,0,0,,Бұралсам да қозғалмайды, сынып қалады.
Dialogue: 0,0:14:40.64,0:14:41.28,Default,,0,0,0,,Не?
Dialogue: 0,0:14:44.32,0:14:46.56,Default,,0,0,0,,Коюю Мен сізбен келісе алмаймын, сондықтан мынаны пайдаланыңыз
Dialogue: 0,0:14:46.68,0:14:47.12,Default,,0,0,0,,Иә
Dialogue: 0,0:14:49.16,0:14:49.80,Default,,0,0,0,,Жаңа
Dialogue: 0,0:14:50.40,0:14:50.92,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:14:51.32,0:14:52.76,Default,,0,0,0,,Жаңа
Dialogue: 0,0:14:53.56,0:14:56.21,Default,,0,0,0,,Әй, мм.
Dialogue: 0,0:14:56.92,0:14:58.16,Default,,0,0,0,,Мен қиындыққа тап болдым.
Dialogue: 0,0:14:58.28,0:15:00.32,Default,,0,0,0,,Сіз атын да білмейсіз
Dialogue: 0,0:15:00.56,0:15:02.21,Default,,0,0,0,,Мен шошып кеттім де, «Нюу нюу» деймін.
Dialogue: 0,0:15:02.40,0:15:03.32,Default,,0,0,0,,Жаңа жеткіліксіз
Dialogue: 0,0:15:03.96,0:15:04.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:06.20,0:15:07.44,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:15:07.44,0:15:08.80,Default,,0,0,0,,Қараңдаршы, мен бақыттымын.
Dialogue: 0,0:15:09.56,0:15:10.80,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:15:12.04,0:15:12.80,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:21.48,0:15:22.72,Default,,0,0,0,,Жақсы емес, солай ма?
Dialogue: 0,0:15:23.08,0:15:24.84,Default,,0,0,0,,Сен бұлай қай жерге сидидің?
Dialogue: 0,0:15:24.96,0:15:25.60,Default,,0,0,0,,Жаңа
Dialogue: 0,0:15:30.16,0:15:31.81,Default,,0,0,0,,Сізді жалғыз жібергенім үшін кешіріңіз.
Dialogue: 0,0:15:33.20,0:15:35.85,Default,,0,0,0,,Маған шалбарымның ешқайсысын кигізбе
Dialogue: 0,0:15:36.20,0:15:38.12,Default,,0,0,0,,Өйткені менің ауыстыратын басқа киімім жоқ.
Dialogue: 0,0:15:38.72,0:15:40.08,Default,,0,0,0,,Мен оны кейінірек сатып аламын.
Dialogue: 0,0:15:41.00,0:15:42.49,Default,,0,0,0,,Мен қайда жеуім керек?
Dialogue: 0,0:15:43.36,0:15:44.72,Default,,0,0,0,,Мен саған күріш шарын әкелдім.
Dialogue: 0,0:15:52.48,0:15:53.76,Default,,0,0,0,,Сіз де ше?
Dialogue: 0,0:15:53.84,0:15:54.48,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:15:59.88,0:16:03.52,Default,,0,0,0,,Эй, сен мына баламен қайда жүрсің?
Dialogue: 0,0:16:04.00,0:16:04.76,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:16:10.28,0:16:12.00,Default,,0,0,0,,Күріш жеген бала бар ма?
Dialogue: 0,0:16:13.88,0:16:15.29,Default,,0,0,0,,Оны осылай ұстаңыз
Dialogue: 0,0:16:22.16,0:16:23.36,Default,,0,0,0,,Мен бұған көмектесе алмаймын.
Dialogue: 0,0:16:28.88,0:16:30.64,Default,,0,0,0,,Жүріңдер, мен барлығын толқытамын.
Dialogue: 0,0:16:49.80,0:16:52.04,Default,,0,0,0,,Гуичидзи бес қабатты құлыптың қалқаны
Dialogue: 0,0:16:52.44,0:16:54.80,Default,,0,0,0,,Қауіпсіздік жүйесі де тамаша болды.
Dialogue: 0,0:16:55.68,0:16:59.32,Default,,0,0,0,,Өздігінен ашылған апаттық розетканың жапқышы әлі де себеп болып табылады. . .
Dialogue: 0,0:16:59.44,0:17:04.04,Default,,0,0,0,,Дәл қазір менің басты басымдығым себебін табу емес, Люсиді жою.
Dialogue: 0,0:17:04.08,0:17:06.04,Default,,0,0,0,,Өшіру? Түсіргеннен гөрі?
Dialogue: 0,0:17:07.00,0:17:09.89,Default,,0,0,0,,SAT арнайы шабуыл күштерін қолданыңыз
Dialogue: 0,0:17:11.60,0:17:13.40,Default,,0,0,0,,Люсиді миға жіберіңіз
Dialogue: 0,0:17:14.16,0:17:15.49,Default,,0,0,0,,Адамзат жойылады
Dialogue: 0,0:17:25.88,0:17:26.56,Default,,0,0,0,,Мені тезірек үйге жіберші.
Dialogue: 0,0:17:26.92,0:17:29.12,Default,,0,0,0,,Барлық нысандарды бір уақытта құлыптау
Dialogue: 0,0:17:30.24,0:17:33.16,Default,,0,0,0,,Оны жалғыз жеңетін нәрсе болса, бұл құбыжық.
Dialogue: 0,0:17:34.16,0:17:34.92,Default,,0,0,0,,Құбыжық. . .
Dialogue: 0,0:17:38.32,0:17:41.40,Default,,0,0,0,,Бұл адамдарды біршама мақсатты етеді.
Dialogue: 0,0:17:55.08,0:17:56.92,Default,,0,0,0,,Бандо: Сіз байсалдысыз ба?
Dialogue: 0,0:17:58.96,0:18:02.32,Default,,0,0,0,,Айқайлап, қансырап тұрған нәрсені атудың не керегі бар?
Dialogue: 0,0:18:02.80,0:18:03.72,Default,,0,0,0,,Ахокус!
Dialogue: 0,0:18:03.80,0:18:05.56,Default,,0,0,0,,Біреу біреуді атсын.
Dialogue: 0,0:18:05.72,0:18:06.72,Default,,0,0,0,,Кисама
Dialogue: 0,0:18:07.32,0:18:08.16,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:11.68,0:18:14.16,Default,,0,0,0,,Ahokuse Сіз мұны істей аласыз ба?
Dialogue: 0,0:18:16.08,0:18:19.24,Default,,0,0,0,,Бүгін таңертең кісі өлтіруші лагерьден қашып кетті.
Dialogue: 0,0:18:21.48,0:18:23.20,Default,,0,0,0,,Оны мүмкіндігінше тезірек табыңыз
Dialogue: 0,0:18:24.08,0:18:24.96,Default,,0,0,0,,Мені атып өлтіруіңді қалаймын.
Dialogue: 0,0:18:25.48,0:18:26.20,Default,,0,0,0,,Түсіру?
Dialogue: 0,0:18:27.00,0:18:28.72,Default,,0,0,0,,Біреуді кенеттен атып өлтіруге бола ма?
Dialogue: 0,0:18:40.88,0:18:42.32,Default,,0,0,0,,Ату керек пе?
Dialogue: 0,0:18:42.72,0:18:43.36,Default,,0,0,0,,Бандо мырза
Dialogue: 0,0:18:48.60,0:18:50.60,Default,,0,0,0,,Менің артымда тұрма
Dialogue: 0,0:18:50.96,0:18:51.76,Default,,0,0,0,,Ақымақ әйел
Dialogue: 0,0:18:58.84,0:18:59.88,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:19:09.04,0:19:10.64,Default,,0,0,0,,Мен айтқандай тазалаңыз.
Dialogue: 0,0:19:10.64,0:19:11.40,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:12.48,0:19:14.05,Default,,0,0,0,,Арнайы қызмет бүгін ғана
Dialogue: 0,0:19:14.36,0:19:16.04,Default,,0,0,0,,Ертеңнен бастап
Dialogue: 0,0:19:16.28,0:19:17.61,Default,,0,0,0,,Мен түсіндім
Dialogue: 0,0:19:18.00,0:19:18.92,Default,,0,0,0,,Жаңа
Dialogue: 0,0:19:21.16,0:19:21.88,Default,,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,0:19:22.04,0:19:23.80,Default,,0,0,0,,Осында қойсам да
Dialogue: 0,0:19:24.52,0:19:26.88,Default,,0,0,0,,Менің ойымша, полицияға хабарласуым керек.
Dialogue: 0,0:19:27.24,0:19:27.92,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:19:29.64,0:19:30.76,Default,,0,0,0,,Ой. . .
Dialogue: 0,0:19:32.52,0:19:34.80,Default,,0,0,0,,Мүмкін. . .
Dialogue: 0,0:19:35.92,0:19:36.80,Default,,0,0,0,,At that time
Dialogue: 0,0:19:40.04,0:19:41.20,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:19:43.00,0:19:43.68,Default,,0,0,0,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 0,0:19:44.80,0:19:45.68,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:19:46.00,0:19:47.92,Default,,0,0,0,,Мен мұны тапқаныма қуаныштымын.
Dialogue: 0,0:19:50.64,0:19:51.56,Default,,0,0,0,,Сонымен. .
Dialogue: 0,0:19:53.76,0:19:55.09,Default,,0,0,0,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:19:55.76,0:19:58.84,Default,,0,0,0,,Менің қолымнан келмейді, мен ағама барамын.
Dialogue: 0,0:20:01.28,0:20:02.52,Default,,0,0,0,,Осыдан кейін бірден. . .
Dialogue: 0,0:20:03.84,0:20:05.41,Default,,0,0,0,,Өйткені мен аурудан қайтыс болдым.
Dialogue: 0,0:20:07.20,0:20:07.84,Default,,0,0,0,,Ауру?
Dialogue: 0,0:20:09.08,0:20:10.44,Default,,0,0,0,,Ауру дегеніміз не?
Dialogue: 0,0:20:10.72,0:20:12.32,Default,,0,0,0,,Бұл естелік сияқты.
Dialogue: 0,0:20:13.08,0:20:14.84,Default,,0,0,0,,Мен мұнда келу үшін қиындық көрдім.
Dialogue: 0,0:20:15.84,0:20:17.17,Default,,0,0,0,,Бірге ойланайық
Dialogue: 0,0:20:18.36,0:20:18.96,Default,,0,0,0,,Кота
Dialogue: 0,0:20:22.16,0:20:22.80,Default,,0,0,0,,Не?
Dialogue: 0,0:20:33.12,0:20:33.84,Default,,0,0,0,,Кота
Dialogue: 0,0:20:34.00,0:20:35.20,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:20:35.32,0:20:37.12,Default,,0,0,0,,Әпкеңе естелік ретінде айттың.
Dialogue: 0,0:20:37.32,0:20:38.24,Default,,0,0,0,,Коута №
Dialogue: 0,0:20:38.24,0:20:39.00,Default,,0,0,0,,Ой жоқ.
Dialogue: 0,0:20:39.08,0:20:39.48,Default,,0,0,0,,Коута №
Dialogue: 0,0:20:39.48,0:20:39.49,Default,,0,0,0,,Коута №
Dialogue: 0,0:20:39.49,0:20:39.88,Default,,0,0,0,,Коута №
Dialogue: 0,0:20:39.88,0:20:39.89,Default,,0,0,0,,Тек мазасыздану жеткіліксіз
Dialogue: 0,0:20:39.89,0:20:40.48,Default,,0,0,0,,Тек мазасыздану жеткіліксіз
Dialogue: 0,0:20:40.48,0:20:41.48,Default,,0,0,0,,Кота, тоқтат.
Dialogue: 0,0:20:41.56,0:20:42.76,Default,,0,0,0,,Тынышталыңыз.
Dialogue: 0,0:20:42.84,0:20:43.88,Default,,0,0,0,,Мен Ню-чанға сенімдімін. . .
Dialogue: 0,0:20:43.96,0:20:45.61,Default,,0,0,0,,Балалар, шығыңдар!
Dialogue: 0,0:20:45.76,0:20:46.76,Default,,0,0,0,,Сәлем Коута
Dialogue: 0,0:20:46.84,0:20:47.56,Default,,0,0,0,,Шығыңыз.
Dialogue: 0,0:20:47.64,0:20:48.76,Default,,0,0,0,,Жоқ дейсіз бе?
Dialogue: 0,0:20:48.88,0:20:49.36,Default,,0,0,0,,Сыртқа шығып, мені тепкіле, солай ма?
Dialogue: 0,0:20:49.76,0:20:50.64,Default,,0,0,0,,Сабыр етіңіз.
Dialogue: 0,0:20:50.96,0:20:51.00,Default,,0,0,0,,Тітіркендірмеңіз
Dialogue: 0,0:20:51.72,0:20:52.24,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:20:52.36,0:20:53.72,Default,,0,0,0,,Кота
Dialogue: 0,0:21:17.24,0:21:19.04,Default,,0,0,0,,Ол не ойлады?
Dialogue: 0,0:21:20.28,0:21:21.16,Default,,0,0,0,,Әрине. . .
Dialogue: 0,0:21:23.92,0:21:24.88,Default,,0,0,0,,Кота
Dialogue: 0,0:21:26.40,0:21:28.52,Default,,0,0,0,,Себебі сен мұңды көрінесің.
Dialogue: 0,0:21:29.80,0:21:33.56,Default,,0,0,0,,Менің ойымша, бұл қабық жаман адамдарды көргісі келеді.
Dialogue: 0,0:21:36.04,0:21:39.88,Default,,0,0,0,,Кота Канэ-чанды ойлаған сайын мұңайып кетсе
Dialogue: 0,0:21:41.00,0:21:43.65,Default,,0,0,0,,Кана-чан да мұңая ма деп ойлаймын.
Dialogue: 0,0:21:49.40,0:21:51.05,Default,,0,0,0,,Мен оны іздеймін.
Dialogue: 0,0:21:51.32,0:21:53.44,Default,,0,0,0,,Сыртта қараңғы, қатты жаңбыр жауып тұр.
Dialogue: 0,0:22:02.44,0:22:03.93,Default,,0,0,0,,Көп ұзамай Камакураның үстінде
Dialogue: 0,0:22:04.84,0:22:08.84,Default,,0,0,0,,Егер бұл елде кәмелетке толмағандарды атып өлтіру туралы нұсқау берілсе, онда...
Dialogue: 0,0:22:11.16,0:22:12.73,Default,,0,0,0,,Әлем жақсырақ жерге айналды.
Dialogue: 0,0:22:12.80,0:22:13.92,Default,,0,0,0,,Аузыңызды жабыңыз
Dialogue: 0,0:22:14.04,0:22:15.72,Default,,0,0,0,,Кисама, сенің міндетің қандай?
Dialogue: 0,0:22:17.60,0:22:18.20,Default,,0,0,0,,Ямаро
Dialogue: 0,0:22:18.28,0:22:19.20,Default,,0,0,0,,Сіз не ойладыңыз?
Dialogue: 0,0:22:19.20,0:22:19.72,Default,,0,0,0,,Ямаро
Dialogue: 0,0:22:19.84,0:22:22.73,Default,,0,0,0,,Біз күнде қандай жаттығу жасаймыз?
Dialogue: 0,0:22:24.56,0:22:25.60,Default,,0,0,0,,Әйтеуір, адамның өмірінің соңы—
Dialogue: 0,0:22:26.96,0:22:27.60,Default,,0,0,0,,Талап етілмеген елу миллиардты қайтарып алу үшін.
Dialogue: 0,0:22:32.32,0:22:33.68,Default,,0,0,0,,Сіз бөлісесіз бе?
Dialogue: 0,0:22:37.12,0:22:40.60,Default,,0,0,0,,Көңілді болыңыз, бірақ сақтықты төмендетпеңіз.
Dialogue: 0,0:22:45.00,0:22:49.36,Default,,0,0,0,,Мақсат – бар болғаны 5 минутта 23 адамды өлтірген қаскөй.
Dialogue: 0,0:24:34.56,0:24:37.04,Default,,0,0,0,,Аңшылық, аңшылық.
Dialogue: 0,0:24:39.12,0:24:41.85,Default,,0,0,0,,Тұрақты сан кері және кері.
Dialogue: 0,0:24:43.96,0:24:45.48,Default,,0,0,0,,Оны айнымас серпінге айналдыр
Dialogue: 0,0:24:45.60,0:24:47.25,Default,,0,0,0,,Таза нәзік мінез-құлық
Dialogue: 0,0:24:49.32,0:24:51.00,Default,,0,0,0,,Өйткені бұл таза нәзіктік. . .
Dialogue: 0,0:24:51.32,0:24:52.24,Default,,0,0,0,,Ләззат
Dialogue: 0,0:24:55.12,0:24:55.84,Default,,0,0,0,,Келесі жолы
Dialogue: 0,0:24:55.88,0:24:57.32,Default,,0,0,0,,Эльфен өтірік айтты «2-эпизод»
Dialogue: 0,0:24:57.76,0:24:58.88,Default,,0,0,0,,Сыпыру
Dialogue: 0,0:25:00.38,0:25:06.38,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory