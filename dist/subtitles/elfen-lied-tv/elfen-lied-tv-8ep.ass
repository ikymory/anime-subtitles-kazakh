Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.77,0:00:18.16,Default,,0,0,0,,Os iusti meditabitur sapientiam,
Dialogue: 0,0:00:18.16,0:00:27.29,Default,,0,0,0,,Et lingua eius loquetur indicium.
Dialogue: 0,0:00:27.29,0:00:38.55,Default,,0,0,0,,Beatus vir qui азап шегеді,
Dialogue: 0,0:00:38.55,0:00:49.15,Default,,0,0,0,,Quoniqm cum probaes fuerit accipient coronam vitae.
Dialogue: 0,0:00:49.15,0:01:02.24,Default,,0,0,0,,Кири, ignis divine, eleison.
Dialogue: 0,0:01:02.62,0:01:13.71,Default,,0,0,0,,О quam sancta, quam serena,
Dialogue: 0,0:01:13.71,0:01:28.31,Default,,0,0,0,,Куам-беигма, квам амоена,
Dialogue: 0,0:01:31.08,0:01:32.08,Default,,0,0,0,,Ню-чан
Dialogue: 0,0:01:36.32,0:01:37.24,Default,,0,0,0,,Кота
Dialogue: 0,0:01:37.48,0:01:38.61,Default,,0,0,0,,Тек қолтаңба ғана — ерекше алғыс
Dialogue: 0,0:01:38.60,0:01:40.73,Default,,0,0,0,,Ол кездегідей емес
Dialogue: 0,0:01:40.92,0:01:41.81,Default,,0,0,0,,Ню-сан
Dialogue: 0,0:01:41.84,0:01:43.13,Default,,0,0,0,,Ню-чан, жақсысың ба?
Dialogue: 0,0:01:43.56,0:01:44.85,Default,,0,0,0,,Ню-чан деба
Dialogue: 0,0:01:45.36,0:01:46.12,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:01:46.24,0:01:46.84,Default,,0,0,0,,Эй
Dialogue: 0,0:01:53.32,0:01:55.00,Default,,0,0,0,,Сіз кенеттен не істеп жатырсыз?
Dialogue: 0,0:01:55.00,0:01:56.76,Default,,0,0,0,,Бұл менің жолым шығар.
Dialogue: 0,0:01:58.36,0:02:00.36,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:02:00.64,0:02:04.65,Default,,0,0,0,,Кешіріңіз. Бұл болғанына өкінемін.
Dialogue: 0,0:02:04.64,0:02:07.21,Default,,0,0,0,,Кота-сан, кешіріңіз.
Dialogue: 0,0:02:08.92,0:02:12.29,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:02:12.52,0:02:14.05,Default,,0,0,0,,Бұл кінәлі адам.
Dialogue: 0,0:02:14.32,0:02:16.64,Default,,0,0,0,,Неліктен бәрі Люсиді қорғайды?
Dialogue: 0,0:02:17.00,0:02:17.81,Default,,0,0,0,,Люси
Dialogue: 0,0:02:18.04,0:02:20.04,Default,,0,0,0,,Ол өте жаман адам.
Dialogue: 0,0:02:20.44,0:02:23.81,Default,,0,0,0,,Неге, бұл жерде ештеңе жоқ.
Dialogue: 0,0:02:24.44,0:02:27.57,Default,,0,0,0,,Нана Бұл жаман емес.
Dialogue: 0,0:02:27.56,0:02:29.96,Default,,0,0,0,,Ню-чан, жауап беріңізші.
Dialogue: 0,0:02:29.96,0:02:30.93,Default,,0,0,0,,Не болды?
Dialogue: 0,0:02:31.16,0:02:33.05,Default,,0,0,0,,Мен есінен танып қалдым деп ойлаймын.
Dialogue: 0,0:02:33.04,0:02:34.57,Default,,0,0,0,,Ей, мықты бол.
Dialogue: 0,0:02:34.76,0:02:36.21,Default,,0,0,0,,Ол қатты жараланған еді...
Dialogue: 0,0:02:37.20,0:02:38.44,Default,,0,0,0,,Ах Нана-сан
Dialogue: 0,0:02:46.08,0:02:48.56,Default,,0,0,0,,Нана, бұл жерде ештеңе жоқ.
Dialogue: 0,0:02:49.04,0:02:50.72,Default,,0,0,0,,Бұл жерде ештеңе жоқ
Dialogue: 0,0:03:02.60,0:03:04.60,Default,,0,0,0,,Мен сөмкемді ұмытып кетіппін.
Dialogue: 0,0:03:05.12,0:03:05.85,Default,,0,0,0,,Бетіңде әлі де сол мұңды кейіп бар.
Dialogue: 0,0:03:06.60,0:03:07.93,Default,,0,0,0,,Мен Маюды жек көремін
Dialogue: 0,0:03:08.12,0:03:10.01,Default,,0,0,0,,Бәріміз Нананы жаман жігіт қылайық
Dialogue: 0,0:03:10.00,0:03:11.08,Default,,0,0,0,,Жібер
Dialogue: 0,0:03:11.48,0:03:12.72,Default,,0,0,0,,Бұл өте жауапсыздық.
Dialogue: 0,0:03:12.72,0:03:13.45,Default,,0,0,0,,Егер сіз жіберсеңіз
Dialogue: 0,0:03:27.00,0:03:31.12,Default,,0,0,0,,Нана-сан кінәлі емес пе, күтпеген жерден Ню-санға осындай әрекет жасағаны үшін?
Dialogue: 0,0:03:31.12,0:03:31.13,Default,,0,0,0,,Өйткені ол адам шынымен жаман адам.
Dialogue: 0,0:03:31.13,0:03:34.12,Default,,0,0,0,,Өйткені ол адам шынымен жаман адам.
Dialogue: 0,0:03:34.40,0:03:39.72,Default,,0,0,0,,Ум, сен Нюу-санды Люси-сан деп атадың, солай ма?
Dialogue: 0,0:04:16.24,0:04:17.96,Default,,0,0,0,,Ер адамның аты – Ллойд Форджер
Dialogue: 0,0:04:18.24,0:04:20.40,Default,,0,0,0,,Мен енді ешқашан мұндайды мінбеймін.
Dialogue: 0,0:04:20.88,0:04:22.29,Default,,0,0,0,,Хе-хе-хе
Dialogue: 0,0:04:29.88,0:04:33.40,Default,,0,0,0,,Неліктен мен мұндай нәрсені жеткізу үшін қиындыққа баруым керек?
Dialogue: 0,0:04:33.84,0:04:36.04,Default,,0,0,0,,Бұл жай ғана келіп алып кету емес.
Dialogue: 0,0:04:40.28,0:04:42.52,Default,,0,0,0,,Бұл ұрлау емес.
Dialogue: 0,0:04:45.52,0:04:48.17,Default,,0,0,0,,Жуынғаныма неше күн болды?
Dialogue: 0,0:04:51.68,0:04:53.28,Default,,0,0,0,,Директор Кадозава сізді күтуде.
Dialogue: 0,0:04:59.16,0:05:00.12,Default,,0,0,0,,Әрине
Dialogue: 0,0:05:01.32,0:05:02.89,Default,,0,0,0,,Бұл оны шешер еді.
Dialogue: 0,0:05:03.32,0:05:04.89,Default,,0,0,0,,Үйге тез келе аласыз ба?
Dialogue: 0,0:05:06.00,0:05:06.68,Default,,0,0,0,,Going home?
Dialogue: 0,0:05:07.28,0:05:10.20,Default,,0,0,0,,Егер бұл рас болса, мен көңіл айтар едім.
Dialogue: 0,0:05:10.68,0:05:14.16,Default,,0,0,0,,Бірақ мені де күтпеген жерден осындай жерге шақырды.
Dialogue: 0,0:05:14.68,0:05:17.52,Default,,0,0,0,,Көңіл айту керек сенсің.
Dialogue: 0,0:05:21.52,0:05:23.56,Default,,0,0,0,,Na. . . What a moment
Dialogue: 0,0:05:23.56,0:05:25.96,Default,,0,0,0,,Бұл қауіпті, сондықтан оны қойыңыз.
Dialogue: 0,0:05:28.20,0:05:30.96,Default,,0,0,0,,Эй, бұл жай әрекет емес.
Dialogue: 0,0:05:31.28,0:05:32.92,Default,,0,0,0,,You saw this
Dialogue: 0,0:05:32.92,0:05:32.93,Default,,0,0,0,,Бұл мүйізді білдіре ме?
Dialogue: 0,0:05:32.93,0:05:34.44,Default,,0,0,0,,Бұл мүйізді білдіре ме?
Dialogue: 0,0:05:34.44,0:05:38.72,Default,,0,0,0,,Сондықтан мен сені тірі қалдыра алмаймын.
Dialogue: 0,0:05:39.72,0:05:40.92,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба?
Dialogue: 0,0:05:45.36,0:05:49.36,Default,,0,0,0,,That's a lie.
Dialogue: 0,0:05:49.84,0:05:54.24,Default,,0,0,0,,Рас, институттан қашып, Савадағы адамдарды өлтір.
Dialogue: 0,0:05:54.96,0:05:57.72,Default,,0,0,0,,Іздеп келген мүшелерім де сондай.
Dialogue: 0,0:05:58.84,0:06:01.60,Default,,0,0,0,,Мен бұған сене алмаймын.
Dialogue: 0,0:06:13.00,0:06:15.97,Default,,0,0,0,,Біз қарапайым адамдар емеспіз.
Dialogue: 0,0:06:16.36,0:06:17.88,Default,,0,0,0,,Олардың мүйізі ғана емес
Dialogue: 0,0:06:23.40,0:06:24.24,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:06:25.12,0:06:26.36,Default,,0,0,0,,Ах, сонда ол ма еді?
Dialogue: 0,0:06:33.60,0:06:35.88,Default,,0,0,0,,Ho. . . I really hit it
Dialogue: 0,0:06:38.72,0:06:40.52,Default,,0,0,0,,Өлгің келмейді
Dialogue: 0,0:06:41.24,0:06:43.64,Default,,0,0,0,,Менен анық нәрсені сұрама
Dialogue: 0,0:06:43.64,0:06:45.64,Default,,0,0,0,,А, тым көп қан.
Dialogue: 0,0:06:46.16,0:06:48.92,Default,,0,0,0,,Олай болса, менің артымнан мойынсұнып жүр.
Dialogue: 0,0:06:51.36,0:06:53.52,Default,,0,0,0,,Алдымен сұрағыңызға жауап берейін.
Dialogue: 0,0:06:55.56,0:06:56.76,Default,,0,0,0,,Екіншісі кім?
Dialogue: 0,0:06:57.68,0:06:58.64,Default,,0,0,0,,Не туралы сөйлесу керек
Dialogue: 0,0:06:59.04,0:07:01.64,Default,,0,0,0,,Менің баламның денесін көрген ол.
Dialogue: 0,0:07:01.76,0:07:05.00,Default,,0,0,0,,Оқиға орнында сізден басқа іздер расталды.
Dialogue: 0,0:07:05.80,0:07:08.77,Default,,0,0,0,,Әлбетте, тағы бір адам болды.
Dialogue: 0,0:07:09.32,0:07:11.92,Default,,0,0,0,,Мұғалімге қонаққа келген оқушы.
Dialogue: 0,0:07:12.40,0:07:13.32,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:07:13.44,0:07:16.76,Default,,0,0,0,,Осындай оқиғадан кейін мен оның бетін де жақсы есіме түсірмеймін.
Dialogue: 0,0:07:17.76,0:07:19.33,Default,,0,0,0,,Әсіресе аты
Dialogue: 0,0:07:20.44,0:07:21.68,Default,,0,0,0,,Оны дәл осы жерде жоямыз
Dialogue: 0,0:07:24.16,0:07:27.32,Default,,0,0,0,,Соңғы кезде Рюкті көрмеппін, иә?
Dialogue: 0,0:07:27.64,0:07:31.04,Default,,0,0,0,,Ұлымнан оның тамаша ғалым екенін естідім.
Dialogue: 0,0:07:39.28,0:07:40.61,Default,,0,0,0,,қоғамдық бейбітшілік хатын алмастыру үшін, иә?
Dialogue: 0,0:07:41.96,0:07:46.96,Default,,0,0,0,,Мұғалімімен қалдырған қызды іздеп келді.
Dialogue: 0,0:07:47.68,0:07:49.20,Default,,0,0,0,,Қыз болса ше?
Dialogue: 0,0:07:49.20,0:07:54.36,Default,,0,0,0,,Біз кеткенде ол жоқ еді.
Dialogue: 0,0:07:55.84,0:07:59.84,Default,,0,0,0,,Мен қалай шіримін мұндай жерде, әлі тың?
Dialogue: 0,0:08:01.00,0:08:04.56,Default,,0,0,0,,Сіз мұнымен мүлдем келісесіз бе? . .
Dialogue: 0,0:08:12.48,0:08:13.56,Default,,0,0,0,,Ширакава
Dialogue: 0,0:08:13.84,0:08:14.72,Default,,0,0,0,,Иә
Dialogue: 0,0:08:17.36,0:08:18.44,Default,,0,0,0,,Director's office
Dialogue: 0,0:08:18.84,0:08:19.76,Default,,0,0,0,,Жедел медициналық бригада
Dialogue: 0,0:08:21.08,0:08:23.60,Default,,0,0,0,,Will you help me?
Dialogue: 0,0:08:23.60,0:08:26.76,Default,,0,0,0,,Дегенмен, мен сізден ынтымақтастық сұраймын.
Dialogue: 0,0:08:30.12,0:08:32.00,Default,,0,0,0,,Ұлымның атынан.
Dialogue: 0,0:08:36.16,0:08:39.92,Default,,0,0,0,,Біз туылғаннан бері қолымыз сенен басқа.
Dialogue: 0,0:08:40.44,0:08:41.28,Default,,0,0,0,,Hand?
Dialogue: 0,0:08:59.20,0:09:00.61,Default,,0,0,0,,Бұл қолдың төрт қолы бар.
Dialogue: 0,0:09:01.32,0:09:05.40,Default,,0,0,0,,Сондықтан Нана әкесі берген аяқ-қолдарды қозғалта алады.
Dialogue: 0,0:09:07.84,0:09:10.57,Default,,0,0,0,,Бұл арман емес еді.
Dialogue: 0,0:09:11.84,0:09:14.36,Default,,0,0,0,,Е, әлгі қарт не деді.
Dialogue: 0,0:09:16.24,0:09:17.24,Default,,0,0,0,,Сіз таң қалдыңыз ба?
Dialogue: 0,0:09:17.72,0:09:20.56,Default,,0,0,0,,Бірақ Нана Люсиден өзгеше.
Dialogue: 0,0:09:20.84,0:09:22.36,Default,,0,0,0,,Ештеңе мүлдем жаман емес
Dialogue: 0,0:09:25.12,0:09:27.60,Default,,0,0,0,,Мұны маған әкем жасырын айтты.
Dialogue: 0,0:09:27.60,0:09:30.12,Default,,0,0,0,,Мен сөйлегеннен кейін не істеуім керек?
Dialogue: 0,0:09:30.12,0:09:31.56,Default,,0,0,0,,Ah. . . Бұл
Dialogue: 0,0:09:32.44,0:09:33.24,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:09:33.48,0:09:36.21,Default,,0,0,0,,Ню-сан мүлде жаман адам емес.
Dialogue: 0,0:09:36.48,0:09:40.64,Default,,0,0,0,,Өмір қарапайым, адал және қызықты.
Dialogue: 0,0:09:41.36,0:09:44.01,Default,,0,0,0,,Бірге, соңына дейін көңіл көтереміз.
Dialogue: 0,0:09:47.72,0:09:52.12,Default,,0,0,0,,That. . . Мен ешқашан қолды пайдаланған емеспін.
Dialogue: 0,0:09:52.64,0:09:56.36,Default,,0,0,0,,It's true. Ню-сан мен Нана-сан сен айтып отырған нәрсеге мүлдем ұқсамайды. . .
Dialogue: 0,0:09:56.64,0:09:57.76,Default,,0,0,0,,I wonder why
Dialogue: 0,0:09:59.52,0:10:02.64,Default,,0,0,0,,Бұл адам Люси екені сөзсіз.
Dialogue: 0,0:10:04.24,0:10:06.72,Default,,0,0,0,,Мен ешқандай қатысуды сезе алмаймын.
Dialogue: 0,0:10:08.60,0:10:11.52,Default,,0,0,0,,Ол Нана білетін Люси-саннан өзгеше.
Dialogue: 0,0:10:12.28,0:10:17.16,Default,,0,0,0,,Бірақ енді оны оңай басқаша атауға болады.
Dialogue: 0,0:10:18.16,0:10:19.16,Default,,0,0,0,,Нана-сан
Dialogue: 0,0:10:20.52,0:10:23.25,Default,,0,0,0,,Мен білмеймін, білмеймін
Dialogue: 0,0:10:24.00,0:10:27.28,Default,,0,0,0,,Сіз қарсы алмайтын адаммен күресе алмайсыз.
Dialogue: 0,0:10:28.16,0:10:31.16,Default,,0,0,0,,Әке, мен не істеуім керек?
Dialogue: 0,0:10:31.92,0:10:33.25,Default,,0,0,0,,Нана-сан
Dialogue: 0,0:10:40.44,0:10:41.76,Default,,0,0,0,,Дене қызуы көтерілмейді.
Dialogue: 0,0:10:41.76,0:10:41.77,Default,,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,0:10:41.77,0:10:42.64,Default,,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,0:10:42.88,0:10:45.56,Default,,0,0,0,,Тек ұрып-соғудан болмаған сияқты.
Dialogue: 0,0:10:45.88,0:10:48.32,Default,,0,0,0,,Егер ауырып жатсаңыз, мен сізді ауруханаға апаруым керек.
Dialogue: 0,0:10:50.08,0:10:52.81,Default,,0,0,0,,Мүйізі бар адамдар бірден оқшауланады.
Dialogue: 0,0:10:53.56,0:10:54.20,Default,,0,0,0,,Then
Dialogue: 0,0:10:54.84,0:10:56.52,Default,,0,0,0,,But the hospital
Dialogue: 0,0:11:02.32,0:11:03.84,Default,,0,0,0,,Nyu-chan woke up
Dialogue: 0,0:11:04.16,0:11:08.21,Default,,0,0,0,,Жақсы, мені түсіне аласың ба?
Dialogue: 0,0:11:10.40,0:11:11.08,Default,,0,0,0,,Кота
Dialogue: 0,0:11:12.96,0:11:14.16,Default,,0,0,0,,Нана-сан
Dialogue: 0,0:11:17.36,0:11:19.48,Default,,0,0,0,,Нана-сан, не болды?
Dialogue: 0,0:11:24.12,0:11:25.24,Default,,0,0,0,,оянды
Dialogue: 0,0:11:26.36,0:11:30.25,Default,,0,0,0,,Ол профессор Какузаваның көмекшісі болса да, оның мұнда бөгде адамды әкелгеніне сене алар емеспін.
Dialogue: 0,0:11:31.60,0:11:33.60,Default,,0,0,0,,Комиссар не істейді?
Dialogue: 0,0:11:34.00,0:11:37.60,Default,,0,0,0,,Ол ұлының зерттеуі туралы бәрін біледі.
Dialogue: 0,0:11:38.24,0:11:40.32,Default,,0,0,0,,Ретровирусқа қарсы вакцина жасау
Dialogue: 0,0:11:41.00,0:11:43.24,Default,,0,0,0,,Бұл сыртқы агенттікпен мүмкін болуы керек
Dialogue: 0,0:11:44.12,0:11:45.88,Default,,0,0,0,,Вакцина.
Dialogue: 0,0:11:47.88,0:11:50.77,Default,,0,0,0,,Менің қалағаным вакцина емес
Dialogue: 0,0:11:51.24,0:11:53.12,Default,,0,0,0,,Бұл вирустың өзі.
Dialogue: 0,0:11:53.60,0:11:57.00,Default,,0,0,0,,Мен сіздің ниетіңізді өлшей алмаймын, бірақ
Dialogue: 0,0:11:57.60,0:12:02.64,Default,,0,0,0,,Жоғарғы жағында Люси бар жаңа адамзат нәсілінің қайта туылуын жоспарлау
Dialogue: 0,0:12:03.40,0:12:05.76,Default,,0,0,0,,Хатшы, сіз бе?
Dialogue: 0,0:12:06.52,0:12:11.04,Default,,0,0,0,,Адам түрі міндетті түрде өзінің соңына қарай бет алады.
Dialogue: 0,0:12:11.40,0:12:13.16,Default,,0,0,0,,Жоқ, мен өтуім керек.
Dialogue: 0,0:12:14.00,0:12:17.28,Default,,0,0,0,,Люсидің әлемге келуі – соның дәлелі.
Dialogue: 0,0:12:18.76,0:12:21.48,Default,,0,0,0,,Мен Құдайдың өкілімін
Dialogue: 0,0:12:21.48,0:12:21.49,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:12:21.49,0:12:22.40,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:12:23.28,0:12:24.80,Default,,0,0,0,,Ал мен оны дәл осы жерде ғана ұшырып жіберсем!
Dialogue: 0,0:12:24.88,0:12:26.80,Default,,0,0,0,,Мені қате түсінбеңіз Курама
Dialogue: 0,0:12:27.52,0:12:30.04,Default,,0,0,0,,Маған қарызыңды ұмыттың ба?
Dialogue: 0,0:12:31.00,0:12:34.44,Default,,0,0,0,,Сен маған адал болуың керек.
Dialogue: 0,0:12:36.12,0:12:38.24,Default,,0,0,0,,7 санының қашып кетуіне жол бергеніңізді естідім.
Dialogue: 0,0:12:39.56,0:12:45.20,Default,,0,0,0,,7 нөмірін өңдеу және Люсиді түсіру үшін 35 санын пайдаланыңыз
Dialogue: 0,0:12:47.20,0:12:51.80,Default,,0,0,0,,Жақсылығымның кесірінен бағынбаудың күнәларын оқимын ба?
Dialogue: 0,0:12:54.96,0:12:57.56,Default,,0,0,0,,Нюу Бір жері ауырып тұр ма?
Dialogue: 0,0:13:06.28,0:13:07.85,Default,,0,0,0,,Әй, қайда барасың?
Dialogue: 0,0:13:13.84,0:13:15.84,Default,,0,0,0,,Менің жадым әлі күнге дейін.
Dialogue: 0,0:13:22.16,0:13:23.36,Default,,0,0,0,,Бұл дәретхана ма?
Dialogue: 0,0:13:28.04,0:13:29.72,Default,,0,0,0,,Дәретхана ол жақта емес шығар.
Dialogue: 0,0:13:30.24,0:13:32.56,Default,,0,0,0,,Ақымақ қызды өлтіру
Dialogue: 0,0:13:36.84,0:13:38.33,Default,,0,0,0,,Сен ақымақсың
Dialogue: 0,0:13:38.68,0:13:40.72,Default,,0,0,0,,Сізге тыныш ұйықтау керек.
Dialogue: 0,0:13:42.48,0:13:43.12,Default,,0,0,0,,Кота
Dialogue: 0,0:13:47.60,0:13:50.00,Default,,0,0,0,,Жарайды, мен үйден дәрі алып келейін.
Dialogue: 0,0:13:51.08,0:13:53.24,Default,,0,0,0,,Тек жылуды салқындату қажет болса
Dialogue: 0,0:13:53.36,0:13:54.52,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:13:55.00,0:13:56.36,Default,,0,0,0,,Олай болса, өтінемін.
Dialogue: 0,0:13:56.36,0:13:57.77,Default,,0,0,0,,Иә, өтінемін.
Dialogue: 0,0:13:57.96,0:14:00.96,Default,,0,0,0,,Ню-чан, енді тентектік жасама.
Dialogue: 0,0:14:16.84,0:14:18.17,Default,,0,0,0,,Себебі мен сенімен біргемін.
Dialogue: 0,0:14:18.48,0:14:19.92,Default,,0,0,0,,Ұйқыларыңыз тыныш болсын
Dialogue: 0,0:14:22.36,0:14:24.52,Default,,0,0,0,,Жылу тез суып кетуі керек.
Dialogue: 0,0:14:26.80,0:14:28.64,Default,,0,0,0,,Тез суытайық.
Dialogue: 0,0:14:51.32,0:14:53.28,Default,,0,0,0,,Баланың қызуы тағы көтерілді.
Dialogue: 0,0:14:53.56,0:14:55.08,Default,,0,0,0,,Мен сізден жеңіл болғаныңызды қалаймын.
Dialogue: 0,0:14:55.76,0:14:58.44,Default,,0,0,0,,Осыдан кейін менің уәдем бар еді.
Dialogue: 0,0:14:58.92,0:15:00.64,Default,,0,0,0,,Балаға мүлдем ұқсамайды
Dialogue: 0,0:15:00.64,0:15:01.97,Default,,0,0,0,,Жарық шіркін.
Dialogue: 0,0:15:02.40,0:15:03.97,Default,,0,0,0,,Және сол мүйіздер сияқты.
Dialogue: 0,0:15:04.32,0:15:05.20,Default,,0,0,0,,Қызық, бұл не?
Dialogue: 0,0:15:07.96,0:15:11.08,Default,,0,0,0,,Басқа балалар да бір бөлмеде болғысы келмейді.
Dialogue: 0,0:15:48.44,0:15:50.24,Default,,0,0,0,,Сіз уайымдап тұрсыз ба?
Dialogue: 0,0:15:51.36,0:15:54.33,Default,,0,0,0,,Ештеңе емес, жалғыздыққа үйреніп қалғанмын.
Dialogue: 0,0:15:54.72,0:15:56.60,Default,,0,0,0,,Мен жалғыз емеспін
Dialogue: 0,0:15:58.08,0:16:01.64,Default,,0,0,0,,Себебі мен өзімді жалғыз сезінбеймін
Dialogue: 0,0:16:04.08,0:16:06.08,Default,,0,0,0,,Эй, Кадо, бұл сенсің.
Dialogue: 0,0:16:06.40,0:16:10.08,Default,,0,0,0,,Ол сөмкемен не істеп жатырсың?
Dialogue: 0,0:16:10.40,0:16:12.76,Default,,0,0,0,,Сүт басып, сасық.
Dialogue: 0,0:16:13.88,0:16:16.00,Default,,0,0,0,,Сізге тек жауап беру керек.
Dialogue: 0,0:16:23.24,0:16:27.29,Default,,0,0,0,,Мен сізді орманды жерге тастап кеткенін естідім.
Dialogue: 0,0:16:27.52,0:16:30.28,Default,,0,0,0,,Жарайды, мүйіз өссе, лақтыруға болады.
Dialogue: 0,0:16:37.92,0:16:42.05,Default,,0,0,0,,Сен адам емессің, жынның баласысың.
Dialogue: 0,0:16:42.88,0:16:45.80,Default,,0,0,0,,Мұғалімдер бір-бірін ұнатпайтындарын айтып жатыр.
Dialogue: 0,0:16:53.80,0:16:56.68,Default,,0,0,0,,Мұғалім, Томоо сені тағы қорқытып жатыр.
Dialogue: 0,0:16:56.68,0:16:56.69,Default,,0,0,0,,Жоқ, қашайық.
Dialogue: 0,0:16:56.69,0:16:58.04,Default,,0,0,0,,Жоқ, қашайық.
Dialogue: 0,0:17:00.88,0:17:03.08,Default,,0,0,0,,Қызды қорлау - ең жаманы
Dialogue: 0,0:17:03.44,0:17:04.96,Default,,0,0,0,,Әй, жарайды.
Dialogue: 0,0:17:07.24,0:17:09.12,Default,,0,0,0,,Менің сөмкем сүтпен жабылған.
Dialogue: 0,0:17:10.36,0:17:12.04,Default,,0,0,0,,Қорқынышты істермен айналыспаңыз
Dialogue: 0,0:17:12.80,0:17:15.12,Default,,0,0,0,,Мұндағы балалардың бәрі бақытсыз.
Dialogue: 0,0:17:15.80,0:17:17.16,Default,,0,0,0,,Не?
Dialogue: 0,0:17:17.92,0:17:22.05,Default,,0,0,0,,Мен бақытсыз болғандықтан, маған менен қарағанда бақытсыз адам керек сияқты.
Dialogue: 0,0:17:24.56,0:17:25.56,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:17:30.12,0:17:32.44,Default,,0,0,0,,Қазір кептірсем жарай ма?
Dialogue: 0,0:17:32.80,0:17:35.80,Default,,0,0,0,,Ей, үнемі жалғыз қалма.
Dialogue: 0,0:17:36.56,0:17:40.04,Default,,0,0,0,,Егер қиналсаңыз, маған бірдеңе айтыңыз.
Dialogue: 0,0:17:40.56,0:17:42.32,Default,,0,0,0,,Бұл сізге көмектесетініне сенімдімін
Dialogue: 0,0:18:00.84,0:18:03.20,Default,,0,0,0,,Сіз қатты аш болған шығарсыз.
Dialogue: 0,0:18:06.92,0:18:12.56,Default,,0,0,0,,Сен болмасаң, мен баяғыда бас тартқан болар едім.
Dialogue: 0,0:18:16.72,0:18:20.36,Default,,0,0,0,,Кешіріңіз, сізді тамақтандыратын басқа ештеңем жоқ.
Dialogue: 0,0:18:22.96,0:18:25.72,Default,,0,0,0,,Мектептегі түскі астың жартысы жетпейді ғой.
Dialogue: 0,0:18:30.12,0:18:32.60,Default,,0,0,0,,Аш болсаң да, барма
Dialogue: 0,0:18:33.24,0:18:35.12,Default,,0,0,0,,Тіпті сізді қорлайды
Dialogue: 0,0:18:36.76,0:18:41.64,Default,,0,0,0,,Мен күштірек болсам, сені қорғай алар едім.
Dialogue: 0,0:18:45.44,0:18:47.20,Default,,0,0,0,,Ол күштірек болса
Dialogue: 0,0:19:11.40,0:19:18.28,Default,,0,0,0,,Ішімде тағы бірдеңе торға түскендей болды.
Dialogue: 0,0:19:33.00,0:19:33.76,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:19:35.12,0:19:36.64,Default,,0,0,0,,Консультация бар.
Dialogue: 0,0:19:38.12,0:19:40.32,Default,,0,0,0,,Керемет, менің итім бар.
Dialogue: 0,0:19:40.32,0:19:42.52,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:19:42.68,0:19:45.33,Default,,0,0,0,,Егер Тому мен басқалары білсе, сені қорлайды.
Dialogue: 0,0:19:47.20,0:19:50.80,Default,,0,0,0,,Жарайды, мен сендермен мектептегі түскі асымды бөлісемін.
Dialogue: 0,0:19:51.20,0:19:52.69,Default,,0,0,0,,Мен оны үнемі артта қалдырамын.
Dialogue: 0,0:19:54.40,0:19:56.08,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:19:56.20,0:19:57.56,Default,,0,0,0,,Бұл туралы ешкім білмеуі керек.
Dialogue: 0,0:19:57.56,0:20:01.28,Default,,0,0,0,,Иә, мен ешкімге айтпаймын, уайымдамаңыз.
Dialogue: 0,0:20:09.84,0:20:10.84,Default,,0,0,0,,Дос бұрыш
Dialogue: 0,0:20:12.72,0:20:14.68,Default,,0,0,0,,Сіз сондай тәкаппарсыз.
Dialogue: 0,0:20:14.84,0:20:16.49,Default,,0,0,0,,Мен адам болмасам да
Dialogue: 0,0:20:20.08,0:20:21.08,Default,,0,0,0,,Балалар
Dialogue: 0,0:20:24.56,0:20:26.68,Default,,0,0,0,,Жібер, тоқтат.
Dialogue: 0,0:20:26.80,0:20:30.24,Default,,0,0,0,,Мен сенің бұлай ренжігеніңді бірінші рет көріп тұрмын.
Dialogue: 0,0:20:30.24,0:20:34.24,Default,,0,0,0,,Жылауға да, күлуге де болмайды, бұл қорқынышты.
Dialogue: 0,0:20:34.60,0:20:37.36,Default,,0,0,0,,Жыла, жыла және жалбар.
Dialogue: 0,0:20:37.80,0:20:41.77,Default,,0,0,0,,Әйтпесе, сіздің орныңызда итіңіз қиналады.
Dialogue: 0,0:20:44.96,0:20:46.12,Default,,0,0,0,,Бұл. . . Бұл
Dialogue: 0,0:20:46.84,0:20:48.84,Default,,0,0,0,,Эй, мына итті теп!
Dialogue: 0,0:20:48.84,0:20:49.48,Default,,0,0,0,,Тоқта
Dialogue: 0,0:20:54.32,0:20:58.48,Default,,0,0,0,,тікелей қорқытуға қарағанда тиімдірек.
Dialogue: 0,0:21:02.64,0:21:03.88,Default,,0,0,0,,Мен сені ұстап тұрмын.
Dialogue: 0,0:21:16.04,0:21:18.77,Default,,0,0,0,,Бұл өтірік.
Dialogue: 0,0:21:19.28,0:21:21.72,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:21:22.64,0:21:23.52,Default,,0,0,0,,Тоқта
Dialogue: 0,0:21:24.12,0:21:27.24,Default,,0,0,0,,Не дедіңіз?
Dialogue: 0,0:21:28.52,0:21:29.80,Default,,0,0,0,,Өйткені, өйткені
Dialogue: 0,0:21:30.64,0:21:32.48,Default,,0,0,0,,Сенің бұлай істеп жатқаныңа сене алар емеспін.
Dialogue: 0,0:21:37.80,0:21:40.92,Default,,0,0,0,,Кешіріңіз, мен байқаусызда сөйледім.
Dialogue: 0,0:21:43.52,0:21:46.04,Default,,0,0,0,,Ол жұмысын тоқтатты.
Dialogue: 0,0:21:47.52,0:21:48.44,Default,,0,0,0,,Тым ерте
Dialogue: 0,0:21:52.20,0:21:53.92,Default,,0,0,0,,Өйткені мен бақытсызмын
Dialogue: 0,0:21:54.80,0:21:59.56,Default,,0,0,0,,Менің ойымша, маған менен бақытсыз нәрсе керек.
Dialogue: 0,0:22:00.44,0:22:04.28,Default,,0,0,0,,Адам емес нәрсе адам емес
Dialogue: 0,0:22:05.96,0:22:07.45,Default,,0,0,0,,Бұл сендерсіңдер, балалар.
Dialogue: 0,0:22:32.80,0:22:33.60,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:22:34.12,0:22:35.48,Default,,0,0,0,,Бұл менің кінәм
Dialogue: 0,0:22:36.68,0:22:41.12,Default,,0,0,0,,Неліктен мен басқалардан аздап ерекшеленетіндіктен, мұны бастан өткеруім керек?
Dialogue: 0,0:22:41.88,0:22:42.72,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:24:35.36,0:24:37.12,Default,,0,0,0,,Айналуды тоқтатпай
Dialogue: 0,0:24:37.60,0:24:40.72,Default,,0,0,0,,Бірақ ешқашан торға қосылмайды
Dialogue: 0,0:24:42.00,0:24:44.08,Default,,0,0,0,,Тіпті жарық сәулесі де жарқырайды
Dialogue: 0,0:24:44.32,0:24:47.56,Default,,0,0,0,,Ол тек тамақ іздеуге баса назар аударды.
Dialogue: 0,0:24:48.72,0:24:50.00,Default,,0,0,0,,Бұл жады
Dialogue: 0,0:24:50.44,0:24:53.56,Default,,0,0,0,,Қызға қандай мағына берді?
Dialogue: 0,0:24:54.84,0:24:57.00,Default,,0,0,0,,Келесі жолы Эльфен өтірік айтты 9-бөлім
Dialogue: 0,0:24:57.48,0:24:58.48,Default,,0,0,0,,Естеліктер
Dialogue: 0,0:24:59.98,0:25:05.98,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory