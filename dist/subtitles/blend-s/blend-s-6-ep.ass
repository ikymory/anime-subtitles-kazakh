Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:48.84,0:00:50.13,Default,,0,0,0,,Ичиго-сан
Dialogue: 0,0:00:52.59,0:00:54.64,Default,,0,0,0,,Өзен қалай?
Dialogue: 0,0:00:55.43,0:00:59.63,Default,,0,0,0,,Әлі аздап салқын, бірақ жақсы сезінеді деп үміттенемін.
Dialogue: 0,0:02:51.18,0:02:52.57,Default,,0,0,0,,Ум...
Dialogue: 0,0:02:53.06,0:02:55.18,Default,,0,0,0,,Неге өзенде ойнамайсың?
Dialogue: 0,0:02:55.52,0:02:56.85,Default,,0,0,0,,Жақсы сезінеді
Dialogue: 0,0:02:56.94,0:02:57.94,Default,,0,0,0,,Тоқта
Dialogue: 0,0:02:58.02,0:03:00.73,Default,,0,0,0,,Үнділерді далаға шығуға мәжбүрлемеңіз.
Dialogue: 0,0:03:00.81,0:03:03.23,Default,,0,0,0,,Бұл тамаша Синбоку кездесуі.
Dialogue: 0,0:03:03.32,0:03:04.78,Default,,0,0,0,,Неліктен өзен?
Dialogue: 0,0:03:04.86,0:03:06.11,Default,,0,0,0,,Караоке жақсы болар еді.
Dialogue: 0,0:03:06.24,0:03:07.57,Default,,0,0,0,,Қолдан келмейді ғой, иә?
Dialogue: 0,0:03:07.82,0:03:10.66,Default,,0,0,0,,Тас, қағаз, қайшы ойнап болған соң, өзен жағасында барбекю жасауды шештік.
Dialogue: 0,0:03:11.12,0:03:14.49,Default,,0,0,0,,Өзенге келгенім жақсы, бірақ мен бір орында қалғым келеді.
Dialogue: 0,0:03:14.79,0:03:15.58,Default,,0,0,0,,Бірақ
Dialogue: 0,0:03:16.04,0:03:17.29,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:03:18.04,0:03:21.00,Default,,0,0,0,,Біз мұнда әртүрлі заттарды дайындадық.
Dialogue: 0,0:03:21.25,0:03:22.92,Default,,0,0,0,,Ойнайтын нәрсе бар ма?
Dialogue: 0,0:03:28.22,0:03:29.51,Default,,0,0,0,,Мен есепшотты жақсы көремін
Dialogue: 0,0:03:32.26,0:03:35.27,Default,,0,0,0,,Оқиғаға дейін төзімділігімді сақтағым келеді.
Dialogue: 0,0:03:35.39,0:03:37.77,Default,,0,0,0,,Айтпақшы, жазғы комикс жақында қалды.
Dialogue: 0,0:03:38.23,0:03:41.19,Default,,0,0,0,,Мм, егер сіз біздің шеңберден сата алсаңыз.
Dialogue: 0,0:03:41.31,0:03:42.86,Default,,0,0,0,,Мен сізге билет беремін.
Dialogue: 0,0:03:43.31,0:03:44.11,Default,,0,0,0,,Иә? Шынайы ма?
Dialogue: 0,0:03:44.27,0:03:46.73,Default,,0,0,0,,Мен мұны істеймін. Мен есептеулерде жақсымын.
Dialogue: 0,0:03:46.73,0:03:49.03,Default,,0,0,0,,Бұл рас па? Рақмет сізге.
Dialogue: 0,0:03:49.20,0:03:52.24,Default,,0,0,0,,Ым, тым болмаса шашлык жеп алайық.
Dialogue: 0,0:04:00.00,0:04:02.00,Default,,0,0,0,,Менеджер, сен үйреніп қалғансың.
Dialogue: 0,0:04:03.92,0:04:07.30,Default,,0,0,0,,Аа, мен кішкентай кезімде бақшада шашлык жасайтынбыз.
Dialogue: 0,0:04:07.92,0:04:08.80,Default,,0,0,0,,Ичигока ше?
Dialogue: 0,0:04:13.22,0:04:15.89,Default,,0,0,0,,Мен Шичиринде күзгі гриль жасадым.
Dialogue: 0,0:04:16.35,0:04:19.18,Default,,0,0,0,,Жапондық барбекю
Dialogue: 0,0:04:20.81,0:04:22.27,Default,,0,0,0,,Баруға дайын
Dialogue: 0,0:04:23.06,0:04:26.32,Default,,0,0,0,,Енді сіз әкелген ингредиенттерді шығарыңыз.
Dialogue: 0,0:04:26.61,0:04:28.03,Default,,0,0,0,,Мен етмін
Dialogue: 0,0:04:28.40,0:04:29.65,Default,,0,0,0,,Мен көкөніспін
Dialogue: 0,0:04:30.15,0:04:32.41,Default,,0,0,0,,Мен күріш шарларын әкелдім.
Dialogue: 0,0:04:32.70,0:04:33.91,Default,,0,0,0,,Мен ішемін
Dialogue: 0,0:04:34.49,0:04:35.70,Default,,0,0,0,,Канаме храмы туралы не деуге болады?
Dialogue: 0,0:04:38.41,0:04:39.37,Default,,0,0,0,,тунец?
Dialogue: 0,0:04:41.87,0:04:42.75,Default,,0,0,0,,Керемет
Dialogue: 0,0:04:42.92,0:04:44.96,Default,,0,0,0,,Ата-анам маған рұқсат берді.
Dialogue: 0,0:04:44.96,0:04:46.63,Default,,0,0,0,,Бай адам күткендей
Dialogue: 0,0:04:47.59,0:04:48.34,Default,,0,0,0,,Менеджер
Dialogue: 0,0:04:48.38,0:04:49.92,Default,,0,0,0,,Сіз мұны шеше аласыз ба?
Dialogue: 0,0:04:50.34,0:04:53.26,Default,,0,0,0,,Күткендей, тунецпен тәжірибем жоқ.
Dialogue: 0,0:04:54.43,0:04:55.05,Default,,0,0,0,,Бірақ
Dialogue: 0,0:04:55.22,0:04:57.68,Default,,0,0,0,,Ичиго-санның маған әкелгені
Dialogue: 0,0:05:01.39,0:05:03.14,Default,,0,0,0,,Ас пісірейік
Dialogue: 0,0:05:11.07,0:05:11.95,Default,,0,0,0,,Дүкен менеджері
Dialogue: 0,0:05:12.95,0:05:14.41,Default,,0,0,0,,Бұл өте жаман емес.
Dialogue: 0,0:05:14.78,0:05:17.08,Default,,0,0,0,,Менің тунецпен тәжірибем жоқ.
Dialogue: 0,0:05:17.58,0:05:19.41,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:05:21.33,0:05:23.50,Default,,0,0,0,,Мен мұны беруді ұмытып кетіппін
Dialogue: 0,0:05:30.51,0:05:33.38,Default,,0,0,0,,Мен одан да көп пісіретін боламын, сондықтан тамақтаныңыз.
Dialogue: 0,0:05:37.26,0:05:38.68,Default,,0,0,0,,Дәмді
Dialogue: 0,0:05:39.14,0:05:41.43,Default,,0,0,0,,Ең жақсы барбекю
Dialogue: 0,0:05:42.06,0:05:44.56,Default,,0,0,0,,Бұрынғы әлсіз жер қайдан шықты?
Dialogue: 0,0:05:49.36,0:05:53.40,Default,,0,0,0,,Мен менеджерге тунецтің ең жақсы бөлігін беремін.
Dialogue: 0,0:06:00.08,0:06:01.33,Default,,0,0,0,,Күте тұрыңыз, Мафую-сан.
Dialogue: 0,0:06:01.74,0:06:02.37,Default,,0,0,0,,Не?
Dialogue: 0,0:06:03.16,0:06:06.12,Default,,0,0,0,,Мен Мафуйю-санның ересек екенін білемін, бірақ
Dialogue: 0,0:06:06.21,0:06:08.38,Default,,0,0,0,,Бұл сурет
Dialogue: 0,0:06:13.13,0:06:15.17,Default,,0,0,0,,Әпкеңе берген уәде.
Dialogue: 0,0:06:17.64,0:06:19.85,Default,,0,0,0,,Бұл әлі де біртүрлі.
Dialogue: 0,0:06:21.93,0:06:23.47,Default,,0,0,0,,Амано-сан ішпейді ме?
Dialogue: 0,0:06:23.89,0:06:27.65,Default,,0,0,0,,Иә, менде ерекше сусын бар.
Dialogue: 0,0:06:29.40,0:06:32.23,Default,,0,0,0,,Бұл эксклюзивті ме?
Dialogue: 0,0:06:32.40,0:06:36.11,Default,,0,0,0,,Тауарды тапсырудың соңғы мерзімі ертең, солай ма?
Dialogue: 0,0:06:37.66,0:06:39.49,Default,,0,0,0,,Сіз бас тарта аласыз.
Dialogue: 0,0:06:39.74,0:06:40.95,Default,,0,0,0,,Қоғамдық жиын
Dialogue: 0,0:06:43.45,0:06:44.75,Default,,0,0,0,,Якусокку
Dialogue: 0,0:06:53.67,0:06:56.30,Default,,0,0,0,,Зефир жақсы тост жасады.
Dialogue: 0,0:06:56.63,0:06:57.63,Default,,0,0,0,,Иә, өтінемін.
Dialogue: 0,0:06:57.93,0:06:59.30,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:02.35,0:07:03.60,Default,,0,0,0,,Кахо-сан да өтінемін.
Dialogue: 0,0:07:04.52,0:07:05.56,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:05.56,0:07:06.18,Default,,0,0,0,,Жылу
Dialogue: 0,0:07:06.98,0:07:07.89,Default,,0,0,0,,Тек L өз ықпалындағы біреумен алмастырылған
Dialogue: 0,0:07:08.56,0:07:10.61,Default,,0,0,0,,Сақ болыңыз, күн ыстық.
Dialogue: 0,0:07:11.36,0:07:12.02,Default,,0,0,0,,Тіл
Dialogue: 0,0:07:13.73,0:07:16.07,Default,,0,0,0,,Иә, не гемахенка?
Dialogue: 0,0:07:22.03,0:07:23.20,Default,,0,0,0,,Ауа райы туралы не айтасыз?
Dialogue: 0,0:07:33.75,0:07:36.05,Default,,0,0,0,,Егер күн сәл ыстық болса, мен жүзе алар едім.
Dialogue: 0,0:07:36.51,0:07:37.63,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:07:38.55,0:07:39.05,Default,,0,0,0,,Иә
Dialogue: 0,0:07:39.63,0:07:42.18,Default,,0,0,0,,Ендеше, бұл жолы теңізді таңдайық.
Dialogue: 0,0:07:46.02,0:07:47.77,Default,,0,0,0,,Біртүрлі түсірілген болуы мүмкін.
Dialogue: 0,0:07:48.60,0:07:51.73,Default,,0,0,0,,Әрине, бәріңізбен бірге.
Dialogue: 0,0:07:52.86,0:07:54.77,Default,,0,0,0,,Барлығы және теңіз
Dialogue: 0,0:07:56.40,0:07:59.78,Default,,0,0,0,,Бірақ менде тек мектептегі купальник бар.
Dialogue: 0,0:08:02.24,0:08:06.62,Default,,0,0,0,,Ах, менеджер, келесі жолы купальник сатып алуға менімен бірге келе аласыз ба?
Dialogue: 0,0:08:07.95,0:08:08.87,Default,,0,0,0,,I
Dialogue: 0,0:08:09.96,0:08:12.13,Default,,0,0,0,,Ичигоның купальнигі
Dialogue: 0,0:08:16.34,0:08:16.84,Default,,0,0,0,,Біраз
Dialogue: 0,0:08:17.34,0:08:17.84,Default,,0,0,0,,Менеджер
Dialogue: 0,0:08:17.96,0:08:18.59,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:08:19.17,0:08:20.88,Default,,0,0,0,,Нақты...
Dialogue: 0,0:08:20.93,0:08:22.43,Default,,0,0,0,,Ол адамзат үшін баға жетпес мүмкіндік
Dialogue: 0,0:08:35.36,0:08:36.40,Default,,0,0,0,,О, құлпынай иісі
Dialogue: 0,0:08:37.32,0:08:38.48,Default,,0,0,0,,Сіз шығасыз ба?
Dialogue: 0,0:08:39.28,0:08:43.32,Default,,0,0,0,,Иә, бүгін мен дүкен менеджерімен купальник сатып алуға барамын.
Dialogue: 0,0:08:44.07,0:08:45.20,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:08:46.58,0:08:49.00,Default,,0,0,0,,Күте тұрыңыз, бұл Тед пе?
Dialogue: 0,0:08:51.33,0:08:54.46,Default,,0,0,0,,Ендеше, құр қол жүруге жол жоқ, Ичигока!
Dialogue: 0,0:08:57.50,0:09:00.09,Default,,0,0,0,,Маған естелік сыйлық берілді.
Dialogue: 0,0:09:04.26,0:09:05.05,Default,,0,0,0,,қатты, қатты
Dialogue: 0,0:09:05.14,0:09:07.31,Default,,0,0,0,,Жапондық інжу печеньесі
Dialogue: 0,0:09:14.98,0:09:16.65,Default,,0,0,0,,Ичиго-сан, осында.
Dialogue: 0,0:09:17.02,0:09:18.82,Default,,0,0,0,,Жүр, ішке кірейік.
Dialogue: 0,0:09:19.23,0:09:19.73,Default,,0,0,0,,Иә
Dialogue: 0,0:09:20.74,0:09:25.11,Default,,0,0,0,,Менеджер, сізге көп рахмет.
Dialogue: 0,0:09:25.53,0:09:28.62,Default,,0,0,0,,Жоқ, бұл арзан.
Dialogue: 0,0:09:28.91,0:09:31.16,Default,,0,0,0,,Ең жақсысын таңдаңыз
Dialogue: 0,0:09:39.13,0:09:41.76,Default,,0,0,0,,Бұған бір күн қажет болуы мүмкін.
Dialogue: 0,0:09:42.47,0:09:42.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:46.26,0:09:48.47,Default,,0,0,0,,Иә? Түрлі түрлері көп.
Dialogue: 0,0:09:49.60,0:09:54.27,Default,,0,0,0,,Мен Италияда болғанымда батыл киім киген адамдарды көп көрдім.
Dialogue: 0,0:09:58.90,0:10:02.15,Default,,0,0,0,,Ичиго-сан, мүмкін Сукумизу жақсырақ шығар.
Dialogue: 0,0:10:03.90,0:10:05.49,Default,,0,0,0,,Сіз жақсы нәрсе таптыңыз ба?
Dialogue: 0,0:10:06.95,0:10:09.16,Default,,0,0,0,,Мен жоғалып кететін нәрселер көп.
Dialogue: 0,0:10:11.70,0:10:15.33,Default,,0,0,0,,Содан кейін мен дүкендегі барлық адамдардан не ұнайтынын сұраймын.
Dialogue: 0,0:10:15.54,0:10:16.96,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:10:24.97,0:10:26.72,Default,,0,0,0,,Бұл мағынасы бар.
Dialogue: 0,0:10:34.06,0:10:36.69,Default,,0,0,0,,Әрбір адам шын мәнінде еркін.
Dialogue: 0,0:10:37.27,0:10:38.10,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:10:38.40,0:10:41.57,Default,,0,0,0,,Барлығында қандай купальник бар деп сұрайық.
Dialogue: 0,0:10:44.82,0:10:47.74,Default,,0,0,0,,Мен сұрауым керек пе еді?
Dialogue: 0,0:10:50.87,0:10:52.58,Default,,0,0,0,,О, дұрыс.
Dialogue: 0,0:10:54.45,0:10:57.33,Default,,0,0,0,,Ичиго мырза, мұндай нәрсе туралы не айтасыз?
Dialogue: 0,0:10:59.17,0:11:00.50,Default,,0,0,0,,Әдемі дизайн
Dialogue: 0,0:11:00.84,0:11:02.71,Default,,0,0,0,,Экспозиция көп емес пе?
Dialogue: 0,0:11:03.59,0:11:06.67,Default,,0,0,0,,Бұл қалыпты жағдай ма?
Dialogue: 0,0:11:08.43,0:11:10.18,Default,,0,0,0,,Содан кейін интернеттен іздеңіз.
Dialogue: 0,0:11:10.43,0:11:12.43,Default,,0,0,0,,Ағымдағы тенденцияларды тексерейік
Dialogue: 0,0:11:14.27,0:11:16.52,Default,,0,0,0,,Бұдан артық әшкерелеуге болмайды.
Dialogue: 0,0:11:16.81,0:11:19.02,Default,,0,0,0,,Салыстыру сәл басқаша.
Dialogue: 0,0:11:21.11,0:11:23.32,Default,,0,0,0,,Олай болса, мен оны киіп көрейін.
Dialogue: 0,0:11:23.57,0:11:24.07,Default,,0,0,0,,Иә
Dialogue: 0,0:11:29.70,0:11:30.24,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:32.03,0:11:34.29,Default,,0,0,0,,Бұл мата купальникпен бірге келеді.
Dialogue: 0,0:11:34.49,0:11:35.91,Default,,0,0,0,,Оны қалай кию керек?
Dialogue: 0,0:11:39.42,0:11:40.63,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:11:47.17,0:11:49.68,Default,,0,0,0,,Сол тұтынушы...
Dialogue: 0,0:11:52.30,0:11:54.48,Default,,0,0,0,,Бұл осылай жасалды.
Dialogue: 0,0:11:55.01,0:11:57.35,Default,,0,0,0,,Қызыл полка нүктелері сүйкімді
Dialogue: 0,0:11:59.94,0:12:01.48,Default,,0,0,0,,Қызыл түс есіме түсіреді
Dialogue: 0,0:12:01.94,0:12:05.15,Default,,0,0,0,,My skin has turned red due to sunburn.
Dialogue: 0,0:12:06.73,0:12:09.40,Default,,0,0,0,,Кейбір адамдардың терісі сезімтал болса, қызарып кетеді.
Dialogue: 0,0:12:09.65,0:12:10.36,Default,,0,0,0,,Иә
Dialogue: 0,0:12:10.78,0:12:13.57,Default,,0,0,0,,But I was pretty bad.
Dialogue: 0,0:12:14.37,0:12:15.83,Default,,0,0,0,,It becomes like an octopus.
Dialogue: 0,0:12:16.16,0:12:16.79,Default,,0,0,0,,Сегізаяқ?
Dialogue: 0,0:12:18.12,0:12:18.62,Default,,0,0,0,,Мен осы өмірді он жылдан астам уақыт бойы кешіп келемін
Dialogue: 0,0:12:19.66,0:12:20.29,Default,,0,0,0,,Сегізаяқ!
Dialogue: 0,0:12:21.00,0:12:25.04,Default,,0,0,0,,Олай болса, күйдірілген сегізаяқтан сақтық шараларын сақтаңыз.
Dialogue: 0,0:12:25.50,0:12:26.50,Default,,0,0,0,,Алдымен мынаны орындаңыз
Dialogue: 0,0:12:26.80,0:12:29.72,Default,,0,0,0,,Қалғандары күннен қорғайтын көзілдірік, капюшон және ұзын қолғап.
Dialogue: 0,0:12:29.72,0:12:31.05,Default,,0,0,0,,Мынау және мынау
Dialogue: 0,0:12:33.43,0:12:35.35,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:12:38.47,0:12:42.02,Default,,0,0,0,,Swimsuits have no meaning anymore.
Dialogue: 0,0:12:44.19,0:12:46.61,Default,,0,0,0,,I've decided, I'll do this.
Dialogue: 0,0:12:47.11,0:12:48.69,Default,,0,0,0,,It’s a cute pattern.
Dialogue: 0,0:12:49.36,0:12:53.03,Default,,0,0,0,,Isn't that just normal clothes?
Dialogue: 0,0:12:54.78,0:12:58.08,Default,,0,0,0,,Actually, this is a set with a swimsuit.
Dialogue: 0,0:13:05.04,0:13:06.25,Default,,0,0,0,,Менеджер
Dialogue: 0,0:13:06.54,0:13:08.42,Default,,0,0,0,,Тұтынушы
Dialogue: 0,0:13:21.56,0:13:23.89,Default,,0,0,0,,Бұл теңіз.
Dialogue: 0,0:13:26.06,0:13:27.57,Default,,0,0,0,,I'm glad it's sunny.
Dialogue: 0,0:13:27.86,0:13:28.36,Default,,0,0,0,,Иә
Dialogue: 0,0:13:33.40,0:13:35.24,Default,,0,0,0,,Why are they in the same outdoor area?
Dialogue: 0,0:13:35.24,0:13:37.20,Default,,0,0,0,,Is the tension different at sea?
Dialogue: 0,0:13:37.62,0:13:40.12,Default,,0,0,0,,This luggage is really heavy.
Dialogue: 0,0:13:40.37,0:13:43.62,Default,,0,0,0,,Оған ноутбуктер, планшеттер, ойын консольдері және т.б.
Dialogue: 0,0:13:43.62,0:13:44.83,Default,,0,0,0,,Оны тастамаңыз
Dialogue: 0,0:13:44.92,0:13:45.94,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:13:52.67,0:13:53.51,Default,,0,0,0,,Ичиго-чан
Dialogue: 0,0:14:00.64,0:14:02.81,Default,,0,0,0,,Ичиго-chan's swimsuit is cute
Dialogue: 0,0:14:02.89,0:14:03.89,Default,,0,0,0,,Сізге жақсы көрінеді
Dialogue: 0,0:14:04.10,0:14:08.06,Default,,0,0,0,,Бұл рас па? The store manager chose it with me.
Dialogue: 0,0:14:09.06,0:14:11.53,Default,,0,0,0,,I also really like it.
Dialogue: 0,0:14:12.32,0:14:15.03,Default,,0,0,0,,Дүкен менеджері таңдау керек болса, мен бұл Сукумизу болар деп ойладым.
Dialogue: 0,0:14:16.28,0:14:20.95,Default,,0,0,0,,Мм, мені мақтай аласыз ба, әлде жамандай аласыз ба?
Dialogue: 0,0:14:25.25,0:14:26.79,Default,,0,0,0,,What’s wrong, Akizuki-kun?
Dialogue: 0,0:14:26.96,0:14:28.33,Default,,0,0,0,,I looked around a lot
Dialogue: 0,0:14:29.71,0:14:31.05,Default,,0,0,0,,Жоқ, не?
Dialogue: 0,0:14:31.75,0:14:36.93,Default,,0,0,0,,Нағыз қыздың купальникін жақыннан көрген емеспін.
Dialogue: 0,0:14:37.97,0:14:39.22,Default,,0,0,0,,Көз қайда барады
Dialogue: 0,0:14:40.97,0:14:43.72,Default,,0,0,0,,I saw a lot of that at the school pool.
Dialogue: 0,0:14:43.72,0:14:47.31,Default,,0,0,0,,Ондай нәрсеге араласпа, ақымақ.
Dialogue: 0,0:14:51.27,0:14:54.86,Default,,0,0,0,,Мен Ичиго-санның ләззат алуы үшін барымды саламын.
Dialogue: 0,0:15:55.50,0:15:56.76,Default,,0,0,0,,Келесі
Dialogue: 0,0:15:57.34,0:15:57.97,Default,,0,0,0,,Миу-сан
Dialogue: 0,0:15:58.63,0:15:59.13,Default,,0,0,0,,Хината
Dialogue: 0,0:15:59.34,0:16:00.38,Default,,0,0,0,,Жаңалықтар «Батырлар өлтіруші» туралы әңгімеге толы болды
Dialogue: 0,0:16:00.38,0:16:00.97,Default,,0,0,0,,Иә
Dialogue: 0,0:16:01.01,0:16:02.34,Default,,0,0,0,,Уф… Таңертеңгісін-ақ шаршап біттім.
Dialogue: 0,0:16:09.27,0:16:10.06,Default,,0,0,0,,Алшақтық
Dialogue: 0,0:16:16.15,0:16:18.32,Default,,0,0,0,,Umi, I've been here before.
Dialogue: 0,0:16:18.40,0:16:20.20,Default,,0,0,0,,It's my first time swimming.
Dialogue: 0,0:16:20.49,0:16:23.12,Default,,0,0,0,,Менеджер, сіз әлі аяғыңызда тұрсыз ба?
Dialogue: 0,0:16:23.37,0:16:27.95,Default,,0,0,0,,Әлі де көп орын бар, бірақ бұл жерден тереңдей түсетін сияқты.
Dialogue: 0,0:16:28.79,0:16:30.71,Default,,0,0,0,,Ичиго-сан, абай бол.
Dialogue: 0,0:16:32.33,0:16:33.46,Default,,0,0,0,,Ичиго-сан
Dialogue: 0,0:16:36.50,0:16:40.67,Default,,0,0,0,,Амансың ба? Таяз жерлерге оралайық.
Dialogue: 0,0:16:41.13,0:16:42.13,Default,,0,0,0,,А, иә
Dialogue: 0,0:16:45.47,0:16:50.23,Default,,0,0,0,,Бұл дәстүрлі жапондық Moe анимациясы болуы мүмкін.
Dialogue: 0,0:16:50.68,0:16:52.27,Default,,0,0,0,,Бақытты бұзық!
Dialogue: 0,0:16:53.31,0:16:56.65,Default,,0,0,0,,Мен мұндай дәстүрлі жағдайды бастан кешіре алатыныма сене алар емеспін.
Dialogue: 0,0:16:59.32,0:17:03.49,Default,,0,0,0,,Ха! Бұл тамаша мүмкіндік. Қайта оралу ысырап емес пе?
Dialogue: 0,0:17:04.49,0:17:06.70,Default,,0,0,0,,Мен Ичиго-санды аяймын.
Dialogue: 0,0:17:07.16,0:17:09.04,Default,,0,0,0,,Біраз баяу...
Dialogue: 0,0:17:14.04,0:17:16.13,Default,,0,0,0,,Ой, кешіріңіз, мен қазір қайтамын.
Dialogue: 0,0:17:17.67,0:17:19.51,Default,,0,0,0,,Жарайды, орындалды!
Dialogue: 0,0:17:22.17,0:17:25.76,Default,,0,0,0,,Күрсін, құм салқын және жайлы сезінеді.
Dialogue: 0,0:17:25.76,0:17:27.81,Default,,0,0,0,,Оны да кейін көмемін.
Dialogue: 0,0:17:27.89,0:17:29.35,Default,,0,0,0,,О, жақсы.
Dialogue: 0,0:17:30.56,0:17:34.10,Default,,0,0,0,,Қайту, үйге қайт
Dialogue: 0,0:17:34.19,0:17:35.31,Default,,0,0,0,,Не болды?
Dialogue: 0,0:17:35.31,0:17:36.31,Default,,0,0,0,,Қайтару
Dialogue: 0,0:17:38.40,0:17:39.69,Default,,0,0,0,,Не?
Dialogue: 0,0:17:40.44,0:17:43.20,Default,,0,0,0,,Жоқ, егер сіз қазір Акидзуки-санға қарасаңыз.
Dialogue: 0,0:17:43.20,0:17:46.24,Default,,0,0,0,,Жазғы комикске арналған бонустық кітаптың мазмұнымен келу
Dialogue: 0,0:17:46.45,0:17:47.95,Default,,0,0,0,,дегеніміз не?
Dialogue: 0,0:17:48.45,0:17:52.58,Default,,0,0,0,,Құмның астында сіздің денеңізді көптеген жұмбақ шатырлар бұзады.
Dialogue: 0,0:17:52.62,0:17:54.00,Default,,0,0,0,,Ләззатқа батып кете жаздады
Dialogue: 0,0:17:54.00,0:17:57.00,Default,,0,0,0,,Бұл айналаңыздағылардың назарына түспеуге тырысу дегенді білдіреді.
Dialogue: 0,0:17:58.88,0:18:02.51,Default,,0,0,0,,Адамдарға қарап отырып бірдеңені ойлап отырмын...
Dialogue: 0,0:18:02.55,0:18:07.80,Default,,0,0,0,,Жоқ, соңғы кездері интернетте қабырғаға жабысып қалған адамдар туралы әңгімелерді көріп жүрмін.
Dialogue: 0,0:18:08.72,0:18:13.89,Default,,0,0,0,,Қозғалуға болмайтын жағдайларда азғындық сезімі болғаны жақсы.
Dialogue: 0,0:18:14.56,0:18:15.69,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:23.07,0:18:24.49,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:25.03,0:18:25.95,Default,,0,0,0,,Не?
Dialogue: 0,0:18:39.04,0:18:42.55,Default,,0,0,0,,Мен қырынған мұз сатып алайын деп жатырмын, сенімен барғаным үшін кешір.
Dialogue: 0,0:18:42.96,0:18:45.01,Default,,0,0,0,,Жоқ, бұл туралы алаңдамаңыз.
Dialogue: 0,0:18:45.80,0:18:49.18,Default,,0,0,0,,Ал, Кахо - Көк Гавайи.
Dialogue: 0,0:18:49.30,0:18:51.06,Default,,0,0,0,,Мафуйю-сан – лимон
Dialogue: 0,0:18:51.06,0:18:52.64,Default,,0,0,0,,Миу-сан - Ренью
Dialogue: 0,0:18:52.81,0:18:54.35,Default,,0,0,0,,Акидзуки-сан – қауын
Dialogue: 0,0:18:54.64,0:18:56.44,Default,,0,0,0,,Жақсы есімде.
Dialogue: 0,0:18:56.81,0:19:00.06,Default,,0,0,0,,Тапсырысты есте сақтау тұтынушыларға қызмет көрсетудің негізі болып табылады.
Dialogue: 0,0:19:02.27,0:19:04.74,Default,,0,0,0,,Мен сіріңке жасауды ойлап жүрмін.
Dialogue: 0,0:19:04.90,0:19:06.24,Default,,0,0,0,,Дүкен меңгерушісі не істеп жатыр?
Dialogue: 0,0:19:06.99,0:19:08.16,Default,,0,0,0,,Не болды?
Dialogue: 0,0:19:10.07,0:19:12.33,Default,,0,0,0,,Бір жерден кесілген сияқты.
Dialogue: 0,0:19:12.37,0:19:14.04,Default,,0,0,0,,Жарақат ауыр.
Dialogue: 0,0:19:17.50,0:19:19.83,Default,,0,0,0,,Хахаха, тез жуып, қамқорлық жаса.
Dialogue: 0,0:19:21.04,0:19:24.00,Default,,0,0,0,,Уау, мен жүре аламын, жүре аламын.
Dialogue: 0,0:19:26.63,0:19:29.76,Default,,0,0,0,,Осы жерде күте тұрыңыз, мен таңғыш сатып аламын.
Dialogue: 0,0:19:30.18,0:19:31.72,Default,,0,0,0,,Дүкен менеджері.
Dialogue: 0,0:19:34.47,0:19:35.97,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:37.02,0:19:38.60,Default,,0,0,0,,Бағалы теңіз болса да
Dialogue: 0,0:19:38.81,0:19:41.56,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:19:53.70,0:19:58.54,Default,,0,0,0,,Әй, мен ханшайымның құшақтайтыны деген қауесеттен естідім.
Dialogue: 0,0:19:59.33,0:20:02.58,Default,,0,0,0,,Қырылған мұз, қырылған мұз
Dialogue: 0,0:20:02.88,0:20:06.00,Default,,0,0,0,,Тез кел, қырылған мұз.
Dialogue: 0,0:20:07.01,0:20:08.38,Default,,0,0,0,,Бұл қандай ән?
Dialogue: 0,0:20:08.84,0:20:10.59,Default,,0,0,0,,Қырылған мұз әні
Dialogue: 0,0:20:16.01,0:20:19.60,Default,,0,0,0,,Мен су сатып алдым, алдымен жараны жуайын.
Dialogue: 0,0:20:19.85,0:20:20.39,Default,,0,0,0,,Иә
Dialogue: 0,0:20:26.61,0:20:30.40,Default,,0,0,0,,Менеджер, сіз бүгін үлкен сияқтысыз.
Dialogue: 0,0:20:32.03,0:20:37.70,Default,,0,0,0,,Бүгін маған дүкен менеджері үлкен қолдау көрсетті, сондықтан мен әдеттегіден үлкен болып көрінемін.
Dialogue: 0,0:20:39.50,0:20:45.92,Default,,0,0,0,,Мен оны жақсы түсіндіре алмаймын, бірақ бар дер едім.
Dialogue: 0,0:20:47.80,0:20:48.80,Default,,0,0,0,,Бұл біртүрлі, солай емес пе?
Dialogue: 0,0:20:49.34,0:20:52.09,Default,,0,0,0,,Дүкен меңгерушісін үнемі бақылап отырамын.
Dialogue: 0,0:20:57.10,0:20:58.81,Default,,0,0,0,,Бүгін күн ыстық, солай емес пе?
Dialogue: 0,0:20:59.56,0:21:01.56,Default,,0,0,0,,Әй, енді жаз ғой.
Dialogue: 0,0:21:08.69,0:21:11.65,Default,,0,0,0,,Ичиго-чан мен менеджер, кешігіп қалдыңыз.
Dialogue: 0,0:21:12.24,0:21:13.74,Default,,0,0,0,,Бірдеңе болды ма деп ойлаймын.
Dialogue: 0,0:21:14.82,0:21:18.79,Default,,0,0,0,,Әй, менде жазғы теңіз жағасындағы оқиға орын алатын сияқты.
Dialogue: 0,0:21:18.99,0:21:22.37,Default,,0,0,0,,Аңғал Ичиго-сан жазда қатты күйік туды.
Dialogue: 0,0:21:24.33,0:21:25.17,Default,,0,0,0,,Сүйіспеншілікті алдын ала көру, алдын ала ескерту
Dialogue: 0,0:21:25.17,0:21:26.29,Default,,0,0,0,,Ашыңыз және жинаңыз!
Dialogue: 0,0:21:26.29,0:21:27.67,Default,,0,0,0,,Мен үйдемін.
Dialogue: 0,0:21:35.97,0:21:37.60,Default,,0,0,0,,Бұл үлкен күйік емес пе?
Dialogue: 0,0:23:24.12,0:23:26.12,Default,,0,0,0,,Жел жақсы сезінеді.
Dialogue: 0,0:23:28.54,0:23:30.21,Default,,0,0,0,,Бүгін көңілді болдыңыз ба?
Dialogue: 0,0:23:33.13,0:23:33.63,Default,,0,0,0,,Иә
Dialogue: 0,0:23:36.01,0:23:36.76,Default,,0,0,0,,Келесі жолы
Dialogue: 0,0:23:37.11,0:23:39.15,Default,,0,0,0,,Банан мен құлпынаймен айналысады
Dialogue: 0,0:23:40.65,0:23:45.65,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
