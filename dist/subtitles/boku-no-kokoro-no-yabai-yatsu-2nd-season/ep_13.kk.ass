Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.46,0:00:03.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:03.87,0:00:05.92,Default,,0,0,0,,Ах, қайырлы таң.
Dialogue: 0,0:00:07.34,0:00:08.92,Default,,0,0,0,,Бұл жазғы киім емес пе?
Dialogue: 0,0:00:09.42,0:00:11.46,Default,,0,0,0,,Иә? Бұл Паян
Dialogue: 0,0:00:11.55,0:00:13.01,Default,,0,0,0,,Бұл маңызды емес
Dialogue: 0,0:00:13.09,0:00:14.01,Default,,0,0,0,,(Үкідің ұлуы)
Dialogue: 0,0:00:15.01,0:00:17.26,Default,,0,0,0,,Айтайын дегенім, бүгіннен бастап мен киім кидім.
Dialogue: 0,0:00:17.35,0:00:19.31,Default,,0,0,0,,Киімдерді аз-аздан байқамай шешіңіз.
Dialogue: 0,0:00:21.14,0:00:24.85,Default,,0,0,0,,Киіміңді ауыстырсаң, жаз мезгілі деп ойлайсың.
Dialogue: 0,0:00:24.94,0:00:26.27,Default,,0,0,0,,Дегенмен, кардиганнан
Dialogue: 0,0:00:26.35,0:00:27.81,Default,,0,0,0,,Оны кеудеше ауыстыра жаздады.
Dialogue: 0,0:00:27.90,0:00:28.82,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:29.61,0:00:31.82,Default,,0,0,0,,Белдемшенің матасы да мүлде басқа.
Dialogue: 0,0:00:31.90,0:00:32.65,Default,,0,0,0,,Оны түртіңіз
Dialogue: 0,0:00:39.49,0:00:42.04,Default,,0,0,0,,Не... неге жартылай шешіндіңіз?
Dialogue: 0,0:00:42.12,0:00:44.25,Default,,0,0,0,,Келіңіздер... Келіңіздер.
Dialogue: 0,0:00:45.04,0:00:47.04,Default,,0,0,0,,♪～
Dialogue: 0,0:02:12.92,0:02:14.92,Default,,0,0,0,,～♪
Dialogue: 0,0:02:15.55,0:02:18.80,Default,,0,0,0,,Жаз... Мен жек көретін мезгіл.
Dialogue: 0,0:02:18.88,0:02:20.76,Default,,0,0,0,,Бірақ биыл
Dialogue: 0,0:02:20.84,0:02:21.68,Default,,0,0,0,,Ямада осында
Dialogue: 0,0:02:21.76,0:02:22.80,Default,,0,0,0,,Кері тарту
Dialogue: 0,0:02:22.89,0:02:25.14,Default,,0,0,0,,Ақылға қонбайтын үміттерге жол бермеу
Dialogue: 0,0:02:25.64,0:02:28.06,Default,,0,0,0,,«Алтын апта» болған жоқ.
Dialogue: 0,0:02:28.14,0:02:30.85,Default,,0,0,0,,Ямада Сіз соңғы уақытта бос емес сияқтысыз.
Dialogue: 0,0:02:30.94,0:02:31.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:32.02,0:02:34.32,Default,,0,0,0,,(Ямаданың гуілдеуі)
Dialogue: 0,0:02:34.40,0:02:36.07,Default,,0,0,0,,Менің көңіл-күйім жақсы, Ямада.
Dialogue: 0,0:02:36.15,0:02:38.61,Default,,0,0,0,,Сіз қабылдандыңыз ба? тыңдау
Dialogue: 0,0:02:38.70,0:02:41.61,Default,,0,0,0,,Тыныш! Confidentiality Confidentiality
Dialogue: 0,0:02:41.70,0:02:43.45,Default,,0,0,0,,- (Йошида) Не? -(Андо) А?
Dialogue: 0,0:02:43.53,0:02:45.54,Default,,0,0,0,,Иә? Бір сәт...
Dialogue: 0,0:02:45.62,0:02:47.62,Default,,0,0,0,,Иә, баршаңызға қайырлы таң.
Dialogue: 0,0:02:48.45,0:02:52.25,Default,,0,0,0,,Бүгін көптен күткен мектеп саяхатына топты анықтайық!
Dialogue: 0,0:02:54.84,0:02:57.26,Default,,0,0,0,,Ммм... мммм!
Dialogue: 0,0:02:58.09,0:03:00.22,Default,,0,0,0,,Топты таңдау?
Dialogue: 0,0:03:01.63,0:03:04.18,Default,,0,0,0,,Иә? 12…
Dialogue: 0,0:03:05.51,0:03:06.35,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:06.93,0:03:07.97,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:03:08.06,0:03:10.02,Default,,0,0,0,,Не? Бол... Шынымен емес.
Dialogue: 0,0:03:10.10,0:03:11.64,Default,,0,0,0,,Анна
Dialogue: 0,0:03:12.23,0:03:14.27,Default,,0,0,0,,А... иә
Dialogue: 0,0:03:14.36,0:03:15.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:17.15,0:03:18.74,Default,,0,0,0,,- (Канзаки) Ичикава - (Ичикава) Иә?
Dialogue: 0,0:03:18.82,0:03:21.99,Default,,0,0,0,,Бір топта болайық. Ямаданы да шақыр.
Dialogue: 0,0:03:22.07,0:03:24.99,Default,,0,0,0,,Не? Ия... Ямада? неге?
Dialogue: 0,0:03:25.07,0:03:28.12,Default,,0,0,0,,Неге... біз доспыз, солай ма?
Dialogue: 0,0:03:29.08,0:03:32.00,Default,,0,0,0,,-(Ямада) Теңіз кірпі~ Теңіз кірпі~ -(Кобаяши) Я... тоқтатыңыз~
Dialogue: 0,0:03:32.08,0:03:33.37,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:34.00,0:03:35.75,Default,,0,0,0,,- (Ичикава) Мен айтайын - (Канзаки) Иә?
Dialogue: 0,0:03:35.84,0:03:37.21,Default,,0,0,0,,Мұнда, мұнда, мұнда, мұнда
Dialogue: 0,0:03:37.30,0:03:39.59,Default,,0,0,0,,Уф, тоқтат!
Dialogue: 0,0:03:39.67,0:03:40.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:40.88,0:03:41.88,Default,,0,0,0,,Не болды?
Dialogue: 0,0:03:41.97,0:03:46.14,Default,,0,0,0,,Егер қиналсаңыз, мен кіріп көмектесе аламын ба?
Dialogue: 0,0:03:47.47,0:03:49.60,Default,,0,0,0,,Барлығына! Ичикава кіріп келеді.
Dialogue: 0,0:03:49.68,0:03:50.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:50.56,0:03:52.94,Default,,0,0,0,,Жоқ, бұл бөлме үшін топ таңдауы.
Dialogue: 0,0:03:53.02,0:03:55.48,Default,,0,0,0,,Не? Бірақ... Бірақ Канзаки
Dialogue: 0,0:03:55.56,0:03:59.15,Default,,0,0,0,,Ямада - Теппей Ямада, солай ма?
Dialogue: 0,0:03:59.23,0:04:00.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:00.36,0:04:02.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:02.82,0:04:06.16,Default,,0,0,0,,Уф... бәрі жақсы емес.
Dialogue: 0,0:04:06.24,0:04:07.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:09.58,0:04:10.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:11.79,0:04:12.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:13.21,0:04:14.04,Default,,0,0,0,,Хехе
Dialogue: 0,0:04:21.80,0:04:26.39,Default,,0,0,0,,Қызық... кәдімгі Ямададан өзгеше.
Dialogue: 0,0:04:26.47,0:04:29.01,Default,,0,0,0,,Сізді алаңдататын нәрсе бар ма?
Dialogue: 0,0:04:29.10,0:04:30.39,Default,,0,0,0,,- (Қиялы Киоторо) Бірінші сүйісу - (Ичикава) Уф...
Dialogue: 0,0:04:30.47,0:04:31.64,Default,,0,0,0,,Не!
Dialogue: 0,0:04:31.72,0:04:33.64,Default,,0,0,0,,«Кимиоку» мектеп саяхаты басылымында
Dialogue: 0,0:04:33.73,0:04:35.02,Default,,0,0,0,,Бұл менің алғашқы сүйісім.
Dialogue: 0,0:04:35.10,0:04:37.44,Default,,0,0,0,,Сіз бұл туралы білуге ​​жақсы мүмкіндік бар.
Dialogue: 0,0:04:37.52,0:04:38.56,Default,,0,0,0,,«Бұрын ол жетімдер үйін басқарған».
Dialogue: 0,0:04:43.65,0:04:47.57,Default,,0,0,0,,Есіңізде ме? Мектепке саяхатта ма?
Dialogue: 0,0:04:52.79,0:04:55.08,Default,,0,0,0,,-(Ямада) Ылғалдыңыз. -(Ичикава) Иә.
Dialogue: 0,0:04:58.00,0:04:58.88,Default,,0,0,0,,Иә
Dialogue: 0,0:04:58.96,0:04:59.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:00.71,0:05:02.34,Default,,0,0,0,,Сіз мұны өзіңіз жасай аласыз
Dialogue: 0,0:05:02.42,0:05:04.63,Default,,0,0,0,,- (Ямада) Жақсы - (Ичикава) Жақсы!
Dialogue: 0,0:05:04.72,0:05:05.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:14.18,0:05:15.85,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:15.94,0:05:18.90,Default,,0,0,0,,Сіз не күтесіз? Сіз неге толқып тұрсыз?
Dialogue: 0,0:05:18.98,0:05:20.86,Default,,0,0,0,,Мектепке бару қызықсыз.
Dialogue: 0,0:05:20.94,0:05:24.03,Default,,0,0,0,,Мен ерекше араласпайтын адамдармен бірге түнеу.
Dialogue: 0,0:05:24.11,0:05:25.57,Default,,0,0,0,,Не қызық?
Dialogue: 0,0:05:26.24,0:05:26.90,Default,,0,0,0,,Ха…
Dialogue: 0,0:05:32.74,0:05:36.71,Default,,0,0,0,,Мен бармадым, сонда неге осында тұрсың?
Dialogue: 0,0:05:39.50,0:05:42.38,Default,,0,0,0,,Сіз оны асыға күтесіз бе?
Dialogue: 0,0:05:42.88,0:05:44.01,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:45.21,0:05:47.30,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:05:48.26,0:05:51.10,Default,,0,0,0,,Аа, сіз ояу болдыңыз ба? Хехе
Dialogue: 0,0:05:51.18,0:05:53.47,Default,,0,0,0,,Ах, «Кимиокудың» 12-томы
Dialogue: 0,0:05:53.56,0:05:56.93,Default,,0,0,0,,Не? А... Иә, мен көбірек сатып алдым.
Dialogue: 0,0:05:57.02,0:05:59.35,Default,,0,0,0,,Ендеше мен саған қарызға бергеніңді беремін.
Dialogue: 0,0:06:00.19,0:06:02.61,Default,,0,0,0,,Ямада оны да қайталап оқыды ма?
Dialogue: 0,0:06:03.11,0:06:07.65,Default,,0,0,0,,12 том Мектептегі саяхаттағы сүйісу көрінісі?
Dialogue: 0,0:06:08.40,0:06:12.41,Default,,0,0,0,,Сонымен, мектептегі саяхат...
Dialogue: 0,0:06:14.24,0:06:15.29,Default,,0,0,0,,Иә
Dialogue: 0,0:06:19.54,0:06:21.25,Default,,0,0,0,,Мектепке саяхат...
Dialogue: 0,0:06:21.33,0:06:22.79,Default,,0,0,0,,Бірдеңе дұрыс емес пе?
Dialogue: 0,0:06:22.88,0:06:23.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:25.25,0:06:26.13,Default,,0,0,0,,Иә
Dialogue: 0,0:06:26.71,0:06:27.63,Default,,0,0,0,,Ал...
Dialogue: 0,0:06:27.72,0:06:28.63,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:32.18,0:06:33.85,Default,,0,0,0,,Жоқ... ештеңе.
Dialogue: 0,0:06:33.93,0:06:34.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:35.39,0:06:37.18,Default,,0,0,0,,мектеп саяхатына бару
Dialogue: 0,0:06:37.77,0:06:39.14,Default,,0,0,0,,Мен «Хан Харири» деп аталатын базарға (сук) шағын сауда орны басқарамын
Dialogue: 0,0:06:39.64,0:06:42.27,Default,,0,0,0,,Кешіріңіз, экранды өшіре аламын ба?
Dialogue: 0,0:06:47.07,0:06:51.53,Default,,0,0,0,,Нарада қандай дәмді тағам бар деп ойлаймын...
Dialogue: 0,0:06:51.61,0:06:52.91,Default,,0,0,0,,Ә? Әйтеуір, ол Мисаға қатты ғашық қой.
Dialogue: 0,0:06:53.41,0:06:55.03,Default,,0,0,0,,Бұғы күріш крекерлері?
Dialogue: 0,0:06:55.12,0:06:57.12,Default,,0,0,0,,Оны біреудің тамағына айналдыр
Dialogue: 0,0:06:58.25,0:06:59.46,Default,,0,0,0,,Дегенмен, не болып жатқанын түсінбеймін.
Dialogue: 0,0:06:59.54,0:07:02.67,Default,,0,0,0,,Әйтеуір өзімді жайсыз, мазасыз сезінемін.
Dialogue: 0,0:07:02.75,0:07:05.96,Default,,0,0,0,,Мен дірілдей алмайтын жайсыздық сезімін сезінгенде...
Dialogue: 0,0:07:06.05,0:07:07.00,Default,,0,0,0,,(Шырылдаған дыбыс)
Dialogue: 0,0:07:07.09,0:07:08.42,Default,,0,0,0,,Не? Сізде суық бар ма?
Dialogue: 0,0:07:09.05,0:07:11.72,Default,,0,0,0,,Хмм... Менде бәрі жақсы.
Dialogue: 0,0:07:13.51,0:07:17.60,Default,,0,0,0,,Нара мен Киото мектебіне саяхат басталады
Dialogue: 0,0:07:18.10,0:07:19.31,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:07:19.39,0:07:20.69,Default,,0,0,0,,Не болды!
Dialogue: 0,0:07:20.77,0:07:24.19,Default,,0,0,0,,Анна өзі әкелген тағамдарды жеп қойған.
Dialogue: 0,0:07:24.27,0:07:25.36,Default,,0,0,0,,Атқа мінер алдында?
Dialogue: 0,0:07:25.44,0:07:27.90,Default,,0,0,0,,Мен оны қайтадан сатып аламын ба?
Dialogue: 0,0:07:27.98,0:07:30.44,Default,,0,0,0,,Сіз неліктен мүмкін емес деп ойлайсыз?
Dialogue: 0,0:07:30.53,0:07:31.61,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:07:31.70,0:07:34.66,Default,,0,0,0,,- (Ер оқушы) Әй, тамаша - (Студент қыз) Бірінші рет атқа міну
Dialogue: 0,0:07:36.41,0:07:38.12,Default,,0,0,0,,Ку…нууу…
Dialogue: 0,0:07:40.20,0:07:41.71,Default,,0,0,0,,Толық.
Dialogue: 0,0:07:41.79,0:07:42.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:43.71,0:07:44.21,Default,,0,0,0,,Ах
Dialogue: 0,0:07:44.29,0:07:46.84,Default,,0,0,0,,Мен... бағдар ретінде
Dialogue: 0,0:07:46.92,0:07:49.71,Default,,0,0,0,,- (Ямада) мөрі? Не? -(Ичикава) сөмке
Dialogue: 0,0:07:49.80,0:07:51.63,Default,,0,0,0,,Тез отыра аласыз ба?
Dialogue: 0,0:07:51.72,0:07:53.22,Default,,0,0,0,,Э? Ах…
Dialogue: 0,0:07:56.89,0:07:59.93,Default,,0,0,0,,Moeko терезесінің жағы 5 минут сайын
Dialogue: 0,0:08:00.02,0:08:01.77,Default,,0,0,0,,Тым қиын
Dialogue: 0,0:08:04.27,0:08:06.69,Default,,0,0,0,,О, құдайым... О, құдайым.
Dialogue: 0,0:08:06.77,0:08:07.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:12.61,0:08:13.86,Default,,0,0,0,,Мен сені ауыстырайын ба?
Dialogue: 0,0:08:14.36,0:08:15.49,Default,,0,0,0,,Бір ай бойы бірдей нәрсені естіп жүрсең, ештеңе сезбей қаласың.
Dialogue: 0,0:08:17.83,0:08:19.29,Default,,0,0,0,,- (Ханзава) А... - (Ичикава) Иә?
Dialogue: 0,0:08:19.37,0:08:22.54,Default,,0,0,0,,Күріш алқабында салынған кондоминиум
Dialogue: 0,0:08:23.12,0:08:24.54,Default,,0,0,0,,Менің жинақтағы ақшамнан тек 285 йен ғана қалды!
Dialogue: 0,0:08:25.04,0:08:26.71,Default,,0,0,0,,Бұл сұраныстың қандай түріне жатады?
Dialogue: 0,0:08:26.79,0:08:27.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:28.63,0:08:29.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:30.63,0:08:31.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:33.47,0:08:35.18,Default,,0,0,0,,- (Ханзава) Ичикава-кун - (Ичикава) Иә?
Dialogue: 0,0:08:36.22,0:08:40.10,Default,,0,0,0,,Осы үш күнде абай болғаныңыз жөн.
Dialogue: 0,0:08:40.18,0:08:43.35,Default,,0,0,0,,А... сақ болыңыз? Не?
Dialogue: 0,0:08:43.85,0:08:45.10,Default,,0,0,0,,Канна, қара.
Dialogue: 0,0:08:47.19,0:08:50.15,Default,,0,0,0,,- (Андо) Чокичоки... - (Ханзава) Бұл батаға арналған конфетти.
Dialogue: 0,0:08:50.65,0:08:54.49,Default,,0,0,0,,Осы мектептегі саяхатта мен жұп құрғым келеді.
Dialogue: 0,0:08:54.99,0:08:57.87,Default,,0,0,0,,Біз де флеш-мобты мұқият жаттықтыруға мәжбүр болдық.
Dialogue: 0,0:08:58.45,0:08:59.83,Default,,0,0,0,,Аа...
Dialogue: 0,0:08:59.91,0:09:03.75,Default,,0,0,0,,Мен ең ерекше атап өткендерім - Ичикава-кун мен Ямада-сан.
Dialogue: 0,0:09:03.83,0:09:04.46,Default,,0,0,0,,Не!
Dialogue: 0,0:09:04.54,0:09:07.88,Default,,0,0,0,,Бол... Ямада екеуімізде ерекше ештеңе жоқ.
Dialogue: 0,0:09:08.46,0:09:11.67,Default,,0,0,0,,Хмм, мен сізге кеңес бермеймін.
Dialogue: 0,0:09:13.30,0:09:17.68,Default,,0,0,0,,Ичикава мырза, сіз көптеген адамдардың қолдауымен өз сезімдеріңізді мойындағыңыз келе ме?
Dialogue: 0,0:09:18.43,0:09:21.60,Default,,0,0,0,,Сіз мұны жасамайынша мойындай алмайтын типсіз бе?
Dialogue: 0,0:09:22.10,0:09:24.14,Default,,0,0,0,,Кешіріңіз, мен жасырын жолаушымын.
Dialogue: 0,0:09:24.23,0:09:26.52,Default,,0,0,0,,Қазір... Қазір...
Dialogue: 0,0:09:27.02,0:09:27.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:29.94,0:09:32.36,Default,,0,0,0,,Мен сені өлтіре аламын ба? орындық
Dialogue: 0,0:09:32.44,0:09:33.86,Default,,0,0,0,,-(Ичикава) Әйтеуір -(Ямада) Не...
Dialogue: 0,0:09:34.61,0:09:36.32,Default,,0,0,0,,- (Ямада) Неге? -(Ичикава) Отырыңыз.
Dialogue: 0,0:09:36.40,0:09:38.36,Default,,0,0,0,,- (Ямада) Неліктен? -(Секине) 3 жасар бала ма?
Dialogue: 0,0:09:38.45,0:09:41.87,Default,,0,0,0,,- (Ичикава) Алға қара... - (Ханзава) Махаббат біртүрлі.
Dialogue: 0,0:09:41.95,0:09:43.37,Default,,0,0,0,,Неліктен неге!
Dialogue: 0,0:09:43.45,0:09:45.29,Default,,0,0,0,,«Неге, неге, неге» емес
Dialogue: 0,0:09:48.62,0:09:49.96,Default,,0,0,0,,Демек, шынымен де мұнда жартылай жұмыс істеуді бастапсың ғой.
Dialogue: 0,0:09:50.71,0:09:52.92,Default,,0,0,0,,Біртүрлі нәрселерге араласудан қалай аулақ болуға болады
Dialogue: 0,0:09:53.00,0:09:55.34,Default,,0,0,0,,Ямададан арақашықтықты сақтаған дұрыс.
Dialogue: 0,0:09:55.97,0:09:59.59,Default,,0,0,0,,Екеуміз бірге болмасам, тойлай алмаймын.
Dialogue: 0,0:09:59.68,0:10:02.60,Default,,0,0,0,,Өкінішке орай, әрекет тобы бірдей.
Dialogue: 0,0:10:02.68,0:10:06.02,Default,,0,0,0,,Неліктен бәрімізге күріш крекерін бермейсіздер?
Dialogue: 0,0:10:06.10,0:10:07.60,Default,,0,0,0,,Сен Құбыжықтарды жоюшылар корпусының мүшесі емессің бе?
Dialogue: 0,0:10:07.69,0:10:09.35,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:10:09.98,0:10:12.57,Default,,0,0,0,,Уау! Е, күте тұрыңыз... күтіңіз
Dialogue: 0,0:10:12.65,0:10:15.48,Default,,0,0,0,,Е, күте тұрыңыз! Отырыңыз
Dialogue: 0,0:10:15.57,0:10:19.45,Default,,0,0,0,,Тезірек оны маған беріңіз. Сіз Нараның түкпір-түкпірінен бұғы жинауды жоспарлап отырсыз ба?
Dialogue: 0,0:10:19.53,0:10:20.82,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:10:20.91,0:10:22.12,Default,,0,0,0,,А, өт!
Dialogue: 0,0:10:24.99,0:10:25.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:26.08,0:10:26.83,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:10:27.33,0:10:28.96,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:10:29.04,0:10:30.62,Default,,0,0,0,,- (Ичикава) Біраз күте тұрыңыз... - (Ямада) Күтіңіз, тыныш тұрыңыз.
Dialogue: 0,0:10:30.71,0:10:32.96,Default,,0,0,0,,- (Ичикава) Бұл не? Бұл не? -(Ямада) Сәл артқа шегін.
Dialogue: 0,0:10:33.04,0:10:34.42,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:10:34.50,0:10:35.34,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:35.42,0:10:37.01,Default,,0,0,0,,Неліктен!
Dialogue: 0,0:10:37.09,0:10:39.55,Default,,0,0,0,,Кетіңіз... Кетпесеңіз
Dialogue: 0,0:10:40.55,0:10:42.60,Default,,0,0,0,,Кешіріңіз! Ямада
Dialogue: 0,0:10:43.10,0:10:43.97,Default,,0,0,0,,барлығын бірге орналастырыңыз.
Dialogue: 0,0:10:44.06,0:10:45.43,Default,,0,0,0,,Аа...
Dialogue: 0,0:10:45.51,0:10:48.48,Default,,0,0,0,,Мен әзірге осыншама алыс болсам болады ма?
Dialogue: 0,0:10:49.60,0:10:50.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:53.19,0:10:55.32,Default,,0,0,0,,- (Ичикава) Мүмкін мен адасып қалған шығармын - (Кобаяши) А?
Dialogue: 0,0:10:56.78,0:10:59.20,Default,,0,0,0,,...
Dialogue: 0,0:11:03.24,0:11:05.41,Default,,0,0,0,,Ямада Бұл біртүрлі.
Dialogue: 0,0:11:05.99,0:11:06.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:07.29,0:11:08.91,Default,,0,0,0,,Түсінбейсің бе?
Dialogue: 0,0:11:09.00,0:11:12.67,Default,,0,0,0,,Жоқ, шиеленіс табиғи емес екені сөзсіз.
Dialogue: 0,0:11:13.25,0:11:15.88,Default,,0,0,0,,Бұл Ямаданың шешімі болды.
Dialogue: 0,0:11:15.96,0:11:18.09,Default,,0,0,0,,Менің басқа амалым жоқ
Dialogue: 0,0:11:18.17,0:11:20.13,Default,,0,0,0,,Мен біраз абдырап қалдым.
Dialogue: 0,0:11:20.22,0:11:22.51,Default,,0,0,0,,- (Ичикава) Сен шештің бе? -(Кобаяши) Иә.
Dialogue: 0,0:11:22.59,0:11:23.89,Default,,0,0,0,,Сіз бірдеңе білесіз бе?
Dialogue: 0,0:11:23.97,0:11:26.72,Default,,0,0,0,,А, Баяшико бар еді.
Dialogue: 0,0:11:26.81,0:11:29.31,Default,,0,0,0,,Топ басшысы жалғыз әрекет етпеуі керек.
Dialogue: 0,0:11:29.39,0:11:30.14,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:30.23,0:11:31.73,Default,,0,0,0,,Тез барайық
Dialogue: 0,0:11:32.23,0:11:34.19,Default,,0,0,0,,- (Кобаяши) Олай болса - (Ичикава) Ах.
Dialogue: 0,0:11:35.73,0:11:37.48,Default,,0,0,0,,Сіз өзіңіз шешім қабылдадыңыз ба?
Dialogue: 0,0:11:37.57,0:11:38.98,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:11:40.53,0:11:41.95,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:11:43.07,0:11:45.12,Default,,0,0,0,,(Андоның күлкісі)
Dialogue: 0,0:11:45.20,0:11:46.12,Default,,0,0,0,,Дұрыс тамақтаныңыз
Dialogue: 0,0:11:46.20,0:11:48.62,Default,,0,0,0,,А, сен қайда болдың?
Dialogue: 0,0:11:48.70,0:11:49.45,Default,,0,0,0,,Дәретхана
Dialogue: 0,0:11:51.46,0:11:53.42,Default,,0,0,0,,Жалғыз қалуға болмайды
Dialogue: 0,0:11:53.92,0:11:55.21,Default,,0,0,0,,Болмауы керек
Dialogue: 0,0:11:55.71,0:11:56.88,Default,,0,0,0,,Әлі де...
Dialogue: 0,0:11:58.05,0:11:59.84,Default,,0,0,0,,Иә, солай ма?
Dialogue: 0,0:12:00.34,0:12:02.51,Default,,0,0,0,,Нарадағы бұғылар сүйкімді...
Dialogue: 0,0:12:02.59,0:12:03.88,Default,,0,0,0,,Жақсы~
Dialogue: 0,0:12:03.97,0:12:05.05,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:12:05.14,0:12:08.31,Default,,0,0,0,,Мен Ямаданың жүрегін білгім келеді
Dialogue: 0,0:12:10.52,0:12:12.64,Default,,0,0,0,,Декки~
Dialogue: 0,0:12:14.77,0:12:17.48,Default,,0,0,0,,Мектеп саяхатының түні келді.
Dialogue: 0,0:12:17.57,0:12:19.48,Default,,0,0,0,,Сіз мұны жемейсіз бе?
Dialogue: 0,0:12:19.57,0:12:21.40,Default,,0,0,0,,Мен оны жеймін.
Dialogue: 0,0:12:21.49,0:12:24.28,Default,,0,0,0,,- (Ичикава) Менде бәрі жақсы, солай ма? - (Ямада) Мынаны аламын ба?
Dialogue: 0,0:12:24.36,0:12:25.82,Default,,0,0,0,,Генерал Гаки!
Dialogue: 0,0:12:25.91,0:12:27.99,Default,,0,0,0,,Хехехе, бұл дұрыс емес.
Dialogue: 0,0:12:28.08,0:12:30.83,Default,,0,0,0,,Бірақ ол кезде де солай болды.
Dialogue: 0,0:12:31.54,0:12:36.13,Default,,0,0,0,,Ямада сондай жетілген және байсалды көрінеді.
Dialogue: 0,0:12:37.25,0:12:39.46,Default,,0,0,0,,Мен бір нәрсеге сенімдімін...
Dialogue: 0,0:12:39.96,0:12:42.63,Default,,0,0,0,,Иә? иә? Ах...
Dialogue: 0,0:12:50.51,0:12:51.47,Default,,0,0,0,,Фуну
Dialogue: 0,0:12:53.81,0:12:56.48,Default,,0,0,0,,Жарайды, жарайды, мен оны тез жуып, тез шыға аламын...
Dialogue: 0,0:12:56.56,0:12:58.15,Default,,0,0,0,,О, Ичикава
Dialogue: 0,0:12:58.23,0:12:59.19,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:59.69,0:13:02.23,Default,,0,0,0,,Әтешпен ұрысайық. Әтеш ұрысайық.
Dialogue: 0,0:13:02.32,0:13:04.03,Default,,0,0,0,,Неліктен Адачи?
Dialogue: 0,0:13:04.11,0:13:05.86,Default,,0,0,0,,Екінші топ алдыңғы уақыттағы топ болды, солай ма?
Dialogue: 0,0:13:05.95,0:13:09.28,Default,,0,0,0,,Дұрыс. Мен қателесіп әйелдер моншасына кірмек болдым.
Dialogue: 0,0:13:09.37,0:13:11.70,Default,,0,0,0,,Үлкен уағыздың уақыты келді.
Dialogue: 0,0:13:11.79,0:13:12.87,Default,,0,0,0,,Дұрыс емес пе?
Dialogue: 0,0:13:12.95,0:13:16.37,Default,,0,0,0,,Ойлан, әйелдер мен балалар осындай.
Dialogue: 0,0:13:17.00,0:13:19.38,Default,,0,0,0,,А, кеуделерің тағы да үлкейіп кетті ме?
Dialogue: 0,0:13:19.46,0:13:21.13,Default,,0,0,0,,Сізге массаж жасауға рұқсат етіңіз~
Dialogue: 0,0:13:21.21,0:13:24.13,Default,,0,0,0,,...және олар бір-бірімен төбелесіп жатты.
Dialogue: 0,0:13:24.22,0:13:29.64,Default,,0,0,0,,Менің ойымша, бұл жерде әтеш төбелесу гендерлік тең қоғамның бөлігі болып табылады.
Dialogue: 0,0:13:29.72,0:13:31.97,Default,,0,0,0,,Адачи Сіз ілгерілеп жатырсыз.
Dialogue: 0,0:13:32.06,0:13:33.14,Default,,0,0,0,,Хмф!
Dialogue: 0,0:13:33.22,0:13:34.48,Default,,0,0,0,,Канзаки, сен...
Dialogue: 0,0:13:34.56,0:13:36.85,Default,,0,0,0,,Ома Ома... Бұл сенсің, сен.
Dialogue: 0,0:13:36.94,0:13:38.48,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:13:38.98,0:13:41.69,Default,,0,0,0,,- (Адачи) Ичикава Бұл өтірік, солай ма? -(Ичикава) Эй!
Dialogue: 0,0:13:41.77,0:13:43.19,Default,,0,0,0,,Бұл ең нашар!
Dialogue: 0,0:13:44.28,0:13:45.69,Default,,0,0,0,,Хаа~
Dialogue: 0,0:13:45.78,0:13:48.36,Default,,0,0,0,,Өйткені, үлкен ванна жақсы.
Dialogue: 0,0:13:48.45,0:13:51.28,Default,,0,0,0,,Иә? не болды? Барлығы
Dialogue: 0,0:13:51.37,0:13:55.00,Default,,0,0,0,,Қызық, мен оны тегін көре аламын ба?
Dialogue: 0,0:13:55.08,0:13:56.12,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:13:56.21,0:13:57.79,Default,,0,0,0,,Букубуку…
Dialogue: 0,0:13:57.87,0:14:00.92,Default,,0,0,0,,Неліктен Мо қатерлі ісік ауруын көру қиынға соқты?
Dialogue: 0,0:14:01.00,0:14:03.55,Default,,0,0,0,,Иә, секундына 1000 иен.
Dialogue: 0,0:14:03.63,0:14:05.88,Default,,0,0,0,,1000, 2000, 3000...
Dialogue: 0,0:14:05.97,0:14:07.42,Default,,0,0,0,,Бұл күмәнді дүкен.
Dialogue: 0,0:14:07.51,0:14:10.89,Default,,0,0,0,,Хаа... Мен қызып тұрмын, сондықтан мен көтерілемін.
Dialogue: 0,0:14:10.97,0:14:12.93,Default,,0,0,0,,- (Ханзава) Мен де - (Йошида) Фу~
Dialogue: 0,0:14:13.01,0:14:14.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:19.06,0:14:20.56,Default,,0,0,0,,Жүзу дұрыс па?
Dialogue: 0,0:14:20.65,0:14:21.73,Default,,0,0,0,,Тоқта
Dialogue: 0,0:14:21.81,0:14:22.77,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:14:26.57,0:14:29.03,Default,,0,0,0,,Бұл көңілді ме? мектептегі саяхат
Dialogue: 0,0:14:30.66,0:14:32.99,Default,,0,0,0,,Иә, өте көп
Dialogue: 0,0:14:36.87,0:14:40.21,Default,,0,0,0,,Мен бөлмеме қайтып, шашымды тез құрғатамын.
Dialogue: 0,0:14:40.29,0:14:42.67,Default,,0,0,0,,А, онда сіз алға қарай жүре аласыз.
Dialogue: 0,0:14:42.75,0:14:45.05,Default,,0,0,0,,Хмм, а, сонда...
Dialogue: 0,0:14:49.88,0:14:50.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:55.81,0:14:57.31,Default,,0,0,0,,Иә? Эх...
Dialogue: 0,0:14:58.10,0:14:59.31,Default,,0,0,0,,- (Ичикава) Ямада - (Ямада) Ах!
Dialogue: 0,0:14:59.39,0:15:01.02,Default,,0,0,0,,Ой...
Dialogue: 0,0:15:01.10,0:15:02.06,Default,,0,0,0,,Абуна
Dialogue: 0,0:15:03.98,0:15:05.82,Default,,0,0,0,,- (Ямада) Рахмет - (Ичикава) Иә?
Dialogue: 0,0:15:06.57,0:15:09.82,Default,,0,0,0,,Кими жақсы… AD?
Dialogue: 0,0:15:10.74,0:15:12.24,Default,,0,0,0,,Уф, тым қызықсыз екен.
Dialogue: 0,0:15:12.32,0:15:14.12,Default,,0,0,0,,Міне! гүл себет гүл себет
Dialogue: 0,0:15:14.20,0:15:15.16,Default,,0,0,0,,Мен шомылып жатқанмын.
Dialogue: 0,0:15:15.24,0:15:16.74,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:15:17.24,0:15:18.95,Default,,0,0,0,,О, Ичикава
Dialogue: 0,0:15:19.04,0:15:21.92,Default,,0,0,0,,Әтеш ұрысы қыза түсті.
Dialogue: 0,0:15:22.50,0:15:25.17,Default,,0,0,0,,Сіз таңғаларлық жақсы жекпе-жек көрсеттіңіз.
Dialogue: 0,0:15:25.25,0:15:26.96,Default,,0,0,0,,О, о...
Dialogue: 0,0:15:27.46,0:15:28.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:29.97,0:15:31.84,Default,,0,0,0,,Tsk! жанасудағы айырмашылық
Dialogue: 0,0:15:35.26,0:15:36.93,Default,,0,0,0,,- (Ичикава) Рахмет! -(Адачи) А?
Dialogue: 0,0:15:55.32,0:15:56.53,Default,,0,0,0,,Хаа…
Dialogue: 0,0:15:59.04,0:16:01.29,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:16:01.37,0:16:05.46,Default,,0,0,0,,Ертеңгі күні «Кимиоку А.Д.»
Dialogue: 0,0:16:05.96,0:16:07.59,Default,,0,0,0,,Шығарылған күні?
Dialogue: 0,0:16:07.67,0:16:10.34,Default,,0,0,0,,Жоқ, соңғы басылым бір күні ғана шықты.
Dialogue: 0,0:16:10.42,0:16:12.26,Default,,0,0,0,,Келісім жасасамыз ба?
Dialogue: 0,0:16:12.34,0:16:13.72,Default,,0,0,0,,Бұл шешім қабылданған болуы керек.
Dialogue: 0,0:16:13.80,0:16:14.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:14.39,0:16:18.47,Default,,0,0,0,,Бұл мектеп саяхатының соңғы күнінде сүйісу дегенді білдіреді.
Dialogue: 0,0:16:18.56,0:16:20.47,Default,,0,0,0,,«Кимиоку» 12 томымен бірдей
Dialogue: 0,0:16:20.56,0:16:22.85,Default,,0,0,0,,Мұндай жерде көрінбе!
Dialogue: 0,0:16:23.35,0:16:24.48,Default,,0,0,0,,- (Қиялдағы Киоторо) Иа - (Ичикава) Иә?
Dialogue: 0,0:16:25.35,0:16:26.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:26.15,0:16:27.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:27.48,0:16:30.03,Default,,0,0,0,,Осының дәл астында Хара мырзаның бөлмесі.
Dialogue: 0,0:16:30.61,0:16:33.32,Default,,0,0,0,,Бұл Шимогахараның бөлмесі
Dialogue: 0,0:16:33.40,0:16:35.03,Default,,0,0,0,,Көремін, көремін.
Dialogue: 0,0:16:35.78,0:16:36.78,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:36.87,0:16:39.54,Default,,0,0,0,,Көремін, көремін, көремін.
Dialogue: 0,0:16:39.62,0:16:41.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:41.37,0:16:42.66,Default,,0,0,0,,Тс… Тағы да кірлеп кетті.
Dialogue: 0,0:16:44.00,0:16:45.33,Default,,0,0,0,,Мынау
Dialogue: 0,0:16:45.42,0:16:47.04,Default,,0,0,0,,Сол қыздың шаш түсіне ұқсас шашы бар қыз…
Dialogue: 0,0:16:47.54,0:16:48.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:48.25,0:16:49.71,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:16:50.21,0:16:53.76,Default,,0,0,0,,Оның орнына, оны сүйіспеншілікке қалай енгізу туралы ойланыңыз.
Dialogue: 0,0:16:55.26,0:16:56.18,Default,,0,0,0,,Бұл ертең.
Dialogue: 0,0:16:56.26,0:16:57.55,Default,,0,0,0,,Жоқ
Dialogue: 0,0:16:58.05,0:17:00.47,Default,,0,0,0,,Ямада бұл туралы ойламайды.
Dialogue: 0,0:17:00.97,0:17:04.18,Default,,0,0,0,,Ямада... Ямада байсалдырақ.
Dialogue: 0,0:17:04.27,0:17:06.02,Default,,0,0,0,,Нақтырақ
Dialogue: 0,0:17:06.10,0:17:07.94,Default,,0,0,0,,Сонымен, сіз нені айтасыз?
Dialogue: 0,0:17:08.44,0:17:09.44,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:09.52,0:17:11.28,Default,,0,0,0,,- (Ямада) Мен де - (2 адам) А?
Dialogue: 0,0:17:12.07,0:17:15.45,Default,,0,0,0,,Сондықтан мен де солай айтып отырмын.
Dialogue: 0,0:17:16.03,0:17:18.16,Default,,0,0,0,,Әлемдегі ең жақсы
Dialogue: 0,0:17:19.07,0:17:21.49,Default,,0,0,0,,Жоқ, дұрыс айтыңыз.
Dialogue: 0,0:17:22.24,0:17:26.67,Default,,0,0,0,,Мен тағы да дұрыс айтамын, сондықтан мұқият тыңдаңыз.
Dialogue: 0,0:17:26.75,0:17:30.17,Default,,0,0,0,,Ах... Ямада
Dialogue: 0,0:17:31.80,0:17:34.59,Default,,0,0,0,,Маған ұнайды... Маған ұнайды
Dialogue: 0,0:17:35.88,0:17:37.43,Default,,0,0,0,,Нигорикава-кун
Dialogue: 0,0:17:39.89,0:17:40.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:56.78,0:18:00.20,Default,,0,0,0,,Көңілді... Бұл қызық
Dialogue: 0,0:18:04.12,0:18:05.00,Default,,0,0,0,,Қазір ғана…
Dialogue: 0,0:18:06.16,0:18:07.50,Default,,0,0,0,,«Кимиоку»
Dialogue: 0,0:18:08.08,0:18:10.46,Default,,0,0,0,,Бұл Ямаданың шешімі болды.
Dialogue: 0,0:18:10.54,0:18:12.17,Default,,0,0,0,,Менің басқа амалым жоқ
Dialogue: 0,0:18:12.75,0:18:15.42,Default,,0,0,0,,Не? А... Иә, мен көбірек сатып алдым.
Dialogue: 0,0:18:15.96,0:18:19.18,Default,,0,0,0,,Сіз қабылдандыңыз ба? тыңдау
Dialogue: 0,0:18:19.26,0:18:23.01,Default,,0,0,0,,Кими жақсы… Тыңдау
Dialogue: 0,0:18:23.51,0:18:25.47,Default,,0,0,0,,Сонда сіз нені айтасыз?
Dialogue: 0,0:18:25.97,0:18:28.44,Default,,0,0,0,,Сіз оқуға қабылданамын деп ойламағандықтан мектеп сапарына келдіңіз, солай емес пе?
Dialogue: 0,0:18:29.23,0:18:30.19,Default,,0,0,0,,Жоқ
Dialogue: 0,0:18:30.27,0:18:33.15,Default,,0,0,0,,Сонымен қатар, мектеп саяхаты өмірде бір рет болады.
Dialogue: 0,0:18:33.65,0:18:35.65,Default,,0,0,0,,Тыңдау дегеніміз не? Қалағаныңызша мүмкіндігіңіз бар...
Dialogue: 0,0:18:35.73,0:18:36.32,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:18:36.90,0:18:39.86,Default,,0,0,0,,Егер сіз шынымен осылай ойласаңыз, сіз ондай әрекет жасамас едіңіз.
Dialogue: 0,0:18:39.95,0:18:41.45,Default,,0,0,0,,Өйткені мен тірі жеп қойылудан шын мәнінде қорқамын
Dialogue: 0,0:18:41.53,0:18:44.12,Default,,0,0,0,,Біріншіден, Ямада мұндай нәрселер туралы ойламайды.
Dialogue: 0,0:18:44.20,0:18:46.37,Default,,0,0,0,,Қабылдауым екіталай, сондықтан мұнда келмеймін.
Dialogue: 0,0:18:46.45,0:18:48.62,Default,,0,0,0,,Онда не үшін келдің?
Dialogue: 0,0:18:49.21,0:18:50.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:50.96,0:18:52.63,Default,,0,0,0,,Жоқ... ештеңе.
Dialogue: 0,0:18:52.71,0:18:53.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:54.42,0:18:56.38,Default,,0,0,0,,Мектепке саяхатқа бару
Dialogue: 0,0:18:59.59,0:19:01.97,Default,,0,0,0,,Менің...
Dialogue: 0,0:19:02.47,0:19:03.39,Default,,0,0,0,,(Шырылдаған дыбыс)
Dialogue: 0,0:19:03.47,0:19:05.18,Default,,0,0,0,,Не? Сізде суық бар ма?
Dialogue: 0,0:19:05.72,0:19:08.43,Default,,0,0,0,,Хмм... Менде бәрі жақсы.
Dialogue: 0,0:19:08.93,0:19:11.73,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:19:12.52,0:19:13.61,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:17.86,0:19:18.99,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,0:19:22.07,0:19:25.41,Default,,0,0,0,,Мен әрқашан ақымақ боламын
Dialogue: 0,0:19:28.00,0:19:29.54,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:19:32.37,0:19:35.25,Default,,0,0,0,,Біраз ойланып қарасаңыз, түсінесіз!
Dialogue: 0,0:19:35.34,0:19:37.55,Default,,0,0,0,,Бірақ мен сүйіспеншілікке толы болдым.
Dialogue: 0,0:19:39.42,0:19:40.88,Default,,0,0,0,,Жарықты сөндіретін уақыт таяп қалды.
Dialogue: 0,0:19:40.97,0:19:41.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:41.88,0:19:43.55,Default,,0,0,0,,Мен бірден қайтамын
Dialogue: 0,0:19:43.64,0:19:48.56,Default,,0,0,0,,Ямада өз жұмысына қаншалықты байсалды және байсалды...
Dialogue: 0,0:19:49.64,0:19:52.19,Default,,0,0,0,,Сіздің сүйікті жұмысыңыз бойынша тыңдау
Dialogue: 0,0:19:52.27,0:19:55.44,Default,,0,0,0,,Бұрынғыдан да көп жұмыс істегеніңізге сенімдімін.
Dialogue: 0,0:19:55.94,0:20:00.32,Default,,0,0,0,,Қалған уақытта мектепке барыңыз, жұмыс жасаңыз және жаттығу жасаңыз.
Dialogue: 0,0:20:01.40,0:20:02.49,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:20:04.70,0:20:08.37,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:20:09.49,0:20:11.71,Default,,0,0,0,,Өйткені мен оны асыға күттім.
Dialogue: 0,0:20:13.12,0:20:15.42,Default,,0,0,0,,Орман мектебі де мені алдамады.
Dialogue: 0,0:20:16.34,0:20:17.42,Default,,0,0,0,,Мен...
Dialogue: 0,0:20:22.05,0:20:23.26,Default,,0,0,0,,- (Мория) Ямада? -(Ичикава) Ух...
Dialogue: 0,0:20:23.34,0:20:25.18,Default,,0,0,0,,Бұл сенің бөлмең емес пе?
Dialogue: 0,0:20:25.26,0:20:26.47,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:26.55,0:20:27.26,Default,,0,0,0,,Ямада?
Dialogue: 0,0:20:28.35,0:20:29.77,Default,,0,0,0,,- (Ямада) Иә? -(Ичикава) Ах...
Dialogue: 0,0:20:30.56,0:20:32.94,Default,,0,0,0,,- (Ямада) Не жасырып тұрсың? -(Ичикава) О, жоқ...
Dialogue: 0,0:20:33.02,0:20:35.10,Default,,0,0,0,,Не болды? Онда кім болды?
Dialogue: 0,0:20:35.19,0:20:36.44,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:20:39.07,0:20:40.90,Default,,0,0,0,,Иә? Кобаяши?
Dialogue: 0,0:20:40.98,0:20:42.90,Default,,0,0,0,,Не? А... бұл дұрыс.
Dialogue: 0,0:20:42.99,0:20:45.70,Default,,0,0,0,,Мен дұрыс емес бөлмеде тұрған сияқтымын.
Dialogue: 0,0:20:46.20,0:20:47.99,Default,,0,0,0,,Екеуі де сонда, солай ма?
Dialogue: 0,0:20:48.08,0:20:50.24,Default,,0,0,0,,Жүр, тезірек!
Dialogue: 0,0:20:50.83,0:20:53.50,Default,,0,0,0,,Иә, кірдім, кірдім, Қайырлы түн!
Dialogue: 0,0:20:54.33,0:20:55.50,Default,,0,0,0,,Ал, мақта...
Dialogue: 0,0:20:55.58,0:20:59.75,Default,,0,0,0,,Не? Эй, бұл...
Dialogue: 0,0:20:59.84,0:21:03.55,Default,,0,0,0,,Мм, топ жетекшісінің отырысы қызықсыз болды.
Dialogue: 0,0:21:05.59,0:21:07.09,Default,,0,0,0,,Иә?Не?
Dialogue: 0,0:21:07.18,0:21:09.35,Default,,0,0,0,,Жоқ, мен құладым.
Dialogue: 0,0:21:09.43,0:21:12.18,Default,,0,0,0,,- (Кобаяши) Абайлаңыз - (Ямада) Хехехе
Dialogue: 0,0:21:13.27,0:21:13.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:15.19,0:21:16.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:16.65,0:21:18.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:18.98,0:21:20.98,Default,,0,0,0,,♪～
Dialogue: 0,0:22:46.94,0:22:48.95,Default,,0,0,0,,～♪
