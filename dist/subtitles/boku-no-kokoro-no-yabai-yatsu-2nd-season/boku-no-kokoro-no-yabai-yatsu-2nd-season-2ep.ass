Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.75,0:00:06.13,Default,,0,0,0,,Мен Киоторо Ичикавамын
Dialogue: 0,0:00:07.54,0:00:08.88,Default,,0,0,0,,Кіші орта мектептің екінші курсы\NБүгіннен бастап
Dialogue: 0,0:00:10.01,0:00:11.51,Default,,0,0,0,,3 семестр
Dialogue: 0,0:00:13.43,0:00:17.60,Default,,0,0,0,,Бұл Анна Ямада
Dialogue: 0,0:00:17.68,0:00:18.72,Default,,0,0,0,,- (Ямада) Иә? -(Ичикава) Ух...
Dialogue: 0,0:00:18.81,0:00:19.81,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:00:19.89,0:00:22.73,Default,,0,0,0,,Ичикава-кун, шынында да сүйегің сынған.
Dialogue: 0,0:00:22.81,0:00:24.39,Default,,0,0,0,,Ямада осылай деді
Dialogue: 0,0:00:24.48,0:00:25.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:25.48,0:00:27.77,Default,,0,0,0,,Сіз Акитаның қарлы тауларында құладыңыз ба?
Dialogue: 0,0:00:27.86,0:00:28.65,Default,,0,0,0,,Чий!
Dialogue: 0,0:00:28.73,0:00:30.53,Default,,0,0,0,,Неге екені белгісіз мені қоршап алды
Dialogue: 0,0:00:30.61,0:00:31.74,Default,,0,0,0,,Додл жасайық
Dialogue: 0,0:00:31.82,0:00:32.74,Default,,0,0,0,,- (Ямада) Чий! -(Ёшида) Бұл хабар.
Dialogue: 0,0:00:32.82,0:00:34.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:34.45,0:00:37.03,Default,,0,0,0,,Сүйегің сынды деп, алданып қалма!
Dialogue: 0,0:00:37.12,0:00:38.87,Default,,0,0,0,,Оны жақсы нәрсе деп айтпа.
Dialogue: 0,0:00:39.78,0:00:41.12,Default,,0,0,0,,- (Кобаяши) А? -(Ичикава) Аа...
Dialogue: 0,0:00:41.20,0:00:42.54,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:00:42.62,0:00:44.62,Default,,0,0,0,,- (Ичикава) Бұл кетті - (Ямада) О, жоқ...
Dialogue: 0,0:00:45.21,0:00:45.75,Default,,0,0,0,,Ақыры шетелге шығу уақыты келді—
Dialogue: 0,0:00:46.79,0:00:49.34,Default,,0,0,0,,Сіз бос орын алуды мақсат етіп жатырсыз ба?
Dialogue: 0,0:00:49.42,0:00:52.21,Default,,0,0,0,,Мен оны жоғалтып аламын ба деп қорқамын, сондықтан оны қоямын.
Dialogue: 0,0:00:52.30,0:00:53.47,Default,,0,0,0,,-(Ямада) Эй -(Ичикава) Иә?
Dialogue: 0,0:00:54.17,0:00:56.51,Default,,0,0,0,,Егер сізде қандай да бір қиындық болса...
Dialogue: 0,0:00:56.59,0:00:58.01,Default,,0,0,0,,Да-яма
Dialogue: 0,0:00:58.09,0:01:01.31,Default,,0,0,0,,Мен Осакадан кәдесый әкелдім.
Dialogue: 0,0:01:03.39,0:01:04.39,Default,,0,0,0,,Айтыңызшы
Dialogue: 0,0:01:12.98,0:01:14.99,Default,,0,0,0,,♪～
Dialogue: 0,0:02:40.95,0:02:42.95,Default,,0,0,0,,～♪
Dialogue: 0,0:02:43.53,0:02:45.24,Default,,0,0,0,,Бұл апат болды.
Dialogue: 0,0:02:45.33,0:02:47.08,Default,,0,0,0,,Бұл ыңғайсыз, себебі бұл сіздің басым қолыңыз, солай ма?
Dialogue: 0,0:02:47.16,0:02:49.25,Default,,0,0,0,,Жоқ, мен үйреніп қалдым.
Dialogue: 0,0:02:49.87,0:02:52.79,Default,,0,0,0,,Біреуден көмек сұраған дұрыс емес пе?
Dialogue: 0,0:02:52.88,0:02:54.46,Default,,0,0,0,,Жоқ... га...
Dialogue: 0,0:02:55.09,0:02:58.51,Default,,0,0,0,,Бұл даму маған ең ұнамайтыны...
Dialogue: 0,0:02:58.59,0:03:01.47,Default,,0,0,0,,Сыныптағы ең жақын досың кім?
Dialogue: 0,0:03:01.55,0:03:04.51,Default,,0,0,0,,Міне! Студенттердің қандай жақсы досы...
Dialogue: 0,0:03:04.60,0:03:07.47,Default,,0,0,0,,Ямада ше...?
Dialogue: 0,0:03:07.56,0:03:08.77,Default,,0,0,0,,Орындар да жақын.
Dialogue: 0,0:03:09.27,0:03:11.19,Default,,0,0,0,,Я... Ямада...
Dialogue: 0,0:03:11.27,0:03:14.52,Default,,0,0,0,,Достарым көп, қолым бос емес.
Dialogue: 0,0:03:15.23,0:03:17.73,Default,,0,0,0,,Ямада мырза анда-санда ғана сөйлейді.
Dialogue: 0,0:03:17.82,0:03:19.19,Default,,0,0,0,,Екеуміз жақсы дос емеспіз.
Dialogue: 0,0:03:19.28,0:03:20.45,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:03:20.53,0:03:21.65,Default,,0,0,0,,Не болса да
Dialogue: 0,0:03:21.74,0:03:25.70,Default,,0,0,0,,Мен бір қолмен сыныпты да, мектептегі түскі асты да басқара аламын деп ойлаймын...
Dialogue: 0,0:03:26.41,0:03:26.95,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:31.92,0:03:33.92,Default,,0,0,0,,Нашар... Жаман Жаман
Dialogue: 0,0:03:34.00,0:03:36.46,Default,,0,0,0,,Неліктен бұл болып жатыр!
Dialogue: 0,0:03:36.54,0:03:37.42,Default,,0,0,0,,Өйткені…
Dialogue: 0,0:03:38.00,0:03:40.01,Default,,0,0,0,,Қысқы демалыста сәл ғана
Dialogue: 0,0:03:40.09,0:03:42.47,Default,,0,0,0,,Жақындап бара жатқанымызды сезсем де
Dialogue: 0,0:03:42.55,0:03:46.47,Default,,0,0,0,,Бәрін бұзатын менмін!
Dialogue: 0,0:03:49.60,0:03:52.60,Default,,0,0,0,,Өйткені, мен сол қолымды мүлде қуып жете алмаймын.
Dialogue: 0,0:03:53.10,0:03:53.73,Default,,0,0,0,,Не!
Dialogue: 0,0:03:55.19,0:03:57.69,Default,,0,0,0,,Менің біреуге көшірме беруден басқа амалым жоқ...
Dialogue: 0,0:03:58.48,0:03:59.19,Default,,0,0,0,,Ах
Dialogue: 0,0:04:01.28,0:04:02.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:04.07,0:04:05.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:05.24,0:04:06.28,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:06.78,0:04:08.28,Default,,0,0,0,,Иә, Хара мырза...
Dialogue: 0,0:04:08.37,0:04:12.21,Default,,0,0,0,,Жоқ, жоқ, мен бұл сөзсіз мүмкін емес сияқтымын!
Dialogue: 0,0:04:12.79,0:04:13.67,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:04:14.25,0:04:15.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:15.08,0:04:18.09,Default,,0,0,0,,Маған арқа сүйейтін сияқты.
Dialogue: 0,0:04:18.17,0:04:19.67,Default,,0,0,0,,Ямадаға
Dialogue: 0,0:04:19.75,0:04:20.67,Default,,0,0,0,,Ямада?
Dialogue: 0,0:04:21.59,0:04:23.01,Default,,0,0,0,,Жазбалардың көшірмесі?
Dialogue: 0,0:04:23.09,0:04:25.05,Default,,0,0,0,,Иә, Ичикаваға.
Dialogue: 0,0:04:25.13,0:04:27.97,Default,,0,0,0,,Менің қолжазбам лас.
Dialogue: 0,0:04:28.05,0:04:29.31,Default,,0,0,0,,...
Dialogue: 0,0:04:30.01,0:04:31.39,Default,,0,0,0,,«Сіз мұны менен сұрай аласыз ба?»
Dialogue: 0,0:04:31.47,0:04:34.10,Default,,0,0,0,,«Сен мейірімді және салқын болғандықтан, Адачи-кун жалғыз».
Dialogue: 0,0:04:34.19,0:04:36.19,Default,,0,0,0,,Маған солай деді хахаха
Dialogue: 0,0:04:36.27,0:04:38.52,Default,,0,0,0,,Сіз бұлай айтқан жоқсыз.
Dialogue: 0,0:04:38.61,0:04:41.32,Default,,0,0,0,,Уф... мен... сен олай айтпадың ба?
Dialogue: 0,0:04:45.11,0:04:46.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:46.20,0:04:47.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:52.95,0:04:54.08,Default,,0,0,0,,Тору, менімен бірге жүр. (Ишикава) Ээ…
Dialogue: 0,0:04:55.08,0:04:56.17,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:57.63,0:04:58.79,Default,,0,0,0,,Не?
Dialogue: 0,0:04:59.34,0:05:01.46,Default,,0,0,0,,Мұғалімге айтқаным
Dialogue: 0,0:05:02.05,0:05:05.68,Default,,0,0,0,,Мұғалімге айтқан сөзіңіз үшін өкінесіз бе?
Dialogue: 0,0:05:06.38,0:05:07.64,Default,,0,0,0,,Айтыңызшы
Dialogue: 0,0:05:07.72,0:05:09.43,Default,,0,0,0,,Ал...
Dialogue: 0,0:05:10.01,0:05:11.93,Default,,0,0,0,,Гу... бұл не?
Dialogue: 0,0:05:12.56,0:05:14.35,Default,,0,0,0,,А... Айтайын дегенім, бұл...
Dialogue: 0,0:05:15.27,0:05:19.48,Default,,0,0,0,,Ямаданың маған көмектесуіне рұқсат бергеніме өкінемін.
Dialogue: 0,0:05:20.19,0:05:26.07,Default,,0,0,0,,Бірақ шын мәнінде, мен сізге көбірек сенгім келеді...
Dialogue: 0,0:05:29.70,0:05:30.83,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:05:31.37,0:05:34.37,Default,,0,0,0,,Ммм!
Dialogue: 0,0:05:37.29,0:05:39.46,Default,,0,0,0,,Үйге қайту Көлікпен емес пе?
Dialogue: 0,0:05:39.54,0:05:42.13,Default,,0,0,0,,Анам қосымша жұмыс істейді, сондықтан мен үйге жаяу барамын.
Dialogue: 0,0:05:42.21,0:05:44.13,Default,,0,0,0,,Жарайды, мен саған сөмке алып келейін.
Dialogue: 0,0:05:44.21,0:05:45.63,Default,,0,0,0,,А... а... жоқ.
Dialogue: 0,0:05:46.42,0:05:47.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:48.93,0:05:50.39,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:05:54.97,0:05:57.94,Default,,0,0,0,,Сондай-ақ, Адачимен көп сөйлеспеңіз.
Dialogue: 0,0:05:58.02,0:06:00.48,Default,,0,0,0,,Неліктен? Неліктен неге?
Dialogue: 0,0:06:01.61,0:06:03.90,Default,,0,0,0,,Осыдан кейін, Ямада
Dialogue: 0,0:06:03.98,0:06:06.28,Default,,0,0,0,,Ол маған қандай да бір түрде қамқорлық жасай бастады.
Dialogue: 0,0:06:07.70,0:06:09.16,Default,,0,0,0,,Мен оны сенімен бірге тазалаймын.
Dialogue: 0,0:06:09.91,0:06:12.33,Default,,0,0,0,,Не? А... мен әлі сорпа ішіп жүрмін.
Dialogue: 0,0:06:12.41,0:06:12.91,Default,,0,0,0,,Ах
Dialogue: 0,0:06:12.99,0:06:15.41,Default,,0,0,0,,Жоқ... қаншалықты аз?
Dialogue: 0,0:06:16.00,0:06:17.54,Default,,0,0,0,,Гогого... Кешіріңіз!
Dialogue: 0,0:06:18.33,0:06:19.92,Default,,0,0,0,,Неге қалтырап тұрсың?
Dialogue: 0,0:06:21.33,0:06:24.09,Default,,0,0,0,,Гипс қолданылғаннан бері үш апта өтті.
Dialogue: 0,0:06:24.17,0:06:26.59,Default,,0,0,0,,Ыңғайсыз өмірге үйреніп қалдым, бірақ...
Dialogue: 0,0:06:27.09,0:06:28.13,Default,,0,0,0,,Бір… Келесі
Dialogue: 0,0:06:28.63,0:06:29.43,Default,,0,0,0,,Хмм
Dialogue: 0,0:06:34.47,0:06:36.39,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:06:37.18,0:06:38.31,Default,,0,0,0,,- (Ямада) Өтінемін! -(Ичикава) Иә?
Dialogue: 0,0:06:38.39,0:06:40.31,Default,,0,0,0,,(Зеницу) Незуко-чан, Танжиро~ (Танжиро) Тоқтат! Зенцу!
Dialogue: 0,0:06:41.81,0:06:43.61,Default,,0,0,0,,Кешіріңіз, мен оны өткізіп алдым.
Dialogue: 0,0:06:44.27,0:06:46.86,Default,,0,0,0,,Мен Ямаданың көмегіне үйренбегенмін.
Dialogue: 0,0:06:46.94,0:06:48.86,Default,,0,0,0,,Мынаны қараңыз.
Dialogue: 0,0:06:48.95,0:06:50.24,Default,,0,0,0,,Не? Бұл эротикалық кітап па?
Dialogue: 0,0:06:50.32,0:06:51.36,Default,,0,0,0,,Өте жаман
Dialogue: 0,0:06:51.45,0:06:53.95,Default,,0,0,0,,Ех! Бұл не айдол журналы?
Dialogue: 0,0:06:54.03,0:06:55.99,Default,,0,0,0,,Эй, Лемонзака, мен сені жақсы көремін.
Dialogue: 0,0:06:56.08,0:06:57.37,Default,,0,0,0,,Қарап көріңіз.
Dialogue: 0,0:06:57.45,0:07:00.12,Default,,0,0,0,,Мұндай журнал қалайша шу шығара алады?
Dialogue: 0,0:07:00.21,0:07:02.13,Default,,0,0,0,,Әлі де дөрекі адамдар...
Dialogue: 0,0:07:02.21,0:07:04.13,Default,,0,0,0,,Ооо, бұл Ямада!
Dialogue: 0,0:07:04.21,0:07:04.75,Default,,0,0,0,,Не!
Dialogue: 0,0:07:05.71,0:07:07.96,Default,,0,0,0,,Эй, менің сахналық есімім Акино.
Dialogue: 0,0:07:08.05,0:07:10.97,Default,,0,0,0,,Бірақ Ямада мырза үлгі емес пе?
Dialogue: 0,0:07:11.05,0:07:13.39,Default,,0,0,0,,Не, сен мұны білмейсің бе?
Dialogue: 0,0:07:13.47,0:07:13.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:14.05,0:07:16.43,Default,,0,0,0,,Модельдер ғана емес, эстрадалық фильмдер және т.б.
Dialogue: 0,0:07:16.51,0:07:17.72,Default,,0,0,0,,Мен көп нәрсені істеп жатырмын.
Dialogue: 0,0:07:17.81,0:07:19.64,Default,,0,0,0,,Кеңсе ұсынған шығар
Dialogue: 0,0:07:21.39,0:07:21.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:22.52,0:07:24.06,Default,,0,0,0,,Ол жоғалды...
Dialogue: 0,0:07:24.56,0:07:27.53,Default,,0,0,0,,Жоқ, бірақ айдол журналында көрсетілген...
Dialogue: 0,0:07:27.61,0:07:29.90,Default,,0,0,0,,Идол журналында көрсетілу дегенді білдіреді
Dialogue: 0,0:07:29.99,0:07:32.82,Default,,0,0,0,,Мүмкін ол қазірден бастап пұттарды сата бастайды.
Dialogue: 0,0:07:32.91,0:07:33.66,Default,,0,0,0,,Купальник?!
Dialogue: 0,0:07:33.74,0:07:36.91,Default,,0,0,0,,Қарғыс атқыр... Мен де солай ойладым.
Dialogue: 0,0:07:36.99,0:07:39.70,Default,,0,0,0,,Ку~ Ямаданың микробикинисі
Dialogue: 0,0:07:39.79,0:07:40.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:40.50,0:07:42.33,Default,,0,0,0,,Ах... Гохо Гохо
Dialogue: 0,0:07:49.59,0:07:52.76,Default,,0,0,0,,Эй, сен бүгін Адачимен және басқалармен не туралы сөйлестің?
Dialogue: 0,0:07:52.84,0:07:54.93,Default,,0,0,0,,Қарғыс атқыр... ақыры келдің бе?
Dialogue: 0,0:07:55.43,0:07:56.60,Default,,0,0,0,,Жоқ... кез келген нәрсе
Dialogue: 0,0:07:57.18,0:07:59.31,Default,,0,0,0,,Ер адамдар арасындағы әңгіме дегеніміз не?
Dialogue: 0,0:07:59.81,0:08:01.06,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,0:08:01.14,0:08:01.85,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:08:02.77,0:08:06.36,Default,,0,0,0,,Ойланып қарасам, жұмыс туралы сұрасам жарай ма?
Dialogue: 0,0:08:07.27,0:08:11.36,Default,,0,0,0,,Ақыр соңында, сіз ерлерге арналған гравюралық суреттерді көргіңіз келмейді ме?
Dialogue: 0,0:08:12.15,0:08:14.86,Default,,0,0,0,,Иә, дүкенге бір сәт тоқтай аламын ба?
Dialogue: 0,0:08:16.70,0:08:19.12,Default,,0,0,0,,А, бұл!
Dialogue: 0,0:08:19.20,0:08:22.29,Default,,0,0,0,,Бұл Лимон Сакадан шыққан Хонока Сайто!
Dialogue: 0,0:08:22.37,0:08:23.50,Default,,0,0,0,,Мен сенің үмітіңе сүйенемін, Гран Торино
Dialogue: 0,0:08:25.88,0:08:29.42,Default,,0,0,0,,Ммм... бұл~!
Dialogue: 0,0:08:29.92,0:08:31.59,Default,,0,0,0,,Бұл Ямада болды
Dialogue: 0,0:08:31.67,0:08:34.01,Default,,0,0,0,,Аа, дұрыс, шоқжұлдызды болжау
Dialogue: 0,0:08:34.09,0:08:34.68,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:08:36.30,0:08:39.31,Default,,0,0,0,,Бұл әдеттегіден ұзағырақ уақыт алды.
Dialogue: 0,0:08:39.39,0:08:42.77,Default,,0,0,0,,Маған табиғи көрінгім келетінін айтты, сондықтан мен қобалжыдым.
Dialogue: 0,0:08:42.85,0:08:44.44,Default,,0,0,0,,Мен оны олай көрмеймін.
Dialogue: 0,0:08:44.52,0:08:47.73,Default,,0,0,0,,Бірақ менің айналамдағы қызметкерлер бұл қызықты деп ойлады.
Dialogue: 0,0:08:47.81,0:08:51.19,Default,,0,0,0,,А... Кешіріңіз, маған бәрібір.
Dialogue: 0,0:08:52.03,0:08:56.28,Default,,0,0,0,,Мм... Кәдімгідей жақсы шықты деп ойлаймын.
Dialogue: 0,0:08:56.36,0:09:00.45,Default,,0,0,0,,Ах... Әдеттегідей, ең жақсы жағдайда деймін.
Dialogue: 0,0:09:01.04,0:09:03.16,Default,,0,0,0,,Таныс Ямада...
Dialogue: 0,0:09:03.66,0:09:05.29,Default,,0,0,0,,Мақтау қиын...
Dialogue: 0,0:09:06.33,0:09:07.58,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:08.13,0:09:10.63,Default,,0,0,0,,Ичикава менімен таныс.
Dialogue: 0,0:09:11.21,0:09:13.34,Default,,0,0,0,,Ең жақсы шарттар дегенді қалай түсінесіз?
Dialogue: 0,0:09:13.42,0:09:15.05,Default,,0,0,0,,Неліктен бұлай?
Dialogue: 0,0:09:15.13,0:09:16.30,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:09:17.30,0:09:19.43,Default,,0,0,0,,Жоқ, мен оны саған сатып аламын.
Dialogue: 0,0:09:22.43,0:09:25.48,Default,,0,0,0,,Мен оны сабақта ақымақ әңгіме ретінде ойнайтынмын.
Dialogue: 0,0:09:25.56,0:09:28.02,Default,,0,0,0,,Уақыт айырмашылығына байланысты біртіндеп жұмыс істеу
Dialogue: 0,0:09:28.52,0:09:30.90,Default,,0,0,0,,Әлем туралы мен білмейтін нәрселер
Dialogue: 0,0:09:31.86,0:09:33.19,Default,,0,0,0,,Саған қайсысы көбірек ұнайды?
Dialogue: 0,0:09:33.82,0:09:35.36,Default,,0,0,0,,Мен қайсысы екенін білмеймін.
Dialogue: 0,0:09:35.44,0:09:36.90,Default,,0,0,0,,Мұның бәрі?
Dialogue: 0,0:09:38.24,0:09:40.16,Default,,0,0,0,,Бірақ сән журналдары ше?
Dialogue: 0,0:09:40.24,0:09:41.45,Default,,0,0,0,,Бұл мүлдем басқа.
Dialogue: 0,0:09:46.54,0:09:47.62,Default,,0,0,0,,Сіз оны көрдіңіз бе?
Dialogue: 0,0:09:47.71,0:09:49.17,Default,,0,0,0,,Иә! Жоқ... жоқ...
Dialogue: 0,0:09:49.25,0:09:51.34,Default,,0,0,0,,Менің әпкем кездейсоқ сатып алды...
Dialogue: 0,0:09:52.34,0:09:53.88,Default,,0,0,0,,А... түсіндім.
Dialogue: 0,0:09:54.38,0:09:56.17,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:09:56.80,0:10:01.55,Default,,0,0,0,,Макияж, сіздің тұрысыңыз және түсірілімдегі атмосфераның бәрі басқаша.
Dialogue: 0,0:10:01.64,0:10:03.06,Default,,0,0,0,,О... дұрыс.
Dialogue: 0,0:10:03.14,0:10:04.10,Default,,0,0,0,,Сондай-ақ...
Dialogue: 0,0:10:04.68,0:10:06.85,Default,,0,0,0,,Сізге жұмысыңыз ұнайды.
Dialogue: 0,0:10:10.81,0:10:11.56,Default,,0,0,0,,Иә
Dialogue: 0,0:10:14.11,0:10:16.90,Default,,0,0,0,,Ямаданың күлкісіне тура қарай алмаған себебім
Dialogue: 0,0:10:16.99,0:10:21.62,Default,,0,0,0,,Батып бара жатқан күн тым күшті болғандықтан шығар
Dialogue: 0,0:10:26.29,0:10:27.58,Default,,0,0,0,,Ававуааа
Dialogue: 0,0:10:27.66,0:10:29.08,Default,,0,0,0,,Оны ақырын бөлшектеңіз.
Dialogue: 0,0:10:29.79,0:10:31.83,Default,,0,0,0,,Моккай... Моккай, солай ма?
Dialogue: 0,0:10:37.59,0:10:38.34,Default,,0,0,0,,Хмм.
Dialogue: 0,0:10:39.13,0:10:40.63,Default,,0,0,0,,- (Ямада) Уау - (Киншодани) Ямада мырза!
Dialogue: 0,0:10:40.72,0:10:41.97,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:10:42.05,0:10:46.18,Default,,0,0,0,,Айтпақшы, Ичикава-кун қысқы демалыста ешқайда барды ма?
Dialogue: 0,0:10:46.27,0:10:47.81,Default,,0,0,0,,Неге ол маған ештеңе айтпады екен?
Dialogue: 0,0:10:47.89,0:10:49.64,Default,,0,0,0,,Мен Акитаға қайта оралдым деп ойлаймын.
Dialogue: 0,0:10:49.73,0:10:52.40,Default,,0,0,0,,Жарайды, мен сол жерде зардап шектім.
Dialogue: 0,0:10:52.48,0:10:54.77,Default,,0,0,0,,Акита... мм.
Dialogue: 0,0:10:55.57,0:10:57.53,Default,,0,0,0,,Мені қуып жіберді
Dialogue: 0,0:10:57.61,0:10:59.28,Default,,0,0,0,,Иә, Ямада мырза?
Dialogue: 0,0:10:59.36,0:11:01.36,Default,,0,0,0,,Сіз қысқы демалыста кез келген жерге бардыңыз ба?
Dialogue: 0,0:11:01.45,0:11:04.24,Default,,0,0,0,,Не? Мен сапарға шыға алмадым
Dialogue: 0,0:11:04.33,0:11:05.79,Default,,0,0,0,,Мику мен Аояма кетеді
Dialogue: 0,0:11:05.87,0:11:07.29,Default,,0,0,0,,Хауа мен Ичикава
Dialogue: 0,0:11:07.91,0:11:09.41,Default,,0,0,0,,Няанчидегі Жаңа жыл түні
Dialogue: 0,0:11:09.50,0:11:11.00,Default,,0,0,0,,Ал жаңа жылдық сапар туралы...
Dialogue: 0,0:11:11.08,0:11:13.58,Default,,0,0,0,,Иә? Хмм? Хауа?
Dialogue: 0,0:11:13.67,0:11:15.25,Default,,0,0,0,,Ал... күте тұр, күт
Dialogue: 0,0:11:15.92,0:11:16.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:17.46,0:11:20.76,Default,,0,0,0,,Ойланып қарасаңыз, бұл рас.
Dialogue: 0,0:11:20.84,0:11:23.55,Default,,0,0,0,,Хара мырза ше?
Dialogue: 0,0:11:23.64,0:11:26.51,Default,,0,0,0,,Мен жаңа жылға Канзаки-кунмен бірге бардым...
Dialogue: 0,0:11:26.60,0:11:29.06,Default,,0,0,0,,Иә! Қысқы демалыс туралы естідім
Dialogue: 0,0:11:29.14,0:11:30.81,Default,,0,0,0,,Неліктен Канзаки-кун?
Dialogue: 0,0:11:30.89,0:11:33.06,Default,,0,0,0,,Уф... бұл қулық~
Dialogue: 0,0:11:33.15,0:11:35.52,Default,,0,0,0,,Менде демалатын орын болмағанына көп уақыт болды.
Dialogue: 0,0:11:35.61,0:11:37.57,Default,,0,0,0,,Ал сен Ал Майтті не деп ойлайсың?
Dialogue: 0,0:11:37.65,0:11:38.78,Default,,0,0,0,,Иә...
Dialogue: 0,0:11:40.24,0:11:41.40,Default,,0,0,0,,Күткеніңізге рахмет!
Dialogue: 0,0:11:41.49,0:11:42.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:43.66,0:11:45.24,Default,,0,0,0,,Ой...
Dialogue: 0,0:11:45.32,0:11:47.91,Default,,0,0,0,,Үйірме жұмыстарында үзіліс болғандықтан, мен өз дағдыларымды кеңейткім келеді.
Dialogue: 0,0:11:47.99,0:11:50.37,Default,,0,0,0,,Сондай-ақ... менің жақтарым...
Dialogue: 0,0:11:50.45,0:11:54.17,Default,,0,0,0,,Ой... ой... ой...
Dialogue: 0,0:11:54.75,0:11:57.50,Default,,0,0,0,,Осындай кезде мен не айтуым керек еді?
Dialogue: 0,0:11:57.59,0:12:01.72,Default,,0,0,0,,Мен сыртқы келбетке ерекше мән бергім келмеді.
Dialogue: 0,0:12:01.80,0:12:06.18,Default,,0,0,0,,Егер сіз жақсы көретін адам сізге сәйкес келмейтін нәрсені жасаса ше...
Dialogue: 0,0:12:06.68,0:12:07.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:09.97,0:12:13.31,Default,,0,0,0,,Жоқ... жоқ, маған әлі ұнайтын ешкім жоқ.
Dialogue: 0,0:12:13.39,0:12:15.02,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:12:15.10,0:12:17.15,Default,,0,0,0,,Бұл әлі де сіздің ұстанымыңыз ба?
Dialogue: 0,0:12:17.23,0:12:19.69,Default,,0,0,0,,Міне, балалар
Dialogue: 0,0:12:19.78,0:12:22.19,Default,,0,0,0,,Саңылауларыңызды да итарқаға салыңыз.
Dialogue: 0,0:12:22.28,0:12:23.86,Default,,0,0,0,,Не? А... иә
Dialogue: 0,0:12:26.07,0:12:28.28,Default,,0,0,0,,Мен мұны саған жасаймын, осы жаққа кел.
Dialogue: 0,0:12:30.33,0:12:32.87,Default,,0,0,0,,Эй... Маған сәл ғана берші.
Dialogue: 0,0:12:34.71,0:12:35.42,Default,,0,0,0,,Иә
Dialogue: 0,0:12:36.96,0:12:38.29,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:12:38.84,0:12:41.59,Default,,0,0,0,,Хехехе, біртүрлі екен.
Dialogue: 0,0:12:45.22,0:12:47.22,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:49.31,0:12:51.02,Default,,0,0,0,,Орындалды!
Dialogue: 0,0:12:51.10,0:12:51.97,Default,,0,0,0,,Не?
Dialogue: 0,0:12:52.06,0:12:55.81,Default,,0,0,0,,Қазірдің өзінде! Себебі Хара-сан маған көмектеспеді.
Dialogue: 0,0:12:55.90,0:12:57.15,Default,,0,0,0,,Масқара
Dialogue: 0,0:12:57.23,0:12:58.73,Default,,0,0,0,,Жақсы, дәмі жақсы, солай ма?
Dialogue: 0,0:13:00.61,0:13:01.73,Default,,0,0,0,,(Ходжинс) Бүгіннен бастап мен Автоматты жазу қуыршағының шәкірті болып жұмыс істеймін.
Dialogue: 0,0:13:01.82,0:13:04.61,Default,,0,0,0,,Аа, мен жасадым.
Dialogue: 0,0:13:04.70,0:13:05.40,Default,,0,0,0,,Ах
Dialogue: 0,0:13:06.03,0:13:06.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:08.03,0:13:10.37,Default,,0,0,0,,Адачи ең жақсысы.
Dialogue: 0,0:13:10.45,0:13:13.00,Default,,0,0,0,,Сен мені қатты жақсы көресің, солай ма?
Dialogue: 0,0:13:16.42,0:13:17.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:19.21,0:13:20.38,Default,,0,0,0,,Хаа~
Dialogue: 0,0:13:20.46,0:13:22.80,Default,,0,0,0,,Әй, бұл құлады.
Dialogue: 0,0:13:22.88,0:13:23.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:24.01,0:13:26.43,Default,,0,0,0,,Бұл кілт тізбегі сүйкімді.
Dialogue: 0,0:13:26.51,0:13:27.59,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:28.30,0:13:30.18,Default,,0,0,0,,Акита Ину сүйкімді, солай емес пе?
Dialogue: 0,0:13:31.47,0:13:33.47,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:13:34.52,0:13:37.27,Default,,0,0,0,,А, Хара мырза, сіз дұрыс тамақтандыңыз ба?
Dialogue: 0,0:13:37.35,0:13:40.19,Default,,0,0,0,,Мен... Мен диетадамын.
Dialogue: 0,0:13:40.27,0:13:43.69,Default,,0,0,0,,Менің ойымша, Хара-сан жақсы.
Dialogue: 0,0:13:43.78,0:13:45.40,Default,,0,0,0,,Ичикава да солай ойлайды, солай ма?
Dialogue: 0,0:13:45.49,0:13:46.70,Default,,0,0,0,,Мен жүгері дорбаларын жүк көліктеріне тиеп, қоймаға апаратынмын.
Dialogue: 0,0:13:47.28,0:13:49.20,Default,,0,0,0,,Ммм~
Dialogue: 0,0:13:51.03,0:13:53.99,Default,,0,0,0,,Олай болса, бүйірің қайта өспесін!
Dialogue: 0,0:13:54.08,0:13:55.00,Default,,0,0,0,,Не!
Dialogue: 0,0:14:01.46,0:14:02.96,Default,,0,0,0,,Бұрынғы Хара мырза
Dialogue: 0,0:14:03.80,0:14:06.59,Default,,0,0,0,,Бұл сіз оны білетіндігіңізді білдіреді.
Dialogue: 0,0:14:07.17,0:14:09.51,Default,,0,0,0,,Акита Ину туралы
Dialogue: 0,0:14:09.59,0:14:10.34,Default,,0,0,0,,Сонымен…
Dialogue: 0,0:14:10.43,0:14:12.10,Default,,0,0,0,,А... иә
Dialogue: 0,0:14:12.81,0:14:16.02,Default,,0,0,0,,Егер сұраса, Ямада не деп жауап береді?
Dialogue: 0,0:14:17.10,0:14:18.31,Default,,0,0,0,,Жоқ, жақсы ма?
Dialogue: 0,0:14:18.81,0:14:21.52,Default,,0,0,0,,Қыздар арасында мұндай әңгіме қалыпты ма?
Dialogue: 0,0:14:22.06,0:14:24.94,Default,,0,0,0,,Оның үстіне Ямада барлығымен жақсы тіл табысады.
Dialogue: 0,0:14:25.03,0:14:28.78,Default,,0,0,0,,Сіз көптеген кәдесыйлар алып, сыйлайтыныңызға сенімдімін...
Dialogue: 0,0:14:30.87,0:14:33.20,Default,,0,0,0,,Мен... Аа, кешіріңіз.
Dialogue: 0,0:14:33.28,0:14:34.66,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:14:36.83,0:14:38.62,Default,,0,0,0,,Пайдасыз болғаным үшін кешіріңіз.
Dialogue: 0,0:14:39.12,0:14:40.04,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:14:40.54,0:14:43.54,Default,,0,0,0,,Соңғы кездері Ямада көп кешірім сұрайтын болды.
Dialogue: 0,0:14:44.13,0:14:48.55,Default,,0,0,0,,«Көп уайымдама, тек қасыңда болу қызық».
Dialogue: 0,0:14:48.63,0:14:51.30,Default,,0,0,0,,...Осындай жеңіл-желпі бірдеңе айтсам ғой
Dialogue: 0,0:14:55.31,0:14:55.81,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:14:56.68,0:14:59.56,Default,,0,0,0,,Әпке, күні кеше кәмелеттік жасқа толу тойы өтті.
Dialogue: 0,0:14:59.64,0:15:02.40,Default,,0,0,0,,Уау, сондай сүйкімді!
Dialogue: 0,0:15:02.48,0:15:03.56,Default,,0,0,0,,Бұл күлкілі
Dialogue: 0,0:15:04.15,0:15:06.19,Default,,0,0,0,,Ичикава мұны да сақтап қалды.
Dialogue: 0,0:15:06.28,0:15:08.57,Default,,0,0,0,,Жоқ... жоқ, бұл...
Dialogue: 0,0:15:08.65,0:15:10.45,Default,,0,0,0,,Хехехе
Dialogue: 0,0:15:10.53,0:15:13.78,Default,,0,0,0,,Дұрыс, сіз де сұраған қарлы табиғат суреті.
Dialogue: 0,0:15:14.37,0:15:15.78,Default,,0,0,0,,Тағы кім болуы мүмкін?
Dialogue: 0,0:15:15.87,0:15:19.12,Default,,0,0,0,,Әй, осы сәтте мен жардан құладым.
Dialogue: 0,0:15:19.20,0:15:20.29,Default,,0,0,0,,Бұл күлкілі
Dialogue: 0,0:15:24.13,0:15:25.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:25.67,0:15:27.63,Default,,0,0,0,,Ах! А... жоқ
Dialogue: 0,0:15:27.71,0:15:31.26,Default,,0,0,0,,Кешіріңіз, мен олай айтқым келген жоқ.
Dialogue: 0,0:15:32.84,0:15:36.72,Default,,0,0,0,,Сонда бұл қол мен сұрағаным үшін...
Dialogue: 0,0:15:36.81,0:15:38.35,Default,,0,0,0,,Жоқ, бұл менікі!
Dialogue: 0,0:15:39.73,0:15:42.23,Default,,0,0,0,,Мен тым мұқият емеспін
Dialogue: 0,0:15:44.73,0:15:47.86,Default,,0,0,0,,Әй, енді ойлап қарасам, келесі аптаның болжамы қар.
Dialogue: 0,0:15:48.78,0:15:50.07,Default,,0,0,0,,Айта алмадым
Dialogue: 0,0:15:51.15,0:15:55.45,Default,,0,0,0,,«Мен Ямада туралы ойласам, айналамдағы ештеңені көре алмаймын»
Dialogue: 0,0:15:59.50,0:16:03.04,Default,,0,0,0,,А... Дұрыс, келесі аптада қар жауады.
Dialogue: 0,0:16:03.12,0:16:05.38,Default,,0,0,0,,Не? Мен сізге бұрын айттым
Dialogue: 0,0:16:05.46,0:16:07.67,Default,,0,0,0,,Не? Аа, дұрыс
Dialogue: 0,0:16:08.71,0:16:09.92,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:10.92,0:16:14.26,Default,,0,0,0,,Ямаданың мұндай түрін бірінші рет көруім.
Dialogue: 0,0:16:18.76,0:16:22.35,Default,,0,0,0,,Ямада: Мен сізден кеше хабар алған жоқпын.
Dialogue: 0,0:16:22.43,0:16:25.69,Default,,0,0,0,,Саған бәрібір? Менің жарақатым туралы
Dialogue: 0,0:16:25.77,0:16:27.52,Default,,0,0,0,,Эй, жақсысың ба?
Dialogue: 0,0:16:28.32,0:16:28.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:30.03,0:16:31.86,Default,,0,0,0,,Сіз біртүрлі әрекет жасайсыз ба?
Dialogue: 0,0:16:31.94,0:16:36.32,Default,,0,0,0,,Ах, Ямада, мен де кеше бір ғана картоп жедім.
Dialogue: 0,0:16:36.41,0:16:37.24,Default,,0,0,0,,Бір?
Dialogue: 0,0:16:37.32,0:16:38.74,Default,,0,0,0,,№, 1 дана
Dialogue: 0,0:16:38.83,0:16:40.66,Default,,0,0,0,,Менде әдетте екі қалдырады.
Dialogue: 0,0:16:40.74,0:16:43.66,Default,,0,0,0,,Қышыма Бірдеңе есіңде жоқ па?
Dialogue: 0,0:16:43.75,0:16:46.54,Default,,0,0,0,,Енді... неге мені сұрап тұрсың?
Dialogue: 0,0:16:46.63,0:16:48.96,Default,,0,0,0,,Шынында да, Ичикава-куннан неге сұрайсың?
Dialogue: 0,0:16:49.55,0:16:50.34,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:16:50.42,0:16:51.59,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:16:52.21,0:16:54.05,Default,,0,0,0,,Тағы бір Қан Құбыжық Өнері ме?
Dialogue: 0,0:16:54.13,0:16:54.97,Default,,0,0,0,,Иә
Dialogue: 0,0:17:05.02,0:17:07.02,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:17:07.10,0:17:09.19,Default,,0,0,0,,Менің жарақатыма не себеп болды
Dialogue: 0,0:17:11.07,0:17:11.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:12.69,0:17:13.44,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:17:14.03,0:17:15.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:15.11,0:17:16.91,Default,,0,0,0,,Акита Кентаро жоқ
Dialogue: 0,0:17:16.99,0:17:18.45,Default,,0,0,0,,- (Кобаяши) Кім? -(Ямада) О, жоқ...
Dialogue: 0,0:17:19.91,0:17:20.95,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:17:22.95,0:17:24.41,Default,,0,0,0,,Үйге кететін уақыт болды ма?
Dialogue: 0,0:17:24.50,0:17:27.17,Default,,0,0,0,,Жарайды... ол жерде болмаған шығар.
Dialogue: 0,0:17:27.25,0:17:30.17,Default,,0,0,0,,Менің ойымша, бұл үйде шығар.
Dialogue: 0,0:17:31.34,0:17:33.17,Default,,0,0,0,,Балалар, орындарыңа отырыңдар.
Dialogue: 0,0:17:33.26,0:17:35.05,Default,,0,0,0,,Иә
Dialogue: 0,0:17:36.88,0:17:39.93,Default,,0,0,0,,Осындай жағдайда не айтуым керек?
Dialogue: 0,0:17:40.76,0:17:43.93,Default,,0,0,0,,Мен саған өзімнің Кендзиромды беремін деу басқа.
Dialogue: 0,0:17:47.02,0:17:50.15,Default,,0,0,0,,Болжам бойынша бүгін қалың қар жауады.
Dialogue: 0,0:17:50.23,0:17:52.94,Default,,0,0,0,,Сабақ осында аяқталады және барлығы шығарылады.
Dialogue: 0,0:17:53.03,0:17:54.19,Default,,0,0,0,,(Роко) Иә, әрине. Мұнда өте жайлы екен.
Dialogue: 0,0:17:58.41,0:17:59.45,Default,,0,0,0,,- (Ичикава) Иә? -(Канзаки) Ах.
Dialogue: 0,0:17:59.53,0:18:03.37,Default,,0,0,0,,Хара мырза ит кілттерінің тізбегін жоғалтқан сияқты.
Dialogue: 0,0:18:03.45,0:18:04.45,Default,,0,0,0,,Иттер туралы?
Dialogue: 0,0:18:06.00,0:18:08.71,Default,,0,0,0,,Акита Кентаро, дәл осылай айтып тұрсыз ба?
Dialogue: 0,0:18:08.79,0:18:11.96,Default,,0,0,0,,Ямада мырза, мен қатты күйзелдім.
Dialogue: 0,0:18:12.04,0:18:12.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:14.38,0:18:16.17,Default,,0,0,0,,Рахмет, жеткілікті
Dialogue: 0,0:18:17.55,0:18:19.01,Default,,0,0,0,,Мен оны іздеймін
Dialogue: 0,0:18:21.30,0:18:23.06,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:18:23.76,0:18:25.31,Default,,0,0,0,,Боқ... Тәтті\NТіпті
Dialogue: 0,0:18:26.10,0:18:27.52,Default,,0,0,0,,Боқ, боқ, боқ!
Dialogue: 0,0:18:28.52,0:18:31.40,Default,,0,0,0,,тым кең.
Dialogue: 0,0:18:31.48,0:18:35.40,Default,,0,0,0,,Біріншіден, мен қайдан келгенімді білмеймін.
Dialogue: 0,0:18:36.40,0:18:37.15,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:18:43.74,0:18:45.24,Default,,0,0,0,,Бірдеңе іздеп жүрсіз бе?
Dialogue: 0,0:18:45.33,0:18:47.12,Default,,0,0,0,,Не? бөлек
Dialogue: 0,0:18:47.83,0:18:50.92,Default,,0,0,0,,Анна Бұл жол көп жүрмейді.
Dialogue: 0,0:18:51.00,0:18:52.58,Default,,0,0,0,,Үй сол жақта.
Dialogue: 0,0:18:52.67,0:18:55.09,Default,,0,0,0,,Мен үнемі жүретін жол
Dialogue: 0,0:18:56.34,0:18:57.42,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:07.60,0:19:11.52,Default,,0,0,0,,Денем салқындап, жарылған қолым ауырады.
Dialogue: 0,0:19:12.69,0:19:15.02,Default,,0,0,0,,Мұндай нәрсенің мағынасы жоқ
Dialogue: 0,0:19:15.86,0:19:17.78,Default,,0,0,0,,Тек өзін-өзі қанағаттандыру
Dialogue: 0,0:19:20.28,0:19:21.41,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:19:46.81,0:19:50.60,Default,,0,0,0,,Үйде де, еш жерде де емес
Dialogue: 0,0:19:51.98,0:19:54.56,Default,,0,0,0,,Іздесем де, іздесем де...
Dialogue: 0,0:19:54.65,0:19:55.27,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:57.94,0:19:59.28,Default,,0,0,0,,Өйткені бұл мүлдем орындалады!
Dialogue: 0,0:20:01.40,0:20:04.78,Default,,0,0,0,,Таба алмасаң, бір жерде бар! Ол жоғалып кетпейді!
Dialogue: 0,0:20:05.45,0:20:08.12,Default,,0,0,0,,Сондықтан... уайымдамаңыз.
Dialogue: 0,0:20:09.24,0:20:10.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:10.79,0:20:15.04,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:20:17.54,0:20:18.55,Default,,0,0,0,,Ямада…
Dialogue: 0,0:20:20.76,0:20:21.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:22.51,0:20:23.43,Default,,0,0,0,,болды
Dialogue: 0,0:20:23.51,0:20:24.93,Default,,0,0,0,,- (Ичикава) Міне болды - (Ямада) Иә?
Dialogue: 0,0:20:25.51,0:20:27.93,Default,,0,0,0,,Оны алған адам ағашқа іліп қойды.
Dialogue: 0,0:20:30.81,0:20:32.18,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:36.36,0:20:37.94,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:38.52,0:20:39.61,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:20:39.69,0:20:42.78,Default,,0,0,0,,Егер мен Ямаданы кездестіре алмасам, мен жоғары қарамас едім.
Dialogue: 0,0:21:02.34,0:21:03.26,Default,,0,0,0,,(Ичикаваның түшкіруі)
Dialogue: 0,0:21:03.34,0:21:04.34,Default,,0,0,0,,А, жақсысың ба?
Dialogue: 0,0:21:04.93,0:21:07.05,Default,,0,0,0,,Сіз үйренбейсіз.
Dialogue: 0,0:21:11.60,0:21:13.60,Default,,0,0,0,,- (Ямада) Учиха... - (Ичикава) Иә?
Dialogue: 0,0:21:14.69,0:21:17.10,Default,,0,0,0,,Дәл сол жерде.
Dialogue: 0,0:21:18.15,0:21:21.44,Default,,0,0,0,,Кішкене ғана... жылытыңыз ба?
Dialogue: 0,0:21:23.40,0:21:23.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:34.00,0:21:36.00,Default,,0,0,0,,♪～
Dialogue: 0,0:23:01.96,0:23:03.96,Default,,0,0,0,,～♪
