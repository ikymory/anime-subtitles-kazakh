Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.10,0:00:12.11,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:00:13.11,0:00:15.11,Default,,0,0,0,,《Бұл не жағдай...》
Dialogue: 0,0:00:15.11,0:00:17.31,Default,,0,0,0,,《Ертең өлетін ту...? 》
Dialogue: 0,0:00:17.31,0:00:19.11,Default,,0,0,0,,Тоқта.
Dialogue: 0,0:00:19.11,0:00:23.12,Default,,0,0,0,,Ей, мен кеше түнде осыны ойлап едім→
Dialogue: 0,0:00:23.12,0:00:26.09,Default,,0,0,0,,Әкең сені қалай атайды, Ичикава?
Dialogue: 0,0:00:26.09,0:00:31.13,Default,,0,0,0,,Мен оны бұл күндері онша атамаймын, бірақ мен оны «Кё-чан» немесе «Кё» деп атаймын...
Dialogue: 0,0:00:31.13,0:00:33.13,Default,,0,0,0,,Достардан?
Dialogue: 0,0:00:33.13,0:00:36.13,Default,,0,0,0,,«Ичикава» немесе «Ичикава-кун»?
Dialogue: 0,0:00:36.13,0:00:42.10,Default,,0,0,0,,Сонымен... мен «Киотаро» таңдауым керек пе? Оны қалай атауға болады.
Dialogue: 0,0:00:44.14,0:00:47.11,Default,,0,0,0,,《...Өлетін ту бүгін》
Dialogue: 0,0:00:48.21,0:00:55.18,Default,,0,0,0,,♬～
Dialogue: 0,0:02:25.11,0:02:27.11,Default,,0,0,0,,Мен сізге қоңырау шаламын.
Dialogue: 0,0:02:27.11,0:02:29.11,Default,,0,0,0,,Иә.
Dialogue: 0,0:02:29.11,0:02:33.12,Default,,0,0,0,,《Ямада бүгін суретке түсіру үшін Хиросимаға бара жатқан сияқты.》
Dialogue: 0,0:02:33.12,0:02:35.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:35.12,0:02:37.09,Default,,0,0,0,,《Мен саған қолыңнан келгеннің бәрін істе деп айта алмадым》
Dialogue: 0,0:02:38.12,0:02:40.12,Default,,0,0,0,,《Ал мен...》
Dialogue: 0,0:02:40.12,0:02:43.13,Default,,0,0,0,,Юрин Құмарлық махаббат. Мен қалғанды жақсы көремін ...
Dialogue: 0,0:02:43.13,0:02:45.13,Default,,0,0,0,,Мен сенемін.
Dialogue: 0,0:02:45.13,0:02:48.10,Default,,0,0,0,,Ол жай ғана жақын дос, түні бойы ойын ойнадық →
Dialogue: 0,0:02:48.10,0:02:50.10,Default,,0,0,0,,Менің айтайын дегенім...
Dialogue: 0,0:02:50.10,0:02:52.07,Default,,0,0,0,,Аа, олай емес...
Dialogue: 0,0:02:52.07,0:02:54.10,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:02:54.10,0:02:57.11,Default,,0,0,0,,Ол қандай болса да өз ұсыныстарына сенетін отаку.
Dialogue: 0,0:02:57.11,0:03:01.11,Default,,0,0,0,,《Қызық, бұл не... Жүрегім дірілдеп кетті》
Dialogue: 0,0:03:01.11,0:03:03.11,Default,,0,0,0,,《Бірақ шие гүлін көру…》
Dialogue: 0,0:03:03.11,0:03:06.11,Default,,0,0,0,,《Мен қауесетті естідім, бірақ олар шынымен болды ма?''
Dialogue: 0,0:03:06.11,0:03:09.08,Default,,0,0,0,,《Осындай жерге шақырылады деп ойламаппын...》
Dialogue: 0,0:03:09.08,0:03:11.09,Default,,0,0,0,,Міне.
Dialogue: 0,0:03:12.12,0:03:14.09,Default,,0,0,0,,Ақыр соңында?
Dialogue: 0,0:03:14.09,0:03:17.09,Default,,0,0,0,,Мен таныс дауысты естідім деп ойладым.
Dialogue: 0,0:03:17.09,0:03:21.10,Default,,0,0,0,,А... у... мұнда неге келдің?
Dialogue: 0,0:03:21.10,0:03:24.10,Default,,0,0,0,,Ер адамдар экономика туралы айтты.
Dialogue: 0,0:03:24.10,0:03:28.10,Default,,0,0,0,,Бұл Юриннің махаббатының ашылуы туралы әңгіме, солай ма?
Dialogue: 0,0:03:28.10,0:03:31.11,Default,,0,0,0,,Сүйісу тегін, ұйықтау тегін.
Dialogue: 0,0:03:31.11,0:03:33.11,Default,,0,0,0,,...Екеуміз кездесіп жүрсек.
Dialogue: 0,0:03:34.11,0:03:37.11,Default,,0,0,0,,Әйтсе де, кездеспесек те бір жерде қалып қойсақ ше→
Dialogue: 0,0:03:37.11,0:03:42.12,Default,,0,0,0,,Мое-самадан күткендей, көңілім қалды, бірақ... Эй, Ичи-кун!
Dialogue: 0,0:03:42.12,0:03:45.12,Default,,0,0,0,,《Мен... түсінемін.》
Dialogue: 0,0:03:45.12,0:03:48.12,Default,,0,0,0,,《Ямада өзі кездеспеген баланың үйінде қалды...》
Dialogue: 0,0:03:48.12,0:03:51.13,Default,,0,0,0,,《Бұл сөзсіз объективті факт...》
Dialogue: 0,0:03:51.13,0:03:55.10,Default,,0,0,0,,《Ол Юрин сияқты атақты болмаса да, Ямада...》
Dialogue: 0,0:03:55.10,0:03:59.10,Default,,0,0,0,,Менің сізбен қарым-қатынасым жұмысыма кедергі келтіруі мүмкін...
Dialogue: 0,0:04:00.10,0:04:02.10,Default,,0,0,0,,《Мүмкін қорқынышты нәрсе...》
Dialogue: 0,0:04:02.10,0:04:05.11,Default,,0,0,0,,Иә. Оны Ямадаға жіберіңіз.
Dialogue: 0,0:04:05.11,0:04:07.11,Default,,0,0,0,,Иә ірімшік. (камера ысырмасының дыбысы)
Dialogue: 0,0:04:07.11,0:04:09.14,Default,,0,0,0,,Ал... күте тұрыңыз!
Dialogue: 0,0:04:09.14,0:04:12.11,Default,,0,0,0,,Иә? Ойлап қарасаңыз, Ямада мырза сізбен бірге емес пе?
Dialogue: 0,0:04:12.11,0:04:15.12,Default,,0,0,0,,Ертең Хиросимада фильм түсіру басталады.
Dialogue: 0,0:04:15.12,0:04:17.12,Default,,0,0,0,,Мен бүгін алдыңғы жолаушы ретінде бардым.
Dialogue: 0,0:04:17.12,0:04:20.09,Default,,0,0,0,,Ол Кен Катаоканың қызын ойнайды.
Dialogue: 0,0:04:20.09,0:04:22.12,Default,,0,0,0,,Айқай~ Бұл керемет.
Dialogue: 0,0:04:22.12,0:04:25.13,Default,,0,0,0,,Барған сайын ғажайып болып барады.
Dialogue: 0,0:04:30.10,0:04:35.10,Default,,0,0,0,,Бірақ Ямада - Ямада, ештеңе өзгермейді.
Dialogue: 0,0:04:35.10,0:04:37.14,Default,,0,0,0,,...Дұрыс.
Dialogue: 0,0:04:37.14,0:04:41.14,Default,,0,0,0,,Мен оны бір күні көрдім. Рамюне қос бургердің арасына тығылды.
Dialogue: 0,0:04:41.14,0:04:43.15,Default,,0,0,0,,Шынайы ма? (Секине) Иә.
Dialogue: 0,0:04:43.15,0:04:47.12,Default,,0,0,0,,《Өзгеріс жоқ...немесе...》
Dialogue: 0,0:04:47.12,0:04:49.12,Default,,0,0,0,,Әйтеуір, гала-концерт – өзіңді ерекше көрсетуге арналған.
Dialogue: 0,0:04:50.12,0:04:52.12,Default,,0,0,0,,«Бұл шынымен де әдемі қонақ үй».
Dialogue: 0,0:04:52.12,0:04:54.12,Default,,0,0,0,,«Сіз бөлмені аралағыңыз келе ме?»
Dialogue: 0,0:04:54.12,0:04:57.13,Default,,0,0,0,,《Кейбір нәрселерді өзгерту керек...》
Dialogue: 0,0:04:57.13,0:04:59.09,Default,,0,0,0,,Білесіз бе... «(Есіктің ашылған дыбысы)»
Dialogue: 0,0:04:59.09,0:05:01.10,Default,,0,0,0,,Бір минут күтіңіз. — Ә?
Dialogue: 0,0:05:01.10,0:05:03.10,Default,,0,0,0,,Аа...
Dialogue: 0,0:05:03.10,0:05:05.10,Default,,0,0,0,,Әй, анашым.
Dialogue: 0,0:05:05.10,0:05:09.10,Default,,0,0,0,,Әй, Анна, бір сәт сөйлесе аламыз ба?
Dialogue: 0,0:05:09.10,0:05:13.07,Default,,0,0,0,,《Соңында мен сол күні ештеңе айта алмадым》
Dialogue: 0,0:05:17.18,0:05:19.15,Default,,0,0,0,,Бұл әдемі.
Dialogue: 0,0:05:20.08,0:05:22.08,Default,,0,0,0,,Сәлем Анна Чан.
Dialogue: 0,0:05:23.08,0:05:26.09,Default,,0,0,0,,Е... эхехехе. Менің ойымша...
Dialogue: 0,0:05:26.09,0:05:28.19,Default,,0,0,0,,Көрініс қандай? а….
Dialogue: 0,0:05:28.19,0:05:30.16,Default,,0,0,0,,⚟Кен Катаока осында!
Dialogue: 0,0:05:31.16,0:05:33.13,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:05:33.13,0:05:36.10,Default,,0,0,0,,Релакс Релакс…. иә.
Dialogue: 0,0:05:36.10,0:05:38.10,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:05:46.11,0:05:51.11,Default,,0,0,0,,《...Мен соншалықты дөрекі және жауапсыз бірдеңені ғана айта алдым》
Dialogue: 0,0:05:51.11,0:05:55.12,Default,,0,0,0,,《Мүмкін сенің анаң қалғаның үшін ашуланған шығар...》
Dialogue: 0,0:05:55.12,0:05:58.09,Default,,0,0,0,,《Ямада қарапайым орта мектеп оқушысы емес》
Dialogue: 0,0:05:58.09,0:06:01.09,Default,,0,0,0,,《Мен де саналы әрекет етуім керек...》
Dialogue: 0,0:06:05.09,0:06:07.10,Default,,0,0,0,,《Күте тұрыңыз! Бұл...》
Dialogue: 0,0:06:07.10,0:06:09.06,Default,,0,0,0,,《Жоқ...》
Dialogue: 0,0:06:10.10,0:06:12.10,Default,,0,0,0,,《Жоқ, жоқ, жоқ, жоқ, жоқ, жоқ...! 》
Dialogue: 0,0:06:12.10,0:06:16.10,Default,,0,0,0,,《Күтілгендей! Не істеп жатырсың, Ямада! 》
Dialogue: 0,0:06:16.10,0:06:18.07,Default,,0,0,0,,《Мұндай нәрсе жақсы емес! 》
Dialogue: 0,0:06:19.11,0:06:22.11,Default,,0,0,0,,《Қараңдар! Өткір біреу бар! 》
Dialogue: 0,0:06:22.11,0:06:28.08,Default,,0,0,0,,♬～
Dialogue: 0,0:06:28.08,0:06:30.09,Default,,0,0,0,,《Отакусқа тән ұзақ сөйлемдер...》
Dialogue: 0,0:06:30.09,0:06:33.09,Default,,0,0,0,,《Барлық шоттар бірдей》
Dialogue: 0,0:06:33.09,0:06:35.12,Default,,0,0,0,,《Шошқа жігіт...? 》
Dialogue: 0,0:06:35.12,0:06:38.13,Default,,0,0,0,,《Мм...Раота Доруотаның жиі жүретін қариясы→
Dialogue: 0,0:06:38.13,0:06:40.13,Default,,0,0,0,,Бір нәрсе...》
Dialogue: 0,0:06:40.13,0:06:46.10,Default,,0,0,0,,♬～
Dialogue: 0,0:06:46.10,0:06:48.10,Default,,0,0,0,,《Мен қатты ауырып тұрмын...! 》
Dialogue: 0,0:06:50.11,0:06:53.07,Default,,0,0,0,,《Өмір сүру...Үміт...》
Dialogue: 0,0:06:58.11,0:07:00.08,Default,,0,0,0,,《Түнгі ойын~! ? 》
Dialogue: 0,0:07:00.08,0:07:04.09,Default,,0,0,0,,《Ааа...! Сіз не жаздыңыз?
Dialogue: 0,0:07:04.09,0:07:06.09,Default,,0,0,0,,《Оны өз бетімен аяқтама! 》
Dialogue: 0,0:07:06.09,0:07:08.22,Default,,0,0,0,,《Бұл не, шошқа?》
Dialogue: 0,0:07:08.22,0:07:11.09,Default,,0,0,0,,《Бұл қауесеттер өз өмірлерін алады →
Dialogue: 0,0:07:11.09,0:07:14.10,Default,,0,0,0,,Оны мазақ ететіндер міндетті түрде болады! 》
Dialogue: 0,0:07:14.10,0:07:17.10,Default,,0,0,0,,《Ол біршама тарады...》
Dialogue: 0,0:07:17.10,0:07:19.07,Default,,0,0,0,,《Қарғыс атсын... Мен мұны айтқым келген жоқ...》
Dialogue: 0,0:07:21.10,0:07:23.10,Default,,0,0,0,,《Осылай ма...》
Dialogue: 0,0:07:23.10,0:07:26.11,Default,,0,0,0,,《Жоқ, маған мұндай тұлға жасауға жол бермеңіз→
Dialogue: 0,0:07:26.11,0:07:29.08,Default,,0,0,0,,Отаку-кун... иә? 》
Dialogue: 0,0:07:30.11,0:07:32.11,Default,,0,0,0,,《Тез аға! Бұл жағдайда…》
Dialogue: 0,0:07:33.11,0:07:35.08,Default,,0,0,0,,Бұл менің таңдауым!
Dialogue: 0,0:07:35.08,0:07:39.09,Default,,0,0,0,,Ыңғайлы кезде ғана әкеңмен бетпе-бет келме!
Dialogue: 0,0:07:42.19,0:07:44.09,Default,,0,0,0,,⚟Иә, кесіңіз!
Dialogue: 0,0:07:44.09,0:07:48.10,Default,,0,0,0,,Ах... Кешіріңіз. Бұл жылайтын жер емес...
Dialogue: 0,0:07:48.10,0:07:51.07,Default,,0,0,0,,Жақсы емес пе... әзірге? Эй?
Dialogue: 0,0:07:52.10,0:07:55.10,Default,,0,0,0,,Толып жатқан жоқ па...?
Dialogue: 0,0:07:55.10,0:07:59.11,Default,,0,0,0,,Бұл Тэцу-чанның кеңсесі ме? сен. А... иә.
Dialogue: 0,0:07:59.11,0:08:03.11,Default,,0,0,0,,Жақсы. Мен ашудан гөрі алаңдаушылықты сезіндім...
Dialogue: 0,0:08:06.11,0:08:09.08,Default,,0,0,0,,Жасөспірімдер жақсы Жасөспірімдер...
Dialogue: 0,0:08:11.09,0:08:15.09,Default,,0,0,0,,Содан кейін маған түсірілімді көруге рұқсат берілді...
Dialogue: 0,0:08:15.09,0:08:19.13,Default,,0,0,0,,Күткендей, Кен Катаока керемет...
Dialogue: 0,0:08:19.13,0:08:24.17,Default,,0,0,0,,"Бірақ мақтаған Ямада болды. Таңғажайып Ямада емес пе?"
Dialogue: 0,0:08:24.17,0:08:26.10,Default,,0,0,0,,Жоқ, бұл дұрыс емес...
Dialogue: 0,0:08:26.10,0:08:31.11,Default,,0,0,0,,Мен қызық болып жүргенде неге жылады екен...
Dialogue: 0,0:08:32.11,0:08:34.08,Default,,0,0,0,,Ол кезде мен...
Dialogue: 0,0:08:36.11,0:08:41.08,Default,,0,0,0,,Мен аз болса да Ичикаваның жүрегіне әсер еткендей болдым.
Dialogue: 0,0:08:42.08,0:08:46.12,Default,,0,0,0,,«Өзіме деген ашуланшақтық және алаңдаушылық...»
Dialogue: 0,0:08:46.12,0:08:50.13,Default,,0,0,0,,«Катаока-сан, менің ойымша, сен мұны түсіндің».
Dialogue: 0,0:08:50.13,0:08:53.13,Default,,0,0,0,,«Сонымен басқа түн→
Dialogue: 0,0:08:53.13,0:08:56.10,Default,,0,0,0,,Менімен бірге болғаныңызға өте қуаныштымын...».
Dialogue: 0,0:08:57.10,0:09:00.10,Default,,0,0,0,,«Ал, анам маған ашуланды.»
Dialogue: 0,0:09:00.10,0:09:02.14,Default,,0,0,0,,Күткендей... Меніңше, ол ашуланды...
Dialogue: 0,0:09:02.14,0:09:04.24,Default,,0,0,0,,Иә….
Dialogue: 0,0:09:04.24,0:09:07.11,Default,,0,0,0,,Өтірік айтпа... Олай айтпа.
Dialogue: 0,0:09:07.11,0:09:10.11,Default,,0,0,0,,Тіпті анам да ата-анама көп өтірік айтқан.
Dialogue: 0,0:09:11.15,0:09:14.12,Default,,0,0,0,,Бірақ мен сізді шынымен қолдағым келеді →
Dialogue: 0,0:09:14.12,0:09:17.09,Default,,0,0,0,,...
Dialogue: 0,0:09:21.12,0:09:23.12,Default,,0,0,0,,Ах... рахмет...
Dialogue: 0,0:09:23.12,0:09:25.13,Default,,0,0,0,,"Не? Бұл сызық."
Dialogue: 0,0:09:25.13,0:09:27.13,Default,,0,0,0,,Мен... көремін...
Dialogue: 0,0:09:27.13,0:09:31.13,Default,,0,0,0,,《Ештеңе де босқа кетпейді》
Dialogue: 0,0:09:31.13,0:09:34.10,Default,,0,0,0,,《… …》
Dialogue: 0,0:09:36.10,0:09:38.14,Default,,0,0,0,,《→
Dialogue: 0,0:09:38.14,0:09:41.11,Default,,0,0,0,,Түсірілімнің өзі туралы уайымдаудың қажеті жоқ деп ойлаймын...》
Dialogue: 0,0:09:41.11,0:09:43.14,Default,,0,0,0,,《Мәселе мынада...》
Dialogue: 0,0:09:43.14,0:09:48.12,Default,,0,0,0,,《Егер мен тағы да осындай пост жазсам, отакус ананы, ананы істейді...》
Dialogue: 0,0:09:49.12,0:09:52.12,Default,,0,0,0,,→
Dialogue: 0,0:09:52.12,0:09:54.12,Default,,0,0,0,,...
Dialogue: 0,0:09:54.12,0:09:56.12,Default,,0,0,0,,...
Dialogue: 0,0:09:56.12,0:09:58.13,Default,,0,0,0,,...
Dialogue: 0,0:09:58.13,0:10:01.10,Default,,0,0,0,,...
Dialogue: 0,0:10:01.10,0:10:03.10,Default,,0,0,0,,Е...
Dialogue: 0,0:10:03.10,0:10:05.10,Default,,0,0,0,,…Аа!
Dialogue: 0,0:10:14.11,0:10:16.08,Default,,0,0,0,,Не?
Dialogue: 0,0:10:18.11,0:10:22.08,Default,,0,0,0,,《Менің кеудемдегі ауыру сезімі не...》
Dialogue: 0,0:10:23.08,0:10:27.09,Default,,0,0,0,,《Мен бұл жігіттің эмоцияларымен таныспын...》
Dialogue: 0,0:10:28.09,0:10:31.09,Default,,0,0,0,,《… …》
Dialogue: 0,0:10:35.13,0:10:39.10,Default,,0,0,0,,...
Dialogue: 0,0:10:39.10,0:10:43.10,Default,,0,0,0,,«Қазір... Шиманами Кайдо?» Келіңіздер...
Dialogue: 0,0:10:43.10,0:10:46.11,Default,,0,0,0,,«Неге жергілікті тұрғындар түсінбейді?»
Dialogue: 0,0:10:46.11,0:10:48.11,Default,,0,0,0,,«Оның үстіне сен қазір жалғызсың, солай ма?»
Dialogue: 0,0:10:48.11,0:10:51.08,Default,,0,0,0,,...
Dialogue: 0,0:10:51.08,0:10:55.08,Default,,0,0,0,,«Сондықтан не айтсаң да, бәрі жақсы». Жоқ, олай емес...
Dialogue: 0,0:10:55.08,0:10:59.12,Default,,0,0,0,,《Жақын жерде қауіпті желдеткіштер бар деп айту тым ауыр ма?》
Dialogue: 0,0:10:59.12,0:11:02.09,Default,,0,0,0,,Ум, иә... тек артыңызды бақылаңыз...
Dialogue: 0,0:11:02.09,0:11:05.09,Default,,0,0,0,,「   」
Dialogue: 0,0:11:06.13,0:11:08.10,Default,,0,0,0,,...
Dialogue: 0,0:11:08.10,0:11:11.10,Default,,0,0,0,,...
Dialogue: 0,0:11:11.10,0:11:13.10,Default,,0,0,0,,「 」
Dialogue: 0,0:11:13.10,0:11:15.07,Default,,0,0,0,,「 」
Dialogue: 0,0:11:16.10,0:11:20.11,Default,,0,0,0,,「」  …
Dialogue: 0,0:11:24.11,0:11:27.08,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:11:27.08,0:11:32.12,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:11:32.12,0:11:37.09,Default,,0,0,0,,Цубаки қыз.
Dialogue: 0,0:11:39.09,0:11:41.10,Default,,0,0,0,,Бұл өтірік...
Dialogue: 0,0:11:45.17,0:11:47.10,Default,,0,0,0,,⚟ (Жаңбыр дыбысы)
Dialogue: 0,0:11:47.10,0:11:50.10,Default,,0,0,0,,《 》
Dialogue: 0,0:11:50.10,0:11:52.07,Default,,0,0,0,,《…》
Dialogue: 0,0:11:54.11,0:11:57.11,Default,,0,0,0,,《 …》
Dialogue: 0,0:11:57.11,0:12:16.10,Default,,0,0,0,,♬～
Dialogue: 0,0:12:16.10,0:12:18.10,Default,,0,0,0,,Он… бе… с…
Dialogue: 0,0:12:18.10,0:12:22.10,Default,,0,0,0,,《 …》
Dialogue: 0,0:12:23.17,0:12:26.14,Default,,0,0,0,,（）
Dialogue: 0,0:12:29.11,0:12:32.08,Default,,0,0,0,,《Жоқ. Жетеді. Сен мені жек көрсең де! 》
Dialogue: 0,0:12:42.12,0:12:45.09,Default,,0,0,0,,Ах... а... а...
Dialogue: 0,0:12:45.09,0:12:48.13,Default,,0,0,0,,… …  …
Dialogue: 0,0:12:48.13,0:12:52.10,Default,,0,0,0,,《  》
Dialogue: 0,0:12:53.13,0:12:55.14,Default,,0,0,0,,23:00….
Dialogue: 0,0:12:55.14,0:12:59.14,Default,,0,0,0,,《 …》
Dialogue: 0,0:12:59.14,0:13:01.11,Default,,0,0,0,,...
Dialogue: 0,0:13:01.11,0:13:03.08,Default,,0,0,0,,Е...
Dialogue: 0,0:13:04.11,0:13:07.08,Default,,0,0,0,,Суық... Жоғары шығыңыз.
Dialogue: 0,0:13:15.12,0:13:18.09,Default,,0,0,0,,Уау...!
Dialogue: 0,0:13:18.09,0:13:21.06,Default,,0,0,0,,《Кәсіби аспазшыдан күткендей...》
Dialogue: 0,0:13:22.10,0:13:25.10,Default,,0,0,0,,Міне осылай, ата-анаңа хабарлас.
Dialogue: 0,0:13:25.10,0:13:27.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:27.10,0:13:30.07,Default,,0,0,0,,...
Dialogue: 0,0:13:32.11,0:13:34.11,Default,,0,0,0,,《Жаман...Сәл ашуландың ба? 》
Dialogue: 0,0:13:34.11,0:13:38.25,Default,,0,0,0,,《Егер сіз бұл туралы ойласаңыз, сіз өте жиіркенішті әрекет етесіз.》
Dialogue: 0,0:13:38.25,0:13:40.08,Default,,0,0,0,,《 》
Dialogue: 0,0:13:40.08,0:13:42.08,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:13:44.09,0:13:46.09,Default,,0,0,0,,Әй, Анна?
Dialogue: 0,0:13:48.22,0:13:52.09,Default,,0,0,0,,Енді...? Не? Байланыс?
Dialogue: 0,0:13:52.09,0:13:55.10,Default,,0,0,0,,...
Dialogue: 0,0:13:55.10,0:13:58.27,Default,,0,0,0,,…  …
Dialogue: 0,0:13:58.27,0:14:00.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:01.10,0:14:04.11,Default,,0,0,0,,...
Dialogue: 0,0:14:05.11,0:14:07.11,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:07.11,0:14:11.11,Default,,0,0,0,,Аннаның ұялы телефоны суға батып кетті, мен онымен байланыса алмаймын →
Dialogue: 0,0:14:11.11,0:14:13.08,Default,,0,0,0,,...
Dialogue: 0,0:14:15.08,0:14:17.12,Default,,0,0,0,,...
Dialogue: 0,0:14:17.12,0:14:19.12,Default,,0,0,0,,...
Dialogue: 0,0:14:19.12,0:14:23.09,Default,,0,0,0,,…  …
Dialogue: 0,0:14:25.09,0:14:30.06,Default,,0,0,0,,...
Dialogue: 0,0:14:32.10,0:14:34.10,Default,,0,0,0,,О, о...
Dialogue: 0,0:14:34.10,0:14:36.10,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:14:36.10,0:14:40.07,Default,,0,0,0,,"Не? Юки. Сен жалғызсың ба?"
Dialogue: 0,0:14:40.07,0:14:43.08,Default,,0,0,0,,… … 「 … 」
Dialogue: 0,0:14:43.08,0:14:47.08,Default,,0,0,0,,…  …
Dialogue: 0,0:14:47.08,0:14:49.08,Default,,0,0,0,,「…」 「」
Dialogue: 0,0:14:49.08,0:14:51.09,Default,,0,0,0,,→
Dialogue: 0,0:14:51.09,0:14:54.26,Default,,0,0,0,,Мен бұрыла сала ұялы телефонымды теңізге тастадым→
Dialogue: 0,0:14:54.26,0:14:56.12,Default,,0,0,0,,→
Dialogue: 0,0:14:56.12,0:14:59.19,Default,,0,0,0,,Мен Ичикава шынымен уайымдап жатыр деп ойлап, оған хат жаздым...
Dialogue: 0,0:14:59.19,0:15:02.10,Default,,0,0,0,,...
Dialogue: 0,0:15:02.10,0:15:04.33,Default,,0,0,0,,...
Dialogue: 0,0:15:04.33,0:15:07.10,Default,,0,0,0,,… …
Dialogue: 0,0:15:07.10,0:15:10.10,Default,,0,0,0,,Бұлтты пайдалансаңыз, деректеріңізді қайтара аласыз...
Dialogue: 0,0:15:10.10,0:15:12.11,Default,,0,0,0,,Иә….
Dialogue: 0,0:15:12.11,0:15:14.08,Default,,0,0,0,,Ум...
Dialogue: 0,0:15:16.11,0:15:18.08,Default,,0,0,0,,Анашым….
Dialogue: 0,0:15:18.08,0:15:23.05,Default,,0,0,0,,… …
Dialogue: 0,0:15:24.22,0:15:27.22,Default,,0,0,0,,… …
Dialogue: 0,0:15:29.26,0:15:31.26,Default,,0,0,0,,Маған ұнайды. Бұны ұнатамын.
Dialogue: 0,0:15:36.10,0:15:38.10,Default,,0,0,0,,→
Dialogue: 0,0:15:38.10,0:15:42.07,Default,,0,0,0,,Сондықтан мен тұру туралы көп ойладым...
Dialogue: 0,0:15:48.11,0:15:52.08,Default,,0,0,0,,『』
Dialogue: 0,0:15:57.08,0:16:01.09,Default,,0,0,0,,《Оқиғалы көктемгі демалыс осылай өтті...》
Dialogue: 0,0:16:07.09,0:16:11.10,Default,,0,0,0,,Токионың дәмдері көбірек...
Dialogue: 0,0:16:11.10,0:16:13.10,Default,,0,0,0,,Бүгін той күні болады.
Dialogue: 0,0:16:13.10,0:16:17.07,Default,,0,0,0,,Ал... өткен күні жасаған басқа шоттан...
Dialogue: 0,0:16:24.08,0:16:28.08,Default,,0,0,0,,《Иә. Бұрын жазылған 》
Dialogue: 0,0:16:28.08,0:16:31.12,Default,,0,0,0,,《Неге байқамадым! 》
Dialogue: 0,0:16:31.12,0:16:33.09,Default,,0,0,0,,《Әрқашан солай...》
Dialogue: 0,0:16:33.09,0:16:37.09,Default,,0,0,0,,《Қауіпті адамдар өзімді қауіпсіз сезінгенде келеді...》
Dialogue: 0,0:16:37.09,0:16:40.06,Default,,0,0,0,,Ямада...! Ямада! !
Dialogue: 0,0:16:42.10,0:16:44.07,Default,,0,0,0,,Бүгін….
Dialogue: 0,0:16:47.10,0:16:49.10,Default,,0,0,0,,Сіз бір-біріңізді танисыз ба?
Dialogue: 0,0:16:49.10,0:16:51.11,Default,,0,0,0,,Ах... мм...
Dialogue: 0,0:16:51.11,0:16:54.08,Default,,0,0,0,,Аа, мен өткен күні сенімдімін ...
Dialogue: 0,0:16:54.08,0:16:56.08,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:16:56.08,0:17:01.12,Default,,0,0,0,,《Бұл адам түсірілім орнында Ямаданың сүйсінген моделі болды...》
Dialogue: 0,0:17:01.12,0:17:04.12,Default,,0,0,0,,《Одан да, ол қазір шошқа.》
Dialogue: 0,0:17:04.12,0:17:06.12,Default,,0,0,0,,Біз кездейсоқ кездесіп қалдық...
Dialogue: 0,0:17:06.12,0:17:11.13,Default,,0,0,0,,《Шынында мен сені басқа жерге шақырғым келеді, бірақ бұл адам дәл қазір осында...》
Dialogue: 0,0:17:11.13,0:17:14.13,Default,,0,0,0,,Ямада... Мен сенімен тамақ ішсем болады ма?
Dialogue: 0,0:17:14.13,0:17:16.10,Default,,0,0,0,,…Иә!
Dialogue: 0,0:17:18.10,0:17:20.10,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:17:21.20,0:17:25.17,Default,,0,0,0,,Артқы жақтағы үшінші орын, өтінемін. рақмет сізге.
Dialogue: 0,0:17:28.08,0:17:30.08,Default,,0,0,0,,《Мм! ? 》
Dialogue: 0,0:17:31.11,0:17:33.11,Default,,0,0,0,,《Жоқ, болмайды...》 Анна-чан, Ономичи қалай болды?
Dialogue: 0,0:17:33.11,0:17:35.12,Default,,0,0,0,,《Харизматикалық модель...》 Аа, сен білесің бе?
Dialogue: 0,0:17:35.12,0:17:37.12,Default,,0,0,0,,Бұл жергілікті.
Dialogue: 0,0:17:38.12,0:17:40.09,Default,,0,0,0,,Шошқа жігіт….
Dialogue: 0,0:17:43.12,0:17:45.09,Default,,0,0,0,,《Түсінуге оңай! 》
Dialogue: 0,0:17:45.09,0:17:47.13,Default,,0,0,0,,Күткеніңізге рахмет!
Dialogue: 0,0:17:47.13,0:17:50.20,Default,,0,0,0,,Бұл қоспасы жоқ кішкентай рамен...
Dialogue: 0,0:17:50.20,0:17:52.17,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:17:52.17,0:17:56.17,Default,,0,0,0,,《Түсіндім, мен мұны бұрын оқығанмын, Рамен-ро...》
Dialogue: 0,0:17:58.14,0:18:00.27,Default,,0,0,0,,(кеспенің шырылдаған дыбысы)
Dialogue: 0,0:18:00.27,0:18:04.11,Default,,0,0,0,,《Осындай дүкенде бес адам лоттар бойынша тұтынушыларға қызмет көрсетеді.》
Dialogue: 0,0:18:04.11,0:18:07.11,Default,,0,0,0,,《Кешігіп қалсаң, сені ``топтық тәртіпсіздік'' деп атайды да, аулақ болады...》
Dialogue: 0,0:18:07.11,0:18:09.12,Default,,0,0,0,,《Жоқ...》
Dialogue: 0,0:18:09.12,0:18:11.09,Default,,0,0,0,,《Мен оған жеңіл кірмеуім керек еді》
Dialogue: 0,0:18:14.12,0:18:16.09,Default,,0,0,0,,Аа... 《Бұл өте жылдам! 》
Dialogue: 0,0:18:17.09,0:18:19.09,Default,,0,0,0,,《Қарғыс атсын...! 》
Dialogue: 0,0:18:25.10,0:18:27.10,Default,,0,0,0,,Мм… Мен….
Dialogue: 0,0:18:30.10,0:18:32.07,Default,,0,0,0,,Бұл Танатос.
Dialogue: 0,0:18:33.07,0:18:35.11,Default,,0,0,0,,Тана...?
Dialogue: 0,0:18:35.11,0:18:37.11,Default,,0,0,0,,《Мені бірден бұғаттады》
Dialogue: 0,0:18:37.11,0:18:45.09,Default,,0,0,0,,Ямаданың... Анна Акиноның... фанаты... Сонымен... мен де...
Dialogue: 0,0:18:45.09,0:18:48.12,Default,,0,0,0,,Бұл жақсы, Анна-чан.
Dialogue: 0,0:18:48.12,0:18:52.09,Default,,0,0,0,,Сүйкімді, салқын, салқын, жетілген...
Dialogue: 0,0:18:52.09,0:18:55.10,Default,,0,0,0,,Керемет….
Dialogue: 0,0:18:55.10,0:18:57.10,Default,,0,0,0,,《Ынталы жанкүйер...》
Dialogue: 0,0:18:57.10,0:19:01.10,Default,,0,0,0,,《Егер Ямада болашақта танымал болса, олардың саны көбейетін шығар.》
Dialogue: 0,0:19:01.10,0:19:05.11,Default,,0,0,0,,《Бірақ мен білемін》
Dialogue: 0,0:19:05.11,0:19:09.08,Default,,0,0,0,,《Мінсіз емес... Анна Ямада...》
Dialogue: 0,0:19:12.08,0:19:15.12,Default,,0,0,0,,Бұл менің жеңісім.
Dialogue: 0,0:19:15.12,0:19:19.09,Default,,0,0,0,,Ыдыс Оны жоғары көтеріңіз.
Dialogue: 0,0:19:24.09,0:19:26.06,Default,,0,0,0,,Мен жай ғана жағдайды біраз бақылап тұрамын.
Dialogue: 0,0:19:27.09,0:19:32.10,Default,,0,0,0,,А... Иә? Мен сені көптен бері көрмегендіктен бойың өсті ме?
Dialogue: 0,0:19:32.10,0:19:35.10,Default,,0,0,0,,Туыстар? Себебі ол өкше.
Dialogue: 0,0:19:36.10,0:19:38.17,Default,,0,0,0,,Ичикава аяқ киімдері бөлек....
Dialogue: 0,0:19:38.17,0:19:40.11,Default,,0,0,0,,Не? А... бұл...
Dialogue: 0,0:19:40.11,0:19:43.08,Default,,0,0,0,,Сіз сонша асығыс келдіңіз бе? Е... жоқ...
Dialogue: 0,0:19:43.08,0:19:45.08,Default,,0,0,0,,Джи….
Dialogue: 0,0:19:46.18,0:19:50.15,Default,,0,0,0,,Анна-чан, сен бұл бетті жасайсың. О, жоқ. өзен….
Dialogue: 0,0:19:52.09,0:19:56.26,Default,,0,0,0,,Мен... мен... Ах... Жоқ, бұл мен→
Dialogue: 0,0:19:56.26,0:19:59.09,Default,,0,0,0,,Нико-чан туралы Мен сізді әрқашан таңдандырдым.
Dialogue: 0,0:19:59.09,0:20:02.10,Default,,0,0,0,,Қайтадан бірге жұмыс істеуге рұқсат етіңіз!
Dialogue: 0,0:20:02.10,0:20:06.30,Default,,0,0,0,,Өйткені мен сүйікті адамдарымнан тиісті қашықтықты сақтағысы келетін адаммын.
Dialogue: 0,0:20:06.30,0:20:08.10,Default,,0,0,0,,《Отаку》
Dialogue: 0,0:20:08.10,0:20:11.21,Default,,0,0,0,,《Егер бұл өзара махаббат болса, онда...》
Dialogue: 0,0:20:11.21,0:20:13.11,Default,,0,0,0,,Олай болса. О, күте тұрыңыз ...
Dialogue: 0,0:20:13.11,0:20:15.08,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:20:15.08,0:20:19.08,Default,,0,0,0,,Ямаданың жеке ақпаратын ешқашан жарияламаңыз!
Dialogue: 0,0:20:19.08,0:20:22.08,Default,,0,0,0,,Жоқ... Маған қызық, не болып жатыр...
Dialogue: 0,0:20:25.09,0:20:27.09,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:20:28.09,0:20:33.09,Default,,0,0,0,,《Мен харизматикалық модельмен байланыс ақпаратын алмастым...》
Dialogue: 0,0:20:41.10,0:20:45.11,Default,,0,0,0,,Ұялы телефоныңыз туралы алаңдатқаным үшін кешіріңіз.
Dialogue: 0,0:20:45.11,0:20:50.08,Default,,0,0,0,,Жоқ, менде жай ғана теріс адасушылық болды.
Dialogue: 0,0:20:50.08,0:20:52.08,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:20:55.08,0:20:59.12,Default,,0,0,0,,Бұл дүниеде атақты адамдардың қадірін кетіргісі келетін адамдар бар→
Dialogue: 0,0:20:59.12,0:21:01.12,Default,,0,0,0,,Олар өте көп.
Dialogue: 0,0:21:01.12,0:21:05.09,Default,,0,0,0,,Сондықтан мен жариялаған фотосуреттерге абай болу керек...
Dialogue: 0,0:21:08.10,0:21:12.10,Default,,0,0,0,,Сәлем... Адамдар көп болатын жерлерде қашықтықты сақтаңыз.
Dialogue: 0,0:21:12.10,0:21:22.11,Default,,0,0,0,,♬～
Dialogue: 0,0:21:22.11,0:21:27.11,Default,,0,0,0,,Иә. Мен сені енді алаңдатқым келмейді.
Dialogue: 0,0:21:27.11,0:21:31.09,Default,,0,0,0,,Себебі мен ересек болғым келеді.
Dialogue: 0,0:21:31.09,0:21:35.09,Default,,0,0,0,,《Иә, тиісті қашықтық сезімімен...》
Dialogue: 0,0:21:37.19,0:21:39.09,Default,,0,0,0,,Мен ересек адам болғым келеді Салқын және мағыналы.
Dialogue: 0,0:21:39.09,0:21:41.10,Default,,0,0,0,,《Тыныш! 》
Dialogue: 0,0:21:41.10,0:21:43.06,Default,,0,0,0,,Мен ересек болғым келеді!
Dialogue: 0,0:21:44.10,0:21:51.07,Default,,0,0,0,,♬～
Dialogue: 0,0:21:52.57,0:21:58.57,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
