Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.09,0:00:11.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:11.76,0:00:14.05,Default,,0,0,0,,Анна-чан жақсы жерде
Dialogue: 0,0:00:14.13,0:00:16.09,Default,,0,0,0,,Бұл Валентин шоколады.
Dialogue: 0,0:00:16.18,0:00:16.80,Default,,0,0,0,,Мен де
Dialogue: 0,0:00:17.60,0:00:18.89,Default,,0,0,0,,Рахмет
Dialogue: 0,0:00:18.97,0:00:21.31,Default,,0,0,0,,-(А қыз) Сүйкімді... -(Б қыз) Сүйкімді...
Dialogue: 0,0:00:21.39,0:00:23.69,Default,,0,0,0,,Кяа~! Бұл сүйкімді болды
Dialogue: 0,0:00:24.98,0:00:25.56,Default,,0,0,0,,Курури
Dialogue: 0,0:00:25.65,0:00:27.61,Default,,0,0,0,,Тағы бір бару керек пе?
Dialogue: 0,0:00:27.69,0:00:29.65,Default,,0,0,0,,Бұл қазірдің өзінде бесінші айналым.
Dialogue: 0,0:00:32.40,0:00:34.15,Default,,0,0,0,,Мұнда көп адам жиналды
Dialogue: 0,0:00:34.24,0:00:36.49,Default,,0,0,0,,Хмм, бұл жақсы.
Dialogue: 0,0:00:36.57,0:00:37.74,Default,,0,0,0,,Нене Чиха?
Dialogue: 0,0:00:37.82,0:00:39.49,Default,,0,0,0,,Иә? Менің анам...
Dialogue: 0,0:00:39.58,0:00:41.58,Default,,0,0,0,,Басқа күндер сияқты
Dialogue: 0,0:00:41.66,0:00:43.00,Default,,0,0,0,,Сізге жақсы
Dialogue: 0,0:00:43.08,0:00:44.96,Default,,0,0,0,,14 ақпан
Dialogue: 0,0:00:46.42,0:00:49.84,Default,,0,0,0,,Оби шоколадын жою науқанын жүргізейік!
Dialogue: 0,0:00:49.92,0:00:54.01,Default,,0,0,0,,Қате түсінетін мұңды ұлдардың санын көбейткіңіз келмейді!
Dialogue: 0,0:00:54.09,0:00:55.34,Default,,0,0,0,,Ммм
Dialogue: 0,0:00:55.43,0:00:58.26,Default,,0,0,0,,Иә, бірінші келген, бірінші қызмет етеді.
Dialogue: 0,0:00:58.34,0:00:59.26,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:00.89,0:01:01.85,Default,,0,0,0,,Нихихи…
Dialogue: 0,0:01:01.93,0:01:03.31,Default,,0,0,0,,Жою қозғалысы туралы не айтасыз?
Dialogue: 0,0:01:04.43,0:01:05.81,Default,,0,0,0,,Көгершін сияқты
Dialogue: 0,0:01:07.65,0:01:09.11,Default,,0,0,0,,Жолдан тез кет.
Dialogue: 0,0:01:09.19,0:01:10.44,Default,,0,0,0,,- (Секине) Алдың ба? -(Ичикава) Жоқ.
Dialogue: 0,0:01:10.52,0:01:12.07,Default,,0,0,0,,- (Секине) Мен саған беремін - (Ичикава) Маған керегі жоқ.
Dialogue: 0,0:01:12.15,0:01:14.82,Default,,0,0,0,,Сен осылай айтасың деп ойлап едім, Итчидің үстеліне жайып жібердім.
Dialogue: 0,0:01:14.90,0:01:16.07,Default,,0,0,0,,- (Ичикава) Иә? -(Секине) А?
Dialogue: 0,0:01:16.15,0:01:17.28,Default,,0,0,0,,Ахмм
Dialogue: 0,0:01:17.78,0:01:19.74,Default,,0,0,0,,Ямада~
Dialogue: 0,0:01:20.45,0:01:21.49,Default,,0,0,0,,Мен бүгін ұлмын
Dialogue: 0,0:01:21.58,0:01:22.37,Default,,0,0,0,,...
Dialogue: 0,0:01:22.45,0:01:24.33,Default,,0,0,0,,Не деген сұмдық!
Dialogue: 0,0:01:24.83,0:01:26.12,Default,,0,0,0,,Ууууах!
Dialogue: 0,0:01:26.21,0:01:29.00,Default,,0,0,0,,Әй, қарашы, мына жаңғақ жүрек пішінді екен ғой?
Dialogue: 0,0:01:29.08,0:01:31.00,Default,,0,0,0,,Бұл жасырын сүйікті ме?
Dialogue: 0,0:01:31.09,0:01:32.46,Default,,0,0,0,,Сіз тым толқып тұрсыз.
Dialogue: 0,0:01:32.55,0:01:34.76,Default,,0,0,0,,- (Секине) Саған бермеуім керек еді - (Йошида) Болды.
Dialogue: 0,0:01:34.84,0:01:37.05,Default,,0,0,0,,Шоколад алу арқылы қателесесің.
Dialogue: 0,0:01:37.13,0:01:38.76,Default,,0,0,0,,Адам таза
Dialogue: 0,0:01:38.84,0:01:40.05,Default,,0,0,0,,Ичикава да, солай ма?
Dialogue: 0,0:01:40.14,0:01:41.97,Default,,0,0,0,,Таза Золушка Бала, солай ма?
Dialogue: 0,0:01:42.06,0:01:42.93,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:01:45.02,0:01:47.02,Default,,0,0,0,,♪～
Dialogue: 0,0:03:12.90,0:03:14.90,Default,,0,0,0,,～♪
Dialogue: 0,0:03:15.52,0:03:16.90,Default,,0,0,0,,(Үстелге жайылған шоколадтың дыбысы)
Dialogue: 0,0:03:16.98,0:03:18.90,Default,,0,0,0,,Бүгін шоги ойынын ойнайық
Dialogue: 0,0:03:18.99,0:03:20.82,Default,,0,0,0,,Ережелер мен білмеймін.
Dialogue: 0,0:03:20.90,0:03:22.32,Default,,0,0,0,,Шоги де шоги
Dialogue: 0,0:03:22.41,0:03:23.87,Default,,0,0,0,,Тироль шоколады Шоги
Dialogue: 0,0:03:23.95,0:03:26.03,Default,,0,0,0,,- (Ямада) Жоқ - (Ичикава) Жоқ, мен артық білмеймін.
Dialogue: 0,0:03:32.29,0:03:32.79,Default,,0,0,0,,Ах
Dialogue: 0,0:03:33.96,0:03:36.17,Default,,0,0,0,,Бұл болды ма...
Dialogue: 0,0:03:36.25,0:03:37.09,Default,,0,0,0,,Қай қозғалыс?
Dialogue: 0,0:03:38.42,0:03:39.84,Default,,0,0,0,,Ичикава да айтты
Dialogue: 0,0:03:39.92,0:03:42.38,Default,,0,0,0,,- (Ичикава) Әй, анау қол... - (Ямада) Қазір емес.
Dialogue: 0,0:03:42.47,0:03:43.59,Default,,0,0,0,,Қашан?
Dialogue: 0,0:03:47.31,0:03:50.35,Default,,0,0,0,,Қанша ойласам да түсінбеймін.
Dialogue: 0,0:03:51.14,0:03:52.94,Default,,0,0,0,,Не? Мен қалай жеңемін...
Dialogue: 0,0:03:53.02,0:03:54.85,Default,,0,0,0,,- (Ямада) Мен келдім - (Ичикава) Иә?
Dialogue: 0,0:03:54.94,0:03:56.19,Default,,0,0,0,,Иә
Dialogue: 0,0:03:56.27,0:03:57.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:57.77,0:04:00.69,Default,,0,0,0,,Жеңімпаз барлық фигураларды алады.
Dialogue: 0,0:04:00.78,0:04:02.20,Default,,0,0,0,,... ереже болып табылады
Dialogue: 0,0:04:02.82,0:04:03.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:10.79,0:04:12.58,Default,,0,0,0,,Бірақ қалай…
Dialogue: 0,0:04:14.37,0:04:17.04,Default,,0,0,0,,Хмм… Сәлеметсіз бе.
Dialogue: 0,0:04:21.55,0:04:22.22,Default,,0,0,0,,Шоколад
Dialogue: 0,0:04:23.47,0:04:26.93,Default,,0,0,0,,Шоколад... бұл шоколад.
Dialogue: 0,0:04:27.43,0:04:29.01,Default,,0,0,0,,Бұл шоколад...
Dialogue: 0,0:04:29.51,0:04:31.31,Default,,0,0,0,,Маған берген шоколадыңызды көрсетіңіз.
Dialogue: 0,0:04:33.06,0:04:35.19,Default,,0,0,0,,Шоколадыңызда жүрек жоқ.
Dialogue: 0,0:04:35.27,0:04:36.35,Default,,0,0,0,,Бұл міндет, жарайды!
Dialogue: 0,0:04:36.44,0:04:38.27,Default,,0,0,0,,А, болады, А, ха.
Dialogue: 0,0:04:38.86,0:04:42.03,Default,,0,0,0,,Мен «Гири» деп жазылғанымен жүруім керек еді.
Dialogue: 0,0:04:42.61,0:04:46.66,Default,,0,0,0,,Шоколад беріп қана тоймайды ғой.
Dialogue: 0,0:04:46.74,0:04:48.87,Default,,0,0,0,,Сезіміңді жеткізе алмасаң мағынасыз
Dialogue: 0,0:04:54.58,0:04:56.25,Default,,0,0,0,,Шоколад…
Dialogue: 0,0:04:56.33,0:05:01.42,Default,,0,0,0,,Жоқ, Ямаданың адамдарға тәтті беруі әдеттен тыс.
Dialogue: 0,0:05:01.50,0:05:05.26,Default,,0,0,0,,Бұл да Ямаданың әдеттегі эксцентриктерінің бірі ме?
Dialogue: 0,0:05:05.34,0:05:06.76,Default,,0,0,0,,Уау! Жүгіру қиын
Dialogue: 0,0:05:07.34,0:05:08.09,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:08.18,0:05:09.76,Default,,0,0,0,,- (Ямада) Ши~! -(Ичикава) Иә?
Dialogue: 0,0:05:11.26,0:05:12.31,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:05:12.85,0:05:15.81,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:05:18.40,0:05:19.65,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:05:19.73,0:05:21.40,Default,,0,0,0,,Біреудің шоколадын қызғану деген нені білдіреді?
Dialogue: 0,0:05:21.48,0:05:22.23,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:22.32,0:05:23.90,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:05:24.40,0:05:27.28,Default,,0,0,0,,Бүгінде оғаш қылықтар көп.
Dialogue: 0,0:05:28.78,0:05:31.87,Default,,0,0,0,,(Ямаданың гуілдеуі)
Dialogue: 0,0:05:31.95,0:05:35.37,Default,,0,0,0,,Бірақ мен мектепте ештеңе берудің қажеті жоқ.
Dialogue: 0,0:05:35.46,0:05:38.96,Default,,0,0,0,,Қараңдаршы, Хара мырза достарымен бірге үйге қайтты.
Dialogue: 0,0:05:39.04,0:05:41.63,Default,,0,0,0,,Де... Біз кездесіп жатырмыз, солай ма?
Dialogue: 0,0:05:42.21,0:05:45.13,Default,,0,0,0,,Оны маған кез келген уақытта бере аласыз. Күн ұзақ.
Dialogue: 0,0:05:45.21,0:05:45.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:47.72,0:05:51.14,Default,,0,0,0,,Мектеп – білім ордасы. Бұл проблема емес.
Dialogue: 0,0:05:51.97,0:05:52.81,Default,,0,0,0,,Олай болса
Dialogue: 0,0:05:53.31,0:05:54.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:54.52,0:05:55.93,Default,,0,0,0,,Жүріңіз
Dialogue: 0,0:05:56.02,0:05:57.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:00.15,0:06:01.65,Default,,0,0,0,,Бүйірлік атпен жүру қорқынышты
Dialogue: 0,0:06:02.73,0:06:04.40,Default,,0,0,0,,баяу
Dialogue: 0,0:06:05.82,0:06:07.99,Default,,0,0,0,,Өйткені күн ұзақ
Dialogue: 0,0:06:12.49,0:06:14.45,Default,,0,0,0,,Сіз мұны қайтадан жасадыңыз. Екі орындық.
Dialogue: 0,0:06:15.54,0:06:16.87,Default,,0,0,0,,Бұрын
Dialogue: 0,0:06:16.95,0:06:20.00,Default,,0,0,0,,Мен полиция жәшігінің қасынан өтіп бара жатып өлемін деп ойладым.
Dialogue: 0,0:06:20.58,0:06:22.13,Default,,0,0,0,,Байқамадым
Dialogue: 0,0:06:22.21,0:06:25.21,Default,,0,0,0,,Мен саған түсе бер деп ойладым, бірақ...
Dialogue: 0,0:06:26.13,0:06:27.92,Default,,0,0,0,,Сіз өзгеруден қорқатын адамсыз.
Dialogue: 0,0:06:28.51,0:06:31.05,Default,,0,0,0,,Соны естігенде... ренжідім.
Dialogue: 0,0:06:31.14,0:06:33.26,Default,,0,0,0,,Мен мұны айттым ба?
Dialogue: 0,0:06:33.35,0:06:35.31,Default,,0,0,0,,Мен, әрине, солай ойладым.
Dialogue: 0,0:06:36.52,0:06:39.39,Default,,0,0,0,,Менің ойымша, Ямада түсінбейді, өйткені ол өзгерістерді ұнататын түрі.
Dialogue: 0,0:06:39.89,0:06:41.15,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:06:41.65,0:06:42.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:45.15,0:06:48.74,Default,,0,0,0,,Бірақ қазір түсінерсіз.
Dialogue: 0,0:06:51.28,0:06:53.87,Default,,0,0,0,,Мен қазір бақытты болғандықтан ба?
Dialogue: 0,0:07:01.12,0:07:03.08,Default,,0,0,0,,Жоқ... жоқ, әлі жетпейді
Dialogue: 0,0:07:03.84,0:07:05.84,Default,,0,0,0,,Себебі менің қарным ашты.
Dialogue: 0,0:07:13.18,0:07:15.39,Default,,0,0,0,,Мұндай заттың қымбат екені сөзсіз.
Dialogue: 0,0:07:18.02,0:07:20.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:20.52,0:07:23.15,Default,,0,0,0,,- (Ичикава) Шоколадты тоқаш сатып алдың ба? - (Ямада) Иә.
Dialogue: 0,0:07:24.56,0:07:27.82,Default,,0,0,0,,Бірінші курстың қызы саған көп шоколад берді, солай ма?
Dialogue: 0,0:07:27.90,0:07:30.40,Default,,0,0,0,,Жарайды, шоколадтың шексіз мөлшері бар.
Dialogue: 0,0:07:31.03,0:07:32.95,Default,,0,0,0,,Бір қарағанда тануға болатын шоколад
Dialogue: 0,0:07:33.03,0:07:33.95,Default,,0,0,0,,- (Ямада) Шұбат - (Ичикава) Иә?
Dialogue: 0,0:07:34.03,0:07:35.66,Default,,0,0,0,,- (Ямада) Жоқ! -(Ичикава) Түсірілді.
Dialogue: 0,0:07:38.91,0:07:41.25,Default,,0,0,0,,- (Ямада) Ичикава шоколад... - (Ичикава) Иә?
Dialogue: 0,0:07:41.33,0:07:42.46,Default,,0,0,0,,А, жоқ...
Dialogue: 0,0:07:43.83,0:07:47.84,Default,,0,0,0,,Ичикава, сен қандай шоколадты жақсы көресің?
Dialogue: 0,0:07:48.38,0:07:51.76,Default,,0,0,0,,Бұл қиын, хмм...
Dialogue: 0,0:07:53.76,0:07:56.51,Default,,0,0,0,,Маған дұрыс айтпасаңыз, мен түсінбеуім мүмкін.
Dialogue: 0,0:07:57.01,0:07:57.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:59.22,0:08:00.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:01.27,0:08:03.10,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:08:09.23,0:08:12.40,Default,,0,0,0,,Аа, егер ол жүрек тәрізді болса, кейбіреулер қате түсінуі мүмкін.
Dialogue: 0,0:08:12.49,0:08:13.74,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:14.32,0:08:15.03,Default,,0,0,0,,О
Dialogue: 0,0:08:17.12,0:08:18.99,Default,,0,0,0,,Адачи осылай деді
Dialogue: 0,0:08:19.08,0:08:20.58,Default,,0,0,0,,- (Ямада) Ичикава - (Ичикава) Иә?
Dialogue: 0,0:08:20.66,0:08:21.29,Default,,0,0,0,,Не!
Dialogue: 0,0:08:23.62,0:08:24.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:25.33,0:08:28.00,Default,,0,0,0,,- (Ямада) Мен саған беремін - (Ичикава) Сәлем.
Dialogue: 0,0:08:32.88,0:08:33.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:42.35,0:08:43.64,Default,,0,0,0,,Ол қосулы
Dialogue: 0,0:08:57.28,0:08:58.49,Default,,0,0,0,,Қош бол
Dialogue: 0,0:09:00.53,0:09:01.74,Default,,0,0,0,,Хаа…
Dialogue: 0,0:09:02.62,0:09:07.21,Default,,0,0,0,,Мен мұны сәл ғана күттім, жүрегімнің бір жерінде.
Dialogue: 0,0:09:07.79,0:09:10.54,Default,,0,0,0,,Маған дұрыс айтпасаңыз, мен түсінбеуім мүмкін.
Dialogue: 0,0:09:33.57,0:09:34.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:35.78,0:09:36.99,Default,,0,0,0,,(Жедел жүзген қайықтың дыбысы)
Dialogue: 0,0:09:40.28,0:09:42.16,Default,,0,0,0,,... болды ма?
Dialogue: 0,0:09:42.24,0:09:43.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:43.91,0:09:45.96,Default,,0,0,0,,Жарайды, бар күшіңді сал
Dialogue: 0,0:09:46.62,0:09:48.08,Default,,0,0,0,,- (Ичикава) Ум - (Ямада) Иә?
Dialogue: 0,0:09:48.17,0:09:49.29,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:09:51.25,0:09:53.25,Default,,0,0,0,,Ямада: Сіз мұны сыныпта айттыңыз.
Dialogue: 0,0:09:53.92,0:09:56.26,Default,,0,0,0,,Бүгін ұл бала
Dialogue: 0,0:09:58.51,0:09:59.68,Default,,0,0,0,,Мен бүгін ұлмын
Dialogue: 0,0:09:59.76,0:10:01.01,Default,,0,0,0,,...
Dialogue: 0,0:10:01.10,0:10:02.51,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:03.56,0:10:05.47,Default,,0,0,0,,-(Ичикава) Джа -(Ямада) Ах, Ичи...
Dialogue: 0,0:10:21.70,0:10:24.87,Default,,0,0,0,,Жақсы! Жарайды, жарайды, бұл дегеніміз, солай ма?
Dialogue: 0,0:10:24.95,0:10:27.66,Default,,0,0,0,,Бұл дұрыс, солай ма? Өйткені бұл Ямада.
Dialogue: 0,0:10:28.66,0:10:31.67,Default,,0,0,0,,Ахх...
Dialogue: 0,0:10:31.75,0:10:35.09,Default,,0,0,0,,Мүлдем жиіркенішті! Melty Kiss дегеніміз не?
Dialogue: 0,0:10:35.17,0:10:37.09,Default,,0,0,0,,Еріген сүйіспеншілік?
Dialogue: 0,0:10:37.17,0:10:38.17,Default,,0,0,0,,А…?
Dialogue: 0,0:10:41.51,0:10:43.26,Default,,0,0,0,,Көру қорқынышты
Dialogue: 0,0:10:43.76,0:10:44.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:44.68,0:10:47.85,Default,,0,0,0,,(Ичикаваның жүгірген қадамы)
Dialogue: 0,0:10:53.94,0:10:55.61,Default,,0,0,0,,14 ақпан
Dialogue: 0,0:10:56.11,0:10:57.82,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:10:58.32,0:11:00.24,Default,,0,0,0,,19:26
Dialogue: 0,0:11:05.03,0:11:07.62,Default,,0,0,0,,Вантароның жаяу жүру курсы
Dialogue: 0,0:11:07.70,0:11:09.41,Default,,0,0,0,,Мен оны өзгертуге тырысамын.
Dialogue: 0,0:11:09.50,0:11:10.66,Default,,0,0,0,,- (Ичикава) Йо - (Вантаро) Бір!
Dialogue: 0,0:11:10.75,0:11:14.09,Default,,0,0,0,,Ах, эй, Ичикава, сен сондай жақынсың.
Dialogue: 0,0:11:15.00,0:11:16.09,Default,,0,0,0,,Кішкене сөйлесейік.
Dialogue: 0,0:11:16.17,0:11:17.17,Default,,0,0,0,,Ха ха
Dialogue: 0,0:11:20.26,0:11:21.72,Default,,0,0,0,,Сіз оны алғыңыз келе ме?
Dialogue: 0,0:11:21.80,0:11:23.18,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:11:23.26,0:11:24.18,Default,,0,0,0,,Бір!
Dialogue: 0,0:11:24.26,0:11:25.55,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:26.64,0:11:27.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:28.27,0:11:29.68,Default,,0,0,0,,Оны дұрыс ұстаңыз
Dialogue: 0,0:11:31.98,0:11:33.02,Default,,0,0,0,,Осыған ұқсас нәрсе
Dialogue: 0,0:11:33.10,0:11:34.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:37.27,0:11:40.19,Default,,0,0,0,,Жарайды, құмар ойнаймыз.
Dialogue: 0,0:11:40.70,0:11:41.40,Default,,0,0,0,,(тиын салу дыбысы)
Dialogue: 0,0:11:41.49,0:11:43.82,Default,,0,0,0,,Қалаған какаомен
Dialogue: 0,0:11:43.91,0:11:46.33,Default,,0,0,0,,Сізге ең аз қажет қара кофе
Dialogue: 0,0:11:46.41,0:11:49.33,Default,,0,0,0,,Толқудан ләззат алу үшін бір уақытта басыңыз
Dialogue: 0,0:11:49.41,0:11:51.00,Default,,0,0,0,,Бұл құмар ойыны ма?
Dialogue: 0,0:11:51.08,0:11:51.83,Default,,0,0,0,,Эй!
Dialogue: 0,0:11:52.87,0:11:54.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:54.67,0:12:00.42,Default,,0,0,0,,Ахх! Ал ше!
Dialogue: 0,0:12:03.09,0:12:04.64,Default,,0,0,0,,Оған көмектесу мүмкін емес, сондықтан мен оны сізге беремін.
Dialogue: 0,0:12:04.72,0:12:05.89,Default,,0,0,0,,Иә...
Dialogue: 0,0:12:05.97,0:12:07.01,Default,,0,0,0,,«Кіруді бақылау жүйесіндегі автоматты есіктер—»
Dialogue: 0,0:12:11.10,0:12:14.02,Default,,0,0,0,,Құмырсқаны жайына қалдырайық.
Dialogue: 0,0:12:14.10,0:12:16.77,Default,,0,0,0,,Ол «болғандай» сияқты сөздерді айтты.
Dialogue: 0,0:12:16.86,0:12:18.44,Default,,0,0,0,,Ах, кейінірек.
Dialogue: 0,0:12:18.52,0:12:21.11,Default,,0,0,0,,Е-е, эй...
Dialogue: 0,0:12:21.19,0:12:24.78,Default,,0,0,0,,Бүгін Ямада, біртүрлі... әйтеуір.
Dialogue: 0,0:12:24.86,0:12:25.70,Default,,0,0,0,,Е...
Dialogue: 0,0:12:27.62,0:12:29.74,Default,,0,0,0,,- (Ямада) Бұл әрқашан біртүрлі - (Ичикава) Түсінемін.
Dialogue: 0,0:12:29.83,0:12:31.54,Default,,0,0,0,,«Мен көремін».
Dialogue: 0,0:12:31.62,0:12:33.16,Default,,0,0,0,,Әлде өзім айтуым керек пе?
Dialogue: 0,0:12:33.25,0:12:35.25,Default,,0,0,0,,Чии маған үнемі солай айтады
Dialogue: 0,0:12:35.33,0:12:37.88,Default,,0,0,0,,Чии жоқ еді, мен өзім айттым.
Dialogue: 0,0:12:37.96,0:12:38.96,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:12:39.59,0:12:42.13,Default,,0,0,0,,- (Ямада) Суық емес пе? -(Ичикава) Жарайды.
Dialogue: 0,0:12:42.21,0:12:44.05,Default,,0,0,0,,А, бүгінгі шоколад үшін рахмет.
Dialogue: 0,0:12:44.13,0:12:45.47,Default,,0,0,0,,(Шинсоның дем алған дыбысы)
Dialogue: 0,0:12:45.55,0:12:48.55,Default,,0,0,0,,-(Ямада) Биыл күн жылы. -(Ичикава) Ах~
Dialogue: 0,0:12:48.64,0:12:52.06,Default,,0,0,0,,- (Ямада) Енді қар жаумайды деп ойлаймын - (Ичикава) Сағат нешеде?
Dialogue: 0,0:12:53.23,0:12:55.06,Default,,0,0,0,,Ичи…
Dialogue: 0,0:12:55.14,0:12:56.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:57.77,0:13:00.32,Default,,0,0,0,,Бүгін Ичикава шоколад алды ма?
Dialogue: 0,0:13:00.40,0:13:02.23,Default,,0,0,0,,Отбасы мүшелерінен басқа
Dialogue: 0,0:13:02.32,0:13:02.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:02.90,0:13:04.20,Default,,0,0,0,,Иә
Dialogue: 0,0:13:04.28,0:13:05.32,Default,,0,0,0,,... ереже болып табылады
Dialogue: 0,0:13:05.99,0:13:07.16,Default,,0,0,0,,Бірақ қалай…
Dialogue: 0,0:13:07.74,0:13:08.87,Default,,0,0,0,,(Роко) Һм? (Масато) Хехехе
Dialogue: 0,0:13:11.41,0:13:12.54,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:13:13.50,0:13:14.87,Default,,0,0,0,,Хмм.
Dialogue: 0,0:13:16.12,0:13:20.17,Default,,0,0,0,,Яма... Ямада саған шоколад берді ме?
Dialogue: 0,0:13:21.25,0:13:23.92,Default,,0,0,0,,Бұл сұрақ қауіпсіз бе?
Dialogue: 0,0:13:25.05,0:13:25.93,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:13:26.43,0:13:29.47,Default,,0,0,0,,Себебі мен сізге міндетті шоколад бермеймін деп шештім.
Dialogue: 0,0:13:29.97,0:13:31.76,Default,,0,0,0,,Тек сол жерде тұрып ұйықтап жат.
Dialogue: 0,0:13:31.85,0:13:32.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:32.97,0:13:35.94,Default,,0,0,0,,Жеңімпаз барлық фигураларды алады.
Dialogue: 0,0:13:36.02,0:13:37.10,Default,,0,0,0,,(Роко) Һм? (Масато) Хехехе
Dialogue: 0,0:13:37.19,0:13:39.56,Default,,0,0,0,,Жақсы... жақсы
Dialogue: 0,0:13:39.65,0:13:41.69,Default,,0,0,0,,Міндетті шоколадты жою жақсы дейді.
Dialogue: 0,0:13:41.77,0:13:43.53,Default,,0,0,0,,Адачидің пікірімен келісемін.
Dialogue: 0,0:13:43.61,0:13:46.53,Default,,0,0,0,,Түсінбеген бақытсыз адам ғана туады.
Dialogue: 0,0:13:46.61,0:13:48.28,Default,,0,0,0,,- (Ямада) Ащы? -(Ичикава) қалжың
Dialogue: 0,0:13:49.28,0:13:52.16,Default,,0,0,0,,Мен тәттілерді ұнатпаймын дегенім өтірік болды.
Dialogue: 0,0:13:54.91,0:13:55.75,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:14:08.84,0:14:13.22,Default,,0,0,0,,Тәтті... Тым тәтті етіп жасадым.
Dialogue: 0,0:14:14.68,0:14:16.06,Default,,0,0,0,,«Су»?
Dialogue: 0,0:14:16.14,0:14:17.77,Default,,0,0,0,,- (Ямада) Моги - (Ичикава) А?
Dialogue: 0,0:14:27.65,0:14:28.86,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:30.24,0:14:31.78,Default,,0,0,0,,- (Ямада) Жарайды - (Ичикава) Иә?
Dialogue: 0,0:14:35.04,0:14:38.79,Default,,0,0,0,,Егер сіз қате түсінсеңіз жақсы.
Dialogue: 0,0:14:42.17,0:14:43.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:45.92,0:14:47.63,Default,,0,0,0,,Куун…
Dialogue: 0,0:14:48.22,0:14:49.34,Default,,0,0,0,,Ямада...
Dialogue: 0,0:14:51.47,0:14:54.64,Default,,0,0,0,,Кун Кун
Dialogue: 0,0:14:55.14,0:14:55.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:56.64,0:14:58.23,Default,,0,0,0,,- (Ямада) Уау - (Ичикава) Иә?
Dialogue: 0,0:14:58.31,0:15:00.02,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:00.64,0:15:04.23,Default,,0,0,0,,Менің қолымнан келмейді... Барлығы
Dialogue: 0,0:15:04.32,0:15:05.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:08.65,0:15:09.36,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:09.45,0:15:11.36,Default,,0,0,0,,Дәмді Дәмді кәдімгі!
Dialogue: 0,0:15:11.86,0:15:15.58,Default,,0,0,0,,А, жоқ, бұл қалыпты емес, бұл өте...
Dialogue: 0,0:15:17.91,0:15:21.75,Default,,0,0,0,,Содан кейін әрекетті қайталаңыз
Dialogue: 0,0:15:22.37,0:15:23.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:43.10,0:15:44.56,Default,,0,0,0,,Ямада бұл
Dialogue: 0,0:15:48.15,0:15:49.57,Default,,0,0,0,,Ямада
Dialogue: 0,0:15:57.41,0:15:58.66,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:01.12,0:16:02.79,Default,,0,0,0,,Мен
Dialogue: 0,0:16:14.84,0:16:15.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:18.22,0:16:19.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:21.64,0:16:26.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:26.11,0:16:28.19,Default,,0,0,0,,Не болды, сен сондай қиын көрінесің бе?
Dialogue: 0,0:16:28.27,0:16:30.57,Default,,0,0,0,,Ақ күннің орнына не істеуім керек?
Dialogue: 0,0:16:30.65,0:16:32.19,Default,,0,0,0,,Бір ай ғана болды.
Dialogue: 0,0:16:32.28,0:16:33.74,Default,,0,0,0,,- (Ичикава) Жоқ, - (3 адам) А?
Dialogue: 0,0:16:33.82,0:16:36.66,Default,,0,0,0,,Бір ай ғана қалды деуге болады.
Dialogue: 0,0:16:36.74,0:16:37.95,Default,,0,0,0,,Хмм…
Dialogue: 0,0:16:38.53,0:16:42.04,Default,,0,0,0,,Иә, мен Ямададан шоколад алдым.
Dialogue: 0,0:16:42.12,0:16:43.87,Default,,0,0,0,,Мен оны алдым.
Dialogue: 0,0:16:44.62,0:16:46.67,Default,,0,0,0,,Бір айдан кейін Ақ күн
Dialogue: 0,0:16:46.75,0:16:48.88,Default,,0,0,0,,Мен сізге жақсы төлей аламын ба?
Dialogue: 0,0:16:48.96,0:16:52.42,Default,,0,0,0,,Бұл айда қалай өмір сүретініңіз маңызды.
Dialogue: 0,0:16:52.92,0:16:56.14,Default,,0,0,0,,Менің қолымдағы жалғыз нәрсе Секиненің таратып жатқаны болды.
Dialogue: 0,0:16:56.22,0:16:58.22,Default,,0,0,0,,Жаңғақтар жүрек тәрізді болды
Dialogue: 0,0:16:58.30,0:17:00.47,Default,,0,0,0,,Қараңызшы, сіз оны қыз деп айта аласыз, солай ма?
Dialogue: 0,0:17:00.56,0:17:02.98,Default,,0,0,0,,Оны анық айтпа, Мо Чан.
Dialogue: 0,0:17:03.56,0:17:05.69,Default,,0,0,0,,Міндет, сүйікті...
Dialogue: 0,0:17:06.44,0:17:08.73,Default,,0,0,0,,Мен мұны сіздің қиялыңызға қалдырамын.
Dialogue: 0,0:17:08.81,0:17:09.57,Default,,0,0,0,,Зұлым әйел
Dialogue: 0,0:17:09.65,0:17:10.69,Default,,0,0,0,,Күтілгендей!
Dialogue: 0,0:17:10.77,0:17:13.53,Default,,0,0,0,,Мен құлаққапты алғым келеді.
Dialogue: 0,0:17:13.61,0:17:15.70,Default,,0,0,0,,Өйткені, «жақсы» «сезімді»
Dialogue: 0,0:17:15.78,0:17:19.99,Default,,0,0,0,,Мен біреуге «Мені ұста» және «Екінші болуға қарсы емеспін» дейтін сыйлық бергім келеді.
Dialogue: 0,0:17:20.08,0:17:21.58,Default,,0,0,0,,Өсуге деген ұмтылыс
Dialogue: 0,0:17:21.66,0:17:24.04,Default,,0,0,0,,Бұл тентек іш киім бе?
Dialogue: 0,0:17:24.12,0:17:25.58,Default,,0,0,0,,«Яппа» дегеніміз не?
Dialogue: 0,0:17:25.66,0:17:27.50,Default,,0,0,0,,Себебі мен қолдан жасалған шоколадтар алдым.
Dialogue: 0,0:17:27.58,0:17:29.67,Default,,0,0,0,,Ха! Қолдан жасалған іш киім?
Dialogue: 0,0:17:29.75,0:17:31.38,Default,,0,0,0,,Сіз әлеуметтік жағынан өлесіз.
Dialogue: 0,0:17:31.46,0:17:34.92,Default,,0,0,0,,Мен сені жеуге болатын тәттілермен сыйлаймын деп ойлаймын.
Dialogue: 0,0:17:35.01,0:17:37.09,Default,,0,0,0,,Аа, бұл жақсы, сіз жей аласыз
Dialogue: 0,0:17:37.18,0:17:37.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:38.64,0:17:41.39,Default,,0,0,0,,Шақыру қиын
Dialogue: 0,0:17:43.68,0:17:46.27,Default,,0,0,0,,Эй, шоколад алдың ба?
Dialogue: 0,0:17:46.35,0:17:46.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:47.64,0:17:50.44,Default,,0,0,0,,Ал, иә, жақсы...
Dialogue: 0,0:17:50.52,0:17:52.90,Default,,0,0,0,,Өтірік айтудан пайда жоқ
Dialogue: 0,0:17:53.61,0:17:55.74,Default,,0,0,0,,Демек, мұнда Бағана болған екен ғой?
Dialogue: 0,0:17:55.82,0:17:57.99,Default,,0,0,0,,Хмм, сен бәрібір ұсқынсызсың.
Dialogue: 0,0:17:58.07,0:17:59.99,Default,,0,0,0,,- (Ямада) Хмм - (Секине) Хехе
Dialogue: 0,0:18:00.07,0:18:01.37,Default,,0,0,0,,Допты айналдыр!
Dialogue: 0,0:18:02.49,0:18:03.91,Default,,0,0,0,,Жекпе-жек!
Dialogue: 0,0:18:08.08,0:18:09.63,Default,,0,0,0,,Һмпф
Dialogue: 0,0:18:09.71,0:18:13.00,Default,,0,0,0,,Өзіңе ұнамайтын адамға бір нәрсе беру дұрыс емес пе?
Dialogue: 0,0:18:13.09,0:18:16.26,Default,,0,0,0,,Маған ұнайтын адамдар ұнайды.
Dialogue: 0,0:18:16.34,0:18:18.80,Default,,0,0,0,,Жалаулар неғұрлым көп болса, соғұрлым жақсы.
Dialogue: 0,0:18:18.88,0:18:20.26,Default,,0,0,0,,Бірде-біреуі тұрмайды.
Dialogue: 0,0:18:20.34,0:18:25.10,Default,,0,0,0,,Ойланып қарасаңыз, мен Секине туралы ештеңе білмеймін.
Dialogue: 0,0:18:25.18,0:18:28.52,Default,,0,0,0,,Бұл қорқынышты, өйткені мен білмеймін, мен оны кездейсоқ жасай алмаймын.
Dialogue: 0,0:18:28.60,0:18:29.98,Default,,0,0,0,,Сіз байыптысыз.
Dialogue: 0,0:18:30.06,0:18:32.06,Default,,0,0,0,,Сізді қайда апарып жатыр?
Dialogue: 0,0:18:32.15,0:18:32.77,Default,,0,0,0,,Ах
Dialogue: 0,0:18:33.57,0:18:34.27,Default,,0,0,0,,«Қажет болса», – дейді Джосуке. «Жарайды».
Dialogue: 0,0:18:36.07,0:18:36.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:36.74,0:18:39.86,Default,,0,0,0,,Нанжо Пайсен, менімен бірге комитетке кел.
Dialogue: 0,0:18:39.95,0:18:41.91,Default,,0,0,0,,Не? Бір нәрсе жоғалып барады
Dialogue: 0,0:18:41.99,0:18:45.74,Default,,0,0,0,,Пейсен өте танымал, сондықтан кеңес алайық.
Dialogue: 0,0:18:45.83,0:18:47.62,Default,,0,0,0,,Ал Хиёриге не болды?!
Dialogue: 0,0:18:47.70,0:18:49.25,Default,,0,0,0,,Мен танымал емеспін.
Dialogue: 0,0:18:49.33,0:18:51.00,Default,,0,0,0,,Тағы да~
Dialogue: 0,0:18:51.08,0:18:52.33,Default,,0,0,0,,Дәл осылай...
Dialogue: 0,0:18:52.42,0:18:55.30,Default,,0,0,0,,Бұл салқын атмосфера екенін айта аласыз ба?
Dialogue: 0,0:18:55.38,0:18:57.92,Default,,0,0,0,,Бұл атмосфера ма? Мүмкін сіз оқи аласыз
Dialogue: 0,0:18:58.01,0:18:59.51,Default,,0,0,0,,Мен оны оқымадым.
Dialogue: 0,0:18:59.59,0:19:00.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:02.30,0:19:04.10,Default,,0,0,0,,Ннн…
Dialogue: 0,0:19:04.18,0:19:07.31,Default,,0,0,0,,Бұл жігіт Валентин күніне шоколад алған сияқты.
Dialogue: 0,0:19:07.39,0:19:08.98,Default,,0,0,0,,Оның орнына нені қалайсыз?
Dialogue: 0,0:19:10.14,0:19:13.23,Default,,0,0,0,,Әй, мен түсіндім.
Dialogue: 0,0:19:14.44,0:19:17.73,Default,,0,0,0,,Бірақ мен басқа адамның қалауын білмеймін.
Dialogue: 0,0:19:17.82,0:19:20.61,Default,,0,0,0,,Таңдау жасамас бұрын білген дұрыс емес пе?
Dialogue: 0,0:19:20.70,0:19:22.91,Default,,0,0,0,,Жоқ, мұның мағынасы жоқ.
Dialogue: 0,0:19:22.99,0:19:26.49,Default,,0,0,0,,Ерлер мен әйелдер бір-бірін ешқашан түсінбейді.
Dialogue: 0,0:19:26.58,0:19:28.37,Default,,0,0,0,,О, әрине
Dialogue: 0,0:19:28.45,0:19:29.66,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:19:31.50,0:19:33.42,Default,,0,0,0,,Мүлде басқа жаратылыс...
Dialogue: 0,0:19:34.59,0:19:38.55,Default,,0,0,0,,Біздің ортамыз, хоббиіміз және ойлау тәсілдеріміз әртүрлі, бірақ біз бір-бірімізді білген сайын,
Dialogue: 0,0:19:38.63,0:19:41.93,Default,,0,0,0,,Мен жанашырлық сезінемін, өйткені бір жерде ұқсастық бар ...
Dialogue: 0,0:19:42.63,0:19:46.64,Default,,0,0,0,,Дәлірек айтқанда, бұл сізге түсінуге көмектеседі.
Dialogue: 0,0:19:49.02,0:19:52.69,Default,,0,0,0,,Не...Қызық, сізге сыйлық ретінде не келеді?
Dialogue: 0,0:19:52.77,0:19:54.52,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:19:54.61,0:19:57.57,Default,,0,0,0,,Іш киім ше?
Dialogue: 0,0:19:57.65,0:20:00.07,Default,,0,0,0,,Аа, дұрыс айтасыз!
Dialogue: 0,0:20:00.15,0:20:02.61,Default,,0,0,0,,Сізге ұнайтынына сенімдімін.
Dialogue: 0,0:20:02.70,0:20:04.57,Default,,0,0,0,,Эй, Ичихара-кун
Dialogue: 0,0:20:04.66,0:20:06.45,Default,,0,0,0,,Бұл ебедейсіз тұзақ.
Dialogue: 0,0:20:07.33,0:20:11.12,Default,,0,0,0,,Менің ойымша, Пейзеннің әңгімесі тағылымды.
Dialogue: 0,0:20:11.21,0:20:12.54,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:20:13.08,0:20:17.13,Default,,0,0,0,,Мен үшін Адачи маған көбірек білуге ​​және түсінуге көмектесетін нәрселерді айтады.
Dialogue: 0,0:20:17.21,0:20:20.84,Default,,0,0,0,,Бах... Мен саған ғашық боламын деп ойламаймын.
Dialogue: 0,0:20:20.92,0:20:22.76,Default,,0,0,0,,Аа, мен үйірме жұмыстарына баруым керек.
Dialogue: 0,0:20:25.05,0:20:26.64,Default,,0,0,0,,Мен үйге бара жатырмын
Dialogue: 0,0:20:28.85,0:20:29.64,Default,,0,0,0,,Ах
Dialogue: 0,0:20:29.72,0:20:33.77,Default,,0,0,0,,Сәлем! Эй!
Dialogue: 0,0:20:33.85,0:20:35.85,Default,,0,0,0,,Ой... тоқта...
Dialogue: 0,0:20:47.95,0:20:49.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:01.96,0:21:06.51,Default,,0,0,0,,О, мен Ямадамын...
Dialogue: 0,0:21:06.59,0:21:07.89,Default,,0,0,0,,Күте тұрыңыз, күтіңіз
Dialogue: 0,0:21:10.81,0:21:11.93,Default,,0,0,0,,Су…
Dialogue: 0,0:21:18.23,0:21:19.94,Default,,0,0,0,,Қош бол
Dialogue: 0,0:21:34.00,0:21:36.00,Default,,0,0,0,,♪～
Dialogue: 0,0:23:01.54,0:23:03.54,Default,,0,0,0,,～♪
