Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.35,0:00:03.82,Default,,0,0,0,,Сіз көлікті қалай жүргізесіз?
Dialogue: 0,0:00:03.82,0:00:08.66,Default,,0,0,0,,А, сен... мынаны Гарон планетасына апар.
Dialogue: 0,0:00:08.66,0:00:11.16,Default,,0,0,0,,1 ай бұрын кенет жолдан шығып кетті
Dialogue: 0,0:00:11.16,0:00:14.93,Default,,0,0,0,,Біз тура Күн жүйесінің орталығына бет алдық.
Dialogue: 0,0:00:14.93,0:00:17.53,Default,,0,0,0,,Келетінімді хабарлауым керек еді.
Dialogue: 0,0:02:08.04,0:02:10.94,Default,,0,0,0,,Сіз кімсіз? Бұл жігіттер
Dialogue: 0,0:02:21.29,0:02:23.22,Default,,0,0,0,,Күте тұрыңыз, а?
Dialogue: 0,0:02:23.22,0:02:25.22,Default,,0,0,0,,Ах
Dialogue: 0,0:02:27.89,0:02:31.30,Default,,0,0,0,,Олар күдікті емес
Dialogue: 0,0:02:31.30,0:02:34.23,Default,,0,0,0,,Маған қирандыларды қазуға көмектесу
Dialogue: 0,0:02:34.23,0:02:36.77,Default,,0,0,0,,Ол Марстағы үңгір адамы.
Dialogue: 0,0:02:36.77,0:02:38.77,Default,,0,0,0,,Профессор Тополо
Dialogue: 0,0:02:41.21,0:02:44.51,Default,,0,0,0,,Рождество мерекесімен Профессор
Dialogue: 0,0:02:55.22,0:02:59.86,Default,,0,0,0,,Бірақ, балалар, неге олай дулыға киесіздер?
Dialogue: 0,0:02:59.86,0:03:03.73,Default,,0,0,0,,Бұл үңгірлердің көздері күн сәулесіне сезімтал.
Dialogue: 0,0:03:03.73,0:03:08.13,Default,,0,0,0,,Әйтсе де, қараңғыда қарапайым адамға ұқсайсың.
Dialogue: 0,0:03:11.77,0:03:18.25,Default,,0,0,0,,Менің ойымша, сіз осындай қирандыларды қазу үшін тамаша серіктес екенсіз.
Dialogue: 0,0:03:18.25,0:03:20.78,Default,,0,0,0,,Бірақ профессор, не?
Dialogue: 0,0:03:20.78,0:03:25.09,Default,,0,0,0,,Бұл Гарон планетасы жасанды жұлдыз екені рас па?
Dialogue: 0,0:03:25.09,0:03:29.72,Default,,0,0,0,,Бұл рас, бірақ біз осы планетаның ежелгі тарихынан шешкеніміз бойынша.
Dialogue: 0,0:03:29.72,0:03:33.59,Default,,0,0,0,,Қазір адамсыз кометаның ғаламды кезетін уақыты.
Dialogue: 0,0:03:33.59,0:03:39.37,Default,,0,0,0,,Бұл ежелгі гарондар басқарған үлкен ғарыш кемесі болса керек.
Dialogue: 0,0:03:39.37,0:03:41.90,Default,,0,0,0,,Ғарыш кемесі? О
Dialogue: 0,0:03:41.90,0:03:46.71,Default,,0,0,0,,Жарқыраған өркениет құрған ежелгі гарон халқы
Dialogue: 0,0:03:46.71,0:03:51.28,Default,,0,0,0,,Олардың құдайы болған.
Dialogue: 0,0:03:51.28,0:03:55.88,Default,,0,0,0,,Мәңгілік өмірмен өлмейтін Шеба ханшайымы
Dialogue: 0,0:03:55.88,0:03:58.52,Default,,0,0,0,,Ол бұл планетада еркін қозғалады
Dialogue: 0,0:03:58.52,0:04:04.76,Default,,0,0,0,,Ол мыңдаған жылдар бойы ғаламды шарлады.
Dialogue: 0,0:04:04.76,0:04:09.60,Default,,0,0,0,,Бұл шексіз саяхат болды.
Dialogue: 0,0:04:09.60,0:04:14.77,Default,,0,0,0,,Шива патшайым ғаламның бір жерінде нағыз алтын жер бар деп санайды.
Dialogue: 0,0:04:14.77,0:04:18.07,Default,,0,0,0,,Мен іздегенім осы еді
Dialogue: 0,0:04:18.07,0:04:22.98,Default,,0,0,0,,Алайда бұл табиғи апат па, індет пе, олар Алтын жерді таба алмады.
Dialogue: 0,0:04:22.98,0:04:27.68,Default,,0,0,0,,Саяхат кезінде ежелгі гарон халқы қырылды.
Dialogue: 0,0:04:27.68,0:04:32.82,Default,,0,0,0,,Ал Шива патшайымның қайтыс болуымен Гарон планетасы да өз қозғалысын тоқтатты.
Dialogue: 0,0:04:32.82,0:04:35.72,Default,,0,0,0,,Күнді эллипстік орбита бойынша айналады
Dialogue: 0,0:04:35.72,0:04:39.26,Default,,0,0,0,,Ол құйрықты жұлдызға айналды.
Dialogue: 0,0:04:39.26,0:04:41.26,Default,,0,0,0,,Гарон жұлдызы да сондықтан
Dialogue: 0,0:04:41.26,0:04:45.07,Default,,0,0,0,,Сіз дәл қазір траекторияңызды кенеттен өзгерттіңіз бе?
Dialogue: 0,0:04:45.07,0:04:51.30,Default,,0,0,0,,Біреу осы Гарон планетасының ішіндегі итергіштерді іске қосты.
Dialogue: 0,0:04:51.30,0:04:54.21,Default,,0,0,0,,Біреу итергішті жылжытты ма?
Dialogue: 0,0:04:54.21,0:04:59.85,Default,,0,0,0,,Бірақ патшайым Шеба бұл планетаны жылжыта алатын жалғыз адам болды.
Dialogue: 0,0:04:59.85,0:05:04.95,Default,,0,0,0,,Енді ол кетті, бұл планетаны кім басқарады?
Dialogue: 0,0:05:18.00,0:05:20.90,Default,,0,0,0,,Мен қазған қирандылар осы жерде.
Dialogue: 0,0:05:20.90,0:05:24.64,Default,,0,0,0,,Бұл ежелгі гарон халқының ханшайымы Шеба сарайының қирандылары.
Dialogue: 0,0:05:24.64,0:05:27.64,Default,,0,0,0,,Іші қараңғы, сондықтан абай болыңыз.
Dialogue: 0,0:05:38.65,0:05:40.99,Default,,0,0,0,,Сіз қалай ойлайсыз? бір сигара
Dialogue: 0,0:05:40.99,0:05:42.92,Default,,0,0,0,,Нағыз түрік орамдары.
Dialogue: 0,0:05:42.92,0:05:44.92,Default,,0,0,0,,Мынау
Dialogue: 0,0:05:47.16,0:05:51.56,Default,,0,0,0,,Кешіріңіз, кешіріңіз. Қараңғы болды.
Dialogue: 0,0:05:51.56,0:05:53.76,Default,,0,0,0,,Жоқ, маңызды емес.
Dialogue: 0,0:06:06.98,0:06:08.98,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:06:14.32,0:06:16.26,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:16.26,0:06:20.19,Default,,0,0,0,,Бұл адам жүзді балық. Бұл ежелгі балықтың бір түрі.
Dialogue: 0,0:06:20.19,0:06:24.63,Default,,0,0,0,,Осы сарайдың тұрғыны оны үй жануары ретінде ұстаса керек.
Dialogue: 0,0:06:24.63,0:06:27.13,Default,,0,0,0,,Бұл сарайдың еденінің астында жер асты су жолы бар.
Dialogue: 0,0:06:27.13,0:06:29.87,Default,,0,0,0,,Олар әлі де көптеп өмір сүреді.
Dialogue: 0,0:06:29.87,0:06:33.07,Default,,0,0,0,,Олар қатыгез, сондықтан сақ болыңыз.
Dialogue: 0,0:06:33.07,0:06:39.27,Default,,0,0,0,,Рас, бұл үй жануары. Оның сүйкімділігі сонша, мен оны құшақтағым келеді.
Dialogue: 0,0:07:04.10,0:07:07.24,Default,,0,0,0,,Бұл не? Бұл алтын есік
Dialogue: 0,0:07:07.24,0:07:09.18,Default,,0,0,0,,Есік?
Dialogue: 0,0:07:09.18,0:07:13.18,Default,,0,0,0,,Бұл сарайдың иесі - Гарон планетасының патшайымы Шеба.
Dialogue: 0,0:07:13.18,0:07:15.95,Default,,0,0,0,,Осы алтын есік арқылы
Dialogue: 0,0:07:15.95,0:07:21.42,Default,,0,0,0,,Ол жер астында итергіштің қуат бөлмесіне кіріп-шығады.
Dialogue: 0,0:07:21.42,0:07:24.92,Default,,0,0,0,,Ал, алтын есікті аша алсаң...
Dialogue: 0,0:07:24.92,0:07:30.30,Default,,0,0,0,,Иә, қозғалтқышты өшіріп, күнмен соқтығысудан аулақ бола аласыз.
Dialogue: 0,0:07:30.30,0:07:34.17,Default,,0,0,0,,Әлемде бұл есікті аша алатын бір ғана есік бар.
Dialogue: 0,0:07:34.17,0:07:36.44,Default,,0,0,0,,Тек Шебаның кілті
Dialogue: 0,0:07:36.44,0:07:41.21,Default,,0,0,0,,Ежелгі тарихтан мен кілттің Венерада екенін білдім.
Dialogue: 0,0:07:41.21,0:07:45.08,Default,,0,0,0,,Енді маған Шиваның құпия кілтін беріңіз.
Dialogue: 0,0:07:45.08,0:07:48.72,Default,,0,0,0,,Иә, профессор Кобра, Шиваның кілті.
Dialogue: 0,0:07:48.72,0:07:54.02,Default,,0,0,0,,А, менің қалтамда екені анық.
Dialogue: 0,0:07:54.02,0:07:56.32,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:07:56.32,0:07:58.26,Default,,0,0,0,,Кобра!
Dialogue: 0,0:07:58.26,0:08:01.59,Default,,0,0,0,,Не... Не болып жатыр?
Dialogue: 0,0:08:01.59,0:08:07.40,Default,,0,0,0,,Бұл жерде енді күн сәулесі жоқ, сол дулығаны неге шешпейсің?
Dialogue: 0,0:08:07.40,0:08:10.27,Default,,0,0,0,,Кобра, сен нені айтып тұрсың?
Dialogue: 0,0:08:10.27,0:08:14.07,Default,,0,0,0,,Олар қорқынышты адамдар, түнде жақсы көретін үңгір адамдары.
Dialogue: 0,0:08:14.07,0:08:18.37,Default,,0,0,0,,Ол қолын бос темекі қапшығына салды, мен оған создым.
Dialogue: 0,0:08:26.22,0:08:28.62,Default,,0,0,0,,Олар қарақшылар гильдиясы.
Dialogue: 0,0:08:36.86,0:08:38.86,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:08:40.77,0:08:44.60,Default,,0,0,0,,Нағыз профессор да, үңгір адамы да сол табытта.
Dialogue: 0,0:08:44.60,0:08:46.57,Default,,0,0,0,,Қымбаттым... ол қайда?
Dialogue: 0,0:08:46.57,0:08:48.57,Default,,0,0,0,,Бұл осында.
Dialogue: 0,0:09:06.76,0:09:10.26,Default,,0,0,0,,Гильдия меннен озып кеткен сияқты.
Dialogue: 0,0:09:12.43,0:09:15.53,Default,,0,0,0,,Бұл нағыз профессор Тополо.
Dialogue: 0,0:09:26.95,0:09:29.45,Default,,0,0,0,,Уа, эй...
Dialogue: 0,0:09:44.43,0:09:48.64,Default,,0,0,0,,Ах, Шебаның кілті.
Dialogue: 0,0:09:48.64,0:09:52.54,Default,,0,0,0,,Конняроме, мен бұл қауырсынды аршып, якитори жасаймын.
Dialogue: 0,0:09:58.88,0:10:02.75,Default,,0,0,0,,Ах Зорос
Dialogue: 0,0:10:02.75,0:10:06.35,Default,,0,0,0,,Кобра Кобра Кобра!
Dialogue: 0,0:10:18.53,0:10:20.53,Default,,0,0,0,,Blackbone
Dialogue: 0,0:10:24.70,0:10:26.70,Default,,0,0,0,,Ах
Dialogue: 0,0:10:31.84,0:10:34.85,Default,,0,0,0,,Шива кілті хаха...
Dialogue: 0,0:10:34.85,0:10:39.59,Default,,0,0,0,,Енді алтын есікті ешкім аша алмайды.
Dialogue: 0,0:10:39.59,0:10:42.12,Default,,0,0,0,,Мақсатымыз – Шебаның кілті.
Dialogue: 0,0:10:42.12,0:10:44.99,Default,,0,0,0,,Оны бұл дүниеден өшіру керек еді.
Dialogue: 0,0:10:44.99,0:10:48.90,Default,,0,0,0,,Не? Енді мен алтын есіктен өте аламын
Dialogue: 0,0:10:48.90,0:10:54.27,Default,,0,0,0,,Бұл планетада жер астында орналасқан итергіштерді тоқтату мүмкін емес болып қалды.
Dialogue: 0,0:10:54.27,0:10:59.11,Default,,0,0,0,,Гарон жұлдызы бір аптадан кейін күнге соғады.
Dialogue: 0,0:10:59.11,0:11:04.58,Default,,0,0,0,,Ал Күн жүйесі бұл ғаламнан жойылады.
Dialogue: 0,0:11:04.58,0:11:07.18,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:11:11.65,0:11:13.65,Default,,0,0,0,,Бұл...
Dialogue: 0,0:11:30.87,0:11:34.87,Default,,0,0,0,,Ей, құбыжық, сен әлі тірісің бе?
Dialogue: 0,0:12:03.77,0:12:05.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:10.01,0:12:11.94,Default,,0,0,0,,Сіз Титантардың бір-бірімен шайқасып жатқанын айтасыз ба?
Dialogue: 0,0:12:11.94,0:12:14.85,Default,,0,0,0,,Мен үшін жұмыс істемейді
Dialogue: 0,0:12:14.85,0:12:17.82,Default,,0,0,0,,Менің денемді жабатын арнайы таңғыш бар.
Dialogue: 0,0:12:17.82,0:12:21.05,Default,,0,0,0,,Ол барлық энергияны жұтады.
Dialogue: 0,0:12:21.05,0:12:23.12,Default,,0,0,0,,Жақсы
Dialogue: 0,0:12:23.12,0:12:27.39,Default,,0,0,0,,Біз сөйлесе аламыз ба? қой қуыршақ
Dialogue: 0,0:12:27.39,0:12:29.70,Default,,0,0,0,,Дие Кобра
Dialogue: 0,0:12:29.70,0:12:32.90,Default,,0,0,0,,Қой сияқты отыра алмайсың, шыдамайсың.
Dialogue: 0,0:12:52.02,0:12:55.42,Default,,0,0,0,,Қатты қой, бірақ дәмді ме?
Dialogue: 0,0:13:09.90,0:13:13.10,Default,,0,0,0,,Ол жер асты су жолдары арқылы біршама шайылып кеткен.
Dialogue: 0,0:13:15.07,0:13:19.57,Default,,0,0,0,,Қазба тобы өзінің зерттеу базасына оралған сияқты.
Dialogue: 0,0:13:26.45,0:13:32.33,Default,,0,0,0,,Бірақ бұл қараңғыда мен қайда жүремін...
Dialogue: 0,0:13:32.33,0:13:34.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:41.73,0:13:46.53,Default,,0,0,0,,Мен таң қалдым, Қой-чан, әлі тірі сияқты.
Dialogue: 0,0:14:06.23,0:14:08.23,Default,,0,0,0,,Бұл бітсе, бірдеңе жейміз бе? Егер қаласаң, көңіліңді көтерейін.
Dialogue: 0,0:14:11.06,0:14:15.06,Default,,0,0,0,,Мына қараңғыда қалай дәл маған дәл көздеуге болады?
Dialogue: 0,0:14:20.41,0:14:23.91,Default,,0,0,0,,Қарғыс атсын, ол мені көре алатын сияқты.
Dialogue: 0,0:14:45.20,0:14:48.80,Default,,0,0,0,,Хехехе... Мен сенің қашып кетуіңе жол бермеймін.
Dialogue: 0,0:14:56.94,0:15:00.81,Default,,0,0,0,,Көрдім, оның көздері инфрақызыл датчиктер?
Dialogue: 0,0:15:00.81,0:15:04.31,Default,,0,0,0,,Ол менің денемнен тараған жылуды көреді.
Dialogue: 0,0:15:16.83,0:15:19.13,Default,,0,0,0,,Сіз сонда жүгірдіңіз бе?
Dialogue: 0,0:15:27.34,0:15:32.01,Default,,0,0,0,,Хахаха... душ бөлмесінің ішінде ме?
Dialogue: 0,0:15:32.01,0:15:34.55,Default,,0,0,0,,Бұл сенің табытың.
Dialogue: 0,0:15:34.55,0:15:36.55,Default,,0,0,0,,Бұл кішкентай вакуумдық торнадоның соңғы әсері!
Dialogue: 0,0:15:43.26,0:15:46.86,Default,,0,0,0,,Соңында орындадым
Dialogue: 0,0:15:46.86,0:15:49.16,Default,,0,0,0,,Иә? Ол жоқ
Dialogue: 0,0:15:56.14,0:15:58.14,Default,,0,0,0,,Міне, мен болар едім
Dialogue: 0,0:16:08.71,0:16:13.25,Default,,0,0,0,,Таңғышты жеп қойды, ол өлімге әкелді.
Dialogue: 0,0:16:13.25,0:16:18.46,Default,,0,0,0,,Неге, неге мен сені көре алмадым?
Dialogue: 0,0:16:18.46,0:16:22.33,Default,,0,0,0,,Душ тек ыстық суды қабылдау ғана емес.
Dialogue: 0,0:16:22.33,0:16:24.30,Default,,0,0,0,,Мен суға шомылдым
Dialogue: 0,0:16:24.30,0:16:28.63,Default,,0,0,0,,Ал мен дене температурасын бөлме температурасына дейін түсірдім.
Dialogue: 0,0:16:28.63,0:16:30.57,Default,,0,0,0,,Айттым ғой! Апаттар – нағыз азап.
Dialogue: 0,0:16:30.57,0:16:33.31,Default,,0,0,0,,Мұндағы ауа мен мен арасындағы температура айырмашылығы жоқ.
Dialogue: 0,0:16:33.31,0:16:35.98,Default,,0,0,0,,Көздерің ажырата алмады.
Dialogue: 0,0:16:35.98,0:16:38.98,Default,,0,0,0,,Рахмет... hection
Dialogue: 0,0:16:41.38,0:16:43.38,Default,,0,0,0,,Мен суық тиіп қалдым.
Dialogue: 0,0:16:58.73,0:17:01.57,Default,,0,0,0,,Сіздің сонда екеніңіздің құпиясы
Dialogue: 0,0:17:01.57,0:17:06.74,Default,,0,0,0,,Осы жұлдыз күнмен соқтығысқан уақытты шыдамдылықпен күтіңіз.
Dialogue: 0,0:17:06.74,0:17:10.98,Default,,0,0,0,,Алайда бұған дейін тоғанда аш адам кейпіндегі балықтар болған.
Dialogue: 0,0:17:10.98,0:17:13.98,Default,,0,0,0,,Мен сені жалғыз қалдырмас едім.
Dialogue: 0,0:17:17.52,0:17:21.52,Default,,0,0,0,,Хохохо... Қош бол құпия
Dialogue: 0,0:17:52.49,0:17:55.86,Default,,0,0,0,,Не... неге уайымдамайсың?
Dialogue: 0,0:17:55.86,0:18:00.46,Default,,0,0,0,,Сен менің досымсың, сондықтан сөйлесе аласың.
Dialogue: 0,0:18:00.46,0:18:05.30,Default,,0,0,0,,Аа, профессор Тополо мен Су перісі тайпасы доспыз.
Dialogue: 0,0:18:05.30,0:18:07.23,Default,,0,0,0,,Ол осы сарайды қазды
Dialogue: 0,0:18:07.23,0:18:10.67,Default,,0,0,0,,Ол бізді құрып кетуден құтқарды.
Dialogue: 0,0:18:10.67,0:18:12.61,Default,,0,0,0,,Профессор? бірақ
Dialogue: 0,0:18:12.61,0:18:17.34,Default,,0,0,0,,Оны қарақшылар гильдиясы өлтірді.
Dialogue: 0,0:18:17.34,0:18:23.18,Default,,0,0,0,,Өкінішке орай, суда ештеңе істей алмадық.
Dialogue: 0,0:18:23.18,0:18:25.99,Default,,0,0,0,,Бірақ өлмес бұрын профессор
Dialogue: 0,0:18:25.99,0:18:30.82,Default,,0,0,0,,Маған алтын есікті қалай ашу керектігін үйретті
Dialogue: 0,0:18:30.82,0:18:35.69,Default,,0,0,0,,Иә, бірақ қазір бітті.
Dialogue: 0,0:18:35.69,0:18:39.29,Default,,0,0,0,,Шива кілті енді қолданылмайды.
Dialogue: 0,0:18:42.27,0:18:45.91,Default,,0,0,0,,Бұл, әрине, ең нашар.
Dialogue: 0,0:18:45.91,0:18:48.64,Default,,0,0,0,,Кобра Йо
Dialogue: 0,0:18:48.64,0:18:52.14,Default,,0,0,0,,Хахаха... Анау кілт жалған.
Dialogue: 0,0:18:55.25,0:19:00.09,Default,,0,0,0,,Бұл гильдияны Шиваның шынайы кілтінен алшақтату үшін жасалған айла.
Dialogue: 0,0:19:00.09,0:19:03.29,Default,,0,0,0,,Сонымен, нақты кілт қайда?
Dialogue: 0,0:19:03.29,0:19:08.13,Default,,0,0,0,,Нағыз кілт – сен, құпия
Dialogue: 0,0:19:08.13,0:19:13.37,Default,,0,0,0,,Бұл ғаламның алтын есігін тек сен ғана аша аласың.
Dialogue: 0,0:19:13.37,0:19:16.37,Default,,0,0,0,,Бір ғана адам бар
Dialogue: 0,0:19:16.37,0:19:23.17,Default,,0,0,0,,Шеба патшайым бұрынғы дүниедегі ең сұлу әйел болған.
Dialogue: 0,0:19:57.88,0:20:00.68,Default,,0,0,0,,Мынау... ол мына есікте.
Dialogue: 0,0:20:00.68,0:20:05.05,Default,,0,0,0,,Мен өзім сияқты пропорциялармен кілт тесігін жасадым.
Dialogue: 0,0:20:05.05,0:20:07.42,Default,,0,0,0,,Құдай бұл дүниеде нені жаратуы мүмкін еді
Dialogue: 0,0:20:07.42,0:20:12.73,Default,,0,0,0,,Ең мінсіз және ең әдемі пропорциялар
Dialogue: 0,0:20:12.73,0:20:18.13,Default,,0,0,0,,Алтын пропорциялы әйел есікті ашатын кілт.
Dialogue: 0,0:20:18.13,0:20:20.13,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:22.97,0:20:27.67,Default,,0,0,0,,Профессор сізді осы планетаға басынан бастап шақырды...
Dialogue: 0,0:20:38.75,0:20:41.35,Default,,0,0,0,,Кобра Мен жасап көремін.
Dialogue: 0,0:20:55.13,0:20:57.13,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:23:13.11,0:23:15.84,Default,,0,0,0,,Алтын есік ашылғанша жақсы болды.
Dialogue: 0,0:23:15.84,0:23:20.15,Default,,0,0,0,,Мен шұңқырға құлап, басымды қатты соқтым.
Dialogue: 0,0:23:20.15,0:23:23.18,Default,,0,0,0,,Ол есте сақтау қабілетін жоғалтқан сияқты.
Dialogue: 0,0:23:23.18,0:23:26.92,Default,,0,0,0,,Содан кейін мені тәртіпсіз ұлдар қоршап алды.
Dialogue: 0,0:23:26.92,0:23:30.29,Default,,0,0,0,,Ол көшедегі төбелестерге қатысады, өте бос емес.
Dialogue: 0,0:23:30.29,0:23:33.69,Default,,0,0,0,,Жадымды қалай қалпына келтіруге болады?
Dialogue: 0,0:23:33.69,0:23:38.79,Default,,0,0,0,,Келесі КОБРА «Жұлдызсыз қала» анимациясы Құрметпен
Dialogue: 0,0:23:40.29,0:23:46.29,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory