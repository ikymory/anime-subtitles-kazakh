Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:20.10,0:00:23.97,Default,,0,0,0,,Эй, мен айдап келемін.
Dialogue: 0,0:00:23.97,0:00:27.67,Default,,0,0,0,,Ол үмітсіз жігіт.
Dialogue: 0,0:00:27.67,0:00:30.57,Default,,0,0,0,,Иә? сурет?
Dialogue: 0,0:00:30.57,0:00:34.14,Default,,0,0,0,,Бұл не!
Dialogue: 0,0:00:34.14,0:00:37.61,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:37.61,0:00:40.41,Default,,0,0,0,,Уф... Кя!
Dialogue: 0,0:02:39.54,0:02:42.04,Default,,0,0,0,,Басталуға 5 минут қалғанда Әрбір спортшы
Dialogue: 0,0:02:42.04,0:02:44.54,Default,,0,0,0,,Тұрақты торды орындаңыз
Dialogue: 0,0:02:54.32,0:02:57.85,Default,,0,0,0,,Сол әдемі аяқтарыңа
Dialogue: 0,0:02:57.85,0:03:00.16,Default,,0,0,0,,Мен жеңсем ше?
Dialogue: 0,0:03:00.16,0:03:03.93,Default,,0,0,0,,Bikos қонақүйінде бірге шампан ашу...
Dialogue: 0,0:03:03.93,0:03:06.33,Default,,0,0,0,,Бұл үлкен сенімділік.
Dialogue: 0,0:03:08.36,0:03:11.60,Default,,0,0,0,,Жарайды, бірақ есіңізде болсын.
Dialogue: 0,0:03:11.60,0:03:14.17,Default,,0,0,0,,Мен әлі жеңілген жоқпын.
Dialogue: 0,0:03:14.17,0:03:17.21,Default,,0,0,0,,Ей, мен ол жерде болмағандықтан болды.
Dialogue: 0,0:03:17.21,0:03:19.81,Default,,0,0,0,,Ал, бүгін кешкі сағат 8-де кездесейік.
Dialogue: 0,0:03:33.09,0:03:37.09,Default,,0,0,0,,Барлық ойыншылар ойынды таза бастады.
Dialogue: 0,0:03:39.50,0:03:42.13,Default,,0,0,0,,Жылдамдық пен төзімділік шегін сынау
Dialogue: 0,0:03:42.13,0:03:45.73,Default,,0,0,0,,Әлемдегі ең үлкен метеор жарысы басталады
Dialogue: 0,0:03:48.61,0:03:50.61,Default,,0,0,0,,Биіктігі 30 000
Dialogue: 0,0:03:54.04,0:03:56.04,Default,,0,0,0,,Биіктігі 20 000
Dialogue: 0,0:04:05.09,0:04:09.46,Default,,0,0,0,,Биіктігі 10 000 Әрбір спортшы өз машиналарын құрастыра бастады.
Dialogue: 0,0:04:09.46,0:04:12.20,Default,,0,0,0,,Бұған дейінгі әлем чемпионы Памела Ли
Dialogue: 0,0:04:12.20,0:04:14.50,Default,,0,0,0,,Күтілгендей, олар жылдам қимылдарды көрсетеді.
Dialogue: 0,0:04:37.35,0:04:41.75,Default,,0,0,0,,А, Памела Ли, №7, ұшаққа бірінші кірді.
Dialogue: 0,0:04:49.93,0:04:51.93,Default,,0,0,0,,Биіктігі 3000
Dialogue: 0,0:05:02.48,0:05:05.78,Default,,0,0,0,,Бұл қорқынышты. Қуат сөніп қалды. Иә?
Dialogue: 0,0:05:05.78,0:05:09.68,Default,,0,0,0,,Әрбір ойыншы үшін қозғалтқышты реттеу ғана қалады.
Dialogue: 0,0:05:13.09,0:05:15.09,Default,,0,0,0,,Биіктігі 1000
Dialogue: 0,0:05:18.43,0:05:21.13,Default,,0,0,0,,Памела кері инъекцияны бастады
Dialogue: 0,0:05:21.13,0:05:25.00,Default,,0,0,0,,№ 9 Ирхтин және № 21 Ұзын оттық.
Dialogue: 0,0:05:25.00,0:05:27.30,Default,,0,0,0,,Дроссель ашылмайды!
Dialogue: 0,0:05:29.34,0:05:31.34,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:05:34.18,0:05:36.11,Default,,0,0,0,,Ой, бұл оқыс оқиға.
Dialogue: 0,0:05:36.11,0:05:40.38,Default,,0,0,0,,No8 Жиген артқа бұрыла алмай, жерге құлады.
Dialogue: 0,0:05:40.38,0:05:43.02,Default,,0,0,0,,Идиот, оны жеткізудің қажеті жоқ.
Dialogue: 0,0:05:43.02,0:05:45.59,Default,,0,0,0,,Қуат өшірілді. Міне бітті.
Dialogue: 0,0:05:45.59,0:05:47.82,Default,,0,0,0,,№7 Памела Ли жетекші
Dialogue: 0,0:05:47.82,0:05:50.49,Default,,0,0,0,,Біз соңғы курсқа кірдік.
Dialogue: 0,0:05:50.49,0:05:54.79,Default,,0,0,0,,Памеланы №0 жаңа Кобра тез ұстап алады.
Dialogue: 0,0:05:57.80,0:06:01.10,Default,,0,0,0,,О, Кобра, мен Памеланың қасында болдым.
Dialogue: 0,0:06:01.10,0:06:03.30,Default,,0,0,0,,Қатты шабуыл мен қорғанысты көрсету
Dialogue: 0,0:06:10.48,0:06:12.88,Default,,0,0,0,,Енді аяқтау уақыты келді.
Dialogue: 0,0:06:28.80,0:06:30.73,Default,,0,0,0,,Мақсат!
Dialogue: 0,0:06:30.73,0:06:33.14,Default,,0,0,0,,Мына қатты дауысты тыңдаңыз.
Dialogue: 0,0:06:33.14,0:06:36.47,Default,,0,0,0,,«Кобра» мақсатқа дейін кері ағынды жасайды деп айтылады.
Dialogue: 0,0:06:36.47,0:06:40.34,Default,,0,0,0,,Жоғары техника көрсетіп, біріншілікте жеңіске жету
Dialogue: 0,0:06:40.34,0:06:42.65,Default,,0,0,0,,Әлем чемпионы Памела Ли
Dialogue: 0,0:06:42.65,0:06:47.48,Default,,0,0,0,,Өкінішке орай, мен Кобраның батыл техникасынан жеңілдім.
Dialogue: 0,0:06:47.48,0:06:49.92,Default,,0,0,0,,Уа, не болып жатыр?
Dialogue: 0,0:06:49.92,0:06:52.52,Default,,0,0,0,,Кобраның машинасы бағытынан шығып кетті
Dialogue: 0,0:06:52.52,0:06:55.22,Default,,0,0,0,,Күзетшіні жеңді!
Dialogue: 0,0:06:55.22,0:06:58.02,Default,,0,0,0,,А, мен жер асты өткеліне кірдім!
Dialogue: 0,0:07:04.77,0:07:06.74,Default,,0,0,0,,Бұл үлкен мәселеге айналды.
Dialogue: 0,0:07:06.74,0:07:12.41,Default,,0,0,0,,Бірінші келген «Кобра» машинасы жерасты өткелінде өртеніп жатыр.
Dialogue: 0,0:07:12.41,0:07:16.61,Default,,0,0,0,,Мен мәре сызығын кесіп өткенде менің қалпымда бірдеңе болды ма?
Dialogue: 0,0:07:56.79,0:07:58.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:00.66,0:08:04.56,Default,,0,0,0,,Шампан жалғыз ішуге арналмаған.
Dialogue: 0,0:08:07.96,0:08:12.54,Default,,0,0,0,,Өлгендердің қайта тірілуіне таң қалмайтын сияқтысың.
Dialogue: 0,0:08:12.54,0:08:15.27,Default,,0,0,0,,Мен басқалардың көзін алдаған шығармын, бірақ
Dialogue: 0,0:08:15.27,0:08:17.37,Default,,0,0,0,,Мен сені алдай алмаймын
Dialogue: 0,0:08:19.44,0:08:23.75,Default,,0,0,0,,Бұл апат әдейі болды.
Dialogue: 0,0:08:23.75,0:08:28.62,Default,,0,0,0,,Бүгінгі жарыс кезінде түскен ақша жарыс өтетін жерден ұрланған сияқты.
Dialogue: 0,0:08:28.62,0:08:32.05,Default,,0,0,0,,Бұл жерде қорқынышты адамдар бар.
Dialogue: 0,0:08:32.05,0:08:34.59,Default,,0,0,0,,Сіз билейсіз бе?
Dialogue: 0,0:08:34.59,0:08:36.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:43.40,0:08:47.17,Default,,0,0,0,,Мен қылмыскердің мұны қалай істегенін білмеймін, бірақ
Dialogue: 0,0:08:47.17,0:08:52.98,Default,,0,0,0,,Өткізілетін орынның қуаты өшірілді, яғни қауіпсіздік құрылғылары іске қосылмаған.
Dialogue: 0,0:08:52.98,0:08:57.55,Default,,0,0,0,,Содан кейін қылмыскер қоймаға жерасты өткелімен кірді.
Dialogue: 0,0:08:57.55,0:09:01.25,Default,,0,0,0,,Дұрыс, мен 4 миллион доллар таптым.
Dialogue: 0,0:09:01.25,0:09:03.72,Default,,0,0,0,,Бұл қорқынышты ұсыныс.
Dialogue: 0,0:09:03.72,0:09:07.59,Default,,0,0,0,,Ол 3,5 миллион доллар алды.
Dialogue: 0,0:09:07.59,0:09:11.89,Default,,0,0,0,,Сіз қандай адамсыз.
Dialogue: 0,0:09:25.04,0:09:27.61,Default,,0,0,0,,Мен сіздей адамды кездестірмедім
Dialogue: 0,0:09:27.61,0:09:31.61,Default,,0,0,0,,Сіз мұны тоқтата аласыз.
Dialogue: 0,0:09:38.96,0:09:42.43,Default,,0,0,0,,Кобра Қара оқты тоқтатыңыз
Dialogue: 0,0:09:42.43,0:09:47.03,Default,,0,0,0,,Өтінемін, нені тоқтатыңыз?
Dialogue: 0,0:09:47.03,0:09:50.03,Default,,0,0,0,,А... а...
Dialogue: 0,0:09:52.44,0:09:54.54,Default,,0,0,0,,Не болды, Памела?
Dialogue: 0,0:09:56.61,0:09:58.61,Default,,0,0,0,,Памела!
Dialogue: 0,0:10:10.59,0:10:14.26,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:10:14.26,0:10:18.16,Default,,0,0,0,,Мен... Құлақ!
Dialogue: 0,0:10:20.06,0:10:22.36,Default,,0,0,0,,Памела... Ах.
Dialogue: 0,0:10:52.50,0:10:54.90,Default,,0,0,0,,Әй... Мен ішке кірейін.
Dialogue: 0,0:11:16.62,0:11:20.36,Default,,0,0,0,,Кім ау... полиция көлігін жарып жібердің.
Dialogue: 0,0:11:20.36,0:11:23.89,Default,,0,0,0,,Біз оны тоқтатпасақ, одан да көп адам өлетін еді.
Dialogue: 0,0:11:23.89,0:11:26.90,Default,,0,0,0,,Бірақ бұл не туралы?
Dialogue: 0,0:11:26.90,0:11:30.70,Default,,0,0,0,,Бұл полиция көлігі қара оқтың жұмысы.
Dialogue: 0,0:11:30.70,0:11:33.50,Default,,0,0,0,,Қара оқ?
Dialogue: 0,0:11:33.50,0:11:38.21,Default,,0,0,0,,Оның орнына маған қол ұшын беріңіз, сіз онша мұқият емессіз.
Dialogue: 0,0:11:38.21,0:11:40.64,Default,,0,0,0,,Мынау...
Dialogue: 0,0:11:40.64,0:11:42.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:42.58,0:11:45.31,Default,,0,0,0,,Мен сені қамауға аламын, қарақшы Кобра.
Dialogue: 0,0:11:45.31,0:11:48.08,Default,,0,0,0,,Психо мылтықты көрсету жаман ой болды.
Dialogue: 0,0:11:48.08,0:11:52.18,Default,,0,0,0,,Менің бойымды көрсетпейтін жаман әдетім бар.
Dialogue: 0,0:11:54.62,0:11:59.06,Default,,0,0,0,,100-ден астам көлікті қара оқ басып қалды.
Dialogue: 0,0:11:59.06,0:12:02.47,Default,,0,0,0,,Және 200-ден астам адам қайтыс болды.
Dialogue: 0,0:12:02.47,0:12:04.93,Default,,0,0,0,,Ондай адамды неге жалғыз қалдыру керек?
Dialogue: 0,0:12:04.93,0:12:08.20,Default,,0,0,0,,Өйткені, ол 600 км/сағ жылдамдықпен жүреді.
Dialogue: 0,0:12:08.20,0:12:10.91,Default,,0,0,0,,Полиция көлігі қуып жете алмайды.
Dialogue: 0,0:12:10.91,0:12:16.55,Default,,0,0,0,,Ал елді мекенде болғаннан кейін әуеден барлау мүмкін емес.
Dialogue: 0,0:12:16.55,0:12:19.12,Default,,0,0,0,,Оның үстіне оның қорқынышты күшті денесі бар.
Dialogue: 0,0:12:19.12,0:12:22.95,Default,,0,0,0,,Тіпті 62 мм пулемет те жеткіліксіз болды
Dialogue: 0,0:12:22.95,0:12:25.02,Default,,0,0,0,,Күшті лазерлік мылтық қалай болды?
Dialogue: 0,0:12:25.02,0:12:27.16,Default,,0,0,0,,Бұл да жақсы емес.
Dialogue: 0,0:12:27.16,0:12:30.56,Default,,0,0,0,,Оның денесінде шағылыстыратын құрылғы бар сияқты.
Dialogue: 0,0:12:30.56,0:12:34.26,Default,,0,0,0,,Қаланың қақ ортасында зымыран ату мүмкін емес деп ойлаймын.
Dialogue: 0,0:12:34.26,0:12:37.16,Default,,0,0,0,,Иә, бұл мүлдем бақылаудан шықты.
Dialogue: 0,0:12:39.54,0:12:43.41,Default,,0,0,0,,72 блокта қара оқтармен барлық полиция машиналарын қоршау.
Dialogue: 0,0:12:43.41,0:12:45.41,Default,,0,0,0,,Мені дереу оқиға орнына жеткізді.
Dialogue: 0,0:12:45.41,0:12:47.61,Default,,0,0,0,,Yahoo, сіз мұны жасадыңыз.
Dialogue: 0,0:12:53.08,0:12:56.42,Default,,0,0,0,,Қара оқ қазір тұрақ ғимаратының ішінде жасырынып жатыр.
Dialogue: 0,0:12:56.42,0:12:58.35,Default,,0,0,0,,Барлық шығулар қорғалған.
Dialogue: 0,0:12:58.35,0:13:01.96,Default,,0,0,0,,Қара оқтардың мәжбүрлі серпілісте қолдану қаупі бар екенін ескеріңіз.
Dialogue: 0,0:13:01.96,0:13:03.89,Default,,0,0,0,,Үлкен қырағылықты қажет етеді
Dialogue: 0,0:13:03.89,0:13:06.39,Default,,0,0,0,,Бұл жерде тыныш болу керек...
Dialogue: 0,0:13:18.41,0:13:20.81,Default,,0,0,0,,Қара оқ...
Dialogue: 0,0:13:20.81,0:13:24.41,Default,,0,0,0,,Бұл шайтанның ісі сияқты.
Dialogue: 0,0:13:38.93,0:13:41.86,Default,,0,0,0,,Егер тым қатты болса, мен мұны істемеймін.
Dialogue: 0,0:13:41.86,0:13:44.87,Default,,0,0,0,,Басқа адамдарға келтірген қолайсыздықтар туралы ойланыңыз.
Dialogue: 0,0:13:44.87,0:13:48.10,Default,,0,0,0,,Қария, сен мұндай жерде не істеп жүрсің?
Dialogue: 0,0:13:48.10,0:13:51.84,Default,,0,0,0,,Сіз көрмейсіз бе? Кешкі ас.
Dialogue: 0,0:13:51.84,0:13:55.51,Default,,0,0,0,,Кешіріңіз, қария, мен жаман сөз айтпаймын.
Dialogue: 0,0:13:55.51,0:13:58.41,Default,,0,0,0,,Кешкі асты ішуді доғар, далаға шық.
Dialogue: 0,0:14:26.21,0:14:30.11,Default,,0,0,0,,Қандай жігіт, қабырғаны бұзып, қашып кетті.
Dialogue: 0,0:14:32.48,0:14:36.32,Default,,0,0,0,,Бауырым, менің қолымнан келетін нәрсе бар ма?
Dialogue: 0,0:14:36.32,0:14:38.25,Default,,0,0,0,,Шынымды айтсам, кешіріңіз.
Dialogue: 0,0:14:38.25,0:14:41.55,Default,,0,0,0,,Ғимараттың құлап қалмауы үшін қолдау көрсете аласыз ба?
Dialogue: 0,0:14:45.36,0:14:49.10,Default,,0,0,0,,Сіз детектив емес сияқтысыз, бірақ мені неге қуып жүрсіз?
Dialogue: 0,0:14:49.10,0:14:51.37,Default,,0,0,0,,Қара оқ...
Dialogue: 0,0:14:51.37,0:14:54.40,Default,,0,0,0,,Жоқ, Памела.
Dialogue: 0,0:14:54.40,0:14:56.40,Default,,0,0,0,,Памела?
Dialogue: 0,0:15:03.28,0:15:06.98,Default,,0,0,0,,Хахаха... Кордон ба?
Dialogue: 0,0:15:06.98,0:15:09.25,Default,,0,0,0,,Олар ақымақ.
Dialogue: 0,0:15:09.25,0:15:11.52,Default,,0,0,0,,Қараңдар, міне!
Dialogue: 0,0:15:11.52,0:15:16.12,Default,,0,0,0,,Оның жарысы осында аяқталады. Бұл баррикаданы бұзу мүмкін емес.
Dialogue: 0,0:15:19.60,0:15:22.40,Default,,0,0,0,,Уа... дәл маған келе жатыр.
Dialogue: 0,0:15:26.80,0:15:29.47,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:15:29.47,0:15:32.21,Default,,0,0,0,,Сіз мені тоқтата алмайсыз
Dialogue: 0,0:15:32.21,0:15:34.74,Default,,0,0,0,,Мені ешкім тоқтата алмайды!
Dialogue: 0,0:15:34.74,0:15:38.54,Default,,0,0,0,,Ахаха ахахха...
Dialogue: 0,0:15:45.89,0:15:49.79,Default,,0,0,0,,Негізі қара оқты мен жасадым.
Dialogue: 0,0:15:49.79,0:15:51.79,Default,,0,0,0,,Не?
Dialogue: 0,0:15:51.79,0:15:54.60,Default,,0,0,0,,Түрім осылай болса да, мен инженермін.
Dialogue: 0,0:15:54.60,0:15:57.20,Default,,0,0,0,,Мен белгілі бір кәсіпорынның бас инженері болып жұмыс істеп жүрген кезім.
Dialogue: 0,0:15:57.20,0:15:59.80,Default,,0,0,0,,Мен Памеламен таныстым.
Dialogue: 0,0:15:59.80,0:16:02.44,Default,,0,0,0,,Памела үздік жүгіруші болды.
Dialogue: 0,0:16:02.44,0:16:05.34,Default,,0,0,0,,Әйелдердің жеделдетуге тән күші
Dialogue: 0,0:16:05.34,0:16:08.38,Default,,0,0,0,,Басқа жүгірушілерге жол бермеу
Dialogue: 0,0:16:08.38,0:16:10.55,Default,,0,0,0,,Қара оқ жердегі көлік ретінде
Dialogue: 0,0:16:10.55,0:16:15.38,Default,,0,0,0,,Ол әлемдегі ең жылдам жылдамдықты жазу үшін жасалған.
Dialogue: 0,0:16:15.38,0:16:21.79,Default,,0,0,0,,Ол жай ғана жүйрік емес, жақсы қыз еді.
Dialogue: 0,0:16:21.79,0:16:24.59,Default,,0,0,0,,Неліктен Памела...
Dialogue: 0,0:16:24.59,0:16:28.06,Default,,0,0,0,,Барлығы осыдан кейін болды.
Dialogue: 0,0:16:28.06,0:16:31.00,Default,,0,0,0,,Оның Линда есімді қарындасы бар.
Dialogue: 0,0:16:31.00,0:16:34.44,Default,,0,0,0,,Олар жақын апалы-сіңлі еді.
Dialogue: 0,0:16:34.44,0:16:39.81,Default,,0,0,0,,Линданы көлік қағып, былтыр қайтыс болды.
Dialogue: 0,0:16:39.81,0:16:44.31,Default,,0,0,0,,Иә, Линданың өлімі оны өзгертті.
Dialogue: 0,0:16:44.31,0:16:47.22,Default,,0,0,0,,Сол апаттан бері Памела жүгіретіннің бәрін жақсы көреді.
Dialogue: 0,0:16:47.22,0:16:50.92,Default,,0,0,0,,Менде әдеттен тыс жеккөрушілік пайда болды.
Dialogue: 0,0:16:50.92,0:16:54.26,Default,,0,0,0,,Ол ондай емес еді.
Dialogue: 0,0:16:54.26,0:16:56.89,Default,,0,0,0,,Бүгін де жарыс...
Dialogue: 0,0:16:56.89,0:17:01.63,Default,,0,0,0,,Памела толық дуальды тұлғаны қалыптастырды.
Dialogue: 0,0:17:01.63,0:17:06.30,Default,,0,0,0,,Кейде, ол күйзеліске ұшыраған кезде, өшпенділік оны өзгертеді.
Dialogue: 0,0:17:06.30,0:17:09.30,Default,,0,0,0,,Қорқынышты кісі өлтіруші бол
Dialogue: 0,0:17:12.54,0:17:15.44,Default,,0,0,0,,Кобра Қара оқты тоқтатыңыз
Dialogue: 0,0:17:15.44,0:17:18.34,Default,,0,0,0,,Өтінемін, тоқтаңыз.
Dialogue: 0,0:17:20.28,0:17:23.65,Default,,0,0,0,,Қара оқты тоқтату мүмкін емес пе?
Dialogue: 0,0:17:23.65,0:17:25.62,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:17:25.62,0:17:31.26,Default,,0,0,0,,Егер Памела люкті ашып, көліктен түспесе.
Dialogue: 0,0:17:31.26,0:17:34.46,Default,,0,0,0,,Люкті ашыңыз...
Dialogue: 0,0:17:34.46,0:17:39.37,Default,,0,0,0,,Бүгінгі күнге дейін қара оқтың қайда екені белгісіз.
Dialogue: 0,0:17:39.37,0:17:43.47,Default,,0,0,0,,Өткен түндегі мәлімет бойынша, қаза тапқандар саны 250-ге жетті.
Dialogue: 0,0:17:43.47,0:17:46.87,Default,,0,0,0,,Зардап шеккендер саны әлі де арта береді деп күтілуде...
Dialogue: 0,0:17:51.61,0:17:55.91,Default,,0,0,0,,Маған ұнамайды... Маған енді ұнамайды
Dialogue: 0,0:18:24.45,0:18:27.95,Default,,0,0,0,,Қара оқ қазір батысқа қарай аумақтан өтіп жатыр.
Dialogue: 0,0:18:34.46,0:18:37.23,Default,,0,0,0,,Мен оны жаптым. Мен 6-шы палатаға кірдім. Мен оны бұрышқа қойдым.
Dialogue: 0,0:18:37.23,0:18:39.23,Default,,0,0,0,,Енді құтылу мүмкін емес
Dialogue: 0,0:18:42.66,0:18:44.76,Default,,0,0,0,,А, мен төбеге шығамын.
Dialogue: 0,0:18:50.91,0:18:53.91,Default,,0,0,0,,Ах, міне олар! Садақ пен жебелер. Олар артқы қабырғаға ілініп тұр.
Dialogue: 0,0:18:58.51,0:19:03.45,Default,,0,0,0,,Өртен, күй!
Dialogue: 0,0:19:03.45,0:19:07.85,Default,,0,0,0,,Әркім жанып күл болсын
Dialogue: 0,0:19:12.06,0:19:16.67,Default,,0,0,0,,Кобра Орындалды. Бұл сіз сұраған нәрсе.
Dialogue: 0,0:19:16.67,0:19:20.27,Default,,0,0,0,,Кобра, сен мұны не істейсің?
Dialogue: 0,0:19:20.27,0:19:22.27,Default,,0,0,0,,Памела...
Dialogue: 0,0:19:27.51,0:19:31.85,Default,,0,0,0,,Ол менен көмек сұрады
Dialogue: 0,0:19:31.85,0:19:34.45,Default,,0,0,0,,Мені тоқтатыңызшы
Dialogue: 0,0:19:56.74,0:20:00.11,Default,,0,0,0,,Дұрыс айтасыз, менің аэровелосипедімнің шегі 500 км.
Dialogue: 0,0:20:00.11,0:20:03.41,Default,,0,0,0,,Өлі аймақ дәл бұрышта, бірақ қозғалтқыш, оны маған беріңіз.
Dialogue: 0,0:20:20.80,0:20:22.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:22.86,0:20:25.57,Default,,0,0,0,,Линда!
Dialogue: 0,0:20:25.57,0:20:27.57,Default,,0,0,0,,Бұл ақымақтық
Dialogue: 0,0:20:32.98,0:20:34.98,Default,,0,0,0,,Линда!
Dialogue: 0,0:20:40.72,0:20:42.72,Default,,0,0,0,,Жоғалып кетті…
Dialogue: 0,0:21:26.26,0:21:30.76,Default,,0,0,0,,Көкте жақсы жүгіріңіз, Памела
Dialogue: 0,0:23:13.97,0:23:17.47,Default,,0,0,0,,Мұндағы адамдардың Шива қамалын қайтарып алуын өтінетін хаты бар.
Dialogue: 0,0:23:17.47,0:23:21.48,Default,,0,0,0,,Алған соң жиналғандар осылар, мен де солардың бірімін.
Dialogue: 0,0:23:21.48,0:23:24.88,Default,,0,0,0,,Бұл планета хаос әскері Шива руын жойғаннан бері бар.
Dialogue: 0,0:23:24.88,0:23:27.42,Default,,0,0,0,,Мен әрқашан олардың бақылауында болдым.
Dialogue: 0,0:23:27.42,0:23:31.39,Default,,0,0,0,,Сонда да барлық жерде хаос күштері бар.
Dialogue: 0,0:23:31.39,0:23:34.72,Default,,0,0,0,,Сен маған мына жігіттермен тіл табысасың деп тұрсың ба?
Dialogue: 0,0:23:34.72,0:23:37.39,Default,,0,0,0,,Мен мүлдем құлықсызмын, бірақ...
Dialogue: 0,0:23:37.39,0:23:39.66,Default,,0,0,0,,Келесі КОБРА АНИМАЦИЯ
Dialogue: 0,0:23:39.66,0:23:42.36,Default,,0,0,0,,«Галактика рыцарлары» Құрметпен
Dialogue: 0,0:23:43.86,0:23:49.86,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory