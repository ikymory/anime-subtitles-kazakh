Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:27.00,0:00:29.94,Default,,0,0,0,,Бұл қайда? сенімен бір рет
Dialogue: 0,0:00:29.94,0:00:34.07,Default,,0,0,0,,Бұл мен неке ант беруді армандаған жерім.
Dialogue: 0,0:00:34.07,0:00:37.01,Default,,0,0,0,,Сіз? Біртүрлі ма?
Dialogue: 0,0:00:37.01,0:00:41.28,Default,,0,0,0,,Жоқ, мұндай кез болған.
Dialogue: 0,0:00:41.28,0:00:44.08,Default,,0,0,0,,Кез келген адам бақытты армандайтын кез болды.
Dialogue: 0,0:00:51.89,0:00:53.89,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:00:53.89,0:00:58.40,Default,,0,0,0,,Бар болғаны екі адамға үйлену тойын жасайық.
Dialogue: 0,0:00:58.40,0:01:00.40,Default,,0,0,0,,Үйлену тойы…
Dialogue: 0,0:01:06.17,0:01:08.17,Default,,0,0,0,,О
Dialogue: 0,0:01:26.19,0:01:28.83,Default,,0,0,0,,Бұл не? Бұл Раонның плащы
Dialogue: 0,0:01:28.83,0:01:31.03,Default,,0,0,0,,Ағам да маған батасын береді.
Dialogue: 0,0:01:34.60,0:01:36.84,Default,,0,0,0,,Бақытты уақытта
Dialogue: 0,0:01:36.84,0:01:39.14,Default,,0,0,0,,Барлығы осында келгеніне сенімдімін.
Dialogue: 0,0:01:47.15,0:01:51.65,Default,,0,0,0,,Қоңырауды кім соғады? Кен
Dialogue: 0,0:01:51.65,0:01:54.32,Default,,0,0,0,,Юлия Сіз көрмейсіз бе?
Dialogue: 0,0:01:54.32,0:01:56.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:17.61,0:02:19.61,Default,,0,0,0,,Барлығы
Dialogue: 0,0:02:29.59,0:02:33.56,Default,,0,0,0,,Жанымыз бірлікте болсын деп дұға етейік.
Dialogue: 0,0:02:33.56,0:02:35.86,Default,,0,0,0,,Мәңгілікке жету
Dialogue: 0,0:02:35.86,0:02:37.86,Default,,0,0,0,,Мәңгілікке жету
Dialogue: 0,0:02:50.38,0:02:52.38,Default,,0,0,0,,Бұл әдемі күннің батуы.
Dialogue: 0,0:02:52.38,0:02:55.58,Default,,0,0,0,,Бұл уақыт сенімен мәңгілік болса
Dialogue: 0,0:02:57.78,0:03:01.28,Default,,0,0,0,,Ехо, ехо... Юлия!
Dialogue: 0,0:03:03.59,0:03:06.96,Default,,0,0,0,,Кен Батып бара жатқан күн
Dialogue: 0,0:03:06.96,0:03:09.86,Default,,0,0,0,,Мені ешкім тоқтата алмайды
Dialogue: 0,0:03:09.86,0:03:13.77,Default,,0,0,0,,Олай болса әдемі етіп жіберейік.
Dialogue: 0,0:03:13.77,0:03:17.17,Default,,0,0,0,,...
Dialogue: 0,0:03:17.17,0:03:21.37,Default,,0,0,0,,Егер сіз өз ауруыңызбен күресе алсаңыз
Dialogue: 0,0:03:21.37,0:03:23.71,Default,,0,0,0,,Өмірімді қатерге тігсем де
Dialogue: 0,0:03:23.71,0:03:26.91,Default,,0,0,0,,Кен, мұңайма.
Dialogue: 0,0:03:31.25,0:03:34.15,Default,,0,0,0,,Толығырақ айтып бере аласыз ба?
Dialogue: 0,0:03:34.15,0:03:36.89,Default,,0,0,0,,Сіз жүріп өткен жол
Dialogue: 0,0:03:36.89,0:03:38.89,Default,,0,0,0,,Менің жолым...
Dialogue: 0,0:03:41.46,0:03:44.26,Default,,0,0,0,,Бұл мен үшін емес, иә?
Dialogue: 0,0:03:59.68,0:04:03.32,Default,,0,0,0,,және осы адаммен шайқасуға рұқсат етті—
Dialogue: 0,0:04:03.32,0:04:06.22,Default,,0,0,0,,Мен сіздің дауысыңызды ести алатыныма сенімдімін
Dialogue: 0,0:04:06.22,0:04:09.12,Default,,0,0,0,,Мен оны міндетті түрде беремін.
Dialogue: 0,0:04:09.12,0:04:12.99,Default,,0,0,0,,Құтқарушыңыз туралы аңыз
Dialogue: 0,0:04:12.99,0:04:15.59,Default,,0,0,0,,Ю... Юрия
Dialogue: 0,0:04:33.61,0:04:36.38,Default,,0,0,0,,Әңгімені міндетті түрде жеткізеді
Dialogue: 0,0:04:36.38,0:04:39.38,Default,,0,0,0,,Құтқарушыңыз туралы аңыз
Dialogue: 0,0:05:15.15,0:05:21.03,Default,,0,0,0,,Дүние жүзін қамтыған ядролық соғыс өркениетті жойды.
Dialogue: 0,0:05:21.03,0:05:24.33,Default,,0,0,0,,Дүниені зорлық пен тәртіпсіздік биледі.
Dialogue: 0,0:05:26.50,0:05:30.37,Default,,0,0,0,,Барлығы қайтадан қараңғылықтан қорқады
Dialogue: 0,0:05:30.37,0:05:33.37,Default,,0,0,0,,Ертеңгі күннен үміт үзілді
Dialogue: 0,0:05:43.78,0:05:46.52,Default,,0,0,0,,Ер адамның аты Кенширо
Dialogue: 0,0:05:46.52,0:05:52.32,Default,,0,0,0,,Бұл үмітсіз дүниенің кейін құтқарушыға айналатын жас жігіт
Dialogue: 0,0:05:52.32,0:05:56.12,Default,,0,0,0,,Енді мен шарасыздықтан айдалада кезіп жүр едім.
Dialogue: 0,0:06:34.63,0:06:36.73,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:48.21,0:06:51.78,Default,,0,0,0,,Кенширо - өлтіруші жұдырығы
Dialogue: 0,0:06:51.78,0:06:54.79,Default,,0,0,0,,Хокуто Шинкеннің мұрагері болды.
Dialogue: 0,0:06:54.79,0:06:58.56,Default,,0,0,0,,Бірақ ол әлі де зорлық-зомбылық шөлінде
Dialogue: 0,0:06:58.56,0:07:02.03,Default,,0,0,0,,Тағдырымды білмедім
Dialogue: 0,0:07:02.03,0:07:06.30,Default,,0,0,0,,Ал аспан күтуді жалғастырды
Dialogue: 0,0:07:06.30,0:07:09.10,Default,,0,0,0,,Кенширо оянғанда
Dialogue: 0,0:07:51.41,0:07:55.75,Default,,0,0,0,,Әке! Бұл... бұл жігіт
Dialogue: 0,0:07:55.75,0:07:57.98,Default,,0,0,0,,Сіз қасқырлармен соғысқан сияқтысыз.
Dialogue: 0,0:07:57.98,0:08:02.15,Default,,0,0,0,,Бұл керемет. Сіз 10 қасқырды өзіңіз жеңе аласыз.
Dialogue: 0,0:08:02.15,0:08:06.99,Default,,0,0,0,,Бірақ бұл кісі де осыншама күшке ие болса, өлді.
Dialogue: 0,0:08:06.99,0:08:09.49,Default,,0,0,0,,Қашып кетуді ойласам, не жақсы болар еді?
Dialogue: 0,0:08:09.49,0:08:12.29,Default,,0,0,0,,Жүр, біз де асығайық.
Dialogue: 0,0:08:14.33,0:08:18.90,Default,,0,0,0,,Амо, тезірек, иә, бірақ...
Dialogue: 0,0:08:18.90,0:08:22.10,Default,,0,0,0,,Ха! Бұл адам тірі!
Dialogue: 0,0:08:28.65,0:08:32.18,Default,,0,0,0,,Ол тірі Бұл адам тірі!
Dialogue: 0,0:08:32.18,0:08:35.99,Default,,0,0,0,,Не істеу керек? Сая, сен тірі болсаң көмектесейік.
Dialogue: 0,0:08:35.99,0:08:40.33,Default,,0,0,0,,Бірақ... оны жақын маңдағы қалаға апара алатын болсам...
Dialogue: 0,0:08:40.33,0:08:42.93,Default,,0,0,0,,Бізді тастасақ, адам болудан қаламыз.
Dialogue: 0,0:08:44.93,0:08:46.93,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:08:51.30,0:08:54.57,Default,,0,0,0,,Эй, аяғыңды мықтап ұста, Дэн Амо.
Dialogue: 0,0:08:54.57,0:08:57.58,Default,,0,0,0,,Сіз не істеп жатырсыз? Көбірек күш сал, Амо.
Dialogue: 0,0:08:57.58,0:08:59.68,Default,,0,0,0,,Мен істеп жатырмын!
Dialogue: 0,0:09:03.01,0:09:05.92,Default,,0,0,0,,Хмм, қатты ұстаңыз, Амо.
Dialogue: 0,0:09:05.92,0:09:07.92,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:07.92,0:09:10.12,Default,,0,0,0,,Эй!
Dialogue: 0,0:09:10.12,0:09:13.52,Default,,0,0,0,,Не? Уф!
Dialogue: 0,0:09:20.17,0:09:22.17,Default,,0,0,0,,Не? Сіз жігіттер!
Dialogue: 0,0:09:22.17,0:09:25.67,Default,,0,0,0,,Хихихихи...
Dialogue: 0,0:09:28.81,0:09:32.68,Default,,0,0,0,,Мен таптым...
Dialogue: 0,0:09:32.68,0:09:36.58,Default,,0,0,0,,Dehedehedehe Ихихихихихи…
Dialogue: 0,0:09:38.52,0:09:43.15,Default,,0,0,0,,Дехедехе Қайсысы? 2 ересек және 2 бала
Dialogue: 0,0:09:43.15,0:09:46.99,Default,,0,0,0,,Ал бұл не болды? Бір өліп бара жатқан бейбақ
Dialogue: 0,0:09:46.99,0:09:51.30,Default,,0,0,0,,Бұл төрт жарым дегенді білдіреді. Бұл үлкен егін.
Dialogue: 0,0:09:51.30,0:09:54.03,Default,,0,0,0,,Егін жинау? Ой, сендер қандайсыңдар?
Dialogue: 0,0:09:54.03,0:09:56.23,Default,,0,0,0,,Бізбен не істейсіз? ?
Dialogue: 0,0:09:59.40,0:10:03.34,Default,,0,0,0,,Дехедехе, уайымдама, мен құл саудагер Гурумамын.
Dialogue: 0,0:10:03.34,0:10:05.51,Default,,0,0,0,,Құл саудагерлері? О
Dialogue: 0,0:10:05.51,0:10:08.25,Default,,0,0,0,,Тіпті балалар, бізді 2-3 күн тамақпен қамтамасыз ете аласыздар.
Dialogue: 0,0:10:08.25,0:10:12.55,Default,,0,0,0,,Біз Dehedehedehe айырбастай аламыз ба, бізді құл етсін бе?
Dialogue: 0,0:10:12.55,0:10:15.25,Default,,0,0,0,,Саған ұнамаса, мені осы жерде өлтіре аласың.
Dialogue: 0,0:10:15.25,0:10:18.76,Default,,0,0,0,,Енді сендер менің өнімімсіңдер, хехехехе...
Dialogue: 0,0:10:18.76,0:10:21.56,Default,,0,0,0,,Сонымен... Әй, балалар.
Dialogue: 0,0:10:21.56,0:10:25.10,Default,,0,0,0,,Тауарды тиейік.Бастық, бұл кім?
Dialogue: 0,0:10:25.10,0:10:27.87,Default,,0,0,0,,Хе, өліп бара жатқан бейбақты лақтырып жібер.
Dialogue: 0,0:10:27.87,0:10:29.93,Default,,0,0,0,,Жоқ, бұл адам да менің қасымда болуы керек.
Dialogue: 0,0:10:29.93,0:10:32.70,Default,,0,0,0,,Осылай қалдырсаң, өлесің.
Dialogue: 0,0:10:32.70,0:10:35.37,Default,,0,0,0,,Хмм, дехедехе
Dialogue: 0,0:10:35.37,0:10:38.28,Default,,0,0,0,,Сенің жүзің сүйкімді болғаны ұят.
Dialogue: 0,0:10:38.28,0:10:40.98,Default,,0,0,0,,Егер сіз әйел болсаңыз
Dialogue: 0,0:10:40.98,0:10:44.48,Default,,0,0,0,,Амансың ба? Балам, өлетін нәрсені сата алмайсың.
Dialogue: 0,0:10:44.48,0:10:46.92,Default,,0,0,0,,Әйел болса, сұлу; егер ол еркек болса, ол күшті.
Dialogue: 0,0:10:46.92,0:10:50.49,Default,,0,0,0,,Егер ол жігерлі болмаса, жұмыс жоқ. Дехехехе
Dialogue: 0,0:10:50.49,0:10:52.52,Default,,0,0,0,,Сонда бұл адам мықты!
Dialogue: 0,0:10:52.52,0:10:56.29,Default,,0,0,0,,Дұрыс, бұл адам жалғыз өзі барлық қасқырларды жеңді.
Dialogue: 0,0:10:56.29,0:10:58.69,Default,,0,0,0,,Қараңдаршы, бұл не?
Dialogue: 0,0:11:01.83,0:11:06.00,Default,,0,0,0,,Бұл жігіт мылтық немесе пышақ емес, оны ішінен жарып жібереді.
Dialogue: 0,0:11:06.00,0:11:08.37,Default,,0,0,0,,Егер сіз мұны жалаң қолыңызбен жасасаңыз ше?
Dialogue: 0,0:11:08.37,0:11:11.28,Default,,0,0,0,,Бұл мәміле болуы мүмкін.
Dialogue: 0,0:11:11.28,0:11:13.78,Default,,0,0,0,,Бастық, өліп жатқан адамды өзіңізбен бірге алғыңыз келе ме?
Dialogue: 0,0:11:13.78,0:11:18.52,Default,,0,0,0,,Іскерлік бизнес Dehedehedehe
Dialogue: 0,0:11:18.52,0:11:20.59,Default,,0,0,0,,Содан кейін қол кісендерін киіңіз.
Dialogue: 0,0:11:20.59,0:11:24.19,Default,,0,0,0,,Егер бұл рас болса, бұл ақылсыз.
Dialogue: 0,0:11:26.99,0:11:30.53,Default,,0,0,0,,Уау! Тезірек жүріңіз!
Dialogue: 0,0:11:30.53,0:11:33.53,Default,,0,0,0,,Кешіктірмеңіз! О, менің!
Dialogue: 0,0:11:59.56,0:12:04.16,Default,,0,0,0,,Дехедехе, сендер бақыттысыңдар, менің қолыма түсіп қалдыңдар.
Dialogue: 0,0:12:04.16,0:12:07.07,Default,,0,0,0,,Менің ұраным - бұйымды күту.
Dialogue: 0,0:12:07.07,0:12:09.10,Default,,0,0,0,,Сондықтан мен оны машинада жасаймын.
Dialogue: 0,0:12:09.10,0:12:11.80,Default,,0,0,0,,Шүкір ет, дехедехе
Dialogue: 0,0:13:23.27,0:13:25.21,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:13:25.21,0:13:30.05,Default,,0,0,0,,Бұл Гессо қаласы, мұндағы ең үлкен құл базары.
Dialogue: 0,0:13:30.05,0:13:33.82,Default,,0,0,0,,Сен сияқты әлсіз жігіттерді құл болып сатып алып, сатады.
Dialogue: 0,0:13:33.82,0:13:36.75,Default,,0,0,0,,Қолдарын есіне түсіргендер мұнда сарбаздарды іздеп келеді.
Dialogue: 0,0:13:36.75,0:13:39.09,Default,,0,0,0,,«Әскери автобус» жалдаған
Dialogue: 0,0:13:39.09,0:13:42.43,Default,,0,0,0,,Мен сатып алу, сату, делдалдық жасау арқылы көп ақша табамын.
Dialogue: 0,0:13:42.43,0:13:46.43,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:13:48.30,0:13:50.87,Default,,0,0,0,,Бұл... иә?
Dialogue: 0,0:13:50.87,0:13:53.34,Default,,0,0,0,,Қашқын құлдардың тағдыры
Dialogue: 0,0:13:53.34,0:13:56.24,Default,,0,0,0,,Дехедехе жақсылап есте сақта
Dialogue: 0,0:14:01.51,0:14:04.02,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:14:04.02,0:14:07.25,Default,,0,0,0,,Сіз жарақат алдыңыз! Бұлай айқайлама
Dialogue: 0,0:14:07.25,0:14:10.02,Default,,0,0,0,,Тіпті бұған өте мұқият қарайды.
Dialogue: 0,0:14:10.02,0:14:13.32,Default,,0,0,0,,Бұл менің дүкенім!
Dialogue: 0,0:14:13.32,0:14:16.59,Default,,0,0,0,,Қарашы, мен сені қымбатқа сатамын.
Dialogue: 0,0:14:16.59,0:14:21.43,Default,,0,0,0,,Жарайсың ба? Клиенттер дүкенге қараса, ең жақсы жағдайда олар көңілді көрінеді.
Dialogue: 0,0:14:21.43,0:14:23.53,Default,,0,0,0,,Dehedehedehe
Dialogue: 0,0:14:32.08,0:14:34.98,Default,,0,0,0,,Сіз ше? Бұл теңіз қыраны ма?
Dialogue: 0,0:14:34.98,0:14:39.85,Default,,0,0,0,,Мен Фугенмін, сен сияқты құлмын.
Dialogue: 0,0:14:39.85,0:14:42.72,Default,,0,0,0,,Картоп ақсақ
Dialogue: 0,0:14:42.72,0:14:45.72,Default,,0,0,0,,Сондықтан ол сатылмай қалады.
Dialogue: 0,0:14:50.50,0:14:53.36,Default,,0,0,0,,Періште сияқты
Dialogue: 0,0:14:53.36,0:14:55.80,Default,,0,0,0,,Мен бұл балаларды қатты аяймын.
Dialogue: 0,0:14:55.80,0:14:59.00,Default,,0,0,0,,Құдірет қолымда болса
Dialogue: 0,0:14:59.00,0:15:01.30,Default,,0,0,0,,Кешіріңіз Сая
Dialogue: 0,0:15:04.84,0:15:07.55,Default,,0,0,0,,Әй, мама, мына кісі жылап тұр.
Dialogue: 0,0:15:07.55,0:15:09.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:22.06,0:15:24.46,Default,,0,0,0,,Уишотто
Dialogue: 0,0:15:31.17,0:15:35.14,Default,,0,0,0,,Хехехехе Бұл дехедехпен ақша табуға болады
Dialogue: 0,0:15:35.14,0:15:38.51,Default,,0,0,0,,Бастық шақырып жатыр.
Dialogue: 0,0:15:38.51,0:15:44.61,Default,,0,0,0,,Не! ? Бастық! ? Жоқ, генерал! ? Ха~
Dialogue: 0,0:15:46.58,0:15:50.92,Default,,0,0,0,,Сегун деген кім? Менің атым Сиска, мен осы қаланың бастығымын.
Dialogue: 0,0:15:50.92,0:15:53.46,Default,,0,0,0,,Оны қазір Шогун-сама, т.б.
Dialogue: 0,0:15:53.46,0:15:58.23,Default,,0,0,0,,Егер мен дұрыс айтсам, мен жай ғана компьютердің бағдарламалық жасақтамасын әзірлеу бөлімінің меңгерушісімін.
Dialogue: 0,0:15:58.23,0:16:01.13,Default,,0,0,0,,Мұндай адам бұл қалаға қалай билеуші ​​болды?
Dialogue: 0,0:16:01.13,0:16:04.90,Default,,0,0,0,,Бұл қалада лас суды тазартатын жүйе бар.
Dialogue: 0,0:16:04.90,0:16:08.54,Default,,0,0,0,,Оны өзінің құпия сөзі арқылы монополиялады.
Dialogue: 0,0:16:08.54,0:16:10.91,Default,,0,0,0,,Содан кейін жолыңызға түскендердің бәрін өлтіріңіз.
Dialogue: 0,0:16:10.91,0:16:13.71,Default,,0,0,0,,Ол қазір осы қаланың генералы.
Dialogue: 0,0:16:13.71,0:16:17.48,Default,,0,0,0,,Өкінішке орай, бастық бастапқыда Шисканың бастығы болған.
Dialogue: 0,0:16:17.48,0:16:19.58,Default,,0,0,0,,Және ол президент болды.
Dialogue: 0,0:16:42.41,0:16:44.38,Default,,0,0,0,,Гурма кіреді
Dialogue: 0,0:16:44.38,0:16:49.18,Default,,0,0,0,,Ух, Гурма, келгеніме қуаныштымын.
Dialogue: 0,0:16:49.18,0:16:52.28,Default,,0,0,0,,Иә, сонда отырыңыз.
Dialogue: 0,0:16:55.12,0:17:00.83,Default,,0,0,0,,...
Dialogue: 0,0:17:00.83,0:17:05.03,Default,,0,0,0,,Уф! Жоқ... жоқ... жоқ
Dialogue: 0,0:17:05.03,0:17:08.30,Default,,0,0,0,,Сонымен, Гурума, бұл күндері экономика қалай жүріп жатыр?
Dialogue: 0,0:17:08.30,0:17:12.64,Default,,0,0,0,,Аа, иә, соңғы кездері жақсы өнім таба алмай жүрмін.
Dialogue: 0,0:17:12.64,0:17:17.38,Default,,0,0,0,,Ей, қасқыр өлтіруші, сен үлкен мәмілесің.
Dialogue: 0,0:17:17.38,0:17:20.18,Default,,0,0,0,,Сіз оны сатып алған сияқтысыз, бірақ ол жоғары бағаға сатылады деп ойлайсыз ба?
Dialogue: 0,0:17:20.18,0:17:22.81,Default,,0,0,0,,Әйтеуір Шиска-сама ақшаны үнемдеп алды
Dialogue: 0,0:17:22.81,0:17:25.72,Default,,0,0,0,,Мен өтей аламын деп... Уау, бұл азап.
Dialogue: 0,0:17:25.72,0:17:30.39,Default,,0,0,0,,Төлеміңізді өте кешіктірсеңіз, дүкеніңізді тартып алуым мүмкін.
Dialogue: 0,0:17:30.39,0:17:35.16,Default,,0,0,0,,Сіз және Зиния көшенің арғы жағындағы дүкеніңізді қалайсыз.
Dialogue: 0,0:17:35.16,0:17:38.06,Default,,0,0,0,,Зин... Зинния? Бұл... бәрі осы.
Dialogue: 0,0:17:38.06,0:17:43.77,Default,,0,0,0,,Уф, бұл сенің оазис қаласың, осы дүниенің жұмағы.
Dialogue: 0,0:17:43.77,0:17:46.37,Default,,0,0,0,,Бізде су, жарық, тамақ бар.
Dialogue: 0,0:17:46.37,0:17:51.11,Default,,0,0,0,,Мен сені бұрынғы жақсы күндер үшін осында ұстап отырмын.
Dialogue: 0,0:17:51.11,0:17:54.31,Default,,0,0,0,,Сіз қалай ойлайсыз? Президент мырза
Dialogue: 0,0:17:54.31,0:17:57.22,Default,,0,0,0,,Мен... Түсіндім, бастық.
Dialogue: 0,0:17:57.22,0:18:03.09,Default,,0,0,0,,Иә? Дәл қазір не болды? Мен... ол кетті!
Dialogue: 0,0:18:03.09,0:18:06.86,Default,,0,0,0,,Мынау! Уф!
Dialogue: 0,0:18:06.86,0:18:09.26,Default,,0,0,0,,Бұл ауырады
Dialogue: 0,0:18:09.26,0:18:12.63,Default,,0,0,0,,Сәлем! Генерал болса да, ақымақ!
Dialogue: 0,0:18:12.63,0:18:14.57,Default,,0,0,0,,Бұрынғыдан өзгерек, Гурума.
Dialogue: 0,0:18:14.57,0:18:17.03,Default,,0,0,0,,Жалқау болсаң, дүкеніңді тартып аламыз.
Dialogue: 0,0:18:17.03,0:18:19.37,Default,,0,0,0,,Қарызыңызды тез өтеңіз.
Dialogue: 0,0:18:19.37,0:18:24.57,Default,,0,0,0,,Мен... Түсіндім, генерал, хехе.
Dialogue: 0,0:18:29.45,0:18:32.15,Default,,0,0,0,,Тәтті, саған не болды, генерал?
Dialogue: 0,0:18:32.15,0:18:35.75,Default,,0,0,0,,Әлі күнге дейін сол күрсіну мені ренжітті емес пе?
Dialogue: 0,0:18:37.96,0:18:39.96,Default,,0,0,0,,Менің дүкенім?
Dialogue: 0,0:18:39.96,0:18:43.13,Default,,0,0,0,,Иә, иә, берекелі іс, берекелі іс
Dialogue: 0,0:18:43.13,0:18:45.06,Default,,0,0,0,,Dehedehedehe
Dialogue: 0,0:18:45.06,0:18:47.13,Default,,0,0,0,,Иә, иә, иә
Dialogue: 0,0:18:47.13,0:18:50.30,Default,,0,0,0,,Баршаңызға сәлем, Gourmet дүкенінде мәмілелер.
Dialogue: 0,0:18:50.30,0:18:54.27,Default,,0,0,0,,Бұл жігіт басқа еш жерден ала алмайтын бірінші сортты өнім.
Dialogue: 0,0:18:54.27,0:18:58.04,Default,,0,0,0,,Сіз не айтып тұрсыз? Қалай қарасаңыз да, қолдануға жарамсыз сияқты.
Dialogue: 0,0:18:58.04,0:19:00.08,Default,,0,0,0,,Сол жерде тұтынушылар
Dialogue: 0,0:19:00.08,0:19:02.45,Default,,0,0,0,,Бұл маңдайшада өтірік жоқ.
Dialogue: 0,0:19:02.45,0:19:06.18,Default,,0,0,0,,Қасқырды өлтірсең де, бұл жігіт жартылай өлтірілген.
Dialogue: 0,0:19:06.18,0:19:09.09,Default,,0,0,0,,Дұрыс, біраз уақыттан бері мүлде қозғалған жоқ.
Dialogue: 0,0:19:09.09,0:19:11.09,Default,,0,0,0,,Ол өлген жоқ па?
Dialogue: 0,0:19:11.09,0:19:13.26,Default,,0,0,0,,О, бәрің тынышталыңдар.
Dialogue: 0,0:19:13.26,0:19:16.16,Default,,0,0,0,,Бір қарағанда, ол ескірген машинаға ұқсайды.
Dialogue: 0,0:19:16.16,0:19:20.90,Default,,0,0,0,,Негізінде оның жалаң қолымен 10 қасқырды өлтіретін күшті қолдары бар.
Dialogue: 0,0:19:20.90,0:19:25.17,Default,,0,0,0,,Шынында да ғасырдың соңындағы супер машина...
Dialogue: 0,0:19:25.17,0:19:29.04,Default,,0,0,0,,Бірақ, ол толығымен сынған және енді жұмыс істемейді, солай ма?
Dialogue: 0,0:19:29.04,0:19:33.88,Default,,0,0,0,,Жоқ, біз қазір оны қалпына келтіріп жатырмыз. Біраз күтіңіз. Иә.
Dialogue: 0,0:19:33.88,0:19:37.42,Default,,0,0,0,,Не, tsk, бұл туралы айтудың қажеті жоқ.
Dialogue: 0,0:19:37.42,0:19:40.65,Default,,0,0,0,,Бұл дүкен бұрынғыдай жақсы.
Dialogue: 0,0:19:40.65,0:19:42.95,Default,,0,0,0,,А, а...
Dialogue: 0,0:20:01.91,0:20:06.11,Default,,0,0,0,,Хмм… мм… мм…
Dialogue: 0,0:20:12.32,0:20:16.25,Default,,0,0,0,,Ооо, ау, Кен!
Dialogue: 0,0:20:16.25,0:20:20.02,Default,,0,0,0,,Хе, Кенширо, мен Юрияны аламын.
Dialogue: 0,0:20:20.02,0:20:23.89,Default,,0,0,0,,Бұл Юлия үшін... Не! ?
Dialogue: 0,0:20:23.89,0:20:29.20,Default,,0,0,0,,Әйеліңді ұрлауға келген мені өлтіруге тартындың.
Dialogue: 0,0:20:29.20,0:20:32.74,Default,,0,0,0,,Ондай тәттілік қазіргі заманда жарамайды.
Dialogue: 0,0:20:32.74,0:20:37.07,Default,,0,0,0,,Ондай жігіт жалғыз әйелді қорғай алмайды.
Dialogue: 0,0:20:37.07,0:20:41.81,Default,,0,0,0,,Сондықтан мен саған Юлияны бере алмаймын.
Dialogue: 0,0:20:41.81,0:20:46.01,Default,,0,0,0,,Уау! Кен!
Dialogue: 0,0:20:48.49,0:20:51.29,Default,,0,0,0,,Ю... Юрия!
Dialogue: 0,0:20:51.29,0:20:54.19,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:54.19,0:20:56.89,Default,,0,0,0,,Әке, қарашы, мына кісінің көзі ашылды.
Dialogue: 0,0:21:01.90,0:21:03.90,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:10.27,0:21:12.87,Default,,0,0,0,,Уау! Әзірге өзіңізді қатты итермеңіз
Dialogue: 0,0:21:15.25,0:21:18.45,Default,,0,0,0,,Амансың ба? А... аа
Dialogue: 0,0:21:20.82,0:21:23.22,Default,,0,0,0,,Иә? Сіз
Dialogue: 0,0:21:23.22,0:21:27.56,Default,,0,0,0,,Неліктен ол өлген қасқырмен бірге жатты?
Dialogue: 0,0:21:27.56,0:21:35.73,Default,,0,0,0,,Хмм... бұл... осы жараның кесірінен...
Dialogue: 0,0:21:35.73,0:21:39.04,Default,,0,0,0,,Ешкімге айтқың келмейтін нәрселер бар.
Dialogue: 0,0:21:39.04,0:21:41.74,Default,,0,0,0,,Ах, дұрыс.
Dialogue: 0,0:21:41.74,0:21:45.41,Default,,0,0,0,,Сен ғажапсың, сол қасқырлардың бәрін өлтірдің.
Dialogue: 0,0:21:45.41,0:21:49.61,Default,,0,0,0,,Бұл сен бе? Дэн, қажетсіз ештеңе айтпа.
Dialogue: 0,0:21:49.61,0:21:52.92,Default,,0,0,0,,Көмегің үшін рахмет №.
Dialogue: 0,0:21:52.92,0:21:55.92,Default,,0,0,0,,Мен сізге көмектесуге тырыстым, бірақ солай болды.
Dialogue: 0,0:21:55.92,0:21:58.02,Default,,0,0,0,,Құрмет жоқ
Dialogue: 0,0:22:02.43,0:22:05.33,Default,,0,0,0,,Билік жоқтар құлдар ма?
Dialogue: 0,0:22:05.33,0:22:10.20,Default,,0,0,0,,Бұл заманда әлсіздерді құл етіп сатып алып, сатады.
Dialogue: 0,0:22:10.20,0:22:17.51,Default,,0,0,0,,Жарақаттарың жазылып кеткен соң, сендер де тамақтың орнына сатыласыңдар.
Dialogue: 0,0:22:17.51,0:22:20.44,Default,,0,0,0,,Ағай, көңілсізсіз бе?
Dialogue: 0,0:22:20.44,0:22:23.68,Default,,0,0,0,,Мен Амомын. Ағаң қайда?
Dialogue: 0,0:22:23.68,0:22:27.02,Default,,0,0,0,,Мен Кенширомын, иә?
Dialogue: 0,0:22:27.02,0:22:31.46,Default,,0,0,0,,Танысқаныма қуаныштымын, Кенширо ағай.
Dialogue: 0,0:22:31.46,0:22:34.29,Default,,0,0,0,,Уау! ? Ga!
Dialogue: 0,0:22:34.29,0:22:37.03,Default,,0,0,0,,А...уф! Мықты болыңыз
Dialogue: 0,0:22:37.03,0:22:40.33,Default,,0,0,0,,Ағай! Сақ болыңыз
Dialogue: 0,0:22:40.33,0:22:42.90,Default,,0,0,0,,Біз бұл адамның кім екенін әлі білмейміз.
Dialogue: 0,0:22:42.90,0:22:46.77,Default,,0,0,0,,Мына қария әкем жылағанда бірге жылады!
Dialogue: 0,0:22:46.77,0:22:49.41,Default,,0,0,0,,Сондықтан ол мейірімді адам болуы керек.
Dialogue: 0,0:22:49.41,0:22:52.64,Default,,0,0,0,,Әкем айтты, солай ма? Адамдардың мұңын түсінетін адам
Dialogue: 0,0:22:52.64,0:22:55.11,Default,,0,0,0,,Ол өте мейірімді адам.
Dialogue: 0,0:22:55.11,0:22:59.51,Default,,0,0,0,,Ал, мен анық жылап едім.
Dialogue: 0,0:23:04.52,0:23:08.32,Default,,0,0,0,,Дұрыс, дұрыс, Амо.
Dialogue: 0,0:23:24.44,0:23:27.38,Default,,0,0,0,,Уау, менің бос уақытым бар сияқты.
Dialogue: 0,0:23:27.38,0:23:31.02,Default,,0,0,0,,Түптеп келгенде, блефинг арқылы ғана клиент ала алмайсың.
Dialogue: 0,0:23:31.02,0:23:35.85,Default,,0,0,0,,Мұндай құлдырау кезінде біз дүкендерімізді көшіруіміз керек шығар.
Dialogue: 0,0:23:35.85,0:23:40.69,Default,,0,0,0,,Ха! ? Қасқыр өлтіруші! ?
Dialogue: 0,0:23:40.69,0:23:45.26,Default,,0,0,0,,Сіз бұл белгіні қанша уақыттан бері қойып жүрсіз? О?
Dialogue: 0,0:23:45.26,0:23:48.27,Default,,0,0,0,,Эй, дүкендер арасындағы іскерлік кедергі осында.
Dialogue: 0,0:23:48.27,0:23:52.34,Default,,0,0,0,,Тыйым салынған емес пе? Менің қарсымдағы адам Gourmet дүкені.
Dialogue: 0,0:23:52.34,0:23:57.54,Default,,0,0,0,,Мына маңдайша таң қалдырады, ал іші бұрынғыдай ұқыпты.
Dialogue: 0,0:23:57.54,0:24:00.44,Default,,0,0,0,,О? Не? Теме!
Dialogue: 0,0:24:00.44,0:24:05.08,Default,,0,0,0,,Эй, қасқыр өлтіруші. Эй, бұл кім?
Dialogue: 0,0:24:05.08,0:24:07.79,Default,,0,0,0,,Мынау ұйықтап жатқан адам.
Dialogue: 0,0:24:07.79,0:24:11.66,Default,,0,0,0,,Өйткені, он қасқырды жалаң қолмен өлтірген адам ғой.
Dialogue: 0,0:24:11.66,0:24:17.09,Default,,0,0,0,,Дәл қазір бір апталық азық-түлік пен 200 литр бензинге үлкен жеңілдік бар.
Dialogue: 0,0:24:17.09,0:24:19.73,Default,,0,0,0,,Ондай жігіттің құны соншама?
Dialogue: 0,0:24:19.73,0:24:22.17,Default,,0,0,0,,Делдалдық төлем сәл жоғары емес пе?
Dialogue: 0,0:24:22.17,0:24:27.97,Default,,0,0,0,,Күйеуім, олай істемей, бұлай істемегенің жөн.
Dialogue: 0,0:24:27.97,0:24:33.58,Default,,0,0,0,,Мен дүкенімде мықтырақ, мықтырақ, үлкенірек жігіттердің бірі болғанын қалаймын.
Dialogue: 0,0:24:33.58,0:24:36.11,Default,,0,0,0,,Эй, Зинния, бизнеске араласу
Dialogue: 0,0:24:36.11,0:24:38.15,Default,,0,0,0,,Олар мұны істемеу керек дейді.
Dialogue: 0,0:24:38.15,0:24:42.25,Default,,0,0,0,,Бұл Гурман. Жоқ, бұл сіздің дүкеннен.
Dialogue: 0,0:24:42.25,0:24:46.26,Default,,0,0,0,,Сатылмаған тауардың қымбаттығы сонша, олар тым ескірген.
Dialogue: 0,0:24:46.26,0:24:50.43,Default,,0,0,0,,Мен аздап уайымдап тұрмын.
Dialogue: 0,0:24:50.43,0:24:54.40,Default,,0,0,0,,Жақсы, қосымша көмегіңіз үшін рахмет.
Dialogue: 0,0:24:54.40,0:24:59.14,Default,,0,0,0,,Дүкенім мұңайған жоқ, мені аяйсың.
Dialogue: 0,0:24:59.14,0:25:03.94,Default,,0,0,0,,Бұл өте жақсы. Бұл жақсы тұтынушы сияқты.
Dialogue: 0,0:25:03.94,0:25:08.45,Default,,0,0,0,,Қайсысы жақсы, менің дүкенімдегі ұсынылған өнім немесе үйдегі қасқыр өлтіруші ме?
Dialogue: 0,0:25:08.45,0:25:11.95,Default,,0,0,0,,көрсетейін, мм?
Dialogue: 0,0:25:11.95,0:25:14.29,Default,,0,0,0,,Мен оны әлі сатып алуды шешкен жоқпын.
Dialogue: 0,0:25:14.29,0:25:19.12,Default,,0,0,0,,Жарайды, Зиния, ертең түскі жекпе-жек өткізейік.
Dialogue: 0,0:25:19.12,0:25:22.76,Default,,0,0,0,,Бір минут күтіңіз, бұл адамның жарақаты әлі жазылмаған.
Dialogue: 0,0:25:22.76,0:25:26.13,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Бұл жігіт қасқыр өлтіруші.
Dialogue: 0,0:25:26.13,0:25:29.80,Default,,0,0,0,,Жаралы болсаң да, кім болсаң да, жау емессің.
Dialogue: 0,0:25:29.80,0:25:35.21,Default,,0,0,0,,Хмф, мен оны қабылдаймын.
Dialogue: 0,0:25:35.21,0:25:38.58,Default,,0,0,0,,Dehedehedehehmm
Dialogue: 0,0:25:38.58,0:25:41.55,Default,,0,0,0,,Dehedehedehe mmmmmmmm
Dialogue: 0,0:25:41.55,0:25:43.75,Default,,0,0,0,,Сондықтан мен әлі шешкен жоқпын.
Dialogue: 0,0:25:43.75,0:25:45.95,Default,,0,0,0,,Мм! Дехе!
Dialogue: 0,0:26:09.24,0:26:12.21,Default,,0,0,0,,Дехе! Дехедехе!
Dialogue: 0,0:26:12.21,0:26:16.81,Default,,0,0,0,,Зиння бейбақ, сонша адамды қашан жинадың?
Dialogue: 0,0:26:16.81,0:26:18.75,Default,,0,0,0,,Тіпті Шиска
Dialogue: 0,0:26:18.75,0:26:23.59,Default,,0,0,0,,Егер ол кісі осы адамдардың алдында жеңілсе, менің дүкенім жойылады.
Dialogue: 0,0:26:23.59,0:26:26.49,Default,,0,0,0,,Бұл жігіт қауіпті.
Dialogue: 0,0:26:26.49,0:26:30.89,Default,,0,0,0,,Фуфу Гурма, мен мұны сіздің дүкеніңізді жабу мүмкіндігі ретінде қабылдаймын.
Dialogue: 0,0:26:30.89,0:26:32.99,Default,,0,0,0,,Мен оны дүкенім етемін.
Dialogue: 0,0:26:48.28,0:26:51.18,Default,,0,0,0,,Осы дүрбелеңнің арқасында қауіпсіздік әлсіз.
Dialogue: 0,0:26:51.18,0:26:53.68,Default,,0,0,0,,А, енді сіздің мүмкіндігіңіз.
Dialogue: 0,0:26:59.82,0:27:04.56,Default,,0,0,0,,Ханымдар мен мырзалар, кестелеріңіздің тығыздығына қарамастан бүгін бізге қосылғаныңыз үшін рахмет.
Dialogue: 0,0:27:04.56,0:27:09.40,Default,,0,0,0,,Мен бұл Гурумаға қатты әсер еттім...
Dialogue: 0,0:27:09.40,0:27:13.27,Default,,0,0,0,,Енді менің ұсынысым «Гурманың құл дүкені»
Dialogue: 0,0:27:13.27,0:27:18.88,Default,,0,0,0,,Делдалдық төлем бір апталық азық-түлік немесе 200 литр бензин.
Dialogue: 0,0:27:18.88,0:27:23.48,Default,,0,0,0,,Қасқыр өлтірушімен таныстыру!
Dialogue: 0,0:27:32.42,0:27:35.06,Default,,0,0,0,,Эй, қытырлақ ет!
Dialogue: 0,0:27:35.06,0:27:39.06,Default,,0,0,0,,Егер жеңілсең, мен олардың бәрін өлтіремін.
Dialogue: 0,0:27:41.53,0:27:44.80,Default,,0,0,0,,Олай болса, шоуға келгендердің бәрі.
Dialogue: 0,0:27:44.80,0:27:50.61,Default,,0,0,0,,Менің желілік нарықтағы ең жақсы таңдауым - Хокка және кеше ғана келген басқалары.
Dialogue: 0,0:27:50.61,0:27:54.21,Default,,0,0,0,,Аю өлтіруші Гадеспен таныстыру!
Dialogue: 0,0:27:59.72,0:28:01.99,Default,,0,0,0,,Иә? Жақсы!
Dialogue: 0,0:28:01.99,0:28:04.66,Default,,0,0,0,,Мен аюды тұншықтырып өлтірдім.
Dialogue: 0,0:28:04.66,0:28:08.26,Default,,0,0,0,,Қасқырды өлтірсең, мен сені жұлып аламын, бейбақ!
Dialogue: 0,0:28:08.26,0:28:12.13,Default,,0,0,0,,А... Әй, бұл рас па?
Dialogue: 0,0:28:12.13,0:28:15.77,Default,,0,0,0,,Егер біз Диоға бет алсақ, әпкемнің жауымен кездесуіміз анық.
Dialogue: 0,0:28:15.77,0:28:19.27,Default,,0,0,0,,Гурума Бұл жолы жолым болмады.
Dialogue: 0,0:28:19.27,0:28:24.01,Default,,0,0,0,,Қасқыр өлтіруші болсаң, менде саған аюды өлтіруші бар.
Dialogue: 0,0:28:24.01,0:28:27.91,Default,,0,0,0,,Хмм, ол жай ғана ағаш қуыршақ діни қызметкер емес пе?
Dialogue: 0,0:28:27.91,0:28:29.91,Default,,0,0,0,,Ух хе хе хе
Dialogue: 0,0:28:36.32,0:28:40.02,Default,,0,0,0,,Ал, әрқайсыңыз өзіңізге ұнайтын қаруды таңдай аласыз.
Dialogue: 0,0:28:40.02,0:28:45.23,Default,,0,0,0,,Құрметті генерал, мен бұлай айтуға қорқамын
Dialogue: 0,0:28:45.23,0:28:47.50,Default,,0,0,0,,Бұл адам өте қауіпті.
Dialogue: 0,0:28:47.50,0:28:51.74,Default,,0,0,0,,Қолыма кісен салып төбелесуге рұқсат етіңіз.
Dialogue: 0,0:28:51.74,0:28:56.67,Default,,0,0,0,,Ой, бұл әзіл ғой. Бұл абайсыздық емес пе?
Dialogue: 0,0:28:56.67,0:29:01.75,Default,,0,0,0,,Эй, Гурума, уайымдап тұрсың ба? Егер сіз Гадеске осылай жасасаңыз ше?
Dialogue: 0,0:29:01.75,0:29:04.08,Default,,0,0,0,,Иттің өлуіне жол бермейсің бе?
Dialogue: 0,0:29:04.08,0:29:08.92,Default,,0,0,0,,Бұл жақсы кемістік, Зинния, кейін әбігерге салма.
Dialogue: 0,0:29:08.92,0:29:11.82,Default,,0,0,0,,Кешіріңіз, бірақ мен кісенді шеше алмаймын.
Dialogue: 0,0:29:11.82,0:29:17.43,Default,,0,0,0,,Сіздің жеңілгеніңіз үшін ақталуыңыз шыдамайды. Маған кек сақтама.
Dialogue: 0,0:29:17.43,0:29:22.93,Default,,0,0,0,,Ха, мынау... сұмдық, мен әлі әрең тұрамын.
Dialogue: 0,0:29:22.93,0:29:26.47,Default,,0,0,0,,Әке, Кенширо өлтіріледі.
Dialogue: 0,0:29:26.47,0:29:30.41,Default,,0,0,0,,Жоқ, әлі үмітіңізді үзбеңіз.
Dialogue: 0,0:29:30.41,0:29:34.28,Default,,0,0,0,,Ол кісі мен білетін Кенширо болса екен.
Dialogue: 0,0:29:34.28,0:29:38.52,Default,,0,0,0,,Не? Оны қазір өлтір, Гадес.
Dialogue: 0,0:29:38.52,0:29:41.32,Default,,0,0,0,,Жеңіске жетсеңіз, жалақыңыз үш еселенеді!
Dialogue: 0,0:29:44.69,0:29:48.86,Default,,0,0,0,,Гехехехе…
Dialogue: 0,0:29:48.86,0:29:54.77,Default,,0,0,0,,Уайымдама, мен сені қинауға уақыт таппай өлтіремін!
Dialogue: 0,0:29:54.77,0:29:58.54,Default,,0,0,0,,Мм, сізге қару керек емес пе?
Dialogue: 0,0:29:58.54,0:30:02.41,Default,,0,0,0,,Бұл қару. Ах, анау бейбақ.
Dialogue: 0,0:30:02.41,0:30:06.28,Default,,0,0,0,,Сіз бас тарттыңыз ба? Ол қайтадан толығымен ашылды
Dialogue: 0,0:30:06.28,0:30:09.08,Default,,0,0,0,,Олай болса
Dialogue: 0,0:30:09.08,0:30:11.58,Default,,0,0,0,,Ха! ? Нұря!
Dialogue: 0,0:30:14.75,0:30:17.75,Default,,0,0,0,,Дехья! Бір-бірін өлтіретін гонг
Dialogue: 0,0:30:17.75,0:30:21.39,Default,,0,0,0,,Қоңырау соғып тұр! Қасқыр өлтіруші!
Dialogue: 0,0:30:21.39,0:30:23.83,Default,,0,0,0,,Ах! Эй, эй, дәл қазір солай болады деп күтпедім.
Dialogue: 0,0:30:23.83,0:30:27.33,Default,,0,0,0,,Ол өлген жоқ па? Хмм
Dialogue: 0,0:30:31.90,0:30:35.31,Default,,0,0,0,,Сіз шынымен де аю өлтірушісіз бе?
Dialogue: 0,0:30:35.31,0:30:38.21,Default,,0,0,0,,Олар тіпті кішкентай аюды да алған сияқты.
Dialogue: 0,0:30:38.21,0:30:40.81,Default,,0,0,0,,Не? Бұл аюдың күшігі ме?
Dialogue: 0,0:30:45.95,0:30:50.85,Default,,0,0,0,,Бұл не? Тым күшті болмаңыз!
Dialogue: 0,0:30:55.69,0:30:58.99,Default,,0,0,0,,На… на…
Dialogue: 0,0:31:06.00,0:31:10.50,Default,,0,0,0,,Сіз не істеп жатырсыз? Әзірше емес...?
Dialogue: 0,0:31:14.71,0:31:18.92,Default,,0,0,0,,Не? Бұл сиқыр ма?
Dialogue: 0,0:31:18.92,0:31:23.49,Default,,0,0,0,,Жоқ! Нуууу...
Dialogue: 0,0:31:23.49,0:31:26.89,Default,,0,0,0,,Эй, сен таңқаларлық ақымақсың.
Dialogue: 0,0:31:26.89,0:31:31.63,Default,,0,0,0,,Оның пайдасы жоқ. Өлуге асықпайды. Оны қазірдің өзінде тоқтатыңыз.
Dialogue: 0,0:31:31.63,0:31:36.17,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Сіз ауырып, шаршадыңыз.
Dialogue: 0,0:31:36.17,0:31:40.87,Default,,0,0,0,,Бұл шектеу. Мен сенен бас тартпаймын!
Dialogue: 0,0:31:44.04,0:31:46.74,Default,,0,0,0,,Өл!
Dialogue: 0,0:31:49.31,0:31:51.88,Default,,0,0,0,,Нуваа! Қалыңыз! Ах...
Dialogue: 0,0:31:51.88,0:31:54.79,Default,,0,0,0,,Ата! Гуаа!
Dialogue: 0,0:31:54.79,0:31:57.49,Default,,0,0,0,,О!
Dialogue: 0,0:32:12.57,0:32:17.31,Default,,0,0,0,,Не! Сонымен... керемет!
Dialogue: 0,0:32:17.31,0:32:19.84,Default,,0,0,0,,Бұл жігіт супер машина ғой.
Dialogue: 0,0:32:19.84,0:32:21.78,Default,,0,0,0,,Дехехехе
Dialogue: 0,0:32:21.78,0:32:24.68,Default,,0,0,0,,О! Ал... соған дейін!
Dialogue: 0,0:32:28.55,0:32:34.36,Default,,0,0,0,,Бауырым! Кенширо-сан керемет! аа! Өте күшті!
Dialogue: 0,0:32:34.36,0:32:36.83,Default,,0,0,0,,Ол кісі нағыз қасқыр өлтіруші.
Dialogue: 0,0:32:36.83,0:32:41.23,Default,,0,0,0,,көремін. Солай ма?
Dialogue: 0,0:32:51.98,0:32:57.85,Default,,0,0,0,,Мен таң қалдым. Мен мұндай декорация бұрынғының қалдығы деп ойладым.
Dialogue: 0,0:32:57.85,0:33:02.05,Default,,0,0,0,,Шисканың күшінің көзі осы ма?
Dialogue: 0,0:33:13.36,0:33:17.73,Default,,0,0,0,,Бұл не? Мен барымтадамын, бұл менде болғанша.
Dialogue: 0,0:33:17.73,0:33:21.61,Default,,0,0,0,,Бұл қала тұрғындарының Шискаға бағынудан басқа амалы жоқ.
Dialogue: 0,0:33:21.61,0:33:25.51,Default,,0,0,0,,Ол түрмеде ғана емес, осы қамалда.
Dialogue: 0,0:33:25.51,0:33:29.15,Default,,0,0,0,,Қаланы жарып жіберетін пультті өзіммен бірге ұстаймын.
Dialogue: 0,0:33:29.15,0:33:31.78,Default,,0,0,0,,Қосалқы зат осында, солай ма?
Dialogue: 0,0:33:31.78,0:33:35.39,Default,,0,0,0,,Иә, оның қолындағысы ше?
Dialogue: 0,0:33:35.39,0:33:38.79,Default,,0,0,0,,Менде оны алып кетудің жоспары бар.
Dialogue: 0,0:33:38.79,0:33:41.73,Default,,0,0,0,,Сәлем досым
Dialogue: 0,0:33:41.73,0:33:45.93,Default,,0,0,0,,Олай болса, бұл қаланы иемденгеніміз дұрыс емес пе?
Dialogue: 0,0:33:45.93,0:33:51.27,Default,,0,0,0,,Хмм? Тоқта, ол адам тұрғанша мүмкін емес.
Dialogue: 0,0:33:51.27,0:33:55.77,Default,,0,0,0,,Біртүрлі ойлар өлімге әкеледі. Иә, ол адам?
Dialogue: 0,0:34:05.62,0:34:11.52,Default,,0,0,0,,Эй, бұл хайуанаттар бағы емес. Өнімді алғыңыз келмесе, үйге барыңыз.
Dialogue: 0,0:34:11.52,0:34:13.69,Default,,0,0,0,,Бұл не? Жақсы емес пе?
Dialogue: 0,0:34:13.69,0:34:20.46,Default,,0,0,0,,Аюды өлтіріп, қасқырды өлтірген адам...Бастық Мұны оқу қиын.
Dialogue: 0,0:34:20.46,0:34:23.67,Default,,0,0,0,,Ақымақ! Сіз де көрген боларсыз
Dialogue: 0,0:34:23.67,0:34:26.40,Default,,0,0,0,,Оның күші! Хехе, жүр!
Dialogue: 0,0:34:26.40,0:34:31.24,Default,,0,0,0,,Тәуекелсіз, табысы жоғары бизнеске ие болғаным үшін шынымен бақыттымын.
Dialogue: 0,0:34:31.24,0:34:34.58,Default,,0,0,0,,Бастық Сіз бәрібір не істейсіз? бұл адам
Dialogue: 0,0:34:34.58,0:34:37.21,Default,,0,0,0,,Жақсы, ол жоғары бағаға сатылатын шығар.
Dialogue: 0,0:34:37.21,0:34:39.98,Default,,0,0,0,,Осындай нәрсені көрсек, қанша істесек те,
Dialogue: 0,0:34:39.98,0:34:42.32,Default,,0,0,0,,Мен ол жігітті басқара алмаймын.
Dialogue: 0,0:34:42.32,0:34:46.19,Default,,0,0,0,,Ал, жақсы... Бірақ өнім - бұл өнім.
Dialogue: 0,0:34:46.19,0:34:49.19,Default,,0,0,0,,Менің айтқанымды тыңдайсыз деп үміттенемін.
Dialogue: 0,0:34:51.36,0:34:54.20,Default,,0,0,0,,Сіз ха! Иә, иә!
Dialogue: 0,0:34:54.20,0:34:59.00,Default,,0,0,0,,Мені сонша сатқың келсе, мына отбасын жинап алайық.
Dialogue: 0,0:34:59.00,0:35:01.77,Default,,0,0,0,,Не? Сен не туралы айтып тұрсың?
Dialogue: 0,0:35:01.77,0:35:06.34,Default,,0,0,0,,Мұнда бәрі менімен бірге сат деп жатыр.
Dialogue: 0,0:35:06.34,0:35:10.35,Default,,0,0,0,,Басқаша айтқанда, сізді және осы отбасыңызды жиынтық ретінде сатуымды қалайсыз ба?
Dialogue: 0,0:35:10.35,0:35:12.52,Default,,0,0,0,,Қария да, иә?
Dialogue: 0,0:35:12.52,0:35:15.85,Default,,0,0,0,,Ал мына түрме ыңғайсыз.
Dialogue: 0,0:35:15.85,0:35:21.36,Default,,0,0,0,,Оны басқа жерге көшірейік...
Dialogue: 0,0:35:21.36,0:35:25.83,Default,,0,0,0,,Бұл біраз...
Dialogue: 0,0:35:25.83,0:35:28.67,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:35:28.67,0:35:31.33,Default,,0,0,0,,Иә! Мен оны түсіндім!
Dialogue: 0,0:35:31.33,0:35:34.70,Default,,0,0,0,,Біраз күтіңіз.
Dialogue: 0,0:35:34.70,0:35:38.58,Default,,0,0,0,,Мұның бәрі не туралы? Бұл жаман идея ма?
Dialogue: 0,0:35:38.58,0:35:42.08,Default,,0,0,0,,Бұл тәуекелі жоғары, қайтарымсыз бизнес, солай ма?
Dialogue: 0,0:35:44.21,0:35:46.62,Default,,0,0,0,,Бұл жеткілікті, бұл жеткілікті
Dialogue: 0,0:35:46.62,0:35:49.85,Default,,0,0,0,,Сіз ешқашан ажырамайсыз.
Dialogue: 0,0:35:49.85,0:35:54.72,Default,,0,0,0,,Рахмет Кенширо-сан Кенширо-сан...
Dialogue: 0,0:35:54.72,0:35:58.33,Default,,0,0,0,,Жақсы ма? Не айтқың келеді?
Dialogue: 0,0:35:58.33,0:36:03.27,Default,,0,0,0,,Әлсіздерді құл саудагерлері ұстап алып, басқа жерде сатады.
Dialogue: 0,0:36:03.27,0:36:08.47,Default,,0,0,0,,Бұл отбасының тағдырын сенің мейірімділігіңмен өзгерту мүмкін емес.
Dialogue: 0,0:36:08.47,0:36:14.38,Default,,0,0,0,,Бұл күштілердің уақытша өзімшілдік әрекеті деп ойламайсыз ба?
Dialogue: 0,0:36:14.38,0:36:17.15,Default,,0,0,0,,Сонымен... сен неге?
Dialogue: 0,0:36:17.15,0:36:21.85,Default,,0,0,0,,Аю өлтірушіні сен өлтірген жоқсың ба? Ол мені өлтіре алмайды
Dialogue: 0,0:36:21.85,0:36:24.19,Default,,0,0,0,,Онда оны өлтіруге ешқандай себеп жоқ.
Dialogue: 0,0:36:24.19,0:36:28.69,Default,,0,0,0,,Бұл өзімшіл, саған жарайды.
Dialogue: 0,0:36:28.69,0:36:34.06,Default,,0,0,0,,Бірақ оның жаралары жазылса, ол қайтадан өлтіре алады.
Dialogue: 0,0:36:34.06,0:36:38.30,Default,,0,0,0,,Бұл отбасы болуы мүмкін.
Dialogue: 0,0:36:38.30,0:36:41.20,Default,,0,0,0,,Сонда мен не істеуім керек?
Dialogue: 0,0:36:45.98,0:36:50.08,Default,,0,0,0,,Хехе, сен сондай тәттісің.
Dialogue: 0,0:36:58.39,0:37:01.83,Default,,0,0,0,,Амоның не үшін дұға етіп жатқанын білесіз бе?
Dialogue: 0,0:37:01.83,0:37:06.30,Default,,0,0,0,,Сіз нені айтасыз? Бұл құтқарушының келуі.
Dialogue: 0,0:37:06.30,0:37:12.20,Default,,0,0,0,,Әлсіздер әрқашан құтқарушы...
Dialogue: 0,0:37:12.20,0:37:16.71,Default,,0,0,0,,Құтқарушы дегеніміз не? Ол барлық қайғыны иығында көтереді.
Dialogue: 0,0:37:16.71,0:37:21.91,Default,,0,0,0,,Тағдырынан ешқашан қашпайтындар туралы.
Dialogue: 0,0:37:56.45,0:38:01.22,Default,,0,0,0,,Тынш! Сәттілік
Dialogue: 0,0:38:01.22,0:38:05.46,Default,,0,0,0,,Құрметті Жуғай, бәрі дайын.
Dialogue: 0,0:38:05.46,0:38:09.06,Default,,0,0,0,,Бекініске шабуыл жасайтын уақыт жетті.
Dialogue: 0,0:38:13.60,0:38:15.60,Default,,0,0,0,,«Сенді ергеніме өкінемін».
Dialogue: 0,0:38:28.18,0:38:31.38,Default,,0,0,0,,Мен сенен шыққан кісі өлтіру ниеті мен зұлым рухтың иісін сеземін.
Dialogue: 0,0:38:31.38,0:38:34.98,Default,,0,0,0,,Не... не? мені өлтір
Dialogue: 0,0:38:34.98,0:38:37.85,Default,,0,0,0,,Қашықтан басқару пультін алыңыз.
Dialogue: 0,0:38:37.85,0:38:41.06,Default,,0,0,0,,Сонда Гессо қаласы сіздікі болады.
Dialogue: 0,0:38:41.06,0:38:43.66,Default,,0,0,0,,Сонымен... мұндай нәрсе
Dialogue: 0,0:38:48.70,0:38:52.37,Default,,0,0,0,,Бұл дүниеде дос болсын, дұшпан болсын, өлілер ғана бар.
Dialogue: 0,0:38:52.37,0:38:55.37,Default,,0,0,0,,Оларды бір-бірінен ажырату тривиальды.
Dialogue: 0,0:38:55.37,0:38:59.78,Default,,0,0,0,,Қат! Сосын өл!
Dialogue: 0,0:38:59.78,0:39:01.78,Default,,0,0,0,,Ха!
Dialogue: 0,0:39:06.18,0:39:09.18,Default,,0,0,0,,Бұл сіздің олжаңыз, оны жеңіз.
Dialogue: 0,0:39:19.86,0:39:24.37,Default,,0,0,0,,Мен ол қаланы ешкімге бермеймін, кеттік!
Dialogue: 0,0:39:24.37,0:39:26.47,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:39:42.15,0:39:44.89,Default,,0,0,0,,Ей, кезектесіп отырайық.
Dialogue: 0,0:39:44.89,0:39:46.89,Default,,0,0,0,,Егер ол Кира болса, тергеу штабын басқаратын L —
Dialogue: 0,0:39:58.43,0:40:01.27,Default,,0,0,0,,Бұл...
Dialogue: 0,0:40:01.27,0:40:05.64,Default,,0,0,0,,Барлық азаматтарға хабарландыру: Жаудың шабуылы.
Dialogue: 0,0:40:05.64,0:40:08.11,Default,,0,0,0,,Менің генералымның қаласын басып алуға тырысу.
Dialogue: 0,0:40:08.11,0:40:11.48,Default,,0,0,0,,Бұл қамалды арам адамдар қоршап алады.
Dialogue: 0,0:40:11.48,0:40:15.89,Default,,0,0,0,,Қатты дайындықта болыңыз және қалаға ешкімді кіргізбеңіз.
Dialogue: 0,0:40:15.89,0:40:19.72,Default,,0,0,0,,Қайталаңыз, барлық азаматтарға айтыңыз, бұл жаудың шабуылы.
Dialogue: 0,0:40:19.72,0:40:24.19,Default,,0,0,0,,Хм, жау шабуылы ма? Жау – Жуғай әскері.
Dialogue: 0,0:40:24.19,0:40:27.93,Default,,0,0,0,,Не деген азап, тағы сол ақымақ.
Dialogue: 0,0:40:27.93,0:40:32.90,Default,,0,0,0,,Әдеттегідей оларды кері жіберіңіз, бірақ бұл жолы жағдай басқаша.
Dialogue: 0,0:40:32.90,0:40:36.77,Default,,0,0,0,,Егер бізге бірден шабуыл жасалса, біз үлкен шығынға ұшыраймыз деп қорқамын.
Dialogue: 0,0:40:36.77,0:40:42.78,Default,,0,0,0,,Сіз неден шошып тұрсыз? Оларға су мен тамақ беріңіз ...
Dialogue: 0,0:40:42.78,0:40:47.72,Default,,0,0,0,,Әй, маған жас құлдар беріп, үйге баруға рұқсат етіңіз.
Dialogue: 0,0:40:47.72,0:40:50.52,Default,,0,0,0,,Бұл цитадель алынбайды.
Dialogue: 0,0:40:50.52,0:40:53.92,Default,,0,0,0,,Олардың маған қатты шабуыл жасауы мүмкін емес.
Dialogue: 0,0:40:53.92,0:40:58.39,Default,,0,0,0,,Иә, бірақ... бос тұрма.
Dialogue: 0,0:40:58.39,0:41:00.49,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:41:14.54,0:41:21.28,Default,,0,0,0,,Бұл жерде менің суым, тамағым бар, мен де құл бекітіп беремін.
Dialogue: 0,0:41:21.28,0:41:24.18,Default,,0,0,0,,Бұл жерден дереу кетіңіз.
Dialogue: 0,0:41:29.03,0:41:31.43,Default,,0,0,0,,Гуоах кяаа
Dialogue: 0,0:41:35.30,0:41:41.44,Default,,0,0,0,,Жарайды, ол жігіттер әдеттегіден бөлек, солай емес пе?
Dialogue: 0,0:41:41.44,0:41:43.37,Default,,0,0,0,,Тор төмен! Тор төмен!
Dialogue: 0,0:41:43.37,0:41:49.88,Default,,0,0,0,,Барлық қақпалар жабық. Біз қоршау шайқасына кірісеміз!
Dialogue: 0,0:41:49.88,0:41:53.55,Default,,0,0,0,,Біз өзімізді қамап алсақ, біз жеңеміз.
Dialogue: 0,0:41:53.55,0:41:56.82,Default,,0,0,0,,Бұл қаладан басқа бұл жерде су жоқ.
Dialogue: 0,0:41:56.82,0:41:59.66,Default,,0,0,0,,Жау көп ұзамай құрғайды.
Dialogue: 0,0:41:59.66,0:42:02.36,Default,,0,0,0,,Тезірек, балалар қозғалып жатырсыңдар.
Dialogue: 0,0:42:02.36,0:42:05.30,Default,,0,0,0,,Бізді қайда апара жатырсың? Бұл мен!
Dialogue: 0,0:42:05.30,0:42:08.10,Default,,0,0,0,,Бұл түрмеден де жақсы жер.
Dialogue: 0,0:42:08.10,0:42:13.84,Default,,0,0,0,,Әй, аға, мен шөлдедім. Мен жаңа ғана су тесігінен су алдым.
Dialogue: 0,0:42:13.84,0:42:17.34,Default,,0,0,0,,Мынаны ішу керек!
Dialogue: 0,0:42:19.64,0:42:23.51,Default,,0,0,0,,Мен оны Кеншираға да беремін, сәл күте тұрыңыз.
Dialogue: 0,0:42:23.51,0:42:26.95,Default,,0,0,0,,Улы иісті суды ішпе.
Dialogue: 0,0:42:26.95,0:42:28.95,Default,,0,0,0,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:42:38.56,0:42:40.86,Default,,0,0,0,,Бұл...
Dialogue: 0,0:42:46.17,0:42:50.54,Default,,0,0,0,,Осымен мен өзімді қоршау сияқты алаңсыз әрекеттерді жасай алмаймын.
Dialogue: 0,0:42:50.54,0:42:52.78,Default,,0,0,0,,Олар байсалды.
Dialogue: 0,0:42:52.78,0:42:56.25,Default,,0,0,0,,Енді су болмаған соң, торға отырудың қажеті жоқ.
Dialogue: 0,0:42:56.25,0:43:00.55,Default,,0,0,0,,Бұлай жалғаса берсе, бәріміз араласып, өлтіреміз.
Dialogue: 0,0:43:11.56,0:43:16.70,Default,,0,0,0,,Енді оған қарамаңыз. Бұл сіз, әйел адам, көтере алмайтын көрініс.
Dialogue: 0,0:43:16.70,0:43:19.64,Default,,0,0,0,,Ха! Неге олай?
Dialogue: 0,0:43:19.64,0:43:23.94,Default,,0,0,0,,Сіз неше жаста боласыз? 15
Dialogue: 0,0:43:31.71,0:43:34.32,Default,,0,0,0,,Нуо! Не! ? У! ?
Dialogue: 0,0:43:34.32,0:43:37.95,Default,,0,0,0,,Бұл Жуғайдың байсалдылығының белгісі ме?
Dialogue: 0,0:43:37.95,0:43:41.22,Default,,0,0,0,,Өте қиын болды… Өтінемін, мені жалғыз қалдыр.
Dialogue: 0,0:43:41.22,0:43:48.00,Default,,0,0,0,,Соғыс, бұл қаланы қорға, әйтпесе мен сенің отбасыңды өлтіремін.
Dialogue: 0,0:43:48.00,0:43:52.24,Default,,0,0,0,,Балалар, түсіндіңдер ме? Бұл детонатор
Dialogue: 0,0:43:52.24,0:43:57.64,Default,,0,0,0,,Маған мойынсұнбасаң, отбасың мен әйелдерің түгелдей қырылады!
Dialogue: 0,0:43:57.64,0:44:02.48,Default,,0,0,0,,Жарайсың ба? Сізді кепілге алғаныңызды ұмытпаңыз!
Dialogue: 0,0:44:02.48,0:44:05.01,Default,,0,0,0,,Хаха!
Dialogue: 0,0:44:05.01,0:44:07.21,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:44:18.66,0:44:21.16,Default,,0,0,0,,Бұл қаладан қашып кет
Dialogue: 0,0:44:21.16,0:44:24.07,Default,,0,0,0,,Балалар, сендер неге Шисканың мейіріміне төбелесесіңдер?
Dialogue: 0,0:44:24.07,0:44:26.77,Default,,0,0,0,,Оған көмектесу мүмкін емес!
Dialogue: 0,0:44:30.17,0:44:34.84,Default,,0,0,0,,Бұл жігіттердің барлығы Шисканың кепілінде.
Dialogue: 0,0:44:34.84,0:44:39.78,Default,,0,0,0,,Кепілге алынған ба? Әй, мына қария дұрыс айтады.
Dialogue: 0,0:44:39.78,0:44:44.15,Default,,0,0,0,,Менің ұлым бар, ол небәрі 2 жаста.
Dialogue: 0,0:44:44.15,0:44:47.35,Default,,0,0,0,,Бұл өте сүйкімді! Қарғыс атсын!
Dialogue: 0,0:44:53.86,0:44:58.10,Default,,0,0,0,,Екеуміз де ұрысып жатырмыз, солай ма? Сіз оны ертерек көрдіңіз, солай ма?
Dialogue: 0,0:44:58.10,0:45:00.04,Default,,0,0,0,,Құдық айналасындағылардың бәрі уланып өлді.
Dialogue: 0,0:45:00.04,0:45:03.37,Default,,0,0,0,,Ештеңе жасамасаң, өлтіресің, Дэн...
Dialogue: 0,0:45:03.37,0:45:07.24,Default,,0,0,0,,Қашып кетсең де, ештеңені қорғай алмайсың; саған ешкім көмектеспейді.
Dialogue: 0,0:45:07.24,0:45:11.24,Default,,0,0,0,,Олай болса шайқас! Егер сіз мұны жасамасаңыз, сіз ештеңені қорғай алмайсыз!
Dialogue: 0,0:45:56.63,0:46:00.23,Default,,0,0,0,,Әлі емес... бірақ
Dialogue: 0,0:46:05.20,0:46:07.40,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:46:10.34,0:46:12.71,Default,,0,0,0,,Шисканы өлтіріңіз
Dialogue: 0,0:46:12.71,0:46:19.92,Default,,0,0,0,,Мұндай денемен мүмкін емес, ал СС оны қоршап тұр.
Dialogue: 0,0:46:19.92,0:46:24.32,Default,,0,0,0,,Бірақ менде осы ғана!
Dialogue: 0,0:46:24.32,0:46:28.49,Default,,0,0,0,,Кеудедегі сол жараның кесірінен меридиандарыңыз бұзылған.
Dialogue: 0,0:46:28.49,0:46:31.39,Default,,0,0,0,,Qi жеткіліксіз
Dialogue: 0,0:46:31.39,0:46:37.13,Default,,0,0,0,,Құпия меридианды соғып, оған бірден қарқынды энергия құю керек.
Dialogue: 0,0:46:37.13,0:46:41.97,Default,,0,0,0,,Хокуто Шинкен дәрменсіз, өкінішке орай, сіз қазірсіз
Dialogue: 0,0:46:41.97,0:46:45.61,Default,,0,0,0,,Егер сіз жәй ғана жарақат алған адам болсаңыз, неге бұлай етесіз?
Dialogue: 0,0:46:45.61,0:46:50.45,Default,,0,0,0,,Жүрегіңді жаралап, Юрияны ұрлап кеткен Шинге.
Dialogue: 0,0:46:50.45,0:46:56.95,Default,,0,0,0,,Нанто Кошукенді саған сыйлаған адам! Не?! ? Олай болса, Шин ұстаз! ?
Dialogue: 0,0:46:56.95,0:47:02.59,Default,,0,0,0,,Аа, дұрыс, бірақ қазір қарт адам.
Dialogue: 0,0:47:02.59,0:47:11.30,Default,,0,0,0,,Мен Нанто Коушукенді Шинге тапсырған соң, ол екі аяғымның сіңірін кесіп тастады.
Dialogue: 0,0:47:11.30,0:47:17.51,Default,,0,0,0,,Ол өзінің ашкөздігіне беріліп, сүйікті Юлияны ұрлап кетті.
Dialogue: 0,0:47:17.51,0:47:21.38,Default,,0,0,0,,Дегенмен, қазір рұқсат етілген уақыт.
Dialogue: 0,0:47:21.38,0:47:26.02,Default,,0,0,0,,Нанто көтеріліске шыққанда Хокуто пайда болады дейді.
Dialogue: 0,0:47:26.02,0:47:32.89,Default,,0,0,0,,Кенширо, сенің тағдырың осы зорлық-зомбылық дәуірін аяқтау.
Dialogue: 0,0:47:32.89,0:47:36.59,Default,,0,0,0,,Енді қашпа, біз үшін алаңдама.
Dialogue: 0,0:47:36.59,0:47:40.16,Default,,0,0,0,,Мұнда өлме, мейірімсіз бол
Dialogue: 0,0:47:40.16,0:47:44.16,Default,,0,0,0,,Үлкен тапсырманы орындау үшін аяусыз болыңыз.
Dialogue: 0,0:47:46.04,0:47:50.27,Default,,0,0,0,,Мен мұны істей алмаймын!
Dialogue: 0,0:47:50.27,0:47:53.18,Default,,0,0,0,,Шөл далада бір отбасы құтқарды
Dialogue: 0,0:47:53.18,0:47:58.01,Default,,0,0,0,,Себебі аспан сені тірі қалдыруға тырысады.
Dialogue: 0,0:47:58.01,0:48:01.88,Default,,0,0,0,,Бұл нені білдіретінін білмейсіз бе? Мен білмеймін!
Dialogue: 0,0:48:01.88,0:48:05.76,Default,,0,0,0,,Бірақ оны өлтірсең, ешкім соғыспайды.
Dialogue: 0,0:48:05.76,0:48:08.06,Default,,0,0,0,,Бұл анық.
Dialogue: 0,0:48:10.53,0:48:14.43,Default,,0,0,0,,Тәтті, тәтті...
Dialogue: 0,0:48:23.61,0:48:25.61,Default,,0,0,0,,Кенширо...
Dialogue: 0,0:49:11.65,0:49:15.65,Default,,0,0,0,,Осы кісінің, осындай адамның арқасында
Dialogue: 0,0:49:24.83,0:49:30.11,Default,,0,0,0,,Уф, бұл қорқынышты. Мен тіпті ұйықтай алмаймын.
Dialogue: 0,0:49:30.11,0:49:33.91,Default,,0,0,0,,Сіз Гурман және мына қасқыр өлтіруші емессіз бе?
Dialogue: 0,0:49:33.91,0:49:37.48,Default,,0,0,0,,Ол тіпті мені өлтіруіңді сұрады ма?
Dialogue: 0,0:49:37.48,0:49:40.68,Default,,0,0,0,,Гурума маңызды емес, сіз өлгенше
Dialogue: 0,0:49:40.68,0:49:45.19,Default,,0,0,0,,Ешкім өлмеуі керек, бар болғаны.
Dialogue: 0,0:49:45.19,0:49:50.06,Default,,0,0,0,,Бәрін құтқару үшін мені өлтіретін сияқты қызық нәрсе айтып тұрсың ба?
Dialogue: 0,0:49:50.06,0:49:53.90,Default,,0,0,0,,Бірақ бұл қате, хаха...
Dialogue: 0,0:49:53.90,0:49:59.30,Default,,0,0,0,,Осыны бассаңыз не болатынын білесіз бе? иә?
Dialogue: 0,0:49:59.30,0:50:03.31,Default,,0,0,0,,Егер сіз осы түймені бассаңыз, жер астындағы кепілге алынғандардың бәріне қол жеткізе аласыз.
Dialogue: 0,0:50:03.31,0:50:06.51,Default,,0,0,0,,Бәрі жарылып кетеді, түсіндің бе?
Dialogue: 0,0:50:06.51,0:50:11.25,Default,,0,0,0,,Оны басқан кезде бәрі дірілдеп өледі.
Dialogue: 0,0:50:11.25,0:50:16.15,Default,,0,0,0,,Бәрі өледі, хехе...
Dialogue: 0,0:50:18.55,0:50:20.65,Default,,0,0,0,,Егер солай болса, сол кезде айтамын.
Dialogue: 0,0:50:22.49,0:50:28.93,Default,,0,0,0,,Хахаха... Осындай тәтті қызбен маған қарсы күресуге қалай дәтің бар?
Dialogue: 0,0:50:28.93,0:50:32.80,Default,,0,0,0,,100 жыл ерте! Нухаха...
Dialogue: 0,0:50:32.80,0:50:35.70,Default,,0,0,0,,Ухахахахаха!
Dialogue: 0,0:50:45.98,0:50:47.98,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:50:50.49,0:50:54.09,Default,,0,0,0,,А, бұл Гурманд пен мына қасқыр өлтіруші емес пе?
Dialogue: 0,0:50:56.09,0:50:59.59,Default,,0,0,0,,Егер бұл шынымен шулы болса ше?
Dialogue: 0,0:51:01.86,0:51:05.16,Default,,0,0,0,,Менің өнімім! О құдайым-ай!
Dialogue: 0,0:51:26.79,0:51:33.30,Default,,0,0,0,,Егер сен де ол сияқты болғың келмесе, генералға тағы бір рет ант бер.
Dialogue: 0,0:51:33.30,0:51:36.20,Default,,0,0,0,,Ол, сен неге бұлай істейсің?
Dialogue: 0,0:51:36.20,0:51:38.43,Default,,0,0,0,,Кенширо жалғыз
Dialogue: 0,0:51:38.43,0:51:42.61,Default,,0,0,0,,Оның үстіне ол сол денені Шисканы өлтіру үшін пайдаланды.
Dialogue: 0,0:51:42.61,0:51:46.01,Default,,0,0,0,,Не! ? Неге олай істедің...
Dialogue: 0,0:51:46.01,0:51:49.28,Default,,0,0,0,,Осылай жасасаң, бәрі құтқарылады.
Dialogue: 0,0:51:49.28,0:51:52.72,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:51:52.72,0:51:58.12,Default,,0,0,0,,Адам тәрізді адамды көрмегелі көп болды.
Dialogue: 0,0:52:33.96,0:52:37.89,Default,,0,0,0,,Кенширо-сан, біз үшін рахмет.
Dialogue: 0,0:52:37.89,0:52:40.06,Default,,0,0,0,,Дан
Dialogue: 0,0:52:40.06,0:52:44.07,Default,,0,0,0,,Мен Жуғай әскерімен соғысамын. Тоқта.
Dialogue: 0,0:52:44.07,0:52:48.44,Default,,0,0,0,,Ештеңе жасамасаң, жау сені де өлтірмейді.
Dialogue: 0,0:52:48.44,0:52:53.11,Default,,0,0,0,,тым кеш. Ана мен Амо кепілге алынды.
Dialogue: 0,0:52:53.11,0:52:55.44,Default,,0,0,0,,Соғыспасақ, екеуміз де өлеміз.
Dialogue: 0,0:52:55.44,0:52:58.64,Default,,0,0,0,,Ши... Шиска!
Dialogue: 0,0:53:14.33,0:53:17.53,Default,,0,0,0,,Қый!
Dialogue: 0,0:53:17.53,0:53:21.34,Default,,0,0,0,,Бұл өте қорқынышты
Dialogue: 0,0:53:21.34,0:53:23.84,Default,,0,0,0,,Сондықтан маған батылдық берші, Кенширо-сан.
Dialogue: 0,0:53:23.84,0:53:26.28,Default,,0,0,0,,Дан…
Dialogue: 0,0:53:26.28,0:53:31.11,Default,,0,0,0,,Менің шын атым Дэнн Кенширо.
Dialogue: 0,0:53:31.11,0:53:34.02,Default,,0,0,0,,Фуген мырза сіз тәтті екенсіз дейді.
Dialogue: 0,0:53:34.02,0:53:37.82,Default,,0,0,0,,Маған Кеншироны сондай ұнайды.
Dialogue: 0,0:53:41.56,0:53:43.56,Default,,0,0,0,,Донн
Dialogue: 0,0:53:50.10,0:53:54.30,Default,,0,0,0,,Енді сіздің кезегіңіз! Мен барлығын қорғаймын!
Dialogue: 0,0:53:56.41,0:54:02.31,Default,,0,0,0,,Донн! Гуаа! Боқ...
Dialogue: 0,0:54:42.85,0:54:45.25,Default,,0,0,0,,Қарт...
Dialogue: 0,0:54:45.25,0:54:49.12,Default,,0,0,0,,Сені қорғай алатын жалғыз мен ғана.
Dialogue: 0,0:54:49.12,0:54:53.03,Default,,0,0,0,,Ал сен мұнда өлмейсің.
Dialogue: 0,0:54:53.03,0:54:55.86,Default,,0,0,0,,Осыны айтып, менің қолымнан келетіні
Dialogue: 0,0:54:55.86,0:55:00.16,Default,,0,0,0,,Құдайға арқа сүйеу сияқты... Неге?
Dialogue: 0,0:55:02.64,0:55:06.14,Default,,0,0,0,,Негізі Джугай да шабуылдап жатыр.
Dialogue: 0,0:55:06.14,0:55:09.08,Default,,0,0,0,,Ол менің шәкіртім болды. Не! ?
Dialogue: 0,0:55:09.08,0:55:13.78,Default,,0,0,0,,Жуғай - ізбасар болу жолынан бас тартқан адам.
Dialogue: 0,0:55:22.99,0:55:26.73,Default,,0,0,0,,Неге бұл адамдар! ? Бұл жігіттер...
Dialogue: 0,0:55:26.73,0:55:30.57,Default,,0,0,0,,Мына жігіттер менің әйелім мен баламды өлтірді!
Dialogue: 0,0:55:30.57,0:55:36.04,Default,,0,0,0,,Тек... бірнеше күндік тамақты ұрлау үшін!
Dialogue: 0,0:55:36.04,0:55:39.58,Default,,0,0,0,,Жугай... Ұстаз.
Dialogue: 0,0:55:39.58,0:55:45.35,Default,,0,0,0,,Сіз маған Нанто Сейкеннің адамдардың өмірін сақтайтын Катсужинкен екенін үйреттіңіз.
Dialogue: 0,0:55:45.35,0:55:48.65,Default,,0,0,0,,Бірақ мен енді ол ілімді ұстана алмаймын.
Dialogue: 0,0:55:48.65,0:55:50.65,Default,,0,0,0,,Мына қанды қолдармен
Dialogue: 0,0:55:52.55,0:55:58.85,Default,,0,0,0,,Бұл дүние – тозақ. Тозақ болса, сезімімді, көз жасымды тастаймын.
Dialogue: 0,0:56:02.66,0:56:07.86,Default,,0,0,0,,Осы жұдырықтармен мен тозақтың иесі боламын.
Dialogue: 0,0:56:17.71,0:56:22.55,Default,,0,0,0,,Шын да, Жуғай да өнері бірдей жақсы шәкірттер еді.
Dialogue: 0,0:56:22.55,0:56:28.19,Default,,0,0,0,,Бұл екеуінің аңға айналуына жол жоқ...
Dialogue: 0,0:56:28.19,0:56:31.59,Default,,0,0,0,,Ешқашан оқыту емес
Dialogue: 0,0:56:39.64,0:56:41.70,Default,,0,0,0,,Дехе дехе Гурума!
Dialogue: 0,0:56:41.70,0:56:45.44,Default,,0,0,0,,Дехе, менің ұраным - өнімді күту.
Dialogue: 0,0:56:45.44,0:56:49.68,Default,,0,0,0,,Хехе, бәріміз саған көмектесеміз деп сөйлестік.
Dialogue: 0,0:56:49.68,0:56:51.68,Default,,0,0,0,,Не! ? сен біз үшінсің
Dialogue: 0,0:56:51.68,0:56:58.39,Default,,0,0,0,,Өміріңді қатерге тіктің, жетеді, мен саған қарыздармын.
Dialogue: 0,0:56:58.39,0:57:01.09,Default,,0,0,0,,Бұл менің ұлым, мен өлгенде
Dialogue: 0,0:57:01.09,0:57:04.49,Default,,0,0,0,,Мынаны менің ұлыма беріңізші.
Dialogue: 0,0:57:04.49,0:57:07.16,Default,,0,0,0,,Оның орнына мен саған жақсы нәрсе үйретемін.
Dialogue: 0,0:57:07.16,0:57:10.63,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:57:10.63,0:57:13.40,Default,,0,0,0,,Бұл қаладан шығудың жолы! Не! ?
Dialogue: 0,0:57:13.40,0:57:16.67,Default,,0,0,0,,Сол жерден қашыңыз. Мен де біреудің ата-анасымын. Мен жын емеспін.
Dialogue: 0,0:57:16.67,0:57:22.18,Default,,0,0,0,,Ал мен бұйымға күтім жасауды айттым ғой, солай ма?
Dialogue: 0,0:57:22.18,0:57:26.62,Default,,0,0,0,,Жарайсың ба? Шығу жолы – сол құлыптың астындағы құрғақ құдық.
Dialogue: 0,0:57:26.62,0:57:32.42,Default,,0,0,0,,Кепілдегілер де сонда, көмектесіңізші. Дехехехе
Dialogue: 0,0:57:32.42,0:57:35.32,Default,,0,0,0,,Уау, бұл қауіпті!
Dialogue: 0,0:57:35.32,0:57:37.82,Default,,0,0,0,,Уау! Гурума!
Dialogue: 0,0:57:42.70,0:57:47.67,Default,,0,0,0,,Құдай-ау, менің тағдырым осы ма?
Dialogue: 0,0:57:47.67,0:57:51.44,Default,,0,0,0,,Құдайдың жазасы келген сияқты.
Dialogue: 0,0:57:51.44,0:57:57.35,Default,,0,0,0,,Кеншираға уәде бер... Гурума!
Dialogue: 0,0:57:57.35,0:58:02.02,Default,,0,0,0,,Кенширо, Аспан сені тірі қалдыруға тырысады.
Dialogue: 0,0:58:02.02,0:58:06.56,Default,,0,0,0,,Сол себепті Гурмаға да, маған да жебе тиді.
Dialogue: 0,0:58:06.56,0:58:10.76,Default,,0,0,0,,Тағдырыңды орындауың үшін
Dialogue: 0,0:58:18.67,0:58:22.17,Default,,0,0,0,,Аспан – мен...
Dialogue: 0,0:58:40.56,0:58:44.29,Default,,0,0,0,,Сіз қоңырау шалып жатырсыз ба? шебері
Dialogue: 0,0:58:44.29,0:58:46.39,Default,,0,0,0,,Кенширо Иә
Dialogue: 0,0:58:52.03,0:58:56.37,Default,,0,0,0,,Мен көктен бір дауыс естідім
Dialogue: 0,0:58:56.37,0:59:01.84,Default,,0,0,0,,Сіз қазір Хокуто Шинкеннің 64-ші мұрагерісіз.
Dialogue: 0,0:59:01.84,0:59:04.08,Default,,0,0,0,,Мастер, жоқ па?
Dialogue: 0,0:59:04.08,0:59:07.02,Default,,0,0,0,,Неліктен Раох немесе Токи емес, мен?
Dialogue: 0,0:59:07.02,0:59:13.36,Default,,0,0,0,,Хмм, дәл қазір Токиді жеңу мүмкін емес.
Dialogue: 0,0:59:13.36,0:59:16.93,Default,,0,0,0,,Раох үшін одан да аз. Сонда неге?
Dialogue: 0,0:59:16.93,0:59:21.83,Default,,0,0,0,,Кенширо, сен үмітсіз адамсың.
Dialogue: 0,0:59:21.83,0:59:24.53,Default,,0,0,0,,Оның мінезі тәтті
Dialogue: 0,0:59:24.53,0:59:28.73,Default,,0,0,0,,Мына Рюкеннің жақсы екені сонша, мен оған қарауды тоқтата алмаймын...
Dialogue: 0,0:59:34.88,0:59:39.31,Default,,0,0,0,,Я, жақсы, ха...
Dialogue: 0,0:59:39.31,0:59:44.49,Default,,0,0,0,,Кенширо, Хокуто Шинкен - өлім құдайының жұдырығы.
Dialogue: 0,0:59:44.49,0:59:50.66,Default,,0,0,0,,Қасқыр адам жеке себептермен адамдарды өлтірмейді, сондықтан оның шынайы табиғаты
Dialogue: 0,0:59:50.66,0:59:53.96,Default,,0,0,0,,Нағыз адам болуы керек
Dialogue: 0,0:59:53.96,1:00:01.30,Default,,0,0,0,,Менмендіктің, қызғаныштың, өшпенділіктің және жердегі қалаулардың кесірінен адамдарды өлтіру - сиқырлық!
Dialogue: 0,1:00:01.30,1:00:08.48,Default,,0,0,0,,Тәңірдің бұйрығын естіп, жан-жануарларды құтқару үшін, Қасқыр мейірімсіз өлтіреді.
Dialogue: 0,1:00:08.48,1:00:12.78,Default,,0,0,0,,Басқалар үшін адамдарды өлтірме
Dialogue: 0,1:00:12.78,1:00:17.32,Default,,0,0,0,,Хехехе... Қасқыр болуды жалғастырыңыз
Dialogue: 0,1:00:17.32,1:00:21.12,Default,,0,0,0,,Адам болып қалу қиын.
Dialogue: 0,1:00:21.12,1:00:26.32,Default,,0,0,0,,Бірақ бұл жүкті тек сен ғана көтере аласың.
Dialogue: 0,1:00:28.36,1:00:32.26,Default,,0,0,0,,Бұл мен естіген аспанның дауысы
Dialogue: 0,1:00:39.61,1:00:42.61,Default,,0,0,0,,Аспан, Солтүстік жұлдыз
Dialogue: 0,1:00:42.61,1:00:46.31,Default,,0,0,0,,Кешіріңізші, мен енді білемін.
Dialogue: 0,1:00:46.31,1:00:51.25,Default,,0,0,0,,Хокуто тағдыры, менің ізбасарларымның тағдыры
Dialogue: 0,1:00:51.25,1:00:54.15,Default,,0,0,0,,Қайғылыларға арналған дұғалар
Dialogue: 0,1:01:01.83,1:01:05.23,Default,,0,0,0,,Нууах!
Dialogue: 0,1:01:12.14,1:01:14.24,Default,,0,0,0,,Ооооо!
Dialogue: 0,1:01:19.65,1:01:25.55,Default,,0,0,0,,О! Аспан! Аспан Кеншираға күш береді!
Dialogue: 0,1:02:07.63,1:02:09.56,Default,,0,0,0,,Уау!
Dialogue: 0,1:02:09.56,1:02:12.57,Default,,0,0,0,,Хе хе хе...
Dialogue: 0,1:02:12.57,1:02:16.77,Default,,0,0,0,,Аюды өлтір! Әй, мен Жуғай әскеріне қосылдым.
Dialogue: 0,1:02:16.77,1:02:20.28,Default,,0,0,0,,Өкінішті, сендер өліңдер!
Dialogue: 0,1:02:20.28,1:02:23.91,Default,,0,0,0,,Уау!
Dialogue: 0,1:02:23.91,1:02:26.01,Default,,0,0,0,,Әй?
Dialogue: 0,1:02:35.96,1:02:40.16,Default,,0,0,0,,Ей, мына бейбақ әлі тірі!
Dialogue: 0,1:02:40.16,1:02:43.66,Default,,0,0,0,,Осы жолы өл!
Dialogue: 0,1:02:45.87,1:02:47.94,Default,,0,0,0,,Әй?
Dialogue: 0,1:02:47.94,1:02:51.77,Default,,0,0,0,,Не? Қайта қозғалмайды
Dialogue: 0,1:02:51.77,1:02:54.21,Default,,0,0,0,,О?
Dialogue: 0,1:02:54.21,1:02:57.08,Default,,0,0,0,,Уф... Уау!
Dialogue: 0,1:02:57.08,1:02:59.28,Default,,0,0,0,,Бля саған! Апыр-ай!
Dialogue: 0,1:03:03.92,1:03:07.19,Default,,0,0,0,,Кенширо-сан
Dialogue: 0,1:03:07.19,1:03:11.53,Default,,0,0,0,,Дэн мені сен оқыттың.
Dialogue: 0,1:03:11.53,1:03:14.50,Default,,0,0,0,,Менің тағдырым
Dialogue: 0,1:03:14.50,1:03:18.30,Default,,0,0,0,,Халық дұғалары Кенширо
Dialogue: 0,1:03:29.91,1:03:33.15,Default,,0,0,0,,Мен бұл Джугай екеніне сенімдімін
Dialogue: 0,1:03:33.15,1:03:37.69,Default,,0,0,0,,Қайда? мен әрқашан сенімен біргемін
Dialogue: 0,1:03:37.69,1:03:41.62,Default,,0,0,0,,Ал күрес, бұл аспанның үні
Dialogue: 0,1:03:41.62,1:03:44.02,Default,,0,0,0,,Жалғыз...
Dialogue: 0,1:03:57.87,1:04:01.74,Default,,0,0,0,,Не? Әлгі бейбақ бомба жасырып тұрған жоқ па?
Dialogue: 0,1:04:01.74,1:04:05.75,Default,,0,0,0,,Ол қасқыр өлтіруші ғой, солай емес пе? Ол жалғыз өзі не істемек?
Dialogue: 0,1:04:05.75,1:04:07.75,Default,,0,0,0,,Кенширо-сан
Dialogue: 0,1:04:11.09,1:04:13.62,Default,,0,0,0,,Мына жекпе-жекті қара!
Dialogue: 0,1:04:13.62,1:04:17.53,Default,,0,0,0,,Он мың әскер болса да, біз жау емеспіз.
Dialogue: 0,1:04:17.53,1:04:23.93,Default,,0,0,0,,Ол біздің құтқарушымыз болатын адам.
Dialogue: 0,1:04:23.93,1:04:28.77,Default,,0,0,0,,Шегін, Жуғай, шегіну керек. Мен сенің қарсыласыңмын.
Dialogue: 0,1:04:28.77,1:04:32.27,Default,,0,0,0,,Сен ақымақсың ба? Мен мұны жалғыз жасай аламын
Dialogue: 0,1:04:32.27,1:04:35.97,Default,,0,0,0,,Жебені атып, оны кірпіге айналдыр.
Dialogue: 0,1:04:40.98,1:04:43.35,Default,,0,0,0,,Ха!
Dialogue: 0,1:04:43.35,1:04:46.39,Default,,0,0,0,,Хмм... Бұл әдіс екі саусақпен вакуумды ұстау.
Dialogue: 0,1:04:46.39,1:04:50.13,Default,,0,0,0,,Біздің Жуғай әскеріне қарсы тұруға ниетіңіз бар ма?
Dialogue: 0,1:04:50.13,1:04:53.96,Default,,0,0,0,,Мен Гедоның дауысын естімеймін.
Dialogue: 0,1:04:53.96,1:04:57.70,Default,,0,0,0,,Кім өлгісі келсе, алға шығу керек.
Dialogue: 0,1:04:57.70,1:05:00.70,Default,,0,0,0,,Кеттік! Апыр-ай!
Dialogue: 0,1:05:02.54,1:05:05.44,Default,,0,0,0,,Құдай, Кенширо-санды сақта.
Dialogue: 0,1:05:18.02,1:05:20.92,Default,,0,0,0,,Ол қайда! ?
Dialogue: 0,1:05:20.92,1:05:24.62,Default,,0,0,0,,Болды! Уа!
Dialogue: 0,1:05:35.14,1:05:38.14,Default,,0,0,0,,Керемет! Ақыр соңында, бұл супер машина болды.
Dialogue: 0,1:05:44.81,1:05:49.25,Default,,0,0,0,,Оның аспанға қашып кетуіне жол берме! Найза бөлімі, оны құлат!
Dialogue: 0,1:05:49.25,1:05:52.95,Default,,0,0,0,,Сәлем! Апыр-ай!
Dialogue: 0,1:05:55.02,1:05:57.12,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:05:59.86,1:06:03.77,Default,,0,0,0,,Артқа! Ақымақ, білмей тұрып! ?
Dialogue: 0,1:06:03.77,1:06:13.88,Default,,0,0,0,,Атататата…
Dialogue: 0,1:06:13.88,1:06:16.68,Default,,0,0,0,,Атта!
Dialogue: 0,1:06:21.95,1:06:24.75,Default,,0,0,0,,Бұл меридиандық техниканың қандай түрі?
Dialogue: 0,1:06:24.75,1:06:28.69,Default,,0,0,0,,Олар Кеншироның қимылдарын анықтай алмайды.
Dialogue: 0,1:06:28.69,1:06:32.93,Default,,0,0,0,,Найзалардың пайдасы жоқ, Кенширо-сан.
Dialogue: 0,1:06:32.93,1:06:38.83,Default,,0,0,0,,Кенширо - соңғы өлтіру жұдырығы Хокуто Шинкеннің мұрагері.
Dialogue: 0,1:06:38.83,1:06:40.83,Default,,0,0,0,,Хокуто Шинкен...
Dialogue: 0,1:06:44.54,1:06:47.48,Default,,0,0,0,,Мазасыз, бірден кел.
Dialogue: 0,1:06:47.48,1:06:50.18,Default,,0,0,0,,Жалғастырыңыз! Оны қоршаңыз!
Dialogue: 0,1:07:37.19,1:07:42.29,Default,,0,0,0,,Кенширо... Хокуто Шинкеннің мұрагері Кенширо!
Dialogue: 0,1:07:48.27,1:07:54.48,Default,,0,0,0,,Жақсы, қасқыр өлтіруші! Уақыты келгенде күресіңіз...
Dialogue: 0,1:07:54.48,1:07:58.08,Default,,0,0,0,,Хехехе...
Dialogue: 0,1:08:01.25,1:08:03.18,Default,,0,0,0,,Бізде бұл бар.
Dialogue: 0,1:08:03.18,1:08:06.62,Default,,0,0,0,,Бұл жігіт бәрін тозаққа апарады!
Dialogue: 0,1:08:06.62,1:08:10.12,Default,,0,0,0,,Nu! ? аа!
Dialogue: 0,1:08:15.40,1:08:19.90,Default,,0,0,0,,Сіз! ? Ақыры басқасын таптым.
Dialogue: 0,1:08:19.90,1:08:23.77,Default,,0,0,0,,Не? Тағы біреуі ше? О
Dialogue: 0,1:08:23.77,1:08:27.54,Default,,0,0,0,,Маған біріншісі қайда екенін айтты.
Dialogue: 0,1:08:27.54,1:08:31.64,Default,,0,0,0,,Бұл... кімге? о?
Dialogue: 0,1:08:34.18,1:08:36.52,Default,,0,0,0,,Сіз...
Dialogue: 0,1:08:36.52,1:08:39.42,Default,,0,0,0,,Мен енді сізге жазыла алмаймын.
Dialogue: 0,1:08:39.42,1:08:42.12,Default,,0,0,0,,Сен маған опасыздық жасадың ба?
Dialogue: 0,1:08:42.12,1:08:46.22,Default,,0,0,0,,Жугай қожайын менің отбасымды қайтаруға уәде берді.
Dialogue: 0,1:08:48.36,1:08:50.90,Default,,0,0,0,,Дұрыс, бұл жаман.
Dialogue: 0,1:08:50.90,1:08:55.34,Default,,0,0,0,,Енді жүйені іске қосу үшін құпия сөзді айтыңыз.
Dialogue: 0,1:08:55.34,1:08:59.14,Default,,0,0,0,,Сіздің аман қалуыңыздың жалғыз жолы – оқыту.
Dialogue: 0,1:09:10.62,1:09:14.39,Default,,0,0,0,,E… MOMO0328
Dialogue: 0,1:09:14.39,1:09:20.86,Default,,0,0,0,,MOMO? Момо... Қайтыс болған қызының аты мен туған күні.
Dialogue: 0,1:09:20.86,1:09:26.86,Default,,0,0,0,,Иә, бұл тамаша! Апыр-ай!
Dialogue: 0,1:09:29.97,1:09:34.61,Default,,0,0,0,,Ах! Ой... аа...
Dialogue: 0,1:09:34.61,1:09:38.48,Default,,0,0,0,,О... сен уәде бердің.
Dialogue: 0,1:09:38.48,1:09:42.42,Default,,0,0,0,,Бұл дүниеде уәде сияқты сенімсіз ештеңе жоқ.
Dialogue: 0,1:09:42.42,1:09:45.92,Default,,0,0,0,,Дұрыс па? Гаха!
Dialogue: 0,1:10:00.84,1:10:06.04,Default,,0,0,0,,Оны Джугай мырзаға жеткізіңіз. Бұл қала енді Джугай мырзаға тиесілі.
Dialogue: 0,1:10:15.38,1:10:19.55,Default,,0,0,0,,Сіз Хокуто Шинкеннің мұрагері Кенширосыз ба?
Dialogue: 0,1:10:19.55,1:10:23.79,Default,,0,0,0,,Кет, бекер өлесің.
Dialogue: 0,1:10:23.79,1:10:29.13,Default,,0,0,0,,Қалайша бастық боласың, жұдырығың әйелді ұрлап алды?
Dialogue: 0,1:10:29.13,1:10:33.53,Default,,0,0,0,,Бұл мен үшін жұмыс істейді деп ойлайсыз ба? ?
Dialogue: 0,1:10:33.53,1:10:36.23,Default,,0,0,0,,Ааа!
Dialogue: 0,1:10:45.85,1:10:47.95,Default,,0,0,0,,Жалғыз қыран жұдырықтың тырнағынан кейін
Dialogue: 0,1:10:49.75,1:10:54.19,Default,,0,0,0,,Келесі жолы мен сені ішегіңе дейін ойып жіберемін.
Dialogue: 0,1:10:54.19,1:10:57.13,Default,,0,0,0,,Уау! Өте әдемі!
Dialogue: 0,1:10:57.13,1:11:01.56,Default,,0,0,0,,Билік – әділдік. Бұл жақсы уақыттар.
Dialogue: 0,1:11:01.56,1:11:06.43,Default,,0,0,0,,Мықтылар ойланбастан қалағанын алады.
Dialogue: 0,1:11:06.43,1:11:09.97,Default,,0,0,0,,Сіз мені жеңе алмайсыз.
Dialogue: 0,1:11:09.97,1:11:16.51,Default,,0,0,0,,Сіз бен менің арамызда өлімге әкелетін айырмашылық бар, ол - қалау мен құмарлық.
Dialogue: 0,1:11:16.51,1:11:20.91,Default,,0,0,0,,Қалау күшке жетелейді. Сізде ол жоқ!
Dialogue: 0,1:11:22.88,1:11:27.22,Default,,0,0,0,,Еріксіз қалаудың соңында күтетін нәрсе - жоқтық
Dialogue: 0,1:11:27.22,1:11:32.03,Default,,0,0,0,,Бұл ешкімді бақытты ете алмайды
Dialogue: 0,1:11:32.03,1:11:35.83,Default,,0,0,0,,Бұл тәтті!
Dialogue: 0,1:11:35.83,1:11:39.33,Default,,0,0,0,,Атааа! Нанто Гоку Тоукен!
Dialogue: 0,1:12:12.47,1:12:15.74,Default,,0,0,0,,Кенширо-сан!
Dialogue: 0,1:12:15.74,1:12:19.07,Default,,0,0,0,,Қ-не істеймін! Оны қағып кеттім!
Dialogue: 0,1:12:19.07,1:12:22.51,Default,,0,0,0,,…баланың санасына ықпал ету үшін миына енгізілген
Dialogue: 0,1:12:22.51,1:12:27.01,Default,,0,0,0,,Неге! ? Мен неге Шинмен теңмін? ?
Dialogue: 0,1:12:27.01,1:12:30.65,Default,,0,0,0,,Аспан сені жеңді.
Dialogue: 0,1:12:30.65,1:12:35.42,Default,,0,0,0,,Мен жай ғана тағдырыма еріп, теңдесі жоқ жұдырығымды сермеп отырмын.
Dialogue: 0,1:12:35.42,1:12:39.32,Default,,0,0,0,,Бұл қызық.
Dialogue: 0,1:12:46.07,1:12:49.44,Default,,0,0,0,,Бұл не? Сиска өлді
Dialogue: 0,1:12:49.44,1:12:52.34,Default,,0,0,0,,Бұл қамалдың жарылғыш пульті.
Dialogue: 0,1:12:52.34,1:12:56.71,Default,,0,0,0,,Мен саған бұл қаланы беремін, Жуғай.
Dialogue: 0,1:12:56.71,1:13:02.12,Default,,0,0,0,,Жамандықтың иісі жоқ, бар болғаны.
Dialogue: 0,1:13:02.12,1:13:07.92,Default,,0,0,0,,Неге екені белгісіз, баяғы жақсы күндердей сағыныш иісі аңқиды.
Dialogue: 0,1:13:07.92,1:13:12.23,Default,,0,0,0,,Тыңда, оның орнына маған көрсет.
Dialogue: 0,1:13:12.23,1:13:16.10,Default,,0,0,0,,Бұл тәттілік қаншалықты алысқа барады?
Dialogue: 0,1:13:16.10,1:13:20.50,Default,,0,0,0,,Менмін, тозақтың түбіненмін
Dialogue: 0,1:13:20.50,1:13:23.10,Default,,0,0,0,,Маған қарап көрейін.
Dialogue: 0,1:13:31.55,1:13:34.88,Default,,0,0,0,,Жугай…
Dialogue: 0,1:13:34.88,1:13:37.69,Default,,0,0,0,,Қаш! Ол құбыжық!
Dialogue: 0,1:13:37.69,1:13:42.22,Default,,0,0,0,,Біз мұны жасадық! Барлығы босатылады! Кепілге алынғандар қамалдың жертөлесінде!
Dialogue: 0,1:13:42.22,1:13:44.32,Default,,0,0,0,,Сіз өз отбасыңызды кездестіре аласыз!
Dialogue: 0,1:13:58.61,1:14:02.31,Default,,0,0,0,,Дан! иә
Dialogue: 0,1:14:02.31,1:14:05.61,Default,,0,0,0,,Рахмет, Кенширо-сан!
Dialogue: 0,1:14:13.49,1:14:17.79,Default,,0,0,0,,Ихахаха…
Dialogue: 0,1:14:17.79,1:14:21.63,Default,,0,0,0,,Қашықтан басқару пульті жалғыз түйме емес!
Dialogue: 0,1:14:21.63,1:14:26.17,Default,,0,0,0,,Мен бұл қаланы ешкімге... ешкімге бермеймін!
Dialogue: 0,1:14:26.17,1:14:31.87,Default,,0,0,0,,Хехехе...
Dialogue: 0,1:14:31.87,1:14:38.27,Default,,0,0,0,,Мен, бұл мен! Мен оны тозаққа апарамын!
Dialogue: 0,1:14:43.58,1:14:46.78,Default,,0,0,0,,Иә? не! ?
Dialogue: 0,1:15:04.74,1:15:06.94,Default,,0,0,0,,(Әйел) Жолдасым! Арбадағы әйел өліп қалды, бірақ➡
Dialogue: 0,1:16:02.60,1:16:06.30,Default,,0,0,0,,Бұл... неге...
Dialogue: 0,1:16:21.92,1:16:24.95,Default,,0,0,0,,Қария!
Dialogue: 0,1:16:24.95,1:16:30.56,Default,,0,0,0,,Ке... Кенширо Қарт!
Dialogue: 0,1:16:30.56,1:16:37.16,Default,,0,0,0,,Кенширо Көз жасы түкке тұрғысыз, өлімді жеңейік.
Dialogue: 0,1:16:37.16,1:16:42.44,Default,,0,0,0,,Біздің қалағанымыз осы
Dialogue: 0,1:16:42.44,1:16:47.24,Default,,0,0,0,,Қайғымыз бен дұғамызды жүрегімізге ойып ал
Dialogue: 0,1:16:47.24,1:16:52.61,Default,,0,0,0,,Олай болсаң, біз сенің қалқаныңа айналамыз.
Dialogue: 0,1:16:52.61,1:16:55.52,Default,,0,0,0,,Менің қалқаным үшін бе? Бұл дұрыс
Dialogue: 0,1:16:55.52,1:17:00.76,Default,,0,0,0,,Мұңды көтеру деген осы.
Dialogue: 0,1:17:00.76,1:17:08.46,Default,,0,0,0,,Барыңыз, бізді қалқаныңыз ретінде пайдаланыңыз және Құтқарушының жолымен жүріңіз ...
Dialogue: 0,1:17:17.20,1:17:22.60,Default,,0,0,0,,Барлығы менің қалқаным
Dialogue: 0,1:17:42.86,1:17:45.96,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,1:18:33.88,1:18:41.36,Default,,0,0,0,,Қаладан әрі қарай күн батып бара жатыр
Dialogue: 0,1:18:41.36,1:18:46.36,Default,,0,0,0,,Кешті күткен жұлдыз пайда болады
Dialogue: 0,1:18:48.20,1:18:55.87,Default,,0,0,0,,Аспан кешегідей болса да
Dialogue: 0,1:18:55.87,1:19:00.37,Default,,0,0,0,,Өліп бара жатқан осы жүрек пе?
Dialogue: 0,1:19:02.51,1:19:09.78,Default,,0,0,0,,Тесілген ауру мен түпсіз қараңғылық
Dialogue: 0,1:19:09.78,1:19:17.06,Default,,0,0,0,,Мен оны анық сезсем де, махаббат тербеледі
Dialogue: 0,1:19:17.06,1:19:24.13,Default,,0,0,0,,Жүз жылдық жалғыздыққа түскендер.
Dialogue: 0,1:19:24.13,1:19:30.91,Default,,0,0,0,,Мұңды сезінгенде, махаббат күшейе түседі
Dialogue: 0,1:19:30.91,1:19:40.58,Default,,0,0,0,,Көптеген өмірлер қазір де жылап туады.
Dialogue: 0,1:19:40.58,1:19:47.78,Default,,0,0,0,,Көздеріңде нұр
Dialogue: 0,1:20:02.84,1:20:10.48,Default,,0,0,0,,Бейбітшілік іздеген күндер әлі ұзақ
Dialogue: 0,1:20:10.48,1:20:15.48,Default,,0,0,0,,Қақтығыс болмай қоймайды
Dialogue: 0,1:20:17.35,1:20:24.99,Default,,0,0,0,,Үмітсіздік пен ашумен күресу
Dialogue: 0,1:20:24.99,1:20:31.63,Default,,0,0,0,,Жақында келер дәрменсіздік?
Dialogue: 0,1:20:31.63,1:20:38.87,Default,,0,0,0,,Мен өзім үшін маңызды адамды жоғалтқым келмейді
Dialogue: 0,1:20:38.87,1:20:46.11,Default,,0,0,0,,Махаббат сараңдыққа айналады, бұрмалайды, адасады
Dialogue: 0,1:20:46.11,1:20:53.22,Default,,0,0,0,,Жүз жыл оңаша өмір сүргендер
Dialogue: 0,1:20:53.22,1:20:59.96,Default,,0,0,0,,Әділдік уақыт өте келе пішінін өзгертеді.
Dialogue: 0,1:20:59.96,1:21:09.67,Default,,0,0,0,,Ұзақ мұңды қараңғы түнге кір келтірме
Dialogue: 0,1:21:09.67,1:21:16.77,Default,,0,0,0,,Жұлдыздар, әлі де жарқырайды
Dialogue: 0,1:21:46.17,1:21:53.08,Default,,0,0,0,,Жүз жылдық жалғыздыққа түскендер.
Dialogue: 0,1:21:53.08,1:22:00.02,Default,,0,0,0,,Мұңды сезінгенде, махаббат күшейе түседі
Dialogue: 0,1:22:00.02,1:22:09.63,Default,,0,0,0,,Көптеген өмірлер қазір де жылап туады.
Dialogue: 0,1:22:09.63,1:22:16.17,Default,,0,0,0,,Көздеріңде нұр
Dialogue: 0,1:22:16.17,1:22:20.57,Default,,0,0,0,,Жарық
Dialogue: 0,1:27:39.36,1:27:45.63,Default,,0,0,0,,Мына баланы жібер! ? досымды кім жасады
Dialogue: 0,1:27:45.63,1:27:48.54,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,1:27:48.54,1:27:54.74,Default,,0,0,0,,Атататата... Ататата!
Dialogue: 0,1:27:58.21,1:28:00.81,Default,,0,0,0,,Хокуто Хякурикен
Dialogue: 0,1:28:00.81,1:28:05.62,Default,,0,0,0,,Не! ? Сіздің жұдырығыңыз масалардан тиімді емес.
Dialogue: 0,1:28:05.62,1:28:07.72,Default,,0,0,0,,(Тодороки) Мен сол жігіттен барынша көп нәрсе үйренгім келеді
Dialogue: 0,1:28:09.52,1:28:11.82,Default,,0,0,0,,Сіз әлдеқашан өлдіңіз
Dialogue: 0,1:28:13.32,1:28:19.32,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
