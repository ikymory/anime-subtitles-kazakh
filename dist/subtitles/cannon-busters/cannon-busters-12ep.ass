Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.01,0:00:16.93,Default,,0,0,0,,‪♪～
Dialogue: 0,0:01:35.80,0:01:40.97,Default,,0,0,0,,‪～♪
Dialogue: 0,0:01:41.81,0:01:44.47,Default,,0,0,0,,Ммм...
Dialogue: 0,0:01:44.77,0:01:46.27,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:46.35,0:01:47.56,Default,,0,0,0,,Кууууууу
Dialogue: 0,0:01:47.81,0:01:49.23,Default,,0,0,0,,Сол ақымақ ханзада-
Dialogue: 0,0:01:49.31,0:01:50.77,Default,,0,0,0,,Мені қажетсіз қиындыққа ұшыратпаңыз.
Dialogue: 0,0:01:51.36,0:01:53.98,Default,,0,0,0,,Енді мен өлемін.
Dialogue: 0,0:01:54.57,0:01:58.11,Default,,0,0,0,,Мына ақымақ оның дауысы анық екенін біле ме?
Dialogue: 0,0:01:58.20,0:01:59.95,Default,,0,0,0,,Сіз естідіңіз бе? ханзада
Dialogue: 0,0:02:00.03,0:02:03.20,Default,,0,0,0,,Атышулы іздеуде жүрген адам сені қуып келеді.
Dialogue: 0,0:02:03.70,0:02:07.41,Default,,0,0,0,,Бізбен қауіпсіз болғаныңыз жақсы.
Dialogue: 0,0:02:07.83,0:02:11.54,Default,,0,0,0,,Жарайды, ол жігіттің қолына түскеннен жақсы.
Dialogue: 0,0:02:11.63,0:02:14.13,Default,,0,0,0,,Өйткені мен сені тірідей жеткізуге уәде беремін.
Dialogue: 0,0:02:14.59,0:02:18.22,Default,,0,0,0,,(Келби) Өтірік айтпа! Ей, қанішер жауыздар!
Dialogue: 0,0:02:18.63,0:02:21.39,Default,,0,0,0,,Иә, өлтіруші, әрқашан.
Dialogue: 0,0:02:21.97,0:02:24.51,Default,,0,0,0,,Бірақ бұл жұмыс ерекше.
Dialogue: 0,0:02:24.60,0:02:27.23,Default,,0,0,0,,Мені қатты толқытпаңыз
Dialogue: 0,0:02:27.31,0:02:30.40,Default,,0,0,0,,Менің қолым абайсызда сырғып, денем баяу...
Dialogue: 0,0:02:30.48,0:02:33.61,Default,,0,0,0,,Сіз оны үлкен ет тілімдерімен кесуіңіз мүмкін.
Dialogue: 0,0:02:34.11,0:02:35.73,Default,,0,0,0,,Жоғал!
Dialogue: 0,0:02:35.82,0:02:40.49,Default,,0,0,0,,(Филли) Ахх, саусағым жұлынып қалды~
Dialogue: 0,0:02:41.11,0:02:42.66,Default,,0,0,0,,Фили!
Dialogue: 0,0:02:44.03,0:02:46.41,Default,,0,0,0,,Ахххх...
Dialogue: 0,0:02:49.41,0:02:50.21,Default,,0,0,0,,(Один) Ах...
Dialogue: 0,0:02:52.29,0:02:53.38,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:55.67,0:02:56.30,Default,,0,0,0,,Уф
Dialogue: 0,0:02:57.34,0:02:58.92,Default,,0,0,0,,Ах! (Один) Иә!
Dialogue: 0,0:03:02.76,0:03:03.30,Default,,0,0,0,,Га
Dialogue: 0,0:03:05.26,0:03:05.85,Default,,0,0,0,,Ах
Dialogue: 0,0:03:15.36,0:03:15.90,Default,,0,0,0,,Уф
Dialogue: 0,0:03:18.53,0:03:19.53,Default,,0,0,0,,Ах
Dialogue: 0,0:03:20.03,0:03:21.91,Default,,0,0,0,,Неғұрлым мас болсаң, соғұрлым күшті боласың...
Dialogue: 0,0:03:21.99,0:03:22.99,Default,,0,0,0,,Мен мұны айттым ба?
Dialogue: 0,0:03:23.07,0:03:23.91,Default,,0,0,0,,Нуаааааааааа!
Dialogue: 0,0:03:26.83,0:03:27.87,Default,,0,0,0,,Уф
Dialogue: 0,0:03:28.12,0:03:30.33,Default,,0,0,0,,Сыраның қалғаны қайда?
Dialogue: 0,0:03:30.87,0:03:32.75,Default,,0,0,0,,Шынайы жауап беріңіз
Dialogue: 0,0:03:32.83,0:03:35.46,Default,,0,0,0,,Спирттің бар-жоғын иісінен білуге болады.
Dialogue: 0,0:03:35.71,0:03:38.46,Default,,0,0,0,,Кууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:03:38.55,0:03:40.92,Default,,0,0,0,,Ахх... уһ уһ
Dialogue: 0,0:03:41.30,0:03:44.14,Default,,0,0,0,,Бодика балам, мен сені қашып кетуге ешқашан жол бермеймін.
Dialogue: 0,0:03:44.59,0:03:46.68,Default,,0,0,0,,Ол құлады ма?
Dialogue: 0,0:03:54.73,0:03:55.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:56.73,0:03:57.61,Default,,0,0,0,,(Аяқ дыбысы) Иә?
Dialogue: 0,0:03:57.82,0:03:59.90,Default,,0,0,0,,Құбыжық әйел!
Dialogue: 0,0:04:01.28,0:04:02.32,Default,,0,0,0,,Гррр…
Dialogue: 0,0:04:04.28,0:04:05.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:05.74,0:04:07.83,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:04:08.16,0:04:10.54,Default,,0,0,0,,(Келби) Хильда сенің кесіріңнен өлді.
Dialogue: 0,0:04:10.62,0:04:13.79,Default,,0,0,0,,Ол сенен әлдеқайда құнды адам еді.
Dialogue: 0,0:04:13.87,0:04:15.46,Default,,0,0,0,,Ал, батыл.
Dialogue: 0,0:04:18.96,0:04:19.96,Default,,0,0,0,,(Bridge Dex) Иә?
Dialogue: 0,0:04:21.30,0:04:22.42,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:23.47,0:04:24.47,Default,,0,0,0,,(Келби) Ах.
Dialogue: 0,0:04:24.97,0:04:25.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:33.43,0:04:34.64,Default,,0,0,0,,Құт
Dialogue: 0,0:04:35.14,0:04:36.77,Default,,0,0,0,,Хехехе
Dialogue: 0,0:04:39.69,0:04:40.48,Default,,0,0,0,,Не?
Dialogue: 0,0:04:41.15,0:04:41.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:51.87,0:04:54.96,Default,,0,0,0,,(Филли) Уау...
Dialogue: 0,0:05:12.43,0:05:13.52,Default,,0,0,0,,Арх!
Dialogue: 0,0:05:15.69,0:05:16.35,Default,,0,0,0,,(Кейси) Ei
Dialogue: 0,0:05:21.73,0:05:24.44,Default,,0,0,0,,(Бессидің ұрыс айқайы)
Dialogue: 0,0:05:27.32,0:05:29.87,Default,,0,0,0,,Кеттік, Бесси, досыңа көмектес!
Dialogue: 0,0:05:35.58,0:05:40.46,Default,,0,0,0,,(Филли еңіреп)
Dialogue: 0,0:05:40.67,0:05:42.46,Default,,0,0,0,,Уау...
Dialogue: 0,0:05:49.01,0:05:50.18,Default,,0,0,0,,(Кейси) Сэм күт!
Dialogue: 0,0:05:52.56,0:05:53.93,Default,,0,0,0,,Сэм!
Dialogue: 0,0:06:00.02,0:06:02.77,Default,,0,0,0,,Сэм, сіз әлі есіңізде тұрсыз.
Dialogue: 0,0:06:04.57,0:06:06.78,Default,,0,0,0,,Ескерту Жауларды жою
Dialogue: 0,0:06:08.03,0:06:09.91,Default,,0,0,0,,(Кейси) Уау Сэм!
Dialogue: 0,0:06:10.24,0:06:11.62,Default,,0,0,0,,(Филли) Уф...
Dialogue: 0,0:06:12.62,0:06:13.33,Default,,0,0,0,,Мм.
Dialogue: 0,0:06:16.79,0:06:20.21,Default,,0,0,0,,Керемет! Мен мұндай күшті зеңбіректі ешқашан көрген емеспін.
Dialogue: 0,0:06:20.67,0:06:21.33,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:23.21,0:06:24.30,Default,,0,0,0,,(Кейси) Сэм!
Dialogue: 0,0:06:26.26,0:06:29.88,Default,,0,0,0,,Корольдік рұқсат берген шабуылдарға кедергі жасамаңыз
Dialogue: 0,0:06:30.38,0:06:32.01,Default,,0,0,0,,Кешіріңіз, Сэм
Dialogue: 0,0:06:32.10,0:06:34.51,Default,,0,0,0,,Бірақ сен менің жалғыз досымсың
Dialogue: 0,0:06:35.35,0:06:37.85,Default,,0,0,0,,Білесіз бе, мен және Бесси...
Dialogue: 0,0:06:37.93,0:06:40.52,Default,,0,0,0,,Өйткені мен сенен әлдеқайда үлкенмін
Dialogue: 0,0:06:45.86,0:06:48.36,Default,,0,0,0,,Қалғанын бізге қалдырыңыз!
Dialogue: 0,0:06:57.54,0:06:58.75,Default,,0,0,0,,(Odin) Ой!
Dialogue: 0,0:07:01.96,0:07:05.67,Default,,0,0,0,,Уаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:07:06.00,0:07:07.13,Default,,0,0,0,,Уау
Dialogue: 0,0:07:07.67,0:07:09.84,Default,,0,0,0,,Яаааааааааааааааааааа!
Dialogue: 0,0:07:10.17,0:07:10.72,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:13.34,0:07:14.93,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:07:20.48,0:07:21.14,Default,,0,0,0,,Ах
Dialogue: 0,0:07:22.77,0:07:25.57,Default,,0,0,0,,Ооо!
Dialogue: 0,0:07:30.86,0:07:31.82,Default,,0,0,0,,Уф
Dialogue: 0,0:07:36.37,0:07:42.25,Default,,0,0,0,,Ха ха ха ха ха
Dialogue: 0,0:07:42.62,0:07:47.25,Default,,0,0,0,,Енді спиртті қайда жасырдың? Неге мойындамайсың?
Dialogue: 0,0:07:47.75,0:07:49.67,Default,,0,0,0,,Көңілді жүрсің бе?
Dialogue: 0,0:07:50.30,0:07:52.93,Default,,0,0,0,,Сен... бұзық!
Dialogue: 0,0:07:53.01,0:07:56.80,Default,,0,0,0,,Дөрекі жігіт, жүрегіңді ренжітуден пайда жоқ.
Dialogue: 0,0:07:57.26,0:07:59.77,Default,,0,0,0,,А, мен арықтауға шыдамдымын.
Dialogue: 0,0:07:59.85,0:08:02.39,Default,,0,0,0,,Мен мына пальто астында не жасырылғанын көргім келеді.
Dialogue: 0,0:08:02.48,0:08:04.85,Default,,0,0,0,,Сіз қышиды ма?
Dialogue: 0,0:08:05.27,0:08:07.06,Default,,0,0,0,,Мен көгерген жерлерді бұрын көргенмін.
Dialogue: 0,0:08:07.52,0:08:11.36,Default,,0,0,0,,Әй, бұл маған да қызық емес.
Dialogue: 0,0:08:11.94,0:08:15.20,Default,,0,0,0,,Сен сондай дөрекі адамсың!
Dialogue: 0,0:08:22.37,0:08:23.12,Default,,0,0,0,,Мм.
Dialogue: 0,0:08:23.62,0:08:25.42,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:08:28.67,0:08:29.38,Default,,0,0,0,,(Келби Декс) Ах.
Dialogue: 0,0:08:29.71,0:08:32.76,Default,,0,0,0,,(Филли) Уф... Уау...
Dialogue: 0,0:08:34.88,0:08:38.01,Default,,0,0,0,,(Филли айқай)
Dialogue: 0,0:08:41.52,0:08:44.14,Default,,0,0,0,,Кешіріңіз, мен сәл реттеу қатесін жібердім.
Dialogue: 0,0:08:44.77,0:08:47.36,Default,,0,0,0,,Бірақ енді келесісі тамаша.
Dialogue: 0,0:08:53.78,0:08:54.90,Default,,0,0,0,,(Декс Келби) Уау
Dialogue: 0,0:08:58.12,0:08:59.87,Default,,0,0,0,,(Кейси) Ханзада, асығыңыз!
Dialogue: 0,0:09:01.33,0:09:03.54,Default,,0,0,0,,Мен сол тозығы жеткен көлікті тазалаймын.
Dialogue: 0,0:09:04.00,0:09:04.83,Default,,0,0,0,,Аяқ
Dialogue: 0,0:09:05.92,0:09:07.46,Default,,0,0,0,,(Келби) А... а...
Dialogue: 0,0:09:08.29,0:09:09.75,Default,,0,0,0,,Келіңізші, өтінемін.
Dialogue: 0,0:09:09.84,0:09:10.67,Default,,0,0,0,,(Кейси) Рахмет
Dialogue: 0,0:09:11.63,0:09:13.01,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:19.93,0:09:20.64,Default,,0,0,0,,Өтірік...
Dialogue: 0,0:09:40.74,0:09:42.08,Default,,0,0,0,,Сен мені алдадың!
Dialogue: 0,0:09:46.08,0:09:46.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:47.25,0:09:48.21,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:09:54.88,0:09:56.72,Default,,0,0,0,,(Кейси) Ха! BESSIE қауіп!
Dialogue: 0,0:10:07.64,0:10:08.39,Default,,0,0,0,,Бесси!
Dialogue: 0,0:10:08.48,0:10:11.65,Default,,0,0,0,,(ескерту үні)
Dialogue: 0,0:10:13.32,0:10:14.73,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:10:15.44,0:10:16.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:17.28,0:10:19.32,Default,,0,0,0,,Түсіндім, солай ма? ханзада
Dialogue: 0,0:10:19.41,0:10:22.20,Default,,0,0,0,,Мен әлі де мейірімдімін.
Dialogue: 0,0:10:40.18,0:10:42.60,Default,,0,0,0,,Уаааааааааааааааааа!
Dialogue: 0,0:10:43.26,0:10:45.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:45.93,0:10:47.43,Default,,0,0,0,,Бесси
Dialogue: 0,0:10:47.98,0:10:50.35,Default,,0,0,0,,Ах! Мұнда...
Dialogue: 0,0:10:52.44,0:10:54.61,Default,,0,0,0,,Сэм, ашуланбауға болады ма?
Dialogue: 0,0:10:54.69,0:10:58.07,Default,,0,0,0,,Мүмкін мен бірдеңені жақсы сезінген шығармын.
Dialogue: 0,0:10:58.15,0:11:00.20,Default,,0,0,0,,Ха! Ахх
Dialogue: 0,0:11:02.99,0:11:03.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:06.58,0:11:07.24,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:12.04,0:11:12.88,Default,,0,0,0,,Не! ?
Dialogue: 0,0:11:13.17,0:11:13.83,Default,,0,0,0,,(Келби) Ах.
Dialogue: 0,0:11:34.27,0:11:35.23,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:36.94,0:11:37.61,Default,,0,0,0,,Уф
Dialogue: 0,0:11:39.44,0:11:41.28,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:12:01.84,0:12:03.47,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:03.84,0:12:05.97,Default,,0,0,0,,Баяғыда жасалған -
Dialogue: 0,0:12:06.05,0:12:07.97,Default,,0,0,0,,Бұл күшті қару.
Dialogue: 0,0:12:08.10,0:12:09.06,Default,,0,0,0,,А?
Dialogue: 0,0:12:09.14,0:12:12.18,Default,,0,0,0,,Сіз соғыс тарихын аздап білесіз, бастық.
Dialogue: 0,0:12:12.69,0:12:16.65,Default,,0,0,0,,Бұл зат бұрыннан қолданылған соғыс големі.
Dialogue: 0,0:12:17.02,0:12:18.11,Default,,0,0,0,,(Келби) А...
Dialogue: 0,0:12:18.48,0:12:20.90,Default,,0,0,0,,Тағы бір мазасыз нәрсе шықты.
Dialogue: 0,0:12:20.99,0:12:23.57,Default,,0,0,0,,Эй, уайымдама.
Dialogue: 0,0:12:24.70,0:12:27.95,Default,,0,0,0,,(Робот сарбаз) Мәртебелі Роктан, Сиқыр императорынан хабарлама.
Dialogue: 0,0:12:28.03,0:12:32.37,Default,,0,0,0,,6-шы блиц-рейдер бөлімі кездесу нүктесіне 10 минутта жетеді.
Dialogue: 0,0:12:33.58,0:12:36.88,Default,,0,0,0,,Менің несиені ол адамдармен бөлісуге ниетім жоқ.
Dialogue: 0,0:12:37.25,0:12:41.13,Default,,0,0,0,,Мен бірінші барамын, оны тез жең.
Dialogue: 0,0:12:41.21,0:12:43.34,Default,,0,0,0,,Жүр, кеттік, ханзада.
Dialogue: 0,0:12:47.26,0:12:48.10,Default,,0,0,0,,(Келби) Ах.
Dialogue: 0,0:12:53.10,0:12:53.98,Default,,0,0,0,,Уф
Dialogue: 0,0:12:54.48,0:12:56.27,Default,,0,0,0,,(Келби) Аххххххххххххххххх
Dialogue: 0,0:13:00.77,0:13:02.61,Default,,0,0,0,,Маған ханзаданы беріңіз
Dialogue: 0,0:13:04.28,0:13:07.24,Default,,0,0,0,,Бар, жүр, Сэм! Әрқайсысын жеңіңіз!
Dialogue: 0,0:13:07.32,0:13:08.49,Default,,0,0,0,,Сіз кереметсіз!
Dialogue: 0,0:13:15.58,0:13:18.13,Default,,0,0,0,,Бұл үлкен күш.
Dialogue: 0,0:13:20.25,0:13:21.21,Default,,0,0,0,,Ах
Dialogue: 0,0:13:23.30,0:13:25.97,Default,,0,0,0,,Әй, Сэм?
Dialogue: 0,0:13:26.05,0:13:28.01,Default,,0,0,0,,Маған ханзаданы беріңіз
Dialogue: 0,0:13:35.27,0:13:36.10,Default,,0,0,0,,Құт
Dialogue: 0,0:13:51.49,0:13:52.54,Default,,0,0,0,,Уау
Dialogue: 0,0:13:52.66,0:13:53.74,Default,,0,0,0,,(Декс Келби) Уф...
Dialogue: 0,0:14:06.09,0:14:08.13,Default,,0,0,0,,Сіз мұны істемейсіз.
Dialogue: 0,0:14:08.22,0:14:10.05,Default,,0,0,0,,Егер біз басқа жерде кездессек...
Dialogue: 0,0:14:10.14,0:14:12.85,Default,,0,0,0,,Мүмкін сіз осылай мәңгі қалғым келеді деп ойлаған шығарсыз.
Dialogue: 0,0:14:13.26,0:14:14.52,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:14:14.60,0:14:17.60,Default,,0,0,0,,Алдын ала ойынды өткізіп жіберіп, байыпты болыңыз.
Dialogue: 0,0:14:19.69,0:14:21.23,Default,,0,0,0,,Хахаха…
Dialogue: 0,0:14:27.99,0:14:29.86,Default,,0,0,0,,(Один) Ах, мм.
Dialogue: 0,0:14:31.70,0:14:33.95,Default,,0,0,0,,(Один) Уау! Уф...
Dialogue: 0,0:14:36.45,0:14:37.25,Default,,0,0,0,,Хехе
Dialogue: 0,0:14:40.25,0:14:44.84,Default,,0,0,0,,Менде ішімдік мүлдем жетпейді.
Dialogue: 0,0:14:50.72,0:14:51.34,Default,,0,0,0,,Құт
Dialogue: 0,0:15:01.94,0:15:02.61,Default,,0,0,0,,Уф
Dialogue: 0,0:15:05.98,0:15:06.94,Default,,0,0,0,,(Декс Келби) О.
Dialogue: 0,0:15:29.34,0:15:30.13,Default,,0,0,0,,(Филли) Хехехе
Dialogue: 0,0:15:30.47,0:15:31.76,Default,,0,0,0,,(тесетін дыбыс)
Dialogue: 0,0:15:32.09,0:15:32.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:36.01,0:15:36.93,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:37.43,0:15:38.93,Default,,0,0,0,,(Филли жөтел)
Dialogue: 0,0:15:39.02,0:15:42.44,Default,,0,0,0,,Бұл өте үлкен Филли Бала емес пе?
Dialogue: 0,0:15:42.52,0:15:46.52,Default,,0,0,0,,Кез келген сыйлы аңшы армандайтын сый.
Dialogue: 0,0:15:46.61,0:15:51.40,Default,,0,0,0,,Бірақ бұл адамның қосалқы оқ сатып алуға да шамасы жоқ.
Dialogue: 0,0:15:51.99,0:15:54.99,Default,,0,0,0,,Артық емес...
Dialogue: 0,0:15:56.99,0:15:58.58,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,0:15:59.62,0:16:00.91,Default,,0,0,0,,Ах! Хмм...
Dialogue: 0,0:16:01.12,0:16:02.21,Default,,0,0,0,,(Odin) Күте тұрыңыз!
Dialogue: 0,0:16:02.83,0:16:04.54,Default,,0,0,0,,Цк (Келби) Ах!
Dialogue: 0,0:16:04.88,0:16:06.50,Default,,0,0,0,,Күте тұрыңыз! Хмм
Dialogue: 0,0:16:08.55,0:16:09.46,Default,,0,0,0,,Хехе
Dialogue: 0,0:16:09.96,0:16:11.92,Default,,0,0,0,,Келесі кезекте өлмейтін бейбақ па?
Dialogue: 0,0:16:12.34,0:16:14.13,Default,,0,0,0,,Аспан көк
Dialogue: 0,0:16:14.47,0:16:15.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:15.89,0:16:19.97,Default,,0,0,0,,(Филли) Не? Бұл анық нәрсені айту ойыны емес пе?
Dialogue: 0,0:16:20.56,0:16:22.48,Default,,0,0,0,,(Один) Мен танысқанды ұнатпаймын.
Dialogue: 0,0:16:28.52,0:16:30.86,Default,,0,0,0,,Ой-оу.
Dialogue: 0,0:16:37.45,0:16:38.28,Default,,0,0,0,,Келби
Dialogue: 0,0:16:38.58,0:16:39.49,Default,,0,0,0,,(Келби) Иә?
Dialogue: 0,0:16:40.87,0:16:42.41,Default,,0,0,0,,Сэм...Сэм?
Dialogue: 0,0:16:43.08,0:16:44.29,Default,,0,0,0,,Келби
Dialogue: 0,0:16:45.54,0:16:47.88,Default,,0,0,0,,Эй, ол сені ұнататын сияқты.
Dialogue: 0,0:16:47.96,0:16:49.17,Default,,0,0,0,,(Саған қарай жүгірген аяқ дыбысы) Иә?
Dialogue: 0,0:16:56.59,0:17:01.39,Default,,0,0,0,,(Филли) Ууууууууу!
Dialogue: 0,0:17:03.60,0:17:06.90,Default,,0,0,0,,Эй, маған оқ керек емес.
Dialogue: 0,0:17:06.98,0:17:08.23,Default,,0,0,0,,Айтатата…
Dialogue: 0,0:17:08.44,0:17:10.90,Default,,0,0,0,,(Келби) Уф... уф...
Dialogue: 0,0:17:13.44,0:17:16.78,Default,,0,0,0,,Ууууууууууу...
Dialogue: 0,0:17:17.07,0:17:18.12,Default,,0,0,0,,Ахх
Dialogue: 0,0:17:18.99,0:17:20.83,Default,,0,0,0,,Сәлем! Жерде не?
Dialogue: 0,0:17:21.33,0:17:22.41,Default,,0,0,0,,(Келби) Қарғыс атсын...
Dialogue: 0,0:17:29.88,0:17:31.30,Default,,0,0,0,,Қозғалмаңыз
Dialogue: 0,0:17:37.34,0:17:38.09,Default,,0,0,0,,(Кейси) Уау!
Dialogue: 0,0:17:38.64,0:17:40.60,Default,,0,0,0,,Фили, сен не істеп жатырсың?
Dialogue: 0,0:17:40.68,0:17:43.02,Default,,0,0,0,,Жоқ, Сэм, бұл Фили!
Dialogue: 0,0:17:43.10,0:17:46.35,Default,,0,0,0,,Ол соншалықты жаман емес. Біз жақсы араласатынбыз.
Dialogue: 0,0:18:03.54,0:18:04.41,Default,,0,0,0,,Ku…
Dialogue: 0,0:18:10.92,0:18:11.75,Default,,0,0,0,,Құт
Dialogue: 0,0:18:14.17,0:18:15.80,Default,,0,0,0,,А, тоқта, тоқта
Dialogue: 0,0:18:16.38,0:18:18.13,Default,,0,0,0,,Темиді өлтіргеннен кейін...
Dialogue: 0,0:18:18.22,0:18:20.72,Default,,0,0,0,,Менің бұл сезімім өшпейді...
Dialogue: 0,0:18:20.80,0:18:21.97,Default,,0,0,0,,Бұл тіпті кек алу емес.
Dialogue: 0,0:18:23.18,0:18:26.27,Default,,0,0,0,,Теми ата-анасынан айырылған бала ғана.
Dialogue: 0,0:18:26.85,0:18:28.31,Default,,0,0,0,,Мен сияқты
Dialogue: 0,0:18:31.73,0:18:32.52,Default,,0,0,0,,Бас
Dialogue: 0,0:18:34.69,0:18:36.90,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:18:37.11,0:18:38.95,Default,,0,0,0,,Сіз неғұрлым ұзақ өмір сүрсеңіз...
Dialogue: 0,0:18:39.03,0:18:41.41,Default,,0,0,0,,Сіз енді тірі болудың мәнін түсінбейсіз.
Dialogue: 0,0:18:41.95,0:18:43.87,Default,,0,0,0,,Сэм! тыңда
Dialogue: 0,0:18:43.95,0:18:48.00,Default,,0,0,0,,Менде қазір бәрі жақсы. Үйге барайық. Үйге бірге барайық.
Dialogue: 0,0:18:48.66,0:18:52.21,Default,,0,0,0,,Бұрынғы айтқаным үшін кешірім сұраймын, Сэм ойыншық емес!
Dialogue: 0,0:18:55.05,0:18:58.42,Default,,0,0,0,,Сэм менің досым, нағыз досым!
Dialogue: 0,0:19:11.94,0:19:16.23,Default,,0,0,0,,Мен біраз абдырап қалдым...
Dialogue: 0,0:19:19.15,0:19:21.82,Default,,0,0,0,,Ммммммммм
Dialogue: 0,0:19:22.11,0:19:25.66,Default,,0,0,0,,Нағыз Сэм автоматты режимді басқаруға тырысады.
Dialogue: 0,0:19:25.74,0:19:28.04,Default,,0,0,0,,Сәттілік Сэм, оян.
Dialogue: 0,0:19:28.41,0:19:34.75,Default,,0,0,0,,(Сэмнің ыңырануы)
Dialogue: 0,0:19:34.84,0:19:36.59,Default,,0,0,0,,Нуаа!
Dialogue: 0,0:19:38.09,0:19:40.38,Default,,0,0,0,,Шешім критерийлерін өзгерту
Dialogue: 0,0:19:51.94,0:19:52.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:57.19,0:19:58.48,Default,,0,0,0,,Сэм?
Dialogue: 0,0:20:08.79,0:20:10.87,Default,,0,0,0,,(Барлығы) Ахххххх
Dialogue: 0,0:20:11.16,0:20:11.83,Default,,0,0,0,,Уф
Dialogue: 0,0:20:11.96,0:20:14.37,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:20:22.97,0:20:25.47,Default,,0,0,0,,(Кейси) Сэм! Сэм!
Dialogue: 0,0:20:25.89,0:20:28.10,Default,,0,0,0,,Керемет, Сэм жеңді!
Dialogue: 0,0:20:28.18,0:20:30.06,Default,,0,0,0,,Жақсы жұмыс Сэм.
Dialogue: 0,0:20:34.81,0:20:36.56,Default,,0,0,0,,Фу…
Dialogue: 0,0:20:37.06,0:20:40.44,Default,,0,0,0,,Бүгін сіз екеуміз твиттерге жазған сияқтымыз.
Dialogue: 0,0:20:40.53,0:20:41.90,Default,,0,0,0,,Ханзада
Dialogue: 0,0:20:41.99,0:20:43.32,Default,,0,0,0,,(Один) Ханзада! (Филли) Иә?
Dialogue: 0,0:20:43.70,0:20:44.45,Default,,0,0,0,,Ах
Dialogue: 0,0:20:44.99,0:20:46.41,Default,,0,0,0,,Жібер!
Dialogue: 0,0:20:46.62,0:20:47.53,Default,,0,0,0,,Құт
Dialogue: 0,0:20:50.79,0:20:53.00,Default,,0,0,0,,Один! Сэм!
Dialogue: 0,0:20:53.21,0:20:54.79,Default,,0,0,0,,Сен қазір Сэмді тастап кетесің бе?
Dialogue: 0,0:20:55.62,0:20:57.29,Default,,0,0,0,,Ммм аааа
Dialogue: 0,0:20:57.38,0:20:58.96,Default,,0,0,0,,Хе хехе
Dialogue: 0,0:20:59.42,0:21:01.21,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:05.59,0:21:07.43,Default,,0,0,0,,Сиқырлы патша Локк
Dialogue: 0,0:21:07.93,0:21:09.85,Default,,0,0,0,,Тұтқынға алынған ханзада Келби
Dialogue: 0,0:21:09.93,0:21:12.10,Default,,0,0,0,,Мен қазір сол жаққа бара жатырмын.
Dialogue: 0,0:21:12.18,0:21:14.39,Default,,0,0,0,,Фуфухаха...
Dialogue: 0,0:21:14.94,0:21:19.40,Default,,0,0,0,,Хахахаха... хахахаха...
Dialogue: 0,0:21:22.61,0:21:25.53,Default,,0,0,0,,Қарғыс атсын... Қарғыс атсын
Dialogue: 0,0:21:29.87,0:21:31.03,Default,,0,0,0,,Келби?
Dialogue: 0,0:21:31.12,0:21:34.25,Default,,0,0,0,,Уайымдама, ол әлі тірі шығар.
Dialogue: 0,0:21:35.16,0:21:36.25,Default,,0,0,0,,Фили туралы не деуге болады?
Dialogue: 0,0:21:36.33,0:21:39.46,Default,,0,0,0,,Әй, Фили! Сізге қауіп төнді ме?
Dialogue: 0,0:21:39.79,0:21:42.88,Default,,0,0,0,,Біреуді өлтірсең де есіңе түспейді деп ойлаймын.
Dialogue: 0,0:21:42.96,0:21:44.30,Default,,0,0,0,,Ыңғайлы заттар
Dialogue: 0,0:21:44.92,0:21:47.84,Default,,0,0,0,,Капитан Один, жағдайыңыз қалай?
Dialogue: 0,0:21:48.14,0:21:52.35,Default,,0,0,0,,Мен бұл зеңбіректерді жарып жібергеніне сене алар емеспін.
Dialogue: 0,0:21:52.93,0:21:56.31,Default,,0,0,0,,Мәртебелі оны ханзаданы қорғау үшін жасаған шығар.
Dialogue: 0,0:21:56.39,0:21:58.35,Default,,0,0,0,,Бұл сізді таң қалдырады.
Dialogue: 0,0:21:58.48,0:22:00.65,Default,,0,0,0,,Бірақ егер...
Dialogue: 0,0:22:01.19,0:22:02.94,Default,,0,0,0,,Кешіріңіз, капитан.
Dialogue: 0,0:22:03.03,0:22:05.36,Default,,0,0,0,,«Зеңбірек ұрлау» деген не?
Dialogue: 0,0:22:05.94,0:22:07.45,Default,,0,0,0,,(Один) Cannon Buster дегеніміз не?
Dialogue: 0,0:22:07.53,0:22:10.45,Default,,0,0,0,,Жауынгерлік машина тарихтағы ең күшті деп аталды
Dialogue: 0,0:22:10.87,0:22:15.79,Default,,0,0,0,,Сиқырмен жасалған және жан берілген соғыс големі.
Dialogue: 0,0:22:16.08,0:22:19.83,Default,,0,0,0,,Бес ұлы державаның келісімімен сиқыршылар дәуірі аяқталды.
Dialogue: 0,0:22:19.92,0:22:24.05,Default,,0,0,0,,Бұл сиқырмен бірге тыйым салынған жәдігер.
Dialogue: 0,0:22:42.36,0:22:44.73,Default,,0,0,0,,(Филли мен Кейси жылайды)
Dialogue: 0,0:22:44.94,0:22:47.36,Default,,0,0,0,,О, менің тәттім Бесси
Dialogue: 0,0:22:47.44,0:22:50.49,Default,,0,0,0,,Жарайды, әйтеуір түзетемін.
Dialogue: 0,0:22:53.28,0:22:54.45,Default,,0,0,0,,Жарайды, осы бөлмеде бәрі дұрыс па, тексеріп бересің бе?
Dialogue: 0,0:22:54.53,0:22:56.62,Default,,0,0,0,,Бессиді кездейсоқ мінбе!
Dialogue: 0,0:22:56.70,0:22:57.33,Default,,0,0,0,,Хаха
Dialogue: 0,0:22:57.41,0:22:58.62,Default,,0,0,0,,Мас!
Dialogue: 0,0:22:58.71,0:22:59.87,Default,,0,0,0,,Ггаааах!
Dialogue: 0,0:22:59.96,0:23:01.21,Default,,0,0,0,,Бесси сенікі емес.
Dialogue: 0,0:23:01.29,0:23:02.96,Default,,0,0,0,,Бұл менің сүйікті көлігім!
Dialogue: 0,0:23:03.04,0:23:05.13,Default,,0,0,0,,Шынымды айтсам, бұл ең жақсы сапар!
Dialogue: 0,0:23:05.21,0:23:06.76,Default,,0,0,0,,Бұл ағаштың бір бөлігі!
Dialogue: 0,0:23:06.84,0:23:07.96,Default,,0,0,0,,Сенің арқасында тіпті трусигім де суға малып кетті. О, Құдай-ай…
Dialogue: 0,0:23:08.05,0:23:09.47,Default,,0,0,0,,Мен үшін не істейсің, Чибибот?
Dialogue: 0,0:23:09.93,0:23:13.47,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:23:13.55,0:23:16.31,Default,,0,0,0,,Эй, мені жібер!
Dialogue: 0,0:23:16.47,0:23:17.89,Default,,0,0,0,,Жібер...
Dialogue: 0,0:23:18.39,0:23:20.89,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:23:21.69,0:23:22.85,Default,,0,0,0,,Гвардия капитаны -
Dialogue: 0,0:23:22.94,0:23:24.61,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:23:24.69,0:23:27.19,Default,,0,0,0,,(Один) Бодика патшалығы шығар.
Dialogue: 0,0:23:27.90,0:23:30.32,Default,,0,0,0,,Сиқырлы император қай жерде болса да...
Dialogue: 0,0:23:30.40,0:23:33.07,Default,,0,0,0,,Мен өз ханзадамды құтқаруым керек.
Dialogue: 0,0:23:34.28,0:23:36.28,Default,,0,0,0,,Күте тұрыңыз, гвардия капитаны.
Dialogue: 0,0:23:36.37,0:23:39.41,Default,,0,0,0,,Біз де ханзада Келбиді тастап кете алмаймыз!
Dialogue: 0,0:23:39.66,0:23:40.71,Default,,0,0,0,,(Филли) Иә? (Кейси) Иә?
Dialogue: 0,0:23:42.17,0:23:44.17,Default,,0,0,0,,Жарайды, бәріңе.
Dialogue: 0,0:23:44.33,0:23:46.84,Default,,0,0,0,,Бүгін не болғанын білмеймін...
Dialogue: 0,0:23:46.92,0:23:48.63,Default,,0,0,0,,Білудің қажеті жоқ
Dialogue: 0,0:23:49.30,0:23:50.38,Default,,0,0,0,,Белгілі нәрсе -
Dialogue: 0,0:23:50.47,0:23:53.39,Default,,0,0,0,,Менің досыма үлкен қауіп төніп тұр.
Dialogue: 0,0:23:53.93,0:23:55.64,Default,,0,0,0,,Барлығымыз көмектесейік
Dialogue: 0,0:23:55.72,0:23:56.35,Default,,0,0,0,,(Филли) Иә?
Dialogue: 0,0:23:56.68,0:23:58.31,Default,,0,0,0,,О, о...
Dialogue: 0,0:23:58.89,0:24:02.44,Default,,0,0,0,,Жарайды, мен сіздің күшіңізге сене аламын.
Dialogue: 0,0:24:02.52,0:24:05.81,Default,,0,0,0,,Болашақта бізді жау күтіп тұрғаны сөзсіз.
Dialogue: 0,0:24:05.90,0:24:10.03,Default,,0,0,0,,Олар бізді жылы қарсы алады деп ойламаймын.
Dialogue: 0,0:24:10.65,0:24:13.24,Default,,0,0,0,,Келбиді бірге құтқарайық.
Dialogue: 0,0:24:13.61,0:24:15.57,Default,,0,0,0,,Жарайды, жасайық!
Dialogue: 0,0:24:16.16,0:24:18.62,Default,,0,0,0,,Қызық, Бодиканың ішімдігі бар ма?
Dialogue: 0,0:24:18.70,0:24:19.62,Default,,0,0,0,,Бұл дәмді ме?
Dialogue: 0,0:24:19.70,0:24:20.70,Default,,0,0,0,,Бұл дәмді болуы керек.
Dialogue: 0,0:24:20.79,0:24:23.62,Default,,0,0,0,,Дүние жүзіне танымал але бар.
Dialogue: 0,0:24:23.71,0:24:25.58,Default,,0,0,0,,Ерік! Бірге барайық
Dialogue: 0,0:24:25.71,0:24:27.38,Default,,0,0,0,,Соңында баяғы бала тағы да...
Dialogue: 0,0:24:27.46,0:24:29.46,Default,,0,0,0,,Артыңнан қуғанның не керегі бар?
Dialogue: 0,0:24:29.55,0:24:31.46,Default,,0,0,0,,Оның үстіне бұл жолы сен менің жолыма бөгет боласың.
Dialogue: 0,0:24:31.55,0:24:33.30,Default,,0,0,0,,Бұл ақымақтардың көбейетінін білдіре ме?
Dialogue: 0,0:24:33.38,0:24:34.43,Default,,0,0,0,,Мен шыдай алмаймын.
Dialogue: 0,0:24:35.01,0:24:35.84,Default,,0,0,0,,Сізбен кездесуге рұқсат етсеңіз...
Dialogue: 0,0:24:35.93,0:24:38.18,Default,,0,0,0,,Филиге уәде бермедің бе?
Dialogue: 0,0:24:38.26,0:24:40.14,Default,,0,0,0,,Сіз өз ойыңызды өзгерткен жоқсыз, солай ма?
Dialogue: 0,0:24:41.43,0:24:42.64,Default,,0,0,0,,А...
Dialogue: 0,0:24:43.89,0:24:45.31,Default,,0,0,0,,Қазір тым суық...
Dialogue: 0,0:24:45.40,0:24:47.19,Default,,0,0,0,,Сіз айтпайсыз, солай ма? Фили
Dialogue: 0,0:24:47.48,0:24:49.40,Default,,0,0,0,,(Изуку) Качан… әдетте оң қолымен мықты соққы жасап бастайды
Dialogue: 0,0:24:57.49,0:24:58.28,Default,,0,0,0,,Га
Dialogue: 0,0:25:05.29,0:25:06.58,Default,,0,0,0,,Бірақ
Dialogue: 0,0:25:06.71,0:25:09.42,Default,,0,0,0,,Көлігім жоқ болса не істеуім керек?
Dialogue: 0,0:25:11.50,0:25:16.47,Default,,0,0,0,,♪～
Dialogue: 0,0:25:17.97,0:25:23.97,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory