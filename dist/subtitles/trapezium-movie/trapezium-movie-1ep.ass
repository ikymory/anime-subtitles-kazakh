Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:13.97,0:00:18.93,Default,,0,0,0,,Сен, қара нәсілді жексұрын!
Dialogue: 0,0:00:21.89,0:00:27.44,Default,,0,0,0,,(Жүректің соғу дыбысы арқылы келе жатқан пойыздың дыбысы)
Dialogue: 0,0:00:30.94,0:00:35.66,Default,,0,0,0,,(Пойыздың жүгіру дыбысы)
Dialogue: 0,0:00:37.78,0:00:39.91,Default,,0,0,0,,(♪Құлаққаптан музыка ағып жатыр)
Dialogue: 0,0:00:42.87,0:00:45.04,Default,,0,0,0,,Такахашидің жігіті сүйгені үшін мектептен шеттетілген сияқты.
Dialogue: 0,0:00:45.12,0:00:46.42,Default,,0,0,0,,Сіз қоршауға шығып жатырсыз ба?
Dialogue: 0,0:00:46.50,0:00:48.92,Default,,0,0,0,,Таксист мені көріп, шаншып жіберді.
Dialogue: 0,0:00:49.00,0:00:50.80,Default,,0,0,0,,Шынайы ма? Бұл күлкілі
Dialogue: 0,0:00:50.88,0:00:52.67,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:01:03.31,0:01:06.48,Default,,0,0,0,,(ұлдар арасындағы әңгіменің жалғасы)
Dialogue: 0,0:01:21.70,0:01:24.12,Default,,0,0,0,,~♪
Dialogue: 0,0:01:37.84,0:01:39.89,Default,,0,0,0,,Жүрейік (2-оқушы қыз) Иә.
Dialogue: 0,0:01:39.97,0:01:41.26,Default,,0,0,0,,Ах
Dialogue: 0,0:01:53.36,0:01:55.24,Default,,0,0,0,,♪ Мен ең керексіз адаммын деп ойлаймын
Dialogue: 0,0:01:55.32,0:01:57.11,Default,,0,0,0,,♪ Сіз де ең керексіз болуыңыз керек.
Dialogue: 0,0:01:57.20,0:01:58.99,Default,,0,0,0,,♪ Біз ештеңеміз, ештеңеміз, ештеңеміз.
Dialogue: 0,0:01:59.07,0:02:00.83,Default,,0,0,0,,♪ Менің ойымша, сіз оны ала алмайсыз.
Dialogue: 0,0:02:00.91,0:02:02.91,Default,,0,0,0,,♪ Кішкентай шамды іздеу
Dialogue: 0,0:02:02.99,0:02:05.25,Default,,0,0,0,,♪ Екеуміз қиналып жүрген түнде, ақыры бірге жеттік
Dialogue: 0,0:02:05.33,0:02:08.29,Default,,0,0,0,,♪ Бұл ән сол күндерді атап өтеді
Dialogue: 0,0:02:09.12,0:02:10.67,Default,,0,0,0,,♪ Бір ғана арман орындалса
Dialogue: 0,0:02:10.75,0:02:12.38,Default,,0,0,0,,♪ Сіз не қалайтыныңызды айтар едіңіз?
Dialogue: 0,0:02:12.46,0:02:14.34,Default,,0,0,0,,♪ Егер сіз бір адам бола алсаңыз
Dialogue: 0,0:02:14.42,0:02:15.63,Default,,0,0,0,,♪ Кім болғың келеді деп айтар едің?
Dialogue: 0,0:02:15.71,0:02:18.68,Default,,0,0,0,,♪ Менің жағыма бірден жетпейтін нәрселер ғана бар.
Dialogue: 0,0:02:18.76,0:02:20.68,Default,,0,0,0,,♪ Маған не қалайтыныңызды айтыңыз
Dialogue: 0,0:02:20.76,0:02:22.72,Default,,0,0,0,,♪ Неге екені белгісіз, менде ынта болды.
Dialogue: 0,0:02:23.26,0:02:24.85,Default,,0,0,0,,♪ Көк ауа, самал баратын жер
Dialogue: 0,0:02:24.93,0:02:27.06,Default,,0,0,0,,♪ Сөздердің траекториясы, жүрегіміздің соғу үні
Dialogue: 0,0:02:27.14,0:02:28.77,Default,,0,0,0,,♪ Мен өзімді шексіз сұлу сезіндім.
Dialogue: 0,0:02:28.85,0:02:30.44,Default,,0,0,0,,♪ Жоспарланған толық емес идеализм
Dialogue: 0,0:02:30.52,0:02:33.19,Default,,0,0,0,,♪ Баспалдақпен көтерілген сайын секіремін.
Dialogue: 0,0:02:33.27,0:02:35.11,Default,,0,0,0,,♪ Бірінші шаршыға мәжбүрлі түрде қайтару
Dialogue: 0,0:02:35.19,0:02:37.90,Default,,0,0,0,,♪ Мен қатты дем шығардым.
Dialogue: 0,0:02:37.99,0:02:41.87,Default,,0,0,0,,♪ Мен сенген нәрсеге сенген сияқтымын
Dialogue: 0,0:02:41.95,0:02:45.41,Default,,0,0,0,,♪ Мен оның пішіні жоқ екенін түсінгенде де
Dialogue: 0,0:02:45.49,0:02:47.54,Default,,0,0,0,,♪ Жазықсыздықтың біткеніндей күлдім
Dialogue: 0,0:02:47.62,0:02:48.75,Default,,0,0,0,,♪ Мен қарап тұра берем
Dialogue: 0,0:02:48.83,0:02:50.54,Default,,0,0,0,,♪ Мен жақсара бастадым.
Dialogue: 0,0:02:50.62,0:02:52.29,Default,,0,0,0,,♪ ...тірі болды
Dialogue: 0,0:02:53.42,0:02:55.21,Default,,0,0,0,,♪ Мен ең керексіз адаммын деп ойлаймын.
Dialogue: 0,0:02:55.30,0:02:57.09,Default,,0,0,0,,♪ Сіз де ең керексіз болуыңыз керек.
Dialogue: 0,0:02:57.17,0:02:59.01,Default,,0,0,0,,♪ Біз ештеңеміз, ештеңеміз, ештеңеміз.
Dialogue: 0,0:02:59.09,0:03:00.76,Default,,0,0,0,,♪ Менің ойымша, сіз оны ала алмайсыз.
Dialogue: 0,0:03:00.84,0:03:02.93,Default,,0,0,0,,♪ Кішкентай шамды іздеу
Dialogue: 0,0:03:03.01,0:03:05.26,Default,,0,0,0,,♪ Екеуміз қиналып жүрген түні ақыры бірге жеттік
Dialogue: 0,0:03:05.35,0:03:08.18,Default,,0,0,0,,♪ Тіпті сол күндердің өзі сүйкімді көрінетін
Dialogue: 0,0:03:08.27,0:03:10.10,Default,,0,0,0,,♪ Сол күні көз жасыңды төкпеуді шештің.
Dialogue: 0,0:03:10.19,0:03:12.10,Default,,0,0,0,,♪ Сіз көз жасыңызды төкпеуді шешкен шығарсыз.
Dialogue: 0,0:03:12.19,0:03:13.23,Default,,0,0,0,,♪ Бірақ неге?
Dialogue: 0,0:03:13.31,0:03:14.52,Default,,0,0,0,,♪ неге неге неге
Dialogue: 0,0:03:14.61,0:03:15.86,Default,,0,0,0,,♪ Ол жылап жатса керек.
Dialogue: 0,0:03:15.94,0:03:17.74,Default,,0,0,0,,♪ Жарқырап көрінді
Dialogue: 0,0:03:17.82,0:03:20.32,Default,,0,0,0,,♪ Сол күні мен көрген жұлдыздар қазір
Dialogue: 0,0:03:20.40,0:03:22.66,Default,,0,0,0,,♪ Бір жерде біреу маған нұрын шаша ма деп ойлаймын.
Dialogue: 0,0:03:22.74,0:03:24.78,Default,,0,0,0,,♪ Әлі де бар ма деп ойлаймын
Dialogue: 0,0:03:39.26,0:03:42.26,Default,,0,0,0,,~♪
Dialogue: 0,0:03:54.81,0:03:56.90,Default,,0,0,0,,Уау Хигаши орта мектебі
Dialogue: 0,0:03:56.98,0:03:58.40,Default,,0,0,0,,Форма ақсақ
Dialogue: 0,0:03:59.53,0:04:00.36,Default,,0,0,0,,Цк
Dialogue: 0,0:04:02.32,0:04:03.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:06.45,0:04:09.08,Default,,0,0,0,,«Мейірімділік» дегеніміз не?
Dialogue: 0,0:04:10.29,0:04:14.63,Default,,0,0,0,,♪ Тенеритас Бұл мейірімділік...
Dialogue: 0,0:04:14.71,0:04:18.75,Default,,0,0,0,,(♪ Жалғасы «Seinan Teneritas Girls' School song»)
Dialogue: 0,0:04:25.30,0:04:27.47,Default,,0,0,0,,~♪
Dialogue: 0,0:04:39.65,0:04:42.11,Default,,0,0,0,,Тезірек (теннис клубының мүшесі 2) Иә.
Dialogue: 0,0:04:43.07,0:04:44.24,Default,,0,0,0,,Ах
Dialogue: 0,0:04:44.32,0:04:45.61,Default,,0,0,0,,Табылды
Dialogue: 0,0:04:45.70,0:04:47.83,Default,,0,0,0,,Таза алтын құймасы
Dialogue: 0,0:04:50.33,0:04:53.08,Default,,0,0,0,,Таза алтын құймасы...
Dialogue: 0,0:04:53.16,0:04:54.87,Default,,0,0,0,,Күтесіз бе?
Dialogue: 0,0:04:54.96,0:04:57.84,Default,,0,0,0,,Бұл форма Хигаши орта мектебінен, солай ма?
Dialogue: 0,0:04:57.92,0:04:59.63,Default,,0,0,0,,Енді барлау.
Dialogue: 0,0:04:59.71,0:05:01.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:04.47,0:05:06.68,Default,,0,0,0,,Эээх…
Dialogue: 0,0:05:06.76,0:05:09.51,Default,,0,0,0,,Істің қалай орындалғанын көру үшін.
Dialogue: 0,0:05:10.18,0:05:11.60,Default,,0,0,0,,Мен сені құрбыммен жасатамын.
Dialogue: 0,0:05:11.68,0:05:13.23,Default,,0,0,0,,Ах
Dialogue: 0,0:05:15.64,0:05:19.69,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:05:21.44,0:05:24.15,Default,,0,0,0,,Келіңіздер, шарасыздан
Dialogue: 0,0:05:25.15,0:05:26.49,Default,,0,0,0,,Көбелек ханым?
Dialogue: 0,0:05:26.57,0:05:27.91,Default,,0,0,0,,Га
Dialogue: 0,0:05:31.49,0:05:32.70,Default,,0,0,0,,Әй
Dialogue: 0,0:05:33.20,0:05:34.87,Default,,0,0,0,,(Кёко) Ой... мен соңғы хиттердің ешқайсысын білмеймін!
Dialogue: 0,0:05:35.50,0:05:38.13,Default,,0,0,0,,Вомбай Качо ойын жинағы
Dialogue: 0,0:05:39.88,0:05:43.92,Default,,0,0,0,,Ха, гүл құсындай жеңілген маған пайда жоқ.
Dialogue: 0,0:05:44.01,0:05:46.22,Default,,0,0,0,,Үйге тез қайт
Dialogue: 0,0:05:47.59,0:05:49.68,Default,,0,0,0,,Ах~
Dialogue: 0,0:05:50.39,0:05:52.35,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:05:56.39,0:05:58.23,Default,,0,0,0,,Мм...
Dialogue: 0,0:06:00.90,0:06:02.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:02.36,0:06:05.11,Default,,0,0,0,,Мен сізге алғыс айтқым келді.
Dialogue: 0,0:06:05.19,0:06:06.32,Default,,0,0,0,,Рахмет?
Dialogue: 0,0:06:06.82,0:06:11.33,Default,,0,0,0,,Ойынның алдында сіз мені Баттерфляй ханым деп атадыңыз.
Dialogue: 0,0:06:11.41,0:06:12.24,Default,,0,0,0,,Иә
Dialogue: 0,0:06:12.33,0:06:14.29,Default,,0,0,0,,Мен бақытты болдым.
Dialogue: 0,0:06:14.37,0:06:17.79,Default,,0,0,0,,Маған "Нысанаға ал Эйс!"
Dialogue: 0,0:06:17.87,0:06:19.50,Default,,0,0,0,,Мен теннис үйірмесіне қосылдым.
Dialogue: 0,0:06:19.58,0:06:24.42,Default,,0,0,0,,Маған да ұнайды! Баяғыда анамның ата-анасының үйінде манга оқып жүргенмін...
Dialogue: 0,0:06:25.26,0:06:28.38,Default,,0,0,0,,Сіз теннис клубында жоқсыз.
Dialogue: 0,0:06:28.93,0:06:32.89,Default,,0,0,0,,Мен біреуді жеңу мүмкін емес
Dialogue: 0,0:06:32.97,0:06:34.31,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:34.39,0:06:36.73,Default,,0,0,0,,Бұл кешірім сұрау туралы емес.
Dialogue: 0,0:06:36.81,0:06:38.44,Default,,0,0,0,,Ұят, солай емес пе?
Dialogue: 0,0:06:39.19,0:06:43.94,Default,,0,0,0,,Сырт келбетіңіз осылай болса да, теннисте басқаларға қарағанда әлсізсіз.
Dialogue: 0,0:06:46.19,0:06:49.40,Default,,0,0,0,,Сенің мұнда қалай келгеніңді білмеймін, бірақ
Dialogue: 0,0:06:49.49,0:06:51.87,Default,,0,0,0,,Қалай болғанда да, рахмет
Dialogue: 0,0:06:53.45,0:06:54.62,Default,,0,0,0,,Шындығында, мен...
Dialogue: 0,0:06:55.20,0:06:58.29,Default,,0,0,0,,Мен бұл мектепке достасуға келдім.
Dialogue: 0,0:06:58.37,0:07:00.08,Default,,0,0,0,,Достасуды?
Dialogue: 0,0:07:00.17,0:07:01.00,Default,,0,0,0,,Иә
Dialogue: 0,0:07:01.08,0:07:02.71,Default,,0,0,0,,Бұл біртүрлі, солай емес пе?
Dialogue: 0,0:07:02.79,0:07:06.09,Default,,0,0,0,,Ухуху, бұл біртүрлі.
Dialogue: 0,0:07:07.51,0:07:09.72,Default,,0,0,0,,Бірақ мен байсалдымын.
Dialogue: 0,0:07:13.05,0:07:15.31,Default,,0,0,0,,Бір қызығы, екеуміз де кезіп жүрміз.
Dialogue: 0,0:07:15.39,0:07:16.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:19.89,0:07:22.52,Default,,0,0,0,,Мені Көбелек ханым деп атағаныңызға рахмет.
Dialogue: 0,0:07:22.60,0:07:25.73,Default,,0,0,0,,Егер менімен жақсы болсаң, мен саған дос боламын.
Dialogue: 0,0:07:25.82,0:07:28.94,Default,,0,0,0,,Менің атым Качо Ранко.
Dialogue: 0,0:07:30.70,0:07:33.53,Default,,0,0,0,,Менің атым Ю Хигаши.
Dialogue: 0,0:07:33.62,0:07:35.58,Default,,0,0,0,,Рахмет, Минами-сан!
Dialogue: 0,0:07:35.66,0:07:37.24,Default,,0,0,0,,Минами мырза?
Dialogue: 0,0:07:37.33,0:07:40.75,Default,,0,0,0,,Мм... бұл лақап ат.
Dialogue: 0,0:07:40.83,0:07:43.17,Default,,0,0,0,,Өйткені мен Хигашиконың Хигашимін
Dialogue: 0,0:07:43.25,0:07:45.96,Default,,0,0,0,,Сейнан Тенеритастың «Минами-сан» туралы не деуге болады?
Dialogue: 0,0:07:47.30,0:07:51.68,Default,,0,0,0,,Жақсы! Иә, бұл өте жақсы, хехехе
Dialogue: 0,0:07:52.59,0:07:56.31,Default,,0,0,0,,Бұл менің бірінші рет лақап ат беруім!
Dialogue: 0,0:07:58.93,0:08:01.14,Default,,0,0,0,,Фуфуфу (Ранко) Фуфуфуфу
Dialogue: 0,0:08:10.65,0:08:12.24,Default,,0,0,0,,Ең алдымен бүгінгі алғашқы ән
Dialogue: 0,0:08:12.32,0:08:14.66,Default,,0,0,0,,«Қозы қоян» радио атауымен сұралған
Dialogue: 0,0:08:14.74,0:08:15.99,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:08:16.83,0:08:19.62,Default,,0,0,0,,(♪Радиодан естілетін музыка)
Dialogue: 0,0:08:22.16,0:08:24.83,Default,,0,0,0,,Юу! Тамағыңды іш
Dialogue: 0,0:08:24.92,0:08:26.21,Default,,0,0,0,,Иә
Dialogue: 0,0:08:26.88,0:08:28.63,Default,,0,0,0,,~♪
Dialogue: 0,0:08:39.10,0:08:43.27,Default,,0,0,0,,Адам Адам Ер адам
Dialogue: 0,0:08:46.31,0:08:48.40,Default,,0,0,0,,Тек ұлдар
Dialogue: 0,0:08:57.07,0:08:58.12,Default,,0,0,0,,Ах
Dialogue: 0,0:08:59.20,0:09:00.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:00.99,0:09:01.83,Default,,0,0,0,,Бұл
Dialogue: 0,0:09:01.91,0:09:02.91,Default,,0,0,0,,Иә
Dialogue: 0,0:09:03.00,0:09:04.87,Default,,0,0,0,,Міне, не болғаны
Dialogue: 0,0:09:04.96,0:09:06.04,Default,,0,0,0,,Мен үшін?
Dialogue: 0,0:09:06.12,0:09:07.04,Default,,0,0,0,,Әрине
Dialogue: 0,0:09:07.13,0:09:10.55,Default,,0,0,0,,Мен роботтарды зерттеу тобының қай жерде жұмыс істейтінін білгім келеді.
Dialogue: 0,0:09:10.63,0:09:13.13,Default,,0,0,0,,Әй...
Dialogue: 0,0:09:14.34,0:09:15.63,Default,,0,0,0,,Мен саған жол көрсетемін
Dialogue: 0,0:09:15.72,0:09:17.22,Default,,0,0,0,,О, жақсы ма?
Dialogue: 0,0:09:17.30,0:09:19.18,Default,,0,0,0,,Түсіну қиын
Dialogue: 0,0:09:23.02,0:09:26.60,Default,,0,0,0,,Бауырым, біраздан бері маған қарамадың ба?
Dialogue: 0,0:09:26.69,0:09:28.02,Default,,0,0,0,,Өйткені форма...
Dialogue: 0,0:09:28.11,0:09:30.19,Default,,0,0,0,,Бірыңғай... а
Dialogue: 0,0:09:30.27,0:09:33.74,Default,,0,0,0,,«Сол ақсақ формалы орта мектеп қайда?» деп ойлап көрдіңіз бе?
Dialogue: 0,0:09:33.82,0:09:38.62,Default,,0,0,0,,Жоқ, маған тек жоғары сынып оқушыларының формасы ұнайды.
Dialogue: 0,0:09:38.70,0:09:40.08,Default,,0,0,0,,Ал...
Dialogue: 0,0:09:40.16,0:09:41.49,Default,,0,0,0,,Иә? Кудо Бұл не?
Dialogue: 0,0:09:41.58,0:09:44.37,Default,,0,0,0,,Ертең сөйлесейік
Dialogue: 0,0:09:45.08,0:09:47.08,Default,,0,0,0,,Кудо қызбен бірге
Dialogue: 0,0:09:47.17,0:09:50.50,Default,,0,0,0,,Техникумдарда шынымен де аз қыздар бар ма?
Dialogue: 0,0:09:50.59,0:09:51.46,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:09:51.55,0:09:55.13,Default,,0,0,0,,Біраз уақыттан бері бірде-бір адамды көрмедім.
Dialogue: 0,0:09:55.22,0:09:56.38,Default,,0,0,0,,Ах
Dialogue: 0,0:09:59.18,0:10:01.35,Default,,0,0,0,,Эй, анау бала...
Dialogue: 0,0:10:02.89,0:10:04.10,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:10:04.18,0:10:06.81,Default,,0,0,0,,Ол өткен жылғы робот чемпионатында танымал болды.
Dialogue: 0,0:10:07.73,0:10:09.98,Default,,0,0,0,,Ол біздің ханшайымымыз.
Dialogue: 0,0:10:10.06,0:10:13.78,Default,,0,0,0,,Мен теледидарға шыққаннан кейін бір айға жуық уақыт өте керемет болды.
Dialogue: 0,0:10:13.86,0:10:16.24,Default,,0,0,0,,Жанкүйерлер тіпті мектепке келді
Dialogue: 0,0:10:16.32,0:10:17.95,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:10:18.03,0:10:21.62,Default,,0,0,0,,Неліктен біздің роботтарды зерттеу тобына қосылдыңыз?
Dialogue: 0,0:10:21.70,0:10:23.04,Default,,0,0,0,,Мен сенімен танысқым келді.
Dialogue: 0,0:10:23.12,0:10:25.54,Default,,0,0,0,,О, демек сен оның жанкүйерісің бе?
Dialogue: 0,0:10:26.16,0:10:28.21,Default,,0,0,0,,Қарапайым тілмен айтқанда, солай.
Dialogue: 0,0:10:28.29,0:10:31.59,Default,,0,0,0,,Түсіндім, енді тым болмаса мені тыңдайтын шығар.
Dialogue: 0,0:10:31.67,0:10:32.84,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:10:41.05,0:10:42.39,Default,,0,0,0,,Куруми-чан
Dialogue: 0,0:10:42.47,0:10:43.72,Default,,0,0,0,,Хмм
Dialogue: 0,0:10:44.26,0:10:45.10,Default,,0,0,0,,Хи хи
Dialogue: 0,0:10:50.19,0:10:53.98,Default,,0,0,0,,А, бұл Куруми Тайга, солай ма? мен...
Dialogue: 0,0:10:54.07,0:10:54.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:57.36,0:11:00.11,Default,,0,0,0,,А... Ақыр соңында, бұл жұмыс істемеді деп ойлаймын.
Dialogue: 0,0:11:00.20,0:11:02.91,Default,,0,0,0,,Сізбен кездесе де, не істеуім керек?
Dialogue: 0,0:11:05.83,0:11:06.66,Default,,0,0,0,,Бұл
Dialogue: 0,0:11:09.04,0:11:13.84,Default,,0,0,0,,Куруми-чан, мен бұл туралы бірдеңе жасауға тырысамын.
Dialogue: 0,0:11:13.92,0:11:17.34,Default,,0,0,0,,Не? Аа...
Dialogue: 0,0:11:17.42,0:11:18.76,Default,,0,0,0,,(♪Радиодан естілетін музыка)
Dialogue: 0,0:11:18.76,0:11:20.34,Default,,0,0,0,,(♪Радиодан естілетін музыка)
Dialogue: 0,0:11:18.76,0:11:20.34,Default,,0,0,0,,Басқа сиқыршылардың қосымша күштерінен қашқысы келген бе?
Dialogue: 0,0:11:20.43,0:11:23.22,Default,,0,0,0,,Жұмыс істемеу?
Dialogue: 0,0:11:29.94,0:11:32.10,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:11:32.19,0:11:33.77,Default,,0,0,0,,Тору~!
Dialogue: 0,0:11:34.77,0:11:35.82,Default,,0,0,0,,Ах
Dialogue: 0,0:11:41.11,0:11:41.95,Default,,0,0,0,,О
Dialogue: 0,0:11:45.08,0:11:45.91,Default,,0,0,0,,Ах
Dialogue: 0,0:11:50.58,0:11:53.50,Default,,0,0,0,,~♪
Dialogue: 0,0:11:53.58,0:11:56.04,Default,,0,0,0,,Мен осы құдай таңдаған ессіз ғалыммын…
Dialogue: 0,0:11:56.13,0:11:57.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:58.46,0:12:00.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:00.84,0:12:02.26,Default,,0,0,0,,Сізге роботтар ұнайды ма?
Dialogue: 0,0:12:02.34,0:12:04.47,Default,,0,0,0,,Иә? Иә
Dialogue: 0,0:12:04.55,0:12:08.72,Default,,0,0,0,,Мен Шин Чаннан оның роботтарға деген сүйіспеншілігі мен ынта-жігері туралы естідім.
Dialogue: 0,0:12:09.43,0:12:11.98,Default,,0,0,0,,Мен туралы не айттың?
Dialogue: 0,0:12:12.77,0:12:15.81,Default,,0,0,0,,Роботтарды ұнататын қыздар көп емес.
Dialogue: 0,0:12:15.90,0:12:17.65,Default,,0,0,0,,Мен сенімен бір күні кездескім келді.
Dialogue: 0,0:12:17.73,0:12:19.86,Default,,0,0,0,,Өйткені Куруми атақты
Dialogue: 0,0:12:21.95,0:12:23.03,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:23.11,0:12:25.99,Default,,0,0,0,,Біржақты білу дұрыс емес, солай ма?
Dialogue: 0,0:12:27.70,0:12:31.25,Default,,0,0,0,,Ю Хигаши, Джошу Хигаши орта мектебінің 1 курс студенті
Dialogue: 0,0:12:31.33,0:12:34.92,Default,,0,0,0,,Мен кумирлерді жақсы көремін және классикалық балетпен көптен бері айналысамын.
Dialogue: 0,0:12:35.00,0:12:38.67,Default,,0,0,0,,Мен Канадада орта мектептің екінші жылына дейін тұрдым, сондықтан мен ағылшын тілін жақсы білемін.
Dialogue: 0,0:12:38.75,0:12:41.26,Default,,0,0,0,,Мен роботты құрастыруда қиналдым
Dialogue: 0,0:12:41.34,0:12:42.67,Default,,0,0,0,,Мен Тамиядан сатып алдым.
Dialogue: 0,0:12:42.76,0:12:45.18,Default,,0,0,0,,Таңқаларлықтай жатық
Dialogue: 0,0:12:45.26,0:12:48.14,Default,,0,0,0,,Сіз жаңа ғана «Тамиядан робот сатып алдым» дедіңіз бе?
Dialogue: 0,0:12:48.22,0:12:49.06,Default,,0,0,0,,Иә
Dialogue: 0,0:12:49.14,0:12:52.10,Default,,0,0,0,,Бұл жақсы. Мен де жаңғақ алғым келеді.
Dialogue: 0,0:12:53.81,0:12:56.19,Default,,0,0,0,,Жаттығу Сіз әрқашан бассейнге барасыз ба?
Dialogue: 0,0:12:56.27,0:12:58.23,Default,,0,0,0,,Өйткені біз дәл қазір соғысып жатырмыз
Dialogue: 0,0:12:58.32,0:12:59.77,Default,,0,0,0,,Ұрыс?
Dialogue: 0,0:12:59.86,0:13:04.40,Default,,0,0,0,,Менің мектебім өткен жылы республикалық байқауда дизайн жүлдесін жеңіп алды.
Dialogue: 0,0:13:04.99,0:13:08.07,Default,,0,0,0,,Барлығы биыл да дизайн жүлдесін көздеп отыр.
Dialogue: 0,0:13:08.66,0:13:12.41,Default,,0,0,0,,Мен C++ немесе Java тілдерін пайдалану мүмкіндіктерін қолданғым келеді.
Dialogue: 0,0:13:12.50,0:13:15.79,Default,,0,0,0,,C++ тілін пайдалана алатыныңыз таңқаларлық.
Dialogue: 0,0:13:15.87,0:13:17.79,Default,,0,0,0,,Құрдас болсақ та, мен сені сыйлаймын.
Dialogue: 0,0:13:17.88,0:13:20.00,Default,,0,0,0,,Солай ма? Мен бақыттымын
Dialogue: 0,0:13:20.09,0:13:23.47,Default,,0,0,0,,Сіз тек дизайн арқылы ұлттық деңгейде жеңіске жете алмайсыз.
Dialogue: 0,0:13:24.09,0:13:27.22,Default,,0,0,0,,Барған сайын биікке ұмтылғым келеді.
Dialogue: 0,0:13:27.89,0:13:32.72,Default,,0,0,0,,Дегенмен, биылғы менің судағы бірінші жарысым болғандықтан, бәрі жақсы болмады.
Dialogue: 0,0:13:34.06,0:13:37.31,Default,,0,0,0,,Бұлтты бассейн мәселе сияқты естіледі.
Dialogue: 0,0:13:37.40,0:13:39.73,Default,,0,0,0,,Иә, шынымды айтсам, ол кемшіліктерге толы.
Dialogue: 0,0:13:42.98,0:13:46.20,Default,,0,0,0,,Мен өз мектебімдегі бассейнді пайдалануға рұқсат аламын ба?
Dialogue: 0,0:13:46.28,0:13:48.62,Default,,0,0,0,,Шынымен бе? бақытты!
Dialogue: 0,0:13:48.70,0:13:53.12,Default,,0,0,0,,♪~
Dialogue: 0,0:13:54.04,0:13:55.12,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:13:56.25,0:13:57.54,Default,,0,0,0,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:13:57.62,0:13:59.63,Default,,0,0,0,,Бұл Ранко Качо.
Dialogue: 0,0:13:59.71,0:14:01.17,Default,,0,0,0,,Бұл Куруми Окава.
Dialogue: 0,0:14:03.67,0:14:06.76,Default,,0,0,0,,Соңында мектеп бассейнін пайдалану мүмкін болмады.
Dialogue: 0,0:14:06.84,0:14:09.18,Default,,0,0,0,,Минамидің үйінде бассейн бар еді.
Dialogue: 0,0:14:09.26,0:14:13.43,Default,,0,0,0,,Бұл батыс пен оңтүстікті біріктірген бақытты қате есеп болды.
Dialogue: 0,0:14:13.52,0:14:17.44,Default,,0,0,0,,Аптасына бір рет бассейнде кездесе бастадық.
Dialogue: 0,0:14:46.13,0:14:47.76,Default,,0,0,0,,Рахмет робот чемпионаты
Dialogue: 0,0:14:49.05,0:14:50.39,Default,,0,0,0,,Рахмет саған, шығыс, батыс, оңтүстік
Dialogue: 0,0:14:50.47,0:14:54.14,Default,,0,0,0,,Лездік желімге ұқсас жабысқақ беріктігі бар қатайтылған
Dialogue: 0,0:14:54.22,0:14:55.39,Default,,0,0,0,,~♪
Dialogue: 0,0:14:58.98,0:15:02.15,Default,,0,0,0,,Бірге күрескен В командасының барлығы
Dialogue: 0,0:15:02.23,0:15:06.28,Default,,0,0,0,,Содан екі айға жуық уақыт бойы мен жалғыз және бөлек әрекет еттім.
Dialogue: 0,0:15:06.36,0:15:09.03,Default,,0,0,0,,Мені жылы қабылдаған барлық клуб мүшелеріне.
Dialogue: 0,0:15:09.11,0:15:09.95,Default,,0,0,0,,Сізге көп рахмет...
Dialogue: 0,0:15:09.95,0:15:11.16,Default,,0,0,0,,Сізге көп рахмет...
Dialogue: 0,0:15:09.95,0:15:11.16,Default,,0,0,0,,
Dialogue: 0,0:15:11.16,0:15:11.24,Default,,0,0,0,,
Dialogue: 0,0:15:11.24,0:15:12.66,Default,,0,0,0,,
Dialogue: 0,0:15:11.24,0:15:12.66,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:15:12.66,0:15:13.66,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:15:22.63,0:15:23.63,Default,,0,0,0,,Ах
Dialogue: 0,0:15:25.13,0:15:26.13,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:15:26.71,0:15:29.09,Default,,0,0,0,,Сен Куруми-чанмен жақсы араласатын сияқтысың.
Dialogue: 0,0:15:29.17,0:15:31.30,Default,,0,0,0,,Иә, сізге рахмет.
Dialogue: 0,0:15:32.01,0:15:33.01,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:15:33.09,0:15:35.10,Default,,0,0,0,,Фотосурет - менің хоббиім.
Dialogue: 0,0:15:35.18,0:15:39.31,Default,,0,0,0,,Мен елестер клубының мүшесімін, бірақ кейде мен магнитофон болуға жаралғанмын.
Dialogue: 0,0:15:40.48,0:15:42.85,Default,,0,0,0,,Эй, мен сенен бір нәрсе сұрасам болады ма?
Dialogue: 0,0:15:48.19,0:15:50.57,Default,,0,0,0,,Жылдам мысал.
Dialogue: 0,0:15:50.65,0:15:52.86,Default,,0,0,0,,А, міне, осы.
Dialogue: 0,0:15:54.66,0:15:56.33,Default,,0,0,0,,Сіз сүйкімді көрінесіз, солай емес пе?
Dialogue: 0,0:15:56.41,0:16:00.12,Default,,0,0,0,,Керемет Бәрін маған бер
Dialogue: 0,0:16:00.21,0:16:01.21,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:16:01.29,0:16:02.58,Default,,0,0,0,,Оны маған бір сәтке бересіз бе?
Dialogue: 0,0:16:03.12,0:16:07.05,Default,,0,0,0,,Маған неге мұны қалайтыныңды айтпасаң, мен басымды изей алмаймын.
Dialogue: 0,0:16:07.13,0:16:09.01,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:09.09,0:16:10.84,Default,,0,0,0,,Мүмкін Азума-сан шығар?
Dialogue: 0,0:16:11.38,0:16:13.05,Default,,0,0,0,,Сізге қыздар ұнайды ма?
Dialogue: 0,0:16:13.13,0:16:14.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:14.09,0:16:16.64,Default,,0,0,0,,А, жоқ, менің ойымша, бұл өте жақсы.
Dialogue: 0,0:16:16.72,0:16:18.64,Default,,0,0,0,,А, қарашы, Куруми-чан сондай сүйкімді.
Dialogue: 0,0:16:18.72,0:16:21.98,Default,,0,0,0,,Жоқ, жоқ, олай емес.
Dialogue: 0,0:16:22.85,0:16:24.98,Default,,0,0,0,,Мм... күліп тұрған жоқсың ба?
Dialogue: 0,0:16:25.06,0:16:28.23,Default,,0,0,0,,Күлмеймін, уәде беремін.
Dialogue: 0,0:16:36.24,0:16:39.45,Default,,0,0,0,,Солтүстік, оңтүстік, шығыс, батыс және Ешуден бір адам жинаңыз.
Dialogue: 0,0:16:39.54,0:16:41.83,Default,,0,0,0,,Мен айдол тобын құрғым келеді
Dialogue: 0,0:16:43.04,0:16:44.37,Default,,0,0,0,,Бұл қандай бет?
Dialogue: 0,0:16:44.46,0:16:47.67,Default,,0,0,0,,Жоқ, мен біртүрлі сенімдімін.
Dialogue: 0,0:16:47.75,0:16:49.30,Default,,0,0,0,,Куруми-чан Батыстың өкілі ме?
Dialogue: 0,0:16:49.38,0:16:54.01,Default,,0,0,0,,Иә, шынымды айтсам, мен Куруми-чанның танымалдылығын пайдаланғым келеді.
Dialogue: 0,0:16:54.09,0:16:55.72,Default,,0,0,0,,Сондықтан мен фотоға түскім келеді
Dialogue: 0,0:16:56.43,0:17:00.97,Default,,0,0,0,,Егер бір ғажайып орын алса, сіз бір ғана фотосуретпен кумирге айналуыңыз мүмкін.
Dialogue: 0,0:17:01.06,0:17:05.81,Default,,0,0,0,,Хм, қызық, Куруми-чан кумирлерге қызыға ма?
Dialogue: 0,0:17:05.90,0:17:09.27,Default,,0,0,0,,Сүйкімді қызды көрген сайын ойлаймын
Dialogue: 0,0:17:09.36,0:17:11.28,Default,,0,0,0,,Айдол болсам ғой
Dialogue: 0,0:17:11.99,0:17:14.95,Default,,0,0,0,,Куруми-чан да, Минами-сан да сондай сүйкімді.
Dialogue: 0,0:17:15.03,0:17:17.12,Default,,0,0,0,,Егер адамның өзі пұтқа қол созбаса
Dialogue: 0,0:17:17.20,0:17:19.03,Default,,0,0,0,,Сіз бола алмайсыз, солай ма?
Dialogue: 0,0:17:19.12,0:17:21.95,Default,,0,0,0,,Бұл өте ысырап.
Dialogue: 0,0:17:22.04,0:17:24.16,Default,,0,0,0,,Мен әркім менің кумирім болғанын қалаймын
Dialogue: 0,0:17:24.25,0:17:26.58,Default,,0,0,0,,Мен сол үшін мүмкіндік жасағым келеді
Dialogue: 0,0:17:29.59,0:17:32.84,Default,,0,0,0,,Пұттар жарқырайды.
Dialogue: 0,0:17:33.47,0:17:35.09,Default,,0,0,0,,Жұлдыз сияқты
Dialogue: 0,0:17:35.18,0:17:38.85,Default,,0,0,0,,Мен де осылай жарқырағым келеді.
Dialogue: 0,0:17:38.93,0:17:40.97,Default,,0,0,0,,Бұл сіздің арманыңыз
Dialogue: 0,0:17:41.72,0:17:42.97,Default,,0,0,0,,Сол Титан
Dialogue: 0,0:17:43.06,0:17:46.73,Default,,0,0,0,,Оның арман болып біткенін қаламаймын, сондықтан оны шындыққа айналдыр
Dialogue: 0,0:17:46.81,0:17:48.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:53.44,0:17:54.94,Default,,0,0,0,,Мынаны қарашы, не?
Dialogue: 0,0:17:55.65,0:17:57.20,Default,,0,0,0,,Текапо көліне сапарымнан фотосуреттер
Dialogue: 0,0:17:57.28,0:17:59.70,Default,,0,0,0,,Иә? Суретті өзіңіз түсірдіңіз бе?
Dialogue: 0,0:17:59.78,0:18:01.79,Default,,0,0,0,,Иә, мен орта мектепте оқып жүрген кезімде.
Dialogue: 0,0:18:01.87,0:18:04.00,Default,,0,0,0,,Өте әдемі
Dialogue: 0,0:18:04.08,0:18:06.37,Default,,0,0,0,,Мен әрқашан жұлдыздарды жақсы көретінмін
Dialogue: 0,0:18:06.46,0:18:09.63,Default,,0,0,0,,Бірақ оны камерамен түсіру қиын.
Dialogue: 0,0:18:09.71,0:18:12.38,Default,,0,0,0,,Жаттығу барысында мен өзімнің байланып қалғанымды түсіндім.
Dialogue: 0,0:18:13.30,0:18:15.38,Default,,0,0,0,,Маған бұл фото ұнады.
Dialogue: 0,0:18:15.47,0:18:16.51,Default,,0,0,0,,Рахмет
Dialogue: 0,0:18:18.34,0:18:22.14,Default,,0,0,0,,Егер сізге тағы бір суретке түсу керек болса, көмектесуге рұқсат етіңіз.
Dialogue: 0,0:18:22.22,0:18:23.68,Default,,0,0,0,,Хмм.
Dialogue: 0,0:18:23.77,0:18:26.31,Default,,0,0,0,,Аха, Азума-сан қызық адам екен.
Dialogue: 0,0:18:26.39,0:18:28.65,Default,,0,0,0,,Мен бақытты емеспін.
Dialogue: 0,0:18:31.90,0:18:34.53,Default,,0,0,0,,Енді солтүстікке не істеу керек?
Dialogue: 0,0:18:36.49,0:18:38.91,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:18:42.78,0:18:44.66,Default,,0,0,0,,Мүмкін… Сондықтан сендер
Dialogue: 0,0:18:46.62,0:18:47.54,Default,,0,0,0,,(Хашида) Ахаха… Мен қалай білейін! (Маюри Шиина) О, Дару-кун?
Dialogue: 0,0:18:47.62,0:18:52.00,Default,,0,0,0,,Иә, Куруми-санды көргенде, мен оны байқап көргім келді.
Dialogue: 0,0:18:52.09,0:18:54.92,Default,,0,0,0,,Куруми Менің ойымша, бұл жақсы
Dialogue: 0,0:18:55.00,0:18:56.67,Default,,0,0,0,,Така…
Dialogue: 0,0:18:56.76,0:18:59.26,Default,,0,0,0,,Ақшаға алаңдаудың қажеті жоқ.
Dialogue: 0,0:18:59.34,0:19:01.89,Default,,0,0,0,,Сіз жай ғана айтқан соманы аудара аласыз.
Dialogue: 0,0:19:03.05,0:19:04.89,Default,,0,0,0,,Куруми Мен кітап дүкеніне барғым келеді.
Dialogue: 0,0:19:04.97,0:19:07.06,Default,,0,0,0,,Жарайды, менің артымнан жүр.
Dialogue: 0,0:19:12.06,0:19:13.11,Default,,0,0,0,,Сәлем, Азума-чан
Dialogue: 0,0:19:13.19,0:19:14.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:14.69,0:19:17.57,Default,,0,0,0,,Мына балаға қараңдаршы, ол сондай сүйкімді
Dialogue: 0,0:19:17.65,0:19:21.16,Default,,0,0,0,,Басқа қыздарға қызығатындар сирек.
Dialogue: 0,0:19:23.20,0:19:26.62,Default,,0,0,0,,Ол сүйкімді, бірақ менің ойымша, ол еркектерді ұнатады.
Dialogue: 0,0:19:27.29,0:19:28.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:28.50,0:19:30.46,Default,,0,0,0,,А (Мика) Хигаши-чан?
Dialogue: 0,0:19:30.54,0:19:31.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:33.08,0:19:35.38,Default,,0,0,0,,Бұл Азума-чан ғой, солай ма?
Dialogue: 0,0:19:35.46,0:19:36.92,Default,,0,0,0,,Аа...
Dialogue: 0,0:19:37.01,0:19:40.51,Default,,0,0,0,,Мені есіңізде ме? Мика Камей
Dialogue: 0,0:19:40.59,0:19:42.89,Default,,0,0,0,,Бастауыш мектепте бір сыныпта оқыдық.
Dialogue: 0,0:19:42.97,0:19:44.93,Default,,0,0,0,,Камей мырза...?
Dialogue: 0,0:19:45.01,0:19:46.56,Default,,0,0,0,,Көптен бері көрмегелі!
Dialogue: 0,0:19:46.64,0:19:49.27,Default,,0,0,0,,Мен басқаша әсер алдым.
Dialogue: 0,0:19:49.35,0:19:52.40,Default,,0,0,0,,Иә, сізді таң қалдырғаным үшін кешіріңіз.
Dialogue: 0,0:19:53.27,0:19:54.48,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:57.07,0:19:59.78,Default,,0,0,0,,Ю Гохан
Dialogue: 0,0:19:59.86,0:20:01.49,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:20:01.57,0:20:03.99,Default,,0,0,0,,(♪Радиодан естілетін музыка)
Dialogue: 0,0:20:04.07,0:20:05.99,Default,,0,0,0,,Өйткені, жүзі бөлек.
Dialogue: 0,0:20:06.74,0:20:08.37,Default,,0,0,0,,Әдемі болды
Dialogue: 0,0:20:15.08,0:20:16.59,Default,,0,0,0,,Кита жоғары…
Dialogue: 0,0:20:16.67,0:20:19.34,Default,,0,0,0,,Солтүстік! Хмм
Dialogue: 0,0:20:20.13,0:20:22.55,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:22.63,0:20:23.84,Default,,0,0,0,,Тору~!
Dialogue: 0,0:20:26.72,0:20:27.97,Default,,0,0,0,,Тору~!
Dialogue: 0,0:20:28.93,0:20:30.35,Default,,0,0,0,,Хмм
Dialogue: 0,0:20:30.43,0:20:31.89,Default,,0,0,0,,Тору~!
Dialogue: 0,0:20:32.94,0:20:35.86,Default,,0,0,0,,~♪
Dialogue: 0,0:20:37.23,0:20:39.48,Default,,0,0,0,,Сіз тәттілерді ұнатасыз, солай ма?
Dialogue: 0,0:20:39.57,0:20:41.99,Default,,0,0,0,,Куруми-чан да, солай ма?
Dialogue: 0,0:20:42.07,0:20:43.78,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:20:43.86,0:20:46.45,Default,,0,0,0,,Екеуміздің жақындығымызды қызғанамын.
Dialogue: 0,0:20:46.53,0:20:48.74,Default,,0,0,0,,Біз көптен бері біргеміз.
Dialogue: 0,0:20:48.83,0:20:50.62,Default,,0,0,0,,Бұл біртүрлі кездесу болды.
Dialogue: 0,0:20:50.70,0:20:54.67,Default,,0,0,0,,Бұл екеуі волонтерлік жұмысқа қызығушылық таныта ма?
Dialogue: 0,0:20:54.75,0:20:56.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:02.67,0:21:05.43,Default,,0,0,0,,Сонымен, бұл солтүстік, оңтүстік, шығыс және батыстың барлығы теңестірілген дегенді білдіре ме?
Dialogue: 0,0:21:06.26,0:21:08.30,Default,,0,0,0,,Бұл бала соңғысы
Dialogue: 0,0:21:08.39,0:21:11.35,Default,,0,0,0,,«Нико Балалар»?
Dialogue: 0,0:21:11.43,0:21:15.44,Default,,0,0,0,,Иә, дәл қазір бәріміз осы блогта жариялауды жоспарлап отырмыз.
Dialogue: 0,0:21:16.10,0:21:20.94,Default,,0,0,0,,Келесі айда тауға өрмелеу болады. Бұл солтүстік, оңтүстік, шығыс және батыстағы бірінші оқиға.
Dialogue: 0,0:21:21.03,0:21:22.90,Default,,0,0,0,,Менің кезегім жақындады ма?
Dialogue: 0,0:21:22.99,0:21:25.53,Default,,0,0,0,,Жоқ, бізде арнайы фотограф бар.
Dialogue: 0,0:21:25.61,0:21:29.62,Default,,0,0,0,,Мен сүйкімді суреттерді түсіре алатыныма сенімдімін.
Dialogue: 0,0:21:30.20,0:21:34.04,Default,,0,0,0,,Қазір ойлап қарасам, Курумидің суреті 2000-ға жуық лайк жинапты.
Dialogue: 0,0:21:34.12,0:21:35.96,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:36.04,0:21:38.08,Default,,0,0,0,,Аа, көңіліңіз толмай ма?
Dialogue: 0,0:21:38.17,0:21:42.26,Default,,0,0,0,,Жарайды, мен басынан бәрі жақсы болады деп күтпедім.
Dialogue: 0,0:21:43.09,0:21:45.76,Default,,0,0,0,,Бұл жолы сүйкімді көрінудің қажеті жоқ.
Dialogue: 0,0:21:45.84,0:21:48.76,Default,,0,0,0,,Маған ерікті екенімді дәлелдеу керек.
Dialogue: 0,0:21:49.39,0:21:52.56,Default,,0,0,0,,Осындай әрекетті орындағанда, сіз жақсы адам болып көрінесіз.
Dialogue: 0,0:21:52.64,0:21:53.64,Default,,0,0,0,,Қаржы бөлімінен әкетілген адам
Dialogue: 0,0:21:55.18,0:21:58.81,Default,,0,0,0,,Кумир болған соң, өткенің бірден ашылады.
Dialogue: 0,0:21:58.90,0:22:00.15,Default,,0,0,0,,Енді мәселе.
Dialogue: 0,0:22:00.23,0:22:03.32,Default,,0,0,0,,Сол кезде ол кісі екеуміз түскен сурет табылды.
Dialogue: 0,0:22:03.40,0:22:06.82,Default,,0,0,0,,Өздерін волонтерлік жұмысқа арнаған адамдардың суреттері пайда болады.
Dialogue: 0,0:22:06.90,0:22:09.32,Default,,0,0,0,,Қайсысы көбірек ұнайды?
Dialogue: 0,0:22:09.41,0:22:12.20,Default,,0,0,0,,Мен тіпті кумир болғаннан кейін не болды деп ойлаймын.
Dialogue: 0,0:22:12.29,0:22:15.37,Default,,0,0,0,,Иә, ол өзіне тым сенімді жігіт.
Dialogue: 0,0:22:15.46,0:22:16.79,Default,,0,0,0,,Мен сені жек көрмеймін
Dialogue: 0,0:22:20.08,0:22:24.46,Default,,0,0,0,,Ай!
Dialogue: 0,0:22:25.47,0:22:27.05,Default,,0,0,0,,Мен сізден біраз уақыт сұрайын деп едім.
Dialogue: 0,0:22:27.13,0:22:27.97,Default,,0,0,0,,Иә
Dialogue: 0,0:22:28.05,0:22:31.35,Default,,0,0,0,,Неліктен кумир болу үшін соншалықты көп нәрсеге барғыңыз келеді?
Dialogue: 0,0:22:35.89,0:22:39.52,Default,,0,0,0,,Кумирді алғаш көргенде не ойладым
Dialogue: 0,0:22:39.60,0:22:42.32,Default,,0,0,0,,Адамдар жарқырайды дейді.
Dialogue: 0,0:22:43.07,0:22:46.94,Default,,0,0,0,,Содан бері мен де жарқыраудың жолын іздедім.
Dialogue: 0,0:22:47.03,0:22:49.49,Default,,0,0,0,,Басқалардан жасыру және өтірік айту
Dialogue: 0,0:22:50.45,0:22:54.08,Default,,0,0,0,,Бірақ мен сияқты адамдар көп деп ойлаймын.
Dialogue: 0,0:22:54.16,0:22:58.12,Default,,0,0,0,,Әр адамның айтып жеткізе алмайтын армандары мен ұмтылыстары болады.
Dialogue: 0,0:22:58.21,0:23:02.34,Default,,0,0,0,,Күнделікті ойланып, күш салу.
Dialogue: 0,0:23:02.42,0:23:06.26,Default,,0,0,0,,Оқымаймын десе де 100 балл алған адамдармен бірдей.
Dialogue: 0,0:23:06.34,0:23:09.72,Default,,0,0,0,,Мұндай адамдардың көзінің асты қараңғы болады.
Dialogue: 0,0:23:09.80,0:23:12.72,Default,,0,0,0,,Бірақ ондай жігіттер керемет.
Dialogue: 0,0:23:16.68,0:23:20.73,Default,,0,0,0,,Неліктен жылтыр заттар соншалықты тартымды?
Dialogue: 0,0:23:20.81,0:23:24.69,Default,,0,0,0,,Жұлдыздарды жақсы көретін Шинджикун күткендей, ол мұны өте жақсы түсінеді.
Dialogue: 0,0:23:25.65,0:23:26.73,Default,,0,0,0,,Хаха
Dialogue: 0,0:23:28.28,0:23:29.53,Default,,0,0,0,,Әр сынып үшін түрлі жарыстарға іріктеу кезеңдері өткізіледі—
Dialogue: 0,0:23:31.86,0:23:32.91,Default,,0,0,0,,Хехе
Dialogue: 0,0:23:45.88,0:23:47.05,Default,,0,0,0,,Фу
Dialogue: 0,0:23:48.17,0:23:49.01,Default,,0,0,0,,Жарайды
Dialogue: 0,0:23:49.09,0:23:51.26,Default,,0,0,0,,Иә, сіз қызып кеттіңіз.
Dialogue: 0,0:23:51.34,0:23:52.39,Default,,0,0,0,,Ах
Dialogue: 0,0:23:53.05,0:23:54.39,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:23:54.47,0:23:56.89,Default,,0,0,0,,Кешіріңіз, мен сізді өзіммен бірге шығуға мәжбүрледім.
Dialogue: 0,0:23:56.97,0:24:00.73,Default,,0,0,0,,Бұл дұрыс. Қызық болмаса мен сені кешірмеймін.
Dialogue: 0,0:24:00.81,0:24:02.48,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:24:04.23,0:24:05.65,Default,,0,0,0,,Не? Сол көзқарас
Dialogue: 0,0:24:08.36,0:24:11.40,Default,,0,0,0,,Тау қызы, бәрін алдым.
Dialogue: 0,0:24:11.49,0:24:13.41,Default,,0,0,0,,Тік орамға сәйкес келмейді
Dialogue: 0,0:24:13.49,0:24:16.41,Default,,0,0,0,,Оны алып тастауға батылдық танытудың өзі оны стильді етеді.
Dialogue: 0,0:24:17.33,0:24:20.00,Default,,0,0,0,,Иә? Бөлек топтар?
Dialogue: 0,0:24:20.08,0:24:22.79,Default,,0,0,0,,Иә, Азума-чан екеуміз бір топтамыз.
Dialogue: 0,0:24:22.87,0:24:25.38,Default,,0,0,0,,Неліктен? Төртеуің бірге емессіңдер ме?
Dialogue: 0,0:24:25.46,0:24:26.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:29.34,0:24:32.01,Default,,0,0,0,,Әй, Баба-сан.
Dialogue: 0,0:24:32.09,0:24:36.10,Default,,0,0,0,,Әй, бүгін келгендеріңізге рахмет.
Dialogue: 0,0:24:36.18,0:24:37.47,Default,,0,0,0,,Бұл жерде.
Dialogue: 0,0:24:39.56,0:24:41.27,Default,,0,0,0,,Жоқ—сол қолымды пайдаланбай-ақ ең үздікке айналу арқылы—
Dialogue: 0,0:24:41.35,0:24:43.94,Default,,0,0,0,,Топтауды енді өзгерту мүмкін емес.
Dialogue: 0,0:24:44.02,0:24:45.69,Default,,0,0,0,,(Ирис) Анашым, әкешім! Ағам мен апам да!
Dialogue: 0,0:24:46.27,0:24:50.23,Default,,0,0,0,,Бүгінгі күні әр арбаға 5 адам тіреледі.
Dialogue: 0,0:24:50.32,0:24:52.20,Default,,0,0,0,,Ендеше бірге өрмелеп көрейік
Dialogue: 0,0:24:52.82,0:24:56.03,Default,,0,0,0,,Төртеуі жас қыз болса, сен уайымдайсың.
Dialogue: 0,0:24:56.12,0:24:58.12,Default,,0,0,0,,Бірдеңе болып қалса, қиналып қаламын.
Dialogue: 0,0:24:58.91,0:25:01.70,Default,,0,0,0,,Мен бәріміз бірге өрмелей аламыз деп ойладым.
Dialogue: 0,0:25:01.79,0:25:06.33,Default,,0,0,0,,Жарайды, басқа топтағылар да жақсы адамдар.
Dialogue: 0,0:25:06.42,0:25:07.59,Default,,0,0,0,,Қарсымын!
Dialogue: 0,0:25:08.59,0:25:10.67,Default,,0,0,0,,Олай болса, танысқаныма қуаныштымын.
Dialogue: 0,0:25:11.84,0:25:14.09,Default,,0,0,0,,Бөлшектердің мағынасы жоқ
Dialogue: 0,0:25:14.76,0:25:17.68,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:25:27.19,0:25:28.61,Default,,0,0,0,,Уф
Dialogue: 0,0:25:37.87,0:25:40.53,Default,,0,0,0,,Сено (Сачи Мизуно) Уау
Dialogue: 0,0:25:46.42,0:25:48.75,Default,,0,0,0,,Иә, еңбектеріңіз үшін рахмет.
Dialogue: 0,0:25:49.75,0:25:52.42,Default,,0,0,0,,Сатқын шықты.
Dialogue: 0,0:25:56.84,0:25:57.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:01.72,0:26:02.89,Default,,0,0,0,,Шаршадыңыз ба?
Dialogue: 0,0:26:02.97,0:26:03.89,Default,,0,0,0,,Жоқ
Dialogue: 0,0:26:03.98,0:26:05.85,Default,,0,0,0,,Дегенмен—
Dialogue: 0,0:26:05.94,0:26:09.40,Default,,0,0,0,,Бұл менің бірінші оқиғам, сондықтан мен түсінбеймін.
Dialogue: 0,0:26:10.36,0:26:11.90,Default,,0,0,0,,Бұл көңілді болды ма?
Dialogue: 0,0:26:12.73,0:26:14.78,Default,,0,0,0,,Хмм...
Dialogue: 0,0:26:14.86,0:26:16.61,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:26:18.61,0:26:21.91,Default,,0,0,0,,Менімен бір топқа түскеніңіз үшін кешіріңіз.
Dialogue: 0,0:26:21.99,0:26:23.83,Default,,0,0,0,,Жоқ, олай емес...
Dialogue: 0,0:26:56.15,0:26:57.07,Default,,0,0,0,,Ах
Dialogue: 0,0:27:05.83,0:27:08.79,Default,,0,0,0,,Суға батып өлу қиын.
Dialogue: 0,0:27:10.29,0:27:12.21,Default,,0,0,0,,Иә, айуандық
Dialogue: 0,0:27:13.25,0:27:15.25,Default,,0,0,0,,Жоқ... Жоқ, бұл құмырсқа.
Dialogue: 0,0:27:15.34,0:27:17.51,Default,,0,0,0,,Куруми Менің қарным ашты.
Dialogue: 0,0:27:17.59,0:27:20.47,Default,,0,0,0,,Егер сіз сонша шу шығарсаңыз, сіз аш болуыңыз мүмкін.
Dialogue: 0,0:27:20.55,0:27:23.01,Default,,0,0,0,,Өте шулы.
Dialogue: 0,0:27:24.10,0:27:25.89,Default,,0,0,0,,Ас болсын!
Dialogue: 0,0:27:25.97,0:27:28.56,Default,,0,0,0,,А, мисо сорпасы дәмді.
Dialogue: 0,0:27:28.64,0:27:31.81,Default,,0,0,0,,Менің ойымша, дұрыс жауап үлкенірек демалыс парағын пайдалану.
Dialogue: 0,0:27:31.90,0:27:33.73,Default,,0,0,0,,Өте пайдалы
Dialogue: 0,0:27:35.27,0:27:37.74,Default,,0,0,0,,Не болды? Сондай шырмауық сияқты
Dialogue: 0,0:27:37.82,0:27:41.99,Default,,0,0,0,,Жоқ, себебі екеуі де ашулы деп ойлаймын.
Dialogue: 0,0:27:42.07,0:27:43.57,Default,,0,0,0,,Мен өз-өзімді өлтіруге тырыстым.
Dialogue: 0,0:27:43.66,0:27:44.49,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:27:44.58,0:27:47.58,Default,,0,0,0,,Шынымды айтсам, артта қалған кезде,
Dialogue: 0,0:27:47.66,0:27:49.16,Default,,0,0,0,,Иә? Бірақ солай болып шықты
Dialogue: 0,0:27:49.25,0:27:52.83,Default,,0,0,0,,Куруми-сан маған үйіне бара жатқанын айта бастады, бұл мен үшін қиын болды.
Dialogue: 0,0:27:52.92,0:27:56.59,Default,,0,0,0,,Бүгін де Азума-чан мені осында келуге мәжбүр етті.
Dialogue: 0,0:27:57.42,0:28:00.80,Default,,0,0,0,,Минами-сан екеуміз қатты уайымдап отырмыз.
Dialogue: 0,0:28:00.88,0:28:03.97,Default,,0,0,0,,Кім саған сонша қамқор болды деп ойлайсың?
Dialogue: 0,0:28:04.05,0:28:05.14,Default,,0,0,0,,(Иура) Жарайды, жарайды. (Мотоко) Оны қолыңмен тиме.
Dialogue: 0,0:28:07.10,0:28:09.02,Default,,0,0,0,,Ой, мен ақыры күлдім.
Dialogue: 0,0:28:09.10,0:28:10.56,Default,,0,0,0,,Иә
Dialogue: 0,0:28:11.14,0:28:14.27,Default,,0,0,0,,Аа, дұрыс, бұл Минами-санның бірінші рет келуі.
Dialogue: 0,0:28:14.36,0:28:17.07,Default,,0,0,0,,Джошу Кита орта мектебінен Мика Камей
Dialogue: 0,0:28:17.15,0:28:20.57,Default,,0,0,0,,Біз бұл туралы бұрын айттық, солай ма? Мұнда бірге тамақтанайық.
Dialogue: 0,0:28:20.65,0:28:22.49,Default,,0,0,0,,Ә? Шынында ма?
Dialogue: 0,0:28:23.20,0:28:26.99,Default,,0,0,0,,Мен Азума-чан бәріміз бірге болсақ бақыттырақ болар деп ойладым.
Dialogue: 0,0:28:27.70,0:28:28.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:28:29.45,0:28:33.42,Default,,0,0,0,,Камей мырза, менің атым Ранко Качо.
Dialogue: 0,0:28:33.50,0:28:34.46,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:28:34.54,0:28:37.84,Default,,0,0,0,,Иә, сіздің атыңыз Минами емес пе?
Dialogue: 0,0:28:37.92,0:28:40.84,Default,,0,0,0,,Себебі мен Сейнан Тенеритас Қыздар Академиясында оқимын.
Dialogue: 0,0:28:40.92,0:28:42.80,Default,,0,0,0,,Оңтүстік деп аталады.
Dialogue: 0,0:28:43.84,0:28:45.30,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:28:45.39,0:28:48.56,Default,,0,0,0,,Мен де Кита орта мектебінің оқушысымын, сондықтан мені Кита-чан деп атауға болады.
Dialogue: 0,0:28:48.64,0:28:51.68,Default,,0,0,0,,Не? Бұл жағдайда Курумидің де Нисши болғанын қалайсыз ба?
Dialogue: 0,0:28:51.77,0:28:53.69,Default,,0,0,0,,Не? кінә!
Dialogue: 0,0:28:53.77,0:28:56.56,Default,,0,0,0,,Біз солтүстік, оңтүстік, шығыс және батыспыз.
Dialogue: 0,0:28:56.65,0:28:57.77,Default,,0,0,0,,О!
Dialogue: 0,0:28:57.86,0:28:59.44,Default,,0,0,0,,Таңғажайып сәйкестік
Dialogue: 0,0:28:59.53,0:29:02.45,Default,,0,0,0,,Сонда Куруми - түптеп келгенде Нисши.
Dialogue: 0,0:29:02.53,0:29:04.32,Default,,0,0,0,,Баршаңыз да сапарыңызды жалғастырғанда абай болыңыздар
Dialogue: 0,0:29:07.41,0:29:10.12,Default,,0,0,0,,Эй, бұл керемет, Сакан.
Dialogue: 0,0:29:10.20,0:29:11.79,Default,,0,0,0,,Сонымен... (Мидзуно Ханаэ) Сачи
Dialogue: 0,0:29:11.87,0:29:12.96,Default,,0,0,0,,Анашым
Dialogue: 0,0:29:13.04,0:29:14.96,Default,,0,0,0,,Сачи, бұл керемет болды.
Dialogue: 0,0:29:15.04,0:29:17.04,Default,,0,0,0,,Айналасында сүйкімді ханымдар
Dialogue: 0,0:29:17.13,0:29:18.04,Default,,0,0,0,,Иә!
Dialogue: 0,0:29:18.13,0:29:20.46,Default,,0,0,0,,Біраз уақыт болды, Сакчан мама
Dialogue: 0,0:29:20.55,0:29:23.09,Default,,0,0,0,,Биыл басқа топта болдық (Мика) Иә.
Dialogue: 0,0:29:23.17,0:29:24.97,Default,,0,0,0,,Бірақ танысқаныма қуаныштымын.
Dialogue: 0,0:29:25.05,0:29:28.10,Default,,0,0,0,,Сакчан отбасы мен Мика-чан таныс.
Dialogue: 0,0:29:28.18,0:29:29.01,Default,,0,0,0,,Иә
Dialogue: 0,0:29:29.10,0:29:30.60,Default,,0,0,0,,Енді барамыз ба?
Dialogue: 0,0:29:30.68,0:29:33.56,Default,,0,0,0,,Сәлем (Мика) Сакчан, көріскенше.
Dialogue: 0,0:29:33.64,0:29:36.48,Default,,0,0,0,,Қайырлы күн (Ранко)
Dialogue: 0,0:29:39.65,0:29:42.65,Default,,0,0,0,,Қызықты уақыт өте тез өтеді.
Dialogue: 0,0:29:42.74,0:29:43.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:43.65,0:29:46.28,Default,,0,0,0,,Мен жетістікке жеткенімді сезінемін.
Dialogue: 0,0:29:46.36,0:29:47.70,Default,,0,0,0,,Курумимо
Dialogue: 0,0:29:47.78,0:29:49.45,Default,,0,0,0,,Мен қайтадан келе аламын деп үміттенемін.
Dialogue: 0,0:29:49.53,0:29:50.74,Default,,0,0,0,,Иә
Dialogue: 0,0:29:54.62,0:29:56.37,Default,,0,0,0,,Солтүстік, оңтүстік, шығыс және батыс теңестірілген уақыт
Dialogue: 0,0:29:56.46,0:29:57.88,Default,,0,0,0,,Қысқа болса да
Dialogue: 0,0:29:57.96,0:29:59.59,Default,,0,0,0,,Нәтижелері жақсы.
Dialogue: 0,0:29:59.67,0:30:02.84,Default,,0,0,0,,Мен оны мерейтой ретінде сақтағым келеді.
Dialogue: 0,0:30:09.43,0:30:12.68,Default,,0,0,0,,(шулы дауыстар)
Dialogue: 0,0:30:16.94,0:30:20.36,Default,,0,0,0,,Қызық, мектептегі фестивальде тапиока қандай болады?
Dialogue: 0,0:30:20.44,0:30:21.61,Default,,0,0,0,,Ах Куруми-сан
Dialogue: 0,0:30:21.69,0:30:23.44,Default,,0,0,0,,Куруми Окава, солай ма?
Dialogue: 0,0:30:23.53,0:30:25.44,Default,,0,0,0,,Мен сенімен суретке түсе аламын ба?
Dialogue: 0,0:30:25.53,0:30:27.99,Default,,0,0,0,,Күрсін... аа...
Dialogue: 0,0:30:28.82,0:30:30.57,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:30:33.49,0:30:35.91,Default,,0,0,0,,Өте бос емес.
Dialogue: 0,0:30:36.00,0:30:37.79,Default,,0,0,0,,Эй, мұны көргің келе ме?
Dialogue: 0,0:30:39.50,0:30:41.54,Default,,0,0,0,,Бала бақылаушы кесірткесі?
Dialogue: 0,0:30:41.63,0:30:42.96,Default,,0,0,0,,Бұл топтың аты.
Dialogue: 0,0:30:43.05,0:30:46.30,Default,,0,0,0,,Мектеп фестивалі сахнасында өнер көрсететін белгілі бір адам
Dialogue: 0,0:30:46.38,0:30:51.05,Default,,0,0,0,,Тікелей эфирдегі шоуды немесе сахналық қойылымды бірінші рет көріп отырған болсаңыз, оны бір рет көргеніңіз дұрыс деп ойлаймын.
Dialogue: 0,0:30:51.14,0:30:52.93,Default,,0,0,0,,Иә, бұл үлкен мәселе.
Dialogue: 0,0:30:53.51,0:30:55.35,Default,,0,0,0,,Олай болса, бәріміз... Куруми-чан
Dialogue: 0,0:30:55.43,0:30:57.23,Default,,0,0,0,,Ол дәл қазір қозғалды.
Dialogue: 0,0:30:57.31,0:30:59.56,Default,,0,0,0,,Әй, Сакан!
Dialogue: 0,0:31:00.40,0:31:01.86,Default,,0,0,0,,Көп уақыт болған жоқ
Dialogue: 0,0:31:01.94,0:31:03.82,Default,,0,0,0,,Иә (Мика) Сенің келетініңді білмедім.
Dialogue: 0,0:31:03.90,0:31:05.57,Default,,0,0,0,,Куруми мені шақырды.
Dialogue: 0,0:31:05.65,0:31:08.24,Default,,0,0,0,,Біз де жаңа ғана келдік.
Dialogue: 0,0:31:08.32,0:31:09.66,Default,,0,0,0,,Ендеше бірге айналамыз
Dialogue: 0,0:31:09.74,0:31:11.45,Default,,0,0,0,,О, мен жасадым! Эххе
Dialogue: 0,0:31:11.53,0:31:13.74,Default,,0,0,0,,Олай болса кеттік, кеттік!
Dialogue: 0,0:31:15.16,0:31:16.41,Default,,0,0,0,,♪~
Dialogue: 0,0:31:16.41,0:31:18.00,Default,,0,0,0,,♪~
Dialogue: 0,0:31:16.41,0:31:18.00,Default,,0,0,0,,Сәлем сахна...
Dialogue: 0,0:31:30.43,0:31:32.43,Default,,0,0,0,,О, мен түсіндім!
Dialogue: 0,0:31:32.51,0:31:34.10,Default,,0,0,0,,Жарайсың! Сакан керемет
Dialogue: 0,0:31:35.93,0:31:38.68,Default,,0,0,0,,Ол қозғалмайды, солай ма? Ол қозғалмайды, солай ма?
Dialogue: 0,0:31:38.77,0:31:40.19,Default,,0,0,0,,Ол қозғалмайды
Dialogue: 0,0:31:40.27,0:31:41.10,Default,,0,0,0,,Баа (Ранко) Жоқ!
Dialogue: 0,0:31:41.19,0:31:42.56,Default,,0,0,0,,Уау (ер студент елес ойнап жатыр) О, жоқ!
Dialogue: 0,0:31:42.65,0:31:43.81,Default,,0,0,0,,Уф...
Dialogue: 0,0:31:43.90,0:31:47.07,Default,,0,0,0,,Кешіріңіз, мен бұл уақытқа дейін барады деп ойламадым.
Dialogue: 0,0:31:49.11,0:31:50.45,Default,,0,0,0,,Маған тағы екі бере аласыз ба?
Dialogue: 0,0:31:50.53,0:31:51.91,Default,,0,0,0,,Күн ыстық, абай болыңыз. (Ер оқушы) Иә.
Dialogue: 0,0:31:51.99,0:31:53.03,Default,,0,0,0,,Рахмет (Ранко) Өтінемін, асығыңыз.
Dialogue: 0,0:31:54.20,0:31:55.08,Default,,0,0,0,,Хафф
Dialogue: 0,0:31:55.16,0:31:58.08,Default,,0,0,0,,Мен ыстық дедім~
Dialogue: 0,0:31:58.16,0:31:59.54,Default,,0,0,0,,Кристалда жарық жүздеген миллион рет шағылады—
Dialogue: 0,0:32:01.08,0:32:04.54,Default,,0,0,0,,Әйтеуір, бәрімен осылай кездескеніме қуаныштымын.
Dialogue: 0,0:32:04.63,0:32:08.30,Default,,0,0,0,,Жыл сайын өндірістік фестивальден үзіліс алатынмын.
Dialogue: 0,0:32:08.38,0:32:11.05,Default,,0,0,0,,Дүкен ашсам әуре болар деп ойладым.
Dialogue: 0,0:32:11.13,0:32:13.51,Default,,0,0,0,,Айналада жүретін ешкім жоқ.
Dialogue: 0,0:32:13.59,0:32:14.85,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:32:14.93,0:32:17.35,Default,,0,0,0,,Бірақ биыл қызық болды.
Dialogue: 0,0:32:14.93,0:32:17.35,Default,,0,0,0,,~♪
Dialogue: 0,0:32:18.02,0:32:19.22,Default,,0,0,0,,Мұнда не бар?
Dialogue: 0,0:32:21.81,0:32:23.73,Default,,0,0,0,,Сіз кіргіңіз келе ме? Иә
Dialogue: 0,0:32:23.81,0:32:26.23,Default,,0,0,0,,Ха, менің бос уақытым көп.
Dialogue: 0,0:32:26.32,0:32:27.48,Default,,0,0,0,,Ах
Dialogue: 0,0:32:27.57,0:32:28.78,Default,,0,0,0,,A-ra
Dialogue: 0,0:32:28.86,0:32:30.19,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:32:30.28,0:32:31.45,Default,,0,0,0,,Уау
Dialogue: 0,0:32:32.99,0:32:34.20,Default,,0,0,0,,Иә? Бұл өтірік.
Dialogue: 0,0:32:34.28,0:32:36.45,Default,,0,0,0,,Иә? Аа, еңбегіңіз үшін рахмет
Dialogue: 0,0:32:36.53,0:32:37.74,Default,,0,0,0,,Шин-чан
Dialogue: 0,0:32:37.83,0:32:40.08,Default,,0,0,0,,Жоқ, кіріңіз, кіріңіз.
Dialogue: 0,0:32:40.16,0:32:43.33,Default,,0,0,0,,Жарайды, енді ешкім келмейтіндіктен жабайын деп ойладым.
Dialogue: 0,0:32:43.42,0:32:44.79,Default,,0,0,0,,...
Dialogue: 0,0:32:44.88,0:32:47.42,Default,,0,0,0,,Олай болса, ханымдар.
Dialogue: 0,0:32:47.50,0:32:50.46,Default,,0,0,0,,Осы жерден кигіңіз келетін киімді таңдаңыз.
Dialogue: 0,0:32:50.55,0:32:53.47,Default,,0,0,0,,Бұл менің дәл қазір кигім келетін киім емес.
Dialogue: 0,0:32:53.55,0:32:54.93,Default,,0,0,0,,10 жылдан кейін елестетіңізші
Dialogue: 0,0:32:55.01,0:32:56.22,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:32:56.30,0:32:57.18,Default,,0,0,0,,Бұл жақсырақ
Dialogue: 0,0:32:57.26,0:32:59.68,Default,,0,0,0,,Бұл уақыт капсуласы сияқты, қызық емес пе?
Dialogue: 0,0:32:59.77,0:33:01.93,Default,,0,0,0,,Суретке түсіруді маған қалдырыңыз
Dialogue: 0,0:33:03.44,0:33:05.23,Default,,0,0,0,,Жаңғақ, мұны істейік.
Dialogue: 0,0:33:05.31,0:33:06.98,Default,,0,0,0,,Сачиге бұл ұнайды
Dialogue: 0,0:33:07.06,0:33:08.82,Default,,0,0,0,,Сіз косплейдің қандай түрін ойнап жатырсыз?
Dialogue: 0,0:33:09.98,0:33:11.03,Default,,0,0,0,,Идол!
Dialogue: 0,0:33:11.11,0:33:14.32,Default,,0,0,0,,Сакчан айдолдарды жақсы көреді, солай ма?
Dialogue: 0,0:33:20.37,0:33:23.75,Default,,0,0,0,,Бірақ Сачи әлі де қалыңдық үлгісін киеді.
Dialogue: 0,0:33:23.83,0:33:25.58,Default,,0,0,0,,Неге?
Dialogue: 0,0:33:25.67,0:33:28.04,Default,,0,0,0,,Неге сен кумиріңнің көйлегін кимейсің?
Dialogue: 0,0:33:28.13,0:33:32.38,Default,,0,0,0,,Жоқ, мен Сачиден гөрі Азума кигенін қалаймын.
Dialogue: 0,0:33:36.26,0:33:38.35,Default,,0,0,0,,Онда мен оны киемін.
Dialogue: 0,0:33:39.64,0:33:41.01,Default,,0,0,0,,Иә!
Dialogue: 0,0:33:44.10,0:33:47.02,Default,,0,0,0,,Ухуху-ахха...
Dialogue: 0,0:33:58.32,0:33:59.32,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:33:59.41,0:34:00.70,Default,,0,0,0,,А, сәл күте тұрыңыз
Dialogue: 0,0:34:00.78,0:34:02.45,Default,,0,0,0,,Суретке түскіңіз келсе, түсіремін деңіз.
Dialogue: 0,0:34:02.54,0:34:05.50,Default,,0,0,0,,Уайымдамаңыз, мен жақсы суретке түсіре алдым.
Dialogue: 0,0:34:09.42,0:34:12.84,Default,,0,0,0,,Куруми-чан, тез қайтпасам жақсы ма?
Dialogue: 0,0:34:12.92,0:34:14.76,Default,,0,0,0,,Шинигами қалай өледі екен.
Dialogue: 0,0:34:14.84,0:34:16.30,Default,,0,0,0,,Біз де киімімізді ауыстырайық па?
Dialogue: 0,0:34:17.47,0:34:19.18,Default,,0,0,0,,А, Хигаши-чан?
Dialogue: 0,0:34:19.26,0:34:21.93,Default,,0,0,0,,Сол көйлекті кигеніңіз үшін рахмет.
Dialogue: 0,0:34:22.01,0:34:24.31,Default,,0,0,0,,Нағыз кумирге ұқсайды
Dialogue: 0,0:34:24.39,0:34:25.81,Default,,0,0,0,,Ах
Dialogue: 0,0:34:28.85,0:34:33.11,Default,,0,0,0,,Егер мен нағыз кумир болсам, сен бақытты болар ма едің?
Dialogue: 0,0:34:33.19,0:34:34.40,Default,,0,0,0,,Иә!
Dialogue: 0,0:34:34.49,0:34:36.15,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:34:38.99,0:34:41.16,Default,,0,0,0,,Бұл болады, мен уәде беремін.
Dialogue: 0,0:34:42.74,0:34:45.16,Default,,0,0,0,,Иә, мен уәде беремін.
Dialogue: 0,0:35:04.43,0:35:06.43,Default,,0,0,0,,Келесі жоспар...
Dialogue: 0,0:35:09.77,0:35:14.44,Default,,0,0,0,,Бұл ерікті болуға өтініш берген Хигаши. Көмегіңіз үшін рақмет.
Dialogue: 0,0:35:16.86,0:35:18.95,Default,,0,0,0,,Ах (қол шапалақтау)
Dialogue: 0,0:35:19.03,0:35:21.20,Default,,0,0,0,,Қош келдіңіз Азима-сан
Dialogue: 0,0:35:21.28,0:35:25.20,Default,,0,0,0,,Келгеніңізге рахмет, Итами.
Dialogue: 0,0:35:25.29,0:35:26.29,Default,,0,0,0,,Бұл Азума.
Dialogue: 0,0:35:26.37,0:35:30.37,Default,,0,0,0,,А, сен осы маңдағы мұражайға бардың ба?
Dialogue: 0,0:35:30.46,0:35:32.71,Default,,0,0,0,,Жоқ, әлі жоқ.
Dialogue: 0,0:35:32.79,0:35:35.67,Default,,0,0,0,,Бұл мен өткен күні апардым.
Dialogue: 0,0:35:35.75,0:35:38.30,Default,,0,0,0,,Қараңдаршы, мынау керемет.
Dialogue: 0,0:35:38.38,0:35:40.18,Default,,0,0,0,,Иә...
Dialogue: 0,0:35:40.26,0:35:41.80,Default,,0,0,0,,Коракора-кун
Dialogue: 0,0:35:41.89,0:35:44.35,Default,,0,0,0,,Аджима-сан қиналып жатыр емес пе?
Dialogue: 0,0:35:44.43,0:35:45.64,Default,,0,0,0,,О
Dialogue: 0,0:35:46.72,0:35:48.89,Default,,0,0,0,,Келесі операция - Огури сарайы.
Dialogue: 0,0:35:49.73,0:35:54.52,Default,,0,0,0,,Атақты ойынның орналасуына байланысты шетелдік туристер саны тез өсті.
Dialogue: 0,0:35:54.61,0:35:56.65,Default,,0,0,0,,Орюджо сарайына қош келдіңіз.
Dialogue: 0,0:35:56.73,0:35:58.24,Default,,0,0,0,,Уау! Мен тарихты түсіндіремін
Dialogue: 0,0:35:58.32,0:36:01.28,Default,,0,0,0,,қамал мұнарасына кірер алдында.
Dialogue: 0,0:36:02.11,0:36:06.03,Default,,0,0,0,,Ыстық нүкте ретінде міндетті түрде теледидарды қамту болады.
Dialogue: 0,0:36:06.79,0:36:10.75,Default,,0,0,0,,Төртеуміз бірге волонтер гид ретінде теледидарға шығуды жоспарлап отырмыз.
Dialogue: 0,0:36:15.54,0:36:20.09,Default,,0,0,0,,Менің талап етуім бойынша барлығы гидтерге қосылғанына бірнеше апта болды.
Dialogue: 0,0:36:20.80,0:36:23.09,Default,,0,0,0,,Көптен күткен күн де ​​келіп жетті.
Dialogue: 0,0:36:24.68,0:36:26.10,Default,,0,0,0,,Білмеймін.
Dialogue: 0,0:36:26.18,0:36:27.43,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:36:29.10,0:36:30.85,Default,,0,0,0,,Барлығыңызбен танысқаныма қуаныштымын.
Dialogue: 0,0:36:30.93,0:36:34.40,Default,,0,0,0,,Мен Elmix деп аталатын өндірістік компанияда администратор болып жұмыс істеймін.
Dialogue: 0,0:36:34.48,0:36:35.36,Default,,0,0,0,,Бұл Кога.
Dialogue: 0,0:36:35.44,0:36:37.57,Default,,0,0,0,,Бүгінгі көмегіңіз үшін рахмет.
Dialogue: 0,0:36:37.65,0:36:39.86,Default,,0,0,0,,Мен теледидардан бірінші рет сұхбат беріп отырмын.
Dialogue: 0,0:36:39.94,0:36:41.90,Default,,0,0,0,,Қызық көрінеді.
Dialogue: 0,0:36:41.99,0:36:43.16,Default,,0,0,0,,Куруми-чан ше?
Dialogue: 0,0:36:43.24,0:36:44.53,Default,,0,0,0,,Ол бүгін келмейді.
Dialogue: 0,0:36:44.62,0:36:45.66,Default,,0,0,0,,Не!
Dialogue: 0,0:36:48.87,0:36:50.75,Default,,0,0,0,,Иә (Кога) Көремін, көремін.
Dialogue: 0,0:36:50.83,0:36:51.41,Default,,0,0,0,,Содан кейін деректерді кейінірек ала аламын ба?
Dialogue: 0,0:36:51.41,0:36:53.04,Default,,0,0,0,,Содан кейін деректерді кейінірек ала аламын ба?
Dialogue: 0,0:36:51.41,0:36:53.04,Default,,0,0,0,,көрсетілмейді
Dialogue: 0,0:36:53.12,0:36:54.67,Default,,0,0,0,,Иә (Кога) Әй, бұл да.
Dialogue: 0,0:36:54.75,0:36:56.29,Default,,0,0,0,,Иә (Кога) Менің де сұрағым бар.
Dialogue: 0,0:36:56.38,0:36:58.55,Default,,0,0,0,,Маған кез келген нәрсені сұраңыз
Dialogue: 0,0:36:58.63,0:36:59.92,Default,,0,0,0,,«Біз "екінші Кира" бағыты бойынша тергеу жүргізіп жатырмыз» және олардың ынтымақтастығын сұраймыз.
Dialogue: 0,0:37:00.01,0:37:01.59,Default,,0,0,0,,Жоғары сынып оқушылары
Dialogue: 0,0:37:01.67,0:37:04.05,Default,,0,0,0,,Сізді фотоға түсіру қызметін ұсынатыныңызды естідім.
Dialogue: 0,0:37:04.84,0:37:08.26,Default,,0,0,0,,Мен камераға жауаптымын, ал мен ағылшын тілінде жетекшімін.
Dialogue: 0,0:37:08.35,0:37:10.02,Default,,0,0,0,,Ах, бұл Ю Хигаши.
Dialogue: 0,0:37:10.10,0:37:12.98,Default,,0,0,0,,Хигаши-чан, сен ағылшынша сөйлей аласың ба?
Dialogue: 0,0:37:13.06,0:37:16.06,Default,,0,0,0,,Иә, бірақ мен тарихтан жақсы емеспін.
Dialogue: 0,0:37:16.15,0:37:18.48,Default,,0,0,0,,Әркім нұсқаулықтың мазмұны туралы ойлансын.
Dialogue: 0,0:37:18.57,0:37:21.11,Default,,0,0,0,,Барлығы сондай сүйкімді
Dialogue: 0,0:37:21.19,0:37:23.36,Default,,0,0,0,,...
Dialogue: 0,0:37:23.45,0:37:26.24,Default,,0,0,0,,...
Dialogue: 0,0:37:26.32,0:37:30.99,Default,,0,0,0,,Біз солтүстіктен, оңтүстіктен, шығыстан, батыстан осы қамалға келеміз.
Dialogue: 0,0:37:31.08,0:37:33.46,Default,,0,0,0,,Менің атым Кадори.
Dialogue: 0,0:37:33.54,0:37:36.63,Default,,0,0,0,,Адамдар мені Минами-сан деп атайды, өйткені мен оңтүстіктенмін.
Dialogue: 0,0:37:36.71,0:37:37.75,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:37:37.83,0:37:41.63,Default,,0,0,0,,...
Dialogue: 0,0:37:41.71,0:37:43.88,Default,,0,0,0,,Солай етіңіз!
Dialogue: 0,0:37:53.93,0:37:55.73,Default,,0,0,0,,Куруми-чан ше?
Dialogue: 0,0:37:55.81,0:37:57.52,Default,,0,0,0,,Көпке дейін шықпайды.
Dialogue: 0,0:37:58.40,0:37:59.82,Default,,0,0,0,,Өйткені бұл үлкен мәселе
Dialogue: 0,0:37:59.90,0:38:02.57,Default,,0,0,0,,...
Dialogue: 0,0:38:09.62,0:38:11.03,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:38:11.12,0:38:13.83,Default,,0,0,0,,...
Dialogue: 0,0:38:13.91,0:38:15.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:15.12,0:38:18.46,Default,,0,0,0,,...
Dialogue: 0,0:38:18.54,0:38:21.92,Default,,0,0,0,,Біз тек волонтерлік қызмет арқылы байланысқан сияқтымыз.
Dialogue: 0,0:38:22.00,0:38:23.55,Default,,0,0,0,,Мұндай жерде дүкен ашу—
Dialogue: 0,0:38:23.63,0:38:26.17,Default,,0,0,0,,Тек осылай айтсаң түсіну оңайырақ...
Dialogue: 0,0:38:26.26,0:38:29.01,Default,,0,0,0,,...
Dialogue: 0,0:38:29.09,0:38:31.81,Default,,0,0,0,,Осыны дұрыс айтқаныңызды қалаймын.
Dialogue: 0,0:38:31.89,0:38:33.72,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:38:33.81,0:38:36.18,Default,,0,0,0,,Азума-санның да жаман ниеті жоқ деп ойлаймын.
Dialogue: 0,0:38:41.65,0:38:43.44,Default,,0,0,0,,Осы жерден жалғастырыңыз
Dialogue: 0,0:38:43.53,0:38:46.36,Default,,0,0,0,,Келесі орын осында: Огури сарайы
Dialogue: 0,0:38:46.45,0:38:50.66,Default,,0,0,0,,Бұл қазір танымал орын, себебі ол әйгілі ойынның орны болды.
Dialogue: 0,0:38:50.74,0:38:53.37,Default,,0,0,0,,...
Dialogue: 0,0:38:53.45,0:38:55.62,Default,,0,0,0,,Мен сіздің әңгімеңізді естідім.
Dialogue: 0,0:38:56.58,0:39:00.13,Default,,0,0,0,,Барлығыңыз мұнда күнде гид болып жұмыс істейсіздер, солай ма?
Dialogue: 0,0:39:00.21,0:39:04.67,Default,,0,0,0,,...
Dialogue: 0,0:39:04.76,0:39:06.26,Default,,0,0,0,,Мен өте бос емеспін.
Dialogue: 0,0:39:06.34,0:39:09.76,Default,,0,0,0,,Е-е, сенбі және жексенбі күндері жергілікті орта мектеп оқушылары да барады.
Dialogue: 0,0:39:09.84,0:39:15.14,Default,,0,0,0,,...
Dialogue: 0,0:39:15.22,0:39:18.39,Default,,0,0,0,,Рахмет сізге ата
Dialogue: 0,0:39:18.48,0:39:21.35,Default,,0,0,0,,Юу Бұл аздап көрінді.
Dialogue: 0,0:39:21.44,0:39:24.52,Default,,0,0,0,,Робокондық бала кім? Біз әрқашан біргеміз
Dialogue: 0,0:39:26.32,0:39:28.28,Default,,0,0,0,,Соңында жойылды.
Dialogue: 0,0:39:31.45,0:39:32.28,Default,,0,0,0,,Ах~
Dialogue: 0,0:39:46.17,0:39:47.80,Default,,0,0,0,,Хмм
Dialogue: 0,0:39:48.84,0:39:51.01,Default,,0,0,0,,Уф
Dialogue: 0,0:39:52.68,0:39:53.68,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:39:53.76,0:39:57.14,Default,,0,0,0,,Ах, Аджима-сан, ақыры шықтың.
Dialogue: 0,0:39:57.22,0:39:59.89,Default,,0,0,0,,Соңғы уақытта бос емессіз бе? Жолсерік те...
Dialogue: 0,0:39:59.98,0:40:01.69,Default,,0,0,0,,Мен оқумен айналысамын
Dialogue: 0,0:40:01.77,0:40:04.61,Default,,0,0,0,,А... шынымен солай ма?
Dialogue: 0,0:40:04.69,0:40:06.61,Default,,0,0,0,,Ыңғайлы болса барамын.
Dialogue: 0,0:40:06.69,0:40:09.99,Default,,0,0,0,,Негізі, кешегі теледидардағы адам еді.
Dialogue: 0,0:40:10.07,0:40:12.70,Default,,0,0,0,,Ол хабарласқысы келетінін айтты.
Dialogue: 0,0:40:14.53,0:40:15.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:19.37,0:40:21.54,Default,,0,0,0,,Ах, Хигаши-ччи~
Dialogue: 0,0:40:21.62,0:40:22.46,Default,,0,0,0,,Ах
Dialogue: 0,0:40:22.54,0:40:25.04,Default,,0,0,0,,Ха ха ха ха ха~
Dialogue: 0,0:40:25.13,0:40:26.96,Default,,0,0,0,,Мазалағаным үшін кешіріңіз
Dialogue: 0,0:40:27.05,0:40:29.26,Default,,0,0,0,,Келгендеріңізге рахмет.
Dialogue: 0,0:40:29.34,0:40:34.26,Default,,0,0,0,,3-ші жыл еңбек өтілі, Жардың шетіндегі АД-ның өтініші бар.
Dialogue: 0,0:40:34.93,0:40:38.14,Default,,0,0,0,,Шындығында, мен өткен күні қарастырған бағдарламадан басқа,
Dialogue: 0,0:40:38.22,0:40:40.02,Default,,0,0,0,,Менде тағы бір зат бар.
Dialogue: 0,0:40:42.02,0:40:47.15,Default,,0,0,0,,Бұл жұма күндері түнгі эстрадалық шоу, бірақ мен оны осы жолы күшейтуді шештім.
Dialogue: 0,0:40:47.23,0:40:48.82,Default,,0,0,0,,Мен сенің сонда көрінуіңді қалаймын.
Dialogue: 0,0:40:48.90,0:40:51.28,Default,,0,0,0,,Га (Ранко) Біз?
Dialogue: 0,0:40:51.36,0:40:55.57,Default,,0,0,0,,Жоспарлау жиналысында мен оларға Огури сарайынан қызықты балалар тапқанымды айттым.
Dialogue: 0,0:40:55.66,0:40:57.99,Default,,0,0,0,,Сіз оны қолданып көргіңіз келе ме?
Dialogue: 0,0:40:58.08,0:40:59.83,Default,,0,0,0,,Бұл сіздің бірінші мүмкіндігіңіз.
Dialogue: 0,0:41:01.41,0:41:05.75,Default,,0,0,0,,Жазу күнін барлығына лайықтап реттейміз және, әрине, ата-аналарға да түсіндіреміз.
Dialogue: 0,0:41:05.83,0:41:09.17,Default,,0,0,0,,Ол қызықты болуы керек: шығыс, батыс, солтүстік, оңтүстік.
Dialogue: 0,0:41:09.25,0:41:11.38,Default,,0,0,0,,Бәріміз бірге болайық
Dialogue: 0,0:41:11.46,0:41:12.47,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:41:12.55,0:41:14.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:15.01,0:41:17.35,Default,,0,0,0,,Біз оны оң бағалаймыз.
Dialogue: 0,0:41:17.43,0:41:21.31,Default,,0,0,0,,Шынымен бе? Олай болса, алдымен аздап түсіндірейін...
Dialogue: 0,0:41:23.73,0:41:25.10,Default,,0,0,0,,Сіз не ойладыңыз?
Dialogue: 0,0:41:25.19,0:41:26.65,Default,,0,0,0,,Бұрынғы оқиға туралы не деуге болады?
Dialogue: 0,0:41:26.73,0:41:27.56,Default,,0,0,0,,Иә
Dialogue: 0,0:41:27.65,0:41:29.86,Default,,0,0,0,,Мені қатты қызықтырады.
Dialogue: 0,0:41:29.94,0:41:31.32,Default,,0,0,0,,Сіз тестілеуші ​​болсаңыз да?
Dialogue: 0,0:41:31.40,0:41:34.40,Default,,0,0,0,,Иә, айналамдағылар солай айтады.
Dialogue: 0,0:41:35.32,0:41:36.20,Default,,0,0,0,,Куруми туралы не деуге болады?
Dialogue: 0,0:41:37.53,0:41:40.70,Default,,0,0,0,,Мен маңызды нәрсеге алаңдаймын.
Dialogue: 0,0:41:40.79,0:41:44.21,Default,,0,0,0,,Мен мұны да түсінбеймін.
Dialogue: 0,0:41:44.29,0:41:47.71,Default,,0,0,0,,Бірақ мен бірінші рет көп нәрсені сынап көрдім.
Dialogue: 0,0:41:47.79,0:41:49.29,Default,,0,0,0,,Бұл жаман болған жоқ.
Dialogue: 0,0:41:49.38,0:41:51.71,Default,,0,0,0,,Мен Куруми-саннан компьютер туралы да білдім.
Dialogue: 0,0:41:54.26,0:41:56.89,Default,,0,0,0,,Бәрібір жасап көрейік.
Dialogue: 0,0:42:00.47,0:42:01.43,Default,,0,0,0,,Иә
Dialogue: 0,0:42:04.31,0:42:07.81,Default,,0,0,0,,А, сәлем, Кога мырза, барлығы рұқсат алды.
Dialogue: 0,0:42:07.90,0:42:08.40,Default,,0,0,0,,(♪Радиодан естілетін музыка)
Dialogue: 0,0:42:08.40,0:42:11.19,Default,,0,0,0,,(♪Радиодан естілетін музыка)
Dialogue: 0,0:42:08.40,0:42:11.19,Default,,0,0,0,,А, иә, рахмет.
Dialogue: 0,0:42:13.65,0:42:16.28,Default,,0,0,0,,Иә! Ух хе хе
Dialogue: 0,0:42:17.28,0:42:21.20,Default,,0,0,0,,Ухуху уа уа
Dialogue: 0,0:42:30.54,0:42:34.21,Default,,0,0,0,,~♪
Dialogue: 0,0:42:41.85,0:42:43.47,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:42:43.56,0:42:47.23,Default,,0,0,0,,Олай болса бастау уақыты келді
Dialogue: 0,0:42:47.31,0:42:49.48,Default,,0,0,0,,3 2…
Dialogue: 0,0:42:51.23,0:42:53.82,Default,,0,0,0,,Солтүстік, оңтүстік, шығыс және батыс бұрыштары!
Dialogue: 0,0:42:55.61,0:42:59.53,Default,,0,0,0,,Міне, біздің дауылды күндеріміз басталды.
Dialogue: 0,0:43:00.24,0:43:04.04,Default,,0,0,0,,Бұл менің бірінші рет болды, сондықтан мен қобалжып, абдырап қалдым.
Dialogue: 0,0:43:04.79,0:43:08.37,Default,,0,0,0,,Төртеумізге әртүрлі нәрселерді сынап көру қызық.
Dialogue: 0,0:43:09.12,0:43:11.46,Default,,0,0,0,,Ранко Качоның күшті мінезі
Dialogue: 0,0:43:12.17,0:43:15.46,Default,,0,0,0,,Куруми Тайганың жойқын күлкісі
Dialogue: 0,0:43:15.55,0:43:17.97,Default,,0,0,0,,Мика Камейдің барлығына ұнайтын келбеті
Dialogue: 0,0:43:18.84,0:43:23.31,Default,,0,0,0,,Мұқият таңдаған мүшелер Көзімде ешнәрсе болмады
Dialogue: 0,0:43:24.06,0:43:27.89,Default,,0,0,0,,Шығыс, батыс, солтүстік, оңтүстік, бірте-бірте, бірақ тұрақты
Dialogue: 0,0:43:27.98,0:43:29.85,Default,,0,0,0,,Әлемге танылды
Dialogue: 0,0:43:36.78,0:43:41.66,Default,,0,0,0,,Енді сіздің туған күніңіздегі тосынсыйыңыз қаншалықты қымбат болса да,
Dialogue: 0,0:43:41.74,0:43:44.83,Default,,0,0,0,,Ұсыныс қаншалықты қызық болса да,
Dialogue: 0,0:43:44.91,0:43:47.16,Default,,0,0,0,,Мен ешқашан мұндай бақытты болған емеспін.
Dialogue: 0,0:43:47.91,0:43:53.71,Default,,0,0,0,,Мұны ностальгия деп атай аламыз ба?
Dialogue: 0,0:44:00.51,0:44:03.05,Default,,0,0,0,,Не, келесі аптада студияда?
Dialogue: 0,0:44:03.64,0:44:05.10,Default,,0,0,0,,Иә
Dialogue: 0,0:44:06.26,0:44:07.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:08.27,0:44:09.56,Default,,0,0,0,,Иә!
Dialogue: 0,0:44:15.15,0:44:16.02,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:44:16.98,0:44:17.86,Default,,0,0,0,,Уау
Dialogue: 0,0:44:18.36,0:44:21.53,Default,,0,0,0,,Ху~ Сіз атақты адамға ұқсайсыз.
Dialogue: 0,0:44:21.61,0:44:22.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:23.66,0:44:26.74,Default,,0,0,0,,Сәлемдеуді қатты дауыспен айту керек.
Dialogue: 0,0:44:36.75,0:44:38.88,Default,,0,0,0,,Уау...
Dialogue: 0,0:44:41.38,0:44:43.05,Default,,0,0,0,,Мен Изуку Мидориямын!
Dialogue: 0,0:44:43.13,0:44:45.18,Default,,0,0,0,,Өтінемін (қол шапалақтау)
Dialogue: 0,0:44:47.51,0:44:49.81,Default,,0,0,0,,Хабарландырулар бар ма?
Dialogue: 0,0:44:49.89,0:44:53.98,Default,,0,0,0,,Иә, шын мәнінде, жаңа жоба осында!
Dialogue: 0,0:44:55.40,0:44:56.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:58.15,0:44:59.65,Default,,0,0,0,,Маңызды хабарландыру
Dialogue: 0,0:44:59.73,0:45:04.49,Default,,0,0,0,,Тозай Нанбоку (алдын ала) Idol дебюттік жобасы басталады!
Dialogue: 0,0:45:04.57,0:45:07.45,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:45:10.04,0:45:14.62,Default,,0,0,0,,Орта мектеп оқушыларының өнерпаздық бұрышы көпшіліктің көңілінен шықты.
Dialogue: 0,0:45:14.71,0:45:18.42,Default,,0,0,0,,Жоспар өзгертіліп, солтүстік, оңтүстік, шығыс және батыс пұтқа айналды.
Dialogue: 0,0:45:18.50,0:45:20.92,Default,,0,0,0,,Өсу тарихына айналды
Dialogue: 0,0:45:21.51,0:45:24.97,Default,,0,0,0,,Сол жерден көзді ашып-жұмғанша іс өтті.
Dialogue: 0,0:45:25.05,0:45:27.30,Default,,0,0,0,,Барлығы дайындалды
Dialogue: 0,0:45:27.89,0:45:30.81,Default,,0,0,0,,Бұл үлкендер әлемі
Dialogue: 0,0:45:31.60,0:45:36.06,Default,,0,0,0,,Дебюттік хабарландыруға дайындық кезінде мен барған сайын қарбалас болдым.
Dialogue: 0,0:45:36.15,0:45:37.90,Default,,0,0,0,,Жаңа әндер бойынша сабақ алу кезінде
Dialogue: 0,0:45:38.52,0:45:43.28,Default,,0,0,0,,Мектеп, жұмыс және өздігінен оқудың жылдам қарқыны
Dialogue: 0,0:45:44.28,0:45:46.03,Default,,0,0,0,,Көптен күткен күндер
Dialogue: 0,0:45:46.11,0:45:49.78,Default,,0,0,0,,Сіз бір кездері көрмей қалған жұлдызға жете аласыз
Dialogue: 0,0:45:50.74,0:45:53.00,Default,,0,0,0,,Ойын осы жерден басталады.
Dialogue: 0,0:45:53.08,0:45:58.42,Default,,0,0,0,,Біз үшін Солтүстік, Оңтүстік, Шығыс, Батыс, шынайы пұтқа айналу.
Dialogue: 0,0:45:58.50,0:45:59.63,Default,,0,0,0,,Мен бәріне қамқор боламын
Dialogue: 0,0:46:00.46,0:46:03.63,Default,,0,0,0,,Мен оны одан сайын жарқыратамын
Dialogue: 0,0:46:03.72,0:46:06.84,Default,,0,0,0,,♪~
Dialogue: 0,0:46:33.29,0:46:36.21,Default,,0,0,0,,~♪
Dialogue: 0,0:46:36.29,0:46:39.71,Default,,0,0,0,,(Пойыздың жүгіру дыбысы)
Dialogue: 0,0:46:46.88,0:46:51.18,Default,,0,0,0,,Сен, қара нәсілді жексұрын!
Dialogue: 0,0:47:04.15,0:47:06.15,Default,,0,0,0,,Жақында
Dialogue: 0,0:47:06.24,0:47:07.65,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:47:10.82,0:47:12.49,Default,,0,0,0,,Жарайды (Мика) Иә.
Dialogue: 0,0:47:22.75,0:47:24.67,Default,,0,0,0,,Шеңбер құрайық па?
Dialogue: 0,0:47:24.75,0:47:27.38,Default,,0,0,0,,«бәріміз тартынған оқиға орнына бардық —»
Dialogue: 0,0:47:38.52,0:47:41.77,Default,,0,0,0,,Шарасыз орындайық
Dialogue: 0,0:47:42.40,0:47:43.40,Default,,0,0,0,,Иә
Dialogue: 0,0:47:43.48,0:47:45.02,Default,,0,0,0,,Иә
Dialogue: 0,0:47:45.11,0:47:46.32,Default,,0,0,0,,Иә
Dialogue: 0,0:47:46.86,0:47:48.28,Default,,0,0,0,,Көңілді болайық
Dialogue: 0,0:47:49.28,0:47:50.24,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:47:50.32,0:47:52.74,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,0:48:06.05,0:48:09.92,Default,,0,0,0,,♪ Тек маңызды емес нәрселер
Dialogue: 0,0:48:10.01,0:48:14.26,Default,,0,0,0,,♪ Әңгімелесіп күлейік
Dialogue: 0,0:48:14.35,0:48:18.35,Default,,0,0,0,,♪ Бір-бірімізден өтіп, ғашық боламыз
Dialogue: 0,0:48:18.43,0:48:21.69,Default,,0,0,0,,♪ Тілегіңді орында
Dialogue: 0,0:48:21.77,0:48:25.19,Default,,0,0,0,,♪ Мен бірдеңе іздеп жүрмін, ол жеткіліксіз
Dialogue: 0,0:48:25.27,0:48:26.57,Default,,0,0,0,,♪ Сондай күндерде
Dialogue: 0,0:48:26.65,0:48:29.61,Default,,0,0,0,,♪ Адамдар сияқты.
Dialogue: 0,0:48:29.69,0:48:32.61,Default,,0,0,0,,♪ Бүгін де арманда Латтата
Dialogue: 0,0:48:32.70,0:48:34.82,Default,,0,0,0,,♪ Латтата желде
Dialogue: 0,0:48:34.91,0:48:37.24,Default,,0,0,0,,♪ Ән мәтінінің бір жерінде
Dialogue: 0,0:48:37.33,0:48:39.50,Default,,0,0,0,,♪ Болған болуы мүмкін
Dialogue: 0,0:48:39.58,0:48:43.25,Default,,0,0,0,,♪ Мен көрдім! «Бұл сенің ішіңде»
Dialogue: 0,0:48:43.33,0:48:44.92,Default,,0,0,0,,♪ Бірақ сіз қандай болғыңыз келсе
Dialogue: 0,0:48:45.00,0:48:46.25,Default,,0,0,0,,♪ Бір ғана емес
Dialogue: 0,0:48:46.34,0:48:49.34,Default,,0,0,0,,♪ Ешкім жалғыз емес
Dialogue: 0,0:48:56.76,0:48:59.85,Default,,0,0,0,,♪ Жұмсақ балмұздақ
Dialogue: 0,0:48:59.93,0:49:04.48,Default,,0,0,0,,♪ Дүкенде сұраған сайын
Dialogue: 0,0:49:04.56,0:49:09.86,Default,,0,0,0,,♪ Мен ваниль мен шоколадты шеше алмаймын.
Dialogue: 0,0:49:09.94,0:49:12.86,Default,,0,0,0,,♪ Соңында ол матчаға айналады
Dialogue: 0,0:49:12.95,0:49:14.66,Default,,0,0,0,,♪ Біз қазір
Dialogue: 0,0:49:14.74,0:49:16.87,Default,,0,0,0,,♪ Бастапқы нүктеде
Dialogue: 0,0:49:16.95,0:49:18.95,Default,,0,0,0,,♪ Мақсат қайда?
Dialogue: 0,0:49:19.04,0:49:21.20,Default,,0,0,0,,♪ Ол түзетілмеген.
Dialogue: 0,0:49:21.29,0:49:25.54,Default,,0,0,0,,♪ барлық бағытта 360 градус
Dialogue: 0,0:49:25.63,0:49:27.79,Default,,0,0,0,,♪ Кез келген бағытта
Dialogue: 0,0:49:27.88,0:49:34.34,Default,,0,0,0,,♪ Жүгіруді бастауға болады.
Dialogue: 0,0:49:36.80,0:49:38.64,Default,,0,0,0,,♪ Қалағаныңды істе
Dialogue: 0,0:49:39.43,0:49:41.56,Default,,0,0,0,,♪ Түсіндегі Латтата
Dialogue: 0,0:49:41.64,0:49:43.81,Default,,0,0,0,,♪ Латтата желде
Dialogue: 0,0:49:43.89,0:49:48.27,Default,,0,0,0,,♪ Енді бір діңнен өскен бұтақтар сияқты
Dialogue: 0,0:49:48.36,0:49:52.15,Default,,0,0,0,,♪ Латтата Күнге қарай бет алып барамын
Dialogue: 0,0:49:52.24,0:49:53.78,Default,,0,0,0,,♪ Өйткені ол сіз қандай болғыңыз келсе, сол.
Dialogue: 0,0:49:53.86,0:49:55.11,Default,,0,0,0,,♪ Бір ғана емес
Dialogue: 0,0:49:55.20,0:49:57.16,Default,,0,0,0,,♪ Жылауға болмайды
Dialogue: 0,0:49:57.24,0:49:59.45,Default,,0,0,0,,♪ Менің болғым келетін бір емес, көп болашақ бар.
Dialogue: 0,0:49:59.53,0:50:02.29,Default,,0,0,0,,♪ Біз жалғыз емеспіз
Dialogue: 0,0:50:05.21,0:50:07.13,Default,,0,0,0,,♪ Басталуы!
Dialogue: 0,0:50:08.46,0:50:10.09,Default,,0,0,0,,Хахаха
Dialogue: 0,0:50:10.17,0:50:11.75,Default,,0,0,0,,Хахаха
Dialogue: 0,0:50:11.84,0:50:13.42,Default,,0,0,0,,Хахаха
Dialogue: 0,0:50:13.51,0:50:16.63,Default,,0,0,0,,Хахаха
Dialogue: 0,0:50:23.85,0:50:25.06,Default,,0,0,0,,Сол Кога-сан
Dialogue: 0,0:50:25.14,0:50:27.65,Default,,0,0,0,,Иә? Кішкене ғана кеңес
Dialogue: 0,0:50:27.73,0:50:29.31,Default,,0,0,0,,Не?
Dialogue: 0,0:50:29.40,0:50:34.11,Default,,0,0,0,,Жақында кеңсеге баруымыз керек емес пе?
Dialogue: 0,0:50:34.19,0:50:35.65,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:50:35.74,0:50:40.07,Default,,0,0,0,,Мен твиттерде таныстыруға болатын жерлер бар.
Dialogue: 0,0:50:40.16,0:50:41.53,Default,,0,0,0,,Иә
Dialogue: 0,0:50:43.87,0:50:45.91,Default,,0,0,0,,Бұл Марсактан келген Эндо.
Dialogue: 0,0:50:46.00,0:50:49.79,Default,,0,0,0,,Мен Когадан естідім. Бұл Азума-сан ба?
Dialogue: 0,0:50:49.88,0:50:52.30,Default,,0,0,0,,Иә, бұл Ю Хигаши.
Dialogue: 0,0:50:53.80,0:50:55.17,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:50:58.30,0:51:00.80,Default,,0,0,0,,Азума-сан, мен теледидар көрдім.
Dialogue: 0,0:51:00.89,0:51:01.97,Default,,0,0,0,,Рахмет
Dialogue: 0,0:51:02.05,0:51:04.72,Default,,0,0,0,,Бұл керемет, атақты адам сияқты.
Dialogue: 0,0:51:04.81,0:51:06.27,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:51:06.35,0:51:08.77,Default,,0,0,0,,Мектепте қандай да бір қиындыққа тап болсаңыз, кез келген уақытта маған хабарлаңыз.
Dialogue: 0,0:51:08.85,0:51:12.36,Default,,0,0,0,,Иә, мен соңғы уақытта орынды жиі түсіріп жүрмін, сондықтан бұл пайдалы.
Dialogue: 0,0:51:13.78,0:51:14.61,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:51:15.57,0:51:19.36,Default,,0,0,0,,Соңғы кездері ол теледидарға үнемі шығып, Огуриджоны баспалдақ ретінде пайдаланып жүр.
Dialogue: 0,0:51:19.45,0:51:21.57,Default,,0,0,0,,Оны баспалдақ демеңіз
Dialogue: 0,0:51:21.66,0:51:23.95,Default,,0,0,0,,Қарттар жалғызсырап көрінді.
Dialogue: 0,0:51:24.58,0:51:26.62,Default,,0,0,0,,Аа, бірақ мен сені сүйем.
Dialogue: 0,0:51:26.70,0:51:28.62,Default,,0,0,0,,Шинджи-кун, тастамайсың ба?
Dialogue: 0,0:51:28.71,0:51:31.71,Default,,0,0,0,,Өйткені мен мұны өзім жасағым келеді дедім.
Dialogue: 0,0:51:31.79,0:51:34.96,Default,,0,0,0,,Адамдарды қуанту арқылы камералық дағдыларыңызды жақсартуға болады
Dialogue: 0,0:51:35.05,0:51:36.96,Default,,0,0,0,,Бұл мен үшін жақсы орта.
Dialogue: 0,0:51:37.05,0:51:40.34,Default,,0,0,0,,Бұл жақсы орта ма? Мен қызғаншақпын.
Dialogue: 0,0:51:40.97,0:51:42.26,Default,,0,0,0,,Қазір өзіңізді қалай сезінесіз?
Dialogue: 0,0:51:43.30,0:51:48.23,Default,,0,0,0,,Не дейсіз... Мен өзімді осы уақытқа дейін жеткендей сезінемін.
Dialogue: 0,0:51:48.31,0:51:50.90,Default,,0,0,0,,Менің арманым шынымен орындала ма деп ойлаймын
Dialogue: 0,0:51:50.98,0:51:52.40,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:51:53.77,0:51:56.15,Default,,0,0,0,,Ақыры Азума-санмен кездесуге барғаныма қуаныштымын.
Dialogue: 0,0:51:56.23,0:51:58.36,Default,,0,0,0,,Иә? Күн?
Dialogue: 0,0:51:58.44,0:52:01.70,Default,,0,0,0,,Өйткені бізге енді стратегиялық кездесу қажет емес, солай ма?
Dialogue: 0,0:52:02.32,0:52:04.08,Default,,0,0,0,,Жай ғана кездесу.
Dialogue: 0,0:52:04.16,0:52:07.58,Default,,0,0,0,,Иә, мен бүгін рахмет айту үшін келдім.
Dialogue: 0,0:52:08.50,0:52:09.58,Default,,0,0,0,,Рахмет
Dialogue: 0,0:52:12.96,0:52:16.59,Default,,0,0,0,,Азума-санды енді көре алмайтыныма қынжыламын.
Dialogue: 0,0:52:18.26,0:52:19.34,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:52:23.05,0:52:23.97,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:52:24.05,0:52:26.47,Default,,0,0,0,,Иә, басқа уақытта
Dialogue: 0,0:52:28.85,0:52:30.02,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:52:30.69,0:52:32.06,Default,,0,0,0,,Сізге соңғы сұрақ қойсам болады ма?
Dialogue: 0,0:52:32.14,0:52:33.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:33.15,0:52:34.61,Default,,0,0,0,,Неліктен Азума мырза?
Dialogue: 0,0:52:34.69,0:52:37.28,Default,,0,0,0,,Кумир болу үшін кастингтен өткен жоқсыз ба?
Dialogue: 0,0:52:37.36,0:52:40.19,Default,,0,0,0,,Бұл әлдеқайда қысқарақ болар еді.
Dialogue: 0,0:52:40.82,0:52:44.03,Default,,0,0,0,,Неге деп ойлаймын.
Dialogue: 0,0:52:45.62,0:52:46.62,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:52:47.49,0:52:48.70,Default,,0,0,0,,Олай болса кеттік
Dialogue: 0,0:52:48.79,0:52:49.62,Default,,0,0,0,,Иә
Dialogue: 0,0:52:57.63,0:52:58.55,Default,,0,0,0,,Уф
Dialogue: 0,0:53:04.09,0:53:08.56,Default,,0,0,0,,Бәрі құлады деп айту өте керемет.
Dialogue: 0,0:53:21.94,0:53:24.53,Default,,0,0,0,,Сіздің агенттікке жататындығыңызды шешкен кезде
Dialogue: 0,0:53:24.61,0:53:27.70,Default,,0,0,0,,Шоудың аяқталу әнін ғана айтпаңыз
Dialogue: 0,0:53:27.78,0:53:29.41,Default,,0,0,0,,Басқа жұмыстар келе бастады.
Dialogue: 0,0:53:31.33,0:53:35.33,Default,,0,0,0,,Көп ұзамай кеңсе мені SNS пайдалануды бастауды сұрады.
Dialogue: 0,0:53:35.42,0:53:39.13,Default,,0,0,0,,(Радиодыбыс)
Dialogue: 0,0:53:45.18,0:53:46.93,Default,,0,0,0,,Шынайы ма? Е, таңқаларлық
Dialogue: 0,0:53:51.52,0:53:53.23,Default,,0,0,0,,Көп емес пе?
Dialogue: 0,0:54:01.28,0:54:02.15,Default,,0,0,0,,Ах
Dialogue: 0,0:54:05.24,0:54:07.28,Default,,0,0,0,,Мұның бәрі ашылды.
Dialogue: 0,0:54:07.37,0:54:10.16,Default,,0,0,0,,Мен қисық сызықтан алда болдым деп ойлаймын.
Dialogue: 0,0:54:14.96,0:54:15.92,Default,,0,0,0,,Уф
Dialogue: 0,0:54:17.21,0:54:18.79,Default,,0,0,0,,Осы тапаншаны пайдаланып—
Dialogue: 0,0:54:34.64,0:54:35.60,Default,,0,0,0,,Жарайды
Dialogue: 0,0:54:37.98,0:54:39.31,Default,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,0:54:40.86,0:54:44.15,Default,,0,0,0,,Ах, Азума-чан, фанат хат келе жатыр.
Dialogue: 0,0:54:44.24,0:54:45.78,Default,,0,0,0,,Рахмет
Dialogue: 0,0:54:48.70,0:54:49.53,Default,,0,0,0,,Хмм
Dialogue: 0,0:54:57.87,0:54:59.00,Default,,0,0,0,,Уф
Dialogue: 0,0:55:05.84,0:55:06.84,Default,,0,0,0,,Келесі сұрақ
Dialogue: 0,0:55:07.68,0:55:10.80,Default,,0,0,0,,«Да Винчи» деп аталатын бұл робот бүкіл әлемде белсенді.
Dialogue: 0,0:55:10.89,0:55:12.76,Default,,0,0,0,,Робот жер бетінде не үшін пайдаланылады?
Dialogue: 0,0:55:12.85,0:55:13.68,Default,,0,0,0,,(Батырма басылған дыбысы)
Dialogue: 0,0:55:13.76,0:55:16.68,Default,,0,0,0,,О, Шығыс, Батыс, Оңтүстік және Солтүстік (Ранко) Курумидің ерекшелігі!
Dialogue: 0,0:55:16.77,0:55:17.73,Default,,0,0,0,,Ах
Dialogue: 0,0:55:17.81,0:55:20.69,Default,,0,0,0,,(Кері санақ дыбысы)
Dialogue: 0,0:55:26.28,0:55:27.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:55:27.82,0:55:29.11,Default,,0,0,0,,(Уақыт біткен дыбысы)
Dialogue: 0,0:55:29.20,0:55:30.03,Default,,0,0,0,,Ах~
Dialogue: 0,0:55:30.11,0:55:32.03,Default,,0,0,0,,Не болды, роботты жақсы көретін кумир!
Dialogue: 0,0:55:32.12,0:55:34.79,Default,,0,0,0,,(Орындаушылардың күлкісі)
Dialogue: 0,0:55:46.67,0:55:51.05,Default,,0,0,0,,Біз қазір өте алыс жүре аламыз.
Dialogue: 0,0:55:53.10,0:55:57.10,Default,,0,0,0,,Мені бейтаныс жерге апарады ма?
Dialogue: 0,0:55:57.68,0:55:59.69,Default,,0,0,0,,Куруми қазірдің өзінде қашқысы келеді
Dialogue: 0,0:55:59.77,0:56:03.56,Default,,0,0,0,,Жарайды, осы уақытқа дейін бәрі ойдағыдай болды.
Dialogue: 0,0:56:03.65,0:56:06.53,Default,,0,0,0,,Мен бұл жерден де ағымға қарсы жүруім керек екеніне сенімдімін.
Dialogue: 0,0:56:06.61,0:56:08.82,Default,,0,0,0,,Бірдеңе болады.
Dialogue: 0,0:56:08.90,0:56:12.74,Default,,0,0,0,,Жарайды ма? Маған орта мектептегі қалыпты өмір сүрудің қажеті жоқ еді.
Dialogue: 0,0:56:12.82,0:56:16.24,Default,,0,0,0,,Иә, назар аударуды ұнатпаймын.
Dialogue: 0,0:56:16.33,0:56:20.33,Default,,0,0,0,,Ал біздің бірге өткізген әр күніміз қызық.
Dialogue: 0,0:56:21.92,0:56:23.25,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:56:25.21,0:56:26.63,Default,,0,0,0,,Сіз жылап жатырсыз ба?
Dialogue: 0,0:56:28.09,0:56:29.26,Default,,0,0,0,,Жоқ
Dialogue: 0,0:56:33.39,0:56:38.06,Default,,0,0,0,,♪Ааааааааааааааааааааааааааааааааа
Dialogue: 0,0:56:38.14,0:56:40.39,Default,,0,0,0,,Жарайды келесі (есіктің ашылған дыбысы)
Dialogue: 0,0:56:42.94,0:56:45.11,Default,,0,0,0,,Камей-сан, сәл күте тұрыңыз.
Dialogue: 0,0:56:45.19,0:56:47.23,Default,,0,0,0,,Иә
Dialogue: 0,0:56:51.15,0:56:53.45,Default,,0,0,0,,Не болды?
Dialogue: 0,0:56:53.53,0:56:56.95,Default,,0,0,0,,(Миканың жылағаны)
Dialogue: 0,0:56:57.03,0:57:01.46,Default,,0,0,0,,Күте тұрыңыз, өтірік айтасыз. Бұл өткен аптада болды ма?
Dialogue: 0,0:57:01.54,0:57:02.92,Default,,0,0,0,,Сонымен қатар, Yoshida Productions Яиді Yotsuba-ның талисманы ретінде насихаттап жатыр.
Dialogue: 0,0:57:03.58,0:57:06.75,Default,,0,0,0,,Фото... жігітімен.
Dialogue: 0,0:57:07.29,0:57:09.38,Default,,0,0,0,,Нико Балалардың үлкені
Dialogue: 0,0:57:11.13,0:57:12.38,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:57:12.47,0:57:15.85,Default,,0,0,0,,Біреумен кездесіп жүргенің жақсы емес.
Dialogue: 0,0:57:15.93,0:57:17.18,Default,,0,0,0,,Мен қызғаншақпын
Dialogue: 0,0:57:17.26,0:57:18.10,Default,,0,0,0,,Цк
Dialogue: 0,0:57:18.18,0:57:23.10,Default,,0,0,0,,Жарайды, бұл жолы олар ажырасуға уәде берді, сондықтан ешқандай жаза болмайды.
Dialogue: 0,0:57:23.19,0:57:27.65,Default,,0,0,0,,Барлығыңыз солтүстік, оңтүстік, шығыс және батысқа тең келмейінше, мұның еш мәні жоқ.
Dialogue: 0,0:57:27.73,0:57:30.44,Default,,0,0,0,,Бұдан былай сақ болыңыз
Dialogue: 0,0:57:33.78,0:57:36.57,Default,,0,0,0,,Соншалықты алысқа бару керек пе?
Dialogue: 0,0:57:40.12,0:57:41.29,Default,,0,0,0,,Мен оны естімедім (Мика) Иә?
Dialogue: 0,0:57:42.08,0:57:45.29,Default,,0,0,0,,Менің жігітім болса, дос болмас едік.
Dialogue: 0,0:57:45.37,0:57:46.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:57:46.42,0:57:47.92,Default,,0,0,0,,Уф...
Dialogue: 0,0:57:52.13,0:57:55.55,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:57:56.97,0:57:58.35,Default,,0,0,0,,Сайт
Dialogue: 0,0:58:00.93,0:58:03.43,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:58:06.94,0:58:10.52,Default,,0,0,0,,Әй, қош келдіңіз, бүгін ерте келдіңіз.
Dialogue: 0,0:58:10.61,0:58:12.19,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:58:13.40,0:58:17.20,Default,,0,0,0,,♪~
Dialogue: 0,0:58:45.81,0:58:48.94,Default,,0,0,0,,~♪
Dialogue: 0,0:59:08.62,0:59:10.38,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:59:15.59,0:59:16.59,Default,,0,0,0,,Хмм...
Dialogue: 0,0:59:22.14,0:59:25.31,Default,,0,0,0,,Мика-чан, кеше артық айтқаным үшін кешіріңіз.
Dialogue: 0,0:59:26.06,0:59:27.10,Default,,0,0,0,,Бұл менің кінәм болды
Dialogue: 0,0:59:27.18,0:59:28.52,Default,,0,0,0,,Ах
Dialogue: 0,0:59:29.14,0:59:30.15,Default,,0,0,0,,Иә
Dialogue: 0,0:59:32.15,0:59:34.15,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:59:34.23,0:59:36.24,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:59:36.32,0:59:37.95,Default,,0,0,0,,А... (Кога) Не болды?
Dialogue: 0,0:59:38.03,0:59:40.07,Default,,0,0,0,,Мен өзімді жақсы сезінбеймін.
Dialogue: 0,0:59:41.78,0:59:44.45,Default,,0,0,0,,«Наритай Жибун» әніңіз
Dialogue: 0,0:59:44.54,0:59:46.50,Default,,0,0,0,,Өте жақсы бедел.
Dialogue: 0,0:59:46.58,0:59:49.50,Default,,0,0,0,,Енді мен фестивальде ән айта аламын.
Dialogue: 0,0:59:50.08,0:59:51.38,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:59:51.46,0:59:56.59,Default,,0,0,0,,О, бағдарлама да маған жаңа әндер жазғылары келетінін айтты.
Dialogue: 0,0:59:56.67,0:59:57.72,Default,,0,0,0,,Көрсетілім келесідей көрінеді
Dialogue: 0,0:59:58.76,1:00:03.80,Default,,0,0,0,,(♪Компьютерден ойнатылатын демо ән)
Dialogue: 0,1:00:06.68,1:00:08.23,Default,,0,0,0,,Уау...
Dialogue: 0,1:00:20.99,1:00:24.37,Default,,0,0,0,,Ән мәтінін әлі шешіп қойдыңыз ба?
Dialogue: 0,1:00:24.45,1:00:26.66,Default,,0,0,0,,Жоқ, мен тапсырыс берейін деп жатырмын.
Dialogue: 0,1:00:26.74,1:00:28.41,Default,,0,0,0,,Мен мұны өзіміз байқап көргім келеді.
Dialogue: 0,1:00:28.50,1:00:29.41,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:29.50,1:00:31.17,Default,,0,0,0,,Өлең сөзін өзіміз жазсақ
Dialogue: 0,1:00:31.25,1:00:34.34,Default,,0,0,0,,Менің ойымша, біз төрт адамның даралығын көбірек көрсете аламыз.
Dialogue: 0,1:00:34.42,1:00:36.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:00:36.09,1:00:38.71,Default,,0,0,0,,Содан кейін бір рет жазып көріңіз.
Dialogue: 0,1:00:39.55,1:00:41.51,Default,,0,0,0,,Рахмет!
Dialogue: 0,1:00:43.68,1:00:47.68,Default,,0,0,0,,(Ән қаттырақ естіледі)
Dialogue: 0,1:01:09.70,1:01:12.71,Default,,0,0,0,,~♪
Dialogue: 0,1:01:15.04,1:01:17.84,Default,,0,0,0,,Кешіріңіз, мен сізді сынамақ болдым.
Dialogue: 0,1:01:17.92,1:01:21.80,Default,,0,0,0,,Бірақ мұны оқып жатқанда уақытым таусылып жатыр.
Dialogue: 0,1:01:21.88,1:01:24.76,Default,,0,0,0,,Жұмыспен және еріктілікпен барын салу
Dialogue: 0,1:01:25.30,1:01:27.85,Default,,0,0,0,,Кешіріңіз, Азума-чан, шынымен.
Dialogue: 0,1:01:27.93,1:01:30.10,Default,,0,0,0,,Курумиге де сынақтан өтуге тура келді.
Dialogue: 0,1:01:30.18,1:01:33.60,Default,,0,0,0,,Ха... Үй тапсырмасын кейінге қалдыра аламын.
Dialogue: 0,1:01:34.52,1:01:36.61,Default,,0,0,0,,Алдымен келесі тікелей эфирде бар күшімізді салайық.
Dialogue: 0,1:01:36.69,1:01:40.28,Default,,0,0,0,,Сондай-ақ теледидар бар, сондықтан сіз міндетті түрде назар аударасыз.
Dialogue: 0,1:01:40.36,1:01:41.49,Default,,0,0,0,,Иә
Dialogue: 0,1:01:42.69,1:01:44.91,Default,,0,0,0,,Барымызды салайық, жарай ма?
Dialogue: 0,1:01:45.45,1:01:51.70,Default,,0,0,0,,(♪Айдолдың ән айтқан дауысы залда жаңғырық)
Dialogue: 0,1:01:51.79,1:01:52.83,Default,,0,0,0,,Иә? Манеке?
Dialogue: 0,1:01:52.91,1:01:55.08,Default,,0,0,0,,Ән айтудың қажеті жоқ екеніне сенімдісіз бе?
Dialogue: 0,1:01:55.17,1:01:57.46,Default,,0,0,0,,Жоқ, үшеуі ерін синхрондау.
Dialogue: 0,1:01:57.54,1:01:59.21,Default,,0,0,0,,Азума-саннан ән айтуын сұраңыз
Dialogue: 0,1:01:59.88,1:02:01.38,Default,,0,0,0,,Неге...
Dialogue: 0,1:02:01.46,1:02:04.17,Default,,0,0,0,,Ән мен сүйкімді бимен жеткізіңіз
Dialogue: 0,1:02:04.26,1:02:05.97,Default,,0,0,0,,Пұттар деген осы емес пе?
Dialogue: 0,1:02:07.93,1:02:12.72,Default,,0,0,0,,Бірақ... Мен ән айтуда жақсы емеспін, сондықтан мен құтқарылдым.
Dialogue: 0,1:02:12.81,1:02:13.93,Default,,0,0,0,,Минами-санса
Dialogue: 0,1:02:14.02,1:02:17.40,Default,,0,0,0,,Егер сіз өзіңізді жақсы емес деп ойласаңыз, жай ғана жаттығу жасаңыз.
Dialogue: 0,1:02:21.15,1:02:22.48,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,1:02:26.16,1:02:29.16,Default,,0,0,0,,~♪
Dialogue: 0,1:02:39.38,1:02:40.92,Default,,0,0,0,,Неге...
Dialogue: 0,1:02:45.22,1:02:46.05,Default,,0,0,0,,Хмм
Dialogue: 0,1:02:54.93,1:02:58.02,Default,,0,0,0,,Минами-сан, қазір көңілді жүрсің бе?
Dialogue: 0,1:02:58.60,1:03:01.06,Default,,0,0,0,,Жақында... дәл қазір
Dialogue: 0,1:03:01.15,1:03:02.19,Default,,0,0,0,,Сіз мұны айттыңыз.
Dialogue: 0,1:03:02.94,1:03:05.65,Default,,0,0,0,,«Ағынмен жүр»
Dialogue: 0,1:03:05.74,1:03:07.70,Default,,0,0,0,,Бұл жаңғақ үшін мүмкін емес.
Dialogue: 0,1:03:08.32,1:03:09.82,Default,,0,0,0,,Жынды болып кете жаздады
Dialogue: 0,1:03:12.24,1:03:16.33,Default,,0,0,0,,Мен де алда не күтіп тұр деп уайымдаймын.
Dialogue: 0,1:03:16.41,1:03:19.83,Default,,0,0,0,,Бұл сіздің мансаптық жолыңызды айқын көрсетуге тура келетін уақыт.
Dialogue: 0,1:03:19.92,1:03:23.59,Default,,0,0,0,,Сіз байқадыңыз ба? Мика Чан күлуін тоқтатты
Dialogue: 0,1:03:24.51,1:03:25.38,Default,,0,0,0,,Иә
Dialogue: 0,1:03:25.46,1:03:27.97,Default,,0,0,0,,Мика-чан туралы ештеңе білмеймін
Dialogue: 0,1:03:28.05,1:03:30.18,Default,,0,0,0,,Мен қалаған нәрсені істеймін
Dialogue: 0,1:03:30.26,1:03:32.60,Default,,0,0,0,,Бұл атақты адамдар үшін қалыпты жағдай ма?
Dialogue: 0,1:03:33.68,1:03:36.23,Default,,0,0,0,,Неліктен бәрі атақты болғысы келеді?
Dialogue: 0,1:03:36.31,1:03:38.56,Default,,0,0,0,,Көп адамға өзіңіз туралы айтыңыз
Dialogue: 0,1:03:38.64,1:03:40.85,Default,,0,0,0,,Менің ойымша, сіз қабылданғыңыз келеді.
Dialogue: 0,1:03:40.94,1:03:42.48,Default,,0,0,0,,Куруми түсінбейді
Dialogue: 0,1:03:43.32,1:03:45.48,Default,,0,0,0,,Маған басқалардың пікірі керек емес
Dialogue: 0,1:03:45.57,1:03:46.99,Default,,0,0,0,,Куруми-сан...
Dialogue: 0,1:03:48.20,1:03:52.32,Default,,0,0,0,,Тағдырдың аралас ағынының арқасында осындамыз.
Dialogue: 0,1:03:52.41,1:03:55.62,Default,,0,0,0,,Менде мұндай тәжірибе ешқашан болмауы мүмкін.
Dialogue: 0,1:03:56.62,1:03:59.21,Default,,0,0,0,,Ағынмен жүру - құмар ойын.
Dialogue: 0,1:03:59.29,1:04:00.58,Default,,0,0,0,,Егер сіз бәс тігуде ұтып алсаңыз
Dialogue: 0,1:04:00.67,1:04:02.71,Default,,0,0,0,,Тіпті армандар да өшеді.
Dialogue: 0,1:04:03.79,1:04:05.92,Default,,0,0,0,,Минами-санның арманы қандай?
Dialogue: 0,1:04:06.00,1:04:09.22,Default,,0,0,0,,Мен осылай өмір сүрсем, бұл шынымен орындалады ма?
Dialogue: 0,1:04:09.30,1:04:11.22,Default,,0,0,0,,Мен білмеймін, бірақ...
Dialogue: 0,1:04:11.30,1:04:13.97,Default,,0,0,0,,Жетеді, тоқтат.
Dialogue: 0,1:04:15.18,1:04:16.64,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:04:17.14,1:04:21.23,Default,,0,0,0,,Курумиді жынды болмай тұрып босатыңыз...
Dialogue: 0,1:04:21.31,1:04:25.61,Default,,0,0,0,,(Пойыздың дыбысы күшейді)
Dialogue: 0,1:04:38.87,1:04:40.21,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,1:04:41.71,1:04:43.13,Default,,0,0,0,,Бұл жаңа топ па әлде бірдеңе ме?
Dialogue: 0,1:04:43.21,1:04:45.46,Default,,0,0,0,,Тайга, күте тұр (2-ші қызметкер) Куруми-чан
Dialogue: 0,1:04:45.54,1:04:48.46,Default,,0,0,0,,Маған енді ұнамайды! Мен оны ұнатпаймын!
Dialogue: 0,1:04:48.55,1:04:50.17,Default,,0,0,0,,Мен теледидарда болғым келмейді
Dialogue: 0,1:04:50.26,1:04:54.01,Default,,0,0,0,,Неге бұлай істеп жатырсың? Эй, мен енді мұны істегім келмейді!
Dialogue: 0,1:04:54.09,1:04:56.64,Default,,0,0,0,,Мен енді өзім болмаймын!
Dialogue: 0,1:04:56.72,1:05:00.06,Default,,0,0,0,,Пұттарға бұл мәселе қарамайды!
Dialogue: 0,1:05:00.14,1:05:03.56,Default,,0,0,0,,Маған қазір үйге баруға рұқсат етіңіз! Мені жалғыз қалдыр
Dialogue: 0,1:05:03.65,1:05:06.73,Default,,0,0,0,,Сәлем! Ааааааа...
Dialogue: 0,1:05:06.82,1:05:08.07,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,1:05:08.15,1:05:09.90,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,1:05:11.90,1:05:12.74,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:12.82,1:05:14.49,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,1:05:14.57,1:05:18.70,Default,,0,0,0,,Мен Куруми-чанмен сөйлесуім керек. Ертең де жазба бар, солай ма?
Dialogue: 0,1:05:19.29,1:05:22.54,Default,,0,0,0,,Азума-сан шынымен ештеңе түсінбейді.
Dialogue: 0,1:05:23.62,1:05:25.29,Default,,0,0,0,,Куруми-сан өз шегінде.
Dialogue: 0,1:05:25.38,1:05:28.34,Default,,0,0,0,,Шектеу дегенді қалай түсінесіз?
Dialogue: 0,1:05:28.42,1:05:31.92,Default,,0,0,0,,Куруми әрқашан ерекшеленетін және ерекшеленетін тұлға болды.
Dialogue: 0,1:05:32.01,1:05:33.30,Default,,0,0,0,,Қиын бала еді ғой?
Dialogue: 0,1:05:35.43,1:05:36.80,Default,,0,0,0,,Сонымен не істеуіміз керек?
Dialogue: 0,1:05:37.68,1:05:40.56,Default,,0,0,0,,Оны кәдімгі қызға айналдырайық.
Dialogue: 0,1:05:40.64,1:05:43.10,Default,,0,0,0,,Осы уақытқа дейін жеткенімізбен
Dialogue: 0,1:05:44.27,1:05:45.56,Default,,0,0,0,,Шығыңыз дейсіз бе?
Dialogue: 0,1:05:45.65,1:05:47.44,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,1:05:47.52,1:05:50.40,Default,,0,0,0,,Мен де бір нәрсені байқадым.
Dialogue: 0,1:05:50.48,1:05:52.24,Default,,0,0,0,,Кумир болу қызық емес
Dialogue: 0,1:05:52.32,1:05:53.65,Default,,0,0,0,,Естуімше, ол сенің бала кезден бергі досың.
Dialogue: 0,1:05:53.74,1:05:55.66,Default,,0,0,0,,Бұл біртүрлі!
Dialogue: 0,1:05:55.74,1:05:58.99,Default,,0,0,0,,Әдемі киім киіп, әдемі шаш үлгісін жасаңыз
Dialogue: 0,1:05:59.08,1:06:01.50,Default,,0,0,0,,Студияда көп жарыққа шомылды
Dialogue: 0,1:06:01.58,1:06:04.08,Default,,0,0,0,,Бұл сізді қаншалықты бақытты ететінін білесіз бе?
Dialogue: 0,1:06:04.16,1:06:08.59,Default,,0,0,0,,Оны қызықты деп санайтын себебім, Азума айдолдарды жақсы көреді.
Dialogue: 0,1:06:08.67,1:06:10.34,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,1:06:10.42,1:06:13.42,Default,,0,0,0,,Үйреніп алсаң, қызық болатыны сөзсіз.
Dialogue: 0,1:06:14.01,1:06:19.89,Default,,0,0,0,,Өйткені пұттар көптеген адамдарды күлдіреді.
Dialogue: 0,1:06:19.97,1:06:23.02,Default,,0,0,0,,Мұндай тамаша кәсіп жоқ!
Dialogue: 0,1:06:23.10,1:06:25.85,Default,,0,0,0,,Чи... жақын жерде
Dialogue: 0,1:06:25.94,1:06:26.77,Default,,0,0,0,,Иә?
Dialogue: 0,1:06:26.85,1:06:31.78,Default,,0,0,0,,Айналасындағыларды күлдірте алмайтын адамдар
Dialogue: 0,1:06:31.86,1:06:33.15,Default,,0,0,0,,Иә?
Dialogue: 0,1:06:34.65,1:06:35.49,Default,,0,0,0,,Ах
Dialogue: 0,1:06:36.41,1:06:40.66,Default,,0,0,0,,Азума-чан... дәл қазір біртүрлі...
Dialogue: 0,1:06:41.70,1:06:42.99,Default,,0,0,0,,Рақмет. Хехехе…
Dialogue: 0,1:06:43.08,1:06:46.71,Default,,0,0,0,,(Миканың жылағаны)
Dialogue: 0,1:06:46.79,1:06:47.79,Default,,0,0,0,,Мика-сан
Dialogue: 0,1:07:18.45,1:07:19.95,Default,,0,0,0,,Бірнеше күннен кейін
Dialogue: 0,1:07:20.99,1:07:25.70,Default,,0,0,0,,Агенттік маған хабарласып, үш адамның келісім-шарттары бұзылғанын хабарлады.
Dialogue: 0,1:07:26.91,1:07:31.04,Default,,0,0,0,,Бағдарламаның Тозай Нанбоку үнемі шығатын бұрышы болды
Dialogue: 0,1:07:31.13,1:07:32.84,Default,,0,0,0,,Тағы бір жоба басталды
Dialogue: 0,1:07:33.67,1:07:36.42,Default,,0,0,0,,Менің жұмысым бітті.
Dialogue: 0,1:07:38.43,1:07:40.01,Default,,0,0,0,,
Dialogue: 0,1:07:40.09,1:07:42.47,Default,,0,0,0,,Юу, көңіл-күйің қалай?
Dialogue: 0,1:07:44.60,1:07:47.39,Default,,0,0,0,,Маған жаңа ғана мектеп мұғалімі қоңырау шалды.
Dialogue: 0,1:07:47.48,1:07:49.69,Default,,0,0,0,,Мұғалімдер қобалжыды.
Dialogue: 0,1:07:53.23,1:07:56.40,Default,,0,0,0,,Түскі ас Аздап болса да ішіңіз.
Dialogue: 0,1:08:07.45,1:08:09.37,Default,,0,0,0,,(перделердің ашылған дыбысы)
Dialogue: 0,1:08:09.46,1:08:13.67,Default,,0,0,0,,Юу Сіз мәңгі ұйықтай алмайсыз, солай ма?
Dialogue: 0,1:08:14.46,1:08:15.88,Default,,0,0,0,,Эй
Dialogue: 0,1:08:28.35,1:08:32.98,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:08:35.69,1:08:37.86,Default,,0,0,0,,Еңбегіңізге рахмет, мен Хигашимін.
Dialogue: 0,1:08:37.94,1:08:40.15,Default,,0,0,0,,Ах, Азума-сан, еңбегіңе рахмет.
Dialogue: 0,1:08:40.24,1:08:43.03,Default,,0,0,0,,Бүгін менің шағын іскерлік қоңырауым бар.
Dialogue: 0,1:08:44.62,1:08:49.00,Default,,0,0,0,,Қалған үш адамды қалдыру процедуралары аяқталды, мен не істеуім керек?
Dialogue: 0,1:08:53.38,1:08:55.42,Default,,0,0,0,,Мен оны тоқтатамын.
Dialogue: 0,1:08:57.92,1:09:00.05,Default,,0,0,0,,Мен оны ақырында алдым деп ойладым.
Dialogue: 0,1:09:00.13,1:09:02.26,Default,,0,0,0,,Пұттың атауы
Dialogue: 0,1:09:02.34,1:09:05.05,Default,,0,0,0,,Ол менің қолымнан тайып кетті.
Dialogue: 0,1:09:14.73,1:09:18.19,Default,,0,0,0,,Сенің көңіл-күйіңді білемін, бірақ мектепке баратын кез келді.
Dialogue: 0,1:09:21.40,1:09:24.32,Default,,0,0,0,,Кел, кел!
Dialogue: 0,1:09:50.22,1:09:53.14,Default,,0,0,0,,(Студенттердің шуы)
Dialogue: 0,1:09:53.85,1:09:56.65,Default,,0,0,0,,Азума мырза мектепке келеді.
Dialogue: 0,1:09:56.73,1:09:59.48,Default,,0,0,0,,Соңғы кездері сіз көп бос емессіз, солай ма?
Dialogue: 0,1:10:00.11,1:10:04.99,Default,,0,0,0,,Мектепте қандай да бір қиындыққа тап болсаңыз, кез келген уақытта маған хабарлаңыз.
Dialogue: 0,1:10:05.07,1:10:06.87,Default,,0,0,0,,(орындық тартылып жатқан дыбыс)
Dialogue: 0,1:10:06.95,1:10:08.33,Default,,0,0,0,,Ах
Dialogue: 0,1:10:08.41,1:10:09.49,Default,,0,0,0,,Рахмет
Dialogue: 0,1:10:10.16,1:10:13.12,Default,,0,0,0,,Менің артымнан мен туралы жаман сөздер айтып жатқаныңызды білемін.
Dialogue: 0,1:10:20.67,1:10:23.34,Default,,0,0,0,,Неге олай істедің...
Dialogue: 0,1:10:33.31,1:10:35.64,Default,,0,0,0,,Ах, Азима-сан, а...
Dialogue: 0,1:10:36.98,1:10:39.11,Default,,0,0,0,,Көп уақыт өтті.
Dialogue: 0,1:10:39.73,1:10:41.57,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,1:10:41.65,1:10:45.24,Default,,0,0,0,,Солтүстікте, оңтүстікте, шығыста және батыста барлығыңыз қолыңыздан келгеннің бәрін істеп жатырсыз ба?
Dialogue: 0,1:10:48.16,1:10:50.37,Default,,0,0,0,,Мен бәрін тоқтаттым.
Dialogue: 0,1:10:50.45,1:10:53.58,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:53.66,1:10:56.37,Default,,0,0,0,,Енді не істейсіз?
Dialogue: 0,1:10:59.17,1:11:00.79,Default,,0,0,0,,Бұдан былай...?
Dialogue: 0,1:11:08.34,1:11:09.68,Default,,0,0,0,,Бұдан былай
Dialogue: 0,1:11:17.19,1:11:19.56,Default,,0,0,0,,Қызық, бәрінің жағдайы қалай?
Dialogue: 0,1:11:25.49,1:11:27.20,Default,,0,0,0,,Бұдан былай...
Dialogue: 0,1:11:27.28,1:11:29.49,Default,,0,0,0,,Жоқ, сондықтан мен шешкен жоқпын.
Dialogue: 0,1:11:29.57,1:11:32.16,Default,,0,0,0,,Кеш емес пе? Келесі айда 3 жыл болады
Dialogue: 0,1:11:32.24,1:11:35.08,Default,,0,0,0,,Мен университеттің мақсаты жоқ сияқты сезінемін.
Dialogue: 0,1:11:35.16,1:11:36.87,Default,,0,0,0,,Сонымен, сіз болашақта не істейсіз?
Dialogue: 0,1:11:36.96,1:11:38.37,Default,,0,0,0,,Айтпа
Dialogue: 0,1:11:38.46,1:11:40.58,Default,,0,0,0,,Хмм, шешім қабылдағаныма қуаныштымын.
Dialogue: 0,1:11:40.67,1:11:42.67,Default,,0,0,0,,Мен өзіммен не істеуім керек?
Dialogue: 0,1:11:42.75,1:11:45.80,Default,,0,0,0,,Еңбекқорлықты қажет ететін ең керемет жұмыс
Dialogue: 0,1:11:45.88,1:11:47.55,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,1:11:48.22,1:11:50.43,Default,,0,0,0,,Ал, мысалы, ғарышкер?
Dialogue: 0,1:11:50.51,1:11:51.89,Default,,0,0,0,,Керемет
Dialogue: 0,1:11:51.97,1:11:54.10,Default,,0,0,0,,Бұдан былай... (Ұялы телефон рингтоны)
Dialogue: 0,1:12:00.23,1:12:01.19,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,1:12:01.27,1:12:04.32,Default,,0,0,0,,Ах Азума, біраз болды. Қалайсың?
Dialogue: 0,1:12:04.40,1:12:05.78,Default,,0,0,0,,А... иә
Dialogue: 0,1:12:05.86,1:12:07.69,Default,,0,0,0,,Сіз көп жұмыс жасадыңыз ба?
Dialogue: 0,1:12:07.78,1:12:12.28,Default,,0,0,0,,Солтүстікте, оңтүстікте, шығыста және батыста көп қиындық көргенімізге біраз болды.
Dialogue: 0,1:12:12.37,1:12:13.28,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:12:13.37,1:12:16.54,Default,,0,0,0,,А, жоқ, мен бұл туралы айтып отырған жоқпын.
Dialogue: 0,1:12:16.62,1:12:19.16,Default,,0,0,0,,Мен сізге хабарласайын деп ойладым.
Dialogue: 0,1:12:19.25,1:12:20.08,Default,,0,0,0,,Иә
Dialogue: 0,1:12:20.17,1:12:24.04,Default,,0,0,0,,Жақында бағдарламадағы әндер бар CD шығады.
Dialogue: 0,1:12:24.13,1:12:27.13,Default,,0,0,0,,Шығыс, Батыс, Оңтүстік, Солтүстік әндері де қосылсын деп шешілді.
Dialogue: 0,1:12:27.21,1:12:28.30,Default,,0,0,0,,Иә?
Dialogue: 0,1:12:28.38,1:12:30.72,Default,,0,0,0,,тым кеш.
Dialogue: 0,1:12:30.80,1:12:33.80,Default,,0,0,0,,Мен сізге хабарлауға уақыт бөлемін деп ойладым.
Dialogue: 0,1:12:33.89,1:12:35.89,Default,,0,0,0,,Солтүстікке, оңтүстікке, шығысқа, батысқа рахмет
Dialogue: 0,1:12:35.97,1:12:38.81,Default,,0,0,0,,Өйткені мен көптеген қызықты нәрселерді бастан өткердім.
Dialogue: 0,1:12:38.89,1:12:41.06,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,1:12:44.81,1:12:46.11,Default,,0,0,0,,Мен де солай.
Dialogue: 0,1:12:47.28,1:12:49.11,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,1:12:57.66,1:12:59.58,Default,,0,0,0,,Мұны кім естіді? (Комедия 2) Мен ағамнан сұрадым
Dialogue: 0,1:12:59.66,1:13:00.83,Default,,0,0,0,,Иә, иә, ағаңа.
Dialogue: 0,1:13:00.91,1:13:05.00,Default,,0,0,0,,Сонда мама мен шешемнің жалғыз қызы
Dialogue: 0,1:13:05.09,1:13:08.30,Default,,0,0,0,,Олар анамның шешесінің күйеуінің жалғыз қыздары.
Dialogue: 0,1:13:08.38,1:13:09.21,Default,,0,0,0,,Анаңның сөмкесі емес пе?
Dialogue: 0,1:13:09.30,1:13:10.97,Default,,0,0,0,,Баршаңыз да сапарыңызды жалғастырғанда абай болыңыздар
Dialogue: 0,1:13:17.10,1:13:18.60,Default,,0,0,0,,Барлығы қалай?
Dialogue: 0,1:13:18.68,1:13:20.18,Default,,0,0,0,,Иә?
Dialogue: 0,1:13:20.27,1:13:22.10,Default,,0,0,0,,Шығыс, батыс, солтүстік, оңтүстік
Dialogue: 0,1:13:25.11,1:13:27.32,Default,,0,0,0,,Мен сізбен байланыста болған жоқпын.
Dialogue: 0,1:13:28.40,1:13:29.32,Default,,0,0,0,,Иә
Dialogue: 0,1:13:29.82,1:13:30.90,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:13:32.28,1:13:34.45,Default,,0,0,0,,Әлгі жігіт?
Dialogue: 0,1:13:35.82,1:13:37.58,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,1:13:38.33,1:13:40.95,Default,,0,0,0,,Ол жиіркенішті адам, солай емес пе?
Dialogue: 0,1:13:47.17,1:13:51.09,Default,,0,0,0,,Ондай жерлер де бар, жоқ жерлер де бар.
Dialogue: 0,1:13:51.17,1:13:52.63,Default,,0,0,0,,Юхана
Dialogue: 0,1:13:55.97,1:13:58.10,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,1:13:58.68,1:14:02.18,Default,,0,0,0,,(Юу жылайды)
Dialogue: 0,1:14:21.87,1:14:24.62,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,1:14:35.80,1:14:37.18,Default,,0,0,0,,Азума-чан
Dialogue: 0,1:14:42.60,1:14:43.64,Default,,0,0,0,,Көптен бері көрмеген
Dialogue: 0,1:14:45.77,1:14:47.90,Default,,0,0,0,,Кешіріңіз, кенеттен.
Dialogue: 0,1:14:47.98,1:14:49.15,Default,,0,0,0,,Жоқ
Dialogue: 0,1:14:51.11,1:14:52.36,Default,,0,0,0,,Осымен
Dialogue: 0,1:14:53.53,1:14:55.32,Default,,0,0,0,,Менің сізден сұрайын дегенім бар.
Dialogue: 0,1:14:55.40,1:14:57.20,Default,,0,0,0,,Сіз не сұрағыңыз келеді?
Dialogue: 0,1:14:59.28,1:15:03.41,Default,,0,0,0,,Өткенде мен туралы айтып бере аласыз ба?
Dialogue: 0,1:15:08.21,1:15:10.34,Default,,0,0,0,,Есіңізде болсын... жоқ, солай ма?
Dialogue: 0,1:15:10.42,1:15:14.80,Default,,0,0,0,,Мені сыныптастарым да, мұғалім де елемейтін.
Dialogue: 0,1:15:14.88,1:15:18.22,Default,,0,0,0,,Сол Азума-чан ғана менімен сөйлесті
Dialogue: 0,1:15:19.68,1:15:24.27,Default,,0,0,0,,Олай істесем, сенімен бірге мені қорқытады деп қорқамын.
Dialogue: 0,1:15:24.77,1:15:27.52,Default,,0,0,0,,Бірақ Азума-чан маған айтты
Dialogue: 0,1:15:27.60,1:15:31.36,Default,,0,0,0,,«Мен сөйлеп тұрсам да, неге мені тоқтатып жатқаныңызды түсінбеймін, өйткені менің бір ісім бар».
Dialogue: 0,1:15:31.44,1:15:36.36,Default,,0,0,0,,«Мен құрметтемейтін адамның нұсқауларын қабылдамаймын».
Dialogue: 0,1:15:36.44,1:15:38.91,Default,,0,0,0,,Сіз әрқашан сыпайы болдыңыз ба?
Dialogue: 0,1:15:38.99,1:15:42.28,Default,,0,0,0,,Жоқ, Азума-чан жақсы болды.
Dialogue: 0,1:15:42.37,1:15:45.75,Default,,0,0,0,,Ол әдемі және ақылды, ешқашан жыламайды.
Dialogue: 0,1:15:49.79,1:15:52.25,Default,,0,0,0,,Хигаши-чан Канадаға көшті
Dialogue: 0,1:15:52.34,1:15:55.46,Default,,0,0,0,,Мен мектепке баруды тоқтаттым.
Dialogue: 0,1:15:56.21,1:16:01.18,Default,,0,0,0,,Оның орнына мен Баба үйіне барып, орта мектепті қабылдау емтиханын тапсырып, жүзімді өзгерттім.
Dialogue: 0,1:16:01.26,1:16:03.35,Default,,0,0,0,,Барлығы жаңа
Dialogue: 0,1:16:03.43,1:16:05.60,Default,,0,0,0,,Бірақ бұл мүмкін емес еді.
Dialogue: 0,1:16:06.39,1:16:10.73,Default,,0,0,0,,Қорқыту туралы Менің ойымша, бұл туралы Кита орта мектебінде біреу айтқан
Dialogue: 0,1:16:10.81,1:16:12.27,Default,,0,0,0,,Өйткені ол ауылда.
Dialogue: 0,1:16:12.36,1:16:15.61,Default,,0,0,0,,Бұл заттардың бәрі тез таралады.
Dialogue: 0,1:16:18.86,1:16:20.24,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,1:16:20.32,1:16:21.16,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:21.24,1:16:23.12,Default,,0,0,0,,Мен Азума-чанды кітап дүкенінде кездестіргенде
Dialogue: 0,1:16:24.12,1:16:28.41,Default,,0,0,0,,Біраз уақыт өтті, бірақ мен оның Азума-чан екенін бірден білдім.
Dialogue: 0,1:16:28.50,1:16:31.50,Default,,0,0,0,,Менің кейіпкерім Жапонияға оралды.
Dialogue: 0,1:16:32.17,1:16:34.25,Default,,0,0,0,,Ойланбай тұрып, сені шақырдым.
Dialogue: 0,1:16:36.88,1:16:37.88,Default,,0,0,0,,Азума-чан
Dialogue: 0,1:16:38.80,1:16:43.26,Default,,0,0,0,,Мен Хигаши-чанның бірінші фанаты болдым.
Dialogue: 0,1:16:46.97,1:16:48.89,Default,,0,0,0,,Жоқ, түсіндім.
Dialogue: 0,1:16:48.98,1:16:52.10,Default,,0,0,0,,Мен де, мен оны көргенде ғана сатып аламын.
Dialogue: 0,1:16:52.19,1:16:53.60,Default,,0,0,0,,Балық шұжығы
Dialogue: 0,1:16:54.23,1:16:56.44,Default,,0,0,0,,Иә, келесі сұрау
Dialogue: 0,1:16:56.52,1:16:59.86,Default,,0,0,0,,Біз «Нико балаларының Сачиінен» хабарлама алдық
Dialogue: 0,1:16:59.94,1:17:00.74,Default,,0,0,0,,«Нағыз кумир болғаныңыз үшін рахмет».
Dialogue: 0,1:17:00.74,1:17:02.78,Default,,0,0,0,,«Нағыз кумир болғаныңыз үшін рахмет».
Dialogue: 0,1:17:00.74,1:17:02.78,Default,,0,0,0,,Сачи...
Dialogue: 0,1:17:02.86,1:17:04.87,Default,,0,0,0,,«Армандар орындалады».
Dialogue: 0,1:17:04.95,1:17:06.99,Default,,0,0,0,,Олай болса, ертеңгі шығарылым
Dialogue: 0,1:17:07.08,1:17:10.66,Default,,0,0,0,,«Mecha×2 Friday» тақырыптық әндер жинағынан бір ән
Dialogue: 0,1:17:10.75,1:17:12.29,Default,,0,0,0,,Шығыс, Батыс, Солтүстік, Оңтүстік (шартты) «Қайда болғың келеді»
Dialogue: 0,1:17:12.29,1:17:13.50,Default,,0,0,0,,Шығыс, батыс, солтүстік, оңтүстік (алдын ала) «Қайда болғың келеді»
Dialogue: 0,1:17:12.29,1:17:13.50,Default,,0,0,0,,Ах
Dialogue: 0,1:17:13.50,1:17:14.71,Default,,0,0,0,,Шығыс, Батыс, Солтүстік, Оңтүстік (шартты) «Мен қайда болғым келеді»
Dialogue: 0,1:17:14.79,1:17:18.71,Default,,0,0,0,,♪ Тек маңызды емес нәрселер
Dialogue: 0,1:17:18.80,1:17:23.22,Default,,0,0,0,,♪ Әңгімелесіп күлейік
Dialogue: 0,1:17:23.30,1:17:27.51,Default,,0,0,0,,♪ Бір-бірімізден өтіп, ғашық боламыз
Dialogue: 0,1:17:27.60,1:17:31.23,Default,,0,0,0,,♪ Тілегіңді орында
Dialogue: 0,1:17:31.31,1:17:34.23,Default,,0,0,0,,♪ Мен бірдеңе іздеп жүрмін, ол жеткіліксіз
Dialogue: 0,1:17:34.31,1:17:35.48,Default,,0,0,0,,♪ Сондай күндерде
Dialogue: 0,1:17:35.56,1:17:38.73,Default,,0,0,0,,♪ Адамдар сияқты.
Dialogue: 0,1:17:38.82,1:17:41.61,Default,,0,0,0,,♪ Бүгін де арманда Латтата
Dialogue: 0,1:17:41.69,1:17:43.82,Default,,0,0,0,,♪ Латтата желде
Dialogue: 0,1:17:43.91,1:17:46.03,Default,,0,0,0,,♪ Ән мәтінінің бір жерінде
Dialogue: 0,1:17:46.12,1:17:48.28,Default,,0,0,0,,♪ Болған болуы мүмкін
Dialogue: 0,1:17:48.37,1:17:50.24,Default,,0,0,0,,♪ Мен көрдім! «Сенің ішіңде»...
Dialogue: 0,1:18:29.95,1:18:31.58,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,1:18:33.75,1:18:34.66,Default,,0,0,0,,Ах
Dialogue: 0,1:18:54.27,1:18:55.35,Default,,0,0,0,,Иә?
Dialogue: 0,1:18:58.10,1:19:00.65,Default,,0,0,0,,Барлығын кешіріңіз
Dialogue: 0,1:19:02.40,1:19:06.78,Default,,0,0,0,,Соңында мен өзімді ғана ойладым.
Dialogue: 0,1:19:06.86,1:19:11.24,Default,,0,0,0,,Өз арманың үшін еш ойланбастан өзгені ренжіте аласың.
Dialogue: 0,1:19:11.33,1:19:14.33,Default,,0,0,0,,Мен барлығымен бәрін істей аламын деп ойладым.
Dialogue: 0,1:19:15.25,1:19:18.96,Default,,0,0,0,,Мен үшін көп нәрсеге араласу өте жаман болды.
Dialogue: 0,1:19:20.17,1:19:24.13,Default,,0,0,0,,Куруми Хаса Мен Азума-чанның түсін байқадым
Dialogue: 0,1:19:24.67,1:19:28.43,Default,,0,0,0,,Бірақ Куруми үшін пұт болу мүмкін емес еді.
Dialogue: 0,1:19:29.14,1:19:33.56,Default,,0,0,0,,Мен танымайтын адамдардың өміріне араласудан қорқамын.
Dialogue: 0,1:19:33.64,1:19:36.85,Default,,0,0,0,,Бос күйді жөндеу мүмкін емес.
Dialogue: 0,1:19:36.93,1:19:39.31,Default,,0,0,0,,Кешіріңіз, мен сізге көмектесе алмаймын
Dialogue: 0,1:19:39.40,1:19:44.61,Default,,0,0,0,,Бірақ Хигаши-чанмен танысу арқылы Куруми алғаш рет дос тапты.
Dialogue: 0,1:19:45.61,1:19:46.99,Default,,0,0,0,,Иә
Dialogue: 0,1:19:47.53,1:19:49.03,Default,,0,0,0,,Мен де кешірім сұраймын
Dialogue: 0,1:19:49.11,1:19:52.62,Default,,0,0,0,,Мен бұлыңғыр сезіммен жасамауым керек еді.
Dialogue: 0,1:19:52.70,1:19:56.79,Default,,0,0,0,,Мен оған да, Азума-чанға да қиындық туғыздым.
Dialogue: 0,1:19:56.87,1:20:00.54,Default,,0,0,0,,Бірақ мен барлығымен танысқаныма қуаныштымын.
Dialogue: 0,1:20:00.63,1:20:03.29,Default,,0,0,0,,Сен менің досым болып қала бересің бе?
Dialogue: 0,1:20:03.38,1:20:06.30,Default,,0,0,0,,Әрине! Сәлем Азума-чан
Dialogue: 0,1:20:08.67,1:20:09.55,Default,,0,0,0,,Әрине
Dialogue: 0,1:20:11.09,1:20:14.47,Default,,0,0,0,,Бірақ мен оны әлі түсінбеймін.
Dialogue: 0,1:20:15.06,1:20:16.81,Default,,0,0,0,,Махаббат соншалықты маңызды ма?
Dialogue: 0,1:20:17.89,1:20:20.52,Default,,0,0,0,,Егер сіз үшін маңызды адам болса, сіз түсінесіз.
Dialogue: 0,1:20:22.15,1:20:23.27,Default,,0,0,0,,Азума мырза
Dialogue: 0,1:20:23.36,1:20:26.82,Default,,0,0,0,,Мен болсам, мен не істегім келетінін таптым.
Dialogue: 0,1:20:26.90,1:20:29.11,Default,,0,0,0,,Сіз не істегіңіз келеді? (Ранко) Иә.
Dialogue: 0,1:20:31.74,1:20:36.16,Default,,0,0,0,,Мен жер шарын аралап, көмек көрсету жұмысын атқаруды ойлап жүрмін.
Dialogue: 0,1:20:36.24,1:20:38.62,Default,,0,0,0,,Не, шын айтасың ба? Емтихан ше?
Dialogue: 0,1:20:38.70,1:20:40.37,Default,,0,0,0,,Мен алмаймын.
Dialogue: 0,1:20:40.46,1:20:43.63,Default,,0,0,0,,Мен ерікті болуға тырысып, кумир болғаннан кейін түсінгенім
Dialogue: 0,1:20:43.71,1:20:47.38,Default,,0,0,0,,Мен де басқаларға қуаныш сыйлай алатынымды түсіндім.
Dialogue: 0,1:20:48.01,1:20:52.89,Default,,0,0,0,,Менің өмірім өзгере бастады, өйткені мен барлығымен бірге кумир болу үшін өзімді сынай алдым.
Dialogue: 0,1:20:52.97,1:20:54.64,Default,,0,0,0,,Бұл керемет әрекет.
Dialogue: 0,1:20:54.72,1:20:58.35,Default,,0,0,0,,Уһ, тек әрекет ету қабілеті туралы айтсақ.
Dialogue: 0,1:20:58.43,1:21:00.52,Default,,0,0,0,,Азума-сан да жеңілген жоқ деп үміттенемін.
Dialogue: 0,1:21:03.48,1:21:04.65,Default,,0,0,0,,Хехе
Dialogue: 0,1:21:06.32,1:21:07.69,Default,,0,0,0,,(Барлығы төрт адам) Һмм? (ДжоДжо) Дерби?
Dialogue: 0,1:21:10.11,1:21:11.61,Default,,0,0,0,,Өйткені
Dialogue: 0,1:21:11.70,1:21:13.32,Default,,0,0,0,,Біз тарағанымызбен
Dialogue: 0,1:21:13.41,1:21:16.58,Default,,0,0,0,,Олардың пұтқа айналғанына бәрі қуанса керек.
Dialogue: 0,1:21:16.66,1:21:17.87,Default,,0,0,0,,Сонымен, мұны қайталағыңыз келе ме?
Dialogue: 0,1:21:17.95,1:21:19.12,Default,,0,0,0,,Мүлдем жоқ
Dialogue: 0,1:21:21.50,1:21:23.87,Default,,0,0,0,,Бүгін сізбен сөйлесе алатыныма қуаныштымын.
Dialogue: 0,1:21:29.67,1:21:30.67,Default,,0,0,0,,Хмм
Dialogue: 0,1:21:36.05,1:21:37.39,Default,,0,0,0,,Тору~!
Dialogue: 0,1:21:39.81,1:21:41.14,Default,,0,0,0,,Ах (Мика/Ранко) Хэхе
Dialogue: 0,1:21:41.23,1:21:42.64,Default,,0,0,0,,Иә?
Dialogue: 0,1:21:48.23,1:21:49.61,Default,,0,0,0,,Бұл…
Dialogue: 0,1:21:49.69,1:21:52.86,Default,,0,0,0,,Мен үй тапсырмасын сол кезде орындадым.
Dialogue: 0,1:21:52.95,1:21:53.78,Default,,0,0,0,,Өйткені...
Dialogue: 0,1:21:53.86,1:21:56.49,Default,,0,0,0,,Куруми Себебі ол үй тапсырмасын жақсы орындайтын тип.
Dialogue: 0,1:21:56.57,1:21:58.24,Default,,0,0,0,,Мен де
Dialogue: 0,1:22:07.00,1:22:08.84,Default,,0,0,0,,Тору~!
Dialogue: 0,1:22:11.34,1:22:13.42,Default,,0,0,0,,Орындалды... орындадың.
Dialogue: 0,1:22:14.18,1:22:15.93,Default,,0,0,0,,Дегенмен тым кеш.
Dialogue: 0,1:22:27.27,1:22:30.27,Default,,0,0,0,,♪ Күндер өтіп жатыр
Dialogue: 0,1:22:30.36,1:22:32.94,Default,,0,0,0,,♪ Тоқта және қабылда
Dialogue: 0,1:22:38.16,1:22:42.20,Default,,0,0,0,,♪ Мен сенің қайда екеніңді білгім келеді.
Dialogue: 0,1:22:42.29,1:22:47.79,Default,,0,0,0,,♪ Тек аспанға қарап
Dialogue: 0,1:22:47.88,1:22:51.38,Default,,0,0,0,,♪ Кеудемде қатты ауырып тұр
Dialogue: 0,1:22:51.46,1:22:54.17,Default,,0,0,0,,♪ Бұл қалай көрінеді?
Dialogue: 0,1:22:54.26,1:22:59.10,Default,,0,0,0,,♪ Көлеңкеде ашылатын гүлдер әдемі.
Dialogue: 0,1:22:59.18,1:23:02.10,Default,,0,0,0,,♪ Кім сыбырлады?
Dialogue: 0,1:23:02.18,1:23:07.81,Default,,0,0,0,,♪ Барып көрейік. Мен сені қазір жолға апарамын.
Dialogue: 0,1:23:08.44,1:23:12.40,Default,,0,0,0,,♪ Солтүстік, оңтүстік, шығыс және батыс
Dialogue: 0,1:23:12.48,1:23:16.24,Default,,0,0,0,,♪ Жастар билетімен бұрылу
Dialogue: 0,1:23:16.32,1:23:20.24,Default,,0,0,0,,♪ Артқы жел сенімді
Dialogue: 0,1:23:20.32,1:23:24.25,Default,,0,0,0,,♪ Юбкаңызды шайқаңыз
Dialogue: 0,1:23:24.33,1:23:28.25,Default,,0,0,0,,♪ Мәселе Шешімді іздеу
Dialogue: 0,1:23:28.33,1:23:32.25,Default,,0,0,0,,♪ Бүктелген дәптер күлімсіреп сұрайды
Dialogue: 0,1:23:32.34,1:23:36.26,Default,,0,0,0,,♪ Тағы да сәл басқаша.
Dialogue: 0,1:23:36.34,1:23:40.26,Default,,0,0,0,,♪ Кешегіден де көп
Dialogue: 0,1:23:40.34,1:23:42.39,Default,,0,0,0,,♪ Бүгінгі жұлдыз
Dialogue: 0,1:23:42.47,1:23:49.40,Default,,0,0,0,,♪ Өмірімді нұрландырды
Dialogue: 0,1:23:59.53,1:24:01.24,Default,,0,0,0,,Азума мырза
Dialogue: 0,1:24:04.03,1:24:06.95,Default,,0,0,0,,Мені тапқаныңызға рахмет
Dialogue: 0,1:24:09.17,1:24:14.00,Default,,0,0,0,,Хигаши-чан Курумимен дос болған алғашқы қыз болды.
Dialogue: 0,1:24:14.09,1:24:17.13,Default,,0,0,0,,Мен сізді қолдауды жалғастырамын
Dialogue: 0,1:24:17.21,1:24:19.26,Default,,0,0,0,,Сіз әлі бас тартқан жоқсыз, солай ма?
Dialogue: 0,1:24:19.34,1:24:20.68,Default,,0,0,0,,Ах
Dialogue: 0,1:24:28.35,1:24:31.60,Default,,0,0,0,,Осы уақытқа дейін мен оны басқа біреу үшін деп айтып келдім.
Dialogue: 0,1:24:31.69,1:24:33.69,Default,,0,0,0,,Мен мұның бәрін өзім үшін жасадым.
Dialogue: 0,1:24:34.40,1:24:37.61,Default,,0,0,0,,Өзін мейірімді етіп көрсету және басқаларды ренжіту
Dialogue: 0,1:24:38.15,1:24:39.61,Default,,0,0,0,,Мен білемін
Dialogue: 0,1:24:39.70,1:24:43.16,Default,,0,0,0,,Менің айтарым, мұндай адамдар пұтқа айналмауы керек.
Dialogue: 0,1:24:44.66,1:24:49.66,Default,,0,0,0,,Бірақ менде әлі де мінезім нашар, өлуім жаман.
Dialogue: 0,1:24:55.54,1:24:59.34,Default,,0,0,0,,Мен бас тартқым келсе де, қолымнан келмейді.
Dialogue: 0,1:24:59.42,1:25:00.42,Default,,0,0,0,,Хехе
Dialogue: 0,1:25:04.93,1:25:09.48,Default,,0,0,0,,Иә, бұл шынымен де кездейсоқтық сияқты.
Dialogue: 0,1:25:10.06,1:25:13.10,Default,,0,0,0,,Мен байқауға қатысуға өтініш беріп, қабылдандым.
Dialogue: 0,1:25:14.06,1:25:17.61,Default,,0,0,0,,Иә, мен орта мектепте оқып жүргенде аз ғана ерікті болдым.
Dialogue: 0,1:25:18.19,1:25:22.36,Default,,0,0,0,,Мен біреуге күлімсіреуге көмектесе алғанымда, өзімді бірге бақытты сезіндім.
Dialogue: 0,1:25:22.95,1:25:26.87,Default,,0,0,0,,Сондықтан қазіргі жұмысымда көптеген адамдардың жүзінен күлкі көргім келеді.
Dialogue: 0,1:25:26.95,1:25:28.12,Default,,0,0,0,,Иә
Dialogue: 0,1:25:28.20,1:25:30.33,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,1:25:33.08,1:25:34.33,Default,,0,0,0,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,1:25:34.42,1:25:35.38,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,1:25:36.09,1:25:37.71,Default,,0,0,0,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,1:25:37.80,1:25:38.96,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,1:25:39.63,1:25:40.88,Default,,0,0,0,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,1:25:40.97,1:25:42.38,Default,,0,0,0,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,1:25:42.47,1:25:44.64,Default,,0,0,0,,Шығыс! Ерен еңбегіңіз үшін рахмет
Dialogue: 0,1:25:44.72,1:25:46.76,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,1:25:47.60,1:25:49.14,Default,,0,0,0,,Мен қазір барлығымен кездесуге барамын.
Dialogue: 0,1:25:49.22,1:25:52.60,Default,,0,0,0,,Шынымен бе? Менің ең жақсы құрметімді білдіруіңізді өтінемін.
Dialogue: 0,1:26:16.08,1:26:18.54,Default,,0,0,0,,Мен өткен күні барған дүкен туралы айтып отырмын.
Dialogue: 0,1:26:18.63,1:26:19.92,Default,,0,0,0,,Иә, не?
Dialogue: 0,1:26:20.00,1:26:23.05,Default,,0,0,0,,Өзіңіздің жұмсақ балмұздақ жасай алатын дүкен болды.
Dialogue: 0,1:26:23.13,1:26:24.13,Default,,0,0,0,,Иә
Dialogue: 0,1:26:24.22,1:26:25.72,Default,,0,0,0,,Бірақ мен сәтсіздікке ұшырадым...
Dialogue: 0,1:26:25.80,1:26:28.55,Default,,0,0,0,,Кешіріңіз, кешігіп қалдым.
Dialogue: 0,1:26:28.64,1:26:30.10,Default,,0,0,0,,Ах
Dialogue: 0,1:26:30.18,1:26:32.85,Default,,0,0,0,,Хигаши-чан (Мика) Көптен бері көрмегелі
Dialogue: 0,1:26:32.93,1:26:34.48,Default,,0,0,0,,Қайырлы күн Азума-сан
Dialogue: 0,1:26:34.56,1:26:38.11,Default,,0,0,0,,Уау, бұл үлкен! Сіз екіншісіз, солай ма?
Dialogue: 0,1:26:38.19,1:26:39.94,Default,,0,0,0,,Иә 7 ай
Dialogue: 0,1:26:40.02,1:26:41.40,Default,,0,0,0,,Үлкен бала ше?
Dialogue: 0,1:26:41.48,1:26:44.19,Default,,0,0,0,,6 жаста, бастауыш сынып оқушысы дерлік
Dialogue: 0,1:26:44.28,1:26:46.66,Default,,0,0,0,,Минами-сан әлі ұшып жүр ме?
Dialogue: 0,1:26:46.74,1:26:49.33,Default,,0,0,0,,Иә, мен бүгін таңға дейін Лаоста болдым.
Dialogue: 0,1:26:49.91,1:26:51.83,Default,,0,0,0,,Куруми-чан ше? Соңғы кездері қалай болдыңыз?
Dialogue: 0,1:26:51.91,1:26:53.87,Default,,0,0,0,,Сергектік жалғасуда
Dialogue: 0,1:27:02.55,1:27:07.09,Default,,0,0,0,,♪~
Dialogue: 0,1:28:02.52,1:28:06.53,Default,,0,0,0,,~♪
Dialogue: 0,1:28:10.49,1:28:11.62,Default,,0,0,0,,Эй
Dialogue: 0,1:28:11.70,1:28:13.20,Default,,0,0,0,,Қараңыз
Dialogue: 0,1:28:15.45,1:28:17.62,Default,,0,0,0,,Бұл...
Dialogue: 0,1:28:30.59,1:28:31.64,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,1:28:55.78,1:28:59.25,Default,,0,0,0,,Мен жай ғана кумир болғым келді
Dialogue: 0,1:29:00.12,1:29:02.00,Default,,0,0,0,,Мен ол кезде қазіргіден де балаша, ақымақ едім.
Dialogue: 0,1:29:02.00,1:29:04.79,Default,,0,0,0,,Мен ол кезде қазіргіден де балаша, ақымақ едім.
Dialogue: 0,1:29:02.00,1:29:04.79,Default,,0,0,0,,(♪Соңғы тақырып)
Dialogue: 0,1:29:04.79,1:29:04.88,Default,,0,0,0,,(♪Соңғы тақырып)
Dialogue: 0,1:29:04.88,1:29:07.00,Default,,0,0,0,,(♪Соңғы тақырып)
Dialogue: 0,1:29:04.88,1:29:07.00,Default,,0,0,0,,Бұл салқын және салқын болды
Dialogue: 0,1:29:07.00,1:29:07.50,Default,,0,0,0,,Бұл салқын және салқын болды
Dialogue: 0,1:29:08.59,1:29:13.68,Default,,0,0,0,,Армандарын орындағандар ғана армандарын жүзеге асырудың қуанышын түсіне алады.
Dialogue: 0,1:29:14.64,1:29:17.56,Default,,0,0,0,,Сондықтан мен анық айта аламын
Dialogue: 0,1:29:19.56,1:29:22.77,Default,,0,0,0,,Сол кезде мен үшін рахмет
Dialogue: 0,1:34:28.37,1:34:32.37,Default,,0,0,0,,~♪
Dialogue: 0,1:34:33.87,1:34:39.87,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
