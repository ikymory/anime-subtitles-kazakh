Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,♪~
Dialogue: 0,0:01:25.56,0:01:29.81,Default,,0,0,0,,~♪
Dialogue: 0,0:01:31.86,0:01:33.32,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:01:35.11,0:01:36.82,Default,,0,0,0,,қоғамдық бейбітшілік хатын алмастыру үшін, иә?
Dialogue: 0,0:01:37.95,0:01:39.53,Default,,0,0,0,,Фрирен.
Dialogue: 0,0:01:41.12,0:01:45.75,Default,,0,0,0,,Адамзаттың Солтракты зерттеп, талдауына үлкен үлес қосты.
Dialogue: 0,0:01:46.25,0:01:51.21,Default,,0,0,0,,Тарихта ең көп жындарды өлтірген сиқыршы.
Dialogue: 0,0:01:53.92,0:01:56.17,Default,,0,0,0,,Фриренді жерлеу
Dialogue: 0,0:01:58.43,0:02:00.84,Default,,0,0,0,,Ол мен жек көретін данышпан.
Dialogue: 0,0:02:12.56,0:02:14.98,Default,,0,0,0,,Ол біраз демалады.
Dialogue: 0,0:02:15.07,0:02:16.65,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:02:17.78,0:02:20.32,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:02:20.41,0:02:24.20,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:24.28,0:02:25.54,Default,,0,0,0,,Эй!
Dialogue: 0,0:02:26.54,0:02:27.87,Default,,0,0,0,,Ха... жақсысың ба?
Dialogue: 0,0:02:29.54,0:02:32.00,Default,,0,0,0,,Балалар сендерге рахмет, мен құтқарылдым.
Dialogue: 0,0:02:32.08,0:02:33.71,Default,,0,0,0,,Кишибе Рохан секілді күші бар біреу!
Dialogue: 0,0:02:34.42,0:02:35.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:38.76,0:02:41.63,Default,,0,0,0,,Сиқыршы серігін кешірейік.
Dialogue: 0,0:02:41.72,0:02:45.10,Default,,0,0,0,,Оның шешімі дұрыс болды.
Dialogue: 0,0:02:46.06,0:02:49.06,Default,,0,0,0,,Енді Фрирен қалаға оралуы мүмкін.
Dialogue: 0,0:02:49.14,0:02:51.10,Default,,0,0,0,,Лугнерді және басқаларды жеңейік.
Dialogue: 0,0:02:51.98,0:02:52.94,Default,,0,0,0,,Ум...
Dialogue: 0,0:02:53.02,0:02:56.44,Default,,0,0,0,,Лорд Фрирен күзетшіні өлтірген жоқ...
Dialogue: 0,0:02:56.52,0:02:59.86,Default,,0,0,0,,Мен білемін, оны жындар жасады.
Dialogue: 0,0:03:00.49,0:03:04.45,Default,,0,0,0,,Әлде бұл шебер Фрирен деп аталады ма?
Dialogue: 0,0:03:04.53,0:03:05.37,Default,,0,0,0,,Иә
Dialogue: 0,0:03:06.08,0:03:07.70,Default,,0,0,0,,Мен оның батырлар тобында екеніне сене алмадым⸺
Dialogue: 0,0:03:07.79,0:03:09.95,Default,,0,0,0,,Эльф шебері?
Dialogue: 0,0:03:10.54,0:03:13.50,Default,,0,0,0,,Егер солай болса, мен дөрекі болған шығармын.
Dialogue: 0,0:03:14.42,0:03:17.63,Default,,0,0,0,,Гранато отбасы батырлар тобына қарыздар.
Dialogue: 0,0:03:17.71,0:03:20.05,Default,,0,0,0,,Атам заманында
Dialogue: 0,0:03:20.13,0:03:23.30,Default,,0,0,0,,Бұл қалаға жындар әскері шабуыл жасағанда
Dialogue: 0,0:03:23.38,0:03:25.14,Default,,0,0,0,,Мен оларды тойтардым.
Dialogue: 0,0:03:26.26,0:03:31.35,Default,,0,0,0,,Сол кездегі қарсылас Шичикусукен гильотинасының аурасы да болды.
Dialogue: 0,0:03:33.56,0:03:36.02,Default,,0,0,0,,Біраз уақыт болды, Аура.
Dialogue: 0,0:03:36.11,0:03:39.82,Default,,0,0,0,,Иә, 80 жыл өтті.
Dialogue: 0,0:03:39.90,0:03:41.03,Default,,0,0,0,,Фрирен
Dialogue: 0,0:03:44.57,0:03:47.03,Default,,0,0,0,,Келесі қалаға баруды жоспарлап отырсыз ба?
Dialogue: 0,0:03:48.03,0:03:50.75,Default,,0,0,0,,Мені кері қайтарсаңыз, риза болар едім.
Dialogue: 0,0:03:51.37,0:03:52.21,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:03:53.12,0:03:53.96,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:04:14.60,0:04:17.98,Default,,0,0,0,,Өйткені мен басыммын.
Dialogue: 0,0:04:19.07,0:04:20.23,Default,,0,0,0,,Иә
Dialogue: 0,0:04:23.74,0:04:25.78,Default,,0,0,0,,Содан бері өсті.
Dialogue: 0,0:04:26.28,0:04:28.70,Default,,0,0,0,,Сонша санмен жұмыс істеу керек пе?
Dialogue: 0,0:04:28.78,0:04:31.24,Default,,0,0,0,,Жындардың сиқыры шектен шыққан.
Dialogue: 0,0:04:31.95,0:04:36.04,Default,,0,0,0,,Бұл адамның сиқырлы технологиясымен елестете алмайтын биіктік.
Dialogue: 0,0:04:37.46,0:04:40.59,Default,,0,0,0,,Бірақ бұл ең дәмсіз сиқыр.
Dialogue: 0,0:04:40.67,0:04:41.63,Default,,0,0,0,,У… Қозғалма! Атып жіберемін!
Dialogue: 0,0:04:42.51,0:04:44.42,Default,,0,0,0,,Бұл қорқынышты нәрсе.
Dialogue: 0,0:04:44.51,0:04:47.09,Default,,0,0,0,,Мен оларды жинау үшін көп еңбектенсем де.
Dialogue: 0,0:04:56.48,0:04:59.06,Default,,0,0,0,,Мұнда таныс сауыт бар.
Dialogue: 0,0:05:00.32,0:05:01.36,Default,,0,0,0,,Аура
Dialogue: 0,0:05:01.44,0:05:04.15,Default,,0,0,0,,Сен мені осы жерде өлтіруің керек.
Dialogue: 0,0:05:05.95,0:05:07.16,Default,,0,0,0,,Хехе
Dialogue: 0,0:05:08.62,0:05:10.33,Default,,0,0,0,,Мойынсұну таразылары
Dialogue: 0,0:05:11.91,0:05:15.54,Default,,0,0,0,,Аураны көп жылдар бойы жеңе алмауымыздың себебі осы.
Dialogue: 0,0:05:16.79,0:05:18.46,Default,,0,0,0,,Ол пайдаланады
Dialogue: 0,0:05:18.54,0:05:22.71,Default,,0,0,0,,Қарсыласты өзіне бағындыратын және оны өз қалауы бойынша басқаратын сиқыр
Dialogue: 0,0:05:23.30,0:05:28.09,Default,,0,0,0,,Шичикүрекеңнің сиқыры адам білімінен де, адам ақылынан да асып түседі.
Dialogue: 0,0:05:29.09,0:05:33.01,Default,,0,0,0,,Аура өз жанын және нысананың жанын таразыға қояды.
Dialogue: 0,0:05:33.10,0:05:35.48,Default,,0,0,0,,Сиқырлы күштің шамасын өлшеу
Dialogue: 0,0:05:36.39,0:05:39.02,Default,,0,0,0,,Сиқырлы күш көбірек болса жақсы болар еді
Dialogue: 0,0:05:39.10,0:05:42.77,Default,,0,0,0,,Сіз басқаларды бағындырып, оларды қуыршақ ретінде пайдалана аласыз.
Dialogue: 0,0:05:43.27,0:05:48.11,Default,,0,0,0,,Дене шірігенше, мәңгілікке.
Dialogue: 0,0:05:49.61,0:05:52.49,Default,,0,0,0,,Тәуекел сиқырды күшті етеді
Dialogue: 0,0:05:53.03,0:05:55.75,Default,,0,0,0,,Сиқырлы күшке ие Аура үшін,
Dialogue: 0,0:05:55.83,0:05:57.10,Default,,0,0,0,,Бұл сенімді сиқыр
Dialogue: 0,0:05:58.08,0:06:00.75,Default,,0,0,0,,Қарсыласу мүмкін емес пе?
Dialogue: 0,0:06:02.79,0:06:05.00,Default,,0,0,0,,Аураның сиқырлы күшінің салмағымен
Dialogue: 0,0:06:05.09,0:06:08.80,Default,,0,0,0,,Таразы қисайғанымен, бастапқыда әділ.
Dialogue: 0,0:06:09.97,0:06:13.72,Default,,0,0,0,,Аурадан да сиқырлы күші бар жан таразыда тұрса,
Dialogue: 0,0:06:14.35,0:06:16.68,Default,,0,0,0,,Сіз Аураны жеңе аласыз.
Dialogue: 0,0:06:18.23,0:06:20.10,Default,,0,0,0,,Бірақ олай емес.
Dialogue: 0,0:06:20.19,0:06:24.27,Default,,0,0,0,,Аураның жеті данышпан ретінде билік еткеніне 500 жыл
Dialogue: 0,0:06:24.36,0:06:27.36,Default,,0,0,0,,Ешқашан болмаған деп айтылады.
Dialogue: 0,0:06:27.44,0:06:30.86,Default,,0,0,0,,Сонда қарсы шаралар жоқ па?
Dialogue: 0,0:06:35.45,0:06:38.25,Default,,0,0,0,,Шын мәнінде, болды.
Dialogue: 0,0:06:38.33,0:06:40.46,Default,,0,0,0,,Ерік-жігері мықтылар
Dialogue: 0,0:06:40.54,0:06:43.38,Default,,0,0,0,,Уақытша болса да қарсылыққа қол жеткізілді.
Dialogue: 0,0:06:46.00,0:06:47.38,Default,,0,0,0,,Болаттың өсиеті
Dialogue: 0,0:06:47.46,0:06:50.38,Default,,0,0,0,,Батыр қаншалықты жақсы дайындалған болса, соғұрлым оның қабілеті жоғары болады.
Dialogue: 0,0:06:51.26,0:06:53.51,Default,,0,0,0,,Бұл әлі де уақытша ма?
Dialogue: 0,0:06:54.10,0:06:56.51,Default,,0,0,0,,Бірақ бұл өлімге әкелетін кемшілік.
Dialogue: 0,0:06:56.60,0:06:59.89,Default,,0,0,0,,Оның еркі кедергі болған шығар.
Dialogue: 0,0:07:00.52,0:07:01.81,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:07:03.65,0:07:05.69,Default,,0,0,0,,Гильотина аурасы
Dialogue: 0,0:07:05.77,0:07:09.53,Default,,0,0,0,,Өзіне айла-шарғы жасағандарға өте орынды шара қолданды.
Dialogue: 0,0:07:10.82,0:07:12.53,Default,,0,0,0,,Бұл қорқынышты оқиға.
Dialogue: 0,0:07:18.91,0:07:19.75,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:07:20.50,0:07:23.25,Default,,0,0,0,,Менің өлмейтін әскерім күшті емес пе?
Dialogue: 0,0:07:35.80,0:07:37.01,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:07:38.01,0:07:39.14,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:07:40.10,0:07:43.35,Default,,0,0,0,,Мен жасаған сиқырдан бас тартылды.
Dialogue: 0,0:07:44.06,0:07:46.15,Default,,0,0,0,,Мұндай жағдай бірінші рет болып тұр.
Dialogue: 0,0:07:47.02,0:07:49.94,Default,,0,0,0,,Мұндай күшті жою сиқыры
Dialogue: 0,0:07:50.03,0:07:53.45,Default,,0,0,0,,Сиқырлы қуатты тұтыну да айтарлықтай болуы керек.
Dialogue: 0,0:07:53.53,0:07:56.16,Default,,0,0,0,,Неліктен сіз бірдеңені осылай айналдырасыз?
Dialogue: 0,0:07:58.45,0:08:02.37,Default,,0,0,0,,Біз соңғы рет ұрысып қалғанда, сен таң қалдырдың.
Dialogue: 0,0:08:04.75,0:08:07.54,Default,,0,0,0,,Химмел кейін маған ашуланды.
Dialogue: 0,0:08:08.71,0:08:12.55,Default,,0,0,0,,Онда мұны істеудің қажеті жоқ.
Dialogue: 0,0:08:13.88,0:08:14.93,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:08:15.64,0:08:17.68,Default,,0,0,0,,Химмел енді бұл жерде жоқ.
Dialogue: 0,0:08:20.26,0:08:22.18,Default,,0,0,0,,Түсінемін, бұл жақсы.
Dialogue: 0,0:08:24.06,0:08:27.19,Default,,0,0,0,,Өйткені, сен жындар құбыжықсың.
Dialogue: 0,0:08:27.27,0:08:29.65,Default,,0,0,0,,Аяусыз өлтіре алады
Dialogue: 0,0:08:29.73,0:08:30.65,Default,,0,0,0,,Жарайды
Dialogue: 0,0:08:31.73,0:08:34.20,Default,,0,0,0,,Мен көп қозғала бастадым.
Dialogue: 0,0:08:35.49,0:08:38.66,Default,,0,0,0,,Әке, бұл жерде қауіпсіз, солай ма?
Dialogue: 0,0:08:38.74,0:08:39.83,Default,,0,0,0,,Иә
Dialogue: 0,0:08:39.91,0:08:42.33,Default,,0,0,0,,Қорғаныш кедергісі сияқты жақсы болмаса да.
Dialogue: 0,0:08:42.41,0:08:45.29,Default,,0,0,0,,Бұл шіркеудің де кедергісі бар.
Dialogue: 0,0:08:45.92,0:08:48.25,Default,,0,0,0,,Олай болса, граф, осында күт.
Dialogue: 0,0:08:49.09,0:08:50.17,Default,,0,0,0,,Тәтті бала
Dialogue: 0,0:08:50.25,0:08:52.55,Default,,0,0,0,,Сіз не істеуді жоспарлап отырсыз?
Dialogue: 0,0:08:52.63,0:08:54.67,Default,,0,0,0,,Осындай жерге тығылсам ше?
Dialogue: 0,0:08:54.76,0:08:57.01,Default,,0,0,0,,Жындар қайтып келе ме?
Dialogue: 0,0:08:57.51,0:09:00.30,Default,,0,0,0,,Старк мырза, сіз байсалдысыз ба?
Dialogue: 0,0:09:01.10,0:09:04.43,Default,,0,0,0,,Бұл кезде тосын шабуыл тек кездейсоқ сәтті болды.
Dialogue: 0,0:09:04.52,0:09:07.60,Default,,0,0,0,,Шындығында соңғы соққыны беруге мүмкіндік болмады.
Dialogue: 0,0:09:09.44,0:09:11.57,Default,,0,0,0,,Егер біз осылай шайқассақ
Dialogue: 0,0:09:11.65,0:09:14.24,Default,,0,0,0,,Өлтірген біз едік.
Dialogue: 0,0:09:15.28,0:09:18.20,Default,,0,0,0,,Мұны біреу істеу керек.
Dialogue: 0,0:09:22.99,0:09:24.62,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:09:24.70,0:09:26.41,Default,,0,0,0,,Барымызды бірге жасайық.
Dialogue: 0,0:09:28.58,0:09:32.25,Default,,0,0,0,,Жоқ, Ферн күзет бекетіне бару керек.
Dialogue: 0,0:09:32.34,0:09:34.38,Default,,0,0,0,,Қала тұрғындарын эвакуациялаңыз.
Dialogue: 0,0:09:34.88,0:09:36.67,Default,,0,0,0,,Сонымен, Старк мырза...
Dialogue: 0,0:09:39.51,0:09:41.68,Default,,0,0,0,,О, мен...
Dialogue: 0,0:09:42.93,0:09:46.18,Default,,0,0,0,,Догеза бар күшіңді салып, Фриренді қайтар.
Dialogue: 0,0:09:47.14,0:09:48.31,Default,,0,0,0,,А...
Dialogue: 0,0:09:50.86,0:09:54.44,Default,,0,0,0,,Не! Мені жеңуіңізге мүмкіндік беруден басқа амалым жоқ.
Dialogue: 0,0:09:55.32,0:09:58.70,Default,,0,0,0,,Бұл, әрине, шынайырақ.
Dialogue: 0,0:10:03.03,0:10:04.08,Default,,0,0,0,,Маған мынаны көрсетсеңіз
Dialogue: 0,0:10:04.16,0:10:06.70,Default,,0,0,0,,Күзетшілер сізді тыңдайды.
Dialogue: 0,0:10:07.79,0:10:09.08,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:10:10.50,0:10:12.38,Default,,0,0,0,,Мен бірден қаладан кетемін.
Dialogue: 0,0:10:14.17,0:10:15.21,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:15.30,0:10:18.88,Default,,0,0,0,,Сіздің қолыңыз өте ауыр жағдайда.
Dialogue: 0,0:10:18.97,0:10:21.89,Default,,0,0,0,,Қамалдың қақпасынан осылай өтуге бола ма?
Dialogue: 0,0:10:22.64,0:10:24.43,Default,,0,0,0,,Жарайды, солай ма?
Dialogue: 0,0:10:24.51,0:10:26.72,Default,,0,0,0,,Жауынгер үшін бұл қалыпты жағдай.
Dialogue: 0,0:10:26.81,0:10:28.06,Default,,0,0,0,,Бірдеңе дұрыс емес пе?
Dialogue: 0,0:10:28.64,0:10:29.69,Default,,0,0,0,,Екі қолы қанға боялған
Dialogue: 0,0:10:29.77,0:10:31.77,Default,,0,0,0,,Қаланы аралап жүрген жауынгерлер.
Dialogue: 0,0:10:31.85,0:10:33.44,Default,,0,0,0,,Мен оны бұрын ешқашан көрген емеспін.
Dialogue: 0,0:10:34.02,0:10:36.36,Default,,0,0,0,,Біріншіден, сіз адам туралы ештеңе айта алмайсыз.
Dialogue: 0,0:10:36.44,0:10:37.44,Default,,0,0,0,,Тіпті Ферн...
Dialogue: 0,0:10:38.40,0:10:42.95,Default,,0,0,0,,Иә? Бұл кімнің қаны? Бұл менің қаным емес...
Dialogue: 0,0:10:46.49,0:10:48.10,Default,,0,0,0,,Сәлем! Не болды... аа
Dialogue: 0,0:10:52.96,0:10:55.25,Default,,0,0,0,,Старк мырза, сиқырлы күш осы қаннан шығады...
Dialogue: 0,0:10:57.21,0:10:58.17,Default,,0,0,0,,Ферн!
Dialogue: 0,0:11:06.72,0:11:07.56,Default,,0,0,0,,Балта?
Dialogue: 0,0:11:12.56,0:11:14.61,Default,,0,0,0,,Мен сенбеймін
Dialogue: 0,0:11:14.69,0:11:16.65,Default,,0,0,0,,Мен тіпті түс көріп тұрмын ба?
Dialogue: 0,0:11:17.65,0:11:20.15,Default,,0,0,0,,Бұл шебердің шеберлігі.
Dialogue: 0,0:11:23.36,0:11:27.08,Default,,0,0,0,,Мен нашар қозғалғандықтан, өмірлік маңызды ойымды өткізіп алдым.
Dialogue: 0,0:11:28.08,0:11:30.10,Default,,0,0,0,,Мен сені қинаймын деп ойлаған жоқпын.
Dialogue: 0,0:11:35.17,0:11:37.55,Default,,0,0,0,,Сіз не нәрсеге таң қалдыңыз?
Dialogue: 0,0:11:38.09,0:11:41.97,Default,,0,0,0,,Мен өлімші жарақат аламын деп тұрсам да, осында тұрмын ба?
Dialogue: 0,0:11:42.05,0:11:45.97,Default,,0,0,0,,Әлде олар біздің көзқарасымызды анықтай алмады ма?
Dialogue: 0,0:11:47.93,0:11:51.64,Default,,0,0,0,,Сиқырлы күшті басқару арқылы болмысты жасыру, т.б.
Dialogue: 0,0:11:51.73,0:11:54.40,Default,,0,0,0,,Сіз өзіңіздің талантыңызда жалғыз емессіз
Dialogue: 0,0:11:54.48,0:11:57.73,Default,,0,0,0,,Мұны кез келген жын жасай алады.
Dialogue: 0,0:11:58.65,0:11:59.48,Default,,0,0,0,,Алайда...
Dialogue: 0,0:12:00.07,0:12:03.65,Default,,0,0,0,,Бұл сиқыршылар арасындағы шайқасқа ұқсас әрекет.
Dialogue: 0,0:12:03.74,0:12:05.49,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:12:06.57,0:12:10.24,Default,,0,0,0,,Сіз көп сөйлейсіз, мені өлтірмейсіз бе?
Dialogue: 0,0:12:12.25,0:12:15.79,Default,,0,0,0,,Енді мен сені өлтіре алмағандықтан, сенен сұрайын дегенім бар.
Dialogue: 0,0:12:18.46,0:12:20.55,Default,,0,0,0,,Әлде қазір өлуім керек пе?
Dialogue: 0,0:12:22.55,0:12:23.55,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:12:26.47,0:12:28.80,Default,,0,0,0,,Мына бала күшті ме?
Dialogue: 0,0:12:29.60,0:12:32.22,Default,,0,0,0,,Жауынгер Айзеннің ең жақсы шәкірті
Dialogue: 0,0:12:32.73,0:12:35.56,Default,,0,0,0,,Иә, бұл біртүрлі нәрсе.
Dialogue: 0,0:12:36.15,0:12:37.69,Default,,0,0,0,,Бейшара жігіт
Dialogue: 0,0:12:37.77,0:12:41.07,Default,,0,0,0,,Сіз Линьерге қарсы жаман өлмейсіз.
Dialogue: 0,0:12:43.15,0:12:44.82,Default,,0,0,0,,Тағы бір нәрсе
Dialogue: 0,0:12:45.45,0:12:47.41,Default,,0,0,0,,Фрирен қайда орналасқан?
Dialogue: 0,0:12:50.12,0:12:51.83,Default,,0,0,0,,Мен бұл қаладан қашып кеттім.
Dialogue: 0,0:12:53.12,0:12:56.67,Default,,0,0,0,,Бұл түрме күзетшісін өлтіргеніңіз үшін.
Dialogue: 0,0:12:56.75,0:12:59.50,Default,,0,0,0,,Граф Гранато да осылай деді.
Dialogue: 0,0:12:59.59,0:13:02.09,Default,,0,0,0,,Күзетшіні өлтіру ауыр қылмыс сияқты.
Dialogue: 0,0:13:02.92,0:13:04.09,Default,,0,0,0,,Өлім жазасы
Dialogue: 0,0:13:04.17,0:13:05.67,Default,,0,0,0,,Өлім жазасы...
Dialogue: 0,0:13:06.22,0:13:09.47,Default,,0,0,0,,Әлгі әйел мұндай нәрседен қашып кетер ме еді?
Dialogue: 0,0:13:10.22,0:13:13.35,Default,,0,0,0,,Оның жын-шайтандарға деген өшпенділігі күшті.
Dialogue: 0,0:13:14.06,0:13:18.85,Default,,0,0,0,,Оның шәкірттеріне жындарды өлтіру үшін сиқырға үйрететіні соншалық.
Dialogue: 0,0:13:20.15,0:13:22.48,Default,,0,0,0,,Ондай адамның қашып кетуі мүмкін емес.
Dialogue: 0,0:13:23.36,0:13:25.49,Default,,0,0,0,,Қандай да бір мақсат болуы керек.
Dialogue: 0,0:13:28.20,0:13:29.41,Default,,0,0,0,,Аура-сама?
Dialogue: 0,0:13:33.70,0:13:35.29,Default,,0,0,0,,Әйелдер бұл рөлге жарамайды; ол спикер ретіндегі рөлін түсінуде жеткіліксіз санаға ие болған деген қорытындыға келуге тура келеді
Dialogue: 0,0:13:36.41,0:13:40.46,Default,,0,0,0,,Сізде Фрирен мырзаның қайда бара жатқаны туралы түсінік бар.
Dialogue: 0,0:13:40.96,0:13:42.80,Default,,0,0,0,,Боқ
Dialogue: 0,0:13:43.71,0:13:47.30,Default,,0,0,0,,Мені өлтіре алмадың деген өтірік.
Dialogue: 0,0:13:47.38,0:13:52.43,Default,,0,0,0,,Сіз бұл тосын шабуыл үшін маған қарсы келгіңіз келді.
Dialogue: 0,0:13:53.18,0:13:55.77,Default,,0,0,0,,Тәкаппар және мақтаншақ
Dialogue: 0,0:13:55.85,0:13:57.89,Default,,0,0,0,,Әлі де біз...
Dialogue: 0,0:13:57.98,0:14:00.90,Default,,0,0,0,,Мен тіпті Фрирен-самадан басқа ешкімге қауіп төндіретінін сезбеймін.
Dialogue: 0,0:14:02.02,0:14:05.40,Default,,0,0,0,,Сондықтан ол тіпті маған ашуға тырысты.
Dialogue: 0,0:14:07.53,0:14:10.99,Default,,0,0,0,,Осы жақын қашықтықта мен сіздің жүрегіңізді дәл аттай аламын.
Dialogue: 0,0:14:12.70,0:14:17.04,Default,,0,0,0,,Басыңыз ұшып кетпей тұрып көріңіз.
Dialogue: 0,0:14:25.13,0:14:26.26,Default,,0,0,0,,Фрирен мырза
Dialogue: 0,0:14:27.21,0:14:29.72,Default,,0,0,0,,Мен көмектесіп жатырмын ба?
Dialogue: 0,0:14:29.80,0:14:32.01,Default,,0,0,0,,Неліктен бұлай сұрайсыз?
Dialogue: 0,0:14:33.43,0:14:35.26,Default,,0,0,0,,Мен Фрирен мырза сияқты жақсымын⸺
Dialogue: 0,0:14:35.35,0:14:37.77,Default,,0,0,0,,Сиқырды мүлтіксіз қолдана алмау
Dialogue: 0,0:14:38.64,0:14:42.06,Default,,0,0,0,,Бұл біздің өмір сүрген уақытымыздың айырмашылығына байланысты.
Dialogue: 0,0:14:42.15,0:14:44.90,Default,,0,0,0,,Ферн мені ешқашан қуып жете алмайды.
Dialogue: 0,0:14:46.61,0:14:48.24,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:14:48.94,0:14:53.03,Default,,0,0,0,,Бірақ бұл тек сиқыр мен технология мәселесі.
Dialogue: 0,0:14:53.62,0:14:57.37,Default,,0,0,0,,Мен жиі құбыжықтармен шайқастарды Фернге қалдырамын.
Dialogue: 0,0:14:57.45,0:15:00.25,Default,,0,0,0,,Иә, мен бұл жолы қайталауға мәжбүр болдым.
Dialogue: 0,0:15:00.33,0:15:01.54,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:02.58,0:15:06.05,Default,,0,0,0,,Ферн шайқаса, тезірек аяқталады.
Dialogue: 0,0:15:06.13,0:15:09.55,Default,,0,0,0,,Өйткені сен маған қарағанда сиқырды жылдам атасың.
Dialogue: 0,0:15:11.26,0:15:12.55,Default,,0,0,0,,Кішкентай қыз
Dialogue: 0,0:15:13.51,0:15:16.81,Default,,0,0,0,,Мен өмірімнің көп бөлігін сиқырға арнадым.
Dialogue: 0,0:15:18.02,0:15:19.81,Default,,0,0,0,,Мен де
Dialogue: 0,0:15:33.74,0:15:36.28,Default,,0,0,0,,Не? Бұл реакция жылдамдығы
Dialogue: 0,0:15:37.24,0:15:39.04,Default,,0,0,0,,Өзіңізді рефлексивті түрде қорғамасаңыз.
Dialogue: 0,0:15:39.12,0:15:41.96,Default,,0,0,0,,Оның жүрегіне оқ тиген.
Dialogue: 0,0:15:42.04,0:15:43.79,Default,,0,0,0,,Сіз оны қорғадыңыз.
Dialogue: 0,0:15:43.87,0:15:46.04,Default,,0,0,0,,Сіздің жүрегіңіз әлсіз жері ме?
Dialogue: 0,0:15:47.46,0:15:48.55,Default,,0,0,0,,≫ Тап-тап-тап (аяқ дыбысы) (Ол Майт) Һм?
Dialogue: 0,0:15:49.92,0:15:51.26,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:51.76,0:15:55.30,Default,,0,0,0,,Өмірін соған арнадым десе, өтірік емес сияқты.
Dialogue: 0,0:15:56.43,0:15:59.60,Default,,0,0,0,,Онда мен сені бар күшіммен басып тастаймын.
Dialogue: 0,0:16:00.10,0:16:01.06,Default,,0,0,0,,Бартель
Dialogue: 0,0:16:04.77,0:16:06.90,Default,,0,0,0,,Екінші жағы да басталды ма?
Dialogue: 0,0:16:08.27,0:16:10.07,Default,,0,0,0,,Бірақ бұл ұят.
Dialogue: 0,0:16:10.73,0:16:12.90,Default,,0,0,0,,Енді бітті.
Dialogue: 0,0:16:14.11,0:16:16.12,Default,,0,0,0,,Мүмкін мен ойынды қарайтын шығармын.
Dialogue: 0,0:16:16.62,0:16:20.24,Default,,0,0,0,,Рагнер мырза, мен сізді мазалағанда ашуланасыз, солай емес пе?
Dialogue: 0,0:16:21.45,0:16:23.87,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:25.50,0:16:26.33,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:26.42,0:16:30.34,Default,,0,0,0,,Әлі біткен жоқ...
Dialogue: 0,0:16:30.92,0:16:34.09,Default,,0,0,0,,Бұл тұрақты. Кішкене қызық болатын сияқты.
Dialogue: 0,0:16:37.68,0:16:40.51,Default,,0,0,0,,Сиқыр, технология және бақылау
Dialogue: 0,0:16:40.60,0:16:42.60,Default,,0,0,0,,Мен әлдеқайда жақсымын
Dialogue: 0,0:17:03.70,0:17:08.58,Default,,0,0,0,,Кішкентай қыз бен менің арамыздағы айырмашылықты айтып жеткізу мүмкін емес.
Dialogue: 0,0:17:08.67,0:17:11.34,Default,,0,0,0,,Жай... тез
Dialogue: 0,0:17:12.88,0:17:16.13,Default,,0,0,0,,Мені тек күш-жігермен итеріп жіберді.
Dialogue: 0,0:17:22.68,0:17:27.73,Default,,0,0,0,,Фрирен, сен мына кішкентай қыздың бойына қандай тәрбие бердің?
Dialogue: 0,0:17:31.32,0:17:34.44,Default,,0,0,0,,Мен оны жойылу соғысына әкеліп, сиқырдың біткенін күтуім керек пе?
Dialogue: 0,0:17:47.87,0:17:49.29,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:17:50.21,0:17:52.92,Default,,0,0,0,,Оған дейін шешіледі.
Dialogue: 0,0:17:53.59,0:17:56.55,Default,,0,0,0,,Егер мен тым болмаса саңылау жасай алсам...
Dialogue: 0,0:17:57.13,0:17:59.26,Default,,0,0,0,,Лини, не істеп жатырсың!
Dialogue: 0,0:17:59.34,0:18:00.68,Default,,0,0,0,,Тез сол затты қолға ал!
Dialogue: 0,0:18:04.52,0:18:06.52,Default,,0,0,0,,Уф... уф
Dialogue: 0,0:18:07.94,0:18:10.15,Default,,0,0,0,,Бұл не? Сен өзімшілсің.
Dialogue: 0,0:18:10.23,0:18:12.90,Default,,0,0,0,,Бұл жігіт қорғаныста табанды.
Dialogue: 0,0:18:13.48,0:18:14.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:15.40,0:18:16.90,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:16.99,0:18:18.28,Default,,0,0,0,,Уф!
Dialogue: 0,0:18:31.75,0:18:35.09,Default,,0,0,0,,Бұл балташылық нені білдіреді?
Dialogue: 0,0:18:35.17,0:18:37.46,Default,,0,0,0,,Бұл шебердің шеберлігі.
Dialogue: 0,0:18:37.55,0:18:40.72,Default,,0,0,0,,Мен сиқырды жақсы оқимын.
Dialogue: 0,0:18:41.51,0:18:46.18,Default,,0,0,0,,Қозғалыс кезінде адам денесінің ішіндегі сиқырлы күш ағынын есте сақтаңыз.
Dialogue: 0,0:18:46.27,0:18:48.48,Default,,0,0,0,,Сіз қозғалыстарға еліктей аласыз, солай ма?
Dialogue: 0,0:18:48.56,0:18:50.23,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:19:05.33,0:19:06.83,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:13.92,0:19:16.09,Default,,0,0,0,,Сенің зәулім сарайда бірінші рет қозғалғаныңды көргенде
Dialogue: 0,0:19:16.17,0:19:17.55,Default,,0,0,0,,сенімді
Dialogue: 0,0:19:18.34,0:19:22.93,Default,,0,0,0,,Ол мен бұрыннан есімде қалған ең күшті жауынгердің қимылдарын жасап жатыр.
Dialogue: 0,0:19:25.68,0:19:26.51,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:26.60,0:19:28.93,Default,,0,0,0,,Мұндай кездейсоқтықтар бар.
Dialogue: 0,0:19:29.02,0:19:30.39,Default,,0,0,0,,Тағдыр қызық
Dialogue: 0,0:19:31.35,0:19:32.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:34.90,0:19:36.15,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:19:36.86,0:19:39.90,Default,,0,0,0,,Жауынгер Айзеннің қимылдарына еліктеймін.
Dialogue: 0,0:19:41.32,0:19:43.86,Default,,0,0,0,,Бұл не? Бұл жынды емес пе?
Dialogue: 0,0:19:47.08,0:19:49.62,Default,,0,0,0,,Мен осындай нәрседе жеңіске жетуім керек ...
Dialogue: 0,0:19:49.95,0:19:51.37,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:58.21,0:20:00.26,Default,,0,0,0,,Ол ақыры құлады ма?
Dialogue: 0,0:20:00.34,0:20:04.38,Default,,0,0,0,,Егер сіз асықпасаңыз, Мастер Рагнер сізге тағы ұрысады.
Dialogue: 0,0:20:07.47,0:20:09.10,Default,,0,0,0,,Құлап қалдыңыз ба?
Dialogue: 0,0:20:09.81,0:20:12.23,Default,,0,0,0,,Мен құлап жатырмын ба?
Dialogue: 0,0:20:16.02,0:20:17.69,Default,,0,0,0,,Тұрған Старк
Dialogue: 0,0:20:18.19,0:20:22.69,Default,,0,0,0,,Қанша тозса да, құлағаныңды кешіремін.
Dialogue: 0,0:20:23.57,0:20:25.82,Default,,0,0,0,,Сіз мұны айтқан болсаңыз да...
Dialogue: 0,0:20:26.78,0:20:30.24,Default,,0,0,0,,Мен қожайынымды жеңе алмаймын.
Dialogue: 0,0:20:30.33,0:20:31.95,Default,,0,0,0,,Әрине
Dialogue: 0,0:20:32.54,0:20:34.67,Default,,0,0,0,,Мен сенен күштімін
Dialogue: 0,0:20:35.17,0:20:36.46,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:20:36.54,0:20:40.09,Default,,0,0,0,,Бірақ сіз әлі жеңілген жоқсыз.
Dialogue: 0,0:20:40.92,0:20:42.76,Default,,0,0,0,,Себебі мен орнымнан тұрдым
Dialogue: 0,0:20:43.26,0:20:45.09,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:20:45.80,0:20:47.47,Default,,0,0,0,,Старк
Dialogue: 0,0:20:47.55,0:20:50.60,Default,,0,0,0,,Мен саған мықты қарсыластарды жеңудің сырын үйретемін
Dialogue: 0,0:20:51.56,0:20:52.93,Default,,0,0,0,,Бұл оңай
Dialogue: 0,0:20:53.02,0:20:56.81,Default,,0,0,0,,Қалағаныңызша тұрып, техникаңызды қолданыңыз.
Dialogue: 0,0:20:56.90,0:20:57.98,Default,,0,0,0,,Жауынгер дегеніміз не?
Dialogue: 0,0:20:58.06,0:21:01.98,Default,,0,0,0,,Ең соңғы тұрған жеңеді.
Dialogue: 0,0:21:05.90,0:21:08.62,Default,,0,0,0,,Әрине, ұстаз...
Dialogue: 0,0:21:09.12,0:21:11.66,Default,,0,0,0,,Біртүрлі теория мені мәжбүр етті
Dialogue: 0,0:21:12.16,0:21:14.83,Default,,0,0,0,,Ми бұлшық еттерден тұрады емес пе?
Dialogue: 0,0:21:15.29,0:21:16.25,Default,,0,0,0,,Я...
Dialogue: 0,0:21:16.83,0:21:19.59,Default,,0,0,0,,Тыныш ұйықтасам ғой.
Dialogue: 0,0:21:19.67,0:21:21.25,Default,,0,0,0,,Мен ұтылып қалдым
Dialogue: 0,0:21:22.25,0:21:23.88,Default,,0,0,0,,Мен әлі тұрамын
Dialogue: 0,0:21:26.22,0:21:28.39,Default,,0,0,0,,Мен есіме түсті
Dialogue: 0,0:21:28.47,0:21:30.97,Default,,0,0,0,,Шебердің техникасы одан да маңызды болды.
Dialogue: 0,0:21:32.60,0:21:35.64,Default,,0,0,0,,Өйткені, сенікі жай ғана менеджер.
Dialogue: 0,0:21:40.31,0:21:44.28,Default,,0,0,0,,Бұл жағдайда мен сізге осы мәселе бойынша нұсқаулық беремін.
Dialogue: 0,0:21:45.32,0:21:46.82,Default,,0,0,0,,Эйрфурцен
Dialogue: 0,0:21:46.90,0:21:48.82,Default,,0,0,0,,Балтелье!
Dialogue: 0,0:22:00.42,0:22:01.59,Default,,0,0,0,,Үлкен тербеліс
Dialogue: 0,0:22:01.67,0:22:04.59,Default,,0,0,0,,Қорғаныс жоқ, мен жеңіліске ұшырадым.
Dialogue: 0,0:22:09.89,0:22:10.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:12.64,0:22:16.27,Default,,0,0,0,,Мен сауда жасауға дайындалдым, бірақ мен қорқып, жоғалдым.
Dialogue: 0,0:22:16.35,0:22:19.23,Default,,0,0,0,,Бұл мүлдем ауыр емес.
Dialogue: 0,0:22:20.81,0:22:22.65,Default,,0,0,0,,Шынтенгеки!
Dialogue: 0,0:22:34.99,0:22:36.10,Default,,0,0,0,,Лини! Тоқта...
Dialogue: 0,0:22:37.08,0:22:38.83,Default,,0,0,0,,Зольтрак
Dialogue: 0,0:22:43.34,0:22:46.34,Default,,0,0,0,,Жындарды өлтіретін сиқыр...
Dialogue: 0,0:22:49.93,0:22:54.93,Default,,0,0,0,,♪~
Dialogue: 0,0:24:14.80,0:24:19.81,Default,,0,0,0,,~♪
Dialogue: 0,0:24:21.31,0:24:26.31,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
