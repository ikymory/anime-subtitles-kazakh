Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.33,0:00:10.00,Default,,0,0,0,,NETFLIX түпнұсқалық аниме сериясы
Dialogue: 0,0:00:26.25,0:00:28.70,Default,,0,0,0,,2-тапсырма Иттің көзіне соғу
Dialogue: 0,0:00:31.00,0:00:31.20,Default,,0,0,0,,Иттермен шайқас ертең.
Dialogue: 0,0:00:31.20,0:00:33.66,Default,,0,0,0,,Иттермен шайқас ертең
Dialogue: 0,0:00:31.20,0:00:33.66,Default,,0,0,0,,Мияу Мияу Мысық Босс шеберлігі Кэтрин Клау
Dialogue: 0,0:00:33.66,0:00:33.79,Default,,0,0,0,,Мияу Мяу Мысық Босс шеберлігі Кэтрин Клау
Dialogue: 0,0:00:33.79,0:00:36.16,Default,,0,0,0,,Мияу Мяу Мысық Босс шеберлігі Кэтрин Клау
Dialogue: 0,0:00:33.79,0:00:36.16,Default,,0,0,0,,Қалай күресу керектігін бәріңіз ойладыңыз ба?
Dialogue: 0,0:00:36.45,0:00:38.91,Default,,0,0,0,,Берген дұрыс емес пе?
Dialogue: 0,0:00:41.87,0:00:43.45,Default,,0,0,0,,Неліктен сыйлық бермеске?
Dialogue: 0,0:00:46.91,0:00:48.37,Default,,0,0,0,,Мен ештеңе айтқан жоқпын
Dialogue: 0,0:00:48.70,0:00:51.33,Default,,0,0,0,,Мына картаны алды
Dialogue: 0,0:00:51.45,0:00:55.87,Default,,0,0,0,,Мен өлтірушімін. Мен оны бастық итті өлтіру үшін жалдасам қалай?
Dialogue: 0,0:00:57.95,0:01:00.04,Default,,0,0,0,,«Жеті өлтіруші»
Dialogue: 0,0:01:22.95,0:01:23.95,Default,,0,0,0,,Кәсіби өлтіруші...
Dialogue: 0,0:01:24.08,0:01:26.79,Default,,0,0,0,,Алшақтап, құйрықты басу
Dialogue: 0,0:01:26.91,0:01:28.12,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:01:29.66,0:01:33.50,Default,,0,0,0,,Неге екенін сұрамаңыз, тек уақыт пен орынды айтыңыз.
Dialogue: 0,0:01:33.62,0:01:36.45,Default,,0,0,0,,Күн шыққанға дейін иттердің штабында
Dialogue: 0,0:01:37.16,0:01:39.79,Default,,0,0,0,,Мақсат - олардың бастығы.
Dialogue: 0,0:01:39.91,0:01:43.45,Default,,0,0,0,,Жарайды, мен итті күн шықпай тұрып өлтіремін.
Dialogue: 0,0:01:43.62,0:01:46.45,Default,,0,0,0,,Оларды өлтірмей-ақ көзіне қағып ал
Dialogue: 0,0:01:46.83,0:01:48.20,Default,,0,0,0,,Түсінді. Сіз айтқандай.
Dialogue: 0,0:01:48.20,0:01:49.12,Default,,0,0,0,,Сіз айтқандай түсіндім.
Dialogue: 0,0:01:48.20,0:01:49.12,Default,,0,0,0,,〝Иттер штабы〞
Dialogue: 0,0:01:49.12,0:01:49.91,Default,,0,0,0,,〝Иттердің штабы〞
Dialogue: 0,0:01:56.79,0:01:58.00,Default,,0,0,0,,«Иттер қалай ойнайды»
Dialogue: 0,0:02:01.08,0:02:03.70,Default,,0,0,0,,Қауіпсіздік қатаң. Не істеуім керек?
Dialogue: 0,0:02:25.87,0:02:29.00,Default,,0,0,0,,Мына балалар түнде не істеп жүр?
Dialogue: 0,0:02:29.50,0:02:32.20,Default,,0,0,0,,Барлық иттер қатыгез көрінеді.
Dialogue: 0,0:02:32.45,0:02:34.70,Default,,0,0,0,,Бірақ мен қорықпаймын, мен...
Dialogue: 0,0:02:40.66,0:02:42.33,Default,,0,0,0,,Оны кім лақтырды?
Dialogue: 0,0:02:52.29,0:02:53.66,Default,,0,0,0,,Бұл жолы кім?
Dialogue: 0,0:02:54.37,0:02:55.91,Default,,0,0,0,,Фризби?
Dialogue: 0,0:03:08.04,0:03:08.83,Default,,0,0,0,,Мен де, әпкем де осы жерде күтеміз.
Dialogue: 0,0:03:25.87,0:03:29.33,Default,,0,0,0,,Бұл қауіпті жер. Бұл қауіпті жер еді.
Dialogue: 0,0:03:29.45,0:03:31.79,Default,,0,0,0,,Мен кәсіпқоймын, сондықтан тайсалмаймын.
Dialogue: 0,0:03:31.91,0:03:34.33,Default,,0,0,0,,Арқаңмен қозғалсаң жақсы
Dialogue: 0,0:03:35.45,0:03:37.70,Default,,0,0,0,,Бұл позиция әдеттен тыс па?
Dialogue: 0,0:03:48.16,0:03:50.75,Default,,0,0,0,,Бұл бастық па?
Dialogue: 0,0:03:55.12,0:03:57.00,Default,,0,0,0,,Атмосфера әртүрлі.
Dialogue: 0,0:03:58.58,0:03:59.83,Default,,0,0,0,,Жоқ, өмірден бас тартпа
Dialogue: 0,0:03:59.95,0:04:02.41,Default,,0,0,0,,Сенің атың кім? Бұл сіз көрмейтін бет
Dialogue: 0,0:04:02.54,0:04:05.04,Default,,0,0,0,,Менің атым – Mad Wanwan
Dialogue: 0,0:04:05.33,0:04:06.08,Default,,0,0,0,,Мұнда бәріміз «Бірміз», басқа атаулар жоқ.
Dialogue: 0,0:04:06.08,0:04:09.45,Default,,0,0,0,,Мұнда бәріміз «Бір»піз, басқа атаулар жоқ.
Dialogue: 0,0:04:06.08,0:04:09.45,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:04:09.83,0:04:14.66,Default,,0,0,0,,Mad Wan Wan - лақап ат. Оның шын есімі Мад Ван.
Dialogue: 0,0:04:15.37,0:04:16.83,Default,,0,0,0,,Ақылсыз ба?
Dialogue: 0,0:04:16.95,0:04:18.33,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:04:33.79,0:04:34.66,Default,,0,0,0,,Өтірік, Жынды менің атым.
Dialogue: 0,0:04:34.66,0:04:37.62,Default,,0,0,0,,Өтірік, Жынды менің атым.
Dialogue: 0,0:04:34.66,0:04:37.62,Default,,0,0,0,,Mad One Dog Boss Skill Rock Dog
Dialogue: 0,0:04:39.70,0:04:44.04,Default,,0,0,0,,Айтпақшы, неліктен адам иісі шығады?
Dialogue: 0,0:04:45.08,0:04:47.70,Default,,0,0,0,,Сіз жалған итсіз бе?
Dialogue: 0,0:04:48.12,0:04:48.45,Default,,0,0,0,,Бастық Бұл нағыз ит пе? Оны сынаудың жолы бар.
Dialogue: 0,0:04:48.45,0:04:52.29,Default,,0,0,0,,Бастық Бұл нағыз ит пе? Оны сынаудың жолы бар.
Dialogue: 0,0:04:48.45,0:04:52.29,Default,,0,0,0,,Дана
Dialogue: 0,0:04:52.87,0:04:55.95,Default,,0,0,0,,Иттің копрофагиялық мінез-құлқын өзгерту мүмкін емес.
Dialogue: 0,0:04:56.37,0:04:58.58,Default,,0,0,0,,Егер бұл ит болса, оны жеп көріңіз.
Dialogue: 0,0:04:59.41,0:05:00.70,Default,,0,0,0,,Бұл жігіт байсалды ма?
Dialogue: 0,0:05:01.41,0:05:02.95,Default,,0,0,0,,Жылы кезде
Dialogue: 0,0:05:04.08,0:05:05.45,Default,,0,0,0,,Алдымен тамақтаныңыз
Dialogue: 0,0:05:10.25,0:05:11.29,Default,,0,0,0,,Ал оған он алты жасында, Римде…
Dialogue: 0,0:05:21.45,0:05:22.79,Default,,0,0,0,,Көзді соғу
Dialogue: 0,0:05:26.29,0:05:29.08,Default,,0,0,0,,Кешіріңіз, мен өлтірушімін.
Dialogue: 0,0:05:31.83,0:05:32.54,Default,,0,0,0,,Әйтеуір, ол жақында ғана қорқынышты сынақтан өтті
Dialogue: 0,0:05:32.79,0:05:35.83,Default,,0,0,0,,Мен сенің көзіңе тықтым ба?
Dialogue: 0,0:05:36.41,0:05:37.95,Default,,0,0,0,,Бұл менің көзім
Dialogue: 0,0:05:38.58,0:05:41.66,Default,,0,0,0,,Маңдайға күннен қорғайтын көзілдірік ілінді
Dialogue: 0,0:05:41.83,0:05:44.70,Default,,0,0,0,,О, құдай-ау, алданып қалдым.
Dialogue: 0,0:05:45.16,0:05:45.87,Default,,0,0,0,,Тосын шабуыл
Dialogue: 0,0:05:48.45,0:05:49.54,Default,,0,0,0,,Кім сұрады?
Dialogue: 0,0:05:50.25,0:05:53.70,Default,,0,0,0,,Мен кәсіби өлтіруші ретінде...
Dialogue: 0,0:05:55.45,0:05:59.83,Default,,0,0,0,,Жарайды, айтамын, бірақ ешкімге айтпа.
Dialogue: 0,0:05:59.95,0:06:00.91,Default,,0,0,0,,Мегуми Фушигуро.
Dialogue: 0,0:06:02.33,0:06:05.45,Default,,0,0,0,,Мен енді қайталамаймын, сондықтан мені жіберіңіз
Dialogue: 0,0:06:05.79,0:06:07.62,Default,,0,0,0,,Мен үйге барғым келеді
Dialogue: 0,0:06:08.66,0:06:11.20,Default,,0,0,0,,Оны кім жібергенін айтпасаңыз...
Dialogue: 0,0:06:11.33,0:06:13.91,Default,,0,0,0,,Йога шабуылы
Dialogue: 0,0:06:14.08,0:06:16.58,Default,,0,0,0,,Мен йогамен де айналысамын
Dialogue: 0,0:06:17.66,0:06:18.29,Default,,0,0,0,,Алайда сол кезде теледидар станциясына асығып барған Учида мырзаның өлтірілуі,
Dialogue: 0,0:06:19.25,0:06:20.33,Default,,0,0,0,,Өте…
Dialogue: 0,0:06:23.29,0:06:24.25,Default,,0,0,0,,Айт
Dialogue: 0,0:06:26.91,0:06:29.62,Default,,0,0,0,,Кәсіби өлтіруші ретінде -
Dialogue: 0,0:06:30.08,0:06:32.45,Default,,0,0,0,,Кез келген жағдайда көзді қатайтыңыз
Dialogue: 0,0:06:32.79,0:06:34.70,Default,,0,0,0,,Сен мені қатты ашуландырдың.
Dialogue: 0,0:06:34.70,0:06:36.33,Default,,0,0,0,,Сен мені қатты ашуландырдың.
Dialogue: 0,0:06:34.70,0:06:36.33,Default,,0,0,0,,«Құлыптау»
Dialogue: 0,0:07:26.12,0:07:27.87,Default,,0,0,0,,39 ату
Dialogue: 0,0:08:02.12,0:08:03.37,Default,,0,0,0,,Ах, жарай берсін—
Dialogue: 0,0:08:18.79,0:08:20.79,Default,,0,0,0,,Неліктен бұл фотосурет?
Dialogue: 0,0:08:20.91,0:08:23.62,Default,,0,0,0,,Бұл... менің итім.
Dialogue: 0,0:08:23.75,0:08:26.20,Default,,0,0,0,,Нья сені осында әкелді ме?
Dialogue: 0,0:08:27.66,0:08:30.87,Default,,0,0,0,,Ол кезде мен қаңғыбас ит едім, ән жейтінмін.
Dialogue: 0,0:08:31.00,0:08:32.91,Default,,0,0,0,,Өткенге қызықпайды
Dialogue: 0,0:08:33.83,0:08:38.45,Default,,0,0,0,,Менің сүйкімді қызым күнде менің әндерімді тыңдауға келеді.
Dialogue: 0,0:08:39.50,0:08:42.29,Default,,0,0,0,,Ал біз ғашық болдық
Dialogue: 0,0:08:42.41,0:08:47.12,Default,,0,0,0,,Мені алдасаң, көзіңді қатайтамын.
Dialogue: 0,0:08:51.08,0:08:54.58,Default,,0,0,0,,Сонда мені алдадым деп жіберді ме?
Dialogue: 0,0:08:54.70,0:08:56.04,Default,,0,0,0,,Сіз алдайсыз ба?
Dialogue: 0,0:09:00.37,0:09:02.29,Default,,0,0,0,,Мен оны тастап кеттім, себебі...
Dialogue: 0,0:09:04.20,0:09:06.66,Default,,0,0,0,,Мысықтар мен иттер әртүрлі түрлер.
Dialogue: 0,0:09:06.79,0:09:11.29,Default,,0,0,0,,Олардың араласа алмайтыны белгілі болды.
Dialogue: 0,0:09:11.41,0:09:13.45,Default,,0,0,0,,Қандай сүйкімді
Dialogue: 0,0:09:13.95,0:09:17.00,Default,,0,0,0,,Сізге қанша котят керек?
Dialogue: 0,0:09:17.12,0:09:18.08,Default,,0,0,0,,№
Dialogue: 0,0:09:18.29,0:09:20.33,Default,,0,0,0,,Әйел күйеуіне бағынуы керек
Dialogue: 0,0:09:20.50,0:09:22.79,Default,,0,0,0,,Сіз қанша күшік алғыңыз келеді?
Dialogue: 0,0:09:24.83,0:09:27.62,Default,,0,0,0,,Мен оған кетіп қалдым.
Dialogue: 0,0:09:27.95,0:09:30.25,Default,,0,0,0,,Асыра бермеңіз
Dialogue: 0,0:09:32.20,0:09:37.08,Default,,0,0,0,,Егер сіз оған көңіл күйіңізді айтпасаңыз, ол әлі де түсінбей қалады.
Dialogue: 0,0:09:44.04,0:09:48.16,Default,,0,0,0,,Сіз трагедия кейіпкері болып көрінесіз бе? Бакайаро
Dialogue: 0,0:09:50.87,0:09:53.12,Default,,0,0,0,,Ол қашып кетті.
Dialogue: 0,0:10:13.75,0:10:15.41,Default,,0,0,0,,Сол кезде И
Dialogue: 0,0:10:16.95,0:10:20.83,Default,,0,0,0,,Мен мысыққа ғашық болдым
Dialogue: 0,0:10:21.45,0:10:22.79,Default,,0,0,0,,...
Dialogue: 0,0:10:24.62,0:10:28.58,Default,,0,0,0,,Оның күлкісі бәрінен де сүйкімді еді.
Dialogue: 0,0:10:29.37,0:10:30.87,Default,,0,0,0,,Мен оны жақсы көремін
Dialogue: 0,0:10:32.41,0:10:36.41,Default,,0,0,0,,Мен мәңгілік сүюді армандадым
Dialogue: 0,0:10:36.95,0:10:42.79,Default,,0,0,0,,Бірақ мен оның арманын орындай алмаймын
Dialogue: 0,0:10:46.04,0:10:50.16,Default,,0,0,0,,Сондықтан мен оны тастап кетуді шештім.
Dialogue: 0,0:10:53.62,0:10:57.95,Default,,0,0,0,,Түсініспеушілік пен өкініштің азабы басым болды.
Dialogue: 0,0:11:01.50,0:11:03.83,Default,,0,0,0,,Мен оны қатты сағындым
Dialogue: 0,0:11:09.25,0:11:14.00,Default,,0,0,0,,Бірақ ол мені шын жүректен жек көреді.
Dialogue: 0,0:11:16.87,0:11:22.87,Default,,0,0,0,,Мен сені тастағым келмеді, жаным.
Dialogue: 0,0:11:23.75,0:11:30.54,Default,,0,0,0,,Мұңайғаным сонша, жүрегім жарылып кетердей болды.
Dialogue: 0,0:11:32.37,0:11:38.45,Default,,0,0,0,,Қымбаттым, мені кешірші.
Dialogue: 0,0:11:39.20,0:11:46.16,Default,,0,0,0,,Мен қандай ақымақ адаммын
Dialogue: 0,0:11:49.20,0:11:52.12,Default,,0,0,0,,Мен сені тастап кеттім
Dialogue: 0,0:11:52.25,0:11:55.79,Default,,0,0,0,,Өйткені ит пен мысық бір-бірімен араласа алмайды.
Dialogue: 0,0:11:56.25,0:11:59.20,Default,,0,0,0,,Мен сенен басқа ешкімді сүйген емеспін
Dialogue: 0,0:12:00.91,0:12:02.87,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:12:03.16,0:12:06.20,Default,,0,0,0,,Менің жалғыз сүйгенім сенсің
Dialogue: 0,0:12:07.37,0:12:08.58,Default,,0,0,0,,сенбеймін
Dialogue: 0,0:12:11.20,0:12:12.54,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:12:13.70,0:12:15.04,Default,,0,0,0,,Өтірікші
Dialogue: 0,0:12:21.41,0:12:23.25,Default,,0,0,0,,Мен сені жақсы көремін.
Dialogue: 0,0:12:24.62,0:12:28.75,Default,,0,0,0,,Мен саған бәрін бергім келді
Dialogue: 0,0:12:29.20,0:12:30.95,Default,,0,0,0,,Уф! Аах!
Dialogue: 0,0:12:32.41,0:12:36.41,Default,,0,0,0,,Біз басқа әлемде өмір сүреміз
Dialogue: 0,0:12:37.00,0:12:38.83,Default,,0,0,0,,Сіз
Dialogue: 0,0:12:40.25,0:12:44.25,Default,,0,0,0,,бала сүйгісі келді
Dialogue: 0,0:12:44.70,0:12:50.50,Default,,0,0,0,,Бірақ мен ол арманымды орындай алмаймын
Dialogue: 0,0:12:53.75,0:12:58.37,Default,,0,0,0,,Сондықтан мен сені тастап кетуді шештім.
Dialogue: 0,0:13:01.66,0:13:05.50,Default,,0,0,0,,Сізге зиян тигізбеу үшін
Dialogue: 0,0:13:09.25,0:13:11.54,Default,,0,0,0,,Бірақ менің жүрегімде
Dialogue: 0,0:13:15.66,0:13:20.62,Default,,0,0,0,,Саған деген махаббатым одан сайын артады
Dialogue: 0,0:13:24.70,0:13:31.00,Default,,0,0,0,,Мен енді сүйіктімді тастамаймын.
Dialogue: 0,0:13:31.45,0:13:38.16,Default,,0,0,0,,Мен сені енді ешқашан ренжітпеймін
Dialogue: 0,0:13:40.16,0:13:46.12,Default,,0,0,0,,Жаным, жанымда болғаныңды қалаймын.
Dialogue: 0,0:13:47.08,0:13:53.87,Default,,0,0,0,,Мені әлі де жақсы көретініңді айт
Dialogue: 0,0:13:55.58,0:14:01.95,Default,,0,0,0,,Мен сені тастағым келмеді, жаным.
Dialogue: 0,0:14:02.41,0:14:07.41,Default,,0,0,0,,Мұңайғаным сонша, жүрегім жарылып кетердей болды.
Dialogue: 0,0:14:11.12,0:14:17.70,Default,,0,0,0,,Қымбаттым, мені кешірші.
Dialogue: 0,0:14:17.83,0:14:23.54,Default,,0,0,0,,Мен қандай ақымақ адаммын
Dialogue: 0,0:14:25.04,0:14:31.04,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory