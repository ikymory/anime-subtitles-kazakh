Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.33,0:00:09.95,Default,,0,0,0,,NETFLIX түпнұсқалық аниме сериясы
Dialogue: 0,0:00:26.20,0:00:28.62,Default,,0,0,0,,5 тапсырма Тәкаппар кемпірді өлтіру
Dialogue: 0,0:00:28.83,0:00:31.79,Default,,0,0,0,,Жаңа піскен апельсиндер ше?
Dialogue: 0,0:00:31.91,0:00:33.29,Default,,0,0,0,,Тоқтаңыз.
Dialogue: 0,0:00:33.41,0:00:36.08,Default,,0,0,0,,Алғашқы махаббаттың дәмінен де тәтті
Dialogue: 0,0:00:36.20,0:00:38.37,Default,,0,0,0,,Егер сіз оны қазір сатып алмасаңыз, бұл шығын.
Dialogue: 0,0:00:39.91,0:00:41.83,Default,,0,0,0,,Ал сіз ше, аға?
Dialogue: 0,0:00:41.95,0:00:43.54,Default,,0,0,0,,Бұл өте тәтті
Dialogue: 0,0:00:44.16,0:00:45.33,Default,,0,0,0,,Қанша?
Dialogue: 0,0:00:45.50,0:00:48.58,Default,,0,0,0,,Байқап көріңіз, ол қаншалықты тәтті екенін дәлелдейді.
Dialogue: 0,0:00:49.58,0:00:51.25,Default,,0,0,0,,Бұл тәтті емес. Қанша?
Dialogue: 0,0:00:51.87,0:00:55.29,Default,,0,0,0,,«Жарты километр»
Dialogue: 0,0:00:56.45,0:00:57.50,Default,,0,0,0,,Жарты кило 200 юань
Dialogue: 0,0:00:58.70,0:00:59.91,Default,,0,0,0,,Қымбат, маған керегі жоқ
Dialogue: 0,0:01:02.91,0:01:05.45,Default,,0,0,0,,Мен тура жарты келі жедім.
Dialogue: 0,0:01:05.58,0:01:07.70,Default,,0,0,0,,Мен 200 юань аламын.
Dialogue: 0,0:01:11.16,0:01:13.12,Default,,0,0,0,,Бұл алаяқтық емес пе?
Dialogue: 0,0:01:21.33,0:01:25.70,Default,,0,0,0,,Көмектесіңіз! қарттарға зорлық-зомбылық жасаған
Dialogue: 0,0:01:25.83,0:01:27.54,Default,,0,0,0,,Менің аяғым сынды!
Dialogue: 0,0:01:27.66,0:01:29.33,Default,,0,0,0,,Қандай қорқынышты адам
Dialogue: 0,0:01:29.45,0:01:33.08,Default,,0,0,0,,Менің аяғым мен қол сүйектерім сынған.
Dialogue: 0,0:01:33.25,0:01:35.33,Default,,0,0,0,,Түсіндім, мен бәрін сатып аламын.
Dialogue: 0,0:01:36.95,0:01:38.87,Default,,0,0,0,,Твит жазбайтын күнім.
Dialogue: 0,0:01:39.00,0:01:40.70,Default,,0,0,0,,Кемпір императрица Чен Ерекше шеберлігі: `` Қарттардың озбырлығы''
Dialogue: 0,0:01:40.70,0:01:42.83,Default,,0,0,0,,Кемпір императрица Чен ерекше шеберлігі ''Қарттар тираниясы''
Dialogue: 0,0:01:40.70,0:01:42.83,Default,,0,0,0,,Қосымша 200 алды
Dialogue: 0,0:01:43.04,0:01:45.04,Default,,0,0,0,,Сувенирлерді Сяолоннан сатып алуға болады.
Dialogue: 0,0:01:45.16,0:01:47.20,Default,,0,0,0,,Мен үшін тауық еті
Dialogue: 0,0:01:48.29,0:01:51.04,Default,,0,0,0,,Сол баланың қуанышты жүзін көріп тұрмын
Dialogue: 0,0:01:55.41,0:01:59.00,Default,,0,0,0,,«Жеті»
Dialogue: 0,0:01:59.00,0:02:00.25,Default,,0,0,0,,«Жеті»
Dialogue: 0,0:01:59.00,0:02:00.25,Default,,0,0,0,,Күнәкар кемпір
Dialogue: 0,0:02:10.54,0:02:12.33,Default,,0,0,0,,Байқамаңыз
Dialogue: 0,0:02:13.08,0:02:15.20,Default,,0,0,0,,Сабыр ет, сабырлы бол.
Dialogue: 0,0:02:15.33,0:02:16.62,Default,,0,0,0,,Жарайды
Dialogue: 0,0:02:42.54,0:02:43.12,Default,,0,0,0,,Уф… Бұған қуануым керек пе?
Dialogue: 0,0:02:51.12,0:02:52.83,Default,,0,0,0,,Бұл бос жәшік емес пе?
Dialogue: 0,0:02:53.37,0:02:54.91,Default,,0,0,0,,Мен жеміс күттім.
Dialogue: 0,0:03:00.16,0:03:02.70,Default,,0,0,0,,Әже, сіз не істеп жатырсыз?
Dialogue: 0,0:03:03.12,0:03:04.79,Default,,0,0,0,,Менің бөксем қатты ауырады.
Dialogue: 0,0:03:04.91,0:03:06.25,Default,,0,0,0,,Келесі жолы мен сізге қайта ораламын...
Dialogue: 0,0:03:06.54,0:03:07.70,Default,,0,0,0,,Уф… Бұған қуануым керек пе?
Dialogue: 0,0:03:07.83,0:03:09.66,Default,,0,0,0,,Өте…
Dialogue: 0,0:03:09.79,0:03:11.25,Default,,0,0,0,,Менің белім жарақаттанды
Dialogue: 0,0:03:32.54,0:03:34.87,Default,,0,0,0,,Неліктен ауыр?
Dialogue: 0,0:03:35.29,0:03:37.33,Default,,0,0,0,,Кем дегенде 5 юаньға сатыңыз
Dialogue: 0,0:03:38.79,0:03:40.41,Default,,0,0,0,,Дәл уақыт
Dialogue: 0,0:03:40.54,0:03:42.66,Default,,0,0,0,,Немеремді алуға мектепке бардым.
Dialogue: 0,0:03:42.79,0:03:48.75,Default,,0,0,0,,«Бастауыш мектеп»
Dialogue: 0,0:03:52.75,0:03:54.29,Default,,0,0,0,,Чен әже, ерте.
Dialogue: 0,0:03:55.20,0:03:57.12,Default,,0,0,0,,Сіз құқық бұзушысыз ба?
Dialogue: 0,0:03:57.25,0:03:59.08,Default,,0,0,0,,Сіздің балаңыз бүгін тағы да қорылдап жатыр ма?
Dialogue: 0,0:04:02.50,0:04:04.54,Default,,0,0,0,,Немеремді жақсылап бақсаңызшы.
Dialogue: 0,0:04:04.66,0:04:06.00,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:04:25.66,0:04:29.50,Default,,0,0,0,,Біз оларға әдептілікке үйретуіміз керек.
Dialogue: 0,0:04:38.54,0:04:40.29,Default,,0,0,0,,Оны сенімді түрде өлтіріңіз
Dialogue: 0,0:04:45.16,0:04:46.16,Default,,0,0,0,,Шағып алды ма?
Dialogue: 0,0:04:49.75,0:04:53.87,Default,,0,0,0,,Мені жібермесең, мен сені қазанға лақтырамын.
Dialogue: 0,0:05:04.33,0:05:07.79,Default,,0,0,0,,Менің мүшемді тістеу...
Dialogue: 0,0:05:22.50,0:05:25.70,Default,,0,0,0,,Тіс профилі анық қалады
Dialogue: 0,0:05:26.29,0:05:27.29,Default,,0,0,0,,Сізде таңғыш бар ма?
Dialogue: 0,0:05:37.45,0:05:39.41,Default,,0,0,0,,Маған екі бөлікті беріңіз
Dialogue: 0,0:05:39.87,0:05:42.33,Default,,0,0,0,,Сөмкең жыртылып қалды емес пе?
Dialogue: 0,0:05:42.45,0:05:45.87,Default,,0,0,0,,Түзетулер енгізу. Тағы бір рет пышақталғанын қалайсыз ба?
Dialogue: 0,0:05:46.00,0:05:47.04,Default,,0,0,0,,Мен бұзылдым.
Dialogue: 0,0:06:03.83,0:06:05.62,Default,,0,0,0,,Мен осында қалсам, өмір жоқ.
Dialogue: 0,0:06:07.45,0:06:08.91,Default,,0,0,0,,Эй, менің ақшам ше?
Dialogue: 0,0:06:09.29,0:06:11.62,Default,,0,0,0,,Кемпірге төмен қарадым.
Dialogue: 0,0:06:11.75,0:06:14.45,Default,,0,0,0,,Қазіргі заманда қарттар қатыгез.
Dialogue: 0,0:06:14.87,0:06:16.41,Default,,0,0,0,,Маған ақшаны беріңіз. Өлгің келе ме?
Dialogue: 0,0:06:20.58,0:06:21.75,Default,,0,0,0,,Егер солай істесем…
Dialogue: 0,0:06:21.87,0:06:23.33,Default,,0,0,0,,Қайшы, кел!
Dialogue: 0,0:06:40.25,0:06:45.16,Default,,0,0,0,,Мен бұндай жұмысты енді ешқашан жасамаймын, тіпті маған тапсырма берсе де.
Dialogue: 0,0:06:46.75,0:06:49.75,Default,,0,0,0,,Маған ақшаны төле, мен сенің есегіңе пышақ саламын.
Dialogue: 0,0:06:53.50,0:06:55.00,Default,,0,0,0,,Сяолун келе жатыр
Dialogue: 0,0:07:05.66,0:07:07.58,Default,,0,0,0,,Қоңырау арқылы сақталды
Dialogue: 0,0:07:09.50,0:07:11.20,Default,,0,0,0,,Сяолун
Dialogue: 0,0:07:12.12,0:07:14.66,Default,,0,0,0,,Мұны кім жасады?
Dialogue: 0,0:07:15.54,0:07:17.95,Default,,0,0,0,,Бұл шаш үлгісін жасаған кім?
Dialogue: 0,0:07:20.45,0:07:21.54,Default,,0,0,0,,Сол жігіт
Dialogue: 0,0:07:22.66,0:07:24.08,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:07:35.29,0:07:37.41,Default,,0,0,0,,Дауыс өзгертуші екен ғой
Dialogue: 0,0:07:42.54,0:07:43.50,Default,,0,0,0,,Неліктен бұл болып жатыр?
Dialogue: 0,0:07:44.75,0:07:47.75,Default,,0,0,0,,Бұл бала әжесінің немересі еді.
Dialogue: 0,0:07:54.29,0:07:58.12,Default,,0,0,0,,Ал ол кісі баланың әкесі.
Dialogue: 0,0:07:58.87,0:08:01.66,Default,,0,0,0,,Басқаша айтқанда, кемпірді өлтіргім келеді...
Dialogue: 0,0:08:02.20,0:08:04.00,Default,,0,0,0,,Ол менің туған ұлым еді.
Dialogue: 0,0:08:04.70,0:08:06.58,Default,,0,0,0,,Мені тез өлтір.
Dialogue: 0,0:08:07.20,0:08:08.95,Default,,0,0,0,,Осы ойынды қазір тоқтатайық
Dialogue: 0,0:08:19.66,0:08:21.20,Default,,0,0,0,,Императрица кемпір
Dialogue: 0,0:08:21.45,0:08:25.37,Default,,0,0,0,,Немеремді қорлауды ешқашан кешірмеймін.
Dialogue: 0,0:08:37.45,0:08:39.70,Default,,0,0,0,,Қандай сұмдық.
Dialogue: 0,0:08:40.91,0:08:41.95,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:42.08,0:08:44.04,Default,,0,0,0,,Балалар оны көрмеуі керек.
Dialogue: 0,0:08:45.25,0:08:46.83,Default,,0,0,0,,Қорқынышты кемпір.
Dialogue: 0,0:08:47.16,0:08:50.66,Default,,0,0,0,,Қарама. Басқа біреу болып көріну.
Dialogue: 0,0:08:47.16,0:08:50.66,Default,,0,0,0,,«Еңбекқорлық»
Dialogue: 0,0:09:01.62,0:09:04.04,Default,,0,0,0,,Барлығына көрсетейік
Dialogue: 0,0:09:07.37,0:09:10.37,Default,,0,0,0,,Бұл менің сүйкімді немеремді ренжіткенім үшін кек.
Dialogue: 0,0:09:20.66,0:09:24.41,Default,,0,0,0,,Жеті, сен өлтірушінің айласын білмейсің.
Dialogue: 0,0:09:25.70,0:09:29.62,Default,,0,0,0,,Нағыз өлтіруші біледі
Dialogue: 0,0:09:30.54,0:09:32.45,Default,,0,0,0,,Адамның ең үлкен әлсіздігі –
Dialogue: 0,0:09:33.45,0:09:34.75,Default,,0,0,0,,Махаббат!
Dialogue: 0,0:09:58.12,0:10:00.16,Default,,0,0,0,,Мен кінәлі болдым
Dialogue: 0,0:10:00.29,0:10:02.62,Default,,0,0,0,,Мен тозаққа барамын
Dialogue: 0,0:10:03.54,0:10:06.04,Default,,0,0,0,,Отбасыңмен араласпа
Dialogue: 0,0:10:42.04,0:10:43.91,Default,,0,0,0,,«Кездейсоқ өлімді сақтандыру»
Dialogue: 0,0:10:49.20,0:10:50.25,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:10:50.37,0:10:52.08,Default,,0,0,0,,Бүгін күн ыстық.
Dialogue: 0,0:10:52.50,0:10:55.62,Default,,0,0,0,,Менің сөмкемді ақымақ адам сындырды.
Dialogue: 0,0:10:56.08,0:10:59.58,Default,,0,0,0,,Әлгі қыздың шашын қиған ол.
Dialogue: 0,0:11:00.83,0:11:02.83,Default,,0,0,0,,Келесі жолы кездессек, мен аямаймын.
Dialogue: 0,0:11:08.25,0:11:10.95,Default,,0,0,0,,Көшеде ұйықтағың келмесе...
Dialogue: 0,0:11:11.12,0:11:12.33,Default,,0,0,0,,Ақша табу
Dialogue: 0,0:11:18.41,0:11:20.25,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:13:26.79,0:13:29.79,Default,,0,0,0,,Жапон субтитрлері Ри Инагаки
Dialogue: 0,0:13:31.29,0:13:37.29,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory