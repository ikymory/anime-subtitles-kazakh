Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.33,0:00:09.95,Default,,0,0,0,,NETFLIX түпнұсқалық аниме сериясы
Dialogue: 0,0:00:26.16,0:00:28.95,Default,,0,0,0,,6 тапсырма Сұлу қызды өлтіру
Dialogue: 0,0:00:36.58,0:00:38.25,Default,,0,0,0,,Толық кауль!
Dialogue: 0,0:00:40.58,0:00:43.08,Default,,0,0,0,,Қандай қатыгез тағдыр
Dialogue: 0,0:00:43.87,0:00:46.54,Default,,0,0,0,,Себебі мен әдемі әйел болып туылғанмын.
Dialogue: 0,0:00:46.95,0:00:52.12,Default,,0,0,0,,Тағдыр тартқан мен сияқты сұлу әйелдер.
Dialogue: 0,0:00:55.04,0:00:56.58,Default,,0,0,0,,Бұл менің кінәм.
Dialogue: 0,0:00:56.95,0:00:58.87,Default,,0,0,0,,Мен өлуім керек пе?
Dialogue: 0,0:00:59.00,0:01:00.83,Default,,0,0,0,,Сен үшін ертең жоқ
Dialogue: 0,0:01:00.95,0:01:02.62,Default,,0,0,0,,Бүгін соңғы күн ме?
Dialogue: 0,0:01:02.75,0:01:03.79,Default,,0,0,0,,Мисс Бекки қамалда тұрады
Dialogue: 0,0:01:04.33,0:01:08.66,Default,,0,0,0,,Мен бір нәрсе істегім келеді. Егер сіз ынтымақтастық жасасаңыз, мені өлтіре аласыз.
Dialogue: 0,0:01:09.08,0:01:11.95,Default,,0,0,0,,Бұл өтірік емес, солай ма?
Dialogue: 0,0:01:12.08,0:01:14.91,Default,,0,0,0,,Ақылды, мен сені алдаймын деп ойлайсың ба?
Dialogue: 0,0:01:16.79,0:01:18.20,Default,,0,0,0,,"Дегенмен ол жүгірді."
Dialogue: 0,0:01:18.91,0:01:20.20,Default,,0,0,0,,Енді ештеңені жоғалтпау үшін
Dialogue: 0,0:01:20.66,0:01:23.16,Default,,0,0,0,,Жасағым келетін істердің тізімі
Dialogue: 0,0:01:23.83,0:01:26.62,Default,,0,0,0,,Егер ол орындалса, өкінбейсіз
Dialogue: 0,0:01:27.50,0:01:30.16,Default,,0,0,0,,Бұл тез орындалады.
Dialogue: 0,0:01:30.45,0:01:31.91,Default,,0,0,0,,О… Бәрі бітті. Мен енді біттім.
Dialogue: 0,0:01:33.00,0:01:35.75,Default,,0,0,0,,Не... Не? Менің денем қозғалмайды.
Dialogue: 0,0:01:35.75,0:01:37.00,Default,,0,0,0,,Не... Не, менің денем қозғалмайды?
Dialogue: 0,0:01:35.75,0:01:37.00,Default,,0,0,0,,Әдемі қыз кола
Dialogue: 0,0:01:37.16,0:01:38.33,Default,,0,0,0,,Қабілеті: Денеге тиіп, қарсы жынысты сал.
Dialogue: 0,0:01:38.33,0:01:40.25,Default,,0,0,0,,Қабілеті Денеге тиіп, қарсы жынысты шал етеді Ей, кет.
Dialogue: 0,0:01:40.37,0:01:41.29,Default,,0,0,0,,Егер уәде берсеңіз...
Dialogue: 0,0:01:41.66,0:01:44.37,Default,,0,0,0,,Сен кеткеннен кейін айт
Dialogue: 0,0:02:12.16,0:02:13.12,Default,,0,0,0,,Тәңір
Dialogue: 0,0:02:13.25,0:02:16.75,Default,,0,0,0,,«1-ші орындағым келеді: кокс ішу»
Dialogue: 0,0:02:21.70,0:02:24.54,Default,,0,0,0,,«2 тұрып»
Dialogue: 0,0:02:31.12,0:02:32.87,Default,,0,0,0,,Оған қарамаңыз
Dialogue: 0,0:02:37.66,0:02:40.16,Default,,0,0,0,,Қараңызшы, мына жігіт бұзық екен.
Dialogue: 0,0:02:40.29,0:02:41.16,Default,,0,0,0,,Біртүрлі жігіт
Dialogue: 0,0:02:46.33,0:02:50.75,Default,,0,0,0,,Неге сен емес мен жалаңашпын?
Dialogue: 0,0:02:50.87,0:02:54.87,Default,,0,0,0,,«3 Қоғамдық орында жалаңаш жүгіру (адамдарға қарап)»
Dialogue: 0,0:03:07.33,0:03:08.45,Default,,0,0,0,,Қаш!
Dialogue: 0,0:03:16.66,0:03:17.70,Default,,0,0,0,,Сіз батылсыз.
Dialogue: 0,0:03:19.04,0:03:21.04,Default,,0,0,0,,Қозғала алмаймын…
Dialogue: 0,0:03:21.45,0:03:24.37,Default,,0,0,0,,«4 Медбикеге инъекция жасаңыз»
Dialogue: 0,0:03:25.25,0:03:26.95,Default,,0,0,0,,Толық брондалған
Dialogue: 0,0:03:25.25,0:03:26.95,Default,,0,0,0,,«Мейрамхана»
Dialogue: 0,0:03:42.33,0:03:44.16,Default,,0,0,0,,даяшының есебі
Dialogue: 0,0:03:46.00,0:03:49.20,Default,,0,0,0,,Бұл 5000 юань ме? сен байсың
Dialogue: 0,0:03:56.08,0:04:00.54,Default,,0,0,0,,Ақшам жоқ деп айтпа.
Dialogue: 0,0:04:06.37,0:04:09.20,Default,,0,0,0,,«5 3 жұлдызды мейрамханада тамақтаныңыз»
Dialogue: 0,0:04:09.54,0:04:12.37,Default,,0,0,0,,Келесі жолы мен сенің аузыңды желбіретемін
Dialogue: 0,0:04:39.87,0:04:41.33,Default,,0,0,0,,Тория!
Dialogue: 0,0:04:52.83,0:04:56.50,Default,,0,0,0,,«6 Сіздің бұрынғы жігітіңіздің доптарын ұрыңыз»
Dialogue: 0,0:05:01.12,0:05:04.25,Default,,0,0,0,,Қараңдаршы, мен шаршадым.
Dialogue: 0,0:05:04.45,0:05:07.25,Default,,0,0,0,,Оны жайына қалдырайық
Dialogue: 0,0:05:08.66,0:05:09.54,Default,,0,0,0,,Тағы да?
Dialogue: 0,0:05:19.95,0:05:20.95,Default,,0,0,0,,Керемет!
Dialogue: 0,0:05:28.33,0:05:29.12,Default,,0,0,0,,Қозғалыңыздар
Dialogue: 0,0:05:49.79,0:05:53.20,Default,,0,0,0,,«7 арыстанға міну»
Dialogue: 0,0:05:57.33,0:06:00.70,Default,,0,0,0,,Ұшақ, парашют жоқ
Dialogue: 0,0:06:00.83,0:06:02.95,Default,,0,0,0,,Дайвингтен бас тарту
Dialogue: 0,0:06:03.70,0:06:05.54,Default,,0,0,0,,Онда өлтірудің қажеті жоқ.
Dialogue: 0,0:06:07.20,0:06:10.45,Default,,0,0,0,,Мен оны сағынып қаламын деп ойлайсың ба?
Dialogue: 0,0:06:11.16,0:06:12.58,Default,,0,0,0,,Ханшайым, егер кездейсоқ
Dialogue: 0,0:06:14.33,0:06:17.95,Default,,0,0,0,,Ынтымақтастық жасамасаңыз, енді ешқашан қозғала алмайсыз.
Dialogue: 0,0:06:18.45,0:06:19.41,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:06:19.54,0:06:22.62,Default,,0,0,0,,Менің бір ойым бар. Менен қолдарыңды ал.
Dialogue: 0,0:06:25.16,0:06:26.25,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:06:27.00,0:06:29.00,Default,,0,0,0,,Маған біртүрлі қарама
Dialogue: 0,0:06:30.12,0:06:34.45,Default,,0,0,0,,Жылдам ұшатын тауық
Dialogue: 0,0:06:34.79,0:06:37.58,Default,,0,0,0,,Қыздың көзінше, оның жамбасынан ұстама.
Dialogue: 0,0:06:44.91,0:06:47.04,Default,,0,0,0,,Жоғары
Dialogue: 0,0:06:48.87,0:06:50.58,Default,,0,0,0,,Қосымша
Dialogue: 0,0:06:52.58,0:06:54.37,Default,,0,0,0,,Қосымша
Dialogue: 0,0:06:55.16,0:06:56.41,Default,,0,0,0,,Жоғары
Dialogue: 0,0:06:56.54,0:06:59.58,Default,,0,0,0,,Мен одан жоғары көтеріле алмаймын.
Dialogue: 0,0:06:59.70,0:07:02.75,Default,,0,0,0,,Мен Жерге қайтамын!
Dialogue: 0,0:07:29.29,0:07:31.91,Default,,0,0,0,,Ұшақ!
Dialogue: 0,0:07:43.75,0:07:45.33,Default,,0,0,0,,Аспанда ұшу!
Dialogue: 0,0:08:15.66,0:08:18.66,Default,,0,0,0,,«8 парашютпен секіру»
Dialogue: 0,0:08:19.08,0:08:21.20,Default,,0,0,0,,Неге жалтармайсың?
Dialogue: 0,0:08:21.66,0:08:23.37,Default,,0,0,0,,Сенің салмағың ауыр болғандықтан.
Dialogue: 0,0:08:32.66,0:08:36.83,Default,,0,0,0,,Соңғы істі аяқтап, тезірек құтылайық.
Dialogue: 0,0:08:37.50,0:08:39.16,Default,,0,0,0,,Қарғыс атқан ұрық метаморфозға ұшыраған жағдайда—
Dialogue: 0,0:08:40.12,0:08:42.33,Default,,0,0,0,,Енді не айтуым керек?
Dialogue: 0,0:08:43.54,0:08:45.66,Default,,0,0,0,,Ол әлі жас және әдемі.
Dialogue: 0,0:08:46.08,0:08:47.87,Default,,0,0,0,,Мен өмірден ләззат алғым келеді
Dialogue: 0,0:08:53.66,0:08:56.66,Default,,0,0,0,,Менің өлгім келмейді.
Dialogue: 0,0:08:59.41,0:09:02.66,Default,,0,0,0,,Бірақ мен көп өмір сүрмеймін
Dialogue: 0,0:09:08.45,0:09:09.54,Default,,0,0,0,,Бұл қатерлі ісік.
Dialogue: 0,0:09:10.66,0:09:13.41,Default,,0,0,0,,Емнің жанама әсері ретінде шаштың түсуі
Dialogue: 0,0:09:14.45,0:09:17.45,Default,,0,0,0,,Басы қырылған болса да, әдемі.
Dialogue: 0,0:09:19.29,0:09:20.70,Default,,0,0,0,,Оны кім сұрады?
Dialogue: 0,0:09:21.12,0:09:23.95,Default,,0,0,0,,Мен кәсіби өлтірушімін.
Dialogue: 0,0:09:24.12,0:09:26.16,Default,,0,0,0,,Аты-жөнін ашу мүмкін емес
Dialogue: 0,0:09:26.29,0:09:29.79,Default,,0,0,0,,Мен сұрау үшін төледім.
Dialogue: 0,0:09:30.95,0:09:36.00,Default,,0,0,0,,Ауруханада өлгеннен гөрі, қастандық жасау жақсырақ.
Dialogue: 0,0:09:37.04,0:09:40.33,Default,,0,0,0,,Мен нысанаға алатындай атақты емеспін.
Dialogue: 0,0:09:43.25,0:09:44.20,Default,,0,0,0,,Достар...?
Dialogue: 0,0:09:44.79,0:09:47.37,Default,,0,0,0,,Бұл менің соңғы тілегім
Dialogue: 0,0:10:29.50,0:10:30.91,Default,,0,0,0,,«Ештеңені қалдырмай тамақтаныңыз»
Dialogue: 0,0:10:46.04,0:10:48.50,Default,,0,0,0,,Ей, мен оны өлтіре алмадым.
Dialogue: 0,0:10:48.62,0:10:49.41,Default,,0,0,0,,Бұл тек болжам ғана, айтпақшы.
Dialogue: 0,0:10:49.54,0:10:51.83,Default,,0,0,0,,Бірақ мен жалақы аламын.
Dialogue: 0,0:10:51.95,0:10:54.70,Default,,0,0,0,,Жақсы дәрігерге көріну
Dialogue: 0,0:10:55.12,0:10:57.70,Default,,0,0,0,,Оны емдей алады.
Dialogue: 0,0:10:59.20,0:11:05.20,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory