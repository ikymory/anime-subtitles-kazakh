Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.33,0:00:09.95,Default,,0,0,0,,NETFLIX түпнұсқалық аниме сериясы
Dialogue: 0,0:00:26.25,0:00:28.41,Default,,0,0,0,,Миссия 4 Іш киім жинаушыны өлтіріңіз
Dialogue: 0,0:00:28.95,0:00:30.75,Default,,0,0,0,,«Дайбо сұлулық салоны»
Dialogue: 0,0:00:30.87,0:00:32.33,Default,,0,0,0,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:00:32.45,0:00:35.00,Default,,0,0,0,,Аймақтық тазалау комитетінің төрағасы Чан
Dialogue: 0,0:00:37.29,0:00:40.20,Default,,0,0,0,,Мақсаттының екінші ұлы
Dialogue: 0,0:00:54.91,0:00:57.20,Default,,0,0,0,,Керемет аяқталу
Dialogue: 0,0:00:59.00,0:01:01.62,Default,,0,0,0,,Бұл дәл фотосуретке ұқсайды, солай ма?
Dialogue: 0,0:01:02.00,0:01:06.16,Default,,0,0,0,,Бұл мен өлтіргім келетін адамның суреті.
Dialogue: 0,0:01:07.54,0:01:10.75,Default,,0,0,0,,Шаш қиюды кім үйретті?
Dialogue: 0,0:01:13.29,0:01:17.87,Default,,0,0,0,,Егер мен өз миссиямды орындамай қалсам, мен бұл дүкенді жоямын. «Нысана»
Dialogue: 0,0:01:18.12,0:01:19.62,Default,,0,0,0,,Сяо Фэй кеттік!
Dialogue: 0,0:01:42.16,0:01:43.50,Default,,0,0,0,,〝Іш киім мамандандырылған дүкені〞
Dialogue: 0,0:01:43.50,0:01:46.20,Default,,0,0,0,,〝Іш киім мамандандырылған дүкені〞
Dialogue: 0,0:01:43.50,0:01:46.20,Default,,0,0,0,,Бұл бұзық іш киім жинаушы.
Dialogue: 0,0:01:46.91,0:01:49.29,Default,,0,0,0,,Менің комитетімнің бірауыздан
Dialogue: 0,0:01:49.41,0:01:52.04,Default,,0,0,0,,Оны өлтіру үшін 500 юань төле.
Dialogue: 0,0:01:52.29,0:01:53.50,Default,,0,0,0,,Аралдың тыныштығы үшін
Dialogue: 0,0:01:57.16,0:01:58.29,Default,,0,0,0,,Кет!
Dialogue: 0,0:02:13.45,0:02:17.83,Default,,0,0,0,,Маған ұнайтын "сексуалды студент қыз" түрі.
Dialogue: 0,0:02:27.20,0:02:30.00,Default,,0,0,0,,Үй, балақай.
Dialogue: 0,0:02:39.04,0:02:41.66,Default,,0,0,0,,Сексуалды келбетіңізді қабырғаға да іліп қойыңыз
Dialogue: 0,0:02:53.16,0:02:54.79,Default,,0,0,0,,Бұзылған адамды екіге бөл
Dialogue: 0,0:02:55.12,0:02:57.04,Default,,0,0,0,,Неліктен тастар?
Dialogue: 0,0:02:59.58,0:03:01.25,Default,,0,0,0,,Менің балам...
Dialogue: 0,0:03:01.95,0:03:04.79,Default,,0,0,0,,Амансың ба? Бейшара жігіт
Dialogue: 0,0:03:05.54,0:03:08.95,Default,,0,0,0,,Мен бүгін жаңа ғана алған сүйкімді сәби.
Dialogue: 0,0:03:10.62,0:03:12.58,Default,,0,0,0,,Мен оны киіп көрейін бе?
Dialogue: 0,0:03:26.25,0:03:26.83,Default,,0,0,0,,Бұрын менің жинақтағы ақшам 20 000 йен болатын! Ах, ах…
Dialogue: 0,0:03:27.41,0:03:29.29,Default,,0,0,0,,Егер шалбар кимесең
Dialogue: 0,0:03:33.41,0:03:36.08,Default,,0,0,0,,Аралды тазалау комитеті
Dialogue: 0,0:03:36.20,0:03:40.00,Default,,0,0,0,,Мен бұзық адамды тазартуға келдім.
Dialogue: 0,0:03:44.95,0:03:47.45,Default,,0,0,0,,Неліктен бұл күшті әйел мұнда?
Dialogue: 0,0:03:47.62,0:03:49.29,Default,,0,0,0,,Серіктестерді әкелу
Dialogue: 0,0:03:50.50,0:03:51.87,Default,,0,0,0,,Бұл мен...
Dialogue: 0,0:03:52.29,0:03:53.08,Default,,0,0,0,,Күйіп қалу
Dialogue: 0,0:03:53.20,0:03:54.83,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,0:03:56.33,0:03:58.79,Default,,0,0,0,,Мен мұны енді ешқашан жасамаймын
Dialogue: 0,0:03:59.12,0:04:02.58,Default,,0,0,0,,Мен іш киім жинауды бұзық деп білемін.
Dialogue: 0,0:04:03.54,0:04:08.62,Default,,0,0,0,,Бірақ мен ештеңе ұрлаған жоқпын. Мен бәрін өзім сатып алдым.
Dialogue: 0,0:04:08.75,0:04:11.29,Default,,0,0,0,,Менің іш киімімді күйдірме
Dialogue: 0,0:04:17.75,0:04:19.25,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:04:48.91,0:04:52.12,Default,,0,0,0,,Егер сіз оны күйдіріп алсаңыз, көріңіз.
Dialogue: 0,0:04:52.91,0:04:55.45,Default,,0,0,0,,Мен саған о бастан сенбедім.
Dialogue: 0,0:04:55.91,0:04:59.12,Default,,0,0,0,,Бұзық адамның жасырынған жерін білу.
Dialogue: 0,0:04:59.58,0:05:02.62,Default,,0,0,0,,Мен сізді аңдыдым.
Dialogue: 0,0:05:04.00,0:05:04.91,Default,,0,0,0,,Тұру
Dialogue: 0,0:05:06.95,0:05:08.50,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:05:09.62,0:05:12.41,Default,,0,0,0,,Ойыншық жинауды ұнататын адам
Dialogue: 0,0:05:12.87,0:05:14.91,Default,,0,0,0,,Антикалық коллекционер
Dialogue: 0,0:05:15.54,0:05:16.91,Default,,0,0,0,,Галстук жинағыш
Dialogue: 0,0:05:17.20,0:05:22.08,Default,,0,0,0,,Кейбір адамдар бонустық карталар үшін жылдам кеспе жейді.
Dialogue: 0,0:05:23.12,0:05:27.33,Default,,0,0,0,,Бұл жігіттің жинау әдеті әдеттен тыс.
Dialogue: 0,0:05:27.79,0:05:32.62,Default,,0,0,0,,Іш киім жинауды әдеттен тыс және бұрмалаушылық деп атауға болады.
Dialogue: 0,0:05:33.04,0:05:35.66,Default,,0,0,0,,Бірақ бұл не болды?
Dialogue: 0,0:05:35.79,0:05:38.33,Default,,0,0,0,,Әр адамның жасыратын нәрсесі бар.
Dialogue: 0,0:05:38.45,0:05:43.66,Default,,0,0,0,,Мен ешкімді ренжітпеймін, сондықтан не істегенім маңызды емес.
Dialogue: 0,0:05:48.33,0:05:51.70,Default,,0,0,0,,Лас адамның пікірі қажет емес.
Dialogue: 0,0:05:52.45,0:05:55.33,Default,,0,0,0,,Іш киіміңді өртеп, қуып жіберемін.
Dialogue: 0,0:05:55.87,0:05:58.33,Default,,0,0,0,,Бұл қайшылар бұған жол бермейді
Dialogue: 0,0:06:14.20,0:06:16.37,Default,,0,0,0,,Менің көзім айналады. Бұл гипноз ба?
Dialogue: 0,0:06:33.58,0:06:35.83,Default,,0,0,0,,Аюдай күшті
Dialogue: 0,0:06:40.04,0:06:43.08,Default,,0,0,0,,Міне, тағы барамыз. Бұл жолы қулық маған әсер етпейді.
Dialogue: 0,0:06:49.37,0:06:51.37,Default,,0,0,0,,Ұрысты тоқтатыңыз!
Dialogue: 0,0:06:56.08,0:06:58.20,Default,,0,0,0,,Енді менің кезегім
Dialogue: 0,0:07:05.75,0:07:07.58,Default,,0,0,0,,Сонымен, сіз не істейсіз?
Dialogue: 0,0:07:07.70,0:07:09.70,Default,,0,0,0,,Келме! Мен айқайлаймын
Dialogue: 0,0:07:14.29,0:07:16.45,Default,,0,0,0,,Қазір кінәні мойындайтын уақыт.
Dialogue: 0,0:07:19.79,0:07:20.50,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,0:07:29.66,0:07:31.79,Default,,0,0,0,,Менің көзімнен көргендерің үшін мені кешір.
Dialogue: 0,0:07:46.95,0:07:48.75,Default,,0,0,0,,Өзінің әлсіз жақтарын пайдалану
Dialogue: 0,0:08:09.83,0:08:11.79,Default,,0,0,0,,Мен көзілдірігімнен көрмеймін...
Dialogue: 0,0:09:03.62,0:09:04.87,Default,,0,0,0,,Қыздың ояну жұдырығы
Dialogue: 0,0:09:05.87,0:09:07.50,Default,,0,0,0,,Ақ лалагүлдің соққысы
Dialogue: 0,0:09:21.87,0:09:23.41,Default,,0,0,0,,Арнайы қозғалысты қолдану уақыты келді
Dialogue: 0,0:09:23.54,0:09:26.45,Default,,0,0,0,,Айдаһардың қанаттары!
Dialogue: 0,0:09:28.29,0:09:31.54,Default,,0,0,0,,Көзіңізді дереу жуу керек!
Dialogue: 0,0:09:37.45,0:09:40.79,Default,,0,0,0,,Кез келген жағдайда соққы беру үшін «wyvern қанаттары» пайдаланыңыз.
Dialogue: 0,0:09:50.20,0:09:54.87,Default,,0,0,0,,Өтінемін, мені бұзық адамдай көрме.
Dialogue: 0,0:09:55.00,0:09:56.20,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:56.50,0:09:58.79,Default,,0,0,0,,Менің хоббиім басқа адамдардан сәл ғана ерекшеленеді.
Dialogue: 0,0:09:58.91,0:10:00.54,Default,,0,0,0,,Мен мұндай сезімді бірінші рет сезіндім.
Dialogue: 0,0:10:05.91,0:10:07.79,Default,,0,0,0,,Мен сенің атыңды сұрамадым.
Dialogue: 0,0:10:08.45,0:10:10.25,Default,,0,0,0,,Бұл тамаша
Dialogue: 0,0:12:10.62,0:12:13.62,Default,,0,0,0,,Жапон субтитрлері Ри Инагаки
Dialogue: 0,0:12:19.16,0:12:21.04,Default,,0,0,0,,Жалақысы бар маймыл
Dialogue: 0,0:12:22.54,0:12:28.54,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory