Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.33,0:00:09.95,Default,,0,0,0,,NETFLIX түпнұсқалық аниме сериясы
Dialogue: 0,0:00:25.75,0:00:28.25,Default,,0,0,0,,7-миссия капитан Джекті өлтіріңіз
Dialogue: 0,0:00:29.58,0:00:31.29,Default,,0,0,0,,Әдемі көк аспан
Dialogue: 0,0:00:32.04,0:00:33.37,Default,,0,0,0,,Әдемі жағажай
Dialogue: 0,0:00:34.16,0:00:35.66,Default,,0,0,0,,Және әдемі бикини
Dialogue: 0,0:00:35.66,0:00:37.37,Default,,0,0,0,,Және әдемі бикини
Dialogue: 0,0:00:35.66,0:00:37.37,Default,,0,0,0,,〝Жаңа піскен кокос 5 юань〞
Dialogue: 0,0:00:37.37,0:00:38.54,Default,,0,0,0,,〝Жаңа піскен кокос жаңғағы 5 юань〞
Dialogue: 0,0:00:38.79,0:00:42.29,Default,,0,0,0,,Бірақ біз кокос жаңғағын сатуымыз керек
Dialogue: 0,0:00:38.79,0:00:42.29,Default,,0,0,0,,〝Біреуін ал, біреуін тегін ал〞
Dialogue: 0,0:00:42.66,0:00:45.12,Default,,0,0,0,,Сіз тапсырмаңызды орындай алмадыңыз. Бұл сенің кінәң.
Dialogue: 0,0:00:45.87,0:00:48.45,Default,,0,0,0,,Бірде-бір жетістік емес
Dialogue: 0,0:00:49.12,0:00:52.00,Default,,0,0,0,,Егер бұл рас болса, мен қазірге дейін...
Dialogue: 0,0:00:55.04,0:00:56.54,Default,,0,0,0,,Сіз шатастырдыңыз ...
Dialogue: 0,0:00:58.04,0:00:59.00,Default,,0,0,0,,Мұнда емес.
Dialogue: 0,0:00:59.62,0:01:02.33,Default,,0,0,0,,Май жағу керек пе?
Dialogue: 0,0:01:05.79,0:01:08.04,Default,,0,0,0,,Гайвер жұмыртқасы!
Dialogue: 0,0:01:09.87,0:01:12.54,Default,,0,0,0,,Бұл кісі өлтіру туралы өтініш пе?
Dialogue: 0,0:01:12.66,0:01:14.75,Default,,0,0,0,,Оны кәсіпқойларға қалдырыңыз
Dialogue: 0,0:01:14.87,0:01:19.62,Default,,0,0,0,,Сәтсіз болса, толық қайтару Жаңа 50 юань жеңілдік
Dialogue: 0,0:01:19.75,0:01:22.83,Default,,0,0,0,,Оны бүкіл денеме біркелкі жағу керек пе?
Dialogue: 0,0:01:23.45,0:01:24.79,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:01:25.08,0:01:26.29,Default,,0,0,0,,Бұл миссия.
Dialogue: 0,0:01:26.41,0:01:28.12,Default,,0,0,0,,Жүр, жеті!
Dialogue: 0,0:01:28.87,0:01:32.00,Default,,0,0,0,,Алдымен май жағып алайық.
Dialogue: 0,0:01:35.04,0:01:37.83,Default,,0,0,0,,Бұл жақсы жер болды!
Dialogue: 0,0:01:38.00,0:01:39.29,Default,,0,0,0,,Шалбар шешіледі
Dialogue: 0,0:01:39.66,0:01:42.70,Default,,0,0,0,,Мен оны бұрын бояйын ба?
Dialogue: 0,0:02:02.33,0:02:04.95,Default,,0,0,0,,«Жағалау күзеті»
Dialogue: 0,0:02:08.91,0:02:12.62,Default,,0,0,0,,Тақылдап, кіріңіз.
Dialogue: 0,0:02:14.33,0:02:15.33,Default,,0,0,0,,Үш сүңгуір қайық бізге жақындап келеді.
Dialogue: 0,0:02:15.33,0:02:16.91,Default,,0,0,0,,Үш сүңгуір қайық бізге жақындап келеді.
Dialogue: 0,0:02:15.33,0:02:16.91,Default,,0,0,0,,Чен ағай
Dialogue: 0,0:02:16.91,0:02:17.04,Default,,0,0,0,,Үш сүңгуір қайық бізге жақындап келеді.
Dialogue: 0,0:02:17.04,0:02:18.08,Default,,0,0,0,,Үш сүңгуір қайық бізге жақындап келеді.
Dialogue: 0,0:02:17.04,0:02:18.08,Default,,0,0,0,,Тауық аралының жағалау күзеті жауынгерлік қабілеті 45
Dialogue: 0,0:02:18.08,0:02:18.20,Default,,0,0,0,,Тауық аралының жағалау күзеті жауынгерлік қабілеті 45
Dialogue: 0,0:02:18.20,0:02:20.79,Default,,0,0,0,,Тауық аралының жағалау күзеті жауынгерлік қабілеті 45
Dialogue: 0,0:02:18.20,0:02:20.79,Default,,0,0,0,,Ең үлкен сүңгуір қайыққа еніп, капитанды өлтіріңіз.
Dialogue: 0,0:02:20.79,0:02:23.37,Default,,0,0,0,,Ең үлкен суасты қайығына еніп, капитанды өлтіріңіз.
Dialogue: 0,0:02:25.58,0:02:26.58,Default,,0,0,0,,мұздатылған
Dialogue: 0,0:02:26.70,0:02:28.20,Default,,0,0,0,,Қайта бастаймыз
Dialogue: 0,0:02:29.04,0:02:32.12,Default,,0,0,0,,Мұндағы техника ескі емес пе?
Dialogue: 0,0:02:33.00,0:02:38.08,Default,,0,0,0,,10 жыл бойы төленбеген жалақы мен жалғыз қалдым.
Dialogue: 0,0:02:39.41,0:02:42.29,Default,,0,0,0,,Сіз ақшаны төлемейтініңізге сенімдісіз бе?
Dialogue: 0,0:02:43.16,0:02:44.45,Default,,0,0,0,,〝Гомоку жаңғағы ай торты〞
Dialogue: 0,0:02:43.16,0:02:44.45,Default,,0,0,0,,Қабылдау
Dialogue: 0,0:02:44.45,0:02:45.12,Default,,0,0,0,,Қабылдау
Dialogue: 0,0:02:46.25,0:02:48.62,Default,,0,0,0,,Мен ай торттарын жек көремін
Dialogue: 0,0:02:48.83,0:02:52.29,Default,,0,0,0,,Қастандық үшін комиссия 88 юань.
Dialogue: 0,0:02:52.70,0:02:54.75,Default,,0,0,0,,Шынымен де жиіркенішті
Dialogue: 0,0:02:54.87,0:02:57.04,Default,,0,0,0,,Бірақ мен оны қабылдаймын.
Dialogue: 0,0:02:57.25,0:02:58.87,Default,,0,0,0,,Сүңгуір костюмі
Dialogue: 0,0:02:59.29,0:03:00.12,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:03:00.75,0:03:01.54,Default,,0,0,0,,Су астындағы маскалар ше?
Dialogue: 0,0:03:01.66,0:03:02.58,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:03:03.08,0:03:04.91,Default,,0,0,0,,Сізде теңіз наны бар ма?
Dialogue: 0,0:03:06.04,0:03:10.33,Default,,0,0,0,,Мен көп жылдар бойы қолданып жүрген және жақсы көретін нәрсені сізге арнайы қарызға беруге рұқсат етіңіз.
Dialogue: 0,0:03:12.79,0:03:14.45,Default,,0,0,0,,Сізде бар.
Dialogue: 0,0:03:15.16,0:03:16.16,Default,,0,0,0,,Мен мүлде білмеймін.
Dialogue: 0,0:03:16.29,0:03:18.87,Default,,0,0,0,,Әй, мен теңіз нанын ұмытып кетіппін.
Dialogue: 0,0:03:19.25,0:03:22.91,Default,,0,0,0,,Мен жақсырақ жол ойлап таптым
Dialogue: 0,0:03:23.04,0:03:26.12,Default,,0,0,0,,Суға батқан балық болып көрініп, инфильтрация
Dialogue: 0,0:03:26.91,0:03:29.79,Default,,0,0,0,,Бұл тамаша стратегия.
Dialogue: 0,0:03:30.29,0:03:34.29,Default,,0,0,0,,Бұл аралдың тағдыры өз қолдарыңда.
Dialogue: 0,0:03:34.41,0:03:38.95,Default,,0,0,0,,Мен әлемдегі ең жақсы өлтіруші болу бақытына ие болдым.
Dialogue: 0,0:03:42.75,0:03:45.45,Default,,0,0,0,,Керемет!
Dialogue: 0,0:03:58.95,0:04:02.75,Default,,0,0,0,,Кешіріңіз, бірақ мені теңізге лақтырыңыз.
Dialogue: 0,0:04:05.33,0:04:09.08,Default,,0,0,0,,Секіргеннен кейін өзгеру керек еді.
Dialogue: 0,0:04:23.95,0:04:26.91,Default,,0,0,0,,Жарайды, актерлік шеберлігіңізді көрсететін кез келді.
Dialogue: 0,0:04:28.29,0:04:30.75,Default,,0,0,0,,Мен жүзе алмаймын, көмектесіңізші.
Dialogue: 0,0:04:30.87,0:04:32.29,Default,,0,0,0,,Балық суға батып бара жатыр
Dialogue: 0,0:04:33.12,0:04:34.91,Default,,0,0,0,,Оны ұстап алайық
Dialogue: 0,0:04:38.62,0:04:38.95,Default,,0,0,0,,Мен балық ауладым. Мен оны бүгін кешке бумен пісіремін.
Dialogue: 0,0:04:38.95,0:04:42.37,Default,,0,0,0,,Мен балық ұстадым. Мен оны бүгін кешке бумен пісіремін.
Dialogue: 0,0:04:38.95,0:04:42.37,Default,,0,0,0,,Арджун Қарақшы Хенчмен
Dialogue: 0,0:04:42.79,0:04:42.91,Default,,0,0,0,,Әже қарақшылардың қолбасшылары
Dialogue: 0,0:04:42.91,0:04:45.37,Default,,0,0,0,,Әже қарақшының қолбасшысы
Dialogue: 0,0:04:42.91,0:04:45.37,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:04:45.37,0:04:45.62,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:04:46.04,0:04:48.54,Default,,0,0,0,,Балықты грильде жеген дұрыс.
Dialogue: 0,0:04:49.20,0:04:53.79,Default,,0,0,0,,Тірі балық буға пісірілгенде дәмді болады.
Dialogue: 0,0:04:55.54,0:04:57.29,Default,,0,0,0,,Онда мен сені өлтіремін.
Dialogue: 0,0:05:00.25,0:05:02.04,Default,,0,0,0,,Мұнда өлі болып көріну
Dialogue: 0,0:05:03.00,0:05:05.16,Default,,0,0,0,,Сәлем... өте жаман
Dialogue: 0,0:05:05.54,0:05:07.70,Default,,0,0,0,,Ешкімді тамақтандырмаңыз
Dialogue: 0,0:05:09.45,0:05:11.12,Default,,0,0,0,,Ол тірі болды ма?
Dialogue: 0,0:05:11.62,0:05:13.12,Default,,0,0,0,,Енді буға пісірілген балыққа.
Dialogue: 0,0:05:13.83,0:05:15.20,Default,,0,0,0,,Өл! Мен пісіремін
Dialogue: 0,0:05:15.45,0:05:17.37,Default,,0,0,0,,Ешкімді тамақтандырмаңыз
Dialogue: 0,0:05:17.91,0:05:19.29,Default,,0,0,0,,Толық кауль!
Dialogue: 0,0:05:19.41,0:05:20.54,Default,,0,0,0,,Тамақ бермеңіз
Dialogue: 0,0:05:20.66,0:05:21.70,Default,,0,0,0,,Пісір!
Dialogue: 0,0:05:21.83,0:05:22.79,Default,,0,0,0,,Мүлдем жоқ
Dialogue: 0,0:05:22.91,0:05:23.70,Default,,0,0,0,,Грильде пісірілген балық
Dialogue: 0,0:05:28.08,0:05:29.54,Default,,0,0,0,,Қазір тоқтаңыз
Dialogue: 0,0:05:31.41,0:05:32.37,Default,,0,0,0,,Сексуалды қарақшылардың жетекшісі капитан Джек
Dialogue: 0,0:05:32.37,0:05:34.20,Default,,0,0,0,,Сексуалды қарақшылардың жетекшісі капитан Джек
Dialogue: 0,0:05:32.37,0:05:34.20,Default,,0,0,0,,Дауласудың қажеті жоқ
Dialogue: 0,0:05:34.20,0:05:34.45,Default,,0,0,0,,Сексуалды қарақшылардың жетекшісі капитан Джек
Dialogue: 0,0:05:35.20,0:05:36.95,Default,,0,0,0,,Капитан осында.
Dialogue: 0,0:05:37.70,0:05:40.12,Default,,0,0,0,,Оны тек сашимиге айналдырыңыз
Dialogue: 0,0:05:46.91,0:05:49.37,Default,,0,0,0,,Мен оны ұстайын ба?
Dialogue: 0,0:05:49.54,0:05:50.29,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:05:55.62,0:05:59.12,Default,,0,0,0,,Сен менің керемет кіреберісімді бұздың.
Dialogue: 0,0:05:59.41,0:06:00.95,Default,,0,0,0,,Балықтың шетінде...
Dialogue: 0,0:06:01.20,0:06:01.95,Default,,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:06:04.37,0:06:05.12,Default,,0,0,0,,О, Best Jeanist!
Dialogue: 0,0:06:07.95,0:06:10.95,Default,,0,0,0,,Миссия аяқталды Бұл оңай жеңіс болды.
Dialogue: 0,0:06:13.29,0:06:17.54,Default,,0,0,0,,Қараған сайын балық дәмдірек болып көрінеді.
Dialogue: 0,0:06:23.54,0:06:26.16,Default,,0,0,0,,Мұнда әуесқой өлтіруші өлу үшін келді ме?
Dialogue: 0,0:06:26.66,0:06:30.54,Default,,0,0,0,,Мен кәсіпқоймын. Сен үшін ертең жоқ.
Dialogue: 0,0:06:30.87,0:06:33.70,Default,,0,0,0,,Мен бұл жолды естуден шаршадым.
Dialogue: 0,0:06:34.58,0:06:36.37,Default,,0,0,0,,Бұл соңғы рет
Dialogue: 0,0:06:38.25,0:06:41.66,Default,,0,0,0,,Тезірек, қолдарым ұйып барады.
Dialogue: 0,0:06:41.79,0:06:43.04,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:47.66,0:06:52.00,Default,,0,0,0,,Әлгі жігіт сәтсіздікке ұшыраса, менің амалым жоқ.
Dialogue: 0,0:06:58.37,0:07:00.29,Default,,0,0,0,,Енді мені өлтіріңіз.
Dialogue: 0,0:07:00.87,0:07:04.20,Default,,0,0,0,,7 түрі 42 қылыш
Dialogue: 0,0:07:10.04,0:07:11.41,Default,,0,0,0,,Бұл менің қылышым
Dialogue: 0,0:07:18.87,0:07:19.62,Default,,0,0,0,,Толық кауль!
Dialogue: 0,0:07:27.83,0:07:30.62,Default,,0,0,0,,Мені әдемімін деп сынама
Dialogue: 0,0:07:31.00,0:07:34.58,Default,,0,0,0,,Қарақшылар соншалықты қорқынышты
Dialogue: 0,0:07:34.79,0:07:38.62,Default,,0,0,0,,Мен көбірек жалақы алуым керек еді!
Dialogue: 0,0:07:38.75,0:07:43.20,Default,,0,0,0,,Сіз шынымен мені өлтіремін деп ойладыңыз ба? Сізге айтайын, мен...
Dialogue: 0,0:07:54.62,0:07:56.95,Default,,0,0,0,,Өзін-өзі таныстыруға кедергі жасамаңыз
Dialogue: 0,0:07:58.20,0:08:01.91,Default,,0,0,0,,Мен атышулы және ерекше теңіз ақсүйегімін.
Dialogue: 0,0:08:02.04,0:08:03.54,Default,,0,0,0,,Бұл капитан Джек.
Dialogue: 0,0:08:12.87,0:08:15.16,Default,,0,0,0,,Моши Моши Дайбо
Dialogue: 0,0:08:15.29,0:08:18.29,Default,,0,0,0,,Жау тым күшті. Қолдау сұраңыз.
Dialogue: 0,0:08:20.12,0:08:23.12,Default,,0,0,0,,Мен тауықпын, жүзе алмаймын
Dialogue: 0,0:08:23.75,0:08:25.29,Default,,0,0,0,,Өзіңіз бірдеңе жасаңыз
Dialogue: 0,0:08:25.70,0:08:27.20,Default,,0,0,0,,Бұл ақымақ бір жерде...
Dialogue: 0,0:08:27.54,0:08:29.00,Default,,0,0,0,,Мұны тыныш орындаңыз
Dialogue: 0,0:08:29.12,0:08:33.16,Default,,0,0,0,,Егер сіз оны ысқыламасаңыз, оны біркелкі жаға алмайсыз.
Dialogue: 0,0:08:34.00,0:08:34.83,Default,,0,0,0,,Ол ма?
Dialogue: 0,0:08:39.62,0:08:41.87,Default,,0,0,0,,Бұл сіз қалаған нәрсе.
Dialogue: 0,0:08:47.79,0:08:48.62,Default,,0,0,0,,50 миллион.
Dialogue: 0,0:08:48.91,0:08:49.70,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:08:49.87,0:08:51.62,Default,,0,0,0,,Сіздің шотыңызға ақша аударыңыз
Dialogue: 0,0:09:16.16,0:09:20.29,Default,,0,0,0,,Сіздің кесіріңізден мен ақшаны ала алмадым.
Dialogue: 0,0:09:26.66,0:09:28.79,Default,,0,0,0,,Сіз мені елемейсіз бе?
Dialogue: 0,0:09:29.08,0:09:31.45,Default,,0,0,0,,Сіз мені өте жақсы қорладыңыз.
Dialogue: 0,0:09:44.87,0:09:47.29,Default,,0,0,0,,Мен оны өлтіруім керек еді. Неге...
Dialogue: 0,0:10:12.75,0:10:15.29,Default,,0,0,0,,Бірақ бұл адам тым әлсіз.
Dialogue: 0,0:10:16.41,0:10:17.50,Default,,0,0,0,,Ол тез.
Dialogue: 0,0:10:21.95,0:10:23.33,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:10:23.79,0:10:25.37,Default,,0,0,0,,Ұқсас болғанымен...
Dialogue: 0,0:10:26.12,0:10:28.12,Default,,0,0,0,,Қуат айырмашылығы айқын
Dialogue: 0,0:10:30.33,0:10:32.70,Default,,0,0,0,,Неліктен аралға басып кіру керек?
Dialogue: 0,0:10:34.50,0:10:36.95,Default,,0,0,0,,Өмірлері киіміне байланысты жағалау күзетінің қызметкерлері үшін...
Dialogue: 0,0:10:37.41,0:10:39.79,Default,,0,0,0,,Ол сандық киген.
Dialogue: 0,0:10:40.58,0:10:43.75,Default,,0,0,0,,Мені өлтіруші ретінде жалдау үшін
Dialogue: 0,0:10:44.66,0:10:46.75,Default,,0,0,0,,Өйткені мен шалбарымды ломбардқа қойдым.
Dialogue: 0,0:10:47.50,0:10:52.79,Default,,0,0,0,,Ол өзі жақсы көретін арал үшін кез келген құрбандыққа баруға дайын.
Dialogue: 0,0:10:47.50,0:10:52.79,Default,,0,0,0,,«Ломбард»
Dialogue: 0,0:10:53.37,0:10:55.12,Default,,0,0,0,,Біркелкі шалбар
Dialogue: 0,0:10:55.33,0:10:58.08,Default,,0,0,0,,Аралдың тағдыры өз қолдарыңда.
Dialogue: 0,0:10:58.20,0:10:59.16,Default,,0,0,0,,Және...
Dialogue: 0,0:10:59.66,0:11:00.58,Default,,0,0,0,,Және...
Dialogue: 0,0:11:01.33,0:11:03.75,Default,,0,0,0,,Әдемі бикини
Dialogue: 0,0:11:04.08,0:11:07.79,Default,,0,0,0,,Мен әлі май жақпадым!
Dialogue: 0,0:11:10.25,0:11:13.29,Default,,0,0,0,,Мен терезені сындырып, сені суға батырамын.
Dialogue: 0,0:11:17.33,0:11:18.33,Default,,0,0,0,,Өте…
Dialogue: 0,0:11:23.12,0:11:24.66,Default,,0,0,0,,Қызықты
Dialogue: 0,0:11:25.41,0:11:28.16,Default,,0,0,0,,Олай болса бәс тігейік
Dialogue: 0,0:11:28.75,0:11:33.58,Default,,0,0,0,,Бір қадам болса да жылжи алсам, аралдан бас тартамын.
Dialogue: 0,0:11:35.16,0:11:36.25,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:11:48.75,0:11:49.45,Default,,0,0,0,,Гайвер жұмыртқасы!
Dialogue: 0,0:11:57.04,0:11:58.87,Default,,0,0,0,,Бұл кәдімгі жұмыртқа.
Dialogue: 0,0:12:02.91,0:12:05.00,Default,,0,0,0,,Сіздің шығыныңыз
Dialogue: 0,0:12:07.25,0:12:09.45,Default,,0,0,0,,Уәде – уәде, қош бол.
Dialogue: 0,0:12:12.08,0:12:16.70,Default,,0,0,0,,Мен енді өтейін деп жатыр едім, басып кіру ойым жоқ еді.
Dialogue: 0,0:12:20.08,0:12:21.70,Default,,0,0,0,,Тұтқынға түсті
Dialogue: 0,0:12:25.25,0:12:27.20,Default,,0,0,0,,Мені шығарыңыз
Dialogue: 0,0:12:30.08,0:12:31.12,Default,,0,0,0,,Сәтті
Dialogue: 0,0:12:31.41,0:12:32.29,Default,,0,0,0,,Бұл жеткізу.
Dialogue: 0,0:12:37.75,0:12:41.25,Default,,0,0,0,,Сонымен марапат қайда?
Dialogue: 0,0:14:43.54,0:14:46.54,Default,,0,0,0,,Жапон субтитрлері Тецуко Икегая
Dialogue: 0,0:14:48.04,0:14:54.04,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory