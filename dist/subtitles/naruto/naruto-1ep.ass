Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:07.59,Default,,0,0,0,,⟨Баяғыда бір елес болған⟩
Dialogue: 0,0:00:07.59,0:00:11.09,Default,,0,0,0,,⟨Сол түлкінің тоғыз құйрығы бар⟩
Dialogue: 0,0:00:11.80,0:00:16.10,Default,,0,0,0,,⟨Егер оның құйрығы бір рет шайқалса, көшкін цунамиді тудырады⟩
Dialogue: 0,0:00:16.51,0:00:21.52,Default,,0,0,0,,⟨Осыдан мазасызданған адамдар ниндзяларды жинады⟩
Dialogue: 0,0:00:21.81,0:00:24.56,Default,,0,0,0,,Yondaime келгенше ұстаңыз!
Dialogue: 0,0:00:24.60,0:00:27.31,Default,,0,0,0,,Ауылға бір қадам да жақындама!
Dialogue: 0,0:00:30.74,0:00:37.49,Default,,0,0,0,,⟨Тек бір ниндзя бар, мен оны жабу үшін өмір мен өлімімді қатерге тігемін, бірақ...
Dialogue: 0,0:00:37.87,0:00:39.54,Default,,0,0,0,,Ол адам өледі⟩
Dialogue: 0,0:00:40.20,0:00:46.46,Default,,0,0,0,,⟨Сол ниндзяның аты - Төртінші Хокаге⟩
Dialogue: 0,0:00:47.54,0:00:49.50,Default,,0,0,0,,Огияа Огяа
Dialogue: 0,0:00:49.92,0:00:53.26,Default,,0,0,0,,Иә иә иә
Dialogue: 0,0:00:59.51,0:01:02.31,Default,,0,0,0,,Гяхаха…хехе
Dialogue: 0,0:01:02.31,0:01:03.56,Default,,0,0,0,,Мұнда Наруто
Dialogue: 0,0:01:03.56,0:01:05.77,Default,,0,0,0,,Мен жазаға лайық нәрсе жасадым!
Dialogue: 0,0:01:05.77,0:01:08.27,Default,,0,0,0,,Мен сені бүгін ешқашан кешірмеймін!
Dialogue: 0,0:01:11.19,0:01:13.57,Default,,0,0,0,,Хахаха
Dialogue: 0,0:01:13.57,0:01:15.36,Default,,0,0,0,,Усендаттебайо!
Dialogue: 0,0:01:15.78,0:01:19.91,Default,,0,0,0,,Балалар, сендер бұған еліктей алмайсыңдар ма?
Dialogue: 0,0:01:20.03,0:01:22.04,Default,,0,0,0,,Бірақ мен мұны істей аламын.
Dialogue: 0,0:01:22.16,0:01:24.41,Default,,0,0,0,,Мен кереметпін
Dialogue: 0,0:01:24.54,0:01:25.79,Default,,0,0,0,,Бұл қиын, үшінші буын!
Dialogue: 0,0:01:25.79,0:01:26.92,Default,,0,0,0,,Хокаге-сама
Dialogue: 0,0:01:27.37,0:01:32.55,Default,,0,0,0,,Сонымен, Наруто тағы бірдеңе жасады ма?
Dialogue: 0,0:01:32.84,0:01:35.76,Default,,0,0,0,,Иә, өткен Хокаге-саманың жүздері...
Dialogue: 0,0:01:35.76,0:01:37.97,Default,,0,0,0,,Дудл жасаудан қорықпаңыз!
Dialogue: 0,0:01:38.43,0:01:39.72,Default,,0,0,0,,Аа...
Dialogue: 0,0:01:48.10,0:01:49.19,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:01:52.36,0:01:56.70,Default,,0,0,0,,Хахаха... Олай емес!
Dialogue: 0,0:01:56.82,0:01:58.45,Default,,0,0,0,,Сәлем Наруто!
Dialogue: 0,0:01:58.45,0:02:01.20,Default,,0,0,0,,Уау...
Dialogue: 0,0:02:02.70,0:02:06.12,Default,,0,0,0,,Кенеттен мен не істеуім керек?Ирука сенси
Dialogue: 0,0:02:06.16,0:02:09.21,Default,,0,0,0,,Сабақта не істеп жатырсың!?
Dialogue: 0,0:02:11.79,0:02:13.25,Default,,0,0,0,,Тыңда, Наруто!
Dialogue: 0,0:02:13.46,0:02:17.84,Default,,0,0,0,,Сіз бітіру емтиханын соңғы рет және оған дейінгі уақытта тапсыра алмадыңыз.
Dialogue: 0,0:02:17.88,0:02:20.55,Default,,0,0,0,,Бұл трюк ойнайтын уақыт емес, ақымақ.
Dialogue: 0,0:02:20.72,0:02:21.47,Default,,0,0,0,,Хмф!
Dialogue: 0,0:02:22.89,0:02:25.93,Default,,0,0,0,,Бүгінгі сабақ - өзгерту өнері бойынша қайталау сынағы.
Dialogue: 0,0:02:25.93,0:02:28.48,Default,,0,0,0,,Өтіп кеткендерді тізімдеңіз!
Dialogue: 0,0:02:28.48,0:02:30.10,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:30.35,0:02:32.44,Default,,0,0,0,,Сакура Харуно Мен осындамын
Dialogue: 0,0:02:32.44,0:02:33.40,Default,,0,0,0,,Өзгер!
Dialogue: 0,0:02:38.11,0:02:39.11,Default,,0,0,0,,Эй!
Dialogue: 0,0:02:40.28,0:02:41.91,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:42.41,0:02:44.16,Default,,0,0,0,,《Тшш!》
Dialogue: 0,0:02:44.49,0:02:46.08,Default,,0,0,0,,Сасуке-кун, көрдің бе?
Dialogue: 0,0:02:46.08,0:02:47.66,Default,,0,0,0,,Келесі Сасуке Учиха
Dialogue: 0,0:02:48.08,0:02:48.87,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:54.17,0:02:55.59,Default,,0,0,0,,Жарайды... Жарайды.
Dialogue: 0,0:02:57.97,0:02:58.51,Default,,0,0,0,,Хун
Dialogue: 0,0:02:58.72,0:03:00.89,Default,,0,0,0,,Келесі Наруто Узумаки
Dialogue: 0,0:03:01.39,0:03:03.76,Default,,0,0,0,,Бұл өте тітіркендіргіш
Dialogue: 0,0:03:03.97,0:03:05.76,Default,,0,0,0,,Бәріне сен кінәлісің
Dialogue: 0,0:03:05.76,0:03:07.18,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:03:10.10,0:03:11.19,Default,,0,0,0,,《Жарайды…》
Dialogue: 0,0:03:12.65,0:03:15.73,Default,,0,0,0,,《Наруто-кун... Сәттілік》
Dialogue: 0,0:03:16.03,0:03:16.98,Default,,0,0,0,,Өзгер!
Dialogue: 0,0:03:19.28,0:03:21.32,Default,,0,0,0,,Уууу
Dialogue: 0,0:03:22.66,0:03:24.33,Default,,0,0,0,,Мен... Не!
Dialogue: 0,0:03:26.58,0:03:28.20,Default,,0,0,0,,Гяхаха…
Dialogue: 0,0:03:28.20,0:03:30.71,Default,,0,0,0,,Сіз қалай ойлайсыз?Оны атаңыз, жыныстық тартымдылық өнері!
Dialogue: 0,0:03:30.71,0:03:32.58,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:03:32.58,0:03:34.96,Default,,0,0,0,,Ақылсыз әдістерді ойлап шығармаңыз!
Dialogue: 0,0:03:40.22,0:03:41.13,Default,,0,0,0,,Боқ...
Dialogue: 0,0:03:41.68,0:03:42.68,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:03:43.18,0:03:46.89,Default,,0,0,0,,Таза болғанша үйге барма!
Dialogue: 0,0:03:47.97,0:03:49.48,Default,,0,0,0,,Мәселе жоқ!
Dialogue: 0,0:03:49.48,0:03:52.10,Default,,0,0,0,,Мен үйге барғанда үйде ешкім жоқ
Dialogue: 0,0:03:52.10,0:03:52.73,Default,,0,0,0,,Хун
Dialogue: 0,0:03:57.61,0:03:58.53,Default,,0,0,0,,Наруто
Dialogue: 0,0:03:59.99,0:04:01.82,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:04:02.11,0:04:04.20,Default,,0,0,0,,Ойланыңызшы...
Dialogue: 0,0:04:04.53,0:04:09.58,Default,,0,0,0,,Барлығын тазалаған соң, бүгін кешке рамен сатып аламын.
Dialogue: 0,0:04:11.87,0:04:12.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:13.54,0:04:17.54,Default,,0,0,0,,Юоши!Бұл менмін, менмін, барымызды салайық!
Dialogue: 0,0:04:32.18,0:04:33.10,Default,,0,0,0,,Наруто
Dialogue: 0,0:04:33.31,0:04:34.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:34.56,0:04:37.40,Default,,0,0,0,,Неліктен онда граффити жаздыңыз?
Dialogue: 0,0:04:37.65,0:04:40.90,Default,,0,0,0,,Хокаге-саманың қандай адамдар екенін білесіз бе?
Dialogue: 0,0:04:40.94,0:04:42.61,Default,,0,0,0,,Әрине бар.
Dialogue: 0,0:04:47.41,0:04:48.37,Default,,0,0,0,,Аа...
Dialogue: 0,0:04:48.78,0:04:52.29,Default,,0,0,0,,Демек, Хокаге есімін мұрагер еткен адам...
Dialogue: 0,0:04:52.45,0:04:55.17,Default,,0,0,0,,Ол ауылдағы ең жақсы ниндзя болды, солай ма?
Dialogue: 0,0:04:57.96,0:05:03.55,Default,,0,0,0,,Әсіресе, Йондайме ауылды құбыжық түлкіден қорғаған батырға ұқсайды.
Dialogue: 0,0:05:03.76,0:05:05.05,Default,,0,0,0,,Сонда неге?
Dialogue: 0,0:05:05.30,0:05:09.01,Default,,0,0,0,,Мен бір күні Хокаге есімін мұраға аламын...
Dialogue: 0,0:05:09.01,0:05:13.60,Default,,0,0,0,,Келіңіздер, мен бұрынғы Хокагеден де асып түсемін.
Dialogue: 0,0:05:13.64,0:05:18.69,Default,,0,0,0,,Күшімді ауылдағылардың бәріне таныттым.
Dialogue: 0,0:05:19.44,0:05:23.82,Default,,0,0,0,,Айтпақшы, профессор, өтінемін...
Dialogue: 0,0:05:24.36,0:05:25.61,Default,,0,0,0,,Қайта толтыру керек пе?
Dialogue: 0,0:05:25.61,0:05:29.66,Default,,0,0,0,,Ня, Коноханың маңдайын қорғаушы, мұны істе.
Dialogue: 0,0:05:29.66,0:05:31.58,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:05:31.87,0:05:33.08,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:05:33.25,0:05:38.29,Default,,0,0,0,,Бұл сіздің мектеп бітіріп, толыққанды тұлға ретінде танылғаныңыздың дәлелі.
Dialogue: 0,0:05:38.75,0:05:40.42,Default,,0,0,0,,Сен ертеңсің
Dialogue: 0,0:05:40.67,0:05:41.92,Default,,0,0,0,,Хмм!Сараң!
Dialogue: 0,0:05:41.92,0:05:45.13,Default,,0,0,0,,Ах ха ха... Сондықтан мен көзілдірікті шешіп алдым.
Dialogue: 0,0:05:45.13,0:05:46.05,Default,,0,0,0,,Қайта толтырыңыз!
Dialogue: 0,0:05:46.05,0:05:47.01,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:49.18,0:05:52.01,Default,,0,0,0,,Енді бітіру емтиханын бастайық.
Dialogue: 0,0:05:52.47,0:05:55.56,Default,,0,0,0,,Шақырылғандар көрші сыныпқа келуі керек.
Dialogue: 0,0:05:55.93,0:05:58.60,Default,,0,0,0,,Қиындық клон жасау өнері болады.
Dialogue: 0,0:05:58.60,0:06:00.44,Default,,0,0,0,,《Гах...》
Dialogue: 0,0:06:00.44,0:06:04.65,Default,,0,0,0,,《Айтпақшы, бұл менің ең ұнамайтын техникам.》
Dialogue: 0,0:06:08.66,0:06:11.99,Default,,0,0,0,,``Бірақ, бірақ, мен мұны істеймін!'' 》
Dialogue: 0,0:06:17.08,0:06:18.58,Default,,0,0,0,,Bunshin no Jutsu!
Dialogue: 0,0:06:27.63,0:06:29.22,Default,,0,0,0,,Дисквалификацияланды!
Dialogue: 0,0:06:31.18,0:06:32.43,Default,,0,0,0,,Ирука Сенсей
Dialogue: 0,0:06:33.60,0:06:37.31,Default,,0,0,0,,Оның тамаша қозғалысы мен төзімділігі бар...
Dialogue: 0,0:06:37.52,0:06:41.11,Default,,0,0,0,,Осыған қарамастан, мен әлі де клондау әдісін қолдана аламын.
Dialogue: 0,0:06:41.31,0:06:42.65,Default,,0,0,0,,Мен сені өткізуге рұқсат етсем де...
Dialogue: 0,0:06:42.65,0:06:43.44,Default,,0,0,0,,Аха!
Dialogue: 0,0:06:43.82,0:06:45.19,Default,,0,0,0,,Мизуки Сенсей
Dialogue: 0,0:06:45.44,0:06:49.03,Default,,0,0,0,,Әр адамның кем дегенде үш альтер эгосы бар.
Dialogue: 0,0:06:50.41,0:06:52.62,Default,,0,0,0,,Бірақ Наруто жалғыз
Dialogue: 0,0:06:52.87,0:06:55.49,Default,,0,0,0,,Және бұл тек кедергі ретінде қызмет етеді.
Dialogue: 0,0:06:55.62,0:06:57.41,Default,,0,0,0,,Өткізілген деп танылмады
Dialogue: 0,0:06:59.79,0:07:02.50,Default,,0,0,0,,Жарайды!>>Хахаха…
Dialogue: 0,0:07:05.96,0:07:08.01,Default,,0,0,0,,Енді мен толыққандымын!
Dialogue: 0,0:07:08.01,0:07:10.22,Default,,0,0,0,,Жарайсың!Балам күткендей
Dialogue: 0,0:07:10.26,0:07:13.93,Default,,0,0,0,,Мектеп бітіруіңізбен құттықтаймыз. Мама бүгін кешке той жасайды.
Dialogue: 0,0:07:15.10,0:07:16.85,Default,,0,0,0,,Эй, бұл бала...
Dialogue: 0,0:07:17.52,0:07:21.31,Default,,0,0,0,,Бір ғана бала құлаған сияқты.
Dialogue: 0,0:07:21.73,0:07:23.77,Default,,0,0,0,,Хун, бұл жақсы көрінеді.
Dialogue: 0,0:07:23.90,0:07:26.53,Default,,0,0,0,,Егер мұндай нәрсе шинобиге айналса, қиын болар еді.
Dialogue: 0,0:07:26.86,0:07:28.03,Default,,0,0,0,,Өйткені бұл шын мәнінде сол қыз...
Dialogue: 0,0:07:28.03,0:07:30.78,Default,,0,0,0,,Эй!Одан тыс кез келген нәрсе – тыйым салынған
Dialogue: 0,0:07:30.90,0:07:31.53,Default,,0,0,0,,(аяқ дыбыстары)
Dialogue: 0,0:07:31.53,0:07:32.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:36.29,0:07:37.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:38.70,0:07:40.04,Default,,0,0,0,,Дельфин...
Dialogue: 0,0:07:41.75,0:07:43.75,Default,,0,0,0,,Мен сенімен кейінірек сөйлесемін.
Dialogue: 0,0:07:44.42,0:07:45.25,Default,,0,0,0,,Иә...
Dialogue: 0,0:07:50.97,0:07:54.97,Default,,0,0,0,,Ирука-сенсэй мүлде жаман емес.
Dialogue: 0,0:07:55.39,0:07:58.10,Default,,0,0,0,,Сонда неге тек мен...
Dialogue: 0,0:07:58.39,0:08:01.14,Default,,0,0,0,,Сөздің шын мағынасында Наруто-кун...
Dialogue: 0,0:08:01.35,0:08:04.15,Default,,0,0,0,,Мен сенің күшті болғаныңды қалаймын.
Dialogue: 0,0:08:05.15,0:08:06.86,Default,,0,0,0,,Ата-анасы жоқ адамдар...
Dialogue: 0,0:08:08.40,0:08:09.11,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:08:09.94,0:08:12.40,Default,,0,0,0,,Мен оқуды аяқтағым келді.
Dialogue: 0,0:08:13.03,0:08:13.86,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:08:14.82,0:08:16.53,Default,,0,0,0,,Мен бұған көмектесе алмаймын.
Dialogue: 0,0:08:16.91,0:08:17.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:18.83,0:08:22.16,Default,,0,0,0,,Мен сізге бір ерекше құпияны айтайын
Dialogue: 0,0:08:23.71,0:08:24.83,Default,,0,0,0,,《Құпия...》
Dialogue: 0,0:08:28.42,0:08:29.63,Default,,0,0,0,,Дельфин
Dialogue: 0,0:08:30.55,0:08:32.97,Default,,0,0,0,,Бұл не?Хокаге-сама
Dialogue: 0,0:08:33.18,0:08:36.18,Default,,0,0,0,,Мен сенің сезімдеріңді де түсінбеймін.
Dialogue: 0,0:08:36.22,0:08:38.76,Default,,0,0,0,,Дәл солай Джага Нарутоға да қатысты...
Dialogue: 0,0:08:38.76,0:08:41.93,Default,,0,0,0,,Ата-анаңның махаббатын білмей өстің.
Dialogue: 0,0:08:46.44,0:08:49.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:49.19,0:08:50.07,Default,,0,0,0,,Жібер!
Dialogue: 0,0:08:50.07,0:08:53.15,Default,,0,0,0,,Анам мен әкем әлі соғысуда!
Dialogue: 0,0:08:56.07,0:08:58.08,Default,,0,0,0,,Ирука Сенсей!Өтінемін ояныңыз
Dialogue: 0,0:08:58.08,0:08:58.70,Default,,0,0,0,,Әй!
Dialogue: 0,0:09:00.29,0:09:01.79,Default,,0,0,0,,Не болды?
Dialogue: 0,0:09:02.00,0:09:04.41,Default,,0,0,0,,Хокаге-саманың орнына жиналыңдар.
Dialogue: 0,0:09:04.83,0:09:06.63,Default,,0,0,0,,Шамасы, Наруто-кун...
Dialogue: 0,0:09:07.13,0:09:09.29,Default,,0,0,0,,Мөрлер кітабын шығарған сияқты!
Dialogue: 0,0:09:09.59,0:09:10.17,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:09:10.38,0:09:11.80,Default,,0,0,0,,Ол мөр басылған кітап па!?
Dialogue: 0,0:09:13.72,0:09:17.05,Default,,0,0,0,,Хмм... Бірінші джутсу...
Dialogue: 0,0:09:17.34,0:09:20.06,Default,,0,0,0,,Бірнеше көлеңкелі клондар ма?
Dialogue: 0,0:09:20.60,0:09:24.39,Default,,0,0,0,,Бұл не? Кенеттен мен бұл техникада жақсы емеспін!
Dialogue: 0,0:09:24.39,0:09:28.23,Default,,0,0,0,,Хокаге-сама, бұл жолы мен еркелікпен құтылмаймын!
Dialogue: 0,0:09:28.23,0:09:32.40,Default,,0,0,0,,Мөрлер кітабы бірінші Хокаге-сама мөрімен басылған қауіпті нәрсе.
Dialogue: 0,0:09:32.48,0:09:34.49,Default,,0,0,0,,Оны қалай пайдаланатыныңызға байланысты...
Dialogue: 0,0:09:34.82,0:09:38.53,Default,,0,0,0,,Егер сені ауылдан алып кетсе, бұл үлкен іс!
Dialogue: 0,0:09:39.91,0:09:40.66,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:40.91,0:09:43.04,Default,,0,0,0,,Нарутоны қайтарыңыз!
Dialogue: 0,0:09:43.08,0:09:43.95,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:51.67,0:09:54.21,Default,,0,0,0,,Хаха...
Dialogue: 0,0:09:54.21,0:09:55.76,Default,,0,0,0,,《Наруто қайда кетті...》
Dialogue: 0,0:10:02.22,0:10:04.31,Default,,0,0,0,,Хехе...
Dialogue: 0,0:10:04.31,0:10:08.15,Default,,0,0,0,,``Ауылға хабар тарат, содан кейін Нарутодан құтыл!》
Dialogue: 0,0:10:08.52,0:10:11.90,Default,,0,0,0,,《Онда мөрлер кітабы менікі болады》
Dialogue: 0,0:10:14.44,0:10:18.82,Default,,0,0,0,,Хаха...
Dialogue: 0,0:10:22.70,0:10:23.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:23.49,0:10:26.54,Default,,0,0,0,,Эй... Наруто...
Dialogue: 0,0:10:27.71,0:10:29.79,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:10:30.71,0:10:31.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:31.88,0:10:33.96,Default,,0,0,0,,Сіз оны таптыңыз ба?
Dialogue: 0,0:10:33.96,0:10:36.97,Default,,0,0,0,,Мен әлі бір ғана джутсу үйрендім...
Dialogue: 0,0:10:37.97,0:10:40.01,Default,,0,0,0,,《Дзюцумен осында жаттығасыз ба?》
Dialogue: 0,0:10:40.93,0:10:42.35,Default,,0,0,0,,《Осылай болғанша...》
Dialogue: 0,0:10:42.39,0:10:45.81,Default,,0,0,0,,Сіз маған таңғажайып әдістерді көрсеткіңіз келеді.
Dialogue: 0,0:10:45.81,0:10:47.98,Default,,0,0,0,,Егер сен мұны істей алсаң, маған оқуды бітіруге рұқсат ет!
Dialogue: 0,0:10:47.98,0:10:51.94,Default,,0,0,0,,Егер мен сізге бұл шиыршықты қалай пайдалану керектігін көрсетсем, сіз бітіретініңізге сенімдімін, солай емес пе?
Dialogue: 0,0:10:51.94,0:10:54.15,Default,,0,0,0,,Сонымен… кім мұндай нәрсені жасайды!?
Dialogue: 0,0:10:54.15,0:10:56.28,Default,,0,0,0,,Мизуки Сенсей Даттебайо
Dialogue: 0,0:10:56.28,0:11:00.20,Default,,0,0,0,,Шиыршық пен осы жерге қатысты Мизуки-сенсэй...
Dialogue: 0,0:11:03.20,0:11:04.37,Default,,0,0,0,,《Мидзуки!?》
Dialogue: 0,0:11:04.79,0:11:05.41,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:06.16,0:11:07.79,Default,,0,0,0,,Уф... Уау!
Dialogue: 0,0:11:09.62,0:11:11.50,Default,,0,0,0,,​​Мен бұл мәселені жақсы түсінемін.
Dialogue: 0,0:11:12.38,0:11:15.17,Default,,0,0,0,,Түсінемін... Солай ма?
Dialogue: 0,0:11:18.17,0:11:19.13,Default,,0,0,0,,Наруто
Dialogue: 0,0:11:20.22,0:11:21.72,Default,,0,0,0,,Маған шиыршықты беріңіз.
Dialogue: 0,0:11:21.93,0:11:25.39,Default,,0,0,0,,Бұл не болып жатыр?
Dialogue: 0,0:11:25.72,0:11:27.56,Default,,0,0,0,,Қарғыс атқыр... хахаха...
Dialogue: 0,0:11:27.56,0:11:30.52,Default,,0,0,0,,Наруто Өлсең де шиыршықты берме!
Dialogue: 0,0:11:30.64,0:11:35.15,Default,,0,0,0,,Ниндзюцуға тыйым салынған және мөрмен жабылған қауіпті нәрсе.
Dialogue: 0,0:11:35.52,0:11:39.19,Default,,0,0,0,,Мизуки оны алу үшін сізді пайдаланды.
Dialogue: 0,0:11:39.44,0:11:40.32,Default,,0,0,0,,Не!?
Dialogue: 0,0:11:40.86,0:11:41.91,Default,,0,0,0,,Наруто
Dialogue: 0,0:11:42.49,0:11:46.08,Default,,0,0,0,,Дельфин сенде болады деп қорқады.
Dialogue: 0,0:11:46.12,0:11:46.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:49.12,0:11:50.96,Default,,0,0,0,,Не туралы айтып тұрсың, Мизуки?
Dialogue: 0,0:11:51.08,0:11:52.83,Default,,0,0,0,,Нарутоға алданбаңыз
Dialogue: 0,0:11:53.04,0:11:54.08,Default,,0,0,0,,Хахаха…
Dialogue: 0,0:11:54.08,0:11:56.25,Default,,0,0,0,,Мен саған шындықты айтайын
Dialogue: 0,0:11:56.25,0:11:57.84,Default,,0,0,0,,Бах... Идиот!
Dialogue: 0,0:11:58.09,0:12:02.26,Default,,0,0,0,,Осыдан 12 жыл бұрынғы оқиғадан бері ауылда белгілі бір тәртіп орнады.
Dialogue: 0,0:12:03.76,0:12:05.26,Default,,0,0,0,,Белгілі бір ереже?
Dialogue: 0,0:12:05.72,0:12:07.39,Default,,0,0,0,,Бұл Наруто...
Dialogue: 0,0:12:07.56,0:12:11.56,Default,,0,0,0,,Бұл тек сіз ешқашан білмейтін ереже болды.
Dialogue: 0,0:12:11.73,0:12:13.10,Default,,0,0,0,,Тек мен үшін бе?
Dialogue: 0,0:12:13.40,0:12:15.69,Default,,0,0,0,,Бұл қандай ереже?
Dialogue: 0,0:12:15.90,0:12:17.40,Default,,0,0,0,,Тоқта, Мизуки!
Dialogue: 0,0:12:17.82,0:12:21.95,Default,,0,0,0,,Нарутоның шынайы тұлғасын жасырын түлкі деп айтпау ереже.
Dialogue: 0,0:12:22.70,0:12:23.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:24.20,0:12:27.41,Default,,0,0,0,,Сонымен, сіз Ируканың ата-анасын өлтірдіңіз ...
Dialogue: 0,0:12:27.41,0:12:31.16,Default,,0,0,0,,Ауылды бұзған тоғыз құйрықты түлкі!
Dialogue: 0,0:12:31.37,0:12:32.83,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:12:33.83,0:12:37.29,Default,,0,0,0,,Сені ауылдағылардың бәрі алдап кетті.
Dialogue: 0,0:12:38.09,0:12:40.30,Default,,0,0,0,,Сізге бұл біртүрлі көрінбеді ме?
Dialogue: 0,0:12:40.96,0:12:42.97,Default,,0,0,0,,Соншалықты жек көру...
Dialogue: 0,0:12:43.51,0:12:45.09,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:12:45.30,0:12:48.22,Default,,0,0,0,,Қарғыс атсын, қарғыс атсын, қарғыс атсын...
Dialogue: 0,0:12:48.64,0:12:49.97,Default,,0,0,0,,Наруто…
Dialogue: 0,0:12:50.39,0:12:53.06,Default,,0,0,0,,Сізді ешкім танымайды!
Dialogue: 0,0:12:53.39,0:12:55.85,Default,,0,0,0,,Тіпті Ирука сені жек көреді
Dialogue: 0,0:12:56.10,0:12:56.86,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:12:57.19,0:12:58.44,Default,,0,0,0,,Дельфин...
Dialogue: 0,0:12:59.02,0:13:01.90,Default,,0,0,0,,Наруто ата-анасының махаббатын білмейді...
Dialogue: 0,0:13:02.28,0:13:06.53,Default,,0,0,0,,Ауылдағылар бұл оқиғадан ұялады.
Dialogue: 0,0:13:07.20,0:13:12.58,Default,,0,0,0,,Сондықтан да адамдардың назарын аудару үшін еркелік ойнаудан басқа амалдары қалмады.
Dialogue: 0,0:13:12.87,0:13:18.21,Default,,0,0,0,,Менің бар екендігімді кез келген жолмен танығанын қалаймын деп ойлаймын.
Dialogue: 0,0:13:18.63,0:13:22.92,Default,,0,0,0,,Ол күшті болғанымен, зардап шегетін Наруто.
Dialogue: 0,0:13:23.26,0:13:25.30,Default,,0,0,0,,Наруто өл!
Dialogue: 0,0:13:25.51,0:13:27.64,Default,,0,0,0,,Уау уау...
Dialogue: 0,0:13:27.64,0:13:29.30,Default,,0,0,0,,Наруто, жат!
Dialogue: 0,0:13:35.94,0:13:37.02,Default,,0,0,0,,Гах...
Dialogue: 0,0:13:39.52,0:13:40.61,Default,,0,0,0,,Хмм!
Dialogue: 0,0:13:42.15,0:13:44.44,Default,,0,0,0,,Не... неге?
Dialogue: 0,0:13:46.24,0:13:48.07,Default,,0,0,0,,Өйткені олар бірдей
Dialogue: 0,0:13:49.03,0:13:50.83,Default,,0,0,0,,Ата-анам қайтыс болғаннан кейін...
Dialogue: 0,0:13:51.12,0:13:53.20,Default,,0,0,0,,Мені ешкім мақтамайды...
Dialogue: 0,0:13:53.20,0:13:56.00,Default,,0,0,0,,Енді мені қабылдайтын ешкім жоқ.
Dialogue: 0,0:13:57.33,0:14:01.09,Default,,0,0,0,,Мен нашар оқитынмын және сабақта өзімді жиі ақымақ ететінмін.
Dialogue: 0,0:14:02.59,0:14:05.05,Default,,0,0,0,,Себебі мен адамдардың назарын аударғым келді...
Dialogue: 0,0:14:05.55,0:14:08.51,Default,,0,0,0,,Өйткені мен талантты болдым және адамдардың назарын аудармадым...
Dialogue: 0,0:14:09.30,0:14:11.43,Default,,0,0,0,,Осы уақыт бойы мен ақымақтық жасадым.
Dialogue: 0,0:14:14.85,0:14:16.02,Default,,0,0,0,,Бұл ауыр болды.
Dialogue: 0,0:14:18.19,0:14:20.69,Default,,0,0,0,,Дұрыс, Наруто...
Dialogue: 0,0:14:21.36,0:14:23.94,Default,,0,0,0,,Мен жалғыз болған шығармын...
Dialogue: 0,0:14:24.57,0:14:26.65,Default,,0,0,0,,Бұл ауырған болуы керек...
Dialogue: 0,0:14:27.78,0:14:29.70,Default,,0,0,0,,Кешіріңіз Наруто...
Dialogue: 0,0:14:30.28,0:14:35.87,Default,,0,0,0,,Егер мен қаттырақ болсам, сені бұлай сездірмес едім...
Dialogue: 0,0:14:36.75,0:14:39.08,Default,,0,0,0,,Фухаха...
Dialogue: 0,0:14:39.08,0:14:40.63,Default,,0,0,0,,Маған күлесің!
Dialogue: 0,0:14:40.83,0:14:45.42,Default,,0,0,0,,Ата-анасын өлтіргеніңіз үшін Ирука сізді әрқашан жек көреді.
Dialogue: 0,0:14:45.92,0:14:49.93,Default,,0,0,0,,Мен жай ғана артқа айналдырғым келеді.
Dialogue: 0,0:14:50.14,0:14:51.01,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:53.18,0:14:54.06,Default,,0,0,0,,Наруто
Dialogue: 0,0:14:55.81,0:14:57.81,Default,,0,0,0,,Наруто!
Dialogue: 0,0:14:58.69,0:14:59.56,Default,,0,0,0,,Хаха...
Dialogue: 0,0:15:00.27,0:15:03.19,Default,,0,0,0,,​​Наруто өз ойын өзгертетін жігіт емес.
Dialogue: 0,0:15:04.27,0:15:07.74,Default,,0,0,0,,Сол шиыршықпен осы ауылдың кегін аламын.
Dialogue: 0,0:15:08.82,0:15:12.91,Default,,0,0,0,,Ол жігіттің көзін бұрын көрдіңіз бе?Бұл елес түлкінің көзі.
Dialogue: 0,0:15:14.16,0:15:15.12,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:15.95,0:15:16.91,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:15:17.16,0:15:21.42,Default,,0,0,0,,Наруто... ондай жігіт емес!
Dialogue: 0,0:15:21.96,0:15:22.67,Default,,0,0,0,,Хмф!
Dialogue: 0,0:15:23.96,0:15:27.63,Default,,0,0,0,,Нарутодан құтылып, сол шиыршықты алғаныңызша, бұл жақсы.
Dialogue: 0,0:15:28.42,0:15:30.30,Default,,0,0,0,,Сіз екінші жағындасыз.
Dialogue: 0,0:15:30.34,0:15:31.26,Default,,0,0,0,,Гррр…
Dialogue: 0,0:15:31.26,0:15:32.51,Default,,0,0,0,,《Маған істеуге рұқсат етіңіз》
Dialogue: 0,0:15:35.81,0:15:37.18,Default,,0,0,0,,《О, менің...》
Dialogue: 0,0:15:37.60,0:15:39.85,Default,,0,0,0,,《Мидзуки жігіті, сөйлес!》
Dialogue: 0,0:15:40.19,0:15:43.23,Default,,0,0,0,,《Наруто бұрынғыдан да тұрақсыз...》
Dialogue: 0,0:15:43.44,0:15:47.11,Default,,0,0,0,,《Ол техникамен басылған қуатты босатуы мүмкін.》
Dialogue: 0,0:15:47.40,0:15:52.16,Default,,0,0,0,,《Егер сенің де қолыңда Мөрлер кітабы болса...》
Dialogue: 0,0:15:52.32,0:15:54.20,Default,,0,0,0,,《Пломбаны өз бетіңізше сындырыңыз――
Dialogue: 0,0:15:54.28,0:15:59.83,Default,,0,0,0,,Тоғыз құйрықты түлкінің пайда болу мүмкіндігі бар, бірақ ол ойға келеді...
Dialogue: 0,0:16:00.37,0:16:01.79,Default,,0,0,0,,《Ол кезде...》
Dialogue: 0,0:16:04.42,0:16:05.38,Default,,0,0,0,,《Мен оны таптым!》
Dialogue: 0,0:16:07.34,0:16:08.25,Default,,0,0,0,,Наруто!
Dialogue: 0,0:16:08.38,0:16:10.55,Default,,0,0,0,,Мизукидің бұрын айтқандары - бос сөз.
Dialogue: 0,0:16:10.55,0:16:12.76,Default,,0,0,0,,Тезірек маған шиыршықты беріңіз.
Dialogue: 0,0:16:12.76,0:16:14.84,Default,,0,0,0,,Мизуки шиыршыққа ұмтылуда!
Dialogue: 0,0:16:15.64,0:16:16.51,Default,,0,0,0,,Даа!
Dialogue: 0,0:16:17.10,0:16:17.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:21.89,0:16:22.77,Default,,0,0,0,,Аһ!
Dialogue: 0,0:16:26.31,0:16:29.15,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:16:30.24,0:16:32.07,Default,,0,0,0,,О... міне...
Dialogue: 0,0:16:34.28,0:16:35.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:37.66,0:16:40.37,Default,,0,0,0,,Неліктен?наруто
Dialogue: 0,0:16:42.08,0:16:43.12,Default,,0,0,0,,Неге...
Dialogue: 0,0:16:44.62,0:16:46.75,Default,,0,0,0,,Оның дельфин емес екенін білдіңіз бе?
Dialogue: 0,0:16:46.79,0:16:48.80,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:16:50.55,0:16:52.59,Default,,0,0,0,,Ирука менмін
Dialogue: 0,0:16:54.22,0:16:55.59,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:57.97,0:17:01.35,Default,,0,0,0,,Ата-анаңның жауы болса да оны қорғаудың мәні неде?
Dialogue: 0,0:17:01.68,0:17:05.27,Default,,0,0,0,,Мен шиыршықты сен сияқты ақымаққа бермеймін.
Dialogue: 0,0:17:05.73,0:17:07.31,Default,,0,0,0,,Сен ақымақсың
Dialogue: 0,0:17:07.61,0:17:10.11,Default,,0,0,0,,Наруто менімен бірдей.
Dialogue: 0,0:17:11.07,0:17:12.07,Default,,0,0,0,,Дәл солай ма?
Dialogue: 0,0:17:12.49,0:17:16.28,Default,,0,0,0,,Егер сіз айналдыру техникасын қолдансаңыз, қалағаныңызды жасай аласыз.
Dialogue: 0,0:17:16.45,0:17:17.49,Default,,0,0,0,,Наруто...
Dialogue: 0,0:17:18.28,0:17:22.08,Default,,0,0,0,,Құбыжық түлкі шиыршықтың күшін пайдаланбауы мүмкін емес.
Dialogue: 0,0:17:22.58,0:17:24.25,Default,,0,0,0,,А, бұл дұрыс...
Dialogue: 0,0:17:26.62,0:17:29.63,Default,,0,0,0,,《Ке!Өйткені, бұл дұрыс》
Dialogue: 0,0:17:30.13,0:17:31.09,Default,,0,0,0,,《Қараңдар...》
Dialogue: 0,0:17:31.09,0:17:36.55,Default,,0,0,0,,《Тіпті Ирука-сенсей де мені қабылдамайды...》
Dialogue: 0,0:17:36.55,0:17:38.14,Default,,0,0,0,,Егер бұл елес түлкі болса
Dialogue: 0,0:17:38.14,0:17:38.72,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:40.26,0:17:42.43,Default,,0,0,0,,Бірақ Наруто басқаша.
Dialogue: 0,0:17:42.43,0:17:43.39,Default,,0,0,0,,Ол жігіт...
Dialogue: 0,0:17:44.39,0:17:47.60,Default,,0,0,0,,Бұл адам мен мойындаған үздік студент.
Dialogue: 0,0:17:48.44,0:17:51.07,Default,,0,0,0,,Еңбекқор және бірбеткей...
Dialogue: 0,0:17:51.90,0:17:56.36,Default,,0,0,0,,Осыған қарамастан, мен ебедеймін және мені ешкім қабылдамайды...
Dialogue: 0,0:17:57.32,0:18:00.20,Default,,0,0,0,,Ол адамдардың жүрегіндегі дертті біледі.
Dialogue: 0,0:18:00.58,0:18:02.95,Default,,0,0,0,,Ол құбыжық түлкі емес
Dialogue: 0,0:18:03.04,0:18:05.66,Default,,0,0,0,,Бұл Коноха ауылынан келген Наруто Узумаки.
Dialogue: 0,0:18:09.71,0:18:12.34,Default,,0,0,0,,Ke!Құттықтаймын, бейбақ.
Dialogue: 0,0:18:12.75,0:18:17.09,Default,,0,0,0,,Дельфин!Мен сені кейінге қалдырғым келді, бірақ тоқтадым.
Dialogue: 0,0:18:17.43,0:18:19.22,Default,,0,0,0,,Тезірек өл!
Dialogue: 0,0:18:20.76,0:18:22.22,Default,,0,0,0,,《Әзірге...》
Dialogue: 0,0:18:22.85,0:18:24.06,Default,,0,0,0,,Уау!Ахх...
Dialogue: 0,0:18:29.69,0:18:30.61,Default,,0,0,0,,《Наруто!?》
Dialogue: 0,0:18:33.36,0:18:35.32,Default,,0,0,0,,Сіз мұны істей аласыз, солай ма?
Dialogue: 0,0:18:36.49,0:18:39.41,Default,,0,0,0,,Ирука-сенсеймен араласпа
Dialogue: 0,0:18:39.95,0:18:40.99,Default,,0,0,0,,I'll kill you
Dialogue: 0,0:18:41.57,0:18:42.62,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:18:43.08,0:18:46.20,Default,,0,0,0,,Мен сен сияқты баланы бір жұдырықтан теуіп жіберемін.
Dialogue: 0,0:18:46.75,0:18:48.50,Default,,0,0,0,,Байқап көріңіз, масқара!
Dialogue: 0,0:18:48.79,0:18:51.29,Default,,0,0,0,,Мен саған мың есе артық қайтарамын.
Dialogue: 0,0:18:51.29,0:18:55.63,Default,,0,0,0,,Қолыңнан келсе, істе!Құбыжық түлкі!
Dialogue: 0,0:18:56.21,0:18:58.01,Default,,0,0,0,,Shadow Bunshin no Jutsu!
Dialogue: 0,0:19:07.23,0:19:09.19,Default,,0,0,0,,《Наруто сен...》
Dialogue: 0,0:19:09.60,0:19:11.19,Default,,0,0,0,,《Көлеңке Буншин но Джуцу》
Dialogue: 0,0:19:12.11,0:19:15.61,Default,,0,0,0,,《Заттың өзін жасайтын жетілдірілген ниндзюцу!》
Dialogue: 0,0:19:17.65,0:19:18.61,Default,,0,0,0,,Не!?
Dialogue: 0,0:19:18.90,0:19:25.08,Default,,0,0,0,,Не болды >>Кәне!
Dialogue: 0,0:19:25.41,0:19:26.54,Default,,0,0,0,,Олай болса >> Содан кейін
Dialogue: 0,0:19:26.54,0:19:28.20,Default,,0,0,0,,Осы жерден кетейік!
Dialogue: 0,0:19:28.37,0:19:32.38,Default,,0,0,0,,Ахх... Уау!
Dialogue: 0,0:19:39.42,0:19:40.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:42.30,0:19:44.05,Default,,0,0,0,,Хехехе
Dialogue: 0,0:19:44.05,0:19:46.01,Default,,0,0,0,,Мен тым алысқа кеттім...
Dialogue: 0,0:19:46.60,0:19:48.81,Default,,0,0,0,,Ирука-сенсей, жақсысың ба?
Dialogue: 0,0:19:49.02,0:19:50.77,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:19:51.98,0:19:53.61,Default,,0,0,0,,《Бұл үлкен мәселе》
Dialogue: 0,0:19:54.06,0:19:57.90,Default,,0,0,0,,《Бұл жігіт шынымен де кез келген Хокадж болуы мүмкін...》
Dialogue: 0,0:19:58.74,0:20:00.57,Default,,0,0,0,,Аа...
Dialogue: 0,0:20:00.82,0:20:01.82,Default,,0,0,0,,Наруто
Dialogue: 0,0:20:01.86,0:20:03.24,Default,,0,0,0,,Бір секундқа осында келіңіз.
Dialogue: 0,0:20:03.49,0:20:05.62,Default,,0,0,0,,Менің саған бергім келетін бір нәрсем бар.
Dialogue: 0,0:20:08.54,0:20:10.83,Default,,0,0,0,,Нарутоны таптыңыз ба?
Dialogue: 0,0:20:10.96,0:20:11.75,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:20:12.04,0:20:15.13,Default,,0,0,0,,Қарғыс атсын!Қорқынышты нәрсе болды.
Dialogue: 0,0:20:15.88,0:20:18.00,Default,,0,0,0,,Енді уайымдамаңыз
Dialogue: 0,0:20:18.00,0:20:18.55,Default,,0,0,0,,Әй?
Dialogue: 0,0:20:19.26,0:20:20.38,Default,,0,0,0,,Хокаге-сама
Dialogue: 0,0:20:21.47,0:20:24.47,Default,,0,0,0,,Ол жақында оралады...
Dialogue: 0,0:20:25.39,0:20:27.76,Default,,0,0,0,,Мұғалімсіз бе?
Dialogue: 0,0:20:28.01,0:20:30.43,Default,,0,0,0,,Жарайды!Сіз қазір көзіңізді аша аласыз.
Dialogue: 0,0:20:41.82,0:20:44.82,Default,,0,0,0,,Мектеп бітіру... Құттықтаймыз
Dialogue: 0,0:20:49.99,0:20:52.21,Default,,0,0,0,,Жарайды, бұл мектеп бітіруге арналған сыйлық.
Dialogue: 0,0:20:52.62,0:20:54.75,Default,,0,0,0,,Мен саған рамен сатып аламын.
Dialogue: 0,0:21:00.05,0:21:00.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:01.55,0:21:02.72,Default,,0,0,0,,Ирука Сенсей!
Dialogue: 0,0:21:02.72,0:21:04.80,Default,,0,0,0,,Уау! Ауырды, эй!
Dialogue: 0,0:21:05.64,0:21:06.93,Default,,0,0,0,,《Наруто》
Dialogue: 0,0:21:07.01,0:21:11.47,Default,,0,0,0,,《Шинобу үшін нағыз қиыншылық қазірден бастап――》
Dialogue: 0,0:21:11.52,0:21:13.52,Default,,0,0,0,,《Уағыз айтайын деп едім, бірақ...》
Dialogue: 0,0:21:13.73,0:21:18.48,Default,,0,0,0,,《Ал, мен рамен дүкеніне дейін күтемін.》
Dialogue: 0,0:22:52.70,0:22:55.20,Default,,0,0,0,,Жоқ... не болды, кішкентай жігіт!
Dialogue: 0,0:22:55.20,0:22:56.83,Default,,0,0,0,,Адамдарға ермеңіз!
Dialogue: 0,0:22:56.83,0:23:00.58,Default,,0,0,0,,Не керек, мен кішкентай болсам да, Бесінші Хокаге боламын!?
Dialogue: 0,0:23:00.58,0:23:01.83,Default,,0,0,0,,Эй!
Dialogue: 0,0:23:01.83,0:23:04.34,Default,,0,0,0,,Мен Хокаге атасының немересімін, бірақ ол туралы ештеңе білмеймін.
Dialogue: 0,0:23:04.34,0:23:07.55,Default,,0,0,0,,Өзіңді Хокаге, Барса деп атау оңай емес.
Dialogue: 0,0:23:07.55,0:23:11.47,Default,,0,0,0,,Осыншама қаласаң, мені ұрған соң істеу керек!
Dialogue: 0,0:23:11.64,0:23:13.93,Default,,0,0,0,,Келесі жолы бұл Конохамару!
Dialogue: 0,0:23:14.14,0:23:17.10,Default,,0,0,0,,Мен қайтадан белсенді боламын.
Dialogue: 0,0:23:18.60,0:23:23.60,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
