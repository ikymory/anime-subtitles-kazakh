Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,(Бидайдың дірілдеген дыбысы)
Dialogue: 0,0:00:08.34,0:00:10.34,Default,,0,0,0,,Торс!
Dialogue: 0,0:00:10.34,0:00:12.84,Default,,0,0,0,,Ооо!!
Dialogue: 0,0:00:12.84,0:00:15.34,Default,,0,0,0,,Уф!Гуаааа!
Dialogue: 0,0:00:15.34,0:00:18.18,Default,,0,0,0,,Таа!Апыр-ай!
Dialogue: 0,0:00:18.18,0:00:20.85,Default,,0,0,0,,Таа~!Хаха….
Dialogue: 0,0:00:20.85,0:00:24.02,Default,,0,0,0,,Уууу!
Dialogue: 0,0:00:24.02,0:00:26.02,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:00:26.02,0:00:29.36,Default,,0,0,0,,(Торц) Торкелл, сіз дәл Флоки жиналған жердесіз➡
Dialogue: 0,0:00:29.36,0:00:31.53,Default,,0,0,0,,Алдыңғы жағын бірден алға итеріңіз.
Dialogue: 0,0:00:31.53,0:00:34.53,Default,,0,0,0,,Бұл сүйек басы...
Dialogue: 0,0:00:34.53,0:00:37.03,Default,,0,0,0,,Жарайды, бірақ сен ше?
Dialogue: 0,0:00:37.03,0:00:39.37,Default,,0,0,0,,Жауды тоқтатыңыз.
Dialogue: 0,0:00:39.37,0:00:41.37,Default,,0,0,0,,Тоқта дейсіз➡
Dialogue: 0,0:00:41.37,0:00:44.87,Default,,0,0,0,,Сіз бұл деңгейге қалай жеттіңіз...?
Dialogue: 0,0:00:44.87,0:00:49.88,Default,,0,0,0,,О, сен ептісің, солай емес пе?
Dialogue: 0,0:00:53.38,0:00:55.88,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:00:57.89,0:00:59.89,Default,,0,0,0,,(бұршақтың дыбысы)
Dialogue: 0,0:00:59.89,0:01:06.83,Default,,0,0,0,,♬～
Dialogue: 0,0:01:06.83,0:01:09.03,Default,,0,0,0,,Ха!?
Dialogue: 0,0:01:11.00,0:01:13.67,Default,,0,0,0,,Келіңіздер!Ха!
Dialogue: 0,0:01:13.67,0:01:22.88,Default,,0,0,0,,♬～
Dialogue: 0,0:01:35.19,0:01:38.19,Default,,0,0,0,,(Каване)
Dialogue: 0,0:01:42.03,0:01:45.13,Default,,0,0,0,,Ммм... мммммм.
Dialogue: 0,0:01:47.20,0:01:51.37,Default,,0,0,0,,Ммм….
Dialogue: 0,0:01:51.37,0:02:24.51,Default,,0,0,0,,♬～
Dialogue: 0,0:02:24.51,0:02:26.51,Default,,0,0,0,,(Мизуон)
Dialogue: 0,0:02:26.51,0:02:31.18,Default,,0,0,0,,(Юрва) А, Торфинннн, мен қойға тамақ пен сүт алғым келеді.Иә.
Dialogue: 0,0:02:31.18,0:02:34.02,Default,,0,0,0,,(қой малау)
Dialogue: 0,0:02:34.02,0:02:37.02,Default,,0,0,0,,Уау!?
Dialogue: 0,0:02:37.02,0:02:39.52,Default,,0,0,0,,(қой малау)
Dialogue: 0,0:02:41.86,0:02:45.06,Default,,0,0,0,,Мен... хмм.
Dialogue: 0,0:02:47.36,0:02:51.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:51.70,0:02:55.60,Default,,0,0,0,,(Терн жылау)
Dialogue: 0,0:02:59.37,0:03:03.15,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:03:03.15,0:03:08.35,Default,,0,0,0,,♬～
Dialogue: 0,0:03:13.49,0:03:15.66,Default,,0,0,0,,(Боранның дыбысы)
Dialogue: 0,0:03:15.66,0:03:21.00,Default,,0,0,0,,(Лейф) Марклендтен шығып, біздің кемелер оңтүстікке қарай жүзіп кетті.
Dialogue: 0,0:03:21.00,0:03:23.67,Default,,0,0,0,,«Байрақ жер бар» ➡
Dialogue: 0,0:03:23.67,0:03:27.84,Default,,0,0,0,,Жел маған осылай айтты.Ха!
Dialogue: 0,0:03:27.84,0:03:30.14,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:03:35.51,0:03:38.01,Default,,0,0,0,,Бүркіт оны тапты.
Dialogue: 0,0:03:40.18,0:03:42.38,Default,,0,0,0,,Жаңа континент.
Dialogue: 0,0:03:48.69,0:03:54.03,Default,,0,0,0,,Жемісі піскен, шалғынды толқындар жаңа жер.
Dialogue: 0,0:03:54.03,0:03:57.13,Default,,0,0,0,,Бүркіт елді атады.
Dialogue: 0,0:04:04.47,0:04:09.81,Default,,0,0,0,,Ол жердің аты «Винланд».
Dialogue: 0,0:04:09.81,0:04:13.48,Default,,0,0,0,,(Лейф) Сооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооо!
Dialogue: 0,0:04:13.48,0:04:17.15,Default,,0,0,0,,Сіз Лейф Эриксонға аздап қарадыңыз ба?
Dialogue: 0,0:04:17.15,0:04:19.82,Default,,0,0,0,,Сонымен... бұл керемет, Лейфтің ағасы!
Dialogue: 0,0:04:19.82,0:04:21.82,Default,,0,0,0,,Міне, солай!? Біреу болды ма?
Dialogue: 0,0:04:21.82,0:04:24.83,Default,,0,0,0,,Жылы болды ма?Ол Исландиядан үлкен бе?
Dialogue: 0,0:04:24.83,0:04:28.50,Default,,0,0,0,,Келіңіздер, мұндағыдан әлдеқайда жылырақ➡
Dialogue: 0,0:04:28.50,0:04:31.00,Default,,0,0,0,,Шөптің бәрі қалың болып өсті.
Dialogue: 0,0:04:31.00,0:04:35.00,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:04:35.00,0:04:38.67,Default,,0,0,0,,Біз жергілікті тұрғындармен де кездестік.
Dialogue: 0,0:04:38.67,0:04:43.01,Default,,0,0,0,,Бір тілде сөйлемесек те, тез достасып кеттік.
Dialogue: 0,0:04:43.01,0:04:47.85,Default,,0,0,0,,Бұл шлейфтер мен құбырлар солардың сыйы.
Dialogue: 0,0:04:47.85,0:04:50.52,Default,,0,0,0,,Тыңдаңыз, бұл жігіт ше➡
Dialogue: 0,0:04:50.52,0:04:54.52,Default,,0,0,0,,Оны тек нағыз жауынгерлер кие алады.
Dialogue: 0,0:04:57.03,0:04:59.13,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:05:01.30,0:05:03.63,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:03.63,0:05:06.80,Default,,0,0,0,,Не, балалар әлі ояу ма?
Dialogue: 0,0:05:06.80,0:05:08.80,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:05:08.80,0:05:11.64,Default,,0,0,0,,Мен сізге Лейф-санның оқиғасын айтқым келді...
Dialogue: 0,0:05:11.64,0:05:15.81,Default,,0,0,0,,Нағыз жауынгер... Қарт ғажап.
Dialogue: 0,0:05:15.81,0:05:18.81,Default,,0,0,0,,Не?Жақсы бала, Торфинннн➡
Dialogue: 0,0:05:18.81,0:05:21.65,Default,,0,0,0,,Өскенде қыранның қайығына мінесің бе?
Dialogue: 0,0:05:21.65,0:05:23.82,Default,,0,0,0,,Эх!Маған қазір апарыңыз!
Dialogue: 0,0:05:23.82,0:05:27.16,Default,,0,0,0,,Енді... Бірақ бұл біртүрлі, Лейф.
Dialogue: 0,0:05:27.16,0:05:29.82,Default,,0,0,0,,Өйткені атам солай айтқан.
Dialogue: 0,0:05:29.82,0:05:31.99,Default,,0,0,0,,Батыста Джормунганд➡
Dialogue: 0,0:05:31.99,0:05:34.50,Default,,0,0,0,,Ол жақындаған барлық кемелерді жейді.
Dialogue: 0,0:05:34.50,0:05:37.33,Default,,0,0,0,,Бұдан басқа ештеңе жоқ.
Dialogue: 0,0:05:37.33,0:05:42.50,Default,,0,0,0,,Да~қара~ра!Сондықтан менің қаншалықты ұлы екенімді түсінесіз.
Dialogue: 0,0:05:42.50,0:05:45.84,Default,,0,0,0,,Қараңдар, қараңдар, бұл нағыз жауынгердің дәлелі...
Dialogue: 0,0:05:45.84,0:05:48.68,Default,,0,0,0,,Менің ойымша, Лейф жауынгер емес.
Dialogue: 0,0:05:48.68,0:05:50.68,Default,,0,0,0,,А, мен түсінбеймін.
Dialogue: 0,0:05:50.68,0:05:53.68,Default,,0,0,0,,Майданда тек жауынгерлер ғана жұмыс істемейді.
Dialogue: 0,0:05:53.68,0:05:57.85,Default,,0,0,0,,Теңізшілер теңізде соғысады.Бұл керемет.
Dialogue: 0,0:05:57.85,0:05:59.96,Default,,0,0,0,,Хи хи хи.... Күткендей.
Dialogue: 0,0:05:59.96,0:06:02.29,Default,,0,0,0,,⚟Сәлем.иә?Бұл не?
Dialogue: 0,0:06:02.29,0:06:06.29,Default,,0,0,0,,Бәрі де қарияны сақалды бала дейді.
Dialogue: 0,0:06:06.29,0:06:09.30,Default,,0,0,0,,Мұның бәрі шытырман оқиғалар туралы және шайқаста ешқандай пайдасы жоқ.
Dialogue: 0,0:06:09.30,0:06:12.13,Default,,0,0,0,,Тауық!Айналаңыздағылардың сыпырып кетуі➡
Dialogue: 0,0:06:12.13,0:06:14.97,Default,,0,0,0,,Мен Торфиннннге сенемін...
Dialogue: 0,0:06:14.97,0:06:18.64,Default,,0,0,0,,А... Сонда бұл Нани ме?
Dialogue: 0,0:06:18.64,0:06:21.81,Default,,0,0,0,,Соғысқа бармайтын шытырман адам осылай дейді➡
Dialogue: 0,0:06:21.81,0:06:23.98,Default,,0,0,0,,Маған сене алмайсың ба?
Dialogue: 0,0:06:23.98,0:06:29.28,Default,,0,0,0,,Әкем жауынгер болса, рас...
Dialogue: 0,0:06:31.65,0:06:33.99,Default,,0,0,0,,Иә.
Dialogue: 0,0:06:33.99,0:06:36.99,Default,,0,0,0,,Торс!Бұл жігіттерді мазақ етпе!
Dialogue: 0,0:06:36.99,0:06:39.33,Default,,0,0,0,,«Биші!»деңіз.
Dialogue: 0,0:06:39.33,0:06:41.50,Default,,0,0,0,,Міне, бүгінгі уақыт келді.(қол шапалақтау дыбысы)
Dialogue: 0,0:06:41.50,0:06:45.17,Default,,0,0,0,,(Балалар) Иә.Баршаңызды жіберіңізші.
Dialogue: 0,0:06:45.17,0:06:47.50,Default,,0,0,0,,Иә, Торс мырза.
Dialogue: 0,0:06:47.50,0:06:50.17,Default,,0,0,0,,Жақында кездескенше!Сонда кездескенше!
Dialogue: 0,0:06:50.17,0:06:55.38,Default,,0,0,0,,(Боранның дыбысы)
Dialogue: 0,0:07:06.79,0:07:11.13,Default,,0,0,0,,(Торс) Мен түсінемін.Гренландияда тоңып өлген адамдар бар...
Dialogue: 0,0:07:11.13,0:07:15.63,Default,,0,0,0,,Биылғы суық толқын да қатты болып, көп мал қырылады...
Dialogue: 0,0:07:15.63,0:07:20.47,Default,,0,0,0,,Дегенмен, мәселе жыл өткен сайын салқындауында.
Dialogue: 0,0:07:20.47,0:07:22.47,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:07:22.47,0:07:26.64,Default,,0,0,0,,Ух... Саби~!
Dialogue: 0,0:07:26.64,0:07:28.81,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:07:28.81,0:07:31.65,Default,,0,0,0,,Осы екеуі ғана әлсіз болды.
Dialogue: 0,0:07:31.65,0:07:34.15,Default,,0,0,0,,Уау, суық болды, Юрва-чан.
Dialogue: 0,0:07:34.15,0:07:37.65,Default,,0,0,0,,Ағай сізді жылытады.Ақымақ қария!
Dialogue: 0,0:07:37.65,0:07:40.66,Default,,0,0,0,,Анашым, жатыңыз. Тағы да суық тиіп қаласыз ба?
Dialogue: 0,0:07:40.66,0:07:44.86,Default,,0,0,0,,Жарайды. Маған қойларды байлауға көмектес.Иә.
Dialogue: 0,0:07:47.83,0:07:52.33,Default,,0,0,0,,Бұл жерде де қиын болатын сияқты.Жақсы.
Dialogue: 0,0:07:52.33,0:07:56.84,Default,,0,0,0,,(Лейф) Ешкім шыдамайтын қыс келуі мүмкін.
Dialogue: 0,0:07:56.84,0:08:01.78,Default,,0,0,0,,Бүркіттер елінде інім қазір көшіп кетуді жоспарлап жүр.
Dialogue: 0,0:08:01.78,0:08:04.95,Default,,0,0,0,,Ол алыс емес пе?
Dialogue: 0,0:08:04.95,0:08:10.12,Default,,0,0,0,,Ей... бүркіт ары-бері жүрді.
Dialogue: 0,0:08:10.12,0:08:13.79,Default,,0,0,0,,♬～
Dialogue: 0,0:08:13.79,0:08:17.63,Default,,0,0,0,,｟Алға қарай жүріңіз~ Винланд дәл сол жерде~!
Dialogue: 0,0:08:17.63,0:08:20.30,Default,,0,0,0,,(Теңізші А) Капитан Торфиннннн!Не!
Dialogue: 0,0:08:20.30,0:08:22.96,Default,,0,0,0,,Джормунганд!
Dialogue: 0,0:08:22.96,0:08:26.80,Default,,0,0,0,,Хмм, кел, құбыжық!(Теңізшілер) О!
Dialogue: 0,0:08:26.80,0:08:30.47,Default,,0,0,0,,Уф уаааааааааааааааааааааааааааааааа...
Dialogue: 0,0:08:30.47,0:08:33.98,Default,,0,0,0,,Ммммммм!Ауырсыну...
Dialogue: 0,0:08:33.98,0:08:37.48,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:37.48,0:08:40.82,Default,,0,0,0,,Әпке!Төсегіңізге барыңыз!Бұл кішкентай!
Dialogue: 0,0:08:40.82,0:08:43.82,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:08:43.82,0:08:47.49,Default,,0,0,0,,Бұл жасырын!Мен бұл төсекті жылытқан шығармын...
Dialogue: 0,0:08:47.49,0:08:52.59,Default,,0,0,0,,А... біз әлі сөйлесеміз.
Dialogue: 0,0:08:54.66,0:08:59.50,Default,,0,0,0,,Уайымдаудың қажеті жоқ. Уайымдау – ересек адамның ісі.
Dialogue: 0,0:08:59.50,0:09:01.44,Default,,0,0,0,,Олай болса, келіңіз~➡
Dialogue: 0,0:09:01.44,0:09:04.11,Default,,0,0,0,,Менің әпкем сені ұстайды!Уау!
Dialogue: 0,0:09:04.11,0:09:11.28,Default,,0,0,0,,♬～
Dialogue: 0,0:09:11.28,0:09:13.62,Default,,0,0,0,,Әй, ана!
Dialogue: 0,0:09:13.62,0:09:17.79,Default,,0,0,0,,Әй, әке, біз неге құл сатып алмаймыз?
Dialogue: 0,0:09:17.79,0:09:21.79,Default,,0,0,0,,Менің анам әлсіз, сондықтан мен оған көмектесуім керек...
Dialogue: 0,0:09:21.79,0:09:25.96,Default,,0,0,0,,Жыл сайын ``The Other Side'' тыңдамаңыз.
Dialogue: 0,0:09:25.96,0:09:33.30,Default,,0,0,0,,Хмм... Мен біртүрлімін.Ахх.
Dialogue: 0,0:09:33.30,0:09:35.97,Default,,0,0,0,,О!?О!
Dialogue: 0,0:09:35.97,0:09:37.97,Default,,0,0,0,,Юрва!
Dialogue: 0,0:09:37.97,0:09:41.81,Default,,0,0,0,,Уау... Мен өлемін деп ойладым.
Dialogue: 0,0:09:41.81,0:09:45.31,Default,,0,0,0,,Сіз жарақат алдыңыз ба?Иә.Хмм?
Dialogue: 0,0:09:45.31,0:09:49.48,Default,,0,0,0,,Не болды?Мына жерде бірдеңе...
Dialogue: 0,0:09:49.48,0:09:52.65,Default,,0,0,0,,Ах!Ммммммм….Юрва?
Dialogue: 0,0:09:52.65,0:09:55.06,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:09:56.99,0:09:58.99,Default,,0,0,0,,Ах!?
Dialogue: 0,0:09:58.99,0:10:02.60,Default,,0,0,0,,Ха… ха….
Dialogue: 0,0:10:15.34,0:10:19.51,Default,,0,0,0,,(теңіз құстарының айқайы)
Dialogue: 0,0:10:19.51,0:10:23.69,Default,,0,0,0,,(Торфинннн) Ей, қария, кешегі әңгіменің қаншалықты рас?
Dialogue: 0,0:10:23.69,0:10:26.86,Default,,0,0,0,,Сіз нені айтасыз? Мұның бәрі рас.
Dialogue: 0,0:10:26.86,0:10:31.69,Default,,0,0,0,,Олай болса, мені осы кемеге отырғыз. Мен өз көзіммен көргенде сенемін.
Dialogue: 0,0:10:31.69,0:10:35.86,Default,,0,0,0,,Идиот, мен бұған сенемін деп айтпаймын.
Dialogue: 0,0:10:35.86,0:10:39.70,Default,,0,0,0,,Егер сіз қайыққа мінгіңіз келсе, әкеңізден сізді кемеге отырғызуын сұраңыз. Міне➡
Dialogue: 0,0:10:39.70,0:10:43.71,Default,,0,0,0,,Ол жерде де әскери кеме бар.Ауылда ұрпақтан-ұрпаққа қолданылған көрінеді➡
Dialogue: 0,0:10:43.71,0:10:46.88,Default,,0,0,0,,Әкең оны саған қарызға беруге қуанышты болар еді.
Dialogue: 0,0:10:46.88,0:10:52.05,Default,,0,0,0,,Хм... Әке сараң. Қанша сұрасам да жұмыс істемейді.
Dialogue: 0,0:10:52.05,0:10:55.38,Default,,0,0,0,,Сараңдыққа ұқсамайды.
Dialogue: 0,0:10:55.38,0:11:00.15,Default,,0,0,0,,Мұндағы теңіз, Торфинннн, қорқынышты.
Dialogue: 0,0:11:00.15,0:11:04.83,Default,,0,0,0,,Бүркіт жас кезінде бірде мұз құрсауында қалып қойған.
Dialogue: 0,0:11:04.83,0:11:08.16,Default,,0,0,0,,Мен Гренландияға жаңа ғана көшіп келген едім➡
Dialogue: 0,0:11:08.16,0:11:10.16,Default,,0,0,0,,Мен есін жоғалттым.
Dialogue: 0,0:11:10.16,0:11:12.50,Default,,0,0,0,,Тамақ тез таусылды➡
Dialogue: 0,0:11:12.50,0:11:15.84,Default,,0,0,0,,Мен күйзелістен құтылу үшін мұз жедім.
Dialogue: 0,0:11:15.84,0:11:19.17,Default,,0,0,0,,Соңында кемені мұз басып қалды➡
Dialogue: 0,0:11:19.17,0:11:23.51,Default,,0,0,0,,Бүркіттер теңізде шарасыз жүрді...
Dialogue: 0,0:11:23.51,0:11:26.01,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:11:26.01,0:11:29.32,Default,,0,0,0,,Оянсам, тек қыран ғана екен.
Dialogue: 0,0:11:31.35,0:11:34.56,Default,,0,0,0,,Алты сахаба да қайтыс болды.
Dialogue: 0,0:11:38.86,0:11:41.20,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:11:41.20,0:11:47.60,Default,,0,0,0,,Неліктен біз солтүстік аралда өмір сүру үшін соншалықты ұзаққа барамыз?
Dialogue: 0,0:11:50.21,0:11:52.71,Default,,0,0,0,,Хельга!Суды қайнатыңыз!
Dialogue: 0,0:11:52.71,0:11:56.21,Default,,0,0,0,,Юрва Бұл жүн.(Юрва) Иә!
Dialogue: 0,0:11:56.21,0:11:59.61,Default,,0,0,0,,(Хельга) Жоқ, не болды?Оны қар басып қалды.
Dialogue: 0,0:12:08.66,0:12:11.66,Default,,0,0,0,,Уау, ауырады... Бұл не?
Dialogue: 0,0:12:11.66,0:12:15.16,Default,,0,0,0,,Отты күшейт.
Dialogue: 0,0:12:15.16,0:12:19.67,Default,,0,0,0,,(Юрва) Әй, әке, ол өлген жоқ па?
Dialogue: 0,0:12:19.67,0:12:25.84,Default,,0,0,0,,Ол кісінің аяқ-қолы шіріген, дәлірек айтсақ, жиіркенішті...
Dialogue: 0,0:12:25.84,0:12:28.51,Default,,0,0,0,,Ол бұл ауылдан емес...
Dialogue: 0,0:12:28.51,0:12:32.35,Default,,0,0,0,,Бейшара, сен неге сонша борандасың?
Dialogue: 0,0:12:32.35,0:12:35.52,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:12:35.52,0:12:40.69,Default,,0,0,0,,Ол қашқан құл... Жасырсақ, бәле болады.
Dialogue: 0,0:12:40.69,0:12:45.69,Default,,0,0,0,,♬～
Dialogue: 0,0:12:45.69,0:12:47.70,Default,,0,0,0,,Ол қашып кетті.
Dialogue: 0,0:12:47.70,0:12:51.87,Default,,0,0,0,,Біздің ата-бабаларымыз одан әрі шығыста өмір сүрген.
Dialogue: 0,0:12:51.87,0:12:54.87,Default,,0,0,0,,Бұл Норвегия деп аталатын жер.
Dialogue: 0,0:12:54.87,0:12:59.04,Default,,0,0,0,,Мұндағыдан да жылырақ, теңіз қатпайды.
Dialogue: 0,0:12:59.04,0:13:03.81,Default,,0,0,0,,Бұл көптеген шығанақтармен қорғалған жақсы жер.
Dialogue: 0,0:13:03.81,0:13:09.32,Default,,0,0,0,,Бірақ бір күні Харальд есімді күшті адам пайда болды.
Dialogue: 0,0:13:09.32,0:13:14.16,Default,,0,0,0,,Харальд әскері оттың күшімен ауылдарды жаулап алды➡
Dialogue: 0,0:13:14.16,0:13:19.49,Default,,0,0,0,,Ол біртұтас Норвегияның бірінші королі болды және билеуші болды.
Dialogue: 0,0:13:19.49,0:13:22.33,Default,,0,0,0,,Және ол адамдарға қысым жасады.
Dialogue: 0,0:13:22.33,0:13:28.34,Default,,0,0,0,,Корольге бағыныңыз немесе Норвегиядан кетіңіз...
Dialogue: 0,0:13:28.34,0:13:35.51,Default,,0,0,0,,Көптеген адамдар Харальдтың озбырлығын жек көріп, олардың бақылауынан тыс алыс елдерге көшті.
Dialogue: 0,0:13:35.51,0:13:40.68,Default,,0,0,0,,Бұл Исландияда.
Dialogue: 0,0:13:40.68,0:13:42.68,Default,,0,0,0,,Бұл өтірік...
Dialogue: 0,0:13:44.85,0:13:47.19,Default,,0,0,0,,Қарт өтірікші ғой!
Dialogue: 0,0:13:47.19,0:13:50.53,Default,,0,0,0,,Әкем немесе ата-бабаларым қашып кетер ме екен!
Dialogue: 0,0:13:50.53,0:13:53.70,Default,,0,0,0,,Қарияның үргені!Шытырман қарт!
Dialogue: 0,0:13:53.70,0:13:56.60,Default,,0,0,0,,(теңіз құстарының айқайы)
Dialogue: 0,0:13:59.20,0:14:03.97,Default,,0,0,0,,(Тыныс алу жүгіру)
Dialogue: 0,0:14:03.97,0:14:06.97,Default,,0,0,0,,Әке!
Dialogue: 0,0:14:06.97,0:14:10.81,Default,,0,0,0,,Әке, мені тыңда, Лейфтің ағасы...
Dialogue: 0,0:14:10.81,0:14:14.32,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:14:19.32,0:14:21.99,Default,,0,0,0,,Қайтадан қош келдіңіз Торфинннн.
Dialogue: 0,0:14:21.99,0:14:24.33,Default,,0,0,0,,Бұл адам кім?
Dialogue: 0,0:14:24.33,0:14:28.16,Default,,0,0,0,,Бұл бейтаныс адамның құлы. Ол қашып кетті.
Dialogue: 0,0:14:28.16,0:14:30.67,Default,,0,0,0,,(жөтел дауысы)
Dialogue: 0,0:14:30.67,0:14:32.67,Default,,0,0,0,,Мен өмірге қайта оралдым!?
Dialogue: 0,0:14:32.67,0:14:36.84,Default,,0,0,0,,Эй!Есіміңізді айта аласыз ба??(Шапалақ дауысы)
Dialogue: 0,0:14:36.84,0:14:39.67,Default,,0,0,0,,Суық...
Dialogue: 0,0:14:39.67,0:14:44.01,Default,,0,0,0,,(Торс) Бұл от, Юрва, күштірек.Иә.
Dialogue: 0,0:14:44.01,0:14:47.01,Default,,0,0,0,,Сіз қайдансыз?
Dialogue: 0,0:14:47.01,0:14:52.85,Default,,0,0,0,,О, мені... қайтарып алады ма?
Dialogue: 0,0:14:52.85,0:14:55.86,Default,,0,0,0,,Лорд Халфданның сарайында...
Dialogue: 0,0:14:55.86,0:14:59.53,Default,,0,0,0,,Жарты Дан!Өйткені, бұл таудың арғы жағынан!
Dialogue: 0,0:14:59.53,0:15:04.53,Default,,0,0,0,,Ах... ұнамайды... ұнамайды...
Dialogue: 0,0:15:06.63,0:15:13.84,Default,,0,0,0,,Бірақ... баратын жерім жоқ...
Dialogue: 0,0:15:18.48,0:15:20.48,Default,,0,0,0,,Торс!(есіктің ашылған дыбысы)
Dialogue: 0,0:15:20.48,0:15:23.15,Default,,0,0,0,,Кел, Халфдан портта!
Dialogue: 0,0:15:23.15,0:15:26.15,Default,,0,0,0,,Олар тағы бір нәрсені таңдау үшін осында.
Dialogue: 0,0:15:26.15,0:15:28.32,Default,,0,0,0,,Егер бұл сен болмасаң, мен сенімен айналыса алмаймын.
Dialogue: 0,0:15:28.32,0:15:31.99,Default,,0,0,0,,Олар құлдар туралы алаңдамай жағаға шығуға мәжбүр болды.
Dialogue: 0,0:15:31.99,0:15:34.50,Default,,0,0,0,,Лейф мырза ➡ араласып жатыр
Dialogue: 0,0:15:34.50,0:15:37.00,Default,,0,0,0,,Жастар бірлесіп жұмыс істей бастағалы тұрған сияқты.
Dialogue: 0,0:15:37.00,0:15:39.00,Default,,0,0,0,,Бәрібір кел!
Dialogue: 0,0:15:45.17,0:15:49.51,Default,,0,0,0,,(Жартылай дан) Шынжыр – адамға жарасатын жалғыз алқа.
Dialogue: 0,0:15:49.51,0:15:54.68,Default,,0,0,0,,Бұл алтын немесе күміс емес, бұл темір шынжырлар.
Dialogue: 0,0:15:54.68,0:15:57.35,Default,,0,0,0,,Тек мойнымдағы шынжыр➡
Dialogue: 0,0:15:57.35,0:16:00.56,Default,,0,0,0,,Адамдар сізді аздап жақсарта алады.
Dialogue: 0,0:16:03.62,0:16:05.63,Default,,0,0,0,,Сіз солай ойламайсыз ба?
Dialogue: 0,0:16:05.63,0:16:07.80,Default,,0,0,0,,Уф... Уф....
Dialogue: 0,0:16:07.80,0:16:12.30,Default,,0,0,0,,(Хальфдан) Кеше түнде менің бір құлым шынжырды үзіп, қашып кетті.
Dialogue: 0,0:16:12.30,0:16:14.80,Default,,0,0,0,,Сіздің ойыңыз бар ма?
Dialogue: 0,0:16:14.80,0:16:17.64,Default,,0,0,0,,Ешқандай байланыс жасамаңыз!
Dialogue: 0,0:16:17.64,0:16:20.98,Default,,0,0,0,,Сіз өткен күні болған оқиғаны қайталауға тырысып жатқан шығарсыз!
Dialogue: 0,0:16:20.98,0:16:23.64,Default,,0,0,0,,Мен олармен көп қақтығыстарға тап болдым➡
Dialogue: 0,0:16:23.64,0:16:26.98,Default,,0,0,0,,Бұл мәселе өткен күні қоғамдық жиналыста делдалды.
Dialogue: 0,0:16:26.98,0:16:30.99,Default,,0,0,0,,Бала: Теме таныс сияқты.
Dialogue: 0,0:16:30.99,0:16:33.99,Default,,0,0,0,,Сол шайқаста Теме Няның сол қолы кесілген.
Dialogue: 0,0:16:33.99,0:16:38.49,Default,,0,0,0,,Ағаңның аяғын кескен сен едің.
Dialogue: 0,0:16:38.49,0:16:40.66,Default,,0,0,0,,Yosanka Are!
Dialogue: 0,0:16:40.66,0:16:45.00,Default,,0,0,0,,Үлкен аға енді ешқашан жүре алмайды.Мен де анау бейбақтың аяғын кесіп тастаймын!
Dialogue: 0,0:16:45.00,0:16:49.67,Default,,0,0,0,,Қане! Заң мен азаматтық қоғам ит боқтық!
Dialogue: 0,0:16:49.67,0:16:51.67,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:16:51.67,0:16:56.01,Default,,0,0,0,,Ха, Халфдан мырза….(шу)
Dialogue: 0,0:16:56.01,0:16:58.85,Default,,0,0,0,,Сізге қосылайық.
Dialogue: 0,0:16:58.85,0:17:05.95,Default,,0,0,0,,♬～
Dialogue: 0,0:17:05.95,0:17:09.12,Default,,0,0,0,,Гиииаааааааааааааааааааааааааааааааааааааааааааааааа!!
Dialogue: 0,0:17:09.12,0:17:12.13,Default,,0,0,0,,Заңды құрметтемейтіндерді кешіріңіз.
Dialogue: 0,0:17:12.13,0:17:14.80,Default,,0,0,0,,Заң – тізбек.
Dialogue: 0,0:17:14.80,0:17:19.47,Default,,0,0,0,,Байланыс болған жағдайда ғана шеттетілгендер адам нәсілінің бір бөлігі бола алады.
Dialogue: 0,0:17:19.47,0:17:21.77,Default,,0,0,0,,Ұмытпаңыз.
Dialogue: 0,0:17:25.97,0:17:29.81,Default,,0,0,0,,Қашқан адам жас славян жігіті екен.
Dialogue: 0,0:17:29.81,0:17:33.61,Default,,0,0,0,,Сіздің ойыңыз бар ма?
Dialogue: 0,0:17:37.82,0:17:41.49,Default,,0,0,0,,Бұл... қайда...?
Dialogue: 0,0:17:41.49,0:17:44.49,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:17:44.49,0:17:51.33,Default,,0,0,0,,Аа, мен өзімді бірінші рет осылай тыныш сезіндім...
Dialogue: 0,0:17:51.33,0:17:54.50,Default,,0,0,0,,Мықты болыңыз!Эй сен!
Dialogue: 0,0:17:54.50,0:17:56.67,Default,,0,0,0,,Абайлаңыз!Мен өлемін!
Dialogue: 0,0:17:56.67,0:18:01.11,Default,,0,0,0,,Торс….иә….
Dialogue: 0,0:18:01.11,0:18:03.61,Default,,0,0,0,,Әкем….
Dialogue: 0,0:18:03.61,0:18:07.78,Default,,0,0,0,,Анасы мен әпкесі де...
Dialogue: 0,0:18:07.78,0:18:11.79,Default,,0,0,0,,Барлығы осында болды ма?
Dialogue: 0,0:18:11.79,0:18:17.12,Default,,0,0,0,,Мен уайымдадым, өйткені олар бөлшектеп сатылды ...
Dialogue: 0,0:18:17.12,0:18:23.83,Default,,0,0,0,,Бұл қайда?Неге мен...
Dialogue: 0,0:18:28.64,0:18:36.81,Default,,0,0,0,,Батыста, теңіздің арғы жағында Винланд деп аталатын жер бар.
Dialogue: 0,0:18:36.81,0:18:41.65,Default,,0,0,0,,Бұл жылы және бай➡
Dialogue: 0,0:18:41.65,0:18:47.32,Default,,0,0,0,,Бұл құл саудагерлері де, соғыс оты да жете алмайтын алыс өлке.
Dialogue: 0,0:18:47.32,0:18:55.03,Default,,0,0,0,,Неге бір күні келіп, бізбен бірге тұрмайсың?
Dialogue: 0,0:18:57.16,0:18:59.57,Default,,0,0,0,,Винланд….
Dialogue: 0,0:19:02.27,0:19:05.77,Default,,0,0,0,,Мен... көремін.
Dialogue: 0,0:19:05.77,0:19:11.78,Default,,0,0,0,,Бұл жер Винланд деп аталады ма?
Dialogue: 0,0:19:15.12,0:19:17.32,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:19:21.79,0:19:26.79,Default,,0,0,0,,(Хальфдан) Хун, мен оны таптым.Дөрекі болғаным үшін кешіріңіз, Торс.
Dialogue: 0,0:19:26.79,0:19:33.30,Default,,0,0,0,,Мен құлдың заңды иесімін. Мен оны саған қайтарамын.
Dialogue: 0,0:19:33.30,0:19:37.47,Default,,0,0,0,,Цк, әке….Жүр, Торфинннн.
Dialogue: 0,0:19:37.47,0:19:39.81,Default,,0,0,0,,Халфдан мырза!О.
Dialogue: 0,0:19:39.81,0:19:43.81,Default,,0,0,0,,Көрдіңіз бе, мен оны жасырмадым!?
Dialogue: 0,0:19:43.81,0:19:47.48,Default,,0,0,0,,Құлыңды ажалдан құтқардым!
Dialogue: 0,0:19:47.48,0:19:50.79,Default,,0,0,0,,Халфдан Сіз бұл жігітті қаншаға сатып алдыңыз?
Dialogue: 0,0:19:53.82,0:19:58.16,Default,,0,0,0,,Цк, Әке~ Мұндайды сұрау дөрекі.
Dialogue: 0,0:19:58.16,0:20:00.66,Default,,0,0,0,,Екі қой, жас аналық.
Dialogue: 0,0:20:00.66,0:20:04.50,Default,,0,0,0,,Мен үшеуін сатып аламын. Мен оларды сатып аламын.Жақсы!?
Dialogue: 0,0:20:04.50,0:20:08.17,Default,,0,0,0,,Қалайсың, Халфдан?
Dialogue: 0,0:20:08.17,0:20:10.17,Default,,0,0,0,,Мен оны үйіне апарамын.
Dialogue: 0,0:20:10.17,0:20:14.08,Default,,0,0,0,,Оны басқа құлдар алдында үлгі етіп қинауға жол берме.
Dialogue: 0,0:20:18.68,0:20:22.02,Default,,0,0,0,,Сонда төртеуі бар.
Dialogue: 0,0:20:22.02,0:20:26.02,Default,,0,0,0,,Теме: Мен Халфдан мырзаның не айтқанын түсінбедім... үндемеңіз.
Dialogue: 0,0:20:28.02,0:20:30.86,Default,,0,0,0,,Бұдан екі есе ше?
Dialogue: 0,0:20:30.86,0:20:34.86,Default,,0,0,0,,Оларды босатайық.Барлық әйелдер 3 жасқа толмаған болуы керек.
Dialogue: 0,0:20:34.86,0:20:37.16,Default,,0,0,0,,(шу)
Dialogue: 0,0:20:40.03,0:20:45.54,Default,,0,0,0,,(Жарты Дан) Ғұн, сегіз қой өлетін сияқты емес.
Dialogue: 0,0:20:45.54,0:20:48.04,Default,,0,0,0,,Цк.
Dialogue: 0,0:20:48.04,0:20:51.38,Default,,0,0,0,,Бұл жақсы келісім.
Dialogue: 0,0:20:51.38,0:20:55.08,Default,,0,0,0,,Өтірік... Бизнес мәміле жабылды ма?
Dialogue: 0,0:20:58.22,0:21:03.99,Default,,0,0,0,,Торс Сонымен, сіз оны шешуді жоспарлап отырсыз ба?
Dialogue: 0,0:21:03.99,0:21:06.59,Default,,0,0,0,,Ендеше оны қайда апарасың?
Dialogue: 0,0:21:08.83,0:21:14.34,Default,,0,0,0,,Хмм... Мен саған қой таңдауға рұқсат етемін.
Dialogue: 0,0:21:24.01,0:21:27.01,Default,,0,0,0,,(Юрваның айқайы)
Dialogue: 0,0:21:29.35,0:21:33.19,Default,,0,0,0,,Әпке, көңілсіз бе?Бұл өкінішті!
Dialogue: 0,0:21:33.19,0:21:36.52,Default,,0,0,0,,Менің сегіз қойым бар еді!Ол әп-сәтте қайтыс болды.
Dialogue: 0,0:21:36.52,0:21:42.86,Default,,0,0,0,,Уау!Менің әкем ақымақ!Өзгеріс жоқ!
Dialogue: 0,0:21:42.86,0:21:48.04,Default,,0,0,0,,Әке, біз де қашып кеттік пе?
Dialogue: 0,0:21:48.04,0:21:50.70,Default,,0,0,0,,Лейфтің ағасы…➡
Dialogue: 0,0:21:50.70,0:21:55.04,Default,,0,0,0,,Ата-бабаң шығыстан қашқан деседі.
Dialogue: 0,0:21:55.04,0:21:58.88,Default,,0,0,0,,Мен қашып, осында келсем де...
Dialogue: 0,0:21:58.88,0:22:02.18,Default,,0,0,0,,Әй, маған солай айтылған.
Dialogue: 0,0:22:06.82,0:22:08.82,Default,,0,0,0,,Ал...
Dialogue: 0,0:22:13.99,0:22:20.17,Default,,0,0,0,,Сонымен, бұл жерден қашқысы келетіндер үшін➡
Dialogue: 0,0:22:20.17,0:22:22.84,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:22:22.84,0:22:52.37,Default,,0,0,0,,♬～
Dialogue: 0,0:22:53.87,0:22:58.87,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
