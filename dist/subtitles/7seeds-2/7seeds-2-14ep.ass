Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.97,0:00:14.43,Default,,0,0,0,,‎(Ясуи) Сіз адасып қалдыңыз ба?
Dialogue: 0,0:00:14.55,0:00:17.05,Default,,0,0,0,,‎(Рё) Бұл бұрыннан тасталған кеме емес сияқты.
Dialogue: 0,0:00:17.39,0:00:18.81,Default,,0,0,0,,‎(Ясуи) Біз жақындайық па?
Dialogue: 0,0:00:18.93,0:00:21.35,Default,,0,0,0,,‎(Рё) Жоқ, бұл тұзақ болуы мүмкін.
Dialogue: 0,0:00:21.47,0:00:23.27,Default,,0,0,0,,Тұзақ? Кімнің?
Dialogue: 0,0:00:23.39,0:00:25.73,Default,,0,0,0,,Сіз оны көрмеген шығарсыз...
Dialogue: 0,0:00:26.06,0:00:27.81,Default,,0,0,0,,Сол сынақта...
Dialogue: 0,0:00:27.94,0:00:31.44,Default,,0,0,0,,Мен сол кемеде өте тітіркендіргіш тәжірибе болдым.
Dialogue: 0,0:00:32.03,0:00:33.36,Default,,0,0,0,,Не болатынын көрейік.
Dialogue: 0,0:00:33.49,0:00:36.95,Default,,0,0,0,,‎(Банумару) Ало~ха~ое~
Dialogue: 0,0:00:37.95,0:00:42.95,Default,,0,0,0,,♪～
Dialogue: 0,0:01:58.28,0:02:03.28,Default,,0,0,0,,～♪
Dialogue: 0,0:02:07.87,0:02:10.75,Default,,0,0,0,,Ало~ха~ое~
Dialogue: 0,0:02:10.88,0:02:14.05,Default,,0,0,0,,Ало~ха~ое~
Dialogue: 0,0:02:14.17,0:02:16.63,Default,,0,0,0,,‎Нацу, сен де ән айтуың керек!
Dialogue: 0,0:02:16.76,0:02:18.26,Default,,0,0,0,,Дұрыс биле!
Dialogue: 0,0:02:18.38,0:02:20.72,Default,,0,0,0,,Жамбасыңызды көбірек шайқаңыз! Қараңдар!
Dialogue: 0,0:02:20.84,0:02:23.85,Default,,0,0,0,,‎Ой... Мен бұлай билей алмаймын.
Dialogue: 0,0:02:24.14,0:02:25.18,Default,,0,0,0,,Идиот!
Dialogue: 0,0:02:25.31,0:02:27.14,Default,,0,0,0,,Жексенбілік жасырын өнер сайысы...
Dialogue: 0,0:02:27.27,0:02:30.19,Default,,0,0,0,,‎Біз бұл манзайды не болса да жеңеміз!
Dialogue: 0,0:02:30.40,0:02:31.94,Default,,0,0,0,,‎Жарайды, осыны қарастырайық.
Dialogue: 0,0:02:32.06,0:02:33.40,Default,,0,0,0,,Е...
Dialogue: 0,0:02:33.73,0:02:37.32,Default,,0,0,0,,Сәлем, бұл Банмару мен Нацу.
Dialogue: 0,0:02:37.44,0:02:41.99,Default,,0,0,0,,‎Эй, Нацу, “Алоха” алоха жейдесін білдіреді, солай ма?
Dialogue: 0,0:02:42.12,0:02:44.49,Default,,0,0,0,,‎Hona «Oe~» дегеніміз не?
Dialogue: 0,0:02:44.62,0:02:45.70,Default,,0,0,0,,‎Мм...
Dialogue: 0,0:02:45.83,0:02:48.62,Default,,0,0,0,,‎(Ханумару) “Oe~” деген не?! Эх...
Dialogue: 0,0:02:48.75,0:02:50.12,Default,,0,0,0,,‎О, ой…
Dialogue: 0,0:02:50.25,0:02:51.54,Default,,0,0,0,,Жүрек айну!
Dialogue: 0,0:02:51.67,0:02:53.96,Default,,0,0,0,,Ашуланбаңыздар, Гавайи халқы
Dialogue: 0,0:02:54.09,0:02:56.55,Default,,0,0,0,,О! О! (Бамимару) Бұл дельфин бе?
Dialogue: 0,0:02:56.67,0:02:59.92,Default,,0,0,0,,О, бұл рас болуы мүмкін.
Dialogue: 0,0:03:00.13,0:03:01.13,Default,,0,0,0,,‎Мм...
Dialogue: 0,0:03:01.38,0:03:03.93,Default,,0,0,0,,‎(Хаманумару) Жарайды, көбірек идеяларды ойлап көрейік!
Dialogue: 0,0:03:04.05,0:03:05.72,Default,,0,0,0,,‎Өз ойларыңызды жеткізіңіз!
Dialogue: 0,0:03:06.26,0:03:09.18,Default,,0,0,0,,‎(Ясуи) Бұл қандай да бір тұзақ екені анық. (Рё) О.
Dialogue: 0,0:03:09.31,0:03:10.52,Default,,0,0,0,,‎(Ясуи) Иә?
Dialogue: 0,0:03:11.48,0:03:13.77,Default,,0,0,0,,‎(Рё) Олар бірдеңені ұнтақтап жатқан сияқты.
Dialogue: 0,0:03:13.90,0:03:15.52,Default,,0,0,0,,‎Ха ха! Хо-хо!
Dialogue: 0,0:03:15.65,0:03:17.82,Default,,0,0,0,,‎Хаха Уау~ Хаха!
Dialogue: 0,0:03:17.94,0:03:19.90,Default,,0,0,0,,‎Аа... ха...
Dialogue: 0,0:03:21.74,0:03:24.28,Default,,0,0,0,,Ей, теңізде де біреу бар.
Dialogue: 0,0:03:25.37,0:03:28.04,Default,,0,0,0,,‎(Отты) Пион, сен мынаны жей аласың ба?
Dialogue: 0,0:03:28.41,0:03:30.12,Default,,0,0,0,,‎(Пионгүл) Барлығы да сынақ.
Dialogue: 0,0:03:30.25,0:03:33.75,Default,,0,0,0,,Менің дәмім улы, сондықтан оның дәмі улы болса, жолым жоқ.
Dialogue: 0,0:03:34.04,0:03:37.09,Default,,0,0,0,,Менің ойымша, бұл жақсы шығар.
Dialogue: 0,0:03:37.80,0:03:40.59,Default,,0,0,0,,‎Ясуи, бұл саған тұзақ.
Dialogue: 0,0:03:40.72,0:03:44.26,Default,,0,0,0,,‎Рё, мен әйелдерге шабуылдағым келмейді.
Dialogue: 0,0:03:44.39,0:03:47.60,Default,,0,0,0,,‎Әрине, ақымақтардың істейтіні.
Dialogue: 0,0:03:48.18,0:03:49.60,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:03:50.02,0:03:52.69,Default,,0,0,0,,‎(Араши) Пион, үстіне бірдеңе киіп алшы.
Dialogue: 0,0:03:53.10,0:03:55.02,Default,,0,0,0,,‎(Пион) Сіз үйреніп кетесіз деп үміттенемін.
Dialogue: 0,0:03:55.23,0:03:56.61,Default,,0,0,0,,Мен бұған үйренбеймін
Dialogue: 0,0:03:57.27,0:03:58.11,Default,,0,0,0,,‎(пион) Бұл солай ма?
Dialogue: 0,0:03:58.48,0:04:00.94,Default,,0,0,0,,Бұл ас үйдегі раковина ма?
Dialogue: 0,0:04:01.07,0:04:03.61,Default,,0,0,0,,‎Осы жердегі теңіз қазынаға толы.
Dialogue: 0,0:04:04.28,0:04:06.45,Default,,0,0,0,,‎Ескі нәрселерге сену жақсы емес.
Dialogue: 0,0:04:06.57,0:04:08.24,Default,,0,0,0,,‎(пион) Қолыңнан келгенін пайдаланған дұрыс.
Dialogue: 0,0:04:09.33,0:04:11.50,Default,,0,0,0,,‎(Ясуи) Не айтып тұрсың...
Dialogue: 0,0:04:11.62,0:04:14.71,Default,,0,0,0,,‎(Ryo) Бұл дағдарысты басқару және квоталар туралы.
Dialogue: 0,0:04:15.63,0:04:17.21,Default,,0,0,0,,Барлығы 7 адам?
Dialogue: 0,0:04:17.34,0:04:21.21,Default,,0,0,0,,‎Бұл сөзсіз басқа жазғы команда екенін білдіреді.
Dialogue: 0,0:04:21.34,0:04:22.22,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:04:22.34,0:04:25.64,Default,,0,0,0,,Біз кемені ұрлап алсақ та, оның бірден қозғалуы екіталай...
Dialogue: 0,0:04:25.76,0:04:28.10,Default,,0,0,0,,Олардың да мылтықтары болуы мүмкін.
Dialogue: 0,0:04:28.55,0:04:32.64,Default,,0,0,0,,‎Егер олар бізге қарсы құрылған болса, олар қандай да бір топ болуы керек.
Dialogue: 0,0:04:32.89,0:04:35.02,Default,,0,0,0,,Біраз уақыт алыстан бақылап көрейік
Dialogue: 0,0:04:35.14,0:04:36.90,Default,,0,0,0,,Уау! (Рё мен Ясуи) Ах! ?
Dialogue: 0,0:04:37.02,0:04:39.02,Default,,0,0,0,,Соқтығыс!
Dialogue: 0,0:04:39.15,0:04:40.15,Default,,0,0,0,,‎(Ясуи) Ух...
Dialogue: 0,0:04:43.19,0:04:45.45,Default,,0,0,0,,А...
Dialogue: 0,0:04:48.70,0:04:50.29,Default,,0,0,0,,‎Аа... Рахмет
Dialogue: 0,0:04:50.79,0:04:52.29,Default,,0,0,0,,Қандай өтірік!
Dialogue: 0,0:04:52.95,0:04:55.00,Default,,0,0,0,,‎Ол өте әдемі!
Dialogue: 0,0:04:55.12,0:04:57.17,Default,,0,0,0,,‎Армандасаң, ол орындалады!
Dialogue: 0,0:04:57.29,0:05:01.38,Default,,0,0,0,,Иә! Ханзадалар маған көмектесу үшін келді!
Dialogue: 0,0:05:02.42,0:05:04.55,Default,,0,0,0,,‎ Чимаки-чан Чимаки-чан!
Dialogue: 0,0:05:04.88,0:05:07.64,Default,,0,0,0,,Қараңдаршы, екі әдемі жігіт бар!
Dialogue: 0,0:05:07.76,0:05:09.93,Default,,0,0,0,,Ал, рахмет.
Dialogue: 0,0:05:10.22,0:05:10.64,Default,,0,0,0,,‎Эй, сен алыстан не көріп тұрсың?
Dialogue: 0,0:05:10.64,0:05:12.27,Default,,0,0,0,,‎Эй, сен алыстан не көріп тұрсың?
Dialogue: 0,0:05:10.64,0:05:12.27,Default,,0,0,0,,Хе, бұл адамдар-
Dialogue: 0,0:05:12.27,0:05:12.39,Default,,0,0,0,,‎Эй, сен алыстан не көріп тұрсың?
Dialogue: 0,0:05:12.39,0:05:13.35,Default,,0,0,0,,‎Эй, сен алыстан не көріп тұрсың?
Dialogue: 0,0:05:12.39,0:05:13.35,Default,,0,0,0,,Сіз мені құтқардыңыз!
Dialogue: 0,0:05:13.35,0:05:13.47,Default,,0,0,0,,Сіз мені құтқардыңыз!
Dialogue: 0,0:05:13.47,0:05:14.43,Default,,0,0,0,,Сіз мені құтқардыңыз!
Dialogue: 0,0:05:13.47,0:05:14.43,Default,,0,0,0,,Сіздің таңдауыңыз жоқ.
Dialogue: 0,0:05:14.73,0:05:16.73,Default,,0,0,0,,Тағдырлы кездесулер болады!
Dialogue: 0,0:05:17.06,0:05:19.77,Default,,0,0,0,,‎ Хмм, саған жақсы, Мацури
Dialogue: 0,0:05:20.11,0:05:23.53,Default,,0,0,0,,Бұрынғыдай өзіңіз туралы көп сөйлемеңіз.
Dialogue: 0,0:05:23.65,0:05:24.53,Default,,0,0,0,,Қолайсыз болу
Dialogue: 0,0:05:24.65,0:05:26.82,Default,,0,0,0,,‎Аа, мен енді шатаспаймын.
Dialogue: 0,0:05:33.45,0:05:37.08,Default,,0,0,0,,‎Міне, қарашы, Натчан, ақыры әдемі жігіт пайда болды!
Dialogue: 0,0:05:37.21,0:05:39.58,Default,,0,0,0,,‎(Ханумару) «Соңында» Мацури мен мен Араши де сонда болады!
Dialogue: 0,0:05:39.71,0:05:40.34,Default,,0,0,0,,Боу!
Dialogue: 0,0:05:40.50,0:05:41.09,Default,,0,0,0,,‎(Банумару) Менің туған қаламда қатты болды.
Dialogue: 0,0:05:41.09,0:05:42.34,Default,,0,0,0,,‎(Банумару) Менің туған қаламда қатты болды.
Dialogue: 0,0:05:41.09,0:05:42.34,Default,,0,0,0,,Әдемі жігіт дегеніміз не?
Dialogue: 0,0:05:42.34,0:05:42.46,Default,,0,0,0,,‎(Банмару) Менің туған қаламда қатты болды.
Dialogue: 0,0:05:42.46,0:05:43.09,Default,,0,0,0,,‎(Банумару) Менің туған қаламда қатты болды.
Dialogue: 0,0:05:42.46,0:05:43.09,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:05:43.09,0:05:43.34,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:05:43.67,0:05:46.51,Default,,0,0,0,,Мен таң қалдым. Ал сендер ше?
Dialogue: 0,0:05:46.63,0:05:48.55,Default,,0,0,0,,‎Біз жаз Б
Dialogue: 0,0:05:49.89,0:05:51.68,Default,,0,0,0,,‎(Ясуи) Қазір жаз (Хамимару және т.б.) О!
Dialogue: 0,0:05:51.80,0:05:54.39,Default,,0,0,0,,‎Бұл А жазын білдіреді ме? Шынымен бе?
Dialogue: 0,0:05:54.52,0:05:57.23,Default,,0,0,0,,‎(Араши) Солай ма? (Бамимару) Ақыры шықтың, досым!
Dialogue: 0,0:05:57.77,0:06:00.86,Default,,0,0,0,,Мен бұл бірінші құрылған команда деп естідім.
Dialogue: 0,0:06:00.98,0:06:02.61,Default,,0,0,0,,‎Танысқаныма қуаныштымын.
Dialogue: 0,0:06:02.73,0:06:05.44,Default,,0,0,0,,Тек екі адам? Басқа мүшелер де солай ма?
Dialogue: 0,0:06:06.49,0:06:07.32,Default,,0,0,0,,Бөлінген
Dialogue: 0,0:06:07.70,0:06:10.82,Default,,0,0,0,,‎(Ботан) Мен бұл туралы уайымдап отырмын. Мен саған оны іздеуге көмектесемін.
Dialogue: 0,0:06:10.95,0:06:13.03,Default,,0,0,0,,‎Жақсы Жақын емес
Dialogue: 0,0:06:13.37,0:06:14.49,Default,,0,0,0,,А...
Dialogue: 0,0:06:14.62,0:06:15.45,Default,,0,0,0,,‎(От бляшка) Мм...
Dialogue: 0,0:06:15.91,0:06:18.41,Default,,0,0,0,,‎Барлығыңыз, уақыт таяп қалды.
Dialogue: 0,0:06:18.54,0:06:20.37,Default,,0,0,0,,‎(Пион) А, бұл уақыт әлдеқашан ба?
Dialogue: 0,0:06:20.50,0:06:21.58,Default,,0,0,0,,‎(Банумару) Сабын сабын!
Dialogue: 0,0:06:21.92,0:06:23.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:21.92,0:06:23.17,Default,,0,0,0,,‎(Араши) Набе! Шәйнек! Дайын бол! Дайын бол!
Dialogue: 0,0:06:23.17,0:06:24.17,Default,,0,0,0,,‎(Араши) Набе! Шәйнек! Дайын бол! Дайын бол!
Dialogue: 0,0:06:24.63,0:06:28.30,Default,,0,0,0,,‎(Отты) келе жатыр 3 2 1!
Dialogue: 0,0:06:31.14,0:06:32.80,Default,,0,0,0,,‎(Фестивальдің құттықтауы)
Dialogue: 0,0:06:33.43,0:06:34.72,Default,,0,0,0,,‎Гейзер…
Dialogue: 0,0:06:34.85,0:06:37.31,Default,,0,0,0,,‎Ал бұл сирек кездесетін суық бұлақ.
Dialogue: 0,0:06:37.73,0:06:39.27,Default,,0,0,0,,Күніне бес рет соғады.
Dialogue: 0,0:06:39.73,0:06:42.15,Default,,0,0,0,,‎Мен мұны көріп, кемені жақындатуға тырысқанда...
Dialogue: 0,0:06:42.27,0:06:44.98,Default,,0,0,0,,Мен тасқа жүгірдім.
Dialogue: 0,0:06:45.53,0:06:48.44,Default,,0,0,0,,‎(Рё) Бұл жігіттер мүлдем бос орындарға толы, солай емес пе?
Dialogue: 0,0:06:48.57,0:06:49.86,Default,,0,0,0,,‎(Ясуи) Соған ұқсайды.
Dialogue: 0,0:06:50.11,0:06:52.70,Default,,0,0,0,,‎(Рё) Жалғыз гид, Пион, жаттығу.
Dialogue: 0,0:06:52.82,0:06:56.08,Default,,0,0,0,,Оның өткір денесі бар. Алдына, артына, сол жағына, оң жағына көңіл бөледі.
Dialogue: 0,0:06:56.54,0:06:59.75,Default,,0,0,0,,‎Ал Арашидің спорттық қабілеті жақсы сияқты.
Dialogue: 0,0:06:59.87,0:07:02.75,Default,,0,0,0,,Қалғаны туралы айтудың қажеті жоқ, әсіресе Нацу.
Dialogue: 0,0:07:03.04,0:07:06.50,Default,,0,0,0,,Мақсат бойынша? Сіз бізді сынап жатырсыз ба?
Dialogue: 0,0:07:06.63,0:07:07.46,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:12.64,0:07:15.22,Default,,0,0,0,,‎(Ясуи) Сіз жолбасшымын дедіңіз.
Dialogue: 0,0:07:15.47,0:07:17.14,Default,,0,0,0,,Сіз әріптес мұғалімсіз бе?
Dialogue: 0,0:07:17.43,0:07:20.06,Default,,0,0,0,,О, мен полиция қызметкері едім...
Dialogue: 0,0:07:20.18,0:07:22.27,Default,,0,0,0,,‎Сіздің гидтеріңіз мұғалімдер ме?
Dialogue: 0,0:07:24.15,0:07:27.11,Default,,0,0,0,,Мен гидтер негізінен мемлекеттік қызметшілер деп естідім.
Dialogue: 0,0:07:27.23,0:07:28.99,Default,,0,0,0,,‎Мұғалімдер де болады.
Dialogue: 0,0:07:29.11,0:07:32.49,Default,,0,0,0,,Мен ол адаммен бір күні кездескім келеді.
Dialogue: 0,0:07:33.28,0:07:37.45,Default,,0,0,0,,‎(Банумару) Жарайды, толқын сейілді! Кешкі ас ішейік!
Dialogue: 0,0:07:37.58,0:07:40.75,Default,,0,0,0,,Сіз де барасыз ба? Мен саған кемені көрсетемін.
Dialogue: 0,0:07:43.88,0:07:47.34,Default,,0,0,0,,‎(Араши) Олар сабырлы және тұрақты болып көрінеді.
Dialogue: 0,0:07:47.46,0:07:50.42,Default,,0,0,0,,‎(Пион) Хехе, мен қашықтықты өлшей беремін.
Dialogue: 0,0:07:50.55,0:07:51.38,Default,,0,0,0,,‎(Араши) аралық?
Dialogue: 0,0:07:51.80,0:07:54.18,Default,,0,0,0,,Қарсыласыңыз кенеттен бірдеңе жасап көргенде...
Dialogue: 0,0:07:54.30,0:07:56.93,Default,,0,0,0,,Мен онымен күресу үшін жеткілікті қашықтықты сақтаймын.
Dialogue: 0,0:07:57.14,0:07:59.43,Default,,0,0,0,,‎Мүмкін, сізде жекпе-жек туралы біраз біліміңіз бар шығар.
Dialogue: 0,0:07:59.56,0:08:02.98,Default,,0,0,0,,Екеуі де қобалжыған, сүйкімді
Dialogue: 0,0:08:03.10,0:08:05.35,Default,,0,0,0,,‎Ботан-сан, жас өлтіруші шығар! ?
Dialogue: 0,0:08:06.11,0:08:06.98,Default,,0,0,0,,Өлтіруші?
Dialogue: 0,0:08:08.19,0:08:10.03,Default,,0,0,0,,Менің қарсыластарым көбейді.
Dialogue: 0,0:08:10.15,0:08:11.69,Default,,0,0,0,,Иә? Натчан
Dialogue: 0,0:08:11.82,0:08:14.99,Default,,0,0,0,,‎Кімге не болса да, мен кек сақтамаймын.
Dialogue: 0,0:08:15.24,0:08:18.24,Default,,0,0,0,,‎Е, а... мен сондаймын...
Dialogue: 0,0:08:18.58,0:08:21.95,Default,,0,0,0,,‎Араши-кун басқа біреудікі, сондықтан мен басқа біреуді табуым керек.
Dialogue: 0,0:08:22.08,0:08:24.71,Default,,0,0,0,,Ех! ? Бұл дұрыс...
Dialogue: 0,0:08:24.83,0:08:25.92,Default,,0,0,0,,Мұндай нәрсе...
Dialogue: 0,0:08:26.04,0:08:28.25,Default,,0,0,0,,‎Бұл анық, Натчан!
Dialogue: 0,0:08:28.38,0:08:29.84,Default,,0,0,0,,Мұндай нәрсе...
Dialogue: 0,0:08:30.34,0:08:32.72,Default,,0,0,0,,Мен ешнәрсе туралы ойлай алмаймын
Dialogue: 0,0:08:32.84,0:08:37.85,Default,,0,0,0,,‎Мені біреуге ұнатуы мүмкін емес...
Dialogue: 0,0:08:40.14,0:08:41.10,Default,,0,0,0,,‎(Корпақты түрту дыбысы)
Dialogue: 0,0:08:43.10,0:08:44.81,Default,,0,0,0,,Қабыл ал! Барлық шаяндарды алыңыз!
Dialogue: 0,0:08:46.73,0:08:48.52,Default,,0,0,0,,Сіз жей аласыз!
Dialogue: 0,0:08:48.65,0:08:50.15,Default,,0,0,0,,‎Ханумару-сан, артыңда!
Dialogue: 0,0:08:50.48,0:08:52.49,Default,,0,0,0,,А? Эй!
Dialogue: 0,0:08:52.94,0:08:55.28,Default,,0,0,0,,‎Келме... Келме!
Dialogue: 0,0:08:58.62,0:09:00.20,Default,,0,0,0,,‎(Рё) Жаңа ғана ішкенді жемейсің бе?
Dialogue: 0,0:09:00.45,0:09:02.25,Default,,0,0,0,,‎Сен осындай жиіркенішті тамақты жей аласың ба?
Dialogue: 0,0:09:04.79,0:09:06.79,Default,,0,0,0,,‎(Ханумару) Сәлем, Араши. (Араши) Иә?
Dialogue: 0,0:09:06.92,0:09:09.38,Default,,0,0,0,,Олар пышақтарын шығарды.
Dialogue: 0,0:09:09.50,0:09:12.59,Default,,0,0,0,,‎Аа, бұл таңқаларлық, сіз оны пайдаланып үйреніп қалдыңыз.
Dialogue: 0,0:09:12.88,0:09:15.55,Default,,0,0,0,,‎Идиот, оны бақылап отырайық.
Dialogue: 0,0:09:16.26,0:09:18.93,Default,,0,0,0,,Менің соғыста шыңдалған иіс сезімім бойынша...
Dialogue: 0,0:09:19.05,0:09:21.56,Default,,0,0,0,,‎Мен өзімді шабуылдайтын немесе қауіпті сезінбеймін.
Dialogue: 0,0:09:21.85,0:09:25.14,Default,,0,0,0,,Бірақ менің ойымша, ол бірдеңе ұрлау үшін келген жоқ.
Dialogue: 0,0:09:25.89,0:09:28.52,Default,,0,0,0,,Банмару есіңізде ме?
Dialogue: 0,0:09:28.90,0:09:32.11,Default,,0,0,0,,‎Бұл бізге күзгі топтың айтқаны.
Dialogue: 0,0:09:32.40,0:09:34.74,Default,,0,0,0,,‎Сіз ол кезде бұл ақылға сыйымсыз деп ойладыңыз, солай ма?
Dialogue: 0,0:09:34.94,0:09:38.16,Default,,0,0,0,,Қалай болғанда да, бұған сену қауіпті.
Dialogue: 0,0:09:38.28,0:09:41.28,Default,,0,0,0,,Мен сенгім келеді, өйткені бұл әлем
Dialogue: 0,0:09:41.49,0:09:45.58,Default,,0,0,0,,‎Сіз оны тазаламайсыз ба немесе күтпейсіз бе? Ол тез нашарлайды.
Dialogue: 0,0:09:45.71,0:09:49.42,Default,,0,0,0,,‎Оны бұрышта қалдыру жақсы емес, өйткені ол діңгекке күш түсіреді.
Dialogue: 0,0:09:49.54,0:09:51.34,Default,,0,0,0,,А...
Dialogue: 0,0:09:52.46,0:09:55.67,Default,,0,0,0,,‎(Банмару) Хмм, мен мұны ескі маған айтқым келеді.
Dialogue: 0,0:09:55.80,0:09:58.13,Default,,0,0,0,,Мен краб жеуден шаршадым!
Dialogue: 0,0:09:58.26,0:10:00.97,Default,,0,0,0,,А? Фурикаке? Күнжіт?
Dialogue: 0,0:10:01.10,0:10:02.10,Default,,0,0,0,,Сізде жақсы нәрселер бар.
Dialogue: 0,0:10:03.14,0:10:04.06,Default,,0,0,0,,‎(Ясуи) Құмырсқа түрі.
Dialogue: 0,0:10:04.18,0:10:05.35,Default,,0,0,0,,‎(Араши/Бамимару) Сәлем!
Dialogue: 0,0:10:05.77,0:10:08.06,Default,,0,0,0,,Жәндіктер ақуыздың жақсы көзі болып табылады
Dialogue: 0,0:10:08.52,0:10:09.90,Default,,0,0,0,,Кейбіреулер тәтті
Dialogue: 0,0:10:10.19,0:10:11.77,Default,,0,0,0,,‎(Бамамару) Ноаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа(Араши) Уау!
Dialogue: 0,0:10:12.90,0:10:14.03,Default,,0,0,0,,‎(Ясуи) Сіз қалай ойлайсыз?
Dialogue: 0,0:10:14.36,0:10:18.90,Default,,0,0,0,,Олар қарапайым адамдар ма, әлде біз сияқты таңдалды ма?
Dialogue: 0,0:10:19.66,0:10:23.33,Default,,0,0,0,,‎Су қандай болса, кемеге қараусыз қалған
Dialogue: 0,0:10:23.45,0:10:26.50,Default,,0,0,0,,Жануарлар мен жәндіктерден қорқып, олармен күресуге қабілетсіз
Dialogue: 0,0:10:27.20,0:10:31.04,Default,,0,0,0,,Олар дағдарысты басқаруда жақсы емес. Олар да жазғы команда.
Dialogue: 0,0:10:31.46,0:10:35.88,Default,,0,0,0,,Ран Шинигами В жазында болуы мүмкін екенін айтты.
Dialogue: 0,0:10:36.01,0:10:39.63,Default,,0,0,0,,Пиондар? Мені өлтіруші деп атады.
Dialogue: 0,0:10:40.34,0:10:42.60,Default,,0,0,0,,‎Такаши Сенсейдің қолын пайдаланғыңыз келе ме?
Dialogue: 0,0:10:42.72,0:10:46.60,Default,,0,0,0,,‎Мойынды арт жағынан сипап, «Оны қалай алып тастауға болады?»
Dialogue: 0,0:10:46.72,0:10:49.31,Default,,0,0,0,,‎Рё, бұл есімді айтпа.
Dialogue: 0,0:10:51.98,0:10:52.81,Default,,0,0,0,,Оны шығармаңыз
Dialogue: 0,0:11:00.78,0:11:05.45,Default,,0,0,0,,‎(Рё) Толқындардың дыбысы өте қатты. Бірдеңе жақындап қалғандай сезіледі.
Dialogue: 0,0:11:06.33,0:11:09.33,Default,,0,0,0,,‎Ал, өзгеретін уақыт келді.
Dialogue: 0,0:11:09.62,0:11:11.75,Default,,0,0,0,,‎(Чимакидің күш дауысы)
Dialogue: 0,0:11:12.08,0:11:14.75,Default,,0,0,0,,Иә? (Ясуи) Шигеру қайда?
Dialogue: 0,0:11:14.88,0:11:15.71,Default,,0,0,0,,Кім?
Dialogue: 0,0:11:15.96,0:11:18.51,Default,,0,0,0,,Шигеру қайда?
Dialogue: 0,0:11:18.63,0:11:20.26,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:11:23.76,0:11:26.85,Default,,0,0,0,,‎(Рё) Ясуи толқындардың дыбысын естімейтін шығар.
Dialogue: 0,0:11:27.56,0:11:31.52,Default,,0,0,0,,Мен мұны Дэнгоро сияқты өзім жасаған жоқпын.
Dialogue: 0,0:11:31.64,0:11:35.06,Default,,0,0,0,,Мен Корури сияқты өлімді көргендей емеспін.
Dialogue: 0,0:11:35.48,0:11:38.69,Default,,0,0,0,,‎Кенеттен салмақ жоғалып кетті.
Dialogue: 0,0:11:39.07,0:11:41.61,Default,,0,0,0,,‎Ол кетті, болды.
Dialogue: 0,0:11:42.15,0:11:44.49,Default,,0,0,0,,‎Ей, кезекпен жүр.
Dialogue: 0,0:11:44.91,0:11:46.45,Default,,0,0,0,,‎(Рё) Бұл жігіт әлі...
Dialogue: 0,0:11:46.95,0:11:48.74,Default,,0,0,0,,Мен сол сынақтың ортасындамын.
Dialogue: 0,0:11:48.87,0:11:49.87,Default,,0,0,0,,Ұйқыға кет
Dialogue: 0,0:11:53.96,0:11:57.25,Default,,0,0,0,,‎(Ясуи) Ешкім оянбайды. Не болып жатыр?
Dialogue: 0,0:11:57.38,0:11:59.67,Default,,0,0,0,,‎(Рё) Жоқ, мен олай ойламаймын.
Dialogue: 0,0:11:59.80,0:12:03.26,Default,,0,0,0,,‎(Банмару) Бүгін сенбі, ал ертең жексенбі~!
Dialogue: 0,0:12:03.38,0:12:04.22,Default,,0,0,0,,‎(Анго) сенбі?
Dialogue: 0,0:12:04.34,0:12:06.51,Default,,0,0,0,,‎(Хаманумару) А, мен өз бетіммен шештім.
Dialogue: 0,0:12:06.64,0:12:08.97,Default,,0,0,0,,‎Арашидің ақымақтары өткірліктің болғаны жақсы дейді.
Dialogue: 0,0:12:09.10,0:12:12.98,Default,,0,0,0,,Ал ертең жексенбіде жыл сайынғы жасырын трюк жарысы.
Dialogue: 0,0:12:13.10,0:12:14.35,Default,,0,0,0,,‎(Ясуи) Жасырын трюк?
Dialogue: 0,0:12:14.48,0:12:16.86,Default,,0,0,0,,‎(Банумару) Сахнаны сәл безендіремін.
Dialogue: 0,0:12:17.19,0:12:21.03,Default,,0,0,0,,‎Бос уақытыңыз болса, қураған ағашты немесе бір нәрсені жинаңыз.
Dialogue: 0,0:12:21.15,0:12:22.86,Default,,0,0,0,,‎(Ясуи) Бұл орынды ма? (Бамимару) Ой
Dialogue: 0,0:12:22.99,0:12:24.99,Default,,0,0,0,,‎Бұтақтар, шөптер және т.б.
Dialogue: 0,0:12:25.11,0:12:26.20,Default,,0,0,0,,‎(Ясуи) Кездейсоқ дегеніміз не?
Dialogue: 0,0:12:26.32,0:12:27.78,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:27.91,0:12:29.49,Default,,0,0,0,,‎Сәйкес келеді.
Dialogue: 0,0:12:29.83,0:12:33.25,Default,,0,0,0,,‎Қалыңдығы, ұзындығы, материалы және т.б.
Dialogue: 0,0:12:33.37,0:12:34.46,Default,,0,0,0,,‎Қандай орынды?
Dialogue: 0,0:12:34.58,0:12:36.71,Default,,0,0,0,,‎(Ханумару) Хмм... шамамен (Ясуи) шамамен?
Dialogue: 0,0:12:37.29,0:12:40.46,Default,,0,0,0,,‎Жоқ, жеткілікті...
Dialogue: 0,0:12:40.59,0:12:43.13,Default,,0,0,0,,Сіз өте салмақты адам сияқтысыз.
Dialogue: 0,0:12:43.59,0:12:46.01,Default,,0,0,0,,Міне солай! (От бляшка) Аа, күн суық.
Dialogue: 0,0:12:46.14,0:12:47.64,Default,,0,0,0,,Әлі жоқ!
Dialogue: 0,0:12:49.14,0:12:52.73,Default,,0,0,0,,‎(Ясуи) Олар күні бойы ерекше ештеңе жасамайды.
Dialogue: 0,0:12:53.77,0:12:57.06,Default,,0,0,0,,Таңертең және кешке тамақ ішу
Dialogue: 0,0:12:57.19,0:12:59.19,Default,,0,0,0,,‎Қалғандары қалағандай жейді.
Dialogue: 0,0:12:59.48,0:13:02.07,Default,,0,0,0,,Енді жасырын өнер сайысына дайындал
Dialogue: 0,0:13:02.32,0:13:03.74,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:03.86,0:13:06.24,Default,,0,0,0,,Басқа да істер бар.
Dialogue: 0,0:13:06.36,0:13:08.78,Default,,0,0,0,,‎Жұмыс көп болуы керек!
Dialogue: 0,0:13:08.91,0:13:09.70,Default,,0,0,0,,А
Dialogue: 0,0:13:12.50,0:13:15.66,Default,,0,0,0,,‎Ах... Жасырын трюк жарысы...
Dialogue: 0,0:13:15.79,0:13:17.79,Default,,0,0,0,,‎Мен өзімді ауыр сезініп тұрмын, мұны істегім келмейді...
Dialogue: 0,0:13:17.92,0:13:19.38,Default,,0,0,0,,‎(Ясуи) Тек сен бе?
Dialogue: 0,0:13:19.71,0:13:21.75,Default,,0,0,0,,‎(Ясуи) Кім жұмыс істейді?
Dialogue: 0,0:13:21.88,0:13:25.17,Default,,0,0,0,,‎Қадамдар ретсіз, бірақ сонымен бірге сызбалы.
Dialogue: 0,0:13:25.55,0:13:29.68,Default,,0,0,0,,‎Аа... Ум, кешіріңіз...
Dialogue: 0,0:13:29.80,0:13:30.85,Default,,0,0,0,,‎(Ясуи) Көмек бергіңіз келе ме? иә?
Dialogue: 0,0:13:30.97,0:13:33.43,Default,,0,0,0,,Сондай-ақ желкенді алып, жөндеу керек.
Dialogue: 0,0:13:33.56,0:13:36.39,Default,,0,0,0,,‎Менің қолым осындай, сондықтан оны түзетіңіз.
Dialogue: 0,0:13:36.52,0:13:39.06,Default,,0,0,0,,Мен оны тазалаймын. Маған соны қарызға бер.
Dialogue: 0,0:13:39.19,0:13:41.19,Default,,0,0,0,,Иә
Dialogue: 0,0:13:42.27,0:13:44.49,Default,,0,0,0,,‎Ол мейірімді адам!
Dialogue: 0,0:13:46.99,0:13:48.32,Default,,0,0,0,,‎Анго?
Dialogue: 0,0:13:51.28,0:13:54.16,Default,,0,0,0,,‎(Мозу) Банумару әлі де тамаша формада.
Dialogue: 0,0:13:54.70,0:13:57.08,Default,,0,0,0,,Ясуи Нацумен сырласа бастады.
Dialogue: 0,0:13:57.21,0:14:00.33,Default,,0,0,0,,‎Сенің басқаларға қамқор болу фактісі өзгерген жоқ.
Dialogue: 0,0:14:01.09,0:14:05.63,Default,,0,0,0,,‎Ясуи мен Рю жазда В-мен араласқаннан кейін не ойлайды?
Dialogue: 0,0:14:05.76,0:14:07.88,Default,,0,0,0,,Сіз таң қаласыз.
Dialogue: 0,0:14:09.59,0:14:13.60,Default,,0,0,0,,‎Егер сіз зиян келтірсеңіз, сізді құтқаруға жол жоқ.
Dialogue: 0,0:14:16.93,0:14:18.60,Default,,0,0,0,,‎(Банумару) Әйелдер мен ерлер!
Dialogue: 0,0:14:19.19,0:14:21.73,Default,,0,0,0,,Көңілді жексенбінің түні келді!
Dialogue: 0,0:14:21.86,0:14:23.86,Default,,0,0,0,,Бүгін кеште құпия өнер сайысы!
Dialogue: 0,0:14:24.44,0:14:27.19,Default,,0,0,0,,‎Жарайды, біріншіден, біз ең жақсы соққылармыз!
Dialogue: 0,0:14:27.53,0:14:30.49,Default,,0,0,0,,‎Ало~ха~ое~
Dialogue: 0,0:14:30.61,0:14:32.66,Default,,0,0,0,,‎Банмару мен Нацу
Dialogue: 0,0:14:32.78,0:14:34.16,Default,,0,0,0,,‎(Барлық қошемет)
Dialogue: 0,0:14:34.29,0:14:35.66,Default,,0,0,0,,О!
Dialogue: 0,0:14:35.79,0:14:38.66,Default,,0,0,0,,Жүрек айну! Ашулы Гавайи халқы
Dialogue: 0,0:14:38.79,0:14:39.96,Default,,0,0,0,,О! О!
Dialogue: 0,0:14:40.08,0:14:41.38,Default,,0,0,0,,Дельфин!
Dialogue: 0,0:14:41.50,0:14:43.92,Default,,0,0,0,,‎Бұл дельфин емес, теңіз арыстаны. Тек «масалар» жарасады!
Dialogue: 0,0:14:43.92,0:14:44.75,Default,,0,0,0,,‎Бұл дельфин емес, теңіз арыстаны. Тек «масалар» жарасады!
Dialogue: 0,0:14:43.92,0:14:44.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:44.88,0:14:46.13,Default,,0,0,0,,‎(Барлығы күледі)
Dialogue: 0,0:14:46.63,0:14:48.59,Default,,0,0,0,,‎(Банумару) Піл мен теңіз арыстаны бар піл итбалығы
Dialogue: 0,0:14:48.72,0:14:49.22,Default,,0,0,0,,‎Леопон арыстан мен қабыланмен
Dialogue: 0,0:14:49.22,0:14:50.34,Default,,0,0,0,,‎Леопон арыстан мен қабыланмен
Dialogue: 0,0:14:49.22,0:14:50.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:50.34,0:14:50.93,Default,,0,0,0,,‎Леопон арыстан мен барыспен
Dialogue: 0,0:14:51.05,0:14:52.55,Default,,0,0,0,,Пон дегеніміз не?
Dialogue: 0,0:14:52.89,0:14:55.76,Default,,0,0,0,,‎(Банмару) Понзу соусы! (Барлығы күледі)
Dialogue: 0,0:14:56.14,0:14:59.52,Default,,0,0,0,,‎Неге... Мен саған қарап тұрмын, саған қатты қараймын...
Dialogue: 0,0:15:00.23,0:15:03.19,Default,,0,0,0,,‎Сіз шынымен Қансай аймағынансыз ба және комедияға өте талғампазсыз ба?
Dialogue: 0,0:15:03.31,0:15:05.90,Default,,0,0,0,,Қайда қарап тұрсың? Мен аяқтауды шешемін.
Dialogue: 0,0:15:06.36,0:15:09.49,Default,,0,0,0,,‎Аа, мен кенет қарасам, Мозукуды осы жерде көрдім!
Dialogue: 0,0:15:09.61,0:15:11.91,Default,,0,0,0,,Немесе… шаш...
Dialogue: 0,0:15:12.20,0:15:14.12,Default,,0,0,0,,‎(Нацу/Бамимару) Мен оны жөндедім!
Dialogue: 0,0:15:14.24,0:15:15.37,Default,,0,0,0,,‎(Мацуридің күлуі)
Dialogue: 0,0:15:15.49,0:15:18.62,Default,,0,0,0,,‎(Ясуи) Мен түсінбеймін. (Рё) Тым терең ойламаңыз.
Dialogue: 0,0:15:18.75,0:15:20.66,Default,,0,0,0,,‎(Ыдыс қағу дыбысы)
Dialogue: 0,0:15:21.29,0:15:23.17,Default,,0,0,0,,‎(Барлығы) Let's Limbo!
Dialogue: 0,0:15:23.71,0:15:24.75,Default,,0,0,0,,‎(Хаманумару) Әпке өте керемет!
Dialogue: 0,0:15:24.88,0:15:27.00,Default,,0,0,0,,‎Менің кеудем... Кеудемді уайымдаймын!
Dialogue: 0,0:15:27.63,0:15:30.51,Default,,0,0,0,,‎(Ясуи) Икемділік жаттығулары? (Рё) Бұл басқаша.
Dialogue: 0,0:15:30.88,0:15:36.06,Default,,0,0,0,,‎15 Токугава сегундары черлидинг кезінде кезекпен айтады!
Dialogue: 0,0:15:36.18,0:15:37.85,Default,,0,0,0,,Алға Жеңіс!
Dialogue: 0,0:15:37.97,0:15:40.18,Default,,0,0,0,,‎Иэясу Хидэтада Алға!
Dialogue: 0,0:15:40.31,0:15:42.65,Default,,0,0,0,,‎Иемицу Йошимунэ Иецугу Иехару…
Dialogue: 0,0:15:43.15,0:15:45.31,Default,,0,0,0,,‎(Ясуи) Тәртіпсіз (Рё) Оны жай қалдырыңыз
Dialogue: 0,0:15:45.81,0:15:47.48,Default,,0,0,0,,‎(Банмару) О, бұл сиқырлы қулық па?
Dialogue: 0,0:15:47.61,0:15:48.44,Default,,0,0,0,,Баспалдақ!
Dialogue: 0,0:15:48.98,0:15:50.44,Default,,0,0,0,,‎(Барлығы) Иә?
Dialogue: 0,0:15:51.07,0:15:52.45,Default,,0,0,0,,‎Токио мұнарасы
Dialogue: 0,0:15:52.91,0:15:53.78,Default,,0,0,0,,Бұл бесік пе?
Dialogue: 0,0:15:53.91,0:15:56.28,Default,,0,0,0,,‎(пиондардың күлкісі)
Dialogue: 0,0:15:56.41,0:15:59.91,Default,,0,0,0,,Балалар сендер басқа командалармен таныстыңдар ма?
Dialogue: 0,0:16:00.16,0:16:02.41,Default,,0,0,0,,Кенеттен тағы не болды?
Dialogue: 0,0:16:02.54,0:16:05.13,Default,,0,0,0,,‎Бамамару және басқалары көп кездесті, солай ма?
Dialogue: 0,0:16:05.25,0:16:07.25,Default,,0,0,0,,Біз күзгі командада кездестік!
Dialogue: 0,0:16:07.38,0:16:08.96,Default,,0,0,0,,Бұл ең нашар!
Dialogue: 0,0:16:09.09,0:16:09.92,Default,,0,0,0,,‎(Рё/Ясуи) Ммм...
Dialogue: 0,0:16:10.30,0:16:12.17,Default,,0,0,0,,‎Сен өліп қала жаздадың, солай ма?
Dialogue: 0,0:16:12.30,0:16:14.43,Default,,0,0,0,,Себебі олар тамақ ұрлайды.
Dialogue: 0,0:16:14.55,0:16:16.89,Default,,0,0,0,,‎Сосын Көктемнің мұқалмас жігіті...
Dialogue: 0,0:16:17.22,0:16:18.26,Default,,0,0,0,,А
Dialogue: 0,0:16:18.97,0:16:21.23,Default,,0,0,0,,Иті бар анау қарт
Dialogue: 0,0:16:21.35,0:16:25.19,Default,,0,0,0,,‎15 жыл жалғыз қыдырған қыста аман қалу
Dialogue: 0,0:16:25.31,0:16:27.40,Default,,0,0,0,,Иә, бұл өте қауіпті.
Dialogue: 0,0:16:27.52,0:16:29.65,Default,,0,0,0,,‎Бір қарағанда мейірімді болып көрінсе де, ол жай құбыжық емес.
Dialogue: 0,0:16:31.65,0:16:34.03,Default,,0,0,0,,‎Сен бізден қорықпайсың ба?
Dialogue: 0,0:16:34.49,0:16:39.08,Default,,0,0,0,,‎Бұл мүлде жаман емес. Сіз маған көмектестіңіз.
Dialogue: 0,0:16:39.20,0:16:41.37,Default,,0,0,0,,Сіз зұлымдық жасағыңыз келетін жастасыз.
Dialogue: 0,0:16:41.75,0:16:44.42,Default,,0,0,0,,‎Мен абай емес сияқтымын.
Dialogue: 0,0:16:44.54,0:16:45.83,Default,,0,0,0,,Бұл менмін.
Dialogue: 0,0:16:46.25,0:16:50.17,Default,,0,0,0,,Мен қала орталығында роумингте жүрген көптеген қауіпті адамдарды көрдім.
Dialogue: 0,0:16:50.30,0:16:52.97,Default,,0,0,0,,‎Сонымен салыстырғанда, сізде қанша...
Dialogue: 0,0:16:53.09,0:16:56.09,Default,,0,0,0,,«Менің ауыл мектебінде спорттық лагерім болды».
Dialogue: 0,0:16:56.22,0:16:58.14,Default,,0,0,0,,Бұл...
Dialogue: 0,0:16:58.26,0:17:02.02,Default,,0,0,0,,‎Түсіндім, бірде маған жылыжайда өстім деп айтты.
Dialogue: 0,0:17:02.14,0:17:05.56,Default,,0,0,0,,‎Рё, біз жылыжайда өскен жоқпыз.
Dialogue: 0,0:17:05.69,0:17:07.15,Default,,0,0,0,,Ол жерде олай емес...
Dialogue: 0,0:17:07.27,0:17:10.82,Default,,0,0,0,,Жылыжайда өскен жаман емес. Сіз кез келген нәрсеге айнала аласыз.
Dialogue: 0,0:17:11.32,0:17:12.40,Default,,0,0,0,,‎(Рё/Ясуи) Ах...
Dialogue: 0,0:17:13.07,0:17:15.78,Default,,0,0,0,,‎(Хаманумару) Енді келесі кім? (Отты) Иә
Dialogue: 0,0:17:16.49,0:17:20.24,Default,,0,0,0,,Негізі менің отбасым көріпкелдікпен күн көретін.
Dialogue: 0,0:17:20.87,0:17:24.54,Default,,0,0,0,,‎Менің ойымша, сол қол туған тағдырын бейнелейді.
Dialogue: 0,0:17:24.66,0:17:28.67,Default,,0,0,0,,‎Оң қол екі қолмен де қаралады, өйткені ол қазіргі сәттілікті білдіреді.
Dialogue: 0,0:17:30.00,0:17:31.84,Default,,0,0,0,,‎(От бляшка) Ха-а.
Dialogue: 0,0:17:31.96,0:17:34.01,Default,,0,0,0,,‎(От бляшка) Сіз өте романтиксіз.
Dialogue: 0,0:17:34.13,0:17:37.68,Default,,0,0,0,,‎Ол өз әлемінде армандаған қыз еді.
Dialogue: 0,0:17:37.80,0:17:41.22,Default,,0,0,0,,‎Мұны әжем «Армандағы Юмеко» деп атайды.
Dialogue: 0,0:17:41.35,0:17:42.77,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:43.02,0:17:48.06,Default,,0,0,0,,Бірақ қазір мен аяғымды жерге тигізбей, шындықпен күресуге тырысамын.
Dialogue: 0,0:17:48.19,0:17:49.02,Default,,0,0,0,,А
Dialogue: 0,0:17:49.15,0:17:51.19,Default,,0,0,0,,‎(Отты) Өйткені мен негізі ерік-жігері күшті адаммын...
Dialogue: 0,0:17:51.48,0:17:55.28,Default,,0,0,0,,Бұл жолдарда анық көрінеді.
Dialogue: 0,0:17:55.65,0:17:56.95,Default,,0,0,0,,Жақсы көрінеді.
Dialogue: 0,0:17:57.24,0:17:59.07,Default,,0,0,0,,А...
Dialogue: 0,0:18:01.83,0:18:02.95,Default,,0,0,0,,‎(От бляшка) О, күтпеген жерден
Dialogue: 0,0:18:03.49,0:18:06.08,Default,,0,0,0,,Сіз өте уайымсыз бала едіңіз, солай емес пе?
Dialogue: 0,0:18:06.21,0:18:08.12,Default,,0,0,0,,‎Мен сияқты генерал ба?
Dialogue: 0,0:18:08.25,0:18:09.88,Default,,0,0,0,,Өтірік айтасың ба?
Dialogue: 0,0:18:10.00,0:18:11.04,Default,,0,0,0,,‎(Араши) Уф...
Dialogue: 0,0:18:11.17,0:18:14.21,Default,,0,0,0,,‎(От бляшка) Ойланатын нәрселер көп...
Dialogue: 0,0:18:14.34,0:18:15.88,Default,,0,0,0,,Біз кездестік, солай ма?
Dialogue: 0,0:18:16.01,0:18:20.55,Default,,0,0,0,,‎Мен ол кісімен кездесіп, жүрекжарды алмасып, көңілді уақыт өткіздім.
Dialogue: 0,0:18:20.68,0:18:23.97,Default,,0,0,0,,‎Араши-кунды бүгінгідей етіп тұрған да осы.
Dialogue: 0,0:18:24.43,0:18:25.52,Default,,0,0,0,,Иә
Dialogue: 0,0:18:26.64,0:18:29.10,Default,,0,0,0,,‎(От бляшка) Мен мұны қарап шыға аламын ба?
Dialogue: 0,0:18:29.94,0:18:31.65,Default,,0,0,0,,‎Қолыңыздағы әжімдерге қарап не айта аласыз?
Dialogue: 0,0:18:32.02,0:18:33.36,Default,,0,0,0,,‎Hehehehe
Dialogue: 0,0:18:33.48,0:18:35.61,Default,,0,0,0,,‎Мен оны екі қолмен көргім келеді.
Dialogue: 0,0:18:35.73,0:18:37.90,Default,,0,0,0,,‎Жарақат алғандықтан, ол тек сол қолын ғана пайдаланады.
Dialogue: 0,0:18:38.36,0:18:41.16,Default,,0,0,0,,‎Сол қол сіздің тағдырыңыз...
Dialogue: 0,0:18:42.57,0:18:43.87,Default,,0,0,0,,Сіз не көріп тұрсыз?
Dialogue: 0,0:18:43.99,0:18:45.37,Default,,0,0,0,,‎(От құс) Иә...
Dialogue: 0,0:18:48.71,0:18:50.29,Default,,0,0,0,,Сіз не көріп тұрсыз?
Dialogue: 0,0:18:53.59,0:18:54.42,Default,,0,0,0,,‎(Барлығы) Иә?
Dialogue: 0,0:18:55.42,0:18:56.42,Default,,0,0,0,,А... А?
Dialogue: 0,0:18:56.92,0:18:57.92,Default,,0,0,0,,‎(Ясуи) Иә?
Dialogue: 0,0:18:58.05,0:18:59.93,Default,,0,0,0,,‎(От бляшка) А, бұл ештеңе емес.
Dialogue: 0,0:19:00.47,0:19:02.85,Default,,0,0,0,,Кейде бұл орын алады.
Dialogue: 0,0:19:02.97,0:19:06.60,Default,,0,0,0,,Кешіріңіз, мен оны бір қолмен қарай алмаймын.
Dialogue: 0,0:19:06.72,0:19:09.18,Default,,0,0,0,,Жарақатыңыз жазылғаннан кейін қайта келіңіз.
Dialogue: 0,0:19:11.35,0:19:14.19,Default,,0,0,0,,‎(Банумару) Жарайсың, үлкен құс! Chimaki Go!
Dialogue: 0,0:19:16.28,0:19:19.07,Default,,0,0,0,,‎Өнер дегенде ойыма осы ғана келеді.
Dialogue: 0,0:19:20.70,0:19:22.24,Default,,0,0,0,,Сейно!
Dialogue: 0,0:19:22.36,0:19:23.45,Default,,0,0,0,,‎(Барлығы) О!
Dialogue: 0,0:19:23.87,0:19:26.95,Default,,0,0,0,,‎Мен тіпті жаттығу жасамадым.
Dialogue: 0,0:19:27.29,0:19:29.83,Default,,0,0,0,,Бұл қызықсыз, сәтсіздікке ұшырады.
Dialogue: 0,0:19:29.96,0:19:32.46,Default,,0,0,0,,‎Дұрыс, Нацу, сен байқап көр.
Dialogue: 0,0:19:32.58,0:19:33.71,Default,,0,0,0,,Ех! ?
Dialogue: 0,0:19:34.25,0:19:37.17,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:37.67,0:19:38.92,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:19:39.05,0:19:41.68,Default,,0,0,0,,‎Нахахахаха уәде!
Dialogue: 0,0:19:41.80,0:19:43.93,Default,,0,0,0,,‎Сен өте күлкілісің, Нацу!
Dialogue: 0,0:19:44.22,0:19:45.47,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:45.60,0:19:47.89,Default,,0,0,0,,‎(Ясуи) Уайымдайтын ештеңе жоқ.
Dialogue: 0,0:19:48.43,0:19:51.39,Default,,0,0,0,,‎Кілт – тарту бұрышы, жылдамдық және батылдық.
Dialogue: 0,0:19:51.52,0:19:54.02,Default,,0,0,0,,‎Мұны кез келген адам бірнеше рет жаттығудан кейін жасай алады.
Dialogue: 0,0:19:54.15,0:19:55.61,Default,,0,0,0,,Бұл күлетін нәрсе емес.
Dialogue: 0,0:19:55.98,0:19:57.86,Default,,0,0,0,,‎Ах (барлығы) Ах...
Dialogue: 0,0:19:58.53,0:20:01.49,Default,,0,0,0,,‎Хе, бұл керемет.
Dialogue: 0,0:20:02.32,0:20:03.99,Default,,0,0,0,,Жеңімпаз - Хотару-чан
Dialogue: 0,0:20:04.11,0:20:05.99,Default,,0,0,0,,Сіз 5 ұпай аласыз!
Dialogue: 0,0:20:06.12,0:20:07.45,Default,,0,0,0,,Келесі аптада не істейсіз?
Dialogue: 0,0:20:07.58,0:20:10.37,Default,,0,0,0,,Канджи сынағы? (Бамимару) Мен сені өлтіремін, Араши!
Dialogue: 0,0:20:10.75,0:20:13.83,Default,,0,0,0,,‎Натчан Сен істедің, Натчан!
Dialogue: 0,0:20:13.96,0:20:15.38,Default,,0,0,0,,Бұрын бұл не болды?
Dialogue: 0,0:20:15.50,0:20:17.50,Default,,0,0,0,,Натчанға бір көргеннен ғашық болып қалмадың ба?
Dialogue: 0,0:20:17.63,0:20:19.92,Default,,0,0,0,,‎Мен... Мен олай емес деп ойлаймын.
Dialogue: 0,0:20:20.46,0:20:23.76,Default,,0,0,0,,Бар болуы мүмкін, бірақ мен бұл жолы сенімен бірге боламын.
Dialogue: 0,0:20:23.88,0:20:25.14,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:25.26,0:20:28.72,Default,,0,0,0,,‎Аа...Мен ешкім бола алмаймын.
Dialogue: 0,0:20:32.06,0:20:35.60,Default,,0,0,0,,Бұл мен ғана емес, басқа біреу де емес.
Dialogue: 0,0:20:35.98,0:20:38.57,Default,,0,0,0,,‎Аа... Кешіріңіз.
Dialogue: 0,0:20:38.69,0:20:39.94,Default,,0,0,0,,Ihi
Dialogue: 0,0:20:40.07,0:20:43.36,Default,,0,0,0,,‎Бірақ бұл кез келген сымбатты жігіт болуы мүмкін.
Dialogue: 0,0:20:43.49,0:20:45.78,Default,,0,0,0,,‎Онда мен Рёкунды таңдайтын шығармын.
Dialogue: 0,0:20:45.91,0:20:47.03,Default,,0,0,0,,А...
Dialogue: 0,0:20:47.16,0:20:49.62,Default,,0,0,0,,‎Хехе, барымызды салайық, Натчан
Dialogue: 0,0:20:49.74,0:20:53.83,Default,,0,0,0,,‎Фуфуфуфу натчан жекпе-жек~! қайырлы түн!
Dialogue: 0,0:20:53.96,0:20:56.50,Default,,0,0,0,,Мен Мацури-чанды ренжіттім...
Dialogue: 0,0:20:56.63,0:20:58.42,Default,,0,0,0,,‎Сен мені жек көрген шығарсың...
Dialogue: 0,0:20:58.84,0:21:00.13,Default,,0,0,0,,‎(Ясуи) Әй, ә
Dialogue: 0,0:21:01.92,0:21:03.30,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:11.47,0:21:13.68,Default,,0,0,0,,‎(Араши) Эй, Хибари-чан жоқ!
Dialogue: 0,0:21:13.81,0:21:15.35,Default,,0,0,0,,‎(Мозу) Мен таңертең ерте шықтым.
Dialogue: 0,0:21:15.85,0:21:17.94,Default,,0,0,0,,Сіз кеттіңіз бе? бұл не
Dialogue: 0,0:21:18.06,0:21:19.36,Default,,0,0,0,,‎Балаңызды жалғыз жібердіңіз бе?
Dialogue: 0,0:21:19.48,0:21:20.86,Default,,0,0,0,,‎(От бляшка) Жарайды.
Dialogue: 0,0:21:21.28,0:21:25.99,Default,,0,0,0,,Мен біреумен біргемін. Мен өзімді өте тыныш сезінемін, бұл сирек.
Dialogue: 0,0:21:26.53,0:21:27.91,Default,,0,0,0,,‎Кім...
Dialogue: 0,0:21:28.24,0:21:30.74,Default,,0,0,0,,‎(От құс) Хибари-чан мұнда болғысы келмейді.
Dialogue: 0,0:21:30.87,0:21:32.87,Default,,0,0,0,,‎Себебі сен мені жек көресің
Dialogue: 0,0:21:33.00,0:21:35.00,Default,,0,0,0,,‎Маған қалағанымды істеуге рұқсат етіңіз
Dialogue: 0,0:21:35.29,0:21:39.63,Default,,0,0,0,,‎Хибари-чан, ол бәрінен де бақытты және бәрінен де күшті...
Dialogue: 0,0:21:39.75,0:21:42.00,Default,,0,0,0,,Мен мұны өзім де түсінбеймін.
Dialogue: 0,0:21:42.13,0:21:44.42,Default,,0,0,0,,‎Ендеше, бәрі жақсы.
Dialogue: 0,0:21:46.88,0:21:48.39,Default,,0,0,0,,Мен қобалжып, шошып кетемін, сондықтан менде күш жоқ.
Dialogue: 0,0:21:48.39,0:21:49.47,Default,,0,0,0,,Мен қобалжығаным сонша, электр қуатын сөндіре алмаймын.
Dialogue: 0,0:21:48.39,0:21:49.47,Default,,0,0,0,,‎(Араши) Иә? Нацу?
Dialogue: 0,0:21:50.05,0:21:52.97,Default,,0,0,0,,‎(Ясуи) Сен шынымен де істей аласың... соны маған көрсет.
Dialogue: 0,0:21:53.10,0:21:54.06,Default,,0,0,0,,бұл… иә
Dialogue: 0,0:21:54.43,0:21:55.89,Default,,0,0,0,,‎Ясуидің бейбақы…
Dialogue: 0,0:21:56.02,0:21:58.94,Default,,0,0,0,,Сіз мені бір соққымен ұра аласыз ба?
Dialogue: 0,0:21:59.27,0:22:01.36,Default,,0,0,0,,Менің әйеліме тиіспе.
Dialogue: 0,0:22:01.48,0:22:02.15,Default,,0,0,0,,‎Бамамару!
Dialogue: 0,0:22:02.61,0:22:05.57,Default,,0,0,0,,‎Негізі, мені Банимару қатты ұрды...
Dialogue: 0,0:22:05.69,0:22:08.66,Default,,0,0,0,,Маған айқайлап, мазақ етіп тұрсың, неге үндемейсің?
Dialogue: 0,0:22:08.78,0:22:12.33,Default,,0,0,0,,‎Мм... жоқ, бұл манзай болғандықтан...
Dialogue: 0,0:22:13.20,0:22:16.62,Default,,0,0,0,,‎Бұл адам неге сонша мейірімді? ?
Dialogue: 0,0:22:16.75,0:22:18.58,Default,,0,0,0,,‎(Банумару) Эй, сен не істеп жатырсың?
Dialogue: 0,0:22:18.92,0:22:19.83,Default,,0,0,0,,Тәжірибе
Dialogue: 0,0:22:19.96,0:22:21.67,Default,,0,0,0,,Сәлем, жаттығу.
Dialogue: 0,0:22:22.17,0:22:24.25,Default,,0,0,0,,‎(Араши) Банумару! (Бамимару) Хмм...
Dialogue: 0,0:22:31.68,0:22:36.68,Default,,0,0,0,,♪～
Dialogue: 0,0:22:38.18,0:22:44.18,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory