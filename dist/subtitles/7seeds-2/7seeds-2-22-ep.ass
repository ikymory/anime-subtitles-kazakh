Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:13.51,0:00:14.59,Default,,0,0,0,,‎(гүл) га…
Dialogue: 0,0:00:17.80,0:00:20.52,Default,,0,0,0,,Мүмкін Фудзико-чан шығар?
Dialogue: 0,0:00:20.64,0:00:25.98,Default,,0,0,0,,Сәлем! Бұл Фудзико-чан емес пе?
Dialogue: 0,0:00:26.40,0:00:28.06,Default,,0,0,0,,‎(Фудзико) Бұл Фудзико!
Dialogue: 0,0:00:28.19,0:00:29.94,Default,,0,0,0,,‎Хана-чан? қайда?
Dialogue: 0,0:00:30.36,0:00:31.48,Default,,0,0,0,,‎Ха!
Dialogue: 0,0:00:31.90,0:00:33.57,Default,,0,0,0,,Қазір сонда барыңыз!
Dialogue: 0,0:00:34.07,0:00:35.82,Default,,0,0,0,,Балалар сендер қозғалмайсыңдар
Dialogue: 0,0:00:35.95,0:00:39.12,Default,,0,0,0,,‎Төмен түсу қауіпті, сондықтан тыныш болыңыз.
Dialogue: 0,0:00:39.24,0:00:40.08,Default,,0,0,0,,‎(құлын айқайы)
Dialogue: 0,0:00:44.29,0:00:45.71,Default,,0,0,0,,‎(Гүл) тірі еді...
Dialogue: 0,0:00:46.25,0:00:47.08,Default,,0,0,0,,Ол тірі еді!
Dialogue: 0,0:00:48.13,0:00:49.34,Default,,0,0,0,,‎Фудзико-чан…
Dialogue: 0,0:00:49.46,0:00:53.47,Default,,0,0,0,,Мен бәріне рұқсатсыз келгені үшін ашуланатын шығармын...
Dialogue: 0,0:00:53.76,0:00:55.72,Default,,0,0,0,,Сіз таң қалуыңыз мүмкін, бірақ...
Dialogue: 0,0:00:56.59,0:00:57.76,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:00:58.01,0:00:59.30,Default,,0,0,0,,‎(Гүл) Әй...
Dialogue: 0,0:01:00.26,0:01:02.31,Default,,0,0,0,,‎(Фудзико) Хана… Хана-чан…
Dialogue: 0,0:01:04.89,0:01:06.56,Default,,0,0,0,,Сен тірісің бе?
Dialogue: 0,0:01:07.19,0:01:08.27,Default,,0,0,0,,‎(Гүл) Ух...
Dialogue: 0,0:01:08.98,0:01:10.36,Default,,0,0,0,,А...
Dialogue: 0,0:01:13.32,0:01:14.86,Default,,0,0,0,,‎(Гүлдердің жылауы)
Dialogue: 0,0:01:16.91,0:01:21.91,Default,,0,0,0,,♪～
Dialogue: 0,0:02:37.19,0:02:42.20,Default,,0,0,0,,～♪
Dialogue: 0,0:02:46.62,0:02:50.62,Default,,0,0,0,,Ха ха ха, сенің шашың қайырлы!
Dialogue: 0,0:02:50.75,0:02:52.50,Default,,0,0,0,,Жабайы баладай болдым
Dialogue: 0,0:02:52.88,0:02:57.17,Default,,0,0,0,,‎Ахаха, дұрыс, ол жас келіншекке көбірек ұқсады.
Dialogue: 0,0:02:57.42,0:03:01.51,Default,,0,0,0,,Мен Чиса-чанның сені нағыз жас ханым деп айтқанын қаламаймын!
Dialogue: 0,0:03:02.43,0:03:06.97,Default,,0,0,0,,‎(Фудзико) Хана Егер мен сені кездестірсем, мен сені ұрып-соғуды ойладым.
Dialogue: 0,0:03:07.10,0:03:08.81,Default,,0,0,0,,Не болды?
Dialogue: 0,0:03:09.85,0:03:14.40,Default,,0,0,0,,‎Менің терім... көк-күлгін ысқырықты.
Dialogue: 0,0:03:14.86,0:03:16.36,Default,,0,0,0,,‎Ол барған сайын таралуда...
Dialogue: 0,0:03:16.48,0:03:20.53,Default,,0,0,0,,‎Мен Шинмаки мырзадан сұрағанымда, ол бәрі еріп бара жатқанын айтты.
Dialogue: 0,0:03:20.95,0:03:25.62,Default,,0,0,0,,‎Бұл жақсы емес деп ойладым, адамдардың мені бұлай көргенін қаламадым.
Dialogue: 0,0:03:25.74,0:03:28.08,Default,,0,0,0,,‎(Фудзико) Менің ойымша, бұл сіздің айтқысы келгеніңіз ...
Dialogue: 0,0:03:28.54,0:03:31.58,Default,,0,0,0,,‎Бірақ оны дұрыс айту керек!
Dialogue: 0,0:03:31.71,0:03:34.92,Default,,0,0,0,,Мен уайымдадым, өйткені мен мұңайдым!
Dialogue: 0,0:03:36.54,0:03:37.84,Default,,0,0,0,,‎(Гүл) Кешіріңіз...
Dialogue: 0,0:03:38.59,0:03:39.71,Default,,0,0,0,,‎(Фудзико) Жарайды.
Dialogue: 0,0:03:39.84,0:03:44.34,Default,,0,0,0,,Кешкі ас ішу кезінде бір-біріміздің өткен тәжірибеміз туралы сөйлесейік.
Dialogue: 0,0:03:44.93,0:03:47.01,Default,,0,0,0,,Ас пісіріңіз.
Dialogue: 0,0:03:47.89,0:03:49.06,Default,,0,0,0,,Иә иә
Dialogue: 0,0:03:49.18,0:03:50.60,Default,,0,0,0,,‎Хана-чан, осылай.
Dialogue: 0,0:03:51.10,0:03:53.10,Default,,0,0,0,,Фудзико-сан бақытты көрінеді
Dialogue: 0,0:03:53.44,0:03:55.86,Default,,0,0,0,,Мен көптен бері өзімді жақсы сезінбей жүрмін.
Dialogue: 0,0:03:56.31,0:03:58.69,Default,,0,0,0,,Күн сайын тамақ іздеймін
Dialogue: 0,0:03:59.07,0:04:02.53,Default,,0,0,0,,Менің денем әлсіз, менде үміт жоқ ...
Dialogue: 0,0:04:02.82,0:04:06.24,Default,,0,0,0,,‎(Гүл) Ойланып қарасам, екеуміз де қатты арықтадық...
Dialogue: 0,0:04:06.45,0:04:07.66,Default,,0,0,0,,‎Бәрінен де артық―
Dialogue: 0,0:04:07.78,0:04:12.25,Default,,0,0,0,,‎Мен өмір бойы ешкімді кездестіре алмайтын шығармын деп ойлаудың өзі ауырады...
Dialogue: 0,0:04:12.58,0:04:15.88,Default,,0,0,0,,‎Сондықтан мен де танысқаныма қуаныштымын.
Dialogue: 0,0:04:16.00,0:04:19.46,Default,,0,0,0,,‎Оған қоса, Хана-чан... Мен өзімді жақсы сезінемін.
Dialogue: 0,0:04:20.71,0:04:24.84,Default,,0,0,0,,‎(Фудзико) Содан су тасқыны болып, бірдеңе бүлінді...
Dialogue: 0,0:04:25.18,0:04:29.72,Default,,0,0,0,,‎Жер бедері өзгерді, мен бастапқы орныма орала алмаймын.
Dialogue: 0,0:04:29.85,0:04:32.43,Default,,0,0,0,,Бақытымызға орай, менде багажым болды.
Dialogue: 0,0:04:32.56,0:04:35.27,Default,,0,0,0,,‎Екеуміз қозғала бердік...
Dialogue: 0,0:04:35.65,0:04:37.65,Default,,0,0,0,,Мен осында қоныстандым.
Dialogue: 0,0:04:37.94,0:04:43.44,Default,,0,0,0,,мырза. Шинмаки мен Хару артымнан ерді, біз бірге батысқа бардық...
Dialogue: 0,0:04:43.65,0:04:46.86,Default,,0,0,0,,Баспана тауып, кіргеннен кейін мен Күз командасын кездестірдім...
Dialogue: 0,0:04:47.07,0:04:49.70,Default,,0,0,0,,Күз? Басқа командалармен таныстыңыз ба?
Dialogue: 0,0:04:49.99,0:04:51.83,Default,,0,0,0,,‎(Гүл) Иә, одан кейін біраз уақытқа...
Dialogue: 0,0:04:51.95,0:04:55.29,Default,,0,0,0,,Мен күзгі команданың адамдарымен жұмыс істедім...
Dialogue: 0,0:04:55.42,0:04:57.29,Default,,0,0,0,,А, Момота жақсы.
Dialogue: 0,0:04:57.67,0:05:00.25,Default,,0,0,0,,Шынымен бе? Сізбен танысқаныма қуаныштымын?
Dialogue: 0,0:05:00.55,0:05:03.59,Default,,0,0,0,,Иә, мені жазда А...
Dialogue: 0,0:05:03.84,0:05:04.67,Default,,0,0,0,,‎Ха!
Dialogue: 0,0:05:11.47,0:05:15.85,Default,,0,0,0,,‎(Гүл) Әлгі екі адам мені өлтіре жаздағаны есімде...
Dialogue: 0,0:05:17.77,0:05:19.19,Default,,0,0,0,,‎(Банмару) Сәлем бәріңе...
Dialogue: 0,0:05:19.61,0:05:21.94,Default,,0,0,0,,‎(Банмару) Бұл зымыран емес пе?
Dialogue: 0,0:05:22.07,0:05:25.49,Default,,0,0,0,,Шынымен бе? Зымыран деген нәрсе жоқ, солай ма?
Dialogue: 0,0:05:25.61,0:05:28.41,Default,,0,0,0,,Мүмкін жанармай сияқты бірдеңе шығар, солай ма? Рё-кун
Dialogue: 0,0:05:30.28,0:05:31.74,Default,,0,0,0,,Ал, бірақ зымырандар...
Dialogue: 0,0:05:31.87,0:05:34.37,Default,,0,0,0,,‎Бұл маңызды емес, өйткені ол асқазанға қосылмайды.
Dialogue: 0,0:05:34.50,0:05:35.25,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:35.75,0:05:38.42,Default,,0,0,0,,‎Натчан, сен қай жолмен жүрдің?
Dialogue: 0,0:05:38.54,0:05:42.05,Default,,0,0,0,,‎(Банмару) Айтпақшы, мен шыңға шыққым келеді, бірақ баруға жол жоқ.
Dialogue: 0,0:05:42.17,0:05:44.26,Default,,0,0,0,,‎Бұл жалғыз жол
Dialogue: 0,0:05:45.63,0:05:48.13,Default,,0,0,0,,Фан-чин! (Бамимару) Жақсы!
Dialogue: 0,0:05:51.93,0:05:53.06,Default,,0,0,0,,‎Тоу!
Dialogue: 0,0:05:56.06,0:05:58.48,Default,,0,0,0,,‎Аа... Кешіріңіз.
Dialogue: 0,0:05:58.60,0:06:01.44,Default,,0,0,0,,Сіз тағы да ренжідіңіз бе? Сіз ашулы болдыңыз, солай ма?
Dialogue: 0,0:06:02.32,0:06:03.52,Default,,0,0,0,,‎(Рё) Жеткілікті.
Dialogue: 0,0:06:03.65,0:06:07.40,Default,,0,0,0,,‎Идиоттар ақымақ сияқты өмір сүруі керек, бұл дұрыс әрекет.
Dialogue: 0,0:06:07.90,0:06:09.70,Default,,0,0,0,,Біз де фестивальге барайық
Dialogue: 0,0:06:09.82,0:06:10.70,Default,,0,0,0,,‎Сәлеметсіз бе, хи...
Dialogue: 0,0:06:14.91,0:06:17.04,Default,,0,0,0,,‎Ха… га…
Dialogue: 0,0:06:17.41,0:06:20.04,Default,,0,0,0,,‎(Ясуи) Нацу: Енді сіз мәнді түсіндіңіз бе?
Dialogue: 0,0:06:20.17,0:06:21.38,Default,,0,0,0,,Денеңізді созбаңыз!
Dialogue: 0,0:06:21.83,0:06:23.71,Default,,0,0,0,,‎Аа... Уф...
Dialogue: 0,0:06:25.96,0:06:27.67,Default,,0,0,0,,‎(Ясуи) Су ағып жатыр...
Dialogue: 0,0:06:27.97,0:06:29.47,Default,,0,0,0,,Сақ болыңыз, өйткені сіз тайып кетесіз!
Dialogue: 0,0:06:29.80,0:06:32.68,Default,,0,0,0,,‎Ха… ха… ха…
Dialogue: 0,0:06:33.26,0:06:35.97,Default,,0,0,0,,‎(Араши) Нацу Сол қолыңды сол түтікке қой!
Dialogue: 0,0:06:36.35,0:06:38.02,Default,,0,0,0,,‎Хехе...
Dialogue: 0,0:06:38.48,0:06:42.61,Default,,0,0,0,,‎(Ясуи) Дұрыс, енді құлама, енді ешқашан!
Dialogue: 0,0:06:43.11,0:06:44.15,Default,,0,0,0,,Ах! (Ясуи) Ха!
Dialogue: 0,0:06:44.52,0:06:45.69,Default,,0,0,0,,Ах! (Араши) Нацу!
Dialogue: 0,0:06:46.48,0:06:47.61,Default,,0,0,0,,А...
Dialogue: 0,0:06:47.74,0:06:51.53,Default,,0,0,0,,‎Ха ха ха ха ха ха...
Dialogue: 0,0:06:51.91,0:06:54.95,Default,,0,0,0,,Нацу, жақсысың ба? Сіз оны бір жерден соқтыңыз ба?
Dialogue: 0,0:06:55.08,0:06:59.83,Default,,0,0,0,,‎Сәлеметсіз бе... Менің тізем сәл... бірақ бәрібір.
Dialogue: 0,0:06:59.96,0:07:02.38,Default,,0,0,0,,мырза. Ясуи, Нацу жақсы!
Dialogue: 0,0:07:02.96,0:07:05.75,Default,,0,0,0,,Өйткені Ясуи мырза арқанды қолдады!
Dialogue: 0,0:07:07.63,0:07:08.97,Default,,0,0,0,,мырза. Ясуи?
Dialogue: 0,0:07:11.30,0:07:13.80,Default,,0,0,0,,‎Уф... Уф
Dialogue: 0,0:07:14.26,0:07:16.31,Default,,0,0,0,,‎Уф... Уф!
Dialogue: 0,0:07:18.02,0:07:22.35,Default,,0,0,0,,‎Аа, Ясуи-кун, не болды?
Dialogue: 0,0:07:22.48,0:07:23.31,Default,,0,0,0,,мырза. Ясуи! ?
Dialogue: 0,0:07:23.65,0:07:27.78,Default,,0,0,0,,‎(Ясуи) Әй... балалар... осылай өрмелесеңдер...
Dialogue: 0,0:07:27.90,0:07:30.65,Default,,0,0,0,,‎Арқан нені білдіреді... Уф...
Dialogue: 0,0:07:30.95,0:07:32.07,Default,,0,0,0,,мырза. Ясуи
Dialogue: 0,0:07:32.20,0:07:35.58,Default,,0,0,0,,‎(Ясуи) Уф... мен құладым... құладым...
Dialogue: 0,0:07:35.87,0:07:39.62,Default,,0,0,0,,‎Шигеру… Шигеру…
Dialogue: 0,0:07:39.75,0:07:43.21,Default,,0,0,0,,Арқанды кескен Рё болды... Бірақ...
Dialogue: 0,0:07:43.33,0:07:47.04,Default,,0,0,0,,‎Бәрі менің кінәм... Мен оны өлтірдім...
Dialogue: 0,0:07:47.50,0:07:49.05,Default,,0,0,0,,Бұл бұталы…
Dialogue: 0,0:07:49.42,0:07:52.72,Default,,0,0,0,,Сіз әктас үңгірге ұқсайтын үңгірден өтіп бара жатырсыз, солай ма?
Dialogue: 0,0:07:52.93,0:07:56.35,Default,,0,0,0,,Шигеруге не болды?
Dialogue: 0,0:07:57.72,0:08:02.44,Default,,0,0,0,,Бұл сынақ. Бұл жетіліктің бірі ретінде таңдалатын сынақ!
Dialogue: 0,0:08:02.73,0:08:05.86,Default,,0,0,0,,Шигеру құлады! Раушан да, кокон да!
Dialogue: 0,0:08:05.98,0:08:07.15,Default,,0,0,0,,Барлығы жойылды!
Dialogue: 0,0:08:08.19,0:08:10.99,Default,,0,0,0,,Жетіден басқасы өлтірілді!
Dialogue: 0,0:08:11.19,0:08:14.32,Default,,0,0,0,,Сіз нені айтып тұрсыз? Сынақ дегеніміз...
Dialogue: 0,0:08:14.70,0:08:16.07,Default,,0,0,0,,Бұл сынақ!
Dialogue: 0,0:08:16.20,0:08:20.41,Default,,0,0,0,,Болашаққа баратын жеті адамды таңдау өмірге қауіп төндіретін сынақ!
Dialogue: 0,0:08:20.54,0:08:21.54,Default,,0,0,0,,‎(Араши/Нацу) Ах...
Dialogue: 0,0:08:22.54,0:08:26.67,Default,,0,0,0,,‎(құбырды түрту дыбысы)
Dialogue: 0,0:08:26.79,0:08:30.05,Default,,0,0,0,,‎Аа... ешбір дауысты естімедің бе?
Dialogue: 0,0:08:30.30,0:08:33.22,Default,,0,0,0,,‎Бұл өте қатты!
Dialogue: 0,0:08:44.19,0:08:46.02,Default,,0,0,0,,Бұл жетіліктің бірі ретінде таңдалатын сынақ.
Dialogue: 0,0:08:46.02,0:08:46.85,Default,,0,0,0,,Бұл жетіліктің бірі ретінде таңдалатын сынақ.
Dialogue: 0,0:08:46.02,0:08:46.85,Default,,0,0,0,,‎(Рё) Осы жерден...
Dialogue: 0,0:08:47.36,0:08:49.23,Default,,0,0,0,,‎Е, бұл дауыс Ясуи емес пе?
Dialogue: 0,0:08:49.36,0:08:50.40,Default,,0,0,0,,Бұл Ясуи-кун!
Dialogue: 0,0:08:50.82,0:08:52.11,Default,,0,0,0,,‎(Ясуи) Бұл сынақ!
Dialogue: 0,0:08:52.24,0:08:56.78,Default,,0,0,0,,Болашаққа аттанатын жеті адамды таңдау өмірге қауіп төндіретін сынақ!
Dialogue: 0,0:08:57.41,0:09:00.79,Default,,0,0,0,,‎(Рё) Әлгі ақымақ... тағы да сөйлейді...
Dialogue: 0,0:09:01.16,0:09:03.20,Default,,0,0,0,,‎Бұл не...
Dialogue: 0,0:09:03.33,0:09:07.29,Default,,0,0,0,,Сіз мұны істедіңіз бе? «7SEEDS» жобасы дегеніміз не?
Dialogue: 0,0:09:07.88,0:09:11.25,Default,,0,0,0,,Сіз өзіңіздің жазғы А командасын осылай таңдайсыз ба?
Dialogue: 0,0:09:11.55,0:09:12.84,Default,,0,0,0,,Қорқынышты...
Dialogue: 0,0:09:13.21,0:09:15.47,Default,,0,0,0,,Сіз түсінбейсіз...
Dialogue: 0,0:09:15.88,0:09:17.97,Default,,0,0,0,,‎Мұнда аң-таң болып келгендер үшін!
Dialogue: 0,0:09:18.39,0:09:21.72,Default,,0,0,0,,‎Иә, мен оны елестете де алмаймын.
Dialogue: 0,0:09:21.85,0:09:22.81,Default,,0,0,0,,Бұл өте жаман...
Dialogue: 0,0:09:23.02,0:09:24.89,Default,,0,0,0,,Түсіну мүмкін емес
Dialogue: 0,0:09:25.64,0:09:27.19,Default,,0,0,0,,Сол сынақ...
Dialogue: 0,0:09:27.44,0:09:32.28,Default,,0,0,0,,‎Біз жеті адам таңдау үшін ғана өмір сүрдік...
Dialogue: 0,0:09:33.15,0:09:34.28,Default,,0,0,0,,Мм...
Dialogue: 0,0:09:34.53,0:09:39.28,Default,,0,0,0,,‎Иә, білмеймін... бірақ мен осындай нәрсені бастан өткеруге мәжбүр болдым...
Dialogue: 0,0:09:39.91,0:09:41.24,Default,,0,0,0,,‎Неге қашпадың?
Dialogue: 0,0:09:41.53,0:09:42.62,Default,,0,0,0,,‎(Ясуи) Ах...
Dialogue: 0,0:09:45.12,0:09:46.21,Default,,0,0,0,,Қашып кету керек пе?
Dialogue: 0,0:09:46.62,0:09:47.46,Default,,0,0,0,,‎(Рё) Ах...
Dialogue: 0,0:09:47.75,0:09:50.00,Default,,0,0,0,,‎(Банмару) Араши! Аа, бұл Араши-кун, бұл дауыс
Dialogue: 0,0:09:50.13,0:09:51.59,Default,,0,0,0,,Эй, о...
Dialogue: 0,0:09:52.75,0:09:54.09,Default,,0,0,0,,Қашып кету керек пе?
Dialogue: 0,0:09:57.72,0:10:01.97,Default,,0,0,0,,Иә, бәріміз бірігіп, мұғалімді байлап алайық.
Dialogue: 0,0:10:02.10,0:10:05.43,Default,,0,0,0,,‎Сіз сыртқа жүгіре алмай, көмекке шақырдыңыз ба?
Dialogue: 0,0:10:06.89,0:10:09.73,Default,,0,0,0,,Бұл мұхиттағы жалғыз арал ма, әлде түрме ме?
Dialogue: 0,0:10:10.27,0:10:12.73,Default,,0,0,0,,‎Оны қарулары бар адамдар қамап тастады...
Dialogue: 0,0:10:12.86,0:10:15.40,Default,,0,0,0,,‎Жоқ, олай емес...
Dialogue: 0,0:10:15.61,0:10:18.03,Default,,0,0,0,,‎Таулардың бір жерінде мен білмеймін...
Dialogue: 0,0:10:19.07,0:10:20.87,Default,,0,0,0,,‎Жоқ, қашу дегенді қалай түсінесіңдер?
Dialogue: 0,0:10:20.99,0:10:23.70,Default,,0,0,0,,Қашудың қажеті жоқ. Сізді 7 адам таңдамайды!
Dialogue: 0,0:10:24.04,0:10:25.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:25.49,0:10:27.54,Default,,0,0,0,,Сонымен, көңіліңізден шықты ма?
Dialogue: 0,0:10:27.66,0:10:30.33,Default,,0,0,0,,Мен тест тапсырғым келді, өйткені мен оны тапсырғым келді.
Dialogue: 0,0:10:30.46,0:10:33.13,Default,,0,0,0,,‎(Ясуи) Жоқ... жоқ, бірақ...
Dialogue: 0,0:10:33.25,0:10:36.51,Default,,0,0,0,,Болашаққа өзіңіз барғыңыз келді ме?
Dialogue: 0,0:10:37.42,0:10:40.22,Default,,0,0,0,,‎Дұрыс, мен мұнда келгендіктен келдім!
Dialogue: 0,0:10:40.34,0:10:43.01,Default,,0,0,0,,‎Мен не болса да болашаққа баратын 7 адамның бірі ретінде таңдалғым келді!
Dialogue: 0,0:10:43.55,0:10:45.39,Default,,0,0,0,,‎(Ясуи) Әрине! (Араши) Олай болса...
Dialogue: 0,0:10:45.51,0:10:48.52,Default,,0,0,0,,Мақсатыңызға жеткеніңізге қуаныштысыз ба?
Dialogue: 0,0:10:48.98,0:10:50.10,Default,,0,0,0,,№.
Dialogue: 0,0:10:50.65,0:10:53.27,Default,,0,0,0,,‎Бұл біртүрлі, Ясуи-сан, не айтып тұрсың!
Dialogue: 0,0:10:54.11,0:10:57.32,Default,,0,0,0,,‎Бұл дәл қазір қатты ауыратын сияқты, ал бұл қалыпты жағдай?
Dialogue: 0,0:10:57.90,0:11:01.16,Default,,0,0,0,,‎Ол мұғалімдер сізге шынымен не істеді? ?
Dialogue: 0,0:11:01.45,0:11:02.78,Default,,0,0,0,,А...
Dialogue: 0,0:11:03.66,0:11:08.20,Default,,0,0,0,,‎Эй Рё, бұл әңгіме де сен туралы...
Dialogue: 0,0:11:09.08,0:11:12.83,Default,,0,0,0,,‎(Рё) Мынаны шешіп, ішке кірейік. Ол алда сияқты.
Dialogue: 0,0:11:12.96,0:11:14.09,Default,,0,0,0,,‎(Банмару) О... О
Dialogue: 0,0:11:14.50,0:11:16.92,Default,,0,0,0,,‎(Араши) Мұны бәріңіз біліп, қабылдадыңыз ба?
Dialogue: 0,0:11:17.59,0:11:21.34,Default,,0,0,0,,‎Достарымды өлтірсе бәрібір, мен болашаққа барғым келеді
Dialogue: 0,0:11:21.80,0:11:23.72,Default,,0,0,0,,Барлығы осылай ойлады ма?
Dialogue: 0,0:11:25.72,0:11:28.52,Default,,0,0,0,,Олай болса, бұл миды жуумен бірдей емес пе?
Dialogue: 0,0:11:28.64,0:11:29.60,Default,,0,0,0,,‎Ха!
Dialogue: 0,0:11:30.56,0:11:34.27,Default,,0,0,0,,(Корири) Неге мен бара аламын, ал Маю-чан бармаймын? Неге! ?
Dialogue: 0,0:11:34.56,0:11:35.69,Default,,0,0,0,,‎(Ясуи) Ах...
Dialogue: 0,0:11:37.73,0:11:39.44,Default,,0,0,0,,Миды жуу деген не...
Dialogue: 0,0:11:39.57,0:11:42.11,Default,,0,0,0,,‎Араши Сіз адамдарға ақымақ сияқты қарауға тырысасыз ба? ?
Dialogue: 0,0:11:42.41,0:11:45.53,Default,,0,0,0,,‎Бұл менің қалағаным емес, бұл менің ойлағаным емес.
Dialogue: 0,0:11:45.66,0:11:46.99,Default,,0,0,0,,‎Бұл мұғалімдерге ыңғайлы.
Dialogue: 0,0:11:47.24,0:11:49.66,Default,,0,0,0,,Мен бұл туралы ойладым! Бұл менің ойым!
Dialogue: 0,0:11:49.79,0:11:53.75,Default,,0,0,0,,Мен күн сайын қатты ойладым! тапсырманы қалай орындау керек
Dialogue: 0,0:11:54.25,0:11:57.63,Default,,0,0,0,,‎Әр уақытта шыңды алыңыз немесе құлап кетпеуге тырысыңыз!
Dialogue: 0,0:11:57.75,0:11:59.51,Default,,0,0,0,,Мен бұл туралы өз басыммен ойладым!
Dialogue: 0,0:11:59.92,0:12:03.43,Default,,0,0,0,,‎Қалай қорытынды сынақтан өтіп, жетіліктің қатарында қалуға болады!
Dialogue: 0,0:12:04.59,0:12:06.89,Default,,0,0,0,,Неліктен тест тапсыру керек?
Dialogue: 0,0:12:07.01,0:12:08.01,Default,,0,0,0,,А...
Dialogue: 0,0:12:08.43,0:12:11.60,Default,,0,0,0,,Сіз болашаққа не үшін барғыңыз келетінін ойладыңыз ба?
Dialogue: 0,0:12:11.98,0:12:13.39,Default,,0,0,0,,‎(Ясуи) Ах...
Dialogue: 0,0:12:13.52,0:12:17.77,Default,,0,0,0,,‎Неге қашу мүмкін емес еді...
Dialogue: 0,0:12:18.23,0:12:21.65,Default,,0,0,0,,‎Мен неге қазір дірілдеуім керек...
Dialogue: 0,0:12:21.78,0:12:26.66,Default,,0,0,0,,‎(Дауылдың айқайы)
Dialogue: 0,0:12:27.28,0:12:29.66,Default,,0,0,0,,‎(Ясуи) Неліктен тапсырма...
Dialogue: 0,0:12:30.08,0:12:33.66,Default,,0,0,0,,‎Неге жоғарғы... Неге сынақ...
Dialogue: 0,0:12:35.04,0:12:39.25,Default,,0,0,0,,‎Неге соншалықты анық нәрсеге жауап бере алмайсыз?
Dialogue: 0,0:12:39.80,0:12:41.21,Default,,0,0,0,,‎(Араши) I-
Dialogue: 0,0:12:41.34,0:12:44.72,Default,,0,0,0,,«Неге қашпадың?» деген сияқты сұмдық сөздер айтып жатырсың.
Dialogue: 0,0:12:45.84,0:12:49.14,Default,,0,0,0,,‎Бірақ мен бұл мұғалімдерге ашуланамын!
Dialogue: 0,0:12:50.01,0:12:52.39,Default,,0,0,0,,‎Мені ең қатты ашуландыратын нәрсе...
Dialogue: 0,0:12:52.52,0:12:56.02,Default,,0,0,0,,Сіз көп адамды өлтіргенге дейін...
Dialogue: 0,0:12:56.27,0:12:59.65,Default,,0,0,0,,‎Бұл мен өзімді ойламауға мәжбүр болдым дегенді білдіреді!
Dialogue: 0,0:13:00.02,0:13:02.82,Default,,0,0,0,,‎Мұғалім солай істеді, Ясуи-сан!
Dialogue: 0,0:13:05.24,0:13:08.32,Default,,0,0,0,,‎Қашып кетуді ойлай да алмайтын дүние...
Dialogue: 0,0:13:08.45,0:13:11.37,Default,,0,0,0,,‎Қайда болдың, Ясуи-кун?
Dialogue: 0,0:13:11.79,0:13:14.50,Default,,0,0,0,,‎(Араши) Менің ойымша, қашу жолы жоқ әлем біртүрлі.
Dialogue: 0,0:13:14.62,0:13:18.83,Default,,0,0,0,,‎Өзіңізді қорғау үшін қашу туралы шешім қабылдау...
Dialogue: 0,0:13:18.96,0:13:20.79,Default,,0,0,0,,‎Бар болуы керек!
Dialogue: 0,0:13:21.38,0:13:22.80,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:13:23.05,0:13:26.84,Default,,0,0,0,,«Сендер ешнәрсені ойламай, елің үшін соғысқа барасыңдар».
Dialogue: 0,0:13:26.97,0:13:30.39,Default,,0,0,0,,Менің ойымша, бұл біреуге ыңғайлы болу үшін бірдеңе айтумен бірдей.
Dialogue: 0,0:13:31.43,0:13:34.18,Default,,0,0,0,,Мен мұны мүлдем жек көремін.
Dialogue: 0,0:13:35.02,0:13:36.60,Default,,0,0,0,,Бұл әлі де жақын.
Dialogue: 0,0:13:36.85,0:13:39.61,Default,,0,0,0,,Жоқ, Араши! Біз үшін қашу мүмкін емес...
Dialogue: 0,0:13:39.73,0:13:43.23,Default,,0,0,0,,(дауыл) болды! болды
Dialogue: 0,0:13:43.48,0:13:45.32,Default,,0,0,0,,‎Бірақ мен байқамауға мәжбүр болдым.
Dialogue: 0,0:13:46.15,0:13:49.57,Default,,0,0,0,,Мені өлтірсе де, басқа жол жоқ деп ойлады!
Dialogue: 0,0:13:49.70,0:13:51.03,Default,,0,0,0,,‎Араши Жоқ!
Dialogue: 0,0:13:51.16,0:13:53.12,Default,,0,0,0,,‎(Араши) Мен оны өзім таңдадым деп ойладым!
Dialogue: 0,0:13:53.24,0:13:55.79,Default,,0,0,0,,‎(Ясуи) Араши Тоқта! (Араши) Ясуи мырза
Dialogue: 0,0:13:55.91,0:13:58.79,Default,,0,0,0,,Мен бұл сынақтан өтпегеніме қуаныштымын!
Dialogue: 0,0:13:59.04,0:14:00.42,Default,,0,0,0,,‎(Ясуи) Ха...
Dialogue: 0,0:14:11.72,0:14:14.27,Default,,0,0,0,,‎(Араши) Біз бірдейміз
Dialogue: 0,0:14:14.81,0:14:16.81,Default,,0,0,0,,‎Үмітіміз естілмейді.
Dialogue: 0,0:14:16.93,0:14:19.81,Default,,0,0,0,,Сіз таңдай да, бас тарта да алмайсыз.
Dialogue: 0,0:14:19.94,0:14:22.19,Default,,0,0,0,,Мені бұл жерге рұқсатсыз лақтырған.
Dialogue: 0,0:14:22.52,0:14:24.19,Default,,0,0,0,,Мен ешкіммен қоштаса алмаймын...
Dialogue: 0,0:14:24.61,0:14:27.07,Default,,0,0,0,,Бұл сіздің де барғыңыз келеді.
Dialogue: 0,0:14:27.19,0:14:29.86,Default,,0,0,0,,Біреудің қалауы бойынша лақтыру
Dialogue: 0,0:14:30.41,0:14:34.95,Default,,0,0,0,,‎Бұл баяғы Ясуи мырза, А және В жазы.
Dialogue: 0,0:14:35.70,0:14:38.91,Default,,0,0,0,,‎Бірақ қазір біз боспыз
Dialogue: 0,0:14:39.54,0:14:42.25,Default,,0,0,0,,‎Енді таңдап, өзіңіз шеше аласыз.
Dialogue: 0,0:14:42.75,0:14:44.09,Default,,0,0,0,,мырза. Ясуи де
Dialogue: 0,0:14:47.84,0:14:49.68,Default,,0,0,0,,Бұл мені ойландырды...
Dialogue: 0,0:14:51.01,0:14:53.01,Default,,0,0,0,,Мен оны қабылдамағаныма қуаныштымын...
Dialogue: 0,0:14:54.01,0:14:58.02,Default,,0,0,0,,‎Онда бәріміз ақымақ сияқтымыз...
Dialogue: 0,0:14:59.18,0:15:03.15,Default,,0,0,0,,‎Онда Шигеруге тест тапсырудың қажеті жоқ. Ол сынақта қайтыс болды ...
Dialogue: 0,0:15:04.15,0:15:06.32,Default,,0,0,0,,‎Хахаха...
Dialogue: 0,0:15:07.86,0:15:11.45,Default,,0,0,0,,Шигеру... Шигеру мен үшін өлді...
Dialogue: 0,0:15:11.74,0:15:16.04,Default,,0,0,0,,мырза. Ясуи, мұндай жағдайда болған оқиға үшін жауапкершілік жоқ!
Dialogue: 0,0:15:16.62,0:15:18.95,Default,,0,0,0,,‎Hehe hahaha…
Dialogue: 0,0:15:19.08,0:15:22.46,Default,,0,0,0,,‎(Ясуи) Өзің ойлап...
Dialogue: 0,0:15:22.58,0:15:23.71,Default,,0,0,0,,‎(Рё) Ясуи
Dialogue: 0,0:15:28.71,0:15:29.84,Default,,0,0,0,,Рё-сан
Dialogue: 0,0:15:29.97,0:15:32.09,Default,,0,0,0,,‎Химмару-сан... Мацури-чан да!
Dialogue: 0,0:15:32.59,0:15:34.14,Default,,0,0,0,,Сәлем Натчан!
Dialogue: 0,0:15:34.26,0:15:37.60,Default,,0,0,0,,‎Эй, Араши, сен қайда болдың!
Dialogue: 0,0:15:37.72,0:15:39.43,Default,,0,0,0,,Мен қатты уайымдадым.
Dialogue: 0,0:15:39.85,0:15:40.98,Default,,0,0,0,,Салқын…
Dialogue: 0,0:15:41.48,0:15:45.44,Default,,0,0,0,,‎Ясуи, мен саған айтпаған нәрсем бар.
Dialogue: 0,0:15:46.02,0:15:50.32,Default,,0,0,0,,Мен мұны айту керек пе, жоқ па, шеше алмадым.
Dialogue: 0,0:15:50.74,0:15:53.74,Default,,0,0,0,,‎Ол кезде айтпай-ақ қояйын деп ойладым.
Dialogue: 0,0:15:54.20,0:15:56.62,Default,,0,0,0,,‎Бірақ мен қателескен шығармын.
Dialogue: 0,0:15:57.28,0:15:58.29,Default,,0,0,0,,Мен мұны айтуым керек еді.
Dialogue: 0,0:15:58.87,0:16:01.04,Default,,0,0,0,,‎Не... айтып тұрсың...
Dialogue: 0,0:16:01.66,0:16:04.04,Default,,0,0,0,,‎Ол кезде үңгірде――
Dialogue: 0,0:16:04.71,0:16:07.50,Default,,0,0,0,,Сіз және Шигеру ауада тоқтатылған кезде...
Dialogue: 0,0:16:07.63,0:16:10.84,Default,,0,0,0,,Арқанды кескен Шигеру болды.
Dialogue: 0,0:16:11.63,0:16:14.80,Default,,0,0,0,,Не, енді кесіп тастадың ба? ?
Dialogue: 0,0:16:15.30,0:16:18.81,Default,,0,0,0,,Мен де оны бір уақытта дерлік кесіп тастадым.
Dialogue: 0,0:16:19.14,0:16:23.44,Default,,0,0,0,,Сол кезде қолымдағы арқанды кесіп жатқан Шигерудің реакциясын сездім.
Dialogue: 0,0:16:24.81,0:16:28.44,Default,,0,0,0,,Шигеру сізге көмектесу үшін оны өзі кесіп тастады.
Dialogue: 0,0:16:28.77,0:16:31.40,Default,,0,0,0,,Бұл өтірік. Шигеру солай жасады...
Dialogue: 0,0:16:31.53,0:16:33.57,Default,,0,0,0,,‎(Рё) Сіз мұны істей алмайсыз деп ойлайсыз, солай ма? (Ясуи) Ой...
Dialogue: 0,0:16:33.70,0:16:35.91,Default,,0,0,0,,Сіз солай ойлайсыз.
Dialogue: 0,0:16:36.37,0:16:38.45,Default,,0,0,0,,Мен де солай ойладым.
Dialogue: 0,0:16:39.03,0:16:41.41,Default,,0,0,0,,‎Ол жалқау және шешімсіз.
Dialogue: 0,0:16:42.45,0:16:46.29,Default,,0,0,0,,‎Мен саған сенемін, сенсіз ештеңе істей алмаймын.
Dialogue: 0,0:16:46.42,0:16:48.21,Default,,0,0,0,,‎Жақсы және әлсіз жігіт жоқ
Dialogue: 0,0:16:48.54,0:16:51.05,Default,,0,0,0,,(Ясуи) Мен солай ойлаймын... (Рё) Мен солай ойлаймын!
Dialogue: 0,0:16:51.84,0:16:53.92,Default,,0,0,0,,«Ол сізге көмектесе алмайды».
Dialogue: 0,0:16:54.47,0:16:56.30,Default,,0,0,0,,‎«Мен мұны кешіре алмаймын»
Dialogue: 0,0:16:56.43,0:16:57.26,Default,,0,0,0,,‎(Ясуи) Ах...
Dialogue: 0,0:16:57.68,0:17:01.10,Default,,0,0,0,,‎Шигеруді ең көп құптамайтын сенсің.
Dialogue: 0,0:17:01.93,0:17:06.60,Default,,0,0,0,,Мен үңгірге түсер алдында сол күні Шигеруді бақылап отырдым.
Dialogue: 0,0:17:07.06,0:17:10.07,Default,,0,0,0,,‎Сені өлтірмек болған Укаймен соғысу...
Dialogue: 0,0:17:10.19,0:17:12.36,Default,,0,0,0,,‎Аттың азабына шыдап...
Dialogue: 0,0:17:12.48,0:17:14.95,Default,,0,0,0,,‎Үңгірде болсам да мен саған көмектесуге тырыстым.
Dialogue: 0,0:17:15.99,0:17:18.16,Default,,0,0,0,,‎(Шигеру) Ясуиге айтпа.
Dialogue: 0,0:17:18.57,0:17:20.95,Default,,0,0,0,,‎Онда мен үшін тағы да алаңдауға тура келеді.
Dialogue: 0,0:17:22.16,0:17:25.29,Default,,0,0,0,,Мен Ясуо үшін алаңдап, оған қамқорлық жасайтын адаммын.
Dialogue: 0,0:17:27.21,0:17:28.88,Default,,0,0,0,,‎Себебі бұл сирек
Dialogue: 0,0:17:29.25,0:17:31.30,Default,,0,0,0,,Мен оны біраз қарап шықтым.
Dialogue: 0,0:17:31.42,0:17:35.38,Default,,0,0,0,,‎Ол сол түні сізге қарағанда әлдеқайда пайдалы болды.
Dialogue: 0,0:17:37.43,0:17:41.10,Default,,0,0,0,,Сіз оны мойындамайсыз, солай ма? Ол жігіт керемет еді
Dialogue: 0,0:17:41.68,0:17:46.35,Default,,0,0,0,,‎Сен Шигеру сен үшін өлді деп ойлағың келеді, солай емес пе?
Dialogue: 0,0:17:46.64,0:17:49.90,Default,,0,0,0,,Олар оны «мас» деп атайды.
Dialogue: 0,0:17:50.02,0:17:50.94,Default,,0,0,0,,‎(Банмару) Ах...
Dialogue: 0,0:17:52.90,0:17:56.32,Default,,0,0,0,,‎(Рё) Ясуи мойындаңыз.
Dialogue: 0,0:17:56.74,0:18:00.95,Default,,0,0,0,,Шигеру өзі үшін күресіп, өзі шешеді.
Dialogue: 0,0:18:01.08,0:18:04.91,Default,,0,0,0,,Мен шұңқырға өзім түсіп, бірінші болып көтерілдім.
Dialogue: 0,0:18:05.37,0:18:08.12,Default,,0,0,0,,Өзіңізге зиян келтіріңіз, өзіңіз қателесіңіз.
Dialogue: 0,0:18:08.25,0:18:10.75,Default,,0,0,0,,Нәтижесінде арқанды өзім кесуге тура келді.
Dialogue: 0,0:18:11.21,0:18:14.42,Default,,0,0,0,,‎Мен өз шешімімді өз тәуекеліммен қабылдадым!
Dialogue: 0,0:18:14.55,0:18:17.09,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасадым, оның ішінде қателіктер де бар!
Dialogue: 0,0:18:17.59,0:18:21.26,Default,,0,0,0,,Жарайсың ба? Мен сен үшін өлген жоқпын!
Dialogue: 0,0:18:21.72,0:18:25.22,Default,,0,0,0,,Мен сені қорғап, өзім үшін өлдім.
Dialogue: 0,0:18:26.31,0:18:30.02,Default,,0,0,0,,‎Бұл ол үшін мақтаныш болса керек.
Dialogue: 0,0:18:33.02,0:18:34.44,Default,,0,0,0,,Мойындаңыз.
Dialogue: 0,0:18:34.82,0:18:36.86,Default,,0,0,0,,‎Ол сенің қосымшаң емес.
Dialogue: 0,0:18:37.44,0:18:40.66,Default,,0,0,0,,Мен сіздің әңгімеңіздегі қосалқы кейіпкер емеспін.
Dialogue: 0,0:18:41.37,0:18:44.66,Default,,0,0,0,,‎Оны басты кейіпкер етіңіз!
Dialogue: 0,0:18:46.20,0:18:49.41,Default,,0,0,0,,‎Ясуи Ясуиге міндетті түрде көмектесемін.
Dialogue: 0,0:18:55.50,0:18:56.34,Default,,0,0,0,,‎(Ясуи) Ух...
Dialogue: 0,0:18:56.55,0:18:59.38,Default,,0,0,0,,‎(Рё) Шигеру Укайға айтты.
Dialogue: 0,0:19:00.18,0:19:02.68,Default,,0,0,0,,«Ясуи болашаққа барады»
Dialogue: 0,0:19:03.18,0:19:06.43,Default,,0,0,0,,‎«Өзіңіз үшін шешім қабылдаңыз және өзіңіз үшін жауапкершілікті алыңыз»
Dialogue: 0,0:19:06.56,0:19:09.94,Default,,0,0,0,,«Мұндай адамдар болашаққа баруы керек».
Dialogue: 0,0:19:10.06,0:19:11.40,Default,,0,0,0,,Меніңше...
Dialogue: 0,0:19:12.06,0:19:12.90,Default,,0,0,0,,‎Ясуи
Dialogue: 0,0:19:13.90,0:19:16.15,Default,,0,0,0,,‎Осындай адам бол!
Dialogue: 0,0:19:16.82,0:19:19.03,Default,,0,0,0,,‎(Ясуи) Уф...
Dialogue: 0,0:19:22.07,0:19:23.32,Default,,0,0,0,,‎(Шигеру) Ясуи
Dialogue: 0,0:19:24.24,0:19:27.04,Default,,0,0,0,,Сіз маған сенбейсіз, солай ма?
Dialogue: 0,0:19:27.91,0:19:30.58,Default,,0,0,0,,‎Ол әрқашан менің інім немесе көмекшім.
Dialogue: 0,0:19:31.12,0:19:33.79,Default,,0,0,0,,Мен әрқашан теңдей дос болғым келді.
Dialogue: 0,0:19:34.46,0:19:35.79,Default,,0,0,0,,Біз доспыз, солай ма?
Dialogue: 0,0:19:36.30,0:19:40.80,Default,,0,0,0,,Олай болса, мен Ясуиден жақсы баға алсам, ренжімейсің бе?
Dialogue: 0,0:19:41.47,0:19:44.09,Default,,0,0,0,,‎(Ясуи) Бұл... бұл...
Dialogue: 0,0:19:44.51,0:19:47.14,Default,,0,0,0,,Бұл біз қарсылас боламыз деген сөз, солай ма?
Dialogue: 0,0:19:48.02,0:19:50.31,Default,,0,0,0,,‎(Шигеру) Жақсы дыбыс «қарсылас»
Dialogue: 0,0:19:52.73,0:19:56.82,Default,,0,0,0,,Шигеру, мен саған айтуды ұмытып кетіппін.
Dialogue: 0,0:19:57.07,0:19:58.07,Default,,0,0,0,,Не?
Dialogue: 0,0:19:59.23,0:20:01.82,Default,,0,0,0,,‎Мен оны қыңырлығым үшін айтқан жоқпын.
Dialogue: 0,0:20:02.32,0:20:03.16,Default,,0,0,0,,‎(Шиге) Иә
Dialogue: 0,0:20:07.41,0:20:11.66,Default,,0,0,0,,(Ясуи) Сен келмегенде мен сонда өлетін едім.
Dialogue: 0,0:20:12.66,0:20:15.67,Default,,0,0,0,,Менің көмекке келгеніңіз үшін рахмет.
Dialogue: 0,0:20:16.13,0:20:17.46,Default,,0,0,0,,Сосын...
Dialogue: 0,0:20:18.38,0:20:19.92,Default,,0,0,0,,Барлығы үшін кешірім сұраймын
Dialogue: 0,0:20:21.34,0:20:22.88,Default,,0,0,0,,‎(Шиге) Хэхе
Dialogue: 0,0:20:24.38,0:20:27.30,Default,,0,0,0,,Болашақта сәттілік Ясуи
Dialogue: 0,0:20:30.89,0:20:32.23,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:20:42.32,0:20:43.57,Default,,0,0,0,,‎(Ясуи) Уф...
Dialogue: 0,0:20:48.37,0:20:49.70,Default,,0,0,0,,Ух...
Dialogue: 0,0:21:05.80,0:21:10.01,Default,,0,0,0,,Жоғарыға көтерілейік. Әрқайсымыз жоғарыға көтеріліп, шыңда кездесейік.
Dialogue: 0,0:21:12.31,0:21:15.14,Default,,0,0,0,,‎(Араши) Ясуи мырза, бара аламыз ба?
Dialogue: 0,0:21:15.73,0:21:16.85,Default,,0,0,0,,‎(Ясуи) Араши
Dialogue: 0,0:21:18.19,0:21:19.19,Default,,0,0,0,,‎(Араши) Уф!
Dialogue: 0,0:21:21.78,0:21:22.90,Default,,0,0,0,,‎(Ясуи) Hmph
Dialogue: 0,0:21:33.29,0:21:35.54,Default,,0,0,0,,‎(Күз) Қызық, ол жылыжайда өседі ме?
Dialogue: 0,0:21:36.46,0:21:39.96,Default,,0,0,0,,‎Жылыжайда өскен... Түсінемін.
Dialogue: 0,0:21:40.42,0:21:44.76,Default,,0,0,0,,‎(Хаманумару) Сондықтан мен айттым, солай ма? «Жылыжайда өсіру жаман емес».
Dialogue: 0,0:21:45.47,0:21:49.30,Default,,0,0,0,,Табиғатта гүлдеген адам талғампаз бола алмайды, бірақ...
Dialogue: 0,0:21:49.43,0:21:51.76,Default,,0,0,0,,‎Әдемі адам тек талғампаз ғана емес -
Dialogue: 0,0:21:51.89,0:21:53.60,Default,,0,0,0,,‎Сізді іздеуге де болады.
Dialogue: 0,0:21:54.06,0:21:55.10,Default,,0,0,0,,‎Жақсы нәрсе айтыңыз
Dialogue: 0,0:21:55.23,0:21:57.27,Default,,0,0,0,,Дұрыс? Мені көбірек мадақтаңыз, Рё-чин!
Dialogue: 0,0:21:57.81,0:21:58.81,Default,,0,0,0,,‎(Ясуи) Ах...
Dialogue: 0,0:21:59.56,0:22:00.69,Default,,0,0,0,,‎Фу…
Dialogue: 0,0:22:02.07,0:22:05.15,Default,,0,0,0,,‎Нацу, қатты көтеріл! Өзіңіз көтеріліңіз!
Dialogue: 0,0:22:05.69,0:22:06.99,Default,,0,0,0,,Иә!
Dialogue: 0,0:22:11.87,0:22:15.37,Default,,0,0,0,,‎(Араши) Бірақ қазір біз боспыз.
Dialogue: 0,0:22:16.83,0:22:19.37,Default,,0,0,0,,‎Енді таңдап, өзіңіз шеше аласыз.
Dialogue: 0,0:22:21.71,0:22:26.72,Default,,0,0,0,,♪～
Dialogue: 0,0:22:28.22,0:22:34.22,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory