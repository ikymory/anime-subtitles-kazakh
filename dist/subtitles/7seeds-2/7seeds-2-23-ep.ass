Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:24.94,0:00:26.73,Default,,0,0,0,,‎(Фудзико) Ет? Ах
Dialogue: 0,0:00:26.86,0:00:28.94,Default,,0,0,0,,‎Мен де ұстай алатын жануарлар бар.
Dialogue: 0,0:00:29.57,0:00:32.15,Default,,0,0,0,,‎Ерте тұрудың пайдасы зор.
Dialogue: 0,0:00:32.57,0:00:35.86,Default,,0,0,0,,‎Ал (Фудзико) Уау! Мен аламын!
Dialogue: 0,0:00:36.16,0:00:37.45,Default,,0,0,0,,Дәмді!
Dialogue: 0,0:00:37.57,0:00:39.83,Default,,0,0,0,,‎(Фудзико) Қарашы, Хана-чан да (Гүл) Дәмді көрінеді.
Dialogue: 0,0:00:39.95,0:00:43.16,Default,,0,0,0,,‎Бұл өте жұмсақ және иісі жоқ.
Dialogue: 0,0:00:44.54,0:00:45.71,Default,,0,0,0,,‎Дәмді!
Dialogue: 0,0:00:45.83,0:00:47.42,Default,,0,0,0,,Бұл жануар әлі де бар ма?
Dialogue: 0,0:00:47.92,0:00:50.34,Default,,0,0,0,,Иә, мен тағы бірнеше адамды көрдім.
Dialogue: 0,0:00:50.96,0:00:54.51,Default,,0,0,0,,‎(Фудзико) Уау! Мен өзімді жақсы сезінемін!
Dialogue: 0,0:00:54.63,0:00:57.93,Default,,0,0,0,,‎Рахмет Чиса-чан, біз бүгін тағы да отын жинап жатырмыз!
Dialogue: 0,0:00:58.05,0:01:01.77,Default,,0,0,0,,‎Онда мен үлкен бір нәрсе жасап көремін.
Dialogue: 0,0:01:02.93,0:01:07.94,Default,,0,0,0,,♪～
Dialogue: 0,0:02:23.26,0:02:28.27,Default,,0,0,0,,～♪
Dialogue: 0,0:02:33.02,0:02:35.82,Default,,0,0,0,,Мүмкін мен тағы бумеранг жасауым керек шығар...
Dialogue: 0,0:02:36.40,0:02:38.15,Default,,0,0,0,,‎(шөптің тербелген дыбысы)
Dialogue: 0,0:02:38.28,0:02:39.95,Default,,0,0,0,,‎(Гүл) Ah ‎(Лалагүлдің хорваты)
Dialogue: 0,0:02:40.07,0:02:41.57,Default,,0,0,0,,‎(Урибудың айқайы және т.б.)
Dialogue: 0,0:02:41.70,0:02:42.57,Default,,0,0,0,,‎(Гүл) Балалар...
Dialogue: 0,0:02:43.70,0:02:44.53,Default,,0,0,0,,‎(Қабан дыбысы)
Dialogue: 0,0:02:44.95,0:02:48.91,Default,,0,0,0,,Не болды? Ал екіншісі ше? Ең кішкентай...
Dialogue: 0,0:02:49.04,0:02:51.12,Default,,0,0,0,,‎(Гүл) Сізге бірдеңе шабуыл жасады ма? (Қабан дыбысы)
Dialogue: 0,0:02:51.71,0:02:54.75,Default,,0,0,0,,‎…Ха! Өтірік, дәл алдында...
Dialogue: 0,0:03:00.59,0:03:03.26,Default,,0,0,0,,‎(Гүл) әр түрлі… Мен…
Dialogue: 0,0:03:05.97,0:03:06.81,Default,,0,0,0,,А
Dialogue: 0,0:03:11.52,0:03:12.52,Default,,0,0,0,,‎Ku…
Dialogue: 0,0:03:13.52,0:03:15.90,Default,,0,0,0,,Жүр, алысқа бар!
Dialogue: 0,0:03:16.27,0:03:18.11,Default,,0,0,0,,Енді маған жақындама!
Dialogue: 0,0:03:18.57,0:03:21.03,Default,,0,0,0,,‎(Урибудың айқайы)
Dialogue: 0,0:03:23.32,0:03:24.74,Default,,0,0,0,,‎(Гүл) Ух...
Dialogue: 0,0:03:25.20,0:03:28.95,Default,,0,0,0,,‎(Гүл) Үй жануары немесе мал емес екенін айтып жатқанда
Dialogue: 0,0:03:29.08,0:03:30.54,Default,,0,0,0,,Біз бірге болдық...
Dialogue: 0,0:03:31.29,0:03:36.00,Default,,0,0,0,,‎Менің кесірімнен олар абай болмай, оңай ұсталды...
Dialogue: 0,0:03:36.25,0:03:39.38,Default,,0,0,0,,‎Егер бұл маңызды болса, мен оны өзімдікі ретінде сақтауым керек еді.
Dialogue: 0,0:03:39.76,0:03:41.93,Default,,0,0,0,,‎Себебі мен жарымжанмын!
Dialogue: 0,0:03:42.05,0:03:43.01,Default,,0,0,0,,‎(Гүл) Ух...
Dialogue: 0,0:03:43.59,0:03:45.89,Default,,0,0,0,,‎(Гүл) Құсуға болмайды! Мен жеп қойдым
Dialogue: 0,0:03:46.01,0:03:48.64,Default,,0,0,0,,Мен жедім! Оны нәрлі етіңіз!
Dialogue: 0,0:03:51.18,0:03:55.10,Default,,0,0,0,,Мен оған ат бермегеніме қуаныштымын...
Dialogue: 0,0:03:58.32,0:04:01.28,Default,,0,0,0,,(Мацури мен Бандимарудың ауыр тыныс алуы) (Рё) Демалыңыз. Мен алға қараймын.
Dialogue: 0,0:04:01.40,0:04:03.40,Default,,0,0,0,,‎(Ясуи) Ой, мен де барамын.
Dialogue: 0,0:04:04.53,0:04:06.99,Default,,0,0,0,,‎(Банумару) Бұл жігіттердің физикалық күші сондай.
Dialogue: 0,0:04:07.12,0:04:09.66,Default,,0,0,0,,Менің қолым мен аяғым дірілдеп тұр.
Dialogue: 0,0:04:10.16,0:04:15.00,Default,,0,0,0,,‎(Араши) Мен дайындалдым, оқыдым, жаттығамын.
Dialogue: 0,0:04:15.38,0:04:20.46,Default,,0,0,0,,‎Тозақ көріністі басынан өткергеннен кейін мен әлі де сіздің алдыңызда тұрмын.
Dialogue: 0,0:04:20.59,0:04:21.42,Default,,0,0,0,,Керемет
Dialogue: 0,0:04:21.55,0:04:24.59,Default,,0,0,0,,‎(Бамимару) Тека Араши! Ол кенет жоғалып кетті
Dialogue: 0,0:04:24.72,0:04:26.97,Default,,0,0,0,,‎Келесі жолы жіпті бекітіңіз! Жіп!
Dialogue: 0,0:04:27.10,0:04:27.93,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:04:28.47,0:04:29.64,Default,,0,0,0,,‎Фу
Dialogue: 0,0:04:30.06,0:04:30.68,Default,,0,0,0,,‎Эй, Нацу, сен де жоғалып кетпе.
Dialogue: 0,0:04:30.68,0:04:31.98,Default,,0,0,0,,‎Эй, Нацу, сен де жоғалып кетпе.
Dialogue: 0,0:04:30.68,0:04:31.98,Default,,0,0,0,,А...
Dialogue: 0,0:04:31.98,0:04:32.85,Default,,0,0,0,,‎Эй, Нацу, сен де жоғалып кетпе.
Dialogue: 0,0:04:32.85,0:04:33.85,Default,,0,0,0,,Эй Нацу, сен де жоғалып кетпе.
Dialogue: 0,0:04:32.85,0:04:33.85,Default,,0,0,0,,Не... не... а...
Dialogue: 0,0:04:33.85,0:04:33.98,Default,,0,0,0,,Не... не... а...
Dialogue: 0,0:04:33.98,0:04:35.94,Default,,0,0,0,,Не... не... а...
Dialogue: 0,0:04:33.98,0:04:35.94,Default,,0,0,0,,Сіз уайымдауыңыз керек еді.
Dialogue: 0,0:04:36.06,0:04:37.73,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:04:38.77,0:04:41.15,Default,,0,0,0,,Сонымен, сен қолыңнан келгеннің бәрін қалай істедің?
Dialogue: 0,0:04:41.28,0:04:42.15,Default,,0,0,0,,Иә
Dialogue: 0,0:04:42.28,0:04:45.32,Default,,0,0,0,,‎О, жарайсың, жарайсың, жарайсың
Dialogue: 0,0:04:45.45,0:04:46.86,Default,,0,0,0,,Сіз мұны істейсіз, солай ма?
Dialogue: 0,0:04:48.57,0:04:50.08,Default,,0,0,0,,‎Сен не айтасың, баяу тасбақа! Керемет көрінеді...
Dialogue: 0,0:04:50.08,0:04:52.08,Default,,0,0,0,,‎Мен не айтамын деп ойлайсың, баяу тасбақа! Керемет көрінеді...
Dialogue: 0,0:04:50.08,0:04:52.08,Default,,0,0,0,,Уау...
Dialogue: 0,0:04:52.20,0:04:53.62,Default,,0,0,0,,‎(Ханумару және оның достарының әбігері)
Dialogue: 0,0:04:54.04,0:04:56.21,Default,,0,0,0,,‎(Рё) Тек төмен түсетін есіктер бар.
Dialogue: 0,0:04:56.46,0:04:58.92,Default,,0,0,0,,‎(Ясуи) Олар өте шулы.
Dialogue: 0,0:04:59.04,0:05:00.42,Default,,0,0,0,,‎(Рё) Әрқашан солай.
Dialogue: 0,0:05:01.88,0:05:03.51,Default,,0,0,0,,‎(Ясуи) Рё (Рё) Иә?
Dialogue: 0,0:05:03.84,0:05:05.55,Default,,0,0,0,,Араши маған айтты
Dialogue: 0,0:05:05.68,0:05:08.47,Default,,0,0,0,,«Неге сол кезде қашып кетпедің?»
Dialogue: 0,0:05:08.85,0:05:10.68,Default,,0,0,0,,О, мен естідім.
Dialogue: 0,0:05:11.06,0:05:14.10,Default,,0,0,0,,‎Рё, сен бұл туралы ойладың ба?
Dialogue: 0,0:05:14.23,0:05:16.35,Default,,0,0,0,,‎Ол сынақтан өтпей қалай қашып кеттің?
Dialogue: 0,0:05:16.48,0:05:19.40,Default,,0,0,0,,Бұлай болуы мүмкін емес. Мұндай нұсқа жоқ.
Dialogue: 0,0:05:20.02,0:05:23.53,Default,,0,0,0,,(Ясуи) Бірақ соңғы сынақ болды...
Dialogue: 0,0:05:23.65,0:05:28.66,Default,,0,0,0,,Мен жеті адам таңдағандардан басқаның өлтірілетінін білдім.
Dialogue: 0,0:05:28.87,0:05:32.12,Default,,0,0,0,,Мен бұл туралы бәріне хабарлай алар едім.
Dialogue: 0,0:05:32.49,0:05:33.33,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:33.70,0:05:37.12,Default,,0,0,0,,Жаңа материалмен өзіңізді қайтадан ұрып-соғуды бастамаңыз.
Dialogue: 0,0:05:37.50,0:05:38.50,Default,,0,0,0,,‎(Ясуи) Хмм...
Dialogue: 0,0:05:39.04,0:05:43.42,Default,,0,0,0,,Мен енді не істерімді білмеймін.
Dialogue: 0,0:05:43.55,0:05:45.30,Default,,0,0,0,,Себебі ол келді
Dialogue: 0,0:05:46.92,0:05:48.43,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:05:50.80,0:05:52.22,Default,,0,0,0,,‎(Рё) Ол ақырында көтеріледі.
Dialogue: 0,0:05:52.35,0:05:54.89,Default,,0,0,0,,‎(Ясуи) Бұл сақталды ма?
Dialogue: 0,0:05:55.02,0:05:56.43,Default,,0,0,0,,Оны біреу пайдаланды.
Dialogue: 0,0:05:56.68,0:06:00.56,Default,,0,0,0,,‎Ясуи, сенің оң қолың саусақтары қозғалып тұр.
Dialogue: 0,0:06:00.81,0:06:04.03,Default,,0,0,0,,‎Аа... а, дұрыс.
Dialogue: 0,0:06:04.48,0:06:06.61,Default,,0,0,0,,Оны Шигеру жөндеген сияқты.
Dialogue: 0,0:06:07.07,0:06:09.91,Default,,0,0,0,,‎Бір мағынада, бұл дауылдың кінәсі шығар.
Dialogue: 0,0:06:10.57,0:06:12.99,Default,,0,0,0,,Мен оны есінен танған шығар деп ойладым...
Dialogue: 0,0:06:13.12,0:06:16.58,Default,,0,0,0,,‎Ол қорқынышты түрде шындықты айтты.
Dialogue: 0,0:06:16.70,0:06:18.50,Default,,0,0,0,,Бір нәрсе гүлге ұқсайды.
Dialogue: 0,0:06:18.96,0:06:20.79,Default,,0,0,0,,‎(Рё) Сіз де ұқсайсыз. (Ясуи) Не!?
Dialogue: 0,0:06:21.13,0:06:22.84,Default,,0,0,0,,Сіз ұмыттыңыз ба?
Dialogue: 0,0:06:22.96,0:06:25.13,Default,,0,0,0,,‎Сен де өте қыңырсың.
Dialogue: 0,0:06:25.25,0:06:28.88,Default,,0,0,0,,‎Ол тура және шынайы дәлелдерді айтатын жиіркенішті жігіт еді.
Dialogue: 0,0:06:29.01,0:06:31.43,Default,,0,0,0,,‎Сондықтан гүлдер сізді алаңдатты, солай ма?
Dialogue: 0,0:06:31.84,0:06:35.89,Default,,0,0,0,,Сіз бұл туралы Такаши-сенсэйдің қызы екеніңізді білмей тұрып-ақ білгенсіз.
Dialogue: 0,0:06:36.02,0:06:37.02,Default,,0,0,0,,А...
Dialogue: 0,0:06:37.14,0:06:40.27,Default,,0,0,0,,‎(Рё) Бұл мені мазалады және бір уақытта мені алаңдатты.
Dialogue: 0,0:06:42.69,0:06:44.48,Default,,0,0,0,,Орындалды ма?
Dialogue: 0,0:06:44.61,0:06:46.69,Default,,0,0,0,,‎Эй, мұнда кел!
Dialogue: 0,0:06:47.49,0:06:48.44,Default,,0,0,0,,‎(шу)
Dialogue: 0,0:06:48.95,0:06:51.16,Default,,0,0,0,,‎(Пион) Мен төменде бір дыбыс естідім.
Dialogue: 0,0:06:51.49,0:06:52.49,Default,,0,0,0,,‎(Отты) Иә
Dialogue: 0,0:06:58.70,0:06:59.91,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:01.42,0:07:03.25,Default,,0,0,0,,‎(Банмару) Уау, ханым.
Dialogue: 0,0:07:03.38,0:07:05.42,Default,,0,0,0,,‎Ботан-сан мен Фатли-чан да!
Dialogue: 0,0:07:05.55,0:07:06.92,Default,,0,0,0,,‎(Пион) Барлығының қауіпсіз болғанына қуаныштымын.
Dialogue: 0,0:07:07.13,0:07:10.84,Default,,0,0,0,,‎Жоқ, бұл қазірдің өзінде қиын! Мен үстел теннисін ойнап жатқанымда лифт құлап кетті.
Dialogue: 0,0:07:10.97,0:07:14.22,Default,,0,0,0,,‎Бізді де су шайып кетті, құлағанымызда тасбақа болды!
Dialogue: 0,0:07:14.35,0:07:15.35,Default,,0,0,0,,Соя бұршақтарын ал.
Dialogue: 0,0:07:15.47,0:07:17.31,Default,,0,0,0,,‎Нацудың оны кранмен көтеруі
Dialogue: 0,0:07:17.43,0:07:20.27,Default,,0,0,0,,Мен не айтып тұрғаныңызды түсінбеймін.
Dialogue: 0,0:07:20.39,0:07:22.15,Default,,0,0,0,,Тынышталыңыз.
Dialogue: 0,0:07:22.27,0:07:25.57,Default,,0,0,0,,‎Ха... Біріншіден, Араши, сіз өте пайдалы болдыңыз.
Dialogue: 0,0:07:25.69,0:07:27.86,Default,,0,0,0,,Мен сені енді ешқашан көрмеймін деп ойладым.
Dialogue: 0,0:07:27.98,0:07:29.44,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:32.70,0:07:35.95,Default,,0,0,0,,Біз дұрыс сөйлесетін уақыт келгеніне қуаныштымын.
Dialogue: 0,0:07:36.37,0:07:37.37,Default,,0,0,0,,‎(Рё) Ах...
Dialogue: 0,0:07:39.50,0:07:42.00,Default,,0,0,0,,‎Тыңдаңыздар, менің барлығына айтар сөзім бар.
Dialogue: 0,0:07:42.25,0:07:44.13,Default,,0,0,0,,‎(Рё Ясуи) Иә? (Бамимару және т.б.) Әй?
Dialogue: 0,0:07:44.88,0:07:46.54,Default,,0,0,0,,‎(Араши) Өз еліңе қарай―
Dialogue: 0,0:07:46.67,0:07:49.96,Default,,0,0,0,,Капитан зымыран ұшыру түймесін басқан деп айтасыз ба?
Dialogue: 0,0:07:50.09,0:07:52.34,Default,,0,0,0,,‎(Пион) Және олар ядролық зымырандар да бар дейді.
Dialogue: 0,0:07:52.93,0:07:54.34,Default,,0,0,0,,Қандай да бір себептермен-
Dialogue: 0,0:07:54.47,0:07:57.26,Default,,0,0,0,,Кері санақ жарты жолда тоқтаған сияқты...
Dialogue: 0,0:07:57.39,0:08:01.14,Default,,0,0,0,,‎Енді біз осында болсақ, бәрі қайтадан қозғала бастаған сияқты.
Dialogue: 0,0:08:01.39,0:08:02.48,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:02.60,0:08:05.56,Default,,0,0,0,,‎(Пион гүлі) Айтпақшы, бұл кеме де өзін-өзі жойып жіберетін сияқты.
Dialogue: 0,0:08:05.69,0:08:08.82,Default,,0,0,0,,Сосын бұл зымыран шығар...
Dialogue: 0,0:08:09.28,0:08:10.32,Default,,0,0,0,,Сіз оны көрдіңіз бе? Нацу
Dialogue: 0,0:08:10.44,0:08:14.70,Default,,0,0,0,,А, иә, а, сонда қалған уақыт ше...
Dialogue: 0,0:08:15.03,0:08:19.29,Default,,0,0,0,,Иә, барлық жерде мониторларда дисплейлер бар, солай ма?
Dialogue: 0,0:08:19.41,0:08:22.79,Default,,0,0,0,,‎Зымыран ұшырылғанға дейінгі уақыт... Бұл солай сияқты.
Dialogue: 0,0:08:22.91,0:08:24.50,Default,,0,0,0,,Қараңызшы, бұл да осында.
Dialogue: 0,0:08:24.62,0:08:26.63,Default,,0,0,0,,7 сағат қалды
Dialogue: 0,0:08:27.17,0:08:29.59,Default,,0,0,0,,‎(Пион) Біз не істеуіміз керек? (Ясуи) Үш нұсқа бар.
Dialogue: 0,0:08:29.84,0:08:32.72,Default,,0,0,0,,Біріншіден, бұл кемені дереу тастаңыз.
Dialogue: 0,0:08:32.84,0:08:35.93,Default,,0,0,0,,Жанкешті жарылыс кезінде ұсталып қалмас үшін мүмкіндігінше алыс болыңыз
Dialogue: 0,0:08:36.26,0:08:37.18,Default,,0,0,0,,‎(Банмару) Жақсы емес.
Dialogue: 0,0:08:37.30,0:08:40.10,Default,,0,0,0,,Біздің кеме дайын бетон балдырларына кептеліп, қозғала алмай қалды.
Dialogue: 0,0:08:40.22,0:08:42.64,Default,,0,0,0,,О, бұл мәселе.
Dialogue: 0,0:08:42.85,0:08:46.10,Default,,0,0,0,,Екіншіден, зымыран ұшыруды қандай да бір түрде тоқтатыңыз.
Dialogue: 0,0:08:46.23,0:08:47.94,Default,,0,0,0,,Бақытымызға орай, әлі уақыт бар
Dialogue: 0,0:08:48.06,0:08:50.94,Default,,0,0,0,,ұшыруды соңғы сәтке дейін тоқтатуға тырысыңыз
Dialogue: 0,0:08:51.07,0:08:52.32,Default,,0,0,0,,Үшіншісі ше?
Dialogue: 0,0:08:52.69,0:08:55.03,Default,,0,0,0,,Кемені жарып, теңізге батырыңыз
Dialogue: 0,0:08:55.15,0:08:58.45,Default,,0,0,0,,‎Жай ғана іште қалып, мұны істеу қауіпті.
Dialogue: 0,0:08:58.82,0:09:01.87,Default,,0,0,0,,‎Уақыты белгіленген тұтану құрылғысын ойлап таппасаңыз.
Dialogue: 0,0:09:02.16,0:09:03.33,Default,,0,0,0,,‎Жоқ, жоқ, жоқ
Dialogue: 0,0:09:03.45,0:09:06.29,Default,,0,0,0,,Сонда да кемеміз қозғала алмаса, біз оған ілініп қаламыз.
Dialogue: 0,0:09:06.58,0:09:10.84,Default,,0,0,0,,‎Ал бұл жағдайда да зымыранмен не болатыны кездейсоқтықта қалады.
Dialogue: 0,0:09:11.13,0:09:14.63,Default,,0,0,0,,Тоқтатайық. Қазір Жапонияда да адамдар бар.
Dialogue: 0,0:09:14.92,0:09:18.68,Default,,0,0,0,,‎Күзгі және көктемгі және жазғы команданың басқа мүшелері А
Dialogue: 0,0:09:19.51,0:09:22.43,Default,,0,0,0,,‎Бір жерде көбірек адамдар болуы мүмкін.
Dialogue: 0,0:09:23.06,0:09:25.10,Default,,0,0,0,,‎(Араши) Бір жерде гүлдер бар...
Dialogue: 0,0:09:25.60,0:09:26.94,Default,,0,0,0,,Мен оны мүлдем тоқтатуым керек
Dialogue: 0,0:09:27.35,0:09:31.23,Default,,0,0,0,,Жануарлар мен өсімдіктер де қазіргі ортада тіршілік етеді.
Dialogue: 0,0:09:31.36,0:09:34.90,Default,,0,0,0,,‎Біз бұл кемеге кездейсоқ кіргендіктен...
Dialogue: 0,0:09:35.03,0:09:38.28,Default,,0,0,0,,‎Ол қозғала бастағаннан бері мен жауапкершілікті алуым керек.
Dialogue: 0,0:09:38.41,0:09:41.08,Default,,0,0,0,,Бұл ядролық, өлімнің күлін жауып тұрған жоқ па?
Dialogue: 0,0:09:41.20,0:09:43.08,Default,,0,0,0,,‎Алыста жүрсең де соғылмайды.
Dialogue: 0,0:09:43.20,0:09:45.33,Default,,0,0,0,,Қашсақ та, біз де қиыншылыққа тап боламыз, солай ма?
Dialogue: 0,0:09:45.71,0:09:47.54,Default,,0,0,0,,Иә, онда...
Dialogue: 0,0:09:47.83,0:09:50.92,Default,,0,0,0,,‎Жарайды, зымыранды тоқтату бағытында қозғалайық.
Dialogue: 0,0:09:51.46,0:09:53.50,Default,,0,0,0,,‎(От бляшка) Негізі, мен оны жаңа ғана таптым.
Dialogue: 0,0:09:53.63,0:09:55.97,Default,,0,0,0,,Менің ойымша, бұл солай шығар...
Dialogue: 0,0:09:56.09,0:09:59.84,Default,,0,0,0,,‎Іске қосу пәрменін қолмен тоқтату Құрылғының орналасқан жері...
Dialogue: 0,0:09:59.97,0:10:03.97,Default,,0,0,0,,‎Бұл кеме ABCD блоктарынан тұрады.
Dialogue: 0,0:10:04.10,0:10:07.14,Default,,0,0,0,,‎Әрқайсысында босату құрылғысы бар сияқты.
Dialogue: 0,0:10:07.77,0:10:10.44,Default,,0,0,0,,‎Оны төртеуінің біреуімен жоюға болады ма?
Dialogue: 0,0:10:10.56,0:10:14.28,Default,,0,0,0,,Мен бәрінен бас тартуым керек пе, білмеймін.
Dialogue: 0,0:10:14.48,0:10:17.49,Default,,0,0,0,,‎1-ден 4-ке дейінгі сандардың да мағынасы бар.
Dialogue: 0,0:10:17.99,0:10:21.07,Default,,0,0,0,,‎Әзірше бірінші құрылғыға көшейік.
Dialogue: 0,0:10:21.20,0:10:22.28,Default,,0,0,0,,Сіз мұның қалай өтетінін көресіз.
Dialogue: 0,0:10:22.41,0:10:26.20,Default,,0,0,0,,Мен бортта хабарландырулар жасай алатынымды да білдім.
Dialogue: 0,0:10:26.33,0:10:30.08,Default,,0,0,0,,Менің ойымша, кемеде домофондар бар.
Dialogue: 0,0:10:30.21,0:10:32.29,Default,,0,0,0,,‎Менің ойымша, біз байланыста бола аламыз.
Dialogue: 0,0:10:32.54,0:10:34.17,Default,,0,0,0,,‎(Ясуи) Түсіндім (Рё) Мен де барамын.
Dialogue: 0,0:10:34.30,0:10:38.97,Default,,0,0,0,,‎Жоқ, Ryo Құрылғыны жіберсеңіз, қуат өшуі мүмкін.
Dialogue: 0,0:10:39.09,0:10:41.55,Default,,0,0,0,,Сіз қазір қашу жолын қамтамасыз етуіңіз керек.
Dialogue: 0,0:10:42.18,0:10:44.93,Default,,0,0,0,,Қараңғыда да адаспастан шығу үшін
Dialogue: 0,0:10:45.06,0:10:45.89,Default,,0,0,0,,Түсінді
Dialogue: 0,0:10:46.22,0:10:47.85,Default,,0,0,0,,‎Менімен бірге біреу келсін.
Dialogue: 0,0:10:47.98,0:10:48.85,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:10:49.10,0:10:51.27,Default,,0,0,0,,‎А, а, мен де барамын.
Dialogue: 0,0:10:51.40,0:10:54.65,Default,,0,0,0,,‎Натчан, қолыңнан келгеннің бәрін істе. Мен Рёкунмен барамын.
Dialogue: 0,0:10:55.23,0:10:56.86,Default,,0,0,0,,(Ясуи) Тағы бір мәселе бар. (Араши) А?
Dialogue: 0,0:10:57.36,0:10:58.94,Default,,0,0,0,,‎Бактериялар.
Dialogue: 0,0:10:59.07,0:11:02.57,Default,,0,0,0,,Пролиферация жылдамдығы әдеттен тыс жоғары жылдамдыққа дейін артып келеді
Dialogue: 0,0:11:02.70,0:11:04.66,Default,,0,0,0,,‎(Банумару) Бұл не? Бұл қорқынышты.
Dialogue: 0,0:11:04.78,0:11:06.83,Default,,0,0,0,,Темірді жейтін бактериялар
Dialogue: 0,0:11:06.95,0:11:09.71,Default,,0,0,0,,‎Кеменің жұмысына қандай да бір әсер етуі мүмкін.
Dialogue: 0,0:11:10.04,0:11:12.67,Default,,0,0,0,,Басқаша айтқанда, бұл кеме қауіпті.
Dialogue: 0,0:11:12.88,0:11:15.29,Default,,0,0,0,,‎(Ясуи) Дұрыс. Сақ болыңыз.
Dialogue: 0,0:11:15.42,0:11:16.84,Default,,0,0,0,,‎(Рё) Ясуи (Ясуи) Иә?
Dialogue: 0,0:11:16.96,0:11:18.05,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:11:18.51,0:11:19.76,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:11:20.59,0:11:22.34,Default,,0,0,0,,‎Hehehehehe…
Dialogue: 0,0:11:22.47,0:11:25.43,Default,,0,0,0,,«Ясуи, жақсысың ба?» Фуфуфу, жарайды.
Dialogue: 0,0:11:25.55,0:11:27.39,Default,,0,0,0,,‎(Ryo) Бұл не? (Бамимару) Ясуи Махаббат
Dialogue: 0,0:11:27.52,0:11:29.31,Default,,0,0,0,,Мен мағынасын түсінбеймін
Dialogue: 0,0:11:29.43,0:11:31.64,Default,,0,0,0,,Мен сол жігітпен санасып келдім.
Dialogue: 0,0:11:31.77,0:11:35.44,Default,,0,0,0,,‎Ол жетекшілік және қиын істермен айналысатын.
Dialogue: 0,0:11:35.56,0:11:39.40,Default,,0,0,0,,‎Сонымен, егер сен өзіңді бақыламасаң, мен әуре боламын. Бар болғаны.
Dialogue: 0,0:11:39.78,0:11:44.28,Default,,0,0,0,,‎Хехехе~ Егер салқындап кетсе, мен сені ұнататын шығармын.
Dialogue: 0,0:11:44.41,0:11:46.08,Default,,0,0,0,,‎(Банмару) Уф, о... бір!
Dialogue: 0,0:11:46.53,0:11:48.04,Default,,0,0,0,,‎K… Қара белбеу?
Dialogue: 0,0:11:48.16,0:11:49.37,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:11:51.41,0:11:54.33,Default,,0,0,0,,‎Егер сіз шығуға бет алсаңыз, мен сізбен бірге барамын.
Dialogue: 0,0:11:54.46,0:11:56.34,Default,,0,0,0,,‎Бамару Хотарумен бірге.
Dialogue: 0,0:11:56.59,0:11:58.00,Default,,0,0,0,,Сәлем
Dialogue: 0,0:11:58.71,0:12:00.92,Default,,0,0,0,,‎(Оттылар) Ясуи-сан және басқалар, мені естисің бе?
Dialogue: 0,0:12:01.05,0:12:03.93,Default,,0,0,0,,‎Домофонды тапқан кезде онымен сөйлесіп көріңіз.
Dialogue: 0,0:12:05.97,0:12:08.47,Default,,0,0,0,,‎Аа... а, міне, солай.
Dialogue: 0,0:12:08.76,0:12:11.52,Default,,0,0,0,,‎Мошимоши (Бамимару) О, мен оны естимін, Нацу
Dialogue: 0,0:12:11.64,0:12:13.73,Default,,0,0,0,,‎Ah, орын да көрсетіледі.
Dialogue: 0,0:12:14.48,0:12:18.27,Default,,0,0,0,,Түзу жүріп, екі тік жолдан өтіңіз...
Dialogue: 0,0:12:18.40,0:12:20.23,Default,,0,0,0,,Келесі бұрышқа өтіңіз
Dialogue: 0,0:12:20.36,0:12:23.45,Default,,0,0,0,,‎(Араши) Керемет... Мен мұндай қулықтың барына сене алар емеспін.
Dialogue: 0,0:12:23.57,0:12:28.91,Default,,0,0,0,,‎(Ясуи) Дұрыс. Бұл кемені қалай мұқият жүргізу керектігін біліңіз.
Dialogue: 0,0:12:29.49,0:12:32.79,Default,,0,0,0,,‎Жарайды Араши Нацу, мен қадамымды бақылаймын.
Dialogue: 0,0:12:32.91,0:12:34.25,Default,,0,0,0,,‎(Араши/Нацу) Иә!
Dialogue: 0,0:12:34.92,0:12:38.25,Default,,0,0,0,,‎(пион) Біз кірген есік алда.
Dialogue: 0,0:12:38.38,0:12:39.80,Default,,0,0,0,,‎Қисық орын
Dialogue: 0,0:12:40.17,0:12:43.34,Default,,0,0,0,,Сыртта қараңғы. Таза ауаны сағындым.
Dialogue: 0,0:12:43.76,0:12:44.59,Default,,0,0,0,,Мұнда?
Dialogue: 0,0:12:45.30,0:12:48.55,Default,,0,0,0,,‎Бұл не, өртке қарсы есік? Су өткізбейтін қабырға?
Dialogue: 0,0:12:48.68,0:12:50.56,Default,,0,0,0,,‎Бұл шынымен қалың сияқты.
Dialogue: 0,0:12:50.76,0:12:52.18,Default,,0,0,0,,‎Қашан...
Dialogue: 0,0:12:52.31,0:12:54.94,Default,,0,0,0,,Бұл экипажды қамауға алу механизмі ме?
Dialogue: 0,0:12:55.06,0:12:57.35,Default,,0,0,0,,Ешкімнің қашып кетуіне жол бермей, өзіңізді жарғыңыз келе ме?
Dialogue: 0,0:12:57.61,0:13:00.82,Default,,0,0,0,,Бұл кеме болжамды жауларға дайындалған.
Dialogue: 0,0:13:00.94,0:13:04.82,Default,,0,0,0,,‎Кемеңіздің ұрлануын/ұрлануын болдырмаңыз
Dialogue: 0,0:13:04.95,0:13:08.82,Default,,0,0,0,,‎Егер бұл орын алса, келесі жолы өзіңізді құлыптап, өзіңізді жойыңыз.
Dialogue: 0,0:13:10.24,0:13:13.25,Default,,0,0,0,,‎Эй Рёкун, біз қай есіктен кірдік?
Dialogue: 0,0:13:13.66,0:13:16.08,Default,,0,0,0,,‎Мен де бұған үлкен үміт артпаймын, бірақ мен тырысамын.
Dialogue: 0,0:13:16.79,0:13:19.75,Default,,0,0,0,,‎(Пионгүл) Банумару Хотару Мен кірген кіреберіс жабылып қалды.
Dialogue: 0,0:13:19.88,0:13:22.92,Default,,0,0,0,,‎(Банмару) Иә? Бұл өтірік пе? (пион) Басқа нәрсе ізде
Dialogue: 0,0:13:23.67,0:13:25.84,Default,,0,0,0,,‎(Ясуи) Баратын жерімізге жеттік.
Dialogue: 0,0:13:26.88,0:13:28.64,Default,,0,0,0,,Мен шығу туралы естідім.
Dialogue: 0,0:13:28.76,0:13:32.60,Default,,0,0,0,,‎Зымыранды тоқтатудан басқа амалымыз жоқ сияқты.
Dialogue: 0,0:13:32.72,0:13:35.31,Default,,0,0,0,,‎Қазір ішіне қарап, маған қайта хабарласыңыз.
Dialogue: 0,0:13:43.23,0:13:44.74,Default,,0,0,0,,‎(Arashi) терминалы?
Dialogue: 0,0:13:44.86,0:13:47.91,Default,,0,0,0,,‎Егер идентификаторыңызды немесе құпия сөзіңізді сұрасаңыз, сіз жоқсыз.
Dialogue: 0,0:13:48.20,0:13:51.03,Default,,0,0,0,,‎Мен мұндай нәрсені білмеймін, Араши, солай істе.
Dialogue: 0,0:13:51.24,0:13:53.08,Default,,0,0,0,,Ішінде монитор бар.
Dialogue: 0,0:13:53.20,0:13:55.45,Default,,0,0,0,,О, Нацу, қолыңнан келгеннің бәрін жаса.
Dialogue: 0,0:13:55.58,0:13:58.71,Default,,0,0,0,,‎Даусыңыз үнемі естілетініне көз жеткізіңіз.
Dialogue: 0,0:13:59.21,0:14:01.09,Default,,0,0,0,,‎Пиондар, сіз де тыңдаңыз.
Dialogue: 0,0:14:01.21,0:14:02.17,Default,,0,0,0,,Жарайды
Dialogue: 0,0:14:04.46,0:14:06.51,Default,,0,0,0,,Алдымен, қуат қосылатынын тексеріңіз...
Dialogue: 0,0:14:15.10,0:14:18.35,Default,,0,0,0,,‎(Араши) «Сүйікті кітап»? Мен мұны түсінуге ешқандай мүмкіндік жоқ.
Dialogue: 0,0:14:18.48,0:14:20.69,Default,,0,0,0,,‎(Пион) Араши «Ескі теңізші линиясы»
Dialogue: 0,0:14:20.81,0:14:24.53,Default,,0,0,0,,‎Кандзи «Кәрі теңізші кетеді». Оны енгізіп көріңіз.
Dialogue: 0,0:14:24.65,0:14:26.65,Default,,0,0,0,,Бұл капитанның келтірген соңғы өлеңі.
Dialogue: 0,0:14:27.03,0:14:28.32,Default,,0,0,0,,Рахмет Пиони-сан
Dialogue: 0,0:14:29.45,0:14:32.74,Default,,0,0,0,,‎(Пион) Капитан альбатросты себепсіз өлтірді.
Dialogue: 0,0:14:32.87,0:14:33.83,Default,,0,0,0,,‎Қарғыс атылған―
Dialogue: 0,0:14:34.20,0:14:38.37,Default,,0,0,0,,Қаңғыбас болыңыз және құтқарылу сапарына шығыңыз
Dialogue: 0,0:14:39.00,0:14:41.04,Default,,0,0,0,,‎Ағылшын ақынының поэмасы.
Dialogue: 0,0:14:43.88,0:14:44.75,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:46.42,0:14:49.22,Default,,0,0,0,,‎Код?
Dialogue: 0,0:14:49.55,0:14:50.76,Default,,0,0,0,,‎«Соңғы жолғыдай»?
Dialogue: 0,0:14:51.22,0:14:56.02,Default,,0,0,0,,Хотару-чан, зымыран ұшыру туралы шешімді қалай қою керектігін білесің бе?
Dialogue: 0,0:14:56.14,0:14:58.48,Default,,0,0,0,,Жабдық нұсқаулығын қайта қарап шыға аласыз ба?
Dialogue: 0,0:14:58.60,0:15:00.77,Default,,0,0,0,,‎Бұл шығару емес, шығару емес пе?
Dialogue: 0,0:15:00.90,0:15:01.73,Default,,0,0,0,,‎(Араши) Ах
Dialogue: 0,0:15:01.85,0:15:04.90,Default,,0,0,0,,‎(Пернетақта жұмысының дыбысы) ‎(Firefly) А, мінекей!
Dialogue: 0,0:15:05.02,0:15:06.78,Default,,0,0,0,,‎Ұшыру және өзін-өзі жою үшін, алдымен -
Dialogue: 0,0:15:06.90,0:15:10.07,Default,,0,0,0,,‎«Капитанды қосқанда кемінде 4 адамның келісімі қажет»
Dialogue: 0,0:15:10.20,0:15:12.07,Default,,0,0,0,,‎Сонымен 4 стенд бар ма?
Dialogue: 0,0:15:12.20,0:15:16.20,Default,,0,0,0,,‎(Firefly) 4 адам әрқайсысы жеке басын тексеру сұрақтарын қояды
Dialogue: 0,0:15:16.33,0:15:17.41,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:15:17.54,0:15:21.08,Default,,0,0,0,,‎(Firefly) Әр адам шешіп, 8 таңбалы кодты енгізгеннен кейін
Dialogue: 0,0:15:21.21,0:15:25.29,Default,,0,0,0,,‎4 адам орындау түймесін бір уақытта 3 секундтан астам басып тұруы керек
Dialogue: 0,0:15:25.84,0:15:27.67,Default,,0,0,0,,‎О, оның құлпын ашудың да жолы болды!
Dialogue: 0,0:15:28.17,0:15:32.38,Default,,0,0,0,,‎Орнату кезіндегідей кодты енгізіңіз және ату процедурасын орындаңыз!
Dialogue: 0,0:15:32.72,0:15:36.10,Default,,0,0,0,,Басқаша айтқанда, төрт адам орнатқан кодты алыңыз...
Dialogue: 0,0:15:36.22,0:15:38.22,Default,,0,0,0,,‎Сіз бір уақытта босату түймесін басуыңыз керек.
Dialogue: 0,0:15:38.35,0:15:40.73,Default,,0,0,0,,‎(Отты) Иә (Араши) Алдыңғы сұрақтан.
Dialogue: 0,0:15:40.85,0:15:43.48,Default,,0,0,0,,Капитан кодты осы жерге енгізген болуы керек.
Dialogue: 0,0:15:43.60,0:15:46.02,Default,,0,0,0,,‎От фляж, мені капитанның бөлмесіне апарыңыз.
Dialogue: 0,0:15:46.15,0:15:47.61,Default,,0,0,0,,‎(От құс) A 1 6
Dialogue: 0,0:15:49.65,0:15:51.53,Default,,0,0,0,,‎(Араши) Менде бір түсінік болғанын қалаймын...
Dialogue: 0,0:15:51.65,0:15:52.49,Default,,0,0,0,,Иә…
Dialogue: 0,0:15:52.91,0:15:54.70,Default,,0,0,0,,Жоқ, күте тұрыңыз.
Dialogue: 0,0:15:54.82,0:15:58.95,Default,,0,0,0,,‎Біз капитанның кодын білсек те, қалған үшеуімен не істеуіміз керек?
Dialogue: 0,0:16:01.00,0:16:02.67,Default,,0,0,0,,‎Ха! (Ясуи) Бірдеңе ізде.
Dialogue: 0,0:16:02.79,0:16:05.58,Default,,0,0,0,,‎(Ясуи) Араши Мына терминалға да қараңдар. (Араши) Иә.
Dialogue: 0,0:16:14.89,0:16:18.51,Default,,0,0,0,,‎Мүмкін қалтаңда жазба бар шығар...
Dialogue: 0,0:16:18.85,0:16:22.02,Default,,0,0,0,,‎Ол болса да, мен оны шығара алмаймын деп ойлаймын...
Dialogue: 0,0:16:22.35,0:16:24.73,Default,,0,0,0,,‎Платина? Тот баспаған
Dialogue: 0,0:16:25.40,0:16:28.65,Default,,0,0,0,,‎Ха! Ахх! Араши-кун Ясуи-кун!
Dialogue: 0,0:16:28.77,0:16:29.94,Default,,0,0,0,,‎(Араши) Иә?
Dialogue: 0,0:16:30.82,0:16:31.82,Default,,0,0,0,,Табылды!
Dialogue: 0,0:16:40.62,0:16:41.83,Default,,0,0,0,,‎Яй Нацу!
Dialogue: 0,0:16:41.95,0:16:43.91,Default,,0,0,0,,‎(Ясуи) Келесі №2 Кеттік Иә!
Dialogue: 0,0:16:44.25,0:16:45.92,Default,,0,0,0,,‎Сен шынымен істедің! ?
Dialogue: 0,0:16:46.04,0:16:47.33,Default,,0,0,0,,Бірінші нәрсе
Dialogue: 0,0:16:47.79,0:16:49.17,Default,,0,0,0,,‎(Банмару) 1-стенд тазартылды!
Dialogue: 0,0:16:49.59,0:16:50.42,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:16:52.92,0:16:54.17,Default,,0,0,0,,‎(Араши) Жалғыз мәселе...
Dialogue: 0,0:16:54.30,0:16:58.26,Default,,0,0,0,,‎Бұл капитаннан басқа ешкім оларды жеке-жеке тани алмайды, солай ма?
Dialogue: 0,0:16:58.80,0:17:00.51,Default,,0,0,0,,‎Кодты іздеудің қажеті жоқ
Dialogue: 0,0:17:03.77,0:17:05.02,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:17:05.48,0:17:08.65,Default,,0,0,0,,«Сіздің» кім екеніңізді білуге мүмкіндік жоқ.
Dialogue: 0,0:17:08.77,0:17:09.61,Default,,0,0,0,,‎(Ясуи)
Dialogue: 0,0:17:09.86,0:17:12.19,Default,,0,0,0,,‎Мими… Мими-чан
Dialogue: 0,0:17:12.32,0:17:13.78,Default,,0,0,0,,‎(Ясуи/Араши) Иә?
Dialogue: 0,0:17:16.70,0:17:17.78,Default,,0,0,0,,‎Бұл керемет, Нацу!
Dialogue: 0,0:17:17.91,0:17:20.37,Default,,0,0,0,,Мими-чанның фото жиектемелері болды.
Dialogue: 0,0:17:20.49,0:17:24.12,Default,,0,0,0,,‎Код... Фото жиектеме қай жерде болды...
Dialogue: 0,0:17:24.25,0:17:26.00,Default,,0,0,0,,‎Сіз ол жерге барсаңыз, білуіңіз мүмкін.
Dialogue: 0,0:17:26.12,0:17:27.12,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:17:31.96,0:17:35.34,Default,,0,0,0,,‎Иә, тапсырыстарды бөлгіңіз келе ме?
Dialogue: 0,0:17:35.47,0:17:38.59,Default,,0,0,0,,‎Араши-кун және басқалар, 3 және 4 құрылғыларына өтіңіз.
Dialogue: 0,0:17:38.72,0:17:39.72,Default,,0,0,0,,‎Нацу?
Dialogue: 0,0:17:40.01,0:17:42.18,Default,,0,0,0,,‎Жарайды, өзіңіз бара аласыз.
Dialogue: 0,0:17:42.64,0:17:44.68,Default,,0,0,0,,‎Олай болса мен сізге 2 санын қалдырамын.
Dialogue: 0,0:17:44.81,0:17:46.14,Default,,0,0,0,,Нацу, тоқтат.
Dialogue: 0,0:17:47.56,0:17:48.40,Default,,0,0,0,,Мен де барамын!
Dialogue: 0,0:17:48.73,0:17:50.94,Default,,0,0,0,,№. 3 ең жақын.
Dialogue: 0,0:17:51.07,0:17:52.48,Default,,0,0,0,,‎(Хаманумару) Онда барайық!
Dialogue: 0,0:17:53.36,0:17:56.40,Default,,0,0,0,,‎(Firefly) Сондықтан Ханумару мырза 3-ші нөмірге бет алды.
Dialogue: 0,0:17:56.53,0:17:59.49,Default,,0,0,0,,‎Араши-кун және т.б., 4 нөміріне өтіңіз.
Dialogue: 0,0:17:59.62,0:18:02.08,Default,,0,0,0,,Жалғыз болған дұрыс па?
Dialogue: 0,0:18:02.53,0:18:05.87,Default,,0,0,0,,‎Нацу жалғыз демалып жатса да, мен қалай демаламын!
Dialogue: 0,0:18:06.33,0:18:08.21,Default,,0,0,0,,‎Сондай-ақ тез шығуды табу керек.
Dialogue: 0,0:18:12.25,0:18:15.01,Default,,0,0,0,,‎(Ханумару) Араши, қазір не жегің келеді?
Dialogue: 0,0:18:15.13,0:18:16.88,Default,,0,0,0,,Менде карри күріш бар
Dialogue: 0,0:18:17.01,0:18:18.76,Default,,0,0,0,,‎(Араши) А, мен де солай болармын!
Dialogue: 0,0:18:18.88,0:18:20.76,Default,,0,0,0,,‎Мен үшін теңіз өнімдерінен жасалған карри.
Dialogue: 0,0:18:21.05,0:18:22.72,Default,,0,0,0,,Маған тауықтың орташа ащы болғаны ұнайды!
Dialogue: 0,0:18:22.85,0:18:26.23,Default,,0,0,0,,‎Жасыл карри мен кокос сүтін де тастау қиын.
Dialogue: 0,0:18:26.35,0:18:28.10,Default,,0,0,0,,Көп көкөністер беріледі!
Dialogue: 0,0:18:28.23,0:18:31.27,Default,,0,0,0,,‎Аа... Мен көкөністерді ұнатпаймын.
Dialogue: 0,0:18:31.40,0:18:33.19,Default,,0,0,0,,‎Әсіресе ірі картоп...
Dialogue: 0,0:18:33.32,0:18:35.15,Default,,0,0,0,,Түсіндім! Мен де
Dialogue: 0,0:18:35.28,0:18:36.36,Default,,0,0,0,,‎Егер картоп үлкен болса...
Dialogue: 0,0:18:36.49,0:18:39.32,Default,,0,0,0,,‎Мен карридің дәмі бөлінгендей сезінемін.
Dialogue: 0,0:18:39.45,0:18:41.99,Default,,0,0,0,,‎Ясуи мырза және басқалары карри жеді ме?
Dialogue: 0,0:18:42.37,0:18:45.08,Default,,0,0,0,,Мен мұны жақсы орындадым. Барлығына ұнады.
Dialogue: 0,0:18:45.66,0:18:47.04,Default,,0,0,0,,‎Тіпті лагерьде, үлкен қазанда...
Dialogue: 0,0:18:47.41,0:18:49.12,Default,,0,0,0,,‎Олай болса бұл карри, Банумару.
Dialogue: 0,0:18:49.54,0:18:50.87,Default,,0,0,0,,‎(Пернетақта жұмысының дыбысы)
Dialogue: 0,0:18:53.17,0:18:56.71,Default,,0,0,0,,Дұрыс! Араши мен ас үйге барамын.
Dialogue: 0,0:18:56.84,0:19:01.05,Default,,0,0,0,,Бұл жігіт аспаз болуы керек, оның тоңазытқышта жазбасы бар шығар.
Dialogue: 0,0:19:03.64,0:19:07.06,Default,,0,0,0,,‎(Ясуи) Бір-біріне оқ атқандар көп болса керек. Тесіктер көп.
Dialogue: 0,0:19:07.35,0:19:09.56,Default,,0,0,0,,‎(Араши) Терминал тірі ме?
Dialogue: 0,0:19:10.52,0:19:12.31,Default,,0,0,0,,Жылжытуыңызды өтінеміз.
Dialogue: 0,0:19:17.86,0:19:20.03,Default,,0,0,0,,«Бұл кемеде қандай спорт түрлерін ойнауға болмайды?»
Dialogue: 0,0:19:20.15,0:19:21.28,Default,,0,0,0,,‎(Банумару) Спорт?
Dialogue: 0,0:19:21.41,0:19:24.16,Default,,0,0,0,,‎Келесі опциялардың бірін таңдаңыз
Dialogue: 0,0:19:24.28,0:19:26.95,Default,,0,0,0,,‎Футбол қоржынындағы боулинг
Dialogue: 0,0:19:27.08,0:19:29.66,Default,,0,0,0,,‎Гольф Теннис Бейсбол
Dialogue: 0,0:19:30.12,0:19:32.08,Default,,0,0,0,,‎Бортта орындау мүмкін емес...
Dialogue: 0,0:19:32.37,0:19:35.88,Default,,0,0,0,,Үстел теннисі үстелі мен баскетбол голы болды, солай ма?
Dialogue: 0,0:19:36.34,0:19:39.46,Default,,0,0,0,,‎(Хаманумару) Ах, гимназия сияқты бірдеңе болды.
Dialogue: 0,0:19:39.59,0:19:42.26,Default,,0,0,0,,Қоймада волейбол доптары мен гольф клубтары бар...
Dialogue: 0,0:19:42.93,0:19:44.39,Default,,0,0,0,,(Банумару) Бейсбол емес пе... (Араши) Иә?
Dialogue: 0,0:19:44.93,0:19:47.93,Default,,0,0,0,,Ол жерде жарғанақ та, доп та болған жоқ.
Dialogue: 0,0:19:48.56,0:19:49.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:52.02,0:19:53.40,Default,,0,0,0,,А...
Dialogue: 0,0:19:54.73,0:19:58.48,Default,,0,0,0,,‎Зымыран қосқышын басқаннан кейін асылып қалдыңыз ба?
Dialogue: 0,0:19:58.86,0:20:01.53,Default,,0,0,0,,Кешіріңіз, бірақ біз оны тоқтатамыз.
Dialogue: 0,0:20:01.82,0:20:04.49,Default,,0,0,0,,‎(Араши) Ханумару Жауап бейсбол болды.
Dialogue: 0,0:20:05.32,0:20:07.20,Default,,0,0,0,,‎(Араши) ‎Бамамару, не болды? (Домофонның басылған дыбысы)
Dialogue: 0,0:20:07.33,0:20:09.58,Default,,0,0,0,,‎(Банумару) А, мен де кодты алдым.
Dialogue: 0,0:20:09.70,0:20:10.62,Default,,0,0,0,,‎(Араши) Сен істедің!
Dialogue: 0,0:20:13.00,0:20:15.88,Default,,0,0,0,,Сіздің карри жақсы болған болуы керек.
Dialogue: 0,0:20:17.71,0:20:19.05,Default,,0,0,0,,Мен қорықпаймын...
Dialogue: 0,0:20:19.17,0:20:23.59,Default,,0,0,0,,Мен басында қатты қорықтым, бірақ қазір қорықпаймын.
Dialogue: 0,0:20:23.72,0:20:26.85,Default,,0,0,0,,Керісінше, батылдық күшейеді
Dialogue: 0,0:20:26.97,0:20:28.81,Default,,0,0,0,,‎(Араши) Нацу, ол ше?
Dialogue: 0,0:20:28.93,0:20:30.22,Default,,0,0,0,,‎(Банмару) Сен тірісің бе?
Dialogue: 0,0:20:31.14,0:20:34.56,Default,,0,0,0,,Жарайды. Мен келдім. Мен оны қазір іздеймін.
Dialogue: 0,0:20:38.07,0:20:40.90,Default,,0,0,0,,‎Жоқ... Егер ол шығып, домалап кетсе...
Dialogue: 0,0:20:46.41,0:20:47.82,Default,,0,0,0,,Табылды!
Dialogue: 0,0:20:47.95,0:20:49.49,Default,,0,0,0,,‎(Банмару) О! (Араши) Ия!
Dialogue: 0,0:20:49.62,0:20:50.83,Default,,0,0,0,,А...
Dialogue: 0,0:20:54.83,0:20:57.42,Default,,0,0,0,,Өте сүйкімді, Мими Чан
Dialogue: 0,0:20:57.54,0:21:00.42,Default,,0,0,0,,Сізге оны қатты ұнатқаныңызға сенімдімін.
Dialogue: 0,0:21:00.80,0:21:02.05,Default,,0,0,0,,‎(Араши) Қайтқанда абай болыңыз
Dialogue: 0,0:21:02.88,0:21:04.22,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:06.80,0:21:08.26,Default,,0,0,0,,‎(Ясуи) Тым көп нәрсе
Dialogue: 0,0:21:10.35,0:21:11.22,Default,,0,0,0,,‎(Араши) Ах
Dialogue: 0,0:21:13.68,0:21:14.85,Default,,0,0,0,,А
Dialogue: 0,0:21:15.35,0:21:16.73,Default,,0,0,0,,(Араши) Міне болды. (Ясуи) А?
Dialogue: 0,0:21:19.06,0:21:20.69,Default,,0,0,0,,Неліктен ол жерде...
Dialogue: 0,0:21:21.19,0:21:23.94,Default,,0,0,0,,Мен оған бейсбол ұнайды деп ойладым.
Dialogue: 0,0:21:24.07,0:21:24.95,Default,,0,0,0,,Мен сенімдімін...
Dialogue: 0,0:21:25.07,0:21:28.32,Default,,0,0,0,,Мен сенің бейсбол туралы естеліктерің бар шығар деп ойладым.
Dialogue: 0,0:21:28.57,0:21:30.12,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:21:30.37,0:21:33.75,Default,,0,0,0,,Иә, Ясуи мырза, 1-нөмірге оралыңыз.
Dialogue: 0,0:21:33.87,0:21:35.16,Default,,0,0,0,,Мен 4 санына барамын.
Dialogue: 0,0:21:35.83,0:21:38.25,Default,,0,0,0,,Ештеңеге қарамастан тоқтатайық.
Dialogue: 0,0:21:38.96,0:21:40.59,Default,,0,0,0,,‎(Ясуи) Араши (Араши) Иә
Dialogue: 0,0:21:40.84,0:21:43.01,Default,,0,0,0,,Жоқ, абай болыңыз.
Dialogue: 0,0:21:43.13,0:21:44.55,Default,,0,0,0,,‎(Араши) Ясуи мырза да
Dialogue: 0,0:21:45.67,0:21:48.39,Default,,0,0,0,,‎(Ясуи) Мен мұны түсінбедім.
Dialogue: 0,0:21:48.51,0:21:52.18,Default,,0,0,0,,‎Бірақ сен, Жаз В, байқадың...
Dialogue: 0,0:21:58.27,0:22:00.52,Default,,0,0,0,,‎Күту режимінде барлығы жақсы ма?
Dialogue: 0,0:22:00.94,0:22:02.52,Default,,0,0,0,,‎(Ясуи) Иә.
Dialogue: 0,0:22:02.65,0:22:04.69,Default,,0,0,0,,‎(Банмару) Сәлем! (Араши) Жарайды
Dialogue: 0,0:22:04.82,0:22:06.40,Default,,0,0,0,,Құрметпен, Хотару-чан
Dialogue: 0,0:22:06.74,0:22:10.49,Default,,0,0,0,,‎Санақ 0 болғанда, бір уақытта 3 секунд басып тұрыңыз.
Dialogue: 0,0:22:10.62,0:22:12.49,Default,,0,0,0,,Олай болса барайық.
Dialogue: 0,0:22:13.08,0:22:17.75,Default,,0,0,0,,‎５ ４ ３ ２ 1
Dialogue: 0,0:22:18.17,0:22:19.00,Default,,0,0,0,,‎０！
Dialogue: 0,0:22:27.63,0:22:30.59,Default,,0,0,0,,‎Аа... Мен тоқтай алмаймын...
Dialogue: 0,0:22:31.80,0:22:36.81,Default,,0,0,0,,♪～
