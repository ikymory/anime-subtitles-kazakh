Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.24,0:00:11.95,OP,,0,0,0,,Жаңа гүлдеген одуванчиктердің арасында
Dialogue: 0,0:00:11.95,0:00:15.87,OP,,0,0,0,,Қарға айналмайтын су тамшылары
Dialogue: 0,0:00:15.87,0:00:19.74,OP,,0,0,0,,Мен көз жасына боялған жүзді ажырата аламын деп ойладым
Dialogue: 0,0:00:19.74,0:00:22.46,OP,,0,0,0,,Мен ойланбастан қолшатырымды ұсындым
Dialogue: 0,0:00:22.46,0:00:26.57,OP,,0,0,0,,Солға немесе оңға жүру дұрыс па?
Dialogue: 0,0:00:26.57,0:00:30.38,OP,,0,0,0,,Мен шынымен шешім қабылдамай тұрып жол аяқталды
Dialogue: 0,0:00:30.38,0:00:34.43,OP,,0,0,0,,Бірақ бұл ерекше біреуді аямайтын дұрыс қоңырау екені сөзсіз
Dialogue: 0,0:00:34.43,0:00:38.36,OP,,0,0,0,,Кез келген азапты тәжірибелерден
Dialogue: 0,0:00:38.36,0:00:41.49,OP,,0,0,0,,Ендеше, кішкене батылдықпен, алға ұмтылыңыз
Dialogue: 0,0:00:41.49,0:00:45.07,OP,,0,0,0,,Егер бәрі қисық болса, қиғаш жолмен жүріңіз
Dialogue: 0,0:00:45.07,0:00:48.80,OP,,0,0,0,,Алға қарай жүрсең, нұрды табасың
Dialogue: 0,0:00:48.80,0:00:52.52,OP,,0,0,0,,Бір-біріне үйіріліп, бір дауыста сайрап тұрған кішкентай құстар сияқты
Dialogue: 0,0:00:52.52,0:00:56.12,OP,,0,0,0,,Біз жаңа маусымның басында міндетті түрде қоңырау шаламыз
Dialogue: 0,0:00:56.12,0:00:58.92,OP,,0,0,0,,Сонымен көктем бізді тағы да құшағына алады
Dialogue: 0,0:00:58.92,0:01:03.15,OP,,0,0,0,,Біз жаңа беттерге бояуды шашыратып жібереміз
Dialogue: 0,0:01:03.15,0:01:07.04,OP,,0,0,0,,Екеуміз тез дос болдық, жақсы тамақтандық
Dialogue: 0,0:01:07.04,0:01:09.68,OP,,0,0,0,,Біз тіпті аздап ұрысып қалған шығармыз
Dialogue: 0,0:01:09.68,0:01:13.32,OP,,0,0,0,,Бірақ біз сол кішкентай сәттерді жүрегімізде сақтаймыз
Dialogue: 0,0:01:13.32,0:01:17.05,OP,,0,0,0,,Бізді қателесуге болмайтын болашаққа итермелейтін себептер ретінде
Dialogue: 0,0:01:17.05,0:01:21.44,OP,,0,0,0,,Күн сәулесі түскен ағаштардың арасында қанша рет адасып қалсақ та
Dialogue: 0,0:01:21.44,0:01:26.04,OP,,0,0,0,,Бүгін мұнда бір жақты билетпен желдер алып кетті
Dialogue: 0,0:01:26.04,0:01:27.49,OP,,0,0,0,,Бұл тамаша күнге гүлдейді
Dialogue: 0,0:01:32.41,0:01:35.50,titles,,0,0,0,,Өртенген өріс (1-бөлім)
Dialogue: 0,0:01:50.67,0:01:52.51,Default-ja,,0,0,0,,Ах... Ах...
Dialogue: 0,0:01:55.30,0:01:58.14,Default-ja,,0,0,0,,Мм...
Dialogue: 5,0:01:55.40,0:01:56.90,Default,,0,0,0,,Олар дәл қашан осы үйдің бір бөлігіне айналды?
Dialogue: 5,0:01:56.90,0:01:58.14,Default,,0,0,0,,Ой...
Dialogue: 0,0:01:58.31,0:01:59.89,Default-ja,,0,0,0,,Ннн… Ннн…
Dialogue: 0,0:02:00.77,0:02:03.02,Default-ja,,0,0,0,,Бұл не...
Dialogue: 5,0:02:00.82,0:02:03.02,Default,,0,0,0,,Менің айтайын дегенім, не...
Dialogue: 0,0:02:03.02,0:02:08.53,signs,,0,0,0,,SHOGI MAESTRO ТУРНИРІ
Dialogue: 1,0:02:03.02,0:02:08.53,signs,,0,0,0,,SHOGI MAESTRO ТУРНИРІ
Dialogue: 0,0:02:03.02,0:02:08.53,signs,,0,0,0,,Babbling Stream Inn
Dialogue: 0,0:02:03.02,0:02:08.53,signs,,0,0,0,,Seiryuueen
Dialogue: 1,0:02:03.02,0:02:08.53,signs,,0,0,0,,Сейірюуен
Dialogue: 0,0:02:03.02,0:02:08.53,signs,,0,0,0,,Әйелдерге арналған жоспарға спа қызметтері мен түскі ас курсы кіреді
Dialogue: 1,0:02:03.02,0:02:08.53,signs,,0,0,0,,Әйелдерге арналған жоспарға спа қызметтері мен түскі ас курсы кіреді
Dialogue: 2,0:02:03.02,0:02:08.53,signs,,0,0,0,,Әйелдерге арналған жоспарға спа қызметтері мен түскі ас курсы кіреді
Dialogue: 0,0:02:03.02,0:02:08.53,signs,,0,0,0,,Қатысқан шығыс шоги ханзадаларының жұбы
Dialogue: 1,0:02:03.02,0:02:08.53,signs,,0,0,0,,Қатысқан шығыс шоги ханзадаларының жұбы
Dialogue: 2,0:02:03.02,0:02:08.53,signs,,0,0,0,,Қатысқан шығыс шоги ханзадаларының жұбы
Dialogue: 0,0:02:03.02,0:02:08.53,signs,,0,0,0,,Демонстрациялық тақтаға түсініктеме
Dialogue: 1,0:02:03.02,0:02:08.53,signs,,0,0,0,,Демонстрациялық тақтаға түсініктеме
Dialogue: 0,0:02:03.02,0:02:08.53,signs,,0,0,0,,Әртүрлі қабылдаулар жоспарланған
Dialogue: 1,0:02:03.02,0:02:08.53,signs,,0,0,0,,Әртүрлі қабылдаулар жоспарланған
Dialogue: 0,0:02:03.81,0:02:08.53,Default-ja,,0,0,0,,Өткен жолғыдан да нашар, дәлірек айтсақ...
Dialogue: 5,0:02:03.83,0:02:07.43,Default,,0,0,0,,Бұл бұрынғысынан да нашар.
Dialogue: 5,0:02:07.43,0:02:08.53,Default,,0,0,0,,9-эпизод
Dialogue: 0,0:02:08.53,0:02:09.40,signs,,0,0,0,,Қатысқан шығыс шоги ханзадаларының жұбы
Dialogue: 1,0:02:08.53,0:02:09.40,signs,,0,0,0,,Қатысқан шығыс шоги ханзадаларының жұбы
Dialogue: 2,0:02:08.53,0:02:09.40,signs,,0,0,0,,Қатысқан шығыс шоги ханзадаларының жұбы
Dialogue: 0,0:02:08.53,0:02:09.40,signs,,0,0,0,,Демонстрациялық тақтаға түсініктеме
Dialogue: 1,0:02:08.53,0:02:09.40,signs,,0,0,0,,Демонстрациялық тақтаға түсініктеме
Dialogue: 5,0:02:09.40,0:02:12.15,Default,,0,0,0,,Неліктен бізде үлкен план бар?
Dialogue: 0,0:02:09.57,0:02:12.03,Default-ja,,0,0,0,,Біз неге тұрмыз?
Dialogue: 5,0:02:12.15,0:02:14.53,Default,,0,0,0,,«Шығыс шоги ханзадаларының жұбы»?
Dialogue: 0,0:02:12.15,0:02:14.53,Default-ja,,0,0,0,,«Шығыс Шоги ханзадасы жұбы»?
Dialogue: 0,0:02:15.16,0:02:18.24,Default-ja,,0,0,0,,Мына сопақ жақтау дұрыс емес пе?
Dialogue: 5,0:02:15.19,0:02:18.25,Default,,0,0,0,,Мен екеуіңнің айналаңдағы сопақ жақтауларды білмеймін.
Dialogue: 0,0:02:18.41,0:02:19.75,Default-ja,,0,0,0,,Мен не айтуым керек?
Dialogue: 5,0:02:18.54,0:02:23.38,Default,,0,0,0,,Бұл жылнама күні сабаққа келмеген студенттердің суреттері сияқты.
Dialogue: 0,0:02:19.91,0:02:23.37,Default-ja,,0,0,0,,Жылнамада болмаған адамға ұқсайды...
Dialogue: 5,0:02:23.38,0:02:26.38,Default,,0,0,0,,Олар суретке түсіре берді.
Dialogue: 0,0:02:23.54,0:02:26.38,Default-ja,,0,0,0,,Жоқ... Алсаң, аласың.
Dialogue: 0,0:02:26.54,0:02:31.26,Default-ja,,0,0,0,,Бұл жолы «Мен сені әрқашан көктен бақылап отырамын» деген сияқты нәрсе—
Dialogue: 5,0:02:26.78,0:02:33.39,Default,,0,0,0,,Бірақ содан кейін «Біз сені әрқашан көктен бақылап отырамыз» деген діріл пайда болды.
Dialogue: 0,0:02:31.38,0:02:33.38,Default-ja,,0,0,0,,Атмосфера сезімі бар...
Dialogue: 0,0:02:39.18,0:02:41.39,Default-ja,,0,0,0,,Мен оны қолданып көрдім...
Dialogue: 5,0:02:39.24,0:02:41.40,Default,,0,0,0,,Сонымен, сіз оны қолданып көрдіңіз.
Dialogue: 5,0:02:41.40,0:02:45.11,Default,,0,0,0,,Shogi Maestro турниріне қаражат жинау қиын.
Dialogue: 0,0:02:41.56,0:02:45.02,Default-ja,,0,0,0,,Шоги турниріне қаражат жинау қиын.
Dialogue: 5,0:02:45.11,0:02:49.40,Default,,0,0,0,,Мен Шоги қауымдастығының бас менеджері Накамурадан дизайн ойлап табуды сұрадым.
Dialogue: 0,0:02:45.15,0:02:49.40,Default-ja,,0,0,0,,Мен Шоги федерациясының бас менеджері Накамура мырзадан оның дизайнын сұрадым.
Dialogue: 0,0:02:49.90,0:02:54.15,Default-ja,,0,0,0,,Бұл тегін, бірақ бәрібір қиын...
Dialogue: 5,0:02:49.96,0:02:54.16,Default,,0,0,0,,бірақ ешқандай ақша жұмсамай, бұл жоғары тапсырыс.
Dialogue: 5,0:02:54.16,0:02:57.29,Default,,0,0,0,,Иә, мен бұл оңай деп ойладым.
Dialogue: 0,0:02:54.32,0:02:57.28,Default-ja,,0,0,0,,Жарайды, мен оңай болар деп ойладым, бірақ жоқ.
Dialogue: 5,0:02:57.29,0:03:00.04,Default,,0,0,0,,Жобалау өте қиын.
Dialogue: 0,0:02:57.45,0:03:00.04,Default-ja,,0,0,0,,Өйткені дизайн қиын.
Dialogue: 5,0:03:00.04,0:03:01.33,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:03:00.20,0:03:01.33,Default-ja,,0,0,0,,Бұл біртүрлі
Dialogue: 5,0:03:01.33,0:03:04.58,Default,,0,0,0,,Мен колледжде оқып жүргенде компьютерлік клубта болдым.
Dialogue: 0,0:03:01.50,0:03:04.58,Default-ja,,0,0,0,,Мен университетте компьютерлік клубта болдым.
Dialogue: 0,0:03:04.75,0:03:10.09,Default-ja,,0,0,0,,Толқудың бәсеңдегені сонша, тіпті төрағаның да ашуы қашып кетті...
Dialogue: 5,0:03:04.95,0:03:10.09,Default,,0,0,0,,Оның алғашқы ынтасының сөнгені сонша, төраға одан айырылып қалды.
Dialogue: 0,0:03:11.67,0:03:14.72,Default-ja,,0,0,0,,Иә, жеткілікті! Жақсы! иә!
Dialogue: 5,0:03:11.74,0:03:12.18,Default,,0,0,0,,(Тик-так, тик-так соғады сағат)
Dialogue: 5,0:03:12.18,0:03:13.09,Default,,0,0,0,,Бұл жеткілікті!
Dialogue: 5,0:03:13.09,0:03:13.84,Default,,0,0,0,,Жақсы!
Dialogue: 5,0:03:13.84,0:03:14.72,Default,,0,0,0,,(Тик-так, тик-так соғады сағат)
Dialogue: 5,0:03:14.72,0:03:18.06,Default,,0,0,0,,Шын мәнінде, біз неге олардың әлсіздігін көрсетпейміз?
Dialogue: 0,0:03:14.72,0:03:18.06,signs,,0,0,0,,Қатаң бюджет
Dialogue: 1,0:03:14.72,0:03:18.06,signs,,0,0,0,,Қатаң бюджет
Dialogue: 0,0:03:14.72,0:03:18.06,signs,,0,0,0,,Жаңа идеялар
Dialogue: 1,0:03:14.72,0:03:18.06,signs,,0,0,0,,Жаңа идеялар
Dialogue: 0,0:03:14.88,0:03:18.05,Default-ja,,0,0,0,,Кемшіліктерімізді одан да көп шығарайық!
Dialogue: 5,0:03:18.06,0:03:19.98,Default,,0,0,0,,Бізде стационарлық камера болуы мүмкін
Dialogue: 0,0:03:18.22,0:03:19.97,Default-ja,,0,0,0,,Бұл қазірдің өзінде стационарлық камера.
Dialogue: 0,0:03:19.98,0:03:23.48,signs,,0,0,0,,m 95 58 l 96 109 294 111 293 56
Dialogue: 1,0:03:19.98,0:03:23.48,signs,,0,0,0,,Тікелей трансляция
Dialogue: 2,0:03:19.98,0:03:23.48,signs,,0,0,0,,Тікелей трансляция
Dialogue: 3,0:03:19.98,0:03:23.48,signs,,0,0,0,,Тікелей трансляция
Dialogue: 2,0:03:19.98,0:03:23.48,signs,,0,0,0,,Қалған уақыт
Dialogue: 3,0:03:19.98,0:03:23.48,signs,,0,0,0,,Қалған уақыт
Dialogue: 2,0:03:19.98,0:03:23.48,signs,,0,0,0,,Жүрек соғу жиілігі
Dialogue: 3,0:03:19.98,0:03:23.48,signs,,0,0,0,,Жүрек соғу жиілігі
Dialogue: 5,0:03:19.98,0:03:24.55,Default,,0,0,0,,бұл олардың ЭКГ және жүрек соғу жиілігін және матчта қалған уақытты көрсетеді!
Dialogue: 0,0:03:20.14,0:03:21.22,Default-ja,,0,0,0,,Қалған уақытпен бірге
Dialogue: 0,0:03:21.35,0:03:24.35,Default-ja,,0,0,0,,Электрокардиограмма мен жүрек соғу жиілігін алайық!
Dialogue: 5,0:03:32.99,0:03:36.99,Default,,0,0,0,,Ал келесі бөлмеде медбике тұра алады!
Dialogue: 0,0:03:33.15,0:03:36.99,Default-ja,,0,0,0,,Мені келесі бөлмеде медбике немесе бірдеңе күтіп тұр.
Dialogue: 0,0:03:37.16,0:03:41.33,Default-ja,,0,0,0,,Кез келген уақытта қайсысының құлағаны маңызды емес! Ұнайды...
Dialogue: 5,0:03:37.28,0:03:41.17,Default,,0,0,0,,"Егер олардың біреуі құлап кетсе, алаңдайтын ештеңе жоқ!"
Dialogue: 5,0:03:41.62,0:03:44.12,Default,,0,0,0,,Току! Қазірдің өзінде жеткілікті!
Dialogue: 0,0:03:41.79,0:03:44.12,Default-ja,,0,0,0,,Току-чан! Уайымдама!
