Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.89,0:00:04.98,titles,,0,0,0,,Ақ дауыл (2 бөлім)
Dialogue: 5,0:00:09.13,0:00:10.37,Default,,0,0,0,,Мен неге екенін білмеймін,
Dialogue: 0,0:00:09.15,0:00:10.32,Default-ja,,0,0,0,,Неліктен?
Dialogue: 5,0:00:24.49,0:00:26.47,Default,,0,0,0,,бірақ бәрі қайта оралды.
Dialogue: 0,0:00:24.50,0:00:26.42,Default-ja,,0,0,0,,Кенет есіме түсті
Dialogue: 5,0:00:30.81,0:00:32.35,Default,,0,0,0,,Соуя?
Dialogue: 0,0:00:30.84,0:00:32.30,Default-ja,,0,0,0,,Соя?
Dialogue: 0,0:00:33.76,0:00:35.30,Default-ja,,0,0,0,,Дұрыс...
Dialogue: 5,0:00:33.77,0:00:35.35,Default,,0,0,0,,Көрейік...
Dialogue: 0,0:00:36.18,0:00:37.30,Default-ja,,0,0,0,,Балалық шақ—
Dialogue: 5,0:00:36.19,0:00:37.35,Default,,0,0,0,,Бала кезімде,
Dialogue: 5,0:00:37.97,0:00:42.25,Default,,0,0,0,,Бір кездері үлкен қанатты ақ құс кезіп кеткен
Dialogue: 0,0:00:37.97,0:00:42.35,Default-ja,,0,0,0,,Үйдің бақшасына кіріп кеткен үлкен қанатты зат...
Dialogue: 0,0:00:45.02,0:00:46.52,Default-ja,,0,0,0,,Ақ құс
Dialogue: 5,0:00:45.03,0:00:46.42,Default,,0,0,0,,біздің аулаға.
Dialogue: 5,0:00:48.79,0:00:50.37,Default,,0,0,0,,Ол маған құсты еске түсіреді.
Dialogue: 0,0:00:48.81,0:00:50.32,Default-ja,,0,0,0,,құсқа ұқсас
Dialogue: 5,0:00:52.70,0:00:55.01,Default,,0,0,0,,Мастер Соуя дәстүрлі жапон киімі!
Dialogue: 0,0:00:52.94,0:00:54.94,Default-ja,,0,0,0,,Мастер Соя жапондық киім киіп алған!
Dialogue: 5,0:00:55.01,0:00:58.83,Default,,0,0,0,,Мен екі ойыншының да естелік матчтарға костюм киюін қалыпты жағдай деп ойладым.
Dialogue: 0,0:00:55.07,0:00:58.78,Default-ja,,0,0,0,,Еске алу ойындарында әдетте екі жақ костюм киді.
Dialogue: 0,0:00:59.12,0:01:02.87,Default-ja,,0,0,0,,Көмегің үшін рахмет, Тоно құрметті 9-шы Дэн.
Dialogue: 5,0:00:59.13,0:01:02.99,Default,,0,0,0,,Сіз құтқарушысыз, Туно Мэйо, 9-дан!
Dialogue: 5,0:01:02.99,0:01:06.43,Default,,0,0,0,,Мүлде жоқ. Матчтың менің қалада өткеніне қуаныштымын.
Dialogue: 0,0:01:02.99,0:01:06.37,Default-ja,,0,0,0,,Жоқ, жоқ, жергілікті жерде өткеніне қуаныштымын.
Dialogue: 5,0:01:06.72,0:01:10.68,Default,,0,0,0,,Менің кимоно хоббиім біреуге пайдалы болды.
Dialogue: 0,0:01:06.75,0:01:10.63,Default-ja,,0,0,0,,Менің кимоно хоббиім ақыры пайдалы болды.
Dialogue: 5,0:01:10.68,0:01:14.93,Default,,0,0,0,,Солардың бірін Мастер Соуя кигені мені мақтан тұтады.
Dialogue: 0,0:01:10.84,0:01:14.88,Default-ja,,0,0,0,,Ұстаз Сояның кигені үлкен мәртебе.
Dialogue: 5,0:01:14.93,0:01:17.86,Default,,0,0,0,,Бұл енді отбасының мұрасы болады.
Dialogue: 0,0:01:15.13,0:01:17.97,Default-ja,,0,0,0,,Мен оны отбасылық мұраға айналдырамын.
Dialogue: 0,0:01:21.26,0:01:22.76,Default-ja,,0,0,0,,Бұл біртүрлі.
Dialogue: 5,0:01:21.27,0:01:22.68,Default,,0,0,0,,Біртүрлі екен.
Dialogue: 5,0:01:23.71,0:01:26.76,Default,,0,0,0,,Ол әрқашан кітапта болатын кейіпкер сияқты болуы керек.
Dialogue: 0,0:01:23.72,0:01:26.85,Default-ja,,0,0,0,,Мен барлық уақытта әңгімеде болуым керек еді...
Dialogue: 5,0:01:27.60,0:01:30.20,Default,,0,0,0,,Бірақ қазір ол менің алдымда отыр.
Dialogue: 0,0:01:27.60,0:01:30.15,Default-ja,,0,0,0,,Қазір менің алдымда отыр
Dialogue: 5,0:01:33.96,0:01:37.21,Default,,0,0,0,,Ол тыныс алады және қозғалады.
Dialogue: 0,0:01:33.98,0:01:36.95,Default-ja,,0,0,0,,Тыныс алу және қозғалу
Dialogue: 0,0:01:37.70,0:01:41.70,Default-ja,,0,0,0,,Ал сен менімен ұрысамын дейсің
Dialogue: 5,0:01:37.74,0:01:41.77,Default,,0,0,0,,Ал ол маған қарсы ойнамақшы.
Dialogue: 0,0:01:43.74,0:01:47.41,Default-ja,,0,0,0,,Мықты болыңыз! Кеше өзің айтпадың ба?
Dialogue: 5,0:01:43.76,0:01:45.47,Default,,0,0,0,,Оны жинаңыз.
Dialogue: 5,0:01:45.47,0:01:47.47,Default,,0,0,0,,Кеше түнде өзің айтпадың ба?
Dialogue: 5,0:01:47.99,0:01:54.47,Default,,0,0,0,,Матч бастала салысымен бітпеуі үшін ойнап жатқанда зейінімді шоғырландырғым келеді.
Dialogue: 0,0:01:48.00,0:01:51.42,Default-ja,,0,0,0,,Мұның тез аяқталуына жол бермеңіз -
Dialogue: 0,0:01:51.54,0:01:54.42,Default-ja,,0,0,0,,Мен назар аударғым келеді және ...
Dialogue: 5,0:01:55.29,0:01:56.73,Default,,0,0,0,,Дәл қазір,
Dialogue: 0,0:01:55.30,0:01:59.80,Default-ja,,0,0,0,,Бұдан былай мен бұл адаммен айналысуым керек.
Dialogue: 5,0:01:57.26,0:01:59.85,Default,,0,0,0,,Бұл адаммен жолымды кесіп өтуім керек.
Dialogue: 0,0:02:00.55,0:02:02.80,Default-ja,,0,0,0,,Мен қуат айырмашылығын түсінемін, т.б.
Dialogue: 5,0:02:00.56,0:02:02.86,Default,,0,0,0,,Мен біздің қабілеттеріміздегі олқылықты жақсы білемін.
Dialogue: 5,0:02:03.80,0:02:07.11,Default,,0,0,0,,Бірақ егер мен жеңіске жету ниетінен басқа нәрсемен айналыссам,
Dialogue: 0,0:02:03.81,0:02:07.06,Default-ja,,0,0,0,,Бірақ егер сіз «жеңуден» басқа оймен секірсеңіз—
Dialogue: 5,0:02:08.47,0:02:10.61,Default,,0,0,0,,әп-сәтте басым ұшып кетеді.
Dialogue: 0,0:02:08.48,0:02:10.56,Default-ja,,0,0,0,,Бір сәтте басыңды ұшырып ал
Dialogue: 5,0:02:13.68,0:02:14.96,Default,,0,0,0,,Жақсы сәйкестік.
Dialogue: 0,0:02:13.69,0:02:15.02,Default-ja,,0,0,0,,Өтінемін
Dialogue: 0,0:02:23.73,0:02:26.46,OP,,0,0,0,,Жаңа гүлдеген одуванчиктердің арасында
Dialogue: 0,0:02:26.46,0:02:30.38,OP,,0,0,0,,Қарға айналмайтын су тамшылары
Dialogue: 0,0:02:30.38,0:02:34.25,OP,,0,0,0,,Мен көз жасына боялған жүзді ажырата аламын деп ойладым
Dialogue: 0,0:02:34.25,0:02:36.97,OP,,0,0,0,,Сондықтан мен ойланбастан қолшатырымды ұсындым
Dialogue: 0,0:02:36.97,0:02:41.08,OP,,0,0,0,,Солға немесе оңға жүру дұрыс па?
Dialogue: 0,0:02:41.08,0:02:44.89,OP,,0,0,0,,Мен шынымен шешім қабылдамай тұрып жол аяқталды
Dialogue: 0,0:02:44.89,0:02:48.94,OP,,0,0,0,,Бірақ бұл ерекше біреуді аямайтын дұрыс қоңырау екені сөзсіз
Dialogue: 0,0:02:48.94,0:02:52.86,OP,,0,0,0,,Кез келген азапты тәжірибелерден
Dialogue: 0,0:02:52.86,0:02:56.00,OP,,0,0,0,,Ендеше, кішкене батылдықпен, алға ұмтылыңыз
Dialogue: 0,0:02:56.00,0:02:59.58,OP,,0,0,0,,Егер бәрі қисық болса, қиғаш жолмен жүріңіз
Dialogue: 0,0:02:59.58,0:03:03.31,OP,,0,0,0,,Алға қарай жүрсең, нұрды табасың
Dialogue: 0,0:03:03.31,0:03:07.03,OP,,0,0,0,,Бір-біріне үйіріліп, бір дауыста сайрап тұрған кішкентай құстар сияқты
Dialogue: 0,0:03:07.03,0:03:10.63,OP,,0,0,0,,Жаңа маусымның басында міндетті түрде қоңырау шаламыз
Dialogue: 0,0:03:10.63,0:03:13.43,OP,,0,0,0,,Сонымен көктем бізді тағы да құшағына алады
Dialogue: 0,0:03:13.43,0:03:17.66,OP,,0,0,0,,Біз жаңа беттерге бояуды шашыратып жібереміз
Dialogue: 0,0:03:17.66,0:03:21.55,OP,,0,0,0,,Екеуміз тез дос болдық, жақсы тамақтандық
Dialogue: 0,0:03:21.55,0:03:24.19,OP,,0,0,0,,Біз тіпті біраз ұрысып қалған шығармыз
Dialogue: 0,0:03:24.19,0:03:27.83,OP,,0,0,0,,Бірақ біз сол кішкентай сәттерді жүрегімізде сақтаймыз
Dialogue: 0,0:03:27.83,0:03:31.56,OP,,0,0,0,,Бізді қателесуге болмайтын болашаққа итермелейтін себептер ретінде
Dialogue: 0,0:03:31.56,0:03:35.95,OP,,0,0,0,,Күн сәулесі түскен ағаштардың арасында қанша рет адасып қалсақ та
Dialogue: 0,0:03:35.95,0:03:40.55,OP,,0,0,0,,Бүгін мұнда бір жақты билетпен желдер алып кетті
Dialogue: 0,0:03:40.55,0:03:42.00,OP,,0,0,0,,Бұл тамаша күнге гүлдейді
Dialogue: 0,0:03:46.87,0:03:49.70,Default-ja,,0,0,0,,Айягура? (Қатысушы Е) Бұл бірінші қадам.
Dialogue: 5,0:03:46.88,0:03:48.19,Default,,0,0,0,,Қос бекініс қорғанысы, иә?
Dialogue: 5,0:03:48.19,0:03:49.76,Default,,0,0,0,,Бұл олардың бірге бірінші кездесуі.
Dialogue: 5,0:03:50.29,0:03:53.38,Default,,0,0,0,,Екеуі де бір-бірімен танысқысы келеді деп ойлаймын.
Dialogue: 0,0:03:50.29,0:03:53.33,Default-ja,,0,0,0,,Олай болса, бір-бірімізді жақсы білейік.
Dialogue: 5,0:03:53.38,0:03:56.86,Default,,0,0,0,,Бұл ойын барысында табиғи түрде болған шығар.
Dialogue: 0,0:03:53.58,0:03:56.79,Default-ja,,0,0,0,,Менің ойымша, олардың бір-бірін меңзейтіні табиғи нәрсе.
Dialogue: 0,0:04:01.63,0:04:06.18,Default-ja,,0,0,0,,Иә? Соя 28 күміс (Е қатысушы) 28 күміс?
Dialogue: 5,0:04:02.48,0:04:04.52,Default,,0,0,0,,Соуя күмісті 2 сағатқа жылжытты.
Dialogue: 5,0:04:04.52,0:04:06.13,Default,,0,0,0,,S-2h?
Dialogue: 0,0:04:06.51,0:04:09.22,Default-ja,,0,0,0,,Хохо... бұл сауалнама.
Dialogue: 5,0:04:07.53,0:04:09.27,Default,,0,0,0,,Бұл сұрақ.
Dialogue: 5,0:04:09.27,0:04:14.78,Default,,0,0,0,,Соуя: "Сәлеметсіз бе. Бұл кім?" деп сұрап жатыр.
Dialogue: 0,0:04:09.43,0:04:11.39,Default-ja,,0,0,0,,Соя-куннан
Dialogue: 0,0:04:11.52,0:04:14.73,Default-ja,,0,0,0,,«Сәлеметсіз бе, сіз кімсіз?»
Dialogue: 5,0:04:16.64,0:04:18.46,Default,,0,0,0,,S-2h.
Dialogue: 0,0:04:16.65,0:04:21.82,Default-ja,,0,0,0,,2Ягин Мен мұны бірінші рет жасап отырмын. Бұл зерттеу ме?
Dialogue: 5,0:04:18.46,0:04:20.57,Default,,0,0,0,,Мен мұндай қимылды бұрын көрген емеспін.
Dialogue: 5,0:04:20.57,0:04:21.71,Default,,0,0,0,,Ол мені сынап жатыр ма?
Dialogue: 0,0:04:22.65,0:04:27.12,Default-ja,,0,0,0,,...Ол дегеніміз 38 шыбын, 19 күміс.
Dialogue: 5,0:04:22.67,0:04:23.66,Default,,0,0,0,,Ал...
Dialogue: 5,0:04:24.06,0:04:25.46,Default,,0,0,0,,R-3h.
Dialogue: 5,0:04:25.46,0:04:27.17,Default,,0,0,0,,S-1i+.
Dialogue: 5,0:04:27.17,0:04:28.99,Default,,0,0,0,,S4h-5g.
Dialogue: 0,0:04:27.24,0:04:31.62,Default-ja,,0,0,0,,5 Жеті күміс оң жақ 8 Үш хош иісті зат...?
Dialogue: 5,0:04:28.99,0:04:31.67,Default,,0,0,0,,Содан кейін L-8c-мен аяқталады?
Dialogue: 5,0:04:32.27,0:04:35.68,Default,,0,0,0,,Бұл, әрине, қауіп, бірақ бұл өте қарапайым.
Dialogue: 0,0:04:32.29,0:04:35.62,Default-ja,,0,0,0,,Бұл қауіп екені сөзсіз, бірақ ол тым сызықты.
Dialogue: 0,0:04:36.58,0:04:39.04,Default-ja,,0,0,0,,Тікелей соққыдан сақтансаңыз, ешқандай проблема болмайды.
Dialogue: 5,0:04:36.59,0:04:38.87,Default,,0,0,0,,Мен тікелей шабуылдан аулақ болсам, бұл ешқандай проблема емес.
Dialogue: 0,0:04:39.54,0:04:43.88,Default-ja,,0,0,0,,Керісінше, біз қазір баруымыз керек - бұл адамдар көп орын ...
Dialogue: 5,0:04:39.56,0:04:42.80,Default,,0,0,0,,Шындығында, мен өз шығармаларымды жақын формацияға жылжытуым керек.
Dialogue: 5,0:04:42.80,0:04:43.93,Default,,0,0,0,,...
Dialogue: 0,0:04:44.84,0:04:46.01,Default-ja,,0,0,0,,Шаршы басы
Dialogue: 5,0:04:44.85,0:04:46.06,Default,,0,0,0,,Епископ басшысының пешкасын итеру.
Dialogue: 0,0:04:48.85,0:04:51.89,Default-ja,,0,0,0,,Жоқ, бірақ Кирияма жақсы күресіп жатыр.
Dialogue: 5,0:04:48.85,0:04:51.94,Default,,0,0,0,,Сонда да Кирияма жақсы күресіп жатыр.
Dialogue: 5,0:04:51.94,0:04:55.70,Default,,0,0,0,,Менің ойымша, ол Суядан кейін кіші сыныпта кәсіпқой атанған келесі адам болғаны таңқаларлық емес.
Dialogue: 0,0:04:52.14,0:04:55.64,Default-ja,,0,0,0,,Күткендей, ол Соядан кейін орта мектептің кәсіби маманы болды.
Dialogue: 0,0:04:55.98,0:04:58.06,Default-ja,,0,0,0,,Хмм... дәлірек айтсақ, осы кезеңде—
Dialogue: 5,0:04:56.62,0:05:00.75,Default,,0,0,0,,Шындығында, бұл кезеңде Кирияма басымдылыққа ие сияқты.
Dialogue: 0,0:04:58.19,0:05:00.69,Default-ja,,0,0,0,,Кирияма жақсырақ емес пе?
Dialogue: 5,0:05:00.75,0:05:08.37,Default,,0,0,0,,Бірақ егер жаңадан келген 5-дан ойынының ортасында ағымдағы Мастерден басым болса,
Dialogue: 0,0:05:00.82,0:05:04.65,Default-ja,,0,0,0,,Жоқ, жоқ, жаңадан келген 5-дан мен қазіргі шебер арасындағы матчтың ортасында...
Dialogue: 0,0:05:05.19,0:05:08.28,Default-ja,,0,0,0,,Егер біреу: «Мүмкін жаңадан келгендердің артықшылығы бар шығар?» деп сұраса.
Dialogue: 5,0:05:08.37,0:05:13.30,Default,,0,0,0,,, егер бұл телешоу болса, бұл жаңадан келген адамның жеңілетінінің белгісі болар еді.
Dialogue: 0,0:05:08.41,0:05:13.24,Default-ja,,0,0,0,,Бұл драма болса, жеңіліс туы ғана болар еді.
Dialogue: 0,0:05:15.71,0:05:20.38,Default-ja,,0,0,0,,Хохохо... Пікірталас тудырудың өзі үлкен іс.
Dialogue: 5,0:05:17.38,0:05:20.38,Default,,0,0,0,,Пікірталастың өтуі оның қаншалықты жақсы жұмыс істейтінін көрсетеді.
Dialogue: 0,0:05:22.38,0:05:23.88,Default-ja,,0,0,0,,Барлығы осы...
Dialogue: 5,0:05:22.39,0:05:26.87,Default,,0,0,0,,Мұның өзі оның бірдеңе жүріп жатқанын көрсетеді.
Dialogue: 0,0:05:24.30,0:05:27.01,Default-ja,,0,0,0,,Ол баланың ішінде.
Dialogue: 5,0:05:28.17,0:05:29.42,Default,,0,0,0,,Өте талғампаз болма.
Dialogue: 0,0:05:28.18,0:05:34.18,Default-ja,,0,0,0,,Дұрыс, 55 қадам Сол күміс 75 қадам қалды
Dialogue: 5,0:05:29.42,0:05:31.11,Default,,0,0,0,,P*5e.
Dialogue: 5,0:05:31.11,0:05:32.73,Default,,0,0,0,,S6fx5e.
Dialogue: 5,0:05:32.73,0:05:34.41,Default,,0,0,0,,Px7e.
Dialogue: 5,0:05:34.41,0:05:36.44,Default,,0,0,0,,Сосын мен епископты мақсат етемін...
Dialogue: 0,0:05:34.56,0:05:36.39,Default-ja,,0,0,0,,Мұнда, жоспарланғандай, шаршы басы...
Dialogue: 5,0:05:40.27,0:05:41.79,Default,,0,0,0,,P*7d.
Dialogue: 0,0:05:40.31,0:05:41.90,Default-ja,,0,0,0,,Жеті төрт қадам.
Dialogue: 5,0:05:45.11,0:05:51.17,Default,,0,0,0,,Неліктен мен кесінді босатқанда саусақ ұшында әлсіз ату ауырсынуын сезіндім?
Dialogue: 0,0:05:45.11,0:05:46.32,Default-ja,,0,0,0,,Неліктен?
Dialogue: 0,0:05:46.61,0:05:51.12,Default-ja,,0,0,0,,Кесекті босатқанда, саусақ ұшында аздап ауырғанын сезіндім.
Dialogue: 5,0:05:53.00,0:05:54.39,Default,,0,0,0,,P*7d.
Dialogue: 0,0:05:53.03,0:05:54.49,Default-ja,,0,0,0,,Жеті төрт қадам...
Dialogue: 5,0:05:55.57,0:05:56.80,Default,,0,0,0,,Ақыры заман мені қуып жетті ме?
Dialogue: 0,0:05:55.58,0:05:58.00,Default-ja,,0,0,0,,Жоқ, мен не істеп жатырмын?
Dialogue: 5,0:05:56.80,0:05:58.05,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 5,0:05:58.68,0:06:00.21,Default,,0,0,0,,Мен неге түсінбедім?
Dialogue: 0,0:05:58.79,0:06:01.63,Default-ja,,0,0,0,,Неге байқамайсың? 86 қадам болады!
Dialogue: 5,0:06:00.21,0:06:01.68,Default,,0,0,0,,P-8f ойыны бар!
Dialogue: 5,0:06:02.80,0:06:05.06,Default,,0,0,0,,Егер ол мені P-8f ұрса,
Dialogue: 0,0:06:03.04,0:06:07.01,Default-ja,,0,0,0,,Бұл жерде 86 қадам жасағаныңыз үшін сынға ұшырасаңыз, бұдан артық ештеңе қалмайды!
Dialogue: 5,0:06:05.85,0:06:07.06,Default,,0,0,0,,бәрі бітті!
Dialogue: 5,0:06:16.60,0:06:18.29,Default,,0,0,0,,P-8f.
Dialogue: 0,0:06:16.64,0:06:18.39,Default-ja,,0,0,0,,86 қадам...
Dialogue: 0,0:06:38.04,0:06:40.54,Default-ja,,0,0,0,,Хмм... иә...
Dialogue: 0,0:06:47.09,0:06:48.26,Default-ja,,0,0,0,,Дәл осындай қадам…
Dialogue: 5,0:06:47.11,0:06:48.31,Default,,0,0,0,,Px8f.
Dialogue: 0,0:06:51.76,0:06:53.43,Default-ja,,0,0,0,,9 бесбұрыш
Dialogue: 5,0:06:51.79,0:06:53.30,Default,,0,0,0,,B-9e.
Dialogue: 5,0:06:54.47,0:06:56.32,Default,,0,0,0,,G6g-7g.
Dialogue: 0,0:06:54.47,0:06:56.26,Default-ja,,0,0,0,,7 жеті алтын сыйға тарту
Dialogue: 5,0:06:57.57,0:06:59.44,Default,,0,0,0,,Соуя 8е-де пешкасын тастады.
Dialogue: 0,0:06:57.81,0:07:01.77,Default-ja,,0,0,0,,Соя 85 қадам Кирияма Бұл қатал ма?
Dialogue: 5,0:06:59.44,0:07:01.82,Default,,0,0,0,,Кирияма қиын жерде.
Dialogue: 5,0:07:01.82,0:07:02.99,Default,,0,0,0,,Сіз не істейсіз?
Dialogue: 0,0:07:01.94,0:07:04.40,Default-ja,,0,0,0,,Не істеу керек? (Қатысушы О) Біз де сол қадамды жасауымыз керек пе?
Dialogue: 5,0:07:02.99,0:07:04.45,Default,,0,0,0,,Px8e арқылы өту керек пе?
Dialogue: 5,0:07:22.15,0:07:24.22,Default,,0,0,0,,P-9f! Px8e емес!
Dialogue: 0,0:07:22.17,0:07:24.17,Default-ja,,0,0,0,,96 қадам! Бір бетте емес
Dialogue: 5,0:07:24.69,0:07:25.62,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:07:24.71,0:07:27.34,Default-ja,,0,0,0,,Түсінемін, егер біз 85 қадамды бірдей қадам жасасақ...
Dialogue: 5,0:07:25.62,0:07:30.92,Default,,0,0,0,,Егер ол пешкамен 8e-де пешканы алса, оған рыцарь 9c-те жауап беріп, патшасын ашық қалдырады.
Dialogue: 0,0:07:27.46,0:07:30.84,Default-ja,,0,0,0,,9 Мені Миката серпіп тастады, ал доптың басы мені ұстай алмады.
Dialogue: 5,0:07:30.92,0:07:32.30,Default,,0,0,0,,Бұл мағынасы бар.
Dialogue: 0,0:07:30.97,0:07:33.93,Default-ja,,0,0,0,,Мен түсінемін, бірақ бұл туралы.
Dialogue: 5,0:07:32.30,0:07:33.98,Default,,0,0,0,,Бірақ бұл солай болуы мүмкін.
Dialogue: 5,0:07:33.98,0:07:36.27,Default,,0,0,0,,Бұрынғы P*7d ауырды.
Dialogue: 0,0:07:34.09,0:07:36.22,Default-ja,,0,0,0,,Бұрынғы жеті және төрт қадам ауырды.
Dialogue: 5,0:07:36.62,0:07:39.99,Default,,0,0,0,,Иә, бірақ ол кем дегенде Соуяның P*8e-ден жалтарып кетті.
Dialogue: 0,0:07:36.64,0:07:39.93,Default-ja,,0,0,0,,Жоқ, бірақ мен Соуяның 8-5 қадамынан жалтардым.
Dialogue: 5,0:07:43.44,0:07:46.74,Default,,0,0,0,,Жақсы, жақсы, +L-6h.
Dialogue: 0,0:07:43.44,0:07:46.69,Default-ja,,0,0,0,,О, құдай-ау, 6хачинари деген не?
Dialogue: 5,0:07:47.09,0:07:50.75,Default,,0,0,0,,Қазір Соуя қызықты қимылдар жасап жатыр.
Dialogue: 0,0:07:47.11,0:07:50.69,Default-ja,,0,0,0,,Соя-кун да оның мазасыз қолын көрсетеді.
Dialogue: 5,0:07:51.46,0:07:54.00,Default,,0,0,0,,Сонымен Кирияма, 5-дан,
Dialogue: 0,0:07:51.49,0:07:53.95,Default-ja,,0,0,0,,Енді Кирияма 5-ші Дан
Dialogue: 5,0:07:54.74,0:07:58.95,Default,,0,0,0,,Сіз бұл көтерілген найзаны арқанмен бірге ала аласыз ба, жоқ па?
Dialogue: 0,0:07:54.74,0:07:58.99,Default-ja,,0,0,0,,Мына Нариканы қармақпен апару керек пе, жоқ па?
Dialogue: 5,0:07:59.77,0:08:01.51,Default,,0,0,0,,Дұрыс жауап...
Dialogue: 0,0:07:59.79,0:08:01.45,Default-ja,,0,0,0,,Дұрыс жауап...
Dialogue: 0,0:08:14.84,0:08:19.14,Default-ja,,0,0,0,,Әй, қармаққа тиме, 73 қадам жаса
Dialogue: 5,0:08:15.29,0:08:19.19,Default,,0,0,0,,Ол жемді қабылдамады, керісінше P-7c+-мен жүрді.
Dialogue: 5,0:08:19.50,0:08:22.69,Default,,0,0,0,,Ол ең жақсы қимылдарды нақты түрде жасайды.
Dialogue: 0,0:08:19.51,0:08:22.64,Default-ja,,0,0,0,,Ең жақсы қимылды байсалды түрде көрсетесіз.
Dialogue: 5,0:08:23.10,0:08:24.56,Default,,0,0,0,,Шиш.
Dialogue: 0,0:08:23.10,0:08:27.15,Default-ja,,0,0,0,,Міне, сондықтан да бұл жігіт қызық.
Dialogue: 5,0:08:24.56,0:08:27.20,Default,,0,0,0,,Оны қызықтыратын да осы.
Dialogue: 5,0:08:35.96,0:08:38.03,Default,,0,0,0,,Осыдан кейін мен сіріңкеге сіңіп кеттім.
Dialogue: 0,0:08:35.99,0:08:38.62,Default-ja,,0,0,0,,Содан бері мен байланып қалдым (соғылған бөлшектердің дыбысы)
Dialogue: 5,0:08:39.03,0:08:43.56,Default,,0,0,0,,Тақтадағы әрбір шығарманың дыбысы менің басымдағы жарқылмен бірге жүрді.
Dialogue: 0,0:08:39.03,0:08:43.66,Default-ja,,0,0,0,,Комане менің басымда фонарь сияқты жарқ етті.
Dialogue: 5,0:08:44.55,0:08:49.60,Default,,0,0,0,,Мен басымдағы бір нәрсе барлық қозғалыстарды байланыстырып тұрғанын түсіндім.
Dialogue: 0,0:08:44.58,0:08:49.34,Default-ja,,0,0,0,,Мен басымда бір нәрсенің қолдарымды жалғап жатқанын көбірек сездім.
Dialogue: 0,0:08:50.63,0:08:51.38,Default-ja,,0,0,0,,Дәл…
Dialogue: 5,0:08:50.67,0:08:51.43,Default,,0,0,0,,Бұл...
Dialogue: 5,0:08:54.53,0:08:56.94,Default,,0,0,0,,күмістей жарқыраған су,
Dialogue: 0,0:08:54.55,0:08:56.88,Default-ja,,0,0,0,,Жарқыраған су күмістей жарқырайды.
Dialogue: 5,0:08:57.64,0:09:00.70,Default,,0,0,0,,әр бұрышқа ағып жатыр.
Dialogue: 0,0:08:57.64,0:09:00.81,Default-ja,,0,0,0,,Әр бұрышқа ағып жатқандай болды.
Dialogue: 0,0:09:02.94,0:09:04.94,titles,,0,0,0,,Ақ дауыл (2 бөлім)
Dialogue: 0,0:09:04.94,0:09:08.94,titles,,0,0,0,,Ақ дауыл (3 бөлім)
Dialogue: 0,0:09:10.69,0:09:13.78,Default-ja,,0,0,0,,Сіз көрсеткен 7 қадамнан қолыңызды босатқанда—
Dialogue: 5,0:09:10.70,0:09:13.83,Default,,0,0,0,,Мен 7д-де пешкамды жібергенімде,
Dialogue: 5,0:09:13.83,0:09:16.83,Default,,0,0,0,,саусақтарымның бетін жұлып алғандай болды.
Dialogue: 0,0:09:13.94,0:09:16.78,Default-ja,,0,0,0,,Саусағымның бетін жұлып алғандай болды.
Dialogue: 0,0:09:18.45,0:09:23.04,Default-ja,,0,0,0,,Мен жіберген сәтте мен жеңілгенімді түсіндім.
Dialogue: 5,0:09:18.47,0:09:20.09,Default,,0,0,0,,Қолымды алған сәтте,
Dialogue: 5,0:09:20.99,0:09:22.94,Default,,0,0,0,,Мен жылжыту маған сәйкес келетінін түсіндім.
Dialogue: 0,0:09:24.54,0:09:27.58,Default-ja,,0,0,0,,Мен ештеңе қалмағанын түсіндім.
Dialogue: 5,0:09:24.56,0:09:27.63,Default,,0,0,0,,Мен мұның біткенін білдім.
Dialogue: 5,0:09:32.12,0:09:34.47,Default,,0,0,0,,Бірақ сонымен бірге бұл менің ойымнан өтті.
Dialogue: 0,0:09:32.13,0:09:34.42,Default-ja,,0,0,0,,...Осы кезде мен кенет ойға қалдым
Dialogue: 5,0:09:42.63,0:09:48.53,Default,,0,0,0,,Егер мен осы сәттен бастап ең жақсы қимылдарды ғана ойнасам,
Dialogue: 0,0:09:42.64,0:09:48.73,Default-ja,,0,0,0,,Егер сіз осы жерден барлық қимылдарды тек ең жақсы қимылыңызбен жасай алсаңыз...
Dialogue: 5,0:09:50.59,0:09:53.89,Default,,0,0,0,,Мен матчта қанша жүре аламын?
Dialogue: 0,0:09:50.61,0:09:53.98,Default-ja,,0,0,0,,Қызық, бұл шоги ойыны қаншалықты алысқа барады?
Dialogue: 5,0:09:57.31,0:09:58.95,Default,,0,0,0,,Жел күшті.
Dialogue: 0,0:09:57.32,0:10:02.45,Default-ja,,0,0,0,,Жел күшті. Бұл тайфун Тынық мұхитына соқпай ма?
Dialogue: 5,0:09:59.57,0:10:02.50,Default,,0,0,0,,Мен тайфун Тынық мұхиты арқылы өтеді деп ойладым.
Dialogue: 5,0:10:05.69,0:10:07.81,Default,,0,0,0,,Пойыздар жүре береді деп үміттенемін.
Dialogue: 0,0:10:05.70,0:10:07.91,Default-ja,,0,0,0,,Бұл тоқтамайды деп үміттенемін.
Dialogue: 5,0:10:08.43,0:10:13.26,Default,,0,0,0,,Мен түстен кейінгі сабақтарыма барғым келеді, сондықтан ол тек жарты күндік сабақ емес деп есептеледі.
Dialogue: 0,0:10:08.46,0:10:13.21,Default-ja,,0,0,0,,Мен түстен кейін сабаққа барғым келеді және жарты күндік демалыс ретінде қабылданғым келеді.
Dialogue: 5,0:10:22.16,0:10:23.52,Default,,0,0,0,,Соя бар.
Dialogue: 0,0:10:22.18,0:10:23.47,Default-ja,,0,0,0,,Бұл Соя-сан.
Dialogue: 0,0:10:24.51,0:10:27.48,Default-ja,,0,0,0,,Көрдім, бұл баяғы Шинкансен?
Dialogue: 5,0:10:24.53,0:10:25.58,Default,,0,0,0,,Б... бір сызық
Dialogue: 5,0:10:25.58,0:10:27.35,Default,,0,0,0,,Біз бір оқпен жүретін пойыздамыз, иә?
Dialogue: 5,0:10:28.13,0:10:30.82,Default,,0,0,0,,Ол да ерте пойызбен қайтады.
Dialogue: 0,0:10:28.14,0:10:30.77,Default-ja,,0,0,0,,Мен өте ерте пойызбен қайтамын деп ойлаймын.
Dialogue: 5,0:10:31.69,0:10:34.78,Default,,0,0,0,,Мен оны ілулі тұрмайтын адам деп түсіндім, бірақ бұл таңқаларлық.
Dialogue: 0,0:10:31.73,0:10:34.90,Default-ja,,0,0,0,,Мен сені ұзақ қалатын адам емес деп ойладым.
Dialogue: 5,0:10:36.01,0:10:40.58,Default,,0,0,0,,Мен оның басқа адамдармен араласып тұрғанын ешқашан көрген емеспін.
Dialogue: 0,0:10:36.03,0:10:40.53,Default-ja,,0,0,0,,Мен сенің басқа адамдармен көп араласқаныңды көрмедім.
Dialogue: 5,0:10:41.91,0:10:44.43,Default,,0,0,0,,Оның күліп, адамдармен сөйлескенін де көрмедім.
Dialogue: 0,0:10:41.91,0:10:44.58,Default-ja,,0,0,0,,Күлімсіреп, біреумен сөйлесу
Dialogue: 0,0:10:45.16,0:10:47.95,Default-ja,,0,0,0,,Мен оны бала кезімнен көріп келемін, бірақ...
Dialogue: 5,0:10:45.29,0:10:48.01,Default,,0,0,0,,Мен оны бала кезімнен бақылап келемін,
Dialogue: 5,0:10:48.74,0:10:50.78,Default,,0,0,0,,бірақ менің естеліктерімде ол...
Dialogue: 0,0:10:48.75,0:10:50.96,Default-ja,,0,0,0,,Бұл адам менің жадымда...
Dialogue: 5,0:10:52.00,0:10:53.06,Default,,0,0,0,,Өте талғампаз болма.
Dialogue: 0,0:10:52.00,0:10:55.25,Default-ja,,0,0,0,,Иә, мен әрқашан жалғызбын.
Dialogue: 5,0:10:53.70,0:10:55.11,Default,,0,0,0,,Ол әрқашан жалғыз.
Dialogue: 5,0:10:56.87,0:10:57.95,Default,,0,0,0,,Оқу, оқу
Dialogue: 0,0:10:56.88,0:10:59.47,Default-ja,,0,0,0,,Иә, бұл біртүрлі.
Dialogue: 5,0:10:58.57,0:10:59.52,Default,,0,0,0,,Біртүрлі екен.
Dialogue: 5,0:11:01.71,0:11:04.61,Default,,0,0,0,,Мен кеше осы жігітке қарсы ойнадым.
Dialogue: 0,0:11:01.72,0:11:04.55,Default-ja,,0,0,0,,Мен кеше осы кісімен ұрысып қалдым.
Dialogue: 5,0:11:06.04,0:11:08.99,Default,,0,0,0,,Мен оны ойнадым және жеңілдім.
Dialogue: 0,0:11:06.06,0:11:08.93,Default-ja,,0,0,0,,шайқасты және жеңілді
Dialogue: 5,0:11:10.36,0:11:11.49,Default,,0,0,0,,Бұл не болып жатыр өзі?!
Dialogue: 0,0:11:10.39,0:11:11.44,Default-ja,,0,0,0,,Не?
Dialogue: 0,0:11:12.65,0:11:14.81,Default-ja,,0,0,0,,Бұл менің бірінші рет сезінуім.
Dialogue: 5,0:11:12.65,0:11:14.87,Default,,0,0,0,,Мен бұрын-соңды мұндай сезімде болған емеспін.
Dialogue: 5,0:11:15.47,0:11:18.85,Default,,0,0,0,,Жеңілсем де, Шаршаған жоқпын.
Dialogue: 0,0:11:15.48,0:11:18.57,Default-ja,,0,0,0,,Мен жеңілсем де, денем мүлде шаршаған жоқ.
Dialogue: 5,0:11:18.85,0:11:21.12,Default,,0,0,0,,Мен өзімді мүлде депрессия сезінбеймін.
Dialogue: 0,0:11:19.03,0:11:21.24,Default-ja,,0,0,0,,Мен өзімді мүлде ауыр сезінбеймін.
Dialogue: 5,0:11:22.69,0:11:25.00,Default,,0,0,0,,Мен жеңуге мүмкіндігім жоқ екенін білдім,
Dialogue: 0,0:11:22.70,0:11:24.95,Default-ja,,0,0,0,,Мен жеңу мүмкін емес деп ойладым.
Dialogue: 5,0:11:25.00,0:11:28.76,Default,,0,0,0,,бірақ мен жай ғана бас тартамын деген ниетім жоқ еді.
Dialogue: 0,0:11:25.12,0:11:28.70,Default-ja,,0,0,0,,Мен жай ғана жеңіліп, жеңемін деген ниетім жоқ.
Dialogue: 0,0:11:30.75,0:11:35.21,Default-ja,,0,0,0,,Дегенмен, мен қатты түсінгенім тәжірибе де, зерттеу де...
Dialogue: 5,0:11:30.76,0:11:35.26,Default,,0,0,0,,Бірақ мен тәжірибеде де, оқуда да терең білдім.
Dialogue: 0,0:11:36.00,0:11:38.42,Default-ja,,0,0,0,,Тек «жыл айырмашылығы» үшін—
Dialogue: 5,0:11:36.01,0:11:41.27,Default,,0,0,0,,ол менен бірнеше жыл озып кетті, мен қуып жетпедім.
Dialogue: 0,0:11:38.55,0:11:41.22,Default-ja,,0,0,0,,Қуып жетуге шамасы келмеді
Dialogue: 5,0:11:44.25,0:11:49.28,Default,,0,0,0,,Мен бұл олқылықты қалай жабуға болатынын әлі білмедім.
Dialogue: 0,0:11:44.26,0:11:47.68,Default-ja,,0,0,0,,Бұл олқылықты қалай жабуға болады?
Dialogue: 0,0:11:47.81,0:11:49.22,Default-ja,,0,0,0,,Біз нені әлі түсінбейміз
Dialogue: 0,0:11:51.02,0:11:54.94,Default-ja,,0,0,0,,Жақсы айта алмаймын, жеңілсем де, сергітеді.
Dialogue: 5,0:11:51.05,0:11:53.01,Default,,0,0,0,,Мен оны жақсы жеткізе алмаймын,
Dialogue: 5,0:11:53.01,0:11:57.28,Default,,0,0,0,,бірақ мен әрқашан жеңіліске ұшырағаннан кейін, сергіп қалдым немесе матчтан ләззат аламын деп ойладым
Dialogue: 0,0:11:55.06,0:11:57.23,Default-ja,,0,0,0,,Қуанышты сезіну -
Dialogue: 5,0:11:58.35,0:12:02.29,Default,,0,0,0,,шын мәнінде сіздің қарсыласыңызға үлкен қорлау болып табылады.
Dialogue: 0,0:11:58.40,0:12:02.24,Default-ja,,0,0,0,,Негізі бұл басқа адамға өте дөрекі болып көрінеді.
Dialogue: 5,0:12:03.30,0:12:09.55,Default,,0,0,0,,Қарсыласыңды тұғырға отырғызып, құрмет көрсетіп, сосын жеке өзін сергек сезіну сияқты.
Dialogue: 0,0:12:03.32,0:12:07.07,Default-ja,,0,0,0,,Жай ғана басқа адамды құрбандық үстеліне орналастырыңыз және оларға рұқсатсыз табыныңыз.
Dialogue: 0,0:12:07.20,0:12:09.49,Default-ja,,0,0,0,,Бір жағынан сергітетін сияқты.
Dialogue: 5,0:12:10.94,0:12:15.18,Default,,0,0,0,,Қарсыласыңды тұлға ретінде ойламау.
Dialogue: 0,0:12:11.00,0:12:15.12,Default-ja,,0,0,0,,Мен адамдарды адам деп санамайтын сияқтымын...
Dialogue: 0,0:12:18.50,0:12:22.13,Default-ja,,0,0,0,,Мен солай ойладым... Бірақ...
Dialogue: 5,0:12:18.51,0:12:22.18,Default,,0,0,0,,Мен әрқашан осылай ойладым,
Dialogue: 0,0:12:22.72,0:12:26.01,Default-ja,,0,0,0,,Бұл не болды? Кешегі ойын болды
Dialogue: 5,0:12:22.73,0:12:26.06,Default,,0,0,0,,бірақ бұл кешегі матчты қалай түсіндіреді?
Dialogue: 5,0:12:26.83,0:12:31.74,Default,,0,0,0,,Мен басқа профессионалдармен қарсыласқанда, арамызда шеберлік алшақтығы қаншалықты үлкен болса да,
Dialogue: 0,0:12:26.84,0:12:31.68,Default-ja,,0,0,0,,Басқа ойыншылармен ойнаған кезде, күш айырмашылығы қаншалықты үлкен болса да...
Dialogue: 5,0:12:31.74,0:12:34.70,Default,,0,0,0,,Мен әрқашан олардың ойлау желісін белгілі бір дәрежеде бақылай аламын.
Dialogue: 0,0:12:31.81,0:12:34.64,Default-ja,,0,0,0,,Сіз басқа адамның ойын белгілі бір дәрежеде бақылай алатын болсаңыз да...
Dialogue: 5,0:12:37.56,0:12:39.83,Default,,0,0,0,,Ол жалғыз...
Dialogue: 0,0:12:37.56,0:12:39.77,Default-ja,,0,0,0,,Тек ол...
Dialogue: 5,0:12:42.17,0:12:43.61,Default,,0,0,0,,мұнда мен бос жолды салдым.
Dialogue: 0,0:12:42.19,0:12:43.78,Default-ja,,0,0,0,,Ол таза ақ түсті
Dialogue: 0,0:12:45.20,0:12:50.03,Default-ja,,0,0,0,,Көрсеткен кезде екеуміз де ақ түсті едік.
Dialogue: 5,0:12:45.22,0:12:50.09,Default,,0,0,0,,Біз ойнап жүргенде, таза ақ кеңістікте екеуміз жалғыз қалғандай болдық.
Dialogue: 5,0:12:52.31,0:12:54.79,Default,,0,0,0,,Бұл өте ыңғайлы болды.
Dialogue: 0,0:12:52.33,0:12:54.91,Default-ja,,0,0,0,,Бұл өте жақсы сезінді.
Dialogue: 5,0:12:57.62,0:12:59.85,Default,,0,0,0,,Мен бұл кеше не болды деп ойлаймын.
Dialogue: 0,0:12:57.63,0:12:59.79,Default-ja,,0,0,0,,Бұл не болды? Кеше...
Dialogue: 5,0:13:00.56,0:13:04.00,Default,,0,0,0,,Мастер Соуя мен 5-дан Кириямамен матчтан кейінгі шолу.
Dialogue: 0,0:13:00.59,0:13:03.76,Default-ja,,0,0,0,,Мэйджин Соя мен 5-ші Дэн Кирияма арасындағы әсерлі шайқас
Dialogue: 5,0:13:04.00,0:13:06.18,Default,,0,0,0,,Мен мұндайды ешқашан көрген емеспін.
Dialogue: 0,0:13:04.09,0:13:06.13,Default-ja,,0,0,0,,Мен мұндайды бұрын көрген емеспін.
Dialogue: 5,0:13:06.18,0:13:09.86,Default,,0,0,0,,Олар бір ауыз сөз алмаспай жүре берді.
Dialogue: 0,0:13:06.26,0:13:07.97,Default-ja,,0,0,0,,Екеуміз де бір ауыз сөз айтқан жоқпыз.
Dialogue: 0,0:13:08.09,0:13:09.80,Default-ja,,0,0,0,,Мен әрі қарай жалғастырамын деп ойлаймын.
Dialogue: 0,0:13:10.30,0:13:12.81,Default-ja,,0,0,0,,Ойын аяқталып, әсер алу уақыты келгенде...
Dialogue: 5,0:13:10.31,0:13:12.86,Default,,0,0,0,,Матч аяқталып, матчтан кейінгі шолу басталғаннан кейін,
Dialogue: 0,0:13:13.14,0:13:14.56,Default-ja,,0,0,0,,Кенет Кирияма...
Dialogue: 5,0:13:13.15,0:13:18.36,Default,,0,0,0,,Кирияма бірдеңе үндеместен, бекініп барлық бөлшектерді тізіп қойды.
Dialogue: 0,0:13:14.81,0:13:16.19,Default-ja,,0,0,0,,Үнсіз, үлкен күшпен—
Dialogue: 0,0:13:16.31,0:13:18.31,Default-ja,,0,0,0,,Сіз бөлшектерді реттей бастадыңыз.
Dialogue: 5,0:13:20.79,0:13:24.12,Default,,0,0,0,,Олар 63-ші жүріске жеткенде,
Dialogue: 0,0:13:20.81,0:13:24.07,Default-ja,,0,0,0,,және 63-ке жылжу үшін оралыңыз—
Dialogue: 5,0:13:24.12,0:13:27.62,Default,,0,0,0,,ол матч рекордында жоқ S-6f ойнады.
Dialogue: 0,0:13:24.32,0:13:27.57,Default-ja,,0,0,0,,Кітапта жоқ 66 күмісті көрсетті.
Dialogue: 5,0:13:32.93,0:13:37.63,Default,,0,0,0,,Сосын Мастер Соуя жауап ретінде сәл басын изеді, солай ма?
Dialogue: 0,0:13:32.95,0:13:34.33,Default-ja,,0,0,0,,Мастер Соя
Dialogue: 0,0:13:34.45,0:13:37.58,Default-ja,,0,0,0,,Ол кезде кішкентай болса да бас изеп едіңіз.
Dialogue: 5,0:13:37.99,0:13:41.76,Default,,0,0,0,,Ол Кирияманың P*7d матчта жеңілгенін растады,
Dialogue: 0,0:13:38.00,0:13:41.71,Default-ja,,0,0,0,,Өйткені, Кирияма сол жеті және төрт қадаммен жеңілді.
Dialogue: 5,0:13:41.76,0:13:46.55,Default,,0,0,0,,және бұл S-6f, матчтан кейінгі шолудан, перспективалы қадам болды.
Dialogue: 0,0:13:41.84,0:13:46.38,Default-ja,,0,0,0,,Менің ойымша, бұл әсерлі матчта көрсеткен 66 күмістің болашағы зор екенін білдіреді.
Dialogue: 5,0:13:46.55,0:13:49.40,Default,,0,0,0,,Ең таңғаларлық оқиға - кейін болған оқиға.
Dialogue: 0,0:13:46.67,0:13:49.34,Default-ja,,0,0,0,,...Бірақ таң қалдырғаны – әрі қарай не болатыны.
Dialogue: 5,0:13:50.08,0:13:53.21,Default,,0,0,0,,Матчтан кейінгі шолу аяқталған кезде,
Dialogue: 0,0:13:50.09,0:13:53.31,Default-ja,,0,0,0,,Кирияма әсерлері бойынша матчты аяқтаған кезде—
Dialogue: 5,0:13:53.78,0:13:57.90,Default,,0,0,0,,Кирияма бір сәт өз саусақтарына қарады.
Dialogue: 0,0:13:53.93,0:13:57.85,Default-ja,,0,0,0,,Бір сәт саусағыма жалт қарадым.
Dialogue: 5,0:13:58.50,0:14:00.45,Default,,0,0,0,,Ол жай ғана оларға қарады.
Dialogue: 0,0:13:58.52,0:14:00.56,Default-ja,,0,0,0,,Бірақ бұл бәрі...
Dialogue: 5,0:14:06.41,0:14:08.50,Default,,0,0,0,,Міне осылай.
Dialogue: 0,0:14:06.61,0:14:08.57,Default-ja,,0,0,0,,Міне, солай.
Dialogue: 5,0:14:10.10,0:14:12.78,Default,,0,0,0,,Ол мұнымен не айтқысы келді?
Dialogue: 0,0:14:10.11,0:14:12.62,Default-ja,,0,0,0,,Бұл не болды?
Dialogue: 5,0:14:12.78,0:14:17.80,Default,,0,0,0,,Мен оңдымын «Мынау солай» деді ол.
Dialogue: 0,0:14:12.91,0:14:17.75,Default-ja,,0,0,0,,Шебердің: «Міне, солай» дегеніне сенімдімін.
Dialogue: 5,0:14:18.31,0:14:21.80,Default,,0,0,0,,Кирияма оған бір ауыз сөз де айтқан жоқ.
Dialogue: 0,0:14:18.33,0:14:21.58,Default-ja,,0,0,0,,Кирияма бір ауыз сөз айтпаса да.
Dialogue: 5,0:14:23.53,0:14:25.81,Default,,0,0,0,,Мен осыдан бастадым.
Dialogue: 0,0:14:23.54,0:14:25.75,Default-ja,,0,0,0,,Сол кезде мен таң қалдым.
Dialogue: 5,0:14:26.77,0:14:30.81,Default,,0,0,0,,Мен ойлағанымды бұлдырған шығармын деп ойладым.
Dialogue: 0,0:14:26.80,0:14:30.55,Default-ja,,0,0,0,,Мен ойлаған нәрсе аузыма түсті деп ойладым.
Dialogue: 5,0:14:31.76,0:14:34.32,Default,,0,0,0,,Бірақ бұл оған сөзсіз жетті.
Dialogue: 0,0:14:31.76,0:14:34.26,Default-ja,,0,0,0,,Сөзбен жеткізбесем де түсіндім
Dialogue: 0,0:14:35.43,0:14:38.02,Default-ja,,0,0,0,,Ондай дүние бар ма деп қалдым.
Dialogue: 5,0:14:35.44,0:14:37.96,Default,,0,0,0,,«Осындай дүние бар ма?» деп ойладым.
Dialogue: 5,0:14:39.39,0:14:43.85,Default,,0,0,0,,Бұл тыныш, жарық жер еді
Dialogue: 0,0:14:39.39,0:14:43.98,Default-ja,,0,0,0,,Тыныш, жарық, ештеңе жоқ—
Dialogue: 0,0:14:45.11,0:14:47.32,Default-ja,,0,0,0,,Мен қорықпайтын жерде болдым.
Dialogue: 5,0:14:45.13,0:14:47.19,Default,,0,0,0,,онда қорқатын ештеңе болмады.
Dialogue: 5,0:14:51.96,0:14:57.18,Default,,0,0,0,,Оқ пойыз Сендай вокзалына түскі уақытта жетіп, жүрісін тоқтатты.
Dialogue: 0,0:14:51.99,0:14:55.24,Default-ja,,0,0,0,,Сағат 12-ден кейін Сендай вокзалына кіргенімде...
Dialogue: 0,0:14:55.37,0:14:57.08,Default-ja,,0,0,0,,Шинкансен жұмысын тоқтатты
Dialogue: 5,0:14:57.18,0:15:00.59,Default,,0,0,0,,Абукума өзенінің су деңгейінің көтерілуіне байланысты қызмет көрсету тоқтатылады.
Dialogue: 0,0:14:57.20,0:15:00.54,Default-ja,,0,0,0,,Су деңгейінің көтерілуіне байланысты Абукума өзенінің қызметі тоқтатылды
Dialogue: 0,0:15:01.17,0:15:04.67,Default-ja,,0,0,0,,Жұмысты қайта бастау перспективасы жоқ.
Dialogue: 5,0:15:01.17,0:15:04.93,Default,,0,0,0,,Қызмет қашан қайта басталатыны әлі анықталған жоқ.
Dialogue: 0,0:15:04.79,0:15:06.71,Default-ja,,0,0,0,,Жүруді қайталаңыз...
Dialogue: 5,0:15:04.93,0:15:06.76,Default,,0,0,0,,Қайталап айтамын, жолаушылар...
Dialogue: 0,0:15:05.51,0:15:05.76,signs,,0,0,0,,Ашу
Dialogue: 1,0:15:05.51,0:15:05.76,signs,,0,0,0,,Ашу
Dialogue: 0,0:15:05.51,0:15:05.76,signs,,0,0,0,,Масштабтау
Dialogue: 1,0:15:05.51,0:15:05.76,signs,,0,0,0,,Масштабтау
Dialogue: 5,0:15:06.76,0:15:08.25,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:15:06.76,0:15:09.01,signs,,0,0,0,,Барлық кеңсе қызметкерлері хабарды естіген сәтте олар үйреніп қалғандай орындарынан тұрады.
Dialogue: 1,0:15:06.76,0:15:09.01,signs,,0,0,0,,Барлық кеңсе қызметкерлері хабарды естіген кезде орнынан тұрады.
Dialogue: 0,0:15:06.96,0:15:08.96,Default-ja,,0,0,0,,Не? иә? Асығыңыз!
Dialogue: 5,0:15:08.25,0:15:09.02,Default,,0,0,0,,Бұл тез болды!
Dialogue: 0,0:15:08.38,0:15:09.01,signs,,0,0,0,,Бұл тез болды!
Dialogue: 1,0:15:08.38,0:15:09.01,signs,,0,0,0,,Бұл тез болды!
Dialogue: 5,0:15:09.30,0:15:13.36,Default,,0,0,0,,Екінші тайфунға байланысты қызмет көрсету тоқтатылды.
Dialogue: 0,0:15:09.30,0:15:13.09,Default-ja,,0,0,0,,№2 тайфунға байланысты қызмет көрсету тоқтатылды.
Dialogue: 5,0:15:13.36,0:15:18.24,Default,,0,0,0,,Қайталап айтамын, екінші тайфунға байланысты қызмет көрсету тоқтатылды.
Dialogue: 0,0:15:13.47,0:15:14.47,Default-ja,,0,0,0,,Қайталаңыз
Dialogue: 0,0:15:14.64,0:15:18.14,Default-ja,,0,0,0,,No2 тайфунына байланысты қызмет көрсету тоқтатылды.
Dialogue: 5,0:15:18.24,0:15:21.24,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:15:18.27,0:15:21.19,Default-ja,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 5,0:15:21.24,0:15:24.99,Default,,0,0,0,,Екінші тайфунға байланысты қызмет көрсету тоқтатылды.
Dialogue: 0,0:15:21.48,0:15:24.94,Default-ja,,0,0,0,,No2 тайфунына байланысты қызмет көрсету тоқтатылды.
Dialogue: 0,0:15:36.16,0:15:37.33,Default-ja,,0,0,0,,(Үш мүйізді) Құрлықтағыдай еркін қозғала алмайсың. Көресің әлі!
Dialogue: 5,0:15:36.18,0:15:37.59,Default,,0,0,0,,Ол ұйықтап жатыр.
Dialogue: 5,0:15:39.14,0:15:40.59,Default,,0,0,0,,Суя.
Dialogue: 0,0:15:39.16,0:15:42.08,Default-ja,,0,0,0,,Соя мырза, у...
Dialogue: 5,0:15:41.18,0:15:41.89,Default,,0,0,0,,Олар дәл қашан осы үйдің бір бөлігіне айналды?
Dialogue: 0,0:15:45.58,0:15:47.04,Default-ja,,0,0,0,,Мм... Соя мырза
Dialogue: 5,0:15:45.59,0:15:47.10,Default,,0,0,0,,Кешіріңіз, Соуя.
Dialogue: 0,0:15:49.92,0:15:51.26,Default-ja,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 5,0:15:49.93,0:15:51.14,Default,,0,0,0,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 5,0:15:52.59,0:15:53.06,Default,,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,0:15:52.59,0:15:53.55,Default-ja,,0,0,0,,Мм... (Соя) Иә?
Dialogue: 5,0:15:55.92,0:15:58.82,Default,,0,0,0,,Кешіріңіз, бірақ...
Dialogue: 0,0:15:55.93,0:15:57.22,Default-ja,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:57.35,0:16:02.23,Default-ja,,0,0,0,,Мм... Бірақ бұл пойыз енді қозғалмайтын сияқты.
Dialogue: 5,0:15:59.19,0:16:02.28,Default,,0,0,0,,Пойыз жүрмей қалған сияқты.
Dialogue: 0,0:16:05.48,0:16:06.31,Default-ja,,0,0,0,,Я...
Dialogue: 5,0:16:13.60,0:16:14.90,Default,,0,0,0,,Соуя?
Dialogue: 0,0:16:13.61,0:16:15.07,Default-ja,,0,0,0,,Соя мырза?
Dialogue: 5,0:16:18.82,0:16:22.38,Default,,0,0,0,,Менің ойымша, бүгін пойыз қозғалысы тоқтатылды.
Dialogue: 0,0:16:18.83,0:16:24.08,Default-ja,,0,0,0,,Бұрынғы эфирде бүгін жұмысты қайта бастауға үміт жоқ сияқты деп айтылды...
Dialogue: 5,0:16:22.81,0:16:24.13,Default,,0,0,0,,Олар осылай жариялады.
Dialogue: 5,0:16:24.56,0:16:28.26,Default,,0,0,0,,Сондықтан біз билеттеріміздің ақшасын қайтаруымыз керек, содан кейін...
Dialogue: 0,0:16:24.62,0:16:28.21,Default-ja,,0,0,0,,Сонымен, билетті қайтару және...
Dialogue: 5,0:16:30.03,0:16:32.77,Default,,0,0,0,,Мен оған жете алмаған сияқтымын.
Dialogue: 0,0:16:30.05,0:16:32.72,Default-ja,,0,0,0,,Ол ештеңе алмаған сияқты.
Dialogue: 5,0:16:33.57,0:16:36.01,Default,,0,0,0,,Менің жүрегім балғадай соға бастады.
Dialogue: 0,0:16:33.59,0:16:36.14,Default-ja,,0,0,0,,Кеудемнен шу шықты.
Dialogue: 5,0:16:37.31,0:16:39.78,Default,,0,0,0,,Түнге бөлме алғанымыз жөн.
Dialogue: 0,0:16:37.34,0:16:39.93,Default-ja,,0,0,0,,Мен бүгін түнде тұратын жер табуым керек.
Dialogue: 0,0:16:41.18,0:16:43.81,Default-ja,,0,0,0,,Барлық бөлшектер сәйкес келеді
Dialogue: 5,0:16:41.38,0:16:43.70,Default,,0,0,0,,Барлық бөлшектер орнына түсті.
Dialogue: 5,0:16:47.15,0:16:49.16,Default,,0,0,0,,Мен оны жалғыз қалдырам деп ойламадым,
Dialogue: 0,0:16:47.19,0:16:51.07,Default-ja,,0,0,0,,Мен оны жалғыз қалдыра алмай, қолымды тартып алдым.
Dialogue: 5,0:16:49.77,0:16:50.93,Default,,0,0,0,,сондықтан мен қолымды создым.
Dialogue: 5,0:16:53.38,0:16:57.15,Default,,0,0,0,,Айналасында бұл дыбыс өшіп тұрғандай емес еді.
Dialogue: 0,0:16:53.40,0:16:57.28,Default-ja,,0,0,0,,Бұл адамның айналасындағы дыбыстар жоғалмаған сияқты.
Dialogue: 0,0:16:58.53,0:17:02.91,Default-ja,,0,0,0,,Бұл адамның ішінде дыбыс жоқ.
Dialogue: 5,0:16:58.54,0:17:00.11,Default,,0,0,0,,Бұл болды
Dialogue: 5,0:17:01.42,0:17:02.82,Default,,0,0,0,,дыбысы ол үшін болмаған.
Dialogue: 5,0:17:07.93,0:17:09.56,Default,,0,0,0,,Тағы бір қосымша сабақ па, қазірден-ақ?
Dialogue: 0,0:17:08.21,0:17:10.38,Default-ja,,0,0,0,,Неліктен? Қашаннан бері?
Dialogue: 5,0:17:09.56,0:17:10.43,Default,,0,0,0,,Қанша уақытқа?
Dialogue: 0,0:17:12.55,0:17:13.38,Default-ja,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 5,0:17:12.57,0:17:13.43,Default,,0,0,0,,Тик-так, сағат тілі тик-так
Dialogue: 5,0:17:15.01,0:17:20.35,Default,,0,0,0,,Бірақ оның құлағына енді ештеңе жетпейді.
Dialogue: 0,0:17:15.01,0:17:20.51,Default-ja,,0,0,0,,Бұл кісінің құлағына енді ештеңе жетпейді.
Dialogue: 0,0:17:20.93,0:17:23.94,titles,,0,0,0,,Ақ дауыл (3 бөлім)
Dialogue: 0,0:17:23.94,0:17:27.94,titles,,0,0,0,,Ақ дауыл (4-бөлім)
Dialogue: 0,0:17:28.06,0:17:29.35,Default-ja,,0,0,0,,Операцияларды қайта бастаудың болжамы қандай?
Dialogue: 5,0:17:29.47,0:17:32.31,Default,,0,0,0,,Хабарландырулар станцияда тоқтаусыз жалғасты.
Dialogue: 0,0:17:29.48,0:17:34.65,Default-ja,,0,0,0,,Станцияда қатты жаңбырдың ылғалдылығы арасында хабарландырулар естілуі жалғасуда.
Dialogue: 5,0:17:32.31,0:17:37.46,Default,,0,0,0,,Жаңбырдың ауа ылғалдылығы кезінде үй-жайларды адамдар басып қалды.
Dialogue: 0,0:17:34.78,0:17:37.40,Default-ja,,0,0,0,,Кампус көп адамға лық толы болды.
Dialogue: 0,0:17:39.03,0:17:40.91,Default-ja,,0,0,0,,Мен бүгін қозғалмаймын.
Dialogue: 5,0:17:39.04,0:17:40.96,Default,,0,0,0,,Ол ертеңге дейін жұмыс істемейді.
Dialogue: 5,0:17:41.66,0:17:45.46,Default,,0,0,0,,Бұл жағдайда біз арнайы экспресс билеттеріміздің ақшасын қайтаруымыз керек.
Dialogue: 0,0:17:41.66,0:17:45.41,Default-ja,,0,0,0,,Бұл экспресс билетті қайтаруым керек дегенді білдіре ме?
Dialogue: 0,0:17:46.33,0:17:48.12,Default-ja,,0,0,0,,No2 тайфунның әсерінен...
Dialogue: 5,0:17:47.99,0:17:50.60,Default,,0,0,0,,Билет желісі шынымен ұзақ шығар.
Dialogue: 0,0:17:48.25,0:17:52.63,Default-ja,,0,0,0,,Билет кассасы лық толы сияқты. Мен сәл кешігіп қалдым.
Dialogue: 5,0:17:50.60,0:17:52.45,Default,,0,0,0,,Пойыздан сәл баяу түстім.
Dialogue: 5,0:17:53.53,0:17:57.06,Default,,0,0,0,,Ум, билет қақпасынан өтейік.
Dialogue: 0,0:17:53.55,0:17:57.01,Default-ja,,0,0,0,,Мм... онда билет қақпасынан шығайық.
Dialogue: 0,0:17:58.09,0:18:02.01,Default-ja,,0,0,0,,Мен жедел билетті төлеу үшін кезекте тұрамын...
Dialogue: 5,0:17:58.10,0:18:02.06,Default,,0,0,0,,Мен кезекке тұрамын және пойыз билеттерін реттеуге дайынмын.
Dialogue: 0,0:18:03.68,0:18:05.43,Default-ja,,0,0,0,,Иә? Соя мырза?
Dialogue: 5,0:18:04.02,0:18:05.26,Default,,0,0,0,,Соуя?
Dialogue: 0,0:18:08.56,0:18:10.57,signs,,0,0,0,,Реттеу терезесі
Dialogue: 1,0:18:08.56,0:18:10.57,signs,,0,0,0,,Реттеу терезесі
Dialogue: 5,0:18:11.79,0:18:12.83,Default,,0,0,0,,Кел де жуынып ал.
Dialogue: 0,0:18:11.81,0:18:12.77,Default-ja,,0,0,0,,Сәлем
Dialogue: 5,0:18:13.11,0:18:14.34,Default,,0,0,0,,Б... бір сызық
Dialogue: 0,0:18:13.11,0:18:18.28,Default-ja,,0,0,0,,Түсіндім, бұл ақшаны қайтару болғандықтан, мен оны осы жерден де жасай аламын. Мен түсінемін.
Dialogue: 5,0:18:14.34,0:18:17.16,Default,,0,0,0,,Біз ақшаны қайтарып жатырмыз, сондықтан оны осы жерден де жасай аламыз.
Dialogue: 5,0:18:17.16,0:18:18.33,Default,,0,0,0,,мағынасы бар.
Dialogue: 0,0:18:18.33,0:18:23.83,signs,,0,0,0,,Реттеу терезесі
Dialogue: 1,0:18:18.33,0:18:23.83,signs,,0,0,0,,Реттеу терезесі
Dialogue: 5,0:18:20.71,0:18:24.66,Default,,0,0,0,,Енді біз ақшаны қайтарып, ертеңгі билеттерді шештік.
Dialogue: 0,0:18:20.74,0:18:24.66,Default-ja,,0,0,0,,Ақшаны қайтару және билет рәсімдері аяқталды.
Dialogue: 5,0:18:24.66,0:18:28.27,Default,,0,0,0,,Ым, келесі... Дұрыс. Қонатын орын.
Dialogue: 0,0:18:24.79,0:18:30.29,Default-ja,,0,0,0,,Ал, келесі... Дұрыс, мен тұратын жер табу керек.
Dialogue: 5,0:18:28.27,0:18:30.34,Default,,0,0,0,,Брондау жасағанымыз жөн.
Dialogue: 5,0:18:31.03,0:18:34.00,Default,,0,0,0,,Бұл үлкен станция, сондықтан ақпараттық есептегіш болуы керек.
Dialogue: 0,0:18:31.08,0:18:34.17,Default-ja,,0,0,0,,Бұл үлкен станция, сондықтан ақпараттық тақталар болуы керек...
Dialogue: 5,0:18:36.37,0:18:37.88,Default,,0,0,0,,О, мінекей.
Dialogue: 0,0:18:36.38,0:18:38.01,Default-ja,,0,0,0,,Міне, болды.
Dialogue: 5,0:18:39.05,0:18:41.32,Default,,0,0,0,,Ум, қайсысы жақсы болар еді?
Dialogue: 0,0:18:39.13,0:18:41.26,Default-ja,,0,0,0,,Хмм... қайсысы жақсы?
Dialogue: 5,0:18:41.32,0:18:47.99,Default,,0,0,0,,Ол шынымен төмен түсіп жатыр, сондықтан станцияға мүмкіндігінше жақын жерде, жер асты өткелдеріне қосылған орын сияқты.
Dialogue: 0,0:18:41.39,0:18:45.18,Default-ja,,0,0,0,,Жаңбыр көп жауатын сияқты, сондықтан мен станцияға мүмкіндігінше жақын болғым келеді.
Dialogue: 0,0:18:45.31,0:18:48.14,Default-ja,,0,0,0,,Жер асты өткелдерімен байланыстырылған орындар т.б.
Dialogue: 0,0:18:49.52,0:18:52.02,Default-ja,,0,0,0,,Солай ма? Сіз толығымен брондалғансыз ба?
Dialogue: 5,0:18:49.53,0:18:52.06,Default,,0,0,0,,Шынымен бе? Сізге тапсырыс берілді ме?
Dialogue: 5,0:18:52.06,0:18:53.46,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:18:52.15,0:18:55.57,Default-ja,,0,0,0,,Түсіндім Рахмет Иә
Dialogue: 5,0:18:53.46,0:18:54.91,Default,,0,0,0,,Кел де жуынып ал.
Dialogue: 5,0:18:54.91,0:18:55.62,Default,,0,0,0,,Алдымен, ортаңғы және көрсеткі саусақтарыңызды осылайша қосыңыз,
Dialogue: 5,0:18:57.09,0:19:00.12,Default,,0,0,0,,Вокзал жанындағы қонақүйлердің ешқайсысында бос орындар жоқ.
Dialogue: 0,0:18:57.11,0:19:00.07,Default-ja,,0,0,0,,Вокзалға жақын барлық қонақүйлер шығып кетті ме?
Dialogue: 5,0:19:00.12,0:19:04.38,Default,,0,0,0,,Олай болса, қай қонақүйді таңдауымыз керек?
Dialogue: 0,0:19:00.49,0:19:04.32,Default-ja,,0,0,0,,Сонда қай қонақүй жақсырақ?
Dialogue: 5,0:19:04.38,0:19:07.02,Default,,0,0,0,,Мен болсам, кез келгені жақсы болар еді.
Dialogue: 0,0:19:04.62,0:19:06.87,Default-ja,,0,0,0,,Мен ғана болсам, бәрі жақсы.
Dialogue: 5,0:19:11.91,0:19:13.98,Default,,0,0,0,,Seisen Inn?
Dialogue: 0,0:19:11.92,0:19:16.38,Default-ja,,0,0,0,,«Сориизуми қонақ үйі»…Аа, бұл Токиода да жиі кездеседі.
Dialogue: 5,0:19:13.98,0:19:16.43,Default,,0,0,0,,О, Токиода да олар өте көп.
Dialogue: 5,0:19:17.13,0:19:19.13,Default,,0,0,0,,Біз тіпті ол жерде жүре аламыз.
Dialogue: 0,0:19:17.17,0:19:20.67,Default-ja,,0,0,0,,Онда жаяу жүруге болады. Бұл соншалықты алыс емес.
Dialogue: 5,0:19:19.13,0:19:20.94,Default,,0,0,0,,Бұл өте алыс емес.
Dialogue: 5,0:19:21.52,0:19:23.41,Default,,0,0,0,,Иә, сізде бос орындар бар ма?
Dialogue: 0,0:19:21.55,0:19:25.55,Default-ja,,0,0,0,,Иә, боссың ба? Иә, бір кісілік 2 бөлмелі
Dialogue: 5,0:19:23.41,0:19:25.45,Default,,0,0,0,,Иә. Екі бір кісілік бөлме.
Dialogue: 0,0:19:26.18,0:19:28.64,Default-ja,,0,0,0,,Иә, мен қазір кетемін Иә
Dialogue: 5,0:19:26.19,0:19:27.91,Default,,0,0,0,,Иә, біз дәл қазір сонда барамыз.
Dialogue: 5,0:19:27.91,0:19:28.69,Default,,0,0,0,,Уф.
Dialogue: 0,0:19:28.69,0:19:31.95,signs,,0,0,0,,Seisen Inn
Dialogue: 1,0:19:28.69,0:19:31.95,signs,,0,0,0,,Seisen Inn
Dialogue: 0,0:19:28.93,0:19:31.89,Default-ja,,0,0,0,,Жарайды, түсіндім. Мен қуаныштымын.
Dialogue: 5,0:19:29.46,0:19:30.86,Default,,0,0,0,,Жарайды, бізде бөлмелер бар.
Dialogue: 5,0:19:30.86,0:19:31.95,Default,,0,0,0,,Біздің руға шабуыл жасаған Маскалылар Эбису-саманың…
Dialogue: 5,0:19:32.56,0:19:33.95,Default,,0,0,0,,Вент одан әрі ашылмауына қол жеткіздік.
Dialogue: 0,0:19:32.56,0:19:33.90,Default-ja,,0,0,0,,Енді барайық
Dialogue: 5,0:19:36.61,0:19:42.71,Default,,0,0,0,,Бұл сұр бөлік жер астында болуы керек, сондықтан мүмкіндігінше онымен жүрейік, содан кейін тротуармен жүрейік.
Dialogue: 0,0:19:36.61,0:19:40.07,Default-ja,,0,0,0,,Мен бұл сұр аймақтың жер асты өткелі екеніне сенімдімін.
Dialogue: 0,0:19:39.20,0:19:42.71,signs,,0,0,0,,Seisen Inn
Dialogue: 1,0:19:39.20,0:19:42.71,signs,,0,0,0,,Seisen Inn
Dialogue: 0,0:19:40.19,0:19:42.65,Default-ja,,0,0,0,,Мүмкіндігінше төмен түсіп, жоғарыдан шығыңыз.
Dialogue: 5,0:19:44.81,0:19:45.96,Default,,0,0,0,,Оң. Қолшатырлар.
Dialogue: 0,0:19:44.82,0:19:47.41,Default-ja,,0,0,0,,Иә, қолшатыр! Қолшатыр сатып алуым керек
Dialogue: 5,0:19:46.30,0:19:47.46,Default,,0,0,0,,Қолшатыр сатып алғанымыз жөн.
Dialogue: 0,0:19:47.45,0:19:48.46,signs,,0,0,0,,m -473 162 l -368 244 329 221 466 61 486 -24 405 -127 213 -187 -62 -213 -308 -211 -436 -160 -508 43
Dialogue: 1,0:19:47.45,0:19:48.46,signs,,0,0,0,,Бос
Dialogue: 2,0:19:47.45,0:19:48.46,signs,,0,0,0,,Бос
Dialogue: 5,0:19:48.46,0:19:49.71,Default,,0,0,0,,Ешқайсысы жоқ!
Dialogue: 0,0:19:48.58,0:19:49.66,Default-ja,,0,0,0,,Ха... жоқ!
Dialogue: 0,0:19:48.70,0:19:50.46,signs,,0,0,0,,Көзді ашып-жұмғанша сатылып кетті
Dialogue: 1,0:19:48.70,0:19:50.46,signs,,0,0,0,,Көзді ашып-жұмғанша сатылып кетті
Dialogue: 0,0:19:48.95,0:19:50.46,signs,,0,0,0,,Бос
Dialogue: 1,0:19:48.95,0:19:50.46,signs,,0,0,0,,Бос
Dialogue: 0,0:19:49.71,0:19:50.46,signs,,0,0,0,,Ахх!
Dialogue: 1,0:19:49.71,0:19:50.46,signs,,0,0,0,,Ахх!
Dialogue: 5,0:19:53.15,0:19:56.62,Default,,0,0,0,,Бақытымызға орай, ол дүкенде әлі де қолшатырлар болды.
Dialogue: 0,0:19:53.33,0:19:56.54,Default-ja,,0,0,0,,Жақсы болды. Қолшатыр болды.
Dialogue: 5,0:19:56.62,0:19:58.53,Default,,0,0,0,,Олар дәл осылай сатылады.
Dialogue: 0,0:19:56.67,0:19:59.84,Default-ja,,0,0,0,,Бірден жоғалып кетті. Бұл қауіпті болды.
Dialogue: 5,0:19:58.53,0:19:59.89,Default,,0,0,0,,Бұл жақын болды.
Dialogue: 0,0:20:00.26,0:20:01.92,Default-ja,,0,0,0,,Енді барайық
Dialogue: 5,0:20:00.27,0:20:01.86,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 5,0:20:08.63,0:20:10.86,Default,,0,0,0,,Бұл шынайы емес еді.
Dialogue: 0,0:20:08.64,0:20:10.60,Default-ja,,0,0,0,,Шындық сезімі болған жоқ
Dialogue: 5,0:20:12.42,0:20:15.87,Default,,0,0,0,,Бірақ біртүрлі эйфория сезімі болды.
Dialogue: 0,0:20:12.43,0:20:15.81,Default-ja,,0,0,0,,Бірақ мен біртүрлі қуаныш сезімін сезіндім.
Dialogue: 5,0:20:17.30,0:20:20.87,Default,,0,0,0,,Бұл тайфунға байланысты болса керек.
Dialogue: 0,0:20:17.31,0:20:20.82,Default-ja,,0,0,0,,Мұның бәрі осы тайфунның кесірінен екеніне сенімдімін.
Dialogue: 0,0:20:24.40,0:20:26.70,Default-ja,,0,0,0,,Уау... таксилердің үлкен кезегі
Dialogue: 5,0:20:24.88,0:20:26.75,Default,,0,0,0,,Таксиге арналған жолды қараңыз!
Dialogue: 5,0:20:28.91,0:20:31.01,Default,,0,0,0,,Уа, неткен жаңбыр!
Dialogue: 0,0:20:28.91,0:20:30.95,Default-ja,,0,0,0,,Уау... жаңбыр керемет!
Dialogue: 5,0:20:32.76,0:20:33.71,Default,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:20:32.87,0:20:37.46,Default-ja,,0,0,0,,Иә? Бұл дүкенге айналды.
Dialogue: 5,0:20:33.71,0:20:35.01,Default,,0,0,0,,Олар дәл қашан осы үйдің бір бөлігіне айналды?
Dialogue: 5,0:20:35.31,0:20:37.51,Default,,0,0,0,,Бұл жол кейбір дүкендерге апаратын сияқты.
Dialogue: 0,0:20:38.09,0:20:39.96,Default-ja,,0,0,0,,Мен бұл жерден шыға аламын ба деп ойлаймын...
Dialogue: 5,0:20:38.09,0:20:40.01,Default,,0,0,0,,Осы жерден тротуарға жете аламыз ба?
Dialogue: 5,0:20:42.97,0:20:43.73,Default,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:20:42.97,0:20:47.34,Default-ja,,0,0,0,,Иә? Бұл... жүк көлігі ме?
Dialogue: 5,0:20:43.73,0:20:45.36,Default,,0,0,0,,Мм... Бұл...
Dialogue: 5,0:20:46.12,0:20:47.40,Default,,0,0,0,,Жүк көлігі?!
Dialogue: 5,0:20:47.40,0:20:49.36,Default,,0,0,0,,Қызмет көрсетуге арналған кіреберіс?
Dialogue: 0,0:20:47.68,0:20:50.72,Default-ja,,0,0,0,,Бұл жеткізу кіреберісі ме? Мен бұл жерден кете аламын ба деп ойлаймын...
Dialogue: 5,0:20:49.36,0:20:50.78,Default,,0,0,0,,Осы жолмен шығу дұрыс па?
Dialogue: 0,0:20:52.31,0:20:53.60,Default-ja,,0,0,0,,Баяу?
Dialogue: 5,0:20:52.32,0:20:53.48,Default,,0,0,0,,Дәл солай ма?!
Dialogue: 5,0:21:27.83,0:21:31.69,Default,,0,0,0,,Маған дәл қазір, бүгін кешке және ертең таңертең керек нәрсе керек.
Dialogue: 0,0:21:27.84,0:21:31.64,Default-ja,,0,0,0,,Ағымдағы минут, түнгі минут және таңғы минут?
Dialogue: 0,0:21:32.14,0:21:37.60,Default-ja,,0,0,0,,〜   …
Dialogue: 5,0:21:32.15,0:21:33.44,Default,,0,0,0,,Мм, сондай-ақ...
Dialogue: 5,0:21:33.80,0:21:37.67,Default,,0,0,0,,Сэндвич, күріш шары, кесе кеспе...
Dialogue: 5,0:21:37.67,0:21:38.82,Default,,0,0,0,,Алдымен, ортаңғы және көрсеткі саусақтарыңызды осылайша қосыңыз,
Dialogue: 0,0:21:37.73,0:21:39.77,Default-ja,,0,0,0,,Жарайды, иә
Dialogue: 5,0:21:39.21,0:21:39.82,Default,,0,0,0,,Бұл орындалады.
Dialogue: 5,0:21:40.39,0:21:45.33,Default,,0,0,0,,Мен тым көп сатып алуым мүмкін, бірақ бұл жаңбырда қайта шыққым келмейді.
Dialogue: 0,0:21:40.40,0:21:42.32,Default-ja,,0,0,0,,Мүмкін мен тым көп сатып алған шығармын, бірақ...
Dialogue: 0,0:21:42.44,0:21:45.28,Default-ja,,0,0,0,,...
Dialogue: 5,0:21:49.24,0:21:51.59,Default,,0,0,0,,Сіздің жалпы сомасы 1540 иен.
Dialogue: 0,0:21:49.24,0:21:51.53,Default-ja,,0,0,0,,Барлығы 1540 иен
Dialogue: 5,0:21:51.99,0:21:53.40,Default,,0,0,0,,Барлығы осы ма?
Dialogue: 0,0:21:52.16,0:21:57.33,Default-ja,,0,0,0,,…
Dialogue: 5,0:21:53.40,0:21:57.59,Default,,0,0,0,,Төтенше жәрдемақылар тізбегі сияқты.
Dialogue: 0,0:21:57.84,0:22:00.59,signs,,0,0,0,,оралған жұмыртқа сэндвичі
Dialogue: 1,0:21:57.84,0:22:00.59,signs,,0,0,0,,Қапталған жұмыртқа сэндвичі
Dialogue: 0,0:21:57.84,0:22:00.59,signs,,0,0,0,,Шошқа етінен жасалған котлет сэндвичі
Dialogue: 1,0:21:57.84,0:22:00.59,signs,,0,0,0,,Шошқа котлетінен жасалған сэндвич
Dialogue: 0,0:21:57.84,0:22:00.59,signs,,0,0,0,,Қуырылған тофу
Dialogue: 1,0:21:57.84,0:22:00.59,signs,,0,0,0,,Қуырылған тофу
Dialogue: 0,0:21:57.84,0:22:00.59,signs,,0,0,0,,Сөмкелер
Dialogue: 1,0:21:57.84,0:22:00.59,signs,,0,0,0,,Сөмкелер
Dialogue: 0,0:21:57.84,0:22:00.59,signs,,0,0,0,,Сүтті шоколад
Dialogue: 1,0:21:57.84,0:22:00.59,signs,,0,0,0,,Сүтті шоколад
Dialogue: 0,0:21:57.84,0:22:00.59,signs,,0,0,0,,Кремді нан
Dialogue: 1,0:21:57.84,0:22:00.59,signs,,0,0,0,,Кремді нан
Dialogue: 0,0:21:57.84,0:22:00.59,signs,,0,0,0,,Үлпілдек қауын нан
Dialogue: 1,0:21:57.84,0:22:00.59,signs,,0,0,0,,Үлпілдек қауын нан
Dialogue: 0,0:21:58.12,0:22:00.54,Default-ja,,0,0,0,,Барлығы 2980 иен
Dialogue: 5,0:21:58.15,0:22:00.59,Default,,0,0,0,,Сіздің жалпы сомасы 2980 иен.
Dialogue: 5,0:22:00.59,0:22:03.21,Default,,0,0,0,,Иә? Шынымен бе? Соншама?
Dialogue: 0,0:22:00.59,0:22:03.71,signs,,0,0,0,,Үйме
Dialogue: 1,0:22:00.59,0:22:03.71,signs,,0,0,0,,Үйме
Dialogue: 0,0:22:00.83,0:22:03.30,Default-ja,,0,0,0,,Не? иә? сонда?
Dialogue: 0,0:22:00.96,0:22:03.71,signs,,0,0,0,,Тым көп сатып алды
Dialogue: 1,0:22:00.96,0:22:03.71,signs,,0,0,0,,Тым көп сатып алды
Dialogue: 0,0:22:01.59,0:22:03.71,signs,,0,0,0,,*Тайфунмен \hалып кеткен \hжағдай
Dialogue: 1,0:22:01.59,0:22:03.71,signs,,0,0,0,,*Тайфунмен \hалып кеткен \hжағдай
Dialogue: 0,0:22:03.84,0:22:06.67,Default-ja,,0,0,0,,Сізге көп рахмет
Dialogue: 5,0:22:04.83,0:22:06.73,Default,,0,0,0,,Рахмет!
Dialogue: 5,0:22:23.39,0:22:24.24,Default,,0,0,0,,Мен оны көріп тұрмын.
Dialogue: 0,0:22:23.40,0:22:24.19,Default-ja,,0,0,0,,сонымен қатар кейбір қосымша пайда да бар. Олар қандай?
Dialogue: 5,0:22:26.11,0:22:27.46,Default,,0,0,0,,Мен солай деп ойлаймын.
Dialogue: 0,0:22:26.11,0:22:27.53,Default-ja,,0,0,0,,Мүмкін солай шығар.
Dialogue: 0,0:22:44.14,0:22:49.73,ED,,0,0,0,,Тұрақты тоқырау шегіндегі пейзажмен қоршалған
Dialogue: 0,0:22:49.73,0:22:53.36,ED,,0,0,0,,Мен өзімді бірдеңе іздеп таптым
Dialogue: 0,0:22:55.12,0:23:01.84,ED,,0,0,0,,Мен өзімнің аянышты әлсіздігімді тұрақты етіп көрсету үшін бетперде кидім
Dialogue: 0,0:23:02.57,0:23:04.74,ED,,0,0,0,,Және оны батыл кигізді
Dialogue: 0,0:23:06.26,0:23:11.76,ED,,0,0,0,,Өзен жағалап келе жатқанда мұздаған қадамымның дыбысы
Dialogue: 0,0:23:11.76,0:23:17.31,ED,,0,0,0,,Өтіп бара жатқан пойыздың гуілінен оп-оңай басып қалды
Dialogue: 0,0:23:17.31,0:23:26.50,ED,,0,0,0,,Соған қарамастан мен өз-өзіме «Мен тағы бір қадам жасауым керек» деп айқайлай бердім
Dialogue: 0,0:23:26.95,0:23:28.35,ED,,0,0,0,,Қайта-қайта
Dialogue: 0,0:23:28.35,0:23:33.59,ED,,0,0,0,,Менің дәл осы жерде тұрмын деп жариялағанымды естіп тұрсың ба?
Dialogue: 0,0:23:33.59,0:23:39.15,ED,,0,0,0,,Жалаң аяқ болсам да, мен қалаған жерге бара аламын
Dialogue: 0,0:23:39.15,0:23:45.66,ED,,0,0,0,,Мен өзімді қай жерде табатынымды білмеймін
Dialogue: 0,0:23:45.66,0:23:50.42,ED,,0,0,0,,Мен болжай алмаймын, бірақ мен сиямен жаза аламын
Dialogue: 0,0:23:50.42,0:23:57.81,ED,,0,0,0,,Барған сайын маған сәйкес келетін жаңа пейзаж
Dialogue: 5,0:24:06.78,0:24:07.93,Default,,0,0,0,,Мен жүре бастағанда,
Dialogue: 0,0:24:06.79,0:24:07.88,Default-ja,,0,0,0,,Мен жүре бастағанда—
Dialogue: 0,0:24:08.88,0:24:09.88,Default-ja,,0,0,0,,Жаяу жүре бастаңыз
Dialogue: 5,0:24:08.89,0:24:09.93,Default,,0,0,0,,ол жүре бастайды.
Dialogue: 0,0:24:13.30,0:24:14.38,Default-ja,,0,0,0,,Сіз тоқтаған кезде—
Dialogue: 5,0:24:13.32,0:24:14.44,Default,,0,0,0,,Мен тоқтаған кезде,
Dialogue: 5,0:24:15.21,0:24:16.44,Default,,0,0,0,,ол тоқтайды.
Dialogue: 0,0:24:15.22,0:24:16.39,Default-ja,,0,0,0,,тоқтату
Dialogue: 5,0:24:20.07,0:24:22.08,Default,,0,0,0,,Бұл құдай сияқты
Dialogue: 0,0:24:20.10,0:24:22.18,Default-ja,,0,0,0,,Менің артымнан тыныш жүр...
Dialogue: 5,0:24:23.73,0:24:25.55,Default,,0,0,0,,үнсіз менің артымнан келе жатыр.
Dialogue: 0,0:24:23.73,0:24:25.65,Default-ja,,0,0,0,,Құдай ереді
Dialogue: 0,0:24:27.94,0:24:30.99,titles,,0,0,0,,Ақ дауыл (4-бөлім)
Dialogue: 0,0:24:30.99,0:24:32.99,titles,,0,0,0,,Келесі эпизодты алдын ала қарау
Dialogue: 5,0:24:32.99,0:24:34.65,Default,,0,0,0,,Бұл менмін.
Dialogue: 0,0:24:32.99,0:24:51.01,signs,,0,0,0,,38-бөлім
Dialogue: 1,0:24:32.99,0:24:51.01,signs,,0,0,0,,38-бөлім
Dialogue: 0,0:24:33.32,0:24:36.53,Default-ja,,0,0,0,,Бұл менмін. Сенімен бәрі жақсы ма?
Dialogue: 5,0:24:34.65,0:24:36.58,Default,,0,0,0,,Қандай сәнсіз...
Dialogue: 5,0:24:36.58,0:24:39.24,Default,,0,0,0,,Бұл мүлдем шынайы емес еді.
Dialogue: 0,0:24:36.66,0:24:39.03,Default-ja,,0,0,0,,...
Dialogue: 5,0:24:39.24,0:24:40.95,Default,,0,0,0,,Жылдар бойы,
Dialogue: 0,0:24:39.41,0:24:40.91,Default-ja,,0,0,0,,Көп уақыт өтті
Dialogue: 5,0:24:40.95,0:24:44.61,Default,,0,0,0,,еститін кездер, естімейтін кездер болады.
Dialogue: 0,0:24:41.04,0:24:42.70,Default-ja,,0,0,0,,«есту» және «есту емес»—
Dialogue: 0,0:24:42.83,0:24:44.79,Default-ja,,0,0,0,,Алды-артқа жүру
Dialogue: 5,0:24:45.31,0:24:50.10,Default,,0,0,0,,Екеуміз жаңбырда бірге жүргенімізге сенімді болсам да.
Dialogue: 0,0:24:45.33,0:24:46.92,Default-ja,,0,0,0,,Сол жаңбырда —
Dialogue: 0,0:24:47.38,0:24:50.21,Default-ja,,0,0,0,,Екеуміз бірге жүрдік...
Dialogue: 0,0:24:51.01,0:25:01.02,signs,,0,0,0,,Сурет: Камиджоу Атсуши
Dialogue: 1,0:24:51.01,0:25:01.02,signs,,0,0,0,,Сурет: Камиджоу Атсуши
Dialogue: 2,0:24:51.01,0:25:01.02,signs,,0,0,0,,Сурет: Камиджоу Атсуши
Dialogue: 0,0:24:51.92,0:24:54.88,Default-ja,,0,0,0,,Ашық аспан астындағы монша керемет.
Dialogue: 5,0:24:51.93,0:24:54.97,Default,,0,0,0,,Ашық аспандағы ыстық бұлақ керемет еді!
Dialogue: 5,0:24:54.97,0:24:57.64,Default,,0,0,0,,Сенің де кіруің керек еді, Кирияма.
Dialogue: 0,0:24:55.01,0:24:57.76,Default-ja,,0,0,0,,Кирияма-чанды да қосуым керек еді.
