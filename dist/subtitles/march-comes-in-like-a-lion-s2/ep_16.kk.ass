Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 5,0:00:01.98,0:00:05.66,Default,,0,0,0,,Пойыз қозғалысы қалған уақытқа тоқтатылды.
Dialogue: 0,0:00:01.98,0:00:05.53,Default-ja,,0,0,0,,Операциялардың бүгін қашан қайта басталатыны туралы ешқандай болжам жоқ.
Dialogue: 0,0:00:05.65,0:00:06.53,Default-ja,,0,0,0,,Қайталау…
Dialogue: 5,0:00:05.66,0:00:06.53,Default,,0,0,0,,Қайталап айтамын...
Dialogue: 0,0:00:16.54,0:00:18.42,signs,,0,0,0,,Реттеу терезесі
Dialogue: 1,0:00:16.54,0:00:18.42,signs,,0,0,0,,Реттеу терезесі
Dialogue: 0,0:01:43.46,0:01:44.96,Default-ja,,0,0,0,,Мен жүре бастағанда—
Dialogue: 5,0:01:43.48,0:01:44.96,Default,,0,0,0,,Мен жүре бастағанда,
Dialogue: 0,0:01:45.59,0:01:46.96,Default-ja,,0,0,0,,Жаяу жүруді бастаңыз
Dialogue: 5,0:01:45.60,0:01:46.97,Default,,0,0,0,,ол жүре бастайды.
Dialogue: 0,0:01:50.01,0:01:51.47,Default-ja,,0,0,0,,Сіз тоқтаған кезде—
Dialogue: 5,0:01:50.03,0:01:51.47,Default,,0,0,0,,Мен тоқтаған кезде,
Dialogue: 0,0:01:51.89,0:01:53.14,Default-ja,,0,0,0,,Тоқта
Dialogue: 5,0:01:51.93,0:01:52.97,Default,,0,0,0,,ол тоқтайды.
Dialogue: 0,0:01:56.68,0:01:58.89,Default-ja,,0,0,0,,Менің артымнан тыныш жүр...
Dialogue: 5,0:01:56.75,0:01:58.72,Default,,0,0,0,,Бұл құдай сияқты
Dialogue: 0,0:02:00.39,0:02:02.44,Default-ja,,0,0,0,,Құдай ереді
Dialogue: 5,0:02:00.43,0:02:02.27,Default,,0,0,0,,үнсіз менің артымнан келе жатыр.
Dialogue: 0,0:02:11.74,0:02:14.45,OP,,0,0,0,,Жаңа гүлдеген одуванчиктердің арасында
Dialogue: 0,0:02:14.45,0:02:18.37,OP,,0,0,0,,Қарға айнала алмаған су тамшылары
Dialogue: 0,0:02:18.37,0:02:22.24,OP,,0,0,0,,Мен көз жасына боялған жүзді ажырата аламын деп ойладым
Dialogue: 0,0:02:22.24,0:02:24.96,OP,,0,0,0,,Мен ойланбастан қолшатырымды ұсындым
Dialogue: 0,0:02:24.96,0:02:29.07,OP,,0,0,0,,Солға немесе оңға жүру дұрыс па?
Dialogue: 0,0:02:29.07,0:02:32.88,OP,,0,0,0,,Мен шынымен шешім қабылдамай тұрып жол аяқталды
Dialogue: 0,0:02:32.88,0:02:36.93,OP,,0,0,0,,Бірақ бұл ерекше біреуді аямайтын дұрыс қоңырау екені сөзсіз
Dialogue: 0,0:02:36.93,0:02:40.85,OP,,0,0,0,,Кез келген азапты тәжірибелерден
Dialogue: 0,0:02:40.85,0:02:43.99,OP,,0,0,0,,Ендеше, кішкене батылдықпен, алға ұмтылыңыз
Dialogue: 0,0:02:43.99,0:02:47.57,OP,,0,0,0,,Егер бәрі қисық болса, қиғаш жолмен жүріңіз
Dialogue: 0,0:02:47.57,0:02:51.30,OP,,0,0,0,,Алға қарай жүрсең нұрды табасың
Dialogue: 0,0:02:51.30,0:02:55.02,OP,,0,0,0,,Бір-біріне үйіріліп, бір дауыста сайрап тұрған кішкентай құстар сияқты
Dialogue: 0,0:02:55.02,0:02:58.62,OP,,0,0,0,,Жаңа маусымның басында міндетті түрде қоңырау соғамыз
Dialogue: 0,0:02:58.62,0:03:01.42,OP,,0,0,0,,Сонымен көктем бізді тағы да құшағына алады
Dialogue: 0,0:03:01.42,0:03:05.65,OP,,0,0,0,,Біз жаңа беттерге бояуды шашыратып жібереміз
Dialogue: 0,0:03:05.65,0:03:09.54,OP,,0,0,0,,Екеуміз тез дос болдық, жақсы тамақтандық
Dialogue: 0,0:03:09.54,0:03:12.18,OP,,0,0,0,,Біз тіпті біраз ұрысып қалған шығармыз
Dialogue: 0,0:03:12.18,0:03:15.82,OP,,0,0,0,,Бірақ біз сол кішкентай сәттерді жүрегімізде сақтаймыз
Dialogue: 0,0:03:15.82,0:03:19.55,OP,,0,0,0,,Бізді қателесуге болмайтын болашаққа итермелейтін себептер ретінде
Dialogue: 0,0:03:19.55,0:03:23.94,OP,,0,0,0,,Күн сәулесі түскен ағаштардың арасында қанша рет адасып қалсақ та
Dialogue: 0,0:03:23.94,0:03:28.54,OP,,0,0,0,,Бүгін бір жақты билетпен желдер осында алып кетті
Dialogue: 0,0:03:28.54,0:03:29.99,OP,,0,0,0,,Бұл тамаша күнге гүлдейді
Dialogue: 0,0:03:34.91,0:03:38.00,titles,,0,0,0,,Ақ дауыл (4-бөлім) Жалғасы
Dialogue: 0,0:03:46.54,0:03:50.13,Default-ja,,0,0,0,,Ал... сонда
Dialogue: 5,0:03:46.59,0:03:47.88,Default,,0,0,0,,Олар дәл қашан осы үйдің бір бөлігіне айналды?
Dialogue: 5,0:03:48.65,0:03:50.13,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:03:59.43,0:04:00.89,Default-ja,,0,0,0,,Рахмет
Dialogue: 5,0:03:59.49,0:04:00.89,Default,,0,0,0,,Кел де жуынып ал.
Dialogue: 0,0:04:01.06,0:04:02.64,Default-ja,,0,0,0,,Өте шиеленісті, иә?
Dialogue: 5,0:04:01.23,0:04:02.26,Default,,0,0,0,,Мен көмекті бағалаймын.
Dialogue: 0,0:04:40.68,0:04:42.81,Default-ja,,0,0,0,,Иә, бұл Кирияма.
Dialogue: 5,0:04:40.70,0:04:42.90,Default,,0,0,0,,Сәлеметсіз бе? Кирияма осында.
Dialogue: 5,0:04:42.90,0:04:44.77,Default,,0,0,0,,Сәлем! Бұл мен.
Dialogue: 0,0:04:42.93,0:04:44.77,Default-ja,,0,0,0,,Иә, бұл менмін.
Dialogue: 0,0:04:44.77,0:04:46.52,signs,,0,0,0,,Төраға Цзингуджи
Dialogue: 1,0:04:44.77,0:04:46.52,signs,,0,0,0,,Төраға Цзингуджи
Dialogue: 2,0:04:44.77,0:04:46.52,signs,,0,0,0,,Төраға Цзингуджи
Dialogue: 0,0:04:45.14,0:04:46.52,Default-ja,,0,0,0,,Мен бұған сенгенмін, бірақ ол шынымен де құбыжық екен.
Dialogue: 5,0:04:45.16,0:04:46.52,Default,,0,0,0,,Қандай сәнсіз...
Dialogue: 0,0:04:47.69,0:04:48.77,Default-ja,,0,0,0,,Төраға?
Dialogue: 5,0:04:47.74,0:04:48.77,Default,,0,0,0,,Төраға?
Dialogue: 5,0:04:48.77,0:04:50.27,Default,,0,0,0,,Owww...
Dialogue: 0,0:04:50.98,0:04:56.53,Default-ja,,0,0,0,,Мен жергілікті қолдау тобымен және демеушілермен таңға дейін ішіп жүрдім, енді ояндым...
Dialogue: 5,0:04:50.99,0:04:56.53,Default,,0,0,0,,Мен жергілікті қолдау тобымен және демеушілермен таңға дейін ішіп, енді ғана ояндым.
Dialogue: 5,0:04:56.86,0:05:00.09,Default,,0,0,0,,Мен тайфунға байланысты оқтын пойызының тоқтағанын естідім.
Dialogue: 0,0:04:56.86,0:05:00.12,Default-ja,,0,0,0,,Тайфунның кесірінен Шинкансеннің тоқтағанын естідім.
Dialogue: 5,0:05:00.09,0:05:01.39,Default,,0,0,0,,Қандай сәнсіз...
Dialogue: 0,0:05:00.24,0:05:03.29,Default-ja,,0,0,0,,Амансың ба? қазір қайдасың?
Dialogue: 5,0:05:01.39,0:05:03.39,Default,,0,0,0,,Қайдасың?
Dialogue: 5,0:05:03.39,0:05:04.81,Default,,0,0,0,,Сендай тілінде.
Dialogue: 0,0:05:03.41,0:05:07.04,Default-ja,,0,0,0,,Бұл Сендай. Көлік жүргізу жалғаспайтын сияқты.
Dialogue: 5,0:05:04.81,0:05:07.04,Default,,0,0,0,,Пойыз бүгін қайта жұмыс істемейтін сияқты.
Dialogue: 5,0:05:07.04,0:05:08.32,Default,,0,0,0,,Б... бір сызық
Dialogue: 0,0:05:07.21,0:05:09.04,Default-ja,,0,0,0,,Мен көремін...
Dialogue: 5,0:05:09.04,0:05:10.66,Default,,0,0,0,,Ято өліп бара жатыр!
Dialogue: 0,0:05:09.21,0:05:13.55,Default-ja,,0,0,0,,Сонымен біз бір Шинкансендеміз...
Dialogue: 5,0:05:10.66,0:05:13.16,Default,,0,0,0,,Сіз сияқты оқтын пойызында...
Dialogue: 0,0:05:13.71,0:05:16.17,Default-ja,,0,0,0,,Ах... бұл...
Dialogue: 5,0:05:14.30,0:05:16.17,Default,,0,0,0,,Хиёри, мұнда жақынлама.
Dialogue: 0,0:05:17.09,0:05:19.30,Default-ja,,0,0,0,,А, Соя-сан?
Dialogue: 5,0:05:18.01,0:05:19.30,Default,,0,0,0,,Соуяны айтасыз ба?
Dialogue: 0,0:05:19.89,0:05:22.30,Default-ja,,0,0,0,,Жарайды, мен қазір сенімен біргемін.
Dialogue: 5,0:05:19.90,0:05:21.08,Default,,0,0,0,,Оның жағдайы жақсы.
Dialogue: 5,0:05:21.08,0:05:22.31,Default,,0,0,0,,Мен қазір онымен біргемін.
Dialogue: 0,0:05:22.47,0:05:26.43,Default-ja,,0,0,0,,Ой... Түсіндім, мен сенімен біргемін.
Dialogue: 5,0:05:23.39,0:05:24.48,Default,,0,0,0,,Ято-сама, өтінемін, өз ізбасарларыңызға назар аударыңыз
Dialogue: 5,0:05:24.48,0:05:26.20,Default,,0,0,0,,Ол сенімен бірге ме?
Dialogue: 0,0:05:27.02,0:05:29.06,Default-ja,,0,0,0,,Қонатын жер таптың ба?
Dialogue: 5,0:05:27.05,0:05:29.06,Default,,0,0,0,,Сонымен, сіз қалатын жер таптыңыз ба?
Dialogue: 5,0:05:29.06,0:05:30.49,Default,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,0:05:29.23,0:05:33.82,Default-ja,,0,0,0,,Иә, Сендай станциясының жанындағы Morisen Inn қонақүйінде.
Dialogue: 5,0:05:30.49,0:05:33.82,Default,,0,0,0,,Бұл Сендай вокзалының жанындағы Сейсен қонақ үйі.
Dialogue: 0,0:05:33.98,0:05:37.07,Default-ja,,0,0,0,,Жақсы болар еді...және—
Dialogue: 5,0:05:34.12,0:05:35.84,Default,,0,0,0,,Тыңдау жақсы.
Dialogue: 5,0:05:35.84,0:05:39.70,Default,,0,0,0,,Егер сіз онымен бірге болсаңыз, онда...
Dialogue: 0,0:05:37.24,0:05:39.70,Default-ja,,0,0,0,,Сізбен бірге болу дегеніміз...
Dialogue: 0,0:05:40.95,0:05:42.20,Default-ja,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 5,0:05:40.96,0:05:42.20,Default,,0,0,0,,Оқу, оқу
Dialogue: 0,0:05:42.53,0:05:44.62,Default-ja,,0,0,0,,Сіз мені ести алмайсыз, солай ма?
Dialogue: 5,0:05:42.61,0:05:44.41,Default,,0,0,0,,Ол естімейді.
Dialogue: 0,0:05:54.84,0:05:56.84,titles,,0,0,0,,Ақ дауыл (4-бөлім) Жалғасы
Dialogue: 0,0:05:56.84,0:06:00.84,titles,,0,0,0,,Ақ дауыл (5-бөлім)
Dialogue: 0,0:05:59.68,0:06:00.84,Default-ja,,0,0,0,,Ум...
Dialogue: 5,0:05:59.69,0:06:00.84,Default,,0,0,0,,Олар дәл қашан осы үйдің бір бөлігіне айналды?
Dialogue: 0,0:06:01.43,0:06:03.10,Default-ja,,0,0,0,,Қашаннан бері?
Dialogue: 5,0:06:01.47,0:06:03.10,Default,,0,0,0,,Ол қашан басталды?
Dialogue: 0,0:06:03.26,0:06:07.72,Default-ja,,0,0,0,,А... дұрыс, ұзақ.
Dialogue: 5,0:06:04.68,0:06:06.08,Default,,0,0,0,,Көрейік.
Dialogue: 5,0:06:06.08,0:06:07.58,Default,,0,0,0,,Көп уақыт өтті.
Dialogue: 0,0:06:08.77,0:06:11.27,Default-ja,,0,0,0,,Шамамен 10 жыл бұрын
Dialogue: 5,0:06:08.79,0:06:11.34,Default,,0,0,0,,Он жылдан астам уақыт.
Dialogue: 5,0:06:11.34,0:06:12.86,Default,,0,0,0,,Жылдар бойы,
Dialogue: 0,0:06:11.40,0:06:12.86,Default-ja,,0,0,0,,Бұл көп уақыт болды
Dialogue: 0,0:06:13.02,0:06:16.94,Default-ja,,0,0,0,,«Мен естимін» және «ести алмаймын» арасында алға-артқа өту
Dialogue: 5,0:06:13.24,0:06:16.77,Default,,0,0,0,,Естетін кездер бар, естімейтін кездер болады.
Dialogue: 0,0:06:19.90,0:06:22.82,Default-ja,,0,0,0,,Дәрігерге барсаңыз да, себебін анықтау мүмкін емес.
Dialogue: 5,0:06:19.93,0:06:22.86,Default,,0,0,0,,Ол дәрігерлерге барды, бірақ олар себебін таба алмайды.
Dialogue: 5,0:06:22.86,0:06:26.62,Default,,0,0,0,,Стресс - олар қанша сынақтан өтсе де шығара алатын ең жақсы нәрсе.
Dialogue: 0,0:06:22.95,0:06:26.45,Default-ja,,0,0,0,,«Мен күйзеліске түстім» деп қайталай беремін және бұл туралы ештеңе істей алмаймын.
Dialogue: 0,0:06:28.70,0:06:31.25,Default-ja,,0,0,0,,Сол жігіт те.
Dialogue: 5,0:06:28.78,0:06:31.25,Default,,0,0,0,,Және ол кім болса,
Dialogue: 0,0:06:31.71,0:06:35.00,Default-ja,,0,0,0,,Басында мен де ауруханаға бардым.
Dialogue: 5,0:06:31.74,0:06:35.00,Default,,0,0,0,,алдымен дәрігерге үнемі баратын,
Dialogue: 0,0:06:35.17,0:06:39.55,Default-ja,,0,0,0,,Сіз «Тыныш және қиындық тудырмауы керек» сияқты сөздерді айта бастайсыз.
Dialogue: 5,0:06:35.31,0:06:39.43,Default,,0,0,0,,бірақ кейін ол үнсіздікке қарсы емес екенін айта бастады.
Dialogue: 5,0:06:40.01,0:06:41.76,Default,,0,0,0,,Мен сенің жаныңа дүрлігіп бара жатырмын, дірілдеп
Dialogue: 0,0:06:40.17,0:06:41.76,Default-ja,,0,0,0,,Бұл...
Dialogue: 0,0:06:42.13,0:06:44.85,Default-ja,,0,0,0,,Олай айтсаң да, қиналып қалмайсың, солай ма?
Dialogue: 5,0:06:42.17,0:06:44.85,Default,,0,0,0,,Бұлай айтса да, оған оңай бола алмайды.
Dialogue: 0,0:06:45.26,0:06:46.47,Default-ja,,0,0,0,,Өйткені...
Dialogue: 5,0:06:45.34,0:06:46.47,Default,,0,0,0,,9-эпизод
Dialogue: 0,0:06:47.60,0:06:50.98,Default-ja,,0,0,0,,«Адамдармен сөйлескенде, т.б.» деп айтуға тырыстым.
Dialogue: 5,0:06:47.63,0:06:50.98,Default,,0,0,0,,«Ол адамдармен сөйлескенде» деп бастадым.
Dialogue: 0,0:06:51.52,0:06:54.27,Default-ja,,0,0,0,,Мориоканың таңғы тұғыры ойға оралды.
Dialogue: 5,0:06:51.56,0:06:54.05,Default,,0,0,0,,бірақ мен бүгін таңертең Мориокада болған оқиға есіме түсті.
Dialogue: 0,0:06:57.27,0:07:00.49,Default-ja,,0,0,0,,Мен сенің басқа адамдармен көп араласқаныңды көрмедім.
Dialogue: 5,0:06:57.31,0:07:00.49,Default,,0,0,0,,Мен оның басқа адамдармен араласып жатқанын ешқашан көрген емеспін.
Dialogue: 0,0:07:01.61,0:07:04.41,Default-ja,,0,0,0,,Күлімсіреп, біреумен сөйлесу
Dialogue: 5,0:07:01.62,0:07:04.22,Default,,0,0,0,,Оның күліп, адамдармен сөйлескенін де көрмедім.
Dialogue: 0,0:07:04.87,0:07:09.41,Default-ja,,0,0,0,,Менің жадымдағы бұл адам әрқашан жалғыз.
Dialogue: 5,0:07:04.90,0:07:06.90,Default,,0,0,0,,Менің естеліктерімде,
Dialogue: 5,0:07:07.91,0:07:09.24,Default,,0,0,0,,ол әрқашан жалғыз.
Dialogue: 0,0:07:11.29,0:07:13.21,Default-ja,,0,0,0,,Бұл қашан болды?
Dialogue: 5,0:07:11.34,0:07:13.08,Default,,0,0,0,,Бұл қашан болды?
Dialogue: 5,0:07:13.58,0:07:15.50,Default,,0,0,0,,Бұл балалар турнирі болды.
Dialogue: 0,0:07:13.75,0:07:18.67,Default-ja,,0,0,0,,Балалар сайысында бірінші рет жеңіске жеткен бастауыш мектептің...
Dialogue: 5,0:07:15.81,0:07:18.57,Default,,0,0,0,,Бірінші рет бастауыш сыныптар бөлімінде жеңіске жеттім.
Dialogue: 0,0:07:20.42,0:07:21.76,Default-ja,,0,0,0,,Хмм. Нацу-кун, сен жақсы көрінесің.
Dialogue: 5,0:07:20.49,0:07:21.76,Default,,0,0,0,,Егер бұл дұрыс болса...
Dialogue: 0,0:07:22.34,0:07:24.43,Default-ja,,0,0,0,,Олай болса, сол кезде...
Dialogue: 5,0:07:22.39,0:07:24.27,Default,,0,0,0,,Егер бұл дұрыс болса, онда...
Dialogue: 0,0:07:25.76,0:07:27.05,Default-ja,,0,0,0,,Қазірдің өзінде...
Dialogue: 5,0:07:25.81,0:07:26.69,Default,,0,0,0,,ол қазірдің өзінде...
Dialogue: 0,0:07:29.39,0:07:31.10,Default-ja,,0,0,0,,Мм... бұл туралы...
Dialogue: 5,0:07:29.43,0:07:31.22,Default,,0,0,0,,Ум, басқа біреу бар ма...
Dialogue: 5,0:07:31.22,0:07:35.52,Default,,0,0,0,,Иә, оған қарсы көп ойнайтын адамдар.
Dialogue: 0,0:07:31.23,0:07:35.52,Default-ja,,0,0,0,,Аа, ойында мен жиі жеңетін жігіт.
Dialogue: 0,0:07:35.98,0:07:38.44,Default-ja,,0,0,0,,...Бірақ Сояға жолығатын жігіт ше?
Dialogue: 5,0:07:36.00,0:07:43.03,Default,,0,0,0,,Айтуынша, оған тек титулдық матчтардағы қарсыластар ғана қарсы шығады.
Dialogue: 0,0:07:38.57,0:07:42.95,Default-ja,,0,0,0,,Титулдық матчта тікелей жеңе алатын жалғыз үміткер...
Dialogue: 5,0:07:43.03,0:07:45.66,Default,,0,0,0,,Бұл аз ғана адам қалдырады.
Dialogue: 0,0:07:43.20,0:07:45.66,Default-ja,,0,0,0,,Онша көп емес.
Dialogue: 5,0:07:46.91,0:07:50.41,Default,,0,0,0,,Ол әсіресе жасыруға тырыспады,
Dialogue: 0,0:07:47.07,0:07:50.41,Default-ja,,0,0,0,,Жарайды, олардың мұны жасыру ниеті жоқ сияқты.
Dialogue: 5,0:07:50.41,0:07:54.79,Default,,0,0,0,,бірақ оның кейбір кемшіліктері бар, сондықтан мен оған бұл туралы үндемей тұруын айтқанда...
Dialogue: 0,0:07:50.58,0:07:54.79,Default-ja,,0,0,0,,Кемшіліктері бар, сондықтан аузыңды жаппа дедім...
Dialogue: 0,0:07:54.96,0:07:57.88,Default-ja,,0,0,0,,Кері санаққа дейін аяқтауым керек пе?
Dialogue: 5,0:07:55.16,0:07:57.70,Default,,0,0,0,,Мен тек кері санаққа дейін матчты аяқтауым керек, солай ма?
Dialogue: 0,0:07:59.63,0:08:01.42,Default-ja,,0,0,0,,Арнайы проблема жоқ па?
Dialogue: 5,0:07:59.67,0:08:01.88,Default,,0,0,0,,Ешқандай қиындық туындамауы керек емес пе?
Dialogue: 0,0:08:01.55,0:08:03.30,Default-ja,,0,0,0,,... немесе сол сияқты нәрсе.
Dialogue: 5,0:08:01.88,0:08:03.30,Default,,0,0,0,,...оның жауабы осылай болды.
Dialogue: 0,0:08:03.80,0:08:07.93,Default-ja,,0,0,0,,Ей... Мен сені уайымдаймын, бірақ мен соншалықты алаңсызмын.
Dialogue: 5,0:08:03.82,0:08:08.04,Default,,0,0,0,,Ей, мен осыған байланысты өзімді байлап жатырмын, бірақ оның дүниеде қамқорлығы жоқ.
Dialogue: 5,0:08:08.04,0:08:12.64,Default,,0,0,0,,Айтайын дегенім, ол әрқашан осындай адам болған.
Dialogue: 0,0:08:08.05,0:08:09.05,Default-ja,,0,0,0,,Адамның өзі-
Dialogue: 0,0:08:09.22,0:08:12.60,Default-ja,,0,0,0,,Ол көптен бері солай.
Dialogue: 5,0:08:12.64,0:08:15.26,Default,,0,0,0,,Сонымен, ол үйлесімсіз нәрсені айтса да,
Dialogue: 0,0:08:12.72,0:08:15.19,Default-ja,,0,0,0,,Мен шектен шыққан нәрсе айтсам да,
Dialogue: 5,0:08:14.31,0:08:15.79,Default,,0,0,0,,Кешіріңіз!
Dialogue: 5,0:08:15.26,0:08:20.51,Default,,0,0,0,,адамдар оны сырғып жіберді, өйткені ол бұрын да солай болған.
Dialogue: 0,0:08:15.31,0:08:20.61,Default-ja,,0,0,0,,Алғашында солай болды, сондықтан мен одан біраз құтылдым.
Dialogue: 5,0:08:15.79,0:08:17.43,Default,,0,0,0,,Жоқ! Сіздің костюміңіз!
Dialogue: 0,0:08:21.86,0:08:24.99,Default-ja,,0,0,0,,Ал, сәлемдесу және ойынға дейін және ойыннан кейінгі сұрақтар...
Dialogue: 5,0:08:21.91,0:08:29.69,Default,,0,0,0,,Қабылдау мен сұрақ-жауапқа матчқа дейін және кейін келетін болсақ, олар реті мен мазмұны жағынан ұқсас.
Dialogue: 0,0:08:25.40,0:08:29.58,Default-ja,,0,0,0,,Тәртібі мен мазмұны әдетте ұқсас.
Dialogue: 5,0:08:29.69,0:08:33.25,Default,,0,0,0,,Бір қызығы, ол шогиде жақсырақ болған сайын,
Dialogue: 0,0:08:29.70,0:08:33.25,Default-ja,,0,0,0,,Ирония, шоги жын сияқты күшті болса ғой...
Dialogue: 0,0:08:33.41,0:08:36.29,Default-ja,,0,0,0,,Кішкене ақылсыз болып көрінсе де—
Dialogue: 5,0:08:33.62,0:08:36.25,Default,,0,0,0,,адамдар оған сәл есінен танып қалғандай қарады,
Dialogue: 0,0:08:36.46,0:08:39.25,Default-ja,,0,0,0,,Керісінше, айналамдағы адамдар: «Данышпан күткендей» дейді.
Dialogue: 5,0:08:36.65,0:08:43.88,Default,,0,0,0,,, бірақ олар оны данышпанның эксцентриктілігімен түсіндіреді, тіпті өздерінің қате түсінігімен көңіл көтеретін еді.
Dialogue: 0,0:08:39.42,0:08:43.71,Default-ja,,0,0,0,,Өзіңізше түсіндіріп, толқыңыз.
Dialogue: 5,0:08:44.50,0:08:50.39,Default,,0,0,0,,Егер ол қазір өз бөлмесінде болса, таңға дейін ұйықтайтынына сенімдімін.
Dialogue: 0,0:08:44.51,0:08:47.01,Default-ja,,0,0,0,,Егер сіз бөлмеде болсаңыз...
Dialogue: 0,0:08:47.18,0:08:50.39,Default-ja,,0,0,0,,Таң атқанша ұйықтауы керек.
Dialogue: 0,0:08:56.60,0:08:58.98,Default-ja,,0,0,0,,Енді оны жайына қалдырған дұрыс.
Dialogue: 5,0:08:56.62,0:08:58.80,Default,,0,0,0,,Оны жалғыз қалдырсаңыз, ол жақсы болады.
Dialogue: 0,0:08:59.94,0:09:02.40,Default-ja,,0,0,0,,Бірақ шынымды айтсам, мен құтқарылдым.
Dialogue: 5,0:09:00.00,0:09:02.51,Default,,0,0,0,,Бірақ шынымды айтсам үлкен көмек болдыңыз.
Dialogue: 5,0:09:02.51,0:09:07.53,Default,,0,0,0,,Мен оның жаңбырда қонақүй іздеп жүргеніне қатты қобалжыдым.
Dialogue: 0,0:09:02.52,0:09:05.94,Default-ja,,0,0,0,,Мен сізді осы жаңбырда қонақүй іздеп жүрген шығар деп ойладым.
Dialogue: 0,0:09:06.07,0:09:07.65,Default-ja,,0,0,0,,Мен қорқатынмын.
Dialogue: 0,0:09:08.36,0:09:13.04,Default-ja,,0,0,0,,Осыдан кейін жақын арада гиокушо шайқасының жетінші ойыны өтеді.
Dialogue: 5,0:09:08.41,0:09:13.04,Default,,0,0,0,,Дәл осыдан кейін ол Король турнирінде ең үздік жеті ұпайға ие болды.
Dialogue: 0,0:09:13.54,0:09:16.79,Default-ja,,0,0,0,,Оны алғаныңызға өте қуаныштымын.
Dialogue: 5,0:09:13.56,0:09:16.79,Default,,0,0,0,,Сонымен, сен оны өзіңмен бірге алып жүрген құдайдың сыйы болдың.
Dialogue: 0,0:09:19.96,0:09:24.13,Default-ja,,0,0,0,,Бірақ Кирияма: Мен бұл туралы Киотода бұрын ойладым.
Dialogue: 5,0:09:20.11,0:09:22.11,Default,,0,0,0,,Бірақ тыңда, Кирияма.
Dialogue: 5,0:09:22.11,0:09:24.24,Default,,0,0,0,,Мен мұны Киотода да ойладым.
Dialogue: 5,0:09:24.24,0:09:25.55,Default,,0,0,0,,Шимада сияқты.
Dialogue: 0,0:09:24.25,0:09:25.55,Default-ja,,0,0,0,,Кинкиса Шимада
Dialogue: 0,0:09:26.26,0:09:29.59,Default-ja,,0,0,0,,Сіз шынымен қамқор жігітсіз.
Dialogue: 5,0:09:26.27,0:09:29.69,Default,,0,0,0,,Сіз — қалай айтсам болады — адамдарға қарауға өте шебер едіңіз.
Dialogue: 5,0:09:29.69,0:09:31.36,Default,,0,0,0,,Сіз шынымен де заманауи баласыз ба?
Dialogue: 0,0:09:29.72,0:09:31.30,Default-ja,,0,0,0,,Сіз шынымен қазіргі баласыз ба?
Dialogue: 5,0:09:31.36,0:09:34.08,Default,,0,0,0,,Сен бізге 90-шы жылдары туылғансың деп өтірік айттың ба?
Dialogue: 0,0:09:31.43,0:09:33.97,Default-ja,,0,0,0,,Хейсэй дәуірінде дүниеге келгені рас емес пе?
Dialogue: 5,0:09:34.08,0:09:37.51,Default,,0,0,0,,Сіз шынымен де іштей мінсіз орта жастағы ана екеніңізге сенімдімін.
Dialogue: 0,0:09:34.10,0:09:37.39,Default-ja,,0,0,0,,Ол шынымен де іштей қамқор кемпір емес пе?
Dialogue: 5,0:09:37.51,0:09:39.06,Default,,0,0,0,,Менің жасым 18-де.
Dialogue: 0,0:09:37.52,0:09:39.06,Default-ja,,0,0,0,,18...
Dialogue: 5,0:09:42.32,0:09:45.82,Default,,0,0,0,,Және тағы бір нәрсе. Бұл қызықты матч болды.
Dialogue: 0,0:09:42.48,0:09:45.73,Default-ja,,0,0,0,,Өйткені, бұл қызықты ойын болды.
Dialogue: 5,0:09:45.82,0:09:50.45,Default,,0,0,0,,Соуя екеуің бір-біріңді қалыпты, бір-біріңді түсінетін болдыңдар.
Dialogue: 0,0:09:45.86,0:09:50.45,Default-ja,,0,0,0,,Соя екеуің қалыпты сөйлесе аласыңдар.
Dialogue: 0,0:09:57.62,0:09:59.67,Default-ja,,0,0,0,,Мен күлдім.
Dialogue: 5,0:09:57.64,0:09:59.37,Default,,0,0,0,,Ол күлді.
Dialogue: 0,0:10:05.21,0:10:09.30,Default-ja,,0,0,0,,Келесі күні таңертең оянсам, тайфун өтіп кеткен...
Dialogue: 5,0:10:05.25,0:10:09.30,Default,,0,0,0,,Келесі күні таңертең оянсам, тайфун өтіп кетіпті.
Dialogue: 0,0:10:10.97,0:10:13.80,Default-ja,,0,0,0,,Не? Мм... бухгалтерлік есеп...
Dialogue: 5,0:10:11.15,0:10:11.80,Default,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 5,0:10:11.80,0:10:13.81,Default,,0,0,0,,Ум, менің шотым ше?
Dialogue: 5,0:10:13.81,0:10:19.27,Default,,0,0,0,,Сізбен бірге келген адам, Суя мырза, сіздің тұруыңыз үшін ақша төледі.
Dialogue: 0,0:10:13.97,0:10:15.43,Default-ja,,0,0,0,,Тұру құны –
Dialogue: 0,0:10:15.56,0:10:19.43,Default-ja,,0,0,0,,Бізбен бірге келген Соя мырза есепшотты төледі.
Dialogue: 0,0:10:24.61,0:10:26.32,Default-ja,,0,0,0,,Сыртқа шыққанда...
Dialogue: 5,0:10:24.66,0:10:26.09,Default,,0,0,0,,Мен далаға шыққанда,
Dialogue: 0,0:10:29.24,0:10:31.15,Default-ja,,0,0,0,,Сендайдың аспаны...
Dialogue: 5,0:10:29.28,0:10:37.80,Default,,0,0,0,,Сендайдың аспаны бала салған дәу кенепке ұқсайтын, жасанды көрінетін кең көк түсті.
Dialogue: 0,0:10:32.57,0:10:37.95,Default-ja,,0,0,0,,Аспан бала оны бояумен бояғандай кездейсоқ көгілдір болды.
Dialogue: 0,0:10:45.25,0:10:47.80,Default-ja,,0,0,0,,Шындық сезімі мүлде болмады.
Dialogue: 5,0:10:45.27,0:10:47.80,Default,,0,0,0,,Бұл мүлдем шынайы емес еді.
Dialogue: 0,0:10:48.55,0:10:55.10,Default-ja,,0,0,0,,Кешегі әлгі дауылды түс көргендей алыстан көрінді.
Dialogue: 5,0:10:48.61,0:10:54.89,Default,,0,0,0,,Кешегі боран түсінде болғандай алыста көрінді.
Dialogue: 0,0:10:59.93,0:11:04.94,Default-ja,,0,0,0,,Біз сол жаңбырда бірге жүрдік...
Dialogue: 5,0:10:59.95,0:11:04.94,Default,,0,0,0,,Екеуміз жаңбырда бірге жүргенімізге сенімдімін.
Dialogue: 0,0:11:12.11,0:11:15.95,Default-ja,,0,0,0,,Сол күні мен үшінші кезеңнен сабаққа бардым.
Dialogue: 5,0:11:12.14,0:11:15.79,Default,,0,0,0,,Мен сол күні үшінші кезеңнен бастап мектепке бардым,
Dialogue: 0,0:11:16.78,0:11:22.58,Default-ja,,0,0,0,,Шаршағандықтан шығар, бірақ сыныптағы дауыстар мен сыныптағы әбігер...
Dialogue: 5,0:11:16.81,0:11:22.58,Default,,0,0,0,,шаршағандықтан болар, бірақ мұғалімнің дауысы мен әдеттегі сыныптағы әбігер
Dialogue: 0,0:11:22.91,0:11:27.59,Default-ja,,0,0,0,,Ол соншалықты бұлыңғыр және алыс болды, мен оны толық анықтай алмадым.
Dialogue: 5,0:11:22.96,0:11:27.59,Default,,0,0,0,,анық емес сияқты көрінді, сондықтан ол маған өте алмады.
Dialogue: 0,0:11:34.05,0:11:35.18,Default-ja,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 5,0:11:34.08,0:11:35.18,Default,,0,0,0,,Дегенмен,
Dialogue: 0,0:11:39.01,0:11:42.39,Default-ja,,0,0,0,,Сол жерде мен естіген жалғыз дыбыс...
Dialogue: 5,0:11:39.04,0:11:42.39,Default,,0,0,0,,сол сіріңкенің бөліктерінің дыбысы...
Dialogue: 0,0:11:49.36,0:11:50.44,Default-ja,,0,0,0,,Мен жай ғана...
Dialogue: 5,0:11:49.38,0:11:50.44,Default,,0,0,0,,миымда шырылдады...
Dialogue: 0,0:11:52.94,0:11:54.61,Default-ja,,0,0,0,,Қоңырауын тоқтатпайды...
Dialogue: 5,0:11:52.99,0:11:54.46,Default,,0,0,0,,және кетпейді.
Dialogue: 0,0:11:58.20,0:12:00.33,signs,,0,0,0,,Шоги залы
Dialogue: 0,0:12:00.33,0:12:02.33,signs,,0,0,0,,Шоги Холл\h\h
Dialogue: 1,0:12:00.33,0:12:02.33,signs,,0,0,0,,Шоги Холл\h\h
Dialogue: 0,0:12:04.25,0:12:06.00,Default-ja,,0,0,0,,А... (Шигета) Иә?
Dialogue: 0,0:12:06.58,0:12:10.63,Default-ja,,0,0,0,,Йо Кирияма, бұл қатты тайфун болған сияқты.
Dialogue: 5,0:12:06.61,0:12:07.98,Default,,0,0,0,,Сәлем, Кирияма.
Dialogue: 5,0:12:07.98,0:12:10.43,Default,,0,0,0,,Мен бұл тайфунның сіз үшін қаншалықты ауыр болғанын естідім.
Dialogue: 0,0:12:14.13,0:12:15.26,Default-ja,,0,0,0,,Кирияма?
Dialogue: 5,0:12:14.15,0:12:15.26,Default,,0,0,0,,Кирияма?
Dialogue: 0,0:12:16.68,0:12:18.93,Default-ja,,0,0,0,,Не? Ессіз күйде
Dialogue: 5,0:12:16.81,0:12:17.78,Default,,0,0,0,,Оған не болды?
Dialogue: 5,0:12:17.78,0:12:19.05,Default,,0,0,0,,Ол аң-таң.
Dialogue: 5,0:12:19.05,0:12:22.55,Default,,0,0,0,,Шаршаған шығар, қайтып келген соң бірден мектепке барады.
Dialogue: 0,0:12:19.05,0:12:22.43,Default-ja,,0,0,0,,Сендейден мектептен шаршаған шығарсың.
Dialogue: 5,0:12:22.55,0:12:25.37,Default,,0,0,0,,Білесіз бе, оның П.Е.
Dialogue: 0,0:12:22.56,0:12:25.27,Default-ja,,0,0,0,,Мектепте, қараңыздаршы, дене шынықтыру сабағы бар.
Dialogue: 5,0:12:25.37,0:12:27.02,Default,,0,0,0,,Бұл энергияны алады.
Dialogue: 0,0:12:25.39,0:12:27.02,Default-ja,,0,0,0,,Сізге физикалық күш қажет.
Dialogue: 0,0:12:27.02,0:12:28.90,signs,,0,0,0,,Кеңсе
Dialogue: 1,0:12:27.02,0:12:28.90,signs,,0,0,0,,Кеңсе
Dialogue: 0,0:12:50.59,0:12:51.96,Default-ja,,0,0,0,,Мен жай ғана...
Dialogue: 5,0:12:50.59,0:12:52.09,Default,,0,0,0,,Мен жай ғана...
Dialogue: 0,0:12:52.88,0:12:54.76,Default-ja,,0,0,0,,Мәңгі, мәңгі...
Dialogue: 5,0:12:52.93,0:12:54.51,Default,,0,0,0,,бұл дыбысты алыңыз...
Dialogue: 5,0:12:56.32,0:12:57.80,Default,,0,0,0,,менің басымнан шықты.
Dialogue: 0,0:12:56.34,0:12:58.01,Default-ja,,0,0,0,,…
Dialogue: 0,0:13:00.97,0:13:02.98,titles,,0,0,0,,Ақ дауыл (5-бөлім)
Dialogue: 0,0:13:02.98,0:13:06.98,titles,,0,0,0,,Қайта іске қосу
Dialogue: 0,0:13:08.60,0:13:09.98,Default-ja,,0,0,0,,Үлкен әпке
Dialogue: 5,0:13:08.64,0:13:09.98,Default,,0,0,0,,апа,
Dialogue: 5,0:13:09.98,0:13:14.24,Default,,0,0,0,,Кирияма бүгін де келе алмайтынын айтады, өйткені ол ертеңгі матчқа дайындалуы керек.
Dialogue: 0,0:13:10.15,0:13:14.23,Default-ja,,0,0,0,,Кирияма-кун, сен бүгін келе алмайсың, себебі ертеңгі ойынға дайындық бар.
Dialogue: 0,0:13:12.36,0:13:14.24,signs,,0,0,0,,Кіріс жәшігі
Dialogue: 1,0:13:12.36,0:13:14.24,signs,,0,0,0,,Кіріс жәшігі
Dialogue: 0,0:13:12.36,0:13:14.24,signs,,0,0,0,,Кирияма Рей
Dialogue: 1,0:13:12.36,0:13:14.24,signs,,0,0,0,,Кирияма Рей
Dialogue: 0,0:13:12.36,0:13:14.24,signs,,0,0,0,,Шақырғаныңызға рахмет
Dialogue: 1,0:13:12.36,0:13:14.24,signs,,0,0,0,,Шақырғаныңызға рахмет
Dialogue: 0,0:13:12.36,0:13:14.24,signs,,0,0,0,,Мен ертеңгі матчқа дайындалуым керек, сондықтан бүгін келе алмаймын.
Dialogue: 1,0:13:12.36,0:13:14.24,signs,,0,0,0,,Мен ертеңгі матчқа дайындалуым керек, сондықтан бүгін келе алмаймын.
Dialogue: 0,0:13:14.65,0:13:15.86,Default-ja,,0,0,0,,Міне, ұят!
Dialogue: 5,0:13:14.68,0:13:15.86,Default,,0,0,0,,О, бұл өте жаман.
Dialogue: 0,0:13:16.03,0:13:19.45,Default-ja,,0,0,0,,Какуни сонша қою қайнаса да?
Dialogue: 5,0:13:16.16,0:13:19.45,Default,,0,0,0,,Бұл қуырылған шошқа еті шынымен жұмсақ болғанымен бе?
Dialogue: 0,0:13:19.61,0:13:22.24,Default-ja,,0,0,0,,—
Dialogue: 5,0:13:19.75,0:13:20.41,Default,,0,0,0,,(Тик-так, сағаттың көрсеткіштері тик-так)
Dialogue: 5,0:13:20.71,0:13:26.70,Default,,0,0,0,,Менің мамандығым жұмсақ пісірілген жұмыртқа шошқа етінің тұзды-тәтті соусына малынған болса да?
Dialogue: 0,0:13:22.37,0:13:24.29,Default-ja,,0,0,0,,Қанша тәтті және тұзды пісірілген соус.
Dialogue: 0,0:13:24.41,0:13:27.37,Default-ja,,0,0,0,,Ол дақтармен жабылған болса да?
