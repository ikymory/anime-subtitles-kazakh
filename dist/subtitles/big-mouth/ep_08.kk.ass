Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.00,0:00:08.29,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:08.55,0:00:09.00,Default,,0,0,0,,«Томның тигелі»
Dialogue: 0,0:00:09.00,0:00:10.01,Default,,0,0,0,,«Томның тигелі»
Dialogue: 0,0:00:09.00,0:00:10.01,Default,,0,0,0,,Том Круз!
Dialogue: 0,0:00:10.09,0:00:12.13,Default,,0,0,0,,Саентология – культ
Dialogue: 0,0:00:12.22,0:00:16.30,Default,,0,0,0,,Бірақ тамаша оңалту құралдары бар.
Dialogue: 0,0:00:16.39,0:00:17.72,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:00:17.80,0:00:20.06,Default,,0,0,0,,Том неге «балқыту қазанында»?
Dialogue: 0,0:00:20.14,0:00:22.02,Default,,0,0,0,,Не деген әңгімеші!
Dialogue: 0,0:00:22.10,0:00:24.73,Default,,0,0,0,,Мен сені әйелім етіп қателестім.
Dialogue: 0,0:00:24.81,0:00:27.98,Default,,0,0,0,,Өйткені бұл театрды культ салған.
Dialogue: 0,0:00:28.06,0:00:30.23,Default,,0,0,0,,Өткен жылы бұл Траволта болды.
Dialogue: 0,0:00:30.32,0:00:34.49,Default,,0,0,0,,Бұл бақсы аңы, жоқ, қателескен аң.
Dialogue: 0,0:00:34.57,0:00:38.58,Default,,0,0,0,,Маған бұл культке мүше болудан бас тартылды.
Dialogue: 0,0:00:38.66,0:00:41.12,Default,,0,0,0,,Қолыңды ұстай аламын ба?
Dialogue: 0,0:00:42.12,0:00:43.87,Default,,0,0,0,,«Қазір не істеп жатырсың?»
Dialogue: 0,0:00:43.96,0:00:46.96,Default,,0,0,0,,«Джунгли суында өседі және өте сасық»
Dialogue: 0,0:00:47.25,0:00:47.96,Default,,0,0,0,,«Түргенде іштің ауыруы неден туындайды?»
Dialogue: 0,0:00:47.96,0:00:49.29,Default,,0,0,0,,«Түргенде іштің ауыруы неден туындайды?»
Dialogue: 0,0:00:47.96,0:00:49.29,Default,,0,0,0,,``Мен Миссимен біргемін''
Dialogue: 0,0:00:49.29,0:00:49.88,Default,,0,0,0,,«Түргенде іштің ауыруы неден туындайды?»
Dialogue: 0,0:00:49.96,0:00:52.26,Default,,0,0,0,,Бұл Helicobacter pylori.
Dialogue: 0,0:00:52.34,0:00:54.42,Default,,0,0,0,,Гастрит ауруын тудырады
Dialogue: 0,0:00:54.51,0:00:57.68,Default,,0,0,0,,Эндрю микробтар бойынша викториналарды жақсы біледі.
Dialogue: 0,0:00:57.76,0:01:00.51,Default,,0,0,0,,Соңғы кездері ерекше қуанып жүрмін.
Dialogue: 0,0:01:01.93,0:01:04.10,Default,,0,0,0,,Сен менің қолымды ұстадың.
Dialogue: 0,0:01:04.18,0:01:08.06,Default,,0,0,0,,Сіздің ата-анаңыз жыныстық қатынасқа түскен кезде жыныстық қатынасқа түсуіңіз мүмкін бе?
Dialogue: 0,0:01:08.15,0:01:09.36,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:01:10.48,0:01:11.90,Default,,0,0,0,,«Кирсти аллеясы театры»
Dialogue: 0,0:01:12.57,0:01:13.78,Default,,0,0,0,,Сәлем, бұл Ник.
Dialogue: 0,0:01:13.86,0:01:14.90,Default,,0,0,0,,Мен Даниелмін
Dialogue: 0,0:01:14.99,0:01:17.45,Default,,0,0,0,,Томның өнері тамаша болды.
Dialogue: 0,0:01:17.53,0:01:18.20,Default,,0,0,0,,Сәлем
Dialogue: 0,0:01:18.28,0:01:21.62,Default,,0,0,0,,Том әйелдермен танысуға тырысады.
Dialogue: 0,0:01:22.45,0:01:24.66,Default,,0,0,0,,Сіз қауесет Никсіз.
Dialogue: 0,0:01:24.75,0:01:27.25,Default,,0,0,0,,Лияның Инстаграмында көрген
Dialogue: 0,0:01:27.33,0:01:30.29,Default,,0,0,0,,Ол шұжық болып киінді.
Dialogue: 0,0:01:30.38,0:01:32.13,Default,,0,0,0,,Бұл Wiener орамы.
Dialogue: 0,0:01:32.21,0:01:34.05,Default,,0,0,0,,Маған винер ұнайды
Dialogue: 0,0:01:34.13,0:01:35.30,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:01:35.38,0:01:36.67,Default,,0,0,0,,Дәмдеуіштер ше?
Dialogue: 0,0:01:36.76,0:01:37.76,Default,,0,0,0,,Кетчуп желдеткіші
Dialogue: 0,0:01:38.09,0:01:39.39,Default,,0,0,0,,Ғашық болсақ тамаша болар еді
Dialogue: 0,0:01:39.47,0:01:40.35,Default,,0,0,0,,Өте жаман
Dialogue: 0,0:01:40.43,0:01:41.30,Default,,0,0,0,,Иә.
Dialogue: 0,0:01:41.60,0:01:42.43,Default,,0,0,0,,Ник мен үйге бара жатырмын
Dialogue: 0,0:01:42.51,0:01:44.60,Default,,0,0,0,,Іске қосу сіздің үйіңізде.
Dialogue: 0,0:01:44.68,0:01:45.31,Default,,0,0,0,,Ал енді Пенбардан келген соңғы видео бар.
Dialogue: 0,0:01:46.48,0:01:48.23,Default,,0,0,0,,Ата-анаңыз жоқ кезде той жасайсыз ба?
Dialogue: 0,0:01:48.31,0:01:50.98,Default,,0,0,0,,Мен, сен Эндрюдің үйісің.
Dialogue: 0,0:01:51.82,0:01:54.03,Default,,0,0,0,,Себебі ол кездесуде
Dialogue: 0,0:01:54.11,0:01:56.03,Default,,0,0,0,,Мен жоғары сынып оқушыларымен кеш өткіземін
Dialogue: 0,0:01:56.11,0:01:58.24,Default,,0,0,0,,Сіз де қатысасыз ба?
Dialogue: 0,0:02:02.24,0:02:03.54,Default,,0,0,0,,Сәтсіз
Dialogue: 0,0:02:03.95,0:02:04.87,Default,,0,0,0,,Кездескенше, Таллула
Dialogue: 0,0:02:04.95,0:02:05.91,Default,,0,0,0,,Таллула?
Dialogue: 0,0:02:06.00,0:02:08.33,Default,,0,0,0,,Ол Таллула ма?
Dialogue: 0,0:02:08.41,0:02:09.25,Default,,0,0,0,,Күлдірмеңіз
Dialogue: 0,0:02:09.33,0:02:11.54,Default,,0,0,0,,Мен күліп тұрған жоқпын
Dialogue: 0,0:02:11.92,0:02:14.30,Default,,0,0,0,,Таллула!
Dialogue: 0,0:02:14.50,0:02:15.51,Default,,0,0,0,,Мазарлардағы барлық ескі суреттер
Dialogue: 0,0:02:15.59,0:02:17.59,Default,,0,0,0,,Қиындыққа тап болдым, қайта алмаймын
Dialogue: 0,0:02:17.67,0:02:18.63,Default,,0,0,0,,Кәсібі: тыңшы
Dialogue: 0,0:02:53.38,0:02:56.00,Default,,0,0,0,,Сізде печенье торты бар ма?
Dialogue: 0,0:02:56.09,0:02:57.34,Default,,0,0,0,,Доритос туралы не деуге болады?
Dialogue: 0,0:02:57.42,0:02:59.09,Default,,0,0,0,,Сен бала емессің бе?
Dialogue: 0,0:02:59.17,0:03:01.47,Default,,0,0,0,,Жоғары сынып оқушылары салқын әрекет етеді
Dialogue: 0,0:03:01.55,0:03:03.26,Default,,0,0,0,,Салқын болыңыз
Dialogue: 0,0:03:03.34,0:03:04.39,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:03:04.47,0:03:06.14,Default,,0,0,0,,Бұл әйелдерге арналған.
Dialogue: 0,0:03:06.22,0:03:07.02,Default,,0,0,0,,Әкемдікі
Dialogue: 0,0:03:07.10,0:03:08.52,Default,,0,0,0,,Иә, оны әкем пайдаланады.
Dialogue: 0,0:03:08.60,0:03:09.14,Default,,0,0,0,,(Роко) Иә, әрине. Мұнда өте жайлы екен.
Dialogue: 0,0:03:09.23,0:03:10.18,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:03:10.27,0:03:13.94,Default,,0,0,0,,Драма үйірмесіндегі балалардың барлығы зерек.
Dialogue: 0,0:03:14.02,0:03:15.94,Default,,0,0,0,,Мысалы, Даниел
Dialogue: 0,0:03:16.02,0:03:19.28,Default,,0,0,0,,Лия Даниелді жақсы көреді.
Dialogue: 0,0:03:19.36,0:03:20.86,Default,,0,0,0,,Мен сенің тамағыңды кесемін
Dialogue: 0,0:03:20.95,0:03:22.78,Default,,0,0,0,,Бұл жақсы қауіп.
Dialogue: 0,0:03:22.86,0:03:26.37,Default,,0,0,0,,Мен боқтық драма үйірмесіне шарап әкелдім.
Dialogue: 0,0:03:26.45,0:03:27.54,Default,,0,0,0,,Виски алыңыз
Dialogue: 0,0:03:27.62,0:03:28.83,Default,,0,0,0,,Көбінесе ұнамды
Dialogue: 0,0:03:28.91,0:03:30.37,Default,,0,0,0,,Рахмет сізге Джуд
Dialogue: 0,0:03:30.46,0:03:31.00,Default,,0,0,0,,Алкоголь?
Dialogue: 0,0:03:31.08,0:03:33.46,Default,,0,0,0,,Мен 16 жастамын, бұл шарап.
Dialogue: 0,0:03:33.54,0:03:36.13,Default,,0,0,0,,Көрдім, сосын мен де ішемін.
Dialogue: 0,0:03:36.21,0:03:37.71,Default,,0,0,0,,Табиғи материал қоры
Dialogue: 0,0:03:37.80,0:03:39.21,Default,,0,0,0,,Табиғат – сен
Dialogue: 0,0:03:39.30,0:03:40.84,Default,,0,0,0,,Мен бәрін естимін
Dialogue: 0,0:03:40.92,0:03:42.59,Default,,0,0,0,,Сіз алмайсыз.
Dialogue: 0,0:03:42.68,0:03:43.59,Default,,0,0,0,,Мүлдем жоқ
Dialogue: 0,0:03:43.68,0:03:47.01,Default,,0,0,0,,Айтушы ағаң болғанымды қалайсың ба?
Dialogue: 0,0:03:47.10,0:03:48.60,Default,,0,0,0,,Бұл жаман, солай ма?
Dialogue: 0,0:03:48.68,0:03:50.35,Default,,0,0,0,,Олай болса, сәл ғана.
Dialogue: 0,0:03:50.43,0:03:52.81,Default,,0,0,0,,Ник – «кішкентай дик»
Dialogue: 0,0:03:53.35,0:03:53.90,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:03:53.98,0:03:54.73,Default,,0,0,0,,Қабырғада құлақтар бар
Dialogue: 0,0:03:56.48,0:03:59.86,Default,,0,0,0,,Бұл үй. Бұл үйден басқа ештеңе емес.
Dialogue: 0,0:03:59.94,0:04:02.57,Default,,0,0,0,,Иә, бұл жай ғана үй.
Dialogue: 0,0:04:02.65,0:04:04.36,Default,,0,0,0,,О, міне сен.
Dialogue: 0,0:04:04.45,0:04:05.07,Default,,0,0,0,,Таллула
Dialogue: 0,0:04:05.16,0:04:06.16,Default,,0,0,0,,Ник Берч
Dialogue: 0,0:04:08.91,0:04:10.95,Default,,0,0,0,,Мен Эндрюмін
Dialogue: 0,0:04:11.04,0:04:14.79,Default,,0,0,0,,Екеуің жыныстық қатынасқа түскенде мен де қызымның қасында болдым...
Dialogue: 0,0:04:14.87,0:04:17.21,Default,,0,0,0,,Бұл табиғи емес.
Dialogue: 0,0:04:17.29,0:04:19.00,Default,,0,0,0,,Неліктен өзіңізді таныстыруыңыз керек?
Dialogue: 0,0:04:19.34,0:04:19.88,Default,,0,0,0,,Ник
Dialogue: 0,0:04:19.96,0:04:24.01,Default,,0,0,0,,Мен қазір жоғары сынып оқушысын кешке алып бара жатырмын.
Dialogue: 0,0:04:24.09,0:04:24.80,Default,,0,0,0,,Жүр.
Dialogue: 0,0:04:24.88,0:04:27.76,Default,,0,0,0,,Орта мектептегі кешке барайық
Dialogue: 0,0:04:27.85,0:04:30.93,Default,,0,0,0,,Бірақ бұл қазір Миссидің үйі.
Dialogue: 0,0:04:31.02,0:04:33.98,Default,,0,0,0,,Анам жерба ​​мате шай қайнатып жатыр.
Dialogue: 0,0:04:34.06,0:04:35.65,Default,,0,0,0,,Ата-анаңа не болды?
Dialogue: 0,0:04:35.73,0:04:37.40,Default,,0,0,0,,Мен мұнда өзімді жайлы сезінбеймін.
Dialogue: 0,0:04:37.48,0:04:39.40,Default,,0,0,0,,Қараңызшы, бұл шарап.
Dialogue: 0,0:04:40.82,0:04:42.74,Default,,0,0,0,,Мен бас тартқым келмейді, бірақ
Dialogue: 0,0:04:42.82,0:04:45.07,Default,,0,0,0,,Мен бара алмаймын. Сонда кездескенше.
Dialogue: 0,0:04:45.82,0:04:46.74,Default,,0,0,0,,Енді кім?
Dialogue: 0,0:04:46.82,0:04:47.82,Default,,0,0,0,,Бұл Ник.
Dialogue: 0,0:04:47.91,0:04:51.08,Default,,0,0,0,,Жоғары сынып оқушылары үйде той жасап жатыр.
Dialogue: 0,0:04:51.16,0:04:52.58,Default,,0,0,0,,Барғыңыз келе ме?
Dialogue: 0,0:04:52.66,0:04:53.37,Default,,0,0,0,,Өте
Dialogue: 0,0:04:53.45,0:04:54.00,Default,,0,0,0,,Тоқта
Dialogue: 0,0:04:54.08,0:04:57.04,Default,,0,0,0,,Ол бұл туралы қоғамдық радиода айтты.
Dialogue: 0,0:04:57.13,0:05:00.25,Default,,0,0,0,,Ерлі-зайыптылар шытырман оқиғаға баруы керек
Dialogue: 0,0:05:00.34,0:05:03.26,Default,,0,0,0,,Орта мектептегі кеш - бұл шытырман оқиға.
Dialogue: 0,0:05:03.34,0:05:05.47,Default,,0,0,0,,Радио тыңдау үшін...
Dialogue: 0,0:05:05.55,0:05:07.47,Default,,0,0,0,,Бірақ ата-анаға не айту керек?
Dialogue: 0,0:05:07.55,0:05:08.89,Default,,0,0,0,,Фильм көру
Dialogue: 0,0:05:08.97,0:05:10.68,Default,,0,0,0,,Иә, не?
Dialogue: 0,0:05:11.68,0:05:13.06,Default,,0,0,0,,«Кілем төбесі»
Dialogue: 0,0:05:13.14,0:05:13.77,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:05:13.85,0:05:15.52,Default,,0,0,0,,Иран фильмі
Dialogue: 0,0:05:15.60,0:05:20.48,Default,,0,0,0,,Физик патша құлағаннан кейін даяшы болады.
Dialogue: 0,0:05:20.57,0:05:21.44,Default,,0,0,0,,Мұндай фильм бар ма?
Dialogue: 0,0:05:21.52,0:05:23.40,Default,,0,0,0,,Жоқ, бұл өтірік.
Dialogue: 0,0:05:23.48,0:05:25.28,Default,,0,0,0,,Ал өтірік айтуды жақсы біледі
Dialogue: 0,0:05:25.36,0:05:28.28,Default,,0,0,0,,Маған өтірік айтуға шебер әйелдер ұнайды
Dialogue: 0,0:05:28.36,0:05:30.20,Default,,0,0,0,,Кейбір әйелдер жыныстық қатынаста жақсы
Dialogue: 0,0:05:31.58,0:05:34.04,Default,,0,0,0,,Партия қасқыры осында!
Dialogue: 0,0:05:35.71,0:05:36.25,Default,,0,0,0,,Міне, келдік
Dialogue: 0,0:05:36.33,0:05:37.29,Default,,0,0,0,,Сәлем Джей
Dialogue: 0,0:05:37.37,0:05:38.83,Default,,0,0,0,,Неліктен білесің?
Dialogue: 0,0:05:38.92,0:05:40.25,Default,,0,0,0,,Асүйде орнату
Dialogue: 0,0:05:41.29,0:05:42.00,Default,,0,0,0,,Камерамен
Dialogue: 0,0:05:42.09,0:05:42.67,Default,,0,0,0,,Не?
Dialogue: 0,0:05:42.75,0:05:43.80,Default,,0,0,0,,Күдікті болмаңыз
Dialogue: 0,0:05:43.88,0:05:47.47,Default,,0,0,0,,Мен жай ғана анаңның пісіргенін көргім келді.
Dialogue: 0,0:05:47.55,0:05:49.01,Default,,0,0,0,,Өйткені біз әртүрліміз.
Dialogue: 0,0:05:49.09,0:05:50.55,Default,,0,0,0,,Балалар!
Dialogue: 0,0:05:50.64,0:05:52.47,Default,,0,0,0,,Түскі ас!
Dialogue: 0,0:05:56.14,0:05:59.77,Default,,0,0,0,,Мен тұздыққа насыбайгүл қосуым керек.
Dialogue: 0,0:05:59.85,0:06:02.02,Default,,0,0,0,,Сондықтан мен Дайанды көргім келеді.
Dialogue: 0,0:06:02.11,0:06:04.57,Default,,0,0,0,,Махаббатпен жасалған
Dialogue: 0,0:06:04.65,0:06:05.36,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:05.44,0:06:08.11,Default,,0,0,0,,Сонымен не? Чикушумэ
Dialogue: 0,0:06:08.20,0:06:09.86,Default,,0,0,0,,Сіз қанша қойдыңыз?
Dialogue: 0,0:06:09.95,0:06:12.53,Default,,0,0,0,,Қараңдар, мен саған ішімдік әкелдім.
Dialogue: 0,0:06:12.62,0:06:13.99,Default,,0,0,0,,Мақта кондиті?
Dialogue: 0,0:06:14.08,0:06:16.62,Default,,0,0,0,,Әкем қорғаған жігіт жасаған.
Dialogue: 0,0:06:16.70,0:06:19.96,Default,,0,0,0,,Балалардың балаларға арналған ішімдіктері
Dialogue: 0,0:06:20.04,0:06:24.00,Default,,0,0,0,,Алкоголь жасаған баланы қорғадыңыз ба?
Dialogue: 0,0:06:24.09,0:06:27.42,Default,,0,0,0,,Мен судьяны «сеу» деп атап, істі жоғалтып алдым.
Dialogue: 0,0:06:27.51,0:06:29.55,Default,,0,0,0,,Сіздің үйіңіз апатты жағдайда.
Dialogue: 0,0:06:29.63,0:06:30.26,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:06:30.34,0:06:31.72,Default,,0,0,0,,Сіз мұны ішесіз бе?
Dialogue: 0,0:06:31.80,0:06:34.22,Default,,0,0,0,,Партия қасқырына
Dialogue: 0,0:06:34.64,0:06:36.06,Default,,0,0,0,,Мұрын және тамақ!
Dialogue: 0,0:06:36.14,0:06:38.56,Default,,0,0,0,,Көру 30 секундта қалыпқа келеді
Dialogue: 0,0:06:38.64,0:06:39.69,Default,,0,0,0,,Менің ішім ауырады
Dialogue: 0,0:06:39.77,0:06:40.81,Default,,0,0,0,,Күшті сусын, солай ма?
Dialogue: 0,0:06:40.90,0:06:42.73,Default,,0,0,0,,Бірақ бұл пирог сияқты тәтті
Dialogue: 0,0:06:43.48,0:06:44.07,Default,,0,0,0,,Енді жұмысқа аттанатын уақыт келді ғой?
Dialogue: 0,0:06:44.15,0:06:45.90,Default,,0,0,0,,«Мен бара аламын ба?»
Dialogue: 0,0:06:45.98,0:06:47.90,Default,,0,0,0,,Кәмелетке толу рәсіміне оркестрді қалай брондауға болады?
Dialogue: 0,0:06:47.99,0:06:48.65,Default,,0,0,0,,Есірткі қолданып жүргендіктен ұмыттыңыз ба?
Dialogue: 0,0:06:48.65,0:06:50.24,Default,,0,0,0,,Есірткі қолданып жүргендіктен ұмыттыңыз ба?
Dialogue: 0,0:06:48.65,0:06:50.24,Default,,0,0,0,,``Кәне, бұл кеш»'
Dialogue: 0,0:06:50.57,0:06:53.66,Default,,0,0,0,,Никтің үйіне бара аламын ба?
Dialogue: 0,0:06:53.74,0:06:55.16,Default,,0,0,0,,Үйге ерте бар
Dialogue: 0,0:06:55.24,0:06:56.62,Default,,0,0,0,,Көңілді болыңыз
Dialogue: 0,0:06:56.70,0:07:00.25,Default,,0,0,0,,Сенімді түбір жолағын сақтаңыз
Dialogue: 0,0:07:00.33,0:07:03.67,Default,,0,0,0,,Бұл тот басқан фейк емес пе?
Dialogue: 0,0:07:03.75,0:07:06.42,Default,,0,0,0,,Мақта кондиті Мен өзімді керемет сезінемін
Dialogue: 0,0:07:06.50,0:07:09.09,Default,,0,0,0,,Мақта кондиті, кеттік.
Dialogue: 0,0:07:09.17,0:07:10.84,Default,,0,0,0,,Сен жындысың.
Dialogue: 0,0:07:10.93,0:07:12.72,Default,,0,0,0,,Эй, сен-
Dialogue: 0,0:07:12.80,0:07:14.80,Default,,0,0,0,,Менің рэпімді естідің бе?
Dialogue: 0,0:07:14.89,0:07:16.51,Default,,0,0,0,,Мен ақымақпын
Dialogue: 0,0:07:17.22,0:07:20.14,Default,,0,0,0,,Мен ақымақ және ақымақ адаммын.
Dialogue: 0,0:07:20.23,0:07:22.81,Default,,0,0,0,,Сен ақымақ болсаң, мен де ақымақпын
Dialogue: 0,0:07:23.27,0:07:24.48,Default,,0,0,0,,Екеуі де Усуноро
Dialogue: 0,0:07:24.56,0:07:25.82,Default,,0,0,0,,Бұл менің ағам Джадд.
Dialogue: 0,0:07:25.90,0:07:28.15,Default,,0,0,0,,Мен бір күні сайлауға түсемін
Dialogue: 0,0:07:28.82,0:07:29.69,Default,,0,0,0,,Адам аяғы тимейтін орынды әдейі таңдаған...
Dialogue: 0,0:07:29.82,0:07:32.95,Default,,0,0,0,,Сен күлкілісің, Ник.
Dialogue: 0,0:07:34.32,0:07:34.87,Default,,0,0,0,,Не?
Dialogue: 0,0:07:34.95,0:07:37.29,Default,,0,0,0,,Менің сүйіктім бар~
Dialogue: 0,0:07:37.37,0:07:39.29,Default,,0,0,0,,Иә? Мен мас болдым ба деп ойлаймын
Dialogue: 0,0:07:39.37,0:07:41.12,Default,,0,0,0,,Махаббатқа мас болған
Dialogue: 0,0:07:41.21,0:07:42.37,Default,,0,0,0,,Таллулаға деген махаббат
Dialogue: 0,0:07:42.46,0:07:44.17,Default,,0,0,0,,Мен қызғаншақпын.
Dialogue: 0,0:07:44.54,0:07:47.09,Default,,0,0,0,,Мен сиқым келген адамды қызғанамын ба?
Dialogue: 0,0:07:47.17,0:07:48.75,Default,,0,0,0,,Әкем де қызғанады
Dialogue: 0,0:07:48.84,0:07:51.84,Default,,0,0,0,,Мақта кәмпит коньягы ше?
Dialogue: 0,0:07:52.80,0:07:53.76,Default,,0,0,0,,Партия қасқыры
Dialogue: 0,0:07:56.26,0:07:57.14,Default,,0,0,0,,(Серо) Тіпті бастауыш сынып оқушысы кенеттен «Қорықпа!» деп айқайлады.
Dialogue: 0,0:07:58.89,0:07:59.64,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:07:59.72,0:08:01.23,Default,,0,0,0,,Қызды сүйді
Dialogue: 0,0:08:01.31,0:08:02.81,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:08:03.52,0:08:04.90,Default,,0,0,0,,Сен ақымақ
Dialogue: 0,0:08:05.23,0:08:08.90,Default,,0,0,0,,Мен сенен кіші болсам да, жоғары сынып оқушысынан да жетілгенмін.
Dialogue: 0,0:08:09.07,0:08:10.69,Default,,0,0,0,,Дөрекі адамдар
Dialogue: 0,0:08:11.32,0:08:12.36,Default,,0,0,0,,Енді жұмысқа аттанатын уақыт келді ғой?
Dialogue: 0,0:08:12.74,0:08:14.28,Default,,0,0,0,,Бұл сексуалдық сәйкестік
Dialogue: 0,0:08:14.36,0:08:16.91,Default,,0,0,0,,Тоқта, мен өзімді саиак сияқты сезінемін.
Dialogue: 0,0:08:16.99,0:08:21.45,Default,,0,0,0,,Сіздің дертіңізді емдейтін арнайы дәрі бар екен.
Dialogue: 0,0:08:21.54,0:08:24.42,Default,,0,0,0,,«Бала жасаған мақта кондиті»
Dialogue: 0,0:08:24.50,0:08:25.46,Default,,0,0,0,,«Көмек»
Dialogue: 0,0:08:25.54,0:08:27.63,Default,,0,0,0,,Оны қайдан алдың?
Dialogue: 0,0:08:27.71,0:08:29.59,Default,,0,0,0,,Бангкок кәмелетке толмағандарды ұстау изоляторы
Dialogue: 0,0:08:29.92,0:08:30.46,Default,,0,0,0,,Не?
Dialogue: 0,0:08:30.55,0:08:31.34,Default,,0,0,0,,Сайт
Dialogue: 0,0:08:31.42,0:08:33.67,Default,,0,0,0,,Өндіріс қазірдің өзінде тоқтатылды.
Dialogue: 0,0:08:33.76,0:08:35.68,Default,,0,0,0,,Өйткені нысан өртке оранды
Dialogue: 0,0:08:36.93,0:08:38.68,Default,,0,0,0,,Норома Жоғарыдан қараңыз.
Dialogue: 0,0:08:38.76,0:08:40.01,Default,,0,0,0,,Мен үшін алаңдама
Dialogue: 0,0:08:40.10,0:08:43.10,Default,,0,0,0,,Менің сізге айтайын деген ауыр әңгімем бар.
Dialogue: 0,0:08:43.18,0:08:43.73,Default,,0,0,0,,Не?
Dialogue: 0,0:08:43.81,0:08:45.69,Default,,0,0,0,,Сіз машинамен сөйлескен едіңіз, солай ма?
Dialogue: 0,0:08:45.77,0:08:46.85,Default,,0,0,0,,Көңілді болыңыз
Dialogue: 0,0:08:47.36,0:08:50.02,Default,,0,0,0,,Таллула - феллатио машинасы
Dialogue: 0,0:08:50.11,0:08:52.86,Default,,0,0,0,,Ол минеттерді ұнатады
Dialogue: 0,0:08:52.94,0:08:53.61,Default,,0,0,0,,Күте тұр… Демек, мені соңында ұмытып қалдыңдар ма?
Dialogue: 0,0:08:53.69,0:08:55.32,Default,,0,0,0,,Сіз мені жек көресіз, солай ма?
Dialogue: 0,0:08:55.40,0:08:57.11,Default,,0,0,0,,Жоқ, сен менің інімсің.
Dialogue: 0,0:08:57.20,0:09:00.12,Default,,0,0,0,,Мен сені ренжітемін деп үміттенемін
Dialogue: 0,0:09:00.20,0:09:01.12,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:09:01.20,0:09:03.54,Default,,0,0,0,,Никтің шытырман оқиғалары құтты болсын
Dialogue: 0,0:09:03.62,0:09:06.08,Default,,0,0,0,,Оның жолы болды
Dialogue: 0,0:09:06.17,0:09:09.84,Default,,0,0,0,,Никтің кішкентай заты оның аузына түседі.
Dialogue: 0,0:09:09.92,0:09:10.92,Default,,0,0,0,,Ауыздан басқа болуы мүмкін
Dialogue: 0,0:09:11.00,0:09:12.38,Default,,0,0,0,,Сабыр етіңіз.
Dialogue: 0,0:09:12.46,0:09:14.13,Default,,0,0,0,,Кішкентай емес
Dialogue: 0,0:09:14.22,0:09:15.93,Default,,0,0,0,,Жоқ. Ол кішкентай ма?
Dialogue: 0,0:09:17.43,0:09:20.35,Default,,0,0,0,,Эндрю, мен сенімен сөйлескім келді.
Dialogue: 0,0:09:20.43,0:09:21.89,Default,,0,0,0,,Сіз массыз ба?
Dialogue: 0,0:09:21.97,0:09:23.60,Default,,0,0,0,,Ол сол жерде
Dialogue: 0,0:09:23.68,0:09:26.39,Default,,0,0,0,,Бұл минет машинасы.
Dialogue: 0,0:09:26.48,0:09:27.35,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:09:27.44,0:09:29.11,Default,,0,0,0,,Мисси де сонда болды ма?
Dialogue: 0,0:09:29.19,0:09:30.61,Default,,0,0,0,,Сәлем
Dialogue: 0,0:09:30.69,0:09:32.86,Default,,0,0,0,,Уайымдама, мен сенімен сөйлесемін.
Dialogue: 0,0:09:32.94,0:09:34.49,Default,,0,0,0,,Бұл ер адамдар арасындағы әңгіме.
Dialogue: 0,0:09:34.57,0:09:36.86,Default,,0,0,0,,Мен өзімдікі үшін уайымдаймын.
Dialogue: 0,0:09:36.95,0:09:38.07,Default,,0,0,0,,Осы жерде...
Dialogue: 0,0:09:38.16,0:09:38.78,Default,,0,0,0,,Ник
Dialogue: 0,0:09:38.86,0:09:39.87,Default,,0,0,0,,Бұл сиқыр.
Dialogue: 0,0:09:39.95,0:09:40.66,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:09:40.74,0:09:43.74,Default,,0,0,0,,Мен Миссидің қасында болуым керек.
Dialogue: 0,0:09:43.83,0:09:45.58,Default,,0,0,0,,Ананаспен сөйлесу
Dialogue: 0,0:09:45.66,0:09:48.08,Default,,0,0,0,,Сіз бұл шаш үлгісін қалай жасайсыз?
Dialogue: 0,0:09:49.96,0:09:52.38,Default,,0,0,0,,О, жоқ, жоқ
Dialogue: 0,0:09:53.67,0:09:54.80,Default,,0,0,0,,Герцог
Dialogue: 0,0:09:54.88,0:09:56.26,Default,,0,0,0,,Герцог I...
Dialogue: 0,0:09:56.34,0:09:57.43,Default,,0,0,0,,Бұл Ник емес пе?
Dialogue: 0,0:09:58.13,0:10:02.39,Default,,0,0,0,,Төменгі қабатта кеш өткізіп жатқан едік, сондықтан біз де той жасап жатырмыз.
Dialogue: 0,0:10:02.47,0:10:03.22,Default,,0,0,0,,ұқсайды
Dialogue: 0,0:10:03.31,0:10:05.64,Default,,0,0,0,,Ник, бұл Пикассо.
Dialogue: 0,0:10:05.73,0:10:07.31,Default,,0,0,0,,Уитни Хьюстон
Dialogue: 0,0:10:07.39,0:10:08.94,Default,,0,0,0,,Және ханзада
Dialogue: 0,0:10:09.02,0:10:11.19,Default,,0,0,0,,Элизабет Тейлор және Ричард Бертон
Dialogue: 0,0:10:11.27,0:10:13.86,Default,,0,0,0,,Үйлендік, бірақ қатты ұрыстық.
Dialogue: 0,0:10:13.94,0:10:15.99,Default,,0,0,0,,Ханзада, сенің өлгеніңе қынжыламын.
Dialogue: 0,0:10:16.07,0:10:16.94,Default,,0,0,0,,Біз ше?
Dialogue: 0,0:10:17.03,0:10:18.24,Default,,0,0,0,,Барлығы өлді
Dialogue: 0,0:10:18.32,0:10:19.66,Default,,0,0,0,,Ол қайтыс болды~
Dialogue: 0,0:10:19.74,0:10:20.99,Default,,0,0,0,,Кетіңіз
Dialogue: 0,0:10:21.07,0:10:22.24,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:10:22.33,0:10:24.79,Default,,0,0,0,,Бірақ жұптасып жатқан әйел...
Dialogue: 0,0:10:24.87,0:10:26.58,Default,,0,0,0,,Тыңдаймыз ба?
Dialogue: 0,0:10:26.66,0:10:27.87,Default,,0,0,0,,Сенім білдірмеңіз
Dialogue: 0,0:10:27.96,0:10:29.71,Default,,0,0,0,,Таллула деген кім?
Dialogue: 0,0:10:29.79,0:10:32.34,Default,,0,0,0,,Минет машинасына ұқсайды
Dialogue: 0,0:10:32.42,0:10:33.96,Default,,0,0,0,,Ол сырғанап түскенде
Dialogue: 0,0:10:34.05,0:10:35.38,Default,,0,0,0,,Қаланың адамдары
Dialogue: 0,0:10:35.46,0:10:37.84,Default,,0,0,0,,Оның аузына крем жағыңыз
Dialogue: 0,0:10:37.92,0:10:40.51,Default,,0,0,0,,Жарайды, тыныш бол.
Dialogue: 0,0:10:40.59,0:10:42.43,Default,,0,0,0,,Сонымен, мәселе неде?
Dialogue: 0,0:10:42.51,0:10:44.39,Default,,0,0,0,,Мен шынымды айтайын.
Dialogue: 0,0:10:44.47,0:10:47.64,Default,,0,0,0,,Бәлкім, менде сиқыр жетіспейді
Dialogue: 0,0:10:47.73,0:10:49.48,Default,,0,0,0,,Өлшем маңызды емес
Dialogue: 0,0:10:49.56,0:10:53.44,Default,,0,0,0,,Оның ішінде сіз сезінетін жарылыс маңызды.
Dialogue: 0,0:10:54.44,0:10:56.98,Default,,0,0,0,,Менікі төртбұрышты
Dialogue: 0,0:10:57.07,0:10:58.19,Default,,0,0,0,,мұнда
Dialogue: 0,0:10:58.28,0:10:59.99,Default,,0,0,0,,Сондықтан мен кубизмді жасадым
Dialogue: 0,0:11:00.07,0:11:02.91,Default,,0,0,0,,«Керемет» болып есептеліңіз
Dialogue: 0,0:11:02.99,0:11:05.24,Default,,0,0,0,,Көрейін.
Dialogue: 0,0:11:05.33,0:11:07.20,Default,,0,0,0,,Сенің сиқырың
Dialogue: 0,0:11:07.29,0:11:08.62,Default,,0,0,0,,Бізге көрсет
Dialogue: 0,0:11:08.70,0:11:11.12,Default,,0,0,0,,Бұл орынды ма?
Dialogue: 0,0:11:11.21,0:11:13.21,Default,,0,0,0,,Жарайды, өйткені бұл елес.
Dialogue: 0,0:11:13.29,0:11:15.38,Default,,0,0,0,,Жүр, көрсетейін~
Dialogue: 0,0:11:15.46,0:11:19.38,Default,,0,0,0,,Уитниден басқа ешкім
Dialogue: 0,0:11:19.47,0:11:21.05,Default,,0,0,0,,Көргіңіз келсе
Dialogue: 0,0:11:23.47,0:11:25.14,Default,,0,0,0,,<Сәкең қайда? 〉
Dialogue: 0,0:11:25.22,0:11:27.35,Default,,0,0,0,,Шашты өңдедіңіз бе?
Dialogue: 0,0:11:27.43,0:11:29.64,Default,,0,0,0,,Мен өсетін жаста емеспін.
Dialogue: 0,0:11:29.73,0:11:33.10,Default,,0,0,0,,Мектеп формасының алтын түймесі сияқты көрінеді.
Dialogue: 0,0:11:33.19,0:11:35.86,Default,,0,0,0,,Таллула үшін бұл тым кішкентай деп ойлайсыз ба?
Dialogue: 0,0:11:35.94,0:11:39.03,Default,,0,0,0,,Оның алдыңғы тістерінің арасында саңылау бар ма?
Dialogue: 0,0:11:39.11,0:11:41.95,Default,,0,0,0,,Бар болса жеткілікті.
Dialogue: 0,0:11:42.70,0:11:45.37,Default,,0,0,0,,Бәрі өлсе де
Dialogue: 0,0:11:45.45,0:11:47.08,Default,,0,0,0,,Кішкентай болса да
Dialogue: 0,0:11:47.16,0:11:51.62,Default,,0,0,0,,Сіздің мүшеңіз баланың мұрнындай.
Dialogue: 0,0:11:51.71,0:11:52.08,Default,,0,0,0,,〝Егер басып алсаң, мен сені сабаймын〞
Dialogue: 0,0:11:52.08,0:11:54.04,Default,,0,0,0,,〝Егер басып алсаң, мен сені ұрамын〞
Dialogue: 0,0:11:52.08,0:11:54.04,Default,,0,0,0,,Джаддтың бөлмесі қауіпті
Dialogue: 0,0:11:54.04,0:11:54.54,Default,,0,0,0,,Джаддтың бөлмесі қауіпті
Dialogue: 0,0:11:54.63,0:11:55.33,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:11:56.13,0:11:58.59,Default,,0,0,0,,Париж және «Гамильтон» постері.
Dialogue: 0,0:11:58.67,0:11:59.71,Default,,0,0,0,,Кімнің бөлмесі?
Dialogue: 0,0:11:59.80,0:12:00.46,Default,,0,0,0,,Бұл?
Dialogue: 0,0:12:02.72,0:12:03.84,Default,,0,0,0,,Лия
Dialogue: 0,0:12:03.93,0:12:06.76,Default,,0,0,0,,Бұл заттар болып жатқан бөлме.
Dialogue: 0,0:12:06.85,0:12:08.51,Default,,0,0,0,,Сондай-ақ шкаф болуы мүмкін.
Dialogue: 0,0:12:08.60,0:12:10.31,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:12:10.39,0:12:11.98,Default,,0,0,0,,Лияның киімінен иіс шығады...
Dialogue: 0,0:12:12.06,0:12:13.10,Default,,0,0,0,,Мен түсіндім
Dialogue: 0,0:12:13.35,0:12:18.19,Default,,0,0,0,,«Аспандағы 7 минут» ойынын білесіз бе?
Dialogue: 0,0:12:18.27,0:12:21.57,Default,,0,0,0,,Уақыт келді. Бұл нағыз нәрсе.
Dialogue: 0,0:12:21.65,0:12:23.53,Default,,0,0,0,,Бұл агрессивті.
Dialogue: 0,0:12:23.61,0:12:25.11,Default,,0,0,0,,Бірдеңе аударылды ма?
Dialogue: 0,0:12:25.20,0:12:30.91,Default,,0,0,0,,Бұл бала шөлімізді сумен қандырады.
Dialogue: 0,0:12:31.00,0:12:32.58,Default,,0,0,0,,Менің аузым құрғақ
Dialogue: 0,0:12:32.66,0:12:34.54,Default,,0,0,0,,Сіз қобалжыдыңыз ба?
Dialogue: 0,0:12:34.62,0:12:35.83,Default,,0,0,0,,Енді аузыңды жап
Dialogue: 0,0:12:35.92,0:12:38.54,Default,,0,0,0,,Сөйлеме, ішке кір.
Dialogue: 0,0:12:42.30,0:12:45.30,Default,,0,0,0,,Сіз осында болдыңыз, Ник Берч.
Dialogue: 0,0:12:45.38,0:12:49.31,Default,,0,0,0,,Иә, Таллула Левин
Dialogue: 0,0:12:49.39,0:12:51.22,Default,,0,0,0,,Сіз мені толық аты-жөніңізбен атадыңыз.
Dialogue: 0,0:12:51.31,0:12:53.89,Default,,0,0,0,,Дұрыс, мен қыздарды жинап жатырмын.
Dialogue: 0,0:12:53.98,0:12:54.98,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:12:55.06,0:12:56.60,Default,,0,0,0,,(Фушигиро) Неге мұнда жүрсің, Зэн'ин-сенпай?
Dialogue: 0,0:12:59.27,0:13:02.28,Default,,0,0,0,,Сіз әдемі және сүйкімдісіз
Dialogue: 0,0:13:02.36,0:13:05.11,Default,,0,0,0,,Сіздің тілегіңіз орындалмайды
Dialogue: 0,0:13:05.20,0:13:06.07,Default,,0,0,0,,Үміт?
Dialogue: 0,0:13:06.16,0:13:07.28,Default,,0,0,0,,Хе-хе. Баспалдақтан төмен түсіп кеткенсің ғой?
Dialogue: 0,0:13:07.36,0:13:08.41,Default,,0,0,0,,Сіздің қалауыңыз
Dialogue: 0,0:13:08.49,0:13:11.16,Default,,0,0,0,,Қалау? Не айтқың келеді?
Dialogue: 0,0:13:11.24,0:13:13.83,Default,,0,0,0,,Fellatio мүмкін емес.
Dialogue: 0,0:13:13.91,0:13:15.12,Default,,0,0,0,,Кешіріңіз, бірақ...
Dialogue: 0,0:13:15.37,0:13:17.88,Default,,0,0,0,,Неліктен мен фельатио беремін?
Dialogue: 0,0:13:17.96,0:13:19.04,Default,,0,0,0,,Сіздің лақап атыңыз
Dialogue: 0,0:13:19.13,0:13:20.71,Default,,0,0,0,,Ақымақ болма
Dialogue: 0,0:13:20.79,0:13:23.71,Default,,0,0,0,,Мен бұрын кездескен адам
Dialogue: 0,0:13:23.80,0:13:26.47,Default,,0,0,0,,Мен саған бос сөз айттым.
Dialogue: 0,0:13:26.55,0:13:28.68,Default,,0,0,0,,Сонда мен машинамын ба?
Dialogue: 0,0:13:28.76,0:13:30.47,Default,,0,0,0,,Кешіріңіз, мен-
Dialogue: 0,0:13:30.55,0:13:34.27,Default,,0,0,0,,Мен жай ғана сырласқысы келетін ақымақпын.
Dialogue: 0,0:13:34.35,0:13:36.77,Default,,0,0,0,,Иә, сен ақымақ екенсің.
Dialogue: 0,0:13:40.02,0:13:41.61,Default,,0,0,0,,Бұл жолы емес
Dialogue: 0,0:13:41.69,0:13:43.19,Default,,0,0,0,,Тыныштыр, фото.
Dialogue: 0,0:13:43.28,0:13:44.65,Default,,0,0,0,,Мен қабырғаның ішіндемін
Dialogue: 0,0:13:44.74,0:13:45.74,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,0:13:45.99,0:13:47.66,Default,,0,0,0,,Жеті минут, солай ма?
Dialogue: 0,0:13:47.74,0:13:48.91,Default,,0,0,0,,Таймер?
Dialogue: 0,0:13:48.99,0:13:50.70,Default,,0,0,0,,Олай болса бастайық
Dialogue: 0,0:13:50.78,0:13:51.91,Default,,0,0,0,,Морис
Dialogue: 0,0:13:51.99,0:13:53.37,Default,,0,0,0,,Шағын әңгіме
Dialogue: 0,0:13:53.45,0:13:54.87,Default,,0,0,0,,Мәміле қандай?
Dialogue: 0,0:13:54.95,0:13:56.96,Default,,0,0,0,,Сіздің көкірекшеңіздің үстінен ше?
Dialogue: 0,0:13:57.04,0:13:58.87,Default,,0,0,0,,Жыныстық қатынас туралы не білесіз?
Dialogue: 0,0:13:58.96,0:14:00.75,Default,,0,0,0,,Эндрю -
Dialogue: 0,0:14:00.83,0:14:01.88,Default,,0,0,0,,Төзімді бол, көмекші!
Dialogue: 0,0:14:01.96,0:14:04.38,Default,,0,0,0,,Мен айтқанымдай, Мисси де.
Dialogue: 0,0:14:04.46,0:14:06.72,Default,,0,0,0,,Мен не істеп жатқанымды білмеймін
Dialogue: 0,0:14:06.80,0:14:09.13,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:14:09.22,0:14:10.89,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:14:20.31,0:14:23.27,Default,,0,0,0,,Тағы бір жазылған алғашқы сүйісу
Dialogue: 0,0:14:23.36,0:14:25.07,Default,,0,0,0,,Бірінші сүйісу - ең жақсысы
Dialogue: 0,0:14:25.15,0:14:26.19,Default,,0,0,0,,Есіңізде ме?
Dialogue: 0,0:14:26.28,0:14:27.90,Default,,0,0,0,,Тоқта, Морис.
Dialogue: 0,0:14:27.99,0:14:31.95,Default,,0,0,0,,Динозаврлар Пангея материгінен кеткеннен кейін.
Dialogue: 0,0:14:32.03,0:14:34.29,Default,,0,0,0,,Жерде жалғыз біз болдық
Dialogue: 0,0:14:34.37,0:14:39.21,Default,,0,0,0,,Жоқ, мен мамонтты қызартқанымызға сенімдімін.
Dialogue: 0,0:14:40.04,0:14:41.54,Default,,0,0,0,,Сізді қайтадан көргеніме қуаныштымын
Dialogue: 0,0:14:41.63,0:14:44.30,Default,,0,0,0,,Оның иісін сезгеніңізге қуаныштымын.
Dialogue: 0,0:14:50.63,0:14:51.51,Default,,0,0,0,,Бұл жаман
Dialogue: 0,0:14:51.59,0:14:53.43,Default,,0,0,0,,Ято-сама!
Dialogue: 0,0:14:53.51,0:14:54.35,Default,,0,0,0,,Сәлем
Dialogue: 0,0:14:54.43,0:14:57.06,Default,,0,0,0,,Бала оны неге итеріп жіберді?
Dialogue: 0,0:14:57.14,0:14:59.10,Default,,0,0,0,,Ішімнен эякуляция шығып кете жаздады.
Dialogue: 0,0:14:59.18,0:15:00.52,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:00.60,0:15:01.52,Default,,0,0,0,,Бұл менің кінәм
Dialogue: 0,0:15:01.60,0:15:04.73,Default,,0,0,0,,Өйткені мен оған қарсы өзімнің бөртпе тұсын басып қойдым.
Dialogue: 0,0:15:04.82,0:15:05.57,Default,,0,0,0,,Не?
Dialogue: 0,0:15:05.65,0:15:06.90,Default,,0,0,0,,Яғни, жоғарыдағы...
Dialogue: 0,0:15:06.98,0:15:08.28,Default,,0,0,0,,Бұл туралы қазір ұмытыңыз
Dialogue: 0,0:15:08.36,0:15:10.65,Default,,0,0,0,,Өйткені олар іркілмей алға ұмтылады.
Dialogue: 0,0:15:10.74,0:15:13.32,Default,,0,0,0,,Мен бағындырмаймын
Dialogue: 0,0:15:13.41,0:15:14.78,Default,,0,0,0,,Мен жай ғана
Dialogue: 0,0:15:14.87,0:15:18.33,Default,,0,0,0,,Ол маған тіс щеткасы мен щеткамды үйде қалдыруымды айтты...
Dialogue: 0,0:15:18.41,0:15:19.62,Default,,0,0,0,,Сәлем Конни
Dialogue: 0,0:15:20.08,0:15:22.04,Default,,0,0,0,,Кешке оралу
Dialogue: 0,0:15:22.12,0:15:23.79,Default,,0,0,0,,Сізде әлі екі минут бар.
Dialogue: 0,0:15:23.88,0:15:26.46,Default,,0,0,0,,Сіз көп нәрсені байқап көре аласыз
Dialogue: 0,0:15:28.38,0:15:29.63,Default,,0,0,0,,Оны алып кетуге келген анасымен бірге —
Dialogue: 0,0:15:31.76,0:15:33.05,Default,,0,0,0,,Бұл Лия
Dialogue: 0,0:15:33.14,0:15:34.39,Default,,0,0,0,,Ер адам кім?
Dialogue: 0,0:15:34.47,0:15:37.39,Default,,0,0,0,,Мен ананасты ғана білемін
Dialogue: 0,0:15:38.68,0:15:40.89,Default,,0,0,0,,Ник, сіз тым көп ішесіз.
Dialogue: 0,0:15:40.98,0:15:42.81,Default,,0,0,0,,Дайанның аузын жап
Dialogue: 0,0:15:42.90,0:15:43.77,Default,,0,0,0,,Сіз кіммен сөйлесесіз?
Dialogue: 0,0:15:43.85,0:15:45.48,Default,,0,0,0,,Сіз кіммен біргесіз?
Dialogue: 0,0:15:45.56,0:15:47.15,Default,,0,0,0,,Сіз массыз ба?
Dialogue: 0,0:15:47.23,0:15:48.57,Default,,0,0,0,,Мені тыңда
Dialogue: 0,0:15:48.65,0:15:49.19,Default,,0,0,0,,Қый!
Dialogue: 0,0:15:49.28,0:15:51.32,Default,,0,0,0,,Оның сізге қатысы жоқ.
Dialogue: 0,0:15:51.40,0:15:52.57,Default,,0,0,0,,Қызу!
Dialogue: 0,0:15:52.66,0:15:56.20,Default,,0,0,0,,Ештеңе емес, тек менің ата-анам Сайақ.
Dialogue: 0,0:15:56.28,0:15:59.20,Default,,0,0,0,,Әкем сондай мүйізді
Dialogue: 0,0:15:59.29,0:16:00.91,Default,,0,0,0,,Анам да біртүрлі, солай ма?
Dialogue: 0,0:16:01.08,0:16:01.62,Default,,0,0,0,,Не?
Dialogue: 0,0:16:01.96,0:16:02.50,Default,,0,0,0,,Бөлек
Dialogue: 0,0:16:02.58,0:16:04.25,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:16:04.33,0:16:06.09,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:16:06.17,0:16:09.00,Default,,0,0,0,,Бұл күлкілі, сондықтан бұл туралы алаңдамаңыз
Dialogue: 0,0:16:09.09,0:16:10.30,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:16:10.38,0:16:11.13,Default,,0,0,0,,Не?
Dialogue: 0,0:16:11.22,0:16:13.38,Default,,0,0,0,,Мойында, Ник.
Dialogue: 0,0:16:13.47,0:16:16.64,Default,,0,0,0,,Қалаға барсам, қалпақ көрдім.
Dialogue: 0,0:16:16.72,0:16:19.39,Default,,0,0,0,,Шляпа анаңды сүй
Dialogue: 0,0:16:19.47,0:16:20.43,Default,,0,0,0,,Қалпақ – әйел
Dialogue: 0,0:16:21.10,0:16:23.35,Default,,0,0,0,,Мен мұны анық айттым.
Dialogue: 0,0:16:23.44,0:16:26.15,Default,,0,0,0,,Сенің анаң бір әйелді сүйіп тұрған
Dialogue: 0,0:16:26.23,0:16:27.77,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:16:27.86,0:16:29.02,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:29.11,0:16:31.15,Default,,0,0,0,,Кешіріңіз, Джесси.
Dialogue: 0,0:16:31.24,0:16:34.07,Default,,0,0,0,,Сіз екі апта бұрын қалаға бардыңыз, солай ма?
Dialogue: 0,0:16:34.15,0:16:35.24,Default,,0,0,0,,Шынында да солай емес пе?
Dialogue: 0,0:16:35.32,0:16:36.87,Default,,0,0,0,,Менің есімде
Dialogue: 0,0:16:36.95,0:16:40.91,Default,,0,0,0,,Осы уақытқа дейін маған ештеңе айтқан жоқсың.
Dialogue: 0,0:16:41.00,0:16:41.79,Default,,0,0,0,,Сайт
Dialogue: 0,0:16:41.87,0:16:42.62,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:42.71,0:16:44.42,Default,,0,0,0,,Қандай қорқынышты дос.
Dialogue: 0,0:16:44.50,0:16:47.63,Default,,0,0,0,,Шүкір, мен сөйлейтінмін.
Dialogue: 0,0:16:48.46,0:16:49.46,Default,,0,0,0,,Чат…
Dialogue: 0,0:16:49.55,0:16:51.96,Default,,0,0,0,,Дәл осы бағдарлама
Dialogue: 0,0:16:52.05,0:16:55.34,Default,,0,0,0,,Эй, сен сонда қарап отырсың.
Dialogue: 0,0:16:55.43,0:16:56.93,Default,,0,0,0,,Мен саған қарап тұрмын
Dialogue: 0,0:16:57.01,0:16:58.93,Default,,0,0,0,,Жай ғана үндеме.
Dialogue: 0,0:17:01.77,0:17:03.18,Default,,0,0,0,,Бұл жерден кетейік
Dialogue: 0,0:17:03.27,0:17:05.52,Default,,0,0,0,,Қазір кетсем біртүрлі болар еді.
Dialogue: 0,0:17:05.60,0:17:07.27,Default,,0,0,0,,Іздеуді тоқтатыңыз
Dialogue: 0,0:17:07.35,0:17:09.11,Default,,0,0,0,,Түсіндім, тоқтат.
Dialogue: 0,0:17:12.44,0:17:13.78,Default,,0,0,0,,Ол не істеді?
Dialogue: 0,0:17:14.45,0:17:17.03,Default,,0,0,0,,Оның орнына сүйген жақсырақ.
Dialogue: 0,0:17:21.54,0:17:22.37,Default,,0,0,0,,Білемін, білемін!
Dialogue: 0,0:17:22.45,0:17:23.29,Default,,0,0,0,,Жарайды
Dialogue: 0,0:17:23.37,0:17:25.46,Default,,0,0,0,,Даниел, доғар.
Dialogue: 0,0:17:25.83,0:17:28.21,Default,,0,0,0,,Мен мұны істемеймін.
Dialogue: 0,0:17:28.29,0:17:30.25,Default,,0,0,0,,Сен қаталсың.
Dialogue: 0,0:17:30.34,0:17:31.42,Default,,0,0,0,,Осындайша тәж кигізу рәсіміне кедергі келтіру…
Dialogue: 0,0:17:31.50,0:17:33.09,Default,,0,0,0,,Сен жындысың
Dialogue: 0,0:17:33.17,0:17:35.22,Default,,0,0,0,,Мен сене алар емеспін.
Dialogue: 0,0:17:35.30,0:17:37.18,Default,,0,0,0,,Бұл менің бөлмем, бірақ мен кетемін.
Dialogue: 0,0:17:37.26,0:17:39.76,Default,,0,0,0,,Бұған жол берудің мәні неде?
Dialogue: 0,0:17:39.85,0:17:41.18,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:41.26,0:17:42.14,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:17:45.43,0:17:46.73,Default,,0,0,0,,Ол осылай жұмыс істейді
Dialogue: 0,0:17:47.31,0:17:49.02,Default,,0,0,0,,Бұл тәтті
Dialogue: 0,0:17:49.10,0:17:49.65,Default,,0,0,0,,Қосымша
Dialogue: 0,0:17:49.73,0:17:50.44,Default,,0,0,0,,(Роко) Иә, әрине. Мұнда өте жайлы екен.
Dialogue: 0,0:17:50.52,0:17:52.32,Default,,0,0,0,,Шынымды айтсам, мен мұны істемеймін.
Dialogue: 0,0:17:52.40,0:17:53.53,Default,,0,0,0,,Бұл күлкілі
Dialogue: 0,0:17:53.61,0:17:55.90,Default,,0,0,0,,Бұл мүлдем күлкілі.
Dialogue: 0,0:17:56.70,0:17:58.57,Default,,0,0,0,,Менің отбасым сұмдық
Dialogue: 0,0:17:58.66,0:18:00.62,Default,,0,0,0,,Біз де ақымақпыз.
Dialogue: 0,0:18:05.12,0:18:06.12,Default,,0,0,0,,Партия қасқыры…
Dialogue: 0,0:18:09.08,0:18:13.21,Default,,0,0,0,,Бұл үйдегі барлық гормондар жынды.
Dialogue: 0,0:18:13.30,0:18:15.67,Default,,0,0,0,,Морис Морис
Dialogue: 0,0:18:15.76,0:18:18.05,Default,,0,0,0,,Мен ойымды өзгерттім.
Dialogue: 0,0:18:18.51,0:18:21.89,Default,,0,0,0,,Жоғарыда болған оқиға қорқынышты болды.
Dialogue: 0,0:18:21.97,0:18:24.31,Default,,0,0,0,,Кешіріңіз, мен шектен шығып кеттім.
Dialogue: 0,0:18:24.39,0:18:25.72,Default,,0,0,0,,Бұл сіз туралы емес.
Dialogue: 0,0:18:25.81,0:18:29.23,Default,,0,0,0,,Әлгі адам Лияға солай істеді.
Dialogue: 0,0:18:29.31,0:18:31.40,Default,,0,0,0,,Бүгін түнде бәрі біртүрлі.
Dialogue: 0,0:18:31.48,0:18:34.90,Default,,0,0,0,,Морис, сенің еркелігің.
Dialogue: 0,0:18:34.98,0:18:37.19,Default,,0,0,0,,Оны үйде қалдыруға болады.
Dialogue: 0,0:18:38.15,0:18:39.53,Default,,0,0,0,,Мына қарғыс кесте
Dialogue: 0,0:18:41.37,0:18:44.33,Default,,0,0,0,,Сіздің ерніңіз ванна төсенішінен жақсы
Dialogue: 0,0:18:44.41,0:18:45.70,Default,,0,0,0,,Мен ауырып тұрмын
Dialogue: 0,0:18:45.79,0:18:48.33,Default,,0,0,0,,Шеге сынықтары жоқ.
Dialogue: 0,0:18:49.75,0:18:51.00,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:18:51.08,0:18:52.33,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:52.42,0:18:53.59,Default,,0,0,0,,Ал, көзіңді жұм.
Dialogue: 0,0:18:53.67,0:18:56.05,Default,,0,0,0,,Не? шыға бер
Dialogue: 0,0:18:56.80,0:18:57.59,Default,,0,0,0,,Ах… Тога…
Dialogue: 0,0:18:57.67,0:19:00.55,Default,,0,0,0,,Сіз орамал алып жүрсіз бе?
Dialogue: 0,0:19:00.63,0:19:02.97,Default,,0,0,0,,Мен құсып кетсем, мені алаңдатпайды.
Dialogue: 0,0:19:03.05,0:19:04.97,Default,,0,0,0,,Бұл жомарт, рахмет.
Dialogue: 0,0:19:05.06,0:19:08.18,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба? Мен сүйіспеншілікке толдым
Dialogue: 0,0:19:08.27,0:19:10.14,Default,,0,0,0,,Міне!
Dialogue: 0,0:19:10.23,0:19:10.98,Default,,0,0,0,,Әрине
Dialogue: 0,0:19:11.06,0:19:12.40,Default,,0,0,0,,Бұл әңгіме аяқталды
Dialogue: 0,0:19:12.48,0:19:13.31,Default,,0,0,0,,Менің ағама...
Dialogue: 0,0:19:13.40,0:19:15.15,Default,,0,0,0,,Айтпа!
Dialogue: 0,0:19:15.23,0:19:17.15,Default,,0,0,0,,Ешкімге айтпа
Dialogue: 0,0:19:19.11,0:19:20.74,Default,,0,0,0,,Ұзақ болсын терең сүйіспеншілік
Dialogue: 0,0:19:22.49,0:19:24.07,Default,,0,0,0,,Сіз осында болдыңыз ба?
Dialogue: 0,0:19:24.16,0:19:25.45,Default,,0,0,0,,Кофе?
Dialogue: 0,0:19:25.53,0:19:26.45,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:19:26.54,0:19:30.41,Default,,0,0,0,,Ыстық суға ұнтақ кофе құйылды.
Dialogue: 0,0:19:30.50,0:19:32.71,Default,,0,0,0,,Дәмі жаман емес.
Dialogue: 0,0:19:32.79,0:19:34.00,Default,,0,0,0,,Шын мәнінде мектеп автобусымен келдің бе?
Dialogue: 0,0:19:34.08,0:19:38.13,Default,,0,0,0,,Лия жоғарғы қабатта қалпақ киген адаммен бірге болды.
Dialogue: 0,0:19:38.21,0:19:40.80,Default,,0,0,0,,Бұл Лияны ұнататын Даниэль.
Dialogue: 0,0:19:40.88,0:19:41.80,Default,,0,0,0,,Енді жоқ
Dialogue: 0,0:19:41.88,0:19:42.89,Default,,0,0,0,,Маған енді ұнамайды
Dialogue: 0,0:19:42.97,0:19:44.30,Default,,0,0,0,,Өте қатыгез
Dialogue: 0,0:19:44.39,0:19:46.72,Default,,0,0,0,,Мен Лияны мәжбүрледім
Dialogue: 0,0:19:46.81,0:19:49.73,Default,,0,0,0,,Балалар сендер біртүрлі екенсіңдер. Ол керемет.
Dialogue: 0,0:19:49.81,0:19:52.02,Default,,0,0,0,,Достар, римдіктер
Dialogue: 0,0:19:52.10,0:19:56.02,Default,,0,0,0,,Ойынға қосыл, маған елікте.
Dialogue: 0,0:19:56.11,0:19:59.53,Default,,0,0,0,,Әрқашан салқын және салқын
Dialogue: 0,0:20:01.53,0:20:02.95,Default,,0,0,0,,Джанет Джексон
Dialogue: 0,0:20:03.03,0:20:03.70,Default,,0,0,0,,Барак Обама
Dialogue: 0,0:20:03.78,0:20:04.95,Default,,0,0,0,,Бейонсе
Dialogue: 0,0:20:06.16,0:20:08.16,Default,,0,0,0,,Сіздің Бейонсеңіз ең жақсы
Dialogue: 0,0:20:08.24,0:20:09.83,Default,,0,0,0,,Әйелдер дүниенің басты кейіпкерлері
Dialogue: 0,0:20:09.91,0:20:11.62,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,0:20:11.71,0:20:13.46,Default,,0,0,0,,Енді менің кезегім
Dialogue: 0,0:20:13.54,0:20:16.79,Default,,0,0,0,,Кеш иесі осында.
Dialogue: 0,0:20:16.88,0:20:18.21,Default,,0,0,0,,Сәлем
Dialogue: 0,0:20:19.50,0:20:20.34,Default,,0,0,0,,Жарайды
Dialogue: 0,0:20:20.92,0:20:22.88,Default,,0,0,0,,Жарайды, біз жыныстық қатынасқа түсіп жатырмыз.
Dialogue: 0,0:20:22.97,0:20:24.01,Default,,0,0,0,,Сүйісу
Dialogue: 0,0:20:24.09,0:20:25.55,Default,,0,0,0,,Барак Обама
Dialogue: 0,0:20:26.05,0:20:27.72,Default,,0,0,0,,Біреудің басы...
Dialogue: 0,0:20:27.80,0:20:29.22,Default,,0,0,0,,Жаттықтырушы сэндвич жеп отыр
Dialogue: 0,0:20:29.31,0:20:29.85,Default,,0,0,0,,Сіз намаз оқисыз ба?
Dialogue: 0,0:20:29.93,0:20:31.43,Default,,0,0,0,,Намаз оқитын мұсылмандар
Dialogue: 0,0:20:31.52,0:20:32.23,Default,,0,0,0,,Барак Обама!
Dialogue: 0,0:20:32.31,0:20:33.85,Default,,0,0,0,,Сүйіп тұрған адам
Dialogue: 0,0:20:33.94,0:20:34.48,Default,,0,0,0,,Партия қасқыры?
Dialogue: 0,0:20:34.56,0:20:36.69,Default,,0,0,0,,Бұл Даниэль.
Dialogue: 0,0:20:36.77,0:20:37.90,Default,,0,0,0,,Күте тұрыңыз, бұл дұрыс емес.
Dialogue: 0,0:20:37.98,0:20:40.07,Default,,0,0,0,,Сіз сондайсыз.
Dialogue: 0,0:20:40.15,0:20:41.32,Default,,0,0,0,,Қай жағынан?
Dialogue: 0,0:20:41.40,0:20:42.99,Default,,0,0,0,,Бас итергіш!
Dialogue: 0,0:20:43.07,0:20:43.90,Default,,0,0,0,,Мен оны бастым.
Dialogue: 0,0:20:43.99,0:20:44.91,Default,,0,0,0,,Бас итергіш
Dialogue: 0,0:20:44.99,0:20:45.70,Default,,0,0,0,,Басты итеру?
Dialogue: 0,0:20:45.82,0:20:47.91,Default,,0,0,0,,«Томның мейрамханасы»
Dialogue: 0,0:20:48.33,0:20:49.66,Default,,0,0,0,,«Басты итеру» дегеніміз не?
Dialogue: 0,0:20:49.74,0:20:55.12,Default,,0,0,0,,Минет жасау үшін әйелдің басын итеру.
Dialogue: 0,0:20:55.21,0:20:56.42,Default,,0,0,0,,Бұл техника ма?
Dialogue: 0,0:20:56.50,0:20:58.75,Default,,0,0,0,,Әйелдер мүлде бақытты емес
Dialogue: 0,0:20:58.84,0:21:01.88,Default,,0,0,0,,Мен әрқашан феллатио туралы армандайтынмын
Dialogue: 0,0:21:01.96,0:21:02.92,Default,,0,0,0,,Басу деген нені білдіреді?
Dialogue: 0,0:21:03.01,0:21:03.76,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:21:03.84,0:21:06.68,Default,,0,0,0,,Мен оны ешқашан баспаймын
Dialogue: 0,0:21:08.14,0:21:10.18,Default,,0,0,0,,Ник, көлігіңді маған қарызға бер.
Dialogue: 0,0:21:10.26,0:21:11.18,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:21:11.27,0:21:13.48,Default,,0,0,0,,Мен саған шабуыл жасаған сияқтымын.
Dialogue: 0,0:21:13.56,0:21:14.73,Default,,0,0,0,,Мен сенің басыңды итеріп жібердім.
Dialogue: 0,0:21:14.81,0:21:15.89,Default,,0,0,0,,Жаңа ғана сұралды
Dialogue: 0,0:21:16.02,0:21:19.11,Default,,0,0,0,,Бас тартса да табанды түрде талап етілді
Dialogue: 0,0:21:19.19,0:21:19.86,Default,,0,0,0,,«Сенім артамын.»
Dialogue: 0,0:21:19.94,0:21:23.03,Default,,0,0,0,,Егер әйел агрессивті болса, оны итермелеудің қажеті жоқ.
Dialogue: 0,0:21:23.11,0:21:23.78,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:21:23.86,0:21:25.78,Default,,0,0,0,,Ер адам жетекшілік етуі керек
Dialogue: 0,0:21:25.86,0:21:28.28,Default,,0,0,0,,Минеттерді тағы қалай ынталандыруға болады?
Dialogue: 0,0:21:28.37,0:21:30.74,Default,,0,0,0,,Денеңізді доғалап, жамбасыңызды көтеріңіз.
Dialogue: 0,0:21:30.83,0:21:34.37,Default,,0,0,0,,«Бұл кешкі ас» деп айтыңыз
Dialogue: 0,0:21:34.45,0:21:36.21,Default,,0,0,0,,Ақымақ болма
Dialogue: 0,0:21:36.29,0:21:38.83,Default,,0,0,0,,Маған ұнағанша күтуім керек пе?
Dialogue: 0,0:21:38.92,0:21:40.46,Default,,0,0,0,,Мүлдем жоқ
Dialogue: 0,0:21:40.54,0:21:41.59,Default,,0,0,0,,Қайдасың?
Dialogue: 0,0:21:41.67,0:21:43.30,Default,,0,0,0,,Олай болса, неге сұрамайсың?
Dialogue: 0,0:21:43.38,0:21:44.34,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба?
Dialogue: 0,0:21:44.42,0:21:46.30,Default,,0,0,0,,Өте ұят
Dialogue: 0,0:21:46.38,0:21:47.84,Default,,0,0,0,,Сонда жоқ.
Dialogue: 0,0:21:47.93,0:21:48.68,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:21:48.76,0:21:51.39,Default,,0,0,0,,Сұрағаннан жақсы.
Dialogue: 0,0:21:51.47,0:21:55.10,Default,,0,0,0,,Менің бірдеңе істегенімді қаласаңыз, алдымен оны жасаңыз.
Dialogue: 0,0:21:56.56,0:21:58.98,Default,,0,0,0,,Біреуді күштеп мәжбүрлеу әдепсіз
Dialogue: 0,0:21:59.06,0:22:02.19,Default,,0,0,0,,Мен Эндрюге шабуыл жасадым
Dialogue: 0,0:22:02.27,0:22:03.44,Default,,0,0,0,,Монс пубисті итеріңіз
Dialogue: 0,0:22:03.53,0:22:04.40,Default,,0,0,0,,Чикю?
Dialogue: 0,0:22:04.94,0:22:05.99,Default,,0,0,0,,Чикю?
Dialogue: 0,0:22:06.24,0:22:08.32,Default,,0,0,0,,«Томның мейрамханасы»
Dialogue: 0,0:22:08.36,0:22:11.66,Default,,0,0,0,,«Чикю» дегеніміз не?
Dialogue: 0,0:22:11.74,0:22:13.37,Default,,0,0,0,,Бұл mons pubis па?
Dialogue: 0,0:22:13.45,0:22:17.37,Default,,0,0,0,,Ыңғайлы жердің алдындағы төсеніш
Dialogue: 0,0:22:17.46,0:22:19.54,Default,,0,0,0,,Маған ұнамайтын адам жоқ
Dialogue: 0,0:22:19.62,0:22:21.84,Default,,0,0,0,,Маған да «монс пубис ұнайды»
Dialogue: 0,0:22:22.84,0:22:25.96,Default,,0,0,0,,Көліктің іші араға толы болды.
Dialogue: 0,0:22:27.38,0:22:29.72,Default,,0,0,0,,Бұл ирониялық.
Dialogue: 0,0:22:29.80,0:22:31.68,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:22:32.93,0:22:35.52,Default,,0,0,0,,Пьесадағы бақсы аңы сияқты.
Dialogue: 0,0:22:35.60,0:22:38.14,Default,,0,0,0,,Кім кеште минет алғысы келеді?
Dialogue: 0,0:22:38.23,0:22:39.31,Default,,0,0,0,,Бұл шынымен де жаман ба?
Dialogue: 0,0:22:39.39,0:22:42.40,Default,,0,0,0,,Әкеңіздің кеңсесінің жарнамасын плагиат жасамаңыз.
Dialogue: 0,0:22:42.48,0:22:45.19,Default,,0,0,0,,Мен әйелдерге бәрінен де мейірімдімін
Dialogue: 0,0:22:45.28,0:22:47.36,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:22:47.44,0:22:50.78,Default,,0,0,0,,Бас тартсаң, сен істедің деп өтірік айтады.
Dialogue: 0,0:22:50.86,0:22:53.37,Default,,0,0,0,,Бұл шынымен Рокуденаши.
Dialogue: 0,0:22:53.45,0:22:54.79,Default,,0,0,0,,Ол адам ба?
Dialogue: 0,0:22:54.87,0:22:59.25,Default,,0,0,0,,Бұл жақсы оқу мүмкіндігі болды, бірақ ол жағымсыз оқиғаға айналды.
Dialogue: 0,0:22:59.33,0:23:00.96,Default,,0,0,0,,Егер сіз кінәлі болсаңыз
Dialogue: 0,0:23:01.04,0:23:03.79,Default,,0,0,0,,Партиялық мәдениетті кінәлау
Dialogue: 0,0:23:03.88,0:23:06.55,Default,,0,0,0,,Сен ақымақ жігітсің.
Dialogue: 0,0:23:06.63,0:23:09.26,Default,,0,0,0,,Мен зұлыммын ба? Ұят саған.
Dialogue: 0,0:23:09.93,0:23:10.72,Default,,0,0,0,,Даниел
Dialogue: 0,0:23:10.80,0:23:13.26,Default,,0,0,0,,Үлкен адам болды ма?
Dialogue: 0,0:23:13.35,0:23:15.31,Default,,0,0,0,,Үлкен емес Бұл кішкентай
Dialogue: 0,0:23:15.39,0:23:20.69,Default,,0,0,0,,Бүгін түнде мен коньяк пен ұнтақталған кофе іштім.
Dialogue: 0,0:23:20.77,0:23:23.19,Default,,0,0,0,,Менің сізге айтқым келгені...
Dialogue: 0,0:23:32.32,0:23:34.12,Default,,0,0,0,,Лия, мына қалпақты маған қайтар.
Dialogue: 0,0:23:34.20,0:23:35.08,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:23:35.16,0:23:37.04,Default,,0,0,0,,Сіз ондай адам емессіз.
Dialogue: 0,0:23:37.12,0:23:39.20,Default,,0,0,0,,Жоқ, бұл адам.
Dialogue: 0,0:23:39.29,0:23:40.58,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:23:41.12,0:23:42.37,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:23:42.46,0:23:43.83,Default,,0,0,0,,Партия қасқыры
Dialogue: 0,0:23:46.34,0:23:48.92,Default,,0,0,0,,«Кілем төбесін» көруге барсам...
Dialogue: 0,0:23:49.01,0:23:51.63,Default,,0,0,0,,Мұндай фильм жоқ.
Dialogue: 0,0:23:51.72,0:23:52.26,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:23:52.34,0:23:56.43,Default,,0,0,0,,Сіз шынымен де қателескен жоқсыз.
Dialogue: 0,0:23:56.51,0:23:59.93,Default,,0,0,0,,Мен айналамдағыларға қауіпті әйелмін.
Dialogue: 0,0:24:00.02,0:24:01.10,Default,,0,0,0,,Жоқ, мен...
Dialogue: 0,0:24:01.18,0:24:02.27,Default,,0,0,0,,Әкелер
Dialogue: 0,0:24:02.35,0:24:04.06,Default,,0,0,0,,Әрқашан ерте келіңіз
Dialogue: 0,0:24:05.48,0:24:09.15,Default,,0,0,0,,Морис Неліктен бұл өте күрделі?
Dialogue: 0,0:24:09.23,0:24:12.53,Default,,0,0,0,,Мен бірнеше рет айтқанымдай, Меркурий ретроградтық.
Dialogue: 0,0:24:12.61,0:24:14.03,Default,,0,0,0,,Жұлдыз жорамалдарды оқуды доғарыңыз
Dialogue: 0,0:24:14.11,0:24:16.78,Default,,0,0,0,,Сізде Егіздер сияқты қос тұлға бар.
Dialogue: 0,0:24:16.87,0:24:18.95,Default,,0,0,0,,Мен сенің жаныңдамын
Dialogue: 0,0:24:19.04,0:24:20.70,Default,,0,0,0,,Мен оны таптым
Dialogue: 0,0:24:20.79,0:24:22.75,Default,,0,0,0,,Сен менің үйіме келе жатырсың, солай ма?
Dialogue: 0,0:24:22.83,0:24:23.54,Default,,0,0,0,,Қазір мен романтика туралы ойлауға өзімді дайын сезіне алмаймын.
Dialogue: 0,0:24:23.62,0:24:26.00,Default,,0,0,0,,Менің шұғыл жұмысым бар.
Dialogue: 0,0:24:26.08,0:24:28.13,Default,,0,0,0,,Екі рет мастурбация жасаңыз
Dialogue: 0,0:24:28.21,0:24:29.34,Default,,0,0,0,,Жүріңдер, қандастар.
Dialogue: 0,0:24:30.96,0:24:32.51,Default,,0,0,0,,Кездескенше, бас итеруші.
Dialogue: 0,0:24:33.38,0:24:35.26,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:24:36.09,0:24:38.72,Default,,0,0,0,,Даниелдің көлігіндегі шиналар?
Dialogue: 0,0:24:38.81,0:24:39.35,Default,,0,0,0,,Тіпті араластырсам да—
Dialogue: 0,0:24:39.43,0:24:40.02,Default,,0,0,0,,Панк…
Dialogue: 0,0:24:40.10,0:24:40.68,Default,,0,0,0,,Даниел?
Dialogue: 0,0:24:42.02,0:24:43.27,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:24:43.44,0:24:45.31,Default,,0,0,0,,«Томның мейрамханасы»
Dialogue: 0,0:24:45.52,0:24:48.11,Default,,0,0,0,,Сіз бұл жаңалықты естідіңіз бе?
Dialogue: 0,0:24:48.19,0:24:48.86,Default,,0,0,0,,Не?
Dialogue: 0,0:24:48.94,0:24:51.57,Default,,0,0,0,,Даниел қайтыс болды.
Dialogue: 0,0:24:51.65,0:24:52.74,Default,,0,0,0,,Сіз өлдіңіз бе?
Dialogue: 0,0:24:52.82,0:24:53.36,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:24:53.45,0:24:54.28,Default,,0,0,0,,Мұның себебі неде?
Dialogue: 0,0:24:54.36,0:24:56.87,Default,,0,0,0,,Миыма кәмпит коньяк кірді
Dialogue: 0,0:24:56.95,0:24:59.95,Default,,0,0,0,,Ісік алғаннан кейін екі аптадан кейін,
Dialogue: 0,0:25:00.04,0:25:00.79,Default,,0,0,0,,Эй!
Dialogue: 0,0:25:00.87,0:25:02.87,Default,,0,0,0,,Жерлеу қашан болады?
Dialogue: 0,0:25:02.95,0:25:06.12,Default,,0,0,0,,Ертең, бірақ менің кестем мені итермелейді.
Dialogue: 0,0:25:54.76,0:25:56.76,Default,,0,0,0,,Жапон субтитрлері Нагиса Исозаки
Dialogue: 0,0:25:58.26,0:26:04.26,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
