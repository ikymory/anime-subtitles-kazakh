Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.00,0:00:08.17,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:11.38,0:00:12.88,Default,,0,0,0,,Джесси Әлі емес пе?
Dialogue: 0,0:00:12.97,0:00:15.26,Default,,0,0,0,,Мен не кисем де, келбетім жақсы емес
Dialogue: 0,0:00:15.34,0:00:18.68,Default,,0,0,0,,Сән индустриясының негізгі нүктелері
Dialogue: 0,0:00:18.76,0:00:22.39,Default,,0,0,0,,Малайзияда жасалған киімге көп ақша жұмсау
Dialogue: 0,0:00:22.48,0:00:24.98,Default,,0,0,0,,Балалар еңбегін ынталандыру
Dialogue: 0,0:00:25.06,0:00:27.81,Default,,0,0,0,,Бұл туралы не деуге болады? Саған жарасады.
Dialogue: 0,0:00:27.90,0:00:29.77,Default,,0,0,0,,Бәрін мақтасам да
Dialogue: 0,0:00:29.86,0:00:33.53,Default,,0,0,0,,Жоқ, кейбір киімдер маған жараспайды.
Dialogue: 0,0:00:33.61,0:00:36.36,Default,,0,0,0,,Джесси не болып жатыр?
Dialogue: 0,0:00:36.45,0:00:39.12,Default,,0,0,0,,Сүйіскеннен кейін кездестік пе?
Dialogue: 0,0:00:39.20,0:00:43.25,Default,,0,0,0,,Маған иттің балық аулағаны туралы видео жіберілді.
Dialogue: 0,0:00:43.33,0:00:45.42,Default,,0,0,0,,Мен саған қызығамын
Dialogue: 0,0:00:45.50,0:00:49.13,Default,,0,0,0,,Ол пальтомен балық аулап жүрген ит.
Dialogue: 0,0:00:49.21,0:00:49.92,Default,,0,0,0,,Мен оны көрдім
Dialogue: 0,0:00:50.00,0:00:51.63,Default,,0,0,0,,Қалжың болып көріну...
Dialogue: 0,0:00:51.71,0:00:52.84,Default,,0,0,0,,Сіз байсалдысыз.
Dialogue: 0,0:00:52.92,0:00:54.72,Default,,0,0,0,,Қалай жауап беруге болады
Dialogue: 0,0:00:55.26,0:00:57.84,Default,,0,0,0,,Маған сенің суретін жібер
Dialogue: 0,0:00:57.93,0:01:01.18,Default,,0,0,0,,Сізді кенеттен жіберсе, әйелдер қуанады.
Dialogue: 0,0:01:34.42,0:01:35.59,Default,,0,0,0,,«Экскурсия»
Dialogue: 0,0:01:35.67,0:01:37.38,Default,,0,0,0,,Экскурсиялар ең жақсысы
Dialogue: 0,0:01:37.47,0:01:40.35,Default,,0,0,0,,Көптеген ақымақтар рұқсаттарын ұмытады.
Dialogue: 0,0:01:40.43,0:01:44.14,Default,,0,0,0,,Сәлем Девин және Девин ака «Дэвинс»
Dialogue: 0,0:01:44.22,0:01:45.14,Default,,0,0,0,,Тіпті «Девиндер»
Dialogue: 0,0:01:45.23,0:01:47.98,Default,,0,0,0,,Супер жұп күткендей
Dialogue: 0,0:01:48.06,0:01:51.11,Default,,0,0,0,,Жарыс шынымен де маңызды емес.
Dialogue: 0,0:01:51.19,0:01:53.73,Default,,0,0,0,,Ник Джесси туралы не деуге болады?
Dialogue: 0,0:01:53.82,0:01:55.90,Default,,0,0,0,,Ғашық болғанға жарайды.
Dialogue: 0,0:01:55.99,0:01:57.20,Default,,0,0,0,,Сіз кездесіп жүрсіз бе?
Dialogue: 0,0:01:58.53,0:02:03.58,Default,,0,0,0,,Тыңда, Ник, сен қызықсың, бірақ тартымсызсың.
Dialogue: 0,0:02:03.66,0:02:05.50,Default,,0,0,0,,«Қызықты» жеткілікті ме?
Dialogue: 0,0:02:05.58,0:02:09.62,Default,,0,0,0,,Джесси - өсіп келе жатқан акция. Ақылды әйелдер қазір танымал.
Dialogue: 0,0:02:09.71,0:02:11.42,Default,,0,0,0,,Сізге қарсылас ретінде қарамайды.
Dialogue: 0,0:02:11.50,0:02:14.67,Default,,0,0,0,,Мен Никтің сүйкімділігін бірте-бірте түсіне аламын.
Dialogue: 0,0:02:14.75,0:02:16.13,Default,,0,0,0,,Ал сіз
Dialogue: 0,0:02:16.21,0:02:17.59,Default,,0,0,0,,Менің аузым сырғып кетті.
Dialogue: 0,0:02:17.67,0:02:20.51,Default,,0,0,0,,Сіз жұптар орындығына отыруыңыз үшін
Dialogue: 0,0:02:20.59,0:02:25.56,Default,,0,0,0,,Менің лесбиянканы тастап, Джессимен шығудан басқа амалым жоқ.
Dialogue: 0,0:02:25.64,0:02:27.43,Default,,0,0,0,,Қараңызшы, бұл жақсы.
Dialogue: 0,0:02:27.52,0:02:31.65,Default,,0,0,0,,Бұл шорттардың жақсы бөксесі бар.
Dialogue: 0,0:02:31.73,0:02:33.73,Default,,0,0,0,,Нағашымның қолы
Dialogue: 0,0:02:33.82,0:02:35.48,Default,,0,0,0,,Қайырлы таң Джесси
Dialogue: 0,0:02:35.57,0:02:37.19,Default,,0,0,0,,Қайырлы таң, а...құшақтасыңдар ма?
Dialogue: 0,0:02:37.28,0:02:38.03,Default,,0,0,0,,Дұрыс емес пе?
Dialogue: 0,0:02:38.11,0:02:39.95,Default,,0,0,0,,Жоқ, бәрі жақсы.
Dialogue: 0,0:02:40.03,0:02:41.36,Default,,0,0,0,,Бұл солай ма?
Dialogue: 0,0:02:41.45,0:02:44.08,Default,,0,0,0,,Осыны қолданып көрсеңіз қалай болады?
Dialogue: 0,0:02:44.99,0:02:48.33,Default,,0,0,0,,Міне, сүйкімді, бұл жастық шақ.
Dialogue: 0,0:02:48.41,0:02:51.17,Default,,0,0,0,,Орташа американдық азамат үшін
Dialogue: 0,0:02:51.25,0:02:54.09,Default,,0,0,0,,Бұл «сүйкімді» болуы керек
Dialogue: 0,0:02:54.17,0:02:56.84,Default,,0,0,0,,Екеуің кездесіп жүрсіңдер ме?
Dialogue: 0,0:03:02.30,0:03:05.47,Default,,0,0,0,,Жарайды, қызық болып барады.
Dialogue: 0,0:03:05.56,0:03:07.22,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:03:07.93,0:03:10.14,Default,,0,0,0,,Сіз не айтасыз? Біз...
Dialogue: 0,0:03:10.23,0:03:11.94,Default,,0,0,0,,Сіз кездесіп жүрсіз бе?
Dialogue: 0,0:03:15.36,0:03:17.07,Default,,0,0,0,,Ол жұптарға толы.
Dialogue: 0,0:03:17.15,0:03:21.40,Default,,0,0,0,,Ник пен Джесси анасы және хоспис медбикесі
Dialogue: 0,0:03:21.49,0:03:22.91,Default,,0,0,0,,Махаббатқа толы
Dialogue: 0,0:03:22.99,0:03:27.29,Default,,0,0,0,,Ішінде свастика оюы жоқ орынды іздеңіз.
Dialogue: 0,0:03:27.37,0:03:30.50,Default,,0,0,0,,Ник! жұп артқы жағында
Dialogue: 0,0:03:31.46,0:03:33.88,Default,,0,0,0,,Біз бірге отыруымыз керек.
Dialogue: 0,0:03:33.96,0:03:35.17,Default,,0,0,0,,Артқы орындықта?
Dialogue: 0,0:03:35.25,0:03:36.00,Default,,0,0,0,,Иә
Dialogue: 0,0:03:36.21,0:03:38.00,Default,,0,0,0,,Қарсысыз ба?
Dialogue: 0,0:03:38.09,0:03:39.26,Default,,0,0,0,,Әрине
Dialogue: 0,0:03:39.34,0:03:43.13,Default,,0,0,0,,Артқы орындықтар жұптар мен мүгедектер арбаларына арналған.
Dialogue: 0,0:03:43.22,0:03:45.35,Default,,0,0,0,,Өзін тең етіп көрсету
Dialogue: 0,0:03:45.43,0:03:48.68,Default,,0,0,0,,Бұл артқы жағынан жүктейді.
Dialogue: 0,0:03:48.77,0:03:51.10,Default,,0,0,0,,Мен вакцинацияға жаяу бардым.
Dialogue: 0,0:03:51.18,0:03:54.02,Default,,0,0,0,,Джесси Ник, қош келдіңіз.
Dialogue: 0,0:03:54.10,0:03:56.90,Default,,0,0,0,,Мен үшін уайымдама, бар.
Dialogue: 0,0:03:56.98,0:03:58.36,Default,,0,0,0,,Бұл қандай жер...
Dialogue: 0,0:03:58.44,0:03:58.98,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:03:59.07,0:04:00.74,Default,,0,0,0,,Маған кейінірек айтыңыз
Dialogue: 0,0:04:01.11,0:04:01.90,Default,,0,0,0,,Бұл тек болжам ғана, айтпақшы.
Dialogue: 0,0:04:01.99,0:04:04.11,Default,,0,0,0,,Мейірімділігіңіз үшін рахмет.
Dialogue: 0,0:04:05.11,0:04:07.12,Default,,0,0,0,,Саған жақсы, жігітім.
Dialogue: 0,0:04:07.20,0:04:08.74,Default,,0,0,0,,Жағымсыз сезім
Dialogue: 0,0:04:08.83,0:04:10.75,Default,,0,0,0,,Қыздың қасына отыруға болады
Dialogue: 0,0:04:10.83,0:04:15.46,Default,,0,0,0,,Бұл сіздің жамбасыңызға немесе кеудеге кездейсоқ тиіп кету мүмкіндігіңіз.
Dialogue: 0,0:04:15.54,0:04:17.46,Default,,0,0,0,,Джей мұны біледі.
Dialogue: 0,0:04:17.54,0:04:18.71,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:04:18.80,0:04:19.38,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:04:19.46,0:04:20.05,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:04:20.13,0:04:21.59,Default,,0,0,0,,Бұл солай болуы мүмкін.
Dialogue: 0,0:04:21.67,0:04:24.01,Default,,0,0,0,,Неге менімен бірге шықпайсың?
Dialogue: 0,0:04:24.09,0:04:26.72,Default,,0,0,0,,Тез отырыңдар, кеш болады
Dialogue: 0,0:04:26.80,0:04:30.35,Default,,0,0,0,,Сіз атмосфераны оқи алмайсыз. Сіз баланың қасында бола алмайсыз.
Dialogue: 0,0:04:30.43,0:04:31.85,Default,,0,0,0,,Менен бірдеңе керек пе?
Dialogue: 0,0:04:31.93,0:04:33.98,Default,,0,0,0,,Жаныңда құбыжық бар
Dialogue: 0,0:04:34.06,0:04:35.31,Default,,0,0,0,,Йорошику на
Dialogue: 0,0:04:36.56,0:04:38.06,Default,,0,0,0,,Мына қыз жақсы екен
Dialogue: 0,0:04:38.15,0:04:41.44,Default,,0,0,0,,Би билеп шығып кеткен мына бала.
Dialogue: 0,0:04:41.53,0:04:44.07,Default,,0,0,0,,Мен қоғамдық эякуляцияны ұмытып кеттім.
Dialogue: 0,0:04:44.20,0:04:45.03,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:04:45.15,0:04:46.07,Default,,0,0,0,,Ұмытасың ба?
Dialogue: 0,0:04:50.54,0:04:53.00,Default,,0,0,0,,Мен оны бәрібір байқамаймын
Dialogue: 0,0:04:53.08,0:04:55.96,Default,,0,0,0,,Мына рюкзакқа қараңдар.
Dialogue: 0,0:04:56.04,0:04:58.13,Default,,0,0,0,,Көкеші қуыршақтарына толы
Dialogue: 0,0:04:58.21,0:05:00.63,Default,,0,0,0,,Эндрю Сіз Scrabble ойнайсыз ба?
Dialogue: 0,0:05:02.13,0:05:04.26,Default,,0,0,0,,Мен сізді шақырамын
Dialogue: 0,0:05:04.76,0:05:07.30,Default,,0,0,0,,Чикусо! Бұл жалғаса берсе...
Dialogue: 0,0:05:07.39,0:05:08.55,Default,,0,0,0,,Отырыңыз
Dialogue: 0,0:05:08.64,0:05:11.14,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,0:05:11.26,0:05:12.89,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:05:12.97,0:05:15.48,Default,,0,0,0,,Дұрыс, боқ болса да тамшылап тұр
Dialogue: 0,0:05:15.56,0:05:17.56,Default,,0,0,0,,Сіздің қызыңыз бар ма?
Dialogue: 0,0:05:17.65,0:05:21.19,Default,,0,0,0,,Мен қазір мұнда емеспін... мен бұрын да болған емеспін.
Dialogue: 0,0:05:21.27,0:05:23.99,Default,,0,0,0,,Мен сүйген бір ғана әйел бар
Dialogue: 0,0:05:24.07,0:05:27.11,Default,,0,0,0,,Ол жасыл және өте ұзын.
Dialogue: 0,0:05:27.20,0:05:29.24,Default,,0,0,0,,Яғни, Бостандық мүсіні.
Dialogue: 0,0:05:29.32,0:05:32.45,Default,,0,0,0,,«Бүгінгі экскурсиялық орын» ретінде де белгілі
Dialogue: 0,0:05:32.54,0:05:33.79,Default,,0,0,0,,Басқа аты-
Dialogue: 0,0:05:33.87,0:05:37.50,Default,,0,0,0,,«Американдық мифтерді құрастырудың мысалы»
Dialogue: 0,0:05:37.58,0:05:40.88,Default,,0,0,0,,Олар бұл елді жергілікті тұрғындардан ұрлады.
Dialogue: 0,0:05:40.96,0:05:44.21,Default,,0,0,0,,Мұғалімдер шынымен де терең.
Dialogue: 0,0:05:44.30,0:05:48.43,Default,,0,0,0,,Жергілікті тұрғындар Алғыс айту күні үшін өз елін берді.
Dialogue: 0,0:05:48.51,0:05:51.43,Default,,0,0,0,,Бірдеңе айтуға кеш.
Dialogue: 0,0:05:51.51,0:05:53.10,Default,,0,0,0,,Бұл әзіл
Dialogue: 0,0:05:53.18,0:05:54.68,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:05:57.98,0:06:02.44,Default,,0,0,0,,Мен өзімді VIP сияқты сезінемін, өйткені мен артқы орындықта отырмын.
Dialogue: 0,0:06:02.52,0:06:05.32,Default,,0,0,0,,Сіз шырын немесе шампан алғыңыз келе ме?
Dialogue: 0,0:06:05.40,0:06:07.07,Default,,0,0,0,,Тіпті көлік ішінде қызмет көрсету ме?
Dialogue: 0,0:06:07.15,0:06:09.32,Default,,0,0,0,,Ол жүргізушінің ұлы.
Dialogue: 0,0:06:09.41,0:06:14.41,Default,,0,0,0,,Жаңа пісірілген печеньелерді де кейінірек береміз.
Dialogue: 0,0:06:18.21,0:06:19.96,Default,,0,0,0,,Солайсыңдар ма, балалар?
Dialogue: 0,0:06:20.83,0:06:22.54,Default,,0,0,0,,Біз де солай істеуіміз керек пе?
Dialogue: 0,0:06:22.63,0:06:24.84,Default,,0,0,0,,Оны мәжбүрлеудің қажеті жоқ.
Dialogue: 0,0:06:24.92,0:06:28.13,Default,,0,0,0,,Таң атуға әлі ерте
Dialogue: 0,0:06:28.22,0:06:29.68,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,0:06:30.34,0:06:32.47,Default,,0,0,0,,Дәмі торт сияқты.
Dialogue: 0,0:06:32.55,0:06:36.31,Default,,0,0,0,,Қысқаша қол ұстасу туралы не айтуға болады?
Dialogue: 0,0:06:36.39,0:06:37.64,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:06:37.73,0:06:39.56,Default,,0,0,0,,Оны ішсем ше? Бұл тегін
Dialogue: 0,0:06:42.86,0:06:44.15,Default,,0,0,0,,Ник, бұл бәсекелестік.
Dialogue: 0,0:06:44.23,0:06:47.86,Default,,0,0,0,,Ерлер мен әйелдерге арналған бағыттарды бөліп, жоғарғы жағында кездесіңіз.
Dialogue: 0,0:06:47.94,0:06:50.28,Default,,0,0,0,,Жұп суретке түсіру
Dialogue: 0,0:06:50.36,0:06:51.70,Default,,0,0,0,,Негізінен, біз қашамыз.
Dialogue: 0,0:06:51.78,0:06:52.70,Default,,0,0,0,,Жұп сурет?
Dialogue: 0,0:06:52.78,0:06:56.29,Default,,0,0,0,,Инстаграмды мазақ қылсам да?
Dialogue: 0,0:06:56.37,0:06:59.83,Default,,0,0,0,,Мен сенімді болдым, бірақ мен ойымды өзгерттім.
Dialogue: 0,0:07:00.41,0:07:05.25,Default,,0,0,0,,Жарайды, жоғарыда кездесіп, «жұптық суретке» түсейік.
Dialogue: 0,0:07:09.30,0:07:11.18,Default,,0,0,0,,Тастап кеттіңіз бе?
Dialogue: 0,0:07:11.26,0:07:14.22,Default,,0,0,0,,Оған көмектесу мүмкін емес, өйткені біз жұппыз.
Dialogue: 0,0:07:14.30,0:07:19.31,Default,,0,0,0,,Мен жарқыраған оргия лақтырамын.
Dialogue: 0,0:07:19.43,0:07:21.35,Default,,0,0,0,,Сен бұрышта жұлқынып кетесің
Dialogue: 0,0:07:21.44,0:07:24.98,Default,,0,0,0,,Оргия куәгерді қажет етеді.
Dialogue: 0,0:07:25.06,0:07:27.78,Default,,0,0,0,,Ник өзінің туған күнін есіне алады ма?
Dialogue: 0,0:07:28.32,0:07:28.86,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:07:28.94,0:07:31.65,Default,,0,0,0,,Бұл жұптар үшін ең маңызды күн.
Dialogue: 0,0:07:31.74,0:07:34.99,Default,,0,0,0,,Девин, мен сенімен сөйлесуім керек, тек екеуміз ғана.
Dialogue: 0,0:07:35.07,0:07:35.87,Default,,0,0,0,,Қалай болғанда да, ең алдымен мен Мими-уэге жақындауым керек, бірақ
Dialogue: 0,0:07:35.95,0:07:40.29,Default,,0,0,0,,Мен біреумен сөйлескенде қызғанышпен қараймын.
Dialogue: 0,0:07:43.92,0:07:45.33,Default,,0,0,0,,Менің ойымша, оған көмектесу мүмкін емес ...
Dialogue: 0,0:07:45.42,0:07:48.96,Default,,0,0,0,,Джей, сен не істеп жатырсың? Бірге өрмелеп көрейік
Dialogue: 0,0:07:49.05,0:07:52.80,Default,,0,0,0,,Фокустарға шоғырлануды жақсарту
Dialogue: 0,0:07:52.88,0:07:53.68,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:53.76,0:07:55.60,Default,,0,0,0,,Қандай айла?
Dialogue: 0,0:07:55.68,0:08:00.60,Default,,0,0,0,,Бұл Копперфилдтің әйгілі иллюзиясының рекреациясы.
Dialogue: 0,0:08:00.68,0:08:04.77,Default,,0,0,0,,Бостандық мүсінін жоғалтыңыз
Dialogue: 0,0:08:04.85,0:08:06.06,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:08:06.15,0:08:07.69,Default,,0,0,0,,О, мен Таяу Шығыстанмын.
Dialogue: 0,0:08:07.77,0:08:11.36,Default,,0,0,0,,Түсіндім, қаласаң көмектесемін.
Dialogue: 0,0:08:11.44,0:08:13.82,Default,,0,0,0,,Неге бәрің менен қашып жүрсіңдер?
Dialogue: 0,0:08:13.91,0:08:16.37,Default,,0,0,0,,Өйткені оның иісі еврейге ұқсайды.
Dialogue: 0,0:08:17.20,0:08:20.83,Default,,0,0,0,,Жігіт нақты не істейді?
Dialogue: 0,0:08:20.91,0:08:26.46,Default,,0,0,0,,Мен әрқашан дос қызымның сабақ алдында және сабақтан кейін, түскі үзіліс кезінде және ұйықтар алдында жанында боламын.
Dialogue: 0,0:08:26.54,0:08:27.38,Default,,0,0,0,,Шаршаған көрінеді
Dialogue: 0,0:08:27.46,0:08:29.00,Default,,0,0,0,,Ең жақсы
Dialogue: 0,0:08:29.09,0:08:30.76,Default,,0,0,0,,ымыраға келу керек.
Dialogue: 0,0:08:30.84,0:08:31.38,Default,,0,0,0,,басқа біреудің ұялы телефоны қоңырау шалғанда шыдай алмаймын.
Dialogue: 0,0:08:31.46,0:08:35.80,Default,,0,0,0,,Мен ол үшін өз есімімді Девоннан Девинге ауыстырдым.
Dialogue: 0,0:08:35.89,0:08:37.72,Default,,0,0,0,,Бұл туралы айтатын болсақ, бұл Девон.
Dialogue: 0,0:08:37.80,0:08:39.43,Default,,0,0,0,,Мен мұны істей аламын ба деп ойлаймын ...
Dialogue: 0,0:08:39.51,0:08:41.64,Default,,0,0,0,,Жақында үйреніп кетесің, Джесси.
Dialogue: 0,0:08:41.72,0:08:42.56,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:42.98,0:08:45.23,Default,,0,0,0,,Ақыры Ник табылды ма?
Dialogue: 0,0:08:45.31,0:08:46.44,Default,,0,0,0,,Мен сенің жоғалып кеткеніңді қалаймын.
Dialogue: 0,0:08:46.52,0:08:48.11,Default,,0,0,0,,Сіз кездесіп жүрсіз бе?
Dialogue: 0,0:08:48.19,0:08:51.90,Default,,0,0,0,,Жай ғана сүйісу және екі электрондық хат
Dialogue: 0,0:08:51.98,0:08:54.70,Default,,0,0,0,,Жұп және автобустың артқы орындығы.
Dialogue: 0,0:08:54.78,0:08:55.78,Default,,0,0,0,,Мүгедектер арбалары да
Dialogue: 0,0:08:55.86,0:08:56.78,Default,,0,0,0,,Мас адам.
Dialogue: 0,0:08:56.86,0:08:58.82,Default,,0,0,0,,Итті балық аулауға жіберді
Dialogue: 0,0:08:58.91,0:09:00.87,Default,,0,0,0,,Сіз тіпті мазмұнын білесіз бе?
Dialogue: 0,0:09:00.95,0:09:02.41,Default,,0,0,0,,Аузы сырғып кетті
Dialogue: 0,0:09:02.50,0:09:03.83,Default,,0,0,0,,Эндрю, менімен сөйлес.
Dialogue: 0,0:09:03.91,0:09:08.13,Default,,0,0,0,,Бірақ дәл қазір сен менің досымның әйелісің.
Dialogue: 0,0:09:08.21,0:09:11.30,Default,,0,0,0,,«Әйел» деген не? Жетеді
Dialogue: 0,0:09:11.42,0:09:12.09,Default,,0,0,0,,Енді жұмысқа аттанатын уақыт келді ғой?
Dialogue: 0,0:09:12.17,0:09:12.71,Default,,0,0,0,,Мен оларды шаруамен жібердім.
Dialogue: 0,0:09:12.80,0:09:15.80,Default,,0,0,0,,Сіз балмұздақтың үстінде отырдыңыз ба?
Dialogue: 0,0:09:19.22,0:09:21.97,Default,,0,0,0,,Мен де отырдым.
Dialogue: 0,0:09:22.06,0:09:24.48,Default,,0,0,0,,Мен дереу ваннаға баруым керек.
Dialogue: 0,0:09:24.56,0:09:26.89,Default,,0,0,0,,Амансың ба? Мен де барамын
Dialogue: 0,0:09:26.98,0:09:29.19,Default,,0,0,0,,Мен әдейі отырдым.
Dialogue: 0,0:09:29.27,0:09:30.65,Default,,0,0,0,,Мен өзімді салқын сезінгім келеді
Dialogue: 0,0:09:30.73,0:09:33.82,Default,,0,0,0,,Білесің бе, менің тілім құрғақ.
Dialogue: 0,0:09:34.86,0:09:38.86,Default,,0,0,0,,Әр сағат сайын ылғалдану керек
Dialogue: 0,0:09:38.95,0:09:42.66,Default,,0,0,0,,Мен балмұздақ жеу бақытына ие болдым.
Dialogue: 0,0:09:45.12,0:09:48.71,Default,,0,0,0,,Жақсысың ба? Үлкенді шақырайын ба?
Dialogue: 0,0:09:48.79,0:09:51.54,Default,,0,0,0,,Ешқашан жаттықтырушыны шақырмаңыз
Dialogue: 0,0:09:51.63,0:09:55.72,Default,,0,0,0,,Жоқ, бұл өтірік. Мұндай ештеңе жоқ.
Dialogue: 0,0:09:55.80,0:10:01.18,Default,,0,0,0,,Бостандық мүсінінде алғашқы етеккірімді алғаныма сене алар емеспін!
Dialogue: 0,0:10:01.76,0:10:04.52,Default,,0,0,0,,Мен бір нәрсені іздеуім керек
Dialogue: 0,0:10:04.60,0:10:06.14,Default,,0,0,0,,Бұл өтірік емес пе?
Dialogue: 0,0:10:06.93,0:10:09.19,Default,,0,0,0,,Мен сенбеймін, бұл ең сорақысы
Dialogue: 0,0:10:10.56,0:10:14.19,Default,,0,0,0,,Неліктен әйелдерді жек көретін Садад әкімшісі де бар?
Dialogue: 0,0:10:14.28,0:10:18.95,Default,,0,0,0,,Мені тастап кетуге қалай дәтің бар! Мен әйелдерді жек көремін!
Dialogue: 0,0:10:19.03,0:10:20.78,Default,,0,0,0,,Джесси, не болды?
Dialogue: 0,0:10:20.87,0:10:24.20,Default,,0,0,0,,Расында, сөмке шабарманның денесінде жыртылып кеткен бе?
Dialogue: 0,0:10:24.29,0:10:25.37,Default,,0,0,0,,Бірдеңе айт
Dialogue: 0,0:10:26.20,0:10:29.33,Default,,0,0,0,,Эндрю, кіріңіз.
Dialogue: 0,0:10:29.42,0:10:30.12,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:10:30.21,0:10:31.08,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:10:33.25,0:10:34.92,Default,,0,0,0,,Не, сол баяғы...
Dialogue: 0,0:10:35.00,0:10:35.84,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:35.92,0:10:39.84,Default,,0,0,0,,Мен ешқашан еркекке айта алмаймын, бірақ егер сіз...
Dialogue: 0,0:10:39.93,0:10:40.89,Default,,0,0,0,,Ауырады.
Dialogue: 0,0:10:40.97,0:10:42.55,Default,,0,0,0,,Менің етеккірім келді.
Dialogue: 0,0:10:44.06,0:10:45.22,Default,,0,0,0,,Штаб оның шамамен төрт айда сегіз «Стелла» жинайтынын болжайды, бірақ
Dialogue: 0,0:10:47.93,0:10:49.56,Default,,0,0,0,,Дәретхана қағазын алыңыз
Dialogue: 0,0:10:49.64,0:10:51.10,Default,,0,0,0,,Ол жоқ!
Dialogue: 0,0:10:53.81,0:10:56.48,Default,,0,0,0,,Мисси, сен Джессиді көрмедің бе?
Dialogue: 0,0:10:56.57,0:10:59.90,Default,,0,0,0,,Мен оны көрмедім, бірақ сол жаққа қараңыз.
Dialogue: 0,0:10:59.99,0:11:05.16,Default,,0,0,0,,Сіз миллиондаған иммигранттарға арналған шлюз Эллис аралын көре аласыз.
Dialogue: 0,0:11:05.24,0:11:10.00,Default,,0,0,0,,Көп адам көз ауруына байланысты кері қайтарылды
Dialogue: 0,0:11:10.08,0:11:11.75,Default,,0,0,0,,Сіз оны көрмедіңіз.
Dialogue: 0,0:11:13.25,0:11:15.29,Default,,0,0,0,,Бұл американдық арман.
Dialogue: 0,0:11:15.38,0:11:17.38,Default,,0,0,0,,Бос теңіздің түбінен
Dialogue: 0,0:11:17.46,0:11:21.55,Default,,0,0,0,,Ол сондай үлкен мүсінге айналды.
Dialogue: 0,0:11:21.63,0:11:24.55,Default,,0,0,0,,Бұл Франциядан келген сыйлық.
Dialogue: 0,0:11:24.64,0:11:26.51,Default,,0,0,0,,Бұл империализмнің символы.
Dialogue: 0,0:11:26.60,0:11:31.02,Default,,0,0,0,,Мен колледжде француз екенімді білмедім.
Dialogue: 0,0:11:31.10,0:11:31.64,Default,,0,0,0,,Қайда?
Dialogue: 0,0:11:31.73,0:11:32.40,Default,,0,0,0,,Apex Tech
Dialogue: 0,0:11:32.48,0:11:33.02,Default,,0,0,0,,Қайда?
Dialogue: 0,0:11:33.10,0:11:34.27,Default,,0,0,0,,Оқуға қосымша
Dialogue: 0,0:11:34.36,0:11:34.90,Default,,0,0,0,,Қайда?
Dialogue: 0,0:11:34.98,0:11:36.82,Default,,0,0,0,,Мен оны интернеттен оқыдым.
Dialogue: 0,0:11:37.02,0:11:37.57,Default,,0,0,0,,Сауатсыз
Dialogue: 0,0:11:37.65,0:11:38.32,Default,,0,0,0,,Мен білгенмін
Dialogue: 0,0:11:38.40,0:11:41.45,Default,,0,0,0,,Бетіңізде «Мен сене алмаймын».
Dialogue: 0,0:11:41.53,0:11:42.82,Default,,0,0,0,,Джесси қайда?
Dialogue: 0,0:11:42.91,0:11:43.78,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:11:43.86,0:11:45.37,Default,,0,0,0,,Қалтаңда не бар?
Dialogue: 0,0:11:45.45,0:11:47.70,Default,,0,0,0,,Мен Эндрюмен бірге ваннаға бардым.
Dialogue: 0,0:11:47.79,0:11:51.71,Default,,0,0,0,,Мен бүгін ваннаға бара жатқан тағы кімдерді көрдім?
Dialogue: 0,0:11:51.79,0:11:54.46,Default,,0,0,0,,Эрик Кевин Саша
Dialogue: 0,0:11:54.96,0:11:57.00,Default,,0,0,0,,Саша да кетті ме?
Dialogue: 0,0:11:57.09,0:11:59.88,Default,,0,0,0,,Мен не істеуім керек? Не істеуім керек... Ауырды ма?
Dialogue: 0,0:11:59.96,0:12:01.30,Default,,0,0,0,,Мен өзімді жақсы сезінбеймін.
Dialogue: 0,0:12:01.38,0:12:02.26,Default,,0,0,0,,Өте үлкен
Dialogue: 0,0:12:02.34,0:12:06.26,Default,,0,0,0,,Сыйлық дүкенінен санитарлық өнімдерді сатып алыңыз.
Dialogue: 0,0:12:06.35,0:12:09.06,Default,,0,0,0,,Жарайды, бұл түбіртек төлемі, солай ма?
Dialogue: 0,0:12:09.14,0:12:10.98,Default,,0,0,0,,Менің қынаптан қан кетіп жатыр.
Dialogue: 0,0:12:11.06,0:12:11.85,Default,,0,0,0,,Өзіңізді емдеңіз
Dialogue: 0,0:12:13.85,0:12:15.69,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:12:20.15,0:12:21.49,Default,,0,0,0,,Сәлем Джесси
Dialogue: 0,0:12:21.57,0:12:27.16,Default,,0,0,0,,Әйелдер атынан мен сізді етеккір келісіміне қош келдіңіздер.
Dialogue: 0,0:12:27.24,0:12:29.58,Default,,0,0,0,,Керемет, бұл әйел.
Dialogue: 0,0:12:29.66,0:12:33.00,Default,,0,0,0,,Мен қатты қан кетіп жатқандықтан қорықтым.
Dialogue: 0,0:12:33.08,0:12:34.25,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:12:34.92,0:12:36.92,Default,,0,0,0,,Ер жеткен әйелдер аянышты
Dialogue: 0,0:12:37.00,0:12:41.17,Default,,0,0,0,,Жақсы адам мені қаламаған жүкті етеді.
Dialogue: 0,0:12:41.26,0:12:43.01,Default,,0,0,0,,Түпкі мәселе - етеккір кезіндегі ауырсыну
Dialogue: 0,0:12:43.76,0:12:46.43,Default,,0,0,0,,Мен қазіргідей қалғым келеді.
Dialogue: 0,0:12:46.51,0:12:50.10,Default,,0,0,0,,Өзгеріс сіз қаламасаңыз да келеді.
Dialogue: 0,0:12:50.18,0:12:55.02,Default,,0,0,0,,Көгершін боп иығыма мініп, блять
Dialogue: 0,0:12:56.19,0:12:57.56,Default,,0,0,0,,көңілін қалдыратын нәрсе
Dialogue: 0,0:12:57.65,0:13:00.90,Default,,0,0,0,,Америкаға ұқсамағаныңыз өкінішті.
Dialogue: 0,0:13:00.98,0:13:04.03,Default,,0,0,0,,Микки Маусты блять
Dialogue: 0,0:13:04.11,0:13:08.49,Default,,0,0,0,,Сен енді әйелсің, қайта алмайсың.
Dialogue: 0,0:13:08.57,0:13:11.58,Default,,0,0,0,,Әйел болудың жақсы жағы бар емес пе?
Dialogue: 0,0:13:11.66,0:13:16.62,Default,,0,0,0,,Егер бақытыңыз болса, сіз метродағы жаппай устрицаларға гарнир бола аласыз.
Dialogue: 0,0:13:16.71,0:13:18.13,Default,,0,0,0,,Басқаша айтқанда, жоқ.
Dialogue: 0,0:13:20.38,0:13:22.34,Default,,0,0,0,,Қалтаңыздағыны алыңыз
Dialogue: 0,0:13:22.42,0:13:25.67,Default,,0,0,0,,Менің оны өшіретін ойым болған жоқ.
Dialogue: 0,0:13:25.76,0:13:29.55,Default,,0,0,0,,Әй, мұнымен не істемекші едің?
Dialogue: 0,0:13:29.85,0:13:33.31,Default,,0,0,0,,Бұл жай ғана сиқыр. Маған дәлелді көрсет.
Dialogue: 0,0:13:36.23,0:13:38.94,Default,,0,0,0,,Мен таң қалдым! Қандай талант!
Dialogue: 0,0:13:39.02,0:13:41.57,Default,,0,0,0,,Бұрын келген Қода Қобыдан артық.
Dialogue: 0,0:13:41.57,0:13:42.15,Default,,0,0,0,,Алдыңғы келген Қода Қобыдан артық.
Dialogue: 0,0:13:41.57,0:13:42.15,Default,,0,0,0,,〝Бұл өте қызық болды. Хода Кобиден〞
Dialogue: 0,0:13:42.15,0:13:42.23,Default,,0,0,0,,〝Бұл өте қызық болды. Хода Кобиден〞
Dialogue: 0,0:13:42.23,0:13:45.90,Default,,0,0,0,,〝Бұл өте қызық болды. Хода Кобиден〞
Dialogue: 0,0:13:42.23,0:13:45.90,Default,,0,0,0,,Хода Қобы «БҮГІН» ақпараттық бағдарламасынан ма?
Dialogue: 0,0:13:45.90,0:13:46.90,Default,,0,0,0,,〝Бұл өте қызық болды. Хода Кобиден〞
Dialogue: 0,0:13:46.99,0:13:47.70,Default,,0,0,0,,Тағы бірдеңе бар ма?
Dialogue: 0,0:13:47.78,0:13:50.16,Default,,0,0,0,,Қулықты қалай көрсету керек
Dialogue: 0,0:13:50.24,0:13:53.41,Default,,0,0,0,,Алдымен қол кісенін алып тастауым керек.
Dialogue: 0,0:13:53.70,0:13:55.04,Default,,0,0,0,,Керемет!
Dialogue: 0,0:13:55.12,0:13:56.29,Default,,0,0,0,,Сіз менің қолыма кісен салдыңыз ба?
Dialogue: 0,0:13:56.37,0:13:57.46,Default,,0,0,0,,Менде жоқ.
Dialogue: 0,0:13:57.54,0:14:01.50,Default,,0,0,0,,Бірдеңе болып қалса мен оны өзіммен бірге алып жүремін.
Dialogue: 0,0:14:01.59,0:14:03.75,Default,,0,0,0,,Кал Пенн тамашасынан
Dialogue: 0,0:14:03.84,0:14:05.88,Default,,0,0,0,,Сіз өзіңізді қарғайтын боласыз
Dialogue: 0,0:14:03.84,0:14:05.88,Default,,0,0,0,,Кал Пенннен «Сотта кездескенше».
Dialogue: 0,0:14:05.88,0:14:05.97,Default,,0,0,0,,Кал Пенннен «Сотта кездескенше».
Dialogue: 0,0:14:05.97,0:14:07.30,Default,,0,0,0,,Кал Пенннен «Сотта кездескенше».
Dialogue: 0,0:14:05.97,0:14:07.30,Default,,0,0,0,,Бля саған!
Dialogue: 0,0:14:07.30,0:14:07.38,Default,,0,0,0,,``Сотта кездескенше'', Кал Пенн
Dialogue: 0,0:14:07.38,0:14:08.72,Default,,0,0,0,,Кал Пенннен «Сотта кездескенше».
Dialogue: 0,0:14:07.38,0:14:08.72,Default,,0,0,0,,Бұл тым көп
Dialogue: 0,0:14:08.80,0:14:12.01,Default,,0,0,0,,Джесси, сен сондасың ба? Бұл Эндрю
Dialogue: 0,0:14:12.10,0:14:12.97,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:14:13.06,0:14:14.06,Default,,0,0,0,,Жақсы
Dialogue: 0,0:14:14.14,0:14:14.97,Default,,0,0,0,,Онда болды ма?
Dialogue: 0,0:14:15.06,0:14:15.64,Default,,0,0,0,,О
Dialogue: 0,0:14:17.31,0:14:20.60,Default,,0,0,0,,Бұл өтірік. Мұнымен не істеуіміз керек? «Мен 11 қыркүйекті ешқашан ұмытпаймын»
Dialogue: 0,0:14:20.69,0:14:24.86,Default,,0,0,0,,Янкилердің вымпелі де болды.
Dialogue: 0,0:14:24.94,0:14:27.28,Default,,0,0,0,,Саған ұнамайды деп ойладым
Dialogue: 0,0:14:27.36,0:14:29.36,Default,,0,0,0,,Өйткені мен Mets жанкүйерімін
Dialogue: 0,0:14:29.45,0:14:29.99,Default,,0,0,0,,Иә.
Dialogue: 0,0:14:30.07,0:14:31.87,Default,,0,0,0,,Барайық Mets!
Dialogue: 0,0:14:31.95,0:14:33.83,Default,,0,0,0,,Басқа адамдар бар ма?
Dialogue: 0,0:14:33.91,0:14:35.49,Default,,0,0,0,,Кеттік, бар күшіңді сал
Dialogue: 0,0:14:35.58,0:14:38.00,Default,,0,0,0,,Кеттік Mets!
Dialogue: 0,0:14:38.08,0:14:39.50,Default,,0,0,0,,«Қайдасың?»
Dialogue: 0,0:14:39.58,0:14:40.88,Default,,0,0,0,,Сізге шағымданатын нәрсе бар ма?
Dialogue: 0,0:14:40.96,0:14:42.29,Default,,0,0,0,,Мен шағымданбаймын.
Dialogue: 0,0:14:42.38,0:14:45.75,Default,,0,0,0,,Мен жай ғана “#Девиндердің” тоқтағанын қалаймын.
Dialogue: 0,0:14:45.84,0:14:46.67,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:14:46.76,0:14:48.34,Default,,0,0,0,,Себебі мен Девонмын!
Dialogue: 0,0:14:49.80,0:14:53.26,Default,,0,0,0,,11 қыркүйектегі орамалды жөргекке айналдыру...
Dialogue: 0,0:14:53.35,0:14:57.35,Default,,0,0,0,,Бұл ең нашар киім таңдау болды.
Dialogue: 0,0:14:57.43,0:14:59.94,Default,,0,0,0,,Осымен бөксеңізді жабыңыз
Dialogue: 0,0:15:00.02,0:15:00.69,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:15:00.77,0:15:01.98,Default,,0,0,0,,Ол жақсы дос.
Dialogue: 0,0:15:03.02,0:15:05.07,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:15:05.15,0:15:07.69,Default,,0,0,0,,Эндрю мен Джессиді көріп тұрсың ба?
Dialogue: 0,0:15:07.78,0:15:08.86,Default,,0,0,0,,Дүрбі?
Dialogue: 0,0:15:08.94,0:15:11.07,Default,,0,0,0,,Туристерді көру
Dialogue: 0,0:15:11.16,0:15:14.24,Default,,0,0,0,,Бұл Minions футболкасы. Бұл күлкілі.
Dialogue: 0,0:15:15.37,0:15:16.70,Default,,0,0,0,,Бұл ненің иісі?
Dialogue: 0,0:15:16.79,0:15:18.29,Default,,0,0,0,,Ештеңе иісі жоқ
Dialogue: 0,0:15:18.66,0:15:19.79,Default,,0,0,0,,Бұл сіздің кезеңіңіз.
Dialogue: 0,0:15:19.87,0:15:22.21,Default,,0,0,0,,Ол шынымен де ең нашар.
Dialogue: 0,0:15:22.29,0:15:25.34,Default,,0,0,0,,«Қанқұмарлық» дәл осы.
Dialogue: 0,0:15:25.42,0:15:26.46,Default,,0,0,0,,Оны міндетті түрде дәл тиетініңе толық сенімді болмасаң, оқ атпа.
Dialogue: 0,0:15:26.55,0:15:27.21,Default,,0,0,0,,Оны айтпа
Dialogue: 0,0:15:27.30,0:15:27.96,Default,,0,0,0,,Бет әлпеті
Dialogue: 0,0:15:28.05,0:15:29.17,Default,,0,0,0,,Не?
Dialogue: 0,0:15:29.76,0:15:31.93,Default,,0,0,0,,Бұл екеуміздің арамыздағы құпия.
Dialogue: 0,0:15:32.01,0:15:36.39,Default,,0,0,0,,Бұл сен, мен және 11 қыркүйектегі алып орамал арасындағы құпия.
Dialogue: 0,0:15:36.47,0:15:37.06,Default,,0,0,0,,Косэй, өзіңді жаман сезініп тұрсың ба?
Dialogue: 0,0:15:37.14,0:15:38.47,Default,,0,0,0,,Мен ешқашан ұмытпаймын!
Dialogue: 0,0:15:38.56,0:15:40.68,Default,,0,0,0,,Сену маңызды
Dialogue: 0,0:15:40.77,0:15:45.73,Default,,0,0,0,,«Дұрыс карта сөзсіз пайда болады».
Dialogue: 0,0:15:45.81,0:15:46.73,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:15:45.81,0:15:46.73,Default,,0,0,0,,«Семіз күзетші»
Dialogue: 0,0:15:46.73,0:15:46.82,Default,,0,0,0,,«Семіз күзетші»
Dialogue: 0,0:15:46.82,0:15:47.82,Default,,0,0,0,,«Семіз күзетші»
Dialogue: 0,0:15:46.82,0:15:47.82,Default,,0,0,0,,Бұл менің қолтаңбам
Dialogue: 0,0:15:47.82,0:15:48.48,Default,,0,0,0,,Бұл менің қолтаңбам
Dialogue: 0,0:15:48.57,0:15:49.86,Default,,0,0,0,,Керемет
Dialogue: 0,0:15:49.94,0:15:51.95,Default,,0,0,0,,Сіз енді босатылдыңыз.
Dialogue: 0,0:15:52.03,0:15:53.45,Default,,0,0,0,,Сиқыр - ең жақсы!
Dialogue: 0,0:15:53.53,0:15:55.95,Default,,0,0,0,,Маған басқа ештеңе керек емес
Dialogue: 0,0:15:57.95,0:16:00.16,Default,,0,0,0,,Мен сені өз басымда күттім.
Dialogue: 0,0:16:00.25,0:16:02.37,Default,,0,0,0,,Мен бұл тәж деп ойладым
Dialogue: 0,0:16:02.46,0:16:05.38,Default,,0,0,0,,Танысу ережелері бар.
Dialogue: 0,0:16:05.46,0:16:06.88,Default,,0,0,0,,Мен ол жайлы білмеймін.
Dialogue: 0,0:16:06.96,0:16:10.42,Default,,0,0,0,,Девинмен бірге күтуге мәжбүр болу
Dialogue: 0,0:16:10.51,0:16:11.51,Default,,0,0,0,,Мені кешіріңіз
Dialogue: 0,0:16:11.59,0:16:12.88,Default,,0,0,0,,Сіз оның жағындасыз ба?
Dialogue: 0,0:16:12.97,0:16:18.56,Default,,0,0,0,,Мен Джессиге тек сен Девинмен бірге болғаның үшін көмектестім.
Dialogue: 0,0:16:18.64,0:16:19.97,Default,,0,0,0,,Көмек беру дегенді қалай түсінесіңдер?
Dialogue: 0,0:16:20.18,0:16:21.48,Default,,0,0,0,,Сен мені құшақтап тұрдың.
Dialogue: 0,0:16:21.56,0:16:22.60,Default,,0,0,0,,Себебі...
Dialogue: 0,0:16:22.69,0:16:23.31,Default,,0,0,0,,Себебі неде?
Dialogue: 0,0:16:23.39,0:16:24.40,Default,,0,0,0,,Менің етеккірім келді
Dialogue: 0,0:16:24.48,0:16:25.23,Default,,0,0,0,,Эндрю!
Dialogue: 0,0:16:26.52,0:16:27.06,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:27.15,0:16:28.77,Default,,0,0,0,,Не үшін өкінесіз?
Dialogue: 0,0:16:28.86,0:16:30.69,Default,,0,0,0,,Сіздің етеккіріңіз келді ме?
Dialogue: 0,0:16:30.78,0:16:34.32,Default,,0,0,0,,Бұл ауру емес, бұл мүлдем қалыпты жағдай.
Dialogue: 0,0:16:34.41,0:16:38.70,Default,,0,0,0,,Басқалардың кезеңі сияқты мен де оны бастан өткердім.
Dialogue: 0,0:16:38.78,0:16:42.33,Default,,0,0,0,,Ақ шорт киген күні!
Dialogue: 0,0:16:42.83,0:16:45.83,Default,,0,0,0,,Не болды?
Dialogue: 0,0:16:45.92,0:16:48.13,Default,,0,0,0,,Пікір айтудан аулақпын.
Dialogue: 0,0:16:48.21,0:16:50.21,Default,,0,0,0,,Бұл балмұздақ емес пе еді?
Dialogue: 0,0:16:50.30,0:16:55.22,Default,,0,0,0,,Бұл атмосферада ештеңе жегім келмейді.
Dialogue: 0,0:16:55.30,0:16:59.18,Default,,0,0,0,,Бұл әр қыз қорқатын қорқынышты түс.
Dialogue: 0,0:16:59.26,0:17:04.69,Default,,0,0,0,,Мен сенің не айтып тұрғаныңды білемін, бірақ сен қатты ұялып тұрсың!
Dialogue: 0,0:17:04.77,0:17:07.69,Default,,0,0,0,,Соңғысы - ақ шалбар.
Dialogue: 0,0:17:07.77,0:17:10.36,Default,,0,0,0,,Мен де автобустан түстім.
Dialogue: 0,0:17:10.44,0:17:13.28,Default,,0,0,0,,Миссидің рюкзактарына мініңіз.
Dialogue: 0,0:17:13.36,0:17:17.41,Default,,0,0,0,,Тыңда, бүгін ең жақсы күн болды.
Dialogue: 0,0:17:18.03,0:17:20.12,Default,,0,0,0,,Құлағымның артында бірдеңе бар
Dialogue: 0,0:17:20.20,0:17:21.99,Default,,0,0,0,,Менің қазір көңіл-күйім жоқ
Dialogue: 0,0:17:22.08,0:17:24.29,Default,,0,0,0,,Мүмкін бұл сіздің етеккіріңіз…
Dialogue: 0,0:17:35.97,0:17:39.05,Default,,0,0,0,,Бірінші жұмыртқа шықты
Dialogue: 0,0:17:41.26,0:17:43.22,Default,,0,0,0,,Денеден тыс шығарылады
Dialogue: 0,0:17:43.39,0:17:47.19,Default,,0,0,0,,Ағзадан эндометриямен бірге шығарылады
Dialogue: 0,0:17:49.02,0:17:54.61,Default,,0,0,0,,Менструальды қан кету дегеніміз не? Міне осылай басталады.
Dialogue: 0,0:17:56.32,0:17:58.53,Default,,0,0,0,,Әйелдің қынабынан
Dialogue: 0,0:17:58.61,0:18:02.53,Default,,0,0,0,,Барлығы қынаптан шығады
Dialogue: 0,0:18:05.70,0:18:10.08,Default,,0,0,0,,Бірақ сіз жалғыз емессіз.
Dialogue: 0,0:18:10.17,0:18:14.05,Default,,0,0,0,,Барлығы қансырап жатыр
Dialogue: 0,0:18:15.30,0:18:18.05,Default,,0,0,0,,Мен оны анда-санда ойнаймын.
Dialogue: 0,0:18:18.72,0:18:20.72,Default,,0,0,0,,Сондықтан жай ғана ағып кетіңіз
Dialogue: 0,0:18:21.64,0:18:25.47,Default,,0,0,0,,Достық бұзылады
Dialogue: 0,0:18:27.48,0:18:31.11,Default,,0,0,0,,Тек ұят дақтар қалды
Dialogue: 0,0:18:31.19,0:18:34.73,Default,,0,0,0,,Жүрегіңнің ақ шортында
Dialogue: 0,0:18:34.82,0:18:38.57,Default,,0,0,0,,Барлығы қансырап жатыр
Dialogue: 0,0:18:38.65,0:18:42.70,Default,,0,0,0,,Ішкі ағзаларым жарылып кеткендей.
Dialogue: 0,0:18:43.08,0:18:45.41,Default,,0,0,0,,Барлығы қансырап жатыр
Dialogue: 0,0:18:46.16,0:18:50.17,Default,,0,0,0,,Азаппен, етеккірдегі ауырсынумен және іштің кебуімен өмір сүру
Dialogue: 0,0:18:50.25,0:18:53.67,Default,,0,0,0,,Барлығы қансырап жатыр
Dialogue: 0,0:18:54.42,0:18:58.26,Default,,0,0,0,,Сіз не істеп жатырсыз? Автобусқа қайта отырыңыз.
Dialogue: 0,0:19:00.13,0:19:02.68,Default,,0,0,0,,Жуынатын бөлмеге уақытында жеттіңіз бе?
Dialogue: 0,0:19:02.76,0:19:05.76,Default,,0,0,0,,Бұл жай ғана қауіпсіз болды.
Dialogue: 0,0:19:07.39,0:19:10.19,Default,,0,0,0,,Мен әйелдерге арналған бұйымдарды сатып алдым.
Dialogue: 0,0:19:10.27,0:19:11.69,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:13.23,0:19:14.90,Default,,0,0,0,,Зефир?
Dialogue: 0,0:19:14.98,0:19:17.73,Default,,0,0,0,,Мен мәтінді оқи алмаймын, сондықтан суретті таңдадым.
Dialogue: 0,0:19:17.82,0:19:21.24,Default,,0,0,0,,Қалай болғанда да, бұл өте жақсы нәрсе.
Dialogue: 0,0:19:21.32,0:19:25.49,Default,,0,0,0,,Мен үлкен дәрет алдым, әрең дегенде...
Dialogue: 0,0:19:25.58,0:19:27.29,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:19:27.37,0:19:29.50,Default,,0,0,0,,Мен отырған бойда,
Dialogue: 0,0:19:29.58,0:19:32.12,Default,,0,0,0,,Шұңқырдан шыққан Миркат сияқты...
Dialogue: 0,0:19:32.21,0:19:34.13,Default,,0,0,0,,Оңтүстік жарты шарда болғандықтан, керісінше ме?
Dialogue: 0,0:19:34.21,0:19:35.38,Default,,0,0,0,,Бұл жеткілікті
Dialogue: 0,0:19:37.21,0:19:39.63,Default,,0,0,0,,Балам, бұрын болғаны үшін кешір.
Dialogue: 0,0:19:39.72,0:19:41.26,Default,,0,0,0,,Өзіңізге ұнайтын кез келген тегті пайдаланыңыз
Dialogue: 0,0:19:41.34,0:19:44.18,Default,,0,0,0,,Рахмет, мен мұны істедім.
Dialogue: 0,0:19:46.26,0:19:48.35,Default,,0,0,0,,Бұрынғы үшін кешіріңіз.
Dialogue: 0,0:19:48.43,0:19:49.14,Default,,0,0,0,,Та-да!
Dialogue: 0,0:19:49.22,0:19:50.85,Default,,0,0,0,,Әлі де ашулы
Dialogue: 0,0:19:50.93,0:19:53.94,Default,,0,0,0,,Мен үйге барып, шалбар пісіремін.
Dialogue: 0,0:19:54.02,0:19:55.40,Default,,0,0,0,,Мен де солай істеймін.
Dialogue: 0,0:19:55.48,0:19:59.11,Default,,0,0,0,,Әрең дегенде өтірік.
Dialogue: 0,0:20:01.65,0:20:03.03,Default,,0,0,0,,Бұл көңілді болды ма?
Dialogue: 0,0:20:06.33,0:20:08.37,Default,,0,0,0,,Джесси, не болды?
Dialogue: 0,0:20:08.49,0:20:10.04,Default,,0,0,0,,Менің етеккірім келді.
Dialogue: 0,0:20:10.12,0:20:10.83,Default,,0,0,0,,Менструация үшін?
Dialogue: 0,0:20:10.91,0:20:12.46,Default,,0,0,0,,Ақ шалбар...
Dialogue: 0,0:20:12.54,0:20:14.25,Default,,0,0,0,,Өйткені мен оны ұсындым
Dialogue: 0,0:20:14.71,0:20:16.54,Default,,0,0,0,,Жоқ—сол қолымды пайдаланбай-ақ ең үздікке айналу арқылы—
Dialogue: 0,0:20:19.05,0:20:22.34,Default,,0,0,0,,Мен мысықты қорқыттым
Dialogue: 0,0:20:23.59,0:20:24.55,Default,,0,0,0,,Ал сіз ше?
Dialogue: 0,0:20:24.64,0:20:26.39,Default,,0,0,0,,Жақсы күн емес.
Dialogue: 0,0:20:26.47,0:20:29.22,Default,,0,0,0,,Менің дос қызымның етеккір кезеңі келді.
Dialogue: 0,0:20:29.31,0:20:32.27,Default,,0,0,0,,Сол себепті артта қалдың ба?
Dialogue: 0,0:20:33.39,0:20:34.65,Default,,0,0,0,,СМАШ АҚШ-ы!
Dialogue: 0,0:20:34.73,0:20:36.31,Default,,0,0,0,,Сабыр ет, Ник.
Dialogue: 0,0:20:36.40,0:20:38.73,Default,,0,0,0,,Менструация туралы жанжал ше?
Dialogue: 0,0:20:38.82,0:20:42.36,Default,,0,0,0,,Енді қайта-қайта келеді.
Dialogue: 0,0:20:42.44,0:20:44.86,Default,,0,0,0,,«Сіз келмейсіз» дегенге дейін.
Dialogue: 0,0:20:44.95,0:20:49.91,Default,,0,0,0,,Ал сіз үйден кетіп, Герцог Эллингтон боласыз.
Dialogue: 0,0:20:50.41,0:20:53.91,Default,,0,0,0,,Мен өмірімде көп қателіктер жібердім.
Dialogue: 0,0:20:55.50,0:20:58.29,Default,,0,0,0,,Енді мен кек аламын.
Dialogue: 0,0:20:59.59,0:21:02.26,Default,,0,0,0,,Тампондарға люкс салығы салынады.
Dialogue: 0,0:21:02.34,0:21:05.72,Default,,0,0,0,,Жамбасыңызды мақтамен толтыру «салтанат» па?
Dialogue: 0,0:21:05.80,0:21:08.26,Default,,0,0,0,,Оны қалай пайдалану керектігін айтыңыз.
Dialogue: 0,0:21:08.35,0:21:10.97,Default,,0,0,0,,Тампондарға әлі ерте.
Dialogue: 0,0:21:11.06,0:21:13.73,Default,,0,0,0,,Фаллужаға қарусыз барғыңыз келе ме?
Dialogue: 0,0:21:14.73,0:21:15.81,Default,,0,0,0,,Бұл қате болды.
Dialogue: 0,0:21:15.89,0:21:16.65,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:21:16.73,0:21:17.44,Default,,0,0,0,,Чейни
Dialogue: 0,0:21:17.52,0:21:18.23,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:21:18.31,0:21:19.36,Default,,0,0,0,,Біріншіден, майлықтар
Dialogue: 0,0:21:19.44,0:21:20.02,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:21:20.11,0:21:20.69,Default,,0,0,0,,Жарайды
Dialogue: 0,0:21:20.77,0:21:22.44,Default,,0,0,0,,Бұл әділетсіздік
Dialogue: 0,0:21:22.53,0:21:23.99,Default,,0,0,0,,сондықтан кенеттен үйімнен айырылып қалсам, біраз қиын болар еді.
Dialogue: 0,0:21:24.07,0:21:25.32,Default,,0,0,0,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:21:25.40,0:21:26.78,Default,,0,0,0,,Егер еркек етеккір келсе...
Dialogue: 0,0:21:26.86,0:21:27.74,Default,,0,0,0,,Анашым!
Dialogue: 0,0:21:27.82,0:21:32.12,Default,,0,0,0,,Олимпиадалық спорт түріне айналса, әйелдер жеңілмейді.
Dialogue: 0,0:21:34.66,0:21:37.92,Default,,0,0,0,,Сіз қынаптың қан кететінін білесіз бе?
Dialogue: 0,0:21:38.00,0:21:39.88,Default,,0,0,0,,Бірдеңе дұрыс емес.
Dialogue: 0,0:21:39.96,0:21:42.84,Default,,0,0,0,,Менің мүшесім айына бір рет қан кетсе ше?
Dialogue: 0,0:21:42.92,0:21:44.88,Default,,0,0,0,,Бұл туралы ойлағым да келмейді.
Dialogue: 0,0:21:44.97,0:21:47.01,Default,,0,0,0,,Мені елестетуге мәжбүр етпеңіз
Dialogue: 0,0:21:47.09,0:21:48.01,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:21:48.09,0:21:52.01,Default,,0,0,0,,Мен бір рет қана қызыл бок алдым.
Dialogue: 0,0:21:52.10,0:21:55.48,Default,,0,0,0,,Қансырап жатқаныма таң қалдым.
Dialogue: 0,0:21:55.56,0:21:59.06,Default,,0,0,0,,Қызылша жегенім есімде.
Dialogue: 0,0:21:59.15,0:22:00.86,Default,,0,0,0,,Бұл мүлдем басқа әңгіме.
Dialogue: 0,0:22:00.94,0:22:04.40,Default,,0,0,0,,Джессиге бір қорқынышты нәрсе болды.
Dialogue: 0,0:22:04.48,0:22:07.15,Default,,0,0,0,,Не өзгерді?
Dialogue: 0,0:22:07.24,0:22:10.49,Default,,0,0,0,,Жоқ, Джесси әлі Джесси.
Dialogue: 0,0:22:10.57,0:22:11.41,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:22:11.49,0:22:14.62,Default,,0,0,0,,Адамдар айына бір рет қан кеткенде өзгереді.
Dialogue: 0,0:22:14.70,0:22:15.95,Default,,0,0,0,,Бұл жерде тақды шарлатанға тапсыратын орын да емес қой, иә?
Dialogue: 0,0:22:18.29,0:22:20.33,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:22:28.47,0:22:31.26,Default,,0,0,0,,Сәлем Равиоли-чан
Dialogue: 0,0:22:34.18,0:22:34.72,Default,,0,0,0,,Тыныш.
Dialogue: 0,0:22:34.81,0:22:36.64,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:22:36.73,0:22:39.90,Default,,0,0,0,,Мен Гормон-чанмын
Dialogue: 0,0:22:41.52,0:22:46.57,Default,,0,0,0,,Бостандық мүсінінен естіген әйелдердің қасіреті мен анам
Dialogue: 0,0:22:46.65,0:22:49.15,Default,,0,0,0,,Жасы асқан әйелдер
Dialogue: 0,0:22:49.24,0:22:51.62,Default,,0,0,0,,Сіз қазір ең жақсы кезеңдесіз.
Dialogue: 0,0:22:51.70,0:22:52.24,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:22:52.32,0:22:54.49,Default,,0,0,0,,Кейбір өзгертулер енгізу қажет
Dialogue: 0,0:22:54.58,0:22:56.58,Default,,0,0,0,,Мысалы, бұл не?
Dialogue: 0,0:22:56.66,0:22:57.75,Default,,0,0,0,,Қолғап
Dialogue: 0,0:22:57.83,0:22:58.83,Default,,0,0,0,,Міндетті емес
Dialogue: 0,0:22:59.29,0:23:00.08,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:23:00.17,0:23:03.63,Default,,0,0,0,,Ерін далабы мен Лана Дел Рейді тыңдау
Dialogue: 0,0:23:03.71,0:23:05.42,Default,,0,0,0,,Футболканы кесіңіз
Dialogue: 0,0:23:05.50,0:23:09.93,Default,,0,0,0,,Анаңа айқайла, оның жылағанына күл
Dialogue: 0,0:23:10.01,0:23:11.59,Default,,0,0,0,,Анама айқайлауға қалай дәтің бар?
Dialogue: 0,0:23:11.68,0:23:13.55,Default,,0,0,0,,Мен енді ана емеспін
Dialogue: 0,0:23:13.80,0:23:17.06,Default,,0,0,0,,Бұдан былай мен сені Шэннон деп атаймын.
Dialogue: 0,0:23:17.56,0:23:19.14,Default,,0,0,0,,Сен әдемісің.
Dialogue: 0,0:23:19.23,0:23:20.31,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:23:20.94,0:23:22.15,Default,,0,0,0,,Жақсы иіс
Dialogue: 0,0:23:22.23,0:23:26.73,Default,,0,0,0,,Дезодорант қолданбаңыз, көпіршікті ванна қабылдаңыз
Dialogue: 0,0:23:27.48,0:23:28.90,Default,,0,0,0,,Жақсы болды ма?
Dialogue: 0,0:23:29.07,0:23:30.74,Default,,0,0,0,,Шық, Шеннон!
Dialogue: 0,0:23:30.82,0:23:32.20,Default,,0,0,0,,Керемет шаш үлгісі.
Dialogue: 0,0:23:32.28,0:23:34.53,Default,,0,0,0,,Шық!
Dialogue: 0,0:23:35.58,0:23:38.50,Default,,0,0,0,,Жарайсың, Гёза-чан
Dialogue: 0,0:23:38.58,0:23:42.58,Default,,0,0,0,,Өміріңіздің ең жақсы жылдары басталғалы тұр.
Dialogue: 0,0:23:42.67,0:23:47.63,Default,,0,0,0,,Әрі қарай төсекке лақтырып, қатты жыла.
Dialogue: 0,0:24:50.19,0:24:52.19,Default,,0,0,0,,Жапон субтитрлері Нагиса Исозаки
Dialogue: 0,0:24:53.69,0:24:59.69,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
