Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.00,0:00:06.96,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:06.96,0:00:08.42,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:06.96,0:00:08.42,Default,,0,0,0,,Қаныңды төг!
Dialogue: 0,0:00:08.67,0:00:12.17,Default,,0,0,0,,Қан! қан! қан!
Dialogue: 0,0:00:12.38,0:00:14.01,Default,,0,0,0,,Жасай бер! Кама жігіт
Dialogue: 0,0:00:14.84,0:00:16.43,Default,,0,0,0,,Порно күтіп тұр
Dialogue: 0,0:00:17.64,0:00:18.97,Default,,0,0,0,,Бетіңізді жасаңыз!
Dialogue: 0,0:00:19.18,0:00:21.89,Default,,0,0,0,,Бұл қазірдің өзінде... ауырады!
Dialogue: 0,0:00:24.89,0:00:26.65,Default,,0,0,0,,10 сағат бұрын
Dialogue: 0,0:00:26.73,0:00:29.86,Default,,0,0,0,,Бүгінгі түнгі ұйықтау кеші керемет болады.
Dialogue: 0,0:00:29.98,0:00:31.74,Default,,0,0,0,,Тек балалар
Dialogue: 0,0:00:31.82,0:00:35.03,Default,,0,0,0,,Киіміңді шешіп, ойын ойна
Dialogue: 0,0:00:35.45,0:00:36.32,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,0:00:36.45,0:00:39.08,Default,,0,0,0,,Бұл жезөкше өлтіру туралы қауесет ойыны.
Dialogue: 0,0:00:39.20,0:00:42.58,Default,,0,0,0,,Балалар оны сатып ала алмайды.
Dialogue: 0,0:00:42.70,0:00:45.42,Default,,0,0,0,,Мен саған өзімді көрсеттім
Dialogue: 0,0:00:45.54,0:00:46.54,Default,,0,0,0,,Үлкен
Dialogue: 0,0:00:46.62,0:00:51.96,Default,,0,0,0,,Ата-анаң сыртқа шықса да, үлкен ағаларың сонда болады емес пе?
Dialogue: 0,0:00:52.09,0:00:55.05,Default,,0,0,0,,Суық қанды құбыжық дуэт?
Dialogue: 0,0:00:55.18,0:00:58.05,Default,,0,0,0,,Вал мен Курт та жоқ.
Dialogue: 0,0:00:58.18,0:01:03.52,Default,,0,0,0,,Кіші мектептің үш баласы жыныстық зорлық-зомбылық ойынын ойнай ма?
Dialogue: 0,0:01:03.64,0:01:05.02,Default,,0,0,0,,Бұл көңілді ме?
Dialogue: 0,0:01:05.14,0:01:09.48,Default,,0,0,0,,Эндрю Бұл керемет түн болады.
Dialogue: 0,0:01:10.40,0:01:12.15,Default,,0,0,0,,Мен күте алмаймын
Dialogue: 0,0:01:13.03,0:01:16.15,Default,,0,0,0,,Қалағаныңызша шыны кесектерін алуға болады.
Dialogue: 0,0:01:50.19,0:01:51.44,Default,,0,0,0,,Бүгін түнде не істеп жатырсың?
Dialogue: 0,0:01:51.56,0:01:52.61,Default,,0,0,0,,Ұйқы
Dialogue: 0,0:01:52.73,0:01:56.49,Default,,0,0,0,,Менің үйімде жезөкше өлтіру ойынын ойнайық.
Dialogue: 0,0:01:56.61,0:02:01.07,Default,,0,0,0,,Білемін, жұмыс істейтін әйелдерді менсінбейтін ойын.
Dialogue: 0,0:02:01.20,0:02:04.04,Default,,0,0,0,,Әйел емес, жезөкше.
Dialogue: 0,0:02:04.16,0:02:06.41,Default,,0,0,0,,Әкеңнің сөзі.
Dialogue: 0,0:02:06.54,0:02:08.25,Default,,0,0,0,,Атақты сөздер
Dialogue: 0,0:02:08.37,0:02:09.42,Default,,0,0,0,,Бұл сұмдық
Dialogue: 0,0:02:09.54,0:02:14.00,Default,,0,0,0,,Ең жаман нәрсе жоқ. Атақты болу және ең нашар болу деген ұғым жоқ.
Dialogue: 0,0:02:14.13,0:02:14.71,Default,,0,0,0,,ЖИТС туралы не деуге болады?
Dialogue: 0,0:02:14.84,0:02:18.84,Default,,0,0,0,,Әлемдегі ең танымал аутоиммунды ауруды айтасыз ба?
Dialogue: 0,0:02:18.97,0:02:20.01,Default,,0,0,0,,Қайсысы ең нашар?
Dialogue: 0,0:02:20.14,0:02:22.72,Default,,0,0,0,,Егер Джей
Dialogue: 0,0:02:22.85,0:02:25.85,Default,,0,0,0,,Арсыз адамды жайына қалдыр
Dialogue: 0,0:02:25.93,0:02:28.02,Default,,0,0,0,,Сіз де ұйықтауға болады.
Dialogue: 0,0:02:28.14,0:02:30.69,Default,,0,0,0,,Менің әйел достарым көп емес.
Dialogue: 0,0:02:30.81,0:02:33.15,Default,,0,0,0,,Олар ше?
Dialogue: 0,0:02:33.27,0:02:34.52,Default,,0,0,0,,Девин мен Лаура?
Dialogue: 0,0:02:34.65,0:02:38.82,Default,,0,0,0,,Бізге қарай екі танымал адам келе жатыр.
Dialogue: 0,0:02:38.95,0:02:42.66,Default,,0,0,0,,Шашыңыз тамаша жиналған.
Dialogue: 0,0:02:42.78,0:02:45.16,Default,,0,0,0,,Менің бірнеше танымал достарым бар.
Dialogue: 0,0:02:45.29,0:02:49.54,Default,,0,0,0,,үшін Девинмен дос болғысы келеді.
Dialogue: 0,0:02:49.66,0:02:53.79,Default,,0,0,0,,Аналық арадан бал алыңыз
Dialogue: 0,0:02:55.00,0:02:55.92,Default,,0,0,0,,Девин
Dialogue: 0,0:02:56.05,0:02:57.38,Default,,0,0,0,,О, қымбатты досым
Dialogue: 0,0:02:57.63,0:02:59.80,Default,,0,0,0,,Мм... агепойо
Dialogue: 0,0:02:59.92,0:03:02.30,Default,,0,0,0,,Менің айтайын дегенім, бұл шын...
Dialogue: 0,0:03:02.43,0:03:03.76,Default,,0,0,0,,Мен қалыпты сөйлеймін.
Dialogue: 0,0:03:03.89,0:03:06.56,Default,,0,0,0,,Бүгін түнде болғың келе ме?
Dialogue: 0,0:03:06.68,0:03:10.48,Default,,0,0,0,,Мен жаңа дос тапқым келді.
Dialogue: 0,0:03:10.60,0:03:11.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:11.35,0:03:12.73,Default,,0,0,0,,Дана достар
Dialogue: 0,0:03:12.85,0:03:13.77,Default,,0,0,0,,Өтірік?
Dialogue: 0,0:03:14.11,0:03:16.94,Default,,0,0,0,,«Кішкентай әйелдер» сияқты
Dialogue: 0,0:03:17.07,0:03:20.36,Default,,0,0,0,,Мен сияқты арсыз
Dialogue: 0,0:03:20.49,0:03:21.11,Default,,0,0,0,,Лаура
Dialogue: 0,0:03:21.24,0:03:25.45,Default,,0,0,0,,О, мен сені де Кішкентай әйелдер туралы айтып отыр деп ойладым.
Dialogue: 0,0:03:25.70,0:03:29.00,Default,,0,0,0,,Соғыс кезіндегі отбасылық байланыстар әсер етеді.
Dialogue: 0,0:03:29.12,0:03:32.37,Default,,0,0,0,,Иә, сен де бүгін түнде болғың келе ме?
Dialogue: 0,0:03:32.50,0:03:33.79,Default,,0,0,0,,Менің барғым келеді
Dialogue: 0,0:03:33.92,0:03:34.71,Default,,0,0,0,,Мұнда
Dialogue: 0,0:03:34.83,0:03:37.96,Default,,0,0,0,,Мен достарсыз алаңдаймын.
Dialogue: 0,0:03:38.09,0:03:44.09,Default,,0,0,0,,Әже өлгенде киген пижаманы ал.
Dialogue: 0,0:03:44.22,0:03:47.56,Default,,0,0,0,,Ұйқыда мен де өлдім.
Dialogue: 0,0:03:47.68,0:03:51.02,Default,,0,0,0,,Бұл қызық. Қанекей мынаны істейік.
Dialogue: 0,0:03:51.14,0:03:52.10,Default,,0,0,0,,Иә.
Dialogue: 0,0:03:52.23,0:03:54.44,Default,,0,0,0,,Танысқаныма қуаныштымын, Джесси
Dialogue: 0,0:03:54.56,0:03:59.44,Default,,0,0,0,,Бірақ егер сен менің жақын досыма тым жақын болсаң, мен сені өлтіремін.
Dialogue: 0,0:03:59.57,0:04:01.61,Default,,0,0,0,,Мен бүгін кешті асыға күтемін.
Dialogue: 0,0:04:03.07,0:04:04.70,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:04:04.82,0:04:06.41,Default,,0,0,0,,Иә, бәрібір
Dialogue: 0,0:04:06.53,0:04:08.16,Default,,0,0,0,,Көңілді болыңыз
Dialogue: 0,0:04:08.24,0:04:10.75,Default,,0,0,0,,Әкем сонда болады
Dialogue: 0,0:04:10.87,0:04:15.46,Default,,0,0,0,,Бұл сағыздар бір туыс ағайынды сияқты.
Dialogue: 0,0:04:15.58,0:04:16.88,Default,,0,0,0,,«Менің әкем лимон»
Dialogue: 0,0:04:17.00,0:04:18.13,Default,,0,0,0,,Менің түсім күлгін
Dialogue: 0,0:04:18.25,0:04:20.09,Default,,0,0,0,,Шіріген лимон.
Dialogue: 0,0:04:20.21,0:04:20.92,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:04:21.05,0:04:22.01,Default,,0,0,0,,Не?
Dialogue: 0,0:04:23.05,0:04:27.14,Default,,0,0,0,,Сіз безеуден тазартатын құрал мен абразивті тіс щеткасын әкелдіңіз бе?
Dialogue: 0,0:04:27.26,0:04:27.85,Default,,0,0,0,,болды
Dialogue: 0,0:04:27.97,0:04:29.01,Default,,0,0,0,,Менің жастығым да?
Dialogue: 0,0:04:29.14,0:04:32.77,Default,,0,0,0,,Мен онсыз да ұйықтай аламын.
Dialogue: 0,0:04:32.89,0:04:34.77,Default,,0,0,0,,Сіз Пилбоны артта қалдырасыз ба?
Dialogue: 0,0:04:34.89,0:04:35.48,Default,,0,0,0,,Анашым!
Dialogue: 0,0:04:35.60,0:04:38.19,Default,,0,0,0,,Ол түрлі естеліктерге толы, солай ма?
Dialogue: 0,0:04:38.27,0:04:42.57,Default,,0,0,0,,Жастығыма ат қойғаным үшін мені мазақ етеді
Dialogue: 0,0:04:42.69,0:04:43.82,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:04:43.95,0:04:45.61,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:04:45.74,0:04:46.53,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:04:46.66,0:04:49.74,Default,,0,0,0,,Сау бол, Эндрю
Dialogue: 0,0:04:49.87,0:04:51.08,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:04:52.33,0:04:53.12,Default,,0,0,0,,Қан жарылысы!
Dialogue: 0,0:04:53.25,0:04:56.87,Default,,0,0,0,,Жол ойлы болса да әдемі үй екен.
Dialogue: 0,0:04:57.00,0:04:58.63,Default,,0,0,0,,Ата-аналар, сіз профессорсыз.
Dialogue: 0,0:04:58.75,0:05:03.26,Default,,0,0,0,,Натан Филионға ұқсайтын ит!
Dialogue: 0,0:05:03.42,0:05:07.26,Default,,0,0,0,,«От фляж: Әлемдер соғысын» көрдіңіз бе?
Dialogue: 0,0:05:07.39,0:05:09.51,Default,,0,0,0,,Ой, сен ақымақсың.
Dialogue: 0,0:05:09.64,0:05:12.56,Default,,0,0,0,,Мен де! әке - ең жақсы
Dialogue: 0,0:05:12.68,0:05:13.89,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:05:14.02,0:05:17.65,Default,,0,0,0,,Мисси, эдамаме және тіскебасарға арналған сәбіз.
Dialogue: 0,0:05:17.77,0:05:19.52,Default,,0,0,0,,Мен қант жемеймін.
Dialogue: 0,0:05:19.65,0:05:22.36,Default,,0,0,0,,Инкандық «қант күші» іске қосылды.
Dialogue: 0,0:05:22.48,0:05:23.53,Default,,0,0,0,,Қанттың күші!
Dialogue: 0,0:05:23.65,0:05:26.11,Default,,0,0,0,,Ережелерді шешіңіз
Dialogue: 0,0:05:26.24,0:05:30.99,Default,,0,0,0,,Сіз бүгін түнде ұйықтай алмайтын шығарсыз, неге біз кезекпен ұйықтамаймыз?
Dialogue: 0,0:05:31.12,0:05:33.58,Default,,0,0,0,,Жарайды, бүгін кешті тамашалайық.
Dialogue: 0,0:05:33.70,0:05:37.79,Default,,0,0,0,,Көңілді болыңыз. Ақсақ болды ма?
Dialogue: 0,0:05:37.92,0:05:38.62,Default,,0,0,0,,О
Dialogue: 0,0:05:38.75,0:05:42.25,Default,,0,0,0,,Артқы есікке өтіңіз. Алдыңғы есік тек тұтынушыларға арналған.
Dialogue: 0,0:05:42.38,0:05:42.96,Default,,0,0,0,,Сәлем
Dialogue: 0,0:05:43.09,0:05:43.76,Default,,0,0,0,,Сәлем
Dialogue: 0,0:05:44.76,0:05:46.97,Default,,0,0,0,,Холокост мемориалы?
Dialogue: 0,0:05:47.09,0:05:48.01,Default,,0,0,0,,Үлкен!
Dialogue: 0,0:05:48.13,0:05:49.55,Default,,0,0,0,,Мен қорқамын, көмектесіңізші
Dialogue: 0,0:05:49.68,0:05:51.68,Default,,0,0,0,,Бұл Людакрис, күзетші ит.
Dialogue: 0,0:05:51.80,0:05:55.81,Default,,0,0,0,,Ешқандай зияны жоқ, солай ма?
Dialogue: 0,0:05:55.93,0:05:59.06,Default,,0,0,0,,Эгосын біледі және тітіркенеді
Dialogue: 0,0:06:02.02,0:06:05.65,Default,,0,0,0,,Бақшада супер спорт түрін дамыту
Dialogue: 0,0:06:05.78,0:06:08.40,Default,,0,0,0,,Допты сындырып, салқын қараңыз...
Dialogue: 0,0:06:08.53,0:06:09.86,Default,,0,0,0,,Керемет пе?
Dialogue: 0,0:06:09.99,0:06:10.57,Default,,0,0,0,,Сен оны білесің бе?
Dialogue: 0,0:06:10.70,0:06:12.24,Default,,0,0,0,,Мен бұл туралы ешқашан естіген емеспін.
Dialogue: 0,0:06:12.37,0:06:14.87,Default,,0,0,0,,Бұл паркур сияқты
Dialogue: 0,0:06:14.95,0:06:16.33,Default,,0,0,0,,Тек қарап тұр.
Dialogue: 0,0:06:20.54,0:06:21.75,Default,,0,0,0,,Альберт мырза
Dialogue: 0,0:06:21.88,0:06:22.50,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:06:22.63,0:06:25.63,Default,,0,0,0,,2 анусты қараңыз және 10 ұпай алыңыз
Dialogue: 0,0:06:26.17,0:06:30.01,Default,,0,0,0,,Бұл тамаша ас үй. Не айта аламын...
Dialogue: 0,0:06:30.13,0:06:31.97,Default,,0,0,0,,Нашар кокс?
Dialogue: 0,0:06:32.10,0:06:33.72,Default,,0,0,0,,Бұл бір жерде болды...
Dialogue: 0,0:06:33.85,0:06:36.56,Default,,0,0,0,,Сізде қант жоқ
Dialogue: 0,0:06:36.68,0:06:38.39,Default,,0,0,0,,Маған кола ұнайды
Dialogue: 0,0:06:38.52,0:06:40.44,Default,,0,0,0,,Қанттың күші қандай?
Dialogue: 0,0:06:40.56,0:06:43.11,Default,,0,0,0,,Әй, сен ана сияқтысың ба?
Dialogue: 0,0:06:43.23,0:06:47.78,Default,,0,0,0,,Олай болса ажырасып, қайта тұрмысқа шығу керек.
Dialogue: 0,0:06:47.90,0:06:50.86,Default,,0,0,0,,Мен әр сейсенбіде үйге барамын.
Dialogue: 0,0:06:50.99,0:06:55.87,Default,,0,0,0,,Сонымен қызым мектепке өз бетімен баруға мәжбүр болды.
Dialogue: 0,0:06:55.99,0:06:58.08,Default,,0,0,0,,Назар аударғаныңызға рахмет.
Dialogue: 0,0:06:58.16,0:07:01.42,Default,,0,0,0,,Бірақ бүгін кешке бізде топтық іс-шара болады.
Dialogue: 0,0:07:02.92,0:07:05.46,Default,,0,0,0,,Макияжбен ойнайық
Dialogue: 0,0:07:05.59,0:07:08.71,Default,,0,0,0,,Күн қорғанысы жалғыз косметикалық өнім...
Dialogue: 0,0:07:08.84,0:07:11.47,Default,,0,0,0,,Анаңыздың косметикасы ше?
Dialogue: 0,0:07:11.59,0:07:13.85,Default,,0,0,0,,Үлкен ағалар керемет
Dialogue: 0,0:07:13.97,0:07:15.30,Default,,0,0,0,,Бүгін түнде қайдасың?
Dialogue: 0,0:07:15.43,0:07:19.98,Default,,0,0,0,,Мектепте кеш болды. Мен киініп шықтым.
Dialogue: 0,0:07:20.10,0:07:23.15,Default,,0,0,0,,әйелді мүшесімен ішін шығару
Dialogue: 0,0:07:23.27,0:07:24.40,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:07:25.65,0:07:27.82,Default,,0,0,0,,Бұл музыка бөлмесі.
Dialogue: 0,0:07:27.94,0:07:29.65,Default,,0,0,0,,Бұл қару-жарақ қоймасы
Dialogue: 0,0:07:30.07,0:07:31.32,Default,,0,0,0,,Ашылмаған есік
Dialogue: 0,0:07:33.91,0:07:37.91,Default,,0,0,0,,Ішінде қорқынышты нәрсе бар ма?
Dialogue: 0,0:07:38.04,0:07:40.29,Default,,0,0,0,,Оны ешқашан ашпаңыз!
Dialogue: 0,0:07:40.41,0:07:44.54,Default,,0,0,0,,Ақырында, бұл ғажайыптар болатын бөлме.
Dialogue: 0,0:07:44.67,0:07:45.96,Default,,0,0,0,,Ол адам міндетті түрде біреуді…
Dialogue: 0,0:07:46.09,0:07:46.88,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:07:48.09,0:07:50.67,Default,,0,0,0,,Сіз оны ақ түске боядыңыз ба?
Dialogue: 0,0:07:50.80,0:07:52.26,Default,,0,0,0,,Тұқымдарды көрсетпеу
Dialogue: 0,0:07:52.38,0:07:53.01,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:53.13,0:07:56.22,Default,,0,0,0,,Мен сені кездестіргім келетін адам бар.
Dialogue: 0,0:07:56.51,0:07:58.10,Default,,0,0,0,,Бұл жастық
Dialogue: 0,0:07:58.22,0:07:58.93,Default,,0,0,0,,Қауіп-қатерлерге байланысты әуе саяхатынан бас тартып—
Dialogue: 0,0:07:59.06,0:08:01.43,Default,,0,0,0,,Ол жастық емес
Dialogue: 0,0:08:01.56,0:08:05.61,Default,,0,0,0,,Бұл Мадонна. Онымен танысқыңыз келмей ме?
Dialogue: 0,0:08:05.73,0:08:07.44,Default,,0,0,0,,Жастық сіздің серіктесіңіз бе?
Dialogue: 0,0:08:07.57,0:08:09.73,Default,,0,0,0,,Сіз жастықпен жыныстық қатынас жасайсыз ба?
Dialogue: 0,0:08:09.86,0:08:11.11,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:08:11.24,0:08:13.86,Default,,0,0,0,,Иә, мен істеп жатырмын
Dialogue: 0,0:08:15.28,0:08:18.62,Default,,0,0,0,,Шынымен, бұл рас.
Dialogue: 0,0:08:18.70,0:08:19.91,Default,,0,0,0,,Сіз мұны осылай жасайсыз
Dialogue: 0,0:08:20.33,0:08:25.12,Default,,0,0,0,,Алдымен шеттерін жыртып алмау үшін кесінділерді қысқа етіп жасаңыз.
Dialogue: 0,0:08:25.25,0:08:29.21,Default,,0,0,0,,Сосын сорпаны полиэтилен пакетке салыңыз.
Dialogue: 0,0:08:29.34,0:08:32.47,Default,,0,0,0,,Микротолқынды пеште 98,6 градусқа дейін қызады.
Dialogue: 0,0:08:32.59,0:08:36.01,Default,,0,0,0,,Температура жақсы және сізді күйдірмейді.
Dialogue: 0,0:08:36.93,0:08:38.93,Default,,0,0,0,,Оны жастығыңызға салыңыз
Dialogue: 0,0:08:40.10,0:08:42.68,Default,,0,0,0,,Артқы жағы тек ерекше жағдайларға арналған.
Dialogue: 0,0:08:42.81,0:08:44.19,Default,,0,0,0,,Ол данышпан.
Dialogue: 0,0:08:44.31,0:08:45.31,Default,,0,0,0,,Сорпа ше?
Dialogue: 0,0:08:45.44,0:08:46.77,Default,,0,0,0,,Тамақтану
Dialogue: 0,0:08:46.90,0:08:47.90,Default,,0,0,0,,Бұл сөмкеде.
Dialogue: 0,0:08:48.02,0:08:50.53,Default,,0,0,0,,Эндрюде менің жастығым бар
Dialogue: 0,0:08:50.65,0:08:51.28,Default,,0,0,0,,Маған қарыз бер
Dialogue: 0,0:08:51.40,0:08:52.07,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:08:52.19,0:08:53.65,Default,,0,0,0,,Оған тиіспе
Dialogue: 0,0:08:53.78,0:08:56.20,Default,,0,0,0,,Ер адам? Қызық.
Dialogue: 0,0:08:56.74,0:08:59.99,Default,,0,0,0,,Уайымдама, мен сенің таблетка қорапшаңды қорғаймын.
Dialogue: 0,0:09:00.12,0:09:02.08,Default,,0,0,0,,Жастық – жастық
Dialogue: 0,0:09:02.20,0:09:07.63,Default,,0,0,0,,Мен жастығымның Джейдің серіктесі болғанын қаламаймын.
Dialogue: 0,0:09:07.75,0:09:10.00,Default,,0,0,0,,Ұнтақпен аяқтаңыз...
Dialogue: 0,0:09:10.13,0:09:11.38,Default,,0,0,0,,Аяқтау
Dialogue: 0,0:09:13.38,0:09:16.13,Default,,0,0,0,,Ол өте әдемі
Dialogue: 0,0:09:16.26,0:09:19.51,Default,,0,0,0,,Девинмен бірге фотосуретті SNS желісінде орналастырыңыз
Dialogue: 0,0:09:19.64,0:09:22.97,Default,,0,0,0,,Маған достар екеніңізді айтыңыз
Dialogue: 0,0:09:23.27,0:09:25.35,Default,,0,0,0,,«#Үлкен трансформация»
Dialogue: 0,0:09:25.43,0:09:28.27,Default,,0,0,0,,Келесі орында Лаура, сондықтан қиын болады.
Dialogue: 0,0:09:28.40,0:09:32.94,Default,,0,0,0,,Біз ең жақын дос болғандықтан, бір-бірімізге кез келген нәрсені айта аламыз.
Dialogue: 0,0:09:33.07,0:09:36.49,Default,,0,0,0,,Табиғи сұлулық
Dialogue: 0,0:09:36.61,0:09:38.86,Default,,0,0,0,,Еврейге ұқсайды
Dialogue: 0,0:09:38.99,0:09:41.45,Default,,0,0,0,,Бізден басқа барлығы Сакурадзима-сенпайды ұмытып қалған болар.
Dialogue: 0,0:09:42.58,0:09:47.54,Default,,0,0,0,,Не істеуім керек... балық ыдысындағы суды ішу керек пе? Әрбір алтын балық?
Dialogue: 0,0:09:47.67,0:09:49.08,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:09:50.25,0:09:52.63,Default,,0,0,0,,Қант сізді шатастырды ма?
Dialogue: 0,0:09:52.75,0:09:56.63,Default,,0,0,0,,Жоқ, менің есі дұрыс. Умаконың да костюмі бар.
Dialogue: 0,0:09:57.93,0:09:59.80,Default,,0,0,0,,Керемет макияж жасаңыз
Dialogue: 0,0:09:59.93,0:10:01.72,Default,,0,0,0,,Су ішсем ше?
Dialogue: 0,0:10:01.85,0:10:03.60,Default,,0,0,0,,Мені сор!
Dialogue: 0,0:10:03.72,0:10:07.89,Default,,0,0,0,,Джесси сияқты сүйкімді бол
Dialogue: 0,0:10:08.02,0:10:11.94,Default,,0,0,0,,Оқыңды босқа жұмсама, бұл тұншықтырғыш аймақ.
Dialogue: 0,0:10:12.06,0:10:14.07,Default,,0,0,0,,Жақында өлесің.
Dialogue: 0,0:10:14.19,0:10:16.69,Default,,0,0,0,,Жан денеден шығады
Dialogue: 0,0:10:16.82,0:10:18.36,Default,,0,0,0,,Монах көрпені берді...
Dialogue: 0,0:10:18.49,0:10:20.57,Default,,0,0,0,,Жанды ұста, жіберме!
Dialogue: 0,0:10:20.70,0:10:21.95,Default,,0,0,0,,Тиындарды алыңыз
Dialogue: 0,0:10:22.07,0:10:24.95,Default,,0,0,0,,Қолыңызды субұрқақта жуып, сыртқа шығыңыз
Dialogue: 0,0:10:25.08,0:10:25.75,Default,,0,0,0,,Гелатерия
Dialogue: 0,0:10:25.87,0:10:26.87,Default,,0,0,0,,Гелато Лиа
Dialogue: 0,0:10:27.00,0:10:28.96,Default,,0,0,0,,Монеталармен сатып алу
Dialogue: 0,0:10:29.08,0:10:30.37,Default,,0,0,0,,Не?
Dialogue: 0,0:10:30.50,0:10:32.50,Default,,0,0,0,,Нашар Сіз оны қолдандыңыз ба?
Dialogue: 0,0:10:32.63,0:10:34.55,Default,,0,0,0,,(Иида) үшін шараның рухына ене ала ма екен?
Dialogue: 0,0:10:34.67,0:10:36.38,Default,,0,0,0,,Бұл рас, қарғыс атсын.
Dialogue: 0,0:10:36.51,0:10:38.47,Default,,0,0,0,,Партия туралы не деуге болады?
Dialogue: 0,0:10:38.59,0:10:42.97,Default,,0,0,0,,Кеудесін еркелетіп, көңіл көтердім.
Dialogue: 0,0:10:43.10,0:10:45.89,Default,,0,0,0,,Бірақ мен жалықтым, сондықтан қайтып келдім.
Dialogue: 0,0:10:46.02,0:10:49.27,Default,,0,0,0,,Сонымен, бірге ойын ойнағыларың келе ме?
Dialogue: 0,0:10:49.39,0:10:51.94,Default,,0,0,0,,Оның орнына жыныстық қатынасты қарастырайық
Dialogue: 0,0:10:52.06,0:10:52.98,Default,,0,0,0,,Мен оны жаңа ғана көрдім
Dialogue: 0,0:10:53.11,0:10:57.65,Default,,0,0,0,,Біз барлық уақыттағы ең жақсы порнографиялық жұмыс деп айтылатын нәрсе туралы айтып отырмыз.
Dialogue: 0,0:10:57.78,0:11:02.24,Default,,0,0,0,,Басты рөлдегі Сильвестр Сталлоне
Dialogue: 0,0:11:02.37,0:11:03.91,Default,,0,0,0,,Ол менің досымның ағасы.
Dialogue: 0,0:11:04.03,0:11:05.16,Default,,0,0,0,,Ол жасырын болған кезден бастап жұмыс істейді
Dialogue: 0,0:11:05.28,0:11:08.62,Default,,0,0,0,,Ол кезде сатылмады, бірақ бұл өте үлкен әтеш еді.
Dialogue: 0,0:11:09.25,0:11:12.46,Default,,0,0,0,,Мен ақымақ болудан шаршадым.
Dialogue: 0,0:11:12.58,0:11:15.46,Default,,0,0,0,,Қарасам да бәрібір.
Dialogue: 0,0:11:15.59,0:11:18.46,Default,,0,0,0,,Бүгін менің адам болған күнім.
Dialogue: 0,0:11:18.59,0:11:19.84,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:11:20.84,0:11:24.80,Default,,0,0,0,,Айта... Майлығымды орауды ұмытып кетіппін!
Dialogue: 0,0:11:24.93,0:11:27.22,Default,,0,0,0,,Мен саған көрсетемін.
Dialogue: 0,0:11:27.35,0:11:28.43,Default,,0,0,0,,Үлкен макияж!
Dialogue: 0,0:11:29.23,0:11:33.19,Default,,0,0,0,,Қараңдаршы, мен шұлығыма кеуделі болдым.
Dialogue: 0,0:11:33.31,0:11:35.44,Default,,0,0,0,,Бұл жаңа идея.
Dialogue: 0,0:11:37.19,0:11:39.61,Default,,0,0,0,,Бұл трагедия, сіз солай ойлайсыз ба?
Dialogue: 0,0:11:39.74,0:11:43.70,Default,,0,0,0,,Мен келісемін, ол патшайым, мені қанағаттандырыңыз.
Dialogue: 0,0:11:43.82,0:11:44.41,Default,,0,0,0,,«Адам өлі ме?»
Dialogue: 0,0:11:44.53,0:11:47.66,Default,,0,0,0,,Әлсіздер құрбан болады
Dialogue: 0,0:11:48.62,0:11:52.33,Default,,0,0,0,,«Даллас сатып алушылар клубындағы» қыз сияқты
Dialogue: 0,0:11:53.71,0:11:57.00,Default,,0,0,0,,Мен түсінбеймін, бірақ иә
Dialogue: 0,0:11:57.13,0:12:01.76,Default,,0,0,0,,Тырнақтарыңды жаса, әйтпесе мен сені атып аламын.
Dialogue: 0,0:12:01.88,0:12:06.35,Default,,0,0,0,,Ол ең жақсы ойын-сауық, мені шақырғаныңызға рахмет.
Dialogue: 0,0:12:06.47,0:12:09.52,Default,,0,0,0,,Лаураға қауесет таратыңыз
Dialogue: 0,0:12:09.64,0:12:12.14,Default,,0,0,0,,«Мен сенің анаңмын».
Dialogue: 0,0:12:13.98,0:12:16.19,Default,,0,0,0,,Ақылсыз ағайынды ұрыс?
Dialogue: 0,0:12:16.48,0:12:19.15,Default,,0,0,0,,Жалғыз бала түсінбейді
Dialogue: 0,0:12:19.32,0:12:21.69,Default,,0,0,0,,Менің ағам да жынды болды
Dialogue: 0,0:12:22.28,0:12:23.53,Default,,0,0,0,,Ол ең жақсы аға.
Dialogue: 0,0:12:24.53,0:12:26.45,Default,,0,0,0,,Сіз өлдіңіз бе?
Dialogue: 0,0:12:26.57,0:12:28.74,Default,,0,0,0,,Джей, жақсысың ба?
Dialogue: 0,0:12:28.87,0:12:31.83,Default,,0,0,0,,Екі жарым минуттан астам уақыт жұмыс істемей қалды ма?
Dialogue: 0,0:12:31.95,0:12:33.16,Default,,0,0,0,,Тоқта! (Ичи) Ә? Мұнда ма?
Dialogue: 0,0:12:33.29,0:12:35.54,Default,,0,0,0,,Гейлермен күрес
Dialogue: 0,0:12:35.67,0:12:36.75,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:12:36.88,0:12:39.09,Default,,0,0,0,,Біз ұрысқымыз келмейді
Dialogue: 0,0:12:39.21,0:12:40.63,Default,,0,0,0,,Біз доспыз ба?
Dialogue: 0,0:12:40.75,0:12:44.43,Default,,0,0,0,,Ондай болса, менімен соғыс, ақымақ.
Dialogue: 0,0:12:44.55,0:12:47.14,Default,,0,0,0,,Порно көргіңіз келсе, қанмен төлеңіз.
Dialogue: 0,0:12:47.26,0:12:49.97,Default,,0,0,0,,Дәстүрлі стиль. Мен міндім.
Dialogue: 0,0:12:50.10,0:12:52.35,Default,,0,0,0,,Ник, сөйлесейік.
Dialogue: 0,0:12:52.48,0:12:53.48,Default,,0,0,0,,...
Dialogue: 0,0:12:54.56,0:12:55.73,Default,,0,0,0,,Ұрыс үшін кешірім сұраймын
Dialogue: 0,0:12:55.85,0:12:58.23,Default,,0,0,0,,Мен бұл жерден қашқым келеді
Dialogue: 0,0:12:58.36,0:13:00.44,Default,,0,0,0,,Ұрыспақ болып көріну?
Dialogue: 0,0:13:00.57,0:13:04.65,Default,,0,0,0,,Жұмсақ жалған соққы сияқты
Dialogue: 0,0:13:04.78,0:13:05.36,Default,,0,0,0,,Мүлдем.
Dialogue: 0,0:13:05.49,0:13:06.28,Default,,0,0,0,,Бұл уәде.
Dialogue: 0,0:13:06.66,0:13:08.99,Default,,0,0,0,,Кама және барлық балалар
Dialogue: 0,0:13:09.12,0:13:11.87,Default,,0,0,0,,Өлім сақинасына қош келдіңіз
Dialogue: 0,0:13:12.12,0:13:15.04,Default,,0,0,0,,Міне, өте жеңіл салмақ
Dialogue: 0,0:13:15.16,0:13:18.46,Default,,0,0,0,,Каманың өзі «кішкентай пері»
Dialogue: 0,0:13:18.58,0:13:20.29,Default,,0,0,0,,Әулие Ник!
Dialogue: 0,0:13:20.50,0:13:22.00,Default,,0,0,0,,<Қаныңды төг! 〉
Dialogue: 0,0:13:22.09,0:13:24.34,Default,,0,0,0,,〈Тек бір адам бәс тіге алады〉
Dialogue: 0,0:13:24.76,0:13:27.34,Default,,0,0,0,,«Төбедегі скрипкашы»
Dialogue: 0,0:13:27.47,0:13:31.60,Default,,0,0,0,,«Жасөспірімдерге арналған деликатес» Гловерманш
Dialogue: 0,0:13:31.72,0:13:32.56,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:13:33.35,0:13:34.73,Default,,0,0,0,,Жеңіл бастаңыз
Dialogue: 0,0:13:34.85,0:13:36.02,Default,,0,0,0,,Бетіңізді жасаңыз!
Dialogue: 0,0:13:36.14,0:13:36.77,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:36.89,0:13:37.69,Default,,0,0,0,,Жарайды
Dialogue: 0,0:13:37.81,0:13:38.98,Default,,0,0,0,,Порно күтіп тұр
Dialogue: 0,0:13:39.10,0:13:39.90,Default,,0,0,0,,Жақсы ілмек
Dialogue: 0,0:13:40.02,0:13:42.40,Default,,0,0,0,,Поцелу! аузымнан сүй
Dialogue: 0,0:13:43.15,0:13:45.44,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:13:46.65,0:13:48.74,Default,,0,0,0,,Қан болды, солай ма?
Dialogue: 0,0:13:48.86,0:13:53.45,Default,,0,0,0,,Қан? Түйсіктеріңізді белсендіріңіз, кек алу үшін мені ұрыңыз!
Dialogue: 0,0:13:53.58,0:13:55.79,Default,,0,0,0,,Бұл ауырады!
Dialogue: 0,0:13:56.50,0:13:59.92,Default,,0,0,0,,Уәде басқа. Біз ұрысатын кейіп танытамыз, солай ма?
Dialogue: 0,0:14:01.67,0:14:04.42,Default,,0,0,0,,Оның бетін жұлып ал
Dialogue: 0,0:14:04.55,0:14:05.84,Default,,0,0,0,,Түсіңіз.
Dialogue: 0,0:14:06.55,0:14:08.59,Default,,0,0,0,,Ойыннан да қызық
Dialogue: 0,0:14:09.34,0:14:13.31,Default,,0,0,0,,Джесси Сізді ұнатасыз ба?
Dialogue: 0,0:14:13.43,0:14:16.56,Default,,0,0,0,,Мен сені сүйгім келеді, Натан!
Dialogue: 0,0:14:16.68,0:14:19.06,Default,,0,0,0,,Бұл кім? Ақымақ көрінеді
Dialogue: 0,0:14:19.19,0:14:21.27,Default,,0,0,0,,Ақылды және жақсы адам
Dialogue: 0,0:14:21.40,0:14:24.94,Default,,0,0,0,,Мен не істеуім керек? Менің қантым өте жоғары.
Dialogue: 0,0:14:25.07,0:14:27.82,Default,,0,0,0,,Жақсы, өзімізді құртайық.
Dialogue: 0,0:14:27.95,0:14:30.16,Default,,0,0,0,,Кейде мен түс көремін
Dialogue: 0,0:14:30.28,0:14:33.53,Default,,0,0,0,,Натанмен істі шешіңіз
Dialogue: 0,0:14:33.66,0:14:38.46,Default,,0,0,0,,Ал сен білмей тұрып, достық пен махаббат дамиды.
Dialogue: 0,0:14:38.58,0:14:40.50,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:14:40.62,0:14:43.34,Default,,0,0,0,,Сен менің ең жақын досымсың және сүйіктімсің
Dialogue: 0,0:14:43.46,0:14:45.05,Default,,0,0,0,,Натан…
Dialogue: 0,0:14:45.17,0:14:47.13,Default,,0,0,0,,Мен сенімен бірге тұрғым келеді
Dialogue: 0,0:14:47.26,0:14:50.72,Default,,0,0,0,,Қылмыспен бірге күресіп, үй тапсырмасын бірге орындайық
Dialogue: 0,0:14:50.84,0:14:53.10,Default,,0,0,0,,Менімен биле
Dialogue: 0,0:14:53.22,0:14:56.06,Default,,0,0,0,,Мен сен туралы білгім келеді
Dialogue: 0,0:14:56.18,0:14:58.39,Default,,0,0,0,,Бұл әдемі, Мисси.
Dialogue: 0,0:14:58.52,0:15:00.56,Default,,0,0,0,,Мен сені сүйсем бола ма?
Dialogue: 0,0:15:00.69,0:15:02.77,Default,,0,0,0,,Әрине, Натан.
Dialogue: 0,0:15:07.69,0:15:08.69,Default,,0,0,0,,Натан?
Dialogue: 0,0:15:09.49,0:15:12.62,Default,,0,0,0,,Керемет! Мен шедевр алдым
Dialogue: 0,0:15:12.74,0:15:14.03,Default,,0,0,0,,Мисси
Dialogue: 0,0:15:14.16,0:15:15.99,Default,,0,0,0,,Неге ашуланасың?
Dialogue: 0,0:15:16.12,0:15:19.96,Default,,0,0,0,,Себебі сен біртүрлісің. Не болды?
Dialogue: 0,0:15:20.87,0:15:24.29,Default,,0,0,0,,Мен сенімен дос болғым келді.
Dialogue: 0,0:15:24.42,0:15:28.67,Default,,0,0,0,,Үнемі оғаш істермен айналысатын адаммен дос бола алмайсың.
Dialogue: 0,0:15:28.80,0:15:30.22,Default,,0,0,0,,Айқайламаңыз
Dialogue: 0,0:15:30.67,0:15:33.34,Default,,0,0,0,,Мен көңілді кеш болғанын қаладым...
Dialogue: 0,0:15:34.14,0:15:35.35,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,0:15:35.47,0:15:38.43,Default,,0,0,0,,Тоқта, Натан, тамақ ішпе.
Dialogue: 0,0:15:38.56,0:15:40.31,Default,,0,0,0,,Бұл қызық емес пе?
Dialogue: 0,0:15:40.43,0:15:41.39,Default,,0,0,0,,Қайда
Dialogue: 0,0:15:41.52,0:15:44.06,Default,,0,0,0,,Бұл әдейі жасалған жоқ
Dialogue: 0,0:15:44.19,0:15:45.27,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:15:45.40,0:15:47.86,Default,,0,0,0,,Татуласу кезеңін орнатайық
Dialogue: 0,0:15:47.98,0:15:51.07,Default,,0,0,0,,Сиқырдың емдейтін күші бар
Dialogue: 0,0:15:51.20,0:15:53.45,Default,,0,0,0,,Есегіңнен қоян шықты ма?
Dialogue: 0,0:15:53.57,0:15:54.37,Default,,0,0,0,,Сіз гейсіз бе?
Dialogue: 0,0:15:54.49,0:15:56.49,Default,,0,0,0,,Гей емес
Dialogue: 0,0:15:56.62,0:15:57.20,Default,,0,0,0,,Гей
Dialogue: 0,0:15:57.33,0:16:01.04,Default,,0,0,0,,Мені теуіп алсаңыз да, қуат көзінен ажыратыңыз
Dialogue: 0,0:16:01.16,0:16:01.75,Default,,0,0,0,,Асс
Dialogue: 0,0:16:01.87,0:16:02.54,Default,,0,0,0,,Қоян
Dialogue: 0,0:16:02.67,0:16:05.71,Default,,0,0,0,,Сен мені достарымның көзінше қорладың.
Dialogue: 0,0:16:06.09,0:16:09.42,Default,,0,0,0,,Мен ұйықтайтын жерді де бұздым.
Dialogue: 0,0:16:10.01,0:16:11.59,Default,,0,0,0,,Балалар сендер ең нашарсыңдар.
Dialogue: 0,0:16:13.80,0:16:16.05,Default,,0,0,0,,Жарайды, келесі тапсырма.
Dialogue: 0,0:16:16.18,0:16:20.64,Default,,0,0,0,,Егер ұрысып қалсақ, саған порно көрсетуге уәде бердім.
Dialogue: 0,0:16:20.77,0:16:24.10,Default,,0,0,0,,Сондықтан мен ұрыстым, ұрысқым келмеді
Dialogue: 0,0:16:24.23,0:16:25.19,Default,,0,0,0,,Маған көрсет
Dialogue: 0,0:16:25.31,0:16:26.56,Default,,0,0,0,,Менің де оны көргім келеді
Dialogue: 0,0:16:26.69,0:16:27.86,Default,,0,0,0,,Тапсырма орындалды
Dialogue: 0,0:16:27.98,0:16:29.02,Default,,0,0,0,,Маған көрсет!
Dialogue: 0,0:16:29.15,0:16:32.61,Default,,0,0,0,,Сабыр ет, сонша көргің келді ме?
Dialogue: 0,0:16:32.74,0:16:34.20,Default,,0,0,0,,Олай болса көрейік.
Dialogue: 0,0:16:34.32,0:16:35.28,Default,,0,0,0,,Жақсы
Dialogue: 0,0:16:35.41,0:16:38.24,Default,,0,0,0,,Маған крекер керек
Dialogue: 0,0:16:39.58,0:16:42.37,Default,,0,0,0,,Енді ойын ойнайық
Dialogue: 0,0:16:42.50,0:16:45.12,Default,,0,0,0,,Бұл сперматозоидтар ойыны.
Dialogue: 0,0:16:45.25,0:16:50.38,Default,,0,0,0,,Оның үстінде бәрі мастурбация жасайды, ал кім соңғы рет мастурбация жасаса, сол оны жейді.
Dialogue: 0,0:16:51.01,0:16:52.55,Default,,0,0,0,,Порнография туралы не деуге болады?
Dialogue: 0,0:16:52.67,0:16:54.55,Default,,0,0,0,,Порно көру кезінде
Dialogue: 0,0:16:54.68,0:16:58.55,Default,,0,0,0,,Сондықтан бұл ең жақсы ойын, солай ма?
Dialogue: 0,0:16:58.68,0:17:01.52,Default,,0,0,0,,Енді кім жеңіледі?
Dialogue: 0,0:17:01.68,0:17:05.89,Default,,0,0,0,,Порно көруге болады, бірақ жеңіліп қалсаң, крекер алуға болады.
Dialogue: 0,0:17:06.02,0:17:07.94,Default,,0,0,0,,Мен тамақ ішуім керек
Dialogue: 0,0:17:08.06,0:17:10.90,Default,,0,0,0,,Жасөспірім Ник
Dialogue: 0,0:17:11.03,0:17:14.32,Default,,0,0,0,,Сперматозоид зауыты ашылғалы жатыр деп ойлаймын.
Dialogue: 0,0:17:14.45,0:17:20.03,Default,,0,0,0,,Бірақ мен Эндрюді жеңемін.
Dialogue: 0,0:17:23.16,0:17:26.08,Default,,0,0,0,,Маған бал крекерін көрсетіңіз
Dialogue: 0,0:17:26.21,0:17:28.21,Default,,0,0,0,,А, тұз аз.
Dialogue: 0,0:17:28.83,0:17:31.80,Default,,0,0,0,,Идиот! Мен оны қайтадан әкелуім керек
Dialogue: 0,0:17:31.92,0:17:33.76,Default,,0,0,0,,Осы жерде күтіңіз.
Dialogue: 0,0:17:34.80,0:17:36.47,Default,,0,0,0,,Ник, қаш.
Dialogue: 0,0:17:36.59,0:17:37.47,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:17:37.59,0:17:40.85,Default,,0,0,0,,Бұл қорқынышты түн болды. Мен қараңғылық әлемін көрдім.
Dialogue: 0,0:17:40.97,0:17:43.77,Default,,0,0,0,,Бұл туралы бірнеше жылдан кейін күліп, сөйлесе аламыз, бірақ
Dialogue: 0,0:17:43.89,0:17:48.31,Default,,0,0,0,,Мен қазір күле алмаймын. Бұл балаларды қорлау.
Dialogue: 0,0:17:48.44,0:17:50.06,Default,,0,0,0,,Сіз қашып құтыла аласыз ба?
Dialogue: 0,0:17:50.19,0:17:54.90,Default,,0,0,0,,Ант етемін, мен сені ешқашан ұрығымды жеуге рұқсат етпеймін.
Dialogue: 0,0:17:55.03,0:17:57.24,Default,,0,0,0,,Кейде ант орындалмайды
Dialogue: 0,0:17:57.36,0:17:57.95,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:17:58.07,0:17:59.87,Default,,0,0,0,,Оны басыңа ойып жаз
Dialogue: 0,0:17:59.99,0:18:00.57,Default,,0,0,0,,Қый!
Dialogue: 0,0:18:00.70,0:18:02.24,Default,,0,0,0,,мені тістемек болғанда Розваал мені құтқарды…
Dialogue: 0,0:18:02.37,0:18:04.62,Default,,0,0,0,,Алдыңғы бөлімді де көрдіңіз бе?
Dialogue: 0,0:18:04.79,0:18:10.79,Default,,0,0,0,,Келесі эпизодта Джесси қынаптан ләззат алады.
Dialogue: 0,0:18:12.88,0:18:16.13,Default,,0,0,0,,Мені мазақ ету үшін шақырдың ба?
Dialogue: 0,0:18:16.26,0:18:17.34,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,0:18:17.47,0:18:22.85,Default,,0,0,0,,Кіші мектептегі азапты естеліктер, жазғы жәндіктердің отқа ұшып кетуі
Dialogue: 0,0:18:23.81,0:18:29.35,Default,,0,0,0,,Миссидің итті сүйіп тұрған суретін орналастырыңыз
Dialogue: 0,0:18:29.44,0:18:30.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:30.60,0:18:33.90,Default,,0,0,0,,Шедевр, итіңді сүй
Dialogue: 0,0:18:34.82,0:18:36.32,Default,,0,0,0,,Жариялауға рұқсат етілмейді
Dialogue: 0,0:18:36.44,0:18:37.86,Default,,0,0,0,,Маған тиіспе
Dialogue: 0,0:18:39.11,0:18:40.82,Default,,0,0,0,,Шашыңызды тартыңыз!
Dialogue: 0,0:18:41.37,0:18:42.37,Default,,0,0,0,,Босатыңыз
Dialogue: 0,0:18:42.49,0:18:44.66,Default,,0,0,0,,Тоқта, сен лесбиянсың ба?
Dialogue: 0,0:18:44.79,0:18:46.50,Default,,0,0,0,,Бұйрық бермеу
Dialogue: 0,0:18:46.62,0:18:48.33,Default,,0,0,0,,Шашыңызды босатыңыз
Dialogue: 0,0:18:48.83,0:18:52.04,Default,,0,0,0,,Тот басқан тамыр өшпейді
Dialogue: 0,0:18:57.59,0:18:58.76,Default,,0,0,0,,Жойылған
Dialogue: 0,0:18:58.88,0:19:01.47,Default,,0,0,0,,Мен оны жек көремін! Жақсы емес пе?
Dialogue: 0,0:19:01.59,0:19:04.64,Default,,0,0,0,,Мені шіркін деп атады.
Dialogue: 0,0:19:06.39,0:19:08.81,Default,,0,0,0,,Джесси екіжүзді
Dialogue: 0,0:19:08.93,0:19:10.60,Default,,0,0,0,,Мен фотосуретті жойдым.
Dialogue: 0,0:19:10.73,0:19:13.52,Default,,0,0,0,,Мені біртүрлі деп атады
Dialogue: 0,0:19:13.65,0:19:17.90,Default,,0,0,0,,Басқаларға көмектеспеген адамдар тозаққа түседі.
Dialogue: 0,0:19:18.03,0:19:21.74,Default,,0,0,0,,Жаман әзіл-қалжың жасауды доғар, сен ұйымдастырушысың.
Dialogue: 0,0:19:21.86,0:19:24.20,Default,,0,0,0,,Мен жаңа ғана сенің соңынан ердім
Dialogue: 0,0:19:24.32,0:19:28.08,Default,,0,0,0,,Мен де, әрқашан Девин үшін...
Dialogue: 0,0:19:28.95,0:19:32.21,Default,,0,0,0,,үшін осылай ойлады ма?
Dialogue: 0,0:19:32.33,0:19:35.67,Default,,0,0,0,,Менің де шарасыз екенімді білмейсің бе?
Dialogue: 0,0:19:36.09,0:19:38.96,Default,,0,0,0,,Мектептегі ең сүйкімді қыз
Dialogue: 0,0:19:39.09,0:19:42.84,Default,,0,0,0,,Мектептегі ең танымал адамның рөлін ойнау қиын.
Dialogue: 0,0:19:43.51,0:19:46.51,Default,,0,0,0,,Сіз білмейсіз
Dialogue: 0,0:19:46.93,0:19:49.27,Default,,0,0,0,,«Сүйкімді қыз» артық.
Dialogue: 0,0:19:49.77,0:19:53.40,Default,,0,0,0,,Сіздің міндетіңіз - бұл үйден қашу.
Dialogue: 0,0:19:53.52,0:19:54.94,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:19:55.06,0:19:57.27,Default,,0,0,0,,Менің емшектерімді басыңыз
Dialogue: 0,0:19:59.07,0:20:00.07,Default,,0,0,0,,«Қашу!»
Dialogue: 0,0:20:02.95,0:20:05.07,Default,,0,0,0,,Сіз қашып кете аламын деп ойлайсыз ба?
Dialogue: 0,0:20:06.37,0:20:07.20,Default,,0,0,0,,«Қырғыш қылқалам»
Dialogue: 0,0:20:08.45,0:20:09.41,Default,,0,0,0,,Ик!
Dialogue: 0,0:20:09.54,0:20:10.79,Default,,0,0,0,,Жүгіру
Dialogue: 0,0:20:12.58,0:20:14.42,Default,,0,0,0,,Менің ұрығымды же
Dialogue: 0,0:20:17.50,0:20:18.88,Default,,0,0,0,,Сіз қашан мастурбация жасадыңыз?
Dialogue: 0,0:20:20.59,0:20:21.72,Default,,0,0,0,,«Салицил қышқылы»
Dialogue: 0,0:20:23.43,0:20:24.01,Default,,0,0,0,,Көздер!
Dialogue: 0,0:20:24.13,0:20:25.76,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:25.89,0:20:27.51,Default,,0,0,0,,〝1-эпизод тазартылды〞
Dialogue: 0,0:20:27.51,0:20:28.64,Default,,0,0,0,,〝1-эпизод Clear〞 Оңға бұрылыңыз.
Dialogue: 0,0:20:29.85,0:20:31.06,Default,,0,0,0,,Бұл ашылмайтын есік
Dialogue: 0,0:20:31.18,0:20:32.43,Default,,0,0,0,,Бұрылуға тырысыңыз
Dialogue: 0,0:20:33.64,0:20:36.06,Default,,0,0,0,,Джейдің анасы
Dialogue: 0,0:20:36.19,0:20:37.77,Default,,0,0,0,,Көңілді отырсың ба?
Dialogue: 0,0:20:37.90,0:20:40.48,Default,,0,0,0,,Жоқ, сіздің ұлыңыз жынды екен.
Dialogue: 0,0:20:42.07,0:20:45.99,Default,,0,0,0,,Жігіттер, сендер ақымақ болдыңдар, солай емес пе?
Dialogue: 0,0:20:46.11,0:20:47.41,Default,,0,0,0,,Кама жігіті?
Dialogue: 0,0:20:47.53,0:20:50.24,Default,,0,0,0,,Мақсат осында!
Dialogue: 0,0:20:50.37,0:20:51.66,Default,,0,0,0,,Анасы да жынды
Dialogue: 0,0:20:51.79,0:20:53.04,Default,,0,0,0,,Ұстаңыз!
Dialogue: 0,0:20:55.37,0:20:57.29,Default,,0,0,0,,Бұл Людакрис.
Dialogue: 0,0:20:59.59,0:21:00.59,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:21:00.71,0:21:01.59,Default,,0,0,0,,Бұл...
Dialogue: 0,0:21:02.01,0:21:03.09,Default,,0,0,0,,Мен бе?
Dialogue: 0,0:21:06.01,0:21:09.14,Default,,0,0,0,,Мен сыртқа шыға алдым! Бұл керемет!
Dialogue: 0,0:21:09.26,0:21:13.18,Default,,0,0,0,,Бұл өтірік. Күте тұрыңыз, бұл мүмкін емес.
Dialogue: 0,0:21:13.81,0:21:17.23,Default,,0,0,0,,Мен Пилбоны артта қалдырдым.
Dialogue: 0,0:21:17.35,0:21:22.32,Default,,0,0,0,,Кешіріңіз, мен тек жастық үшін қайтамын...
Dialogue: 0,0:21:22.44,0:21:25.82,Default,,0,0,0,,Такага жастығы? Жоқ, Ник.
Dialogue: 0,0:21:25.95,0:21:28.62,Default,,0,0,0,,Пилбо менің ерекше жастығым
Dialogue: 0,0:21:29.87,0:21:32.16,Default,,0,0,0,,Эндрю Мен түсінемін.
Dialogue: 0,0:21:32.29,0:21:34.79,Default,,0,0,0,,Екеуміз үйге қайтайық.
Dialogue: 0,0:21:35.25,0:21:36.75,Default,,0,0,0,,Пилбоны қалпына келтіру
Dialogue: 0,0:21:36.87,0:21:40.13,Default,,0,0,0,,Девин, кешіріңіз.
Dialogue: 0,0:21:40.25,0:21:44.55,Default,,0,0,0,,Көршілер сені ешкіні құрбандыққа шалып жатыр деп ойлайды.
Dialogue: 0,0:21:44.67,0:21:47.26,Default,,0,0,0,,Бір-бірімен қарым-қатынас жасау
Dialogue: 0,0:21:47.38,0:21:48.59,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:21:48.72,0:21:52.35,Default,,0,0,0,,Мен сенің қарым-қатынасыңды үзгім келмейді.
Dialogue: 0,0:21:52.47,0:21:55.39,Default,,0,0,0,,Сіз Девинді кінәлайсыз, солай ма?
Dialogue: 0,0:21:55.52,0:22:00.52,Default,,0,0,0,,Теріні жұлып алып, Миссиді кінәлайсыз ба?
Dialogue: 0,0:22:01.15,0:22:03.90,Default,,0,0,0,,Бұл менің ниетім емес.
Dialogue: 0,0:22:04.03,0:22:06.65,Default,,0,0,0,,Шынымен бе? Сен сондай мейірімдісің.
Dialogue: 0,0:22:06.78,0:22:09.28,Default,,0,0,0,,Менің айтқанымды айт
Dialogue: 0,0:22:10.45,0:22:11.07,Default,,0,0,0,,Девин
Dialogue: 0,0:22:11.20,0:22:14.20,Default,,0,0,0,,Әкеңді сүйгенім үшін мені айыптайсың ба?
Dialogue: 0,0:22:14.33,0:22:17.29,Default,,0,0,0,,Бұл не? Мен оны жыртып аламын.
Dialogue: 0,0:22:17.41,0:22:18.42,Default,,0,0,0,,Лаура
Dialogue: 0,0:22:19.46,0:22:20.08,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:22:20.21,0:22:21.59,Default,,0,0,0,,Кешір мені.
Dialogue: 0,0:22:21.71,0:22:25.63,Default,,0,0,0,,Мен сенің дос болғаным үшін бақыттымын...
Dialogue: 0,0:22:27.34,0:22:29.55,Default,,0,0,0,,Мен кемелдікке тым көп ұмтылдым
Dialogue: 0,0:22:29.68,0:22:34.43,Default,,0,0,0,,Шынымды айтайын, сен құдайсың.
Dialogue: 0,0:22:34.56,0:22:39.31,Default,,0,0,0,,Мен тек адам костюмін кигім келмеді.
Dialogue: 0,0:22:39.44,0:22:41.81,Default,,0,0,0,,Мен бұл сөздерді естігім келді
Dialogue: 0,0:22:41.94,0:22:43.44,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:22:44.15,0:22:46.15,Default,,0,0,0,,Қорытынды бөлім ad-lib болып табылады.
Dialogue: 0,0:22:46.28,0:22:46.90,Default,,0,0,0,,Иә
Dialogue: 0,0:22:47.03,0:22:49.86,Default,,0,0,0,,Дарынды елес жазушы.
Dialogue: 0,0:22:50.07,0:22:53.49,Default,,0,0,0,,Мисси, сізді ренжіткенім үшін кешіріңіз.
Dialogue: 0,0:22:53.83,0:22:59.79,Default,,0,0,0,,Бұл менің кінәм, мен сені танымал еткім келді.
Dialogue: 0,0:22:59.92,0:23:03.96,Default,,0,0,0,,Шаш жинағы тамаша~
Dialogue: 0,0:23:04.59,0:23:10.30,Default,,0,0,0,,Менің де қантым көтеріліп қалды... Мен оны ұстай алмадым.
Dialogue: 0,0:23:10.43,0:23:15.89,Default,,0,0,0,,Жылауды тоқтат, DVD-ден көрейік.
Dialogue: 0,0:23:16.01,0:23:19.89,Default,,0,0,0,,Натан Филионның «Құлып».
Dialogue: 0,0:23:20.02,0:23:21.81,Default,,0,0,0,,Мен қуаныштымын
Dialogue: 0,0:23:23.23,0:23:24.86,Default,,0,0,0,,Табылмады
Dialogue: 0,0:23:26.19,0:23:27.82,Default,,0,0,0,,Бұл иіс...
Dialogue: 0,0:23:27.94,0:23:29.07,Default,,0,0,0,,Сорпа!
Dialogue: 0,0:23:30.61,0:23:32.70,Default,,0,0,0,,Мені сорпамен шақыр
Dialogue: 0,0:23:32.82,0:23:33.91,Default,,0,0,0,,«Мен… мен адаммын.»
Dialogue: 0,0:23:35.62,0:23:38.29,Default,,0,0,0,,Жақсы, сен амансың.
Dialogue: 0,0:23:38.91,0:23:40.79,Default,,0,0,0,,Неліктен багаж керек?
Dialogue: 0,0:23:40.91,0:23:42.50,Default,,0,0,0,,Біз үйге барамыз
Dialogue: 0,0:23:42.67,0:23:44.63,Default,,0,0,0,,Мен ұрық жегім келмейді
Dialogue: 0,0:23:44.75,0:23:46.29,Default,,0,0,0,,Сен қайда жасырдың?
Dialogue: 0,0:23:46.42,0:23:48.55,Default,,0,0,0,,Тәттілерді қараңыз
Dialogue: 0,0:23:48.67,0:23:50.22,Default,,0,0,0,,Екеуміз бірге қашайық
Dialogue: 0,0:23:50.34,0:23:52.09,Default,,0,0,0,,Бұл менің үйім
Dialogue: 0,0:23:52.22,0:23:55.10,Default,,0,0,0,,Терезеден шық, мен саған біраз уақыт сатып аламын.
Dialogue: 0,0:23:56.43,0:23:58.06,Default,,0,0,0,,Батутты көздеңіз
Dialogue: 0,0:23:58.18,0:23:58.77,Default,,0,0,0,,Ник
Dialogue: 0,0:23:58.89,0:23:59.47,Default,,0,0,0,,Не?
Dialogue: 0,0:23:59.60,0:24:01.39,Default,,0,0,0,,Мен сіздің үйіңізге бара аламын ба?
Dialogue: 0,0:24:01.52,0:24:04.90,Default,,0,0,0,,Секірмесем, жараланып қалсам.
Dialogue: 0,0:24:05.02,0:24:07.27,Default,,0,0,0,,Эй, шық!
Dialogue: 0,0:24:11.19,0:24:14.61,Default,,0,0,0,,Альберт пен басқалары әлі де көңілді
Dialogue: 0,0:24:17.03,0:24:19.91,Default,,0,0,0,,Бұл менің өмірімдегі ең жақсы түн
Dialogue: 0,0:24:20.04,0:24:22.71,Default,,0,0,0,,Ұйқылар аман болсын!
Dialogue: 0,0:24:29.80,0:24:32.59,Default,,0,0,0,,Castle Arroyo - кәсіпқой.
Dialogue: 0,0:24:32.72,0:24:34.76,Default,,0,0,0,,Сонымен, жүзу көпіршігін кім пайдаланады?
Dialogue: 0,0:24:34.89,0:24:38.68,Default,,0,0,0,,Бұл жақсы драма. Басты кейіпкер мінсіз.
Dialogue: 0,0:24:38.81,0:24:41.39,Default,,0,0,0,,Псевдо түнгі көрініспен суретке түсірілген
Dialogue: 0,0:24:41.52,0:24:42.31,Default,,0,0,0,,Мистер Столкер
Dialogue: 0,0:24:42.48,0:24:44.19,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:24:44.31,0:24:45.15,Default,,0,0,0,,Сәлем
Dialogue: 0,0:24:45.73,0:24:49.86,Default,,0,0,0,,Бұл толқуларға толы тамаша қашу болды!
Dialogue: 0,0:24:51.36,0:24:52.61,Default,,0,0,0,,Эндрю
Dialogue: 0,0:24:52.74,0:24:55.07,Default,,0,0,0,,Құдай-ау, сенің жастығың...
Dialogue: 0,0:24:55.20,0:24:57.66,Default,,0,0,0,,Жарайды, Ник.
Dialogue: 0,0:24:57.91,0:25:02.04,Default,,0,0,0,,Бүгін түнде кәдімгі жастыққа оралу маған тағдырдың жазуы болды.
Dialogue: 0,0:25:03.54,0:25:08.54,Default,,0,0,0,,Бірақ мен қашып құтылдым, бірақ өз миссиямды орындай алмағаныма көңілім қалды.
Dialogue: 0,0:25:08.67,0:25:12.17,Default,,0,0,0,,Көңіліңді түсірме, мен мынаны ұрлап алдым.
Dialogue: 0,0:25:13.26,0:25:14.05,Default,,0,0,0,,Құдай-ай, неге қыздар дәретханасында граффити жазып жүрсің өзің?!
Dialogue: 0,0:25:14.93,0:25:16.68,Default,,0,0,0,,Қандай нәрсе
Dialogue: 0,0:25:16.80,0:25:18.60,Default,,0,0,0,,Оны ойнауға бола ма?
Dialogue: 0,0:25:18.72,0:25:22.35,Default,,0,0,0,,Жақсы, өйткені менде бейне палуба бар.
Dialogue: 0,0:25:22.47,0:25:25.52,Default,,0,0,0,,Джей ең есі дұрыс адам емес.
Dialogue: 0,0:25:25.64,0:25:27.81,Default,,0,0,0,,Анам да жынды екен
Dialogue: 0,0:25:27.94,0:25:30.57,Default,,0,0,0,,Үлкен ағалар ұрықпен шабуыл жасайды
Dialogue: 0,0:25:30.69,0:25:35.32,Default,,0,0,0,,Қанша адам өз ұрығын жейді?
Dialogue: 0,0:26:25.87,0:26:27.87,Default,,0,0,0,,Жапон субтитрлері Исозаки Нагиса
Dialogue: 0,0:26:29.37,0:26:35.37,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
