Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.00,0:00:07.71,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:07.79,0:00:08.46,Default,,0,0,0,,Біз жарты жолды өтіп қойдық — бізді тежеме, жарай ма?
Dialogue: 0,0:00:09.75,0:00:11.17,Default,,0,0,0,,Хмм, жақсы...
Dialogue: 0,0:00:11.26,0:00:14.30,Default,,0,0,0,,Абракадабра!
Dialogue: 0,0:00:16.39,0:00:17.76,Default,,0,0,0,,Бұл тамаша болды
Dialogue: 0,0:00:17.85,0:00:19.47,Default,,0,0,0,,Жақсы сезінді
Dialogue: 0,0:00:19.56,0:00:21.06,Default,,0,0,0,,Сізге рахмет
Dialogue: 0,0:00:21.14,0:00:22.35,Default,,0,0,0,,Осы жолы…
Dialogue: 0,0:00:22.43,0:00:23.98,Default,,0,0,0,,Қазірше сау бол,
Dialogue: 0,0:00:24.27,0:00:25.98,Default,,0,0,0,,Қане, менің жамбамды жуайық
Dialogue: 0,0:00:26.06,0:00:27.98,Default,,0,0,0,,Джей, бір минут сөйлесе аламыз ба?
Dialogue: 0,0:00:28.86,0:00:32.36,Default,,0,0,0,,Мен сені алма теруге апара алмаймын.
Dialogue: 0,0:00:32.44,0:00:35.86,Default,,0,0,0,,Жоқ, оны қалай айтамын...
Dialogue: 0,0:00:36.24,0:00:37.16,Default,,0,0,0,,Сіз кешіктіңіз бе?
Dialogue: 0,0:00:37.24,0:00:39.33,Default,,0,0,0,,Жастықтар өшпейді, солай ма?
Dialogue: 0,0:00:39.41,0:00:41.41,Default,,0,0,0,,Жоқ, мен жүктімін.
Dialogue: 0,0:00:41.49,0:00:42.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:42.45,0:00:43.79,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:00:44.33,0:00:46.00,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:00:46.08,0:00:48.88,Default,,0,0,0,,Мен сенен сақ болуды өтіндім.
Dialogue: 0,0:00:48.96,0:00:52.59,Default,,0,0,0,,Сіз дақтар туралы айтып отырсыз ба? Балалар тым кішкентай!
Dialogue: 0,0:00:52.67,0:00:54.17,Default,,0,0,0,,Дайын болыңыз.
Dialogue: 0,0:00:54.26,0:00:56.18,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:00:56.26,0:01:00.31,Default,,0,0,0,,Балалар, иықтарыңды жуыңдар да, мектепке барыңдар!
Dialogue: 0,0:01:00.39,0:01:00.93,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:01:01.01,0:01:01.93,Default,,0,0,0,,Жуылған
Dialogue: 0,0:01:02.02,0:01:03.52,Default,,0,0,0,,Шүкір, мен кешігіп қалдым.
Dialogue: 0,0:01:36.67,0:01:38.05,Default,,0,0,0,,«Джаз клубына кіру сынағы»
Dialogue: 0,0:01:40.60,0:01:41.85,Default,,0,0,0,,〝Джаз клубының қосылу сынағы жүріп жатыр〞
Dialogue: 0,0:01:41.85,0:01:44.56,Default,,0,0,0,,«Джаз клубына кіру сынағы кезінде» Бұл жақсы болмады.
Dialogue: 0,0:01:44.56,0:01:44.85,Default,,0,0,0,,〝Джаз клубына қосылу сынағы жүріп жатыр〞
Dialogue: 0,0:01:44.97,0:01:47.31,Default,,0,0,0,,Кларнет ойнаушы дисквалификацияланды
Dialogue: 0,0:01:47.39,0:01:49.27,Default,,0,0,0,,Басқа таңдау жоқ
Dialogue: 0,0:01:49.35,0:01:50.31,Default,,0,0,0,,Шляпалар әдемі
Dialogue: 0,0:01:50.40,0:01:51.61,Default,,0,0,0,,Капыпа
Dialogue: 0,0:01:51.69,0:01:55.78,Default,,0,0,0,,Ол жас Вуди Алленге ұқсайды.
Dialogue: 0,0:01:55.86,0:01:57.20,Default,,0,0,0,,Вуди Аллен
Dialogue: 0,0:01:57.40,0:02:00.03,Default,,0,0,0,,Ол тек жыныстық қатынасты ойлайтын адам.
Dialogue: 0,0:02:00.12,0:02:05.08,Default,,0,0,0,,Сексуалдық зорлық-зомбылық жасады деп айыпталған, бірақ жауапқа тартылмаған, үйленген өгей қызы
Dialogue: 0,0:02:05.16,0:02:07.66,Default,,0,0,0,,Бұл күрделі, бірақ себебі түсінікті
Dialogue: 0,0:02:07.75,0:02:09.29,Default,,0,0,0,,Эндрю емтиханды тапсырды.
Dialogue: 0,0:02:09.37,0:02:10.13,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:02:10.21,0:02:12.25,Default,,0,0,0,,Қосылуыңызбен құттықтаймыз
Dialogue: 0,0:02:12.34,0:02:15.13,Default,,0,0,0,,Өз басым маған қалпақ ұнады.
Dialogue: 0,0:02:15.21,0:02:18.68,Default,,0,0,0,,Бұл джазға ұқсайды және өте жақсы.
Dialogue: 0,0:02:18.76,0:02:21.51,Default,,0,0,0,,Түсінгеніңізге қуаныштымын.
Dialogue: 0,0:02:21.59,0:02:24.51,Default,,0,0,0,,Келесі жолы менің есегіме мінгің келетінін айт.
Dialogue: 0,0:02:24.60,0:02:25.81,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:02:25.89,0:02:27.10,Default,,0,0,0,,Жоқ, тоқтатыңыз.
Dialogue: 0,0:02:27.18,0:02:30.27,Default,,0,0,0,,Вудиге тәнті болған ол ілгекті алып тастады.
Dialogue: 0,0:02:30.35,0:02:33.36,Default,,0,0,0,,Ол мен үшін батыр.
Dialogue: 0,0:02:34.40,0:02:36.61,Default,,0,0,0,,Лагердегі қыз есіңде ме?
Dialogue: 0,0:02:36.69,0:02:39.99,Default,,0,0,0,,Бұл Роланд, мен оны ағай деп ойладым.
Dialogue: 0,0:02:40.07,0:02:42.49,Default,,0,0,0,,Қартты сүйейін бе?
Dialogue: 0,0:02:42.57,0:02:43.58,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:02:43.66,0:02:45.16,Default,,0,0,0,,Кеше түнде электрондық пошта арқылы-
Dialogue: 0,0:02:45.24,0:02:48.75,Default,,0,0,0,,«Ертең қалада демалайық».
Dialogue: 0,0:02:49.50,0:02:50.79,Default,,0,0,0,,«Кімге» деген не?
Dialogue: 0,0:02:50.87,0:02:52.08,Default,,0,0,0,,Бұл терең мағына емес.
Dialogue: 0,0:02:52.17,0:02:55.75,Default,,0,0,0,,Олай емес, «татуласу».
Dialogue: 0,0:02:55.84,0:02:57.55,Default,,0,0,0,,Қала қызымен?
Dialogue: 0,0:02:57.63,0:02:59.67,Default,,0,0,0,,Жарайды, Нью-Йоркке барайық.
Dialogue: 0,0:02:59.76,0:03:00.38,Default,,0,0,0,,Менімен?
Dialogue: 0,0:03:00.47,0:03:05.18,Default,,0,0,0,,Әлде артында біртүрлі көйлек киген бала бар ма?
Dialogue: 0,0:03:05.26,0:03:06.85,Default,,0,0,0,,Бұл сіз туралы.
Dialogue: 0,0:03:06.93,0:03:09.39,Default,,0,0,0,,Кешіріңіз, бірақ мен қызықсыз адаммын.
Dialogue: 0,0:03:09.48,0:03:13.23,Default,,0,0,0,,Оның мінезі адал, пальтосы өте үлкен, бірақ...
Dialogue: 0,0:03:13.31,0:03:13.86,Default,,0,0,0,,Максимум
Dialogue: 0,0:03:13.94,0:03:16.23,Default,,0,0,0,,Қызық жоқ, жалғыз жүр
Dialogue: 0,0:03:16.32,0:03:18.03,Default,,0,0,0,,Мен ең жақын досыммен барғым келеді
Dialogue: 0,0:03:18.11,0:03:21.61,Default,,0,0,0,,Оған көмектесу мүмкін емес, джазменнің кезегі.
Dialogue: 0,0:03:21.70,0:03:26.33,Default,,0,0,0,,Тәуекелге барғанда табысқа жетеді.
Dialogue: 0,0:03:26.41,0:03:26.95,Default,,0,0,0,,Джаз?
Dialogue: 0,0:03:27.04,0:03:28.04,Default,,0,0,0,,Бұл өмір
Dialogue: 0,0:03:28.12,0:03:31.87,Default,,0,0,0,,Джаз, өмір сияқты, күткеннен де ұзаққа созылады.
Dialogue: 0,0:03:31.96,0:03:35.00,Default,,0,0,0,,Ақырзаман сен білген бойда келеді
Dialogue: 0,0:03:36.54,0:03:41.67,Default,,0,0,0,,Білмей тұрып, адасып жүрген елес болып кеттің.
Dialogue: 0,0:03:41.76,0:03:43.26,Default,,0,0,0,,Тіпті некрофилді жақсы көретіндер ме?
Dialogue: 0,0:03:43.34,0:03:43.89,Default,,0,0,0,,Герцог
Dialogue: 0,0:03:43.97,0:03:45.60,Default,,0,0,0,,Морис
Dialogue: 0,0:03:47.18,0:03:50.06,Default,,0,0,0,,Маған 7 доллар қарыз болдыңыз, солай ма?
Dialogue: 0,0:03:51.43,0:03:52.98,Default,,0,0,0,,Ол дұрыс.
Dialogue: 0,0:03:53.06,0:03:57.98,Default,,0,0,0,,Оның үстіне Пуэрто-Рикандық аққұба әйелдер көп.
Dialogue: 0,0:03:58.07,0:03:59.53,Default,,0,0,0,,шытырман оқиғаға барайық
Dialogue: 0,0:03:59.61,0:04:00.15,Default,,0,0,0,,Джаз
Dialogue: 0,0:04:00.24,0:04:04.32,Default,,0,0,0,,Оның сырғалары соншалықты үлкен, ол сырғаларыңыздың ішіне сыйып кетеді.
Dialogue: 0,0:04:04.41,0:04:08.12,Default,,0,0,0,,Ата-анам мені GPS арқылы бақылап отырса ше?
Dialogue: 0,0:04:08.20,0:04:09.99,Default,,0,0,0,,Оны Джессиге қалдырыңыз.
Dialogue: 0,0:04:10.08,0:04:13.87,Default,,0,0,0,,Оның орнына барсаңыз пайдалы болар еді.
Dialogue: 0,0:04:13.96,0:04:16.25,Default,,0,0,0,,Түстен кейін ғибадатханада салтанат бар.
Dialogue: 0,0:04:16.33,0:04:18.29,Default,,0,0,0,,Бұл сізге пайдалы болуы мүмкін
Dialogue: 0,0:04:18.38,0:04:19.38,Default,,0,0,0,,Міне, алма мен жаңғақ қосылған карамельді вафлилер.
Dialogue: 0,0:04:19.46,0:04:20.63,Default,,0,0,0,,Сәттілік қыз
Dialogue: 0,0:04:20.71,0:04:21.26,Default,,0,0,0,,Бұл ұл бала
Dialogue: 0,0:04:21.34,0:04:22.47,Default,,0,0,0,,Қабығыңнан шығу
Dialogue: 0,0:04:22.55,0:04:24.80,Default,,0,0,0,,Қорқынышыңды жеңіп, менімен бірге жүр
Dialogue: 0,0:04:24.88,0:04:26.22,Default,,0,0,0,,Қалай босаңсуға болады?
Dialogue: 0,0:04:26.30,0:04:29.72,Default,,0,0,0,,Әріптердің жақсы жазылғаны рас...
Dialogue: 0,0:04:29.81,0:04:31.18,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:04:31.27,0:04:33.10,Default,,0,0,0,,Олар жақсы ата-ана сияқты.
Dialogue: 0,0:04:33.18,0:04:33.73,Default,,0,0,0,,Иә
Dialogue: 0,0:04:33.81,0:04:37.98,Default,,0,0,0,,Жолсеріксіз экскурсияның маңыздылығын түсіну.
Dialogue: 0,0:04:38.06,0:04:41.40,Default,,0,0,0,,Ешқандай күмән жоқ.
Dialogue: 0,0:04:41.53,0:04:43.70,Default,,0,0,0,,Сізді алдағаным үшін кешіріңіз.
Dialogue: 0,0:04:43.78,0:04:46.74,Default,,0,0,0,,Бірақ сіз біреумен сөйлесуге қуанышты сияқтысыз.
Dialogue: 0,0:04:46.82,0:04:52.16,Default,,0,0,0,,Негізі мен де Нью-Йоркке барамын. Бір жерде кездескіңіз келе ме?
Dialogue: 0,0:04:52.25,0:04:53.41,Default,,0,0,0,,Бұл жүзім бұтасына ұқсайды ма?
Dialogue: 0,0:04:53.50,0:04:54.08,Default,,0,0,0,,Манхэттенде?
Dialogue: 0,0:04:54.16,0:04:58.92,Default,,0,0,0,,Квинстегі П. (Патрик) Юингтің дүкенінде.
Dialogue: 0,0:04:59.09,0:05:01.46,Default,,0,0,0,,Қарапайым және керемет атмосфера
Dialogue: 0,0:05:01.55,0:05:03.21,Default,,0,0,0,,Иә, мүмкін
Dialogue: 0,0:05:03.30,0:05:06.72,Default,,0,0,0,,Мүмкін.
Dialogue: 0,0:05:07.84,0:05:10.43,Default,,0,0,0,,Қаламды шанышқыдай ұстайсың, солай ма?
Dialogue: 0,0:05:10.51,0:05:11.39,Default,,0,0,0,,〝Бриджтон орта мектебі〞
Dialogue: 0,0:05:11.39,0:05:12.22,Default,,0,0,0,,〝Бриджтон орта мектебі〞
Dialogue: 0,0:05:11.39,0:05:12.22,Default,,0,0,0,,Жарайды, Нью-Йоркке кетейік!
Dialogue: 0,0:05:12.22,0:05:14.10,Default,,0,0,0,,Жарайды, Нью-Йоркке кетейік!
Dialogue: 0,0:05:14.60,0:05:16.06,Default,,0,0,0,,Бұл қалпақ күлкілі
Dialogue: 0,0:05:16.14,0:05:17.73,Default,,0,0,0,,Бұл джаз қалпағы.
Dialogue: 0,0:05:17.85,0:05:20.44,Default,,0,0,0,,Сіз оны шынымен киесіз бе?
Dialogue: 0,0:05:20.52,0:05:23.57,Default,,0,0,0,,Мен оны атамнан қалған мұраның бір бөлігіне сатып алдым.
Dialogue: 0,0:05:23.65,0:05:25.74,Default,,0,0,0,,Бұл өтірік. Қанша?
Dialogue: 0,0:05:25.82,0:05:27.70,Default,,0,0,0,,$199
Dialogue: 0,0:05:27.78,0:05:31.91,Default,,0,0,0,,Бұл тамаша қалпақ, сондықтан орынды шығар.
Dialogue: 0,0:05:34.95,0:05:35.87,Default,,0,0,0,,Таңертеңгі ауру?
Dialogue: 0,0:05:35.96,0:05:37.83,Default,,0,0,0,,Иә, сен сабақты сағындың ба?
Dialogue: 0,0:05:37.92,0:05:39.21,Default,,0,0,0,,Әрине
Dialogue: 0,0:05:39.58,0:05:42.80,Default,,0,0,0,,Сонымен, сіз шешім қабылдадыңыз ба?
Dialogue: 0,0:05:42.88,0:05:43.55,Default,,0,0,0,,Не?
Dialogue: 0,0:05:43.63,0:05:45.38,Default,,0,0,0,,Жүктілік туралы.
Dialogue: 0,0:05:45.47,0:05:46.26,Default,,0,0,0,,Менің құлағанымды қалайсың ба?
Dialogue: 0,0:05:46.34,0:05:49.22,Default,,0,0,0,,Мені қате түсінбеңіз, бірақ қаласаңыз...
Dialogue: 0,0:05:49.30,0:05:49.84,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:05:49.93,0:05:53.47,Default,,0,0,0,,Әрине, мен құлау керек деп тұрған жоқпын.
Dialogue: 0,0:05:53.56,0:05:57.35,Default,,0,0,0,,Менің жасым 40-та, бұл менің соңғы рет балалы болуым болуы мүмкін.
Dialogue: 0,0:05:57.48,0:05:58.02,Default,,0,0,0,,Не?
Dialogue: 0,0:05:58.10,0:05:59.44,Default,,0,0,0,,Бұрын атамның үйінде
Dialogue: 0,0:05:59.52,0:06:00.61,Default,,0,0,0,,Бұл өтірік!
Dialogue: 0,0:06:00.73,0:06:01.27,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:01.36,0:06:03.78,Default,,0,0,0,,Менің жасымды білесің бе?
Dialogue: 0,0:06:03.86,0:06:04.69,Default,,0,0,0,,Сіз 40 жастасыз, солай ма?
Dialogue: 0,0:06:04.78,0:06:06.07,Default,,0,0,0,,Неліктен бұлай?
Dialogue: 0,0:06:07.15,0:06:08.61,Default,,0,0,0,,Менің жасым 40-та
Dialogue: 0,0:06:09.28,0:06:11.45,Default,,0,0,0,,Ол 40 жастағы атақты сиқыршы.
Dialogue: 0,0:06:11.53,0:06:15.08,Default,,0,0,0,,Мен 40 жасқа дейін ақша жинап, қызыл Tesla сатып алдым.
Dialogue: 0,0:06:15.16,0:06:18.21,Default,,0,0,0,,Біз бір жастамыз. Мен қартты білемін.
Dialogue: 0,0:06:18.29,0:06:20.71,Default,,0,0,0,,Аузыңды жап, жасым 40-та!
Dialogue: 0,0:06:20.79,0:06:22.21,Default,,0,0,0,,Жасың нешеде?
Dialogue: 0,0:06:22.29,0:06:23.29,Default,,0,0,0,,13 жас
Dialogue: 0,0:06:23.38,0:06:25.71,Default,,0,0,0,,Әке болу үшін тым жас
Dialogue: 0,0:06:25.80,0:06:29.55,Default,,0,0,0,,Сондықтан мен сенің менен жасырын құтылуыңды қалаймын.
Dialogue: 0,0:06:39.02,0:06:40.44,Default,,0,0,0,,Бұл осында.
Dialogue: 0,0:06:40.52,0:06:42.15,Default,,0,0,0,,Аман-есен келгеніңізге қуаныштымын.
Dialogue: 0,0:06:42.23,0:06:44.77,Default,,0,0,0,,Сосын мен азаматтарға беремін.
Dialogue: 0,0:06:44.86,0:06:46.90,Default,,0,0,0,,Бухгалтерлік фирмаға айтыңыз...
Dialogue: 0,0:06:47.94,0:06:49.36,Default,,0,0,0,,Қош бол кеңсе қызметкері
Dialogue: 0,0:06:49.45,0:06:52.78,Default,,0,0,0,,Ақ кеңседе тағы кездескенше.
Dialogue: 0,0:06:54.24,0:06:56.79,Default,,0,0,0,,Сіз қызыңызбен кездескендіктен қобалжисыз ба?
Dialogue: 0,0:06:56.87,0:06:57.87,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:06:57.95,0:07:00.41,Default,,0,0,0,,Қала балалары керемет
Dialogue: 0,0:07:00.50,0:07:02.13,Default,,0,0,0,,«Гилмор қыздары»...
Dialogue: 0,0:07:02.21,0:07:04.75,Default,,0,0,0,,Бұл маған қатысты емес.
Dialogue: 0,0:07:04.84,0:07:08.59,Default,,0,0,0,,Сонымен қатар, бұл қалпақ оның танымал болатынын білдірмейді.
Dialogue: 0,0:07:08.67,0:07:10.51,Default,,0,0,0,,Мағынасы Түсінесің бе?
Dialogue: 0,0:07:10.59,0:07:12.26,Default,,0,0,0,,Ник, бұл туралы ойланыңыз.
Dialogue: 0,0:07:12.34,0:07:15.60,Default,,0,0,0,,Бұл джаз дамыған қала.
Dialogue: 0,0:07:15.68,0:07:17.81,Default,,0,0,0,,Менің джаз қалпағым бар
Dialogue: 0,0:07:18.10,0:07:18.68,Default,,0,0,0,,Ол мені осы күйімде көрмесін деп, батыл болып көрінуге барынша тырысып жүрмін
Dialogue: 0,0:07:18.77,0:07:21.27,Default,,0,0,0,,Музыкантқа ұқсайды
Dialogue: 0,0:07:21.35,0:07:22.06,Default,,0,0,0,,О
Dialogue: 0,0:07:22.15,0:07:23.35,Default,,0,0,0,,Ұят болма
Dialogue: 0,0:07:23.44,0:07:24.23,Default,,0,0,0,,Мен өзімді жеңіл сезінемін
Dialogue: 0,0:07:24.31,0:07:28.86,Default,,0,0,0,,Езекиелдің ежелгі дәнді дақылдардан жасалған наны бар ма?
Dialogue: 0,0:07:28.94,0:07:33.45,Default,,0,0,0,,Қайызғақтың алдын алу үшін витаминдер қабылдау керек.
Dialogue: 0,0:07:33.53,0:07:34.74,Default,,0,0,0,,Өзіңізден сұраңыз
Dialogue: 0,0:07:36.41,0:07:38.12,Default,,0,0,0,,Ролан?
Dialogue: 0,0:07:38.20,0:07:38.91,Default,,0,0,0,,Ник
Dialogue: 0,0:07:39.00,0:07:39.87,Default,,0,0,0,,Сәлем
Dialogue: 0,0:07:40.25,0:07:41.83,Default,,0,0,0,,Бұл Эндрю.
Dialogue: 0,0:07:41.91,0:07:43.58,Default,,0,0,0,,Кларнетист
Dialogue: 0,0:07:43.67,0:07:47.96,Default,,0,0,0,,Ахаха шедевр! сен сондай күлкілісің
Dialogue: 0,0:07:48.05,0:07:48.59,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:07:48.67,0:07:51.55,Default,,0,0,0,,Әсіресе жабын (қалыптау) сияқты заттар
Dialogue: 0,0:07:51.63,0:07:53.76,Default,,0,0,0,,Мен оны сауда көшесінен (сауда орталығы) сатып алдым.
Dialogue: 0,0:07:54.39,0:07:57.14,Default,,0,0,0,,Сіз Роландпен кездесесіз бе?
Dialogue: 0,0:07:57.22,0:07:57.76,Default,,0,0,0,,Йосе
Dialogue: 0,0:07:57.85,0:08:00.22,Default,,0,0,0,,Ник оны жақсы көреді
Dialogue: 0,0:08:00.31,0:08:04.27,Default,,0,0,0,,Кешіріңіз, екеуіңіз гей жұп болдыңыз ба?
Dialogue: 0,0:08:04.35,0:08:07.02,Default,,0,0,0,,Әй, үндеме!
Dialogue: 0,0:08:07.11,0:08:11.28,Default,,0,0,0,,Боредом-кун келесі көрмеге өте ыңғайлы.
Dialogue: 0,0:08:11.36,0:08:13.86,Default,,0,0,0,,Кешіріңіз, бірақ сіз кімсіз?
Dialogue: 0,0:08:13.95,0:08:15.45,Default,,0,0,0,,Ия, жалбыз
Dialogue: 0,0:08:15.53,0:08:17.07,Default,,0,0,0,,Ол авангард суретшісі.
Dialogue: 0,0:08:17.16,0:08:21.25,Default,,0,0,0,,Сондай-ақ ол Киелі кітаптағы әрбір сөйлемнің соңына сұрақ белгілерін қойды.
Dialogue: 0,0:08:21.75,0:08:23.41,Default,,0,0,0,,Мен ата-анамды жек көремін.
Dialogue: 0,0:08:23.50,0:08:25.12,Default,,0,0,0,,О, мен де.
Dialogue: 0,0:08:25.21,0:08:28.46,Default,,0,0,0,,Бұл сурет М.Гринфилд пе?
Dialogue: 0,0:08:28.54,0:08:29.67,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:08:29.75,0:08:34.38,Default,,0,0,0,,Біз қазірдің өзінде дос сияқтымыз, бірақ сіз талап қоя бересіз.
Dialogue: 0,0:08:34.47,0:08:36.43,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:08:36.51,0:08:38.39,Default,,0,0,0,,Айтпақшы, мұнда неге келдің?
Dialogue: 0,0:08:38.47,0:08:40.64,Default,,0,0,0,,Сіз мені шақырдыңыз, солай ма?
Dialogue: 0,0:08:40.81,0:08:42.02,Default,,0,0,0,,Сол үшін келдің бе?
Dialogue: 0,0:08:42.10,0:08:44.48,Default,,0,0,0,,Менің де басқа жоспарларым бар.
Dialogue: 0,0:08:44.56,0:08:48.52,Default,,0,0,0,,Мен Бостандық мұнарасында құрмет көрсетемін.
Dialogue: 0,0:08:48.61,0:08:53.69,Default,,0,0,0,,Ауылдан келген егеуқұйрық сияқтысың.
Dialogue: 0,0:08:53.78,0:08:56.36,Default,,0,0,0,,Қала мысықтары сені жаман адам етеді
Dialogue: 0,0:08:56.45,0:08:57.53,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:08:57.66,0:08:58.37,Default,,0,0,0,,Ник…
Dialogue: 0,0:08:58.45,0:08:59.45,Default,,0,0,0,,Ролан
Dialogue: 0,0:08:59.62,0:09:00.20,Default,,0,0,0,,Сәлеметсіз бе...
Dialogue: 0,0:09:00.28,0:09:02.25,Default,,0,0,0,,Олар топозмен айналысады.
Dialogue: 0,0:09:02.33,0:09:04.66,Default,,0,0,0,,Бұл туралы уайымдамаңыз және сол жаққа барыңыз.
Dialogue: 0,0:09:04.75,0:09:09.00,Default,,0,0,0,,Өйткені мені қайызғаққа қарсы дәрі қабылдаған кезде көрдім.
Dialogue: 0,0:09:09.09,0:09:10.92,Default,,0,0,0,,Сіз мені медицинаны жақсы көреді деп ойлауыңыз мүмкін.
Dialogue: 0,0:09:11.00,0:09:12.26,Default,,0,0,0,,Бұл күлкілі
Dialogue: 0,0:09:12.34,0:09:15.30,Default,,0,0,0,,Мен күзетшіге айтуым керек...
Dialogue: 0,0:09:15.38,0:09:16.43,Default,,0,0,0,,Дүрбелеңге салынбаңыз
Dialogue: 0,0:09:16.51,0:09:18.05,Default,,0,0,0,,Тікұшақ келді.
Dialogue: 0,0:09:18.14,0:09:19.64,Default,,0,0,0,,Тікұшақ?
Dialogue: 0,0:09:19.72,0:09:21.81,Default,,0,0,0,,Бұл межелі жерге жетудің жалғыз жолы
Dialogue: 0,0:09:21.89,0:09:25.77,Default,,0,0,0,,«The Rock» Д.Джонсонның өтініші бойынша ақша сарайы-
Dialogue: 0,0:09:25.85,0:09:27.27,Default,,0,0,0,,Монтаудағы көрме
Dialogue: 0,0:09:27.35,0:09:28.69,Default,,0,0,0,,Сіз оны білесіз бе?
Dialogue: 0,0:09:28.77,0:09:29.90,Default,,0,0,0,,Тұрақты
Dialogue: 0,0:09:32.36,0:09:35.07,Default,,0,0,0,,Атқа отырудан бас тартыңыз.
Dialogue: 0,0:09:35.15,0:09:35.78,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:09:35.86,0:09:39.07,Default,,0,0,0,,Сіз мұндай мүмкіндікті жіберіп алғыңыз келе ме?
Dialogue: 0,0:09:39.16,0:09:43.74,Default,,0,0,0,,Қызықтым, бірақ ұша алмаймын.
Dialogue: 0,0:09:43.83,0:09:45.16,Default,,0,0,0,,Құлағыңызға зиян.
Dialogue: 0,0:09:45.25,0:09:47.08,Default,,0,0,0,,Бірақ ұшақпен Еуропаға
Dialogue: 0,0:09:47.16,0:09:49.75,Default,,0,0,0,,Мен өтірік айттым. Негізі мен ол жаққа көлікпен бардым.
Dialogue: 0,0:09:49.83,0:09:50.59,Default,,0,0,0,,Еуропада?
Dialogue: 0,0:09:50.67,0:09:52.25,Default,,0,0,0,,Бұл Флорида.
Dialogue: 0,0:09:52.34,0:09:56.55,Default,,0,0,0,,Онымен жұмыс жасайтын уақыт таяп қалды.
Dialogue: 0,0:09:56.63,0:09:59.93,Default,,0,0,0,,Менің тіземде жалбыз қуыршақпен
Dialogue: 0,0:10:00.01,0:10:01.51,Default,,0,0,0,,Жалбыз туралы не деуге болады?
Dialogue: 0,0:10:01.60,0:10:02.51,Default,,0,0,0,,«Долхудор»
Dialogue: 0,0:10:02.60,0:10:05.02,Default,,0,0,0,,Дельфин-пудель будандары
Dialogue: 0,0:10:05.10,0:10:07.18,Default,,0,0,0,,Сіз мұны білесіз бе?
Dialogue: 0,0:10:07.27,0:10:09.10,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:10:09.56,0:10:12.23,Default,,0,0,0,,Әй, сен жақсы қызсың.
Dialogue: 0,0:10:12.32,0:10:14.69,Default,,0,0,0,,Саусақтарыңызды жеуге болады
Dialogue: 0,0:10:14.82,0:10:18.36,Default,,0,0,0,,Кевинге жас жүгері сияқты көрінеді.
Dialogue: 0,0:10:18.45,0:10:19.03,Default,,0,0,0,,Кевин?
Dialogue: 0,0:10:19.11,0:10:22.49,Default,,0,0,0,,Бұл баланың аты, айтпадым ба?
Dialogue: 0,0:10:22.58,0:10:24.04,Default,,0,0,0,,Ник, сен мінесің бе?
Dialogue: 0,0:10:24.12,0:10:27.08,Default,,0,0,0,,Екеуі де жақсы, бірақ тез шешім қабылдаңыз.
Dialogue: 0,0:10:27.16,0:10:30.63,Default,,0,0,0,,Мен ешқашан атқа мінбеймін
Dialogue: 0,0:10:31.04,0:10:35.05,Default,,0,0,0,,Оның ұшуға қабілеті жоқ. Мен онымен кейінірек кездесе аламын ба?
Dialogue: 0,0:10:35.46,0:10:38.63,Default,,0,0,0,,Қалай болғанда да, теңіз жағасындағы Дуэйннің үйінде.
Dialogue: 0,0:10:38.72,0:10:41.22,Default,,0,0,0,,Жарайды, мен міндетті түрде барамын.
Dialogue: 0,0:10:41.30,0:10:45.14,Default,,0,0,0,,Айтпағаныңды ұмытпа
Dialogue: 0,0:10:45.22,0:10:47.14,Default,,0,0,0,,«Айқай музыкаға айналады»
Dialogue: 0,0:10:47.22,0:10:48.73,Default,,0,0,0,,Түсіндім, Минт.
Dialogue: 0,0:10:48.81,0:10:50.56,Default,,0,0,0,,Менің қалпағым кетті
Dialogue: 0,0:10:50.69,0:10:51.98,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:10:53.02,0:10:54.48,Default,,0,0,0,,Ол ұшып бара жатты
Dialogue: 0,0:10:54.90,0:10:57.44,Default,,0,0,0,,Мен де солай ойладым.
Dialogue: 0,0:10:58.07,0:10:59.70,Default,,0,0,0,,Бұл $199.
Dialogue: 0,0:10:59.78,0:11:00.20,Default,,0,0,0,,«Қате»
Dialogue: 0,0:11:00.20,0:11:01.28,Default,,0,0,0,,«Қате»
Dialogue: 0,0:11:00.20,0:11:01.28,Default,,0,0,0,,Бұл IC чипі. Оны енгізіңіз.
Dialogue: 0,0:11:01.28,0:11:02.57,Default,,0,0,0,,Бұл IC чипі. Оны енгізіңіз.
Dialogue: 0,0:11:02.70,0:11:04.16,Default,,0,0,0,,Тағы бір қате
Dialogue: 0,0:11:04.24,0:11:05.66,Default,,0,0,0,,Қарғыс атсын, маған бер.
Dialogue: 0,0:11:06.04,0:11:07.20,Default,,0,0,0,,Не?
Dialogue: 0,0:11:07.29,0:11:08.50,Default,,0,0,0,,Джеймс
Dialogue: 0,0:11:09.41,0:11:10.37,Default,,0,0,0,,Таниша!
Dialogue: 0,0:11:10.92,0:11:12.38,Default,,0,0,0,,Мен қалпағымды іздеуім керек.
Dialogue: 0,0:11:12.46,0:11:13.42,Default,,0,0,0,,Сіз кешігіп қаласыз.
Dialogue: 0,0:11:13.50,0:11:16.71,Default,,0,0,0,,Мен оны таппайынша ешқайда кетпеймін.
Dialogue: 0,0:11:16.80,0:11:20.80,Default,,0,0,0,,Түсіндім, мен оны тапқан кезде бұл Монтау.
Dialogue: 0,0:11:20.88,0:11:25.18,Default,,0,0,0,,Мен жолда Езекиел нан жеймін.
Dialogue: 0,0:11:25.26,0:11:26.64,Default,,0,0,0,,Қайызғақты болдырмауға арналған.
Dialogue: 0,0:11:26.72,0:11:28.22,Default,,0,0,0,,Күніне екі рет.
Dialogue: 0,0:11:28.31,0:11:30.73,Default,,0,0,0,,Эй, есікті аш.
Dialogue: 0,0:11:30.85,0:11:32.85,Default,,0,0,0,,Не болды? Сенімен бәрі жақсы ма?
Dialogue: 0,0:11:35.73,0:11:37.40,Default,,0,0,0,,Мен сені тептім.
Dialogue: 0,0:11:37.48,0:11:38.94,Default,,0,0,0,,Бұл кім? Мен сені ұрамын.
Dialogue: 0,0:11:39.03,0:11:41.20,Default,,0,0,0,,Нәрестенің ұрық қозғалысы
Dialogue: 0,0:11:41.28,0:11:44.62,Default,,0,0,0,,Бұл түсік жасатуды тоқтататыныңызды білдіре ме?
Dialogue: 0,0:11:44.70,0:11:45.32,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:11:45.41,0:11:49.70,Default,,0,0,0,,Бірақ қатаң айтқанда, бұл туғанға дейін мүмкін еді.
Dialogue: 0,0:11:49.79,0:11:53.33,Default,,0,0,0,,Қорқынышты ештеңе айтпа, қолыңды тигіз
Dialogue: 0,0:11:54.29,0:11:54.96,Default,,0,0,0,,Адам аяғы тимейтін орынды әдейі таңдаған...
Dialogue: 0,0:11:55.04,0:11:57.09,Default,,0,0,0,,Шынымды айтсам, өмір тыныс алуда
Dialogue: 0,0:11:57.17,0:11:57.71,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:11:57.80,0:12:00.63,Default,,0,0,0,,Мүмкін менің ең жақсы сиқырым шығар
Dialogue: 0,0:12:01.17,0:12:01.88,Default,,0,0,0,,Екі адам.
Dialogue: 0,0:12:01.97,0:12:05.22,Default,,0,0,0,,Мен сиқыршымын, ал сен менің сенімді көмекшімсің
Dialogue: 0,0:12:05.30,0:12:06.80,Default,,0,0,0,,Мен де сиқыршы болармын
Dialogue: 0,0:12:06.89,0:12:10.77,Default,,0,0,0,,Сіз мені әлемдегі ең бақытты сиқыршы етесіз бе?
Dialogue: 0,0:12:10.85,0:12:11.98,Default,,0,0,0,,Джей…
Dialogue: 0,0:12:12.94,0:12:13.48,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:12:13.56,0:12:14.40,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:12:14.48,0:12:18.27,Default,,0,0,0,,Өзіңді баспалдақтан лақтыр, мен сені жазалаймын!
Dialogue: 0,0:12:18.52,0:12:20.36,Default,,0,0,0,,Бұл анық жағдай.
Dialogue: 0,0:12:20.44,0:12:22.49,Default,,0,0,0,,Ашуланып жанған жастық...
Dialogue: 0,0:12:22.57,0:12:26.12,Default,,0,0,0,,Сексуалды сиқыршыны итеріп өлтірді.
Dialogue: 0,0:12:26.20,0:12:29.54,Default,,0,0,0,,Мамық жастық құлады.
Dialogue: 0,0:12:30.95,0:12:32.00,Default,,0,0,0,,Сіз күннен қорғайтын көзілдірік туралы білмейсіз бе?
Dialogue: 0,0:12:32.08,0:12:34.29,Default,,0,0,0,,Бұл сіздікі, солай ма?
Dialogue: 0,0:12:34.96,0:12:36.13,Default,,0,0,0,,Бұл үлкен мәселе
Dialogue: 0,0:12:37.13,0:12:39.46,Default,,0,0,0,,Сіз осындай қалпақ көрдіңіз бе?
Dialogue: 0,0:12:39.55,0:12:44.05,Default,,0,0,0,,Менің мақсатыма кедергі келтіретін джаз қалпағын көріп тұрсың ба?
Dialogue: 0,0:12:44.13,0:12:48.68,Default,,0,0,0,,Балам, сен өзіңіздің құмарыңызға қарап көрдіңіз бе?
Dialogue: 0,0:12:48.76,0:12:49.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:49.39,0:12:50.85,Default,,0,0,0,,Ник, бұл менмін.
Dialogue: 0,0:12:51.22,0:12:52.22,Default,,0,0,0,,Герцог?
Dialogue: 0,0:12:53.85,0:12:57.52,Default,,0,0,0,,Бүгін мен 11 адамның денесіне кірдім.
Dialogue: 0,0:12:57.61,0:13:00.77,Default,,0,0,0,,Оның тірі кезінде байланыстырылған жазбалар.
Dialogue: 0,0:13:01.44,0:13:05.57,Default,,0,0,0,,Қалайсың? ақ бала
Dialogue: 0,0:13:05.65,0:13:06.78,Default,,0,0,0,,Сіз мас екенсіз, герцог.
Dialogue: 0,0:13:06.86,0:13:09.83,Default,,0,0,0,,Сен герцогсың, маскүнем.
Dialogue: 0,0:13:09.91,0:13:12.08,Default,,0,0,0,,Мен джаз қалпағымды жоғалтып алдым.
Dialogue: 0,0:13:12.16,0:13:13.62,Default,,0,0,0,,Ал, іздеп көрейік.
Dialogue: 0,0:13:13.70,0:13:15.96,Default,,0,0,0,,Мұндай үлкен қалада бұл мүмкін емес.
Dialogue: 0,0:13:16.04,0:13:17.08,Default,,0,0,0,,Осылайша, қарындас мектептер арасындағы алмасу шарасы—
Dialogue: 0,0:13:17.17,0:13:18.25,Default,,0,0,0,,Сіз адасып қалуыңыз мүмкін
Dialogue: 0,0:13:18.33,0:13:22.09,Default,,0,0,0,,Жарайды, Нью-Йоркте ешкім адаспайды.
Dialogue: 0,0:13:24.59,0:13:27.72,Default,,0,0,0,,Үлкен алмада адасып қалсаңыз...
Dialogue: 0,0:13:27.80,0:13:31.14,Default,,0,0,0,,Метромен Чинатаунға секіру
Dialogue: 0,0:13:31.22,0:13:33.06,Default,,0,0,0,,Егер сіз дұрыс емес жерге барсаңыз, алаңдайтын ештеңе жоқ.
Dialogue: 0,0:13:33.06,0:13:35.35,Default,,0,0,0,,Егер сіз дұрыс емес жерге барсаңыз, алаңдайтын ештеңе жоқ.
Dialogue: 0,0:13:33.06,0:13:35.35,Default,,0,0,0,,«Бруклинге»
Dialogue: 0,0:13:35.35,0:13:36.31,Default,,0,0,0,,Егер сіз дұрыс емес жерге барсаңыз, алаңдайтын ештеңе жоқ.
Dialogue: 0,0:13:37.23,0:13:39.98,Default,,0,0,0,,Қаладағы ескі еврей халқы...
Dialogue: 0,0:13:40.06,0:13:43.11,Default,,0,0,0,,Жастарға үйіңізді жалға беріп ақша табыңыз
Dialogue: 0,0:13:43.19,0:13:45.90,Default,,0,0,0,,Олардың ұзын сақалына, аяқ киіміне қараңдар.
Dialogue: 0,0:13:45.99,0:13:48.49,Default,,0,0,0,,Нью-Йорк қызық емес.
Dialogue: 0,0:13:48.57,0:13:49.11,Default,,0,0,0,,Сол жерде
Dialogue: 0,0:13:49.20,0:13:54.50,Default,,0,0,0,,Кіші Одессада тұрғың келсе, татуировка жаса.
Dialogue: 0,0:13:55.29,0:13:58.25,Default,,0,0,0,,Лонг-Айлендтегі атмосфера өте жаман.
Dialogue: 0,0:13:58.42,0:14:01.59,Default,,0,0,0,,Бірақ бұл менің сүйікті жерім
Dialogue: 0,0:14:01.67,0:14:04.26,Default,,0,0,0,,Жыпылықтауы бар қауіпті джив
Dialogue: 0,0:14:04.63,0:14:07.42,Default,,0,0,0,,Маджонг кемпірлерінен сақ болыңыз
Dialogue: 0,0:14:07.51,0:14:10.84,Default,,0,0,0,,Ақындар, панктар, іскер әйелдер және қорқынышты ерлер
Dialogue: 0,0:14:10.93,0:14:14.01,Default,,0,0,0,,Ешқашан ұйықтамайтын бейберекет қала
Dialogue: 0,0:14:14.10,0:14:18.14,Default,,0,0,0,,Жұмбақ және тамаша, сәнді және кір
Dialogue: 0,0:14:18.23,0:14:19.69,Default,,0,0,0,,Бірақ тартынбаңыз
Dialogue: 0,0:14:19.77,0:14:24.82,Default,,0,0,0,,Бұл Нью-Йорк!
Dialogue: 0,0:14:25.40,0:14:26.57,Default,,0,0,0,,Қолдап тұрғаның үшін рахмет.
Dialogue: 0,0:14:26.65,0:14:29.86,Default,,0,0,0,,Уайымдама, ол баяғыда өлген.
Dialogue: 0,0:14:29.95,0:14:32.20,Default,,0,0,0,,Бірақ біз мүлдем адасып қалдық.
Dialogue: 0,0:14:32.28,0:14:33.87,Default,,0,0,0,,Әй, қара
Dialogue: 0,0:14:34.12,0:14:34.91,Default,,0,0,0,,Менің қалпақ
Dialogue: 0,0:14:34.99,0:14:36.08,Default,,0,0,0,,Тездетіңіз
Dialogue: 0,0:14:39.08,0:14:39.79,Default,,0,0,0,,Мен таң қалдым
Dialogue: 0,0:14:39.87,0:14:41.83,Default,,0,0,0,,Екі әйелге бір қалпақ?
Dialogue: 0,0:14:41.92,0:14:44.09,Default,,0,0,0,,<Лесбияндардың сүйісу сахнасы>
Dialogue: 0,0:14:44.17,0:14:45.80,Default,,0,0,0,,Біз оның ортасындамыз.
Dialogue: 0,0:14:47.80,0:14:48.47,Default,,0,0,0,,Ол ма?
Dialogue: 0,0:14:48.55,0:14:49.55,Default,,0,0,0,,Джессидің анасы
Dialogue: 0,0:14:49.63,0:14:52.68,Default,,0,0,0,,Мен оны көрдім. Бұл шарасыз жағдай.
Dialogue: 0,0:14:52.76,0:14:54.22,Default,,0,0,0,,Жоғалайық
Dialogue: 0,0:14:54.31,0:14:54.93,Default,,0,0,0,,Ник?
Dialogue: 0,0:14:55.01,0:14:55.97,Default,,0,0,0,,Қауіпті
Dialogue: 0,0:14:56.06,0:14:57.14,Default,,0,0,0,,Эндрю?
Dialogue: 0,0:14:57.22,0:15:00.73,Default,,0,0,0,,Мен сенің күйеуің емес әйелді сүйгеніңді көрмедім.
Dialogue: 0,0:15:00.81,0:15:03.02,Default,,0,0,0,,Мен қиындыққа тап болдым.
Dialogue: 0,0:15:03.11,0:15:03.65,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:15:03.73,0:15:07.32,Default,,0,0,0,,Иә, мен оны қазір ғана қабылдап жатырмын.
Dialogue: 0,0:15:07.40,0:15:07.94,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:15:08.03,0:15:11.07,Default,,0,0,0,,Мен кездестірген адам әйел болатын.
Dialogue: 0,0:15:11.16,0:15:11.82,Default,,0,0,0,,Бірақ ол екі жылдан бері қоғамдық сахнаға шыққан жоқ
Dialogue: 0,0:15:11.91,0:15:16.08,Default,,0,0,0,,Біз өте жақсы араласамыз, ал Грег екеуміз...
Dialogue: 0,0:15:16.16,0:15:16.70,Default,,0,0,0,,Күйеу?
Dialogue: 0,0:15:16.79,0:15:18.33,Default,,0,0,0,,Жақсы емес
Dialogue: 0,0:15:18.41,0:15:21.83,Default,,0,0,0,,Мен оны қуып, жаңадан бастағым келеді.
Dialogue: 0,0:15:21.92,0:15:22.88,Default,,0,0,0,,Джесси ше?
Dialogue: 0,0:15:22.96,0:15:26.84,Default,,0,0,0,,Мен білмеймін. Мен әлі білгім келмейді.
Dialogue: 0,0:15:26.92,0:15:27.50,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:27.59,0:15:33.43,Default,,0,0,0,,Өтірік айтып жатырсың деп айта алмаймын, сондықтан оны шешуді өзіңе қалдырамын.
Dialogue: 0,0:15:35.85,0:15:37.18,Default,,0,0,0,,Бейшара жігіт
Dialogue: 0,0:15:37.26,0:15:38.27,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:15:38.97,0:15:40.27,Default,,0,0,0,,Біз осылай сезінеміз
Dialogue: 0,0:15:40.35,0:15:42.94,Default,,0,0,0,,Айтпақшы, мектеп ше?
Dialogue: 0,0:15:43.02,0:15:44.15,Default,,0,0,0,,Неліктен поцелу?
Dialogue: 0,0:15:44.23,0:15:44.77,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:15:44.86,0:15:46.73,Default,,0,0,0,,Мен оны көрмедім
Dialogue: 0,0:15:46.82,0:15:48.11,Default,,0,0,0,,Бұл жақсы болуы мүмкін
Dialogue: 0,0:15:48.19,0:15:52.57,Default,,0,0,0,,Келесі кездескенде табиғи болуға тырысыңыз.
Dialogue: 0,0:15:56.28,0:15:57.37,Default,,0,0,0,,Ағаш қоршауға барып, оны ұстап, бір-бірімізден ажырайық.
Dialogue: 0,0:15:57.45,0:16:01.21,Default,,0,0,0,,Сен баласың, сондықтан күнкөріске қол жеткізе алмайсың, солай ма?
Dialogue: 0,0:16:01.29,0:16:05.83,Default,,0,0,0,,Бірге жұмыс жасасақ, қолымыздан бәрі келеді. Мен сені сүйемін, Пам.
Dialogue: 0,0:16:05.92,0:16:09.46,Default,,0,0,0,,Мен де, Джавид Блейн.
Dialogue: 0,0:16:09.55,0:16:10.30,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:16:10.38,0:16:11.42,Default,,0,0,0,,Джавид Блейн
Dialogue: 0,0:16:11.51,0:16:12.30,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:12.38,0:16:13.68,Default,,0,0,0,,Джей оны салды
Dialogue: 0,0:16:13.76,0:16:15.51,Default,,0,0,0,,Әй
Dialogue: 0,0:16:15.59,0:16:16.14,Default,,0,0,0,,Не?
Dialogue: 0,0:16:16.22,0:16:18.31,Default,,0,0,0,,Бұл ешқашан болған емес
Dialogue: 0,0:16:18.39,0:16:19.31,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:16:19.39,0:16:21.56,Default,,0,0,0,,Бұл қиындатуы керек.
Dialogue: 0,0:16:21.64,0:16:23.52,Default,,0,0,0,,Мен ұсқынсыз болғандықтан ба?
Dialogue: 0,0:16:23.60,0:16:25.10,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:16:25.19,0:16:26.52,Default,,0,0,0,,Бұл өте үлкен
Dialogue: 0,0:16:26.61,0:16:27.27,Default,,0,0,0,,Сен әдемісің
Dialogue: 0,0:16:27.36,0:16:30.07,Default,,0,0,0,,Менің мүшесім кеңейіп жатыр!
Dialogue: 0,0:16:30.15,0:16:33.40,Default,,0,0,0,,Сұлу болсаң, жылауыңды доғар.
Dialogue: 0,0:16:34.07,0:16:38.03,Default,,0,0,0,,Мен балаға үлкен сиығыммен зиян келтіремін бе деп уайымдаймын.
Dialogue: 0,0:16:38.12,0:16:41.50,Default,,0,0,0,,Жақсы болса, мен сені қалаймын.
Dialogue: 0,0:16:41.58,0:16:42.54,Default,,0,0,0,,Шығып бара жатырсың ба?
Dialogue: 0,0:16:42.62,0:16:43.96,Default,,0,0,0,,Оны менің ішіме сал
Dialogue: 0,0:16:44.58,0:16:45.12,Default,,0,0,0,,О
Dialogue: 0,0:16:45.21,0:16:46.63,Default,,0,0,0,,Шынықтырылған
Dialogue: 0,0:16:46.71,0:16:48.92,Default,,0,0,0,,Ол жартасқа ұқсайды.
Dialogue: 0,0:16:49.00,0:16:49.75,Default,,0,0,0,,Оны салыңыз
Dialogue: 0,0:16:49.84,0:16:51.13,Default,,0,0,0,,Менің жасым 40-та
Dialogue: 0,0:16:51.59,0:16:54.51,Default,,0,0,0,,Менің сигімнің ұшында баланың басы бар
Dialogue: 0,0:16:54.80,0:16:56.39,Default,,0,0,0,,Мен баймын!
Dialogue: 0,0:16:56.47,0:16:57.47,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:16:57.55,0:17:02.77,Default,,0,0,0,,Егер қарым-қатынаста болған адам әйел болса, мен сіздің күйеуіңіз бен Джессиді аяймын.
Dialogue: 0,0:17:02.85,0:17:06.19,Default,,0,0,0,,Онымен салыстырғанда қалпақ жоқ.
Dialogue: 0,0:17:06.27,0:17:06.94,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:07.02,0:17:09.65,Default,,0,0,0,,Бас киімім жоғалып кетті, үйге қайттым...
Dialogue: 0,0:17:09.73,0:17:10.90,Default,,0,0,0,,Монтаукқа
Dialogue: 0,0:17:10.98,0:17:11.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:11.98,0:17:12.74,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба?
Dialogue: 0,0:17:12.82,0:17:16.57,Default,,0,0,0,,«Егер мен қалпақ тапсам, Монтаукқа барамын».
Dialogue: 0,0:17:16.78,0:17:19.66,Default,,0,0,0,,Мен нақты келіскенім есімде жоқ.
Dialogue: 0,0:17:19.78,0:17:21.54,Default,,0,0,0,,Қандай алдау!
Dialogue: 0,0:17:21.62,0:17:22.24,Default,,0,0,0,,Не?
Dialogue: 0,0:17:22.33,0:17:27.00,Default,,0,0,0,,Ұша алмайтын қайызғақты қорқақ, қалпағы ең жаман.
Dialogue: 0,0:17:27.08,0:17:28.17,Default,,0,0,0,,Қалпақтардың қандай ақауы бар?
Dialogue: 0,0:17:28.25,0:17:29.33,Default,,0,0,0,,Орынсыз
Dialogue: 0,0:17:29.42,0:17:31.09,Default,,0,0,0,,Қайсысы, қалпақ па, әлде мен бе?
Dialogue: 0,0:17:31.17,0:17:32.92,Default,,0,0,0,,Жетеді
Dialogue: 0,0:17:33.01,0:17:34.67,Default,,0,0,0,,Жоқ, айтыңызшы.
Dialogue: 0,0:17:34.76,0:17:35.47,Default,,0,0,0,,Қый!
Dialogue: 0,0:17:35.55,0:17:38.34,Default,,0,0,0,,Сіз жақсысыз ба, мен жеңілген адаммын ба?
Dialogue: 0,0:17:38.43,0:17:41.22,Default,,0,0,0,,Мен саған керек болсам да
Dialogue: 0,0:17:41.31,0:17:42.10,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:17:42.18,0:17:45.35,Default,,0,0,0,,Мен жалғыз келуге қатты қорықтым.
Dialogue: 0,0:17:45.43,0:17:46.81,Default,,0,0,0,,Мен өзімді ақымақ сияқты сезінемін
Dialogue: 0,0:17:46.89,0:17:50.06,Default,,0,0,0,,Мен бұған дейін ләззат алар едім.
Dialogue: 0,0:17:50.15,0:17:53.15,Default,,0,0,0,,Сен мейірімді болғаның үшін мен сенімен бірге шықтым.
Dialogue: 0,0:17:53.23,0:17:54.65,Default,,0,0,0,,Бару керек.
Dialogue: 0,0:17:54.74,0:17:57.24,Default,,0,0,0,,Менде 20 доллар бар, сондықтан үйге таксимен барамын.
Dialogue: 0,0:17:57.32,0:17:58.03,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:58.11,0:18:01.41,Default,,0,0,0,,Сіз кокаинді тастадыңыз, оның ақысын төлеңіз.
Dialogue: 0,0:18:02.20,0:18:05.66,Default,,0,0,0,,Неге екенін білмеймін, бірақ кешірім сұраймын.
Dialogue: 0,0:18:05.75,0:18:09.08,Default,,0,0,0,,Төгілген кокаин үшін төлеңіз
Dialogue: 0,0:18:09.17,0:18:11.13,Default,,0,0,0,,Герцогтың елесі, солай ма?
Dialogue: 0,0:18:11.21,0:18:12.84,Default,,0,0,0,,Шулы! Тездетіңіз
Dialogue: 0,0:18:12.92,0:18:14.00,Default,,0,0,0,,Көшедегі тонау
Dialogue: 0,0:18:14.09,0:18:15.38,Default,,0,0,0,,Жоқ, бұл алдау
Dialogue: 0,0:18:15.46,0:18:16.84,Default,,0,0,0,,Көшедегі тонауға келгенде осылай болады.
Dialogue: 0,0:18:17.13,0:18:18.55,Default,,0,0,0,,Маған ақшаны беріңіз!
Dialogue: 0,0:18:18.68,0:18:19.89,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:18:21.14,0:18:23.10,Default,,0,0,0,,Мен Кокаинді ұмытып кетіппін
Dialogue: 0,0:18:23.18,0:18:25.97,Default,,0,0,0,,Бұл «кокаин» және ол жалған.
Dialogue: 0,0:18:26.35,0:18:27.27,Default,,0,0,0,,Мен адамдардың өмірін сақтайтын жұмыста істедім
Dialogue: 0,0:18:30.31,0:18:33.48,Default,,0,0,0,,Осығаным үшін кешірім сұраймын, мен сіздің қасыңызда өзімді жайлы сезінемін.
Dialogue: 0,0:18:33.57,0:18:36.99,Default,,0,0,0,,Маған иіс ұнайды. Бұл мені толғандырады.
Dialogue: 0,0:18:37.07,0:18:38.07,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:18:39.03,0:18:40.82,Default,,0,0,0,,Сіз қазір шарықтау шегіне жеттіңіз бе?
Dialogue: 0,0:18:41.20,0:18:42.32,Default,,0,0,0,,Кеттік
Dialogue: 0,0:18:42.41,0:18:46.20,Default,,0,0,0,,Жоқ, бұл толғақ ауруы. Жақында сәби дүниеге келеді.
Dialogue: 0,0:18:46.29,0:18:47.91,Default,,0,0,0,,Күте тұрыңыз, аурухана?
Dialogue: 0,0:18:48.00,0:18:49.96,Default,,0,0,0,,Әлде тігін цехы ма?
Dialogue: 0,0:18:50.04,0:18:51.54,Default,,0,0,0,,Туған
Dialogue: 0,0:18:51.63,0:18:52.54,Default,,0,0,0,,Қазірдің өзінде?
Dialogue: 0,0:18:52.63,0:18:56.13,Default,,0,0,0,,Жастықтың жүктілік мерзімі шынымен де қысқа ма?
Dialogue: 0,0:18:57.97,0:19:02.22,Default,,0,0,0,,Бұл ең нашар жағдай сценарийі. Біз мүлдем жоғалып кеттік.
Dialogue: 0,0:19:02.30,0:19:05.47,Default,,0,0,0,,Ата-анам кеш болды деп уайымдап отыр.
Dialogue: 0,0:19:05.56,0:19:08.89,Default,,0,0,0,,Мен оны жақсырақ сүртуім керек еді.
Dialogue: 0,0:19:09.02,0:19:09.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:09.64,0:19:14.36,Default,,0,0,0,,Қағазды сулап, жақсылап сүртуім керек еді.
Dialogue: 0,0:19:14.44,0:19:15.48,Default,,0,0,0,,Артыңызда бірдеңе қалдырдыңыз ба?
Dialogue: 0,0:19:15.57,0:19:19.70,Default,,0,0,0,,Мен Роландтың жапон үлгісіндегі дәретханасына жуа алмаймын.
Dialogue: 0,0:19:19.78,0:19:21.36,Default,,0,0,0,,Біз жай ғана баламыз.
Dialogue: 0,0:19:21.45,0:19:24.53,Default,,0,0,0,,Сен мұны күні бойы айтып жүрсің.
Dialogue: 0,0:19:24.62,0:19:26.03,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:19:26.12,0:19:27.74,Default,,0,0,0,,Шынымен бе? Оған екеуі неге керек болды?
Dialogue: 0,0:19:27.83,0:19:30.04,Default,,0,0,0,,Тізесі бар ғимарат бар.
Dialogue: 0,0:19:32.08,0:19:34.04,Default,,0,0,0,,«Паб П. Юинг»
Dialogue: 0,0:19:36.46,0:19:39.51,Default,,0,0,0,,Сізде тұрақты Стив бар ма?
Dialogue: 0,0:19:39.59,0:19:41.13,Default,,0,0,0,,Стив жоқ
Dialogue: 0,0:19:41.22,0:19:42.97,Default,,0,0,0,,Әй, бұл осылай.
Dialogue: 0,0:19:43.05,0:19:46.18,Default,,0,0,0,,Неге екені белгісіз, бәрі мені «пендежо» деп атайды (ақымақ)
Dialogue: 0,0:19:46.26,0:19:49.22,Default,,0,0,0,,Жаттықтырушы Ол бармен болды ма?
Dialogue: 0,0:19:49.60,0:19:51.69,Default,,0,0,0,,Сенің жай ғана көмекші болғаныңа қуаныштымын.
Dialogue: 0,0:19:51.77,0:19:54.94,Default,,0,0,0,,Менің жұмысым кеседен жұмыртқаның иісін шығару.
Dialogue: 0,0:19:55.02,0:19:56.40,Default,,0,0,0,,Мен өтірік айттым.
Dialogue: 0,0:19:56.48,0:19:57.65,Default,,0,0,0,,Экскурсия емес
Dialogue: 0,0:19:57.73,0:19:59.03,Default,,0,0,0,,Мен мектептен қалдым
Dialogue: 0,0:19:59.11,0:20:02.07,Default,,0,0,0,,Мені тонап кетті, үйге бара алмаймын.
Dialogue: 0,0:20:02.15,0:20:04.32,Default,,0,0,0,,Эй, күте тұр!
Dialogue: 0,0:20:04.41,0:20:07.16,Default,,0,0,0,,Менің көзіме қарап, өтірік айтасың ба?
Dialogue: 0,0:20:08.16,0:20:10.08,Default,,0,0,0,,Олар жақын достар сияқты.
Dialogue: 0,0:20:10.16,0:20:11.79,Default,,0,0,0,,Маған көмектесе аласыз ба?
Dialogue: 0,0:20:11.87,0:20:12.41,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:20:12.50,0:20:14.67,Default,,0,0,0,,Сіз нұсқаушыға келдіңіз бе...
Dialogue: 0,0:20:14.75,0:20:15.83,Default,,0,0,0,,«Көшбасшы»?
Dialogue: 0,0:20:15.92,0:20:19.92,Default,,0,0,0,,Сіз көмек сұрадыңыз, бірақ бас тартуға болады деп ойлайсыз ба?
Dialogue: 0,0:20:20.01,0:20:25.47,Default,,0,0,0,,Патрик, бізге екі ерекше тауық еті сатып алыңыз.
Dialogue: 0,0:20:25.59,0:20:29.85,Default,,0,0,0,,Сіз қызметкер емессіз. Мен полицияға телефон соғамын.
Dialogue: 0,0:20:29.93,0:20:31.18,Default,,0,0,0,,Сыртқа шығайық
Dialogue: 0,0:20:31.27,0:20:34.06,Default,,0,0,0,,Жұмыртқаны кесеге құюға болмайды
Dialogue: 0,0:20:34.14,0:20:37.23,Default,,0,0,0,,Жарайды, мен саған ертең жұмыртқа әкелемін.
Dialogue: 0,0:20:37.31,0:20:38.36,Default,,0,0,0,,Қандай жігіт
Dialogue: 0,0:20:38.44,0:20:39.90,Default,,0,0,0,,О, Құдай!
Dialogue: 0,0:20:40.73,0:20:42.90,Default,,0,0,0,,Тыныс алып, бар күшіңізді салыңыз
Dialogue: 0,0:20:42.99,0:20:43.95,Default,,0,0,0,,Бұл мүмкін емес!
Dialogue: 0,0:20:44.03,0:20:46.78,Default,,0,0,0,,Жарайды. Бірге жұмыс жасайық.
Dialogue: 0,0:20:46.87,0:20:47.41,Default,,0,0,0,,Бірге?
Dialogue: 0,0:20:47.49,0:20:49.45,Default,,0,0,0,,Біз әрқашан біргеміз
Dialogue: 0,0:20:50.58,0:20:52.66,Default,,0,0,0,,Сәби дүниеге келді. Сіз тегті көре аласыз.
Dialogue: 0,0:20:53.08,0:20:54.21,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:20:54.29,0:20:57.38,Default,,0,0,0,,Қандай сүйкімді
Dialogue: 0,0:20:57.75,0:20:59.67,Default,,0,0,0,,Дәл сіз сияқты
Dialogue: 0,0:21:00.38,0:21:01.21,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:21:01.30,0:21:03.34,Default,,0,0,0,,Өз ағаңызға ұқсайсыз.
Dialogue: 0,0:21:03.42,0:21:04.97,Default,,0,0,0,,Куртқа ұқсамайды.
Dialogue: 0,0:21:05.05,0:21:05.88,Default,,0,0,0,,Неліктен арба?
Dialogue: 0,0:21:06.80,0:21:07.34,Default,,0,0,0,,Тек...
Dialogue: 0,0:21:07.43,0:21:10.97,Default,,0,0,0,,Өтірік әйел! Сіз ағаңызбен жыныстық қатынаста болдыңыз ба?
Dialogue: 0,0:21:11.06,0:21:13.48,Default,,0,0,0,,Бұл ашық қарым-қатынас болуы керек.
Dialogue: 0,0:21:13.56,0:21:14.89,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:21:14.98,0:21:17.73,Default,,0,0,0,,Ашық қарым-қатынас жасайық
Dialogue: 0,0:21:17.81,0:21:20.77,Default,,0,0,0,,Сіз кез келген адаммен, тіпті ағаңызбен жыныстық қатынасқа түсе аласыз.
Dialogue: 0,0:21:20.86,0:21:24.49,Default,,0,0,0,,Мен оңай түсінбейтін нәрсені айтқан шығармын.
Dialogue: 0,0:21:24.57,0:21:28.82,Default,,0,0,0,,Менің Куртпен қарым-қатынасым тек секс туралы.
Dialogue: 0,0:21:28.91,0:21:31.95,Default,,0,0,0,,Бірақ сізбен бұл сиқыр сияқты
Dialogue: 0,0:21:32.08,0:21:36.25,Default,,0,0,0,,Сіз бақытты емессіз бе? Мен сені өте қатты жақсы көремін.
Dialogue: 0,0:21:36.33,0:21:38.29,Default,,0,0,0,,Кез келгеннің баласын өсіремін
Dialogue: 0,0:21:38.38,0:21:40.84,Default,,0,0,0,,Сіз ең жақсысыз
Dialogue: 0,0:21:41.00,0:21:44.72,Default,,0,0,0,,Сыныптағы ең мейірімді және мейірімді дос.
Dialogue: 0,0:21:44.88,0:21:45.47,Default,,0,0,0,,Келіңіз
Dialogue: 0,0:21:45.55,0:21:46.09,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:21:46.17,0:21:48.05,Default,,0,0,0,,Скорпионның алдында?
Dialogue: 0,0:21:48.14,0:21:49.93,Default,,0,0,0,,Скорпион? Бұл жақсы есім
Dialogue: 0,0:21:50.01,0:21:51.89,Default,,0,0,0,,О, мен сені сүйемін
Dialogue: 0,0:21:51.97,0:21:52.64,Default,,0,0,0,,Мен де
Dialogue: 0,0:21:53.68,0:21:56.10,Default,,0,0,0,,Әй, мейірімді бол.
Dialogue: 0,0:21:56.31,0:21:59.19,Default,,0,0,0,,Ауырды, бірақ мен оны қатты қалаймын.
Dialogue: 0,0:21:59.48,0:22:02.69,Default,,0,0,0,,Жарайды, мен 41 жастамын!
Dialogue: 0,0:22:02.77,0:22:04.61,Default,,0,0,0,,Бүгін менің туған күнім!
Dialogue: 0,0:22:06.11,0:22:09.11,Default,,0,0,0,,Дегенмен, бұл керемет шытырман оқиға болды.
Dialogue: 0,0:22:09.20,0:22:13.45,Default,,0,0,0,,«Дауылдағы шабандоздарды» еске түсіру
Dialogue: 0,0:22:13.54,0:22:14.91,Default,,0,0,0,,Сізге телефон соғуға болады ма?
Dialogue: 0,0:22:15.00,0:22:16.58,Default,,0,0,0,,Жаттықтырыңыз
Dialogue: 0,0:22:16.87,0:22:18.54,Default,,0,0,0,,Құлаққаптар?
Dialogue: 0,0:22:18.62,0:22:21.00,Default,,0,0,0,,Бұл өте қорқынышты күн болды.
Dialogue: 0,0:22:21.13,0:22:22.79,Default,,0,0,0,,Мен көлікке мінгеніме қуаныштымын...
Dialogue: 0,0:22:22.88,0:22:23.88,Default,,0,0,0,,Дауыл…
Dialogue: 0,0:22:23.96,0:22:26.97,Default,,0,0,0,,Теорияда, бұл машинаны қоспағанда.
Dialogue: 0,0:22:27.05,0:22:28.18,Default,,0,0,0,,Сіз оны орындадыңыз ба?
Dialogue: 0,0:22:28.26,0:22:29.89,Default,,0,0,0,,Дағдарыстың алдын алды
Dialogue: 0,0:22:29.97,0:22:30.68,Default,,0,0,0,,дүниеге келген
Dialogue: 0,0:22:30.76,0:22:32.89,Default,,0,0,0,,Шляпа Бұл ұят болды.
Dialogue: 0,0:22:33.01,0:22:33.56,Default,,0,0,0,,Иә
Dialogue: 0,0:22:33.64,0:22:36.22,Default,,0,0,0,,Ұялшақ болғаным үшін кешіріңіз.
Dialogue: 0,0:22:36.31,0:22:38.69,Default,,0,0,0,,Мен әрқашан өзімнен ұяламын
Dialogue: 0,0:22:38.77,0:22:41.06,Default,,0,0,0,,Манзаректің орындауы керемет
Dialogue: 0,0:22:41.15,0:22:44.69,Default,,0,0,0,,Қала балаларынан жақсысың
Dialogue: 0,0:22:44.78,0:22:47.44,Default,,0,0,0,,Ник, бұл дұрыс емес.
Dialogue: 0,0:22:47.53,0:22:50.57,Default,,0,0,0,,Дұрыс, бірақ мен сені жұбатқым келеді.
Dialogue: 0,0:22:50.66,0:22:55.41,Default,,0,0,0,,Сен Джессиге ана туралы айтуың керек.
Dialogue: 0,0:22:55.49,0:22:58.37,Default,,0,0,0,,Иә, бірақ бұл үлкен мәселе болады.
Dialogue: 0,0:22:58.83,0:23:00.71,Default,,0,0,0,,Жаңбыр тоқтады
Dialogue: 0,0:23:00.79,0:23:03.59,Default,,0,0,0,,Бұл өте таңғажайып дауыл болды.
Dialogue: 0,0:23:03.67,0:23:08.05,Default,,0,0,0,,Менің көңілім қалды. Менің де өз басымнан көңілім қалды.
Dialogue: 0,0:23:08.13,0:23:13.26,Default,,0,0,0,,Енді мен ойымды өзгертіп, сізге несие картамды беремін.
Dialogue: 0,0:23:13.43,0:23:15.60,Default,,0,0,0,,Егер адасып қалсаңыз, оны пайдаланыңыз.
Dialogue: 0,0:23:16.89,0:23:18.64,Default,,0,0,0,,Бұл жаза ма?
Dialogue: 0,0:23:18.73,0:23:19.68,Default,,0,0,0,,Иә
Dialogue: 0,0:23:19.77,0:23:24.23,Default,,0,0,0,,Жаза ретінде Netflix-тен 6 аптаға тыйым салынды
Dialogue: 0,0:23:24.31,0:23:25.27,Default,,0,0,0,,Алты апта?
Dialogue: 0,0:23:25.36,0:23:27.57,Default,,0,0,0,,Маған осыдан үзіліс беріңіз.
Dialogue: 0,0:23:27.86,0:23:31.03,Default,,0,0,0,,Егер сіз оны көрмесеңіз, бұл тас қараңғы.
Dialogue: 0,0:23:31.11,0:23:32.57,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:23:32.66,0:23:38.16,Default,,0,0,0,,Бір израильдік мені дүкеннен фотоаппарат сатып алуға мәжбүрлеген болуы мүмкін.
Dialogue: 0,0:23:38.25,0:23:41.50,Default,,0,0,0,,Ал П.Юингтің дүкені?
Dialogue: 0,0:23:41.58,0:23:44.88,Default,,0,0,0,,Менің жасағаным өшіп қалды.
Dialogue: 0,0:23:44.96,0:23:49.21,Default,,0,0,0,,Мен К.Вандевегенің дүкеніне баруым керек еді.
Dialogue: 0,0:23:49.67,0:23:50.22,Default,,0,0,0,,Пам
Dialogue: 0,0:23:50.30,0:23:53.39,Default,,0,0,0,,Маған минет жасататын болсаң, мен сенің жамбасын жуамын.
Dialogue: 0,0:23:53.80,0:23:54.64,Default,,0,0,0,,Пам?
Dialogue: 0,0:23:55.18,0:23:55.97,Default,,0,0,0,,Қайда?
Dialogue: 0,0:23:56.64,0:23:57.39,Default,,0,0,0,,«Джейге»
Dialogue: 0,0:23:58.39,0:24:02.19,Default,,0,0,0,,Сен хатты оқығанша мен мұнда болмаймын.
Dialogue: 0,0:24:02.27,0:24:02.81,Default,,0,0,0,,Не?
Dialogue: 0,0:24:02.89,0:24:04.94,Default,,0,0,0,,Скорпион да менімен бірге.
Dialogue: 0,0:24:05.02,0:24:07.40,Default,,0,0,0,,Бұл сіздің балаңыз емес.
Dialogue: 0,0:24:07.48,0:24:08.90,Default,,0,0,0,,Зұлым әйел
Dialogue: 0,0:24:08.98,0:24:11.74,Default,,0,0,0,,Сіз оны «жаман әйел» деп атайтыныңызға сенімдімін, солай ма?
Dialogue: 0,0:24:11.82,0:24:15.66,Default,,0,0,0,,Сен сияқты, енді тыңдай алмаймын
Dialogue: 0,0:24:15.74,0:24:20.91,Default,,0,0,0,,Бірақ одан да көп, мен үлкен денелер мен бұлшықеттерді сағындым.
Dialogue: 0,0:24:21.00,0:24:23.46,Default,,0,0,0,,Кемел адам, ал бай?
Dialogue: 0,0:24:23.54,0:24:25.92,Default,,0,0,0,,Мен сенімен айырылысқаныма сене алмаймын, «патша»
Dialogue: 0,0:24:26.00,0:24:28.00,Default,,0,0,0,,Бірақ мен кетуім керек
Dialogue: 0,0:24:28.25,0:24:30.84,Default,,0,0,0,,Қош бол Джей, мен сені жақсы көремін.
Dialogue: 0,0:24:32.84,0:24:35.30,Default,,0,0,0,,Қуаныштымын, қуаныштымын, танысқаныма қуаныштымын
Dialogue: 0,0:24:36.60,0:24:37.14,Default,,0,0,0,,Сәлем
Dialogue: 0,0:24:37.22,0:24:40.72,Default,,0,0,0,,Табанды жаю үшін резеңке киіңіз.
Dialogue: 0,0:24:40.81,0:24:43.23,Default,,0,0,0,,Сіз бұл туралы ойлайсыз ба?
Dialogue: 0,0:24:44.10,0:24:45.77,Default,,0,0,0,,Ол дымқыл
Dialogue: 0,0:24:45.85,0:24:47.02,Default,,0,0,0,,«Жаның тыныш, директордың орынбасары Вирт».
Dialogue: 0,0:24:47.48,0:24:48.44,Default,,0,0,0,,Олардың екеуі
Dialogue: 0,0:24:48.52,0:24:50.07,Default,,0,0,0,,Ол келе жатыр
Dialogue: 0,0:24:50.15,0:24:50.69,Default,,0,0,0,,Айталық
Dialogue: 0,0:24:50.78,0:24:52.82,Default,,0,0,0,,Менің анамның қарым-қатынасы бар.
Dialogue: 0,0:24:52.90,0:24:54.32,Default,,0,0,0,,Екінші адам лесбиянка
Dialogue: 0,0:24:54.40,0:24:55.66,Default,,0,0,0,,Менің әкем емес
Dialogue: 0,0:24:55.74,0:24:56.28,Default,,0,0,0,,Жарайды
Dialogue: 0,0:24:56.36,0:24:58.66,Default,,0,0,0,,Нью-Йорктегі шытырман оқиғаңыз қалай өтті?
Dialogue: 0,0:24:58.74,0:25:00.33,Default,,0,0,0,,Тіпті әдеттен тыс нәрсе бар ма?
Dialogue: 0,0:25:01.95,0:25:03.54,Default,,0,0,0,,Өзіңіз айтасыз ба?
Dialogue: 0,0:25:03.62,0:25:07.63,Default,,0,0,0,,Сіз жақсырақ түсіндіресіз, солай емес пе?
Dialogue: 0,0:25:07.71,0:25:10.71,Default,,0,0,0,,Жарайды, шын мәнінде Джесси...
Dialogue: 0,0:25:10.80,0:25:11.34,Default,,0,0,0,,Не?
Dialogue: 0,0:25:12.05,0:25:13.09,Default,,0,0,0,,Джесси…
Dialogue: 0,0:25:13.17,0:25:14.42,Default,,0,0,0,,Не болды?
Dialogue: 0,0:25:14.51,0:25:15.05,Default,,0,0,0,,Мегуми Фушигуро.
Dialogue: 0,0:25:15.13,0:25:15.68,Default,,0,0,0,,Ара...
Dialogue: 0,0:25:15.76,0:25:19.43,Default,,0,0,0,,Кейбір адамдар дельфин-пудель будандарын ұстайды.
Dialogue: 0,0:25:19.51,0:25:20.10,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:25:20.18,0:25:20.85,Default,,0,0,0,,Дорфудор
Dialogue: 0,0:25:20.93,0:25:21.89,Default,,0,0,0,,Менің атым Кевин
Dialogue: 0,0:25:21.97,0:25:23.31,Default,,0,0,0,,Саусақтарыңызды жеңіз
Dialogue: 0,0:25:23.39,0:25:25.10,Default,,0,0,0,,Мен бұл жас жүгері деп ойладым.
Dialogue: 0,0:25:25.19,0:25:27.85,Default,,0,0,0,,Бұл қорқынышты. Мен бармағаныма қуаныштымын.
Dialogue: 0,0:25:27.94,0:25:29.81,Default,,0,0,0,,(Фушигиро) Неге мұнда жүрсің, Зэн'ин-сенпай?
Dialogue: 0,0:25:29.90,0:25:33.53,Default,,0,0,0,,Біз сенің де көргіміз келмейтін нәрсені көрдік.
Dialogue: 0,0:25:33.61,0:25:35.70,Default,,0,0,0,,Олай болса, 〈Қош бол〉
Dialogue: 0,0:25:36.66,0:25:38.07,Default,,0,0,0,,Оған айта аласыз ба?
Dialogue: 0,0:25:38.16,0:25:39.24,Default,,0,0,0,,Сәтсіз қалдыңыз.
Dialogue: 0,0:25:39.32,0:25:41.28,Default,,0,0,0,,Мен оны айта алмадым
Dialogue: 0,0:25:41.79,0:25:43.12,Default,,0,0,0,,Қый!
Dialogue: 0,0:25:43.20,0:25:45.58,Default,,0,0,0,,Дикіңізде не болды?
Dialogue: 0,0:25:45.96,0:25:48.50,Default,,0,0,0,,Жанып тұр. Неге екенін білгіңіз келе ме?
Dialogue: 0,0:25:48.58,0:25:49.13,Default,,0,0,0,,Мүлдем емес
Dialogue: 0,0:25:49.21,0:25:50.13,Default,,0,0,0,,Кілемшенің үстінде сиқыру
Dialogue: 0,0:25:50.21,0:25:50.75,Default,,0,0,0,,Өтірік
Dialogue: 0,0:26:39.88,0:26:41.89,Default,,0,0,0,,Жапон субтитрлері Нагиса Исозаки
Dialogue: 0,0:26:43.39,0:26:49.39,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
