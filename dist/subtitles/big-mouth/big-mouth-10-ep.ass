Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.00,0:00:07.25,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:07.25,0:00:08.17,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:07.25,0:00:08.17,Default,,0,0,0,,Не істеуім керек?
Dialogue: 0,0:00:08.17,0:00:08.75,Default,,0,0,0,,Не істеуім керек?
Dialogue: 0,0:00:08.75,0:00:09.25,Default,,0,0,0,,Не істеуім керек?
Dialogue: 0,0:00:08.75,0:00:09.25,Default,,0,0,0,,«Джейн Фонда стиліндегі жаттығу»
Dialogue: 0,0:00:09.25,0:00:09.34,Default,,0,0,0,,«Джейн Фонда стиліндегі жаттығу»
Dialogue: 0,0:00:09.34,0:00:10.67,Default,,0,0,0,,«Джейн Фонда стиліндегі жаттығу»
Dialogue: 0,0:00:09.34,0:00:10.67,Default,,0,0,0,,Мүмкін бұл...
Dialogue: 0,0:00:10.67,0:00:12.05,Default,,0,0,0,,«Джейн Фонда стиліндегі жаттығу»
Dialogue: 0,0:00:12.05,0:00:12.59,Default,,0,0,0,,«Джейн Фонда стиліндегі жаттығу»
Dialogue: 0,0:00:12.05,0:00:12.59,Default,,0,0,0,,Қазіргі жасыңда мәңгі қалу—
Dialogue: 0,0:00:12.59,0:00:13.43,Default,,0,0,0,,Қазіргі жасыңда мәңгі қалу—
Dialogue: 0,0:00:13.51,0:00:14.97,Default,,0,0,0,,Бұл менің бірінші рет порно көруім.
Dialogue: 0,0:00:14.97,0:00:15.84,Default,,0,0,0,,«Итальяндық айғыр» порносын алғаш рет көру
Dialogue: 0,0:00:15.84,0:00:16.43,Default,,0,0,0,,«Итальяндық айғыр»
Dialogue: 0,0:00:16.64,0:00:18.01,Default,,0,0,0,,Мисси
Dialogue: 0,0:00:18.10,0:00:21.60,Default,,0,0,0,,Мен енді ешкімді сүйе алмаймын, мені енді ешкім сүймейді
Dialogue: 0,0:00:22.23,0:00:25.40,Default,,0,0,0,,Эндрю Шатаспаңыз.
Dialogue: 0,0:00:25.48,0:00:26.86,Default,,0,0,0,,Мен жыламаймын
Dialogue: 0,0:00:27.36,0:00:30.73,Default,,0,0,0,,Мен өлсем, өкініп, қайта кездесе бастауым мүмкін.
Dialogue: 0,0:00:30.82,0:00:31.48,Default,,0,0,0,,Әкем білсе, бұл сөзсіз L-ге жетеді.
Dialogue: 0,0:00:31.57,0:00:34.82,Default,,0,0,0,,Сильвестр Сталлоне порносын көру
Dialogue: 0,0:00:34.90,0:00:36.28,Default,,0,0,0,,«Итальяндық айғыр»
Dialogue: 0,0:00:36.36,0:00:39.33,Default,,0,0,0,,Жас ғашықтар мотельде жыныстық қатынасқа түседі
Dialogue: 0,0:00:39.41,0:00:40.58,Default,,0,0,0,,Жас ғашықтар?
Dialogue: 0,0:00:40.66,0:00:43.50,Default,,0,0,0,,Мисси, неге бізді тастап кеттің?
Dialogue: 0,0:00:43.58,0:00:44.79,Default,,0,0,0,,Чикусо!
Dialogue: 0,0:00:44.91,0:00:46.50,Default,,0,0,0,,Ой, бұл тесік.
Dialogue: 0,0:00:47.08,0:00:50.17,Default,,0,0,0,,Бұл бел биіктігінде тамаша. Бұны ұнатамын.
Dialogue: 0,0:00:50.75,0:00:54.30,Default,,0,0,0,,Ойнату түймесін басыңыз, сонда сіздің өміріңіз өзгереді.
Dialogue: 0,0:00:54.38,0:00:56.89,Default,,0,0,0,,Бәрі маңызды емес
Dialogue: 0,0:00:56.97,0:01:00.01,Default,,0,0,0,,Қараңызшы, бұл менің күйеуім Кэндис.
Dialogue: 0,0:01:00.10,0:01:01.72,Default,,0,0,0,,Ол мінсіз
Dialogue: 0,0:01:01.81,0:01:04.64,Default,,0,0,0,,Жарақат алу қаупі бар.
Dialogue: 0,0:01:07.27,0:01:09.90,Default,,0,0,0,,Китти Айғырға мінгің келе ме?
Dialogue: 0,0:01:09.98,0:01:12.48,Default,,0,0,0,,Маған резеңкесіз ұнайды.
Dialogue: 0,0:01:12.57,0:01:13.65,Default,,0,0,0,,Бұл ең жақсысы
Dialogue: 0,0:01:15.28,0:01:16.20,Default,,0,0,0,,Біз жарты жолды өтіп қойдық — бізді тежеме, жарай ма?
Dialogue: 0,0:01:16.28,0:01:18.24,Default,,0,0,0,,Сіз ең жақсысыз
Dialogue: 0,0:01:18.32,0:01:19.07,Default,,0,0,0,,Ең жақсысы?
Dialogue: 0,0:01:19.16,0:01:19.99,Default,,0,0,0,,О
Dialogue: 0,0:01:20.08,0:01:22.04,Default,,0,0,0,,Китти, менің сенен бір жақсылығым бар.
Dialogue: 0,0:01:22.37,0:01:24.62,Default,,0,0,0,,Жыныс мүшесін қысыңыз және шарларыңызды ұстаңыз.
Dialogue: 0,0:01:27.12,0:01:29.33,Default,,0,0,0,,Адриан!
Dialogue: 0,0:02:02.91,0:02:05.33,Default,,0,0,0,,Бүгінгі сынып күресі
Dialogue: 0,0:02:05.41,0:02:07.46,Default,,0,0,0,,Олай емес сияқты.
Dialogue: 0,0:02:07.54,0:02:10.04,Default,,0,0,0,,Полиция бөлімшесін аралау.
Dialogue: 0,0:02:10.13,0:02:12.13,Default,,0,0,0,,Мэтью Сіз өтірік айттыңыз ба?
Dialogue: 0,0:02:12.21,0:02:15.92,Default,,0,0,0,,Мен автобуста бас киіммен 20 минут болдым...
Dialogue: 0,0:02:16.01,0:02:17.34,Default,,0,0,0,,Байқалмаған
Dialogue: 0,0:02:17.42,0:02:19.84,Default,,0,0,0,,Шарлар бір жаққа жылжымайды
Dialogue: 0,0:02:19.93,0:02:21.59,Default,,0,0,0,,Егер сіз оны солға және оңға таратпасаңыз
Dialogue: 0,0:02:21.68,0:02:24.56,Default,,0,0,0,,Бриджтон полиция бөлімшесіне қош келдіңіз
Dialogue: 0,0:02:24.64,0:02:25.68,Default,,0,0,0,,Сұрағыңыз бар ма?
Dialogue: 0,0:02:25.77,0:02:28.52,Default,,0,0,0,,Мен қолымды көтеріп жатырмын, себебі бұл полиция бөлімшесі.
Dialogue: 0,0:02:28.60,0:02:29.94,Default,,0,0,0,,Мен оны көтеруім керек.
Dialogue: 0,0:02:30.02,0:02:31.02,Default,,0,0,0,,Бұл жақсы ой.
Dialogue: 0,0:02:31.44,0:02:33.77,Default,,0,0,0,,Мынаны қарашы, бұл менің алғашқы безеуім.
Dialogue: 0,0:02:33.86,0:02:36.65,Default,,0,0,0,,«Айғыр» шабыттандырды ма?
Dialogue: 0,0:02:36.73,0:02:38.15,Default,,0,0,0,,Ер адам ретінде
Dialogue: 0,0:02:38.24,0:02:39.95,Default,,0,0,0,,Бұл безеу ме?
Dialogue: 0,0:02:40.03,0:02:43.03,Default,,0,0,0,,Мен оны есігіме алған кезде-
Dialogue: 0,0:02:43.12,0:02:45.24,Default,,0,0,0,,Мен контрацепция таблеткасын қолдандым.
Dialogue: 0,0:02:45.83,0:02:47.04,Default,,0,0,0,,Жоғары бес?
Dialogue: 0,0:02:47.12,0:02:47.83,Default,,0,0,0,,Бля саған
Dialogue: 0,0:02:47.91,0:02:49.91,Default,,0,0,0,,«Беттік бөлме»
Dialogue: 0,0:02:47.91,0:02:49.91,Default,,0,0,0,,Бұл күдіктілерден сұралатын бөлме.
Dialogue: 0,0:02:49.91,0:02:51.67,Default,,0,0,0,,Бұл күдіктілерден сұралатын бөлме.
Dialogue: 0,0:02:51.75,0:02:53.54,Default,,0,0,0,,Сиқырлы айнасы бар ма?
Dialogue: 0,0:02:53.63,0:02:56.05,Default,,0,0,0,,Біз бір-бірімізді көреміз
Dialogue: 0,0:02:56.13,0:02:58.63,Default,,0,0,0,,Мынау терезе, мына орангутан.
Dialogue: 0,0:02:58.72,0:03:00.22,Default,,0,0,0,,Бұл өткір цуккоми.
Dialogue: 0,0:03:01.63,0:03:02.80,Default,,0,0,0,,Эндрю
Dialogue: 0,0:03:02.89,0:03:04.26,Default,,0,0,0,,Сәлем Мисси
Dialogue: 0,0:03:04.35,0:03:06.43,Default,,0,0,0,,Барлығы бір жаққа бұрылды.
Dialogue: 0,0:03:06.51,0:03:10.06,Default,,0,0,0,,Біз дос бола аламыз ба?
Dialogue: 0,0:03:10.14,0:03:13.35,Default,,0,0,0,,Біз дос бола алмаймыз.
Dialogue: 0,0:03:13.44,0:03:15.44,Default,,0,0,0,,Мені жақсы көрмейсің бе?
Dialogue: 0,0:03:15.52,0:03:18.61,Default,,0,0,0,,Бір күні үйлену тойыңа мені шақырады...
Dialogue: 0,0:03:18.69,0:03:21.49,Default,,0,0,0,,Менің Джоэлге тұрмысқа шыққанымды көргің келе ме?
Dialogue: 0,0:03:21.57,0:03:23.24,Default,,0,0,0,,Оның несі сізге ұнайды?
Dialogue: 0,0:03:23.32,0:03:25.49,Default,,0,0,0,,Ол сәулетші, ол жақсы жігіт.
Dialogue: 0,0:03:25.58,0:03:27.54,Default,,0,0,0,,Сізге жақсы, Мисси.
Dialogue: 0,0:03:28.08,0:03:31.41,Default,,0,0,0,,Кешіріңіз, тағы бір мәйіт табылды.
Dialogue: 0,0:03:31.50,0:03:33.46,Default,,0,0,0,,Құйрықты өлтіруші
Dialogue: 0,0:03:33.67,0:03:35.42,Default,,0,0,0,,Сіздің лақап атыңыз басқа.
Dialogue: 0,0:03:35.50,0:03:38.34,Default,,0,0,0,,Құйрық сутенер, солай ма?
Dialogue: 0,0:03:38.42,0:03:40.01,Default,,0,0,0,,Сутенер? Ол кісі өлтіруші.
Dialogue: 0,0:03:40.09,0:03:41.47,Default,,0,0,0,,Маған қатты дыбыс ұнайды
Dialogue: 0,0:03:41.55,0:03:44.18,Default,,0,0,0,,Құйрықты адам ше?
Dialogue: 0,0:03:44.26,0:03:46.10,Default,,0,0,0,,Бұл лақап ат емес.
Dialogue: 0,0:03:46.18,0:03:48.22,Default,,0,0,0,,Тоқта, адамдар өліп жатыр.
Dialogue: 0,0:03:48.31,0:03:51.10,Default,,0,0,0,,Керемет лақап ат ойлап табыңыз
Dialogue: 0,0:03:51.18,0:03:55.19,Default,,0,0,0,,Бұл ДНҚ сынақтары жүргізілетін ғылыми талдау бөлмесі.
Dialogue: 0,0:03:55.27,0:03:56.61,Default,,0,0,0,,Кім сынақтан өткісі келеді?
Dialogue: 0,0:03:56.69,0:03:59.44,Default,,0,0,0,,Сіз сол бос көздеріңізбен біргесіз бе?
Dialogue: 0,0:03:59.53,0:04:02.36,Default,,0,0,0,,Менің бүкіл денем бос, сондықтан мен сәтсіздікке ұшырауым мүмкін.
Dialogue: 0,0:04:02.45,0:04:05.74,Default,,0,0,0,,ДНҚ – гей-ғалымның алдауы
Dialogue: 0,0:04:05.82,0:04:07.66,Default,,0,0,0,,Әкеңе еліктеуді доғар.
Dialogue: 0,0:04:07.74,0:04:09.33,Default,,0,0,0,,Жарайды, тоқтайық.
Dialogue: 0,0:04:09.74,0:04:10.54,Default,,0,0,0,,Тоқта
Dialogue: 0,0:04:14.04,0:04:16.83,Default,,0,0,0,,Менің еріндерім жабысып қалды
Dialogue: 0,0:04:16.92,0:04:18.46,Default,,0,0,0,,Сөйлеме
Dialogue: 0,0:04:19.50,0:04:20.92,Default,,0,0,0,,«Ат құйрығы Нантока»
Dialogue: 0,0:04:21.01,0:04:24.51,Default,,0,0,0,,Әкемнің бейіті Үй жануарлары зиратында.
Dialogue: 0,0:04:25.47,0:04:29.68,Default,,0,0,0,,Кэрол мені әйелдер жаттығу залынан қуып жіберді.
Dialogue: 0,0:04:29.85,0:04:32.77,Default,,0,0,0,,Ат құйрығымен жақсы көрінетін автобус жүргізушісі.
Dialogue: 0,0:04:32.85,0:04:34.52,Default,,0,0,0,,Қандай кездейсоқтық!
Dialogue: 0,0:04:34.60,0:04:37.65,Default,,0,0,0,,Мен сізден не сұрағым келеді
Dialogue: 0,0:04:37.73,0:04:39.82,Default,,0,0,0,,Бұл заңды шектеу ме?
Dialogue: 0,0:04:39.90,0:04:42.32,Default,,0,0,0,,Спойлер туралы ескерту: Мен кінәлімін
Dialogue: 0,0:04:42.40,0:04:44.57,Default,,0,0,0,,Түстен кейін Фудзисаваға қайтасың да, мектепке барасың, иә?
Dialogue: 0,0:04:46.11,0:04:46.99,Default,,0,0,0,,Жоқ, өмірден бас тартпа
Dialogue: 0,0:04:47.07,0:04:50.70,Default,,0,0,0,,Мен наразы емеспін, бірақ сен мені неге сүйесің?
Dialogue: 0,0:04:50.79,0:04:53.20,Default,,0,0,0,,Ажырасқан ата-ананың реакциясы
Dialogue: 0,0:04:53.29,0:04:54.12,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:54.21,0:04:57.50,Default,,0,0,0,,Бірақ мен жүрек байланысын қалаймын
Dialogue: 0,0:04:57.88,0:05:00.50,Default,,0,0,0,,Ата-анамның маған тиіспеу саясаты бар.
Dialogue: 0,0:05:00.59,0:05:03.34,Default,,0,0,0,,Адамдармен қарым-қатынас жоқ.
Dialogue: 0,0:05:03.42,0:05:04.92,Default,,0,0,0,,Бұл әрекет болмаса
Dialogue: 0,0:05:05.01,0:05:07.26,Default,,0,0,0,,Мысалы, көпшілік алдында құлау.
Dialogue: 0,0:05:07.34,0:05:07.89,Default,,0,0,0,,Не?
Dialogue: 0,0:05:07.97,0:05:10.60,Default,,0,0,0,,Мен жүректердің алмасуын қалаймын
Dialogue: 0,0:05:10.68,0:05:11.97,Default,,0,0,0,,Гей сияқты ма?
Dialogue: 0,0:05:12.39,0:05:14.48,Default,,0,0,0,,Маған аздап тамақ бер
Dialogue: 0,0:05:14.56,0:05:18.19,Default,,0,0,0,,Баланың сені сүйеді
Dialogue: 0,0:05:18.27,0:05:20.32,Default,,0,0,0,,Түсіндім, бір күн.
Dialogue: 0,0:05:20.40,0:05:21.61,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:21.69,0:05:23.90,Default,,0,0,0,,Қараңыз, бұлай етпеңіз.
Dialogue: 0,0:05:25.99,0:05:28.36,Default,,0,0,0,,Мына сүйкімді саусақтарға қараңдаршы
Dialogue: 0,0:05:28.45,0:05:30.53,Default,,0,0,0,,Мен сенің жаныңда бола алмаймын
Dialogue: 0,0:05:30.62,0:05:32.45,Default,,0,0,0,,Қалай емделуге болады?
Dialogue: 0,0:05:32.54,0:05:34.91,Default,,0,0,0,,Үйде тағы да порно көру
Dialogue: 0,0:05:35.00,0:05:38.00,Default,,0,0,0,,Шәкірт ақыры көшбасшы болды.
Dialogue: 0,0:05:38.08,0:05:39.54,Default,,0,0,0,,Порнографиялық болуы мүмкін
Dialogue: 0,0:05:39.63,0:05:40.50,Default,,0,0,0,,Эндрю
Dialogue: 0,0:05:40.59,0:05:43.21,Default,,0,0,0,,Сіздің досыңыз жасөспірім...
Dialogue: 0,0:05:43.30,0:05:44.46,Default,,0,0,0,,Гормон-кун?
Dialogue: 0,0:05:45.01,0:05:47.72,Default,,0,0,0,,Менің де безеуім бар, сөйлескім келеді.
Dialogue: 0,0:05:47.80,0:05:48.97,Default,,0,0,0,,Мен сөйлескім келеді
Dialogue: 0,0:05:49.80,0:05:52.85,Default,,0,0,0,,Неліктен жасөспірім кезіңізде жүгіруді шештіңіз?
Dialogue: 0,0:05:52.93,0:05:55.60,Default,,0,0,0,,Мен 13 жаста едім, тіпті сүйіспеншілікті де бастан өткердім.
Dialogue: 0,0:05:55.68,0:05:58.94,Default,,0,0,0,,Бұл жерде безеу жанартауы да пайда болды.
Dialogue: 0,0:05:59.02,0:05:59.98,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,0:06:00.06,0:06:03.44,Default,,0,0,0,,«Итальяндық айғырды» көргенде...
Dialogue: 0,0:06:03.52,0:06:04.61,Default,,0,0,0,,Оргазм туралы не деуге болады?
Dialogue: 0,0:06:04.69,0:06:06.28,Default,,0,0,0,,Мен де сезіндім
Dialogue: 0,0:06:06.36,0:06:07.82,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:06:08.20,0:06:10.82,Default,,0,0,0,,Шырын қаптамасы жарылған сияқты.
Dialogue: 0,0:06:10.91,0:06:13.37,Default,,0,0,0,,Түсіндім, сұхбат осында аяқталды.
Dialogue: 0,0:06:13.45,0:06:15.45,Default,,0,0,0,,2 жылдан кейін қайта бастаңыз
Dialogue: 0,0:06:15.54,0:06:17.87,Default,,0,0,0,,Неліктен? Безеу туралы не деуге болады?
Dialogue: 0,0:06:17.96,0:06:19.29,Default,,0,0,0,,Бұл жақсы идея.
Dialogue: 0,0:06:20.42,0:06:23.04,Default,,0,0,0,,Бұл жарылу үлкенірек
Dialogue: 0,0:06:24.05,0:06:25.71,Default,,0,0,0,,Мен келіспеймін.
Dialogue: 0,0:06:25.80,0:06:29.09,Default,,0,0,0,,Пісте жеу дөрекі.
Dialogue: 0,0:06:29.18,0:06:31.68,Default,,0,0,0,,Бұл менің сүйікті тағамым, біртүрлі жігіт.
Dialogue: 0,0:06:31.76,0:06:32.64,Default,,0,0,0,,Мұнда
Dialogue: 0,0:06:32.72,0:06:34.26,Default,,0,0,0,,Сіз ойнауға келмейсіз бе?
Dialogue: 0,0:06:34.35,0:06:36.14,Default,,0,0,0,,Менің бір ісім бар.
Dialogue: 0,0:06:36.22,0:06:39.31,Default,,0,0,0,,Мен апамның тойына баруым керек.
Dialogue: 0,0:06:39.39,0:06:40.85,Default,,0,0,0,,Үйлену жұмыс күні?
Dialogue: 0,0:06:40.94,0:06:42.65,Default,,0,0,0,,Бағаға сараң болу
Dialogue: 0,0:06:42.73,0:06:43.86,Default,,0,0,0,,Ертең кездескенше
Dialogue: 0,0:06:43.94,0:06:44.69,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:06:44.77,0:06:46.48,Default,,0,0,0,,Бұл жақсы өтірік
Dialogue: 0,0:06:46.57,0:06:50.03,Default,,0,0,0,,Қатерлі ісікпен ұзақ күрескеннен кейін апам...
Dialogue: 0,0:06:50.11,0:06:52.91,Default,,0,0,0,,Менің өлгенімді білмей
Dialogue: 0,0:06:52.99,0:06:54.20,Default,,0,0,0,,Сен ақымақсың.
Dialogue: 0,0:06:57.08,0:06:58.20,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:06:58.29,0:07:01.62,Default,,0,0,0,,Миссиді ұмыту үшін порно көру
Dialogue: 0,0:07:01.71,0:07:02.88,Default,,0,0,0,,Дәл солай ма?
Dialogue: 0,0:07:02.96,0:07:04.63,Default,,0,0,0,,Сүйкімді картоп-чан
Dialogue: 0,0:07:04.71,0:07:07.26,Default,,0,0,0,,Порнография әлемі кең.
Dialogue: 0,0:07:07.34,0:07:09.01,Default,,0,0,0,,Эротика тарихы –
Dialogue: 0,0:07:09.09,0:07:12.43,Default,,0,0,0,,Палеолит дәуіріндегі қабырға суреттеріне жатады
Dialogue: 0,0:07:12.93,0:07:13.97,Default,,0,0,0,,Сіздің қауіпсіз сөзіңіз қандай?
Dialogue: 0,0:07:14.05,0:07:16.85,Default,,0,0,0,,Бұл ұят, бірақ "wooga booga"
Dialogue: 0,0:07:16.93,0:07:21.02,Default,,0,0,0,,Кама-сутра 3 ғасырда танымал болды
Dialogue: 0,0:07:21.77,0:07:24.90,Default,,0,0,0,,Менің аяғым аздап қалды.
Dialogue: 0,0:07:24.98,0:07:27.73,Default,,0,0,0,,Бұл жүзім бұтасы ма? Мен төңкеріліп отырмын
Dialogue: 0,0:07:28.11,0:07:29.19,Default,,0,0,0,,Зерттеуге құмар
Dialogue: 0,0:07:29.28,0:07:33.16,Default,,0,0,0,,Содан кейін бейне мастурбация дәуірі келді.
Dialogue: 0,0:07:33.24,0:07:36.33,Default,,0,0,0,,Сіз пиццаға тапсырыс бердіңіз бе? Мен оны жедім
Dialogue: 0,0:07:36.41,0:07:39.04,Default,,0,0,0,,Рон, сен тағы бәтуалауға келдің бе?
Dialogue: 0,0:07:39.12,0:07:40.20,Default,,0,0,0,,Бұл адам неге...
Dialogue: 0,0:07:40.29,0:07:41.87,Default,,0,0,0,,Бұл өте үлкен
Dialogue: 0,0:07:41.96,0:07:45.13,Default,,0,0,0,,Ақырында, порно аспан келді.
Dialogue: 0,0:07:45.21,0:07:46.46,Default,,0,0,0,,Бұл интернет.
Dialogue: 0,0:07:46.54,0:07:50.21,Default,,0,0,0,,Сіз қалағаныңызды кез келген уақытта ала аласыз.
Dialogue: 0,0:07:51.72,0:07:52.63,Default,,0,0,0,,Керемет
Dialogue: 0,0:07:52.72,0:07:55.30,Default,,0,0,0,,Бірақ 18 жастан жоғары деп жазылған.
Dialogue: 0,0:07:55.39,0:07:57.26,Default,,0,0,0,,Жарайды, Эндрю.
Dialogue: 0,0:07:57.35,0:07:59.72,Default,,0,0,0,,Себебі мен 75 миллион жастамын
Dialogue: 0,0:07:59.81,0:08:00.64,Default,,0,0,0,,«Ит стилі»
Dialogue: 0,0:08:04.02,0:08:05.65,Default,,0,0,0,,Мына қалпақ жақсы екен.
Dialogue: 0,0:08:05.73,0:08:06.69,Default,,0,0,0,,Мисси
Dialogue: 0,0:08:07.61,0:08:09.90,Default,,0,0,0,,Мен сенімен жалғыз қалғым келеді
Dialogue: 0,0:08:10.53,0:08:11.90,Default,,0,0,0,,Бөлісейік
Dialogue: 0,0:08:13.07,0:08:15.66,Default,,0,0,0,,Мен сені қалаймын, Эндрю.
Dialogue: 0,0:08:13.07,0:08:15.66,Default,,0,0,0,,«Ыстық камералар»
Dialogue: 0,0:08:15.82,0:08:17.07,Default,,0,0,0,,Қынапқа қош келдіңіз
Dialogue: 0,0:08:17.91,0:08:20.87,Default,,0,0,0,,Ертең мектепте 7 минут кездескенше...
Dialogue: 0,0:08:30.59,0:08:32.80,Default,,0,0,0,,Бұл тамаша түн болды.
Dialogue: 0,0:08:32.88,0:08:34.09,Default,,0,0,0,,Сіз қашан ұйықтадыңыз?
Dialogue: 0,0:08:34.18,0:08:35.05,Default,,0,0,0,,Ұйықтамау
Dialogue: 0,0:08:36.26,0:08:38.10,Default,,0,0,0,,Топтық сину?
Dialogue: 0,0:08:38.18,0:08:41.43,Default,,0,0,0,,Бір адам қараудан шаршады да, сонда барды.
Dialogue: 0,0:08:41.52,0:08:43.02,Default,,0,0,0,,(Тодороки) Мен сол жігіттен барынша көп нәрсе үйренгім келеді
Dialogue: 0,0:08:43.10,0:08:45.56,Default,,0,0,0,,Мен мектепке баруым керек.
Dialogue: 0,0:08:45.65,0:08:47.77,Default,,0,0,0,,Порно жоқ
Dialogue: 0,0:08:48.90,0:08:52.44,Default,,0,0,0,,Бұлай мектепке бару жаман.
Dialogue: 0,0:08:52.53,0:08:54.15,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:08:54.24,0:08:55.82,Default,,0,0,0,,Оны қоқыс жәшігіне тастаңыз
Dialogue: 0,0:08:55.91,0:08:59.58,Default,,0,0,0,,Ақымақ болма, зиянды заттарды сыртқа таста.
Dialogue: 0,0:08:59.83,0:09:00.66,Default,,0,0,0,,Керемет
Dialogue: 0,0:09:00.74,0:09:02.45,Default,,0,0,0,,Синагога?
Dialogue: 0,0:09:02.75,0:09:06.33,Default,,0,0,0,,Маринадталған майшабақ иісін жасыратынына сенімдімін.
Dialogue: 0,0:09:06.42,0:09:08.38,Default,,0,0,0,,Бұл менің мақсатым.
Dialogue: 0,0:09:08.46,0:09:09.46,Default,,0,0,0,,Сіз ақылдысыз
Dialogue: 0,0:09:09.54,0:09:09.96,Default,,0,0,0,,〝Бриджтон орта мектебі〞
Dialogue: 0,0:09:09.96,0:09:10.63,Default,,0,0,0,,〝Бриджтон орта мектебі〞
Dialogue: 0,0:09:09.96,0:09:10.63,Default,,0,0,0,,Электрондарды бөлісетін атомдар арасындағы байланыс
Dialogue: 0,0:09:10.63,0:09:14.51,Default,,0,0,0,,Электрондарды бөлісетін атомдар арасындағы байланыс
Dialogue: 0,0:09:14.59,0:09:17.59,Default,,0,0,0,,«Ковалентті байланыс» деп аталады.
Dialogue: 0,0:09:17.68,0:09:18.30,Default,,0,0,0,,Эндрю
Dialogue: 0,0:09:18.39,0:09:18.93,Default,,0,0,0,,Не?
Dialogue: 0,0:09:19.01,0:09:22.27,Default,,0,0,0,,Ковалентті байланысқан молекуланың мысалы қандай?
Dialogue: 0,0:09:23.47,0:09:24.60,Default,,0,0,0,,Үлкен молекулалар?
Dialogue: 0,0:09:24.68,0:09:26.44,Default,,0,0,0,,Сіз тыңдамадыңыз.
Dialogue: 0,0:09:26.52,0:09:29.52,Default,,0,0,0,,Сен өте жаман қызсың.
Dialogue: 0,0:09:32.11,0:09:34.49,Default,,0,0,0,,Сені жазалағанымды қалайсың ба?
Dialogue: 0,0:09:34.57,0:09:38.70,Default,,0,0,0,,Мен жаман баламын, мені жазала
Dialogue: 0,0:09:38.78,0:09:41.78,Default,,0,0,0,,Партаға ұрса ше?
Dialogue: 0,0:09:41.87,0:09:43.12,Default,,0,0,0,,Осындайша тәж кигізу рәсіміне кедергі келтіру…
Dialogue: 0,0:09:43.49,0:09:44.29,Default,,0,0,0,,Сәлем
Dialogue: 0,0:09:44.37,0:09:47.04,Default,,0,0,0,,Балам, мені ұр
Dialogue: 0,0:09:47.12,0:09:49.13,Default,,0,0,0,,Бала емес
Dialogue: 0,0:09:49.21,0:09:51.38,Default,,0,0,0,,Партада отырған дұрыс сияқты.
Dialogue: 0,0:09:52.63,0:09:55.51,Default,,0,0,0,,21 тамызға қараған түні қайда болдың?
Dialogue: 0,0:09:55.59,0:09:58.05,Default,,0,0,0,,Мен үйде жалғыз болғаныма сенімдімін.
Dialogue: 0,0:09:58.13,0:09:58.63,Default,,0,0,0,,«Алиби жоқ»
Dialogue: 0,0:09:58.63,0:09:59.05,Default,,0,0,0,,«Алиби жоқ»
Dialogue: 0,0:09:58.63,0:09:59.05,Default,,0,0,0,,11 қыркүйек туралы не деуге болады?
Dialogue: 0,0:09:59.05,0:09:59.93,Default,,0,0,0,,11 қыркүйек туралы не деуге болады?
Dialogue: 0,0:10:00.01,0:10:02.31,Default,,0,0,0,,Менің туған күнім еді, мен үйде жалғыз қалдым.
Dialogue: 0,0:10:02.39,0:10:03.51,Default,,0,0,0,,28 қыркүйек туралы не деуге болады?
Dialogue: 0,0:10:03.60,0:10:05.93,Default,,0,0,0,,``Үйде жалғыз'' фильмін өзім көріп отырдым.
Dialogue: 0,0:10:06.02,0:10:09.52,Default,,0,0,0,,Сізде әліби жоқ, ал...
Dialogue: 0,0:10:09.60,0:10:11.98,Default,,0,0,0,,Жәбірленушімен қарым-қатынасы бар
Dialogue: 0,0:10:12.06,0:10:14.36,Default,,0,0,0,,Басқаша айтқанда, ол маңызды анықтамалық тұлға.
Dialogue: 0,0:10:14.44,0:10:15.99,Default,,0,0,0,,Бұл менмін...
Dialogue: 0,0:10:16.07,0:10:19.41,Default,,0,0,0,,Пайдалы болумен қатар, бұл адам ба?
Dialogue: 0,0:10:19.49,0:10:21.62,Default,,0,0,0,,Жаттықтырушы, сен адамсың.
Dialogue: 0,0:10:21.70,0:10:24.87,Default,,0,0,0,,Сіздің ең жақсы болуға құқығыңыз бар.
Dialogue: 0,0:10:25.04,0:10:26.50,Default,,0,0,0,,«Қалған бөлме»
Dialogue: 0,0:10:26.58,0:10:27.66,Default,,0,0,0,,Эндрю
Dialogue: 0,0:10:27.75,0:10:28.29,Default,,0,0,0,,Мисси
Dialogue: 0,0:10:28.37,0:10:31.71,Default,,0,0,0,,Себебі мен химия сабағында біртүрлі болдым.
Dialogue: 0,0:10:31.79,0:10:32.96,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:10:33.04,0:10:35.38,Default,,0,0,0,,Жарайды. Жуықта көріскенше.
Dialogue: 0,0:10:35.46,0:10:36.46,Default,,0,0,0,,Сіз бүгін келесіз, солай ма?
Dialogue: 0,0:10:36.55,0:10:39.30,Default,,0,0,0,,Жоқ, мен бейсбол ойынын көремін.
Dialogue: 0,0:10:39.80,0:10:40.68,Default,,0,0,0,,Әжеммен
Dialogue: 0,0:10:40.76,0:10:43.30,Default,,0,0,0,,Неліктен тойдан кейінгі күні?
Dialogue: 0,0:10:43.39,0:10:44.18,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:10:44.26,0:10:48.31,Default,,0,0,0,,Неліктен белдігі бар минет?
Dialogue: 0,0:10:48.39,0:10:49.14,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:10:49.23,0:10:50.48,Default,,0,0,0,,Ең ауыр жарақат алған – Зенитсу-сан
Dialogue: 0,0:10:50.56,0:10:53.56,Default,,0,0,0,,Жүр, менің ойымша, сен кінәлісің.
Dialogue: 0,0:10:53.65,0:10:55.61,Default,,0,0,0,,Мен сенімдімін.
Dialogue: 0,0:10:57.65,0:10:58.44,Default,,0,0,0,,Жарайды
Dialogue: 0,0:10:58.53,0:10:59.45,Default,,0,0,0,,«Байланыс жоқ»
Dialogue: 0,0:10:59.53,0:11:01.53,Default,,0,0,0,,WiFi қосылымы жоқ.
Dialogue: 0,0:11:01.61,0:11:05.37,Default,,0,0,0,,Порноның қажеті жоқ, өз қиялыңызды пайдаланыңыз.
Dialogue: 0,0:11:05.45,0:11:07.24,Default,,0,0,0,,Кеуделерді есте сақтаңыз
Dialogue: 0,0:11:07.33,0:11:10.75,Default,,0,0,0,,Бұл дөңгелек қорапқа ұқсайды.
Dialogue: 0,0:11:11.67,0:11:13.29,Default,,0,0,0,,Барлығы жағымсыз.
Dialogue: 0,0:11:13.38,0:11:15.17,Default,,0,0,0,,Иә, бұл жағымсыз.
Dialogue: 0,0:11:15.25,0:11:16.50,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:11:16.59,0:11:17.76,Default,,0,0,0,,Бұл үй.
Dialogue: 0,0:11:17.84,0:11:19.17,Default,,0,0,0,,Бұл өте нашар үй.
Dialogue: 0,0:11:19.26,0:11:20.42,Default,,0,0,0,,Бұл менің кінәм бе?
Dialogue: 0,0:11:22.13,0:11:24.47,Default,,0,0,0,,``Үлкен жарылыс теориясы'' күлкілі
Dialogue: 0,0:11:25.26,0:11:27.89,Default,,0,0,0,,Сусындарды беріңіз
Dialogue: 0,0:11:28.56,0:11:31.27,Default,,0,0,0,,Неге екені белгісіз, бұрынғыдан да ләззат аламын.
Dialogue: 0,0:11:31.35,0:11:34.48,Default,,0,0,0,,Өйткені мен оны сексуалды деп санаймын
Dialogue: 0,0:11:34.56,0:11:37.07,Default,,0,0,0,,Әкем ажырасқанымды қорғауымды өтінді.
Dialogue: 0,0:11:37.15,0:11:40.82,Default,,0,0,0,,Менің әкем сенің анаңды құртады
Dialogue: 0,0:11:40.90,0:11:41.95,Default,,0,0,0,,Мен көмектесе алмаймын.
Dialogue: 0,0:11:42.03,0:11:45.07,Default,,0,0,0,,Әкемді жертөлеге қуып жіберді...
Dialogue: 0,0:11:45.16,0:11:47.66,Default,,0,0,0,,Аулада душ қабылдау
Dialogue: 0,0:11:47.74,0:11:50.16,Default,,0,0,0,,Әкемнің жұмыс орнында...
Dialogue: 0,0:11:50.25,0:11:52.67,Default,,0,0,0,,Қабылдаушы мен халат бар.
Dialogue: 0,0:11:52.75,0:11:54.75,Default,,0,0,0,,Қабылдаушымен алдау?
Dialogue: 0,0:11:54.83,0:11:56.71,Default,,0,0,0,,Мен мұны байқамадым
Dialogue: 0,0:11:56.79,0:11:57.38,Default,,0,0,0,,Бұл ең нашар.
Dialogue: 0,0:11:57.46,0:11:58.13,Default,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:11:58.21,0:11:59.26,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:11:59.34,0:12:00.34,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:12:00.42,0:12:01.97,Default,,0,0,0,,Бірақ мен сенімен бірге бола аламын
Dialogue: 0,0:12:03.26,0:12:04.18,Default,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:12:08.51,0:12:10.43,Default,,0,0,0,,Ат құйрығы…
Dialogue: 0,0:12:16.48,0:12:17.57,Default,,0,0,0,,Эндрю
Dialogue: 0,0:12:17.65,0:12:19.90,Default,,0,0,0,,Амансың ба? Сіз сусызданған жоқсыз ба?
Dialogue: 0,0:12:19.98,0:12:21.15,Default,,0,0,0,,Жарайды
Dialogue: 0,0:12:21.24,0:12:24.28,Default,,0,0,0,,Жарайды ма? Мен жүрегімді жоғалттым.
Dialogue: 0,0:12:24.36,0:12:26.03,Default,,0,0,0,,Бейшара бала
Dialogue: 0,0:12:26.12,0:12:27.41,Default,,0,0,0,,Жараларды емдеу үшін
Dialogue: 0,0:12:27.49,0:12:30.62,Default,,0,0,0,,Тек досымның әкесінен құшақ
Dialogue: 0,0:12:30.70,0:12:32.66,Default,,0,0,0,,Бейсбол ойыны емес пе еді?
Dialogue: 0,0:12:32.75,0:12:35.29,Default,,0,0,0,,Доп кемпірге тиді...
Dialogue: 0,0:12:35.37,0:12:36.92,Default,,0,0,0,,2011 жылы қайтыс болды
Dialogue: 0,0:12:37.00,0:12:38.00,Default,,0,0,0,,Маған дәретхананы жалға беріңіз
Dialogue: 0,0:12:38.09,0:12:39.13,Default,,0,0,0,,Ол құлыптаулы ма?
Dialogue: 0,0:12:39.21,0:12:40.00,Default,,0,0,0,,Ауырсыну қалай?
Dialogue: 0,0:12:40.09,0:12:41.59,Default,,0,0,0,,WiFi құпия сөзі дегеніміз не?
Dialogue: 0,0:12:41.67,0:12:43.92,Default,,0,0,0,,«Балалар – қазына»
Dialogue: 0,0:12:44.01,0:12:44.76,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:12:44.84,0:12:47.43,Default,,0,0,0,,Интернетті шарлаудан ләззат алыңыз
Dialogue: 0,0:12:47.51,0:12:51.72,Default,,0,0,0,,Эндрю Мені жақсы сезіну
Dialogue: 0,0:12:51.81,0:12:53.27,Default,,0,0,0,,Киіміңді шеш.
Dialogue: 0,0:12:53.35,0:12:56.44,Default,,0,0,0,,Бұған дейін Amazon тізімінен...
Dialogue: 0,0:12:56.52,0:12:58.98,Default,,0,0,0,,Тоңазытқыш сатып алыңыз
Dialogue: 0,0:12:59.06,0:13:00.07,Default,,0,0,0,,«Бриджтон банкі»
Dialogue: 0,0:12:59.06,0:13:00.07,Default,,0,0,0,,Мен оны сатып алсам, шешіп бересіз бе?
Dialogue: 0,0:13:00.07,0:13:01.48,Default,,0,0,0,,Мен оны сатып алсам, сіз оны шешесіз бе?
Dialogue: 0,0:13:01.57,0:13:04.28,Default,,0,0,0,,Әрине, мен ыстықпын
Dialogue: 0,0:13:04.36,0:13:06.99,Default,,0,0,0,,Сондықтан оны суыту керек
Dialogue: 0,0:13:07.07,0:13:08.70,Default,,0,0,0,,Эндрю, жақсысың ба?
Dialogue: 0,0:13:08.78,0:13:09.78,Default,,0,0,0,,Сіз кіммен сөйлесесіз?
Dialogue: 0,0:13:09.87,0:13:11.08,Default,,0,0,0,,Құрамында
Dialogue: 0,0:13:11.54,0:13:14.12,Default,,0,0,0,,Порнографиядан аулақ болыңыз
Dialogue: 0,0:13:14.21,0:13:16.96,Default,,0,0,0,,Не? Сіз гормоналдысыз ба?
Dialogue: 0,0:13:17.04,0:13:19.00,Default,,0,0,0,,Иә, бұл көп шаршы.
Dialogue: 0,0:13:19.08,0:13:22.51,Default,,0,0,0,,Бірақ бұл таза импульс.
Dialogue: 0,0:13:22.59,0:13:25.17,Default,,0,0,0,,Мына сұлуды ұсқынсыз етіп тұрсың
Dialogue: 0,0:13:25.26,0:13:27.05,Default,,0,0,0,,Содан кейін кетіңіз.
Dialogue: 0,0:13:27.13,0:13:28.47,Default,,0,0,0,,Суық сызықтар
Dialogue: 0,0:13:29.05,0:13:30.01,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:13:31.51,0:13:33.06,Default,,0,0,0,,Тек өтірік айту.
Dialogue: 0,0:13:33.14,0:13:35.31,Default,,0,0,0,,Бұл жолы мен ваннада тұрып қалдым.
Dialogue: 0,0:13:35.39,0:13:36.69,Default,,0,0,0,,Ол Киригумо-суги деп аталатын өте жеңіл ағаш түрінен жасалған
Dialogue: 0,0:13:36.77,0:13:39.73,Default,,0,0,0,,Мен білемін, мен есірткі ішемін.
Dialogue: 0,0:13:39.81,0:13:41.27,Default,,0,0,0,,Бұл Эндрю?
Dialogue: 0,0:13:41.36,0:13:44.15,Default,,0,0,0,,Менің досымды тастап кеткеннен кейін...
Dialogue: 0,0:13:44.24,0:13:45.90,Default,,0,0,0,,Мен бірден есірткіге жүгіндім.
Dialogue: 0,0:13:46.40,0:13:50.45,Default,,0,0,0,,Ал көзін ашты да өлді.
Dialogue: 0,0:13:50.53,0:13:52.62,Default,,0,0,0,,Сіз үмітсіз дейсіз бе?
Dialogue: 0,0:13:52.70,0:13:54.87,Default,,0,0,0,,Жоқ. Досыңды сақта.
Dialogue: 0,0:13:54.95,0:13:58.29,Default,,0,0,0,,Дәрілерді осында әкеліңіз
Dialogue: 0,0:13:58.37,0:14:03.25,Default,,0,0,0,,Ал қасықты ұмытпаңыз.
Dialogue: 0,0:14:07.88,0:14:09.64,Default,,0,0,0,,Бұл Эндрю емес пе?
Dialogue: 0,0:14:09.72,0:14:10.59,Default,,0,0,0,,Не?
Dialogue: 0,0:14:10.68,0:14:12.43,Default,,0,0,0,,Мұнда кел
Dialogue: 0,0:14:12.51,0:14:13.10,Default,,0,0,0,,Мен?
Dialogue: 0,0:14:13.18,0:14:15.43,Default,,0,0,0,,Сізден басқа біреу бар ма?
Dialogue: 0,0:14:15.52,0:14:18.56,Default,,0,0,0,,Адриан Сіз печенье ұрладыңыз, солай ма?
Dialogue: 0,0:14:18.64,0:14:19.60,Default,,0,0,0,,Бұл Эндрю.
Dialogue: 0,0:14:19.69,0:14:20.73,Default,,0,0,0,,Бұл cookie файлы
Dialogue: 0,0:14:20.81,0:14:21.61,Default,,0,0,0,,Hello Kitty
Dialogue: 0,0:14:21.69,0:14:24.73,Default,,0,0,0,,Экран арқылы енгізіңіз
Dialogue: 0,0:14:24.82,0:14:26.11,Default,,0,0,0,,Не? енгізу?
Dialogue: 0,0:14:26.19,0:14:27.24,Default,,0,0,0,,Жақынырақ
Dialogue: 0,0:14:27.32,0:14:29.78,Default,,0,0,0,,Мен неге сенемін?
Dialogue: 0,0:14:31.91,0:14:33.16,Default,,0,0,0,,Оны ашыңыз.
Dialogue: 0,0:14:33.24,0:14:34.74,Default,,0,0,0,,Маған инъекция беріңіз
Dialogue: 0,0:14:36.41,0:14:36.95,Default,,0,0,0,,Эндрю?
Dialogue: 0,0:14:37.04,0:14:37.96,Default,,0,0,0,,Жоқ
Dialogue: 0,0:14:38.04,0:14:39.29,Default,,0,0,0,,Героин көп пе?
Dialogue: 0,0:14:39.37,0:14:40.96,Default,,0,0,0,,Героин? Жоқ
Dialogue: 0,0:14:41.04,0:14:42.59,Default,,0,0,0,,Мен порнографияға тәуелдімін.
Dialogue: 0,0:14:42.67,0:14:45.42,Default,,0,0,0,,Эндрюді сорып алды
Dialogue: 0,0:14:45.50,0:14:47.09,Default,,0,0,0,,Порнографияға
Dialogue: 0,0:14:47.97,0:14:48.51,Default,,0,0,0,,Не?
Dialogue: 0,0:14:48.59,0:14:52.97,Default,,0,0,0,,Порнография шынайы болатын басқа әлем
Dialogue: 0,0:14:53.05,0:14:54.51,Default,,0,0,0,,Порнография
Dialogue: 0,0:14:56.39,0:14:57.93,Default,,0,0,0,,О, құдайым Эндрю
Dialogue: 0,0:14:58.02,0:15:00.31,Default,,0,0,0,,Егер оны тез арада құтқармасақ
Dialogue: 0,0:15:00.39,0:15:04.23,Default,,0,0,0,,Мен енді ешкіммен физикалық және психикалық байланыс жасай алмаймын.
Dialogue: 0,0:15:04.32,0:15:05.11,Default,,0,0,0,,Нед қол
Dialogue: 0,0:15:05.19,0:15:05.77,Default,,0,0,0,,Бұл Ник.
Dialogue: 0,0:15:05.86,0:15:07.19,Default,,0,0,0,,Солай деді
Dialogue: 0,0:15:07.28,0:15:09.07,Default,,0,0,0,,Кішкене қатал...
Dialogue: 0,0:15:09.61,0:15:12.03,Default,,0,0,0,,Менің аяғым аздап қалды.
Dialogue: 0,0:15:12.11,0:15:13.49,Default,,0,0,0,,Бұл жүзім ба?
Dialogue: 0,0:15:13.57,0:15:15.08,Default,,0,0,0,,Мен төңкеріліп тұрмын
Dialogue: 0,0:15:16.99,0:15:18.58,Default,,0,0,0,,«Бетан Фетамин Холл»
Dialogue: 0,0:15:16.99,0:15:18.58,Default,,0,0,0,,Дина осы синагогадағы кантор.
Dialogue: 0,0:15:18.58,0:15:20.25,Default,,0,0,0,,Дина осы синагогадағы кантор.
Dialogue: 0,0:15:20.33,0:15:22.08,Default,,0,0,0,,Мен істей алатын нәрсе бар ма?
Dialogue: 0,0:15:22.17,0:15:23.92,Default,,0,0,0,,Мұнда терезені сындырайық.
Dialogue: 0,0:15:24.00,0:15:26.00,Default,,0,0,0,,Бұл жек көрушілік қылмыс
Dialogue: 0,0:15:26.09,0:15:28.88,Default,,0,0,0,,Ал, өсек-аяңды таратайық.
Dialogue: 0,0:15:28.96,0:15:32.93,Default,,0,0,0,,Дина тәттілерге тезек жейді
Dialogue: 0,0:15:33.01,0:15:35.39,Default,,0,0,0,,Неліктен бұл қауесетті үнемі естисің?
Dialogue: 0,0:15:35.47,0:15:36.10,Default,,0,0,0,,Қандай дыбыс?
Dialogue: 0,0:15:38.47,0:15:40.68,Default,,0,0,0,,Не болды? Ішінде не бар?
Dialogue: 0,0:15:43.40,0:15:45.31,Default,,0,0,0,,Мен не істеуім керек? Бұл мәйіт!
Dialogue: 0,0:15:45.40,0:15:46.65,Default,,0,0,0,,Менің қызым бол!
Dialogue: 0,0:15:46.73,0:15:47.90,Default,,0,0,0,,Оны неге қазір айту керек?
Dialogue: 0,0:15:47.98,0:15:48.69,Default,,0,0,0,,Сонда қашан?
Dialogue: 0,0:15:48.78,0:15:49.61,Default,,0,0,0,,Қазірден басқа!
Dialogue: 0,0:15:49.69,0:15:51.53,Default,,0,0,0,,Мен сені жақсы көремін!
Dialogue: 0,0:15:55.20,0:15:56.66,Default,,0,0,0,,Итальяндық айғыр?
Dialogue: 0,0:15:56.74,0:15:57.37,Default,,0,0,0,,Сәлем
Dialogue: 0,0:15:57.45,0:15:59.45,Default,,0,0,0,,Эндрюді көрмедің бе?
Dialogue: 0,0:15:59.54,0:16:01.91,Default,,0,0,0,,Денесі алмұрт тәрізді, көзілдірік киеді.
Dialogue: 0,0:16:02.00,0:16:05.13,Default,,0,0,0,,Бұл Адриан емес пе?
Dialogue: 0,0:16:05.46,0:16:07.92,Default,,0,0,0,,Ол ұлы патша
Dialogue: 0,0:16:08.00,0:16:09.55,Default,,0,0,0,,Менің сөйлескім келеді
Dialogue: 0,0:16:09.63,0:16:11.92,Default,,0,0,0,,Шағымдамаңыз, тыңдаңыз.
Dialogue: 0,0:16:12.01,0:16:14.01,Default,,0,0,0,,Ол біздің жаратушымыз.
Dialogue: 0,0:16:14.09,0:16:16.10,Default,,0,0,0,,Жыныстық құдай
Dialogue: 0,0:16:16.18,0:16:17.68,Default,,0,0,0,,Сіз қайда екеніңізді білесіз бе?
Dialogue: 0,0:16:17.76,0:16:18.97,Default,,0,0,0,,Чинко өзенінің жоғары ағысы.
Dialogue: 0,0:16:19.06,0:16:21.27,Default,,0,0,0,,Мен сені сонда апарамын.
Dialogue: 0,0:16:21.35,0:16:22.35,Default,,0,0,0,,Сүйісейік
Dialogue: 0,0:16:22.43,0:16:24.69,Default,,0,0,0,,Маған тиіспе, кеттік.
Dialogue: 0,0:16:30.61,0:16:31.74,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:16:31.82,0:16:33.86,Default,,0,0,0,,Шолу тарихы әлемі
Dialogue: 0,0:16:33.95,0:16:36.37,Default,,0,0,0,,Сіз көрген нәрсе шындыққа айналады
Dialogue: 0,0:16:37.20,0:16:40.04,Default,,0,0,0,,Микки мен Поли
Dialogue: 0,0:16:40.58,0:16:41.62,Default,,0,0,0,,бірақ ол да маған күдікпен қарады…
Dialogue: 0,0:16:41.70,0:16:44.37,Default,,0,0,0,,Себебі мен саған «Италиялық айғырды» көрсеттім.
Dialogue: 0,0:16:44.46,0:16:46.63,Default,,0,0,0,,Жоқ, бұл менің кінәм шығар.
Dialogue: 0,0:16:46.71,0:16:48.67,Default,,0,0,0,,«Жасөспірімдік» оны сындырды
Dialogue: 0,0:16:48.75,0:16:51.17,Default,,0,0,0,,Мені қашан құртасың?
Dialogue: 0,0:16:51.26,0:16:52.30,Default,,0,0,0,,Тағы да солай ма?
Dialogue: 0,0:16:52.38,0:16:53.63,Default,,0,0,0,,Сізге әлі ерте
Dialogue: 0,0:16:53.72,0:16:56.68,Default,,0,0,0,,Онда неге мені порно әлеміне жібердің?
Dialogue: 0,0:16:56.76,0:16:58.35,Default,,0,0,0,,Порнография
Dialogue: 0,0:16:58.43,0:17:00.43,Default,,0,0,0,,Бұл жақсырақ
Dialogue: 0,0:17:00.51,0:17:02.47,Default,,0,0,0,,Сізді әкелген адам-
Dialogue: 0,0:17:02.56,0:17:04.81,Default,,0,0,0,,Себебі мен Эндрюді көндіре аламын.
Dialogue: 0,0:17:04.89,0:17:07.15,Default,,0,0,0,,Кешіріңіз, бірақ мен келдім.
Dialogue: 0,0:17:10.65,0:17:11.69,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:17:11.78,0:17:13.11,Default,,0,0,0,,Патша сонда.
Dialogue: 0,0:17:14.15,0:17:18.07,Default,,0,0,0,,Міне, мен Гарнизон Кейлордың аузына кірдім.
Dialogue: 0,0:17:18.16,0:17:21.12,Default,,0,0,0,,Эндрю мені сонда да сүйіп кете жаздады.
Dialogue: 0,0:17:21.20,0:17:24.79,Default,,0,0,0,,Гарнизонның оқиғасын еске түсіріңіз.
Dialogue: 0,0:17:29.29,0:17:31.00,Default,,0,0,0,,Кешіріңіз, кіруге тыйым салынады.
Dialogue: 0,0:17:31.09,0:17:33.71,Default,,0,0,0,,Ей, екеуің ішке кіріңдер.
Dialogue: 0,0:17:38.09,0:17:39.72,Default,,0,0,0,,Эндрю
Dialogue: 0,0:17:39.80,0:17:40.97,Default,,0,0,0,,Тіпті осындай нәрселер...
Dialogue: 0,0:17:41.06,0:17:42.85,Default,,0,0,0,,Форель устрицаларының үйі?
Dialogue: 0,0:17:42.93,0:17:43.85,Default,,0,0,0,,Мына көйлек ше?
Dialogue: 0,0:17:44.64,0:17:45.77,Default,,0,0,0,,Порнографиялық көйлек?
Dialogue: 0,0:17:45.85,0:17:49.61,Default,,0,0,0,,Хэллоуинде киген Дракула костюмі.
Dialogue: 0,0:17:50.40,0:17:51.77,Default,,0,0,0,,«Міне, менің электрондық поштамның мекенжайы.»
Dialogue: 0,0:17:51.86,0:17:52.65,Default,,0,0,0,,Мен көмекке келдім
Dialogue: 0,0:17:52.73,0:17:54.44,Default,,0,0,0,,Бұған жол берілмейді.
Dialogue: 0,0:17:54.53,0:17:58.32,Default,,0,0,0,,Ол маған ыдыс жуғыш машина сатып алуға келді.
Dialogue: 0,0:17:58.41,0:18:01.41,Default,,0,0,0,,Кішкентай, бірақ үлкен табақ сыйдырады
Dialogue: 0,0:18:01.49,0:18:03.16,Default,,0,0,0,,Оны әлі шешкен жоқпын
Dialogue: 0,0:18:03.24,0:18:04.95,Default,,0,0,0,,Бұл сен емессің
Dialogue: 0,0:18:05.04,0:18:07.54,Default,,0,0,0,,Ол шын мәнінде керемет адам.
Dialogue: 0,0:18:07.62,0:18:09.75,Default,,0,0,0,,Мен Миссиді жақсы көремін
Dialogue: 0,0:18:13.21,0:18:15.30,Default,,0,0,0,,Сыртқы дүние тым қатал
Dialogue: 0,0:18:15.38,0:18:16.63,Default,,0,0,0,,Бұл жерде сізге зиян тигізбейді.
Dialogue: 0,0:18:16.72,0:18:17.72,Default,,0,0,0,,Нақты емес
Dialogue: 0,0:18:17.80,0:18:20.43,Default,,0,0,0,,Бұл мен үшін шындық
Dialogue: 0,0:18:20.51,0:18:22.97,Default,,0,0,0,,Сөйлесіп жатқанда тоқтаңыз.
Dialogue: 0,0:18:23.06,0:18:23.72,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:23.81,0:18:27.56,Default,,0,0,0,,Онда мен де осында қаламын.
Dialogue: 0,0:18:27.64,0:18:30.31,Default,,0,0,0,,Порно әлемінде өмір сүру
Dialogue: 0,0:18:30.40,0:18:34.19,Default,,0,0,0,,Бұл порнография. Неліктен дұрыс емес?
Dialogue: 0,0:18:34.27,0:18:35.82,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:18:35.90,0:18:36.90,Default,,0,0,0,,Бізге қосылыңыз
Dialogue: 0,0:18:36.99,0:18:40.28,Default,,0,0,0,,Әтешіңді қысып, қыздың көтін жалап
Dialogue: 0,0:18:40.36,0:18:41.91,Default,,0,0,0,,Барлығының да бөксесі
Dialogue: 0,0:18:41.99,0:18:43.45,Default,,0,0,0,,Бұл рух.
Dialogue: 0,0:18:43.53,0:18:45.87,Default,,0,0,0,,Енді түсіндің, солай ма?
Dialogue: 0,0:18:45.95,0:18:47.58,Default,,0,0,0,,Жасөспірімдікке әлі ерте
Dialogue: 0,0:18:47.66,0:18:49.08,Default,,0,0,0,,Сіз мұны білесіз бе?
Dialogue: 0,0:18:49.16,0:18:51.00,Default,,0,0,0,,Келіңдер, азғындар.
Dialogue: 0,0:18:51.58,0:18:53.25,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:18:55.05,0:18:57.92,Default,,0,0,0,,Біз Никке қазір көмектесуіміз керек.
Dialogue: 0,0:18:58.01,0:19:01.55,Default,,0,0,0,,Сіз қатты зорланғалы жатырсыз.
Dialogue: 0,0:19:01.64,0:19:02.39,Default,,0,0,0,,Эндрю?
Dialogue: 0,0:19:02.47,0:19:03.72,Default,,0,0,0,,Жүріңдер, келіңдер.
Dialogue: 0,0:19:04.18,0:19:04.72,Default,,0,0,0,,Тоқта
Dialogue: 0,0:19:04.81,0:19:08.43,Default,,0,0,0,,Никті жіберіңіз, оған әлі ерте.
Dialogue: 0,0:19:08.52,0:19:10.81,Default,,0,0,0,,Морис, қаш.
Dialogue: 0,0:19:11.77,0:19:13.06,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:19:13.52,0:19:15.57,Default,,0,0,0,,Аш бұзықтар жылдам.
Dialogue: 0,0:19:19.70,0:19:21.70,Default,,0,0,0,,Темекіні аз тартпасаңыз
Dialogue: 0,0:19:25.03,0:19:27.70,Default,,0,0,0,,Патшаны жайына қалдыр
Dialogue: 0,0:19:27.79,0:19:30.04,Default,,0,0,0,,Екеуің де қайыққа мініңдер.
Dialogue: 0,0:19:30.12,0:19:31.17,Default,,0,0,0,,Айғырды жайына қалдыр
Dialogue: 0,0:19:31.25,0:19:33.13,Default,,0,0,0,,Мен сені артта қалдыра алмаймын
Dialogue: 0,0:19:33.21,0:19:34.96,Default,,0,0,0,,Жарайды, тез кет.
Dialogue: 0,0:19:35.04,0:19:37.38,Default,,0,0,0,,Бар күшіңмен маған кел
Dialogue: 0,0:19:39.88,0:19:41.13,Default,,0,0,0,,Мектеп формасын өзгерте алмайсыңдар ма?
Dialogue: 0,0:19:45.01,0:19:47.26,Default,,0,0,0,,Мынаны да же!
Dialogue: 0,0:19:49.14,0:19:50.89,Default,,0,0,0,,Бұл ең жақсы!
Dialogue: 0,0:19:52.60,0:19:54.02,Default,,0,0,0,,Тастанды
Dialogue: 0,0:19:54.10,0:19:56.27,Default,,0,0,0,,Жоқ, ол мұны қалайды.
Dialogue: 0,0:19:56.36,0:19:59.15,Default,,0,0,0,,Мен осылай өлгім келді.
Dialogue: 0,0:20:00.74,0:20:01.65,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:20:01.74,0:20:02.28,Default,,0,0,0,,Мисси?
Dialogue: 0,0:20:02.36,0:20:03.36,Default,,0,0,0,,Мұнда не бар?
Dialogue: 0,0:20:03.45,0:20:04.66,Default,,0,0,0,,Сізді іздеймін
Dialogue: 0,0:20:04.74,0:20:05.82,Default,,0,0,0,,Тез қашайық
Dialogue: 0,0:20:05.91,0:20:07.16,Default,,0,0,0,,Мен мұнда бақыттымын
Dialogue: 0,0:20:07.24,0:20:08.58,Default,,0,0,0,,Ғашық болуға қайта оралайық
Dialogue: 0,0:20:08.66,0:20:09.45,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:20:09.54,0:20:11.41,Default,,0,0,0,,Бұл жерде қалуға болмайды.
Dialogue: 0,0:20:14.12,0:20:15.63,Default,,0,0,0,,Мисси емес
Dialogue: 0,0:20:15.71,0:20:16.50,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:20:17.34,0:20:20.46,Default,,0,0,0,,Нағыз Мисси менімен бірге болғысы келмейді.
Dialogue: 0,0:20:20.55,0:20:22.55,Default,,0,0,0,,Ал аяқтары жасанды мүшелер
Dialogue: 0,0:20:22.63,0:20:23.22,Default,,0,0,0,,Кеттік
Dialogue: 0,0:20:23.30,0:20:24.59,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:20:24.68,0:20:27.30,Default,,0,0,0,,Мен сені ешқайда жібермеймін.
Dialogue: 0,0:20:37.98,0:20:39.52,Default,,0,0,0,,Ол қайтып келді.
Dialogue: 0,0:20:40.15,0:20:41.86,Default,,0,0,0,,Мен түсіндім деп ойлаймын.
Dialogue: 0,0:20:41.94,0:20:44.24,Default,,0,0,0,,Менің порномда проблема бар
Dialogue: 0,0:20:44.32,0:20:48.24,Default,,0,0,0,,Қарияның зәрінен біртүрлі иіс шыққаны рас.
Dialogue: 0,0:20:48.33,0:20:50.20,Default,,0,0,0,,Бұл витамин бе?
Dialogue: 0,0:20:50.29,0:20:51.54,Default,,0,0,0,,Қосымшалар
Dialogue: 0,0:20:51.95,0:20:55.12,Default,,0,0,0,,Құрбым екеуміз шу естідік...
Dialogue: 0,0:20:55.21,0:20:57.04,Default,,0,0,0,,Қақпақты ашсаңыз, мәйіт жатыр.
Dialogue: 0,0:20:57.13,0:20:58.63,Default,,0,0,0,,Оның сүйіктісі?
Dialogue: 0,0:20:58.71,0:21:00.09,Default,,0,0,0,,Дәл емес
Dialogue: 0,0:21:00.17,0:21:01.67,Default,,0,0,0,,Сонда ол ше?
Dialogue: 0,0:21:01.76,0:21:03.38,Default,,0,0,0,,Сіз ғашық болғыңыз келе ме?
Dialogue: 0,0:21:03.47,0:21:04.76,Default,,0,0,0,,Мен қандаймын?
Dialogue: 0,0:21:04.84,0:21:06.13,Default,,0,0,0,,Кейде сүйіп тұратын адам
Dialogue: 0,0:21:06.22,0:21:08.14,Default,,0,0,0,,Бұл ғашық емес
Dialogue: 0,0:21:08.22,0:21:08.97,Default,,0,0,0,,Адамдар өлді
Dialogue: 0,0:21:09.05,0:21:12.39,Default,,0,0,0,,Бүгін түнде қарым-қатынасты ашыңыз.
Dialogue: 0,0:21:12.47,0:21:15.19,Default,,0,0,0,,Екеуінің естіген шулары кінәлі болуы керек.
Dialogue: 0,0:21:15.27,0:21:17.85,Default,,0,0,0,,Бұл кезде жаттықтырушы осында болды.
Dialogue: 0,0:21:17.94,0:21:20.52,Default,,0,0,0,,Басқаша айтқанда, ол кінәлі емес.
Dialogue: 0,0:21:20.61,0:21:22.19,Default,,0,0,0,,Джон Бон ат құйрығы?
Dialogue: 0,0:21:22.28,0:21:24.40,Default,,0,0,0,,Лақап аттармен ойнауды тоқтатыңыз
Dialogue: 0,0:21:24.65,0:21:26.36,Default,,0,0,0,,Сіз боссыз
Dialogue: 0,0:21:26.99,0:21:28.45,Default,,0,0,0,,Сіз осында бола аласыз ба?
Dialogue: 0,0:21:28.53,0:21:30.66,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:21:30.74,0:21:31.45,Default,,0,0,0,,«Полиция бөлімшесі»
Dialogue: 0,0:21:31.45,0:21:31.83,Default,,0,0,0,,«Полиция бөлімшесі»
Dialogue: 0,0:21:31.45,0:21:31.83,Default,,0,0,0,,Мен үйге баруым керек.
Dialogue: 0,0:21:31.83,0:21:33.33,Default,,0,0,0,,Мен үйге баруым керек.
Dialogue: 0,0:21:33.79,0:21:34.96,Default,,0,0,0,,Шынымен бе!? Иә
Dialogue: 0,0:21:35.04,0:21:36.42,Default,,0,0,0,,Ха-ха-ха-ха! Бұл дәл сен сияқты, Лабраба.
Dialogue: 0,0:21:36.50,0:21:37.83,Default,,0,0,0,,Тамақ болмайды.
Dialogue: 0,0:21:37.92,0:21:39.33,Default,,0,0,0,,Үйге баруды тоқтатыңыз
Dialogue: 0,0:21:39.42,0:21:40.84,Default,,0,0,0,,Киноға барасыз ба?
Dialogue: 0,0:21:40.92,0:21:42.42,Default,,0,0,0,,Зиратта ұйықтайсың ба?
Dialogue: 0,0:21:42.50,0:21:44.84,Default,,0,0,0,,Бос бейіт бар
Dialogue: 0,0:21:44.92,0:21:46.43,Default,,0,0,0,,Бұл жерден кетейік
Dialogue: 0,0:21:46.51,0:21:49.30,Default,,0,0,0,,Мексикаға қашу
Dialogue: 0,0:21:49.39,0:21:53.02,Default,,0,0,0,,Жағада өмір сүріп, шашыңды өр
Dialogue: 0,0:21:53.10,0:21:55.06,Default,,0,0,0,,Алыс жерге барайық
Dialogue: 0,0:21:55.14,0:21:56.10,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:21:56.18,0:21:56.73,Default,,0,0,0,,Иә
Dialogue: 0,0:21:56.81,0:21:59.10,Default,,0,0,0,,Мен 100% борттамын.
Dialogue: 0,0:21:59.19,0:22:01.11,Default,,0,0,0,,Сондай-ақ рюкзак бар
Dialogue: 0,0:22:01.19,0:22:03.40,Default,,0,0,0,,Мен ойымды өзгерткенше барайық.
Dialogue: 0,0:22:03.48,0:22:06.11,Default,,0,0,0,,Мазмұны - шелпек чипсы.
Dialogue: 0,0:22:07.49,0:22:08.70,Default,,0,0,0,,Сәлем Ник
Dialogue: 0,0:22:10.28,0:22:12.03,Default,,0,0,0,,Қалай қашып құтылдың?
Dialogue: 0,0:22:12.12,0:22:14.08,Default,,0,0,0,,Олардың барлығы қылмыс жасаған.
Dialogue: 0,0:22:14.16,0:22:16.37,Default,,0,0,0,,Бұл туралы, мен-
Dialogue: 0,0:22:16.46,0:22:18.54,Default,,0,0,0,,Жасөспірімдікке әлі ерте
Dialogue: 0,0:22:18.62,0:22:21.04,Default,,0,0,0,,Жоқ, мен өзім шеше алмаймын.
Dialogue: 0,0:22:21.13,0:22:23.00,Default,,0,0,0,,Іштің төменгі бөлігіне қараңыз.
Dialogue: 0,0:22:23.38,0:22:24.84,Default,,0,0,0,,Сәлем Ник
Dialogue: 0,0:22:24.92,0:22:26.76,Default,,0,0,0,,Жаңа дос
Dialogue: 0,0:22:26.84,0:22:29.22,Default,,0,0,0,,Бұл Тампа ма? ыстық және иісі бар
Dialogue: 0,0:22:29.30,0:22:30.01,Default,,0,0,0,,Мен қашып кеткім келеді
Dialogue: 0,0:22:30.09,0:22:31.55,Default,,0,0,0,,Тампа емес
Dialogue: 0,0:22:31.64,0:22:33.35,Default,,0,0,0,,Америка Құрама Штаттарының кеңістігінде болу
Dialogue: 0,0:22:33.43,0:22:34.51,Default,,0,0,0,,(Саяма) Ой! (Джунпей) Уф...
Dialogue: 0,0:22:34.72,0:22:36.18,Default,,0,0,0,,Ақырында жыныстық жетілу ме?
Dialogue: 0,0:22:36.27,0:22:37.85,Default,,0,0,0,,Сіз менің серіктесімсіз бе?
Dialogue: 0,0:22:38.35,0:22:40.02,Default,,0,0,0,,Сәл басқаша
Dialogue: 0,0:22:40.10,0:22:42.19,Default,,0,0,0,,Рик сіздің серіктесіңіз
Dialogue: 0,0:22:42.27,0:22:44.02,Default,,0,0,0,,Монах қайда?
Dialogue: 0,0:22:44.11,0:22:45.90,Default,,0,0,0,,Мен тіпті көрмеймін ...
Dialogue: 0,0:22:45.98,0:22:48.20,Default,,0,0,0,,Менің аяғымнан боқ жүгіріп барады.
Dialogue: 0,0:22:48.57,0:22:50.82,Default,,0,0,0,,Бірге көңіл көтерейік
Dialogue: 0,0:22:50.91,0:22:53.16,Default,,0,0,0,,Мен мұны мүлдем жек көремін.
Dialogue: 0,0:22:53.24,0:22:56.95,Default,,0,0,0,,Инъекция арқылы жыныстық жетілуді тоқтатуға болады, солай ма?
Dialogue: 0,0:22:57.04,0:23:00.17,Default,,0,0,0,,Саған мастурбацияны үйретейін бе?
Dialogue: 0,0:23:02.92,0:23:05.09,Default,,0,0,0,,Бір есікті жапсаңыз...
Dialogue: 0,0:23:05.88,0:23:07.09,Default,,0,0,0,,Тағы бір есік ашылады
Dialogue: 0,0:23:07.59,0:23:09.84,Default,,0,0,0,,Еденге түс, бұзық!
Dialogue: 0,0:23:09.93,0:23:11.18,Default,,0,0,0,,Жерде не бар?
Dialogue: 0,0:23:11.26,0:23:12.09,Default,,0,0,0,,Қамау
Dialogue: 0,0:23:12.18,0:23:13.43,Default,,0,0,0,,Ұлыңмен не істейсің?
Dialogue: 0,0:23:13.51,0:23:15.64,Default,,0,0,0,,Мұны айту қиын, бірақ...
Dialogue: 0,0:23:15.72,0:23:17.85,Default,,0,0,0,,Сіздің ұлыңыз қанішер
Dialogue: 0,0:23:17.93,0:23:18.60,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:23:18.68,0:23:22.27,Default,,0,0,0,,Мәйіт ДНҚ-да жабылған.
Dialogue: 0,0:23:22.35,0:23:23.90,Default,,0,0,0,,Бұл көп шәует.
Dialogue: 0,0:23:23.98,0:23:24.77,Default,,0,0,0,,Шұлықтар.
Dialogue: 0,0:23:24.86,0:23:27.73,Default,,0,0,0,,Мен бұл аттың ісі деп ойладым.
Dialogue: 0,0:23:27.82,0:23:30.11,Default,,0,0,0,,Мен сенің кім екеніңді білемін.
Dialogue: 0,0:23:30.20,0:23:32.61,Default,,0,0,0,,Ат құйрығы Нантока
Dialogue: 0,0:23:32.70,0:23:34.57,Default,,0,0,0,,Ол жай ғана біртүрлі бала.
Dialogue: 0,0:23:34.66,0:23:35.99,Default,,0,0,0,,Детектив Бұл
Dialogue: 0,0:23:36.08,0:23:36.79,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:23:36.87,0:23:37.70,Default,,0,0,0,,Келесі мақсат?
Dialogue: 0,0:23:37.79,0:23:39.75,Default,,0,0,0,,Бұл менің әріптесім Сюзан.
Dialogue: 0,0:23:39.83,0:23:41.67,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:23:41.75,0:23:44.50,Default,,0,0,0,,Бұл Гормон-кундікі.
Dialogue: 0,0:23:44.58,0:23:46.84,Default,,0,0,0,,Менің балам жынды!
Dialogue: 0,0:23:46.92,0:23:49.30,Default,,0,0,0,,Бұл да Гормон-кун ба?
Dialogue: 0,0:23:49.38,0:23:52.13,Default,,0,0,0,,Иә, мен оны сонда шығарайын деп едім.
Dialogue: 0,0:23:52.22,0:23:53.47,Default,,0,0,0,,Неліктен түсіндіру керек?
Dialogue: 0,0:23:53.55,0:23:55.26,Default,,0,0,0,,Эндрю
Dialogue: 0,0:23:55.35,0:23:58.52,Default,,0,0,0,,Қабырғама тесік жасау деген нені білдіреді?
Dialogue: 0,0:23:58.60,0:24:00.18,Default,,0,0,0,,Баламды ал
Dialogue: 0,0:24:00.27,0:24:00.93,Default,,0,0,0,,Тоқта
Dialogue: 0,0:24:02.89,0:24:06.19,Default,,0,0,0,,Мен жексенбіде құрылыс дүкеніне баруым керек.
Dialogue: 0,0:24:06.27,0:24:08.82,Default,,0,0,0,,Неге бұлай істеп жатырсың?
Dialogue: 0,0:24:08.90,0:24:10.15,Default,,0,0,0,,«Түрме»
Dialogue: 0,0:24:10.69,0:24:11.90,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:24:11.99,0:24:13.91,Default,,0,0,0,,Бұл қорқынышты, Ник.
Dialogue: 0,0:24:13.99,0:24:17.66,Default,,0,0,0,,Бөлмедегі жігіт мені «сүйкімді тесік» деп атайды
Dialogue: 0,0:24:18.16,0:24:21.08,Default,,0,0,0,,Оны қабылдаңыз және ләззат алыңыз.
Dialogue: 0,0:24:21.16,0:24:23.96,Default,,0,0,0,,Сіз шыға аласыз, өйткені сіз кінәсізсіз.
Dialogue: 0,0:24:24.04,0:24:25.33,Default,,0,0,0,,Сіз кінәсізсіз бе?
Dialogue: 0,0:24:25.42,0:24:28.88,Default,,0,0,0,,Мәйіт сіздің ДНҚ-да жабылған.
Dialogue: 0,0:24:28.96,0:24:29.88,Default,,0,0,0,,Сондай-ақ көздің ішінде...
Dialogue: 0,0:24:29.96,0:24:31.67,Default,,0,0,0,,Мен кінәсізмін
Dialogue: 0,0:24:31.76,0:24:35.22,Default,,0,0,0,,Ол сериялық өлтіруші емес, ол мастурбатор.
Dialogue: 0,0:24:35.30,0:24:37.76,Default,,0,0,0,,Менің жарнамамды плагиат жасамаңыз
Dialogue: 0,0:24:37.85,0:24:40.35,Default,,0,0,0,,Джейдің әкесі Неге келдіңіз?
Dialogue: 0,0:24:40.43,0:24:43.81,Default,,0,0,0,,Мен сені қорғаймын, сен үйіңе қайт.
Dialogue: 0,0:24:43.89,0:24:44.44,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:24:44.52,0:24:45.69,Default,,0,0,0,,Жақсы жаңалық.
Dialogue: 0,0:24:45.77,0:24:49.73,Default,,0,0,0,,Мәйітті лақтырып жіберген адам камераға түсіп қалған.
Dialogue: 0,0:24:49.82,0:24:51.11,Default,,0,0,0,,Жақсы
Dialogue: 0,0:24:51.19,0:24:52.49,Default,,0,0,0,,Жаман жаңалықтар.
Dialogue: 0,0:24:52.57,0:24:56.20,Default,,0,0,0,,Мен сенің шұлықтарыңды лақтырып жатқаныңды да көрдім.
Dialogue: 0,0:24:56.28,0:24:57.57,Default,,0,0,0,,Дәл сол қоқыс жәшігі
Dialogue: 0,0:24:57.66,0:24:59.70,Default,,0,0,0,,Бейне тарап кетті
Dialogue: 0,0:24:59.78,0:25:02.08,Default,,0,0,0,,〝Камера 4 сейсенбі〞
Dialogue: 0,0:25:02.16,0:25:03.58,Default,,0,0,0,,Осы жерде қағып жатырсыз ба?
Dialogue: 0,0:25:03.66,0:25:04.21,Default,,0,0,0,,Иә
Dialogue: 0,0:25:04.29,0:25:05.83,Default,,0,0,0,,Ал мұрынды таңда
Dialogue: 0,0:25:05.92,0:25:07.67,Default,,0,0,0,,`` Ұрық шұлығын лақтыратын бұзық''
Dialogue: 0,0:25:07.67,0:25:09.00,Default,,0,0,0,,`` Ұрық шұлықтарын лақтырып жатқан бұзық '' Мен енді мектепке бара алмаймын
Dialogue: 0,0:25:09.00,0:25:09.38,Default,,0,0,0,,Мен енді мектепке бара алмаймын
Dialogue: 0,0:25:09.46,0:25:11.92,Default,,0,0,0,,Бұл қазір ұят болуы мүмкін.
Dialogue: 0,0:25:12.01,0:25:15.84,Default,,0,0,0,,Бірақ бір күні артыма қарайтын уақыт келеді
Dialogue: 0,0:25:15.93,0:25:18.47,Default,,0,0,0,,Керемет нәрсе дүниеге келеді
Dialogue: 0,0:25:18.55,0:25:21.85,Default,,0,0,0,,Қызып тұрған бала бейнеленген бағдарлама?
Dialogue: 0,0:25:21.93,0:25:24.31,Default,,0,0,0,,Бұл балалар порнографиясы
Dialogue: 0,0:25:24.39,0:25:26.35,Default,,0,0,0,,Бұл жаман
Dialogue: 0,0:25:26.44,0:25:29.48,Default,,0,0,0,,Бірақ оны анимеге айналдырсаңыз, ешқандай проблема жоқ.
Dialogue: 0,0:25:29.94,0:25:30.77,Default,,0,0,0,,Мен және ұлым
Dialogue: 0,0:25:39.28,0:25:42.29,Default,,0,0,0,,Жүктен аулақ болыңыз және тасымалдаушыға отырыңыз.
Dialogue: 0,0:25:42.37,0:25:43.83,Default,,0,0,0,,Рахмет
Dialogue: 0,0:25:45.87,0:25:47.71,Default,,0,0,0,,Пэм мен Скорпион?
Dialogue: 0,0:25:47.79,0:25:49.92,Default,,0,0,0,,Джей Бұл жастық ше?
Dialogue: 0,0:25:50.00,0:25:53.00,Default,,0,0,0,,Джейдің отбасы, сіз кімсіз?
Dialogue: 0,0:25:54.17,0:25:55.38,Default,,0,0,0,,Мен қиындыққа тап болдым.
Dialogue: 0,0:26:41.59,0:26:42.60,Default,,0,0,0,,Жапон субтитрлері Нагиса Исозаки
Dialogue: 0,0:26:44.10,0:26:50.10,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
