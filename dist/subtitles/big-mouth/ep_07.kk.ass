Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.00,0:00:08.25,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:30.94,0:00:31.65,Default,,0,0,0,,Сәлем
Dialogue: 0,0:00:31.74,0:00:32.78,Default,,0,0,0,,Сәлем
Dialogue: 0,0:00:32.86,0:00:34.32,Default,,0,0,0,,Бұл...
Dialogue: 0,0:00:34.65,0:00:36.49,Default,,0,0,0,,Оны қолдануға болатын сияқты.
Dialogue: 0,0:00:42.79,0:00:46.67,Default,,0,0,0,,Сіздің арқаңызда мен құтқарылдым. Мен өз шегімде болдым.
Dialogue: 0,0:00:46.75,0:00:48.92,Default,,0,0,0,,Көзіңді жұмсаң да солай
Dialogue: 0,0:00:49.34,0:00:50.75,Default,,0,0,0,,Жарай ма?
Dialogue: 0,0:00:50.84,0:00:53.80,Default,,0,0,0,,Хмм, тағы бір дем.
Dialogue: 0,0:00:53.88,0:00:55.47,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:56.47,0:00:58.18,Default,,0,0,0,,Біз бірге бардық
Dialogue: 0,0:01:06.90,0:01:08.48,Default,,0,0,0,,Ал өмір туады
Dialogue: 0,0:01:08.56,0:01:12.07,Default,,0,0,0,,Шетелдіктер Жермен жыныстық қатынасқа түскендіктен бе?
Dialogue: 0,0:01:12.15,0:01:14.19,Default,,0,0,0,,Саентология?
Dialogue: 0,0:01:14.28,0:01:16.65,Default,,0,0,0,,Олар таң қаларлықтай дұрыс.
Dialogue: 0,0:01:49.90,0:01:50.69,Default,,0,0,0,,"Ғылым көрмесі? Бұл әділ емес."
Dialogue: 0,0:01:50.69,0:01:51.11,Default,,0,0,0,,«Ғылым көрмесі? Бұл әділ емес» Келесі аптадағы ғылыми көрме үшін -
Dialogue: 0,0:01:51.11,0:01:52.52,Default,,0,0,0,,Келесі аптадағы ғылыми көрме үшін-
Dialogue: 0,0:01:52.61,0:01:55.69,Default,,0,0,0,,Барлықтарыңыз, зерттеуіңізді жасаңыз
Dialogue: 0,0:01:55.78,0:01:57.07,Default,,0,0,0,,Біз қайтадан топтасамыз ба?
Dialogue: 0,0:01:57.15,0:01:58.82,Default,,0,0,0,,Сіз А, ал мен С?
Dialogue: 0,0:01:58.91,0:02:00.91,Default,,0,0,0,,Мен В бағасын алдым.
Dialogue: 0,0:02:01.12,0:02:02.20,Default,,0,0,0,,Егер мен бұны қазір айтпасам, кейін қарама-қайшылықтар туындауы мүмкін.
Dialogue: 0,0:02:02.28,0:02:03.58,Default,,0,0,0,,Гутуч
Dialogue: 0,0:02:04.08,0:02:09.50,Default,,0,0,0,,Биыл бюджет қысқартылды, сондықтан үш адамнан топ болып жұмыс істеуге тура келді.
Dialogue: 0,0:02:14.67,0:02:16.30,Default,,0,0,0,,Девин оны саған бермейді!
Dialogue: 0,0:02:20.39,0:02:21.80,Default,,0,0,0,,Бірге орындайық
Dialogue: 0,0:02:21.89,0:02:23.81,Default,,0,0,0,,Джессимен мүмкін емес
Dialogue: 0,0:02:23.89,0:02:27.39,Default,,0,0,0,,Мен мұны жасыра алмаймын.
Dialogue: 0,0:02:27.48,0:02:30.10,Default,,0,0,0,,Бұл ананың лесбиянка әрекеті болды ма?
Dialogue: 0,0:02:30.19,0:02:32.52,Default,,0,0,0,,Егер бұл сурет болса, мен оны сақтап қойдым.
Dialogue: 0,0:02:33.11,0:02:37.28,Default,,0,0,0,,Үшінші баланы күлдірту үшін бірге жұмыс жасайық.
Dialogue: 0,0:02:37.36,0:02:40.20,Default,,0,0,0,,Жарайды, Гогарт ше?
Dialogue: 0,0:02:41.11,0:02:44.08,Default,,0,0,0,,Өтіңіз, өйткені күлкі мені дір еткізеді
Dialogue: 0,0:02:44.16,0:02:47.20,Default,,0,0,0,,Мен жақсы көретін жігітті алғым келеді
Dialogue: 0,0:02:47.29,0:02:48.37,Default,,0,0,0,,Эндрюс!
Dialogue: 0,0:02:48.45,0:02:51.42,Default,,0,0,0,,Джей? Бұл жұмыс істемеуі мүмкін
Dialogue: 0,0:02:51.50,0:02:55.17,Default,,0,0,0,,Керемет, ақымақ және сүйкімді
Dialogue: 0,0:02:55.42,0:02:55.96,Default,,0,0,0,,Яда
Dialogue: 0,0:02:56.05,0:02:58.76,Default,,0,0,0,,Сексуалды үңгір адамына ұқсайды
Dialogue: 0,0:02:58.84,0:02:59.42,Default,,0,0,0,,Джей
Dialogue: 0,0:02:59.51,0:03:01.47,Default,,0,0,0,,Бірге топтасайық
Dialogue: 0,0:03:01.55,0:03:02.43,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:03:02.97,0:03:03.72,Default,,0,0,0,,Таңдалған
Dialogue: 0,0:03:03.80,0:03:04.76,Default,,0,0,0,,Балалар
Dialogue: 0,0:03:04.85,0:03:06.01,Default,,0,0,0,,Сіз менімен бірлесе алмайсыз.
Dialogue: 0,0:03:06.10,0:03:08.52,Default,,0,0,0,,Шайқас осында
Dialogue: 0,0:03:08.60,0:03:09.81,Default,,0,0,0,,Керемет
Dialogue: 0,0:03:09.89,0:03:12.27,Default,,0,0,0,,Джесси мен Джей алынды.
Dialogue: 0,0:03:13.27,0:03:14.77,Default,,0,0,0,,Мисси осында
Dialogue: 0,0:03:14.86,0:03:16.27,Default,,0,0,0,,Біз топтасамыз ба?
Dialogue: 0,0:03:16.36,0:03:17.28,Default,,0,0,0,,Бір ай бойы бірдей нәрсені естіп жүрсең, ештеңе сезбей қаласың.
Dialogue: 0,0:03:17.36,0:03:18.53,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:03:18.61,0:03:19.69,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:03:19.78,0:03:23.74,Default,,0,0,0,,Егер сіз жұмсақ болсаңыз, оны оңай жарып жібере аласыз.
Dialogue: 0,0:03:23.82,0:03:24.74,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:03:24.82,0:03:29.91,Default,,0,0,0,,Екінші жағынан, егер сіз тым қобалжысаңыз, ұрықтың орнына құсу пайда болуы мүмкін.
Dialogue: 0,0:03:30.00,0:03:31.66,Default,,0,0,0,,Екеуі де сергітеді
Dialogue: 0,0:03:31.75,0:03:32.37,Default,,0,0,0,,Эндрю
Dialogue: 0,0:03:32.46,0:03:33.58,Default,,0,0,0,,Мисси…
Dialogue: 0,0:03:35.17,0:03:36.00,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:03:36.09,0:03:38.34,Default,,0,0,0,,Рахмет, мен оны асыға күтемін...
Dialogue: 0,0:03:39.46,0:03:40.92,Default,,0,0,0,,Мен құсып кете жаздадым
Dialogue: 0,0:03:41.01,0:03:44.30,Default,,0,0,0,,Мен қатты толқыған болуым керек.
Dialogue: 0,0:03:44.39,0:03:47.81,Default,,0,0,0,,Өйткені біз бірге ғылыми зерттеулер жасай аламыз
Dialogue: 0,0:03:47.89,0:03:50.85,Default,,0,0,0,,Девиннен аулақ болыңыз
Dialogue: 0,0:03:53.23,0:03:57.19,Default,,0,0,0,,Сіз кеше «Сейнфельдті» көрдіңіз бе?
Dialogue: 0,0:03:57.27,0:03:58.69,Default,,0,0,0,,Баяғыда бітті
Dialogue: 0,0:03:58.78,0:04:02.45,Default,,0,0,0,,Мен WGN арқылы қайта бастадым.
Dialogue: 0,0:04:02.53,0:04:04.24,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:04:04.32,0:04:08.20,Default,,0,0,0,,Кофе тым ыстық болғандықтан сотқа шағымдану оқиғасы
Dialogue: 0,0:04:08.28,0:04:10.16,Default,,0,0,0,,Мен бұл тым көп деп ойладым, бірақ...
Dialogue: 0,0:04:10.25,0:04:11.83,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:04:11.91,0:04:15.00,Default,,0,0,0,,Кофе туралы айтатын болсақ, бұл Санка.
Dialogue: 0,0:04:15.08,0:04:16.17,Default,,0,0,0,,Мен Кеуригпін
Dialogue: 0,0:04:16.25,0:04:19.30,Default,,0,0,0,,Бұл туралы сөйлесетін сияқтымыз.
Dialogue: 0,0:04:19.38,0:04:23.30,Default,,0,0,0,,Кеуриг айту қиын
Dialogue: 0,0:04:23.38,0:04:25.09,Default,,0,0,0,,Содан кейін K кесе
Dialogue: 0,0:04:25.18,0:04:29.97,Default,,0,0,0,,О, сіз мұны тағы да айттыңыз, тікелей маған «К кубогы»
Dialogue: 0,0:04:30.06,0:04:35.06,Default,,0,0,0,,Кеуриг жігерлендірді
Dialogue: 0,0:04:35.14,0:04:36.73,Default,,0,0,0,,Жақсы болды.
Dialogue: 0,0:04:36.81,0:04:39.11,Default,,0,0,0,,Маған ғылыми көрмеге көмектесе аласыз ба?
Dialogue: 0,0:04:39.19,0:04:41.73,Default,,0,0,0,,Iitomo «тіркеу» дегенді білдіреді
Dialogue: 0,0:04:41.82,0:04:44.32,Default,,0,0,0,,Басқаша айтқанда, «маған жаз»
Dialogue: 0,0:04:44.40,0:04:45.70,Default,,0,0,0,,Басқаша айтқанда, «оқылмайды»
Dialogue: 0,0:04:45.78,0:04:47.24,Default,,0,0,0,,Мен саған көмектесемін
Dialogue: 0,0:04:47.32,0:04:48.99,Default,,0,0,0,,Ал...
Dialogue: 0,0:04:49.28,0:04:50.54,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:04:51.58,0:04:54.83,Default,,0,0,0,,Менен бірінші рет жақсысың ба деп сұрады.
Dialogue: 0,0:04:54.91,0:04:56.62,Default,,0,0,0,,Спойлер туралы ескерту
Dialogue: 0,0:04:56.71,0:04:58.79,Default,,0,0,0,,Мен көмектесуге қуаныштымын, бірақ-
Dialogue: 0,0:04:58.88,0:05:03.97,Default,,0,0,0,,Оны жай көрме емес, тамаша ғылыми көрмеге айналдырайық.
Dialogue: 0,0:05:04.05,0:05:05.43,Default,,0,0,0,,Қызықты адам.
Dialogue: 0,0:05:07.01,0:05:09.35,Default,,0,0,0,,Кешіріңіз, бұл Санка.
Dialogue: 0,0:05:09.43,0:05:11.35,Default,,0,0,0,,Ер адамдар арасындағы адам.
Dialogue: 0,0:05:11.43,0:05:14.43,Default,,0,0,0,,Дұрыс, бұл Гормон-кун.
Dialogue: 0,0:05:14.52,0:05:16.77,Default,,0,0,0,,Құсықты жемейсің бе?
Dialogue: 0,0:05:18.19,0:05:22.03,Default,,0,0,0,,«Үш нүктелік ғылым» туралы не деуге болады?
Dialogue: 0,0:05:22.11,0:05:24.44,Default,,0,0,0,,Біз баскетбол ойнаймыз, сіз статистиканы жүргізесіз.
Dialogue: 0,0:05:24.53,0:05:28.28,Default,,0,0,0,,Оның балдыркөк жеп жатқанын көргенде шыдай алмаймын
Dialogue: 0,0:05:28.36,0:05:29.57,Default,,0,0,0,,Сіз де жеуіңіз керек.
Dialogue: 0,0:05:29.66,0:05:33.37,Default,,0,0,0,,Жүр, әкем толтырған тарақтарды жұт.
Dialogue: 0,0:05:33.45,0:05:37.33,Default,,0,0,0,,Қорқынышты Мен ұялғаным сонша, оны жей алмаймын
Dialogue: 0,0:05:37.42,0:05:41.79,Default,,0,0,0,,Йеллоустоун кальдерасының моделі туралы не деуге болады?
Dialogue: 0,0:05:41.88,0:05:43.92,Default,,0,0,0,,Ол атқылап кетсе, жанартау күлі...
Dialogue: 0,0:05:44.01,0:05:47.26,Default,,0,0,0,,Егістік жерлер қирап, өзендер бөгеттелген.
Dialogue: 0,0:05:47.34,0:05:48.38,Default,,0,0,0,,Үлкен апат орын алды
Dialogue: 0,0:05:48.47,0:05:50.14,Default,,0,0,0,,Мен сізге сілтеме жіберемін
Dialogue: 0,0:05:50.22,0:05:52.10,Default,,0,0,0,,Маған қатты ұнады
Dialogue: 0,0:05:52.18,0:05:56.35,Default,,0,0,0,,Баскетбол және үлкен жанартау, екі нұсқа бар ма?
Dialogue: 0,0:05:56.43,0:05:58.64,Default,,0,0,0,,Кім үлкен жанартауларды жақтайды?
Dialogue: 0,0:05:58.73,0:05:59.90,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:59.98,0:06:03.69,Default,,0,0,0,,Оның 2-ден 1-ге тең болғанына көмектесу мүмкін емес.
Dialogue: 0,0:06:04.53,0:06:08.20,Default,,0,0,0,,Жарайды, Нохинаши, менімен бара аласың ба?
Dialogue: 0,0:06:08.28,0:06:10.49,Default,,0,0,0,,Джесси ше?
Dialogue: 0,0:06:10.57,0:06:13.37,Default,,0,0,0,,Маған екі жұп іш киім кигеніңізді айтыңызшы.
Dialogue: 0,0:06:13.45,0:06:16.37,Default,,0,0,0,,Жарайды, онда таң қалмаңыз.
Dialogue: 0,0:06:16.45,0:06:20.37,Default,,0,0,0,,Зерттеу тақырыбы «Телекинетикалық қозғалыстың сиқыры»
Dialogue: 0,0:06:21.29,0:06:26.80,Default,,0,0,0,,Сиқыр мен ғылымды шатастыру ең жақсы жағдайда проблемалық
Dialogue: 0,0:06:26.92,0:06:29.51,Default,,0,0,0,,Хабарландырулар жасауда жақсы емеспіз.
Dialogue: 0,0:06:29.59,0:06:32.05,Default,,0,0,0,,Мен мұны істеймін, мен мұны істеймін.
Dialogue: 0,0:06:32.18,0:06:33.55,Default,,0,0,0,,(Экипаж мүшесі 1) Жұмысты жалғастырып, қазынаны көрсекші.
Dialogue: 0,0:06:33.64,0:06:36.72,Default,,0,0,0,,Күнделікті күнделікті киім жеткілікті, солай ма?
Dialogue: 0,0:06:36.81,0:06:39.19,Default,,0,0,0,,Оны жарқыратып көрейік
Dialogue: 0,0:06:39.27,0:06:45.07,Default,,0,0,0,,Біз жилет пен ақсақ жейде киеміз, ал Джесси тар мини киеді.
Dialogue: 0,0:06:45.15,0:06:49.32,Default,,0,0,0,,Мэтьюге де мини ұнайды ма? Сіз трансгендерсіз бе?
Dialogue: 0,0:06:49.40,0:06:52.28,Default,,0,0,0,,Бұл геймен бірдей, дұрыс түсініңіз.
Dialogue: 0,0:06:52.37,0:06:52.91,Default,,0,0,0,,Жарайды
Dialogue: 0,0:06:52.99,0:06:56.70,Default,,0,0,0,,Шынайы мәселелерді ойламасаң, қиыншылыққа тап боласың.
Dialogue: 0,0:06:56.79,0:07:02.50,Default,,0,0,0,,Дүрбелеңнің қажеті жоқ, ингредиенттер дәл сіздің алдыңызда.
Dialogue: 0,0:07:02.58,0:07:05.09,Default,,0,0,0,,Деректі фильм түсіру
Dialogue: 0,0:07:05.17,0:07:10.09,Default,,0,0,0,,«Алдану және қиял: сиқыршы баланың жалғыз әлемі»
Dialogue: 0,0:07:12.34,0:07:13.39,Default,,0,0,0,,Мисси деген не?
Dialogue: 0,0:07:14.14,0:07:15.26,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:07:15.35,0:07:17.52,Default,,0,0,0,,Менің сиқырымды жалай бергің келеді, солай ма?
Dialogue: 0,0:07:17.60,0:07:18.14,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:07:18.22,0:07:20.10,Default,,0,0,0,,Мен ол қызды жақсы көрсем де
Dialogue: 0,0:07:20.18,0:07:21.69,Default,,0,0,0,,Маған ұнайды деп айтудың орнына...
Dialogue: 0,0:07:21.77,0:07:24.77,Default,,0,0,0,,Басымнан шығара алмай, құлағым ыстық...
Dialogue: 0,0:07:24.86,0:07:28.23,Default,,0,0,0,,Дик те, солай ма? Мүмкін сізде қызба бар
Dialogue: 0,0:07:28.32,0:07:30.49,Default,,0,0,0,,Термометрді салыңыз.
Dialogue: 0,0:07:30.86,0:07:32.03,Default,,0,0,0,,Ауырсынатын көрінеді
Dialogue: 0,0:07:32.11,0:07:33.45,Default,,0,0,0,,Егер сіз мені кездесуге шақырсаңыз
Dialogue: 0,0:07:33.53,0:07:36.28,Default,,0,0,0,,Мүлдем жоқ! Егер сіз бас тартсаңыз не істейсіз?
Dialogue: 0,0:07:36.37,0:07:37.45,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:07:37.54,0:07:39.79,Default,,0,0,0,,Одан да сорақысы, Ник.
Dialogue: 0,0:07:39.87,0:07:43.75,Default,,0,0,0,,Сырымды айтсам, ажырасамыз.
Dialogue: 0,0:07:43.96,0:07:48.84,Default,,0,0,0,,Экзема үшін сүт ваннасын қабылдағаныңызды бәрі біледі.
Dialogue: 0,0:07:48.92,0:07:50.34,Default,,0,0,0,,Мен оны анық айтамын
Dialogue: 0,0:07:50.42,0:07:50.97,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:07:51.05,0:07:53.93,Default,,0,0,0,,Мұндай мүмкіндіктер сирек кездеседі.
Dialogue: 0,0:07:54.01,0:07:58.85,Default,,0,0,0,,Ұнату сирек, сондықтан ол сізді айналып өтпесін?
Dialogue: 0,0:07:58.93,0:07:59.56,Default,,0,0,0,,дұрыс болуы мүмкін
Dialogue: 0,0:07:59.64,0:08:02.77,Default,,0,0,0,,Эндрю, түсіндіруге рұқсат етіңіз.
Dialogue: 0,0:08:02.85,0:08:04.15,Default,,0,0,0,,Баскетбол мысалы
Dialogue: 0,0:08:04.23,0:08:08.07,Default,,0,0,0,,Алдымен, негізгі дос қызды (күн) өткізіңіз
Dialogue: 0,0:08:08.15,0:08:11.74,Default,,0,0,0,,Ол айналдырғанда (Жарайды), сек аяқталды.
Dialogue: 0,0:08:11.82,0:08:13.36,Default,,0,0,0,,Мен соншалықты алысқа бара алмаймын.
Dialogue: 0,0:08:13.45,0:08:15.78,Default,,0,0,0,,Оның жүріп жатқанын көргіңіз келе ме? Күте тұрыңыз
Dialogue: 0,0:08:18.91,0:08:20.29,Default,,0,0,0,,«Терезеге тас түсті»
Dialogue: 0,0:08:20.37,0:08:21.50,Default,,0,0,0,,«Шығу»
Dialogue: 0,0:08:21.58,0:08:22.50,Default,,0,0,0,,«Мен қазір сырттамын».
Dialogue: 0,0:08:23.87,0:08:27.29,Default,,0,0,0,,Сіз не істеп жатырсыз? Сағат 9-ға таяп қалды
Dialogue: 0,0:08:27.38,0:08:28.38,Default,,0,0,0,,Мен ұйықтай алмаймын
Dialogue: 0,0:08:28.46,0:08:29.21,Default,,0,0,0,,Мен де
Dialogue: 0,0:08:29.30,0:08:31.42,Default,,0,0,0,,Егер кальдера атқылап кетсе -
Dialogue: 0,0:08:31.51,0:08:35.43,Default,,0,0,0,,Эжекциядан өзімізді қалай қорғай аламыз?
Dialogue: 0,0:08:35.51,0:08:36.43,Default,,0,0,0,,«Шығару»?
Dialogue: 0,0:08:36.51,0:08:38.72,Default,,0,0,0,,Мен мұны қалаймын, иығыңды шығар.
Dialogue: 0,0:08:38.80,0:08:40.22,Default,,0,0,0,,Өтінемін, үндемеңіз
Dialogue: 0,0:08:40.31,0:08:42.14,Default,,0,0,0,,Онда мен саған өзімді беремін.
Dialogue: 0,0:08:42.68,0:08:47.02,Default,,0,0,0,,Сен ең жақсысың, мен сенімен бірге болудан ләззат аламын.
Dialogue: 0,0:08:47.10,0:08:47.86,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:08:47.94,0:08:54.24,Default,,0,0,0,,Шынымен, қарсы болмасаң, менің қызым бола аласың ба?
Dialogue: 0,0:08:55.82,0:08:56.74,Default,,0,0,0,,«Иә»?
Dialogue: 0,0:08:56.82,0:08:58.82,Default,,0,0,0,,Иә, мен өте қуаныштымын.
Dialogue: 0,0:08:59.58,0:09:01.83,Default,,0,0,0,,Сіз қиын болғанын сездіңіз бе?
Dialogue: 0,0:09:01.91,0:09:03.25,Default,,0,0,0,,Бұл жер сілкінісі ме?
Dialogue: 0,0:09:03.33,0:09:06.17,Default,,0,0,0,,Жоқ, біз осылай сезінеміз.
Dialogue: 0,0:09:06.75,0:09:10.09,Default,,0,0,0,,Сенімен жүргенде денем дірілдейді
Dialogue: 0,0:09:10.17,0:09:13.42,Default,,0,0,0,,Ішек – жүрек сияқты.
Dialogue: 0,0:09:13.51,0:09:14.09,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:09:14.17,0:09:17.64,Default,,0,0,0,,Денем дірілдеп тұр
Dialogue: 0,0:09:17.72,0:09:23.43,Default,,0,0,0,,Кішкентай гүл сияқты, нәзік, нәзік
Dialogue: 0,0:09:24.60,0:09:26.73,Default,,0,0,0,,Бұл қандай сезім?
Dialogue: 0,0:09:26.81,0:09:30.40,Default,,0,0,0,,Менің ішкі мүшелерім бұралып, тырысады.
Dialogue: 0,0:09:30.48,0:09:36.65,Default,,0,0,0,,Сені көрген сайын шалбарым дірілдегендей болады
Dialogue: 0,0:09:37.86,0:09:40.12,Default,,0,0,0,,Қандай қорқынышты сезім
Dialogue: 0,0:09:40.83,0:09:45.20,Default,,0,0,0,,Бұл махаббат болуы керек
Dialogue: 0,0:09:45.29,0:09:48.71,Default,,0,0,0,,Мен күйзелістен ауырдым
Dialogue: 0,0:09:48.79,0:09:52.55,Default,,0,0,0,,Мен газға толып кеттім
Dialogue: 0,0:09:52.71,0:09:55.63,Default,,0,0,0,,Жарылып кетейін деп тұрған сияқты.
Dialogue: 0,0:09:55.72,0:10:02.64,Default,,0,0,0,,Себебі мен ғашықпын
Dialogue: 0,0:10:03.72,0:10:06.14,Default,,0,0,0,,Ертең мектепте кездескенше.
Dialogue: 0,0:10:06.23,0:10:07.89,Default,,0,0,0,,Мен ертең демалуым керек
Dialogue: 0,0:10:09.31,0:10:10.44,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:10:10.52,0:10:11.98,Default,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,0:10:12.32,0:10:15.57,Default,,0,0,0,,Ия, сенің қызың бар, солай ма?
Dialogue: 0,0:10:15.65,0:10:18.20,Default,,0,0,0,,Бұл рас, мен дем ала алмаймын.
Dialogue: 0,0:10:18.28,0:10:19.86,Default,,0,0,0,,Осыны ішке тарт
Dialogue: 0,0:10:20.87,0:10:22.12,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:10:22.20,0:10:24.95,Default,,0,0,0,,Менің сэндвичім мен тунец
Dialogue: 0,0:10:25.04,0:10:25.87,Default,,0,0,0,,«Лаура үшін қан тапсыру»
Dialogue: 0,0:10:25.87,0:10:26.45,Default,,0,0,0,,«Лаура үшін қан тапсыру»
Dialogue: 0,0:10:25.87,0:10:26.45,Default,,0,0,0,,Стив
Dialogue: 0,0:10:26.54,0:10:28.25,Default,,0,0,0,,Әріптерді үйренейік
Dialogue: 0,0:10:28.33,0:10:30.33,Default,,0,0,0,,Мен ән айта аламын
Dialogue: 0,0:10:30.42,0:10:33.67,Default,,0,0,0,,Шатырдағы семіз жарты ай
Dialogue: 0,0:10:33.75,0:10:36.42,Default,,0,0,0,,Тағы бір май тарақ
Dialogue: 0,0:10:37.76,0:10:39.05,Default,,0,0,0,,Бұл ән
Dialogue: 0,0:10:39.13,0:10:43.47,Default,,0,0,0,,Бүйрек алғыңыз келсе ше?
Dialogue: 0,0:10:43.55,0:10:45.35,Default,,0,0,0,,Мен бұрын талай рет алдандым.
Dialogue: 0,0:10:45.43,0:10:49.19,Default,,0,0,0,,Ол менің ағама ұқсайды. Өйткені ол ерекше адам.
Dialogue: 0,0:10:49.27,0:10:50.65,Default,,0,0,0,,Мен ерекшемін бе?
Dialogue: 0,0:10:50.73,0:10:53.73,Default,,0,0,0,,Еркексің, бүйрегін бер.
Dialogue: 0,0:10:54.57,0:10:57.49,Default,,0,0,0,,«Махаббат» сөзін қалай жазу керектігін айта аласыз ба?
Dialogue: 0,0:10:57.94,0:11:02.53,Default,,0,0,0,,«Махаббат» Л О В Е
Dialogue: 0,0:11:02.95,0:11:06.95,Default,,0,0,0,,Хоккей таяқшасының дақтары Қағаз кеседегі тарақ
Dialogue: 0,0:11:07.04,0:11:09.04,Default,,0,0,0,,Уау, сіз тез жақсарып жатырсыз.
Dialogue: 0,0:11:09.12,0:11:11.96,Default,,0,0,0,,Мен сені сүйемін, мен саған ғашықпын
Dialogue: 0,0:11:12.04,0:11:15.25,Default,,0,0,0,,Мен де сені жақсы көретініме қуаныштымын
Dialogue: 0,0:11:15.34,0:11:19.30,Default,,0,0,0,,Мен пиццаны жақсы көремін. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:11:23.34,0:11:25.26,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:11:25.35,0:11:27.10,Default,,0,0,0,,Мен үрейленіп тұрмын.
Dialogue: 0,0:11:27.18,0:11:31.31,Default,,0,0,0,,Миссиге қарасам, жүрегім кеудемнен секіріп кететіндей болады.
Dialogue: 0,0:11:31.39,0:11:35.56,Default,,0,0,0,,Дәрігер ретінде мен онымен сөйлескенім дұрыс деп айтамын.
Dialogue: 0,0:11:35.65,0:11:37.11,Default,,0,0,0,,Ақыр соңында?
Dialogue: 0,0:11:37.19,0:11:40.44,Default,,0,0,0,,Менің тілім ісіп кетті. Мені ауыстырыңызшы.
Dialogue: 0,0:11:40.53,0:11:42.07,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:11:42.78,0:11:45.95,Default,,0,0,0,,Эндрю қайырлы таң деді.
Dialogue: 0,0:11:46.03,0:11:47.28,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:11:47.37,0:11:50.29,Default,,0,0,0,,Менің тілім қандай да бір себептермен ісініп кетті.
Dialogue: 0,0:11:51.33,0:11:56.79,Default,,0,0,0,,Бүгін кешке ата-анаммен бірге ғылыми мұражайға барғың келе ме?
Dialogue: 0,0:11:57.00,0:12:00.01,Default,,0,0,0,,Сіз мені жаңа ғана кездесуге шақырдыңыз. Сіздің жауабыңыз қандай?
Dialogue: 0,0:12:00.09,0:12:01.34,Default,,0,0,0,,Жарайды
Dialogue: 0,0:12:01.42,0:12:04.68,Default,,0,0,0,,Менің құлыным жолға түсті, иә деп айт
Dialogue: 0,0:12:04.76,0:12:07.26,Default,,0,0,0,,Жанартау туралы фильм көру...
Dialogue: 0,0:12:07.35,0:12:10.27,Default,,0,0,0,,Жарайды, қуана барамын.
Dialogue: 0,0:12:10.98,0:12:15.69,Default,,0,0,0,,Мен мұндай пікірді күтпеймін, бірақ зерттеуімізге тоқталайық.
Dialogue: 0,0:12:16.11,0:12:18.40,Default,,0,0,0,,Бұл менің иісім емес.
Dialogue: 0,0:12:19.40,0:12:22.78,Default,,0,0,0,,Кездесулерге барғанда қобалжыймын.
Dialogue: 0,0:12:22.86,0:12:24.32,Default,,0,0,0,,Жақсырақ жол бар
Dialogue: 0,0:12:24.41,0:12:25.66,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:25.74,0:12:31.04,Default,,0,0,0,,Бұл менің құрбыммен өткізілетін виртуалды жаттығу.
Dialogue: 0,0:12:31.12,0:12:32.96,Default,,0,0,0,,Жақсы болуы мүмкін
Dialogue: 0,0:12:37.42,0:12:40.25,Default,,0,0,0,,Эндрю Менің не істегенімді қалайсыз?
Dialogue: 0,0:12:41.17,0:12:44.01,Default,,0,0,0,,Денеме күннен қорғайтын крем жаққым келеді
Dialogue: 0,0:12:44.09,0:12:45.34,Default,,0,0,0,,Мені ылғалдандырыңыз
Dialogue: 0,0:12:47.43,0:12:48.55,Default,,0,0,0,,Әрі қарай не болады?
Dialogue: 0,0:12:48.64,0:12:51.81,Default,,0,0,0,,Сол кездегідей бірге ұйықтағыларың келе ме?
Dialogue: 0,0:12:51.89,0:12:55.56,Default,,0,0,0,,Мен күннен қорғайтын крем жақтым, сондықтан құм алуым мүмкін.
Dialogue: 0,0:12:55.64,0:12:58.02,Default,,0,0,0,,Мазасыз болмаңыз
Dialogue: 0,0:12:58.77,0:12:59.94,Default,,0,0,0,,Маған беріңіз
Dialogue: 0,0:13:00.02,0:13:02.44,Default,,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:13:02.99,0:13:03.90,Default,,0,0,0,,Оңтүстік аймақтардың бас қолбасшысы Доти Пиксис
Dialogue: 0,0:13:03.99,0:13:07.41,Default,,0,0,0,,Бұл менің құрбым болса да, мен қателескендей сезінемін.
Dialogue: 0,0:13:07.49,0:13:09.70,Default,,0,0,0,,Екі адамның қарым-қатынасын ластайтын сияқты.
Dialogue: 0,0:13:09.78,0:13:12.45,Default,,0,0,0,,Олай болса, басына оралайық.
Dialogue: 0,0:13:12.54,0:13:14.29,Default,,0,0,0,,Ең алдымен әзіл
Dialogue: 0,0:13:14.37,0:13:17.17,Default,,0,0,0,,Ал екі түрлі қолдануға болатын сары май
Dialogue: 0,0:13:17.25,0:13:18.08,Default,,0,0,0,,Иә...
Dialogue: 0,0:13:18.17,0:13:20.50,Default,,0,0,0,,Сіз мұны пайдалана алмайсыз.
Dialogue: 0,0:13:20.59,0:13:23.46,Default,,0,0,0,,Оның Нетамен қарым-қатынасы бар сияқты.
Dialogue: 0,0:13:23.55,0:13:28.59,Default,,0,0,0,,Сонда сіз Миссимен немесе басқа біреумен жасай алмайсыз ба?
Dialogue: 0,0:13:28.72,0:13:30.05,Default,,0,0,0,,Бұл кім болуы керек?
Dialogue: 0,0:13:30.14,0:13:32.89,Default,,0,0,0,,Онда ешкім жоқ. Мастурбация тоқтатылды.
Dialogue: 0,0:13:34.64,0:13:36.64,Default,,0,0,0,,Сіз мастурбация жасамайсыз, солай ма?
Dialogue: 0,0:13:36.73,0:13:40.06,Default,,0,0,0,,Камера қайда орналасқан? Бұл еркелік камера ма?
Dialogue: 0,0:13:40.15,0:13:41.57,Default,,0,0,0,,Хост қайда?
Dialogue: 0,0:13:41.65,0:13:46.15,Default,,0,0,0,,Мен байсалдымын. Мен бұдан былай мастурбация жасамаймын.
Dialogue: 0,0:13:46.28,0:13:49.82,Default,,0,0,0,,Кешіріңіз, мен кездесуге дайындаламын.
Dialogue: 0,0:13:49.91,0:13:51.83,Default,,0,0,0,,Мен соңғы рет 36 сағат бұрын мастурбация жасадым.
Dialogue: 0,0:13:51.83,0:13:52.79,Default,,0,0,0,,Мен соңғы рет 36 сағат бұрын мастурбация жасадым.
Dialogue: 0,0:13:51.83,0:13:52.79,Default,,0,0,0,,«Өткен уақыт»
Dialogue: 0,0:13:52.79,0:13:52.87,Default,,0,0,0,,«Өткен уақыт»
Dialogue: 0,0:13:52.87,0:13:54.12,Default,,0,0,0,,«Өткен уақыт»
Dialogue: 0,0:13:52.87,0:13:54.12,Default,,0,0,0,,(Жігіт) Соққыдан қалған көгерулерді жасыруға да жақсы тәсіл.
Dialogue: 0,0:13:54.20,0:13:56.91,Default,,0,0,0,,Жарылғалы тұрған жоқ па?
Dialogue: 0,0:13:58.50,0:13:59.83,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:13:59.92,0:14:01.75,Default,,0,0,0,,Ол Эндрюге
Dialogue: 0,0:14:01.84,0:14:04.67,Default,,0,0,0,,Алғашқы махаббатым Беккиді ұмыта алмаймын
Dialogue: 0,0:14:04.76,0:14:07.68,Default,,0,0,0,,Сенің бетіңнен сүйсем, сен мені тірліктен тептің.
Dialogue: 0,0:14:07.76,0:14:11.39,Default,,0,0,0,,Ісінген витальдардан да ауыр нәрсе болды.
Dialogue: 0,0:14:11.47,0:14:12.35,Default,,0,0,0,,Жүрек?
Dialogue: 0,0:14:12.43,0:14:15.89,Default,,0,0,0,,Бұл менің уретриям. Маған операция жасалды, себебі ол жаншып кетті.
Dialogue: 0,0:14:15.98,0:14:18.31,Default,,0,0,0,,Бірақ бұл балада ешқандай проблема жоқ.
Dialogue: 0,0:14:18.39,0:14:21.31,Default,,0,0,0,,Ол жақсы жігіт болар еді
Dialogue: 0,0:14:21.40,0:14:23.69,Default,,0,0,0,,Ол жақсы тақырып сияқты.
Dialogue: 0,0:14:23.77,0:14:26.24,Default,,0,0,0,,Сіз қызғаншақсыз ба, Ник?
Dialogue: 0,0:14:26.32,0:14:30.57,Default,,0,0,0,,Мен тіпті күнді реттедім.
Dialogue: 0,0:14:30.66,0:14:32.32,Default,,0,0,0,,Бірақ мен ата-анаммен біргемін
Dialogue: 0,0:14:32.41,0:14:34.74,Default,,0,0,0,,Бұл ең жақсы 3P емес пе?
Dialogue: 0,0:14:34.83,0:14:35.37,Default,,0,0,0,,Иә
Dialogue: 0,0:14:35.45,0:14:39.00,Default,,0,0,0,,Менің ұлым болмаса да, мен шығамын.
Dialogue: 0,0:14:39.08,0:14:41.04,Default,,0,0,0,,12 жасар бала бар ма?
Dialogue: 0,0:14:41.13,0:14:43.59,Default,,0,0,0,,Сен ең жақсы болсаң
Dialogue: 0,0:14:43.67,0:14:45.17,Default,,0,0,0,,«Дарвинді ашу орталығы»
Dialogue: 0,0:14:45.67,0:14:48.55,Default,,0,0,0,,Керемет! Бұл үштік оқиға
Dialogue: 0,0:14:48.63,0:14:52.89,Default,,0,0,0,,Ата-анаммен, ғылыми мұражаймен және қызыммен бірге шығу
Dialogue: 0,0:14:52.97,0:14:54.43,Default,,0,0,0,,Сіз тым көп сөйледіңіз бе?
Dialogue: 0,0:14:54.51,0:14:58.85,Default,,0,0,0,,Мен саған кептірілген папайя бердім, сен биікте ұшып бара жатырсың.
Dialogue: 0,0:14:58.93,0:15:02.44,Default,,0,0,0,,Бұл олай емес, маған біреу ұнағандықтан (тәтті)
Dialogue: 0,0:15:02.52,0:15:04.23,Default,,0,0,0,,Эндрю туралы
Dialogue: 0,0:15:04.32,0:15:05.27,Default,,0,0,0,,Иә
Dialogue: 0,0:15:05.36,0:15:09.11,Default,,0,0,0,,Анам: «Өрмекшілер мені тістейді, өйткені мен тәттімін» деді.
Dialogue: 0,0:15:09.19,0:15:13.32,Default,,0,0,0,,Мұндай қажетсіз сөздерді айтпа.
Dialogue: 0,0:15:13.41,0:15:16.41,Default,,0,0,0,,Сіз маған геморроймен ауырғаныңызды айтасыз ба?
Dialogue: 0,0:15:16.49,0:15:17.33,Default,,0,0,0,,Сіз массыз ба?
Dialogue: 0,0:15:17.41,0:15:18.20,Default,,0,0,0,,Эндрю
Dialogue: 0,0:15:18.29,0:15:19.33,Default,,0,0,0,,Кірейік
Dialogue: 0,0:15:19.41,0:15:20.46,Default,,0,0,0,,Жүректе?
Dialogue: 0,0:15:20.54,0:15:22.25,Default,,0,0,0,,Сізбен?
Dialogue: 0,0:15:22.33,0:15:22.88,Default,,0,0,0,,Иә
Dialogue: 0,0:15:22.96,0:15:24.08,Default,,0,0,0,,Маюшиі енді ғана айтылған сөздердің бір ауызын да түсінбеді.
Dialogue: 0,0:15:24.17,0:15:27.09,Default,,0,0,0,,Жоқ, мені жайына қалдыр.
Dialogue: 0,0:15:27.17,0:15:30.67,Default,,0,0,0,,Мен оны толғандыратын көріністі көргім келеді.
Dialogue: 0,0:15:30.76,0:15:32.64,Default,,0,0,0,,Мықты төмендетіңіз
Dialogue: 0,0:15:32.72,0:15:37.10,Default,,0,0,0,,Жасағым келмеді, әжемді алып шықтым.
Dialogue: 0,0:15:37.18,0:15:39.10,Default,,0,0,0,,Ақ шашты кәмелетке толған әйел сиқығысы келеді
Dialogue: 0,0:15:39.89,0:15:41.64,Default,,0,0,0,,Сонда бұл мезуза.
Dialogue: 0,0:15:42.27,0:15:44.19,Default,,0,0,0,,Айқас тәрізді әсер туралы не деуге болады?
Dialogue: 0,0:15:44.27,0:15:46.98,Default,,0,0,0,,Бұл алтын шұбар...
Dialogue: 0,0:15:47.07,0:15:50.11,Default,,0,0,0,,«Мен мұны істеймін» тек мағына ретінде түсіндіріледі.
Dialogue: 0,0:15:50.19,0:15:52.28,Default,,0,0,0,,Бұл соңғы шара
Dialogue: 0,0:15:52.36,0:15:56.78,Default,,0,0,0,,Бұрынғы радиобағдарлама жүргізушісі Г.Кейлор
Dialogue: 0,0:15:56.87,0:16:00.87,Default,,0,0,0,,Рождествоның жақсы жағы - бұл жыл сайын болады.
Dialogue: 0,0:16:00.96,0:16:02.12,Default,,0,0,0,,Нөлдік жыныстық иіс
Dialogue: 0,0:16:02.21,0:16:04.25,Default,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:16:04.33,0:16:05.71,Default,,0,0,0,,Кеттік Мисси
Dialogue: 0,0:16:05.79,0:16:09.42,Default,,0,0,0,,Дыбыс шығарып, мұрын түктері арқылы тыныс алайық
Dialogue: 0,0:16:09.51,0:16:11.67,Default,,0,0,0,,Дик қашып кетеді
Dialogue: 0,0:16:11.76,0:16:13.18,Default,,0,0,0,,«Панера наны»
Dialogue: 0,0:16:13.26,0:16:17.14,Default,,0,0,0,,Менің суретімді түсіргеніңізге қуаныштымын.
Dialogue: 0,0:16:17.22,0:16:19.77,Default,,0,0,0,,Аты аңызға айналған үстел сиқыршысы.
Dialogue: 0,0:16:19.85,0:16:23.60,Default,,0,0,0,,Жақындаған сайын түсінігің азаяды
Dialogue: 0,0:16:23.77,0:16:25.48,Default,,0,0,0,,Зерттеу материалдарын өзгерту
Dialogue: 0,0:16:25.56,0:16:29.32,Default,,0,0,0,,«30 жыл бойы жыныстық қатынассыз болғаннан кейін ер адамның позасына әсері»
Dialogue: 0,0:16:29.40,0:16:31.28,Default,,0,0,0,,Осы тырнақты жабыңыз
Dialogue: 0,0:16:31.36,0:16:34.11,Default,,0,0,0,,Қанша уақыт, мүйіздей.
Dialogue: 0,0:16:34.20,0:16:39.54,Default,,0,0,0,,Оның «Ұлы Гари» деген есімі де бар.
Dialogue: 0,0:16:39.62,0:16:43.46,Default,,0,0,0,,Ал ұзын тырнақтар арфада ойнауға арналған.
Dialogue: 0,0:16:43.54,0:16:46.83,Default,,0,0,0,,Сиқырдың өзі қызық емес пе?
Dialogue: 0,0:16:47.67,0:16:50.75,Default,,0,0,0,,Қасыңда болсам, байқамай қалмаймын
Dialogue: 0,0:16:50.84,0:16:53.76,Default,,0,0,0,,Сіз Сиқырды мазақ етесіз бе?
Dialogue: 0,0:16:53.84,0:16:54.51,Default,,0,0,0,,Сіз де
Dialogue: 0,0:16:54.59,0:16:56.05,Default,,0,0,0,,Клубтың адамдары да
Dialogue: 0,0:16:56.14,0:16:59.39,Default,,0,0,0,,Неге топтастың? Зерттеу туралы не деуге болады?
Dialogue: 0,0:16:59.47,0:17:04.23,Default,,0,0,0,,«Телекинез» қолайлы зерттеу тақырыбы деп ойладыңыз ба?
Dialogue: 0,0:17:04.31,0:17:06.15,Default,,0,0,0,,Бұл адасушылық емес пе?
Dialogue: 0,0:17:06.23,0:17:10.36,Default,,0,0,0,,Бұл ғылым мен сиқырдың тоғысқан жері.
Dialogue: 0,0:17:10.44,0:17:13.32,Default,,0,0,0,,Мен сені киелі кеңістікке әкеліп, одан айырылдым.
Dialogue: 0,0:17:13.40,0:17:14.24,Default,,0,0,0,,«Панера»
Dialogue: 0,0:17:14.32,0:17:17.78,Default,,0,0,0,,Бұл ғажайып бөлме, Отанконас.
Dialogue: 0,0:17:18.20,0:17:19.24,Default,,0,0,0,,Сіз әлі түсіріп жатырсыз ба?
Dialogue: 0,0:17:19.32,0:17:20.83,Default,,0,0,0,,Бұл қымбат.
Dialogue: 0,0:17:20.91,0:17:22.08,Default,,0,0,0,,Сіздің көлігіңіз бар ма?
Dialogue: 0,0:17:22.16,0:17:25.12,Default,,0,0,0,,Сотқа анаммен бірге қатысуым керек.
Dialogue: 0,0:17:26.71,0:17:27.29,Default,,0,0,0,,Герцог
Dialogue: 0,0:17:27.37,0:17:30.88,Default,,0,0,0,,Бұл жұма түні! Эндрю есепші ше?
Dialogue: 0,0:17:30.96,0:17:32.17,Default,,0,0,0,,Тек достар
Dialogue: 0,0:17:32.92,0:17:35.30,Default,,0,0,0,,Салықтарыңызды есептеп жатырсыз ба?
Dialogue: 0,0:17:35.38,0:17:39.64,Default,,0,0,0,,Ол Миссимен кездесіп жүр, ол мені қызықтырмайды.
Dialogue: 0,0:17:39.72,0:17:42.22,Default,,0,0,0,,Бұл қызықсыз ба?
Dialogue: 0,0:17:42.31,0:17:44.73,Default,,0,0,0,,Сізде кездесуге уақыт таусылуы мүмкін
Dialogue: 0,0:17:44.81,0:17:48.65,Default,,0,0,0,,Әрине, еркектер әйелдерді қызықтырады.
Dialogue: 0,0:17:48.73,0:17:51.82,Default,,0,0,0,,Дж.(Джо) ДиМаджио мен М.Монро сияқты
Dialogue: 0,0:17:51.90,0:17:53.98,Default,,0,0,0,,Мен оған ессіз болдым.
Dialogue: 0,0:17:54.07,0:17:57.86,Default,,0,0,0,,Ортаға трусиымды жинап жаттым.
Dialogue: 0,0:17:57.95,0:18:00.28,Default,,0,0,0,,Аздап кір труси
Dialogue: 0,0:18:00.37,0:18:03.41,Default,,0,0,0,,Бұл да кішкентай трусиктер.
Dialogue: 0,0:18:04.20,0:18:07.96,Default,,0,0,0,,Маған қыздар ұнайды, бірақ мен спортпен, достармен айналысамын.
Dialogue: 0,0:18:08.04,0:18:09.12,Default,,0,0,0,,Мен де
Dialogue: 0,0:18:09.21,0:18:11.75,Default,,0,0,0,,Менде әйел, көлік және топ маңызды.
Dialogue: 0,0:18:11.84,0:18:12.96,Default,,0,0,0,,Иә, дәл солай.
Dialogue: 0,0:18:13.05,0:18:16.09,Default,,0,0,0,,Шатырдағы жалғыз екі елес
Dialogue: 0,0:18:16.17,0:18:17.30,Default,,0,0,0,,Мен өлген жоқпын
Dialogue: 0,0:18:17.38,0:18:20.34,Default,,0,0,0,,Эндрю үшін де солай.
Dialogue: 0,0:18:20.43,0:18:22.22,Default,,0,0,0,,«Үш жармалы қақпақ»
Dialogue: 0,0:18:22.30,0:18:24.31,Default,,0,0,0,,Жақсы дамыған қарынша.
Dialogue: 0,0:18:24.39,0:18:26.23,Default,,0,0,0,,Өте сау көрінеді
Dialogue: 0,0:18:26.31,0:18:27.94,Default,,0,0,0,,Тақта жоқ
Dialogue: 0,0:18:28.02,0:18:29.27,Default,,0,0,0,,Артериялық окклюзия.
Dialogue: 0,0:18:29.35,0:18:31.73,Default,,0,0,0,,Айтпақшы болдым
Dialogue: 0,0:18:32.15,0:18:34.32,Default,,0,0,0,,Екеуміз ғана болғанда қызық.
Dialogue: 0,0:18:35.36,0:18:36.53,Default,,0,0,0,,Маған кіруге рұқсат етіңіз!
Dialogue: 0,0:18:36.65,0:18:39.53,Default,,0,0,0,,Мені елемегеніңді кешірмеймін.
Dialogue: 0,0:18:39.70,0:18:41.57,Default,,0,0,0,,Екеуміз ғана болғанымызға қуаныштымын.
Dialogue: 0,0:18:41.66,0:18:45.79,Default,,0,0,0,,Мына жерді өртеп, күлін былғаймын.
Dialogue: 0,0:18:45.95,0:18:50.29,Default,,0,0,0,,Ежелден ұрық шығардық.
Dialogue: 0,0:18:50.58,0:18:52.38,Default,,0,0,0,,Екеуің де жақсысыңдар ма?
Dialogue: 0,0:18:52.46,0:18:53.42,Default,,0,0,0,,Бұл жер сілкінісі болды ма?
Dialogue: 0,0:18:53.50,0:18:56.13,Default,,0,0,0,,Әлсіз болды, уайымдамаңыз.
Dialogue: 0,0:18:56.21,0:18:58.42,Default,,0,0,0,,Егер бұл менің қылмысым болса
Dialogue: 0,0:18:58.51,0:19:01.34,Default,,0,0,0,,Менің бірінші сүйгенім бұзылды
Dialogue: 0,0:19:01.43,0:19:03.64,Default,,0,0,0,,Бұл менің кінәм емес
Dialogue: 0,0:19:03.72,0:19:06.35,Default,,0,0,0,,Мен саған ескерттім, мынаны қара.
Dialogue: 0,0:19:06.43,0:19:07.93,Default,,0,0,0,,Тек сен ғана, Хиёри-чан, осы жаққа келуге рұқсат
Dialogue: 0,0:19:08.02,0:19:11.77,Default,,0,0,0,,Мысықтар табиғатта мағынасыз нәрселер бар деп есептейді...
Dialogue: 0,0:19:11.85,0:19:14.69,Default,,0,0,0,,Бұл ауызды жабудың жалғыз жолы
Dialogue: 0,0:19:15.44,0:19:16.11,Default,,0,0,0,,Біз жарты жолды өтіп қойдық — бізді тежеме, жарай ма?
Dialogue: 0,0:19:16.19,0:19:17.44,Default,,0,0,0,,Тоқта
Dialogue: 0,0:19:17.53,0:19:20.28,Default,,0,0,0,,Кайлар, бәрін іш.
Dialogue: 0,0:19:20.36,0:19:21.78,Default,,0,0,0,,«Жасау теориясының көрмесі келесі аптада өтеді»
Dialogue: 0,0:19:22.87,0:19:23.74,Default,,0,0,0,,〝Ғылым көрмесі жалғасуда〞
Dialogue: 0,0:19:23.74,0:19:25.99,Default,,0,0,0,,〝Ғылым көрмесі жалғасуда〞
Dialogue: 0,0:19:23.74,0:19:25.99,Default,,0,0,0,,Рахмет... Сәлем Стив.
Dialogue: 0,0:19:26.08,0:19:27.58,Default,,0,0,0,,Мен киіндім
Dialogue: 0,0:19:27.66,0:19:29.08,Default,,0,0,0,,Бұл ерекше күн, солай емес пе?
Dialogue: 0,0:19:29.16,0:19:30.16,Default,,0,0,0,,Арнайы ерлер
Dialogue: 0,0:19:30.25,0:19:32.00,Default,,0,0,0,,Мен сен үшін өлтірер едім
Dialogue: 0,0:19:32.08,0:19:33.21,Default,,0,0,0,,Бұл қажет емес.
Dialogue: 0,0:19:33.29,0:19:36.50,Default,,0,0,0,,Жеңілдендім, істесем ауыртпалық.
Dialogue: 0,0:19:36.88,0:19:39.84,Default,,0,0,0,,Ғылым көрмесіне құрметті төреші болу
Dialogue: 0,0:19:39.92,0:19:43.84,Default,,0,0,0,,Мен судьямын ба? Мен мұны істеуге қуанышты боламын
Dialogue: 0,0:19:44.01,0:19:45.01,Default,,0,0,0,,Эмилия ханым, жоспар бойынша айдаһар арбасымен эвакуацияланыңыз.
Dialogue: 0,0:19:45.10,0:19:49.35,Default,,0,0,0,,Мен сені бақытты ету үшін бірдеңе істей аламын.
Dialogue: 0,0:19:49.73,0:19:51.23,Default,,0,0,0,,Стив
Dialogue: 0,0:19:51.31,0:19:53.85,Default,,0,0,0,,Сен де таптың.
Dialogue: 0,0:19:53.94,0:19:56.27,Default,,0,0,0,,Маған үйленесің бе?
Dialogue: 0,0:19:56.65,0:20:00.03,Default,,0,0,0,,Стив, бұл үлкен құрмет.
Dialogue: 0,0:20:00.40,0:20:01.99,Default,,0,0,0,,Бірақ мен тұрмысқа шыға алмаймын
Dialogue: 0,0:20:02.07,0:20:03.03,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:20:03.11,0:20:07.83,Default,,0,0,0,,Өзіңізге ұқсайтын әйелге үйлену керек.
Dialogue: 0,0:20:07.91,0:20:10.08,Default,,0,0,0,,Жүзімнен салық төлейтін әйел?
Dialogue: 0,0:20:10.16,0:20:11.50,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:20:11.58,0:20:15.00,Default,,0,0,0,,Сен менің досымсың. Кешіріңіз.
Dialogue: 0,0:20:15.08,0:20:16.21,Default,,0,0,0,,«Кешіріңіз»?
Dialogue: 0,0:20:16.34,0:20:20.71,Default,,0,0,0,,Ең бақытты адам болған соң кешірім сұраудың мәні неде?
Dialogue: 0,0:20:20.80,0:20:21.80,Default,,0,0,0,,Сіз бақыттысыз ба?
Dialogue: 0,0:20:21.88,0:20:24.22,Default,,0,0,0,,Біз дос бола аламыз, солай ма?
Dialogue: 0,0:20:24.30,0:20:28.43,Default,,0,0,0,,Мен сенбеймін, бұл ең маңызды лауазым.
Dialogue: 0,0:20:28.51,0:20:31.93,Default,,0,0,0,,Сіздің досыңыз болу үлкен мәртебе, Стив.
Dialogue: 0,0:20:32.02,0:20:33.85,Default,,0,0,0,,Ол кім?
Dialogue: 0,0:20:33.94,0:20:37.40,Default,,0,0,0,,Спойлер туралы ескерту «Ол» - Стив
Dialogue: 0,0:20:37.48,0:20:39.40,Default,,0,0,0,,«Өткен уақыт»
Dialogue: 0,0:20:40.40,0:20:40.69,Default,,0,0,0,,...
Dialogue: 0,0:20:40.69,0:20:42.40,Default,,0,0,0,,...
Dialogue: 0,0:20:40.69,0:20:42.40,Default,,0,0,0,,Бұл қарқынды болды.
Dialogue: 0,0:20:42.49,0:20:44.15,Default,,0,0,0,,Жер сілкінісі
Dialogue: 0,0:20:44.24,0:20:45.82,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:20:45.91,0:20:47.41,Default,,0,0,0,,Тағы не?
Dialogue: 0,0:20:47.49,0:20:48.49,Default,,0,0,0,,Сәлем аға
Dialogue: 0,0:20:48.58,0:20:49.28,Default,,0,0,0,,Бауырлар?
Dialogue: 0,0:20:49.37,0:20:52.20,Default,,0,0,0,,Мен қателескендіктен кешірім сұрағым келді.
Dialogue: 0,0:20:52.29,0:20:57.88,Default,,0,0,0,,Қайлардың мойнымен жыныстық қатынасқа түскенде шектен шыққан шығармын.
Dialogue: 0,0:20:58.00,0:21:00.71,Default,,0,0,0,,Мен сені енді мазаламаймын
Dialogue: 0,0:21:01.26,0:21:02.88,Default,,0,0,0,,Жақсы
Dialogue: 0,0:21:02.97,0:21:04.84,Default,,0,0,0,,Құдай Мористі жарылқасын
Dialogue: 0,0:21:04.93,0:21:06.93,Default,,0,0,0,,Құдай жарылқасын, пастор.
Dialogue: 0,0:21:07.01,0:21:09.39,Default,,0,0,0,,Оның арқасында мен өзгердім.
Dialogue: 0,0:21:10.18,0:21:14.31,Default,,0,0,0,,Жанартау атқылағанға дейінгі сұйықтық ағып жатыр.
Dialogue: 0,0:21:14.98,0:21:18.52,Default,,0,0,0,,Көңілімді тыныштандыру үшін тұрақта сусын ішуім керек пе?
Dialogue: 0,0:21:18.61,0:21:19.31,Default,,0,0,0,,«Телекинез туралы ғылым»
Dialogue: 0,0:21:19.31,0:21:20.86,Default,,0,0,0,,〝Телекинетикалық қозғалыс туралы ғылым〞
Dialogue: 0,0:21:19.31,0:21:20.86,Default,,0,0,0,,Өте қайғылы көрінеді
Dialogue: 0,0:21:20.94,0:21:21.78,Default,,0,0,0,,Шынында да «Адан және иллюзия»
Dialogue: 0,0:21:21.78,0:21:21.90,Default,,0,0,0,,«Алдану және қиял»
Dialogue: 0,0:21:21.90,0:21:23.28,Default,,0,0,0,,``Адан және қиял'' Кешіріңіз...
Dialogue: 0,0:21:23.28,0:21:23.36,Default,,0,0,0,,«Алдану және қиял»
Dialogue: 0,0:21:23.36,0:21:26.15,Default,,0,0,0,,``Адан және қиял'' Душ пердесі көгерген
Dialogue: 0,0:21:26.24,0:21:28.20,Default,,0,0,0,,Сіз Мэттпен сөйлесіп жатырсыз ба?
Dialogue: 0,0:21:28.28,0:21:31.03,Default,,0,0,0,,Жалғыз болсаң болды
Dialogue: 0,0:21:31.12,0:21:32.95,Default,,0,0,0,,Мені мұнда неге әкелдің?
Dialogue: 0,0:21:33.04,0:21:35.33,Default,,0,0,0,,Сізге жылжыту үшін бірдеңе қажет болады.
Dialogue: 0,0:21:35.41,0:21:37.75,Default,,0,0,0,,Торт фабрикасына барамын деген уәде ше?
Dialogue: 0,0:21:37.83,0:21:40.21,Default,,0,0,0,,Маған торт жеуге рұқсат етіңіз
Dialogue: 0,0:21:40.29,0:21:42.59,Default,,0,0,0,,Кратер жеткілікті ылғалды ма?
Dialogue: 0,0:21:42.67,0:21:44.42,Default,,0,0,0,,Ол жеткілікті ылғалды.
Dialogue: 0,0:21:44.51,0:21:45.30,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз
Dialogue: 0,0:21:45.38,0:21:46.88,Default,,0,0,0,,(Экипаж мүшесі 1) Жұмысты жалғастырып, қазынаны көрсекші.
Dialogue: 0,0:21:46.97,0:21:47.84,Default,,0,0,0,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,0:21:47.93,0:21:50.35,Default,,0,0,0,,Оның сөздері сексуалды
Dialogue: 0,0:21:50.43,0:21:52.72,Default,,0,0,0,,Мисси тағы да?
Dialogue: 0,0:21:53.06,0:21:54.35,Default,,0,0,0,,Басыңнан айырылдың.
Dialogue: 0,0:21:54.43,0:21:55.06,Default,,0,0,0,,Не?
Dialogue: 0,0:21:55.14,0:21:57.81,Default,,0,0,0,,Сен де трусиларыңды ортаға киіп ал.
Dialogue: 0,0:21:57.89,0:21:59.06,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:21:59.15,0:22:03.36,Default,,0,0,0,,Орталық мүмкін емес. Жарық болуы мүмкін.
Dialogue: 0,0:22:03.44,0:22:06.70,Default,,0,0,0,,Бірақ сенің менімен өткізетін уақытың жоқ
Dialogue: 0,0:22:06.78,0:22:10.49,Default,,0,0,0,,Сіз енді ғана кездесе бастадыңыз, қорықпаңыз.
Dialogue: 0,0:22:10.57,0:22:12.62,Default,,0,0,0,,Сіз қорқасыз ба? Сатқын
Dialogue: 0,0:22:12.70,0:22:14.37,Default,,0,0,0,,Сіз сатқынсыз.
Dialogue: 0,0:22:15.29,0:22:17.91,Default,,0,0,0,,«Өткен уақыт»
Dialogue: 0,0:22:18.46,0:22:21.13,Default,,0,0,0,,Көмекші жоқ, сондықтан дайын бол.
Dialogue: 0,0:22:21.21,0:22:25.55,Default,,0,0,0,,ішінде біз Мэтт телепортациясын көрсетеміз.
Dialogue: 0,0:22:25.63,0:22:27.67,Default,,0,0,0,,Мұны істеу мүмкін емес.
Dialogue: 0,0:22:27.76,0:22:30.97,Default,,0,0,0,,Мен өз есегімнен басымды шығарып алсам ше?
Dialogue: 0,0:22:31.05,0:22:33.72,Default,,0,0,0,,Шулы көмекші - мәселе.
Dialogue: 0,0:22:33.81,0:22:36.81,Default,,0,0,0,,Көріп отырғаныңыздай, іші бос.
Dialogue: 0,0:22:36.89,0:22:38.73,Default,,0,0,0,,Және де
Dialogue: 0,0:22:38.81,0:22:40.06,Default,,0,0,0,,Мұнда не бар?
Dialogue: 0,0:22:40.15,0:22:42.15,Default,,0,0,0,,Маған көмекші керек деп ойладым.
Dialogue: 0,0:22:42.23,0:22:44.82,Default,,0,0,0,,Өз-өзіне қол жұмсаса, мен көмектесе алмаймын.
Dialogue: 0,0:22:44.90,0:22:45.44,Default,,0,0,0,,Жарайды
Dialogue: 0,0:22:45.82,0:22:47.11,Default,,0,0,0,,Шешейік
Dialogue: 0,0:22:47.19,0:22:51.66,Default,,0,0,0,,Телекинез ғылымын толығырақ қарастырайық.
Dialogue: 0,0:22:54.62,0:22:56.08,Default,,0,0,0,,Керемет! Бұл орындалды
Dialogue: 0,0:22:56.16,0:22:57.58,Default,,0,0,0,,Біз мұны жасадық.
Dialogue: 0,0:22:57.66,0:22:59.83,Default,,0,0,0,,Жоқ, мен жасадым.
Dialogue: 0,0:22:59.92,0:23:01.33,Default,,0,0,0,,Бұл ең нашар хабарландыру.
Dialogue: 0,0:23:01.79,0:23:03.92,Default,,0,0,0,,Йеллоустоун кальдерасы – бұл...
Dialogue: 0,0:23:04.00,0:23:07.76,Default,,0,0,0,,«Оянудың алдында ұйықтап жатқан алып».
Dialogue: 0,0:23:07.84,0:23:11.01,Default,,0,0,0,,Ыстық сұйықтық төменнен көтеріледі.
Dialogue: 0,0:23:11.47,0:23:15.68,Default,,0,0,0,,Кеңейу Жер қыртысы қайта-қайта жоғары итеру арқылы кеңейеді.
Dialogue: 0,0:23:15.76,0:23:17.85,Default,,0,0,0,,Жоқ, мен өз шегімдемін.
Dialogue: 0,0:23:17.93,0:23:20.56,Default,,0,0,0,,Мені кешірші, мен әлсіз адаммын.
Dialogue: 0,0:23:20.64,0:23:21.52,Default,,0,0,0,,Сіз неге рұқсат бересіз?
Dialogue: 0,0:23:21.60,0:23:22.56,Default,,0,0,0,,Менің әрекеттерім
Dialogue: 0,0:23:22.65,0:23:26.27,Default,,0,0,0,,Егер қысым болса, сәулелену қажет.
Dialogue: 0,0:23:26.36,0:23:27.19,Default,,0,0,0,,Екі рет секіру ме? Әзілдеп тұрсың ғой.
Dialogue: 0,0:23:29.11,0:23:31.57,Default,,0,0,0,,Жарайды, себебі бұл әлсіз жер сілкінісі.
Dialogue: 0,0:23:31.66,0:23:33.95,Default,,0,0,0,,үшін достарыңды қорғайды
Dialogue: 0,0:23:34.03,0:23:35.53,Default,,0,0,0,,Мисси Жалғастыру
Dialogue: 0,0:23:35.62,0:23:39.50,Default,,0,0,0,,Мен мұны істеуге қатты қорқамын, Эндрю, кезекпен жүр.
Dialogue: 0,0:23:39.58,0:23:40.96,Default,,0,0,0,,Нашар
Dialogue: 0,0:23:41.04,0:23:42.12,Default,,0,0,0,,Не болды?
Dialogue: 0,0:23:43.04,0:23:43.63,Default,,0,0,0,,Сіз сонша жау жинап алатыныңыз шын мәнінде ауыртпалық.
Dialogue: 0,0:23:43.71,0:23:44.96,Default,,0,0,0,,Қауіпті
Dialogue: 0,0:23:47.21,0:23:48.51,Default,,0,0,0,,Қорқынышты!
Dialogue: 0,0:23:48.88,0:23:49.97,Default,,0,0,0,,Нашар
Dialogue: 0,0:23:50.05,0:23:51.51,Default,,0,0,0,,Менімен бірге жүр
Dialogue: 0,0:23:51.59,0:23:54.30,Default,,0,0,0,,Маған ұнамайды, маған не болды?
Dialogue: 0,0:23:55.14,0:23:56.47,Default,,0,0,0,,Біз бірдейміз
Dialogue: 0,0:23:56.56,0:23:58.81,Default,,0,0,0,,Өтінемін, Морис.
Dialogue: 0,0:23:58.89,0:24:00.60,Default,,0,0,0,,Дикті жалау
Dialogue: 0,0:24:00.68,0:24:02.94,Default,,0,0,0,,Мэтт сөйледі.
Dialogue: 0,0:24:03.48,0:24:04.77,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:24:04.86,0:24:09.07,Default,,0,0,0,,Бапкеріңізді күйеуіңізге айналдыруға уәде бересіз бе?
Dialogue: 0,0:24:09.15,0:24:09.86,Default,,0,0,0,,Ант етемін
Dialogue: 0,0:24:09.94,0:24:11.78,Default,,0,0,0,,Халлилуя
Dialogue: 0,0:24:14.11,0:24:15.28,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:24:16.95,0:24:18.03,Default,,0,0,0,,Мисси
Dialogue: 0,0:24:19.79,0:24:20.79,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:24:25.04,0:24:26.67,Default,,0,0,0,,Эндрюдің идиоты
Dialogue: 0,0:24:26.75,0:24:29.05,Default,,0,0,0,,Бізге сабақ болу үшін...
Dialogue: 0,0:24:30.30,0:24:33.22,Default,,0,0,0,,Ал құдайдың жазасы түседі-
Dialogue: 0,0:24:33.30,0:24:38.43,Default,,0,0,0,,Ыстық лава атқылап, жердің күнәлары тазартылды.
Dialogue: 0,0:24:38.51,0:24:42.14,Default,,0,0,0,,Табиғат құдіретін ешкім тоқтата алмайды!
Dialogue: 0,0:24:57.87,0:25:00.95,Default,,0,0,0,,Менің саусақтарым жабысқақ.
Dialogue: 0,0:25:01.04,0:25:03.37,Default,,0,0,0,,Мен саған айттым, мен қаламын.
Dialogue: 0,0:25:03.46,0:25:05.08,Default,,0,0,0,,Н.Кеннонға ұқсайды
Dialogue: 0,0:25:05.17,0:25:07.42,Default,,0,0,0,,Мұның бәрі дымқыл түс пе еді?
Dialogue: 0,0:25:07.50,0:25:11.00,Default,,0,0,0,,Джесси мен Джейдің оқиғасы шынайы.
Dialogue: 0,0:25:11.09,0:25:12.13,Default,,0,0,0,,Мэтт ше?
Dialogue: 0,0:25:12.21,0:25:15.09,Default,,0,0,0,,Рас, ол жақсы әйел.
Dialogue: 0,0:25:15.18,0:25:16.89,Default,,0,0,0,,«Зейнфельд» дәйексөзі
Dialogue: 0,0:25:16.97,0:25:18.76,Default,,0,0,0,,Сіз әлі де армандайсыз ба?
Dialogue: 0,0:25:18.85,0:25:19.55,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:25:19.64,0:25:23.60,Default,,0,0,0,,Бірақ мен штат бөлмесінде жаттықтырушыны тыңдамадым.
Dialogue: 0,0:25:23.68,0:25:24.81,Default,,0,0,0,,Бұл дұрыс, дұрыс.
Dialogue: 0,0:25:24.89,0:25:29.27,Default,,0,0,0,,Сіз шынымен көргендіктен осылай болды, солай ма?
Dialogue: 0,0:25:29.36,0:25:31.57,Default,,0,0,0,,«Кейлор» шектен шығып бара жатыр ма?
Dialogue: 0,0:25:31.65,0:25:33.40,Default,,0,0,0,,Бұл қорқынышты болды.
Dialogue: 0,0:25:33.49,0:25:35.32,Default,,0,0,0,,Сол кезде күлдім, бірақ
Dialogue: 0,0:25:35.40,0:25:36.99,Default,,0,0,0,,Маған оғаш нәрселер ұнайды
Dialogue: 0,0:25:37.07,0:25:38.62,Default,,0,0,0,,NETFLIX сұрауы
Dialogue: 0,0:25:38.70,0:25:39.49,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:26:25.62,0:26:27.62,Default,,0,0,0,,Жапон субтитрлері Нагиса Исозаки
Dialogue: 0,0:26:29.12,0:26:35.12,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
