Dialogue: 0,0:00:30.86,0:00:32.97,,NTP,0000,0000,0000,,Мияу~ Бұл қара.
Dialogue: 0,0:00:38.78,0:00:42.12,,NTP,0000,0000,0000,,Мияу~ Қайда бара жатырсың? Сіз қайтадан ву-вуға барасыз ба?
Dialogue: 0,0:00:42.97,0:00:44.52,,NTP,0000,0000,0000,,Ву-у?
Dialogue: 0,0:00:45.99,0:00:47.47,,NTP,0000,0000,0000,,Чи де жүріп жатыр~
Dialogue: 0,0:00:47.82,0:00:49.35,,NTP,0000,0000,0000,,Менің артымнан ерме
Dialogue: 0,0:00:49.72,0:00:51.21,,NTP,0000,0000,0000,,Қайда бара жатырсың?
Dialogue: 0,0:00:53.64,0:00:57.12,,NTP,0000,0000,0000,,Иә? Ана, Чи ше?
Dialogue: 0,0:00:57.94,0:00:59.58,,NTP,0000,0000,0000,,Ол мұнда жоқ.
Dialogue: 0,0:01:00.23,0:01:04.34,,NTP,0000,0000,0000,,Жоқ, таяқшаны пайдалануды ұмытып кетіппін.
Dialogue: 0,0:01:04.51,0:01:05.82,,NTP,0000,0000,0000,,Мен оның сыртқа шығады деп ойламадым.
Dialogue: 0,0:01:06.25,0:01:07.33,,NTP,0000,0000,0000,,Онда жоқ.
Dialogue: 0,0:01:07.93,0:01:09.28,,NTP,0000,0000,0000,,Не істеуім керек?
Dialogue: 0,0:01:09.86,0:01:14.28,,NTP,0000,0000,0000,,Мені біреу тапса, қиналып қаламын. Мен оны іздеуім керек.
Dialogue: 0,0:01:18.86,0:01:21.02,,NTP,0000,0000,0000,,О, сәлем.
Dialogue: 0,0:01:28.33,0:01:30.49,,NTP,0000,0000,0000,,Нене, сен не істейсің?
Dialogue: 0,0:01:31.01,0:01:33.22,,NTP,0000,0000,0000,,Менің артымнан келе жатсаң, үндеме.
Dialogue: 0,0:01:33.32,0:01:47.22,,NTP,0000,0000,0000,,Ай ха ха олжа ~
Dialogue: 0,0:01:48.13,0:01:49.52,,NTP,0000,0000,0000,,Қарамаңдар
Dialogue: 0,0:01:50.29,0:01:52.08,,NTP,0000,0000,0000,,Міне, сондықтан
Dialogue: 0,0:01:52.79,0:01:56.34,,NTP,0000,0000,0000,,Біз әр үйден мысықтың зақымдануы бар-жоғын сұраймыз.
Dialogue: 0,0:01:56.92,0:01:58.16,,NTP,0000,0000,0000,,Солай ма?
Dialogue: 0,0:02:05.91,0:02:06.93,,NTP,0000,0000,0000,,Мияу~
Dialogue: 0,0:02:08.72,0:02:10.57,,NTP,0000,0000,0000,,Қажетсіз ештеңе жасамаңыз!
Dialogue: 0,0:02:15.07,0:02:16.75,,NTP,0000,0000,0000,,Жақсы иіс~
Dialogue: 0,0:02:18.48,0:02:19.74,,NTP,0000,0000,0000,,Мен үйге асығамын.
Dialogue: 0,0:02:21.22,0:02:26.75,,NTP,0000,0000,0000,,Чи де, аа, аа~
Dialogue: 0,0:02:26.98,0:02:29.22,,NTP,0000,0000,0000,,Мынау мынау мынау….
Dialogue: 0,0:02:29.27,0:02:31.33,,NTP,0000,0000,0000,,Сіз не істеп жатырсыз? Асықшы!
Dialogue: 0,0:02:32.76,0:02:35.09,,NTP,0000,0000,0000,,Эй, сен шай алғың келе ме?
Dialogue: 0,0:02:35.17,0:02:36.62,,NTP,0000,0000,0000,,О, солай.
Dialogue: 0,0:02:37.20,0:02:39.44,,NTP,0000,0000,0000,,Уф, тез қаш!
Dialogue: 0,0:02:39.82,0:02:43.06,,NTP,0000,0000,0000,,Бұл….
Dialogue: 0,0:02:41.81,0:02:44.20,,NTP,0000,0000,0000,,Мен түскі ас ішуді ойладым.
Dialogue: 0,0:02:45.10,0:02:46.78,,NTP,0000,0000,0000,,Күрсін!
Dialogue: 0,0:02:48.46,0:02:50.16,,NTP,0000,0000,0000,,Хм. Хахахаха
Dialogue: 0,0:02:50.78,0:02:54.21,,NTP,0000,0000,0000,,Нян~ Сәлем
Dialogue: 0,0:03:27.50,0:03:28.57,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:03:29.86,0:03:30.58,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:03:32.27,0:03:33.42,,NTP,0000,0000,0000,,Онда жоқ.
Dialogue: 0,0:03:34.06,0:03:37.63,,NTP,0000,0000,0000,,Әкімші мені тапса, не істеуім керек?
Dialogue: 0,0:03:37.91,0:03:39.91,,NTP,0000,0000,0000,,Сіз табылған жағдайда не болады?
Dialogue: 0,0:03:41.52,0:03:43.47,,NTP,0000,0000,0000,,Не болады екен деп ойлаймын~
Dialogue: 0,0:03:44.68,0:03:46.41,,NTP,0000,0000,0000,,Ааа~
Dialogue: 0,0:03:48.04,0:03:49.43,,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:03:49.98,0:03:52.55,,NTP,0000,0000,0000,,Мені ұстаңыз!
Dialogue: 0,0:03:52.57,0:03:53.85,,NTP,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:03:54.06,0:03:55.29,,NTP,0000,0000,0000,,Қаш!
Dialogue: 0,0:03:56.04,0:03:58.11,,NTP,0000,0000,0000,,Өте ыстық.
Dialogue: 0,0:04:00.06,0:04:01.18,,NTP,0000,0000,0000,,Мен оны ұстадым~
Dialogue: 0,0:04:01.29,0:04:02.04,,NTP,0000,0000,0000,,Иә~
Dialogue: 0,0:04:03.61,0:04:04.74,,NTP,0000,0000,0000,,Ата-ана мен бала?
Dialogue: 0,0:04:05.07,0:04:09.77,,NTP,0000,0000,0000,,Мен біреу ғана бар деп ойладым, бірақ екеуі аңдып жүгіріп жүрді.
Dialogue: 0,0:04:10.12,0:04:11.71,,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:04:17.54,0:04:18.82,,NTP,0000,0000,0000,,Мен жүгіремін, артымнан жүр.
Dialogue: 0,0:04:19.04,0:04:26.63,,NTP,0000,0000,0000,,А, мен қашып кеттім. Күте тұрыңыз.
Dialogue: 0,0:04:27.45,0:04:29.66,,NTP,0000,0000,0000,,Чи, сен қайда бардың?
Dialogue: 0,0:04:30.31,0:04:31.41,,NTP,0000,0000,0000,,Ах-чи
Dialogue: 0,0:04:35.85,0:04:38.44,,NTP,0000,0000,0000,,Қоңыр аю мысық? Чи
Dialogue: 0,0:04:39.68,0:04:40.53,,NTP,0000,0000,0000,,Бұл
Dialogue: 0,0:04:40.60,0:04:45.54,,NTP,0000,0000,0000,,Күтіңіз~ Міне
Dialogue: 0,0:04:45.76,0:04:47.58,,NTP,0000,0000,0000,,Әкімші мырза?
Dialogue: 0,0:04:48.62,0:04:55.93,,NTP,0000,0000,0000,,Мұнда күт, мысық, күте~ Міне~, күт
Dialogue: 0,0:04:58.38,0:05:01.09,,NTP,0000,0000,0000,,Ци ұсталса не болады?
Dialogue: 0,0:05:02.00,0:05:04.11,,NTP,0000,0000,0000,,Не болады екен деп ойлаймын~
Dialogue: 0,0:05:07.11,0:05:07.90,,NTP,0000,0000,0000,,Өрмелеп көрейік
Dialogue: 0,0:05:15.99,0:05:20.55,,NTP,0000,0000,0000,,Маған Чи ұнамайды. Мен көтеріле алмаймын. Мен үйге бара жатырмын.
Dialogue: 0,0:05:20.95,0:05:23.00,,NTP,0000,0000,0000,,Мен мұны қазір істей алмаймын. Менімен жүр.
Dialogue: 0,0:05:23.25,0:05:26.33,,NTP,0000,0000,0000,,Неліктен? Маған ұнамайды
Dialogue: 0,0:05:26.45,0:05:28.90,,NTP,0000,0000,0000,,Менің түйсігім қашып кет деп жатыр!
Dialogue: 0,0:05:29.08,0:05:30.94,,NTP,0000,0000,0000,,Инстинкт?
Dialogue: 0,0:05:36.19,0:05:39.89,,NTP,0000,0000,0000,,Ци Мен инстинкттерді білмеймін, мен сені ешқашан кездестірмедім!
Dialogue: 0,0:05:40.68,0:05:42.72,,NTP,0000,0000,0000,,Бұл маңызды! Жүгір!
Dialogue: 0,0:05:44.16,0:05:47.83,,NTP,0000,0000,0000,,Бұл не~ қазірдің өзінде~
Dialogue: 0,0:06:31.36,0:06:35.83,,NTP,0000,0000,0000,,Мына мысықтар осында ма?
Dialogue: 0,0:07:02.21,0:07:03.44,,NTP,0000,0000,0000,,Чи?
Dialogue: 0,0:07:07.49,0:07:09.82,,NTP,0000,0000,0000,,Мен соққы алдым.
Dialogue: 0,0:07:10.66,0:07:14.75,,NTP,0000,0000,0000,,Бұл жерде үй жануарларына рұқсат етілмейтінін айтуым керек.
Dialogue: 0,0:07:18.82,0:07:21.62,,NTP,0000,0000,0000,,Мұның бәрі қоңыр аю мысықтың арқасында болды.
Dialogue: 0,0:07:21.95,0:07:23.24,,NTP,0000,0000,0000,,Чи жақсы ма?
Dialogue: 0,0:07:29.32,0:07:32.44,,NTP,0000,0000,0000,,О, бұл қайда?
Dialogue: 0,0:07:33.21,0:07:33.73,,NTP,0000,0000,0000,,Йо~
Dialogue: 0,0:07:33.80,0:07:36.92,,NTP,0000,0000,0000,,Мияу, мен таң қалдым.
Dialogue: 0,0:07:37.40,0:07:38.55,,NTP,0000,0000,0000,,Бұл менің үйім!
Dialogue: 0,0:07:38.72,0:07:42.71,,NTP,0000,0000,0000,,Үй? Чи үйге бара жатыр~
Dialogue: 0,0:07:45.07,0:07:45.82,,NTP,0000,0000,0000,,Бұл...
Dialogue: 0,0:07:45.87,0:07:47.10,,NTP,0000,0000,0000,,Чи жоқ.
Dialogue: 0,0:07:47.68,0:07:49.47,,NTP,0000,0000,0000,,Ол әлі де төмен ме?
Dialogue: 0,0:07:52.99,0:07:57.39,,NTP,0000,0000,0000,,Иә, иә, эй, менеджер.
Dialogue: 0,0:07:57.79,0:07:58.90,,NTP,0000,0000,0000,,Сәлем
Dialogue: 0,0:08:00.50,0:08:05.30,,NTP,0000,0000,0000,,Менің қояр сұрағым бар, бірақ сіздің үйде мысық бар ма?
Dialogue: 0,0:08:06.17,0:08:07.98,,NTP,0000,0000,0000,,Мысық? Иә, менде бар.
Dialogue: 0,0:08:08.23,0:08:12.82,,NTP,0000,0000,0000,,Сен мысық асырайсың ғой. Мысықтың зақымдануы көп болды.
Dialogue: 0,0:08:13.01,0:08:16.67,,NTP,0000,0000,0000,,Көріп отырғаныңыздай, оған кондоминиум ережелерінде де тыйым салынған.
Dialogue: 0,0:08:17.26,0:08:18.01,,NTP,0000,0000,0000,,Тыйым салынған?
Dialogue: 0,0:08:18.99,0:08:22.64,,NTP,0000,0000,0000,,Мен үйге бара жатырмын, сондықтан үндемеңіз және менің артымнан жүріңіз.
Dialogue: 0,0:08:22.84,0:08:23.74,,NTP,0000,0000,0000,,Ай
Dialogue: 0,0:08:24.80,0:08:35.93,,NTP,0000,0000,0000,,Осылай, секірейік, секірейік!
Dialogue: 0,0:08:40.72,0:08:46.53,,NTP,0000,0000,0000,,Е, маған ұнамайды.
Dialogue: 0,0:09:23.31,0:09:27.60,,NTP,0000,0000,0000,,Секірейік, секірейік!
Dialogue: 0,0:09:31.14,0:09:32.07,,NTP,0000,0000,0000,,Секіру
Dialogue: 0,0:09:34.87,0:09:36.94,,NTP,0000,0000,0000,,Сіз не істеп жатырсыз? Тез кел.
Dialogue: 0,0:09:40.10,0:09:46.73,,NTP,0000,0000,0000,,Мұнда жазылғандай, мұнда ит пен мысыққа тыйым салынған.
Dialogue: 0,0:09:47.17,0:09:47.83,,NTP,0000,0000,0000,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:09:47.88,0:09:50.03,,NTP,0000,0000,0000,,Менің мысығым бар болғандықтан, сізден көшуіңізді сұрауым керек пе?
Dialogue: 0,0:09:50.22,0:09:53.23,,NTP,0000,0000,0000,,Мысықтың бірдеңе жасаудан басқа амалы жоқ.
Dialogue: 0,0:09:55.52,0:09:57.11,,NTP,0000,0000,0000,,Маған ұнамайды
Dialogue: 0,0:09:57.24,0:09:58.49,,NTP,0000,0000,0000,,Жоғары қара
Dialogue: 0,0:10:00.85,0:10:02.69,,NTP,0000,0000,0000,,Әй, оны қой — қарашы!
Dialogue: 0,0:10:05.35,0:10:07.02,,NTP,0000,0000,0000,,Бұл біртүрлі бет.
Dialogue: 0,0:10:07.59,0:10:13.31,,NTP,0000,0000,0000,,Алға жылжу кезінде төмен қарамаңыз. Күлімсіреп, алға күтіңіз.
Dialogue: 0,0:10:20.36,0:10:21.60,,NTP,0000,0000,0000,,Үйге қайт
Dialogue: 0,0:10:39.78,0:10:42.16,,NTP,0000,0000,0000,,Чи мұны жасады
Dialogue: 0,0:10:42.80,0:10:46.63,,NTP,0000,0000,0000,,Жарайды, келесі жолы түсейік.
Dialogue: 0,0:10:47.24,0:10:48.04,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:10:49.47,0:10:51.71,,NTP,0000,0000,0000,,Йохеи екінші жағын іздейді
Dialogue: 0,0:10:51.82,0:10:52.44,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:10:54.06,0:10:56.22,,NTP,0000,0000,0000,,Ци, оны терезеден көрмейсің бе?
Dialogue: 0,0:11:01.72,0:11:05.56,,NTP,0000,0000,0000,,Ха Чи
Dialogue: 0,0:11:10.12,0:11:15.10,,NTP,0000,0000,0000,,А, қоңыр аю мысық?
Dialogue: 0,0:11:20.42,0:11:23.49,,NTP,0000,0000,0000,,Қоңыр аю мысық Чиге көмектесті ме?
Dialogue: 0,0:11:26.06,0:11:28.04,,NTP,0000,0000,0000,,Бұл қызықты болды
Dialogue: 0,0:00:00.00,0:00:00.00,,NTP,0000,0000,0000,,үйге қайтты
Dialogue: 0,0:11:28.67,0:11:29.52,,NTP,0000,0000,0000,,Сонда кездескенше
Dialogue: 0,0:11:34.84,0:11:36.21,,NTP,0000,0000,0000,,Жақында кездескенше
Dialogue: 0,0:11:40.30,0:11:43.00,,NTP,0000,0000,0000,,Ах Матана
Dialogue: 0,0:12:14.89,0:12:16.57,,NTP,0000,0000,0000,,Не? Чи бұл
Dialogue: 0,0:12:17.37,0:12:19.80,,NTP,0000,0000,0000,,Менеджер мені тапты.
Dialogue: 0,0:12:20.03,0:12:22.79,,NTP,0000,0000,0000,,Қоңыр аю мысық үйге дейін ізіне түсті.
Dialogue: 0,0:12:23.87,0:12:26.17,,NTP,0000,0000,0000,,Чи әйтеуір аман қалды.
Dialogue: 0,0:12:27.84,0:12:30.65,,NTP,0000,0000,0000,,Ертең мен де қаралармен ойнаймын.
Dialogue: 0,0:12:32.99,0:12:36.15,,NTP,0000,0000,0000,,Бұл кептеліп қалды.
Dialogue: 0,0:12:40.97,0:12:42.38,,NTP,0000,0000,0000,,қабылдау мүмкін емес
Dialogue: 0,0:12:46.69,0:12:48.00,,NTP,0000,0000,0000,,Түсіндім
Dialogue: 0,0:12:51.07,0:12:52.89,,NTP,0000,0000,0000,,Кептеліп қалды
Dialogue: 0,0:12:58.10,0:12:59.36,,NTP,0000,0000,0000,,Түсіндім
Dialogue: 0,0:13:00.98,0:13:04.24,,NTP,0000,0000,0000,,О, қиын.
Dialogue: 0,0:13:12.99,0:13:13.96,,NTP,0000,0000,0000,,Мм, мм
Dialogue: 0,0:13:15.53,0:13:19.39,,NTP,0000,0000,0000,,Жүгіру, жүгіру
Dialogue: 0,0:13:24.41,0:13:26.28,,NTP,0000,0000,0000,,Берілмеңіз
Dialogue: 0,0:13:40.75,0:13:44.05,,NTP,0000,0000,0000,,Qi, мен қанша жүруім керек?
Dialogue: 0,0:13:44.50,0:13:47.60,,NTP,0000,0000,0000,,Енді жоқ
Dialogue: 0,0:13:48.69,0:13:49.86,,NTP,0000,0000,0000,,Алға жылжу кезінде
Dialogue: 0,0:13:50.10,0:13:53.04,,NTP,0000,0000,0000,,Төмен қарама, күліп, алға қара.
Dialogue: 0,0:13:57.37,0:13:58.53,,NTP,0000,0000,0000,,Сәттілік Чи
Dialogue: 0,0:14:04.00,0:14:05.80,,NTP,0000,0000,0000,,Сәттілік Чи
Dialogue: 0,0:14:15.24,0:14:17.50,,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:14:18.64,0:14:20.91,,NTP,0000,0000,0000,,Сәттілік Чи
Dialogue: 0,0:14:21.47,0:14:22.81,,NTP,0000,0000,0000,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:14:23.07,0:14:23.90,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:14:23.98,0:14:24.88,,NTP,0000,0000,0000,,Раббым!
Dialogue: 0,0:14:25.08,0:14:26.84,,NTP,0000,0000,0000,,Қазір бәрі жақсы.
Dialogue: 0,0:14:27.36,0:14:29.36,,NTP,0000,0000,0000,,Чи, сен қолыңнан келгеннің бәрін жасадың.
Dialogue: 0,0:14:30.96,0:14:32.07,,NTP,0000,0000,0000,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:14:34.50,0:14:36.60,,NTP,0000,0000,0000,,Чи, сен қолыңнан келгеннің бәрін жасадың.
Dialogue: 0,0:15:10.92,0:15:13.09,,NTP,0000,0000,0000,,Қызық, қарасы келе ме?
Dialogue: 0,0:15:13.52,0:15:15.58,,NTP,0000,0000,0000,,Ендеше бірге ойнайық
Dialogue: 0,0:15:18.96,0:15:20.60,,NTP,0000,0000,0000,,Көрдіңіз бе? Ямада мырза
Dialogue: 0,0:15:20.99,0:15:21.61,,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:15:22.17,0:15:24.94,,NTP,0000,0000,0000,,Пошта жәшігіндегі ескерту қағазы
Dialogue: 0,0:15:25.62,0:15:26.42,,NTP,0000,0000,0000,,Қағаз?
Dialogue: 0,0:15:26.92,0:15:29.12,,NTP,0000,0000,0000,,Бұл шын мәнінде басталатын сияқты.
Dialogue: 0,0:15:29.31,0:15:31.00,,NTP,0000,0000,0000,,Үй жануарларын бақылау
Dialogue: 0,0:15:33.57,0:15:38.55,,NTP,0000,0000,0000,,Ережеге сәйкес бұл пәтерде үй жануарларына тыйым салынады.
Dialogue: 0,0:15:38.79,0:15:42.60,,NTP,0000,0000,0000,,Сіз үй жануарыңыздан қазір бас тартасыз ба, әлде кетесіз бе?
Dialogue: 0,0:15:43.32,0:15:47.59,,NTP,0000,0000,0000,,Ах, мен Чиді енді ешқашан жібермеуім керек.
Dialogue: 0,0:15:47.76,0:15:48.72,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:15:50.28,0:15:52.54,,NTP,0000,0000,0000,,Келесі жолы қара болады ма деп ойлаймын.
Dialogue: 0,0:15:53.04,0:15:56.76,,NTP,0000,0000,0000,,Аа, дұрыс. Біз де ойнайық, Чи.
Dialogue: 0,0:15:56.90,0:15:58.69,,NTP,0000,0000,0000,,Сыртта
Dialogue: 0,0:15:58.94,0:16:01.35,,NTP,0000,0000,0000,,Иә Ашпаңыз
Dialogue: 0,0:16:07.62,0:16:08.86,,NTP,0000,0000,0000,,Әкем
Dialogue: 0,0:16:10.36,0:16:11.21,,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:16:11.18,0:16:12.99,,NTP,0000,0000,0000,,Әке, мына жерді ашыңыз.
Dialogue: 0,0:16:13.87,0:16:15.74,,NTP,0000,0000,0000,,Ци, шыққың келе ме?
Dialogue: 0,0:16:16.31,0:16:17.86,,NTP,0000,0000,0000,,Ашық, ашық
Dialogue: 0,0:16:19.19,0:16:23.66,,NTP,0000,0000,0000,,Кешіріңіз Чи, әкеңізге де қиын.
Dialogue: 0,0:16:31.58,0:16:33.03,,NTP,0000,0000,0000,,Сыртта
Dialogue: 0,0:16:34.77,0:16:35.81,,NTP,0000,0000,0000,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:16:35.96,0:16:37.37,,NTP,0000,0000,0000,,Ах Чи
Dialogue: 0,0:16:37.39,0:16:38.92,,NTP,0000,0000,0000,,Чи де шықты.
Dialogue: 0,0:16:43.04,0:16:44.76,,NTP,0000,0000,0000,,Кешіріңіз, сіз шыға алмайсыз.
Dialogue: 0,0:16:45.04,0:16:49.31,,NTP,0000,0000,0000,,Мама, сыртта не істеп жүрсіз?
Dialogue: 0,0:16:49.38,0:16:50.39,,NTP,0000,0000,0000,,No
Dialogue: 0,0:16:52.69,0:16:53.99,,NTP,0000,0000,0000,,Егер табылса, Qi
Dialogue: 0,0:16:54.15,0:16:56.11,,NTP,0000,0000,0000,,Мен мұнда тұра алмаймын.
Dialogue: 0,0:16:56.30,0:16:59.56,,NTP,0000,0000,0000,,Мама, сіз сырттасыз.
Dialogue: 0,0:17:00.98,0:17:02.02,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:17:02.44,0:17:09.29,,NTP,0000,0000,0000,,Сыртта
Dialogue: 0,0:17:08.89,0:17:09.73,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:17:13.64,0:17:15.91,,NTP,0000,0000,0000,,Үй ішінде ойнайық.
Dialogue: 0,0:17:17.01,0:17:21.47,,NTP,0000,0000,0000,,Жоқ, Чи сыртқа шыққысы келеді.
Dialogue: 0,0:17:21.79,0:17:25.95,,NTP,0000,0000,0000,,Сыртта Сыртта Ол сыртта.
Dialogue: 0,0:17:26.55,0:17:33.04,,NTP,0000,0000,0000,,Сыртта
Dialogue: 0,0:18:20.73,0:18:21.56,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:18:29.40,0:18:32.33,,NTP,0000,0000,0000,,Қарамен ойнаңыз
Dialogue: 0,0:18:35.30,0:18:36.83,,NTP,0000,0000,0000,,Сыртта
Dialogue: 0,0:18:44.60,0:18:45.47,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:19:09.75,0:19:13.03,,NTP,0000,0000,0000,,Ци, сенің сыртқа шыққың келеді.
Dialogue: 0,0:19:13.26,0:19:17.26,,NTP,0000,0000,0000,,Бірақ кейбір жанұялар үй жануарларын тек үйдің ішінде ұстайды.
Dialogue: 0,0:19:17.56,0:19:21.12,,NTP,0000,0000,0000,,Бірақ мен оны ашылмас үшін құпия ұстадым.
Dialogue: 0,0:19:21.80,0:19:24.91,,NTP,0000,0000,0000,,Оларды кенет жібермеу басқа.
Dialogue: 0,0:19:25.94,0:19:29.80,,NTP,0000,0000,0000,,Сонымен қатар, Чи сыртқы әлем туралы біледі.
Dialogue: 0,0:19:30.14,0:19:31.63,,NTP,0000,0000,0000,,Бұл рас.
Dialogue: 0,0:19:32.51,0:19:34.79,,NTP,0000,0000,0000,,Бұл жақсы ма?
Dialogue: 0,0:19:35.05,0:19:37.73,,NTP,0000,0000,0000,,Сонымен не істейміз?
Dialogue: 0,0:19:37.86,0:19:39.60,,NTP,0000,0000,0000,,Не істеуім керек?
Dialogue: 0,0:19:39.84,0:19:43.60,,NTP,0000,0000,0000,,Хоккайдодағы билікті Джуридің отбасы алады ма?
Dialogue: 0,0:19:44.74,0:19:47.66,,NTP,0000,0000,0000,,Мен білмеймін, білмеймін
Dialogue: 0,0:19:48.56,0:19:52.04,,NTP,0000,0000,0000,,Бірақ біз шешуіміз керек
Dialogue: 0,0:19:52.22,0:19:54.70,,NTP,0000,0000,0000,,Циді ең бақытты ететін не?
Dialogue: 0,0:20:12.22,0:20:14.70,,NTP,0000,0000,0000,,Чи, сен әлі осында болдың ба?
Dialogue: 0,0:20:20.01,0:20:21.09,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:20:27.93,0:20:29.29,,NTP,0000,0000,0000,,Сыртта
Dialogue: 0,0:21:11.19,0:21:13.60,,NTP,0000,0000,0000,,Чи, өзіңізді жақсы сезінбейсіз.
Dialogue: 0,0:21:17.08,0:21:19.12,,NTP,0000,0000,0000,,Сіз сыртқа шыққыңыз келеді.
Dialogue: 0,0:21:20.32,0:21:25.47,,NTP,0000,0000,0000,,Бірақ жоқ, олар білсе қиын болады дейді.
Dialogue: 0,0:21:35.10,0:21:37.04,,NTP,0000,0000,0000,,Қандай дыбыс?
Dialogue: 0,0:21:39.62,0:21:40.52,,NTP,0000,0000,0000,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:21:46.16,0:21:47.64,,NTP,0000,0000,0000,,Бұл қара.
Dialogue: 0,0:21:51.64,0:21:53.55,,NTP,0000,0000,0000,,Қоңыр аю мысық
Dialogue: 0,0:21:53.85,0:21:55.47,,NTP,0000,0000,0000,,Юхэй, аш.
Dialogue: 0,0:21:56.12,0:21:57.76,,NTP,0000,0000,0000,,Qi Оны ашпаңыз.
Dialogue: 0,0:21:57.87,0:22:00.73,,NTP,0000,0000,0000,,Мен қара киіммен ойнауға келдім.
Dialogue: 0,0:22:02.10,0:22:03.67,,NTP,0000,0000,0000,,Оны ашу Оны ашыңыз
Dialogue: 0,0:22:03.95,0:22:05.86,,NTP,0000,0000,0000,,Жоқ, Чи.
Dialogue: 0,0:22:06.55,0:22:07.73,,NTP,0000,0000,0000,,Йохай
Dialogue: 0,0:22:16.39,0:22:18.88,,NTP,0000,0000,0000,,Бірақ жоқ, бұл жақсы емес.
Dialogue: 0,0:22:19.74,0:22:23.18,,NTP,0000,0000,0000,,Қарамен ойнаңыз
Dialogue: 0,0:22:25.45,0:22:26.90,,NTP,0000,0000,0000,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:22:53.27,0:22:53.99,,NTP,0000,0000,0000,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,0:22:58.14,0:23:00.54,,NTP,0000,0000,0000,,Мен бақыттымын
Dialogue: 0,0:23:02.55,0:23:07.71,,NTP,0000,0000,0000,,Қара, қара, қара
Dialogue: 0,0:23:24.98,0:23:27.04,,NTP,0000,0000,0000,,Қара ойын ойнайық
Dialogue: 0,0:23:59.04,0:24:03.14,,NTP,0000,0000,0000,,Бұл қара. Сен Чимен ойнауға келдің.
Dialogue: 0,0:24:09.31,0:24:12.68,,NTP,0000,0000,0000,,Мен мұны саған беремін.
Dialogue: 0,0:24:17.81,0:24:19.08,,NTP,0000,0000,0000,,696-санды тұтқын – Мұнда не болып жатыр өзі?
Dialogue: 0,0:24:20.74,0:24:21.64,,NTP,0000,0000,0000,,Мен мүлде не болып жатқанын түсінбеймін.
Dialogue: 0,0:24:22.63,0:24:25.95,,NTP,0000,0000,0000,,Шапылдаған олжа.
Dialogue: 0,0:24:27.24,0:24:28.56,,NTP,0000,0000,0000,,Сізге ұнады ма?
Dialogue: 0,0:24:29.32,0:24:30.65,,NTP,0000,0000,0000,,Маған бұл ұнайды
Dialogue: 0,0:24:33.71,0:24:38.26,,NTP,0000,0000,0000,,Күтіңіз Күтіңіз Күтіңіз
Dialogue: 0,0:24:40.50,0:24:42.17,,NTP,0000,0000,0000,,Сіз қашып үлгердіңіз.
Dialogue: 0,0:24:45.60,0:24:47.69,,NTP,0000,0000,0000,,Бұл өте қызық болды.
Dialogue: 0,0:24:48.98,0:24:50.03,,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:25:29.76,0:25:30.92,,NTP,0000,0000,0000,,Осы үшін оны мектептен шығарып жіберсе жақсы болар еді.
Dialogue: 0,0:25:31.22,0:25:32.16,,NTP,0000,0000,0000,,Үйге бару
Dialogue: 0,0:25:33.21,0:25:33.97,,NTP,0000,0000,0000,,О
Dialogue: 0,0:25:41.07,0:25:47.25,,NTP,0000,0000,0000,,Қайта ойнайық Чимен ойнайық
Dialogue: 0,0:26:01.45,0:26:03.22,,NTP,0000,0000,0000,,О
Dialogue: 0,0:26:05.41,0:26:08.35,,NTP,0000,0000,0000,,Көріскенше, Чи
Dialogue: 0,0:26:17.65,0:26:19.34,,NTP,0000,0000,0000,,Қоңыр аю мысық
Dialogue: 0,0:26:55.45,0:26:57.11,,NTP,0000,0000,0000,,Сәлем, Ямада мырза
Dialogue: 0,0:26:57.31,0:26:57.91,,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:26:58.20,0:26:59.87,,NTP,0000,0000,0000,,Эй, мен көрдім.
Dialogue: 0,0:27:03.89,0:27:08.57,,NTP,0000,0000,0000,,Қараңдаршы, бұл үй екінші қабатта мысық бар екені анықталды.
Dialogue: 0,0:27:08.64,0:27:11.80,,NTP,0000,0000,0000,,Мен мысығымды жібергім келмейді.
Dialogue: 0,0:27:12.33,0:27:14.33,,NTP,0000,0000,0000,,Мен сіздің көшуге шешім қабылдағаныңызды естідім.
Dialogue: 0,0:27:15.45,0:27:16.60,,NTP,0000,0000,0000,,Жылжыту?
Dialogue: 0,0:27:16.68,0:27:19.15,,NTP,0000,0000,0000,,Дұрыс, мен қазір жүктерімді тиеп жатырмын.
Dialogue: 0,0:27:30.19,0:27:32.24,,NTP,0000,0000,0000,,Мен таң қалдым.
Dialogue: 0,0:27:32.30,0:27:33.65,,NTP,0000,0000,0000,,Бұл кенеттен болды.
Dialogue: 0,0:27:34.95,0:27:36.47,,NTP,0000,0000,0000,,Барлығы не істеп жатыр?
Dialogue: 0,0:27:40.69,0:27:45.07,,NTP,0000,0000,0000,,Қоңыр аю мысық үй орнына мысықты таңдады.
Dialogue: 0,0:27:45.21,0:27:48.12,,NTP,0000,0000,0000,,Иә, дұрыс.
Dialogue: 0,0:27:48.46,0:27:50.17,,NTP,0000,0000,0000,,О, бұл сыртта.
Dialogue: 0,0:27:52.37,0:27:57.50,,NTP,0000,0000,0000,,Кешіріңіз, бірақ әкімші ретінде мен де көмектесе алмаймын.
Dialogue: 0,0:27:57.70,0:27:59.20,,NTP,0000,0000,0000,,Мен де солай.
Dialogue: 0,0:27:59.42,0:28:00.82,,NTP,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:28:01.42,0:28:03.19,,NTP,0000,0000,0000,,Амансың деп үміттенемін.
Dialogue: 0,0:28:04.18,0:28:08.54,,NTP,0000,0000,0000,,О, сенде екі мысық бар, солай ма?
Dialogue: 0,0:28:09.25,0:28:11.17,,NTP,0000,0000,0000,,Басқа котенка ше?
Dialogue: 0,0:28:11.94,0:28:14.15,,NTP,0000,0000,0000,,Бұл мысық үйде жалғыз
Dialogue: 0,0:28:14.46,0:28:17.33,,NTP,0000,0000,0000,,Не? Ал, бұл котенка...
Dialogue: 0,0:28:17.86,0:28:23.72,,NTP,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:28:29.41,0:28:30.83,,NTP,0000,0000,0000,,Бұл қара.
Dialogue: 0,0:28:34.96,0:28:37.46,,NTP,0000,0000,0000,,Эй, сәлем
Dialogue: 0,0:28:40.21,0:28:43.23,,NTP,0000,0000,0000,,Қоңыр аю мысық қайда барады?
Dialogue: 0,0:28:43.42,0:28:44.72,,NTP,0000,0000,0000,,Алыста ма?
Dialogue: 0,0:28:45.11,0:28:46.51,,NTP,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:28:48.18,0:28:51.03,,NTP,0000,0000,0000,,Чи, мен қоңыр аю мысықты енді кездестіре алмаймын.
Dialogue: 0,0:28:51.29,0:28:53.44,,NTP,0000,0000,0000,,Біз өте жақын дос болсақ та
Dialogue: 0,0:29:01.87,0:29:03.95,,NTP,0000,0000,0000,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:29:03.97,0:29:06.31,,NTP,0000,0000,0000,,Қандай тамаша саяхат.
Dialogue: 0,0:29:09.53,0:29:18.48,,NTP,0000,0000,0000,,Қош келдіңіз, қош келдіңіз...
Dialogue: 0,0:29:54.33,0:29:56.80,,NTP,0000,0000,0000,,Қандай тамаша саяхат.
Dialogue: 0,0:29:58.26,0:30:01.67,,NTP,0000,0000,0000,,Эй, Чи енді қоңыр аю мысықты кездестіре алмайды.
Dialogue: 0,0:30:02.78,0:30:12.34,,NTP,0000,0000,0000,,Қош келдіңіз, қош келдіңіз...
Dialogue: 0,0:30:35.25,0:30:36.84,,NTP,0000,0000,0000,,Ол жоғалды.
Dialogue: 0,0:30:37.25,0:30:39.09,,NTP,0000,0000,0000,,Сіз мысық үшін қозғаласыз ба?
Dialogue: 0,0:30:39.83,0:30:42.42,,NTP,0000,0000,0000,,Бұл оңай іс емес.
Dialogue: 0,0:30:43.19,0:30:43.94,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:30:45.98,0:30:47.00,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:31:09.76,0:31:11.49,,NTP,0000,0000,0000,,Қара емес
Dialogue: 0,0:31:19.37,0:31:21.47,,NTP,0000,0000,0000,,Айтуынша, сол шайқас нағыз қанды қырғын болған екен.
Dialogue: 0,0:31:52.62,0:31:53.79,,NTP,0000,0000,0000,,Маған ұнамайды
Dialogue: 0,0:31:56.14,0:32:00.22,,NTP,0000,0000,0000,,Қайта ойнайық Чимен ойнайық
Dialogue: 0,0:32:01.23,0:32:02.69,,NTP,0000,0000,0000,,Ах
Dialogue: 0,0:32:09.58,0:32:12.46,,NTP,0000,0000,0000,,Маған ұнамайды
Dialogue: 0,0:32:48.69,0:32:50.58,,NTP,0000,0000,0000,,Қара түс жоқ
Dialogue: 0,0:32:52.33,0:32:53.93,,NTP,0000,0000,0000,,Айтуынша, сол шайқас нағыз қанды қырғын болған екен.
Dialogue: 0,0:32:56.10,0:33:05.47,,NTP,0000,0000,0000,,Маған ұнамайды, маған ұнамайды, маған ұнамайды, маған ұнамайды.
Dialogue: 0,0:33:09.27,0:33:10.24,,NTP,0000,0000,0000,,жылап жіберді
Dialogue: 0,0:33:11.94,0:33:13.36,,NTP,0000,0000,0000,,Мен жыладым.
Dialogue: 0,0:33:18.03,0:33:19.95,,NTP,0000,0000,0000,,Петанко Пом Пом
Dialogue: 0,0:33:22.73,0:33:23.77,,NTP,0000,0000,0000,,Күлімсіреу
Dialogue: 0,0:33:36.55,0:33:38.89,,NTP,0000,0000,0000,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:33:47.01,0:33:49.39,,NTP,0000,0000,0000,,Сені кішкентай үйрек күтіп тұр.
Dialogue: 0,0:33:52.24,0:33:54.94,,NTP,0000,0000,0000,,Үлкен үйрек кетті.
Dialogue: 0,0:33:56.10,0:33:58.38,,NTP,0000,0000,0000,,Бұл кітапта жазылған.
Dialogue: 0,0:34:11.83,0:34:14.47,,NTP,0000,0000,0000,,Сіз оны көре алмайсыз, бірақ ол сонда.
Dialogue: 0,0:34:33.49,0:34:35.05,,NTP,0000,0000,0000,,Qi, не болды?
Dialogue: 0,0:34:35.50,0:34:38.27,,NTP,0000,0000,0000,,Йохей Әкесі Ана
Dialogue: 0,0:34:39.07,0:34:40.90,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:34:40.92,0:34:43.89,,NTP,0000,0000,0000,,Бірі бар, бірі қарасы бар.
Dialogue: 0,0:34:45.05,0:34:47.86,,NTP,0000,0000,0000,,Чи, ақыры өзіңізді жақсы сезінген сияқтысыз.
Dialogue: 0,0:34:48.32,0:34:49.42,,NTP,0000,0000,0000,,Жақсы, онда
Dialogue: 0,0:34:58.21,0:35:05.64,,NTP,0000,0000,0000,,Сіз оны көре алмайсыз, бірақ ол сонда.
