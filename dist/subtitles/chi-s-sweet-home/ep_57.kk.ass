Dialogue: 0,0:00:01.70,0:00:04.25,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:00:04.73,0:00:07.56,,NTP,0000,0000,0000,,Мен сүтке өте ризамын
Dialogue: 0,0:00:08.05,0:00:10.61,,NTP,0000,0000,0000,,Ойнағаннан кейін
Dialogue: 0,0:00:11.10,0:00:14.29,,NTP,0000,0000,0000,,Сипалғанды жақсы сезіну
Dialogue: 0,0:00:14.56,0:00:16.83,,NTP,0000,0000,0000,,Мен оны аламын
Dialogue: 0,0:00:17.35,0:00:20.56,,NTP,0000,0000,0000,,Дәмді тағамы бар бонбон
Dialogue: 0,0:00:20.97,0:00:25.80,,NTP,0000,0000,0000,,Бақытты жатып
Dialogue: 0,0:00:26.49,0:00:28.89,,NTP,0000,0000,0000,,Ролл~
Dialogue: 0,0:00:55.71,0:01:01.65,,NTP,0000,0000,0000,,Мияу қызық
Dialogue: 0,0:01:03.96,0:01:05.23,,NTP,0000,0000,0000,,Ах Чи
Dialogue: 0,0:01:05.64,0:01:08.41,,NTP,0000,0000,0000,,Жоқ, кірмен ойнаңыз.
Dialogue: 0,0:01:09.63,0:01:12.92,,NTP,0000,0000,0000,,Мияу, қызық~
Dialogue: 0,0:01:15.02,0:01:17.92,,NTP,0000,0000,0000,,Мияу мама, қызық екен.
Dialogue: 0,0:01:18.27,0:01:19.19,,NTP,0000,0000,0000,,Мұнда Чи
Dialogue: 0,0:01:20.21,0:01:22.42,,NTP,0000,0000,0000,,Жусаң да кірленеді.
Dialogue: 0,0:01:26.67,0:01:28.55,,NTP,0000,0000,0000,,Жоқ, Чи.
Dialogue: 0,0:01:32.87,0:01:35.63,,NTP,0000,0000,0000,,Ци: Сіз жоқ дейсіз.
Dialogue: 0,0:01:36.91,0:01:37.33,,NTP,0000,0000,0000,,Мияу
Dialogue: 0,0:01:41.20,0:01:43.97,,NTP,0000,0000,0000,,Юхэй, қазір ішке кір.
Dialogue: 0,0:01:44.40,0:01:46.49,,NTP,0000,0000,0000,,Жел күшейеді.
Dialogue: 0,0:01:47.38,0:01:48.26,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:01:48.92,0:01:50.85,,NTP,0000,0000,0000,,Ойыншықтарыңызды дұрыстап тазалаңыз~
Dialogue: 0,0:01:51.24,0:01:52.03,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:02:15.78,0:02:17.89,,NTP,0000,0000,0000,,Ци, ішке кір.
Dialogue: 0,0:02:19.21,0:02:22.98,,NTP,0000,0000,0000,,Мияу Мияу
Dialogue: 0,0:02:24.49,0:02:26.40,,NTP,0000,0000,0000,,Дауыл келе жатыр
Dialogue: 0,0:02:27.78,0:02:28.48,,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:02:28.75,0:02:31.00,,NTP,0000,0000,0000,,Бұл дауыл
Dialogue: 0,0:02:32.54,0:02:33.84,,NTP,0000,0000,0000,,Дауыл?
Dialogue: 0,0:02:39.86,0:02:43.39,,NTP,0000,0000,0000,,~
Dialogue: 0,0:02:47.32,0:02:53.19,,NTP,0000,0000,0000,,қызықты
Dialogue: 0,0:02:58.02,0:03:00.29,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:03:00.72,0:03:03.48,,NTP,0000,0000,0000,,Мен сүтке ризамын
Dialogue: 0,0:03:03.95,0:03:06.62,,NTP,0000,0000,0000,,Ойнағаннан кейін
Dialogue: 0,0:03:07.07,0:03:10.28,,NTP,0000,0000,0000,,Сипалғанды жақсы сезіну
Dialogue: 0,0:03:10.58,0:03:12.96,,NTP,0000,0000,0000,,Мен оны аламын.
Dialogue: 0,0:03:13.59,0:03:16.17,,NTP,0000,0000,0000,,Дәмді тағамы бар бонбон
Dialogue: 0,0:03:16.73,0:03:21.55,,NTP,0000,0000,0000,,Жатып, бақытты болу
Dialogue: 0,0:03:22.53,0:03:24.93,,NTP,0000,0000,0000,,Ролл~
Dialogue: 0,0:03:26.64,0:03:28.29,,NTP,0000,0000,0000,,О
Dialogue: 0,0:03:44.70,0:03:46.92,,NTP,0000,0000,0000,,Мияу Мияу
Dialogue: 0,0:03:51.13,0:03:53.87,,NTP,0000,0000,0000,,А, бұл бақа.
Dialogue: 0,0:03:58.50,0:04:00.03,,NTP,0000,0000,0000,,түйреуіш
Dialogue: 0,0:04:20.98,0:04:22.29,,NTP,0000,0000,0000,,ағып кетті
Dialogue: 0,0:04:25.19,0:04:27.60,,NTP,0000,0000,0000,,Бұл қызық~ Йохеи
Dialogue: 0,0:04:28.68,0:04:34.10,,NTP,0000,0000,0000,,О, бұл қиын. Бір ғана қалды.
Dialogue: 0,0:04:42.32,0:04:44.14,,NTP,0000,0000,0000,,Резервуар құлады
Dialogue: 0,0:04:45.90,0:04:48.56,,NTP,0000,0000,0000,,Иә? Аа...
Dialogue: 0,0:05:06.77,0:05:09.69,,NTP,0000,0000,0000,,Жаңбыр күшейіп барады.
Dialogue: 0,0:05:13.46,0:05:22.39,,NTP,0000,0000,0000,,Көмектесіңіз! Жоқ, мияу мияу
Dialogue: 0,0:05:28.01,0:05:30.28,,NTP,0000,0000,0000,,Йохеи не істеп жатырсың?
Dialogue: 0,0:05:31.18,0:05:32.40,,NTP,0000,0000,0000,,Теру Теру Бозу?
Dialogue: 0,0:05:32.90,0:05:36.81,,NTP,0000,0000,0000,,...
Dialogue: 0,0:05:40.28,0:05:47.74,,NTP,0000,0000,0000,,Мияу Мяу Маған суланғанды ұнатпаймын.
Dialogue: 0,0:05:53.72,0:05:56.26,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:05:56.60,0:05:59.40,,NTP,0000,0000,0000,,Мен сүтке өте ризамын
Dialogue: 0,0:06:00.06,0:06:02.53,,NTP,0000,0000,0000,,Ойнағаннан кейін
Dialogue: 0,0:06:03.13,0:06:06.27,,NTP,0000,0000,0000,,Сипалғанды жақсы сезіну
Dialogue: 0,0:06:06.67,0:06:08.84,,NTP,0000,0000,0000,,Мен оны аламын.
Dialogue: 0,0:06:09.30,0:06:12.45,,NTP,0000,0000,0000,,Дәмді тағамы бар бонбон
Dialogue: 0,0:06:12.88,0:06:18.23,,NTP,0000,0000,0000,,Бақытты жату
Dialogue: 0,0:06:18.43,0:06:20.94,,NTP,0000,0000,0000,,Ролл~
Dialogue: 0,0:06:23.12,0:06:28.07,,NTP,0000,0000,0000,,Мияу Мияу Маған суланғанды ұнатпаймын.
Dialogue: 0,0:06:31.75,0:06:33.43,,NTP,0000,0000,0000,,А, орындалды, қараңыз.
Dialogue: 0,0:06:33.91,0:06:37.92,,NTP,0000,0000,0000,,...
Dialogue: 0,0:06:40.91,0:06:44.48,,NTP,0000,0000,0000,,Қолшатырым ұшып кетті.
Dialogue: 0,0:06:45.73,0:06:50.85,,NTP,0000,0000,0000,,Мияу, маған көмектес!
Dialogue: 0,0:06:52.36,0:06:54.80,,NTP,0000,0000,0000,,Менде қорқынышты оқиға болды.
Dialogue: 0,0:06:54.90,0:06:55.97,,NTP,0000,0000,0000,,Қайта оралдын.
Dialogue: 0,0:06:56.39,0:06:57.79,,NTP,0000,0000,0000,,Бұл қиын болды.
Dialogue: 0,0:06:57.95,0:06:58.56,,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:07:00.12,0:07:01.55,,NTP,0000,0000,0000,,Qi?
Dialogue: 0,0:07:03.12,0:07:06.57,,NTP,0000,0000,0000,,...
Dialogue: 0,0:07:08.69,0:07:10.78,,NTP,0000,0000,0000,,Ци Жасырынбақ?
Dialogue: 0,0:07:12.56,0:07:14.23,,NTP,0000,0000,0000,,Бұл біртүрлі...
Dialogue: 0,0:07:14.18,0:07:22.47,,NTP,0000,0000,0000,,...
Dialogue: 0,0:07:24.81,0:07:30.89,,NTP,0000,0000,0000,,...
Dialogue: 0,0:07:39.67,0:07:40.82,,NTP,0000,0000,0000,,Чи!
Dialogue: 0,0:07:41.21,0:07:41.92,,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:07:44.81,0:07:47.10,,NTP,0000,0000,0000,,Ол дымқыл және жиіркенішті
Dialogue: 0,0:07:47.39,0:07:48.74,,NTP,0000,0000,0000,,Сүлгімен орамал
Dialogue: 0,0:07:49.13,0:07:50.73,,NTP,0000,0000,0000,,Чи қозғалмайды
Dialogue: 0,0:07:53.58,0:07:56.02,,NTP,0000,0000,0000,,Мен қорқынышты жағдайға тап болдым
Dialogue: 0,0:08:00.58,0:08:02.27,,NTP,0000,0000,0000,,Мияу
Dialogue: 0,0:08:02.89,0:08:04.04,,NTP,0000,0000,0000,,Өзіңізді жақсы сезінесіз бе?
Dialogue: 0,0:08:04.10,0:08:05.86,,NTP,0000,0000,0000,,Сізге жақсы, Чи.
Dialogue: 0,0:08:07.32,0:08:08.88,,NTP,0000,0000,0000,,А, бұл не?
Dialogue: 0,0:08:15.71,0:08:17.20,,NTP,0000,0000,0000,,Сәлем!
Dialogue: 0,0:08:21.22,0:08:21.97,,NTP,0000,0000,0000,,Қорқынышты
Dialogue: 0,0:08:22.77,0:08:24.36,,NTP,0000,0000,0000,,Қорқынышты
Dialogue: 0,0:08:27.79,0:08:29.04,,NTP,0000,0000,0000,,Келіңіздер
Dialogue: 0,0:08:34.68,0:08:36.08,,NTP,0000,0000,0000,,Мен өзімді жалғыз сезінемін
Dialogue: 0,0:08:37.58,0:08:39.23,,NTP,0000,0000,0000,,Ал Кира
Dialogue: 0,0:08:39.61,0:08:40.54,,NTP,0000,0000,0000,,Қорқынышты
Dialogue: 0,0:08:42.79,0:08:45.64,,NTP,0000,0000,0000,,Мен күңкілдегенді ұнатпаймын.
Dialogue: 0,0:08:49.86,0:08:52.39,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:08:52.87,0:08:55.51,,NTP,0000,0000,0000,,Мен сүтке өте ризамын
Dialogue: 0,0:08:55.80,0:08:58.60,,NTP,0000,0000,0000,,Ойнағаннан кейін
Dialogue: 0,0:08:59.11,0:09:02.50,,NTP,0000,0000,0000,,Сипағанын жақсы сезіну
Dialogue: 0,0:09:02.54,0:09:04.98,,NTP,0000,0000,0000,,Мен оны аламын.
Dialogue: 0,0:09:05.32,0:09:08.18,,NTP,0000,0000,0000,,Дәмді тағамы бар бонбон
Dialogue: 0,0:09:08.96,0:09:14.03,,NTP,0000,0000,0000,,Бақытты жатып
Dialogue: 0,0:09:14.50,0:09:17.09,,NTP,0000,0000,0000,,Ролл~
Dialogue: 0,0:09:28.98,0:09:30.01,,NTP,0000,0000,0000,,Электр қуатын өшіру
Dialogue: 0,0:09:30.89,0:09:32.64,,NTP,0000,0000,0000,,Бұл қорқынышты
Dialogue: 0,0:09:33.10,0:09:36.68,,NTP,0000,0000,0000,,Қол шамыңызды қайда қойдыңыз?
Dialogue: 0,0:09:37.00,0:09:38.18,,NTP,0000,0000,0000,,Ол қайда?
Dialogue: 0,0:09:39.09,0:09:40.89,,NTP,0000,0000,0000,,Менің ойымша, бұл осында болды ...
Dialogue: 0,0:09:46.24,0:09:48.85,,NTP,0000,0000,0000,,Мияу, жоқ!
Dialogue: 0,0:09:51.01,0:09:53.32,,NTP,0000,0000,0000,,Тынышталыңыз, Чи.
Dialogue: 0,0:09:55.21,0:09:57.11,,NTP,0000,0000,0000,,Әке, сіз не істеп жатырсыз?
Dialogue: 0,0:09:57.99,0:09:59.33,,NTP,0000,0000,0000,,Тек болжамға сүйеніп осындай қауіпті тәуекелге бара аламыз ба?
Dialogue: 0,0:10:05.44,0:10:06.17,,NTP,0000,0000,0000,,Жарайды
Dialogue: 0,0:10:07.24,0:10:08.98,,NTP,0000,0000,0000,,Мияу Мияу
Dialogue: 0,0:10:09.54,0:10:10.66,,NTP,0000,0000,0000,,О?
Dialogue: 0,0:10:13.09,0:10:14.12,,NTP,0000,0000,0000,,Мияу Мияу
Dialogue: 0,0:10:15.70,0:10:16.30,,NTP,0000,0000,0000,,О.
Dialogue: 0,0:10:22.30,0:10:23.68,,NTP,0000,0000,0000,,Qi ойнау
Dialogue: 0,0:10:24.58,0:10:26.70,,NTP,0000,0000,0000,,О, бұл қызық сияқты.
Dialogue: 0,0:10:27.05,0:10:33.76,,NTP,0000,0000,0000,,Қара, қара, қара, міне.
Dialogue: 0,0:10:36.21,0:10:37.89,,NTP,0000,0000,0000,,Мен де істеймін
Dialogue: 0,0:10:41.64,0:10:44.78,,NTP,0000,0000,0000,,Мен де, қараңыз.
Dialogue: 0,0:10:45.30,0:10:47.77,,NTP,0000,0000,0000,,Мияу Мияу
Dialogue: 0,0:10:58.80,0:11:01.34,,NTP,0000,0000,0000,,Электр қуатының үзілуі анда-санда жақсы нәрсе.
Dialogue: 0,0:11:05.59,0:11:07.36,,NTP,0000,0000,0000,,Электр қосылды
Dialogue: 0,0:11:07.46,0:11:08.70,,NTP,0000,0000,0000,,Жақсы
Dialogue: 0,0:11:10.41,0:11:13.33,,NTP,0000,0000,0000,,Не? Ол жоғалып кетті.
Dialogue: 0,0:11:14.04,0:11:15.92,,NTP,0000,0000,0000,,Кездейсоқ
Dialogue: 0,0:11:16.35,0:11:18.24,,NTP,0000,0000,0000,,Сіз әлі де ойнағыңыз келе ме?
Dialogue: 0,0:11:18.85,0:11:19.88,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:11:25.87,0:11:27.46,,NTP,0000,0000,0000,,А, олжа.
Dialogue: 0,0:11:28.58,0:11:34.67,,NTP,0000,0000,0000,,Қызықты Қызықты
Dialogue: 0,0:11:45.92,0:11:48.37,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:11:48.68,0:11:51.49,,NTP,0000,0000,0000,,Мен сүтке ризамын
Dialogue: 0,0:11:51.96,0:11:54.72,,NTP,0000,0000,0000,,Ойнағаннан кейін
Dialogue: 0,0:11:55.21,0:11:58.37,,NTP,0000,0000,0000,,Сипалғанды жақсы сезіну
Dialogue: 0,0:11:58.56,0:12:00.88,,NTP,0000,0000,0000,,Мен оны аламын.
Dialogue: 0,0:12:01.35,0:12:04.22,,NTP,0000,0000,0000,,Дәмді тағамы бар бонбон
Dialogue: 0,0:12:05.21,0:12:10.28,,NTP,0000,0000,0000,,Жатып, бақытты болу
Dialogue: 0,0:12:10.45,0:12:13.14,,NTP,0000,0000,0000,,Ролл~
Dialogue: 0,0:12:21.56,0:12:24.21,,NTP,0000,0000,0000,,Иә? Онда ешкім жоқ.
Dialogue: 0,0:12:25.66,0:12:32.59,,NTP,0000,0000,0000,,Күткендей қызуым көтеріліп тұр. Менің ойымша, бүгін балабақшадан бас тартқаныңыз дұрыс болар еді.
Dialogue: 0,0:12:33.67,0:12:34.81,,NTP,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:12:35.19,0:12:36.83,,NTP,0000,0000,0000,,Мен барамын
Dialogue: 0,0:12:42.28,0:12:46.91,,NTP,0000,0000,0000,,Иә, қызуыңыз көтеріліп тұрған сияқты, иә.
Dialogue: 0,0:12:48.18,0:12:50.22,,NTP,0000,0000,0000,,Чи Чи бұрынғыдай жігерлі.
Dialogue: 0,0:12:50.43,0:12:51.85,,NTP,0000,0000,0000,,Юхэ ойнайды
Dialogue: 0,0:12:53.23,0:12:54.49,,NTP,0000,0000,0000,,О, суық.
Dialogue: 0,0:12:55.53,0:12:57.50,,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:12:58.22,0:13:01.80,,NTP,0000,0000,0000,,Чи: Жоқ, Юхэй ауырып жатыр.
Dialogue: 0,0:13:01.84,0:13:03.96,,NTP,0000,0000,0000,,Бүгін сен тынышсыз.
Dialogue: 0,0:13:04.61,0:13:05.74,,NTP,0000,0000,0000,,Ши-йо
Dialogue: 0,0:13:14.06,0:13:16.82,,NTP,0000,0000,0000,,Мен ойнағым келді
Dialogue: 0,0:13:29.58,0:13:31.76,,NTP,0000,0000,0000,,Йохай, сен ойнамайсың ба?
Dialogue: 0,0:13:38.63,0:13:39.80,,NTP,0000,0000,0000,,Чи, сен сондай тынышсың.
Dialogue: 0,0:13:40.15,0:13:44.09,,NTP,0000,0000,0000,,Чи Юхэидің ауырып жатқанын біледі ме деп ойлаймын.
Dialogue: 0,0:13:51.52,0:13:53.13,,NTP,0000,0000,0000,,Йохеи, жақсысың ба?
Dialogue: 0,0:13:56.65,0:13:58.74,,NTP,0000,0000,0000,,О, егер бұл Чи болса...
Dialogue: 0,0:13:59.28,0:14:01.12,,NTP,0000,0000,0000,,Біз бірге ұйықтап жатырмыз.
Dialogue: 0,0:14:02.89,0:14:07.11,,NTP,0000,0000,0000,,Мен бүгін ойнай алмадым, сондықтан сіз қызықты түс көріп жатырсыз деп үміттенемін.
Dialogue: 0,0:14:07.57,0:14:08.61,,NTP,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:14:24.96,0:14:27.24,,NTP,0000,0000,0000,,Мияу Мияу
Dialogue: 0,0:14:33.47,0:14:35.46,,NTP,0000,0000,0000,,Панпан
Dialogue: 0,0:14:41.89,0:14:44.46,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:14:44.76,0:14:47.69,,NTP,0000,0000,0000,,Мен сүтке өте ризамын
Dialogue: 0,0:14:48.04,0:14:50.67,,NTP,0000,0000,0000,,Ойнағаннан кейін
Dialogue: 0,0:14:51.23,0:14:54.52,,NTP,0000,0000,0000,,Сипалғанды жақсы сезіну
Dialogue: 0,0:14:54.79,0:14:57.21,,NTP,0000,0000,0000,,Мен оны аламын.
Dialogue: 0,0:14:57.41,0:15:00.32,,NTP,0000,0000,0000,,Дәмді тағамы бар бонбон
Dialogue: 0,0:15:00.81,0:15:06.13,,NTP,0000,0000,0000,,Бақытты жату
Dialogue: 0,0:15:06.72,0:15:09.05,,NTP,0000,0000,0000,,Ролл~
Dialogue: 0,0:15:11.92,0:15:14.35,,NTP,0000,0000,0000,,Анашым, не болды?
Dialogue: 0,0:15:14.87,0:15:19.35,,NTP,0000,0000,0000,,Мен Йохэй емделді деп ойладым, бірақ қазір оның анасы суық тиіп қалды.
Dialogue: 0,0:15:19.59,0:15:20.83,,NTP,0000,0000,0000,,Амансың ба?
Dialogue: 0,0:15:21.20,0:15:23.85,,NTP,0000,0000,0000,,Ұйықтасаң, тез жазылып кетесің.
Dialogue: 0,0:15:24.44,0:15:26.18,,NTP,0000,0000,0000,,Мен біраз уақытқа шығуым керек.
Dialogue: 0,0:15:26.57,0:15:29.85,,NTP,0000,0000,0000,,Үйге ерте кел, мен кешкі ас әзірлеймін.
Dialogue: 0,0:15:30.42,0:15:31.78,,NTP,0000,0000,0000,,Рахмет~
Dialogue: 0,0:15:32.51,0:15:34.18,,NTP,0000,0000,0000,,Барлығы не болды?
Dialogue: 0,0:15:35.25,0:15:38.89,,NTP,0000,0000,0000,,Жарайды, мен жұмысқа барамын, сондықтан үйде отыруыңызды өтінемін.
Dialogue: 0,0:15:44.97,0:15:48.63,,NTP,0000,0000,0000,,Юхэй Қызық екен, мияу.
Dialogue: 0,0:15:49.18,0:15:50.17,,NTP,0000,0000,0000,,Ши-
Dialogue: 0,0:15:50.41,0:15:51.81,,NTP,0000,0000,0000,,Не болды? Йохеи
Dialogue: 0,0:15:53.25,0:15:55.49,,NTP,0000,0000,0000,,Амансың ба, мама?
Dialogue: 0,0:16:01.99,0:16:04.43,,NTP,0000,0000,0000,,Аа, мен орынды ауыстыруым керек.
Dialogue: 0,0:16:13.50,0:16:15.49,,NTP,0000,0000,0000,,Йохеи, сен не істеп жатырсың?
Dialogue: 0,0:16:18.74,0:16:19.74,,NTP,0000,0000,0000,,Қолымнан келгеннің бәрін жасадым
Dialogue: 0,0:16:22.88,0:16:24.18,,NTP,0000,0000,0000,,(Айзава) Сондықтан мен қабылдау емтиханы логикаға жат дедім
Dialogue: 0,0:16:28.33,0:16:29.90,,NTP,0000,0000,0000,,Юхэй үлкен
Dialogue: 0,0:16:30.56,0:16:35.81,,NTP,0000,0000,0000,,Не? иә? Суық
Dialogue: 0,0:16:42.44,0:16:43.42,,NTP,0000,0000,0000,,Мен мұны істедім
Dialogue: 0,0:16:45.11,0:16:45.91,,NTP,0000,0000,0000,,Мияу
Dialogue: 0,0:16:49.23,0:16:50.14,,NTP,0000,0000,0000,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:16:51.07,0:16:52.27,,NTP,0000,0000,0000,,Амансың ба?
Dialogue: 0,0:16:52.62,0:16:53.25,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:16:54.74,0:16:57.73,,NTP,0000,0000,0000,,Йохеи Бұл қауіпті.
Dialogue: 0,0:16:59.40,0:17:01.19,,NTP,0000,0000,0000,,Өйткені мен...
Dialogue: 0,0:17:01.74,0:17:03.69,,NTP,0000,0000,0000,,Жерде не болады?
Dialogue: 0,0:17:08.41,0:17:11.99,,NTP,0000,0000,0000,,Йохеи... Анаң үшін бе?
Dialogue: 0,0:17:13.01,0:17:14.70,,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:17:15.79,0:17:18.34,,NTP,0000,0000,0000,,Йохай Рахмет
Dialogue: 0,0:17:18.83,0:17:19.86,,NTP,0000,0000,0000,,Ә? (Кения) Сен➡
Dialogue: 0,0:17:21.70,0:17:22.65,,NTP,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:17:23.82,0:17:28.79,,NTP,0000,0000,0000,,Үшеулерің жақсы дос болғандарың керемет...
Dialogue: 0,0:17:38.02,0:17:40.63,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:17:40.87,0:17:43.81,,NTP,0000,0000,0000,,Мен сүтке өте ризамын
Dialogue: 0,0:17:43.95,0:17:46.73,,NTP,0000,0000,0000,,Ойнағаннан кейін
Dialogue: 0,0:17:47.30,0:17:50.56,,NTP,0000,0000,0000,,Сипалғанды жақсы сезіну
Dialogue: 0,0:17:50.68,0:17:53.03,,NTP,0000,0000,0000,,Мен оны аламын
Dialogue: 0,0:17:53.46,0:17:56.34,,NTP,0000,0000,0000,,Дәмді тағам қосылған бонбон
Dialogue: 0,0:17:57.08,0:18:01.96,,NTP,0000,0000,0000,,Бақытты жатып
Dialogue: 0,0:18:02.74,0:18:05.25,,NTP,0000,0000,0000,,Ролл~
Dialogue: 0,0:18:08.02,0:18:12.89,,NTP,0000,0000,0000,,Ей, анаңның салқыны жазылып кеткеніне қуаныштымын.
Dialogue: 0,0:18:13.58,0:18:16.25,,NTP,0000,0000,0000,,Қазір біздің үй толығымен қалпына келді.
Dialogue: 0,0:18:16.71,0:18:18.83,,NTP,0000,0000,0000,,Сыртқа шығатын уақыт болды, Йохеи.
Dialogue: 0,0:18:19.50,0:18:20.41,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:18:21.57,0:18:22.95,,NTP,0000,0000,0000,,Мен барамын
Dialogue: 0,0:18:23.19,0:18:24.18,,NTP,0000,0000,0000,,Мен барамын
Dialogue: 0,0:18:24.55,0:18:25.94,,NTP,0000,0000,0000,,О, келіңдер.
Dialogue: 0,0:18:26.83,0:18:30.20,,NTP,0000,0000,0000,,Олай болса, Чи.
Dialogue: 0,0:18:30.56,0:18:31.44,,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:18:31.72,0:18:34.04,,NTP,0000,0000,0000,,Мен онымен біраз уақыт ойнамадым.
Dialogue: 0,0:18:33.89,0:18:36.07,,NTP,0000,0000,0000,,Жарайды, жарайды, жарайды.
Dialogue: 0,0:18:36.66,0:18:38.87,,NTP,0000,0000,0000,,Міне.
Dialogue: 0,0:18:39.47,0:18:42.37,,NTP,0000,0000,0000,,Бүгін мен тойғанша ойнаймын.
Dialogue: 0,0:18:40.02,0:18:42.98,,NTP,0000,0000,0000,,Ал, күт, күт.
Dialogue: 0,0:18:45.28,0:18:46.87,,NTP,0000,0000,0000,,Міне…
Dialogue: 0,0:18:47.04,0:18:53.33,,NTP,0000,0000,0000,,Мияу мияу күт күт күт
Dialogue: 0,0:18:51.90,0:18:54.48,,NTP,0000,0000,0000,,Бұл көңілді ме?
Dialogue: 0,0:18:56.25,0:18:57.55,,NTP,0000,0000,0000,,Мияу
Dialogue: 0,0:18:59.23,0:19:02.72,,NTP,0000,0000,0000,,Бұл біртүрлі нәрсе. Ол дірілдеп тұр.
Dialogue: 0,0:19:03.83,0:19:07.50,,NTP,0000,0000,0000,,Мүмкін... суық тиген шығар?
Dialogue: 0,0:19:09.68,0:19:11.67,,NTP,0000,0000,0000,,Иә... өте ыстық...
Dialogue: 0,0:19:11.89,0:19:13.82,,NTP,0000,0000,0000,,Әке, көбірек ойнайық
Dialogue: 0,0:19:15.91,0:19:17.25,,NTP,0000,0000,0000,,Кешіріңіз Чи
Dialogue: 0,0:19:18.59,0:19:19.21,,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:19:21.95,0:19:24.42,,NTP,0000,0000,0000,,Мен денсаулығыма сенімді болдым.
Dialogue: 0,0:19:27.35,0:19:28.20,,NTP,0000,0000,0000,,Мияу Мияу
Dialogue: 0,0:19:27.20,0:19:29.69,,NTP,0000,0000,0000,,Ой, бұл ойыншық емес.
Dialogue: 0,0:19:34.04,0:19:35.67,,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:19:37.40,0:19:38.57,,NTP,0000,0000,0000,,Мияу
Dialogue: 0,0:19:39.00,0:19:40.24,,NTP,0000,0000,0000,,Чи…
Dialogue: 0,0:19:40.76,0:19:42.16,,NTP,0000,0000,0000,,Мұнда және мұнда
Dialogue: 0,0:19:42.81,0:19:44.41,,NTP,0000,0000,0000,,Мен мұны істедім
Dialogue: 0,0:19:46.22,0:19:47.38,,NTP,0000,0000,0000,,Ұсталды~
Dialogue: 0,0:19:47.71,0:19:50.28,,NTP,0000,0000,0000,,Ци, оны маған қайтар.
Dialogue: 0,0:19:50.87,0:19:54.56,,NTP,0000,0000,0000,,Әй, мені тартып жатыр, тартады, тартады.
Dialogue: 0,0:19:55.46,0:19:58.30,,NTP,0000,0000,0000,,Ци, менде қызба бар.
Dialogue: 0,0:19:58.74,0:20:00.21,,NTP,0000,0000,0000,,Оны қайтарыңыз.
Dialogue: 0,0:19:58.82,0:20:00.15,,NTP,0000,0000,0000,,Көңілді~
Dialogue: 0,0:20:02.82,0:20:04.16,,NTP,0000,0000,0000,,Өтінемін...
Dialogue: 0,0:20:12.20,0:20:13.91,,NTP,0000,0000,0000,,Әкем жеңеді
Dialogue: 0,0:20:18.23,0:20:19.81,,NTP,0000,0000,0000,,Мияу~
Dialogue: 0,0:20:22.51,0:20:25.41,,NTP,0000,0000,0000,,Менде жағымсыз сезім бар.
Dialogue: 0,0:20:28.17,0:20:30.18,,NTP,0000,0000,0000,,Келесі Сіз не ойнап жатырсыз?
Dialogue: 0,0:20:34.02,0:20:36.66,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:20:36.85,0:20:39.94,,NTP,0000,0000,0000,,Мен сүтке өте ризамын
Dialogue: 0,0:20:40.13,0:20:43.00,,NTP,0000,0000,0000,,Ойнағаннан кейін
Dialogue: 0,0:20:43.26,0:20:46.60,,NTP,0000,0000,0000,,Сипалғанды жақсы сезіну
Dialogue: 0,0:20:46.70,0:20:49.16,,NTP,0000,0000,0000,,Мен оны аламын.
Dialogue: 0,0:20:49.67,0:20:52.64,,NTP,0000,0000,0000,,Дәмді тағам қосылған бонбон
Dialogue: 0,0:20:53.05,0:20:58.09,,NTP,0000,0000,0000,,Бақытты жату
Dialogue: 0,0:20:58.72,0:21:01.23,,NTP,0000,0000,0000,,Ролл~
Dialogue: 0,0:21:04.07,0:21:07.95,,NTP,0000,0000,0000,,Барлығы жоқта қалай суық тиюге болады?
Dialogue: 0,0:21:09.32,0:21:13.26,,NTP,0000,0000,0000,,Мен саған су беремін.
Dialogue: 0,0:21:32.15,0:21:38.65,,NTP,0000,0000,0000,,Ци, кешіріңіз, бірақ бүгін менің бөлмеме кірмеңіз.
Dialogue: 0,0:21:39.54,0:21:45.24,,NTP,0000,0000,0000,,Мияу Мяу әке, не болды? Әке...
Dialogue: 0,0:21:48.75,0:21:50.40,,NTP,0000,0000,0000,,Кешіріңіз Чи
Dialogue: 0,0:21:50.75,0:21:53.58,,NTP,0000,0000,0000,,Әкем әке...
Dialogue: 0,0:21:58.89,0:22:01.96,,NTP,0000,0000,0000,,О, ақыры тыныш...
Dialogue: 0,0:22:02.56,0:22:04.58,,NTP,0000,0000,0000,,Енді мен тыныш ұйықтай аламын
Dialogue: 0,0:22:05.99,0:22:07.90,,NTP,0000,0000,0000,,Ха ха жем.
Dialogue: 0,0:22:09.26,0:22:12.45,,NTP,0000,0000,0000,,Әке, әке, мен олжаны ұстадым~
Dialogue: 0,0:22:15.56,0:22:17.66,,NTP,0000,0000,0000,,Сабыр, сабыр, басқа күн жақсырақ.
Dialogue: 0,0:22:18.09,0:22:19.40,,NTP,0000,0000,0000,,Мияу Мияу
Dialogue: 0,0:22:26.66,0:22:30.21,,NTP,0000,0000,0000,,Тыныш, тыныш.
Dialogue: 0,0:22:36.43,0:22:38.14,,NTP,0000,0000,0000,,Әке, не?
Dialogue: 0,0:22:48.56,0:22:51.73,,NTP,0000,0000,0000,,Егер сен менен көзіңді алсаң, мен не істерімді білмеймін.
Dialogue: 0,0:22:54.92,0:22:56.90,,NTP,0000,0000,0000,,Әке, ойнайық
Dialogue: 0,0:23:02.50,0:23:03.86,,NTP,0000,0000,0000,,(Роко) Куфуфуфу. Мақтаның жараланды ма?
Dialogue: 0,0:23:04.23,0:23:05.48,,NTP,0000,0000,0000,,Күтіңіз, күтіңіз
Dialogue: 0,0:23:08.77,0:23:09.95,,NTP,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:23:10.68,0:23:13.44,,NTP,0000,0000,0000,,Әкең де суық тиіп қалыпты.
Dialogue: 0,0:23:14.07,0:23:15.95,,NTP,0000,0000,0000,,Чи, сен тыныш ұйықтап жатырсың.
Dialogue: 0,0:23:16.98,0:23:19.82,,NTP,0000,0000,0000,,Жоқ, мен оны ақыры ұйықтаттым.
Dialogue: 0,0:23:20.09,0:23:20.90,,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:23:29.91,0:23:32.63,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:23:32.93,0:23:35.78,,NTP,0000,0000,0000,,Мен сүтке ризамын
Dialogue: 0,0:23:36.09,0:23:38.61,,NTP,0000,0000,0000,,Ойнағаннан кейін
Dialogue: 0,0:23:39.21,0:23:42.49,,NTP,0000,0000,0000,,Сипалғанды жақсы сезіну
Dialogue: 0,0:23:42.94,0:23:45.31,,NTP,0000,0000,0000,,Мен оны аламын.
Dialogue: 0,0:23:45.57,0:23:48.58,,NTP,0000,0000,0000,,Дәмді тағамы бар бонбон
Dialogue: 0,0:23:49.20,0:23:54.49,,NTP,0000,0000,0000,,Жатып, бақытты болу
Dialogue: 0,0:23:54.77,0:23:57.28,,NTP,0000,0000,0000,,Ролл~
Dialogue: 0,0:24:02.45,0:24:03.19,,NTP,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:24:03.63,0:24:05.20,,NTP,0000,0000,0000,,Қош келдіңіз~
Dialogue: 0,0:24:06.09,0:24:07.56,,NTP,0000,0000,0000,,Чи Бұл кәдесый.
Dialogue: 0,0:24:08.09,0:24:09.06,,NTP,0000,0000,0000,,Не? Бұл?
Dialogue: 0,0:24:09.44,0:24:12.02,,NTP,0000,0000,0000,,Бұл краб камабоко, мысық тағамдары.
Dialogue: 0,0:24:12.82,0:24:13.74,,NTP,0000,0000,0000,,Тағам?
Dialogue: 0,0:24:14.22,0:24:18.05,,NTP,0000,0000,0000,,Қарашы, Чи, дәмді екен.
Dialogue: 0,0:24:25.23,0:24:27.04,,NTP,0000,0000,0000,,Дәмді~
Dialogue: 0,0:24:27.99,0:24:30.28,,NTP,0000,0000,0000,,Солай ма? Жақсы ма?
Dialogue: 0,0:24:30.35,0:24:31.81,,NTP,0000,0000,0000,,Мен де бергім келеді
Dialogue: 0,0:24:34.02,0:24:34.89,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:24:42.48,0:24:44.32,,NTP,0000,0000,0000,,Әке көбірек
Dialogue: 0,0:24:44.43,0:24:46.79,,NTP,0000,0000,0000,,Жарайды, жарайды.
Dialogue: 0,0:24:49.78,0:24:51.83,,NTP,0000,0000,0000,,Бұл дәмді.
Dialogue: 0,0:24:51.97,0:24:56.03,,NTP,0000,0000,0000,,Тікелей тамақты көп жесеңіз, тамақ іше алмайсыз.
Dialogue: 0,0:24:56.60,0:24:58.61,,NTP,0000,0000,0000,,Юхэй мен Чи үшін де солай шығар.
Dialogue: 0,0:24:59.23,0:25:00.84,,NTP,0000,0000,0000,,Иә, дұрыс.
Dialogue: 0,0:25:01.21,0:25:03.08,,NTP,0000,0000,0000,,Чи Ертең кездескенше.
Dialogue: 0,0:25:03.82,0:25:06.19,,NTP,0000,0000,0000,,Әке көбірек
Dialogue: 0,0:25:06.51,0:25:08.04,,NTP,0000,0000,0000,,Тағы бір нәрсе
Dialogue: 0,0:25:08.34,0:25:09.34,,NTP,0000,0000,0000,,Әке!
Dialogue: 0,0:25:10.54,0:25:12.15,,NTP,0000,0000,0000,,Манга салмас бұрын жаттығулар
Dialogue: 0,0:25:16.09,0:25:18.96,,NTP,0000,0000,0000,,Әке, маған сыйлық беріңізші.
Dialogue: 0,0:25:19.66,0:25:21.96,,NTP,0000,0000,0000,,Қараңдаршы, бұл Чидің тамағы.
Dialogue: 0,0:25:24.46,0:25:26.09,,NTP,0000,0000,0000,,Маған бұл ұнамайды.
Dialogue: 0,0:25:26.53,0:25:27.30,,NTP,0000,0000,0000,,Чи…
Dialogue: 0,0:25:28.38,0:25:31.18,,NTP,0000,0000,0000,,Әкемде тым көп тағамдар бар.
Dialogue: 0,0:25:31.50,0:25:32.29,,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:25:32.60,0:25:33.92,,NTP,0000,0000,0000,,Мияу мияу~
Dialogue: 0,0:25:34.57,0:25:35.44,,NTP,0000,0000,0000,,Жоқ, жоқ
Dialogue: 0,0:25:35.67,0:25:39.52,,NTP,0000,0000,0000,,Чи, сен тамақ ішпесең, мен жинаймын.
Dialogue: 0,0:25:40.91,0:25:43.25,,NTP,0000,0000,0000,,Бұл дәмді.
Dialogue: 0,0:25:44.01,0:25:45.79,,NTP,0000,0000,0000,,Қалағаныңды істе...
Dialogue: 0,0:25:47.94,0:25:49.67,,NTP,0000,0000,0000,,Қайырлы түн
Dialogue: 0,0:25:59.05,0:26:00.59,,NTP,0000,0000,0000,,Соңғы жебеге айналғанша...
Dialogue: 0,0:26:01.97,0:26:06.83,,NTP,0000,0000,0000,,Qi Сіз аш болуыңыз керек Иә.
Dialogue: 0,0:26:08.21,0:26:09.56,,NTP,0000,0000,0000,,Анам…
Dialogue: 0,0:26:10.18,0:26:14.59,,NTP,0000,0000,0000,,Тікелей тамақ жемей, жақсы тамақтаныңыз
Dialogue: 0,0:26:14.90,0:26:16.93,,NTP,0000,0000,0000,,Ол үлкен және сау болады~
Dialogue: 0,0:26:17.62,0:26:20.84,,NTP,0000,0000,0000,,Бұл дәмді, анашым.
Dialogue: 0,0:26:26.12,0:26:28.62,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:26:28.89,0:26:32.05,,NTP,0000,0000,0000,,Мен сүтке өте ризамын
Dialogue: 0,0:26:32.46,0:26:35.03,,NTP,0000,0000,0000,,Ойнағаннан кейін
Dialogue: 0,0:26:35.31,0:26:38.60,,NTP,0000,0000,0000,,Сілтемені жақсы сезіну
Dialogue: 0,0:26:38.95,0:26:41.45,,NTP,0000,0000,0000,,Мен оны аламын
Dialogue: 0,0:26:41.79,0:26:44.75,,NTP,0000,0000,0000,,Дәмді тағамы бар бонбон
Dialogue: 0,0:26:45.35,0:26:50.16,,NTP,0000,0000,0000,,Жатып, бақытты болу
Dialogue: 0,0:26:50.68,0:26:53.29,,NTP,0000,0000,0000,,Ролл~
Dialogue: 0,0:26:58.37,0:26:59.49,,NTP,0000,0000,0000,,Қызықты
Dialogue: 0,0:26:59.66,0:27:01.09,,NTP,0000,0000,0000,,Эй Чи
Dialogue: 0,0:27:01.64,0:27:03.93,,NTP,0000,0000,0000,,Тазалау кезінде маған кедергі жасама
Dialogue: 0,0:27:02.56,0:27:03.84,,NTP,0000,0000,0000,,Бұл не? Бұл не?
Dialogue: 0,0:27:04.87,0:27:05.57,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:27:05.73,0:27:07.73,,NTP,0000,0000,0000,,Біз де чи ойынын ойнайық
Dialogue: 0,0:27:07.93,0:27:09.29,,NTP,0000,0000,0000,,Шығарылым
Dialogue: 0,0:27:14.10,0:27:16.23,,NTP,0000,0000,0000,,Мен таң қалдым.
Dialogue: 0,0:27:16.91,0:27:18.39,,NTP,0000,0000,0000,,Амансың ба? Чи
Dialogue: 0,0:27:19.52,0:27:21.85,,NTP,0000,0000,0000,,Анашым, сізбен кездескім келмейді.
Dialogue: 0,0:27:22.06,0:27:22.76,,NTP,0000,0000,0000,,Чи…
Dialogue: 0,0:27:24.53,0:27:26.86,,NTP,0000,0000,0000,,Циді жек көру қаншалықты азап екенін білесің.
Dialogue: 0,0:27:27.31,0:27:27.90,,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:27:28.25,0:27:32.55,,NTP,0000,0000,0000,,Оны ветеринарлық ауруханаға жеткізгеннен кейін қалай ауырды...
Dialogue: 0,0:27:32.81,0:27:34.11,,NTP,0000,0000,0000,,Жарайды.
Dialogue: 0,0:27:34.29,0:27:34.80,,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:27:35.05,0:27:37.56,,NTP,0000,0000,0000,,Чи сәл таң қалды.
Dialogue: 0,0:27:38.26,0:27:40.68,,NTP,0000,0000,0000,,Оны ұмытып, кері қайтыңыз
Dialogue: 0,0:27:41.28,0:27:42.48,,NTP,0000,0000,0000,,Әке, кеттік.
Dialogue: 0,0:27:42.85,0:27:45.96,,NTP,0000,0000,0000,,Эй, мен кітап дүкеніне барамын.
Dialogue: 0,0:27:48.58,0:27:50.04,,NTP,0000,0000,0000,,Кеттік
Dialogue: 0,0:27:53.36,0:27:55.91,,NTP,0000,0000,0000,,Чи, бұрын болғаны үшін кешірім сұраймын.
Dialogue: 0,0:27:56.23,0:27:57.00,,NTP,0000,0000,0000,,Жасалайық
Dialogue: 0,0:27:57.19,0:28:00.56,,NTP,0000,0000,0000,,Жоқ, жоқ, мен анамды ұнатпаймын.
Dialogue: 0,0:28:00.87,0:28:02.87,,NTP,0000,0000,0000,,Бұл соншалықты қорқынышты болды ма?
Dialogue: 0,0:28:03.51,0:28:04.06,,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:28:04.80,0:28:08.21,,NTP,0000,0000,0000,,Қараңдаршы, қараңдаршы, қызық екен.
Dialogue: 0,0:28:11.08,0:28:13.65,,NTP,0000,0000,0000,,Жоқ, мен сені тағы кездестіремін.
Dialogue: 0,0:28:13.85,0:28:15.02,,NTP,0000,0000,0000,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:28:15.93,0:28:17.01,,NTP,0000,0000,0000,,Бұл туралы не деуге болады?
Dialogue: 0,0:28:18.91,0:28:19.91,,NTP,0000,0000,0000,,Хоорахо хора
Dialogue: 0,0:28:26.70,0:28:30.28,,NTP,0000,0000,0000,,Чи, мен саған тамақ берейін, жүр.
Dialogue: 0,0:28:31.07,0:28:33.01,,NTP,0000,0000,0000,,А, дәмді тағам
Dialogue: 0,0:28:33.22,0:28:34.76,,NTP,0000,0000,0000,,(Роко) Куфуфуфу. Мақтаның жараланды ма?
Dialogue: 0,0:28:37.09,0:28:37.56,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:28:45.76,0:28:47.64,,NTP,0000,0000,0000,,Дәмді
Dialogue: 0,0:28:48.08,0:28:50.72,,NTP,0000,0000,0000,,Эй, мен саған көбірек беремін.
Dialogue: 0,0:28:52.95,0:28:53.90,,NTP,0000,0000,0000,,Дәмді~
Dialogue: 0,0:28:56.36,0:28:58.00,,NTP,0000,0000,0000,,Жақсы
Dialogue: 0,0:28:59.16,0:29:00.66,,NTP,0000,0000,0000,,Сізге жақсылық, анашым.
Dialogue: 0,0:29:01.15,0:29:02.70,,NTP,0000,0000,0000,,Иә... иә?
Dialogue: 0,0:29:02.98,0:29:05.52,,NTP,0000,0000,0000,,Әкем әмиянды ұмытып қалды.
Dialogue: 0,0:29:06.06,0:29:09.12,,NTP,0000,0000,0000,,Өйткені, Чидің жек көруі өте азапты~
Dialogue: 0,0:29:14.86,0:29:17.05,,NTP,0000,0000,0000,,Ана көбірек
Dialogue: 0,0:29:22.26,0:29:24.76,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:29:24.88,0:29:28.01,,NTP,0000,0000,0000,,Мен сүтке өте ризамын
Dialogue: 0,0:29:28.37,0:29:31.11,,NTP,0000,0000,0000,,Ойнағаннан кейін
Dialogue: 0,0:29:31.38,0:29:34.79,,NTP,0000,0000,0000,,Сипалғанды жақсы сезіну
Dialogue: 0,0:29:34.85,0:29:37.26,,NTP,0000,0000,0000,,Мен оны аламын.
Dialogue: 0,0:29:37.95,0:29:40.76,,NTP,0000,0000,0000,,Дәмді тағамы бар бонбон
Dialogue: 0,0:29:41.30,0:29:46.17,,NTP,0000,0000,0000,,Жатып, бақытты болу
Dialogue: 0,0:29:46.98,0:29:48.98,,NTP,0000,0000,0000,,Ролл~
Dialogue: 0,0:29:51.41,0:29:51.41,,NTP,0000,0000,0000,,Мияу
Dialogue: 0,0:29:52.05,0:29:54.83,,NTP,0000,0000,0000,,Мынаны алыңыз.
Dialogue: 0,0:29:58.42,0:29:59.47,,NTP,0000,0000,0000,,Қ-Қандай?
Dialogue: 0,0:30:00.22,0:30:01.74,,NTP,0000,0000,0000,,Иә... бұл жақсы.
Dialogue: 0,0:30:02.02,0:30:04.41,,NTP,0000,0000,0000,,Сынып жиналысынан бері біраз уақыт өтті.
Dialogue: 0,0:30:04.93,0:30:06.25,,NTP,0000,0000,0000,,Рухың болмаса
Dialogue: 0,0:30:06.64,0:30:09.33,,NTP,0000,0000,0000,,Енді, түзетіп, жасаңдар.
Dialogue: 0,0:30:12.85,0:30:13.68,,NTP,0000,0000,0000,,Мияу Мияу
Dialogue: 0,0:30:17.97,0:30:19.08,,NTP,0000,0000,0000,,Мен шыдай алмаймын...
Dialogue: 0,0:30:23.63,0:30:24.99,,NTP,0000,0000,0000,,Қолымнан келгеннің бәрін жасадым
Dialogue: 0,0:30:27.88,0:30:31.00,,NTP,0000,0000,0000,,Анашым, Чидің ойыншығын ала аласыз ба?
Dialogue: 0,0:30:31.40,0:30:34.45,,NTP,0000,0000,0000,,Ойыншық? Күте тұрыңыз.
Dialogue: 0,0:30:37.99,0:30:38.47,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:30:38.64,0:30:39.80,,NTP,0000,0000,0000,,Рахмет~
Dialogue: 0,0:30:40.64,0:30:42.82,,NTP,0000,0000,0000,,Енді дайындал...
Dialogue: 0,0:30:43.59,0:30:44.34,,NTP,0000,0000,0000,,Қараңызшы, Чи.
Dialogue: 0,0:30:48.97,0:30:50.96,,NTP,0000,0000,0000,,Иә, орындалды
Dialogue: 0,0:30:51.48,0:30:53.04,,NTP,0000,0000,0000,,Енді сақина
Dialogue: 0,0:30:54.31,0:31:00.44,,NTP,0000,0000,0000,,Егер есімде дұрыс болса, мен оны ертерек осы жерден алып тастадым.
Dialogue: 0,0:31:01.44,0:31:06.47,,NTP,0000,0000,0000,,Иә, неге жоқ?
Dialogue: 0,0:31:10.91,0:31:11.80,,NTP,0000,0000,0000,,Бұл бар ма?
Dialogue: 0,0:31:12.51,0:31:14.39,,NTP,0000,0000,0000,,Жоқ... жоқ... жоқ!
Dialogue: 0,0:31:15.50,0:31:18.50,,NTP,0000,0000,0000,,Жоқ, қызық, мен оны қайда қойдым?
Dialogue: 0,0:31:18.70,0:31:19.88,,NTP,0000,0000,0000,,Жуынатын бөлме?
Dialogue: 0,0:31:27.90,0:31:29.80,,NTP,0000,0000,0000,,Қызық, мен оны қайда қойдым?
Dialogue: 0,0:31:30.31,0:31:32.26,,NTP,0000,0000,0000,,Мама, ойыншықты ал.
Dialogue: 0,0:31:32.54,0:31:33.83,,NTP,0000,0000,0000,,Е, сәл күте тұрыңыз.
Dialogue: 0,0:31:34.21,0:31:36.83,,NTP,0000,0000,0000,,Әй, сен анаңның жүзігін көрмедің бе?
Dialogue: 0,0:31:38.23,0:31:39.64,,NTP,0000,0000,0000,,(Хонда мен басқалары күледі)
Dialogue: 0,0:31:41.20,0:31:44.45,,NTP,0000,0000,0000,,Бұл біртүрлі. Бұлай болуы мүмкін емес.
Dialogue: 0,0:31:44.90,0:31:46.16,,NTP,0000,0000,0000,,Қызықты
Dialogue: 0,0:31:50.35,0:31:52.83,,NTP,0000,0000,0000,,Иә? Міне болды!
Dialogue: 0,0:31:56.75,0:31:58.95,,NTP,0000,0000,0000,,Жақсы...
Dialogue: 0,0:32:01.93,0:32:03.96,,NTP,0000,0000,0000,,Рахмет Чи
Dialogue: 0,0:32:04.17,0:32:06.44,,NTP,0000,0000,0000,,Жоқ, жоқ, ойна.
Dialogue: 0,0:32:06.67,0:32:10.02,,NTP,0000,0000,0000,,Сақинаны таптыңыз, рахмет.
Dialogue: 0,0:32:11.41,0:32:14.72,,NTP,0000,0000,0000,,Мама, мені жіберіңізші...
Dialogue: 0,0:32:18.22,0:32:20.76,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:32:21.17,0:32:23.96,,NTP,0000,0000,0000,,Мен сүтке өте ризамын
Dialogue: 0,0:32:24.44,0:32:26.83,,NTP,0000,0000,0000,,Ойнағаннан кейін
Dialogue: 0,0:32:27.56,0:32:30.70,,NTP,0000,0000,0000,,Сипалғанды жақсы сезіну
Dialogue: 0,0:32:31.04,0:32:33.37,,NTP,0000,0000,0000,,Мен оны аламын.
Dialogue: 0,0:32:33.95,0:32:36.51,,NTP,0000,0000,0000,,Дәмді тағамы бар бонбон
Dialogue: 0,0:32:37.26,0:32:41.90,,NTP,0000,0000,0000,,Жатып бақытты болу
Dialogue: 0,0:32:42.94,0:32:45.25,,NTP,0000,0000,0000,,Ролл~
Dialogue: 0,0:32:59.36,0:33:01.00,,NTP,0000,0000,0000,,Йохеи Қайырлы түн
Dialogue: 0,0:33:11.25,0:33:13.57,,NTP,0000,0000,0000,,Йохеи қозғалады, бірақ тоқтайды
Dialogue: 0,0:33:28.21,0:33:30.64,,NTP,0000,0000,0000,,Қайырлы түн әке
Dialogue: 0,0:33:31.06,0:33:35.36,,NTP,0000,0000,0000,,Кешіріңіз Чи, менің соңғы мерзімім бар.
Dialogue: 0,0:33:38.91,0:33:41.68,,NTP,0000,0000,0000,,Жуынатын бөлмені тазалауды аяқтады.
Dialogue: 0,0:33:44.91,0:33:46.64,,NTP,0000,0000,0000,,Мм, мм
Dialogue: 0,0:33:47.82,0:33:50.36,,NTP,0000,0000,0000,,Бұл жерде жақсы нәрсе бар ма?
Dialogue: 0,0:34:01.39,0:34:04.10,,NTP,0000,0000,0000,,Қайырлы түн апа
Dialogue: 0,0:34:07.23,0:34:08.29,,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:34:09.68,0:34:10.94,,NTP,0000,0000,0000,,Сыртқы келбетті тексеру
Dialogue: 0,0:34:24.19,0:34:26.15,,NTP,0000,0000,0000,,Ци, сен не істеп жатырсың?
Dialogue: 0,0:34:31.44,0:34:35.16,,NTP,0000,0000,0000,,Бұл мысықтар кітабындағы ФумиФуми ме?
Dialogue: 0,0:34:44.63,0:34:48.38,,NTP,0000,0000,0000,,Сенің ана мысық есіңде ме?
Dialogue: 0,0:00:26.69,0:00:30.00,,NTP,0000,0000,0000,,『：』 『：justin』 『：』 『：Jing Lee』『：』
