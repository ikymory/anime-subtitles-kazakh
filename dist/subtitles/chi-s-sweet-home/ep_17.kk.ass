Dialogue: 0,0:00:01.86,0:00:04.43,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:00:04.81,0:00:07.69,,NTP,0000,0000,0000,,Мен сонша сүтке ризамын
Dialogue: 0,0:00:07.82,0:00:14.31,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:00:14.42,0:00:17.10,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:00:17.21,0:00:20.63,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:00:20.72,0:00:25.77,,NTP,0000,0000,0000,,Жатып, бақытты болу
Dialogue: 0,0:00:26.20,0:00:28.85,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:00:40.54,0:00:41.01,,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:00:45.37,0:00:46.92,,NTP,0000,0000,0000,,Susususu
Dialogue: 0,0:00:50.63,0:00:51.51,,NTP,0000,0000,0000,,Жеміс
Dialogue: 0,0:00:52.27,0:00:53.76,,NTP,0000,0000,0000,,Ол мойнын қорғап қалды
Dialogue: 0,0:00:54.58,0:00:56.85,,NTP,0000,0000,0000,,Ах, Чи Чи
Dialogue: 0,0:00:58.70,0:01:00.09,,NTP,0000,0000,0000,,Жарайды
Dialogue: 0,0:01:00.44,0:01:01.64,,NTP,0000,0000,0000,,Өте шиеленісті, иә?
Dialogue: 0,0:01:02.13,0:01:05.84,,NTP,0000,0000,0000,,Нян күтіңіз күтіңіз күтіңіз
Dialogue: 0,0:01:28.16,0:01:30.40,,NTP,0000,0000,0000,,Мен бір нәрсені ұмытып қалдым
Dialogue: 0,0:01:31.91,0:01:34.86,,NTP,0000,0000,0000,,Youhei Chi тағамдары
Dialogue: 0,0:01:35.19,0:01:36.93,,NTP,0000,0000,0000,,Мысықтарға арналған тағамдар
Dialogue: 0,0:01:36.64,0:01:36.93,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:01:43.18,0:01:45.03,,NTP,0000,0000,0000,,Бұл дәмді болды
Dialogue: 0,0:01:55.51,0:02:00.19,,NTP,0000,0000,0000,,Не дірілдеп тұрсың?
Dialogue: 0,0:02:00.98,0:02:03.25,,NTP,0000,0000,0000,,Қараңдар, қараңдар, төгіліп жатыр
Dialogue: 0,0:02:04.86,0:02:11.49,,NTP,0000,0000,0000,,Бұл не қызық?
Dialogue: 0,0:02:16.70,0:02:18.61,,NTP,0000,0000,0000,,ваза екенін білдіреді
Dialogue: 0,0:02:19.62,0:02:23.25,,NTP,0000,0000,0000,,Бұл енді жақсы емес.
Dialogue: 0,0:02:26.66,0:02:31.93,,NTP,0000,0000,0000,,Чи Чи қашып кетті.
Dialogue: 0,0:02:30.39,0:02:31.22,,NTP,0000,0000,0000,,Дегенмен, ол шын мәнінде аристократ. Өте сәнді киінген, иә?
Dialogue: 0,0:02:35.26,0:02:38.30,,NTP,0000,0000,0000,,О сыртында
Dialogue: 0,0:02:39.87,0:02:44.13,,NTP,0000,0000,0000,,Сыр сыры
Dialogue: 0,0:02:44.44,0:02:45.88,,NTP,0000,0000,0000,,Мен ашуланғанды жек көремін.
Dialogue: 0,0:02:45.91,0:02:48.88,,NTP,0000,0000,0000,,Сыр сыры
Dialogue: 0,0:02:51.73,0:02:52.65,,NTP,0000,0000,0000,,Қош бол
Dialogue: 0,0:02:58.22,0:03:00.93,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:03:00.95,0:03:04.00,,NTP,0000,0000,0000,,Мен сонша сүтке ризамын
Dialogue: 0,0:03:04.13,0:03:10.79,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:03:10.80,0:03:13.50,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:03:13.52,0:03:16.55,,NTP,0000,0000,0000,,Дәмді тағаммен толтырылған
Dialogue: 0,0:03:17.10,0:03:22.26,,NTP,0000,0000,0000,,Жатып, бақытты болу
Dialogue: 0,0:03:22.71,0:03:25.35,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:03:30.61,0:03:33.67,,NTP,0000,0000,0000,,...
Dialogue: 0,0:03:40.00,0:03:44.24,,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:03:52.21,0:04:03.49,,NTP,0000,0000,0000,,...
Dialogue: 0,0:04:13.38,0:04:21.59,,NTP,0000,0000,0000,,...
Dialogue: 0,0:04:36.94,0:04:55.08,,NTP,0000,0000,0000,,...
Dialogue: 0,0:05:01.13,0:05:04.89,,NTP,0000,0000,0000,,...
Dialogue: 0,0:05:08.56,0:05:10.76,,NTP,0000,0000,0000,,Иә, жұмыс істеп тұр
Dialogue: 0,0:05:12.55,0:05:14.85,,NTP,0000,0000,0000,,Мысықтар жапырақтармен ойнайды.
Dialogue: 0,0:05:15.30,0:05:16.20,,NTP,0000,0000,0000,,Келіңіздер
Dialogue: 0,0:05:21.07,0:05:25.86,,NTP,0000,0000,0000,,Міне, осында, осында.
Dialogue: 0,0:05:26.54,0:05:34.48,,NTP,0000,0000,0000,,...
Dialogue: 0,0:05:32.57,0:05:34.61,,NTP,0000,0000,0000,,Қызықты
Dialogue: 0,0:05:34.61,0:05:37.02,,NTP,0000,0000,0000,,Томоко Норио кеттік
Dialogue: 0,0:05:37.05,0:05:38.77,,NTP,0000,0000,0000,,Иә, анашым
Dialogue: 0,0:05:40.03,0:05:41.45,,NTP,0000,0000,0000,,...
Dialogue: 0,0:05:41.37,0:05:43.29,,NTP,0000,0000,0000,,Қош бол, сау бол
Dialogue: 0,0:05:44.73,0:05:47.61,,NTP,0000,0000,0000,,Сыртта қызық көп.
Dialogue: 0,0:05:53.83,0:05:56.54,,NTP,0000,0000,0000,,～
Dialogue: 0,0:05:56.72,0:05:59.68,,NTP,0000,0000,0000,,Мен сонша сүтке ризамын
Dialogue: 0,0:05:59.82,0:06:06.40,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:06:06.55,0:06:09.14,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:06:09.25,0:06:12.47,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:06:12.58,0:06:17.39,,NTP,0000,0000,0000,,...
Dialogue: 0,0:06:18.37,0:06:20.30,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:06:32.21,0:06:32.89,,NTP,0000,0000,0000,,Жарайды
Dialogue: 0,0:06:39.32,0:06:41.30,,NTP,0000,0000,0000,,Көңілді сияқты
Dialogue: 0,0:06:46.22,0:06:48.58,,NTP,0000,0000,0000,,Жүр, үйге қайтайық.
Dialogue: 0,0:06:52.04,0:06:52.69,,NTP,0000,0000,0000,,Дегенмен, ол шын мәнінде аристократ. Өте сәнді киінген, иә?
Dialogue: 0,0:06:56.40,0:06:57.67,,NTP,0000,0000,0000,,Уф… Таңертеңгісін-ақ шаршап біттім.
Dialogue: 0,0:07:01.73,0:07:03.62,,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:07:07.15,0:07:12.75,,NTP,0000,0000,0000,,Кеттік, ау.
Dialogue: 0,0:07:16.34,0:07:23.44,,NTP,0000,0000,0000,,Қызғаншақ мияу
Dialogue: 0,0:07:27.94,0:07:30.40,,NTP,0000,0000,0000,,Очобикуя
Dialogue: 0,0:07:34.38,0:07:38.82,,NTP,0000,0000,0000,,Тоқта, күт, күт, енді не болады?
Dialogue: 0,0:07:52.77,0:08:02.74,,NTP,0000,0000,0000,,Керемет, көмектесіңізші
Dialogue: 0,0:08:03.00,0:08:07.12,,NTP,0000,0000,0000,,Чи Чи қайда
Dialogue: 0,0:08:06.89,0:08:10.10,,NTP,0000,0000,0000,,Сыр сыры
Dialogue: 0,0:08:10.13,0:08:12.51,,NTP,0000,0000,0000,,Қызық, қайда кетті?
Dialogue: 0,0:08:13.16,0:08:15.49,,NTP,0000,0000,0000,,Сізге қауіп төніп тұрған жоқ деп үміттенемін.
Dialogue: 0,0:08:16.84,0:08:20.79,,NTP,0000,0000,0000,,Сыр сыры
Dialogue: 0,0:08:21.23,0:08:24.82,,NTP,0000,0000,0000,,Йохеи ана, көмектесіңізші
Dialogue: 0,0:08:27.15,0:08:28.14,,NTP,0000,0000,0000,,Сендердің міндетің не, көпшілік?
Dialogue: 0,0:08:37.37,0:08:39.64,,NTP,0000,0000,0000,,Бұл мысық сүйкімді
Dialogue: 0,0:08:39.52,0:08:43.34,,NTP,0000,0000,0000,,Маған бұл жерде ұнайды Чи маған бұл жерде ұнайды
Dialogue: 0,0:08:49.82,0:08:52.66,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:08:52.78,0:08:55.76,,NTP,0000,0000,0000,,Мен сонша сүтке ризамын
Dialogue: 0,0:08:55.89,0:09:02.45,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:09:02.57,0:09:05.30,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:09:05.39,0:09:08.82,,NTP,0000,0000,0000,,Дәмді тағаммен толтырылған
Dialogue: 0,0:09:08.93,0:09:13.40,,NTP,0000,0000,0000,,Бақытты жату
Dialogue: 0,0:09:14.32,0:09:16.66,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:09:18.89,0:09:22.79,,NTP,0000,0000,0000,,Нян Қызықты
Dialogue: 0,0:09:23.37,0:09:25.61,,NTP,0000,0000,0000,,Qi сізді жақындатады
Dialogue: 0,0:09:25.55,0:09:28.42,,NTP,0000,0000,0000,,А, мен түсте кездескен мысық.
Dialogue: 0,0:09:29.24,0:09:33.11,,NTP,0000,0000,0000,,Ойнайық Қайтадан ойнағың келе ме?
Dialogue: 0,0:09:34.30,0:09:36.84,,NTP,0000,0000,0000,,Томоко Норио кеттік
Dialogue: 0,0:09:36.86,0:09:38.05,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:09:39.73,0:09:42.25,,NTP,0000,0000,0000,,Енді үйге барып кешкі ас ішейік.
Dialogue: 0,0:09:42.14,0:09:43.11,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:09:44.97,0:09:47.80,,NTP,0000,0000,0000,,Жақсы, Чи сол жаққа бара жатыр.
Dialogue: 0,0:09:52.52,0:10:02.67,,NTP,0000,0000,0000,,Ал олардың қол сөмкелері мен аяқ киімдері ше?
Dialogue: 0,0:10:10.52,0:10:14.01,,NTP,0000,0000,0000,,Барлығы үйлеріне қайтты және Чи
Dialogue: 0,0:10:19.11,0:10:19.74,,NTP,0000,0000,0000,,Мұнда
Dialogue: 0,0:10:22.20,0:10:23.29,,NTP,0000,0000,0000,,Жақсы нәрсе
Dialogue: 0,0:10:42.67,0:10:47.67,,NTP,0000,0000,0000,,Қарным ашты ма деп қорқамын
Dialogue: 0,0:10:49.66,0:10:56.60,,NTP,0000,0000,0000,,Сыр сыры
Dialogue: 0,0:10:57.65,0:11:02.76,,NTP,0000,0000,0000,,Сыр сыры
Dialogue: 0,0:11:03.19,0:11:04.34,,NTP,0000,0000,0000,,Чи қай жерде?
Dialogue: 0,0:11:04.59,0:11:07.42,,NTP,0000,0000,0000,,Шық, Чи.
Dialogue: 0,0:11:07.78,0:11:11.75,,NTP,0000,0000,0000,,Сыр сыры
Dialogue: 0,0:11:11.75,0:11:15.62,,NTP,0000,0000,0000,,Бұл Юхэй және басқалары.
Dialogue: 0,0:11:16.20,0:11:20.22,,NTP,0000,0000,0000,,Нян Нян
Dialogue: 0,0:11:21.55,0:11:23.90,,NTP,0000,0000,0000,,Чи Нян
Dialogue: 0,0:11:27.61,0:11:30.26,,NTP,0000,0000,0000,,Мені мүлде уайымдатпа.
Dialogue: 0,0:11:30.28,0:11:33.07,,NTP,0000,0000,0000,,Бірақ мен сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:11:34.21,0:11:36.30,,NTP,0000,0000,0000,,Олай болса, үйге қайтайық.
Dialogue: 0,0:11:36.35,0:11:39.59,,NTP,0000,0000,0000,,Иә, Чи, үйге қайтайық.
Dialogue: 0,0:11:40.36,0:11:41.85,,NTP,0000,0000,0000,,Үйге қайт
Dialogue: 0,0:11:45.80,0:11:48.61,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:11:48.72,0:11:51.80,,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:11:51.94,0:11:58.38,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:11:58.50,0:12:01.20,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:12:01.33,0:12:04.77,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:12:04.89,0:12:09.91,,NTP,0000,0000,0000,,Жатып, бақытты болу
Dialogue: 0,0:12:10.26,0:12:12.65,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:12:15.47,0:12:16.96,,NTP,0000,0000,0000,,Бүгін баруым керек.
Dialogue: 0,0:12:17.26,0:12:18.70,,NTP,0000,0000,0000,,Иә, мен міндетті түрде баруым керек.
Dialogue: 0,0:12:19.61,0:12:22.50,,NTP,0000,0000,0000,,Цидің медициналық тексеруі
Dialogue: 0,0:12:22.90,0:12:24.29,,NTP,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:12:25.61,0:12:28.59,,NTP,0000,0000,0000,,Мен сені сыртқа шығарсам, табылып қалу қаупі бар.
Dialogue: 0,0:12:28.69,0:12:31.58,,NTP,0000,0000,0000,,Ци үшін мен кетуім керек.
Dialogue: 0,0:12:32.62,0:12:33.35,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:12:37.70,0:12:39.89,,NTP,0000,0000,0000,,Эй, біз пикникке барамыз.
Dialogue: 0,0:12:40.28,0:12:42.06,,NTP,0000,0000,0000,,Бұл пикник емес пе?
Dialogue: 0,0:12:42.03,0:12:43.97,,NTP,0000,0000,0000,,Мен Чиді ветеринарға апарып жатырмын.
Dialogue: 0,0:12:44.67,0:12:45.89,,NTP,0000,0000,0000,,Ветеринарлық аурухана
Dialogue: 0,0:12:46.22,0:12:51.45,,NTP,0000,0000,0000,,Ци дұрыс өсетінін білу үшін дәрігерге барыңыз.
Dialogue: 0,0:12:51.61,0:12:54.87,,NTP,0000,0000,0000,,Ендеше, мен ауруханаға түсемін деген сияқты емес.
Dialogue: 0,0:13:01.71,0:13:03.16,,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:13:04.74,0:13:06.05,,NTP,0000,0000,0000,,Жарайсыңдар.
Dialogue: 0,0:13:06.27,0:13:08.23,,NTP,0000,0000,0000,,О Чи
Dialogue: 0,0:13:10.10,0:13:13.37,,NTP,0000,0000,0000,,Сәлем, шық!
Dialogue: 0,0:13:14.86,0:13:19.09,,NTP,0000,0000,0000,,Қызықты Қызықты Қызықты Бұл не?
Dialogue: 0,0:13:18.86,0:13:20.76,,NTP,0000,0000,0000,,Юхэ, маған Чи әкел.
Dialogue: 0,0:13:23.09,0:13:24.10,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:13:26.21,0:13:29.90,,NTP,0000,0000,0000,,Youhei Youhei ойнайды
Dialogue: 0,0:13:31.90,0:13:33.01,,NTP,0000,0000,0000,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:13:33.42,0:13:35.40,,NTP,0000,0000,0000,,Нян Маған ұнамайды, көбірек ойнаймын
Dialogue: 0,0:13:35.54,0:13:37.18,,NTP,0000,0000,0000,,Рахмет Йохай
Dialogue: 0,0:13:37.76,0:13:38.48,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:13:41.95,0:13:44.20,,NTP,0000,0000,0000,,Пәтердегі адамдарға сізді көруге жол бермеңіз.
Dialogue: 0,0:13:44.25,0:13:46.66,,NTP,0000,0000,0000,,Иә, әкімші және басқалар.
Dialogue: 0,0:13:47.62,0:13:48.91,,NTP,0000,0000,0000,,Жарайды, мен барамын.
Dialogue: 0,0:13:49.41,0:13:50.78,,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:13:56.64,0:14:00.18,,NTP,0000,0000,0000,,Оң жақ, сол жақ
Dialogue: 0,0:14:00.85,0:14:02.10,,NTP,0000,0000,0000,,Жарайды, жарайды.
Dialogue: 0,0:14:02.28,0:14:03.60,,NTP,0000,0000,0000,,Жоқ, өмірден үміт үзбе
Dialogue: 0,0:14:03.75,0:14:05.54,,NTP,0000,0000,0000,,Сәлем, қош келдіңіз.
Dialogue: 0,0:14:07.54,0:14:09.00,,NTP,0000,0000,0000,,Чидің сонда екенін білсеңіз
Dialogue: 0,0:14:09.09,0:14:11.17,,NTP,0000,0000,0000,,Бәрімізді қуып жібереді.
Dialogue: 0,0:14:11.30,0:14:14.69,,NTP,0000,0000,0000,,Бұл шын мәнінде иттер мен мысықтарға рұқсат етілмеген пәтер.
Dialogue: 0,0:14:14.70,0:14:16.72,,NTP,0000,0000,0000,,Сондықтан қатты дауыс көтермеу керек
Dialogue: 0,0:14:17.53,0:14:18.56,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:14:22.07,0:14:22.78,,NTP,0000,0000,0000,,Нян
Dialogue: 0,0:14:26.75,0:14:27.60,,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:14:27.99,0:14:30.27,,NTP,0000,0000,0000,,Мен таң қалдым.
Dialogue: 0,0:14:30.79,0:14:32.45,,NTP,0000,0000,0000,,Бұл қауіпті болды.
Dialogue: 0,0:14:35.50,0:14:38.12,,NTP,0000,0000,0000,,Қазір жақсысың ба?
Dialogue: 0,0:14:41.91,0:14:44.69,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:14:44.83,0:14:47.83,,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:14:47.98,0:14:54.50,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:14:54.61,0:14:57.33,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:14:57.42,0:15:00.83,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:15:00.96,0:15:05.94,,NTP,0000,0000,0000,,Жатып, бақытты болу
Dialogue: 0,0:15:06.38,0:15:08.62,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:15:11.92,0:15:16.15,,NTP,0000,0000,0000,,Ей, медициналық тексеру сізге арналған.
Dialogue: 0,0:15:16.59,0:15:17.48,,NTP,0000,0000,0000,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:15:17.66,0:15:20.41,,NTP,0000,0000,0000,,Мен жақсы қыз болып жүрмін.
Dialogue: 0,0:15:21.16,0:15:22.43,,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:15:24.91,0:15:26.51,,NTP,0000,0000,0000,,Сосын мен оны сұрадым.
Dialogue: 0,0:15:26.69,0:15:29.31,,NTP,0000,0000,0000,,Иә, ветеринарлық ауруханаға барайық.
Dialogue: 0,0:15:29.65,0:15:31.25,,NTP,0000,0000,0000,,Сәлем
Dialogue: 0,0:15:32.18,0:15:34.07,,NTP,0000,0000,0000,,Kan әкімшісі
Dialogue: 0,0:15:34.16,0:15:36.64,,NTP,0000,0000,0000,,Әй бәріңе, сәйкестікке не болды?
Dialogue: 0,0:15:37.28,0:15:38.91,,NTP,0000,0000,0000,,Қазір шығасың ба?
Dialogue: 0,0:15:39.20,0:15:41.82,,NTP,0000,0000,0000,,Хахаха жақсы
Dialogue: 0,0:15:41.93,0:15:45.39,,NTP,0000,0000,0000,,Жоқ, тек менің әкем біраз жұмысқа шығып жатыр.
Dialogue: 0,0:15:45.68,0:15:47.23,,NTP,0000,0000,0000,,О, солай ма?
Dialogue: 0,0:15:47.32,0:15:50.94,,NTP,0000,0000,0000,,Ауа-райы жақсы. Бұл жұмыс үшін жақсы.
Dialogue: 0,0:15:50.84,0:15:55.47,,NTP,0000,0000,0000,,Әй, бірақ бұлт түсте келеді.
Dialogue: 0,0:15:56.10,0:15:57.37,,NTP,0000,0000,0000,,Солай ма?
Dialogue: 0,0:15:58.36,0:16:02.69,,NTP,0000,0000,0000,,Жарайды, мен кір немесе бірдеңе әкелуім керек шығар.
Dialogue: 0,0:16:03.73,0:16:08.15,,NTP,0000,0000,0000,,Иә, кептіруге күш салған нәрселердің сулануы үлкен мәселе.
Dialogue: 0,0:16:08.80,0:16:11.04,,NTP,0000,0000,0000,,Жарайды, мен оны кейінірек қабылдаймын.
Dialogue: 0,0:16:11.28,0:16:13.93,,NTP,0000,0000,0000,,Олай болса, кешірім сұрайтын кез келді.
Dialogue: 0,0:16:13.82,0:16:16.15,,NTP,0000,0000,0000,,Өтінемін, келесі күні маған келіңіз.
Dialogue: 0,0:16:15.05,0:16:16.15,,NTP,0000,0000,0000,,Нян
Dialogue: 0,0:16:20.88,0:16:25.42,,NTP,0000,0000,0000,,Маған қызық, мысық қазір қайда жылайды.
Dialogue: 0,0:16:27.07,0:16:29.29,,NTP,0000,0000,0000,,Мен мұны жақын жерде естідім.
Dialogue: 0,0:16:30.51,0:16:33.12,,NTP,0000,0000,0000,,Біреу сақтай ма деп ойлаймын.
Dialogue: 0,0:16:33.62,0:16:36.74,,NTP,0000,0000,0000,,Жоқ, сізді қуып жібереді.
Dialogue: 0,0:16:37.84,0:16:40.81,,NTP,0000,0000,0000,,А, мен не істеуім керек?
Dialogue: 0,0:16:44.44,0:16:48.36,,NTP,0000,0000,0000,,Нян Нян
Dialogue: 0,0:16:51.11,0:16:53.30,,NTP,0000,0000,0000,,Бұл Йохэйкун болатын.
Dialogue: 0,0:16:53.32,0:16:56.34,,NTP,0000,0000,0000,,Апайды нағыз мысық деп ойладым.
Dialogue: 0,0:16:58.06,0:17:02.45,,NTP,0000,0000,0000,,А, сен, қара, мен сені мәміле жасамас бұрын күтемін.
Dialogue: 0,0:17:02.49,0:17:07.93,,NTP,0000,0000,0000,,Дұрыс. Жарайды, кешіріңіз.
Dialogue: 0,0:17:08.54,0:17:11.74,,NTP,0000,0000,0000,,О, кешіріңіз, мен сізді артта қалдырдым.
Dialogue: 0,0:17:12.40,0:17:14.11,,NTP,0000,0000,0000,,сақталды
Dialogue: 0,0:17:25.25,0:17:26.87,,NTP,0000,0000,0000,,Шығару
Dialogue: 0,0:17:30.02,0:17:32.76,,NTP,0000,0000,0000,,Қазір жақсысың ба?
Dialogue: 0,0:17:37.98,0:17:40.61,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:17:40.77,0:17:43.87,,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:17:43.99,0:17:50.53,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:17:50.65,0:17:53.39,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:17:53.52,0:17:56.88,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:17:57.02,0:18:01.90,,NTP,0000,0000,0000,,Жатып, бақытты болу
Dialogue: 0,0:18:02.40,0:18:04.72,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:18:11.60,0:18:14.28,,NTP,0000,0000,0000,,Ақыры жануарлар ауруханасына келді.
Dialogue: 0,0:18:15.93,0:18:17.39,,NTP,0000,0000,0000,,Шығару
Dialogue: 0,0:18:17.84,0:18:18.44,,NTP,0000,0000,0000,,Ашық
Dialogue: 0,0:18:33.43,0:18:34.67,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:18:37.94,0:18:39.54,,NTP,0000,0000,0000,,Бұл қайда?
Dialogue: 0,0:18:40.39,0:18:41.01,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:18:41.88,0:18:42.95,,NTP,0000,0000,0000,,Нян
Dialogue: 0,0:18:42.73,0:18:43.85,,NTP,0000,0000,0000,,Ци, шығыңыз.
Dialogue: 0,0:18:44.45,0:18:51.48,,NTP,0000,0000,0000,,Әке, әке, мен қорықтым.
Dialogue: 0,0:18:50.13,0:18:50.85,,NTP,0000,0000,0000,,Жарайды, жарайды.
Dialogue: 0,0:18:57.01,0:19:00.10,,NTP,0000,0000,0000,,Қауіпсіздігіңіз үшін оны тордан шығармаңыз.
Dialogue: 0,0:19:00.30,0:19:01.88,,NTP,0000,0000,0000,,Қандай кездейсоқ кездесу, Хиёри
Dialogue: 0,0:19:02.62,0:19:05.60,,NTP,0000,0000,0000,,Ямада мырза Чи Ямада мырза
Dialogue: 0,0:19:05.66,0:19:06.81,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:19:08.46,0:19:14.84,,NTP,0000,0000,0000,,Нян Нян әке, маған бұл жер ұнамайды. Үйге барайық.
Dialogue: 0,0:19:18.35,0:19:20.07,,NTP,0000,0000,0000,,Әке, үйге қайтайық.
Dialogue: 0,0:19:22.04,0:19:24.45,,NTP,0000,0000,0000,,Сіз оны көтергеніңізді естідім.
Dialogue: 0,0:19:25.62,0:19:28.81,,NTP,0000,0000,0000,,Бұл екі-үш айлық қыз.
Dialogue: 0,0:19:28.92,0:19:30.69,,NTP,0000,0000,0000,,Иә, сен қызсың ба?
Dialogue: 0,0:19:32.09,0:19:34.28,,NTP,0000,0000,0000,,Мына жер қайда?
Dialogue: 0,0:19:35.64,0:19:42.99,,NTP,0000,0000,0000,,Құлағыңыз таза. Конъюнктивит жоқ. Тістеріңіз бен қызыл иектеріңіз де таза.
Dialogue: 0,0:19:43.57,0:19:46.93,,NTP,0000,0000,0000,,Енді мен температураңызды өлшеймін, оны ұстап тұрыңыз.
Dialogue: 0,0:19:47.01,0:19:47.74,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:19:47.61,0:19:49.17,,NTP,0000,0000,0000,,Яна Яна Яна Яна
Dialogue: 0,0:19:49.64,0:19:51.73,,NTP,0000,0000,0000,,Сіз не істемексіз?
Dialogue: 0,0:20:00.22,0:20:03.00,,NTP,0000,0000,0000,,Мен енді мұндай жерде болғым келмейді.
Dialogue: 0,0:20:04.42,0:20:06.60,,NTP,0000,0000,0000,,Тіпті Ямада Чи мырза
Dialogue: 0,0:20:07.38,0:20:11.04,,NTP,0000,0000,0000,,Бұл керемет. Чидің де тегі бар.
Dialogue: 0,0:20:11.47,0:20:13.47,,NTP,0000,0000,0000,,Бұл қиын болды.
Dialogue: 0,0:20:13.63,0:20:14.28,,NTP,0000,0000,0000,,Эй Чи
Dialogue: 0,0:20:22.25,0:20:24.57,,NTP,0000,0000,0000,,Мен әкемді жек көремін.
Dialogue: 0,0:20:26.76,0:20:28.95,,NTP,0000,0000,0000,,Ци жек көретін
Dialogue: 0,0:20:34.03,0:20:36.79,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:20:36.91,0:20:39.92,,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:20:40.11,0:20:46.53,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:20:46.65,0:20:49.38,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:20:49.46,0:20:52.98,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:20:53.07,0:20:57.96,,NTP,0000,0000,0000,,Жатып бақытты болу
Dialogue: 0,0:20:58.48,0:21:00.58,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:21:07.39,0:21:08.79,,NTP,0000,0000,0000,,Чи, шықшы.
Dialogue: 0,0:21:08.86,0:21:09.74,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:21:20.16,0:21:20.82,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:21:22.47,0:21:26.06,,NTP,0000,0000,0000,,Әке, сіз Чиді ұнатпайтын жерге қайтадан апаратыныңызға бәс тігемін.
Dialogue: 0,0:21:26.21,0:21:26.84,,NTP,0000,0000,0000,,Яна Яна
Dialogue: 0,0:21:29.29,0:21:33.90,,NTP,0000,0000,0000,,Суккари-чи мен оны ветеринарлық ауруханаға апарғаннан кейін мені жек көре бастаған сияқты.
Dialogue: 0,0:21:36.15,0:21:39.04,,NTP,0000,0000,0000,,Чи Чи шығады
Dialogue: 0,0:21:40.13,0:21:42.00,,NTP,0000,0000,0000,,Яна Яна Яна Яна Яна
Dialogue: 0,0:21:42.02,0:21:43.31,,NTP,0000,0000,0000,,Читтеба
Dialogue: 0,0:21:45.37,0:21:46.70,,NTP,0000,0000,0000,,Чи, шығыңдар.
Dialogue: 0,0:21:47.67,0:21:50.22,,NTP,0000,0000,0000,,Qi Мен оны жек көремін.
Dialogue: 0,0:21:53.91,0:21:55.39,,NTP,0000,0000,0000,,Мен өзімді жалғыз сезінемін
Dialogue: 0,0:21:56.97,0:21:59.55,,NTP,0000,0000,0000,,Иә, дұрыс.
Dialogue: 0,0:22:01.43,0:22:03.65,,NTP,0000,0000,0000,,Әке, сіз көп нәрсе сатып алдыңыз.
Dialogue: 0,0:22:04.76,0:22:08.00,,NTP,0000,0000,0000,,Жоспар Чиді дәмді нәрсемен қуанту болды.
Dialogue: 0,0:22:10.40,0:22:11.96,,NTP,0000,0000,0000,,Қараңызшы, Чи.
Dialogue: 0,0:22:14.02,0:22:15.41,,NTP,0000,0000,0000,,Жақсы иіс шығады.
Dialogue: 0,0:22:16.18,0:22:17.33,,NTP,0000,0000,0000,,Бұл дәмді
Dialogue: 0,0:22:18.26,0:22:20.65,,NTP,0000,0000,0000,,Мен мұны не жеуге болады?
Dialogue: 0,0:22:25.88,0:22:27.59,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:22:29.14,0:22:29.99,,NTP,0000,0000,0000,,Мен мұны істедім
Dialogue: 0,0:22:38.16,0:22:39.85,,NTP,0000,0000,0000,,Помпон
Dialogue: 0,0:22:43.98,0:22:48.80,,NTP,0000,0000,0000,,Чи, мен бақыттымын. Жақсы.
Dialogue: 0,0:22:55.29,0:22:56.77,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:23:01.69,0:23:02.86,,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:23:03.35,0:23:04.31,,NTP,0000,0000,0000,,Сипалау
Dialogue: 0,0:23:04.12,0:23:04.86,,NTP,0000,0000,0000,,Е
Dialogue: 0,0:23:07.17,0:23:12.05,,NTP,0000,0000,0000,,Мен ұйықтап жатқанда ғана сені еркелетуге рұқсат бересің бе деп ойлаймын.
Dialogue: 0,0:23:30.01,0:23:32.78,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:23:32.96,0:23:35.90,,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:23:36.27,0:23:42.63,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:23:42.72,0:23:45.47,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:23:45.57,0:23:48.90,,NTP,0000,0000,0000,,Дәмді тағаммен толтырылған
Dialogue: 0,0:23:49.01,0:23:54.07,,NTP,0000,0000,0000,,Бақытты жатып
Dialogue: 0,0:23:54.46,0:23:56.64,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:24:03.23,0:24:07.46,,NTP,0000,0000,0000,,Иә, осында.
Dialogue: 0,0:24:08.61,0:24:13.03,,NTP,0000,0000,0000,,Ойнағыңыз келе ме? Шығу.
Dialogue: 0,0:24:14.33,0:24:16.94,,NTP,0000,0000,0000,,Мен әкемнің мені ұнатпайтын жерлерге апарғанын ұнатпаймын.
Dialogue: 0,0:24:18.50,0:24:22.79,,NTP,0000,0000,0000,,А, сіз әлі де мал ауруханасына өшпенділік танытасыз ба?
Dialogue: 0,0:24:24.76,0:24:27.60,,NTP,0000,0000,0000,,А, сен мені қатты қинадың
Dialogue: 0,0:24:28.04,0:24:30.90,,NTP,0000,0000,0000,,Ача Чи мұны істеді ме?
Dialogue: 0,0:24:30.67,0:24:33.05,,NTP,0000,0000,0000,,Иә, тырнақтарыммен жасадым.
Dialogue: 0,0:24:33.36,0:24:34.94,,NTP,0000,0000,0000,,Маған солай қарама.
Dialogue: 0,0:24:34.62,0:24:38.01,,NTP,0000,0000,0000,,Жақсы емес. Бұл диван 50 000 иен тұрады.
Dialogue: 0,0:24:38.39,0:24:40.46,,NTP,0000,0000,0000,,Бірдеңе дірілдейді
Dialogue: 0,0:24:47.35,0:24:49.05,,NTP,0000,0000,0000,,Оны жалама
Dialogue: 0,0:24:54.75,0:24:56.08,,NTP,0000,0000,0000,,Бұл да атаусыз
Dialogue: 0,0:24:56.65,0:24:58.32,,NTP,0000,0000,0000,,Бұл соншалықты байқалмайды.
Dialogue: 0,0:24:58.59,0:25:00.33,,NTP,0000,0000,0000,,Бұл байқалады.
Dialogue: 0,0:25:00.55,0:25:04.64,,NTP,0000,0000,0000,,Әй, мына джинсы шалбарды жуу керек шығар.
Dialogue: 0,0:25:04.62,0:25:06.46,,NTP,0000,0000,0000,,Ол жыртылған.
Dialogue: 0,0:25:07.18,0:25:09.64,,NTP,0000,0000,0000,,Маған бұның жыртық болғаны ұнайды.
Dialogue: 0,0:25:09.86,0:25:13.27,,NTP,0000,0000,0000,,Мен винтажды джинсылардың әдемілігін түсінбеймін.
Dialogue: 0,0:25:13.43,0:25:14.89,,NTP,0000,0000,0000,,Ах Чи
Dialogue: 0,0:25:15.96,0:25:18.55,,NTP,0000,0000,0000,,Маған бұл ұнайды, әке.
Dialogue: 0,0:25:18.62,0:25:22.00,,NTP,0000,0000,0000,,Чи ғана түсінеді.
Dialogue: 0,0:25:22.36,0:25:24.24,,NTP,0000,0000,0000,,Жақсы көрінеді.
Dialogue: 0,0:25:24.77,0:25:28.59,,NTP,0000,0000,0000,,Тоқта, кел, кел, Чи.
Dialogue: 0,0:25:29.29,0:25:30.60,,NTP,0000,0000,0000,,Құтқындылық күші
Dialogue: 0,0:25:30.84,0:25:32.46,,NTP,0000,0000,0000,,Помпон.
Dialogue: 0,0:25:32.53,0:25:34.99,,NTP,0000,0000,0000,,Жоқ, жоқ, бұл винтаж.
Dialogue: 0,0:25:35.02,0:25:37.85,,NTP,0000,0000,0000,,Ах Чи
Dialogue: 0,0:25:40.90,0:25:44.76,,NTP,0000,0000,0000,,Ах Чи, жақсысың ба?
Dialogue: 0,0:25:52.27,0:25:54.41,,NTP,0000,0000,0000,,Қайталап көріңіз
Dialogue: 0,0:25:54.41,0:25:57.04,,NTP,0000,0000,0000,,Жоқ.
Dialogue: 0,0:25:57.19,0:26:00.58,,NTP,0000,0000,0000,,Жоқ, жоқ, жоқ.
Dialogue: 0,0:25:58.16,0:25:59.52,,NTP,0000,0000,0000,,Әкем
Dialogue: 0,0:26:05.04,0:26:07.78,,NTP,0000,0000,0000,,Чиге әкесінің джинсы ұнайды.
Dialogue: 0,0:26:08.18,0:26:12.02,,NTP,0000,0000,0000,,Әке, Чимен тіл табыса алғаныңызға қуаныштымын.
Dialogue: 0,0:26:14.36,0:26:17.00,,NTP,0000,0000,0000,,Маған бұл ұнайды, әке.
Dialogue: 0,0:26:18.40,0:26:21.28,,NTP,0000,0000,0000,,Бұл диванға қарағанда қымбатырақ.
Dialogue: 0,0:26:26.12,0:26:28.76,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:26:28.97,0:26:31.91,,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:26:32.07,0:26:38.66,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:26:38.79,0:26:41.44,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:26:41.54,0:26:45.03,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:26:45.11,0:26:49.90,,NTP,0000,0000,0000,,Бақытты жатып
Dialogue: 0,0:26:50.59,0:26:52.97,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:26:55.11,0:26:57.73,,NTP,0000,0000,0000,,Әке, бұл жақсы.
Dialogue: 0,0:26:59.07,0:27:03.89,,NTP,0000,0000,0000,,Ветеринариялық ауруханаға барғалы бері мен бұрынғыдан да мазасыз болдым.
Dialogue: 0,0:27:05.50,0:27:09.32,,NTP,0000,0000,0000,,Ах, Чидің мені қатты жақсы көретініне сене алар емеспін.
Dialogue: 0,0:27:10.63,0:27:16.25,,NTP,0000,0000,0000,,Бірақ бұл джинсы қымбат, олар винтажды, мен ақырында сатып алдым.
Dialogue: 0,0:27:17.81,0:27:20.01,,NTP,0000,0000,0000,,А, мен не істеуім керек?
Dialogue: 0,0:27:20.31,0:27:23.62,,NTP,0000,0000,0000,,Жақсы, тек жыртылған джинсы шалбар.
Dialogue: 0,0:27:23.39,0:27:30.89,,NTP,0000,0000,0000,,Жақсы емес, кешіріңіз Чи.
Dialogue: 0,0:27:31.63,0:27:33.32,,NTP,0000,0000,0000,,Менің әкеме не болды?
Dialogue: 0,0:27:33.34,0:27:36.64,,NTP,0000,0000,0000,,Келіңіздер.
Dialogue: 0,0:27:37.59,0:27:39.02,,NTP,0000,0000,0000,,Қалайсың, Чи?
Dialogue: 0,0:27:39.37,0:27:44.80,,NTP,0000,0000,0000,,Келіңіздер, егер сіз джинсы шалбар кисеңіз, Чиге қалағаныңызша жақын бола аласыз.
Dialogue: 0,0:27:48.51,0:27:49.57,,NTP,0000,0000,0000,,Бұл емес
Dialogue: 0,0:27:50.85,0:27:52.19,,NTP,0000,0000,0000,,Бұл
Dialogue: 0,0:27:52.65,0:27:55.57,,NTP,0000,0000,0000,,Бұрынғы джинсы шалбарды киюім керек сияқты.
Dialogue: 0,0:27:55.63,0:27:58.41,,NTP,0000,0000,0000,,О, солай.
Dialogue: 0,0:27:59.49,0:28:01.76,,NTP,0000,0000,0000,,Жоқ.
Dialogue: 0,0:28:02.64,0:28:08.02,,NTP,0000,0000,0000,,Qi, енді диван жоқ.
Dialogue: 0,0:28:10.86,0:28:13.81,,NTP,0000,0000,0000,,Қайтадан шырылдап жатыр Иә.
Dialogue: 0,0:28:15.05,0:28:16.50,,NTP,0000,0000,0000,,Жоқ.
Dialogue: 0,0:28:16.97,0:28:21.25,,NTP,0000,0000,0000,,Әке, жіберіңізші, жіберіңізші
Dialogue: 0,0:28:21.42,0:28:24.58,,NTP,0000,0000,0000,,Әкесі де, анасы да Циге кедергі жасайды.
Dialogue: 0,0:28:26.60,0:28:28.41,,NTP,0000,0000,0000,,Ци Мен түшкірдім деп ойлаймын.
Dialogue: 0,0:28:28.61,0:28:32.23,,NTP,0000,0000,0000,,Бірақ бір жерде, бірде жараланып қалсаң, қиналып қаласың.
Dialogue: 0,0:28:32.31,0:28:34.56,,NTP,0000,0000,0000,,Иә, дұрыс.
Dialogue: 0,0:28:35.24,0:28:37.91,,NTP,0000,0000,0000,,Бұл мысықтың тырнақтары ма?
Dialogue: 0,0:28:38.05,0:28:40.90,,NTP,0000,0000,0000,,Картоннан жасалған ұзын, жұқа немесе дөңгелек заттар
Dialogue: 0,0:28:40.91,0:28:44.30,,NTP,0000,0000,0000,,Үй жануарларымен жабылған және жұқа сияқты басқа түрлері
Dialogue: 0,0:28:44.31,0:28:46.10,,NTP,0000,0000,0000,,Үй түрі, қуыршақ түрі және т.б.
Dialogue: 0,0:28:46.12,0:28:48.15,,NTP,0000,0000,0000,,Бүгін қайсысын іздеп жүрсіз?
Dialogue: 0,0:28:48.32,0:28:51.13,,NTP,0000,0000,0000,,Аа, маған ең көп таралғанын беріңізші.
Dialogue: 0,0:28:51.98,0:28:54.26,,NTP,0000,0000,0000,,Иә, көп рахмет.
Dialogue: 0,0:28:54.75,0:28:58.67,,NTP,0000,0000,0000,,Чи, сәл шыда, мен жақында келемін.
Dialogue: 0,0:29:09.15,0:29:12.44,,NTP,0000,0000,0000,,Чи әкенің винтажы
Dialogue: 0,0:29:15.97,0:29:18.33,,NTP,0000,0000,0000,,Маған бұл өте ұнайды
Dialogue: 0,0:29:22.11,0:29:24.89,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:29:25.01,0:29:27.98,,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:29:28.11,0:29:34.64,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:29:34.78,0:29:37.46,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:29:37.56,0:29:41.01,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:29:41.12,0:29:46.11,,NTP,0000,0000,0000,,Бақытты жату
Dialogue: 0,0:29:46.52,0:29:48.97,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:29:57.34,0:29:59.07,,NTP,0000,0000,0000,,Әке, бұл не?
Dialogue: 0,0:29:59.73,0:30:02.57,,NTP,0000,0000,0000,,Бұл Чи тырнағын қайрау үшін қолданатын құрал ма?
Dialogue: 0,0:30:03.23,0:30:04.10,,NTP,0000,0000,0000,,Қалайсың, Чи?
Dialogue: 0,0:30:04.17,0:30:05.83,,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:30:07.15,0:30:11.99,,NTP,0000,0000,0000,,Енді тырнақтарыңызды қалағаныңызша қайрай аласыз. Ол саған ұнайды ма? Чи.
Dialogue: 0,0:30:15.33,0:30:16.20,,NTP,0000,0000,0000,,Бұл
Dialogue: 0,0:30:16.45,0:30:17.54,,NTP,0000,0000,0000,,Маған бұл ұнайды
Dialogue: 0,0:30:20.68,0:30:25.04,,NTP,0000,0000,0000,,Неліктен Qi бір нәрсені дұрыс пайдалана алмайды?
Dialogue: 0,0:30:25.30,0:30:28.05,,NTP,0000,0000,0000,,Сіздің қолыңыздан келетін жалғыз нәрсе - шыдамдылықпен үйрету.
Dialogue: 0,0:30:28.26,0:30:30.32,,NTP,0000,0000,0000,,Маған бұл өте ұнайды
Dialogue: 0,0:30:30.43,0:30:34.87,,NTP,0000,0000,0000,,Чи, мынау емес, мынау.
Dialogue: 0,0:30:41.61,0:30:42.93,,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:30:43.38,0:30:46.53,,NTP,0000,0000,0000,,Иә, тырнақтарыңды қайрайсыңдар.
Dialogue: 0,0:30:47.17,0:30:49.03,,NTP,0000,0000,0000,,Жақсы төсек
Dialogue: 0,0:30:52.23,0:30:54.08,,NTP,0000,0000,0000,,Чи ойнап тұр.
Dialogue: 0,0:30:55.41,0:30:58.36,,NTP,0000,0000,0000,,Чи, маған қарашы.
Dialogue: 0,0:30:58.61,0:31:00.63,,NTP,0000,0000,0000,,Тырнақтарыңда осылай тұру
Dialogue: 0,0:31:01.06,0:31:03.36,,NTP,0000,0000,0000,,Тырнақтарыңызды осылай қайрайсыз
Dialogue: 0,0:31:04.47,0:31:06.63,,NTP,0000,0000,0000,,Қараңыз, чиді де қолданып көріңіз.
Dialogue: 0,0:31:09.23,0:31:11.23,,NTP,0000,0000,0000,,Ци Тырнағымды қайратпаймын.
Dialogue: 0,0:31:13.74,0:31:15.32,,NTP,0000,0000,0000,,Әдемі әдемі
Dialogue: 0,0:31:15.79,0:31:23.65,,NTP,0000,0000,0000,,Оның орнына қараңыз, мынаны және мынаны орындаңыз.
Dialogue: 0,0:31:23.04,0:31:24.50,,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:31:25.24,0:31:29.73,,NTP,0000,0000,0000,,Енді түсіндің.
Dialogue: 0,0:31:31.03,0:31:35.34,,NTP,0000,0000,0000,,Чидің қолын қыспа
Dialogue: 0,0:31:35.47,0:31:36.79,,NTP,0000,0000,0000,,Ауырды
Dialogue: 0,0:31:36.85,0:31:39.31,,NTP,0000,0000,0000,,Әй, ау, сені ұрып-соғып қалдың.
Dialogue: 0,0:31:39.71,0:31:41.64,,NTP,0000,0000,0000,,А, мен ашуландым.
Dialogue: 0,0:31:44.96,0:31:46.53,,NTP,0000,0000,0000,,Чи әлі ашулы.
Dialogue: 0,0:31:46.53,0:31:48.14,,NTP,0000,0000,0000,,Мен өзімді әлсіз сезінемін.
Dialogue: 0,0:31:50.78,0:31:54.45,,NTP,0000,0000,0000,,Мен Чидің тырнағын қырқып алуым керек сияқты.
Dialogue: 0,0:31:56.93,0:31:58.72,,NTP,0000,0000,0000,,Әке, өтінемін.
Dialogue: 0,0:31:58.87,0:32:01.97,,NTP,0000,0000,0000,,Иә, иә
Dialogue: 0,0:32:02.58,0:32:04.94,,NTP,0000,0000,0000,,Дұрыс, мен оны көруге бар күшімді саламын.
Dialogue: 0,0:32:06.73,0:32:07.65,,NTP,0000,0000,0000,,Хун
Dialogue: 0,0:32:09.11,0:32:13.68,,NTP,0000,0000,0000,,Чи, сабырмен тырнақтарымды кесуге рұқсат бересің бе?
Dialogue: 0,0:32:18.17,0:32:20.81,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:32:20.97,0:32:24.10,,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:32:24.24,0:32:30.70,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:32:30.82,0:32:33.54,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:32:33.65,0:32:37.07,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:32:37.18,0:32:41.99,,NTP,0000,0000,0000,,Бақытты жату
Dialogue: 0,0:32:42.57,0:32:44.66,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:32:50.41,0:32:54.82,,NTP,0000,0000,0000,,Иә, Чи, сен жақсы қызсың. Тыныш бол.
Dialogue: 0,0:32:55.65,0:32:57.94,,NTP,0000,0000,0000,,Әке, сіз не істеп жатырсыз?
Dialogue: 0,0:32:58.19,0:33:04.25,,NTP,0000,0000,0000,,Жарайды, Мемото, мықтап ұстасаң, тырнақ шығады.
Dialogue: 0,0:33:04.31,0:33:08.29,,NTP,0000,0000,0000,,Мен мысықтың тырнағын бұрын-соңды қиып көрмегенмін, сондықтан қобалжыдым.
Dialogue: 0,0:33:15.82,0:33:21.67,,NTP,0000,0000,0000,,Бұл не? Мен оны ұнатпаймын.
Dialogue: 0,0:33:21.72,0:33:23.96,,NTP,0000,0000,0000,,Эй, Чи, қозғалма.
Dialogue: 0,0:33:23.51,0:33:27.16,,NTP,0000,0000,0000,,Жоқ, рұқсат етіңіз. Сіз не істемексіз?
Dialogue: 0,0:33:27.88,0:33:30.25,,NTP,0000,0000,0000,,Қозғалмай отырыңыз.
Dialogue: 0,0:33:31.34,0:33:33.06,,NTP,0000,0000,0000,,Егер сіз оны қаттырақ ұстасаңыз
Dialogue: 0,0:33:33.60,0:33:38.44,,NTP,0000,0000,0000,,Иә, жарайды.
Dialogue: 0,0:33:38.53,0:33:41.03,,NTP,0000,0000,0000,,Сәттілік, әке.
Dialogue: 0,0:33:41.62,0:33:44.89,,NTP,0000,0000,0000,,Осы жерден мөлдір бөлікті кесіңіз.
Dialogue: 0,0:33:45.18,0:33:49.98,,NTP,0000,0000,0000,,Түсті бөлігін кесіп алсаңыз, қан шығады.
Dialogue: 0,0:33:50.12,0:33:53.01,,NTP,0000,0000,0000,,Иә, қансырап жатыр.
Dialogue: 0,0:33:58.53,0:34:01.63,,NTP,0000,0000,0000,,Жоқ, мен оны кесуге қатты қорқамын.
Dialogue: 0,0:34:06.85,0:34:10.89,,NTP,0000,0000,0000,,Қой, иә
Dialogue: 0,0:34:12.45,0:34:15.27,,NTP,0000,0000,0000,,Ци, үндемеңіз.
Dialogue: 0,0:34:18.99,0:34:21.00,,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:34:23.41,0:34:26.35,,NTP,0000,0000,0000,,Ия, жақсылап кесіп алдың.
Dialogue: 0,0:34:26.52,0:34:32.59,,NTP,0000,0000,0000,,Ақырында, бір. Тоғыз қалды ма?
Dialogue: 0,0:34:37.80,0:34:39.87,,NTP,0000,0000,0000,,Ауырды
Dialogue: 0,0:34:39.98,0:34:45.18,,NTP,0000,0000,0000,,Қатты болды, бірақ Чидің тырнақтары дұрыс кесілгеніне қуаныштымын.
Dialogue: 0,0:34:45.98,0:34:51.72,,NTP,0000,0000,0000,,А, сен мені тағы жек көрдің, Чи.
Dialogue: 0,0:34:52.72,0:34:58.61,,NTP,0000,0000,0000,,Чи, татуласып көрейік.
Dialogue: 0,0:35:05.19,0:35:07.22,,NTP,0000,0000,0000,,Мен әкемді жек көремін.
Dialogue: 0,0:35:14.22,0:35:16.98,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:35:17.10,0:35:20.15,,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:35:20.27,0:35:26.82,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:35:26.95,0:35:29.66,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:35:29.76,0:35:33.14,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:35:33.25,0:35:38.19,,NTP,0000,0000,0000,,Жатып бақытты болу
Dialogue: 0,0:35:38.62,0:35:40.96,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:35:44.02,0:35:47.50,,NTP,0000,0000,0000,,Әке, кешігіп қалдыңыз.
Dialogue: 0,0:35:47.70,0:35:51.82,,NTP,0000,0000,0000,,Мен жақында кешкі асқа дүкен аралауым керек.
Dialogue: 0,0:35:55.73,0:35:56.77,,NTP,0000,0000,0000,,Йохай
Dialogue: 0,0:35:57.41,0:35:59.70,,NTP,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:36:00.47,0:36:03.31,,NTP,0000,0000,0000,,Меніңше, әкең жақында үйге келеді.
Dialogue: 0,0:36:03.63,0:36:06.09,,NTP,0000,0000,0000,,Оған дейін Чимен жақсы қыз бол.
Dialogue: 0,0:36:06.61,0:36:07.85,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:36:08.35,0:36:11.20,,NTP,0000,0000,0000,,Ал, мен барамын.
Dialogue: 0,0:36:14.35,0:36:16.60,,NTP,0000,0000,0000,,Чи Чи
Dialogue: 0,0:36:17.12,0:36:20.35,,NTP,0000,0000,0000,,Серуенге шығу
Dialogue: 0,0:36:20.73,0:36:25.66,,NTP,0000,0000,0000,,Чи менімен бірге қалады. Мен түссіндім.
Dialogue: 0,0:36:25.97,0:36:27.18,,NTP,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:36:28.18,0:36:29.90,,NTP,0000,0000,0000,,Сыртқа шығу
Dialogue: 0,0:36:30.01,0:36:31.08,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:36:33.43,0:36:35.66,,NTP,0000,0000,0000,,Мен бұлай дүкенге бара алмаймын.
Dialogue: 0,0:36:37.30,0:36:38.63,,NTP,0000,0000,0000,,Чи, күріш.
Dialogue: 0,0:36:40.18,0:36:42.33,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:36:45.91,0:36:47.22,,NTP,0000,0000,0000,,Осы сәтте
Dialogue: 0,0:36:52.78,0:36:54.47,,NTP,0000,0000,0000,,Жоқ, Чи.
Dialogue: 0,0:36:55.82,0:36:58.29,,NTP,0000,0000,0000,,Бұл стратегия жақсы емес пе?
Dialogue: 0,0:37:00.90,0:37:01.89,,NTP,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:37:01.96,0:37:04.30,,NTP,0000,0000,0000,,Аа, дұрыс жерде.
Dialogue: 0,0:37:04.54,0:37:05.64,,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:37:07.37,0:37:09.52,,NTP,0000,0000,0000,,Онда маған мынаны беріңізші.
Dialogue: 0,0:37:09.93,0:37:12.15,,NTP,0000,0000,0000,,Аа, бұл кешкі асқа гарнир.
Dialogue: 0,0:37:12.36,0:37:13.46,,NTP,0000,0000,0000,,Танысқаныма қуаныштымын.
Dialogue: 0,0:37:13.39,0:37:15.38,,NTP,0000,0000,0000,,Қош келдіңіз
Dialogue: 0,0:37:18.45,0:37:20.17,,NTP,0000,0000,0000,,Сыртқа шығу
Dialogue: 0,0:37:21.94,0:37:23.77,,NTP,0000,0000,0000,,Чи
Dialogue: 0,0:37:27.06,0:37:28.77,,NTP,0000,0000,0000,,Соба мейрамханасына барған сайын.
Dialogue: 0,0:37:30.12,0:37:33.16,,NTP,0000,0000,0000,,Мен дүкенге бара алмадым.
Dialogue: 0,0:37:34.09,0:37:36.88,,NTP,0000,0000,0000,,Иә, жақын арада Чиге айтуым керек.
Dialogue: 0,0:37:36.83,0:37:37.95,,NTP,0000,0000,0000,,Не
Dialogue: 0,0:37:37.72,0:37:39.45,,NTP,0000,0000,0000,,Мен алыстамын.
Dialogue: 0,0:37:39.70,0:37:43.98,,NTP,0000,0000,0000,,Мен үйде отырсам болады ма?
Dialogue: 0,0:37:45.07,0:37:48.26,,NTP,0000,0000,0000,,Міне, мен бұған дейін үйреніп қалған сияқтымын.
Dialogue: 0,0:37:50.00,0:37:52.02,,NTP,0000,0000,0000,,Жақын арада бәрі жақсы болады деп ойлаймын.
Dialogue: 0,0:37:54.00,0:37:56.76,,NTP,0000,0000,0000,,Иә, солай істейік.
Dialogue: 0,0:37:57.12,0:37:58.70,,NTP,0000,0000,0000,,Жарайды, егер солай шешсеңіз.
Dialogue: 0,0:37:59.16,0:38:02.62,,NTP,0000,0000,0000,,Келесі жексенбіде Чи бірінші рет үйде отыр.
Dialogue: 0,0:38:05.43,0:38:06.44,,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:38:10.20,0:38:12.97,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:38:13.13,0:38:16.13,,NTP,0000,0000,0000,,Мен сонша сүтке ризамын
Dialogue: 0,0:38:16.24,0:38:22.80,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:38:22.89,0:38:25.57,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:38:25.69,0:38:29.09,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:38:29.22,0:38:34.22,,NTP,0000,0000,0000,,Жатып, бақытты болу
Dialogue: 0,0:38:34.69,0:38:37.00,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:38:39.35,0:38:42.84,,NTP,0000,0000,0000,,Мм, мен шыныаяқтар мен заттарды тазалауым керек сияқты.
Dialogue: 0,0:38:42.89,0:38:46.13,,NTP,0000,0000,0000,,Сыртқа шықпау үшін есікті құлыптап алғаныңызға көз жеткіздіңіз бе?
Dialogue: 0,0:38:47.20,0:38:49.07,,NTP,0000,0000,0000,,Барлығы не істеп жатыр?
Dialogue: 0,0:38:49.53,0:38:52.18,,NTP,0000,0000,0000,,Дұрыс, мен қазірдің өзінде қарауым керек.
Dialogue: 0,0:38:52.43,0:38:53.69,,NTP,0000,0000,0000,,Не
Dialogue: 0,0:38:54.15,0:38:56.07,,NTP,0000,0000,0000,,Дәретхана құмы
Dialogue: 0,0:38:56.59,0:38:59.68,,NTP,0000,0000,0000,,Мама, мен не істеуім керек?
Dialogue: 0,0:39:00.43,0:39:04.32,,NTP,0000,0000,0000,,Иә, Йохеи, ойыншықтарыңды таста.
Dialogue: 0,0:39:04.53,0:39:06.11,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:39:10.33,0:39:11.33,,NTP,0000,0000,0000,,Нян
Dialogue: 0,0:39:12.16,0:39:17.80,,NTP,0000,0000,0000,,Чи Рахмет Чи
Dialogue: 0,0:39:19.38,0:39:21.74,,NTP,0000,0000,0000,,Ойнамау бөліміне өтіңіз
Dialogue: 0,0:39:26.96,0:39:32.17,,NTP,0000,0000,0000,,қызықты олжа
Dialogue: 0,0:39:32.09,0:39:33.68,,NTP,0000,0000,0000,,Чи
Dialogue: 0,0:39:37.58,0:39:39.86,,NTP,0000,0000,0000,,Ци, маған кедергі жасама.
Dialogue: 0,0:39:40.21,0:39:42.15,,NTP,0000,0000,0000,,Чи жалғыз жүргенде
Dialogue: 0,0:39:42.21,0:39:47.35,,NTP,0000,0000,0000,,Шатасып кетпес үшін оны тазалаңыз.
Dialogue: 0,0:39:49.35,0:39:52.27,,NTP,0000,0000,0000,,Жарайды, енді дайынсың.
Dialogue: 0,0:39:53.10,0:39:54.62,,NTP,0000,0000,0000,,Жалықтырғыш
Dialogue: 0,0:39:55.28,0:39:59.45,,NTP,0000,0000,0000,,Мен алмаймын. Мен Чидің асын ұмытайын деп тұрмын.
Dialogue: 0,0:40:06.31,0:40:07.89,,NTP,0000,0000,0000,,Сіз соншалықты көп жей аласыз ба?
Dialogue: 0,0:40:08.00,0:40:10.16,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:40:10.75,0:40:14.13,,NTP,0000,0000,0000,,Чи үйде, сондықтан мен сізге әдеттегіден жақсырақ қызмет көрсетемін.
Dialogue: 0,0:40:15.78,0:40:19.95,,NTP,0000,0000,0000,,Әй, әй, сыртқа шықсаң, қазір.
Dialogue: 0,0:40:20.18,0:40:21.79,,NTP,0000,0000,0000,,Солай ма?
Dialogue: 0,0:40:22.36,0:40:23.63,,NTP,0000,0000,0000,,Дәмді
Dialogue: 0,0:40:28.25,0:40:29.86,,NTP,0000,0000,0000,,Енді кеттік.
Dialogue: 0,0:40:30.27,0:40:31.59,,NTP,0000,0000,0000,,Сыртқа шығу
Dialogue: 0,0:40:32.15,0:40:36.32,,NTP,0000,0000,0000,,Бірақ Чидің үйде жалғыз қалуы дұрыс па?
Dialogue: 0,0:40:37.32,0:40:38.53,,NTP,0000,0000,0000,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,0:40:39.01,0:40:40.07,,NTP,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:40:40.35,0:40:43.63,,NTP,0000,0000,0000,,Чи жалғыз болса да мен өзімді жалғыз сезінбеймін.
Dialogue: 0,0:40:43.77,0:40:46.57,,NTP,0000,0000,0000,,Ешқандай уайымдамаңыз
Dialogue: 0,0:40:47.51,0:40:48.63,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:40:48.42,0:40:49.29,,NTP,0000,0000,0000,,Әкем
Dialogue: 0,0:40:51.25,0:40:54.17,,NTP,0000,0000,0000,,Саған оны үйде ұстауды айтқан әкең болса керек.
Dialogue: 0,0:40:54.38,0:40:55.94,,NTP,0000,0000,0000,,Иә, иә, дұрыс.
Dialogue: 0,0:40:56.14,0:40:57.38,,NTP,0000,0000,0000,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:40:57.31,0:40:58.73,,NTP,0000,0000,0000,,Өйткені Чи
Dialogue: 0,0:40:58.70,0:41:01.39,,NTP,0000,0000,0000,,Қандай жағдай болмасын, мен барамын.
Dialogue: 0,0:41:01.31,0:41:02.81,,NTP,0000,0000,0000,,Помпон
Dialogue: 0,0:41:06.22,0:41:09.01,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:41:09.13,0:41:12.19,,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:41:12.30,0:41:18.88,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:41:19.00,0:41:21.71,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:41:21.80,0:41:25.20,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:41:25.31,0:41:30.64,,NTP,0000,0000,0000,,Жатып бақытты болу
Dialogue: 0,0:41:30.77,0:41:33.14,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:41:36.71,0:41:38.77,,NTP,0000,0000,0000,,Помпон
Dialogue: 0,0:41:38.75,0:41:41.41,,NTP,0000,0000,0000,,Бәріміз бірге далаға шыққанымызға біраз болды.
Dialogue: 0,0:41:41.54,0:41:45.25,,NTP,0000,0000,0000,,Иә, ауа-райы жақсы, бұл жақсы.
Dialogue: 0,0:41:46.36,0:41:48.49,,NTP,0000,0000,0000,,Бұл не болды?
Dialogue: 0,0:41:49.14,0:41:53.43,,NTP,0000,0000,0000,,Өйткені, Чидің үйде жалғыз болғаны дұрыс па деп ойлаймын.
Dialogue: 0,0:41:53.40,0:41:56.38,,NTP,0000,0000,0000,,Уайымдамаңыз, мен мұқият дайындалдым.
Dialogue: 0,0:41:56.77,0:41:57.75,,NTP,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:41:57.71,0:41:59.19,,NTP,0000,0000,0000,,Олай болса кеттік
Dialogue: 0,0:41:59.32,0:42:00.43,,NTP,0000,0000,0000,,Бұл
Dialogue: 0,0:42:00.44,0:42:01.50,,NTP,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:42:02.07,0:42:04.59,,NTP,0000,0000,0000,,Жуынатын бөлменің есігін жаптың ба?
Dialogue: 0,0:42:05.33,0:42:08.08,,NTP,0000,0000,0000,,Чи ваннаға түсіп кетсе қауіпті болар еді.
Dialogue: 0,0:42:08.11,0:42:11.61,,NTP,0000,0000,0000,,Иә, бірақ мен оны жабуым керек еді.
Dialogue: 0,0:42:11.74,0:42:14.35,,NTP,0000,0000,0000,,Иә, кешіріңіз, мен қараймын.
Dialogue: 0,0:42:17.69,0:42:19.73,,NTP,0000,0000,0000,,Сіз қазірдің өзінде алаңдауыңыз керек.
Dialogue: 0,0:42:24.64,0:42:26.52,,NTP,0000,0000,0000,,Йосиун
Dialogue: 0,0:42:29.42,0:42:32.01,,NTP,0000,0000,0000,,Чи, мен жақсы қыз боламын және сені күтемін.
Dialogue: 0,0:42:36.04,0:42:38.95,,NTP,0000,0000,0000,,Кешіріңіз, бәрі жақсы болды. Барайық.
Dialogue: 0,0:42:39.00,0:42:40.00,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:42:40.19,0:42:43.53,,NTP,0000,0000,0000,,Кәстрөлдегі суды ағыздың ба?
Dialogue: 0,0:42:43.85,0:42:46.31,,NTP,0000,0000,0000,,Мен пышақты қойдым деп ойлаймын.
Dialogue: 0,0:42:46.49,0:42:48.57,,NTP,0000,0000,0000,,Мен бәрін жақсы орындадым.
Dialogue: 0,0:42:49.08,0:42:51.72,,NTP,0000,0000,0000,,Мен қараймын.
Dialogue: 0,0:42:51.85,0:42:54.17,,NTP,0000,0000,0000,,Әке
Dialogue: 0,0:42:54.86,0:42:56.26,,NTP,0000,0000,0000,,Мен уайымдап тұрмын
Dialogue: 0,0:43:09.19,0:43:12.62,,NTP,0000,0000,0000,,Бұл не? Бұл не?
Dialogue: 0,0:43:20.75,0:43:24.35,,NTP,0000,0000,0000,,Ашулан, қаш
Dialogue: 0,0:43:36.36,0:43:40.82,,NTP,0000,0000,0000,,Барлығы сыртқа шығып жатыр. Мұнда ешкім жоқ.
Dialogue: 0,0:43:41.31,0:43:43.57,,NTP,0000,0000,0000,,Мен жасадым. Мен ашуланбаймын.
Dialogue: 0,0:43:44.10,0:43:46.36,,NTP,0000,0000,0000,,Қандай жағдай болмасын, мен ашуланбаймын.
Dialogue: 0,0:43:46.58,0:43:48.51,,NTP,0000,0000,0000,,Мүлдем ашулы емес
Dialogue: 0,0:43:53.95,0:43:55.75,,NTP,0000,0000,0000,,Көңілді
Dialogue: 0,0:44:02.42,0:44:05.08,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:44:05.21,0:44:08.28,,NTP,0000,0000,0000,,Мен сонша сүтке ризамын
Dialogue: 0,0:44:08.40,0:44:14.91,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:44:15.03,0:44:17.73,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:44:17.84,0:44:21.19,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:44:21.28,0:44:26.39,,NTP,0000,0000,0000,,Бақытты жату
Dialogue: 0,0:44:26.78,0:44:29.41,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:44:34.15,0:44:36.36,,NTP,0000,0000,0000,,Пи Чан келді
Dialogue: 0,0:44:37.17,0:44:39.43,,NTP,0000,0000,0000,,Чи ұлылығы
Dialogue: 0,0:44:43.19,0:44:46.86,,NTP,0000,0000,0000,,Түсіндім, мұнда ешкім жоқ.
Dialogue: 0,0:44:49.18,0:44:50.67,,NTP,0000,0000,0000,,Ас үшін рахмет
Dialogue: 0,0:44:51.35,0:44:53.84,,NTP,0000,0000,0000,,О, мен бүгін ештеңені төкпей жедім.
Dialogue: 0,0:44:54.53,0:44:56.07,,NTP,0000,0000,0000,,Йохай Ұлы
Dialogue: 0,0:45:22.11,0:45:24.12,,NTP,0000,0000,0000,,Мен қайтамын.
Dialogue: 0,0:45:28.09,0:45:29.41,,NTP,0000,0000,0000,,Қайтадан қош келдіңіз
Dialogue: 0,0:45:30.16,0:45:31.42,,NTP,0000,0000,0000,,Әр жолы рахмет
Dialogue: 0,0:45:31.23,0:45:32.70,,NTP,0000,0000,0000,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:45:37.38,0:45:46.36,,NTP,0000,0000,0000,,Сіз қайтасыз. Қайтып келсең мен саған ренжіп қаламын.
Dialogue: 0,0:45:49.76,0:45:52.58,,NTP,0000,0000,0000,,Чи сувенир Сізге ұнайды деп үміттенемін
Dialogue: 0,0:45:52.83,0:45:54.75,,NTP,0000,0000,0000,,Осы күндері не істеп жүрсің деп ойлаймын.
Dialogue: 0,0:45:55.23,0:45:57.89,,NTP,0000,0000,0000,,Мені сағынғаныңызға сенімдімін
Dialogue: 0,0:46:02.00,0:46:05.28,,NTP,0000,0000,0000,,Ци Бүгін сен жалғыз болдың ғой, солай ма?
Dialogue: 0,0:46:11.94,0:46:16.05,,NTP,0000,0000,0000,,О, Ямада мырза, қош келдіңіз.
Dialogue: 0,0:46:16.23,0:46:17.17,,NTP,0000,0000,0000,,Қайырлы кеш
Dialogue: 0,0:46:18.10,0:46:19.71,,NTP,0000,0000,0000,,бірақ мен де, Ято да ақша табуымыз керек қой!
Dialogue: 0,0:46:21.78,0:46:24.72,,NTP,0000,0000,0000,,Не, сен ұйықтаушысың ба?
Dialogue: 0,0:46:25.12,0:46:27.90,,NTP,0000,0000,0000,,Уайымдап үйге асығыс келдіңіз.
Dialogue: 0,0:46:29.14,0:46:32.68,,NTP,0000,0000,0000,,Чи, мен үйде жалғыз қалдым. Жарайсың.
Dialogue: 0,0:46:34.16,0:46:36.13,,NTP,0000,0000,0000,,О, диван.
Dialogue: 0,0:46:36.15,0:46:38.08,,NTP,0000,0000,0000,,Ваза.
Dialogue: 0,0:46:38.31,0:46:39.73,,NTP,0000,0000,0000,,А, перделер.
Dialogue: 0,0:46:39.76,0:46:40.86,,NTP,0000,0000,0000,,Тін
Dialogue: 0,0:46:40.86,0:46:42.25,,NTP,0000,0000,0000,,Жастық.
Dialogue: 0,0:46:43.22,0:46:44.91,,NTP,0000,0000,0000,,Әке, тазалауға көмектесіңізші.
Dialogue: 0,0:46:45.21,0:46:47.33,,NTP,0000,0000,0000,,Анашым, маған осында көмектесіңізші.
Dialogue: 0,0:46:47.56,0:46:51.09,,NTP,0000,0000,0000,,Не, сонша су төгіп алдың ба?
Dialogue: 0,0:46:51.89,0:46:54.21,,NTP,0000,0000,0000,,Әке, маған ыдыс орамал әкеліңіз.
Dialogue: 0,0:46:54.01,0:46:55.45,,NTP,0000,0000,0000,,Барлығыңызға қош келдіңіздер
Dialogue: 0,0:00:02.09,0:00:07.70,,NTP,0000,0000,0000,,Бұл субтитрді Yumorokami Subtitle Group (kamigami.org) шығарған және оқу алмасуларында шектеулі пайдалануға арналған. Йошитака Вакаенің бұл жұмысына түпнұсқа бейне өнімі қолдау көрсетеді.
Dialogue: 0,0:46:56.95,0:47:02.95,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory