Dialogue: 0,0:00:01.86,0:00:04.43,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:00:04.81,0:00:07.69,,NTP,0000,0000,0000,,Мен сонша сүтке ризамын
Dialogue: 0,0:00:07.82,0:00:14.31,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:00:14.42,0:00:17.10,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:00:17.21,0:00:20.63,,NTP,0000,0000,0000,,Дәмді тағаммен толтырылған
Dialogue: 0,0:00:20.72,0:00:25.77,,NTP,0000,0000,0000,,Бақытты жату
Dialogue: 0,0:00:26.20,0:00:28.85,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:00:46.78,0:00:47.06,,NTP,0000,0000,0000,,Мияу
Dialogue: 0,0:00:47.49,0:00:47.81,,NTP,0000,0000,0000,,Мияу
Dialogue: 0,0:00:48.17,0:00:48.85,,NTP,0000,0000,0000,,Мияу мияу
Dialogue: 0,0:00:50.84,0:00:52.52,,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:00:54.12,0:00:55.96,,NTP,0000,0000,0000,,Мама, қайсысы?
Dialogue: 0,0:00:56.36,0:00:58.31,,NTP,0000,0000,0000,,Қайсысы, қайсысы?
Dialogue: 0,0:01:01.57,0:01:02.88,,NTP,0000,0000,0000,,Күйші
Dialogue: 0,0:01:04.14,0:01:06.70,,NTP,0000,0000,0000,,Мама, мама
Dialogue: 0,0:01:06.88,0:01:09.24,,NTP,0000,0000,0000,,Уау, уау, уау, уау
Dialogue: 0,0:01:09.59,0:01:11.61,,NTP,0000,0000,0000,,Анамның қайда екенін білесің бе?
Dialogue: 0,0:01:11.86,0:01:12.00,,NTP,0000,0000,0000,,Уау
Dialogue: 0,0:01:12.17,0:01:13.18,,NTP,0000,0000,0000,,Уау!
Dialogue: 0,0:01:13.66,0:01:15.04,,NTP,0000,0000,0000,,Уау, уау, уау, уау
Dialogue: 0,0:01:15.21,0:01:16.67,,NTP,0000,0000,0000,,Ах, аа,
Dialogue: 0,0:01:16.87,0:01:19.51,,NTP,0000,0000,0000,,А, мен таң қалдым.
Dialogue: 0,0:01:19.69,0:01:20.28,,NTP,0000,0000,0000,,Бибі
Dialogue: 0,0:01:23.62,0:01:26.29,,NTP,0000,0000,0000,,Өте ыстық!
Dialogue: 0,0:01:26.52,0:01:27.34,,NTP,0000,0000,0000,,Мя
Dialogue: 0,0:01:27.59,0:01:29.22,,NTP,0000,0000,0000,,Мен үйге бара жатырмын~
Dialogue: 0,0:01:34.02,0:01:36.44,,NTP,0000,0000,0000,,Біз қайдамыз?
Dialogue: 0,0:01:36.70,0:01:37.97,,NTP,0000,0000,0000,,Гяаа
Dialogue: 0,0:01:38.47,0:01:40.57,,NTP,0000,0000,0000,,Сіз мені танисыз ба?
Dialogue: 0,0:01:46.88,0:01:48.56,,NTP,0000,0000,0000,,Жыл бойы шорт киетін ұрғашы горилла ма!?
Dialogue: 0,0:01:50.00,0:01:52.67,,NTP,0000,0000,0000,,Менің қарным ашты.
Dialogue: 0,0:01:58.98,0:02:06.42,,NTP,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,0:02:07.29,0:02:09.63,,NTP,0000,0000,0000,,Хахаха, хахахаха, хаха
Dialogue: 0,0:02:09.82,0:02:11.08,,NTP,0000,0000,0000,,Иә, аха!
Dialogue: 0,0:02:11.28,0:02:12.57,,NTP,0000,0000,0000,,Аха, аха, аха!
Dialogue: 0,0:02:13.39,0:02:16.46,,NTP,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,0:02:26.75,0:02:33.61,,NTP,0000,0000,0000,,Сіз түсінбейсіз, солай ма?
Dialogue: 0,0:02:33.76,0:02:35.76,,NTP,0000,0000,0000,,Йохай!
Dialogue: 0,0:02:35.94,0:02:41.14,,NTP,0000,0000,0000,,Құлап қалсаң да, өзің тұр~
Dialogue: 0,0:02:41.27,0:02:44.23,,NTP,0000,0000,0000,,Ана~
Dialogue: 0,0:02:44.55,0:02:47.53,,NTP,0000,0000,0000,,Мысық құлап жатыр
Dialogue: 0,0:02:47.70,0:02:50.70,,NTP,0000,0000,0000,,Кешіріңіз, маған не болды~
Dialogue: 0,0:02:50.85,0:02:52.21,,NTP,0000,0000,0000,,Иә~
Dialogue: 0,0:02:57.80,0:03:00.59,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:03:00.64,0:03:03.67,,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:03:03.75,0:03:10.33,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:03:10.52,0:03:13.11,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:03:13.21,0:03:16.68,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:03:16.77,0:03:21.76,,NTP,0000,0000,0000,,Бақытты жату
Dialogue: 0,0:03:22.44,0:03:25.41,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:03:29.60,0:03:32.82,,NTP,0000,0000,0000,,Кю~
Dialogue: 0,0:03:32.97,0:03:38.65,,NTP,0000,0000,0000,,Мен үйге бара жатырмын. Мама~
Dialogue: 0,0:03:39.09,0:03:41.02,,NTP,0000,0000,0000,,Хи-кю-
Dialogue: 0,0:03:41.19,0:03:44.40,,NTP,0000,0000,0000,,Кя! ~~
Dialogue: 0,0:03:45.03,0:03:48.87,,NTP,0000,0000,0000,,Иә? Бұл қайда?
Dialogue: 0,0:03:49.00,0:03:50.40,,NTP,0000,0000,0000,,Некодан
Dialogue: 0,0:03:50.50,0:03:52.36,,NTP,0000,0000,0000,,Қозғалыс
Dialogue: 0,0:03:54.14,0:03:56.69,,NTP,0000,0000,0000,,Шөп құлап жатыр.
Dialogue: 0,0:03:56.78,0:03:59.46,,NTP,0000,0000,0000,,Неге сен де осындасың?
Dialogue: 0,0:03:59.57,0:04:01.09,,NTP,0000,0000,0000,,О, байқадың ба?
Dialogue: 0,0:04:01.05,0:04:02.32,,NTP,0000,0000,0000,,Өзіңізді жақсы сезінесіз бе?
Dialogue: 0,0:04:02.45,0:04:03.23,,NTP,0000,0000,0000,,Мияу! ~
Dialogue: 0,0:04:06.43,0:04:09.45,,NTP,0000,0000,0000,,Бұл тұйыққа тіреледі~
Dialogue: 0,0:04:09.68,0:04:11.39,,NTP,0000,0000,0000,,О~ой~
Dialogue: 0,0:04:11.58,0:04:14.77,,NTP,0000,0000,0000,,Оча~Сен мені таң қалдырдың~
Dialogue: 0,0:04:15.17,0:04:18.88,,NTP,0000,0000,0000,,Иә~и~
Dialogue: 0,0:04:19.05,0:04:21.75,,NTP,0000,0000,0000,,А, бұл не?
Dialogue: 0,0:04:21.89,0:04:27.56,,NTP,0000,0000,0000,,Иә, мен сізді аш болуыңыз мүмкін деп ойладым.
Dialogue: 0,0:04:27.92,0:04:31.93,,NTP,0000,0000,0000,,Сіз оны ішесіз бе?
Dialogue: 0,0:04:32.02,0:04:34.93,,NTP,0000,0000,0000,,Иісі дәмді.
Dialogue: 0,0:04:35.05,0:04:37.34,,NTP,0000,0000,0000,,Әй, сүт!
Dialogue: 0,0:04:39.98,0:04:40.71,,NTP,0000,0000,0000,,Ха~
Dialogue: 0,0:04:40.88,0:04:42.71,,NTP,0000,0000,0000,,Сіз мысық ұстайсыз ба?
Dialogue: 0,0:04:42.88,0:04:47.57,,NTP,0000,0000,0000,,Иә, менің пәтеріме иттер мен мысықтар кірмейді.
Dialogue: 0,0:00:00.00,0:00:00.00,,NTP,0000,0000,0000,,Өйткені біз мұны өзіміз жасай алмаймыз,
Dialogue: 0,0:04:47.71,0:04:51.62,,NTP,0000,0000,0000,,Мен мұны өзім істей алмайтындықтан, оны алатын адам табуым керек.
Dialogue: 0,0:04:51.88,0:04:53.20,,NTP,0000,0000,0000,,Кю~
Dialogue: 0,0:04:55.31,0:04:57.83,,NTP,0000,0000,0000,,Понпонда~
Dialogue: 0,0:04:58.30,0:05:03.03,,NTP,0000,0000,0000,,Хю~ху~
Dialogue: 0,0:05:07.23,0:05:10.97,,NTP,0000,0000,0000,,Мен үйге бара жатырмын!
Dialogue: 0,0:05:11.15,0:05:13.99,,NTP,0000,0000,0000,,Мысық, далаға шыққың келе ме?
Dialogue: 0,0:05:15.71,0:05:16.54,,NTP,0000,0000,0000,,Ха~
Dialogue: 0,0:05:17.39,0:05:19.69,,NTP,0000,0000,0000,,Әй, үй, ә, үй, ә, үй~
Dialogue: 0,0:05:19.84,0:05:22.21,,NTP,0000,0000,0000,,А, Учи, А, Учи, А?
Dialogue: 0,0:05:23.78,0:05:29.32,,NTP,0000,0000,0000,,Уау~Уау~Уау~
Dialogue: 0,0:05:29.52,0:05:33.98,,NTP,0000,0000,0000,,Кю~вааа~
Dialogue: 0,0:05:34.97,0:05:38.38,,NTP,0000,0000,0000,,Йохеи, әкімші сізді табатын шығар~
Dialogue: 0,0:05:38.30,0:05:39.20,,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:05:39.00,0:05:40.20,,NTP,0000,0000,0000,,Мияу~
Dialogue: 0,0:05:44.20,0:05:49.86,,NTP,0000,0000,0000,,Осы жерде тағы біраз тығылайық
Dialogue: 0,0:05:53.83,0:05:56.54,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:05:56.72,0:05:59.68,,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:05:59.82,0:06:06.40,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:06:06.55,0:06:09.14,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:06:09.25,0:06:12.47,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:06:12.58,0:06:17.39,,NTP,0000,0000,0000,,Бақытты жату
Dialogue: 0,0:06:18.37,0:06:20.30,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:06:26.49,0:06:29.84,,NTP,0000,0000,0000,,Сыпырғыш
Dialogue: 0,0:06:31.27,0:06:34.79,,NTP,0000,0000,0000,,Жақсы төсек, бірақ сау бол
Dialogue: 0,0:06:35.25,0:06:37.82,,NTP,0000,0000,0000,,Мен үйге бара жатырмын!
Dialogue: 0,0:06:38.47,0:06:40.38,,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:06:41.51,0:06:43.44,,NTP,0000,0000,0000,,Ах! Аэ! Аэ!
Dialogue: 0,0:06:43.68,0:06:48.78,,NTP,0000,0000,0000,,Ах! Аэ! Аэ!
Dialogue: 0,0:06:49.41,0:06:50.50,,NTP,0000,0000,0000,,Жібер
Dialogue: 0,0:06:50.96,0:06:52.65,,NTP,0000,0000,0000,,Иә, иә
Dialogue: 0,0:06:57.43,0:07:00.39,,NTP,0000,0000,0000,,Иә, мен оны тазалаймын.
Dialogue: 0,0:07:00.55,0:07:02.72,,NTP,0000,0000,0000,,Ал, кеттік~
Dialogue: 0,0:07:04.37,0:07:06.27,,NTP,0000,0000,0000,,Мияу! ! !
Dialogue: 0,0:07:08.53,0:07:13.29,,NTP,0000,0000,0000,,Оны алыңыз
Dialogue: 0,0:07:13.42,0:07:16.99,,NTP,0000,0000,0000,,Қашпа
Dialogue: 0,0:07:17.14,0:07:19.11,,NTP,0000,0000,0000,,Мияу! ! !
Dialogue: 0,0:07:19.73,0:07:24.80,,NTP,0000,0000,0000,,Ах-ах-ня! ! !
Dialogue: 0,0:07:25.65,0:07:27.56,,NTP,0000,0000,0000,,Эй, эй, эй! !
Dialogue: 0,0:07:27.76,0:07:29.28,,NTP,0000,0000,0000,,Ей, мықты бол!
Dialogue: 0,0:07:29.41,0:07:32.08,,NTP,0000,0000,0000,,Не болды? Сенімен бәрі жақсы ма?
Dialogue: 0,0:07:32.24,0:07:33.08,,NTP,0000,0000,0000,,Ikee~
Dialogue: 0,0:07:33.26,0:07:35.91,,NTP,0000,0000,0000,,Бұл мүмкін емес қой?
Dialogue: 0,0:07:36.69,0:07:38.24,,NTP,0000,0000,0000,,Жарайды~
Dialogue: 0,0:07:38.38,0:07:41.07,,NTP,0000,0000,0000,,Чи~мяу~! !
Dialogue: 0,0:07:41.75,0:07:44.03,,NTP,0000,0000,0000,,Чи~мяу~ өлтіріледі~
Dialogue: 0,0:07:44.27,0:07:46.85,,NTP,0000,0000,0000,,Бұл мүмкін емес қой?
Dialogue: 0,0:07:47.01,0:07:48.99,,NTP,0000,0000,0000,,'Жоқ—ол қайта қосылып жатыр ма? Бөлініп кеткен бөліктері…'
Dialogue: 0,0:07:50.61,0:07:52.92,,NTP,0000,0000,0000,,Эх-хэ-хэ
Dialogue: 0,0:07:53.08,0:07:57.44,,NTP,0000,0000,0000,,А, менде қорқынышты оқиға болды.
Dialogue: 0,0:07:58.44,0:08:00.15,,NTP,0000,0000,0000,,Олай болса, келесі.
Dialogue: 0,0:08:00.32,0:08:01.32,,NTP,0000,0000,0000,,Аяғын батпаққа тығып алып, осы жардан құлап кеткен бе? ➡
Dialogue: 0,0:08:04.48,0:08:06.44,,NTP,0000,0000,0000,,үшін? ~
Dialogue: 0,0:08:06.96,0:08:08.70,,NTP,0000,0000,0000,,Гяа! !
Dialogue: 0,0:08:09.75,0:08:12.66,,NTP,0000,0000,0000,,Мысықты жуу қиын емес пе?
Dialogue: 0,0:08:12.88,0:08:16.35,,NTP,0000,0000,0000,,және шаш кептіргіш жақсы сезінеді.
Dialogue: 0,0:08:18.40,0:08:21.79,,NTP,0000,0000,0000,,Мен өлемін деп ойладым
Dialogue: 0,0:08:24.44,0:08:28.07,,NTP,0000,0000,0000,,Мен өлмегеніме қуаныштымын.
Dialogue: 0,0:08:28.67,0:08:29.63,,NTP,0000,0000,0000,,Уха~
Dialogue: 0,0:08:29.81,0:08:31.29,,NTP,0000,0000,0000,,Енді таза!
Dialogue: 0,0:08:31.48,0:08:32.74,,NTP,0000,0000,0000,,Бұл дұрыс~
Dialogue: 0,0:08:32.90,0:08:36.28,,NTP,0000,0000,0000,,Қараңдаршы, арқаларың тегіс.
Dialogue: 0,0:08:36.46,0:08:37.78,,NTP,0000,0000,0000,,Бұл дұрыс~
Dialogue: 0,0:08:37.97,0:08:39.16,,NTP,0000,0000,0000,,Сізге жақсы
Dialogue: 0,0:08:40.01,0:08:41.46,,NTP,0000,0000,0000,,Әдемі ~ Әдемі
Dialogue: 0,0:08:41.60,0:08:43.26,,NTP,0000,0000,0000,,Жылтыр~
Dialogue: 0,0:08:43.40,0:08:44.14,,NTP,0000,0000,0000,,Мүмкін
Dialogue: 0,0:08:44.42,0:08:46.31,,NTP,0000,0000,0000,,Ахаха, үлпілдек~
Dialogue: 0,0:08:49.82,0:08:52.66,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:08:52.78,0:08:55.76,,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:08:55.89,0:09:02.45,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:09:02.57,0:09:05.30,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:09:05.39,0:09:08.82,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:09:08.93,0:09:13.40,,NTP,0000,0000,0000,,Жатып бақытты болу
Dialogue: 0,0:09:14.32,0:09:16.66,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:09:25.90,0:09:27.87,,NTP,0000,0000,0000,,Мен үйге бара жатырмын!
Dialogue: 0,0:09:30.51,0:09:37.42,,NTP,0000,0000,0000,,Жарайды, мен котенка таптым, оны ұстайсың ба?
Dialogue: 0,0:09:38.97,0:09:41.29,,NTP,0000,0000,0000,,Сүт!
Dialogue: 0,0:09:41.98,0:09:46.30,,NTP,0000,0000,0000,,Түсіндім, қалғанын қараймын.
Dialogue: 0,0:09:47.17,0:09:52.10,,NTP,0000,0000,0000,,Мияу! Бұл понпон
Dialogue: 0,0:09:52.38,0:09:58.37,,NTP,0000,0000,0000,,Сатып алушыны табу қиын.
Dialogue: 0,0:10:02.62,0:10:04.12,,NTP,0000,0000,0000,,Мен үйге бара жатырмын!
Dialogue: 0,0:10:06.94,0:10:08.16,,NTP,0000,0000,0000,,Хо, хо?
Dialogue: 0,0:10:09.69,0:10:12.94,,NTP,0000,0000,0000,,Бұл тест
Dialogue: 0,0:10:14.18,0:10:19.48,,NTP,0000,0000,0000,,Мен оны көре алмаймын~
Dialogue: 0,0:10:32.77,0:10:34.68,,NTP,0000,0000,0000,,Иә!
Dialogue: 0,0:10:37.97,0:10:41.48,,NTP,0000,0000,0000,,Мен үйге бара жатырмын!
Dialogue: 0,0:10:52.43,0:10:55.93,,NTP,0000,0000,0000,,Мияу~
Dialogue: 0,0:11:04.74,0:11:06.90,,NTP,0000,0000,0000,,Бұл қызықты болды
Dialogue: 0,0:11:08.11,0:11:13.36,,NTP,0000,0000,0000,,Мияу, иә?
Dialogue: 0,0:11:13.82,0:11:15.60,,NTP,0000,0000,0000,,Мен бір нәрсені ұмытып қалдым
Dialogue: 0,0:11:15.76,0:11:20.15,,NTP,0000,0000,0000,,Ух
Dialogue: 0,0:11:23.91,0:11:28.08,,NTP,0000,0000,0000,,Мама, мысық есік алдында.
Dialogue: 0,0:11:28.25,0:11:32.54,,NTP,0000,0000,0000,,Өзін жақсы сезіну.
Dialogue: 0,0:11:45.80,0:11:48.61,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:11:48.72,0:11:51.80,,NTP,0000,0000,0000,,Мен сонша сүтке ризамын
Dialogue: 0,0:11:51.94,0:11:58.38,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:11:58.50,0:12:01.20,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:12:01.33,0:12:04.77,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:12:04.89,0:12:09.91,,NTP,0000,0000,0000,,Жатып, бақытты болу
Dialogue: 0,0:12:10.26,0:12:12.65,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:12:17.18,0:12:23.09,,NTP,0000,0000,0000,,Сисе, сиса~
Dialogue: 0,0:12:27.15,0:12:30.61,,NTP,0000,0000,0000,,Сіз газетті қолдануға болады деп естідіңіз бе?
Dialogue: 0,0:12:30.78,0:12:31.99,,NTP,0000,0000,0000,,Рақмет, директор.
Dialogue: 0,0:12:33.21,0:12:35.87,,NTP,0000,0000,0000,,Мына жерден сидит
Dialogue: 0,0:12:36.04,0:12:38.76,,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:12:39.15,0:12:41.46,,NTP,0000,0000,0000,,ше? Ха~
Dialogue: 0,0:12:45.95,0:12:50.39,,NTP,0000,0000,0000,,Ойнайық
Dialogue: 0,0:12:51.14,0:12:54.25,,NTP,0000,0000,0000,,Бұл ойнайтын орын емес.
Dialogue: 0,0:12:54.40,0:12:57.91,,NTP,0000,0000,0000,,Дәретхана, әжетхана
Dialogue: 0,0:13:00.93,0:13:02.53,,NTP,0000,0000,0000,,Хааа~
Dialogue: 0,0:13:03.35,0:13:07.36,,NTP,0000,0000,0000,,Дұрыс, мынау әжетхана, эй~
Dialogue: 0,0:13:07.56,0:13:11.85,,NTP,0000,0000,0000,,О, қандай жақсы төсек!
Dialogue: 0,0:13:12.07,0:13:13.87,,NTP,0000,0000,0000,,Е...
Dialogue: 0,0:13:18.56,0:13:24.45,,NTP,0000,0000,0000,,Жарайды, мұндай нәрселерге шыдамдылық таныту керек.
Dialogue: 0,0:13:24.92,0:13:26.37,,NTP,0000,0000,0000,,Әй, сиыс
Dialogue: 0,0:13:26.57,0:13:29.98,,NTP,0000,0000,0000,,Мен зәр шығарайын деп жатырмын, қайда зәр шығаруым керек?
Dialogue: 0,0:13:30.13,0:13:34.43,,NTP,0000,0000,0000,,Ха~мяу~
Dialogue: 0,0:13:50.01,0:13:51.93,,NTP,0000,0000,0000,,Ах! ! !
Dialogue: 0,0:13:53.01,0:13:55.16,,NTP,0000,0000,0000,,Мен дұрыс зәр шығара алдым.
Dialogue: 0,0:13:55.85,0:13:57.27,,NTP,0000,0000,0000,,Міне! !
Dialogue: 0,0:13:59.45,0:14:03.20,,NTP,0000,0000,0000,,Жаңадан жуылған кір...
Dialogue: 0,0:14:03.34,0:14:04.47,,NTP,0000,0000,0000,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:14:04.68,0:14:06.28,,NTP,0000,0000,0000,,А-а, не?
Dialogue: 0,0:14:06.43,0:14:07.40,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:14:07.61,0:14:11.04,,NTP,0000,0000,0000,,Чи? Егер сіз Чи болсаңыз, ваннаға барыңыз.
Dialogue: 0,0:14:11.21,0:14:14.29,,NTP,0000,0000,0000,,Чи шықты.
Dialogue: 0,0:14:15.18,0:14:16.79,,NTP,0000,0000,0000,,Ах! ! !
Dialogue: 0,0:14:17.79,0:14:21.46,,NTP,0000,0000,0000,,Әйтеуір~ Чи кетпей тұрып ваннаға баруым керек~
Dialogue: 0,0:14:21.32,0:14:22.31,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:14:22.50,0:14:24.31,,NTP,0000,0000,0000,,О, Құдай-ай…
Dialogue: 0,0:14:31.54,0:14:38.24,,NTP,0000,0000,0000,,Жоқ, егер сіз сийіп кетсеңіз, сізге құмнан қоршау жасау керек болады~
Dialogue: 0,0:14:41.91,0:14:44.69,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:14:44.83,0:14:47.83,,NTP,0000,0000,0000,,Мен сонша сүтке ризамын
Dialogue: 0,0:14:47.98,0:14:54.50,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:14:54.61,0:14:57.33,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:14:57.42,0:15:00.83,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:15:00.96,0:15:05.94,,NTP,0000,0000,0000,,Бақытты жату
Dialogue: 0,0:15:06.38,0:15:08.62,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:15:15.09,0:15:16.43,,NTP,0000,0000,0000,,Пи
Dialogue: 0,0:15:16.61,0:15:20.38,,NTP,0000,0000,0000,,Біз қайда баруымыз керек? Мен қайда баруым керек? Біз қайда баруымыз керек? ?
Dialogue: 0,0:15:23.86,0:15:26.94,,NTP,0000,0000,0000,,Ха~мяу~
Dialogue: 0,0:15:32.45,0:15:36.20,,NTP,0000,0000,0000,,Ха! ! Олар мұны қайтадан жасады!
Dialogue: 0,0:15:36.37,0:15:39.66,,NTP,0000,0000,0000,,Неко-дан, мен Чи алдым.
Dialogue: 0,0:15:45.69,0:15:47.96,,NTP,0000,0000,0000,,Не? Не?
Dialogue: 0,0:15:48.10,0:15:50.22,,NTP,0000,0000,0000,,Сәлем! !
Dialogue: 0,0:15:52.68,0:15:59.20,,NTP,0000,0000,0000,,Мен таң қалдым! Не деп үріп жатырсың?
Dialogue: 0,0:15:59.59,0:16:01.46,,NTP,0000,0000,0000,,Мен үйдемін~
Dialogue: 0,0:16:01.84,0:16:04.47,,NTP,0000,0000,0000,,Сіздің мысығыңыз барлық жерге зәр беріп жатыр ма?
Dialogue: 0,0:16:04.67,0:16:08.48,,NTP,0000,0000,0000,,Мен Йохеи дәретхананы пайдалану кезінде азырақ қателеседі деп ойладым.
Dialogue: 0,0:16:08.62,0:16:12.96,,NTP,0000,0000,0000,,Енді мысықты үйретуге алаңдау керек.
Dialogue: 0,0:16:13.07,0:16:17.22,,NTP,0000,0000,0000,,Қарасам, бұл жігіт сәби екен.
Dialogue: 0,0:16:17.38,0:16:22.21,,NTP,0000,0000,0000,,Мүмкін мен мысық қоқыс үшін қоқыс сатып алуым керек шығар.
Dialogue: 0,0:16:22.35,0:16:28.23,,NTP,0000,0000,0000,,Иә, бірақ мен сатып алушы тапқанша ғана.
Dialogue: 0,0:16:28.25,0:16:31.75,,NTP,0000,0000,0000,,Мен қайда зәр шығаруым керек? Мен қайда зәр шығаруым керек?
Dialogue: 0,0:16:29.91,0:16:33.44,,NTP,0000,0000,0000,,Газеттерді шашумен ғана толқу мүмкін емес пе?
Dialogue: 0,0:16:33.67,0:16:36.66,,NTP,0000,0000,0000,,Бірақ бүгін мен бірнеше рет соққыға жығылдым.
Dialogue: 0,0:16:36.80,0:16:39.11,,NTP,0000,0000,0000,,Тіпті құрғақ кір
Dialogue: 0,0:16:39.27,0:16:43.42,,NTP,0000,0000,0000,,Эй, бірақ мысықтар кірдің не екенін білмейді.
Dialogue: 0,0:16:43.58,0:16:46.44,,NTP,0000,0000,0000,,Оған көмектесу мүмкін емес, өйткені мен оны сол жерге лақтырып жібердім.
Dialogue: 0,0:16:46.95,0:16:50.36,,NTP,0000,0000,0000,,Оны айтудың басқа жолы бар емес пе?
Dialogue: 0,0:16:50.56,0:16:53.43,,NTP,0000,0000,0000,,Иә, жоқ, солай деп ойлаймын.
Dialogue: 0,0:16:53.55,0:16:55.17,,NTP,0000,0000,0000,,Сәлем, әке.
Dialogue: 0,0:16:55.31,0:16:56.89,,NTP,0000,0000,0000,,Чи~
Dialogue: 0,0:16:57.56,0:17:02.06,,NTP,0000,0000,0000,,Не болды? Юхэй ваннаға өзі бара алады.
Dialogue: 0,0:17:02.05,0:17:02.37,,NTP,0000,0000,0000,,Чи~
Dialogue: 0,0:17:03.10,0:17:03.36,,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:17:06.04,0:17:12.18,,NTP,0000,0000,0000,,Әй, менің сүйікті сөмкем. . .
Dialogue: 0,0:17:12.33,0:17:15.23,,NTP,0000,0000,0000,,О, орындалды.
Dialogue: 0,0:17:15.40,0:17:18.35,,NTP,0000,0000,0000,,Мияу~Құм сынығы
Dialogue: 0,0:17:18.49,0:17:22.00,,NTP,0000,0000,0000,,Мен оны лақтырып жібергендіктен көмектесу мүмкін емес.
Dialogue: 0,0:17:23.44,0:17:27.52,,NTP,0000,0000,0000,,Жарайды, мен қазір дәретхана құмын сатып алайын!
Dialogue: 0,0:17:27.65,0:17:30.40,,NTP,0000,0000,0000,,Не? Дәл қазір?
Dialogue: 0,0:17:30.49,0:17:34.76,,NTP,0000,0000,0000,,Зәр дұрыс орындалды!
Dialogue: 0,0:17:37.98,0:17:40.61,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:17:40.77,0:17:43.87,,NTP,0000,0000,0000,,Мен сонша сүтке ризамын
Dialogue: 0,0:17:43.99,0:17:50.53,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:17:50.65,0:17:53.39,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:17:53.52,0:17:56.88,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:17:57.02,0:18:01.90,,NTP,0000,0000,0000,,Бақытты жату
Dialogue: 0,0:18:02.40,0:18:04.72,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:18:11.83,0:18:13.46,,NTP,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:18:13.58,0:18:14.38,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:18:14.91,0:18:17.24,,NTP,0000,0000,0000,,Мысықтың қоқысын қайдан табуға болады?
Dialogue: 0,0:18:17.42,0:18:23.30,,NTP,0000,0000,0000,,Ой, бұл мысық қоқысы ма? Бұл осылай. Бұл осылай.
Dialogue: 0,0:18:23.62,0:18:27.45,,NTP,0000,0000,0000,,Мұнда бізде қағаз құм, кипарис құмы, кендір құмы, минералды құм бар.
Dialogue: 0,0:18:28.11,0:18:29.59,,NTP,0000,0000,0000,,Жанғыш қоқыспен бірге лақтырылған құм
Dialogue: 0,0:18:29.77,0:18:30.74,,NTP,0000,0000,0000,,Дәретханаға ағызуға болатын құм
Dialogue: 0,0:18:30.89,0:18:32.05,,NTP,0000,0000,0000,,Зәрді анықтайтын құм
Dialogue: 0,0:18:32.23,0:18:33.19,,NTP,0000,0000,0000,,Тегіс құм
Dialogue: 0,0:18:33.33,0:18:34.25,,NTP,0000,0000,0000,,Иіссіз құм
Dialogue: 0,0:18:34.45,0:18:36.44,,NTP,0000,0000,0000,,Бактерияға қарсы қасиеті бар құм және т.б.
Dialogue: 0,0:18:36.60,0:18:38.90,,NTP,0000,0000,0000,,Бүгін қайсысын іздеп жүрсіз?
Dialogue: 0,0:18:39.11,0:18:42.01,,NTP,0000,0000,0000,,Түрлері өте көп
Dialogue: 0,0:18:42.17,0:18:43.84,,NTP,0000,0000,0000,,Әй, ә?
Dialogue: 0,0:18:43.98,0:18:44.80,,NTP,0000,0000,0000,,Иә~
Dialogue: 0,0:18:44.96,0:18:47.58,,NTP,0000,0000,0000,,Умм, қайсысын сатып алуым керек?
Dialogue: 0,0:18:47.84,0:18:52.21,,NTP,0000,0000,0000,,Бұл менің бірінші рет, сондықтан иә, мен абдырап қалдым.
Dialogue: 0,0:18:52.34,0:18:53.82,,NTP,0000,0000,0000,,Мен де солай жасадым
Dialogue: 0,0:18:53.95,0:18:56.85,,NTP,0000,0000,0000,,Алдымен оның қандай ортада сақталатынын айтыңызшы.
Dialogue: 0,0:18:57.00,0:18:58.09,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:19:00.24,0:19:02.76,,NTP,0000,0000,0000,,Дәретханаға ағызуға болатын құм?
Dialogue: 0,0:19:02.89,0:19:04.74,,NTP,0000,0000,0000,,Бұл оңай, өйткені сіз оны ағыза аласыз.
Dialogue: 0,0:19:04.90,0:19:07.77,,NTP,0000,0000,0000,,Қараңызшы, бұл пәтерге мысықтар мен иттер кірмейді.
Dialogue: 0,0:19:07.91,0:19:10.79,,NTP,0000,0000,0000,,А, мен түсіндім. Мысықтың қоқысын қоқысқа тастауға болмайды.
Dialogue: 0,0:19:10.95,0:19:11.31,,NTP,0000,0000,0000,,Ах~
Dialogue: 0,0:19:13.58,0:19:18.88,,NTP,0000,0000,0000,,Мысық~Мен жақсы нәрселер сатып алдым.
Dialogue: 0,0:19:20.88,0:19:26.70,,NTP,0000,0000,0000,,Мынау кереуетте ойнауға болады, жаншылған.
Dialogue: 0,0:19:32.70,0:19:38.15,,NTP,0000,0000,0000,,А, иә~
Dialogue: 0,0:19:39.26,0:19:42.83,,NTP,0000,0000,0000,,Ойнайық, ойнайық
Dialogue: 0,0:19:43.01,0:19:44.34,,NTP,0000,0000,0000,,Пи
Dialogue: 0,0:19:45.73,0:19:49.84,,NTP,0000,0000,0000,,Әй, тағы да осындай жерге сисасың
Dialogue: 0,0:19:50.03,0:19:51.55,,NTP,0000,0000,0000,,Бұл Чи, бұл Чи!
Dialogue: 0,0:19:51.71,0:19:53.93,,NTP,0000,0000,0000,,Чи дәретханада бар, солай ма?
Dialogue: 0,0:19:54.08,0:19:55.48,,NTP,0000,0000,0000,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:19:55.71,0:19:56.80,,NTP,0000,0000,0000,,Қайда бара жатырсың?
Dialogue: 0,0:19:56.97,0:19:58.84,,NTP,0000,0000,0000,,Мысықтарға арналған дәретхана
Dialogue: 0,0:19:59.92,0:20:06.50,,NTP,0000,0000,0000,,Ей, мына жерге сидиң.
Dialogue: 0,0:20:08.31,0:20:11.00,,NTP,0000,0000,0000,,Бұл сіз ойнауға болатын төсек болды.
Dialogue: 0,0:20:26.81,0:20:31.04,,NTP,0000,0000,0000,,Бұл сіз ойнауға болатын төсек болды.
Dialogue: 0,0:20:34.03,0:20:36.79,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:20:36.91,0:20:39.92,,NTP,0000,0000,0000,,Мен сонша сүтке ризамын
Dialogue: 0,0:20:40.11,0:20:46.53,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:20:46.65,0:20:49.38,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:20:49.46,0:20:52.98,,NTP,0000,0000,0000,,Дәмді тағаммен толтырылған
Dialogue: 0,0:20:53.07,0:20:57.96,,NTP,0000,0000,0000,,Бақытты жату
Dialogue: 0,0:20:58.48,0:21:00.58,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:21:02.80,0:21:07.81,,NTP,0000,0000,0000,,Неко-чан~Нянко~Анонимді Гонбей~
Dialogue: 0,0:21:07.96,0:21:09.99,,NTP,0000,0000,0000,,Ей, ат қояйық.
Dialogue: 0,0:21:10.11,0:21:12.85,,NTP,0000,0000,0000,,Жоқ, жоқ, мен оны сақтамаймын.
Dialogue: 0,0:21:12.96,0:21:15.24,,NTP,0000,0000,0000,,Табылды
Dialogue: 0,0:21:17.11,0:21:18.22,,NTP,0000,0000,0000,,Чи?
Dialogue: 0,0:21:18.40,0:21:22.00,,NTP,0000,0000,0000,,Не? Мен қазір бос емеспін
Dialogue: 0,0:21:22.45,0:21:27.10,,NTP,0000,0000,0000,,Анашым, менің мысығым дәретханада жылап жатыр.
Dialogue: 0,0:21:27.25,0:21:30.58,,NTP,0000,0000,0000,,Мен де тырысамын
Dialogue: 0,0:21:34.57,0:21:41.45,,NTP,0000,0000,0000,,Түсіндім, сіз дәретхана қорабында жасадыңыз, тамаша, тамаша.
Dialogue: 0,0:21:41.96,0:21:43.02,,NTP,0000,0000,0000,,Аа, дұрыс.
Dialogue: 0,0:21:45.41,0:21:48.16,,NTP,0000,0000,0000,,Ня~чи?
Dialogue: 0,0:21:49.56,0:21:50.99,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:21:51.32,0:21:53.46,,NTP,0000,0000,0000,,Сүт!
Dialogue: 0,0:21:54.18,0:21:56.83,,NTP,0000,0000,0000,,Ана, ана
Dialogue: 0,0:21:56.99,0:22:00.80,,NTP,0000,0000,0000,,Мен де дұрыстап үлгердім, ештеңе ағызған жоқпын.
Dialogue: 0,0:22:00.95,0:22:04.56,,NTP,0000,0000,0000,,О, тамаша, тамаша
Dialogue: 0,0:22:04.82,0:22:06.31,,NTP,0000,0000,0000,,Мен мұны істей алдым
Dialogue: 0,0:22:07.12,0:22:09.31,,NTP,0000,0000,0000,,Чи?
Dialogue: 0,0:22:11.40,0:22:14.85,,NTP,0000,0000,0000,,Әке, әке, менде хи да болған жоқ.
Dialogue: 0,0:22:15.01,0:22:16.65,,NTP,0000,0000,0000,,Дұрыс орындаған сияқтысың, Чи~
Dialogue: 0,0:22:17.21,0:22:19.70,,NTP,0000,0000,0000,,Жарайды, жарайды, бұл керемет, Йохеи.
Dialogue: 0,0:22:16.65,0:22:20.74,,NTP,0000,0000,0000,,Чи-Чи дегеніміз не?
Dialogue: 0,0:22:25.92,0:22:30.26,,NTP,0000,0000,0000,,Не? Сүйкімді котенка дүниеге келді.
Dialogue: 0,0:22:30.46,0:22:32.25,,NTP,0000,0000,0000,,Саған бере аламын ба?
Dialogue: 0,0:22:32.57,0:22:35.32,,NTP,0000,0000,0000,,Кейбір жағдайларға байланысты мен енді үй жануарымды ұстай алмаймын.
Dialogue: 0,0:22:35.50,0:22:40.08,,NTP,0000,0000,0000,,Бұл не! «Өтінемін, алыңыз» демейсіз бе?
Dialogue: 0,0:22:40.50,0:22:41.43,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:22:44.67,0:22:48.07,,NTP,0000,0000,0000,,Няёнда?
Dialogue: 0,0:23:01.67,0:23:03.00,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:23:03.19,0:23:05.69,,NTP,0000,0000,0000,,Сіз шақырдыңыз, солай ма?
Dialogue: 0,0:23:08.88,0:23:10.16,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:23:10.31,0:23:12.64,,NTP,0000,0000,0000,,Ал… біз Карт Титанмен біріктік ➡
Dialogue: 0,0:23:14.43,0:23:15.35,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:23:15.49,0:23:17.14,,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:23:17.97,0:23:21.86,,NTP,0000,0000,0000,,Қараңызшы, менің ойымша, сіз «Чи» сіздің атыңыз деп ойладыңыз.
Dialogue: 0,0:23:22.01,0:23:26.26,,NTP,0000,0000,0000,,Аты шешілді!
Dialogue: 0,0:23:30.01,0:23:32.78,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:23:32.96,0:23:35.90,,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:23:36.27,0:23:42.63,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:23:42.72,0:23:45.47,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:23:45.57,0:23:48.90,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:23:49.01,0:23:54.07,,NTP,0000,0000,0000,,Бақытты жату
Dialogue: 0,0:23:54.46,0:23:56.64,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:23:58.89,0:24:07.10,,NTP,0000,0000,0000,,Бон-бон-бон
Dialogue: 0,0:24:07.26,0:24:08.28,,NTP,0000,0000,0000,,Мияу!
Dialogue: 0,0:24:15.44,0:24:17.29,,NTP,0000,0000,0000,,Чи?
Dialogue: 0,0:24:26.57,0:24:28.81,,NTP,0000,0000,0000,,Қызықты
Dialogue: 0,0:24:29.02,0:24:30.47,,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:24:30.66,0:24:32.44,,NTP,0000,0000,0000,,Сіз бұрын шай төгіп жібердіңіз.
Dialogue: 0,0:24:32.58,0:24:34.01,,NTP,0000,0000,0000,,Осыны өзгертіңіз
Dialogue: 0,0:24:34.18,0:24:35.87,,NTP,0000,0000,0000,,Киініп алайық
Dialogue: 0,0:24:36.23,0:24:37.99,,NTP,0000,0000,0000,,Енді қараңдар!
Dialogue: 0,0:24:38.12,0:24:39.31,,NTP,0000,0000,0000,,Ах ха ха ха
Dialogue: 0,0:24:48.81,0:24:51.14,,NTP,0000,0000,0000,,Керемет
Dialogue: 0,0:24:56.09,0:25:02.34,,NTP,0000,0000,0000,,Бірақ бұл сәл баяу.
Dialogue: 0,0:25:02.53,0:25:05.96,,NTP,0000,0000,0000,,Сіз мысық асырап алғыңыз келе ме?
Dialogue: 0,0:25:06.15,0:25:11.30,,NTP,0000,0000,0000,,Мен оны таптым, бірақ мен оны осында сақтай алмаймын.
Dialogue: 0,0:25:11.51,0:25:15.01,,NTP,0000,0000,0000,,Сүт дәмді.
Dialogue: 0,0:25:15.94,0:25:19.54,,NTP,0000,0000,0000,,Мио~мио~мио~
Dialogue: 0,0:25:21.04,0:25:21.98,,NTP,0000,0000,0000,,О, өтінемін, мені өлтірме
Dialogue: 0,0:25:22.50,0:25:25.95,,NTP,0000,0000,0000,,Мен түсінемін.
Dialogue: 0,0:25:26.12,0:25:29.60,,NTP,0000,0000,0000,,Ах, ол қайтадан жұмыс істемеді.
Dialogue: 0,0:25:29.77,0:25:32.87,,NTP,0000,0000,0000,,Қайту, үйге қайт
Dialogue: 0,0:25:39.50,0:25:40.55,,NTP,0000,0000,0000,,Үй, үй,
Dialogue: 0,0:25:41.39,0:25:43.66,,NTP,0000,0000,0000,,Үй, үй, үй~
Dialogue: 0,0:25:43.80,0:25:49.72,,NTP,0000,0000,0000,,Үй, үй
Dialogue: 0,0:25:53.92,0:25:56.01,,NTP,0000,0000,0000,,Мияу~
Dialogue: 0,0:25:58.89,0:26:02.57,,NTP,0000,0000,0000,,Ах! Чи~
Dialogue: 0,0:26:05.44,0:26:08.16,,NTP,0000,0000,0000,,Мұндай жерде қауіпті.
Dialogue: 0,0:26:08.32,0:26:10.01,,NTP,0000,0000,0000,,А, мен құлап бара жатырмын.
Dialogue: 0,0:26:15.67,0:26:21.98,,NTP,0000,0000,0000,,Күрсін, мен мұндай нәрсенің сыртта өмір сүре алмайтынына сенімдімін.
Dialogue: 0,0:26:26.12,0:26:28.76,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:26:28.97,0:26:31.91,,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:26:32.07,0:26:38.66,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:26:38.79,0:26:41.44,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:26:41.54,0:26:45.03,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:26:45.11,0:26:49.90,,NTP,0000,0000,0000,,Жатып, бақытты болу
Dialogue: 0,0:26:50.59,0:26:52.97,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:26:54.83,0:26:59.03,,NTP,0000,0000,0000,,Сіз оны сақтағысы келетін біреуді білесіз бе?
Dialogue: 0,0:27:00.87,0:27:04.25,,NTP,0000,0000,0000,,Мама, мама
Dialogue: 0,0:27:04.43,0:27:18.68,,NTP,0000,0000,0000,,Мама~Мама~Ня~Ня~Мама
Dialogue: 0,0:27:19.00,0:27:21.45,,NTP,0000,0000,0000,,Мама, Ци қатты ұйықтап жатыр.
Dialogue: 0,0:27:21.55,0:27:22.93,,NTP,0000,0000,0000,,Енді—
Dialogue: 0,0:27:23.06,0:27:25.27,,NTP,0000,0000,0000,,Сәбилер көп ұйықтайды, солай ма?
Dialogue: 0,0:27:25.43,0:27:27.12,,NTP,0000,0000,0000,,Біреуін үйде ұстай алмаймын, бірақ
Dialogue: 0,0:27:27.24,0:27:30.93,,NTP,0000,0000,0000,,Сыр алатын жерді табу қиын.
Dialogue: 0,0:27:31.12,0:27:33.72,,NTP,0000,0000,0000,,Енді Йохэ, біз де ұйықтайық.
Dialogue: 0,0:27:33.87,0:27:35.04,,NTP,0000,0000,0000,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:27:35.17,0:27:36.61,,NTP,0000,0000,0000,,Иә, қайырлы түн.
Dialogue: 0,0:27:36.72,0:27:38.78,,NTP,0000,0000,0000,,Анашым, менімен ұйықтаңызшы.
Dialogue: 0,0:27:38.91,0:27:43.29,,NTP,0000,0000,0000,,Иә, иә, мен енді жалғыз бола алмаймын.
Dialogue: 0,0:27:49.09,0:27:53.99,,NTP,0000,0000,0000,,Иә? иә? Анашым, қайдасыз?
Dialogue: 0,0:27:55.40,0:27:59.77,,NTP,0000,0000,0000,,Мияу! !
Dialogue: 0,0:28:00.79,0:28:02.87,,NTP,0000,0000,0000,,Мен қорқамын, мама.
Dialogue: 0,0:28:03.44,0:28:05.24,,NTP,0000,0000,0000,,Мияу! !
Dialogue: 0,0:28:05.36,0:28:13.66,,NTP,0000,0000,0000,,Уф, уф, уф, уф. . . .
Dialogue: 0,0:28:13.97,0:28:17.75,,NTP,0000,0000,0000,,Мен қорқамын, мама.
Dialogue: 0,0:28:47.80,0:28:51.09,,NTP,0000,0000,0000,,Ци, сен өз күшіңмен өмір сүре аласың ба?
Dialogue: 0,0:28:51.24,0:28:53.95,,NTP,0000,0000,0000,,Маған беретін адамды таба алмаймын.
Dialogue: 0,0:28:54.08,0:28:56.74,,NTP,0000,0000,0000,,Пәтерде иттер мен мысықтарды ұстауға тыйым салынады.
Dialogue: 0,0:28:56.89,0:29:00.56,,NTP,0000,0000,0000,,Бірақ бұл әлі нәресте котенка.
Dialogue: 0,0:29:00.72,0:29:02.31,,NTP,0000,0000,0000,,Дұрыс~
Dialogue: 0,0:29:02.52,0:29:05.06,,NTP,0000,0000,0000,,Мен тіпті ат қойдым.
Dialogue: 0,0:29:05.21,0:29:08.49,,NTP,0000,0000,0000,,Мен оны лақтыруға шыдай алмаймын
Dialogue: 0,0:29:09.00,0:29:10.49,,NTP,0000,0000,0000,,Мен жақсы ұйықтадым.
Dialogue: 0,0:29:10.62,0:29:14.75,,NTP,0000,0000,0000,,Иә? Сізде қиындықтар бар ма?
Dialogue: 0,0:29:14.91,0:29:18.21,,NTP,0000,0000,0000,,Оны сақтаудан басқа амал жоқ па?
Dialogue: 0,0:29:22.11,0:29:24.89,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:29:25.01,0:29:27.98,,NTP,0000,0000,0000,,Мен сонша сүтке ризамын
Dialogue: 0,0:29:28.11,0:29:34.64,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:29:34.78,0:29:37.46,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:29:37.56,0:29:41.01,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:29:41.12,0:29:46.11,,NTP,0000,0000,0000,,Бақытты жату
Dialogue: 0,0:29:46.52,0:29:48.97,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:29:51.61,0:29:54.50,,NTP,0000,0000,0000,,Жем, олжа.
Dialogue: 0,0:29:54.65,0:29:57.53,,NTP,0000,0000,0000,,Дұрыс, бұл котенка.
Dialogue: 0,0:29:57.67,0:30:01.51,,NTP,0000,0000,0000,,Шынымен бе? Жоқ, қош келдіңіз.
Dialogue: 0,0:30:02.01,0:30:04.02,,NTP,0000,0000,0000,,Бұл әлі де жақсы емес пе?
Dialogue: 0,0:30:04.48,0:30:07.68,,NTP,0000,0000,0000,,Мен басқа қоңырау шалатын ештеңе таппаймын.
Dialogue: 0,0:30:09.54,0:30:13.65,,NTP,0000,0000,0000,,Мен қазір Чиді лақтырып жібере алмаймын.
Dialogue: 0,0:30:14.43,0:30:17.25,,NTP,0000,0000,0000,,Тоқта, мен сені ұстап аламын.
Dialogue: 0,0:30:17.36,0:30:21.16,,NTP,0000,0000,0000,,Бірақ бұл иттер мен мысықтарға тыйым салынған көпқабатты үй.
Dialogue: 0,0:30:21.29,0:30:24.63,,NTP,0000,0000,0000,,Бұл адам қайта қоңырау шалмады.
Dialogue: 0,0:30:24.73,0:30:29.27,,NTP,0000,0000,0000,,Мен Ямадамын, мен сізбен бір азаматтың лекциясында жұмыс істейтінмін.
Dialogue: 0,0:30:29.44,0:30:35.20,,NTP,0000,0000,0000,,Шындығында, бұл рас па?
Dialogue: 0,0:30:35.33,0:30:37.06,,NTP,0000,0000,0000,,Не? Не болды?
Dialogue: 0,0:30:37.19,0:30:39.43,,NTP,0000,0000,0000,,Иә, көріскенше!
Dialogue: 0,0:30:39.71,0:30:41.06,,NTP,0000,0000,0000,,Бұл шынымен рас па?
Dialogue: 0,0:30:41.18,0:30:45.20,,NTP,0000,0000,0000,,Мен мысық іздеп жүр едім, өйткені оны ұстағым келді.
Dialogue: 0,0:30:45.65,0:30:47.82,,NTP,0000,0000,0000,,Не? Бұл не?
Dialogue: 0,0:30:48.14,0:30:50.25,,NTP,0000,0000,0000,,Бірақ мен өзімді жалғыз сезінемін.
Dialogue: 0,0:30:50.36,0:30:52.61,,NTP,0000,0000,0000,,Ол қазір Циді көруге келетінін айтты.
Dialogue: 0,0:30:52.72,0:30:54.37,,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:30:56.48,0:30:59.77,,NTP,0000,0000,0000,,Сүйкімді
Dialogue: 0,0:30:59.88,0:31:01.72,,NTP,0000,0000,0000,,Кім шалбарын шылаған, сен, қанды шошқа!
Dialogue: 0,0:31:01.84,0:31:04.74,,NTP,0000,0000,0000,,Ол дәретхананы дұрыс пайдалана алатын жақсы бала.
Dialogue: 0,0:31:04.86,0:31:07.00,,NTP,0000,0000,0000,,Мен өз атымды білемін.
Dialogue: 0,0:31:07.15,0:31:08.09,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:31:08.20,0:31:09.93,,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:31:10.17,0:31:13.59,,NTP,0000,0000,0000,,Хаха, сіз біраз қобалжыған сияқтысыз.
Dialogue: 0,0:31:13.73,0:31:16.37,,NTP,0000,0000,0000,,Бейтаныс адам келгенде таң қалдым.
Dialogue: 0,0:31:16.62,0:31:17.66,,NTP,0000,0000,0000,,Мияу~
Dialogue: 0,0:31:21.68,0:31:24.20,,NTP,0000,0000,0000,,Мен таң қалдым.
Dialogue: 0,0:31:24.74,0:31:27.30,,NTP,0000,0000,0000,,Ол әдетте мейірімді бала.
Dialogue: 0,0:31:27.41,0:31:32.78,,NTP,0000,0000,0000,,Эй, Чи Чан өте сүйкімді, мен оның балам болғанын қалаймын.
Dialogue: 0,0:31:33.13,0:31:34.21,,NTP,0000,0000,0000,,Жақсы
Dialogue: 0,0:31:34.36,0:31:35.96,,NTP,0000,0000,0000,,Бұл маған жан тыныштығын береді.
Dialogue: 0,0:31:36.07,0:31:39.46,,NTP,0000,0000,0000,,А, мен алдымен күйеуіммен сөйлесуім керек.
Dialogue: 0,0:31:39.63,0:31:44.50,,NTP,0000,0000,0000,,Мысық ұстаймын деген адам иесі.
Dialogue: 0,0:31:44.82,0:31:46.95,,NTP,0000,0000,0000,,Жарайды, мен саған бүгін кешке қоңырау шаламын.
Dialogue: 0,0:31:47.06,0:31:48.29,,NTP,0000,0000,0000,,Иә,
Dialogue: 0,0:31:48.41,0:31:52.26,,NTP,0000,0000,0000,,Қайта кездескенше Чи-чан, Юхэйкун да.
Dialogue: 0,0:31:53.27,0:31:55.88,,NTP,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:31:59.50,0:32:04.65,,NTP,0000,0000,0000,,Эй, Чи, сен анау кемпірге барасың ба?
Dialogue: 0,0:32:04.78,0:32:05.91,,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:32:11.69,0:32:15.18,,NTP,0000,0000,0000,,Барлығына не болды?
Dialogue: 0,0:32:18.17,0:32:20.81,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:32:20.97,0:32:24.10,,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:32:24.24,0:32:30.70,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:32:30.82,0:32:33.54,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:32:33.65,0:32:37.07,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:32:37.18,0:32:41.99,,NTP,0000,0000,0000,,Бақытты жату
Dialogue: 0,0:32:42.57,0:32:44.66,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:32:47.42,0:32:50.48,,NTP,0000,0000,0000,,Йохеи, мен жалғызбын деп ойлаймын.
Dialogue: 0,0:32:50.65,0:32:52.66,,NTP,0000,0000,0000,,Иә, бұл түсінікті.
Dialogue: 0,0:32:52.79,0:32:55.69,,NTP,0000,0000,0000,,Мен Читпен ойнадым.
Dialogue: 0,0:32:56.86,0:33:00.62,,NTP,0000,0000,0000,,Ойнайық, эй, ойнайық~
Dialogue: 0,0:33:01.11,0:33:04.03,,NTP,0000,0000,0000,,Мен ойнамаймын
Dialogue: 0,0:33:06.70,0:33:12.13,,NTP,0000,0000,0000,,Ня~чи де жалғыз көрінеді.
Dialogue: 0,0:33:12.28,0:33:14.72,,NTP,0000,0000,0000,,Мен бірдеңе білемін бе деп ойлаймын.
Dialogue: 0,0:33:14.83,0:33:19.27,,NTP,0000,0000,0000,,Ойнайық, эй, ойнайық~
Dialogue: 0,0:33:19.41,0:33:23.03,,NTP,0000,0000,0000,,Чи, сен жоқ боласың.
Dialogue: 0,0:33:23.14,0:33:26.67,,NTP,0000,0000,0000,,Әй, жоқ, жоқ, кет, жоқ, жібер.
Dialogue: 0,0:33:28.27,0:33:31.23,,NTP,0000,0000,0000,,туындаған
Dialogue: 0,0:33:31.87,0:33:33.42,,NTP,0000,0000,0000,,Себепсіз
Dialogue: 0,0:33:33.68,0:33:37.32,,NTP,0000,0000,0000,,Чи, бірақ оған көмектесу мүмкін емес.
Dialogue: 0,0:33:37.42,0:33:39.82,,NTP,0000,0000,0000,,Мұнда иттер мен мысықтарды ұстауға тыйым салынады.
Dialogue: 0,0:33:39.98,0:33:43.86,,NTP,0000,0000,0000,,Чи оны алса, еркін өмір сүре алатын еді.
Dialogue: 0,0:33:44.01,0:33:47.80,,NTP,0000,0000,0000,,А, мен Чидің де осылай бақытты болатынына сенімдімін.
Dialogue: 0,0:33:47.95,0:33:51.55,,NTP,0000,0000,0000,,Не болды? Не? Не?
Dialogue: 0,0:33:51.69,0:33:54.44,,NTP,0000,0000,0000,,Ха~
Dialogue: 0,0:33:58.54,0:34:01.18,,NTP,0000,0000,0000,,Иә, бұл Ямада.
Dialogue: 0,0:34:01.53,0:34:04.84,,NTP,0000,0000,0000,,Иә. Жоқ, қош келдіңіз
Dialogue: 0,0:34:05.13,0:34:07.98,,NTP,0000,0000,0000,,Мм, бұл үшін кешіріңіз.
Dialogue: 0,0:34:08.11,0:34:08.99,,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:34:09.10,0:34:12.76,,NTP,0000,0000,0000,,Менің күйеуім бүгін жұмыстан котенка алды.
Dialogue: 0,0:34:12.88,0:34:13.70,,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:34:13.93,0:34:18.28,,NTP,0000,0000,0000,,Басқа адам менің бастығым, сондықтан мен бас тарта алмаймын.
Dialogue: 0,0:34:18.37,0:34:21.44,,NTP,0000,0000,0000,,Сонымен, Qi?
Dialogue: 0,0:34:21.76,0:34:23.49,,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:34:23.61,0:34:25.18,,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:34:25.26,0:34:27.56,,NTP,0000,0000,0000,,Чи-чан, мен оны енді ала алмаймын.
Dialogue: 0,0:34:27.69,0:34:31.01,,NTP,0000,0000,0000,,Бұл рас па? ол туралы уайымдама
Dialogue: 0,0:34:31.12,0:34:33.01,,NTP,0000,0000,0000,,Маңызды емес
Dialogue: 0,0:34:33.11,0:34:35.39,,NTP,0000,0000,0000,,Не? Бұл не?
Dialogue: 0,0:34:36.39,0:34:39.57,,NTP,0000,0000,0000,,Иә, қайырлы түн.
Dialogue: 0,0:34:39.69,0:34:40.70,,NTP,0000,0000,0000,,Әкем
Dialogue: 0,0:34:40.82,0:34:41.63,,NTP,0000,0000,0000,,Иә,
Dialogue: 0,0:34:41.79,0:34:44.09,,NTP,0000,0000,0000,,Үйде сақтайық
Dialogue: 0,0:34:44.26,0:34:48.50,,NTP,0000,0000,0000,,Эй, Чи ше? Сіз үйде отыра аласыз ба?
Dialogue: 0,0:34:48.60,0:34:49.61,,NTP,0000,0000,0000,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:34:49.71,0:34:52.40,,NTP,0000,0000,0000,,Ах, Чи менің балам болады.
Dialogue: 0,0:34:52.84,0:34:54.49,,NTP,0000,0000,0000,,Ха~!
Dialogue: 0,0:34:54.61,0:34:57.68,,NTP,0000,0000,0000,,Тағдырдың жазғанын сеземін.
Dialogue: 0,0:34:57.82,0:34:59.62,,NTP,0000,0000,0000,,Бұл шынымен жақсы идея емес, бірақ
Dialogue: 0,0:35:00.38,0:35:03.45,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:35:03.61,0:35:06.07,,NTP,0000,0000,0000,,Жоқ, жоқ!
Dialogue: 0,0:35:06.27,0:35:08.07,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:35:08.15,0:35:11.41,,NTP,0000,0000,0000,,Ойнайық
Dialogue: 0,0:35:14.22,0:35:16.98,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:35:17.10,0:35:20.15,,NTP,0000,0000,0000,,Мен сонша сүтке ризамын
Dialogue: 0,0:35:20.27,0:35:26.82,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:35:26.95,0:35:29.66,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:35:29.76,0:35:33.14,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:35:33.25,0:35:38.19,,NTP,0000,0000,0000,,Бақытты жату
Dialogue: 0,0:35:38.62,0:35:40.96,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:35:45.99,0:35:48.95,,NTP,0000,0000,0000,,Иә? Не?
Dialogue: 0,0:35:51.25,0:35:54.26,,NTP,0000,0000,0000,,Иә~О!
Dialogue: 0,0:35:55.94,0:35:57.12,,NTP,0000,0000,0000,,Йохай
Dialogue: 0,0:35:57.23,0:35:58.72,,NTP,0000,0000,0000,,Ха!
Dialogue: 0,0:35:58.85,0:36:00.14,,NTP,0000,0000,0000,,Йохай
Dialogue: 0,0:36:00.24,0:36:03.23,,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:36:03.74,0:36:07.91,,NTP,0000,0000,0000,,Мен оны шалбарымның қалтасында қалдырдым.
Dialogue: 0,0:36:08.03,0:36:09.77,,NTP,0000,0000,0000,,Дұрыс тазалаңыз.
Dialogue: 0,0:36:09.87,0:36:12.33,,NTP,0000,0000,0000,,Иә~
Dialogue: 0,0:36:13.07,0:36:17.16,,NTP,0000,0000,0000,,Мяу~Йохай, ойнайық~
Dialogue: 0,0:36:17.29,0:36:20.00,,NTP,0000,0000,0000,,Чи?
Dialogue: 0,0:36:20.17,0:36:21.92,,NTP,0000,0000,0000,,Мияу!
Dialogue: 0,0:36:39.26,0:36:41.26,,NTP,0000,0000,0000,,Қайда ол? Сол кілтке ұқсас зат қайда…
Dialogue: 0,0:36:40.65,0:36:44.82,,NTP,0000,0000,0000,,Мен кірдім.
Dialogue: 0,0:36:49.60,0:36:57.13,,NTP,0000,0000,0000,,Итадай ~ Нене ~ Итадай
Dialogue: 0,0:36:57.33,0:36:59.80,,NTP,0000,0000,0000,,Ау, ауырып тұр.
Dialogue: 0,0:37:02.09,0:37:05.07,,NTP,0000,0000,0000,,Түбіртек
Dialogue: 0,0:37:08.64,0:37:10.21,,NTP,0000,0000,0000,,Мияу~
Dialogue: 0,0:37:11.63,0:37:14.70,,NTP,0000,0000,0000,,Китата мырза
Dialogue: 0,0:37:18.48,0:37:27.68,,NTP,0000,0000,0000,,Ня~ күт, күт, күт, ня~
Dialogue: 0,0:37:28.20,0:37:30.25,,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:37:37.36,0:37:39.34,,NTP,0000,0000,0000,,Бұл үлкен мәселе болады.
Dialogue: 0,0:37:39.50,0:37:42.34,,NTP,0000,0000,0000,,Супербоулды тез тазалаңыз!
Dialogue: 0,0:37:42.51,0:37:44.31,,NTP,0000,0000,0000,,Иә~
Dialogue: 0,0:37:48.10,0:37:52.38,,NTP,0000,0000,0000,,Мияу~мияу
Dialogue: 0,0:37:54.38,0:37:57.36,,NTP,0000,0000,0000,,Сіз сондай тәртіпсіздік жасадыңыз
Dialogue: 0,0:37:57.51,0:38:01.07,,NTP,0000,0000,0000,,Супер доп Ци үшін қауіпті.
Dialogue: 0,0:38:01.20,0:38:03.57,,NTP,0000,0000,0000,,А, иә.
Dialogue: 0,0:38:03.67,0:38:07.30,,NTP,0000,0000,0000,,Қызықты, қызық
Dialogue: 0,0:38:10.20,0:38:12.97,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:38:13.13,0:38:16.13,,NTP,0000,0000,0000,,Мен сонша сүтке ризамын
Dialogue: 0,0:38:16.24,0:38:22.80,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:38:22.89,0:38:25.57,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:38:25.69,0:38:29.09,,NTP,0000,0000,0000,,Дәмді тағаммен толтырылған
Dialogue: 0,0:38:29.22,0:38:34.22,,NTP,0000,0000,0000,,Бақытты жатып
Dialogue: 0,0:38:34.69,0:38:37.00,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:38:38.85,0:38:42.24,,NTP,0000,0000,0000,,Гатанготон, Гатанготон
Dialogue: 0,0:38:42.36,0:38:47.48,,NTP,0000,0000,0000,,Келесі бекет менің үйімде, менің үйімде
Dialogue: 0,0:38:47.95,0:38:51.91,,NTP,0000,0000,0000,,Ол станция мен үшін жақсы.
Dialogue: 0,0:38:52.04,0:38:54.05,,NTP,0000,0000,0000,,Кеттік
Dialogue: 0,0:38:50.30,0:38:54.00,,NTP,0000,0000,0000,,Мияу, бұл не?
Dialogue: 0,0:38:55.22,0:38:58.29,,NTP,0000,0000,0000,,Біртүрлі, біртүрлі
Dialogue: 0,0:39:00.82,0:39:05.41,,NTP,0000,0000,0000,,Егін жинау айын алыңыз.
Dialogue: 0,0:39:00.82,0:39:05.41,,NTP,0000,0000,0000,,Түпнұсқа: Егін айын алайын деп жылап тұрған бала ма? Бұл Жапониядағы күздің ортасындағы әйгілі өлең.
Dialogue: 0,0:39:06.77,0:39:11.31,,NTP,0000,0000,0000,,Түсіндім, Йохеидің ойыншықтары көп.
Dialogue: 0,0:39:11.45,0:39:15.83,,NTP,0000,0000,0000,,Чиде ештеңе жоқ.
Dialogue: 0,0:39:14.87,0:39:20.67,,NTP,0000,0000,0000,,Не? Ол жоғалып кетті. Қайда қашып кеттің?
Dialogue: 0,0:39:20.80,0:39:22.43,,NTP,0000,0000,0000,,Мен біраз уақытқа шығамын.
Dialogue: 0,0:39:22.06,0:39:25.98,,NTP,0000,0000,0000,,Не? О, жұмыс кездесуі ме?
Dialogue: 0,0:39:26.07,0:39:28.21,,NTP,0000,0000,0000,,Иә, иә, кішкене шоппинг.
Dialogue: 0,0:39:28.35,0:39:31.34,,NTP,0000,0000,0000,,О, кеттік
Dialogue: 0,0:39:34.51,0:39:36.53,,NTP,0000,0000,0000,,Кешіріңіз, кешіріңіз.
Dialogue: 0,0:39:36.67,0:39:37.69,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:39:37.28,0:39:39.35,,NTP,0000,0000,0000,,Әй, өткен күндегі тұтынушы
Dialogue: 0,0:39:39.53,0:39:43.67,,NTP,0000,0000,0000,,Әй, мысық ойыншықтарын қайдан табуға болады?
Dialogue: 0,0:39:43.81,0:39:46.61,,NTP,0000,0000,0000,,Ой, бұл мысық ойыншығы ма?
Dialogue: 0,0:39:46.74,0:39:49.70,,NTP,0000,0000,0000,,Кел, мынау, мынау.
Dialogue: 0,0:39:49.82,0:39:52.88,,NTP,0000,0000,0000,,Котенкадан ересек мысықтарға дейін.
Dialogue: 0,0:39:53.07,0:39:55.39,,NTP,0000,0000,0000,,Бізде танымал ойыншықтардың үлкен таңдауы бар.
Dialogue: 0,0:39:55.51,0:39:58.15,,NTP,0000,0000,0000,,Бұрылыс кезінде секірген балық
Dialogue: 0,0:39:58.28,0:40:00.58,,NTP,0000,0000,0000,,Пури Пури Чуутароның қуанышында шек жоқ.
Dialogue: 0,0:40:00.74,0:40:03.56,,NTP,0000,0000,0000,,Карарин-чанмен допты ынтамен қуу
Dialogue: 0,0:40:03.72,0:40:05.85,,NTP,0000,0000,0000,,Марг таяқпен кептіріледі
Dialogue: 0,0:40:05.96,0:40:09.21,,NTP,0000,0000,0000,,Мысық шаққан жәндік Хайносукеге шапты
Dialogue: 0,0:40:09.33,0:40:10.86,,NTP,0000,0000,0000,,Басқа да көп
Dialogue: 0,0:40:10.96,0:40:13.15,,NTP,0000,0000,0000,,Сіз қайсысын іздейсіз?
Dialogue: 0,0:40:13.25,0:40:16.96,,NTP,0000,0000,0000,,Ал, мынау және мынау.
Dialogue: 0,0:40:18.62,0:40:22.54,,NTP,0000,0000,0000,,Қарашы, Чи, бұл ойыншық.
Dialogue: 0,0:40:23.25,0:40:26.62,,NTP,0000,0000,0000,,Мияу~мияу~мияу~
Dialogue: 0,0:40:27.22,0:40:30.47,,NTP,0000,0000,0000,,Бұл қызық, Чи, саған жақсы.
Dialogue: 0,0:40:30.61,0:40:32.02,,NTP,0000,0000,0000,,Мияу~мияу~мияу~
Dialogue: 0,0:40:32.14,0:40:34.81,,NTP,0000,0000,0000,,Китата мырза
Dialogue: 0,0:40:34.89,0:40:37.91,,NTP,0000,0000,0000,,Тұтынушы, тұтынушы
Dialogue: 0,0:40:37.97,0:40:39.49,,NTP,0000,0000,0000,,А, иә
Dialogue: 0,0:40:39.60,0:40:41.26,,NTP,0000,0000,0000,,Сіз қайсысын таңдар едіңіз?
Dialogue: 0,0:40:45.32,0:40:49.10,,NTP,0000,0000,0000,,Маған бәрін беріңізші.
Dialogue: 0,0:40:49.19,0:40:50.19,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:40:52.05,0:40:53.89,,NTP,0000,0000,0000,,Сізге көп рахмет
Dialogue: 0,0:40:54.05,0:40:57.73,,NTP,0000,0000,0000,,Хаха, иә
Dialogue: 0,0:40:58.13,0:41:01.87,,NTP,0000,0000,0000,,Чи, мен оны асыға күтемін.
Dialogue: 0,0:41:06.22,0:41:09.01,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:41:09.13,0:41:12.19,,NTP,0000,0000,0000,,Мен сонша сүтке ризамын
Dialogue: 0,0:41:12.30,0:41:18.88,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:41:19.00,0:41:21.71,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:41:21.80,0:41:25.20,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:41:25.31,0:41:30.64,,NTP,0000,0000,0000,,Бақытты жату
Dialogue: 0,0:41:30.77,0:41:33.14,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:41:36.03,0:41:38.92,,NTP,0000,0000,0000,,Чип… Чип, чип!
Dialogue: 0,0:41:41.07,0:41:44.24,,NTP,0000,0000,0000,,Қарашы, Чи, бұл қызық.
Dialogue: 0,0:41:44.40,0:41:46.83,,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:41:46.99,0:41:50.22,,NTP,0000,0000,0000,,Әй, эй, әке, бұл не?
Dialogue: 0,0:41:50.34,0:41:52.32,,NTP,0000,0000,0000,,Бұл мысықтарға арналған ойыншық.
Dialogue: 0,0:41:52.44,0:41:54.67,,NTP,0000,0000,0000,,Мысық онымен ойнауға қуанышты сияқты.
Dialogue: 0,0:41:54.82,0:41:56.28,,NTP,0000,0000,0000,,Сәлем~
Dialogue: 0,0:41:56.40,0:42:01.12,,NTP,0000,0000,0000,,Чи, менің қуанышымда шек жоқ.
Dialogue: 0,0:42:01.27,0:42:06.00,,NTP,0000,0000,0000,,Кәне, Чи, көңіліңе қарай ойнай аласың.
Dialogue: 0,0:42:12.36,0:42:13.57,,NTP,0000,0000,0000,,Мияу~
Dialogue: 0,0:42:17.17,0:42:18.31,,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:42:18.41,0:42:19.96,,NTP,0000,0000,0000,,Чи, мен ойнамаймын.
Dialogue: 0,0:42:20.08,0:42:23.50,,NTP,0000,0000,0000,,Жарайды, сен әлі түсінбеген шығарсың, сен котенкасың.
Dialogue: 0,0:42:23.66,0:42:26.91,,NTP,0000,0000,0000,,Егер мұны істесеңіз, көресіз
Dialogue: 0,0:42:27.09,0:42:28.22,,NTP,0000,0000,0000,,Мен мұны істедім
Dialogue: 0,0:42:28.37,0:42:31.35,,NTP,0000,0000,0000,,Мияу~
Dialogue: 0,0:42:31.62,0:42:33.16,,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:42:33.44,0:42:35.04,,NTP,0000,0000,0000,,Мен сені жалғыз қалдырмаймын
Dialogue: 0,0:42:35.16,0:42:44.69,,NTP,0000,0000,0000,,Бұл біртүрлі. Тыңда, Чи, сен осылай істейсің.
Dialogue: 0,0:42:44.80,0:42:46.89,,NTP,0000,0000,0000,,Жылжыту
Dialogue: 0,0:42:47.00,0:42:53.17,,NTP,0000,0000,0000,,Ах, Чи, сен осымен ойнайсың.
Dialogue: 0,0:42:53.31,0:42:57.56,,NTP,0000,0000,0000,,Келесі, Эйто, Эйто
Dialogue: 0,0:42:57.91,0:43:01.84,,NTP,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:43:01.95,0:43:03.16,,NTP,0000,0000,0000,,О.
Dialogue: 0,0:43:03.27,0:43:05.96,,NTP,0000,0000,0000,,Ал, бұл туралы не деуге болады?
Dialogue: 0,0:43:06.09,0:43:09.61,,NTP,0000,0000,0000,,Эй, мен сені шақырып жатырмын.
Dialogue: 0,0:43:09.72,0:43:14.11,,NTP,0000,0000,0000,,Мен мысыққа қанша ойыншық сатып алдым.
Dialogue: 0,0:43:14.25,0:43:22.47,,NTP,0000,0000,0000,,Қоңырау шалу, шақыру, шақыру, шақыру, шақыру
Dialogue: 0,0:43:22.59,0:43:25.22,,NTP,0000,0000,0000,,Хехе, мынандай нәрсе де бар.
Dialogue: 0,0:43:25.34,0:43:30.37,,NTP,0000,0000,0000,,Мен сізді келуге шақырамын.
Dialogue: 0,0:43:35.21,0:43:40.31,,NTP,0000,0000,0000,,Чиге көбірек ұнайтын сияқты.
Dialogue: 0,0:43:41.40,0:43:45.67,,NTP,0000,0000,0000,,Қызық, бұл қызық.
Dialogue: 0,0:43:45.83,0:43:48.99,,NTP,0000,0000,0000,,Сонымен бұл не?
Dialogue: 0,0:43:49.14,0:43:50.13,,NTP,0000,0000,0000,,Ахаха
Dialogue: 0,0:43:50.98,0:43:52.69,,NTP,0000,0000,0000,,Көңілді
Dialogue: 0,0:43:52.82,0:43:54.82,,NTP,0000,0000,0000,,Мияу мияу
Dialogue: 0,0:43:54.94,0:43:59.50,,NTP,0000,0000,0000,,Чи де бақытты, сондықтан жақсы.
Dialogue: 0,0:44:02.42,0:44:05.08,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:44:05.21,0:44:08.28,,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:44:08.40,0:44:14.91,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:44:15.03,0:44:17.73,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:44:17.84,0:44:21.19,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:44:21.28,0:44:26.39,,NTP,0000,0000,0000,,Бақытты жатып
Dialogue: 0,0:44:26.78,0:44:29.41,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:44:32.18,0:44:35.90,,NTP,0000,0000,0000,,Жоқ, соңғы мерзім ертең.
Dialogue: 0,0:44:36.05,0:44:38.90,,NTP,0000,0000,0000,,Аа, бұл енді жақсы емес.
Dialogue: 0,0:44:39.04,0:44:41.17,,NTP,0000,0000,0000,,Менің ойыма ештеңе келмейді
Dialogue: 0,0:44:41.33,0:44:43.64,,NTP,0000,0000,0000,,Әке, мені тағы қуып барасыз ба?
Dialogue: 0,0:44:43.77,0:44:47.12,,NTP,0000,0000,0000,,Иә? Иә, сіз жұмыстан бос емес сияқтысыз.
Dialogue: 0,0:44:47.23,0:44:50.25,,NTP,0000,0000,0000,,Эйто, график, график
Dialogue: 0,0:44:50.37,0:44:52.89,,NTP,0000,0000,0000,,Графикалық қалау
Dialogue: 0,0:44:53.04,0:44:56.51,,NTP,0000,0000,0000,,Мен бүгін суретті кітап оқимын, сондықтан тыныш болыңыз.
Dialogue: 0,0:44:56.63,0:44:57.91,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:44:58.01,0:44:59.26,,NTP,0000,0000,0000,,Иә. .
Dialogue: 0,0:44:59.38,0:45:00.98,,NTP,0000,0000,0000,,Ня
Dialogue: 0,0:45:01.08,0:45:06.08,,NTP,0000,0000,0000,,Әке, ойнайық, эй, эй.
Dialogue: 0,0:45:07.76,0:45:10.21,,NTP,0000,0000,0000,,Дәретханаға бару
Dialogue: 0,0:45:10.37,0:45:13.35,,NTP,0000,0000,0000,,Әке, бұл керемет.
Dialogue: 0,0:45:13.95,0:45:17.89,,NTP,0000,0000,0000,,Мысықтар қарапайым болуы керек.
Dialogue: 0,0:45:18.03,0:45:20.51,,NTP,0000,0000,0000,,Ойнағыңыз келмей ме?
Dialogue: 0,0:45:20.59,0:45:28.83,,NTP,0000,0000,0000,,Иә? Онда не бар?
Dialogue: 0,0:45:29.83,0:45:35.38,,NTP,0000,0000,0000,,+6 ~ толық
Dialogue: 0,0:45:38.88,0:45:42.98,,NTP,0000,0000,0000,,Қызықты
Dialogue: 0,0:45:46.27,0:45:48.50,,NTP,0000,0000,0000,,плюс отбасылық әулеттік қорқыныш, деп ойлаймын
Dialogue: 0,0:45:48.62,0:45:52.45,,NTP,0000,0000,0000,,Ойнайтын нәрселер көп
Dialogue: 0,0:46:01.22,0:46:04.92,,NTP,0000,0000,0000,,Эй, эй, Чи, жоқ.
Dialogue: 0,0:46:05.05,0:46:10.64,,NTP,0000,0000,0000,,Жоқ! Көбірек ойнайық, көп ойнайық
Dialogue: 0,0:46:08.10,0:46:10.69,,NTP,0000,0000,0000,,Аа, өте көп
Dialogue: 0,0:46:10.81,0:46:15.99,,NTP,0000,0000,0000,,Мен Qi-ге сатып алған ойыншық ойнауға пайдаланылмайды, ол неге біреудің жұмыс құралы ретінде пайдаланылады? . .
Dialogue: 0,0:46:16.12,0:46:18.89,,NTP,0000,0000,0000,,Иә? бұл. . .
Dialogue: 0,0:46:19.02,0:46:22.05,,NTP,0000,0000,0000,,Иә! Егер сіз аспанды пайдалансаңыз
Dialogue: 0,0:46:22.19,0:46:25.66,,NTP,0000,0000,0000,,Сіз бара аласыз! Бұл идея қалыптасады
Dialogue: 0,0:46:25.80,0:46:28.46,,NTP,0000,0000,0000,,Әрі бақытты өмір сүрді
Dialogue: 0,0:46:27.74,0:46:28.98,,NTP,0000,0000,0000,,тамаша, тамаша
Dialogue: 0,0:46:28.80,0:46:30.49,,NTP,0000,0000,0000,,Бақытты, бақытты
Dialogue: 0,0:46:30.80,0:46:32.20,,NTP,0000,0000,0000,,Иә, мен мұны істеймін.
Dialogue: 0,0:46:32.31,0:46:34.80,,NTP,0000,0000,0000,,Әке, сен Чимен ойнайсың ба?
Dialogue: 0,0:46:34.90,0:46:36.79,,NTP,0000,0000,0000,,Сол уақыттан бері жағдай өзгерді ғой, иә?
Dialogue: 0,0:46:39.22,0:46:43.15,,NTP,0000,0000,0000,,Әкемнің бөлмесі ойнайтын заттарға толы.
Dialogue: 0,0:46:43.28,0:46:45.85,,NTP,0000,0000,0000,,Жарайды, барымызды салайық, Чи.
Dialogue: 0,0:46:45.96,0:46:48.64,,NTP,0000,0000,0000,,Мияу~
Dialogue: 0,0:46:49.77,0:46:55.22,,NTP,0000,0000,0000,,Ой, қызық сияқты.
Dialogue: 0,0:46:56.72,0:47:02.72,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory