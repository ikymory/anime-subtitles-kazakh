Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:39.01,0:00:41.10,,,0,0,0,,Бұл жақсы төсек
Dialogue: 0,0:00:41.10,0:00:42.52,,,0,0,0,,Қош бол
Dialogue: 0,0:00:42.52,0:00:44.31,,,0,0,0,,Үйге бару
Dialogue: 0,0:00:57.00,0:01:00.37,,,0,0,0,,- Жібер - Иә, иә
Dialogue: 0,0:01:05.04,0:01:07.95,,,0,0,0,,Иә, мен оны сен үшін тазалаймын.
Dialogue: 0,0:01:08.79,0:01:10.22,,,0,0,0,,Барайық
Dialogue: 0,0:01:16.20,0:01:19.34,,,0,0,0,,Оны алыңыз
Dialogue: 0,0:01:20.56,0:01:23.56,,,0,0,0,,Қашпа
Dialogue: 0,0:01:33.37,0:01:35.58,,,0,0,0,,Біраз
Dialogue: 0,0:01:35.58,0:01:36.84,,,0,0,0,,Ей, тыныш отыр.
Dialogue: 0,0:01:36.84,0:01:38.08,,,0,0,0,,Не болды?
Dialogue: 0,0:01:38.49,0:01:39.79,,,0,0,0,,Сендердің міндетің не, көпшілік?
Dialogue: 0,0:01:40.69,0:01:42.80,,,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,0:01:44.41,0:01:45.84,,,0,0,0,,Келіңіздер.
Dialogue: 0,0:01:48.64,0:01:51.77,,,0,0,0,,Жоқ, олар шын мәнінде тамақтанбай-ақ қоятындай деңгейге дейін дамыды, бірақ…
Dialogue: 0,0:01:51.77,0:01:54.67,,,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,0:02:02.14,0:02:05.00,,,0,0,0,,Менде жағымсыз оқиға болды
Dialogue: 0,0:02:06.23,0:02:07.84,,,0,0,0,,Жарайды, келесі.
Dialogue: 0,0:02:17.55,0:02:20.40,,,0,0,0,,Мысықты жуу қиын емес пе?
Dialogue: 0,0:02:20.40,0:02:23.61,,,0,0,0,,Ванна да, фен де жақсы сезінеді.
Dialogue: 0,0:02:26.01,0:02:28.42,,,0,0,0,,Мен өлемін деп ойладым
Dialogue: 0,0:02:31.96,0:02:35.11,,,0,0,0,,Мен өлмегеніме қуаныштымын
Dialogue: 0,0:02:37.20,0:02:38.97,,,0,0,0,,Қазір таза.
Dialogue: 0,0:02:38.97,0:02:40.47,,,0,0,0,,Бұл рас
Dialogue: 0,0:02:40.47,0:02:41.63,,,0,0,0,,Қараңдар, қараңдар!
Dialogue: 0,0:02:41.63,0:02:43.79,,,0,0,0,,Менің арқам да кішкентай
Dialogue: 0,0:02:43.79,0:02:47.23,,,0,0,0,,- Бұл рас - мен қуаныштымын.
Dialogue: 0,0:02:47.90,0:02:49.25,,,0,0,0,,Әдемі әдемі
Dialogue: 0,0:02:49.25,0:02:50.90,,,0,0,0,,Ол жылтыр.
Dialogue: 0,0:02:50.90,0:02:52.48,,,0,0,0,,Мұндайды қалай байқадың, Рюзаки?
Dialogue: 0,0:02:52.48,0:02:54.78,,,0,0,0,,Үлпілдек
Dialogue: 0,0:02:56.28,0:03:02.28,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory