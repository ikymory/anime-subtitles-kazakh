Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:30.34,0:00:38.87,,NTP,0000,0000,0000,,Бұл субтитр көзі коммерциялық пайдалануға тыйым салынған субтитрлер тобының өндірісі, жеткізу алмасуы болып табылады.
Dialogue: 0,0:00:30.34,0:00:38.87,,NTP,0000,0000,0000,,``Жапон тіліндегі аударма: xHunter'' ``Жапон тіліндегі аударма: Гүлдер кітабы'' ``Мектеп кітабы: Цзин Ли'' ``Уақыт кітабы: Zaide life'' ``Кай жүйесі: Шағын сома''
Dialogue: 0,0:00:01.91,0:00:04.66,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:00:04.71,0:00:07.76,,NTP,0000,0000,0000,,Мен сонша сүтке ризамын
Dialogue: 0,0:00:07.83,0:00:14.53,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:00:14.59,0:00:17.35,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:00:17.39,0:00:20.88,,NTP,0000,0000,0000,,Дәмді тағаммен толтырылған
Dialogue: 0,0:00:20.95,0:00:26.30,,NTP,0000,0000,0000,,Бақытты жату
Dialogue: 0,0:00:26.38,0:00:28.76,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:00:39.00,0:00:40.33,,NTP,0000,0000,0000,,Ол адамзат үшін баға жетпес мүмкіндік
Dialogue: 0,0:00:41.17,0:00:44.59,,NTP,0000,0000,0000,,Чи, мен серуендеуге барамын деп ойладым.
Dialogue: 0,0:00:44.74,0:00:47.42,,NTP,0000,0000,0000,,Есікке жабысып қалсаң да, ол ашылмайды.
Dialogue: 0,0:00:47.47,0:00:51.83,,NTP,0000,0000,0000,,Не біреуге қоңырау шалыңыз, не өзіңіз ашыңыз.
Dialogue: 0,0:00:52.92,0:00:54.43,,NTP,0000,0000,0000,,Жарайды, енді іске кірісейік.
Dialogue: 0,0:00:55.23,0:00:57.85,,NTP,0000,0000,0000,,Уақыт өте келе сенің де қолыңнан келеді.
Dialogue: 0,0:00:58.30,0:00:59.31,,NTP,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:01:03.74,0:01:06.95,,NTP,0000,0000,0000,,Жаңа ғана аяқтадым.
Dialogue: 0,0:01:08.72,0:01:09.66,,NTP,0000,0000,0000,,Сонда кездескенше
Dialogue: 0,0:01:11.64,0:01:15.36,,NTP,0000,0000,0000,,Біз тағы кездесіп, үйренеміз. Чи де барады.
Dialogue: 0,0:01:18.90,0:01:20.78,,NTP,0000,0000,0000,,О, сыртта
Dialogue: 0,0:01:23.92,0:01:25.70,,NTP,0000,0000,0000,,Сонымен, сетте алты ойынды бірінші жеңген адам жеңеді, иә?
Dialogue: 0,0:01:31.32,0:01:32.96,,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:01:37.08,0:01:43.65,,NTP,0000,0000,0000,,Әй, піспе шыдамайды, анаң саған ашуланады.
Dialogue: 0,0:01:44.45,0:01:47.46,,NTP,0000,0000,0000,,Бұл жер менікі деген белгі.
Dialogue: 0,0:01:53.27,0:01:55.95,,NTP,0000,0000,0000,,Мұнда Чиге жатады
Dialogue: 0,0:02:10.38,0:02:13.74,,NTP,0000,0000,0000,,Біреуін жасаудың қажеті жоқ, себебі бұл сіздің территорияңыз.
Dialogue: 0,0:02:17.89,0:02:19.23,,NTP,0000,0000,0000,,Неге Цуки камералар мен тыңшылық құрылғыларға сонша әуес?
Dialogue: 0,0:02:21.98,0:02:23.17,,NTP,0000,0000,0000,,Жеміс
Dialogue: 0,0:02:24.32,0:02:25.86,,NTP,0000,0000,0000,,Аузыңды жап, қарап тұр.
Dialogue: 0,0:02:38.73,0:02:40.73,,NTP,0000,0000,0000,,Тамаша, салқын таң, иә?
Dialogue: 0,0:02:57.98,0:03:00.64,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:03:00.72,0:03:03.82,,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:03:03.86,0:03:10.55,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:03:10.68,0:03:13.35,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:03:13.43,0:03:16.91,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:03:17.00,0:03:22.38,,NTP,0000,0000,0000,,Жатып бақытты болу
Dialogue: 0,0:03:22.48,0:03:24.83,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:03:27.98,0:03:31.68,,NTP,0000,0000,0000,,Чи, бұл тамақ, Чи.
Dialogue: 0,0:03:35.50,0:03:40.14,,NTP,0000,0000,0000,,Бұл экранның есігі ашық.
Dialogue: 0,0:03:41.20,0:03:44.59,,NTP,0000,0000,0000,,Жаяу жүру де қызық.
Dialogue: 0,0:03:45.44,0:03:47.28,,NTP,0000,0000,0000,,Ол әлі де сізбен бірге келе ме?
Dialogue: 0,0:03:47.33,0:03:49.15,,NTP,0000,0000,0000,,Мен сізге еремін.
Dialogue: 0,0:03:52.18,0:03:53.61,,NTP,0000,0000,0000,,Жеміс
Dialogue: 0,0:03:56.04,0:03:57.68,,NTP,0000,0000,0000,,Жеміс
Dialogue: 0,0:04:03.20,0:04:05.79,,NTP,0000,0000,0000,,Сіз қатысуды жоюыңыз керек
Dialogue: 0,0:04:05.85,0:04:07.41,,NTP,0000,0000,0000,,Белгілер
Dialogue: 0,0:04:33.82,0:04:34.84,,NTP,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:04:36.61,0:04:38.15,,NTP,0000,0000,0000,,Жеміс
Dialogue: 0,0:04:40.61,0:04:42.26,,NTP,0000,0000,0000,,Сіз қашып кеттіңіз бе?
Dialogue: 0,0:04:42.99,0:04:44.61,,NTP,0000,0000,0000,,Менің олжам бар.
Dialogue: 0,0:04:44.70,0:04:46.39,,NTP,0000,0000,0000,,Кәдесый ретінде жақсы емес
Dialogue: 0,0:04:46.41,0:04:47.95,,NTP,0000,0000,0000,,Сувенирлер
Dialogue: 0,0:04:48.43,0:04:51.20,,NTP,0000,0000,0000,,Бұл үйге апару керек.
Dialogue: 0,0:04:53.12,0:04:54.35,,NTP,0000,0000,0000,,Тамаша, салқын таң, иә?
Dialogue: 0,0:04:54.38,0:04:57.48,,NTP,0000,0000,0000,,Чи әкесіне де кәдесый береді.
Dialogue: 0,0:04:59.88,0:05:01.10,,NTP,0000,0000,0000,,Жыртқыш
Dialogue: 0,0:05:25.10,0:05:28.99,,NTP,0000,0000,0000,,Күтіңіз, күтіңіз, күтіңіз!
Dialogue: 0,0:05:29.09,0:05:31.33,,NTP,0000,0000,0000,,Цидің олжасы
Dialogue: 0,0:05:44.97,0:05:48.25,,NTP,0000,0000,0000,,Кәдесый алу
Dialogue: 0,0:05:53.99,0:05:56.74,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:05:56.82,0:05:59.90,,NTP,0000,0000,0000,,Мен сонша сүтке ризамын
Dialogue: 0,0:05:59.98,0:06:06.61,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:06:06.63,0:06:09.39,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:06:09.43,0:06:12.95,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:06:13.00,0:06:18.52,,NTP,0000,0000,0000,,Бақытты жату
Dialogue: 0,0:06:18.61,0:06:20.97,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:06:37.41,0:06:40.07,,NTP,0000,0000,0000,,Әй, күт, күт.
Dialogue: 0,0:06:40.14,0:06:43.39,,NTP,0000,0000,0000,,Чидің олжасын күту
Dialogue: 0,0:07:01.76,0:07:04.53,,NTP,0000,0000,0000,,Біздің кім екенімізді қайдан білесің?
Dialogue: 0,0:07:18.91,0:07:23.12,,NTP,0000,0000,0000,,Мен сені міндетті түрде ұстаймын
Dialogue: 0,0:07:24.98,0:07:29.53,,NTP,0000,0000,0000,,Тыңдаңыз, қатысуды жоғалтыңыз.
Dialogue: 0,0:07:29.57,0:07:32.46,,NTP,0000,0000,0000,,Ағаштың көлеңкесіне тығылатын шығар.
Dialogue: 0,0:07:43.06,0:07:44.28,,NTP,0000,0000,0000,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:08:07.70,0:08:09.14,,NTP,0000,0000,0000,,Мен мүлде не болып жатқанын түсінбеймін.
Dialogue: 0,0:08:09.35,0:08:12.75,,NTP,0000,0000,0000,,Абсолютті Qi жеңеді
Dialogue: 0,0:08:32.95,0:08:35.60,,NTP,0000,0000,0000,,Qi жоғалтады.
Dialogue: 0,0:08:37.50,0:08:40.13,,NTP,0000,0000,0000,,Міне, солай.
Dialogue: 0,0:08:40.23,0:08:41.70,,NTP,0000,0000,0000,,Жүр, үйге қайтайық.
Dialogue: 0,0:08:43.05,0:08:46.62,,NTP,0000,0000,0000,,Мен бұл жолы ешқашан жеңілмеймін
Dialogue: 0,0:08:50.01,0:08:52.77,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:08:52.87,0:08:55.90,,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:08:55.95,0:09:02.63,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:09:02.70,0:09:05.45,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:09:05.50,0:09:08.97,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:09:09.05,0:09:14.50,,NTP,0000,0000,0000,,Жатып бақытты болу
Dialogue: 0,0:09:14.61,0:09:16.86,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:09:18.56,0:09:21.11,,NTP,0000,0000,0000,,Qi, ол қайда?
Dialogue: 0,0:09:21.81,0:09:24.52,,NTP,0000,0000,0000,,Сыр сыры
Dialogue: 0,0:09:25.20,0:09:28.81,,NTP,0000,0000,0000,,Чи Чи, сен қайда бардың?
Dialogue: 0,0:09:28.99,0:09:34.09,,NTP,0000,0000,0000,,мүмкін сыртта
Dialogue: 0,0:09:34.95,0:09:37.91,,NTP,0000,0000,0000,,Мен кәдесый ала алмадым.
Dialogue: 0,0:09:38.14,0:09:40.48,,NTP,0000,0000,0000,,Келесі жолы тағы біреуі бар.
Dialogue: 0,0:09:44.32,0:09:45.16,,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:09:51.85,0:09:54.77,,NTP,0000,0000,0000,,Менің территориямда
Dialogue: 0,0:09:59.54,0:10:01.39,,NTP,0000,0000,0000,,аумаққа кірмеу
Dialogue: 0,0:10:08.52,0:10:09.99,,NTP,0000,0000,0000,,Мүлдем
Dialogue: 0,0:10:16.39,0:10:18.02,,NTP,0000,0000,0000,,Менің көлігім
Dialogue: 0,0:10:18.13,0:10:18.89,,NTP,0000,0000,0000,,Құдай-ай, оны тауып алуға тура келеді
Dialogue: 0,0:10:20.57,0:10:22.99,,NTP,0000,0000,0000,,Тұр, е!
Dialogue: 0,0:10:23.41,0:10:26.09,,NTP,0000,0000,0000,,Чи, сен қайда бардың?
Dialogue: 0,0:10:26.54,0:10:28.40,,NTP,0000,0000,0000,,Аа.
Dialogue: 0,0:10:28.46,0:10:31.21,,NTP,0000,0000,0000,,Қызық, адасып қалдым ба?
Dialogue: 0,0:10:31.35,0:10:34.00,,NTP,0000,0000,0000,,Көліктер сыртта қауіпті.
Dialogue: 0,0:10:34.38,0:10:36.50,,NTP,0000,0000,0000,,Қорқынышты ит және т.б.
Dialogue: 0,0:10:39.35,0:10:40.33,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:10:40.46,0:10:42.71,,NTP,0000,0000,0000,,Әке, мен үйдемін.
Dialogue: 0,0:10:42.78,0:10:46.05,,NTP,0000,0000,0000,,Сіз қайда болдыңыз? Мен уайымдадым.
Dialogue: 0,0:10:46.23,0:10:50.44,,NTP,0000,0000,0000,,Әу қоңыр аю мысық
Dialogue: 0,0:10:50.65,0:10:52.13,,NTP,0000,0000,0000,,Ол қайтадан пайда болды ма?
Dialogue: 0,0:10:52.66,0:10:54.32,,NTP,0000,0000,0000,,Мен мұнда қашып кеттім.
Dialogue: 0,0:10:54.41,0:10:55.83,,NTP,0000,0000,0000,,Бұл қара мысық
Dialogue: 0,0:10:56.41,0:11:00.47,,NTP,0000,0000,0000,,Олармен бірге тағы бір кішкентай мысық болды.
Dialogue: 0,0:11:01.59,0:11:04.01,,NTP,0000,0000,0000,,Қызық, сен тағы да осында боласың ба?
Dialogue: 0,0:11:04.68,0:11:07.03,,NTP,0000,0000,0000,,Екеуі қашып кетті.
Dialogue: 0,0:11:07.16,0:11:08.77,,NTP,0000,0000,0000,,Міндетті түрде табыңыз
Dialogue: 0,0:11:08.86,0:11:11.79,,NTP,0000,0000,0000,,Иә, мен оны міндетті түрде табамын.
Dialogue: 0,0:11:12.19,0:11:14.45,,NTP,0000,0000,0000,,Сіз не істедіңіз?
Dialogue: 0,0:11:14.48,0:11:17.44,,NTP,0000,0000,0000,,Мен көлігіме зәр шығардым.
Dialogue: 0,0:11:17.50,0:11:23.06,,NTP,0000,0000,0000,,Маа, қазір ойлап қарасам, осы уақыт ішінде басқа үйлер де зақымдалған сияқты.
Dialogue: 0,0:11:23.35,0:11:25.62,,NTP,0000,0000,0000,,Күрішті пісіргеннен кейін
Dialogue: 0,0:11:28.27,0:11:29.87,,NTP,0000,0000,0000,,Өте шиеленісті, иә?
Dialogue: 0,0:11:31.68,0:11:32.81,,NTP,0000,0000,0000,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:11:33.93,0:11:35.79,,NTP,0000,0000,0000,,Кәдесыйлар әлі алда
Dialogue: 0,0:11:39.14,0:11:41.23,,NTP,0000,0000,0000,,Жақында кездескенше
Dialogue: 0,0:11:45.99,0:11:48.82,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:11:48.89,0:11:52.00,,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:11:52.06,0:11:58.64,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:11:58.68,0:12:01.42,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:12:01.50,0:12:05.00,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:12:05.06,0:12:10.50,,NTP,0000,0000,0000,,Жатып, бақытты болу
Dialogue: 0,0:12:10.59,0:12:12.93,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:12:15.84,0:12:18.01,,NTP,0000,0000,0000,,Иә, постер.
Dialogue: 0,0:12:18.18,0:12:24.29,,NTP,0000,0000,0000,,Иә, алдыңғы менеджер мысық көрсеңіз бізге хабарлаңыз деді.
Dialogue: 0,0:12:24.84,0:12:27.62,,NTP,0000,0000,0000,,Мен қиындыққа тап болдым.
Dialogue: 0,0:12:28.28,0:12:32.29,,NTP,0000,0000,0000,,Қалай болғанда да, Чи табылмас үшін бұрынғыдан да сақ болуым керек.
Dialogue: 0,0:12:32.34,0:12:36.90,,NTP,0000,0000,0000,,Иә, абайсызда сыртқа шығарып жіберіп, ұсталып қалсам, үлкен мәселе болар еді.
Dialogue: 0,0:12:37.02,0:12:38.11,,NTP,0000,0000,0000,,Бұл жерде тақды шарлатанға тапсыратын орын да емес қой, иә?
Dialogue: 0,0:12:38.45,0:12:39.88,,NTP,0000,0000,0000,,Жаяу жүру
Dialogue: 0,0:12:42.84,0:12:47.83,,NTP,0000,0000,0000,,Кіреберіске кіргенде немесе шыққанда есіктен секірмеңіз.
Dialogue: 0,0:12:48.24,0:12:52.65,,NTP,0000,0000,0000,,Сондай-ақ, терезелер, оларды ашық қалдырмаңыз.
Dialogue: 0,0:12:53.50,0:12:54.51,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:12:54.63,0:12:56.53,,NTP,0000,0000,0000,,А, күте тұрыңыз.
Dialogue: 0,0:12:59.31,0:13:01.56,,NTP,0000,0000,0000,,Мені ұстап алшы Йохеи.
Dialogue: 0,0:13:05.86,0:13:08.39,,NTP,0000,0000,0000,,Сен сияқты біреуге уақытымды босқа жұмсауға уақытым жоқ.
Dialogue: 0,0:13:09.60,0:13:11.64,,NTP,0000,0000,0000,,Маған сенетініне сенімді емеспін.
Dialogue: 0,0:13:12.20,0:13:15.91,,NTP,0000,0000,0000,,Мен сөйлескен жерден экранның есігі ашық қалды.
Dialogue: 0,0:13:16.01,0:13:18.98,,NTP,0000,0000,0000,,Чи, кеттік ойнайық.
Dialogue: 0,0:13:19.11,0:13:21.26,,NTP,0000,0000,0000,,Қашан жабуды ұмытып қалдым деп ойлаймын.
Dialogue: 0,0:13:21.33,0:13:25.59,,NTP,0000,0000,0000,,Мен кірді кептіргеннен кейін есікті жаптым деп ойлаймын.
Dialogue: 0,0:13:25.63,0:13:27.61,,NTP,0000,0000,0000,,Мен де жаптым.
Dialogue: 0,0:13:28.49,0:13:29.80,,NTP,0000,0000,0000,,Бұл біртүрлі.
Dialogue: 0,0:13:30.71,0:13:33.08,,NTP,0000,0000,0000,,Қызық, қашан ашылды?
Dialogue: 0,0:13:45.33,0:13:46.07,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:13:46.42,0:13:48.72,,NTP,0000,0000,0000,,Ци оны өзі ашты.
Dialogue: 0,0:13:48.95,0:13:51.50,,NTP,0000,0000,0000,,Жоқ, Чи өте шебер.
Dialogue: 0,0:13:51.55,0:13:52.51,,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:13:53.03,0:13:55.70,,NTP,0000,0000,0000,,Чи, қайта шыққың келе ме?
Dialogue: 0,0:13:57.60,0:13:58.75,,NTP,0000,0000,0000,,Қ-Қандай?
Dialogue: 0,0:14:00.40,0:14:03.59,,NTP,0000,0000,0000,,Мен үйге бара жатырмын.
Dialogue: 0,0:14:06.19,0:14:09.89,,NTP,0000,0000,0000,,Мен Чи экранның есігін өзі ашады деп ойламадым.
Dialogue: 0,0:14:10.00,0:14:15.38,,NTP,0000,0000,0000,,Сіз шыны есікті аша алмайтын шығарсыз, бірақ оны үнемі жабық ұстасаңыз, ауа кірмейді.
Dialogue: 0,0:14:22.22,0:14:25.22,,NTP,0000,0000,0000,,Qi, сіз жай ғана көріне алмайсыз.
Dialogue: 0,0:14:25.25,0:14:27.15,,NTP,0000,0000,0000,,Бұл маған жан тыныштығын береді
Dialogue: 0,0:14:28.67,0:14:29.77,,NTP,0000,0000,0000,,Кана
Dialogue: 0,0:14:33.77,0:14:38.39,,NTP,0000,0000,0000,,Неліктен ашылмайды?
Dialogue: 0,0:14:42.11,0:14:44.84,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:14:44.97,0:14:47.97,,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:14:48.06,0:14:54.73,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:14:54.79,0:14:57.48,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:14:57.53,0:15:01.01,,NTP,0000,0000,0000,,Дәмді тағаммен толтырылған
Dialogue: 0,0:15:01.08,0:15:06.57,,NTP,0000,0000,0000,,Жатып, бақытты болу
Dialogue: 0,0:15:06.64,0:15:08.89,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:15:19.71,0:15:21.60,,NTP,0000,0000,0000,,Көңілді сияқты
Dialogue: 0,0:15:22.21,0:15:24.35,,NTP,0000,0000,0000,,Мен әкімшімін
Dialogue: 0,0:15:27.92,0:15:29.21,,NTP,0000,0000,0000,,Ямада мырза
Dialogue: 0,0:15:29.51,0:15:30.65,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:15:30.98,0:15:32.68,,NTP,0000,0000,0000,,Әке, өтінемін
Dialogue: 0,0:15:34.16,0:15:38.33,,NTP,0000,0000,0000,,Ямада мырза, мен әкімшімін.
Dialogue: 0,0:15:39.67,0:15:41.74,,NTP,0000,0000,0000,,Иә Сәлем
Dialogue: 0,0:15:41.91,0:15:47.08,,NTP,0000,0000,0000,,Ямада отбасында қандай да бір мәселе бар ма?
Dialogue: 0,0:15:48.09,0:15:50.02,,NTP,0000,0000,0000,,Сен сияқты біреуге уақытымды босқа жұмсауға уақытым жоқ.
Dialogue: 0,0:15:50.42,0:15:56.20,,NTP,0000,0000,0000,,Жарайды, жарайды. Бұл жерде ештеңе жоқ. Бұл күлкілі.
Dialogue: 0,0:15:56.30,0:15:58.16,,NTP,0000,0000,0000,,жақсы болар еді.
Dialogue: 0,0:15:58.33,0:16:02.75,,NTP,0000,0000,0000,,Ой, мен шай ішіп отырмын, кешіріңіз.
Dialogue: 0,0:16:02.86,0:16:05.84,,NTP,0000,0000,0000,,А, мен асығып тұрмын.
Dialogue: 0,0:16:05.89,0:16:06.94,,NTP,0000,0000,0000,,Сабырсыз
Dialogue: 0,0:16:07.10,0:16:13.11,,NTP,0000,0000,0000,,Жоқ, ол шай, шай алғың келе ме?
Dialogue: 0,0:16:13.17,0:16:18.52,,NTP,0000,0000,0000,,Рахмет, іштей сөйлесейік.
Dialogue: 0,0:16:21.94,0:16:23.69,,NTP,0000,0000,0000,,(Кёко Хори) Иә, әлі де өзімді жақсы сезінбеймін.
Dialogue: 0,0:16:24.52,0:16:26.35,,NTP,0000,0000,0000,,Чидің ойыншықтарын жасыруым керек.
Dialogue: 0,0:16:26.43,0:16:27.61,,NTP,0000,0000,0000,,Йохеи де өтінемін
Dialogue: 0,0:16:29.80,0:16:31.48,,NTP,0000,0000,0000,,Qi де ойнайды
Dialogue: 0,0:16:33.68,0:16:35.67,,NTP,0000,0000,0000,,Ах, Цидің шашы.
Dialogue: 0,0:16:35.79,0:16:39.86,,NTP,0000,0000,0000,,Жоқ, қазір біраз әбігер.
Dialogue: 0,0:16:39.95,0:16:41.82,,NTP,0000,0000,0000,,Уайымдамаңыз
Dialogue: 0,0:16:48.08,0:16:50.45,,NTP,0000,0000,0000,,Әдемі емес пе?
Dialogue: 0,0:16:51.09,0:16:53.44,,NTP,0000,0000,0000,,Қош келдіңіз
Dialogue: 0,0:16:53.55,0:16:57.85,,NTP,0000,0000,0000,,Сәлеметсіз бе ханым, мазалағаным үшін кешіріңіз.
Dialogue: 0,0:17:01.51,0:17:03.52,,NTP,0000,0000,0000,,Мен сен демалыс үйін сатып аламыз дедің деп анық естідім.
Dialogue: 0,0:17:05.32,0:17:06.53,,NTP,0000,0000,0000,,Sa Sa
Dialogue: 0,0:17:14.62,0:17:20.19,,NTP,0000,0000,0000,,Сізді кенеттен бөлгенім үшін кешіріңіз.
Dialogue: 0,0:17:20.26,0:17:23.82,,NTP,0000,0000,0000,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:17:25.44,0:17:29.72,,NTP,0000,0000,0000,,Ци, осы жерде тыныш күтіңіз.
Dialogue: 0,0:17:29.95,0:17:34.61,,NTP,0000,0000,0000,,Йохеи осында ойнайық
Dialogue: 0,0:17:38.06,0:17:40.96,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:17:40.99,0:17:44.05,,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:17:44.11,0:17:50.73,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:17:50.82,0:17:53.57,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:17:53.65,0:17:57.08,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:17:57.12,0:18:02.52,,NTP,0000,0000,0000,,Бақытты жату
Dialogue: 0,0:18:02.57,0:18:04.95,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:18:06.91,0:18:09.92,,NTP,0000,0000,0000,,Сізді кенеттен бөлгенім үшін кешіріңіз.
Dialogue: 0,0:18:10.04,0:18:10.97,,NTP,0000,0000,0000,,Жақсы
Dialogue: 0,0:18:11.49,0:18:13.86,,NTP,0000,0000,0000,,Осы жерге тығыл, жарай ма?
Dialogue: 0,0:18:14.43,0:18:17.84,,NTP,0000,0000,0000,,Сонымен әңгіме мысықтар туралы.
Dialogue: 0,0:18:17.94,0:18:19.09,,NTP,0000,0000,0000,,мысық
Dialogue: 0,0:18:19.12,0:18:23.76,,NTP,0000,0000,0000,,Иә, экранның есігінде таяқша бар.
Dialogue: 0,0:18:24.73,0:18:26.60,,NTP,0000,0000,0000,,Міне
Dialogue: 0,0:18:27.05,0:18:30.00,,NTP,0000,0000,0000,,Үйімде мысық болады деп ойламадым.
Dialogue: 0,0:18:31.56,0:18:34.60,,NTP,0000,0000,0000,,Менің ойымша.
Dialogue: 0,0:18:35.21,0:18:38.78,,NTP,0000,0000,0000,,Анау қара мысық сенің үйіңе де кіріп келеді.
Dialogue: 0,0:18:39.08,0:18:39.94,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:18:39.97,0:18:41.24,,NTP,0000,0000,0000,,Қара мысық
Dialogue: 0,0:18:41.42,0:18:44.26,,NTP,0000,0000,0000,,Мен де Сузукидің үйін пайдаланамын.
Dialogue: 0,0:18:44.34,0:18:47.78,,NTP,0000,0000,0000,,Қара мысық торлы есікті ашып, ішке кіреді.
Dialogue: 0,0:18:48.11,0:18:50.24,,NTP,0000,0000,0000,,Солай ма?
Dialogue: 0,0:18:52.48,0:18:54.21,,NTP,0000,0000,0000,,Өте шиеленісті, иә?
Dialogue: 0,0:18:55.90,0:18:57.23,,NTP,0000,0000,0000,,Қызықты
Dialogue: 0,0:18:57.40,0:18:59.75,,NTP,0000,0000,0000,,Жоқ, Чи.
Dialogue: 0,0:19:03.14,0:19:04.28,,NTP,0000,0000,0000,,Бірдеңе
Dialogue: 0,0:19:04.40,0:19:08.19,,NTP,0000,0000,0000,,Йохеи ваннаны жинап жатыр.
Dialogue: 0,0:19:09.10,0:19:12.18,,NTP,0000,0000,0000,,Иә, иә, мен соңғы уақытта тазалықты жақсы көремін.
Dialogue: 0,0:19:12.28,0:19:14.01,,NTP,0000,0000,0000,,Бала деген қызық, солай емес пе?
Dialogue: 0,0:19:15.73,0:19:18.12,,NTP,0000,0000,0000,,Бұл өте біртүрлі.
Dialogue: 0,0:19:19.62,0:19:21.33,,NTP,0000,0000,0000,,Маған бұл ұнайды
Dialogue: 0,0:19:22.42,0:19:23.46,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:19:23.75,0:19:26.31,,NTP,0000,0000,0000,,Сіз өте қуаныштысыз.
Dialogue: 0,0:19:26.95,0:19:29.32,,NTP,0000,0000,0000,,Әңгіменің қалған бөлігі
Dialogue: 0,0:19:29.41,0:19:35.37,,NTP,0000,0000,0000,,Иә, қара мысық. Бұл көпқабатты үйдің біреуінің иелігінде деген қауесет бар.
Dialogue: 0,0:19:35.48,0:19:36.98,,NTP,0000,0000,0000,,Мен бірдеңе білмеймін
Dialogue: 0,0:19:37.08,0:19:38.75,,NTP,0000,0000,0000,,Ештеңе жоқ
Dialogue: 0,0:19:41.72,0:19:43.99,,NTP,0000,0000,0000,,№.
Dialogue: 0,0:19:46.80,0:19:50.40,,NTP,0000,0000,0000,,Шай үшін рахмет. Егер сізге бірдеңе керек болса, маған хабарлаңыз.
Dialogue: 0,0:19:55.18,0:19:56.53,,NTP,0000,0000,0000,,Йохай-кун, бәрібір.
Dialogue: 0,0:19:57.44,0:19:59.35,,NTP,0000,0000,0000,,Сол
Dialogue: 0,0:20:02.46,0:20:03.98,,NTP,0000,0000,0000,,Табылды
Dialogue: 0,0:20:04.48,0:20:06.86,,NTP,0000,0000,0000,,Артық емес
Dialogue: 0,0:20:08.69,0:20:12.05,,NTP,0000,0000,0000,,Сен де қабырғаларды тазалап жатырсың, Йохеи.
Dialogue: 0,0:20:12.94,0:20:15.90,,NTP,0000,0000,0000,,Маған қатты әсер қалдырды.
Dialogue: 0,0:20:16.56,0:20:18.22,,NTP,0000,0000,0000,,Әлі жоқ.
Dialogue: 0,0:20:22.75,0:20:24.37,,NTP,0000,0000,0000,,Мен құтқарылдым.
Dialogue: 0,0:20:25.01,0:20:27.62,,NTP,0000,0000,0000,,Қарашы, Чи, бұл осылай.
Dialogue: 0,0:20:27.85,0:20:29.54,,NTP,0000,0000,0000,,плюс отбасылық әулеттік қорқыныш, деп ойлаймын
Dialogue: 0,0:20:34.19,0:20:36.98,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:20:37.02,0:20:40.10,,NTP,0000,0000,0000,,Сүт көп Мен бақыттымын
Dialogue: 0,0:20:40.15,0:20:46.76,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:20:46.87,0:20:49.64,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:20:49.71,0:20:53.16,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:20:53.24,0:20:58.65,,NTP,0000,0000,0000,,Бақытты жату
Dialogue: 0,0:20:58.74,0:21:01.13,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:21:06.02,0:21:08.84,,NTP,0000,0000,0000,,Олай болса, Циді лақтырып тастаймын дейсің бе?
Dialogue: 0,0:21:08.92,0:21:11.22,,NTP,0000,0000,0000,,Сіз бұлай демес едіңіз.
Dialogue: 0,0:21:11.28,0:21:14.55,,NTP,0000,0000,0000,,Қара мысық оқиғасына байланысты әкімші маған келді.
Dialogue: 0,0:21:14.62,0:21:16.89,,NTP,0000,0000,0000,,Чи әлі табылмаған болуы мүмкін.
Dialogue: 0,0:21:17.04,0:21:18.52,,NTP,0000,0000,0000,,Бірақ
Dialogue: 0,0:21:19.78,0:21:22.02,,NTP,0000,0000,0000,,Нене, ойнайық
Dialogue: 0,0:21:22.11,0:21:23.35,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:21:24.21,0:21:26.86,,NTP,0000,0000,0000,,Бұл сіздің күшіңізді біршама арттырады.
Dialogue: 0,0:21:26.93,0:21:29.03,,NTP,0000,0000,0000,,Чи, сен не істеп жатырсың?
Dialogue: 0,0:21:29.17,0:21:31.54,,NTP,0000,0000,0000,,Біз не ойнауымыз керек?
Dialogue: 0,0:21:33.12,0:21:37.00,,NTP,0000,0000,0000,,Менің ойымша, оны жасыру уақыт мәселесі.
Dialogue: 0,0:21:37.17,0:21:40.25,,NTP,0000,0000,0000,,Сонымен, сіз жаңа иесін іздеп жүрсіз бе?
Dialogue: 0,0:21:40.29,0:21:41.16,,NTP,0000,0000,0000,,Әңгіме
Dialogue: 0,0:21:41.26,0:21:45.21,,NTP,0000,0000,0000,,Себебі мені осы жерден қуып жіберуі мүмкін.
Dialogue: 0,0:21:45.32,0:21:47.07,,NTP,0000,0000,0000,,Чи, мен ойнағым келеді.
Dialogue: 0,0:21:47.13,0:21:50.30,,NTP,0000,0000,0000,,Бірақ Чи қазір отбасы.
Dialogue: 0,0:21:50.43,0:21:52.98,,NTP,0000,0000,0000,,Біз не ойнауымыз керек?
Dialogue: 0,0:21:53.13,0:21:55.68,,NTP,0000,0000,0000,,Сондықтан мен не істеуім керек деп айтып отырмын?
Dialogue: 0,0:21:55.74,0:21:57.50,,NTP,0000,0000,0000,,Сонымен не істеуіміз керек?
Dialogue: 0,0:21:57.56,0:21:58.49,,NTP,0000,0000,0000,,Няня
Dialogue: 0,0:21:58.58,0:22:00.66,,NTP,0000,0000,0000,,Мен мұны істей алғым келеді
Dialogue: 0,0:22:00.73,0:22:02.64,,NTP,0000,0000,0000,,Мен Тарара жасағым келеді
Dialogue: 0,0:22:06.08,0:22:08.15,,NTP,0000,0000,0000,,Алаңдамаңыз
Dialogue: 0,0:22:10.33,0:22:12.67,,NTP,0000,0000,0000,,Youhei Qi өтінемін
Dialogue: 0,0:22:16.57,0:22:19.70,,NTP,0000,0000,0000,,Соңында не істейсің?
Dialogue: 0,0:22:19.78,0:22:21.57,,NTP,0000,0000,0000,,Буггарати мен басқалары шынында да осы пойызға мініпті
Dialogue: 0,0:22:37.03,0:22:39.54,,NTP,0000,0000,0000,,Мен жасырынбақ ойнаймын.
Dialogue: 0,0:22:39.64,0:22:41.23,,NTP,0000,0000,0000,,Ци, сен не істеп жатырсың?
Dialogue: 0,0:22:41.78,0:22:44.90,,NTP,0000,0000,0000,,Чи онда жоқ.
Dialogue: 0,0:22:47.36,0:22:49.12,,NTP,0000,0000,0000,,Бұл Чи.
Dialogue: 0,0:22:51.43,0:22:54.17,,NTP,0000,0000,0000,,Мен сөйлесуге тым алшақпын.
Dialogue: 0,0:22:54.21,0:22:56.69,,NTP,0000,0000,0000,,Сіз Чи туралы айтып отырсыз.
Dialogue: 0,0:22:58.47,0:23:02.22,,NTP,0000,0000,0000,,Қалай болғанда да, Чи әлі табылған жоқ.
Dialogue: 0,0:23:02.32,0:23:05.98,,NTP,0000,0000,0000,,Иә, тынышталып, ойланып көрейік.
Dialogue: 0,0:23:06.04,0:23:10.70,,NTP,0000,0000,0000,,А, енді не істеуім керек?
Dialogue: 0,0:23:12.19,0:23:18.98,,NTP,0000,0000,0000,,Мұнда бәрі басқаша. Міне, басқаша.
Dialogue: 0,0:23:21.68,0:23:23.60,,NTP,0000,0000,0000,,Ци Мен кітапты көре алмаймын.
Dialogue: 0,0:23:24.14,0:23:26.07,,NTP,0000,0000,0000,,Чи, осында.
Dialogue: 0,0:23:30.15,0:23:33.01,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:23:33.05,0:23:36.09,,NTP,0000,0000,0000,,Сүт көп Мен бақыттымын
Dialogue: 0,0:23:36.13,0:23:42.80,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:23:42.89,0:23:45.63,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:23:45.71,0:23:49.17,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:23:49.24,0:23:54.72,,NTP,0000,0000,0000,,Бақытты жату
Dialogue: 0,0:23:54.79,0:23:57.09,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:24:01.23,0:24:05.48,,NTP,0000,0000,0000,,Керемет
Dialogue: 0,0:24:05.63,0:24:08.19,,NTP,0000,0000,0000,,Сіз сүйкімді суретке түсіре алатын сияқтысыз
Dialogue: 0,0:24:09.88,0:24:11.78,,NTP,0000,0000,0000,,Сізге келудің қажеті жоқ.
Dialogue: 0,0:24:12.51,0:24:14.28,,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:24:14.98,0:24:17.02,,NTP,0000,0000,0000,,Бұл емес.
Dialogue: 0,0:24:18.44,0:24:21.37,,NTP,0000,0000,0000,,Иә Qi қандай болса солай
Dialogue: 0,0:24:23.46,0:24:26.90,,NTP,0000,0000,0000,,Бұл поза да жақсы
Dialogue: 0,0:24:28.02,0:24:31.03,,NTP,0000,0000,0000,,А, құйрық қана.
Dialogue: 0,0:24:34.62,0:24:36.98,,NTP,0000,0000,0000,,Әке, бұл олжа.
Dialogue: 0,0:24:38.21,0:24:40.28,,NTP,0000,0000,0000,,Осы өрнек үшін рахмет.
Dialogue: 0,0:24:44.87,0:24:46.45,,NTP,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:24:47.60,0:24:49.18,,NTP,0000,0000,0000,,Мен фотосурет алдым
Dialogue: 0,0:24:49.29,0:24:50.08,,NTP,0000,0000,0000,,Мими-уэ отырған вагонда әйелді мазалаған бір ер адам құлап қалды.
Dialogue: 0,0:24:50.76,0:24:56.49,,NTP,0000,0000,0000,,Қараңдаршы, Хоккайдодан келген Юри Жан маған Чидің суретін жіберуімді өтінді.
Dialogue: 0,0:24:56.60,0:24:57.49,,NTP,0000,0000,0000,,Маған көрсет
Dialogue: 0,0:24:58.23,0:25:00.59,,NTP,0000,0000,0000,,Иә, бұл не?
Dialogue: 0,0:25:01.04,0:25:04.89,,NTP,0000,0000,0000,,Төмендегі сәл қара нәрсе - Чидің көлеңкесі.
Dialogue: 0,0:25:05.03,0:25:07.46,,NTP,0000,0000,0000,,Чидің суретін түсірсем екен.
Dialogue: 0,0:25:07.58,0:25:10.95,,NTP,0000,0000,0000,,Суретке түсейін десем, Чи қашып кетті.
Dialogue: 0,0:25:11.19,0:25:14.95,,NTP,0000,0000,0000,,Ай қашып кетті
Dialogue: 0,0:25:15.22,0:25:18.66,,NTP,0000,0000,0000,,Иә, Йохеи, өтінемін.
Dialogue: 0,0:25:19.73,0:25:22.04,,NTP,0000,0000,0000,,Коу әке
Dialogue: 0,0:25:23.29,0:25:24.69,,NTP,0000,0000,0000,,Бұл жақсы ма?
Dialogue: 0,0:25:25.56,0:25:27.17,,NTP,0000,0000,0000,,Сүйкімді
Dialogue: 0,0:25:27.23,0:25:28.66,,NTP,0000,0000,0000,,Бұл жақсы
Dialogue: 0,0:25:33.65,0:25:34.51,,NTP,0000,0000,0000,,Өте жаман
Dialogue: 0,0:25:34.94,0:25:37.85,,NTP,0000,0000,0000,,Йохеи, сен не істеп жатырсың?
Dialogue: 0,0:25:37.91,0:25:40.25,,NTP,0000,0000,0000,,Сол жерде Чи
Dialogue: 0,0:25:40.92,0:25:44.14,,NTP,0000,0000,0000,,Ол жерде емес, ана жақта, Чи.
Dialogue: 0,0:25:49.32,0:25:51.85,,NTP,0000,0000,0000,,Егер мұндай нәрсе болса, оны маған қалдырыңыз.
Dialogue: 0,0:25:56.19,0:25:58.62,,NTP,0000,0000,0000,,Чи сүйкімді
Dialogue: 0,0:25:59.54,0:26:00.85,,NTP,0000,0000,0000,,Ысырма мүмкіндігі
Dialogue: 0,0:26:15.41,0:26:18.00,,NTP,0000,0000,0000,,Бұл сіздің бетіңіздің жалғыз фотосы ма?
Dialogue: 0,0:26:20.69,0:26:22.62,,NTP,0000,0000,0000,,Мен таң қалдым.
Dialogue: 0,0:26:26.23,0:26:29.02,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:26:29.06,0:26:32.15,,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:26:32.24,0:26:38.92,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:26:38.97,0:26:41.75,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:26:41.79,0:26:45.22,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:26:45.31,0:26:50.77,,NTP,0000,0000,0000,,Жатып, бақытты болу
Dialogue: 0,0:26:50.85,0:26:53.22,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:26:55.75,0:27:00.07,,NTP,0000,0000,0000,,Суреттен өзгеше Сүйкімді
Dialogue: 0,0:27:03.76,0:27:05.10,,NTP,0000,0000,0000,,Ештеңе
Dialogue: 0,0:27:06.38,0:27:07.31,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:27:08.80,0:27:09.79,,NTP,0000,0000,0000,,Ештеңе
Dialogue: 0,0:27:10.00,0:27:11.20,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:27:12.64,0:27:14.41,,NTP,0000,0000,0000,,Күтіңіз, күтіңіз
Dialogue: 0,0:27:15.31,0:27:16.08,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:27:16.24,0:27:17.44,,NTP,0000,0000,0000,,Юри
Dialogue: 0,0:27:17.62,0:27:18.88,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:27:19.88,0:27:21.70,,NTP,0000,0000,0000,,Мұнда келме
Dialogue: 0,0:27:21.98,0:27:24.50,,NTP,0000,0000,0000,,Ах, фотодағыдай
Dialogue: 0,0:27:24.58,0:27:26.18,,NTP,0000,0000,0000,,О, Джури-чан
Dialogue: 0,0:27:26.27,0:27:27.61,,NTP,0000,0000,0000,,Мысықты құшақтау
Dialogue: 0,0:27:28.51,0:27:30.30,,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:27:30.64,0:27:32.66,,NTP,0000,0000,0000,,Ци, тынышталыңыз.
Dialogue: 0,0:27:32.73,0:27:34.79,,NTP,0000,0000,0000,,Мысықты құшақтау
Dialogue: 0,0:27:35.33,0:27:37.03,,NTP,0000,0000,0000,,Оны да тоқтат, Джури-чан.
Dialogue: 0,0:27:37.34,0:27:39.80,,NTP,0000,0000,0000,,Кел, кел, кел.
Dialogue: 0,0:27:40.29,0:27:42.82,,NTP,0000,0000,0000,,Қарашы, Чи, сен келгенде.
Dialogue: 0,0:27:42.94,0:27:46.59,,NTP,0000,0000,0000,,Кел, кел, кел, кел.
Dialogue: 0,0:27:42.85,0:27:45.52,,NTP,0000,0000,0000,,Сабыр ет, Юри.
Dialogue: 0,0:27:45.79,0:27:47.29,,NTP,0000,0000,0000,,Джури-чан, шырын
Dialogue: 0,0:27:47.44,0:27:49.34,,NTP,0000,0000,0000,,Иә Шырын
Dialogue: 0,0:27:51.02,0:27:52.95,,NTP,0000,0000,0000,,Рахмет, апай.
Dialogue: 0,0:27:54.39,0:27:56.38,,NTP,0000,0000,0000,,Юри де мысықтарды жақсы көреді
Dialogue: 0,0:27:56.47,0:27:57.54,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:27:57.60,0:28:03.43,,NTP,0000,0000,0000,,Сіз жіберген фотоны көргенде, Чи Чанмен кездесуді асыға күткен едіңіз.
Dialogue: 0,0:28:05.20,0:28:06.15,,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:28:08.01,0:28:10.66,,NTP,0000,0000,0000,,Qi, не болды?
Dialogue: 0,0:28:13.19,0:28:17.25,,NTP,0000,0000,0000,,Белгісіз иіс Күдікті иіс
Dialogue: 0,0:28:19.09,0:28:20.24,,NTP,0000,0000,0000,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:28:21.82,0:28:25.05,,NTP,0000,0000,0000,,Құйрықты қыспаңыз
Dialogue: 0,0:28:29.11,0:28:31.81,,NTP,0000,0000,0000,,Түсіндің бе?
Dialogue: 0,0:28:36.29,0:28:38.78,,NTP,0000,0000,0000,,Мен сақтықты түсіре алмаймын.
Dialogue: 0,0:28:44.71,0:28:50.76,,NTP,0000,0000,0000,,Сіз не істемексіз? Чи, мен жеңілмеймін.
Dialogue: 0,0:28:53.77,0:28:54.84,,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:28:55.72,0:28:58.28,,NTP,0000,0000,0000,,Би билеу Би билеу
Dialogue: 0,0:28:58.36,0:28:59.77,,NTP,0000,0000,0000,,Сіз ашулысыз.
Dialogue: 0,0:28:59.89,0:29:00.64,,NTP,0000,0000,0000,,О
Dialogue: 0,0:29:06.86,0:29:09.79,,NTP,0000,0000,0000,,Чи кішкентай, бірақ қатыгез бала.
Dialogue: 0,0:29:10.63,0:29:12.35,,NTP,0000,0000,0000,,Джури-чан да
Dialogue: 0,0:29:15.63,0:29:18.07,,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:29:22.30,0:29:25.10,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:29:25.18,0:29:28.23,,NTP,0000,0000,0000,,Мен сонша сүтке ризамын
Dialogue: 0,0:29:28.30,0:29:34.94,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:29:35.00,0:29:37.77,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:29:37.83,0:29:41.24,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:29:41.35,0:29:46.81,,NTP,0000,0000,0000,,Жатып, бақытты болу
Dialogue: 0,0:29:46.91,0:29:49.38,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:29:51.39,0:29:53.56,,NTP,0000,0000,0000,,Бұл кәдесый. Оны ашыңыз.
Dialogue: 0,0:29:54.49,0:29:56.73,,NTP,0000,0000,0000,,Уау, керемет
Dialogue: 0,0:29:57.16,0:30:00.22,,NTP,0000,0000,0000,,Мен оны біраз ұстауға қорқамын.
Dialogue: 0,0:30:00.44,0:30:01.30,,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:30:01.65,0:30:03.26,,NTP,0000,0000,0000,,О Чи
Dialogue: 0,0:30:11.66,0:30:13.31,,NTP,0000,0000,0000,,Бұл біртүрлі.
Dialogue: 0,0:30:13.52,0:30:14.48,,NTP,0000,0000,0000,,Шаян
Dialogue: 0,0:30:15.81,0:30:16.63,,NTP,0000,0000,0000,,Ай
Dialogue: 0,0:30:21.14,0:30:22.71,,NTP,0000,0000,0000,,Жарайды, енді іске кірісейік.
Dialogue: 0,0:30:23.39,0:30:25.30,,NTP,0000,0000,0000,,Джури-чан керемет
Dialogue: 0,0:30:25.34,0:30:26.97,,NTP,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:30:27.67,0:30:29.27,,NTP,0000,0000,0000,,Мен жеңілетін сияқтымын
Dialogue: 0,0:30:31.37,0:30:32.42,,NTP,0000,0000,0000,,Қараңыз
Dialogue: 0,0:30:34.93,0:30:36.74,,NTP,0000,0000,0000,,Мен жеңілмеймін
Dialogue: 0,0:30:43.23,0:30:44.33,,NTP,0000,0000,0000,,Джури-чан
Dialogue: 0,0:30:44.43,0:30:45.08,,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:30:45.17,0:30:47.67,,NTP,0000,0000,0000,,Чиді қатты таң қалдырмаңыз.
Dialogue: 0,0:30:47.75,0:30:48.74,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:30:53.47,0:30:56.66,,NTP,0000,0000,0000,,Чи, келіңдер.
Dialogue: 0,0:30:56.96,0:31:01.02,,NTP,0000,0000,0000,,Ол төбелесші, абай бол.
Dialogue: 0,0:31:03.10,0:31:04.66,,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:31:04.71,0:31:06.76,,NTP,0000,0000,0000,,Джури-чан, сен не істеп жатырсың?
Dialogue: 0,0:31:07.14,0:31:10.92,,NTP,0000,0000,0000,,Жануарлар мойындарын түсіргенде өздерін жақсы сезінеді.
Dialogue: 0,0:31:10.98,0:31:12.11,,NTP,0000,0000,0000,,Юкине-кун, бұл адамды танисың ба?
Dialogue: 0,0:31:12.62,0:31:17.17,,NTP,0000,0000,0000,,Көрдіңіз бе, үйдегі жылқы да, ит те жақсы сезінеді.
Dialogue: 0,0:31:20.29,0:31:23.93,,NTP,0000,0000,0000,,Жақсы, мен бітірдім, оңай болды.
Dialogue: 0,0:31:24.68,0:31:28.08,,NTP,0000,0000,0000,,Qi, қуанатын тағы көп нәрсе бар.
Dialogue: 0,0:31:28.35,0:31:29.91,,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:31:29.96,0:31:32.69,,NTP,0000,0000,0000,,Жақсы, жақсы, жақсы, жақсы, жақсы.
Dialogue: 0,0:31:32.79,0:31:37.59,,NTP,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:31:37.66,0:31:38.99,,NTP,0000,0000,0000,,Джури-чан, тоқтат.
Dialogue: 0,0:31:39.26,0:31:43.82,,NTP,0000,0000,0000,,Жарайды, жарайды, жарайды, менің итім өте қуанышты болады.
Dialogue: 0,0:31:44.90,0:31:46.61,,NTP,0000,0000,0000,,Жарайды.
Dialogue: 0,0:31:49.20,0:31:52.05,,NTP,0000,0000,0000,,Қараңызшы, көңілді көрінеді.
Dialogue: 0,0:31:55.90,0:31:57.05,,NTP,0000,0000,0000,,Бұл
Dialogue: 0,0:31:57.81,0:32:03.63,,NTP,0000,0000,0000,,Юри: Чи Чанға дөрекі болма, ол котенка.
Dialogue: 0,0:32:03.71,0:32:05.00,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:32:09.66,0:32:12.63,,NTP,0000,0000,0000,,Бұл қызықты болды
Dialogue: 0,0:32:18.28,0:32:21.16,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:32:21.21,0:32:24.22,,NTP,0000,0000,0000,,Мен сонша сүтке ризамын
Dialogue: 0,0:32:24.29,0:32:30.92,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:32:31.02,0:32:33.76,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:32:33.85,0:32:37.29,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:32:37.38,0:32:42.80,,NTP,0000,0000,0000,,Жатып, бақытты болу
Dialogue: 0,0:32:42.91,0:32:45.38,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:32:47.45,0:32:49.88,,NTP,0000,0000,0000,,Юри Жан жақсы жұмыс істейді.
Dialogue: 0,0:32:49.97,0:32:53.26,,NTP,0000,0000,0000,,Мен Хоккайдодағы Рокуджо қаласында өстім.
Dialogue: 0,0:32:54.29,0:32:57.04,,NTP,0000,0000,0000,,Қараңдаршы, бұл жылқы.
Dialogue: 0,0:32:59.44,0:32:59.95,,NTP,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:33:00.06,0:33:00.72,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:33:00.83,0:33:01.48,,NTP,0000,0000,0000,,Бұл
Dialogue: 0,0:33:01.57,0:33:02.49,,NTP,0000,0000,0000,,Чи, кел.
Dialogue: 0,0:33:02.56,0:33:03.67,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:33:05.66,0:33:08.10,,NTP,0000,0000,0000,,Келесі жолы не ойнаймыз?
Dialogue: 0,0:33:10.06,0:33:12.57,,NTP,0000,0000,0000,,Менің немен ойнағанымды қалайсың?
Dialogue: 0,0:33:12.80,0:33:17.91,,NTP,0000,0000,0000,,О, Чиге Джури Жан ұнайтын сияқты.
Dialogue: 0,0:33:18.34,0:33:20.68,,NTP,0000,0000,0000,,Ци Ойнайық
Dialogue: 0,0:33:21.14,0:33:23.75,,NTP,0000,0000,0000,,Чи, сәл күте тұрыңыз.
Dialogue: 0,0:33:25.77,0:33:27.17,,NTP,0000,0000,0000,,Не
Dialogue: 0,0:33:27.74,0:33:30.45,,NTP,0000,0000,0000,,Жарайды, Чи, кеттік.
Dialogue: 0,0:33:36.26,0:33:38.15,,NTP,0000,0000,0000,,Мен оны алдым.
Dialogue: 0,0:33:38.24,0:33:40.46,,NTP,0000,0000,0000,,Ци, әкел.
Dialogue: 0,0:33:40.55,0:33:41.98,,NTP,0000,0000,0000,,Мен оны алдым.
Dialogue: 0,0:33:42.07,0:33:43.91,,NTP,0000,0000,0000,,Оны әкеліңіз.
Dialogue: 0,0:33:44.09,0:33:47.86,,NTP,0000,0000,0000,,Жарайды, ит болса, алып келер едім.
Dialogue: 0,0:33:52.52,0:33:54.96,,NTP,0000,0000,0000,,Келесі жолы мен әкелемін.
Dialogue: 0,0:33:55.67,0:33:57.34,,NTP,0000,0000,0000,,Мен оны алдым.
Dialogue: 0,0:33:57.57,0:34:00.36,,NTP,0000,0000,0000,,Жарайды, мен әкелуім керек.
Dialogue: 0,0:34:01.15,0:34:02.83,,NTP,0000,0000,0000,,Келесі жолы мен әкелемін.
Dialogue: 0,0:34:09.14,0:34:11.02,,NTP,0000,0000,0000,,Серуендеуге барасыз ба?
Dialogue: 0,0:34:11.13,0:34:13.91,,NTP,0000,0000,0000,,Мен бұл пәтерде мысық ұстай аламын ба?
Dialogue: 0,0:34:14.03,0:34:15.21,,NTP,0000,0000,0000,,...
Dialogue: 0,0:34:15.72,0:34:20.15,,NTP,0000,0000,0000,,Егер бірдеңе болса, мен Ци Сянды үйге апарамын.
Dialogue: 0,0:34:20.56,0:34:24.13,,NTP,0000,0000,0000,,Мүмкін болса, рахмет.
Dialogue: 0,0:34:24.24,0:34:26.54,,NTP,0000,0000,0000,,Чи, менің үйіме келесің бе?
Dialogue: 0,0:34:26.67,0:34:29.17,,NTP,0000,0000,0000,,Жоқ, мүмкін бұл жай ғана факт.
Dialogue: 0,0:34:30.31,0:34:32.09,,NTP,0000,0000,0000,,Қош бол
Dialogue: 0,0:34:32.54,0:34:33.91,,NTP,0000,0000,0000,,Жақында кездескенше
Dialogue: 0,0:34:34.86,0:34:38.22,,NTP,0000,0000,0000,,Мен Чицзянды үйге апарамын.
Dialogue: 0,0:34:52.22,0:34:53.48,,NTP,0000,0000,0000,,Йохай
Dialogue: 0,0:34:55.91,0:34:58.67,,NTP,0000,0000,0000,,Йохай Ойнайық
Dialogue: 0,0:35:01.33,0:35:04.53,,NTP,0000,0000,0000,,Чи ешқайда бармайды, солай ма?
Dialogue: 0,0:35:05.71,0:35:06.70,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:35:07.20,0:35:09.34,,NTP,0000,0000,0000,,Нене, ойнайық
Dialogue: 0,0:35:10.84,0:35:16.84,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory