Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.58,0:00:05.21,Default,,0,0,0,,Ба… а…
Dialogue: 0,0:00:05.75,0:00:07.50,Default,,0,0,0,,Бұл Чизуко күні.
Dialogue: 0,0:00:07.59,0:00:09.80,Default,,0,0,0,,Дайын болсаңыз, уайымдаудың қажеті жоқ.
Dialogue: 0,0:00:09.88,0:00:13.38,Default,,0,0,0,,Өткен күні қолданған құм дорбаларым өте пайдалы болды.
Dialogue: 0,0:00:13.47,0:00:14.68,Default,,0,0,0,,Бұл көмектеседі.
Dialogue: 0,0:00:14.76,0:00:15.76,Default,,0,0,0,,Аю аю
Dialogue: 0,0:00:15.85,0:00:17.39,Default,,0,0,0,,Барлығына кейінірек
Dialogue: 0,0:00:17.47,0:00:21.27,Default,,0,0,0,,Мен сізге құлпынай хош иісі бар ыстық протеинмен сыйлаймын.
Dialogue: 0,0:00:21.35,0:00:23.39,Default,,0,0,0,,Аю аю
Dialogue: 0,0:00:23.48,0:00:25.27,Default,,0,0,0,,Сізге жақсы
Dialogue: 0,0:00:25.77,0:00:26.77,Default,,0,0,0,,Хой
Dialogue: 0,0:00:26.86,0:00:29.53,Default,,0,0,0,,Тағы бір қадам
Dialogue: 0,0:00:30.44,0:00:34.95,Default,,0,0,0,,Жапон теңізі жағындағы N префектурасының Нанига қаласында жаңбыр салқын.
Dialogue: 0,0:00:35.03,0:00:37.41,Default,,0,0,0,,Ылғалданса, өзегіне дейін суытады...
Dialogue: 0,0:00:37.49,0:00:39.41,Default,,0,0,0,,Күн картасының баламасы
Dialogue: 0,0:00:39.49,0:00:42.00,Default,,0,0,0,,Осыдан кейін мен сенің жалғыз кеткеніңді қалаймын.
Dialogue: 0,0:00:42.08,0:00:42.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:43.00,0:00:47.42,Default,,0,0,0,,Менің аяқ киімім жаңбырмен суланған.
Dialogue: 0,0:00:50.13,0:00:52.05,Default,,0,0,0,,Шыдамның шегіне жеттім.
Dialogue: 0,0:00:52.13,0:00:54.05,Default,,0,0,0,,Бұл етік?
Dialogue: 0,0:00:54.63,0:00:56.43,Default,,0,0,0,,Шұлықты ауыстыруға оралу
Dialogue: 0,0:00:56.51,0:00:58.55,Default,,0,0,0,,Шайқас туралы не айтасыз?
Dialogue: 0,0:00:58.64,0:01:01.89,Default,,0,0,0,,Мен дереу қайтамын, сондықтан аман болыңыз.
Dialogue: 0,0:01:05.14,0:01:07.06,Default,,0,0,0,,Чайнатаун болса да, ол Йокогамада ғой!
Dialogue: 0,0:01:12.99,0:01:16.41,Default,,0,0,0,,Жоқ, бірақ бұл күресуден алыс...
Dialogue: 0,0:01:16.49,0:01:18.49,Default,,0,0,0,,Берри және басқалары әлі де осында.
Dialogue: 0,0:01:20.58,0:01:22.83,Default,,0,0,0,,Әзірше, ішінде...
Dialogue: 0,0:01:25.92,0:01:28.88,Default,,0,0,0,,Бұл көмектесті.
Dialogue: 0,0:01:30.67,0:01:32.13,Default,,0,0,0,,Өлімдік күнәлардың кардиналына тән нәрсе деп айтуға болатын шығар.
Dialogue: 0,0:01:32.21,0:01:34.63,Default,,0,0,0,,Фосса Магна штатындағы Данте?
Dialogue: 0,0:01:35.13,0:01:36.09,Default,,0,0,0,,Бол...
Dialogue: 0,0:01:36.18,0:01:38.14,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:01:38.22,0:01:41.06,Default,,0,0,0,,Сен шынымен де осындай күнде төбелеспексің бе?
Dialogue: 0,0:01:41.14,0:01:43.52,Default,,0,0,0,,Өйткені Маширо желге ұшып кетеді.
Dialogue: 0,0:01:43.60,0:01:45.64,Default,,0,0,0,,Мен үйде отырмын.
Dialogue: 0,0:01:46.23,0:01:48.19,Default,,0,0,0,,Заңды сұрақ
Dialogue: 0,0:01:48.27,0:01:52.40,Default,,0,0,0,,Сондай-ақ... Хрома біраз уақыттан кейін осында болады, мен одан бұл туралы сұраймын.
Dialogue: 0,0:01:52.48,0:01:53.73,Default,,0,0,0,,О...
Dialogue: 0,0:01:54.69,0:01:56.90,Default,,0,0,0,,Ал, сен келгенше күтейік.
Dialogue: 0,0:01:57.45,0:01:58.91,Default,,0,0,0,,Көрші үйге келіңіз.
Dialogue: 0,0:02:00.45,0:02:03.91,Default,,0,0,0,,Берри гүлімен жалғыз!?
Dialogue: 0,0:02:03.99,0:02:05.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:06.00,0:02:10.75,Default,,0,0,0,,♪～
Dialogue: 0,0:03:33.29,0:03:35.92,Default,,0,0,0,,～♪
Dialogue: 0,0:03:39.01,0:03:41.93,Default,,0,0,0,,... Тез кел, Хрома.
Dialogue: 0,0:03:42.01,0:03:45.68,Default,,0,0,0,,Уф...Мен қатты қобалжыдым, шыдай алмаймын.
Dialogue: 0,0:03:50.81,0:03:53.60,Default,,0,0,0,,Ха... Мүмкін күтуім керек пе?
Dialogue: 0,0:03:53.69,0:03:56.23,Default,,0,0,0,,Кейбір адамдардың дымқыл болғаны сонша, иықтары ашық қалады.
Dialogue: 0,0:03:57.44,0:03:59.23,Default,,0,0,0,,Жидек гүлі
Dialogue: 0,0:03:59.32,0:04:00.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:00.32,0:04:03.49,Default,,0,0,0,,Мм... Қарсы болмасаңыз, мынау.
Dialogue: 0,0:04:05.03,0:04:06.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:08.99,0:04:10.96,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:04:12.12,0:04:13.92,Default,,0,0,0,,Жылы
Dialogue: 0,0:04:14.88,0:04:16.92,Default,,0,0,0,,Ахххх...
Dialogue: 0,0:04:17.00,0:04:20.76,Default,,0,0,0,,Бірақ бұл Данте-кунды суытпайды.
Dialogue: 0,0:04:20.84,0:04:22.34,Default,,0,0,0,,Солай сияқты.
Dialogue: 0,0:04:22.84,0:04:23.93,Default,,0,0,0,,Ах
Dialogue: 0,0:04:24.01,0:04:26.93,Default,,0,0,0,,Жоқ... жоқ, бәрі жақсы.
Dialogue: 0,0:04:28.18,0:04:30.18,Default,,0,0,0,,(Изуку) Каири-чан (Каири) Дэку-сан
Dialogue: 0,0:04:31.27,0:04:32.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:32.89,0:04:34.60,Default,,0,0,0,,Өтінемін, Компота.
Dialogue: 0,0:04:37.56,0:04:39.07,Default,,0,0,0,,(Ранпа) Зұлымдар Альянсы, иә? Тамаша! Кел, байқап көрейік!
Dialogue: 0,0:04:40.86,0:04:41.99,Default,,0,0,0,,Сол жерден?
Dialogue: 0,0:04:42.07,0:04:44.49,Default,,0,0,0,,Мен оны өзіммен бірге алып жүремін.
Dialogue: 0,0:04:44.57,0:04:46.28,Default,,0,0,0,,Каир, қызыл бұршақ пастасы және т.б.
Dialogue: 0,0:04:48.87,0:04:52.16,Default,,0,0,0,,Сондай-ақ жылытқыш бар.
Dialogue: 0,0:04:52.25,0:04:53.54,Default,,0,0,0,,Тұрмыстық техника кенеттен?
Dialogue: 0,0:04:53.62,0:04:57.54,Default,,0,0,0,,Егер сіз электр қуатын пайдалана алмасаңыз, оны алып жүрудің қажеті жоқ, солай ма?
Dialogue: 0,0:04:57.63,0:04:59.63,Default,,0,0,0,,Ал... солай шығар.
Dialogue: 0,0:05:01.13,0:05:02.92,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:05:03.01,0:05:05.38,Default,,0,0,0,,Назар аударғаныңызға рахмет.
Dialogue: 0,0:05:05.47,0:05:08.18,Default,,0,0,0,,Суық болмай тұрып, мен оны аламын.
Dialogue: 0,0:05:08.26,0:05:09.64,Default,,0,0,0,,♬ Мен бара жатқан жер — әлі көрінбеген тағдыр
Dialogue: 0,0:05:09.72,0:05:10.68,Default,,0,0,0,,Иә
Dialogue: 0,0:05:11.47,0:05:14.48,Default,,0,0,0,,Өте ұзақ уақыттан бері көрмеппін.
Dialogue: 0,0:05:16.52,0:05:17.94,Default,,0,0,0,,Сәтсіздік
Dialogue: 0,0:05:18.02,0:05:20.23,Default,,0,0,0,,Данте-кунның жақсы бала болғанына қуанамын.
Dialogue: 0,0:05:20.32,0:05:22.19,Default,,0,0,0,,Мен сәл көтерілдім.
Dialogue: 0,0:05:24.28,0:05:27.53,Default,,0,0,0,,Мұндай бала қалайша зұлым кеңесші болады...
Dialogue: 0,0:05:27.61,0:05:28.45,Default,,0,0,0,,Ha
Dialogue: 0,0:05:28.53,0:05:30.62,Default,,0,0,0,,Умммм хахаха...
Dialogue: 0,0:05:30.62,0:05:32.95,Default,,0,0,0,,Умммм хахаха...
Dialogue: 0,0:05:30.62,0:05:32.95,Default,,0,0,0,,Сіз шынымен де өзіңізді мәжбүрледіңіз бе?
Dialogue: 0,0:05:33.04,0:05:37.46,Default,,0,0,0,,Ойлап қарасам, өткен күні неге екені белгісіз жылап жібердім.
Dialogue: 0,0:05:37.54,0:05:38.79,Default,,0,0,0,,Фу…
Dialogue: 0,0:05:39.54,0:05:40.79,Default,,0,0,0,,Данте-кун
Dialogue: 0,0:05:40.88,0:05:41.96,Default,,0,0,0,,Иә
Dialogue: 0,0:05:42.05,0:05:45.55,Default,,0,0,0,,Егер сіз Chroma-ға еруге мәжбүр болсаңыз және қызметкер офицері ретінде әрекет етуге мәжбүр болсаңыз.
Dialogue: 0,0:05:45.63,0:05:47.43,Default,,0,0,0,,Маған сеніңіз
Dialogue: 0,0:05:47.51,0:05:49.72,Default,,0,0,0,,Адамдарды қиыншылықта жалғыз қалдыра алмайсың.
Dialogue: 0,0:05:49.80,0:05:51.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:51.72,0:05:53.64,Default,,0,0,0,,Жидек гүлі...
Dialogue: 0,0:05:54.31,0:05:58.23,Default,,0,0,0,,Берри Блэссом мен үшін уайымдап жатыр ма?
Dialogue: 0,0:05:58.85,0:06:01.73,Default,,0,0,0,,Мен ешқашан мұндай құрметке ие болған емеспін.
Dialogue: 0,0:06:02.27,0:06:03.73,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:06:06.49,0:06:07.95,Default,,0,0,0,,Данте-кун?
Dialogue: 0,0:06:09.28,0:06:13.58,Default,,0,0,0,,Кадр қызметкері болған себебім оны жарқырату болды.
Dialogue: 0,0:06:17.83,0:06:21.59,Default,,0,0,0,,Өйткені мен Берри гүлінің салқын болғанын қалаймын.
Dialogue: 0,0:06:25.76,0:06:29.55,Default,,0,0,0,,Біз салқын зұлым болуды мақсат етеміз.
Dialogue: 0,0:06:29.64,0:06:32.22,Default,,0,0,0,,Бұл қалада мәңгілік осылай
Dialogue: 0,0:06:33.22,0:06:35.93,Default,,0,0,0,,Баталарыңыз үшін көп рахмет.
Dialogue: 0,0:06:36.43,0:06:38.94,Default,,0,0,0,,Мені алдағаныңызға қуаныштымын.
Dialogue: 0,0:06:39.65,0:06:40.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:45.36,0:06:46.53,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:06:51.57,0:06:54.87,Default,,0,0,0,,А... Сол әлсіздік әрекет пе?
Dialogue: 0,0:06:54.95,0:06:58.46,Default,,0,0,0,,Сіз мені бірдеңе істеуге мәжбүрледіңіз бе?
Dialogue: 0,0:06:59.08,0:07:00.83,Default,,0,0,0,,Мен жеңілдім!
Dialogue: 0,0:07:00.92,0:07:03.67,Default,,0,0,0,,Мен мүлдем алданып қалдым!
Dialogue: 0,0:07:04.25,0:07:06.92,Default,,0,0,0,,Бірақ... Бірақ...
Dialogue: 0,0:07:08.26,0:07:11.97,Default,,0,0,0,,Пончоңызды маған қарызға бергеніңіз рас, солай ма?
Dialogue: 0,0:07:12.85,0:07:13.93,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:07:14.01,0:07:17.35,Default,,0,0,0,,Фосса магна қалай аталады?
Dialogue: 0,0:07:19.94,0:07:21.40,Default,,0,0,0,,Сіз қоңырау шалдыңыз ба?
Dialogue: 0,0:07:21.48,0:07:23.31,Default,,0,0,0,,Эй, мұнда!
Dialogue: 0,0:07:23.40,0:07:24.40,Default,,0,0,0,,Қазір тым кеш пе?
Dialogue: 0,0:07:24.48,0:07:26.48,Default,,0,0,0,,Нені шулатып жатырсың?
Dialogue: 0,0:07:29.40,0:07:30.90,Default,,0,0,0,,Дантеге не болды?
Dialogue: 0,0:07:30.99,0:07:33.78,Default,,0,0,0,,Сіздің қызметкеріңіз мұны маған жасады.
Dialogue: 0,0:07:33.87,0:07:36.95,Default,,0,0,0,,О, Дантенің ісі.
Dialogue: 0,0:07:37.41,0:07:39.29,Default,,0,0,0,,Бұл қандай зұлымдық?
Dialogue: 0,0:07:39.37,0:07:40.75,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:41.21,0:07:43.58,Default,,0,0,0,,Мені басқа атмосферамен алдау
Dialogue: 0,0:07:44.04,0:07:46.80,Default,,0,0,0,,Мен компот пен қызыл бұршақ пастасын жеп отырдым...\NТек
Dialogue: 0,0:07:46.88,0:07:48.05,Default,,0,0,0,,...
Dialogue: 0,0:07:49.30,0:07:50.97,Default,,0,0,0,,Кукукуку…
Dialogue: 0,0:07:51.43,0:07:53.93,Default,,0,0,0,,Мұны істеме Данте
Dialogue: 0,0:07:56.89,0:07:59.81,Default,,0,0,0,,Ал, бүгін біз сызықтық функциялар туралы сөйлесетін боламыз.
Dialogue: 0,0:07:59.89,0:08:01.73,Default,,0,0,0,,Барлығы бірінші сыныпта оқып жүргенде
Dialogue: 0,0:08:01.81,0:08:04.56,Default,,0,0,0,,Менің ойымша, сіз пропорционалдық және кері пропорция туралы білдіңіз.
Dialogue: 0,0:08:04.65,0:08:07.57,Default,,0,0,0,,Бұл жолы біз қолдануға және мысалдар жасауға тоқталамыз...
Dialogue: 0,0:08:08.11,0:08:10.53,Default,,0,0,0,,Салқын зұлымдық...
Dialogue: 0,0:08:10.99,0:08:14.32,Default,,0,0,0,,Зұлымдықтың анықтамасы қандай?
Dialogue: 0,0:08:16.87,0:08:20.00,Default,,0,0,0,,Қандай жағдай болмасын, алда әлі алда...
Dialogue: 0,0:08:20.00,0:08:21.08,Default,,0,0,0,,Қалай болғанда да, әлі алда әлі алда...
Dialogue: 0,0:08:20.00,0:08:21.08,Default,,0,0,0,,(Барлығы күңкілдейді)
Dialogue: 0,0:08:21.08,0:08:21.16,Default,,0,0,0,,(Барлығы күңкілдейді)
Dialogue: 0,0:08:21.16,0:08:22.00,Default,,0,0,0,,(Барлығы күңкілдейді)
Dialogue: 0,0:08:21.16,0:08:22.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:30.30,0:08:31.34,Default,,0,0,0,,Иә!?
Dialogue: 0,0:08:31.80,0:08:34.18,Default,,0,0,0,,Жұмбақ кеңсе қызметкері ауада ілулі тұр...
Dialogue: 0,0:08:34.26,0:08:35.47,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:08:38.06,0:08:39.18,Default,,0,0,0,,Яба
Dialogue: 0,0:08:39.26,0:08:41.85,Default,,0,0,0,,Бұл адам бұрынғыдай жақсы ма?
Dialogue: 0,0:08:41.93,0:08:43.60,Default,,0,0,0,,Маған тез арада көмек керек
Dialogue: 0,0:08:43.69,0:08:45.65,Default,,0,0,0,,Полиция? Өрт сөндіру бөлімі?
Dialogue: 0,0:08:45.73,0:08:48.52,Default,,0,0,0,,Мен сені кім деп атайын, Руми-чан?
Dialogue: 0,0:08:49.61,0:08:52.49,Default,,0,0,0,,Немесе... құбыжық пайда болды!
Dialogue: 0,0:08:52.57,0:08:53.82,Default,,0,0,0,,Құбыжық?
Dialogue: 0,0:08:53.90,0:08:56.16,Default,,0,0,0,,Әй, солай ма?
Dialogue: 0,0:08:56.24,0:08:57.45,Default,,0,0,0,,Біз есімізді жоғалтқан болармыз, иә?
Dialogue: 0,0:08:57.53,0:08:59.70,Default,,0,0,0,,Аюлар шынымен де жауыз
Dialogue: 0,0:09:00.24,0:09:01.50,Default,,0,0,0,,Шынында да…
Dialogue: 0,0:09:01.58,0:09:03.91,Default,,0,0,0,,Мен қашуым керек пе?
Dialogue: 0,0:09:05.83,0:09:06.83,Default,,0,0,0,,Жарайды
Dialogue: 0,0:09:06.92,0:09:09.38,Default,,0,0,0,,Мен мұны жаман істеріме жамылғы ретінде пайдаланып біттім.
Dialogue: 0,0:09:09.46,0:09:13.05,Default,,0,0,0,,Салқын зұлымдық қарапайым адамдарды құрбандыққа шалмайды.
Dialogue: 0,0:09:13.13,0:09:14.63,Default,,0,0,0,,Бұл бірінші қадам
Dialogue: 0,0:09:23.98,0:09:25.98,Default,,0,0,0,,Иә, қабылдаймын.
Dialogue: 0,0:09:26.06,0:09:28.61,Default,,0,0,0,,Мен не істеуім керек? мм...
Dialogue: 0,0:09:35.36,0:09:37.36,Default,,0,0,0,,Ахх...
Dialogue: 0,0:09:39.91,0:09:41.70,Default,,0,0,0,,Жидек гүлі!
Dialogue: 0,0:09:41.79,0:09:43.37,Default,,0,0,0,,Иә? Сіз...
Dialogue: 0,0:09:43.45,0:09:45.50,Default,,0,0,0,,Құбыжықтың пайда болғанын естігенде
Dialogue: 0,0:09:45.58,0:09:47.37,Default,,0,0,0,,Аспаннан жалақышы көрінеді...
Dialogue: 0,0:09:47.83,0:09:49.38,Default,,0,0,0,,Біз тағы да кездестік.
Dialogue: 0,0:09:49.46,0:09:52.38,Default,,0,0,0,,Мүмкін сіз көмектесу үшін қалдыңыз ба?
Dialogue: 0,0:09:53.67,0:09:54.88,Default,,0,0,0,,Аба~
Dialogue: 0,0:09:54.97,0:09:56.09,Default,,0,0,0,,Ах
Dialogue: 0,0:09:57.18,0:10:00.01,Default,,0,0,0,,Хмм, мен тым көп ұйықтадым деп ойлаймын.
Dialogue: 0,0:10:00.10,0:10:01.68,Default,,0,0,0,,Мен үшін алғаш рет!
Dialogue: 0,0:10:01.76,0:10:03.14,Default,,0,0,0,,Сіз тыныс ала аласыз ба?
Dialogue: 0,0:10:03.22,0:10:04.64,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:10:04.73,0:10:06.31,Default,,0,0,0,,Қайғырма.
Dialogue: 0,0:10:06.39,0:10:08.40,Default,,0,0,0,,Не?
Dialogue: 0,0:10:08.48,0:10:10.65,Default,,0,0,0,,Демек, шынымен де мұнда жартылай жұмыс істеуді бастапсың ғой.
Dialogue: 0,0:10:10.73,0:10:13.03,Default,,0,0,0,,Сен сиқырлы қызсың
Dialogue: 0,0:10:13.11,0:10:14.19,Default,,0,0,0,,Е...
Dialogue: 0,0:10:14.28,0:10:17.36,Default,,0,0,0,,Сіз маған көмектестіңіз. Кешіріңіз.
Dialogue: 0,0:10:17.45,0:10:18.66,Default,,0,0,0,,Жоқ, жоқ
Dialogue: 0,0:10:18.74,0:10:21.03,Default,,0,0,0,,Әділдік одақтасы ретінде бұл заңдылық.
Dialogue: 0,0:10:21.12,0:10:24.04,Default,,0,0,0,,Рахмет айтып, той берейін.
Dialogue: 0,0:10:24.54,0:10:25.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:25.62,0:10:28.54,Default,,0,0,0,,Осындай күдікті бейтаныс адаммен?
Dialogue: 0,0:10:28.62,0:10:30.13,Default,,0,0,0,,Сіз де келіңіз
Dialogue: 0,0:10:30.21,0:10:31.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:41.14,0:10:43.06,Default,,0,0,0,,Келіңдер, келіңдер.
Dialogue: 0,0:10:43.14,0:10:45.27,Default,,0,0,0,,Жоқ, жоқ, жоқ, солай
Dialogue: 0,0:10:45.35,0:10:47.81,Default,,0,0,0,,Тәкаппар болу жаман.
Dialogue: 0,0:10:47.89,0:10:50.73,Default,,0,0,0,,Сондықтан жеке ұшақтан түсе алмай қалдым.
Dialogue: 0,0:10:50.81,0:10:51.94,Default,,0,0,0,,Оны құпия сақтаңыз.
Dialogue: 0,0:10:52.02,0:10:54.78,Default,,0,0,0,,Сіз Berry Blossom тобына қосылуды жоспарлап отырсыз ба?
Dialogue: 0,0:10:54.86,0:10:55.48,Default,,0,0,0,,Бұған жол бермеңіз...
Dialogue: 0,0:10:55.48,0:10:56.23,Default,,0,0,0,,Бұған жол берме...
Dialogue: 0,0:10:55.48,0:10:56.23,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:10:56.23,0:10:56.90,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:10:57.65,0:10:58.99,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:11:01.24,0:11:02.87,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:11:02.95,0:11:06.16,Default,,0,0,0,,Құлпынай парфесін жеу~
Dialogue: 0,0:11:06.24,0:11:08.16,Default,,0,0,0,,Сіз тамақ ішпейсіз бе?
Dialogue: 0,0:11:08.71,0:11:11.63,Default,,0,0,0,,Менің жүрегім толып кетті...
Dialogue: 0,0:11:11.71,0:11:13.59,Default,,0,0,0,,Онда мен жеймін.
Dialogue: 0,0:11:14.67,0:11:18.88,Default,,0,0,0,,Қалай болғанда да, сиқырлы қыздар әдетте не істейді?
Dialogue: 0,0:11:18.97,0:11:20.93,Default,,0,0,0,,Ах... ммм.
Dialogue: 0,0:11:21.01,0:11:22.84,Default,,0,0,0,,Қала тыныштығын қорғау
Dialogue: 0,0:11:22.93,0:11:25.81,Default,,0,0,0,,Біз Fossa Magna деп аталатын зұлым ұйыммен күресіп жатырмыз.
Dialogue: 0,0:11:25.89,0:11:27.43,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:11:27.52,0:11:31.14,Default,,0,0,0,,Сондай-ақ, мен қазір мұнда емеспін.
Dialogue: 0,0:11:31.23,0:11:33.81,Default,,0,0,0,,Мен Маширо есімді қыздан қолдау таптым.
Dialogue: 0,0:11:34.82,0:11:36.07,Default,,0,0,0,,Иә
Dialogue: 0,0:11:36.15,0:11:38.78,Default,,0,0,0,,Сіз шынымен таңдануға тұрарлықсыз.
Dialogue: 0,0:11:38.86,0:11:41.70,Default,,0,0,0,,Хмм, құпия
Dialogue: 0,0:11:45.45,0:11:48.58,Default,,0,0,0,,Әуелі, сен...
Dialogue: 0,0:11:48.66,0:11:49.66,Default,,0,0,0,,Ах
Dialogue: 0,0:11:49.75,0:11:51.33,Default,,0,0,0,,Мен сізді таныстыруға кешігіп қалдым.
Dialogue: 0,0:11:53.79,0:11:54.88,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:11:54.96,0:11:57.46,Default,,0,0,0,,Сіз танымайтын адамнан визит картасын ала алмайсыз.
Dialogue: 0,0:11:57.55,0:12:00.72,Default,,0,0,0,,Иә, мен оны танымайтындықтан сізге берейін деп ойладым.
Dialogue: 0,0:12:01.76,0:12:03.93,Default,,0,0,0,,Басю Омизо?
Dialogue: 0,0:12:04.01,0:12:06.18,Default,,0,0,0,,Oomizo Technica?
Dialogue: 0,0:12:06.26,0:12:09.60,Default,,0,0,0,,Ах, мен соңғы кездері көп еститін компания...
Dialogue: 0,0:12:09.68,0:12:10.98,Default,,0,0,0,,Президент мырза!?
Dialogue: 0,0:12:11.06,0:12:12.19,Default,,0,0,0,,Иә
Dialogue: 0,0:12:12.85,0:12:13.98,Default,,0,0,0,,Хехе
Dialogue: 0,0:12:14.06,0:12:15.06,Default,,0,0,0,,Бұл
Dialogue: 0,0:12:15.15,0:12:17.23,Default,,0,0,0,,Тамақ бергеніңізге көп рахмет.
Dialogue: 0,0:12:17.32,0:12:18.57,Default,,0,0,0,,Президент мырза
Dialogue: 0,0:12:18.65,0:12:20.24,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:20.32,0:12:22.07,Default,,0,0,0,,Хм, солай ма?
Dialogue: 0,0:12:22.15,0:12:23.99,Default,,0,0,0,,Бұл өте қызық болды.
Dialogue: 0,0:12:24.45,0:12:26.74,Default,,0,0,0,,Содан кейін мен жұмысқа қайта ораламын.
Dialogue: 0,0:12:26.83,0:12:27.95,Default,,0,0,0,,Иә
Dialogue: 0,0:12:28.03,0:12:30.29,Default,,0,0,0,,Үйге қайтқанда абай болыңыз.
Dialogue: 0,0:12:30.37,0:12:32.91,Default,,0,0,0,,Зұлым ұйымдар пайда болуы мүмкін
Dialogue: 0,0:12:33.00,0:12:34.50,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:12:34.58,0:12:37.38,Default,,0,0,0,,Соңғы уақытта қызметкерлер саны өсті.
Dialogue: 0,0:12:37.46,0:12:39.13,Default,,0,0,0,,Ол мұны өте жақсы біледі.
Dialogue: 0,0:12:39.21,0:12:42.13,Default,,0,0,0,,Бұл мен болуым керек!
Dialogue: 0,0:12:43.01,0:12:44.55,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:12:44.55,0:12:46.05,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:12:44.55,0:12:46.05,Default,,0,0,0,,<Мен оны «Спайс» деп атаймын➡
Dialogue: 0,0:12:46.72,0:12:48.60,Default,,0,0,0,,Сәлеметсіз бе, Маширо?
Dialogue: 0,0:12:48.68,0:12:50.39,Default,,0,0,0,,Сіз кешіктіңіз.
Dialogue: 0,0:12:50.47,0:12:52.98,Default,,0,0,0,,Біз супермаркеттің алдында кездесеміз, солай ма?
Dialogue: 0,0:12:53.06,0:12:54.73,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:12:54.81,0:12:56.10,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:56.19,0:13:00.61,Default,,0,0,0,,Жарайды, құбыжық пайда болды деді, мен барсам ол жоқ екен.
Dialogue: 0,0:13:00.69,0:13:02.49,Default,,0,0,0,,Содан кейін парашют...
Dialogue: 0,0:13:02.57,0:13:03.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:03.90,0:13:07.57,Default,,0,0,0,,Мен шынымен түсінбеймін, бірақ бәрібір сонда барамын.
Dialogue: 0,0:13:07.66,0:13:08.87,Default,,0,0,0,,Қай жерде?
Dialogue: 0,0:13:08.95,0:13:11.16,Default,,0,0,0,,Орналасқан жері? Ал...
Dialogue: 0,0:13:11.24,0:13:12.66,Default,,0,0,0,,Фу…
Dialogue: 0,0:13:12.75,0:13:16.42,Default,,0,0,0,,Уайымдамаңыз, сіздің шынайы болмысыңыз ашылмайды.
Dialogue: 0,0:13:17.79,0:13:21.71,Default,,0,0,0,,Түрлендіру кезінде тануды блоктай аласыз.
Dialogue: 0,0:13:21.80,0:13:23.88,Default,,0,0,0,,Өйткені ол солай.
Dialogue: 0,0:13:23.97,0:13:25.72,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:13:26.18,0:13:27.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:27.72,0:13:31.47,Default,,0,0,0,,Сонымен, президент маған парфей сыйлады.
Dialogue: 0,0:13:31.56,0:13:34.27,Default,,0,0,0,,Олар маған жеке ұшақты құпия ұстауымды айтты.
Dialogue: 0,0:13:34.35,0:13:35.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:35.44,0:13:38.19,Default,,0,0,0,,Сіз не айтып тұрсыз? Мен оны одан сайын түсінбеймін.
Dialogue: 0,0:13:38.27,0:13:39.11,Default,,0,0,0,,Ой…
Dialogue: 0,0:13:39.69,0:13:41.73,Default,,0,0,0,,Мен оны таптым
Dialogue: 0,0:13:44.03,0:13:46.57,Default,,0,0,0,,Фосса Магнаның құлауы
Dialogue: 0,0:13:46.66,0:13:48.99,Default,,0,0,0,,Сатқын Синдзиро-кун
Dialogue: 0,0:13:57.92,0:13:59.25,Default,,0,0,0,,Маширо?
Dialogue: 0,0:13:59.71,0:14:02.13,Default,,0,0,0,,Фосса Магнаға қатысы бар ма?
Dialogue: 0,0:14:02.21,0:14:04.42,Default,,0,0,0,,Не... нені айтып тұрсың?
Dialogue: 0,0:14:04.51,0:14:06.72,Default,,0,0,0,,Ой!
Dialogue: 0,0:14:06.80,0:14:09.14,Default,,0,0,0,,Сіз Берри Блоссомсыз, солай ма?
Dialogue: 0,0:14:09.22,0:14:10.51,Default,,0,0,0,,Да... кім?
Dialogue: 0,0:14:10.60,0:14:12.14,Default,,0,0,0,,Мен қазір өңдеудемін...
Dialogue: 0,0:14:12.22,0:14:14.14,Default,,0,0,0,,Мен сізден сұхбат алғым келеді.
Dialogue: 0,0:14:14.22,0:14:17.27,Default,,0,0,0,,Не? Мен... Мен?
Dialogue: 0,0:14:17.35,0:14:18.35,Default,,0,0,0,,Иә
Dialogue: 0,0:14:18.44,0:14:21.73,Default,,0,0,0,,Жақында болған алып оқиға қызу тақырыпқа айналды.
Dialogue: 0,0:14:21.82,0:14:23.73,Default,,0,0,0,,Солай етіңіз.
Dialogue: 0,0:14:23.82,0:14:26.49,Default,,0,0,0,,Не... не істеуіміз керек? Маширо
Dialogue: 0,0:14:27.36,0:14:28.36,Default,,0,0,0,,А...
Dialogue: 0,0:14:31.41,0:14:34.45,Default,,0,0,0,,Маширо, сен қайда бардың?
Dialogue: 0,0:14:39.29,0:14:41.84,Default,,0,0,0,,Бұл... Дата Чизуко.
Dialogue: 0,0:14:41.92,0:14:45.34,Default,,0,0,0,,Бұл адам жай ғана оғаш президент емес.
Dialogue: 0,0:14:45.42,0:14:47.72,Default,,0,0,0,,Біз Fossa Magna компаниясының президентіміз.
Dialogue: 0,0:14:47.80,0:14:48.76,Default,,0,0,0,,Ах
Dialogue: 0,0:14:48.84,0:14:51.97,Default,,0,0,0,,Енді ойлап қарасам, кешегі телефондағы әлгі кісінің даусы...
Dialogue: 0,0:14:52.43,0:14:54.72,Default,,0,0,0,,Байқау өте кеш.
Dialogue: 0,0:14:54.81,0:14:57.48,Default,,0,0,0,,Бұл оның қолы жетпейтіндігінен.
Dialogue: 0,0:14:57.56,0:14:59.98,Default,,0,0,0,,Сенің мұнда не үшін келгеніңді білмеймін...
Dialogue: 0,0:15:00.06,0:15:01.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:01.19,0:15:04.65,Default,,0,0,0,,Бірақ Маширо-сан қатты қиындыққа тап болды.
Dialogue: 0,0:15:04.73,0:15:06.86,Default,,0,0,0,,Теледидарға сұхбат беруге бола ма?
Dialogue: 0,0:15:06.94,0:15:10.03,Default,,0,0,0,,Маширо? Ол жігітке не болды?
Dialogue: 0,0:15:10.11,0:15:12.32,Default,,0,0,0,,Иә, бұл...
Dialogue: 0,0:15:12.41,0:15:15.87,Default,,0,0,0,,Қандай да бір себептермен ол президентпен бірге жоғалып кетті.
Dialogue: 0,0:15:17.70,0:15:20.29,Default,,0,0,0,,Президент былай дейді...
Dialogue: 0,0:15:20.75,0:15:24.13,Default,,0,0,0,,Ұйымда Маширо мырза да болған сияқты.
Dialogue: 0,0:15:24.21,0:15:25.75,Default,,0,0,0,,Маширо?
Dialogue: 0,0:15:26.21,0:15:28.59,Default,,0,0,0,,Мен ондай адамды танымаймын.
Dialogue: 0,0:15:28.67,0:15:29.63,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:15:29.72,0:15:30.84,Default,,0,0,0,,О
Dialogue: 0,0:15:31.30,0:15:35.43,Default,,0,0,0,,Қалай болғанда да, біз әдеттегідей істейміз.
Dialogue: 0,0:15:35.51,0:15:36.89,Default,,0,0,0,,Әңгімелесу күні
Dialogue: 0,0:15:36.97,0:15:38.22,Default,,0,0,0,,Иә...
Dialogue: 0,0:15:44.65,0:15:46.52,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:15:46.61,0:15:50.03,Default,,0,0,0,,Маширо мені әділдікке одақтас етсе де.
Dialogue: 0,0:15:51.86,0:15:54.45,Default,,0,0,0,,Оған тоқталмаңыз
Dialogue: 0,0:15:54.53,0:15:56.95,Default,,0,0,0,,Күнді әдеттегідей өткізу керек.
Dialogue: 0,0:15:57.04,0:16:00.41,Default,,0,0,0,,Маширо оны көрсе, алаңдауы мүмкін.
Dialogue: 0,0:16:04.21,0:16:07.67,Default,,0,0,0,,Кеш болды, зұлым ұйым.
Dialogue: 0,0:16:07.75,0:16:09.92,Default,,0,0,0,,Қашан келесіз?
Dialogue: 0,0:16:10.01,0:16:11.17,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:16:11.26,0:16:14.39,Default,,0,0,0,,Мен әділдіктің одақтасымын, сондықтан түсінбеймін.
Dialogue: 0,0:16:16.85,0:16:18.14,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:16:18.22,0:16:19.43,Default,,0,0,0,,Төмен түсіңіз
Dialogue: 0,0:16:19.52,0:16:21.77,Default,,0,0,0,,Фосса Магна
Dialogue: 0,0:16:21.85,0:16:25.31,Default,,0,0,0,,Куку... Бүгін сенің соңғы күнің.
Dialogue: 0,0:16:36.16,0:16:38.58,Default,,0,0,0,,Бүгін ғана, неге велосипедте...
Dialogue: 0,0:16:38.66,0:16:41.45,Default,,0,0,0,,Сіздің қоржыныңызда жұмыртқалар бар.
Dialogue: 0,0:16:41.54,0:16:42.91,Default,,0,0,0,,Фу…
Dialogue: 0,0:16:43.00,0:16:45.50,Default,,0,0,0,,Бәрі жақсы, Данте.
Dialogue: 0,0:16:45.58,0:16:48.71,Default,,0,0,0,,Велосипед тұрағы толып тұрғанда, мен мұны жақсы емес деп ойладым.
Dialogue: 0,0:16:48.80,0:16:50.76,Default,,0,0,0,,Велосипедіңізбен келуіңіз керек.
Dialogue: 0,0:16:50.84,0:16:52.47,Default,,0,0,0,,Жарайды, бұрын, бұрын.
Dialogue: 0,0:16:52.55,0:16:54.88,Default,,0,0,0,,Әй, бұл...
Dialogue: 0,0:16:54.97,0:16:56.76,Default,,0,0,0,,Жоқ, әдетте.
Dialogue: 0,0:16:56.85,0:16:58.39,Default,,0,0,0,,Айырмашылығы неде?
Dialogue: 0,0:16:58.47,0:17:00.52,Default,,0,0,0,,Әдеттегідей, И
Dialogue: 0,0:17:05.52,0:17:07.44,Default,,0,0,0,,Аю
Dialogue: 0,0:17:07.52,0:17:09.40,Default,,0,0,0,,Аю~
Dialogue: 0,0:17:09.48,0:17:10.86,Default,,0,0,0,,Аю аю
Dialogue: 0,0:17:10.94,0:17:13.90,Default,,0,0,0,,Енді кескілескен шайқас басталды.
Dialogue: 0,0:17:13.99,0:17:16.87,Default,,0,0,0,,Бүгінгі Кума монстрының өлшемі қалыпты сияқты.
Dialogue: 0,0:17:16.95,0:17:18.62,Default,,0,0,0,,Аю
Dialogue: 0,0:17:18.70,0:17:20.37,Default,,0,0,0,,Хаа (Кума монстры) ставкасы...
Dialogue: 0,0:17:20.45,0:17:22.12,Default,,0,0,0,,Аю (жидек гүлі) Уау
Dialogue: 0,0:17:22.20,0:17:23.75,Default,,0,0,0,,Аю
Dialogue: 0,0:17:23.83,0:17:25.71,Default,,0,0,0,,Аю аю аю аю…
Dialogue: 0,0:17:26.37,0:17:27.21,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:28.92,0:17:30.84,Default,,0,0,0,,Аю~!
Dialogue: 0,0:17:30.92,0:17:32.59,Default,,0,0,0,,Хаха...
Dialogue: 0,0:17:32.67,0:17:36.55,Default,,0,0,0,,Мен ешқашан мұндай ауыртпалықпен ұрысып көрмеппін.
Dialogue: 0,0:17:36.63,0:17:38.76,Default,,0,0,0,,Хмф, әрине.
Dialogue: 0,0:17:38.85,0:17:42.43,Default,,0,0,0,,Мен қазіргі жігіттен ешқандай амбицияны немесе күрескерлік рухты сезе алмаймын.
Dialogue: 0,0:17:42.52,0:17:45.39,Default,,0,0,0,,Егер солай болса, мен де жақсы жекпе-жекке шығуым мүмкін...
Dialogue: 0,0:17:51.07,0:17:53.36,Default,,0,0,0,,Не болды? Мен жақсы көрмеймін!
Dialogue: 0,0:17:53.44,0:17:55.36,Default,,0,0,0,,Біреу құлап кеткен сияқты.
Dialogue: 0,0:17:55.45,0:17:57.61,Default,,0,0,0,,Бұл реттелді дегенді білдіре ме?
Dialogue: 0,0:17:57.70,0:18:00.49,Default,,0,0,0,,Қатты жидек гүлі!
Dialogue: 0,0:18:09.88,0:18:12.84,Default,,0,0,0,,Қош бол менің велосипедім
Dialogue: 0,0:18:12.92,0:18:14.67,Default,,0,0,0,,Сыртқы жарақат жоқ сияқты.
Dialogue: 0,0:18:14.76,0:18:16.72,Default,,0,0,0,,Сиқырлы қыз сен!
Dialogue: 0,0:18:16.80,0:18:20.47,Default,,0,0,0,,Мен мұндай оғаш уақытта жеңілгенімді қабылдай алмаймын!
Dialogue: 0,0:18:20.55,0:18:23.43,Default,,0,0,0,,Ой... Маширо...
Dialogue: 0,0:18:31.48,0:18:32.61,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:18:32.69,0:18:35.86,Default,,0,0,0,,Қызық, Маширо-санның жоғалуы жауап па?
Dialogue: 0,0:18:35.94,0:18:37.03,Default,,0,0,0,,Хмм
Dialogue: 0,0:18:37.11,0:18:39.78,Default,,0,0,0,,Бұрынғыдай бәсеке жоқ екені рас.
Dialogue: 0,0:18:40.24,0:18:43.08,Default,,0,0,0,,Ол фюрермен бірге жоғалып кеткен жоқ па?
Dialogue: 0,0:18:43.16,0:18:45.58,Default,,0,0,0,,Менде түсінік болғанын қалаймын.
Dialogue: 0,0:18:45.66,0:18:47.50,Default,,0,0,0,,Та-дай қазір!
Dialogue: 0,0:18:48.00,0:18:50.75,Default,,0,0,0,,Ата
Dialogue: 0,0:18:50.83,0:18:52.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:52.17,0:18:55.76,Default,,0,0,0,,Эй, сен ерекше тұтынушысың.
Dialogue: 0,0:18:55.84,0:18:57.13,Default,,0,0,0,,Қараңыз~
Dialogue: 0,0:18:57.22,0:19:00.01,Default,,0,0,0,,Мен сол жердегі ағыннан шаян жинадым.
Dialogue: 0,0:19:00.09,0:19:02.43,Default,,0,0,0,,Енді бәрі...
Dialogue: 0,0:19:02.51,0:19:03.51,Default,,0,0,0,,Соңында ол табысқа жете ме, жетпей ме
Dialogue: 0,0:19:03.60,0:19:05.43,Default,,0,0,0,,Уф... ой...
Dialogue: 0,0:19:05.52,0:19:06.52,Default,,0,0,0,,Бичи бичи бичи...
Dialogue: 0,0:19:06.60,0:19:09.39,Default,,0,0,0,,Мен мұны бұрын көргендей сезінемін.
Dialogue: 0,0:19:09.48,0:19:12.73,Default,,0,0,0,,Міне, бұл Хью, бұрынғы жаңа бас қолбасшы.
Dialogue: 0,0:19:12.81,0:19:14.48,Default,,0,0,0,,Мұны айтпа!
Dialogue: 0,0:19:14.57,0:19:16.03,Default,,0,0,0,,Эй, мен сөйледім.
Dialogue: 0,0:19:16.11,0:19:17.53,Default,,0,0,0,,Бұл не, балалар?
Dialogue: 0,0:19:17.61,0:19:20.15,Default,,0,0,0,,Менімен қандай да бір ісің бар ма?
Dialogue: 0,0:19:22.49,0:19:25.29,Default,,0,0,0,,Иә, бұл кісіден сұрасаңыз...
Dialogue: 0,0:19:25.37,0:19:27.79,Default,,0,0,0,,Мүмкін сіз бірдеңені анықтай аласыз
Dialogue: 0,0:19:27.87,0:19:29.79,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:19:29.87,0:19:31.96,Default,,0,0,0,,Біз қазір жей аламыз ба?
Dialogue: 0,0:19:32.04,0:19:32.92,Default,,0,0,0,,Неліктен!?
Dialogue: 0,0:19:33.00,0:19:34.42,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:19:34.50,0:19:35.92,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:19:36.42,0:19:37.55,Default,,0,0,0,,Мен темекі шегуді тастадым
Dialogue: 0,0:19:37.63,0:19:41.80,Default,,0,0,0,,Мен жоғалып кеткен Маширо мырзаның қайда екенін сұрадым...
Dialogue: 0,0:19:41.89,0:19:45.31,Default,,0,0,0,,Олардың екі басы бірдей болғандықтан білуге мүмкіндік жоқ.
Dialogue: 0,0:19:46.51,0:19:48.31,Default,,0,0,0,,Мен ештеңе түсінбедім
Dialogue: 0,0:19:48.39,0:19:50.27,Default,,0,0,0,,Ол ашық...
Dialogue: 0,0:19:50.35,0:19:52.15,Default,,0,0,0,,Үміттенуге рұқсат етіңіз
Dialogue: 0,0:19:52.23,0:19:54.86,Default,,0,0,0,,Сіз бұлай ештеңе істей алмайсыз!
Dialogue: 0,0:19:54.94,0:19:56.27,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:19:57.15,0:20:00.32,Default,,0,0,0,,Мен Берри Гүлінің көңіл-күйіңізді көтергенін қалаймын.
Dialogue: 0,0:20:00.40,0:20:04.07,Default,,0,0,0,,Мм Маширо...
Dialogue: 0,0:20:04.16,0:20:06.70,Default,,0,0,0,,Мен сізге Маширо мырзамен кездесуге рұқсат беруім керек.
Dialogue: 0,0:20:06.78,0:20:09.04,Default,,0,0,0,,Алайда ешқандай ақпарат жоқ...
Dialogue: 0,0:20:09.12,0:20:10.46,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,0:20:10.54,0:20:13.67,Default,,0,0,0,,Екі басты бала болса, үйге қайтып бара жатқанда көретін едім.
Dialogue: 0,0:20:13.75,0:20:15.79,Default,,0,0,0,,А... қайда?
Dialogue: 0,0:20:15.88,0:20:18.59,Default,,0,0,0,,Мен станцияға қарай бет алдым.
Dialogue: 0,0:20:18.67,0:20:21.72,Default,,0,0,0,,Мен бейтаныс адаммен болдым.
Dialogue: 0,0:20:27.01,0:20:28.51,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:20:29.02,0:20:30.02,Default,,0,0,0,,Айқай?
Dialogue: 0,0:20:30.10,0:20:31.60,Default,,0,0,0,,Біз де барайық
Dialogue: 0,0:20:31.68,0:20:33.44,Default,,0,0,0,,Хрома үйде
Dialogue: 0,0:20:33.94,0:20:35.31,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:20:35.40,0:20:36.81,Default,,0,0,0,,Күн картасының баламасы
Dialogue: 0,0:20:36.90,0:20:37.77,Default,,0,0,0,,Иә
Dialogue: 0,0:20:37.86,0:20:40.69,Default,,0,0,0,,Берри гүлін қадағалаңыз.
Dialogue: 0,0:20:46.20,0:20:48.20,Default,,0,0,0,,Зұлым президент...
Dialogue: 0,0:20:48.28,0:20:50.83,Default,,0,0,0,,Маширо-санмен не істеуді жоспарлап отырсыз?
Dialogue: 0,0:20:50.91,0:20:52.21,Default,,0,0,0,,Санкция Хью мырзаға
Dialogue: 0,0:20:52.29,0:20:55.25,Default,,0,0,0,,Өзін сондай етіп көрсететін адам.
Dialogue: 0,0:20:55.33,0:20:56.33,Default,,0,0,0,,Бірақ
Dialogue: 0,0:20:56.42,0:21:00.13,Default,,0,0,0,,Зұлым фюрер Берриге не береді?
Dialogue: 0,0:21:00.63,0:21:02.34,Default,,0,0,0,,Бұл жаман, бірақ мен де сондаймын.
Dialogue: 0,0:21:09.97,0:21:14.10,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:21:14.56,0:21:18.52,Default,,0,0,0,,Бұл қалай іздегеніңізге таң қалдым.
Dialogue: 0,0:21:18.61,0:21:19.44,Default,,0,0,0,,Ах
Dialogue: 0,0:21:20.11,0:21:21.94,Default,,0,0,0,,Пісіру сенің хоббиің бе?
Dialogue: 0,0:21:22.44,0:21:23.53,Default,,0,0,0,,Басю мырза
Dialogue: 0,0:21:23.61,0:21:24.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:24.53,0:21:27.57,Default,,0,0,0,,Иә? Бұл кездейсоқтық
Dialogue: 0,0:21:27.66,0:21:30.24,Default,,0,0,0,,Біз мұнда қалай келдік?
Dialogue: 0,0:21:30.33,0:21:32.66,Default,,0,0,0,,Бұл не? сол шиеленіс
Dialogue: 0,0:21:33.12,0:21:35.71,Default,,0,0,0,,Маширо мырза, жидектер қиын.
Dialogue: 0,0:21:35.79,0:21:37.38,Default,,0,0,0,,Менімен бірге жүр
Dialogue: 0,0:21:37.83,0:21:38.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:42.30,0:21:45.05,Default,,0,0,0,,Мен онымен көп сөйлесемін.
Dialogue: 0,0:21:45.13,0:21:47.22,Default,,0,0,0,,Сіз де келесіз бе?
Dialogue: 0,0:21:47.30,0:21:48.72,Default,,0,0,0,,Е...
Dialogue: 0,0:21:48.80,0:21:50.05,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:50.14,0:21:52.72,Default,,0,0,0,,Бұл өте көңілді жер.
Dialogue: 0,0:21:54.23,0:21:55.73,Default,,0,0,0,,Менің қалағаным осы
Dialogue: 0,0:21:57.35,0:21:58.69,Default,,0,0,0,,Бұл үшін де төлеңіз.
Dialogue: 0,0:22:04.99,0:22:07.24,Default,,0,0,0,,♪～
Dialogue: 0,0:23:31.53,0:23:34.91,Default,,0,0,0,,～♪
