Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.96,0:00:05.67,Default,,0,0,0,,Бұл Чизуко күні.
Dialogue: 0,0:00:06.38,0:00:10.59,Default,,0,0,0,,Мен қазір Fossa Magna зұлым ұйымының қызметкерімін.
Dialogue: 0,0:00:10.67,0:00:13.47,Default,,0,0,0,,Өзенде зұлымдық қолбасшысымен ұйықтау
Dialogue: 0,0:00:13.55,0:00:15.30,Default,,0,0,0,,Эй, смартфоныңа қарама!
Dialogue: 0,0:00:15.39,0:00:17.39,Default,,0,0,0,,Мен дұрыс оянамын ба деп уайымдаймын.
Dialogue: 0,0:00:17.47,0:00:19.14,Default,,0,0,0,,Менің көзім жұмылды...
Dialogue: 0,0:00:19.22,0:00:20.43,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:00:20.52,0:00:23.19,Default,,0,0,0,,Сіз мұны кім үшін істеп жатырмын деп ойлайсыз?
Dialogue: 0,0:00:24.65,0:00:25.94,Default,,0,0,0,,Күн картасының баламасы
Dialogue: 0,0:00:26.02,0:00:27.69,Default,,0,0,0,,Жоқ, бұл штаб офицері Данте.
Dialogue: 0,0:00:27.77,0:00:29.90,Default,,0,0,0,,Мені ертең таңғы 4-те оят.
Dialogue: 0,0:00:29.98,0:00:31.86,Default,,0,0,0,,Не? Маған ұнамайды, дегенмен
Dialogue: 0,0:00:31.94,0:00:33.07,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:00:33.15,0:00:34.41,Default,,0,0,0,,Жидек гүліне
Dialogue: 0,0:00:34.49,0:00:36.82,Default,,0,0,0,,Мен саған ертеңгі күнәлар туралы хабарлама жібердім.
Dialogue: 0,0:00:36.91,0:00:38.83,Default,,0,0,0,,Оның жоспары бар.
Dialogue: 0,0:00:38.91,0:00:42.04,Default,,0,0,0,,Олар таңғы 4-те баруға болатынын айтты, бірақ мен оған көмектесе алмадым.
Dialogue: 0,0:00:42.12,0:00:44.33,Default,,0,0,0,,Шешілме, басынан баста.
Dialogue: 0,0:00:44.42,0:00:47.13,Default,,0,0,0,,Қандай жағдай болмасын сағат 4-те тұру үшін
Dialogue: 0,0:00:47.21,0:00:49.84,Default,,0,0,0,,Мен сізден қолыңыздан келгеннің бәрін істеуіңізді сұраймын, штаб офицері Данте.
Dialogue: 0,0:00:49.92,0:00:54.88,Default,,0,0,0,,Бұл адам штаб офицерін өз анасы деп ойласа керек...
Dialogue: 0,0:00:54.97,0:00:56.89,Default,,0,0,0,,Сондай-ақ, мен атадан сұраймын.
Dialogue: 0,0:00:56.97,0:00:58.22,Default,,0,0,0,,Окемару~
Dialogue: 0,0:00:58.30,0:00:59.35,Default,,0,0,0,,А...
Dialogue: 0,0:00:59.81,0:01:02.02,Default,,0,0,0,,Қызметкер, бұл маңызды емес.
Dialogue: 0,0:01:03.52,0:01:05.35,Default,,0,0,0,,Төбесі биік болды
Dialogue: 0,0:01:05.44,0:01:07.10,Default,,0,0,0,,Мен өзімді мазасыз сезінемін
Dialogue: 0,0:01:07.61,0:01:09.36,Default,,0,0,0,,Күн картасының баламасы
Dialogue: 0,0:01:09.90,0:01:11.19,Default,,0,0,0,,Сіз әлі ұйықтадыңыз ба?
Dialogue: 0,0:01:12.78,0:01:14.78,Default,,0,0,0,,Эй, сен ұйықтадың ба? Эй
Dialogue: 0,0:01:14.86,0:01:17.03,Default,,0,0,0,,А, мен ұйықтап қалдым, өйткені мен ұйықтадым.
Dialogue: 0,0:01:17.11,0:01:18.99,Default,,0,0,0,,Сіз ұйықтамайсыз, солай ма?
Dialogue: 0,0:01:19.07,0:01:20.49,Default,,0,0,0,,Хахаха
Dialogue: 0,0:01:20.58,0:01:22.45,Default,,0,0,0,,Көңіл көтерме!
Dialogue: 0,0:01:27.58,0:01:29.59,Default,,0,0,0,,(Қаңбақ қабығының дыбысы)
Dialogue: 0,0:01:29.59,0:01:30.59,Default,,0,0,0,,(Қаңбақ қабығының дыбысы)
Dialogue: 0,0:01:29.59,0:01:30.59,Default,,0,0,0,,Ия
Dialogue: 0,0:01:30.67,0:01:32.42,Default,,0,0,0,,Таң атты
Dialogue: 0,0:01:34.30,0:01:38.39,Default,,0,0,0,,Қараңызшы, Хрома мырза, ояусыз, ояусыз.
Dialogue: 0,0:01:39.85,0:01:41.60,Default,,0,0,0,,Иә
Dialogue: 0,0:01:41.68,0:01:44.60,Default,,0,0,0,,Бар болғаны саусақтарыңызды тартыңыз және киіміңізді ауыстырыңыз.
Dialogue: 0,0:01:45.18,0:01:48.10,Default,,0,0,0,,А... мүлде шырылдамайды.
Dialogue: 0,0:01:48.19,0:01:50.48,Default,,0,0,0,,Енді мен тіпті бұрмалай да алмаймын.
Dialogue: 0,0:01:50.56,0:01:52.73,Default,,0,0,0,,Оған көмектесу мүмкін емес
Dialogue: 0,0:01:53.36,0:01:55.86,Default,,0,0,0,,Мен сонда біраз уақыт боламын.
Dialogue: 0,0:01:57.86,0:01:58.95,Default,,0,0,0,,Қандай да бір себепті,
Dialogue: 0,0:01:59.03,0:02:01.99,Default,,0,0,0,,Қызметкерлердің біліктілігі жағынан өзімді атадан кем сезінемін.
Dialogue: 0,0:02:02.83,0:02:05.12,Default,,0,0,0,,Жүр, оян.
Dialogue: 0,0:02:05.20,0:02:08.25,Default,,0,0,0,,Бұл Якко үшін ұят болар еді...
Dialogue: 0,0:02:08.33,0:02:09.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:09.25,0:02:11.17,Default,,0,0,0,,Ояныңыз Берри!
Dialogue: 0,0:02:11.25,0:02:13.42,Default,,0,0,0,,Ааа...
Dialogue: 0,0:02:13.50,0:02:16.09,Default,,0,0,0,,Снек 300 иеннің орнына 1000 иен?
Dialogue: 0,0:02:16.17,0:02:19.05,Default,,0,0,0,,Бұл саяхат емес, орман мектебі!
Dialogue: 0,0:02:19.13,0:02:21.43,Default,,0,0,0,,Сонымен, Хрома келсе не істейсің?
Dialogue: 0,0:02:21.51,0:02:24.43,Default,,0,0,0,,Зұлым қолбасшы Фосса Магна туралы
Dialogue: 0,0:02:24.52,0:02:26.93,Default,,0,0,0,,Карри күріш
Dialogue: 0,0:02:34.90,0:02:38.95,Default,,0,0,0,,Бір-бірімізді көрмедік деп алайық.
Dialogue: 0,0:02:39.03,0:02:43.78,Default,,0,0,0,,♪～
Dialogue: 0,0:04:06.33,0:04:08.91,Default,,0,0,0,,～♪
Dialogue: 0,0:04:09.79,0:04:13.00,Default,,0,0,0,,Осымен аяқталады, Хрома командирі!
Dialogue: 0,0:04:15.17,0:04:16.88,Default,,0,0,0,,Кукукуку…
Dialogue: 0,0:04:16.96,0:04:18.59,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:04:19.05,0:04:20.13,Default,,0,0,0,,Жоғалып кетті ме?
Dialogue: 0,0:04:20.59,0:04:21.72,Default,,0,0,0,,Куку…
Dialogue: 0,0:04:21.80,0:04:24.47,Default,,0,0,0,,Енді ол келесі жерде қай жерде пайда болады деп ойлайсыз?
Dialogue: 0,0:04:24.55,0:04:26.76,Default,,0,0,0,,Ой, менің миыма...
Dialogue: 0,0:04:26.85,0:04:28.01,Default,,0,0,0,,Қорқақ!
Dialogue: 0,0:04:28.10,0:04:30.27,Default,,0,0,0,,Өзіңді көрсет!
Dialogue: 0,0:04:31.77,0:04:34.48,Default,,0,0,0,,Жарайды, әзірге бұл жоспарланғандай.
Dialogue: 0,0:04:34.56,0:04:36.94,Default,,0,0,0,,Мен штат қызметкері ретінде де әрекет ете аламын.
Dialogue: 0,0:04:37.02,0:04:39.02,Default,,0,0,0,,Бұл әрекетті сәтті орындаңыз
Dialogue: 0,0:04:39.11,0:04:41.94,Default,,0,0,0,,Жидек гүлі жарқырай берсін
Dialogue: 0,0:04:42.03,0:04:45.57,Default,,0,0,0,,Аю? Аю аю?
Dialogue: 0,0:04:45.66,0:04:46.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:46.74,0:04:49.83,Default,,0,0,0,,Олар да Хроманы іздеп жатқан жоқ па?
Dialogue: 0,0:04:49.91,0:04:51.29,Default,,0,0,0,,Иә
Dialogue: 0,0:04:49.91,0:04:51.29,Default,,0,0,0,,Жалаңаш аю?
Dialogue: 0,0:04:51.29,0:04:51.79,Default,,0,0,0,,Аю аю?
Dialogue: 0,0:04:51.87,0:04:53.62,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:04:53.71,0:04:56.17,Default,,0,0,0,,Ең дұрысы, қорқыңыз.
Dialogue: 0,0:04:56.25,0:04:57.46,Default,,0,0,0,,Қорықпа!
Dialogue: 0,0:04:57.96,0:05:00.96,Default,,0,0,0,,Осыған қарағанда, құбыжықтың алдында есеп беріңіз, оны дұрыс жасаңыз!
Dialogue: 0,0:05:01.05,0:05:03.76,Default,,0,0,0,,Аю аю... Аю?
Dialogue: 0,0:05:03.84,0:05:06.72,Default,,0,0,0,,Атмосферада біртүрлі нәрсе бар.
Dialogue: 0,0:05:06.80,0:05:09.26,Default,,0,0,0,,Жоспарлағандай жоғалып кеткеніне қуаныштымын...
Dialogue: 0,0:05:09.76,0:05:12.52,Default,,0,0,0,,Аю... Аю аю?
Dialogue: 0,0:05:12.52,0:05:13.64,Default,,0,0,0,,Аю... Аю аю?
Dialogue: 0,0:05:12.52,0:05:13.64,Default,,0,0,0,,баяу
Dialogue: 0,0:05:13.64,0:05:14.10,Default,,0,0,0,,Аю... Аю аю?
Dialogue: 0,0:05:14.18,0:05:16.77,Default,,0,0,0,,Хрома, тез кел.
Dialogue: 0,0:05:16.85,0:05:17.98,Default,,0,0,0,,Chroma...
Dialogue: 0,0:05:18.48,0:05:20.07,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:05:20.61,0:05:24.32,Default,,0,0,0,,Осыдан кейін айналып өтіп, соқыр жерден шабуыл жасаңыз.
Dialogue: 0,0:05:24.78,0:05:26.45,Default,,0,0,0,,Қайда? хрома
Dialogue: 0,0:05:26.53,0:05:28.53,Default,,0,0,0,,Читоко күнін күткеніңізге рахмет
Dialogue: 0,0:05:28.62,0:05:29.45,Default,,0,0,0,,Chroma!
Dialogue: 0,0:05:30.33,0:05:31.74,Default,,0,0,0,,Жаяу саяхат!?
Dialogue: 0,0:05:31.83,0:05:34.91,Default,,0,0,0,,Сиқырлы күшімді сақтауға тырысамын...
Dialogue: 0,0:05:35.46,0:05:36.96,Default,,0,0,0,,Гехо...
Dialogue: 0,0:05:37.04,0:05:37.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:37.96,0:05:40.34,Default,,0,0,0,,Менің жағым ауырып тұр...
Dialogue: 0,0:05:40.42,0:05:43.96,Default,,0,0,0,,Келесі - соқыр жерден шабуыл, солай ма?
Dialogue: 0,0:05:44.51,0:05:45.67,Default,,0,0,0,,Әрине.
Dialogue: 0,0:05:45.76,0:05:48.72,Default,,0,0,0,,Ақылды шеш, Чизуко Дате.
Dialogue: 0,0:05:50.39,0:05:51.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:52.47,0:05:53.64,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:53.72,0:05:55.43,Default,,0,0,0,,Бұл... Жақсысың ба?
Dialogue: 0,0:05:55.52,0:05:57.10,Default,,0,0,0,,Жағдай жұтылды ма?
Dialogue: 0,0:05:57.73,0:05:59.86,Default,,0,0,0,,Менің Ичичора...
Dialogue: 0,0:05:59.94,0:06:02.98,Default,,0,0,0,,Сіз онымен осылайша балшықпен шайқаспақсыз ба?
Dialogue: 0,0:06:03.07,0:06:05.36,Default,,0,0,0,,Егер сіз мұны істесеңіз...
Dialogue: 0,0:06:05.44,0:06:06.53,Default,,0,0,0,,Хмм? иә?
Dialogue: 0,0:06:06.53,0:06:08.36,Default,,0,0,0,,Хмм? иә?
Dialogue: 0,0:06:06.53,0:06:08.36,Default,,0,0,0,,Жидек гүліне
Dialogue: 0,0:06:08.45,0:06:09.24,Default,,0,0,0,,Айырмашылықты оңай анықтау Сізге мұны істеуге тура келеді!
Dialogue: 0,0:06:09.24,0:06:10.82,Default,,0,0,0,,Айырмашылықты оңай анықтау Сізге мұны істеуге тура келеді!
Dialogue: 0,0:06:09.24,0:06:10.82,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:10.82,0:06:12.12,Default,,0,0,0,,Айырмашылықты оңай анықтау Сізге мұны істеуге тура келеді!
Dialogue: 0,0:06:12.20,0:06:15.00,Default,,0,0,0,,Қарғыс атсын, не істеуім керек...
Dialogue: 0,0:06:16.75,0:06:17.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:19.58,0:06:21.00,Default,,0,0,0,,Ах
Dialogue: 0,0:06:21.09,0:06:23.34,Default,,0,0,0,,Ай Бүгін кешкі асқа не бар?
Dialogue: 0,0:06:23.34,0:06:23.80,Default,,0,0,0,,Ай Бүгін кешкі асқа не бар?
Dialogue: 0,0:06:23.34,0:06:23.80,Default,,0,0,0,,(шу)
Dialogue: 0,0:06:23.80,0:06:24.59,Default,,0,0,0,,(шу)
Dialogue: 0,0:06:24.67,0:06:25.51,Default,,0,0,0,,Джова!
Dialogue: 0,0:06:25.59,0:06:28.01,Default,,0,0,0,,Кір жуғыш машинаңды маған қарызға бер, кішкентайым!
Dialogue: 0,0:06:28.09,0:06:30.51,Default,,0,0,0,,Нанана... Бұл не!?
Dialogue: 0,0:06:32.47,0:06:33.89,Default,,0,0,0,,Сен эмоцияларыңды басқара алмайсың ғана емес, сонымен бірге тәуекелден қорқатын, өзін-өзі сақтауға бағытталған ой-санамен әрекет етесің.
Dialogue: 0,0:06:33.97,0:06:35.35,Default,,0,0,0,,Сол тамаша плащ
Dialogue: 0,0:06:35.43,0:06:37.64,Default,,0,0,0,,Мен оны жарқырағанша жуамын.
Dialogue: 0,0:06:37.73,0:06:41.02,Default,,0,0,0,,Бұл керемет кір жуғыш машина ерекше ерекше!
Dialogue: 0,0:06:41.11,0:06:42.94,Default,,0,0,0,,Өкесі: 2-сынып баласы?
Dialogue: 0,0:06:43.02,0:06:44.53,Default,,0,0,0,,Не!?
Dialogue: 0,0:06:44.61,0:06:47.36,Default,,0,0,0,,Бұл әкеңнің мақтан тұтатын туындысы.
Dialogue: 0,0:06:47.86,0:06:49.24,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:06:49.32,0:06:52.12,Default,,0,0,0,,Ай Ең әдемі курс
Dialogue: 0,0:06:52.20,0:06:53.87,Default,,0,0,0,,«Нөлдік кір»
Dialogue: 0,0:06:53.95,0:06:56.87,Default,,0,0,0,,«Бәрінің есебінен» курсы
Dialogue: 0,0:06:56.95,0:06:58.87,Default,,0,0,0,,Пәннің атауы Қорқынышты
Dialogue: 0,0:06:59.33,0:07:00.96,Default,,0,0,0,,Кокоа-чанға рахмет
Dialogue: 0,0:07:01.04,0:07:02.33,Default,,0,0,0,,Хехехе
Dialogue: 0,0:07:02.42,0:07:05.30,Default,,0,0,0,,Ең жақсы жағдайда мен сізге жақсылық жасай аламын.
Dialogue: 0,0:07:05.38,0:07:07.67,Default,,0,0,0,,Бұл дұрыс болды, Кокоа-сама.
Dialogue: 0,0:07:07.76,0:07:09.72,Default,,0,0,0,,Мен әлі тұлып үшін алғыс айтқан жоқпын.
Dialogue: 0,0:07:09.80,0:07:10.93,Default,,0,0,0,,Ай!
Dialogue: 0,0:07:11.01,0:07:12.43,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:07:12.51,0:07:15.39,Default,,0,0,0,,Хехехе... Сиқырлы қыздар!
Dialogue: 0,0:07:16.64,0:07:20.52,Default,,0,0,0,,Бұл әлі де біраз уақыт алады, сондықтан уақытыңызды бір жерде өлтіре аласыз.
Dialogue: 0,0:07:20.60,0:07:22.02,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:22.77,0:07:24.15,Default,,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:07:24.69,0:07:28.36,Default,,0,0,0,,Сиқырлы күш сын сағаттарда пайдасыз, солай емес пе?
Dialogue: 0,0:07:28.44,0:07:30.95,Default,,0,0,0,,Бұны естіген Бас қолбасшы таң қалады.
Dialogue: 0,0:07:31.53,0:07:33.99,Default,,0,0,0,,Кішкентайдың айтқаны дұрыс.
Dialogue: 0,0:07:34.07,0:07:37.20,Default,,0,0,0,,Төтенше жағдайда сиқырлы күш пайдасыз.
Dialogue: 0,0:07:37.29,0:07:41.83,Default,,0,0,0,,Сондықтан мен адамдарға көп сенемін.
Dialogue: 0,0:07:42.42,0:07:45.67,Default,,0,0,0,,Өтінемін, бұл жақсы әңгіме сияқты бос сөз айтпаңыз.
Dialogue: 0,0:07:45.75,0:07:47.21,Default,,0,0,0,,Анықталды
Dialogue: 0,0:07:47.30,0:07:49.67,Default,,0,0,0,,...
Dialogue: 0,0:07:49.76,0:07:51.09,Default,,0,0,0,,Бұл не, Чизу Дата...
Dialogue: 0,0:07:51.18,0:07:52.47,Default,,0,0,0,,U.A. Спорттық күні тез арада келіп жетті
Dialogue: 0,0:07:55.97,0:07:59.77,Default,,0,0,0,,S... Жуу үшін қажетті жарық мөлшері емес.
Dialogue: 0,0:07:59.85,0:08:01.19,Default,,0,0,0,,(Кір жуғыш машинаның аяқталу дыбысы)
Dialogue: 0,0:08:01.19,0:08:02.06,Default,,0,0,0,,(Кір жуғыш машинаның аяқталу дыбысы)
Dialogue: 0,0:08:01.19,0:08:02.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:04.19,0:08:06.19,Default,,0,0,0,,Жоқ... бұл өтірік
Dialogue: 0,0:08:07.94,0:08:09.40,Default,,0,0,0,,Неге...
Dialogue: 0,0:08:10.24,0:08:12.45,Default,,0,0,0,,Бұл көмір емес пе?
Dialogue: 0,0:08:12.53,0:08:14.53,Default,,0,0,0,,Бірақ кір шығып жатыр.
Dialogue: 0,0:08:14.62,0:08:17.91,Default,,0,0,0,,Одан да маңызды нәрсе жоғалып кетті!
Dialogue: 0,0:08:17.99,0:08:19.83,Default,,0,0,0,,Өйткені бұл курс.
Dialogue: 0,0:08:19.91,0:08:20.91,Default,,0,0,0,,Қыңыр…
Dialogue: 0,0:08:21.00,0:08:24.04,Default,,0,0,0,,Біз бірдей нәрсені жасаймыз ба?
Dialogue: 0,0:08:24.12,0:08:26.17,Default,,0,0,0,,Мен ыңғайлымын, сондықтан
Dialogue: 0,0:08:28.92,0:08:30.34,Default,,0,0,0,,Өте шебер!
Dialogue: 0,0:08:30.42,0:08:31.67,Default,,0,0,0,,О~
Dialogue: 0,0:08:34.89,0:08:36.18,Default,,0,0,0,,Дайын
Dialogue: 0,0:08:36.93,0:08:40.52,Default,,0,0,0,,Мен оны визуалды жады негізінде жасадым, сондықтан қате жоқ деп ойлаймын.
Dialogue: 0,0:08:40.60,0:08:41.89,Default,,0,0,0,,О~
Dialogue: 0,0:08:41.98,0:08:44.90,Default,,0,0,0,,Егер сен сондай өнерлі болсаң, дұрыстап жуғаныңды қалаймын.
Dialogue: 0,0:08:44.98,0:08:47.23,Default,,0,0,0,,Әй, тозығы жеткен
Dialogue: 0,0:08:47.73,0:08:49.27,Default,,0,0,0,,Сәл күтіңіз.
Dialogue: 0,0:08:50.82,0:08:53.57,Default,,0,0,0,,Құрметті Хрома, сіздің сүйікті жануарыңыз қандай?
Dialogue: 0,0:08:53.65,0:08:55.91,Default,,0,0,0,,Не? Бұл аю...
Dialogue: 0,0:08:56.82,0:08:58.49,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:09:01.75,0:09:02.75,Default,,0,0,0,,Ой
Dialogue: 0,0:09:02.83,0:09:04.62,Default,,0,0,0,,Мынау, кішкентайым.
Dialogue: 0,0:09:04.71,0:09:06.42,Default,,0,0,0,,Және Дата Чизуко
Dialogue: 0,0:09:08.09,0:09:12.01,Default,,0,0,0,,Сайып келгенде, адамдар сенуге болады
Dialogue: 0,0:09:13.59,0:09:16.68,Default,,0,0,0,,Бұзған да сол.
Dialogue: 0,0:09:20.85,0:09:22.27,Default,,0,0,0,,Кухаха…
Dialogue: 0,0:09:22.35,0:09:24.31,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз, Берри Блоссом.
Dialogue: 0,0:09:24.39,0:09:25.52,Default,,0,0,0,,О, осында.
Dialogue: 0,0:09:30.65,0:09:33.28,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,0:09:34.24,0:09:36.66,Default,,0,0,0,,Не? Сол сәнді аппликация
Dialogue: 0,0:09:36.74,0:09:38.07,Default,,0,0,0,,Алғашқы көмек көрсету шарасы ретінде
Dialogue: 0,0:09:38.16,0:09:40.16,Default,,0,0,0,,Сіздің күш-жігеріңіздің фокусы өшірілді.
Dialogue: 0,0:09:41.70,0:09:44.33,Default,,0,0,0,,Үстінде қоңыр түсті бірдеңе бар.
Dialogue: 0,0:09:44.41,0:09:45.58,Default,,0,0,0,,Бұл балшық па?
Dialogue: 0,0:09:45.66,0:09:48.46,Default,,0,0,0,,Бұл жаман. Сіз оны дұрыс жууыңыз керек.
Dialogue: 0,0:09:48.54,0:09:50.92,Default,,0,0,0,,Адамдар мұны лайлы кір деп ойлайды.
Dialogue: 0,0:09:51.00,0:09:53.05,Default,,0,0,0,,Менің бұрынғы жігітім де, балаларым да жоқ.
Dialogue: 0,0:09:54.63,0:09:57.59,Default,,0,0,0,,Мүлдем... Кірді дұрыс жуыңыз.
Dialogue: 0,0:10:02.93,0:10:05.77,Default,,0,0,0,,Сен не айтып тұрсың, Чизуко Дате?
Dialogue: 0,0:10:05.85,0:10:07.02,Default,,0,0,0,,Тауық еті
Dialogue: 0,0:10:07.10,0:10:09.23,Default,,0,0,0,,Кешкі асқа қуырылған тауық етін жеймін деп ойладым.
Dialogue: 0,0:10:09.31,0:10:11.06,Default,,0,0,0,,О, қуырылған тауық!
Dialogue: 0,0:10:11.15,0:10:13.69,Default,,0,0,0,,Сіз бүгін тағы да Берри Блоссоммен бәсекеге түсесіз, солай ма?
Dialogue: 0,0:10:13.78,0:10:15.74,Default,,0,0,0,,Бұған дейін тауық етін дәмдеңіз...
Dialogue: 0,0:10:16.28,0:10:17.74,Default,,0,0,0,,Аа, менде крахмал ұнтағы жоқ.
Dialogue: 0,0:10:17.82,0:10:19.70,Default,,0,0,0,,Оған көмектесу мүмкін емес. Мен оны әдеттегідей пісіруім керек пе?
Dialogue: 0,0:10:19.78,0:10:20.62,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:10:20.70,0:10:23.24,Default,,0,0,0,,Адамдарды қуырылған тауық етін күту мен қуырмаудың айырмашылығы неде?
Dialogue: 0,0:10:23.33,0:10:24.87,Default,,0,0,0,,Жамандықтың да шегі бар!
Dialogue: 0,0:10:24.95,0:10:27.46,Default,,0,0,0,,Өйткені менің енді дүкен аралауға уақытым жоқ.
Dialogue: 0,0:10:27.54,0:10:29.50,Default,,0,0,0,,Аю құбыжығынан тапсырма орындауын сұраңыз
Dialogue: 0,0:10:29.58,0:10:30.46,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:10:30.96,0:10:31.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:33.34,0:10:34.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:35.92,0:10:38.34,Default,,0,0,0,,Ааааах!
Dialogue: 0,0:10:38.43,0:10:39.38,Default,,0,0,0,,Не!?
Dialogue: 0,0:10:39.47,0:10:41.35,Default,,0,0,0,,Кума құбыжығы... Кума құбыжығы!
Dialogue: 0,0:10:41.43,0:10:43.35,Default,,0,0,0,,Мен үйден қашып кеттім!
Dialogue: 0,0:10:43.43,0:10:44.81,Default,,0,0,0,,Үйден қашу...
Dialogue: 0,0:10:44.89,0:10:46.85,Default,,0,0,0,,Бірақ неге олай?
Dialogue: 0,0:10:46.93,0:10:48.35,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:10:48.44,0:10:50.06,Default,,0,0,0,,Бұл менің бірінші рет
Dialogue: 0,0:10:58.95,0:11:01.62,Default,,0,0,0,,Біз кішкентай кезімізден біргеміз.
Dialogue: 0,0:11:03.70,0:11:07.29,Default,,0,0,0,,Хмм, бұл да себеп болған сияқты.
Dialogue: 0,0:11:07.37,0:11:09.50,Default,,0,0,0,,Әйтеуір, қонжық құбыжықты тауып алайық.
Dialogue: 0,0:11:09.58,0:11:12.21,Default,,0,0,0,,Мен Берри Блоссомды аяймын.
Dialogue: 0,0:11:12.29,0:11:14.46,Default,,0,0,0,,Мен олардан бүгін менсіз істеуді өтіндім.
Dialogue: 0,0:11:15.13,0:11:16.76,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:11:20.47,0:11:21.72,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:21.80,0:11:24.60,Default,,0,0,0,,Сіз өте жағымсыз нәрселер жасайсыз, солай ма?
Dialogue: 0,0:11:24.68,0:11:26.01,Default,,0,0,0,,Құрметті Хрома
Dialogue: 0,0:11:26.10,0:11:29.60,Default,,0,0,0,,Келесі күні біз бір күн бұрын таңғы 4-те кездесеміз.
Dialogue: 0,0:11:29.68,0:11:31.90,Default,,0,0,0,,Келесі жолы бізді көп күттіріңіз.
Dialogue: 0,0:11:31.98,0:11:34.15,Default,,0,0,0,,Бұл жолы мен кенеттен бас тарттым.
Dialogue: 0,0:11:34.23,0:11:36.02,Default,,0,0,0,,Сіз шынымен жақсы жағдайдасыз.
Dialogue: 0,0:11:36.11,0:11:37.53,Default,,0,0,0,,(Қоңырау ажыратылған дыбыс)
Dialogue: 0,0:11:37.61,0:11:38.82,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:11:38.90,0:11:40.28,Default,,0,0,0,,Біз бүгін күресуіміз керек
Dialogue: 0,0:11:40.36,0:11:43.03,Default,,0,0,0,,Келесі жолы төбелесе алмауыңыз мүмкін.
Dialogue: 0,0:11:43.12,0:11:46.28,Default,,0,0,0,,Қарсы жақтың ашуы түсінікті.
Dialogue: 0,0:11:46.37,0:11:48.79,Default,,0,0,0,,Олай болса мен аю құбыжығын іздеймін.
Dialogue: 0,0:11:48.87,0:11:51.16,Default,,0,0,0,,Жоқ, мен барамын.
Dialogue: 0,0:11:51.25,0:11:54.17,Default,,0,0,0,,Бұл жерде Кума Монстр үшін ештеңе істемесек.
Dialogue: 0,0:11:54.25,0:11:58.09,Default,,0,0,0,,Олар маған өте жақсы болады
Dialogue: 0,0:11:58.17,0:12:00.34,Default,,0,0,0,,Мен көп жұмыс істегендіктен әйелім мені тастап кетті.
Dialogue: 0,0:12:00.42,0:12:02.43,Default,,0,0,0,,Күйеу сияқты сөйлеп тұрсың.
Dialogue: 0,0:12:02.51,0:12:05.43,Default,,0,0,0,,Бірақ Берри Блоссоммен шайқас...
Dialogue: 0,0:12:05.51,0:12:07.39,Default,,0,0,0,,Менің мұны істеуден басқа амалым жоқ.
Dialogue: 0,0:12:07.47,0:12:08.31,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:12:08.39,0:12:10.31,Default,,0,0,0,,Не? Уау...
Dialogue: 0,0:12:10.89,0:12:12.77,Default,,0,0,0,,Оу!
Dialogue: 0,0:12:12.85,0:12:14.06,Default,,0,0,0,,Ой
Dialogue: 0,0:12:23.36,0:12:24.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:24.57,0:12:26.95,Default,,0,0,0,,Жоқ... Бұл не?!
Dialogue: 0,0:12:27.45,0:12:28.95,Default,,0,0,0,,Сізге жақсы көрінеді
Dialogue: 0,0:12:29.04,0:12:32.21,Default,,0,0,0,,Оны маған шебер біреу жасағаны дұрыс болды.
Dialogue: 0,0:12:32.29,0:12:34.21,Default,,0,0,0,,Мен жасадым
Dialogue: 0,0:12:34.29,0:12:36.00,Default,,0,0,0,,Не, бұл...
Dialogue: 0,0:12:36.08,0:12:38.21,Default,,0,0,0,,Амал жоқ... Амал жоқ, болмайды
Dialogue: 0,0:12:38.30,0:12:40.26,Default,,0,0,0,,Жоқ
Dialogue: 0,0:12:40.34,0:12:42.38,Default,,0,0,0,,Бұл сіздің бірінші шайқасыңыз, Чизуко Дате.
Dialogue: 0,0:12:42.47,0:12:45.26,Default,,0,0,0,,Жоқ, штаб офицері Данте!
Dialogue: 0,0:12:46.09,0:12:47.51,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:12:47.60,0:12:51.89,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:12:58.27,0:12:59.98,Default,,0,0,0,,Ах, Дата мырза
Dialogue: 0,0:13:00.53,0:13:03.74,Default,,0,0,0,,Мен Берри Блоссоммен тікелей соқтығысамын...
Dialogue: 0,0:13:04.32,0:13:06.49,Default,,0,0,0,,Берри штат офицері Данте ретінде танылды
Dialogue: 0,0:13:06.57,0:13:06.99,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:13:06.99,0:13:08.49,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:13:06.99,0:13:08.49,Default,,0,0,0,,Берримен сөйлесу
Dialogue: 0,0:13:08.58,0:13:09.58,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:13:08.58,0:13:09.58,Default,,0,0,0,,Жидектер шабуылдады...
Dialogue: 0,0:13:09.58,0:13:09.66,Default,,0,0,0,,Жидектер шабуылдады...
Dialogue: 0,0:13:09.66,0:13:10.99,Default,,0,0,0,,Жидектер шабуылдады...
Dialogue: 0,0:13:09.66,0:13:10.99,Default,,0,0,0,,Оянып қалдым да, бүкіл денем ауырады~!
Dialogue: 0,0:13:11.08,0:13:13.96,Default,,0,0,0,,Ой... ау, болмайды!
Dialogue: 0,0:13:14.92,0:13:17.25,Default,,0,0,0,,Жоқ, мұны істеуден басқа амалым жоқ.
Dialogue: 0,0:13:17.33,0:13:18.42,Default,,0,0,0,,Өйткені
Dialogue: 0,0:13:19.04,0:13:21.71,Default,,0,0,0,,Жидек гүлінің жылтырлығы
Dialogue: 0,0:13:21.80,0:13:23.05,Default,,0,0,0,,Менің...
Dialogue: 0,0:13:23.67,0:13:25.43,Default,,0,0,0,,Менің...
Dialogue: 0,0:13:26.13,0:13:26.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:27.05,0:13:29.14,Default,,0,0,0,,О? Чизуко-сан
Dialogue: 0,0:13:29.22,0:13:30.22,Default,,0,0,0,,Әке?
Dialogue: 0,0:13:30.31,0:13:32.14,Default,,0,0,0,,Жоқ... мұнда не үшін келдің?
Dialogue: 0,0:13:32.22,0:13:33.23,Default,,0,0,0,,Әйтеуір
Dialogue: 0,0:13:33.31,0:13:36.69,Default,,0,0,0,,Мұнда сіз Хрома мен оның достарының төбелесіп жатқанын көре аласыз.
Dialogue: 0,0:13:36.77,0:13:37.60,Default,,0,0,0,,Интуиция!?
Dialogue: 0,0:13:37.69,0:13:41.27,Default,,0,0,0,,Жоқ, себебі Chroma-да бірдеңе бар.
Dialogue: 0,0:13:41.36,0:13:42.73,Default,,0,0,0,,Мен сенің орынбасарың боламын...
Dialogue: 0,0:13:42.82,0:13:44.28,Default,,0,0,0,,Ауыстыру?
Dialogue: 0,0:13:44.36,0:13:47.20,Default,,0,0,0,,Бірақ Чизуко әлі бала.
Dialogue: 0,0:13:47.28,0:13:48.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:48.74,0:13:52.95,Default,,0,0,0,,Маған күш берсең, мен кез келген уақытта соғысуға бара аламын.
Dialogue: 0,0:13:53.04,0:13:54.16,Default,,0,0,0,,Иа (Картадағы бала) Ой...
Dialogue: 0,0:13:54.25,0:13:56.96,Default,,0,0,0,,Менің биологиялық әкем менің лауазымымды мақсат етіп отыр.
Dialogue: 0,0:13:57.42,0:13:58.12,Default,,0,0,0,,Бірақ ол, әрине, штаб офицеріне ұқсайды.
Dialogue: 0,0:13:58.12,0:14:00.67,Default,,0,0,0,,Бірақ ол, әрине, штаб офицеріне ұқсайды.
Dialogue: 0,0:13:58.12,0:14:00.67,Default,,0,0,0,,Ақыл-ой сынақтарының атымен—
Dialogue: 0,0:14:00.75,0:14:03.17,Default,,0,0,0,,Мұғалім болғандықтан, ол да ақылды...
Dialogue: 0,0:14:05.97,0:14:06.84,Default,,0,0,0,,Уф
Dialogue: 0,0:14:06.93,0:14:09.18,Default,,0,0,0,,Менің туысқанымның кадрлық қабілеті неге жоғары!?
Dialogue: 0,0:14:09.76,0:14:12.43,Default,,0,0,0,,Қарсы болмасаңыз, Хрома мырзаға хабарласыңыз.
Dialogue: 0,0:14:12.89,0:14:14.02,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:14:14.52,0:14:16.98,Default,,0,0,0,,Сиқырлы жидек гүлімен күресу
Dialogue: 0,0:14:18.69,0:14:21.90,Default,,0,0,0,,Өйткені бұл Fossa Magna қызметкері Данте!
Dialogue: 0,0:14:21.98,0:14:23.11,Default,,0,0,0,,О~
Dialogue: 0,0:14:21.98,0:14:23.11,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:14:23.11,0:14:23.19,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:14:23.19,0:14:25.86,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:14:23.19,0:14:25.86,Default,,0,0,0,,Чизуко-сан, сен сиқырлы қызсың, солай ма?
Dialogue: 0,0:14:25.94,0:14:26.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:26.86,0:14:28.53,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:14:29.03,0:14:30.28,Default,,0,0,0,,Олай емес пе?
Dialogue: 0,0:14:30.37,0:14:33.12,Default,,0,0,0,,Ол өзгере алады және ол қыз, сондықтан бұл анық...
Dialogue: 0,0:14:33.20,0:14:34.79,Default,,0,0,0,,Былайғы түйіндерді тоқтатыңыз!
Dialogue: 0,0:14:34.87,0:14:36.91,Default,,0,0,0,,Қараңдаршы, менде де таяқ бар.
Dialogue: 0,0:14:37.00,0:14:37.83,Default,,0,0,0,,Иә!?
Dialogue: 0,0:14:37.91,0:14:39.87,Default,,0,0,0,,Менде таяқ бар, ол не?
Dialogue: 0,0:14:39.96,0:14:42.54,Default,,0,0,0,,Олар бір-біріне ұқсайды, сондықтан мен білмеймін.
Dialogue: 0,0:14:42.63,0:14:43.84,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:14:43.92,0:14:47.51,Default,,0,0,0,,Бұл мүлдем басқа, бірақ...
Dialogue: 0,0:14:47.59,0:14:49.93,Default,,0,0,0,,Сиқырлы қыздар...
Dialogue: 0,0:14:50.01,0:14:51.76,Default,,0,0,0,,Сиқырлы қыз дегеніміз не?
Dialogue: 0,0:14:52.51,0:14:54.01,Default,,0,0,0,,Карен
Dialogue: 0,0:14:54.64,0:14:56.27,Default,,0,0,0,,Салқын
Dialogue: 0,0:14:56.77,0:14:57.85,Default,,0,0,0,,Бұл Агент Твайлайт басқаратын академия ма?
Dialogue: 0,0:14:58.81,0:15:00.31,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:00.77,0:15:05.19,Default,,0,0,0,,Берри гүлі туралы айтып отырсыз ба?
Dialogue: 0,0:15:05.73,0:15:08.90,Default,,0,0,0,,Мен қажет емес нәрсе айтқан сияқтымын.
Dialogue: 0,0:15:08.99,0:15:10.20,Default,,0,0,0,,Хаха
Dialogue: 0,0:15:12.32,0:15:13.24,Default,,0,0,0,,Я...
Dialogue: 0,0:15:13.33,0:15:17.37,Default,,0,0,0,,Ууу!
Dialogue: 0,0:15:17.45,0:15:19.46,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:15:21.21,0:15:22.54,Default,,0,0,0,,Бұл бала кім...
Dialogue: 0,0:15:22.63,0:15:25.96,Default,,0,0,0,,Ол Фосса Магна штатының офицері Данте
Dialogue: 0,0:15:26.05,0:15:28.09,Default,,0,0,0,,Мен әкемін
Dialogue: 0,0:15:28.17,0:15:30.09,Default,,0,0,0,,Ата-аналар ертіп барады!?
Dialogue: 0,0:15:30.18,0:15:33.76,Default,,0,0,0,,Ууу!
Dialogue: 0,0:15:33.85,0:15:38.35,Default,,0,0,0,,Ал штаб офицері өз-өзінен тыс қалған сияқты.
Dialogue: 0,0:15:38.43,0:15:40.19,Default,,0,0,0,,Егер сіз біреуді осылай ұрсаңыз...
Dialogue: 0,0:15:40.85,0:15:43.15,Default,,0,0,0,,Мен сенен үндемеуіңді сұраймын!
Dialogue: 0,0:15:45.32,0:15:46.36,Default,,0,0,0,,Жоғалып кетті!?
Dialogue: 0,0:15:46.44,0:15:50.74,Default,,0,0,0,,Сиқырлы күш шынымен ашуланғанда бақылаудан шығып кетуі мүмкін.
Dialogue: 0,0:15:50.82,0:15:51.24,Default,,0,0,0,,Нуаа!
Dialogue: 0,0:15:51.24,0:15:53.66,Default,,0,0,0,,Нуаа!
Dialogue: 0,0:15:51.24,0:15:53.66,Default,,0,0,0,,Сізге айтпағаным үшін кешіріңіз.
Dialogue: 0,0:15:53.74,0:15:55.83,Default,,0,0,0,,Ахххх...
Dialogue: 0,0:15:58.50,0:16:00.33,Default,,0,0,0,,Штаб офицері Данте
Dialogue: 0,0:16:00.41,0:16:02.21,Default,,0,0,0,,Chroma!?
Dialogue: 0,0:16:00.41,0:16:02.21,Default,,0,0,0,,О...
Dialogue: 0,0:16:02.29,0:16:03.83,Default,,0,0,0,,А... а...
Dialogue: 0,0:16:04.42,0:16:05.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:05.42,0:16:06.46,Default,,0,0,0,,Бұл...
Dialogue: 0,0:16:06.54,0:16:08.21,Default,,0,0,0,,Бұл әлі шешілген жоқ.
Dialogue: 0,0:16:09.51,0:16:13.26,Default,,0,0,0,,Уау...
Dialogue: 0,0:16:13.34,0:16:14.34,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:16:20.39,0:16:22.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:23.90,0:16:28.94,Default,,0,0,0,,(Дантенің ауыр тыныс алуы)
Dialogue: 0,0:16:29.03,0:16:31.61,Default,,0,0,0,,Хрома Кума Кайдзин ше?
Dialogue: 0,0:16:31.70,0:16:33.61,Default,,0,0,0,,Әлі табылмады
Dialogue: 0,0:16:34.07,0:16:34.95,Default,,0,0,0,,Бірақ
Dialogue: 0,0:16:35.03,0:16:37.83,Default,,0,0,0,,Кадрлық дағдарысты назардан тыс қалдырмайтын сияқтысыз.
Dialogue: 0,0:16:37.91,0:16:40.66,Default,,0,0,0,,Оны зұлымдықтың иесі деуге болмайды.
Dialogue: 0,0:16:43.33,0:16:45.25,Default,,0,0,0,,Кеттік, Берри гүлі!
Dialogue: 0,0:16:52.34,0:16:54.93,Default,,0,0,0,,Мен сиқырды көп қолдандым ба?
Dialogue: 0,0:16:55.97,0:16:58.64,Default,,0,0,0,,Нахахаха, сен сондай тозғансың!
Dialogue: 0,0:16:58.72,0:17:00.52,Default,,0,0,0,,Эй, Маширо, кел!
Dialogue: 0,0:17:00.60,0:17:01.43,Default,,0,0,0,,Мен!
Dialogue: 0,0:17:02.23,0:17:04.48,Default,,0,0,0,,Тым ақсақ...
Dialogue: 0,0:17:05.73,0:17:08.27,Default,,0,0,0,,Қызметкерлерге көмектесуден алыс
Dialogue: 0,0:17:08.36,0:17:11.11,Default,,0,0,0,,Мен қанағаттанарлықтай қолымнан ештеңе ала алмаймын.
Dialogue: 0,0:17:11.19,0:17:13.86,Default,,0,0,0,,Сондықтан аю құбыжығы да бар...
Dialogue: 0,0:17:17.24,0:17:18.24,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:17:17.24,0:17:18.24,Default,,0,0,0,,Уау...
Dialogue: 0,0:17:18.24,0:17:18.32,Default,,0,0,0,,Уау...
Dialogue: 0,0:17:18.32,0:17:19.99,Default,,0,0,0,,Уау...
Dialogue: 0,0:17:18.32,0:17:19.99,Default,,0,0,0,,... Жібер, Данте!
Dialogue: 0,0:17:19.99,0:17:20.08,Default,,0,0,0,,Уау...
Dialogue: 0,0:17:20.08,0:17:22.25,Default,,0,0,0,,Уау...
Dialogue: 0,0:17:20.08,0:17:22.25,Default,,0,0,0,,Бос емес болсаңыз да қауіпті!
Dialogue: 0,0:17:22.33,0:17:24.87,Default,,0,0,0,,Ууу...
Dialogue: 0,0:17:25.42,0:17:27.00,Default,,0,0,0,,Сонда біз күресе аламыз.
Dialogue: 0,0:17:28.46,0:17:30.38,Default,,0,0,0,,Бұл ақсақ емес
Dialogue: 0,0:17:30.46,0:17:34.30,Default,,0,0,0,,Сіз ұялшақ болғандықтан өзіңізді ақсап сезінесіз.
Dialogue: 0,0:17:37.09,0:17:41.60,Default,,0,0,0,,Берри гүлі де Шаба Шабаның шабуылына ұшырайды.
Dialogue: 0,0:17:41.68,0:17:43.85,Default,,0,0,0,,Мен қарадым...
Dialogue: 0,0:17:46.73,0:17:47.56,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:51.90,0:17:56.03,Default,,0,0,0,,Менің сенімім жоғалған сияқты.
Dialogue: 0,0:17:56.57,0:17:58.32,Default,,0,0,0,,Бірақ біз өзгеруіміз керек
Dialogue: 0,0:17:58.41,0:18:02.08,Default,,0,0,0,,Мен қызметкерлердің маған тым жақсы болғанын қаламаймын.
Dialogue: 0,0:18:02.79,0:18:04.75,Default,,0,0,0,,Мен неге екенін түсінбеймін
Dialogue: 0,0:18:04.83,0:18:07.46,Default,,0,0,0,,Жамандықтың көсемі кәдімгі көңіл күйінде.
Dialogue: 0,0:18:07.54,0:18:08.50,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:18:08.96,0:18:10.96,Default,,0,0,0,,Хаа
Dialogue: 0,0:18:11.04,0:18:15.38,Default,,0,0,0,,Толық күзгі дауыл!
Dialogue: 0,0:18:15.47,0:18:16.97,Default,,0,0,0,,Желді оят
Dialogue: 0,0:18:17.05,0:18:19.05,Default,,0,0,0,,Бұл алдау!
Dialogue: 0,0:18:19.14,0:18:21.72,Default,,0,0,0,,Уау, бұл жаңа техника!
Dialogue: 0,0:18:21.81,0:18:23.06,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:18:23.14,0:18:25.23,Default,,0,0,0,,(Суға құлау дыбысы)
Dialogue: 0,0:18:25.31,0:18:28.85,Default,,0,0,0,,Күштілігі сонша, тіпті аю құбыжығы да қайтып оралғысы келеді
Dialogue: 0,0:18:28.94,0:18:30.19,Default,,0,0,0,,Мен үйдемін~
Dialogue: 0,0:18:30.27,0:18:32.07,Default,,0,0,0,,Аю~
Dialogue: 0,0:18:32.15,0:18:34.36,Default,,0,0,0,,А... не істеп жатырсың?
Dialogue: 0,0:18:34.44,0:18:35.57,Default,,0,0,0,,Ширауды одан сайын тартыңыз!
Dialogue: 0,0:18:36.53,0:18:38.28,Default,,0,0,0,,Ку… Кума монстры
Dialogue: 0,0:18:38.36,0:18:40.03,Default,,0,0,0,,және ата
Dialogue: 0,0:18:40.11,0:18:41.62,Default,,0,0,0,,Осы уақытқа дейін қайда болдың?
Dialogue: 0,0:18:41.70,0:18:43.54,Default,,0,0,0,,Go клубындағы барлығымен
Dialogue: 0,0:18:43.62,0:18:46.20,Default,,0,0,0,,Мен оқу-жаттығу жиынына бардым.
Dialogue: 0,0:18:49.00,0:18:50.58,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:18:50.67,0:18:51.33,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:18:51.33,0:18:52.46,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:18:51.33,0:18:52.46,Default,,0,0,0,,Аю
Dialogue: 0,0:18:52.46,0:18:52.92,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:18:54.75,0:18:55.84,Default,,0,0,0,,...
Dialogue: 0,0:18:55.92,0:18:57.80,Default,,0,0,0,,Маған да жазып алуды тапсырдым.
Dialogue: 0,0:18:57.88,0:18:58.88,Default,,0,0,0,,Сіз оны көрмейсіз бе?
Dialogue: 0,0:18:58.97,0:18:59.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:59.88,0:19:01.30,Default,,0,0,0,,Сіздің пікіріңізді естігеннен кейін оны мүмкіндігінше тезірек хабардар еткім келді.
Dialogue: 0,0:19:02.55,0:19:05.68,Default,,0,0,0,,Не, жазбалардың мазмұнын мүлде түсінбедің!?
Dialogue: 0,0:19:06.52,0:19:08.31,Default,,0,0,0,,Аю~
Dialogue: 0,0:19:09.73,0:19:11.81,Default,,0,0,0,,Жақында Нанига
Dialogue: 0,0:19:11.90,0:19:12.40,Default,,0,0,0,,Біз Нанигаға жетеміз.
Dialogue: 0,0:19:12.40,0:19:14.15,Default,,0,0,0,,Біз Нанигаға жетеміз.
Dialogue: 0,0:19:12.40,0:19:14.15,Default,,0,0,0,,Сізді пойыз қағып бара жатқанда жақсы немесе жаман нәрселер туралы ойламаңыз.
Dialogue: 0,0:19:14.15,0:19:15.69,Default,,0,0,0,,Сізді пойыз қағып бара жатқанда жақсы немесе жаман нәрселер туралы ойламаңыз.
Dialogue: 0,0:19:15.78,0:19:17.03,Default,,0,0,0,,Күн картасының баламасы
Dialogue: 0,0:19:17.11,0:19:21.11,Default,,0,0,0,,Менің ойымша, қоғамдық көлікте мұндай сөздерді айтпаған дұрыс.
Dialogue: 0,0:19:21.20,0:19:22.87,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:19:22.95,0:19:25.66,Default,,0,0,0,,Аю құбыжығы да қайтып келді.
Dialogue: 0,0:19:25.74,0:19:28.29,Default,,0,0,0,,Біз жаңа идеяларды іздейміз.
Dialogue: 0,0:19:25.74,0:19:28.29,Default,,0,0,0,,Нанига ~ Нанига ~
Dialogue: 0,0:19:28.37,0:19:29.21,Default,,0,0,0,,Хмм.
Dialogue: 0,0:19:29.29,0:19:31.29,Default,,0,0,0,,Есікті жабудан сақ болыңыз
Dialogue: 0,0:19:29.29,0:19:31.29,Default,,0,0,0,,Кума құбыжық Кума құбыжық...
Dialogue: 0,0:19:31.29,0:19:32.63,Default,,0,0,0,,Кума құбыжық Кума құбыжық...
Dialogue: 0,0:19:32.71,0:19:34.84,Default,,0,0,0,,(Шығу қоңырауы)
Dialogue: 0,0:19:34.92,0:19:36.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:36.42,0:19:37.92,Default,,0,0,0,,Аю құбыжық!
Dialogue: 0,0:19:39.05,0:19:40.55,Default,,0,0,0,,Аю құбыжық!
Dialogue: 0,0:19:45.05,0:19:48.27,Default,,0,0,0,,Аю құбыжық!
Dialogue: 0,0:19:52.23,0:19:53.56,Default,,0,0,0,,Аю аю...
Dialogue: 0,0:19:53.65,0:19:55.15,Default,,0,0,0,,Кигуруми?
Dialogue: 0,0:19:55.23,0:19:57.28,Default,,0,0,0,,Бұл жануардың иісі сияқты...
Dialogue: 0,0:19:57.36,0:19:58.36,Default,,0,0,0,,Аю…
Dialogue: 0,0:19:59.19,0:20:00.78,Default,,0,0,0,,Аю аю
Dialogue: 0,0:20:00.86,0:20:03.07,Default,,0,0,0,,Иә? (Жолаушы) А? Ол жоғалып кетті ме?
Dialogue: 0,0:20:03.53,0:20:04.32,Default,,0,0,0,,Аю аю аю...
Dialogue: 0,0:20:04.32,0:20:06.37,Default,,0,0,0,,Аю аю аю...
Dialogue: 0,0:20:04.32,0:20:06.37,Default,,0,0,0,,Ал, келесі Минами Нига.
Dialogue: 0,0:20:06.45,0:20:08.70,Default,,0,0,0,,Аю құбыжық не айтып тұр?
Dialogue: 0,0:20:08.79,0:20:10.62,Default,,0,0,0,,Сенімсіз адамдар үшін
Dialogue: 0,0:20:10.71,0:20:11.58,Default,,0,0,0,,Бұдан былай мен адам тілін қолданамын.
Dialogue: 0,0:20:11.58,0:20:13.58,Default,,0,0,0,,Бұдан былай мен адам тілін қолданамын.
Dialogue: 0,0:20:11.58,0:20:13.58,Default,,0,0,0,,Минами Нига ~ Минами Нига ~
Dialogue: 0,0:20:13.58,0:20:13.67,Default,,0,0,0,,Минами Нига ~ Минами Нига ~
Dialogue: 0,0:20:13.67,0:20:14.71,Default,,0,0,0,,Минами Нига ~ Минами Нига ~
Dialogue: 0,0:20:13.67,0:20:14.71,Default,,0,0,0,,Мен асығыс едім...
Dialogue: 0,0:20:14.71,0:20:15.21,Default,,0,0,0,,Мен асығыс едім...
Dialogue: 0,0:20:15.29,0:20:17.25,Default,,0,0,0,,Мен дүрбелең тудырғым келмейді.
Dialogue: 0,0:20:15.29,0:20:17.25,Default,,0,0,0,,Есікті жабудан сақ болыңыз
Dialogue: 0,0:20:17.34,0:20:19.55,Default,,0,0,0,,Төмен профильді сақтайық
Dialogue: 0,0:20:37.27,0:20:38.27,Default,,0,0,0,,Не болды?
Dialogue: 0,0:20:38.36,0:20:40.69,Default,,0,0,0,,Ескі күндерді еске түсіріңіз
Dialogue: 0,0:20:40.78,0:20:41.78,Default,,0,0,0,,Ұзақ уақыт бұрын?
Dialogue: 0,0:20:42.57,0:20:44.41,Default,,0,0,0,,Бүгін біз не ойнауымыз керек?
Dialogue: 0,0:20:44.49,0:20:45.74,Default,,0,0,0,,Аю~
Dialogue: 0,0:20:45.82,0:20:47.74,Default,,0,0,0,,Тау бұлағынан төмен!
Dialogue: 0,0:20:48.95,0:20:51.25,Default,,0,0,0,,Меніңше, оның қазіргіден көп айырмашылығы жоқ.
Dialogue: 0,0:20:51.33,0:20:53.08,Default,,0,0,0,,Жоқ, ол өзгертілді.
Dialogue: 0,0:20:53.79,0:20:56.25,Default,,0,0,0,,Біздің атымыз да болған жоқ
Dialogue: 0,0:20:56.33,0:20:59.21,Default,,0,0,0,,Олар бізді Кума құбыжықтары деп атай бастағаннан бері.
Dialogue: 0,0:20:59.30,0:21:00.84,Default,,0,0,0,,Ол өзгерді
Dialogue: 0,0:21:01.51,0:21:03.97,Default,,0,0,0,,Ол зұлымдықтың көсемі ме, не екенін білмеймін.
Dialogue: 0,0:21:04.05,0:21:08.51,Default,,0,0,0,,Бізге пешкадай қарайтын жігітке қосылғым келмейді.
Dialogue: 0,0:21:10.14,0:21:12.14,Default,,0,0,0,,Сіз солай ойлайсыз ба?
Dialogue: 0,0:21:12.23,0:21:13.23,Default,,0,0,0,,Мен...
Dialogue: 0,0:21:16.73,0:21:17.73,Default,,0,0,0,,Ах
Dialogue: 0,0:21:17.81,0:21:19.07,Default,,0,0,0,,Аю құбыжық!
Dialogue: 0,0:21:19.61,0:21:21.03,Default,,0,0,0,,Ахх~
Dialogue: 0,0:21:21.11,0:21:23.53,Default,,0,0,0,,Сізді қайта көргеніме қуаныштымын, Кума монстр.
Dialogue: 0,0:21:25.86,0:21:28.07,Default,,0,0,0,,Мен сендім
Dialogue: 0,0:21:28.78,0:21:29.91,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:21:30.54,0:21:32.50,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:21:32.58,0:21:33.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:33.50,0:21:35.33,Default,,0,0,0,,Құбыжық аю, мені тыңда.
Dialogue: 0,0:21:35.42,0:21:38.75,Default,,0,0,0,,Мен Хроманы көргенде, мен оны көтеріп алайын деп едім.
Dialogue: 0,0:21:38.84,0:21:40.29,Default,,0,0,0,,Бұл... Дата Мапко!
Dialogue: 0,0:21:40.38,0:21:42.01,Default,,0,0,0,,Өйткені бұл шындық.
Dialogue: 0,0:21:40.38,0:21:42.01,Default,,0,0,0,,Мен Читокомен бірге бола бастағаннан бері.
Dialogue: 0,0:21:42.01,0:21:42.09,Default,,0,0,0,,Мен Читокомен бірге бола бастағаннан бері.
Dialogue: 0,0:21:42.09,0:21:43.13,Default,,0,0,0,,Мен Читокомен бірге бола бастағаннан бері.
Dialogue: 0,0:21:42.09,0:21:43.13,Default,,0,0,0,,Сіз бұлай айтпауға уәде бересіз!
Dialogue: 0,0:21:43.13,0:21:43.21,Default,,0,0,0,,Сіз бұлай айтпауға уәде бересіз!
Dialogue: 0,0:21:43.21,0:21:44.30,Default,,0,0,0,,Сіз бұлай айтпауға уәде бересіз!
Dialogue: 0,0:21:43.21,0:21:44.30,Default,,0,0,0,,Мен өзімді бұрынғыдан осы жігітке көбірек ұқсайтын болдым.
Dialogue: 0,0:21:44.30,0:21:45.80,Default,,0,0,0,,Мен бұрынғыдан осы жігітке көбірек ұқсайтын болдым.
Dialogue: 0,0:21:45.88,0:21:47.93,Default,,0,0,0,,Өткен күндегі аппликация сияқты нәрсе.
Dialogue: 0,0:21:48.01,0:21:49.97,Default,,0,0,0,,Бұл сүйкімді болды.
Dialogue: 0,0:21:50.05,0:21:51.26,Default,,0,0,0,,Хун
Dialogue: 0,0:21:51.35,0:21:54.43,Default,,0,0,0,,Иә? Аю құбыжықтары үнемі бірдеңе айтады.
Dialogue: 0,0:21:55.14,0:21:56.77,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:21:56.85,0:21:58.69,Default,,0,0,0,,Аю аю аю
Dialogue: 0,0:22:00.61,0:22:01.48,Default,,0,0,0,,О
Dialogue: 0,0:22:02.73,0:22:03.99,Default,,0,0,0,,Аю
Dialogue: 0,0:22:04.99,0:22:07.24,Default,,0,0,0,,♪～
Dialogue: 0,0:23:31.53,0:23:34.91,Default,,0,0,0,,～♪
