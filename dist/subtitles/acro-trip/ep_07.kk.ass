Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.08,0:00:06.46,Default,,0,0,0,,Су толқындары, олар кеткен жерге шабуыл жасаңдар
Dialogue: 0,0:00:06.54,0:00:08.80,Default,,0,0,0,,Осында кездескенімізге 100 жыл болды.
Dialogue: 0,0:00:08.88,0:00:09.96,Default,,0,0,0,,Сиқырлы қыз
Dialogue: 0,0:00:10.05,0:00:12.47,Default,,0,0,0,,Бұл сызық Фосса Магна.
Dialogue: 0,0:00:12.55,0:00:15.22,Default,,0,0,0,,Мен әлі аздап күрестім.
Dialogue: 0,0:00:15.30,0:00:16.97,Default,,0,0,0,,Те... Тея!
Dialogue: 0,0:00:17.05,0:00:18.72,Default,,0,0,0,,О... Уау!
Dialogue: 0,0:00:20.43,0:00:21.81,Default,,0,0,0,,Шынында да солай емес пе?
Dialogue: 0,0:00:21.89,0:00:23.77,Default,,0,0,0,,Жасай бер Жидек гүлі
Dialogue: 0,0:00:30.94,0:00:33.86,Default,,0,0,0,,Не... Не? Мен күдіктенемін...
Dialogue: 0,0:00:35.70,0:00:37.62,Default,,0,0,0,,Мигьяа!
Dialogue: 0,0:00:37.70,0:00:38.83,Default,,0,0,0,,Ой! Ол бұрыштан айналып кетті!
Dialogue: 0,0:00:38.91,0:00:40.20,Default,,0,0,0,,Мен жеңдім, Маширо.
Dialogue: 0,0:00:40.29,0:00:41.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:41.20,0:00:43.12,Default,,0,0,0,,Фугю…
Dialogue: 0,0:00:41.20,0:00:43.12,Default,,0,0,0,,Кя Маширо!
Dialogue: 0,0:00:44.17,0:00:46.33,Default,,0,0,0,,Қорқынышты соққы Бұл не?
Dialogue: 0,0:00:48.75,0:00:50.96,Default,,0,0,0,,Сізге қаңғыбас мысық шабуыл жасады ма? Куку...
Dialogue: 0,0:00:51.05,0:00:51.96,Default,,0,0,0,,Ах!?
Dialogue: 0,0:00:52.05,0:00:53.59,Default,,0,0,0,,Маширо?
Dialogue: 0,0:00:53.67,0:00:57.22,Default,,0,0,0,,Оны сиқырлы қыздың серігі деп айту онша үлкен мәселе емес.
Dialogue: 0,0:00:57.30,0:00:58.72,Default,,0,0,0,,Гор!
Dialogue: 0,0:00:58.80,0:01:00.43,Default,,0,0,0,,Жалаңаш аю хахахаха…
Dialogue: 0,0:01:01.06,0:01:03.31,Default,,0,0,0,,Гррр... Жалап ал.
Dialogue: 0,0:01:03.39,0:01:04.81,Default,,0,0,0,,Жоқ, Маширо
Dialogue: 0,0:01:04.89,0:01:06.06,Default,,0,0,0,,Сізге демалу керек.
Dialogue: 0,0:01:06.85,0:01:09.57,Default,,0,0,0,,Қарғыс атсын, Хрома бейбақ.
Dialogue: 0,0:01:11.40,0:01:14.61,Default,,0,0,0,,Бірақ менде қазір ешқандай күш жоқ екені рас.
Dialogue: 0,0:01:14.70,0:01:16.11,Default,,0,0,0,,Какеру Уеха…
Dialogue: 0,0:01:18.07,0:01:19.99,Default,,0,0,0,,Стратегия – заттармен балық аулау.
Dialogue: 0,0:01:22.58,0:01:24.41,Default,,0,0,0,,Келіңдер, мысықтар!
Dialogue: 0,0:01:24.50,0:01:26.00,Default,,0,0,0,,Мен сені тыныштандырамын
Dialogue: 0,0:01:29.08,0:01:30.84,Default,,0,0,0,,Жүр, тамақ іш!
Dialogue: 0,0:01:34.47,0:01:36.05,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:01:36.13,0:01:37.13,Default,,0,0,0,,Ауырды!
Dialogue: 0,0:01:39.18,0:01:40.10,Default,,0,0,0,,Ах
Dialogue: 0,0:01:42.14,0:01:43.39,Default,,0,0,0,,Мен қайықты тексеріп бітірдім.
Dialogue: 0,0:01:43.89,0:01:45.18,Default,,0,0,0,,Мияу
Dialogue: 0,0:01:45.81,0:01:47.39,Default,,0,0,0,,Әй, жігіт! Біреуге қоңырау шал!
Dialogue: 0,0:01:47.48,0:01:48.85,Default,,0,0,0,,Мияу мияу
Dialogue: 0,0:01:48.94,0:01:51.48,Default,,0,0,0,,Tsk tsk бұл жігіт кім...
Dialogue: 0,0:01:52.90,0:01:54.90,Default,,0,0,0,,О, жоқ... батып бара жатыр
Dialogue: 0,0:01:54.99,0:01:56.61,Default,,0,0,0,,Яки бұрылды.
Dialogue: 0,0:01:56.70,0:02:00.62,Default,,0,0,0,,Мен мысықты құтқаратын адам емес едім.
Dialogue: 0,0:02:05.58,0:02:08.17,Default,,0,0,0,,Содан кейін мен тестті қайтарамын.
Dialogue: 0,0:02:08.25,0:02:10.92,Default,,0,0,0,,Сен бұл жолы да қайталадың, Машима.
Dialogue: 0,0:02:11.00,0:02:12.25,Default,,0,0,0,,Иә
Dialogue: 0,0:02:14.00,0:02:18.76,Default,,0,0,0,,♪～
Dialogue: 0,0:03:41.30,0:03:43.93,Default,,0,0,0,,～♪
Dialogue: 0,0:03:44.47,0:03:46.43,Default,,0,0,0,,Жасай бер, Маджима
Dialogue: 0,0:03:46.51,0:03:48.43,Default,,0,0,0,,Ма-кун шынымен де керемет.
Dialogue: 0,0:03:48.52,0:03:50.94,Default,,0,0,0,,Тек Машима жаратылыстану/математика бойынша тамаша ұпайға ие.
Dialogue: 0,0:03:51.02,0:03:52.81,Default,,0,0,0,,Мұғалімнің де мұрны үлкен.
Dialogue: 0,0:03:52.90,0:03:54.40,Default,,0,0,0,,Хехе, әрине.
Dialogue: 0,0:03:55.23,0:03:58.78,Default,,0,0,0,,Көбіңіз кім екеніңізді сұрайтын шығарсыз.
Dialogue: 0,0:03:58.86,0:04:01.28,Default,,0,0,0,,Біріншіден, менің атымды есте сақтаңыз.
Dialogue: 0,0:04:01.36,0:04:02.20,Default,,0,0,0,,Иә, мен Мажимамын...
Dialogue: 0,0:04:02.20,0:04:03.03,Default,,0,0,0,,Иә, мен Мажимамын...
Dialogue: 0,0:04:02.20,0:04:03.03,Default,,0,0,0,,Гэндзи!
Dialogue: 0,0:04:03.03,0:04:03.91,Default,,0,0,0,,Гэндзи!
Dialogue: 0,0:04:03.99,0:04:06.91,Default,,0,0,0,,Жапон/ағылшын тіліндегі тамаша балл, күткендей.
Dialogue: 0,0:04:06.99,0:04:08.41,Default,,0,0,0,,Иә
Dialogue: 0,0:04:08.49,0:04:09.66,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:04:09.75,0:04:10.96,Default,,0,0,0,,Chroma бәрінен де керемет
Dialogue: 0,0:04:10.96,0:04:11.50,Default,,0,0,0,,Хрома керемет
Dialogue: 0,0:04:10.96,0:04:11.50,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:04:11.50,0:04:11.58,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:04:11.58,0:04:12.67,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:04:11.58,0:04:12.67,Default,,0,0,0,,Мен сенің не ойлайтыныңды білмеймін.
Dialogue: 0,0:04:12.67,0:04:12.75,Default,,0,0,0,,Мен сенің не ойлайтыныңды білмеймін.
Dialogue: 0,0:04:12.75,0:04:13.42,Default,,0,0,0,,Мен сенің не ойлап тұрғаныңды білмеймін.
Dialogue: 0,0:04:12.75,0:04:13.42,Default,,0,0,0,,Өзімнен ерекшеленетін, өзімнен жақсы жұмыс істейтін менмін.
Dialogue: 0,0:04:13.42,0:04:13.50,Default,,0,0,0,,Өзімнен ерекшеленетін, өзімнен артық істейтін адаммын.
Dialogue: 0,0:04:13.50,0:04:14.50,Default,,0,0,0,,Өзімнен ерекшеленетін, өзімнен артық істейтін адаммын.
Dialogue: 0,0:04:13.50,0:04:14.50,Default,,0,0,0,,Сен ақылдысың
Dialogue: 0,0:04:14.50,0:04:14.58,Default,,0,0,0,,Өзімнен ерекшеленетін, өзімнен артық істейтін адаммын.
Dialogue: 0,0:04:14.58,0:04:16.84,Default,,0,0,0,,Өзімнен ерекшеленетін, өзімнен артық істейтін адаммын.
Dialogue: 0,0:04:14.58,0:04:16.84,Default,,0,0,0,,Бұл жұмбақ.
Dialogue: 0,0:04:16.92,0:04:19.21,Default,,0,0,0,,Мен сені жек көремін!
Dialogue: 0,0:04:19.30,0:04:21.92,Default,,0,0,0,,Әр нәрсенің басында тұрған менмін.
Dialogue: 0,0:04:22.01,0:04:23.38,Default,,0,0,0,,Сондықтан мен бала кезімде
Dialogue: 0,0:04:23.47,0:04:26.30,Default,,0,0,0,,Зұлымдықтың көсемі болу арманым еді.
Dialogue: 0,0:04:26.39,0:04:28.31,Default,,0,0,0,,Жоқ, бұл жақсы.
Dialogue: 0,0:04:28.39,0:04:29.89,Default,,0,0,0,,Мен енді бала емеспін
Dialogue: 0,0:04:29.97,0:04:31.31,Default,,0,0,0,,Қалай болғанда да!
Dialogue: 0,0:04:31.39,0:04:33.98,Default,,0,0,0,,Гендзи Хрома!
Dialogue: 0,0:04:35.35,0:04:36.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:36.27,0:04:37.73,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:04:37.82,0:04:40.94,Default,,0,0,0,,Жапон/ағылшын тілінен 100 ұпай жинағаныңызға көңіліңіз толмайды.
Dialogue: 0,0:04:41.03,0:04:43.78,Default,,0,0,0,,Не? Сіз кенеттен не істеп жатырсыз?
Dialogue: 0,0:04:44.57,0:04:45.82,Default,,0,0,0,,Сен…
Dialogue: 0,0:04:46.45,0:04:47.41,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:04:47.49,0:04:49.45,Default,,0,0,0,,Эй, есіңде жоқ.
Dialogue: 0,0:04:49.54,0:04:50.87,Default,,0,0,0,,Біз бір сыныпта оқимыз.
Dialogue: 0,0:04:53.21,0:04:54.92,Default,,0,0,0,,Біздің таңдауымыз жоқ.
Dialogue: 0,0:04:55.00,0:04:58.38,Default,,0,0,0,,Арманыма қарай жылжып бара жатқанда, есіме түсіре алмаймын.
Dialogue: 0,0:04:58.46,0:04:59.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:59.67,0:05:03.34,Default,,0,0,0,,Мен зұлымдықтың көшбасшысы болуым керек.
Dialogue: 0,0:05:04.17,0:05:06.47,Default,,0,0,0,,Әр минут пен секундты босқа өткізе аласыз ба?
Dialogue: 0,0:05:07.09,0:05:08.80,Default,,0,0,0,,Зұлымдықтың иесі?
Dialogue: 0,0:05:08.89,0:05:12.06,Default,,0,0,0,,Неліктен бұл жігіт бұрын мен сияқты істеп жүр?
Dialogue: 0,0:05:12.14,0:05:12.98,Default,,0,0,0,,Ха…
Dialogue: 0,0:05:13.93,0:05:16.27,Default,,0,0,0,,Сіз өте ынталысыз.
Dialogue: 0,0:05:16.35,0:05:18.44,Default,,0,0,0,,Мені бағынышты қылсаң да...
Dialogue: 0,0:05:18.52,0:05:20.19,Default,,0,0,0,,Наранай (Машима) ше?
Dialogue: 0,0:05:20.27,0:05:22.36,Default,,0,0,0,,Мен саған бағынышты болмаймын.
Dialogue: 0,0:05:24.15,0:05:26.61,Default,,0,0,0,,Менің ойымша, бұл жігіт, ол кезде...\NӘсіресе,
Dialogue: 0,0:05:26.70,0:05:28.49,Default,,0,0,0,,...
Dialogue: 0,0:05:28.57,0:05:30.74,Default,,0,0,0,,Осында кездескенімізге 100 жыл болды.
Dialogue: 0,0:05:32.83,0:05:36.12,Default,,0,0,0,,Көпшілік алдында жазалау басталды!
Dialogue: 0,0:05:36.71,0:05:38.25,Default,,0,0,0,,Эй, бұл не?
Dialogue: 0,0:05:39.25,0:05:41.96,Default,,0,0,0,,Сіздің жалғасып жатқан қараңғы тарихыңыз
Dialogue: 0,0:05:42.05,0:05:44.47,Default,,0,0,0,,Оны сабақта ашамын.
Dialogue: 0,0:05:44.55,0:05:48.22,Default,,0,0,0,,Мен сіздің әлеуметтік өліміңізді көре алмаймын.
Dialogue: 0,0:05:48.30,0:05:49.93,Default,,0,0,0,,Бәріңе сәлем
Dialogue: 0,0:05:50.01,0:05:53.10,Default,,0,0,0,,Oomizo Technica венчурлық компания екенін білесіз бе?
Dialogue: 0,0:05:54.18,0:05:55.60,Default,,0,0,0,,Мен білемін, бірақ
Dialogue: 0,0:05:55.68,0:05:57.31,Default,,0,0,0,,Не болды? Болды
Dialogue: 0,0:05:57.39,0:06:01.07,Default,,0,0,0,,Иә, OMT – Хокушинецудағы болашағы зор жұлдыз.
Dialogue: 0,0:06:01.15,0:06:03.44,Default,,0,0,0,,Ол соңғы жылдары тамаша компанияға айналды.
Dialogue: 0,0:06:03.53,0:06:04.36,Default,,0,0,0,,Оларға қашып кетуге жол бермеңдер
Dialogue: 0,0:06:04.44,0:06:06.70,Default,,0,0,0,,Мүмкін бұл хрома
Dialogue: 0,0:06:06.78,0:06:09.11,Default,,0,0,0,,Оны зұлым ұйым деп санау
Dialogue: 0,0:06:10.45,0:06:12.16,Default,,0,0,0,,Қандай таң қалдырды!
Dialogue: 0,0:06:12.24,0:06:16.08,Default,,0,0,0,,Бұл жігіт Omizo Technica компаниясына жұмысқа орналасты.
Dialogue: 0,0:06:16.16,0:06:19.25,Default,,0,0,0,,Жамандықтың иесі не істеуі керек?
Dialogue: 0,0:06:19.33,0:06:21.59,Default,,0,0,0,,Бұл болашақтың арманы!
Dialogue: 0,0:06:21.67,0:06:25.96,Default,,0,0,0,,Хахаха хахахаха
Dialogue: 0,0:06:28.13,0:06:30.26,Default,,0,0,0,,Хун Зама Миягаре
Dialogue: 0,0:06:30.34,0:06:31.51,Default,,0,0,0,,Эй
Dialogue: 0,0:06:31.60,0:06:34.35,Default,,0,0,0,,Менің қалаған мансап жолым туралы қайдан білдіңіз?
Dialogue: 0,0:06:34.43,0:06:35.27,Default,,0,0,0,,Ha
Dialogue: 0,0:06:35.35,0:06:36.64,Default,,0,0,0,,Э?
Dialogue: 0,0:06:37.48,0:06:39.06,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:39.14,0:06:43.11,Default,,0,0,0,,Жас кезімде жол көрсеттің.
Dialogue: 0,0:06:43.19,0:06:45.28,Default,,0,0,0,,Жамандықтың басшысы болғысы келетін бала
Dialogue: 0,0:06:46.78,0:06:47.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:47.86,0:06:49.66,Default,,0,0,0,,Екеуің соны мақсат етіп жатырсыңдар дегенді білдіре ме?
Dialogue: 0,0:06:49.74,0:06:51.32,Default,,0,0,0,,Жоқ…жоқ
Dialogue: 0,0:06:49.74,0:06:51.32,Default,,0,0,0,,Иә? Басқаша айтқанда?
Dialogue: 0,0:06:51.41,0:06:52.70,Default,,0,0,0,,Мен бұлай болады деп ойламадым...
Dialogue: 0,0:06:52.70,0:06:53.16,Default,,0,0,0,,Мен бұлай болады деп ойламадым...
Dialogue: 0,0:06:52.70,0:06:53.16,Default,,0,0,0,,Зұлымдықтың бас қолбасшысы ше?
Dialogue: 0,0:06:53.16,0:06:55.16,Default,,0,0,0,,Менің айтайын дегенім, зұлымдықтың қолбасшысы...
Dialogue: 0,0:06:55.24,0:06:58.00,Default,,0,0,0,,Уаааааа...
Dialogue: 0,0:06:58.96,0:07:00.92,Default,,0,0,0,,Бірақ... қолыңнан келгеннің бәрін істе, Маджима.
Dialogue: 0,0:07:03.50,0:07:05.96,Default,,0,0,0,,Қарғыс атсын... құдай-ау
Dialogue: 0,0:07:06.05,0:07:09.17,Default,,0,0,0,,Мен үшін әлеуметтік өлім...
Dialogue: 0,0:07:10.01,0:07:12.14,Default,,0,0,0,,Сізді Маджима деп атайды ма?
Dialogue: 0,0:07:12.22,0:07:14.18,Default,,0,0,0,,Менің есімде, біз жолдас едік.
Dialogue: 0,0:07:18.14,0:07:21.15,Default,,0,0,0,,Гунунуну…
Dialogue: 0,0:07:22.56,0:07:24.19,Default,,0,0,0,,Тосын шабуыл?
Dialogue: 0,0:07:24.27,0:07:26.23,Default,,0,0,0,,Түсінемін, бұл өте қауіпті.
Dialogue: 0,0:07:26.32,0:07:27.90,Default,,0,0,0,,Сондықтан бұдан былай бұндай жағдай қайталанбасын десек?
Dialogue: 0,0:07:27.99,0:07:30.45,Default,,0,0,0,,Бір жолды жалғастырсақ, қарсы емеспін.
Dialogue: 0,0:07:30.53,0:07:33.99,Default,,0,0,0,,Мен сені міндетті түрде талқандаймын
Dialogue: 0,0:07:37.20,0:07:40.41,Default,,0,0,0,,Omizo Technica-да жұмыс сұхбатының уақыты келді ме?
Dialogue: 0,0:07:40.50,0:07:43.71,Default,,0,0,0,,Бірақ сұхбаттардың бір күнде болғаны сондай кездейсоқтық.
Dialogue: 0,0:07:43.79,0:07:45.21,Default,,0,0,0,,Ах, дұрыс.
Dialogue: 0,0:07:46.00,0:07:47.25,Default,,0,0,0,,Эй, ақымақ.
Dialogue: 0,0:07:47.34,0:07:49.67,Default,,0,0,0,,Тек сені құлатып алатыныма көз жеткізу үшін.
Dialogue: 0,0:07:49.76,0:07:52.63,Default,,0,0,0,,Хм... Менің ойымша, біз сәл асығуымыз керек.
Dialogue: 0,0:07:53.47,0:07:56.81,Default,,0,0,0,,Аа, шынымен. Үлкен жүгі бар кемпір.
Dialogue: 0,0:07:56.89,0:08:00.48,Default,,0,0,0,,Суға батып бара жатқан мысықты көрсеңіз де, оны құтқаратын уақыт емес.
Dialogue: 0,0:08:00.56,0:08:03.02,Default,,0,0,0,,Қарғыс атқыр... Маджима қаншалықты жаман?
Dialogue: 0,0:08:03.10,0:08:05.52,Default,,0,0,0,,Бұл сирек болады...
Dialogue: 0,0:08:05.61,0:08:07.65,Default,,0,0,0,,Міне!
Dialogue: 0,0:08:11.11,0:08:12.49,Default,,0,0,0,,Жалақы?
Dialogue: 0,0:08:12.57,0:08:14.99,Default,,0,0,0,,Неге олай ұйықтайсың?
Dialogue: 0,0:08:15.62,0:08:19.12,Default,,0,0,0,,Сол адамдарды су шайып жатыр!
Dialogue: 0,0:08:21.71,0:08:23.67,Default,,0,0,0,,Қарғыс атқыр... алаңсыз
Dialogue: 0,0:08:23.75,0:08:27.88,Default,,0,0,0,,Бұлай жалғаса берсе, ол Жапон теңізіне дейін шайылып, акулаларға жем болады.
Dialogue: 0,0:08:29.63,0:08:30.59,Default,,0,0,0,,Міне!
Dialogue: 0,0:08:30.67,0:08:32.01,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:32.72,0:08:34.59,Default,,0,0,0,,Аю (Машима) ше?
Dialogue: 0,0:08:35.55,0:08:36.55,Default,,0,0,0,,Жарайды
Dialogue: 0,0:08:36.64,0:08:37.72,Default,,0,0,0,,(Сирена қосылады)
Dialogue: 0,0:08:40.27,0:08:41.93,Default,,0,0,0,,Сол адамды ұстаңыз.
Dialogue: 0,0:08:42.02,0:08:43.89,Default,,0,0,0,,Көтеру
Dialogue: 0,0:08:43.98,0:08:45.65,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:08:45.73,0:08:48.65,Default,,0,0,0,,Иә? Көріп отырғаныңыздай, бұл құтқарушы.
Dialogue: 0,0:08:48.73,0:08:50.15,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ.
Dialogue: 0,0:08:50.23,0:08:52.90,Default,,0,0,0,,Сіз біртүрлі нәрсе шығардыңыз, солай ма? Бұл не болды?
Dialogue: 0,0:08:53.40,0:08:55.61,Default,,0,0,0,,Не? Сіз де жасай аласыз.
Dialogue: 0,0:08:55.70,0:08:58.03,Default,,0,0,0,,Кішкентай кезімнен оны шығарып, ойнап жүрген болуым керек.
Dialogue: 0,0:08:58.12,0:09:00.79,Default,,0,0,0,,Мен шығара алмаймын, бере алмаймын, ақымақ!
Dialogue: 0,0:09:00.87,0:09:02.54,Default,,0,0,0,,Аю~
Dialogue: 0,0:09:02.62,0:09:04.54,Default,,0,0,0,,А, жоғары көтерілген сияқты.
Dialogue: 0,0:09:09.96,0:09:12.42,Default,,0,0,0,,Ол жігіт не болып жатыр?
Dialogue: 0,0:09:16.72,0:09:18.35,Default,,0,0,0,,Жақсы жұмыс (Кума құбыжық) Аю~
Dialogue: 0,0:09:21.31,0:09:23.39,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:09:23.48,0:09:24.48,Default,,0,0,0,,Бұл қатаң тыйым салынған!
Dialogue: 0,0:09:27.94,0:09:28.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:29.02,0:09:31.82,Default,,0,0,0,,Не... Не? Бұл не?
Dialogue: 0,0:09:31.90,0:09:34.95,Default,,0,0,0,,Мен не болып жатқанын да білмеймін.
Dialogue: 0,0:09:35.03,0:09:36.82,Default,,0,0,0,,Ммм
Dialogue: 0,0:09:37.28,0:09:39.53,Default,,0,0,0,,Сен мені көп қиындыққа ұшыраттың.
Dialogue: 0,0:09:39.62,0:09:41.91,Default,,0,0,0,,Балалар, сендерде бірдеңе болған жоқ па?
Dialogue: 0,0:09:41.99,0:09:43.91,Default,,0,0,0,,Ха, сұхбат!
Dialogue: 0,0:09:46.37,0:09:49.92,Default,,0,0,0,,О, мүмкін Oomizo Technica-дан шығар?
Dialogue: 0,0:09:50.00,0:09:51.92,Default,,0,0,0,,дұрыс болар еді
Dialogue: 0,0:09:56.72,0:10:01.22,Default,,0,0,0,,Omizo Technica Өкіл директоры, президент және бас директор
Dialogue: 0,0:10:01.31,0:10:03.18,Default,,0,0,0,,Менің атым Басака Омизо. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:10:05.14,0:10:07.39,Default,,0,0,0,,Бұл президент болды ма?
Dialogue: 0,0:10:07.48,0:10:09.06,Default,,0,0,0,,Неліктен өзен?
Dialogue: 0,0:10:09.15,0:10:12.07,Default,,0,0,0,,Сіз маған бірден көмектестіңіз.
Dialogue: 0,0:10:13.28,0:10:16.15,Default,,0,0,0,,Иә, мен және Мажима ғана.
Dialogue: 0,0:10:16.24,0:10:20.16,Default,,0,0,0,,Біз сіздің компанияңызға қосылғаннан кейін де икемді әрекет етуге уәде береміз.
Dialogue: 0,0:10:20.24,0:10:23.20,Default,,0,0,0,,Не... мына жігіт тез бейімделеді.
Dialogue: 0,0:10:23.29,0:10:25.95,Default,,0,0,0,,Біздің мектепке құжат тапсыруыңызға не түрткі болды?
Dialogue: 0,0:10:27.25,0:10:29.46,Default,,0,0,0,,Өйткені мен зұлымдықтың басшысы болғым келеді.
Dialogue: 0,0:10:29.54,0:10:30.71,Default,,0,0,0,,Эй, сен...
Dialogue: 0,0:10:30.79,0:10:34.17,Default,,0,0,0,,Ей, сен зұлымдықтың басшысысың.
Dialogue: 0,0:10:34.80,0:10:36.55,Default,,0,0,0,,Саған да солай, Маджима.
Dialogue: 0,0:10:36.63,0:10:38.22,Default,,0,0,0,,Мені араластырма, ақымақ!
Dialogue: 0,0:10:38.30,0:10:39.13,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:10:39.22,0:10:40.84,Default,,0,0,0,,Жоқ, жоқ...
Dialogue: 0,0:10:41.35,0:10:43.47,Default,,0,0,0,,Президент, уақыт таяп қалды.
Dialogue: 0,0:10:43.56,0:10:44.81,Default,,0,0,0,,(Беатриса) Ол кітап бөлмеге кіріп кеткен жәндіктерден қалай құтылу керектігін айтып бере ме екен?
Dialogue: 0,0:10:44.89,0:10:46.60,Default,,0,0,0,,Міне, сұхбат үшін.
Dialogue: 0,0:10:46.68,0:10:47.43,Default,,0,0,0,,Ахххх...
Dialogue: 0,0:10:47.43,0:10:49.60,Default,,0,0,0,,Ахххх...
Dialogue: 0,0:10:47.43,0:10:49.60,Default,,0,0,0,,Сен менің тірегім болуың керек еді—
Dialogue: 0,0:10:49.69,0:10:51.31,Default,,0,0,0,,Мен ойладым...
Dialogue: 0,0:10:55.53,0:10:58.45,Default,,0,0,0,,Себебі жұмбақ, бірақ маған жұмысқа ұсыныс түсті.
Dialogue: 0,0:10:58.53,0:11:02.16,Default,,0,0,0,,Егер бұл орын алса, мен байқағанымнан да тезірек көтерілемін.
Dialogue: 0,0:11:02.16,0:11:02.70,Default,,0,0,0,,Егер бұл орын алса, мен байқағанымнан да тезірек көтерілемін.
Dialogue: 0,0:11:02.16,0:11:02.70,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:11:02.70,0:11:03.41,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:11:03.49,0:11:05.20,Default,,0,0,0,,Ой, бүгін де ерте.
Dialogue: 0,0:11:05.29,0:11:07.37,Default,,0,0,0,,Қайырлы таң, Сенпай.
Dialogue: 0,0:11:07.45,0:11:10.17,Default,,0,0,0,,Балалар сендер өте зейінді екенсіңдер.
Dialogue: 0,0:11:10.25,0:11:12.46,Default,,0,0,0,,Ха хи хи хи хо!
Dialogue: 0,0:11:12.46,0:11:15.13,Default,,0,0,0,,Ха хи хи хи хо!
Dialogue: 0,0:11:12.46,0:11:15.13,Default,,0,0,0,,Мен бұл жігіттен ешқашан жеңілмеймін!
Dialogue: 0,0:11:15.21,0:11:16.63,Default,,0,0,0,,Сәттілік (Машима)
Dialogue: 0,0:11:16.71,0:11:18.13,Default,,0,0,0,,Иә, а... иә, сәлем.
Dialogue: 0,0:11:18.22,0:11:19.63,Default,,0,0,0,,Амансың ба? Мен оны сұрадым
Dialogue: 0,0:11:19.72,0:11:21.51,Default,,0,0,0,,Келесі жаңалықтар
Dialogue: 0,0:11:21.59,0:11:23.26,Default,,0,0,0,,Бұл өткен жылдан бері жүргізіліп келеді.
Dialogue: 0,0:11:23.35,0:11:25.76,Default,,0,0,0,,Маджима сенен сұрайын дегенім бар.
Dialogue: 0,0:11:23.35,0:11:25.76,Default,,0,0,0,,Біздің NNTV бас кеңсесінің ғимаратын жаңарту
Dialogue: 0,0:11:25.85,0:11:27.10,Default,,0,0,0,,Э?
Dialogue: 0,0:11:25.85,0:11:27.10,Default,,0,0,0,,Бұл енді аяқталды.
Dialogue: 0,0:11:27.10,0:11:27.64,Default,,0,0,0,,Бұл енді аяқталды.
Dialogue: 0,0:11:27.72,0:11:30.48,Default,,0,0,0,,Ескерткіштің ашылу салтанаты өтті.
Dialogue: 0,0:11:27.72,0:11:30.48,Default,,0,0,0,,Еңбек етсең де, зұлымдықтың көсемі бола алмайсың, солай ма?
Dialogue: 0,0:11:30.48,0:11:31.77,Default,,0,0,0,,Еңбек етсең де, зұлымдықтың көсемі бола алмайсың, солай ма?
Dialogue: 0,0:11:31.85,0:11:33.86,Default,,0,0,0,,Сіз мұны енді түсіндіңіз бе?
Dialogue: 0,0:11:33.94,0:11:35.86,Default,,0,0,0,,Бұл зұлым ұйым емес.
Dialogue: 0,0:11:35.94,0:11:38.78,Default,,0,0,0,,Сіз жақсы компанияда жұмыс жасайсыз, сондықтан сіз бақыттысыз.
Dialogue: 0,0:11:39.90,0:11:42.49,Default,,0,0,0,,Мен сондай болғым келсе де, Мажима!
Dialogue: 0,0:11:42.57,0:11:45.49,Default,,0,0,0,,Менімен бірге тұрма, балам.
Dialogue: 0,0:11:46.24,0:11:48.50,Default,,0,0,0,,Ей, қажырлы еңбегіңе рахмет.
Dialogue: 0,0:11:49.25,0:11:50.83,Default,,0,0,0,,Президент Омизо
Dialogue: 0,0:11:51.29,0:11:54.46,Default,,0,0,0,,Иә? Екеуің карри жемейсіңдер ме?
Dialogue: 0,0:11:54.54,0:11:57.34,Default,,0,0,0,,Біздің компанияның ерекше түпнұсқа үнді карриі
Dialogue: 0,0:11:57.42,0:11:58.84,Default,,0,0,0,,Паон
Dialogue: 0,0:11:58.92,0:12:01.59,Default,,0,0,0,,Үнді піліне жұмыс істеу керек болса да...
Dialogue: 0,0:12:01.68,0:12:02.97,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:03.05,0:12:04.85,Default,,0,0,0,,Мен дәмдеуіштерді ұнатпаймын
Dialogue: 0,0:12:04.93,0:12:07.06,Default,,0,0,0,,Жарайды, уайымдама.
Dialogue: 0,0:12:07.14,0:12:10.10,Default,,0,0,0,,Бірақ сен адал адамсың, солай емес пе, Хрома-кун?
Dialogue: 0,0:12:10.18,0:12:12.48,Default,,0,0,0,,Әттең!
Dialogue: 0,0:12:12.56,0:12:15.73,Default,,0,0,0,,Бұл қорқынышты. Үнді пілі жабайы болып кетті!
Dialogue: 0,0:12:16.36,0:12:17.73,Default,,0,0,0,,Бұл болды
Dialogue: 0,0:12:17.82,0:12:20.24,Default,,0,0,0,,Маджима үнді пілі президент болды
Dialogue: 0,0:12:20.32,0:12:22.49,Default,,0,0,0,,Цк, пілді тоқтату керек.
Dialogue: 0,0:12:22.57,0:12:24.41,Default,,0,0,0,,Дод, бастық!
Dialogue: 0,0:12:25.99,0:12:28.03,Default,,0,0,0,,Тоқта, піл!
Dialogue: 0,0:12:28.12,0:12:29.41,Default,,0,0,0,,Аю
Dialogue: 0,0:12:30.25,0:12:31.46,Default,,0,0,0,,Бе~ (Үнді пілі) киіз үй…
Dialogue: 0,0:12:31.46,0:12:32.04,Default,,0,0,0,,Бе~ (Үнді пілі) киіз үй…
Dialogue: 0,0:12:31.46,0:12:32.04,Default,,0,0,0,,Әй... (қызметкер) Мен оны тоқтаттым.
Dialogue: 0,0:12:32.04,0:12:32.83,Default,,0,0,0,,Ой... (қызметкер) Мен оны тоқтаттым.
Dialogue: 0,0:12:32.91,0:12:34.29,Default,,0,0,0,,Сүйкімді (қызметкер) Керемет
Dialogue: 0,0:12:34.37,0:12:35.21,Default,,0,0,0,,Хо…
Dialogue: 0,0:12:35.29,0:12:37.17,Default,,0,0,0,,Міне, мен құтқарылдым.
Dialogue: 0,0:12:37.25,0:12:40.21,Default,,0,0,0,,Сұхбат барысында мәлімдегеніңіздей
Dialogue: 0,0:12:40.30,0:12:43.13,Default,,0,0,0,,Сіз икемдісіз, Хрома-кун.
Dialogue: 0,0:12:46.85,0:12:47.85,Default,,0,0,0,,Сұхбат?
Dialogue: 0,0:12:47.93,0:12:49.56,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:12:49.64,0:12:50.97,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,0:12:51.06,0:12:52.77,Default,,0,0,0,,Есіңде жоқ!
Dialogue: 0,0:12:55.40,0:12:56.94,Default,,0,0,0,,Қайырлы таң Маджима
Dialogue: 0,0:12:57.02,0:12:59.27,Default,,0,0,0,,Жапонияда бүгін тағы да күн ашық. Барымызды салайық.
Dialogue: 0,0:13:01.07,0:13:02.28,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:13:05.03,0:13:06.78,Default,,0,0,0,,Бұл қай жер?
Dialogue: 0,0:13:07.57,0:13:09.99,Default,,0,0,0,,Құпия бөлімге қош келдіңіз
Dialogue: 0,0:13:12.04,0:13:13.21,Default,,0,0,0,,Фосса…
Dialogue: 0,0:13:13.29,0:13:14.66,Default,,0,0,0,,Маңызды?
Dialogue: 0,0:13:15.21,0:13:17.96,Default,,0,0,0,,А... зұлым ұйым сияқты!
Dialogue: 0,0:13:18.04,0:13:21.21,Default,,0,0,0,,Сіздер маған ерекше берілген қызметкерлерсіздер.
Dialogue: 0,0:13:21.30,0:13:24.84,Default,,0,0,0,,Енді мен сіздің осы бағыттағы жұмысыңызға үлкен үміт артамын.
Dialogue: 0,0:13:28.26,0:13:29.97,Default,,0,0,0,,Ерен еңбегіңіз үшін рахмет, Президент.
Dialogue: 0,0:13:30.06,0:13:31.06,Default,,0,0,0,,Сәлем
Dialogue: 0,0:13:31.14,0:13:33.23,Default,,0,0,0,,Кешегі операция өте сәтті өтті.
Dialogue: 0,0:13:33.31,0:13:35.23,Default,,0,0,0,,ISS жұмысы
Dialogue: 0,0:13:35.31,0:13:38.36,Default,,0,0,0,,«Үнді пілін президент ету стратегиясы»
Dialogue: 0,0:13:40.98,0:13:44.74,Default,,0,0,0,,Оның құдіреті туралы көбірек білуім керек.
Dialogue: 0,0:13:46.61,0:13:49.49,Default,,0,0,0,,Ия иә иә
Dialogue: 0,0:13:46.61,0:13:49.49,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:13:49.57,0:13:51.79,Default,,0,0,0,,Хахаха мереке!
Dialogue: 0,0:13:51.87,0:13:54.16,Default,,0,0,0,,Бұлай толқымаңыз! Бұл ұят!
Dialogue: 0,0:13:54.25,0:13:55.54,Default,,0,0,0,,Қалқымалы
Dialogue: 0,0:13:55.62,0:13:57.87,Default,,0,0,0,,Дәл сол күні сіз айтқандай болды.
Dialogue: 0,0:13:57.96,0:13:59.88,Default,,0,0,0,,Зұлым ұйым болғаны сөзсіз
Dialogue: 0,0:13:59.96,0:14:01.25,Default,,0,0,0,,Қоғамдық махаббат хатынан бері —
Dialogue: 0,0:14:01.34,0:14:03.88,Default,,0,0,0,,Қой, қой!
Dialogue: 0,0:14:07.22,0:14:10.93,Default,,0,0,0,,Мен саған жұмбақ күш беремін
Dialogue: 0,0:14:11.01,0:14:13.35,Default,,0,0,0,,Бұл қандай карта?
Dialogue: 0,0:14:13.43,0:14:15.81,Default,,0,0,0,,Иә, маңдайыңызға салып көріңіз.
Dialogue: 0,0:14:20.36,0:14:22.44,Default,,0,0,0,,Оны өзіміз әзірледік.
Dialogue: 0,0:14:22.52,0:14:25.53,Default,,0,0,0,,Бұл уақытша ғана әсер етеді.
Dialogue: 0,0:14:25.61,0:14:28.28,Default,,0,0,0,,Неге бізге мұндайды бердіңіз...
Dialogue: 0,0:14:29.32,0:14:32.74,Default,,0,0,0,,Шешетін кез келді деп ойладым.
Dialogue: 0,0:14:33.24,0:14:35.08,Default,,0,0,0,,Фосса Магна командирі.
Dialogue: 0,0:14:35.16,0:14:36.00,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:37.00,0:14:38.75,Default,,0,0,0,,Бірақ тек бір адам
Dialogue: 0,0:14:40.04,0:14:43.13,Default,,0,0,0,,Барлықтарыңызды бас қолбасшы лауазымына бәсекелесулеріңізді сұраймын.
Dialogue: 0,0:14:43.21,0:14:44.46,Default,,0,0,0,,ше? Мен қарсы емеспін
Dialogue: 0,0:14:45.63,0:14:47.88,Default,,0,0,0,,Өйткені біз зұлымдықтың иесіміз
Dialogue: 0,0:14:47.97,0:14:49.55,Default,,0,0,0,,Біз осы уақытқа дейін жеттік
Dialogue: 0,0:14:49.63,0:14:51.55,Default,,0,0,0,,На (Машима) Наа!
Dialogue: 0,0:14:51.64,0:14:54.76,Default,,0,0,0,,Енді сен ғана соны мақсат етіп отырсың.
Dialogue: 0,0:14:54.85,0:14:57.06,Default,,0,0,0,,Бұл рух керемет!
Dialogue: 0,0:14:57.68,0:14:58.94,Default,,0,0,0,,Секір!!
Dialogue: 0,0:14:59.02,0:15:02.65,Default,,0,0,0,,(Тікұшақтың дыбысы)
Dialogue: 0,0:15:03.32,0:15:06.36,Default,,0,0,0,,Жағажай жалауымен кім жеңсе, сол бас қолбасшы болып табылады.
Dialogue: 0,0:15:07.99,0:15:11.03,Default,,0,0,0,,Неліктен бұлай болды...
Dialogue: 0,0:15:11.11,0:15:12.24,Default,,0,0,0,,Жақсы
Dialogue: 0,0:15:12.32,0:15:14.53,Default,,0,0,0,,Бізде мұны істеуден басқа амал жоқ.
Dialogue: 0,0:15:14.99,0:15:16.70,Default,,0,0,0,,Сен өте ынталысың, досым.
Dialogue: 0,0:15:17.58,0:15:19.79,Default,,0,0,0,,Менің ойымша, солай.
Dialogue: 0,0:15:19.87,0:15:22.38,Default,,0,0,0,,Мен мұны бала кезімнен айтып келемін.
Dialogue: 0,0:15:23.54,0:15:27.42,Default,,0,0,0,,Мен мұндай күн келеді деп ойламаппын.
Dialogue: 0,0:15:30.80,0:15:33.47,Default,,0,0,0,,Иә Орын туралы
Dialogue: 0,0:15:33.55,0:15:35.93,Default,,0,0,0,,Әлі шешілген жоқ.
Dialogue: 0,0:15:37.02,0:15:39.43,Default,,0,0,0,,Жеңісімнен бас тартамын деген ойым жоқ.
Dialogue: 0,0:15:39.52,0:15:42.77,Default,,0,0,0,,Кеттік.
Dialogue: 0,0:15:44.02,0:15:45.44,Default,,0,0,0,,Бум!
Dialogue: 0,0:15:45.52,0:15:49.61,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:15:49.69,0:15:52.11,Default,,0,0,0,,Алдымен жалаушаны алған дұрыс
Dialogue: 0,0:15:52.20,0:15:53.20,Default,,0,0,0,,Бас қолбасшыға
Dialogue: 0,0:15:53.28,0:15:54.12,Default,,0,0,0,,Цука?
Dialogue: 0,0:15:55.03,0:15:58.79,Default,,0,0,0,,Жағажай тым кең!
Dialogue: 0,0:16:00.71,0:16:03.88,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:16:04.46,0:16:06.96,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:16:07.05,0:16:08.30,Default,,0,0,0,,Табылмады
Dialogue: 0,0:16:08.84,0:16:10.59,Default,,0,0,0,,Мүлдем емес
Dialogue: 0,0:16:12.22,0:16:13.39,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:16:13.47,0:16:16.05,Default,,0,0,0,,Туды табу басты жарыс емес деп ойлаймын!
Dialogue: 0,0:16:18.64,0:16:19.64,Default,,0,0,0,,Аю
Dialogue: 0,0:16:19.72,0:16:21.27,Default,,0,0,0,,Жаяу жүріп жол таба алмайсың
Dialogue: 0,0:16:21.35,0:16:22.56,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:16:27.32,0:16:29.11,Default,,0,0,0,,Tsk... не істеуім керек?
Dialogue: 0,0:16:31.95,0:16:33.66,Default,,0,0,0,,Бұл жігітті қолдануға бола ма?
Dialogue: 0,0:16:33.74,0:16:36.20,Default,,0,0,0,,табу оңайырақ болады
Dialogue: 0,0:16:43.79,0:16:44.46,Default,,0,0,0,,Біз жеңілдік.
Dialogue: 0,0:16:44.46,0:16:45.75,Default,,0,0,0,,Біз жеңілдік.
Dialogue: 0,0:16:44.46,0:16:45.75,Default,,0,0,0,,Уау... Уау
Dialogue: 0,0:16:45.75,0:16:46.54,Default,,0,0,0,,Уау... Уау
Dialogue: 0,0:16:46.63,0:16:47.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:59.01,0:17:00.77,Default,,0,0,0,,болды
Dialogue: 0,0:17:02.77,0:17:03.94,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:04.02,0:17:05.44,Default,,0,0,0,,Мен бұл туралы ойладым, Машима.
Dialogue: 0,0:17:06.81,0:17:08.48,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,0:17:08.57,0:17:10.11,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:17:10.19,0:17:12.69,Default,,0,0,0,,Мен оны бірінші таптым
Dialogue: 0,0:17:12.78,0:17:14.57,Default,,0,0,0,,Chroma Bastard-ты жеңіңіз
Dialogue: 0,0:17:15.28,0:17:17.45,Default,,0,0,0,,Мен мұны саған ешқашан бермеймін.
Dialogue: 0,0:17:17.53,0:17:18.53,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:17:18.62,0:17:22.62,Default,,0,0,0,,Бұл менікі!
Dialogue: 0,0:17:22.70,0:17:25.46,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:17:29.50,0:17:30.34,Default,,0,0,0,,Ах
Dialogue: 0,0:17:34.34,0:17:35.34,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:17:37.89,0:17:39.47,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:40.05,0:17:40.97,Default,,0,0,0,,Ах
Dialogue: 0,0:17:44.60,0:17:45.60,Default,,0,0,0,,Сендердің міндетің не, көпшілік?
Dialogue: 0,0:17:49.15,0:17:51.11,Default,,0,0,0,,Бұл ойын, солай емес пе?
Dialogue: 0,0:17:54.40,0:17:56.78,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:17:57.61,0:17:59.32,Default,,0,0,0,,Жеңімпаз - Genmi Chroma
Dialogue: 0,0:17:59.41,0:18:00.91,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:18:01.41,0:18:03.29,Default,,0,0,0,,(Фанфар)
Dialogue: 0,0:18:06.71,0:18:09.33,Default,,0,0,0,,О, бітті ме?
Dialogue: 0,0:18:12.09,0:18:15.55,Default,,0,0,0,,Енді Хрома ақыры бас қолбасшы болды.
Dialogue: 0,0:18:16.13,0:18:18.55,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,0:18:18.64,0:18:20.18,Default,,0,0,0,,Хрома-кун?
Dialogue: 0,0:18:21.10,0:18:24.02,Default,,0,0,0,,Мен мұнда жеңіске жету үшін келген жоқпын
Dialogue: 0,0:18:24.10,0:18:26.56,Default,,0,0,0,,Маджимаға көмектесу үшін туды алдым.
Dialogue: 0,0:18:27.44,0:18:29.85,Default,,0,0,0,,Бұл өте құрметті қадам.
Dialogue: 0,0:18:30.40,0:18:32.57,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,0:18:33.40,0:18:35.07,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:18:35.15,0:18:37.07,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:18:37.15,0:18:38.40,Default,,0,0,0,,Бұл L-дің ізбасарын тәрбиелеуге арналған мекеме сияқты.
Dialogue: 0,0:18:38.86,0:18:41.57,Default,,0,0,0,,Жамандықтың көсемі болуға менің талантым жетпейді.
Dialogue: 0,0:18:42.16,0:18:44.54,Default,,0,0,0,,Маған қалыс қалуға рұқсат етіңіз, Мажима.
Dialogue: 0,0:18:48.96,0:18:52.67,Default,,0,0,0,,Сен зұлымдықтың басшысы болуға лайықсың.
Dialogue: 0,0:18:53.42,0:18:54.42,Default,,0,0,0,,Иә!?
Dialogue: 0,0:18:54.50,0:18:56.67,Default,,0,0,0,,Ойында жеңіске жету үшін не істеп жатырсың?
Dialogue: 0,0:18:57.17,0:18:59.18,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:19:00.80,0:19:01.76,Default,,0,0,0,,Цк
Dialogue: 0,0:19:01.85,0:19:03.18,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:03.64,0:19:06.27,Default,,0,0,0,,Шешім қабылдаған адам болса, көмектесу мүмкін емес.
Dialogue: 0,0:19:06.35,0:19:08.35,Default,,0,0,0,,Сонда сіз бас қолбасшысыз.
Dialogue: 0,0:19:11.35,0:19:12.36,Default,,0,0,0,,Эй
Dialogue: 0,0:19:12.86,0:19:14.36,Default,,0,0,0,,Ақымақ.
Dialogue: 0,0:19:14.82,0:19:16.73,Default,,0,0,0,,Мен неге сонша келдім...
Dialogue: 0,0:19:16.82,0:19:18.49,Default,,0,0,0,,(Жүрек соғысы дыбысы)
Dialogue: 0,0:19:18.57,0:19:19.49,Default,,0,0,0,,Содан кейін мен бұл картаны тастаймын.
Dialogue: 0,0:19:19.49,0:19:21.49,Default,,0,0,0,,Онда мен бұл картаны тастаймын.
Dialogue: 0,0:19:19.49,0:19:21.49,Default,,0,0,0,,Эй, эй, тыңдап тұрсың ба?
Dialogue: 0,0:19:21.57,0:19:23.87,Default,,0,0,0,,(Жүрек соғысы дыбысы)
Dialogue: 0,0:19:24.62,0:19:28.71,Default,,0,0,0,,Не лақтырдың, мен неге алмаймын?
Dialogue: 0,0:19:28.79,0:19:31.17,Default,,0,0,0,,Бұл алғашқы «Глория».
Dialogue: 0,0:19:31.25,0:19:34.46,Default,,0,0,0,,Мойындамаймын Мойындамаймын
Dialogue: 0,0:19:34.54,0:19:37.67,Default,,0,0,0,,Нетимонды оңай жіберетін адамға.
Dialogue: 0,0:19:37.76,0:19:40.38,Default,,0,0,0,,Мен жеңілдім бе?
Dialogue: 0,0:19:41.18,0:19:44.05,Default,,0,0,0,,Ахххх...
Dialogue: 0,0:19:46.89,0:19:50.02,Default,,0,0,0,,Ууууууу...
Dialogue: 0,0:19:50.48,0:19:54.23,Default,,0,0,0,,Хромаааааа!
Dialogue: 0,0:19:54.31,0:19:55.69,Default,,0,0,0,,Гррр…
Dialogue: 0,0:19:55.77,0:20:00.15,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:20:04.16,0:20:06.41,Default,,0,0,0,,Ма... Шима...
Dialogue: 0,0:20:17.09,0:20:18.42,Default,,0,0,0,,Мен мұны істедім бе?
Dialogue: 0,0:20:18.50,0:20:19.76,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:20:19.84,0:20:23.22,Default,,0,0,0,,Ол соншалықты шайқалған болуы керек, ол өз күштерін басқара алмады.
Dialogue: 0,0:20:23.30,0:20:25.05,Default,,0,0,0,,Бұл қайғылы оқиға болды.
Dialogue: 0,0:20:25.97,0:20:29.31,Default,,0,0,0,,Мен сізбен жұмыс істей бастағалы жатыр едім.
Dialogue: 0,0:20:29.39,0:20:30.64,Default,,0,0,0,,Өкінішті
Dialogue: 0,0:20:31.98,0:20:33.85,Default,,0,0,0,,Не деген...
Dialogue: 0,0:20:36.27,0:20:37.98,Default,,0,0,0,,Уф... не?
Dialogue: 0,0:20:39.78,0:20:41.24,Default,,0,0,0,,Ол осы мамандық атауын беруге тікелей шабыт болған —
Dialogue: 0,0:20:42.20,0:20:43.70,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:20:43.78,0:20:45.74,Default,,0,0,0,,Бұл карта.
Dialogue: 0,0:20:45.82,0:20:49.24,Default,,0,0,0,,Күші жоқ адамды ренжіткен кезде
Dialogue: 0,0:20:49.33,0:20:52.33,Default,,0,0,0,,Айыппұл осылай іске қосылады.
Dialogue: 0,0:20:57.59,0:20:59.00,Default,,0,0,0,,Hiii (Батака) Күте тұрыңыз...
Dialogue: 0,0:20:59.75,0:21:00.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:01.30,0:21:03.34,Default,,0,0,0,,Жарайсыңдар, көмек көрсету тобы.
Dialogue: 0,0:21:10.26,0:21:12.35,Default,,0,0,0,,Мен... мен...
Dialogue: 0,0:21:12.89,0:21:14.35,Default,,0,0,0,,Сіз байқадыңыз ба?
Dialogue: 0,0:21:14.44,0:21:15.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:15.77,0:21:18.02,Default,,0,0,0,,Ал... Маджима ше?
Dialogue: 0,0:21:18.11,0:21:20.07,Default,,0,0,0,,Мен мұны жақсы айта алмаймын.
Dialogue: 0,0:21:20.15,0:21:23.82,Default,,0,0,0,,Жаңа ғана апат мені толығымен өзгертті.
Dialogue: 0,0:21:25.41,0:21:27.03,Default,,0,0,0,,Бұл жеткілікті
Dialogue: 0,0:21:27.12,0:21:28.37,Default,,0,0,0,,Мен оны естігім келмейді
Dialogue: 0,0:21:28.45,0:21:29.99,Default,,0,0,0,,Көремін, көремін.
Dialogue: 0,0:21:30.08,0:21:31.95,Default,,0,0,0,,Машима-кун енді бұл жерде жоқ.
Dialogue: 0,0:21:32.87,0:21:35.79,Default,,0,0,0,,Өйткені бүгіннен бастап сіз бас қолбасшысыз.
Dialogue: 0,0:21:35.87,0:21:39.34,Default,,0,0,0,,Бірақ бұл жолы біз жақсы деректер алдық және
Dialogue: 0,0:21:39.42,0:21:42.26,Default,,0,0,0,,Бұл күшке эмоциялар әсер етеді, солай ма?
Dialogue: 0,0:21:42.34,0:21:44.26,Default,,0,0,0,,Өте қызық...
Dialogue: 0,0:21:48.55,0:21:50.39,Default,,0,0,0,,Сіз мені естімейсіз бе?
Dialogue: 0,0:21:54.14,0:21:55.64,Default,,0,0,0,,Мажима...
Dialogue: 0,0:22:04.19,0:22:07.57,Default,,0,0,0,,Уф... Қарғыс атсын.
Dialogue: 0,0:22:09.12,0:22:12.08,Default,,0,0,0,,Бұл картаны әлі де пайдалануға бола ма?
Dialogue: 0,0:22:12.16,0:22:15.04,Default,,0,0,0,,(Мотоцикл дыбыстары)
Dialogue: 0,0:22:15.12,0:22:18.29,Default,,0,0,0,,Мен бұлай болмаймын.
Dialogue: 0,0:22:18.75,0:22:20.13,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:22:23.05,0:22:25.51,Default,,0,0,0,,Маширо Маширо!
Dialogue: 0,0:22:25.59,0:22:26.92,Default,,0,0,0,,Маширо
Dialogue: 0,0:22:28.80,0:22:29.30,Default,,0,0,0,,Жақсы
Dialogue: 0,0:22:29.30,0:22:30.43,Default,,0,0,0,,Жақсы
Dialogue: 0,0:22:29.30,0:22:30.43,Default,,0,0,0,,Уф... ауырады
Dialogue: 0,0:22:30.43,0:22:30.51,Default,,0,0,0,,Уф... ауырады
Dialogue: 0,0:22:30.51,0:22:31.22,Default,,0,0,0,,Уф... ауырады
Dialogue: 0,0:22:30.51,0:22:31.22,Default,,0,0,0,,Котенка да қауіпсіз.
Dialogue: 0,0:22:31.22,0:22:32.35,Default,,0,0,0,,Котенка да қауіпсіз.
Dialogue: 0,0:22:33.56,0:22:34.60,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:22:43.57,0:22:45.61,Default,,0,0,0,,Мен мүлде түсінбеймін
Dialogue: 0,0:22:45.69,0:22:46.61,Default,,0,0,0,,Хехе
Dialogue: 0,0:22:46.69,0:22:48.82,Default,,0,0,0,,Сіз Машироға рахмет айтпайсыз ба?
Dialogue: 0,0:22:48.91,0:22:50.70,Default,,0,0,0,,Бірақ тым зорлық-зомбылықтан аулақ болыңыз.
Dialogue: 0,0:22:50.78,0:22:51.91,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:22:52.91,0:22:54.99,Default,,0,0,0,,Әділдік одақтасына қандай серік.
Dialogue: 0,0:22:55.08,0:22:56.62,Default,,0,0,0,,Сондықтан мен қазірдің өзінде бастадым
Dialogue: 0,0:22:56.70,0:22:59.08,Default,,0,0,0,,Бұл жұмбақ жіп не?
Dialogue: 0,0:22:59.17,0:23:00.63,Default,,0,0,0,,Ах, дұрыс
Dialogue: 0,0:23:00.71,0:23:03.46,Default,,0,0,0,,Мен саған мынаны беру үшін келдім.
Dialogue: 0,0:23:08.67,0:23:11.14,Default,,0,0,0,,Мен үй жануарлары емеспін
Dialogue: 0,0:23:11.22,0:23:14.81,Default,,0,0,0,,Егер сіз өзіңіздің адасушы емес екеніңізді көрсетсеңіз, сіз азырақ қиындыққа тап болуыңыз мүмкін емес пе?
Dialogue: 0,0:23:14.89,0:23:16.52,Default,,0,0,0,,Мәселе мынада...
Dialogue: 0,0:23:16.97,0:23:18.23,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:23:18.31,0:23:20.94,Default,,0,0,0,,Бар болғаныңыздай қалыңыз.
Dialogue: 0,0:23:21.02,0:23:21.98,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:23:22.73,0:23:24.11,Default,,0,0,0,,Жақсы... жақсы жер.
Dialogue: 0,0:23:24.57,0:23:25.82,Default,,0,0,0,,Ах
Dialogue: 0,0:23:27.53,0:23:29.40,Default,,0,0,0,,Күте тұрыңыз, Маширо.
Dialogue: 0,0:23:30.20,0:23:33.07,Default,,0,0,0,,Бұл жіп өте ылғалды.
Dialogue: 0,0:23:34.57,0:23:40.57,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
