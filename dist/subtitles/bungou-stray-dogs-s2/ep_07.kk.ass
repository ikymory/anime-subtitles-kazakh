Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.83,0:00:07.71,Default,,0,0,0,,(Наоми мен Харуноның ауыр тыныс алуы)
Dialogue: 0,0:00:08.46,0:00:10.01,Default,,0,0,0,,Харуно-сан, асығыңыз! (Кирако Харуно) Ой...
Dialogue: 0,0:00:10.09,0:00:11.97,Default,,0,0,0,,Гильдияның табиғаттан тыс күштері жақында осында болады.
Dialogue: 0,0:00:15.43,0:00:16.51,Default,,0,0,0,,Сәлем Наоми-чан
Dialogue: 0,0:00:16.93,0:00:20.68,Default,,0,0,0,,Детективтің адамдары келіп, маған көмектесе ме?
Dialogue: 0,0:00:20.77,0:00:22.14,Default,,0,0,0,,Менің ағам осында.
Dialogue: 0,0:00:23.27,0:00:25.56,Default,,0,0,0,,Ол міндетті түрде маған көмекке келеді.
Dialogue: 0,0:00:30.11,0:00:31.65,Default,,0,0,0,,Жақсы қонақ үй
Dialogue: 0,0:00:31.74,0:00:34.78,Default,,0,0,0,,Жерді өңдесең, жақсы баққа айналады.
Dialogue: 0,0:00:34.99,0:00:36.36,Default,,0,0,0,,Қалай түсіруге болады?
Dialogue: 0,0:00:36.95,0:00:40.41,Default,,0,0,0,,Сіздің қабілетіңізбен олардың басы түсіп қалады.
Dialogue: 0,0:00:40.49,0:00:41.87,Default,,0,0,0,,Жүзімімді алып барайық
Dialogue: 0,0:01:05.94,0:01:10.94,Default,,0,0,0,,(көліктің жүгіру дыбысы)
Dialogue: 0,0:01:16.45,0:01:18.07,Default,,0,0,0,,Онда...
Dialogue: 0,0:01:18.20,0:01:23.20,Default,,0,0,0,,♪~
Dialogue: 0,0:02:42.16,0:02:47.16,Default,,0,0,0,,~♪
Dialogue: 0,0:02:51.17,0:02:52.38,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:52.46,0:02:53.92,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:02:54.21,0:02:56.71,Default,,0,0,0,,Не? (Харуно) Көліктің корпусында бірдеңе бар!
Dialogue: 0,0:02:56.80,0:02:57.63,Default,,0,0,0,,Есік ашылмайды!
Dialogue: 0,0:03:01.80,0:03:03.51,Default,,0,0,0,,Ағаш тамыры? Ах!
Dialogue: 0,0:03:03.60,0:03:05.72,Default,,0,0,0,,Бұлай жалғаса берсе, мен жаншылып қаламын!
Dialogue: 0,0:03:06.01,0:03:07.02,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:10.85,0:03:13.44,Default,,0,0,0,,Кешіріңіз, ханымдар.
Dialogue: 0,0:03:13.90,0:03:14.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:15.06,0:03:15.90,Default,,0,0,0,,Балалар
Dialogue: 0,0:03:16.32,0:03:18.99,Default,,0,0,0,,Жүзім өсіруді білесің бе?
Dialogue: 0,0:03:19.15,0:03:23.62,Default,,0,0,0,,Жүзім бұтақтарының басқа өсімдіктерге жабысу қабілеті күшті.
Dialogue: 0,0:03:23.70,0:03:25.41,Default,,0,0,0,,Сондықтан егеміз, өсеміз
Dialogue: 0,0:03:26.45,0:03:27.66,Default,,0,0,0,,Осы сияқты...
Dialogue: 0,0:03:28.12,0:03:29.29,Default,,0,0,0,,Уау...
Dialogue: 0,0:03:30.00,0:03:31.92,Default,,0,0,0,,Менің жүзім және басқа да өсімдіктерім
Dialogue: 0,0:03:32.00,0:03:33.96,Default,,0,0,0,,Егер біз осылай қосылсақ...
Dialogue: 0,0:03:34.04,0:03:38.00,Default,,0,0,0,,Осы аймақтағы өсімдіктерді денеңіздің жалғасы ретінде пайдалануға болады.
Dialogue: 0,0:03:38.50,0:03:43.22,Default,,0,0,0,,Сезімімізді өсімдіктермен бөлісетіндіктен, тербелістерді жер астындағы тамырлармен ұстаймыз.
Dialogue: 0,0:03:43.30,0:03:47.01,Default,,0,0,0,,Қашып бара жатқан адамды табу оңай...
Dialogue: 0,0:03:47.76,0:03:50.18,Default,,0,0,0,,Соншалықты қорқынышты көрінбе.
Dialogue: 0,0:03:50.27,0:03:52.02,Default,,0,0,0,,Менің сізден сұрайын дегенім бар.
Dialogue: 0,0:03:52.48,0:03:54.56,Default,,0,0,0,,Зұлымдарға арналған «Рересс».
Dialogue: 0,0:03:54.65,0:03:57.48,Default,,0,0,0,,Бұл «пайдалану, ұрлау және лақтыру» сөзінің синонимі.
Dialogue: 0,0:03:57.86,0:04:00.53,Default,,0,0,0,,Гильдиялар зұлым ұйымдар емес.
Dialogue: 0,0:04:00.61,0:04:01.99,Default,,0,0,0,,Әрине мен де...
Dialogue: 0,0:04:03.03,0:04:06.07,Default,,0,0,0,,Менің туған жерімде сіздей бір әпкем бар.
Dialogue: 0,0:04:06.16,0:04:09.74,Default,,0,0,0,,Үлкен отбасында кешкі ас – соғыс
Dialogue: 0,0:04:10.20,0:04:14.46,Default,,0,0,0,,Менің әпкем пирогты жақсы көреді, әрқашан мен сияқты көп жейді.
Dialogue: 0,0:04:14.71,0:04:17.13,Default,,0,0,0,,Бірақ ол сондай сүйкімді, мен оны кешірдім.
Dialogue: 0,0:04:18.04,0:04:19.84,Default,,0,0,0,,Олай болса құтылайық.
Dialogue: 0,0:04:21.26,0:04:22.42,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:04:22.80,0:04:25.18,Default,,0,0,0,,Егер мен сізді қате түсінсем, кешірім сұраймын.
Dialogue: 0,0:04:25.26,0:04:28.68,Default,,0,0,0,,Гильдия жұмысы қиын, бірақ жақсы төлейді.
Dialogue: 0,0:04:28.97,0:04:31.06,Default,,0,0,0,,Мен жұмыстан шығарылсам...
Dialogue: 0,0:04:28.97,0:04:31.06,Default,,0,0,0,,Танжиро~!
Dialogue: 0,0:04:31.14,0:04:33.64,Default,,0,0,0,,Үйдегі отбасылар аштықтан өледі
Dialogue: 0,0:04:31.14,0:04:33.64,Default,,0,0,0,,Оны қазірдің өзінде тоқтатыңыз...
Dialogue: 0,0:04:34.14,0:04:36.02,Default,,0,0,0,,Менің әпкем үшін
Dialogue: 0,0:04:36.23,0:04:38.77,Default,,0,0,0,,Балалар, сендерге не болғаны маған бәрібір.
Dialogue: 0,0:04:40.28,0:04:41.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:42.49,0:04:44.36,Default,,0,0,0,,Осы маусымда қар...
Dialogue: 0,0:04:49.16,0:04:50.54,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:04:51.08,0:04:52.79,Default,,0,0,0,,(Экхарт) Кторигалга басып кірген бейбітшілікке қарсы күштер—
Dialogue: 0,0:04:53.16,0:04:54.41,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:54.62,0:04:55.75,Default,,0,0,0,,Наоми, қаш.
Dialogue: 0,0:04:55.87,0:04:56.96,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:04:57.04,0:05:00.00,Default,,0,0,0,,5 минуттан кейін жолаушылар пойызы жаяу жолдың бойымен өтіп жатыр!
Dialogue: 0,0:05:00.09,0:05:00.59,Default,,0,0,0,,(Локомотив ысқырығы)
Dialogue: 0,0:05:00.59,0:05:03.26,Default,,0,0,0,,(Локомотив ысқырығы)
Dialogue: 0,0:05:00.59,0:05:03.26,Default,,0,0,0,,Мен әңгімені бір минутқа ғана тоқтататындай етіп қостым.
Dialogue: 0,0:05:03.34,0:05:04.63,Default,,0,0,0,,Оған секір!
Dialogue: 0,0:05:05.01,0:05:07.05,Default,,0,0,0,,Енді жүгір! Артқа қарама!
Dialogue: 0,0:05:08.39,0:05:10.01,Default,,0,0,0,,Мен бұлай болатынын сездім.
Dialogue: 0,0:05:10.64,0:05:13.22,Default,,0,0,0,,Бұл сенімсіз ақпарат көзі болды.
Dialogue: 0,0:05:13.85,0:05:16.44,Default,,0,0,0,,Мен сізге бұрын көрсеткен адамның ерекше қабілеті...
Dialogue: 0,0:05:16.89,0:05:18.77,Default,,0,0,0,,Ағашқа қосылғаннан кейін...
Dialogue: 0,0:05:18.86,0:05:22.23,Default,,0,0,0,,Таудың етегіндегі ағаштарды манипуляциялау арқылы пойызды тоқтата аласыз.
Dialogue: 0,0:05:23.11,0:05:26.15,Default,,0,0,0,,Клерктердің қашып кетуіне бес минут қалды.
Dialogue: 0,0:05:26.40,0:05:29.37,Default,,0,0,0,,Оған ағашқа қол тигізбеңіз.
Dialogue: 0,0:05:31.41,0:05:32.24,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:05:32.45,0:05:33.75,Default,,0,0,0,,Куникида мырза!
Dialogue: 0,0:05:34.45,0:05:36.54,Default,,0,0,0,,Мен дәл қазір солай ойладым.
Dialogue: 0,0:05:36.62,0:05:38.37,Default,,0,0,0,,Олар қашып құтылғанша...
Dialogue: 0,0:05:38.46,0:05:41.54,Default,,0,0,0,,Ағаштарға қол тигізбесең, жеңесің.
Dialogue: 0,0:05:41.96,0:05:45.80,Default,,0,0,0,,Егер сіз шайқас жағдайын тым жеңілдетсеңіз, әрекет монотонды болады.
Dialogue: 0,0:05:46.47,0:05:50.09,Default,,0,0,0,,көремін. Оны кейінірек дәптеріме жазып аламын.
Dialogue: 0,0:05:50.72,0:05:54.06,Default,,0,0,0,,Айтпақшы, сіз мұны бұрын ойлаған жоқсыз ба?
Dialogue: 0,0:05:54.31,0:05:58.77,Default,,0,0,0,,«Тапаншаны құлатсаң, шабуылдың басқа құралы болмайды»...
Dialogue: 0,0:05:59.15,0:06:00.90,Default,,0,0,0,,Доппо Гинкьяку!
Dialogue: 0,0:06:03.48,0:06:04.32,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:05.15,0:06:06.90,Default,,0,0,0,,Бала, отыр!
Dialogue: 0,0:06:07.15,0:06:08.91,Default,,0,0,0,,Уф, айналаңа абай бол.
Dialogue: 0,0:06:11.32,0:06:12.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:13.87,0:06:17.83,Default,,0,0,0,,Егер сіз шайқас жағдайын тым жеңілдетсеңіз, әрекет монотонды болады.
Dialogue: 0,0:06:18.41,0:06:20.83,Default,,0,0,0,,Оны кейінірек жазып алыңыз...
Dialogue: 0,0:06:21.25,0:06:25.84,Default,,0,0,0,,Алып державаның құпия ұйымы шет елде адам ұрлау ісімен айналысады.
Dialogue: 0,0:06:25.92,0:06:27.59,Default,,0,0,0,,Менің құлағым ауырады.
Dialogue: 0,0:06:27.92,0:06:30.22,Default,,0,0,0,,Бірақ бастық осылай деді.
Dialogue: 0,0:06:30.30,0:06:32.80,Default,,0,0,0,,«Гильдиялар жақсы істермен айналысатын ұйымдар емес».
Dialogue: 0,0:06:33.05,0:06:35.77,Default,,0,0,0,,«Бұл не істеу керек екенін жасайтын ұйым».
Dialogue: 0,0:06:36.02,0:06:36.85,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:37.06,0:06:38.06,Default,,0,0,0,,Куникида-сан, артыңызда!
Dialogue: 0,0:06:38.35,0:06:39.23,Default,,0,0,0,,Не!?
Dialogue: 0,0:06:41.15,0:06:43.48,Default,,0,0,0,,Сіз мылтық қолдана алмайтын табиғаттан тыс күшке ие адамсыз ба?
Dialogue: 0,0:06:43.56,0:06:45.78,Default,,0,0,0,,Лавкрафт кеш болды (Кукида)...
Dialogue: 0,0:06:46.15,0:06:48.82,Default,,0,0,0,,Сіз не істеп жатырсыз? (Махаббат) Мен ұйықтап жатыр едім...
Dialogue: 0,0:06:48.90,0:06:51.28,Default,,0,0,0,,Коракора (Lovecraft) Кешіріңіз...
Dialogue: 0,0:06:52.57,0:06:54.91,Default,,0,0,0,,Танизаки Жұқа қарда пайда болады!
Dialogue: 0,0:06:54.99,0:06:57.25,Default,,0,0,0,,Уф... (Танизаки) Ахх...
Dialogue: 0,0:06:57.91,0:06:58.87,Default,,0,0,0,,Уф... (Танизаки) Ах...
Dialogue: 0,0:06:59.50,0:07:01.00,Default,,0,0,0,,Бұл қандай күш...
Dialogue: 0,0:07:01.83,0:07:03.96,Default,,0,0,0,,Ерекше қабілет болса да, тым оғаш.
Dialogue: 0,0:07:04.54,0:07:06.50,Default,,0,0,0,,Оларды өлтірмекші ме?
Dialogue: 0,0:07:06.59,0:07:07.46,Default,,0,0,0,,Мен таң қалдым ...
Dialogue: 0,0:07:08.01,0:07:10.55,Default,,0,0,0,,Біріншіден, қыздарды ұстағаннан кейін...
Dialogue: 0,0:07:10.63,0:07:12.09,Default,,0,0,0,,Нұсқауларды сұраңыз
Dialogue: 0,0:07:13.85,0:07:16.51,Default,,0,0,0,,(Наоми мен Харуноның ауыр тыныс алуы)
Dialogue: 0,0:07:17.56,0:07:19.77,Default,,0,0,0,,Міне! (Харуно) О!
Dialogue: 0,0:07:20.18,0:07:21.81,Default,,0,0,0,,Уф... Харуно-сан!
Dialogue: 0,0:07:22.10,0:07:22.94,Default,,0,0,0,,Оу!
Dialogue: 0,0:07:23.02,0:07:25.06,Default,,0,0,0,,(Локомотив ысқырығы)
Dialogue: 0,0:07:25.06,0:07:26.94,Default,,0,0,0,,(Локомотив ысқырығы)
Dialogue: 0,0:07:25.06,0:07:26.94,Default,,0,0,0,,Пойыз... (Харуно) Ах!
Dialogue: 0,0:07:27.02,0:07:29.74,Default,,0,0,0,,Жарайды, жұмыс аяқталды.
Dialogue: 0,0:07:29.82,0:07:32.16,Default,,0,0,0,,Жергілікті полиция келгенге дейін эвакуациялаңыз.
Dialogue: 0,0:07:32.86,0:07:36.24,Default,,0,0,0,,Олай болса, жұқа қарда жоғалып кетудің мәні жоқ.
Dialogue: 0,0:07:36.33,0:07:38.04,Default,,0,0,0,,Қандай да бір жол бар ма?
Dialogue: 0,0:07:38.41,0:07:40.00,Default,,0,0,0,,Әпке, мен оны қарызға аламын.
Dialogue: 0,0:07:40.16,0:07:41.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:42.58,0:07:44.25,Default,,0,0,0,,Наомимен не істемексің?
Dialogue: 0,0:07:44.79,0:07:49.13,Default,,0,0,0,,Мен жауапты емеспін, сондықтан бұл қамау немесе азаптау деп ойлаймын...
Dialogue: 0,0:07:49.42,0:07:52.09,Default,,0,0,0,,Сіздің ойыңызша, мұндай нәрсеге рұқсат етілген бе?
Dialogue: 0,0:07:52.18,0:07:54.22,Default,,0,0,0,,Бұл жұмыс.
Dialogue: 0,0:07:54.30,0:07:57.81,Default,,0,0,0,,Сіз сияқты моральистер түсінбейді деп ойлаймын.
Dialogue: 0,0:07:58.31,0:07:59.27,Default,,0,0,0,,Мораль?
Dialogue: 0,0:07:59.97,0:08:01.23,Default,,0,0,0,,(Жүк машинасының жүгіру дыбысы)
Dialogue: 0,0:08:01.23,0:08:02.06,Default,,0,0,0,,(Жүк көлігінің жүгіру дыбысы)
Dialogue: 0,0:08:01.23,0:08:02.06,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:02.06,0:08:02.77,Default,,0,0,0,,(Жүк көлігінің жүгіру дыбысы)
Dialogue: 0,0:08:02.77,0:08:03.64,Default,,0,0,0,,(Жүк машинасының жүгіру дыбысы)
Dialogue: 0,0:08:02.77,0:08:03.64,Default,,0,0,0,,Жүк көлігі?
Dialogue: 0,0:08:04.48,0:08:07.19,Default,,0,0,0,,Бұл жағдайды көру қиын...
Dialogue: 0,0:08:07.32,0:08:10.03,Default,,0,0,0,,Детективте адамгершілік сезімі бар екені рас.
Dialogue: 0,0:08:10.11,0:08:10.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:11.49,0:08:14.91,Default,,0,0,0,,Бірақ мен үшін Наоми басқаша.
Dialogue: 0,0:08:15.41,0:08:17.53,Default,,0,0,0,,Мораль және зұлымдық-
Dialogue: 0,0:08:17.62,0:08:19.16,Default,,0,0,0,,Мораль және эго
Dialogue: 0,0:08:19.66,0:08:22.96,Default,,0,0,0,,Ол одан да жоғары деңгейде, сондықтан оны салыстыруға болмайды...
Dialogue: 0,0:08:25.04,0:08:25.88,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:26.04,0:08:29.67,Default,,0,0,0,,Әлгі жүк көлігі бізді байқамай ма?
Dialogue: 0,0:08:33.34,0:08:34.18,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:08:34.68,0:08:36.97,Default,,0,0,0,,Бұл жолға ұқсайды ма?
Dialogue: 0,0:08:37.43,0:08:39.93,Default,,0,0,0,,Егер бұл Наоми үшін болса...
Dialogue: 0,0:08:40.06,0:08:42.10,Default,,0,0,0,,Қуана-қуана күйдірер едім дүниені
Dialogue: 0,0:08:43.10,0:08:44.06,Default,,0,0,0,,Ой... аа!
Dialogue: 0,0:08:46.40,0:08:48.19,Default,,0,0,0,,Ах! қозғалысы тоқтады
Dialogue: 0,0:08:48.19,0:08:48.94,Default,,0,0,0,,Ах! қозғалысы тоқтады
Dialogue: 0,0:08:48.19,0:08:48.94,Default,,0,0,0,,(Локомотив ысқырығы)
Dialogue: 0,0:08:48.94,0:08:49.73,Default,,0,0,0,,(Локомотив ысқырығы)
Dialogue: 0,0:08:49.73,0:08:51.15,Default,,0,0,0,,(Локомотив ысқырығы)
Dialogue: 0,0:08:49.73,0:08:51.15,Default,,0,0,0,,Харуно мырза! (Харуно) Ах!
Dialogue: 0,0:08:51.15,0:08:54.11,Default,,0,0,0,,(Локомотив ысқырығы)
Dialogue: 0,0:08:55.32,0:08:56.32,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:56.53,0:08:58.20,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:58.28,0:09:01.37,Default,,0,0,0,,(Наоми мен Харуноның ауыр тыныс алуы)
Dialogue: 0,0:09:01.70,0:09:02.58,Default,,0,0,0,,Харуно-сан!
Dialogue: 0,0:09:02.66,0:09:08.33,Default,,0,0,0,,(Харуноның ауыр тыныс алуы)
Dialogue: 0,0:09:08.67,0:09:09.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:09.59,0:09:11.96,Default,,0,0,0,,Уф! (Харуно) Хааа!
Dialogue: 0,0:09:12.84,0:09:14.17,Default,,0,0,0,,Я...
Dialogue: 0,0:09:14.26,0:09:16.68,Default,,0,0,0,,(Локомотив ысқырығы)
Dialogue: 0,0:09:17.22,0:09:18.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:20.26,0:09:21.97,Default,,0,0,0,,Мен таң қалдым...
Dialogue: 0,0:09:22.10,0:09:23.18,Default,,0,0,0,,Олар ше?
Dialogue: 0,0:09:23.60,0:09:25.18,Default,,0,0,0,,Белгі жоқ
Dialogue: 0,0:09:25.56,0:09:29.56,Default,,0,0,0,,Ол жоғалып, қашып кеткен сияқты.
Dialogue: 0,0:09:29.65,0:09:30.86,Default,,0,0,0,,Қуып алайық
Dialogue: 0,0:09:29.65,0:09:30.86,Default,,0,0,0,,(әскери полиция сиренасы)
Dialogue: 0,0:09:30.86,0:09:31.52,Default,,0,0,0,,(әскери полиция сиренасы)
Dialogue: 0,0:09:31.52,0:09:32.53,Default,,0,0,0,,(әскери полиция сиренасы)
Dialogue: 0,0:09:31.52,0:09:32.53,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:32.53,0:09:33.03,Default,,0,0,0,,(әскери полиция сиренасы)
Dialogue: 0,0:09:35.53,0:09:36.36,Default,,0,0,0,,Хигучи расталды.
Dialogue: 0,0:09:36.78,0:09:37.78,Default,,0,0,0,,Бас кеңсе -
Dialogue: 0,0:09:37.86,0:09:40.24,Default,,0,0,0,,Біз екі адамды ұрлады деп таптық.
Dialogue: 0,0:09:42.45,0:09:45.66,Default,,0,0,0,,Бұл туралы алдын ала хабарланды.
Dialogue: 0,0:09:45.83,0:09:47.75,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:09:47.75,0:09:50.00,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:09:47.75,0:09:50.00,Default,,0,0,0,,Наоми мен оның достары мінген пойыз.
Dialogue: 0,0:09:50.42,0:09:51.84,Default,,0,0,0,,Бұл баяу.
Dialogue: 0,0:09:52.09,0:09:53.63,Default,,0,0,0,,Порт мафиясының Мори мырзасы
Dialogue: 0,0:09:53.71,0:09:55.88,Default,,0,0,0,,Рационализация тұлғасында.
Dialogue: 0,0:09:55.97,0:09:59.14,Default,,0,0,0,,Математикалық формуланың тыныштығымен шайқасты басқарыңыз.
Dialogue: 0,0:09:59.76,0:10:02.93,Default,,0,0,0,,Сондықтан өлтірушілерден қашып, босаңсыған сәтке ұмтылыңыз...
Dialogue: 0,0:10:03.01,0:10:05.43,Default,,0,0,0,,Мен оның бірдеңе жасайтынына сенімдімін.
Dialogue: 0,0:10:08.31,0:10:11.86,Default,,0,0,0,,Қазір біз қауіпсізбіз. (Харуно) Иа... түсіндім.
Dialogue: 0,0:10:12.06,0:10:14.03,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:10:21.62,0:10:22.95,Default,,0,0,0,,Кешіріңіз?
Dialogue: 0,0:10:23.45,0:10:24.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:26.33,0:10:29.04,Default,,0,0,0,,Аа... Кешіріңіз.
Dialogue: 0,0:10:29.17,0:10:30.50,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:10:32.54,0:10:35.96,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:10:35.96,0:10:37.67,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:10:35.96,0:10:37.67,Default,,0,0,0,,Ацуши-кун... (Ацуши) Иә?
Dialogue: 0,0:10:38.17,0:10:40.26,Default,,0,0,0,,Еріксіз жағдайлар туындады
Dialogue: 0,0:10:40.34,0:10:41.43,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:10:42.43,0:10:44.14,Default,,0,0,0,,Дәретханаға бару
Dialogue: 0,0:10:44.22,0:10:44.97,Default,,0,0,0,,Уф, да, а, ағып кетті, ағып кетті, ағып кетті...
Dialogue: 0,0:10:44.97,0:10:46.89,Default,,0,0,0,,Уф, да, а, ағып кетті, ағып кетті, ағып кетті...
Dialogue: 0,0:10:44.97,0:10:46.89,Default,,0,0,0,,Уф... ха...
Dialogue: 0,0:10:58.40,0:11:01.41,Default,,0,0,0,,Мені ешкім көрмейтін жерден шықсам ше?
Dialogue: 0,0:11:02.66,0:11:06.12,Default,,0,0,0,,Эй, Джин Чан... бойың өсті.
Dialogue: 0,0:11:06.58,0:11:07.58,Default,,0,0,0,,(Балға ату дыбысы)
Dialogue: 0,0:11:08.33,0:11:10.79,Default,,0,0,0,,Бақылау болжау дегенді білдіреді ме?
Dialogue: 0,0:11:11.29,0:11:15.38,Default,,0,0,0,,Өйткені мен Порт мафиясының бақылау әдістерін жасаған адам едім.
Dialogue: 0,0:11:15.71,0:11:17.84,Default,,0,0,0,,-да? Сіздің бизнесіңіз қандай?
Dialogue: 0,0:11:18.05,0:11:20.72,Default,,0,0,0,,Бұл мылтық сізге керек деп ойламайсыз ба?
Dialogue: 0,0:11:20.80,0:11:22.51,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:11:22.84,0:11:25.89,Default,,0,0,0,,Қастандық жасағы үшін кадрларды таңдау нашар.
Dialogue: 0,0:11:26.47,0:11:30.06,Default,,0,0,0,,Джин-чан, бұл қауіпті, мынаны түсіре аласың ба?
Dialogue: 0,0:11:31.35,0:11:32.27,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:32.81,0:11:34.98,Default,,0,0,0,,Істің басқа екені рас.
Dialogue: 0,0:11:35.52,0:11:37.78,Default,,0,0,0,,Маған бастықтан хабарлама келді.
Dialogue: 0,0:11:37.86,0:11:40.11,Default,,0,0,0,,Эй, Мори мырзадан...
Dialogue: 0,0:11:40.61,0:11:41.78,Default,,0,0,0,,Біз жас бәсекелестер ақыл-парасатымыз таусылып, әбден таңырқап қаламыз, солай ма~?
Dialogue: 0,0:11:41.86,0:11:43.32,Default,,0,0,0,,Міне, хабарлама
Dialogue: 0,0:11:44.57,0:11:45.91,Default,,0,0,0,,Дазай-кун
Dialogue: 0,0:11:46.45,0:11:49.95,Default,,0,0,0,,Порт мафиясының басшылығына қайтып оралу ниетіңіз бар ма?
Dialogue: 0,0:11:51.83,0:11:55.42,Default,,0,0,0,,Уфуфуфуфуфу… хахаха…
Dialogue: 0,0:11:55.50,0:11:59.09,Default,,0,0,0,,Бұл өте жақсы шақыру.
Dialogue: 0,0:11:59.17,0:12:01.13,Default,,0,0,0,,Мен сіздің жазбаңызды көрдім
Dialogue: 0,0:11:59.17,0:12:01.13,Default,,0,0,0,,Хехе...
Dialogue: 0,0:12:02.68,0:12:05.22,Default,,0,0,0,,Сіздің қаныңыз қара мафия
Dialogue: 0,0:12:05.34,0:12:06.80,Default,,0,0,0,,Бұл елдегі басқалардан артық...
Dialogue: 0,0:12:07.18,0:12:09.22,Default,,0,0,0,,Адамдар өзгереді.
Dialogue: 0,0:12:09.31,0:12:11.39,Default,,0,0,0,,Негізі Джин Чан сонда да.
Dialogue: 0,0:12:11.48,0:12:13.27,Default,,0,0,0,,Бұрын бұл кішкентай еді...
Dialogue: 0,0:12:13.64,0:12:16.52,Default,,0,0,0,,Ол әдемі қыз еді (Хигучи) Иә?
Dialogue: 0,0:12:16.77,0:12:18.73,Default,,0,0,0,,Тақырыпты өзгертпеңіз...
Dialogue: 0,0:12:28.24,0:12:29.08,Default,,0,0,0,,Ах
Dialogue: 0,0:12:29.54,0:12:32.75,Default,,0,0,0,,Харуно-сан, Наоми-сан, жақсысың ба?
Dialogue: 0,0:12:32.83,0:12:33.66,Default,,0,0,0,,Иә
Dialogue: 0,0:12:34.21,0:12:36.50,Default,,0,0,0,,Бірақ мен ешқашан кеңсе қызметкерін нысанаға алады деп ойламадым...
Dialogue: 0,0:12:37.00,0:12:41.26,Default,,0,0,0,,Уайымдамаңыз, біз сізді эвакуациялау базасына дейін шығарып саламыз.
Dialogue: 0,0:12:42.26,0:12:44.59,Default,,0,0,0,,Бірақ мағынасы жоқ...
Dialogue: 0,0:12:44.68,0:12:48.10,Default,,0,0,0,,Мен Мори мырзаның өз қызметкерлерін мұндай фарсқа бөлетініне сене алмаймын.
Dialogue: 0,0:12:48.18,0:12:51.35,Default,,0,0,0,,Сені қорғау үшін (Дазай) Сені қорғау үшін бе?
Dialogue: 0,0:12:52.52,0:12:55.10,Default,,0,0,0,,Бастық түрмеден «Q» шығарды.
Dialogue: 0,0:12:55.35,0:12:56.35,Default,,0,0,0,,Не!
Dialogue: 0,0:12:57.90,0:12:59.86,Default,,0,0,0,,Иә, мен сені таныстырамын.
Dialogue: 0,0:13:00.36,0:13:02.19,Default,,0,0,0,,Біз пойызда кездестік...
Dialogue: 0,0:13:04.36,0:13:05.36,Default,,0,0,0,,Қап…
Dialogue: 0,0:13:07.57,0:13:08.87,Default,,0,0,0,,Хехе...
Dialogue: 0,0:13:09.20,0:13:10.20,Default,,0,0,0,,О...
Dialogue: 0,0:13:11.83,0:13:12.83,Default,,0,0,0,,Ах
Dialogue: 0,0:13:14.66,0:13:18.54,Default,,0,0,0,,Не? Қолына лентамен оралған ұстара бар.
Dialogue: 0,0:13:19.13,0:13:21.59,Default,,0,0,0,,Бұл сәл ғана соққы болды...
Dialogue: 0,0:13:21.67,0:13:23.55,Default,,0,0,0,,Ұстара қолымды ауыртты...
Dialogue: 0,0:13:25.84,0:13:27.55,Default,,0,0,0,,Кәне, ойнайық
Dialogue: 0,0:13:28.47,0:13:29.55,Default,,0,0,0,,Ақымақ...
Dialogue: 0,0:13:30.10,0:13:32.93,Default,,0,0,0,,Сіз нені ашқаныңызды білесіз бе?
Dialogue: 0,0:13:33.10,0:13:37.27,Default,,0,0,0,,Q - барлық жаулар мен одақтастарды жойатын жаяу апат.
Dialogue: 0,0:13:37.35,0:13:39.36,Default,,0,0,0,,Күресті жеңу болса...
Dialogue: 0,0:13:39.44,0:13:41.61,Default,,0,0,0,,Порт мафиясы қолынан келгеннің бәрін жасайды
Dialogue: 0,0:13:42.11,0:13:45.11,Default,,0,0,0,,Қалай ойлайсыңдар, Q түрме камерасында неліктен мөрленді?
Dialogue: 0,0:13:46.57,0:13:48.32,Default,,0,0,0,,Nii…
Dialogue: 0,0:13:48.41,0:13:49.16,Default,,0,0,0,,(Қуыршақтың күлкісі)
Dialogue: 0,0:13:49.16,0:13:51.95,Default,,0,0,0,,(Қуыршақтың күлкісі)
Dialogue: 0,0:13:49.16,0:13:51.95,Default,,0,0,0,,Табиғаттан тыс қабілеттердің ішіндегі ең жиіркеніштісі.
Dialogue: 0,0:13:51.95,0:13:52.03,Default,,0,0,0,,(Қуыршақтың күлкісі)
Dialogue: 0,0:13:52.03,0:13:54.33,Default,,0,0,0,,(Қуыршақтың күлкісі)
Dialogue: 0,0:13:52.03,0:13:54.33,Default,,0,0,0,,Өйткені оның ақыл-ойды басқару қабілеті бар.
Dialogue: 0,0:13:54.79,0:13:55.75,Default,,0,0,0,,А...
Dialogue: 0,0:13:55.83,0:13:57.83,Default,,0,0,0,,Хахаха... ахх...
Dialogue: 0,0:13:57.83,0:13:58.67,Default,,0,0,0,,Хахаха... ахх...
Dialogue: 0,0:13:57.83,0:13:58.67,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:58.67,0:13:59.83,Default,,0,0,0,,Хахаха... ахх...
Dialogue: 0,0:13:59.92,0:14:00.75,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:01.09,0:14:02.80,Default,,0,0,0,,Иә? Уау...
Dialogue: 0,0:14:03.63,0:14:04.88,Default,,0,0,0,,О...
Dialogue: 0,0:14:04.96,0:14:05.42,Default,,0,0,0,,Бірдеңе істемесем, өлемін.
Dialogue: 0,0:14:05.42,0:14:06.97,Default,,0,0,0,,Бірдеңе істемесем, өлемін.
Dialogue: 0,0:14:05.42,0:14:06.97,Default,,0,0,0,,Қарғыс атсын... Қарғыс атсын!
Dialogue: 0,0:14:07.05,0:14:09.89,Default,,0,0,0,,Ух... жаудың ерекше қабілетті шабуылы...
Dialogue: 0,0:14:11.05,0:14:13.89,Default,,0,0,0,,Мен... барлығын қорғауым керек.
Dialogue: 0,0:14:14.77,0:14:17.10,Default,,0,0,0,,Сіз ештеңені қорғай алмайсыз
Dialogue: 0,0:14:17.48,0:14:19.65,Default,,0,0,0,,Сіз нені қорғай аласыз?
Dialogue: 0,0:14:20.40,0:14:23.57,Default,,0,0,0,,Жоқ, мен бұрынғыдай емеспін.
Dialogue: 0,0:14:24.98,0:14:26.61,Default,,0,0,0,,Менің күшім бар!
Dialogue: 0,0:14:29.07,0:14:30.61,Default,,0,0,0,,Кешіріңіз, Харуно-сан!
Dialogue: 0,0:14:31.57,0:14:32.58,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:32.99,0:14:33.99,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:36.00,0:14:38.50,Default,,0,0,0,,Q-ның қарғысы белсендірілгендер...
Dialogue: 0,0:14:38.58,0:14:41.17,Default,,0,0,0,,Оның санасына галлюцинация әсер етеді және ол айналасындағыларға еріксіз шабуыл жасайды.
Dialogue: 0,0:14:41.17,0:14:42.46,Default,,0,0,0,,Оның санасына галлюцинация әсер етеді және ол айналасындағыларға бей-берекет шабуыл жасайды.
Dialogue: 0,0:14:41.17,0:14:42.46,Default,,0,0,0,,Мен үйге барамын.
Dialogue: 0,0:14:42.54,0:14:43.13,Default,,0,0,0,,(Қуыршақтың күлкісі)
Dialogue: 0,0:14:43.13,0:14:45.21,Default,,0,0,0,,(Қуыршақтың күлкісі)
Dialogue: 0,0:14:43.13,0:14:45.21,Default,,0,0,0,,Қарғысқа не себеп болады?
Dialogue: 0,0:14:45.21,0:14:45.30,Default,,0,0,0,,(Қуыршақтың күлкісі)
Dialogue: 0,0:14:45.30,0:14:48.51,Default,,0,0,0,,(Қуыршақтың күлкісі)
Dialogue: 0,0:14:45.30,0:14:48.51,Default,,0,0,0,,Қарғыстың көзі болған қуыршақ жойылады.
Dialogue: 0,0:14:49.26,0:14:51.59,Default,,0,0,0,,Алайда қуыршақ жойылғанда -
Dialogue: 0,0:14:51.68,0:14:54.14,Default,,0,0,0,,Тек алушыға ғана қарғыс
Dialogue: 0,0:14:54.39,0:14:58.27,Default,,0,0,0,,Реципиент болудың шарты Q-ға зиян келтіру.
Dialogue: 0,0:14:58.56,0:14:59.85,Default,,0,0,0,,алушының денесінде -
Dialogue: 0,0:15:00.27,0:15:03.31,Default,,0,0,0,,Біреу мені ұстап алғандай көгергендіктен...
Dialogue: 0,0:15:03.40,0:15:04.90,Default,,0,0,0,,Айыру оңай
Dialogue: 0,0:15:05.98,0:15:06.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:07.19,0:15:10.86,Default,,0,0,0,,Мұнда келгенде «мені қорғау үшін» дедің...
Dialogue: 0,0:15:13.28,0:15:14.83,Default,,0,0,0,,Ха! Ол кетті!
Dialogue: 0,0:15:15.28,0:15:18.16,Default,,0,0,0,,Уф... Кук...
Dialogue: 0,0:15:18.37,0:15:21.54,Default,,0,0,0,,Тоқта, Атсуши-кун, мұқият қара!
Dialogue: 0,0:15:21.62,0:15:22.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:23.21,0:15:26.75,Default,,0,0,0,,Қарғыс атсын... Атсуши-сан, тоқта...
Dialogue: 0,0:15:26.84,0:15:28.76,Default,,0,0,0,,(Харуноның үрейлі дауысы)
Dialogue: 0,0:15:30.51,0:15:31.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:31.76,0:15:32.22,Default,,0,0,0,,(Наомидің жөтелі)
Dialogue: 0,0:15:32.22,0:15:33.59,Default,,0,0,0,,(Наомидің жөтелі)
Dialogue: 0,0:15:32.22,0:15:33.59,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:33.59,0:15:33.89,Default,,0,0,0,,(Наомидің жөтелі)
Dialogue: 0,0:15:33.89,0:15:36.56,Default,,0,0,0,,(Наомидің жөтелі)
Dialogue: 0,0:15:33.89,0:15:36.56,Default,,0,0,0,,Әу бастан айла-шарғы жасаған жалғыз мен болдым ба...
Dialogue: 0,0:15:38.14,0:15:40.56,Default,,0,0,0,,Мен барлығын қорғауға тырыстым...
Dialogue: 0,0:15:41.27,0:15:43.77,Default,,0,0,0,,Бәріне сен кінәлі (Ацуши) Ха!
Dialogue: 0,0:15:44.27,0:15:47.23,Default,,0,0,0,,Билікке жегіліп, басқаларға зиян келтірудің мәні
Dialogue: 0,0:15:47.32,0:15:48.65,Default,,0,0,0,,Өмір бойы өзгермейді
Dialogue: 0,0:15:48.90,0:15:51.57,Default,,0,0,0,,Жоқ! Мен өзгергім келеді...
Dialogue: 0,0:15:51.90,0:15:54.07,Default,,0,0,0,,Барлығын қорғауға тырысамын...
Dialogue: 0,0:15:51.90,0:15:54.07,Default,,0,0,0,,(Қуыршақтың күлкісі)
Dialogue: 0,0:15:54.07,0:15:54.41,Default,,0,0,0,,(Қуыршақтың күлкісі)
Dialogue: 0,0:15:54.41,0:15:55.70,Default,,0,0,0,,(Қуыршақтың күлкісі)
Dialogue: 0,0:15:54.41,0:15:55.70,Default,,0,0,0,,Цк... а...
Dialogue: 0,0:15:55.70,0:15:57.08,Default,,0,0,0,,(Қуыршақтың күлкісі)
Dialogue: 0,0:15:57.16,0:16:00.04,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:16:03.50,0:16:07.17,Default,,0,0,0,,Енді түсіндің бе? Мен кіммін?
Dialogue: 0,0:16:07.92,0:16:11.22,Default,,0,0,0,,Жоғал... Ерекше қабілет Адам ретінде жарамсыз!
Dialogue: 0,0:16:13.88,0:16:15.72,Default,,0,0,0,,(Локомотив ысқырығы)
Dialogue: 0,0:16:15.72,0:16:16.30,Default,,0,0,0,,(Локомотив ысқырығы)
Dialogue: 0,0:16:15.72,0:16:16.30,Default,,0,0,0,,Дазай-санның жаңа достары нәзік, солай емес пе?
Dialogue: 0,0:16:16.30,0:16:19.26,Default,,0,0,0,,Дазай-санның жаңа достары нәзік, солай емес пе?
Dialogue: 0,0:16:19.35,0:16:21.23,Default,,0,0,0,,Цу... (Q) Бірақ бәрібір.
Dialogue: 0,0:16:21.31,0:16:24.31,Default,,0,0,0,,Дазай-санды құрту қуанышы қалды.
Dialogue: 0,0:16:25.81,0:16:27.65,Default,,0,0,0,,Мені қамап қойғаныңыз үшін рахмет
Dialogue: 0,0:16:27.73,0:16:30.90,Default,,0,0,0,,Мен сені қатты қинаймын, сені сындырамын.
Dialogue: 0,0:16:31.61,0:16:35.32,Default,,0,0,0,,Келесі жолы пломбаламаймын, Жүрегімді қиып аламын.
Dialogue: 0,0:16:35.78,0:16:37.28,Default,,0,0,0,,Қайтадан ойнайық~ Дазай-сан~
Dialogue: 0,0:16:37.28,0:16:38.83,Default,,0,0,0,,Қайтадан ойнайық~ Дазай-сан~
Dialogue: 0,0:16:37.28,0:16:38.83,Default,,0,0,0,,(Локомотив ысқырығы)
Dialogue: 0,0:16:38.83,0:16:39.83,Default,,0,0,0,,(Локомотив ысқырығы)
Dialogue: 0,0:16:39.83,0:16:42.29,Default,,0,0,0,,(Локомотив ысқырығы)
Dialogue: 0,0:16:39.83,0:16:42.29,Default,,0,0,0,,(Ацушидің үрейлі дауысы)
Dialogue: 0,0:16:42.29,0:16:44.83,Default,,0,0,0,,(Ацушидің үрейлі дауысы)
Dialogue: 0,0:16:48.50,0:16:50.92,Default,,0,0,0,,Жүр, Атсуши-кун, тұр.
Dialogue: 0,0:16:51.26,0:16:53.13,Default,,0,0,0,,Менің қолымнан келмейді!
Dialogue: 0,0:16:53.22,0:16:55.68,Default,,0,0,0,,Менде болмауы керек...
Dialogue: 0,0:16:55.97,0:17:00.31,Default,,0,0,0,,(Ацушидің үрейлі дауысы)
Dialogue: 0,0:17:00.39,0:17:02.85,Default,,0,0,0,,Ацуши-кун (Ацуши) Ха...
Dialogue: 0,0:17:08.90,0:17:10.82,Default,,0,0,0,,Тыңда, Атсуши-кун.
Dialogue: 0,0:17:11.98,0:17:14.36,Default,,0,0,0,,Оқта-текте аға сияқты кеңес берейік.
Dialogue: 0,0:17:15.99,0:17:17.78,Default,,0,0,0,,Өзіңді аяма
Dialogue: 0,0:17:18.74,0:17:22.62,Default,,0,0,0,,Өзіңді аясаң, өмір бітпейтін қорқынышты түн болады
Dialogue: 0,0:17:26.04,0:17:27.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:28.46,0:17:29.75,Default,,0,0,0,,Қазір...
Dialogue: 0,0:17:30.29,0:17:33.63,Default,,0,0,0,,Біздің құралдарымызды таңдайтын уақыт емес.
Dialogue: 0,0:17:34.26,0:17:38.43,Default,,0,0,0,,Жау разы болса, Онисуда тегін де кесіп алайық.
Dialogue: 0,0:17:41.72,0:17:43.35,Default,,0,0,0,,Стратегияны қайта жазыңыз.
Dialogue: 0,0:17:43.97,0:17:46.48,Default,,0,0,0,,А... аа...
Dialogue: 0,0:17:46.69,0:17:49.31,Default,,0,0,0,,Мм... иә
Dialogue: 0,0:17:49.65,0:17:52.19,Default,,0,0,0,,Сол ұзақ әңгімеге қатысты бірдеңе істей аламыз ба?
Dialogue: 0,0:17:52.27,0:17:55.03,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:17:55.11,0:17:56.40,Default,,0,0,0,,Мен қайтамын...
Dialogue: 0,0:17:57.11,0:17:58.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:58.57,0:17:59.03,Default,,0,0,0,,Жолда оқу Келесі жұмыс аймағы қандай?
Dialogue: 0,0:17:59.03,0:18:01.91,Default,,0,0,0,,Қозғалыспен оқу Келесі жұмыс аймағы қандай?
Dialogue: 0,0:17:59.03,0:18:01.91,Default,,0,0,0,,А, ә... а...
Dialogue: 0,0:18:02.03,0:18:03.58,Default,,0,0,0,,Бұл қауіпті.
Dialogue: 0,0:18:03.66,0:18:05.62,Default,,0,0,0,,Енді негізгі жолаушылар кемесі құлады―
Dialogue: 0,0:18:05.70,0:18:09.17,Default,,0,0,0,,Маған Фрэнсис үйде қалып, тыныш болуы керек...
Dialogue: 0,0:18:10.17,0:18:13.30,Default,,0,0,0,,Мен тұрған жер гильдия негізі.
Dialogue: 0,0:18:13.42,0:18:14.76,Default,,0,0,0,,Оны қалай тоқтатамыз?
Dialogue: 0,0:18:15.09,0:18:18.09,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:18:20.05,0:18:21.85,Default,,0,0,0,,О, Ваппа (Ацуши) О!
Dialogue: 0,0:18:21.93,0:18:22.76,Default,,0,0,0,,Бір адамды өзгерту керек пе?
Dialogue: 0,0:18:23.72,0:18:25.22,Default,,0,0,0,,Неліктен мұнда?
Dialogue: 0,0:18:25.72,0:18:28.14,Default,,0,0,0,,Мен Дазаймен мәміле жасадым.
Dialogue: 0,0:18:28.64,0:18:31.11,Default,,0,0,0,,«Егер сіз жоғалған Киоканы құтқарғыңыз келсе-»
Dialogue: 0,0:18:31.19,0:18:34.36,Default,,0,0,0,,«Тыныш бол және осында күт».
Dialogue: 0,0:18:34.94,0:18:39.28,Default,,0,0,0,,Ваппа жақсы ма? Мен Дазайдың қасында болмасам да...
Dialogue: 0,0:18:39.78,0:18:41.20,Default,,0,0,0,,Дазай-сан...
Dialogue: 0,0:18:41.28,0:18:42.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:42.53,0:18:45.66,Default,,0,0,0,,Мемлекеттік агенттермен келіссөздерге барды
Dialogue: 0,0:18:45.87,0:18:49.92,Default,,0,0,0,,(көліктің жүгіру дыбысы)
Dialogue: 0,0:18:53.29,0:18:55.63,Default,,0,0,0,,Мен сені ешқашан кешірмеймін!
Dialogue: 0,0:18:55.71,0:18:57.63,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:18:58.38,0:19:00.97,Default,,0,0,0,,Дазай-кун, неше жыл болды?
Dialogue: 0,0:19:01.43,0:19:03.72,Default,,0,0,0,,Қоңырау соққанда таң қалдым.
Dialogue: 0,0:19:04.01,0:19:06.85,Default,,0,0,0,,Эй Анго, сен жақсы көрінесің.
Dialogue: 0,0:19:09.27,0:19:11.27,Default,,0,0,0,,Сені көргеніме қуаныштымын, Анго.
Dialogue: 0,0:19:11.44,0:19:13.40,Default,,0,0,0,,Бұлай ойлауға не себеп болды?
Dialogue: 0,0:19:13.48,0:19:16.15,Default,,0,0,0,,Мен сені кешірдім
Dialogue: 0,0:19:19.24,0:19:23.37,Default,,0,0,0,,Қызық, бұл бәрібір түсірілді ме?
Dialogue: 0,0:19:23.62,0:19:24.49,Default,,0,0,0,,Мен сізге қалай көмектесе аламын?
Dialogue: 0,0:19:25.08,0:19:26.29,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:19:26.74,0:19:28.25,Default,,0,0,0,,Мен көрдім...
Dialogue: 0,0:19:28.75,0:19:34.29,Default,,0,0,0,,Арнайы қабілеттілік бөлімі туралы айтатын болсақ, бұл елдегі ең құпия аномал ұйым.
Dialogue: 0,0:19:34.46,0:19:39.30,Default,,0,0,0,,Егер сіз одақтас болсаңыз, детективтік агенттік сіздің ең үлкен трамплин болады.
Dialogue: 0,0:19:39.42,0:19:43.72,Default,,0,0,0,,Егер біз мұны жасасақ, Киока-чан көп ұзамай детективтік агенттікке орала алады.
Dialogue: 0,0:19:44.05,0:19:45.80,Default,,0,0,0,,Өтінемін... (Ацуши) Әй?
Dialogue: 0,0:19:46.18,0:19:47.51,Default,,0,0,0,,Ноу Ваппа
Dialogue: 0,0:19:47.93,0:19:51.98,Default,,0,0,0,,Бірнеше ай ғана жаттығу жасаған 14 жасар қыз
Dialogue: 0,0:19:52.06,0:19:56.69,Default,,0,0,0,,Сіз шынымен 35 адамды өлтіре аламын деп ойлайсыз ба?
Dialogue: 0,0:19:57.69,0:19:59.07,Default,,0,0,0,,Бұл талант.
Dialogue: 0,0:19:59.44,0:20:03.61,Default,,0,0,0,,Талантты Киоканың жан-дүниесімен түнектеніп жатқандықтан...
Dialogue: 0,0:20:03.78,0:20:06.33,Default,,0,0,0,,Ол бала қараңғылықтан құтыла алмайды.
Dialogue: 0,0:20:06.78,0:20:08.83,Default,,0,0,0,,Мен бұрынғыдай
Dialogue: 0,0:20:09.16,0:20:10.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:11.33,0:20:12.21,Default,,0,0,0,,Ваппа
Dialogue: 0,0:20:14.83,0:20:16.59,Default,,0,0,0,,Киокаға сұраңыз
Dialogue: 0,0:20:18.25,0:20:22.93,Default,,0,0,0,,Арнайы істер бөлімінің рөлі ерекше қабілеттері бар қылмыстық ұйымдармен күресу болып табылады.
Dialogue: 0,0:20:23.01,0:20:25.26,Default,,0,0,0,,Міндетке немқұрайлы қарау жақсы емес.
Dialogue: 0,0:20:25.34,0:20:28.31,Default,,0,0,0,,Біз гильдия әрекетінен хабардармыз.
Dialogue: 0,0:20:28.76,0:20:30.81,Default,,0,0,0,,Бұл олар бұл туралы біліп, оны жалғыз қалдырды дегенді білдіре ме?
Dialogue: 0,0:20:31.27,0:20:33.98,Default,,0,0,0,,Олар дипломатиялық көздерден қысым көрсетті
Dialogue: 0,0:20:34.06,0:20:37.69,Default,,0,0,0,,Мүшелерге дипломаттар сияқты өкілеттік берілді.
Dialogue: 0,0:20:38.27,0:20:40.94,Default,,0,0,0,,Олар енді заңнан тыс...
Dialogue: 0,0:20:41.44,0:20:44.57,Default,,0,0,0,,Құқық қорғау органдары тіпті гильдияларды ұстай алмайды.
Dialogue: 0,0:20:45.66,0:20:46.87,Default,,0,0,0,,(Көлік тежегішінің дыбысы)
Dialogue: 0,0:20:47.20,0:20:49.58,Default,,0,0,0,,Дазай-кун, қазір қашып кет!
Dialogue: 0,0:20:49.79,0:20:51.16,Default,,0,0,0,,Ах... (Анго) Маған айтыңызшы.
Dialogue: 0,0:20:51.25,0:20:53.00,Default,,0,0,0,,Анго... (Анго) Сіздің бағыныштыңызға қауіп төніп тұр...
Dialogue: 0,0:20:53.21,0:20:54.87,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:20:57.63,0:20:59.54,Default,,0,0,0,,(кеме ысқырығы)
Dialogue: 0,0:20:59.63,0:21:01.96,Default,,0,0,0,,Дазай-сан, кешігіп қалдың...
Dialogue: 0,0:21:02.71,0:21:04.38,Default,,0,0,0,,Мен сені күттірдім бе? (Ацуши) Иә?
Dialogue: 0,0:21:05.38,0:21:06.39,Default,,0,0,0,,Уф!
Dialogue: 0,0:21:07.30,0:21:08.30,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:21:10.14,0:21:12.93,Default,,0,0,0,,Бұл әдеттегі реакция. Бұл қызықсыз.
Dialogue: 0,0:21:13.68,0:21:17.44,Default,,0,0,0,,Қандай күшті күш. Сіз табиғаттан тыс күштің жауынгерлік түрісіз бе?
Dialogue: 0,0:21:17.65,0:21:20.02,Default,,0,0,0,,Бірақ бұл жігітті жеңсек, соғыс бітеді!
Dialogue: 0,0:21:24.32,0:21:26.45,Default,,0,0,0,,Сіздің қазіргі соққыңыз жақсы.
Dialogue: 0,0:21:26.53,0:21:28.57,Default,,0,0,0,,Бұл шамамен $10 000 тұрады.
Dialogue: 0,0:21:28.91,0:21:30.41,Default,,0,0,0,,Бірақ... (Ацуши) Уф...
Dialogue: 0,0:21:31.62,0:21:32.95,Default,,0,0,0,,Аххххх...
Dialogue: 0,0:21:33.66,0:21:37.42,Default,,0,0,0,,Біздің сізге берген сыйлығымыз 7 млрд.
Dialogue: 0,0:21:33.66,0:21:37.42,Default,,0,0,0,,Ка… Кууууу…
Dialogue: 0,0:21:37.50,0:21:38.42,Default,,0,0,0,,Я...
Dialogue: 0,0:21:38.50,0:21:41.38,Default,,0,0,0,,Мен оны мұндай деңгейде сатып ала алмаймын (Ацуши) Уф...
Dialogue: 0,0:21:41.46,0:21:41.63,Default,,0,0,0,,♪~
Dialogue: 0,0:21:41.63,0:21:43.30,Default,,0,0,0,,♪~
Dialogue: 0,0:21:41.63,0:21:43.30,Default,,0,0,0,,Бірақ мұңаймаңыз
Dialogue: 0,0:21:43.30,0:21:43.55,Default,,0,0,0,,♪~
Dialogue: 0,0:21:43.55,0:21:46.09,Default,,0,0,0,,♪~
Dialogue: 0,0:21:43.55,0:21:46.09,Default,,0,0,0,,Сенің құндылығың басқа (Ацуши) Ха... Ах...
Dialogue: 0,0:21:47.34,0:21:49.55,Default,,0,0,0,,Жүр, мен сенімен бірге барайын.
Dialogue: 0,0:21:50.76,0:21:52.89,Default,,0,0,0,,Бұл бұрынғыдай...
Dialogue: 0,0:21:53.85,0:21:56.52,Default,,0,0,0,,Мен... тағы да...
Dialogue: 0,0:21:57.52,0:21:59.23,Default,,0,0,0,,Күтесіз бе?
Dialogue: 0,0:21:59.77,0:22:01.11,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:22:04.28,0:22:05.11,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:06.90,0:22:09.20,Default,,0,0,0,,Киока…чан
Dialogue: 0,0:23:34.95,0:23:39.96,Default,,0,0,0,,~♪
