Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.51,0:00:17.35,Default,,0,0,0,,Жапырақтардың түсуінің сұлулығы
Dialogue: 0,0:00:20.77,0:00:24.94,Default,,0,0,0,,Бірақ бүршік болып шашылмаған.
Dialogue: 0,0:00:25.02,0:00:30.03,Default,,0,0,0,,♪~
Dialogue: 0,0:01:49.90,0:01:54.90,Default,,0,0,0,,~♪
Dialogue: 0,0:01:55.07,0:01:57.90,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:02:05.62,0:02:08.83,Default,,0,0,0,,Иә, мені күт, бүгін карри мен күріш.
Dialogue: 0,0:02:09.04,0:02:11.58,Default,,0,0,0,,Ағам күткендей дәмді көрінеді.
Dialogue: 0,0:02:11.67,0:02:13.00,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:13.09,0:02:15.05,Default,,0,0,0,,Итадакимасу (Танизаки) соусы соусы
Dialogue: 0,0:02:15.46,0:02:17.13,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:17.42,0:02:18.80,Default,,0,0,0,,Енді ойлап қарасам, аға...
Dialogue: 0,0:02:19.26,0:02:22.22,Default,,0,0,0,,Баумкученді мен кеше порттың жанындағы дүкенде көрдім.
Dialogue: 0,0:02:22.30,0:02:24.18,Default,,0,0,0,,Мен үшін сатып алдың ба? (Танизаки) Ах...
Dialogue: 0,0:02:25.01,0:02:26.27,Default,,0,0,0,,Сіз ұмыттыңыз ба?
Dialogue: 0,0:02:26.64,0:02:28.23,Default,,0,0,0,,Мен айттым ғой!
Dialogue: 0,0:02:28.60,0:02:31.15,Default,,0,0,0,,Мен оны бүгін міндетті түрде жегім келеді!
Dialogue: 0,0:02:31.23,0:02:33.02,Default,,0,0,0,,Аа, кешіріңіз...
Dialogue: 0,0:02:33.82,0:02:35.48,Default,,0,0,0,,Айтпақшы... Хм...
Dialogue: 0,0:02:36.11,0:02:38.32,Default,,0,0,0,,«Бұл» бұл?
Dialogue: 0,0:02:41.95,0:02:43.03,Default,,0,0,0,,～
Dialogue: 0,0:02:43.24,0:02:44.87,Default,,0,0,0,,Әй, бауырым...
Dialogue: 0,0:02:44.95,0:02:46.91,Default,,0,0,0,,Мен мұны осылай істеймін~ (Танизаки) Эй, эй, Наоми...
Dialogue: 0,0:02:47.00,0:02:49.41,Default,,0,0,0,,Наоми, тоқтат! Бұл сияқты!
Dialogue: 0,0:02:54.38,0:02:55.21,Default,,0,0,0,,Аға
Dialogue: 0,0:02:55.67,0:02:57.76,Default,,0,0,0,,Сіз тамақ ішіп отырып жұмыс істейсіз бе?
Dialogue: 0,0:02:57.84,0:03:00.34,Default,,0,0,0,,Мен қалалық полициядан әңгімелесу жазбасын алдым.
Dialogue: 0,0:03:00.43,0:03:01.59,Default,,0,0,0,,Киока-чандікі
Dialogue: 0,0:03:01.80,0:03:05.47,Default,,0,0,0,,Егер есімде дұрыс болса, ол порт мафиясына дейін жетім болған...
Dialogue: 0,0:03:05.72,0:03:08.18,Default,,0,0,0,,Сол үшін жетім қалдым...
Dialogue: 0,0:03:08.73,0:03:10.94,Default,,0,0,0,,Сіздің ата-анаңыз өлтірілді.
Dialogue: 0,0:03:12.65,0:03:14.15,Default,,0,0,0,,Кінәлі...
Dialogue: 0,0:03:17.11,0:03:18.15,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:03:18.15,0:03:19.15,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:03:18.15,0:03:19.15,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:19.15,0:03:20.61,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:03:22.24,0:03:24.45,Default,,0,0,0,,Тоқта, мен саған жұмыс таптым.
Dialogue: 0,0:03:25.16,0:03:26.66,Default,,0,0,0,,Бұған дейін бұл
Dialogue: 0,0:03:26.74,0:03:28.37,Default,,0,0,0,,Есту мылтығын ату
Dialogue: 0,0:03:29.16,0:03:31.08,Default,,0,0,0,,Порт мафиясы бізді де нысанаға алған шығар.
Dialogue: 0,0:03:31.16,0:03:32.75,Default,,0,0,0,,Өзін-өзі қорғау үшін
Dialogue: 0,0:03:33.08,0:03:36.38,Default,,0,0,0,,Бұл жолы ешқандай қауіп жоқ деп ойлаймын.
Dialogue: 0,0:03:36.63,0:03:37.88,Default,,0,0,0,,Қандай жұмыс түрі?
Dialogue: 0,0:03:37.96,0:03:41.93,Default,,0,0,0,,Осы дәлелдер салынған конвертті соттағы судьяға беріңіз.
Dialogue: 0,0:03:42.22,0:03:43.22,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:03:43.68,0:03:45.05,Default,,0,0,0,,Бұл – төреші.
Dialogue: 0,0:03:45.85,0:03:48.64,Default,,0,0,0,,Түсінді Толық жаттады
Dialogue: 0,0:03:48.72,0:03:50.02,Default,,0,0,0,,Көңіл-күйіңіз жақсы.
Dialogue: 0,0:03:50.35,0:03:52.06,Default,,0,0,0,,Бұл сіздің бірінші жұмысыңыз болғандықтан ба?
Dialogue: 0,0:03:52.73,0:03:53.81,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:54.98,0:03:56.56,Default,,0,0,0,,Бірінші жұмыс болды
Dialogue: 0,0:03:56.65,0:03:59.19,Default,,0,0,0,,Бұл ғимаратқа кіріп, екі адамды өлтіру болды.
Dialogue: 0,0:03:59.78,0:04:01.07,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:04:01.32,0:04:02.82,Default,,0,0,0,,Ол әрқашан...
Dialogue: 0,0:04:03.91,0:04:06.20,Default,,0,0,0,,Яша Шираюкидің өлтіру қабілеті ерекше.
Dialogue: 0,0:04:06.49,0:04:09.62,Default,,0,0,0,,Киока басқаларды өлтіргенде ғана мағынаға ие болады
Dialogue: 0,0:04:13.04,0:04:14.75,Default,,0,0,0,,Мен... (Ацуши) Ах.
Dialogue: 0,0:04:15.96,0:04:17.09,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе
Dialogue: 0,0:04:21.26,0:04:22.51,Default,,0,0,0,,Кіре алмайсыз ба?
Dialogue: 0,0:04:22.59,0:04:24.05,Default,,0,0,0,,Рұқсат қажет
Dialogue: 0,0:04:24.43,0:04:26.55,Default,,0,0,0,,Бірақ уәде етілген уақыт...
Dialogue: 0,0:04:26.89,0:04:29.14,Default,,0,0,0,,Процедура формасын сол жерде толтырыңыз-
Dialogue: 0,0:04:29.22,0:04:30.85,Default,,0,0,0,,Қабылдағанша күтіңіз
Dialogue: 0,0:04:31.31,0:04:32.60,Default,,0,0,0,,Уәде етілген уақыт...
Dialogue: 0,0:04:33.48,0:04:35.19,Default,,0,0,0,,Бұл ереже
Dialogue: 0,0:04:35.85,0:04:40.86,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:04:43.82,0:04:46.03,Default,,0,0,0,,Жоқ, судья келмейді.
Dialogue: 0,0:04:46.61,0:04:48.74,Default,,0,0,0,,Байланыссыздық болған сияқты.
Dialogue: 0,0:04:48.83,0:04:50.79,Default,,0,0,0,,Біз сол күзетшіге бірдеңе жасауымыз керек.
Dialogue: 0,0:04:52.50,0:04:53.79,Default,,0,0,0,,Өшіру керек пе? (Ацуши) Иә?
Dialogue: 0,0:04:54.75,0:04:55.79,Default,,0,0,0,,Біріншіден, түс трюктерімен
Dialogue: 0,0:04:55.87,0:04:58.00,Default,,0,0,0,,Сені елсіз жерге азғырғаннан кейін...
Dialogue: 0,0:04:58.84,0:04:59.71,Default,,0,0,0,,Гусари және...
Dialogue: 0,0:05:00.21,0:05:03.05,Default,,0,0,0,,Детектив агенттіктері мұндай жұмысты жасамайды!
Dialogue: 0,0:05:04.26,0:05:07.05,Default,,0,0,0,,Сонда мен бір ғана басқа әдісті білемін.
Dialogue: 0,0:05:07.14,0:05:08.64,Default,,0,0,0,,Сәлем! Киока-чан?
Dialogue: 0,0:05:20.44,0:05:20.77,Default,,0,0,0,,(Төтенше қоңырау дыбысы)
Dialogue: 0,0:05:20.77,0:05:22.19,Default,,0,0,0,,(Төтенше қоңырау дыбысы)
Dialogue: 0,0:05:20.77,0:05:22.19,Default,,0,0,0,,О...
Dialogue: 0,0:05:22.19,0:05:23.82,Default,,0,0,0,,(Төтенше қоңырау дыбысы)
Dialogue: 0,0:05:23.82,0:05:24.78,Default,,0,0,0,,(Төтенше қоңырау дыбысы)
Dialogue: 0,0:05:23.82,0:05:24.78,Default,,0,0,0,,Не?
Dialogue: 0,0:05:24.78,0:05:26.24,Default,,0,0,0,,(Төтенше қоңырау дыбысы)
Dialogue: 0,0:05:27.99,0:05:30.12,Default,,0,0,0,,Не істеп жатырсың... Уау!
Dialogue: 0,0:05:30.95,0:05:32.33,Default,,0,0,0,,Не болып жатыр? Бұл не деген шу?
Dialogue: 0,0:05:32.33,0:05:33.16,Default,,0,0,0,,Не болып жатыр? Бұл не деген шу?
Dialogue: 0,0:05:32.33,0:05:33.16,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:05:35.75,0:05:38.04,Default,,0,0,0,,(Судьяның айқайы)
Dialogue: 0,0:05:38.46,0:05:40.67,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:05:41.29,0:05:42.75,Default,,0,0,0,,Бұл жеткізу.
Dialogue: 0,0:05:47.84,0:05:48.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:57.06,0:05:58.10,Default,,0,0,0,,Иә
Dialogue: 0,0:05:58.52,0:05:59.52,Default,,0,0,0,,Иә
Dialogue: 0,0:06:00.40,0:06:02.82,Default,,0,0,0,,Президент менімен сөйлесті.
Dialogue: 0,0:06:03.36,0:06:05.32,Default,,0,0,0,,Мен сені судьямен достассың деп естідім.
Dialogue: 0,0:06:05.78,0:06:08.78,Default,,0,0,0,,Электр қуаты өшіп қалса жақсы болар еді...
Dialogue: 0,0:06:08.86,0:06:10.95,Default,,0,0,0,,Бұл сізге қажет...
Dialogue: 0,0:06:11.74,0:06:12.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:13.37,0:06:16.62,Default,,0,0,0,,Сіз бұл телефонды әлі лақтырып жіберген жоқсыз ба?
Dialogue: 0,0:06:17.91,0:06:20.83,Default,,0,0,0,,Мен сатушыға бағдарламаны өзгертуді тапсырдым.
Dialogue: 0,0:06:21.29,0:06:22.71,Default,,0,0,0,,Өйткені бұл маңызды...
Dialogue: 0,0:06:23.38,0:06:24.21,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:26.30,0:06:29.30,Default,,0,0,0,,Жарайды... бұл мүмкіншілік мәселесі.
Dialogue: 0,0:06:30.13,0:06:33.22,Default,,0,0,0,,Егер сіздің ерекше қабілетіңіздің құпиясы шешілсе...
Dialogue: 0,0:06:33.30,0:06:37.23,Default,,0,0,0,,Телефондағы дауысқа ғана бағынатын Яшаны басқара алсам...
Dialogue: 0,0:06:37.31,0:06:38.48,Default,,0,0,0,,Детективтің өкілеттіктерінің бірі...
Dialogue: 0,0:06:38.77,0:06:39.81,Default,,0,0,0,,Жоқ! (Ацуши) Ой?
Dialogue: 0,0:06:40.35,0:06:41.77,Default,,0,0,0,,Ах! Құдай-ай!
Dialogue: 0,0:06:42.02,0:06:44.23,Default,,0,0,0,,Яша енді ешқашан...
Dialogue: 0,0:06:44.57,0:06:44.94,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:06:44.94,0:06:46.15,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:06:44.94,0:06:46.15,Default,,0,0,0,,Ах! (Киока) Ха!
Dialogue: 0,0:06:46.15,0:06:49.57,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:06:52.28,0:06:53.12,Default,,0,0,0,,Марухи байқалды. Оның Қиркі іске қосылмас бұрын дереу қамауға алуды сұраймын
Dialogue: 0,0:06:53.41,0:06:54.12,Default,,0,0,0,,Яша Шираюки
Dialogue: 0,0:06:54.12,0:06:55.24,Default,,0,0,0,,Яша Шираюки
Dialogue: 0,0:06:54.12,0:06:55.24,Default,,0,0,0,,Ха! Аа...
Dialogue: 0,0:06:55.24,0:06:56.16,Default,,0,0,0,,Ха! Аа...
Dialogue: 0,0:06:56.16,0:06:56.66,Default,,0,0,0,,Ха! Аа...
Dialogue: 0,0:06:56.16,0:06:56.66,Default,,0,0,0,,Киокаға өтірік дүниені үйреткендерді жазала.
Dialogue: 0,0:06:56.66,0:07:00.21,Default,,0,0,0,,Киокаға өтірік дүниені үйреткендерді жазала.
Dialogue: 0,0:07:00.29,0:07:02.04,Default,,0,0,0,,Уф... (Киока) Ха!
Dialogue: 0,0:07:02.67,0:07:04.54,Default,,0,0,0,,Ах, ха... (Киока) Ах...
Dialogue: 0,0:07:04.63,0:07:05.29,Default,,0,0,0,,(күзгі жапырақтар күлкі)
Dialogue: 0,0:07:05.29,0:07:06.30,Default,,0,0,0,,(күзгі жапырақтар күлкі)
Dialogue: 0,0:07:05.29,0:07:06.30,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:06.30,0:07:07.46,Default,,0,0,0,,(күзгі жапырақтар күлкі)
Dialogue: 0,0:07:07.55,0:07:11.72,Default,,0,0,0,,Зияндылардың қанымен де тамшылары әдемі.
Dialogue: 0,0:07:12.89,0:07:15.22,Default,,0,0,0,,Сіз олай ойламайсыз ба?
Dialogue: 0,0:07:17.31,0:07:18.89,Default,,0,0,0,,Құрметті Киокая
Dialogue: 0,0:07:19.18,0:07:20.02,Default,,0,0,0,,Ұф… Ха…
Dialogue: 0,0:07:20.10,0:07:23.06,Default,,0,0,0,,Мен сіздің қауіпсіздігіңізге қаншалықты мән беремін?
Dialogue: 0,0:07:23.15,0:07:24.81,Default,,0,0,0,,Сіз кеудеңізді ауырттыңыз ба?
Dialogue: 0,0:07:25.31,0:07:27.02,Default,,0,0,0,,Мынадай нәрсе... (Ацуши) Аргх!
Dialogue: 0,0:07:27.44,0:07:31.74,Default,,0,0,0,,Мен сені аңдармен қалдырамын.
Dialogue: 0,0:07:27.44,0:07:31.74,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:31.82,0:07:33.57,Default,,0,0,0,,Ах! (Киока) А...
Dialogue: 0,0:07:33.66,0:07:34.49,Default,,0,0,0,,Картоп
Dialogue: 0,0:07:34.74,0:07:36.99,Default,,0,0,0,,Енді уайымдамаңыз
Dialogue: 0,0:07:37.49,0:07:39.79,Default,,0,0,0,,Уайымдайтын ештеңе жоқ
Dialogue: 0,0:07:39.87,0:07:42.42,Default,,0,0,0,,Мен сені қорғаймын.
Dialogue: 0,0:07:42.75,0:07:45.96,Default,,0,0,0,,Ол ешқашан Порт мафиясына оралмайды.
Dialogue: 0,0:07:46.34,0:07:48.13,Default,,0,0,0,,Оның күші -
Dialogue: 0,0:07:48.21,0:07:51.26,Default,,0,0,0,,Бұл детектив қызметінің жұмысында қолданылуы керек нәрсе.
Dialogue: 0,0:07:57.51,0:08:00.31,Default,,0,0,0,,Мен күткендей, Огай-дононың рұқсатын күтудің қажеті жоқ.
Dialogue: 0,0:08:00.39,0:08:02.81,Default,,0,0,0,,Сіз мені дереу алып кетуге келуің керек еді.
Dialogue: 0,0:08:03.35,0:08:03.64,Default,,0,0,0,,Мен сені бұл екіжүзділіктің ұясында бір секундқа қалдыра алмаймын.
Dialogue: 0,0:08:03.64,0:08:04.56,Default,,0,0,0,,Мен сені бұл екіжүзділіктің ұясында бір секундқа қалдыра алмаймын.
Dialogue: 0,0:08:03.64,0:08:04.56,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:04.56,0:08:05.19,Default,,0,0,0,,Мен сені бұл екіжүзділіктің ұясында бір секундқа қалдыра алмаймын.
Dialogue: 0,0:08:05.19,0:08:06.19,Default,,0,0,0,,Мен сені бұл екіжүзділіктің ұясында бір секундқа қалдыра алмаймын.
Dialogue: 0,0:08:05.19,0:08:06.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:06.19,0:08:07.02,Default,,0,0,0,,Мен сені бұл екіжүзділіктің ұясында бір секундқа қалдыра алмаймын.
Dialogue: 0,0:08:09.07,0:08:11.11,Default,,0,0,0,,Тәтті әңгімеге арбау-
Dialogue: 0,0:08:11.19,0:08:14.45,Default,,0,0,0,,Олар оны жарық әлемі деп қателескен болуы керек.
Dialogue: 0,0:08:14.70,0:08:16.91,Default,,0,0,0,,Олар сізге ақырында айтып береді.
Dialogue: 0,0:08:16.99,0:08:19.04,Default,,0,0,0,,«Яша Шираюкиді қолданыңыз»
Dialogue: 0,0:08:19.12,0:08:19.99,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:20.70,0:08:24.08,Default,,0,0,0,,Енді сенің орныңа қайтайық.
Dialogue: 0,0:08:24.21,0:08:27.13,Default,,0,0,0,,Тоқта... мені қайда апарып жатырсың?
Dialogue: 0,0:08:27.88,0:08:29.80,Default,,0,0,0,,Киока-чан қайда орналасқан?
Dialogue: 0,0:08:30.55,0:08:31.63,Default,,0,0,0,,Детектив агенттігі!
Dialogue: 0,0:08:33.97,0:08:34.88,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:35.05,0:08:36.80,Default,,0,0,0,,Кеш
Dialogue: 0,0:08:38.72,0:08:40.10,Default,,0,0,0,,Тағы бір Яша?
Dialogue: 0,0:08:40.35,0:08:41.18,Default,,0,0,0,,Аһ!
Dialogue: 0,0:08:43.31,0:08:44.14,Default,,0,0,0,,Гах…
Dialogue: 0,0:08:45.48,0:08:48.61,Default,,0,0,0,,Күткендей, мен бірінші жұмысымды аяқтаймын.
Dialogue: 0,0:08:48.90,0:08:50.57,Default,,0,0,0,,Бля саған, кішкентай бала (Ацуши)...
Dialogue: 0,0:08:50.65,0:08:51.53,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,0:08:51.61,0:08:52.86,Default,,0,0,0,,Дегенмен, заттары көп екен.
Dialogue: 0,0:08:53.53,0:08:58.16,Default,,0,0,0,,Лорд Огай барлық детектив қызметкерлерін өлтіргісі келеді.
Dialogue: 0,0:08:58.53,0:09:01.49,Default,,0,0,0,,Бірақ біз сенің өміріңді сұраймыз.
Dialogue: 0,0:09:01.58,0:09:03.54,Default,,0,0,0,,ерекше рұқсат етілген
Dialogue: 0,0:09:04.04,0:09:06.37,Default,,0,0,0,,Қайт, Киока, сен қараңғылықтың гүлісің.
Dialogue: 0,0:09:06.37,0:09:07.96,Default,,0,0,0,,Қайт, Киока, сен қараңғылықтың гүлісің.
Dialogue: 0,0:09:06.37,0:09:07.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:08.42,0:09:10.71,Default,,0,0,0,,Мен қараңғыда ғана демаламын
Dialogue: 0,0:09:11.05,0:09:12.26,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:09:12.92,0:09:14.59,Default,,0,0,0,,Мен қараңғылық гүлі емеспін
Dialogue: 0,0:09:14.97,0:09:16.18,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:18.68,0:09:20.18,Default,,0,0,0,,Мен сені жек көремін, балам.
Dialogue: 0,0:09:20.51,0:09:21.64,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:21.89,0:09:24.89,Default,,0,0,0,,Әлгі баланың нұры соқыр.
Dialogue: 0,0:09:25.02,0:09:26.94,Default,,0,0,0,,Сіз маған көрсеткен жарық
Dialogue: 0,0:09:27.90,0:09:30.15,Default,,0,0,0,,Бірақ, бақытымызға орай, әлі де жол бар.
Dialogue: 0,0:09:31.32,0:09:34.49,Default,,0,0,0,,Детективте балаларсыз өмір сүру қиын емес пе?
Dialogue: 0,0:09:34.57,0:09:35.28,Default,,0,0,0,,Уф!
Dialogue: 0,0:09:35.53,0:09:39.24,Default,,0,0,0,,Одан да сен үшін өлтірілсем...
Dialogue: 0,0:09:35.53,0:09:39.24,Default,,0,0,0,,Ук ку аа...
Dialogue: 0,0:09:39.37,0:09:40.20,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:09:41.95,0:09:45.00,Default,,0,0,0,,Мен қайтып барамын Сондықтан...
Dialogue: 0,0:09:46.46,0:09:49.58,Default,,0,0,0,,Бәрі сен үшін, Киока.
Dialogue: 0,0:09:51.13,0:09:52.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:53.21,0:09:55.76,Default,,0,0,0,,Түсінетін уақыт келеді.
Dialogue: 0,0:09:59.01,0:10:00.72,Default,,0,0,0,,Уиноу…
Dialogue: 0,0:10:01.85,0:10:03.31,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:11.40,0:10:14.53,Default,,0,0,0,,Хохохо...
Dialogue: 0,0:10:17.65,0:10:19.78,Default,,0,0,0,,Киока күткендей
Dialogue: 0,0:10:19.86,0:10:21.70,Default,,0,0,0,,Бұл кісі өлтіру ниеті сияқты.
Dialogue: 0,0:10:22.70,0:10:24.33,Default,,0,0,0,,Жарық дүниені көрдім
Dialogue: 0,0:10:24.62,0:10:25.45,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:25.79,0:10:29.12,Default,,0,0,0,,Мен білмеген уақытқа орала алмаймын.
Dialogue: 0,0:10:30.71,0:10:32.71,Default,,0,0,0,,Оны қолданба, Киока.
Dialogue: 0,0:10:33.17,0:10:35.17,Default,,0,0,0,,Егер сіз оны пайдалансаңыз...
Dialogue: 0,0:10:35.55,0:10:36.42,Default,,0,0,0,,Хмм
Dialogue: 0,0:10:36.96,0:10:39.93,Default,,0,0,0,,Яша Шираюки Менің жауымды жең!
Dialogue: 0,0:10:42.47,0:10:44.10,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,0:10:44.10,0:10:46.39,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,0:10:44.10,0:10:46.39,Default,,0,0,0,,Менің Рочинанте...
Dialogue: 0,0:10:46.93,0:10:49.35,Default,,0,0,0,,Бұл елдегі жолдар тым тар.
Dialogue: 0,0:10:49.89,0:10:52.65,Default,,0,0,0,,Баратын жерге жаяу барудан басқа амал жоқ
Dialogue: 0,0:10:52.81,0:10:55.69,Default,,0,0,0,,Ха, мен оны тез бітіріп, үйге қайтқым келеді.
Dialogue: 0,0:10:56.44,0:10:59.03,Default,,0,0,0,,Сыртқа шыққаныма төрт жыл болды...
Dialogue: 0,0:10:59.45,0:11:01.66,Default,,0,0,0,,Жарайды... Жарайды, жарайды.
Dialogue: 0,0:11:02.49,0:11:05.12,Default,,0,0,0,,Кеттік. Жүктің келетін уақыты таяп қалды.
Dialogue: 0,0:11:08.12,0:11:09.04,Default,,0,0,0,,(Тодороки) Алда не күтіп тұрғанын біртүрлі ұмытып кетіппін
Dialogue: 0,0:11:09.33,0:11:11.50,Default,,0,0,0,,Бұл жүз сіздің шынайы табиғатыңыз.
Dialogue: 0,0:11:11.96,0:11:13.96,Default,,0,0,0,,Егер мен біреуді мазалайтын болсам, дереу өлтіремін.
Dialogue: 0,0:11:14.13,0:11:16.55,Default,,0,0,0,,Дәл Яша (Киока) сияқты Жоқ!
Dialogue: 0,0:11:17.63,0:11:20.30,Default,,0,0,0,,Сезіміңді түсінбеймін.
Dialogue: 0,0:11:20.76,0:11:24.60,Default,,0,0,0,,Қараңғыда жайқалған гүлдер тек қараңғыда ғана тыныға алады.
Dialogue: 0,0:11:25.39,0:11:27.43,Default,,0,0,0,,Мен неге білемін?
Dialogue: 0,0:11:28.14,0:11:30.14,Default,,0,0,0,,Сол сияқты жарықты аңсау――
Dialogue: 0,0:11:30.89,0:11:33.48,Default,,0,0,0,,Өйткені күйіп, құлаған әйел болған.
Dialogue: 0,0:11:35.31,0:11:36.57,Default,,0,0,0,,Киокаға қайтыңыз
Dialogue: 0,0:11:37.44,0:11:38.69,Default,,0,0,0,,Мен қайтып оралғым келмейді...
Dialogue: 0,0:11:40.32,0:11:42.11,Default,,0,0,0,,Мен әлі де...
Dialogue: 0,0:11:42.49,0:11:43.66,Default,,0,0,0,,мақсатында
Dialogue: 0,0:11:43.74,0:11:48.12,Default,,0,0,0,,Кісі өлтірудің барлық түрін ақтайды, оның шынайы табиғаты өзгеріссіз қалады\NЕгер бұл
Dialogue: 0,0:11:48.58,0:11:51.75,Default,,0,0,0,,болмаса, Яшаны бұлай қолдануға ешқандай мүмкіндік жоқ.
Dialogue: 0,0:11:53.29,0:11:55.84,Default,,0,0,0,,Өйткені Яша сенің ата-анаң...
Dialogue: 0,0:11:56.84,0:11:58.42,Default,,0,0,0,,Өйткені ол айуандықпен өлтірілген.
Dialogue: 0,0:11:58.50,0:11:59.84,Default,,0,0,0,,Ха! (Ацуши) Иә?
Dialogue: 0,0:12:00.46,0:12:01.59,Default,,0,0,0,,Ха ха…
Dialogue: 0,0:12:01.67,0:12:03.05,Default,,0,0,0,,Бұл... (Кёка) Уф...
Dialogue: 0,0:12:03.93,0:12:04.89,Default,,0,0,0,,Неге...
Dialogue: 0,0:12:05.22,0:12:07.47,Default,,0,0,0,,Жоқ, бұл…
Dialogue: 0,0:12:07.60,0:12:09.68,Default,,0,0,0,,Ол түсінбейді.
Dialogue: 0,0:12:10.31,0:12:12.89,Default,,0,0,0,,Күн сәулесі түсетін әлемде өмір сүретіндер үшін
Dialogue: 0,0:12:25.45,0:12:29.54,Default,,0,0,0,,Сізге енді тиесілі жерді іздеу үшін жүзіңізді бұлғаудың қажеті жоқ.
Dialogue: 0,0:12:29.91,0:12:32.08,Default,,0,0,0,,Мен сені қорғаймын
Dialogue: 0,0:12:36.42,0:12:37.84,Default,,0,0,0,,Басыңызды иіңіз. (Күзгі жапырақтар) Иә?
Dialogue: 0,0:12:37.84,0:12:39.34,Default,,0,0,0,,Басыңызды иіңіз. (Күзгі жапырақтар) Иә?
Dialogue: 0,0:12:37.84,0:12:39.34,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:40.00,0:12:41.05,Default,,0,0,0,,Мені жебе таңдағанына қарамастан, ол маған тимей, қайта қайтты.
Dialogue: 0,0:12:41.38,0:12:43.22,Default,,0,0,0,,Иә, у...
Dialogue: 0,0:12:43.38,0:12:45.34,Default,,0,0,0,,О, ұшты! Ұшты!
Dialogue: 0,0:12:45.43,0:12:47.30,Default,,0,0,0,,Ха... жақсысың ба? Ацуши!
Dialogue: 0,0:12:47.43,0:12:49.85,Default,,0,0,0,,Куникида мырза, мұнда неге келдіңіз?
Dialogue: 0,0:12:50.26,0:12:52.39,Default,,0,0,0,,Егер Киоканың ұялы телефонына қоңырау келсе...
Dialogue: 0,0:12:52.48,0:12:55.23,Default,,0,0,0,,Мен белгі беру үшін қолымды қойдым. (Ацуши) О...
Dialogue: 0,0:12:55.31,0:12:56.15,Default,,0,0,0,,Тұр! (Ацуши) Уау!
Dialogue: 0,0:12:56.60,0:12:58.61,Default,,0,0,0,,Сіз қанша уақытқа дейін қорғаушы болғыңыз келеді?
Dialogue: 0,0:12:59.52,0:13:02.19,Default,,0,0,0,,Қаттылық - Werecat-тың сату нүктесі! (Ацуши) Ах...
Dialogue: 0,0:13:02.36,0:13:04.07,Default,,0,0,0,,Детективтің улы жәндігі!
Dialogue: 0,0:13:04.74,0:13:07.36,Default,,0,0,0,,Киокаға бұдан артық улы жарық көрсетпе!
Dialogue: 0,0:13:07.82,0:13:10.16,Default,,0,0,0,,Уау, тамаша уақыт
Dialogue: 0,0:13:10.28,0:13:12.20,Default,,0,0,0,,Соқтығысуға 1 секунд қалғандай.
Dialogue: 0,0:13:12.29,0:13:13.12,Default,,0,0,0,,Оо?
Dialogue: 0,0:13:14.21,0:13:17.25,Default,,0,0,0,,Сәл кешірек келсем оңай болар еді...
Dialogue: 0,0:13:17.42,0:13:18.46,Default,,0,0,0,,Сіз мұны істейсіз бе?
Dialogue: 0,0:13:18.92,0:13:22.96,Default,,0,0,0,,Қарсы емеспін, бірақ көптің қарасы қышиды.
Dialogue: 0,0:13:24.01,0:13:25.55,Default,,0,0,0,,Мен мүлде білмеймін.
Dialogue: 0,0:13:25.63,0:13:28.68,Default,,0,0,0,,Сіз гильдиядағы жалақыңызға жұмыс істейсіз бе?
Dialogue: 0,0:13:29.18,0:13:32.31,Default,,0,0,0,,Ах, мен шаршадым. Ах, қышу.
Dialogue: 0,0:13:32.39,0:13:33.93,Default,,0,0,0,,Ах, мен шаршадым, қышиды.
Dialogue: 0,0:13:34.35,0:13:36.94,Default,,0,0,0,,Бұл адамдар табиғаттан тыс күштерге ие гильдиядан шыққандар ма?
Dialogue: 0,0:13:37.48,0:13:40.77,Default,,0,0,0,,Аа, ортасына ашық қалдырыңыз.
Dialogue: 0,0:13:42.07,0:13:43.90,Default,,0,0,0,,Пакет жақын арада келеді.
Dialogue: 0,0:13:44.49,0:13:46.78,Default,,0,0,0,,Иә? (Ацуши) А-а!
Dialogue: 0,0:13:47.45,0:13:48.66,Default,,0,0,0,,Онда не бар?
Dialogue: 0,0:13:51.16,0:13:52.74,Default,,0,0,0,,Уау...
Dialogue: 0,0:13:52.83,0:13:55.70,Default,,0,0,0,,Уау...
Dialogue: 0,0:14:01.88,0:14:03.38,Default,,0,0,0,,Жоқ! Ат!
Dialogue: 0,0:14:04.55,0:14:07.97,Default,,0,0,0,,(Пулеметтің дыбысы)
Dialogue: 0,0:14:16.18,0:14:17.60,Default,,0,0,0,,Айтып тұрғасын...
Dialogue: 0,0:14:17.89,0:14:20.06,Default,,0,0,0,,По мен Луиза қайсысы?
Dialogue: 0,0:14:20.56,0:14:24.28,Default,,0,0,0,,Биіктіктен қорқып, артта қалдым.
Dialogue: 0,0:14:24.36,0:14:25.94,Default,,0,0,0,,(Мадо) Бірақ… (Иба) Мадо!
Dialogue: 0,0:14:26.07,0:14:29.20,Default,,0,0,0,,Бұл оңай жұмыс болды, құрметті.
Dialogue: 0,0:14:30.99,0:14:35.16,Default,,0,0,0,,Құдай күнәһарларды жарылқасын
Dialogue: 0,0:14:49.97,0:14:52.72,Default,,0,0,0,,Хмм... аа...
Dialogue: 0,0:14:53.80,0:14:55.51,Default,,0,0,0,,Бұл қай жерде?
Dialogue: 0,0:14:56.35,0:14:59.44,Default,,0,0,0,,Маған жаудың шабуыл жасағанына сенімдімін...
Dialogue: 0,0:14:56.35,0:14:59.44,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:15:00.02,0:15:00.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:00.35,0:15:01.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:00.35,0:15:01.02,Default,,0,0,0,,Бұл ауыр жарақат сияқты, иә? Ацуши
Dialogue: 0,0:15:01.02,0:15:04.82,Default,,0,0,0,,Бұл ауыр жарақат сияқты, иә? Ацуши
Dialogue: 0,0:15:05.40,0:15:07.99,Default,,0,0,0,,Енді емделу уақыты келді.
Dialogue: 0,0:15:08.07,0:15:09.07,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:15:11.61,0:15:13.74,Default,,0,0,0,,Бүгін мына жігітпен барайық (Ацуши) Уау!
Dialogue: 0,0:15:14.12,0:15:18.45,Default,,0,0,0,,Гаа~!
Dialogue: 0,0:15:19.16,0:15:20.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:20.79,0:15:23.29,Default,,0,0,0,,Бұл мүлдем дұрыс емес.
Dialogue: 0,0:15:23.38,0:15:25.04,Default,,0,0,0,,Менің мүмкіндігім болмаса...
Dialogue: 0,0:15:25.29,0:15:27.92,Default,,0,0,0,,Олардың барлығы жер астында қалды.
Dialogue: 0,0:15:28.42,0:15:29.59,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:15:30.17,0:15:31.30,Default,,0,0,0,,Президент...
Dialogue: 0,0:15:30.17,0:15:31.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:31.30,0:15:31.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:31.80,0:15:34.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:31.80,0:15:34.72,Default,,0,0,0,,Кешіріңіз, мен сізбен болған кезде...
Dialogue: 0,0:15:34.80,0:15:36.81,Default,,0,0,0,,Жақсы
Dialogue: 0,0:15:37.35,0:15:38.06,Default,,0,0,0,,Бірақ қазір көшеге шығу қауіпті...
Dialogue: 0,0:15:38.06,0:15:39.02,Default,,0,0,0,,Бірақ қазір көшеге шығу қауіпті...
Dialogue: 0,0:15:38.06,0:15:39.02,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:15:39.02,0:15:40.48,Default,,0,0,0,,Бірақ қазір сыртқа шығу қауіпті...
Dialogue: 0,0:15:42.14,0:15:42.98,Default,,0,0,0,,Фу…
Dialogue: 0,0:15:43.06,0:15:46.15,Default,,0,0,0,,Иә, төбе өте үлкен.
Dialogue: 0,0:15:47.57,0:15:49.44,Default,,0,0,0,,Сәлем, Эрис-чан
Dialogue: 0,0:15:49.53,0:15:51.95,Default,,0,0,0,,Көп жеу денеге пайдалы емес.
Dialogue: 0,0:15:52.32,0:15:55.32,Default,,0,0,0,,Хмм, неге? Тәтті – әділдік
Dialogue: 0,0:15:55.78,0:15:57.45,Default,,0,0,0,,Иә, бірақ~
Dialogue: 0,0:15:57.53,0:16:00.75,Default,,0,0,0,,Ринтаро бұрын сатып алған көйлекті киюге болады.
Dialogue: 0,0:16:00.83,0:16:01.62,Default,,0,0,0,,Әй!
Dialogue: 0,0:16:01.62,0:16:01.83,Default,,0,0,0,,Әй!
Dialogue: 0,0:16:01.62,0:16:01.83,Default,,0,0,0,,Ммм...
Dialogue: 0,0:16:01.83,0:16:03.00,Default,,0,0,0,,Ммм...
Dialogue: 0,0:16:03.00,0:16:05.54,Default,,0,0,0,,Ммм...
Dialogue: 0,0:16:03.00,0:16:05.54,Default,,0,0,0,,Сізге ауыстыру керек пе?
Dialogue: 0,0:16:06.17,0:16:07.50,Default,,0,0,0,,Бастық, детектив оқиға орнына бізден ертерек келді.
Dialogue: 0,0:16:07.50,0:16:09.63,Default,,0,0,0,,Бастық, детектив оқиға орнына бізден ертерек келді.
Dialogue: 0,0:16:07.50,0:16:09.63,Default,,0,0,0,,Ха ха~
Dialogue: 0,0:16:09.63,0:16:09.71,Default,,0,0,0,,Ха ха~
Dialogue: 0,0:16:09.71,0:16:12.26,Default,,0,0,0,,Ха ха~
Dialogue: 0,0:16:09.71,0:16:12.26,Default,,0,0,0,,Момиджидің қарындасын алып кеткен дейді.
Dialogue: 0,0:16:12.88,0:16:16.22,Default,,0,0,0,,Бес басшының бірі кепілге алынды...
Dialogue: 0,0:16:16.30,0:16:19.35,Default,,0,0,0,,Абайсыз қол... (Оғай) Дұрыс.
Dialogue: 0,0:16:20.06,0:16:20.52,Default,,0,0,0,,Ммм...
Dialogue: 0,0:16:20.52,0:16:23.35,Default,,0,0,0,,Ммм...
Dialogue: 0,0:16:20.52,0:16:23.35,Default,,0,0,0,,Жақсы! Детектив агенттігінің президентін өлтірейік!
Dialogue: 0,0:16:23.35,0:16:23.44,Default,,0,0,0,,Жақсы! Детектив агенттігінің президентін өлтірейік!
Dialogue: 0,0:16:23.44,0:16:24.23,Default,,0,0,0,,Жақсы! Детектив агенттігінің президентін өлтірейік!
Dialogue: 0,0:16:23.44,0:16:24.23,Default,,0,0,0,,Ммм...
Dialogue: 0,0:16:24.23,0:16:24.31,Default,,0,0,0,,Ммм...
Dialogue: 0,0:16:24.31,0:16:27.98,Default,,0,0,0,,Ммм...
Dialogue: 0,0:16:24.31,0:16:27.98,Default,,0,0,0,,Қастандық өте жақсы болар еді. Егер біз сырттағы өлтірушіні қолдансақ...
Dialogue: 0,0:16:28.23,0:16:31.94,Default,,0,0,0,,Біз гильдиямен көп күш жұмсамай-ақ күресе аламыз.
Dialogue: 0,0:16:32.24,0:16:34.20,Default,,0,0,0,,Зейінін жинақтай алады
Dialogue: 0,0:16:39.83,0:16:42.71,Default,,0,0,0,,Хмм... (Осаму Дазай) Сәлеметсіз бе, ханым.
Dialogue: 0,0:16:43.08,0:16:43.91,Default,,0,0,0,,Хмм... Ха!
Dialogue: 0,0:16:44.62,0:16:45.67,Default,,0,0,0,,Көптен бері көрмеген
Dialogue: 0,0:16:46.63,0:16:49.80,Default,,0,0,0,,Әрине көп болды, сатқын.
Dialogue: 0,0:16:50.80,0:16:53.55,Default,,0,0,0,,Ваппа: Киока жақсы ма?
Dialogue: 0,0:16:55.63,0:16:57.14,Default,,0,0,0,,Ол жоғалып кетті.
Dialogue: 0,0:16:58.10,0:16:58.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:00.06,0:17:01.68,Default,,0,0,0,,Бұл сенің кінәң
Dialogue: 0,0:17:01.77,0:17:03.77,Default,,0,0,0,,Фуфуфуфуфу... (Ацуши) Ах!
Dialogue: 0,0:17:04.18,0:17:05.98,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:17:06.94,0:17:08.52,Default,,0,0,0,,Не болды?
Dialogue: 0,0:17:09.15,0:17:11.28,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:17:11.36,0:17:12.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:13.32,0:17:14.86,Default,,0,0,0,,Дазай-сан!
Dialogue: 0,0:17:15.07,0:17:17.03,Default,,0,0,0,,Аяғыңды тез жазып алғаның жөн.
Dialogue: 0,0:17:18.12,0:17:19.07,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:17:19.16,0:17:20.58,Default,,0,0,0,,Қазір...
Dialogue: 0,0:17:20.66,0:17:23.87,Default,,0,0,0,,Тез болғаным үшін кешіріңіз, бірақ Порт мафиясының жауынгерлік жағдайы
Dialogue: 0,0:17:23.95,0:17:26.12,Default,,0,0,0,,Маған болашақ стратегияңыз туралы айтып беріңізші.
Dialogue: 0,0:17:26.21,0:17:27.04,Default,,0,0,0,,Хмм.
Dialogue: 0,0:17:27.62,0:17:31.30,Default,,0,0,0,,Порт мафиясының ережелерін ұмыттыңыз ба? монах
Dialogue: 0,0:17:31.38,0:17:33.84,Default,,0,0,0,,Сөйлегіш бірінші өледі.
Dialogue: 0,0:17:34.01,0:17:37.47,Default,,0,0,0,,Сіздің әпкеңіздің азаптауға маманданған командасы болды, солай ма?
Dialogue: 0,0:17:37.55,0:17:42.06,Default,,0,0,0,,Сирек жағдайларда мен оларға қиын қарсыласпен көмектестім.
Dialogue: 0,0:17:43.64,0:17:44.35,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:44.35,0:17:44.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:44.35,0:17:44.73,Default,,0,0,0,,Тұтқындардан сұрасам да олар үнсіз қалды...
Dialogue: 0,0:17:44.73,0:17:46.39,Default,,0,0,0,,Тұтқындардан сұрасам да олар үнсіз қалды...
Dialogue: 0,0:17:46.39,0:17:47.14,Default,,0,0,0,,Тұтқындардан сұрасам да олар үнсіз қалды...
Dialogue: 0,0:17:46.39,0:17:47.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:47.14,0:17:47.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:47.23,0:17:49.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:47.23,0:17:49.19,Default,,0,0,0,,Тіпті бір адам болды ма?
Dialogue: 0,0:17:49.44,0:17:53.23,Default,,0,0,0,,Қазірден бастап үлкендердің уақыты келді.
Dialogue: 0,0:17:54.90,0:17:57.86,Default,,0,0,0,,Барлық тергеушілер компания ғимаратынан шығып кетті.
Dialogue: 0,0:17:57.95,0:18:00.32,Default,,0,0,0,,Ескі Банко-до Холлға жиналыңыз
Dialogue: 0,0:18:00.78,0:18:02.24,Default,,0,0,0,,Компания құрылғанға дейін -
Dialogue: 0,0:18:02.33,0:18:05.54,Default,,0,0,0,,Бұл президент орналасқан Банкодо ма?
Dialogue: 0,0:18:05.75,0:18:09.04,Default,,0,0,0,,Бұл дәрісхана туралы өте аз ғана адам біледі.
Dialogue: 0,0:18:09.12,0:18:09.79,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:18:09.79,0:18:13.38,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:18:09.79,0:18:13.38,Default,,0,0,0,,Базаңды жасырмасаң, өзіңнен асып түсетін жау сені талқандайды.
Dialogue: 0,0:18:14.30,0:18:17.13,Default,,0,0,0,,Президент әлі де соғысқа дайын...
Dialogue: 0,0:18:19.76,0:18:21.68,Default,,0,0,0,,Діни қонаққа ұқсайды.
Dialogue: 0,0:18:22.51,0:18:23.97,Default,,0,0,0,,Президент, не болды?
Dialogue: 0,0:18:26.60,0:18:27.68,Default,,0,0,0,,Президент?
Dialogue: 0,0:18:28.10,0:18:29.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:29.98,0:18:31.48,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:31.56,0:18:33.44,Default,,0,0,0,,Президентпен сөйлесу...
Dialogue: 0,0:18:33.69,0:18:35.48,Default,,0,0,0,,Жау шабуылы? (Ацуши) Иә?
Dialogue: 0,0:18:35.57,0:18:36.90,Default,,0,0,0,,тезірек көмектесіңіз
Dialogue: 0,0:18:37.32,0:18:39.61,Default,,0,0,0,,Президент жақсы, бірақ...
Dialogue: 0,0:18:39.70,0:18:42.12,Default,,0,0,0,,Сіз қайдан білесіз? Міне бітті!
Dialogue: 0,0:18:43.41,0:18:44.74,Default,,0,0,0,,Я...
Dialogue: 0,0:18:47.66,0:18:49.75,Default,,0,0,0,,Менің қолымнан ұстап көріңіз (Ацуши) Иә?
Dialogue: 0,0:18:49.83,0:18:51.29,Default,,0,0,0,,Түсінуге оңай
Dialogue: 0,0:18:57.42,0:18:59.68,Default,,0,0,0,,Бұл менің шеберімнен үйренген бірінші әдіс.
Dialogue: 0,0:19:01.43,0:19:04.30,Default,,0,0,0,,Мен қожайыннан әлі бір шөлмек ала алмаймын.
Dialogue: 0,0:19:04.60,0:19:08.98,Default,,0,0,0,,Бұл адамның табанды өлтірушіден жеңіліп қалуы мүмкін емес.
Dialogue: 0,0:19:09.48,0:19:13.11,Default,,0,0,0,,Уф... (Фукузава) Қайтыңыз да, Ұстазға айтыңыз.
Dialogue: 0,0:19:13.19,0:19:15.07,Default,,0,0,0,,«Жақсы ниет»
Dialogue: 0,0:19:15.40,0:19:18.69,Default,,0,0,0,,Егер көздейтін болсаң, мені ғана көзде!
Dialogue: 0,0:19:24.87,0:19:25.95,Default,,0,0,0,,Тамаша жұмыс
Dialogue: 0,0:19:26.33,0:19:28.20,Default,,0,0,0,,Детективтік агенттік кеңсесін тастап кетті.
Dialogue: 0,0:19:28.29,0:19:30.58,Default,,0,0,0,,Ол басқа мекемеге жасырынған сияқты.
Dialogue: 0,0:19:31.17,0:19:33.92,Default,,0,0,0,,Жаңа негіздерді табу қиын.
Dialogue: 0,0:19:34.00,0:19:36.30,Default,,0,0,0,,Порт мафиясы да қозғала бастады.
Dialogue: 0,0:19:37.30,0:19:38.42,Default,,0,0,0,,Мен бала кезімде-
Dialogue: 0,0:19:38.84,0:19:42.09,Default,,0,0,0,,Мен дәл осы мылтықты сатып алу үшін екі жыл жұмыс істедім.
Dialogue: 0,0:19:42.18,0:19:44.85,Default,,0,0,0,,Сонда да мен төрт адамды өлтірдім.
Dialogue: 0,0:19:45.68,0:19:49.18,Default,,0,0,0,,Бұл мылтықты жасайтын компания енді менікі.
Dialogue: 0,0:19:50.43,0:19:52.35,Default,,0,0,0,,Ақша - бұл қорқынышты түс
Dialogue: 0,0:19:52.48,0:19:55.27,Default,,0,0,0,,Мен қалаған бір нәрсені алған сайын...
Dialogue: 0,0:19:55.44,0:19:57.73,Default,,0,0,0,,Мен қалаған бір нәрсе аз
Dialogue: 0,0:19:58.40,0:20:03.57,Default,,0,0,0,,Жақында дүние жанып тұрған өлі жапырақтардың көк түтініндей қызықсыз болады.
Dialogue: 0,0:20:04.62,0:20:06.28,Default,,0,0,0,,Сондықтан, Джон.
Dialogue: 0,0:20:08.41,0:20:12.25,Default,,0,0,0,,Менің әлемім енді нұрға толы.
Dialogue: 0,0:20:18.21,0:20:20.21,Default,,0,0,0,,Куфуфу
Dialogue: 0,0:20:20.92,0:20:24.22,Default,,0,0,0,,Мен ол қаланы міндетті түрде аламын
Dialogue: 0,0:20:25.64,0:20:28.97,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:20:29.06,0:20:31.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:31.77,0:20:33.10,Default,,0,0,0,,Барлығың тыңдаңдар
Dialogue: 0,0:20:33.77,0:20:36.48,Default,,0,0,0,,Порт мафиясы компанияны өлтіруді жоспарлап отыр
Dialogue: 0,0:20:36.73,0:20:39.40,Default,,0,0,0,,Гильдия компанияны тонауды жоспарлап отыр
Dialogue: 0,0:20:40.03,0:20:43.36,Default,,0,0,0,,Біз детективті осы екі адамнан қорғауымыз керек.
Dialogue: 0,0:20:44.32,0:20:46.24,Default,,0,0,0,,Дазай түсіндірмесі
Dialogue: 0,0:20:46.78,0:20:48.28,Default,,0,0,0,,Иә
Dialogue: 0,0:20:48.37,0:20:49.99,Default,,0,0,0,,Гильдия – қаржылық күш
Dialogue: 0,0:20:50.08,0:20:52.70,Default,,0,0,0,,Порт мафиясы сан жағынан артық.
Dialogue: 0,0:20:52.79,0:20:56.29,Default,,0,0,0,,Осылайша біз өз құрамымызды шабуылға және қорғанысқа бөлдік.
Dialogue: 0,0:20:56.38,0:20:59.25,Default,,0,0,0,,Қарсыласқа қарсы тұру үшін тосын тактиканы қолданыңыз.
Dialogue: 0,0:20:59.71,0:21:01.84,Default,,0,0,0,,Не айтсаң да, қорғаныстың кілті...
Dialogue: 0,0:21:01.92,0:21:03.72,Default,,0,0,0,,Мұнда Йосано мырзаны қорғау
Dialogue: 0,0:21:04.34,0:21:06.18,Default,,0,0,0,,Мұғалімнің емшілік қабілеті болса...
Dialogue: 0,0:21:06.26,0:21:08.30,Default,,0,0,0,,Өлмесең, толық сауығып кете аласың.
Dialogue: 0,0:21:08.80,0:21:11.18,Default,,0,0,0,,Ал құқық бұзушылық екі топқа бөлінеді.
Dialogue: 0,0:21:11.27,0:21:15.02,Default,,0,0,0,,Танизаки-кунның құпия қабілетімен және менің күшіммен ...
Dialogue: 0,0:21:15.10,0:21:17.06,Default,,0,0,0,,Жауды бүйірден соғу
Dialogue: 0,0:21:17.60,0:21:21.44,Default,,0,0,0,,Бұл шайқастың кілті - бұл базаны жасыру.
Dialogue: 0,0:21:21.61,0:21:24.03,Default,,0,0,0,,Барлығымызды осында асығып келгенде
Dialogue: 0,0:21:24.70,0:21:26.86,Default,,0,0,0,,Өйткені қорғаныста ол жоқ.
Dialogue: 0,0:21:27.36,0:21:29.24,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:21:29.45,0:21:32.45,Default,,0,0,0,,Босс шабуылы сәтсіз аяқталды
Dialogue: 0,0:21:33.16,0:21:36.16,Default,,0,0,0,,Мен құйрықты қостым, бірақ ол...
Dialogue: 0,0:21:36.33,0:21:38.79,Default,,0,0,0,,Жарайды, жоспарланғандай.
Dialogue: 0,0:21:39.17,0:21:41.63,Default,,0,0,0,,Сонымен? Мен оны өлтірушінің киіміне кигіздім.
Dialogue: 0,0:21:42.13,0:21:44.26,Default,,0,0,0,,Радиоактивті микроэлементтер дегеніміз не?
Dialogue: 0,0:21:45.34,0:21:47.18,Default,,0,0,0,,Жауап жақсы
Dialogue: 0,0:21:47.59,0:21:49.89,Default,,0,0,0,,Бұл детективтің жасырынған жері.
Dialogue: 0,0:21:50.72,0:21:51.14,Default,,0,0,0,,♪~
Dialogue: 0,0:21:51.14,0:21:54.64,Default,,0,0,0,,♪~
Dialogue: 0,0:21:51.14,0:21:54.64,Default,,0,0,0,,Үш ұйымның біреуі ғана аман қалады.
Dialogue: 0,0:21:54.64,0:21:54.98,Default,,0,0,0,,♪~
Dialogue: 0,0:21:54.98,0:21:55.73,Default,,0,0,0,,♪~
Dialogue: 0,0:21:54.98,0:21:55.73,Default,,0,0,0,,Төбелесуден басқа жол жоқ!
Dialogue: 0,0:21:55.73,0:21:57.02,Default,,0,0,0,,Соғысудан басқа жол жоқ!
Dialogue: 0,0:21:57.35,0:22:00.36,Default,,0,0,0,,Әрине, біз соңғымыз.
Dialogue: 0,0:22:00.69,0:22:03.40,Default,,0,0,0,,Мен аяқталуын асыға күтіп жүрмін.
Dialogue: 0,0:22:04.03,0:22:06.53,Default,,0,0,0,,Бұл қабілеттері әртүрлі үш ұйым арасындағы соғыс!
Dialogue: 0,0:23:34.66,0:23:39.66,Default,,0,0,0,,~♪
