Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:38.38,0:02:42.30,Default,,0,0,0,,Бір ғана шындық Құдай
Dialogue: 0,0:02:51.35,0:02:53.69,Default,,0,0,0,,Иә, бұл менмін.
Dialogue: 0,0:02:55.23,0:02:57.61,Default,,0,0,0,,Сәлем, Жаңбыр
Dialogue: 0,0:03:17.63,0:03:20.38,Default,,0,0,0,,Сіз Құдайсыз ба?
Dialogue: 0,0:03:21.51,0:03:24.85,Default,,0,0,0,,Иә, мен Құдаймын.
Dialogue: 0,0:03:32.31,0:03:36.98,Default,,0,0,0,,Сен неге құдайсың? Мен түсінбедім.
Dialogue: 0,0:03:41.61,0:03:45.32,Default,,0,0,0,,Сен өлдің, солай емес пе? Жай адам ретінде
Dialogue: 0,0:03:45.32,0:03:49.50,Default,,0,0,0,,Мұндай адамның құдайға айналуы мүмкін емес.
Dialogue: 0,0:03:52.08,0:03:55.50,Default,,0,0,0,,Мен дененің қажеті жоқ екенін түсіндім.
Dialogue: 0,0:03:56.59,0:04:00.47,Default,,0,0,0,,Өлім - денені жай ғана тастап кету.
Dialogue: 0,0:04:03.47,0:04:06.35,Default,,0,0,0,,Бұл Чисаго-чан туралы.
Dialogue: 0,0:04:14.19,0:04:16.86,Default,,0,0,0,,Бұл... дұрыс.
Dialogue: 0,0:04:18.52,0:04:21.86,Default,,0,0,0,,Мен Wired-ті басқаратын хаттаманы әзірледім.
Dialogue: 0,0:04:23.65,0:04:26.95,Default,,0,0,0,,Иә, айттыңыз.
Dialogue: 0,0:04:26.95,0:04:29.87,Default,,0,0,0,,Бірақ хаттамалар жай ғана келісімдер.
Dialogue: 0,0:04:29.87,0:04:38.04,Default,,0,0,0,,Иә, бірақ мен жоғары фазада жұмыс істейтін шифрланған кодты жаздым.
Dialogue: 0,0:04:38.04,0:04:39.17,Default,,0,0,0,,Бұл – Қабырға.
Dialogue: 0,0:04:43.26,0:04:48.18,Default,,0,0,0,,Протокол қысылған ақпаратты қамтиды
Dialogue: 0,0:04:49.51,0:04:51.18,Default,,0,0,0,,Қандай ақпарат?
Dialogue: 0,0:04:51.18,0:04:54.19,Default,,0,0,0,,Адам жады, бұл кеніш
Dialogue: 0,0:04:54.19,0:04:59.65,Default,,0,0,0,,Масами Эйри есімді адамның ойлары, тарихы, жазбалары, эмоциялары
Dialogue: 0,0:05:01.53,0:05:04.70,Default,,0,0,0,,Қызық, бұл нені білдіреді?
Dialogue: 0,0:05:06.11,0:05:10.45,Default,,0,0,0,,Wired Anonymous ретінде мәңгі өмір сүріңіз
Dialogue: 0,0:05:10.45,0:05:13.50,Default,,0,0,0,,Ақпарат арқылы оны басқара алатын болмыс
Dialogue: 0,0:05:14.91,0:05:18.04,Default,,0,0,0,,Мұндай тіршілік иесі қалай аталады деп ойлайсың?
Dialogue: 0,0:05:19.34,0:05:20.59,Default,,0,0,0,,Құдай
Dialogue: 0,0:05:20.59,0:05:22.76,Default,,0,0,0,,Құдай жоқ
Dialogue: 0,0:05:25.42,0:05:30.47,Default,,0,0,0,,Иә, ол әмбебап болмыс болса да және әсер ете алады
Dialogue: 0,0:05:30.47,0:05:33.31,Default,,0,0,0,,Оған құлшылық етушілерсіз Құдай жетпейді
Dialogue: 0,0:05:34.27,0:05:38.52,Default,,0,0,0,,Бірақ ол сонда болды. Жоқ, сен орындадың.
Dialogue: 0,0:05:40.40,0:05:42.11,Default,,0,0,0,,Рыцарлар...
Dialogue: 0,0:05:58.12,0:06:02.88,Default,,0,0,0,,Саған енді дене керек емес, Реон.
Dialogue: 0,0:06:06.72,0:06:08.72,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:07:05.44,0:07:06.78,Default,,0,0,0,,Тұр!
Dialogue: 0,0:07:09.07,0:07:10.70,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:07:13.37,0:07:15.79,Default,,0,0,0,,Олай болса оқулығыңызды жабыңыз.
Dialogue: 0,0:07:42.48,0:07:46.57,Default,,0,0,0,,А... Мен, мен, бұл шын.
Dialogue: 0,0:07:46.57,0:07:48.23,Default,,0,0,0,,Мен тірімін!
Dialogue: 0,0:07:48.23,0:07:51.03,Default,,0,0,0,,Мен осындамын.
Dialogue: 0,0:07:51.99,0:07:54.74,Default,,0,0,0,,Бұл қалай болды?
Dialogue: 0,0:07:55.49,0:07:58.12,Default,,0,0,0,,Мен бірдеңе істедім бе?
Dialogue: 0,0:07:58.12,0:08:02.92,Default,,0,0,0,,Мен мұндай жағдайға жол бермеу үшін әрқашан сақ болдым.
Dialogue: 0,0:08:02.92,0:08:06.88,Default,,0,0,0,,Мен әрқашан біртүрлі сөздер айтудан сақ болатынмын.
Dialogue: 0,0:08:07.96,0:08:10.46,Default,,0,0,0,,Мен солай деп ойлаймын.
Dialogue: 0,0:08:11.63,0:08:15.34,Default,,0,0,0,,Мүмкін менің денем болмауы керек шығар...
Dialogue: 0,0:08:18.97,0:08:20.43,Default,,0,0,0,,Дұрыс, Реон.
Dialogue: 0,0:08:21.77,0:08:24.94,Default,,0,0,0,,Сіз нақты әлемде қажет емессіз
Dialogue: 0,0:09:24.29,0:09:25.50,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:10:49.75,0:10:51.54,Default,,0,0,0,,Әке?
Dialogue: 0,0:10:51.54,0:10:55.30,Default,,0,0,0,,Бұл қоштасу, Реон-сан.
Dialogue: 0,0:10:57.88,0:11:02.85,Default,,0,0,0,,Қазір біздің жұмысымыз аяқталғанын білесіздер.
Dialogue: 0,0:11:03.89,0:11:07.73,Default,,0,0,0,,Бұл аз уақыт болды, бірақ мен сізге көп нәрсе істей алмадым.
Dialogue: 0,0:11:07.73,0:11:10.56,Default,,0,0,0,,Енді сіз өзіңіз қалаған нәрсені жасай аласыз.
Dialogue: 0,0:11:11.85,0:11:14.57,Default,,0,0,0,,Жоқ, сіз басынан-ақ бос едіңіз.
Dialogue: 0,0:11:15.52,0:11:21.57,Default,,0,0,0,,Қоштасуға рұқсатым жоқ еді, бірақ мен сені сүйдім.
Dialogue: 0,0:11:26.16,0:11:30.00,Default,,0,0,0,,Бұл отбасылық ойын қызық болған сияқты емес.
Dialogue: 0,0:11:30.00,0:11:35.50,Default,,0,0,0,,Мүмкін мен сені қызғандым.
Dialogue: 0,0:11:35.50,0:11:37.30,Default,,0,0,0,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:11:45.05,0:11:45.89,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:11:47.85,0:11:49.56,Default,,0,0,0,,Мені жалғыз қалдырмаңыз!
Dialogue: 0,0:11:51.73,0:11:55.73,Default,,0,0,0,,Жалғыз ба? Сіз жалғыз емессіз.
Dialogue: 0,0:11:57.90,0:12:02.91,Default,,0,0,0,,Wired желісіне қосылыңыз және бәрі сізді қарсы алады.
Dialogue: 0,0:12:02.91,0:12:06.37,Default,,0,0,0,,Сіз де солай болдыңыз.
Dialogue: 0,0:12:27.18,0:12:29.22,Default,,0,0,0,,Мен жалғыз емеспін
Dialogue: 0,0:12:41.53,0:12:43.99,Default,,0,0,0,,Сізге не керек? Жаңбыр
Dialogue: 0,0:12:48.28,0:12:50.91,Default,,0,0,0,,Бұл сенің әлемің Жаңбыр
Dialogue: 0,0:12:52.71,0:12:58.50,Default,,0,0,0,,Рыцарлар деген кім? Мені өтірік шығарған солар ғой, солай ма?
Dialogue: 0,0:12:58.50,0:13:00.05,Default,,0,0,0,,Мен бұл туралы білмеймін.
Dialogue: 0,0:13:00.05,0:13:01.21,Default,,0,0,0,,Жоқ, мүмкін.
Dialogue: 0,0:13:01.21,0:13:07.51,Default,,0,0,0,,Арифметиканың шығыс орденінің бастауын Тамплияр рыцарларынан бастауға болатын сияқты.
Dialogue: 0,0:13:07.51,0:13:16.23,Default,,0,0,0,,Олар сымдар пайда болғанға дейін адамдардың көрінбейтін желісін және ұжымдық бейсаналықты пайдаланады.
Dialogue: 0,0:13:17.94,0:13:20.27,Default,,0,0,0,,Сізге не керек? Жаңбыр
Dialogue: 0,0:13:21.53,0:13:22.44,Default,,0,0,0,,Рыцарлар...
Dialogue: 0,0:13:23.19,0:13:25.86,Default,,0,0,0,,Рыцарлар деген кім?
Dialogue: 0,0:13:25.86,0:13:28.20,Default,,0,0,0,,Осыны білгің келеді, Жаңбыр.
Dialogue: 0,0:13:29.45,0:13:35.21,Default,,0,0,0,,Сымды құдай құдай, өйткені оған табынатын адамдар бар.
Dialogue: 0,0:14:02.02,0:14:05.90,Default,,0,0,0,,Эй, Таро, басқа жаққа барайық.
Dialogue: 0,0:14:05.90,0:14:07.78,Default,,0,0,0,,Бұл қызық емес пе?
Dialogue: 0,0:14:07.78,0:14:10.62,Default,,0,0,0,,Дұрыс, сен осында емессің бе?
Dialogue: 0,0:14:10.62,0:14:12.99,Default,,0,0,0,,Масаюки, сізге келудің қажеті жоқ.
Dialogue: 0,0:14:14.79,0:14:17.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:17.00,0:14:21.29,Default,,0,0,0,,Таро сен сияқты бәйбішелермен айналыспайды.
Dialogue: 0,0:14:21.29,0:14:22.71,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:14:22.71,0:14:25.13,Default,,0,0,0,,Мьюмью әлі бала.
Dialogue: 0,0:14:26.84,0:14:31.22,Default,,0,0,0,,Қыздар жақсы, өйткені қыздар жас кезінде жақсырақ болады.
Dialogue: 0,0:14:31.22,0:14:33.22,Default,,0,0,0,,Дұрыс? Таро
Dialogue: 0,0:14:33.22,0:14:34.64,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:34.64,0:14:39.60,Default,,0,0,0,,Таро... Не болды? Net News бірдеңе айтып жатыр ма?
Dialogue: 0,0:14:39.60,0:14:40.81,Default,,0,0,0,,Тізім
Dialogue: 0,0:14:40.81,0:14:42.73,Default,,0,0,0,,Иә? Қандай тізім?
Dialogue: 0,0:14:43.40,0:14:48.20,Default,,0,0,0,,Неліктен Knights мүшелерінің тізімі Net News сайтында орналасқан?
Dialogue: 0,0:15:04.04,0:15:05.50,Default,,0,0,0,,... иә?
Dialogue: 0,0:15:11.22,0:15:13.01,Default,,0,0,0,,Өтінемін, дыбыс шығармаңыз
Dialogue: 0,0:15:14.39,0:15:16.01,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:15:16.01,0:15:17.84,Default,,0,0,0,,Сақ болайық, солай ма?
Dialogue: 0,0:15:17.84,0:15:19.59,Default,,0,0,0,,Не?!
Dialogue: 0,0:15:52.47,0:15:54.60,Default,,0,0,0,,Анашым, мені ұрды!
Dialogue: 0,0:15:54.60,0:15:56.31,Default,,0,0,0,,Мама!
Dialogue: 0,0:15:57.14,0:16:01.56,Default,,0,0,0,,Ендігі кезек анаға келді. Келмесең, мен жалғастырамын.
Dialogue: 0,0:16:01.56,0:16:03.56,Default,,0,0,0,,Анашым, жақсысыз ба?
Dialogue: 0,0:16:04.69,0:16:07.57,Default,,0,0,0,,Ей, мен анау жігіттерді ұрамын, жарай ма?
Dialogue: 0,0:16:11.15,0:16:15.32,Default,,0,0,0,,Бүгінгі таңда әлем елдерінде тізбекті суицидтер бірінен соң бірі орын алуда.
Dialogue: 0,0:16:15.32,0:16:20.79,Default,,0,0,0,,Әр елдегі ақпаратты басқару бюросы мен полиция оның себебін зерттей бастады.
Dialogue: 0,0:16:20.79,0:16:25.53,Default,,0,0,0,,Өз-өзіне қол жұмсаған адамдардың барлығы желіге қатысты.
Dialogue: 0,0:16:25.53,0:16:32.26,Default,,0,0,0,,Дереккөздер бойынша, ол рыцарьлар деп аталатын достық тобының мүшесі деген болжам бар.
Dialogue: 0,0:17:18.39,0:17:22.02,Default,,0,0,0,,Неліктен олай істедің?
Dialogue: 0,0:17:22.98,0:17:26.81,Default,,0,0,0,,Бұл біздің клиенттің сұрауы
Dialogue: 0,0:17:26.81,0:17:30.98,Default,,0,0,0,,Сіз бүкіл әлем бойынша рыцарьларды ауладыңыз.
Dialogue: 0,0:17:30.98,0:17:35.95,Default,,0,0,0,,Біздің әріптестер қазір мәселені өңдеу үшін бірлесіп жұмыс істеуде.
Dialogue: 0,0:17:35.95,0:17:38.16,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,0:17:38.87,0:17:42.74,Default,,0,0,0,,Сымды ерекше дүние болмауы керек
Dialogue: 0,0:17:42.74,0:17:47.71,Default,,0,0,0,,Нақты әлемді күшейтетін ішкі жүйе ретінде жұмыс істеуі керек өріс.
Dialogue: 0,0:17:49.04,0:17:50.96,Default,,0,0,0,,Сондықтан...
Dialogue: 0,0:17:51.55,0:17:56.17,Default,,0,0,0,,Сіз сондай-ақ Wired қолданбасында болмауы керек адамсыз.
Dialogue: 0,0:17:56.17,0:17:58.30,Default,,0,0,0,,Бірақ сіз қауіпсізсіз, солай емес пе?
Dialogue: 0,0:18:00.18,0:18:04.35,Default,,0,0,0,,Шамасы, сізде құдайдың қорғауы бар.
Dialogue: 0,0:18:06.85,0:18:13.11,Default,,0,0,0,,Сайып келгенде, Масами Эйридің қалдық ойлар бағдарламасы да Wired арқылы дезинфекцияланады.
Dialogue: 0,0:18:13.11,0:18:20.74,Default,,0,0,0,,Біздің клиент Жеті протокол кодын толығымен қайта жазу процесінде.
Dialogue: 0,0:18:24.04,0:18:27.04,Default,,0,0,0,,Бізге Құдай керек емес.
Dialogue: 0,0:18:27.04,0:18:30.67,Default,,0,0,0,,Иә, сымды және нақты әлем.
Dialogue: 0,0:18:45.93,0:18:51.02,Default,,0,0,0,,Біз сіздің кім екеніңізді әлі түсінбейміз.
Dialogue: 0,0:18:56.49,0:18:59.82,Default,,0,0,0,,Бірақ сен маған ұнайсың
Dialogue: 0,0:19:03.33,0:19:07.70,Default,,0,0,0,,Махаббат біртүрлі сезім.
Dialogue: 0,0:19:35.98,0:19:37.57,Default,,0,0,0,,Не істеу керек?
Dialogue: 0,0:19:38.53,0:19:41.78,Default,,0,0,0,,Кел, мен не істеуім керек?
Dialogue: 0,0:19:44.78,0:19:48.04,Default,,0,0,0,,Намаз оқитын адам қалмады.
Dialogue: 0,0:19:49.58,0:19:55.54,Default,,0,0,0,,Сонда олар енді құдай болмас еді, бірақ бұл олардың бәрі жоғалып кетті дегенді білдірмейді.
Dialogue: 0,0:19:55.54,0:20:00.09,Default,,0,0,0,,Бір адамның да иманы болса, мен құдай болып қала аламын.
Dialogue: 0,0:20:00.92,0:20:02.22,Default,,0,0,0,,Кім?
Dialogue: 0,0:20:03.22,0:20:06.68,Default,,0,0,0,,Мен сені жек көремін, Реон.
Dialogue: 0,0:20:10.23,0:20:14.31,Default,,0,0,0,,Мен үшін сен кімсің.
Dialogue: 0,0:20:14.94,0:20:18.73,Default,,0,0,0,,Сіз бастапқыда Wired ішінде дүниеге келдіңіз.
Dialogue: 0,0:20:18.73,0:20:24.32,Default,,0,0,0,,Сымның ішіндегі аңыз Сым ішіндегі ертегідегі басты кейіпкер
Dialogue: 0,0:20:30.08,0:20:31.50,Default,,0,0,0,,Ах.
Dialogue: 0,0:20:32.46,0:20:36.75,Default,,0,0,0,,Нағыз дүниедегі Рейн Ивакура – соның голограммасы ғана.
Dialogue: 0,0:20:36.75,0:20:39.88,Default,,0,0,0,,Жасанды рибосомалары бар гомункулус
Dialogue: 0,0:20:40.63,0:20:43.05,Default,,0,0,0,,Сіз бірінші кезекте жоқсыз.
Dialogue: 0,0:20:44.89,0:20:45.97,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:20:47.80,0:20:53.69,Default,,0,0,0,,Өтіріктің отбасы, өтіріктің досы, бәрі өтірік болды.
Dialogue: 0,0:20:56.27,0:20:57.48,Default,,0,0,0,,Бұл өтірік...
Dialogue: 0,0:21:00.11,0:21:02.19,Default,,0,0,0,,Бұл өтірік...
Dialogue: 0,0:21:04.61,0:21:08.62,Default,,0,0,0,,Бейшара Реон қазірдің өзінде жалғыз.
Dialogue: 0,0:21:08.62,0:21:13.79,Default,,0,0,0,,Бірақ мен бармын, сүйетін мен бармын.
Dialogue: 0,0:21:13.79,0:21:18.13,Default,,0,0,0,,Сені осы дүниеге жібергенім үшін мені жақсы көруің керек.
Dialogue: 0,0:21:20.75,0:21:24.26,Default,,0,0,0,,Мен сенің жаратушыңмын
Dialogue: 0,0:21:24.80,0:21:27.26,Default,,0,0,0,,Мені сүй...
Dialogue: 0,0:21:28.26,0:21:30.26,Default,,0,0,0,,Дұрыс па, Рейн?
Dialogue: 0,0:21:31.43,0:21:33.27,Default,,0,0,0,,Басқа...
Dialogue: 0,0:21:35.64,0:21:37.77,Default,,0,0,0,,Тағы мен...
Dialogue: 0,0:21:37.77,0:21:43.15,Default,,0,0,0,,Сен енді жалғыз емессің, нағыз өзіңсің.
Dialogue: 0,0:21:46.49,0:21:48.49,Default,,0,0,0,,Кез келген жағдайда жақсы!
Dialogue: 0,0:22:15.40,0:22:20.40,Default,,0,0,0,,Кунагиса жасаған. Несиені алып тастамаңыз
Dialogue: 0,0:22:20.42,0:22:25.42,Default,,0,0,0,,Қолдау немесе маған хабарласыңыз: patreon.com/kunagisa және ko-fi.com/kunagisa
