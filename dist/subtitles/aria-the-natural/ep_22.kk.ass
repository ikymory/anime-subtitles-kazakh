Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.96,0:00:08.30,Default,,0,0,0,,♬～
Dialogue: 0,0:00:08.30,0:00:12.31,Default,,0,0,0,,<Ай-чан, мен қазіргіден өзгеше болсам ше?➡
Dialogue: 0,0:00:12.31,0:00:14.64,Default,,0,0,0,,Сіз бұл туралы ойладыңыз ба? ＞
Dialogue: 0,0:00:14.64,0:00:18.31,Default,,0,0,0,,<Егер мен Undine болуды мақсат етпесем➡
Dialogue: 0,0:00:18.31,0:00:22.32,Default,,0,0,0,,Мен Алисияны немесе басқаларды кездестірмедім➡
Dialogue: 0,0:00:22.32,0:00:25.32,Default,,0,0,0,,Ай-чан➡ сияқты тұрғын үйде
Dialogue: 0,0:00:25.32,0:00:27.99,Default,,0,0,0,,Олар бөтен адамдар емес пе?
Dialogue: 0,0:00:27.99,0:00:30.99,Default,,0,0,0,,<Өте біртүрлі сезім>
Dialogue: 0,0:00:34.66,0:00:38.33,Default,,0,0,0,,Президент Ария параллель әлемдер туралы біледі ме?
Dialogue: 0,0:00:38.33,0:00:40.34,Default,,0,0,0,,Пуинюпуи?
Dialogue: 0,0:00:40.34,0:00:43.01,Default,,0,0,0,,Бұл дүниеден басқа жерде
Dialogue: 0,0:00:43.01,0:00:46.01,Default,,0,0,0,,Ол жерде жұмбақ дүние болуы мүмкін.
Dialogue: 0,0:00:46.01,0:00:49.01,Default,,0,0,0,,Мұндай дүние параллель дүние деп аталады.
Dialogue: 0,0:00:49.01,0:00:54.35,Default,,0,0,0,,Жаңа Пуи! Мысалы, шытырман оқиғаға толы әлем.
Dialogue: 0,0:00:54.35,0:00:56.35,Default,,0,0,0,,Пуи?
Dialogue: 0,0:00:56.35,0:00:58.69,Default,,0,0,0,,《Қой! 》
Dialogue: 0,0:00:58.69,0:01:01.39,Default,,0,0,0,,《Пупуи Пуиню~! 》
Dialogue: 0,0:01:02.29,0:01:05.63,Default,,0,0,0,,Мысалы, Президент Ария жұлдыз болатын әлем.
Dialogue: 0,0:01:05.63,0:01:07.63,Default,,0,0,0,,Pupui⁉
Dialogue: 0,0:01:07.63,0:01:10.63,Default,,0,0,0,,♪《Пуй Пуи Ча Пуи! Пуи! 》
Dialogue: 0,0:01:10.63,0:01:14.04,Default,,0,0,0,,♪《Пупуйча~! 》 《(қуаныш)》
Dialogue: 0,0:01:14.97,0:01:17.31,Default,,0,0,0,,Пупупуи Пуиню~!
Dialogue: 0,0:01:17.31,0:01:19.64,Default,,0,0,0,,Уфуфу... сондай дүние
Dialogue: 0,0:01:19.64,0:01:23.31,Default,,0,0,0,,Ол басқа кеңістікте болуы мүмкін сияқты.
Dialogue: 0,0:01:23.31,0:01:26.65,Default,,0,0,0,,А, сол баспалдақтардың арасында шығар.
Dialogue: 0,0:01:26.65,0:01:29.65,Default,,0,0,0,,Құпия кіреберіс болуы мүмкін.
Dialogue: 0,0:01:29.65,0:01:31.99,Default,,0,0,0,,Пупупуиню⁉ Уфуфуфу
Dialogue: 0,0:01:31.99,0:01:35.32,Default,,0,0,0,,Енді гондола жаттығуына барайық.
Dialogue: 0,0:01:35.32,0:01:37.33,Default,,0,0,0,,П... Пуиню
Dialogue: 0,0:01:43.00,0:01:45.00,Default,,0,0,0,,Пуиню…
Dialogue: 0,0:01:46.67,0:01:50.07,Default,,0,0,0,,...
Dialogue: 0,0:01:51.01,0:01:53.34,Default,,0,0,0,,Пуи
Dialogue: 0,0:01:53.34,0:01:56.04,Default,,0,0,0,,Пу...пуи
Dialogue: 0,0:01:58.35,0:02:01.28,Default,,0,0,0,,...
Dialogue: 0,0:02:01.28,0:02:05.62,Default,,0,0,0,,Күшік күшік... күшік күшік...
Dialogue: 0,0:02:05.62,0:02:10.29,Default,,0,0,0,,Пуиню~!!
Dialogue: 0,0:02:10.29,0:02:12.29,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:02:14.63,0:02:17.30,Default,,0,0,0,,(балконға құлау дыбысы)
Dialogue: 0,0:02:17.30,0:02:21.30,Default,,0,0,0,,...
Dialogue: 0,0:02:22.30,0:02:24.64,Default,,0,0,0,,Пуиню…
Dialogue: 0,0:02:24.64,0:02:28.31,Default,,0,0,0,,О, болды! Pupui?
Dialogue: 0,0:02:28.31,0:02:32.65,Default,,0,0,0,,Кәне, президент Ария, гондола жаттығуына барайық.
Dialogue: 0,0:02:32.65,0:02:35.05,Default,,0,0,0,,Пуинюпуи?
Dialogue: 0,0:02:36.32,0:02:38.99,Default,,0,0,0,,Иә Pupui?
Dialogue: 0,0:02:38.99,0:02:42.32,Default,,0,0,0,,Енді кеттік... Пупуиню!
Dialogue: 0,0:02:42.32,0:02:45.99,Default,,0,0,0,,Күшік пупиню! Пуи~!
Dialogue: 0,0:02:45.99,0:03:05.95,Default,,0,0,0,,♬～
Dialogue: 0,0:03:05.95,0:03:25.97,Default,,0,0,0,,♬～
Dialogue: 0,0:03:25.97,0:03:45.99,Default,,0,0,0,,♬～
Dialogue: 0,0:03:45.99,0:04:05.94,Default,,0,0,0,,♬～
Dialogue: 0,0:04:05.94,0:04:18.25,Default,,0,0,0,,♬～
Dialogue: 0,0:04:27.30,0:04:30.63,Default,,0,0,0,,Бұрын не болды? Ария президенті
Dialogue: 0,0:04:30.63,0:04:35.30,Default,,0,0,0,,П… уф… күшік…
Dialogue: 0,0:04:35.30,0:04:37.31,Default,,0,0,0,,А…?
Dialogue: 0,0:04:39.31,0:04:43.31,Default,,0,0,0,,Ах... Эй, Алиса!
Dialogue: 0,0:04:43.31,0:04:46.98,Default,,0,0,0,,Ах, Ақари-сенпай, қайырлы таң.
Dialogue: 0,0:04:46.98,0:04:50.32,Default,,0,0,0,,Ал, сен мұнда не істеп жүрсің?
Dialogue: 0,0:04:50.32,0:04:53.66,Default,,0,0,0,,Тынш... Ах!
Dialogue: 0,0:04:53.66,0:04:58.33,Default,,0,0,0,,Бұл... Айка-кун мен Аль-чан
Dialogue: 0,0:04:58.33,0:05:00.93,Default,,0,0,0,,Кейде екеуміз ғана кездесеміз.
Dialogue: 0,0:05:00.93,0:05:02.93,Default,,0,0,0,,Бұл үлкен және күдікті.
Dialogue: 0,0:05:02.93,0:05:05.23,Default,,0,0,0,,Пуича...
Dialogue: 0,0:05:06.27,0:05:09.94,Default,,0,0,0,,...
Dialogue: 0,0:05:09.94,0:05:11.94,Default,,0,0,0,,Пуинью?
Dialogue: 0,0:05:11.94,0:05:14.61,Default,,0,0,0,,Пуф! Пуиню…
Dialogue: 0,0:05:14.61,0:05:17.95,Default,,0,0,0,,Пупуиню? (Акацуки) Ой, сен шырша емессің бе?
Dialogue: 0,0:05:17.95,0:05:21.28,Default,,0,0,0,,Пууеее! Ах Акацуки-сан...
Dialogue: 0,0:05:21.28,0:05:25.29,Default,,0,0,0,,Бүгін де жақсы жаққыштар. Олар қаптал емес...
Dialogue: 0,0:05:25.29,0:05:27.62,Default,,0,0,0,,...Бұл бәрі емес.
Dialogue: 0,0:05:27.62,0:05:29.62,Default,,0,0,0,,Иә?не?
Dialogue: 0,0:05:29.62,0:05:31.96,Default,,0,0,0,,Әй, бұл Әл мен гача қаламы емес!
Dialogue: 0,0:05:31.96,0:05:35.30,Default,,0,0,0,,Дұрыс па? сен не істеп жатырсың? сол балалар
Dialogue: 0,0:05:35.30,0:05:37.97,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:37.97,0:05:40.64,Default,,0,0,0,,《Бұл дүниеден басқа жерде➡
Dialogue: 0,0:05:40.64,0:05:44.31,Default,,0,0,0,,Жұмбақ әлем болуы мүмкін.》
Dialogue: 0,0:05:44.31,0:05:48.31,Default,,0,0,0,,《Мұндай әлем параллель әлем деп аталады》
Dialogue: 0,0:05:49.64,0:05:53.65,Default,,0,0,0,,П… күшік…
Dialogue: 0,0:05:53.65,0:05:57.32,Default,,0,0,0,,Күшік... күшік... күшік!
Dialogue: 0,0:05:57.32,0:06:00.92,Default,,0,0,0,,Пуичапия~!!
Dialogue: 0,0:06:00.92,0:06:04.59,Default,,0,0,0,,Иә? Енді мен таныс жылауды естідім ...
Dialogue: 0,0:06:04.59,0:06:06.60,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:06:06.60,0:06:09.93,Default,,0,0,0,,Colla~! Гачапен! Уау...
Dialogue: 0,0:06:09.93,0:06:12.93,Default,,0,0,0,,О, Акацуки-чан, сәлем.
Dialogue: 0,0:06:12.93,0:06:14.94,Default,,0,0,0,,Енді бұл әлі де әрекет.
Dialogue: 0,0:06:14.94,0:06:18.61,Default,,0,0,0,,Не айтып тұрсың, Поныко... Не болып жатыр!
Dialogue: 0,0:06:18.61,0:06:21.61,Default,,0,0,0,,Уау, өте қиын! Tsk...
Dialogue: 0,0:06:21.61,0:06:23.95,Default,,0,0,0,,Ittetete... Ауырды!
Dialogue: 0,0:06:23.95,0:06:25.95,Default,,0,0,0,,P…
Dialogue: 0,0:06:25.95,0:06:29.28,Default,,0,0,0,,Пупуу…пууинюу…
Dialogue: 0,0:06:29.28,0:06:32.29,Default,,0,0,0,,Пу… Пупуиню…
Dialogue: 0,0:06:32.29,0:06:39.29,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:06:41.30,0:06:44.30,Default,,0,0,0,,Жарайды... сенің мұны істеуге ешқандай мүмкіндік жоқ, солай ма?
Dialogue: 0,0:06:44.30,0:06:46.64,Default,,0,0,0,,Өйткені біз кездейсоқ кездесіп қалдық.
Dialogue: 0,0:06:46.64,0:06:49.30,Default,,0,0,0,,Мен саған жүктеріңді алып жүруге көмектестім.
Dialogue: 0,0:06:49.30,0:06:51.97,Default,,0,0,0,,Мен сенбеймін! Гачапен!
Dialogue: 0,0:06:51.97,0:06:54.98,Default,,0,0,0,,Мен сенің бүлінген тамырыңды түзетемін.
Dialogue: 0,0:06:54.98,0:06:56.98,Default,,0,0,0,,Менің әнімді тыңдаңдар!
Dialogue: 0,0:06:56.98,0:07:01.58,Default,,0,0,0,,♪ Сезімдерім қызып барады~ Эй... Понико, тоқта!
Dialogue: 0,0:07:01.58,0:07:03.59,Default,,0,0,0,,Ұсқынсыз фальсеттоға тыйым салынады!
Dialogue: 0,0:07:03.59,0:07:06.25,Default,,0,0,0,,Күте тұрыңыз... екеуің де тоқтаңдар.
Dialogue: 0,0:07:06.25,0:07:08.26,Default,,0,0,0,,Бұл өте үлкен. Көбірек жасаңыз.
Dialogue: 0,0:07:08.26,0:07:11.26,Default,,0,0,0,,Жарайды, екеуміз де тынышталамыз.
Dialogue: 0,0:07:11.26,0:07:14.26,Default,,0,0,0,,Пуиню…
Dialogue: 0,0:07:14.26,0:07:18.60,Default,,0,0,0,,Ня? Няун (Президент Ария) Пуи?
Dialogue: 0,0:07:18.60,0:07:21.60,Default,,0,0,0,,Пупупуича Пуича!
Dialogue: 0,0:07:21.60,0:07:24.31,Default,,0,0,0,,Мияу~
Dialogue: 0,0:07:26.27,0:07:30.28,Default,,0,0,0,,Пуи…? Пуичапуи⁉
Dialogue: 0,0:07:31.95,0:07:33.95,Default,,0,0,0,,Жарайды (Президент Ария) Уф!
Dialogue: 0,0:07:33.95,0:07:36.25,Default,,0,0,0,,Ал...
Dialogue: 0,0:07:37.29,0:07:39.29,Default,,0,0,0,,Пуи?
Dialogue: 0,0:07:39.29,0:07:41.96,Default,,0,0,0,,Ал...
Dialogue: 0,0:07:41.96,0:07:45.29,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:07:45.29,0:07:48.30,Default,,0,0,0,,Пуича...! Pupui?
Dialogue: 0,0:07:48.30,0:07:51.63,Default,,0,0,0,,Президент Ария, не болды? Мен өзімді жақсы сезінбеймін.
Dialogue: 0,0:07:51.63,0:07:53.64,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:07:53.64,0:07:57.34,Default,,0,0,0,,Бүгін, президент Ария, бұл біраз оғаш болды.
Dialogue: 0,0:07:58.31,0:08:01.58,Default,,0,0,0,,Біртүрлі тамақ жеген жоқсың ба?
Dialogue: 0,0:08:01.58,0:08:04.58,Default,,0,0,0,,Мүмкін қарныңыз ашқан шығар.
Dialogue: 0,0:08:04.58,0:08:08.98,Default,,0,0,0,,Иә, иә (Акацуки) Хмм... мүмкін бе?
Dialogue: 0,0:08:11.59,0:08:14.92,Default,,0,0,0,,Қараңдаршы, Президент Ария, мама.
Dialogue: 0,0:08:14.92,0:08:17.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:17.26,0:08:19.26,Default,,0,0,0,,Pui...
Dialogue: 0,0:08:19.26,0:08:23.60,Default,,0,0,0,,Аа, президент Ария, сіз аш болған сияқтысыз.
Dialogue: 0,0:08:23.60,0:08:27.27,Default,,0,0,0,,Бір жақсысы, мен үлкен тойымсызмын.
Dialogue: 0,0:08:27.27,0:08:29.60,Default,,0,0,0,,Қараңызшы, тағы да бар.
Dialogue: 0,0:08:29.60,0:08:31.94,Default,,0,0,0,,(Насиро) Рей! (Сузуя) Ол қазір Джузо~
Dialogue: 0,0:08:31.94,0:08:33.94,Default,,0,0,0,,Хехе
Dialogue: 0,0:08:33.94,0:08:36.95,Default,,0,0,0,,(Насиро) Рей! (Сузуя) Ол қазір Джузо~
Dialogue: 0,0:08:42.28,0:08:44.29,Default,,0,0,0,,Пупуйча…
Dialogue: 0,0:08:44.29,0:08:46.29,Default,,0,0,0,,Мияу
Dialogue: 0,0:08:46.29,0:08:48.99,Default,,0,0,0,,Мияу~
Dialogue: 0,0:08:50.63,0:08:54.96,Default,,0,0,0,,Пуи... Пупуи... Пупупи~!
Dialogue: 0,0:08:54.96,0:08:58.63,Default,,0,0,0,,Пупупуи...! А, президент Ария?
Dialogue: 0,0:08:58.63,0:09:01.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:02.57,0:09:08.24,Default,,0,0,0,,Пуи Пуи Пуи Пуи...!
Dialogue: 0,0:09:08.24,0:09:24.26,Default,,0,0,0,,♬～
Dialogue: 0,0:09:24.26,0:09:26.56,Default,,0,0,0,,Пойни...
Dialogue: 0,0:09:29.60,0:09:32.27,Default,,0,0,0,,Уф...! Пупуйча...
Dialogue: 0,0:09:32.27,0:09:36.94,Default,,0,0,0,,Президент Ария? (Президент Ария) Уф! Пупуйча?
Dialogue: 0,0:09:36.94,0:09:40.28,Default,,0,0,0,,Не болды?
Dialogue: 0,0:09:40.28,0:09:43.98,Default,,0,0,0,,Писка...
Dialogue: 0,0:09:45.61,0:09:49.28,Default,,0,0,0,,Пуйпуи! (Акира) Не болды? Алисия
Dialogue: 0,0:09:49.28,0:09:53.62,Default,,0,0,0,,Аа, президент Ария өзін жақсы сезінбейтін сияқты.
Dialogue: 0,0:09:53.62,0:09:56.29,Default,,0,0,0,,Уау, бұл қиын.
Dialogue: 0,0:09:56.29,0:09:58.63,Default,,0,0,0,,Сіз жай ғана аштыңыз ба?
Dialogue: 0,0:09:58.63,0:10:02.63,Default,,0,0,0,,Эй, Ария президенті, бұл өте қымбат!
Dialogue: 0,0:10:02.63,0:10:05.03,Default,,0,0,0,,Пуи…
Dialogue: 0,0:10:06.30,0:10:08.97,Default,,0,0,0,,...
Dialogue: 0,0:10:08.97,0:10:13.31,Default,,0,0,0,,Жоғары! Хоора хора
Dialogue: 0,0:10:13.31,0:10:17.31,Default,,0,0,0,,Жоғары! (Президент Ария) Пупупуиню...
Dialogue: 0,0:10:17.31,0:10:19.65,Default,,0,0,0,,Puppuipui~
Dialogue: 0,0:10:19.65,0:10:22.32,Default,,0,0,0,,Жақсы~ Бұл жоғары ма?
Dialogue: 0,0:10:22.32,0:10:25.32,Default,,0,0,0,,Аа, Вуди мырза, сәлеметсіз бе.
Dialogue: 0,0:10:25.32,0:10:28.66,Default,,0,0,0,,Президент Ария өзін жақсы сезінбейді.
Dialogue: 0,0:10:28.66,0:10:32.33,Default,,0,0,0,,Маған да рұқсат бере аласыз ба?
Dialogue: 0,0:10:32.33,0:10:35.00,Default,,0,0,0,,P… pui⁉ Өтінемін, өтінемін.
Dialogue: 0,0:10:35.00,0:10:37.60,Default,,0,0,0,,Pupupupupupuinyu…
Dialogue: 0,0:10:40.67,0:10:43.67,Default,,0,0,0,,Міне! (Президент Ария) Пупупупу...
Dialogue: 0,0:10:43.67,0:10:47.68,Default,,0,0,0,,Жоғары! (Президент Ария) Пуиню...
Dialogue: 0,0:10:47.68,0:10:51.01,Default,,0,0,0,,Охохо! Хохохохо...
Dialogue: 0,0:10:51.01,0:10:56.02,Default,,0,0,0,,...
Dialogue: 0,0:10:56.02,0:10:58.35,Default,,0,0,0,,Ах... (Президент Ария) Пучча!
Dialogue: 0,0:10:58.35,0:11:00.29,Default,,0,0,0,,О...
Dialogue: 0,0:11:00.29,0:11:03.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:03.29,0:11:05.63,Default,,0,0,0,,Пупупупу... Пуича Пупупупу...!
Dialogue: 0,0:11:05.63,0:11:07.63,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:11:08.96,0:11:11.57,Default,,0,0,0,,P… күшік…
Dialogue: 0,0:11:13.64,0:11:15.97,Default,,0,0,0,,Президент Ария! Президент Ария?
Dialogue: 0,0:11:15.97,0:11:18.64,Default,,0,0,0,,Президент Ария! Президент Ария!
Dialogue: 0,0:11:18.64,0:11:21.64,Default,,0,0,0,,Амансың ба? Президент Ария!
Dialogue: 0,0:11:21.64,0:11:25.31,Default,,0,0,0,,...
Dialogue: 0,0:11:25.31,0:11:28.98,Default,,0,0,0,,Амансың ба? Ария президенті
Dialogue: 0,0:11:28.98,0:11:32.65,Default,,0,0,0,,Жақсы, мен ояндым.
Dialogue: 0,0:11:32.65,0:11:36.32,Default,,0,0,0,,Еш жері ауырмайды ма? Ария президенті
Dialogue: 0,0:11:36.32,0:11:40.33,Default,,0,0,0,,Пуиню... Пуинью! Ах
Dialogue: 0,0:11:40.33,0:11:43.00,Default,,0,0,0,,Пупуу…пуипуиню…
Dialogue: 0,0:11:43.00,0:11:46.33,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:11:46.33,0:11:48.64,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:11:51.01,0:11:54.34,Default,,0,0,0,,Пуи? 《Пуй Ча Пуи》
Dialogue: 0,0:11:54.34,0:11:56.34,Default,,0,0,0,,Pupui⁉
Dialogue: 0,0:11:59.01,0:12:02.28,Default,,0,0,0,,Пуф... ау.
Dialogue: 0,0:12:02.28,0:12:06.29,Default,,0,0,0,,Президент Ария - бүлінген жезөкше.
Dialogue: 0,0:12:10.63,0:12:13.29,Default,,0,0,0,,Президент Ария, бүгін біз гондоламен айналысамыз.
Dialogue: 0,0:12:13.29,0:12:16.30,Default,,0,0,0,,Мен барайын десем, ол бір жаққа кетті.
Dialogue: 0,0:12:16.30,0:12:19.97,Default,,0,0,0,,Мен уайымдадым, себебі ол кенет жоғалып кетті.
Dialogue: 0,0:12:19.97,0:12:22.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:22.97,0:12:26.64,Default,,0,0,0,,Қайда болдың, иә...
Dialogue: 0,0:12:26.64,0:12:31.35,Default,,0,0,0,,Сіз тағы да мысықтар жиынына бардыңыз ба?
Dialogue: 0,0:12:32.98,0:12:35.98,Default,,0,0,0,,Пуи Пуиню Пуи~!
Dialogue: 0,0:12:35.98,0:12:40.99,Default,,0,0,0,,<Акари-сан, мен жиі ойлаймын, егер болса>
Dialogue: 0,0:12:40.99,0:12:45.66,Default,,0,0,0,,<Бірақ менің ойымша, болашақта не болады>
Dialogue: 0,0:12:45.66,0:12:48.33,Default,,0,0,0,,<Егер ше?...➡
Dialogue: 0,0:12:48.33,0:12:51.00,Default,,0,0,0,,Бұл құпия! Хехе>
Dialogue: 0,0:13:04.61,0:13:06.95,Default,,0,0,0,,Ал, рахмет, рахмет
Dialogue: 0,0:13:06.95,0:13:09.62,Default,,0,0,0,,Мен сені Алисиямен таныстырғаныма қуаныштымын.
Dialogue: 0,0:13:09.62,0:13:11.95,Default,,0,0,0,,Жоқ, жоқ, қош келдіңіз.
Dialogue: 0,0:13:11.95,0:13:15.96,Default,,0,0,0,,Бізді тамаша тұтынушылармен таныстырғаныңыз үшін рахмет.
Dialogue: 0,0:13:15.96,0:13:18.96,Default,,0,0,0,,Пуи Пуи Пуи Пуй Пуй Ню Нюй
Dialogue: 0,0:13:20.29,0:13:24.30,Default,,0,0,0,,Өтінемін (аға) Ах, итадакамасу.
Dialogue: 0,0:13:24.30,0:13:27.97,Default,,0,0,0,,<Ай-чан, бүгінгі бірінші тұтынушы➡
Dialogue: 0,0:13:27.97,0:13:30.64,Default,,0,0,0,,Акацукидің ағасы мәміле жасап жатыр➡
Dialogue: 0,0:13:30.64,0:13:33.31,Default,,0,0,0,,Ол адам-үй компаниясының президенті болды.＞
Dialogue: 0,0:13:33.31,0:13:37.31,Default,,0,0,0,,＜Маған оның өте қиын адам екенін айтты➡
Dialogue: 0,0:13:37.31,0:13:40.31,Default,,0,0,0,,Бірақ, шамасы, Алисияның гондоласында➡
Dialogue: 0,0:13:40.31,0:13:42.98,Default,,0,0,0,,Сіз өте риза болған сияқтысыз➡
Dialogue: 0,0:13:42.98,0:13:46.99,Default,,0,0,0,,Менің ағам рахметімді айтып келді.＞
Dialogue: 0,0:13:48.99,0:13:51.93,Default,,0,0,0,,Мен ағамнан сұрадым:
Dialogue: 0,0:13:51.93,0:13:54.93,Default,,0,0,0,,Нео Венецияичидің «Прима Ундине».
Dialogue: 0,0:13:54.93,0:13:58.93,Default,,0,0,0,,Бұл Алисия... ау, хехехе
Dialogue: 0,0:13:58.93,0:14:03.60,Default,,0,0,0,,Ол бұл жағынан өте пайдалы болды.
Dialogue: 0,0:14:03.60,0:14:06.94,Default,,0,0,0,,Мен шулы, ақымақ бала едім.
Dialogue: 0,0:14:06.94,0:14:08.94,Default,,0,0,0,,Ондай нәрсе (ағасы) Жоқ, жоқ.
Dialogue: 0,0:14:08.94,0:14:12.61,Default,,0,0,0,,Бұл рас. Не керек, сен ұялшақ адамсың.
Dialogue: 0,0:14:12.61,0:14:16.62,Default,,0,0,0,,Ха... ау, ау.
Dialogue: 0,0:14:16.62,0:14:18.62,Default,,0,0,0,,Пупуй Пупуиню~
Dialogue: 0,0:14:18.62,0:14:21.62,Default,,0,0,0,,Ойланып қарасам, қызық оқиға бар екен.
Dialogue: 0,0:14:21.62,0:14:24.33,Default,,0,0,0,,...
Dialogue: 0,0:14:29.96,0:14:34.97,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:14:37.31,0:14:40.31,Default,,0,0,0,,<Менің атым Акацуки Изумо>
Dialogue: 0,0:14:40.31,0:14:44.65,Default,,0,0,0,,<Акваның тыныштығын қорғайтын жеңілмейтін адам>
Dialogue: 0,0:14:44.65,0:14:49.65,Default,,0,0,0,,<Мен қалқыған аралда туып-өстім, мен жеңіл-желпі аралмын! ＞
Dialogue: 0,0:14:50.92,0:14:53.59,Default,,0,0,0,,Бұл мен үшін қауіпті.
Dialogue: 0,0:14:53.59,0:14:56.92,Default,,0,0,0,,Жоқ, мұндай жерге мінбе.
Dialogue: 0,0:14:56.92,0:14:58.93,Default,,0,0,0,,Хмм
Dialogue: 0,0:14:58.93,0:15:01.60,Default,,0,0,0,,Ах... (Акацуки) Ағай!
Dialogue: 0,0:15:01.60,0:15:07.60,Default,,0,0,0,,<Ешкімге айта алмайтын сырым бар>
Dialogue: 0,0:15:07.60,0:15:09.60,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:15:09.60,0:15:12.94,Default,,0,0,0,,Эй, Акацуки, мен жақында үйге барамын.
Dialogue: 0,0:15:12.94,0:15:15.94,Default,,0,0,0,,Иә? Хмм
Dialogue: 0,0:15:15.94,0:15:20.55,Default,,0,0,0,,<Шын мәнінде мен андроид едім>
Dialogue: 0,0:15:22.95,0:15:29.29,Default,,0,0,0,,♬～
Dialogue: 0,0:15:29.29,0:15:32.96,Default,,0,0,0,,Мен үйдемін~ (Акацуки) Ана қайтып келді~!
Dialogue: 0,0:15:32.96,0:15:35.96,Default,,0,0,0,,Сіз осы уақытта дүкен аралайсыз ба?
Dialogue: 0,0:15:35.96,0:15:37.97,Default,,0,0,0,,Хмм…
Dialogue: 0,0:15:37.97,0:15:39.97,Default,,0,0,0,,Ана~!
Dialogue: 0,0:15:39.97,0:15:42.97,Default,,0,0,0,,Хехехе
Dialogue: 0,0:15:42.97,0:15:44.97,Default,,0,0,0,,Тоу
Dialogue: 0,0:15:46.31,0:15:49.91,Default,,0,0,0,,Аа... (Акацуки) Ана~!
Dialogue: 0,0:15:49.91,0:15:52.58,Default,,0,0,0,,О, қандай тітіркендіргіш...
Dialogue: 0,0:15:52.58,0:15:54.58,Default,,0,0,0,,Бауырым, анам жоқ!
Dialogue: 0,0:15:54.58,0:15:57.59,Default,,0,0,0,,Мені зұлым шетелдіктер ұрлап кеткен болуы керек!
Dialogue: 0,0:15:57.59,0:15:59.92,Default,,0,0,0,,Жетті…
Dialogue: 0,0:15:59.92,0:16:01.92,Default,,0,0,0,,Ммм... Мм...
Dialogue: 0,0:16:01.92,0:16:05.59,Default,,0,0,0,,⚟ (есіктің ашылуы мен жабылу дыбысы) (Таңның анасы) Мен үйдемін.
Dialogue: 0,0:16:05.59,0:16:07.60,Default,,0,0,0,,Ха ха ха...!
Dialogue: 0,0:16:09.26,0:16:12.27,Default,,0,0,0,,Ана~! Сенімен бәрі жақсы ма?
Dialogue: 0,0:16:12.27,0:16:17.61,Default,,0,0,0,,Иә, иә, сіз қауіпсізсіз. (Акацуки) Хмм, бұл жақсы.
Dialogue: 0,0:16:17.61,0:16:19.94,Default,,0,0,0,,Иә, бүгінгі тағамдар
Dialogue: 0,0:16:19.94,0:16:22.28,Default,,0,0,0,,Мұз (Акацуки) О, керемет
Dialogue: 0,0:16:22.28,0:16:25.61,Default,,0,0,0,,Бұл Барибари-кун! (Анашым) Хехехе
Dialogue: 0,0:16:25.61,0:16:28.02,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:16:29.95,0:16:33.29,Default,,0,0,0,,Тамақты тез жесең, ашуланасың.
Dialogue: 0,0:16:33.29,0:16:35.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:35.29,0:16:38.99,Default,,0,0,0,,Китар...!
Dialogue: 0,0:16:41.96,0:16:44.63,Default,,0,0,0,,Бүгін кешкі асқа не бар?
Dialogue: 0,0:16:44.63,0:16:47.03,Default,,0,0,0,,Карри котлеті
Dialogue: 0,0:16:49.30,0:16:52.91,Default,,0,0,0,,Сіз шыныменсіз бе? (Анашым) Бұл шын.
Dialogue: 0,0:16:52.91,0:16:55.58,Default,,0,0,0,,Мұндай дәлелдер қайда?
Dialogue: 0,0:16:55.58,0:16:59.58,Default,,0,0,0,,Енді сұрақ, менің шынайы болмысым қандай?
Dialogue: 0,0:17:00.58,0:17:03.99,Default,,0,0,0,,Android... дұрыс па?
Dialogue: 0,0:17:05.92,0:17:09.92,Default,,0,0,0,,Тағамның шын екенін білу үшін соңғы кездері көп тексеріп жүрсіз.
Dialogue: 0,0:17:09.92,0:17:12.26,Default,,0,0,0,,Бұл не? Яғни
Dialogue: 0,0:17:12.26,0:17:15.93,Default,,0,0,0,,Менің анамның орнын зұлым бөтен адам басып алып, ұрлап әкеткен жоқ па?
Dialogue: 0,0:17:15.93,0:17:19.60,Default,,0,0,0,,Мен жай ғана тексеріп жатырмын. (Аға) Хмм...
Dialogue: 0,0:17:19.60,0:17:23.30,Default,,0,0,0,,Мен анам мен Акваның арасындағы татулықты қорғаймын!
Dialogue: 0,0:17:24.27,0:17:27.94,Default,,0,0,0,,Бұл тек мұғалім ауыстырылды дегенді білдіре ме?
Dialogue: 0,0:17:27.94,0:17:31.55,Default,,0,0,0,,Бұл шектеулі емес пе? (Акацуки) Иә?
Dialogue: 0,0:17:33.61,0:17:35.95,Default,,0,0,0,,Кио Кио Кио…
Dialogue: 0,0:17:35.95,0:17:37.95,Default,,0,0,0,,Кио! Кио Кио Кио…
Dialogue: 0,0:17:37.95,0:17:40.96,Default,,0,0,0,,Пияаа~!
Dialogue: 0,0:17:40.96,0:17:45.29,Default,,0,0,0,,Ооо... Ооо!!
Dialogue: 0,0:17:45.29,0:17:48.63,Default,,0,0,0,,Иә? (Есіктің ашылу және жабылу дыбысы)
Dialogue: 0,0:17:48.63,0:17:51.90,Default,,0,0,0,,Е-е, ініңді қорладың...
Dialogue: 0,0:17:51.90,0:17:56.90,Default,,0,0,0,,(Таң айқайы)
Dialogue: 0,0:17:56.90,0:18:02.91,Default,,0,0,0,,♬～
Dialogue: 0,0:18:02.91,0:18:05.91,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:18:05.91,0:18:08.58,Default,,0,0,0,,Сәлем Вуди!
Dialogue: 0,0:18:08.58,0:18:11.25,Default,,0,0,0,,Иә? Акацуки
Dialogue: 0,0:18:11.25,0:18:14.59,Default,,0,0,0,,Вуди! (Вудидің анасы) Қош келдіңіз, Акацуки-кун.
Dialogue: 0,0:18:14.59,0:18:17.59,Default,,0,0,0,,Акацуки~н (Акацуки) Какакака...
Dialogue: 0,0:18:17.59,0:18:19.93,Default,,0,0,0,,Мені жасыр! (Вуди) Иә?
Dialogue: 0,0:18:19.93,0:18:22.60,Default,,0,0,0,,Менің ағам зұлымдыққа айналды ... зұлымдық ...
Dialogue: 0,0:18:22.60,0:18:25.60,Default,,0,0,0,,Сабырланып, менімен сөйлес, Акацуки.
Dialogue: 0,0:18:25.60,0:18:27.60,Default,,0,0,0,,Хюха!
Dialogue: 0,0:18:29.27,0:18:34.28,Default,,0,0,0,,♬～
Dialogue: 0,0:18:34.28,0:18:36.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:42.95,0:18:47.96,Default,,0,0,0,,(Таң жылағаны)
Dialogue: 0,0:18:52.56,0:18:57.57,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:18:58.57,0:19:03.24,Default,,0,0,0,,Уф... Мм...
Dialogue: 0,0:19:03.24,0:19:05.94,Default,,0,0,0,,Акацуки (Акацуки) Ах...!
Dialogue: 0,0:19:07.58,0:19:09.91,Default,,0,0,0,,Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады
Dialogue: 0,0:19:09.91,0:19:11.91,Default,,0,0,0,,Уау, келме!
Dialogue: 0,0:19:11.91,0:19:14.92,Default,,0,0,0,,Уф... Мен енді ешкімге сенбеймін!
Dialogue: 0,0:19:14.92,0:19:18.92,Default,,0,0,0,,Фу…
Dialogue: 0,0:19:18.92,0:19:21.26,Default,,0,0,0,,Сіз әлі де Androidсіз бе?
Dialogue: 0,0:19:21.26,0:19:23.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:24.26,0:19:32.60,Default,,0,0,0,,♬～
Dialogue: 0,0:19:32.60,0:19:35.27,Default,,0,0,0,,Әй, менің...
Dialogue: 0,0:19:35.27,0:19:39.94,Default,,0,0,0,,♬～
Dialogue: 0,0:19:39.94,0:19:42.94,Default,,0,0,0,,Хмм
Dialogue: 0,0:19:42.94,0:19:44.95,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:19:44.95,0:19:48.28,Default,,0,0,0,,Жарайды, зұлым бөтеннің кім екенін білмеймін.
Dialogue: 0,0:19:48.28,0:19:50.62,Default,,0,0,0,,Бұдан былай ана сияқты
Dialogue: 0,0:19:50.62,0:19:52.95,Default,,0,0,0,,Әр адамды жеке тексеру керек емес пе?
Dialogue: 0,0:19:52.95,0:19:56.56,Default,,0,0,0,,О, түсіндім! (Анашым) Хехехе
Dialogue: 0,0:19:59.63,0:20:02.96,Default,,0,0,0,,Менің анам – стратег, күткендей!
Dialogue: 0,0:20:02.96,0:20:07.97,Default,,0,0,0,,Бұл әлі андроидтердің анасы, иә...
Dialogue: 0,0:20:07.97,0:20:13.31,Default,,0,0,0,,♬～
Dialogue: 0,0:20:13.31,0:20:15.64,Default,,0,0,0,,Әй, қызық емес пе?
Dialogue: 0,0:20:15.64,0:20:20.65,Default,,0,0,0,,Акацукидің балалық шағы мен айтқан ақымақтық болды.
Dialogue: 0,0:20:20.65,0:20:23.32,Default,,0,0,0,,Pupui~! Күрсін...
Dialogue: 0,0:20:23.32,0:20:28.99,Default,,0,0,0,,Содан бері біз кездескен сайын бір-бірімізден: «Менің шын тұлғам қандай?» деп сұрайтынбыз.
Dialogue: 0,0:20:28.99,0:20:32.66,Default,,0,0,0,,Ауыр жағдайларда сізге бұл сұрақты күніне 10 реттен көп қоюға болады.
Dialogue: 0,0:20:32.66,0:20:36.33,Default,,0,0,0,,Қандай сұрақ болса да, әр уақытта бір сұрақ.
Dialogue: 0,0:20:36.33,0:20:40.67,Default,,0,0,0,,Бұл тіпті құпия емес.
Dialogue: 0,0:20:40.67,0:20:45.34,Default,,0,0,0,,Өзімнен кіші іні болсам да, сізден көмек сұрай беремін.
Dialogue: 0,0:20:45.34,0:20:49.34,Default,,0,0,0,,О, сәлем, сәлем...
Dialogue: 0,0:20:49.34,0:20:53.61,Default,,0,0,0,,<Егер Акацуки-сан бұл күйді көрсе, есінен танып қалады...>
Dialogue: 0,0:20:53.61,0:20:55.62,Default,,0,0,0,,Пупупуича Пуича!
Dialogue: 0,0:20:55.62,0:20:57.95,Default,,0,0,0,,Уа, көбірек тыңдағың келе ме? (Президент Ария) Пуи!
Dialogue: 0,0:20:57.95,0:21:01.29,Default,,0,0,0,,Бұл оның бала кезіндегі қолтаңбасы болды.
Dialogue: 0,0:21:01.29,0:21:03.62,Default,,0,0,0,,Сәлем! (Президент Ария) Пупуй... Пуи~!
Dialogue: 0,0:21:03.62,0:21:06.96,Default,,0,0,0,,Иә, иә, иә! Бұл (Президент Ария) Пуппупу... Күшік!
Dialogue: 0,0:21:06.96,0:21:09.30,Default,,0,0,0,,Артыңызда сәл артық салмақ бар! Болды
Dialogue: 0,0:21:09.30,0:21:12.63,Default,,0,0,0,,Пуи! (Аға) Бұл жақсы идея!
Dialogue: 0,0:21:12.63,0:21:18.97,Default,,0,0,0,,♬～
Dialogue: 0,0:21:18.97,0:21:21.98,Default,,0,0,0,,Әй, Акацуки-сан! (Акацуки) Иә?
Dialogue: 0,0:21:21.98,0:21:26.31,Default,,0,0,0,,Ио, Момико! ...О, Алисия!
Dialogue: 0,0:21:26.31,0:21:29.65,Default,,0,0,0,,Күні кеше... ақымақ ағам...
Dialogue: 0,0:21:29.65,0:21:33.32,Default,,0,0,0,,Мен сені мазалаған сияқтымын...?
Dialogue: 0,0:21:33.32,0:21:35.32,Default,,0,0,0,,Пупуй... Пуи~!
Dialogue: 0,0:21:35.32,0:21:37.99,Default,,0,0,0,,Ой... Сәлем, Момико!
Dialogue: 0,0:21:37.99,0:21:41.66,Default,,0,0,0,,Президент Ария бұл поза туралы қайдан біледі? Эй!
Dialogue: 0,0:21:41.66,0:21:45.33,Default,,0,0,0,,Күні кеше Акацукидің ағасы қонаққа келгенде
Dialogue: 0,0:21:45.33,0:21:48.34,Default,,0,0,0,,Акацуки-санның ескі әңгімесі...
Dialogue: 0,0:21:48.34,0:21:51.34,Default,,0,0,0,,Әй, хехехе
Dialogue: 0,0:21:54.28,0:21:57.95,Default,,0,0,0,,Иә!!
Dialogue: 0,0:21:57.95,0:22:02.28,Default,,0,0,0,,♬～
Dialogue: 0,0:22:02.28,0:22:05.95,Default,,0,0,0,,Пупупи... Пуиню~!
Dialogue: 0,0:22:05.95,0:22:08.62,Default,,0,0,0,,<Ай-чан, Ария президенті➡
Dialogue: 0,0:22:08.62,0:22:13.29,Default,,0,0,0,,Менің ойымша, Акацукидің бала кезіндегі қолтаңбасы маған ұнады.＞
Dialogue: 0,0:22:13.29,0:22:18.00,Default,,0,0,0,,<Ол бүгін де гондолада бақытты суретке түсіп отыр>
Dialogue: 0,0:22:19.30,0:22:22.30,Default,,0,0,0,,<Президент Арияның сүйікті қолтаңбасы➡
Dialogue: 0,0:22:22.30,0:22:24.64,Default,,0,0,0,,Менің де көргім келеді! ＞
Dialogue: 0,0:22:24.64,0:22:27.98,Default,,0,0,0,,<Ах, мен де Аквада тұрсам➡
Dialogue: 0,0:22:27.98,0:22:31.31,Default,,0,0,0,,Бірден барып көрсем ғой...>
Dialogue: 0,0:22:31.31,0:22:51.27,Default,,0,0,0,,♬～
Dialogue: 0,0:22:51.27,0:23:11.29,Default,,0,0,0,,♬～
