Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.97,0:00:06.97,Default,,0,0,0,,<Ай-чан, кешегі қармен➡
Dialogue: 0,0:00:06.97,0:00:10.97,Default,,0,0,0,,Бүгінгі Нео Венеция - қарлы пейзаж＞
Dialogue: 0,0:00:12.31,0:00:14.64,Default,,0,0,0,,<Алдағы жылға➡
Dialogue: 0,0:00:14.64,0:00:18.35,Default,,0,0,0,,Бүкіл қала боялған сияқты>
Dialogue: 0,0:00:22.32,0:00:25.99,Default,,0,0,0,,<Акари-сан, Аква алыста>
Dialogue: 0,0:00:25.99,0:00:28.66,Default,,0,0,0,,<Жаздың ыстығы мен қыстың салқыны➡
Dialogue: 0,0:00:28.66,0:00:31.66,Default,,0,0,0,,Толығырақ шомылғым келеді➡
Dialogue: 0,0:00:31.66,0:00:36.67,Default,,0,0,0,,Аква алыс, сондықтан мен әлі күнге дейін жалғыз бара алмаймын>
Dialogue: 0,0:00:38.33,0:00:43.34,Default,,0,0,0,,<Таза ақ Нео Венеция, әдемі емес пе?>
Dialogue: 0,0:00:44.67,0:00:50.38,Default,,0,0,0,,<Ай-чан, мен де Ай Чан> сияқты ойлайтынмын
Dialogue: 0,0:00:51.35,0:00:55.35,Default,,0,0,0,,Мен қазір сол кезде болғым келетін адам.
Dialogue: 0,0:00:55.35,0:00:58.65,Default,,0,0,0,,Сіз үйрендіңіз бе? (Президент Ария) Пупуй?
Dialogue: 0,0:01:02.96,0:01:06.30,Default,,0,0,0,,Аа, бірлескен жаттығуға баратын уақыт жақындап қалды.
Dialogue: 0,0:01:06.30,0:01:08.30,Default,,0,0,0,,Пупуиню
Dialogue: 0,0:01:14.64,0:01:17.64,Default,,0,0,0,,Кеттік, Алисия.
Dialogue: 0,0:01:17.64,0:01:19.98,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:01:19.98,0:01:39.10,Default,,0,0,0,,♬～
Dialogue: 0,0:01:39.10,0:01:59.95,Default,,0,0,0,,♬～
Dialogue: 0,0:01:59.95,0:02:19.97,Default,,0,0,0,,♬～
Dialogue: 0,0:02:19.97,0:02:39.99,Default,,0,0,0,,♬～
Dialogue: 0,0:02:39.99,0:02:59.94,Default,,0,0,0,,♬～
Dialogue: 0,0:02:59.94,0:03:19.53,Default,,0,0,0,,♬～
Dialogue: 0,0:03:21.96,0:03:24.30,Default,,0,0,0,,Иә Айка-чан шөп шайы
Dialogue: 0,0:03:24.30,0:03:27.30,Default,,0,0,0,,Хмм, рахмет.
Dialogue: 0,0:03:28.97,0:03:31.31,Default,,0,0,0,,Иә, Алиса да.
Dialogue: 0,0:03:31.31,0:03:33.31,Default,,0,0,0,,Рахмет
Dialogue: 0,0:03:33.31,0:03:36.31,Default,,0,0,0,,Фу Фу
Dialogue: 0,0:03:36.31,0:03:39.31,Default,,0,0,0,,Күрсін, күн жылы~
Dialogue: 0,0:03:39.31,0:03:43.02,Default,,0,0,0,,Күрсін... бұл менің денеме қатты тиді.
Dialogue: 0,0:03:46.32,0:03:48.99,Default,,0,0,0,,Әйтеуір, жаңбыр көп жауды емес пе?
Dialogue: 0,0:03:48.99,0:03:51.66,Default,,0,0,0,,Бір түнде көп жиналды.
Dialogue: 0,0:03:51.66,0:03:55.33,Default,,0,0,0,,Нео Венеция қаласы қайта дүниеге келген сияқты.
Dialogue: 0,0:03:55.33,0:03:58.33,Default,,0,0,0,,Ұятсыз жолдар жоқ!
Dialogue: 0,0:03:58.33,0:04:01.60,Default,,0,0,0,,Иә? «Е-е...» дей алмаймын.
Dialogue: 0,0:04:01.60,0:04:04.61,Default,,0,0,0,,Сәлеметсіз бе? Акари-сан?
Dialogue: 0,0:04:04.61,0:04:08.28,Default,,0,0,0,,Эй, Айка-чан, Алиса-чан
Dialogue: 0,0:04:08.28,0:04:10.95,Default,,0,0,0,,Не?
Dialogue: 0,0:04:10.95,0:04:14.95,Default,,0,0,0,,Екеуің бала кездеріңде қандай үлкен адам болғыларың келді?
Dialogue: 0,0:04:14.95,0:04:16.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:16.95,0:04:20.29,Default,,0,0,0,,Кенеттен не болды?
Dialogue: 0,0:04:20.29,0:04:24.29,Default,,0,0,0,,А, уф, ерекше ештеңе жоқ.
Dialogue: 0,0:04:24.29,0:04:28.30,Default,,0,0,0,,Мен бұл туралы көп ойламаған шығармын.
Dialogue: 0,0:04:28.30,0:04:31.30,Default,,0,0,0,,Кенже әлі бала ғой, мммм
Dialogue: 0,0:04:31.30,0:04:35.30,Default,,0,0,0,,Бірақ мистер Крибэби оқуын бітірді.
Dialogue: 0,0:04:35.30,0:04:38.64,Default,,0,0,0,,Мен де жылауық болуды бітірдім.
Dialogue: 0,0:04:38.64,0:04:40.98,Default,,0,0,0,,Егер мен мақсат қоятын болсам
Dialogue: 0,0:04:40.98,0:04:44.31,Default,,0,0,0,,Алисия сияқты талғампаз әйел.
Dialogue: 0,0:04:44.31,0:04:47.65,Default,,0,0,0,,Акира-сан маған тағы ұрысады, жарай ма?
Dialogue: 0,0:04:47.65,0:04:50.65,Default,,0,0,0,,Егер мен Undine болсам, онда мен болар едім.
Dialogue: 0,0:04:50.65,0:04:53.66,Default,,0,0,0,,Өйткені, Алисия мен сүйетін адам.
Dialogue: 0,0:04:53.66,0:04:55.99,Default,,0,0,0,,Шешім? Бұл шешілді
Dialogue: 0,0:04:55.99,0:04:58.66,Default,,0,0,0,,Акари-сенпай ше?
Dialogue: 0,0:04:58.66,0:05:01.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:01.93,0:05:04.27,Default,,0,0,0,,Сонда мен Алисия сияқтымын...
Dialogue: 0,0:05:04.27,0:05:07.27,Default,,0,0,0,,Көшіруге болмайды! Иә~
Dialogue: 0,0:05:07.27,0:05:11.27,Default,,0,0,0,,Енді Алисияны сынама.
Dialogue: 0,0:05:11.27,0:05:15.61,Default,,0,0,0,,Бұл деңгейге жету үшін белгілі бір күш пен табандылық қажет.
Dialogue: 0,0:05:15.61,0:05:17.95,Default,,0,0,0,,Түсіндің бе? Ішек, ішек
Dialogue: 0,0:05:17.95,0:05:21.28,Default,,0,0,0,,Акариде ондай батылдық жоқ!
Dialogue: 0,0:05:21.28,0:05:25.29,Default,,0,0,0,,Сен басқа нәрсе ойлап тұрсың, Нунана.
Dialogue: 0,0:05:28.29,0:05:31.96,Default,,0,0,0,,Сәлем Айка-чан, Няё
Dialogue: 0,0:05:31.96,0:05:37.63,Default,,0,0,0,,Алисия қандай ересек адам болғысы келді?
Dialogue: 0,0:05:37.63,0:05:55.98,Default,,0,0,0,,♬～
Dialogue: 0,0:05:55.98,0:06:00.59,Default,,0,0,0,,<Күрсінді... Сіз сымбатты ересек адам екенсіз.>
Dialogue: 0,0:06:03.59,0:06:05.59,Default,,0,0,0,,Ах
Dialogue: 0,0:06:05.59,0:06:08.60,Default,,0,0,0,,Серуендеуге барайық ба, Акари-чан?
Dialogue: 0,0:06:08.60,0:06:10.60,Default,,0,0,0,,Хахи...
Dialogue: 0,0:06:10.60,0:06:14.60,Default,,0,0,0,,Егер бұл көп жиналса, тұтынушылар келмес еді.
Dialogue: 0,0:06:14.60,0:06:16.61,Default,,0,0,0,,Пупуиню!
Dialogue: 0,0:06:16.61,0:06:20.01,Default,,0,0,0,,Бүгінгі сабақты аяқтаймыз Иә.
Dialogue: 0,0:06:23.95,0:06:27.95,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:06:27.95,0:06:32.95,Default,,0,0,0,,Тағы да аздап салқындап барады.
Dialogue: 0,0:06:32.95,0:06:35.62,Default,,0,0,0,,Қалай? Ах~
Dialogue: 0,0:06:35.62,0:06:38.63,Default,,0,0,0,,Жылы~
Dialogue: 0,0:06:38.63,0:06:41.30,Default,,0,0,0,,Әй, хехехе
Dialogue: 0,0:06:41.30,0:06:43.97,Default,,0,0,0,,Каир Оны Акари-чанға беріңіз
Dialogue: 0,0:06:43.97,0:06:46.30,Default,,0,0,0,,Рахмет
Dialogue: 0,0:06:46.30,0:06:59.31,Default,,0,0,0,,♬～
Dialogue: 0,0:06:59.31,0:07:01.25,Default,,0,0,0,,Иә? Әй
Dialogue: 0,0:07:01.25,0:07:04.25,Default,,0,0,0,,Қарашы, Акари-чан, не болды?
Dialogue: 0,0:07:04.25,0:07:08.26,Default,,0,0,0,,Қараңызшы, бұл жолды әлі ешкім басып алған жоқ.
Dialogue: 0,0:07:08.26,0:07:11.59,Default,,0,0,0,,Бұл рас (Президент Ария) Пупуиню!
Dialogue: 0,0:07:11.59,0:07:15.00,Default,,0,0,0,,Уау, бірінші бол.
Dialogue: 0,0:07:16.26,0:07:19.27,Default,,0,0,0,,Хэхехе (Президент Ария) Пупуиню~!
Dialogue: 0,0:07:19.27,0:07:22.57,Default,,0,0,0,,(Алисия мен президент Арияның көңілді дауыстары)
Dialogue: 0,0:07:26.27,0:07:28.94,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:07:28.94,0:07:31.25,Default,,0,0,0,,Міне!
Dialogue: 0,0:07:35.28,0:07:38.62,Default,,0,0,0,,Алисия, иә?
Dialogue: 0,0:07:38.62,0:07:40.96,Default,,0,0,0,,Алисия бала кезінде
Dialogue: 0,0:07:40.96,0:07:43.63,Default,,0,0,0,,Сіз қандай ересек адам болғыңыз келді?
Dialogue: 0,0:07:43.63,0:07:45.63,Default,,0,0,0,,Ммм
Dialogue: 0,0:07:47.63,0:07:49.63,Default,,0,0,0,,А…?
Dialogue: 0,0:07:52.97,0:07:54.97,Default,,0,0,0,,Пуи?
Dialogue: 0,0:07:58.64,0:08:00.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:02.58,0:08:05.58,Default,,0,0,0,,Алисия-сан... (Президент Ария) Пупуй!
Dialogue: 0,0:08:07.25,0:08:10.92,Default,,0,0,0,,Мен саған көмектесемін, рахмет
Dialogue: 0,0:08:10.92,0:08:14.92,Default,,0,0,0,,Пуйпуи Пуича Пуйпуи Пуипуй...
Dialogue: 0,0:08:14.92,0:08:18.59,Default,,0,0,0,,Пупуй Пуи Пуинюи~!
Dialogue: 0,0:08:18.59,0:08:25.60,Default,,0,0,0,,♬～
Dialogue: 0,0:08:25.60,0:08:29.60,Default,,0,0,0,,Ол әлдеқайда үлкейді, солай ма?
Dialogue: 0,0:08:29.60,0:08:31.61,Default,,0,0,0,,О? Ах...
Dialogue: 0,0:08:31.61,0:08:35.94,Default,,0,0,0,,Бұл үлкен. Мен де саған көмектесемін.
Dialogue: 0,0:08:35.94,0:08:39.28,Default,,0,0,0,,Рахмет (шебер) Жоқ, жоқ.
Dialogue: 0,0:08:39.28,0:08:49.29,Default,,0,0,0,,♬～
Dialogue: 0,0:08:49.29,0:08:52.96,Default,,0,0,0,,А... Осыншама үлкен болса жақсы болар еді.
Dialogue: 0,0:08:52.96,0:08:54.96,Default,,0,0,0,,Олай болса
Dialogue: 0,0:08:54.96,0:08:58.30,Default,,0,0,0,,Рахмет (Шебер) Жоқ, жоқ.
Dialogue: 0,0:08:58.30,0:09:01.60,Default,,0,0,0,,Бұл көңілді көрінді, солай ма?
Dialogue: 0,0:09:02.90,0:09:05.57,Default,,0,0,0,,Мм... солай
Dialogue: 0,0:09:05.57,0:09:08.91,Default,,0,0,0,,Алисия қандай ересек адам болғысы келді?
Dialogue: 0,0:09:08.91,0:09:10.91,Default,,0,0,0,,Хехе
Dialogue: 0,0:09:12.91,0:09:14.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:14.92,0:09:26.59,Default,,0,0,0,,♬～
Dialogue: 0,0:09:26.59,0:09:31.93,Default,,0,0,0,,Жақсы! Кешіріңіз, бұл қарлы...
Dialogue: 0,0:09:31.93,0:09:33.94,Default,,0,0,0,,Иә? (Президент Ария) Пуи?
Dialogue: 0,0:09:33.94,0:09:37.24,Default,,0,0,0,,Мен де айналдыра аламын ба?
Dialogue: 0,0:09:38.27,0:09:43.61,Default,,0,0,0,,Уау, мен бірінші рет осындай үлкен қарды домалатып отырмын.
Dialogue: 0,0:09:43.61,0:09:46.28,Default,,0,0,0,,Негізі мен де.
Dialogue: 0,0:09:46.28,0:09:50.29,Default,,0,0,0,,Иа, көп рахмет. Бұл өте қызық болды.
Dialogue: 0,0:09:50.29,0:09:54.29,Default,,0,0,0,,Хахи Сізге көп рахмет
Dialogue: 0,0:09:54.29,0:09:57.63,Default,,0,0,0,,Кездескенше (Президент Ария) Пуиню~
Dialogue: 0,0:09:57.63,0:10:00.96,Default,,0,0,0,,Пуиню Пуйпинью!
Dialogue: 0,0:10:00.96,0:10:08.30,Default,,0,0,0,,♬～
Dialogue: 0,0:10:08.30,0:10:10.31,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:11.64,0:10:14.31,Default,,0,0,0,,Аа...!
Dialogue: 0,0:10:14.31,0:10:19.98,Default,,0,0,0,,Пуйпуиню Пуйпуиню Пуйпуиню~
Dialogue: 0,0:10:19.98,0:10:24.32,Default,,0,0,0,,Еңіс... тік... Иә.
Dialogue: 0,0:10:24.32,0:10:27.99,Default,,0,0,0,,Сіз? Аа, кешіріңіз
Dialogue: 0,0:10:27.99,0:10:30.99,Default,,0,0,0,,Сен, қатты итер. (Күйеуі) Түсіндім.
Dialogue: 0,0:10:30.99,0:10:33.33,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:10:33.33,0:10:37.00,Default,,0,0,0,,Се-жоқ... (әйелі) Ия!
Dialogue: 0,0:10:37.00,0:10:45.34,Default,,0,0,0,,♬～
Dialogue: 0,0:10:45.34,0:10:49.34,Default,,0,0,0,,Пуи Пуинью Пуи Пуиню
Dialogue: 0,0:10:49.34,0:10:53.68,Default,,0,0,0,,Пуи Пуиню Пуи Пуиню
Dialogue: 0,0:10:53.68,0:10:57.69,Default,,0,0,0,,Пуи Пуинью Пуи Пуиню
Dialogue: 0,0:10:57.69,0:11:01.29,Default,,0,0,0,,Пуи Пуи... Пуи? Пуи?
Dialogue: 0,0:11:01.29,0:11:05.63,Default,,0,0,0,,Пуипуи Пуипуи Пуипу Пуипу Пуипу...!
Dialogue: 0,0:11:05.63,0:11:07.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:07.96,0:11:11.97,Default,,0,0,0,,Пупуй Пупуй Пуй Пуиню...!
Dialogue: 0,0:11:11.97,0:11:14.57,Default,,0,0,0,,Президент Ария!
Dialogue: 0,0:11:18.64,0:11:20.98,Default,,0,0,0,,Жаза...
Dialogue: 0,0:11:20.98,0:11:25.31,Default,,0,0,0,,Президент Ария! Жарайды? Ария президенті
Dialogue: 0,0:11:25.31,0:11:27.32,Default,,0,0,0,,Пу... Пуинюи...
Dialogue: 0,0:11:27.32,0:11:30.99,Default,,0,0,0,,О, сенің тірі болғаныңа қуаныштымын (әйелі).
Dialogue: 0,0:11:42.96,0:11:47.97,Default,,0,0,0,,(қоңырау)
Dialogue: 0,0:11:47.97,0:12:07.59,Default,,0,0,0,,♬～
Dialogue: 0,0:12:07.59,0:12:09.59,Default,,0,0,0,,♬～
Dialogue: 0,0:12:09.59,0:12:12.59,Default,,0,0,0,,Хахахаха, бұл керемет.
Dialogue: 0,0:12:12.59,0:12:15.60,Default,,0,0,0,,Қайда көрсетсең де, ұялмайсың.
Dialogue: 0,0:12:15.60,0:12:18.93,Default,,0,0,0,,Хе-хе, рақмет
Dialogue: 0,0:12:18.93,0:12:33.28,Default,,0,0,0,,♬～
Dialogue: 0,0:12:33.28,0:12:35.28,Default,,0,0,0,,Pupupui?
Dialogue: 0,0:12:35.28,0:12:37.62,Default,,0,0,0,,Хэхе~
Dialogue: 0,0:12:37.62,0:12:40.02,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:12:41.62,0:12:44.33,Default,,0,0,0,,Бұл тұйыққа тіреледі.
Dialogue: 0,0:12:47.30,0:12:50.90,Default,,0,0,0,,Оған көмектесу мүмкін емес. Біз қайтеміз?
Dialogue: 0,0:12:50.90,0:12:55.24,Default,,0,0,0,,Иә (Акане) Уау, бұл керемет!
Dialogue: 0,0:12:55.24,0:12:58.24,Default,,0,0,0,,Үлкен... хахи
Dialogue: 0,0:12:58.24,0:13:00.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:00.58,0:13:03.24,Default,,0,0,0,,А, бұл рас.
Dialogue: 0,0:13:03.24,0:13:05.25,Default,,0,0,0,,О, жақсы (Эннидің анасы) Бұл не?
Dialogue: 0,0:13:05.25,0:13:07.92,Default,,0,0,0,,Кешіріңіз, өте шулы.
Dialogue: 0,0:13:07.92,0:13:11.59,Default,,0,0,0,,Мен қазір көшіп жатырмын, кешіріңіз.
Dialogue: 0,0:13:11.59,0:13:15.59,Default,,0,0,0,,Ой, жарайды, жарайды, оны сонда қалдыр.
Dialogue: 0,0:13:15.59,0:13:19.59,Default,,0,0,0,,Мен мұндайды бұрын-соңды көрген емеспін! (Ақанның анасы) Бұл керемет.
Dialogue: 0,0:13:19.59,0:13:23.26,Default,,0,0,0,,Бұл үлкен мәселе...
Dialogue: 0,0:13:23.26,0:13:25.93,Default,,0,0,0,,Мұны екеуің бірге жасадыңдар ма?
Dialogue: 0,0:13:25.93,0:13:29.94,Default,,0,0,0,,Аа, жоқ, мен бірнеше адамнан көмек алдым.
Dialogue: 0,0:13:29.94,0:13:33.94,Default,,0,0,0,,көремін. Олай болса, саған да көмектессек қайтеді?
Dialogue: 0,0:13:33.94,0:13:37.95,Default,,0,0,0,,О, бұл жақсы. Сіз жақсы нәрсе айтасыз.
Dialogue: 0,0:13:37.95,0:13:41.55,Default,,0,0,0,,Мен де жасаймын! Уау...
Dialogue: 0,0:13:42.95,0:13:47.29,Default,,0,0,0,,Ундине-сан, сен шаршадың. Сізге үзіліс жасау керек.
Dialogue: 0,0:13:47.29,0:13:49.62,Default,,0,0,0,,Жылы нәрсе ішіңіз.
Dialogue: 0,0:13:49.62,0:13:52.33,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:55.23,0:13:58.57,Default,,0,0,0,,Уау, бұл рас, бұл өте үлкен!
Dialogue: 0,0:13:58.57,0:14:00.57,Default,,0,0,0,,Бұл рас, бұл өте үлкен!
Dialogue: 0,0:14:00.57,0:14:02.57,Default,,0,0,0,,(Ағайындылардың күлкісі)
Dialogue: 0,0:14:07.58,0:14:12.25,Default,,0,0,0,,Иә, жылы. Рақмет сізге.
Dialogue: 0,0:14:12.25,0:14:16.92,Default,,0,0,0,,Уау, бұл таза ақ. Бұл ақ какао.
Dialogue: 0,0:14:16.92,0:14:19.92,Default,,0,0,0,,Ол ақ шоколадтан жасалған.
Dialogue: 0,0:14:19.92,0:14:24.26,Default,,0,0,0,,Уау, өте жылы! Менің де қолым суып кеткен болуы керек.
Dialogue: 0,0:14:24.26,0:14:27.26,Default,,0,0,0,,Иә, кешіріңіз.
Dialogue: 0,0:14:27.26,0:14:29.93,Default,,0,0,0,,Мен қазір панини пісіріп жатырмын.
Dialogue: 0,0:14:29.93,0:14:32.27,Default,,0,0,0,,Өз тоқашыңызды жеңіз.
Dialogue: 0,0:14:32.27,0:14:35.27,Default,,0,0,0,,Жарайды, мен де көмектесемін деп ойлаймын.
Dialogue: 0,0:14:35.27,0:14:38.61,Default,,0,0,0,,Қатты қобалжып, арқаңызды ауыртпаңыз.
Dialogue: 0,0:14:38.61,0:14:42.28,Default,,0,0,0,,Не? Көңіл көтермей мұны істеуге бола ма?
Dialogue: 0,0:14:42.28,0:14:46.28,Default,,0,0,0,,Одан да үлкейтейік (Ағай) Иә!
Dialogue: 0,0:14:46.28,0:14:48.28,Default,,0,0,0,,Ей, тағы біреуін жасайық.
Dialogue: 0,0:14:48.28,0:14:50.99,Default,,0,0,0,,О~ 3-деңгей? Бұл тамаша.
Dialogue: 0,0:14:51.89,0:14:55.89,Default,,0,0,0,,Иә? Undine және бұрынғыдан басқалар
Dialogue: 0,0:14:55.89,0:14:58.23,Default,,0,0,0,,Ах... (Президент Ария) Пуи?
Dialogue: 0,0:14:58.23,0:15:00.23,Default,,0,0,0,,Ағай
Dialogue: 0,0:15:00.23,0:15:03.93,Default,,0,0,0,,Қош келдіңіз, әке (шебер).
Dialogue: 0,0:15:05.23,0:15:08.24,Default,,0,0,0,,Ол айтарлықтай өсті.
Dialogue: 0,0:15:08.24,0:15:10.91,Default,,0,0,0,,Біз де көмектесіп жатырмыз.
Dialogue: 0,0:15:10.91,0:15:14.91,Default,,0,0,0,,Түсіндім, жарайды, әкеме тағы көмектесейік.
Dialogue: 0,0:15:14.91,0:15:18.25,Default,,0,0,0,,Әке... (Энни) Мен мұны істедім!
Dialogue: 0,0:15:18.25,0:15:20.92,Default,,0,0,0,,Мен де саған көмектесемін.
Dialogue: 0,0:15:20.92,0:15:22.92,Default,,0,0,0,,Сора! Қолыңнан келгеннің бәрін жаса
Dialogue: 0,0:15:22.92,0:15:26.92,Default,,0,0,0,,Бұл бастапқыда Ундинге көмектесу үшін болды.
Dialogue: 0,0:15:26.92,0:15:30.59,Default,,0,0,0,,Аа, дұрыс (Акане) Уфуфу
Dialogue: 0,0:15:30.59,0:15:33.26,Default,,0,0,0,,Undine-san қызықты.
Dialogue: 0,0:15:33.26,0:15:38.27,Default,,0,0,0,,Ол біткен соң, мен оны осымен безендіремін. (Энни) Әшекейлеңдер, безендіріңдер!
Dialogue: 0,0:15:38.27,0:15:41.27,Default,,0,0,0,,Аа, дұрыс, жақсысы бар.
Dialogue: 0,0:15:41.27,0:15:44.61,Default,,0,0,0,,Мен әкелемін. Иә.
Dialogue: 0,0:15:44.61,0:15:47.61,Default,,0,0,0,,Се-жоқ... Дон
Dialogue: 0,0:15:47.61,0:15:50.01,Default,,0,0,0,,Пуиню~!
Dialogue: 0,0:15:51.55,0:15:53.55,Default,,0,0,0,,Өтінемін (Ақане) Иә.
Dialogue: 0,0:15:53.55,0:15:56.22,Default,,0,0,0,,Жарайсыңдар...
Dialogue: 0,0:15:56.22,0:15:58.22,Default,,0,0,0,,Хой
Dialogue: 0,0:15:58.22,0:16:18.24,Default,,0,0,0,,♬～
Dialogue: 0,0:16:18.24,0:16:21.58,Default,,0,0,0,,♬～
Dialogue: 0,0:16:21.58,0:16:23.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:23.58,0:16:28.58,Default,,0,0,0,,(Жолаушылар шуы)
Dialogue: 0,0:16:29.58,0:16:33.59,Default,,0,0,0,,Пуи! Pui Pui Жаңа!
Dialogue: 0,0:16:37.93,0:16:39.93,Default,,0,0,0,,Ухуху…
Dialogue: 0,0:16:45.93,0:16:48.27,Default,,0,0,0,,Жақсы (Энни) Жақсы!
Dialogue: 0,0:16:48.27,0:16:51.21,Default,,0,0,0,,Аа, керемет жұмыс, жақсы
Dialogue: 0,0:16:51.21,0:16:54.88,Default,,0,0,0,,Жақсы, жақсы (Акане) Хехе, сен қалай ойлайсың?
Dialogue: 0,0:16:54.88,0:16:58.88,Default,,0,0,0,,Иә, өте жақсы хехе
Dialogue: 0,0:17:03.22,0:17:12.89,Default,,0,0,0,,♬～
Dialogue: 0,0:17:12.89,0:17:15.23,Default,,0,0,0,,Қош бол!
Dialogue: 0,0:17:15.23,0:17:17.90,Default,,0,0,0,,Қайта келіңіз!
Dialogue: 0,0:17:17.90,0:17:25.91,Default,,0,0,0,,♬～
Dialogue: 0,0:17:25.91,0:17:30.91,Default,,0,0,0,,Хехе, қызық болды, иә.
Dialogue: 0,0:17:30.91,0:17:36.58,Default,,0,0,0,,Жаңа ғана қар домалап жүрсем де, мен әртүрлі адамдарды кездестірдім.
Dialogue: 0,0:17:36.58,0:17:40.99,Default,,0,0,0,,Мен үшін өте жылы болды.
Dialogue: 0,0:17:41.92,0:17:46.93,Default,,0,0,0,,Маған бұл қала одан сайын ұнай бастады.
Dialogue: 0,0:17:49.26,0:17:52.20,Default,,0,0,0,,Бала кезімде
Dialogue: 0,0:17:52.20,0:17:54.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:58.21,0:18:03.21,Default,,0,0,0,,Қар жауған кезде біз үнемі қардан домалақ жасап, олармен ойнайтынбыз.
Dialogue: 0,0:18:04.88,0:18:07.55,Default,,0,0,0,,Қарды домалатқанда
Dialogue: 0,0:18:07.55,0:18:10.89,Default,,0,0,0,,Біреу әрқашан ойламаған жерден пайда болады
Dialogue: 0,0:18:10.89,0:18:14.22,Default,,0,0,0,,Біз бірге өсеміз
Dialogue: 0,0:18:14.22,0:18:19.23,Default,,0,0,0,,Соңында барлығы риза болып үйіне қайтады.
Dialogue: 0,0:18:22.56,0:18:26.27,Default,,0,0,0,,Сол кезде мен кенет ойға қалдым
Dialogue: 0,0:18:28.24,0:18:32.54,Default,,0,0,0,,Мен осылай өскім келеді...
Dialogue: 0,0:18:35.91,0:18:37.91,Default,,0,0,0,,Хехе
Dialogue: 0,0:18:40.25,0:18:44.59,Default,,0,0,0,,＜Сол күлімсіреу – су перісінің күлкісі➡
Dialogue: 0,0:18:44.59,0:18:49.59,Default,,0,0,0,,Бір сәт уақытты жоғалтып, оған сіңіп кеттім>
Dialogue: 0,0:18:50.86,0:18:55.16,Default,,0,0,0,,<Алисия - керемет ересек адам>
Dialogue: 0,0:18:57.87,0:19:02.17,Default,,0,0,0,,Рахмет, Алисия.
Dialogue: 0,0:19:03.54,0:19:06.54,Default,,0,0,0,,Не? Кенет аа
Dialogue: 0,0:19:06.54,0:19:12.55,Default,,0,0,0,,Ал, мен не айтайын...
Dialogue: 0,0:19:12.55,0:19:16.22,Default,,0,0,0,,Менімен кездесу үшін
Dialogue: 0,0:19:16.22,0:19:20.22,Default,,0,0,0,,Хехе, қош келдіңіз.
Dialogue: 0,0:19:20.22,0:19:22.56,Default,,0,0,0,,Пуинью
Dialogue: 0,0:19:22.56,0:19:28.23,Default,,0,0,0,,<Осы планетада бізге таптырмас кездесулер береді➡
Dialogue: 0,0:19:28.23,0:19:32.90,Default,,0,0,0,,Сізге мейіріммен қарайтын бұл қалада➡
Dialogue: 0,0:19:32.90,0:19:35.20,Default,,0,0,0,,Рахмет＞
Dialogue: 0,0:19:36.57,0:19:39.57,Default,,0,0,0,,<Акари-сан, мен өскенде➡
Dialogue: 0,0:19:39.57,0:19:42.58,Default,,0,0,0,,Мен міндетті түрде Нео Венецияға барғым келеді＞
Dialogue: 0,0:19:42.58,0:19:46.91,Default,,0,0,0,,<Мен сол уақытта Акари-санның сонда болатынына сенімдімін...>
Dialogue: 0,0:19:46.91,0:19:49.25,Default,,0,0,0,,Қала аппақ, әдемі
Dialogue: 0,0:19:49.25,0:19:51.92,Default,,0,0,0,,Дәл Алисия сияқты.
Dialogue: 0,0:19:51.92,0:19:54.92,Default,,0,0,0,,Хмм, бүгін де Aqua тыныш.
Dialogue: 0,0:19:54.92,0:19:57.53,Default,,0,0,0,,Маған ризасың ба, Момико?
Dialogue: 0,0:19:58.59,0:20:00.59,Default,,0,0,0,,Ата-апа, дәмді күріш торт
Dialogue: 0,0:20:00.59,0:20:02.60,Default,,0,0,0,,Мен оны алдым.
Dialogue: 0,0:20:03.60,0:20:07.27,Default,,0,0,0,,Ал мен бүгін де аспанда жүзуді жалғастырамын~
Dialogue: 0,0:20:07.27,0:20:10.27,Default,,0,0,0,,Бұл дүниеде жеткізуге болатын нәрсе бар болғанша
Dialogue: 0,0:20:10.27,0:20:30.29,Default,,0,0,0,,♬～
Dialogue: 0,0:20:30.29,0:20:36.63,Default,,0,0,0,,♬～
Dialogue: 0,0:20:36.63,0:20:44.97,Default,,0,0,0,,♬～
Dialogue: 0,0:20:44.97,0:21:04.93,Default,,0,0,0,,♬～
Dialogue: 0,0:21:04.93,0:21:24.95,Default,,0,0,0,,♬～
Dialogue: 0,0:21:24.95,0:21:29.28,Default,,0,0,0,,♬～
Dialogue: 0,0:21:29.28,0:21:31.95,Default,,0,0,0,,Эй Айка, сен пицца алғың келе ме?
Dialogue: 0,0:21:31.95,0:21:34.29,Default,,0,0,0,,Не? Бұл Акира-сан үшін бе?
Dialogue: 0,0:21:34.29,0:21:36.62,Default,,0,0,0,,Иә? Сіз мені емдей аласыз.
Dialogue: 0,0:21:36.62,0:21:40.29,Default,,0,0,0,,Шынымен бе? Алақай! Мен барамын! Мен барамын!
Dialogue: 0,0:21:40.29,0:21:43.63,Default,,0,0,0,,Дегенмен, мен оны бір күні екі есеге қайтарамын.
Dialogue: 0,0:21:43.63,0:21:47.64,Default,,0,0,0,,Сіз Прима болған кезде...
Dialogue: 0,0:21:47.64,0:21:51.24,Default,,0,0,0,,Ах... иә.
Dialogue: 0,0:21:51.24,0:21:55.58,Default,,0,0,0,,Алиса, күн жылынғанда, пикникке шығайық.
Dialogue: 0,0:21:55.58,0:21:59.58,Default,,0,0,0,,А, жарайды. Қайда бара жатырсың?
Dialogue: 0,0:21:59.58,0:22:02.25,Default,,0,0,0,,Хехе, құпия
Dialogue: 0,0:22:02.25,0:22:06.59,Default,,0,0,0,,Бірақ бұл өте жақсы жер.
Dialogue: 0,0:22:06.59,0:22:10.29,Default,,0,0,0,,Күлсін... (Ал, Президент) Жарайды.
Dialogue: 0,0:22:12.59,0:22:32.61,Default,,0,0,0,,♬～
Dialogue: 0,0:22:32.61,0:22:40.62,Default,,0,0,0,,♬～
Dialogue: 0,0:22:40.62,0:22:44.96,Default,,0,0,0,,Сонымен, Акари-чан қандай ересек адам болғысы келеді?
Dialogue: 0,0:22:44.96,0:22:49.90,Default,,0,0,0,,Мен кішкентай кезімде пері болғым келді.
Dialogue: 0,0:22:49.90,0:22:52.23,Default,,0,0,0,,Ертегі? иә
Dialogue: 0,0:22:52.23,0:22:56.90,Default,,0,0,0,,Әр жерде ұшып, барлығын қуанту
Dialogue: 0,0:22:56.90,0:22:59.24,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:22:59.24,0:23:02.91,Default,,0,0,0,,Бұл мүмкін емес пе? Хе?
Dialogue: 0,0:23:02.91,0:23:07.25,Default,,0,0,0,,Жақында Акари-чан да періге айналады
Dialogue: 0,0:23:07.25,0:23:09.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:09.25,0:23:29.27,Default,,0,0,0,,♬～
Dialogue: 0,0:23:29.27,0:23:34.98,Default,,0,0,0,,♬～
