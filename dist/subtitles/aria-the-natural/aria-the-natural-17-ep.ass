Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.96,0:00:04.63,Default,,0,0,0,,♬～
Dialogue: 0,0:00:04.63,0:00:07.97,Default,,0,0,0,,<Ай-чан, түн түскенде➡
Dialogue: 0,0:00:07.97,0:00:11.64,Default,,0,0,0,,Біз гондоламен шынымен қоштасамыз.＞
Dialogue: 0,0:00:11.64,0:00:14.64,Default,,0,0,0,,＜Менің басыма түрлі ойлар келеді➡
Dialogue: 0,0:00:14.64,0:00:17.65,Default,,0,0,0,,Сөзбен айтып жеткізе алмаймын＞
Dialogue: 0,0:00:20.32,0:00:22.65,Default,,0,0,0,,Акари-чан иә
Dialogue: 0,0:00:22.65,0:00:26.99,Default,,0,0,0,,Бүгін кешке гондолада кешкі ас ішеміз бе?
Dialogue: 0,0:00:26.99,0:00:28.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:30.33,0:00:33.66,Default,,0,0,0,,Иә (Президент Ария) Пуйпуиню~
Dialogue: 0,0:00:33.66,0:00:53.68,Default,,0,0,0,,♬～
Dialogue: 0,0:00:53.68,0:01:13.64,Default,,0,0,0,,♬～
Dialogue: 0,0:01:13.64,0:01:33.66,Default,,0,0,0,,♬～
Dialogue: 0,0:01:33.66,0:01:53.68,Default,,0,0,0,,♬～
Dialogue: 0,0:01:53.68,0:02:13.63,Default,,0,0,0,,♬～
Dialogue: 0,0:02:13.63,0:02:25.04,Default,,0,0,0,,♬～
Dialogue: 0,0:02:30.98,0:02:34.32,Default,,0,0,0,,(Президент Арияның тамақ ішіп отырған дыбысы)
Dialogue: 0,0:02:34.32,0:02:38.65,Default,,0,0,0,,Гондола мырзамен қоштасу кеші.
Dialogue: 0,0:02:38.65,0:02:43.33,Default,,0,0,0,,Бұл Гондола мырзаға алғыс білдірген кешкі ас емес пе?
Dialogue: 0,0:02:43.33,0:02:45.66,Default,,0,0,0,,Иә
Dialogue: 0,0:02:45.66,0:02:47.66,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:02:49.33,0:02:51.67,Default,,0,0,0,,Қанша алғыс айтсам да,
Dialogue: 0,0:02:51.67,0:02:54.00,Default,,0,0,0,,Кешір десем де
Dialogue: 0,0:02:54.00,0:02:56.34,Default,,0,0,0,,жеткіліксіз
Dialogue: 0,0:02:56.34,0:02:59.34,Default,,0,0,0,,Мен де...
Dialogue: 0,0:03:01.94,0:03:06.95,Default,,0,0,0,,Бұл гондола мен алғаш рет есуім болды.
Dialogue: 0,0:03:06.95,0:03:08.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:08.95,0:03:18.96,Default,,0,0,0,,♬～
Dialogue: 0,0:03:18.96,0:03:22.63,Default,,0,0,0,,《Алисия, бұл сен қолданатын гондола.》
Dialogue: 0,0:03:22.63,0:03:24.97,Default,,0,0,0,,《Уау...! 》
Dialogue: 0,0:03:24.97,0:03:27.97,Default,,0,0,0,,《Көп рахмет, Гондола мырза》
Dialogue: 0,0:03:27.97,0:03:29.97,Default,,0,0,0,,《Пуй Пуиню~》
Dialogue: 0,0:03:29.97,0:03:32.31,Default,,0,0,0,,《Олай болса жаттығуға барайық.》
Dialogue: 0,0:03:32.31,0:03:34.31,Default,,0,0,0,,《Иә! 》
Dialogue: 0,0:03:34.31,0:03:37.98,Default,,0,0,0,,《Пуи пуи пуи пуи➡
Dialogue: 0,0:03:37.98,0:03:41.65,Default,,0,0,0,,Пуи Пуи Пуи Ча~
Dialogue: 0,0:03:41.65,0:03:46.32,Default,,0,0,0,,《Уфуфу, бұл суда сырғанау сияқты.》
Dialogue: 0,0:03:46.32,0:03:48.32,Default,,0,0,0,,《Аа…》
Dialogue: 0,0:03:50.99,0:03:56.00,Default,,0,0,0,,《(Қоңырау)》
Dialogue: 0,0:04:05.27,0:04:07.28,Default,,0,0,0,,《А...! 》
Dialogue: 0,0:04:08.94,0:04:10.95,Default,,0,0,0,,《Қой! 》
Dialogue: 0,0:04:10.95,0:04:13.55,Default,,0,0,0,,《(тырналған дыбыс)》
Dialogue: 0,0:04:15.95,0:04:21.62,Default,,0,0,0,,♬～
Dialogue: 0,0:04:21.62,0:04:25.63,Default,,0,0,0,,Бұл тыртық менің кесірімнен болды.
Dialogue: 0,0:04:28.30,0:04:30.63,Default,,0,0,0,,Алисия ше?
Dialogue: 0,0:04:30.63,0:04:35.30,Default,,0,0,0,,Мен жаңа болған кезімде мен жиі заттармен соқтығысатынмын.
Dialogue: 0,0:04:35.30,0:04:38.97,Default,,0,0,0,,Бұл гондола Алисия жұп болған кезде де қолданылған.
Dialogue: 0,0:04:38.97,0:04:41.58,Default,,0,0,0,,Сіз мұны білесіз.
Dialogue: 0,0:04:42.64,0:04:44.65,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:04:46.31,0:04:51.32,Default,,0,0,0,,《Мм… Мм…》
Dialogue: 0,0:04:51.32,0:04:55.66,Default,,0,0,0,,《Мм... Хэхе! 》
Dialogue: 0,0:04:55.66,0:04:59.06,Default,,0,0,0,,《Хахи~ Ләззат алыңыз~! 》
Dialogue: 0,0:05:03.60,0:05:05.60,Default,,0,0,0,,《Уау~》
Dialogue: 0,0:05:06.60,0:05:08.94,Default,,0,0,0,,《Кемпірқосақ~》
Dialogue: 0,0:05:08.94,0:05:19.95,Default,,0,0,0,,♬～
Dialogue: 0,0:05:19.95,0:05:25.29,Default,,0,0,0,,《Иә, балауызды біркелкі және мұқият жағыңыз.》
Dialogue: 0,0:05:25.29,0:05:27.29,Default,,0,0,0,,《Иә》
Dialogue: 0,0:05:29.29,0:05:34.30,Default,,0,0,0,,《Хехе, жылтыр болады》 (Президент Ария) 《Пуйпуи~》
Dialogue: 0,0:05:38.63,0:05:41.30,Default,,0,0,0,,Акари-чан қолданатын балауыз
Dialogue: 0,0:05:41.30,0:05:43.31,Default,,0,0,0,,Әженің арнайы балауызы
Dialogue: 0,0:05:43.31,0:05:46.98,Default,,0,0,0,,Мен формуланы сәл ғана өзгерттім.
Dialogue: 0,0:05:46.98,0:05:49.98,Default,,0,0,0,,Дегенмен, 11 жасыңдағы кезіңмен салыстырғанда бетің біраз өзгерген болар
Dialogue: 0,0:05:49.98,0:05:54.98,Default,,0,0,0,,Мен білмейтін жерлерде тарих көп.
Dialogue: 0,0:05:55.98,0:06:01.59,Default,,0,0,0,,Мен де осы гондоламен қоштасуға мұңаямын.
Dialogue: 0,0:06:03.26,0:06:05.56,Default,,0,0,0,,Иә...
Dialogue: 0,0:06:06.93,0:06:09.93,Default,,0,0,0,,Сәлем, Акари!
Dialogue: 0,0:06:09.93,0:06:11.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:11.93,0:06:15.27,Default,,0,0,0,,Күткеніңізге рахмет, Алисия.
Dialogue: 0,0:06:15.27,0:06:17.27,Default,,0,0,0,,Қайырлы кеш
Dialogue: 0,0:06:17.27,0:06:20.61,Default,,0,0,0,,Айка-чан Алиса-чан…
Dialogue: 0,0:06:20.61,0:06:23.28,Default,,0,0,0,,Кеш үшін барлығына рахмет
Dialogue: 0,0:06:23.28,0:06:26.28,Default,,0,0,0,,Мен сенің қатысуыңды қаладым.
Dialogue: 0,0:06:26.28,0:06:28.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:28.28,0:06:30.29,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:31.29,0:06:33.62,Default,,0,0,0,,Мені шақырғаныңызға рахмет.
Dialogue: 0,0:06:33.62,0:06:36.29,Default,,0,0,0,,Не? Не? Бұлай депрессияға түспеңіз.
Dialogue: 0,0:06:36.29,0:06:40.30,Default,,0,0,0,,Әй, бәріне рахмет, жанды болды.
Dialogue: 0,0:06:40.30,0:06:43.00,Default,,0,0,0,,Иә (Президент Ария) Пуинью
Dialogue: 0,0:06:45.63,0:06:47.97,Default,,0,0,0,,Олай болса, тост айтайық.
Dialogue: 0,0:06:47.97,0:06:51.97,Default,,0,0,0,,Акари, сіз жетекшілік етуіңіз керек. Иә.
Dialogue: 0,0:06:51.97,0:06:54.98,Default,,0,0,0,,Аа, мм... у...
Dialogue: 0,0:06:54.98,0:06:57.65,Default,,0,0,0,,Мен бұл гондоланы Жұптың күндерінен бері жүргізіп келемін.
Dialogue: 0,0:06:57.65,0:06:59.65,Default,,0,0,0,,Маған оны пайдалануға рұқсат берілді.
Dialogue: 0,0:06:59.65,0:07:02.25,Default,,0,0,0,,Соңында осы ARIA компаниясынан
Dialogue: 0,0:07:02.25,0:07:04.92,Default,,0,0,0,,Ал, мен сапарға кетемін.
Dialogue: 0,0:07:04.92,0:07:09.26,Default,,0,0,0,,Ал, есімде болса, көп нәрсе болды.
Dialogue: 0,0:07:09.26,0:07:11.26,Default,,0,0,0,,Бұл ұзақ хаха...
Dialogue: 0,0:07:11.26,0:07:13.93,Default,,0,0,0,,Мен өз естеліктерімді кейінірек айтамын.
Dialogue: 0,0:07:13.93,0:07:17.27,Default,,0,0,0,,Иә, сондықтан, Гондола мырза.
Dialogue: 0,0:07:17.27,0:07:21.27,Default,,0,0,0,,Еңбегіңіз үшін алғыс айтқыңыз келе ме? Рахмет айтқыңыз келе ме?
Dialogue: 0,0:07:21.27,0:07:23.61,Default,,0,0,0,,Сонымен... хехе
Dialogue: 0,0:07:23.61,0:07:25.94,Default,,0,0,0,,Қалыпты сөйлессек жарамайды ма?
Dialogue: 0,0:07:25.94,0:07:29.61,Default,,0,0,0,,Иә, мен өзімді жайлы сезіну дұрыс деп ойлаймын.
Dialogue: 0,0:07:29.61,0:07:32.61,Default,,0,0,0,,Дұрыс... (Акира/Айка) Иә?
Dialogue: 0,0:07:32.61,0:07:34.95,Default,,0,0,0,,Бұл тым абайсыздық емес пе?
Dialogue: 0,0:07:34.95,0:07:37.62,Default,,0,0,0,,Меніңше, бәрі жақсы...
Dialogue: 0,0:07:37.62,0:07:40.62,Default,,0,0,0,,Олай болса, ризашылықпен
Dialogue: 0,0:07:40.62,0:07:43.63,Default,,0,0,0,,Сонымен қатар, бұдан былай Гондола мырзаға.
Dialogue: 0,0:07:43.63,0:07:46.96,Default,,0,0,0,,Тағы да тамаша кездесулер болады деп үміттенемін.
Dialogue: 0,0:07:46.96,0:07:50.27,Default,,0,0,0,,Сәлеметсіз бе! (үшін) Сәлем!
Dialogue: 0,0:07:52.97,0:07:55.97,Default,,0,0,0,,Иә, фотоға қараңыз.
Dialogue: 0,0:07:55.97,0:07:58.31,Default,,0,0,0,,Иә~ Иә~
Dialogue: 0,0:07:58.31,0:08:00.91,Default,,0,0,0,,Сіз өте көп суретке түстіңіз.
Dialogue: 0,0:08:00.91,0:08:04.25,Default,,0,0,0,,Иә, Алисияға және барлығына рахмет.
Dialogue: 0,0:08:04.25,0:08:06.92,Default,,0,0,0,,Мен көптеген естеліктер қалдырдым.
Dialogue: 0,0:08:06.92,0:08:13.92,Default,,0,0,0,,♬～
Dialogue: 0,0:08:13.92,0:08:17.59,Default,,0,0,0,,Уау, Акира-чанға, Алисия-чанға қара
Dialogue: 0,0:08:17.59,0:08:21.60,Default,,0,0,0,,Біз де осылай фотоға түсірдік, солай ма?
Dialogue: 0,0:08:21.60,0:08:23.93,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:08:23.93,0:08:28.94,Default,,0,0,0,,Уууу, мен оны осында әкелдім.
Dialogue: 0,0:08:28.94,0:08:32.61,Default,,0,0,0,,Рас, ұқсас фотолар
Dialogue: 0,0:08:32.61,0:08:35.61,Default,,0,0,0,,Бұл гондолаға да қатысты.
Dialogue: 0,0:08:37.28,0:08:41.28,Default,,0,0,0,,《Алисияны Примаға көтерілуімен құттықтаймыз》
Dialogue: 0,0:08:41.28,0:08:43.28,Default,,0,0,0,,Музыканы енді ести алмай қалуым мүмкін.
Dialogue: 0,0:08:43.28,0:08:46.62,Default,,0,0,0,,《Сен күткендей, Алисия-чан》 (Президент Ария) 《Пуиню~》
Dialogue: 0,0:08:46.62,0:08:50.29,Default,,0,0,0,,《Қарғыс атсын... Мен де жақында прима боламын.》
Dialogue: 0,0:08:50.29,0:08:52.29,Default,,0,0,0,,《О, Құдайым!》
Dialogue: 0,0:08:52.29,0:08:56.30,Default,,0,0,0,,《Бұдан былай ақ гондолада жүресің》
Dialogue: 0,0:08:56.30,0:08:58.97,Default,,0,0,0,,《А...》
Dialogue: 0,0:08:58.97,0:09:00.90,Default,,0,0,0,,《Иә》
Dialogue: 0,0:09:00.90,0:09:03.24,Default,,0,0,0,,《Маған осы уақытқа дейін көмектескен гондолалармен➡
Dialogue: 0,0:09:03.24,0:09:06.57,Default,,0,0,0,,Қоштасқалы мұң екен, бірақ...》
Dialogue: 0,0:09:06.57,0:09:11.58,Default,,0,0,0,,《Иә...бізде де бұл гондола туралы естеліктер бар》
Dialogue: 0,0:09:11.58,0:09:13.58,Default,,0,0,0,,Жоқ, ол емес. Жасырынған орын. Жасырынған орын ба?
Dialogue: 0,0:09:14.58,0:09:17.59,Default,,0,0,0,,《Әй, бәріміз суретке түсеміз бе?》
Dialogue: 0,0:09:17.59,0:09:19.59,Default,,0,0,0,,《Фотосурет? 》 《Иә》
Dialogue: 0,0:09:19.59,0:09:21.59,Default,,0,0,0,,《Осы гондоламен》
Dialogue: 0,0:09:21.59,0:09:23.59,Default,,0,0,0,,《Жарайды, фотоға түсейік, фотоға түсейік! 》
Dialogue: 0,0:09:23.59,0:09:27.60,Default,,0,0,0,,《Онда мен камераны әкелемін.》
Dialogue: 0,0:09:27.60,0:09:36.94,Default,,0,0,0,,♬～
Dialogue: 0,0:09:36.94,0:09:38.94,Default,,0,0,0,,《(Ысырма дыбысы)》
Dialogue: 0,0:09:38.94,0:09:41.61,Default,,0,0,0,,《Бұл гондоланы не істеуіміз керек? 》
Dialogue: 0,0:09:41.61,0:09:45.28,Default,,0,0,0,,《Мен жаңа адамдарға нұсқау беруге сенімді болмайынша➡
Dialogue: 0,0:09:45.28,0:09:47.62,Default,,0,0,0,,Оны түсіріп, сақтаңыз.
Dialogue: 0,0:09:47.62,0:09:50.95,Default,,0,0,0,,《Мен… қысқаша қоштасу》
Dialogue: 0,0:09:50.95,0:09:55.29,Default,,0,0,0,,Бұл гондола ARIA компаниясы құрылғаннан бері бар.
Dialogue: 0,0:09:55.29,0:09:57.96,Default,,0,0,0,,Мен өмір бойы еңбек еттім
Dialogue: 0,0:09:57.96,0:10:02.26,Default,,0,0,0,,Бұл ARIA компаниясының тарихы.
Dialogue: 0,0:10:03.63,0:10:06.63,Default,,0,0,0,,Иә? Алисия
Dialogue: 0,0:10:06.63,0:10:10.31,Default,,0,0,0,,Бұл жаңадан келген адам мен болуы мүмкін бе?
Dialogue: 0,0:10:10.31,0:10:12.64,Default,,0,0,0,,Иә, иә, иә.
Dialogue: 0,0:10:12.64,0:10:14.98,Default,,0,0,0,,Тағы кім бар?
Dialogue: 0,0:10:14.98,0:10:18.65,Default,,0,0,0,,Гондола Алисиядан Акари-сенпайға кетті.
Dialogue: 0,0:10:18.65,0:10:20.65,Default,,0,0,0,,Ол мұраға қалды, солай ма?
Dialogue: 0,0:10:20.65,0:10:22.98,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:10:22.98,0:10:24.99,Default,,0,0,0,,Рахмет сізге Акари-чан
Dialogue: 0,0:10:24.99,0:10:27.66,Default,,0,0,0,,Сәлем! А, жоқ...
Dialogue: 0,0:10:27.66,0:10:31.66,Default,,0,0,0,,(үшін күледі)
Dialogue: 0,0:10:52.91,0:10:55.58,Default,,0,0,0,,Олай болса, бүгінгі кеш үшін көп рахмет.
Dialogue: 0,0:10:55.58,0:10:57.59,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:10:57.59,0:10:59.59,Default,,0,0,0,,Біз бірден жойылып кетер едік.
Dialogue: 0,0:10:59.59,0:11:02.99,Default,,0,0,0,,Жақсы адам пайдаланады деп сенемін.
Dialogue: 0,0:11:03.93,0:11:06.23,Default,,0,0,0,,Рахмет
Dialogue: 0,0:11:11.27,0:11:14.27,Default,,0,0,0,,Бір жерде тағы кездесейік.
Dialogue: 0,0:11:14.27,0:11:17.61,Default,,0,0,0,,Қош болыңыз, Гондола мырза.
Dialogue: 0,0:11:17.61,0:11:37.63,Default,,0,0,0,,♬～
Dialogue: 0,0:11:37.63,0:11:43.30,Default,,0,0,0,,♬～
Dialogue: 0,0:11:43.30,0:11:47.30,Default,,0,0,0,,Акари-чан, біз де қайтеміз?
Dialogue: 0,0:11:47.30,0:11:49.30,Default,,0,0,0,,Иә
Dialogue: 0,0:11:52.57,0:11:54.91,Default,,0,0,0,,Пуинью Пуи
Dialogue: 0,0:11:54.91,0:12:13.26,Default,,0,0,0,,♬～
Dialogue: 0,0:12:13.26,0:12:15.26,Default,,0,0,0,,Пуи
Dialogue: 0,0:12:15.26,0:12:17.27,Default,,0,0,0,,Пуиню?
Dialogue: 0,0:12:17.27,0:12:29.28,Default,,0,0,0,,♬～
Dialogue: 0,0:12:29.28,0:12:31.61,Default,,0,0,0,,Өйткені мен кедейлікте туып-өстім—
Dialogue: 0,0:12:31.61,0:12:34.28,Default,,0,0,0,,Тағы біраз
Dialogue: 0,0:12:34.28,0:12:36.99,Default,,0,0,0,,Мен сенімен қала аламын ба?
Dialogue: 0,0:12:38.95,0:12:41.29,Default,,0,0,0,,Суық тигізбе
Dialogue: 0,0:12:41.29,0:12:43.96,Default,,0,0,0,,Иә
Dialogue: 0,0:12:43.96,0:12:46.29,Default,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,0:12:46.29,0:12:48.60,Default,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,0:12:51.57,0:12:54.97,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:13:04.58,0:13:09.58,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:13:13.59,0:13:17.59,Default,,0,0,0,,Пуф... пуи... пуи?
Dialogue: 0,0:13:17.59,0:13:19.93,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:13:19.93,0:13:22.60,Default,,0,0,0,,Пуиню…
Dialogue: 0,0:13:22.60,0:13:25.00,Default,,0,0,0,,Пуинюпуи?
Dialogue: 0,0:13:32.27,0:13:34.28,Default,,0,0,0,,Пуи
Dialogue: 0,0:13:34.28,0:13:37.28,Default,,0,0,0,,Пуи Пуи Пуи...
Dialogue: 0,0:13:47.29,0:13:51.99,Default,,0,0,0,,(Төмен түсетін баспалдақтың дыбысы)
Dialogue: 0,0:13:56.56,0:13:58.57,Default,,0,0,0,,Пуи
Dialogue: 0,0:13:58.57,0:14:01.24,Default,,0,0,0,,Пуиню Пуи Пуиню
Dialogue: 0,0:14:01.24,0:14:04.57,Default,,0,0,0,,Рахмет, Президент Ария.
Dialogue: 0,0:14:04.57,0:14:08.24,Default,,0,0,0,,Бірақ бұл қалай болғанда да жақсы сезінеді
Dialogue: 0,0:14:08.24,0:14:10.91,Default,,0,0,0,,Осылай біраз тұрамын.
Dialogue: 0,0:14:10.91,0:14:13.58,Default,,0,0,0,,Пуинью
Dialogue: 0,0:14:13.58,0:14:18.25,Default,,0,0,0,,♬～
Dialogue: 0,0:14:18.25,0:14:21.59,Default,,0,0,0,,Таң атқанда тасымалдаушы компания келді.
Dialogue: 0,0:14:21.59,0:14:23.93,Default,,0,0,0,,Олар гондоланы алып жүретін сияқты.
Dialogue: 0,0:14:23.93,0:14:25.93,Default,,0,0,0,,Пуинью
Dialogue: 0,0:14:28.60,0:14:31.27,Default,,0,0,0,,Енді ешқашан бірге болмайық
Dialogue: 0,0:14:31.27,0:14:34.94,Default,,0,0,0,,Сіз енді суда жүгіре алмайсыз.
Dialogue: 0,0:14:34.94,0:14:36.94,Default,,0,0,0,,Пуи
Dialogue: 0,0:14:36.94,0:14:51.55,Default,,0,0,0,,♬～
Dialogue: 0,0:14:51.55,0:14:54.22,Default,,0,0,0,,《Бұл Акари-чанның гондоласы》
Dialogue: 0,0:14:54.22,0:14:57.89,Default,,0,0,0,,《Уау~ Бұл нағыз гондола! 》
Dialogue: 0,0:14:57.89,0:15:00.23,Default,,0,0,0,,《О, Құдайым!》
Dialogue: 0,0:15:00.23,0:15:04.53,Default,,0,0,0,,《Көп рахмет, Гондола мырза》
Dialogue: 0,0:15:06.23,0:15:08.57,Default,,0,0,0,,《Ғажайып, Акари-чан》
Dialogue: 0,0:15:08.57,0:15:12.57,Default,,0,0,0,,《Бірақ айту қиын...➡
Dialogue: 0,0:15:12.57,0:15:15.24,Default,,0,0,0,,Қарсы бағытта есу》
Dialogue: 0,0:15:15.24,0:15:17.91,Default,,0,0,0,,《Кімге? 》
Dialogue: 0,0:15:17.91,0:15:20.92,Default,,0,0,0,,《Уф... Уау...》
Dialogue: 0,0:15:23.25,0:15:26.59,Default,,0,0,0,,《Пу… Пуи》
Dialogue: 0,0:15:26.59,0:15:31.59,Default,,0,0,0,,♬～
Dialogue: 0,0:15:31.59,0:15:35.93,Default,,0,0,0,,《Алисия, бұл сен қолданатын гондола.》
Dialogue: 0,0:15:35.93,0:15:39.23,Default,,0,0,0,,《Көп рахмет, Гондола мырза》
Dialogue: 0,0:15:40.94,0:15:44.27,Default,,0,0,0,,《Мм... Ммм…》
Dialogue: 0,0:15:44.27,0:15:47.58,Default,,0,0,0,,《Хахи~ Ләззат алыңыз~! 》
Dialogue: 0,0:15:49.61,0:15:52.55,Default,,0,0,0,,《Уау~》
Dialogue: 0,0:15:52.55,0:15:54.95,Default,,0,0,0,,《Радуга~》
Dialogue: 0,0:15:58.89,0:16:03.49,Default,,0,0,0,,《Хехе, жылтыр болады》 (Президент Ария) 《Пуи пуи~》
Dialogue: 0,0:16:04.56,0:16:06.56,Default,,0,0,0,,《Уау~》
Dialogue: 0,0:16:10.23,0:16:15.90,Default,,0,0,0,,《Бұл жер Үнділер арасындағы Үміт шоқысы деп аталады.》
Dialogue: 0,0:16:15.90,0:16:31.25,Default,,0,0,0,,♬～
Dialogue: 0,0:16:31.25,0:16:34.26,Default,,0,0,0,,＜Мен сені бірінші рет кездестіруім➡
Dialogue: 0,0:16:34.26,0:16:38.26,Default,,0,0,0,,ARIA фирмалық формасын алғаш рет кию➡
Dialogue: 0,0:16:38.26,0:16:41.96,Default,,0,0,0,,Көптеген жаңа адамдармен танысу...＞
Dialogue: 0,0:16:45.60,0:16:50.61,Default,,0,0,0,,<Сенімен бірге көптеген жаңа жерлерге шығу...>
Dialogue: 0,0:16:55.54,0:16:59.21,Default,,0,0,0,,<Одан әрі қанша уақыт өтсе де➡
Dialogue: 0,0:16:59.21,0:17:03.52,Default,,0,0,0,,Қала, адамдар, мен өзгерсем де...>
Dialogue: 0,0:17:05.55,0:17:11.56,Default,,0,0,0,,<Сен менің қымбат естеліктерімде мәңгі қаласың>
Dialogue: 0,0:17:14.23,0:17:18.90,Default,,0,0,0,,＜Ол ешқашан жоғалмайды➡
Dialogue: 0,0:17:18.90,0:17:21.90,Default,,0,0,0,,Бұл менің қазынам＞
Dialogue: 0,0:17:25.91,0:17:30.91,Default,,0,0,0,,Мен Акваға келгенде ол туралы ештеңе білмедім.
Dialogue: 0,0:17:30.91,0:17:36.52,Default,,0,0,0,,Сіз маған көптеген алғашқыларды сыйладыңыз, мен оларды санай алмаймын.
Dialogue: 0,0:17:37.92,0:17:40.25,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:40.25,0:17:50.20,Default,,0,0,0,,♬～
Dialogue: 0,0:17:50.20,0:17:52.20,Default,,0,0,0,,Біз оның жайлы өте аз білеміз… Бұл не, мырза Ринатаки?
Dialogue: 0,0:17:55.87,0:17:59.87,Default,,0,0,0,,Көмегің үшін көп рахмет.
Dialogue: 0,0:17:59.87,0:18:02.88,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:18:02.88,0:18:22.90,Default,,0,0,0,,♬～
Dialogue: 0,0:18:22.90,0:18:41.92,Default,,0,0,0,,♬～
Dialogue: 0,0:18:41.92,0:18:43.92,Default,,0,0,0,,♬～
Dialogue: 0,0:18:43.92,0:18:45.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:50.52,0:18:54.53,Default,,0,0,0,,Иә? Кім... Пуи?
Dialogue: 0,0:18:54.53,0:18:57.20,Default,,0,0,0,,Қазір кім бар?
Dialogue: 0,0:18:57.20,0:19:01.20,Default,,0,0,0,,Маған қолшатыр ұстап тұрғандай сезіндім...
Dialogue: 0,0:19:01.20,0:19:21.22,Default,,0,0,0,,♬～
Dialogue: 0,0:19:21.22,0:19:23.89,Default,,0,0,0,,♬～
Dialogue: 0,0:19:23.89,0:19:26.56,Default,,0,0,0,,Сау болыңыз!
Dialogue: 0,0:19:26.56,0:19:29.90,Default,,0,0,0,,Пуинюпуи Пупуиню~!
Dialogue: 0,0:19:29.90,0:19:35.90,Default,,0,0,0,,♬～
Dialogue: 0,0:19:35.90,0:19:40.57,Default,,0,0,0,,<Ай-чан, арамызда сәл алыс, бірақ➡
Dialogue: 0,0:19:40.57,0:19:43.58,Default,,0,0,0,,Сол мұхитта, Аквада➡
Dialogue: 0,0:19:43.58,0:19:46.58,Default,,0,0,0,,Біз бұдан былай әрқашан бірге боламыз＞
Dialogue: 0,0:19:46.58,0:19:52.25,Default,,0,0,0,,♬～
Dialogue: 0,0:19:52.25,0:19:55.59,Default,,0,0,0,,<Біраз уақыттан кейін...>
Dialogue: 0,0:19:55.59,0:19:58.26,Default,,0,0,0,,Pupupuinyu~!
Dialogue: 0,0:19:58.26,0:20:00.59,Default,,0,0,0,,Хэхе~
Dialogue: 0,0:20:00.59,0:20:04.60,Default,,0,0,0,,Бұл Акаридің жаңа гондоласы.
Dialogue: 0,0:20:04.60,0:20:07.94,Default,,0,0,0,,Бұл... керемет.
Dialogue: 0,0:20:07.94,0:20:13.61,Default,,0,0,0,,Бұл гондоланың бірінші шабандозы - Акари-чан.
Dialogue: 0,0:20:13.61,0:20:15.94,Default,,0,0,0,,Хахи...
Dialogue: 0,0:20:15.94,0:20:27.96,Default,,0,0,0,,♬～
Dialogue: 0,0:20:27.96,0:20:29.96,Default,,0,0,0,,Мен қобалжыдым
Dialogue: 0,0:20:29.96,0:20:33.96,Default,,0,0,0,,Мен әйтеуір жақсы есу мүмкін емес.
Dialogue: 0,0:20:33.96,0:20:35.96,Default,,0,0,0,,Жарайды
Dialogue: 0,0:20:35.96,0:20:38.63,Default,,0,0,0,,Ол желге қарсы жүгіреді.
Dialogue: 0,0:20:38.63,0:20:42.30,Default,,0,0,0,,Пуинюпуиню~
Dialogue: 0,0:20:42.30,0:20:45.97,Default,,0,0,0,,Иә, рақмет.
Dialogue: 0,0:20:45.97,0:20:54.92,Default,,0,0,0,,♬～
Dialogue: 0,0:20:54.92,0:20:56.92,Default,,0,0,0,,А...
Dialogue: 0,0:20:56.92,0:21:02.92,Default,,0,0,0,,♬～
Dialogue: 0,0:21:02.92,0:21:04.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:06.26,0:21:08.60,Default,,0,0,0,,Жақсы! (Президент Ария) Пуиню?
Dialogue: 0,0:21:08.60,0:21:28.62,Default,,0,0,0,,♬～
Dialogue: 0,0:21:28.62,0:21:30.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:34.62,0:21:39.29,Default,,0,0,0,,Мен салған жарадан... ізі болды.
Dialogue: 0,0:21:39.29,0:21:42.96,Default,,0,0,0,,Акари-чан... (Президент Ария) Пуинюпуи?
Dialogue: 0,0:21:42.96,0:21:51.91,Default,,0,0,0,,♬～
Dialogue: 0,0:21:51.91,0:21:54.24,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:21:54.24,0:21:58.25,Default,,0,0,0,,Уфуфуфу (Президент Ария) Пуйпуинию~!
Dialogue: 0,0:22:00.25,0:22:02.58,Default,,0,0,0,,Жаңа гондола-сан
Dialogue: 0,0:22:02.58,0:22:07.59,Default,,0,0,0,,Мен кішкентай ғана адаммын, бірақ маған қамқорлық жасаңыз.
Dialogue: 0,0:22:07.59,0:22:18.93,Default,,0,0,0,,♬～
Dialogue: 0,0:22:18.93,0:22:22.94,Default,,0,0,0,,< Жылтыр гондоласы бар Акари-сан ➡
Dialogue: 0,0:22:22.94,0:22:26.61,Default,,0,0,0,,Сіз көптеген алғашқыларды кездестіресіз.＞
Dialogue: 0,0:22:26.61,0:22:32.28,Default,,0,0,0,,<Акари-саннан кейін ол гондолаға кім мінеді? ＞
Dialogue: 0,0:22:32.28,0:22:52.23,Default,,0,0,0,,♬～
Dialogue: 0,0:22:52.23,0:23:12.25,Default,,0,0,0,,♬～
Dialogue: 0,0:23:12.25,0:23:32.27,Default,,0,0,0,,♬～
Dialogue: 0,0:23:32.27,0:23:52.23,Default,,0,0,0,,♬～
Dialogue: 0,0:23:52.23,0:23:54.93,Default,,0,0,0,,♬～
