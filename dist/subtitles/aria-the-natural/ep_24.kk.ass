Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.96,0:00:04.63,Default,,0,0,0,,⚟ (жаңбыр дыбысы)
Dialogue: 0,0:00:04.63,0:00:09.30,Default,,0,0,0,,<Ай-чан, сенің әжеңнің жағдайы қалай? ＞
Dialogue: 0,0:00:09.30,0:00:15.01,Default,,0,0,0,,<Ұзақ жаз аяқталып, күз ақырын жақындап келеді>
Dialogue: 0,0:00:16.98,0:00:22.32,Default,,0,0,0,,(Президент Арияның ұйықтап жатқан тынысы)
Dialogue: 0,0:00:22.32,0:00:25.32,Default,,0,0,0,,...
Dialogue: 0,0:00:26.32,0:00:30.66,Default,,0,0,0,,Хахи? Мм... Президент Ария?
Dialogue: 0,0:00:30.66,0:00:33.33,Default,,0,0,0,,Пуйпуи~
Dialogue: 0,0:00:33.33,0:00:36.00,Default,,0,0,0,,Амансың ба? (Президент Ария) Пуи
Dialogue: 0,0:00:36.00,0:00:38.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:38.67,0:00:40.67,Default,,0,0,0,,Жаңбыр жауып тұр
Dialogue: 0,0:00:41.67,0:00:44.34,Default,,0,0,0,,<Күндер қысқарып барады➡
Dialogue: 0,0:00:44.34,0:00:48.34,Default,,0,0,0,,Соңғы кездері жаңбырлы күндер саны артып келеді.
Dialogue: 0,0:00:49.34,0:00:53.02,Default,,0,0,0,,Бүгін жаттығудан демалыс күні.
Dialogue: 0,0:00:53.02,0:00:55.35,Default,,0,0,0,,Пуиню~
Dialogue: 0,0:00:55.35,0:01:15.30,Default,,0,0,0,,♬～
Dialogue: 0,0:01:15.30,0:01:35.32,Default,,0,0,0,,♬～
Dialogue: 0,0:01:35.32,0:01:55.34,Default,,0,0,0,,♬～
Dialogue: 0,0:01:55.34,0:02:14.96,Default,,0,0,0,,♬～
Dialogue: 0,0:02:14.96,0:02:16.97,Default,,0,0,0,,♬～
Dialogue: 0,0:02:16.97,0:02:19.63,Default,,0,0,0,,☎ (рингтон)
Dialogue: 0,0:02:19.63,0:02:21.97,Default,,0,0,0,,Иә, ARIA campa... ☎(Айка) Эй!
Dialogue: 0,0:02:21.97,0:02:24.64,Default,,0,0,0,,☎ Сіз не істеп жатырсыз?
Dialogue: 0,0:02:24.64,0:02:27.04,Default,,0,0,0,,Хэхе~?
Dialogue: 0,0:02:32.65,0:02:37.99,Default,,0,0,0,,♪ Пуипу Пуиню Пуи Пуиню Пуипу Пуиню~
Dialogue: 0,0:02:37.99,0:02:41.66,Default,,0,0,0,,<Жаңбырдың салдарынан жартылай жартылай жартылай көлікке міну мүмкін болмағанда.➡
Dialogue: 0,0:02:41.66,0:02:44.33,Default,,0,0,0,,Бір-бірінің бөлмесіне жиналыңдар➡
Dialogue: 0,0:02:44.33,0:02:46.66,Default,,0,0,0,,Толыққанды ундинге айналу➡
Dialogue: 0,0:02:46.66,0:02:50.00,Default,,0,0,0,,Біз оқу сабағын өткізуді жоспарлап отырмыз＞
Dialogue: 0,0:02:50.00,0:02:53.30,Default,,0,0,0,,<Бүгін менің кезегім Айка-чанның бөлмесіне қарайды>
Dialogue: 0,0:02:54.34,0:02:58.67,Default,,0,0,0,,Айка-сенпай бүгін қатты толқыды.
Dialogue: 0,0:02:58.67,0:03:00.94,Default,,0,0,0,,Ойланып қарасаңыз, дұрыс.
Dialogue: 0,0:03:00.94,0:03:03.95,Default,,0,0,0,,«Мен саған қанша өскенімді көрсетемін!»
Dialogue: 0,0:03:03.95,0:03:06.28,Default,,0,0,0,,Сіз көп оқисыз ба?
Dialogue: 0,0:03:06.28,0:03:08.28,Default,,0,0,0,,Сәлем! (Элис Акари) Ах...
Dialogue: 0,0:03:08.28,0:03:11.62,Default,,0,0,0,,Жалқаулыққа жол бермеңіз!
Dialogue: 0,0:03:11.62,0:03:13.62,Default,,0,0,0,,Хехе
Dialogue: 0,0:03:14.62,0:03:18.29,Default,,0,0,0,,Еңбегің, ерен еңбегің, өрге!
Dialogue: 0,0:03:18.29,0:03:21.30,Default,,0,0,0,,Эй, Акари-чан, Алиса-чан, қош келдің.
Dialogue: 0,0:03:21.30,0:03:25.30,Default,,0,0,0,,Мен сені мазаладым, Акира-сан, мен сені мазаладым.
Dialogue: 0,0:03:25.30,0:03:29.97,Default,,0,0,0,,Бұл жаңбырлы күндегі әдеттегі оқу сессиясы ма? Әрқашан қажырлы еңбегіңіз үшін рахмет
Dialogue: 0,0:03:29.97,0:03:33.31,Default,,0,0,0,,Сіз де жұмысыңыздан бас тартасыз ба, Акира-сан?
Dialogue: 0,0:03:33.31,0:03:36.98,Default,,0,0,0,,Егер бұл рас болса, мереке болғандықтан ол толығымен брондалған болар еді.
Dialogue: 0,0:03:36.98,0:03:38.98,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:03:38.98,0:03:43.65,Default,,0,0,0,,Клиенттер де Акираның жартылай жартылай саяхатын асыға күткеніне сенімдімін.
Dialogue: 0,0:03:43.65,0:03:47.06,Default,,0,0,0,,Бұл өкінішті (Акира) Ха...
Dialogue: 0,0:03:47.99,0:03:51.99,Default,,0,0,0,,Алиса мектептен демалыста болса да, ол не оқып жатыр?
Dialogue: 0,0:03:51.99,0:03:55.33,Default,,0,0,0,,Бұл тамаша. Сіз жақсы Undine боласыз.
Dialogue: 0,0:03:55.33,0:03:59.63,Default,,0,0,0,,Ах... (Акира) А? Бірдеңе болды ма?
Dialogue: 0,0:04:00.60,0:04:03.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:03.27,0:04:05.27,Default,,0,0,0,,Айка-чан?
Dialogue: 0,0:04:06.27,0:04:10.95,Default,,0,0,0,,Соңғы кездері жұмыста маған қадала қарағандарды көбірек байқадым.
Dialogue: 0,0:04:10.95,0:04:13.95,Default,,0,0,0,,Бұрынғыдай? Бұл дұрыс!
Dialogue: 0,0:04:13.95,0:04:16.95,Default,,0,0,0,,Бұл менің жақында өскеніме байланысты екеніне сенімдімін.
Dialogue: 0,0:04:16.95,0:04:20.29,Default,,0,0,0,,үшінның көзі менде деп ойлаймын.
Dialogue: 0,0:04:20.29,0:04:23.96,Default,,0,0,0,,Хаха, мен өте сенімдімін.
Dialogue: 0,0:04:23.96,0:04:27.63,Default,,0,0,0,,Прима болатын күнім жақын шығар.
Dialogue: 0,0:04:27.63,0:04:31.63,Default,,0,0,0,,Оны бәрі сезінеді, сен солай ойлайсың ба?
Dialogue: 0,0:04:31.63,0:04:36.64,Default,,0,0,0,,Үлкен адасушылықтарды артқа тастап, оқуға кірісейік.
Dialogue: 0,0:04:36.64,0:04:40.31,Default,,0,0,0,,Не! бастайық Бастайық~
Dialogue: 0,0:04:40.31,0:04:42.64,Default,,0,0,0,,Иә, иә (Президент Ария) Пуи Пуи Пуиню~
Dialogue: 0,0:04:42.64,0:04:46.65,Default,,0,0,0,,Пуи Пуи Пуиню Пуй Пуй Пуи Пуи
Dialogue: 0,0:04:47.98,0:04:49.99,Default,,0,0,0,,Pupui⁉
Dialogue: 0,0:04:49.99,0:04:52.65,Default,,0,0,0,,Пупу пупу… Пуиню…
Dialogue: 0,0:04:52.65,0:04:55.99,Default,,0,0,0,,Жақсы! Осы жағдайға сәйкес
Dialogue: 0,0:04:55.99,0:04:59.66,Default,,0,0,0,,Мәселе ұшу есебінің толтырылмағанында.
Dialogue: 0,0:04:59.66,0:05:02.93,Default,,0,0,0,,Жағдайды түсінуде кешігу болған сияқты.
Dialogue: 0,0:05:02.93,0:05:07.94,Default,,0,0,0,,Әй, есеп жазудың қиындығы сонша, мен оны кейінге қалдырамын.
Dialogue: 0,0:05:07.94,0:05:11.94,Default,,0,0,0,,Дұрыс, бірақ Алисия өте бос емес.
Dialogue: 0,0:05:11.94,0:05:14.61,Default,,0,0,0,,Білмей тұрып бітеді.
Dialogue: 0,0:05:14.61,0:05:18.61,Default,,0,0,0,,Бұл таңқаларлық, күткендей, Алисия-сан.
Dialogue: 0,0:05:19.95,0:05:24.62,Default,,0,0,0,,Ойлап қарасам, Акари ARIA компаниясына 15 жасында қосылды, солай ма?
Dialogue: 0,0:05:24.62,0:05:26.62,Default,,0,0,0,,Иә, білесіз бе?
Dialogue: 0,0:05:26.62,0:05:28.62,Default,,0,0,0,,Алисия да прима болды.
Dialogue: 0,0:05:28.62,0:05:30.63,Default,,0,0,0,,15 жасымда.
Dialogue: 0,0:05:30.63,0:05:34.30,Default,,0,0,0,,Иә? Солай ма? Бұл үлкен және жылдам
Dialogue: 0,0:05:34.30,0:05:37.97,Default,,0,0,0,,Иә! Ундин тарихындағы Алисия
Dialogue: 0,0:05:37.97,0:05:42.97,Default,,0,0,0,,Ол жарқыраған Prima промоушнының ең жас рекордсмені.
Dialogue: 0,0:05:42.97,0:05:44.97,Default,,0,0,0,,Айтпақшы, әже
Dialogue: 0,0:05:44.97,0:05:47.98,Default,,0,0,0,,Бұдан былай оны ешкім бұза алмайды дейді.
Dialogue: 0,0:05:47.98,0:05:50.98,Default,,0,0,0,,Примадан зейнетке шыққан ең қарт адам болу рекордына ие.
Dialogue: 0,0:05:50.98,0:05:53.98,Default,,0,0,0,,Хмм, мүмкін ARIA компаниясы шығар?
Dialogue: 0,0:05:53.98,0:05:56.32,Default,,0,0,0,,Бұл керемет компания емес пе?
Dialogue: 0,0:05:56.32,0:05:58.32,Default,,0,0,0,,Егер жоқ болса да, иә.
Dialogue: 0,0:05:58.32,0:06:01.26,Default,,0,0,0,,Акариден басқа барлығы Иә!
Dialogue: 0,0:06:01.26,0:06:21.28,Default,,0,0,0,,♬～
Dialogue: 0,0:06:21.28,0:06:23.61,Default,,0,0,0,,♬～
Dialogue: 0,0:06:23.61,0:06:27.62,Default,,0,0,0,,Айтпақшы... сізде босаңсуға бейімділік бар, солай емес пе?
Dialogue: 0,0:06:27.62,0:06:29.95,Default,,0,0,0,,Жоқ! Бұл маңызды оқиға.
Dialogue: 0,0:06:29.95,0:06:32.62,Default,,0,0,0,,Көше атауларына тоқталайық! Көше атаулары!
Dialogue: 0,0:06:32.62,0:06:36.29,Default,,0,0,0,,Прима болғаннан кейін сізге лақап атыңызды пайдалануға рұқсат беріледі.
Dialogue: 0,0:06:36.29,0:06:39.29,Default,,0,0,0,,Бұл лақап ат, солай ма?
Dialogue: 0,0:06:39.29,0:06:41.63,Default,,0,0,0,,Сонымен қатар бастауыштың дәлелі
Dialogue: 0,0:06:41.63,0:06:44.30,Default,,0,0,0,,Бұл екінші атау деп аталады.
Dialogue: 0,0:06:44.30,0:06:47.64,Default,,0,0,0,,Иә, иә, бұл атау.
Dialogue: 0,0:06:47.64,0:06:51.64,Default,,0,0,0,,Көшенің атауын қазірден бастап ойланамын деп ойладым.
Dialogue: 0,0:06:51.64,0:06:54.64,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл көше атауы ма?
Dialogue: 0,0:06:54.64,0:06:56.98,Default,,0,0,0,,Алисияның көше аты...
Dialogue: 0,0:06:56.98,0:07:00.58,Default,,0,0,0,,Ақ Ақшақар ертегі!
Dialogue: 0,0:07:00.58,0:07:02.92,Default,,0,0,0,,Афина-сенпай - сирена.
Dialogue: 0,0:07:02.92,0:07:05.25,Default,,0,0,0,,Ән айту су перісі
Dialogue: 0,0:07:05.25,0:07:09.93,Default,,0,0,0,,Ал Акира-сан – қызыл қызыл раушан.
Dialogue: 0,0:07:09.93,0:07:13.93,Default,,0,0,0,,Өте керемет! үшін өте үлкен және керемет
Dialogue: 0,0:07:13.93,0:07:16.93,Default,,0,0,0,,Әсіресе Алисия ең жақсы!
Dialogue: 0,0:07:16.93,0:07:20.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:20.27,0:07:22.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:25.94,0:07:29.95,Default,,0,0,0,,Әй, маған қандай көше атауы жарасады?
Dialogue: 0,0:07:29.95,0:07:31.95,Default,,0,0,0,,Момико...
Dialogue: 0,0:07:31.95,0:07:35.28,Default,,0,0,0,,Бұл Момико емес! Кешіріңіз кешіріңіз
Dialogue: 0,0:07:35.28,0:07:38.59,Default,,0,0,0,,Сонымен, үлкен Момико ше?
Dialogue: 0,0:07:39.95,0:07:43.29,Default,,0,0,0,,Маған не сәйкес келеді деп ойлайсыз?
Dialogue: 0,0:07:43.29,0:07:47.30,Default,,0,0,0,,Ммм... Мм...
Dialogue: 0,0:07:47.30,0:07:49.30,Default,,0,0,0,,Ғажайып Crybaby
Dialogue: 0,0:07:49.30,0:07:52.63,Default,,0,0,0,,Ұятты көше атауларына тыйым салынған?
Dialogue: 0,0:07:52.63,0:07:56.64,Default,,0,0,0,,Айка-сенпайдың үлкен, тамаша лақап аты бар.
Dialogue: 0,0:07:56.64,0:07:58.97,Default,,0,0,0,,Иә! Қандай түрі?
Dialogue: 0,0:07:58.97,0:08:02.28,Default,,0,0,0,,Ежелгі мифтік аң гача қаламы
Dialogue: 0,0:08:03.58,0:08:07.58,Default,,0,0,0,,Тыйым салынған Тыйым салынған Тыйым салынған Тыйым салынған ~!
Dialogue: 0,0:08:07.58,0:08:11.59,Default,,0,0,0,,Айка-чанның гача қаламы бар...
Dialogue: 0,0:08:11.59,0:08:14.59,Default,,0,0,0,,Керемет болуы мүмкін Жазбаларға рұқсат етілмейді!
Dialogue: 0,0:08:14.59,0:08:17.26,Default,,0,0,0,,Ал, Алиса ше?
Dialogue: 0,0:08:17.26,0:08:21.26,Default,,0,0,0,,Үлкен тыйым? Бұл үлкен бас тарту
Dialogue: 0,0:08:21.26,0:08:25.27,Default,,0,0,0,,Ойланып қарасаң өте қиын.
Dialogue: 0,0:08:25.27,0:08:27.94,Default,,0,0,0,,Құрметті лақап ат
Dialogue: 0,0:08:27.94,0:08:31.61,Default,,0,0,0,,Бір кездері Мэнгомның Венециясында ойлап көріңізші.
Dialogue: 0,0:08:31.61,0:08:36.28,Default,,0,0,0,,Зейнеткерлердің лақап атын мұраға қалдыру дәстүрі болғанға ұқсайды.
Dialogue: 0,0:08:36.28,0:08:38.28,Default,,0,0,0,,Ааа~ Аа...
Dialogue: 0,0:08:38.28,0:08:42.95,Default,,0,0,0,,Егер қолымнан келсе, мен Алисияның Ақшақарды мұраға алар едім.
Dialogue: 0,0:08:42.95,0:08:45.62,Default,,0,0,0,,Айка сен
Dialogue: 0,0:08:45.62,0:08:49.62,Default,,0,0,0,,Сіз Алисия прима болу үшін зейнетке шыққанша күтесіз бе?
Dialogue: 0,0:08:49.62,0:08:51.63,Default,,0,0,0,,Ол өте сабырлы жігіт.
Dialogue: 0,0:08:51.63,0:08:56.63,Default,,0,0,0,,А... Түсіндім, Акира-сан, не болды?
Dialogue: 0,0:08:57.63,0:09:00.24,Default,,0,0,0,,Кешіріңіз, осы құжатты реттеуге көмектесіңіз.
Dialogue: 0,0:09:00.24,0:09:02.90,Default,,0,0,0,,Хэхе~ Мұның бәрі ме?
Dialogue: 0,0:09:02.90,0:09:07.24,Default,,0,0,0,,Бұл құжаттардың үлкен үйіндісі. Мен қазір оқу сессиясының ортасындамын.
Dialogue: 0,0:09:07.24,0:09:09.58,Default,,0,0,0,,Сіз әлсіреп бара жатқан сияқтысыз ба?
Dialogue: 0,0:09:09.58,0:09:12.58,Default,,0,0,0,,Қанша рет қаққанмен, ешкім естімегендей болды.
Dialogue: 0,0:09:12.58,0:09:15.25,Default,,0,0,0,,Дұрыс... (Акира) О, иә.
Dialogue: 0,0:09:15.25,0:09:18.59,Default,,0,0,0,,Мен айтып отырған лақап ат туралы... А?
Dialogue: 0,0:09:18.59,0:09:22.26,Default,,0,0,0,,Нақтырақ айтсақ, Мэнгомның Венециясында
Dialogue: 0,0:09:22.26,0:09:25.59,Default,,0,0,0,,Гондольерлердің санына шектеу қойылды.
Dialogue: 0,0:09:25.59,0:09:28.26,Default,,0,0,0,,Сондықтан көше атауын мұрагерлік ету дегенді білдіреді
Dialogue: 0,0:09:28.26,0:09:31.60,Default,,0,0,0,,Кәсіпкерлікпен айналысу құқығын мұраға алудың да мәні болды.
Dialogue: 0,0:09:31.60,0:09:36.94,Default,,0,0,0,,Ол кездегі гондольер қазіргіден әлдеқайда тар болды.
Dialogue: 0,0:09:36.94,0:09:40.28,Default,,0,0,0,,Хэхе~ Мен мұны мүлдем білмедім.
Dialogue: 0,0:09:40.28,0:09:42.61,Default,,0,0,0,,Бұрын қиын болды емес пе?
Dialogue: 0,0:09:42.61,0:09:45.28,Default,,0,0,0,,Олай болса, құжаттарыңызды реттеңіз.
Dialogue: 0,0:09:45.28,0:09:48.62,Default,,0,0,0,,О... күте тұрыңыз!
Dialogue: 0,0:09:48.62,0:09:53.96,Default,,0,0,0,,Неліктен біз құжаттарды ретке келтіруіміз керек?
Dialogue: 0,0:09:53.96,0:09:56.96,Default,,0,0,0,,Үлкендеріңіздің айтқанын тыңдаңыз.
Dialogue: 0,0:09:56.96,0:09:59.96,Default,,0,0,0,,бұл... ха, мен түсіндім.
Dialogue: 0,0:09:59.96,0:10:03.97,Default,,0,0,0,,Міне!
Dialogue: 0,0:10:03.97,0:10:07.30,Default,,0,0,0,,Иә! Ах...
Dialogue: 0,0:10:07.30,0:10:15.64,Default,,0,0,0,,♬～
Dialogue: 0,0:10:15.64,0:10:18.65,Default,,0,0,0,,Сіз бұрыннан келген адамсыз ба?
Dialogue: 0,0:10:18.65,0:10:21.32,Default,,0,0,0,,Сіз Айка-чанға ұмтыласыз ба?
Dialogue: 0,0:10:21.32,0:10:23.32,Default,,0,0,0,,Ол үлкен атақты.
Dialogue: 0,0:10:23.32,0:10:26.32,Default,,0,0,0,,Оның орнына құжаттарымды ретке келтіруім керек.
Dialogue: 0,0:10:26.32,0:10:31.33,Default,,0,0,0,,Әй, Алисия ешқашан мұндай өркөкіректік жасамас еді.
Dialogue: 0,0:10:31.33,0:10:33.63,Default,,0,0,0,,Айка-чантара~
Dialogue: 0,0:10:46.98,0:10:51.91,Default,,0,0,0,,♬～
Dialogue: 0,0:10:51.91,0:10:55.92,Default,,0,0,0,,(Президент Ария мен президент Мааның ұйқысы)
Dialogue: 0,0:10:55.92,0:11:15.94,Default,,0,0,0,,♬～
Dialogue: 0,0:11:15.94,0:11:19.61,Default,,0,0,0,,♬～
Dialogue: 0,0:11:19.61,0:11:22.28,Default,,0,0,0,,Бітті! Ах...
Dialogue: 0,0:11:22.28,0:11:24.95,Default,,0,0,0,,Хэхе~ Ақыры аяқталды
Dialogue: 0,0:11:24.95,0:11:26.95,Default,,0,0,0,,Бұл үлкен және қиын болды.
Dialogue: 0,0:11:26.95,0:11:29.95,Default,,0,0,0,,Мен сені сонша мәжбүрлеп жатқаныма сене алар емеспін.
Dialogue: 0,0:11:29.95,0:11:32.95,Default,,0,0,0,,Ол адамдарға өте қатал.
Dialogue: 0,0:11:32.95,0:11:36.96,Default,,0,0,0,,Бірақ ойланып қарасаңыз, мұндай кесте...
Dialogue: 0,0:11:36.96,0:11:40.63,Default,,0,0,0,,Есептерді жазу және тексеру
Dialogue: 0,0:11:40.63,0:11:43.63,Default,,0,0,0,,Бұл Ундиннің маңызды жұмысы, солай емес пе?
Dialogue: 0,0:11:43.63,0:11:47.97,Default,,0,0,0,,Дұрыс, гондолада жүру жалғыз жұмыс емес.
Dialogue: 0,0:11:47.97,0:11:50.91,Default,,0,0,0,,А... бұл жұмысты Акира істеп жатқан шығар?
Dialogue: 0,0:11:50.91,0:11:54.91,Default,,0,0,0,,Түсіну үшін бізге әкелдің бе?
Dialogue: 0,0:11:54.91,0:11:57.58,Default,,0,0,0,,Түсіндім, егер сіз Прима болуды мақсат етсеңіз.
Dialogue: 0,0:11:57.58,0:12:01.58,Default,,0,0,0,,Бұл біз осындай нәрселерді жасауымыз керек дегенді білдіре ме?
Dialogue: 0,0:12:03.92,0:12:07.92,Default,,0,0,0,,Айтпасаң да білем.
Dialogue: 0,0:12:08.92,0:12:11.26,Default,,0,0,0,,Айка-чан... Әйтеуір
Dialogue: 0,0:12:11.26,0:12:15.96,Default,,0,0,0,,Мен бұл құжатты Акира-санның бөлмесіне қайтарамын.
Dialogue: 0,0:12:17.60,0:12:21.27,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:12:21.27,0:12:24.27,Default,,0,0,0,,Сен керемет адамсың, Акира-сан.
Dialogue: 0,0:12:24.27,0:12:27.98,Default,,0,0,0,,Айка-сенпай шын айта алмайтын сияқты.
Dialogue: 0,0:12:32.61,0:12:34.62,Default,,0,0,0,,Фу…
Dialogue: 0,0:12:37.29,0:12:40.59,Default,,0,0,0,,<А, анау адам...>
Dialogue: 0,0:12:43.96,0:12:48.63,Default,,0,0,0,,Хехехе, сен тіпті осындай жерде мені ғайбаттап жүрсің бе?
Dialogue: 0,0:12:48.63,0:12:52.23,Default,,0,0,0,,Дұрыс, не туралы айтып тұрғаныңды тыңдайық.
Dialogue: 0,0:12:52.23,0:12:54.24,Default,,0,0,0,,Хмф
Dialogue: 0,0:13:01.24,0:13:03.24,Default,,0,0,0,,сыбдырлау
Dialogue: 0,0:13:04.58,0:13:06.91,Default,,0,0,0,,<Бұл қандай әңгіме? ＞
Dialogue: 0,0:13:06.91,0:13:09.25,Default,,0,0,0,,<Хехе...>
Dialogue: 0,0:13:09.25,0:13:15.26,Default,,0,0,0,,⚟ (жаңбыр дыбысы)
Dialogue: 0,0:13:17.26,0:13:19.26,Default,,0,0,0,,Ха…
Dialogue: 0,0:13:25.27,0:13:27.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:43.62,0:13:48.29,Default,,0,0,0,,Бірақ Алиса-чанның да тамаша ағалары бар.
Dialogue: 0,0:13:48.29,0:13:53.23,Default,,0,0,0,,ше? Менің ағам жай ғана ебедейсіз бала.
Dialogue: 0,0:13:53.23,0:13:55.56,Default,,0,0,0,,Уфуфу... Не?
Dialogue: 0,0:13:55.56,0:13:57.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:01.90,0:14:03.91,Default,,0,0,0,,Айка-сенпай?
Dialogue: 0,0:14:03.91,0:14:07.21,Default,,0,0,0,,Іс-әрекет... Не болды? Айка-чан
Dialogue: 0,0:14:08.24,0:14:11.25,Default,,0,0,0,,Бұл мен емес едім...
Dialogue: 0,0:14:11.25,0:14:13.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:18.92,0:14:21.59,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:14:21.59,0:14:25.59,Default,,0,0,0,,Ол кісі маған қарамады.
Dialogue: 0,0:14:25.59,0:14:29.60,Default,,0,0,0,,Не? Мен дәлізде естідім
Dialogue: 0,0:14:29.60,0:14:31.60,Default,,0,0,0,,Бұл адам не туралы айтты?
Dialogue: 0,0:14:31.60,0:14:35.60,Default,,0,0,0,,Акира-санның... жаман сөз болды.
Dialogue: 0,0:14:35.60,0:14:37.61,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:37.61,0:14:41.28,Default,,0,0,0,,«Үш басты перінің бірі болғаным үшін мені ренжітіп жатырмын».
Dialogue: 0,0:14:41.28,0:14:45.28,Default,,0,0,0,,«Мен ешкім қарсы тұра алмайтын атмосфераны жасап жатырмын».
Dialogue: 0,0:14:46.28,0:14:49.62,Default,,0,0,0,,Сол кезде, сол кезде...
Dialogue: 0,0:14:49.62,0:14:51.55,Default,,0,0,0,,Мен емес, сол адам.
Dialogue: 0,0:14:51.55,0:14:55.22,Default,,0,0,0,,Қасымда жүрген Акира-санды көргенде ол туралы жаман сөз айттым.
Dialogue: 0,0:14:55.22,0:14:58.56,Default,,0,0,0,,Бірақ... Бірақ егер мен...
Dialogue: 0,0:14:58.56,0:15:01.90,Default,,0,0,0,,Өзіңнің назардың орталығында екеніңді сену
Dialogue: 0,0:15:01.90,0:15:06.57,Default,,0,0,0,,Ақымақ бақытты... Айка-чан
Dialogue: 0,0:15:06.57,0:15:11.57,Default,,0,0,0,,Жоқ... Акира-сан туралы жаман сөз айтуға болмайды.
Dialogue: 0,0:15:11.57,0:15:13.91,Default,,0,0,0,,Мен мұны істей аламын.
Dialogue: 0,0:15:13.91,0:15:19.91,Default,,0,0,0,,Әуелден Химеяның мұрагері болып туған мен туралы жаман сөз айтсаң,
Dialogue: 0,0:15:19.91,0:15:22.25,Default,,0,0,0,,Бірақ Акира-сан
Dialogue: 0,0:15:22.25,0:15:26.25,Default,,0,0,0,,Осы Химеяда мен өз күшіммен нөлден примаға дейін бардым.
Dialogue: 0,0:15:26.25,0:15:28.92,Default,,0,0,0,,Ол бірінші орынды иемденді.
Dialogue: 0,0:15:28.92,0:15:34.60,Default,,0,0,0,,Сондықтан Акира-санға деген қызғаныш пен жала ғана
Dialogue: 0,0:15:34.60,0:15:36.93,Default,,0,0,0,,Мүлдем жоқ!
Dialogue: 0,0:15:36.93,0:15:39.27,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:15:39.27,0:15:42.60,Default,,0,0,0,,Ах... (Президент Химе) Мяу~
Dialogue: 0,0:15:42.60,0:15:45.94,Default,,0,0,0,,Мүлдем жоқ!
Dialogue: 0,0:15:45.94,0:15:49.88,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:15:49.88,0:15:52.88,Default,,0,0,0,,Акира...
Dialogue: 0,0:15:52.88,0:15:55.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:55.22,0:16:04.23,Default,,0,0,0,,♬～
Dialogue: 0,0:16:05.23,0:16:07.56,Default,,0,0,0,,Шай сізге көмектескеніңіз үшін алғыс айтамын.
Dialogue: 0,0:16:07.56,0:16:11.97,Default,,0,0,0,,Иә, рахмет...
Dialogue: 0,0:16:16.90,0:16:21.51,Default,,0,0,0,,Эй, Айка, бұрын не айтқанымыз есіңде ме?
Dialogue: 0,0:16:26.58,0:16:31.25,Default,,0,0,0,,Ұшқыштық саланың есігі қазір ашық екені рас.
Dialogue: 0,0:16:31.25,0:16:35.26,Default,,0,0,0,,Десе де бәрі бірдей прима бола алмайды.
Dialogue: 0,0:16:36.26,0:16:39.26,Default,,0,0,0,,Бір қарағанда керемет көрінетін бұл дүниеде де
Dialogue: 0,0:16:39.26,0:16:42.26,Default,,0,0,0,,Қатты бәсекелестік бар
Dialogue: 0,0:16:43.93,0:16:49.27,Default,,0,0,0,,Нәтижесінде біреу сізге құлағыңызды ауыртатын нәрсені айтады.
Dialogue: 0,0:16:49.27,0:16:51.54,Default,,0,0,0,,Бұл сөзсіз
Dialogue: 0,0:16:51.54,0:16:55.54,Default,,0,0,0,,Оны қабылдау менің де міндетім.
Dialogue: 0,0:16:58.21,0:17:02.22,Default,,0,0,0,,Олай болса, мен одан бетер түңіліп кетер едім.
Dialogue: 0,0:17:02.22,0:17:06.89,Default,,0,0,0,,Мен білетін Акира қаншалықты күшті көрінсе де,
Dialogue: 0,0:17:06.89,0:17:10.19,Default,,0,0,0,,Кішіпейілділігін жоғалтпайтын адам.
Dialogue: 0,0:17:11.89,0:17:14.23,Default,,0,0,0,,Қанша қатты айтсам да,
Dialogue: 0,0:17:14.23,0:17:18.57,Default,,0,0,0,,Сөзінің астарында әрқашан мейірім жатыр.
Dialogue: 0,0:17:18.57,0:17:21.57,Default,,0,0,0,,Әйтсе де, солай айтсаң да
Dialogue: 0,0:17:21.57,0:17:25.91,Default,,0,0,0,,Төзуге тура келетіні қынжылтады!
Dialogue: 0,0:17:25.91,0:17:28.21,Default,,0,0,0,,Айка-чан...
Dialogue: 0,0:17:30.24,0:17:36.25,Default,,0,0,0,,Баяғыда тамаша, тамаша үйлену тойы болған деседі.
Dialogue: 0,0:17:36.25,0:17:40.25,Default,,0,0,0,,Қалыңдық пен күйеу ауылдағы ең жақсы жұп деп аталды.
Dialogue: 0,0:17:40.25,0:17:44.93,Default,,0,0,0,,Сәнді салтанатты орын, қатысушылардың көптігі
Dialogue: 0,0:17:44.93,0:17:48.60,Default,,0,0,0,,Тойдың бәрі тамаша өтті.
Dialogue: 0,0:17:48.60,0:17:53.20,Default,,0,0,0,,Ақыры келін тайып кетті де
Dialogue: 0,0:17:53.20,0:17:57.20,Default,,0,0,0,,Мен тортқа бірінші құлағанымды қоспағанда.
Dialogue: 0,0:17:57.20,0:17:59.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:59.54,0:18:02.21,Default,,0,0,0,,Осыдан кейін рәсімдер тақырыбы қозғалғанда,
Dialogue: 0,0:18:02.21,0:18:06.55,Default,,0,0,0,,Қатысушылар бұл сәтсіздікті үнемі еске түсіретін сияқты.
Dialogue: 0,0:18:06.55,0:18:10.55,Default,,0,0,0,,Әсіресе келіннің күйзелісі қатты болды.
Dialogue: 0,0:18:10.55,0:18:14.22,Default,,0,0,0,,Осы уақытқа дейін жақсы болғаны туралы қуанышты естеліктер
Dialogue: 0,0:18:14.22,0:18:17.93,Default,,0,0,0,,Мен мүлдем ұмытып кеттім ...
Dialogue: 0,0:18:18.89,0:18:22.23,Default,,0,0,0,,Біртүрлі екен, солай емес пе?
Dialogue: 0,0:18:22.23,0:18:26.90,Default,,0,0,0,,Мені қуантатыны – тез үйреніп, екінші табиғатқа айналады.
Dialogue: 0,0:18:26.90,0:18:30.24,Default,,0,0,0,,Бір ғана жаман нәрсе болса да
Dialogue: 0,0:18:30.24,0:18:33.91,Default,,0,0,0,,Өте ауыр сезіледі.
Dialogue: 0,0:18:33.91,0:18:38.25,Default,,0,0,0,,Мүмкін адамдардың өздері
Dialogue: 0,0:18:38.25,0:18:42.25,Default,,0,0,0,,Мен өзіме ұнамайтын нәрселерді бірнеше есе қиындатып жатырмын.
Dialogue: 0,0:18:42.25,0:18:54.53,Default,,0,0,0,,♬～
Dialogue: 0,0:18:54.53,0:18:56.53,Default,,0,0,0,,Әй!
Dialogue: 0,0:18:59.20,0:19:01.54,Default,,0,0,0,,Рахмет Айка
Dialogue: 0,0:19:01.54,0:19:03.54,Default,,0,0,0,,Е...
Dialogue: 0,0:19:03.54,0:19:07.54,Default,,0,0,0,,Сенің жылағаның маған жетеді.
Dialogue: 0,0:19:09.21,0:19:11.21,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:11.21,0:19:15.55,Default,,0,0,0,,Бұл туралы алаңдамаңыз. Олар шығып тұрған қазық соғылады дейді, солай емес пе?
Dialogue: 0,0:19:15.55,0:19:19.22,Default,,0,0,0,,Әсіресе мен қатал болғандықтан.
Dialogue: 0,0:19:19.22,0:19:35.90,Default,,0,0,0,,♬～
Dialogue: 0,0:19:35.90,0:19:39.57,Default,,0,0,0,,Қуанышты да, жағымсыз нәрселерді де қарапайым деп қабылдамаңыз.
Dialogue: 0,0:19:39.57,0:19:42.98,Default,,0,0,0,,Екеуін де берік қабылдауымыз керек.
Dialogue: 0,0:19:43.91,0:19:46.91,Default,,0,0,0,,Өйткені I
Dialogue: 0,0:19:46.91,0:19:49.52,Default,,0,0,0,,Өйткені бұл бірінші кезекте
Dialogue: 0,0:19:54.26,0:19:56.56,Default,,0,0,0,,Хехе
Dialogue: 0,0:20:03.26,0:20:05.93,Default,,0,0,0,,Жаңбыр басылды.
Dialogue: 0,0:20:05.93,0:20:07.94,Default,,0,0,0,,Ммм
Dialogue: 0,0:20:07.94,0:20:10.60,Default,,0,0,0,,Акира-сан, керемет болды.
Dialogue: 0,0:20:10.60,0:20:13.27,Default,,0,0,0,,Ммм
Dialogue: 0,0:20:13.27,0:20:16.28,Default,,0,0,0,,Прима қатал, солай емес пе?
Dialogue: 0,0:20:16.28,0:20:18.28,Default,,0,0,0,,Ммм
Dialogue: 0,0:20:25.95,0:20:29.62,Default,,0,0,0,,Мен… (Алис Акари) Иә?
Dialogue: 0,0:20:29.62,0:20:32.63,Default,,0,0,0,,Бұл қолғап мені неден қорғады?
Dialogue: 0,0:20:32.63,0:20:35.63,Default,,0,0,0,,Бұл жай ғана орта қол емес еді.
Dialogue: 0,0:20:37.97,0:20:39.97,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:44.31,0:20:46.64,Default,,0,0,0,,Айка-сенпай Айка-чан
Dialogue: 0,0:20:46.64,0:20:49.91,Default,,0,0,0,,Сонымен, бізде көбірек
Dialogue: 0,0:20:49.91,0:20:53.91,Default,,0,0,0,,Мен одан да күшті болуым керек
Dialogue: 0,0:20:55.58,0:20:57.59,Default,,0,0,0,,Қосымша
Dialogue: 0,0:20:57.59,0:21:00.29,Default,,0,0,0,,Иә көбірек
Dialogue: 0,0:21:01.92,0:21:06.26,Default,,0,0,0,,Күшті бол, жүрегің де күшейеді
Dialogue: 0,0:21:06.26,0:21:08.56,Default,,0,0,0,,Содан кейін...
Dialogue: 0,0:21:09.93,0:21:29.95,Default,,0,0,0,,♬～
Dialogue: 0,0:21:29.95,0:21:32.29,Default,,0,0,0,,♬～
Dialogue: 0,0:21:32.29,0:21:34.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:34.96,0:21:44.97,Default,,0,0,0,,♬～
Dialogue: 0,0:21:44.97,0:21:48.27,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:21:50.24,0:21:52.24,Default,,0,0,0,,Міне! Уау
Dialogue: 0,0:21:52.24,0:21:56.24,Default,,0,0,0,,Сіз не істеп жатырсыз? Эй! Хехехе
Dialogue: 0,0:21:56.24,0:21:58.58,Default,,0,0,0,,Міне! Аа, аа, аа...!
Dialogue: 0,0:21:58.58,0:22:01.92,Default,,0,0,0,,(Акаридің күлкісі)
Dialogue: 0,0:22:01.92,0:22:06.25,Default,,0,0,0,,<Ай-чан, Прима болу үшін➡
Dialogue: 0,0:22:06.25,0:22:11.56,Default,,0,0,0,,Бұл маған не қажет екенін түсінген күн болды>
Dialogue: 0,0:22:14.93,0:22:17.60,Default,,0,0,0,,<Ал біз қолдан келгеннің бәрін жасаймыз➡
Dialogue: 0,0:22:17.60,0:22:20.94,Default,,0,0,0,,Мен бір күні толыққанды Undine болатыныма сенімдімін➡
Dialogue: 0,0:22:20.94,0:22:23.54,Default,,0,0,0,,Жүрегімде ант бердім＞
Dialogue: 0,0:22:24.61,0:22:28.94,Default,,0,0,0,,<Ай-чан, қалайсың? ＞
Dialogue: 0,0:22:28.94,0:22:31.61,Default,,0,0,0,,<Жауабыңызды күтуде>
Dialogue: 0,0:22:31.61,0:22:51.57,Default,,0,0,0,,♬～
Dialogue: 0,0:22:51.57,0:23:11.59,Default,,0,0,0,,♬～
Dialogue: 0,0:23:11.59,0:23:31.61,Default,,0,0,0,,♬～
Dialogue: 0,0:23:31.61,0:23:51.56,Default,,0,0,0,,♬～
Dialogue: 0,0:23:51.56,0:23:54.56,Default,,0,0,0,,♬～
