Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.63,0:00:04.63,Default,,0,0,0,,<Ай-чан➡
Dialogue: 0,0:00:04.63,0:00:08.64,Default,,0,0,0,,Нео Венецияда көктем жақындап қалды＞
Dialogue: 0,0:00:08.64,0:00:13.64,Default,,0,0,0,,<Күн күннен күнге жылынып барады...>
Dialogue: 0,0:00:14.98,0:00:18.31,Default,,0,0,0,,<Күндіз болса да, аздап ұйықтап жатырмын...>
Dialogue: 0,0:00:18.31,0:00:23.32,Default,,0,0,0,,♬～
Dialogue: 0,0:00:23.32,0:00:26.32,Default,,0,0,0,,Ух... мм.
Dialogue: 0,0:00:26.32,0:00:29.66,Default,,0,0,0,,Бұл ауыр, президент Ария.
Dialogue: 0,0:00:29.66,0:00:32.06,Default,,0,0,0,,Пуинью иә?
Dialogue: 0,0:00:32.10,0:00:37.33,Default,,0,0,0,,Хаха~ Мен білмей жатып ұйықтап қалдым.
Dialogue: 0,0:00:37.33,0:00:41.67,Default,,0,0,0,,Мені оятқаның үшін рахмет, Президент Ария.
Dialogue: 0,0:00:41.67,0:00:44.01,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:00:44.01,0:00:46.34,Default,,0,0,0,,Пошташы...
Dialogue: 0,0:00:46.34,0:00:50.68,Default,,0,0,0,,Эй, сен ояусың ба? Ұйықтау жақсы сезіне ме?
Dialogue: 0,0:00:50.68,0:00:54.02,Default,,0,0,0,,Эй, сен пошташыны көрдің бе?
Dialogue: 0,0:00:54.02,0:00:57.69,Default,,0,0,0,,А, мен сені төменнен ұйықтап жатқаныңды көрдім.
Dialogue: 0,0:00:57.69,0:01:00.62,Default,,0,0,0,,Мен сені оятсам, мен сені аяймын.
Dialogue: 0,0:01:00.62,0:01:02.96,Default,,0,0,0,,Кешіріңіз... (Президент Ария) Пуи
Dialogue: 0,0:01:02.96,0:01:04.96,Default,,0,0,0,,Йоккора Шотто
Dialogue: 0,0:01:04.96,0:01:08.63,Default,,0,0,0,,Бүгін мен ханыммен қонаққа келдім.
Dialogue: 0,0:01:08.63,0:01:10.97,Default,,0,0,0,,Не? (Пошташы) Негізі
Dialogue: 0,0:01:10.97,0:01:13.64,Default,,0,0,0,,Ағай мен мына гондола тесіліп қалды.
Dialogue: 0,0:01:13.64,0:01:16.31,Default,,0,0,0,,Оны жөндеуге бір күн керек сияқты.
Dialogue: 0,0:01:16.31,0:01:19.31,Default,,0,0,0,,Егер қолымнан келсе, мен бұл қайықты ертең мисспен бірге апарамын.
Dialogue: 0,0:01:19.31,0:01:24.65,Default,,0,0,0,,Мен оны бір күнге жалға беріп, пошта таратсам ба деп ойладым.
Dialogue: 0,0:01:24.65,0:01:27.98,Default,,0,0,0,,Шынымен бе? (Пошташы) Бұл қандай нәрсе?
Dialogue: 0,0:01:27.98,0:01:30.65,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:01:30.65,0:01:33.66,Default,,0,0,0,,Мен бірден Алисиядан сұраймын.
Dialogue: 0,0:01:33.66,0:01:35.66,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:01:35.66,0:01:55.68,Default,,0,0,0,,♬～
Dialogue: 0,0:01:55.68,0:02:15.63,Default,,0,0,0,,♬～
Dialogue: 0,0:02:15.63,0:02:35.65,Default,,0,0,0,,♬～
Dialogue: 0,0:02:35.65,0:02:41.32,Default,,0,0,0,,♬～
Dialogue: 0,0:02:41.32,0:02:45.33,Default,,0,0,0,,♬～
Dialogue: 0,0:02:45.33,0:03:03.95,Default,,0,0,0,,♬～
Dialogue: 0,0:03:03.95,0:03:05.95,Default,,0,0,0,,♬～
Dialogue: 0,0:03:05.95,0:03:07.95,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:08.95,0:03:10.95,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:03:16.29,0:03:18.63,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:18.63,0:03:22.63,Default,,0,0,0,,Ертең менің тапсырыс берген тұтынушыларым көп...
Dialogue: 0,0:03:22.63,0:03:26.30,Default,,0,0,0,,Хехе, міне сен.
Dialogue: 0,0:03:26.30,0:03:30.31,Default,,0,0,0,,Онда менмін! О, ханым?
Dialogue: 0,0:03:30.31,0:03:34.98,Default,,0,0,0,,Жоқ, Акари-чан әлі тек жарты ересек адам.
Dialogue: 0,0:03:34.98,0:03:39.98,Default,,0,0,0,,Сіз жолаушыларды нұсқаушысыз алып кете алмайсыз, солай ма?
Dialogue: 0,0:03:39.98,0:03:42.98,Default,,0,0,0,,Дұрыс... (Пошташы) Дұрыс.
Dialogue: 0,0:03:42.98,0:03:47.32,Default,,0,0,0,,Ертең сіздің жұмысыңызды басқа біреу алып кете ала ма?
Dialogue: 0,0:03:47.32,0:03:50.66,Default,,0,0,0,,Мм, поштадағы жігіттер де.
Dialogue: 0,0:03:50.66,0:03:55.00,Default,,0,0,0,,Бұл жақсы мүмкіндік, сондықтан мен анда-санда үзіліс жасаймын.
Dialogue: 0,0:03:55.00,0:03:59.33,Default,,0,0,0,,Менің ойымша, бұл қарт үшін жұмыстан гөрі қызық.
Dialogue: 0,0:03:59.33,0:04:03.61,Default,,0,0,0,,Неге екені белгісіз, демалуға шыдамаймын.
Dialogue: 0,0:04:03.61,0:04:05.94,Default,,0,0,0,,А, жоқ, қолыңнан келмесе, жарайды.
Dialogue: 0,0:04:05.94,0:04:09.95,Default,,0,0,0,,Кешіріңіз, мен сізден бір қызық нәрсе сұрауға келдім.
Dialogue: 0,0:04:09.95,0:04:14.62,Default,,0,0,0,,Хехе, Акари-чан, а... иә?
Dialogue: 0,0:04:14.62,0:04:17.62,Default,,0,0,0,,Кейде дербес тәжірибенің орнына
Dialogue: 0,0:04:17.62,0:04:21.29,Default,,0,0,0,,Әдеттегіден басқа біреуден нұсқау алу
Dialogue: 0,0:04:21.29,0:04:23.96,Default,,0,0,0,,Бұл дұрыс емес пе?
Dialogue: 0,0:04:23.96,0:04:27.30,Default,,0,0,0,,Мысалы, пошташы
Dialogue: 0,0:04:27.30,0:04:30.30,Default,,0,0,0,,Хохе? А, түсіндім
Dialogue: 0,0:04:30.30,0:04:34.97,Default,,0,0,0,,Егер мен сізбен тапсырыс берушінің орнына нұсқаушы ретінде жаттыға алсам...
Dialogue: 0,0:04:34.97,0:04:37.97,Default,,0,0,0,,Түсіндім, ханым, жаттығуға болады.
Dialogue: 0,0:04:37.97,0:04:42.64,Default,,0,0,0,,Ағай поштаны жинап, жеткізе алады, сондықтан ол бір оқпен екі құсты өлтіре алады.
Dialogue: 0,0:04:42.64,0:04:45.31,Default,,0,0,0,,Хахаха...! Хехе
Dialogue: 0,0:04:45.31,0:04:48.32,Default,,0,0,0,,Пуйпуи Пуиню Пуи Пуиню
Dialogue: 0,0:04:48.32,0:04:51.99,Default,,0,0,0,,Иә? Президент, сіз де барғыңыз келе ме? (Президент Ария) Пуи Пуи
Dialogue: 0,0:04:51.99,0:04:54.66,Default,,0,0,0,,Рахмет, Алисия.
Dialogue: 0,0:04:54.66,0:04:56.66,Default,,0,0,0,,Әй, хехехе
Dialogue: 0,0:04:56.66,0:04:58.66,Default,,0,0,0,,Хонжа, ертең кездескенше.
Dialogue: 0,0:04:58.66,0:05:01.26,Default,,0,0,0,,Иә, қош келдіңіз (Президент Ария) Пуи Пуи Пуиню
Dialogue: 0,0:05:01.26,0:05:06.60,Default,,0,0,0,,♬～
Dialogue: 0,0:05:06.60,0:05:10.61,Default,,0,0,0,,Каннарджио пошта бөлімшесі…
Dialogue: 0,0:05:10.61,0:05:14.61,Default,,0,0,0,,Міне, президент Ария.
Dialogue: 0,0:05:15.61,0:05:18.95,Default,,0,0,0,,Кешіріңіз! (Офицер) Иә.
Dialogue: 0,0:05:18.95,0:05:22.95,Default,,0,0,0,,Мен бүгін пошташыға көмектесуге келдім.
Dialogue: 0,0:05:22.95,0:05:24.95,Default,,0,0,0,,Пошташы?
Dialogue: 0,0:05:24.95,0:05:26.96,Default,,0,0,0,,Иә
Dialogue: 0,0:05:27.96,0:05:32.63,Default,,0,0,0,,А, мен түсіндім. Пошташылардың бәрі пошташы, солай ма?
Dialogue: 0,0:05:32.63,0:05:37.63,Default,,0,0,0,,Мм... ойланып қарасам, ағамның шын атын білмеймін.
Dialogue: 0,0:05:37.63,0:05:39.63,Default,,0,0,0,,О, кездейсоқ.
Dialogue: 0,0:05:39.63,0:05:42.64,Default,,0,0,0,,Бұл Undine, үлкендер жиі айтатын адам.
Dialogue: 0,0:05:42.64,0:05:46.31,Default,,0,0,0,,Ақсақал? Жүр, ішке кір.
Dialogue: 0,0:05:46.31,0:05:48.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:49.31,0:05:52.31,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:53.65,0:05:56.35,Default,,0,0,0,,Бұл әдемі ғимарат.
Dialogue: 0,0:06:01.26,0:06:03.59,Default,,0,0,0,,Сияның иісі бар.
Dialogue: 0,0:06:03.59,0:06:06.93,Default,,0,0,0,,Хахаха... Пошта ғой ғой.
Dialogue: 0,0:06:06.93,0:06:08.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:10.93,0:06:13.27,Default,,0,0,0,,Пуинью! Ах...
Dialogue: 0,0:06:13.27,0:06:17.61,Default,,0,0,0,,Әй, қыз, жарайсың, аға!
Dialogue: 0,0:06:17.61,0:06:19.61,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:06:19.61,0:06:21.61,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:21.61,0:06:24.28,Default,,0,0,0,,Кешіріңіз, таңертең ерте болды
Dialogue: 0,0:06:24.28,0:06:26.95,Default,,0,0,0,,Бүгінгі қолдауыңыз үшін рахмет.
Dialogue: 0,0:06:26.95,0:06:29.95,Default,,0,0,0,,Жоқ, жоқ, бұл.
Dialogue: 0,0:06:29.95,0:06:31.95,Default,,0,0,0,,Жаза...
Dialogue: 0,0:06:31.95,0:06:35.96,Default,,0,0,0,,Президент мырза, бүгін ағайдың бас киімін киесіз бе?
Dialogue: 0,0:06:35.96,0:06:38.66,Default,,0,0,0,,Пуи Пуи Пуиню!
Dialogue: 0,0:06:38.66,0:06:40.30,Default,,0,0,0,,А... жақсы.
Dialogue: 0,0:06:40.30,0:06:43.30,Default,,0,0,0,,Пу-и-и Пуи-и-и
Dialogue: 0,0:06:43.30,0:06:45.30,Default,,0,0,0,,Хэхехе ⚟
Dialogue: 0,0:06:45.30,0:06:48.30,Default,,0,0,0,,Әй, басталып жатыр, иә?
Dialogue: 0,0:06:48.30,0:06:50.64,Default,,0,0,0,,Таңертеңгілік жаттығулар.
Dialogue: 0,0:06:50.64,0:06:54.31,Default,,0,0,0,,Қарттар еңбегі – дене күшін сынау.
Dialogue: 0,0:06:54.31,0:06:56.65,Default,,0,0,0,,Бұл ұят болуы мүмкін, бірақ ол аз.
Dialogue: 0,0:06:56.65,0:06:58.65,Default,,0,0,0,,Бұл да ырым.
Dialogue: 0,0:06:58.65,0:07:01.92,Default,,0,0,0,,Өтінемін, менімен бірге болыңыз.
Dialogue: 0,0:07:01.92,0:07:05.25,Default,,0,0,0,,Пуйпу Пуи…
Dialogue: 0,0:07:12.59,0:07:15.00,Default,,0,0,0,,Пааа! (Президент Ария) Пуи
Dialogue: 0,0:07:16.60,0:07:19.94,Default,,0,0,0,,Эй, кеттік!
Dialogue: 0,0:07:19.94,0:07:21.94,Default,,0,0,0,,Хахи (Президент Ария) Пуи!
Dialogue: 0,0:07:21.94,0:07:30.61,Default,,0,0,0,,♬～
Dialogue: 0,0:07:30.61,0:07:34.28,Default,,0,0,0,,Пошташыны ақсақал деп атайды.
Dialogue: 0,0:07:34.28,0:07:37.29,Default,,0,0,0,,Оның жасы үлкен екенін білетінмін, бірақ бұл…
Dialogue: 0,0:07:37.29,0:07:42.29,Default,,0,0,0,,Бірақ кейбір жастар мені ``джи'' немесе ``ата» деп атайды.
Dialogue: 0,0:07:42.29,0:07:45.29,Default,,0,0,0,,Ахаха жарайды, ағай.
Dialogue: 0,0:07:45.29,0:07:48.60,Default,,0,0,0,,Ол жәй ғана пошташы.
Dialogue: 0,0:07:49.96,0:07:53.27,Default,,0,0,0,,Мен сонда барамын.
Dialogue: 0,0:07:54.64,0:07:56.97,Default,,0,0,0,,Хой, жақындат, жақындат
Dialogue: 0,0:07:56.97,0:07:58.97,Default,,0,0,0,,...
Dialogue: 0,0:08:03.91,0:08:06.51,Default,,0,0,0,,Уау... (Президент Ария) Пуи
Dialogue: 0,0:08:07.92,0:08:10.25,Default,,0,0,0,,Пу-а!
Dialogue: 0,0:08:10.25,0:08:12.59,Default,,0,0,0,,Пуиню…
Dialogue: 0,0:08:12.59,0:08:14.59,Default,,0,0,0,,Пуи!
Dialogue: 0,0:08:20.60,0:08:22.93,Default,,0,0,0,,О~ (Президент Ария) Пупупупу Пуинюу
Dialogue: 0,0:08:22.93,0:08:25.60,Default,,0,0,0,,Бұл әрқашан қолдың асқан шеберлігі.
Dialogue: 0,0:08:25.60,0:08:28.94,Default,,0,0,0,,Сіз де жасап көргіңіз келе ме, ханым?
Dialogue: 0,0:08:28.94,0:08:31.94,Default,,0,0,0,,О, жақсы ма?
Dialogue: 0,0:08:33.61,0:08:36.61,Default,,0,0,0,,Сіз осылай айттыңыз ба?
Dialogue: 0,0:08:36.61,0:08:39.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:39.61,0:08:42.95,Default,,0,0,0,,Сәлем! Әй, ура!
Dialogue: 0,0:08:42.95,0:08:45.62,Default,,0,0,0,,Фуи ноу...
Dialogue: 0,0:08:45.62,0:08:47.62,Default,,0,0,0,,(Спидвагон) Ол сөйледі! Демек, ол соңында бәрін түсінеді екен
Dialogue: 0,0:08:47.62,0:08:49.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:50.63,0:08:52.96,Default,,0,0,0,,Йо~
Dialogue: 0,0:08:52.96,0:08:55.63,Default,,0,0,0,,Ааа...хааа!
Dialogue: 0,0:08:55.63,0:08:59.30,Default,,0,0,0,,Ааа...!
Dialogue: 0,0:08:59.30,0:09:01.24,Default,,0,0,0,,Ах! Хахи
Dialogue: 0,0:09:01.24,0:09:03.24,Default,,0,0,0,,Қап…
Dialogue: 0,0:09:03.24,0:09:06.91,Default,,0,0,0,,Сусу Сусу... Кешіріңіз!
Dialogue: 0,0:09:06.91,0:09:09.21,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:09:13.92,0:09:17.59,Default,,0,0,0,,Хой қайтып оралады
Dialogue: 0,0:09:17.59,0:09:21.99,Default,,0,0,0,,Иә! Эй... иә
Dialogue: 0,0:09:24.26,0:09:26.59,Default,,0,0,0,,Хмм... (Қақпақ жабылған дыбыс)
Dialogue: 0,0:09:26.59,0:09:28.60,Default,,0,0,0,,Я...
Dialogue: 0,0:09:28.60,0:09:30.60,Default,,0,0,0,,Пуи…
Dialogue: 0,0:09:30.60,0:09:32.60,Default,,0,0,0,,Біз оны сәтті шығарып алдық!
Dialogue: 0,0:09:32.60,0:09:36.94,Default,,0,0,0,,Иә, бұл менің бірінші рет. Жақсы жұмыс. Жақсы жұмыс.
Dialogue: 0,0:09:36.94,0:09:38.94,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:38.94,0:09:42.28,Default,,0,0,0,,Жарайды, жайбарақат жүрсең, суды көресің
Dialogue: 0,0:09:42.28,0:09:44.28,Default,,0,0,0,,...
Dialogue: 0,0:09:44.28,0:09:48.95,Default,,0,0,0,,♬～
Dialogue: 0,0:10:00.96,0:10:03.63,Default,,0,0,0,,♬～
Dialogue: 0,0:10:03.63,0:10:06.30,Default,,0,0,0,,Уф~ Менің қарным ашты.
Dialogue: 0,0:10:06.30,0:10:10.97,Default,,0,0,0,,(Станция қызметкерлерінің сөйлеуі)
Dialogue: 0,0:10:10.97,0:10:13.64,Default,,0,0,0,,Эй, мені күте тұршы, а...
Dialogue: 0,0:10:13.64,0:10:16.31,Default,,0,0,0,,Сіз көп жұмыс істегендіктен, сіз аш болуыңыз керек.
Dialogue: 0,0:10:16.31,0:10:19.31,Default,,0,0,0,,Иә, түскі қорап үшін рахмет.
Dialogue: 0,0:10:19.31,0:10:21.32,Default,,0,0,0,,Пуи Пуиню
Dialogue: 0,0:10:23.32,0:10:25.99,Default,,0,0,0,,Итадакимасу (Президент Ария) Пуинью
Dialogue: 0,0:10:25.99,0:10:27.99,Default,,0,0,0,,Хой
Dialogue: 0,0:10:29.99,0:10:32.99,Default,,0,0,0,,Дәмді қуырылған жұмыртқа
Dialogue: 0,0:10:32.99,0:10:35.00,Default,,0,0,0,,Хокка
Dialogue: 0,0:10:35.00,0:10:37.00,Default,,0,0,0,,...
Dialogue: 0,0:10:37.00,0:10:41.00,Default,,0,0,0,,♬～
Dialogue: 0,0:10:41.00,0:10:43.34,Default,,0,0,0,,Пісіру...
Dialogue: 0,0:10:43.34,0:10:45.67,Default,,0,0,0,,Тағы бір рет көрейік
Dialogue: 0,0:10:45.67,0:10:49.01,Default,,0,0,0,,Түстен кейін жеткізу қызметі де бар.
Dialogue: 0,0:10:49.01,0:10:51.95,Default,,0,0,0,,Иә? Президент Ария?
Dialogue: 0,0:10:51.95,0:10:53.95,Default,,0,0,0,,Пуиню~
Dialogue: 0,0:10:53.95,0:10:56.28,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:10:56.28,0:10:59.29,Default,,0,0,0,,Пу-пуу-пуи (бос) Ууу уу
Dialogue: 0,0:10:59.29,0:11:01.62,Default,,0,0,0,,Не болды? президент
Dialogue: 0,0:11:01.62,0:11:03.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:03.96,0:11:05.96,Default,,0,0,0,,Сіз хат жібересіз бе?
Dialogue: 0,0:11:05.96,0:11:08.96,Default,,0,0,0,,Ах... хмм...
Dialogue: 0,0:11:08.96,0:11:10.97,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:10.97,0:11:14.97,Default,,0,0,0,,Мен бұл хатты дереу жеткізгім келеді.
Dialogue: 0,0:11:14.97,0:11:19.64,Default,,0,0,0,,Хмм, бүгінгі процедуралар аяқталды.
Dialogue: 0,0:11:19.64,0:11:22.31,Default,,0,0,0,,Ертең ертерек жеткізу.
Dialogue: 0,0:11:22.31,0:11:25.61,Default,,0,0,0,,Бұл уақытында болмайды, қазір болуы керек.
Dialogue: 0,0:11:26.98,0:11:31.32,Default,,0,0,0,,Баратын жер алыс па? (Аспан) Хмм...
Dialogue: 0,0:11:31.32,0:11:36.32,Default,,0,0,0,,Содан кейін оны тікелей пошта жәшігіне салу жылдамырақ болуы мүмкін.
Dialogue: 0,0:11:36.32,0:11:38.33,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:11:38.33,0:11:42.33,Default,,0,0,0,,Рәсім басталып кетті. Қандай рәсім?
Dialogue: 0,0:11:42.33,0:11:44.33,Default,,0,0,0,,Үйлену тойы
Dialogue: 0,0:11:44.33,0:11:47.34,Default,,0,0,0,,Үйлену тойы? Кімнің?
Dialogue: 0,0:11:47.34,0:11:51.94,Default,,0,0,0,,Мұғалім: Жарайды, бұл сізге құттықтау хат.
Dialogue: 0,0:11:51.94,0:11:53.94,Default,,0,0,0,,Қалыңдық?
Dialogue: 0,0:11:55.28,0:11:58.28,Default,,0,0,0,,Құттықтаулар жаздым.
Dialogue: 0,0:11:58.28,0:12:02.28,Default,,0,0,0,,Мен де жаздым кешіріңіз хаха?
Dialogue: 0,0:12:02.28,0:12:07.29,Default,,0,0,0,,Ұстазым мектептен кетер алдында хор байқауы болды.
Dialogue: 0,0:12:07.29,0:12:10.29,Default,,0,0,0,,Мен келмедім.
Dialogue: 0,0:12:10.29,0:12:14.63,Default,,0,0,0,,Хор байқауы кезінде музыка бөлмесінде болыңыз.
Dialogue: 0,0:12:14.63,0:12:16.97,Default,,0,0,0,,Мұғалім, мені ұятқа қалдыр...
Dialogue: 0,0:12:16.97,0:12:18.97,Default,,0,0,0,,Пуи
Dialogue: 0,0:12:18.97,0:12:21.30,Default,,0,0,0,,Қоштасу кешінде,
Dialogue: 0,0:12:21.30,0:12:25.64,Default,,0,0,0,,Мұғалім жоғалып кеткенде, оны кінәлайтынын айтты.
Dialogue: 0,0:12:25.64,0:12:29.98,Default,,0,0,0,,Мұғалімнің көз жасын бірінші рет көрдім...
Dialogue: 0,0:12:29.98,0:12:31.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:34.65,0:12:37.65,Default,,0,0,0,,...
Dialogue: 0,0:12:37.65,0:12:39.99,Default,,0,0,0,,Пуйпуи
Dialogue: 0,0:12:39.99,0:12:42.99,Default,,0,0,0,,Сол хатты маған қарызға бер. (бос) Иә?
Dialogue: 0,0:12:42.99,0:12:46.10,Default,,0,0,0,,Мен оны шіркеуге жеткіземін. Ах...
Dialogue: 0,0:12:46.10,0:12:50.60,Default,,0,0,0,,Бірақ сіз де менімен бірге келуіңіз керек. (Аспан) Мен де?
Dialogue: 0,0:12:50.60,0:12:54.60,Default,,0,0,0,,Ханым, жақсы ма? Иә, әрине
Dialogue: 0,0:12:59.27,0:13:03.61,Default,,0,0,0,,Бұл ARIA компаниясының Ундине Акари Мизунаши.
Dialogue: 0,0:13:03.61,0:13:05.61,Default,,0,0,0,,Мен тастап кеткен құралдар—
Dialogue: 0,0:13:05.61,0:13:09.62,Default,,0,0,0,,Сора Сора-кун, бұл жақсы есім.
Dialogue: 0,0:13:09.62,0:13:12.62,Default,,0,0,0,,Мистер, асығыңыз және орындаңыз (Президент Ария) Пуйпуи
Dialogue: 0,0:13:12.62,0:13:14.62,Default,,0,0,0,,...
Dialogue: 0,0:13:15.96,0:13:18.96,Default,,0,0,0,,Артқа есу Артқа есу?
Dialogue: 0,0:13:18.96,0:13:21.26,Default,,0,0,0,,Pupupuinyui
Dialogue: 0,0:13:22.96,0:13:26.30,Default,,0,0,0,,Погни! (Аспан) Жақсысың ба?
Dialogue: 0,0:13:26.30,0:13:28.30,Default,,0,0,0,,Иә (пошташы)
Dialogue: 0,0:13:28.30,0:13:30.97,Default,,0,0,0,,Дәл солай Иә.
Dialogue: 0,0:13:30.97,0:13:37.98,Default,,0,0,0,,♬～
Dialogue: 0,0:13:37.98,0:13:39.98,Default,,0,0,0,,Пу-пуи Пупуи
Dialogue: 0,0:13:39.98,0:13:42.28,Default,,0,0,0,,U.A. Спорттық күні тез арада келіп жетті
Dialogue: 0,0:13:43.32,0:13:48.32,Default,,0,0,0,,(шіркеу қоңырауы)
Dialogue: 0,0:13:51.93,0:13:54.26,Default,,0,0,0,,Сіз мұны уақытында жасаған сияқтысыз.
Dialogue: 0,0:13:54.26,0:13:56.93,Default,,0,0,0,,Иә, еңбегіңіз үшін рахмет.
Dialogue: 0,0:13:56.93,0:13:58.93,Default,,0,0,0,,Йоккора Шотто
Dialogue: 0,0:13:58.93,0:14:01.94,Default,,0,0,0,,Шынымен, мен оны сізге жеткіземін (бос) Иә.
Dialogue: 0,0:14:01.94,0:14:06.94,Default,,0,0,0,,(Адамдардың бата беру дауыстары)
Dialogue: 0,0:14:06.94,0:14:09.94,Default,,0,0,0,,Құттықтаймыз Аяно (Аяно) Рахмет
Dialogue: 0,0:14:09.94,0:14:12.95,Default,,0,0,0,,Сәттілік Аяно-чан (Аяно) Рахмет
Dialogue: 0,0:14:13.95,0:14:16.62,Default,,0,0,0,,Рахмет (бала) мұғалім, құттықтаймыз
Dialogue: 0,0:14:16.62,0:14:18.62,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:18.62,0:14:26.96,Default,,0,0,0,,♬～
Dialogue: 0,0:14:26.96,0:14:29.63,Default,,0,0,0,,Құттықтаймыз, Аяно Сенсей
Dialogue: 0,0:14:29.63,0:14:33.03,Default,,0,0,0,,үшінңызға рахмет, хехе...
Dialogue: 0,0:14:35.30,0:14:37.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:37.31,0:14:40.98,Default,,0,0,0,,Пошта (Аяно) Маған?
Dialogue: 0,0:14:40.98,0:14:43.31,Default,,0,0,0,,Жіберуші – Сора-кун.
Dialogue: 0,0:14:43.31,0:14:45.31,Default,,0,0,0,,А...
Dialogue: 0,0:14:45.31,0:14:47.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:47.32,0:14:54.92,Default,,0,0,0,,♬～
Dialogue: 0,0:14:54.92,0:14:59.26,Default,,0,0,0,,«Ұстаз, сізді үнемі мазалағаным үшін кешіріңіз».
Dialogue: 0,0:14:59.26,0:15:03.60,Default,,0,0,0,,«Қоштасу кешінде қорқынышты бірдеңе айтқаным үшін кешірім сұраймын».
Dialogue: 0,0:15:03.60,0:15:07.60,Default,,0,0,0,,«Өтірік айтып, сені кінәлаймын деп айтқаным үшін кешірім сұраймын».
Dialogue: 0,0:15:07.60,0:15:12.27,Default,,0,0,0,,«Шынында мен сізді жақсы көремін, мұғалім».
Dialogue: 0,0:15:12.27,0:15:16.94,Default,,0,0,0,,«Қоштасуды ойласам мұңаямын➡
Dialogue: 0,0:15:16.94,0:15:21.25,Default,,0,0,0,,Мен сізді құттықтай алмағаным үшін кешіріңіз.
Dialogue: 0,0:15:22.28,0:15:24.95,Default,,0,0,0,,«Үйленуіңіз құтты болсын, ұстаз».
Dialogue: 0,0:15:24.95,0:15:28.29,Default,,0,0,0,,«Бақытты бол, Сора».
Dialogue: 0,0:15:28.29,0:15:30.29,Default,,0,0,0,,Сора-кун…
Dialogue: 0,0:15:32.29,0:15:34.63,Default,,0,0,0,,Пошташы!
Dialogue: 0,0:15:34.63,0:15:37.33,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:15:38.30,0:15:40.30,Default,,0,0,0,,О
Dialogue: 0,0:15:40.30,0:15:46.31,Default,,0,0,0,,♬～
Dialogue: 0,0:15:46.31,0:15:49.61,Default,,0,0,0,,Ах... (Пошташы) Жеткізу аяқталды.
Dialogue: 0,0:15:50.58,0:15:52.91,Default,,0,0,0,,Мұғалім қуанып қалды.
Dialogue: 0,0:15:52.91,0:15:56.92,Default,,0,0,0,,Шынымен бе? (Пошташы) О, бұл жақсы.
Dialogue: 0,0:15:56.92,0:15:59.92,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:16:00.92,0:16:03.52,Default,,0,0,0,,Пуиню! Ах...
Dialogue: 0,0:16:05.26,0:16:07.26,Default,,0,0,0,,​​О?
Dialogue: 0,0:16:07.26,0:16:23.61,Default,,0,0,0,,♬～
Dialogue: 0,0:16:23.61,0:16:25.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:27.28,0:16:29.28,Default,,0,0,0,,А... кеттік.
Dialogue: 0,0:16:29.28,0:16:31.62,Default,,0,0,0,,Пуи Пуиню
Dialogue: 0,0:16:31.62,0:16:34.62,Default,,0,0,0,,Сора-кунның шынайы мейірімділігі
Dialogue: 0,0:16:34.62,0:16:38.63,Default,,0,0,0,,Хаттың әр әрпінен жеткізілетін сияқты.
Dialogue: 0,0:16:38.63,0:16:41.63,Default,,0,0,0,,Сора-кун үшін бұл оның қолынан келетін ең жақсысы.
Dialogue: 0,0:16:41.63,0:16:44.97,Default,,0,0,0,,Бұл мереке болуы керек (Аяно) Иә.
Dialogue: 0,0:16:44.97,0:16:49.97,Default,,0,0,0,,Мен ол балаға жақсы мұғалім болдым ба?
Dialogue: 0,0:16:52.57,0:16:55.91,Default,,0,0,0,,Мм... (Айка) Ммм?
Dialogue: 0,0:16:55.91,0:16:59.91,Default,,0,0,0,,Солай сияқты, иә?
Dialogue: 0,0:16:59.91,0:17:01.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:04.25,0:17:06.25,Default,,0,0,0,,Сора-кун
Dialogue: 0,0:17:06.25,0:17:11.93,Default,,0,0,0,,♬～
Dialogue: 0,0:17:11.93,0:17:13.93,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:17:13.93,0:17:17.27,Default,,0,0,0,,Сора-кун, хат үшін рахмет
Dialogue: 0,0:17:17.27,0:17:19.60,Default,,0,0,0,,Мен өте қуаныштымын.
Dialogue: 0,0:17:19.60,0:17:22.60,Default,,0,0,0,,Жауап бер Мен жазамын!
Dialogue: 0,0:17:22.60,0:17:25.27,Default,,0,0,0,,Құттықтаймыз, ұстаз
Dialogue: 0,0:17:25.27,0:17:27.28,Default,,0,0,0,,Жоқ… Оларды Эрен өлтірді!!
Dialogue: 0,0:17:27.28,0:17:29.94,Default,,0,0,0,,Қош бол!
Dialogue: 0,0:17:29.94,0:17:42.29,Default,,0,0,0,,♬～
Dialogue: 0,0:17:42.29,0:17:45.96,Default,,0,0,0,,♬～
Dialogue: 0,0:17:45.96,0:17:50.57,Default,,0,0,0,,Сізге көп рахмет. Көріскенше, Сора-кун.
Dialogue: 0,0:17:50.57,0:17:53.90,Default,,0,0,0,,Пошташыға да рахмет.
Dialogue: 0,0:17:53.90,0:17:55.90,Default,,0,0,0,,Сол жексұрын Зекро — осылайша кетіп қалды ма?
Dialogue: 0,0:17:55.90,0:18:02.91,Default,,0,0,0,,♬～
Dialogue: 0,0:18:02.91,0:18:04.91,Default,,0,0,0,,Сен екеуің алда барыңдар!
Dialogue: 0,0:18:07.92,0:18:10.25,Default,,0,0,0,,Енді поштаның қалған бөлігі.
Dialogue: 0,0:18:10.25,0:18:12.59,Default,,0,0,0,,Мен оны жеткізуім керек.
Dialogue: 0,0:18:12.59,0:18:14.59,Default,,0,0,0,,Иә
Dialogue: 0,0:18:14.59,0:18:21.60,Default,,0,0,0,,♬～
Dialogue: 0,0:18:21.60,0:18:24.60,Default,,0,0,0,,Күшік күшік... (пошташы) О...
Dialogue: 0,0:18:24.60,0:18:38.28,Default,,0,0,0,,♬～
Dialogue: 0,0:18:38.28,0:18:41.62,Default,,0,0,0,,Га, соңғы жеткізу аяқталды
Dialogue: 0,0:18:41.62,0:18:43.62,Default,,0,0,0,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,0:18:43.62,0:18:46.32,Default,,0,0,0,,Рахмет, ханым
Dialogue: 0,0:18:50.22,0:18:54.56,Default,,0,0,0,,Келін бақытты көрінді.
Dialogue: 0,0:18:54.56,0:18:57.57,Default,,0,0,0,,Сора-кун да (Пошташы) Ах
Dialogue: 0,0:18:57.57,0:19:00.23,Default,,0,0,0,,Мен үзіліс жасай алмаймын, өйткені бұл босқа.
Dialogue: 0,0:19:00.23,0:19:03.90,Default,,0,0,0,,Пошташының сезімін аздап түсінгендей болдым.
Dialogue: 0,0:19:03.90,0:19:05.91,Default,,0,0,0,,Хокка
Dialogue: 0,0:19:05.91,0:19:08.58,Default,,0,0,0,,Бұл сауапты жұмыс, солай емес пе?
Dialogue: 0,0:19:08.58,0:19:10.91,Default,,0,0,0,,Пуйпуи иә иә
Dialogue: 0,0:19:10.91,0:19:15.58,Default,,0,0,0,,Бүгін жан-жағыма қарап отырып, тағы бір нәрсені байқадым.
Dialogue: 0,0:19:15.58,0:19:19.25,Default,,0,0,0,,Нео Венецияда көптеген хабарламалар бар.
Dialogue: 0,0:19:19.25,0:19:21.92,Default,,0,0,0,,Иә, осы қаланың адамдары
Dialogue: 0,0:19:21.92,0:19:24.59,Default,,0,0,0,,Мен әлі күнге дейін әріптерге құмармын.
Dialogue: 0,0:19:24.59,0:19:27.60,Default,,0,0,0,,Олар қиындық тудыратын істермен айналысқысы келеді.
Dialogue: 0,0:19:27.60,0:19:29.93,Default,,0,0,0,,Бұл мүлдем ыңғайсыз емес.
Dialogue: 0,0:19:29.93,0:19:34.60,Default,,0,0,0,,Хехе... Бұл рас. Неліктен?
Dialogue: 0,0:19:34.60,0:19:39.94,Default,,0,0,0,,Көп асықсаң, жүрегің жете алмағандықтан болар.
Dialogue: 0,0:19:39.94,0:19:41.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:41.94,0:19:45.61,Default,,0,0,0,,Хат келгенде өзімді бақытты сезінемін.
Dialogue: 0,0:19:45.61,0:19:48.95,Default,,0,0,0,,Қазына сандығын ашқанда оған қара.
Dialogue: 0,0:19:48.95,0:19:52.29,Default,,0,0,0,,Жүрегім баладай болып, толқып кетемін
Dialogue: 0,0:19:52.29,0:19:56.29,Default,,0,0,0,,Сонымен ішіндегі нәрсе әріпке ұқсайды.
Dialogue: 0,0:19:56.29,0:19:58.96,Default,,0,0,0,,Бұл басқа адамның жүрегі.
Dialogue: 0,0:19:58.96,0:20:00.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:00.96,0:20:06.30,Default,,0,0,0,,Мазмұнына қарай қазынаға айналуы мүмкін.
Dialogue: 0,0:20:06.30,0:20:12.31,Default,,0,0,0,,Жүрек – өмір бойы ұстайтын асыл қазына.
Dialogue: 0,0:20:13.64,0:20:17.34,Default,,0,0,0,,Сезуге болатын жүрек...
Dialogue: 0,0:20:18.31,0:20:22.65,Default,,0,0,0,,Сондай-ақ әріптер уақыт пен орыннан асып түседі.
Dialogue: 0,0:20:22.65,0:20:26.65,Default,,0,0,0,,Жазған адамды әкеле аласыз ба деп ойлаймын.
Dialogue: 0,0:20:26.65,0:20:28.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:31.99,0:20:33.99,Default,,0,0,0,,Пуи~
Dialogue: 0,0:20:37.67,0:20:41.34,Default,,0,0,0,,Нео-Венеция да әріпке ұқсайды, солай емес пе?
Dialogue: 0,0:20:41.34,0:20:45.34,Default,,0,0,0,,Иә? Бұл қаланы салған адамдардың жүрегінде
Dialogue: 0,0:20:45.34,0:20:48.68,Default,,0,0,0,,Оны кез келген уақытта түртуге болады.
Dialogue: 0,0:20:48.68,0:20:51.61,Default,,0,0,0,,Хмм, дұрыс.
Dialogue: 0,0:20:51.61,0:20:53.61,Default,,0,0,0,,Мен...
Dialogue: 0,0:20:54.62,0:20:58.29,Default,,0,0,0,,Бұл қала қиындық тудырғысы келеді.
Dialogue: 0,0:20:58.29,0:21:01.29,Default,,0,0,0,,Ол сені қатты жақсы көретін сияқты.
Dialogue: 0,0:21:01.29,0:21:05.29,Default,,0,0,0,,Хокка... Мис-чан да толық
Dialogue: 0,0:21:05.29,0:21:08.30,Default,,0,0,0,,Нео-венециялық түстермен боялған.
Dialogue: 0,0:21:08.30,0:21:10.30,Default,,0,0,0,,...
Dialogue: 0,0:21:15.97,0:21:17.97,Default,,0,0,0,,Күшік күшік...
Dialogue: 0,0:21:18.97,0:21:23.31,Default,,0,0,0,,Қайырлы таң Қайырлы таң Акари-чан
Dialogue: 0,0:21:23.31,0:21:25.98,Default,,0,0,0,,Тәу... Мияу?
Dialogue: 0,0:21:25.98,0:21:28.28,Default,,0,0,0,,Пуи Пуиню?
Dialogue: 0,0:21:29.65,0:21:32.32,Default,,0,0,0,,Ах, Алисия, мынау...
Dialogue: 0,0:21:32.32,0:21:36.99,Default,,0,0,0,,Ах, бүгін таңертең алған хатым Акари-чанға жазылған.
Dialogue: 0,0:21:36.99,0:21:40.10,Default,,0,0,0,,Аа, пошташыдан...
Dialogue: 0,0:21:43.33,0:21:46.67,Default,,0,0,0,,«Құрметті ханым, кешегі күн үшін рахмет➡
Dialogue: 0,0:21:46.67,0:21:49.34,Default,,0,0,0,,Пошташыдан».
Dialogue: 0,0:21:49.34,0:21:51.64,Default,,0,0,0,,Хехе...
Dialogue: 0,0:21:53.61,0:21:55.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:55.61,0:21:57.95,Default,,0,0,0,,Пошташының дәл айтқаны.
Dialogue: 0,0:21:57.95,0:22:01.55,Default,,0,0,0,,Хат жазған адамды қайтарады, солай ма?
Dialogue: 0,0:22:02.62,0:22:06.29,Default,,0,0,0,,<Ай-чан, ол әріп қысқа болса да➡
Dialogue: 0,0:22:06.29,0:22:09.29,Default,,0,0,0,,Ескі сия сондай жылы➡
Dialogue: 0,0:22:09.29,0:22:13.59,Default,,0,0,0,,Пошташының темекісінің иісі шамалы еді＞
Dialogue: 0,0:22:14.63,0:22:19.30,Default,,0,0,0,,<Акари-сан, сенің тағы бір қазынаң бар>
Dialogue: 0,0:22:19.30,0:22:23.64,Default,,0,0,0,,<Хат... ойланып қарасам, ешқашан жазған емеспін>
Dialogue: 0,0:22:23.64,0:22:25.97,Default,,0,0,0,,<Мүмкін келесі жолы жазуым керек>
Dialogue: 0,0:22:25.97,0:22:28.64,Default,,0,0,0,,<Онда мен де нео-Венеция түсіне ауысамын➡
Dialogue: 0,0:22:28.64,0:22:30.98,Default,,0,0,0,,Мен жақындай аламын ба? ＞
Dialogue: 0,0:22:30.98,0:22:50.93,Default,,0,0,0,,♬～
Dialogue: 0,0:22:50.93,0:23:10.95,Default,,0,0,0,,♬～
