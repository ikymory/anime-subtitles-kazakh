Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.97,0:00:07.64,Default,,0,0,0,,<Ай-чан, жаздың қатал күні➡
Dialogue: 0,0:00:07.64,0:00:10.64,Default,,0,0,0,,Ол әлдеқайда жұмсақ болды>
Dialogue: 0,0:00:10.64,0:00:14.64,Default,,0,0,0,,<Бірақ күзгі туристік маусым басталғалы жатыр>
Dialogue: 0,0:00:14.64,0:00:16.65,Default,,0,0,0,,<Бүгін біздің үйлену тойымыз➡
Dialogue: 0,0:00:16.65,0:00:20.65,Default,,0,0,0,,Нео Венецияда қарсы алған жұп біздің қонақтарымыз.
Dialogue: 0,0:00:20.65,0:00:22.65,Default,,0,0,0,,<Оны асыға күтеміз~! ＞
Dialogue: 0,0:00:22.65,0:00:25.65,Default,,0,0,0,,Пуи Пупуи
Dialogue: 0,0:00:25.65,0:00:28.66,Default,,0,0,0,,Пуи~ Пуича! Пуи
Dialogue: 0,0:00:28.66,0:00:33.33,Default,,0,0,0,,Хехе... Дайындық жақсы, президент Ария.
Dialogue: 0,0:00:33.33,0:00:36.33,Default,,0,0,0,,Пуиню ⚟(Әже) Кешіріңіз.
Dialogue: 0,0:00:36.33,0:00:38.67,Default,,0,0,0,,А... иә!
Dialogue: 0,0:00:38.67,0:00:41.34,Default,,0,0,0,,Сіз осында жүрген сияқтысыз, президент Ария.
Dialogue: 0,0:00:41.34,0:00:43.34,Default,,0,0,0,,Пуинюпуи
Dialogue: 0,0:00:48.34,0:00:50.35,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:00:50.35,0:00:53.35,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:00:53.35,0:00:56.02,Default,,0,0,0,,А... Сәлеметсіз бе.
Dialogue: 0,0:00:56.02,0:00:58.62,Default,,0,0,0,,Нео Венецияға қош келдіңіз
Dialogue: 0,0:01:00.29,0:01:02.62,Default,,0,0,0,,ARIA компаниясына қош келдіңіз
Dialogue: 0,0:01:02.62,0:01:06.63,Default,,0,0,0,,Менің атым Алисия Флоренс.
Dialogue: 0,0:01:06.63,0:01:09.33,Default,,0,0,0,,Бес бос дәптер парағы
Dialogue: 0,0:01:10.30,0:01:13.97,Default,,0,0,0,,Бұл жақсы гондола, қымбаттым.
Dialogue: 0,0:01:13.97,0:01:17.97,Default,,0,0,0,,Хмм, рахмет.
Dialogue: 0,0:01:17.97,0:01:21.31,Default,,0,0,0,,Өтінемін (Әже) О, рахмет.
Dialogue: 0,0:01:21.31,0:01:23.98,Default,,0,0,0,,Пуиню Пуиню~!
Dialogue: 0,0:01:23.98,0:01:44.00,Default,,0,0,0,,♬～
Dialogue: 0,0:01:44.00,0:02:03.95,Default,,0,0,0,,♬～
Dialogue: 0,0:02:03.95,0:02:23.97,Default,,0,0,0,,♬～
Dialogue: 0,0:02:23.97,0:02:43.99,Default,,0,0,0,,♬～
Dialogue: 0,0:02:43.99,0:02:55.30,Default,,0,0,0,,♬～
Dialogue: 0,0:03:01.94,0:03:04.61,Default,,0,0,0,,Түскі ас ішкенде
Dialogue: 0,0:03:04.61,0:03:08.28,Default,,0,0,0,,Сан-Марко алаңына барайық.
Dialogue: 0,0:03:08.28,0:03:11.29,Default,,0,0,0,,Биылғы маусымда ашық кафеде шай
Dialogue: 0,0:03:11.29,0:03:14.59,Default,,0,0,0,,Бұл өте жақсы сезінеді және мен оны ұсынамын.
Dialogue: 0,0:03:15.62,0:03:17.96,Default,,0,0,0,,Сіз жалғыз баруыңыз керек.
Dialogue: 0,0:03:17.96,0:03:20.63,Default,,0,0,0,,Мен қонақүйде демалып жатырмын.
Dialogue: 0,0:03:20.63,0:03:22.96,Default,,0,0,0,,Ах... (Әже) Ухухуфу
Dialogue: 0,0:03:22.96,0:03:25.97,Default,,0,0,0,,Олай болса, мен сізге рұқсат етемін деп ойлаймын.
Dialogue: 0,0:03:25.97,0:03:28.30,Default,,0,0,0,,Мм... (Әже) Уууу.
Dialogue: 0,0:03:28.30,0:03:30.97,Default,,0,0,0,,Жаңа жерді жалғыз зерттейсіз бе?
Dialogue: 0,0:03:30.97,0:03:33.31,Default,,0,0,0,,Менің жүрегім дүрсілдеп тұр
Dialogue: 0,0:03:33.31,0:03:35.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:35.31,0:03:38.98,Default,,0,0,0,,Біз келісілген пирсте сағат 5-те кездесеміз.
Dialogue: 0,0:03:38.98,0:03:42.65,Default,,0,0,0,,Кеш қалмаңыз (кемпір) Иә.
Dialogue: 0,0:03:42.65,0:03:44.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:46.32,0:03:48.32,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:03:48.32,0:04:08.28,Default,,0,0,0,,♬～
Dialogue: 0,0:04:08.28,0:04:23.96,Default,,0,0,0,,♬～
Dialogue: 0,0:04:23.96,0:04:27.96,Default,,0,0,0,,Енді сіздің қызметіңізді суретке түсіруге рұқсат етіңіз.
Dialogue: 0,0:04:27.96,0:04:31.63,Default,,0,0,0,,Пупуиню~ (Әже) Жарайды, мен бақыттымын.
Dialogue: 0,0:04:31.63,0:04:35.30,Default,,0,0,0,,Ой, галстугың қисық екен.
Dialogue: 0,0:04:35.30,0:04:37.97,Default,,0,0,0,,Оны көпшілік алдында жасамаңыз.
Dialogue: 0,0:04:37.97,0:04:40.64,Default,,0,0,0,,Иә әдемі
Dialogue: 0,0:04:40.64,0:04:43.98,Default,,0,0,0,,Олай болса суретке түсейік~
Dialogue: 0,0:04:43.98,0:04:47.28,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:04:48.65,0:04:50.65,Default,,0,0,0,,Е...
Dialogue: 0,0:04:51.99,0:04:54.32,Default,,0,0,0,,Хохе?
Dialogue: 0,0:04:54.32,0:04:58.66,Default,,0,0,0,,Не болды? Акари-чан Ах, жоқ... Мен келемін.
Dialogue: 0,0:04:58.66,0:05:00.60,Default,,0,0,0,,Онда не көріп тұрсың?
Dialogue: 0,0:05:00.60,0:05:03.93,Default,,0,0,0,,Кампанил! (ысырма дыбысы)
Dialogue: 0,0:05:03.93,0:05:10.94,Default,,0,0,0,,♬～
Dialogue: 0,0:05:10.94,0:05:14.94,Default,,0,0,0,,Әй, бұл қиын қарт сияқты.
Dialogue: 0,0:05:14.94,0:05:17.61,Default,,0,0,0,,Мен ол кемпірді құрметтеймін.
Dialogue: 0,0:05:17.61,0:05:21.95,Default,,0,0,0,,Мен мұндай адаммен ұзақ уақыт жұмыс істей алдым.
Dialogue: 0,0:05:21.95,0:05:26.96,Default,,0,0,0,,Бірақ... сенің құлағың қызарып кетті ғой, солай ма? (Алиса/Айка) Құлақтар?
Dialogue: 0,0:05:26.96,0:05:29.26,Default,,0,0,0,,⚟(Ата) Бұл басқа әңгіме! (Алиса/Айка) Ах.
Dialogue: 0,0:05:30.29,0:05:33.63,Default,,0,0,0,,Атаның дауысы (Президент Ария) Пупуй?
Dialogue: 0,0:05:33.63,0:05:37.97,Default,,0,0,0,,Бұл мүмкін емес пе, әлде сұмдық па? Клиенттер туралы не ойлайсыз?
Dialogue: 0,0:05:37.97,0:05:41.64,Default,,0,0,0,,Кешіріңіз, мен соншалықты алыс ойламадым.
Dialogue: 0,0:05:41.64,0:05:44.31,Default,,0,0,0,,Өзіңізді алдамаңыз! Мен мұны басынан бері айтып келемін...
Dialogue: 0,0:05:44.31,0:05:47.31,Default,,0,0,0,,Мм... не болды?
Dialogue: 0,0:05:47.31,0:05:50.31,Default,,0,0,0,,Маңызды болмаса да ештеңе айтпа!
Dialogue: 0,0:05:50.31,0:05:53.01,Default,,0,0,0,,Жетеді, бас тарт!
Dialogue: 0,0:05:56.32,0:06:00.59,Default,,0,0,0,,Қандай ұят... Не болды?
Dialogue: 0,0:06:00.59,0:06:04.93,Default,,0,0,0,,О, маған қоңырау шалды, олар гондолаға тапсырыс бергісі келеді.
Dialogue: 0,0:06:04.93,0:06:08.60,Default,,0,0,0,,Мен дайындалдым, бірақ...
Dialogue: 0,0:06:08.60,0:06:13.60,Default,,0,0,0,,Бұл емес. Бұл теңізбен үйлену үшін қолданылатын гондола дейді.
Dialogue: 0,0:06:13.60,0:06:16.61,Default,,0,0,0,,Ех! Бұл ақылсыз
Dialogue: 0,0:06:16.61,0:06:18.94,Default,,0,0,0,,Иә Иә
Dialogue: 0,0:06:18.94,0:06:22.24,Default,,0,0,0,,Теңізбен той...
Dialogue: 0,0:06:23.95,0:06:26.62,Default,,0,0,0,,Бастапқыда Манхомның Венеция-тен
Dialogue: 0,0:06:26.62,0:06:28.95,Default,,0,0,0,,Қалыптасқан мереке ғой, солай емес пе?
Dialogue: 0,0:06:28.95,0:06:31.95,Default,,0,0,0,,Иә, теңіз бен қалада тыныштық болсын деп дұға ет.
Dialogue: 0,0:06:31.95,0:06:35.29,Default,,0,0,0,,Губернатор Додж теңізге сақина түсіреді.
Dialogue: 0,0:06:35.29,0:06:39.63,Default,,0,0,0,,Додж дәл қазір мұнда болмағандықтан, мэрдің рөлі...
Dialogue: 0,0:06:39.63,0:06:42.63,Default,,0,0,0,,Нео-Венецияда теңіз мәңгі
Dialogue: 0,0:06:42.63,0:06:47.64,Default,,0,0,0,,Аква менің құшағымда жүре берсе екен деп тілеймін.
Dialogue: 0,0:06:48.64,0:06:50.97,Default,,0,0,0,,Хмм, жақсы
Dialogue: 0,0:06:50.97,0:06:53.31,Default,,0,0,0,,Теңіз бен судың мәңгілік анты
Dialogue: 0,0:06:53.31,0:06:57.65,Default,,0,0,0,,Ол терең теңіз түбінде жарқырап тұр.
Dialogue: 0,0:06:57.65,0:07:01.25,Default,,0,0,0,,Ұятсыз жолдар жоқ! Иә~
Dialogue: 0,0:07:01.25,0:07:04.25,Default,,0,0,0,,Ол үшін қолданылатыны бучинторо деп аталады.
Dialogue: 0,0:07:04.25,0:07:09.26,Default,,0,0,0,,Бұл арнайы қайық, сондықтан жеке адамның оны жалға алуға мүмкіндігі жоқ.
Dialogue: 0,0:07:09.26,0:07:11.59,Default,,0,0,0,,Сіз өзімшіл адамсыз.
Dialogue: 0,0:07:11.59,0:07:14.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:18.27,0:07:20.27,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:20.27,0:07:22.94,Default,,0,0,0,,Жоқ, жоқ, бұл туралы алаңдамаңыз.
Dialogue: 0,0:07:22.94,0:07:24.94,Default,,0,0,0,,Олай болса
Dialogue: 0,0:07:27.94,0:07:30.95,Default,,0,0,0,,Иә? Ах, мм...
Dialogue: 0,0:07:30.95,0:07:33.95,Default,,0,0,0,,Біз тағы кездестік.
Dialogue: 0,0:07:33.95,0:07:35.95,Default,,0,0,0,,Хун
Dialogue: 0,0:07:38.95,0:07:40.96,Default,,0,0,0,,(Night Eye) Мен ойлағандай, «үшін Бір» шын мәнінде Миллиоға берілуі керек еді.
Dialogue: 0,0:07:40.96,0:07:45.29,Default,,0,0,0,,Қазіргі адамдар қалалық музыкалық топтар сияқты, солай емес пе?
Dialogue: 0,0:07:45.29,0:07:47.96,Default,,0,0,0,,Мен әрқашан шаршы алаңда жаттығу жасаймын.
Dialogue: 0,0:07:47.96,0:07:50.63,Default,,0,0,0,,Гондола және музыка…
Dialogue: 0,0:07:50.63,0:07:55.34,Default,,0,0,0,,Өз тойымды теңізбен өткіземін деп ойламаппын! О, құдайым
Dialogue: 0,0:07:56.64,0:07:58.64,Default,,0,0,0,,А... А?
Dialogue: 0,0:07:59.64,0:08:02.24,Default,,0,0,0,,Бұл үлкен және ашық қызыл.
Dialogue: 0,0:08:02.24,0:08:04.91,Default,,0,0,0,,Мүмкін Зусей...?
Dialogue: 0,0:08:04.91,0:08:07.58,Default,,0,0,0,,Пупуиню?
Dialogue: 0,0:08:07.58,0:08:09.92,Default,,0,0,0,,Угааах~!
Dialogue: 0,0:08:09.92,0:08:13.25,Default,,0,0,0,,Ол оны көргісі келетінін айтты.
Dialogue: 0,0:08:13.25,0:08:18.26,Default,,0,0,0,,Ха... Мен үйренбеген іспен айналыспауым керек сияқты.
Dialogue: 0,0:08:18.26,0:08:22.26,Default,,0,0,0,,Жұмыс Мен адамдарды кейде жұмысқа сапарға шығарып салатынмын.
Dialogue: 0,0:08:22.26,0:08:24.93,Default,,0,0,0,,Өйткені олардың ешқайсысы жоқ еді
Dialogue: 0,0:08:24.93,0:08:28.60,Default,,0,0,0,,Ең болмаса осы сапарда тілегімді орындағым келеді.
Dialogue: 0,0:08:28.60,0:08:31.31,Default,,0,0,0,,Мен солай ойладым.
Dialogue: 0,0:08:35.94,0:08:40.28,Default,,0,0,0,,Қаласаңыз, менің гондоламды пайдалана аласыз!
Dialogue: 0,0:08:40.28,0:08:42.95,Default,,0,0,0,,Не? Тіпті кішкентай гондола
Dialogue: 0,0:08:42.95,0:08:47.29,Default,,0,0,0,,Оны безендірсеңіз...
Dialogue: 0,0:08:47.29,0:08:51.63,Default,,0,0,0,,Иә, бұл жақсы көрінеді деп ойлаймын.
Dialogue: 0,0:08:51.63,0:08:53.96,Default,,0,0,0,,Жоқ... жеткілікті.
Dialogue: 0,0:08:53.96,0:08:56.97,Default,,0,0,0,,Мүлдем жақсы емес! иә?
Dialogue: 0,0:08:56.97,0:09:00.57,Default,,0,0,0,,Неліктен? А, бұл...
Dialogue: 0,0:09:00.57,0:09:03.57,Default,,0,0,0,,Мм... иә
Dialogue: 0,0:09:03.57,0:09:06.24,Default,,0,0,0,,Нео-Венеция туралы айтқым келгені осы.
Dialogue: 0,0:09:06.24,0:09:08.91,Default,,0,0,0,,Себебі мен сені жақсы көремін, иә?
Dialogue: 0,0:09:08.91,0:09:12.58,Default,,0,0,0,,Біз тұтынушыларымызға да Neo Venice ұнағанын қалаймыз.
Dialogue: 0,0:09:12.58,0:09:15.58,Default,,0,0,0,,Керемет естеліктер қалдырғаныңызды қалаймын.
Dialogue: 0,0:09:15.58,0:09:17.59,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:09:17.59,0:09:24.26,Default,,0,0,0,,♬～
Dialogue: 0,0:09:24.26,0:09:26.26,Default,,0,0,0,,Фу…
Dialogue: 0,0:09:26.26,0:09:33.94,Default,,0,0,0,,♬～
Dialogue: 0,0:09:33.94,0:09:36.27,Default,,0,0,0,,Рахмет, Айка-чан, Алиса-чан
Dialogue: 0,0:09:36.27,0:09:38.27,Default,,0,0,0,,Маған көмектескеніңіз үшін рахмет
Dialogue: 0,0:09:38.27,0:09:41.61,Default,,0,0,0,,Иә? Тек бос уақытым болды
Dialogue: 0,0:09:41.61,0:09:44.28,Default,,0,0,0,,Бірдей диагональ бойынша оңға қарай
Dialogue: 0,0:09:44.28,0:09:48.62,Default,,0,0,0,,О, бұл жақсы. Сіз гондоланы киіндіріп жатырсыз ба?
Dialogue: 0,0:09:48.62,0:09:50.95,Default,,0,0,0,,Ах, Алисия.
Dialogue: 0,0:09:50.95,0:09:54.62,Default,,0,0,0,,Фуфуфу (Президент Ария) Пупупуи
Dialogue: 0,0:09:54.62,0:09:57.96,Default,,0,0,0,,Пу~ Пуи Пупуи...
Dialogue: 0,0:09:57.96,0:10:02.30,Default,,0,0,0,,...
Dialogue: 0,0:10:02.30,0:10:04.63,Default,,0,0,0,,Пуппуи
Dialogue: 0,0:10:04.63,0:10:07.97,Default,,0,0,0,,Пуи Пуиню Пу (есіктің ашылған дыбысы)
Dialogue: 0,0:10:07.97,0:10:12.27,Default,,0,0,0,,Сәлеметсіз бе, кешіріңізші.
Dialogue: 0,0:10:13.64,0:10:17.31,Default,,0,0,0,,Пу~ Пуи Пуинью
Dialogue: 0,0:10:19.65,0:10:25.99,Default,,0,0,0,,♬～
Dialogue: 0,0:10:25.99,0:10:29.66,Default,,0,0,0,,Уф... Ол қызық қыз.
Dialogue: 0,0:10:29.66,0:10:32.99,Default,,0,0,0,,Не? (Ата) Басқалар үшін
Dialogue: 0,0:10:32.99,0:10:36.00,Default,,0,0,0,,Мұны қалай жасауға болады...
Dialogue: 0,0:10:36.00,0:10:39.33,Default,,0,0,0,,Хехе, маған әсер еткен болуы керек.
Dialogue: 0,0:10:39.33,0:10:41.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:41.34,0:10:44.67,Default,,0,0,0,,Әйелі үшін барын салатын тұтынушыларға
Dialogue: 0,0:10:44.67,0:10:47.68,Default,,0,0,0,,Е...
Dialogue: 0,0:10:47.68,0:10:49.68,Default,,0,0,0,,Уау
Dialogue: 0,0:10:49.68,0:10:53.68,Default,,0,0,0,,Олай болса, менің түстен кейінгі жұмысым бар.
Dialogue: 0,0:10:53.68,0:10:56.02,Default,,0,0,0,,А... сәлем
Dialogue: 0,0:10:56.02,0:10:59.95,Default,,0,0,0,,Акари: Бұл тым көп! Хахи: Бұл қызық!
Dialogue: 0,0:10:59.95,0:11:02.29,Default,,0,0,0,,Хм
Dialogue: 0,0:11:02.29,0:11:06.96,Default,,0,0,0,,Аа, байсалды болыңыз. (Айка/Акари) Кешіріңіз.
Dialogue: 0,0:11:18.97,0:11:23.98,Default,,0,0,0,,(Тұтынушының дауысы)
Dialogue: 0,0:11:28.65,0:11:30.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:30.99,0:11:32.99,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,0:11:32.99,0:11:36.99,Default,,0,0,0,,Иә, аяқталды! Өте жетістік
Dialogue: 0,0:11:36.99,0:11:40.33,Default,,0,0,0,,Әсіресе мына садақ! Өнер құдайы
Dialogue: 0,0:11:40.33,0:11:45.00,Default,,0,0,0,,Ол кенет менің үстімнен түсті, солай ма? Бұл тағы да.
Dialogue: 0,0:11:45.00,0:11:48.67,Default,,0,0,0,,Айка-сенпай, бұл үлкен қарғыс па?
Dialogue: 0,0:11:48.67,0:11:50.94,Default,,0,0,0,,Мені шығыстық деп атаңыз! Хехе...
Dialogue: 0,0:11:50.94,0:11:52.94,Default,,0,0,0,,Ах
Dialogue: 0,0:11:52.94,0:12:03.95,Default,,0,0,0,,♬～
Dialogue: 0,0:12:03.95,0:12:05.95,Default,,0,0,0,,Ал...
Dialogue: 0,0:12:05.95,0:12:14.96,Default,,0,0,0,,♬～
Dialogue: 0,0:12:14.96,0:12:16.97,Default,,0,0,0,,Пуинью
Dialogue: 0,0:12:16.97,0:12:22.97,Default,,0,0,0,,♬～
Dialogue: 0,0:12:22.97,0:12:25.64,Default,,0,0,0,,Ах...хехе
Dialogue: 0,0:12:25.64,0:12:28.98,Default,,0,0,0,,Музыка болса, тамаша болар еді~
Dialogue: 0,0:12:28.98,0:12:31.98,Default,,0,0,0,,Ал...
Dialogue: 0,0:12:31.98,0:12:34.98,Default,,0,0,0,,А... дұрыс! Бұл не?
Dialogue: 0,0:12:34.98,0:12:37.65,Default,,0,0,0,,Пуи? (Ата) А?
Dialogue: 0,0:12:37.65,0:12:41.66,Default,,0,0,0,,А... кездесуге аз қалды.
Dialogue: 0,0:12:41.66,0:12:44.66,Default,,0,0,0,,Иә, асығайық.
Dialogue: 0,0:12:44.66,0:12:53.94,Default,,0,0,0,,♬～
Dialogue: 0,0:12:53.94,0:12:57.94,Default,,0,0,0,,Жақсы! сен бұл...
Dialogue: 0,0:12:57.94,0:12:59.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:00.94,0:13:05.28,Default,,0,0,0,,Теңізбен неке қию рәсімі
Dialogue: 0,0:13:05.28,0:13:09.28,Default,,0,0,0,,Ах! Енді түсіндім, сонда
Dialogue: 0,0:13:11.29,0:13:15.99,Default,,0,0,0,,Иә, солай дедім.
Dialogue: 0,0:13:16.96,0:13:20.29,Default,,0,0,0,,Бірақ бұл мәңгілік болды...
Dialogue: 0,0:13:20.29,0:13:22.63,Default,,0,0,0,,Акари-чан! (Әже) А?
Dialogue: 0,0:13:22.63,0:13:25.63,Default,,0,0,0,,Не? Алисия
Dialogue: 0,0:13:31.97,0:13:35.64,Default,,0,0,0,,Теңізбен той туралы айтайық.
Dialogue: 0,0:13:35.64,0:13:39.31,Default,,0,0,0,,Тұтынушы қатысқысы келетінін айтты.
Dialogue: 0,0:13:39.31,0:13:41.65,Default,,0,0,0,,Ей, бұл тамаша идея.
Dialogue: 0,0:13:41.65,0:13:45.32,Default,,0,0,0,,Біздің де келуімізге рұқсат етіңіз. (Ата) А...
Dialogue: 0,0:13:45.32,0:13:47.99,Default,,0,0,0,,Керемет! Егер менде Алисияның гондоласы болса
Dialogue: 0,0:13:47.99,0:13:49.92,Default,,0,0,0,,Әдемі бола түседі
Dialogue: 0,0:13:49.92,0:13:52.59,Default,,0,0,0,,Хехе, жалғыз мен емеспін.
Dialogue: 0,0:13:52.59,0:13:54.93,Default,,0,0,0,,Хохе?
Dialogue: 0,0:13:54.93,0:13:57.27,Default,,0,0,0,,Ах! (Әже) Жарайды...
Dialogue: 0,0:13:57.27,0:14:00.27,Default,,0,0,0,,Акира-сан
Dialogue: 0,0:14:00.27,0:14:02.60,Default,,0,0,0,,Афина да
Dialogue: 0,0:14:02.60,0:14:05.27,Default,,0,0,0,,Акира-сан, неге...
Dialogue: 0,0:14:05.27,0:14:07.61,Default,,0,0,0,,Алисияны тыңдау.
Dialogue: 0,0:14:07.61,0:14:12.95,Default,,0,0,0,,Бал айында теңіз жағасындағы тойды көру қандай керемет!
Dialogue: 0,0:14:12.95,0:14:15.62,Default,,0,0,0,,Құдай екеуміздің болашағымызды жоспарлап тұрғандай.
Dialogue: 0,0:14:15.62,0:14:18.29,Default,,0,0,0,,Сен маған батасын беріп тұрған сияқтысың, жаным.
Dialogue: 0,0:14:18.29,0:14:21.29,Default,,0,0,0,,Уау... біртүрлі гондола бар!
Dialogue: 0,0:14:21.29,0:14:25.29,Default,,0,0,0,,Қаласаңыз, сізге қосылайық.
Dialogue: 0,0:14:25.29,0:14:28.63,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:14:28.63,0:14:31.63,Default,,0,0,0,,Керемет... Тамаша Керемет!
Dialogue: 0,0:14:31.63,0:14:34.30,Default,,0,0,0,,Сіз (Ата) А... Ах.
Dialogue: 0,0:14:34.30,0:14:36.97,Default,,0,0,0,,Сәлем! (Әже) А?
Dialogue: 0,0:14:36.97,0:14:40.98,Default,,0,0,0,,Эй (топ мүшесі) О, сен істеп жатырсың!
Dialogue: 0,0:14:40.98,0:14:43.64,Default,,0,0,0,,Ой, балалар...
Dialogue: 0,0:14:43.64,0:14:45.98,Default,,0,0,0,,Хехе, алаңға барсаң
Dialogue: 0,0:14:45.98,0:14:48.65,Default,,0,0,0,,Мен ол жаттығып жүрген шығар деп ойладым.
Dialogue: 0,0:14:48.65,0:14:52.92,Default,,0,0,0,,Мен сізді шақырдым. Басқа жоспарым жоқ.
Dialogue: 0,0:14:52.92,0:14:57.26,Default,,0,0,0,,Қарсы болмасаң, теңізбен тойыңа ән айтайын.
Dialogue: 0,0:14:57.26,0:15:02.96,Default,,0,0,0,,Уау! Тіпті музыка! Сіз мұнымен шынайы нәрсені жеңе алмайсыз
Dialogue: 0,0:15:07.60,0:15:12.61,Default,,0,0,0,,♪ (Оркестрлік орындау)
Dialogue: 0,0:15:12.61,0:15:32.63,Default,,0,0,0,,♪～
Dialogue: 0,0:15:32.63,0:15:52.58,Default,,0,0,0,,♪～
Dialogue: 0,0:15:52.58,0:16:07.93,Default,,0,0,0,,♪～
Dialogue: 0,0:16:07.93,0:16:10.60,Default,,0,0,0,,Ұнады, лайк! Сонымен...
Dialogue: 0,0:16:10.60,0:16:13.60,Default,,0,0,0,,Мен оператормын ба?
Dialogue: 0,0:16:13.60,0:16:18.27,Default,,0,0,0,,Пуи~ Пуи Пуиню~
Dialogue: 0,0:16:18.27,0:16:36.96,Default,,0,0,0,,♪～
Dialogue: 0,0:16:36.96,0:16:38.96,Default,,0,0,0,,♪～
Dialogue: 0,0:16:38.96,0:16:41.63,Default,,0,0,0,,А... жоқ (кемпір) иә?
Dialogue: 0,0:16:41.63,0:16:44.30,Default,,0,0,0,,Жоқ... жоқ
Dialogue: 0,0:16:44.30,0:16:47.00,Default,,0,0,0,,Жоқ! сурет?
Dialogue: 0,0:16:48.30,0:16:52.91,Default,,0,0,0,,Мен оны сатып алдым, бірақ қонақүйде ұмытып кеткен сияқтымын...
Dialogue: 0,0:16:52.91,0:16:55.51,Default,,0,0,0,,Уф... (Әже) Хэхе...
Dialogue: 0,0:16:57.58,0:16:59.98,Default,,0,0,0,,Иә, (атасына)?
Dialogue: 0,0:17:05.25,0:17:09.26,Default,,0,0,0,,А...? (Әже) Мен оны жаңа ғана дүкеннен таптым.
Dialogue: 0,0:17:09.26,0:17:12.56,Default,,0,0,0,,Мен оны жаңа ғана сатып алдым.
Dialogue: 0,0:17:13.93,0:17:18.23,Default,,0,0,0,,Теңізбен тойды еске түсіру
Dialogue: 0,0:17:19.93,0:17:22.27,Default,,0,0,0,,Қандай керемет...
Dialogue: 0,0:17:22.27,0:17:27.94,Default,,0,0,0,,Біз әртүрлі іспен айналыссақ та, бір нәрсені ойлайтынбыз.
Dialogue: 0,0:17:27.94,0:17:31.95,Default,,0,0,0,,Сіз маған әрқашан көмектесе аласыз
Dialogue: 0,0:17:32.95,0:17:37.95,Default,,0,0,0,,Аква - теңіздің көмегінсіз өмір сүре алмайтын планета.
Dialogue: 0,0:17:37.95,0:17:40.62,Default,,0,0,0,,Не? (Ата) Нео Венеция
Dialogue: 0,0:17:40.62,0:17:44.29,Default,,0,0,0,,Осы уақытқа дейін және болашақта
Dialogue: 0,0:17:44.29,0:17:47.60,Default,,0,0,0,,Теңізге мәңгі ғашық
Dialogue: 0,0:17:49.90,0:17:53.23,Default,,0,0,0,,Уми де (Ата) А?
Dialogue: 0,0:17:53.23,0:17:57.24,Default,,0,0,0,,Өйткені мен әрқашан Нео Венецияға ғашық болдым
Dialogue: 0,0:17:57.24,0:18:00.54,Default,,0,0,0,,Біз бір-бірімізге жақын бола береміз.
Dialogue: 0,0:18:05.25,0:18:09.92,Default,,0,0,0,,Мен әрқашан теңізбен бірге той көргім келетінін айтатынмын ...
Dialogue: 0,0:18:09.92,0:18:14.92,Default,,0,0,0,,Баяғыда, қыз кезімде.
Dialogue: 0,0:18:14.92,0:18:18.93,Default,,0,0,0,,Не? Баяғыда ма?
Dialogue: 0,0:18:18.93,0:18:24.60,Default,,0,0,0,,Сәл орынсыз және өте ебедейсіз болса да.
Dialogue: 0,0:18:24.60,0:18:28.60,Default,,0,0,0,,Ол маған айнымас махаббат сыйлайды.
Dialogue: 0,0:18:28.60,0:18:32.94,Default,,0,0,0,,Менің Нео Венециям
Dialogue: 0,0:18:32.94,0:18:34.94,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:18:34.94,0:18:53.89,Default,,0,0,0,,♬～
Dialogue: 0,0:18:53.89,0:18:55.90,Default,,0,0,0,,♬～
Dialogue: 0,0:18:55.90,0:18:57.90,Default,,0,0,0,,Бұл дәл уақыт.
Dialogue: 0,0:18:57.90,0:19:01.24,Default,,0,0,0,,Иә, жел тыныш.
Dialogue: 0,0:19:01.24,0:19:03.24,Default,,0,0,0,,Күннің батуы ашық қызыл
Dialogue: 0,0:19:03.24,0:19:06.91,Default,,0,0,0,,Қарттың құлағы сияқты.
Dialogue: 0,0:19:06.91,0:19:09.91,Default,,0,0,0,,Ария президенті (Ария президенті) Пупуиню
Dialogue: 0,0:19:09.91,0:19:11.91,Default,,0,0,0,,Екі жақсы досқа қараңдар
Dialogue: 0,0:19:11.91,0:19:14.92,Default,,0,0,0,,Батып бара жатқан күн де ұялса керек.
Dialogue: 0,0:19:14.92,0:19:18.52,Default,,0,0,0,,Ұялған... Не болды?
Dialogue: 0,0:19:19.59,0:19:21.92,Default,,0,0,0,,Ал...
Dialogue: 0,0:19:21.92,0:19:24.59,Default,,0,0,0,,Атам өте керемет!
Dialogue: 0,0:19:24.59,0:19:27.60,Default,,0,0,0,,Нағыз Доджға ұқсайды
Dialogue: 0,0:19:27.60,0:19:35.60,Default,,0,0,0,,♬～
Dialogue: 0,0:19:37.94,0:19:41.61,Default,,0,0,0,,Теңіз, мен саған үйленемін
Dialogue: 0,0:19:41.61,0:19:47.01,Default,,0,0,0,,Сізге мәңгілік және мәңгілік тыныштық тілеймін
Dialogue: 0,0:19:50.28,0:19:53.99,Default,,0,0,0,,Сен менікі бол
Dialogue: 0,0:19:55.29,0:20:00.29,Default,,0,0,0,,Соңғы сәтке дейін екеуміз бақытты болайық
Dialogue: 0,0:20:00.29,0:20:02.96,Default,,0,0,0,,Біріккен Араб Әмірліктеріне кірді
Dialogue: 0,0:20:02.96,0:20:22.98,Default,,0,0,0,,♬～
Dialogue: 0,0:20:22.98,0:20:27.66,Default,,0,0,0,,♬～
Dialogue: 0,0:20:27.66,0:20:32.06,Default,,0,0,0,,Өтінемін, мені мәңгі сүй
Dialogue: 0,0:20:33.66,0:20:36.00,Default,,0,0,0,,Әрине
Dialogue: 0,0:20:36.00,0:20:42.34,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:20:42.34,0:20:45.01,Default,,0,0,0,,Бұл көңілсіз қала.
Dialogue: 0,0:20:45.01,0:20:49.01,Default,,0,0,0,,Бұл тамаша қала. (Ата) А.
Dialogue: 0,0:20:49.01,0:20:54.28,Default,,0,0,0,,♬～
Dialogue: 0,0:20:54.28,0:20:57.99,Default,,0,0,0,,Құттықтаймыз, ата мен әже!
Dialogue: 0,0:21:00.62,0:21:05.03,Default,,0,0,0,,Екеуіңіз де сүйкімдісіздер (Еркек) Әй, күлкілерің жақсы.
Dialogue: 0,0:21:06.29,0:21:09.30,Default,,0,0,0,,Біз де солай болғымыз келеді, жаным.
Dialogue: 0,0:21:09.30,0:21:11.97,Default,,0,0,0,,Иә
Dialogue: 0,0:21:11.97,0:21:14.64,Default,,0,0,0,,Нян да тамаша сурет салады.
Dialogue: 0,0:21:14.64,0:21:17.30,Default,,0,0,0,,Бұл үлкен және әдемі.
Dialogue: 0,0:21:17.30,0:21:20.01,Default,,0,0,0,,Пупупуиню Пуи~!
Dialogue: 0,0:21:21.31,0:21:23.98,Default,,0,0,0,,<Екі адамның бір-біріне деген сезімі➡
Dialogue: 0,0:21:23.98,0:21:27.58,Default,,0,0,0,,Желмен мәңгілікке саяхаттайтын сияқты.＞
Dialogue: 0,0:21:29.65,0:21:35.99,Default,,0,0,0,,<Кең кең әлемде, ұзақ, ұзақ уақытта➡
Dialogue: 0,0:21:35.99,0:21:39.66,Default,,0,0,0,,Мен бір ғана маңызды адамды кездестіргеніме сене алар емеспін➡
Dialogue: 0,0:21:39.66,0:21:45.33,Default,,0,0,0,,Бұл ғажайып сияқты, бірақ мүмкін ➡
Dialogue: 0,0:21:45.33,0:21:50.27,Default,,0,0,0,,Әрбір кездесу бір ғажайып шығар.
Dialogue: 0,0:21:50.27,0:21:55.94,Default,,0,0,0,,<Мүмкін маңызды сезімдер дамуы үшін уақыт қажет нәрсе болуы мүмкін>
Dialogue: 0,0:21:55.94,0:21:58.25,Default,,0,0,0,,<Осы екеуі сияқты>
Dialogue: 0,0:22:02.62,0:22:07.02,Default,,0,0,0,,Президент Ария Фото дайын!
Dialogue: 0,0:22:08.29,0:22:12.96,Default,,0,0,0,,<Осы аквада ант-су, жылы сезімге оранып>
Dialogue: 0,0:22:12.96,0:22:16.63,Default,,0,0,0,,<Олардың тілегі орындалатынына сенімдімін>
Dialogue: 0,0:22:16.63,0:22:18.63,Default,,0,0,0,,<Тамаша ғажайып! ＞
Dialogue: 0,0:22:18.63,0:22:22.64,Default,,0,0,0,,<Әркімнің тілегі теңізбен тойға айналды.>
Dialogue: 0,0:22:22.64,0:22:26.97,Default,,0,0,0,,<Менің әжем қазір өзін жақсы сезінбейді➡
Dialogue: 0,0:22:26.97,0:22:30.98,Default,,0,0,0,,Мен де тезірек сауығып кетуіңізді сұраймын! ＞
Dialogue: 0,0:22:30.98,0:22:50.93,Default,,0,0,0,,♬～
Dialogue: 0,0:22:50.93,0:23:10.95,Default,,0,0,0,,♬～
Dialogue: 0,0:23:10.95,0:23:30.97,Default,,0,0,0,,♬～
