Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.96,0:00:05.97,Default,,0,0,0,,♬～
Dialogue: 0,0:00:05.97,0:00:09.64,Default,,0,0,0,,<Ай-чан, ыстық күндер әдеттегідей жалғасуда>
Dialogue: 0,0:00:09.64,0:00:11.64,Default,,0,0,0,,<Бүгін - Акира-сан➡
Dialogue: 0,0:00:11.64,0:00:14.64,Default,,0,0,0,,Жазда шаршағандай көрінетіндерге өмір сыйлау ➡
Dialogue: 0,0:00:14.64,0:00:18.31,Default,,0,0,0,,Олар түскі ас кезінде барбекю турнирін ұйымдастырды.＞
Dialogue: 0,0:00:18.31,0:00:22.65,Default,,0,0,0,,Пуи Пуи Пуи Пуи…
Dialogue: 0,0:00:22.65,0:00:26.32,Default,,0,0,0,,<Аа, менің үлкендерім төлейді➡
Dialogue: 0,0:00:26.32,0:00:30.33,Default,,0,0,0,,Біз, үш кіші, Огор тобымыз>
Dialogue: 0,0:00:30.33,0:00:50.35,Default,,0,0,0,,♬～
Dialogue: 0,0:00:50.35,0:01:10.30,Default,,0,0,0,,♬～
Dialogue: 0,0:01:10.30,0:01:30.32,Default,,0,0,0,,♬～
Dialogue: 0,0:01:30.32,0:01:50.34,Default,,0,0,0,,♬～
Dialogue: 0,0:01:50.34,0:02:09.63,Default,,0,0,0,,♬～
Dialogue: 0,0:02:15.30,0:02:17.30,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:17.30,0:02:21.64,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:02:21.64,0:02:25.31,Default,,0,0,0,,Алисия мен Афина ше? Әзірше емес?
Dialogue: 0,0:02:25.31,0:02:27.31,Default,,0,0,0,,Иә, иә әлі...
Dialogue: 0,0:02:27.31,0:02:32.31,Default,,0,0,0,,Айтайын дегенім... Бүгін түстен бастап бөлмеден кетіңіз дедім.
Dialogue: 0,0:02:32.31,0:02:35.98,Default,,0,0,0,,Менің бүгінгі ауысым кешке басталады, сондықтан мен демаламын.
Dialogue: 0,0:02:35.98,0:02:39.66,Default,,0,0,0,,Бұл екеуі түстен кейінгі уақытты да ескертті, солай ма?
Dialogue: 0,0:02:39.66,0:02:43.66,Default,,0,0,0,,Тез келмесең, тамақ ішуге үлгермейсің.
Dialogue: 0,0:02:45.99,0:02:48.33,Default,,0,0,0,,<Жаз - туристік маусым>
Dialogue: 0,0:02:48.33,0:02:52.63,Default,,0,0,0,,<Үш ұлы перілерді біріктіру өте қиын.>
Dialogue: 0,0:02:57.01,0:02:59.67,Default,,0,0,0,,Пуи Пуи Пуи Пуи Пуи…
Dialogue: 0,0:02:59.67,0:03:01.61,Default,,0,0,0,,Ах, Алиса Чан
Dialogue: 0,0:03:01.61,0:03:04.28,Default,,0,0,0,,Хахе... хахе...
Dialogue: 0,0:03:04.28,0:03:07.28,Default,,0,0,0,,Не? Не? Шаршаған жоқсың ба?
Dialogue: 0,0:03:07.28,0:03:09.28,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:03:09.28,0:03:12.29,Default,,0,0,0,,Бұл өте үлкен және ыстық ...
Dialogue: 0,0:03:12.29,0:03:15.29,Default,,0,0,0,,А... Менің амалым жоқ. Алдымен тамақтанып алайық.
Dialogue: 0,0:03:15.29,0:03:17.96,Default,,0,0,0,,О, жақсы ма?
Dialogue: 0,0:03:17.96,0:03:22.30,Default,,0,0,0,,Жарайды, келмегені жаман.
Dialogue: 0,0:03:22.30,0:03:24.30,Default,,0,0,0,,Иә (Акира) Ммм
Dialogue: 0,0:03:24.30,0:03:26.64,Default,,0,0,0,,Пуи Пупу Пуича~
Dialogue: 0,0:03:26.64,0:03:30.97,Default,,0,0,0,,Пуйпуи Пуича Пуйпуи Пуипуй...
Dialogue: 0,0:03:30.97,0:03:33.64,Default,,0,0,0,,Ендеше, ет же! Ет!
Dialogue: 0,0:03:33.64,0:03:35.64,Default,,0,0,0,,Әй... (Президент Ария) Пуи?
Dialogue: 0,0:03:35.64,0:03:38.98,Default,,0,0,0,,Жақсы~ (Президент Ария) Пуича~!
Dialogue: 0,0:03:38.98,0:03:41.65,Default,,0,0,0,,Менің қарным бірден ашты.
Dialogue: 0,0:03:41.65,0:03:43.99,Default,,0,0,0,,Иә
Dialogue: 0,0:03:43.99,0:03:47.32,Default,,0,0,0,,Күткеніңізге рахмет~ (Алис Акари) А...
Dialogue: 0,0:03:47.32,0:03:51.66,Default,,0,0,0,,Алисия-сан Афина-сан! Мен оны уақытында жасадым ба?
Dialogue: 0,0:03:51.66,0:03:55.33,Default,,0,0,0,,Жарайды, мен пісіруді енді бастадым.
Dialogue: 0,0:03:55.33,0:03:57.67,Default,,0,0,0,,Жарайсың, Афина-чан.
Dialogue: 0,0:03:57.67,0:04:01.94,Default,,0,0,0,,♪ Бұл өте ерекше.
Dialogue: 0,0:04:01.94,0:04:05.61,Default,,0,0,0,,♪ Бұл өте керемет.
Dialogue: 0,0:04:05.61,0:04:08.94,Default,,0,0,0,,♪ Бұл ет шақыру...
Dialogue: 0,0:04:08.94,0:04:11.95,Default,,0,0,0,,Уау~ Мені де қосыңызшы~ Иә?
Dialogue: 0,0:04:11.95,0:04:14.28,Default,,0,0,0,,Ха... ау.
Dialogue: 0,0:04:14.28,0:04:17.95,Default,,0,0,0,,♪ Корянику Доккой Никку Андоку
Dialogue: 0,0:04:17.95,0:04:19.96,Default,,0,0,0,,Қазір! (тамақтану дыбысы)
Dialogue: 0,0:04:19.96,0:04:23.63,Default,,0,0,0,,Хехе~ Ал, біз де бастайық.
Dialogue: 0,0:04:23.63,0:04:25.63,Default,,0,0,0,,Иә
Dialogue: 0,0:04:27.63,0:04:31.33,Default,,0,0,0,,Бұл теңіз өнімдері, солай ма?
Dialogue: 0,0:04:32.30,0:04:35.64,Default,,0,0,0,,Әй, Алисия! Сіз оны уақытында жасадыңыз
Dialogue: 0,0:04:35.64,0:04:38.97,Default,,0,0,0,,Сәлем Айка-чан, сізді күткенім үшін кешіріңіз~
Dialogue: 0,0:04:38.97,0:04:42.31,Default,,0,0,0,,Көкөністер келді~
Dialogue: 0,0:04:42.31,0:04:46.01,Default,,0,0,0,,Тек ет жесең жақсы емес.
Dialogue: 0,0:04:47.32,0:04:49.65,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:04:49.65,0:04:56.32,Default,,0,0,0,,♬～
Dialogue: 0,0:04:56.32,0:04:58.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:58.33,0:05:00.60,Default,,0,0,0,,Няё аа...
Dialogue: 0,0:05:00.60,0:05:04.93,Default,,0,0,0,,Иә, Айка-чанның шашы бүгін де әдемі көрінеді.
Dialogue: 0,0:05:04.93,0:05:07.27,Default,,0,0,0,,Сіздің шаш үлгісі бүгінде басқаша.
Dialogue: 0,0:05:07.27,0:05:10.94,Default,,0,0,0,,Ал, хехехе, жаздың шуағын тамашалау
Dialogue: 0,0:05:10.94,0:05:15.28,Default,,0,0,0,,Менің қара шашым одан сайын жылтырап тұрғандай сезіледі ме?
Dialogue: 0,0:05:15.28,0:05:20.62,Default,,0,0,0,,♬～
Dialogue: 0,0:05:20.62,0:05:24.62,Default,,0,0,0,,Бұл шынымен тегіс және жарқыраған.
Dialogue: 0,0:05:24.62,0:05:30.29,Default,,0,0,0,,Рас, шашың қара маржандай.
Dialogue: 0,0:05:30.29,0:05:34.00,Default,,0,0,0,,Сұлусың, құдайдай.
Dialogue: 0,0:05:38.63,0:05:41.04,Default,,0,0,0,,Алисия...
Dialogue: 0,0:05:42.64,0:05:46.31,Default,,0,0,0,,Мияу! Сізге көп рахмет!
Dialogue: 0,0:05:46.31,0:05:48.64,Default,,0,0,0,,Сіз оны әлі естідіңіз бе? О, құдайым
Dialogue: 0,0:05:48.64,0:05:51.65,Default,,0,0,0,,Әй, сен құдайға ұқсайсың! Мен бүгін қолымнан келгеннің бәрін жасаймын
Dialogue: 0,0:05:51.65,0:05:55.65,Default,,0,0,0,,Алдымен мен көкөністерге күтім жасаймын, жарай ма? Сонда...
Dialogue: 0,0:05:57.65,0:06:00.36,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:06:05.93,0:06:09.23,Default,,0,0,0,,Пуи Пупу Пуи Пуи Пуи
Dialogue: 0,0:06:11.27,0:06:14.94,Default,,0,0,0,,Няан (Президент Ария) Пуи⁉ Пуиню...
Dialogue: 0,0:06:14.94,0:06:17.94,Default,,0,0,0,,Барбекю - бұл ет туралы.
Dialogue: 0,0:06:17.94,0:06:21.61,Default,,0,0,0,,Мм, ет, иә, көкөністер де.
Dialogue: 0,0:06:21.61,0:06:24.28,Default,,0,0,0,,Эх... жақсы болды Айка-чан.
Dialogue: 0,0:06:24.28,0:06:28.28,Default,,0,0,0,,Иә, мен бұл шаш үшін дұға етіп, өсіре бердім.
Dialogue: 0,0:06:28.28,0:06:32.29,Default,,0,0,0,,Алисия мені мақтаса, мен қатты қуанамын.
Dialogue: 0,0:06:32.29,0:06:36.63,Default,,0,0,0,,Қалау? Тілегім сол
Dialogue: 0,0:06:36.63,0:06:39.63,Default,,0,0,0,,Мен қатты толқып тұрмын.
Dialogue: 0,0:06:39.63,0:06:42.96,Default,,0,0,0,,Жаңа өзіңді таба алатындай сезінесің бе?
Dialogue: 0,0:06:42.96,0:06:44.97,Default,,0,0,0,,Жаздың ыстығы ештеңе емес!
Dialogue: 0,0:06:44.97,0:06:47.64,Default,,0,0,0,,Ондай нәрсе сізді желге ұшырып жібереді!
Dialogue: 0,0:06:47.64,0:06:50.64,Default,,0,0,0,,Ооо хехехе
Dialogue: 0,0:06:50.64,0:06:53.64,Default,,0,0,0,,Міне! Асшаяндар күйіп кетеді
Dialogue: 0,0:06:54.64,0:06:57.65,Default,,0,0,0,,Тез болғаным үшін кешіріңіз...
Dialogue: 0,0:06:57.65,0:07:01.58,Default,,0,0,0,,Егер сізде тілек айтуға уақыт болса, сол уақытты өз дағдыларыңызды жетілдіру үшін пайдаланыңыз.
Dialogue: 0,0:07:01.58,0:07:03.92,Default,,0,0,0,,Жоқ! Сол сияқты...
Dialogue: 0,0:07:03.92,0:07:06.25,Default,,0,0,0,,Қара, тез тамақтан, қара.
Dialogue: 0,0:07:06.25,0:07:08.92,Default,,0,0,0,,Хахи~ Сізге көп рахмет...
Dialogue: 0,0:07:08.92,0:07:11.59,Default,,0,0,0,,Ах! Бұл мен өсіретін ет!
Dialogue: 0,0:07:11.59,0:07:14.26,Default,,0,0,0,,Не? Бұлай болғанына өкінемін
Dialogue: 0,0:07:14.26,0:07:17.93,Default,,0,0,0,,Бірақ бұл дәмді~ Бұл үлкен және дәмді.
Dialogue: 0,0:07:17.93,0:07:21.94,Default,,0,0,0,,Балалар... Ой, қандай жандысың.
Dialogue: 0,0:07:21.94,0:07:24.27,Default,,0,0,0,,Иә, бұл қызық.
Dialogue: 0,0:07:24.27,0:07:27.61,Default,,0,0,0,,Осында жайбарақат тамақтанып алайық.
Dialogue: 0,0:07:27.61,0:07:30.28,Default,,0,0,0,,Иә, Алисия, тәтті картоп алыңыз.
Dialogue: 0,0:07:30.28,0:07:34.28,Default,,0,0,0,,О, рахмет, Айка-чан.
Dialogue: 0,0:07:34.28,0:07:36.28,Default,,0,0,0,,Уау
Dialogue: 0,0:07:38.95,0:07:42.29,Default,,0,0,0,,Жарайды! үшін ыстықты жеңе алды ма?
Dialogue: 0,0:07:42.29,0:07:47.30,Default,,0,0,0,,Соңында, біздің арнайы грильде пісірілген күріш шарлары келді!
Dialogue: 0,0:07:47.30,0:07:50.97,Default,,0,0,0,,Уау! Бұл үлкен және дәмді.
Dialogue: 0,0:07:50.97,0:07:54.97,Default,,0,0,0,,Мен Акираның арнайы грильде пісірілген күріш шарларын күттім.
Dialogue: 0,0:07:54.97,0:07:58.31,Default,,0,0,0,,Әй, сен өте танымалсың, Акира-чан.
Dialogue: 0,0:07:58.31,0:08:01.01,Default,,0,0,0,,Мен оны асыға күтемін~
Dialogue: 0,0:08:02.58,0:08:04.91,Default,,0,0,0,,Хмм, иісі жақсы.
Dialogue: 0,0:08:04.91,0:08:06.92,Default,,0,0,0,,Қазір жақсысың ба? (Акира) Әлі жоқ.
Dialogue: 0,0:08:06.92,0:08:09.92,Default,,0,0,0,,Әй, хехехе
Dialogue: 0,0:08:09.92,0:08:13.59,Default,,0,0,0,,Енді тоқмейілсіп тамақтанып, түстен кейін тынбай еңбек ет...
Dialogue: 0,0:08:13.59,0:08:17.26,Default,,0,0,0,,Біртүрлі иіс емес пе?
Dialogue: 0,0:08:17.26,0:08:20.60,Default,,0,0,0,,Қалай? Хмм, күріш шарлары күйіп қалды ма?
Dialogue: 0,0:08:20.60,0:08:23.60,Default,,0,0,0,,Жоқ, олай емес... Ах.
Dialogue: 0,0:08:23.60,0:08:26.60,Default,,0,0,0,,Сәлем Айка! осу?
Dialogue: 0,0:08:26.60,0:08:30.01,Default,,0,0,0,,Мияу! (Акира) Тыныш қал!
Dialogue: 0,0:08:30.94,0:08:34.28,Default,,0,0,0,,Ммм... Мияу...
Dialogue: 0,0:08:34.28,0:08:36.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:45.29,0:08:47.29,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:47.29,0:08:49.29,Default,,0,0,0,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,0:08:57.30,0:08:59.30,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:09:04.91,0:09:09.91,Default,,0,0,0,,Ай!
Dialogue: 0,0:09:20.26,0:09:27.26,Default,,0,0,0,,♬～
Dialogue: 0,0:09:27.26,0:09:31.60,Default,,0,0,0,,Хехе... Ахаха Ахахха Ахахха...!
Dialogue: 0,0:09:31.60,0:09:34.60,Default,,0,0,0,,Сіз мұны жасадыңыз!
Dialogue: 0,0:09:34.60,0:09:36.94,Default,,0,0,0,,Хаха... Ах, бір афро?
Dialogue: 0,0:09:36.94,0:09:40.28,Default,,0,0,0,,Аха аха аха...
Dialogue: 0,0:09:40.28,0:09:43.95,Default,,0,0,0,,Мм... мен үйге бара жатырмын.
Dialogue: 0,0:09:43.95,0:09:47.62,Default,,0,0,0,,Осылай қала берсе шіркін Ахахаха...
Dialogue: 0,0:09:47.62,0:09:50.95,Default,,0,0,0,,Аа, барлығыңыз, өтінемін, жалғастырыңыз.
Dialogue: 0,0:09:50.95,0:09:53.62,Default,,0,0,0,,Өтінемін, өтінемін.
Dialogue: 0,0:09:53.62,0:09:58.03,Default,,0,0,0,,О, грильдегі күріш шары әдемі көрінеді.
Dialogue: 0,0:10:01.30,0:10:03.30,Default,,0,0,0,,Олай болса!
Dialogue: 0,0:10:03.30,0:10:05.30,Default,,0,0,0,,Мияу
Dialogue: 0,0:10:09.97,0:10:13.58,Default,,0,0,0,,Кешіріңіз. Біз де кешірім сұрағымыз келеді.
Dialogue: 0,0:10:14.98,0:10:18.98,Default,,0,0,0,,Иә, иә, бара аласыз.
Dialogue: 0,0:10:18.98,0:10:21.28,Default,,0,0,0,,Бірақ... (Акира) Чарлап!
Dialogue: 0,0:10:22.32,0:10:26.32,Default,,0,0,0,,Оның бар мейірімін құртасың ба?
Dialogue: 0,0:10:26.32,0:10:28.66,Default,,0,0,0,,Акира-чан...
Dialogue: 0,0:10:28.66,0:10:31.99,Default,,0,0,0,,Енді сіздің мүмкіндігіңіз! Қалағаныңызша жеңіз
Dialogue: 0,0:10:31.99,0:10:34.00,Default,,0,0,0,,Атчи Атчи…
Dialogue: 0,0:10:35.66,0:10:39.00,Default,,0,0,0,,Қараңдар, уақытымыз аз, тез тамақтан!
Dialogue: 0,0:10:39.00,0:10:42.67,Default,,0,0,0,,Афина мен Алисия түстен кейінгі уақытты белгілеп қойған шығар.
Dialogue: 0,0:10:42.67,0:10:45.34,Default,,0,0,0,,Иә... (Акира) Бұл жақсы.
Dialogue: 0,0:10:45.34,0:10:50.35,Default,,0,0,0,,Иә, иісі жақсы... Өте дәмді көрінеді...
Dialogue: 0,0:10:51.35,0:10:56.68,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:10:56.68,0:10:58.69,Default,,0,0,0,,Ах
Dialogue: 0,0:11:00.29,0:11:02.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:03.96,0:11:05.96,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:07.96,0:11:09.96,Default,,0,0,0,,Няан
Dialogue: 0,0:11:09.96,0:11:13.97,Default,,0,0,0,,♬～
Dialogue: 0,0:11:13.97,0:11:17.64,Default,,0,0,0,,Айка-чан Айка-чан
Dialogue: 0,0:11:17.64,0:11:21.31,Default,,0,0,0,,Мен оны таба алмаймын. Қайда кетті деп ойлаймын.
Dialogue: 0,0:11:21.31,0:11:24.65,Default,,0,0,0,,Сол жаққа барайық.
Dialogue: 0,0:11:24.65,0:11:38.66,Default,,0,0,0,,♬～
Dialogue: 0,0:11:38.66,0:11:40.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:40.66,0:11:50.00,Default,,0,0,0,,♬～
Dialogue: 0,0:11:50.00,0:11:54.34,Default,,0,0,0,,⚟ (Президент Химе) Нян... (Президент Ария) Пуи!? Пуи Пуи
Dialogue: 0,0:11:54.34,0:11:56.64,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:12:00.28,0:12:02.98,Default,,0,0,0,,Айка...чан?
Dialogue: 0,0:12:05.62,0:12:09.02,Default,,0,0,0,,Не, саған бірдеңе керек пе?
Dialogue: 0,0:12:10.63,0:12:12.63,Default,,0,0,0,,Грильде пісірілген күріш шарларына не болды?
Dialogue: 0,0:12:12.63,0:12:16.03,Default,,0,0,0,,Балалар сендер оны асыға күттіңдер.
Dialogue: 0,0:12:17.63,0:12:20.97,Default,,0,0,0,,Иә... бірақ...
Dialogue: 0,0:12:20.97,0:12:25.31,Default,,0,0,0,,Мен дәл қазір Айка Чанның қасында болғым келеді.
Dialogue: 0,0:12:25.31,0:12:30.31,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:12:51.23,0:12:55.94,Default,,0,0,0,,(жылау)
Dialogue: 0,0:13:00.91,0:13:02.91,Default,,0,0,0,,Жарайды, Айка-чан.
Dialogue: 0,0:13:02.91,0:13:04.91,Default,,0,0,0,,Біз жүрегіміз бен жанымызды саламыз
Dialogue: 0,0:13:04.91,0:13:08.25,Default,,0,0,0,,Мен сізге сүйкімді жаңа шаш үлгісін беремін!
Dialogue: 0,0:13:08.25,0:13:11.25,Default,,0,0,0,,Маған қалдырыңызшы, Пуинюпуи!
Dialogue: 0,0:13:11.25,0:13:14.26,Default,,0,0,0,,Сізге соншалықты сақ болудың қажеті жоқ.
Dialogue: 0,0:13:14.26,0:13:16.59,Default,,0,0,0,,Өзіңізді мәжбүрлемеңіз!
Dialogue: 0,0:13:16.59,0:13:20.60,Default,,0,0,0,,Бүгін мен байсалды режимдемін Иә, иә...
Dialogue: 0,0:13:20.60,0:13:22.93,Default,,0,0,0,,Ой, ой... Пуи... Пуи...
Dialogue: 0,0:13:22.93,0:13:30.27,Default,,0,0,0,,♬～
Dialogue: 0,0:13:30.27,0:13:32.61,Default,,0,0,0,,Иә? Ісіну?
Dialogue: 0,0:13:32.61,0:13:34.61,Default,,0,0,0,,Ах... (Президент Ария) Пупу
Dialogue: 0,0:13:34.61,0:13:37.31,Default,,0,0,0,,...
Dialogue: 0,0:13:39.61,0:13:42.62,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:42.62,0:13:44.62,Default,,0,0,0,,Не? Сол тәртіпсіздік
Dialogue: 0,0:13:44.62,0:13:46.95,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:13:46.95,0:13:50.96,Default,,0,0,0,,Мияу... Мияу...
Dialogue: 0,0:13:54.90,0:13:58.23,Default,,0,0,0,,А... жақсы, жарайды.
Dialogue: 0,0:13:58.23,0:14:01.24,Default,,0,0,0,,Содан кейін оны қалыпты түрде кесуге болады.
Dialogue: 0,0:14:01.24,0:14:03.91,Default,,0,0,0,,Қысқа болса да ұят.
Dialogue: 0,0:14:03.91,0:14:07.91,Default,,0,0,0,,Өртенген жерлерді кесіп алмасақ, біртүрлі болар еді.
Dialogue: 0,0:14:10.58,0:14:14.58,Default,,0,0,0,,Иә, онда мен барамын, маған қалдырыңыз.
Dialogue: 0,0:14:14.58,0:14:16.58,Default,,0,0,0,,Теңдеуіш
Dialogue: 0,0:14:16.58,0:14:23.59,Default,,0,0,0,,♬～
Dialogue: 0,0:14:23.59,0:14:25.93,Default,,0,0,0,,Pui...
Dialogue: 0,0:14:25.93,0:14:32.60,Default,,0,0,0,,♬～
Dialogue: 0,0:14:32.60,0:14:34.60,Default,,0,0,0,,Шун…
Dialogue: 0,0:14:34.60,0:14:38.94,Default,,0,0,0,,Тағы бір мүмкіндік беріңіз!
Dialogue: 0,0:14:38.94,0:14:46.95,Default,,0,0,0,,♬～
Dialogue: 0,0:14:46.95,0:14:48.95,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:48.95,0:14:51.22,Default,,0,0,0,,Осындай нәрсе туралы не айтасыз?
Dialogue: 0,0:14:51.22,0:14:53.22,Default,,0,0,0,,Сонда пони?
Dialogue: 0,0:14:53.22,0:14:56.22,Default,,0,0,0,,Өзін жігерлі сезіну
Dialogue: 0,0:14:56.22,0:14:58.89,Default,,0,0,0,,Сонда бұл жақсырақ...
Dialogue: 0,0:14:58.89,0:15:01.23,Default,,0,0,0,,Жақсы, бірақ аздап көп...
Dialogue: 0,0:15:01.23,0:15:04.57,Default,,0,0,0,,Бұған қалай қарайсыз?
Dialogue: 0,0:15:04.57,0:15:06.57,Default,,0,0,0,,О, сонда ше?
Dialogue: 0,0:15:06.57,0:15:09.90,Default,,0,0,0,,Менің ойымша, бұл жақсы. Иә, мен жасадым!
Dialogue: 0,0:15:09.90,0:15:11.91,Default,,0,0,0,,Тротуар тым кеңейіп кетті
Dialogue: 0,0:15:14.58,0:15:16.91,Default,,0,0,0,,А... жарайды.
Dialogue: 0,0:15:16.91,0:15:19.25,Default,,0,0,0,,Жартылай ұзын шаштың өзі сүйкімді, Айка-чан
Dialogue: 0,0:15:19.25,0:15:22.25,Default,,0,0,0,,Сіз маған керемет көрінесіз
Dialogue: 0,0:15:22.25,0:15:25.25,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:15:28.92,0:15:31.93,Default,,0,0,0,,Хмм... Рахмет
Dialogue: 0,0:15:31.93,0:15:33.93,Default,,0,0,0,,Айка-чан...
Dialogue: 0,0:15:33.93,0:15:36.93,Default,,0,0,0,,Жаман болғаным үшін кешіріңіз...
Dialogue: 0,0:15:36.93,0:15:39.60,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:15:39.60,0:15:42.30,Default,,0,0,0,,Бұлай емес...
Dialogue: 0,0:15:43.60,0:15:49.61,Default,,0,0,0,,Мен саған шашым үшін дұға етемін деп айтпадым ба?
Dialogue: 0,0:15:50.55,0:15:53.55,Default,,0,0,0,,Алисия сияқты
Dialogue: 0,0:15:53.55,0:15:56.55,Default,,0,0,0,,Әдемі ұзын шашты өсіріңіз
Dialogue: 0,0:15:56.55,0:16:00.56,Default,,0,0,0,,Мен Алисия сияқты бейшара болсам ғой.
Dialogue: 0,0:16:00.56,0:16:03.56,Default,,0,0,0,,Бұл менің тілегім болды
Dialogue: 0,0:16:03.56,0:16:05.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:07.23,0:16:09.53,Default,,0,0,0,,Осылай жалғаса берсе, бұл тағдыр ғой, иә?
Dialogue: 0,0:16:10.90,0:16:12.90,Default,,0,0,0,,Орындалмаған тілек
Dialogue: 0,0:16:12.90,0:16:16.24,Default,,0,0,0,,Мен Алисия сияқты болғым келеді.
Dialogue: 0,0:16:16.24,0:16:19.24,Default,,0,0,0,,Әу бастан мүмкін емес еді.
Dialogue: 0,0:16:19.24,0:16:22.91,Default,,0,0,0,,Мен өзімді ақымақ сияқты сезінемін.
Dialogue: 0,0:16:22.91,0:16:26.91,Default,,0,0,0,,Бұл дұрыс емес. Көңіліңізді көтеріңіз.
Dialogue: 0,0:16:26.91,0:16:29.92,Default,,0,0,0,,Жоқ, бұл мүмкін емес. (Элис Акари) Ах...
Dialogue: 0,0:16:30.92,0:16:34.92,Default,,0,0,0,,Сенің Алисия болу мүмкін емес.
Dialogue: 0,0:16:34.92,0:16:37.26,Default,,0,0,0,,Акира-сан... Сен қашаннан бері жүрсің?
Dialogue: 0,0:16:37.26,0:16:39.26,Default,,0,0,0,,Біраз бұрын
Dialogue: 0,0:16:39.26,0:16:43.26,Default,,0,0,0,,Расында да, үшеуі де кенет ғайып болды.
Dialogue: 0,0:16:43.26,0:16:45.60,Default,,0,0,0,,Алисия мен басқалары да жұмысқа кетті.
Dialogue: 0,0:16:45.60,0:16:47.94,Default,,0,0,0,,Мен бәрін өзім жинадым.
Dialogue: 0,0:16:47.94,0:16:51.21,Default,,0,0,0,,Жалғыз ба? Ах... кешіріңіз.
Dialogue: 0,0:16:51.21,0:16:53.21,Default,,0,0,0,,Я...
Dialogue: 0,0:16:53.21,0:16:56.54,Default,,0,0,0,,Айка Сіз сергіп қалдыңыз, солай емес пе?
Dialogue: 0,0:16:56.54,0:16:59.25,Default,,0,0,0,,Сүйкімді, маймылға ұқсайды
Dialogue: 0,0:17:01.22,0:17:04.55,Default,,0,0,0,,Жоқ... дедіңіз?
Dialogue: 0,0:17:04.55,0:17:06.55,Default,,0,0,0,,Айка-чан?
Dialogue: 0,0:17:06.55,0:17:09.89,Default,,0,0,0,,Жаңа ғана не айттыңыз?
Dialogue: 0,0:17:09.89,0:17:11.89,Default,,0,0,0,,Сүйкімді және маймыл тәрізді
Dialogue: 0,0:17:11.89,0:17:14.20,Default,,0,0,0,,Бұған дейін!
Dialogue: 0,0:17:16.23,0:17:19.53,Default,,0,0,0,,Сенің Алисия болуың мүмкін емес.
Dialogue: 0,0:17:21.24,0:17:23.24,Default,,0,0,0,,Айка-чан...
Dialogue: 0,0:17:23.24,0:17:27.24,Default,,0,0,0,,Айттым ғой, тілеуден пайда жоқ.
Dialogue: 0,0:17:27.24,0:17:30.24,Default,,0,0,0,,Бұл... дегенді білдірмейді ме?
Dialogue: 0,0:17:30.24,0:17:34.25,Default,,0,0,0,,А-а, қанша тілесем де мағынасы жоқ
Dialogue: 0,0:17:34.25,0:17:36.92,Default,,0,0,0,,Сіз Алисия бола алмайсыз.
Dialogue: 0,0:17:36.92,0:17:39.22,Default,,0,0,0,,Хмм... Былай деуге болады
Dialogue: 0,0:17:41.59,0:17:43.59,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:43.59,0:17:47.60,Default,,0,0,0,,Қайта-қайта айтамын, сен Алисия бола алмайсың!
Dialogue: 0,0:17:49.26,0:17:52.87,Default,,0,0,0,,Акира-сан... Мен оны жек көремін!
Dialogue: 0,0:17:52.87,0:17:55.20,Default,,0,0,0,,Айка! (Акари/Алис) Ах!
Dialogue: 0,0:17:55.20,0:17:57.54,Default,,0,0,0,,Пуи…
Dialogue: 0,0:17:57.54,0:18:01.94,Default,,0,0,0,,Тыңда, сен тек өзің бола аласың!
Dialogue: 0,0:18:04.55,0:18:06.95,Default,,0,0,0,,Ха...
Dialogue: 0,0:18:08.88,0:18:14.56,Default,,0,0,0,,Жарайсың ба? Тек Алисия Алисия бола алады.
Dialogue: 0,0:18:14.56,0:18:17.56,Default,,0,0,0,,Айка, сен
Dialogue: 0,0:18:17.56,0:18:22.90,Default,,0,0,0,,Алисия емес, Афина емес, мына Акира-сама емес.
Dialogue: 0,0:18:22.90,0:18:25.57,Default,,0,0,0,,Басқа ешкім еліктей алмайды
Dialogue: 0,0:18:25.57,0:18:29.97,Default,,0,0,0,,Neo Venezia тарихындағы ең жақсы Undine болыңыз!
Dialogue: 0,0:18:34.91,0:18:38.58,Default,,0,0,0,,Пуи~ (Ал, президент) Жақсы ма?
Dialogue: 0,0:18:38.58,0:18:48.26,Default,,0,0,0,,♬～
Dialogue: 0,0:18:48.26,0:18:50.19,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:50.19,0:18:52.86,Default,,0,0,0,,Урюурююрю
Dialogue: 0,0:18:52.86,0:18:56.16,Default,,0,0,0,,Урюрююрю... Ах...
Dialogue: 0,0:18:57.20,0:19:00.20,Default,,0,0,0,,Міне (Акира)!
Dialogue: 0,0:19:04.21,0:19:07.88,Default,,0,0,0,,Урюрюрюурю…
Dialogue: 0,0:19:07.88,0:19:27.90,Default,,0,0,0,,♬～
Dialogue: 0,0:19:27.90,0:19:46.91,Default,,0,0,0,,♬～
Dialogue: 0,0:19:46.91,0:19:50.92,Default,,0,0,0,,Тағы барбекю? (Акира) Хмм, дұрыс.
Dialogue: 0,0:19:50.92,0:19:53.92,Default,,0,0,0,,Акира-сан, Айка-чан...
Dialogue: 0,0:19:53.92,0:19:57.93,Default,,0,0,0,,Мен қазір материалдарды дайындап жатырмын. Олар жақын арада осында болуы керек.
Dialogue: 0,0:19:57.93,0:20:02.60,Default,,0,0,0,,Балалар, Айка сендерді шақырғанда, бәрің маған айғайладыңдар.
Dialogue: 0,0:20:02.60,0:20:05.93,Default,,0,0,0,,Себебі мен уайымдап жүрмін... Иә.
Dialogue: 0,0:20:05.93,0:20:08.94,Default,,0,0,0,,Айка-сенпай, жарайсың ба?
Dialogue: 0,0:20:08.94,0:20:11.27,Default,,0,0,0,,Адам келгенде білесің
Dialogue: 0,0:20:11.27,0:20:14.94,Default,,0,0,0,,Айтпақшы, Акира-чан, бүгінгі материалдық шығын...
Dialogue: 0,0:20:14.94,0:20:17.95,Default,,0,0,0,,Бұл сізге қажет емес сияқты. Бұл жақсы ма?
Dialogue: 0,0:20:17.95,0:20:20.95,Default,,0,0,0,,Жарайды (бәріне) Ах...
Dialogue: 0,0:20:24.29,0:20:28.62,Default,,0,0,0,,Менің кесірімнен кешегі күн бұзылды.
Dialogue: 0,0:20:28.62,0:20:31.63,Default,,0,0,0,,Бүгін бізде мереке болады!
Dialogue: 0,0:20:31.63,0:20:35.96,Default,,0,0,0,,Мен бөлмені қайта реттеп жатқаныма шыдаңыз.
Dialogue: 0,0:20:35.96,0:20:38.30,Default,,0,0,0,,Уау... аа... Уау.
Dialogue: 0,0:20:38.30,0:20:42.97,Default,,0,0,0,,Ах аа... аа~! Пупупу... Пуи~
Dialogue: 0,0:20:42.97,0:20:45.31,Default,,0,0,0,,Айка-чан өте керемет!
Dialogue: 0,0:20:45.31,0:20:47.64,Default,,0,0,0,,Иә, ұятсыз жолдарға тыйым салынады!
Dialogue: 0,0:20:47.64,0:20:50.58,Default,,0,0,0,,Пупупуиню! (Президент Химе) Мяу
Dialogue: 0,0:20:50.58,0:20:54.58,Default,,0,0,0,,Сіз жылдам кесіндіңіз. Бұл өте қатты қысқарту болды.
Dialogue: 0,0:20:54.58,0:20:56.98,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:20:58.92,0:21:03.26,Default,,0,0,0,,Бұл шаш үлгісі Айка-чанға қатты ұқсайды.
Dialogue: 0,0:21:03.26,0:21:07.26,Default,,0,0,0,,күрсініп... Алисия-сан
Dialogue: 0,0:21:07.26,0:21:09.26,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:21:09.26,0:21:11.27,Default,,0,0,0,,Иә, жақсы
Dialogue: 0,0:21:11.27,0:21:15.57,Default,,0,0,0,,Бұл тұрақты және жігерлі Айка-чан үшін өте қолайлы.
Dialogue: 0,0:21:18.27,0:21:20.98,Default,,0,0,0,,Рахмет...
Dialogue: 0,0:21:25.28,0:21:27.28,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:31.95,0:21:34.62,Default,,0,0,0,,Жарайды, онда бастайық.
Dialogue: 0,0:21:34.62,0:21:37.02,Default,,0,0,0,,Иә! (Президент Ария) Пуи!
Dialogue: 0,0:21:41.96,0:21:45.97,Default,,0,0,0,,Бұл дәмді~ Бұл үлкен және дәмді.
Dialogue: 0,0:21:45.97,0:21:48.64,Default,,0,0,0,,Өте дәмді~
Dialogue: 0,0:21:48.64,0:21:51.57,Default,,0,0,0,,Жұмыс біткеннен кейін ет дәмді болады.
Dialogue: 0,0:21:51.57,0:21:54.58,Default,,0,0,0,,Жоқ, мен де көкөніс жеуім керек.
Dialogue: 0,0:21:54.58,0:21:57.24,Default,,0,0,0,,Жақсы емес, Акира-чан
Dialogue: 0,0:21:57.24,0:22:02.25,Default,,0,0,0,,Тағы да бар, мүмкіндігінше тамақтаныңыз!
Dialogue: 0,0:22:02.25,0:22:05.59,Default,,0,0,0,,<Ай-чан Айка-чан екен➡
Dialogue: 0,0:22:05.59,0:22:10.59,Default,,0,0,0,,Мен өзімнің жаңа, керемет нұсқамды тапқан сияқтымын.＞
Dialogue: 0,0:22:12.93,0:22:16.26,Default,,0,0,0,,<Мен Акари-сан мен Айка-санның суреттерін көрдім➡
Dialogue: 0,0:22:16.26,0:22:19.27,Default,,0,0,0,,Мен оның шынымен қысқа болғанына таң қалдым>
Dialogue: 0,0:22:19.27,0:22:23.94,Default,,0,0,0,,<Жаңа сүйкімділік ашқанда мен қатты толқыдым>
Dialogue: 0,0:22:23.94,0:22:28.61,Default,,0,0,0,,<Шашлык қызық сияқты. Мен де қосылғым келеді.>
Dialogue: 0,0:22:28.61,0:22:32.28,Default,,0,0,0,,<Мен Нео Венецияға қайта барғым келеді>
