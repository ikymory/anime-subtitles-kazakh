Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.31,0:00:14.64,Default,,0,0,0,,<Акари-сан, мұнда қыс болып қалды>
Dialogue: 0,0:00:14.64,0:00:19.31,Default,,0,0,0,,<Алайда, мүлдем суық емес...>
Dialogue: 0,0:00:19.31,0:00:22.65,Default,,0,0,0,,<Нео Венецияда әлі ыстық емес пе? ＞
Dialogue: 0,0:00:22.65,0:00:24.65,Default,,0,0,0,,<Бірақ ыстық болғандықтан➡
Dialogue: 0,0:00:24.65,0:00:28.32,Default,,0,0,0,,Сіз керемет заттардың сұлулығын түсінесіз, солай ма?
Dialogue: 0,0:00:28.32,0:00:32.66,Default,,0,0,0,,<Жел, су дыбысы, көлеңке➡
Dialogue: 0,0:00:32.66,0:00:37.00,Default,,0,0,0,,Мұзды сүт қорқынышты оқиға＞
Dialogue: 0,0:00:37.00,0:00:41.00,Default,,0,0,0,,<Аа, саған қорқынышты әңгіме керек емес пе? ＞
Dialogue: 0,0:00:46.34,0:00:49.04,Default,,0,0,0,,Пуиню~
Dialogue: 0,0:00:52.35,0:00:57.02,Default,,0,0,0,,Президент Ария, суық тиген кезде абай болу керек.
Dialogue: 0,0:00:57.02,0:01:01.29,Default,,0,0,0,,Серуенге шықпау керек...
Dialogue: 0,0:01:01.29,0:01:06.63,Default,,0,0,0,,Егер сен жақсы бала болсаң, мен саған президент жақсы көретін шабдалы банкісін сатып аламын.
Dialogue: 0,0:01:06.63,0:01:10.30,Default,,0,0,0,,Пуинюпуи, онда мен барамын.
Dialogue: 0,0:01:10.30,0:01:12.30,Default,,0,0,0,,Пуинюпуи~
Dialogue: 0,0:01:12.30,0:01:17.31,Default,,0,0,0,,♬～
Dialogue: 0,0:01:17.31,0:01:19.64,Default,,0,0,0,,Пуиню…
Dialogue: 0,0:01:19.64,0:01:39.66,Default,,0,0,0,,♬～
Dialogue: 0,0:01:39.66,0:01:59.68,Default,,0,0,0,,♬～
Dialogue: 0,0:01:59.68,0:02:19.63,Default,,0,0,0,,♬～
Dialogue: 0,0:02:19.63,0:02:39.66,Default,,0,0,0,,♬～
Dialogue: 0,0:02:39.66,0:02:52.37,Default,,0,0,0,,♬～
Dialogue: 0,0:03:27.30,0:03:29.64,Default,,0,0,0,,Бірінші!
Dialogue: 0,0:03:29.64,0:03:33.98,Default,,0,0,0,,(Адамдар сөйлейді)
Dialogue: 0,0:03:33.98,0:03:46.32,Default,,0,0,0,,♬～
Dialogue: 0,0:03:46.32,0:03:48.66,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:03:48.66,0:03:57.67,Default,,0,0,0,,♬～
Dialogue: 0,0:03:57.67,0:03:59.67,Default,,0,0,0,,Я...
Dialogue: 0,0:03:59.67,0:04:09.61,Default,,0,0,0,,♬～
Dialogue: 0,0:04:09.61,0:04:11.61,Default,,0,0,0,,Жоқ...?
Dialogue: 0,0:04:11.61,0:04:20.62,Default,,0,0,0,,♬～
Dialogue: 0,0:04:20.62,0:04:23.29,Default,,0,0,0,,Қара түсті көйлек...
Dialogue: 0,0:04:23.29,0:04:25.59,Default,,0,0,0,,Ыстық емес пе?
Dialogue: 0,0:04:27.30,0:04:31.63,Default,,0,0,0,,Акари, күткеніңізге рахмет~ Ай, Айка-чан
Dialogue: 0,0:04:31.63,0:04:35.30,Default,,0,0,0,,Эй~ Бүгін де ыстық~
Dialogue: 0,0:04:35.30,0:04:37.31,Default,,0,0,0,,<Қолдамаңыз>
Dialogue: 0,0:04:37.31,0:04:40.64,Default,,0,0,0,,<Адамға қадала қарау дөрекі емес пе?>
Dialogue: 0,0:04:40.64,0:04:45.65,Default,,0,0,0,,Мм, қызық, қызба, пони жігіт, жұмыста әлсіреп жатқан жоқсың ба?
Dialogue: 0,0:04:45.65,0:04:49.32,Default,,0,0,0,,Хехе... Акацуки-сан, жақсысың ба?
Dialogue: 0,0:04:49.32,0:04:52.65,Default,,0,0,0,,Маған анау қызу жігіт бәрібір.
Dialogue: 0,0:04:52.65,0:04:56.66,Default,,0,0,0,,Хух~ Өйткені Айка-чан Акацуки-сан туралы айта бастады.
Dialogue: 0,0:04:56.66,0:04:58.66,Default,,0,0,0,,Шарап
Dialogue: 0,0:05:02.93,0:05:07.27,Default,,0,0,0,,Аа, мен бұл ыстықта істей алмаймын.
Dialogue: 0,0:05:07.27,0:05:10.27,Default,,0,0,0,,Гондолалар қара және жылуды ұстайды.
Dialogue: 0,0:05:10.27,0:05:14.28,Default,,0,0,0,,Кенже әлі келген жоқ, хехехе...
Dialogue: 0,0:05:14.28,0:05:19.28,Default,,0,0,0,,Бұл жерде жаз, енді осы қаладағы әйгілі елестер туралы не айтасыз?
Dialogue: 0,0:05:19.28,0:05:24.95,Default,,0,0,0,,Қорқынышты оқиғалар жақсы, өйткені олар қорқынышты...
Dialogue: 0,0:05:24.95,0:05:29.96,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ, жоқ, күн ыстықта, ең жақсы нәрсе - елес әңгімемен суыту!
Dialogue: 0,0:05:30.96,0:05:33.63,Default,,0,0,0,,Бұл сонымен қатар Сан-Марко алаңының әйгілі ерекшелігі.
Dialogue: 0,0:05:33.63,0:05:37.30,Default,,0,0,0,,Сіз бұл екі тірек туралы білесіз бе?
Dialogue: 0,0:05:37.30,0:05:39.63,Default,,0,0,0,,Иә, ә...
Dialogue: 0,0:05:39.63,0:05:42.97,Default,,0,0,0,,<Иә? Бұрынғы адам кетті>
Dialogue: 0,0:05:42.97,0:05:47.64,Default,,0,0,0,,Бұл тірек Manhom's Venice-тен бері бар.
Dialogue: 0,0:05:47.64,0:05:50.98,Default,,0,0,0,,Бұл қаланың негізгі кіреберісі болып саналды.
Dialogue: 0,0:05:50.98,0:05:56.99,Default,,0,0,0,,Баяғыда, ортағасырлық Венеция Республикасында.
Dialogue: 0,0:05:56.99,0:06:03.99,Default,,0,0,0,,Ол қылмыскерлерді ашық жазалау орны ретінде де пайдаланылды.
Dialogue: 0,0:06:06.93,0:06:09.26,Default,,0,0,0,,Өтірік... шынымен
Dialogue: 0,0:06:09.26,0:06:14.94,Default,,0,0,0,,Бұл жаздың ыстық күні еді
Dialogue: 0,0:06:14.94,0:06:19.94,Default,,0,0,0,,Өлім жазасына кесілген әйел шенеуніктерге көзіне жас алып жалынады.
Dialogue: 0,0:06:19.94,0:06:24.95,Default,,0,0,0,,Мен өз мәйітті зират аралы болып табылатын Сан-Мишель аралында жерлеуді қалаймын.
Dialogue: 0,0:06:24.95,0:06:30.62,Default,,0,0,0,,Өйткені онда әкем мен шешем ұйықтап жатыр.
Dialogue: 0,0:06:30.62,0:06:33.62,Default,,0,0,0,,Бірақ... сол кезде
Dialogue: 0,0:06:33.62,0:06:36.96,Default,,0,0,0,,Сан-Мишель аралындағы зират қазірдің өзінде лық толы.
Dialogue: 0,0:06:36.96,0:06:41.30,Default,,0,0,0,,Оның тілегі естілмеді.
Dialogue: 0,0:06:41.30,0:06:45.30,Default,,0,0,0,,Ал әйел өлім жазасына кесілді
Dialogue: 0,0:06:45.30,0:06:47.97,Default,,0,0,0,,Алайда содан бері
Dialogue: 0,0:06:47.97,0:06:52.31,Default,,0,0,0,,Жан түршігерлік оқиғалар бола бастады.
Dialogue: 0,0:06:52.31,0:06:56.98,Default,,0,0,0,,Қалалық гондолист түнде бағананың жанында жалғыз қалғанда,
Dialogue: 0,0:06:56.98,0:07:00.25,Default,,0,0,0,,Ойда жоқта жоқтау киінген әйел пайда болды.
Dialogue: 0,0:07:00.25,0:07:03.25,Default,,0,0,0,,«Ол гондоланы Сан-Мишель аралына апарыңыз➡
Dialogue: 0,0:07:03.25,0:07:07.59,Default,,0,0,0,,Барыңыз.''
Dialogue: 0,0:07:07.59,0:07:12.59,Default,,0,0,0,,Бірақ онымен ешқашан бармау керек.
Dialogue: 0,0:07:12.59,0:07:15.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:07:16.93,0:07:22.24,Default,,0,0,0,,Өйткені, сіз міндетті түрде жігерленесіз.
Dialogue: 0,0:07:23.61,0:07:25.94,Default,,0,0,0,,Қорқынышты! Қорқынышты қорқынышты!
Dialogue: 0,0:07:25.94,0:07:29.28,Default,,0,0,0,,Бірақ елес Венецияда, Мангомда болды.
Dialogue: 0,0:07:29.28,0:07:32.28,Default,,0,0,0,,Бұл Aqua's Neo Venice екеніне қуаныштымын.
Dialogue: 0,0:07:32.28,0:07:35.28,Default,,0,0,0,,Хехехе... иә? не?
Dialogue: 0,0:07:35.28,0:07:39.62,Default,,0,0,0,,Бұл тәтті, Акари, не?
Dialogue: 0,0:07:39.62,0:07:44.29,Default,,0,0,0,,Сіз пайда болғалы тұрған сияқтысыз.
Dialogue: 0,0:07:44.29,0:07:47.96,Default,,0,0,0,,Сондай-ақ осы Нео-Венецияда.
Dialogue: 0,0:07:47.96,0:07:51.27,Default,,0,0,0,,Өзіме пластырь жапсыра аламын.
Dialogue: 0,0:07:54.97,0:07:56.97,Default,,0,0,0,,(Шинобу) Мұнда кездейсоқ біреуді білетін адам бар ма?
Dialogue: 0,0:07:56.97,0:07:58.97,Default,,0,0,0,,Ұзақ күткенім үшін кешіріңіз.
Dialogue: 0,0:07:58.97,0:08:02.58,Default,,0,0,0,,Алиса! Ха...
Dialogue: 0,0:08:02.58,0:08:06.25,Default,,0,0,0,,Не болды? Акари-сенпай: Аа, аа... ааа...
Dialogue: 0,0:08:06.25,0:08:09.58,Default,,0,0,0,,Пупупупупу, сәл салқындап қалды~
Dialogue: 0,0:08:09.58,0:08:11.92,Default,,0,0,0,,Иә...
Dialogue: 0,0:08:11.92,0:08:16.52,Default,,0,0,0,,(қоңырау)
Dialogue: 0,0:08:36.61,0:08:39.61,Default,,0,0,0,,Акари шынымен қорқынышты.
Dialogue: 0,0:08:39.61,0:08:42.62,Default,,0,0,0,,Егер сіз қорқынышты оқиғалар туралы айтатын болсаңыз, мен көп нәрсені білемін.
Dialogue: 0,0:08:42.62,0:08:46.62,Default,,0,0,0,,О, онда біз бүгін қорқынышты әңгімелер сайысын өткіземіз бе?
Dialogue: 0,0:08:46.62,0:08:48.62,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:08:53.96,0:08:57.30,Default,,0,0,0,,Бірақ менің ойымша, Акари-сенпай
Dialogue: 0,0:08:57.30,0:09:00.90,Default,,0,0,0,,Сізде жұмбақ құбылыстарды оңай тартатын конституция бар сияқты.
Dialogue: 0,0:09:00.90,0:09:03.57,Default,,0,0,0,,Менің ойымша, үлкен нәрсеге абай болу керек.
Dialogue: 0,0:09:03.57,0:09:06.57,Default,,0,0,0,,Иә, сіз мұны айта аласыз деп ойлаймын.
Dialogue: 0,0:09:06.57,0:09:10.98,Default,,0,0,0,,Ал, абай болу үшін не істеуім керек?
Dialogue: 0,0:09:12.91,0:09:18.22,Default,,0,0,0,,Қалай болғанда да, бәрі тамаша! Бұл сіз оған жақындай алмайсыз дегенді білдіре ме?
Dialogue: 0,0:09:21.59,0:09:25.59,Default,,0,0,0,,Қауіпті иісті байқасаңыз, аулақ болыңыз.
Dialogue: 0,0:09:25.59,0:09:28.26,Default,,0,0,0,,Иә... түсіндім.
Dialogue: 0,0:09:28.26,0:09:39.94,Default,,0,0,0,,♬～
Dialogue: 0,0:09:39.94,0:09:42.94,Default,,0,0,0,,Олай болса, еңбектеріңіз үшін тағы да рахмет.
Dialogue: 0,0:09:42.94,0:09:46.95,Default,,0,0,0,,Ерен еңбегіңіз үшін рахмет~ Президент Арияға сәлем жолдаңыз
Dialogue: 0,0:09:46.95,0:09:51.29,Default,,0,0,0,,Өзіңізді күтіңіз, көп рахмет.
Dialogue: 0,0:09:51.29,0:09:59.29,Default,,0,0,0,,♬～
Dialogue: 0,0:09:59.29,0:10:02.96,Default,,0,0,0,,Бір банка шабдалы сатып алайық, үйге ерте қайтайық.
Dialogue: 0,0:10:29.96,0:10:32.29,Default,,0,0,0,,Мен кешігіп қалдым, бірақ
Dialogue: 0,0:10:32.29,0:10:36.97,Default,,0,0,0,,Мен Президент Арияның сүйікті консервіленген шабдалысын тапқаныма қуаныштымын.
Dialogue: 0,0:10:36.97,0:10:40.97,Default,,0,0,0,,Президент Ария, өзіңізді жақсы сезінесіз бе?
Dialogue: 0,0:11:14.94,0:11:18.54,Default,,0,0,0,,Кешіріңіз, бұл гондола...
Dialogue: 0,0:11:22.94,0:11:26.55,Default,,0,0,0,,<Күндізгі уақытта қара көйлек киген адам...>
Dialogue: 0,0:11:37.29,0:11:39.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:40.30,0:11:44.30,Default,,0,0,0,,Өтінемін, Ундин мырза.
Dialogue: 0,0:11:46.30,0:11:49.90,Default,,0,0,0,,Кешіріңіз, мен жартылай ғана толдым.
Dialogue: 0,0:11:49.90,0:11:53.91,Default,,0,0,0,,Жолаушыны жалғыз көтере алмаймын.
Dialogue: 0,0:11:53.91,0:11:57.91,Default,,0,0,0,,Ой, кешіріңіз.
Dialogue: 0,0:11:57.91,0:11:59.91,Default,,0,0,0,,Бірақ мен қиындыққа тап болдым.
Dialogue: 0,0:11:59.91,0:12:04.25,Default,,0,0,0,,Қалған гондолалар біткен сияқты.
Dialogue: 0,0:12:04.25,0:12:07.26,Default,,0,0,0,,<Мүмкін қазір мен➡
Dialogue: 0,0:12:07.26,0:12:10.96,Default,,0,0,0,,Менде өте өрескел түсініспеушілік болған шығар...>
Dialogue: 0,0:12:21.27,0:12:23.27,Default,,0,0,0,,Ум...
Dialogue: 0,0:12:24.61,0:12:28.28,Default,,0,0,0,,Мен саған көлік берейін бе? сурет?
Dialogue: 0,0:12:28.28,0:12:31.61,Default,,0,0,0,,Тұтынушылар міне алмайды деген ереже бар.
Dialogue: 0,0:12:31.61,0:12:35.28,Default,,0,0,0,,Біздің дос болғанымызға қалай қарайсың?
Dialogue: 0,0:12:35.28,0:12:39.29,Default,,0,0,0,,Рахмет, бұл пайдалы.
Dialogue: 0,0:12:39.29,0:12:44.29,Default,,0,0,0,,Сен жақсы қызсың ғой...
Dialogue: 0,0:12:45.63,0:12:48.63,Default,,0,0,0,,Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:12:48.63,0:12:51.23,Default,,0,0,0,,Кездесу…
Dialogue: 0,0:12:51.23,0:12:54.24,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:12:54.24,0:12:57.94,Default,,0,0,0,,Енді қайда бару керектігін айтыңызшы.
Dialogue: 0,0:12:59.57,0:13:02.24,Default,,0,0,0,,Сан-Мишель аралына
Dialogue: 0,0:13:02.24,0:13:04.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:04.25,0:13:08.25,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:13:08.25,0:13:17.26,Default,,0,0,0,,♬～
Dialogue: 0,0:13:17.26,0:13:22.26,Default,,0,0,0,,Президент Ария: Түнгі желге ұшырау суық тиюді күшейтеді.
Dialogue: 0,0:13:22.26,0:13:24.27,Default,,0,0,0,,Пуинью
Dialogue: 0,0:13:26.93,0:13:30.61,Default,,0,0,0,,Акари-чан, сен кешігіп қалдың.
Dialogue: 0,0:13:30.61,0:13:50.56,Default,,0,0,0,,♬～
Dialogue: 0,0:13:50.56,0:13:54.23,Default,,0,0,0,,♬～
Dialogue: 0,0:13:54.23,0:14:00.23,Default,,0,0,0,,<Аквадағы Сан-Мишель аралы да Мэнхоум сияқты тек зираты бар арал>
Dialogue: 0,0:14:01.24,0:14:04.57,Default,,0,0,0,,<Бұл адам түнде Сан-Мишель аралында➡
Dialogue: 0,0:14:04.57,0:14:07.24,Default,,0,0,0,,Маған қызық, сізде қандай кәсіп бар...＞
Dialogue: 0,0:14:07.24,0:14:27.26,Default,,0,0,0,,♬～
Dialogue: 0,0:14:27.26,0:14:47.28,Default,,0,0,0,,♬～
Dialogue: 0,0:14:47.28,0:14:50.22,Default,,0,0,0,,♬～
Dialogue: 0,0:14:50.22,0:14:53.52,Default,,0,0,0,,<Бұл көйлек жоқтау көйлегі ме? ＞
Dialogue: 0,0:14:58.56,0:15:03.23,Default,,0,0,0,,《Онымен ешқашан бармау керек.》
Dialogue: 0,0:15:03.23,0:15:05.53,Default,,0,0,0,,《Неге? 》
Dialogue: 0,0:15:06.90,0:15:11.21,Default,,0,0,0,,《Себебі сіз міндетті түрде жігерленесіз》
Dialogue: 0,0:15:14.24,0:15:18.91,Default,,0,0,0,,<Мен бұл туралы ойламауға тырысамын, бірақ бұл туралы ойламауға тырысамын➡
Dialogue: 0,0:15:18.91,0:15:25.22,Default,,0,0,0,,Айка-чанның әңгімесі мені түннің толқындарымен шайып жатыр>
Dialogue: 0,0:15:44.27,0:15:46.27,Default,,0,0,0,,келді
Dialogue: 0,0:15:54.55,0:15:58.95,Default,,0,0,0,,Сізге үлкен рахмет, бұл өте пайдалы болды.
Dialogue: 0,0:15:59.89,0:16:04.19,Default,,0,0,0,,Олай болса, мен бұл жерде кешірім сұраймын.
Dialogue: 0,0:16:10.90,0:16:13.57,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:13.57,0:16:16.27,Default,,0,0,0,,А... а...
Dialogue: 0,0:16:18.24,0:16:21.24,Default,,0,0,0,,Сен өте жақсы қызсың.
Dialogue: 0,0:16:21.24,0:16:23.24,Default,,0,0,0,,Кешір… (Иура) Қайдағы жоқ.
Dialogue: 0,0:16:23.24,0:16:32.25,Default,,0,0,0,,♬～
Dialogue: 0,0:16:32.25,0:16:34.92,Default,,0,0,0,,Мен сенімен мәңгі бірге болғым келеді
Dialogue: 0,0:16:34.92,0:16:38.59,Default,,0,0,0,,<Не? не болып жатыр? ＞
Dialogue: 0,0:16:38.59,0:16:42.60,Default,,0,0,0,,《Себебі сіз міндетті түрде жігерленесіз》
Dialogue: 0,0:16:42.60,0:16:48.27,Default,,0,0,0,,♬～
Dialogue: 0,0:16:48.27,0:16:53.88,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:16:53.88,0:16:55.88,Default,,0,0,0,,Ей, жартылай жұмыс істейтін! Алдыңа шықшы, өтінемін!
Dialogue: 0,0:16:55.88,0:17:01.22,Default,,0,0,0,,Ха ха ха ха... Не болды? ерте тұру
Dialogue: 0,0:17:01.22,0:17:06.22,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:17:10.89,0:17:12.89,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:17:18.90,0:17:22.24,Default,,0,0,0,,А... жарайды.
Dialogue: 0,0:17:22.24,0:17:25.91,Default,,0,0,0,,Біз жақсы тіл табыса аламыз.
Dialogue: 0,0:17:25.91,0:17:30.91,Default,,0,0,0,,Өйткені... біз доспыз.
Dialogue: 0,0:17:35.25,0:17:37.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:40.59,0:17:44.59,Default,,0,0,0,,(Жел биінің дыбысы)
Dialogue: 0,0:17:57.20,0:17:59.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:00.88,0:18:02.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:24.57,0:18:26.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:26.57,0:18:46.59,Default,,0,0,0,,♬～
Dialogue: 0,0:18:46.59,0:19:06.54,Default,,0,0,0,,♬～
Dialogue: 0,0:19:06.54,0:19:12.88,Default,,0,0,0,,♬～
Dialogue: 0,0:19:12.88,0:19:14.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:16.55,0:19:19.89,Default,,0,0,0,,Иә? Ах...
Dialogue: 0,0:19:19.89,0:19:21.89,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:19:21.89,0:19:25.56,Default,,0,0,0,,Пуиню~ Күшік…
Dialogue: 0,0:19:25.56,0:19:27.90,Default,,0,0,0,,Президент Ария
Dialogue: 0,0:19:27.90,0:19:29.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:31.57,0:19:33.97,Default,,0,0,0,,Жапырақшалар
Dialogue: 0,0:19:34.90,0:19:37.91,Default,,0,0,0,,Ах... ааа...
Dialogue: 0,0:19:37.91,0:19:40.57,Default,,0,0,0,,Президент Ария~!
Dialogue: 0,0:19:40.57,0:19:42.58,Default,,0,0,0,,Пуиню~
Dialogue: 0,0:19:42.58,0:19:45.58,Default,,0,0,0,,Акари-чан⁉ Ах, Алисия-сан
Dialogue: 0,0:19:45.58,0:19:47.58,Default,,0,0,0,,Акари-чан...
Dialogue: 0,0:19:47.58,0:19:50.28,Default,,0,0,0,,Акари-чан! Алисия!
Dialogue: 0,0:19:51.59,0:19:54.92,Default,,0,0,0,,Мен уайымдадым. Сен қайда болдың?
Dialogue: 0,0:19:54.92,0:19:58.59,Default,,0,0,0,,Кешіріңіз, мен қара көйлек киген әйелді алдым.
Dialogue: 0,0:19:58.59,0:20:00.93,Default,,0,0,0,,Сан-Мишель аралына барыңыз
Dialogue: 0,0:20:00.93,0:20:03.93,Default,,0,0,0,,Сөйтіп олар мені зиратқа апарды.
Dialogue: 0,0:20:03.93,0:20:07.60,Default,,0,0,0,,Мен қорқамын, ештеңе істей алмаймын
Dialogue: 0,0:20:07.60,0:20:09.60,Default,,0,0,0,,Содан кейін...
Dialogue: 0,0:20:11.61,0:20:15.61,Default,,0,0,0,,Кейт Сит пайда болады, содан кейін
Dialogue: 0,0:20:15.61,0:20:19.95,Default,,0,0,0,,Мен білмей тұрып, мен террасада болдым ...
Dialogue: 0,0:20:19.95,0:20:24.29,Default,,0,0,0,,Осындай сұмдық оқиға болды ма?
Dialogue: 0,0:20:24.29,0:20:27.96,Default,,0,0,0,,Бірақ мен Акари-чанның қауіпсіз болғанына өте қуаныштымын.
Dialogue: 0,0:20:27.96,0:20:31.63,Default,,0,0,0,,Иә... қорқынышты болды~
Dialogue: 0,0:20:31.63,0:20:34.96,Default,,0,0,0,,О, менің (Президент Ария) Пфф...
Dialogue: 0,0:20:34.96,0:20:37.57,Default,,0,0,0,,Puppupuinyu…
Dialogue: 0,0:20:41.30,0:20:43.97,Default,,0,0,0,,Жоқтаушы әйел⁉
Dialogue: 0,0:20:43.97,0:20:48.31,Default,,0,0,0,,Әлбетте, мен естіген адам сол.
Dialogue: 0,0:20:48.31,0:20:50.58,Default,,0,0,0,,Сонда қалай құтылдың?
Dialogue: 0,0:20:50.58,0:20:54.25,Default,,0,0,0,,Иә, Кейт Сит... Иә?
Dialogue: 0,0:20:54.25,0:20:57.25,Default,,0,0,0,,Кэйт Ситті жоқтаудағы әйел
Dialogue: 0,0:20:57.25,0:20:59.59,Default,,0,0,0,,Ол үлкен жұмбақтарға толы.
Dialogue: 0,0:20:59.59,0:21:01.92,Default,,0,0,0,,Қорқынышты! Қорқынышты!
Dialogue: 0,0:21:01.92,0:21:05.59,Default,,0,0,0,,Бірақ бұл жай ғана арман болуы мүмкін... Бұл қорқынышты!
Dialogue: 0,0:21:05.59,0:21:09.26,Default,,0,0,0,,Сан-Мишель аралында ғана гүлдейтін гүл жапырақтары
Dialogue: 0,0:21:09.26,0:21:13.27,Default,,0,0,0,,Маған қайта көрсетіңізші. Жарайды, иә.
Dialogue: 0,0:21:14.60,0:21:17.27,Default,,0,0,0,,Гяпи~!
Dialogue: 0,0:21:17.27,0:21:20.61,Default,,0,0,0,,Сол әңгіменің жалғасы бар екенін білесіз бе?
Dialogue: 0,0:21:20.61,0:21:24.61,Default,,0,0,0,,Не? Ортағасырлық Венеция Республикасында
Dialogue: 0,0:21:24.61,0:21:27.95,Default,,0,0,0,,Ашық өлім жазасына кесілгенімен,
Dialogue: 0,0:21:27.95,0:21:31.62,Default,,0,0,0,,Қылмыскер жерлеуге орын сұрағаны туралы жазба жоқ.
Dialogue: 0,0:21:31.62,0:21:34.29,Default,,0,0,0,,Бірінші кезекте осындай елес әңгімелер
Dialogue: 0,0:21:34.29,0:21:37.96,Default,,0,0,0,,Адам үйі дәуірінде қалада мұндай нәрсе болмаған сияқты.
Dialogue: 0,0:21:37.96,0:21:41.30,Default,,0,0,0,,Елес оқиға олар Акваға қоныстанғаннан кейін айтылды.
Dialogue: 0,0:21:41.30,0:21:44.63,Default,,0,0,0,,Бұл қаладағы біреудің ойдан шығарған әңгімесі болса керек.
Dialogue: 0,0:21:44.63,0:21:47.97,Default,,0,0,0,,А-а... Басқаша айтқанда, сіз өсек-аяңсыз.
Dialogue: 0,0:21:47.97,0:21:50.57,Default,,0,0,0,,Нео-Венецияда жасалған жалған оқиға
Dialogue: 0,0:21:50.57,0:21:53.91,Default,,0,0,0,,Сонда Венецияда ондай елес хикаялары болған емес пе?
Dialogue: 0,0:21:53.91,0:21:56.91,Default,,0,0,0,,Иә, бірақ бұл жолы Акариді қосқанда.
Dialogue: 0,0:21:56.91,0:22:01.58,Default,,0,0,0,,Нео Венецияда сізді көрген көптеген қауесеттер бар.
Dialogue: 0,0:22:01.58,0:22:04.25,Default,,0,0,0,,Иә
Dialogue: 0,0:22:04.25,0:22:06.25,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:22:06.25,0:22:08.59,Default,,0,0,0,,Неліктен өткендегі елестер фантастика деп есептеледі?
Dialogue: 0,0:22:08.59,0:22:11.59,Default,,0,0,0,,Сіз шынымен болашақтың осы қаласындасыз ба?
Dialogue: 0,0:22:11.59,0:22:16.60,Default,,0,0,0,,Қорыққаныңыз осы емес пе? (Ал, президент) Ал...
Dialogue: 0,0:22:18.60,0:22:23.60,Default,,0,0,0,,(үшін айғайлайды)
Dialogue: 0,0:22:23.60,0:22:27.94,Default,,0,0,0,,<Ай-чан, маған да не болды?➡
Dialogue: 0,0:22:27.94,0:22:30.28,Default,,0,0,0,,Мен түсінбеймін＞
Dialogue: 0,0:22:30.28,0:22:34.62,Default,,0,0,0,,<Мүмкін Кэйт Сит маған көмектескен шығар? ＞
Dialogue: 0,0:22:34.62,0:22:54.57,Default,,0,0,0,,♬～
Dialogue: 0,0:22:54.57,0:23:14.59,Default,,0,0,0,,♬～
Dialogue: 0,0:23:14.59,0:23:34.61,Default,,0,0,0,,♬～
Dialogue: 0,0:23:34.61,0:23:54.30,Default,,0,0,0,,♬～
