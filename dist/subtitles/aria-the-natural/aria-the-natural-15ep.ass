Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.63,0:00:05.97,Default,,0,0,0,,<Ай-чан, Нео Венеция осында➡
Dialogue: 0,0:00:05.97,0:00:09.27,Default,,0,0,0,,Күн сайын жаз қызып тұрғандай сезіледі＞
Dialogue: 0,0:00:10.31,0:00:14.64,Default,,0,0,0,,<Таңертеңгілік бірлескен жаттығу әдеттегідей таңертең аяқталды➡
Dialogue: 0,0:00:14.64,0:00:17.35,Default,,0,0,0,,Алиса мектепте＞
Dialogue: 0,0:00:18.65,0:00:20.65,Default,,0,0,0,,<Әдетте осыдан кейін➡
Dialogue: 0,0:00:20.65,0:00:23.99,Default,,0,0,0,,Мен де түстен кейін Айка-чанмен жаттығу жасаймын➡
Dialogue: 0,0:00:23.99,0:00:27.66,Default,,0,0,0,,Айка-чанның бүгін дүкенге бару жоспары бар➡
Dialogue: 0,0:00:27.66,0:00:30.33,Default,,0,0,0,,Түстен кейін жабық>
Dialogue: 0,0:00:30.33,0:00:34.00,Default,,0,0,0,,<Президент Ария туралы айту...>
Dialogue: 0,0:00:34.00,0:00:38.00,Default,,0,0,0,,Пуи Пуиню~ (Әйел) Уфуфуфу
Dialogue: 0,0:00:38.00,0:00:42.00,Default,,0,0,0,,Пуи! (Әйел) Күрсініп... Сүйкімді!
Dialogue: 0,0:00:42.00,0:00:45.34,Default,,0,0,0,,Уууаа (Президент Арияның қиын дауысы)
Dialogue: 0,0:00:45.34,0:00:49.34,Default,,0,0,0,,Жабысқақ емес, әй, һехехе
Dialogue: 0,0:00:50.68,0:00:55.68,Default,,0,0,0,,<Мысықты жақсы көретін тұтынушының өтініші бойынша Алисиямен жұмыс>
Dialogue: 0,0:00:55.68,0:00:58.69,Default,,0,0,0,,＜Бүгін түстен кейін мен➡
Dialogue: 0,0:00:58.69,0:01:02.39,Default,,0,0,0,,Менің жалғыз түскі ас ішуім сирек кездеседі＞
Dialogue: 0,0:01:03.29,0:01:08.30,Default,,0,0,0,,♬～
Dialogue: 0,0:01:08.30,0:01:10.30,Default,,0,0,0,,Хааа~
Dialogue: 0,0:01:10.30,0:01:12.30,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:12.30,0:01:32.32,Default,,0,0,0,,♬～
Dialogue: 0,0:01:32.32,0:01:52.34,Default,,0,0,0,,♬～
Dialogue: 0,0:01:52.34,0:02:12.29,Default,,0,0,0,,♬～
Dialogue: 0,0:02:12.29,0:02:32.31,Default,,0,0,0,,♬～
Dialogue: 0,0:02:32.31,0:02:42.62,Default,,0,0,0,,♬～
Dialogue: 0,0:02:47.66,0:02:52.67,Default,,0,0,0,,(цикада дауысы)
Dialogue: 0,0:02:54.67,0:02:56.67,Default,,0,0,0,,Әдемі...
Dialogue: 0,0:02:56.67,0:02:59.34,Default,,0,0,0,,Бәрін өзіңе сақтау
Dialogue: 0,0:02:59.34,0:03:02.61,Default,,0,0,0,,Бұл ысырап сияқты.
Dialogue: 0,0:03:02.61,0:03:04.95,Default,,0,0,0,,Акари-чан, аа...
Dialogue: 0,0:03:04.95,0:03:06.95,Default,,0,0,0,,Сәлем! (Акира) Бір адам?
Dialogue: 0,0:03:06.95,0:03:10.29,Default,,0,0,0,,Ах, Акира-сан... Иә, мен жалғызбын.
Dialogue: 0,0:03:10.29,0:03:12.29,Default,,0,0,0,,Мен сенімен түскі ас ішуге бола ма?
Dialogue: 0,0:03:12.29,0:03:14.59,Default,,0,0,0,,Иә, сөзсіз!
Dialogue: 0,0:03:16.96,0:03:20.63,Default,,0,0,0,,Акира-сан, сен жұмыстан шықтың ба?
Dialogue: 0,0:03:20.63,0:03:22.96,Default,,0,0,0,,А, түстен кейін.
Dialogue: 0,0:03:22.96,0:03:25.63,Default,,0,0,0,,Мен кездейсоқ осы алаңда наубайханада болдым.
Dialogue: 0,0:03:25.63,0:03:27.97,Default,,0,0,0,,Мен дүкен аралап жүрдім.
Dialogue: 0,0:03:27.97,0:03:31.31,Default,,0,0,0,,Мұндағы жаңғақ нан өте жақсы.
Dialogue: 0,0:03:31.31,0:03:35.31,Default,,0,0,0,,Хехе, түсіндім.
Dialogue: 0,0:03:35.31,0:03:38.31,Default,,0,0,0,,Ауа-райы жағымды, солай емес пе?
Dialogue: 0,0:03:38.31,0:03:42.65,Default,,0,0,0,,Иә? Аа, дұрыс
Dialogue: 0,0:03:42.65,0:03:45.99,Default,,0,0,0,,Сіздің арқаңызда жаңғақ нанының дәмі одан да дәмді болады.
Dialogue: 0,0:03:45.99,0:03:47.99,Default,,0,0,0,,Уау
Dialogue: 0,0:03:47.99,0:04:07.61,Default,,0,0,0,,♬～
Dialogue: 0,0:04:07.61,0:04:12.95,Default,,0,0,0,,Аспанға қанша қарасам да, одан жалықпаймын.
Dialogue: 0,0:04:12.95,0:04:14.95,Default,,0,0,0,,Иә
Dialogue: 0,0:04:14.95,0:04:17.95,Default,,0,0,0,,Бірақ қарап отыра берсең
Dialogue: 0,0:04:17.95,0:04:21.62,Default,,0,0,0,,Мен өзімді аспанның ортасында жалғыз қалғандай сезінемін
Dialogue: 0,0:04:21.62,0:04:24.63,Default,,0,0,0,,Мен аздап уайымдап тұрмын.
Dialogue: 0,0:04:24.63,0:04:27.30,Default,,0,0,0,,Мико!
Dialogue: 0,0:04:27.30,0:04:30.63,Default,,0,0,0,,Хахи (Акацуки) Ұятты сызықтарға тыйым салынады.
Dialogue: 0,0:04:30.63,0:04:33.64,Default,,0,0,0,,Е! Акацуки-сан...
Dialogue: 0,0:04:33.64,0:04:36.64,Default,,0,0,0,,Жалықтырған сияқтысың, Момико.
Dialogue: 0,0:04:36.64,0:04:40.64,Default,,0,0,0,,Мен жаттығуды жаңа ғана аяқтадым. Ал сен ше, Акацуки?
Dialogue: 0,0:04:40.64,0:04:43.98,Default,,0,0,0,,Менің ақымақ ағам бір тапсырманы орындауымды өтінді.
Dialogue: 0,0:04:43.98,0:04:49.32,Default,,0,0,0,,Мен кездейсоқ сол дүкенге сағатымды жөндеуге келдім.
Dialogue: 0,0:04:49.32,0:04:52.99,Default,,0,0,0,,Алисия ол жерде болмас еді (Акацуки) Хмм!
Dialogue: 0,0:04:52.99,0:04:55.32,Default,,0,0,0,,Муу аа...
Dialogue: 0,0:04:55.32,0:04:57.99,Default,,0,0,0,,Аа, дұрыс, Акира-сан.
Dialogue: 0,0:04:57.99,0:05:00.93,Default,,0,0,0,,Айка-чан бүгін қалай болды?
Dialogue: 0,0:05:00.93,0:05:04.93,Default,,0,0,0,,Иә? Таңертең бірге болмадыңыз ба?
Dialogue: 0,0:05:04.93,0:05:08.60,Default,,0,0,0,,Иә, дұрыс...
Dialogue: 0,0:05:08.60,0:05:11.27,Default,,0,0,0,,Түстен кейін мен президент Хименің лентасын тағып алдым.
Dialogue: 0,0:05:11.27,0:05:13.94,Default,,0,0,0,,Ол жаңа киім алуға шықты.
Dialogue: 0,0:05:13.94,0:05:16.28,Default,,0,0,0,,Иә~ Солай ма?
Dialogue: 0,0:05:16.28,0:05:19.28,Default,,0,0,0,,Бұл да жақсы.
Dialogue: 0,0:05:19.28,0:05:23.62,Default,,0,0,0,,Осындай жақсы ауа-райы бар күні...
Dialogue: 0,0:05:23.62,0:05:25.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:25.62,0:05:45.64,Default,,0,0,0,,♬～
Dialogue: 0,0:05:45.64,0:06:02.59,Default,,0,0,0,,♬～
Dialogue: 0,0:06:02.59,0:06:04.99,Default,,0,0,0,,Ахх.
Dialogue: 0,0:06:07.26,0:06:09.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:09.93,0:06:13.94,Default,,0,0,0,,Сіз тамақ ішесіз бе? Ей, біреуін алайық.
Dialogue: 0,0:06:13.94,0:06:15.94,Default,,0,0,0,,Иә, Акацуки-сан.
Dialogue: 0,0:06:15.94,0:06:18.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:18.61,0:06:20.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:20.61,0:06:24.95,Default,,0,0,0,,Иә, иә, Акацуки-сан.
Dialogue: 0,0:06:24.95,0:06:27.62,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:06:27.62,0:06:29.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:29.95,0:06:31.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:31.95,0:06:33.96,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:06:33.96,0:06:37.56,Default,,0,0,0,,Поо! (Акацуки) А, аа...
Dialogue: 0,0:06:38.63,0:06:40.63,Default,,0,0,0,,Сіз қандайсыз!
Dialogue: 0,0:06:40.63,0:06:42.63,Default,,0,0,0,,Бұл Акира-сама.
Dialogue: 0,0:06:42.63,0:06:47.64,Default,,0,0,0,,Жарайды, ауа райы екеумізге де жақсы.
Dialogue: 0,0:06:47.64,0:06:51.97,Default,,0,0,0,,Иә, ауа райы өте жақсы.
Dialogue: 0,0:06:51.97,0:06:54.98,Default,,0,0,0,,Аль-кун, мұнда қанша уақыт болдыңыз?
Dialogue: 0,0:06:54.98,0:06:58.65,Default,,0,0,0,,Мен сізді мазалағаныма біраз болды.
Dialogue: 0,0:06:58.65,0:07:00.92,Default,,0,0,0,,Бүгін мен кездейсоқ сол дүкенде болдым.
Dialogue: 0,0:07:00.92,0:07:03.59,Default,,0,0,0,,Мен жұмыс құралдарының бөлшектерін алуға келдім.
Dialogue: 0,0:07:03.59,0:07:07.59,Default,,0,0,0,,Жақсы жұмыс істейтін дүкен бар.
Dialogue: 0,0:07:07.59,0:07:09.93,Default,,0,0,0,,Сіз не істеуді жоспарлап отырсыз?
Dialogue: 0,0:07:09.93,0:07:12.53,Default,,0,0,0,,Сол себепті Акира-сама.
Dialogue: 0,0:07:13.93,0:07:18.93,Default,,0,0,0,,Акацуки-кун бала кезінен мүлде өзгерген жоқ.
Dialogue: 0,0:07:18.93,0:07:21.94,Default,,0,0,0,,Иә? Сіз мені сол кезден бері танисыз ба?
Dialogue: 0,0:07:21.94,0:07:25.27,Default,,0,0,0,,Иә, мен қалқымалы аралданмын.
Dialogue: 0,0:07:25.27,0:07:29.28,Default,,0,0,0,,Мен кішкентай кезімнен бала күнгі досым Акацуки-кунды жиі кездестіретінмін.
Dialogue: 0,0:07:29.28,0:07:31.95,Default,,0,0,0,,Мен Вудиге қарадым.
Dialogue: 0,0:07:31.95,0:07:35.95,Default,,0,0,0,,Мен екеуінен бір сынып жоғары болдым.
Dialogue: 0,0:07:42.62,0:07:47.63,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:07:49.63,0:07:57.64,Default,,0,0,0,,♬～
Dialogue: 0,0:07:57.64,0:08:00.58,Default,,0,0,0,,Таң Вуди
Dialogue: 0,0:08:00.58,0:08:03.58,Default,,0,0,0,,Тым тентек болма
Dialogue: 0,0:08:03.58,0:08:06.28,Default,,0,0,0,,Фу Фу
Dialogue: 0,0:08:07.25,0:08:09.92,Default,,0,0,0,,Сіз психикалық тұрғыдан дайынсыз ба? ағаш
Dialogue: 0,0:08:09.92,0:08:14.59,Default,,0,0,0,,Қашан қарасам да қорқынышты слайд.
Dialogue: 0,0:08:14.59,0:08:17.59,Default,,0,0,0,,Акваның тыныштығын мұндай нәрсе қорғауға бола ма?
Dialogue: 0,0:08:17.59,0:08:19.59,Default,,0,0,0,,Бұл батылдық жаттығуы.
Dialogue: 0,0:08:19.59,0:08:22.93,Default,,0,0,0,,Ең бастысы - тежегішті қалай баспау керек.
Dialogue: 0,0:08:22.93,0:08:25.23,Default,,0,0,0,,Сәлем! (Вуди) Ах...
Dialogue: 0,0:08:27.60,0:08:30.61,Default,,0,0,0,,Хмм...! (Вуди) Жақсы...
Dialogue: 0,0:08:32.27,0:08:34.94,Default,,0,0,0,,Ол маған айтты
Dialogue: 0,0:08:34.94,0:08:36.95,Default,,0,0,0,,Хмф!
Dialogue: 0,0:08:43.62,0:08:45.95,Default,,0,0,0,,Хехе, мен сәл қалқып кеттім.
Dialogue: 0,0:08:45.95,0:08:49.96,Default,,0,0,0,,Иә! Бұл керемет, Акацуки, күткендей.
Dialogue: 0,0:08:49.96,0:08:53.63,Default,,0,0,0,,Вуди, сен менің коньки тебу шеберлігім туралы көбірек білуің керек.
Dialogue: 0,0:08:53.63,0:08:57.97,Default,,0,0,0,,Қызық көрінеді, бізге де қосылыңыз.
Dialogue: 0,0:08:57.97,0:09:01.57,Default,,0,0,0,,Хмм, сен кімсің?
Dialogue: 0,0:09:01.57,0:09:05.91,Default,,0,0,0,,Бұл менмін, бұл менмін! Ей, бізді де қосыңызшы.
Dialogue: 0,0:09:05.91,0:09:09.58,Default,,0,0,0,,Мен оны көрмеймін және ол дөрекі. Мен бас тартамын!
Dialogue: 0,0:09:09.58,0:09:11.91,Default,,0,0,0,,Мен қазір арнайы дайындықпен айналысамын.
Dialogue: 0,0:09:11.91,0:09:13.92,Default,,0,0,0,,Арнайы дайындық?
Dialogue: 0,0:09:13.92,0:09:17.52,Default,,0,0,0,,Барған сайын қызық көрінеді Әй.
Dialogue: 0,0:09:24.26,0:09:27.60,Default,,0,0,0,,Келесі кезекте әткеншекпен секіруге арналған арнайы дайындық.
Dialogue: 0,0:09:27.60,0:09:32.27,Default,,0,0,0,,Бірінші, қатар, қатар, қатар.
Dialogue: 0,0:09:32.27,0:09:34.94,Default,,0,0,0,,Ал... ұш!
Dialogue: 0,0:09:34.94,0:09:37.61,Default,,0,0,0,,Хмф (Вуди) О!
Dialogue: 0,0:09:37.61,0:09:42.28,Default,,0,0,0,,Алысқа ұша алсаң, әділдік құдіретіне жақындайсың.
Dialogue: 0,0:09:42.28,0:09:44.28,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:09:44.28,0:09:47.28,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:47.28,0:09:50.62,Default,,0,0,0,,Жоқ! (Ақира) Кекекеке...!
Dialogue: 0,0:09:50.62,0:09:53.96,Default,,0,0,0,,Уа... ау... (Акацуки) Әй?
Dialogue: 0,0:09:53.96,0:09:56.62,Default,,0,0,0,,Уау, тез!
Dialogue: 0,0:09:56.62,0:09:58.96,Default,,0,0,0,,Кекекеке...!
Dialogue: 0,0:09:58.96,0:10:00.96,Default,,0,0,0,,Күте тұрыңыз, бұл қауіпті...!
Dialogue: 0,0:10:00.96,0:10:02.96,Default,,0,0,0,,Уау
Dialogue: 0,0:10:06.97,0:10:09.64,Default,,0,0,0,,Ах... уау!
Dialogue: 0,0:10:09.64,0:10:11.64,Default,,0,0,0,,Ei
Dialogue: 0,0:10:13.64,0:10:16.04,Default,,0,0,0,,Иә? Хмф
Dialogue: 0,0:10:18.31,0:10:20.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:22.98,0:10:26.32,Default,,0,0,0,,Жақсы емес адам (Акацуки) Сен несің!
Dialogue: 0,0:10:26.32,0:10:29.02,Default,,0,0,0,,Эй, бұл менмін!
Dialogue: 0,0:10:30.66,0:10:33.66,Default,,0,0,0,,Мен сені дуэльге шақырамын (Вуди) Ха!
Dialogue: 0,0:10:33.66,0:10:36.66,Default,,0,0,0,,Қайсысы Акваның тыныштығын қорғауға лайық?
Dialogue: 0,0:10:36.66,0:10:38.67,Default,,0,0,0,,Түсіндіріңіз
Dialogue: 0,0:10:38.67,0:10:42.67,Default,,0,0,0,,Акваның...бейбітшілігі?
Dialogue: 0,0:10:42.67,0:10:46.67,Default,,0,0,0,,Ах...хехе
Dialogue: 0,0:10:46.67,0:10:48.68,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:11:02.96,0:11:07.30,Default,,0,0,0,,Бұл қалқымалы аралдың ерекшелігі: қорқынышты слайд.
Dialogue: 0,0:11:07.30,0:11:09.30,Default,,0,0,0,,Енді бұл жер
Dialogue: 0,0:11:09.30,0:11:13.30,Default,,0,0,0,,Аква бейбітшілігі үшін шайқас кезеңі.
Dialogue: 0,0:11:13.30,0:11:15.97,Default,,0,0,0,,Дайынсың ба? (Акира) Океоке
Dialogue: 0,0:11:15.97,0:11:18.31,Default,,0,0,0,,Қашып кететін болсаң, дәл қазір.
Dialogue: 0,0:11:18.31,0:11:20.31,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:11:20.31,0:11:22.64,Default,,0,0,0,,ұсақ ұрлық жасап, соққы беріп қашып кету қылмыстарын жасап, полиция көлігінің терезелерін сындыратын
Dialogue: 0,0:11:22.64,0:11:25.98,Default,,0,0,0,,Ойын оңай, бұл қорқынышты слайд
Dialogue: 0,0:11:25.98,0:11:28.65,Default,,0,0,0,,Коньки тезірек және жақсырақ секіңіз
Dialogue: 0,0:11:28.65,0:11:31.65,Default,,0,0,0,,Кім аяқтай алады, сол жеңімпаз.
Dialogue: 0,0:11:31.65,0:11:33.66,Default,,0,0,0,,Сіз сонда секіре аласыз ба?
Dialogue: 0,0:11:33.66,0:11:35.99,Default,,0,0,0,,Әй... Дұрыс.
Dialogue: 0,0:11:35.99,0:11:39.99,Default,,0,0,0,,Ол үшін тежеуді аздап, жылдамдықты арттыру керек.
Dialogue: 0,0:11:39.99,0:11:42.66,Default,,0,0,0,,Бұл керемет. Бұл қымбат.
Dialogue: 0,0:11:42.66,0:11:45.67,Default,,0,0,0,,Тежегішті баспай осы жерден төмен түсіңіз.
Dialogue: 0,0:11:45.67,0:11:50.27,Default,,0,0,0,,Иә!? Ах... ой...
Dialogue: 0,0:11:50.27,0:11:52.27,Default,,0,0,0,,Мұны істеудің жолы бар ма?
Dialogue: 0,0:11:52.27,0:11:54.61,Default,,0,0,0,,Келіңіздер! (Акацуки) Уау!?
Dialogue: 0,0:11:54.61,0:11:56.61,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:11:56.61,0:11:58.61,Default,,0,0,0,,Уау! Ол жігіт...
Dialogue: 0,0:11:58.61,0:12:00.95,Default,,0,0,0,,Мен тежегішті мүлде басып жатқан жоқпын.
Dialogue: 0,0:12:00.95,0:12:02.95,Default,,0,0,0,,Хехехе
Dialogue: 0,0:12:02.95,0:12:04.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:04.95,0:12:07.96,Default,,0,0,0,,Ал... ұшып жатыр!
Dialogue: 0,0:12:07.96,0:12:10.56,Default,,0,0,0,,Жақсы сезінемін!
Dialogue: 0,0:12:12.29,0:12:15.30,Default,,0,0,0,,Уау! Хехе
Dialogue: 0,0:12:15.30,0:12:17.63,Default,,0,0,0,,Сәлем, келесі жолы!
Dialogue: 0,0:12:17.63,0:12:21.64,Default,,0,0,0,,Е... Акацукин...
Dialogue: 0,0:12:21.64,0:12:24.97,Default,,0,0,0,,Тежегіш жоқ…
Dialogue: 0,0:12:24.97,0:12:26.98,Default,,0,0,0,,Ешбір…
Dialogue: 0,0:12:31.65,0:12:34.32,Default,,0,0,0,,Әй, тезірек!
Dialogue: 0,0:12:34.32,0:12:36.65,Default,,0,0,0,,Уау
Dialogue: 0,0:12:36.65,0:12:40.66,Default,,0,0,0,,Мүмкін емес... Мүлдем мүмкін емес...
Dialogue: 0,0:12:40.66,0:12:44.33,Default,,0,0,0,,Акацукин! (Таң) А
Dialogue: 0,0:12:44.33,0:12:48.66,Default,,0,0,0,,Акацукиде бұл әділет киімі бар!
Dialogue: 0,0:12:48.66,0:12:51.93,Default,,0,0,0,,Ах... Вуди
Dialogue: 0,0:12:51.93,0:12:54.24,Default,,0,0,0,,Акацукин
Dialogue: 0,0:12:55.94,0:12:58.94,Default,,0,0,0,,Рахмет сізге Вуди
Dialogue: 0,0:13:00.27,0:13:02.61,Default,,0,0,0,,Барыңды істе, Акацуки!
Dialogue: 0,0:13:02.61,0:13:04.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:07.95,0:13:09.95,Default,,0,0,0,,Хмм!
Dialogue: 0,0:13:09.95,0:13:11.95,Default,,0,0,0,,Нууу...!
Dialogue: 0,0:13:16.29,0:13:18.96,Default,,0,0,0,,<Сол кезде мен, әрине, жасадым➡
Dialogue: 0,0:13:18.96,0:13:21.30,Default,,0,0,0,,Жарық жылдамдығынан асу＞
Dialogue: 0,0:13:21.30,0:13:23.60,Default,,0,0,0,,Хмм! (Вуди) Жоқ...!
Dialogue: 0,0:13:24.97,0:13:26.97,Default,,0,0,0,,Ах
Dialogue: 0,0:13:28.64,0:13:30.97,Default,,0,0,0,,Уау~ Уау~
Dialogue: 0,0:13:30.97,0:13:32.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:36.64,0:13:40.65,Default,,0,0,0,,Білмеймін, бірақ оның жағдайы өте ауыр сияқты
Dialogue: 0,0:13:40.65,0:13:44.99,Default,,0,0,0,,Уау! Акацуки, бұл қатыгез...
Dialogue: 0,0:13:44.99,0:13:48.99,Default,,0,0,0,,О... жақсысың ба?
Dialogue: 0,0:13:49.92,0:13:54.93,Default,,0,0,0,,Маған олай қарама...
Dialogue: 0,0:13:54.93,0:13:58.27,Default,,0,0,0,,Мен пайдасыз адаммын...
Dialogue: 0,0:13:58.27,0:14:04.27,Default,,0,0,0,,(Таң айқайы)
Dialogue: 0,0:14:04.27,0:14:06.94,Default,,0,0,0,,Ол жаман адам емес.
Dialogue: 0,0:14:06.94,0:14:09.61,Default,,0,0,0,,Бұл өте керемет болды.
Dialogue: 0,0:14:09.61,0:14:13.31,Default,,0,0,0,,Иә? (Акира) Сенде маған қарауға батылдық бар.
Dialogue: 0,0:14:18.95,0:14:21.29,Default,,0,0,0,,Бұл менің жоғалтуым
Dialogue: 0,0:14:21.29,0:14:30.30,Default,,0,0,0,,♬～
Dialogue: 0,0:14:30.30,0:14:32.63,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:32.63,0:14:36.64,Default,,0,0,0,,Сіз Нео-Венециядан мектеп экскурсиясына келдіңіз бе?
Dialogue: 0,0:14:36.64,0:14:40.98,Default,,0,0,0,,Қалқымалы аралдар қызықсыз көрінеді, сондықтан келгім келмеді.
Dialogue: 0,0:14:40.98,0:14:45.31,Default,,0,0,0,,Бұл таңқаларлық жақсы жер болды. Мен қызықты адамдармен таныстым.
Dialogue: 0,0:14:45.31,0:14:47.65,Default,,0,0,0,,Сәлем (Акира)?
Dialogue: 0,0:14:47.65,0:14:51.92,Default,,0,0,0,,Бұл матчты кім көрсе де, бұл мен үшін толық жеңіліс болады.
Dialogue: 0,0:14:51.92,0:14:54.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:54.59,0:14:57.93,Default,,0,0,0,,Бұл үшін кешірім сұраймын, бірақ...
Dialogue: 0,0:14:57.93,0:15:01.60,Default,,0,0,0,,Акваның тыныштығын қорғауды сізге қалдырамын.
Dialogue: 0,0:15:01.60,0:15:04.60,Default,,0,0,0,,Міне! Жарайды ма? Акацуки
Dialogue: 0,0:15:04.60,0:15:08.27,Default,,0,0,0,,Хмм... Жарайды. Aqua тыныштығы үшін.
Dialogue: 0,0:15:08.27,0:15:11.61,Default,,0,0,0,,Мұны істеген дұрыс.
Dialogue: 0,0:15:11.61,0:15:15.28,Default,,0,0,0,,Сіз бір нәрсені дұрыс түсінбедіңіз бе?
Dialogue: 0,0:15:15.28,0:15:18.61,Default,,0,0,0,,Мен мұнда Aqua үшін емеспін.
Dialogue: 0,0:15:18.61,0:15:20.95,Default,,0,0,0,,Жарайсың ба? Тыңда
Dialogue: 0,0:15:20.95,0:15:24.29,Default,,0,0,0,,Менде бұл аква бар.
Dialogue: 0,0:15:24.29,0:15:27.99,Default,,0,0,0,,О! (Акацуки) А, аа...
Dialogue: 0,0:15:28.96,0:15:33.63,Default,,0,0,0,,Әй, мұқият тыңда.
Dialogue: 0,0:15:33.63,0:15:35.63,Default,,0,0,0,,Мен сізді аға деп атауға рұқсат етіңіз
Dialogue: 0,0:15:35.63,0:15:38.33,Default,,0,0,0,,Мен бас тартамын!
Dialogue: 0,0:15:41.97,0:15:44.64,Default,,0,0,0,,Сондай сағыныш
Dialogue: 0,0:15:44.64,0:15:49.64,Default,,0,0,0,,Ум, Акацуки-сан, сен мені қашан тыңдай бастадың?
Dialogue: 0,0:15:49.64,0:15:51.58,Default,,0,0,0,,Хмм, біраз уақыт бұрын.
Dialogue: 0,0:15:51.58,0:15:53.58,Default,,0,0,0,,Бірақ ер адамдар арасындағы адам қандай?
Dialogue: 0,0:15:53.58,0:15:56.25,Default,,0,0,0,,Менің ойымша, сіз сол жігіт туралы айтып отырсыз.
Dialogue: 0,0:15:56.25,0:16:01.26,Default,,0,0,0,,Мен оны бұрыннан білемін, бірақ ол қазір қайда, не істеп жүр деп ойлаймын.
Dialogue: 0,0:16:01.26,0:16:04.93,Default,,0,0,0,,Мен оның үлкен адамға айналғанына сенімдімін.
Dialogue: 0,0:16:04.93,0:16:08.93,Default,,0,0,0,,О, бұл өте ностальгиялық (Президент Ария) Пуинюпуи
Dialogue: 0,0:16:08.93,0:16:11.93,Default,,0,0,0,,Әй, Алисия! Қашаннан бері сондасың?
Dialogue: 0,0:16:11.93,0:16:14.94,Default,,0,0,0,,Иә? біраз уақыт бұрын
Dialogue: 0,0:16:14.94,0:16:18.61,Default,,0,0,0,,Мен жұмыстан кейін үйге келе жатқанда осы жерден өтіп кеттім.
Dialogue: 0,0:16:18.61,0:16:20.94,Default,,0,0,0,,Өйткені мен Акари-чанды және басқаларды көрдім
Dialogue: 0,0:16:20.94,0:16:22.94,Default,,0,0,0,,Хэхе~
Dialogue: 0,0:16:22.94,0:16:26.28,Default,,0,0,0,,Аа, айтпақшы, сағыныш сезіндіңіз бе?
Dialogue: 0,0:16:26.28,0:16:31.29,Default,,0,0,0,,Бұл біз жүзбелі аралға алғаш рет саяхатқа барған кезде болғанына сенімдімін, солай ма?
Dialogue: 0,0:16:31.29,0:16:33.29,Default,,0,0,0,,Не? Акира-чантара
Dialogue: 0,0:16:33.29,0:16:36.96,Default,,0,0,0,,Бір жерге бірінші рет барсам да, мұғалімнің назарын аударамын.
Dialogue: 0,0:16:36.96,0:16:40.63,Default,,0,0,0,,Мені шығарып, еркін жүр.
Dialogue: 0,0:16:40.63,0:16:43.63,Default,,0,0,0,,Бұл жаман, солай ма?
Dialogue: 0,0:16:43.63,0:16:46.97,Default,,0,0,0,,Бір минут күтіңіз, бұл...
Dialogue: 0,0:16:46.97,0:16:49.90,Default,,0,0,0,,Сен... ол кездегі ағасың ба?
Dialogue: 0,0:16:49.90,0:16:54.58,Default,,0,0,0,,Кешіріңіз, ондай ештеңе есімде жоқ. Осындай нәрсе болды ма?
Dialogue: 0,0:16:54.58,0:16:58.25,Default,,0,0,0,,Ааа, менің үлкен ағам сондай күшті еді...
Dialogue: 0,0:16:58.25,0:17:00.25,Default,,0,0,0,,Ой, менің ағам кім?
Dialogue: 0,0:17:00.25,0:17:02.58,Default,,0,0,0,,Енді былай... былай
Dialogue: 0,0:17:02.58,0:17:05.59,Default,,0,0,0,,Кроссовканы ұнататын жігітке ғашық боламын деп ешқашан ойламаппын!
Dialogue: 0,0:17:05.59,0:17:09.26,Default,,0,0,0,,Уау! Мен әрқашан жақсы әйелмін және солай болдым.
Dialogue: 0,0:17:09.26,0:17:12.59,Default,,0,0,0,,Фу... (Акацуки) Мына жас әдемі ханым...
Dialogue: 0,0:17:12.59,0:17:14.93,Default,,0,0,0,,Бұл Алисия еді.
Dialogue: 0,0:17:14.93,0:17:17.93,Default,,0,0,0,,Уфуфу (Акацуки)
Dialogue: 0,0:17:17.93,0:17:21.94,Default,,0,0,0,,Сол кездің өзінде сен маған қараған кезде мен өзімді сондай... соншалықты... қатты толқыдым...
Dialogue: 0,0:17:21.94,0:17:25.27,Default,,0,0,0,,Жүректің соғуы... соғуы...
Dialogue: 0,0:17:25.27,0:17:28.94,Default,,0,0,0,,Содан бері мен Алисияға жанкүйермін.
Dialogue: 0,0:17:28.94,0:17:31.95,Default,,0,0,0,,Хюха... ау, хехехе
Dialogue: 0,0:17:31.95,0:17:36.62,Default,,0,0,0,,Бірақ мен сіз бұл туралы айтқанша кездескенімізді білмедім.
Dialogue: 0,0:17:36.62,0:17:40.29,Default,,0,0,0,,Nu? (Акира) Хмф, Алисия жанкүйерлері дисквалификацияланды.
Dialogue: 0,0:17:40.29,0:17:43.29,Default,,0,0,0,,Ноуу
Dialogue: 0,0:17:43.29,0:17:46.96,Default,,0,0,0,,Жоқ, байқамадым, ұмытып кетіппін!
Dialogue: 0,0:17:46.96,0:17:50.23,Default,,0,0,0,,Бұл бірдей болуы мүмкін, бірақ (Акацуки) басқаша болады!
Dialogue: 0,0:17:50.23,0:17:52.90,Default,,0,0,0,,Дұрысы, ұмытқан дұрыс.
Dialogue: 0,0:17:52.90,0:17:55.90,Default,,0,0,0,,Жаман емес пе? (Акацуки) А, бұл...
Dialogue: 0,0:17:55.90,0:17:59.57,Default,,0,0,0,,Жоқ, олай болуы мүмкін емес!
Dialogue: 0,0:17:59.57,0:18:04.58,Default,,0,0,0,,Иә? не болды? Акари-чан
Dialogue: 0,0:18:04.58,0:18:08.92,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:18:08.92,0:18:10.92,Default,,0,0,0,,Акари-чан?
Dialogue: 0,0:18:10.92,0:18:14.59,Default,,0,0,0,,Дөңгелек және дөңгелек, дөңгелек және дөңгелек
Dialogue: 0,0:18:14.59,0:18:17.29,Default,,0,0,0,,Біз тағы кездесеміз
Dialogue: 0,0:18:21.93,0:18:25.27,Default,,0,0,0,,Аква деп аталатын осы үлкен шеңберде
Dialogue: 0,0:18:25.27,0:18:30.27,Default,,0,0,0,,Кездесу, бір-бірінен өту, қоштасу
Dialogue: 0,0:18:30.27,0:18:38.61,Default,,0,0,0,,♬～
Dialogue: 0,0:18:38.61,0:18:44.29,Default,,0,0,0,,Уақыт өте көп нәрсе біртіндеп өзгереді.
Dialogue: 0,0:18:44.29,0:18:47.62,Default,,0,0,0,,Үлкен сақина өзгеріссіз қалады
Dialogue: 0,0:18:47.62,0:18:51.03,Default,,0,0,0,,Ол адамдар мен қаланы қамтиды.
Dialogue: 0,0:18:55.90,0:19:00.90,Default,,0,0,0,,Өте тамаша жұмбақ
Dialogue: 0,0:19:00.90,0:19:12.91,Default,,0,0,0,,♬～
Dialogue: 0,0:19:12.91,0:19:16.58,Default,,0,0,0,,Ах... (Президент Ария) Пуи Пуиню~
Dialogue: 0,0:19:16.58,0:19:21.92,Default,,0,0,0,,Бірақ мен Мэнхоумнанмын.
Dialogue: 0,0:19:21.92,0:19:25.23,Default,,0,0,0,,Бұл шеңбердің сыртында, солай емес пе?
Dialogue: 0,0:19:28.93,0:19:33.27,Default,,0,0,0,,Момико, иә.
Dialogue: 0,0:19:33.27,0:19:35.27,Default,,0,0,0,,Сәлем! Кешіріңіз
Dialogue: 0,0:19:35.27,0:19:37.94,Default,,0,0,0,,Акари-чан
Dialogue: 0,0:19:37.94,0:19:40.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:40.27,0:19:44.95,Default,,0,0,0,,Енді біз шеңбердің ішінде, бірге айналамыз.
Dialogue: 0,0:19:44.95,0:19:48.55,Default,,0,0,0,,Не, байқамадың ба?
Dialogue: 0,0:19:49.95,0:19:52.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:52.62,0:19:54.96,Default,,0,0,0,,Оның үстіне Момико ортада.
Dialogue: 0,0:19:54.96,0:19:58.29,Default,,0,0,0,,үшін Акари-санның орнына жиналып жатыр.
Dialogue: 0,0:19:58.29,0:20:02.63,Default,,0,0,0,,Мен білмей тұрып, эй (Президент Ария) Пинью~
Dialogue: 0,0:20:02.63,0:20:04.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:05.97,0:20:07.97,Default,,0,0,0,,Не?
Dialogue: 0,0:20:10.97,0:20:14.98,Default,,0,0,0,,Түсіндім... бұл дұрыс.
Dialogue: 0,0:20:14.98,0:20:17.98,Default,,0,0,0,,Эхехе (Акира) Хэхе
Dialogue: 0,0:20:17.98,0:20:20.65,Default,,0,0,0,,Пуи~ Араара
Dialogue: 0,0:20:20.65,0:20:23.98,Default,,0,0,0,,Олай болса бәріміз бірге шай ішейік.
Dialogue: 0,0:20:23.98,0:20:27.66,Default,,0,0,0,,Уау! Ухуху
Dialogue: 0,0:20:27.66,0:20:32.66,Default,,0,0,0,,♪ (Афинаның ән салған дауысы: «Коккоро»)
Dialogue: 0,0:20:32.66,0:20:52.61,Default,,0,0,0,,♪～
Dialogue: 0,0:20:52.61,0:21:09.63,Default,,0,0,0,,♪～
Dialogue: 0,0:21:09.63,0:21:14.30,Default,,0,0,0,,Хмм... Менде өте жақсы лента жоқ.
Dialogue: 0,0:21:14.30,0:21:16.30,Default,,0,0,0,,Мияу
Dialogue: 0,0:21:16.30,0:21:20.31,Default,,0,0,0,,А... бұл туралы не айтасыз? Кешіріңіз!
Dialogue: 0,0:21:20.31,0:21:22.61,Default,,0,0,0,,Уф... Аа, кешіріңіз.
Dialogue: 0,0:21:26.31,0:21:28.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:32.65,0:21:35.66,Default,,0,0,0,,Ах! Күтіңіз~
Dialogue: 0,0:21:35.66,0:21:49.67,Default,,0,0,0,,♪～
Dialogue: 0,0:21:49.67,0:21:53.94,Default,,0,0,0,,<Ай-чан, бұл жалғыз мереке болуы керек еді➡
Dialogue: 0,0:21:53.94,0:21:58.95,Default,,0,0,0,,Мен білмей тұрып, мені бәрі қоршап алды.＞
Dialogue: 0,0:21:58.95,0:22:02.28,Default,,0,0,0,,<Ол мені Аквада орап алады➡
Dialogue: 0,0:22:02.28,0:22:06.59,Default,,0,0,0,,Бұл өте кең және өте жақсы шеңбер болды.＞
Dialogue: 0,0:22:07.96,0:22:10.62,Default,,0,0,0,,<Қандай тамаша әңгіме>
Dialogue: 0,0:22:10.62,0:22:13.63,Default,,0,0,0,,<Акари-санды орап тұрған сақина➡
Dialogue: 0,0:22:13.63,0:22:19.03,Default,,0,0,0,,Қызық, ол кісінің үйіне келді ме, мен де орап жатырмын ба? ＞
Dialogue: 0,0:22:20.63,0:22:25.97,Default,,0,0,0,,<Акари-сан екі жұлдызды сақинаны қосады, солай ма?>
Dialogue: 0,0:22:25.97,0:22:34.98,Default,,0,0,0,,♪～
Dialogue: 0,0:22:34.98,0:22:54.94,Default,,0,0,0,,♬～
