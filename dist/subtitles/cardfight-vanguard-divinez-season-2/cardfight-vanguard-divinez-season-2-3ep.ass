Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.30,0:00:08.34,Default,,0,0,0,,Командалық жарыстың финалы➡
Dialogue: 0,0:00:08.34,0:00:12.31,Default,,0,0,0,,Жалпы шайқаста жеңіске жеткен адам - Сеизо Анкор Болт! ➡
Dialogue: 0,0:00:12.31,0:00:14.31,Default,,0,0,0,,Жеңіске не әкелді➡
Dialogue: 0,0:00:14.31,0:00:17.31,Default,,0,0,0,,Мен жеңілуге мүмкіндігім жоқ жекпе-жекке міндетті түрде асығамын➡
Dialogue: 0,0:00:17.31,0:00:19.28,Default,,0,0,0,,Командалық қалта пышағы➡
Dialogue: 0,0:00:19.28,0:00:22.28,Default,,0,0,0,,Көлеңке Эйс Киома Куросаки!
Dialogue: 0,0:00:22.28,0:00:26.29,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:00:38.30,0:00:40.27,Default,,0,0,0,,Тайзо тым бос.
Dialogue: 0,0:00:42.30,0:00:44.77,Default,,0,0,0,,Әдеттегідей рахмет.
Dialogue: 0,0:00:46.81,0:00:48.78,Default,,0,0,0,,О, менің...
Dialogue: 0,0:02:32.88,0:02:35.85,Default,,0,0,0,,｟Мен үшін емес! ➡
Dialogue: 0,0:02:35.85,0:02:38.85,Default,,0,0,0,,Бұл ағамның өз қалауы. ｠
Dialogue: 0,0:02:40.42,0:02:42.92,Default,,0,0,0,,｟Менің қалауым... ｠
Dialogue: 0,0:02:42.92,0:02:46.36,Default,,0,0,0,,｟Менің тілегім – Хикаридің дені сау болсын. ｠
Dialogue: 0,0:02:46.36,0:02:49.87,Default,,0,0,0,,｟Бірақ... бұл Хикари➡ үшін
Dialogue: 0,0:02:49.87,0:02:52.83,Default,,0,0,0,,Бұл менің өз қалауым емес дегенді білдіре ме? ｠
Dialogue: 0,0:02:53.87,0:02:55.87,Default,,0,0,0,,｟Ешкім үшін емес➡
Dialogue: 0,0:02:55.87,0:02:57.84,Default,,0,0,0,,Менің өзіме қандай тілегім бар? ｠
Dialogue: 0,0:02:59.31,0:03:01.31,Default,,0,0,0,,Бұл мұңды жүз.
Dialogue: 0,0:03:01.31,0:03:03.28,Default,,0,0,0,,Хмм...?
Dialogue: 0,0:03:03.28,0:03:05.28,Default,,0,0,0,,Уау...Айкава!
Dialogue: 0,0:03:05.28,0:03:07.32,Default,,0,0,0,,Бұлай таң қалудың қажеті жоқ.
Dialogue: 0,0:03:07.32,0:03:09.79,Default,,0,0,0,,Ал, мен сақтық сезімін түсінемін.
Dialogue: 0,0:03:09.79,0:03:12.29,Default,,0,0,0,,Ескерту? Мен істеген жоқпын.
Dialogue: 0,0:03:12.29,0:03:14.79,Default,,0,0,0,,Бірақ біз жаумыз, солай ма?
Dialogue: 0,0:03:14.79,0:03:16.83,Default,,0,0,0,,Әрине ұрысамын➡
Dialogue: 0,0:03:16.83,0:03:19.33,Default,,0,0,0,,Бірақ олар жау емес. жұмысшы...?
Dialogue: 0,0:03:19.33,0:03:21.80,Default,,0,0,0,,Мен дос болғанды ​​жөн көремін.
Dialogue: 0,0:03:21.80,0:03:23.83,Default,,0,0,0,,Сау бол, Джоджо!
Dialogue: 0,0:03:23.83,0:03:26.30,Default,,0,0,0,,Мен Куон туралы көбірек білгім келеді!
Dialogue: 0,0:03:26.30,0:03:29.81,Default,,0,0,0,,Ахаха...сен өзгерген жоқсың.
Dialogue: 0,0:03:30.81,0:03:32.77,Default,,0,0,0,,Өзгеріс жоқ па?
Dialogue: 0,0:03:32.77,0:03:35.78,Default,,0,0,0,,Ой... Ақинадан не қалайсың?
Dialogue: 0,0:03:35.78,0:03:38.78,Default,,0,0,0,,Біз жай ғана сөйлесіп отырдық.
Dialogue: 0,0:03:38.78,0:03:41.82,Default,,0,0,0,,Шынымен бе? аа.
Dialogue: 0,0:03:41.82,0:03:45.32,Default,,0,0,0,,Міне, бүгін түн тағы бір тағдырлы шайқас.
Dialogue: 0,0:03:54.30,0:03:56.30,Default,,0,0,0,,(есік қағу)
Dialogue: 0,0:03:56.30,0:03:58.77,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:04:00.30,0:04:02.30,Default,,0,0,0,,Кюма, не болды?
Dialogue: 0,0:04:02.30,0:04:06.27,Default,,0,0,0,,Бұл түстен кейінгі презентация материалы. Көріп тұрмын...бұл бүгін болды➡
Dialogue: 0,0:04:06.27,0:04:08.28,Default,,0,0,0,,Кешіріңіз, бұл пайдалы.
Dialogue: 0,0:04:08.28,0:04:10.28,Default,,0,0,0,,Бұл сіздің кінәңіз➡
Dialogue: 0,0:04:10.28,0:04:12.28,Default,,0,0,0,,Өз күшіңізге тым сенімді➡
Dialogue: 0,0:04:12.28,0:04:15.35,Default,,0,0,0,,Айқын шамадан тыс жұмысты да білмеймін.
Dialogue: 0,0:04:15.35,0:04:19.29,Default,,0,0,0,,Мен орындаймын деген жұмысымды да ұмытамын.
Dialogue: 0,0:04:19.29,0:04:21.29,Default,,0,0,0,,Аа...
Dialogue: 0,0:04:21.29,0:04:23.33,Default,,0,0,0,,Не болды? Жоқ ➡
Dialogue: 0,0:04:23.33,0:04:26.29,Default,,0,0,0,,Колледжде оқып жүрген кезімнен еш айырмашылығы жоқ деп ойлаймын.
Dialogue: 0,0:04:30.37,0:04:32.30,Default,,0,0,0,,｟Мен өзімді жанып тұрғандай сезінемін.
Dialogue: 0,0:04:32.30,0:04:35.27,Default,,0,0,0,,Аа, келесі турнирді жеңіп алсам➡
Dialogue: 0,0:04:35.27,0:04:39.34,Default,,0,0,0,,Тағы бір нәрсе: бұл сізді жоғары кәсіби маман болуға жақындатады.
Dialogue: 0,0:04:39.34,0:04:43.31,Default,,0,0,0,,Сіз бос емес сияқтысыз. Авангард, университеттер және компаниялар➡
Dialogue: 0,0:04:43.31,0:04:45.78,Default,,0,0,0,,Олардың барлығы қызықты.
Dialogue: 0,0:04:45.78,0:04:48.35,Default,,0,0,0,,Бірақ ресурстар шектеулі.
Dialogue: 0,0:04:48.35,0:04:51.29,Default,,0,0,0,,Егер сіз өз басымдықтарыңызды шеше алмасаңыз, банкротқа ұшырайсыз.
Dialogue: 0,0:04:51.29,0:04:53.79,Default,,0,0,0,,Сонда да мен ымыраға келмеймін➡
Dialogue: 0,0:04:53.79,0:04:57.29,Default,,0,0,0,,Барлығын жасаңыз! Өйткені мен өзімшілмін.
Dialogue: 0,0:04:57.29,0:04:59.29,Default,,0,0,0,,Жасағыңыз келетіннің барлығы➡
Dialogue: 0,0:04:59.29,0:05:01.30,Default,,0,0,0,,Мен өзімді шегіне жеткізгім келеді.
Dialogue: 0,0:05:01.30,0:05:03.30,Default,,0,0,0,,Олай болса, мен ➡ сұрар едім
Dialogue: 0,0:05:03.30,0:05:05.30,Default,,0,0,0,,Сіз ертең тапсырылатын тапсырманы орындадыңыз ба?
Dialogue: 0,0:05:05.30,0:05:07.77,Default,,0,0,0,,А...о, жоқ, ұмытып кетіппін.
Dialogue: 0,0:05:07.77,0:05:10.27,Default,,0,0,0,,Бұл мен айтып отырған жақтан.
Dialogue: 0,0:05:10.27,0:05:13.28,Default,,0,0,0,,Хм, мен не істеймін деп ойлаймын...
Dialogue: 0,0:05:15.31,0:05:17.28,Default,,0,0,0,,Материалдарды құрастырдым➡
Dialogue: 0,0:05:17.28,0:05:19.78,Default,,0,0,0,,Тез аяқтаңыз➡
Dialogue: 0,0:05:19.78,0:05:22.28,Default,,0,0,0,,Осыдан кейін мен сізге палубаны реттеуге көмектесемін.
Dialogue: 0,0:05:22.28,0:05:24.32,Default,,0,0,0,,Кьюма күткендей!
Dialogue: 0,0:05:24.32,0:05:27.36,Default,,0,0,0,,Өйткені, сіз ең жақсы серіктессіз!
Dialogue: 0,0:05:27.36,0:05:29.86,Default,,0,0,0,,Оның жағдайы жақсы. ｠
Dialogue: 0,0:05:31.83,0:05:33.80,Default,,0,0,0,,Ең маңызды сәтте➡
Dialogue: 0,0:05:33.80,0:05:36.30,Default,,0,0,0,,Маған міндетті түрде қолдау көрсетесіз➡
Dialogue: 0,0:05:36.30,0:05:38.77,Default,,0,0,0,,Сен сондай жігітсің.
Dialogue: 0,0:05:45.27,0:05:48.28,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:05:49.78,0:05:51.78,Default,,0,0,0,,Менің ойымша, бұл жақсы емес ...
Dialogue: 0,0:05:54.35,0:05:56.32,Default,,0,0,0,,｟Азаматтық адамның психикалық ластануы ➡
Dialogue: 0,0:05:56.32,0:06:00.36,Default,,0,0,0,,Ол тек қысылған жүрегін ашу керектігін айтты➡
Dialogue: 0,0:06:00.36,0:06:04.33,Default,,0,0,0,,Егер солай болса... сіздің шын ниетіңіз осы ма еді? ｠
Dialogue: 0,0:06:12.80,0:06:15.77,Default,,0,0,0,,Қалай ойлайсың, Киома-сан? Шарты.
Dialogue: 0,0:06:15.77,0:06:18.31,Default,,0,0,0,,Барлығы жақсы. Бұл жақсы болды.
Dialogue: 0,0:06:18.31,0:06:20.81,Default,,0,0,0,,Бұл маңызды жекпе-жек алдында.
Dialogue: 0,0:06:20.81,0:06:22.81,Default,,0,0,0,,Бір-біріңе үйренуге мәжбүрлеудің қажеті жоқ.
Dialogue: 0,0:06:22.81,0:06:24.78,Default,,0,0,0,,Балалар сендер де солай.
Dialogue: 0,0:06:24.78,0:06:26.78,Default,,0,0,0,,Бұл дұрыс болуы мүмкін.
Dialogue: 0,0:06:26.78,0:06:29.32,Default,,0,0,0,,Біз бір командада болдық.
Dialogue: 0,0:06:29.32,0:06:32.32,Default,,0,0,0,,Мен Наомен күресе алатын болсам, жақсы.
Dialogue: 0,0:06:32.32,0:06:34.79,Default,,0,0,0,,Тілегім орындалса, бұл да жақсы.
Dialogue: 0,0:06:35.79,0:06:37.79,Default,,0,0,0,,Әр адамның қалауы әртүрлі.
Dialogue: 0,0:06:37.79,0:06:39.79,Default,,0,0,0,,Бізге тиісті рөлдерімізді орындау ғана қалды.
Dialogue: 0,0:06:39.79,0:06:41.83,Default,,0,0,0,,Барлығы еркін.
Dialogue: 0,0:06:41.83,0:06:44.80,Default,,0,0,0,,Хехе...Мен сенің жеңісіңе сенемін.
Dialogue: 0,0:06:47.77,0:06:49.80,Default,,0,0,0,,Тайзо мырза! Күткеніңізге рахмет.
Dialogue: 0,0:06:49.80,0:06:52.31,Default,,0,0,0,,Бүгінгі күннің басты кейіпкері шығады.
Dialogue: 0,0:06:54.81,0:06:56.78,Default,,0,0,0,,Кьюма….
Dialogue: 0,0:06:57.78,0:06:59.78,Default,,0,0,0,,Қазір ойлап қарасам...Кюма-сан➡
Dialogue: 0,0:06:59.78,0:07:01.78,Default,,0,0,0,,Сіз Тайзо-санның әріптесісіз бе?
Dialogue: 0,0:07:01.78,0:07:03.79,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:07:03.79,0:07:06.82,Default,,0,0,0,,Seizo Anchor Bolt Бұл көлеңкелердің эйси!
Dialogue: 0,0:07:06.82,0:07:10.29,Default,,0,0,0,,Shadow Ace? Команда қысылып қалғанда ғана шақырылады➡
Dialogue: 0,0:07:10.29,0:07:12.83,Default,,0,0,0,,Жеңіс әкеліп, тез кет➡
Dialogue: 0,0:07:12.83,0:07:15.80,Default,,0,0,0,,Табысты болғаны үшін оны көлеңкелі Эйс деп атайды!
Dialogue: 0,0:07:15.80,0:07:18.80,Default,,0,0,0,,Нао-сенпай, көңілің толқып тұр ма?
Dialogue: 0,0:07:18.80,0:07:20.84,Default,,0,0,0,,Ешқандай себеп жоқ! ➡
Dialogue: 0,0:07:20.84,0:07:23.27,Default,,0,0,0,,Сеизо Анчор Болттың екі шыңы арасындағы армандардың кездесуі➡
Dialogue: 0,0:07:23.27,0:07:25.37,Default,,0,0,0,,Мен мүлдем уайымдамаймын!
Dialogue: 0,0:07:25.37,0:07:27.31,Default,,0,0,0,,Маған өте қызық...
Dialogue: 0,0:07:27.31,0:07:30.81,Default,,0,0,0,,Ахаха...жарайды, мен жеңемін.
Dialogue: 0,0:07:42.29,0:07:44.29,Default,,0,0,0,,Киома➡
Dialogue: 0,0:07:44.29,0:07:46.80,Default,,0,0,0,,Орындағыңыз келетін тілегіңіз қандай?
Dialogue: 0,0:07:46.80,0:07:49.30,Default,,0,0,0,,Компанияңызды алыңыз➡
Dialogue: 0,0:07:49.30,0:07:51.30,Default,,0,0,0,,Бұл менің тілегім.
Dialogue: 0,0:07:51.30,0:07:53.30,Default,,0,0,0,,Киома... сен!
Dialogue: 0,0:07:53.30,0:07:55.27,Default,,0,0,0,,Мұның бәрі сіздің аманатыңыз үшін.
Dialogue: 0,0:07:58.31,0:08:02.28,Default,,0,0,0,,Кьюма Куросаки Тайзо Сейзо Картаңызды көтеріңіз➡
Dialogue: 0,0:08:02.28,0:08:05.85,Default,,0,0,0,,Соғыс қоңырауын соғыңыз!
Dialogue: 0,0:08:05.85,0:08:08.32,Default,,0,0,0,,Тағдырға... Шешіңіз.
Dialogue: 0,0:08:09.28,0:08:11.29,Default,,0,0,0,,Құдай!
Dialogue: 0,0:08:12.79,0:08:14.82,Default,,0,0,0,,Уақыт келді➡
Dialogue: 0,0:08:14.82,0:08:18.79,Default,,0,0,0,,Енді тағдырдың екінші шайқасын бастайық.
Dialogue: 0,0:08:18.79,0:08:20.80,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:08:21.80,0:08:23.80,Default,,0,0,0,,Джеваль айдаһары.
Dialogue: 0,0:08:23.80,0:08:25.80,Default,,0,0,0,,Блиц бойынша бас механик Бартон.
Dialogue: 0,0:08:25.80,0:08:27.80,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:08:27.80,0:08:29.77,Default,,0,0,0,,Ракетенверф айдаһарына міну➡
Dialogue: 0,0:08:29.77,0:08:31.77,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:08:31.77,0:08:33.81,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:08:33.81,0:08:36.28,Default,,0,0,0,,Стразаға бару Шеберлікпен 1 картаны салыңыз➡
Dialogue: 0,0:08:36.28,0:08:38.28,Default,,0,0,0,,Стразаға шабуыл.
Dialogue: 0,0:08:38.28,0:08:40.28,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:08:40.28,0:08:42.78,Default,,0,0,0,,Бұрылыстың соңы Мен сенімен қатты соқтығысамын➡
Dialogue: 0,0:08:42.78,0:08:44.79,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:08:44.79,0:08:47.79,Default,,0,0,0,,Мен жеңемін➡
Dialogue: 0,0:08:47.79,0:08:49.79,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:08:49.79,0:08:51.79,Default,,0,0,0,,Гитлинг Канон Айдаһарына мініңіз➡
Dialogue: 0,0:08:51.79,0:08:55.30,Default,,0,0,0,,Ракетенверфті жаннан шеберлікпен шақырыңыз➡
Dialogue: 0,0:08:55.30,0:08:57.30,Default,,0,0,0,,Gatling Canone-мен шабуыл.
Dialogue: 0,0:08:57.30,0:08:59.33,Default,,0,0,0,,...
Dialogue: 0,0:08:59.33,0:09:02.30,Default,,0,0,0,,Ракетенверфпен шабуыл. күзетші.
Dialogue: 0,0:09:02.30,0:09:04.27,Default,,0,0,0,,Бұрылыстың соңы. Менің кезегім➡
Dialogue: 0,0:09:04.27,0:09:06.31,Default,,0,0,0,,Юбаға бару➡
