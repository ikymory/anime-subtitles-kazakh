Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.80,0:00:06.27,Default,,0,0,0,,｟Хикари!
Dialogue: 0,0:00:06.27,0:00:08.27,Default,,0,0,0,,Хикари! ➡
Dialogue: 0,0:00:08.27,0:00:10.34,Default,,0,0,0,,Кешіріңіз, Хикари➡
Dialogue: 0,0:00:10.34,0:00:12.31,Default,,0,0,0,,Бұл менің кінәм. Кешіріңіз. ｠
Dialogue: 0,0:00:39.27,0:00:41.24,Default,,0,0,0,,Маған күшіңізді беріңізші...
Dialogue: 0,0:00:42.27,0:00:44.27,Default,,0,0,0,,Резаэль.
Dialogue: 0,0:02:25.74,0:02:28.24,Default,,0,0,0,,Нао-сенпай. Yaho~.
Dialogue: 0,0:02:29.78,0:02:32.25,Default,,0,0,0,,Ал, мен бірінші барамын.
Dialogue: 0,0:02:34.22,0:02:36.22,Default,,0,0,0,,Сіз қалай ойлайсыз? Қалыңыз қалай?
Dialogue: 0,0:02:36.22,0:02:38.22,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:02:38.22,0:02:41.22,Default,,0,0,0,,Мм. Не...?
Dialogue: 0,0:02:41.22,0:02:43.69,Default,,0,0,0,,Сізді мазалайтын нәрсе бар ма?
Dialogue: 0,0:02:47.80,0:02:49.80,Default,,0,0,0,,Хикари маған айтты.
Dialogue: 0,0:02:51.80,0:02:54.74,Default,,0,0,0,,｟Ағаңның тілегі бар ма?
Dialogue: 0,0:02:54.74,0:02:57.24,Default,,0,0,0,,Хикари сау болғанша...
Dialogue: 0,0:02:57.24,0:02:59.31,Default,,0,0,0,,Мен үшін емес.
Dialogue: 0,0:02:59.31,0:03:01.28,Default,,0,0,0,,Бұл ағамның өз қалауы! ｠
Dialogue: 0,0:03:03.71,0:03:07.25,Default,,0,0,0,,Түсіндім, солай болды.
Dialogue: 0,0:03:07.25,0:03:11.22,Default,,0,0,0,,Бірақ мен Хикари-чанның не айтқысы келгенін түсіндім.
Dialogue: 0,0:03:11.22,0:03:13.22,Default,,0,0,0,,Е... Шынымен бе?
Dialogue: 0,0:03:13.22,0:03:15.19,Default,,0,0,0,,Мүмкін.
Dialogue: 0,0:03:16.26,0:03:19.76,Default,,0,0,0,,Жоқ, мен бұл туралы біраз ойланып көрейін.
Dialogue: 0,0:03:21.76,0:03:25.23,Default,,0,0,0,,Менің ойымша, мұндай заттарды өзіңіз табуыңыз керек...
Dialogue: 0,0:03:25.23,0:03:27.74,Default,,0,0,0,,Хикари және бүгінгі жекпе-жек туралы➡
Dialogue: 0,0:03:27.74,0:03:29.70,Default,,0,0,0,,Мен саған бар күшіммен қарсы тұрамын!
Dialogue: 0,0:03:29.70,0:03:31.74,Default,,0,0,0,,Мен көремін➡
Dialogue: 0,0:03:31.74,0:03:35.71,Default,,0,0,0,,Хехе, шынымен, Аки-кун, сен тайсалмайсың.
Dialogue: 0,0:03:35.71,0:03:38.21,Default,,0,0,0,,Мм, сізді мақтап жатыр ма?
Dialogue: 0,0:03:38.21,0:03:40.22,Default,,0,0,0,,Әрине! Кез келген уақытта➡
Dialogue: 0,0:03:40.22,0:03:42.72,Default,,0,0,0,,Берілмеңіз және қолыңызды созыңыз➡
Dialogue: 0,0:03:42.72,0:03:45.22,Default,,0,0,0,,Менің ойымша, бұл жақсы, Аки-кун.
Dialogue: 0,0:03:47.72,0:03:49.76,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:49.76,0:03:52.23,Default,,0,0,0,,Бар, Акина Мейдо!
Dialogue: 0,0:03:53.23,0:03:55.20,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:03:56.73,0:03:58.73,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:04:02.20,0:04:04.21,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе.
Dialogue: 0,0:04:09.75,0:04:13.22,Default,,0,0,0,,Ойоё~? Барлықтарыңыз жеңілгендер.
Dialogue: 0,0:04:13.22,0:04:15.22,Default,,0,0,0,,Теми де жеңіліп қалған шығар!
Dialogue: 0,0:04:15.22,0:04:17.75,Default,,0,0,0,,Хахаха...сіз айтқандай➡
Dialogue: 0,0:04:17.75,0:04:20.72,Default,,0,0,0,,Айтпақшы, сіз психикалық ластанудан зардап шеккенде➡
Dialogue: 0,0:04:20.72,0:04:22.72,Default,,0,0,0,,Өзіңізді қалай сезіндіңіз?
Dialogue: 0,0:04:22.72,0:04:24.73,Default,,0,0,0,,Сіз мені желпілдетесіз бе? Теми!
Dialogue: 0,0:04:24.73,0:04:26.73,Default,,0,0,0,,Жоқ, шындап айтамын➡
Dialogue: 0,0:04:26.73,0:04:28.70,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:04:31.23,0:04:34.24,Default,,0,0,0,,Дұрыс, біз ол кезде болатынбыз➡
Dialogue: 0,0:04:34.24,0:04:38.24,Default,,0,0,0,,Ол өз қалауы үшін бәрін жасауға дайын болды.
Dialogue: 0,0:04:38.24,0:04:41.74,Default,,0,0,0,,Хм... Мен өзімді ұстай алмаймын.
Dialogue: 0,0:04:41.74,0:04:45.75,Default,,0,0,0,,Бірақ сол кездегі тілегім шын еді.
Dialogue: 0,0:04:45.75,0:04:49.25,Default,,0,0,0,,Иә, Айкава-сан мен Мейдо-санның қалауы➡
Dialogue: 0,0:04:49.25,0:04:52.72,Default,,0,0,0,,Мен сізді құрметтегім келетінін сеземін.
Dialogue: 0,0:04:52.72,0:04:55.72,Default,,0,0,0,,Хе, жолдастық сезім сияқты ма?
Dialogue: 0,0:04:55.72,0:04:58.26,Default,,0,0,0,,Бұл соншалықты үлкен мәміле емес.
Dialogue: 0,0:04:58.26,0:05:01.73,Default,,0,0,0,,Бірақ мен тағдырлы шайқастың нәтижесін күтемін және көремін.
Dialogue: 0,0:05:02.73,0:05:04.70,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:21.22,0:05:23.25,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:05:23.25,0:05:26.25,Default,,0,0,0,,Айкава мырза.
Dialogue: 0,0:05:26.25,0:05:28.26,Default,,0,0,0,,Басқа адам - ​​сенің ағаң.
Dialogue: 0,0:05:31.76,0:05:34.73,Default,,0,0,0,,Мен қолымнан келгенін істеймін.
Dialogue: 0,0:05:36.26,0:05:39.27,Default,,0,0,0,,Ағаң сен үшін өте маңызды.
Dialogue: 0,0:05:40.27,0:05:44.21,Default,,0,0,0,,Жарайды. Сіздің тілегіңіз қате емес.
Dialogue: 0,0:05:44.21,0:05:46.21,Default,,0,0,0,,Сіз жеңдіңіз.
Dialogue: 0,0:05:47.21,0:05:49.21,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:54.32,0:05:56.79,Default,,0,0,0,,｟Бұл жақында орындалады.
Dialogue: 0,0:05:56.79,0:05:58.79,Default,,0,0,0,,Біздің тілектер. ｠
Dialogue: 0,0:06:01.26,0:06:04.23,Default,,0,0,0,,Хикари-чан осылайша бет-бейнесін жасай алды.
Dialogue: 0,0:06:04.23,0:06:07.23,Default,,0,0,0,,Менің ойымша, бұл көбірек ұқсайды.
Dialogue: 0,0:06:07.23,0:06:09.20,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:06:11.73,0:06:13.70,Default,,0,0,0,,Ол сондай бала.
Dialogue: 0,0:06:14.70,0:06:18.24,Default,,0,0,0,,А... Ақина-сенпай.
Dialogue: 0,0:06:18.24,0:06:20.21,Default,,0,0,0,,Мұнда да әдемі көрінесің.
Dialogue: 0,0:06:20.21,0:06:22.21,Default,,0,0,0,,Сәттілік, Сенпай!
Dialogue: 0,0:06:23.21,0:06:25.21,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:33.72,0:06:36.22,Default,,0,0,0,,Хикари Жасайық.
Dialogue: 0,0:06:36.22,0:06:38.23,Default,,0,0,0,,Un.
Dialogue: 0,0:06:38.23,0:06:41.23,Default,,0,0,0,,Акина Мейдо Хикари Мейдо! ➡
Dialogue: 0,0:06:41.23,0:06:44.23,Default,,0,0,0,,Карточкаңызды көтеріп, айқайлаңыз! ➡
Dialogue: 0,0:06:44.23,0:06:46.77,Default,,0,0,0,,Соғыс белгісі!
Dialogue: 0,0:06:46.77,0:06:49.20,Default,,0,0,0,,Тағдырға. Оны шешіңіз.
Dialogue: 0,0:06:49.20,0:06:51.21,Default,,0,0,0,,Құдай!
Dialogue: 0,0:06:53.21,0:06:55.24,Default,,0,0,0,,Уақыт келді ➡
Dialogue: 0,0:06:55.24,0:06:57.25,Default,,0,0,0,,Бұдан былай тағдырдың шешуші шайқасы➡
Dialogue: 0,0:06:57.25,0:07:00.22,Default,,0,0,0,,6-ойынды бастайық!
Dialogue: 0,0:07:00.22,0:07:02.22,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:07:03.22,0:07:05.22,Default,,0,0,0,,Ванли Пэн қанатының Гуя Кецаль.
Dialogue: 0,0:07:05.22,0:07:07.72,Default,,0,0,0,,Амбиция қанаттары Соел.
Dialogue: 0,0:07:07.72,0:07:10.26,Default,,0,0,0,,Менің кезегім ➡
Dialogue: 0,0:07:10.26,0:07:13.76,Default,,0,0,0,,Steam Maiden Tigrat қолданбасында айдау дағдысы іске қосылды.
Dialogue: 0,0:07:13.76,0:07:16.23,Default,,0,0,0,,Джишинги/Тағдыр қанаттарын реттілік аймағына орнатыңыз.
Dialogue: 0,0:07:17.73,0:07:19.73,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:07:19.73,0:07:21.70,Default,,0,0,0,,Жауап алдыңыз ба?
Dialogue: 0,0:07:21.70,0:07:23.71,Default,,0,0,0,,Ағамның өз тілегі.
Dialogue: 0,0:07:25.71,0:07:29.28,Default,,0,0,0,,Мен әлі білмеймін, бірақ менің қазіргі тілегім➡
Dialogue: 0,0:07:29.28,0:07:31.75,Default,,0,0,0,,Бұл жекпе-жекті жеңіп, Хикариді құтқарыңыз!
Dialogue: 0,0:07:33.21,0:07:35.22,Default,,0,0,0,,Менің кезегім Бентестаға мінемін.
Dialogue: 0,0:07:35.22,0:07:37.25,Default,,0,0,0,,Ауырсынуды басатын дәріні шақырыңыз➡
Dialogue: 0,0:07:37.25,0:07:40.22,Default,,0,0,0,,Бентестамен шабуыл. Күзетші жоқ.
Dialogue: 0,0:07:40.22,0:07:43.22,Default,,0,0,0,,Ауырсынуды басатын дәрімен шабуыл. күзетші.
Dialogue: 0,0:07:43.22,0:07:45.26,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:07:45.26,0:07:49.26,Default,,0,0,0,,Менің кезегім Мен өмір сызығы үзілген кеңістік-уақыт алыбына мінемін.
Dialogue: 0,0:07:49.26,0:07:53.74,Default,,0,0,0,,Дағдыларды белсендіру регресс көрсеткіші ретінде қолыңызға бір картаны қойыңыз➡
Dialogue: 0,0:07:53.74,0:07:55.70,Default,,0,0,0,,2 картаны сал.
Dialogue: 0,0:07:57.24,0:07:59.24,Default,,0,0,0,,Регресс өлшегіш?
Dialogue: 0,0:07:59.24,0:08:02.74,Default,,0,0,0,,Күнәны кесетін уақыт тағдырының күші.
Dialogue: 0,0:08:02.74,0:08:05.75,Default,,0,0,0,,Күнә? Бұл өткен қателік.
Dialogue: 0,0:08:05.75,0:08:08.75,Default,,0,0,0,,Мен оны түзетемін.
Dialogue: 0,0:08:08.75,0:08:12.75,Default,,0,0,0,,Амми Дитанаға қоңырау шалу Skill Space-Time Giantына 5000 қуат қосады.
Dialogue: 0,0:08:12.75,0:08:16.26,Default,,0,0,0,,Ғарыш уақытының алып сарбазымен шабуыл. Күзетші жоқ.
Dialogue: 0,0:08:16.26,0:08:19.23,Default,,0,0,0,,Амми Дитанамен шабуыл. күзетші.
Dialogue: 0,0:08:19.23,0:08:21.26,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:08:21.26,0:08:23.77,Default,,0,0,0,,Менің кезегім, Азенсиорға мін!
Dialogue: 0,0:08:23.77,0:08:27.77,Default,,0,0,0,,Бентестаға қоңырау шалу, Калбреге қоңырау шалу.
Dialogue: 0,0:08:27.77,0:08:30.24,Default,,0,0,0,,Осы шеберлікпен Гаругаонға қоңырау шалыңыз.
Dialogue: 0,0:08:30.24,0:08:33.27,Default,,0,0,0,,Азеншиормен шабуыл! күзетші.
Dialogue: 0,0:08:33.27,0:08:36.71,Default,,0,0,0,,Гальгаонмен ауыруды басатын дәрінің шабуылы!
Dialogue: 0,0:08:36.71,0:08:39.28,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:08:39.28,0:08:42.72,Default,,0,0,0,,Ауырсынуды тоқтатыңыз және 1 картаны салыңыз.
Dialogue: 0,0:08:42.72,0:08:45.22,Default,,0,0,0,,Кальбрмен шабуыл. күзетші.
Dialogue: 0,0:08:45.22,0:08:47.26,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:08:47.26,0:08:50.23,Default,,0,0,0,,Қателік шынымен сол уақытқа қатысты ма?
Dialogue: 0,0:08:51.76,0:08:55.23,Default,,0,0,0,,Өйткені ол кезде мен сені қорғай алмаған едім.
Dialogue: 0,0:08:56.77,0:08:59.73,Default,,0,0,0,,Сіз айтып отырған күнә менікі... басқа!
Dialogue: 0,0:09:01.20,0:09:03.24,Default,,0,0,0,,Үлкен аға жаман емес.
Dialogue: 0,0:09:03.24,0:09:05.74,Default,,0,0,0,,Сотталуға кінәлілер...
Dialogue: 0,0:09:07.21,0:09:09.21,Default,,0,0,0,,I.
Dialogue: 0,0:09:10.75,0:09:13.28,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:09:13.28,0:09:16.72,Default,,0,0,0,,Айыптау Қанаттары Өткеннен Мұнда!
Dialogue: 0,0:09:16.72,0:09:18.72,Default,,0,0,0,,Уақыт тағдыры➡
Dialogue: 0,0:09:18.72,0:09:21.19,Default,,0,0,0,,Одиумға бару.
Dialogue: 0,0:09:34.27,0:09:37.81,Default,,0,0,0,,Тапсырыс картасы Себеп-салдарлық бұрмалауды/айыптауды пайдаланыңыз.
Dialogue: 0,0:09:37.81,0:09:41.78,Default,,0,0,0,,Соул бұл картаны регресс өлшегіш үшін зарядтайды.
Dialogue: 0,0:09:41.78,0:09:45.25,Default,,0,0,0,,Содан кейін бір картаны тартыңыз және Reel қуатын плюс 10000 алыңыз.
Dialogue: 0,0:09:45.25,0:09:47.78,Default,,0,0,0,,Регресс көрсеткіші де ұлғайтылды.
Dialogue: 0,0:09:47.78,0:09:49.78,Default,,0,0,0,,Бұл бәрі емес.
Dialogue: 0,0:09:49.78,0:09:52.79,Default,,0,0,0,,Reel шеберлігінің арқасында регресс көрсеткіші болды➡
Dialogue: 0,0:09:52.79,0:09:54.79,Default,,0,0,0,,Себеп-салдарлық бұрмалау/бір бөлікке айыптау ➡
Dialogue: 0,0:09:54.79,0:09:57.79,Default,,0,0,0,,Алдыңғы қатардың артқы қорғанысының күші +5000-ға артады.
Dialogue: 0,0:09:59.26,0:10:01.26,Default,,0,0,0,,Ablaze Chimera деп атаңыз.
Dialogue: 0,0:10:01.26,0:10:03.77,Default,,0,0,0,,Палубаның жоғарғы 5 картасынан таңдау үшін дағдыларды қолданыңыз➡
Dialogue: 0,0:10:03.77,0:10:06.23,Default,,0,0,0,,Амми Дитанаға қоңырау шалыңыз.
Dialogue: 0,0:10:07.30,0:10:10.24,Default,,0,0,0,,Амми Дитанамен шабуыл! күзетші.
Dialogue: 0,0:10:10.24,0:10:12.24,Default,,0,0,0,,Уақыт күші➡
Dialogue: 0,0:10:12.24,0:10:14.28,Default,,0,0,0,,Жылдамдаңыз!
Dialogue: 0,0:10:14.28,0:10:17.78,Default,,0,0,0,,Reel Odium-да шабуыл дағдысы іске қосылды.
Dialogue: 0,0:10:17.78,0:10:20.25,Default,,0,0,0,,Амми Дитананы регресс өлшегішке айналдыру арқылы➡
Dialogue: 0,0:10:20.25,0:10:22.32,Default,,0,0,0,,Үштік жетек алыңыз!
Dialogue: 0,0:10:22.32,0:10:25.79,Default,,0,0,0,,Сонымен қатар, Амми Дитананың регресс көрсеткішіне айналған шеберлігімен ➡
Dialogue: 0,0:10:25.79,0:10:28.26,Default,,0,0,0,,Ролдың қуаты плюс 5000!
Dialogue: 0,0:10:28.26,0:10:30.26,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:10:30.26,0:10:32.23,Default,,0,0,0,,Бірінші тексеру….
Dialogue: 0,0:10:33.76,0:10:36.30,Default,,0,0,0,,Екінші тексеру….
Dialogue: 0,0:10:36.30,0:10:39.77,Default,,0,0,0,,Критикалық триггер Амми Детананың қуаты +10000.
Dialogue: 0,0:10:39.77,0:10:42.74,Default,,0,0,0,,Ролдың сыни плюс 1.
Dialogue: 0,0:10:42.74,0:10:44.74,Default,,0,0,0,,Үшінші тексеру➡
Dialogue: 0,0:10:44.74,0:10:46.74,Default,,0,0,0,,Критикалық триггер!
Dialogue: 0,0:10:46.74,0:10:48.78,Default,,0,0,0,,Амми Дитананың күші +10000➡
Dialogue: 0,0:10:48.78,0:10:51.25,Default,,0,0,0,,Ролдың критикалық +1 мәні.
Dialogue: 0,0:10:51.25,0:10:53.25,Default,,0,0,0,,Қос сын!
Dialogue: 0,0:10:53.25,0:10:55.25,Default,,0,0,0,,Амми Дитанамен шабуыл!
Dialogue: 0,0:10:55.25,0:10:57.25,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:10:57.25,0:10:59.25,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:10:59.25,0:11:01.26,Default,,0,0,0,,Зақым 5➡
Dialogue: 0,0:11:01.26,0:11:03.29,Default,,0,0,0,,Бірақ егер бұл Резаэль болса...
Dialogue: 0,0:11:03.29,0:11:05.79,Default,,0,0,0,,Нағыз оқиға осы жерден басталады.
Dialogue: 0,0:11:07.26,0:11:09.23,Default,,0,0,0,,Сөзсіз жеңіңіз.
Dialogue: 0,0:11:10.77,0:11:13.77,Default,,0,0,0,,Күнәларды өтеу.
Dialogue: 0,0:11:14.74,0:11:18.24,Default,,0,0,0,,Менің жекпе-жегімнің мәні осы!
Dialogue: 0,0:11:20.68,0:11:22.74,Default,,0,0,0,,Хикари, айтшы➡
Dialogue: 0,0:11:22.74,0:11:25.68,Default,,0,0,0,,Сіздің арқаңызда қандай күнә бар?
Dialogue: 0,0:11:25.68,0:11:27.68,Default,,0,0,0,,Тыңда, сен не істейсің?
Dialogue: 0,0:11:27.68,0:11:30.22,Default,,0,0,0,,Мен не істей алатынымды білмеймін➡
Dialogue: 0,0:11:30.22,0:11:33.72,Default,,0,0,0,,Хикари қиналып жатса, мен көмектескім келеді.
Dialogue: 0,0:11:35.19,0:11:37.73,Default,,0,0,0,,Бұл туралы. жұмысшы?
Dialogue: 0,0:11:37.73,0:11:40.70,Default,,0,0,0,,Бұл менің күнәм, оны ешкім көтере алмайды.
Dialogue: 0,0:11:40.70,0:11:43.70,Default,,0,0,0,,Түсінбесең, аузыңды жап!
Dialogue: 0,0:11:47.70,0:11:49.70,Default,,0,0,0,,Менің кезегім!
Dialogue: 0,0:11:49.70,0:11:52.24,Default,,0,0,0,,Құтқару қанаттары Міне, көктен!
Dialogue: 0,0:11:52.24,0:11:55.21,Default,,0,0,0,,Резаэльдің ғажайып тағдырына мініңіз!
Dialogue: 0,0:11:56.21,0:11:58.18,Default,,0,0,0,,Садиге қоңырау шалу.
Dialogue: 0,0:11:58.18,0:12:00.78,Default,,0,0,0,,Astute Knight Catels шақырыңыз!
Dialogue: 0,0:12:00.78,0:12:03.25,Default,,0,0,0,,Резаэлдің күші +5000 шеберлікпен!
Dialogue: 0,0:12:03.25,0:12:06.22,Default,,0,0,0,,Бұл карта артқы қатардан ұстап алады!
Dialogue: 0,0:12:07.19,0:12:09.72,Default,,0,0,0,,Кеттік, ғажайып келді!
Dialogue: 0,0:12:09.72,0:12:11.69,Default,,0,0,0,,Құдайдың шеберлігі іске қосылды!
Dialogue: 0,0:12:12.76,0:12:15.76,Default,,0,0,0,,Критикалық триггерді түсіру Барлығын палубаға қайтару➡
Dialogue: 0,0:12:15.76,0:12:18.20,Default,,0,0,0,,Rezael's Drive Plus 1!
Dialogue: 0,0:12:18.20,0:12:21.20,Default,,0,0,0,,Кальбрмен шабуыл! күзетші.
Dialogue: 0,0:12:21.20,0:12:24.24,Default,,0,0,0,,Садимен шабуыл! күзетші.
Dialogue: 0,0:12:24.24,0:12:27.74,Default,,0,0,0,,Кателлустың Резаэлді күшейтуімен шабуыл!
Dialogue: 0,0:12:27.74,0:12:31.21,Default,,0,0,0,,Дағды Нилберис пен Гигантехті құлаудан шақырады.
Dialogue: 0,0:12:38.69,0:12:40.69,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:12:40.69,0:12:42.69,Default,,0,0,0,,Бірінші тексеру….
Dialogue: 0,0:12:44.73,0:12:46.76,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:12:46.76,0:12:49.70,Default,,0,0,0,,Critical Trigger Nilberis Пауэр Plus 10000➡
Dialogue: 0,0:12:49.70,0:12:52.17,Default,,0,0,0,,Резаэльдің сыни плюс 1!
Dialogue: 0,0:12:54.20,0:12:57.71,Default,,0,0,0,,Үшінші триггерді тексеріңіз!
Dialogue: 0,0:12:57.71,0:13:00.17,Default,,0,0,0,,Алдыңғы қатардағы қуат плюс 10 000!
Dialogue: 0,0:13:06.25,0:13:08.72,Default,,0,0,0,,Gigantech-пен шабуыл! Күзетші жоқ.
Dialogue: 0,0:13:10.22,0:13:13.22,Default,,0,0,0,,Нилбериспен шабуыл! Толық күзетші!
Dialogue: 0,0:13:13.22,0:13:16.72,Default,,0,0,0,,Ұрыс соңында Нилберистің шеберлігі іске қосылады.
Dialogue: 0,0:13:16.72,0:13:19.69,Default,,0,0,0,,Бір картаны салыңыз және палубаның жоғарғы жағына қараңыз➡
Dialogue: 0,0:13:19.69,0:13:23.23,Default,,0,0,0,,Жоғарыға оралу Бұрылудың соңы.
Dialogue: 0,0:13:23.23,0:13:26.70,Default,,0,0,0,,Палубаның үстінде Триггер болды ма? Сіз қалай ойлайсыз?
Dialogue: 0,0:13:26.70,0:13:29.24,Default,,0,0,0,,Жарайды...жақсы➡
Dialogue: 0,0:13:29.24,0:13:31.71,Default,,0,0,0,,Бұл туралы ештеңе істей аламын деп ойламаңыз.
Dialogue: 0,0:13:31.71,0:13:33.71,Default,,0,0,0,,Мен жасап көремін.
Dialogue: 0,0:13:34.71,0:13:36.74,Default,,0,0,0,,Хикари мен жеңемін➡
Dialogue: 0,0:13:36.74,0:13:39.75,Default,,0,0,0,,Жеңіңіз және психикалық ластануды жойыңыз➡
Dialogue: 0,0:13:39.75,0:13:43.22,Default,,0,0,0,,Тіпті бұл мені жек көретінін білдірсе де➡
Dialogue: 0,0:13:43.22,0:13:45.72,Default,,0,0,0,,Сен мені құтқара алсаң, мен...
Dialogue: 0,0:13:46.69,0:13:48.76,Default,,0,0,0,,Мен мұны жек көремін!
Dialogue: 0,0:13:48.76,0:13:52.19,Default,,0,0,0,,Себебі оның бәрін өз бетімен көтеруге тырысқаны ұнамайды➡
Dialogue: 0,0:13:52.19,0:13:54.70,Default,,0,0,0,,Мен өткенді өзгерткім келді!
Dialogue: 0,0:13:54.70,0:13:56.73,Default,,0,0,0,,Бұл менің тілегім➡
Dialogue: 0,0:13:56.73,0:14:00.20,Default,,0,0,0,,Өткенге саяхат жасап, сол күнгі оқиғаларды өзгерту.
Dialogue: 0,0:14:00.20,0:14:02.74,Default,,0,0,0,,Бұл оқыс оқиға болды ғой...
Dialogue: 0,0:14:02.74,0:14:06.21,Default,,0,0,0,,Біздің тағдырымыз сол күні шешілді.
Dialogue: 0,0:14:13.85,0:14:16.68,Default,,0,0,0,,｟Кешіріңіз Хикари…. ｠
Dialogue: 0,0:14:16.68,0:14:18.72,Default,,0,0,0,,Біз лагерьге бардық➡
Dialogue: 0,0:14:18.72,0:14:21.76,Default,,0,0,0,,Мен таулардың тереңіндегі қираған жерде құлау апатына тап болдым.
Dialogue: 0,0:14:21.76,0:14:24.23,Default,,0,0,0,,Содан бері менің денем біртүрлі болып қалды➡
Dialogue: 0,0:14:24.23,0:14:26.73,Default,,0,0,0,,Науқас бірнеше рет ауруханаға жатқызылды.
Dialogue: 0,0:14:28.73,0:14:32.20,Default,,0,0,0,,Сондықтан мен сол кезде өзіме ант бердім.
Dialogue: 0,0:14:34.20,0:14:36.24,Default,,0,0,0,,Себебі мен енді өкінгім келмейді➡
Dialogue: 0,0:14:36.24,0:14:39.21,Default,,0,0,0,,Қандай жағдай болса да, берілме, қол соз.
Dialogue: 0,0:14:41.71,0:14:43.71,Default,,0,0,0,,Үйінділер?
Dialogue: 0,0:14:43.71,0:14:45.68,Default,,0,0,0,,Үлкен аға - бұл➡
Dialogue: 0,0:14:45.68,0:14:48.22,Default,,0,0,0,,Сол апат болмаса➡
Dialogue: 0,0:14:48.22,0:14:50.18,Default,,0,0,0,,Сіз бұл туралы ойлап көрдіңіз бе?
Dialogue: 0,0:14:50.18,0:14:52.72,Default,,0,0,0,,Мен үнемі ойланып жүретінмін.
Dialogue: 0,0:14:52.72,0:14:55.72,Default,,0,0,0,,Бұл қалай болды деп ойлаймын.
Dialogue: 0,0:14:55.72,0:14:57.69,Default,,0,0,0,,Ағам жоғалтқан уақыттың орнын толтыру үшін не істеуім керек?
Dialogue: 0,0:14:57.69,0:14:59.69,Default,,0,0,0,,Ол оны қайтарып алуға болатынын айтты.
Dialogue: 0,0:15:00.70,0:15:02.70,Default,,0,0,0,,Сол күннен бастап, інім➡
Dialogue: 0,0:15:02.70,0:15:05.73,Default,,0,0,0,,Ол маған үнемі қамқорлық жасай бастады.
Dialogue: 0,0:15:05.73,0:15:09.70,Default,,0,0,0,,Сен маған көп уақыт бөлдің.
Dialogue: 0,0:15:09.70,0:15:12.21,Default,,0,0,0,,Мен әрқашан ризамын.
Dialogue: 0,0:15:12.21,0:15:14.18,Default,,0,0,0,,Менің ойымша, бұл шынымен де керемет.
Dialogue: 0,0:15:15.71,0:15:20.18,Default,,0,0,0,,Бірақ бұл да қиын болды.
Dialogue: 0,0:15:22.18,0:15:24.72,Default,,0,0,0,,Мен үшін өзіңді құрбан ет➡
Dialogue: 0,0:15:24.72,0:15:26.69,Default,,0,0,0,,Ағамды бұлай көру қиын.
Dialogue: 0,0:15:26.69,0:15:29.72,Default,,0,0,0,,Менің ойымша, бұл құрбандық емес...
Dialogue: 0,0:15:29.72,0:15:31.73,Default,,0,0,0,,Олай болса, тағы бір рет сұрайын.
Dialogue: 0,0:15:31.73,0:15:34.23,Default,,0,0,0,,Ағаңның тілегі қандай?
Dialogue: 0,0:15:34.23,0:15:37.23,Default,,0,0,0,,Мен үшін емес Өз тілегіңіз бар ма?
Dialogue: 0,0:15:39.70,0:15:41.70,Default,,0,0,0,,Мен бұған әлі жауап бере алмаймын.
Dialogue: 0,0:15:43.20,0:15:46.21,Default,,0,0,0,,Дұрыс, кешіріңіз➡
Dialogue: 0,0:15:46.21,0:15:48.24,Default,,0,0,0,,Оның болғанына мен кінәлімін➡
Dialogue: 0,0:15:48.24,0:15:51.21,Default,,0,0,0,,Мен ағамның тағдырын өзгерттім➡
Dialogue: 0,0:15:51.21,0:15:53.68,Default,,0,0,0,,Уақыт ұрланды➡
Dialogue: 0,0:15:53.68,0:15:55.72,Default,,0,0,0,,Бұл менің күнәм.
Dialogue: 0,0:15:55.72,0:15:57.69,Default,,0,0,0,,Хикари….
Dialogue: 0,0:15:57.69,0:16:00.19,Default,,0,0,0,,Сондықтан мен мұны істеуім керек.
Dialogue: 0,0:16:00.19,0:16:02.22,Default,,0,0,0,,Менің күнәларымды өшір!
Dialogue: 0,0:16:02.22,0:16:04.73,Default,,0,0,0,,Уақыт Тағдырының күшімен өткенге саяхат➡
Dialogue: 0,0:16:04.73,0:16:06.76,Default,,0,0,0,,Ағаңның уақытын қайтар!
Dialogue: 0,0:16:06.76,0:16:10.73,Default,,0,0,0,,Менің кезегім Свирлерді шақырады.
Dialogue: 0,0:16:10.73,0:16:13.70,Default,,0,0,0,,Және себепті бұрмалау мен айыптауды қолдану.
Dialogue: 0,0:16:13.70,0:16:15.74,Default,,0,0,0,,Бұл карта регресс көрсеткішіне айналады.
Dialogue: 0,0:16:15.74,0:16:18.71,Default,,0,0,0,,Әрі қарай, Ablaze Chimera-ға қоңырау шалыңыз!
Dialogue: 0,0:16:18.71,0:16:21.71,Default,,0,0,0,,Анахронос Айдаһарды осы шеберлікпен шақырыңыз!
Dialogue: 0,0:16:21.71,0:16:23.74,Default,,0,0,0,,Анахроноспен шабуыл!
Dialogue: 0,0:16:23.74,0:16:27.68,Default,,0,0,0,,Дағды қуатты 5000-ға арттырады және Catels-тен шегінеді!
Dialogue: 0,0:16:27.68,0:16:30.22,Default,,0,0,0,,Күзетші жоқ! Зақымдануды тексеру➡
Dialogue: 0,0:16:30.22,0:16:32.72,Default,,0,0,0,,Критикалық триггер!
Dialogue: 0,0:16:32.72,0:16:34.72,Default,,0,0,0,,Мен сіздің сезіміңізді түсінемін.
Dialogue: 0,0:16:34.72,0:16:37.23,Default,,0,0,0,,Бірақ мен мұны көп айта аламын.
Dialogue: 0,0:16:37.23,0:16:40.23,Default,,0,0,0,,Мен өзімді құрбан еткен жоқпын!
Dialogue: 0,0:16:40.23,0:16:42.23,Default,,0,0,0,,Мен жай ғана қол соза бердім!
Dialogue: 0,0:16:44.73,0:16:47.70,Default,,0,0,0,,Аз ғана жарықтың өзі қолын созғандарға ғана➡
Dialogue: 0,0:16:47.70,0:16:50.71,Default,,0,0,0,,Ғажайыптар түседі.
Dialogue: 0,0:16:50.71,0:16:52.67,Default,,0,0,0,,Ғажайыптың екінші келуі!
Dialogue: 0,0:16:54.24,0:16:56.81,Default,,0,0,0,,Триггер 6-зақымда пайда болған кезде➡
Dialogue: 0,0:16:56.81,0:16:58.81,Default,,0,0,0,,Бір зиянды қалпына келтіріңіз!
Dialogue: 0,0:17:04.19,0:17:06.69,Default,,0,0,0,,Ғажайып құдайлық шеберлік...
Dialogue: 0,0:17:07.76,0:17:11.23,Default,,0,0,0,,Бірақ бұл мені тоқтата алмайды!
Dialogue: 0,0:17:13.19,0:17:16.20,Default,,0,0,0,,Авангардқа Reel Odium арқылы шабуыл жасаңыз!
Dialogue: 0,0:17:16.20,0:17:19.20,Default,,0,0,0,,Анахроносты регресс өлшегішке айналдыру үшін дағдыны пайдаланыңыз➡
Dialogue: 0,0:17:19.20,0:17:21.20,Default,,0,0,0,,Үштік жетек алыңыз!
Dialogue: 0,0:17:21.20,0:17:23.20,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:17:23.20,0:17:25.17,Default,,0,0,0,,Бірінші тексеру….
Dialogue: 0,0:17:27.21,0:17:29.18,Default,,0,0,0,,Екінші тексеру….
Dialogue: 0,0:17:30.75,0:17:33.71,Default,,0,0,0,,Үшінші тексеру сауықтыру триггері!
Dialogue: 0,0:17:33.71,0:17:36.22,Default,,0,0,0,,Амми Дитананың күші плюс 10 000!
Dialogue: 0,0:17:39.69,0:17:42.19,Default,,0,0,0,,Үлкен ағаның айтудан басқа амалы жоқ➡
Dialogue: 0,0:17:42.19,0:17:44.19,Default,,0,0,0,,Құрбандықтар жоқ➡
Dialogue: 0,0:17:44.19,0:17:46.19,Default,,0,0,0,,Сіз қазір кез келген нәрсені айта аласыз.
Dialogue: 0,0:17:47.73,0:17:51.20,Default,,0,0,0,,Менің інім менің кесірімнен көп уақыт жоғалтты➡
Dialogue: 0,0:17:51.20,0:17:53.70,Default,,0,0,0,,Бұл өзгермейтін факт!
Dialogue: 0,0:17:53.70,0:17:55.70,Default,,0,0,0,,Өткен уақыт –➡
Dialogue: 0,0:17:55.70,0:17:57.67,Default,,0,0,0,,Ол ешқашан қайтып келмейді.
Dialogue: 0,0:17:59.21,0:18:02.71,Default,,0,0,0,,Сондықтан бізге бұл күш керек!
Dialogue: 0,0:18:02.71,0:18:04.71,Default,,0,0,0,,Уақытты бұрмалайды➡
Dialogue: 0,0:18:04.71,0:18:06.68,Default,,0,0,0,,Құдайдың шеберлігі іске қосылды!
Dialogue: 0,0:18:08.68,0:18:10.72,Default,,0,0,0,,Кел!
Dialogue: 0,0:18:10.72,0:18:14.72,Default,,0,0,0,,Регресс өлшегіште 5 немесе одан да көп карта болса, қолыңыздан 2 картаны тастаңыз.
Dialogue: 0,0:18:17.69,0:18:20.70,Default,,0,0,0,,Е...бәрі осы ма?
Dialogue: 0,0:18:22.23,0:18:25.23,Default,,0,0,0,,Аблаздың Амми Дитана күшейтуімен шабуыл!
Dialogue: 0,0:18:26.70,0:18:28.70,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:18:28.70,0:18:30.77,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:18:30.77,0:18:33.77,Default,,0,0,0,,｟Мен бұған төзе алдым, бірақ шын мәнінде бәрі осы ма?➡
Dialogue: 0,0:18:33.77,0:18:37.75,Default,,0,0,0,,Жоқ, не болса да, мен өз кезегімде жеңгенше... ｠
Dialogue: 0,0:18:37.75,0:18:40.18,Default,,0,0,0,,Енді сіздің кезегіңіз емес.
Dialogue: 0,0:18:40.18,0:18:42.18,Default,,0,0,0,,E?
Dialogue: 0,0:18:46.19,0:18:48.19,Default,,0,0,0,,Не?
Dialogue: 0,0:18:48.19,0:18:50.69,Default,,0,0,0,,Уақыт күшін бейнелейтін ореол➡
Dialogue: 0,0:18:50.69,0:18:54.23,Default,,0,0,0,,Күнәны тоқтату үшін уақыт пен кеңістікті бұрмалау.
Dialogue: 0,0:18:54.23,0:18:57.73,Default,,0,0,0,,Тәңірлік шеберліктің әсерінен кезек аяқталғаннан кейін➡
Dialogue: 0,0:18:57.73,0:18:59.70,Default,,0,0,0,,Менің кезегімді қайтадан алыңыз!
Dialogue: 0,0:18:59.70,0:19:01.74,Default,,0,0,0,,Ха?
Dialogue: 0,0:19:01.74,0:19:06.21,Default,,0,0,0,,Ондай нәрсе бар ма? Бұл шынымен уақытты қайтаратын күш пе?
Dialogue: 0,0:19:06.21,0:19:08.74,Default,,0,0,0,,Хаха, бұл ақылсыз!
Dialogue: 0,0:19:08.74,0:19:12.25,Default,,0,0,0,,Жаман! Бұрылыс аяқталғаннан кейін Резаэлдің күші қалыпты жағдайға оралады.
Dialogue: 0,0:19:13.18,0:19:16.72,Default,,0,0,0,,Өткенді еске түсіріңіз!
Dialogue: 0,0:19:16.72,0:19:20.69,Default,,0,0,0,,Менің кезегім тұрып, сурет сал!
Dialogue: 0,0:19:21.76,0:19:25.19,Default,,0,0,0,,Жүру фазасы мен негізгі фаза қосымша бұрылыстарда орындалмайды➡
Dialogue: 0,0:19:25.19,0:19:28.23,Default,,0,0,0,,Роль жетекі -1.
Dialogue: 0,0:19:28.23,0:19:32.23,Default,,0,0,0,,Ұрыс кезеңінің басында Анахроностың регресс өлшегішіндегі шеберлігі іске қосылады.
Dialogue: 0,0:19:33.23,0:19:37.24,Default,,0,0,0,,Тамшыдан бір картаны регресс өлшегішке салыңыз және өзіңізге қоңырау шалыңыз.
Dialogue: 0,0:19:37.24,0:19:40.21,Default,,0,0,0,,Амми Дитанамен шабуыл! күзетші!
Dialogue: 0,0:19:40.21,0:19:44.21,Default,,0,0,0,,Авангардқа Reel Odium арқылы шабуыл жасаңыз!
Dialogue: 0,0:19:44.21,0:19:46.68,Default,,0,0,0,,Шеберлікпен үш еселік айдауды алыңыз!
Dialogue: 0,0:19:52.69,0:19:54.69,Default,,0,0,0,,Керемет... Күзетші!
Dialogue: 0,0:19:57.22,0:20:01.23,Default,,0,0,0,,Ағамды жеңемін, Тілегімді орындаймын.
Dialogue: 0,0:20:02.70,0:20:04.70,Default,,0,0,0,,Майюри сол жарыққа тартылып бара жатқандай болды
Dialogue: 0,0:20:07.20,0:20:09.20,Default,,0,0,0,,Бірінші тексеру….
Dialogue: 0,0:20:09.20,0:20:12.74,Default,,0,0,0,,Екінші тексеру…Триггерді тартыңыз!
Dialogue: 0,0:20:12.74,0:20:14.71,Default,,0,0,0,,Reel Odium қуаты плюс 10 000!
Dialogue: 0,0:20:18.18,0:20:20.68,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:20:26.69,0:20:29.19,Default,,0,0,0,,Триггер жоқ….
Dialogue: 0,0:20:33.76,0:20:36.73,Default,,0,0,0,,Жеңімпаз: Уақыт тағдыры!
Dialogue: 0,0:20:38.70,0:20:40.67,Default,,0,0,0,,Мен жасадым...
Dialogue: 0,0:20:50.21,0:20:52.21,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:20:52.21,0:20:54.68,Default,,0,0,0,,Кешіріңіз, егер мен жеңген болсам➡
Dialogue: 0,0:20:54.68,0:20:56.75,Default,,0,0,0,,Бұл біздің жеңісіміз болды.
Dialogue: 0,0:20:56.75,0:20:59.19,Default,,0,0,0,,Бірақ бұл жақсы жекпе-жек болды.
Dialogue: 0,0:20:59.19,0:21:01.69,Default,,0,0,0,,Дұрыс, енді 3-тен 3-ке тең.
Dialogue: 0,0:21:01.69,0:21:04.23,Default,,0,0,0,,Маңыздысы қазірден бастап.
Dialogue: 0,0:21:04.23,0:21:06.69,Default,,0,0,0,,Иә, тағдырлы шайқаста не болады➡
Dialogue: 0,0:21:06.69,0:21:10.20,Default,,0,0,0,,Ұлттық құрамаға берілді➡
Dialogue: 0,0:21:10.20,0:21:13.70,Default,,0,0,0,,Енді бұл өкіл...
Dialogue: 0,0:21:14.70,0:21:16.70,Default,,0,0,0,,Мен тағы барамын➡
Dialogue: 0,0:21:16.70,0:21:18.71,Default,,0,0,0,,Мұнда жеңіңіз➡
Dialogue: 0,0:21:18.71,0:21:21.21,Default,,0,0,0,,Тілегіңізді орындаңыз.
Dialogue: 0,0:21:21.21,0:21:23.24,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:21:23.24,0:21:27.18,Default,,0,0,0,,Сонда мұндағы өкіл Хикари Мейдо➡
Dialogue: 0,0:21:27.18,0:21:30.18,Default,,0,0,0,,Сіздің өкіліңіз кім?
Dialogue: 0,0:21:31.72,0:21:33.69,Default,,0,0,0,,Бұл шайқас сіздің тағдырыңызды шешеді➡
Dialogue: 0,0:21:33.69,0:21:36.72,Default,,0,0,0,,Біз бұл жерде мұқият ойлануымыз керек.
Dialogue: 0,0:21:36.72,0:21:38.69,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:21:38.69,0:21:40.69,Default,,0,0,0,,Маған тағы да...
Dialogue: 0,0:21:40.69,0:21:42.70,Default,,0,0,0,,Мен күресемін.
Dialogue: 0,0:21:47.20,0:21:49.17,Default,,0,0,0,,E?
Dialogue: 0,0:21:51.21,0:21:54.18,Default,,0,0,0,,Қатысу үшін біліктілік бар ма?
Dialogue: 0,0:21:55.24,0:21:59.25,Default,,0,0,0,,Өйткені мен де «Уақыт тағдыры» картасының иесімін.
Dialogue: 0,0:22:00.75,0:22:06.75,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory