Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.67,0:00:17.54,Default,,0,0,0,,Сіз компаниядан шықтыңыз, солай ма?
Dialogue: 0,0:00:18.50,0:00:19.38,Default,,0,0,0,,‎（‎‎）
Dialogue: 0,0:00:20.79,0:00:23.00,Default,,0,0,0,,Сіз мұны айтуыңыз керек. Сіз олар білмейді деп ойладыңыз ба?
Dialogue: 0,0:00:24.17,0:00:27.00,Default,,0,0,0,,Жұмысыңызды тастаған кезде сақтандыруды Ұлттық медициналық сақтандыруға ауыстырдыңыз ба?
Dialogue: 0,0:00:29.09,0:00:32.09,Default,,0,0,0,,‎Сізге жіберілген төлем түбіртегі алдыңғы мекенжайыңызға келді.
Dialogue: 0,0:00:32.17,0:00:33.92,Default,,0,0,0,,‎Пәтер менеджері ‎Назар
Dialogue: 0,0:00:34.00,0:00:36.04,Default,,0,0,0,,Мен оны үйіме жібердім.
Dialogue: 0,0:00:37.34,0:00:38.54,Default,,0,0,0,,‎Мекенжайыңыз өзгерсе
Dialogue: 0,0:00:38.63,0:00:41.54,Default,,0,0,0,,Мен поштаны қайта жіберу процедураларын орындауым керек еді.
Dialogue: 0,0:00:42.63,0:00:44.09,Default,,0,0,0,,♪～
Dialogue: 0,0:00:44.09,0:00:45.17,Default,,0,0,0,,♪~ Қазір қайдасың?
Dialogue: 0,0:00:45.17,0:00:47.29,Default,,0,0,0,,♪～
Dialogue: 0,0:00:47.29,0:00:48.75,Default,,0,0,0,,♪～ ‎Сен жер бетінде қалай өмір сүресің?
Dialogue: 0,0:00:48.75,0:00:49.63,Default,,0,0,0,,Сіз жер бетінде қалай өмір сүресіз?
Dialogue: 0,0:01:24.79,0:01:29.79,Default,,0,0,0,,～♪
Dialogue: 0,0:01:37.42,0:01:38.54,Default,,0,0,0,,‎Ха…
Dialogue: 0,0:01:40.34,0:01:41.79,Default,,0,0,0,,Әлі де кеш емес
Dialogue: 0,0:01:42.42,0:01:43.79,Default,,0,0,0,,Үйге бару керек.
Dialogue: 0,0:01:43.88,0:01:46.04,Default,,0,0,0,,‎(Рецуко) Жоқ, ‎(Хайда) Неге?
Dialogue: 0,0:01:47.25,0:01:50.38,Default,,0,0,0,,‎Себебі бұл менің ата-анаммен сәлемдесу мүмкіндігі.
Dialogue: 0,0:01:51.79,0:01:52.92,Default,,0,0,0,,‎Біріншіден, бұл жолы
Dialogue: 0,0:01:53.00,0:01:55.54,Default,,0,0,0,,Олар менің жұмыссыз екенімді білді, өйткені мені шақырды.
Dialogue: 0,0:01:55.63,0:01:57.71,Default,,0,0,0,,Рецуко келді, оның мағынасы жоқ, солай ма?
Dialogue: 0,0:01:58.21,0:01:59.46,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:01:59.54,0:02:01.54,Default,,0,0,0,,‎"Уайымдама, сіздің ұлыңыз осындай⸺"
Dialogue: 0,0:02:01.63,0:02:04.29,Default,,0,0,0,,Мен сізге айта аламын: ''Мен бар күшімді салып жатырмын''.
Dialogue: 0,0:02:04.38,0:02:05.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:06.00,0:02:09.50,Default,,0,0,0,,Әкең Хайда-кун үшін уайымдап жатыр, солай ма?
Dialogue: 0,0:02:09.59,0:02:12.34,Default,,0,0,0,,Біз ондай ата-ана емеспіз.
Dialogue: 0,0:02:14.50,0:02:15.67,Default,,0,0,0,,Сіз қандай ата-анасыз?
Dialogue: 0,0:02:19.13,0:02:22.63,Default,,0,0,0,,‎(Такси есігін ашу/жабу дыбысы)
Dialogue: 0,0:02:27.00,0:02:27.96,Default,,0,0,0,,Біз келдік.
Dialogue: 0,0:02:28.75,0:02:29.59,Default,,0,0,0,,А...
Dialogue: 0,0:02:39.04,0:02:40.29,Default,,0,0,0,,‎Никко Эдомура?
Dialogue: 0,0:02:40.38,0:02:41.46,Default,,0,0,0,,‎(Хайда) Өренші
Dialogue: 0,0:02:45.25,0:02:46.71,Default,,0,0,0,,‎(Ретсуко) Әкем...
Dialogue: 0,0:02:47.42,0:02:48.50,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:02:50.04,0:02:51.00,Default,,0,0,0,,Парламент депутаты
Dialogue: 0,0:02:51.09,0:02:52.21,Default,,0,0,0,,‎Уау, бұл керемет!
Dialogue: 0,0:02:52.29,0:02:54.42,Default,,0,0,0,,‎(Ретсуко) Қалалық кеңестің мүшесі? (Хайда) Жоқ.
Dialogue: 0,0:02:55.46,0:02:56.42,Default,,0,0,0,,Парламент депутаты
Dialogue: 0,0:02:57.04,0:02:59.75,Default,,0,0,0,,(Ретсуко) Эй...?
Dialogue: 0,0:03:12.88,0:03:15.04,Default,,0,0,0,,Мен үйге баруым керек деп ойлаймын.
Dialogue: 0,0:03:15.13,0:03:16.17,Default,,0,0,0,,Қазір тым кеш
Dialogue: 0,0:03:17.09,0:03:19.29,Default,,0,0,0,,‎(Қатты дыбыс) ‎(Хайда/Ретсуко) Иә!
Dialogue: 0,0:03:20.21,0:03:22.34,Default,,0,0,0,,‎(Қатты дыбыс) ‎(Хайда/Ретсуко) Ммм...
Dialogue: 0,0:03:25.46,0:03:26.50,Default,,0,0,0,,Қандай дыбыс?
Dialogue: 0,0:03:41.71,0:03:42.54,Default,,0,0,0,,‎(Хайда) Иә!
Dialogue: 0,0:03:46.92,0:03:48.46,Default,,0,0,0,,А...
Dialogue: 0,0:03:51.38,0:03:52.79,Default,,0,0,0,,‎(Хайда әкесі) Ммм...
Dialogue: 0,0:04:14.29,0:04:16.46,Default,,0,0,0,,‎(Ретсуконың анасы) ‎Ретсуко, есіңе түсір.
Dialogue: 0,0:04:17.13,0:04:19.34,Default,,0,0,0,,Басқа адамның үйіне барғанда.
Dialogue: 0,0:04:20.54,0:04:24.09,Default,,0,0,0,,Олар не десе де, аузыңның ұшын көтерсең, бәрі жақсы болады.
Dialogue: 0,0:04:24.96,0:04:25.79,Default,,0,0,0,,Иә
Dialogue: 0,0:04:27.17,0:04:28.29,Default,,0,0,0,,‎Hehe…
Dialogue: 0,0:04:35.63,0:04:38.29,Default,,0,0,0,,‎Танысқаныма қуаныштымын. Менің атым Рецуко.
Dialogue: 0,0:04:39.13,0:04:40.38,Default,,0,0,0,,Менің Хайда-кунмен байланысым бар.
Dialogue: 0,0:04:40.46,0:04:42.34,Default,,0,0,0,,‎Ынтымақтастығыңызға рахмет.
Dialogue: 0,0:04:42.84,0:04:44.34,Default,,0,0,0,,Осы мүмкіндік үшін рахмет.
Dialogue: 0,0:04:44.42,0:04:48.59,Default,,0,0,0,,Сәлем беруге келген бойда...
Dialogue: 0,0:04:50.25,0:04:51.25,Default,,0,0,0,,‎Ха…
Dialogue: 0,0:04:51.75,0:04:55.21,Default,,0,0,0,,‎(Хайда ана) А-а-а... Танысқаныма қуаныштымын.
Dialogue: 0,0:04:55.29,0:04:57.54,Default,,0,0,0,,Мені үлкен ұлым бағып отыр.
Dialogue: 0,0:04:57.63,0:04:58.50,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:04:58.59,0:05:01.59,Default,,0,0,0,,Ол өте сүйкімді және ол өте тәрбиелі емес.
Dialogue: 0,0:05:01.67,0:05:03.46,Default,,0,0,0,,Сіз қай жерде кездестіңіз?
Dialogue: 0,0:05:03.54,0:05:04.42,Default,,0,0,0,,‎Компания?
Dialogue: 0,0:05:04.50,0:05:05.92,Default,,0,0,0,,Немесе...
Dialogue: 0,0:05:06.00,0:05:07.42,Default,,0,0,0,,‎
Dialogue: 0,0:05:09.79,0:05:13.00,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:05:16.84,0:05:17.92,Default,,0,0,0,,Ух...
Dialogue: 0,0:05:31.75,0:05:33.71,Default,,0,0,0,,Рецуко-сан, кешіріңіз.
Dialogue: 0,0:05:36.42,0:05:38.63,Default,,0,0,0,,‎Қазір орныңызды қалдыра аласыз ба?
Dialogue: 0,0:05:39.79,0:05:40.63,Default,,0,0,0,,‎Мм…
Dialogue: 0,0:05:50.88,0:05:52.21,Default,,0,0,0,,Осы жерде күтіңіз
Dialogue: 0,0:05:52.29,0:05:53.71,Default,,0,0,0,,А... иә
Dialogue: 0,0:05:54.96,0:05:55.79,Default,,0,0,0,,А...
Dialogue: 0,0:05:56.92,0:05:58.92,Default,,0,0,0,,‎Не, міне...
Dialogue: 0,0:06:01.13,0:06:02.21,Default,,0,0,0,,Менің ағамның бөлмесі
Dialogue: 0,0:06:14.13,0:06:16.50,Default,,0,0,0,,Парламент жақында таратылады
Dialogue: 0,0:06:17.50,0:06:19.13,Default,,0,0,0,,‎Бұл жақында сайлау келе жатқанын білдіреді.
Dialogue: 0,0:06:20.29,0:06:21.25,Default,,0,0,0,,Иә
Dialogue: 0,0:06:21.84,0:06:23.96,Default,,0,0,0,,‎Бұл саясаткерлер үшін маңызды сәт
Dialogue: 0,0:06:24.71,0:06:27.63,Default,,0,0,0,,‎Осындай уақытта сен кезіп жүрген сияқтысың.
Dialogue: 0,0:06:27.71,0:06:28.92,Default,,0,0,0,,Мен өзімді нашар сезінемін.
Dialogue: 0,0:06:29.00,0:06:31.88,Default,,0,0,0,,Жоқ, мен қыдырып жүргендей емеспін...
Dialogue: 0,0:06:32.75,0:06:35.67,Default,,0,0,0,,Хайда отбасының үлкен ұлы жұмыссыз, үйі жоқ.
Dialogue: 0,0:06:35.75,0:06:37.96,Default,,0,0,0,,‎Егер апта сайынғы өсек журналы білсе не болады?
Dialogue: 0,0:06:38.92,0:06:42.25,Default,,0,0,0,,‎Олар көңіл көтеру үшін алыпсатарлық мақалалар жазады.
Dialogue: 0,0:06:43.21,0:06:45.84,Default,,0,0,0,,‎Егер сіз дұрыс емес жерге соқсаңыз, бұл өлімге әкеледі.
Dialogue: 0,0:06:46.38,0:06:49.21,Default,,0,0,0,,Джируға қиындық туғызба
Dialogue: 0,0:06:50.34,0:06:51.21,Default,,0,0,0,,‎Мм…
Dialogue: 0,0:06:52.09,0:06:54.04,Default,,0,0,0,,Иә? Джируға ма?
Dialogue: 0,0:06:55.75,0:06:57.04,Default,,0,0,0,,Әке емес пе?
Dialogue: 0,0:07:02.79,0:07:08.17,Default,,0,0,0,,(Хайда әке) Менің қазіргі денеммен сайлау науқанымен күресу мүмкін емес.
Dialogue: 0,0:07:09.25,0:07:14.54,Default,,0,0,0,,Мен емделуге көңіл бөлемін, Джироның жерді басып алуына рұқсат етемін.
Dialogue: 0,0:07:17.34,0:07:19.63,Default,,0,0,0,,Біраз уақыт ештеңе істемеңіз.
Dialogue: 0,0:07:20.34,0:07:22.50,Default,,0,0,0,,‎Ешқандай қателік жасамаңыз
Dialogue: 0,0:07:22.59,0:07:24.59,Default,,0,0,0,,‎Шулама, ерекшеленбе
Dialogue: 0,0:07:24.67,0:07:27.34,Default,,0,0,0,,Деміңді ұста, Тыныш.
Dialogue: 0,0:07:28.88,0:07:30.17,Default,,0,0,0,,Оның орнына
Dialogue: 0,0:07:31.63,0:07:33.34,Default,,0,0,0,,Мен сізге көмектесемін.
Dialogue: 0,0:07:40.46,0:07:41.46,Default,,0,0,0,,Рецуко
Dialogue: 0,0:07:44.25,0:07:46.84,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз. Әңгіме аяқталды.
Dialogue: 0,0:07:49.46,0:07:50.29,Default,,0,0,0,,‎Рецуко?
Dialogue: 0,0:07:51.54,0:07:53.63,Default,,0,0,0,,Не болды? Сенімен бәрі жақсы ма?
Dialogue: 0,0:07:57.88,0:07:58.75,Default,,0,0,0,,‎Бұл кім?
Dialogue: 0,0:07:58.84,0:07:59.88,Default,,0,0,0,,‎(Хайда) Уау!
Dialogue: 0,0:07:59.96,0:08:02.71,Default,,0,0,0,,Мм... Бұл мектеп қабырғасында жүрген кездегі ескі сурет.
Dialogue: 0,0:08:02.79,0:08:04.96,Default,,0,0,0,,Хмм, өзіңізді жақсы сезінбейсіз.
Dialogue: 0,0:08:06.46,0:08:08.09,Default,,0,0,0,,‎Жақсы естеліктер~
Dialogue: 0,0:08:08.17,0:08:10.46,Default,,0,0,0,,(Хайда) Әй, заттарға тиіспе.
Dialogue: 0,0:08:12.04,0:08:14.96,Default,,0,0,0,,Мен саған ақша беремін, үй жалдаймын, тыныш жүруіңді сұраймын.
Dialogue: 0,0:08:15.04,0:08:17.54,Default,,0,0,0,,Lie Kind ‎Маған ақша бересіз бе? Алақай!
Dialogue: 0,0:08:18.21,0:08:20.59,Default,,0,0,0,,Сондықтан олай емес.
Dialogue: 0,0:08:21.79,0:08:24.38,Default,,0,0,0,,Әкемнің ойындағы жалғыз нәрсе – сайлау.
Dialogue: 0,0:08:25.29,0:08:26.92,Default,,0,0,0,,Сайлау дегеніміз қандай сайлау?
Dialogue: 0,0:08:27.71,0:08:29.09,Default,,0,0,0,,Өкілдер палатасының жалпы сайлауы
Dialogue: 0,0:08:29.59,0:08:31.21,Default,,0,0,0,,‎(гитара дыбысы)
Dialogue: 0,0:08:31.29,0:08:33.75,Default,,0,0,0,,Жақында жарияланған шығар
Dialogue: 0,0:08:39.29,0:08:41.00,Default,,0,0,0,,‎Мен баяғыда топта болған кезім
Dialogue: 0,0:08:41.09,0:08:43.42,Default,,0,0,0,,Ақымақ вокалист. Әлеуметке қарсы лирика.
Dialogue: 0,0:08:43.50,0:08:45.29,Default,,0,0,0,,‎Мен үнемі ән айтатын кезім болды.
Dialogue: 0,0:08:45.38,0:08:47.59,Default,,0,0,0,,... антисоциалды ма?
Dialogue: 0,0:08:47.67,0:08:48.79,Default,,0,0,0,,Бұл жай әзіл.
Dialogue: 0,0:08:49.71,0:08:51.59,Default,,0,0,0,,Бұл пародия болуы керек еді.
Dialogue: 0,0:08:52.29,0:08:55.25,Default,,0,0,0,,Содан кейін, сайлаудың дәл алдында.
Dialogue: 0,0:08:55.34,0:08:58.29,Default,,0,0,0,,«Реп. Хайданың үлкен ұлының тобының сөздері өте нашар»
Dialogue: 0,0:08:58.79,0:09:02.29,Default,,0,0,0,,Осыған ұқсас бірдеңенің кесірінен желідегі мақала қатты таралды.
Dialogue: 0,0:09:02.79,0:09:04.21,Default,,0,0,0,,‎Сен не ән айттың?
Dialogue: 0,0:09:04.29,0:09:05.54,Default,,0,0,0,,Мен бұлай айта алмаймын.
Dialogue: 0,0:09:06.42,0:09:09.71,Default,,0,0,0,,Мен мұны маңызды емес деп ойлап, жалғыз қалдырдым.
Dialogue: 0,0:09:09.79,0:09:11.84,Default,,0,0,0,,Апталық журналдар мақалаларға сүйенеді.
Dialogue: 0,0:09:13.17,0:09:16.34,Default,,0,0,0,,‎Осындай нәрсе болғандықтан, әкем сабақ алған болуы керек.
Dialogue: 0,0:09:17.67,0:09:19.67,Default,,0,0,0,,Сіз маған сенбейсіз.
Dialogue: 0,0:09:21.79,0:09:22.79,Default,,0,0,0,,‎Хайда-кун
Dialogue: 0,0:09:28.21,0:09:30.46,Default,,0,0,0,,Кешіріңіз, мен сіздің әкеңіздің сезімін толық түсінемін.
Dialogue: 0,0:09:30.54,0:09:32.00,Default,,0,0,0,,Сіз маған сене алмайсыз.
Dialogue: 0,0:09:35.29,0:09:37.96,Default,,0,0,0,,(Хаиданың анасы) Әй, екеуің қайда болдыңдар?
Dialogue: 0,0:09:38.04,0:09:39.96,Default,,0,0,0,,Мен сені бөлмеде деп ойладым, бірақ сен жоқсың.
Dialogue: 0,0:09:40.04,0:09:42.67,Default,,0,0,0,,‎Ой, мен сонда кезіп жүр едім.
Dialogue: 0,0:09:42.75,0:09:45.54,Default,,0,0,0,,Кешіріңіз. Мен саған бақшаны көрсеттім.
Dialogue: 0,0:09:45.63,0:09:47.13,Default,,0,0,0,,‎(Хаиданың анасы) Дұрыс.
Dialogue: 0,0:09:48.92,0:09:49.79,Default,,0,0,0,,Мм...
Dialogue: 0,0:09:50.88,0:09:53.42,Default,,0,0,0,,‎Мен сізге бұрын көріксіз бөлігін көрсеттім...
Dialogue: 0,0:09:53.50,0:09:56.04,Default,,0,0,0,,‎Жоқ, бұл дұрыс емес.
Dialogue: 0,0:09:56.13,0:09:59.46,Default,,0,0,0,,Жол бойы келгеніңіз үшін кешіріңіз.
Dialogue: 0,0:09:59.54,0:10:01.29,Default,,0,0,0,,Жоқ, жоқ, бұл шектен шыққан.
Dialogue: 0,0:10:03.34,0:10:06.13,Default,,0,0,0,,‎Осыдан кейін не істейсіз? Сіз түнге дейін тұра аласыз ба?
Dialogue: 0,0:10:06.21,0:10:09.00,Default,,0,0,0,,‎Аа... Не істеу керек екен?
Dialogue: 0,0:10:10.29,0:10:12.67,Default,,0,0,0,,‎(Хаиданың анасы) Мен тамақ дайындаймын. Қаласаңыз жей аласыз.
Dialogue: 0,0:10:12.75,0:10:16.75,Default,,0,0,0,,‎Отбасы болып жиналғаннан бері, көңіл көтерейік, солай ма?
Dialogue: 0,0:10:18.38,0:10:19.21,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:41.34,0:10:42.50,Default,,0,0,0,,(Ретсуко) Бұл қиын...
Dialogue: 0,0:10:43.38,0:10:45.13,Default,,0,0,0,,‎Уфуфу Рецуко-сан
Dialogue: 0,0:10:45.21,0:10:48.59,Default,,0,0,0,,Менің отбасымдағылардың бәрі мұнда сушиді жақсы көреді.
Dialogue: 0,0:10:48.67,0:10:50.29,Default,,0,0,0,,(Ретсуко) Мүмкін қазір кешкі ас ішерміз.
Dialogue: 0,0:10:50.38,0:10:51.29,Default,,0,0,0,,Бұл болып жатыр ма?
Dialogue: 0,0:10:53.38,0:10:55.88,Default,,0,0,0,,‎Ретсуко... аузыңның бұрыштарын көтер.
Dialogue: 0,0:10:57.21,0:10:58.46,Default,,0,0,0,,‎Hehe…
Dialogue: 0,0:11:00.96,0:11:02.67,Default,,0,0,0,,‎Жапсырма жоғары қараған
Dialogue: 0,0:11:03.67,0:11:04.54,Default,,0,0,0,,‎Hehe…
Dialogue: 0,0:11:08.04,0:11:12.17,Default,,0,0,0,,(Рецуко) Әке, сыра алғыңыз келе ме?
Dialogue: 0,0:11:12.25,0:11:14.79,Default,,0,0,0,,‎Алкогольді дәрігер тоқтатты.
Dialogue: 0,0:11:14.88,0:11:16.75,Default,,0,0,0,,‎(Ретсуко) ‎Баланың басынан қателігі
Dialogue: 0,0:11:17.25,0:11:20.29,Default,,0,0,0,,‎(Ретсуко Ана/Тон) ‎Ақырын қозғалмаңыз, одан өту маңызды.
Dialogue: 0,0:11:20.38,0:11:21.67,Default,,0,0,0,,(Ретсуко) Мен мұны істеймін.
Dialogue: 0,0:11:26.96,0:11:27.79,Default,,0,0,0,,Мм...
Dialogue: 0,0:11:28.67,0:11:30.79,Default,,0,0,0,,Мен бұрын көмек туралы айтқан болатынмын.
Dialogue: 0,0:11:32.17,0:11:35.29,Default,,0,0,0,,Мен сіздің өтінішіңізді қабылдамауым керек деп ойлаймын.
Dialogue: 0,0:11:36.42,0:11:39.13,Default,,0,0,0,,‎Мен де жұмыс істеймін, бірақ толық емес жұмыс күнім бар.
Dialogue: 0,0:11:40.00,0:11:42.54,Default,,0,0,0,,Дәл қазір, Рецукомен, мен қандай да бір жолмен басқарып жатырмын.
Dialogue: 0,0:11:43.25,0:11:46.54,Default,,0,0,0,,‎Сен есейген сайын ата-анаңның қамқорлығында боласың.
Dialogue: 0,0:11:47.38,0:11:49.42,Default,,0,0,0,,Мен шынымен кешірім сұраймын.
Dialogue: 0,0:11:49.50,0:11:50.92,Default,,0,0,0,,Уайымдаудың қажеті жоқ
Dialogue: 0,0:11:51.00,0:11:54.17,Default,,0,0,0,,Мен үшін сенен ештеңе күтпеймін.
Dialogue: 0,0:11:55.92,0:11:59.38,Default,,0,0,0,,Жоқ... А, солай шығар.
Dialogue: 0,0:11:59.88,0:12:02.17,Default,,0,0,0,,‎Бұл жолы мен көп нәрсе туралы ойладым.
Dialogue: 0,0:12:02.67,0:12:05.29,Default,,0,0,0,,Үйден қуып шықты. Күндер бойы тор кафеде ұйықтады
Dialogue: 0,0:12:06.09,0:12:08.71,Default,,0,0,0,,Мен осы уақытқа дейін бұзылдым...
Dialogue: 0,0:12:10.21,0:12:11.50,Default,,0,0,0,,‎Necafe?
Dialogue: 0,0:12:12.96,0:12:13.96,Default,,0,0,0,,‎Интернет-кафе
Dialogue: 0,0:12:14.71,0:12:18.09,Default,,0,0,0,,Бұл тұтынушыларға интернет ортасы мен жеке бөлмелерді жалға беретін бизнес.
Dialogue: 0,0:12:18.17,0:12:20.50,Default,,0,0,0,,‎Бұл бастапқыда тұру орны болмаса да.
Dialogue: 0,0:12:20.59,0:12:22.96,Default,,0,0,0,,Кейбір адамдар оны арзан тұру ретінде пайдаланады.
Dialogue: 0,0:12:23.04,0:12:25.84,Default,,0,0,0,,Атап айтқанда, интернет-кафеде ұйықтау арқылы.
Dialogue: 0,0:12:25.92,0:12:27.54,Default,,0,0,0,,Тірі қалған тұрақты емес жұмысшылар
Dialogue: 0,0:12:27.63,0:12:30.04,Default,,0,0,0,,«Интернет-кафе босқындары» деп аталады
Dialogue: 0,0:12:30.88,0:12:33.84,Default,,0,0,0,,«Босқын» ма? Мен түсінемін.
Dialogue: 0,0:12:36.71,0:12:39.09,Default,,0,0,0,,Сол интернет-кафеде сіздің жеке басыңыз
Dialogue: 0,0:12:39.17,0:12:41.67,Default,,0,0,0,,Сіз оны ешкімге айтқан жоқсыз, солай ма?
Dialogue: 0,0:12:41.75,0:12:45.46,Default,,0,0,0,,‎Осындай жерге қарақшылар жиналмайды.
Dialogue: 0,0:12:45.54,0:12:48.42,Default,,0,0,0,,‎Ақшаға тапшылық көргенде, олар бәрін жасайды.
Dialogue: 0,0:12:48.50,0:12:51.54,Default,,0,0,0,,‎Тіпті апта сайынғы журналда да, егер ол ағып кетсе...
Dialogue: 0,0:12:51.63,0:12:52.71,Default,,0,0,0,,‎(Хайда) Әкесі
Dialogue: 0,0:12:55.04,0:12:56.13,Default,,0,0,0,,Бұл емес.
Dialogue: 0,0:12:57.00,0:12:59.42,Default,,0,0,0,,Мен әкем туралы ешкімге айтқан емеспін.
Dialogue: 0,0:13:00.88,0:13:03.04,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:13:03.13,0:13:04.29,Default,,0,0,0,,‎(Хайда) Және...
Dialogue: 0,0:13:04.92,0:13:07.29,Default,,0,0,0,,«Олар ақымақ емес» Алдын ала пікір
Dialogue: 0,0:13:08.21,0:13:11.84,Default,,0,0,0,,үшін жақсы болды, маған да қамқор болды.
Dialogue: 0,0:13:11.92,0:13:13.13,Default,,0,0,0,,‎Онда тұратын жігіт
Dialogue: 0,0:13:13.21,0:13:15.92,Default,,0,0,0,,‎Ол жерге жету үшін барлығы аянбай еңбек етті.
Dialogue: 0,0:13:16.71,0:13:20.13,Default,,0,0,0,,Мүмкін әр адамның өз болмай қоймайтын жағдайлары болуы мүмкін...
Dialogue: 0,0:13:20.21,0:13:22.92,Default,,0,0,0,,‎Мұндай нәрселерге қауіп төніп тұр.
Dialogue: 0,0:13:23.00,0:13:25.63,Default,,0,0,0,,Оқуына немқұрайлы қарағандардың бәрі осылай дейді.
Dialogue: 0,0:13:26.50,0:13:28.63,Default,,0,0,0,,‎Жоқ, олай емес.
Dialogue: 0,0:13:29.21,0:13:30.84,Default,,0,0,0,,‎Күш-жігер жұмсағандар - сол
Dialogue: 0,0:13:30.92,0:13:34.04,Default,,0,0,0,,Мен мұндай ақымақ жағдайға ешқашан түспес едім.
Dialogue: 0,0:13:34.71,0:13:37.21,Default,,0,0,0,,Жоқ, ондай емес адамдар бар.
Dialogue: 0,0:13:37.96,0:13:39.13,Default,,0,0,0,,Бұзбаңыз
Dialogue: 0,0:13:39.79,0:13:44.29,Default,,0,0,0,,Бұл барлығына тең мүмкіндіктерге ие ел.
Dialogue: 0,0:13:45.71,0:13:49.13,Default,,0,0,0,,‎Ха... Кездейсоқ ақшаға бата алатын адамдар
Dialogue: 0,0:13:49.21,0:13:50.96,Default,,0,0,0,,үшін осылай дейді.
Dialogue: 0,0:13:51.54,0:13:53.00,Default,,0,0,0,,(Ретсуко) ‎Хайда-кун
Dialogue: 0,0:13:54.17,0:13:56.38,Default,,0,0,0,,‎Ал... Эй!
Dialogue: 0,0:13:56.46,0:13:59.25,Default,,0,0,0,,Бұл әр адамның ойлау тәсілі әртүрлі екенін білдіреді.
Dialogue: 0,0:13:59.75,0:14:00.71,Default,,0,0,0,,Сәлем
Dialogue: 0,0:14:06.67,0:14:09.29,Default,,0,0,0,,(Хаиданың анасы) Әке, ол көп ішпейді...
Dialogue: 0,0:14:10.00,0:14:11.17,Default,,0,0,0,,№
Dialogue: 0,0:14:12.50,0:14:13.84,Default,,0,0,0,,Ух...
Dialogue: 0,0:14:14.63,0:14:17.21,Default,,0,0,0,,‎Әйел қолдайтындай көрінетін жігіт
Dialogue: 0,0:14:19.25,0:14:22.46,Default,,0,0,0,,Алдымен үлкен нәрселерді қалдырмаңыз.
Dialogue: 0,0:14:22.54,0:14:23.79,Default,,0,0,0,,Әке
Dialogue: 0,0:14:23.88,0:14:24.84,Default,,0,0,0,,Шулы!
Dialogue: 0,0:14:24.92,0:14:28.67,Default,,0,0,0,,Сен мені еркелеттің деп, Мен сондай аянышты адам болып өстім.
Dialogue: 0,0:14:31.25,0:14:33.50,Default,,0,0,0,,‎Бұл не әйел?
Dialogue: 0,0:14:34.96,0:14:37.00,Default,,0,0,0,,Сіз мұнда не үшін келдіңіз?
Dialogue: 0,0:14:37.50,0:14:39.46,Default,,0,0,0,,Бұл өте жағымсыз!
Dialogue: 0,0:14:39.54,0:14:41.21,Default,,0,0,0,,Мақсаты не?
Dialogue: 0,0:14:41.79,0:14:43.46,Default,,0,0,0,,Сіз ақшаның артынан жүрсіз бе?
Dialogue: 0,0:14:44.00,0:14:44.96,Default,,0,0,0,,Сәлем
Dialogue: 0,0:14:46.00,0:14:47.50,Default,,0,0,0,,Ақымақ болма.
Dialogue: 0,0:14:48.25,0:14:50.13,Default,,0,0,0,,‎(Хайда әке) Сіздер сияқты.
Dialogue: 0,0:14:50.75,0:14:54.42,Default,,0,0,0,,‎Бұл бүлінген, құнсыз адамдар бұл елді жеп жатыр.
Dialogue: 0,0:14:55.25,0:14:59.59,Default,,0,0,0,,Жеңілісті жеңу Біз оны қан мен термен құрдық
Dialogue: 0,0:14:59.67,0:15:01.34,Default,,0,0,0,,‎Бұл керемет ел!
Dialogue: 0,0:15:03.29,0:15:04.13,Default,,0,0,0,,‎Га
Dialogue: 0,0:15:04.63,0:15:08.38,Default,,0,0,0,,‎Мен жай ғана жеңіл режимде семірдім.
Dialogue: 0,0:15:09.38,0:15:12.25,Default,,0,0,0,,Егер сіз маймылға еліктеп, заттарды арзанға сатсаңыз, сіз ақша табатын едіңіз, солай ма?
Dialogue: 0,0:15:13.46,0:15:16.04,Default,,0,0,0,,Енді біз құнын төлеуге мәжбүр боламыз.
Dialogue: 0,0:15:17.67,0:15:21.59,Default,,0,0,0,,‎Сендер басқа аренада күресіп жатырсыңдар.
Dialogue: 0,0:15:21.67,0:15:23.54,Default,,0,0,0,,‎Ug…
Dialogue: 0,0:15:28.13,0:15:29.42,Default,,0,0,0,,‎(Ретсуко) Бұл ең нашар
Dialogue: 0,0:15:29.50,0:15:31.38,Default,,0,0,0,,Неліктен бұлай болады?
Dialogue: 0,0:15:32.54,0:15:33.38,Default,,0,0,0,,‎(Хайда) Кешіріңіз.
Dialogue: 0,0:15:34.67,0:15:36.34,Default,,0,0,0,,Анам жылап тұрды.
Dialogue: 0,0:15:36.84,0:15:38.79,Default,,0,0,0,,‎"Соңында бұл қызық болады" дедіңіз, бірақ...
Dialogue: 0,0:15:41.17,0:15:44.42,Default,,0,0,0,,‎(Хайда) Бірдеңе мен енді мұны істей алмаймын.
Dialogue: 0,0:15:45.96,0:15:47.54,Default,,0,0,0,,Олар негізінен бір-біріне сәйкес келмейді.
Dialogue: 0,0:15:48.34,0:15:50.46,Default,,0,0,0,,Екеумізге байланысты үзу керек.
Dialogue: 0,0:15:51.04,0:15:52.38,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:15:53.50,0:15:55.21,Default,,0,0,0,,(Хайда) Рецуко ересек адам.
Dialogue: 0,0:15:56.75,0:16:00.54,Default,,0,0,0,,Әкем мені ренжіткен кезде, мен Рецуко жынданып кетеді деп ойладым.
Dialogue: 0,0:16:01.04,0:16:01.88,Default,,0,0,0,,‎Мм…
Dialogue: 0,0:16:03.21,0:16:06.29,Default,,0,0,0,,Мен енді мұндай қызықсыз нәрселерге ашуланғым келмейді.
Dialogue: 0,0:16:06.96,0:16:10.59,Default,,0,0,0,,Айқайла, жұт, Жеңімпаз сезіну.
Dialogue: 0,0:16:11.71,0:16:14.96,Default,,0,0,0,,‎Бұл мәселені кейінге қалдыру сияқты.
Dialogue: 0,0:16:16.13,0:16:17.79,Default,,0,0,0,,Мен енді мұны істегім келмейді
Dialogue: 0,0:16:32.00,0:16:33.00,Default,,0,0,0,,‎(терезені қағу дыбысы)
Dialogue: 0,0:16:33.09,0:16:34.50,Default,,0,0,0,,‎(Хайда) Хмм... ‎(Ретсуко) Хм?
Dialogue: 0,0:16:38.21,0:16:39.04,Default,,0,0,0,,Джиро
Dialogue: 0,0:16:42.46,0:16:43.42,Default,,0,0,0,,Бұл менің әкемнен.
Dialogue: 0,0:16:46.29,0:16:47.13,Default,,0,0,0,,‎Алтын?
Dialogue: 0,0:16:47.67,0:16:48.50,Default,,0,0,0,,О
Dialogue: 0,0:16:49.38,0:16:51.17,Default,,0,0,0,,‎Сонымен сіз одан бас тарттыңыз, солай ма?
Dialogue: 0,0:16:51.71,0:16:53.34,Default,,0,0,0,,Егер сіз оны қабылдамасаңыз, мен қиындыққа тап боламын.
Dialogue: 0,0:16:53.42,0:16:55.09,Default,,0,0,0,,‎Сен оны қабылдай алмайсың.
Dialogue: 0,0:16:55.96,0:16:57.13,Default,,0,0,0,,Оны үйге апарыңыз.
Dialogue: 0,0:17:00.34,0:17:02.29,Default,,0,0,0,,Әкеңізбен қарым-қатынасыңызды үзуді жоспарлап отырсыз ба?
Dialogue: 0,0:17:04.71,0:17:06.29,Default,,0,0,0,,‎17 жыл бірге тұрдық.
Dialogue: 0,0:17:06.88,0:17:08.88,Default,,0,0,0,,Мен сенің не ойлап тұрғаныңды елестете аламын.
Dialogue: 0,0:17:10.42,0:17:11.84,Default,,0,0,0,,‎Егер сіз айтып отырғаныңыз осы болса
Dialogue: 0,0:17:11.92,0:17:13.84,Default,,0,0,0,,‎Егер сіз оны кесілген ақша деп ойласаңыз, жақсы.
Dialogue: 0,0:17:14.34,0:17:15.71,Default,,0,0,0,,‎Қабыл алсаңыз жақсы болар еді.
Dialogue: 0,0:17:15.79,0:17:17.84,Default,,0,0,0,,‎Біз де сайлауды жан тыныштығымен қарсы аламыз.
Dialogue: 0,0:17:19.71,0:17:21.17,Default,,0,0,0,,‎Өзара пайда үшін
Dialogue: 0,0:17:23.04,0:17:25.17,Default,,0,0,0,,Ақырында, ата-анаңызға мейірімді болыңыз.
Dialogue: 0,0:17:26.50,0:17:27.34,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:17:30.54,0:17:31.46,Default,,0,0,0,,Түсінді
Dialogue: 0,0:17:36.84,0:17:37.79,Default,,0,0,0,,Сосын...
Dialogue: 0,0:17:38.29,0:17:39.13,Default,,0,0,0,,Фу
Dialogue: 0,0:17:40.04,0:17:42.46,Default,,0,0,0,,‎Аспаз…
Dialogue: 0,0:17:43.75,0:17:48.25,Default,,0,0,0,,‎Хахаха... хахаха…
Dialogue: 0,0:17:50.79,0:17:52.09,Default,,0,0,0,,Сіз оны алдыңыз ба?
Dialogue: 0,0:17:52.79,0:17:53.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:55.04,0:17:56.92,Default,,0,0,0,,Жүргізуші, мені шығаруыңызды өтінемін.
