Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.50,0:00:17.79,Default,,0,0,0,,‎（‎‎）～
Dialogue: 0,0:00:17.88,0:00:22.46,Default,,0,0,0,,‎Ах~
Dialogue: 0,0:00:22.54,0:00:25.21,Default,,0,0,0,,(Ретсуко) Қашанға дейін осылай күйзеліп жүре бересің?
Dialogue: 0,0:00:25.96,0:00:27.79,Default,,0,0,0,,‎Егер сіз кем дегенде банан жесеңіз ше?
Dialogue: 0,0:00:30.09,0:00:32.92,Default,,0,0,0,,‎Джиру мырзаның айтқаны үшін уайымдаудың қажеті жоқ.
Dialogue: 0,0:00:33.00,0:00:33.88,Default,,0,0,0,,Е...
Dialogue: 0,0:00:35.00,0:00:37.79,Default,,0,0,0,,‎Жоқ... ол дұрыс.
Dialogue: 0,0:00:39.38,0:00:42.17,Default,,0,0,0,,Сол кезде жүрегімнің бір жерінде осыны ойлайтынмын.
Dialogue: 0,0:00:43.25,0:00:46.75,Default,,0,0,0,,«Ой, бұл ақша өмірді біршама жеңілдетеді».
Dialogue: 0,0:00:46.84,0:00:49.38,Default,,0,0,0,,‎«Мен оқуға көңіл бөле аламын»
Dialogue: 0,0:00:52.63,0:00:56.63,Default,,0,0,0,,‎Нуа~! ‎Дасе~ Дасе~
Dialogue: 0,0:00:56.71,0:01:00.25,Default,,0,0,0,,‎Сондай ақсақ~ Мен ер адамдай ақсақпын!
Dialogue: 0,0:01:00.34,0:01:03.21,Default,,0,0,0,,‎nggngggng…
Dialogue: 0,0:01:03.29,0:01:04.96,Default,,0,0,0,,Мен оның ақсақ екенін білемін
Dialogue: 0,0:01:05.63,0:01:08.17,Default,,0,0,0,,Әзірше әкеңнің ақшасын сол күйінде қалдыр.
Dialogue: 0,0:01:08.25,0:01:10.21,Default,,0,0,0,,Бір күні оны дұрыстап қайтарайық
Dialogue: 0,0:01:11.04,0:01:12.25,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:01:12.34,0:01:13.17,Default,,0,0,0,,Иә
Dialogue: 0,0:01:13.96,0:01:15.63,Default,,0,0,0,,‎Жарайды, мен жұмысқа барайын.
Dialogue: 0,0:01:17.54,0:01:18.96,Default,,0,0,0,,Тамағыңызды дұрыс жеңіз.
Dialogue: 0,0:01:19.04,0:01:19.88,Default,,0,0,0,,‎(Хайда) Иә.
Dialogue: 0,0:01:19.96,0:01:22.21,Default,,0,0,0,,‎(Ретсуко) ‎Кір жуу және шоппинг, өтінемін.
Dialogue: 0,0:01:22.29,0:01:23.13,Default,,0,0,0,,Иә
Dialogue: 0,0:01:23.21,0:01:24.96,Default,,0,0,0,,‎(Ретсуко) Мен барамын.
Dialogue: 0,0:01:25.04,0:01:27.21,Default,,0,0,0,,‎(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:01:29.71,0:01:31.21,Default,,0,0,0,,‎(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:01:31.29,0:01:32.21,Default,,0,0,0,,‎(Ретсуко) Мен үйдемін.
Dialogue: 0,0:01:35.96,0:01:38.50,Default,,0,0,0,,‎Одан бері ештеңе істемеген шығарсың?
Dialogue: 0,0:01:39.00,0:01:39.84,Default,,0,0,0,,Иә
Dialogue: 0,0:01:40.34,0:01:42.79,Default,,0,0,0,,♪～ ‎Куккуккуккук…
Dialogue: 0,0:01:42.79,0:01:43.92,Default,,0,0,0,,♪～
Dialogue: 0,0:01:43.92,0:01:45.67,Default,,0,0,0,,♪～ ‎Сондықтан бұл өте жаман ‎Теми
Dialogue: 0,0:01:45.67,0:01:47.92,Default,,0,0,0,,‎Сондықтан сіз мұны істей алмайсыз. Теми бұл
Dialogue: 0,0:02:22.46,0:02:27.46,Default,,0,0,0,,～♪
Dialogue: 0,0:02:33.67,0:02:34.88,Default,,0,0,0,,О, қандай қиыншылық
Dialogue: 0,0:02:35.96,0:02:39.09,Default,,0,0,0,,Егер мен жалғыз болсам, бенто дүкенін оңай жейтін едім.
Dialogue: 0,0:02:54.71,0:02:55.54,Default,,0,0,0,,‎Мм…
Dialogue: 0,0:03:16.84,0:03:18.00,Default,,0,0,0,,‎(Ұялы телефон рингтоны)
Dialogue: 0,0:03:18.09,0:03:18.92,Default,,0,0,0,,‎Мм…
Dialogue: 0,0:03:19.92,0:03:21.21,Default,,0,0,0,,‎Мм…
Dialogue: 0,0:03:29.63,0:03:30.59,Default,,0,0,0,,‎Мошимоши
Dialogue: 0,0:03:30.67,0:03:33.29,Default,,0,0,0,,(Ретсуко) Неге тезірек шыға алмайсың?
Dialogue: 0,0:03:34.09,0:03:36.88,Default,,0,0,0,,Жоқ, өйткені аузымда банан бар еді.
Dialogue: 0,0:03:37.84,0:03:40.88,Default,,0,0,0,,Қазір супермаркеттен қайтып келе жатырмын
Dialogue: 0,0:03:42.38,0:03:44.17,Default,,0,0,0,,‎Мүмкін біреу сізді аңдып жүрген шығар
Dialogue: 0,0:03:53.29,0:03:54.75,Default,,0,0,0,,‎Сіз сол бұрышқа бұрылғанда...
Dialogue: 0,0:03:55.67,0:03:56.54,Default,,0,0,0,,‎Жүгір!
Dialogue: 0,0:04:07.04,0:04:09.34,Default,,0,0,0,,‎Хаа һаа…
Dialogue: 0,0:04:09.42,0:04:11.79,Default,,0,0,0,,‎(‎Икари‎) Хаа ха ха...
Dialogue: 0,0:04:12.96,0:04:14.96,Default,,0,0,0,,‎Ахх!
Dialogue: 0,0:04:16.34,0:04:19.29,Default,,0,0,0,,‎Гах...
Dialogue: 0,0:04:21.17,0:04:22.00,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:04:22.09,0:04:23.29,Default,,0,0,0,,А?
Dialogue: 0,0:04:23.38,0:04:25.59,Default,,0,0,0,,‎Күт, күт, күт...
Dialogue: 0,0:04:26.13,0:04:27.34,Default,,0,0,0,,‎(Ретсуко) Иә ‎(Икари) Ку
Dialogue: 0,0:04:27.42,0:04:29.25,Default,,0,0,0,,‎Гах... Фу~ Фу~
Dialogue: 0,0:04:31.25,0:04:32.04,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:32.13,0:04:34.09,Default,,0,0,0,,Олай болса, бір минут күте тұрыңыз!
Dialogue: 0,0:04:34.17,0:04:36.25,Default,,0,0,0,,‎Агрессивті Рецуко
Dialogue: 0,0:04:39.21,0:04:40.17,Default,,0,0,0,,, солай ма?
Dialogue: 0,0:04:42.25,0:04:45.42,Default,,0,0,0,,‎(Ретсуко) Иә. (Икари) Жүр.
Dialogue: 0,0:04:45.50,0:04:47.34,Default,,0,0,0,,‎Барма, балақай!
Dialogue: 0,0:04:47.42,0:04:48.92,Default,,0,0,0,,‎(Ретсуко) Эй~ ‎(Икари) Ах!
Dialogue: 0,0:04:49.00,0:04:52.59,Default,,0,0,0,,‎Жоқ, жоқ, жоқ мен ашуланбаймын, мен ашуланбаймын
Dialogue: 0,0:04:52.67,0:04:55.46,Default,,0,0,0,,‎Жоқ, сәлем беруге кешігіп қалдым.
Dialogue: 0,0:04:55.54,0:04:58.88,Default,,0,0,0,,Негізі мен осындай адаммын...
Dialogue: 0,0:05:00.42,0:05:05.34,Default,,0,0,0,,Сіз не істеп жатырсыз? Сталкер жігіт~!
Dialogue: 0,0:05:07.29,0:05:08.46,Default,,0,0,0,,‎(Тепкен дыбыс)
Dialogue: 0,0:05:12.88,0:05:14.59,Default,,0,0,0,,``Ашу партиясы көшбасшысы''
Dialogue: 0,0:05:14.67,0:05:17.79,Default,,0,0,0,,〝Масуо Икари, Өкілдер палатасының мүшесі〞
Dialogue: 0,0:05:19.46,0:05:20.54,Default,,0,0,0,,(Хайда/Ретсуко) ше?
Dialogue: 0,0:05:22.92,0:05:24.25,Default,,0,0,0,,‎Өкілдер палатасының мүшесі?
Dialogue: 0,0:05:24.34,0:05:27.29,Default,,0,0,0,,Ашық түрде Күдікпен қарамаңыз
Dialogue: 0,0:05:28.34,0:05:30.63,Default,,0,0,0,,Сіз бұл бетті теледидардан көрдіңіз бе?
Dialogue: 0,0:05:30.71,0:05:31.96,Default,,0,0,0,,Мен теледидар көрмеймін
Dialogue: 0,0:05:32.04,0:05:33.25,Default,,0,0,0,,‎Сізді саясат қызықтырады ма?
Dialogue: 0,0:05:33.34,0:05:34.17,Default,,0,0,0,,№
Dialogue: 0,0:05:36.42,0:05:40.04,Default,,0,0,0,,Өкінішке орай, сіз мен туралы ештеңе білмейтін сияқтысыз.
Dialogue: 0,0:05:41.09,0:05:45.25,Default,,0,0,0,,Мен Рецуконы жақсы білемін.
Dialogue: 0,0:05:46.42,0:05:49.50,Default,,0,0,0,,‎♪～ ‎(Ретсуко) Уау!
Dialogue: 0,0:05:49.59,0:05:51.25,Default,,0,0,0,,(Икари) Агрессивті Рецуко
Dialogue: 0,0:05:51.34,0:05:55.04,Default,,0,0,0,,Интернетте ынталы қолдау алыңыз ‎Ашу харизмасы
Dialogue: 0,0:05:55.13,0:05:56.88,Default,,0,0,0,,«Ашу» дегеніміз не?
Dialogue: 0,0:05:56.96,0:06:01.96,Default,,0,0,0,,‎Бұл дүниеге келген жан дүниемен соқтығысқанда шашырайтын ұшқындар.
Dialogue: 0,0:06:05.00,0:06:08.29,Default,,0,0,0,,‎Бұл қараңғылықты жарықтандыратын жарық сәті
Dialogue: 0,0:06:09.42,0:06:12.71,Default,,0,0,0,,‎Халықтың ашуын бір жерге жинап, болашаққа жолды нұрландыр.
Dialogue: 0,0:06:12.79,0:06:16.63,Default,,0,0,0,,‎Бұл Ашу партиясының идеясы!
Dialogue: 0,0:06:23.79,0:06:27.38,Default,,0,0,0,,Біздің партия бір кездері Конгресстің екі палатасында 30 орынға ие болды.
Dialogue: 0,0:06:27.46,0:06:31.84,Default,,0,0,0,,Бақылау бірте-бірте әлсірейді.Қазіргі уақытта бір ғана орын бар
Dialogue: 0,0:06:32.84,0:06:35.21,Default,,0,0,0,,‎Бірақ мен әлі бас тартқан жоқпын.
Dialogue: 0,0:06:35.29,0:06:37.96,Default,,0,0,0,,Қосылған жалынды сөндіру мүмкін емес.
Dialogue: 0,0:06:38.04,0:06:42.84,Default,,0,0,0,,‎Бізге партияны қалпына келтіру үшін сіздің көмегіңіз қажет.
Dialogue: 0,0:06:44.09,0:06:48.63,Default,,0,0,0,,‎Біз сіздің Ашу партиясынан келесі сайлауға қатысуыңызды қалаймыз.
Dialogue: 0,0:06:49.50,0:06:54.88,Default,,0,0,0,,Менімен бірге осы елдің болашағын өзгертейік!
Dialogue: 0,0:06:59.04,0:07:00.42,Default,,0,0,0,,Премьер-министр!
Dialogue: 0,0:07:00.50,0:07:02.34,Default,,0,0,0,,Сәлем, кола премьер-министр
Dialogue: 0,0:07:02.42,0:07:04.59,Default,,0,0,0,,Мен сізден сұраймын, Премьер-министр.
Dialogue: 0,0:07:04.67,0:07:06.13,Default,,0,0,0,,‎(Төраға) Балағат сөздерді қолданбауыңызды өтінемін.
Dialogue: 0,0:07:06.21,0:07:10.04,Default,,0,0,0,,‎Қара сөздер қайда! Сіз сұрақ қойып жатқаныңызға сенімдімін, бірақ бұл жігіт...
Dialogue: 0,0:07:10.71,0:07:12.25,Default,,0,0,0,,‎Ag… Ka…
Dialogue: 0,0:07:13.54,0:07:16.79,Default,,0,0,0,,‎Аа... Тынымсыз болғаныма біраз болды...
Dialogue: 0,0:07:16.88,0:07:18.63,Default,,0,0,0,,‎(мүше) ‎Сіз біраз уақыттан бері ашуланып жүрсіз!
Dialogue: 0,0:07:18.71,0:07:21.00,Default,,0,0,0,,‎Ол шынымен де Диетаның мүшесі болды, солай емес пе?
Dialogue: 0,0:07:21.50,0:07:24.92,Default,,0,0,0,,Таңқаларлық емес, мен мұны бұрын бір жерден көрген бет деп ойладым.
Dialogue: 0,0:07:25.63,0:07:28.17,Default,,0,0,0,,Қараңызшы, ол тіпті интернетте де танымал болып көрінеді.
Dialogue: 0,0:07:28.25,0:07:30.13,Default,,0,0,0,,Бұл толығымен боялған жақтау, бірақ...
Dialogue: 0,0:07:33.25,0:07:34.13,Default,,0,0,0,,‎Ха…
Dialogue: 0,0:07:48.34,0:07:49.71,Default,,0,0,0,,Сіз нені айтып тұрсыз?
Dialogue: 0,0:07:49.79,0:07:52.88,Default,,0,0,0,,‎Біздің партиядан сайлауға түсуіңізді сұраймыз!
Dialogue: 0,0:07:52.96,0:07:54.13,Default,,0,0,0,,Мен бас тартамын.
Dialogue: 0,0:07:57.50,0:07:58.46,Default,,0,0,0,,Рецуко!
Dialogue: 0,0:07:58.96,0:08:00.17,Default,,0,0,0,,‎Қалай болса да
Dialogue: 0,0:08:00.25,0:08:01.79,Default,,0,0,0,,Біздің партиядан
Dialogue: 0,0:08:01.88,0:08:03.75,Default,,0,0,0,,Сайлауға қатыса беріңіз!
Dialogue: 0,0:08:03.84,0:08:05.54,Default,,0,0,0,,‎Нагги~
Dialogue: 0,0:08:05.63,0:08:07.46,Default,,0,0,0,,‎(Ретсуко) Ха ха ха...
Dialogue: 0,0:08:09.17,0:08:11.71,Default,,0,0,0,,Мен компания қызметкері ретінде дауыс бере аламын ба?
Dialogue: 0,0:08:13.00,0:08:14.13,Default,,0,0,0,,Сіз алмайсыз.
Dialogue: 0,0:08:14.63,0:08:16.63,Default,,0,0,0,,‎Егер сіз сәтсіздікке ұшырасаңыз, сіз жұмыссыз қаласыз, солай ма?
Dialogue: 0,0:08:17.25,0:08:18.63,Default,,0,0,0,,Бұл болады.
Dialogue: 0,0:08:19.17,0:08:20.92,Default,,0,0,0,,‎Тәуекелден басқа ештеңе жоқ!
Dialogue: 0,0:08:21.00,0:08:24.13,Default,,0,0,0,,Сіз тәуекелсіз жеміс ала алмайсыз.
Dialogue: 0,0:08:25.71,0:08:28.92,Default,,0,0,0,,Неге менің өмірімді құртпақсың?
Dialogue: 0,0:08:29.00,0:08:31.50,Default,,0,0,0,,Сіздің ондай құқығыңыз бар ма, Икари мырза?
Dialogue: 0,0:08:32.34,0:08:36.46,Default,,0,0,0,,Мен ешқашан сайлауға түспеймін!
Dialogue: 0,0:08:39.50,0:08:41.67,Default,,0,0,0,,‎K…
Dialogue: 0,0:08:42.59,0:08:43.92,Default,,0,0,0,,‎Ахахаха…
Dialogue: 0,0:08:44.54,0:08:48.34,Default,,0,0,0,,Түсіндім~ Ол шынымен аңдыушы емес еді.
Dialogue: 0,0:08:48.42,0:08:49.67,Default,,0,0,0,,Сіз жаман нәрсе жасадыңыз.
Dialogue: 0,0:08:51.46,0:08:52.84,Default,,0,0,0,,Сіз сайлауға түсесіз бе?
Dialogue: 0,0:08:52.92,0:08:54.46,Default,,0,0,0,,Сіз мұны істеуге ешқандай мүмкіндік жоқ.
Dialogue: 0,0:08:54.54,0:08:57.59,Default,,0,0,0,,Сіз тым табанды болғаныңыз үшін мен анық бас тарттым.
Dialogue: 0,0:08:57.67,0:08:59.54,Default,,0,0,0,,‎Бұл туралы қалай ойласаңыз да, бұл мүмкін емес.
Dialogue: 0,0:08:59.63,0:09:01.29,Default,,0,0,0,,Сен тым жассың
Dialogue: 0,0:09:01.79,0:09:02.59,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:03.13,0:09:03.96,Default,,0,0,0,,Е...
Dialogue: 0,0:09:05.38,0:09:07.21,Default,,0,0,0,,‎Сіз 25 жаста болсаңыз, сайлауға түсе алмайсыз.
Dialogue: 0,0:09:09.79,0:09:12.25,Default,,0,0,0,,Не? Сіз оны жүгіруге тырысасыз ба?
Dialogue: 0,0:09:12.34,0:09:14.21,Default,,0,0,0,,Жоқ, өйткені
Dialogue: 0,0:09:15.09,0:09:17.71,Default,,0,0,0,,‎OTM орталығы да көп бас тартты.
Dialogue: 0,0:09:17.79,0:09:18.96,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:09:20.84,0:09:23.79,Default,,0,0,0,,‎Рэцуко сізді қызықтырады, солай емес пе?
Dialogue: 0,0:09:24.54,0:09:25.59,Default,,0,0,0,,Не?
Dialogue: 0,0:09:25.67,0:09:26.79,Default,,0,0,0,,Адамдар
Dialogue: 0,0:09:29.04,0:09:31.17,Default,,0,0,0,,‎"Ақаулық" деп айту қате.
Dialogue: 0,0:09:31.25,0:09:32.13,Default,,0,0,0,,Ауырсыну.
Dialogue: 0,0:09:35.42,0:09:37.25,Default,,0,0,0,,‎(Қызметкерлер) Hi-tachi~
Dialogue: 0,0:09:38.59,0:09:40.50,Default,,0,0,0,,Не? Мен бе?
Dialogue: 0,0:09:41.21,0:09:43.71,Default,,0,0,0,,‎(Клерк) Ахаха... біз.
Dialogue: 0,0:09:43.79,0:09:45.29,Default,,0,0,0,,‎(Клерк) Хайда-кун туралы~
Dialogue: 0,0:09:45.38,0:09:47.79,Default,,0,0,0,,(Сатушы) Мен сізді Хайда-ччи деп атауға шешім қабылдадым.
Dialogue: 0,0:09:47.88,0:09:48.96,Default,,0,0,0,,А...
Dialogue: 0,0:09:49.79,0:09:51.84,Default,,0,0,0,,‎(Сату қызметкері) Жоқ, ‎Хаида өте ұялшақ~
Dialogue: 0,0:09:51.92,0:09:53.54,Default,,0,0,0,,‎(Хаида) Ах~ Иә...
Dialogue: 0,0:09:54.04,0:09:56.79,Default,,0,0,0,,‎Хайдатчи Өткен күні Каки қалай болды?
Dialogue: 0,0:09:56.88,0:09:59.17,Default,,0,0,0,,‎(Хайда) Иә? (Сатушы) Сіздің дос қызыңыз бірдеңе деді ме?
Dialogue: 0,0:09:59.25,0:10:02.34,Default,,0,0,0,,‎Аа, мен шынымен бақытты болдым.
Dialogue: 0,0:10:02.42,0:10:04.54,Default,,0,0,0,,«Дәмді, дәмді» дедім де, жедім.
Dialogue: 0,0:10:04.63,0:10:06.34,Default,,0,0,0,,Шынымен бе? Мен өте қуаныштымын~
Dialogue: 0,0:10:06.42,0:10:07.25,Default,,0,0,0,,О, бұл жақсы.
Dialogue: 0,0:10:07.34,0:10:08.59,Default,,0,0,0,,‎(Сатушы) Жақсы. (Сатушы) Жақсы.
Dialogue: 0,0:10:08.67,0:10:09.75,Default,,0,0,0,,‎(Қызметкерлер)
Dialogue: 0,0:10:09.84,0:10:11.71,Default,,0,0,0,,Олай болса, неге көп жоқ?
Dialogue: 0,0:10:11.79,0:10:14.46,Default,,0,0,0,,(Қызметкерлер) Сәлем? Дұрыс, Хайда
Dialogue: 0,0:10:15.29,0:10:16.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:19.46,0:10:21.34,Default,,0,0,0,,Себебі ол көлікте
Dialogue: 0,0:10:24.71,0:10:25.54,Default,,0,0,0,,Аноза
Dialogue: 0,0:10:26.71,0:10:28.38,Default,,0,0,0,,‎Жоқ, сондықтан кешірім сұраймын.
Dialogue: 0,0:10:28.96,0:10:30.09,Default,,0,0,0,,Жарайды
Dialogue: 0,0:10:30.17,0:10:32.84,Default,,0,0,0,,‎Мен оны бүгінгі карриге саламын, сондықтан сіз айта алмайсыз.
Dialogue: 0,0:10:33.34,0:10:35.13,Default,,0,0,0,,(Рецуко) Жоқ, мен білемін.
Dialogue: 0,0:10:38.21,0:10:40.59,Default,,0,0,0,,(Баяндамашы) Бүгін түстен кейін өткен Өкілдер палатасының жалпы отырысында.
Dialogue: 0,0:10:40.67,0:10:44.34,Default,,0,0,0,,Спикер тарату туралы актіні оқиды. Өкілдер палатасы таратылды.
Dialogue: 0,0:10:45.54,0:10:50.34,Default,,0,0,0,,(Спикер) Жапония Конституциясының 7-бабына сәйкес Өкілдер палатасы таратылады.
Dialogue: 0,0:10:50.42,0:10:51.88,Default,,0,0,0,,(Парламент депутаты) Сәлем!
Dialogue: 0,0:10:51.96,0:10:53.38,Default,,0,0,0,,(Парламент депутаттары) Уа!
Dialogue: 0,0:10:53.46,0:10:55.92,Default,,0,0,0,,(Парламент депутаты) Сәлем! (Парламент депутаттары) Сәлем!
Dialogue: 0,0:10:56.00,0:10:58.46,Default,,0,0,0,,(Парламент депутаты) Сәлем! (Парламент депутаттары) Сәлем!
Dialogue: 0,0:10:58.96,0:11:02.21,Default,,0,0,0,,‎Балалар, барлығың қазір жұмыссызсыңдар.
Dialogue: 0,0:11:03.63,0:11:04.92,Default,,0,0,0,,Сіз жақсы орындайсыз.
Dialogue: 0,0:11:06.54,0:11:07.50,Default,,0,0,0,,Тіпті Хайда-кун
Dialogue: 0,0:11:07.59,0:11:09.88,Default,,0,0,0,,‎Джиро мырза сияқты, мен сенің әкеңнің хатшысы болсам.
Dialogue: 0,0:11:09.96,0:11:12.21,Default,,0,0,0,,Мүмкін ол сонда отырған шығар.
Dialogue: 0,0:11:12.29,0:11:14.25,Default,,0,0,0,,Не? Жоқ жоқ жоқ
Dialogue: 0,0:11:17.00,0:11:18.38,Default,,0,0,0,,‎Егер солай болса
Dialogue: 0,0:11:18.46,0:11:20.92,Default,,0,0,0,,Біз мұнда бірге карри шайқамаған болармыз.
Dialogue: 0,0:11:21.54,0:11:22.42,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:11:23.88,0:11:25.84,Default,,0,0,0,,Бүгін Икари мырза сізге шабуыл жасаған жоқ па?
Dialogue: 0,0:11:26.34,0:11:27.17,Default,,0,0,0,,Иә
Dialogue: 0,0:11:27.71,0:11:29.88,Default,,0,0,0,,‎Мен күткендей, ол бас тартты деп ойлаймын.
Dialogue: 0,0:11:31.21,0:11:32.04,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:33.79,0:11:36.59,Default,,0,0,0,,‎Маған асқынулар мен құлдырауларға толы өмір керек емес.
Dialogue: 0,0:11:38.09,0:11:41.13,Default,,0,0,0,,Егер сіз Хайда-кунмен тыныш өмір сүре алсаңыз, бұл жақсы.
Dialogue: 0,0:11:47.09,0:11:51.79,Default,,0,0,0,,Жапония Конституциясының 7-бабына сәйкес Өкілдер палатасын таратады
Dialogue: 0,0:11:52.75,0:11:54.09,Default,,0,0,0,,(Парламент депутаттары) Сәлем!
Dialogue: 0,0:11:54.17,0:11:56.63,Default,,0,0,0,,(Парламент депутаты) Сәлем! (Парламент депутаттары) Сәлем!
Dialogue: 0,0:11:56.71,0:11:57.67,Default,,0,0,0,,(Парламент депутаты) Сәлем!
Dialogue: 0,0:12:42.34,0:12:44.54,Default,,0,0,0,,‎(Хайда) Хаа ха...
Dialogue: 0,0:12:44.63,0:12:47.25,Default,,0,0,0,,‎Wow~ ‎Винил саусақтарымды қазып жатыр.
Dialogue: 0,0:12:47.34,0:12:48.79,Default,,0,0,0,,‎Күріш ауыр, солай емес пе?
Dialogue: 0,0:12:49.42,0:12:52.54,Default,,0,0,0,,Осындай кезде менің көлігім болса ыңғайлы болар еді.
Dialogue: 0,0:12:52.63,0:12:54.04,Default,,0,0,0,,А, жақсы.
Dialogue: 0,0:12:55.34,0:12:58.88,Default,,0,0,0,,‎Хайда жұмысқа тұрғанда, сіз автотұрағы бар жерге көшесіз бе?
Dialogue: 0,0:12:58.96,0:12:59.84,Default,,0,0,0,,‎Ах~
Dialogue: 0,0:13:01.38,0:13:03.34,Default,,0,0,0,,‎Жоқ, бірақ бұл ақша талап етеді.
Dialogue: 0,0:13:03.92,0:13:05.59,Default,,0,0,0,,Мен оны күнде қолданбаймын.
Dialogue: 0,0:13:06.71,0:13:08.04,Default,,0,0,0,,‎Бірақ бұл жақсы көлік
Dialogue: 0,0:13:08.67,0:13:12.34,Default,,0,0,0,,Барлық ауыр жүктеріңізді бортқа салыңыз.
Dialogue: 0,0:13:16.84,0:13:18.13,Default,,0,0,0,,‎(Хайда) Иә?
Dialogue: 0,0:13:20.25,0:13:21.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:25.42,0:13:26.46,Default,,0,0,0,,Йо Рецуко
Dialogue: 0,0:13:26.54,0:13:27.71,Default,,0,0,0,,‎(Ретсуко) Манака!
Dialogue: 0,0:13:28.38,0:13:30.59,Default,,0,0,0,,Бұл не? Сіздің ниетіңіз қандай?
Dialogue: 0,0:13:31.63,0:13:34.00,Default,,0,0,0,,‎(‎Hyodo‎) Бір танысым маған жақсылық сұрады.
Dialogue: 0,0:13:34.50,0:13:37.25,Default,,0,0,0,,Сіз мені танисыз ба?
Dialogue: 0,0:13:41.88,0:13:43.88,Default,,0,0,0,,‎(Икари) «ашу» дегеніміз не?
Dialogue: 0,0:13:43.96,0:13:46.63,Default,,0,0,0,,Біз әлеммен соқтығысқанда ұшқындар ұшады!
Dialogue: 0,0:13:46.71,0:13:47.96,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:48.04,0:13:50.92,Default,,0,0,0,,‎Бұл қараңғылықты жарықтандыратын жарық сәті!
Dialogue: 0,0:13:51.00,0:13:51.96,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:52.04,0:13:54.25,Default,,0,0,0,,(Икари) Болашаққа нұсқау ашудың харизмасы
Dialogue: 0,0:13:54.84,0:13:57.46,Default,,0,0,0,,Агрессивті Рецуко кандидатымен таныстыру!
Dialogue: 0,0:13:57.54,0:14:02.63,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:02.71,0:14:04.50,Default,,0,0,0,,Бұл нағыз Рецуко!
Dialogue: 0,0:14:07.00,0:14:10.09,Default,,0,0,0,,Жиналғандарыңызға жарайсыңдар, менің жауынгерлерім!
Dialogue: 0,0:14:10.17,0:14:12.00,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:12.09,0:14:13.42,Default,,0,0,0,,‎Осыдан не басталады?
Dialogue: 0,0:14:13.50,0:14:15.17,Default,,0,0,0,,‎(Икари) Білгіңіз келе ме? Яй!
Dialogue: 0,0:14:15.25,0:14:17.38,Default,,0,0,0,,‎(Икари) ‎Келесі шабуыл нысанасын білгіңіз келе ме?
Dialogue: 0,0:14:17.46,0:14:19.34,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:19.42,0:14:24.42,Default,,0,0,0,,Агрессивті Рецуконың келесі мақсаты... осында!
Dialogue: 0,0:14:25.50,0:14:27.71,Default,,0,0,0,,‎(Ретсуко) Иә?
Dialogue: 0,0:14:27.79,0:14:28.79,Default,,0,0,0,,Парламент?
Dialogue: 0,0:14:28.88,0:14:29.84,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:14:29.92,0:14:31.42,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:14:31.50,0:14:34.29,Default,,0,0,0,,‎Ал сайлау плакаты... Міне, осы!
Dialogue: 0,0:14:35.79,0:14:40.67,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:40.75,0:14:47.34,Default,,0,0,0,,Рецуко! Рецуко! Рецуко!
Dialogue: 0,0:14:51.92,0:14:53.96,Default,,0,0,0,,(Хайда) Жүргізуші, дәл осы жерде.
Dialogue: 0,0:14:54.04,0:14:55.84,Default,,0,0,0,,Бұрылғаннан кейін біраз уақыт түзу тұрыңыз.
Dialogue: 0,0:14:55.92,0:14:56.79,Default,,0,0,0,,‎(Жүргізуші) Иә, түсіндім.
Dialogue: 0,0:14:59.88,0:15:05.79,Default,,0,0,0,,‎Ретсуко! Рецуко! Рецуко!
Dialogue: 0,0:15:10.79,0:15:12.63,Default,,0,0,0,,‎Тағдырыңды мойында
Dialogue: 0,0:15:14.34,0:15:18.34,Default,,0,0,0,,Екі күн бұрын хабарлау арқылы біз көптеген қолдаушыларды жинадық.
Dialogue: 0,0:15:19.92,0:15:21.63,Default,,0,0,0,,Сіз оны көре аласыз ба?
Dialogue: 0,0:15:22.46,0:15:27.13,Default,,0,0,0,,Осы орынға келе алмаған адамдарды көбірек көргім келеді.
Dialogue: 0,0:15:27.21,0:15:30.09,Default,,0,0,0,,Ішінде жасырылған ашуды айта алмайды
Dialogue: 0,0:15:30.17,0:15:35.13,Default,,0,0,0,,‎Үнсіз сайлаушылар сіздің келуіңізді күтуде!
Dialogue: 0,0:15:37.63,0:15:39.88,Default,,0,0,0,,Сізге сеніп тапсырылған
Dialogue: 0,0:15:40.84,0:15:43.00,Default,,0,0,0,,Бұдан былай, өзім үшін емес.
Dialogue: 0,0:15:43.84,0:15:47.09,Default,,0,0,0,,Басқа біреу үшін ашуланба!
Dialogue: 0,0:15:52.96,0:15:53.79,Default,,0,0,0,,Рецуко!
Dialogue: 0,0:15:56.29,0:15:59.17,Default,,0,0,0,,‎♪～ ‎(Ретсуко) Уау!
Dialogue: 0,0:15:59.25,0:16:00.84,Default,,0,0,0,,‎(Икари) Қарап көріңізші!
Dialogue: 0,0:16:00.92,0:16:04.29,Default,,0,0,0,,Агрессивті Рецуко басын қатты шайқап тұр.
Dialogue: 0,0:16:05.59,0:16:08.04,Default,,0,0,0,,‎Ретсуко! Рецуко! Рецуко! Рецуко!
Dialogue: 0,0:16:08.13,0:16:10.92,Default,,0,0,0,,Рецуко! Рецуко! Кандидат!
Dialogue: 0,0:16:11.00,0:16:15.34,Default,,0,0,0,,Рецуко! Рецуко! Рецуко! Рецуко! Рецуко! Рецуко! Кандидат!
Dialogue: 0,0:16:15.42,0:16:17.13,Default,,0,0,0,,‎(Hyoudou) Егер сіз оны тартқыңыз келсе
Dialogue: 0,0:16:17.21,0:16:18.79,Default,,0,0,0,,Тек сыртқы орды толтырыңыз.
Dialogue: 0,0:16:19.29,0:16:20.71,Default,,0,0,0,,Ол ақырында бұзылады
Dialogue: 0,0:16:21.29,0:16:24.59,Default,,0,0,0,,‎Жақсы, байсалды бала айналасындағылардың үмітін ақтайды.
Dialogue: 0,0:16:26.38,0:16:29.00,Default,,0,0,0,,(Икари) Осы тудың астына жиналыңдар!
Dialogue: 0,0:16:29.63,0:16:31.75,Default,,0,0,0,,‎Барлығыңыз көрдіңіз.
Dialogue: 0,0:16:31.84,0:16:36.13,Default,,0,0,0,,‎Жаңа аңыздың басталу сәті!
Dialogue: 0,0:16:36.21,0:16:41.21,Default,,0,0,0,,♪～
Dialogue: 0,0:16:58.42,0:17:03.46,Default,,0,0,0,,～♪
