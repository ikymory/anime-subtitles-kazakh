Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.33,0:00:06.84,Default,,0,0,0,,Мен киімімді ауыстырғанша сол жерде күте тұрыңыз.
Dialogue: 0,0:00:06.84,0:00:08.84,Default,,0,0,0,,《Шошқа: Эй, эй, сәл күте тұрыңыз.
Dialogue: 0,0:00:08.84,0:00:12.84,Default,,0,0,0,,Сіз әлі де киіміңізді ауыстырмақсыз ба? Мен осында болсам да! ? 》
Dialogue: 0,0:00:12.84,0:00:15.68,Default,,0,0,0,,Хехе.
Dialogue: 0,0:00:15.68,0:00:17.68,Default,,0,0,0,,《Гулп...》
Dialogue: 0,0:00:17.68,0:00:19.85,Default,,0,0,0,,Хехе.
Dialogue: 0,0:00:19.85,0:00:22.18,Default,,0,0,0,,Джаан! Фуга?
Dialogue: 0,0:00:22.18,0:00:24.19,Default,,0,0,0,,Бұл жай ғана киім ауыстыру болса да➡
Dialogue: 0,0:00:24.19,0:00:27.02,Default,,0,0,0,,Тек осы корсетті киіміңізге киіңіз.
Dialogue: 0,0:00:27.02,0:00:29.02,Default,,0,0,0,,Маржан?
Dialogue: 0,0:00:29.02,0:00:31.36,Default,,0,0,0,,Ум...
Dialogue: 0,0:00:31.36,0:00:34.36,Default,,0,0,0,,Сіздің үмітіңізді ақтай алмағанымыз үшін кешірім сұраймыз.
Dialogue: 0,0:00:34.36,0:00:36.37,Default,,0,0,0,,Сізге ұнайды деп ойлаймын➡
Dialogue: 0,0:00:36.37,0:00:38.87,Default,,0,0,0,,Мен жай ғана саған еркелік ойнағым келді.
Dialogue: 0,0:00:38.87,0:00:41.54,Default,,0,0,0,,Жоқ, менің ешқандай үмітім жоқ.
Dialogue: 0,0:00:41.54,0:00:45.37,Default,,0,0,0,,《Көрдім, жүрегімдегі дауыстарды естимін.》
Dialogue: 0,0:00:45.37,0:00:47.71,Default,,0,0,0,,О, бұл Джесстің басқа киімі➡
Dialogue: 0,0:00:47.71,0:00:50.05,Default,,0,0,0,,Бұл сізді көруге болатынын білдіреді.
Dialogue: 0,0:00:50.05,0:00:53.55,Default,,0,0,0,,Оның киім ауыстырғанын көргім келмеді.
Dialogue: 0,0:00:53.55,0:00:56.72,Default,,0,0,0,,Енді мен сендерге тағы бір киімді көрсетейін.
Dialogue: 0,0:00:56.72,0:00:59.72,Default,,0,0,0,,Өтінемін. Хехе.
Dialogue: 0,0:00:59.72,0:01:01.66,Default,,0,0,0,,《Бірақ бұл қыз➡
Dialogue: 0,0:01:01.66,0:01:03.66,Default,,0,0,0,,Жүрегіңіздің дауысын естіп қана қоймайсыз➡
Dialogue: 0,0:01:03.66,0:01:05.66,Default,,0,0,0,,Сұлу қызға мазақ еткісі келеді➡
Dialogue: 0,0:01:05.66,0:01:08.16,Default,,0,0,0,,Менің терең ойларымды сездің бе?
Dialogue: 0,0:01:08.16,0:01:11.67,Default,,0,0,0,,Бұл қорқынышты болар еді》 Шошқа.
Dialogue: 0,0:01:11.67,0:01:14.67,Default,,0,0,0,,Бұл Киртли қаласы. Ой….
Dialogue: 0,0:01:14.67,0:01:18.17,Default,,0,0,0,,Кеттік. Ах.
Dialogue: 0,0:01:18.17,0:01:21.51,Default,,0,0,0,,《Кешіріңіздер, балалар. Мен бір қадам алға барамын.
Dialogue: 0,0:01:21.51,0:01:23.85,Default,,0,0,0,,Бүгін сауда күні.
Dialogue: 0,0:01:23.85,0:01:28.35,Default,,0,0,0,,Балалар, ең болмағанда, менің жетістіктерімді сілтеме ретінде пайдалана аласыздар.
Dialogue: 0,0:02:59.04,0:03:09.82,Default,,0,0,0,,♬～
Dialogue: 0,0:03:09.82,0:03:12.82,Default,,0,0,0,,Бұл жанды және әдемі қала. Иә.
Dialogue: 0,0:03:12.82,0:03:16.83,Default,,0,0,0,,《Қалада шошқамен серуендегенімде мені байқамай қала ма деп уайымдадым➡
Dialogue: 0,0:03:16.83,0:03:21.16,Default,,0,0,0,,Бұл негізсіз қорқыныш болды. Басқа әлемнен болса да, кәдімгі жануарларға толы.
Dialogue: 0,0:03:21.16,0:03:24.00,Default,,0,0,0,,Біртүрлі құбыжықтар табылмады》
Dialogue: 0,0:03:24.00,0:03:28.00,Default,,0,0,0,,Мм, ойын-сауықтың түрі бар ма? Ах.
Dialogue: 0,0:03:28.00,0:03:31.17,Default,,0,0,0,,Бүгін кешке фестиваль бар.
Dialogue: 0,0:03:31.17,0:03:34.18,Default,,0,0,0,,Хохо…. Пиг-сан, сен фестивальдерді жақсы көресің.
Dialogue: 0,0:03:34.18,0:03:36.51,Default,,0,0,0,,Маған ерекше атмосфера ұнайды.
Dialogue: 0,0:03:36.51,0:03:39.68,Default,,0,0,0,,Фестиваль мен саяхатқа да солай.
Dialogue: 0,0:03:39.68,0:03:42.68,Default,,0,0,0,,Мен көремін. Саяхаттау...?
Dialogue: 0,0:03:42.68,0:03:46.86,Default,,0,0,0,,Джесс ешқашан саяхаттаған жоқ па? Иә, ешқашан.
Dialogue: 0,0:03:46.86,0:03:50.53,Default,,0,0,0,,Бұл сіздің король астанасына бірінші рет баруыңызды білдіре ме?
Dialogue: 0,0:03:50.53,0:03:53.03,Default,,0,0,0,,Иә….
Dialogue: 0,0:03:53.03,0:03:55.20,Default,,0,0,0,,О, бұл қызық.
Dialogue: 0,0:03:55.20,0:03:59.70,Default,,0,0,0,,Ал... Мен оны асыға күтемін.
Dialogue: 0,0:03:59.70,0:04:02.80,Default,,0,0,0,,Маржан?
Dialogue: 0,0:04:02.80,0:04:04.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:04.81,0:04:07.48,Default,,0,0,0,,Джесс Бұл қай дүкен? Ах...
Dialogue: 0,0:04:07.48,0:04:10.31,Default,,0,0,0,,Ах, бұл Листаның дүкені.
Dialogue: 0,0:04:10.31,0:04:12.48,Default,,0,0,0,,Мен үнемі сол жерден заттарды сатып аламын.
Dialogue: 0,0:04:12.48,0:04:15.15,Default,,0,0,0,,Қауіпсіздік өте әсерлі.
Dialogue: 0,0:04:15.15,0:04:19.05,Default,,0,0,0,,Иә. Листа өте қымбат.
Dialogue: 0,0:04:26.83,0:04:30.33,Default,,0,0,0,,Эй Джесс, мұндай жердің мақсаты не?
Dialogue: 0,0:04:30.33,0:04:32.67,Default,,0,0,0,,Әртүрлі жағдайлар бар.
Dialogue: 0,0:04:32.67,0:04:35.00,Default,,0,0,0,,《Өтінемін, жақын болыңыз》
Dialogue: 0,0:04:35.00,0:04:37.01,Default,,0,0,0,,Уа... енді ше?
Dialogue: 0,0:04:37.01,0:04:40.01,Default,,0,0,0,,《Есма тек адамдардың жүрегінің дауысын тыңдамайды➡
Dialogue: 0,0:04:40.01,0:04:43.18,Default,,0,0,0,,Жүрегіңіздің үнін де жеткізе аласыз.
Dialogue: 0,0:04:43.18,0:04:45.85,Default,,0,0,0,,Бұл жерде көп айтпаған дұрыс➡
Dialogue: 0,0:04:45.85,0:04:49.18,Default,,0,0,0,,Жарайды деп ойладым》 Түсіндім... Иә?
Dialogue: 0,0:04:49.18,0:04:51.19,Default,,0,0,0,,Бір минут күтіңіз! Ах.
Dialogue: 0,0:04:51.19,0:04:54.52,Default,,0,0,0,,Қалай қарасаң да, қыздың жалғыз келетін жері емес.
Dialogue: 0,0:04:54.52,0:04:58.36,Default,,0,0,0,,《Мынау бар болса, жақсы болады.》 Бұл...
Dialogue: 0,0:04:58.36,0:05:00.96,Default,,0,0,0,,《Егер сізде осы Kiltlin отбасылық белгісі болса➡
Dialogue: 0,0:05:00.96,0:05:03.97,Default,,0,0,0,,Маған ешкім шабуыл жасайды деп ойламаймын.
Dialogue: 0,0:05:03.97,0:05:08.30,Default,,0,0,0,,Егер сізде жоқ болса, сізге шабуыл жасалады деп алаңдайтын сияқтысыз.
Dialogue: 0,0:05:08.30,0:05:10.31,Default,,0,0,0,,《Тек жағдайда.
Dialogue: 0,0:05:10.31,0:05:13.48,Default,,0,0,0,,Ал шошқа бар, солай емес пе?
Dialogue: 0,0:05:13.48,0:05:16.48,Default,,0,0,0,,Шошқа денесінің шегі бар.
Dialogue: 0,0:05:16.48,0:05:20.08,Default,,0,0,0,,Жарайды, абай болайық. рақмет сізге.
Dialogue: 0,0:05:24.32,0:05:26.66,Default,,0,0,0,,⚟Есманың қызы. Ах. ау.
Dialogue: 0,0:05:26.66,0:05:30.49,Default,,0,0,0,,Мұндай жерге жалғыз келсең, жасырын сауда жасап жатқан болуың керек.
Dialogue: 0,0:05:30.49,0:05:32.99,Default,,0,0,0,,Бұл сізге керек пе?
Dialogue: 0,0:05:32.99,0:05:37.50,Default,,0,0,0,,Үш қара тізім 400 алтын тұрады. Бұл жақсы мәміле.
Dialogue: 0,0:05:37.50,0:05:40.34,Default,,0,0,0,,Осы бағамен...?
Dialogue: 0,0:05:40.34,0:05:43.17,Default,,0,0,0,,Сіздің тілегіңізді орындау үшін бұл жеткілікті.
Dialogue: 0,0:05:43.17,0:05:46.51,Default,,0,0,0,,Сіз оны басқа еш жерде бұл бағаға сатып ала алмайсыз.
Dialogue: 0,0:05:46.51,0:05:51.01,Default,,0,0,0,,Бірақ кешіріңіз, менде 400 де жоқ.
Dialogue: 0,0:05:51.01,0:05:53.52,Default,,0,0,0,,Біреуі қанша тұрады?
Dialogue: 0,0:05:53.52,0:05:57.35,Default,,0,0,0,,Бір... Бір болса, 150 алтын.
Dialogue: 0,0:05:57.35,0:06:00.29,Default,,0,0,0,,Мм. 《Хмм? 》
Dialogue: 0,0:06:00.29,0:06:02.46,Default,,0,0,0,,Егер 150 Галт болса...
Dialogue: 0,0:06:02.46,0:06:06.96,Default,,0,0,0,,Эй Джесс, Джесма қара тізім дұғалар үшін қолданылатынын айтты➡
Dialogue: 0,0:06:06.96,0:06:09.13,Default,,0,0,0,,Бір намазға неше намаз қажет?
Dialogue: 0,0:06:09.13,0:06:12.13,Default,,0,0,0,,《Е... бір жеткілікті》
Dialogue: 0,0:06:12.13,0:06:15.14,Default,,0,0,0,,Тілекті орындап, қосымша сиқырлы күшке ие болуға бола ма?
Dialogue: 0,0:06:15.14,0:06:17.81,Default,,0,0,0,,《Әдетте біраз қалдық болады》
Dialogue: 0,0:06:17.81,0:06:20.48,Default,,0,0,0,,Әй қыз, не болды?
Dialogue: 0,0:06:20.48,0:06:24.15,Default,,0,0,0,,Джесс, менің артымнан еріп жүргендей кейіп таныт! Маған жазыл!
Dialogue: 0,0:06:24.15,0:06:26.15,Default,,0,0,0,,Иә? Ах...
Dialogue: 0,0:06:26.15,0:06:28.15,Default,,0,0,0,,Кешіріңіз! Эй!
Dialogue: 0,0:06:28.15,0:06:30.15,Default,,0,0,0,,Ханым!
Dialogue: 0,0:06:30.15,0:06:35.49,Default,,0,0,0,,Хаа... ха... Мм... жер бетінде не болды?
Dialogue: 0,0:06:35.49,0:06:38.49,Default,,0,0,0,,Джесс Ол жігіттен тізім сатып алмаңыз.
Dialogue: 0,0:06:38.49,0:06:40.50,Default,,0,0,0,,Неге?
Dialogue: 0,0:06:40.50,0:06:43.83,Default,,0,0,0,,Мен бұл тізімдердің бәрі пайдаланылмаған қалдықтар екеніне сенімдімін.
Dialogue: 0,0:06:43.83,0:06:47.67,Default,,0,0,0,,Иә! Тілегіңізді орындау үшін бір қара тізім жеткілікті.
Dialogue: 0,0:06:47.67,0:06:50.51,Default,,0,0,0,,Джесс осылай деді. Бірақ ол кісі➡
Dialogue: 0,0:06:50.51,0:06:54.34,Default,,0,0,0,,"Үшке 400 алтын. Тілегіңді орындағың келсе, осы жеткілікті."➡
Dialogue: 0,0:06:54.34,0:06:56.34,Default,,0,0,0,,деді. Иә.
Dialogue: 0,0:06:56.34,0:06:59.85,Default,,0,0,0,,Үш тілек болса, көп тілек орындалатыны рас.
Dialogue: 0,0:06:59.85,0:07:02.45,Default,,0,0,0,,Оны жақсы түсіндірмеңіз.
Dialogue: 0,0:07:02.45,0:07:06.12,Default,,0,0,0,,Үшеуің болса, бір тілегің орындалуы мүмкін➡
Dialogue: 0,0:07:06.12,0:07:08.46,Default,,0,0,0,,Міне, осыны білдіреді. Ах...
Dialogue: 0,0:07:08.46,0:07:10.79,Default,,0,0,0,,Ойлан. Сол жерде➡
Dialogue: 0,0:07:10.79,0:07:13.13,Default,,0,0,0,,Йесма қара тізімді сатып алуы керек➡
Dialogue: 0,0:07:13.13,0:07:16.80,Default,,0,0,0,,Әдетте сіз орталық көшедегі дүкендерден зат алмайсыз, солай ма?
Dialogue: 0,0:07:16.80,0:07:18.80,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:07:18.80,0:07:23.64,Default,,0,0,0,,Біріншіден, үйде қара білезік сирек кездеседі.
Dialogue: 0,0:07:23.64,0:07:27.31,Default,,0,0,0,,Егер сіз бұрын ешқашан нақты қара тізімді пайдаланбаған болсаңыз➡
Dialogue: 0,0:07:27.31,0:07:30.65,Default,,0,0,0,,Сіз сапасыз өнімді сатсаңыз, сізді білмейді. Ах...
Dialogue: 0,0:07:30.65,0:07:32.65,Default,,0,0,0,,Жүрегіңдегі дауысты естисің.
Dialogue: 0,0:07:32.65,0:07:34.65,Default,,0,0,0,,Корсетті көргенде қалай қарады➡
Dialogue: 0,0:07:34.65,0:07:37.82,Default,,0,0,0,,Бұл біртүрлі болды, солай емес пе? Иә.
Dialogue: 0,0:07:37.82,0:07:40.99,Default,,0,0,0,,Олар бірдеңе дұрыс емес деп ойлаған сияқты➡
Dialogue: 0,0:07:40.99,0:07:45.33,Default,,0,0,0,,Егжей-тегжейлі ойларыңызды ести алмаймын... Ах....
Dialogue: 0,0:07:45.33,0:07:47.33,Default,,0,0,0,,《Бірақ ол кісі де➡
Dialogue: 0,0:07:47.33,0:07:50.00,Default,,0,0,0,,Ол ақыл оқи алатын Есмамен сауда жасайды.
Dialogue: 0,0:07:50.00,0:07:53.34,Default,,0,0,0,,Ол өзінің зұлым жоспарларын жарияламау үшін абай болу керек.
Dialogue: 0,0:07:53.34,0:07:56.84,Default,,0,0,0,,Джесс Килтлиндер отбасынан шыққан Йесма➡
Dialogue: 0,0:07:56.84,0:07:59.67,Default,,0,0,0,,Байқағаныңыз үшін емес пе? Ах...
Dialogue: 0,0:07:59.67,0:08:02.11,Default,,0,0,0,,Мен шынайы қара тізім өнімдерін қолдандым➡
Dialogue: 0,0:08:02.11,0:08:04.95,Default,,0,0,0,,Бұл Йесма болуы мүмкін. Аа….
Dialogue: 0,0:08:04.95,0:08:07.45,Default,,0,0,0,,Ондай адамға сапасыз өнім сатсаңыз➡
Dialogue: 0,0:08:07.45,0:08:11.79,Default,,0,0,0,,Лорд мырзасы Килтлиндер отбасы оның жалған бизнесі туралы білу қаупі бар.
Dialogue: 0,0:08:11.79,0:08:15.46,Default,,0,0,0,,Менің ойымша, оны уайымдағаны осы шығар. Бұл солай болды.
Dialogue: 0,0:08:15.46,0:08:18.13,Default,,0,0,0,,Мен бұл өте арзан деп ойладым.
Dialogue: 0,0:08:18.13,0:08:20.13,Default,,0,0,0,,How much does one normally cost?
Dialogue: 0,0:08:20.13,0:08:24.13,Default,,0,0,0,,Мен әдетте сатып алатын дүкенде бір бұйым 600 алтын тұрады.
Dialogue: 0,0:08:24.13,0:08:26.97,Default,,0,0,0,,《Ей, сіз сол кезде бірдеңе дұрыс емес екенін түсінуіңіз керек.》
Dialogue: 0,0:08:26.97,0:08:28.97,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:08:28.97,0:08:31.97,Default,,0,0,0,,Сізге қоңырау шалу қиынға соққан адамға күмәндану - ➡
Dialogue: 0,0:08:31.97,0:08:34.98,Default,,0,0,0,,Кешіріңіз. Жоқ, бұл монолог.
Dialogue: 0,0:08:34.98,0:08:39.31,Default,,0,0,0,,Оған мән бермеңіз. Аа, дұрыс. кешіріңіз.
Dialogue: 0,0:08:39.31,0:08:42.48,Default,,0,0,0,,《Бірақ мен сенің мейірімді екеніңді білдім➡
Dialogue: 0,0:08:42.48,0:08:44.49,Default,,0,0,0,,Әзірге》
Dialogue: 0,0:08:44.49,0:08:46.82,Default,,0,0,0,,Сол шошқа. Хмм.
Dialogue: 0,0:08:46.82,0:08:50.33,Default,,0,0,0,,Рахмет. Шошқа болмаса➡
Dialogue: 0,0:08:50.33,0:08:53.66,Default,,0,0,0,,Мен қымбат ақшамды алдап кете жаздадым.
Dialogue: 0,0:08:53.66,0:08:57.50,Default,,0,0,0,,Уайымдамаңыз. Бірақ болашақта абай болыңыз.
Dialogue: 0,0:08:57.50,0:08:59.67,Default,,0,0,0,,Жақсы болды деп қасыңа келген жігіт➡
Dialogue: 0,0:08:59.67,0:09:02.87,Default,,0,0,0,,Көптеген адамдар тек ақша табуды ойлайды.
Dialogue: 0,0:09:04.77,0:09:06.78,Default,,0,0,0,,А...?
Dialogue: 0,0:09:06.78,0:09:08.98,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:09:10.95,0:09:13.78,Default,,0,0,0,,Oh, by the way, why did Jess ➡
Dialogue: 0,0:09:13.78,0:09:15.98,Default,,0,0,0,,Сіз қара тізімді жасырын түрде сатып алмақ болдыңыз ба?
Dialogue: 0,0:09:17.95,0:09:19.95,Default,,0,0,0,,《Мм? 》
Dialogue: 0,0:09:19.95,0:09:23.96,Default,,0,0,0,,Um... can't you just say it's a secret?
Dialogue: 0,0:09:25.96,0:09:30.13,Default,,0,0,0,,Шошқа қорасында болғанымызда мен Джесстің не айтқанын түсінбедім➡
Dialogue: 0,0:09:30.13,0:09:32.63,Default,,0,0,0,,Шошқаның денесіне де бейімделе алмады.
Dialogue: 0,0:09:32.63,0:09:34.80,Default,,0,0,0,,But after waking up in Jess's room➡
Dialogue: 0,0:09:34.80,0:09:39.14,Default,,0,0,0,,Сөзді түсінетінмін, көруім қалыпты, төрт аяқты басатын болдым.
Dialogue: 0,0:09:39.14,0:09:42.48,Default,,0,0,0,,Jess said, "I tried my best"➡
Dialogue: 0,0:09:42.48,0:09:44.48,Default,,0,0,0,,Мен үшін не істедің?
Dialogue: 0,0:09:44.48,0:09:47.82,Default,,0,0,0,,Ренжіткен болсам кешіріңіз...
Dialogue: 0,0:09:47.82,0:09:51.32,Default,,0,0,0,,No offense, but let me confirm.
Dialogue: 0,0:09:51.32,0:09:53.32,Default,,0,0,0,,Джесс мені емдеу үшін➡
Dialogue: 0,0:09:53.32,0:09:56.32,Default,,0,0,0,,Сіз Килтлиндер отбасының қара тізімін рұқсатсыз пайдаландыңыз, солай ма?
Dialogue: 0,0:09:56.32,0:09:58.33,Default,,0,0,0,,Иә...
Dialogue: 0,0:09:58.33,0:10:01.83,Default,,0,0,0,,Сондықтан оны өз ақшаммен толықтыруға тура келді.
Dialogue: 0,0:10:01.83,0:10:06.67,Default,,0,0,0,,Иә. Жаңа ғана сары білекті рұқсатсыз пайдаланғаны үшін ұрысып қалдым➡
Dialogue: 0,0:10:06.67,0:10:09.17,Default,,0,0,0,,Оның үстіне қара тізімшілерге келгенде.
Dialogue: 0,0:10:09.17,0:10:13.17,Default,,0,0,0,,《Сары тізім мен үшін де қолданылғанына сенімдімін.
Dialogue: 0,0:10:13.17,0:10:18.68,Default,,0,0,0,,Джесс мені, шошқаны үшінші қабатқа апаруы мүмкін емес еді.
Dialogue: 0,0:10:18.68,0:10:21.18,Default,,0,0,0,,Does that mean it was all for me?
Dialogue: 0,0:10:21.18,0:10:23.18,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:10:23.18,0:10:26.52,Default,,0,0,0,,This was all done by me.
Dialogue: 0,0:10:26.52,0:10:29.02,Default,,0,0,0,,Ал мен шошқаны қатыстырдым...
Dialogue: 0,0:10:29.02,0:10:31.03,Default,,0,0,0,,《Why are you crying?
Dialogue: 0,0:10:31.03,0:10:33.03,Default,,0,0,0,,Мұның бәрін сен мен үшін істедің➡
Dialogue: 0,0:10:33.03,0:10:36.03,Default,,0,0,0,,Бұл үшін өкінесіз бе?
Dialogue: 0,0:10:36.03,0:10:38.53,Default,,0,0,0,,What a kind child.
Dialogue: 0,0:10:38.53,0:10:41.54,Default,,0,0,0,,Тым мейірімді, тым мейірімді, өте➡
Dialogue: 0,0:10:41.54,0:10:45.04,Default,,0,0,0,,Мен тіпті шошқа да өтей алмайтын жақсылық алдым.
Dialogue: 0,0:10:45.04,0:10:50.55,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:10:50.55,0:10:54.55,Default,,0,0,0,,《Шошқаның табанымен де басыңды сипау мүмкін емес.》 (жылап)
Dialogue: 0,0:10:54.55,0:10:56.55,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:10:56.55,0:10:59.39,Default,,0,0,0,,Ах... Рахмет, Джесс.
Dialogue: 0,0:10:59.39,0:11:03.83,Default,,0,0,0,,Джесс қателескен жоқ. Мен қателескен жалғыз нәрсе -➡
Dialogue: 0,0:11:03.83,0:11:06.10,Default,,0,0,0,,Адамның шошқаға айналғанындай көп пәле➡
Dialogue: 0,0:11:06.10,0:11:11.00,Default,,0,0,0,,Мен араластым. Бұл сондай әурешілік.
Dialogue: 0,0:11:11.00,0:11:13.17,Default,,0,0,0,,Джесс ешқашан жыламайды.
Dialogue: 0,0:11:13.17,0:11:16.17,Default,,0,0,0,,Мен үшін ол жүзді көрсетпеңізші.
Dialogue: 0,0:11:16.17,0:11:19.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:19.17,0:11:21.88,Default,,0,0,0,,Иә... Кешіріңіз.
Dialogue: 0,0:11:26.51,0:11:29.18,Default,,0,0,0,,Ақыры күлдіңіз бе?
Dialogue: 0,0:11:29.18,0:11:32.19,Default,,0,0,0,,《Жоқ, Джесс, өйткені мен сұрадым➡
Dialogue: 0,0:11:32.19,0:11:34.36,Default,,0,0,0,,Ол жай ғана бұған жауап беруге тырысты.
Dialogue: 0,0:11:34.36,0:11:38.36,Default,,0,0,0,,Мен бұлай өмір сүре алмаймын. Мен Джесске өтеуім керек.
Dialogue: 0,0:11:42.03,0:11:45.70,Default,,0,0,0,,Джесс әрқашан сол дүкеннен Lista сатып алады.
Dialogue: 0,0:11:45.70,0:11:50.87,Default,,0,0,0,,Иә. Қожайыны Киринсу мырза маған әрқашан мейірімді болды.
Dialogue: 0,0:11:50.87,0:11:53.71,Default,,0,0,0,,Джесс, сіз саудаласып көрдіңіз бе?
Dialogue: 0,0:11:53.71,0:11:56.21,Default,,0,0,0,,Мм... жоқ.
Dialogue: 0,0:11:56.21,0:11:58.55,Default,,0,0,0,,Дүкенге шығын келтірмеңіз➡
Dialogue: 0,0:11:58.55,0:12:01.32,Default,,0,0,0,,Кешіріңіз. Бірақ екінші жағынан➡
Dialogue: 0,0:12:01.32,0:12:04.99,Default,,0,0,0,,Джесс сатып алудан үлкен пайда тапқан болуы керек.
Dialogue: 0,0:12:04.99,0:12:07.99,Default,,0,0,0,,Мүмкін сіз Джесске жақсырақ болуыңыз керек шығар.
Dialogue: 0,0:12:07.99,0:12:10.33,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:12:10.33,0:12:13.03,Default,,0,0,0,,Аа, дұрыс. Әзірге барайық.
Dialogue: 0,0:12:17.17,0:12:20.34,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:12:20.34,0:12:22.50,Default,,0,0,0,,Иә? Сәлем Джесс.
Dialogue: 0,0:12:22.50,0:12:25.84,Default,,0,0,0,,Эй, сен сирек бірдеңе әкелесің.
Dialogue: 0,0:12:25.84,0:12:30.68,Default,,0,0,0,,Сәлем Киринс. Жарайды, бүгін қай Листер туралы айтып отырсыз?
Dialogue: 0,0:12:30.68,0:12:33.51,Default,,0,0,0,,Ал... бұл…. иә?
Dialogue: 0,0:12:33.51,0:12:36.68,Default,,0,0,0,,Джесс, менің айтқанымды істе.
Dialogue: 0,0:12:36.68,0:12:38.85,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:12:38.85,0:12:41.56,Default,,0,0,0,,Алдымен маған қара тізімді қалайтыныңызды айтыңыз.
Dialogue: 0,0:12:43.52,0:12:45.53,Default,,0,0,0,,Мм... қара тізім➡
Dialogue: 0,0:12:45.53,0:12:49.03,Default,,0,0,0,,Мен жеке алғым келеді. иә? Тағы?
Dialogue: 0,0:12:49.03,0:12:52.70,Default,,0,0,0,,Өз басым оны біраз уақыт бұрын саттым деп ойлаймын➡
Dialogue: 0,0:12:52.70,0:12:55.70,Default,,0,0,0,,Басқасы бар ма? 《Хмм? 》
Dialogue: 0,0:12:55.70,0:12:59.04,Default,,0,0,0,,Иә, маған қайтадан керек болды.
Dialogue: 0,0:12:59.04,0:13:02.98,Default,,0,0,0,,Есма онша көп сатып ала алмайды деп ойлаймын.
Dialogue: 0,0:13:02.98,0:13:05.48,Default,,0,0,0,,《Мм...》 Бұл...
Dialogue: 0,0:13:05.48,0:13:09.48,Default,,0,0,0,,Олар маған ақша төлесе, мен онымен жақсы болар едім.
Dialogue: 0,0:13:09.48,0:13:13.49,Default,,0,0,0,,Бұл 600 алтын. Маған қанша ақшаңыз бар екенін айтыңыз.
Dialogue: 0,0:13:13.49,0:13:16.49,Default,,0,0,0,,Негізінде 200 ғана қалды.
Dialogue: 0,0:13:16.49,0:13:20.66,Default,,0,0,0,,200 алтын? Қалған 400-мен не істеуім керек?
Dialogue: 0,0:13:20.66,0:13:24.50,Default,,0,0,0,,«Маған бұл өте қажет, сондықтан бағасын төмендете аласыз ба?»➡
Dialogue: 0,0:13:24.50,0:13:26.83,Default,,0,0,0,,Айт.
Dialogue: 0,0:13:26.83,0:13:29.17,Default,,0,0,0,,Бұл өте қажет.
Dialogue: 0,0:13:29.17,0:13:33.17,Default,,0,0,0,,Бағаны төмендете аласыз ба? Жарайды, мен қиналдым.
Dialogue: 0,0:13:33.17,0:13:36.01,Default,,0,0,0,,Бұл Квилтлиндер отбасының саудасы емес, солай ма?
Dialogue: 0,0:13:36.01,0:13:39.35,Default,,0,0,0,,Неліктен мен оны Есмаға арзанға сатуым керек?
Dialogue: 0,0:13:39.35,0:13:42.18,Default,,0,0,0,,《Бұл кемсітушіліктің айқын сезімі.
Dialogue: 0,0:13:42.18,0:13:45.35,Default,,0,0,0,,Бұл қарт Джесс өзінің мейірімді екенін айтты➡
Dialogue: 0,0:13:45.35,0:13:49.36,Default,,0,0,0,,Есманы кемсіту олардың бойына сіңгені анық.
Dialogue: 0,0:13:49.36,0:13:52.66,Default,,0,0,0,,Мм... Кешіріңіз...
Dialogue: 0,0:13:54.70,0:13:58.20,Default,,0,0,0,,Джесс, қара тізім қашан дайын болуым керек?
Dialogue: 0,0:13:58.20,0:14:01.47,Default,,0,0,0,,Бұл... ертең. Уф! ?
Dialogue: 0,0:14:01.47,0:14:05.64,Default,,0,0,0,,Ертең таңертең патша астанасына барар алдында дайындалуым керек➡
Dialogue: 0,0:14:05.64,0:14:08.98,Default,,0,0,0,,Сізді ұры ретінде қуады.
Dialogue: 0,0:14:08.98,0:14:12.48,Default,,0,0,0,,《Сіз сол жерге барып, Листа сатып алмақ болдыңыз ба?》
Dialogue: 0,0:14:12.48,0:14:16.98,Default,,0,0,0,,Шынайы өнімді сатып алу үшін қанша ақша табуға болады?
Dialogue: 0,0:14:16.98,0:14:21.32,Default,,0,0,0,,Жарайды... қарапайым адамға да, 20 күн болса керек.
Dialogue: 0,0:14:21.32,0:14:23.32,Default,,0,0,0,,Бұл көп ақша.
Dialogue: 0,0:14:23.32,0:14:25.83,Default,,0,0,0,,Артқы аллеяға заттар сатып алуға келетін басқа Есмас➡
Dialogue: 0,0:14:25.83,0:14:27.83,Default,,0,0,0,,Оларды қалай жинайсың?
Dialogue: 0,0:14:27.83,0:14:30.33,Default,,0,0,0,,Көп жағдайда қалта ақшасы жетпейді➡
Dialogue: 0,0:14:30.33,0:14:35.64,Default,,0,0,0,,Мен оны сатамын... Иә? Сіз не сатасыз?
Dialogue: 0,0:14:37.84,0:14:40.01,Default,,0,0,0,,Жыныс мүшелері. «Не...! 》
Dialogue: 0,0:14:40.01,0:14:42.34,Default,,0,0,0,,Демек, бұл➡ дегенді білдіреді
Dialogue: 0,0:14:42.34,0:14:45.85,Default,,0,0,0,,Денеңізді сатасыз ба? Эх...
Dialogue: 0,0:14:45.85,0:14:48.35,Default,,0,0,0,,Оны осылай айтуға да болады.
Dialogue: 0,0:14:48.35,0:14:52.35,Default,,0,0,0,,Мен Джесске бұған жол бермеймін! Ах...
Dialogue: 0,0:14:52.35,0:14:57.19,Default,,0,0,0,,Маған қалдырыңыз. Менде бір идея бар. Ах.
Dialogue: 0,0:14:57.19,0:14:59.96,Default,,0,0,0,,Мұндағы шошқаларға да айтыңыз. «Не? 》
Dialogue: 0,0:14:59.96,0:15:03.63,Default,,0,0,0,,Мені сат. 200 Gault және маған Lista сатып алыңыз.
Dialogue: 0,0:15:03.63,0:15:06.80,Default,,0,0,0,,《Бірақ...》 Жарайды. Мен жай шошқа емеспін.
Dialogue: 0,0:15:06.80,0:15:09.64,Default,,0,0,0,,Не болса да, мен бір саңылау тауып, құтыламын.
Dialogue: 0,0:15:09.64,0:15:11.64,Default,,0,0,0,,Сондықтан айтып отырмын. Ах...
Dialogue: 0,0:15:11.64,0:15:13.98,Default,,0,0,0,,Қарт әже, кіріп келемін.
Dialogue: 0,0:15:13.98,0:15:16.31,Default,,0,0,0,,Үндемей қалсаңыз да, ештеңе істей алмайсыз.
Dialogue: 0,0:15:16.31,0:15:18.31,Default,,0,0,0,,Джесс.
Dialogue: 0,0:15:18.31,0:15:20.52,Default,,0,0,0,,Мен үшін де солай істе.
Dialogue: 0,0:15:22.48,0:15:24.82,Default,,0,0,0,,Бұл! 200 Gault➡ қосымша
Dialogue: 0,0:15:24.82,0:15:27.16,Default,,0,0,0,,Мен саған мына шошқаны беремін.
Dialogue: 0,0:15:27.16,0:15:30.66,Default,,0,0,0,,Сонымен, сіз маған қара тізімді сата аласыз ба?
Dialogue: 0,0:15:30.66,0:15:35.16,Default,,0,0,0,,Жоқ... бұл Килтлиндер отбасының малы емес пе? Жоқ.
Dialogue: 0,0:15:35.16,0:15:38.17,Default,,0,0,0,,Мен қырылуға тиісті шошқаларды жасырын өсірдім.
Dialogue: 0,0:15:38.17,0:15:40.84,Default,,0,0,0,,Енді мен Килтлиндер отбасында шошқа емеспін➡
Dialogue: 0,0:15:40.84,0:15:43.50,Default,,0,0,0,,трюктерді де жасай алады. Менің айтарым осы.
Dialogue: 0,0:15:43.50,0:15:48.34,Default,,0,0,0,,Мен қырылуы тиіс торайларды жасырын өсірдім.
Dialogue: 0,0:15:48.34,0:15:51.85,Default,,0,0,0,,Килтлиндер отбасына жатпайды. Және➡
Dialogue: 0,0:15:51.85,0:15:55.35,Default,,0,0,0,,Мен трюк жасай аламын. Өнер?
Dialogue: 0,0:15:55.35,0:15:59.15,Default,,0,0,0,,Жарайды, онда маған бірдеңе көрсет.
Dialogue: 0,0:16:05.46,0:16:09.56,Default,,0,0,0,,Мен не істерімді білмеймін. Маған дұрыс нұсқаулар беріңізші.
Dialogue: 0,0:16:11.63,0:16:14.80,Default,,0,0,0,,Шошқа биі! «Не? Би билеу ме?
Dialogue: 0,0:16:14.80,0:16:19.14,Default,,0,0,0,,Мұның Hyorogari көзілдіріктеріне еш қатысы жоқ, бірақ...
Dialogue: 0,0:16:19.14,0:16:21.14,Default,,0,0,0,,Бізде мұны істеуден басқа амал жоқ! 》
Dialogue: 0,0:16:38.49,0:16:47.50,Default,,0,0,0,,♬～
Dialogue: 0,0:16:47.50,0:16:49.50,Default,,0,0,0,,Хмф!
Dialogue: 0,0:16:52.01,0:16:55.84,Default,,0,0,0,,《О... өте керемет, сөз жоқ》
Dialogue: 0,0:16:55.84,0:16:57.85,Default,,0,0,0,,Хехе.
Dialogue: 0,0:16:57.85,0:17:13.29,Default,,0,0,0,,♬～
Dialogue: 0,0:17:13.29,0:17:15.30,Default,,0,0,0,,Жоқ... Кукуку жеткілікті.
Dialogue: 0,0:17:19.80,0:17:23.50,Default,,0,0,0,,Тоқтауға рұқсат етіңіз. Мен дем ала алмаймын.
Dialogue: 0,0:17:30.14,0:17:33.81,Default,,0,0,0,,Уф... Шошқа мырза, жетеді.
Dialogue: 0,0:17:33.81,0:17:36.62,Default,,0,0,0,,《Мм, осы жеткілікті ме? 》
Dialogue: 0,0:17:39.99,0:17:42.99,Default,,0,0,0,,《Онда мен соңғы шешімді қабылдаймын! 》
Dialogue: 0,0:17:42.99,0:17:45.99,Default,,0,0,0,,♬～
Dialogue: 0,0:17:45.99,0:17:52.00,Default,,0,0,0,,♬～
Dialogue: 0,0:17:54.84,0:17:56.84,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:17:56.84,0:17:59.94,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:17:59.94,0:18:04.78,Default,,0,0,0,,Керемет! Бұл керемет Эй Джесс! Ах. (күлкі)
Dialogue: 0,0:18:04.78,0:18:06.78,Default,,0,0,0,,Баланы осылай сатасың ба? (күлкі)
Dialogue: 0,0:18:06.78,0:18:10.28,Default,,0,0,0,,Бұл жақсы. «Иә» деңіз. иә. (күлкі)
Dialogue: 0,0:18:10.28,0:18:15.12,Default,,0,0,0,,Эй, сен бұл қимылды көрдің бе? Жарақат алған Хекрипонға ұқсайды.
Dialogue: 0,0:18:15.12,0:18:17.12,Default,,0,0,0,,《Гекрипон? Мен шынымен түсінбеймін ➡
Dialogue: 0,0:18:17.12,0:18:19.13,Default,,0,0,0,,Мені мазақ етіп жатқандай сезінемін.
Dialogue: 0,0:18:19.13,0:18:23.97,Default,,0,0,0,,Хахаха... Аа, мен қатты әсер алдым.
Dialogue: 0,0:18:23.97,0:18:26.80,Default,,0,0,0,,Жарайды, Джесс, маған 200 алтын керек емес.
Dialogue: 0,0:18:26.80,0:18:30.14,Default,,0,0,0,,Мына жігітті қара тізімге ауыстырайық. иә?
Dialogue: 0,0:18:30.14,0:18:32.31,Default,,0,0,0,,《О, қандай жомарт》
Dialogue: 0,0:18:32.31,0:18:34.81,Default,,0,0,0,,Мен бүгін кешке фестивальде өнер көрсетемін.
Dialogue: 0,0:18:34.81,0:18:37.98,Default,,0,0,0,,Мен бұл шошқаны пайдалану арқылы көп ақша табуға болатынын сезіндім.
Dialogue: 0,0:18:37.98,0:18:41.65,Default,,0,0,0,,《Бүгін түн... Ақша таппай тұрып қашып кетсем ше?➡
Dialogue: 0,0:18:41.65,0:18:43.99,Default,,0,0,0,,Оның ашуы Джесске бағытталған.
Dialogue: 0,0:18:43.99,0:18:47.32,Default,,0,0,0,,Бұл жаман. Бір амалды қолданып көріңіз...》 Мм.
Dialogue: 0,0:18:47.32,0:18:50.99,Default,,0,0,0,,Мен сізге фестивальге көмектесуге рұқсат етіңіз.
Dialogue: 0,0:18:50.99,0:18:53.49,Default,,0,0,0,,Сәлем Джесс! Бір минут күте тұрыңыз, содан кейін...
Dialogue: 0,0:18:53.49,0:18:56.00,Default,,0,0,0,,Мынау мен бағып жүрген шошқа.
Dialogue: 0,0:18:56.00,0:18:58.33,Default,,0,0,0,,Мен сені іс-әрекетте көргім келеді.
Dialogue: 0,0:18:58.33,0:19:00.94,Default,,0,0,0,,Біз сізге тегін қызмет көрсетеміз. 《Ха….
Dialogue: 0,0:19:00.94,0:19:04.61,Default,,0,0,0,,Мен Джесске күдіктенетін жағдайды жасағым келмеді.
Dialogue: 0,0:19:04.61,0:19:08.94,Default,,0,0,0,,Әрине. Бірақ Квилтлиндер отбасының жұмысы дұрыс па?
Dialogue: 0,0:19:08.94,0:19:13.61,Default,,0,0,0,,Сыныңызды қабылдасам, мен де кәсіппен айналыса алмаймын.
Dialogue: 0,0:19:13.61,0:19:16.45,Default,,0,0,0,,Жарайды. ....
Dialogue: 0,0:19:16.45,0:19:19.62,Default,,0,0,0,,Бүгін түнде орнына Йесма келеді.
Dialogue: 0,0:19:19.62,0:19:21.96,Default,,0,0,0,,Ах... түсіндім.
Dialogue: 0,0:19:21.96,0:19:25.79,Default,,0,0,0,,Бұл уақыт келді ме? иә?
Dialogue: 0,0:19:25.79,0:19:30.63,Default,,0,0,0,,Мен көремін. Сондықтан олар шошқа сатады. Жарайды, түсінемін.
Dialogue: 0,0:19:30.63,0:19:34.14,Default,,0,0,0,,Көру үшін өнімділікті реттеуге көмектесіңіз.
Dialogue: 0,0:19:34.14,0:19:36.30,Default,,0,0,0,,Рахмет. Олай болса➡
Dialogue: 0,0:19:36.30,0:19:39.97,Default,,0,0,0,,Күн батқанша қала алаңына келіңіз. иә!
Dialogue: 0,0:19:39.97,0:19:44.15,Default,,0,0,0,,《Кешіріңіз, Шошқа мырза. Мен өз шешімімді қабылдадым.》
Dialogue: 0,0:19:44.15,0:19:48.15,Default,,0,0,0,,Жоқ, мәселе жоқ. Тек маған қашып кетуге көмектеспе.
Dialogue: 0,0:19:48.15,0:19:50.82,Default,,0,0,0,,Джесске күдіктену қиын болар еді.
Dialogue: 0,0:19:50.82,0:19:55.49,Default,,0,0,0,,《Жақсысың ба? 》 Аа, мені кім деп ойлайсың?
Dialogue: 0,0:19:55.49,0:20:00.33,Default,,0,0,0,,《Мен көзілдірік киген қызбын, сондықтан адамдар мені сынаса, қиналып қалар едім.》
Dialogue: 0,0:20:00.33,0:20:02.50,Default,,0,0,0,,Қараңдаршы, қоштасу.
Dialogue: 0,0:20:02.50,0:20:05.67,Default,,0,0,0,,Рахмет. Көмегіңіз үшін рақмет.
Dialogue: 0,0:20:05.67,0:20:08.84,Default,,0,0,0,,Жарайды, мен ісімді аяқтаған соң келемін.
Dialogue: 0,0:20:08.84,0:20:10.84,Default,,0,0,0,,Иә. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:20:10.84,0:20:14.01,Default,,0,0,0,,《Мерекеде тағы кездескенше, шошқа.》
Dialogue: 0,0:20:14.01,0:20:16.01,Default,,0,0,0,,Аа, кездескенше.
Dialogue: 0,0:20:16.01,0:20:28.02,Default,,0,0,0,,♬～
Dialogue: 0,0:20:28.02,0:20:32.03,Default,,0,0,0,,《Енді, бұл жерден не істейміз... А? 》
Dialogue: 0,0:20:32.03,0:20:35.36,Default,,0,0,0,,Кешіріңіз, сәл үндемей тұрыңыз➡
Dialogue: 0,0:20:35.36,0:20:38.07,Default,,0,0,0,,Эй шошқа. 《Аа! 》
Dialogue: 0,0:20:43.54,0:20:48.04,Default,,0,0,0,,《Мен қара тізімді алдым, бірақ келесі қашу миссиясы...
Dialogue: 0,0:20:48.04,0:20:50.54,Default,,0,0,0,,Мен Джесстен көп ақша жоғалттым➡
Dialogue: 0,0:20:50.54,0:20:53.05,Default,,0,0,0,,Не болды...》 Шошқа!
Dialogue: 0,0:20:53.05,0:20:55.55,Default,,0,0,0,,《Мм.
Dialogue: 0,0:20:55.55,0:20:58.72,Default,,0,0,0,,Әй, бұл қызметші киімі ғой, солай емес пе?
Dialogue: 0,0:20:58.72,0:21:01.49,Default,,0,0,0,,Сонымен, сіз «Ұстаз» деген күні➡
Dialogue: 0,0:21:01.49,0:21:04.83,Default,,0,0,0,,Бұл уже бухибухи хехехехе... Иә? 》
Dialogue: 0,0:21:04.83,0:21:07.66,Default,,0,0,0,,Иә? А, міне, осы.
Dialogue: 0,0:21:07.66,0:21:09.83,Default,,0,0,0,,Ахх.
Dialogue: 0,0:21:09.83,0:21:14.03,Default,,0,0,0,,Мен сені аш шығар деп ойлап, саған әкелдім.
Dialogue: 0,0:21:16.00,0:21:19.01,Default,,0,0,0,,Ләззат алыңыз...
Dialogue: 0,0:21:19.01,0:21:22.01,Default,,0,0,0,,Мырза... Ұстаз.
Dialogue: 0,0:21:22.01,0:21:24.01,Default,,0,0,0,,《Бұй~! 》
Dialogue: 0,0:21:24.01,0:21:26.68,Default,,0,0,0,,Рахмет! Мен мұны ұнатамын! Хехе.
Dialogue: 0,0:21:26.68,0:21:30.35,Default,,0,0,0,,Уау, бұл дәмді. Мен ризамын.
Dialogue: 0,0:21:30.35,0:21:32.35,Default,,0,0,0,,Мен қашқаннан кейін Джесс➡
Dialogue: 0,0:21:32.35,0:21:35.19,Default,,0,0,0,,Кездесу орнын анықтайық. Ах.
Dialogue: 0,0:21:35.19,0:21:41.36,Default,,0,0,0,,《Бұл кездесу орны ма... мм, қайсы жақсырақ?》
Dialogue: 0,0:21:41.36,0:21:45.53,Default,,0,0,0,,Осы фестивальден кейін Джесс Килтлин сарайына орала ма?
Dialogue: 0,0:21:45.53,0:21:49.70,Default,,0,0,0,,《Иә, мен сапарға дайындалуым керек.》
Dialogue: 0,0:21:49.70,0:21:53.37,Default,,0,0,0,,Ал, сен мені бүгін таңға апарған үлкен ағаштың түбіне ше?
Dialogue: 0,0:21:53.37,0:21:55.54,Default,,0,0,0,,Таң атқанша бірдеңе жасаңыз.
Dialogue: 0,0:21:55.54,0:21:58.71,Default,,0,0,0,,Ендеше, күн шықпай тұрып кел.
Dialogue: 0,0:21:58.71,0:22:01.48,Default,,0,0,0,,《Жарайды》
Dialogue: 0,0:22:01.48,0:22:06.15,Default,,0,0,0,,Уайымдама, Джесс. Мені кім деп ойлайсың?
Dialogue: 0,0:22:06.15,0:22:09.16,Default,,0,0,0,,《Ол көзілдірік киген қыз》
Dialogue: 0,0:22:09.16,0:22:11.83,Default,,0,0,0,,《Бұл аты емес...》
Dialogue: 0,0:22:11.83,0:22:14.33,Default,,0,0,0,,Иә, мені төмендетпе.
Dialogue: 0,0:22:14.33,0:22:17.83,Default,,0,0,0,,Мен міндетті түрде қашамын, уайымдама.
Dialogue: 0,0:22:17.83,0:22:20.67,Default,,0,0,0,,《Жарайды. Мен сенемін》
Dialogue: 0,0:22:20.67,0:22:27.07,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:22:28.57,0:22:34.57,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory