Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.97,0:00:09.27,Default,,0,0,0,,《Шошқа: Бұл қайда...? 》
Dialogue: 0,0:00:11.97,0:00:14.31,Default,,0,0,0,,Няфун! 《Хмм? 》
Dialogue: 0,0:00:14.31,0:00:16.81,Default,,0,0,0,,Ах, бұл жаман.
Dialogue: 0,0:00:16.81,0:00:20.82,Default,,0,0,0,,Қуаныштымын... ояндың, шошқа.
Dialogue: 0,0:00:20.82,0:00:23.32,Default,,0,0,0,,Хмм….
Dialogue: 0,0:00:23.32,0:00:26.62,Default,,0,0,0,,《Аа, дұрыс! Мен...》
Dialogue: 0,0:00:28.66,0:00:31.49,Default,,0,0,0,,Ол жігіттің қара білегін пайдаландың ба?
Dialogue: 0,0:00:31.49,0:00:34.83,Default,,0,0,0,,Иә. Аз ғана сома қалды➡
Dialogue: 0,0:00:34.83,0:00:37.33,Default,,0,0,0,,Ол біріктірілгенде жақсы жұмыс істеді.
Dialogue: 0,0:00:37.33,0:00:41.34,Default,,0,0,0,,Листаның қалған бөлігі жазбамен бірге сарайға барады.
Dialogue: 0,0:00:41.34,0:00:44.17,Default,,0,0,0,,Хмм….
Dialogue: 0,0:00:44.17,0:00:47.18,Default,,0,0,0,,Джесс. иә.
Dialogue: 0,0:00:47.18,0:00:50.85,Default,,0,0,0,,Сізге көп рахмет. Сіздің арқаңызда мен өз өмірімді сақтап қалдым.
Dialogue: 0,0:00:50.85,0:00:52.85,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:00:54.85,0:00:58.05,Default,,0,0,0,,Мен мұны істегім келгендіктен жасадым.
Dialogue: 0,0:02:31.65,0:02:34.98,Default,,0,0,0,,Бұл Киртлидің солтүстік-шығысындағы орманда.
Dialogue: 0,0:02:34.98,0:02:37.15,Default,,0,0,0,,Сол жақтағы жолдан өтсеңіз➡
Dialogue: 0,0:02:37.15,0:02:40.82,Default,,0,0,0,,Менің ойымша, шағын ауылдар бар шығар.
Dialogue: 0,0:02:40.82,0:02:43.33,Default,,0,0,0,,Бұл сенімсіздік сияқты естіледі, бірақ➡
Dialogue: 0,0:02:43.33,0:02:48.16,Default,,0,0,0,,Сонымен патша астанасына бара аламыз ба? Иә, солтүстікке барсаңыз➡
Dialogue: 0,0:02:48.16,0:02:50.83,Default,,0,0,0,,Король астанасы көрнекті биік тауда орналасқан➡
Dialogue: 0,0:02:50.83,0:02:54.54,Default,,0,0,0,,Бір қараса айтасың дейді.
Dialogue: 0,0:02:56.51,0:03:01.44,Default,,0,0,0,,Ойлап қарасам, сіз алғаш рет саяхаттап жатырмын дедіңіз.
Dialogue: 0,0:03:01.44,0:03:04.45,Default,,0,0,0,,Жарайды. Сенің жететініңе сенімдімін.
Dialogue: 0,0:03:04.45,0:03:06.95,Default,,0,0,0,,Хмм... Түсінемін.
Dialogue: 0,0:03:06.95,0:03:09.28,Default,,0,0,0,,Олай болса, дереу кетеміз бе?
Dialogue: 0,0:03:09.28,0:03:11.79,Default,,0,0,0,,Сіз жеткілікті демалдың ба? Иә!
Dialogue: 0,0:03:13.79,0:03:18.46,Default,,0,0,0,,《Сен мені арбаға салып, жол бойы жаяу жүрдің, сондықтан мен әрең ұйықтағаныма сенімдімін.》
Dialogue: 0,0:03:18.46,0:03:20.46,Default,,0,0,0,,Джесс. Ах.
Dialogue: 0,0:03:20.46,0:03:23.13,Default,,0,0,0,,Менің арқама мінгің келе ме? иә?
Dialogue: 0,0:03:23.13,0:03:25.63,Default,,0,0,0,,《Ол мейірімді бала болғандықтан, мен жай ғана сұрадым➡
Dialogue: 0,0:03:25.63,0:03:28.47,Default,,0,0,0,,Қыңыр жүруге тырысады. Бірақ мен қазірдің өзінде➡
Dialogue: 0,0:03:28.47,0:03:31.81,Default,,0,0,0,,Мен бұл тым мейірімді қызды қалай ұстау керектігін түсіне бастадым.
Dialogue: 0,0:03:31.81,0:03:35.14,Default,,0,0,0,,Аяғы жалаңаш сүйкімді қыздың атқа мінуі➡
Dialogue: 0,0:03:35.14,0:03:39.05,Default,,0,0,0,,Бұл менің кішкентай кезімнен арманым. Ах...
Dialogue: 0,0:03:42.32,0:03:44.65,Default,,0,0,0,,Бұл жол түзу, солай ма?
Dialogue: 0,0:03:44.65,0:03:49.16,Default,,0,0,0,,Жарайды, ой... жақсы шығар.
Dialogue: 0,0:03:49.16,0:03:54.00,Default,,0,0,0,,Не болды? Өзіңізді нашар сезінесіз бе? Жоқ...
Dialogue: 0,0:03:54.00,0:03:59.00,Default,,0,0,0,,Мені алғаш рет шошқа көтеріп жүр, сондықтан...
Dialogue: 0,0:03:59.00,0:04:03.77,Default,,0,0,0,,Хм... бұл өте қытық.
Dialogue: 0,0:04:03.77,0:04:06.61,Default,,0,0,0,,Өтті...?
Dialogue: 0,0:04:06.61,0:04:09.28,Default,,0,0,0,,Эй... жоқ, жоқ, жоқ, жоқ! Сен не істеп жатырсың!
Dialogue: 0,0:04:09.28,0:04:12.45,Default,,0,0,0,,Мен қалай отыруды білмеймін! Қалай отырасың...?
Dialogue: 0,0:04:12.45,0:04:15.95,Default,,0,0,0,,Иә, кешіріңіз. Мен жеткілікті қамқорлық танытпадым.
Dialogue: 0,0:04:15.95,0:04:19.79,Default,,0,0,0,,Жоқ, мен шыдай алмаймын деген сөз емес.
Dialogue: 0,0:04:19.79,0:04:23.46,Default,,0,0,0,,Бұл біртүрлі сезіледі. 《Тоқта!
Dialogue: 0,0:04:23.46,0:04:26.29,Default,,0,0,0,,Тоқтаңыз! Жіңішке кітаптағыдай жолдармен➡
Dialogue: 0,0:04:26.29,0:04:29.30,Default,,0,0,0,,Қыз екеуміздің арамыздағы бақытты уақытты бұзбаңдар! 》
Dialogue: 0,0:04:29.30,0:04:31.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:31.30,0:04:34.14,Default,,0,0,0,,Келесі жолы салмағыңызды қолыңызда ұстап, атқа мініп көріңіз.
Dialogue: 0,0:04:34.14,0:04:36.97,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:04:36.97,0:04:40.81,Default,,0,0,0,,Сіз қалай ойлайсыз? Мм... әлі де...
Dialogue: 0,0:04:40.81,0:04:43.15,Default,,0,0,0,,Менің омыртқам... Мм.
Dialogue: 0,0:04:43.15,0:04:46.48,Default,,0,0,0,,《Ой! Бұл бейкүнә қызды алғаш рет оқыту➡
Dialogue: 0,0:04:46.48,0:04:48.98,Default,,0,0,0,,Бұл менің арқа сүйегім болмауы керек! 》
Dialogue: 0,0:04:48.98,0:04:51.49,Default,,0,0,0,,Одан әрі артқа отырыңыз.
Dialogue: 0,0:04:51.49,0:04:54.82,Default,,0,0,0,,Санның дәл алдында. Мені аяғыңыздың арасына мықтап ұстаңыз.
Dialogue: 0,0:04:54.82,0:04:58.16,Default,,0,0,0,,Кеттік.
Dialogue: 0,0:04:58.16,0:05:00.76,Default,,0,0,0,,А, бұл жақсы.
Dialogue: 0,0:05:00.76,0:05:03.60,Default,,0,0,0,,《Жарайды, ақырында... Әй! ? 》
Dialogue: 0,0:05:03.60,0:05:09.44,Default,,0,0,0,,Эй... бұл не? Бізді нысанаға алып жатқан жоқ па?
Dialogue: 0,0:05:09.44,0:05:13.28,Default,,0,0,0,,Жарайды. Бұл Хекрипон деген жануар.
Dialogue: 0,0:05:13.28,0:05:15.28,Default,,0,0,0,,Хекрипон….
Dialogue: 0,0:05:15.28,0:05:18.11,Default,,0,0,0,,Аа, тізімдік дүкендегі жігіт осылай деді.
Dialogue: 0,0:05:18.11,0:05:21.12,Default,,0,0,0,,Мен ештеңе істеген жоқпын, әрі қарай жүрейік.
Dialogue: 0,0:05:21.12,0:05:23.62,Default,,0,0,0,,Ах... а.
Dialogue: 0,0:05:23.62,0:05:28.29,Default,,0,0,0,,Мен болған жерде мұндай жануарды ешқашан көрген емеспін.
Dialogue: 0,0:05:28.29,0:05:30.29,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:05:30.29,0:05:32.96,Default,,0,0,0,,Бұл Местерияда өте кең таралған тіршілік иесі.
Dialogue: 0,0:05:32.96,0:05:37.13,Default,,0,0,0,,Зұлмат ғасыр аяқталғаннан кейін бұл сан кенеттен көбейе бастағанға ұқсайды.
Dialogue: 0,0:05:37.13,0:05:41.64,Default,,0,0,0,,Біртүрлі қауесет ешқашан тоқтамайды. Біртүрлі өсек дегенді қалай түсінесіңдер?
Dialogue: 0,0:05:41.64,0:05:43.97,Default,,0,0,0,,Әртүрлі аңыздар бар.
Dialogue: 0,0:05:43.97,0:05:46.98,Default,,0,0,0,,Кейбір аймақтар сәттілік әкеледі➡ дейді
Dialogue: 0,0:05:46.98,0:05:50.81,Default,,0,0,0,,Кейбір аймақтарда біреумен кездесу сәтсіздікке әкеледі дейді.
Dialogue: 0,0:05:50.81,0:05:53.48,Default,,0,0,0,,Хехе, соңында солай➡
Dialogue: 0,0:05:53.48,0:05:56.65,Default,,0,0,0,,Менің ойымша, Хекрипон ештеңе істеген жоқ.
Dialogue: 0,0:05:56.65,0:05:59.82,Default,,0,0,0,,Сөйлескенде көңілді жүрген сияқтысың. иә.
Dialogue: 0,0:05:59.82,0:06:02.26,Default,,0,0,0,,Мен тарих пен фольклорды жақсы көремін!
Dialogue: 0,0:06:02.26,0:06:05.76,Default,,0,0,0,,Мен сенің кітап оқитыныңды естідім, бірақ сенің де қолыңнан келеді ме деп ойлаймын.
Dialogue: 0,0:06:05.76,0:06:09.10,Default,,0,0,0,,Мм, бұл жақсы хобби деп ойлаймын. солай ма?
Dialogue: 0,0:06:09.10,0:06:11.93,Default,,0,0,0,,Шошқалардың да хоббиі бар ма?
Dialogue: 0,0:06:11.93,0:06:15.60,Default,,0,0,0,,《Күнделікті өмірдегі аниме көргенде сұлу қызға айтатын сөздер.
Dialogue: 0,0:06:15.60,0:06:17.61,Default,,0,0,0,,I can't really say that.
Dialogue: 0,0:06:17.61,0:06:19.61,Default,,0,0,0,,I also like reading.
Dialogue: 0,0:06:19.61,0:06:22.61,Default,,0,0,0,,Сондай-ақ, менің соңғы құмарлығым арамшөптерді жеуді салыстыру.
Dialogue: 0,0:06:22.61,0:06:26.62,Default,,0,0,0,,Әдемі қыздардың әңгімелері сізге ұнай ма?
Dialogue: 0,0:06:26.62,0:06:29.78,Default,,0,0,0,,Иә, бұл монолог. Ха!
Dialogue: 0,0:06:29.78,0:06:33.12,Default,,0,0,0,,Ха... Жұмбақ дегеннің не екенін түсіндің бе?
Dialogue: 0,0:06:33.12,0:06:35.12,Default,,0,0,0,,Маған жұмбақтарды шешетін әңгімелер ұнайды.
Dialogue: 0,0:06:35.12,0:06:37.96,Default,,0,0,0,,Оқиға бойына шашыраңқы болған ұсақ-түйек дәлелдерден➡
Dialogue: 0,0:06:37.96,0:06:40.96,Default,,0,0,0,,Бір таңғаларлық фактіге әкелетін оқиға.
Dialogue: 0,0:06:40.96,0:06:43.80,Default,,0,0,0,,Ондай оқу материалы бар!
Dialogue: 0,0:06:43.80,0:06:46.64,Default,,0,0,0,,Алда көп жол бар сияқты. Мен сенімен жолда сөйлесемін.
Dialogue: 0,0:06:46.64,0:06:49.64,Default,,0,0,0,,Бұл рас па! Мен оны асыға күтемін.
Dialogue: 0,0:06:49.64,0:06:52.14,Default,,0,0,0,,А, мүмкін➡
Dialogue: 0,0:06:52.14,0:06:55.31,Default,,0,0,0,,Шошқалар көп нәрсені байқайды ➡
Dialogue: 0,0:06:55.31,0:06:58.81,Default,,0,0,0,,Сол жұмбақты оқығандықтан ба?
Dialogue: 0,0:06:58.81,0:07:01.75,Default,,0,0,0,,Мүмкін солай шығар. Жақсы➡
Dialogue: 0,0:07:01.75,0:07:05.59,Default,,0,0,0,,Бұл ішінара ұсақ-түйектерге алаңдайтын жаман әдетімнен деп ойлаймын.
Dialogue: 0,0:07:05.59,0:07:10.26,Default,,0,0,0,,Сонымен... шошқадан ештеңе жасыра алмайсың.
Dialogue: 0,0:07:10.26,0:07:13.93,Default,,0,0,0,,Жоқ, жасыратын нәрсең болса, оны жасыра аласың.
Dialogue: 0,0:07:13.93,0:07:17.77,Default,,0,0,0,,Джесс менің ішкі дауысымды елемейтіндей➡
Dialogue: 0,0:07:17.77,0:07:21.94,Default,,0,0,0,,Мен тіпті Джесс сенің білгеніңді қаламайтын нәрселерге араласпаймын.
Dialogue: 0,0:07:21.94,0:07:25.27,Default,,0,0,0,,《Біраз уақыт бұрын қара тізімді сатып алып жатқанымда, сені кездестірдім➡
Dialogue: 0,0:07:25.27,0:07:27.78,Default,,0,0,0,,Неге маған бұл туралы айтпадың?
Dialogue: 0,0:07:27.78,0:07:31.11,Default,,0,0,0,,Егер мен бұл сапарға шықсам, мен Килтлиндер отбасына оралмаймын➡
Dialogue: 0,0:07:31.11,0:07:33.11,Default,,0,0,0,,Неліктен тапсырма орындаймын деп өтірік айттыңыз?
Dialogue: 0,0:07:33.11,0:07:35.12,Default,,0,0,0,,Басқа да нәрселер бар➡
Dialogue: 0,0:07:35.12,0:07:37.62,Default,,0,0,0,,Мен мұның ешқайсысы туралы білмегенім жақсы нәрсе деп ойлаймын.
Dialogue: 0,0:07:39.62,0:07:41.62,Default,,0,0,0,,Ум...
Dialogue: 0,0:07:43.63,0:07:45.63,Default,,0,0,0,,Шошқа мырза….
Dialogue: 0,0:07:45.63,0:07:49.96,Default,,0,0,0,,Менің әңгімемді тыңдасаң да, менімен бірге патша астанасына барасың➡
Dialogue: 0,0:07:49.96,0:07:52.47,Default,,0,0,0,,Маған осылай уәде бере аласыз ба?
Dialogue: 0,0:07:52.47,0:07:54.80,Default,,0,0,0,,Әрине. Болмаса ➡
Dialogue: 0,0:07:54.80,0:07:58.47,Default,,0,0,0,,Өмірімнің соңына дейін шошқа болып өмір сүруден басқа амалым жоқ.
Dialogue: 0,0:07:58.47,0:08:01.08,Default,,0,0,0,,Дұрыс. Ах!
Dialogue: 0,0:08:08.25,0:08:12.09,Default,,0,0,0,,Мен шешім қабылдадым. Мен сөйлесемін.
Dialogue: 0,0:08:12.09,0:08:14.09,Default,,0,0,0,,Мен де бір шешімге келдім.
Dialogue: 0,0:08:14.09,0:08:16.26,Default,,0,0,0,,Не естісем де, қорықпаймын.
Dialogue: 0,0:08:16.26,0:08:18.26,Default,,0,0,0,,Уайымдамаңыз.
Dialogue: 0,0:08:22.10,0:08:25.93,Default,,0,0,0,,Мен патша астанасына өзімді құрбан етуге бара жатырмын.
Dialogue: 0,0:08:25.93,0:08:28.77,Default,,0,0,0,,Иә? Болмаса ➡
Dialogue: 0,0:08:28.77,0:08:31.11,Default,,0,0,0,,Жолда өлу. иә?
Dialogue: 0,0:08:31.11,0:08:33.31,Default,,0,0,0,,Бұл Есманың тағдыры.
Dialogue: 0,0:08:37.28,0:08:41.95,Default,,0,0,0,,Местерияда 16 жасқа толған Джесма өзі жұмыс істеген үйден шығып кетті➡
Dialogue: 0,0:08:41.95,0:08:45.29,Default,,0,0,0,,Король астанасына өз бетімен бару заңдылық.
Dialogue: 0,0:08:45.29,0:08:48.46,Default,,0,0,0,,Көбісі жолда өледі.
Dialogue: 0,0:08:48.46,0:08:50.96,Default,,0,0,0,,Есма патша астанасына келді➡
Dialogue: 0,0:08:50.96,0:08:53.96,Default,,0,0,0,,Сіз ешқашан бастапқы орныңызға оралмайсыз.
Dialogue: 0,0:08:53.96,0:08:56.63,Default,,0,0,0,,Патша астанасына келгенде не болады?
Dialogue: 0,0:08:56.63,0:09:00.24,Default,,0,0,0,,Жерде не...? Түрлі қауесеттер бар➡
Dialogue: 0,0:09:00.24,0:09:03.24,Default,,0,0,0,,Шындығында ешкім білмейді.
Dialogue: 0,0:09:03.24,0:09:06.57,Default,,0,0,0,,Король астанасы әлемнің қалған бөлігінен толығымен оқшауланған➡
Dialogue: 0,0:09:06.57,0:09:09.58,Default,,0,0,0,,Ішінде не бар екенін ешкім білмейді.
Dialogue: 0,0:09:09.58,0:09:14.08,Default,,0,0,0,,Пиг-сан, мен неге қашып кету үшін сарайдан шықтым?➡
Dialogue: 0,0:09:14.08,0:09:16.58,Default,,0,0,0,,Сіз қызықсыз ба? Аа….
Dialogue: 0,0:09:16.58,0:09:21.26,Default,,0,0,0,,Мен жауап беремін. Менде мына күміс жаға бар.
Dialogue: 0,0:09:21.26,0:09:24.76,Default,,0,0,0,,Бұған зор сиқырлы күш құйылды➡
Dialogue: 0,0:09:24.76,0:09:27.10,Default,,0,0,0,,Ол өте жоғары бағаға сатылады.
Dialogue: 0,0:09:27.10,0:09:30.27,Default,,0,0,0,,Ал бұл жаға сиқырмен қорғалған➡
Dialogue: 0,0:09:30.27,0:09:34.27,Default,,0,0,0,,Басын кесіп алмайынша оны алу мүмкін емес.
Dialogue: 0,0:09:34.27,0:09:40.28,Default,,0,0,0,,Ал Йесманың денесін, оның ішінде сүйектерін де арзан емес бағаға сатуға болады.
Dialogue: 0,0:09:40.28,0:09:43.78,Default,,0,0,0,,Әулет Килтлиндер отбасына кесімді ➡ төледі
Dialogue: 0,0:09:43.78,0:09:47.12,Default,,0,0,0,,Мен қызметші болуды қойған сәттен бастап➡ болдым
Dialogue: 0,0:09:47.12,0:09:49.78,Default,,0,0,0,,Есманы өлтіру арқылы ақша табу➡
Dialogue: 0,0:09:49.78,0:09:52.99,Default,,0,0,0,,Бұл сізді «Йесума аңы» қуып жіберетінін білдіреді.
Dialogue: 0,0:09:56.29,0:10:00.46,Default,,0,0,0,,Әрине, Килтлиндер отбасы мейірімді адамдар➡
Dialogue: 0,0:10:00.46,0:10:04.30,Default,,0,0,0,,Сіз мені ақшаға сатуды ойламас едіңіз.
Dialogue: 0,0:10:04.30,0:10:06.97,Default,,0,0,0,,Бірақ мен, Киринсу мырза➡
Dialogue: 0,0:10:06.97,0:10:10.14,Default,,0,0,0,,Мен оған бүгін кеткен күнім екенін айттым.
Dialogue: 0,0:10:10.14,0:10:14.48,Default,,0,0,0,,Киринсу мырза да өте жақсы адам➡
Dialogue: 0,0:10:14.48,0:10:18.15,Default,,0,0,0,,Біз ақпараттың қашан және қалай тарайтынын білмейміз.
Dialogue: 0,0:10:18.15,0:10:22.65,Default,,0,0,0,,Сондықтан мен бұл орманға, мүмкіндігінше зәулім үйден алысырақ тығылдым.
Dialogue: 0,0:10:22.65,0:10:27.32,Default,,0,0,0,,《Бұл дүниеде не болып жатыр?》
Dialogue: 0,0:10:27.32,0:10:29.32,Default,,0,0,0,,Шошқа мырза. Ах...
Dialogue: 0,0:10:29.32,0:10:32.16,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:10:32.16,0:10:34.50,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:34.50,0:10:36.50,Default,,0,0,0,,Ах.
Dialogue: 0,0:10:36.50,0:10:40.50,Default,,0,0,0,,Осындай бұрмаланған әлемде Джесс сияқты мейірімді бала зардап шегеді➡
Dialogue: 0,0:10:40.50,0:10:42.67,Default,,0,0,0,,Мен жай отыра алмаймын.
Dialogue: 0,0:10:42.67,0:10:44.67,Default,,0,0,0,,Мен патша астанасына барамын.
Dialogue: 0,0:10:44.67,0:10:48.01,Default,,0,0,0,,Мен жай ғана шошқамын. Мен қылыш пен сиқырды қолдана алмаймын ➡
Dialogue: 0,0:10:48.01,0:10:52.01,Default,,0,0,0,,Джессті барлық ақыл-ойыңызбен қорғаңыз. Біз мәңгі бірге болдық.
Dialogue: 0,0:10:52.01,0:10:55.02,Default,,0,0,0,,Джесс астанаға келгенше, аяғының астында осылай➡
Dialogue: 0,0:10:55.02,0:10:57.02,Default,,0,0,0,,Мен оны өте жақсы ұстанамын.
Dialogue: 0,0:11:00.62,0:11:04.46,Default,,0,0,0,,《Жақсы бірдеңе айтайын деп жатып, тайып кеттім бе?》
Dialogue: 0,0:11:04.46,0:11:09.30,Default,,0,0,0,,Дәретханаға барғанда менен аулақ жүрші, хехе.
Dialogue: 0,0:11:09.30,0:11:11.30,Default,,0,0,0,,《Қандай мықты бала.
Dialogue: 0,0:11:11.30,0:11:15.47,Default,,0,0,0,,Тағдырдың қатыгездігімен бетпе-бет келсе де, жарайсың дегендей күлесің.
Dialogue: 0,0:11:15.47,0:11:18.57,Default,,0,0,0,,Менен құпияны осылай жасырдың.
Dialogue: 0,0:11:20.81,0:11:25.48,Default,,0,0,0,,《Джесстің тағдырынан қорқып қашып кетемін деп ойладым.
Dialogue: 0,0:11:25.48,0:11:27.48,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:11:27.48,0:11:30.32,Default,,0,0,0,,Шошқа болып, бұл дүниеге келу себебім➡
Dialogue: 0,0:11:30.32,0:11:32.32,Default,,0,0,0,,Мен түсіндім деп ойлаймын.
Dialogue: 0,0:11:32.32,0:11:34.32,Default,,0,0,0,,Шынымен...?
Dialogue: 0,0:11:34.32,0:11:36.32,Default,,0,0,0,,｟Мүмкін бұл тағдыр｠
Dialogue: 0,0:11:38.33,0:11:41.83,Default,,0,0,0,,Джесспен астанаға барыңыз және олар сізді адамдарға қайтарсын.
Dialogue: 0,0:11:41.83,0:11:44.00,Default,,0,0,0,,Осындай тағдырдың жолын табу үшін➡
Dialogue: 0,0:11:44.00,0:11:48.84,Default,,0,0,0,,Мен сенің кетеріңнен бір күн бұрын шошқа қорасына келген жоқпын ба?
Dialogue: 0,0:11:48.84,0:11:50.84,Default,,0,0,0,,Иә….
Dialogue: 0,0:11:50.84,0:11:52.84,Default,,0,0,0,,Тағдырымыз ортақ.
Dialogue: 0,0:11:52.84,0:11:55.68,Default,,0,0,0,,Кем дегенде, біз патша астанасына дейін бірге боламыз.
Dialogue: 0,0:11:55.68,0:11:57.68,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:12:06.79,0:12:09.79,Default,,0,0,0,,《Сен әбден шаршаған сияқтысың.
Dialogue: 0,0:12:09.79,0:12:12.46,Default,,0,0,0,,Есуманы аулау... иә?
Dialogue: 0,0:12:12.46,0:12:15.46,Default,,0,0,0,,Бүкіл Джесма патша астанасына сапарға аттанды.\NЕгер
Dialogue: 0,0:12:15.46,0:12:20.64,Default,,0,0,0,,деп алсақ, Йесуманы аулауға арналған жұмыс орны сөзсіз патша астанасының айналасында болады.
Dialogue: 0,0:12:20.64,0:12:24.81,Default,,0,0,0,,Басқаша айтқанда, біз бұл сапардың мақсатына жақындаған сайын, патша астанасы➡
Dialogue: 0,0:12:24.81,0:12:26.81,Default,,0,0,0,,Барған сайын қауіпті болып барады》
Dialogue: 0,0:12:26.81,0:12:28.81,Default,,0,0,0,,(Жапырақтардың сыбдыры)
Dialogue: 0,0:12:30.81,0:12:32.81,Default,,0,0,0,,Хаа….
Dialogue: 0,0:12:36.65,0:12:41.16,Default,,0,0,0,,《Джесс жүрегіндегі дауыстарды естиді. Сосын ойлайтын шошқалар бар.
Dialogue: 0,0:12:41.16,0:12:43.83,Default,,0,0,0,,Осы қаруды барынша пайдаланыңыз➡
Dialogue: 0,0:12:43.83,0:12:46.10,Default,,0,0,0,,Біз өзіміздің орынсыз тағдырымызға қарсы тұруымыз керек.
Dialogue: 0,0:12:46.10,0:12:49.50,Default,,0,0,0,,Король астанасына аман-есен жетті➡
Dialogue: 0,0:12:49.50,0:12:52.17,Default,,0,0,0,,Мен сенен ұлы патша кім екенін сұраймын.
Dialogue: 0,0:12:52.17,0:12:54.84,Default,,0,0,0,,Неліктен Йесмалар бейбіт өмір сүреді➡
Dialogue: 0,0:12:54.84,0:12:57.51,Default,,0,0,0,,Неге мені кешірмейсің?
Dialogue: 0,0:12:57.51,0:13:00.78,Default,,0,0,0,,Менің қаным дәл қазір миссия сезімімен өртеніп жатыр.
Dialogue: 0,0:13:00.78,0:13:03.78,Default,,0,0,0,,Мен рычагтың да жақсы қыздырылғанына сенімдімін.
Dialogue: 0,0:13:03.78,0:13:06.95,Default,,0,0,0,,Менің арқамда ұйықтап жатқан бейкүнә қызға➡
Dialogue: 0,0:13:06.95,0:13:10.25,Default,,0,0,0,,Шын жүрегіңмен ойла, шошқа! 》
Dialogue: 0,0:13:13.96,0:13:15.96,Default,,0,0,0,,Джесс Оян, Джесс.
Dialogue: 0,0:13:15.96,0:13:18.13,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:13:18.13,0:13:22.80,Default,,0,0,0,,Кешіріңіз, мен ұйықтап қалдым.
Dialogue: 0,0:13:22.80,0:13:25.80,Default,,0,0,0,,Күміс жағаң, бұл Есманың➡
Dialogue: 0,0:13:25.80,0:13:27.97,Default,,0,0,0,,Бұл сәйкестік пе? иә.
Dialogue: 0,0:13:27.97,0:13:32.47,Default,,0,0,0,,Егер мен оны жасырсам, адамдар менің Есма екенімді біліп, нысанаға түсуімді қиындатпай ма?
Dialogue: 0,0:13:32.47,0:13:35.14,Default,,0,0,0,,Расында да... дұрыс.
Dialogue: 0,0:13:35.14,0:13:38.98,Default,,0,0,0,,Онда неге орамал сатып алмайсың? А... иә!
Dialogue: 0,0:13:38.98,0:13:41.82,Default,,0,0,0,,Сондай-ақ ауылда дауыстап айтпай сөйлесуге тырысыңыз.
Dialogue: 0,0:13:41.82,0:13:43.82,Default,,0,0,0,,《Жарайды.
Dialogue: 0,0:13:43.82,0:13:47.49,Default,,0,0,0,,Орамалдар өте көп.
Dialogue: 0,0:13:47.49,0:13:49.49,Default,,0,0,0,,Сізге қайсысы көбірек сәйкес келеді деп ойлайсыз? 》
Dialogue: 0,0:13:49.49,0:13:52.99,Default,,0,0,0,,Жағаңызды жасыруға тырысып жатқаныңызды көрсетпеңіз.
Dialogue: 0,0:13:52.99,0:13:56.33,Default,,0,0,0,,Керісінше, бұл оның Есма екенін алға тартуы мүмкін.
Dialogue: 0,0:13:56.33,0:13:59.33,Default,,0,0,0,,Терінің түсіне жақынын таңдаған дұрыс деп ойлаймын.
Dialogue: 0,0:13:59.33,0:14:02.10,Default,,0,0,0,,《Аа... дұрыс.
Dialogue: 0,0:14:02.10,0:14:07.61,Default,,0,0,0,,Кешіріңіз》》《Аа... мен отакумын.
Dialogue: 0,0:14:07.61,0:14:10.28,Default,,0,0,0,,Джесс көңілді болып көрінсе де➡
Dialogue: 0,0:14:10.28,0:14:13.61,Default,,0,0,0,,Бұл атмосфераны бұзады емес пе》
Dialogue: 0,0:14:13.61,0:14:15.62,Default,,0,0,0,,Жоқ, күте тұрыңыз.
Dialogue: 0,0:14:15.62,0:14:18.12,Default,,0,0,0,,Теріңіздің түсіне сәйкес шарф кисеңіз➡
Dialogue: 0,0:14:18.12,0:14:20.46,Default,,0,0,0,,Мен оған жақыннан қарасам, ол өте күдікті болып көрінді.
Dialogue: 0,0:14:20.46,0:14:23.46,Default,,0,0,0,,Түзету. Джесске сәйкес келетінін таңдаңыз.
Dialogue: 0,0:14:23.46,0:14:25.46,Default,,0,0,0,,《Уау….
Dialogue: 0,0:14:25.46,0:14:28.63,Default,,0,0,0,,Олай болса шошқа таңдасын》 Ха!
Dialogue: 0,0:14:28.63,0:14:31.80,Default,,0,0,0,,《Мен өзімнің шынайы құндылығымды көрсететін уақыт келді.
Dialogue: 0,0:14:31.80,0:14:35.30,Default,,0,0,0,,Қызы болмаған адаммен құрдас, көзілдірік киген пәк қыз.
Dialogue: 0,0:14:35.30,0:14:38.97,Default,,0,0,0,,Дәл осы жерде біз хино шалбары мен көйлектер туралы кең білімімізді пайдаланамыз➡
Dialogue: 0,0:14:38.97,0:14:42.48,Default,,0,0,0,,16 жастағы әдемі аққұба қызды таңдайық➡
Dialogue: 0,0:14:42.48,0:14:44.48,Default,,0,0,0,,Сізге ең қолайлы шарфты таңдаңыз! 》
Dialogue: 0,0:14:46.48,0:14:48.48,Default,,0,0,0,,Хмм….
Dialogue: 0,0:14:48.48,0:14:53.32,Default,,0,0,0,,《Кез келген шарф Джесске жақсы көрінеді.
Dialogue: 0,0:14:53.32,0:14:56.82,Default,,0,0,0,,Менің қазіргі киімім ашық көк көйлек.
Dialogue: 0,0:14:56.82,0:14:59.83,Default,,0,0,0,,Көк орамал тақсаң, алыстан да білінбейді.
Dialogue: 0,0:14:59.83,0:15:02.60,Default,,0,0,0,,Бірақ сол түстің дәмі жоқ екені анық.
Dialogue: 0,0:15:02.60,0:15:04.60,Default,,0,0,0,,Егер...》
Dialogue: 0,0:15:04.60,0:15:07.10,Default,,0,0,0,,Ашық жасыл түс ше?
Dialogue: 0,0:15:07.10,0:15:10.94,Default,,0,0,0,,《Осы әдемі таяз көлдің түсі ме? 》
Dialogue: 0,0:15:10.94,0:15:12.94,Default,,0,0,0,,Иә.
Dialogue: 0,0:15:12.94,0:15:16.78,Default,,0,0,0,,《Сен қалай ойлайсың? Бұл сізге жақсы көрінеді ме? 》 Менің ойымша, бұл сізге сәйкес келеді.
Dialogue: 0,0:15:16.78,0:15:20.48,Default,,0,0,0,,《Рахмет. Мен оны сатып аламын.》
Dialogue: 0,0:15:22.95,0:15:25.45,Default,,0,0,0,,《“Әдемі таяз көл”…?
Dialogue: 0,0:15:25.45,0:15:29.29,Default,,0,0,0,,Мен мұны ешқашан айта алмаймын деп ойлаймын.
Dialogue: 0,0:15:29.29,0:15:31.29,Default,,0,0,0,,Ах.
Dialogue: 0,0:15:36.63,0:15:38.63,Default,,0,0,0,,Хмм.
Dialogue: 0,0:15:47.31,0:15:49.64,Default,,0,0,0,,《Сізді күткенім үшін кешіріңіз~》
Dialogue: 0,0:15:49.64,0:15:51.85,Default,,0,0,0,,Эхехе….
Dialogue: 0,0:15:55.98,0:15:57.99,Default,,0,0,0,,Мм... Кешіріңіз...
Dialogue: 0,0:16:03.09,0:16:05.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:07.09,0:16:09.76,Default,,0,0,0,,А... А...
Dialogue: 0,0:16:09.76,0:16:13.10,Default,,0,0,0,,Сәлем, қыз.
Dialogue: 0,0:16:13.10,0:16:15.60,Default,,0,0,0,,Ұзақ жолдан шаршаған сияқтысың.
Dialogue: 0,0:16:15.60,0:16:19.11,Default,,0,0,0,,Сіз аш болуыңыз керек. Е... дұрыс.
Dialogue: 0,0:16:19.11,0:16:21.28,Default,,0,0,0,,Аа... Церес!
Dialogue: 0,0:16:21.28,0:16:23.28,Default,,0,0,0,,Иә. (есіктің ашылған дыбысы)
Dialogue: 0,0:16:23.28,0:16:27.28,Default,,0,0,0,,Буға пісірілген орамал мен қарапайым тағам дайындаңыз. иә?
Dialogue: 0,0:16:27.28,0:16:29.95,Default,,0,0,0,,Иә, мен ақылдымын.
Dialogue: 0,0:16:29.95,0:16:32.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:36.12,0:16:38.13,Default,,0,0,0,,Уф… жас ханым➡
Dialogue: 0,0:16:38.13,0:16:41.96,Default,,0,0,0,,Осы жерден аңғарды кесіп өтесіз бе, Киртлиге өтесіз бе➡
Dialogue: 0,0:16:41.96,0:16:45.13,Default,,0,0,0,,Біз келесі қалаға жеткенше күн батып бара жатыр.
Dialogue: 0,0:16:45.13,0:16:47.64,Default,,0,0,0,,Мен түнеп қалсам қалай болады? Ах...
Dialogue: 0,0:16:47.64,0:16:50.14,Default,,0,0,0,,Өтінемін.
Dialogue: 0,0:16:50.14,0:16:55.48,Default,,0,0,0,,Оны қолданыңыз. Сіздің мейірімділігіңіз үшін рахмет.
Dialogue: 0,0:16:55.48,0:16:57.65,Default,,0,0,0,,Сіз Киртлиденсіз бе?
Dialogue: 0,0:16:57.65,0:16:59.65,Default,,0,0,0,,Есманың қызы. Ах...
Dialogue: 0,0:16:59.65,0:17:02.08,Default,,0,0,0,,Иә. Ха! ?
Dialogue: 0,0:17:02.08,0:17:04.09,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:17:04.09,0:17:06.59,Default,,0,0,0,,Сіз қазір патша астанасына барасыз ба? Иә.
Dialogue: 0,0:17:06.59,0:17:10.93,Default,,0,0,0,,Дұрыс. Эй, сен тым бейқам емессің бе?
Dialogue: 0,0:17:10.93,0:17:12.93,Default,,0,0,0,,Хмм... А! ?
Dialogue: 0,0:17:12.93,0:17:15.10,Default,,0,0,0,,Джесс, қашайық. Ах...
Dialogue: 0,0:17:15.10,0:17:17.10,Default,,0,0,0,,Есманың жағасы қабырғада ілулі тұр!
Dialogue: 0,0:17:17.10,0:17:21.10,Default,,0,0,0,,《Аа... Жарайды》 Иә?
Dialogue: 0,0:17:21.10,0:17:24.94,Default,,0,0,0,,Бұл кімдікі?
Dialogue: 0,0:17:24.94,0:17:28.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:28.94,0:17:32.78,Default,,0,0,0,,Мынау Есманың жағасы, Ыс.
Dialogue: 0,0:17:32.78,0:17:36.12,Default,,0,0,0,,Бұл бала... Церераның ізашары➡
Dialogue: 0,0:17:36.12,0:17:41.96,Default,,0,0,0,,Мен осында жұмыс істедім. Бұл... өкінішті.
Dialogue: 0,0:17:41.96,0:17:45.63,Default,,0,0,0,,И мырза қай жерде қайтыс болды?
Dialogue: 0,0:17:45.63,0:17:47.96,Default,,0,0,0,,Біз➡
Dialogue: 0,0:17:47.96,0:17:51.13,Default,,0,0,0,,Есума мен оның достары 16 жасын тойлады➡
Dialogue: 0,0:17:51.13,0:17:54.30,Default,,0,0,0,,Мен бірде монастырда тығылғанмын.
Dialogue: 0,0:17:54.30,0:17:57.47,Default,,0,0,0,,Мүмкін Вапсус монастырьі шығар?
Dialogue: 0,0:17:57.47,0:18:02.08,Default,,0,0,0,,Сіз білесіз бе? Дұрыс, бұл ауыл бап сасу.
Dialogue: 0,0:18:02.08,0:18:07.58,Default,,0,0,0,,Түсінемін... Негізі мен Килтлиндер отбасында жұмыс істеймін.
Dialogue: 0,0:18:07.58,0:18:09.58,Default,,0,0,0,,Бұл оқиға туралы есту➡
Dialogue: 0,0:18:09.58,0:18:12.59,Default,,0,0,0,,Жас болсам да, есеңгіреп қалғаным есімде.
Dialogue: 0,0:18:12.59,0:18:14.59,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:18:16.76,0:18:21.26,Default,,0,0,0,,Килтлиндер отбасынан шыққан Йесма. Онда іліп қойыңыз.
Dialogue: 0,0:18:25.93,0:18:28.10,Default,,0,0,0,,Боп суспензиясы туралы айту➡
Dialogue: 0,0:18:28.10,0:18:32.11,Default,,0,0,0,,И мырза өртте өлді ме?
Dialogue: 0,0:18:32.11,0:18:34.11,Default,,0,0,0,,А... жоқ.
Dialogue: 0,0:18:34.11,0:18:37.45,Default,,0,0,0,,Оны Йесуманы аулауға апарды. Аа….
Dialogue: 0,0:18:37.45,0:18:41.95,Default,,0,0,0,,Мен оның өлтірілгенге дейін қатты азап шеккеніне сенімдімін.
Dialogue: 0,0:18:41.95,0:18:44.12,Default,,0,0,0,,Сонымен, бұл жаға ше?
Dialogue: 0,0:18:44.12,0:18:47.62,Default,,0,0,0,,Аңшылардың бірі оны Йесуманы аулаудан қайтарып алды.
Dialogue: 0,0:18:47.62,0:18:51.13,Default,,0,0,0,,Осы ауылдың мақтанышы. Бұл дұрыс.
Dialogue: 0,0:18:51.13,0:18:54.13,Default,,0,0,0,,《Ол жаға жаман емес➡
Dialogue: 0,0:18:54.13,0:18:57.63,Default,,0,0,0,,Егер бірдеңе болса, бұл Джесс үшін сенімділік көзі сияқты》
Dialogue: 0,0:18:57.63,0:19:00.23,Default,,0,0,0,,Иә? Ах.
Dialogue: 0,0:19:00.23,0:19:02.74,Default,,0,0,0,,《Мм. Жіңішке Ахиллес сіңірінен➡
Dialogue: 0,0:19:02.74,0:19:05.57,Default,,0,0,0,,Балтырға дейін созылатын жұмсақ, таза тері.
Dialogue: 0,0:19:05.57,0:19:09.41,Default,,0,0,0,,Тіземнің артқы жағындағы әжімдер сәл қызғылт түсті. Бухибухи》
Dialogue: 0,0:19:09.41,0:19:11.91,Default,,0,0,0,,Ха…. 《Аа... жоқ.
Dialogue: 0,0:19:11.91,0:19:15.08,Default,,0,0,0,,Бұл қыз да Есма. Мен ойларды оқи алдым.
Dialogue: 0,0:19:15.08,0:19:17.59,Default,,0,0,0,,Мен шошқамын Мен шошқамын Мен шошқамын》
Dialogue: 0,0:19:19.59,0:19:21.79,Default,,0,0,0,,《Шөпке толы, шөп толтырылған, шөп толтырылған》
Dialogue: 0,0:19:23.76,0:19:26.59,Default,,0,0,0,,Мм... Ах. Фуго.
Dialogue: 0,0:19:26.59,0:19:28.93,Default,,0,0,0,,​​О?
Dialogue: 0,0:19:28.93,0:19:30.93,Default,,0,0,0,,Менің сенен бір жақсылығым бар.
Dialogue: 0,0:19:38.94,0:19:43.28,Default,,0,0,0,,Джесс, сен бұрын айтқан оқиға, ол қашан болды?
Dialogue: 0,0:19:43.28,0:19:45.45,Default,,0,0,0,,Бұл бес жыл бұрын болған.
Dialogue: 0,0:19:45.45,0:19:48.95,Default,,0,0,0,,Ол бастапқыда король астанасына кетуі керек жаста➡
Dialogue: 0,0:19:48.95,0:19:51.45,Default,,0,0,0,,Есманы жасырған монастырь➡
Dialogue: 0,0:19:51.45,0:19:54.62,Default,,0,0,0,,Бір түнде белгісіз себеппен өрт шықты.
Dialogue: 0,0:19:54.62,0:19:57.29,Default,,0,0,0,,Көптеген Йесмалар өртеніп өлді➡
Dialogue: 0,0:19:57.29,0:20:00.96,Default,,0,0,0,,Есма мен қашқан басқалары да жоғалып кетті.
Dialogue: 0,0:20:00.96,0:20:05.63,Default,,0,0,0,,Сізді Йесума аңшысы өлтірді ме? Иә... мүмкін.
Dialogue: 0,0:20:05.63,0:20:08.47,Default,,0,0,0,,Менің ойымша, Джесс оқиға болған жерді көргісі келеді.
Dialogue: 0,0:20:08.47,0:20:11.97,Default,,0,0,0,,Иә. Мен гүл ұсынар едім.
Dialogue: 0,0:20:14.64,0:20:17.65,Default,,0,0,0,,Мм... Джесс. иә?
Dialogue: 0,0:20:17.65,0:20:21.32,Default,,0,0,0,,Мына шошқа сенің досың ба? иә.
Dialogue: 0,0:20:21.32,0:20:24.32,Default,,0,0,0,,Негізі ол 19 жастағы жігіт.
Dialogue: 0,0:20:24.32,0:20:27.99,Default,,0,0,0,,Мен көзілдірік киген қызбын. Сізге көп рахмет.
Dialogue: 0,0:20:27.99,0:20:31.49,Default,,0,0,0,,Не, адам...? Иә.
Dialogue: 0,0:20:31.49,0:20:34.50,Default,,0,0,0,,Мен әйтеуір шошқаға айналған сияқтымын.
Dialogue: 0,0:20:34.50,0:20:36.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:36.50,0:20:39.00,Default,,0,0,0,,Елордаға келгенде, шеберге➡ барыңыз
Dialogue: 0,0:20:39.00,0:20:41.00,Default,,0,0,0,,Мен оны қайтарып алуды ойлап жүрмін.
Dialogue: 0,0:20:41.00,0:20:43.50,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:20:43.50,0:20:47.84,Default,,0,0,0,,Ол менің аяғыма қарап, көп нәрсені ойлады➡
Dialogue: 0,0:20:47.84,0:20:52.18,Default,,0,0,0,,Мен сені біртүрлі шошқа деп ойладым. Ngo!
Dialogue: 0,0:20:52.18,0:20:56.35,Default,,0,0,0,,Сен ешкімге ұқсамайтын шошқасың. Бұл ұят.
Dialogue: 0,0:20:56.35,0:20:59.35,Default,,0,0,0,,Бұдан былай мен тек Джесстің аяғына қарап өмір сүремін.
Dialogue: 0,0:20:59.35,0:21:01.36,Default,,0,0,0,,Хэхе….
Dialogue: 0,0:21:03.29,0:21:08.46,Default,,0,0,0,,《Бұл ашық жасыл шынымен дұрыс болды ма?》
Dialogue: 0,0:21:08.46,0:21:11.30,Default,,0,0,0,,《Шошқаның жүрек үнінде➡
Dialogue: 0,0:21:11.30,0:21:14.47,Default,,0,0,0,,Мен басқа адамдардан ерекшеленетін қауіпсіздік сезімін сезінемін》
Dialogue: 0,0:21:14.47,0:21:17.14,Default,,0,0,0,,《Ол туралы жақсырақ ойлану керек➡
Dialogue: 0,0:21:17.14,0:21:19.14,Default,,0,0,0,,Мүмкін бұл жақсы болған шығар》
Dialogue: 0,0:21:19.14,0:21:22.98,Default,,0,0,0,,《Менің дауысым сыртқы дауысқа өте жақын》
Dialogue: 0,0:21:22.98,0:21:27.48,Default,,0,0,0,,《Джесс Тасоның жүзі өте сүйкімді, сондықтан танымал емес отаку үшін,➡
Dialogue: 0,0:21:27.48,0:21:30.99,Default,,0,0,0,,Олардың барлығы бір-біріне сәйкес келетін сияқты. Дегенмен➡
Dialogue: 0,0:21:30.99,0:21:33.99,Default,,0,0,0,,Мен мұнымен келісемін бе?
Dialogue: 0,0:21:33.99,0:21:37.16,Default,,0,0,0,,Сүйкімді бетіңізді жақсы көрсететін түстер➡
Dialogue: 0,0:21:37.16,0:21:39.33,Default,,0,0,0,,Басқа нәрсе болуы мүмкін бе? 》
Dialogue: 0,0:21:39.33,0:21:44.83,Default,,0,0,0,,《Мен мұндай нәзік ішкі болмыспен ешқашан араласпадым.》
Dialogue: 0,0:21:44.83,0:21:48.34,Default,,0,0,0,,Мм... Шошқа.
Dialogue: 0,0:21:48.34,0:21:52.01,Default,,0,0,0,,Шарфты таңдағаныңызға рахмет.
Dialogue: 0,0:21:52.01,0:21:54.01,Default,,0,0,0,,Бұл үлкен мәселе емес.
Dialogue: 0,0:21:56.34,0:22:00.45,Default,,0,0,0,,《Әркім, заттардың әдетте екі жағы болады.
Dialogue: 0,0:22:00.45,0:22:02.95,Default,,0,0,0,,Әрине мен.
Dialogue: 0,0:22:02.95,0:22:05.45,Default,,0,0,0,,Мистер Джесс, Шошқа мырза. Ах.
Dialogue: 0,0:22:05.45,0:22:09.26,Default,,0,0,0,,Осы жерден сәл жүрсеңіз, өртенген монастырь қирандыларына жетесіз.
Dialogue: 0,0:22:13.29,0:22:18.13,Default,,0,0,0,,《Мені ойлайтын адам бар екені сөзсіз➡
Dialogue: 0,0:22:18.13,0:22:20.13,Default,,0,0,0,,Айғақ》
Dialogue: 0,0:22:24.64,0:22:28.04,Default,,0,0,0,,《Бұл орамал – қазына》
Dialogue: 0,0:22:29.54,0:22:35.54,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory