Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:21:41.41,0:21:45.01,OPJP,,0,0,0,,Жарықты жинау
Dialogue: 0,0:21:53.01,0:21:57.51,OPJP,,0,0,0,,Қоштасудан естеліктер
Dialogue: 0,0:21:58.61,0:22:04.68,OPJP,,0,0,0,,Көзіме тамсанып, алысқа қадалған арман
Dialogue: 0,0:22:04.86,0:22:10.11,OPJP,,0,0,0,,Ән жады бұзылады
Dialogue: 0,0:22:10.41,0:22:15.51,OPJP,,0,0,0,,Жалғыздықтың көз жасын ақырын сүртейік
Dialogue: 0,0:22:15.81,0:22:22.71,OPJP,,0,0,0,,Ұзартылған қол - айналмалы дөңгелек, оны абайлап алыңыз
Dialogue: 0,0:22:23.02,0:22:28.01,OPJP,,0,0,0,,Оянғалы тұрған жадының үзінділері
Dialogue: 0,0:22:29.01,0:22:33.91,OPJP,,0,0,0,,Мен төмен қарап, жоқ болып кетсін деп дұға етемін, бірақ
Dialogue: 0,0:22:34.02,0:22:40.01,OPJP,,0,0,0,,Бұл сіз тапқан дауыс
Dialogue: 0,0:22:40.31,0:22:47.01,OPJP,,0,0,0,,Сағат тілі қозғала бастайды, көп ұзамай дүниенің түсі өзгереді
Dialogue: 0,0:22:47.31,0:22:53.21,OPJP,,0,0,0,,Менің пластикалық жүрегім жарқырайды
Dialogue: 0,0:22:53.48,0:22:58.11,OPJP,,0,0,0,,Ұмытпа, есте сақта
Dialogue: 0,0:22:58.52,0:23:05.01,OPJP,,0,0,0,,Бір күні тағы кездескенше
Dialogue: 0,0:21:41.41,0:21:45.01,OPCN,,0,0,0,,Банарюкодюки
Dialogue: 0,0:21:53.01,0:21:57.51,OPCN,,0,0,0,,Өткен және қазіргі заманның түрлері
Dialogue: 0,0:21:58.61,0:22:04.68,OPCN,,0,0,0,,Хитоми Накасокойори Шинчу Атсуши Миядзаки Сузуки
Dialogue: 0,0:22:04.86,0:22:10.11,OPCN,,0,0,0,,Соруваканың қалқымалы арманы
Dialogue: 0,0:22:10.41,0:22:15.51,OPCN,,0,0,0,,Көзді уқалау
Dialogue: 0,0:22:15.81,0:22:22.71,OPCN,,0,0,0,,Көз алдымда зәулім ғимарат.
Dialogue: 0,0:22:23.02,0:22:28.01,OPCN,,0,0,0,,Өткеннің шығу тегі және оғаш ойлардың пайда болуы туралы егжей-тегжейлі баяндау
Dialogue: 0,0:22:29.01,0:22:33.91,OPCN,,0,0,0,,Мен басымды төмен қараймын.
Dialogue: 0,0:22:34.02,0:22:40.01,OPCN,,0,0,0,,Жүрегіңнің үні
Dialogue: 0,0:22:40.31,0:22:47.01,OPCN,,0,0,0,,Тоқырауын заман, сұр-қараңғы дүние
Dialogue: 0,0:22:47.31,0:22:53.21,OPCN,,0,0,0,,Пластикалық жүрек те жарық шығарады
Dialogue: 0,0:22:53.48,0:22:58.11,OPCN,,0,0,0,,Юкун Мубо Синджу Хисазу
Dialogue: 0,0:22:58.52,0:23:05.01,OPCN,,0,0,0,,Бір күні таң ата, Мен сені тағы да кездестіремін.
Dialogue: 0,0:18:31.59,0:18:34.93,EDJP,,0,0,0,,Ажырасқан сені іздедім.
Dialogue: 0,0:18:35.19,0:18:38.69,EDJP,,0,0,0,,Мені шақырған дауыс сөніп қалды
Dialogue: 0,0:18:38.89,0:18:46.29,EDJP,,0,0,0,,Мен ұстаған қол дірілдеп тұрды.
Dialogue: 0,0:18:46.77,0:18:50.29,EDJP,,0,0,0,,Біздің сезімдер
Dialogue: 0,0:18:50.49,0:18:55.49,EDJP,,0,0,0,,Қайтаруға болмайтын уақытты қабыл алыңыз
Dialogue: 0,0:18:55.70,0:19:00.20,EDJP,,0,0,0,,Мен биікте ұшамын
Dialogue: 0,0:19:01.00,0:19:04.59,EDJP,,0,0,0,,Аспанда жарқыраған калейдоскоп
Dialogue: 0,0:19:04.79,0:19:08.59,EDJP,,0,0,0,,Сіз ыңғайсызданып күлдіңіз.
Dialogue: 0,0:19:08.90,0:19:14.59,EDJP,,0,0,0,,Махаббатқа толы
Dialogue: 0,0:19:15.79,0:19:19.35,EDJP,,0,0,0,,Жарық ерігенге дейін
Dialogue: 0,0:19:19.49,0:19:22.49,EDJP,,0,0,0,,Мен шын жүректен үміттенемін
Dialogue: 0,0:19:22.69,0:19:31.90,EDJP,,0,0,0,,Осы сәтті мәңгі ұмытпа
Dialogue: 0,0:19:32.10,0:19:34.61,EDJP,,0,0,0,,Санақсыз
Dialogue: 0,0:19:35.79,0:19:40.00,EDJP,,0,0,0,,Сенімен өткен күндерді көрейін деп бұрылсам
Dialogue: 0,0:19:40.35,0:19:50.00,EDJP,,0,0,0,,Жұлдыз шахтасындай жарық
Dialogue: 0,0:20:08.41,0:20:11.20,EDJP,,0,0,0,,Күннің шығуы кемпірқосақ түсті
Dialogue: 0,0:20:11.60,0:20:15.10,EDJP,,0,0,0,,Фестивальден кейін жалғыз
Dialogue: 0,0:20:15.36,0:20:20.90,EDJP,,0,0,0,,Өзіңізді кейінгі жарқылға батырыңыз
Dialogue: 0,0:20:22.31,0:20:25.90,EDJP,,0,0,0,,Жылуыңды құшақтап, жүре бастаймын
Dialogue: 0,0:20:26.11,0:20:29.59,EDJP,,0,0,0,,Бұл керемет үшін рахмет
Dialogue: 0,0:20:29.81,0:20:37.90,EDJP,,0,0,0,,Бір күні тағы кездесерміз деп үміттенемін
Dialogue: 0,0:20:39.01,0:20:42.50,EDJP,,0,0,0,,Аспанда жарқыраған калейдоскоп
Dialogue: 0,0:20:42.70,0:20:46.60,EDJP,,0,0,0,,Сіз ыңғайсызданып күлдіңіз.
Dialogue: 0,0:20:46.90,0:20:52.70,EDJP,,0,0,0,,Махаббатқа толы
Dialogue: 0,0:20:53.80,0:20:57.30,EDJP,,0,0,0,,Жарық ерігенге дейін
Dialogue: 0,0:20:57.50,0:21:00.60,EDJP,,0,0,0,,Бар жүрегіммен ант бердім
Dialogue: 0,0:21:00.71,0:21:11.90,EDJP,,0,0,0,,Мен бұл сәтті мәңгі есте сақтауым керек
Dialogue: 0,0:21:12.25,0:21:18.80,EDJP,,0,0,0,,Алыстан гүлдеген
Dialogue: 0,0:21:19.30,0:21:28.70,EDJP,,0,0,0,,Жұлдызды аспан түстері
Dialogue: 0,0:18:31.59,0:18:34.93,EDCN,,0,0,0,,Бұл түзу және сіз адасып қалдыңыз.
Dialogue: 0,0:18:35.19,0:18:38.69,EDCN,,0,0,0,,Дауыс дауысы
Dialogue: 0,0:18:38.89,0:18:46.29,EDCN,,0,0,0,,Насу коте өз қолымнан
Dialogue: 0,0:18:46.77,0:18:50.29,EDCN,,0,0,0,,Жеке ойлар
Dialogue: 0,0:18:50.49,0:18:55.49,EDCN,,0,0,0,,Қайтылатын қозғалыс уақыты жоқ
Dialogue: 0,0:18:55.70,0:19:00.20,EDCN,,0,0,0,,Аспанда биік ұшқаннан кейін
Dialogue: 0,0:19:01.00,0:19:04.59,EDCN,,0,0,0,,Отты жүзім күміс гүлі мантан лалагүлі
Dialogue: 0,0:19:04.79,0:19:08.59,EDCN,,0,0,0,,Күлімсіреген кезде
Dialogue: 0,0:19:08.90,0:19:14.59,EDCN,,0,0,0,,Таусылмас махаббат пен қадір-қасиет
Dialogue: 0,0:19:15.79,0:19:19.35,EDCN,,0,0,0,,Жарықтың таралуы
Dialogue: 0,0:19:19.49,0:19:22.49,EDCN,,0,0,0,,Менің ыңғайлылығым
Dialogue: 0,0:19:22.69,0:19:31.90,EDCN,,0,0,0,,Бір сәт, бұл өмір мәңгілікке ұмытылады.
Dialogue: 0,0:19:32.10,0:19:34.61,EDCN,,0,0,0,,Көптеген сандар
Dialogue: 0,0:19:35.79,0:19:40.00,EDCN,,0,0,0,,Біздің өткеніміз
Dialogue: 0,0:19:40.35,0:19:50.00,EDCN,,0,0,0,,Мантандық от қалай аталады?
Dialogue: 0,0:20:08.41,0:20:11.20,EDCN,,0,0,0,,Түнсіз аспан аспаны
Dialogue: 0,0:20:11.60,0:20:15.10,EDCN,,0,0,0,,Жазғы фестиваль «Өзіндік рефлексияны аяқтайтын ән».
Dialogue: 0,0:20:15.36,0:20:20.90,EDCN,,0,0,0,,...
Dialogue: 0,0:20:22.31,0:20:25.90,EDCN,,0,0,0,,Жылулық және дене күтімі
Dialogue: 0,0:20:26.11,0:20:29.59,EDCN,,0,0,0,,Себеп пен ғажайып реті мен сенемін
Dialogue: 0,0:20:29.81,0:20:37.90,EDCN,,0,0,0,,Бір күні таңертең біз тағы кездесеміз.
Dialogue: 0,0:20:39.01,0:20:42.50,EDCN,,0,0,0,,Отты жүзім күміс гүлі мантан лалагүлі
Dialogue: 0,0:20:42.70,0:20:46.60,EDCN,,0,0,0,,Сіздің өміріңіздің күлкісі
Dialogue: 0,0:20:46.90,0:20:52.70,EDCN,,0,0,0,,Өзара сүйіспеншілік пен сүйіспеншілік
Dialogue: 0,0:20:53.80,0:20:57.30,EDCN,,0,0,0,,Жарықтың таралуы
Dialogue: 0,0:20:57.50,0:21:00.60,EDCN,,0,0,0,,Менің жеке антым
Dialogue: 0,0:21:00.71,0:21:11.90,EDCN,,0,0,0,,Бар болған жалғыз сәт – мәңгілік естелік
Dialogue: 0,0:21:12.25,0:21:18.80,EDCN,,0,0,0,,Аспанның ұзын көрінісі
Dialogue: 0,0:21:19.30,0:21:28.70,EDCN,,0,0,0,,Шексіз жалын, түнгі аспан
Dialogue: 0,0:00:04.76,0:00:07.86,JPN,,0,0,0,,Енді инкассо келісіміне қол қойыңыз.
Dialogue: 0,0:00:08.90,0:00:11.82,JPN,,0,0,0,,Мирабелмен қоштасуға тура келді.
Dialogue: 0,0:00:12.27,0:00:13.53,JPN,,0,0,0,,Мен сені сағынамын
Dialogue: 0,0:00:13.77,0:00:15.58,JPN,,0,0,0,,Бұл бала А-кун аю.
Dialogue: 0,0:00:15.75,0:00:16.96,JPN,,0,0,0,,Сәлем
Dialogue: 0,0:00:17.14,0:00:18.00,JPN,,0,0,0,,Сәлем
Dialogue: 0,0:00:19.11,0:00:21.63,JPN,,0,0,0,,Сонымен Мирабелді қалпына келтіргеннен кейін.
Dialogue: 0,0:00:22.16,0:00:25.63,JPN,,0,0,0,,Сізде, иесінің үш нұсқасы бар.
Dialogue: 0,0:00:26.18,0:00:28.26,JPN,,0,0,0,,Бірі - жаңа өнімді сатып алу кезіндегі жеңілдік.
Dialogue: 0,0:00:28.69,0:00:32.76,JPN,,0,0,0,,Екі элемент үшін оларды саудалау арқылы тізім бағасының 30% кэшбэк ретінде алуға болады.
Dialogue: 0,0:00:33.32,0:00:36.39,JPN,,0,0,0,,Үшіншіден, Мирабелдің денесінде жаңа ОЖ.
Dialogue: 0,0:00:36.56,0:00:39.90,JPN,,0,0,0,,Басқаша айтқанда, жеке басыңызды қалпына келтіру арқылы оны пайдалануды жалғастыра аласыз.
Dialogue: 0,0:00:40.01,0:00:42.06,JPN,,0,0,0,,ОЖ-ны ауыстыруыңызды сұраймын.
Dialogue: 0,0:00:44.54,0:00:45.00,JPN,,0,0,0,,Бұл
Dialogue: 0,0:00:45.16,0:00:48.74,JPN,,0,0,0,,Тұлға мен естеліктер бәрібір жоғалады.
Dialogue: 0,0:00:49.11,0:00:50.45,JPN,,0,0,0,,Әлі де жақсы ма?
Dialogue: 0,0:00:50.78,0:00:51.28,JPN,,0,0,0,,Иә
Dialogue: 0,0:00:51.81,0:00:53.45,JPN,,0,0,0,,Өйткені мен мұны бұрын жасағанмын.
Dialogue: 0,0:00:54.29,0:00:55.54,JPN,,0,0,0,,Бұрын
Dialogue: 0,0:00:56.14,0:00:57.70,JPN,,0,0,0,,Жанымызды ауыстырсақ та
Dialogue: 0,0:00:57.90,0:01:01.00,JPN,,0,0,0,,Мен саған әрқашан бір баладай қараймын.
Dialogue: 0,0:01:24.46,0:01:25.36,JPN,,0,0,0,,Жад?
Dialogue: 0,0:01:25.71,0:01:26.32,JPN,,0,0,0,,Иә
Dialogue: 0,0:01:26.69,0:01:28.61,JPN,,0,0,0,,Жаңа ОЖ бар Giftia
Dialogue: 0,0:01:28.80,0:01:33.03,JPN,,0,0,0,,Бұрынғы естеліктер неге екені белгісіз қайта орала ма деп ойлаймын...
Dialogue: 0,0:01:34.11,0:01:35.12,JPN,,0,0,0,,Мүмкін емес
Dialogue: 0,0:01:36.61,0:01:37.45,JPN,,0,0,0,,Кеше болған жайтқа әлі де алаңдайсың ба?
Dialogue: 0,0:01:38.21,0:01:39.12,JPN,,0,0,0,,Өкінішті, бірақ…
Dialogue: 0,0:01:39.52,0:01:41.87,JPN,,0,0,0,,Жоқ, прецедент жоқ.
Dialogue: 0,0:01:42.46,0:01:43.67,JPN,,0,0,0,,Бұлай болуы мүмкін емес.
Dialogue: 0,0:01:44.29,0:01:46.88,JPN,,0,0,0,,күрсіну. Сіз бұл туралы сұрап көрдіңіз бе?
Dialogue: 0,0:01:47.31,0:01:49.13,JPN,,0,0,0,,Сондықтан да өнерпаздар
Dialogue: 0,0:01:50.71,0:01:53.13,JPN,,0,0,0,,Мичиру бұрынғыдай қатал.
Dialogue: 0,0:01:53.53,0:01:57.87,JPN,,0,0,0,,Giftia жағдайында бұл адамдардың есте сақтау қабілетін жоғалтуынан өзгеше.
Dialogue: 0,0:01:58.26,0:02:01.02,JPN,,0,0,0,,Барлық мазмұн жаңасымен ауыстырылады.
Dialogue: 0,0:02:01.66,0:02:03.98,JPN,,0,0,0,,Бұл мүлдем басқа.
Dialogue: 0,0:02:04.46,0:02:05.90,JPN,,0,0,0,,Мені қате түсінбеңіз
Dialogue: 0,0:02:07.64,0:02:10.61,JPN,,0,0,0,,Бұл оған көмектесу мүмкін емес дегенді білдіре ме?
Dialogue: 0,0:02:11.22,0:02:14.95,JPN,,0,0,0,,Жартылай үміт күту әлдеқайда қиын.
Dialogue: 0,0:02:16.91,0:02:19.62,JPN,,0,0,0,,Мен сенің сезіміңді түсіндім.
Dialogue: 0,0:02:20.52,0:02:24.58,JPN,,0,0,0,,Мен де осында келмес бұрын бір нәрсені көп ойладым.
Dialogue: 0,0:02:26.04,0:02:26.79,JPN,,0,0,0,,Мичиру
Dialogue: 0,0:02:27.04,0:02:30.46,JPN,,0,0,0,,Сондықтан сіз өз ішіңізден орын табуыңыз керек.
Dialogue: 0,0:02:31.90,0:02:33.59,JPN,,0,0,0,,Бұл туралы ештеңе істей алмаймыз.
Dialogue: 0,0:02:40.73,0:02:41.89,JPN,,0,0,0,,Цукаса Айра
Dialogue: 0,0:02:43.17,0:02:47.31,JPN,,0,0,0,,Терминал 3 қызметінен атқыш ертең жіберіледі.
Dialogue: 0,0:02:47.80,0:02:48.65,JPN,,0,0,0,,Үшінші?
Dialogue: 0,0:02:48.93,0:02:53.32,JPN,,0,0,0,,Алынған заты мен сол жерде жауап беретін иесі жоғалып кеткен сияқты.
Dialogue: 0,0:02:53.80,0:02:56.60,JPN,,0,0,0,,Менің ауданымда біреу жасырынып жүр деген ақпарат бар.
Dialogue: 0,0:02:56.71,0:02:57.82,JPN,,0,0,0,,Іздеп келемін деді.
Dialogue: 0,0:02:58.66,0:03:01.83,JPN,,0,0,0,,Бұл кенет және нашар, бірақ мен сізден қолдау сұрағым келеді.
Dialogue: 0,0:03:02.47,0:03:04.00,JPN,,0,0,0,,Тіпті саған автограф қойып, қолыңды да қысып қояйын
Dialogue: 0,0:03:04.51,0:03:05.12,JPN,,0,0,0,,Цукаса
Dialogue: 0,0:03:07.80,0:03:09.56,JPN,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:03:10.94,0:03:13.67,JPN,,0,0,0,,Сіз Цукаса-кун мен Исла-кунсыз ба?
Dialogue: 0,0:03:14.99,0:03:17.22,JPN,,0,0,0,,Бұл Терминал 3 қызметіндегі Энди.
Dialogue: 0,0:03:17.61,0:03:18.26,JPN,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:03:18.71,0:03:19.51,JPN,,0,0,0,,Мен де солай.
Dialogue: 0,0:03:21.24,0:03:23.45,JPN,,0,0,0,,Айтпақшы, Эндидің серіктесі кім?
Dialogue: 0,0:03:23.69,0:03:24.62,JPN,,0,0,0,,​​Ол келмеді.
Dialogue: 0,0:03:25.11,0:03:25.72,JPN,,0,0,0,,Бірақ
Dialogue: 0,0:03:25.97,0:03:28.48,JPN,,0,0,0,,Негізінен іссапардағы бір мергендік емес пе?
Dialogue: 0,0:03:28.89,0:03:30.15,JPN,,0,0,0,,Біріншісі басқаша ма?
Dialogue: 0,0:03:30.70,0:03:31.57,JPN,,0,0,0,,Келіңіздер
Dialogue: 0,0:03:31.92,0:03:33.72,JPN,,0,0,0,,Мен ешқашан іссапарда болған емеспін.
Dialogue: 0,0:03:34.69,0:03:37.95,JPN,,0,0,0,,Екі адамды жіберу тиімсіз болар еді.
Dialogue: 0,0:03:38.48,0:03:42.20,JPN,,0,0,0,,Іссапарларымда сіз сияқты көмекші қызметкерлер болуы мүмкін.
Dialogue: 0,0:03:42.31,0:03:43.49,JPN,,0,0,0,,Сізде қиындық болмайды
Dialogue: 0,0:03:43.62,0:03:44.50,JPN,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:44.91,0:03:47.25,JPN,,0,0,0,,Бірақ егер Ира іссапарға барса ше?
Dialogue: 0,0:03:47.55,0:03:49.75,JPN,,0,0,0,,Мен сенімен міндетті түрде барамын.
Dialogue: 0,0:03:51.00,0:03:53.75,JPN,,0,0,0,,Мен өзім де іссапарға шыға аламын.
Dialogue: 0,0:03:57.01,0:03:58.05,JPN,,0,0,0,,Себебі бұл мүмкін
Dialogue: 0,0:03:59.33,0:04:00.18,JPN,,0,0,0,,Жоқ
Dialogue: 0,0:04:00.30,0:04:01.80,JPN,,0,0,0,,Менің айтқым келгені бұл емес.
Dialogue: 0,0:04:02.05,0:04:02.83,JPN,,0,0,0,,Бұл түсінбеушілік.
Dialogue: 0,0:04:02.90,0:04:04.91,JPN,,0,0,0,,Қате Мен сізді жақсы ести алмадым.
Dialogue: 0,0:04:05.60,0:04:08.60,JPN_Up,,0,0,0,,Жоқ, Исла менің ағам.
Dialogue: 0,0:04:06.24,0:04:09.02,JPN,,0,0,0,,Балалар, сендер мүлде басқа комбинациясыңдар.
Dialogue: 0,0:04:08.70,0:04:11.20,JPN_Up,,0,0,0,,Қате Мен сізді жақсы ести алмадым.
Dialogue: 0,0:04:09.60,0:04:11.36,JPN,,0,0,0,,Ах Цукасачи
Dialogue: 0,0:04:14.53,0:04:15.86,JPN,,0,0,0,,Оливия!
Dialogue: 0,0:04:16.57,0:04:17.24,JPN,,0,0,0,,Ал сен ше, Хори-сан? Қандай музыка ұнайды?
Dialogue: 0,0:04:18.09,0:04:21.18,JPN,,0,0,0,,Мен сене алар емеспін
Dialogue: 0,0:04:23.29,0:04:25.79,JPN,,0,0,0,,Менің қымбатты досым
Dialogue: 0,0:04:28.90,0:04:29.71,JPN,,0,0,0,,Элле мырза?
Dialogue: 0,0:04:31.23,0:04:33.04,JPN,,0,0,0,,Сіз оны қай жерде ұстап тұрсыз?
Dialogue: 0,0:04:36.43,0:04:39.26,JPN,,0,0,0,,Мен оның қарсы шығатынына таң қалдым.
Dialogue: 0,0:04:39.54,0:04:42.72,JPN,,0,0,0,,Бұрын қанша жыныстық қудалау жасасаңыз да, сіз қалағаныңызды істедіңіз.
Dialogue: 0,0:04:43.05,0:04:45.30,JPN,,0,0,0,,Жоқ, бірақ бұл...
Dialogue: 0,0:04:47.47,0:04:49.69,JPN,,0,0,0,,Екеуің бір-біріңді танисыңдар ма?
Dialogue: 0,0:04:49.82,0:04:54.98,JPN,,0,0,0,,Иә, несін жасырсам да, жастық шағымыз бірге өткен жан достармыз.
Dialogue: 0,0:04:55.08,0:04:56.40,JPN,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:04:57.66,0:05:00.28,JPN,,0,0,0,,Сіз екеуміз бірінші рет кездесіп тұрмыз.
Dialogue: 0,0:05:04.14,0:05:04.83,JPN,,0,0,0,,Элле мырза?
Dialogue: 0,0:05:05.70,0:05:07.25,JPN,,0,0,0,,А, жоқ, кешіріңіз.
Dialogue: 0,0:05:07.71,0:05:10.71,JPN,,0,0,0,,Оның менің досыма қатты ұқсағаны сонша, мен оны қателесіп жібердім.
Dialogue: 0,0:05:11.00,0:05:13.17,JPN,,0,0,0,,Біз ебедейміз, солай емес пе?
Dialogue: 0,0:05:15.89,0:05:17.63,JPN,,0,0,0,,Олай болса, кешіріңіз.
Dialogue: 0,0:05:19.40,0:05:21.80,JPN,,0,0,0,,Бірінші адам бәрі басқаша, солай емес пе?
Dialogue: 0,0:05:28.42,0:05:29.39,JPN,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:30.24,0:05:32.74,JPN,,0,0,0,,Менің есте сақтау қабілетім жоғалып кетті.
Dialogue: 0,0:05:44.91,0:05:45.45,JPN,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:05:52.55,0:05:53.08,JPN,,0,0,0,,Ира
Dialogue: 0,0:05:53.71,0:05:54.31,JPN,,0,0,0,,Сендердің міндетің не, көпшілік?
Dialogue: 0,0:05:58.56,0:05:59.51,JPN,,0,0,0,,Қазір
Dialogue: 0,0:06:00.28,0:06:00.97,JPN,,0,0,0,,Оған дейін
Dialogue: 0,0:06:04.20,0:06:05.80,JPN,,0,0,0,,Қызық, сен қазірдің өзінде бас тартасың ба?
Dialogue: 0,0:06:17.77,0:06:18.73,JPN,,0,0,0,,Осы жерге қол қойыңыз
Dialogue: 0,0:06:19.21,0:06:21.57,JPN,,0,0,0,,Өтінемін, жіберіп алмаңыз
Dialogue: 0,0:06:22.48,0:06:24.07,JPN,,0,0,0,,Мен Деректен кеткім келмейді.
Dialogue: 0,0:06:24.37,0:06:25.28,JPN,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:06:25.50,0:06:27.24,JPN,,0,0,0,,Бұлай болуы мүмкін емес.
Dialogue: 0,0:06:27.92,0:06:31.95,JPN,,0,0,0,,Ендеше, ең болмағанда соңғы минутқа дейін сенімен бірге болуға рұқсат етемін.
Dialogue: 0,0:06:32.40,0:06:35.12,JPN,,0,0,0,,Сіз тағы бір апта бойы жақсы боласыз, солай ма?
Dialogue: 0,0:06:35.42,0:06:36.56,JPN,,0,0,0,,Бұл да жақсы емес.
Dialogue: 0,0:06:37.06,0:06:39.71,JPN,,0,0,0,,Балалар, тағы да қашып кетулерің мүмкін.
Dialogue: 0,0:06:40.01,0:06:40.96,JPN,,0,0,0,,Бұл...
Dialogue: 0,0:06:45.70,0:06:46.59,JPN,,0,0,0,,Дерек
Dialogue: 0,0:06:46.97,0:06:47.89,JPN,,0,0,0,,Дерек
Dialogue: 0,0:06:49.50,0:06:50.56,JPN,,0,0,0,,Сәлем Энди
Dialogue: 0,0:06:51.76,0:06:52.43,JPN,,0,0,0,,Жоқ
Dialogue: 0,0:06:54.33,0:06:56.19,JPN,,0,0,0,,Дерек
Dialogue: 0,0:07:04.38,0:07:07.20,JPN,,0,0,0,,Эй, бұл шынымен пайдалы болды.
Dialogue: 0,0:07:07.72,0:07:11.45,JPN,,0,0,0,,Балалар, сендерге рахмет, мен оны күткеннен де тезірек қалпына келтірдім.
Dialogue: 0,0:07:13.64,0:07:15.21,JPN,,0,0,0,,Иә? Не болды?
Dialogue: 0,0:07:15.90,0:07:18.83,JPN,,0,0,0,,Соншалықты күшті болу керек пе еді?
Dialogue: 0,0:07:19.50,0:07:20.21,JPN,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:07:21.00,0:07:25.24,JPN,,0,0,0,,Менімше, иесімен келіспеушілік пайда болмайды.
Dialogue: 0,0:07:25.77,0:07:28.30,JPN,,0,0,0,,А, мен қазір үйреніп қалдым.
Dialogue: 0,0:07:28.44,0:07:30.97,JPN,,0,0,0,,Біздің міндетіміз естеліктерді жырту.
Dialogue: 0,0:07:34.18,0:07:36.06,JPN,,0,0,0,,Энди қателеспейді
Dialogue: 0,0:07:36.77,0:07:38.44,JPN,,0,0,0,,Ах, рақмет.
Dialogue: 0,0:07:38.92,0:07:42.86,JPN,,0,0,0,,Керісінше, мұндай әдіс терминалдық қызметтер үшін кең таралған.
Dialogue: 0,0:07:43.57,0:07:44.69,JPN,,0,0,0,,Солай ма?
Dialogue: 0,0:07:45.32,0:07:47.49,JPN,,0,0,0,,Тек біз ерекшеміз.
Dialogue: 0,0:07:47.66,0:07:51.64,JPN,,0,0,0,,Сіз тіпті иесіне немесе жинау нысанасына психологиялық көмек көрсетуге тырысасыз ба?
Dialogue: 0,0:07:52.10,0:07:55.75,JPN,,0,0,0,,Біріншіден, бұл үш жыл бұрын Кадзуки қабылдаған әдіс.
Dialogue: 0,0:07:57.38,0:08:02.63,JPN,,0,0,0,,Соның салдарынан бөлім меңгерушісіне бас кеңсе үнемі тым қымбатқа түседі деп шағымданады.
Dialogue: 0,0:08:09.53,0:08:10.01,JPN,,0,0,0,,Бұл
Dialogue: 0,0:08:14.85,0:08:16.36,JPN,,0,0,0,,Мүмкін күткен боларсыз?
Dialogue: 0,0:08:17.85,0:08:18.48,JPN,,0,0,0,,Рахмет
Dialogue: 0,0:08:18.88,0:08:23.11,JPN,,0,0,0,,Мен Ясутака мырзамен бүгінгі жұмыс туралы аздаған кеңес алдым.
Dialogue: 0,0:08:23.60,0:08:24.44,JPN,,0,0,0,,Мен де...
Dialogue: 0,0:08:26.22,0:08:29.53,JPN,,0,0,0,,Мен де Цукасаның кеңесіне мінгім келеді.
Dialogue: 0,0:08:31.68,0:08:32.20,JPN,,0,0,0,,О
Dialogue: 0,0:08:32.74,0:08:34.97,JPN,,0,0,0,,Олай болса, мен енді Исламен сөйлесемін.
Dialogue: 0,0:08:38.81,0:08:41.50,JPN,,0,0,0,,Бұл шынымен ақылсыз болды.
Dialogue: 0,0:08:41.90,0:08:43.13,JPN,,0,0,0,,Сатору мен жоғары лауазымды тұлғалар арасындағы қақтығыс осыны ұйымдастырды деген сыбыс бар, солай емес пе?
Dialogue: 0,0:08:43.42,0:08:45.02,JPN,,0,0,0,,Міне, бүгінгі күн солай.
Dialogue: 0,0:08:45.48,0:08:46.65,JPN,,0,0,0,,Күтіңіз
Dialogue: 0,0:08:50.50,0:08:51.72,JPN,,0,0,0,,Сіз қазір Эндисіз бе?
Dialogue: 0,0:08:52.45,0:08:54.18,JPN,,0,0,0,,Иә
Dialogue: 0,0:08:54.50,0:08:57.14,JPN,,0,0,0,,Мен сізге кеше болған оқиға үшін кешірім сұрау үшін хабарластым.
Dialogue: 0,0:08:58.70,0:09:01.46,JPN,,0,0,0,,Осыдан кейін ол маған толық ғашық болды.
Dialogue: 0,0:09:01.66,0:09:03.63,JPN,,0,0,0,,Танымал әйел болу қиын
Dialogue: 0,0:09:05.37,0:09:06.36,JPN,,0,0,0,,Әй, егер солай десеңіз.
Dialogue: 0,0:09:06.54,0:09:09.32,JPN,,0,0,0,,Сіз Эндиді біраз уақыттан бері білетін сияқтысыз.
Dialogue: 0,0:09:09.69,0:09:10.40,JPN,,0,0,0,,О
Dialogue: 0,0:09:12.40,0:09:14.18,JPN,,0,0,0,,Ол көрші болды.
Dialogue: 0,0:09:15.00,0:09:17.75,JPN,,0,0,0,,Оның аты Оливия болатын.
Dialogue: 0,0:09:18.68,0:09:19.46,JPN,,0,0,0,,Сол кезде?
Dialogue: 0,0:09:19.76,0:09:20.37,JPN,,0,0,0,,Қараңыз
Dialogue: 0,0:09:25.58,0:09:27.00,JPN,,0,0,0,,Шынымен Энди ме?
Dialogue: 0,0:09:27.52,0:09:29.51,JPN,,0,0,0,,Атмосфера сәл басқаша көрінеді
Dialogue: 0,0:09:30.82,0:09:34.26,JPN,,0,0,0,,Оливия бірнеше жыл бұрын қалпына келтірілді
Dialogue: 0,0:09:35.55,0:09:36.56,JPN,,0,0,0,,Сонда амал жоқ па?
Dialogue: 0,0:09:37.10,0:09:38.39,JPN,,0,0,0,,ОЖ ауыстырыңыз
Dialogue: 0,0:09:38.92,0:09:39.46,JPN,,0,0,0,,Иә
Dialogue: 0,0:09:40.77,0:09:41.31,JPN,,0,0,0,,Қараңыз
Dialogue: 0,0:09:41.62,0:09:46.42,JPN,,0,0,0,,Терминал қызметтеріне әрқашан шығындарды азайту керектігі айтылған сияқты.
Dialogue: 0,0:09:46.87,0:09:51.90,JPN,,0,0,0,,Сондықтан олар бастапқыда кәдеге жаратылуы тиіс Оливияны қайта пайдалануды ұйғарды.
Dialogue: 0,0:09:54.10,0:09:57.16,JPN,,0,0,0,,Эндидің Оливия кезіндегі естеліктері бар.
Dialogue: 0,0:09:59.29,0:10:02.68,JPN,,0,0,0,,Бұлай қайта кездесеміз деп ойламаппын...
Dialogue: 0,0:10:03.79,0:10:06.50,JPN,,0,0,0,,Сол кеудеге тағы да массаж жасасам ғой.
Dialogue: 0,0:10:06.67,0:10:09.21,JPN,,0,0,0,,Қазір Оливияның Эндиі.
Dialogue: 0,0:10:09.38,0:10:11.47,JPN,,0,0,0,,Маған көп көмек көрсетілді.
Dialogue: 0,0:10:11.60,0:10:14.01,JPN,,0,0,0,,Дәлірек айтсам, күшпен ұстадым.
Dialogue: 0,0:10:11.90,0:10:13.28,JPN_Up,,0,0,0,,Жоқ, бұл адам.
Dialogue: 0,0:10:14.29,0:10:15.22,JPN,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:10:26.08,0:10:30.40,JPN,,0,0,0,,Элл енді Оливия емеспін деп уайымдап тұрған жоқ па?
Dialogue: 0,0:10:31.63,0:10:33.49,JPN,,0,0,0,,Маза бермейтін нәрсе ме деп ойлаймын.
Dialogue: 0,0:10:36.80,0:10:38.70,JPN,,0,0,0,,Бұл солай ма?
Dialogue: 0,0:10:46.83,0:10:48.44,JPN,,0,0,0,,Тәттілер келді.
Dialogue: 0,0:10:48.78,0:10:50.13,JPN,,0,0,0,,Кім?
Dialogue: 0,0:10:50.61,0:10:53.09,JPN,,0,0,0,,Бұл Terminal 3 Services бөлім менеджерінен.
Dialogue: 0,0:10:53.42,0:10:55.14,JPN,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:10:55.26,0:10:57.47,JPN,,0,0,0,,Исла-чан, шай ішіп алшы.
Dialogue: 0,0:10:57.97,0:11:02.64,JPN,,0,0,0,,Эй, Энди, сен өткен күні келдің, сен оны жақсы орындадың.
Dialogue: 0,0:11:02.81,0:11:06.36,JPN,,0,0,0,,Мен жай ғана жұмысқа барып, үйге тез қайтқандай болдым.
Dialogue: 0,0:11:06.50,0:11:09.69,JPN,,0,0,0,,Уау, бұл біз оны пайдалана алмаймыз дегенді білдіре ме?
Dialogue: 0,0:11:10.87,0:11:12.57,JPN,,0,0,0,,Менің айтқым келгені бұл емес.
Dialogue: 0,0:11:12.93,0:11:14.07,JPN,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:11:14.48,0:11:16.07,JPN,,0,0,0,,Цукасатчи
Dialogue: 0,0:11:20.12,0:11:22.58,JPN,,0,0,0,,Маған көмектесіңізші
Dialogue: 0,0:11:24.80,0:11:29.71,JPN,,0,0,0,,Мен байқаусызда Эндиге жергілікті карнавалым туралы айтып бердім.
Dialogue: 0,0:11:30.20,0:11:33.55,JPN,,0,0,0,,Сосын ол мені өзімен бірге алып кетуімді өтінді.
Dialogue: 0,0:11:34.35,0:11:34.92,JPN,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:11:35.23,0:11:37.15,JPN,,0,0,0,,Бүгін түн.
Dialogue: 0,0:11:37.43,0:11:40.43,JPN,,0,0,0,,Цукасачи, менімен бірге келші.
Dialogue: 0,0:11:40.83,0:11:42.30,JPN,,0,0,0,,Неге мен?
Dialogue: 0,0:11:42.48,0:11:44.60,JPN,,0,0,0,,Екеуміз бірге көңіл көтерсек жақсы емес пе?
Dialogue: 0,0:11:44.66,0:11:45.95,JPN,,0,0,0,,Негізсіз мүмкін емес мүмкін емес
Dialogue: 0,0:11:46.10,0:11:46.77,JPN,,0,0,0,,Неліктен?
Dialogue: 0,0:11:48.08,0:11:51.65,JPN,,0,0,0,,Себебі менің Оливиямен естеліктерім көп.
Dialogue: 0,0:11:51.98,0:11:54.53,JPN,,0,0,0,,Онда Эндимен жалғыз барасың ба?
Dialogue: 0,0:11:55.21,0:11:56.49,JPN,,0,0,0,,Бұл өте қатал, солай емес пе?
Dialogue: 0,0:11:57.23,0:11:58.95,JPN,,0,0,0,,Олардың беттері бірдей
Dialogue: 0,0:12:00.52,0:12:01.28,JPN,,0,0,0,,Элле мырза
Dialogue: 0,0:12:02.53,0:12:05.52,JPN,,0,0,0,,Цукасачи, менімен бірге жүр.
Dialogue: 0,0:12:05.76,0:12:08.29,JPN,,0,0,0,,Сіз маған көмектесе аласыз деп ойладым
Dialogue: 0,0:12:08.60,0:12:09.38,JPN,,0,0,0,,Сен бұған қауқарлысың.
Dialogue: 0,0:12:09.76,0:12:12.04,JPN,,0,0,0,,Ұстамаңыз
Dialogue: 0,0:12:13.01,0:12:15.97,JPN,,0,0,0,,Мен бұл екеуі не істеп жатыр деп ойлаймын.
Dialogue: 0,0:12:16.52,0:12:17.76,JPN,,0,0,0,,Ира, тыңдап тұрсың ба?
Dialogue: 0,0:12:18.42,0:12:19.51,JPN,,0,0,0,,Мен қызықпын
Dialogue: 0,0:12:19.82,0:12:23.72,JPN,,0,0,0,,Па.Жолдасыңа айтпау қиын емес пе?
Dialogue: 0,0:12:24.39,0:12:26.43,JPN,,0,0,0,,Маған бәрібір
Dialogue: 0,0:12:27.81,0:12:28.48,JPN,,0,0,0,,Иә?
Dialogue: 0,0:12:30.98,0:12:33.65,JPN,,0,0,0,,Сіз шынымен де қызық болуыңыз керек.
Dialogue: 0,0:12:36.88,0:12:39.07,JPN,,0,0,0,,Мысалы.
Dialogue: 0,0:12:39.77,0:12:41.74,JPN,,0,0,0,,Мен Эндиді карнавалға апарсам
Dialogue: 0,0:12:42.26,0:12:43.58,JPN,,0,0,0,,Осыған байланысты
Dialogue: 0,0:12:44.15,0:12:46.54,JPN,,0,0,0,,Оливияның естеліктері сәл болса да қайта оралады
Dialogue: 0,0:12:47.17,0:12:49.62,JPN,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:12:51.00,0:12:53.71,JPN,,0,0,0,,Сіз Айракчи туралы ойлайсыз ба?
Dialogue: 0,0:12:54.78,0:12:55.71,JPN,,0,0,0,,Бұл не?
Dialogue: 0,0:12:56.38,0:13:00.34,JPN,,0,0,0,,Мен не айтсам да, сен оңайлықпен сенбейсің.
Dialogue: 0,0:13:02.16,0:13:03.55,JPN,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:13:03.93,0:13:06.27,JPN,,0,0,0,,Айракчи де мені пайдаланды
Dialogue: 0,0:13:06.77,0:13:07.73,JPN,,0,0,0,,Қолдану
Dialogue: 0,0:13:08.53,0:13:10.60,JPN,,0,0,0,,Бүгін кешке бірге барайық.
Dialogue: 0,0:13:11.44,0:13:14.11,JPN,,0,0,0,,Сондықтан оны тек өз көзіңмен көру керек.
Dialogue: 0,0:13:16.25,0:13:17.36,JPN,,0,0,0,,Тоқтат! Сол жерде тоқта!
Dialogue: 0,0:13:17.82,0:13:19.49,JPN,,0,0,0,,Өзіңізді мәжбүрлеудің қажеті жоқ.
Dialogue: 0,0:13:20.25,0:13:22.82,JPN,,0,0,0,,Өйткені мен Цукасаның серіктесімін.
Dialogue: 0,0:13:23.27,0:13:25.37,JPN,,0,0,0,,Айтпақшы, Энди де солай.
Dialogue: 0,0:13:26.19,0:13:26.83,JPN,,0,0,0,,Таңертең ерте тұрып-ақ қазірден-ақ қажырлы еңбек етіп жатырсың ғой.
Dialogue: 0,0:13:27.20,0:13:29.87,JPN,,0,0,0,,Сонымен қатар, L-san ерекшеліксіз келеді.
Dialogue: 0,0:13:30.77,0:13:31.62,JPN,,0,0,0,,Мен... барамын
Dialogue: 0,0:13:32.49,0:13:34.13,JPN,,0,0,0,,Жарайды, шешілді.
Dialogue: 0,0:13:34.71,0:13:38.34,JPN,,0,0,0,,Соңында отшашулар атылады және бұл өте қызықты болады.
Dialogue: 0,0:13:38.87,0:13:42.38,JPN,,0,0,0,,Мен бұрын-соңды отшашуды көрген емеспін.
Dialogue: 0,0:13:42.62,0:13:43.47,JPN,,0,0,0,,Солай ма?
Dialogue: 0,0:13:44.97,0:13:48.02,JPN,,0,0,0,,Дауыстың қатты шыққаны сонша, таң қаласың.
Dialogue: 0,0:13:49.27,0:13:49.93,JPN,,0,0,0,,Ж-жақсы, олай болар деп ойлаймын.
Dialogue: 0,0:13:52.20,0:13:54.06,JPN,,0,0,0,,Құлаққапты киюім керек пе?
Dialogue: 0,0:13:54.41,0:13:56.36,JPN,,0,0,0,,А, жоқ, онша алысқа барудың қажеті жоқ...
Dialogue: 0,0:13:56.72,0:13:57.69,JPN,,0,0,0,,Сонда бұл
Dialogue: 0,0:13:57.88,0:13:59.23,JPN,,0,0,0,,Әйтеуір, оның қандай жақсылығы бар?
Dialogue: 0,0:14:04.76,0:14:06.90,JPN,,0,0,0,,Міне, адамдар аз.
Dialogue: 0,0:14:07.00,0:14:09.72,JPN,,0,0,0,,Айракчи өте сүйкімді
Dialogue: 0,0:14:09.81,0:14:10.87,JPN,,0,0,0,,Эй
Dialogue: 0,0:14:13.61,0:14:16.04,JPN,,0,0,0,,Уау, бұл өте қызықты.
Dialogue: 0,0:14:16.75,0:14:18.80,JPN,,0,0,0,,Мұндай жерлерге келу қиын.
Dialogue: 0,0:14:19.06,0:14:21.26,JPN,,0,0,0,,Мен Эллемен дос болғаныма қуаныштымын.
Dialogue: 0,0:14:22.49,0:14:24.64,JPN,,0,0,0,,Ендеше, анау-мынау айналайын.
Dialogue: 0,0:14:34.95,0:14:36.15,JPN,,0,0,0,,Цуцукаса
Dialogue: 0,0:14:36.65,0:14:37.40,JPN,,0,0,0,,Цукаса
Dialogue: 0,0:14:38.50,0:14:39.57,JPN,,0,0,0,,Бұл ауырады
Dialogue: 0,0:14:42.77,0:14:44.74,JPN,,0,0,0,,Мен және Элле ғана емес пе?
Dialogue: 0,0:14:45.00,0:14:46.91,JPN,,0,0,0,,Сіз де Исланы суретке түсіруіңіз керек.
Dialogue: 0,0:14:48.22,0:14:49.16,JPN,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:14:49.47,0:14:50.24,JPN,,0,0,0,,Энди
Dialogue: 0,0:14:50.36,0:14:51.75,JPN,,0,0,0,,Бірдеңе ішейік.
Dialogue: 0,0:14:51.90,0:14:53.58,JPN,,0,0,0,,Ұнату Сізде не бар?
Dialogue: 0,0:14:54.52,0:14:55.50,JPN,,0,0,0,,Ираны көріп тұрсың ба?
Dialogue: 0,0:14:56.19,0:14:57.84,JPN,,0,0,0,,Олар жақсы әпкелер сияқты.
Dialogue: 0,0:15:01.88,0:15:02.63,JPN,,0,0,0,,Жақсы
Dialogue: 0,0:15:02.94,0:15:05.05,JPN,,0,0,0,,Қарсы болмасаңыз, мен Исланы да суретке түсіріп аламын.
Dialogue: 0,0:15:05.34,0:15:07.72,JPN,,0,0,0,,Қате Мен сізді анық ести алмадым.
Dialogue: 0,0:15:08.02,0:15:10.10,JPN,,0,0,0,,Қайталап айтыңыз
Dialogue: 0,0:15:10.56,0:15:12.14,JPN,,0,0,0,,Ал, фото.
Dialogue: 0,0:15:12.14,0:15:12.60,JPN,,0,0,0,,Қате
Dialogue: 0,0:15:12.98,0:15:13.56,JPN,,0,0,0,,Мими-уэ отырған вагонда әйелді мазалаған бір ер адам құлап қалды.
Dialogue: 0,0:15:13.56,0:15:14.10,JPN,,0,0,0,,Қате
Dialogue: 0,0:15:14.88,0:15:16.65,JPN,,0,0,0,,Көңіл-күйіңіз нашар ма?
Dialogue: 0,0:15:17.59,0:15:20.02,JPN,,0,0,0,,Екеуіңіз де мынаны қараңыздаршы.
Dialogue: 0,0:15:20.52,0:15:21.44,JPN,,0,0,0,,Бұл не?
Dialogue: 0,0:15:21.70,0:15:22.99,JPN,,0,0,0,,Медузаның шырыны
Dialogue: 0,0:15:23.34,0:15:26.45,JPN,,0,0,0,,Бұл карнавалдың әйгілі сусыны болса керек.
Dialogue: 0,0:15:26.62,0:15:28.28,JPN,,0,0,0,,Дәмін елестете алмаймын.
Dialogue: 0,0:15:28.66,0:15:30.83,JPN,,0,0,0,,Оны ішкен кезде түсінесің.
Dialogue: 0,0:15:31.34,0:15:34.33,JPN,,0,0,0,,А, сен Эндиді тоқтатуың керек...
Dialogue: 0,0:15:35.26,0:15:37.25,JPN,,0,0,0,,Иә, бұл дәмді.
Dialogue: 0,0:15:37.44,0:15:39.46,JPN,,0,0,0,,Бұл менің бірінші дәмім, бірақ жаман емес.
Dialogue: 0,0:15:40.38,0:15:41.88,JPN,,0,0,0,,Солай ма?
Dialogue: 0,0:15:42.24,0:15:43.86,JPN,,0,0,0,,Жаман емес пе?
Dialogue: 0,0:15:43.96,0:15:44.46,JPN,,0,0,0,,Иә
Dialogue: 0,0:15:45.02,0:15:46.59,JPN,,0,0,0,,Сіз Элледе жақсы емессіз бе?
Dialogue: 0,0:15:46.73,0:15:48.09,JPN,,0,0,0,,Жақсы, жақсы
Dialogue: 0,0:15:48.84,0:15:50.55,JPN,,0,0,0,,Бұл не?
Dialogue: 0,0:15:50.73,0:15:51.85,JPN,,0,0,0,,Оны көргіңіз келе ме?
Dialogue: 0,0:15:52.22,0:15:53.22,JPN,,0,0,0,,Ой, шынымен бе? Қызық екен.
Dialogue: 0,0:15:54.71,0:15:56.10,JPN,,0,0,0,,Жүр, Исла, біз де барайық.
Dialogue: 0,0:15:57.36,0:15:58.77,JPN,,0,0,0,,Ауытқудан сақ болыңыз
Dialogue: 0,0:16:03.95,0:16:04.74,JPN,,0,0,0,,Мен...
Dialogue: 0,0:16:05.81,0:16:06.99,JPN,,0,0,0,,Бала емес
Dialogue: 0,0:16:07.43,0:16:08.45,JPN,,0,0,0,,Ауытқу…
Dialogue: 0,0:16:08.77,0:16:11.45,JPN,,0,0,0,,Цукаса-кун, мынаны да ішіп көр.
Dialogue: 0,0:16:11.68,0:16:13.99,JPN,,0,0,0,,Иә, бірақ бәрібір
Dialogue: 0,0:16:33.41,0:16:34.35,JPN,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:41.50,0:16:42.73,JPN,,0,0,0,,Бөлінген
Dialogue: 0,0:16:46.18,0:16:47.24,JPN,,0,0,0,,Ақымақ
Dialogue: 0,0:16:47.49,0:16:48.74,JPN,,0,0,0,,Ағай, тағы бір рет
Dialogue: 0,0:16:51.56,0:16:53.03,JPN,,0,0,0,,Энди көңілді жүрген сияқты.
Dialogue: 0,0:16:54.09,0:16:56.20,JPN,,0,0,0,,Сіз өте көп болдыңыз.
Dialogue: 0,0:16:56.93,0:16:57.70,JPN,,0,0,0,,Сонымен?
Dialogue: 0,0:16:58.03,0:17:00.17,JPN,,0,0,0,,Жад Ол қайтады деп ойлайсыз ба?
Dialogue: 0,0:17:03.30,0:17:05.92,JPN,,0,0,0,,Иә, бұл шындық.
Dialogue: 0,0:17:08.25,0:17:13.26,JPN,,0,0,0,,Мен келесі жылы бұл карнавалға келмеймін деп ойлаймын.
Dialogue: 0,0:17:15.00,0:17:19.91,JPN,,0,0,0,,Оның орнына Энди екеуміз басқа жерге барамыз.
Dialogue: 0,0:17:20.60,0:17:24.36,JPN,,0,0,0,,Эндимен, мен Оливиямен естеліктерімді бөліспеймін.
Dialogue: 0,0:17:24.66,0:17:27.55,JPN,,0,0,0,,Мен қазірден бастап жаңа естеліктер жасағым келеді.
Dialogue: 0,0:17:28.09,0:17:29.15,JPN,,0,0,0,,Әйтпесе
Dialogue: 0,0:17:29.65,0:17:32.61,JPN,,0,0,0,,Бұл Оливияға да, Эндиге де дөрекі емес пе?
Dialogue: 0,0:17:33.94,0:17:34.66,JPN,,0,0,0,,Элле мырза
Dialogue: 0,0:17:36.12,0:17:38.29,JPN,,0,0,0,,Бүгін маған қосылғаныңыз үшін рахмет.
Dialogue: 0,0:17:38.77,0:17:41.79,JPN,,0,0,0,,Сізге рахмет, мен де оны ұшырып жіберген шығармын.
Dialogue: 0,0:17:43.34,0:17:45.96,JPN,,0,0,0,,Мен оны жаруым керек пе?
Dialogue: 0,0:17:48.67,0:17:49.88,JPN,,0,0,0,,Сәлем Цукасачи
Dialogue: 0,0:17:50.50,0:17:53.26,JPN,,0,0,0,,Есте сақтаудың жалғыз уақыты - қазір.
Dialogue: 0,0:17:54.91,0:17:57.72,JPN,,0,0,0,,Тек осы сәт бар.
Dialogue: 0,0:17:59.72,0:18:01.73,JPN,,0,0,0,,Енді осы сәт
Dialogue: 0,0:18:09.30,0:18:10.07,JPN,,0,0,0,,Отшашу…
Dialogue: 0,0:18:11.94,0:18:13.07,JPN,,0,0,0,,О, Исла
Dialogue: 0,0:18:13.19,0:18:15.62,JPN,,0,0,0,,Мүмкін ол жолдан шығып кеткен шығар.
Dialogue: 0,0:18:15.90,0:18:16.91,JPN,,0,0,0,,Мен оны іздеймін.
Dialogue: 0,0:18:28.88,0:18:30.88,JPN,,0,0,0,,Қатты бала
Dialogue: 0,0:19:35.30,0:19:35.99,JPN,,0,0,0,,Ира
Dialogue: 0,0:19:42.80,0:19:45.21,JPN,,0,0,0,,Сізді жалғыз қалдырғаным үшін кешіріңіз.
Dialogue: 0,0:19:49.72,0:19:51.67,JPN,,0,0,0,,Себебі сіз оны таптыңыз
Dialogue: 0,0:20:06.34,0:20:07.94,JPN,,0,0,0,,Дыбыс керемет, солай емес пе?
Dialogue: 0,0:20:29.81,0:20:31.04,JPN,,0,0,0,,Сәлем Цукаса
Dialogue: 0,0:20:32.82,0:20:35.90,JPN,,0,0,0,,Эндидің жады қайта оралмады, солай ма?
Dialogue: 0,0:20:37.79,0:20:39.01,JPN,,0,0,0,,Неліктен бұл?
Dialogue: 0,0:20:39.67,0:20:43.18,JPN,,0,0,0,,Мүмкін мен Цукасаны қинап жатқан шығармын?
Dialogue: 0,0:20:43.80,0:20:45.77,JPN,,0,0,0,,Олай болса, айтыңызшы.
Dialogue: 0,0:20:47.60,0:20:50.60,JPN,,0,0,0,,Мен тіпті Цукасаны қинадым
Dialogue: 0,0:20:52.40,0:20:55.48,JPN,,0,0,0,,Мен саған серіктес болғым келмейді.
Dialogue: 0,0:21:05.66,0:21:07.62,JPN,,0,0,0,,Ау, ауырып тұр.
Dialogue: 0,0:21:08.20,0:21:11.17,JPN,,0,0,0,,Ауыртып, сыздап, жүрегім жарылып кетердей.
Dialogue: 0,0:21:12.12,0:21:13.54,JPN,,0,0,0,,Әлі де I
Dialogue: 0,0:21:15.24,0:21:17.42,JPN,,0,0,0,,Мен Айраның мәңгі серіктесі болғым келеді.
Dialogue: 0,0:21:18.98,0:21:20.77,JPN,,0,0,0,,Неге сонша?
Dialogue: 0,0:21:20.92,0:21:22.05,JPN,,0,0,0,,Неліктен?
Dialogue: 0,0:21:22.15,0:21:22.97,JPN,,0,0,0,,Солай ма...
Dialogue: 0,0:21:26.12,0:21:27.06,JPN,,0,0,0,,Солай ма...
Dialogue: 0,0:21:33.51,0:21:36.86,JPN,,0,0,0,,Өйткені маған Исла ұнайды.
Dialogue: 0,0:23:13.14,0:23:15.71,JPN,,0,0,0,,Өйткені маған Айра ұнайды
Dialogue: 0,0:23:22.49,0:23:25.47,JPN,,0,0,0,,Уау, айттың ғой!
Dialogue: 0,0:23:26.14,0:23:27.10,JPN,,0,0,0,,Ә? Рика?
Dialogue: 0,0:23:42.72,0:23:43.94,JPN,,0,0,0,,Ммммм
Dialogue: 0,0:23:44.91,0:23:46.15,JPN,,0,0,0,,Мен темекі шегуді тастадым
Dialogue: 0,0:23:52.42,0:23:56.25,JPN,,0,0,0,,Неліктен?
Dialogue: 0,0:23:57.75,0:24:03.75,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
