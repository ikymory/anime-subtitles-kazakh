Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.36,0:00:03.94,OPJP,,0,0,0,,Жарықты жинау
Dialogue: 0,0:00:11.95,0:00:16.45,OPJP,,0,0,0,,Қоштасудан естеліктер
Dialogue: 0,0:00:17.54,0:00:23.63,OPJP,,0,0,0,,Көзіме тамсанып, алысқа қадалған арман
Dialogue: 0,0:00:23.80,0:00:29.05,OPJP,,0,0,0,,Ән жады бұзылады
Dialogue: 0,0:00:29.34,0:00:34.47,OPJP,,0,0,0,,Жалғыздықтың көз жасын ақырын сүртейік
Dialogue: 0,0:00:34.76,0:00:41.65,OPJP,,0,0,0,,Ұзартылған қол - айналмалы дөңгелек, оны абайлап алыңыз
Dialogue: 0,0:00:41.98,0:00:46.94,OPJP,,0,0,0,,Оянғалы тұрған жадының үзінділері
Dialogue: 0,0:00:47.94,0:00:52.87,OPJP,,0,0,0,,Мен төмен қарап, жоқ болып кетсін деп дұға етемін, бірақ
Dialogue: 0,0:00:52.95,0:00:58.96,OPJP,,0,0,0,,Бұл сіз тапқан дауыс
Dialogue: 0,0:00:59.25,0:01:05.96,OPJP,,0,0,0,,Сағат тілі қозғала бастайды, көп ұзамай дүниенің түсі өзгереді
Dialogue: 0,0:01:06.25,0:01:12.14,OPJP,,0,0,0,,Менің пластикалық жүрегім жарқырайды
Dialogue: 0,0:01:12.43,0:01:17.06,OPJP,,0,0,0,,Ұмытпа, есте сақта
Dialogue: 0,0:01:17.47,0:01:23.94,OPJP,,0,0,0,,Бір күні тағы кездескенше
Dialogue: 0,0:22:21.15,0:22:24.49,EDJP,,0,0,0,,Ажырасқан сені іздедім.
Dialogue: 0,0:22:24.75,0:22:28.25,EDJP,,0,0,0,,Мені шақырған дауыс өшіп қалды
Dialogue: 0,0:22:28.45,0:22:35.85,EDJP,,0,0,0,,Мен ұстаған қол дірілдеп тұрды.
Dialogue: 0,0:22:36.33,0:22:39.85,EDJP,,0,0,0,,Біздің сезімдер
Dialogue: 0,0:22:40.05,0:22:45.05,EDJP,,0,0,0,,Қайтаруға болмайтын уақытты қабыл алыңыз
Dialogue: 0,0:22:45.26,0:22:49.76,EDJP,,0,0,0,,Мен биікте ұшамын
Dialogue: 0,0:22:50.56,0:22:54.15,EDJP,,0,0,0,,Аспанда жарқыраған калейдоскоп
Dialogue: 0,0:22:54.35,0:22:58.15,EDJP,,0,0,0,,Сіз ыңғайсызданып күлдіңіз.
Dialogue: 0,0:22:58.46,0:23:04.15,EDJP,,0,0,0,,Махаббатқа толы
Dialogue: 0,0:23:05.35,0:23:08.91,EDJP,,0,0,0,,Жарық ерігенге дейін
Dialogue: 0,0:23:09.05,0:23:12.05,EDJP,,0,0,0,,Мен шын жүректен үміттенемін
Dialogue: 0,0:23:12.25,0:23:24.25,EDJP,,0,0,0,,Осы сәтті мәңгі естен шығарма
Dialogue: 0,0:01:57.91,0:02:00.58,JPN,,0,0,0,,Әке, мен біраз уақыт Исланы сұрайын.
Dialogue: 0,0:02:00.82,0:02:02.13,JPN,,0,0,0,,Сіз жалғыз барасыз ба?
Dialogue: 0,0:02:02.63,0:02:04.09,JPN,,0,0,0,,Қолдау күткен жөн
Dialogue: 0,0:02:06.28,0:02:07.36,JPN,,0,0,0,,бірақ мұнда қатты шу, иә?
Dialogue: 0,0:02:13.74,0:02:16.10,JPN,,0,0,0,,Бұл аяқ енді жақсы емес, оны кесіп тастаудан басқа амалым жоқ.
Dialogue: 0,0:02:31.35,0:02:32.26,JPN,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:36.21,0:02:39.61,JPN,,0,0,0,,Мен сіздермен жұмыс істеген кездегі естеліктерді ешқашан ұмытпаймын.
Dialogue: 0,0:02:40.48,0:02:42.96,JPN,,0,0,0,,Бірақ мен енді сенімен жұмыс істемеймін.
Dialogue: 0,0:03:18.58,0:03:21.68,JPN,,0,0,0,,Марсияға қатысты ынтымақтастық үшін барлығыңызға рахмет.
Dialogue: 0,0:03:22.32,0:03:24.05,JPN,,0,0,0,,Нәтиже осындай болды.
Dialogue: 0,0:03:24.53,0:03:27.85,JPN,,0,0,0,,Қарапайым халықтың араласпағаны бір бақыт еді.
Dialogue: 0,0:03:28.23,0:03:30.72,JPN,,0,0,0,,Ал қараңғы коллектор туралы.
Dialogue: 0,0:03:31.37,0:03:33.76,JPN,,0,0,0,,R.SECURITY-пен бірлесіп
Dialogue: 0,0:03:33.77,0:03:37.06,JPN,,0,0,0,,Маған бас кеңседен телефон соғып, барлығын сүртіп тастайтындарын айтты.
Dialogue: 0,0:03:37.68,0:03:40.39,JPN,,0,0,0,,Қалай болғанда да, осы мәселеге қатысты
Dialogue: 0,0:03:40.60,0:03:42.87,JPN,,0,0,0,,Жауапты Цукаса мен Исла кінәлі емес.
Dialogue: 0,0:04:26.70,0:04:27.46,JPN,,0,0,0,,Цукаса…
Dialogue: 0,0:04:33.00,0:04:33.54,JPN,,0,0,0,,Ира
Dialogue: 0,0:04:34.80,0:04:35.68,JPN,,0,0,0,,Ира
Dialogue: 0,0:04:37.01,0:04:39.18,JPN,,0,0,0,,Эй, сен мұны естідің бе, Цукаса?
Dialogue: 0,0:04:40.41,0:04:41.28,JPN,,0,0,0,,Иә
Dialogue: 0,0:04:41.40,0:04:43.10,JPN,,0,0,0,,Бұл сенің кінәң емес.
Dialogue: 0,0:04:43.26,0:04:46.26,JPN,,0,0,0,,Ешқандай жауапкершілікті өз мойныма алмаймын.
Dialogue: 0,0:04:46.64,0:04:50.29,JPN,,0,0,0,,Осылайша сіз Исла оқиға орнына оралғанша кеңседе күту режимінде боласыз.
Dialogue: 0,0:04:50.64,0:04:51.35,JPN,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:04:52.45,0:04:52.95,JPN,,0,0,0,,Иә
Dialogue: 0,0:04:53.57,0:04:54.53,JPN,,0,0,0,,Содан кейін тараңыз
Dialogue: 0,0:05:17.92,0:05:18.62,JPN,,0,0,0,,Цукаса?
Dialogue: 0,0:05:20.44,0:05:21.24,JPN,,0,0,0,,Сіз ояндыңыз ба?
Dialogue: 0,0:05:21.88,0:05:23.86,JPN,,0,0,0,,Түні бойы менімен бірге болуды талап ет.
Dialogue: 0,0:05:24.15,0:05:25.20,JPN,,0,0,0,,Ол қыңыр жігіт.
Dialogue: 0,0:05:26.36,0:05:27.88,JPN,,0,0,0,,Ертең көшуге болады.
Dialogue: 0,0:05:28.00,0:05:30.85,JPN,,0,0,0,,Сіздің денеңіз әлдеқашан тозған.
Dialogue: 0,0:05:31.48,0:05:33.61,JPN,,0,0,0,,Реттеуге бірнеше күн қажет
Dialogue: 0,0:05:45.05,0:05:46.58,JPN,,0,0,0,,Мен енді сізбен жұмыс істемеймін.
Dialogue: 0,0:06:09.62,0:06:10.95,JPN,,0,0,0,,Ах, қайырлы таң.
Dialogue: 0,0:06:11.19,0:06:12.02,JPN,,0,0,0,,Қазір сағат неше?
Dialogue: 0,0:06:12.29,0:06:13.30,JPN,,0,0,0,,Әлі түнде
Dialogue: 0,0:06:13.52,0:06:15.41,JPN,,0,0,0,,Егер ұйықтағың келсе, жатақханаға қайту керек.
Dialogue: 0,0:06:15.64,0:06:16.65,JPN,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:06:18.42,0:06:20.07,JPN,,0,0,0,,Мен Исланың қауіпсіз болғанына қуаныштымын.
Dialogue: 0,0:06:20.47,0:06:22.79,JPN,,0,0,0,,Мен екі күн ұйықтамадым.
Dialogue: 0,0:06:23.27,0:06:24.20,JPN,,0,0,0,,Қарияға арналған
Dialogue: 0,0:06:24.79,0:06:27.38,JPN,,0,0,0,,«Бәрекелді, сен маған керек емессің, шықшы».
Dialogue: 0,0:06:27.58,0:06:29.70,JPN,,0,0,0,,Мен мас болдым.
Dialogue: 0,0:06:30.79,0:06:31.91,JPN,,0,0,0,,Мен өзімді мазасыз сезінемін.
Dialogue: 0,0:06:32.81,0:06:33.50,JPN,,0,0,0,,Мазасыздық?
Dialogue: 0,0:06:33.75,0:06:37.34,JPN,,0,0,0,,Бұлай жалғаса берсе, Исла енді ешқашан оянбайды.
Dialogue: 0,0:06:39.72,0:06:41.44,JPN,,0,0,0,,Марша мен Сута ше?
Dialogue: 0,0:06:42.77,0:06:43.52,JPN,,0,0,0,,Жарайды
Dialogue: 0,0:06:44.15,0:06:46.12,JPN,,0,0,0,,Казуки-сан мен басқалардан да сізге еруін сұраңыз.
Dialogue: 0,0:06:46.45,0:06:48.12,JPN,,0,0,0,,Мен мұнда бәрін жасадым.
Dialogue: 0,0:06:49.40,0:06:50.32,JPN,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:50.88,0:06:53.14,JPN,,0,0,0,,Мен ештеңе істей алмадым
Dialogue: 0,0:06:53.41,0:06:54.90,JPN,,0,0,0,,Бұл туралы уайымдаудың қажеті жоқ
Dialogue: 0,0:06:56.66,0:06:58.42,JPN,,0,0,0,,Цукаса ше? Сенімен бәрі жақсы ма?
Dialogue: 0,0:07:01.90,0:07:04.32,JPN,,0,0,0,,Мазалағаныңызға рахмет.
Dialogue: 0,0:07:05.38,0:07:07.58,JPN,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,0:07:12.74,0:07:13.60,JPN,,0,0,0,,Неліктен?
Dialogue: 0,0:07:16.62,0:07:19.57,JPN,,0,0,0,,Сіз қалай күліп жүре аласыз?
Dialogue: 0,0:07:34.72,0:07:36.19,JPN,,0,0,0,,Жарайсың ба, Айракчи?
Dialogue: 0,0:07:36.60,0:07:38.85,JPN,,0,0,0,,Реттеу әлі аяқталған жоқ.
Dialogue: 0,0:07:39.09,0:07:42.40,JPN,,0,0,0,,Жұмысты аяқтаған соң, жатақханаға емес, осында үйге кел.
Dialogue: 0,0:07:43.93,0:07:46.97,JPN,,0,0,0,,Мен саған толық қамқорлық жасаймын.
Dialogue: 0,0:07:48.80,0:07:50.06,JPN,,0,0,0,,Енді түсіндім
Dialogue: 0,0:07:54.24,0:07:56.18,JPN,,0,0,0,,Исла-чан, жақсысың ба?
Dialogue: 0,0:07:56.54,0:07:59.81,JPN,,0,0,0,,Техникалық қызмет көрсету тобы біраз түзетуді қажет ететінін айтты.
Dialogue: 0,0:07:57.77,0:07:58.57,JPN_Up,,0,0,0,,Қайырлы таң
Dialogue: 0,0:07:59.18,0:08:00.34,JPN_Up,,0,0,0,,Қайырлы таң
Dialogue: 0,0:08:00.85,0:08:01.50,JPN,,0,0,0,,Қайырлы таң
Dialogue: 0,0:08:01.89,0:08:02.97,JPN,,0,0,0,,Қайырлы таң
Dialogue: 0,0:08:03.46,0:08:05.97,JPN,,0,0,0,,Исла-чан, маған шай берші.
Dialogue: 0,0:08:14.97,0:08:16.49,JPN,,0,0,0,,Әрқашан жаман
Dialogue: 0,0:08:20.58,0:08:20.99,JPN,,0,0,0,,Бұл Миямура-кун емес пе!
Dialogue: 0,0:08:20.99,0:08:22.10,JPN,,0,0,0,,Эй, Цукаса
Dialogue: 0,0:08:22.30,0:08:24.32,JPN,,0,0,0,,Ендеше, бүгін менімен бірге ішуге шығайық.
Dialogue: 0,0:08:24.36,0:08:27.73,JPN,,0,0,0,,Мен сені көптеген сүйкімді ханымдары бар дүкенге апарамын.
Dialogue: 0,0:08:27.82,0:08:28.57,JPN,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:08:28.80,0:08:32.05,JPN,,0,0,0,,Мен кәмелеттік жасқа толмаған екенімді айттым ғой.
Dialogue: 0,0:08:32.20,0:08:35.62,JPN,,0,0,0,,Ясутака Өтінемін, таңертең олай сөйлеме.
Dialogue: 0,0:08:35.93,0:08:37.74,JPN,,0,0,0,,Әй, лас арам.
Dialogue: 0,0:08:38.12,0:08:39.71,JPN,,0,0,0,,Зак ондай болуы мүмкін емес.
Dialogue: 0,0:08:39.98,0:08:40.98,JPN,,0,0,0,,Yes
Dialogue: 0,0:08:41.64,0:08:44.84,JPN,,0,0,0,,Менің әйел қызметкерім әлі күнге дейін аздап қаншық.
Dialogue: 0,0:08:46.13,0:08:48.32,JPN,,0,0,0,,Исла, сен маған ғашық болып қалдың ба?
Dialogue: 0,0:08:48.50,0:08:49.52,JPN,,0,0,0,,Келесі жолы кездесуге барамыз ба?
Dialogue: 0,0:08:49.71,0:08:51.85,JPN,,0,0,0,,Қате Мен Ясутаканы көрген жоқпын.
Dialogue: 0,0:08:51.90,0:08:55.85,JPN,,0,0,0,,О, менің шыны жүрегім енді қатты және қатты жараланды.
Dialogue: 0,0:08:56.09,0:08:59.69,JPN,,0,0,0,,Цукаса, мені жұбату үшін ішіп алайық.
Dialogue: 0,0:09:00.28,0:09:02.34,JPN,,0,0,0,,Маған үзіліс беріңізші.
Dialogue: 0,0:09:07.28,0:09:08.93,JPN,,0,0,0,,Ах, Айра-чан, шай.
Dialogue: 0,0:09:09.07,0:09:09.70,JPN,,0,0,0,,Толып кету
Dialogue: 0,0:09:10.56,0:09:11.70,JPN,,0,0,0,,А, құжаттар...
Dialogue: 0,0:09:11.82,0:09:12.49,JPN,,0,0,0,,«Қиын екен.»
Dialogue: 0,0:09:12.62,0:09:13.61,JPN,,0,0,0,,Тек L өз ықпалындағы біреумен алмастырылған
Dialogue: 0,0:09:14.26,0:09:15.25,JPN,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:26.51,0:09:27.49,JPN,,0,0,0,,Қайырлы таң Ира
Dialogue: 0,0:09:28.61,0:09:31.84,JPN,,0,0,0,,Жұмысқа бөлек барғанда біртүрлі нәрсе бар.
Dialogue: 0,0:09:32.58,0:09:34.48,JPN,,0,0,0,,Соңғы уақытта біз жиі бірге болдық.
Dialogue: 0,0:09:35.24,0:09:37.47,JPN,,0,0,0,,Цукаса күлімсіреп жақсы көрінеді
Dialogue: 0,0:09:38.35,0:09:40.14,JPN,,0,0,0,,Кю... Кенеттен не болды?
Dialogue: 0,0:09:40.22,0:09:41.85,JPN,,0,0,0,,Мені бір нәрсе таң қалдырды.
Dialogue: 0,0:09:42.53,0:09:43.69,JPN,,0,0,0,,Бірақ рахмет
Dialogue: 0,0:09:46.76,0:09:49.74,JPN,,0,0,0,,Исла: Цукаса саған біртүрлі нәрсе жасады ма?
Dialogue: 0,0:09:51.24,0:09:54.05,JPN,,0,0,0,,Уайымдама, біз сенің жаныңдамыз
Dialogue: 0,0:09:54.09,0:09:57.09,JPN,,0,0,0,,Дұрыс, мен де әңгімені естідім.
Dialogue: 0,0:09:57.34,0:09:59.79,JPN,,0,0,0,,Жүрегі таза Айракчиді азғырсаң, кешіру қиын.
Dialogue: 0,0:09:59.79,0:10:03.49,JPN,,0,0,0,,Жағдайға байланысты мен оны осы жолы жатақханадан шығаруды қарастыруым мүмкін.
Dialogue: 0,0:10:03.56,0:10:06.38,JPN,,0,0,0,,Жүр, Айракчи, менімен сөйлесші.
Dialogue: 0,0:10:06.67,0:10:07.53,JPN,,0,0,0,,Келіңіздер
Dialogue: 0,0:10:07.87,0:10:08.69,JPN,,0,0,0,,Келіңіздер
Dialogue: 0,0:10:11.05,0:10:12.74,JPN,,0,0,0,,Мен... жай ғана...
Dialogue: 0,0:10:13.34,0:10:14.03,JPN,,0,0,0,,Тек?
Dialogue: 0,0:10:16.18,0:10:18.67,JPN,,0,0,0,,Мен Цукаса үшін алаңдаймын.
Dialogue: 0,0:10:19.41,0:10:19.78,JPN,,0,0,0,,Иә?
Dialogue: 0,0:10:21.78,0:10:22.72,JPN,,0,0,0,,Байқасаңыз
Dialogue: 0,0:10:23.12,0:10:25.49,JPN,,0,0,0,,Мен Цукасаның артынан көзіммен қарай бастадым.
Dialogue: 0,0:10:26.04,0:10:28.94,JPN,,0,0,0,,Соңғы уақытқа дейін бұл мені онша мазалаған жоқ.
Dialogue: 0,0:10:29.48,0:10:31.91,JPN,,0,0,0,,Ал, сіз нені айтып тұрсыз?
Dialogue: 0,0:10:32.07,0:10:34.68,JPN,,0,0,0,,Айракчи Бұл бір нәрсе деп аталады.
Dialogue: 0,0:10:34.88,0:10:36.20,JPN,,0,0,0,,Бұл махаббат деп аталады.
Dialogue: 0,0:10:36.68,0:10:37.09,JPN,,0,0,0,,Сүйіспеншілік пе?
Dialogue: 0,0:10:37.61,0:10:39.08,JPN,,0,0,0,,А, махаббат?
Dialogue: 0,0:10:40.21,0:10:41.08,JPN,,0,0,0,,Бұл махаббат па?
Dialogue: 0,0:10:41.40,0:10:42.58,JPN,,0,0,0,,Жоқ, мүмкін емес...
Dialogue: 0,0:10:42.58,0:10:46.08,JPN,,0,0,0,,Егер солай болса, мен Айракчимен ынтымақтасуға бар күшімді саламын.
Dialogue: 0,0:10:46.82,0:10:47.68,JPN,,0,0,0,,Атап айтқанда
Dialogue: 0,0:10:47.80,0:10:49.97,JPN,,0,0,0,,Цукасаччиге тәулік бойы бақылау жасаңыз.
Dialogue: 0,0:10:50.02,0:10:52.84,JPN,,0,0,0,,Цукасачи экологиясын толық түсіну.
Dialogue: 0,0:10:53.00,0:10:54.29,JPN,,0,0,0,,Экология дегеніміз не?
Dialogue: 0,0:10:54.41,0:10:57.34,JPN,,0,0,0,,Сіз аңдыушы болуға бір қадам қалдыңыз.
Dialogue: 0,0:10:57.64,0:11:01.10,JPN,,0,0,0,,Өзіңізге ұнайтын адам туралы бәрін білгіңіз келсе көмектесе алмайды.
Dialogue: 0,0:11:01.23,0:11:03.49,JPN,,0,0,0,,Менің де тәжірибем бар, сондықтан түсінемін.
Dialogue: 0,0:11:03.74,0:11:05.85,JPN,,0,0,0,,Тергеу ертең бірден басталады.
Dialogue: 0,0:11:06.88,0:11:08.68,JPN,,0,0,0,,Өйткені мен кездеспеймін.
Dialogue: 0,0:11:16.84,0:11:19.87,JPN,,0,0,0,,Қызық, Цукасачи не оқып жатыр?
Dialogue: 0,0:11:20.51,0:11:22.22,JPN,,0,0,0,,Мүмкін менің күнделігім шығар
Dialogue: 0,0:11:22.32,0:11:24.64,JPN,,0,0,0,,Айракчи сізге оқуға рұқсат берді ме?
Dialogue: 0,0:11:24.82,0:11:26.51,JPN,,0,0,0,,Неліктен мұндай батыл еліктеу керек?
Dialogue: 0,0:11:26.84,0:11:30.46,JPN,,0,0,0,,Маған Терминал қызметтерінде жұмыс істеу ережелері туралы білу сұралды.
Dialogue: 0,0:11:30.64,0:11:31.46,JPN,,0,0,0,,Жай ғана қарызға бердім
Dialogue: 0,0:11:32.16,0:11:34.68,JPN,,0,0,0,,Оқу - бұл ең жылдам әдіс.
Dialogue: 0,0:11:34.88,0:11:39.07,JPN,,0,0,0,,Онда Айракчи туралы бәрі анық жазылған.
Dialogue: 0,0:11:39.20,0:11:41.81,JPN,,0,0,0,,Қандай қызғанышпен мен де оқығым келеді
Dialogue: 0,0:11:42.14,0:11:44.37,JPN,,0,0,0,,Менің ойымша, бұл ерекше қызық емес.
Dialogue: 0,0:11:44.52,0:11:46.21,JPN,,0,0,0,,Иә, солай ма?
Dialogue: 0,0:11:46.29,0:11:49.61,JPN,,0,0,0,,Бірақ Цукасачи оны оқып отырып күледі.
Dialogue: 0,0:11:49.70,0:11:50.75,JPN,,0,0,0,,Бұл жиіркенішті
Dialogue: 0,0:11:51.08,0:11:53.15,JPN,,0,0,0,,Олай десеңіз, L да өте жақсы...
Dialogue: 0,0:11:57.49,0:11:59.38,JPN,,0,0,0,,Шери, не болды?
Dialogue: 0,0:11:59.84,0:12:02.24,JPN,,0,0,0,,Жоқ, біреудің маған қарап тұрғанын сездім.
Dialogue: 0,0:12:02.92,0:12:06.33,JPN,,0,0,0,,Сондай-ақ, қараңғы коллекционерлердің қалдықтары лаңкестік жоспар құруы мүмкін ...
Dialogue: 0,0:12:06.57,0:12:07.81,JPN,,0,0,0,,Менің кеңсемде ме?
Dialogue: 0,0:12:08.10,0:12:10.94,JPN,,0,0,0,,Егер мен осындай бірдеңе жасайтын болсам, мен штаб ғимаратын көздегенім жөн.
Dialogue: 0,0:12:11.46,0:12:14.96,JPN,,0,0,0,,Шери бейтаныс көздерден өте сақ.
Dialogue: 0,0:12:17.65,0:12:19.21,JPN,,0,0,0,,Бұған кім себеп болды?
Dialogue: 0,0:12:20.94,0:12:22.87,JPN,,0,0,0,,Мүмкін мен шығармын?
Dialogue: 0,0:12:23.20,0:12:25.54,JPN,,0,0,0,,Шери, бұл қорқынышты.
Dialogue: 0,0:12:25.68,0:12:28.48,JPN,,0,0,0,,Шерри Казукиге қарағанда әлдеқайда қорқынышты
Dialogue: 0,0:12:28.70,0:12:31.00,JPN,,0,0,0,,Мен мұндай нәрседен бас тартпаймын.
Dialogue: 0,0:12:31.14,0:12:33.42,JPN,,0,0,0,,Келесі, келесі, кеттік, Айракчи.
Dialogue: 0,0:12:33.52,0:12:34.45,JPN,,0,0,0,,Сіз мұны әлі істеп жатырсыз ба?
Dialogue: 0,0:12:36.84,0:12:38.92,JPN,,0,0,0,,Мен енді сенімен бірге шықпаймын.
Dialogue: 0,0:12:42.31,0:12:45.64,JPN,,0,0,0,,Менің қызым жақында жігіт тапқан сияқты.
Dialogue: 0,0:12:45.84,0:12:47.26,JPN,,0,0,0,,Бұл керемет емес пе?
Dialogue: 0,0:12:47.39,0:12:48.85,JPN,,0,0,0,,Жақсы емес
Dialogue: 0,0:12:49.30,0:12:50.09,JPN,,0,0,0,,Өйткені
Dialogue: 0,0:12:56.11,0:12:56.80,JPN,,0,0,0,,Мен саған көмектесемін
Dialogue: 0,0:12:57.59,0:12:58.39,JPN,,0,0,0,,Солай ма?
Dialogue: 0,0:12:58.58,0:12:59.51,JPN,,0,0,0,,Рахмет
Dialogue: 0,0:13:01.17,0:13:02.80,JPN,,0,0,0,,О, абай бол.
Dialogue: 0,0:13:03.22,0:13:04.58,JPN,,0,0,0,,Бұл өте ауыр.
Dialogue: 0,0:13:05.69,0:13:07.41,JPN,,0,0,0,,Хаха, тым кеш.
Dialogue: 0,0:13:07.48,0:13:08.55,JPN,,0,0,0,,Күлме
Dialogue: 0,0:13:08.94,0:13:10.02,JPN,,0,0,0,,Мені құтқар
Dialogue: 0,0:13:14.26,0:13:17.37,JPN,,0,0,0,,Жүріңдер, балалар көбірек ішіңдер.
Dialogue: 0,0:13:17.48,0:13:19.68,JPN,,0,0,0,,Мен шырын ішіп жатырмын.
Dialogue: 0,0:13:20.41,0:13:23.21,JPN,,0,0,0,,Цукаса-кун, алдымен кешірім сұраймын.
Dialogue: 0,0:13:23.65,0:13:24.98,JPN,,0,0,0,,Әйелім маған ашуланады.
Dialogue: 0,0:13:25.16,0:13:26.36,JPN,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:13:26.62,0:13:27.95,JPN,,0,0,0,,Жарайды, өтінемін.
Dialogue: 0,0:13:28.29,0:13:29.69,JPN,,0,0,0,,Кешіріңіз, мен риза боламын.
Dialogue: 0,0:13:31.24,0:13:33.19,JPN,,0,0,0,,Эй, Лен қайда кетті?
Dialogue: 0,0:13:33.46,0:13:35.72,JPN,,0,0,0,,Жүр, бұл әжетхана емес пе?
Dialogue: 0,0:13:36.02,0:13:38.32,JPN,,0,0,0,,Оның орнына, Казуки-сан, сен тым көп ішіп кетіпсің.
Dialogue: 0,0:13:38.46,0:13:41.22,JPN,,0,0,0,,Мәселе жоқ, Цукаса.
Dialogue: 0,0:13:41.60,0:13:43.72,JPN,,0,0,0,,Сен қандайсың...
Dialogue: 0,0:13:46.01,0:13:49.02,JPN,,0,0,0,,Мен сенімен түні бойы тұруға мәжбүр боламын деп ешқашан ойламадым.
Dialogue: 0,0:14:13.85,0:14:14.63,JPN,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:16.16,0:14:18.72,JPN,,0,0,0,,Мұндай жерде қандай таңғаларлық сәйкестік.
Dialogue: 0,0:14:24.06,0:14:26.93,JPN,,0,0,0,,Цукасачи кездейсоқ болды.
Dialogue: 0,0:14:27.16,0:14:29.22,JPN,,0,0,0,,Бұл жай ғана кездейсоқтық.
Dialogue: 0,0:14:29.92,0:14:30.96,JPN,,0,0,0,,Мүлдем
Dialogue: 0,0:14:31.13,0:14:33.29,JPN,,0,0,0,,Эллмен жүрудің қажеті жоқ.
Dialogue: 0,0:14:33.53,0:14:37.29,JPN,,0,0,0,,Бірақ сен мен туралы қатты ойладың.
Dialogue: 0,0:14:38.35,0:14:41.13,JPN,,0,0,0,,Цукаса сізді не мазалайды?
Dialogue: 0,0:14:45.03,0:14:47.29,JPN,,0,0,0,,Марсияға қатысты оқиға жақында болды.
Dialogue: 0,0:14:47.66,0:14:50.90,JPN,,0,0,0,,Цукаса, сенің неге әлі күліп тұрғаныңды білмеймін.
Dialogue: 0,0:14:51.76,0:14:54.49,JPN,,0,0,0,,Мен оның шошып кеткеніне сенімдімін.
Dialogue: 0,0:14:57.14,0:15:00.15,JPN,,0,0,0,,Цукаса ұмытып кеткен шығар.
Dialogue: 0,0:15:00.56,0:15:04.52,JPN,,0,0,0,,Адамдарда ыңғайлы ұмытылатын функциялар бар ма?
Dialogue: 0,0:15:05.30,0:15:07.61,JPN,,0,0,0,,Бірақ мен бұл туралы ешқашан естіген емеспін.
Dialogue: 0,0:15:08.70,0:15:11.00,JPN,,0,0,0,,Цукаса қазір өзін қалай сезінеді?
Dialogue: 0,0:15:11.22,0:15:11.96,JPN,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:15:16.59,0:15:20.06,JPN,,0,0,0,,Кадзуки-сан екеуміз Соутакунның орнына бардық.
Dialogue: 0,0:15:21.38,0:15:23.35,JPN,,0,0,0,,Саған түсіндірейін, Марсия.
Dialogue: 0,0:15:24.15,0:15:26.66,JPN,,0,0,0,,Сол кезде Цукаса сонда болды.
Dialogue: 0,0:15:28.39,0:15:31.09,JPN,,0,0,0,,Ол кеңседе күту керек еді.
Dialogue: 0,0:15:31.29,0:15:33.48,JPN,,0,0,0,,Мен Сута-куннан кешірім сұрауға жалғыз бардым.
Dialogue: 0,0:15:42.63,0:15:44.36,JPN,,0,0,0,,Сәлем Цукаса-сан
Dialogue: 0,0:15:45.12,0:15:46.92,JPN,,0,0,0,,Марсия қайда кетті?
Dialogue: 0,0:15:47.64,0:15:51.90,JPN,,0,0,0,,Мен Марсиямен әлі қоштасқан жоқпын.
Dialogue: 0,0:15:55.61,0:15:56.78,JPN,,0,0,0,,Сен уәде бердің.
Dialogue: 0,0:15:57.10,0:15:59.92,JPN,,0,0,0,,Ол Машаны маған қайтарамын деді.
Dialogue: 0,0:16:01.93,0:16:02.48,JPN,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:03.74,0:16:05.77,JPN,,0,0,0,,Нацуки, ояндың ба әлі?
Dialogue: 0,0:16:06.69,0:16:07.38,JPN,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан Қабырғаны бұзып өтті,
Dialogue: 0,0:16:08.16,0:16:08.93,JPN,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан Қабырғаны бұзып өтті,
Dialogue: 0,0:16:09.19,0:16:11.04,JPN,,0,0,0,,Неге кешірім сұрайсыз?
Dialogue: 0,0:16:11.74,0:16:14.04,JPN,,0,0,0,,Маған Марсиямен кездесуге рұқсат етіңіз
Dialogue: 0,0:16:14.86,0:16:16.54,JPN,,0,0,0,,Нацуки, ояндың ба әлі?
Dialogue: 0,0:16:18.95,0:16:19.82,JPN,,0,0,0,,Содан кейін
Dialogue: 0,0:16:20.25,0:16:24.57,JPN,,0,0,0,,Кадзуки-сан мені қалағанымды істемегенім үшін қатты ұрысты.
Dialogue: 0,0:16:24.74,0:16:25.70,JPN,,0,0,0,,Ол Касуканың жауы ғой, иә?
Dialogue: 0,0:16:27.59,0:16:31.35,JPN,,0,0,0,,Оның да ұмыта алмайтынына сенімдімін.
Dialogue: 0,0:16:32.52,0:16:34.65,JPN,,0,0,0,,Мен ұмытамын деп ойламаймын
Dialogue: 0,0:16:35.36,0:16:37.86,JPN,,0,0,0,,Сонда Цукаса неге күледі?
Dialogue: 0,0:16:38.25,0:16:40.58,JPN,,0,0,0,,Неге деп ойлаймын.
Dialogue: 0,0:16:42.33,0:16:44.72,JPN,,0,0,0,,Мүмкін мен мұңайғандықтан болар
Dialogue: 0,0:16:49.45,0:16:52.59,JPN,,0,0,0,,Мичиру мейірімді болған кезде мейірімді.
Dialogue: 0,0:16:53.05,0:16:55.28,JPN,,0,0,0,,Эй Айра, бұл нені білдіреді?
Dialogue: 0,0:17:00.33,0:17:01.24,JPN,,0,0,0,,Оото
Dialogue: 0,0:17:01.42,0:17:04.07,JPN,,0,0,0,,Бұл не, бастық мырза?
Dialogue: 0,0:17:04.22,0:17:05.30,JPN,,0,0,0,,Бұл кездейсоқтық емес пе?
Dialogue: 0,0:17:05.64,0:17:06.46,JPN,,0,0,0,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:17:06.65,0:17:08.09,JPN,,0,0,0,,Охисан ана
Dialogue: 0,0:17:09.85,0:17:11.57,JPN,,0,0,0,,Бұл осындай жерде жұмыс істей ме?
Dialogue: 0,0:17:11.73,0:17:13.81,JPN,,0,0,0,,Ол қызықсыз адам.
Dialogue: 0,0:17:14.21,0:17:16.18,JPN,,0,0,0,,Біреуге сәл шыдамдылықпен қарасаң
Dialogue: 0,0:17:16.71,0:17:20.92,JPN,,0,0,0,,Сіз мейрамханаларды қаттырақ ұнатпайсыз ба?
Dialogue: 0,0:17:21.43,0:17:23.74,JPN,,0,0,0,,Мен жақын жерден өтіп бара жатырмын.
Dialogue: 0,0:17:25.13,0:17:25.97,JPN,,0,0,0,,Бұл жағдай
Dialogue: 0,0:17:26.45,0:17:29.14,JPN,,0,0,0,,Сіз R.SECURITY-ге қатысыңыз.
Dialogue: 0,0:17:30.84,0:17:32.87,JPN,,0,0,0,,Менің өз жолым бар
Dialogue: 0,0:17:33.40,0:17:34.36,JPN,,0,0,0,,Бұл дегеніміз
Dialogue: 0,0:17:35.00,0:17:36.40,JPN,,0,0,0,,Ұлы болу деген нені білдіреді?
Dialogue: 0,0:17:36.97,0:17:38.65,JPN,,0,0,0,,Қиындық көп сияқты.
Dialogue: 0,0:17:42.07,0:17:44.25,JPN,,0,0,0,,Ира, бүгінге осы.
Dialogue: 0,0:17:44.64,0:17:46.00,JPN,,0,0,0,,Негізгі проблемалар жоқ
Dialogue: 0,0:17:46.39,0:17:49.70,JPN,,0,0,0,,Бұл ертең жұмысқа қайта бара алатынымды білдіре ме?
Dialogue: 0,0:17:49.91,0:17:50.37,JPN,,0,0,0,,Иә
Dialogue: 0,0:17:50.63,0:17:52.54,JPN,,0,0,0,,Бүгін кешке жатақханаңызға қайта аласыз.
Dialogue: 0,0:17:53.18,0:17:53.70,JPN,,0,0,0,,Иә
Dialogue: 0,0:17:54.24,0:17:54.87,JPN,,0,0,0,,Амансың ба?
Dialogue: 0,0:17:56.22,0:17:57.44,JPN,,0,0,0,,Өзіңізді қатты итермеңіз.
Dialogue: 0,0:17:57.74,0:17:59.21,JPN,,0,0,0,,Қатты болса, қатты деп айт.
Dialogue: 0,0:18:02.33,0:18:05.50,JPN,,0,0,0,,Мен жай ғана аяғымды сүйретіп жатырмын
Dialogue: 0,0:18:06.17,0:18:07.58,JPN,,0,0,0,,Мен жұмысқа орала аламын ба?
Dialogue: 0,0:18:08.22,0:18:09.72,JPN,,0,0,0,,Қайтып келмейсіз бе?
Dialogue: 0,0:18:12.52,0:18:15.06,JPN,,0,0,0,,Бірақ мен қайтадан қиындық тудыруы мүмкін.
Dialogue: 0,0:18:15.58,0:18:17.32,JPN,,0,0,0,,Мазасыз ба, жоқ па
Dialogue: 0,0:18:17.57,0:18:19.60,JPN,,0,0,0,,Мұны сіз емес, Цукаса шешеді.
Dialogue: 0,0:18:22.32,0:18:22.98,JPN,,0,0,0,,Солай емес пе?
Dialogue: 0,0:18:37.40,0:18:38.15,JPN,,0,0,0,,Мен үйдемін
Dialogue: 0,0:18:42.98,0:18:43.68,JPN,,0,0,0,,Цукаса?
Dialogue: 0,0:19:28.21,0:19:29.94,JPN,,0,0,0,,Айраға қанша уақыт қалды?
Dialogue: 0,0:19:31.33,0:19:32.79,JPN,,0,0,0,,Сіз Ирадан бірдеңе естідіңіз бе?
Dialogue: 0,0:19:33.43,0:19:33.98,JPN,,0,0,0,,Жоқ
Dialogue: 0,0:19:34.48,0:19:35.25,JPN,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:36.26,0:19:38.93,JPN,,0,0,0,,Исла сенімен бірге болғаннан бері қатты өзгерді.
Dialogue: 0,0:19:39.45,0:19:41.45,JPN,,0,0,0,,Бұл менімен бірге болған кезден үлкен айырмашылық.
Dialogue: 0,0:19:41.83,0:19:42.97,JPN,,0,0,0,,Солай ма?
Dialogue: 0,0:19:43.57,0:19:45.96,JPN,,0,0,0,,Мен ол кезде әбден шаршадым.
Dialogue: 0,0:19:46.28,0:19:48.85,JPN,,0,0,0,,Себебі мен біраз уақыт үзіліс жасадым.
Dialogue: 0,0:19:49.16,0:19:52.48,JPN,,0,0,0,,Исланың өзгергені сенің арқаң.
Dialogue: 0,0:19:53.77,0:19:55.06,JPN,,0,0,0,,Олай болса қуанар едім.
Dialogue: 0,0:19:56.09,0:19:56.89,JPN,,0,0,0,,Астымыз қозғалып жатыр, білесің бе.
Dialogue: 0,0:20:00.29,0:20:04.64,JPN,,0,0,0,,Исланың өмірінде небәрі 1000 сағат қалды.
Dialogue: 0,0:20:09.31,0:20:12.96,JPN,,0,0,0,,Мм, 1000 сағат... мм...
Dialogue: 0,0:20:13.74,0:20:15.97,JPN,,0,0,0,,Бір айдан сәл астам уақыт
Dialogue: 0,0:20:16.82,0:20:17.62,JPN,,0,0,0,,1 ай…
Dialogue: 0,0:20:20.57,0:20:21.72,JPN,,0,0,0,,Уақыты келгенде
Dialogue: 0,0:20:22.62,0:20:24.24,JPN,,0,0,0,,Басқа Giftias сияқты
Dialogue: 0,0:20:25.13,0:20:27.00,JPN,,0,0,0,,Исла шығарып алу керек.
Dialogue: 0,0:20:28.64,0:20:31.58,JPN,,0,0,0,,Мен де үндемедім.
Dialogue: 0,0:20:32.65,0:20:34.83,JPN,,0,0,0,,Нәтижесінде бұл уақыт болды
Dialogue: 0,0:20:35.50,0:20:36.53,JPN,,0,0,0,,Бұл үшін кешірім сұраймын.
Dialogue: 0,0:20:38.26,0:20:40.26,JPN,,0,0,0,,Сонымен не істегіңіз келеді?
Dialogue: 0,0:20:41.21,0:20:43.30,JPN,,0,0,0,,Исламен жұмысты жалғастыруым керек пе?
Dialogue: 0,0:20:43.83,0:20:46.56,JPN,,0,0,0,,Немесе қатынасты тоқтатыңыз.
Dialogue: 0,0:20:46.89,0:20:49.61,JPN,,0,0,0,,Жаңа Giftia тағайындалғанын күтуім керек пе?
Dialogue: 0,0:20:50.52,0:20:52.15,JPN,,0,0,0,,Біз жинала берсек те
Dialogue: 0,0:20:52.62,0:20:54.34,JPN,,0,0,0,,Кез келген жағдайда бір айдан кейін
Dialogue: 0,0:20:54.89,0:20:58.08,JPN,,0,0,0,,Менің Исламен серіктестігім аяқталды.
Dialogue: 0,0:21:04.86,0:21:07.74,JPN,,0,0,0,,Мен Исламен соңына дейін жұмыс істегім келеді.
Dialogue: 0,0:21:09.72,0:21:13.42,JPN,,0,0,0,,Мен қазір Айрадан басқа ешкіммен бірге болуды елестете алмаймын.
Dialogue: 0,0:21:15.49,0:21:17.18,JPN,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:21:18.70,0:21:19.09,JPN,,0,0,0,,Иә
Dialogue: 0,0:21:40.98,0:21:41.57,JPN,,0,0,0,,Ира
Dialogue: 0,0:21:42.21,0:21:44.90,JPN,,0,0,0,,Түсіндім, сен бүгін осында келесің.
Dialogue: 0,0:21:45.51,0:21:46.81,JPN,,0,0,0,,Мен сені алып кетуге баруым керек еді.
Dialogue: 0,0:21:47.35,0:21:47.96,JPN,,0,0,0,,Жоқ
Dialogue: 0,0:21:48.45,0:21:49.06,JPN,,0,0,0,,Та-да!
Dialogue: 0,0:21:52.09,0:21:53.30,JPN,,0,0,0,,Ум... Цукаса
Dialogue: 0,0:21:55.65,0:21:56.45,JPN,,0,0,0,,Мен...
Dialogue: 0,0:21:57.22,0:21:59.02,JPN,,0,0,0,,Ира қош келдіңіз
Dialogue: 0,0:22:03.57,0:22:05.28,JPN,,0,0,0,,Цукаса да қош келдіңіз
Dialogue: 0,0:23:37.06,0:23:38.26,JPN,,0,0,0,,Со Цукаса
Dialogue: 0,0:23:39.00,0:23:39.90,JPN,,0,0,0,,Осыдан кейін
Dialogue: 0,0:23:40.48,0:23:41.36,JPN,,0,0,0,,Сіз оны жегіңіз келе ме?
Dialogue: 0,0:23:41.85,0:23:42.79,JPN,,0,0,0,,Ваннаға түскіңіз келе ме?
Dialogue: 0,0:23:43.69,0:23:44.48,JPN,,0,0,0,,Әлде…
Dialogue: 0,0:23:45.08,0:23:47.17,JPN,,0,0,0,,I?
Dialogue: 0,0:23:49.74,0:23:52.01,JPN,,0,0,0,,Мүмкін мұны саған Эле үйреткен шығар?
Dialogue: 0,0:23:52.39,0:23:53.90,JPN,,0,0,0,,Жоқ, бұл
Dialogue: 0,0:23:55.40,0:24:01.40,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
