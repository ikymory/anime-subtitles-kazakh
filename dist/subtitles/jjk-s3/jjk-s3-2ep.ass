Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:47.61,0:00:50.65,Default,,0,0,0,,♬ МЕНІ СҮЙІП, ЖЕК КӨРЕДІ
Dialogue: 0,0:00:50.65,0:00:54.95,Default,,0,0,0,,♬ LUV ME ӨЛТІР
Dialogue: 0,0:00:57.22,0:00:59.79,Default,,0,0,0,,♬ Сүйіспеншілік, жек көру, сүйіспеншілік, жек көру
Dialogue: 0,0:00:59.79,0:01:02.29,Default,,0,0,0,,♬ Дай Токио Рюусо Ута
Dialogue: 0,0:01:02.29,0:01:04.69,Default,,0,0,0,,♬ Маваримавари дәуірінде
Dialogue: 0,0:01:04.69,0:01:07.36,Default,,0,0,0,,♬ Ұятқа малынған
Dialogue: 0,0:01:07.36,0:01:09.93,Default,,0,0,0,,♬ Сүйіспеншілік, жек көру, жақсы көру және жек көру
Dialogue: 0,0:01:09.93,0:01:12.27,Default,,0,0,0,,♬ Кеттік, үлкен әңгіме сияқты
Dialogue: 0,0:01:12.27,0:01:14.77,Default,,0,0,0,,♬ Екеуміз айырылысып қаламыз
Dialogue: 0,0:01:14.77,0:01:17.84,Default,,0,0,0,,♬ Олай болса тағы кездесейік.
Dialogue: 0,0:01:19.84,0:01:22.21,Default,,0,0,0,,♬ Драмаға батып кету
Dialogue: 0,0:01:22.21,0:01:24.68,Default,,0,0,0,,♬ Толық еместігімді мойында
Dialogue: 0,0:01:24.68,0:01:26.75,Default,,0,0,0,,♬ Босаңсытатын көркем әдебиет
Dialogue: 0,0:01:26.75,0:01:29.75,Default,,0,0,0,,♬ Өтірік пен шындық арасындағы диссонанс
Dialogue: 0,0:01:29.75,0:01:32.29,Default,,0,0,0,,♬ Махаббатым толық болмаса да кешірші
Dialogue: 0,0:01:32.29,0:01:34.62,Default,,0,0,0,,♬ Мәселе жоқ! Осы кезеңнен аман өтіңіз
Dialogue: 0,0:01:34.62,0:01:36.93,Default,,0,0,0,,♬ Тістеген ит жауынгер қалтырап
Dialogue: 0,0:01:36.93,0:01:40.16,Default,,0,0,0,,♬ Есейе берсең, ересек бола алмайсың
Dialogue: 0,0:01:40.16,0:01:42.53,Default,,0,0,0,,♬ LUV ME Тек әділдік
Dialogue: 0,0:01:42.53,0:01:45.17,Default,,0,0,0,,♬ ЖЕК КӨРСІЗ Бәрін алып кетіңіз
Dialogue: 0,0:01:45.17,0:01:47.74,Default,,0,0,0,,♬ LUV ME Махаббат пен жек көрушілікке толы
Dialogue: 0,0:01:47.74,0:01:52.61,Default,,0,0,0,,♬ ӨЛТІР мені бұл жерден алып кет
Dialogue: 0,0:01:52.61,0:01:55.24,Default,,0,0,0,,♬ Сүй, жек көр, сүй, жек көр, құшақтас
Dialogue: 0,0:01:55.24,0:01:57.61,Default,,0,0,0,,♬ Қай уақытта болса да шарықтау шегі
Dialogue: 0,0:01:57.61,0:02:00.15,Default,,0,0,0,,♬ Алдап-арбау да, алдау да дұрыс.
Dialogue: 0,0:02:00.15,0:02:03.12,Default,,0,0,0,,♬ Маған баға маңызды емес
Dialogue: 0,0:02:03.12,0:02:05.45,Default,,0,0,0,,♬ Ғашық, өшпенділік, сүйіспеншілік, жек көрушілікпен кезіп
Dialogue: 0,0:02:05.45,0:02:07.82,Default,,0,0,0,,♬ Дипломатиялық сүйкімділік себіңіз
Dialogue: 0,0:02:07.82,0:02:10.29,Default,,0,0,0,,♬ Бәрі сұрақ-жауапсыз аяқталады.
Dialogue: 0,0:02:10.29,0:02:13.80,Default,,0,0,0,,♬ Олай болса тағы кездесейік.
Dialogue: 0,0:02:45.89,0:02:48.70,Default,,0,0,0,,Кешіріңіз➡
Dialogue: 0,0:02:48.70,0:02:50.67,Default,,0,0,0,,Коджо-кун.
Dialogue: 0,0:02:53.47,0:02:55.44,Default,,0,0,0,,Цк.
Dialogue: 0,0:02:59.78,0:03:05.38,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:03:05.38,0:03:07.58,Default,,0,0,0,,Иә.
Dialogue: 0,0:03:07.58,0:03:09.79,Default,,0,0,0,,Дого! Арх!
Dialogue: 0,0:03:09.79,0:03:12.45,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:12.45,0:03:14.82,Default,,0,0,0,,Дого! Арх!
Dialogue: 0,0:03:14.82,0:03:16.89,Default,,0,0,0,,Дого! Уф!
Dialogue: 0,0:03:19.19,0:03:21.16,Default,,0,0,0,,Гаха!
Dialogue: 0,0:03:23.00,0:03:25.07,Default,,0,0,0,,Иә.
Dialogue: 0,0:03:26.84,0:03:28.90,Default,,0,0,0,,Бум! (Жүректе ісіну фазасы/дауыс) ≪Жылдам!! ≫
Dialogue: 0,0:03:28.90,0:03:31.21,Default,,0,0,0,,≪Мен техниканың түрін түсінбеймін!! ➡
Dialogue: 0,0:03:31.21,0:03:33.28,Default,,0,0,0,,Егер сіз соншалықты басым болса➡
Dialogue: 0,0:03:33.28,0:03:35.68,Default,,0,0,0,,Бұл жерде ешқандай ақпарат ашылмайды. ➡
Dialogue: 0,0:03:35.68,0:03:38.95,Default,,0,0,0,,Бұл «Хякутен» туралы әңгіме емес!! ≫ (Наоя) Иә.
Dialogue: 0,0:03:38.95,0:03:42.35,Default,,0,0,0,,<<Денеден тыс қан манипуляциясы мүлдем нәтиже бермейді!! ≫
Dialogue: 0,0:03:42.35,0:03:44.39,Default,,0,0,0,,♬~
Dialogue: 0,0:03:44.39,0:03:52.03,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:03:52.03,0:03:56.03,Default,,0,0,0,,Шибуто. Не істеп жатырсың?
Dialogue: 0,0:03:56.03,0:04:00.20,Default,,0,0,0,,Бауырым, мен 10 ағайынмын.
Dialogue: 0,0:04:00.20,0:04:03.51,Default,,0,0,0,,≪“Тозақ шкаласы динамикалық қозғалысы / орнату”≫
Dialogue: 0,0:04:03.51,0:04:05.61,Default,,0,0,0,,Бұл жауап емес. ➡
Dialogue: 0,0:04:05.61,0:04:08.91,Default,,0,0,0,,Мен техника және оның табандылығы туралы айтып отырмын➡
Dialogue: 0,0:04:08.91,0:04:11.61,Default,,0,0,0,,Сіз тыңдамайсыз!! За... (жүгіру дыбысы)
Dialogue: 0,0:04:28.23,0:04:30.30,Default,,0,0,0,,≪Ол қосылды≫
Dialogue: 0,0:04:31.63,0:04:35.40,Default,,0,0,0,,Дого! (ісіну) Ару! ➡
Dialogue: 0,0:04:35.40,0:04:37.81,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:37.81,0:04:41.61,Default,,0,0,0,,≪Мен «Қызыл таразылар динамикалық»≫ көремін
Dialogue: 0,0:04:41.61,0:04:44.38,Default,,0,0,0,,≪Бұл қабілетті көзден тыс бұлшықеттерге шоғырландырыңыз➡
Dialogue: 0,0:04:44.38,0:04:47.52,Default,,0,0,0,,Динамикалық көру өткірлігін жақсартыңыз≫
Dialogue: 0,0:04:47.52,0:04:52.95,Default,,0,0,0,,Кешіріңіз. Мен санауыштың алғышартымен қозғалыс жасауға тырысамын. ➡
Dialogue: 0,0:04:52.95,0:04:57.16,Default,,0,0,0,,Сіз табандысыз, сондықтан мен сізге оны пайдалануға рұқсат бердім және бұл жақсы нәрсе. ➡
Dialogue: 0,0:04:57.16,0:05:00.56,Default,,0,0,0,,Қызыл қанмен манипуляция Сіз қан кетуді жақсы тоқтатасыз. ➡
Dialogue: 0,0:05:00.56,0:05:03.60,Default,,0,0,0,,Қан тоқтатамын деп уайымдап, менімен қаншалықты алыс жүре аласың?➡
Dialogue: 0,0:05:03.60,0:05:05.77,Default,,0,0,0,,Көріп көрейік.
Dialogue: 0,0:05:05.77,0:05:08.54,Default,,0,0,0,,Мен дайынмын. (Наоя) Айтпа. ➡
Dialogue: 0,0:05:08.54,0:05:10.77,Default,,0,0,0,,Шынымды айтсам, бұл ақсақ емес деп ойлаймын. ➡
Dialogue: 0,0:05:10.77,0:05:13.07,Default,,0,0,0,,Сиқыршы өзімен бірге сыйлық алып жүр. ➡
Dialogue: 0,0:05:13.07,0:05:15.78,Default,,0,0,0,,Егер ол болмаса, сіз ұта алмайсыз➡
Dialogue: 0,0:05:15.78,0:05:19.11,Default,,0,0,0,,Бір ғажабы сол ойдағы біреу. ➡
Dialogue: 0,0:05:19.11,0:05:22.58,Default,,0,0,0,,Менің ағаларым да сондай беймаза. ➡
Dialogue: 0,0:05:22.58,0:05:26.22,Default,,0,0,0,,Уау, Джинджи-кун туралы оңай бірдеңе айтуға болады.
Dialogue: 0,0:05:26.22,0:05:29.12,Default,,0,0,0,,Мен ағамды жек көремін.
Dialogue: 0,0:05:29.12,0:05:32.46,Default,,0,0,0,,Маған ұнамайды. Ағадан да жаман аға➡
Dialogue: 0,0:05:32.46,0:05:36.43,Default,,0,0,0,,Онда болудың қажеті жоқ. Асылып өлсең де жарайды.
Dialogue: 0,0:05:36.43,0:05:39.13,Default,,0,0,0,,Сол ағаларға рахмет➡
Dialogue: 0,0:05:39.13,0:05:41.84,Default,,0,0,0,,Сіз қазір тұрған жерде болуыңыз мүмкін.
Dialogue: 0,0:05:41.84,0:05:46.64,Default,,0,0,0,,ше? Сіз шынымен қорқынышты нәрсе айттыңыз ба?
Dialogue: 0,0:05:46.64,0:05:49.31,Default,,0,0,0,,Уайымдамаңыз.
Dialogue: 0,0:05:49.31,0:05:51.91,Default,,0,0,0,,Дағды жақсы ма, жаман ма➡
Dialogue: 0,0:05:51.91,0:05:54.68,Default,,0,0,0,,Аға – інісіне үлгі.
Dialogue: 0,0:05:54.68,0:05:56.75,Default,,0,0,0,,Егер ағам бұрыс жолға түссе➡
Dialogue: 0,0:05:56.75,0:05:59.45,Default,,0,0,0,,Менің інім ол жолдан аулақ болуы керек. ➡
Dialogue: 0,0:05:59.45,0:06:04.49,Default,,0,0,0,,Ағасы дұрыс жолмен жүрсе, іні оның соңынан еруі керек. ➡
Dialogue: 0,0:06:04.49,0:06:09.56,Default,,0,0,0,,Ағаң әлсіз болғандықтан, сен күшті болсаң не істер едің? ➡
Dialogue: 0,0:06:09.56,0:06:11.80,Default,,0,0,0,,Неліктен қыңыр екенімді сұрадың.
Dialogue: 0,0:06:11.80,0:06:14.00,Default,,0,0,0,,Иә? (ісіп) Мен саған айтамын. ➡
Dialogue: 0,0:06:14.00,0:06:17.94,Default,,0,0,0,,Менде мысал жоқ. Мен қайта-қайта қателесемін. ➡
Dialogue: 0,0:06:17.94,0:06:22.34,Default,,0,0,0,,Сонда да ағамның алдында жүре беруім керек. ➡
Dialogue: 0,0:06:22.34,0:06:25.21,Default,,0,0,0,,Сондықтан мен күштімін.
Dialogue: 0,0:06:25.21,0:06:28.65,Default,,0,0,0,,Башан!
Dialogue: 0,0:06:28.65,0:06:32.55,Default,,0,0,0,,≪Не болып жатыр?! Мен неге бұл қанмен өмір сүре алмаймын?≫
Dialogue: 0,0:06:32.55,0:06:40.56,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:06:53.31,0:07:00.72,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:07:00.72,0:07:02.75,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:07:02.75,0:07:12.19,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:07:12.19,0:07:14.23,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:07:14.23,0:07:19.47,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:07:19.47,0:07:21.50,Default,,0,0,0,,≪Менің аяғым ауыр. ➡
Dialogue: 0,0:07:21.50,0:07:25.47,Default,,0,0,0,,Матаға сіңген қанды түзеткіңіз келе ме?
Dialogue: 0,0:07:25.47,0:07:27.98,Default,,0,0,0,,Сіз тағы не білесіз?
Dialogue: 0,0:07:27.98,0:07:30.01,Default,,0,0,0,,Бұл тұйыққа тіреледі.
Dialogue: 0,0:07:30.01,0:07:35.85,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:07:35.85,0:07:38.92,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:07:38.92,0:07:42.52,Default,,0,0,0,,≪Менің техникам – алдын ала 24 кадр/сек жылдамдықпен қозғалыс жасау➡
Dialogue: 0,0:07:42.52,0:07:44.59,Default,,0,0,0,,Бақылау. ➡
Dialogue: 0,0:07:44.59,0:07:48.23,Default,,0,0,0,,Осы деңгейде тұрып қалсаңыз, еш қиындықсыз қозғала аласыз≫
Dialogue: 0,0:07:48.23,0:07:50.27,Default,,0,0,0,,≪ Байқап көріңіз≫
Dialogue: 0,0:07:50.27,0:07:53.44,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:07:53.44,0:07:56.37,Default,,0,0,0,,≪Неге мені атып жатырсың?≫
Dialogue: 0,0:07:56.37,0:07:58.44,Default,,0,0,0,,＜Бұл 150 жыл➡
Dialogue: 0,0:07:58.44,0:08:02.74,Default,,0,0,0,,Өз техникасымен бетпе-бет келген түпнұсқа жанкүйер>
Dialogue: 0,0:08:02.74,0:08:04.78,Default,,0,0,0,,Жаса-жаса-жасай! (Наоя) Арх!
Dialogue: 0,0:08:04.78,0:08:06.75,Default,,0,0,0,,Жасау-істеу-істеу! (Наоя) Арх!
Dialogue: 0,0:08:12.75,0:08:16.49,Default,,0,0,0,,А... уф.... ➡
Dialogue: 0,0:08:16.49,0:08:21.40,Default,,0,0,0,,Хаа хаа ха....
Dialogue: 0,0:08:28.30,0:08:32.97,Default,,0,0,0,,Кешіріңіз, бірақ ағаңызды сүйе алмасаңыз, қалай сезінетініңізді түсінбеймін.
Dialogue: 0,0:08:39.88,0:08:43.25,Default,,0,0,0,,⚟Чап тарау...(аяқ дыбыстары)
Dialogue: 0,0:08:43.25,0:08:45.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:48.29,0:08:50.26,Default,,0,0,0,,Жоқ! Дого!
Dialogue: 0,0:08:55.63,0:08:58.63,Default,,0,0,0,,Ауыратын сияқты➡
Dialogue: 0,0:08:58.63,0:09:00.60,Default,,0,0,0,,Наоя мырза.
Dialogue: 0,0:09:02.37,0:09:04.41,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:09:04.41,0:09:07.21,Default,,0,0,0,,≪Төмен қарама!! Уф! ≫
Dialogue: 0,0:09:07.21,0:09:12.08,Default,,0,0,0,,Уф! О! Гохо, гохо... Күрсіну….
Dialogue: 0,0:09:12.08,0:09:14.98,Default,,0,0,0,,≪Бұл не? У⁉➡
Dialogue: 0,0:09:14.98,0:09:18.22,Default,,0,0,0,,Қызыл қан манипуляциясы осындай әсер етеді⁉≫
Dialogue: 0,0:09:18.22,0:09:21.19,Default,,0,0,0,,≪Чау!! Хирургиялық әсер жоқ!! ≫
Dialogue: 0,0:09:21.19,0:09:24.89,Default,,0,0,0,,≪Бұл қан мөлшері тым адамдық болды!! ➡
Dialogue: 0,0:09:24.89,0:09:30.10,Default,,0,0,0,,Пассивті дене? Адам емес қан ағзаға түскенде, ол қабылданбайды.
Dialogue: 0,0:09:30.10,0:09:33.00,Default,,0,0,0,,Мен сені емдеймін бе?
Dialogue: 0,0:09:33.00,0:09:37.07,Default,,0,0,0,,Менің кері қайтару техникам Мен басқаларды да емдей аламын.
Dialogue: 0,0:09:37.07,0:09:39.27,Default,,0,0,0,,орнына➡
Dialogue: 0,0:09:39.27,0:09:42.44,Default,,0,0,0,,Кожо-кунның өлімі сіздің аузыңыздан шықты➡
Dialogue: 0,0:09:42.44,0:09:44.51,Default,,0,0,0,,Жоғарыда хабарлаңыз.
Dialogue: 0,0:09:47.48,0:09:49.45,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:09:54.66,0:10:00.43,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:10:00.43,0:10:03.30,Default,,0,0,0,,((Джин, қалай өмір сүрсең де➡
Dialogue: 0,0:10:03.30,0:10:05.70,Default,,0,0,0,,Бұл сізге байланысты))
Dialogue: 0,0:10:05.70,0:10:11.17,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:10:11.17,0:10:14.78,Default,,0,0,0,,((Юхитоның алдында оғаш нәрселерді айтуды доғарыңыз.➡
Dialogue: 0,0:10:14.78,0:10:18.41,Default,,0,0,0,,Бір таңқаларлығы, ол оны есіне түсіретін сияқты (сәби естелігі))
Dialogue: 0,0:10:18.41,0:10:21.32,Default,,0,0,0,,((Сіз де балалы болғыңыз келді➡
Dialogue: 0,0:10:21.32,0:10:25.72,Default,,0,0,0,,Мен де Каориде мұндай болмағанын білемін))
Dialogue: 0,0:10:25.72,0:10:31.96,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:10:31.96,0:10:36.26,Default,,0,0,0,,Шырылдаған сыңғыр... (жанып жатқан отынның дыбысы)
Dialogue: 0,0:10:36.26,0:10:38.23,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:45.14,0:10:48.34,Default,,0,0,0,,Иә? мен….
Dialogue: 0,0:10:48.34,0:10:50.41,Default,,0,0,0,,Ха...
Dialogue: 0,0:11:04.33,0:11:09.96,Default,,0,0,0,,Иә... бұл жақсы!
Dialogue: 0,0:11:09.96,0:11:12.63,Default,,0,0,0,,Аа...
Dialogue: 0,0:11:12.63,0:11:16.14,Default,,0,0,0,,Хаха….
Dialogue: 0,0:11:16.14,0:11:21.68,Default,,0,0,0,,Мүмкін қыркүйек айының шамасында? Годжо мырза мені көруге жол бойы келді.
Dialogue: 0,0:11:21.68,0:11:24.91,Default,,0,0,0,,Менен сіз туралы сұрады. ➡
Dialogue: 0,0:11:24.91,0:11:28.88,Default,,0,0,0,,Сондықтан спектакльде ойнаудан басқа амалым қалмады.
Dialogue: 0,0:11:28.88,0:11:31.05,Default,,0,0,0,,Ойнау?
Dialogue: 0,0:11:31.05,0:11:34.19,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:11:34.19,0:11:37.16,Default,,0,0,0,,((Егер маған бірдеңе болса, соңғы бір-екі жыл туралы➡
Dialogue: 0,0:11:37.16,0:11:41.96,Default,,0,0,0,,Мен Ютадан жақсылық сұрағым келді. Таразы дұрыс))
Dialogue: 0,0:11:41.96,0:11:46.37,Default,,0,0,0,,) ((Хмм?➡
Dialogue: 0,0:11:46.37,0:11:49.70,Default,,0,0,0,,Юта да әзіл айта бастады))
Dialogue: 0,0:11:49.70,0:11:55.01,Default,,0,0,0,,((Жоқ, мен Годжо мырзаға "бірдеңе" елестете алмаймын))
Dialogue: 0,0:11:55.01,0:11:57.65,Default,,0,0,0,,((Әсіресе бір жылдық Коджо Юхито.➡
Dialogue: 0,0:11:57.65,0:12:01.92,Default,,0,0,0,,Ол бала да Юта сияқты бір кездері өлім жазасына кесілген. ➡
Dialogue: 0,0:12:01.92,0:12:04.95,Default,,0,0,0,,Маған назар аударсаңыз пайдалы болар еді. ➡
Dialogue: 0,0:12:04.95,0:12:07.06,Default,,0,0,0,,О, Мигель ше? ))
Dialogue: 0,0:12:07.06,0:12:09.46,Default,,0,0,0,,((Ол мұғаліммен кездескісі келмейді))
Dialogue: 0,0:12:09.46,0:12:11.39,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:12:11.39,0:12:13.96,Default,,0,0,0,,Басқа орындаушы тағайындалды➡
Dialogue: 0,0:12:13.96,0:12:16.56,Default,,0,0,0,,Коджо-кунның ақпаратын өшірудің орнына➡
Dialogue: 0,0:12:16.56,0:12:19.37,Default,,0,0,0,,Мен осылай әрекет еткен дұрыс деп шештім. ➡
Dialogue: 0,0:12:19.37,0:12:21.80,Default,,0,0,0,,Жарайды, сен де ақымақ емессің➡
Dialogue: 0,0:12:21.80,0:12:25.31,Default,,0,0,0,,Бас инспектор дегеніміз не?Орындаушы ретінде танылу үшін➡
Dialogue: 0,0:12:25.31,0:12:29.31,Default,,0,0,0,,Мен Кожо-кунды өлтіру үшін байладым. ➡
Dialogue: 0,0:12:29.31,0:12:32.58,Default,,0,0,0,,Сондықтан мен оны бір рет өлтірдім. Мен шынымен кешірім сұраймын.
Dialogue: 0,0:12:35.05,0:12:39.55,Default,,0,0,0,,Жоқ...онда мен неге әлі тірімін?
Dialogue: 0,0:12:39.55,0:12:42.76,Default,,0,0,0,,Бұл кері әдіс. ➡
Dialogue: 0,0:12:42.76,0:12:48.43,Default,,0,0,0,,Мен сенің жүрегіңді тоқтатқан бойда, мен бәріңді бірден емдеу үшін кері қайтару әдісін қолдандым. ➡
Dialogue: 0,0:12:48.43,0:12:52.63,Default,,0,0,0,,Мен сен туралы бұрын естігенмін, сондықтан барамын деп ойладым. ➡
Dialogue: 0,0:12:52.63,0:12:55.64,Default,,0,0,0,,Мен шикі энергияны сол күйінде шығара аламын➡
Dialogue: 0,0:12:55.64,0:12:57.91,Default,,0,0,0,,Бұл туралы көп адам біле бермейді. ➡
Dialogue: 0,0:12:57.91,0:13:03.18,Default,,0,0,0,,Иә, мен сенің өліміңді екінші рет қолданып отырмын.
Dialogue: 0,0:13:03.18,0:13:07.42,Default,,0,0,0,,Жақында анықталуы мүмкін, бірақ жағдай басқаша. ➡
Dialogue: 0,0:13:07.42,0:13:12.09,Default,,0,0,0,,Әзірге Коджо-кунның өлім жазасы аяқталған деп есептелуі керек.
Dialogue: 0,0:13:14.16,0:13:17.56,Default,,0,0,0,,Неге сонша алысқа бардың...?
Dialogue: 0,0:13:17.56,0:13:20.93,Default,,0,0,0,,Маған ұнайтын адамдар➡
Dialogue: 0,0:13:20.93,0:13:23.20,Default,,0,0,0,,Себебі мен сені бағалаймын.
Dialogue: 0,0:13:25.70,0:13:30.51,Default,,0,0,0,,Маған да бір кездері қолымнан келмейтін күш жүктелді. ➡
Dialogue: 0,0:13:30.51,0:13:33.74,Default,,0,0,0,,Бірақ маған жүк артты деп ойлаған күш➡ болды
Dialogue: 0,0:13:33.74,0:13:36.34,Default,,0,0,0,,Бұл менің өзім жасаған нәрсе болды. ➡
Dialogue: 0,0:13:36.34,0:13:41.02,Default,,0,0,0,,Мен сенен өзгешемін. Сіз алып жүрген күш сіздің күшіңіз емес.
Dialogue: 0,0:13:43.89,0:13:45.85,Default,,0,0,0,,Сіз жаман емессіз.
Dialogue: 0,0:13:51.56,0:13:56.23,Default,,0,0,0,,Бұл дұрыс емес. Бұл менің кінәм немесе басқа нәрсе емес➡
Dialogue: 0,0:13:56.23,0:13:59.10,Default,,0,0,0,,Мен адаммын... Жолбарыс қамысы.
Dialogue: 0,0:14:03.87,0:14:06.51,Default,,0,0,0,,Фушигуро…. (Мегуми Фушигуро) Не ​​істеп жатырсың?
Dialogue: 0,0:14:06.51,0:14:08.74,Default,,0,0,0,,Техникалық колледжге оралайық.
Dialogue: 0,0:14:08.74,0:14:11.45,Default,,0,0,0,,Қазір техникалық колледждердегі кедергі босап барады.
Dialogue: 0,0:14:11.45,0:14:15.88,Default,,0,0,0,,Мен сіздің жүзіңізді тікелей көре алмағанша, қайтып келсеңіз, бұл проблема болмайды.
Dialogue: 0,0:14:15.88,0:14:18.55,Default,,0,0,0,,Бірде мен үлкендермен кездестім... Тоқта!
Dialogue: 0,0:14:19.99,0:14:23.29,Default,,0,0,0,,Бір нәрсені қарапайым деп қабылдамаңыз.
Dialogue: 0,0:14:23.29,0:14:25.26,Default,,0,0,0,,Ешқашан болмағандай кейіп танытпа.
Dialogue: 0,0:14:27.03,0:14:30.10,Default,,0,0,0,,Мен біреуді өлтірдім.
Dialogue: 0,0:14:31.57,0:14:34.94,Default,,0,0,0,,Менің кесірімнен көп адам өлді! Бұл біздің кінәміз.
Dialogue: 0,0:14:36.24,0:14:38.84,Default,,0,0,0,,≪Сіз осылай айтасыз≫
Dialogue: 0,0:14:38.84,0:14:41.24,Default,,0,0,0,,Сіз жалғыз➡
Dialogue: 0,0:14:41.24,0:14:43.31,Default,,0,0,0,,Жай ғана берілмеңіз.
Dialogue: 0,0:14:50.28,0:14:52.25,Default,,0,0,0,,Уф….
Dialogue: 0,0:14:56.02,0:14:58.79,Default,,0,0,0,,Біз әділдік жағында емеспіз.
Dialogue: 0,0:14:58.79,0:15:00.83,Default,,0,0,0,,Ол сиқыршы.
Dialogue: 0,0:15:00.83,0:15:04.73,Default,,0,0,0,,Бізді ешкім шынымен соттай алмайды.
Dialogue: 0,0:15:04.73,0:15:10.27,Default,,0,0,0,,Сондықтан біз өз болмысымыздың мәнін көрсетуді жалғастыруымыз керек.
Dialogue: 0,0:15:10.27,0:15:12.37,Default,,0,0,0,,≪Бұл дұрыс емес, Фушигуро≫
Dialogue: 0,0:15:12.37,0:15:15.21,Default,,0,0,0,,Бізде енді өзіміз туралы ойлауға уақыт жоқ.
Dialogue: 0,0:15:15.21,0:15:17.51,Default,,0,0,0,,≪Онда сен...≫ Тек алға➡
Dialogue: 0,0:15:17.51,0:15:19.85,Default,,0,0,0,,Адамдарға көмектесу. ≪Мен сенің жаныңда болғанша...≫
Dialogue: 0,0:15:19.85,0:15:22.38,Default,,0,0,0,,Бұл бірінші кезекте сіздің әрекет ету принципіңіз болуы керек еді.
Dialogue: 0,0:15:22.38,0:15:24.42,Default,,0,0,0,,≪Мәңгілік азап шегесің!! ≫
Dialogue: 0,0:15:24.42,0:15:27.49,Default,,0,0,0,,Алдымен маған көмектес, Қожо.
Dialogue: 0,0:15:30.22,0:15:34.06,Default,,0,0,0,,Не? Ұйымдастырушы: Нориюки Камо➡
Dialogue: 0,0:15:34.06,0:15:37.47,Default,,0,0,0,,Сиқырлық берілгендерді өлтіру➡
Dialogue: 0,0:15:37.47,0:15:40.20,Default,,0,0,0,,«Өлім мен өлім сапары».
Dialogue: 0,0:15:40.20,0:15:43.07,Default,,0,0,0,,Цумики де өлім цикліне түседі.
Dialogue: 0,0:15:45.27,0:15:48.11,Default,,0,0,0,,Жолбарыстың таяқшасын сұрау.
Dialogue: 0,0:15:48.11,0:15:53.71,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:53.71,0:15:55.88,Default,,0,0,0,,Маған сенің күшің керек.
Dialogue: 0,0:15:55.88,0:16:22.91,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:18:25.60,0:18:28.94,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:18:28.94,0:18:31.64,Default,,0,0,0,,Жолбарыстың таяқшасын сұрау.
Dialogue: 0,0:18:31.64,0:18:33.81,Default,,0,0,0,,Маған сенің күшің керек.
Dialogue: 0,0:18:35.64,0:18:37.88,Default,,0,0,0,,Отокоцу Сенпай➡
Dialogue: 0,0:18:37.88,0:18:41.52,Default,,0,0,0,,Сукуна Фушигурода бірдеңе құрып жатыр.
Dialogue: 0,0:18:41.52,0:18:44.35,Default,,0,0,0,,Шибуяда ол менің денемді алып кетті➡
Dialogue: 0,0:18:44.35,0:18:47.72,Default,,0,0,0,,Бірден 10 саусағын жегендіктен болар.
Dialogue: 0,0:18:47.72,0:18:50.76,Default,,0,0,0,,Қазір менің ішімде 15 саусақ бар.
Dialogue: 0,0:18:50.76,0:18:53.39,Default,,0,0,0,,Тіпті 5 кесектің бәрін бірден жеу керек болса да➡
Dialogue: 0,0:18:53.39,0:18:57.30,Default,,0,0,0,,Денені басып алуға болмайды деп ойлаймын. Әлі де➡
Dialogue: 0,0:18:57.30,0:18:59.90,Default,,0,0,0,,Келесі жолы Сукунаны ауыстырсам➡
Dialogue: 0,0:18:59.90,0:19:04.07,Default,,0,0,0,,Мені ойланбастан өлтіріңіз. Менің ойымша, үлкендер мұны істей алады.
Dialogue: 0,0:19:05.84,0:19:10.24,Default,,0,0,0,,Түсіндім. Мен қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,0:19:10.24,0:19:14.32,Default,,0,0,0,,Фушигуро Не істеуім керек?
Dialogue: 0,0:19:14.32,0:19:18.22,Default,,0,0,0,,Алдымен техникумға оралып, Теңген-самаға хабарласыңыз.
Dialogue: 0,0:19:18.22,0:19:21.32,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:19:21.32,0:19:24.26,Default,,0,0,0,,Түрме қақпасының мөрін қалай бұзуға болады➡
Dialogue: 0,0:19:24.26,0:19:28.73,Default,,0,0,0,,Норимичи Камоның нақты мақсаты мен болашақ бағыты.
Dialogue: 0,0:19:28.73,0:19:31.57,Default,,0,0,0,,Өлімге қайта оралу - бұрын-соңды болмаған сиқырлы қорқыныш.
Dialogue: 0,0:19:31.57,0:19:35.37,Default,,0,0,0,,Бұл екі жауап жағдайды бақылауға алу үшін міндетті болып табылады.
Dialogue: 0,0:19:35.37,0:19:39.54,Default,,0,0,0,,Бұл сұраққа тек Теңген-сама ғана жауап бере алады деп ойлаймын.
Dialogue: 0,0:19:39.54,0:19:43.24,Default,,0,0,0,,Ол кісі... Куджуку мырза білмейді ме?
Dialogue: 0,0:19:43.24,0:19:45.58,Default,,0,0,0,,Мен Куджуку мырзамен сөйлесіп қойғанмын.
Dialogue: 0,0:19:45.58,0:19:47.92,Default,,0,0,0,,Бұл сол адамның ойы.
Dialogue: 0,0:19:47.92,0:19:50.68,Default,,0,0,0,,Ол кісі де қазір техникалық колледжде жасырынып жүр.
Dialogue: 0,0:19:52.09,0:19:56.66,Default,,0,0,0,,Жасырын ба? Ол жоғарғы басшылықпен ешнәрсе болғысы келмейтін сияқты.
Dialogue: 0,0:19:56.66,0:20:01.46,Default,,0,0,0,,Мәселе Теңген-саманың «жасырын» тосқауылында. ➡
Dialogue: 0,0:20:01.46,0:20:05.30,Default,,0,0,0,,Қайталанатын 1000-нан астам есіктерден ➡
Dialogue: 0,0:20:05.30,0:20:09.57,Default,,0,0,0,,Біреуі ғана Теңген-сама тұратын Раушан сарайына апарады.
Dialogue: 0,0:20:11.07,0:20:15.64,Default,,0,0,0,,Түсінбесем, Теңгенмен кездесе алмаймын...
Dialogue: 0,0:20:19.78,0:20:21.75,Default,,0,0,0,,Кешіріңіз, Фушигуро.
Dialogue: 0,0:20:30.56,0:20:32.53,Default,,0,0,0,,Мен қазір тыңдайтын шығармын.
Dialogue: 0,0:20:36.13,0:20:38.30,Default,,0,0,0,,Кугисакиге не болды?
Dialogue: 0,0:20:45.07,0:20:47.04,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:49.91,0:20:51.88,Default,,0,0,0,,Түсіндім...
Dialogue: 0,0:20:59.05,0:21:02.06,Default,,0,0,0,,Олар үшін де тойып жеңіздер
Dialogue: 0,0:21:02.06,0:21:06.93,Default,,0,0,0,,Мүмкін сол «жасырын» тосқауылдан бірдеңе жасауға болады.
Dialogue: 0,0:21:06.93,0:21:10.83,Default,,0,0,0,,Уф! (Оцукоцу) Мен мұны естідім.
Dialogue: 0,0:21:10.83,0:21:13.67,Default,,0,0,0,,Сіз нені айтасыз? Ісіну фазасы.
Dialogue: 0,0:21:13.67,0:21:18.64,Default,,0,0,0,,Бұрын Масато Сукунаның саусағын және қарғыс атқан құрсақтың тоғыз фазасын ұрлаған болар еді. ➡
Dialogue: 0,0:21:18.64,0:21:20.98,Default,,0,0,0,,Дәл сол әрекетті орындаңыз.
Dialogue: 0,0:21:20.98,0:21:26.81,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:21:26.81,0:21:29.98,Default,,0,0,0,,Сықыр, сықыр, сықыр...(аяқ дыбысы)
Dialogue: 0,0:21:29.98,0:21:32.92,Default,,0,0,0,,Біраз уақыт өтті... солай емес пе?
Dialogue: 0,0:21:32.92,0:21:35.16,Default,,0,0,0,,Маки-сенпай⁉
Dialogue: 0,0:21:35.16,0:21:37.19,Default,,0,0,0,,Ах.
Dialogue: 0,0:21:37.19,0:21:40.33,Default,,0,0,0,,Маки-сан!! Енді қозғала аламын ба?
Dialogue: 0,0:21:40.33,0:21:42.63,Default,,0,0,0,,Жауап. Мәселе жоқ.
Dialogue: 0,0:21:42.63,0:21:44.77,Default,,0,0,0,,Күйіп қалу сөзсіз. ➡
Dialogue: 0,0:21:44.77,0:21:47.50,Default,,0,0,0,,Тіпті инверсия техникасы да із қалдырады. ➡
Dialogue: 0,0:21:47.50,0:21:51.27,Default,,0,0,0,,Бірақ күткендей, ол Құдайдың қарғысына байланысты физикалық дарынды. ➡
Dialogue: 0,0:21:51.27,0:21:54.18,Default,,0,0,0,,Ең соңында қарғысқа қарсы тұрудың орнына➡
Dialogue: 0,0:21:54.18,0:21:57.81,Default,,0,0,0,,Дененің табиғи күші өмір мен өлімді ажыратты. ➡
Dialogue: 0,0:21:57.81,0:22:00.28,Default,,0,0,0,,Отағасын аяймын.
Dialogue: 0,0:22:00.28,0:22:03.82,Default,,0,0,0,,Біз жарысқан сияқты емеспіз. ➡
Dialogue: 0,0:22:03.82,0:22:07.89,Default,,0,0,0,,Мегуми Теңген-саманың тосқауыл оқиғасына келсек.
Dialogue: 0,0:22:07.89,0:22:11.39,Default,,0,0,0,,Бұл... Алдымен сөйлесейік. ➡
Dialogue: 0,0:22:11.39,0:22:13.89,Default,,0,0,0,,Сасей сарайының есігінен ➡ жолда
Dialogue: 0,0:22:13.89,0:22:18.03,Default,,0,0,0,,Техникалық колледжде сиқырлы құралдар мен заттарды сақтайтын ``қойма'' бар. ➡
Dialogue: 0,0:22:18.03,0:22:20.47,Default,,0,0,0,,Менің інілерім жаназада➡
Dialogue: 0,0:22:20.47,0:22:23.27,Default,,0,0,0,,➡
Dialogue: 0,0:22:23.27,0:22:27.17,Default,,0,0,0,,Шашылған сүйектер, сынған сүйектер, өртенген мәйіттер. ➡
Dialogue: 0,0:22:27.17,0:22:29.28,Default,,0,0,0,,Мәйіт болса да 6 адам жинасаң➡
Dialogue: 0,0:22:29.28,0:22:34.11,Default,,0,0,0,,Менің техникамның жанама әсерінен сіз кем дегенде қатысуды тани білуіңіз керек.
Dialogue: 0,0:22:34.11,0:22:37.48,Default,,0,0,0,,Жақсы! (Маки) Жақсы➡
Dialogue: 0,0:22:37.48,0:22:39.45,Default,,0,0,0,,Бұл жігіт кім?
Dialogue: 0,0:22:42.62,0:22:47.33,Default,,0,0,0,,Әзірше... ол менің үлкен ағам.
Dialogue: 0,0:22:47.33,0:22:50.80,Default,,0,0,0,,Юджин~~! ! ! !
Dialogue: 0,0:22:50.80,0:22:52.87,Default,,0,0,0,,Кеттік.
Dialogue: 0,0:22:54.90,0:22:57.07,Default,,0,0,0,,Міне. ➡
Dialogue: 0,0:22:57.07,0:23:01.14,Default,,0,0,0,,Сөз жоқ. Алда інілерім ұйықтап жатыр. ➡
Dialogue: 0,0:23:01.14,0:23:03.11,Default,,0,0,0,,Мен оны ашамын. Иә.
Dialogue: 0,0:23:06.95,0:23:13.09,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:23:13.09,0:23:15.62,Default,,0,0,0,,Түсейік. ➡
Dialogue: 0,0:23:15.62,0:23:19.23,Default,,0,0,0,,Артқы жағында Раушан сарайына апаратын лифт бар.
Dialogue: 0,0:23:20.56,0:23:22.60,Default,,0,0,0,,Ісіну фазасы.
Dialogue: 0,0:23:22.60,0:23:24.67,Default,,0,0,0,,Мен білемін. ➡
Dialogue: 0,0:23:24.67,0:23:28.40,Default,,0,0,0,,Мен сені кейін алып кетемін. Тағы біраз күтіңіз.
Dialogue: 0,0:23:28.40,0:23:34.31,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:23:34.31,0:23:37.41,Default,,0,0,0,,Қан дақтары? Бірдеңе болды ма?
Dialogue: 0,0:23:37.41,0:23:39.88,Default,,0,0,0,,Бұл 12 жыл бұрын болды. ➡
Dialogue: 0,0:23:39.88,0:23:42.82,Default,,0,0,0,,Енді ойлап қарасам... барлық бұрмалаулар ➡
Dialogue: 0,0:23:42.82,0:23:45.95,Default,,0,0,0,,Ол сол кезде басталған болуы мүмкін. ➡
Dialogue: 0,0:23:45.95,0:23:49.16,Default,,0,0,0,,Кәне, бәрің, бас киелі орын дәл алда.
Dialogue: 0,0:23:49.16,0:24:04.14,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:24:04.14,0:24:06.87,Default,,0,0,0,,Қарғыс атсын. Ештеңе.
Dialogue: 0,0:24:06.87,0:24:08.94,Default,,0,0,0,,Бұл басты ғибадатхана ма?
Dialogue: 0,0:24:08.94,0:24:12.65,Default,,0,0,0,,Жоқ, олар бізді қабылдамайды. ➡
Dialogue: 0,0:24:12.65,0:24:15.52,Default,,0,0,0,,Теңген шындыққа араласпайды➡
Dialogue: 0,0:24:15.52,0:24:20.09,Default,,0,0,0,,Мен онымен қазір Рокуган мөрленген соң хабарласуға болады деп ойладым➡
Dialogue: 0,0:24:20.09,0:24:22.06,Default,,0,0,0,,Болжам нашар болды.
Dialogue: 0,0:24:23.69,0:24:26.76,Default,,0,0,0,,≪Қабылданбаған біз емес➡
Dialogue: 0,0:24:26.76,0:24:28.73,Default,,0,0,0,,Мен? ≫
Dialogue: 0,0:24:30.50,0:24:33.67,Default,,0,0,0,,Біз қайтеміз? Цумикидің уақыты жоқ.
Dialogue: 0,0:24:36.54,0:24:39.44,Default,,0,0,0,,Үйге барасыз ба? ➡
Dialogue: 0,0:24:39.44,0:24:43.34,Default,,0,0,0,,Танысқаныма қуаныштымын, Зениннің ұлы, Мичизанның қаны➡
Dialogue: 0,0:24:43.34,0:24:46.71,Default,,0,0,0,,Қарғыс атқан жатырдың тоғыз фазалық диаграммасы және...
Dialogue: 0,0:24:48.92,0:24:51.35,Default,,0,0,0,,Сукунаның ыдысы.
Dialogue: 0,0:24:51.35,0:24:54.52,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:24:55.96,0:25:02.80,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:25:02.80,0:25:06.50,Default,,0,0,0,,♬ Қараңғы күндерде жоқ көлеңке
Dialogue: 0,0:25:06.50,0:25:09.17,Default,,0,0,0,,♬ Мен ренжідім.
Dialogue: 0,0:25:09.17,0:25:12.44,Default,,0,0,0,,♬ Кешірім сұрау сияқты.
Dialogue: 0,0:25:12.44,0:25:15.74,Default,,0,0,0,,♬ Егілген тұқымдар аянышты
Dialogue: 0,0:25:15.74,0:25:18.15,Default,,0,0,0,,♬ гүлдей бастайды
Dialogue: 0,0:25:18.15,0:25:20.55,Default,,0,0,0,,♬ Сіз суықсыз
Dialogue: 0,0:25:20.55,0:25:22.78,Default,,0,0,0,,♬ Созылып қалды
Dialogue: 0,0:25:22.78,0:25:25.32,Default,,0,0,0,,♬ Аспанды алақан кеседі
Dialogue: 0,0:25:25.32,0:25:28.36,Default,,0,0,0,,♬ Жағдайлар қалпына келе ме?
Dialogue: 0,0:25:28.36,0:25:31.79,Default,,0,0,0,,♬ Толқындар жұтылады
Dialogue: 0,0:25:31.79,0:25:34.96,Default,,0,0,0,,♬ Болашақты жойып, жалғастырыңыз
Dialogue: 0,0:25:34.96,0:25:39.67,Default,,0,0,0,,♬ Ақырзаман келе ме?
Dialogue: 0,0:25:39.67,0:25:44.00,Default,,0,0,0,,♬ Үзіліп, үзіліп кетсем
Dialogue: 0,0:25:44.00,0:25:46.61,Default,,0,0,0,,♬ Байғұс шашылып кетсе де
Dialogue: 0,0:25:46.61,0:25:49.18,Default,,0,0,0,,♬ Мен ештеңеден қорықпаймын
Dialogue: 0,0:25:49.18,0:25:51.21,Default,,0,0,0,,♬ Өйткені қазірдің өзінде
Dialogue: 0,0:25:51.21,0:25:53.25,Default,,0,0,0,,♬ Өйткені ол әлдеқашан бос
Dialogue: 0,0:25:53.25,0:25:55.62,Default,,0,0,0,,♬ Ах, соңында
Dialogue: 0,0:25:55.62,0:25:58.89,Default,,0,0,0,,♬ Бұл шамды міндетті түрде өшіріңіз.
Dialogue: 0,0:25:58.89,0:26:02.39,Default,,0,0,0,,♬ Мен енді ештеңе қаламаймын
Dialogue: 0,0:26:02.39,0:26:05.36,Default,,0,0,0,,♬ Себебі мен оны қайтадан жоғалтып алудан қорқамын
Dialogue: 0,0:26:05.36,0:26:07.80,Default,,0,0,0,,♬ Таң атуға жақын болса да
Dialogue: 0,0:26:07.80,0:26:10.83,Default,,0,0,0,,♬ Тұман әлі сейілмейді
Dialogue: 0,0:26:10.83,0:26:13.77,Default,,0,0,0,,♬ Сол түсініксіз схема
Dialogue: 0,0:26:13.77,0:26:16.37,Default,,0,0,0,,♬ Оны міндетті түрде қадағалай отырып
Dialogue: 0,0:26:16.37,0:26:19.94,Default,,0,0,0,,♬ Мен келе жатырмын
Dialogue: 0,0:26:19.94,0:26:24.21,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:28:27.63,0:28:29.67,Default,,0,0,0,,Бір шарт қояйын. (Отоцу) Түрменің қақпасын қалай шешуге болады ➡
Dialogue: 0,0:28:29.67,0:28:31.71,Default,,0,0,0,,Мен сұрауға келдім. (99) Маған сәлем айтпайсың ба?
Dialogue: 0,0:28:31.71,0:28:33.91,Default,,0,0,0,,Сонда өлім сапары ше? (Теңген) Ол адамзатты дамуға мәжбүрлейді.
Dialogue: 0,0:28:33.91,0:28:35.88,Default,,0,0,0,,Ереже бойынша алып кетсе➡
Dialogue: 0,0:28:35.88,0:28:37.95,Default,,0,0,0,,Мен өлемін деп ойлаймын. Сукунаны ауыстырсам➡
Dialogue: 0,0:28:37.95,0:28:40.01,Default,,0,0,0,,Мені ойланбастан өлтіріңіз. (ісіну) Өлме.
Dialogue: 0,0:28:41.51,0:28:46.51,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
