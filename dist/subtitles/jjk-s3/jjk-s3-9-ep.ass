Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:34.30,0:00:37.00,Default,,0,0,0,,♬ МЕНІ ЖЕК КӨРЕДІ
Dialogue: 0,0:00:37.00,0:00:41.30,Default,,0,0,0,,♬ ME LUV ME KILL ME
Dialogue: 0,0:00:43.57,0:00:46.14,Default,,0,0,0,,♬ Сүйіспеншілік, жек көру, сүйіспеншілік, жек көру
Dialogue: 0,0:00:46.14,0:00:48.64,Default,,0,0,0,,♬ Дай Токио Рюусо Ута
Dialogue: 0,0:00:48.64,0:00:51.05,Default,,0,0,0,,♬ Маваримавари дәуірінде
Dialogue: 0,0:00:51.05,0:00:53.72,Default,,0,0,0,,♬ Ұятқа малынған
Dialogue: 0,0:00:53.72,0:00:56.29,Default,,0,0,0,,♬ Сүйіспеншілік, жек көру, махаббат және жек көру
Dialogue: 0,0:00:56.29,0:00:58.62,Default,,0,0,0,,♬ Бұл үлкен әңгіме сияқты.
Dialogue: 0,0:00:58.62,0:01:01.12,Default,,0,0,0,,♬ Екеуміз айырылысып қаламыз
Dialogue: 0,0:01:01.12,0:01:04.23,Default,,0,0,0,,♬ Олай болса тағы кездесейік. Сіз
Dialogue: 0,0:01:06.19,0:01:08.56,Default,,0,0,0,,♬ Драмаға батып кету
Dialogue: 0,0:01:08.56,0:01:11.03,Default,,0,0,0,,♬ Толық еместігімді мойында
Dialogue: 0,0:01:11.03,0:01:13.14,Default,,0,0,0,,♬ Босаңсытатын көркем әдебиет
Dialogue: 0,0:01:13.14,0:01:16.14,Default,,0,0,0,,♬ Өтірік пен шындық арасындағы диссонанс
Dialogue: 0,0:01:16.14,0:01:18.64,Default,,0,0,0,,♬ Махаббатым сәтсіз болса да кешір мені
Dialogue: 0,0:01:18.64,0:01:21.01,Default,,0,0,0,,♬ Мәселе жоқ! Осы кезеңнен аман өтіңіз
Dialogue: 0,0:01:21.01,0:01:23.31,Default,,0,0,0,,♬ Тістеген ит жауынгер қалтырап
Dialogue: 0,0:01:23.31,0:01:26.55,Default,,0,0,0,,♬ Есейе берсең, ересек бола алмайсың
Dialogue: 0,0:01:26.55,0:01:28.95,Default,,0,0,0,,♬ LUV ME Тек әділдік
Dialogue: 0,0:01:28.95,0:01:31.59,Default,,0,0,0,,♬ ЖЕК КӨР МЕНІ БӘРІН ЖҮРГІЗ
Dialogue: 0,0:01:31.59,0:01:34.09,Default,,0,0,0,,♬ LUV ME Махаббат пен жек көрушілікке толы
Dialogue: 0,0:01:34.09,0:01:38.96,Default,,0,0,0,,♬ ӨЛТІР мені бұл жерден алып кет
Dialogue: 0,0:01:38.96,0:01:41.60,Default,,0,0,0,,♬ Сүй, жек көр, сүй, жек көр, құшақтас
Dialogue: 0,0:01:41.60,0:01:43.97,Default,,0,0,0,,♬ Қай уақытта болса да шарықтау шегі
Dialogue: 0,0:01:43.97,0:01:46.50,Default,,0,0,0,,♬ Алдап-арбасаң да жарайды.
Dialogue: 0,0:01:46.50,0:01:49.40,Default,,0,0,0,,♬ Маған баға маңызды емес
Dialogue: 0,0:01:49.40,0:01:51.81,Default,,0,0,0,,♬ Ғашық, өшпенділік, сүйіспеншілік пен жек көрушілікте кезбе
Dialogue: 0,0:01:51.81,0:01:54.18,Default,,0,0,0,,♬ Дипломатиялық сүйкімділік себіңіз
Dialogue: 0,0:01:54.18,0:01:56.65,Default,,0,0,0,,♬ Барлық нәрсе сұрақ-жауапсыз аяқталады
Dialogue: 0,0:01:56.65,0:02:00.15,Default,,0,0,0,,♬ Олай болса тағы кездесейік. Сіз
Dialogue: 0,0:02:05.52,0:02:09.99,Default,,0,0,0,,Аймақты кеңейту. «Қорлау арқылы өлім».
Dialogue: 0,0:02:09.99,0:02:13.93,Default,,0,0,0,,≪Аумақ‼ Техниканы іске қоспас бұрын≫
Dialogue: 0,0:02:13.93,0:02:16.80,Default,,0,0,0,,≪Жеңілу!! ≫
Dialogue: 0,0:02:16.80,0:02:21.10,Default,,0,0,0,,Хаа хаа ха....
Dialogue: 0,0:02:21.10,0:02:25.24,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:25.24,0:02:29.81,Default,,0,0,0,,Мұнда барлық зорлық-зомбылық әрекеттеріне тыйым салынады. ➡
Dialogue: 0,0:02:29.81,0:02:32.51,Default,,0,0,0,,Бір-біріне. Бір-бірін?
Dialogue: 0,0:02:32.51,0:02:34.52,Default,,0,0,0,,Уа.
Dialogue: 0,0:02:36.45,0:02:40.82,Default,,0,0,0,,Ах, мен оны аяқтай алмаймын. Ауызша зорлық-зомбылық басқаша.
Dialogue: 0,0:02:40.82,0:02:43.63,Default,,0,0,0,,Судья, бастаңыз.
Dialogue: 0,0:02:43.63,0:02:47.10,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:47.10,0:02:52.27,Default,,0,0,0,,Юхито Коджо 18 жасқа толмаған болса да➡
Dialogue: 0,0:02:52.27,0:02:56.07,Default,,0,0,0,,16 шілде 2017 жыл➡
Dialogue: 0,0:02:56.07,0:02:59.91,Default,,0,0,0,,Сендай қаласындағы, Мияги префектурасындағы Пачинкодағы «Маджи Вегас» салонында➡
Dialogue: 0,0:02:59.91,0:03:03.31,Default,,0,0,0,,Бұл адам дүкенге тұтынушы ретінде кірді деген күдік бар.
Dialogue: 0,0:03:03.31,0:03:06.75,Default,,0,0,0,,А? а.
Dialogue: 0,0:03:06.75,0:03:10.42,Default,,0,0,0,,Жоқ? мм? Міне бітті.
Dialogue: 0,0:03:10.42,0:03:14.99,Default,,0,0,0,,Төреші өз аймағындағы әрбір адам туралы бәрін біледі.
Dialogue: 0,0:03:14.99,0:03:17.16,Default,,0,0,0,,Бірақ уайымдамаңыз.
Dialogue: 0,0:03:17.16,0:03:20.20,Default,,0,0,0,,Бұл ақпарат менімен бөлісілмейді.
Dialogue: 0,0:03:20.20,0:03:23.40,Default,,0,0,0,,Үкім тек екеуміздің дәлелдерімізге негізделген➡
Dialogue: 0,0:03:23.40,0:03:25.67,Default,,0,0,0,,Жіберілді. ➡
Dialogue: 0,0:03:25.67,0:03:28.40,Default,,0,0,0,,Осы «дәлелден» басқа.
Dialogue: 0,0:03:28.40,0:03:31.64,Default,,0,0,0,,Эх!! Мен білмей тұрып...
Dialogue: 0,0:03:31.64,0:03:35.64,Default,,0,0,0,,Бұл судья ұсынған іс бойынша дәлелдеме. ➡
Dialogue: 0,0:03:35.64,0:03:40.32,Default,,0,0,0,,«Дәлелдер» сіздің күдіктеріңізді растамайды.
Dialogue: 0,0:03:40.32,0:03:43.29,Default,,0,0,0,,Мазмұнын айтайын деген ойым жоқ.
Dialogue: 0,0:03:43.29,0:03:45.92,Default,,0,0,0,,Оның үстіне, сіз өз жағдайыңызды айтасыз➡
Dialogue: 0,0:03:45.92,0:03:48.39,Default,,0,0,0,,Төрешіден күдіктен арылыңыз➡
Dialogue: 0,0:03:48.39,0:03:50.69,Default,,0,0,0,,«Кінәлі емес» дегенге қол жеткізу керек.
Dialogue: 0,0:03:52.36,0:03:54.46,Default,,0,0,0,,≪Сот тәртібі...≫
Dialogue: 0,0:03:56.26,0:03:59.97,Default,,0,0,0,,≪Сол төсбелгі... Адвокат байсалды ма?≫
Dialogue: 0,0:03:59.97,0:04:03.67,Default,,0,0,0,,<<Сіздің істеп жатқан ісіңіз прокуратураға ұқсас емес пе? ≫
Dialogue: 0,0:04:03.67,0:04:05.84,Default,,0,0,0,,≪Ничиша – заманауи адам➡
Dialogue: 0,0:04:05.84,0:04:08.34,Default,,0,0,0,,Бұл аймақ Теңген-саманың айтқаны...≫
Dialogue: 0,0:04:09.71,0:04:12.45,Default,,0,0,0,,((Ежелгі сиқыршылар үшін патшалық болды
Dialogue: 0,0:04:12.45,0:04:16.82,Default,,0,0,0,,Бұл қазіргіден әлдеқайда стандартты технология болды. ➡
Dialogue: 0,0:04:16.82,0:04:20.49,Default,,0,0,0,,Себебі қазіргі аймақта көп➡
Dialogue: 0,0:04:20.49,0:04:25.76,Default,,0,0,0,,Бұл ''Хишитацу'' сөзінің ''Hisatsu'' бөлігі түсірілгендіктен. ➡
Dialogue: 0,0:04:25.76,0:04:31.57,Default,,0,0,0,,Аймақтағы нысанаға ''техника'' арқылы ''кепілдендірілген соққы'' беріңіз. ➡
Dialogue: 0,0:04:31.57,0:04:35.97,Default,,0,0,0,,Бұл өткендегі жалпы доменнің өнімділігі. ➡
Dialogue: 0,0:04:35.97,0:04:38.01,Default,,0,0,0,,«Өлімге» тым көп көңіл бөлу➡
Dialogue: 0,0:04:38.01,0:04:41.81,Default,,0,0,0,,Аймақты салу шарттарына кедергілер көтерілді➡
Dialogue: 0,0:04:41.81,0:04:45.21,Default,,0,0,0,,Аймақ озық технологияға айналады➡
Dialogue: 0,0:04:45.21,0:04:48.45,Default,,0,0,0,,Ал пайдаланушылар саны азайды))
Dialogue: 0,0:04:48.45,0:04:52.02,Default,,0,0,0,,≪Басқа сөзбен айтқанда, бұл аймақ «өлім» емес➡
Dialogue: 0,0:04:52.02,0:04:54.72,Default,,0,0,0,,Маған физикалық зиян келтірмеңіз➡
Dialogue: 0,0:04:54.72,0:04:57.93,Default,,0,0,0,,Мен де белгілі бір дәрежеде ережелерді түсіндіремін➡
Dialogue: 0,0:04:57.93,0:04:59.93,Default,,0,0,0,,Ол «байланыстырудан» тұрады!! ≫
Dialogue: 0,0:05:01.63,0:05:06.47,Default,,0,0,0,,Сізде мәлімдеме жасауға бір мүмкіндік бар. Бұл да өзара. ➡
Dialogue: 0,0:05:06.47,0:05:09.44,Default,,0,0,0,,Сізден кейін мен де бір рет, осы дәлелге сүйеніп➡
Dialogue: 0,0:05:09.44,0:05:11.67,Default,,0,0,0,,Қарсы дәлел келтірейін➡
Dialogue: 0,0:05:11.67,0:05:17.58,Default,,0,0,0,,Соңында судья алты заңның негізінде үкім шығарады.
Dialogue: 0,0:05:17.58,0:05:20.05,Default,,0,0,0,,Мен кінәлі болып табылсам ше?
Dialogue: 0,0:05:20.05,0:05:23.95,Default,,0,0,0,,Өкінішке орай, бұл сұрақ бойынша жауапкершілік жоқ. ➡
Dialogue: 0,0:05:23.95,0:05:28.79,Default,,0,0,0,,Мен оны алмастырушы ретінде айтқым келмейді, бірақ мен сізге мынаны айтайын.
Dialogue: 0,0:05:28.79,0:05:30.89,Default,,0,0,0,,Сізде үш таңдау бар.
Dialogue: 0,0:05:34.53,0:05:38.43,Default,,0,0,0,,Ал «бас тарту» жалған мәлімдемелерді қамтиды.
Dialogue: 0,0:05:38.43,0:05:40.70,Default,,0,0,0,,Бұл өтірік айту дұрыс дегенді білдіре ме?
Dialogue: 0,0:05:40.70,0:05:42.74,Default,,0,0,0,,Бұл сот процесі болса да?
Dialogue: 0,0:05:42.74,0:05:45.17,Default,,0,0,0,,Шындықты айтсаңыздар бәріңіз➡
Dialogue: 0,0:05:45.17,0:05:48.51,Default,,0,0,0,,Сот талқылауының қажеті жоқ. ➡
Dialogue: 0,0:05:48.51,0:05:53.92,Default,,0,0,0,,Енді кешіріңіз. Судьяның көп уайымдауға қажеті жоқ.
Dialogue: 0,0:05:56.15,0:05:58.89,Default,,0,0,0,,≪Мен сол пачинко салонына барамын➡
Dialogue: 0,0:05:58.89,0:06:02.52,Default,,0,0,0,,Play hard, I feel like I won...≫
Dialogue: 0,0:06:02.52,0:06:06.19,Default,,0,0,0,,≪Кінәсіздігін мәлімдеу үшін өтірік айту сөзсіз≫
Dialogue: 0,0:06:06.19,0:06:09.40,Default,,0,0,0,,≪Егер олай болса, әрине, мен бұл туралы ойлануым керек...≫
Dialogue: 0,0:06:09.40,0:06:12.40,Default,,0,0,0,,≪Сол «дәлелдердің» мазмұны!! ≫
Dialogue: 0,0:06:12.40,0:06:14.84,Default,,0,0,0,,(("Дәлелдер" сіздің күдіктеріңізді дәлелдемейді➡
Dialogue: 0,0:06:14.84,0:06:17.97,Default,,0,0,0,,Түпкілікті емес))
Dialogue: 0,0:06:17.97,0:06:21.58,Default,,0,0,0,,≪① Егер дәлелдер пачинко салонына кіруді қолдамаса➡
Dialogue: 0,0:06:21.58,0:06:25.55,Default,,0,0,0,,«Ска» болса, үндемеу немесе жоққа шығаруға болады≫
Dialogue: 0,0:06:25.55,0:06:28.82,Default,,0,0,0,,≪② Егер дәлелдер тек дүкенге кіруді қолдаса➡
Dialogue: 0,0:06:28.82,0:06:31.22,Default,,0,0,0,,Жеңілдететін сылтау айтыңыз? ≫
Dialogue: 0,0:06:33.29,0:06:37.23,Default,,0,0,0,,≪Бірақ дәлел ① “Ska” болса, сізге дүкенге кіруге рұқсат беріледі➡
Dialogue: 0,0:06:37.23,0:06:40.20,Default,,0,0,0,,Бәлкім, көр қазуым керек шығар? ≫
Dialogue: 0,0:06:40.20,0:06:42.66,Default,,0,0,0,,≪③ Дәлел тек дүкенге кіру емес➡
Dialogue: 0,0:06:42.66,0:06:46.57,Default,,0,0,0,,«Ойынға» да қолдау көрсетілсе, ол өлуге жақын...≫
Dialogue: 0,0:06:48.14,0:06:51.07,Default,,0,0,0,,≪Қылмысыңызды мойындау арқылы жеңілдететініне бәс тігесіз бе? ≫
Dialogue: 0,0:06:51.07,0:06:54.08,Default,,0,0,0,,≪Біріншіден, бұл сотта маңызды нәрсе бар ма? ≫
Dialogue: 0,0:06:54.08,0:06:57.61,Default,,0,0,0,,Дан! Мен➡
Dialogue: 0,0:06:57.61,0:07:01.08,Default,,0,0,0,,Мен «Маджи Вегас» пачинко салонына кірдім➡
Dialogue: 0,0:07:01.08,0:07:05.75,Default,,0,0,0,,Менде дәретхананы пайдаланудан басқа амал қалмады, себебі кенеттен дәретхананы пайдалану қажет болды.
Dialogue: 0,0:07:05.75,0:07:07.79,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:07.79,0:07:10.83,Default,,0,0,0,,≪Қою ③!! Жеңілдететін жағдайлар жоқ➡
Dialogue: 0,0:07:10.83,0:07:12.99,Default,,0,0,0,,Мен мұның рас екенін білмеймін➡
Dialogue: 0,0:07:12.99,0:07:17.00,Default,,0,0,0,,Менің ойымша, бұл ең жақсы әсер қалдырады...≫
Dialogue: 0,0:07:17.00,0:07:20.10,Default,,0,0,0,,Енді менің кезегім.
Dialogue: 0,0:07:20.10,0:07:23.57,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:07:23.57,0:07:27.68,Default,,0,0,0,,Бұл оқиға болған күні «Маджи Вегастың» жанындағы антиквариат дүкені...
Dialogue: 0,0:07:27.68,0:07:30.11,Default,,0,0,0,,Ах. Айта берсем➡
Dialogue: 0,0:07:30.11,0:07:33.01,Default,,0,0,0,,Бұл ақша айырбастау пунктінен алынған қауіпсіздік камерасы.
Dialogue: 0,0:07:35.02,0:07:37.19,Default,,0,0,0,,Ах.
Dialogue: 0,0:07:37.19,0:07:40.96,Default,,0,0,0,,Дене бітімі мен бойы Барлығын Юхито Коджоның өзі көргендей➡
Dialogue: 0,0:07:40.96,0:07:43.43,Default,,0,0,0,,Айырмашылық жоқ па?
Dialogue: 0,0:07:43.43,0:07:46.46,Default,,0,0,0,,Хехехе….
Dialogue: 0,0:07:46.46,0:07:51.07,Default,,0,0,0,,Енді мен дүкенге кірдім, бұл түсірілімнен көріп тұрғанымдай ➡
Dialogue: 0,0:07:51.07,0:07:54.67,Default,,0,0,0,,Дәретханалар сенуге тұрарлық емес ➡
Dialogue: 0,0:07:54.67,0:07:57.77,Default,,0,0,0,,Өйткені, Кожо 18 жасқа толмаған➡
Dialogue: 0,0:07:57.77,0:08:00.28,Default,,0,0,0,,Адам дүкенге ойын ойнау мақсатында кірген сияқты.
Dialogue: 0,0:08:01.88,0:08:05.68,Default,,0,0,0,,Бұл қандай қылмыс?
Dialogue: 0,0:08:05.68,0:08:10.92,Default,,0,0,0,,Дүкен 18 жасқа толмаған адамдарға кіруге ашық түрде бас тартады➡
Dialogue: 0,0:08:10.92,0:08:14.02,Default,,0,0,0,,Бұл ғимаратқа кіру қылмысы. ➡
Dialogue: 0,0:08:14.02,0:08:19.93,Default,,0,0,0,,Қылмыстық кодекстің 130-бабы. Ойын-сауық бизнесі туралы заңға сәйкес кәмелетке толмағандардың өздері жазаланбайды.
Dialogue: 0,0:08:21.53,0:08:23.57,Default,,0,0,0,,Бұл алдау.
Dialogue: 0,0:08:23.57,0:08:26.13,Default,,0,0,0,,Оны қалай түсіндіруге тырыссаңыз да, мағынасы жоқ.
Dialogue: 0,0:08:26.13,0:08:28.17,Default,,0,0,0,,≪Бұл ③...≫ болды ма
Dialogue: 0,0:08:28.17,0:08:32.21,Default,,0,0,0,,Сіз не айтып тұрсыз? Жапонияда құмар ойындарға тыйым салынған➡
Dialogue: 0,0:08:32.21,0:08:35.18,Default,,0,0,0,,Дүкен мен айырбастау пункті жеке заңды тұлғалар болып табылады. ➡
Dialogue: 0,0:08:35.18,0:08:38.11,Default,,0,0,0,,Кейбір жағдайларда оны бірнеше дүкен бөліседі. ➡
Dialogue: 0,0:08:38.11,0:08:40.18,Default,,0,0,0,,Ал сұралатын нәрсе ➡
Dialogue: 0,0:08:40.18,0:08:43.28,Default,,0,0,0,,Тек «Маджи Вегасқа» кіру үшін.
Dialogue: 0,0:08:43.28,0:08:46.72,Default,,0,0,0,,Сіз жай ғана: «Мен мұндай дүкендерді білмеймін» деп айтасыз.➡
Dialogue: 0,0:08:46.72,0:08:50.76,Default,,0,0,0,,Сізге тағылған айыптарды жоққа шығару ғана болды.
Dialogue: 0,0:08:50.76,0:08:54.33,Default,,0,0,0,,Жоқ, үкім әлі шыққан жоқ.
Dialogue: 0,0:08:54.33,0:08:56.43,Default,,0,0,0,,Can-can!
Dialogue: 0,0:09:05.44,0:09:07.91,Default,,0,0,0,,≪Бастапқы кеңістікке оралды...≫
Dialogue: 0,0:09:07.91,0:09:10.28,Default,,0,0,0,,≪Мен кінәлі деп танылдым➡
Dialogue: 0,0:09:10.28,0:09:12.41,Default,,0,0,0,,Әсіресе біртүрлі... Уф!! ≫
Dialogue: 0,0:09:12.41,0:09:19.62,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:09:19.62,0:09:21.82,Default,,0,0,0,,Дого! ≪Бұл...≫
Dialogue: 0,0:09:23.16,0:09:25.26,Default,,0,0,0,,(Репортер) Оны бұрын бір жерде көргендеймін, бірақ мүмкін қате естіппін…
Dialogue: 0,0:09:26.56,0:09:30.73,Default,,0,0,0,,≪Бұл балғаны өз қалауыңыз бойынша шығаруға және алуға болады➡
Dialogue: 0,0:09:30.73,0:09:33.03,Default,,0,0,0,,Өлшемді өзгерте аласыз ба? ≫
Dialogue: 0,0:09:33.03,0:09:35.74,Default,,0,0,0,,≪Жоқ, одан да көп≫
Dialogue: 0,0:09:35.74,0:09:37.94,Default,,0,0,0,,Ол берік.
Dialogue: 0,0:09:37.94,0:09:39.97,Default,,0,0,0,,Бұл оның ерекшелігі.
Dialogue: 0,0:09:39.97,0:09:44.21,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:09:44.21,0:09:46.31,Default,,0,0,0,,≪Мен емлені нақтылай алмаймын...≫
Dialogue: 0,0:09:53.25,0:09:55.29,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:09:55.29,0:09:58.73,Default,,0,0,0,,<59 оқу кезеңі. Ивате адвокаттар алқасына жатады➡
Dialogue: 0,0:09:58.73,0:10:01.93,Default,,0,0,0,,Хироми Никша, 36 жаста>
Dialogue: 0,0:10:05.70,0:10:09.37,Default,,0,0,0,,<Заң факультетін енгізуге дейінгі ескі адвокаттық емтихан және т.б.➡
Dialogue: 0,0:10:09.37,0:10:13.11,Default,,0,0,0,,Барлық кедергілерден түз өту＞
Dialogue: 0,0:10:13.11,0:10:17.75,Default,,0,0,0,,<Никша үшін олар қажетті білімді енгізеді➡
Dialogue: 0,0:10:17.75,0:10:22.95,Default,,0,0,0,,Қажет болғанша шығарыңыз Бұл оңай тапсырма болды>
Dialogue: 0,0:10:28.42,0:10:32.63,Default,,0,0,0,,＜ Алайда оның ішіндегі ең жарқыраған асыл тас – ➡
Dialogue: 0,0:10:32.63,0:10:36.13,Default,,0,0,0,,Оның сиқыршы ретіндегі таланты>
Dialogue: 0,0:10:36.13,0:10:38.17,Default,,0,0,0,,Уф! Қарғыс атқыр...
Dialogue: 0,0:10:38.17,0:10:40.37,Default,,0,0,0,,<Аймақ әдепкі бойынша берілген➡
Dialogue: 0,0:10:40.37,0:10:43.00,Default,,0,0,0,,Өзіңіздің хирургиялық әдісіңізді түсіндіру арқылы➡
Dialogue: 0,0:10:43.00,0:10:46.27,Default,,0,0,0,,Бір уақытта бөгет техникасының негіздерін үйреніңіз＞
Dialogue: 0,0:10:46.27,0:10:48.31,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:48.31,0:10:50.81,Default,,0,0,0,,<Тосқауыл техникасынан кері есептеу➡
Dialogue: 0,0:10:50.81,0:10:53.98,Default,,0,0,0,,Сиқырлы күшпен манипуляциялау арқылы күшейту әдістерін түсініңіз➡
Dialogue: 0,0:10:53.98,0:10:56.55,Default,,0,0,0,,Гүлденуден бастап 12 күн ішінде➡
Dialogue: 0,0:10:56.55,0:11:01.96,Default,,0,0,0,,1-сыныптағы сиқыршымен салыстырылатын деңгейге дейін өседі➡
Dialogue: 0,0:11:01.96,0:11:06.26,Default,,0,0,0,,Тосқауылға кірмес бұрын көптеген қарғыс атқан рухтармен күресіңіз➡
Dialogue: 0,0:11:06.26,0:11:11.13,Default,,0,0,0,,20-дан астам жүзуші қаза тапты>
Dialogue: 0,0:11:11.13,0:11:13.13,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:11:15.80,0:11:20.21,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:11:20.21,0:11:22.84,Default,,0,0,0,,Ха ха ха ха ха….
Dialogue: 0,0:11:22.84,0:11:24.88,Default,,0,0,0,,Бум!
Dialogue: 0,0:11:24.88,0:11:33.49,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:11:33.49,0:11:35.52,Default,,0,0,0,,Ол меннен қанша есе мықты. (Очако) Ах…
Dialogue: 0,0:11:35.52,0:11:40.76,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:11:40.76,0:11:43.23,Default,,0,0,0,,Гагагагага…
Dialogue: 0,0:11:43.23,0:11:49.00,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:11:49.00,0:11:52.77,Default,,0,0,0,,Емле күшіңізді нақтылай алмайсыз ба?
Dialogue: 0,0:11:52.77,0:11:55.91,Default,,0,0,0,,Сіз мұны істедіңіз, солай ма?
Dialogue: 0,0:11:55.91,0:11:58.31,Default,,0,0,0,,«Тәркілеу» жазасы уақытша➡
Dialogue: 0,0:11:58.31,0:12:01.55,Default,,0,0,0,,Бұл заклинанияны қолдануды мүмкін емес етеді.
Dialogue: 0,0:12:01.55,0:12:05.89,Default,,0,0,0,,Менің ойымша, сізде техника болмаған.
Dialogue: 0,0:12:05.89,0:12:11.36,Default,,0,0,0,,Сондықтан болар, жаза ``сиқырлы күшті пайдалана алмау'' болып өзгерді. ➡
Dialogue: 0,0:12:11.36,0:12:14.60,Default,,0,0,0,,Айтпақшы, тәркілеу бастапқыда қосымша жаза болып табылады➡
Dialogue: 0,0:12:14.60,0:12:17.60,Default,,0,0,0,,Ол өздігінен салынбайды.
Dialogue: 0,0:12:17.60,0:12:21.24,Default,,0,0,0,,≪Өзім айтудың өзі қорқынышты≫
Dialogue: 0,0:12:21.24,0:12:25.61,Default,,0,0,0,,≪Ешбір сиқырлы күшсіз неге менімен теңдей бәсекелесе аласың... ➡
Dialogue: 0,0:12:25.61,0:12:29.28,Default,,0,0,0,,Сиқыршы ретінде емес, табиғи дене ретінде!! ➡
Dialogue: 0,0:12:29.28,0:12:32.98,Default,,0,0,0,,Ол тірі зат сияқты керемет күшті ме? ➡
Dialogue: 0,0:12:32.98,0:12:36.02,Default,,0,0,0,,Сиқыршы техниканы қолдана алмай қалғанда➡
Dialogue: 0,0:12:36.02,0:12:39.79,Default,,0,0,0,,Тіпті негізгі сиқырлы қуат операциялары жиі қиын болады. ➡
Dialogue: 0,0:12:39.79,0:12:42.32,Default,,0,0,0,,Бәлкім, менің көптен бері ұстанған түйсігім түтіккен шығар. ➡
Dialogue: 0,0:12:42.32,0:12:46.63,Default,,0,0,0,,Одан да кемшілігі: сиқырлы күшті пайдалана алмау!! ➡
Dialogue: 0,0:12:46.63,0:12:50.30,Default,,0,0,0,,Сол күйімде осы уақытқа дейін күресе алғаным!! ≫
Dialogue: 0,0:12:50.30,0:12:55.20,Default,,0,0,0,,≪Орташа жігіттер үшін жекпе-жекте жеңіске жету үшін бірінші соққы жеткілікті болар еді➡
Dialogue: 0,0:12:55.20,0:12:58.67,Default,,0,0,0,,Сақтандырсаң, аяғыңнан сыпырылып кетесің➡
Dialogue: 0,0:12:58.67,0:13:00.71,Default,,0,0,0,,Бар күшіңмен құрту...≫
Dialogue: 0,0:13:00.71,0:13:06.58,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:13:06.58,0:13:08.68,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:11.42,0:13:13.45,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:13.45,0:13:22.66,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:13:22.66,0:13:25.23,Default,,0,0,0,,Бум! Ха!
Dialogue: 0,0:13:25.23,0:13:30.87,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:13:30.87,0:13:32.84,Default,,0,0,0,,Ух!!
Dialogue: 0,0:13:32.84,0:13:38.38,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:13:38.38,0:13:41.38,Default,,0,0,0,,Дого! Nga!!
Dialogue: 0,0:13:41.38,0:13:43.42,Default,,0,0,0,,Бұл керемет!!
Dialogue: 0,0:13:43.42,0:13:46.72,Default,,0,0,0,,≪Сіз сынбайтын қуыршақпен айналысып жатқан сияқтысыз...≫
Dialogue: 0,0:13:46.72,0:13:48.79,Default,,0,0,0,,≪Бұл қауіпті, бұл қауіпті, бұл қауіпті, бұл қауіпті!! ≫
Dialogue: 0,0:13:48.79,0:13:53.36,Default,,0,0,0,,≪Ол қанша уақытқа созылады!! Қарғыс атқан билік!! Тезірек қарғыс ал! ≫
Dialogue: 0,0:13:53.36,0:13:56.10,Default,,0,0,0,,≪Бұл сондай қабілет. Бірдеңе...➡
Dialogue: 0,0:13:56.10,0:14:00.37,Default,,0,0,0,,Ничишаға тиімсіз фактор бар емес пе?
Dialogue: 0,0:14:00.37,0:14:04.04,Default,,0,0,0,,≪Ойлан!! Ойлан, ойлан!! ≫
Dialogue: 0,0:14:04.04,0:14:07.14,Default,,0,0,0,,≪Сот тәртібі!! Сынақ…≫
Dialogue: 0,0:14:07.14,0:14:13.98,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:14:13.98,0:14:16.02,Default,,0,0,0,,Ха!! Никша! ! !
Dialogue: 0,0:14:16.02,0:14:18.55,Default,,0,0,0,,Қайталап көрейік! Тағы да!
Dialogue: 0,0:14:18.55,0:14:22.99,Default,,0,0,0,,Ха ха ха ха ха….
Dialogue: 0,0:14:22.99,0:14:26.49,Default,,0,0,0,,А... уф....
Dialogue: 0,0:14:28.53,0:14:32.27,Default,,0,0,0,,Сіз байқадыңыз ба? Хахаха….
Dialogue: 0,0:14:32.27,0:14:37.37,Default,,0,0,0,,Бұл қауіпті. ...Бұл екінші төреші деп аталады.
Dialogue: 0,0:14:37.37,0:14:40.27,Default,,0,0,0,,<Судья соттады➡
Dialogue: 0,0:14:40.27,0:14:42.78,Default,,0,0,0,,Жаза алған адам –➡
Dialogue: 0,0:14:42.78,0:14:45.11,Default,,0,0,0,,Кінәні мойындамайынша➡
Dialogue: 0,0:14:45.11,0:14:49.58,Default,,0,0,0,,Жаңа сынақ нұсқасын екі ретке дейін сұрауға болады>
Dialogue: 0,0:14:54.99,0:14:57.99,Default,,0,0,0,,Дан! Мінеки тағы біз!!
Dialogue: 0,0:15:00.80,0:15:06.50,Default,,0,0,0,,Юхито Кожо 2018 жылдың 31 қазаны➡
Dialogue: 0,0:15:06.50,0:15:10.71,Default,,0,0,0,,Шибуяда жаппай кісі өлтірді деген күдікті.
Dialogue: 0,0:15:13.71,0:15:18.31,Default,,0,0,0,,А, мен оны өлтірдім. Бұл өтірік те, жоққа шығару да емес.
Dialogue: 0,0:15:31.16,0:15:33.26,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:15:33.26,0:15:38.50,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:38.50,0:15:40.90,Default,,0,0,0,,((Йошизава мырза…➡
Dialogue: 0,0:15:40.90,0:15:44.11,Default,,0,0,0,,Жоба болса, мен оны жаңа ғана тапсырдым...))
Dialogue: 0,0:15:45.44,0:15:47.71,Default,,0,0,0,,((А, жоқ, жоқ. ➡
Dialogue: 0,0:15:47.71,0:15:51.11,Default,,0,0,0,,Мен құжатты көрдім. Керемет. ➡
Dialogue: 0,0:15:51.11,0:15:54.22,Default,,0,0,0,,Оны пайымдау ретінде қолдануға болады➡
Dialogue: 0,0:15:55.85,0:16:01.06,Default,,0,0,0,,Прокурор немесе адвокат болғың келгеніне сенімдімін))
Dialogue: 0,0:16:01.06,0:16:05.23,Default,,0,0,0,,() (Йошизава)((мен қызық.➡
Dialogue: 0,0:16:05.23,0:16:08.23,Default,,0,0,0,,Неге судья болуды мақсат етпеске? ))
Dialogue: 0,0:16:08.23,0:16:17.51,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:16:17.51,0:16:21.64,Default,,0,0,0,,<Судья тағайындаған ең ауыр жаза➡
Dialogue: 0,0:16:21.64,0:16:26.05,Default,,0,0,0,,«Тәркілеу» бар «Өлім жазасы»>
Dialogue: 0,0:16:27.85,0:16:31.05,Default,,0,0,0,,<“Тәркілеу” тәртібімен➡
Dialogue: 0,0:16:31.05,0:16:35.62,Default,,0,0,0,,Сиқырлы күш қолдану мүмкін болмаған кезде жолбарыс таяқшасы➡
Dialogue: 0,0:16:35.62,0:16:40.39,Default,,0,0,0,,Нисшаға＞ «Жалла қылышы» беріледі
Dialogue: 0,0:16:40.39,0:16:44.10,Default,,0,0,0,,<«Жаллашының қылышынан» кесілгендер➡
Dialogue: 0,0:16:44.10,0:16:49.14,Default,,0,0,0,,Ерекшеліксіз өлімге әкелуі керек
Dialogue: 0,0:16:49.14,0:16:51.64,Default,,0,0,0,,≪Адамдардың жүрегіне жақын≫
Dialogue: 0,0:16:51.64,0:16:55.44,Default,,0,0,0,,≪Бұл адамдардың әлсіз жақтарын түсінуді білдіреді≫
Dialogue: 0,0:16:55.44,0:16:59.05,Default,,0,0,0,,≪Жәбірленушінің әлсіздігі Қылмыскердің әлсіздігі➡
Dialogue: 0,0:17:00.41,0:17:04.09,Default,,0,0,0,,Күн сайын Күн сайын Күн сайын➡
Dialogue: 0,0:17:04.09,0:17:07.19,Default,,0,0,0,,Мен үнемі тамақтан зардап шектім➡
Dialogue: 0,0:17:07.19,0:17:10.63,Default,,0,0,0,,Ұсқынсыз. Біреуге жақындаған сайын ➡
Dialogue: 0,0:17:10.63,0:17:13.96,Default,,0,0,0,,Мен осылай ойлай бастадым≫
Dialogue: 0,0:17:13.96,0:17:16.66,Default,,0,0,0,,Сен де... Кожо!! ➡
Dialogue: 0,0:17:18.30,0:17:21.84,Default,,0,0,0,,Барлығы!! Әлсіз және ұсқынсыз!! ➡
Dialogue: 0,0:17:21.84,0:17:25.34,Default,,0,0,0,,Асыл жанды қанша тілесең де!
Dialogue: 0,0:17:28.08,0:17:30.44,Default,,0,0,0,,Одан басқа ештеңе жоқ!!
Dialogue: 0,0:17:30.44,0:17:32.65,Default,,0,0,0,,Алдымдағы қараңғылық жай ғана қараңғылық!! ➡
Dialogue: 0,0:17:33.95,0:17:36.28,Default,,0,0,0,,Жарық жанып тұрған жерде!!
Dialogue: 0,0:17:36.28,0:17:38.85,Default,,0,0,0,,Жарқыраған бос жер қайтадан жайылып жатыр!
Dialogue: 0,0:17:38.85,0:17:40.89,Default,,0,0,0,,Ух!!
Dialogue: 0,0:17:40.89,0:17:45.26,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:17:45.26,0:17:50.87,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:17:50.87,0:17:52.87,Default,,0,0,0,,Хмм... Ух!!
Dialogue: 0,0:17:54.27,0:17:58.87,Default,,0,0,0,,((түсініп тұрмын... себебін сұрайын))
Dialogue: 0,0:17:58.87,0:18:02.48,Default,,0,0,0,,≪Барлық адамдар әлсіз және ұсқынсыз≫
Dialogue: 0,0:18:04.58,0:18:08.08,Default,,0,0,0,,((Мансаптық өсуге мүдделі емес адамдар үшін жарамсыз))
Dialogue: 0,0:18:09.52,0:18:14.69,Default,,0,0,0,,≪Бірақ сол уақытта, ең болмағанда сол уақытқа дейін➡
Dialogue: 0,0:18:14.69,0:18:18.23,Default,,0,0,0,,Басқа тіршілік иелерінде жоқ ластық➡
Dialogue: 0,0:18:18.23,0:18:21.33,Default,,0,0,0,,Мен оны құрметтеу керек деп ойладым! ➡
Dialogue: 0,0:18:21.33,0:18:25.00,Default,,0,0,0,,Неге, Юджи Кожо...➡
Dialogue: 0,0:18:25.00,0:18:27.47,Default,,0,0,0,,Неліктен кінәні мойындадың...≫
Dialogue: 0,0:18:27.47,0:18:30.91,Default,,0,0,0,,<Судья ұсынған дәлелдемелер туралы ақпарат➡
Dialogue: 0,0:18:30.91,0:18:35.11,Default,,0,0,0,,Тәжірибеші маманмен ашылғанға дейін ортақ＞
Dialogue: 0,0:18:35.11,0:18:38.95,Default,,0,0,0,,≪Сіз ұсынған дәлел сіздің ішіңізге ұя салған шайтан➡
Dialogue: 0,0:18:38.95,0:18:41.35,Default,,0,0,0,,Шукуна туралы!! ≫
Dialogue: 0,0:18:41.35,0:18:43.55,Default,,0,0,0,,≪Мен сені өлтірген жоқпын!! ➡
Dialogue: 0,0:18:43.55,0:18:45.95,Default,,0,0,0,,Неге!! неге! ≫
Dialogue: 0,0:18:45.95,0:18:47.99,Default,,0,0,0,,Ух!! Ха!
Dialogue: 0,0:18:47.99,0:18:49.99,Default,,0,0,0,,Ku!!
Dialogue: 0,0:18:52.63,0:18:55.30,Default,,0,0,0,,Ха! Дого!
Dialogue: 0,0:18:55.30,0:18:57.30,Default,,0,0,0,,Гуо!!
Dialogue: 0,0:18:59.50,0:19:02.14,Default,,0,0,0,,Ух!! Гуа!!
Dialogue: 0,0:19:02.14,0:19:04.24,Default,,0,0,0,,(Репортер) Оны бұрын бір жерде көргендеймін, бірақ мүмкін қате естіппін…
Dialogue: 0,0:19:05.74,0:19:07.98,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:19:07.98,0:19:12.28,Default,,0,0,0,,Қылмыстық кодекс 39-бап, 1-тармақ➡
Dialogue: 0,0:19:12.28,0:19:15.62,Default,,0,0,0,,Қабылдау қабілеті және бақылау қабілеті➡
Dialogue: 0,0:19:15.62,0:19:19.42,Default,,0,0,0,,Егер біреуі жоқ болса, адам есінен танып қалады. ➡
Dialogue: 0,0:19:20.82,0:19:25.53,Default,,0,0,0,,Шибуяда сіздің денеңізді Сукуна басып алды.
Dialogue: 0,0:19:25.53,0:19:28.03,Default,,0,0,0,,Неліктен Сукуна туралы?
Dialogue: 0,0:19:28.03,0:19:31.13,Default,,0,0,0,,Басқаша айтқанда, бақылау мүмкіндігі болмады➡
Dialogue: 0,0:19:31.13,0:19:35.20,Default,,0,0,0,,Сондай-ақ ол бақылау қабілетінен өз еркімен бас тартқан жоқ. ➡
Dialogue: 0,0:19:35.20,0:19:38.11,Default,,0,0,0,,Басқаша айтқанда, ол кінәсіз.
Dialogue: 0,0:19:40.24,0:19:42.24,Default,,0,0,0,,Сіз кінәлі емессіз.
Dialogue: 0,0:19:44.25,0:19:47.82,Default,,0,0,0,,Бірақ бәрібір менің кінәм.
Dialogue: 0,0:19:47.82,0:19:49.85,Default,,0,0,0,,Менің әлсіздігімнен.
Dialogue: 0,0:19:49.85,0:19:53.79,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:19:53.79,0:19:56.06,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:56.06,0:19:59.99,Default,,0,0,0,,Ничиша... Неге дәл қазір техниканы шештің?
Dialogue: 0,0:19:59.99,0:20:03.60,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:20:03.60,0:20:05.80,Default,,0,0,0,,Мен өзімнің негіздеріме оралдым.
Dialogue: 0,0:20:07.44,0:20:12.47,Default,,0,0,0,,Жолбарыс қамысы Сіз сияқты әлсіздігі бар адам➡
Dialogue: 0,0:20:12.47,0:20:14.68,Default,,0,0,0,,Көбірек болуы мүмкін. ➡
Dialogue: 0,0:20:16.38,0:20:19.28,Default,,0,0,0,,Киініп, отырыңыз➡
Dialogue: 0,0:20:19.28,0:20:21.32,Default,,0,0,0,,100 ұпай жинаңыз.
Dialogue: 0,0:20:21.32,0:20:34.50,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:20:34.50,0:20:36.93,Default,,0,0,0,,Жолбарыс қамысы. иә?
Dialogue: 0,0:20:36.93,0:20:40.20,Default,,0,0,0,,Сіз өз еркіңізбен біреуді өлтірдіңіз бе?
Dialogue: 0,0:20:40.20,0:20:47.78,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:20:47.78,0:20:49.81,Default,,0,0,0,,Иә.
Dialogue: 0,0:20:49.81,0:20:54.92,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:20:54.92,0:20:57.92,Default,,0,0,0,,көремін. ➡
Dialogue: 0,0:20:57.92,0:20:59.92,Default,,0,0,0,,Бұл ең жаман сезім болса керек.
Dialogue: 0,0:21:01.32,0:21:08.13,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:21:08.13,0:21:11.90,Default,,0,0,0,,♬ Қараңғы күндерде жоқ көлеңке
Dialogue: 0,0:21:11.90,0:21:14.54,Default,,0,0,0,,♬ Мен ренжідім.
Dialogue: 0,0:21:14.54,0:21:17.84,Default,,0,0,0,,♬ Кешірім сұрау сияқты.
Dialogue: 0,0:21:17.84,0:21:23.51,Default,,0,0,0,,♬ Патетикалық Егілген тұқымдар гүлдей бастайды
Dialogue: 0,0:21:23.51,0:21:27.31,Default,,0,0,0,,♬ Барған сайын суып барасың
Dialogue: 0,0:21:27.31,0:21:30.72,Default,,0,0,0,,♬ Ұзарған алақаным аспанды қиып
Dialogue: 0,0:21:30.72,0:21:33.65,Default,,0,0,0,,♬ Жағдайлар қалпына келе ме?
Dialogue: 0,0:21:33.65,0:21:37.12,Default,,0,0,0,,♬ Толқындар жұтылады
Dialogue: 0,0:21:37.12,0:21:40.29,Default,,0,0,0,,♬ Болашақты жойып, жалғастырыңыз
Dialogue: 0,0:21:40.29,0:21:45.00,Default,,0,0,0,,♬ Ақырзаман келе ме?
Dialogue: 0,0:21:45.00,0:21:49.37,Default,,0,0,0,,♬ Үзіліп, жарылып кетсем
Dialogue: 0,0:21:49.37,0:21:51.97,Default,,0,0,0,,♬ Байғұс шашылып кетсе де
Dialogue: 0,0:21:51.97,0:21:54.54,Default,,0,0,0,,♬ Мен ештеңеден қорықпаймын
Dialogue: 0,0:21:54.54,0:21:56.58,Default,,0,0,0,,♬ Өйткені қазірдің өзінде
Dialogue: 0,0:21:56.58,0:21:58.61,Default,,0,0,0,,♬ Өйткені ол әлдеқашан бос
Dialogue: 0,0:21:58.61,0:22:00.98,Default,,0,0,0,,♬ Ах, соңында
Dialogue: 0,0:22:00.98,0:22:04.25,Default,,0,0,0,,♬ Бұл шамды міндетті түрде өшіріңіз.
Dialogue: 0,0:22:04.25,0:22:07.72,Default,,0,0,0,,♬ Мен енді ештеңе қаламаймын
Dialogue: 0,0:22:07.72,0:22:10.72,Default,,0,0,0,,♬ Себебі мен оны қайтадан жоғалтып алудан қорқамын
Dialogue: 0,0:22:10.72,0:22:13.16,Default,,0,0,0,,♬ Таң атуға жақын болса да
Dialogue: 0,0:22:13.16,0:22:16.23,Default,,0,0,0,,♬ Тұман әлі сейілмейді
Dialogue: 0,0:22:16.23,0:22:19.17,Default,,0,0,0,,♬ Сол түсініксіз схема
Dialogue: 0,0:22:19.17,0:22:21.77,Default,,0,0,0,,♬ Бақылау кезінде
Dialogue: 0,0:22:21.77,0:22:25.34,Default,,0,0,0,,♬ Мен келе жатырмын
Dialogue: 0,0:22:25.34,0:22:29.64,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:22:31.78,0:22:35.05,Default,,0,0,0,,Когане Қосылған ережелер. ➡
Dialogue: 0,0:22:35.05,0:22:39.79,Default,,0,0,0,,Жүзушілер арасында ұпайларды тасымалдау мүмкіндігін жасаңыз.
Dialogue: 0,0:22:39.79,0:22:44.56,Default,,0,0,0,,Әрине, бұл 8-ші жалпы ережедегі «вариацияға» енгізілген.
Dialogue: 0,0:22:44.56,0:22:46.83,Default,,0,0,0,,Бекітілді. ➡
Dialogue: 0,0:22:46.83,0:22:49.90,Default,,0,0,0,,Жалпы ережелер 10 Жүзушілер басқа жүзушілерге➡
Dialogue: 0,0:22:49.90,0:22:53.13,Default,,0,0,0,,Кез келген ұпайларды ауыстыруға болады.
Dialogue: 0,0:22:53.13,0:22:55.57,Default,,0,0,0,,Уау. (Ничиша) Когане➡
Dialogue: 0,0:22:55.57,0:22:59.97,Default,,0,0,0,,Менің бір ұпайым жолбарыс таяғына. Мен оны түсіндім.
Dialogue: 0,0:22:59.97,0:23:02.61,Default,,0,0,0,,О. Хироми Никшадан➡
Dialogue: 0,0:23:02.61,0:23:06.08,Default,,0,0,0,,1 тармақ ауыстырылды.
Dialogue: 0,0:23:06.08,0:23:11.02,Default,,0,0,0,,Енді ешқайсысы да 19 күн бойы хирургиялық шеберлігіңнен айырылмайсың. ➡
Dialogue: 0,0:23:11.02,0:23:13.12,Default,,0,0,0,,Шебер бол.
Dialogue: 0,0:23:13.12,0:23:16.46,Default,,0,0,0,,Никша!! Енді не істейсіз?
Dialogue: 0,0:23:16.46,0:23:19.76,Default,,0,0,0,,Егер сіз онымен жақсы болсаңыз, бізге көмектесе аласыз ба?
Dialogue: 0,0:23:21.46,0:23:25.50,Default,,0,0,0,,Мен қалған екеуін Токиоға келгенше өлтірдім➡
Dialogue: 0,0:23:25.50,0:23:28.80,Default,,0,0,0,,Судьялар мен прокурорларға тиесілі. ➡
Dialogue: 0,0:23:28.80,0:23:33.21,Default,,0,0,0,,Егер бөгет ашылса, мен өзімді бұрып алуым мүмкін➡
Dialogue: 0,0:23:33.21,0:23:37.24,Default,,0,0,0,,Оған дейін не істеу керектігі туралы ойланыңыз. ➡
Dialogue: 0,0:23:37.24,0:23:41.75,Default,,0,0,0,,Оның үстіне сенімен бірге болу өзімді одан сайын жек көремін➡
Dialogue: 0,0:23:43.15,0:23:46.35,Default,,0,0,0,,Кешіріңіз. Мен сені кінәлаған жоқпын➡
Dialogue: 0,0:23:47.69,0:23:49.69,Default,,0,0,0,,Жақында кездескенше.
Dialogue: 0,0:23:58.47,0:24:01.00,Default,,0,0,0,,Ережелер жақында қосылады. Кез келген нүкте ➡
Dialogue: 0,0:24:01.00,0:24:03.40,Default,,0,0,0,,Ауыстыруға болады. Мен оны өлтіруге дайын болуым керек.
Dialogue: 0,0:24:03.40,0:24:06.07,Default,,0,0,0,,Бұл жақсы!! (Такаха) Қосымша әлем Wi-Fi! ! !
Dialogue: 0,0:24:06.07,0:24:08.68,Default,,0,0,0,,Маған барлық ұпайларыңызды беріңіз.
