Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.07,0:00:04.67,Default,,0,0,0,,Өзгелерден жоғары тұрған адам өзіне қатал.
Dialogue: 0,0:00:04.67,0:00:08.04,Default,,0,0,0,,Адамдарға мейірімді болғым келеді.
Dialogue: 0,0:00:08.04,0:00:10.24,Default,,0,0,0,,Мен өзіме қатты қиналамын, солай ма?
Dialogue: 0,0:00:10.24,0:00:13.90,Default,,0,0,0,,Толыққанды Ундина болу үшін есте сақтау маңызды нәрсе.
Dialogue: 0,0:00:13.90,0:00:14.98,Default,,0,0,0,,Айка-чан күткендей
Dialogue: 0,0:00:14.98,0:00:19.24,Default,,0,0,0,,Сондықтан менің тәтті болғанымды қалайсың.
Dialogue: 0,0:00:33.78,0:00:39.39,Default,,0,0,0,,Алғы сөз түсіріліп қалды Ай-чан, мен бүгін өте еркінмін.
Dialogue: 0,0:00:39.39,0:00:41.64,Default,,0,0,0,,Бұл таңертең болды.
Dialogue: 0,0:00:49.32,0:00:50.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:50.47,0:00:52.23,Default,,0,0,0,,Ах аа!
Dialogue: 0,0:00:55.93,0:00:56.74,Default,,0,0,0,,Эх!
Dialogue: 0,0:00:57.75,0:00:58.76,Default,,0,0,0,,Эх!
Dialogue: 0,0:01:04.26,0:01:05.30,Default,,0,0,0,,...Хахи?
Dialogue: 0,0:01:06.01,0:01:15.68,Default,,0,0,0,,Жұмсақ жел беттеріңнен сипады
Dialogue: 0,0:01:06.31,0:01:21.54,Default,,0,0,0,,ЖАПОН ТІЛІНДЕ ඞSUS SUBSඞ ТЕЗ сауығып, ДОЛЛИ ЕМЕС
Dialogue: 0,0:01:15.68,0:01:24.54,Default,,0,0,0,,Толқындардың дыбысынан тербеледі
Dialogue: 0,0:01:24.54,0:01:35.41,Default,,0,0,0,,Ол менің денемнің ішін ашады
Dialogue: 0,0:01:25.72,0:01:27.10,Default,,0,0,0,,Қайырлы таң Акари-чан
Dialogue: 0,0:01:27.10,0:01:28.88,Default,,0,0,0,,Алисия-сан Алисия-сан
Dialogue: 0,0:01:28.88,0:01:30.22,Default,,0,0,0,,Бұл қиын
Dialogue: 0,0:01:30.22,0:01:34.36,Default,,0,0,0,,Су тасқыны. Еденнің үстіндегі су тасқыны.
Dialogue: 0,0:01:34.36,0:01:35.21,Default,,0,0,0,,Иә
Dialogue: 0,0:01:35.21,0:01:38.19,Default,,0,0,0,,Иә, мен таң қалмаймын.
Dialogue: 0,0:01:35.41,0:01:45.07,Default,,0,0,0,,Көзіңізді жұмып, қараңыз
Dialogue: 0,0:01:38.19,0:01:42.04,Default,,0,0,0,,Бұл Акари-чанның бірінші рет, Aqua Alta.
Dialogue: 0,0:01:42.04,0:01:43.78,Default,,0,0,0,,...
Dialogue: 0,0:01:44.93,0:01:47.88,Default,,0,0,0,,Жыл сайын осы уақытта болатын дауылдың көтерілу құбылысы.
Dialogue: 0,0:01:45.07,0:01:53.12,Default,,0,0,0,,Жел жүретін жол
Dialogue: 0,0:01:48.59,0:01:53.22,Default,,0,0,0,,Aqua Alta кезінде қала функцияларының көпшілігі тоқтайды.
Dialogue: 0,0:01:53.12,0:02:03.19,Default,,0,0,0,,Енді жарқыраған толқындарға сап түзейік
Dialogue: 0,0:01:53.22,0:01:55.60,Default,,0,0,0,,Барлығы үйде демалады.
Dialogue: 0,0:02:03.19,0:02:12.45,Default,,0,0,0,,Күлімсіреу оңай түседі
Dialogue: 0,0:02:12.45,0:02:22.52,Default,,0,0,0,,Ей, осы толқуды жеткізейік
Dialogue: 0,0:02:22.52,0:02:31.38,Default,,0,0,0,,Саған желді айдау
Dialogue: 0,0:02:31.38,0:02:38.22,Default,,0,0,0,,Кеттік, Ундина
Dialogue: 0,0:02:47.10,0:02:49.02,Default,,0,0,0,,Бұл Aqua Alta аяқталғанда
Dialogue: 0,0:02:49.02,0:02:52.95,Default,,0,0,0,,Нео Венецияға толыққанды жаз келе жатқан сияқты.
Dialogue: 0,0:02:55.66,0:03:00.13,Default,,0,0,0,,Сол ерекше күні...
Dialogue: 0,0:03:06.78,0:03:10.35,Default,,0,0,0,,Акари-сан, сен енді ғана аң-таң болған шығарсың.
Dialogue: 0,0:03:10.35,0:03:12.60,Default,,0,0,0,,Мен ұйықтап қалдым.
Dialogue: 0,0:03:14.63,0:03:17.76,Default,,0,0,0,,Бүкіл қаланы су басып қалса, бұл үлкен мәселе сияқты.
Dialogue: 0,0:03:17.76,0:03:20.49,Default,,0,0,0,,Мен де Нео-Венецияны осылай көргім келеді.
Dialogue: 0,0:03:21.38,0:03:26.69,Default,,0,0,0,,Суда көк аспан шағылысса, қаланың бәрі көгілдір ме екен?
Dialogue: 0,0:03:27.27,0:03:32.21,Default,,0,0,0,,Мен бөлмемнен аспанды көре алмаймын, бірақ бүгін бұлтты шығар.
Dialogue: 0,0:03:32.21,0:03:37.64,Default,,0,0,0,,Бірақ Акари-санның электрондық поштасының арқасында менің жүрегімде аспан көгілдір.
Dialogue: 0,0:03:38.74,0:03:39.99,Default,,0,0,0,,Акари-чан
Dialogue: 0,0:03:39.99,0:03:40.80,Default,,0,0,0,,Иә
Dialogue: 0,0:03:41.38,0:03:44.56,Default,,0,0,0,,Ах, бұл гондолалар қауымдастығының жиналысы болды.
Dialogue: 0,0:03:44.56,0:03:47.47,Default,,0,0,0,,Иә, онда Акари-чан, көп рахмет.
Dialogue: 0,0:03:47.47,0:03:49.84,Default,,0,0,0,,Мен кешке қайтатын шығармын деп ойлаймын.
Dialogue: 0,0:03:49.84,0:03:51.87,Default,,0,0,0,,Иә, келіңіз.
Dialogue: 0,0:03:51.87,0:03:53.11,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:03:57.00,0:03:58.30,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:03:58.30,0:04:02.50,Default,,0,0,0,,Президент Арияның тамағы таусылған, сондықтан сіз оған тамақ сатып ала аласыз ба?
Dialogue: 0,0:04:02.50,0:04:04.25,Default,,0,0,0,,Тіпті саған автограф қойып, қолыңды да қысып қояйын
Dialogue: 0,0:04:04.25,0:04:05.26,Default,,0,0,0,,Жоқ, өмірден үміт үзбе
Dialogue: 0,0:04:05.26,0:04:05.94,Default,,0,0,0,,Иә
Dialogue: 0,0:04:12.33,0:04:14.75,Default,,0,0,0,,Президентке тамақ сатып алайық па?
Dialogue: 0,0:04:15.58,0:04:17.45,Default,,0,0,0,,Бүгін серуендеуге барайық.
Dialogue: 0,0:04:18.56,0:04:20.94,Default,,0,0,0,,Өйткені, бүгін Aqua Alta.
Dialogue: 0,0:04:20.94,0:04:24.26,Default,,0,0,0,,Ерекше күні әдеттегіден басқа нәрсе жасаңыз.
Dialogue: 0,0:04:24.26,0:04:26.77,Default,,0,0,0,,Сіз жаңа ашу жасай аласыз.
Dialogue: 0,0:04:26.77,0:04:28.26,Default,,0,0,0,,Енді барайық
Dialogue: 0,0:04:31.48,0:04:33.35,Default,,0,0,0,,Кеттік
Dialogue: 0,0:04:47.85,0:04:49.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:50.71,0:04:54.87,Default,,0,0,0,,Мен бұл жолдың қай жерде бітетінін білмеймін.
Dialogue: 0,0:04:56.74,0:04:59.86,Default,,0,0,0,,Мұқият мұқият
Dialogue: 0,0:04:59.96,0:05:02.90,Default,,0,0,0,,Мұқият мұқият
Dialogue: 0,0:05:02.90,0:05:05.22,Default,,0,0,0,,Зунтака Зунтака
Dialogue: 0,0:05:05.32,0:05:07.81,Default,,0,0,0,,Зунтака Зунтака
Dialogue: 0,0:05:07.81,0:05:09.19,Default,,0,0,0,,Зунта?
Dialogue: 0,0:05:12.03,0:05:12.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:15.58,0:05:17.21,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:26.43,0:05:28.21,Default,,0,0,0,,Зунтаака Зунта
Dialogue: 0,0:05:28.21,0:05:30.00,Default,,0,0,0,,Зунтаппа
Dialogue: 0,0:05:30.00,0:05:31.69,Default,,0,0,0,,Зунтаака Зунта
Dialogue: 0,0:05:31.69,0:05:33.51,Default,,0,0,0,,Зунтаппа
Dialogue: 0,0:05:33.51,0:05:35.29,Default,,0,0,0,,Зунтаака Зунта
Dialogue: 0,0:05:35.29,0:05:37.10,Default,,0,0,0,,Зунтаппер
Dialogue: 0,0:05:37.10,0:05:38.85,Default,,0,0,0,,Зунтаака Зунта
Dialogue: 0,0:05:38.85,0:05:40.92,Default,,0,0,0,,Зунтаппа!
Dialogue: 0,0:05:53.57,0:05:56.92,Default,,0,0,0,,Мүмкін бұл дұрыс емес шығар.
Dialogue: 0,0:05:56.92,0:06:00.18,Default,,0,0,0,,Бұл әдеттегіден өзгеше, сондықтан мен қателік жібердім деп ойлаймын.
Dialogue: 0,0:06:01.28,0:06:02.60,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:06:03.84,0:06:06.62,Default,,0,0,0,,О, солай.
Dialogue: 0,0:06:15.87,0:06:17.15,Default,,0,0,0,,Бұл жақсы болмады.
Dialogue: 0,0:06:23.04,0:06:25.83,Default,,0,0,0,,Ха, мен таң қалдым.
Dialogue: 0,0:06:27.28,0:06:29.58,Default,,0,0,0,,Жаңбыр көп жауады
Dialogue: 0,0:06:29.58,0:06:32.57,Default,,0,0,0,,Үйге бара аламыз ба?
Dialogue: 0,0:06:37.84,0:06:38.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:47.91,0:06:50.78,Default,,0,0,0,,Сол мысық...
Dialogue: 0,0:06:53.66,0:06:57.85,Default,,0,0,0,,Иә? Акари, не істеп жатырсың?
Dialogue: 0,0:06:57.85,0:06:59.13,Default,,0,0,0,,Айка-чан
Dialogue: 0,0:06:59.13,0:07:02.91,Default,,0,0,0,,Олай болса, бұл мысық президент Химе.
Dialogue: 0,0:07:02.91,0:07:06.29,Default,,0,0,0,,Түсінбейтін нәрселерді айтпаңыз, кіріңіз.
Dialogue: 0,0:07:07.15,0:07:09.13,Default,,0,0,0,,Aqua Alta керемет
Dialogue: 0,0:07:09.13,0:07:13.23,Default,,0,0,0,,Жолдағы өрнек әдеттегіден мүлдем басқаша болды, сондықтан мен адасып қалдым.
Dialogue: 0,0:07:13.23,0:07:16.16,Default,,0,0,0,,Әдетте бәрі үйде отырып, үндемейтін күн.
Dialogue: 0,0:07:16.16,0:07:17.28,Default,,0,0,0,,Өйткені
Dialogue: 0,0:07:17.28,0:07:19.71,Default,,0,0,0,,Айка-сан, сен Акираны білесің бе?
Dialogue: 0,0:07:19.71,0:07:22.15,Default,,0,0,0,,Мен сені таңнан бері көрмедім.
Dialogue: 0,0:07:22.15,0:07:24.56,Default,,0,0,0,,Түсіндім, кешіріңіз.
Dialogue: 0,0:07:26.98,0:07:29.46,Default,,0,0,0,,Бұл президенттің асы ма?
Dialogue: 0,0:07:29.46,0:07:30.73,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:07:30.73,0:07:32.20,Default,,0,0,0,,Мен оны аламын.
Dialogue: 0,0:07:32.20,0:07:34.10,Default,,0,0,0,,Олай болса, өтінемін.
Dialogue: 0,0:07:34.10,0:07:34.96,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:07:38.32,0:07:40.77,Default,,0,0,0,,Химея-санның жалғыз қызы күткендей
Dialogue: 0,0:07:40.77,0:07:43.80,Default,,0,0,0,,Оның абыройлы екені сонша, оның менен бір саты жоғары тұрғанына сене алар емеспін.
Dialogue: 0,0:07:43.80,0:07:45.33,Default,,0,0,0,,Мен сені бұл үшін мақтап тұрғаным жоқ.
Dialogue: 0,0:07:45.33,0:07:46.30,Default,,0,0,0,,Өтірік
Dialogue: 0,0:07:46.30,0:07:48.69,Default,,0,0,0,,Мен кемпірге ұқсаймын дейтіндей сезінемін.
Dialogue: 0,0:07:48.69,0:07:50.96,Default,,0,0,0,,Е, бұл дұрыс емес.
Dialogue: 0,0:07:50.96,0:07:56.06,Default,,0,0,0,,Сонымен қатар, әркімнің құрметті сөздерді қолдануының себебі менде қадір-қасиет бар емес.
Dialogue: 0,0:07:56.06,0:07:56.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:01.98,0:08:02.89,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:08:02.89,0:08:04.07,Default,,0,0,0,,(Кёко Хори) Иә, әлі де өзімді жақсы сезінбеймін.
Dialogue: 0,0:08:06.67,0:08:09.34,Default,,0,0,0,,Күткеніңізге рахмет, Президент Химе.
Dialogue: 0,0:08:16.79,0:08:20.86,Default,,0,0,0,,Президент Хименің көгілдір көздері қашан қарасаң да әдемі.
Dialogue: 0,0:08:20.86,0:08:22.76,Default,,0,0,0,,Иә Ескертусіз сынақ
Dialogue: 0,0:08:22.76,0:08:23.79,Default,,0,0,0,,Әкесі: Ллойд Форджер, психиатр
Dialogue: 0,0:08:23.79,0:08:25.87,Default,,0,0,0,,Неліктен Ундина компаниясында?
Dialogue: 0,0:08:25.87,0:08:29.96,Default,,0,0,0,,Олардың президенті ретінде аквамарин көздері бар мысық болуы мүмкін.
Dialogue: 0,0:08:29.96,0:08:31.96,Default,,0,0,0,,30 таңба ішінде жауап беріңіз
Dialogue: 0,0:08:31.96,0:08:33.21,Default,,0,0,0,,Е.
Dialogue: 0,0:08:33.21,0:08:38.08,Default,,0,0,0,,Аквамаринді кемелердің қауіпсіздігін қорғайтын құдай дейді.
Dialogue: 0,0:08:38.08,0:08:39.08,Default,,0,0,0,,30 таңба!
Dialogue: 0,0:08:39.08,0:08:41.22,Default,,0,0,0,,Иә, өте жақсы.
Dialogue: 0,0:08:41.22,0:08:42.07,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:08:42.07,0:08:43.47,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:43.47,0:08:45.15,Default,,0,0,0,,Сіз оқып жатырсыз, солай емес пе?
Dialogue: 0,0:08:45.93,0:08:47.83,Default,,0,0,0,,Бұл дұрыс, бірақ
Dialogue: 0,0:08:47.83,0:08:52.02,Default,,0,0,0,,Көгілдір көзді мысық қауіпсіздік символы ретінде президент болып сайланды.
Dialogue: 0,0:08:52.02,0:08:54.22,Default,,0,0,0,,Қызық, кім бірінші шешім қабылдады?
Dialogue: 0,0:08:54.22,0:08:55.65,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:08:55.65,0:08:57.51,Default,,0,0,0,,Бұл өте жақсы.
Dialogue: 0,0:08:57.51,0:08:58.96,Default,,0,0,0,,Ұятты жолдарға тыйым салынады!
Dialogue: 0,0:08:58.96,0:08:59.98,Default,,0,0,0,,Сіз Шизукудың жерлеуіне келмедіңіз бе?
Dialogue: 0,0:09:07.08,0:09:10.85,Default,,0,0,0,,Эй Айка, мен демалу үшін не істеуім керек?
Dialogue: 0,0:09:10.85,0:09:12.94,Default,,0,0,0,,Ах, Акира-сан
Dialogue: 0,0:09:12.94,0:09:17.99,Default,,0,0,0,,Аа, бүгін Aqua Alta, сондықтан мен жаттығудан үзіліс аламын деп ойлаймын.
Dialogue: 0,0:09:17.99,0:09:21.35,Default,,0,0,0,,Сендей жарымжанға тыныштық жоқ.
Dialogue: 0,0:09:21.35,0:09:23.52,Default,,0,0,0,,Бірақ осындай күні гондола...
Dialogue: 0,0:09:23.52,0:09:25.21,Default,,0,0,0,,Шарап!
Dialogue: 0,0:09:25.21,0:09:27.00,Default,,0,0,0,,Дене күшін қалыптастыру және ән айтуға жаттықтыру
Dialogue: 0,0:09:27.50,0:09:30.80,Default,,0,0,0,,Отырғызу! Үнділер!
Dialogue: 0,0:09:30.80,0:09:32.35,Default,,0,0,0,,Сіз кез келген нәрсені жасай аласыз, солай ма?
Dialogue: 0,0:09:32.35,0:09:34.24,Default,,0,0,0,,Уау, бұл қиын.
Dialogue: 0,0:09:35.21,0:09:37.56,Default,,0,0,0,,Сіздің ARIA компаниясынан екеніңізге сенімдімін...
Dialogue: 0,0:09:37.56,0:09:39.77,Default,,0,0,0,,Иә, бұл Акари Мизунаши.
Dialogue: 0,0:09:39.77,0:09:41.85,Default,,0,0,0,,Ол манзай дуэтінің серіктесі.
Dialogue: 0,0:09:41.85,0:09:43.66,Default,,0,0,0,,Манзай?
Dialogue: 0,0:09:43.66,0:09:46.45,Default,,0,0,0,,Бойдақ болсаңыз да жолаушыларды тасымалдау
Dialogue: 0,0:09:46.45,0:09:48.94,Default,,0,0,0,,Мен сізді Айкамен ерекше саяхатқа шыққаныңызды естідім.
Dialogue: 0,0:09:49.67,0:09:51.97,Default,,0,0,0,,Қалай айтсаң да...
Dialogue: 0,0:09:51.39,0:09:52.44,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:09:52.54,0:09:55.69,Default,,0,0,0,,Алисияның жігіті тым тәтті.
Dialogue: 0,0:09:55.69,0:09:56.94,Default,,0,0,0,,Онда адамдар бар. Екеуі.
Dialogue: 0,0:09:57.53,0:09:59.48,Default,,0,0,0,,Ол әрқашан солай болған.
Dialogue: 0,0:09:59.48,0:10:01.43,Default,,0,0,0,,Әрқашан қатты күлу...
Dialogue: 0,0:10:00.78,0:10:02.00,Default,,0,0,0,,Алисия туралы
Dialogue: 0,0:10:02.00,0:10:04.34,Default,,0,0,0,,Жаман сөз айтуды доғарыңыз.
Dialogue: 0,0:10:04.34,0:10:05.31,Default,,0,0,0,,Не?
Dialogue: 0,0:10:05.31,0:10:08.80,Default,,0,0,0,,Алисия-сан Акира-санға ұқсамайтын мейірімді.
Dialogue: 0,0:10:08.80,0:10:11.50,Default,,0,0,0,,Сендей бұзылған адам бұзылады.
Dialogue: 0,0:10:11.50,0:10:13.61,Default,,0,0,0,,Сіз толыққанды адам бола аламын деп ойлайсыз ба?
Dialogue: 0,0:10:13.61,0:10:17.79,Default,,0,0,0,,Алисия себебін сұрамай, сізге айқайлап қана қоймайды.
Dialogue: 0,0:10:17.79,0:10:21.54,Default,,0,0,0,,Егер сізге Алисия қатты ұнаса, ARIA компаниясына барыңыз.
Dialogue: 0,0:10:22.51,0:10:25.50,Default,,0,0,0,,Айка-чан, сабыр етіңізші.
Dialogue: 0,0:10:26.87,0:10:27.90,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:10:28.54,0:10:30.78,Default,,0,0,0,,Мен ARIA компаниясына барамын
Dialogue: 0,0:10:30.78,0:10:31.53,Default,,0,0,0,,Ах… «C» рейтингі
Dialogue: 0,0:10:32.22,0:10:33.09,Default,,0,0,0,,...Ех!
Dialogue: 0,0:10:34.42,0:10:36.88,Default,,0,0,0,,Мен Химеяға енді қайтып оралмаймын.
Dialogue: 0,0:10:39.97,0:10:40.71,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:10:45.97,0:10:50.32,Default,,0,0,0,,Айка-чан, кешірім сұра, жаттығу жасайық. Үнді скваттарын жасайық.
Dialogue: 0,0:10:50.32,0:10:53.92,Default,,0,0,0,,Не? Бұл менің кінәм емес, сонда сен неге кешірім сұрайсың?
Dialogue: 0,0:10:53.92,0:10:55.41,Default,,0,0,0,,Кеттік, Акари.
Dialogue: 0,0:10:56.04,0:10:57.28,Default,,0,0,0,,Айка-чан
Dialogue: 0,0:10:59.56,0:11:01.32,Default,,0,0,0,,Сізге де бару керек пе?
Dialogue: 0,0:11:01.32,0:11:03.72,Default,,0,0,0,,А, иә, мен барамын.
Dialogue: 0,0:11:03.72,0:11:04.93,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:15.40,0:11:18.64,Default,,0,0,0,,Ой, о, о, түнде қалғың келе ме?
Dialogue: 0,0:11:18.64,0:11:22.33,Default,,0,0,0,,Иә! Мүмкін болса ARIA компаниясына қосылыңыз.
Dialogue: 0,0:11:22.33,0:11:23.48,Default,,0,0,0,,Айка-чан
Dialogue: 0,0:11:23.48,0:11:24.98,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:11:24.98,0:11:29.09,Default,,0,0,0,,Әзірше қолыма сүйеніп, дәмді кешкі ас әзірлеймін.
Dialogue: 0,0:11:34.10,0:11:36.04,Default,,0,0,0,,Мен оны сонша дәмді етіп жасасам ше?
Dialogue: 0,0:11:36.04,0:11:38.99,Default,,0,0,0,,Мен шынымен ARIA компаниясына қосылғалы жатырмын.
Dialogue: 0,0:11:38.99,0:11:41.34,Default,,0,0,0,,Қайта алмасаң не істейсің?
Dialogue: 0,0:11:40.73,0:11:41.34,Default,,0,0,0,,Тұз
Dialogue: 0,0:11:41.34,0:11:42.25,Default,,0,0,0,,Иә
Dialogue: 0,0:11:43.18,0:11:45.52,Default,,0,0,0,,Арнайы Айка қуырылған күріш аяқталды
Dialogue: 0,0:11:45.52,0:11:47.02,Default,,0,0,0,,Ха~
Dialogue: 0,0:11:47.02,0:11:48.48,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:11:48.48,0:11:50.57,Default,,0,0,0,,Уау~ Бұл керемет.
Dialogue: 0,0:11:50.57,0:11:52.39,Default,,0,0,0,,Ал, жақсы, жақсы!
Dialogue: 0,0:11:58.11,0:11:59.56,Default,,0,0,0,,- Дәмді! - дәмді!
Dialogue: 0,0:12:01.06,0:12:04.37,Default,,0,0,0,,Айка-чан, сен тамақ әзірлеуге өте жақсысың, солай ма?
Dialogue: 0,0:12:04.37,0:12:07.18,Default,,0,0,0,,Не? Ал, онша емес...
Dialogue: 0,0:12:07.90,0:12:10.01,Default,,0,0,0,,Акари! Күріш дәндері бар
Dialogue: 0,0:12:10.01,0:12:10.89,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:12:11.68,0:12:13.67,Default,,0,0,0,,Ақира болса ғой
Dialogue: 0,0:12:13.67,0:12:16.44,Default,,0,0,0,,"Қора! Тамақты жеме! Бұл жаман мінез!"
Dialogue: 0,0:12:16.44,0:12:18.21,Default,,0,0,0,,айқайлап жатыр.
Dialogue: 0,0:12:18.21,0:12:19.19,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:12:19.19,0:12:21.11,Default,,0,0,0,,Бұл бәрі емес.
Dialogue: 0,0:12:21.11,0:12:23.58,Default,,0,0,0,,Ундина сияқты техника ғана емес.
Dialogue: 0,0:12:23.58,0:12:25.36,Default,,0,0,0,,«Асқаның ашық ұйықтама» сияқты нәрсені жасаңыз.
Dialogue: 0,0:12:25.36,0:12:27.26,Default,,0,0,0,,«Бөлмеңізде тәртіпсіздік жасамаңыз» дегенді орындаңыз.
Dialogue: 0,0:12:27.26,0:12:29.03,Default,,0,0,0,,Өте шулы
Dialogue: 0,0:12:29.03,0:12:32.13,Default,,0,0,0,,Қызғылт сары планетадағы Алисия мен Афинамен бірге
Dialogue: 0,0:12:32.13,0:12:35.24,Default,,0,0,0,,Оны үш ұлы су перісінің бірі дейді.
Dialogue: 0,0:12:35.24,0:12:37.57,Default,,0,0,0,,Менен сұрасаң, бұл жын.
Dialogue: 0,0:12:37.57,0:12:38.21,Default,,0,0,0,,Жын?
Dialogue: 0,0:12:38.21,0:12:40.53,Default,,0,0,0,,Иә, жын! Жын нұсқаушы!
Dialogue: 0,0:12:40.53,0:12:44.80,Default,,0,0,0,,Эй, сен Алисиядан мүлде басқа жансың.
Dialogue: 0,0:12:44.80,0:12:48.86,Default,,0,0,0,,Акира-чан қатал болып көрінуі мүмкін, бірақ ол өте мейірімді.
Dialogue: 0,0:12:48.86,0:12:50.21,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:12:50.21,0:12:53.21,Default,,0,0,0,,Иә, дәл Айка-чан білетіндей.
Dialogue: 0,0:12:54.54,0:12:55.30,Default,,0,0,0,,
Dialogue: 0,0:12:57.92,0:13:02.60,Default,,0,0,0,,Әй, Айканың мысық тамағы өте дәмді болды!
Dialogue: 0,0:13:13.01,0:13:17.18,Default,,0,0,0,,А, мен Алисиямен ұйықтай аламын деп ойладым.
Dialogue: 0,0:13:17.18,0:13:20.44,Default,,0,0,0,,Менің үйім басқа жерде~ Менің көңілім қалды.
Dialogue: 0,0:13:20.44,0:13:23.03,Default,,0,0,0,,Бірақ үш ірі пері десеңіз де
Dialogue: 0,0:13:23.03,0:13:25.59,Default,,0,0,0,,Мен сені бірге көрмедім.
Dialogue: 0,0:13:27.31,0:13:30.17,Default,,0,0,0,,Бұл олардың іскер бәсекелестері болғандықтан емес пе?
Dialogue: 0,0:13:30.17,0:13:31.36,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:13:31.36,0:13:35.14,Default,,0,0,0,,Шынымды айтсам, Акира-сан Алисия-санды қарсылас ретінде көреді.
Dialogue: 0,0:13:35.14,0:13:35.86,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:13:35.86,0:13:39.19,Default,,0,0,0,,Иә, бірақ мен Алисияны жақсы көремін.
Dialogue: 0,0:13:39.19,0:13:40.53,Default,,0,0,0,,Сіз қызғанасыз ба?
Dialogue: 0,0:13:40.53,0:13:43.84,Default,,0,0,0,,Айка Алисияны шынымен жақсы көреді.
Dialogue: 0,0:13:46.80,0:13:49.73,Default,,0,0,0,,Менің ойымша, бұл шамамен төрт жыл бұрын болды.
Dialogue: 0,0:13:49.73,0:13:54.66,Default,,0,0,0,,Себебін ұмытамын, бірақ мен қатты күйзелдім.
Dialogue: 0,0:13:54.66,0:13:57.25,Default,,0,0,0,,Үйден бүгінгідей қашып кеттім.
Dialogue: 0,0:13:57.25,0:13:58.83,Default,,0,0,0,,Менің баратын жерім жоқ
Dialogue: 0,0:14:01.25,0:14:01.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:11.58,0:14:12.64,Default,,0,0,0,,Сәлем
Dialogue: 0,0:14:20.96,0:14:21.61,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:30.59,0:14:32.31,Default,,0,0,0,,Сіз суланып қалдыңыз.
Dialogue: 0,0:14:32.31,0:14:33.89,Default,,0,0,0,,Құрғағанша мінгің келе ме?
Dialogue: 0,0:14:47.04,0:14:47.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:47.87,0:14:49.39,Default,,0,0,0,,Қозғалмай отырыңыз.
Dialogue: 0,0:14:49.39,0:14:50.13,Default,,0,0,0,,Иә
Dialogue: 0,0:14:56.92,0:15:00.08,Default,,0,0,0,,Ол кезде Алисия әлі бойдақ еді.
Dialogue: 0,0:15:00.77,0:15:04.42,Default,,0,0,0,,Көңіл-күйім түскенде айтпай, мені гондолаға апардың.
Dialogue: 0,0:15:05.21,0:15:08.20,Default,,0,0,0,,Күн батқанша қасымда болдың.
Dialogue: 0,0:15:09.72,0:15:11.08,Default,,0,0,0,,Иә, дайын!
Dialogue: 0,0:15:16.63,0:15:18.43,Default,,0,0,0,,Сіз қалай ойлайсыз? Қалайсың?
Dialogue: 0,0:15:19.88,0:15:24.28,Default,,0,0,0,,Қыздар шаш үлгісін өзгертсе, тіпті жүру тәсілі де өзгереді.
Dialogue: 0,0:15:27.42,0:15:29.94,Default,,0,0,0,,Ал, енді үйге қайтайық.
Dialogue: 0,0:15:29.94,0:15:30.80,Default,,0,0,0,,Иә
Dialogue: 0,0:15:33.74,0:15:36.87,Default,,0,0,0,,Эй, бұл болды.
Dialogue: 0,0:15:36.87,0:15:39.67,Default,,0,0,0,,Менің ойымша, Алисия есінде жоқ.
Dialogue: 0,0:15:39.67,0:15:42.17,Default,,0,0,0,,Бірақ бұл триггер, солай ма?
Dialogue: 0,0:15:42.17,0:15:44.68,Default,,0,0,0,,Мен Ундина боламын деп шештім.
Dialogue: 0,0:15:45.40,0:15:48.71,Default,,0,0,0,,Мен бір күні сол керемет адам болғым келеді.
Dialogue: 0,0:15:48.71,0:15:52.62,Default,,0,0,0,,Сол себепті Алисия мен үшін ерекше.
Dialogue: 0,0:15:52.62,0:15:54.04,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:54.04,0:15:56.59,Default,,0,0,0,,Химеяның баласы болмасам ғой~
Dialogue: 0,0:15:56.59,0:15:59.55,Default,,0,0,0,,Сонда мен міндетті түрде ARIA компаниясына қосылатын едім.
Dialogue: 0,0:15:59.55,0:16:01.25,Default,,0,0,0,,орнына Акари!
Dialogue: 0,0:16:01.78,0:16:02.91,Default,,0,0,0,,Бұл әзіл емес пе?
Dialogue: 0,0:16:02.91,0:16:03.54,Default,,0,0,0,,Ә... ә... білесің бе...
Dialogue: 0,0:16:03.54,0:16:05.07,Default,,0,0,0,,Сіз Шизукудың жерлеуіне келмедіңіз бе?
Dialogue: 0,0:16:17.00,0:16:18.58,Default,,0,0,0,,Айка-чанға келгенде
Dialogue: 0,0:16:27.41,0:16:28.97,Default,,0,0,0,,Таномо!
Dialogue: 0,0:16:29.60,0:16:30.56,Default,,0,0,0,,Хигья!
Dialogue: 0,0:16:30.56,0:16:33.25,Default,,0,0,0,,Ta~no~mo~!
Dialogue: 0,0:16:33.25,0:16:34.32,Default,,0,0,0,,Уақыты келді…
Dialogue: 0,0:16:35.88,0:16:37.74,Default,,0,0,0,,Гяааааай!
Dialogue: 0,0:16:41.87,0:16:43.96,Default,,0,0,0,,Мен 10-ға дейін санап жатқанда, төмен түс!
Dialogue: 0,0:16:43.96,0:16:46.77,Default,,0,0,0,,Әйтпесе, мен сені Нео-Адриатикалық теңізге батырамын!
Dialogue: 0,0:16:47.28,0:16:48.15,Default,,0,0,0,,Айтпақшы, мен әлдеқайда жақсардым, бірақ соңғы кезде
Dialogue: 0,0:16:48.80,0:16:49.56,Default,,0,0,0,,Екі!
Dialogue: 0,0:16:50.35,0:16:51.24,Default,,0,0,0,,Үш!
Dialogue: 0,0:16:50.48,0:16:51.77,Default,,0,0,0,,Кешіріңіз, Президент Ария!
Dialogue: 0,0:16:51.77,0:16:52.80,Default,,0,0,0,,4!
Dialogue: 0,0:16:52.80,0:16:54.19,Default,,0,0,0,,О, бұл әдеттен тыс.
Dialogue: 0,0:16:54.19,0:16:55.69,Default,,0,0,0,,Көптен бері көрмегелі, Акира-чан
Dialogue: 0,0:16:55.69,0:16:58.59,Default,,0,0,0,,Алисия? неге мұндасың?
Dialogue: 0,0:16:59.32,0:17:01.06,Default,,0,0,0,,Бұл ARIA компаниясы.
Dialogue: 0,0:17:01.06,0:17:02.16,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:17:02.16,0:17:03.53,Default,,0,0,0,,Айка, мен үйге бара жатырмын.
Dialogue: 0,0:17:03.53,0:17:05.48,Default,,0,0,0,,Егер сіз осындай жерде болсаңыз, сізде «О, жоқ» деген сезім пайда болады.
Dialogue: 0,0:17:05.48,0:17:06.69,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:17:06.69,0:17:09.47,Default,,0,0,0,,Маған айтар сөзің болса, тыңдайын.
Dialogue: 0,0:17:09.47,0:17:10.85,Default,,0,0,0,,Сізге не ұнамайды?
Dialogue: 0,0:17:10.85,0:17:13.12,Default,,0,0,0,,Міне, осындай менмендік.
Dialogue: 0,0:17:13.12,0:17:15.74,Default,,0,0,0,,Осындай мейірімді және жақсы қарт адамдар бар ма?
Dialogue: 0,0:17:15.74,0:17:16.78,Default,,0,0,0,,Бұл ақылсыз
Dialogue: 0,0:17:16.78,0:17:18.32,Default,,0,0,0,,Алисия немесе Алисия
Dialogue: 0,0:17:17.84,0:17:19.86,Default,,0,0,0,,О, тәңірім
Dialogue: 0,0:17:18.32,0:17:19.86,Default,,0,0,0,,Алисия-сан, Алисия-сан, Али...
Dialogue: 0,0:17:19.86,0:17:21.42,Default,,0,0,0,,Ой! ауызыңды жап!
Dialogue: 0,0:17:21.42,0:17:22.67,Default,,0,0,0,,О, тәңірім
Dialogue: 0,0:17:22.67,0:17:24.16,Default,,0,0,0,,«О, менің!» деуге болады.
Dialogue: 0,0:17:24.16,0:17:25.22,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:25.22,0:17:28.63,Default,,0,0,0,,Сіз жақсы адам сияқты әрекет етесіз және басқа жерлерден келген қызметкерлерге сізбен бірге ұйықтауға рұқсат бересіз.
Dialogue: 0,0:17:28.63,0:17:29.78,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:17:29.78,0:17:32.84,Default,,0,0,0,,Міне, атақты шайтанның күлкісімен.
Dialogue: 0,0:17:32.84,0:17:35.72,Default,,0,0,0,,Ол әрқашан өзімен бірге барлық дәмді тағамды алып келеді.
Dialogue: 0,0:17:35.72,0:17:37.14,Default,,0,0,0,,Көптен бері солай.
Dialogue: 0,0:17:37.14,0:17:39.13,Default,,0,0,0,,Мен де істеймін! Мен де жасаймын!
Dialogue: 0,0:17:37.61,0:17:41.85,Default,,0,0,0,,Мен бала күнгі досыма Ундин болатынымды айтсам, ол маған еліктейтін.
Dialogue: 0,0:17:39.13,0:17:42.45,Default,,0,0,0,,Мен де істеймін! Мен де жасаймын! Мен де жасаймын!
Dialogue: 0,0:17:42.45,0:17:45.52,Default,,0,0,0,,Біз бірге прима болуға ант бердік.
Dialogue: 0,0:17:45.52,0:17:48.08,Default,,0,0,0,,Тек мен бірінші болып Примаға көтерілемін!
Dialogue: 0,0:17:48.08,0:17:49.64,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:17:49.64,0:17:50.80,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:17:50.80,0:17:53.62,Default,,0,0,0,,Менің айтайын дегенім, оның терісі маған қарағанда ақшылырақ.
Dialogue: 0,0:17:53.62,0:17:56.52,Default,,0,0,0,,Менен артық жесең де семірмейсің бе?
Dialogue: 0,0:17:55.10,0:17:56.79,Default,,0,0,0,,О, тәңірім
Dialogue: 0,0:17:57.76,0:17:59.00,Default,,0,0,0,,«О, жоқ» тыйым салынады!
Dialogue: 0,0:17:59.00,0:17:59.69,Default,,0,0,0,,Кира өзімен-өзі айналысып жүр ғой?
Dialogue: 0,0:17:59.69,0:18:00.91,Default,,0,0,0,,«Уфуфу» да тыйым салынған!
Dialogue: 0,0:18:00.91,0:18:02.05,Default,,0,0,0,,Әй, хехехе
Dialogue: 0,0:18:02.05,0:18:03.52,Default,,0,0,0,,Екеуі де тыйым салынған!
Dialogue: 0,0:18:03.52,0:18:06.07,Default,,0,0,0,,Әй, хехехе
Dialogue: 0,0:18:04.79,0:18:06.07,Default,,0,0,0,,Тыйым салынған! Тыйым салынған!
Dialogue: 0,0:18:06.07,0:18:07.10,Default,,0,0,0,,Әй, хехехе
Dialogue: 0,0:18:07.10,0:18:08.61,Default,,0,0,0,,Тыйым салынған! Тыйым салынған!
Dialogue: 0,0:18:07.77,0:18:09.74,Default,,0,0,0,,Уфуфу О, құдағи Уфуфу
Dialogue: 0,0:18:09.39,0:18:10.62,Default,,0,0,0,,Тыйым салынған!
Dialogue: 0,0:18:09.74,0:18:10.72,Default,,0,0,0,,Әй, хехехе
Dialogue: 0,0:18:10.72,0:18:11.72,Default,,0,0,0,,Тыйым салынған!
Dialogue: 0,0:18:11.03,0:18:12.68,Default,,0,0,0,,Әй, хехехе
Dialogue: 0,0:18:11.82,0:18:12.68,Default,,0,0,0,,Тыйым салынған!
Dialogue: 0,0:18:12.68,0:18:14.49,Default,,0,0,0,,Бала кездегі досым дедіңіз бе?
Dialogue: 0,0:18:12.88,0:18:14.49,Default,,0,0,0,,Тыйым салынған! Тыйым салынған!
Dialogue: 0,0:18:14.49,0:18:15.70,Default,,0,0,0,,айтты
Dialogue: 0,0:18:15.70,0:18:17.24,Default,,0,0,0,,Ендеше мұны істейік.
Dialogue: 0,0:18:18.28,0:18:20.35,Default,,0,0,0,,Балалар, қазір жарысты бастаңдар.
Dialogue: 0,0:18:20.35,0:18:21.42,Default,,0,0,0,,- Жарыс? - Жарыс?
Dialogue: 0,0:18:21.42,0:18:25.61,Default,,0,0,0,,Дұрыс, егер Айка жеңіліп қалса, мен оны тез үйге апарамын.
Dialogue: 0,0:18:25.61,0:18:28.59,Default,,0,0,0,,Бірақ егер сіз жеңсеңіз, өзіңізге ұнайтын нәрсені жасаңыз.
Dialogue: 0,0:18:28.59,0:18:31.60,Default,,0,0,0,,Ал, неге олай?
Dialogue: 0,0:18:31.60,0:18:33.08,Default,,0,0,0,,Сенің әрекетің тым балалық… немесе жай ғана қысқа көзді.
Dialogue: 0,0:18:32.34,0:18:34.74,Default,,0,0,0,,Уау, сен қайдан білесің?
Dialogue: 0,0:18:34.74,0:18:35.34,Default,,0,0,0,,Дайын!
Dialogue: 0,0:18:35.34,0:18:36.07,Default,,0,0,0,,оларды пайдаланбас бұрын бір-біріңмен мұқият кеңесіңдер.
Dialogue: 0,0:18:36.07,0:18:37.00,Default,,0,0,0,,Жақсы бастама
Dialogue: 0,0:18:36.80,0:18:37.20,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:42.79,0:18:44.61,Default,,0,0,0,,Айка-чан не істейді?
Dialogue: 0,0:18:44.61,0:18:46.96,Default,,0,0,0,,Сіз Химеядан шығуды шындап жоспарлап жатырсыз ба?
Dialogue: 0,0:18:46.96,0:18:49.51,Default,,0,0,0,,Сәлем? (Айка-чан...)
Dialogue: 0,0:18:50.86,0:18:52.34,Default,,0,0,0,,Не болады екен деп ойлаймын.
Dialogue: 0,0:18:52.34,0:18:54.27,Default,,0,0,0,,Сіз білесіз бе? Айкаға байланысты.
Dialogue: 0,0:18:54.27,0:18:56.18,Default,,0,0,0,,Әй, хехехе
Dialogue: 0,0:18:56.18,0:18:58.01,Default,,0,0,0,,Мен сізге тыйым салынғанын айттым.
Dialogue: 0,0:18:58.87,0:19:00.28,Default,,0,0,0,,Шай ішкіңіз келе ме?
Dialogue: 0,0:19:00.28,0:19:01.01,Default,,0,0,0,,Сусын
Dialogue: 0,0:19:01.01,0:19:01.67,Default,,0,0,0,,Иә
Dialogue: 0,0:19:07.09,0:19:10.05,Default,,0,0,0,,Мен артқа қарай жүгірсем де жеңуім керек пе?
Dialogue: 0,0:19:11.77,0:19:12.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:16.06,0:19:18.43,Default,,0,0,0,,Е, Айка-чан, күте тұр!
Dialogue: 0,0:19:19.61,0:19:21.57,Default,,0,0,0,,Менің артымнан жүр ~ Акари
Dialogue: 0,0:19:22.14,0:19:25.48,Default,,0,0,0,,Жақсы, бірақ қайда бара жатырсың?
Dialogue: 0,0:19:25.48,0:19:26.39,Default,,0,0,0,,Тотото
Dialogue: 0,0:19:27.24,0:19:31.61,Default,,0,0,0,,Мм, Айка-чан, ол енді бұл жолмен өте алмайтын сияқты.
Dialogue: 0,0:19:31.61,0:19:32.70,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:19:39.35,0:19:40.44,Default,,0,0,0,,Жаңғақ нан?
Dialogue: 0,0:19:40.44,0:19:44.11,Default,,0,0,0,,Иә, мұндағы жаңғақ нан - Акираның сүйіктісі.
Dialogue: 0,0:19:44.11,0:19:45.80,Default,,0,0,0,,Олай болса, жарысқа келетін болсақ...
Dialogue: 0,0:19:45.80,0:19:47.30,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:19:47.30,0:19:51.95,Default,,0,0,0,,Акира-сан, сен маған жаңа ғана абай бол, жарыс деп айттың.
Dialogue: 0,0:19:51.95,0:19:53.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:53.03,0:19:55.71,Default,,0,0,0,,Айналма жолмен жүріп, жайбарақат қайтайық.
Dialogue: 0,0:19:56.82,0:20:00.00,Default,,0,0,0,,Мен Химеяның мұрагерімін.
Dialogue: 0,0:20:00.00,0:20:04.37,Default,,0,0,0,,Менің айналамдағы барлық қызметкерлер мен туралы айтудан аулақ.
Dialogue: 0,0:20:04.37,0:20:06.37,Default,,0,0,0,,Акира-сан мені кездейсоқ деп атайтын жалғыз адам.
Dialogue: 0,0:20:07.80,0:20:12.46,Default,,0,0,0,,Маған тура соққан жалғыз ол.
Dialogue: 0,0:20:12.46,0:20:15.62,Default,,0,0,0,,Түсініп тұрмын, сіз мұны айтып тұрсыз ба?
Dialogue: 0,0:20:43.97,0:20:47.37,Default,,0,0,0,,Бұл жер сондай әдемі алаң болатын.
Dialogue: 0,0:20:47.37,0:20:50.27,Default,,0,0,0,,Акира-сан Aqua Alta-ға ұқсайды
Dialogue: 0,0:20:51.16,0:20:54.87,Default,,0,0,0,,Айка-чанның жүрегін толқынға толтыру
Dialogue: 0,0:20:55.40,0:20:58.43,Default,,0,0,0,,Әдеттегіден басқа бетті табады
Dialogue: 0,0:20:58.43,0:21:00.67,Default,,0,0,0,,Ұятты жолдарға тыйым салынады!
Dialogue: 0,0:21:00.67,0:21:03.98,Default,,0,0,0,,«Тыйым салынған! Дәл Акира-сан сияқты.
Dialogue: 0,0:21:03.98,0:21:05.22,Default,,0,0,0,,(Барлығы төрт адам) Һмм? (JoJo) Дерби?
Dialogue: 0,0:21:06.59,0:21:09.83,Default,,0,0,0,,Шәкірт ұстазына ұқсайды дейді, бірақ бұл рас.
Dialogue: 0,0:21:09.83,0:21:14.61,Default,,0,0,0,,Мен сияқты Айка дөрекі де, бұралаң да емес.
Dialogue: 0,0:21:14.61,0:21:20.19,Default,,0,0,0,,Дұрыс, сондықтан үйге бару керек деп ойласам, әдейі ұтылып қаламын. Шынымды айтсам.
Dialogue: 0,0:21:20.19,0:21:21.70,Default,,0,0,0,,Бұл шынымен де…
Dialogue: 0,0:21:21.70,0:21:25.50,Default,,0,0,0,,Ол сізді таң қалдырады, сондықтан ол қатты тырысуы мүмкін.
Dialogue: 0,0:21:26.44,0:21:29.60,Default,,0,0,0,,Егер бұл орын алса, мен компанияға хабарласуды ойлаймын.
Dialogue: 0,0:21:30.41,0:21:32.63,Default,,0,0,0,,Ол жақсы бала.
Dialogue: 0,0:21:32.63,0:21:34.64,Default,,0,0,0,,Қыңыр, қыңыр болса да
Dialogue: 0,0:21:34.64,0:21:37.19,Default,,0,0,0,,Тура, еңбекқор, мейірімді
Dialogue: 0,0:21:37.77,0:21:40.76,Default,,0,0,0,,Өйткені, Айка-чан дәл Акира-чанға ұқсайды.
Dialogue: 0,0:21:40.76,0:21:42.05,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:42.05,0:21:45.10,Default,,0,0,0,,Мен өзім туралы мұндай нәрсені жек көремін!
Dialogue: 0,0:21:50.31,0:21:55.30,Default,,0,0,0,,Ендеше, екеуің бірге қайтып келіп демалып қайттыңдар?
Dialogue: 0,0:21:55.30,0:21:57.27,Default,,0,0,0,,Егер бұл жарыс болса, мен тастар едім.
Dialogue: 0,0:21:57.27,0:21:58.22,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:58.22,0:22:00.72,Default,,0,0,0,,Бұл! Бұл кешірім сұраудың белгісі!
Dialogue: 0,0:22:08.23,0:22:09.60,Default,,0,0,0,,Қауіпсіз!
Dialogue: 0,0:22:09.60,0:22:10.81,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:22:14.57,0:22:16.96,Default,,0,0,0,,Үйге келген соң бірден жаттығу жасаймын.
Dialogue: 0,0:22:16.96,0:22:19.06,Default,,0,0,0,,Бұл шын мәнінде жеңуге болатын жарыс болды.
Dialogue: 0,0:22:19.06,0:22:20.30,Default,,0,0,0,,Ақтау жоқ
Dialogue: 0,0:22:20.30,0:22:21.96,Default,,0,0,0,,О, менің...
Dialogue: 0,0:22:21.24,0:22:22.61,Default,,0,0,0,,Жоқ «о, жоқ»!
Dialogue: 0,0:22:24.07,0:22:27.26,Default,,0,0,0,,Кәдімгі көрініс әдеттегіден басқаша көрінгенде
Dialogue: 0,0:22:27.26,0:22:31.56,Default,,0,0,0,,Мен әдетте көре алмайтын маңызды нәрсені көре бастағандай сезінемін.
Dialogue: 0,0:22:32.33,0:22:37.44,Default,,0,0,0,,Мен де бір күні Алисия сияқты болғанымды қалаймын.
Dialogue: 0,0:22:45.50,0:22:50.56,Default,,0,0,0,,Оны алақанға жайлап қойыңыз
Dialogue: 0,0:22:50.56,0:22:56.67,Default,,0,0,0,,Мейіріміңді ақырын жылыт
Dialogue: 0,0:22:56.67,0:23:01.73,Default,,0,0,0,,Құпия әуенді ызылдадым
Dialogue: 0,0:23:01.73,0:23:08.70,Default,,0,0,0,,Баратын жерім жоқ болса да ән айт
Dialogue: 0,0:23:08.70,0:23:12.89,Default,,0,0,0,,Бірақ жаңбыр жауа бастады
Dialogue: 0,0:23:12.89,0:23:20.22,Default,,0,0,0,,Маған бәрібір, мен әрқашан жаныңда боламын
Dialogue: 0,0:23:20.22,0:23:28.07,Default,,0,0,0,,Көптеген кемпірқосақтарды кесіп өтуге болады
Dialogue: 0,0:23:28.07,0:23:31.38,Default,,0,0,0,,Бірге кемпірқосақ үстінде
Dialogue: 0,0:23:31.38,0:23:39.23,Default,,0,0,0,,Жұлдызға шағын жарық тілек
Dialogue: 0,0:23:39.23,0:23:47.95,Default,,0,0,0,,Орындалсын, Көк құс екеніне сенімдімін
Dialogue: 0,0:23:47.95,0:23:53.54,Default,,0,0,0,,Жүрегіңдегі бар махаббатты жина, Кемпірқосақ болары сөзсіз
Dialogue: 0,0:23:53.54,0:24:01.04,Default,,0,0,0,,Жүрегімде мәңгі махаббат болады, Кемпірқосақ боларына сенімдімін
Dialogue: 0,0:24:07.97,0:24:09.50,Default,,0,0,0,,Айка-чан, ол қыз кім?
Dialogue: 0,0:24:09.50,0:24:12.02,Default,,0,0,0,,Сіз білмейсіз бе? ...Мен де білмеймін...
Dialogue: 0,0:24:12.02,0:24:13.69,Default,,0,0,0,,Сенің атың кім?
Dialogue: 0,0:24:13.69,0:24:15.38,Default,,0,0,0,,Бұл үлкен және шулы.
Dialogue: 0,0:24:15.38,0:24:18.15,Default,,0,0,0,,Келесі жолы «Сол мөлдір қызбен...»
Dialogue: 0,0:24:18.15,0:24:20.61,Default,,0,0,0,,Бірге тамаша уақыт өткізейік
Dialogue: 0,0:24:22.11,0:24:28.11,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory