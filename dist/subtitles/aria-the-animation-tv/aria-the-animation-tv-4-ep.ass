Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.15,0:00:03.58,Default,,0,0,0,,Алыста болсаңыз да, тікелей кездесе алмасаңыз да
Dialogue: 0,0:00:03.58,0:00:05.99,Default,,0,0,0,,Сіз өз сезіміңізді жеткізе аласыз
Dialogue: 0,0:00:05.99,0:00:09.02,Default,,0,0,0,,Бұл пошташылар мен силфтердің жұмысы.
Dialogue: 0,0:00:09.02,0:00:10.59,Default,,0,0,0,,Бұл керемет, солай емес пе?
Dialogue: 0,0:00:10.59,0:00:13.33,Default,,0,0,0,,Бәлкім, біз Undines жасай аламыз.
Dialogue: 0,0:00:13.33,0:00:15.33,Default,,0,0,0,,Иә, мүмкін мұны істеуге болады.
Dialogue: 0,0:00:15.33,0:00:17.20,Default,,0,0,0,,Бұл жай ғана сезім болса, ауыр емес.
Dialogue: 0,0:00:17.20,0:00:20.03,Default,,0,0,0,,Жай ғана үлкен сезім
Dialogue: 0,0:00:26.14,0:00:29.48,Default,,0,0,0,,Көрдіңіз бе? Бұл бойдақтардың күші
Dialogue: 0,0:00:29.48,0:00:32.01,Default,,0,0,0,,Өзіңіз бен жұптарыңыздың айырмашылығын білу жақсы.
Dialogue: 0,0:00:33.31,0:00:36.12,Default,,0,0,0,,Бұл әдемі күн бату, Алиса.
Dialogue: 0,0:00:36.12,0:00:38.79,Default,,0,0,0,,Иә, ертең де ауа райы жақсы болады.
Dialogue: 0,0:00:38.79,0:00:40.59,Default,,0,0,0,,Мен сенімдімін.
Dialogue: 0,0:00:40.59,0:00:43.96,Default,,0,0,0,,Мен печенье пісірдім, шай ішкің келе ме?
Dialogue: 0,0:00:43.96,0:00:44.99,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:44.99,0:00:46.36,Default,,0,0,0,,Бір минут күтіңіз!
Dialogue: 0,0:00:47.73,0:00:50.90,Default,,0,0,0,,Балалар бір-бірлеріңе қашан үйрендіңдер?
Dialogue: 0,0:00:52.87,0:00:55.80,Default,,0,0,0,,Айка-чан суретке ұқсайды
Dialogue: 0,0:00:55.80,0:00:57.67,Default,,0,0,0,,Бұл үлкен және керемет.
Dialogue: 0,0:00:57.67,0:01:00.61,Default,,0,0,0,,Аа, сен нені алдайсың?
Dialogue: 0,0:01:02.88,0:01:03.94,Default,,0,0,0,,Не?!
Dialogue: 0,0:01:03.94,0:01:05.28,Default,,0,0,0,,Ахх!
Dialogue: 0,0:01:06.41,0:01:09.52,Default,,0,0,0,,Вуди мырза, сіз бүгін жұмысты аяқтадыңыз ба?
Dialogue: 0,0:01:09.52,0:01:12.35,Default,,0,0,0,,Дұрыс! Бұл жай серуендеу!
Dialogue: 0,0:01:12.35,0:01:14.19,Default,,0,0,0,,Қош бол!
Dialogue: 0,0:01:14.19,0:01:15.22,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,0:01:15.86,0:01:18.30,Default,,0,0,0,,Ай-чан, Нео Венецияда
Dialogue: 0,0:01:18.30,0:01:21.33,Default,,0,0,0,,Су перілері мен отты қорғаушылардан басқа
Dialogue: 0,0:01:21.33,0:01:25.30,Default,,0,0,0,,Сильф деп аталатын жел хабаршысы бар.
Dialogue: 0,0:01:25.70,0:01:28.80,Default,,0,0,0,,Біреудің асыл сезімін жеткізу
Dialogue: 0,0:01:28.80,0:01:30.84,Default,,0,0,0,,Жақсы жұмыс.
Dialogue: 0,0:01:31.87,0:01:35.30,Default,,0,0,0,,Мейірім мен толқыған жүрек болатынына сенімдімін
Dialogue: 0,0:01:35.30,0:01:37.91,Default,,0,0,0,,Біз оны бірге жеткіземіз, солай ма?
Dialogue: 0,0:01:37.91,0:01:39.75,Default,,0,0,0,,Ұятты жолдарға тыйым салынады!
Dialogue: 0,0:01:39.75,0:01:40.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:40.76,0:02:00.55,Default,,0,0,0,,ඞSUS SUBSඞ ЖАПОН ТІЛІНДЕ ҰСЫНҒАН https://discord.gg/bkF4ANUd9R
Dialogue: 0,0:01:40.76,0:01:50.44,Default,,0,0,0,,Жұмсақ жел бетімді сипады
Dialogue: 0,0:01:50.44,0:01:59.30,Default,,0,0,0,,Толқындардың дыбысынан тербеледі
Dialogue: 0,0:01:59.30,0:02:10.17,Default,,0,0,0,,Ол менің денемнің ішін ашады
Dialogue: 0,0:02:10.17,0:02:19.84,Default,,0,0,0,,Көзіңізді жұмып, қараңыз
Dialogue: 0,0:02:17.65,0:02:19.02,Default,,0,0,0,,Акари-чан?
Dialogue: 0,0:02:19.02,0:02:19.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:19.84,0:02:27.89,Default,,0,0,0,,Жел жүретін жол
Dialogue: 0,0:02:19.89,0:02:22.09,Default,,0,0,0,,Кешкі асқа макарон жеуге бола ма?
Dialogue: 0,0:02:22.09,0:02:22.69,Default,,0,0,0,,Иә
Dialogue: 0,0:02:22.69,0:02:26.93,Default,,0,0,0,,Орындап болған соң, мен сені наубайханаға апара аламын ба?
Dialogue: 0,0:02:26.93,0:02:29.00,Default,,0,0,0,,Менде ертеңге ештеңе жоқ сияқты.
Dialogue: 0,0:02:27.89,0:02:37.96,Default,,0,0,0,,Жүр, жарқыраған толқындарға сап түзейік
Dialogue: 0,0:02:29.00,0:02:30.26,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:33.57,0:02:36.57,Default,,0,0,0,,Әй, президент Ария да бара ма?
Dialogue: 0,0:02:37.96,0:02:47.22,Default,,0,0,0,,Күлімсіреу оңай түседі
Dialogue: 0,0:02:37.97,0:02:40.54,Default,,0,0,0,,Олай болса, бірге барамыз ба, президент Ария?
Dialogue: 0,0:02:47.22,0:02:57.28,Default,,0,0,0,,Ей, осы толқуды жеткізейік
Dialogue: 0,0:02:57.28,0:03:06.14,Default,,0,0,0,,Саған желде
Dialogue: 0,0:03:06.14,0:03:12.99,Default,,0,0,0,,Кеттік, Ундина.
Dialogue: 0,0:03:32.39,0:03:36.53,Default,,0,0,0,,Бұл үйге тезірек барғыңыз келетін көрініс.
Dialogue: 0,0:03:44.30,0:03:45.44,Default,,0,0,0,,Президент Ария!
Dialogue: 0,0:03:51.78,0:03:53.28,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:04:03.62,0:04:06.29,Default,,0,0,0,,Қайда бара жатырсың? Президент Ария?
Dialogue: 0,0:04:24.14,0:04:26.71,Default,,0,0,0,,Күте тұрыңыз, Президент Ария.
Dialogue: 0,0:05:14.99,0:05:16.53,Default,,0,0,0,,Мен тастап кеткен құралдар—
Dialogue: 0,0:05:19.07,0:05:19.80,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:05:19.80,0:05:20.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:26.51,0:05:27.94,Default,,0,0,0,,Хат?
Dialogue: 0,0:05:27.94,0:05:29.21,Default,,0,0,0,,Жеткізу
Dialogue: 0,0:05:29.21,0:05:31.41,Default,,0,0,0,,Не? мен?
Dialogue: 0,0:05:31.85,0:05:32.68,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:05:34.28,0:05:35.15,Default,,0,0,0,,Ум...
Dialogue: 0,0:05:35.15,0:05:37.12,Default,,0,0,0,,Міндетті түрде жеткізіңіз.
Dialogue: 0,0:06:15.32,0:06:18.09,Default,,0,0,0,,Иә, олай емес.
Dialogue: 0,0:06:18.09,0:06:20.96,Default,,0,0,0,,Бұл мекенжай қате ме?
Dialogue: 0,0:06:22.46,0:06:24.70,Default,,0,0,0,,Тіпті аты да соқпайды.
Dialogue: 0,0:06:25.93,0:06:28.43,Default,,0,0,0,,Жіберуші сол бала, солай ма?
Dialogue: 0,0:06:28.43,0:06:30.84,Default,,0,0,0,,Менің атым мен мекенжайым бұлыңғыр, мен оларды оқи алмаймын.
Dialogue: 0,0:06:37.01,0:06:39.58,Default,,0,0,0,,Мен ертең пошташыдан сұраймын.
Dialogue: 0,0:06:49.79,0:06:52.83,Default,,0,0,0,,Хо, ішіндегісі деректер картасы.
Dialogue: 0,0:06:53.59,0:06:56.70,Default,,0,0,0,,Бірақ бұл әбден ескірген.
Dialogue: 0,0:06:56.70,0:07:00.30,Default,,0,0,0,,Осы типтегі карталарды оқу құралдары қалды ма?
Dialogue: 0,0:07:00.30,0:07:02.87,Default,,0,0,0,,Бұл ескі ме?
Dialogue: 0,0:07:02.87,0:07:03.84,Default,,0,0,0,,О
Dialogue: 0,0:07:03.84,0:07:06.21,Default,,0,0,0,,Байланыс нысандары салынғанға дейін
Dialogue: 0,0:07:06.21,0:07:09.88,Default,,0,0,0,,Бұл алыс қашықтыққа байланысудың жалғыз жолы.
Dialogue: 0,0:07:09.88,0:07:11.11,Default,,0,0,0,,Иә~
Dialogue: 0,0:07:11.11,0:07:15.28,Default,,0,0,0,,Нео Венецияда біз сияқты бірнеше пошташы ғана қалды.
Dialogue: 0,0:07:15.28,0:07:18.58,Default,,0,0,0,,Мен әлі де осындай нәрсені қолданатын адамдар болса, таң қалмас едім.
Dialogue: 0,0:07:19.95,0:07:22.56,Default,,0,0,0,,Бұл қаланың кереметі.
Dialogue: 0,0:07:22.56,0:07:25.16,Default,,0,0,0,,Мен бұл хатты біраз уақытқа дейін сақтаймын.
Dialogue: 0,0:07:25.16,0:07:27.53,Default,,0,0,0,,Поштаға қайтып келген соң қараймын.
Dialogue: 0,0:07:27.96,0:07:29.76,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:29.76,0:07:31.97,Default,,0,0,0,,Кешке дейін күте аламын ба?
Dialogue: 0,0:07:31.97,0:07:34.60,Default,,0,0,0,,Иә! Алдын ала рахмет
Dialogue: 0,0:07:34.60,0:07:35.57,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:41.04,0:07:46.08,Default,,0,0,0,,Бірақ мұндай кішкентай бала мұндай ескі хатты қалай жібереді?
Dialogue: 0,0:07:46.08,0:07:48.68,Default,,0,0,0,,Ата мен әже туралы не айтылады?
Dialogue: 0,0:07:58.56,0:08:01.26,Default,,0,0,0,,Бұл су жолында не болды? Президент Ария
Dialogue: 0,0:08:03.80,0:08:07.03,Default,,0,0,0,,О, сонда барасың ба?
Dialogue: 0,0:08:07.03,0:08:08.23,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:08:08.87,0:08:10.44,Default,,0,0,0,,Бұл тар.
Dialogue: 0,0:08:25.22,0:08:26.95,Default,,0,0,0,,Жарқыраған күн
Dialogue: 0,0:08:28.15,0:08:32.26,Default,,0,0,0,,Мұндай жер болды ма?
Dialogue: 0,0:08:35.19,0:08:35.86,Default,,0,0,0,,Сен!
Dialogue: 0,0:08:36.30,0:08:37.96,Default,,0,0,0,,Сіз оны жеткіздіңіз бе?
Dialogue: 0,0:08:37.96,0:08:41.20,Default,,0,0,0,,Кешіріңіз, әлі жоқ...
Dialogue: 0,0:08:42.24,0:08:44.80,Default,,0,0,0,,Мен уәде берсем де...
Dialogue: 0,0:08:44.80,0:08:46.47,Default,,0,0,0,,Менде тек сен болсаң да...
Dialogue: 0,0:08:46.47,0:08:50.44,Default,,0,0,0,,Тек сен мені байқадың
Dialogue: 0,0:08:50.44,0:08:52.85,Default,,0,0,0,,Мен оны міндетті түрде жеткізгім келеді
Dialogue: 0,0:08:52.85,0:08:56.12,Default,,0,0,0,,Мен пошташыға дәл қазір мекен-жайымды тексеруді тапсырамын.
Dialogue: 0,0:08:56.12,0:08:58.18,Default,,0,0,0,,Сондықтан сәл күте тұрыңыз.
Dialogue: 0,0:08:58.18,0:08:59.59,Default,,0,0,0,,Оның келетініне сенімдісіз бе?
Dialogue: 0,0:08:59.59,0:09:00.42,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:00.42,0:09:02.49,Default,,0,0,0,,Жақсы
Dialogue: 0,0:09:02.49,0:09:08.59,Default,,0,0,0,,Хаттар уақыт пен орыннан тыс жүрекке шынымен жетеді.
Dialogue: 0,0:09:08.59,0:09:10.63,Default,,0,0,0,,Уақыт пен орыннан тыс...?
Dialogue: 0,0:09:10.63,0:09:12.00,Default,,0,0,0,,Ами!
Dialogue: 0,0:09:12.00,0:09:13.97,Default,,0,0,0,,Ami тұтынушысы?
Dialogue: 0,0:09:13.97,0:09:16.40,Default,,0,0,0,,Өтінемін.
Dialogue: 0,0:09:46.63,0:09:48.87,Default,,0,0,0,,Үзіліс уақыты келді ме?
Dialogue: 0,0:09:48.87,0:09:50.27,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:09:50.27,0:09:51.67,Default,,0,0,0,,Сувенирлер
Dialogue: 0,0:09:51.67,0:09:53.14,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:53.57,0:09:54.67,Default,,0,0,0,,Жазғы шаршау?
Dialogue: 0,0:09:54.67,0:09:56.68,Default,,0,0,0,,А, жоқ, бәрі жақсы.
Dialogue: 0,0:09:56.68,0:09:59.01,Default,,0,0,0,,Хатыңызды біразға дейін сақтадым.
Dialogue: 0,0:09:59.01,0:10:00.45,Default,,0,0,0,,О, тәңірім
Dialogue: 0,0:10:01.88,0:10:05.22,Default,,0,0,0,,Менің басым ауырып тұр
Dialogue: 0,0:10:08.99,0:10:10.66,Default,,0,0,0,,О, ой, ой!
Dialogue: 0,0:10:10.66,0:10:14.36,Default,,0,0,0,,Олай болса, мекен-жайды білген соң, мен оны сізге бірден жеткізуім керек.
Dialogue: 0,0:10:14.36,0:10:15.43,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:19.50,0:10:21.07,Default,,0,0,0,,Хошу оқиғасынан екі күн өткен соң
Dialogue: 0,0:10:21.83,0:10:24.70,Default,,0,0,0,,Пошташы, қалай болды?
Dialogue: 0,0:10:24.70,0:10:27.51,Default,,0,0,0,,Мен біраз зерттедім, бірақ...
Dialogue: 0,0:10:27.51,0:10:29.64,Default,,0,0,0,,(Дауыстар таласып жатыр)
Dialogue: 0,0:10:29.64,0:10:31.81,Default,,0,0,0,,О, бұл ұят.
Dialogue: 0,0:10:32.95,0:10:36.08,Default,,0,0,0,,Бұл мекенжай енді қолданылмайды.
Dialogue: 0,0:10:36.08,0:10:37.92,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:10:37.92,0:10:41.85,Default,,0,0,0,,Бұл мекен-жай емес, бірақ мекенжаймен аттас орын бар.
Dialogue: 0,0:10:41.85,0:10:43.96,Default,,0,0,0,,Жоқ, солай болды.
Dialogue: 0,0:10:43.96,0:10:45.09,Default,,0,0,0,,Қайда? ол
Dialogue: 0,0:10:45.09,0:10:49.36,Default,,0,0,0,,Бірақ бұл мүмкін емес.
Dialogue: 0,0:10:49.93,0:10:52.63,Default,,0,0,0,,Мүмкін болмаса да айтып беруіңізді сұрай аламын ба?
Dialogue: 0,0:10:52.63,0:10:56.34,Default,,0,0,0,,А, менің ойымша, бұл жер жақсы...
Dialogue: 0,0:10:58.80,0:11:00.77,Default,,0,0,0,,Өсіру базасы?
Dialogue: 0,0:11:00.77,0:11:06.71,Default,,0,0,0,,Әй, бір кездері құрғақ шөл болған мына планетада мұхит жасағымыз келген кез болды.
Dialogue: 0,0:11:06.71,0:11:10.72,Default,,0,0,0,,Жер асты мұзын қазу үшін барлық жерде базалар бар.
Dialogue: 0,0:11:10.72,0:11:14.72,Default,,0,0,0,,Олардың біреуінің аты адресатпен бірдей болды.
Dialogue: 0,0:11:14.72,0:11:18.46,Default,,0,0,0,,Сонда ол жерде әлі де адамдар бар шығар...?
Dialogue: 0,0:11:18.46,0:11:19.86,Default,,0,0,0,,Енді?
Dialogue: 0,0:11:19.86,0:11:24.20,Default,,0,0,0,,Сансыз негіздер болды, енді әрқайсысымен не болады?
Dialogue: 0,0:11:24.20,0:11:27.27,Default,,0,0,0,,Біз білмейміз.
Dialogue: 0,0:11:27.27,0:11:29.80,Default,,0,0,0,,Онда ешкім тұрмауы керек шығар.
Dialogue: 0,0:11:30.37,0:11:34.81,Default,,0,0,0,,Бірақ ол маған мынаны жеткізуімді өтінді.
Dialogue: 0,0:11:34.81,0:11:38.78,Default,,0,0,0,,Мен шамамен орналасқан жерін білемін.
Dialogue: 0,0:11:39.85,0:11:42.48,Default,,0,0,0,,Рахмет
Dialogue: 0,0:11:42.48,0:11:45.59,Default,,0,0,0,,Тек, жартылай жартылай жартылай жүруге жетпейді.
Dialogue: 0,0:11:47.55,0:11:50.49,Default,,0,0,0,,Бірақ мен уәде бердім, сондықтан мен кетуім керек.
Dialogue: 0,0:11:50.49,0:11:52.46,Default,,0,0,0,,Қанша сағат кетсе де
Dialogue: 0,0:11:52.46,0:11:54.73,Default,,0,0,0,,Оған бір ай қажет.
Dialogue: 0,0:11:54.73,0:11:58.40,Default,,0,0,0,,Не? Соншама? Не істеуім керек?
Dialogue: 0,0:12:05.20,0:12:09.18,Default,,0,0,0,,Эй, бұл АРИА компаниясына сыйлық!
Dialogue: 0,0:12:10.01,0:12:11.61,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:11.61,0:12:14.05,Default,,0,0,0,,Міне осылай.
Dialogue: 0,0:12:14.05,0:12:16.82,Default,,0,0,0,,Nekomanma гурман жиынтығы осында, мистер.
Dialogue: 0,0:12:18.08,0:12:21.29,Default,,0,0,0,,Екіншісі табан шебері ме?
Dialogue: 0,0:12:21.29,0:12:23.46,Default,,0,0,0,,Сонымен, Алисия оны онлайн сатып алды.
Dialogue: 0,0:12:23.46,0:12:26.16,Default,,0,0,0,,Сонымен, сіз оны жеткізгеніңізге сенімдісіз бе?
Dialogue: 0,0:12:26.63,0:12:28.59,Default,,0,0,0,,Иә, рахмет...
Dialogue: 0,0:12:29.56,0:12:31.86,Default,,0,0,0,,Міне.
Dialogue: 0,0:12:33.83,0:12:36.07,Default,,0,0,0,,Вуди мырза! кешіріңіз!
Dialogue: 0,0:12:36.07,0:12:37.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:37.50,0:12:39.04,Default,,0,0,0,,Менің сенен бір жақсылығым бар!
Dialogue: 0,0:12:40.67,0:12:42.94,Default,,0,0,0,,Мені жеткіз!
Dialogue: 0,0:12:48.61,0:12:51.12,Default,,0,0,0,,Кешіріңіз, Алисия.
Dialogue: 0,0:12:51.12,0:12:52.22,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:12:52.22,0:12:55.02,Default,,0,0,0,,Бүгін түстен кейін менде бір ғана тапсырыс бар.
Dialogue: 0,0:12:55.02,0:12:58.42,Default,,0,0,0,,Мен ризамын, бірақ риза емеспін.
Dialogue: 0,0:12:58.42,0:13:02.19,Default,,0,0,0,,Күн өте ыстық болса, мұндай күндер болады.
Dialogue: 0,0:13:02.19,0:13:04.03,Default,,0,0,0,,Акари!
Dialogue: 0,0:13:04.03,0:13:06.77,Default,,0,0,0,,Айка-чан! Алиса!
Dialogue: 0,0:13:06.77,0:13:08.63,Default,,0,0,0,,Сіз шынымен барасыз ба?
Dialogue: 0,0:13:08.63,0:13:10.54,Default,,0,0,0,,Ол үлкен жігіт.
Dialogue: 0,0:13:12.57,0:13:16.61,Default,,0,0,0,,Мен оны шынымен түсінбесем де, арзан ұсыныс жасап жатырмын.
Dialogue: 0,0:13:16.61,0:13:18.08,Default,,0,0,0,,Өтінемін, рұқсат етші.
Dialogue: 0,0:13:18.08,0:13:19.91,Default,,0,0,0,,Иә, бәрібір
Dialogue: 0,0:13:19.91,0:13:23.12,Default,,0,0,0,,Бұл хатты күтіп отырғандар бар екеніне сенімдімін.
Dialogue: 0,0:13:25.58,0:13:27.09,Default,,0,0,0,,Күткеніңізге рахмет.
Dialogue: 0,0:13:27.59,0:13:29.36,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:13:29.36,0:13:31.56,Default,,0,0,0,,Маған қалдырыңыз.
Dialogue: 0,0:13:31.56,0:13:34.63,Default,,0,0,0,,Велосипедіңізден құлап кетпеу үшін абай болыңыз.
Dialogue: 0,0:13:34.63,0:13:35.80,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:35.80,0:13:37.56,Default,,0,0,0,,Сіздің орамалыңыз болды ма?
Dialogue: 0,0:13:37.56,0:13:38.53,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:38.53,0:13:40.73,Default,,0,0,0,,Су бөтелкесі Ішінде бірдеңе бар ма?
Dialogue: 0,0:13:40.73,0:13:43.40,Default,,0,0,0,,Не? Иә!
Dialogue: 0,0:13:43.40,0:13:45.67,Default,,0,0,0,,Сізге үлкен бала сияқты қарайды.
Dialogue: 0,0:13:47.71,0:13:49.44,Default,,0,0,0,,Жеткізу дұрыс па?
Dialogue: 0,0:13:49.44,0:13:51.08,Default,,0,0,0,,Бет астында ғаламдық державалар қатал ақпараттық соғыстар жүргізетін дәуірде
Dialogue: 0,0:13:51.08,0:13:53.55,Default,,0,0,0,,Жеткізу мекенжайының картасы Жарайды ма?
Dialogue: 0,0:13:53.55,0:13:54.45,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:54.45,0:13:56.28,Default,,0,0,0,,Сіз психикалық дайынсыз ба?
Dialogue: 0,0:13:56.28,0:13:57.18,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:57.18,0:13:59.45,Default,,0,0,0,,Олай болса ұш!
Dialogue: 0,0:14:07.39,0:14:09.53,Default,,0,0,0,,Мен кеттім.
Dialogue: 0,0:14:09.53,0:14:11.43,Default,,0,0,0,,Трусиканы толығымен көрсетіңіз.
Dialogue: 0,0:14:18.07,0:14:19.67,Default,,0,0,0,,Ол оны істеу үшін біреуді жіберген болар — аузынан сөз шықпайтын біреуді.
Dialogue: 0,0:14:19.67,0:14:23.21,Default,,0,0,0,,Аспанда жүзу өзін жақсы сезінеді және көңілді.
Dialogue: 0,0:14:23.21,0:14:24.41,Default,,0,0,0,,Жүзу?
Dialogue: 0,0:14:24.41,0:14:26.01,Default,,0,0,0,,Аспан – теңіз
Dialogue: 0,0:14:26.01,0:14:29.05,Default,,0,0,0,,Біздер қазір балықпыз.
Dialogue: 0,0:14:29.05,0:14:30.42,Default,,0,0,0,,Бұл балық па?
Dialogue: 0,0:14:30.42,0:14:31.35,Default,,0,0,0,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,0:14:31.35,0:14:35.55,Default,,0,0,0,,Сауыр мен скумбрия да осы сезіммен жүзетініне сенімдімін.
Dialogue: 0,0:14:35.55,0:14:38.66,Default,,0,0,0,,Ең болмаса өзіңізді дельфин немесе су перісі сияқты сезінетініңізді айтқым келеді.
Dialogue: 0,0:14:38.66,0:14:39.73,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:14:39.73,0:14:40.96,Default,,0,0,0,,Мен аздап өткізіп жіберемін.
Dialogue: 0,0:14:40.96,0:14:41.66,Default,,0,0,0,,Хахи!
Dialogue: 0,0:14:51.00,0:14:53.01,Default,,0,0,0,,Акари-чан, жақсысың ба?
Dialogue: 0,0:14:54.34,0:14:56.51,Default,,0,0,0,,Алдағы аралда демалайық.
Dialogue: 0,0:15:03.75,0:15:06.92,Default,,0,0,0,,Иә, шамамен бір сағат қалды.
Dialogue: 0,0:15:06.92,0:15:09.12,Default,,0,0,0,,Бұл өте алыс.
Dialogue: 0,0:15:09.12,0:15:12.26,Default,,0,0,0,,Менің де мұндай жерге бірінші рет жүзуім.
Dialogue: 0,0:15:12.26,0:15:15.90,Default,,0,0,0,,Сіз әдетте Нео-Венецияда жұмыс істейсіз бе?
Dialogue: 0,0:15:15.90,0:15:17.86,Default,,0,0,0,,Иә, шамамен.
Dialogue: 0,0:15:17.86,0:15:21.17,Default,,0,0,0,,Мен Вудидің жұмысына тәнтімін.
Dialogue: 0,0:15:21.17,0:15:23.47,Default,,0,0,0,,Иә! ? Ундина қызметін тоқтатасыз ба?
Dialogue: 0,0:15:23.47,0:15:25.77,Default,,0,0,0,,А, бұл дұрыс емес.
Dialogue: 0,0:15:26.27,0:15:29.00,Default,,0,0,0,,Вуди мырза және оның достары, сильфтердің қызметі қандай?
Dialogue: 0,0:15:29.00,0:15:33.18,Default,,0,0,0,,Сіздің жұмысыңыз біреудің маңызды сезімін жеткізу, солай ма?
Dialogue: 0,0:15:34.98,0:15:37.38,Default,,0,0,0,,Мұндай нәрсе керемет, солай емес пе?
Dialogue: 0,0:15:37.38,0:15:41.05,Default,,0,0,0,,Ундиннің де осындай жұмысты атқарғанын қалаймын.
Dialogue: 0,0:15:41.05,0:15:43.89,Default,,0,0,0,,Сонда іскер жауға айналасың.
Dialogue: 0,0:15:43.89,0:15:45.83,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:15:46.86,0:15:51.30,Default,,0,0,0,,Біз бұл затты мініп, құнды сезімдеріңізді жеткізуге көмектесеміз.
Dialogue: 0,0:15:52.36,0:15:53.95,Default,,0,0,0,,Жою
Dialogue: 0,0:15:53.95,0:15:57.90,Default,,0,0,0,,Арнайы гондолада жүру кезінде адамдарға өзін маңызды сезінуге көмектесу
Dialogue: 0,0:15:57.90,0:15:59.31,Default,,0,0,0,,Бұл жұмыс.
Dialogue: 0,0:16:00.21,0:16:03.28,Default,,0,0,0,,Өзіңізді маңызды сезінуге көмектесесіз бе?
Dialogue: 0,0:16:03.28,0:16:05.54,Default,,0,0,0,,Қандай керемет жұмыс!
Dialogue: 0,0:16:08.51,0:16:11.12,Default,,0,0,0,,Иә! Мен қайтадан бар күшімді саламын!
Dialogue: 0,0:16:11.12,0:16:11.92,Default,,0,0,0,,Хахи!
Dialogue: 0,0:16:18.69,0:16:22.96,Default,,0,0,0,,Бұл теңіздің ешқашан болмағанына сену қиын.
Dialogue: 0,0:16:22.96,0:16:27.03,Default,,0,0,0,,Біреу көп еңбек етті. Сенсеңіз армандар орындалады.
Dialogue: 0,0:16:43.68,0:16:47.42,Default,,0,0,0,,Карта бойынша ол осы жерде болуы керек.
Dialogue: 0,0:16:47.42,0:16:49.15,Default,,0,0,0,,Ештеңе емес, солай ма?
Dialogue: 0,0:16:49.96,0:16:51.72,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:16:55.59,0:16:57.83,Default,,0,0,0,,Вуди мырза, бұл не?
Dialogue: 0,0:16:58.23,0:16:59.57,Default,,0,0,0,,Барып көрейік.
Dialogue: 0,0:17:12.24,0:17:14.88,Default,,0,0,0,,Бұл қабір ме?
Dialogue: 0,0:17:14.88,0:17:16.40,Default,,0,0,0,,Міне осылай.
Dialogue: 0,0:17:16.40,0:17:20.55,Default,,0,0,0,,Бұл жерде адамдар тұрады деген сөз.
Dialogue: 0,0:17:20.55,0:17:22.42,Default,,0,0,0,,Негіз қай жерде?
Dialogue: 0,0:17:22.42,0:17:24.42,Default,,0,0,0,,А...
Dialogue: 0,0:17:24.42,0:17:25.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:27.56,0:17:29.26,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:17:29.26,0:17:32.57,Default,,0,0,0,,Мен дәл қазір теңізде бірдеңе көргендей болдым.
Dialogue: 0,0:17:45.74,0:17:48.01,Default,,0,0,0,,Теңізде ғимарат бар...!
Dialogue: 0,0:17:48.01,0:17:52.15,Default,,0,0,0,,Өсіру негізі теңізге батып кеткен сияқты.
Dialogue: 0,0:17:52.15,0:17:55.32,Default,,0,0,0,,Сонда адресат қайда?
Dialogue: 0,0:17:57.36,0:18:00.06,Default,,0,0,0,,Сіз енді бұл жерде емессіз бе?
Dialogue: 0,0:18:00.06,0:18:03.96,Default,,0,0,0,,Берілме! Мен бір анықтама табуға тырысамын.
Dialogue: 0,0:18:03.96,0:18:05.20,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:13.57,0:18:14.84,Default,,0,0,0,,Толық дайын болу үшін, ұсынылғандай,
Dialogue: 0,0:18:18.94,0:18:20.88,Default,,0,0,0,,Мен таптым, Акари-чан!
Dialogue: 0,0:18:21.35,0:18:24.35,Default,,0,0,0,,Алисия президенті Ария
Dialogue: 0,0:18:24.92,0:18:27.09,Default,,0,0,0,,Алисия, не болды?
Dialogue: 0,0:18:27.92,0:18:29.82,Default,,0,0,0,,Мен оны гүл дүкенінен алдым.
Dialogue: 0,0:18:29.82,0:18:32.46,Default,,0,0,0,,Бұл керемет. Сіз оны міне аласыз.
Dialogue: 0,0:18:32.46,0:18:35.83,Default,,0,0,0,,Бірақ бұл қағаз болғандықтан қалада қауіпті болды.
Dialogue: 0,0:18:35.83,0:18:36.80,Default,,0,0,0,,О
Dialogue: 0,0:18:36.80,0:18:41.10,Default,,0,0,0,,Акари-чан, ол хат бұрыннан келген болуы мүмкін.
Dialogue: 0,0:18:41.57,0:18:43.00,Default,,0,0,0,,Баяғыда?
Dialogue: 0,0:18:43.00,0:18:46.91,Default,,0,0,0,,Иә, мен пионер дәуірі туралы біраз зерттеу жүргіздім.
Dialogue: 0,0:18:47.64,0:18:52.14,Default,,0,0,0,,Бұл база күтілгеннен әлдеқайда көп су тапты.
Dialogue: 0,0:18:52.14,0:18:54.61,Default,,0,0,0,,Сондықтан ол теңізге батып кетті.
Dialogue: 0,0:18:55.15,0:18:57.08,Default,,0,0,0,,Онда кімдер болды?
Dialogue: 0,0:18:57.08,0:18:59.75,Default,,0,0,0,,Мұндай апаттар сирек емес еді.
Dialogue: 0,0:18:59.75,0:19:01.95,Default,,0,0,0,,Егжей-тегжейлі жазбалар жоқ сияқты.
Dialogue: 0,0:19:01.95,0:19:06.06,Default,,0,0,0,,Мүмкін хат апат туралы ақпарат шықпай тұрып жіберілген шығар.
Dialogue: 0,0:19:06.06,0:19:09.40,Default,,0,0,0,,Барар жері жоқ адасып кеткен баланың хаты ма деп ойлаймын.
Dialogue: 0,0:19:09.40,0:19:12.16,Default,,0,0,0,,Егер солай болса, адресат әлдеқашан... ма?
Dialogue: 0,0:19:14.50,0:19:17.84,Default,,0,0,0,,Ол бала бұл хатпен не істеді?
Dialogue: 0,0:19:17.84,0:19:19.64,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:19:19.64,0:19:22.64,Default,,0,0,0,,Біреу жабық тауып алды ма деп ойлаймын.
Dialogue: 0,0:19:22.64,0:19:26.15,Default,,0,0,0,,Сәлем, Акари-чан! Келіңіздер! Мен таптым!
Dialogue: 0,0:19:26.15,0:19:27.51,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:32.69,0:19:34.62,Default,,0,0,0,,Сол атау
Dialogue: 0,0:19:34.62,0:19:39.06,Default,,0,0,0,,Оның шешкен жылы өлген жылымен бірдей сияқты.
Dialogue: 0,0:19:39.06,0:19:42.63,Default,,0,0,0,,Мен оны жеткізу үшін келгенім үшін кешірім сұраймын.
Dialogue: 0,0:19:43.66,0:19:45.90,Default,,0,0,0,,Хатты жеткізейік.
Dialogue: 0,0:19:45.90,0:19:47.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:47.27,0:19:48.83,Default,,0,0,0,,Сіз уәде бердіңіз, солай ма?
Dialogue: 0,0:19:50.47,0:19:51.54,Default,,0,0,0,,Президент Ария
Dialogue: 0,0:19:58.64,0:20:01.98,Default,,0,0,0,,Пошташы маған карта оқу құралын іздеді.
Dialogue: 0,0:20:05.45,0:20:08.42,Default,,0,0,0,,Олай болса, Президент Ария, өтінемін.
Dialogue: 0,0:20:14.26,0:20:16.93,Default,,0,0,0,,Аллен, қалайсың?
Dialogue: 0,0:20:16.93,0:20:19.73,Default,,0,0,0,,Көріп тұрғаныңыздай менде бәрі жақсы.
Dialogue: 0,0:20:19.73,0:20:22.60,Default,,0,0,0,,Жағалау сызығы айтарлықтай көтерілді.
Dialogue: 0,0:20:22.60,0:20:24.87,Default,,0,0,0,,Судың жоспарланған күніне дейін сәл ғана қалды
Dialogue: 0,0:20:24.87,0:20:30.58,Default,,0,0,0,,Аллен мен оның достары қазатын су біздің үйдің алдындағы су жолын толтыратынына сенімдімін.
Dialogue: 0,0:20:30.58,0:20:33.65,Default,,0,0,0,,Сол кезде Аллен маған қайтып келеді.
Dialogue: 0,0:20:34.55,0:20:38.15,Default,,0,0,0,,Бұл сіздің үйлену тойыңыздың жалғыз мерейтойы болса да, оны осы жылмен шектеңіз.
Dialogue: 0,0:20:38.15,0:20:42.79,Default,,0,0,0,,А? Мүмкін ұмытып кеткен шығарсың? Бүгін менің үйлену тойым
Dialogue: 0,0:20:42.79,0:20:46.33,Default,,0,0,0,,Мен кенеттен Акваға баруға тура келген кезде қатты қобалжыдым.
Dialogue: 0,0:20:46.33,0:20:47.86,Default,,0,0,0,,Сондықтан мен сені кешіремін
Dialogue: 0,0:20:48.99,0:20:52.50,Default,,0,0,0,,Мен Алленнің Акваға келгенде айтқан сөзін ұмытқан жоқпын.
Dialogue: 0,0:20:54.27,0:20:58.67,Default,,0,0,0,,Аква бір күні бақытқа толы жұлдызға айналады.
Dialogue: 0,0:20:58.67,0:21:01.84,Default,,0,0,0,,Сондықтан біз суды қазамыз.
Dialogue: 0,0:21:02.27,0:21:05.38,Default,,0,0,0,,Мен бұл сөздерге сенемін
Dialogue: 0,0:21:05.38,0:21:07.71,Default,,0,0,0,,Қазір қиын кездер көп болса да
Dialogue: 0,0:21:07.71,0:21:13.29,Default,,0,0,0,,Біздің балалық шағымыз күлкіге толы болғанына сенімдімін.
Dialogue: 0,0:21:13.29,0:21:15.02,Default,,0,0,0,,Және-
Dialogue: 0,0:21:15.02,0:21:16.46,Default,,0,0,0,,Жоқ, Ами!
Dialogue: 0,0:21:16.46,0:21:19.83,Default,,0,0,0,,Бұл Алленге жіберілетін маңызды хабарлама, сондықтан оны мазақ етпеңіз.
Dialogue: 0,0:21:23.80,0:21:26.53,Default,,0,0,0,,А, бұл жер...
Dialogue: 0,0:21:30.24,0:21:31.97,Default,,0,0,0,,Қандай дәрменсіз бала.
Dialogue: 0,0:21:32.47,0:21:35.67,Default,,0,0,0,,Ами де Алленмен кездескісі келеді.
Dialogue: 0,0:21:35.67,0:21:39.85,Default,,0,0,0,,Менің де сізді бірден көргім келеді.
Dialogue: 0,0:21:39.85,0:21:41.91,Default,,0,0,0,,Мүмкін болса...
Dialogue: 0,0:21:41.91,0:21:44.88,Default,,0,0,0,,Бірақ бұл мүмкін емес.
Dialogue: 0,0:21:44.88,0:21:49.66,Default,,0,0,0,,Сондықтан мен Алленге ең болмаса жүрегімді бергім келеді.
Dialogue: 0,0:21:50.26,0:21:53.13,Default,,0,0,0,,Мен сені жақсы көремін Аллен
Dialogue: 0,0:21:55.93,0:22:00.10,Default,,0,0,0,,Ол баланың айтқысы келгені осы сезім болды.
Dialogue: 0,0:22:00.83,0:22:02.03,Default,,0,0,0,,Жақсы
Dialogue: 0,0:22:02.03,0:22:07.64,Default,,0,0,0,,Хат шын мәнінде уақыт пен орыннан асып, жүрекке жетеді.
Dialogue: 0,0:22:08.41,0:22:10.18,Default,,0,0,0,,Мен оны жаңа ғана жеткіздім.
Dialogue: 0,0:22:11.04,0:22:12.85,Default,,0,0,0,,Мен оны дұрыс жеткіздім.
Dialogue: 0,0:22:15.08,0:22:21.32,Default,,0,0,0,,Ай-чан, мен Нео-Венезияға қайтып оралдым және сол кезден қайтадан су жолына шықтым.
Dialogue: 0,0:22:21.32,0:22:23.76,Default,,0,0,0,,Мен ол жерге бара алмадым.
Dialogue: 0,0:22:26.99,0:22:31.83,Default,,0,0,0,,Маған қымбат сезімдеріңізді жеткізе алғаныңызға қуаныштымын, Акари-сан.
Dialogue: 0,0:22:31.83,0:22:34.60,Default,,0,0,0,,Нео-Венеция ғажайыптардан жасалған.
Dialogue: 0,0:22:34.60,0:22:38.10,Default,,0,0,0,,Акари-сан мұны бұрын айтқан.
Dialogue: 0,0:22:38.10,0:22:45.46,Default,,0,0,0,,Мүмкін, барлық Аква нәзік ғажайыптардан жасалған.
Dialogue: 0,0:22:45.46,0:22:50.89,Default,,0,0,0,,Алақанға жайлап қояды
Dialogue: 0,0:22:50.89,0:22:56.99,Default,,0,0,0,,Мейіріміңді ақырын жылыт
Dialogue: 0,0:22:56.99,0:23:02.05,Default,,0,0,0,,Құпия әуенді ызылдадым
Dialogue: 0,0:23:02.05,0:23:09.03,Default,,0,0,0,,Баратын жерім жоқ болса да, ән айт
Dialogue: 0,0:23:09.03,0:23:13.22,Default,,0,0,0,,Бірақ жаңбыр жауа бастады
Dialogue: 0,0:23:13.22,0:23:20.54,Default,,0,0,0,,Маған бәрібір, мен әрқашан жаныңда боламын
Dialogue: 0,0:23:20.54,0:23:28.39,Default,,0,0,0,,Көптеген кемпірқосақтарды кесіп өтуге болады
Dialogue: 0,0:23:28.39,0:23:31.71,Default,,0,0,0,,Бірге кемпірқосақ үстінде
Dialogue: 0,0:23:31.71,0:23:39.56,Default,,0,0,0,,Кішкентай жарық, жұлдызға тілек
Dialogue: 0,0:23:39.56,0:23:48.28,Default,,0,0,0,,Орындалсын, Көк құс екеніне сенімдімін
Dialogue: 0,0:23:48.28,0:23:51.00,Default,,0,0,0,,Махаббатқа толы жүрекпен
Dialogue: 0,0:23:51.00,0:23:53.86,Default,,0,0,0,,Жина, ол кемпірқосақ болары сөзсіз
Dialogue: 0,0:23:53.86,0:23:56.60,Default,,0,0,0,,Жүрегіңізде әрқашан махаббат болсын
Dialogue: 0,0:23:56.60,0:24:01.36,Default,,0,0,0,,Мен оны кесіп өтемін, Кемпірқосақ боларына сенімдімін
Dialogue: 0,0:24:07.29,0:24:10.30,Default,,0,0,0,,Айка-чан, Алиса-чан, шытырман оқиғалы саяхатқа шығайық
Dialogue: 0,0:24:10.30,0:24:12.23,Default,,0,0,0,,Маған демалуға арналған турлар ұнайды.
Dialogue: 0,0:24:12.23,0:24:14.23,Default,,0,0,0,,Жарайды тур сияқты ұятсыз жолдар
Dialogue: 0,0:24:14.23,0:24:15.07,Default,,0,0,0,,Иә? !
Dialogue: 0,0:24:15.07,0:24:18.40,Default,,0,0,0,,Келесі жолы: «Ол болмауы керек аралға...»
Dialogue: 0,0:24:18.40,0:24:20.71,Default,,0,0,0,,Бірге тамаша уақыт өткізейік!
Dialogue: 0,0:24:22.21,0:24:28.21,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
