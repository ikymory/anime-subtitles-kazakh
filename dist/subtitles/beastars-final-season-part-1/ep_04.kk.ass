Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.01,0:00:14.01,Default,,0,0,0,,♪～
Dialogue: 0,0:01:38.13,0:01:40.14,Default,,0,0,0,,～♪
Dialogue: 0,0:01:47.02,0:01:48.23,Default,,0,0,0,,Теяааааааааааа!
Dialogue: 0,0:01:48.31,0:01:50.44,Default,,0,0,0,,Бұл балаға тиіспеңіз!
Dialogue: 0,0:01:50.52,0:01:52.11,Default,,0,0,0,,Уф! Ай!
Dialogue: 0,0:01:52.19,0:01:53.07,Default,,0,0,0,,Гухе
Dialogue: 0,0:01:53.15,0:01:54.28,Default,,0,0,0,,Практикалық емтихан: Дайын бол, баста!
Dialogue: 0,0:01:56.11,0:01:58.03,Default,,0,0,0,,Иа... хех хе...
Dialogue: 0,0:01:58.74,0:01:59.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:59.36,0:02:03.03,Default,,0,0,0,,Сіз уағызыңызды әлі аяқтаған жоқсыз, Легоши.
Dialogue: 0,0:02:03.70,0:02:08.16,Default,,0,0,0,,Мен айтып жүрген саясаттың жалғасы бар.
Dialogue: 0,0:02:08.25,0:02:11.67,Default,,0,0,0,,«пацифизм» өте жақсы
Dialogue: 0,0:02:11.75,0:02:17.22,Default,,0,0,0,,Ал күшті адам айтқан кезде ғана мағынасы болады.
Dialogue: 0,0:02:17.30,0:02:19.30,Default,,0,0,0,,-Уау! -(Гоша) Ия! Ха!
Dialogue: 0,0:02:19.38,0:02:20.97,Default,,0,0,0,,(Бүркіттердің ыңырануы)
Dialogue: 0,0:02:21.05,0:02:22.30,Default,,0,0,0,,Ой... уау!
Dialogue: 0,0:02:22.39,0:02:23.35,Default,,0,0,0,,Нвааах!
Dialogue: 0,0:02:25.43,0:02:28.14,Default,,0,0,0,,- (Гоша) Ха... Хаа - Мм...
Dialogue: 0,0:02:28.23,0:02:30.06,Default,,0,0,0,,Хахаха
Dialogue: 0,0:02:30.14,0:02:31.48,Default,,0,0,0,,Арқаңа көтерші, өтінемін.
Dialogue: 0,0:02:32.06,0:02:33.15,Default,,0,0,0,,Угяаа
Dialogue: 0,0:02:33.23,0:02:34.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:34.73,0:02:37.19,Default,,0,0,0,,Уф... Угг
Dialogue: 0,0:02:37.28,0:02:39.99,Default,,0,0,0,,Аяқтау соққысын бере аласыз ба? Легоши
Dialogue: 0,0:02:40.07,0:02:43.03,Default,,0,0,0,,Не... соңғы нүкте? Уф...
Dialogue: 0,0:02:43.12,0:02:46.29,Default,,0,0,0,,Уф... уф... уф!
Dialogue: 0,0:02:51.62,0:02:54.59,Default,,0,0,0,,Құстар ұшуға жеңіл.
Dialogue: 0,0:02:54.67,0:02:56.55,Default,,0,0,0,,Құрлықта соғысуға жарамсыз шығар
Dialogue: 0,0:02:56.63,0:03:00.13,Default,,0,0,0,,Мен сізді жақсы білемін. Сіз төбелесуге үйрендіңіз бе?
Dialogue: 0,0:03:00.22,0:03:02.84,Default,,0,0,0,,Ух... Цк, жоқ, мен мұны бір жерден оқығанмын.
Dialogue: 0,0:03:03.34,0:03:04.60,Default,,0,0,0,,Ха ха ха
Dialogue: 0,0:03:05.43,0:03:10.48,Default,,0,0,0,,Мына бұзақыларды жаңа ғана қарттар ұрып-соғыпты.
Dialogue: 0,0:03:12.52,0:03:15.06,Default,,0,0,0,,Ақырында оянасыз
Dialogue: 0,0:03:15.15,0:03:17.19,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:03:17.94,0:03:22.49,Default,,0,0,0,,Легоши, мен сені уайымдап келдім.
Dialogue: 0,0:03:23.78,0:03:27.24,Default,,0,0,0,,Атам енді қасында болмайтын сияқты.
Dialogue: 0,0:03:27.91,0:03:29.33,Default,,0,0,0,,Хаа…
Dialogue: 0,0:03:35.92,0:03:39.92,Default,,0,0,0,,Азуки-сан, саған шарап ұнаған сияқты.
Dialogue: 0,0:03:40.01,0:03:41.34,Default,,0,0,0,,Тіпті Луис мырза
Dialogue: 0,0:03:41.42,0:03:43.68,Default,,0,0,0,,Дәмді екенін естідім.
Dialogue: 0,0:03:43.76,0:03:45.26,Default,,0,0,0,,Спаржа таглиолини
Dialogue: 0,0:03:45.35,0:03:49.56,Default,,0,0,0,,Ах, май кремі негізіндегі соус және спаржа.
Dialogue: 0,0:03:49.64,0:03:51.39,Default,,0,0,0,,Бұл шынымен де талғампаз.
Dialogue: 0,0:03:51.48,0:03:53.73,Default,,0,0,0,,Сіздің тәбетіңіз қалыпты ма?
Dialogue: 0,0:03:53.81,0:03:54.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:54.98,0:03:56.98,Default,,0,0,0,,Мен әкемнің аузынан естідім.
Dialogue: 0,0:03:57.07,0:04:00.28,Default,,0,0,0,,Луи, сенің оң аяғыңнан айырылғаныңды естідім.
Dialogue: 0,0:04:00.36,0:04:03.40,Default,,0,0,0,,А... иә, мен апатқа ұшырадым.
Dialogue: 0,0:04:03.49,0:04:06.62,Default,,0,0,0,,Менің өмірімді сақтап қалу бақыт болды.
Dialogue: 0,0:04:06.70,0:04:07.87,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:04:09.20,0:04:11.41,Default,,0,0,0,,Ер адамның жұмысында ақаулар бар ма?
Dialogue: 0,0:04:12.62,0:04:13.54,Default,,0,0,0,,Оларға мұқият қарап тұр.
Dialogue: 0,0:04:14.00,0:04:16.29,Default,,0,0,0,,Бұл ең маңыздысы.
Dialogue: 0,0:04:16.38,0:04:20.05,Default,,0,0,0,,Үйленгеннен кейін бала сүйе алмайтыныңызды білсеңіз не болады?
Dialogue: 0,0:04:20.59,0:04:21.38,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:22.13,0:04:25.55,Default,,0,0,0,,Мен бұл жерде мұндай дөрекі сұраққа қаншалықты көп жауап берсем, соғұрлым көп
Dialogue: 0,0:04:25.64,0:04:28.30,Default,,0,0,0,,Horns конгломератында қиындық жоқ
Dialogue: 0,0:04:28.39,0:04:31.77,Default,,0,0,0,,Хехе, таңғаларлық аңғал нәрсе айтып тұрсыз.
Dialogue: 0,0:04:31.85,0:04:32.68,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:04:34.35,0:04:36.23,Default,,0,0,0,,Мен де сенен үлгі аламын—
Dialogue: 0,0:04:36.31,0:04:40.02,Default,,0,0,0,,Мен сізді сәл сүйкімдірек шақыруым керек еді.
Dialogue: 0,0:04:41.28,0:04:43.03,Default,,0,0,0,,Менің сізге бөлмем бар.
Dialogue: 0,0:04:43.11,0:04:44.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:44.49,0:04:49.53,Default,,0,0,0,,Біз бір күні ерлі-зайыпты боламыз, неге аралықты дұрыстап жаппасқа?
Dialogue: 0,0:04:50.20,0:04:50.99,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:52.41,0:04:55.33,Default,,0,0,0,,(сүю дыбысы)
Dialogue: 0,0:04:55.42,0:04:57.17,Default,,0,0,0,,(Азукидің тынысы)
Dialogue: 0,0:04:57.25,0:04:59.50,Default,,0,0,0,,(Луидің абдыраған дауысы)
Dialogue: 0,0:04:59.59,0:05:00.63,Default,,0,0,0,,Ах... Азуки-сан
Dialogue: 0,0:05:00.71,0:05:01.50,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:01.59,0:05:03.84,Default,,0,0,0,,Сізге ұнамайтынына сенімдісіз бе?
Dialogue: 0,0:05:03.92,0:05:07.89,Default,,0,0,0,,Жоқ... Мен аздап шөлдеп тұрмын.
Dialogue: 0,0:05:07.97,0:05:09.05,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:05:10.43,0:05:14.06,Default,,0,0,0,,Ол пәк қыз сияқты, сондай аянышты...
Dialogue: 0,0:05:15.02,0:05:19.56,Default,,0,0,0,,Етқоректілер мен шөпқоректілердің бір қоғамда өмір сүретіндігінің өзі
Dialogue: 0,0:05:19.65,0:05:21.40,Default,,0,0,0,,Бұл табиғат заңдарына қайшы.
Dialogue: 0,0:05:21.48,0:05:23.57,Default,,0,0,0,,Бұл төтенше жағдай емес пе?
Dialogue: 0,0:05:24.24,0:05:26.65,Default,,0,0,0,,Етқоректілер мен шөпқоректілер қиылыспаса
Dialogue: 0,0:05:26.74,0:05:29.07,Default,,0,0,0,,Қоғамның қазіргі дамуы мүмкін болды ма?
Dialogue: 0,0:05:29.16,0:05:32.16,Default,,0,0,0,,Егер олар бөлек болса, олар «шокусацу» деп аталады және т.б.
Dialogue: 0,0:05:32.24,0:05:34.87,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:05:34.95,0:05:40.42,Default,,0,0,0,,Ыңғайлы неке құру Бұл шынымен дұрыс жол ма?
Dialogue: 0,0:05:41.88,0:05:45.01,Default,,0,0,0,,Луи, сен мені құтқардың.
Dialogue: 0,0:05:45.09,0:05:46.59,Default,,0,0,0,,Қарғыс атсын... haa
Dialogue: 0,0:05:46.67,0:05:48.93,Default,,0,0,0,,(Екі тыныс)
Dialogue: 0,0:05:50.01,0:05:53.43,Default,,0,0,0,,(Қатты тыныс алатын екі жануар)
Dialogue: 0,0:05:53.51,0:05:55.43,Default,,0,0,0,,Жарайды, бұл жақсы.
Dialogue: 0,0:05:57.10,0:05:59.65,Default,,0,0,0,,Жіңішке және әлсіз денелер бір-біріне үйіріледі
Dialogue: 0,0:06:00.15,0:06:02.48,Default,,0,0,0,,Бұл қалыпты жағдай, оның қатесі жоқ.
Dialogue: 0,0:06:03.36,0:06:05.69,Default,,0,0,0,,Мен жынды болдым.
Dialogue: 0,0:06:06.28,0:06:08.99,Default,,0,0,0,,Бұл жағдай өте әдеттен тыс болып көрінеді.
Dialogue: 0,0:06:09.07,0:06:10.74,Default,,0,0,0,,Мм...! Хаа...
Dialogue: 0,0:06:13.12,0:06:14.91,Default,,0,0,0,,Джуноның сүйгенінен өзгеше...
Dialogue: 0,0:06:16.04,0:06:19.00,Default,,0,0,0,,Мен бұл қатты азуларды сезе алмаймын...
Dialogue: 0,0:06:20.00,0:06:21.42,Default,,0,0,0,,(Қатты тыныс алатын екі жануар)
Dialogue: 0,0:06:22.13,0:06:24.67,Default,,0,0,0,,Жоқ, жоқ, салыстырма, зейінін шоғырландыр.
Dialogue: 0,0:06:24.75,0:06:27.76,Default,,0,0,0,,Көп ойланба, жолдан тайма
Dialogue: 0,0:06:28.51,0:06:31.39,Default,,0,0,0,,Мен сені ұстаймын, мен сені ұстаймын, мен сені ұстаймын, мен сені ұстаймын!
Dialogue: 0,0:06:31.47,0:06:34.51,Default,,0,0,0,,Бұдан былай мен өз тайпамның мүшесі Азукиді ұстаймын!
Dialogue: 0,0:06:34.60,0:06:36.18,Default,,0,0,0,,А…?
Dialogue: 0,0:06:36.77,0:06:38.06,Default,,0,0,0,,Уф... уф
Dialogue: 0,0:06:38.14,0:06:40.52,Default,,0,0,0,,Луис мырза... жақсысыз ба?
Dialogue: 0,0:06:40.60,0:06:43.23,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:06:43.31,0:06:45.23,Default,,0,0,0,,(Құсу дыбысы)
Dialogue: 0,0:06:45.32,0:06:47.53,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:06:49.90,0:06:54.53,Default,,0,0,0,,Мен шынымен есінен танып қалған сияқтымын.
Dialogue: 0,0:07:00.41,0:07:04.63,Default,,0,0,0,,Хмм, бұл да жаман емес...
Dialogue: 0,0:07:08.71,0:07:10.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:12.30,0:07:15.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:16.76,0:07:17.77,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:07:22.81,0:07:23.90,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:07:26.02,0:07:28.44,Default,,0,0,0,,Әй, мен саған қоңырау шалма дедім.
Dialogue: 0,0:07:29.24,0:07:31.36,Default,,0,0,0,,Сіз берген уәдеңізді ұмыттыңыз ба?
Dialogue: 0,0:07:31.45,0:07:34.37,Default,,0,0,0,,Неліктен бұл жылқы жігіт әлі де үлкен?
Dialogue: 0,0:07:34.45,0:07:37.20,Default,,0,0,0,,Мен түнде қаланы аралап жүрмін. О?
Dialogue: 0,0:07:37.29,0:07:38.83,Default,,0,0,0,,Бұлай асықпа
Dialogue: 0,0:07:39.33,0:07:43.08,Default,,0,0,0,,Бауырымен жорғалаушылар күнге қыздырынған кезде күту керек.
Dialogue: 0,0:07:43.92,0:07:45.59,Default,,0,0,0,,Егер бұл жігіт өлетін болғысы келмесе, денесін Сукунаға тапсырғаны дұрыс—
Dialogue: 0,0:07:53.34,0:07:54.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:58.10,0:08:00.10,Default,,0,0,0,,(Бүркіттердің ыңырануы)
Dialogue: 0,0:08:00.18,0:08:01.56,Default,,0,0,0,,Яғни, қарапайым есептеу бойынша да ол тек екі минуттан кейін ғана пайда болуы тиіс еді.
Dialogue: 0,0:08:02.77,0:08:04.56,Default,,0,0,0,,Олар қандай?
Dialogue: 0,0:08:04.65,0:08:06.06,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:08:06.69,0:08:08.48,Default,,0,0,0,,Эй, маған біреуін берші.
Dialogue: 0,0:08:15.36,0:08:17.07,Default,,0,0,0,,Маған да бер
Dialogue: 0,0:08:17.16,0:08:19.58,Default,,0,0,0,,Бұл ағамның кесірінен менің басымнан өтті.
Dialogue: 0,0:08:19.66,0:08:21.25,Default,,0,0,0,,Хаа... Эй.
Dialogue: 0,0:08:21.33,0:08:23.00,Default,,0,0,0,,А... уф...
Dialogue: 0,0:08:23.08,0:08:25.00,Default,,0,0,0,,Бұл не? Бұлай ашуланудың қажеті жоқ.
Dialogue: 0,0:08:25.08,0:08:26.54,Default,,0,0,0,,Эй, тыныштал.
Dialogue: 0,0:08:27.75,0:08:30.42,Default,,0,0,0,,(қатты сылдырлаған дыбыс)
Dialogue: 0,0:08:30.50,0:08:32.92,Default,,0,0,0,,Ах... Ха...
Dialogue: 0,0:08:35.55,0:08:36.39,Default,,0,0,0,,Ха…
Dialogue: 0,0:08:37.22,0:08:38.14,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:40.01,0:08:41.27,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:08:41.35,0:08:43.06,Default,,0,0,0,,Гух хе хе... хе
Dialogue: 0,0:08:43.14,0:08:44.94,Default,,0,0,0,,- Hmph - (бүркіт 1) Гува...
Dialogue: 0,0:08:46.85,0:08:47.86,Default,,0,0,0,,Фу…
Dialogue: 0,0:08:48.61,0:08:50.69,Default,,0,0,0,,Бұл аянышты
Dialogue: 0,0:08:50.78,0:08:54.03,Default,,0,0,0,,Мен кинус ішкен досым бұлай істей алады деп күтпедім.
Dialogue: 0,0:08:54.11,0:08:57.91,Default,,0,0,0,,А... жоқ, бұл әлгі қартқа.
Dialogue: 0,0:08:57.99,0:08:58.82,Default,,0,0,0,,«Қария»?
Dialogue: 0,0:08:58.91,0:09:03.12,Default,,0,0,0,,Бұл кәрі кесіртке, сол сұмдық улы.
Dialogue: 0,0:09:03.20,0:09:08.13,Default,,0,0,0,,Улы... Сіз болуыңыз мүмкін бе?
Dialogue: 0,0:09:09.75,0:09:12.92,Default,,0,0,0,,Неліктен қазір келіп тұрсыз?
Dialogue: 0,0:09:13.71,0:09:17.72,Default,,0,0,0,,Мені тастап кеткен сатқын... дүние!
Dialogue: 0,0:09:19.85,0:09:22.18,Default,,0,0,0,,(Мотоцикл қозғалтқышының дыбысы)
Dialogue: 0,0:09:22.85,0:09:24.35,Default,,0,0,0,,Та-да!
Dialogue: 0,0:09:24.93,0:09:26.64,Default,,0,0,0,,Тек алыңыз.
Dialogue: 0,0:09:29.02,0:09:30.73,Default,,0,0,0,,Бұл қауіпті емес пе?
Dialogue: 0,0:09:31.32,0:09:35.15,Default,,0,0,0,,Неге мені қалжыңдап тұрсың?
Dialogue: 0,0:09:35.24,0:09:38.36,Default,,0,0,0,,Өртті байқаған сен болдың.
Dialogue: 0,0:09:38.45,0:09:41.62,Default,,0,0,0,,Мен ол баланы жалғыз құтқара алмадым.
Dialogue: 0,0:09:41.70,0:09:43.16,Default,,0,0,0,,Бұл әділ емес!
Dialogue: 0,0:09:43.24,0:09:45.87,Default,,0,0,0,,Ашуланбаңыз, бұл қалыпты жағдай.
Dialogue: 0,0:09:46.79,0:09:49.17,Default,,0,0,0,,«Қалыпты» нәрсені блять.
Dialogue: 0,0:09:49.25,0:09:50.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:50.75,0:09:51.84,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:09:51.92,0:09:54.21,Default,,0,0,0,,Әу бастан осылай жасауым керек еді.
Dialogue: 0,0:09:55.13,0:09:58.59,Default,,0,0,0,,Біз мұндай медальға лайық емеспіз.
Dialogue: 0,0:10:01.18,0:10:03.60,Default,,0,0,0,,Сол кезде мен сенгенмін
Dialogue: 0,0:10:04.85,0:10:09.06,Default,,0,0,0,,350 градустық көру аймағын толықтыратын менің серігім
Dialogue: 0,0:10:09.98,0:10:14.69,Default,,0,0,0,,Сенің кесіріңнен артыма қарай алмаймын.
Dialogue: 0,0:10:15.74,0:10:19.57,Default,,0,0,0,,Ей, Гоша, мына дүниені өзгертейік.
Dialogue: 0,0:10:19.66,0:10:21.20,Default,,0,0,0,,Мен және сен
Dialogue: 0,0:10:21.99,0:10:24.95,Default,,0,0,0,,Екі жануар кез келген нәрсені істей алады
Dialogue: 0,0:10:26.37,0:10:29.83,Default,,0,0,0,,Ол кезде Гоша екеуміздің көздегеніміз
Dialogue: 0,0:10:30.50,0:10:34.17,Default,,0,0,0,,Бұл құбыжықтардың орнына «Құбыжықтар» болды
Dialogue: 0,0:10:36.09,0:10:40.09,Default,,0,0,0,,Бірақ сол түні бәрі бұрмалай бастады.
Dialogue: 0,0:10:44.22,0:10:49.69,Default,,0,0,0,,Хаха... Жақсы жүн. Бұл сізге ақша әкеледі.
Dialogue: 0,0:10:49.77,0:10:52.48,Default,,0,0,0,,Осы азу тістен бастайын ба?
Dialogue: 0,0:10:53.27,0:10:56.94,Default,,0,0,0,,Мен оны сен ұйықтап жатқанда бітіремін.
Dialogue: 0,0:10:57.03,0:10:58.19,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:58.28,0:10:59.53,Default,,0,0,0,,Жоқ! Уф...
Dialogue: 0,0:10:59.61,0:11:00.95,Default,,0,0,0,,Нгга... гугу
Dialogue: 0,0:11:02.32,0:11:03.91,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:11:03.99,0:11:04.87,Default,,0,0,0,,Мен үшін алғаш рет!
Dialogue: 0,0:11:04.95,0:11:08.08,Default,,0,0,0,,Га… Гугу… Нгаа
Dialogue: 0,0:11:09.96,0:11:12.38,Default,,0,0,0,,Әйтеуір дер кезінде жасап қойдым.
Dialogue: 0,0:11:12.46,0:11:14.79,Default,,0,0,0,,Хмм... Ах.
Dialogue: 0,0:11:18.42,0:11:22.22,Default,,0,0,0,,Хаа... таразы...
Dialogue: 0,0:11:22.30,0:11:25.64,Default,,0,0,0,,Әшекейдей, өте әдемі
Dialogue: 0,0:11:25.72,0:11:26.68,Default,,0,0,0,,Ха?
Dialogue: 0,0:11:27.39,0:11:29.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:39.19,0:11:42.95,Default,,0,0,0,,Аа... көп рахмет.
Dialogue: 0,0:11:43.61,0:11:50.04,Default,,0,0,0,,Соңғы кездері жануарларды ұйықтататын дәрімен ұйықтатып, жүнін жұлып тастау оқиғалары жиі орын алуда.
Dialogue: 0,0:11:50.66,0:11:52.62,Default,,0,0,0,,Сақ болыңыз
Dialogue: 0,0:11:52.71,0:11:55.88,Default,,0,0,0,,А, солай ма?
Dialogue: 0,0:11:55.96,0:11:59.59,Default,,0,0,0,,Мен тон киетін болдым ба?
Dialogue: 0,0:12:02.51,0:12:07.60,Default,,0,0,0,,Келесі күні Гоша екеуі кездесіп жүрді.
Dialogue: 0,0:12:07.68,0:12:11.14,Default,,0,0,0,,Және күтпеген жерден ол жалғасын тапты.
Dialogue: 0,0:12:12.18,0:12:16.98,Default,,0,0,0,,Кесіртке мен қасқыр шынымен де түр аралық ғажайып жұп.
Dialogue: 0,0:12:18.27,0:12:20.57,Default,,0,0,0,,Сіздің мәндеріңіз сәйкес келе ме?
Dialogue: 0,0:12:20.65,0:12:24.74,Default,,0,0,0,,Сәйкес келмесе, жарты жылға шыдамайды.
Dialogue: 0,0:12:26.28,0:12:28.49,Default,,0,0,0,,...және сөйлесесіз бе?
Dialogue: 0,0:12:28.58,0:12:30.66,Default,,0,0,0,,Иә, бұл... Хм...
Dialogue: 0,0:12:31.41,0:12:33.21,Default,,0,0,0,,Ол жүкті болды.
Dialogue: 0,0:12:33.29,0:12:34.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:34.25,0:12:35.54,Default,,0,0,0,,Бұл менің балам.
Dialogue: 0,0:12:35.62,0:12:38.92,Default,,0,0,0,,А? Сонда... ол кімнің баласы?
Dialogue: 0,0:12:39.00,0:12:41.13,Default,,0,0,0,,Сонымен... ол менің балам.
Dialogue: 0,0:12:41.21,0:12:46.76,Default,,0,0,0,,Бірақ олар жұмыртқа салатын және тірі, солай ма? Жүкті болу мүмкін емес
Dialogue: 0,0:12:47.43,0:12:52.10,Default,,0,0,0,,Тіпті дәрігер мұны керемет деп айтты. Мен оны қолдауым керек.
Dialogue: 0,0:12:52.18,0:12:53.18,Default,,0,0,0,,Джонатанды өлтіру үшін Дио қолданған өлімге әкелетін қабілет.
Dialogue: 0,0:12:53.27,0:12:55.10,Default,,0,0,0,,О, солай…
Dialogue: 0,0:12:55.19,0:12:57.52,Default,,0,0,0,,Босану қаупі де жоғары екеніне сенімдімін.
Dialogue: 0,0:12:58.36,0:13:03.94,Default,,0,0,0,,Ей, қазір отбасын құратын уақыт емес.
Dialogue: 0,0:13:04.57,0:13:09.16,Default,,0,0,0,,Құбыжық болып, қоғамды өзгертейік.
Dialogue: 0,0:13:10.24,0:13:13.29,Default,,0,0,0,,Хм... Мен түсемін.
Dialogue: 0,0:13:14.29,0:13:16.12,Default,,0,0,0,,Тыңдаңыз... Уау.
Dialogue: 0,0:13:16.21,0:13:19.54,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:13:19.63,0:13:24.42,Default,,0,0,0,,Бейбітшілік пен бірге өмір сүру үшін мен сізге және Құбыжықтарға қосылмақ болдым.
Dialogue: 0,0:13:24.51,0:13:28.51,Default,,0,0,0,,Бірақ бірге өмір сүру қоғамнан маңыздырақ.
Dialogue: 0,0:13:28.59,0:13:30.76,Default,,0,0,0,,Мен дәл көз алдымнан таптым.
Dialogue: 0,0:13:32.22,0:13:35.68,Default,,0,0,0,,Сіз мені жалғыз қалдырасыз ба?
Dialogue: 0,0:13:35.77,0:13:37.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:38.31,0:13:39.86,Default,,0,0,0,,Сатқын...!
Dialogue: 0,0:13:48.82,0:13:51.58,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:13:52.62,0:13:55.91,Default,,0,0,0,,Қасқыр оқиғасы туралы есеп.
Dialogue: 0,0:13:56.00,0:13:57.33,Default,,0,0,0,,Қалай болды?
Dialogue: 0,0:13:57.96,0:14:00.38,Default,,0,0,0,,Сіздің ата-анаңыз қазір жоқ сияқты.
Dialogue: 0,0:14:00.46,0:14:04.38,Default,,0,0,0,,Менің атам менің орта мектеп құжаттары бойынша қамқоршым.
Dialogue: 0,0:14:04.46,0:14:08.84,Default,,0,0,0,,Мен сенбеймін, бірақ бұл Комодо айдаһары.
Dialogue: 0,0:14:10.72,0:14:14.14,Default,,0,0,0,,Әлгі қиғаш көздер мен төмен түскен қастар...
Dialogue: 0,0:14:14.77,0:14:16.68,Default,,0,0,0,,Surprisingly similar.
Dialogue: 0,0:14:17.31,0:14:20.15,Default,,0,0,0,,Оны сәбіз кешіне шақырайық.
Dialogue: 0,0:14:20.23,0:14:21.52,Default,,0,0,0,,Мен реттеймін
Dialogue: 0,0:14:26.03,0:14:27.90,Default,,0,0,0,,«Мазасыз нәрсе болып жатыр».
Dialogue: 0,0:14:27.99,0:14:31.37,Default,,0,0,0,,«Саған сұрақ қоюға рұқсат етіңіз, Билл».
Dialogue: 0,0:14:32.28,0:14:33.70,Default,,0,0,0,,Не болды?
Dialogue: 0,0:14:33.78,0:14:35.08,Default,,0,0,0,,Legoshi-kun
Dialogue: 0,0:14:35.62,0:14:36.87,Default,,0,0,0,,Иә
Dialogue: 0,0:14:37.37,0:14:40.17,Default,,0,0,0,,Кайо-санның сізге келетін уақыты келді.
Dialogue: 0,0:14:40.25,0:14:41.29,Default,,0,0,0,,Менің баруым керек деп ойлаймын.
Dialogue: 0,0:14:41.38,0:14:43.59,Default,,0,0,0,,Kaiyou...?
Dialogue: 0,0:14:43.67,0:14:46.63,Default,,0,0,0,,Теңіз өмірінің тұтынушыларына жеткізу.
Dialogue: 0,0:14:46.71,0:14:50.09,Default,,0,0,0,,А... а, ана жақта ма?
Dialogue: 0,0:14:50.18,0:14:51.34,Default,,0,0,0,,Um... eh? Жеткізу?
Dialogue: 0,0:14:51.43,0:14:55.31,Default,,0,0,0,,Бұл дүкеннің ұраны - барлық жарыстарды қабылдау.
Dialogue: 0,0:14:55.39,0:14:57.47,Default,,0,0,0,,«Бұл удон мейрамханасы Бебебе» десеңіз, мен түсінемін.
Dialogue: 0,0:14:57.56,0:15:00.10,Default,,0,0,0,,А... Бірақ бұл теңіз тілі ғой, солай емес пе?
Dialogue: 0,0:15:00.19,0:15:02.27,Default,,0,0,0,,Мен мүлде сөйлей алмаймын.
Dialogue: 0,0:15:02.35,0:15:03.61,Default,,0,0,0,,Легоши-кун
Dialogue: 0,0:15:03.69,0:15:06.82,Default,,0,0,0,,Сіз Черритон академиясына бардыңыз, солай ма?
Dialogue: 0,0:15:06.90,0:15:10.95,Default,,0,0,0,,«Аппупопопи бебебе белоб помпоропу»
Dialogue: 0,0:15:11.03,0:15:12.53,Default,,0,0,0,,Бұл хабарды жеткізеді
Dialogue: 0,0:15:12.62,0:15:14.83,Default,,0,0,0,,А-а... Тағы да.
Dialogue: 0,0:15:14.91,0:15:17.04,Default,,0,0,0,,А... аа... а...
Dialogue: 0,0:15:17.12,0:15:18.91,Default,,0,0,0,,Oh please!
Dialogue: 0,0:15:30.30,0:15:34.09,Default,,0,0,0,,Um... 9 Basin No. 4
Dialogue: 0,0:15:35.22,0:15:36.18,Default,,0,0,0,,Міне, осы жерде.
Dialogue: 0,0:15:39.56,0:15:42.02,Default,,0,0,0,,Сонымен... қоңырауды соғыңыз.
Dialogue: 0,0:15:54.74,0:15:58.62,Default,,0,0,0,,Біздің көзіміз алғаш кездескен кезде «богорабогола»
Dialogue: 0,0:16:03.21,0:16:05.58,Default,,0,0,0,,Уа, ау... ау
Dialogue: 0,0:16:08.25,0:16:10.59,Default,,0,0,0,,Bobo… bogolabogola
Dialogue: 0,0:16:10.67,0:16:13.72,Default,,0,0,0,,Дабебебоби бабубубу…
Dialogue: 0,0:16:13.80,0:16:14.89,Default,,0,0,0,,Bambububebe!
Dialogue: 0,0:16:14.97,0:16:16.85,Default,,0,0,0,,Уау... аа, не істеуім керек... у...
Dialogue: 0,0:16:16.93,0:16:19.39,Default,,0,0,0,,Ах... Уф, бұл Удон мейрамханасы Бебебе.
Dialogue: 0,0:16:19.47,0:16:23.39,Default,,0,0,0,,Сол удон... Удон Удон мен сені алып келдім.
Dialogue: 0,0:16:23.48,0:16:26.86,Default,,0,0,0,,Эй, сен тапсырыс бердің. I got it...
Dialogue: 0,0:16:26.94,0:16:29.57,Default,,0,0,0,,А, ә... ә... тұтынушы...
Dialogue: 0,0:16:29.65,0:16:31.61,Default,,0,0,0,,Ах, хана, хана... өтінемін, мені жіберіңізші.
Dialogue: 0,0:16:31.69,0:16:34.32,Default,,0,0,0,,Ах... Губибибі Бөбе...
Dialogue: 0,0:16:34.41,0:16:36.32,Default,,0,0,0,,Дүрбелең емес
Dialogue: 0,0:16:36.41,0:16:37.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:37.74,0:16:43.00,Default,,0,0,0,,Теңіз тіршіліктері қозғалатын кез келген нәрсені жейді.
Dialogue: 0,0:16:43.08,0:16:48.29,Default,,0,0,0,,Жарайды, тыныш жүр, мен сені жіберемін.
Dialogue: 0,0:16:48.38,0:16:50.88,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:16:50.96,0:16:54.97,Default,,0,0,0,,Мен оны сізге аударамын.
Dialogue: 0,0:16:55.93,0:17:01.93,Default,,0,0,0,,Покоракопо пукку поппи хатан…
Dialogue: 0,0:17:02.02,0:17:05.56,Default,,0,0,0,,Түсіндім, итбалықтар жартылай құрлық, жартылай теңіз жануарлары...
Dialogue: 0,0:17:05.64,0:17:07.10,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:17:07.19,0:17:09.94,Default,,0,0,0,,Қос тілді тіршілік иесі сақтады
Dialogue: 0,0:17:10.02,0:17:12.65,Default,,0,0,0,,Парья Попоп
Dialogue: 0,0:17:12.74,0:17:14.70,Default,,0,0,0,,«Удон жеу»
Dialogue: 0,0:17:15.49,0:17:17.24,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:17:22.49,0:17:24.91,Default,,0,0,0,,Гавгав... Гавгав...
Dialogue: 0,0:17:25.00,0:17:26.79,Default,,0,0,0,,Sursuru…
Dialogue: 0,0:17:27.29,0:17:28.75,Default,,0,0,0,,Фуууууууу!
Dialogue: 0,0:17:28.83,0:17:31.88,Default,,0,0,0,,Хмм? О, есепшот!
Dialogue: 0,0:17:35.38,0:17:39.34,Default,,0,0,0,,Бұл қабықты ақшаға айырбастауға болады.
Dialogue: 0,0:17:39.43,0:17:40.60,Default,,0,0,0,,О... Ақша айырбастау орны?
Dialogue: 0,0:17:40.68,0:17:45.39,Default,,0,0,0,,Теңіз раковиналары Теңіз ақшасының құндылықтары
Dialogue: 0,0:17:45.48,0:17:47.69,Default,,0,0,0,,А, мен оны сабақта білген шығармын.
Dialogue: 0,0:17:49.27,0:17:51.19,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:17:51.98,0:17:53.69,Default,,0,0,0,,Мм... бұл өте пайдалы болды.
Dialogue: 0,0:17:53.78,0:17:58.57,Default,,0,0,0,,I Харбор итбалығының аты Сагван
Dialogue: 0,0:17:59.24,0:18:04.12,Default,,0,0,0,,Бір ғимаратта тұратын адамдар бір-біріне көмектеседі
Dialogue: 0,0:18:04.20,0:18:06.83,Default,,0,0,0,,Не? Корпо хайуан?
Dialogue: 0,0:18:09.63,0:18:11.46,Default,,0,0,0,,Дегенмен, 11 жасыңдағы кезіңмен салыстырғанда бетің біраз өзгерген болар
Dialogue: 0,0:18:12.25,0:18:15.88,Default,,0,0,0,,Алты ай бұрын мен теңізде тұрдым.
Dialogue: 0,0:18:15.96,0:18:21.93,Default,,0,0,0,,Мен қазір университетте теңіз тілінен сабақ бере отырып, жер туралы оқып жатырмын.
Dialogue: 0,0:18:23.51,0:18:27.02,Default,,0,0,0,,Рику Бұл өте жақсы жер.
Dialogue: 0,0:18:27.10,0:18:28.48,Default,,0,0,0,,Маған ұнады...
Dialogue: 0,0:18:28.56,0:18:29.52,Default,,0,0,0,,Ағ...
Dialogue: 0,0:18:29.60,0:18:30.27,Default,,0,0,0,,Бұл не? Сен сонда екенсің ғой.
Dialogue: 0,0:18:30.35,0:18:31.44,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:18:31.52,0:18:34.07,Default,,0,0,0,,Бұлай жүру қауіпті.
Dialogue: 0,0:18:34.15,0:18:35.73,Default,,0,0,0,,Жер қауіпке толы.
Dialogue: 0,0:18:35.82,0:18:39.28,Default,,0,0,0,,Daijob Daijob Теңізге де қатысты.
Dialogue: 0,0:18:39.36,0:18:42.66,Default,,0,0,0,,А... бұл рас болуы мүмкін.
Dialogue: 0,0:18:42.74,0:18:47.33,Default,,0,0,0,,Ал мен өлсем де солай.
Dialogue: 0,0:18:48.46,0:18:49.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:53.25,0:18:58.22,Default,,0,0,0,,Теңіз Ұсақ балық Ірі балықтар жейді
Dialogue: 0,0:18:58.30,0:19:02.01,Default,,0,0,0,,Оны үлкенірек балықтар жейді
Dialogue: 0,0:19:02.09,0:19:04.97,Default,,0,0,0,,Ал балық өледі
Dialogue: 0,0:19:05.06,0:19:09.23,Default,,0,0,0,,Оны ұсақ балықтар мен планктондар жейді.
Dialogue: 0,0:19:11.23,0:19:15.32,Default,,0,0,0,,Теңіз жәндіктері жейді және жейді
Dialogue: 0,0:19:15.40,0:19:20.03,Default,,0,0,0,,Жеңдер, тойыңдар, бәрі байланысты
Dialogue: 0,0:19:20.11,0:19:23.20,Default,,0,0,0,,«Шокусацу» сөзі жоқ
Dialogue: 0,0:19:23.28,0:19:26.62,Default,,0,0,0,,Барлығы бейбіт өмір сүруде.
Dialogue: 0,0:19:27.37,0:19:33.21,Default,,0,0,0,,Тамақ жеп қой, сонда да... тыныш?
Dialogue: 0,0:19:34.13,0:19:34.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:36.21,0:19:40.76,Default,,0,0,0,,Ондай нәрсе... ондай дүние бар ма?
Dialogue: 0,0:19:40.84,0:19:46.60,Default,,0,0,0,,Көрші үйде мен шөпқоректілермен қарым-қатынасым және өз түйсігім туралы көп уайымдадым.
Dialogue: 0,0:19:47.68,0:19:49.73,Default,,0,0,0,,Мұндай дүние...
Dialogue: 0,0:19:53.73,0:19:55.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:55.98,0:20:01.20,Default,,0,0,0,,Менің бөлмем 501 Шай ішейік
Dialogue: 0,0:20:01.28,0:20:04.78,Default,,0,0,0,,Мен де Легоси-санның әңгімесі туралы естігім келеді.
Dialogue: 0,0:20:04.87,0:20:07.20,Default,,0,0,0,,Иә? А... иә
Dialogue: 0,0:20:18.63,0:20:20.84,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:20:21.88,0:20:23.34,Default,,0,0,0,,Мазалағаным үшін кешіріңіз... Уау!
Dialogue: 0,0:20:23.93,0:20:25.43,Default,,0,0,0,,Не болды, Легоши мырза?
Dialogue: 0,0:20:25.51,0:20:28.97,Default,,0,0,0,,А-а, жоқ, ылғи қой... А-а...
Dialogue: 0,0:20:29.06,0:20:30.43,Default,,0,0,0,,Киім киіңіз.
Dialogue: 0,0:20:30.52,0:20:32.98,Default,,0,0,0,,Құрлықтағы... адамдарға жалаңаш денеңді көрсетуге болмайды.
Dialogue: 0,0:20:33.06,0:20:34.73,Default,,0,0,0,,Иә, солай ма?
Dialogue: 0,0:20:35.35,0:20:37.36,Default,,0,0,0,,Олай болса, киініп алайық.
Dialogue: 0,0:20:37.44,0:20:39.69,Default,,0,0,0,,Дөрекі болсам кешіріңіз.
Dialogue: 0,0:20:39.78,0:20:41.57,Default,,0,0,0,,А... жоқ...
Dialogue: 0,0:20:41.65,0:20:42.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:43.61,0:20:47.53,Default,,0,0,0,,Тапуға тыйым салынған, жоққа шығару жақсы емес.
Dialogue: 0,0:20:47.62,0:20:50.91,Default,,0,0,0,,Тар, солай емес пе? Сагван мырза
Dialogue: 0,0:20:50.99,0:20:52.70,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:20:54.29,0:20:59.80,Default,,0,0,0,,Тамақ ішіңіз және жеңіз, бірақ бәрібір тыныш...
Dialogue: 0,0:21:00.38,0:21:01.88,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:21:02.92,0:21:05.97,Default,,0,0,0,,Құрлықта бәрі уайымдайды.
Dialogue: 0,0:21:06.05,0:21:09.10,Default,,0,0,0,,Етқоректілер мен шөпқоректілер бір-бірінен алшақ тұрады...
Dialogue: 0,0:21:09.18,0:21:10.56,Default,,0,0,0,,Легоши мырза
Dialogue: 0,0:21:11.35,0:21:14.06,Default,,0,0,0,,Қорқынышты нәрсе болды ма?
Dialogue: 0,0:21:15.48,0:21:19.52,Default,,0,0,0,,«Ет үшін соттылығы бар қасқыр көшіп келді».
Dialogue: 0,0:21:19.61,0:21:23.32,Default,,0,0,0,,Пәтер туралы қауесет тарады. Бұл сен бе?
Dialogue: 0,0:21:23.94,0:21:25.90,Default,,0,0,0,,Бұл қауесет болды.
Dialogue: 0,0:21:25.99,0:21:30.49,Default,,0,0,0,,Мен де сен сияқты теңізде жыртқышпын.
Dialogue: 0,0:21:31.87,0:21:35.96,Default,,0,0,0,,Теңізде барлығы күнәнің ауыртпалығын арқалап өмір сүреді.
Dialogue: 0,0:21:36.04,0:21:39.29,Default,,0,0,0,,Бұл қиын емес пе?
Dialogue: 0,0:21:39.38,0:21:41.09,Default,,0,0,0,,Бұл қиын емес.
Dialogue: 0,0:21:41.84,0:21:46.84,Default,,0,0,0,,Осыған қарасам мен теңізде қалқып жүргендей боламын.
Dialogue: 0,0:21:46.93,0:21:50.76,Default,,0,0,0,,Біз байланыстырылғандықтан, тепе-теңдікті сақтай аламыз.
Dialogue: 0,0:21:52.43,0:21:54.52,Default,,0,0,0,,Уау...
Dialogue: 0,0:21:55.18,0:21:57.94,Default,,0,0,0,,Мен бұл адаммен бірге болғанда, ол...
Dialogue: 0,0:21:58.60,0:22:01.11,Default,,0,0,0,,Теңіздің өзімен сөйлесіп тұрғандай болдым.
Dialogue: 0,0:22:02.40,0:22:05.32,Default,,0,0,0,,Салмақсыздық сезімі
Dialogue: 0,0:22:06.61,0:22:10.41,Default,,0,0,0,,Маған бұл қарт ұнайды.
Dialogue: 0,0:22:11.99,0:22:13.99,Default,,0,0,0,,♪～
Dialogue: 0,0:23:39.45,0:23:41.46,Default,,0,0,0,,～♪
