Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:28.11,0:00:30.73,Default,,0,0,0,,Кеше Метеорит фестивалінің атқарушы комитетінен
Dialogue: 0,0:00:30.82,0:00:32.65,Default,,0,0,0,,Маған хабарласты
Dialogue: 0,0:00:33.24,0:00:34.86,Default,,0,0,0,,Ал...
Dialogue: 0,0:00:34.95,0:00:39.24,Default,,0,0,0,,«Сахнаны бірінші жартысы мен екінші жартысы, етқоректі және шөпқоректі деп бөлетін спектакль...»
Dialogue: 0,0:00:39.33,0:00:42.91,Default,,0,0,0,,«Биылғы «Бірге өмір сүреміз» тақырыбы қандай?»
Dialogue: 0,0:00:43.00,0:00:45.71,Default,,0,0,0,,«Бұл анық қарама-қайшы».
Dialogue: 0,0:00:46.25,0:00:50.09,Default,,0,0,0,,«Сондықтан сізге биыл қатысуға рұқсат етілмейді».
Dialogue: 0,0:00:50.17,0:00:54.17,Default,,0,0,0,,Неліктен? (2-мүше) Бұл қорқынышты...
Dialogue: 0,0:00:54.26,0:00:56.01,Default,,0,0,0,,Біздің орнымызда
Dialogue: 0,0:00:56.09,0:00:58.60,Default,,0,0,0,,Драма үйірмесінің дәстүрі бітеді дейсіз бе?
Dialogue: 0,0:00:58.68,0:01:01.64,Default,,0,0,0,,Бұл туралы ештеңе істей алмайсыз...?
Dialogue: 0,0:01:01.72,0:01:03.22,Default,,0,0,0,,Сол жігіт… Көзіне латкі таққан Какужа ма?
Dialogue: 0,0:01:03.31,0:01:05.77,Default,,0,0,0,,Эй Билл, сен бұған жарайсың ба?
Dialogue: 0,0:01:05.85,0:01:09.65,Default,,0,0,0,,Луи-сенпаймен бұлай бетпе-бет келуге болмайды.
Dialogue: 0,0:01:09.73,0:01:10.65,Default,,0,0,0,,Иә.
Dialogue: 0,0:01:10.73,0:01:13.40,Default,,0,0,0,,Тоқта, бұл Биллдің кінәсі емес.
Dialogue: 0,0:01:13.49,0:01:17.16,Default,,0,0,0,,(Клуб мүшелерінің шулы дауыстары)
Dialogue: 0,0:01:17.24,0:01:20.28,Default,,0,0,0,,Бұл! Жарайды деп ойлаймын
Dialogue: 0,0:01:22.87,0:01:23.83,Default,,0,0,0,,...
Dialogue: 0,0:01:25.37,0:01:29.29,Default,,0,0,0,,Мүмкін біз қателескен шығармыз
Dialogue: 0,0:01:29.38,0:01:30.79,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:01:30.88,0:01:32.67,Default,,0,0,0,,Сіз дауыс бердіңіз, солай ма?
Dialogue: 0,0:01:32.75,0:01:37.18,Default,,0,0,0,,Етқоректілер мен шөпқоректілерді ажырату керек пе, әлде белсенділіктерін тоқтату керек пе?
Dialogue: 0,0:01:38.13,0:01:39.34,Default,,0,0,0,,О
Dialogue: 0,0:01:39.43,0:01:43.72,Default,,0,0,0,,Нәтижесінде, бірге өмір сүруге және бірге гүлденуге ұмтылуды ұмытпаңыз.
Dialogue: 0,0:01:43.81,0:01:48.48,Default,,0,0,0,,Біз бәріміз бөлек болсақ та өз іс-әрекетімізді жалғастыруды таңдадық.
Dialogue: 0,0:01:49.06,0:01:50.15,Default,,0,0,0,,Осылайша,
Dialogue: 0,0:01:50.23,0:01:53.23,Default,,0,0,0,,Біздің әрекеттеріміз бөлімдермен бөлінбейді.
Dialogue: 0,0:01:53.32,0:01:54.28,Default,,0,0,0,,Бірақ—
Dialogue: 0,0:01:54.36,0:01:59.24,Default,,0,0,0,,Метеорит фестивалі өтетін жерде жыртқыштар мен шөпқоректілерді бөлетін қабырға бар ма?
Dialogue: 0,0:01:59.32,0:02:02.24,Default,,0,0,0,,Ересек қоғамда мұндай нәрсе жоқ.
Dialogue: 0,0:02:02.33,0:02:04.29,Default,,0,0,0,,Сонда неге мектеп?
Dialogue: 0,0:02:04.37,0:02:07.04,Default,,0,0,0,,Бөлініп, бірігіп жұмыс жасайық дейсіз бе?
Dialogue: 0,0:02:07.75,0:02:12.04,Default,,0,0,0,,Өйткені мектеп бұдан былай тәуекелге барғысы келмейді.
Dialogue: 0,0:02:13.09,0:02:14.38,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:02:14.96,0:02:16.92,Default,,0,0,0,,Біз жақсы білеміз.
Dialogue: 0,0:02:20.34,0:02:24.93,Default,,0,0,0,,Бұл қолмен не болғаны бәрінің есінде, солай ма?
Dialogue: 0,0:02:25.52,0:02:26.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:28.23,0:02:29.31,Default,,0,0,0,,Сол кезде —
Dialogue: 0,0:02:29.94,0:02:32.77,Default,,0,0,0,,Мен драма үйірмесі мен мектептен шығуды ойладым.
Dialogue: 0,0:02:33.52,0:02:35.44,Default,,0,0,0,,Жыртқыштарға қарап
Dialogue: 0,0:02:35.53,0:02:38.70,Default,,0,0,0,,Денем қатайып, тынысым тоқтап қалғандай болды.
Dialogue: 0,0:02:41.03,0:02:43.41,Default,,0,0,0,,Қолды қосу операциясынан кейін
Dialogue: 0,0:02:44.45,0:02:48.71,Default,,0,0,0,,Мен төсекте осылай қолыма қадала қарадым.
Dialogue: 0,0:02:49.79,0:02:53.33,Default,,0,0,0,,Терезеден жарық түсіп, жел соғады
Dialogue: 0,0:02:53.42,0:02:57.42,Default,,0,0,0,,Бірте-бірте өз қолыңмен сезінетін боласың.
Dialogue: 0,0:02:58.67,0:03:02.39,Default,,0,0,0,,Мен тезірек бір нәрсеге қол тигізгім келеді деп ойлай бастадым.
Dialogue: 0,0:03:03.47,0:03:06.14,Default,,0,0,0,,Бірінші қол тигізгім келгені...
Dialogue: 0,0:03:07.72,0:03:09.18,Default,,0,0,0,,Бұл Дао болды
Dialogue: 0,0:03:10.81,0:03:14.69,Default,,0,0,0,,Мен де сені жақсы көремін, мен оңай ауыратын дене емеспін.
Dialogue: 0,0:03:14.77,0:03:17.44,Default,,0,0,0,,Таомен де солай.
Dialogue: 0,0:03:17.53,0:03:18.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:19.32,0:03:23.36,Default,,0,0,0,,Мен оған қонаққа барғанымда, ол маған тиісуімді өтінді...
Dialogue: 0,0:03:25.74,0:03:27.08,Default,,0,0,0,,Көз жасы шықты
Dialogue: 0,0:03:28.58,0:03:33.00,Default,,0,0,0,,Ең көп қиналған мен болсам да, Киби тіпті менің сезімімді ойлады.
Dialogue: 0,0:03:34.33,0:03:38.09,Default,,0,0,0,,Тары арамыздағы қабырғаны алып тастады.
Dialogue: 0,0:03:38.17,0:03:39.80,Default,,0,0,0,,Хехе
Dialogue: 0,0:03:39.88,0:03:44.01,Default,,0,0,0,,Себебі мен Таоны білетінмін.
Dialogue: 0,0:03:44.09,0:03:47.39,Default,,0,0,0,,Өйткені біз клуб мүшелері ретінде әрқашан бірге болдық.
Dialogue: 0,0:03:54.65,0:03:57.15,Default,,0,0,0,,Әрине, біз қателестік.
Dialogue: 0,0:03:57.23,0:03:59.36,Default,,0,0,0,,Мектеп нұсқауларын орындау дұрыс болмады
Dialogue: 0,0:03:59.44,0:04:00.19,Default,,0,0,0,,Эй
Dialogue: 0,0:04:00.28,0:04:03.99,Default,,0,0,0,,Қабырғалармен бөліңіз және қарамаңыз және ұстамаңыз
Dialogue: 0,0:04:04.07,0:04:07.45,Default,,0,0,0,,Бұл жеңілдік болуы мүмкін, бірақ мен үшін!
Dialogue: 0,0:04:07.53,0:04:11.29,Default,,0,0,0,,Өйткені біз етқоректілер мен шөпқоректілер мәселесін бастан кешірдік.
Dialogue: 0,0:04:11.37,0:04:13.92,Default,,0,0,0,,Мен айта алатын нәрселер бар деп ойлаймын.
Dialogue: 0,0:04:14.00,0:04:16.42,Default,,0,0,0,,Жоқ, мен осылай дедім...
Dialogue: 0,0:04:16.50,0:04:19.50,Default,,0,0,0,,Етқоректілер мен шөпқоректілердің қатысуымен бірлескен клубтық іс-шараларға рұқсат етілмейді, солай ма?
Dialogue: 0,0:04:19.59,0:04:21.51,Default,,0,0,0,,...
Dialogue: 0,0:04:21.59,0:04:24.88,Default,,0,0,0,,Біз әрқашан қиындықтарды жеңдік.
Dialogue: 0,0:04:24.97,0:04:28.22,Default,,0,0,0,,Өткен жылы метеорит фестивалі өткеніне сенімдімін...
Dialogue: 0,0:04:28.30,0:04:32.35,Default,,0,0,0,,Луи-сенпай кенет жоғалып кетті, сондықтан мен одан бас тарту мүмкін емес деп ойладым.
Dialogue: 0,0:04:32.43,0:04:34.60,Default,,0,0,0,,Сол кезде мен үшін Джуно ұйымдастырды.
Dialogue: 0,0:04:34.69,0:04:37.31,Default,,0,0,0,,Себебі барлығы бірге жұмыс істеді.
Dialogue: 0,0:04:37.40,0:04:39.69,Default,,0,0,0,,Ақыр соңында, бұл солай.
Dialogue: 0,0:04:39.77,0:04:42.57,Default,,0,0,0,,Бәріміз бірге болғандықтан, қолымыздан келгеннің бәрін жасай алдық.
Dialogue: 0,0:04:42.65,0:04:45.57,Default,,0,0,0,,Иә, әртүрлі нәсілдердің орны әртүрлі.
Dialogue: 0,0:04:45.66,0:04:48.83,Default,,0,0,0,,Сонда да бірге жұмыс істеудің мәні бар...
Dialogue: 0,0:04:48.91,0:04:50.16,Default,,0,0,0,,Біз бір-бірімізді жақсы білеміз.
Dialogue: 0,0:04:50.87,0:04:53.25,Default,,0,0,0,,Сахнаны бірге жасай аламыз ба?
Dialogue: 0,0:04:53.33,0:04:54.33,Default,,0,0,0,,Иә
Dialogue: 0,0:04:54.41,0:04:58.13,Default,,0,0,0,,Актерлер, дыбыс, жарық, реквизиттер
Dialogue: 0,0:04:58.21,0:05:01.34,Default,,0,0,0,,Әркім өз рөлдерін дұрыс орындауды жалғастырса,
Dialogue: 0,0:05:01.42,0:05:04.88,Default,,0,0,0,,Менің ойымша, сіз осындай қабырғамен де сахна жасай аласыз.
Dialogue: 0,0:05:05.93,0:05:10.10,Default,,0,0,0,,Шынында да, егер солай болса, мен тіпті Метеорит фестиваліне қатыса аламын.
Dialogue: 0,0:05:10.18,0:05:11.47,Default,,0,0,0,,Сәлем Элс
Dialogue: 0,0:05:12.06,0:05:14.64,Default,,0,0,0,,Комитетпен тағы сөйлесейік!
Dialogue: 0,0:05:14.73,0:05:15.31,Default,,0,0,0,,Мектепте де!
Dialogue: 0,0:05:15.39,0:05:16.56,Default,,0,0,0,,Жоқ, бірақ...
Dialogue: 0,0:05:16.64,0:05:17.69,Default,,0,0,0,,Сәлем Билл!
Dialogue: 0,0:05:17.77,0:05:20.61,Default,,0,0,0,,Өзіңізге көбірек ұқсаңыз, а?
Dialogue: 0,0:05:20.69,0:05:24.49,Default,,0,0,0,,Неліктен Луи-сенпай сізді менеджер етіп таңдады?
Dialogue: 0,0:05:24.57,0:05:27.03,Default,,0,0,0,,Дұрыс, Билл не істегісі келеді?
Dialogue: 0,0:05:29.03,0:05:31.37,Default,,0,0,0,,О, мен...
Dialogue: 0,0:05:32.83,0:05:35.25,Default,,0,0,0,,А... дұрыс!
Dialogue: 0,0:05:35.33,0:05:37.21,Default,,0,0,0,,Мектеппен келіссөздерді өзіңізге қалдырыңыз!
Dialogue: 0,0:05:37.29,0:05:39.63,Default,,0,0,0,,Билл күткендей!
Dialogue: 0,0:05:39.71,0:05:42.05,Default,,0,0,0,,Жарайды, мен де барамын!
Dialogue: 0,0:05:42.13,0:05:44.38,Default,,0,0,0,,Әкем жарылмайтын жаңғақ жоқ деді!
Dialogue: 0,0:05:44.96,0:05:46.51,Default,,0,0,0,,Өзім жаңғақ жармасам да
Dialogue: 0,0:05:46.59,0:05:49.05,Default,,0,0,0,,Мен өзгеремін! Маған қара
Dialogue: 0,0:06:01.81,0:06:06.61,Default,,0,0,0,,А... міне?
Dialogue: 0,0:06:23.50,0:06:26.80,Default,,0,0,0,,Сіз жолақты көрдіңіз бе?
Dialogue: 0,0:06:26.88,0:06:28.76,Default,,0,0,0,,№.
Dialogue: 0,0:06:28.84,0:06:32.05,Default,,0,0,0,,Тәбет пен жыныстық құштарлық бір уақытта қанағаттандырылады
Dialogue: 0,0:06:32.14,0:06:34.72,Default,,0,0,0,,Етқоректілерге ыңғайлы шоу
Dialogue: 0,0:06:34.81,0:06:37.10,Default,,0,0,0,,Сіз оны көру үшін қоңырау шалдыңыз ба?
Dialogue: 0,0:06:37.18,0:06:40.44,Default,,0,0,0,,Бұл дүкенде танымал биші бар.
Dialogue: 0,0:06:42.48,0:06:44.15,Default,,0,0,0,,Бұл окапи
Dialogue: 0,0:06:44.23,0:06:46.57,Default,,0,0,0,,Шөпқоректілер жер асты базарында жұмыс істей ме?
Dialogue: 0,0:06:46.65,0:06:51.07,Default,,0,0,0,,Ол Мелон ұйымдастырған бетперде киген кеште билеп жатыр.
Dialogue: 0,0:06:51.16,0:06:52.12,Default,,0,0,0,,Сіз—
Dialogue: 0,0:06:52.20,0:06:55.33,Default,,0,0,0,,Оның қызметшісі Харуо ретінде ішке кіріңіз.
Dialogue: 0,0:06:55.41,0:06:57.70,Default,,0,0,0,,А... неге бұл атау?
Dialogue: 0,0:06:57.79,0:07:00.46,Default,,0,0,0,,Қауын - 20-30 жас аралығындағы еркек
Dialogue: 0,0:07:01.17,0:07:06.25,Default,,0,0,0,,Бетінің жоғарғы жартысы қарақұйрық, ал төменгі жартысы барыс араласқан.
Dialogue: 0,0:07:06.34,0:07:09.47,Default,,0,0,0,,Бірақ бетперде киіп жүрсеңіз, айта алмайсыз, солай ма?
Dialogue: 0,0:07:09.55,0:07:11.76,Default,,0,0,0,,Мен оны табамын
Dialogue: 0,0:07:11.84,0:07:14.05,Default,,0,0,0,,Сіз оны ұстайсыз.
Dialogue: 0,0:07:14.76,0:07:18.35,Default,,0,0,0,,Маған Гухин үйреткен әдіс-тәсілдерді көрсетіңіз.
Dialogue: 0,0:07:18.85,0:07:21.52,Default,,0,0,0,,Сіз мен туралы бәрін білесіз.
Dialogue: 0,0:07:21.60,0:07:24.02,Default,,0,0,0,,Каннибализмге дейінгі кезең
Dialogue: 0,0:07:24.11,0:07:26.86,Default,,0,0,0,,Мен бұл соттылықты да өшіремін.
Dialogue: 0,0:07:26.94,0:07:27.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:27.94,0:07:31.32,Default,,0,0,0,,Қоян Харуға үйленгіңіз келеді, солай ма?
Dialogue: 0,0:07:31.40,0:07:32.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:33.07,0:07:34.62,Default,,0,0,0,,Өткізілетін жерде кездескенше.
Dialogue: 0,0:07:34.70,0:07:36.49,Default,,0,0,0,,Иә? Сіз бірге емессіз бе?
Dialogue: 0,0:07:36.58,0:07:37.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:40.00,0:07:42.46,Default,,0,0,0,,А-а-а...
Dialogue: 0,0:07:44.04,0:07:45.88,Default,,0,0,0,,Енді менің дауысымды естисіз
Dialogue: 0,0:07:45.96,0:07:47.46,Default,,0,0,0,,Мен... га...
Dialogue: 0,0:07:48.21,0:07:49.34,Default,,0,0,0,,Му!
Dialogue: 0,0:07:51.13,0:07:52.63,Default,,0,0,0,,Сіз Харусыз ба?
Dialogue: 0,0:07:53.22,0:07:53.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:54.64,0:07:55.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:55.89,0:07:57.10,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:07:57.18,0:07:59.72,Default,,0,0,0,,О, таң қаларлықтай, сіз өте байсалдысыз.
Dialogue: 0,0:07:59.81,0:08:00.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:00.68,0:08:03.81,Default,,0,0,0,,Легоши-кун, сен ше?
Dialogue: 0,0:08:03.90,0:08:07.19,Default,,0,0,0,,Күдікті ересектер кешіне қызығушылық танытады.
Dialogue: 0,0:08:07.27,0:08:10.15,Default,,0,0,0,,Рич Бонбон ретінде енгізілген
Dialogue: 0,0:08:10.23,0:08:13.20,Default,,0,0,0,,Жақсы әрекет ет, Драма клубы.
Dialogue: 0,0:08:13.28,0:08:14.49,Default,,0,0,0,,Мен жарықтандыруға жауаптымын.
Dialogue: 0,0:08:14.57,0:08:15.57,Default,,0,0,0,,Дауысыңызды көтермеңіз
Dialogue: 0,0:08:15.66,0:08:16.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:17.12,0:08:19.49,Default,,0,0,0,,Тергеу туралы ешқашан айтпаңыз.
Dialogue: 0,0:08:19.58,0:08:21.87,Default,,0,0,0,,Олар да тәуекелге ұшырайды
Dialogue: 0,0:08:21.95,0:08:23.37,Default,,0,0,0,,Менің орныма қарашы
Dialogue: 0,0:08:24.62,0:08:26.88,Default,,0,0,0,,Оны өтетін жерге келгенде киіңіз.
Dialogue: 0,0:08:27.54,0:08:29.67,Default,,0,0,0,,-Кеттік -А, иә.
Dialogue: 0,0:08:30.71,0:08:33.47,Default,,0,0,0,,Сәл күте тұрыңыз, әпке!
Dialogue: 0,0:08:40.93,0:08:42.56,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:44.39,0:08:46.15,Default,,0,0,0,,Ол Луна
Dialogue: 0,0:08:46.23,0:08:48.77,Default,,0,0,0,,Танысқаныма қуаныштымын, әпке.
Dialogue: 0,0:08:48.86,0:08:52.32,Default,,0,0,0,,Тек менеджер сияқты тыныш болыңыз.
Dialogue: 0,0:08:52.40,0:08:55.40,Default,,0,0,0,,Жарайды, біз неге бортқа отырмасқа?
Dialogue: 0,0:09:01.08,0:09:04.37,Default,,0,0,0,,Харуо-кун, мен бүгін кешті тамашалаймын, жарай ма?
Dialogue: 0,0:09:04.46,0:09:07.88,Default,,0,0,0,,Иә, мен білемін. Атақты адамдар келе ме?
Dialogue: 0,0:09:07.96,0:09:10.04,Default,,0,0,0,,Клиенттерді аңдуға болмайды
Dialogue: 0,0:09:10.13,0:09:12.55,Default,,0,0,0,,Өйткені бұл жоғарғы таптың құпия кеші.
Dialogue: 0,0:09:12.63,0:09:14.88,Default,,0,0,0,,Ережені бұзсаңыз, сізді алып кетеді.
Dialogue: 0,0:09:14.97,0:09:16.30,Default,,0,0,0,,Бұл өте қызық, солай емес пе?
Dialogue: 0,0:09:16.38,0:09:18.97,Default,,0,0,0,,Оны сипаттау үшін көңіл көтеру жеткіліксіз.
Dialogue: 0,0:09:19.05,0:09:21.60,Default,,0,0,0,,Мен сізге бір нәрсені айтайын.
Dialogue: 0,0:09:21.68,0:09:24.35,Default,,0,0,0,,Қызыл шырынды ішпеңіз
Dialogue: 0,0:09:24.43,0:09:27.19,Default,,0,0,0,,Сен сияқты әлсіз адам тез тығылып қалады.
Dialogue: 0,0:09:27.27,0:09:28.69,Default,,0,0,0,,Сіз конча аласыз ба?
Dialogue: 0,0:09:28.77,0:09:31.23,Default,,0,0,0,,Сіздің қалауыңыз сізді жетелесін
Dialogue: 0,0:09:31.32,0:09:35.07,Default,,0,0,0,,Бұл шикі етті жегіңіз келе ме?
Dialogue: 0,0:09:35.15,0:09:38.41,Default,,0,0,0,,үшінңыз бұл кезеңнен бұрыннан өттіңіз бе?
Dialogue: 0,0:09:39.24,0:09:42.33,Default,,0,0,0,,Жыртқыштардың ет жеуге құштарлығы басылады.
Dialogue: 0,0:09:42.41,0:09:45.29,Default,,0,0,0,,Шөпқоректілердің сақтығы төмендейді
Dialogue: 0,0:09:45.91,0:09:51.42,Default,,0,0,0,,Етқоректілер мен шөпқоректілерді бір-бірінен ажыратпай, теңдей көру қызық.
Dialogue: 0,0:09:51.50,0:09:54.51,Default,,0,0,0,,Үстірт қоғамның ережелері мен байланыстарынан құтылу.
Dialogue: 0,0:09:55.09,0:09:57.09,Default,,0,0,0,,Идеал бірге өмір сүру
Dialogue: 0,0:09:57.93,0:09:58.97,Default,,0,0,0,,Бірақ—
Dialogue: 0,0:09:59.05,0:10:03.01,Default,,0,0,0,,Құштарлық ет жеуден де қорқынышты болатын кездер болады.
Dialogue: 0,0:10:03.10,0:10:04.52,Default,,0,0,0,,- Иә? -Хехе...
Dialogue: 0,0:10:04.60,0:10:07.23,Default,,0,0,0,,Біреу із-түссіз жоғалып кететін сияқты.
Dialogue: 0,0:10:07.31,0:10:09.48,Default,,0,0,0,,Ах... иә...
Dialogue: 0,0:10:09.56,0:10:12.90,Default,,0,0,0,,Бұл шырын кездейсоқ есірткі ме?
Dialogue: 0,0:10:12.98,0:10:16.90,Default,,0,0,0,,Жарайды, маған жақындама.
Dialogue: 0,0:10:16.99,0:10:19.20,Default,,0,0,0,,Оны жабыңыз және тыныш болыңыз.
Dialogue: 0,0:10:19.28,0:10:20.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:34.67,0:10:36.01,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:10:36.09,0:10:37.34,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:10:40.30,0:10:41.84,Default,,0,0,0,,Ах~
Dialogue: 0,0:10:41.93,0:10:45.85,Default,,0,0,0,,Менің көру аймағым тар, естімеймін.
Dialogue: 0,0:10:47.98,0:10:49.73,Default,,0,0,0,,Аа, еңбегіңіз үшін рахмет.
Dialogue: 0,0:10:51.02,0:10:52.44,Default,,0,0,0,,Хе-хе, рақмет
Dialogue: 0,0:10:53.44,0:10:56.23,Default,,0,0,0,,Жаңа қызметші Харуо
Dialogue: 0,0:10:56.32,0:10:57.15,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:57.86,0:10:59.40,Default,,0,0,0,,Құпия сөзді айтыңыз
Dialogue: 0,0:10:59.49,0:11:00.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:01.16,0:11:01.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:02.49,0:11:04.41,Default,,0,0,0,,Бегемоттың терісі қандай?
Dialogue: 0,0:11:05.03,0:11:06.58,Default,,0,0,0,,Бегемот терісі?
Dialogue: 0,0:11:07.66,0:11:11.42,Default,,0,0,0,,Мен тыңдамаймын! Сондай-ақ!
Dialogue: 0,0:11:15.38,0:11:16.71,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:11:32.35,0:11:35.02,Default,,0,0,0,,Қауын әрқашан осында
Dialogue: 0,0:11:35.77,0:11:39.94,Default,,0,0,0,,Газель мүйізі Шөпқоректілерге тән жіңішке дене
Dialogue: 0,0:11:40.03,0:11:42.53,Default,,0,0,0,,Мысықтың иілген арқа бұлшықеттері
Dialogue: 0,0:11:43.11,0:11:45.12,Default,,0,0,0,,Бұл аздап қытық.
Dialogue: 0,0:11:45.20,0:11:46.74,Default,,0,0,0,,Сіз оны жек көрмейсіз, солай ма?
Dialogue: 0,0:11:46.83,0:11:47.83,Default,,0,0,0,,Жаман болма
Dialogue: 0,0:11:47.91,0:11:49.29,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:11:50.41,0:11:51.62,Default,,0,0,0,,Әдемі кеуде пішіні
Dialogue: 0,0:11:51.71,0:11:53.42,Default,,0,0,0,,Мо, мен де қайтарамын.
Dialogue: 0,0:11:56.29,0:11:59.51,Default,,0,0,0,,Бұлардың арасынан оны қалай табуға болады?
Dialogue: 0,0:11:59.59,0:12:01.30,Default,,0,0,0,,Легоси-кун, сен мені естисің бе?
Dialogue: 0,0:12:02.05,0:12:03.88,Default,,0,0,0,,Иә, мен оны естимін.
Dialogue: 0,0:12:03.97,0:12:06.68,Default,,0,0,0,,Алдымен маған құпия сөзді айтыңыз.
Dialogue: 0,0:12:07.56,0:12:10.14,Default,,0,0,0,,«Гиппоның терісі сезімтал»
Dialogue: 0,0:12:10.22,0:12:10.98,Default,,0,0,0,,Мен айттым ғой, солай ма?
Dialogue: 0,0:12:11.06,0:12:12.52,Default,,0,0,0,,Жоқ, мен тыңдамаймын!
Dialogue: 0,0:12:12.60,0:12:13.85,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:13.94,0:12:16.23,Default,,0,0,0,,Сіз Лунаның билеп жатқанын көресіз бе?
Dialogue: 0,0:12:17.86,0:12:18.86,Default,,0,0,0,,Иә
Dialogue: 0,0:12:19.44,0:12:22.57,Default,,0,0,0,,Фондағы мүйізді ер адам
Dialogue: 0,0:12:23.90,0:12:25.07,Default,,0,0,0,,Иә
Dialogue: 0,0:12:25.70,0:12:26.49,Default,,0,0,0,,Содан кейін—
Dialogue: 0,0:12:26.57,0:12:29.79,Default,,0,0,0,,Сахна алдында бір-бірін құшақтап тұрған жұп
Dialogue: 0,0:12:30.66,0:12:31.41,Default,,0,0,0,,Иә
Dialogue: 0,0:12:31.50,0:12:32.50,Default,,0,0,0,,Тағы бір
Dialogue: 0,0:12:32.58,0:12:35.75,Default,,0,0,0,,Есептегіштің соңында отырған
Dialogue: 0,0:12:36.50,0:12:37.63,Default,,0,0,0,,Иә
Dialogue: 0,0:12:37.71,0:12:40.88,Default,,0,0,0,,Қауын осы үшеуінің ішінде.
Dialogue: 0,0:12:40.96,0:12:42.88,Default,,0,0,0,,Мен қалай тексеремін?
Dialogue: 0,0:12:42.97,0:12:44.59,Default,,0,0,0,,Маскаңызды шешіңіз...
Dialogue: 0,0:12:44.68,0:12:45.84,Default,,0,0,0,,Сонымен қалай тексеруге болады...
Dialogue: 0,0:12:45.93,0:12:47.43,Default,,0,0,0,,Керемет жігіт
Dialogue: 0,0:12:47.51,0:12:48.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:48.43,0:12:50.77,Default,,0,0,0,,Екеуің неге жалғыз ойнамайсыңдар?
Dialogue: 0,0:12:50.85,0:12:54.39,Default,,0,0,0,,-А, а, а... -(3-әйел) Эй, эй, сәл күте тұрыңыз...
Dialogue: 0,0:12:56.10,0:12:57.48,Default,,0,0,0,,Сәлем! Легоши!
Dialogue: 0,0:12:57.56,0:13:00.19,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:13:00.27,0:13:02.61,Default,,0,0,0,,Қарғыс атсын... қазірдің өзінде...
Dialogue: 0,0:13:06.49,0:13:11.74,Default,,0,0,0,,Беастардың бөлмесі әкімдіктен жоғары болуы мүмкін емес.
Dialogue: 0,0:13:11.83,0:13:12.83,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:13:13.66,0:13:18.13,Default,,0,0,0,,Соңғы уақытта жастарды өлтіру оқиғалары жиілеп барады.
Dialogue: 0,0:13:18.88,0:13:21.92,Default,,0,0,0,,Horns Pharmaceuticals ингибиторы —
Dialogue: 0,0:13:22.00,0:13:23.92,Default,,0,0,0,,Бұл жұмыс істемейтін сияқты.
Dialogue: 0,0:13:24.63,0:13:27.72,Default,,0,0,0,,Үкіметтен субсидия алсам да.
Dialogue: 0,0:13:27.80,0:13:29.76,Default,,0,0,0,,Оқиғаның бәрі осы ма?
Dialogue: 0,0:13:30.35,0:13:33.77,Default,,0,0,0,,Сіз білесіз бе? Артқы нарық дегеніміз не?
Dialogue: 0,0:13:33.85,0:13:35.52,Default,,0,0,0,,Ересек жыртқыштар
Dialogue: 0,0:13:35.60,0:13:39.61,Default,,0,0,0,,Тәндік нәпсіні қанағаттандыру үшін жасырын барамын.
Dialogue: 0,0:13:40.48,0:13:42.82,Default,,0,0,0,,Бұл қорқынышты жер.
Dialogue: 0,0:13:42.90,0:13:45.03,Default,,0,0,0,,Артқы базарда сатылатын ет
Dialogue: 0,0:13:45.11,0:13:48.41,Default,,0,0,0,,Ол жазатайым жағдайдан немесе аурудан қайтыс болды дейді.
Dialogue: 0,0:13:49.16,0:13:50.70,Default,,0,0,0,,Бірақ эй...
Dialogue: 0,0:13:52.33,0:13:54.62,Default,,0,0,0,,Ертеде оны тірі жем деп атаған.
Dialogue: 0,0:13:54.70,0:13:58.21,Default,,0,0,0,,Тірі балалар жасырын түрде сатылды.
Dialogue: 0,0:13:59.21,0:14:03.00,Default,,0,0,0,,Бұл жерде сатып алу және сату жазбалары сақталады.
Dialogue: 0,0:14:03.09,0:14:05.30,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:14:05.38,0:14:10.30,Default,,0,0,0,,Тірі ет сатып алатындар тек жыртқыштар емес.
Dialogue: 0,0:14:10.39,0:14:12.72,Default,,0,0,0,,Мұнда қараңыз.
Dialogue: 0,0:14:13.81,0:14:16.56,Default,,0,0,0,,Мына сүйкімді бұғы баласын шөпқоректі бұғы алып кеткен.
Dialogue: 0,0:14:16.64,0:14:19.56,Default,,0,0,0,,Мен оны сатып алу үшін көп ақша жұмсап жатырмын.
Dialogue: 0,0:14:20.19,0:14:22.65,Default,,0,0,0,,Сіз оны жедіңіз бе?
Dialogue: 0,0:14:25.28,0:14:30.66,Default,,0,0,0,,Бұл 15 жыл бұрын болған, сондықтан ол тірі болса, 18 жаста болар еді.
Dialogue: 0,0:14:31.57,0:14:34.45,Default,,0,0,0,,Мен отаку Луидің сыныптасымын.
Dialogue: 0,0:14:36.87,0:14:38.29,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:14:38.37,0:14:41.29,Default,,0,0,0,,Артқы базарда жекпе-жек клубы да бар.
Dialogue: 0,0:14:41.92,0:14:44.80,Default,,0,0,0,,Сондай-ақ Кю есімді танымал қоян бар.
Dialogue: 0,0:14:44.88,0:14:47.59,Default,,0,0,0,,Олар бір тірі жем нарығынан аман қалды.
Dialogue: 0,0:14:48.47,0:14:51.14,Default,,0,0,0,,Мүмкін ол есіне түсіреді.
Dialogue: 0,0:14:51.22,0:14:52.64,Default,,0,0,0,,Бұғы баласы
Dialogue: 0,0:14:55.18,0:14:59.81,Default,,0,0,0,,Мен бұл дәптерді мерзімім біткен соң ұсақтап алуды жоспарлап отырмын.
Dialogue: 0,0:15:00.39,0:15:02.31,Default,,0,0,0,,Бұл өткеннің жәдігері.
Dialogue: 0,0:15:03.19,0:15:04.65,Default,,0,0,0,,Қандай талаптар қойылады?
Dialogue: 0,0:15:04.73,0:15:05.77,Default,,0,0,0,,Іс жүзінде—
Dialogue: 0,0:15:05.86,0:15:11.41,Default,,0,0,0,,Мен Horns конгломератының президентінен бір нәрсе сұрай аламын.
Dialogue: 0,0:15:12.95,0:15:15.58,Default,,0,0,0,,(Екі мысық сырласады)
Dialogue: 0,0:15:15.66,0:15:17.95,Default,,0,0,0,,Хехе, жоқ!
Dialogue: 0,0:15:18.04,0:15:18.87,Default,,0,0,0,,Хехехе
Dialogue: 0,0:15:22.42,0:15:24.88,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:15:25.38,0:15:26.00,Default,,0,0,0,,Уф
Dialogue: 0,0:15:26.09,0:15:28.30,Default,,0,0,0,,Жоқ дедіңіз, солай ма?
Dialogue: 0,0:15:28.38,0:15:29.67,Default,,0,0,0,,Мен жай ғана қарап тұрдым.
Dialogue: 0,0:15:29.76,0:15:32.34,Default,,0,0,0,,Балалық сылтау айтпа.
Dialogue: 0,0:15:32.43,0:15:33.30,Default,,0,0,0,,Иә
Dialogue: 0,0:15:34.64,0:15:36.26,Default,,0,0,0,,Ах~
Dialogue: 0,0:15:36.35,0:15:38.10,Default,,0,0,0,,Шөпқоректілер әдемі ғой...
Dialogue: 0,0:15:38.18,0:15:38.97,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:15:39.06,0:15:42.27,Default,,0,0,0,,Неге сонша қуандыңыз? Сіздің маскаңыз бұлыңғыр.
Dialogue: 0,0:15:42.35,0:15:43.60,Default,,0,0,0,,Бұл емес...
Dialogue: 0,0:15:45.52,0:15:46.65,Default,,0,0,0,,(Легошидің күрсінуі)
Dialogue: 0,0:15:47.94,0:15:50.07,Default,,0,0,0,,Тыныс алу қиын, мен өлетіндей боламын
Dialogue: 0,0:15:50.15,0:15:50.99,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:15:51.07,0:15:52.74,Default,,0,0,0,,Айналаңызды көру қиын
Dialogue: 0,0:15:53.28,0:15:55.03,Default,,0,0,0,,Неліктен тез бұлтты болады?
Dialogue: 0,0:15:57.49,0:16:00.25,Default,,0,0,0,,Мүйізді маска киген жыртқыш —
Dialogue: 0,0:16:00.33,0:16:02.83,Default,,0,0,0,,Өзіңді шөпқоректі ретінде көрсетуге болады, бірақ
Dialogue: 0,0:16:02.92,0:16:06.42,Default,,0,0,0,,Шөпқоректілер мүйіздерін алып тастай алмайды.
Dialogue: 0,0:16:06.50,0:16:09.96,Default,,0,0,0,,Бұл әділетсіздік деп ойламайсыз ба? бұл ереже
Dialogue: 0,0:16:10.05,0:16:11.05,Default,,0,0,0,,Е...
Dialogue: 0,0:16:11.13,0:16:13.26,Default,,0,0,0,,А... Маған бәрібір. Маған бәрі бір!
Dialogue: 0,0:16:13.34,0:16:15.43,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:16:17.60,0:16:18.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:21.14,0:16:22.60,Default,,0,0,0,,Мен бұны шешемін.
Dialogue: 0,0:16:24.27,0:16:25.48,Default,,0,0,0,,Міне!
Dialogue: 0,0:16:34.15,0:16:35.45,Default,,0,0,0,,Бұл қауын
Dialogue: 0,0:16:35.53,0:16:36.78,Default,,0,0,0,,(Легошидің ауыр тыныс алуы)
Dialogue: 0,0:16:46.04,0:16:50.05,Default,,0,0,0,,Қандай серпімді және әдемі
Dialogue: 0,0:17:01.89,0:17:04.64,Default,,0,0,0,,Ой... ой...
Dialogue: 0,0:17:06.81,0:17:07.60,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:11.07,0:17:13.65,Default,,0,0,0,,Яхья-сан, мен таптым.
Dialogue: 0,0:17:13.74,0:17:15.24,Default,,0,0,0,,Қазір қайдасың?
Dialogue: 0,0:17:15.32,0:17:16.66,Default,,0,0,0,,Бұл төбедегі стенд.
Dialogue: 0,0:17:16.74,0:17:18.57,Default,,0,0,0,,Сіз үстелдің артынан көтеріле аласыз.
Dialogue: 0,0:17:18.66,0:17:19.78,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:17:19.87,0:17:21.83,Default,,0,0,0,,Мен кеткенше менімен араласпа
Dialogue: 0,0:17:21.91,0:17:23.00,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:17:27.96,0:17:29.29,Default,,0,0,0,,Қалай болғанда да, әзірге сол жерден кетіңдер
Dialogue: 0,0:17:29.38,0:17:32.59,Default,,0,0,0,,Бүгінгі шырын кәдімгі шырынға қарағанда 100 есе тиімді.
Dialogue: 0,0:17:32.67,0:17:34.51,Default,,0,0,0,,«Мелда» дайындалды
Dialogue: 0,0:17:35.13,0:17:37.93,Default,,0,0,0,,Бұл бір ғана стакан, бірақ ләззат алыңыз.
Dialogue: 0,0:17:39.64,0:17:40.18,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:40.89,0:17:42.85,Default,,0,0,0,,Қасқыр мырза жасырын түрде
Dialogue: 0,0:17:42.93,0:17:45.52,Default,,0,0,0,,Сен қарақұйрықты жеуге келдің бе?
Dialogue: 0,0:17:46.10,0:17:48.90,Default,,0,0,0,,Сен таза қарақұйрық емессің
Dialogue: 0,0:17:48.98,0:17:49.69,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:49.77,0:17:50.81,Default,,0,0,0,,...
Dialogue: 0,0:17:51.40,0:17:54.53,Default,,0,0,0,,Нәжісте жеген тағамның өзіне тән иісі болады.
Dialogue: 0,0:17:55.24,0:17:58.45,Default,,0,0,0,,Сіздің зәріңізден шөпқоректі болуы мүмкін емес.
Dialogue: 0,0:17:58.53,0:17:59.49,Default,,0,0,0,,Еттің иісі шықты.
Dialogue: 0,0:17:59.57,0:18:04.04,Default,,0,0,0,,Ал... иттің иіс сезу қабілетін алдауға болмайды.
Dialogue: 0,0:18:04.12,0:18:04.91,Default,,0,0,0,,Ууу!!
Dialogue: 0,0:18:08.67,0:18:11.71,Default,,0,0,0,,Сонымен, біз сіз үшін не істей аламыз?
Dialogue: 0,0:18:11.79,0:18:14.21,Default,,0,0,0,,Мен сені тұтқындаймын, бірақ мені емес...
Dialogue: 0,0:18:14.30,0:18:17.80,Default,,0,0,0,,Қамау? Сіз не істедім дедіңіз?
Dialogue: 0,0:18:17.88,0:18:19.34,Default,,0,0,0,,Е...
Dialogue: 0,0:18:19.43,0:18:24.93,Default,,0,0,0,,Ірі шөпқоректі жануарларды жаппай қырып-жоюға және органдарды сатуға күдік.
Dialogue: 0,0:18:25.52,0:18:27.10,Default,,0,0,0,,Менің достарым жақында келеді.
Dialogue: 0,0:18:27.18,0:18:28.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:28.85,0:18:30.56,Default,,0,0,0,,Бұл сіздің досыңыз ба?
Dialogue: 0,0:18:31.19,0:18:34.86,Default,,0,0,0,,Аа, бұл біраз уақыт алатын сияқты.
Dialogue: 0,0:18:34.94,0:18:38.95,Default,,0,0,0,,Оған дейін сіз менің чат серіктесім боласыз ба?
Dialogue: 0,0:18:39.03,0:18:40.07,Default,,0,0,0,,Сіз қашып кетпейсіз бе?
Dialogue: 0,0:18:40.16,0:18:42.91,Default,,0,0,0,,Мен ешқандай жамандық жасаған жоқпын.
Dialogue: 0,0:18:43.62,0:18:46.12,Default,,0,0,0,,Себебі мен сенімен сөйлескім келеді...
Dialogue: 0,0:18:46.20,0:18:49.58,Default,,0,0,0,,Сен де таза қанды қасқыр емессің ғой?
Dialogue: 0,0:18:50.21,0:18:50.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:50.83,0:18:54.21,Default,,0,0,0,,Хахаха... Бұл хит.
Dialogue: 0,0:18:54.84,0:18:57.80,Default,,0,0,0,,Бұл әділетсіз, сондықтан мен де шешемін.
Dialogue: 0,0:18:59.01,0:18:59.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:08.73,0:19:13.11,Default,,0,0,0,,Менің өз балам жұмыртқадан шыққандай.
Dialogue: 0,0:19:15.77,0:19:16.86,Default,,0,0,0,,Ум...
Dialogue: 0,0:19:17.53,0:19:20.20,Default,,0,0,0,,Сіз қайдан білдіңіз? Мен туралы
Dialogue: 0,0:19:20.28,0:19:24.07,Default,,0,0,0,,Оның денесі қасқыр болу үшін тым үлкен.
Dialogue: 0,0:19:24.16,0:19:28.29,Default,,0,0,0,,Ол мені қатты қызықтырады және оны жасыра алмайды.
Dialogue: 0,0:19:28.37,0:19:29.20,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,0:19:29.29,0:19:33.38,Default,,0,0,0,,Қандай қоспа? Бұл мысық емес.
Dialogue: 0,0:19:33.46,0:19:34.92,Default,,0,0,0,,Кенгуру т.б.
Dialogue: 0,0:19:35.00,0:19:36.25,Default,,0,0,0,,Комодо айдаһары
Dialogue: 0,0:19:36.34,0:19:38.17,Default,,0,0,0,,Шынайы ма? Ахахаха!
Dialogue: 0,0:19:38.26,0:19:40.13,Default,,0,0,0,,Ата-анаң тентек.
Dialogue: 0,0:19:40.22,0:19:42.68,Default,,0,0,0,,Аа, жоқ, бұл менің атам.
Dialogue: 0,0:19:43.72,0:19:44.89,Default,,0,0,0,,22 мамыр: Біз Аоямада бір-бірімізге дәптерлерімізді көрсетеміз.
Dialogue: 0,0:19:45.72,0:19:49.56,Default,,0,0,0,,Неліктен мен біреуді бірінші рет кездестіргенімде соншалықты еркінмін?
Dialogue: 0,0:19:50.35,0:19:55.56,Default,,0,0,0,,Бұл анаң үшін көп жұмыс болса керек.
Dialogue: 0,0:19:55.65,0:19:57.02,Default,,0,0,0,,Менің анам...
Dialogue: 0,0:19:57.90,0:20:01.61,Default,,0,0,0,,Мен 12 жасымда өз-өзіме қол жұмсадым.
Dialogue: 0,0:20:01.70,0:20:06.16,Default,,0,0,0,,Иә, саған да қиын болды, түсіндім.
Dialogue: 0,0:20:06.83,0:20:08.49,Default,,0,0,0,,Осы кеште
Dialogue: 0,0:20:08.58,0:20:11.83,Default,,0,0,0,,Етқоректілер мен шөпқоректілер арасында нәсілдік кедергілер бар.
Dialogue: 0,0:20:11.91,0:20:15.17,Default,,0,0,0,,Мен өзіме бағытталған теріс пікірден құтылғым келеді.
Dialogue: 0,0:20:15.25,0:20:18.34,Default,,0,0,0,,Шырын ішу, бетперде киіп ойнау
Dialogue: 0,0:20:18.42,0:20:22.05,Default,,0,0,0,,А, бұл сәнді әңгіме.
Dialogue: 0,0:20:22.13,0:20:25.55,Default,,0,0,0,,Аралас ретінде менің нәсілім де, досым да жоқ.
Dialogue: 0,0:20:25.64,0:20:27.68,Default,,0,0,0,,Шешімсіз адам
Dialogue: 0,0:20:27.76,0:20:30.72,Default,,0,0,0,,Анам аралас болса да, жарты жаман емес еді.
Dialogue: 0,0:20:30.81,0:20:35.31,Default,,0,0,0,,Ол өзін-өзі өлтірді, өйткені ол жарымжан адам болды, солай ма?
Dialogue: 0,0:20:36.65,0:20:39.94,Default,,0,0,0,,Аралас жай ғана бөгде зат.
Dialogue: 0,0:20:40.03,0:20:42.53,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:20:42.61,0:20:44.20,Default,,0,0,0,,Сіз не айтасыз
Dialogue: 0,0:20:45.20,0:20:50.66,Default,,0,0,0,,Біз жыртқыштар мен шөпқоректілердің тіл табысуына қолайлы қоғамда өмір сүруіміз керек.
Dialogue: 0,0:20:50.74,0:20:52.37,Default,,0,0,0,,А... бұл біртүрлі.
Dialogue: 0,0:20:52.45,0:20:55.71,Default,,0,0,0,,Онда туылған балаларға бөгде зат ретінде қарайды.
Dialogue: 0,0:20:55.79,0:20:58.54,Default,,0,0,0,,Мен өзімді бөгде зат сияқты сезінбеймін.
Dialogue: 0,0:20:58.63,0:21:01.09,Default,,0,0,0,,Сұлу болғаны сонша, жаман мақұлыққа ұқсамайды.
Dialogue: 0,0:21:01.17,0:21:06.64,Default,,0,0,0,,Ах~ Менің айтқаным өте қарапайым және қызықсыз сияқты.
Dialogue: 0,0:21:06.72,0:21:07.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:07.76,0:21:10.47,Default,,0,0,0,,Хи-хи, маған бір қызығырақ айтшы.
Dialogue: 0,0:21:10.56,0:21:12.10,Default,,0,0,0,,Ең болмаса бір әзіл бар емес пе?
Dialogue: 0,0:21:12.18,0:21:14.39,Default,,0,0,0,,Хаха... Менде ондай ештеңе жоқ...
Dialogue: 0,0:21:14.48,0:21:18.19,Default,,0,0,0,,Ондай жағдайда денені сызыққа қою керек.
Dialogue: 0,0:21:19.27,0:21:20.86,Default,,0,0,0,,Жылқы адам
Dialogue: 0,0:21:20.94,0:21:23.36,Default,,0,0,0,,Аа, жоқ, дүниедегі құбыжықтар...
Dialogue: 0,0:21:23.44,0:21:26.91,Default,,0,0,0,,Менің орныма мұндай баланы жібереді деп ойламаппын.
Dialogue: 0,0:21:27.70,0:21:30.58,Default,,0,0,0,,Сіз маған үлкен әзіл айта аласыз, солай ма?
Dialogue: 0,0:21:30.66,0:21:31.66,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:21:31.74,0:21:33.16,Default,,0,0,0,,Яхья
Dialogue: 0,0:21:33.25,0:21:37.33,Default,,0,0,0,,Сізге жауап ретінде әзіл тыңдаңыз.
Dialogue: 0,0:21:38.88,0:21:39.50,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:21:40.96,0:21:42.25,Default,,0,0,0,,Легоши!
Dialogue: 0,0:21:42.34,0:21:44.05,Default,,0,0,0,,Уф!
Dialogue: 0,0:21:46.17,0:21:47.26,Default,,0,0,0,,Ұрлық, тонау, төбелес, өрт қою — ол жасамаған жалғыз қылмыс — кісі өлтіру еді
Dialogue: 0,0:21:49.09,0:21:53.31,Default,,0,0,0,,Сіз қалай ойлайсыз? Хахахаха! Мен күлдім бе?
Dialogue: 0,0:21:53.39,0:21:54.81,Default,,0,0,0,,(күлді)
Dialogue: 0,0:21:56.06,0:21:57.56,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:22:03.19,0:22:06.61,Default,,0,0,0,,Бұл жалықтырады, кішкентай бүлікші.
Dialogue: 0,0:22:11.99,0:22:13.99,Default,,0,0,0,,♪～
Dialogue: 0,0:23:39.54,0:23:41.54,Default,,0,0,0,,～♪
