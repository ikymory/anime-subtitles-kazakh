Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.17,0:00:12.17,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:02:01.87,0:02:05.87,Default,,0,0,0,,(Тікұшақтың ұшу дыбысы)
Dialogue: 0,0:02:23.30,0:02:25.97,Default,,0,0,0,,Келесі жаңалықтар әлем тақырыптары
Dialogue: 0,0:02:26.10,0:02:27.60,Default,,0,0,0,,Құрғақшылық жалғасып жатқан Африкада
Dialogue: 0,0:02:27.73,0:02:29.94,Default,,0,0,0,,Су іздеп жиналған қоқиқаздар тобы.
Dialogue: 0,0:02:30.06,0:02:33.19,Default,,0,0,0,,Бір түнде бәрі жоғалып кеткен біртүрлі оқиға болды.
Dialogue: 0,0:02:34.48,0:02:36.78,Default,,0,0,0,,Танкерден төгілген шикі мұнайға байланысты
Dialogue: 0,0:02:36.90,0:02:38.36,Default,,0,0,0,,Бір топ теңіз құстары қиналып жатты
Dialogue: 0,0:02:38.70,0:02:40.28,Default,,0,0,0,,Бұл мен білмей тұрып жоғалып кеткенін білдіреді.
Dialogue: 0,0:02:40.66,0:02:43.24,Default,,0,0,0,,Эй, біртүрлі нәрселер болып жатыр.
Dialogue: 0,0:02:43.37,0:02:46.24,Default,,0,0,0,,Түсіндім. Сіз не білдіңіз?
Dialogue: 0,0:02:46.37,0:02:47.37,Default,,0,0,0,,Тағы бір бөтен
Dialogue: 0,0:02:47.50,0:02:49.16,Default,,0,0,0,,Сіз мені өзіңізбен бірге алып кеттім деп айтпадыңыз ғой?
Dialogue: 0,0:02:49.29,0:02:52.67,Default,,0,0,0,,Иә, дұрыс, құстарға ұқсайтын жат планеталықтар бар.
Dialogue: 0,0:02:53.13,0:02:57.63,Default,,0,0,0,,Нобитаның ойы балаша. Шетелдіктер сегізаяқ сияқты.
Dialogue: 0,0:02:57.92,0:03:00.30,Default,,0,0,0,,Жоқ, Нобита-кун туралы да теория болуы мүмкін.
Dialogue: 0,0:03:00.43,0:03:01.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:01.55,0:03:02.93,Default,,0,0,0,,Біз бұл бірлескен зерттеуді жүргізіп жатырмыз.
Dialogue: 0,0:03:03.05,0:03:04.55,Default,,0,0,0,,Мен зерттеп, анықтадым
Dialogue: 0,0:03:05.14,0:03:08.52,Default,,0,0,0,,Дүние жүзінде құстар туралы көптеген аңыздар бар.
Dialogue: 0,0:03:08.89,0:03:11.52,Default,,0,0,0,,Құс адамы? (Декісүгі) Құс кейпіндегі адам
Dialogue: 0,0:03:11.64,0:03:14.94,Default,,0,0,0,,Менің ойымша, бұл құс адам деп аталады. (Нобита) Иә, солай, мен сенімдімін!
Dialogue: 0,0:03:15.27,0:03:18.90,Default,,0,0,0,,Мысалы, осы ежелгі ассириялық рух мүсіні
Dialogue: 0,0:03:19.57,0:03:23.49,Default,,0,0,0,,Оның денесі адамдікі, бірақ басы мен қанаты қырандық.
Dialogue: 0,0:03:23.62,0:03:28.83,Default,,0,0,0,,Ал Мысыр құдайы Хорустың беті сұңқар, бірақ адам денесі бар.
Dialogue: 0,0:03:28.95,0:03:31.92,Default,,0,0,0,,Хух~ (Декисуги) Мен де Жапонияда болдым.
Dialogue: 0,0:03:32.04,0:03:33.50,Default,,0,0,0,,Құс адамы? (Декисуги) Қараңдар
Dialogue: 0,0:03:33.63,0:03:35.88,Default,,0,0,0,,Мына қарға теңге шынында да құсбегі екен.
Dialogue: 0,0:03:36.34,0:03:39.05,Default,,0,0,0,,Бұл олардың бәрі жат планеталықтар дегенді білдіре ме?
Dialogue: 0,0:03:39.17,0:03:43.43,Default,,0,0,0,,Нақты айта алмаймын, бірақ болған шығар.
Dialogue: 0,0:03:43.55,0:03:45.51,Default,,0,0,0,,Құс адамы?
Dialogue: 0,0:03:45.64,0:03:48.51,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:50.81,0:03:52.14,Default,,0,0,0,,Бұл менің төзімділігім жақсарғандықтан, және
Dialogue: 0,0:03:53.10,0:03:54.10,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:57.36,0:03:59.11,Default,,0,0,0,,Уф хаа~
Dialogue: 0,0:04:01.24,0:04:04.07,Default,,0,0,0,,Уау! Ахаха
Dialogue: 0,0:04:04.82,0:04:06.95,Default,,0,0,0,,Я~
Dialogue: 0,0:04:08.53,0:04:10.16,Default,,0,0,0,,Мінекей!
Dialogue: 0,0:04:14.33,0:04:17.04,Default,,0,0,0,,Уау! Хахахаха!
Dialogue: 0,0:04:21.42,0:04:23.88,Default,,0,0,0,,Ух ха ха!
Dialogue: 0,0:04:24.72,0:04:25.80,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:26.34,0:04:30.43,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:04:31.27,0:04:37.27,Default,,0,0,0,,♪〜
Dialogue: 0,0:05:38.25,0:05:44.26,Default,,0,0,0,,〜♪
Dialogue: 0,0:05:47.47,0:05:50.01,Default,,0,0,0,,Иә, не?!
Dialogue: 0,0:05:50.68,0:05:55.22,Default,,0,0,0,,Құс сияқты ма? Аспанда еркін ұшқым келеді
Dialogue: 0,0:05:55.35,0:05:56.85,Default,,0,0,0,,Иә Баспропеллер
Dialogue: 0,0:05:56.98,0:05:59.85,Default,,0,0,0,,Жоқ! Бұл құс адам. Бұл құс адам.
Dialogue: 0,0:06:00.44,0:06:03.32,Default,,0,0,0,,Чоджин? Чоужин бұл...
Dialogue: 0,0:06:07.95,0:06:10.82,Default,,0,0,0,,Тантакатаан
Dialogue: 0,0:06:12.37,0:06:16.04,Default,,0,0,0,,(Дораэмонның күшті дауысы)
Dialogue: 0,0:06:19.92,0:06:21.04,Default,,0,0,0,,Фу~
Dialogue: 0,0:06:26.63,0:06:27.47,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:31.14,0:06:33.93,Default,,0,0,0,,Чоджин...? (Нобита) Бұл емес!
Dialogue: 0,0:06:34.06,0:06:36.43,Default,,0,0,0,,Құс адамдар туралы Құс адамдар?
Dialogue: 0,0:06:36.56,0:06:40.02,Default,,0,0,0,,Мен қозғалтқыштарға немесе қозғалтқыштарға сенбеймін.
Dialogue: 0,0:06:40.14,0:06:42.11,Default,,0,0,0,,Аспанда өз күшіммен ұшқым келеді
Dialogue: 0,0:06:42.23,0:06:44.61,Default,,0,0,0,,Керемет
Dialogue: 0,0:06:45.11,0:06:48.07,Default,,0,0,0,,Аа, қазір ойлап қарасам, бұл ұзақ жол болды.
Dialogue: 0,0:06:48.78,0:06:51.70,Default,,0,0,0,,Тапсырманы орындауға барған кезде, «құралдарыңызды алыңыз~»
Dialogue: 0,0:06:51.82,0:06:54.53,Default,,0,0,0,,Үй тапсырмасы болса, «Маған құралдарды беріңіз».
Dialogue: 0,0:06:54.83,0:06:58.00,Default,,0,0,0,,Нобита-кун әрқашан көңіл көтеруге тырысатын
Dialogue: 0,0:06:58.66,0:07:00.33,Default,,0,0,0,,Ақырында, өз күшіммен...
Dialogue: 0,0:07:00.46,0:07:01.46,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:07:01.92,0:07:05.17,Default,,0,0,0,,Осы күннің келуін қанша күттім?
Dialogue: 0,0:07:05.29,0:07:07.88,Default,,0,0,0,,Тіпті менің ойымша, жағдай бұлай жалғаса береді.
Dialogue: 0,0:07:08.01,0:07:09.38,Default,,0,0,0,,Барған сайын керемет
Dialogue: 0,0:07:09.88,0:07:11.26,Default,,0,0,0,,Сонымен... иә
Dialogue: 0,0:07:11.38,0:07:14.68,Default,,0,0,0,,Аспанда өз күшіммен ұша аламын... Құрал-саймандарды шығарыңдар.
Dialogue: 0,0:07:14.80,0:07:19.56,Default,,0,0,0,,Жоқ, енді оны өзіңіз жасаудың қажеті жоқ.
Dialogue: 0,0:07:19.89,0:07:21.44,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:07:21.77,0:07:25.02,Default,,0,0,0,,Міне! Міне осы! көрейік?
Dialogue: 0,0:07:25.15,0:07:28.73,Default,,0,0,0,,Бұл менің жасағым келген нәрсе.
Dialogue: 0,0:07:29.36,0:07:31.20,Default,,0,0,0,,Нобита-кун, бұл...
Dialogue: 0,0:07:31.70,0:07:33.95,Default,,0,0,0,,Жарайды, материалдардан бастайық.
Dialogue: 0,0:07:34.07,0:07:38.79,Default,,0,0,0,,Мм... аа... Мен бұлай ұша алмаймын.
Dialogue: 0,0:07:38.91,0:07:40.62,Default,,0,0,0,,Бір-бірімізге жылы лебіз білдірейік
Dialogue: 0,0:08:02.94,0:08:03.60,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:08:06.73,0:08:07.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:08.23,0:08:11.40,Default,,0,0,0,,А, орындалды!
Dialogue: 0,0:08:11.53,0:08:13.28,Default,,0,0,0,,Сіз тамаша жұмыс жасадыңыз.
Dialogue: 0,0:08:13.40,0:08:15.41,Default,,0,0,0,,Енді артқы тауларда бірінші ұшамыз.
Dialogue: 0,0:08:15.53,0:08:17.45,Default,,0,0,0,,Иә!? Нобита-кун!
Dialogue: 0,0:08:18.83,0:08:21.41,Default,,0,0,0,,Өте жақсы орындалған.
Dialogue: 0,0:08:22.21,0:08:25.25,Default,,0,0,0,,Бірақ Нобита-кун
Dialogue: 0,0:08:25.37,0:08:26.38,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:08:29.00,0:08:30.84,Default,,0,0,0,,Ах! (Нобита) Бұл! иә?
Dialogue: 0,0:08:30.96,0:08:32.30,Default,,0,0,0,,Уау! аа!
Dialogue: 0,0:08:32.76,0:08:36.55,Default,,0,0,0,,Ия, ұшты! Ұшты! сәйкес? Апыр-ай!
Dialogue: 0,0:08:36.68,0:08:39.06,Default,,0,0,0,,Мен ауа матрасын қойғаныма қуаныштымын.
Dialogue: 0,0:08:39.35,0:08:40.81,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:42.06,0:08:46.02,Default,,0,0,0,,Уау! А~ Қажетсіз ештеңе жасамаңыз.
Dialogue: 0,0:08:46.15,0:08:47.98,Default,,0,0,0,,Қосымша заттар...
Dialogue: 0,0:08:48.11,0:08:50.78,Default,,0,0,0,,Мен ұша алмадым деп ойлаймын.
Dialogue: 0,0:08:51.11,0:08:53.44,Default,,0,0,0,,Нобита-кун, адам күші...
Dialogue: 0,0:08:53.78,0:08:56.20,Default,,0,0,0,,Бұл жолы мен ұшамын, сондықтан...
Dialogue: 0,0:08:56.32,0:08:57.57,Default,,0,0,0,,Бұл! Ах!
Dialogue: 0,0:08:57.70,0:08:58.91,Default,,0,0,0,,Ахх...
Dialogue: 0,0:08:59.41,0:09:00.83,Default,,0,0,0,,ммм
Dialogue: 0,0:09:02.25,0:09:05.46,Default,,0,0,0,,Бұл! Уау...
Dialogue: 0,0:09:05.58,0:09:07.96,Default,,0,0,0,,Бұл! Ааа... Уау
Dialogue: 0,0:09:08.42,0:09:11.88,Default,,0,0,0,,Уф ха ха...
Dialogue: 0,0:09:12.34,0:09:15.80,Default,,0,0,0,,Нобита-кун... (Нобита) Ди Ди Ди
Dialogue: 0,0:09:16.26,0:09:19.26,Default,,0,0,0,,Егер сен осыншама көп жұмыс жасасаң, мен сені тоқтата алмаймын.
Dialogue: 0,0:09:20.68,0:09:21.97,Default,,0,0,0,,Бұл! Ах...
Dialogue: 0,0:09:22.31,0:09:24.89,Default,,0,0,0,,Иә! Сіз оны ауа матрассыз жасай аласыз ба?
Dialogue: 0,0:09:25.02,0:09:28.23,Default,,0,0,0,,Иә, төсеніштің болуы өзімді қауіпсіз сезінеді.
Dialogue: 0,0:09:28.35,0:09:29.73,Default,,0,0,0,,Уау! Бұл ақылсыз
Dialogue: 0,0:09:30.77,0:09:32.69,Default,,0,0,0,,Не? Уау (Нобита) Міне!
Dialogue: 0,0:09:32.82,0:09:34.24,Default,,0,0,0,,Ей! (Нобита) Уау
Dialogue: 0,0:09:34.53,0:09:37.45,Default,,0,0,0,,Уау, ау, ұшатынмын, ұшатынмын, ұшатынмын!
Dialogue: 0,0:09:37.57,0:09:38.99,Default,,0,0,0,,... солай емес пе?
Dialogue: 0,0:09:39.12,0:09:41.74,Default,,0,0,0,,Адам күшімен бұл мүлдем мүмкін емес.
Dialogue: 0,0:09:42.41,0:09:45.00,Default,,0,0,0,,Мен өз күшіммен ұшқым келді
Dialogue: 0,0:09:45.12,0:09:47.37,Default,,0,0,0,,Мен Нобита-кунды қарап шықтым
Dialogue: 0,0:09:47.50,0:09:48.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:48.75,0:09:50.71,Default,,0,0,0,,Уау, аа (Нобита) иә? сурет?
Dialogue: 0,0:09:50.84,0:09:53.71,Default,,0,0,0,,Нобита-сан (Нобита) Шизука-чан
Dialogue: 0,0:09:54.17,0:09:57.38,Default,,0,0,0,,Пико қашып кетті, сен мұнда келмедің бе?
Dialogue: 0,0:09:57.93,0:09:59.72,Default,,0,0,0,,Міне болды, Дораемон! Уа уа уа
Dialogue: 0,0:09:59.84,0:10:02.31,Default,,0,0,0,,Жарайды, жарайды, жарайды...
Dialogue: 0,0:10:02.43,0:10:04.81,Default,,0,0,0,,Күте тұрыңыз! Күте тұрыңыз!
Dialogue: 0,0:10:06.52,0:10:07.81,Default,,0,0,0,,Уау! (Нобита) Уау!
Dialogue: 0,0:10:07.94,0:10:10.94,Default,,0,0,0,,(Үш адам айғайлайды)
Dialogue: 0,0:10:11.15,0:10:13.65,Default,,0,0,0,,Ахх (Нобита) Уау!
Dialogue: 0,0:10:13.77,0:10:15.90,Default,,0,0,0,,(Дораэмонның күшті дауысы)
Dialogue: 0,0:10:16.19,0:10:19.61,Default,,0,0,0,,Уау Уау... Уау Уау!
Dialogue: 0,0:10:19.99,0:10:22.03,Default,,0,0,0,,Иә? Сен не істеп жатырсың?
Dialogue: 0,0:10:22.16,0:10:23.62,Default,,0,0,0,,Джан ана жерде! Иә?
Dialogue: 0,0:10:24.20,0:10:25.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:29.00,0:10:31.54,Default,,0,0,0,,Сунео, кеттік (Сунео) Иә.
Dialogue: 0,0:10:31.88,0:10:35.21,Default,,0,0,0,,Мен бұл екеніне сенімдімін. (Нобита) Бұл кенеттен болды.
Dialogue: 0,0:10:35.34,0:10:37.01,Default,,0,0,0,,Сіз Пекодан жалтардыңыз.
Dialogue: 0,0:10:38.92,0:10:41.51,Default,,0,0,0,,Ах, ана жақта (Нобита/Дораемон) Ах!
Dialogue: 0,0:10:42.22,0:10:43.97,Default,,0,0,0,,Мықты болыңыз (3 адам) Ах!
Dialogue: 0,0:10:49.48,0:10:51.69,Default,,0,0,0,,Бұл құс па? Әлде адам?
Dialogue: 0,0:10:51.81,0:10:55.65,Default,,0,0,0,,Келіңіздер... Иә? нағыз құс қауырсындары
Dialogue: 0,0:10:56.11,0:10:59.11,Default,,0,0,0,,Сонымен, құс адам? Амал жоқ
Dialogue: 0,0:10:59.49,0:11:03.49,Default,,0,0,0,,Аспаннан кенеттен осындай ұшақ пайда болды.
Dialogue: 0,0:11:03.62,0:11:05.03,Default,,0,0,0,,Ол кім?
Dialogue: 0,0:11:05.16,0:11:08.00,Default,,0,0,0,,Уф, уф, уф... Мен ренжіген сияқтымын.
Dialogue: 0,0:11:08.12,0:11:10.00,Default,,0,0,0,,Бұл туралы бірдеңе істейік.
Dialogue: 0,0:11:10.12,0:11:13.00,Default,,0,0,0,,Біреу білсе, үлкен шу болады.
Dialogue: 0,0:11:13.42,0:11:15.46,Default,,0,0,0,,Тазартқыш лак
Dialogue: 0,0:11:16.88,0:11:19.47,Default,,0,0,0,,Енді ұшақты жасырайық
Dialogue: 0,0:11:19.88,0:11:21.72,Default,,0,0,0,,Нобита-кун, мына баланы арқаңа көтеріп жүр
Dialogue: 0,0:11:21.84,0:11:23.59,Default,,0,0,0,,Не? Мен?
Dialogue: 0,0:11:23.72,0:11:28.43,Default,,0,0,0,,Дұрыс, әзірше үйге апарайық. Жақсы.
Dialogue: 0,0:11:29.23,0:11:31.64,Default,,0,0,0,,Мүмкін бұл үлкен оқиға шығар.
Dialogue: 0,0:11:31.77,0:11:33.40,Default,,0,0,0,,Сіз оны таба алмайсыз.
Dialogue: 0,0:11:34.19,0:11:37.73,Default,,0,0,0,,Бұл біртүрлі, мен оны осы жерде деп ойладым.
Dialogue: 0,0:11:37.86,0:11:39.69,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:39.82,0:11:42.66,Default,,0,0,0,,Сунео, бұл туралы ешкімге айтпа.
Dialogue: 0,0:11:42.78,0:11:43.74,Default,,0,0,0,,Әрине
Dialogue: 0,0:11:48.54,0:11:52.54,Default,,0,0,0,,(Госукенің айқайы)
Dialogue: 0,0:11:58.05,0:12:01.72,Default,,0,0,0,,(Гусукенің ыңырануы)
Dialogue: 0,0:12:03.34,0:12:05.01,Default,,0,0,0,,Аа, байқаған сияқтысыз.
Dialogue: 0,0:12:05.39,0:12:07.72,Default,,0,0,0,,Уау уау...
Dialogue: 0,0:12:07.85,0:12:10.18,Default,,0,0,0,,Уау...адам!?
Dialogue: 0,0:12:10.60,0:12:13.39,Default,,0,0,0,,Қазірдің өзінде нені шулатып жатырсың?
Dialogue: 0,0:12:13.52,0:12:15.98,Default,,0,0,0,,О, қауырсындар
Dialogue: 0,0:12:16.11,0:12:19.90,Default,,0,0,0,,Менсіз тағы бірдеңе өсіре бастадыңыз.
Dialogue: 0,0:12:20.44,0:12:23.86,Default,,0,0,0,,Қорықпа, жарайды, мен ештеңе істемеймін.
Dialogue: 0,0:12:24.45,0:12:26.70,Default,,0,0,0,,Менің... Менің қар қазым
Dialogue: 0,0:12:26.82,0:12:29.83,Default,,0,0,0,,Ах! А... қайда бардың?
Dialogue: 0,0:12:30.45,0:12:31.95,Default,,0,0,0,,«Қар қазы»?
Dialogue: 0,0:12:32.08,0:12:33.79,Default,,0,0,0,,Менің ойымша, сіз бұл ұшақ туралы айтып отырсыз.
Dialogue: 0,0:12:34.25,0:12:35.83,Default,,0,0,0,,Сіз қайда құладыңыз
Dialogue: 0,0:12:35.96,0:12:39.25,Default,,0,0,0,,Уайымдамаңыз, ол жасырылған, сондықтан сіз оны таппайсыз.
Dialogue: 0,0:12:40.00,0:12:41.80,Default,,0,0,0,,Рахмет, бірақ
Dialogue: 0,0:12:41.92,0:12:44.72,Default,,0,0,0,,Тез, мені қар қазына апар.
Dialogue: 0,0:12:44.88,0:12:46.68,Default,,0,0,0,,Ноби-чан (Нобита және оның достары) Уау!
Dialogue: 0,0:12:47.26,0:12:48.64,Default,,0,0,0,,Анам келеді. Жаман.
Dialogue: 0,0:12:48.93,0:12:51.60,Default,,0,0,0,,(Нобита мен оның достарының үрейлі дауыстары)
Dialogue: 0,0:12:52.39,0:12:53.52,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,0:12:53.64,0:12:55.52,Default,,0,0,0,,Ха ха ха нгг~
Dialogue: 0,0:12:56.23,0:12:59.36,Default,,0,0,0,,Ноби-чан! Ой, не болды? Дора-чан
Dialogue: 0,0:12:59.77,0:13:02.82,Default,,0,0,0,,Хехе, қызуым көтеріліп қалған сияқты.
Dialogue: 0,0:13:02.94,0:13:04.32,Default,,0,0,0,,Көп емес
Dialogue: 0,0:13:05.03,0:13:08.78,Default,,0,0,0,,Ондай жағдайда ащы дәріні кейінірек ішіңіз.
Dialogue: 0,0:13:09.16,0:13:10.16,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:10.74,0:13:12.91,Default,,0,0,0,,Ноби-чан онда не істеп жүр?
Dialogue: 0,0:13:13.04,0:13:15.33,Default,,0,0,0,,Мұнда ештеңе жоқ.
Dialogue: 0,0:13:15.87,0:13:17.29,Default,,0,0,0,,Олай болса, ол жерден кет.
Dialogue: 0,0:13:17.71,0:13:18.88,Default,,0,0,0,,Мен ішін тексеремін (Нобита) А, а...
Dialogue: 0,0:13:19.00,0:13:21.13,Default,,0,0,0,,(Нобита мен оның достарының таңданған дауыстары)
Dialogue: 0,0:13:21.25,0:13:22.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:29.39,0:13:31.85,Default,,0,0,0,,Мен оның ұшақтың артындағы тауға шыққанына сенімдімін.
Dialogue: 0,0:13:32.47,0:13:34.18,Default,,0,0,0,,Ешкім білмей тұрып...
Dialogue: 0,0:13:34.31,0:13:35.35,Default,,0,0,0,,Иә, асығайық.
Dialogue: 0,0:13:38.27,0:13:39.52,Default,,0,0,0,,Нобита! (Дораэмон/Нобита) Уау!
Dialogue: 0,0:13:40.19,0:13:42.73,Default,,0,0,0,,Менің ойымша, сіз тауық өсірмек болдыңыз.
Dialogue: 0,0:13:42.86,0:13:44.49,Default,,0,0,0,,Анам мені кешірмейді!
Dialogue: 0,0:13:48.91,0:13:51.78,Default,,0,0,0,,А, бұл ерекше қулық болды.
Dialogue: 0,0:13:51.91,0:13:54.41,Default,,0,0,0,,Қараңғы, ертең тағы іздейік.
Dialogue: 0,0:13:54.95,0:13:56.96,Default,,0,0,0,,Бір нәрсе құлаған болуы керек.
Dialogue: 0,0:13:57.08,0:14:00.17,Default,,0,0,0,,О, Сунео, Нобита да жоқ.
Dialogue: 0,0:14:00.29,0:14:02.00,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:14:06.09,0:14:10.51,Default,,0,0,0,,Күрсін, қайда жасырдың?
Dialogue: 0,0:14:10.84,0:14:15.56,Default,,0,0,0,,Ху~ Хмм, мен бұл жерде болғанына сенімдімін.
Dialogue: 0,0:14:16.18,0:14:18.02,Default,,0,0,0,,Бүгінгі жағдайда ол профессор Годжо немесе сондай біреу болар еді.
Dialogue: 0,0:14:19.35,0:14:24.19,Default,,0,0,0,,Уау! Эххх уау~ ха ха ха...
Dialogue: 0,0:14:24.32,0:14:27.28,Default,,0,0,0,,(Гусукенің үрейленген дауысы)
Dialogue: 0,0:14:27.86,0:14:29.07,Default,,0,0,0,,Бұл дауыс!
Dialogue: 0,0:14:29.20,0:14:30.61,Default,,0,0,0,,Міне, осылай (Нобита) Болды.
Dialogue: 0,0:14:31.28,0:14:33.16,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:33.28,0:14:36.41,Default,,0,0,0,,Ааа! Уау
Dialogue: 0,0:14:36.54,0:14:39.46,Default,,0,0,0,,Уау! Ууу...
Dialogue: 0,0:14:39.58,0:14:40.54,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:41.88,0:14:42.67,Default,,0,0,0,,Ахх...
Dialogue: 0,0:14:42.79,0:14:45.92,Default,,0,0,0,,(Госукенің үрейленген дауысы)
Dialogue: 0,0:14:46.05,0:14:48.26,Default,,0,0,0,,Иә! Қазір бәрі жақсы (Госуке) Уау, уау
Dialogue: 0,0:14:48.38,0:14:51.34,Default,,0,0,0,,Қанаттарың бар, бірақ ұша алмайсың ба?
Dialogue: 0,0:14:51.47,0:14:54.64,Default,,0,0,0,,Ол енді пародиялық фильм де емес.
Dialogue: 0,0:14:54.76,0:14:57.85,Default,,0,0,0,,Балалар, сендер адамсыңдар, енді қалай ұша аласыңдар?
Dialogue: 0,0:14:58.52,0:15:00.31,Default,,0,0,0,,Лакты кетіру
Dialogue: 0,0:15:02.27,0:15:03.27,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:15:03.61,0:15:06.03,Default,,0,0,0,,Уау! қар қазы
Dialogue: 0,0:15:06.40,0:15:09.49,Default,,0,0,0,,А... бұл қорқынышты.
Dialogue: 0,0:15:09.74,0:15:12.57,Default,,0,0,0,,Бұл жөндеуге көп уақыт қажет сияқты.
Dialogue: 0,0:15:13.57,0:15:16.54,Default,,0,0,0,,Біз де көмектесеміз. (Госуке) Жарайды, мен жалғызбын.
Dialogue: 0,0:15:16.91,0:15:20.92,Default,,0,0,0,,Сіз бізге әлі де сенбейсіз бе?
Dialogue: 0,0:15:21.12,0:15:22.92,Default,,0,0,0,,Хмм... Ах...
Dialogue: 0,0:15:25.04,0:15:28.01,Default,,0,0,0,,Хмм, рахмет Ноби-чан
Dialogue: 0,0:15:29.42,0:15:32.05,Default,,0,0,0,,Сіздің атыңыз Гусуке?
Dialogue: 0,0:15:32.18,0:15:33.97,Default,,0,0,0,,Сіз қайдансыз?
Dialogue: 0,0:15:34.39,0:15:35.93,Default,,0,0,0,,Мүмкін ғарыштан?
Dialogue: 0,0:15:37.01,0:15:40.10,Default,,0,0,0,,Ум (Нобита) Сонда ол қайда?
Dialogue: 0,0:15:41.77,0:15:44.27,Default,,0,0,0,,Мен олай айта алмаймын...
Dialogue: 0,0:15:45.36,0:15:49.03,Default,,0,0,0,,Дәл қазір, бұл ұшақ жөнделгенше.
Dialogue: 0,0:15:49.15,0:15:51.15,Default,,0,0,0,,Бұл жерде жасырынған дұрыс.
Dialogue: 0,0:15:51.28,0:15:54.16,Default,,0,0,0,,Nestbox кемпинг жинағы
Dialogue: 0,0:15:54.45,0:15:56.20,Default,,0,0,0,,Бұл өте кішкентай.
Dialogue: 0,0:15:56.33,0:15:58.45,Default,,0,0,0,,Ал, маған қарашы (Гусуке) А.
Dialogue: 0,0:16:00.87,0:16:04.88,Default,,0,0,0,,Бұл жерде көрініс тамаша, бұл жақсы.
Dialogue: 0,0:16:05.00,0:16:07.54,Default,,0,0,0,,Кез келген жерде лифт орнатыңыз...
Dialogue: 0,0:16:07.67,0:16:08.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:08.75,0:16:11.22,Default,,0,0,0,,Мен ұяға барамын.
Dialogue: 0,0:16:14.93,0:16:16.55,Default,,0,0,0,,(лифт жұмысының дыбысы)
Dialogue: 0,0:16:16.68,0:16:17.76,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:16:18.64,0:16:21.48,Default,,0,0,0,,Уау, іші сондай кең.
Dialogue: 0,0:16:21.60,0:16:24.65,Default,,0,0,0,,Керісінше, біз кішірейіп кеттік.
Dialogue: 0,0:16:24.77,0:16:26.65,Default,,0,0,0,,Хэхехе уау~
Dialogue: 0,0:16:26.77,0:16:29.78,Default,,0,0,0,,Әй, тамаша көрініс (Нобита) Шынымен
Dialogue: 0,0:16:29.90,0:16:31.15,Default,,0,0,0,,Балалар, сендер неге мұндайсыңдар?
Dialogue: 0,0:16:31.28,0:16:32.86,Default,,0,0,0,,Сізде жұмбақ күштер бар ма?
Dialogue: 0,0:16:32.99,0:16:35.61,Default,,0,0,0,,Бұл Дораэмонда ғана бар.
Dialogue: 0,0:16:35.86,0:16:38.53,Default,,0,0,0,,Эххе, сәл ғана.
Dialogue: 0,0:16:38.66,0:16:41.33,Default,,0,0,0,,Хехе…
Dialogue: 0,0:16:46.67,0:16:49.88,Default,,0,0,0,,Пико, қызық, сен қайда бардың?
Dialogue: 0,0:16:50.71,0:16:53.42,Default,,0,0,0,,Сіз қауіпсізсіз деп үміттенемін.
Dialogue: 0,0:16:54.01,0:16:57.05,Default,,0,0,0,,Ал, Гусуке-кун, жақсылап демалып ал.
Dialogue: 0,0:16:57.18,0:16:59.05,Default,,0,0,0,,Біз ертең тағы келеміз.
Dialogue: 0,0:17:00.06,0:17:02.02,Default,,0,0,0,,Көп рахмет
Dialogue: 0,0:17:11.07,0:17:13.90,Default,,0,0,0,,Менің адам әлемінде екенімді білгенде
Dialogue: 0,0:17:14.36,0:17:16.32,Default,,0,0,0,,үшін таң қалады.
Dialogue: 0,0:17:17.03,0:17:21.87,Default,,0,0,0,,Маған адам көмектеседі деп ешқашан ойламадым.
Dialogue: 0,0:17:27.50,0:17:29.21,Default,,0,0,0,,Ах~
Dialogue: 0,0:17:29.88,0:17:33.88,Default,,0,0,0,,(Госукенің қорылдауы)
Dialogue: 0,0:17:36.38,0:17:39.89,Default,,0,0,0,,Иә!? Бұл рас па?
Dialogue: 0,0:17:40.18,0:17:41.43,Default,,0,0,0,,Гиантара қазірдің өзінде
Dialogue: 0,0:17:42.10,0:17:45.85,Default,,0,0,0,,Арқасында қанаттары бар құс тәрізді адам
Dialogue: 0,0:17:47.06,0:17:48.81,Default,,0,0,0,,Ол төбеде жүгіріп келе жатты.
Dialogue: 0,0:17:49.27,0:17:53.03,Default,,0,0,0,,Оның кеше көргендерімізге қатысы бар екеніне сенімдімін.
Dialogue: 0,0:17:53.78,0:17:57.99,Default,,0,0,0,,Декисуги айтып отырған бөтен адам-құс болуы мүмкін.
Dialogue: 0,0:17:58.24,0:18:02.24,Default,,0,0,0,,Бұл үлкен мәселе. Уа, сәл күте тұрыңыз.
Dialogue: 0,0:18:02.37,0:18:04.12,Default,,0,0,0,,Бұл Нобитаға тиесілі емес, солай ма?
Dialogue: 0,0:18:04.24,0:18:06.62,Default,,0,0,0,,Дұрыс (Сунео) Иә, иә.
Dialogue: 0,0:18:09.92,0:18:12.04,Default,,0,0,0,,Эй Гусуке, сен қолыңнан келгеннің бәрін істеп жатырсың.
Dialogue: 0,0:18:12.17,0:18:14.42,Default,,0,0,0,,Иә, сәлем баршаңызға.
Dialogue: 0,0:18:15.01,0:18:15.84,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:18:15.96,0:18:17.38,Default,,0,0,0,,Жақсы ұйықтадың ба?
Dialogue: 0,0:18:17.51,0:18:19.34,Default,,0,0,0,,Сіздің арқаңызда мен өзімді жақсы сезінемін.
Dialogue: 0,0:18:19.97,0:18:22.18,Default,,0,0,0,,Уәде етілгендей, мен көмектесуге келдім.
Dialogue: 0,0:18:22.30,0:18:25.68,Default,,0,0,0,,Рахмет Нобита, мәселе мына қанаттарда...
Dialogue: 0,0:18:26.06,0:18:28.69,Default,,0,0,0,,Эй, мен мұны пайдалана аламын ба? (Гусуке) А?
Dialogue: 0,0:18:28.81,0:18:30.73,Default,,0,0,0,,Мен жасадым.
Dialogue: 0,0:18:30.85,0:18:32.73,Default,,0,0,0,,А, қайсысы?
Dialogue: 0,0:18:33.94,0:18:37.03,Default,,0,0,0,,Е, аздап жыртылған сияқты, бірақ қолдануға болады.
Dialogue: 0,0:18:37.15,0:18:39.28,Default,,0,0,0,,Шынымен бе? Жақсы
Dialogue: 0,0:18:39.40,0:18:40.66,Default,,0,0,0,,Осының алдында
Dialogue: 0,0:18:41.37,0:18:43.99,Default,,0,0,0,,Качинкачин жарығы
Dialogue: 0,0:18:44.12,0:18:45.54,Default,,0,0,0,,Оны... (Госуке) Уф
Dialogue: 0,0:18:46.20,0:18:48.29,Default,,0,0,0,,Нобита, сен оны маған бере аласың ба?
Dialogue: 0,0:18:48.41,0:18:49.71,Default,,0,0,0,,Мұндай жағдай болса деп, астымда бронежилет киіп жүрмін.
Dialogue: 0,0:18:50.17,0:18:52.38,Default,,0,0,0,,Нобита-сан, сен қатты толқыдың.
Dialogue: 0,0:18:52.50,0:18:53.17,Default,,0,0,0,,Иә
Dialogue: 0,0:18:53.59,0:18:54.96,Default,,0,0,0,,А, сәл оңға қарай.
Dialogue: 0,0:18:55.09,0:18:56.13,Default,,0,0,0,,Иә Жарайды
Dialogue: 0,0:18:57.13,0:18:59.51,Default,,0,0,0,,Оны қатты ұстаңыз (Нобита)
Dialogue: 0,0:18:59.63,0:19:01.51,Default,,0,0,0,,Хехе...
Dialogue: 0,0:19:02.68,0:19:04.93,Default,,0,0,0,,Ху~ (Нобита) Хахаха
Dialogue: 0,0:19:05.64,0:19:07.18,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:07.31,0:19:09.35,Default,,0,0,0,,Келесі - бұранданың күйі (Нобита) Жарайды.
Dialogue: 0,0:19:09.81,0:19:11.23,Default,,0,0,0,,Мықтап ұстаңыз
Dialogue: 0,0:19:11.77,0:19:14.23,Default,,0,0,0,,Амансың ба? Кеттік (Нобита)
Dialogue: 0,0:19:14.52,0:19:16.40,Default,,0,0,0,,Нобита, педальды бұрап көріңіз.
Dialogue: 0,0:19:16.53,0:19:17.90,Default,,0,0,0,,Мұндай жағдай болса деп, астымда бронежилет киіп жүрмін.
Dialogue: 0,0:19:18.74,0:19:20.20,Default,,0,0,0,,(Нобитаның қатты дауысы)
Dialogue: 0,0:19:20.61,0:19:22.87,Default,,0,0,0,,Иә, оны көбірек айналдырыңыз (Нобита) Иә.
Dialogue: 0,0:19:22.99,0:19:26.16,Default,,0,0,0,,(Нобитаның қатты дауысы)
Dialogue: 0,0:19:26.79,0:19:29.12,Default,,0,0,0,,Олар ағайынды сияқты, иә.
Dialogue: 0,0:19:29.83,0:19:31.58,Default,,0,0,0,,Жарайды, тамаша.
Dialogue: 0,0:19:32.08,0:19:35.04,Default,,0,0,0,,Енді мен ұша аламын, жақсы.
Dialogue: 0,0:19:35.79,0:19:38.51,Default,,0,0,0,,Рахмет Нобита (Нобита) Жақсы саған Гусуке
Dialogue: 0,0:19:39.26,0:19:40.97,Default,,0,0,0,,Бірден сынақ ұшуын жасайық.
Dialogue: 0,0:19:42.68,0:19:44.60,Default,,0,0,0,,Шынымен, мен қалжыңдап тұрған жоқпын.
Dialogue: 0,0:19:44.72,0:19:48.39,Default,,0,0,0,,Оны бөтен құс-адам деп кім айтты?
Dialogue: 0,0:19:48.52,0:19:51.48,Default,,0,0,0,,Джан, солай ма? А, мен?
Dialogue: 0,0:19:51.98,0:19:53.98,Default,,0,0,0,,Ах, бұл! иә?
Dialogue: 0,0:19:54.10,0:19:57.57,Default,,0,0,0,,Қараңызшы, бұл кеше құлағанның қалдығы емес пе?
Dialogue: 0,0:19:57.69,0:19:58.40,Default,,0,0,0,,Яғни...
Dialogue: 0,0:19:59.15,0:20:00.86,Default,,0,0,0,,Ол әлі де осында болуы керек.
Dialogue: 0,0:20:06.91,0:20:07.78,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:10.29,0:20:11.75,Default,,0,0,0,,Сәттілік Гуосуке!
Dialogue: 0,0:20:12.75,0:20:16.00,Default,,0,0,0,,Иә (Нобита/Шидзука) Хэхехе...
Dialogue: 0,0:20:18.05,0:20:19.05,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:19.71,0:20:21.51,Default,,0,0,0,,Джан! Хмм... бөтен планеталық!?
Dialogue: 0,0:20:23.76,0:20:25.43,Default,,0,0,0,,Менің қашып кетуіме жол берме, Сунео! (Сунео) Иә!
Dialogue: 0,0:20:25.55,0:20:27.43,Default,,0,0,0,,Күте тұрыңыз! тоқта!
Dialogue: 0,0:20:30.10,0:20:31.98,Default,,0,0,0,,(Сунеоның күшті дауысы)
Dialogue: 0,0:20:32.48,0:20:33.94,Default,,0,0,0,,Джан! Сунео!
Dialogue: 0,0:20:34.06,0:20:37.11,Default,,0,0,0,,(Джиан мен Сунеоның айқайы)
Dialogue: 0,0:20:37.98,0:20:40.53,Default,,0,0,0,,Дораемон! Иә Баспропеллер
Dialogue: 0,0:20:44.40,0:20:47.41,Default,,0,0,0,,(Джиан мен Сунеоның айқайы)
Dialogue: 0,0:20:47.91,0:20:49.41,Default,,0,0,0,,Гусуке! Джан!
Dialogue: 0,0:20:49.53,0:20:50.45,Default,,0,0,0,,Сунео-сан!
Dialogue: 0,0:20:52.45,0:20:53.83,Default,,0,0,0,,(Сунео мен Джианның айқайы)
Dialogue: 0,0:20:54.67,0:20:56.71,Default,,0,0,0,,Уау, кешегідей тесік.
Dialogue: 0,0:21:00.30,0:21:02.42,Default,,0,0,0,,Уау! (Нобита) Джан Сунео!
Dialogue: 0,0:21:08.30,0:21:10.14,Default,,0,0,0,,(Үш адам айғайлайды)
Dialogue: 0,0:21:10.64,0:21:12.85,Default,,0,0,0,,Ах, Дораемон, бұл не!
Dialogue: 0,0:21:12.98,0:21:14.98,Default,,0,0,0,,Менің ойымша, бұл кеңістік пен уақыт.
Dialogue: 0,0:21:15.10,0:21:16.52,Default,,0,0,0,,Уақыт пен кеңістік? Ах!
Dialogue: 0,0:21:16.65,0:21:18.61,Default,,0,0,0,,(Үш адам айғайлайды)
Dialogue: 0,0:21:18.73,0:21:19.90,Default,,0,0,0,,Бұл кәдімгі құс.
Dialogue: 0,0:21:22.90,0:21:24.53,Default,,0,0,0,,Ол қайда әкеледі?
Dialogue: 0,0:21:25.11,0:21:27.16,Default,,0,0,0,,Балалар сендерге қауіп төніп тұр!
Dialogue: 0,0:21:27.28,0:21:29.07,Default,,0,0,0,,Жоқ... мені қайда апармақшысың!
Dialogue: 0,0:21:29.20,0:21:30.49,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,0:21:30.78,0:21:32.79,Default,,0,0,0,,(Джианның айқайы)
Dialogue: 0,0:21:35.83,0:21:38.67,Default,,0,0,0,,Уау! (Сунео жылайды)
Dialogue: 0,0:21:44.38,0:21:46.68,Default,,0,0,0,,Бұл қайда? Тез түсіріңіз!
Dialogue: 0,0:21:46.80,0:21:47.93,Default,,0,0,0,,Уау?
Dialogue: 0,0:21:48.01,0:21:49.80,Default,,0,0,0,,Не?
Dialogue: 0,0:21:51.76,0:21:54.68,Default,,0,0,0,,Менен түс! Уау (Сунео) Джан!
Dialogue: 0,0:21:54.81,0:21:58.69,Default,,0,0,0,,(Сунео мен Джианның үрейленген дауыстары)
Dialogue: 0,0:21:59.69,0:22:02.86,Default,,0,0,0,,Ха ха ха... Ха, мен құтқарылдым.
Dialogue: 0,0:22:02.98,0:22:04.82,Default,,0,0,0,,Бірақ Джиан?
Dialogue: 0,0:22:04.94,0:22:06.07,Default,,0,0,0,,Ой, бұл не деген жігіттер!
Dialogue: 0,0:22:11.66,0:22:13.70,Default,,0,0,0,,(Нобита мен оның достарының айқайы)
Dialogue: 0,0:22:13.83,0:22:16.46,Default,,0,0,0,,Мен өттім...
Dialogue: 0,0:22:16.58,0:22:17.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:33.89,0:22:35.72,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:22:35.85,0:22:37.14,Default,,0,0,0,,Иә? Әй, Баспропеллер!
Dialogue: 0,0:22:37.27,0:22:39.56,Default,,0,0,0,,Ах, батарея бітті. Түсейік.
Dialogue: 0,0:22:39.69,0:22:43.57,Default,,0,0,0,,Ах~
Dialogue: 0,0:22:44.07,0:22:46.65,Default,,0,0,0,,(Үш адам айғайлайды)
Dialogue: 0,0:22:47.32,0:22:49.20,Default,,0,0,0,,Амансың ба? (Нобита) әйтеуір
Dialogue: 0,0:22:49.32,0:22:51.11,Default,,0,0,0,,Ах (Дораэмон/Шидзука) Ах!
Dialogue: 0,0:22:52.32,0:22:54.08,Default,,0,0,0,,Уау~
Dialogue: 0,0:23:02.33,0:23:04.96,Default,,0,0,0,,Демек, бұл аранжировка.
Dialogue: 0,0:23:07.76,0:23:08.88,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:23:09.30,0:23:12.76,Default,,0,0,0,,Кококо… Кококо~
Dialogue: 0,0:23:12.89,0:23:14.64,Default,,0,0,0,,Мендри мырза
Dialogue: 0,0:23:15.43,0:23:17.64,Default,,0,0,0,,Бұл жедел жеткізу.
Dialogue: 0,0:23:18.52,0:23:20.52,Default,,0,0,0,,Иә (Мендри) Еңбегіңізге рахмет.
Dialogue: 0,0:23:20.64,0:23:23.61,Default,,0,0,0,,Ал, әтеш мырзадан.
Dialogue: 0,0:23:24.15,0:23:25.40,Default,,0,0,0,,А, асығыңыз, асығыңыз (Нобита және т.б.) Иә?
Dialogue: 0,0:23:25.77,0:23:27.69,Default,,0,0,0,,Тез өтіңізші, Лейлек мырза.
Dialogue: 0,0:23:27.82,0:23:30.07,Default,,0,0,0,,Жұмыртқа туатын сияқты.
Dialogue: 0,0:23:30.20,0:23:31.82,Default,,0,0,0,,Иә Иә Иә
Dialogue: 0,0:23:31.95,0:23:35.45,Default,,0,0,0,,А~ Асығыңыз, асығыңыз! иә иә
Dialogue: 0,0:23:35.83,0:23:38.70,Default,,0,0,0,,Аға, бұл лейлектің акушеркасы ғой.
Dialogue: 0,0:23:38.83,0:23:41.46,Default,,0,0,0,,Пеликан пошташысы да тамаша жарасады.
Dialogue: 0,0:23:41.58,0:23:45.13,Default,,0,0,0,,Қарасам, бұл Гусуке тұратын дүние.
Dialogue: 0,0:23:45.59,0:23:48.34,Default,,0,0,0,,Құс-адам әлемі шынымен де болған
Dialogue: 0,0:23:48.88,0:23:50.30,Default,,0,0,0,,Онда қозғалма! (Нобита және басқалар) Ха!
Dialogue: 0,0:23:50.63,0:23:51.68,Default,,0,0,0,,Уау
Dialogue: 0,0:23:51.80,0:23:53.26,Default,,0,0,0,,Балалар сендер қайдан келдіңдер?
Dialogue: 0,0:23:53.84,0:23:56.56,Default,,0,0,0,,О? Неліктен адамдар бар?
Dialogue: 0,0:23:56.68,0:23:58.68,Default,,0,0,0,,Капитан, бұл мысық.
Dialogue: 0,0:23:59.10,0:24:01.14,Default,,0,0,0,,Хмф, бұл рас, бұл мысық.
Dialogue: 0,0:24:01.64,0:24:03.02,Default,,0,0,0,,Уф
Dialogue: 0,0:24:03.15,0:24:06.02,Default,,0,0,0,,Енот емес, мысық деді.
Dialogue: 0,0:24:06.15,0:24:08.15,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:24:08.28,0:24:10.94,Default,,0,0,0,,Дораемон, бұл таңданатын уақыт емес.
Dialogue: 0,0:24:11.28,0:24:12.90,Default,,0,0,0,,Мысықтар – құстардың үлкен жауы
Dialogue: 0,0:24:13.49,0:24:15.32,Default,,0,0,0,,Мені ұстаңыз! Уау, қашып кет!
Dialogue: 0,0:24:15.82,0:24:18.41,Default,,0,0,0,,Уау~ О, ауырып тұр! Асықшы!
Dialogue: 0,0:24:18.54,0:24:21.45,Default,,0,0,0,,Күте тұрыңыз! Күте тұрыңыз!
Dialogue: 0,0:24:22.62,0:24:24.58,Default,,0,0,0,,Мен қайда жүгіруім керек?
Dialogue: 0,0:24:24.71,0:24:26.67,Default,,0,0,0,,Дорэмон, бірдеңе істе.
Dialogue: 0,0:24:27.04,0:24:30.21,Default,,0,0,0,,Хаха...
Dialogue: 0,0:24:30.34,0:24:31.55,Default,,0,0,0,,Котенка сонда бара жатыр
Dialogue: 0,0:24:32.17,0:24:34.84,Default,,0,0,0,,Не, сен мен туралы айтып тұрсың ба?
Dialogue: 0,0:24:34.97,0:24:35.89,Default,,0,0,0,,Дораэмон тез!
Dialogue: 0,0:24:36.34,0:24:38.35,Default,,0,0,0,,Егер сіз асығыс болсаңыз, түйеқұс таксиге отырыңыз.
Dialogue: 0,0:24:38.72,0:24:41.89,Default,,0,0,0,,Такси? Әзірге атқа мінейік
Dialogue: 0,0:24:42.02,0:24:44.77,Default,,0,0,0,,Қаншалықты? Асығыңыз және алға ұмтылыңыз!
Dialogue: 0,0:24:45.23,0:24:48.40,Default,,0,0,0,,Сәлем! Пуппу (Нобита және оның достары) Уау!
Dialogue: 0,0:24:48.52,0:24:49.73,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:24:50.07,0:24:50.94,Default,,0,0,0,,Алып-соғуға болмайды
Dialogue: 0,0:24:51.07,0:24:53.20,Default,,0,0,0,,Мықтап ұстаңыз.
Dialogue: 0,0:24:53.57,0:24:55.61,Default,,0,0,0,,Ханым, өзіңізді қалай сезінесіз?
Dialogue: 0,0:24:55.91,0:24:58.74,Default,,0,0,0,,Маған бұл шаш үлгісі қатты ұнайды.
Dialogue: 0,0:24:58.87,0:25:01.04,Default,,0,0,0,,Рахмет (ханым).
Dialogue: 0,0:25:01.49,0:25:04.71,Default,,0,0,0,,Сау болыңыз (Ханымның гуілдеуі)
Dialogue: 0,0:25:04.83,0:25:06.92,Default,,0,0,0,,Puppuu
Dialogue: 0,0:25:07.04,0:25:08.46,Default,,0,0,0,,Мен шынымен де мықты энергияны сезіп тұрмын!
Dialogue: 0,0:25:09.17,0:25:11.55,Default,,0,0,0,,Таксимен жүру қандай қиын!
Dialogue: 0,0:25:11.67,0:25:13.88,Default,,0,0,0,,Күте тұрыңыз! (Ханым) Кя!
Dialogue: 0,0:25:16.22,0:25:19.30,Default,,0,0,0,,Тағы не! Хмф!
Dialogue: 0,0:25:19.76,0:25:20.51,Default,,0,0,0,,Ах
Dialogue: 0,0:25:21.81,0:25:25.52,Default,,0,0,0,,Иә, барлығыңыз сапқа тұрыңыздар.
Dialogue: 0,0:25:25.64,0:25:26.94,Default,,0,0,0,,Ха, не болды?
Dialogue: 0,0:25:27.06,0:25:29.52,Default,,0,0,0,,Жылдам жүгір, олай істемейді.
Dialogue: 0,0:25:29.81,0:25:34.57,Default,,0,0,0,,Енді ақырын 1 2 кесіп өтейік
Dialogue: 0,0:25:36.24,0:25:37.41,Default,,0,0,0,,Ах Дораемон
Dialogue: 0,0:25:38.70,0:25:39.95,Default,,0,0,0,,Біз жетеміз!
Dialogue: 0,0:25:40.08,0:25:41.83,Default,,0,0,0,,Мына көшеге кіріңіз!
Dialogue: 0,0:25:41.95,0:25:44.12,Default,,0,0,0,,Сәлем! Пупупупу
Dialogue: 0,0:25:45.41,0:25:46.41,Default,,0,0,0,,Міне бітті!
Dialogue: 0,0:25:46.54,0:25:47.75,Default,,0,0,0,,Күте тұрыңыз! (2-топ мүшесі) Chase!
Dialogue: 0,0:25:48.33,0:25:51.71,Default,,0,0,0,,Бұдан әрі жол тар болады, сондықтан қатты ұстаңыз.
Dialogue: 0,0:25:52.21,0:25:53.76,Default,,0,0,0,,Пупу
Dialogue: 0,0:25:53.88,0:25:55.01,Default,,0,0,0,,Ах
Dialogue: 0,0:25:59.97,0:26:01.14,Default,,0,0,0,,Басыңызды иіңіз! Уау
Dialogue: 0,0:26:03.14,0:26:04.68,Default,,0,0,0,,(Мүшелердің айқайы)
Dialogue: 0,0:26:05.02,0:26:07.48,Default,,0,0,0,,(Мүшелердің ыңырануы)
Dialogue: 0,0:26:07.94,0:26:09.60,Default,,0,0,0,,Уау!
Dialogue: 0,0:26:10.48,0:26:13.07,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз күзетшілерді сәтті орналастырмадыңыз ба?
Dialogue: 0,0:26:13.19,0:26:14.07,Default,,0,0,0,,Рахмет
Dialogue: 0,0:26:14.32,0:26:15.53,Default,,0,0,0,,О, о!
Dialogue: 0,0:26:15.99,0:26:19.49,Default,,0,0,0,,Ах!
Dialogue: 0,0:26:20.12,0:26:22.41,Default,,0,0,0,,Мен сарапшымын~
Dialogue: 0,0:26:22.99,0:26:24.33,Default,,0,0,0,,Уау (Нобита) Уау!
Dialogue: 0,0:26:35.80,0:26:37.42,Default,,0,0,0,,Иә, құрғақ.
Dialogue: 0,0:26:37.55,0:26:39.22,Default,,0,0,0,,Енді не істеуіміз керек?
Dialogue: 0,0:26:39.34,0:26:42.10,Default,,0,0,0,,Қалай болғанда да, біз Гиандарды табуымыз керек.
Dialogue: 0,0:26:44.85,0:26:47.23,Default,,0,0,0,,Иә? (Нобита) Ха, бұл керемет ғимарат.
Dialogue: 0,0:26:55.65,0:26:57.07,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:26:57.57,0:26:58.65,Default,,0,0,0,,Уау, біреу келе жатыр.
Dialogue: 0,0:26:58.78,0:26:59.99,Default,,0,0,0,,Осы жерге тығылайық (Нобита) Иә.
Dialogue: 0,0:27:00.70,0:27:03.20,Default,,0,0,0,,Менің сезімім өзгерген жоқ
Dialogue: 0,0:27:06.20,0:27:09.66,Default,,0,0,0,,Адам басып алды деп мені шақырма.
Dialogue: 0,0:27:11.54,0:27:15.75,Default,,0,0,0,,Олай болса, менің үйіме қайтып келе аласыз ба?
Dialogue: 0,0:27:15.88,0:27:18.17,Default,,0,0,0,,Иә, мен ақылдымын.
Dialogue: 0,0:27:19.01,0:27:20.59,Default,,0,0,0,,Хамф, бұл ауыр...
Dialogue: 0,0:27:21.01,0:27:22.80,Default,,0,0,0,,Мүлдем алаңдатады
Dialogue: 0,0:27:22.93,0:27:25.76,Default,,0,0,0,,Зигрид нені ойлайды? Апыр-ай.
Dialogue: 0,0:27:31.73,0:27:34.61,Default,,0,0,0,,(Үш қорқынышты дауыс)
Dialogue: 0,0:27:51.37,0:27:52.92,Default,,0,0,0,,Жоқ, еңбегіңіз үшін рахмет.
Dialogue: 0,0:27:53.04,0:27:55.42,Default,,0,0,0,,Бүгін енді шықпайтын шығармын.
Dialogue: 0,0:28:03.72,0:28:08.35,Default,,0,0,0,,Жарайды, жарайды, ішке кірейік.
Dialogue: 0,0:28:09.02,0:28:10.89,Default,,0,0,0,,Ақпаратты алуға болады
Dialogue: 0,0:28:11.02,0:28:11.81,Default,,0,0,0,,барлығын бірге орналастырыңыз.
Dialogue: 0,0:28:12.52,0:28:15.73,Default,,0,0,0,,Бұл археологтың үйі болса керек.
Dialogue: 0,0:28:16.23,0:28:18.98,Default,,0,0,0,,Эй, Декисуги маған мынаны көрсетті...
Dialogue: 0,0:28:19.11,0:28:20.49,Default,,0,0,0,,Ол Хорус мүсініне ұқсайды.
Dialogue: 0,0:28:21.19,0:28:24.32,Default,,0,0,0,,Ежелден жермен байланысты екенін білдіреді...
Dialogue: 0,0:28:24.45,0:28:25.41,Default,,0,0,0,,Кя! Ах!
Dialogue: 0,0:28:25.53,0:28:29.04,Default,,0,0,0,,Уау! Әй, бәрі!
Dialogue: 0,0:28:29.41,0:28:30.62,Default,,0,0,0,,Гусуке!
Dialogue: 0,0:28:30.75,0:28:33.25,Default,,0,0,0,,Неге мұндасың? (Нобита) Артыңнан келсем...
Dialogue: 0,0:28:33.54,0:28:37.34,Default,,0,0,0,,Хоу Хоу Бұл әдеттен тыс
Dialogue: 0,0:28:38.13,0:28:40.84,Default,,0,0,0,,Адам баласы...
Dialogue: 0,0:28:40.96,0:28:42.26,Default,,0,0,0,,Ракон-кун, о
Dialogue: 0,0:28:42.38,0:28:45.22,Default,,0,0,0,,Мен Дораемонмын
Dialogue: 0,0:28:45.34,0:28:47.55,Default,,0,0,0,,Бұл мысық тәрізді робот.
Dialogue: 0,0:28:47.68,0:28:51.14,Default,,0,0,0,,Нобита-кун, Шизука-сан, барлығы құтқарушы.
Dialogue: 0,0:28:51.85,0:28:54.06,Default,,0,0,0,,Менің ең жақын досым доктор Хоу
Dialogue: 0,0:28:54.19,0:28:56.15,Default,,0,0,0,,Хоу Хоу
Dialogue: 0,0:28:56.27,0:28:59.65,Default,,0,0,0,,Гусуке, сен рұқсатсыз қайтадан адам әлеміне шықтың.
Dialogue: 0,0:29:00.02,0:29:01.23,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:29:01.36,0:29:03.07,Default,,0,0,0,,Сонда бұл екеуі ше?
Dialogue: 0,0:29:03.45,0:29:06.66,Default,,0,0,0,,А, қарға күзетшісі шығар...
Dialogue: 0,0:29:25.72,0:29:27.05,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:29:27.18,0:29:29.60,Default,,0,0,0,,Мені бұл жерден кетіріңіз!
Dialogue: 0,0:29:29.72,0:29:32.47,Default,,0,0,0,,Конняро! Мен сені дірілдетемін!
Dialogue: 0,0:29:33.43,0:29:34.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:36.81,0:29:39.94,Default,,0,0,0,,Бұл адамдар, директор Зигрид.
Dialogue: 0,0:29:40.32,0:29:41.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:29:41.44,0:29:44.86,Default,,0,0,0,,А... сіз бастықсыз ба? Бұл жерден кетіңіз!
Dialogue: 0,0:29:45.40,0:29:48.32,Default,,0,0,0,,Бұл жауыздық шын мәнінде адамға тән
Dialogue: 0,0:29:48.87,0:29:50.66,Default,,0,0,0,,Сізге қалай ұнайды?
Dialogue: 0,0:29:50.78,0:29:53.79,Default,,0,0,0,,Адам болса, сотқа жүгінудің қажеті болмас еді.
Dialogue: 0,0:29:54.33,0:29:57.87,Default,,0,0,0,,Мені дереу орындаңыз (Сунео) Орындау?
Dialogue: 0,0:29:58.00,0:30:00.00,Default,,0,0,0,,Бұлай істеуге қалай батылы бардың!
Dialogue: 0,0:30:00.46,0:30:01.84,Default,,0,0,0,,Не? (Сигрид) Сіз бұл сіздің таңдауыңыз деп айтасыз ба?
Dialogue: 0,0:30:01.96,0:30:04.09,Default,,0,0,0,,Адамдардың қалауы бойынша
Dialogue: 0,0:30:04.21,0:30:07.22,Default,,0,0,0,,Қанша құс қуғынға ұшырады деп ойлайсың?
Dialogue: 0,0:30:07.80,0:30:09.09,Default,,0,0,0,,Ертең орындаңыз
Dialogue: 0,0:30:11.10,0:30:13.52,Default,,0,0,0,,Эй, күте тұр!
Dialogue: 0,0:30:13.64,0:30:15.81,Default,,0,0,0,,Анашым! Эй, күт!
Dialogue: 0,0:30:16.56,0:30:17.77,Default,,0,0,0,,«Құс пирстері»!?
Dialogue: 0,0:30:18.10,0:30:23.23,Default,,0,0,0,,Қош бол, Құс пирстері адам әлемінен оқшауланған.
Dialogue: 0,0:30:23.61,0:30:24.78,Default,,0,0,0,,Какузецу дегеніміз не?
Dialogue: 0,0:30:24.90,0:30:26.95,Default,,0,0,0,,Бұл біздің шынымен бөлінгенімізді білдіреді.
Dialogue: 0,0:30:27.36,0:30:30.28,Default,,0,0,0,,Сіздің әлеміңіз «Құстар жолы» деп аталады.
Dialogue: 0,0:30:30.41,0:30:32.66,Default,,0,0,0,,Гиперкеңістік арқылы қосылған
Dialogue: 0,0:30:33.20,0:30:36.20,Default,,0,0,0,,Біреуі арғы тауға жалғанған.
Dialogue: 0,0:30:36.33,0:30:38.87,Default,,0,0,0,,Бірақ мен мұны неге осы уақытқа дейін білмедім?
Dialogue: 0,0:30:39.50,0:30:43.75,Default,,0,0,0,,Кіреберіс құс па? Тек біз құстар ғана білеміз.
Dialogue: 0,0:30:43.88,0:30:46.71,Default,,0,0,0,,Және олар бір орында тұрмайды.
Dialogue: 0,0:30:47.01,0:30:49.34,Default,,0,0,0,,Сондықтан оны көшеден таба алмайсың.
Dialogue: 0,0:30:49.47,0:30:52.51,Default,,0,0,0,,Эй, Таке-сан мен Сунео-сан, бізге бірдеңе істеу керек.
Dialogue: 0,0:30:52.64,0:30:53.93,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:30:54.39,0:30:59.06,Default,,0,0,0,,Білемін, бірақ осылай шыға берсем, мені тағы қуады.
Dialogue: 0,0:30:59.19,0:31:01.86,Default,,0,0,0,,Хмм, дұрыс!
Dialogue: 0,0:31:02.15,0:31:04.82,Default,,0,0,0,,Жаңа құс қалпақшасы
Dialogue: 0,0:31:05.32,0:31:09.53,Default,,0,0,0,,Осыны кисек, біз де құс адамдарының қатарына қосыламыз.
Dialogue: 0,0:31:09.65,0:31:10.78,Default,,0,0,0,,Иә
Dialogue: 0,0:31:11.28,0:31:15.24,Default,,0,0,0,,Мен үйрек мырзамын, мен аққу мырзамын.
Dialogue: 0,0:31:15.37,0:31:17.25,Default,,0,0,0,,Иә? О (Нобита) Ах, уах, уау
Dialogue: 0,0:31:17.75,0:31:20.71,Default,,0,0,0,,Уау! Қандай оғаш
Dialogue: 0,0:31:21.08,0:31:23.04,Default,,0,0,0,,Сіз ұша аласыз ба? Әрине
Dialogue: 0,0:31:23.17,0:31:26.13,Default,,0,0,0,,Уау! Хехе... Шынымен!
Dialogue: 0,0:31:26.80,0:31:30.59,Default,,0,0,0,,Олай болса, кеттік. Гусуке-кун, сен бізге айналаны көрсетесің бе?
Dialogue: 0,0:31:30.97,0:31:34.80,Default,,0,0,0,,Сол себепті Қар қазы сынып, ұша алмайды.
Dialogue: 0,0:31:34.93,0:31:35.81,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:31:35.93,0:31:38.22,Default,,0,0,0,,Онда менің арқама мін
Dialogue: 0,0:31:38.73,0:31:40.18,Default,,0,0,0,,Амансың ба? Дораемон
Dialogue: 0,0:31:40.56,0:31:42.10,Default,,0,0,0,,Олай болса, кеттік...
Dialogue: 0,0:31:42.23,0:31:43.48,Default,,0,0,0,,Уау! Ата
Dialogue: 0,0:31:43.61,0:31:47.11,Default,,0,0,0,,Аха, ұша алмау керек. Бұл пингвин қалпақ болды.
Dialogue: 0,0:31:48.19,0:31:51.20,Default,,0,0,0,,Уайымдама, бұл жолы Хатоның қалпағы.
Dialogue: 0,0:31:55.45,0:31:58.62,Default,,0,0,0,,Әй, саған қандай жаза болады?
Dialogue: 0,0:31:59.58,0:32:01.37,Default,,0,0,0,,Қаламды қалам 1000 рет
Dialogue: 0,0:32:01.50,0:32:04.33,Default,,0,0,0,,Анашым! Бұл жерден кетіңіз!
Dialogue: 0,0:32:05.34,0:32:07.71,Default,,0,0,0,,Мүмкін емес Мүмкін емес Ой
Dialogue: 0,0:32:07.84,0:32:09.30,Default,,0,0,0,,Эй, сәл күте тұрыңыз.
Dialogue: 0,0:32:09.59,0:32:11.76,Default,,0,0,0,,Шизуми добы
Dialogue: 0,0:32:12.26,0:32:15.68,Default,,0,0,0,,Мен бұл екеуінің батып кетуіне жол беремін, сондықтан мүмкіндікті пайдаланып, кілтті пайдаланамын.
Dialogue: 0,0:32:15.80,0:32:18.64,Default,,0,0,0,,Жарайды, солай.
Dialogue: 0,0:32:19.35,0:32:20.85,Default,,0,0,0,,Уф, жақын қалды...
Dialogue: 0,0:32:23.56,0:32:25.86,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:32:26.65,0:32:28.40,Default,,0,0,0,,Қазір!
Dialogue: 0,0:32:29.15,0:32:29.98,Default,,0,0,0,,Джан! (Отряд мүшесі) Әй
Dialogue: 0,0:32:30.07,0:32:30.86,Default,,0,0,0,,Сунео-сан! (Солдат) Не!
Dialogue: 0,0:32:31.32,0:32:34.57,Default,,0,0,0,,О, жан досы! (Сунео) О, жақсы.
Dialogue: 0,0:32:34.70,0:32:36.37,Default,,0,0,0,,Ешкім келмей тұрып, асығыңыз.
Dialogue: 0,0:32:36.49,0:32:37.70,Default,,0,0,0,,Әй, сен!
Dialogue: 0,0:32:38.16,0:32:40.66,Default,,0,0,0,,Ей, бұл сенің ісің, есіңде болсын!
Dialogue: 0,0:32:41.20,0:32:42.58,Default,,0,0,0,,Оны ұмыт
Dialogue: 0,0:32:42.71,0:32:44.58,Default,,0,0,0,,Мен сенен ұмытуыңды сұраймын...
Dialogue: 0,0:32:44.71,0:32:46.58,Default,,0,0,0,,Пап-пап-пап (мүшелер) Иә...
Dialogue: 0,0:32:46.71,0:32:49.55,Default,,0,0,0,,Иә? Біз не істеп жүр едік?
Dialogue: 0,0:32:49.67,0:32:50.59,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:32:50.80,0:32:52.01,Default,,0,0,0,,үшінмыз асығайық
Dialogue: 0,0:32:52.13,0:32:54.55,Default,,0,0,0,,Сау болыңыз, абайлаңыз.
Dialogue: 0,0:32:55.55,0:32:58.05,Default,,0,0,0,,Артық емес, үйге қайтайық.
Dialogue: 0,0:32:58.18,0:32:59.85,Default,,0,0,0,,Мұндағы жағдай осындай
Dialogue: 0,0:32:59.97,0:33:01.68,Default,,0,0,0,,Маған көбірек білу керек
Dialogue: 0,0:33:01.81,0:33:04.77,Default,,0,0,0,,Мен үшін бәріне қиындық тудырғаным үшін кешірім сұраймын.
Dialogue: 0,0:33:05.31,0:33:06.85,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:33:06.98,0:33:09.98,Default,,0,0,0,,Мен Гусукемен дос бола алдым.
Dialogue: 0,0:33:10.11,0:33:11.36,Default,,0,0,0,,Толығырақ қарастырайық
Dialogue: 0,0:33:12.03,0:33:14.74,Default,,0,0,0,,Менің атым «Госуке».
Dialogue: 0,0:33:14.86,0:33:17.03,Default,,0,0,0,,Біздің де міндетіміз...
Dialogue: 0,0:33:17.16,0:33:19.37,Default,,0,0,0,,Джан! Мен жол бойы келдім
Dialogue: 0,0:33:19.49,0:33:20.83,Default,,0,0,0,,Оқып көрейік
Dialogue: 0,0:33:21.33,0:33:24.50,Default,,0,0,0,,Дораемон, бізге де сол қалпақты бер.
Dialogue: 0,0:33:24.62,0:33:26.75,Default,,0,0,0,,Әрине иә
Dialogue: 0,0:33:30.21,0:33:33.05,Default,,0,0,0,,Хе! Тоқылдақ сунео үшін өте қолайлы
Dialogue: 0,0:33:33.17,0:33:36.47,Default,,0,0,0,,Мм! Ах, Джиан - альбатрос...
Dialogue: 0,0:33:36.59,0:33:38.18,Default,,0,0,0,,Не! Кім ақымақ?
Dialogue: 0,0:33:38.30,0:33:39.97,Default,,0,0,0,,Конняро! Ал, жақсы…
Dialogue: 0,0:33:40.10,0:33:41.18,Default,,0,0,0,,Енді жоқ (Нобита мен оның достары күледі)
Dialogue: 0,0:33:41.68,0:33:43.89,Default,,0,0,0,,(Нобита мен оның достарының күлкісі)
Dialogue: 0,0:33:44.02,0:33:45.60,Default,,0,0,0,,Эй, Джиан ше?
Dialogue: 0,0:33:45.73,0:33:48.15,Default,,0,0,0,,Альбатросқа жүгіру керек
Dialogue: 0,0:33:48.90,0:33:52.86,Default,,0,0,0,,Хмф... бұл! Мен жасадым
Dialogue: 0,0:33:53.44,0:33:56.32,Default,,0,0,0,,Уау, күткеніңізге рахмет.
Dialogue: 0,0:33:56.65,0:33:58.28,Default,,0,0,0,,Фухахаха хехехе
Dialogue: 0,0:34:03.70,0:34:05.87,Default,,0,0,0,,Бұл себеп болды ма?
Dialogue: 0,0:34:06.46,0:34:08.42,Default,,0,0,0,,Бірақ неге жай ғана адам?
Dialogue: 0,0:34:08.54,0:34:10.84,Default,,0,0,0,,Мен осыдан өтуім керек пе?
Dialogue: 0,0:34:11.17,0:34:15.67,Default,,0,0,0,,Хоу Себебі директор Зигрид адамдарды жек көреді.
Dialogue: 0,0:34:16.09,0:34:18.13,Default,,0,0,0,,Адамдар? Неліктен?
Dialogue: 0,0:34:19.01,0:34:20.60,Default,,0,0,0,,Оны мылтықпен атып өлтірді.
Dialogue: 0,0:34:20.93,0:34:22.26,Default,,0,0,0,,Иә!
Dialogue: 0,0:34:22.35,0:34:23.64,Default,,0,0,0,,Құс пирстері бар:
Dialogue: 0,0:34:23.77,0:34:26.93,Default,,0,0,0,,«Көшпелі құстардың патрульі» деген нәрсе бар.
Dialogue: 0,0:34:27.06,0:34:30.56,Default,,0,0,0,,Біз дүние жүзіндегі қоныс аударатын құстарды бақылаймыз.
Dialogue: 0,0:34:31.06,0:34:33.19,Default,,0,0,0,,Сен асырап алатын балалар санын көбейту керек дедің, бірақ бұл – басты себеп емес шығар?
Dialogue: 0,0:34:33.94,0:34:38.24,Default,,0,0,0,,Құстардың адаспастан өтуге мүмкіндік беретін ерекше қабілеттері бар.
Dialogue: 0,0:34:38.74,0:34:42.45,Default,,0,0,0,,Кейбір адамдар адасып қалады.
Dialogue: 0,0:34:43.08,0:34:47.91,Default,,0,0,0,,Менің міндетім осы құстарды дұрыс бағытқа бағыттап, қауіптен қорғау.
Dialogue: 0,0:34:48.37,0:34:50.88,Default,,0,0,0,,Бұл қоныс аударатын құстардың патрульі.
Dialogue: 0,0:34:53.04,0:34:55.00,Default,,0,0,0,,Сигрид патрульде
Dialogue: 0,0:34:55.13,0:34:58.09,Default,,0,0,0,,Қанатымды жүрексіз адам атып тастады.
Dialogue: 0,0:34:58.47,0:34:59.84,Default,,0,0,0,,Ой...
Dialogue: 0,0:34:59.97,0:35:03.55,Default,,0,0,0,,Содан бері ол адамдарды жек көре бастады.
Dialogue: 0,0:35:04.06,0:35:08.52,Default,,0,0,0,,Бастапқыда жер бетіндегі құстар мен адамдар бірге өмір сүруі керек.
Dialogue: 0,0:35:08.98,0:35:13.23,Default,,0,0,0,,Бізге қазір не істеу керек, бұған жету үшін не істей алатынымызды ойластырыңыз.
Dialogue: 0,0:35:13.98,0:35:17.40,Default,,0,0,0,,Біз де құспыз, сіз де адамбыз.
Dialogue: 0,0:35:17.99,0:35:19.78,Default,,0,0,0,,Иә... дұрыс.
Dialogue: 0,0:35:19.90,0:35:22.28,Default,,0,0,0,,Кешіріңіз, жоқ, жоқ
Dialogue: 0,0:35:22.41,0:35:26.33,Default,,0,0,0,,Мен де сен сияқты адамдар бар екенін білемін.
Dialogue: 0,0:35:26.45,0:35:28.70,Default,,0,0,0,,Гусуке көмектескеніңіз үшін рахмет.
Dialogue: 0,0:35:29.37,0:35:32.13,Default,,0,0,0,,Мен доктормен бірге Қар қазын салдым.
Dialogue: 0,0:35:32.25,0:35:35.92,Default,,0,0,0,,Ах~ Жоқ, көбін Гусүк бір өзі жасаған.
Dialogue: 0,0:35:36.05,0:35:38.13,Default,,0,0,0,,Менің мамандығым археология.
Dialogue: 0,0:35:39.01,0:35:41.47,Default,,0,0,0,,Мен тек ескі заттар бар деп ойладым.
Dialogue: 0,0:35:41.88,0:35:44.10,Default,,0,0,0,,О! Мен бұған қол тигізгім келмейді
Dialogue: 0,0:35:44.72,0:35:49.43,Default,,0,0,0,,Сізді қорқытқаным үшін кешіріңіз, бірақ бұл оңай құлап қалатын көне тас ескерткіш.
Dialogue: 0,0:35:50.43,0:35:53.48,Default,,0,0,0,,Бұл жерде Құс пирстерінің тағдырын өзгертуі мүмкін нәрсе бар.
Dialogue: 0,0:35:53.60,0:35:55.36,Default,,0,0,0,,Оған аңыз жазылған.
Dialogue: 0,0:35:55.69,0:35:57.19,Default,,0,0,0,,Сен асырап алатын балалар санын көбейту керек дедің, бірақ бұл – басты себеп емес шығар?
Dialogue: 0,0:35:57.32,0:36:00.32,Default,,0,0,0,,Өткен жылы Томариғи іргесінен қазылған.
Dialogue: 0,0:36:00.90,0:36:02.66,Default,,0,0,0,,«Томариги»? (Госуке) Иә, қараңыз.
Dialogue: 0,0:36:02.78,0:36:04.24,Default,,0,0,0,,Осыны айтып тұрсың (Сунео) Иә?
Dialogue: 0,0:36:05.87,0:36:08.49,Default,,0,0,0,,Уау!
Dialogue: 0,0:36:11.71,0:36:14.17,Default,,0,0,0,,Үстінде әрқашан бұлт бар
Dialogue: 0,0:36:14.29,0:36:15.50,Default,,0,0,0,,Ол «түтін белдеуі» деп аталады.
Dialogue: 0,0:36:16.04,0:36:19.71,Default,,0,0,0,,Оның ішінде ешкім болған емес.
Dialogue: 0,0:36:25.85,0:36:29.14,Default,,0,0,0,,Томариги құстар туылғаннан бері бізбен бірге.
Dialogue: 0,0:36:29.27,0:36:30.85,Default,,0,0,0,,Өсуін жалғастырады
Dialogue: 0,0:36:30.98,0:36:33.69,Default,,0,0,0,,Бірақ ол қаншалықты биік?
Dialogue: 0,0:36:33.81,0:36:37.19,Default,,0,0,0,,Жоғарғы жағында не бар екенін ешкім білмейді.
Dialogue: 0,0:37:00.25,0:37:03.59,Default,,0,0,0,,Бұл мен (Нобита және т.б.) Ху~
Dialogue: 0,0:37:04.18,0:37:05.97,Default,,0,0,0,,Алыста жүргеніме ашуланбайсың ба?
Dialogue: 0,0:37:06.09,0:37:10.01,Default,,0,0,0,,Жарайды, мен Қар қазына жаттығу жасап едім.
Dialogue: 0,0:37:10.14,0:37:12.27,Default,,0,0,0,,Ішке кір, Гусуке!
Dialogue: 0,0:37:12.39,0:37:13.06,Default,,0,0,0,,Әй?
Dialogue: 0,0:37:13.39,0:37:15.02,Default,,0,0,0,,Қайда болдың!
Dialogue: 0,0:37:15.69,0:37:17.65,Default,,0,0,0,,Уау! Эй, эй, эй, сүт!
Dialogue: 0,0:37:17.77,0:37:19.11,Default,,0,0,0,,Сүт-чан?
Dialogue: 0,0:37:20.19,0:37:22.07,Default,,0,0,0,,О, жаңа дос?
Dialogue: 0,0:37:22.86,0:37:25.86,Default,,0,0,0,,Танысқаныма қуаныштымын, мен көршім Сүт.
Dialogue: 0,0:37:25.99,0:37:27.66,Default,,0,0,0,,Сәлеметсіз бе, біз...
Dialogue: 0,0:37:27.78,0:37:29.99,Default,,0,0,0,,Гусүкені алып шыққан сендер болдыңдар!
Dialogue: 0,0:37:30.12,0:37:33.83,Default,,0,0,0,,Жоқ, мен Қар қазында жаттығатынмын...
Dialogue: 0,0:37:33.96,0:37:36.87,Default,,0,0,0,,Сақтамаңыз! Сен маған айтпай кетіп қалдың!
Dialogue: 0,0:37:37.00,0:37:39.17,Default,,0,0,0,,Гу Чанның қызына ұқсайды
Dialogue: 0,0:37:39.29,0:37:41.63,Default,,0,0,0,,Дұрыс (Дораэмонның тыныш күлкісі)
Dialogue: 0,0:37:44.38,0:37:48.43,Default,,0,0,0,,Жарайды, жарайды, егер Гусукенің досы болсаң, жарайсың.
Dialogue: 0,0:37:48.76,0:37:51.06,Default,,0,0,0,,үшінңыз кешкі ас ішіңіздер.
Dialogue: 0,0:37:51.18,0:37:53.22,Default,,0,0,0,,Анамның тағамы дәмді.
Dialogue: 0,0:37:53.35,0:37:56.64,Default,,0,0,0,,Сіз өте аңғалсыз, мен сізді көбірек ойлануға мәжбүрлеуім керек.
Dialogue: 0,0:37:56.98,0:37:58.19,Default,,0,0,0,,Уфуфу... (Госуке) А, ана.
Dialogue: 0,0:37:58.31,0:37:59.11,Default,,0,0,0,,Әкеңіз ше?
Dialogue: 0,0:37:59.23,0:38:03.82,Default,,0,0,0,,Директор Зигрид дәл қазір капитан Вавилонмен бірге.
Dialogue: 0,0:38:04.07,0:38:06.78,Default,,0,0,0,,Директор Зигрид келе жатыр ма?
Dialogue: 0,0:38:07.32,0:38:08.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:11.95,0:38:15.12,Default,,0,0,0,,Құжатқа қол қоюыңызды қалаймын.
Dialogue: 0,0:38:15.25,0:38:16.41,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:38:17.12,0:38:18.67,Default,,0,0,0,,Менің құс пирсімен
Dialogue: 0,0:38:18.79,0:38:21.38,Default,,0,0,0,,Жер бетіндегі барлық құстарды адамдардан қорға
Dialogue: 0,0:38:21.88,0:38:24.30,Default,,0,0,0,,Қорытынды жоспар келісімі
Dialogue: 0,0:38:24.42,0:38:25.88,Default,,0,0,0,,Хмм...
Dialogue: 0,0:38:26.01,0:38:27.80,Default,,0,0,0,,Қалғаны доктор Хоуда.
Dialogue: 0,0:38:28.30,0:38:33.72,Default,,0,0,0,,Конгресстен өту үшін сіздің Қоршаған ортаны қорғау жөніндегі хатшының қол қоюы жеткілікті.
Dialogue: 0,0:38:34.47,0:38:38.19,Default,,0,0,0,,Өкінішке орай, мен де бұл жоспармен келісе алмаймын.
Dialogue: 0,0:38:39.15,0:38:43.15,Default,,0,0,0,,Тағы да ойланыңыз: адамдар – құстардың ең үлкен жауы.
Dialogue: 0,0:38:44.15,0:38:47.11,Default,,0,0,0,,Бірақ бұл жоспар тым абайсызда.
Dialogue: 0,0:38:47.78,0:38:49.07,Default,,0,0,0,,Уф...
Dialogue: 0,0:38:49.32,0:38:51.49,Default,,0,0,0,,Хмм...
Dialogue: 0,0:38:53.78,0:38:54.99,Default,,0,0,0,,Уме
Dialogue: 0,0:38:55.54,0:38:57.54,Default,,0,0,0,,Сіз әлі де жақсы тамақтанасыз.
Dialogue: 0,0:38:57.66,0:38:59.46,Default,,0,0,0,,Бұл дәмді. Шағымданатын нәрсе бар ма?
Dialogue: 0,0:39:00.42,0:39:01.58,Default,,0,0,0,,Қайта толтыру Иә Иә
Dialogue: 0,0:39:02.04,0:39:04.50,Default,,0,0,0,,Мен де, иә, иә
Dialogue: 0,0:39:06.42,0:39:07.67,Default,,0,0,0,,Вуфуды ауыстыру
Dialogue: 0,0:39:08.13,0:39:10.93,Default,,0,0,0,,Қайта толтыру Иә Иә
Dialogue: 0,0:39:14.01,0:39:15.18,Default,,0,0,0,,Қайта толтыру Иә Иә
Dialogue: 0,0:39:15.43,0:39:17.73,Default,,0,0,0,,Уууу, Гу Чан да жеңілмейді.
Dialogue: 0,0:39:18.39,0:39:22.06,Default,,0,0,0,,Мен Икар жарысына қатысамын, сондықтан мен шыдамдылықты арттыруым керек.
Dialogue: 0,0:39:22.65,0:39:24.02,Default,,0,0,0,,«Икар жарысы» дегеніміз не?
Dialogue: 0,0:39:24.61,0:39:27.49,Default,,0,0,0,,Көшіп-қонушы құстарды патрульге қабылдау сынағы
Dialogue: 0,0:39:28.07,0:39:32.32,Default,,0,0,0,,Аты аңызға айналған құсшы Икардың атымен аталған.
Dialogue: 0,0:39:36.24,0:39:41.42,Default,,0,0,0,,Патруль мүшесі ретінде дағдыларыңыз, жылдамдығыңыз және төзімділігіңіз бойынша жарысыңыз.
Dialogue: 0,0:39:41.54,0:39:45.29,Default,,0,0,0,,Мен де ертең Қар қазындағы жарысқа қатысамын.
Dialogue: 0,0:39:45.42,0:39:47.92,Default,,0,0,0,,Хмм, сондықтан сіз қатты жаттығыңыз.
Dialogue: 0,0:39:48.05,0:39:49.01,Default,,0,0,0,,Фуфухахаха... (Госуке) Иә?
Dialogue: 0,0:39:49.13,0:39:50.05,Default,,0,0,0,,Га
Dialogue: 0,0:39:50.59,0:39:55.68,Default,,0,0,0,,Қанатты ұша алмайтын адам Икар жарысында жеңе алады деп ойлайсың ба?
Dialogue: 0,0:39:56.35,0:39:58.43,Default,,0,0,0,,Бұл жеңіл қабылданды.
Dialogue: 0,0:39:58.56,0:40:01.35,Default,,0,0,0,,Жарайды, ең болмағанда бар күшіңді салып көр.
Dialogue: 0,0:40:01.73,0:40:03.35,Default,,0,0,0,,Хаха...
Dialogue: 0,0:40:03.48,0:40:05.44,Default,,0,0,0,,Не, не! (Гусуке) Сүт!
Dialogue: 0,0:40:05.98,0:40:08.23,Default,,0,0,0,,Гусукенің ұша алмауының себебі бар.
Dialogue: 0,0:40:08.36,0:40:09.57,Default,,0,0,0,,Оған көмектесу мүмкін емес!
Dialogue: 0,0:40:10.15,0:40:11.53,Default,,0,0,0,,Аударма?
Dialogue: 0,0:40:31.76,0:40:32.68,Default,,0,0,0,,Ха!
Dialogue: 0,0:40:34.97,0:40:38.97,Default,,0,0,0,,(Госукенің айқайы)
Dialogue: 0,0:40:42.64,0:40:45.60,Default,,0,0,0,,Ах! Ха (Госуке жылап жатыр)
Dialogue: 0,0:40:53.45,0:40:55.49,Default,,0,0,0,,Олай болса, Гусуке...
Dialogue: 0,0:40:55.61,0:40:58.87,Default,,0,0,0,,Иә, егер сіз өз қанатыңызбен ұшуға тырыссаңыз
Dialogue: 0,0:40:58.99,0:41:01.58,Default,,0,0,0,,Сол қорқынышты кез есімде.
Dialogue: 0,0:41:02.04,0:41:05.04,Default,,0,0,0,,Түсіндім, құлағым да тістеп қалды.
Dialogue: 0,0:41:05.37,0:41:07.50,Default,,0,0,0,,Мен егеуқұйрықтардан қорқамын Мен қорқамын
Dialogue: 0,0:41:08.17,0:41:11.96,Default,,0,0,0,,Бірақ бәрібір, менде Қар қазы бар.
Dialogue: 0,0:41:12.09,0:41:15.30,Default,,0,0,0,,Дұрыс, өз күшіңмен ұшатындықтан да солай.
Dialogue: 0,0:41:15.80,0:41:18.47,Default,,0,0,0,,Эй, мен мүмкіндікті пайдаланып, Икармен жарысамын.
Dialogue: 0,0:41:18.60,0:41:20.39,Default,,0,0,0,,Гусукеге қолдау көрсетейік
Dialogue: 0,0:41:20.51,0:41:22.77,Default,,0,0,0,,Жақсы. (Госуке) Дұрыс!
Dialogue: 0,0:41:22.89,0:41:24.81,Default,,0,0,0,,Неліктен Нобита және басқалары қатыспайды?
Dialogue: 0,0:41:24.94,0:41:26.40,Default,,0,0,0,,Иә!? О!
Dialogue: 0,0:41:26.52,0:41:28.48,Default,,0,0,0,,Бұл қызықты емес пе?
Dialogue: 0,0:41:28.61,0:41:31.19,Default,,0,0,0,,шығасың ба!? Бұл бұрын болуы мүмкін еді.
Dialogue: 0,0:41:31.32,0:41:34.24,Default,,0,0,0,,Tacoros жарысына қатысу туралы шешім қабылданды!
Dialogue: 0,0:41:34.36,0:41:35.82,Default,,0,0,0,,Джан «Икар»
Dialogue: 0,0:41:35.95,0:41:38.12,Default,,0,0,0,,Не? Сегізаяқ немесе кальмар да жақсы.
Dialogue: 0,0:41:38.62,0:41:42.16,Default,,0,0,0,,Жоқ (Нобита мен оның достары күледі)
Dialogue: 0,0:41:42.29,0:41:44.33,Default,,0,0,0,,Олай болса, ертең жаттығу жасайық.
Dialogue: 0,0:41:44.75,0:41:47.37,Default,,0,0,0,,Жарайды, бүгін кешке ерте жатайық.
Dialogue: 0,0:41:47.50,0:41:49.79,Default,,0,0,0,,А, оның алдында не болды?
Dialogue: 0,0:41:50.38,0:41:52.76,Default,,0,0,0,,Айтпақшы, Гу-чан, әжетхана қайда?
Dialogue: 0,0:41:52.88,0:41:54.01,Default,,0,0,0,,Ая~
Dialogue: 0,0:41:54.92,0:41:57.80,Default,,0,0,0,,Ал, баспалдақпен төмен түс...
Dialogue: 0,0:41:59.55,0:42:01.39,Default,,0,0,0,,А, міне, міне, мынау.
Dialogue: 0,0:42:03.10,0:42:06.06,Default,,0,0,0,,Бұл дұрыс емес пе? иә?
Dialogue: 0,0:42:06.98,0:42:08.60,Default,,0,0,0,,Не?
Dialogue: 0,0:42:11.98,0:42:16.78,Default,,0,0,0,,Жұмыртқа! А, аа, аа
Dialogue: 0,0:42:17.45,0:42:19.57,Default,,0,0,0,,(Госукенің інісінің айқайы)
Dialogue: 0,0:42:19.95,0:42:22.54,Default,,0,0,0,,Ах! (Госукенің інісінің жылауы)
Dialogue: 0,0:42:22.91,0:42:24.50,Default,,0,0,0,,Уау!
Dialogue: 0,0:42:25.25,0:42:26.75,Default,,0,0,0,,Жоқ... не болды? Бірдеңе болды ма?
Dialogue: 0,0:42:26.87,0:42:28.67,Default,,0,0,0,,Не болды? Ахх сондай сүйкімді
Dialogue: 0,0:42:28.79,0:42:29.96,Default,,0,0,0,,Сунео сияқты
Dialogue: 0,0:42:30.33,0:42:33.05,Default,,0,0,0,,Әке, бұл бала.
Dialogue: 0,0:42:33.34,0:42:34.92,Default,,0,0,0,,Ол менің інім.
Dialogue: 0,0:42:35.26,0:42:36.59,Default,,0,0,0,,(Госукенің інісінің жылауы)
Dialogue: 0,0:42:36.72,0:42:38.38,Default,,0,0,0,,Не… не болады?
Dialogue: 0,0:42:48.60,0:42:50.77,Default,,0,0,0,,Хм... міне, солай!
Dialogue: 0,0:42:51.36,0:42:54.23,Default,,0,0,0,,...
Dialogue: 0,0:42:54.94,0:42:57.53,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:42:58.61,0:43:01.82,Default,,0,0,0,,«Фениция» Бұл қорқынышты.
Dialogue: 0,0:43:01.91,0:43:03.66,Default,,0,0,0,,Иә? Ол кім?
Dialogue: 0,0:43:07.50,0:43:09.33,Default,,0,0,0,,Бұл тек менің қиялым ба?
Dialogue: 0,0:43:13.13,0:43:17.21,Default,,0,0,0,,«Фениция» Сіз бұлай айтқаныңызға сенімдісіз бе?
Dialogue: 0,0:43:17.63,0:43:19.30,Default,,0,0,0,,Ха, доктор Хоу.
Dialogue: 0,0:43:19.43,0:43:22.68,Default,,0,0,0,,Сол тас ескерткішке қарап отырып анық айтқаны.
Dialogue: 0,0:43:23.14,0:43:26.43,Default,,0,0,0,,Ақыры Финикияның орналасқан жерін аштық.
Dialogue: 0,0:43:26.56,0:43:29.35,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:43:29.48,0:43:31.10,Default,,0,0,0,,Директор «Фениция» дегеніміз не?
Dialogue: 0,0:43:31.56,0:43:35.82,Default,,0,0,0,,Бұл баяғыда мөрленген ұлы держава туралы.
Dialogue: 0,0:43:36.82,0:43:39.78,Default,,0,0,0,,Доктор Хоу менімен бірге болды, өйткені мен оған ұстазым ретінде қарайтынмын.
Dialogue: 0,0:43:40.45,0:43:43.74,Default,,0,0,0,,Ол өз өмірін Финикияны зерттеуге арнады.
Dialogue: 0,0:43:44.07,0:43:46.70,Default,,0,0,0,,Сонда мен сол күшке ие болсам...
Dialogue: 0,0:43:47.16,0:43:49.75,Default,,0,0,0,,Сол қыңыр орта хатшысы
Dialogue: 0,0:43:49.87,0:43:51.67,Default,,0,0,0,,Бізге қарсы шыққандар
Dialogue: 0,0:43:52.42,0:43:55.59,Default,,0,0,0,,Қолыңызды немесе аяғыңызды пайдалана алмасаңыз да...
Dialogue: 0,0:43:55.71,0:43:59.76,Default,,0,0,0,,Айтпақшы, өлім жазасына кесілетін адамның қашып кеткенін айттыңыз ба?
Dialogue: 0,0:43:59.88,0:44:01.63,Default,,0,0,0,,Иә, кешіріңіз.
Dialogue: 0,0:44:02.30,0:44:05.64,Default,,0,0,0,,Күзеттегі адам не болғанын есіне түсірмейді.
Dialogue: 0,0:44:05.76,0:44:08.43,Default,,0,0,0,,Хмм... тағы екі адаммен
Dialogue: 0,0:44:08.56,0:44:10.39,Default,,0,0,0,,1 мысық расталды
Dialogue: 0,0:44:11.02,0:44:15.36,Default,,0,0,0,,Егер біздің жоспарларымыз адам әлеміне таралса, бұл қиын болар еді.
Dialogue: 0,0:44:16.15,0:44:18.73,Default,,0,0,0,,Тезірек (Вавилон қарғасы)
Dialogue: 0,0:44:20.15,0:44:21.90,Default,,0,0,0,,Бұл мүлде ақау…
Dialogue: 0,0:44:22.32,0:44:24.11,Default,,0,0,0,,Нухахаха...
Dialogue: 0,0:44:24.24,0:44:27.16,Default,,0,0,0,,Дахахаха...!
Dialogue: 0,0:44:41.80,0:44:45.05,Default,,0,0,0,,Мұнда адам әлемінен әкелінген құстар
Dialogue: 0,0:44:45.72,0:44:47.55,Default,,0,0,0,,Еркін өмір сүру
Dialogue: 0,0:44:48.22,0:44:51.10,Default,,0,0,0,,Зардап шеккен құстар сауығып кеткенде
Dialogue: 0,0:44:51.23,0:44:53.48,Default,,0,0,0,,Бастапқы әлемге қайта оралу.
Dialogue: 0,0:44:54.02,0:44:55.15,Default,,0,0,0,,Мүмкін солай шығар?
Dialogue: 0,0:44:55.27,0:44:57.48,Default,,0,0,0,,Бұл пингвиндер жаңалықтарда емес пе?
Dialogue: 0,0:44:57.61,0:45:01.15,Default,,0,0,0,,Бұл рас. О, Токи, бұл әдемі.
Dialogue: 0,0:45:01.69,0:45:04.20,Default,,0,0,0,,Жойылып бара жатқан асыл тұқымды құстар
Dialogue: 0,0:45:04.32,0:45:06.12,Default,,0,0,0,,Бір күні адам әлеміне қайта оралу
Dialogue: 0,0:45:06.91,0:45:10.29,Default,,0,0,0,,Бұл менің әкемнің қоршаған ортаны қорғау жөніндегі хатшысы ретіндегі жұмысы.
Dialogue: 0,0:45:10.41,0:45:11.58,Default,,0,0,0,,О, ой
Dialogue: 0,0:45:12.33,0:45:14.25,Default,,0,0,0,,Пико!
Dialogue: 0,0:45:14.42,0:45:16.17,Default,,0,0,0,,Уау
Dialogue: 0,0:45:16.33,0:45:19.38,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын (Нобита)
Dialogue: 0,0:45:19.75,0:45:21.84,Default,,0,0,0,,Қайда бардың деп қызық болдым.
Dialogue: 0,0:45:22.59,0:45:24.30,Default,,0,0,0,,Жаттығуды бастау уақыты келді
Dialogue: 0,0:45:24.76,0:45:26.26,Default,,0,0,0,,Оу!
Dialogue: 0,0:45:26.72,0:45:28.60,Default,,0,0,0,,Тыңдаңдар, Икар жарысы
Dialogue: 0,0:45:28.97,0:45:33.68,Default,,0,0,0,,Осы Орталық кеңседен бастаңыз және көрсетілгендей курсты айналып өтіңіз.
Dialogue: 0,0:45:33.81,0:45:38.61,Default,,0,0,0,,Қайтадан қайтып, Томаригидің түтін белдеуінің астына өтіңіз.
Dialogue: 0,0:45:38.73,0:45:40.48,Default,,0,0,0,,Өз қауырсыныңды тесіп ал
Dialogue: 0,0:45:41.15,0:45:42.86,Default,,0,0,0,,Бұл оңай емес пе?
Dialogue: 0,0:45:42.99,0:45:46.45,Default,,0,0,0,,Бұл жұмыс істемейді. Жолда көптеген кедергілер болады.
Dialogue: 0,0:45:47.28,0:45:49.16,Default,,0,0,0,,Қалай болғанда да, жылдамдық негізгі болып табылады.
Dialogue: 0,0:45:49.74,0:45:52.16,Default,,0,0,0,,Алдымен сол жердегі жартасқа жарысайық.
Dialogue: 0,0:45:52.29,0:45:53.08,Default,,0,0,0,,Оу!
Dialogue: 0,0:45:53.20,0:45:55.83,Default,,0,0,0,,Хахаха бұл! (Сунео/Нобита) Бұл!
Dialogue: 0,0:45:58.92,0:46:01.55,Default,,0,0,0,,Хахаха бұл! бұл!
Dialogue: 0,0:46:02.25,0:46:05.30,Default,,0,0,0,,Гусуке кеттік (Госуке) бастайық
Dialogue: 0,0:46:06.22,0:46:07.89,Default,,0,0,0,,Гусуке, жақсысың ба?
Dialogue: 0,0:46:08.47,0:46:11.35,Default,,0,0,0,,Бұл жақсы сезінеді, солай емес пе?
Dialogue: 0,0:46:14.85,0:46:15.93,Default,,0,0,0,,Уау!
Dialogue: 0,0:46:16.06,0:46:17.27,Default,,0,0,0,,Бұл жылдам
Dialogue: 0,0:46:18.02,0:46:20.31,Default,,0,0,0,,Уау уау~
Dialogue: 0,0:46:24.19,0:46:27.15,Default,,0,0,0,,Жоғалтпа, кеттік! (Нобита) Иә.
Dialogue: 0,0:46:32.91,0:46:34.50,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:46:35.00,0:46:36.79,Default,,0,0,0,,Бұл өте жылдам.
Dialogue: 0,0:46:36.91,0:46:39.46,Default,,0,0,0,,Егер сіз жылдамырақ болмасаңыз, сіз жеңе алмайсыз.
Dialogue: 0,0:46:39.92,0:46:43.00,Default,,0,0,0,,Маған қатысу керек~
Dialogue: 0,0:46:43.13,0:46:45.17,Default,,0,0,0,,Мен аздап тартынамын.
Dialogue: 0,0:46:45.30,0:46:46.42,Default,,0,0,0,,Мен де
Dialogue: 0,0:46:47.22,0:46:49.89,Default,,0,0,0,,Мен чемпионатты мақсат етіп отырмын, Гусуке.
Dialogue: 0,0:46:50.01,0:46:51.01,Default,,0,0,0,,Иә, онда.
Dialogue: 0,0:46:51.14,0:46:52.64,Default,,0,0,0,,Маған тағы 10 рет алға-артқа жүру керек.
Dialogue: 0,0:46:53.22,0:46:56.81,Default,,0,0,0,,Он рет!? Ах...
Dialogue: 0,0:47:20.96,0:47:24.38,Default,,0,0,0,,Мен ертең міндетті түрде жеңемін
Dialogue: 0,0:47:28.76,0:47:30.43,Default,,0,0,0,,Тарих тесті үшін екінші ұлымның ойын оқысам, ең жоғары балл аламын! Хе-хе-хе…》
Dialogue: 0,0:47:30.55,0:47:32.05,Default,,0,0,0,,(Әскерлердің үрейлі дауыстары)
Dialogue: 0,0:47:32.26,0:47:34.18,Default,,0,0,0,,Иә? Жоқ...?
Dialogue: 0,0:47:35.51,0:47:37.64,Default,,0,0,0,,Сонымен... мұнымен не істейсің?
Dialogue: 0,0:47:38.10,0:47:40.52,Default,,0,0,0,,Эй, тоқта! Хехе
Dialogue: 0,0:47:47.15,0:47:51.15,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:47:59.62,0:48:03.63,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:48:05.84,0:48:09.67,Default,,0,0,0,,Енді бұл Құс пирстерінің ең үлкен оқиғасы.
Dialogue: 0,0:48:09.80,0:48:14.05,Default,,0,0,0,,Икар жарысының басталатын уақыты тез жақындап келеді.
Dialogue: 0,0:48:14.55,0:48:18.14,Default,,0,0,0,,Орталық орындарда конференция комитетінің төрағасы, премьер-министр Отака және т.б.
Dialogue: 0,0:48:18.27,0:48:20.64,Default,,0,0,0,,Әр режиссердің жүзін көруге болады.
Dialogue: 0,0:48:21.02,0:48:24.77,Default,,0,0,0,,Сайысқа қатысушылар бастапқы нүктеге жиналып қойған.
Dialogue: 0,0:48:26.27,0:48:27.90,Default,,0,0,0,,үшінна сәттілік
Dialogue: 0,0:48:28.03,0:48:29.11,Default,,0,0,0,,Иә...
Dialogue: 0,0:48:29.23,0:48:31.57,Default,,0,0,0,,Маған қалдырыңыз (Сунео) Мен бар күшімді саламын
Dialogue: 0,0:48:32.24,0:48:34.28,Default,,0,0,0,,Доктор Хоу мұнда жоқ.
Dialogue: 0,0:48:34.41,0:48:36.03,Default,,0,0,0,,Сіз зерттеумен айналыспайсыз ба?
Dialogue: 0,0:48:36.37,0:48:38.49,Default,,0,0,0,,Сәттілік Гусуке!
Dialogue: 0,0:48:40.29,0:48:41.87,Default,,0,0,0,,Сәлем Гусуке
Dialogue: 0,0:48:42.00,0:48:43.96,Default,,0,0,0,,Эй, сен де қатысасың ба?
Dialogue: 0,0:48:44.71,0:48:48.21,Default,,0,0,0,,Қалай ойлайсың, мынандай хина шоколадты ұшақпен жеңе аласың ба?
Dialogue: 0,0:48:48.34,0:48:50.26,Default,,0,0,0,,Аяғына дейін ұша алсаң, Мақтаймын.
Dialogue: 0,0:48:50.38,0:48:51.47,Default,,0,0,0,,Балалар! (Тобио Цубакуру) О
Dialogue: 0,0:48:52.01,0:48:55.39,Default,,0,0,0,,Ер болсаң, сөзіңмен емес, нәсіліңмен күрес.
Dialogue: 0,0:48:55.97,0:48:57.14,Default,,0,0,0,,Не!
Dialogue: 0,0:48:57.26,0:48:59.85,Default,,0,0,0,,Не, Сүт, сен де қатысасың ба?
Dialogue: 0,0:48:59.97,0:49:00.97,Default,,0,0,0,,Әрине
Dialogue: 0,0:49:01.52,0:49:03.56,Default,,0,0,0,,Гусукенің бойтұмары ретінде.
Dialogue: 0,0:49:03.69,0:49:05.06,Default,,0,0,0,,Аха, солай ма?
Dialogue: 0,0:49:05.19,0:49:06.40,Default,,0,0,0,,(Тобио мен Цубакурудың күлкісі)
Dialogue: 0,0:49:06.52,0:49:08.94,Default,,0,0,0,,Жоқ! Қарап көріңізші
Dialogue: 0,0:49:09.07,0:49:10.15,Default,,0,0,0,,Сүт
Dialogue: 0,0:49:10.61,0:49:15.66,Default,,0,0,0,,Енді сіз күткен нәрсе - премьер-министр Отаканың ашылу туралы мәлімдемесі.
Dialogue: 0,0:49:17.87,0:49:19.58,Default,,0,0,0,,Ммм Гяхон
Dialogue: 0,0:49:20.16,0:49:25.04,Default,,0,0,0,,Көшіп-қонатын құстарды патрульдік командаға қабылдау сынағы
Dialogue: 0,0:49:25.17,0:49:27.17,Default,,0,0,0,,Икар жарысын ашу
Dialogue: 0,0:49:27.38,0:49:31.38,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:49:33.51,0:49:38.80,Default,,0,0,0,,Сынақтың шешімі капитан Вавилонға қалдырылады.
Dialogue: 0,0:49:43.31,0:49:46.48,Default,,0,0,0,,Қатыспайтын ойыншылар кетіңіздер. Қатыспайтын ойыншылар...
Dialogue: 0,0:49:46.85,0:49:49.48,Default,,0,0,0,,үшінна сәттілік (Нобита және т.б.) О!
Dialogue: 0,0:49:51.40,0:49:55.40,Default,,0,0,0,,(Фанфар)
Dialogue: 0,0:49:55.86,0:49:58.32,Default,,0,0,0,,Әр ойыншының позициясына қатысты
Dialogue: 0,0:49:58.62,0:49:59.49,Default,,0,0,0,,Хмм...
Dialogue: 0,0:49:59.74,0:50:00.74,Default,,0,0,0,,Уф...
Dialogue: 0,0:50:01.03,0:50:01.99,Default,,0,0,0,,Хмм
Dialogue: 0,0:50:02.37,0:50:04.25,Default,,0,0,0,,Дайындау…
Dialogue: 0,0:50:05.08,0:50:06.46,Default,,0,0,0,,Көкей!
Dialogue: 0,0:50:06.58,0:50:10.59,Default,,0,0,0,,(Ойыншылардың күш дауысы)
Dialogue: 0,0:50:21.26,0:50:23.89,Default,,0,0,0,,Келіңіздер~ Барлық ойыншылар бір уақытта ұшып кетті.
Dialogue: 0,0:50:24.98,0:50:27.52,Default,,0,0,0,,Кім жылдам оралады?
Dialogue: 0,0:50:27.64,0:50:31.82,Default,,0,0,0,,Ал Томаригиге бірінші болып қауырсынды кім жабыстырады?
Dialogue: 0,0:50:41.70,0:50:44.75,Default,,0,0,0,,А, мінекей.
Dialogue: 0,0:50:57.13,0:50:59.01,Default,,0,0,0,,(Нобитаның айқайы)
Dialogue: 0,0:51:05.97,0:51:09.39,Default,,0,0,0,,Уау Уау... Уау!
Dialogue: 0,0:51:09.52,0:51:10.52,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:51:11.27,0:51:14.78,Default,,0,0,0,,Уф~ бітті
Dialogue: 0,0:51:22.95,0:51:27.41,Default,,0,0,0,,Табанды бол, Госуке, бірақ бұл мүмкін емес.
Dialogue: 0,0:51:27.62,0:51:28.58,Default,,0,0,0,,Хмм!
Dialogue: 0,0:51:29.79,0:51:31.92,Default,,0,0,0,,Иә, керемет
Dialogue: 0,0:51:34.71,0:51:36.30,Default,,0,0,0,,Уф, олай етпе
Dialogue: 0,0:51:36.42,0:51:39.80,Default,,0,0,0,,(Сунео мен Джанның айқайы)
Dialogue: 0,0:51:40.09,0:51:42.97,Default,,0,0,0,,(Ойыншының ауыр тыныс алуы)
Dialogue: 0,0:51:43.47,0:51:45.93,Default,,0,0,0,,Бұл қауіпті болды (Госукенің інісінің айқайы)
Dialogue: 0,0:51:46.06,0:51:47.89,Default,,0,0,0,,Уау! Ой... (2 адам) Уау!
Dialogue: 0,0:51:48.02,0:51:50.69,Default,,0,0,0,,Сунео, жақсысың ба? (Сунео) әйтеуір
Dialogue: 0,0:52:55.08,0:52:56.79,Default,,0,0,0,,Ах! Уф...
Dialogue: 0,0:52:56.92,0:52:58.84,Default,,0,0,0,,Әй, сүт!
Dialogue: 0,0:52:59.25,0:53:02.17,Default,,0,0,0,,Жарайды, жүре бер.
Dialogue: 0,0:53:02.34,0:53:04.55,Default,,0,0,0,,Ха ха ха!
Dialogue: 0,0:53:05.43,0:53:08.01,Default,,0,0,0,,(сүт айқайы)
Dialogue: 0,0:53:08.81,0:53:10.39,Default,,0,0,0,,(Джианның күш айқайы)
Dialogue: 0,0:53:10.52,0:53:12.52,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:53:15.60,0:53:17.44,Default,,0,0,0,,Ата... Ха...
Dialogue: 0,0:53:17.86,0:53:20.07,Default,,0,0,0,,Сүт Бұл жерде қауіпті.
Dialogue: 0,0:53:20.19,0:53:21.69,Default,,0,0,0,,Бұл жерден тез кетейік
Dialogue: 0,0:53:21.82,0:53:23.40,Default,,0,0,0,,Иә... иә
Dialogue: 0,0:53:27.70,0:53:31.62,Default,,0,0,0,,Уау, мен Гусуке мен басқаларды енді көре алмаймын.
Dialogue: 0,0:53:31.75,0:53:33.54,Default,,0,0,0,,Сүт, жақсысың ба?
Dialogue: 0,0:53:34.46,0:53:38.04,Default,,0,0,0,,Мен жақсы ұша алмаймын, өйткені қанаттарым өрмекшінің торына тоғысқан.
Dialogue: 0,0:53:38.17,0:53:40.50,Default,,0,0,0,,Балалар, бірінші барыңдар.
Dialogue: 0,0:53:40.88,0:53:42.30,Default,,0,0,0,,Уф (Джан Сунео) Ах!
Dialogue: 0,0:53:42.71,0:53:46.59,Default,,0,0,0,,Гусуке, мен үшін қолыңнан келгеннің бәрін жаса.
Dialogue: 0,0:53:48.60,0:53:50.76,Default,,0,0,0,,Бүгінгі жағдайда ол профессор Годжо немесе сондай біреу болар еді.
Dialogue: 0,0:53:57.81,0:54:00.19,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:54:00.65,0:54:03.57,Default,,0,0,0,,Уау~ Жоғарғы топ қайтып келді.
Dialogue: 0,0:54:03.69,0:54:05.61,Default,,0,0,0,,Томаригиге соңғы серпілу ғана қалды.
Dialogue: 0,0:54:06.11,0:54:08.70,Default,,0,0,0,,Соңғы соққы!
Dialogue: 0,0:54:10.66,0:54:13.75,Default,,0,0,0,,(Екі адам ауыр тыныс алуда)
Dialogue: 0,0:54:17.62,0:54:18.67,Default,,0,0,0,,Уау!
Dialogue: 0,0:54:18.79,0:54:22.17,Default,,0,0,0,,(Гусукенің айқайы)
Dialogue: 0,0:54:23.09,0:54:27.13,Default,,0,0,0,,Ха ха ха... Шүкір!
Dialogue: 0,0:54:33.56,0:54:36.06,Default,,0,0,0,,Ха ха ха!
Dialogue: 0,0:54:39.52,0:54:40.86,Default,,0,0,0,,Ха, ә!?
Dialogue: 0,0:54:45.82,0:54:49.41,Default,,0,0,0,,(қарлығаштың ауыр тынысы)
Dialogue: 0,0:54:49.53,0:54:53.45,Default,,0,0,0,,Осындай құралдарды пайдаланып көңіл көтеріңіз...
Dialogue: 0,0:54:53.58,0:54:54.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:54:54.37,0:54:58.37,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:55:05.30,0:55:06.80,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:55:06.92,0:55:10.30,Default,,0,0,0,,(Гусукенің айқайы)
Dialogue: 0,0:55:10.93,0:55:13.43,Default,,0,0,0,,Ах... Қаз...
Dialogue: 0,0:55:14.51,0:55:15.52,Default,,0,0,0,,Мен жеңіліске жол бере алмаймын!
Dialogue: 0,0:55:18.77,0:55:20.90,Default,,0,0,0,,Хаха...
Dialogue: 0,0:55:21.02,0:55:23.31,Default,,0,0,0,,Бүгінгі жағдайда ол профессор Годжо немесе сондай біреу болар еді.
Dialogue: 0,0:55:31.95,0:55:33.62,Default,,0,0,0,,Құт (гусуке) Ууууу
Dialogue: 0,0:55:34.78,0:55:36.58,Default,,0,0,0,,Таа!
Dialogue: 0,0:55:36.95,0:55:38.58,Default,,0,0,0,,Хмф! Ах!
Dialogue: 0,0:55:39.04,0:55:40.25,Default,,0,0,0,,Ха...
Dialogue: 0,0:55:51.43,0:55:55.97,Default,,0,0,0,,Дәл осындай келу! Бұл галстук. Жеңімпаздар - Цубакуру мен Гусуке.
Dialogue: 0,0:55:56.39,0:55:59.39,Default,,0,0,0,,Жеңімпаздар - Цубакуру мен Гусуке.
Dialogue: 0,0:55:59.52,0:56:01.10,Default,,0,0,0,,Мен жасадым, Гу Чан.
Dialogue: 0,0:56:01.23,0:56:03.35,Default,,0,0,0,,Жеңіске жету ғажап.
Dialogue: 0,0:56:03.48,0:56:05.61,Default,,0,0,0,,Сен қаз
Dialogue: 0,0:56:05.73,0:56:08.36,Default,,0,0,0,,Аа, жарайсың, өте жақсы
Dialogue: 0,0:56:16.70,0:56:18.08,Default,,0,0,0,,(тікелей түсініктеме дыбысы)
Dialogue: 0,0:56:18.37,0:56:21.04,Default,,0,0,0,,Жеңімпаз Цубакуро Гуосуке
Dialogue: 0,0:56:21.16,0:56:23.04,Default,,0,0,0,,Құтты болсын! Құтты болсын! Қол шапалақтау!
Dialogue: 0,0:56:23.67,0:56:27.00,Default,,0,0,0,,Және әрбір қатысушы ойыншыға жылы лебіздер.
Dialogue: 0,0:56:31.13,0:56:32.88,Default,,0,0,0,,Сіз мұны жасадыңыз Гусуке (Госуке) Иә.
Dialogue: 0,0:56:33.01,0:56:35.76,Default,,0,0,0,,Таке-сан да, Сунео-сан да барын салды.
Dialogue: 0,0:56:36.22,0:56:38.64,Default,,0,0,0,,Мен Гусукемен бәсекеге түсе алмаймын.
Dialogue: 0,0:56:38.77,0:56:40.60,Default,,0,0,0,,Мен де Нобитаға қарағанда жақсымын, солай ма?
Dialogue: 0,0:56:40.73,0:56:42.23,Default,,0,0,0,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,0:56:42.89,0:56:43.73,Default,,0,0,0,,(айқай)
Dialogue: 0,0:56:43.85,0:56:45.48,Default,,0,0,0,,(үшін күледі)
Dialogue: 0,0:56:45.61,0:56:49.28,Default,,0,0,0,,Ех~ Ағымдағы жарыс нәтижелерінде өзгеріс болды.
Dialogue: 0,0:56:49.90,0:56:52.70,Default,,0,0,0,,Енді капитан Вавилон презентация жасайды.
Dialogue: 0,0:56:53.57,0:56:58.16,Default,,0,0,0,,Баршаңызға, Гусукенің жеңісі шын мәнінде таңдануға тұрарлық.
Dialogue: 0,0:56:58.54,0:57:03.58,Default,,0,0,0,,Оның ұшуы өз қанатымен емес, жасанды қанаттарымен жасалды.
Dialogue: 0,0:57:04.25,0:57:08.29,Default,,0,0,0,,Біз мұны нағыз жеңімпаз деп қабылдай аламыз ба?
Dialogue: 0,0:57:09.17,0:57:12.26,Default,,0,0,0,,Ұлы Икардың атына кір келтірмеу үшін
Dialogue: 0,0:57:12.51,0:57:15.18,Default,,0,0,0,,Өкінішке орай, Гусуке дисквалификацияланды...
Dialogue: 0,0:57:15.55,0:57:16.64,Default,,0,0,0,,Эх!
Dialogue: 0,0:57:17.26,0:57:20.10,Default,,0,0,0,,Бір ойыншы, Цубакуру жеңімпаз болады.
Dialogue: 0,0:57:20.22,0:57:22.39,Default,,0,0,0,,(аудиторияның қошеметі мен қошеметі)
Dialogue: 0,0:57:22.73,0:57:24.02,Default,,0,0,0,,Эй, досым! Эй, досым!
Dialogue: 0,0:57:24.14,0:57:25.98,Default,,0,0,0,,Бұл қорқынышты! аздап!
Dialogue: 0,0:57:26.77,0:57:28.57,Default,,0,0,0,,Сонымен қатар, патрульдік топ
Dialogue: 0,0:57:28.69,0:57:32.40,Default,,0,0,0,,Өз қанаттарымен соңына дейін ұшуды жалғастырғандардың барлығынан.
Dialogue: 0,0:57:32.69,0:57:35.36,Default,,0,0,0,,Тіркеуге рұқсат етілген.
Dialogue: 0,0:57:39.99,0:57:42.70,Default,,0,0,0,,Өз қанаттарыммен...
Dialogue: 0,0:58:02.31,0:58:05.14,Default,,0,0,0,,Дәрігер, менің өрескел еліктеуімді кешіріңіз.
Dialogue: 0,0:58:05.27,0:58:06.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:58:07.48,0:58:10.15,Default,,0,0,0,,Сіздің арқаңызда Финикияның күші енді біздікі.
Dialogue: 0,0:58:10.27,0:58:11.19,Default,,0,0,0,,Хмм!?
Dialogue: 0,0:58:11.61,0:58:14.15,Default,,0,0,0,,Енді бәрі сіз қалағандай болады.
Dialogue: 0,0:58:14.69,0:58:18.11,Default,,0,0,0,,Есіңде болсын, жексұрын адамдар.
Dialogue: 0,0:58:19.16,0:58:22.16,Default,,0,0,0,,Енді кек алатын кез келді
Dialogue: 0,0:58:24.29,0:58:28.04,Default,,0,0,0,,Вавилон, ертең таңертең қоныс аударатын құстардың патрульін жіберіңіз.
Dialogue: 0,0:58:28.37,0:58:30.04,Default,,0,0,0,,Тек осы жолы ғана көз жұма қараймын.
Dialogue: 0,0:58:47.94,0:58:51.81,Default,,0,0,0,,Өйткені, өз қанатыңмен ұшу керек.
Dialogue: 0,0:58:52.36,0:58:54.61,Default,,0,0,0,,Дораемон, біз бірдеңе істей алмаймыз ба?
Dialogue: 0,0:58:54.73,0:58:55.99,Default,,0,0,0,,Мұның бәрі
Dialogue: 0,0:58:56.11,0:58:59.24,Default,,0,0,0,,Эй (Сунео) қарашы, қарашы
Dialogue: 0,0:58:59.36,0:59:01.07,Default,,0,0,0,,Бізді ертең жібереді.
Dialogue: 0,0:59:01.20,0:59:02.87,Default,,0,0,0,,Екеуің де! (Сунео/Джиан) Иә?
Dialogue: 0,0:59:03.28,0:59:05.54,Default,,0,0,0,,Гу Чанның да сезімі туралы ойланыңыз.
Dialogue: 0,0:59:05.66,0:59:06.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:59:17.30,0:59:19.93,Default,,0,0,0,,(Пиконың айқайы)
Dialogue: 0,0:59:20.43,0:59:23.89,Default,,0,0,0,,Гусуке мен өзімді бөлмеме қамап қойдым.
Dialogue: 0,0:59:24.31,0:59:26.35,Default,,0,0,0,,Оған көмектесу мүмкін емес, оны жайына қалдырайық.
Dialogue: 0,0:59:26.72,0:59:29.39,Default,,0,0,0,,Сәлеметсіз бе, Гусуке-кунның дисквалификациясының артында не жатыр?
Dialogue: 0,0:59:29.52,0:59:31.77,Default,,0,0,0,,Жалғыз қалдыруға болмайтын нәрсе бар сияқты.
Dialogue: 0,0:59:31.90,0:59:33.27,Default,,0,0,0,,Иә!?
Dialogue: 0,0:59:33.40,0:59:35.65,Default,,0,0,0,,Мен солай сезінемін
Dialogue: 0,0:59:40.61,0:59:42.49,Default,,0,0,0,,Дораэмон Шизука-чан!
Dialogue: 0,0:59:42.62,0:59:43.53,Default,,0,0,0,,Иә? не?
Dialogue: 0,0:59:44.08,0:59:45.49,Default,,0,0,0,,Гусуке жоқ.
Dialogue: 0,0:59:45.62,0:59:47.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:59:56.21,0:59:59.38,Default,,0,0,0,,Енді қоныс аударатын құстардың жаңа патрульі
Dialogue: 0,1:00:00.22,1:00:01.84,Default,,0,0,0,,Бірінші миссияңызға бара жатырсыз
Dialogue: 0,1:00:02.72,1:00:06.31,Default,,0,0,0,,Кез келген жағдайда бұйрықты мүлде орындаңыз
Dialogue: 0,1:00:06.76,1:00:08.27,Default,,0,0,0,,Жақсы! (Отряд мүшелері) Иә!
Dialogue: 0,1:00:08.89,1:00:11.19,Default,,0,0,0,,Сіз таңдалған батырларсыз.
Dialogue: 0,1:00:11.31,1:00:14.15,Default,,0,0,0,,Бірінші тапсырманы орындау үшін бар күшіңізді саласыз деп үміттенемін.
Dialogue: 0,1:00:14.27,1:00:15.11,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,1:00:15.65,1:00:18.61,Default,,0,0,0,,Көшпелі құстарды патрульдік бригада жөнелтеді!
Dialogue: 0,1:00:19.15,1:00:21.28,Default,,0,0,0,,Оу!
Dialogue: 0,1:00:36.54,1:00:38.84,Default,,0,0,0,,Гусуке сонда болды ма? Бар емес пе?
Dialogue: 0,1:00:38.96,1:00:40.38,Default,,0,0,0,,Ешкім қарап тұрған жоқ
Dialogue: 0,1:00:40.51,1:00:42.55,Default,,0,0,0,,Сіз қайда кеттіңіз?
Dialogue: 0,1:00:42.68,1:00:45.22,Default,,0,0,0,,Эй, доктор Хоу қайда?
Dialogue: 0,1:00:45.47,1:00:47.56,Default,,0,0,0,,Иә, кеттік. Жақсы.
Dialogue: 0,1:00:48.39,1:00:51.48,Default,,0,0,0,,Доктор Хоу да жоқ. Апыр-ай! Міне осы!
Dialogue: 0,1:00:52.10,1:00:53.73,Default,,0,0,0,,Көрініс
Dialogue: 0,1:00:54.65,1:00:56.52,Default,,0,0,0,,Бұл қауырсын күзетшідікі!
Dialogue: 0,1:00:56.65,1:01:00.44,Default,,0,0,0,,Және дәрігер бағалаған тас ескерткіштің бір бөлігі.
Dialogue: 0,1:01:00.74,1:01:03.40,Default,,0,0,0,,Ха, мен бұл директор Зигридтің орны екеніне сенімдімін.
Dialogue: 0,1:01:03.78,1:01:05.87,Default,,0,0,0,,Бір нәрсе бар.
Dialogue: 0,1:01:06.45,1:01:08.87,Default,,0,0,0,,Біз Гусукені тез табуымыз керек.
Dialogue: 0,1:01:08.99,1:01:09.83,Default,,0,0,0,,Иә
Dialogue: 0,1:01:19.75,1:01:21.01,Default,,0,0,0,,Уф...
Dialogue: 0,1:01:23.88,1:01:25.43,Default,,0,0,0,,Ммммм!
Dialogue: 0,1:01:27.64,1:01:31.64,Default,,0,0,0,,Бүгінгі жағдайда ол профессор Годжо немесе сондай біреу болар еді.
Dialogue: 0,1:01:35.85,1:01:36.85,Default,,0,0,0,,Ой... уау!
Dialogue: 0,1:01:38.36,1:01:41.57,Default,,0,0,0,,(Айқай)
Dialogue: 0,1:01:42.69,1:01:46.32,Default,,0,0,0,,Да... жоқ! Апыр-ай!
Dialogue: 0,1:01:46.86,1:01:48.87,Default,,0,0,0,,Гусуке! Гу-чан
Dialogue: 0,1:01:49.99,1:01:51.20,Default,,0,0,0,,Мені жайына қалдыр
Dialogue: 0,1:01:51.33,1:01:53.75,Default,,0,0,0,,Өтінемін, мен оны өзім көргім келеді.
Dialogue: 0,1:01:54.37,1:01:57.21,Default,,0,0,0,,Мен саған өз күшіммен ұша алатынымды көрсетемін.
Dialogue: 0,1:01:57.50,1:02:00.42,Default,,0,0,0,,Доктор Гусуке Хоу алып кетті!
Dialogue: 0,1:02:00.71,1:02:02.05,Default,,0,0,0,,Не, доктор Хоу!
Dialogue: 0,1:02:02.76,1:02:04.05,Default,,0,0,0,,Ол Гусукенің ең жақын досы, солай ма?
Dialogue: 0,1:02:04.30,1:02:07.26,Default,,0,0,0,,үшінмыз бірігіп жұмыс жасасақ, оны қалай да құтқара аламыз.
Dialogue: 0,1:02:07.72,1:02:08.72,Default,,0,0,0,,Нобита
Dialogue: 0,1:02:09.05,1:02:11.89,Default,,0,0,0,,Нобита-кун, сен кейде жақсы сөздер айтасың.
Dialogue: 0,1:02:12.01,1:02:13.18,Default,,0,0,0,,Ал, иә?
Dialogue: 0,1:02:13.31,1:02:16.39,Default,,0,0,0,,Эй Гусуке, есіңде бірдеңе жоқ па?
Dialogue: 0,1:02:16.52,1:02:19.15,Default,,0,0,0,,Мүмкін сіз тас ескерткіштің шифрын аша алған шығарсыз...
Dialogue: 0,1:02:19.40,1:02:21.86,Default,,0,0,0,,Уақыт фурошикі
Dialogue: 0,1:02:21.98,1:02:24.61,Default,,0,0,0,,Сынған тас ескерткішті қалпына келтіру
Dialogue: 0,1:02:25.57,1:02:28.11,Default,,0,0,0,,Осы сөздерді оқи алсам ғой
Dialogue: 0,1:02:28.24,1:02:30.45,Default,,0,0,0,,Коньякты шынымен қолдануым керек пе?
Dialogue: 0,1:02:30.58,1:02:34.75,Default,,0,0,0,,Не? А, мен мұны қалай байқамадым?
Dialogue: 0,1:02:34.87,1:02:37.25,Default,,0,0,0,,Хоньяку Коньяку
Dialogue: 0,1:02:37.79,1:02:39.71,Default,,0,0,0,,Хиёри, бұл шынымен де түсініспеушілік
Dialogue: 0,1:02:40.25,1:02:41.63,Default,,0,0,0,,Онда не айтылған?
Dialogue: 0,1:02:41.75,1:02:44.67,Default,,0,0,0,,«Қиыр солтүстіктегі Финикия мұнаралары...»
Dialogue: 0,1:02:45.05,1:02:48.84,Default,,0,0,0,,«Рараат тауындағы Айдаһар алқабының түбінде».
Dialogue: 0,1:02:48.97,1:02:50.60,Default,,0,0,0,,Айдаһар алқабы?
Dialogue: 0,1:02:51.05,1:02:56.39,Default,,0,0,0,,«Феницияның құдіреті құдайдай құдіретті».
Dialogue: 0,1:02:56.52,1:02:59.98,Default,,0,0,0,,«Финикияның күшін ояту...»
Dialogue: 0,1:03:00.48,1:03:01.98,Default,,0,0,0,,Осы жерде аяқталады
Dialogue: 0,1:03:02.32,1:03:04.94,Default,,0,0,0,,«Финикиялық күш» дегеніміз не?
Dialogue: 0,1:03:05.57,1:03:08.32,Default,,0,0,0,,Білмеймін, бірақ енді түсінікті
Dialogue: 0,1:03:08.45,1:03:11.66,Default,,0,0,0,,Зигрид Финикияның құдіретті күшін пайдаланады...
Dialogue: 0,1:03:12.33,1:03:15.08,Default,,0,0,0,,Мен Құс пиресін өзімдікіне айналдыруға тырысамын.
Dialogue: 0,1:03:15.20,1:03:17.00,Default,,0,0,0,,Иә!? (Госуке) Бұл Икар.
Dialogue: 0,1:03:17.12,1:03:19.21,Default,,0,0,0,,Икармен сөйлесейік (Нобита және т.б.) Иә!?
Dialogue: 0,1:03:19.33,1:03:22.59,Default,,0,0,0,,Финикияның күші туралы Икар да білуі керек.
Dialogue: 0,1:03:22.92,1:03:25.46,Default,,0,0,0,,«Икар» - аңызға айналған құсбегі, солай ма?
Dialogue: 0,1:03:25.59,1:03:27.05,Default,,0,0,0,,Сен өткеннен емессің бе?
Dialogue: 0,1:03:27.34,1:03:30.68,Default,,0,0,0,,Иә, мен доктор Хоудан сұрадым.
Dialogue: 0,1:03:31.26,1:03:33.10,Default,,0,0,0,,Түрме аралында болу
Dialogue: 0,1:03:38.18,1:03:41.23,Default,,0,0,0,,Икарды адам атқан.
Dialogue: 0,1:03:41.35,1:03:44.27,Default,,0,0,0,,Көшіп келе жатқан құстардың патрульдік апатына жауапкершілікті алу
Dialogue: 0,1:03:44.40,1:03:47.32,Default,,0,0,0,,Мен өз еркіммен түрме аралында қамалдым.
Dialogue: 0,1:04:11.59,1:04:13.47,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,1:04:18.02,1:04:18.68,Default,,0,0,0,,Ах!
Dialogue: 0,1:04:23.31,1:04:25.11,Default,,0,0,0,,Икар (Нобита және т.б.) Иә!
Dialogue: 0,1:04:26.48,1:04:28.32,Default,,0,0,0,,Икар Икар, солай ма?
Dialogue: 0,1:04:30.74,1:04:32.49,Default,,0,0,0,,Икар, маған сенің көмегің керек.
Dialogue: 0,1:04:33.07,1:04:35.95,Default,,0,0,0,,Доктор Хоуды Зигрид алып кетті.
Dialogue: 0,1:04:36.58,1:04:38.70,Default,,0,0,0,,Өткен жылы қазылған тас ескерткіш
Dialogue: 0,1:04:38.83,1:04:43.62,Default,,0,0,0,,Финикияның билігі Айдаһарлар алқабында мөрленген деп жазылған.
Dialogue: 0,1:04:45.38,1:04:47.34,Default,,0,0,0,,Зигрид мұны білді...
Dialogue: 0,1:04:48.84,1:04:50.55,Default,,0,0,0,,Маған күшіңді бер, Икар
Dialogue: 0,1:04:51.01,1:04:52.51,Default,,0,0,0,,Финикия
Dialogue: 0,1:04:53.01,1:04:54.97,Default,,0,0,0,,Егер жағдай осылай жалғаса берсе, Құс Пиер...
Dialogue: 0,1:04:57.89,1:05:02.02,Default,,0,0,0,,Бүгінгі жағдайда ол профессор Годжо немесе сондай біреу болар еді.
Dialogue: 0,1:05:07.11,1:05:07.73,Default,,0,0,0,,Уау!
Dialogue: 0,1:05:08.52,1:05:10.07,Default,,0,0,0,,Ол жерден кетіңіз
Dialogue: 0,1:05:26.13,1:05:28.38,Default,,0,0,0,,Кәне, бәрің, мені ұстаңдар.
Dialogue: 0,1:05:41.81,1:05:42.89,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,1:05:43.02,1:05:45.77,Default,,0,0,0,,Бұл аңыздардың шырқауы!
Dialogue: 0,1:05:50.90,1:05:52.03,Default,,0,0,0,,Ах!
Dialogue: 0,1:05:52.15,1:05:53.95,Default,,0,0,0,,Одиа, жақсысың ба?
Dialogue: 0,1:05:54.07,1:05:54.74,Default,,0,0,0,,Иә
Dialogue: 0,1:05:58.32,1:05:59.16,Default,,0,0,0,,(Нәрестенің жылауы)
Dialogue: 0,1:05:59.83,1:06:01.62,Default,,0,0,0,,Кішкене ғана, бар күшіңді сал
Dialogue: 0,1:06:02.95,1:06:03.87,Default,,0,0,0,,(Бала жылау)
Dialogue: 0,1:06:04.00,1:06:06.08,Default,,0,0,0,,Сен балақай!
Dialogue: 0,1:06:06.33,1:06:07.50,Default,,0,0,0,,♬ Бос соңғы бетте
Dialogue: 0,1:06:07.63,1:06:09.46,Default,,0,0,0,,(баланың айқайы)
Dialogue: 0,1:06:09.59,1:06:11.71,Default,,0,0,0,,Ах! Ахх...
Dialogue: 0,1:06:15.09,1:06:16.13,Default,,0,0,0,,А, ол бос.
Dialogue: 0,1:06:23.56,1:06:26.98,Default,,0,0,0,,Тыңдаңыз, осы жерден біз тура Рараат тауына бет аламыз.
Dialogue: 0,1:06:27.10,1:06:29.19,Default,,0,0,0,,Мықтап ұстаңыз
Dialogue: 0,1:06:30.65,1:06:33.11,Default,,0,0,0,,Өткеннен… немесе бәлкім басқа болашақтан
Dialogue: 0,1:06:39.41,1:06:40.95,Default,,0,0,0,,Міне, осында
Dialogue: 0,1:06:41.08,1:06:45.87,Default,,0,0,0,,Финикияның күші осы айдаһар алқабының астында бекітілген.
Dialogue: 0,1:06:46.00,1:06:50.46,Default,,0,0,0,,Сол күш пен адам әлемінің барлық құстарын тірілт
Dialogue: 0,1:06:50.58,1:06:52.38,Default,,0,0,0,,Құс пирстеріне көшу
Dialogue: 0,1:06:52.71,1:06:57.05,Default,,0,0,0,,Құстарды қоршаған ортаны бұзуды жалғастыратын адамдардан құтқарыңыз!
Dialogue: 0,1:06:57.34,1:06:59.43,Default,,0,0,0,,Иә!? Жоқ!
Dialogue: 0,1:06:59.68,1:07:00.93,Default,,0,0,0,,Иә? Доктор Хоу!
Dialogue: 0,1:07:01.39,1:07:05.39,Default,,0,0,0,,Егер біз мұны жасасақ, адам әлемінің экожүйесі бұзылады.
Dialogue: 0,1:07:05.98,1:07:08.85,Default,,0,0,0,,Құстар мен адамдар бірге өмір сүруі керек.
Dialogue: 0,1:07:09.35,1:07:13.19,Default,,0,0,0,,Дәрігер, мен сізді сөзіңізді есту үшін әкелген жоқпын.
Dialogue: 0,1:07:14.11,1:07:18.53,Default,,0,0,0,,Финикияның күшін бірге зерттеген дос, оған көрсету әдептілік...
Dialogue: 0,1:07:18.65,1:07:20.24,Default,,0,0,0,,Мені оятпа!
Dialogue: 0,1:07:20.61,1:07:21.87,Default,,0,0,0,,Дәрігер! (Сунео) О, Джан!
Dialogue: 0,1:07:22.66,1:07:25.29,Default,,0,0,0,,Мына дәрігерді жібер! Няро~
Dialogue: 0,1:07:25.41,1:07:27.54,Default,,0,0,0,,Осы үшеуін құлыптаңыз.
Dialogue: 0,1:07:28.21,1:07:32.42,Default,,0,0,0,,үшін осы алқаптағы қарды тез арада тазалау керек.
Dialogue: 0,1:07:32.54,1:07:33.46,Default,,0,0,0,,Оу!
Dialogue: 0,1:07:33.88,1:07:36.42,Default,,0,0,0,,О, анашым! Дораемон!
Dialogue: 0,1:07:37.05,1:07:38.88,Default,,0,0,0,,U~ Сабу
Dialogue: 0,1:07:39.51,1:07:40.84,Default,,0,0,0,,(Нобитаның түшкіруі)
Dialogue: 0,1:07:41.22,1:07:43.80,Default,,0,0,0,,Икар мырза, бір рет түсейік.
Dialogue: 0,1:07:55.27,1:07:57.57,Default,,0,0,0,,Бұл Айдаһар алқабының арғы беті.
Dialogue: 0,1:07:57.69,1:07:59.45,Default,,0,0,0,,Тезірек маған бірдеңе беріңіз~
Dialogue: 0,1:07:59.57,1:08:01.45,Default,,0,0,0,,Текио шамы
Dialogue: 0,1:08:01.78,1:08:02.87,Default,,0,0,0,,Бұл жарық...
Dialogue: 0,1:08:02.99,1:08:06.12,Default,,0,0,0,,Тез түсіндіріңіз.
Dialogue: 0,1:08:06.95,1:08:09.62,Default,,0,0,0,,А, қазір өте жылы. Бұл біртүрлі.
Dialogue: 0,1:08:09.75,1:08:12.04,Default,,0,0,0,,Шизука-чан, мен және Икар-сан.
Dialogue: 0,1:08:12.17,1:08:13.00,Default,,0,0,0,,Иә
Dialogue: 0,1:08:13.46,1:08:15.46,Default,,0,0,0,,Тіпті Икардың өзі суық, солай емес пе?
Dialogue: 0,1:08:15.59,1:08:16.25,Default,,0,0,0,,Уау!
Dialogue: 0,1:08:16.71,1:08:17.59,Default,,0,0,0,,Нобита-сан!
Dialogue: 0,1:08:17.88,1:08:21.26,Default,,0,0,0,,Гусуке! (Нобита мен Гусуке айқайлайды)
Dialogue: 0,1:08:21.88,1:08:23.22,Default,,0,0,0,,Нобита-кун, жақсысың ба?
Dialogue: 0,1:08:23.97,1:08:25.64,Default,,0,0,0,,Әйтеуір аман қалдым.
Dialogue: 0,1:08:25.76,1:08:28.52,Default,,0,0,0,,Нобита Бұл не?
Dialogue: 0,1:08:28.85,1:08:30.23,Default,,0,0,0,,Не?
Dialogue: 0,1:08:32.14,1:08:34.94,Default,,0,0,0,,Уау! (Госуке) Ха, адамдар!
Dialogue: 0,1:08:35.06,1:08:37.11,Default,,0,0,0,,Бұл стереоскопиялық кескін
Dialogue: 0,1:08:37.61,1:08:39.24,Default,,0,0,0,,Мен Мамору Туриномын
Dialogue: 0,1:08:39.32,1:08:42.03,Default,,0,0,0,,22 ғасырдағы орнитолог
Dialogue: 0,1:08:42.53,1:08:43.99,Default,,0,0,0,,22 ғасыр?
Dialogue: 0,1:08:44.32,1:08:48.20,Default,,0,0,0,,Мен адамдарды жек көремін, бірақ мен құстарды бәрінен де жақсы көрдім.
Dialogue: 0,1:08:48.79,1:08:50.00,Default,,0,0,0,,Уақыт машинасында
Dialogue: 0,1:08:50.12,1:08:53.67,Default,,0,0,0,,Сүтқоректілер туылмаған ерте заманда
Dialogue: 0,1:08:53.79,1:08:56.21,Default,,0,0,0,,Екеуміз бірге тұруды шештік.
Dialogue: 0,1:08:56.34,1:08:58.05,Default,,0,0,0,,Жақсы, бірақ...
Dialogue: 0,1:09:07.05,1:09:11.06,Default,,0,0,0,,(Ториноның ыңырануы)
Dialogue: 0,1:09:11.89,1:09:13.48,Default,,0,0,0,,Өте шиеленісті, иә?
Dialogue: 0,1:09:14.35,1:09:15.73,Default,,0,0,0,,Кеңістік-уақыттың бұзылуына байланысты
Dialogue: 0,1:09:15.86,1:09:19.40,Default,,0,0,0,,Уақыт машинасы гиперкеңістіктің қабырғасынан өтеді
Dialogue: 0,1:09:19.53,1:09:23.03,Default,,0,0,0,,Мен параллель әлемге келдім.
Dialogue: 0,1:09:24.82,1:09:28.45,Default,,0,0,0,,Иә, бұл басқа Жер болды.
Dialogue: 0,1:09:28.83,1:09:32.41,Default,,0,0,0,,Бұл кездейсоқтық болса да, бұл өмірде бір рет болатын мүмкіндік болды.
Dialogue: 0,1:09:33.21,1:09:36.38,Default,,0,0,0,,Мұнда сіз адамзат тарихын өзгерту туралы алаңдамайсыз.
Dialogue: 0,1:09:37.08,1:09:42.38,Default,,0,0,0,,Жас кезімде шайтанның сыбырын тыңдадым.
Dialogue: 0,1:09:42.67,1:09:44.72,Default,,0,0,0,,Мынаны құстардың пирстеріне айналдырайық
Dialogue: 0,1:09:44.84,1:09:50.18,Default,,0,0,0,,Құстардың барлық түрлері өздігінен дамыған.
Dialogue: 0,1:09:57.69,1:10:00.23,Default,,0,0,0,,Ал құстардың шамасы келгенше...
Dialogue: 0,1:10:00.36,1:10:04.53,Default,,0,0,0,,Содан кейін доктор Торино Гусуке мен оның достарының ата-бабаларын жасады.
Dialogue: 0,1:10:04.65,1:10:05.70,Default,,0,0,0,,Иә!?
Dialogue: 0,1:10:06.20,1:10:11.41,Default,,0,0,0,,Асығыңыз, демалмаңыз, мына алқаптағы қардың бәрін ұшырып жіберіңіз.
Dialogue: 0,1:10:12.20,1:10:13.91,Default,,0,0,0,,Финикиялық күш дегеніміз не?
Dialogue: 0,1:10:14.04,1:10:14.87,Default,,0,0,0,,Келіңіздер
Dialogue: 0,1:10:15.12,1:10:17.29,Default,,0,0,0,,Сөйлеуді тоқтатып, оны тез орындаңыз!
Dialogue: 0,1:10:17.42,1:10:20.75,Default,,0,0,0,,(мүшелердің дауыс жаңғырығы)
Dialogue: 0,1:10:21.21,1:10:24.72,Default,,0,0,0,,Бірақ Құс пирстерінің де табиғи жаулары болды.
Dialogue: 0,1:10:25.05,1:10:29.05,Default,,0,0,0,,(Құстардың сайрауы)
Dialogue: 0,1:10:32.06,1:10:36.10,Default,,0,0,0,,Менің соңғы жұмысым - бұл жігіт туралы бірдеңе жасау.
Dialogue: 0,1:10:36.69,1:10:40.56,Default,,0,0,0,,Сондықтан мен оны сонау солтүстіктегі мына тауға апардым...
Dialogue: 0,1:10:41.19,1:10:42.02,Default,,0,0,0,,Жарылыс!
Dialogue: 0,1:10:53.16,1:10:54.25,Default,,0,0,0,,Уф...
Dialogue: 0,1:10:54.91,1:10:56.50,Default,,0,0,0,,Әй?
Dialogue: 0,1:10:56.62,1:10:59.46,Default,,0,0,0,,Мен оны мұздың астында ұйықтатуға мәжбүрлей аламын, бірақ
Dialogue: 0,1:10:59.92,1:11:02.92,Default,,0,0,0,,Мен де, көп ұзамаймын.
Dialogue: 0,1:11:03.05,1:11:08.13,Default,,0,0,0,,Бірдпияның балалары, Финикияны оятпаңдар.
Dialogue: 0,1:11:09.84,1:11:12.85,Default,,0,0,0,,Финикия қандай да бір алып құбыжық сияқты.
Dialogue: 0,1:11:13.39,1:11:14.64,Default,,0,0,0,,Жүр, асығайық.
Dialogue: 0,1:11:15.27,1:11:18.10,Default,,0,0,0,,Бұл... бұл Финикияның күші ме?
Dialogue: 0,1:11:22.65,1:11:25.53,Default,,0,0,0,,Бұл… біз мұны қайта жандандырамыз ба?
Dialogue: 0,1:11:26.11,1:11:28.40,Default,,0,0,0,,Дұрыс, мына жігітті басқар.
Dialogue: 0,1:11:28.53,1:11:31.49,Default,,0,0,0,,Бердвейден адам әлеміне жіберу
Dialogue: 0,1:11:32.03,1:11:34.87,Default,,0,0,0,,Енді адам әлемі де менікі.
Dialogue: 0,1:11:34.99,1:11:35.70,Default,,0,0,0,,Иә?
Dialogue: 0,1:11:36.04,1:11:37.50,Default,,0,0,0,,Укуку... (Сунео) Тезірек!
Dialogue: 0,1:11:37.62,1:11:39.42,Default,,0,0,0,,(Финикиялықтардың ырылдауы)
Dialogue: 0,1:11:39.54,1:11:40.96,Default,,0,0,0,,(үшінның таңданған дауысы)
Dialogue: 0,1:11:41.88,1:11:44.34,Default,,0,0,0,,(Біреуді тесіп өткендей дыбыс)
Dialogue: 0,1:11:47.55,1:11:51.22,Default,,0,0,0,,Уа, Финикия, мен сені ояттым.
Dialogue: 0,1:11:51.68,1:11:54.68,Default,,0,0,0,,Менің айтқанымды орындаңыз
Dialogue: 0,1:11:55.31,1:11:56.22,Default,,0,0,0,,Сәлем Джи!
Dialogue: 0,1:11:56.35,1:11:57.64,Default,,0,0,0,,Әй, Джан! О!
Dialogue: 0,1:12:02.44,1:12:04.48,Default,,0,0,0,,(Сунео мен Джанның айқайы)
Dialogue: 0,1:12:04.98,1:12:06.44,Default,,0,0,0,,Тыныш бол, Финикия
Dialogue: 0,1:12:06.78,1:12:07.57,Default,,0,0,0,,Икар!
Dialogue: 0,1:12:10.61,1:12:13.12,Default,,0,0,0,,Аты аңызға айналған қаһарман...Икар!
Dialogue: 0,1:12:15.53,1:12:18.37,Default,,0,0,0,,Икар! (Нобита) Джан! Сунео!
Dialogue: 0,1:12:18.50,1:12:20.37,Default,,0,0,0,,Нобита! Жүректің досы!
Dialogue: 0,1:12:20.50,1:12:23.96,Default,,0,0,0,,Доктор Хоу! Гусуке!
Dialogue: 0,1:12:24.08,1:12:25.96,Default,,0,0,0,,Икарды басып ал!
Dialogue: 0,1:12:26.75,1:12:27.92,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,1:12:28.59,1:12:31.34,Default,,0,0,0,,Зигри басқарған Финикия...
Dialogue: 0,1:12:31.47,1:12:34.01,Default,,0,0,0,,Біз адам әлемін жаулап алуға тырысамыз!
Dialogue: 0,1:12:34.14,1:12:37.18,Default,,0,0,0,,Мен саған олай істеуге рұқсат бермеймін, уф...
Dialogue: 0,1:12:37.31,1:12:40.18,Default,,0,0,0,,Эволюциялық бұзылған сәулелену көзі
Dialogue: 0,1:12:40.60,1:12:43.15,Default,,0,0,0,,Дөңгелекті нашарлату үшін бұраңыз
Dialogue: 0,1:12:44.02,1:12:46.32,Default,,0,0,0,,Ол амебаға айналады.
Dialogue: 0,1:12:46.44,1:12:49.11,Default,,0,0,0,,Қажетсіз істермен айналыспаңыз! Ой, не істеп жатырсың?
Dialogue: 0,1:12:51.07,1:12:53.24,Default,,0,0,0,,Хмф! Апыр-ай!
Dialogue: 0,1:12:54.82,1:12:57.16,Default,,0,0,0,,О... Эволюция!
Dialogue: 0,1:12:58.62,1:13:01.12,Default,,0,0,0,,(Финикиялықтардың айқайы)
Dialogue: 0,1:13:01.54,1:13:04.71,Default,,0,0,0,,О, Финикия одан әрі өседі!
Dialogue: 0,1:13:05.17,1:13:09.59,Default,,0,0,0,,Финикия, мені тыңда.
Dialogue: 0,1:13:14.59,1:13:15.80,Default,,0,0,0,,Уау!
Dialogue: 0,1:13:16.68,1:13:17.39,Default,,0,0,0,,Га
Dialogue: 0,1:13:18.26,1:13:19.35,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,1:13:19.68,1:13:22.31,Default,,0,0,0,,Уаа
Dialogue: 0,1:13:22.60,1:13:23.31,Default,,0,0,0,,Хатшы!
Dialogue: 0,1:13:26.48,1:13:27.77,Default,,0,0,0,,Хатшы!
Dialogue: 0,1:13:27.90,1:13:29.02,Default,,0,0,0,,Иә?
Dialogue: 0,1:13:31.78,1:13:35.07,Default,,0,0,0,,Уау! Ах ха
Dialogue: 0,1:13:37.07,1:13:38.08,Default,,0,0,0,,Икар
Dialogue: 0,1:13:39.03,1:13:41.54,Default,,0,0,0,,Вавилон Сигридтен сізге қамқорлық жасауын сұраңыз.
Dialogue: 0,1:13:42.29,1:13:43.50,Default,,0,0,0,,Икар
Dialogue: 0,1:13:45.71,1:13:47.42,Default,,0,0,0,,(Сарбаздардың үрейлі дауыстары)
Dialogue: 0,1:13:51.84,1:13:54.63,Default,,0,0,0,,Финикия қайда барады?
Dialogue: 0,1:13:54.76,1:13:59.01,Default,,0,0,0,,Жоқ, сіздің үйге бару инстинкті сізді Құс пирстеріне апарады.
Dialogue: 0,1:13:59.68,1:14:00.97,Default,,0,0,0,,Құс пирстерінің халқына қауіп төніп тұр.
Dialogue: 0,1:14:01.77,1:14:05.19,Default,,0,0,0,,Бәріміз бірігіп Құс пиресін қорғайық.
Dialogue: 0,1:14:05.31,1:14:06.77,Default,,0,0,0,,Оу!
Dialogue: 0,1:14:06.90,1:14:08.48,Default,,0,0,0,,Дораемон және біз де
Dialogue: 0,1:14:08.61,1:14:10.36,Default,,0,0,0,,Иә, әрине.
Dialogue: 0,1:14:10.48,1:14:11.57,Default,,0,0,0,,Аман болыңыз
Dialogue: 0,1:14:12.03,1:14:13.49,Default,,0,0,0,,Барша адамның ішінде мен дәл осылай қысылып қалсам…
Dialogue: 0,1:14:13.61,1:14:16.49,Default,,0,0,0,,Жарайды, кеттік! (үшін) О!
Dialogue: 0,1:14:17.07,1:14:18.45,Default,,0,0,0,,(айқай)
Dialogue: 0,1:14:20.87,1:14:24.87,Default,,0,0,0,,(Құстардың сайрауы)
Dialogue: 0,1:14:31.38,1:14:34.01,Default,,0,0,0,,үшінң, үрейленбеңдер, жартасқа пана болыңдар.
Dialogue: 0,1:14:35.97,1:14:37.93,Default,,0,0,0,,Қандай қорқынышты құбыжық!
Dialogue: 0,1:14:39.05,1:14:40.39,Default,,0,0,0,,Кім шайқаса алады, сол қолына қару алсын.
Dialogue: 0,1:14:40.93,1:14:41.89,Default,,0,0,0,,Икар!
Dialogue: 0,1:14:42.01,1:14:44.60,Default,,0,0,0,,Жақында қоныс аударатын құстардың патрульі келеді.
Dialogue: 0,1:14:50.15,1:14:51.77,Default,,0,0,0,,Шабуыл басталады
Dialogue: 0,1:14:51.90,1:14:53.44,Default,,0,0,0,,Оу!
Dialogue: 0,1:14:56.28,1:14:57.95,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,1:15:02.03,1:15:03.20,Default,,0,0,0,,Ах!
Dialogue: 0,1:15:03.33,1:15:04.50,Default,,0,0,0,,Әрине, оны есінен тандырып тастаған дұрыс қой?
Dialogue: 0,1:15:09.12,1:15:10.63,Default,,0,0,0,,(Құстардың үрейлі дауыстары)
Dialogue: 0,1:15:11.71,1:15:13.21,Default,,0,0,0,,Таңғажайып нәрсе болып жатыр.
Dialogue: 0,1:15:13.34,1:15:14.59,Default,,0,0,0,,Дорэмон тез арада қару алады
Dialogue: 0,1:15:14.96,1:15:17.05,Default,,0,0,0,,Бұл қару болса да, ол әрқашан таныс...
Dialogue: 0,1:15:17.63,1:15:20.01,Default,,0,0,0,,Пневматикалық және соққылы мылтықтар
Dialogue: 0,1:15:20.43,1:15:23.89,Default,,0,0,0,,Қалай болғанда да, Финикияны Құс пирсінен шығарыңыз.
Dialogue: 0,1:15:24.01,1:15:24.68,Default,,0,0,0,,Иә
Dialogue: 0,1:15:24.81,1:15:26.77,Default,,0,0,0,,Хирари плащы
Dialogue: 0,1:15:27.27,1:15:32.11,Default,,0,0,0,,Шизука-чан және оның достары мұны өрттен кешігіп құтылғандарды қорғау үшін пайдаланды.
Dialogue: 0,1:15:32.23,1:15:33.23,Default,,0,0,0,,Иә Иә
Dialogue: 0,1:15:33.52,1:15:35.57,Default,,0,0,0,,Тыңдаңыздар, бәріңіз, сақ болыңыздар.
Dialogue: 0,1:15:35.69,1:15:37.24,Default,,0,0,0,,Оу!
Dialogue: 0,1:15:37.36,1:15:41.37,Default,,0,0,0,,(Финикиялықтардың ырылдауы)
Dialogue: 0,1:15:42.41,1:15:43.33,Default,,0,0,0,,Ну (Нобита) Ха!
Dialogue: 0,1:15:45.24,1:15:47.37,Default,,0,0,0,,Жоқ, мен қозғалмаймын.
Dialogue: 0,1:15:47.50,1:15:49.41,Default,,0,0,0,,Мен... (3 адам) Уау!
Dialogue: 0,1:15:51.96,1:15:54.34,Default,,0,0,0,,Иә, кішкене жарық болды.
Dialogue: 0,1:15:54.46,1:15:57.13,Default,,0,0,0,,Бұл оны шынымен кішкентай етеді.
Dialogue: 0,1:15:57.26,1:15:58.05,Default,,0,0,0,,Уау!
Dialogue: 0,1:15:58.80,1:16:00.97,Default,,0,0,0,,Хирари плащы Хирари плащы
Dialogue: 0,1:16:01.09,1:16:02.89,Default,,0,0,0,,Уау, тез
Dialogue: 0,1:16:03.01,1:16:05.47,Default,,0,0,0,,Огава (бала) Жақсы.
Dialogue: 0,1:16:06.27,1:16:07.93,Default,,0,0,0,,Сіз мұнда қауіпсізсіз.
Dialogue: 0,1:16:08.06,1:16:09.43,Default,,0,0,0,,Сізге жақсы (бала) Иә.
Dialogue: 0,1:16:09.98,1:16:13.44,Default,,0,0,0,,Ах, Пеко... Сүт-чан, осында күт.
Dialogue: 0,1:16:13.56,1:16:14.94,Default,,0,0,0,,(Сыныптасы) Әй, осындай жалғыздыққа толы сөздер айтпашы.
Dialogue: 0,1:16:15.27,1:16:16.40,Default,,0,0,0,,Сен, жансыз құрал—
Dialogue: 0,1:16:18.57,1:16:19.82,Default,,0,0,0,,Уау!
Dialogue: 0,1:16:20.61,1:16:22.03,Default,,0,0,0,,Осылай қалса жақсы емес.
Dialogue: 0,1:16:25.08,1:16:26.95,Default,,0,0,0,,Финикиялық резолюция
Dialogue: 0,1:16:28.00,1:16:30.04,Default,,0,0,0,,Ой!
Dialogue: 0,1:16:30.33,1:16:31.00,Default,,0,0,0,,Икар!
Dialogue: 0,1:16:31.25,1:16:32.00,Default,,0,0,0,,Икар!
Dialogue: 0,1:16:34.46,1:16:35.92,Default,,0,0,0,,Икар!
Dialogue: 0,1:16:37.05,1:16:38.17,Default,,0,0,0,,Уф
Dialogue: 0,1:16:39.67,1:16:41.80,Default,,0,0,0,,Ууу
Dialogue: 0,1:16:43.51,1:16:44.68,Default,,0,0,0,,Икар Жақсысың ба?
Dialogue: 0,1:16:45.14,1:16:47.01,Default,,0,0,0,,Иә, рахмет, бұл көмектесті.
Dialogue: 0,1:16:47.14,1:16:48.97,Default,,0,0,0,,Гусуке! (Госуке) Сүт
Dialogue: 0,1:16:49.10,1:16:51.81,Default,,0,0,0,,Икар мырза (Нобита) Икар
Dialogue: 0,1:16:51.94,1:16:54.27,Default,,0,0,0,,Уайымдама, бәрі жақсы.
Dialogue: 0,1:16:54.69,1:16:55.77,Default,,0,0,0,,Сәлем, Милк-чан
Dialogue: 0,1:16:55.90,1:16:56.98,Default,,0,0,0,,Шизука-чан ше? Ахх
Dialogue: 0,1:16:57.90,1:17:00.94,Default,,0,0,0,,Пико-чан Пико Пико
Dialogue: 0,1:17:01.19,1:17:02.70,Default,,0,0,0,,Пи-чан
Dialogue: 0,1:17:03.11,1:17:05.37,Default,,0,0,0,,Пико (Пиконың айқайы)
Dialogue: 0,1:17:05.49,1:17:10.29,Default,,0,0,0,,Әй, Пи-чан! Кешіріңіз, Пико.
Dialogue: 0,1:17:10.75,1:17:13.54,Default,,0,0,0,,Соққы мылтықтары Финикияға әсер етпейді.
Dialogue: 0,1:17:13.67,1:17:14.58,Default,,0,0,0,,Пневматикалық зеңбірек
Dialogue: 0,1:17:15.04,1:17:17.00,Default,,0,0,0,,Сізде бұдан артық керемет қару жоқ па?
Dialogue: 0,1:17:17.13,1:17:19.05,Default,,0,0,0,,Менде жоқ.
Dialogue: 0,1:17:19.59,1:17:21.34,Default,,0,0,0,,Хмм, дұрыс.
Dialogue: 0,1:17:21.80,1:17:24.93,Default,,0,0,0,,Доктор Торино мінген уақыт машинасы болса.
Dialogue: 0,1:17:25.05,1:17:27.30,Default,,0,0,0,,Оған қарудың қандай да бір түрі бекітілген болуы мүмкін.
Dialogue: 0,1:17:27.55,1:17:28.39,Default,,0,0,0,,Иә
Dialogue: 0,1:17:28.51,1:17:31.27,Default,,0,0,0,,Финикияны азғырып, оны жеңіңіз
Dialogue: 0,1:17:31.39,1:17:32.64,Default,,0,0,0,,Дораемон күткендей
Dialogue: 0,1:17:33.27,1:17:35.44,Default,,0,0,0,,Уақыт машинасы қайда?
Dialogue: 0,1:17:35.56,1:17:36.40,Default,,0,0,0,,Ах! (Сунео) Иә?
Dialogue: 0,1:17:36.52,1:17:38.32,Default,,0,0,0,,Бұрын… пышақ еді.
Dialogue: 0,1:17:38.44,1:17:40.82,Default,,0,0,0,,Менің ойымда бір нәрсе бар (Нобита және басқалар) Иә?
Dialogue: 0,1:17:41.69,1:17:42.82,Default,,0,0,0,,Томалығының басы
Dialogue: 0,1:17:43.45,1:17:44.74,Default,,0,0,0,,Мен бір рет
Dialogue: 0,1:17:44.86,1:17:47.62,Default,,0,0,0,,Мен түтін белдеуінен өтіп, оны жоғарыдан көрдім.
Dialogue: 0,1:17:48.24,1:17:51.62,Default,,0,0,0,,Уақыт машинасы? Мүмкін
Dialogue: 0,1:17:51.75,1:17:54.16,Default,,0,0,0,,Мен Финикияны азғырамын.
Dialogue: 0,1:17:54.29,1:17:55.83,Default,,0,0,0,,Ой, Икар!
Dialogue: 0,1:17:56.50,1:17:57.92,Default,,0,0,0,,Икардың қанаттары!
Dialogue: 0,1:18:00.67,1:18:02.88,Default,,0,0,0,,Икар мырза, мықты болыңыз.
Dialogue: 0,1:18:03.01,1:18:03.84,Default,,0,0,0,,Гусуке!
Dialogue: 0,1:18:04.30,1:18:06.43,Default,,0,0,0,,Мен Финикияны тартып алғым келеді.
Dialogue: 0,1:18:09.81,1:18:11.35,Default,,0,0,0,,Финикия!
Dialogue: 0,1:18:17.85,1:18:18.90,Default,,0,0,0,,Уау!
Dialogue: 0,1:18:22.44,1:18:25.57,Default,,0,0,0,,Жүр, менің артымнан жүр.
Dialogue: 0,1:18:29.83,1:18:32.58,Default,,0,0,0,,Финикия Томалиге қарай бет алды
Dialogue: 0,1:18:32.70,1:18:35.16,Default,,0,0,0,,Бұл Гусуке! кеттік
Dialogue: 0,1:18:57.44,1:18:58.77,Default,,0,0,0,,Уф, бұл түтін белдігі.
Dialogue: 0,1:19:02.02,1:19:06.03,Default,,0,0,0,,(Госукенің айқайы)
Dialogue: 0,1:19:06.61,1:19:07.49,Default,,0,0,0,,Гусуке!
Dialogue: 0,1:19:07.61,1:19:08.99,Default,,0,0,0,,Уау!
Dialogue: 0,1:19:09.11,1:19:10.95,Default,,0,0,0,,Кон...
Dialogue: 0,1:19:11.07,1:19:12.95,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,1:19:13.45,1:19:14.79,Default,,0,0,0,,Бұл~ Нобита!
Dialogue: 0,1:19:18.37,1:19:19.21,Default,,0,0,0,,Nu
Dialogue: 0,1:19:21.25,1:19:23.00,Default,,0,0,0,,Уау! Бұл ауырады
Dialogue: 0,1:19:23.13,1:19:24.25,Default,,0,0,0,,Нобита-кун!
Dialogue: 0,1:19:24.55,1:19:26.63,Default,,0,0,0,,Уау! (Госуке) Нобита!
Dialogue: 0,1:19:26.76,1:19:30.14,Default,,0,0,0,,Иә? үшін жақсы ма?
Dialogue: 0,1:19:30.26,1:19:32.35,Default,,0,0,0,,Мен Гусуке мұны істейтініне сенімдімін.
Dialogue: 0,1:19:32.97,1:19:36.02,Default,,0,0,0,,Батыл бол, ұша аласың
Dialogue: 0,1:19:36.85,1:19:37.89,Default,,0,0,0,,Ұш!
Dialogue: 0,1:19:38.02,1:19:39.73,Default,,0,0,0,,Уф... Нобита!
Dialogue: 0,1:19:41.35,1:19:42.81,Default,,0,0,0,,Ах~! (Госуке) Хмм!
Dialogue: 0,1:19:42.94,1:19:44.02,Default,,0,0,0,,Уф
Dialogue: 0,1:19:45.65,1:19:48.15,Default,,0,0,0,,Гусуке мен ұша алар едім! (Госуке) Иә.
Dialogue: 0,1:19:48.61,1:19:50.11,Default,,0,0,0,,Гусуке-кун
Dialogue: 0,1:19:50.24,1:19:52.32,Default,,0,0,0,,Сіз ұша аласыз (Госуке) Иә.
Dialogue: 0,1:19:56.54,1:19:57.87,Default,,0,0,0,,Міне келдік (Нобита мен оның достары) Ах!
Dialogue: 0,1:19:58.00,1:19:59.08,Default,,0,0,0,,Менің артымнан еріңіз (Нобита) Ах!
Dialogue: 0,1:19:59.50,1:20:00.50,Default,,0,0,0,,Финикия!
Dialogue: 0,1:20:00.62,1:20:04.63,Default,,0,0,0,,(Финикиялықтардың айқайы)
Dialogue: 0,1:20:06.05,1:20:08.05,Default,,0,0,0,,Менің артымнан жүр
Dialogue: 0,1:20:12.30,1:20:13.47,Default,,0,0,0,,Уф
Dialogue: 0,1:20:18.85,1:20:20.73,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,1:20:21.14,1:20:24.31,Default,,0,0,0,,Дорэмон, біз уақыт машинасына асығуымыз керек.
Dialogue: 0,1:20:24.44,1:20:26.19,Default,,0,0,0,,Соны айтсаң да
Dialogue: 0,1:20:26.65,1:20:29.19,Default,,0,0,0,,Дұрыс, Ко катамаринді қолданайық.
Dialogue: 0,1:20:29.32,1:20:30.40,Default,,0,0,0,,Мен асығып тұрмын—есеп-шотты беріңізші.
Dialogue: 0,1:20:30.82,1:20:32.82,Default,,0,0,0,,Ко Катамарин
Dialogue: 0,1:20:32.95,1:20:35.83,Default,,0,0,0,,Джан, соны ішіп, айқайла.
Dialogue: 0,1:20:36.24,1:20:38.54,Default,,0,0,0,,Мен сиыр жеймін
Dialogue: 0,1:20:39.45,1:20:41.04,Default,,0,0,0,,Хо!
Dialogue: 0,1:20:41.16,1:20:42.46,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,1:20:43.33,1:20:44.33,Default,,0,0,0,,Ойын!
Dialogue: 0,1:20:44.46,1:20:45.59,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,1:20:46.17,1:20:49.88,Default,,0,0,0,,(Нобита мен Дорэмонның айқайы)
Dialogue: 0,1:20:53.30,1:20:56.14,Default,,0,0,0,,Нобита-кун
Dialogue: 0,1:20:56.64,1:20:59.43,Default,,0,0,0,,Нобита-кун (Нобита) Дораемон
Dialogue: 0,1:20:59.56,1:21:01.39,Default,,0,0,0,,Ха, жақсысың ба?
Dialogue: 0,1:21:01.52,1:21:03.35,Default,,0,0,0,,Иә, Гусуке ше?
Dialogue: 0,1:21:03.48,1:21:04.52,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,1:21:04.65,1:21:05.65,Default,,0,0,0,,Уау! (Нобита) Иә?
Dialogue: 0,1:21:06.36,1:21:09.28,Default,,0,0,0,,Томалығының басы – көл.
Dialogue: 0,1:21:09.40,1:21:10.99,Default,,0,0,0,,Оған он мыңдаған жылдар қажет болса керек
Dialogue: 0,1:21:11.11,1:21:12.61,Default,,0,0,0,,Су жиналды.
Dialogue: 0,1:21:13.20,1:21:15.07,Default,,0,0,0,,Дораемон?
Dialogue: 0,1:21:16.20,1:21:18.99,Default,,0,0,0,,Доктор Ториноның уақыт машинасы
Dialogue: 0,1:21:19.37,1:21:21.50,Default,,0,0,0,,Барайық Нобита-кун (Нобита) Иә.
Dialogue: 0,1:21:23.04,1:21:24.42,Default,,0,0,0,,Қызық, Нобита мен оның достары келе ме?
Dialogue: 0,1:21:24.54,1:21:26.42,Default,,0,0,0,,Нобита-кун, тезірек (Нобита) Иә.
Dialogue: 0,1:21:28.34,1:21:31.17,Default,,0,0,0,,Уау, кабина.
Dialogue: 0,1:21:31.46,1:21:33.38,Default,,0,0,0,,Маған қосқыш керек.
Dialogue: 0,1:21:34.01,1:21:37.97,Default,,0,0,0,,Өйткені, ол 200 миллион жыл бойына елеусіз қалды.
Dialogue: 0,1:21:38.10,1:21:39.31,Default,,0,0,0,,Ах! Алақай!
Dialogue: 0,1:21:41.27,1:21:43.23,Default,,0,0,0,,Оған қарудың қандай да бір түрі бекітілген болуы керек.
Dialogue: 0,1:21:43.73,1:21:45.19,Default,,0,0,0,,Мүмкін бұл?
Dialogue: 0,1:21:48.48,1:21:50.82,Default,,0,0,0,,Соққы зеңбірегі атуға дайын
Dialogue: 0,1:21:50.94,1:21:54.11,Default,,0,0,0,,Жарайды, осы арқылы біз Финикияны жеңе аламыз.
Dialogue: 0,1:21:54.24,1:21:56.32,Default,,0,0,0,,Нобита-кун Гусуке-кун
Dialogue: 0,1:21:56.45,1:21:58.37,Default,,0,0,0,,Жарайды, маған құс қалпағыңды бер.
Dialogue: 0,1:21:58.49,1:21:59.70,Default,,0,0,0,,Иә
Dialogue: 0,1:22:01.75,1:22:04.37,Default,,0,0,0,,Гусуке!
Dialogue: 0,1:22:05.04,1:22:06.25,Default,,0,0,0,,Әй, Нобита!
Dialogue: 0,1:22:06.83,1:22:07.88,Default,,0,0,0,,Гусуке
Dialogue: 0,1:22:08.00,1:22:11.92,Default,,0,0,0,,Жоспар ойдағыдай жүріп жатыр, ол менің сигналыммен аспандап кетеді.
Dialogue: 0,1:22:12.05,1:22:13.67,Default,,0,0,0,,Ұнады ма? (Госуке) Иә.
Dialogue: 0,1:22:13.92,1:22:16.84,Default,,0,0,0,,Жақсы, Нобита-кун, хун.
Dialogue: 0,1:22:17.43,1:22:19.05,Default,,0,0,0,,Уф (Нобита) Тағы да
Dialogue: 0,1:22:19.64,1:22:21.10,Default,,0,0,0,,Кеттік (Госуке) Иә.
Dialogue: 0,1:22:22.52,1:22:24.23,Default,,0,0,0,,Қазір!
Dialogue: 0,1:22:30.61,1:22:31.44,Default,,0,0,0,,Иә!
Dialogue: 0,1:22:31.82,1:22:33.44,Default,,0,0,0,,Мен жасадым! (Госуке) Керемет
Dialogue: 0,1:22:41.58,1:22:42.33,Default,,0,0,0,,Гусуке (Госуке) Иә
Dialogue: 0,1:22:45.71,1:22:47.25,Default,,0,0,0,,Дораемон
Dialogue: 0,1:22:49.67,1:22:51.84,Default,,0,0,0,,Дораемон! Жақсы өтті
Dialogue: 0,1:22:51.96,1:22:52.92,Default,,0,0,0,,Рас
Dialogue: 0,1:22:53.05,1:22:55.38,Default,,0,0,0,,Гусуке-кун, сен керемет жұмыс жасадың.
Dialogue: 0,1:22:55.51,1:22:57.38,Default,,0,0,0,,Мен өз қанатыммен ұша алатынмын
Dialogue: 0,1:22:58.09,1:22:59.64,Default,,0,0,0,,Қазір Финикия...
Dialogue: 0,1:22:59.76,1:23:00.93,Default,,0,0,0,,Ах
Dialogue: 0,1:23:01.05,1:23:01.81,Default,,0,0,0,,Иә?
Dialogue: 0,1:23:02.39,1:23:04.06,Default,,0,0,0,,Ауылдың қарапайым адамдары көбейіп кеткен сияқты.
Dialogue: 0,1:23:04.18,1:23:06.39,Default,,0,0,0,,Не? (жердің шуылдауы)
Dialogue: 0,1:23:06.56,1:23:07.23,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,1:23:08.56,1:23:09.65,Default,,0,0,0,,Уау!
Dialogue: 0,1:23:11.11,1:23:12.94,Default,,0,0,0,,Соққы зеңбіректері де тиімсіз.
Dialogue: 0,1:23:13.07,1:23:15.07,Default,,0,0,0,,Ммм, бір жерде жоғалып кет!
Dialogue: 0,1:23:15.57,1:23:16.99,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,1:23:19.24,1:23:21.95,Default,,0,0,0,,Уақыт машинасын бір жерге ұшыр.
Dialogue: 0,1:23:22.78,1:23:24.91,Default,,0,0,0,,Есептегішті нөлге қойыңыз...
Dialogue: 0,1:23:25.50,1:23:26.37,Default,,0,0,0,,(Айзава) Сондықтан мен қабылдау емтиханы логикаға жат дедім
Dialogue: 0,1:23:26.50,1:23:28.79,Default,,0,0,0,,Уақыт машинасы жұмыс істейді
Dialogue: 0,1:23:28.92,1:23:30.83,Default,,0,0,0,,Тез қашу!
Dialogue: 0,1:23:31.29,1:23:32.79,Default,,0,0,0,,Өткеннен… немесе бәлкім басқа болашақтан
Dialogue: 0,1:23:41.51,1:23:43.30,Default,,0,0,0,,Иә!
Dialogue: 0,1:23:43.43,1:23:45.97,Default,,0,0,0,,Мен бұл жолы жасадым (Госуке) Хахаха! Ахаха!
Dialogue: 0,1:23:46.10,1:23:47.06,Default,,0,0,0,,Сен қайда бардың?
Dialogue: 0,1:23:47.43,1:23:50.98,Default,,0,0,0,,Жер пайда болғанға дейін ғарыш кеңістігі болуы мүмкін.
Dialogue: 0,1:23:53.48,1:23:57.49,Default,,0,0,0,,(Финикиялықтардың ырылдауы)
Dialogue: 0,1:23:59.90,1:24:01.36,Default,,0,0,0,,үшінна тезірек хабардар етейік
Dialogue: 0,1:24:01.87,1:24:05.16,Default,,0,0,0,,Бір минут күтіңіз, мен Құс пирсіндегі өртті сөндіруім керек.
Dialogue: 0,1:24:05.29,1:24:06.33,Default,,0,0,0,,Қалай?
Dialogue: 0,1:24:06.79,1:24:08.79,Default,,0,0,0,,Мұса таяқшасы
Dialogue: 0,1:24:09.04,1:24:11.21,Default,,0,0,0,,Оны миномет нұсқасында орнатыңыз...
Dialogue: 0,1:24:11.79,1:24:13.25,Default,,0,0,0,,Ауырсыну
Dialogue: 0,1:24:36.65,1:24:39.36,Default,,0,0,0,,(Екі адам айғайлайды)
Dialogue: 0,1:24:39.90,1:24:41.36,Default,,0,0,0,,Жоқ... не болды?
Dialogue: 0,1:24:42.24,1:24:44.28,Default,,0,0,0,,Джан! Сунео!
Dialogue: 0,1:24:45.28,1:24:46.74,Default,,0,0,0,,Финикия жеңілді.
Dialogue: 0,1:24:46.87,1:24:48.95,Default,,0,0,0,,Шынымен бе? иә? Керемет
Dialogue: 0,1:24:50.04,1:24:50.91,Default,,0,0,0,,Фуфу
Dialogue: 0,1:24:56.34,1:25:00.97,Default,,0,0,0,,Жаңбыр жауып тұр. Бұл өртті өшіреді. Құс пирстері құтқарылды.
Dialogue: 0,1:25:01.09,1:25:02.38,Default,,0,0,0,,Шизука-чан! Ах
Dialogue: 0,1:25:02.51,1:25:03.72,Default,,0,0,0,,Сүт! Ах
Dialogue: 0,1:25:04.55,1:25:06.39,Default,,0,0,0,,Нобита-сан Гусуке?
Dialogue: 0,1:25:06.51,1:25:08.64,Default,,0,0,0,,Финикия қазір жоқ.
Dialogue: 0,1:25:09.02,1:25:10.31,Default,,0,0,0,,Жақсы
Dialogue: 0,1:25:10.43,1:25:13.06,Default,,0,0,0,,Гусуке мен енді ұша аламын.
Dialogue: 0,1:25:13.19,1:25:14.06,Default,,0,0,0,,Мисс Бекки қамалда тұрады
Dialogue: 0,1:25:14.69,1:25:18.02,Default,,0,0,0,,Сол кезде неге екені белгісіз Икардың даусын естідім.
Dialogue: 0,1:25:18.82,1:25:21.19,Default,,0,0,0,,«Батыл бол»
Dialogue: 0,1:25:26.87,1:25:28.28,Default,,0,0,0,,Дәл Гусуке-кун сияқты
Dialogue: 0,1:25:28.41,1:25:31.41,Default,,0,0,0,,Оны Икар иемденіп алған сияқты.
Dialogue: 0,1:25:31.54,1:25:33.16,Default,,0,0,0,,Рахмет Гусуке
Dialogue: 0,1:25:33.79,1:25:36.13,Default,,0,0,0,,О, Нобита, сен адам болғансың!?
Dialogue: 0,1:25:36.50,1:25:39.21,Default,,0,0,0,,О, аа! Бұл... дұрыс
Dialogue: 0,1:25:39.34,1:25:40.88,Default,,0,0,0,,Мен де (Сунео) Мен де
Dialogue: 0,1:25:41.01,1:25:42.09,Default,,0,0,0,,Хехе...
Dialogue: 0,1:25:42.42,1:25:45.51,Default,,0,0,0,,Мен де, үндемегенім үшін кешіріңіз.
Dialogue: 0,1:25:45.64,1:25:46.55,Default,,0,0,0,,Шизука-сан
Dialogue: 0,1:25:47.10,1:25:48.68,Default,,0,0,0,,Мен білдім
Dialogue: 0,1:25:48.81,1:25:52.18,Default,,0,0,0,,Икароза! Сіз амансыз деп үміттенемін
Dialogue: 0,1:25:52.31,1:25:53.89,Default,,0,0,0,,Құс айлағында барлығы күтіп тұр.
Dialogue: 0,1:25:54.44,1:25:56.56,Default,,0,0,0,,Финикия Томалиги шыңына шықты...
Dialogue: 0,1:25:56.69,1:25:58.61,Default,,0,0,0,,Ей, бұл адам! (Топ мүшелері) Иә!
Dialogue: 0,1:25:59.07,1:26:02.15,Default,,0,0,0,,Бұл адамдар Құс пиресін құтқару үшін біздің қайырымды адамдарымыз.
Dialogue: 0,1:26:02.57,1:26:05.32,Default,,0,0,0,,Иә!? Адамдарда құс пирстері бар ма?
Dialogue: 0,1:26:05.57,1:26:07.66,Default,,0,0,0,,Жарайды... жарайды.
Dialogue: 0,1:26:07.95,1:26:10.58,Default,,0,0,0,,А... рахмет (мүшелер) рахмет
Dialogue: 0,1:26:11.04,1:26:14.50,Default,,0,0,0,,Бұл тек біз емес, Гусуке-кун.
Dialogue: 0,1:26:14.62,1:26:19.29,Default,,0,0,0,,үшінның еңбегінің арқасында қолымыздан келді.
Dialogue: 0,1:26:34.98,1:26:37.06,Default,,0,0,0,,Бұдан былай қиын болады.
Dialogue: 0,1:26:37.19,1:26:39.40,Default,,0,0,0,,Бәріміз бірге жұмыс жасасақ, бәріміз жақсы боламыз.
Dialogue: 0,1:26:41.23,1:26:43.32,Default,,0,0,0,,Пико (бәрі күледі)
Dialogue: 0,1:26:43.74,1:26:48.78,Default,,0,0,0,,Бұдан былай адамдар мен құстар бір-біріне қолдау көрсетуі керек.
Dialogue: 0,1:26:49.07,1:26:50.41,Default,,0,0,0,,Біз де адамдармыз
Dialogue: 0,1:26:50.53,1:26:53.79,Default,,0,0,0,,Мен Құс пирстеріне сенбеуге тырысуым керек.
Dialogue: 0,1:26:53.91,1:26:54.70,Default,,0,0,0,,Иә
Dialogue: 0,1:27:07.05,1:27:08.89,Default,,0,0,0,,Келесі жылы Гусуке
Dialogue: 0,1:27:09.01,1:27:12.01,Default,,0,0,0,,Өз қанаттарыңмен Икар жарысын өткізуге болады.
Dialogue: 0,1:27:12.14,1:27:13.93,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,1:27:14.06,1:27:16.98,Default,,0,0,0,,Ал мен сені керемет патрульші етемін.
Dialogue: 0,1:27:17.44,1:27:19.44,Default,,0,0,0,,Осымен біздің жеңетінімізге еш күмән жоқ.
Dialogue: 0,1:27:20.02,1:27:23.90,Default,,0,0,0,,Баршаңызға көп рахмет, мен сізді ешқашан ұмытпаймын.
Dialogue: 0,1:27:24.69,1:27:27.86,Default,,0,0,0,,Біздің патрульдік топ сізді Бердвейге апарады.
Dialogue: 0,1:27:28.32,1:27:29.36,Default,,0,0,0,,Рахмет
Dialogue: 0,1:27:29.49,1:27:32.03,Default,,0,0,0,,Иә? Сунео ше? (Нобита) Иә? Сунео!
Dialogue: 0,1:27:32.16,1:27:34.08,Default,,0,0,0,,(Госукенің інісі және Сунеоның жылауы)
Dialogue: 0,1:27:34.20,1:27:37.04,Default,,0,0,0,,Мен сені үйге апара алмаймын~
Dialogue: 0,1:27:37.46,1:27:40.88,Default,,0,0,0,,Тез өсіп, патрульдік отрядқа қосыл.
Dialogue: 0,1:27:41.00,1:27:43.50,Default,,0,0,0,,Олай болса менімен кездесуге келуге болады, сондықтан...
Dialogue: 0,1:27:44.38,1:27:45.76,Default,,0,0,0,,Ал, үйге қайтайық.
Dialogue: 0,1:27:46.26,1:27:48.22,Default,,0,0,0,,Сау бол Гусуке
Dialogue: 0,1:27:48.72,1:27:50.68,Default,,0,0,0,,Иә, қош бол Нобита
Dialogue: 0,1:27:56.31,1:27:58.39,Default,,0,0,0,,Мені көруге келетініңізге сенімдімін.
Dialogue: 0,1:27:59.23,1:28:02.02,Default,,0,0,0,,Қош бол құс пирстері
Dialogue: 0,1:28:13.74,1:28:19.75,Default,,0,0,0,,♪〜
Dialogue: 0,1:31:09.13,1:31:15.13,Default,,0,0,0,,〜♪
