Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.32,0:00:05.70,Default,,0,0,0,,Мұнда келгенше күн суытады.
Dialogue: 0,0:00:06.12,0:00:08.91,Default,,0,0,0,,Бұл Кларинстен біршама қашықтықта.
Dialogue: 0,0:00:09.16,0:00:11.08,Default,,0,0,0,,Кешіріңіз, Шираюки.
Dialogue: 0,0:00:11.25,0:00:15.21,Default,,0,0,0,,Бұл аздап шұғыл, сондықтан мен оны жарты жолда ғана жібере аламын.
Dialogue: 0,0:00:15.33,0:00:17.09,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:00:17.25,0:00:19.25,Default,,0,0,0,,Ол мені ертіп, мінгізді.
Dialogue: 0,0:00:19.84,0:00:22.34,Default,,0,0,0,,Ракусудоға дейін бару, қандай тапсырма бар?
Dialogue: 0,0:00:22.72,0:00:24.68,Default,,0,0,0,,Сот фармацевті болу да қиын.
Dialogue: 0,0:00:24.93,0:00:26.60,Default,,0,0,0,,Өйткені мен шәкіртпін.
Dialogue: 0,0:00:26.72,0:00:29.22,Default,,0,0,0,,Сонымен қатар мен жиі шығып, үйренемін.
Dialogue: 0,0:00:29.72,0:00:33.85,Default,,0,0,0,,Ойлап қарасам, мен лорд Харукамен Шираюкидің қайтыс болуы туралы сөйлескенімде...
Dialogue: 0,0:00:33.98,0:00:35.81,Default,,0,0,0,,«Құттықтаймыз»
Dialogue: 0,0:00:35.94,0:00:37.73,Default,,0,0,0,,Мен болса да күрсіндім.
Dialogue: 0,0:00:38.02,0:00:41.86,Default,,0,0,0,,Бұл күлкілі, өйткені мен ол адамның не ойлайтынын оңай айта аламын.
Dialogue: 0,0:00:41.99,0:00:43.32,Default,,0,0,0,,Мүлдем емес
Dialogue: 0,0:00:44.28,0:00:46.03,Default,,0,0,0,,Дзен Бірдеңе болды ма?
Dialogue: 0,0:00:46.57,0:00:48.12,Default,,0,0,0,,Шұғыл бизнес туралы не деуге болады?
Dialogue: 0,0:00:48.74,0:00:52.25,Default,,0,0,0,,Жоқ, бұл қамалға кезекті тексеру.
Dialogue: 0,0:00:52.37,0:00:55.04,Default,,0,0,0,,Luxd менің юрисдикциямда.
Dialogue: 0,0:00:57.67,0:00:59.38,Default,,0,0,0,,Онда мен осындамын
Dialogue: 0,0:01:00.17,0:01:01.71,Default,,0,0,0,,Күн суық, айналма жолмен жүрме.
Dialogue: 0,0:01:01.84,0:01:02.51,Default,,0,0,0,,Иә
Dialogue: 0,0:01:03.05,0:01:04.13,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:01:05.59,0:01:07.64,Default,,0,0,0,,Сырттан көп нәрсе алуға болады
Dialogue: 0,0:01:07.76,0:01:08.43,Default,,0,0,0,,Зен
Dialogue: 0,0:01:11.14,0:01:12.39,Default,,0,0,0,,Абайлаңыз!
Dialogue: 0,0:01:13.93,0:01:16.06,Default,,0,0,0,,Бұл ел туралы естігенім, көргенім.
Dialogue: 0,0:01:16.69,0:01:18.40,Default,,0,0,0,,Ондай кездесулер-
Dialogue: 0,0:01:19.52,0:01:22.82,Default,,0,0,0,,Тәжірибе арқылы үйренген эмоциялар
Dialogue: 0,0:01:24.40,0:01:29.41,Default,,0,0,0,,♪～
Dialogue: 0,0:02:48.78,0:02:53.78,Default,,0,0,0,,～♪
Dialogue: 0,0:02:57.54,0:02:59.75,Default,,0,0,0,,Мен күзетшілерді көре алмаймын.
Dialogue: 0,0:02:59.92,0:03:00.58,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:03:00.71,0:03:05.17,Default,,0,0,0,,Біреу жоғалып кетті ме? Ол корольдік гвардиядан. Эй!
Dialogue: 0,0:03:07.80,0:03:08.80,Default,,0,0,0,,Күте тұрыңыз...
Dialogue: 0,0:03:14.39,0:03:15.64,Default,,0,0,0,,Эй, жақсысың ба?
Dialogue: 0,0:03:17.22,0:03:19.69,Default,,0,0,0,,Барлығы... Жоғары мәртебелі мәртебеге дейін.
Dialogue: 0,0:03:19.81,0:03:23.31,Default,,0,0,0,,Біз тұрақты байланысымызды үздік, сондықтан мен сізді тексеруге келдім.
Dialogue: 0,0:03:23.56,0:03:24.86,Default,,0,0,0,,Міне, мен... Ұстаз!
Dialogue: 0,0:03:26.98,0:03:27.65,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:28.07,0:03:30.36,Default,,0,0,0,,Барлығы қамалда ұйықтап жатыр.
Dialogue: 0,0:03:30.86,0:03:31.95,Default,,0,0,0,,Сіз ұйықтап жатырсыз ба?
Dialogue: 0,0:03:32.11,0:03:33.87,Default,,0,0,0,,Бұл... Бұл адам кім?
Dialogue: 0,0:03:34.32,0:03:36.24,Default,,0,0,0,,Мен қожайынның қызметшісімін.
Dialogue: 0,0:03:36.58,0:03:38.25,Default,,0,0,0,,Бұл әлі сынақ мерзімі.
Dialogue: 0,0:03:38.37,0:03:42.54,Default,,0,0,0,,Болды... Тізгінді сенің қолыңа тапсырдым.
Dialogue: 0,0:03:42.67,0:03:43.83,Default,,0,0,0,,сақталмайды
Dialogue: 0,0:03:44.71,0:03:46.09,Default,,0,0,0,,Мен сені мазалаймын.
Dialogue: 0,0:03:46.25,0:03:47.50,Default,,0,0,0,,Жоқ... жоқ
Dialogue: 0,0:03:47.63,0:03:50.80,Default,,0,0,0,,Бұл жерді қорқынышты құбыжық аңдып жүр.
Dialogue: 0,0:03:50.92,0:03:52.18,Default,,0,0,0,,Құбыжық?
Dialogue: 0,0:03:53.55,0:03:55.18,Default,,0,0,0,,20 күн бұрын
Dialogue: 0,0:03:55.80,0:03:59.10,Default,,0,0,0,,Барлығы бірінен соң бірі физикалық ауытқуларға шағымдана бастады.
Dialogue: 0,0:03:59.52,0:04:02.60,Default,,0,0,0,,Көз алдыңызда ауыр немесе қараңғылық сезінесіз бе?
Dialogue: 0,0:04:03.23,0:04:06.02,Default,,0,0,0,,Көбісі тепе-теңдік сезімін жоғалтқан сияқты...
Dialogue: 0,0:04:06.32,0:04:09.44,Default,,0,0,0,,Терапевт те барлығын тексеріп жатқанда құлап қалды.
Dialogue: 0,0:04:10.03,0:04:14.03,Default,,0,0,0,,Мен себебін білмеймін, бірақ мұндай нәрсе құбыжықтың ісі болуы керек ...
Dialogue: 0,0:04:14.24,0:04:15.12,Default,,0,0,0,,Ал сіз ше?
Dialogue: 0,0:04:15.28,0:04:17.12,Default,,0,0,0,,Мен өз басым онша емеспін.
Dialogue: 0,0:04:17.66,0:04:21.21,Default,,0,0,0,,Алайда қарлы жолмен жүруге жағдайым жақсы емес.
Dialogue: 0,0:04:21.54,0:04:23.00,Default,,0,0,0,,Ішіне көз жүгіртіп көрейін.
Dialogue: 0,0:04:23.12,0:04:23.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:24.00,0:04:27.38,Default,,0,0,0,,Мәртебелімен бірдеңе болғанша күтіңіз.
Dialogue: 0,0:04:27.50,0:04:31.01,Default,,0,0,0,,Бұлай істеудің қажеті жоқ, сондықтан өзіңізді қатты итермеңіз.
Dialogue: 0,0:04:31.84,0:04:35.05,Default,,0,0,0,,Сізге демалу керек. Сен жақсы ұстап тұрдың.
Dialogue: 0,0:04:36.89,0:04:37.89,Default,,0,0,0,,Иә
Dialogue: 0,0:04:38.97,0:04:41.85,Default,,0,0,0,,Дзен Мен сені күн батқанға дейін жіберемін.
Dialogue: 0,0:04:41.98,0:04:44.98,Default,,0,0,0,,Аа, Мицухиде, сыртта күзетші.
Dialogue: 0,0:04:45.52,0:04:47.65,Default,,0,0,0,,Мен барлығының ішінде болуын болдырғым келеді.
Dialogue: 0,0:04:47.77,0:04:48.44,Default,,0,0,0,,Түсінді.
Dialogue: 0,0:04:48.57,0:04:51.53,Default,,0,0,0,,Күте тұрыңыз... Эй, бұл қалыпты жағдай. Шебер шығып кеткен шығар.
Dialogue: 0,0:04:51.65,0:04:52.74,Default,,0,0,0,,Егер сізде қандай да бір ауру болса...
Dialogue: 0,0:04:53.28,0:04:55.78,Default,,0,0,0,,Оның қайдан шыққанын білсеңіз...
Dialogue: 0,0:04:55.99,0:04:57.91,Default,,0,0,0,,Бұл құр қол қайтқаннан жақсы.
Dialogue: 0,0:04:58.74,0:05:01.45,Default,,0,0,0,,Амансың ба? Тоқтамаңыз.
Dialogue: 0,0:05:01.62,0:05:03.50,Default,,0,0,0,,Солдаттар уайымдаса керек.
Dialogue: 0,0:05:03.62,0:05:05.00,Default,,0,0,0,,Мицухиде-сан
Dialogue: 0,0:05:05.12,0:05:07.79,Default,,0,0,0,,Сіз ханзаданың жақын көмекшісі болсаңыз да, солай емес пе?
Dialogue: 0,0:05:07.96,0:05:10.09,Default,,0,0,0,,О, Зен.
Dialogue: 0,0:05:18.64,0:05:21.27,Default,,0,0,0,,Мен ерекше ештеңе көрмеймін.
Dialogue: 0,0:05:21.39,0:05:24.77,Default,,0,0,0,,Мен мұны шынымен құбыжықтың жұмысы деп ойламаппын.
Dialogue: 0,0:05:24.89,0:05:28.65,Default,,0,0,0,,Ондай адам бар болса, мен көмек сұрайын деп едім.
Dialogue: 0,0:05:30.94,0:05:32.61,Default,,0,0,0,,Бұл қару-жарақ қоймасы.
Dialogue: 0,0:05:35.28,0:05:38.82,Default,,0,0,0,,Бұл аса маңызды емес сияқты... иә?
Dialogue: 0,0:05:40.62,0:05:42.08,Default,,0,0,0,,Қару-жарақ қоймасы бос па?
Dialogue: 0,0:05:42.20,0:05:44.54,Default,,0,0,0,,Бұрынғы жауынгер де білмесе керек.
Dialogue: 0,0:05:44.91,0:05:49.38,Default,,0,0,0,,Сондай-ақ тырнақ таңбалары да болды, сондықтан олар бұл мүмкіндікті пайдаланған болуы керек.
Dialogue: 0,0:05:50.29,0:05:52.09,Default,,0,0,0,,Қарақшыларды жоюға ауысқыңыз келе ме?
Dialogue: 0,0:05:52.63,0:05:54.55,Default,,0,0,0,,Бұл сіздің мамандығыңыз.
Dialogue: 0,0:05:54.67,0:05:55.59,Default,,0,0,0,,Аузыңды жап
Dialogue: 0,0:05:55.72,0:05:57.47,Default,,0,0,0,,Мамандықтар…
Dialogue: 0,0:05:58.26,0:05:59.30,Default,,0,0,0,,Шираюкиге қоңырау шалсам ше?
Dialogue: 0,0:06:00.18,0:06:01.10,Default,,0,0,0,,Егер бұл бала...
Dialogue: 0,0:06:01.22,0:06:04.47,Default,,0,0,0,,Мүмкін біз сарбаздарға не болып жатқанын біле аламыз.
Dialogue: 0,0:06:05.48,0:06:07.39,Default,,0,0,0,,Мицухиде О
Dialogue: 0,0:06:11.65,0:06:14.23,Default,,0,0,0,,Мен оны күн батқанға дейін уақытында жасай аламын деп үміттенемін.
Dialogue: 0,0:06:14.86,0:06:16.65,Default,,0,0,0,,Сәлем, Ағаштар ханым.
Dialogue: 0,0:06:16.82,0:06:20.28,Default,,0,0,0,,Мицухиде ханзада Дзен туралы пікірі жоқ екені рас па?
Dialogue: 0,0:06:21.58,0:06:24.91,Default,,0,0,0,,Кики мисс негізгі сәттерде байсалды сөйлейтін сияқты, бірақ...
Dialogue: 0,0:06:25.04,0:06:27.04,Default,,0,0,0,,Сіздің серіктесіңіз сәл тәтті емес пе?
Dialogue: 0,0:06:27.50,0:06:30.08,Default,,0,0,0,,Ал, сен қалай ойлайсың?
Dialogue: 0,0:06:30.21,0:06:30.88,Default,,0,0,0,,келді
Dialogue: 0,0:06:32.29,0:06:32.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:39.84,0:06:42.05,Default,,0,0,0,,Терапевт дәрі жазып берді ме?
Dialogue: 0,0:06:42.55,0:06:44.77,Default,,0,0,0,,Иә... басында.
Dialogue: 0,0:06:45.02,0:06:48.56,Default,,0,0,0,,Алайда жылдың осы мезгілінде қол жетімді емдік шөптер оны ұстай алмайды...
Dialogue: 0,0:06:48.69,0:06:49.77,Default,,0,0,0,,Қуып жете алмайсыз ба?
Dialogue: 0,0:06:50.19,0:06:52.11,Default,,0,0,0,,Суық аймақтардағы дәрілік шөптер-
Dialogue: 0,0:06:52.23,0:06:55.44,Default,,0,0,0,,Медициналық тиімділігі төмен препараттың мөлшері қажет болады.
Dialogue: 0,0:06:55.57,0:06:56.23,Default,,0,0,0,,Иә
Dialogue: 0,0:06:57.03,0:06:59.61,Default,,0,0,0,,Жарайды. Тағы бір нәрсе байқадыңыз ба?
Dialogue: 0,0:06:59.95,0:07:04.28,Default,,0,0,0,,Жоқ, мен сыртта жиі күзетемін...
Dialogue: 0,0:07:04.95,0:07:06.95,Default,,0,0,0,,Кешіріңіз, мен көмектесе алмаймын.
Dialogue: 0,0:07:07.08,0:07:09.46,Default,,0,0,0,,Жоқ... бәрібір.
Dialogue: 0,0:07:09.58,0:07:11.17,Default,,0,0,0,,Менің атым Шука.
Dialogue: 0,0:07:11.79,0:07:14.34,Default,,0,0,0,,Егер менің қолымнан келетін нәрсе болса, маған хабарлаңыз.
Dialogue: 0,0:07:14.80,0:07:16.13,Default,,0,0,0,,Бұл пайдалы.
Dialogue: 0,0:07:16.55,0:07:18.51,Default,,0,0,0,,Бірақ қазір демалыңыз.
Dialogue: 0,0:07:19.72,0:07:20.72,Default,,0,0,0,,Иә
Dialogue: 0,0:07:22.72,0:07:25.18,Default,,0,0,0,,Ол өте әлсіз сияқты.
Dialogue: 0,0:07:25.31,0:07:28.85,Default,,0,0,0,,Дзен қазір сыртқа шығуы керек, әйтпесе ол құлап қалмайды.
Dialogue: 0,0:07:29.60,0:07:30.77,Default,,0,0,0,,Тағы біраз нәрсе қалды
Dialogue: 0,0:07:30.89,0:07:32.94,Default,,0,0,0,,Бұл жаман!
Dialogue: 0,0:07:33.06,0:07:34.65,Default,,0,0,0,,Мен суықты ұнатпаймын
Dialogue: 0,0:07:34.90,0:07:36.11,Default,,0,0,0,,Сәйкес Айтпа!
Dialogue: 0,0:07:36.23,0:07:39.28,Default,,0,0,0,,Мен сізге қоңырау шалсам, жалғыз келе аламын ба?
Dialogue: 0,0:07:41.03,0:07:45.16,Default,,0,0,0,,Егер мен Зенмен бірге бірдеңе істей алсам, мен мұны істеймін.
Dialogue: 0,0:07:45.49,0:07:46.91,Default,,0,0,0,,Бірақ қазір бәрі басқаша.
Dialogue: 0,0:07:47.29,0:07:50.00,Default,,0,0,0,,Мен өз жолыммен көмектесуге тырысамын.
Dialogue: 0,0:07:50.37,0:07:51.75,Default,,0,0,0,,Шираюки
Dialogue: 0,0:07:53.17,0:07:55.67,Default,,0,0,0,,Мен де қаламын
Dialogue: 0,0:07:55.79,0:07:56.59,Default,,0,0,0,,Зен
Dialogue: 0,0:07:59.55,0:08:01.97,Default,,0,0,0,,Күн батқанша деді емес пе?
Dialogue: 0,0:08:02.63,0:08:05.47,Default,,0,0,0,,Енді мен өз ұстанымымды ойлауым керек.
Dialogue: 0,0:08:12.81,0:08:13.81,Default,,0,0,0,,Өзімшілдік айтты
Dialogue: 0,0:08:14.40,0:08:16.61,Default,,0,0,0,,Бас тарту Егер сізге бірдеңе керек болса, маған қоңырау шалыңыз.
Dialogue: 0,0:08:25.66,0:08:28.99,Default,,0,0,0,,Жақсы шыдадың, қайсар адам.
Dialogue: 0,0:08:30.41,0:08:32.46,Default,,0,0,0,,Бәлкім, сен айтқандықтан шығар.
Dialogue: 0,0:08:32.79,0:08:34.58,Default,,0,0,0,,Иә, ұялмаңыз.
Dialogue: 0,0:08:34.75,0:08:37.84,Default,,0,0,0,,Шираюкидің қауіпсіздігіне алаңдайтыныңызды түсінемін.
Dialogue: 0,0:08:38.71,0:08:39.75,Default,,0,0,0,,Осы сезім сияқты――
Dialogue: 0,0:08:40.26,0:08:42.17,Default,,0,0,0,,Ол сенуге болатын адам емес пе?
Dialogue: 0,0:08:45.05,0:08:46.34,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:08:47.72,0:08:51.39,Default,,0,0,0,,Бірақ сенің суықты ұнатпайтыныңды бірінші рет естіп тұрмын.
Dialogue: 0,0:08:51.68,0:08:54.10,Default,,0,0,0,,Ондай жерде ұйықтауға бола ма?
Dialogue: 0,0:08:54.81,0:08:57.23,Default,,0,0,0,,Шулы! Мен басымды салқын ұстаймын!
Dialogue: 0,0:08:57.65,0:09:00.19,Default,,0,0,0,,Бір таңқаларлығы, мен Ұстаздың айтқанын естідім.
Dialogue: 0,0:09:00.32,0:09:01.61,Default,,0,0,0,,Шындық -
Dialogue: 0,0:09:01.74,0:09:05.32,Default,,0,0,0,,Дзен тыңдайтын жалғыз нәрсе - Мицухиденің сөздері.
Dialogue: 0,0:09:05.66,0:09:08.45,Default,,0,0,0,,Сондықтан сіз әдетте ештеңе айтпайсыз ба?
Dialogue: 0,0:09:09.20,0:09:11.08,Default,,0,0,0,,Сіз мені бүлдіргіңіз келмейді, солай ма?
Dialogue: 0,0:09:17.42,0:09:18.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:26.89,0:09:28.05,Default,,0,0,0,,Шираюки-доно
Dialogue: 0,0:09:28.55,0:09:30.01,Default,,0,0,0,,Сіз бірдеңені түсіндіңіз бе?
Dialogue: 0,0:09:30.35,0:09:32.22,Default,,0,0,0,,Ұйықтамағаныңыз дұрыс па?
Dialogue: 0,0:09:32.35,0:09:34.73,Default,,0,0,0,,Мен кішкене үзіліс жасадым.
Dialogue: 0,0:09:34.85,0:09:38.19,Default,,0,0,0,,Иә... бұл жерде әлі ештеңе жоқ.
Dialogue: 0,0:09:38.73,0:09:40.98,Default,,0,0,0,,Бастапқы белгілер барлығына бірдей.
Dialogue: 0,0:09:41.40,0:09:44.24,Default,,0,0,0,,Бірақ қазір мен белгілердің айырмашылығын көріп тұрмын.
Dialogue: 0,0:09:44.69,0:09:46.40,Default,,0,0,0,,Қандай да бір себептермен
Dialogue: 0,0:09:46.66,0:09:48.66,Default,,0,0,0,,Мен мұны түсінбеймін
Dialogue: 0,0:09:48.78,0:09:52.12,Default,,0,0,0,,Бірақ мен терапевт жазған дәріні түсінемін.
Dialogue: 0,0:09:52.33,0:09:55.29,Default,,0,0,0,,Мен көшеде сатып алған дәріні араластырып көрейін деп ойладым.
Dialogue: 0,0:09:57.21,0:09:58.00,Default,,0,0,0,,Шираюки-доно!
Dialogue: 0,0:09:58.71,0:09:59.63,Default,,0,0,0,,Тек L өз ықпалындағы біреумен алмастырылған
Dialogue: 0,0:09:59.75,0:10:00.75,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:01.25,0:10:03.46,Default,,0,0,0,,Бұл жақын арада болмауы керек...
Dialogue: 0,0:10:04.21,0:10:05.84,Default,,0,0,0,,Әр адамда әр түрлі бола ма?
Dialogue: 0,0:10:05.97,0:10:07.43,Default,,0,0,0,,Шираюки-доно…
Dialogue: 0,0:10:08.68,0:10:09.68,Default,,0,0,0,,Шука-сан...
Dialogue: 0,0:10:09.80,0:10:13.14,Default,,0,0,0,,Сіз сыртта жиі күзететініңізді айттыңыз.
Dialogue: 0,0:10:13.27,0:10:14.39,Default,,0,0,0,,А... иә
Dialogue: 0,0:10:15.02,0:10:18.23,Default,,0,0,0,,Бұл бөлменің ішінде себеп бар дегенді білдіреді...
Dialogue: 0,0:10:20.44,0:10:22.82,Default,,0,0,0,,Кіреберістен алыс жатқандар...
Dialogue: 0,0:10:22.94,0:10:24.44,Default,,0,0,0,,Ауыр науқас көрінеді
Dialogue: 0,0:10:34.54,0:10:35.33,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:41.71,0:10:44.21,Default,,0,0,0,,Шынымен суық екен, ау
Dialogue: 0,0:10:44.34,0:10:45.46,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:10:47.47,0:10:48.22,Default,,0,0,0,,Шираюки!
Dialogue: 0,0:10:48.88,0:10:49.80,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:50.14,0:10:52.43,Default,,0,0,0,,Жарайды, мен тым жақын жұмыс істедім.
Dialogue: 0,0:10:53.85,0:10:56.18,Default,,0,0,0,,Себеп - Камин ағашы.
Dialogue: 0,0:10:57.06,0:10:59.23,Default,,0,0,0,,Бұл ағашты өртеуге болмайды.
Dialogue: 0,0:10:59.35,0:11:02.98,Default,,0,0,0,,Зиянды бөлшектер таралады, егер сіз дем алуды жалғастырсаңыз, әсер етеді
Dialogue: 0,0:11:03.11,0:11:04.65,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:11:04.77,0:11:06.48,Default,,0,0,0,,Шука-санның айтуы бойынша...
Dialogue: 0,0:11:06.61,0:11:09.24,Default,,0,0,0,,Себебі саяхатшы топ тасымалдау үшін багажға айналады...
Dialogue: 0,0:11:09.36,0:11:10.78,Default,,0,0,0,,Бұл сіз маған берген нәрсе болды.
Dialogue: 0,0:11:10.99,0:11:13.33,Default,,0,0,0,,Қайталағаным үшін кешірім сұраймыз!
Dialogue: 0,0:11:13.45,0:11:16.33,Default,,0,0,0,,Өзіңізді жеңіл сезінесіз бе?
Dialogue: 0,0:11:16.66,0:11:19.75,Default,,0,0,0,,Иә, Шираюки-доно маған дәрі берді.
Dialogue: 0,0:11:20.37,0:11:21.71,Default,,0,0,0,,Жақсы
Dialogue: 0,0:11:22.63,0:11:24.54,Default,,0,0,0,,Жұмыс істеп тұрған сияқты.
Dialogue: 0,0:11:28.42,0:11:31.30,Default,,0,0,0,,Мен өз жолыммен көмектесуге тырысамын.
Dialogue: 0,0:11:36.14,0:11:36.89,Default,,0,0,0,,Мидория, рингтен шық.
Dialogue: 0,0:11:39.64,0:11:43.31,Default,,0,0,0,,Шираюки, сен... кереметсің.
Dialogue: 0,0:11:44.11,0:11:45.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:45.23,0:11:47.23,Default,,0,0,0,,Осы жерде біраз тұра аласыз ба?
Dialogue: 0,0:11:47.78,0:11:50.57,Default,,0,0,0,,Мен солдаттарды сізге қалдырғым келеді.
Dialogue: 0,0:11:52.95,0:11:54.07,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:57.54,0:12:00.54,Default,,0,0,0,,Мен бірнеше күннің ішінде қатты қалпына келгеніме сене алар емеспін...
Dialogue: 0,0:12:00.75,0:12:03.04,Default,,0,0,0,,Шираюкидің шеберлігі сөзсіз.
Dialogue: 0,0:12:03.17,0:12:04.04,Default,,0,0,0,,О
Dialogue: 0,0:12:04.25,0:12:05.17,Default,,0,0,0,,Зен
Dialogue: 0,0:12:07.96,0:12:08.63,Default,,0,0,0,,Ұры...
Dialogue: 0,0:12:09.21,0:12:10.01,Default,,0,0,0,,Иә
Dialogue: 0,0:12:10.13,0:12:13.84,Default,,0,0,0,,Раксед аймағында орналасқан топ бар сияқты.
Dialogue: 0,0:12:13.97,0:12:15.22,Default,,0,0,0,,Олар не жасырады?
Dialogue: 0,0:12:15.60,0:12:18.10,Default,,0,0,0,,Осыған байланысты маған біраз уақыт беріңіз.
Dialogue: 0,0:12:18.22,0:12:20.27,Default,,0,0,0,,Олай болса маған қалдырыңыз.
Dialogue: 0,0:12:20.73,0:12:24.02,Default,,0,0,0,,Мен сендерге қарағанда қала туралы көбірек білемін.
Dialogue: 0,0:12:29.32,0:12:31.99,Default,,0,0,0,,Ол маймыл (ағаштар), бұл анық.
Dialogue: 0,0:12:32.11,0:12:33.45,Default,,0,0,0,,Мицухиде ағаштары
Dialogue: 0,0:12:33.95,0:12:36.99,Default,,0,0,0,,Мен бұл мәселені өзіміз шешкім келеді.
Dialogue: 0,0:12:37.87,0:12:40.83,Default,,0,0,0,,Мен Шираюкиге ғана сене алмаймын.
Dialogue: 0,0:12:45.71,0:12:46.84,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:47.29,0:12:49.96,Default,,0,0,0,,Бұл қайнатпа. Сіз оны ішкіңіз келе ме?
Dialogue: 0,0:12:50.09,0:12:51.05,Default,,0,0,0,,Әй... Мен ащымын.
Dialogue: 0,0:12:51.51,0:12:53.72,Default,,0,0,0,,Хехе, нәр береді екен.
Dialogue: 0,0:12:55.14,0:12:57.60,Default,,0,0,0,,Ум... Шираюки-доно
Dialogue: 0,0:12:58.30,0:12:59.39,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:12:59.93,0:13:00.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:00.81,0:13:03.35,Default,,0,0,0,,Мен... Мен ештеңе істей алмаймын.
Dialogue: 0,0:13:03.48,0:13:07.15,Default,,0,0,0,,Жоғары мәртебелі Дзен бұл қамал үшін ұялды ма?
Dialogue: 0,0:13:08.40,0:13:10.07,Default,,0,0,0,,Сіз солай ойлайсыз ба?
Dialogue: 0,0:13:10.19,0:13:11.99,Default,,0,0,0,,Шынымды айтсам, мен уайымдап тұрмын.
Dialogue: 0,0:13:12.11,0:13:14.74,Default,,0,0,0,,Болашақта сенен арақашықтықты сақтасам ше?
Dialogue: 0,0:13:15.57,0:13:17.20,Default,,0,0,0,,Дзен жиі осында ма?
Dialogue: 0,0:13:17.37,0:13:18.32,Default,,0,0,0,,Иә
Dialogue: 0,0:13:18.49,0:13:22.95,Default,,0,0,0,,Мен патрульге шыққанда мен үлкендермен қала туралы сөйлестік...
Dialogue: 0,0:13:23.33,0:13:27.79,Default,,0,0,0,,Олар да мен сияқты шәкірттер туралы әңгімелерді тыңдағанды ұнататын сияқты.
Dialogue: 0,0:13:28.46,0:13:30.55,Default,,0,0,0,,Мен сізге көмектескім келеді...
Dialogue: 0,0:13:31.05,0:13:34.05,Default,,0,0,0,,Енді мұнда келмеуі мүмкін.
Dialogue: 0,0:13:34.17,0:13:35.68,Default,,0,0,0,,Жақсы сияқты
Dialogue: 0,0:13:36.18,0:13:36.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:37.47,0:13:41.43,Default,,0,0,0,,Мен мұнда қайта-қайта келемін деп ойлаймын, себебі бұл мағыналы.
Dialogue: 0,0:13:41.81,0:13:44.31,Default,,0,0,0,,Дзен мұнда көңілді жүрген сияқты...
Dialogue: 0,0:13:44.43,0:13:46.10,Default,,0,0,0,,Мен де оны көргім келеді
Dialogue: 0,0:13:54.44,0:13:57.07,Default,,0,0,0,,Жарайды, мен жаздым.
Dialogue: 0,0:14:01.49,0:14:04.54,Default,,0,0,0,,Әрі қарай есеп жасаңыз.
Dialogue: 0,0:14:04.66,0:14:10.13,Default,,0,0,0,,Түстен кейін дәрі дайында...
Dialogue: 0,0:14:11.13,0:14:12.25,Default,,0,0,0,,Шираюки
Dialogue: 0,0:14:12.59,0:14:13.46,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:14.38,0:14:15.84,Default,,0,0,0,,Нашар Сіз ұйықтадыңыз ба?
Dialogue: 0,0:14:15.97,0:14:16.93,Default,,0,0,0,,Жоқ
Dialogue: 0,0:14:17.05,0:14:19.64,Default,,0,0,0,,Қарасам, солдаттар оянып жатыр.
Dialogue: 0,0:14:19.76,0:14:20.43,Default,,0,0,0,,Не!
Dialogue: 0,0:14:23.10,0:14:25.85,Default,,0,0,0,,Денеңізді қозғалтқанда ештеңе сезбейсіз бе?
Dialogue: 0,0:14:25.98,0:14:28.06,Default,,0,0,0,,О, жарайды, жарайды
Dialogue: 0,0:14:28.19,0:14:31.86,Default,,0,0,0,,Шираюки-доно, кейінірек тамыр соғуын тексеріңіз.
Dialogue: 0,0:14:31.98,0:14:34.82,Default,,0,0,0,,Сізге тек қамқорлық қажет!
Dialogue: 0,0:14:34.94,0:14:37.78,Default,,0,0,0,,Толық сауығып кеткіңіз келсе, байсалды болыңыз!
Dialogue: 0,0:14:37.90,0:14:40.66,Default,,0,0,0,,Сонымен... Мәртебелі (2-солдат) Кешіріңіз!
Dialogue: 0,0:14:40.82,0:14:41.49,Default,,0,0,0,,Мүлдем емес
Dialogue: 0,0:14:41.78,0:14:43.70,Default,,0,0,0,,Олар керемет жұмыс істейді, солай емес пе?
Dialogue: 0,0:14:44.29,0:14:46.58,Default,,0,0,0,,Бар. Мен барлығын сұрадым.
Dialogue: 0,0:14:47.04,0:14:47.96,Default,,0,0,0,,Иә
Dialogue: 0,0:14:48.33,0:14:51.04,Default,,0,0,0,,Жарайды, тамақ дайындамас бұрын...
Dialogue: 0,0:14:54.17,0:14:56.84,Default,,0,0,0,,Менің ұйқым аздап кетті.
Dialogue: 0,0:15:07.35,0:15:08.69,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:10.98,0:15:11.65,Default,,0,0,0,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,0:15:11.77,0:15:14.32,Default,,0,0,0,,Әй, жақсысың ба?
Dialogue: 0,0:15:15.28,0:15:18.86,Default,,0,0,0,,Мастер рұқсатсыз оған жақындамау керектігін айтты...
Dialogue: 0,0:15:34.21,0:15:35.25,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:15:35.80,0:15:38.13,Default,,0,0,0,,А... Мен сенемін, сен...
Dialogue: 0,0:15:38.67,0:15:39.63,Default,,0,0,0,,Мұнда не бар?
Dialogue: 0,0:15:40.01,0:15:42.68,Default,,0,0,0,,Мен қазір ханзада Зеннің қызметшісімін.
Dialogue: 0,0:15:42.89,0:15:46.22,Default,,0,0,0,,Дұрыс, көп рахмет.
Dialogue: 0,0:15:47.06,0:15:49.27,Default,,0,0,0,,Менен қорықпайсың ба?
Dialogue: 0,0:15:49.98,0:15:53.81,Default,,0,0,0,,Көмек алғаннан кейін сонша сақтық танытудың мәні неде?
Dialogue: 0,0:15:54.31,0:15:55.27,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:15:57.78,0:16:00.11,Default,,0,0,0,,Жас ханым, өзіңізді нашар сезініп тұрсыз, солай емес пе?
Dialogue: 0,0:16:01.74,0:16:03.32,Default,,0,0,0,,Барлығына үндемеңіз.
Dialogue: 0,0:16:03.66,0:16:04.95,Default,,0,0,0,,Айтсаңыз да...
Dialogue: 0,0:16:05.07,0:16:07.79,Default,,0,0,0,,Айтқаныңды тыңда, міндет емес.
Dialogue: 0,0:16:07.91,0:16:09.79,Default,,0,0,0,,Олай болса, біреуін қарызға алыңыз.
Dialogue: 0,0:16:09.91,0:16:10.62,Default,,0,0,0,,Қарыз алу керек пе?
Dialogue: 0,0:16:11.58,0:16:14.88,Default,,0,0,0,,Мені жебемен қорқытқаныңды неге қозғамайсың?
Dialogue: 0,0:16:15.42,0:16:18.17,Default,,0,0,0,,Жарайды, бірақ жасыру себебін айтыңызшы.
Dialogue: 0,0:16:18.34,0:16:23.51,Default,,0,0,0,,(сарбаздар сөйлейді)
Dialogue: 0,0:16:23.64,0:16:25.51,Default,,0,0,0,,Қазір бәрі жақсы сезінеді, солай емес пе?
Dialogue: 0,0:16:26.43,0:16:27.18,Default,,0,0,0,,Иә
Dialogue: 0,0:16:28.51,0:16:30.93,Default,,0,0,0,,Сондықтан мен оны еш қиындықсыз жапқым келеді.
Dialogue: 0,0:16:40.19,0:16:41.74,Default,,0,0,0,,Әрі қарай не істеуім керек?
Dialogue: 0,0:16:42.40,0:16:43.66,Default,,0,0,0,,Қандай бақыттысыңдар, барлық қызықты өзіңе алдыңдар.
Dialogue: 0,0:16:44.49,0:16:45.87,Default,,0,0,0,,Оңтүстікте бір қалыпты емес нәрсе бар ма?
Dialogue: 0,0:16:46.32,0:16:48.91,Default,,0,0,0,,Сондай-ақ батыс мұнарасына бір рет бару керек.
Dialogue: 0,0:16:49.29,0:16:51.00,Default,,0,0,0,,Иә... (1-ші солдат) Мәртебелі.
Dialogue: 0,0:16:51.25,0:16:54.54,Default,,0,0,0,,Қозғала алатындарды жинап, патрульге шығыңыз.
Dialogue: 0,0:16:54.83,0:16:56.17,Default,,0,0,0,,Денеңіз жақсы ма?
Dialogue: 0,0:16:56.46,0:16:58.54,Default,,0,0,0,,Иә, Шираюки-доноға рахмет.
Dialogue: 0,0:16:59.17,0:17:01.17,Default,,0,0,0,,Біз сізге бұдан былай қиындық тудырмаймыз.
Dialogue: 0,0:17:01.55,0:17:03.80,Default,,0,0,0,,Біз де өз міндеттерімізді қолдан келгенше орындаймыз.
Dialogue: 0,0:17:04.13,0:17:06.80,Default,,0,0,0,,Түсіндім, өзіңізді қатты итермеңіз.
Dialogue: 0,0:17:06.93,0:17:07.60,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:08.01,0:17:10.52,Default,,0,0,0,,Дұрыс, Шука, сенде әлі дәрі бар ма?
Dialogue: 0,0:17:10.64,0:17:11.31,Default,,0,0,0,,Жоқ-
Dialogue: 0,0:17:11.93,0:17:15.98,Default,,0,0,0,,Себебі Шираюки-доно оны оянған уақытына қарай жасайды.
Dialogue: 0,0:17:16.10,0:17:16.77,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:17.31,0:17:19.27,Default,,0,0,0,,Барлығы оны ішіп жатыр ма?
Dialogue: 0,0:17:19.40,0:17:21.44,Default,,0,0,0,,Иә Иә?
Dialogue: 0,0:17:21.73,0:17:23.74,Default,,0,0,0,,Енді үш ауысым болды, солай ма?
Dialogue: 0,0:17:24.36,0:17:25.36,Default,,0,0,0,,О
Dialogue: 0,0:17:25.61,0:17:27.95,Default,,0,0,0,,Сарбаздар әр 8 сағат сайын оянады
Dialogue: 0,0:17:28.28,0:17:29.08,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:17:30.79,0:17:32.20,Default,,0,0,0,,Оның аты Фантом Дуби.
Dialogue: 0,0:17:32.33,0:17:35.67,Default,,0,0,0,,Шираюки-доно, сен қашан ұйықтайсың...
Dialogue: 0,0:17:35.79,0:17:36.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:42.76,0:17:43.55,Default,,0,0,0,,Зен?
Dialogue: 0,0:17:44.13,0:17:47.47,Default,,0,0,0,,Отыр (Шираюки) Ух... Иә.
Dialogue: 0,0:17:50.18,0:17:52.39,Default,,0,0,0,,Көзіңізді 60 секундқа баяу жабыңыз
Dialogue: 0,0:17:52.52,0:17:54.14,Default,,0,0,0,,Не? Импульс?
Dialogue: 0,0:17:54.27,0:17:57.15,Default,,0,0,0,,Жарайды, жарты жолда көзіңді ашпа.
Dialogue: 0,0:17:57.27,0:17:59.06,Default,,0,0,0,,Сонымен... бірақ жарайды!
Dialogue: 0,0:17:59.81,0:18:00.90,Default,,0,0,0,,１…
Dialogue: 0,0:18:01.02,0:18:02.40,Default,,0,0,0,,Мм... түсіндім.
Dialogue: 0,0:18:02.73,0:18:04.49,Default,,0,0,0,,２…
Dialogue: 0,0:18:05.82,0:18:07.78,Default,,0,0,0,,３…
Dialogue: 0,0:18:17.92,0:18:22.67,Default,,0,0,0,,Сенің көк жүзің бар... айтшы, Шираюки.
Dialogue: 0,0:18:29.47,0:18:31.01,Default,,0,0,0,,Ұстаз, мен таптым.
Dialogue: 0,0:18:34.06,0:18:35.93,Default,,0,0,0,,Вахаха...!
Dialogue: 0,0:18:36.98,0:18:39.56,Default,,0,0,0,,Камин ағашымен жұмыс істеу үшін мұндай нәрсені күтпедім.
Dialogue: 0,0:18:39.69,0:18:41.61,Default,,0,0,0,,Егер сіз қаруыңызды уақыты келгенде сатсаңыз...
Dialogue: 0,0:18:41.73,0:18:43.27,Default,,0,0,0,,Бұл өте көп ақша.
Dialogue: 0,0:18:43.40,0:18:44.53,Default,,0,0,0,,Балалар сендерсіңдер ме?
Dialogue: 0,0:18:45.28,0:18:47.32,Default,,0,0,0,,Бекіністе адамға көмектескен сол
Dialogue: 0,0:18:47.45,0:18:48.40,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:49.07,0:18:51.24,Default,,0,0,0,,Ол король сарайынан келген корпустан.
Dialogue: 0,0:18:51.37,0:18:54.37,Default,,0,0,0,,Біреудің затын рұқсатсыз алып кетсе, мазаламаңыз.
Dialogue: 0,0:18:54.91,0:18:55.75,Default,,0,0,0,,Хахаха
Dialogue: 0,0:18:55.87,0:18:58.66,Default,,0,0,0,,Бұл аз ғана сарбаздар.
Dialogue: 0,0:19:00.08,0:19:02.88,Default,,0,0,0,,Бір әйел бар. Оның жақсы кәдесыйы болуы керек.
Dialogue: 0,0:19:03.00,0:19:05.92,Default,,0,0,0,,Аузыңды жап, мен саған бұл жерде ешкімге тіл тигізуге жол бермеймін.
Dialogue: 0,0:19:06.42,0:19:08.34,Default,,0,0,0,,Не, сен дос болып көрінесің бе?
Dialogue: 0,0:19:08.47,0:19:10.59,Default,,0,0,0,,Мен оны соншалықты арзан болайын деп отырған жоқпын.
Dialogue: 0,0:19:11.09,0:19:13.89,Default,,0,0,0,,Мен бұл елде тұратын адамдарды білемін...
Dialogue: 0,0:19:14.01,0:19:15.81,Default,,0,0,0,,Менің ойымша, бұл ел маған ұнайды.
Dialogue: 0,0:19:16.43,0:19:18.68,Default,,0,0,0,,Мицухиде мен ағаштар бір-біріне жақын...
Dialogue: 0,0:19:18.85,0:19:20.90,Default,,0,0,0,,Өз ұстанымыңызды жоғалтпаңыз -
Dialogue: 0,0:19:21.10,0:19:22.56,Default,,0,0,0,,Алдыны көре алады
Dialogue: 0,0:19:23.52,0:19:25.98,Default,,0,0,0,,Өйткені бетпе-бет болғысы келетіндер бар...
Dialogue: 0,0:19:26.53,0:19:27.19,Default,,0,0,0,,Бұған -
Dialogue: 0,0:19:27.32,0:19:29.95,Default,,0,0,0,,Мен өзімнен бас тартатын адамға айналамын деп ойламаймын.
Dialogue: 0,0:19:30.15,0:19:31.70,Default,,0,0,0,,Сіз не айтып тұрсыз?
Dialogue: 0,0:19:33.03,0:19:36.12,Default,,0,0,0,,Уайымдамаңыздар, бұл сендерге арналмаған.
Dialogue: 0,0:19:36.29,0:19:37.75,Default,,0,0,0,,Алғыс сөздер
Dialogue: 0,0:19:37.91,0:19:38.83,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:43.50,0:19:44.17,Default,,0,0,0,,Мен жай ғана жағдайды біраз бақылап тұрамын.
Dialogue: 0,0:19:44.29,0:19:45.46,Default,,0,0,0,,Кешіріңіз, мен мұқият тыңдадым.
Dialogue: 0,0:19:47.96,0:19:50.34,Default,,0,0,0,,Жаман ағаштар Мен... әсер алдым.
Dialogue: 0,0:19:50.47,0:19:51.34,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:19:51.76,0:19:54.26,Default,,0,0,0,,Бұл жақсы. Маған да соны айтқым келеді.
Dialogue: 0,0:20:01.56,0:20:02.73,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:05.48,0:20:11.24,Default,,0,0,0,,(қылыштың соқтығысқан дыбысы)
Dialogue: 0,0:20:18.45,0:20:19.50,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:20:21.41,0:20:22.54,Default,,0,0,0,,Сіз оны ояттыңыз ба?
Dialogue: 0,0:20:23.04,0:20:24.79,Default,,0,0,0,,Зен I...
Dialogue: 0,0:20:25.50,0:20:27.88,Default,,0,0,0,,Өкінішке орай, мәселені кеш байқадым
Dialogue: 0,0:20:28.30,0:20:31.01,Default,,0,0,0,,Жауапты адам ретінде маған көңіл жетпей қалды.
Dialogue: 0,0:20:31.30,0:20:32.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:32.51,0:20:35.60,Default,,0,0,0,,Бір ғана сөз...
Dialogue: 0,0:20:35.72,0:20:38.97,Default,,0,0,0,,Саған ауыр болмас үшін мен бұл туралы ойлансам болар еді.
Dialogue: 0,0:20:39.43,0:20:42.27,Default,,0,0,0,,Бұл тек сен емес, Шираюки.
Dialogue: 0,0:20:42.44,0:20:43.73,Default,,0,0,0,,Тіпті солай
Dialogue: 0,0:20:44.23,0:20:46.65,Default,,0,0,0,,Оны қайта жасырмаңыз.
Dialogue: 0,0:20:47.90,0:20:50.61,Default,,0,0,0,,Иә... Кешіріңіз, Зен.
Dialogue: 0,0:20:51.61,0:20:53.49,Default,,0,0,0,,Бір қателік жасамаңыз
Dialogue: 0,0:20:53.74,0:20:55.74,Default,,0,0,0,,Мен осылай ұйықтап қалғаным үшін...
Dialogue: 0,0:20:55.87,0:20:59.62,Default,,0,0,0,,Сіздің жұмысыңыз арқылы құтқарылуда еш жамандық жоқ.
Dialogue: 0,0:21:02.21,0:21:04.21,Default,,0,0,0,,Мен сізге дұрыс алғыс айтпадым.
Dialogue: 0,0:21:04.62,0:21:07.67,Default,,0,0,0,,Сенің келгеніңе қуаныштымын, Шираюки.
Dialogue: 0,0:21:08.50,0:21:12.05,Default,,0,0,0,,Солдаттар туралы... және мен туралы да.
Dialogue: 0,0:21:19.97,0:21:23.73,Default,,0,0,0,,Бұл жолы сен менің қозғаушы күшім болдың.
Dialogue: 0,0:21:26.65,0:21:27.86,Default,,0,0,0,,Мен үшін-
Dialogue: 0,0:21:28.23,0:21:29.90,Default,,0,0,0,,Дзен осындай.
Dialogue: 0,0:21:30.19,0:21:32.57,Default,,0,0,0,,Мен Зенді кездестіргеннен бері көп рет
Dialogue: 0,0:21:40.03,0:21:42.16,Default,,0,0,0,,Бүгіннен бастап мен әдеттегідей тапсырыс бердім.
Dialogue: 0,0:21:42.29,0:21:43.04,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:43.37,0:21:46.04,Default,,0,0,0,,Шираюки-доно, мен хат жазамын.
Dialogue: 0,0:21:46.17,0:21:47.96,Default,,0,0,0,,Иә, мен оны асыға күтемін.
Dialogue: 0,0:21:48.29,0:21:49.75,Default,,0,0,0,,Сау болыңыз!
Dialogue: 0,0:21:52.63,0:21:54.72,Default,,0,0,0,,Мен сырттан көп нәрсе алдым.
Dialogue: 0,0:21:55.47,0:21:57.51,Default,,0,0,0,,Бұл ел туралы көрген-білгенім
Dialogue: 0,0:21:58.09,0:21:59.93,Default,,0,0,0,,Бақытты кездесу
Dialogue: 0,0:22:00.64,0:22:04.35,Default,,0,0,0,,Және сол арқылы үйренетін сезімдер
Dialogue: 0,0:22:04.73,0:22:08.44,Default,,0,0,0,,Олардың көпшілігі бізге ешқашан сөнбейтін жарық береді.
Dialogue: 0,0:22:08.56,0:22:13.57,Default,,0,0,0,,♪～
Dialogue: 0,0:23:32.69,0:23:37.69,Default,,0,0,0,,～♪
Dialogue: 0,0:23:38.28,0:23:43.03,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:23:44.24,0:23:47.20,Default,,0,0,0,,Қош келдіңіз, Мәртебелі Изана
Dialogue: 0,0:23:57.46,0:23:58.92,Default,,0,0,0,,Сәлем аға...
Dialogue: 0,0:23:59.26,0:24:00.84,Default,,0,0,0,,Не… бұл жағдай?
Dialogue: 0,0:24:01.13,0:24:03.93,Default,,0,0,0,,Мен Шираюки-дононы қарсы аламын.
Dialogue: 0,0:24:04.18,0:24:05.97,Default,,0,0,0,,Мен жауап бере алмаймын
Dialogue: 0,0:24:06.14,0:24:08.35,Default,,0,0,0,,Құнсыз ханзада дайын.
Dialogue: 0,0:24:09.85,0:24:15.85,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory