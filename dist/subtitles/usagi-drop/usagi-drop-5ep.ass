Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:08.79,0:02:23.81,Default,,0,0,0,,(Риннің жылаған дауысы)
Dialogue: 0,0:02:23.81,0:02:27.81,Default,,0,0,0,,Сәлем Рин. Оян.
Dialogue: 0,0:02:32.82,0:02:35.82,Default,,0,0,0,,Мұнда кел.
Dialogue: 0,0:02:38.82,0:02:42.83,Default,,0,0,0,,Бұл арман. Уайымдама.
Dialogue: 0,0:02:42.83,0:02:46.83,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:48.83,0:02:51.84,Default,,0,0,0,,《Иә? 》
Dialogue: 0,0:02:51.84,0:03:01.84,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:08.73,0:06:13.74,Default,,0,0,0,,Ммм….
Dialogue: 0,0:06:13.74,0:06:15.74,Default,,0,0,0,,Ах.
Dialogue: 0,0:06:17.74,0:06:21.74,Default,,0,0,0,,Өтінемін. Ха.
Dialogue: 0,0:06:24.75,0:06:27.75,Default,,0,0,0,,Мұны тіпті менің атам да жасаған!
Dialogue: 0,0:06:27.75,0:06:30.75,Default,,0,0,0,,Иә? Солай ма?
Dialogue: 0,0:06:34.76,0:06:40.76,Default,,0,0,0,,Білесің бе, мен жеке пышақ алғым келеді. Жарайды, әлі сәл ерте.
Dialogue: 0,0:06:40.76,0:06:44.76,Default,,0,0,0,,Балаларға арналған кейбір заттар. Шынайы ма?
Dialogue: 0,0:06:48.77,0:06:51.77,Default,,0,0,0,,Ойлан. Эх.
Dialogue: 0,0:06:51.77,0:06:54.78,Default,,0,0,0,,Тезірек жеп ал. Жақында шығады.
Dialogue: 0,0:06:54.78,0:06:56.80,Default,,0,0,0,,Иә.
Dialogue: 0,0:06:56.80,0:07:09.73,Default,,0,0,0,,♪♪~
Dialogue: 0,0:07:09.73,0:07:12.73,Default,,0,0,0,,Сүйкімді балақай.
Dialogue: 0,0:07:12.73,0:07:15.73,Default,,0,0,0,,Иә? …Иә.
Dialogue: 0,0:07:19.74,0:07:24.74,Default,,0,0,0,,《Менің атым Кавачи, Рин Каганың әкесінің туысы.》
Dialogue: 0,0:07:24.74,0:07:29.75,Default,,0,0,0,,《Қазір Рин-сан... Мен Ринмен тұрамын》
Dialogue: 0,0:07:29.75,0:07:31.75,Default,,0,0,0,,[ТЕЛ] (Масако)《А... күрсіну》
Dialogue: 0,0:07:31.75,0:07:34.75,Default,,0,0,0,,《Сіз Масако Йошиисіз》
Dialogue: 0,0:07:34.75,0:07:37.75,Default,,0,0,0,,《Риннің анасы екеніне сенімдісің бе? 》
Dialogue: 0,0:07:37.75,0:07:43.76,Default,,0,0,0,,[ТЕЛ]《Мм... Иә? О мен? А... иә》
Dialogue: 0,0:07:43.76,0:07:46.76,Default,,0,0,0,,《Мен сізбен жеке сөйлескім келеді.》
Dialogue: 0,0:07:46.76,0:07:48.77,Default,,0,0,0,,《Сіздің тұрғылықты жеріңізге жақын жерге келеміз→
Dialogue: 0,0:07:48.77,0:07:50.77,Default,,0,0,0,,Егер сіз орынды көрсетсеңіз...》
Dialogue: 0,0:07:50.77,0:07:55.77,Default,,0,0,0,,[ТЕЛ]《О, жер? Ал, мен не істеуім керек? →
Dialogue: 0,0:07:55.77,0:07:57.71,Default,,0,0,0,,Сауда көшесінің жанында...》
Dialogue: 0,0:07:57.71,0:07:59.71,Default,,0,0,0,,《Кешіріңіз, бірақ сіз қайда тұрасыз?→
Dialogue: 0,0:07:59.71,0:08:01.71,Default,,0,0,0,,Мен мүлде білмеймін》
Dialogue: 0,0:08:12.72,0:08:16.73,Default,,0,0,0,,Уау, сондай сүйкімді!
Dialogue: 0,0:08:16.73,0:08:20.73,Default,,0,0,0,,Анам қайта жасады. Бұл гүлдер де?
Dialogue: 0,0:08:20.73,0:08:23.73,Default,,0,0,0,,Иә. Оны кесте деп атайды.
Dialogue: 0,0:08:23.73,0:08:26.74,Default,,0,0,0,,Уау, бұл керемет.
Dialogue: 0,0:08:26.74,0:08:30.74,Default,,0,0,0,,Кішкене есейгенде қалай істеу керектігін көрсетемін.
Dialogue: 0,0:08:30.74,0:08:33.74,Default,,0,0,0,,Шынымен бе? Рин-Чан: Себебі сен өте шеберсің.
Dialogue: 0,0:08:33.74,0:08:36.75,Default,,0,0,0,,Хехехе.
Dialogue: 0,0:08:36.75,0:08:38.75,Default,,0,0,0,,Сонымен, сіз не істейсіз?
Dialogue: 0,0:08:38.75,0:08:42.75,Default,,0,0,0,,Хмм, мен сенімен кездесуім керек.
Dialogue: 0,0:08:42.75,0:08:45.76,Default,,0,0,0,,Танысқаныма қуаныштымын, Джарин.
Dialogue: 0,0:08:45.76,0:08:47.76,Default,,0,0,0,,Дайкичи. Иә?
Dialogue: 0,0:08:47.76,0:08:51.76,Default,,0,0,0,,Бұл маңызды. Оны мұқият талқылаңыз.
Dialogue: 0,0:08:51.76,0:08:53.76,Default,,0,0,0,,Менің анам да асыға күтті, Рин Чан.
Dialogue: 0,0:08:53.76,0:08:55.76,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:03.71,0:09:07.71,Default,,0,0,0,,《Әйтеуір, бұл менің атама жақын.》
Dialogue: 0,0:09:07.71,0:09:10.71,Default,,0,0,0,,Қош келдіңіз. Сіз жалғызсыз ба?
Dialogue: 0,0:09:10.71,0:09:13.72,Default,,0,0,0,,Кейінірек басқа адам. Темекі шегуге болмайды.
Dialogue: 0,0:09:13.72,0:09:16.72,Default,,0,0,0,,Қараңыз! Ол төгіледі!
Dialogue: 0,0:09:16.72,0:09:19.72,Default,,0,0,0,,Мен қазірдің өзінде күйзеліске түстім. (Анашым) Ой, түсіндім, түсіндім.
Dialogue: 0,0:09:19.72,0:09:22.73,Default,,0,0,0,,Американдық өтінемін. (Даяшы) Иә, бір американдық. →
Dialogue: 0,0:09:22.73,0:09:26.73,Default,,0,0,0,,Жоғарыда айтылғандарға сенімдісіз бе? иә.
Dialogue: 0,0:09:26.73,0:09:29.73,Default,,0,0,0,,Бұл керемет, Сайонжи мырза! Күткендей. →
Dialogue: 0,0:09:29.73,0:09:33.74,Default,,0,0,0,,Енді әр кейіпкерге 2-3 жарақат беріңіз.
Dialogue: 0,0:09:33.74,0:09:35.74,Default,,0,0,0,,Ой... көп емес пе? (Редактор) Noo →
Dialogue: 0,0:09:35.74,0:09:37.74,Default,,0,0,0,,Менің ойымша, бұл тамаша.
Dialogue: 0,0:09:37.74,0:09:41.74,Default,,0,0,0,,《Қызық, қарт сонша жоғалып кетті →
Dialogue: 0,0:09:41.74,0:09:43.75,Default,,0,0,0,,Сіз әлі де осында тұрасыз ба?
Dialogue: 0,0:09:43.75,0:09:46.75,Default,,0,0,0,,Ал, профессор, көп рахмет.
Dialogue: 0,0:09:46.75,0:09:49.75,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:09:49.75,0:09:51.75,Default,,0,0,0,,《Қашып кету немқұрайлы болған болуы керек.》
Dialogue: 0,0:09:51.75,0:09:53.76,Default,,0,0,0,,Анашым сидит! (Ана) А, иә, иә. →
Dialogue: 0,0:09:53.76,0:09:55.76,Default,,0,0,0,,Тек ұстаңыз.
Dialogue: 0,0:09:55.76,0:09:59.70,Default,,0,0,0,,(Хироко) Мұндай ақымақ нәрселерге алаңдама →
Dialogue: 0,0:09:59.70,0:10:02.70,Default,,0,0,0,,Сәлеметсіз бе, енді қайсысы?
Dialogue: 0,0:10:02.70,0:10:06.70,Default,,0,0,0,,А, мен дүкеннің ішіндемін. Ха...!
Dialogue: 0,0:10:06.70,0:10:09.70,Default,,0,0,0,,Қолымыздан келмейді ғой, иә? Сен оны қалайсың ба?
Dialogue: 0,0:10:13.71,0:10:15.71,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:15.71,0:10:19.71,Default,,0,0,0,,Иә, Соичи-сан! ? Жоқ. Ол Суичидің немересі.
Dialogue: 0,0:10:27.72,0:10:29.73,Default,,0,0,0,,《Бала сияқты》
Dialogue: 0,0:10:29.73,0:10:32.73,Default,,0,0,0,,А-а-а... Кешіріңіз.
Dialogue: 0,0:10:32.73,0:10:35.73,Default,,0,0,0,,Олар өте ұқсас болды... А, жоқ...
Dialogue: 0,0:10:35.73,0:10:37.73,Default,,0,0,0,,Бұл туралы маған жақында ғана айтты.
Dialogue: 0,0:10:37.73,0:10:40.74,Default,,0,0,0,,Ах... бірақ күткендей →
Dialogue: 0,0:10:40.74,0:10:44.74,Default,,0,0,0,,Суичи-сан мейірімдірек сияқты... Иә.
Dialogue: 0,0:10:47.74,0:10:51.75,Default,,0,0,0,,Мен Риннің суретін әкелдім. А, сәлем.
Dialogue: 0,0:10:51.75,0:10:55.75,Default,,0,0,0,,Бұл биыл болған оқиға. Балабақшадағы мочи қағу жарысында.
Dialogue: 0,0:10:57.69,0:11:03.69,Default,,0,0,0,,Аа, сен үлкен апаға қатты ұқсайсың.
Dialogue: 0,0:11:11.70,0:11:14.70,Default,,0,0,0,,Мені ертерек Сенсей деп атағаныңызды естідім.
Dialogue: 0,0:11:14.70,0:11:17.71,Default,,0,0,0,,Көрдіңіз бе...? Бірақ аты...
Dialogue: 0,0:11:17.71,0:11:21.71,Default,,0,0,0,,Жұмыс мақсаттары үшін. Кешіріңіз, кеше бейберекет жағдайға тап болдым →
Dialogue: 0,0:11:21.71,0:11:24.71,Default,,0,0,0,,Мен аң-таң болдым. иә?
Dialogue: 0,0:11:28.72,0:11:32.72,Default,,0,0,0,,Ринді босатудың себебі сол жұмыс болды ма?
Dialogue: 0,0:11:32.72,0:11:34.72,Default,,0,0,0,,А-а...
Dialogue: 0,0:11:34.72,0:11:37.73,Default,,0,0,0,,Ол Ринге өзін көмекші → деп ойлаған сияқты
Dialogue: 0,0:11:37.73,0:11:40.73,Default,,0,0,0,,Сәби кезіңізден болды ма?
Dialogue: 0,0:11:40.73,0:11:44.73,Default,,0,0,0,,Жұмыс себеп. Бірақ Суичидің →
Dialogue: 0,0:11:44.73,0:11:47.74,Default,,0,0,0,,Оның қызметші болғаны рас.
Dialogue: 0,0:11:47.74,0:11:50.74,Default,,0,0,0,,Мен Ринді қызым деп ойламауды шештім →
Dialogue: 0,0:11:50.74,0:11:52.74,Default,,0,0,0,,Жүктілік кезінде...
Dialogue: 0,0:11:52.74,0:11:54.74,Default,,0,0,0,,Мен... Кешіріңіз. Не дейсіз...
Dialogue: 0,0:11:54.74,0:11:57.68,Default,,0,0,0,,Көптен бері сата алмай жүрмін. тістері?
Dialogue: 0,0:11:57.68,0:12:02.69,Default,,0,0,0,,Мен үлкен жұмысқа тұрғанда жүкті екенімді білдім.
Dialogue: 0,0:12:02.69,0:12:04.69,Default,,0,0,0,,Бала тәрбиесімен айналыса алмайтын нәрсе →
Dialogue: 0,0:12:04.69,0:12:07.69,Default,,0,0,0,,Бірақ Суичи босануды ұсынады→
Dialogue: 0,0:12:07.69,0:12:10.69,Default,,0,0,0,,Күн сайын мен не жұмыс істеймін, не ұйықтаймын→
Dialogue: 0,0:12:10.69,0:12:12.70,Default,,0,0,0,,Букубуку Мен салмақ қосып жатырмын.
Dialogue: 0,0:12:12.70,0:12:17.70,Default,,0,0,0,,Дегенмен, Рин туылғанда, ол біртүрлі сүйкімді →
Dialogue: 0,0:12:17.70,0:12:19.70,Default,,0,0,0,,Мен бұл өте ерекше деп ойладым.
Dialogue: 0,0:12:19.70,0:12:21.70,Default,,0,0,0,,《Бұл біртүрлі.》
Dialogue: 0,0:12:21.70,0:12:26.71,Default,,0,0,0,,Сондықтан мен өзімді ана емеспін деп айтсам да→
Dialogue: 0,0:12:26.71,0:12:29.71,Default,,0,0,0,,Жұмыс істеп, бала тәрбиелеуге бар күшімді салдым.
Dialogue: 0,0:12:29.71,0:12:33.72,Default,,0,0,0,,Бірақ өмірімді күндізгіге өзгерту қиын →
Dialogue: 0,0:12:33.72,0:12:35.72,Default,,0,0,0,,Кейде түнде жиналысқа шығамын→
Dialogue: 0,0:12:35.72,0:12:39.72,Default,,0,0,0,,Өйткені, ол болмағанда физикалық мүмкін емес еді.
Dialogue: 0,0:12:45.73,0:12:49.97,Default,,0,0,0,,Мм... Рин сенімен пәтерде түнеді деп естідім.
Dialogue: 0,0:12:49.97,0:12:51.73,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:12:51.73,0:12:53.74,Default,,0,0,0,,Сіз түнде далаға шықтыңыз ба?
Dialogue: 0,0:12:53.74,0:12:56.76,Default,,0,0,0,,Аа, әлі түн ортасы.
Dialogue: 0,0:12:56.76,0:12:58.67,Default,,0,0,0,,Сәлден соң Рин ұйықтап қалды.
Dialogue: 0,0:12:58.67,0:13:02.68,Default,,0,0,0,,Сойчи-сан қарап қалатын кездері болды.
Dialogue: 0,0:13:02.68,0:13:06.68,Default,,0,0,0,,Рин әлі түнде жиі оянады.
Dialogue: 0,0:13:06.68,0:13:08.68,Default,,0,0,0,,Мұндай жағдайда қасыңызда ешкім болмаса →
Dialogue: 0,0:13:08.68,0:13:11.69,Default,,0,0,0,,Оның не ойлайтынын ойламадыңыз ба?
Dialogue: 0,0:13:11.69,0:13:15.69,Default,,0,0,0,,Бірақ...сонда баланы өз бетімен қалай тәрбиелейсің?
Dialogue: 0,0:13:15.69,0:13:17.69,Default,,0,0,0,,Сондықтан да қария үшеуі бір отбасы болады деп шешті→
Dialogue: 0,0:13:17.69,0:13:19.69,Default,,0,0,0,,Сіз оны ұсындыңыз ба?
Dialogue: 0,0:13:21.70,0:13:24.70,Default,,0,0,0,,Егер мен Ринмен осылай өмір сүре берсем →
Dialogue: 0,0:13:24.70,0:13:27.70,Default,,0,0,0,,Сіз үшін проблема жоқ па?
Dialogue: 0,0:13:27.70,0:13:30.71,Default,,0,0,0,,…Иә.
Dialogue: 0,0:13:30.71,0:13:32.71,Default,,0,0,0,,Өйткені мен енді ана емеспін→
Dialogue: 0,0:13:32.71,0:13:35.71,Default,,0,0,0,,Менің Ринмен ештеңе істеуге құқығым жоқ.
Dialogue: 0,0:13:35.71,0:13:39.72,Default,,0,0,0,,Рин сіздің ішіңізде болғанына сенімдісіз бе?
Dialogue: 0,0:13:39.72,0:13:42.72,Default,,0,0,0,,Ал... бұл басқа мәселе!
Dialogue: 0,0:13:42.72,0:13:45.72,Default,,0,0,0,,Рин туралы не ойлайсың?
Dialogue: 0,0:13:45.72,0:13:49.73,Default,,0,0,0,,Маңызды ма, жоқ па?
Dialogue: 0,0:13:49.73,0:13:52.73,Default,,0,0,0,,Мен... білмеймін.
Dialogue: 0,0:13:52.73,0:13:54.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:07.68,0:14:10.35,Default,,0,0,0,,Мм... бір ғана өтініш.
Dialogue: 0,0:14:10.35,0:14:12.01,Default,,0,0,0,,(Танжиро) Толық шоғырланған тыныс алуды сақтай отырып жаттығу енді екінші табиғатқа айнала бастады.
Dialogue: 0,0:14:12.01,0:14:13.68,Default,,0,0,0,,Сол бала мектепке барғанда→
Dialogue: 0,0:14:13.68,0:14:16.69,Default,,0,0,0,,Сіз сияқты фамилияны қолдануға рұқсат етіңіз.
Dialogue: 0,0:14:16.69,0:14:18.69,Default,,0,0,0,,Иә? Фамилия?
Dialogue: 0,0:14:18.69,0:14:21.69,Default,,0,0,0,,Егер сіздің фамилияңыз ата-анаңыздан бөлек болса, сіз оған ренжіген боларсыз.
Dialogue: 0,0:14:21.69,0:14:24.69,Default,,0,0,0,,Маған сонша уәде бере аласыз ба?
Dialogue: 0,0:14:24.69,0:14:28.70,Default,,0,0,0,,Хм... Мен мұны түсінбеймін →
Dialogue: 0,0:14:28.70,0:14:30.70,Default,,0,0,0,,Бірақ мен ешқандай уәде бере алмаймын.
Dialogue: 0,0:14:30.70,0:14:34.70,Default,,0,0,0,,Менің атым әрқашан Рин Кага болды→
Dialogue: 0,0:14:34.70,0:14:36.71,Default,,0,0,0,,Менің ойымша, бұл оңай емес...
Dialogue: 0,0:14:36.71,0:14:41.71,Default,,0,0,0,,Мен әйел болғандықтан, менің фамилияма ешқандай қосымша немесе қосымша жоқ.
Dialogue: 0,0:14:41.71,0:14:45.72,Default,,0,0,0,,Ол бәрібір бір күні өзгеруі мүмкін. →
Dialogue: 0,0:14:45.72,0:14:49.72,Default,,0,0,0,,Рин де әйел, сондықтан оның да солай сезінетініне сенімдімін.
Dialogue: 0,0:14:49.72,0:14:52.72,Default,,0,0,0,,Жоқ...бірақ Рин небәрі 6 жаста.
Dialogue: 0,0:14:52.72,0:14:54.72,Default,,0,0,0,,Менің айтып тұрғаным бұл емес →
Dialogue: 0,0:14:54.72,0:14:57.66,Default,,0,0,0,,Жалпы айтқанда, бұл сіздің жеке пікіріңіз...
Dialogue: 0,0:14:57.66,0:14:59.66,Default,,0,0,0,,Бір ғана нәрсе маңызды!
Dialogue: 0,0:14:59.66,0:15:01.73,Default,,0,0,0,,Маған Суичи берген Рин есімі →
Dialogue: 0,0:15:01.73,0:15:05.67,Default,,0,0,0,,Міне. Кешіріңіз!
Dialogue: 0,0:15:05.67,0:15:08.67,Default,,0,0,0,,Мм... Мен еркекпін, сондықтан сенің айтып тұрғаның →
Dialogue: 0,0:15:08.67,0:15:10.67,Default,,0,0,0,,Мен шынымен түсінбеймін.
Dialogue: 0,0:15:10.67,0:15:13.68,Default,,0,0,0,,Бірақ сіз Ринмен сөйлесе аласыз.
Dialogue: 0,0:15:13.68,0:15:17.68,Default,,0,0,0,,Бұл туралы айта отырып... Мен мұндай кішкентай балаға шешім қабылдауға рұқсат бергеніме сене алар емеспін →
Dialogue: 0,0:15:17.68,0:15:19.68,Default,,0,0,0,,Бұл қатыгездік деп ойламайсың ба? Мен!
Dialogue: 0,0:15:21.68,0:15:24.69,Default,,0,0,0,,Мен Рин үшін ең жақсысын ойлаймын.
Dialogue: 0,0:15:24.69,0:15:27.69,Default,,0,0,0,,Жалпы, өз бетінше шешім қабылдау қатыгезірек.
Dialogue: 0,0:15:27.69,0:15:30.69,Default,,0,0,0,,Алдымен Риннің сезімін мұқият тыңдаңыз→
Dialogue: 0,0:15:30.69,0:15:34.70,Default,,0,0,0,,Осыдан кейін біз бірге шешеміз және нәтижені кейінірек хабарлаймыз.
Dialogue: 0,0:15:34.70,0:15:45.70,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:34.78,0:17:36.79,Default,,0,0,0,,Бұл керексіз адам шығар. Сөзсіз!
Dialogue: 0,0:17:36.79,0:17:39.79,Default,,0,0,0,,Кішкентай сүйкімді баланы тастап кету ақылсыз!
Dialogue: 0,0:17:39.79,0:17:43.79,Default,,0,0,0,,А, бірақ мен Ринді уайымдай алдым.
Dialogue: 0,0:17:43.79,0:17:45.79,Default,,0,0,0,,Бұл сәл басқаша →
Dialogue: 0,0:17:45.79,0:17:48.80,Default,,0,0,0,,Мен басқаларды тартатынымды білмеймін деп ойлаймын...
Dialogue: 0,0:17:48.80,0:17:52.80,Default,,0,0,0,,Не айтып тұрсың! Ананың қызының қамын ойлауы заңдылық!
Dialogue: 0,0:17:52.80,0:17:54.80,Default,,0,0,0,,Егер сіз шынымен уайымдасаңыз, менімен кездескіңіз келетініне сенімдімін!
Dialogue: 0,0:17:54.80,0:17:59.81,Default,,0,0,0,,Бәлкім, бұл жерде бірдеңе дұрыс емес шығар, сондықтан...
Dialogue: 0,0:17:59.81,0:18:02.81,Default,,0,0,0,,Ата, сондай адамның қандай жақсылығы болды екен...
Dialogue: 0,0:18:02.81,0:18:06.82,Default,,0,0,0,,Бұл қазір маңызды емес.
Dialogue: 0,0:18:06.82,0:18:09.82,Default,,0,0,0,,Тадаса Рин бастауыш мектепке барғанда→
Dialogue: 0,0:18:09.82,0:18:11.82,Default,,0,0,0,,Ол менің фамилиямды айтуымды өтінді.
Dialogue: 0,0:18:11.82,0:18:15.82,Default,,0,0,0,,Әй, анам мұнымен келіседі. (Кендзи/Даикичи) Иә! ?
Dialogue: 0,0:18:15.82,0:18:19.83,Default,,0,0,0,,Балалардың тегі ата-анасымен бірдей болуы керек.
Dialogue: 0,0:18:19.83,0:18:22.83,Default,,0,0,0,,Мен мұны түсіндім, бірақ→
Dialogue: 0,0:18:22.83,0:18:24.83,Default,,0,0,0,,Мұны Ринге қалай түсіндіруім керек?
Dialogue: 0,0:18:24.83,0:18:26.84,Default,,0,0,0,,Оның шын аты болса да...
Dialogue: 0,0:18:26.84,0:18:29.84,Default,,0,0,0,,Әй, ол қыз ғой, мен оған бәрібір үйленемін→
Dialogue: 0,0:18:29.84,0:18:31.84,Default,,0,0,0,,Фамилиялар өзгереді.
Dialogue: 0,0:18:31.84,0:18:33.78,Default,,0,0,0,,Тағы да!
Dialogue: 0,0:18:33.78,0:18:37.78,Default,,0,0,0,,Не? Менің атым туралы бірдеңе айтса мен ренжігенім дұрыс →
Dialogue: 0,0:18:37.78,0:18:40.78,Default,,0,0,0,,Менің фамилиямды мектепте қолдануға болады.
Dialogue: 0,0:18:40.78,0:18:43.79,Default,,0,0,0,,Иә. Сіз оны осындай ептілікпен пайдалана алмайсыз ба?
Dialogue: 0,0:18:43.79,0:18:50.79,Default,,0,0,0,,Бастауыш сынып оқушысы болған кезде көп нәрсе болады. Мен сенімдімін... бұл солай.
Dialogue: 0,0:18:53.80,0:18:57.80,Default,,0,0,0,,Олай болса мен Ринді асырап аламын. (Сачико/Кенджи) Не...!
Dialogue: 0,0:18:57.80,0:19:00.80,Default,,0,0,0,,Егер ол сізге ұнамаса... Бұл нағыз Рин Кавачи.
Dialogue: 0,0:19:00.80,0:19:02.81,Default,,0,0,0,,Иә, бұл табиғирақ.
Dialogue: 0,0:19:02.81,0:19:06.81,Default,,0,0,0,,Сен, онша маңызды нәрсе туралы айтпа!
Dialogue: 0,0:19:06.81,0:19:09.81,Default,,0,0,0,,Жеңіл қабылдамаңыз! Мен бәрібір шешуім керек деп ойлаймын.
Dialogue: 0,0:19:09.81,0:19:12.82,Default,,0,0,0,,Қашан шешім қабылдасаң да, мен сенімен бірге боламын! Ал, жақсы… жақсы….
Dialogue: 0,0:19:12.82,0:19:15.82,Default,,0,0,0,,Біз бірге емеспіз! бірге. Сөзсіз бірге!
Dialogue: 0,0:19:15.82,0:19:19.82,Default,,0,0,0,,Маған таяқшаны енді ешкімге берудің қажеті жоқ.
Dialogue: 0,0:19:19.82,0:19:23.82,Default,,0,0,0,,Бұл Ринге ешқашан жасамау керек нәрсе.
Dialogue: 0,0:19:25.83,0:19:28.83,Default,,0,0,0,,Мен туралы болса, Рин, мен ашуланамын.
Dialogue: 0,0:19:31.83,0:19:33.77,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:19:33.77,0:19:36.77,Default,,0,0,0,,Бұл менікі ме? Иә. Риндікі.
Dialogue: 0,0:19:36.77,0:19:40.78,Default,,0,0,0,,Дегенмен, сіз оны мен қасыңызда болғанда ғана пайдалана аласыз!
Dialogue: 0,0:19:40.78,0:19:45.78,Default,,0,0,0,,Уәдеңде тұра алсаң, оны пайдалануға болады. иә!
Dialogue: 0,0:19:47.78,0:19:51.79,Default,,0,0,0,,Білесің бе, мен саған карри дайындаймын! Шынайы ма?
Dialogue: 0,0:19:51.79,0:19:55.79,Default,,0,0,0,,Бүгін! Эх! ? Ертең жасайық.
Dialogue: 0,0:20:01.86,0:20:05.80,Default,,0,0,0,,Иә? Сіз итеріп жатырсыз ба, әлде тартасыз ба?
Dialogue: 0,0:20:05.80,0:20:08.80,Default,,0,0,0,,Иә? Маған қарызға берші...
Dialogue: 0,0:20:10.81,0:20:12.81,Default,,0,0,0,,Міне, кеттік.
Dialogue: 0,0:20:12.81,0:20:17.81,Default,,0,0,0,,Дайкичи: Сен жақсысың. Ей... Мен де көптен бері жалғыз тұрдым.
Dialogue: 0,0:20:17.81,0:20:21.81,Default,,0,0,0,,Әй, көріңіз. Оны баяу қабылдаған дұрыс.
Dialogue: 0,0:20:32.85,0:20:35.85,Default,,0,0,0,,Ыстық су ішпеңіз. Иә.
Dialogue: 0,0:20:42.77,0:20:45.77,Default,,0,0,0,,Иығыңызға дейін сулаңыз 10. Иә.
Dialogue: 0,0:20:45.77,0:20:50.78,Default,,0,0,0,,1 2 Санма Шиитаке... 1… 2….
Dialogue: 0,0:20:50.78,0:20:54.78,Default,,0,0,0,,Опа 6 қолтырауын 7 8 9! 3… 4… 5….
Dialogue: 0,0:20:54.78,0:20:56.78,Default,,0,0,0,,6…. Дайкичи кешікті!
Dialogue: 0,0:20:58.79,0:21:01.76,Default,,0,0,0,,Уууу.
Dialogue: 0,0:21:01.76,0:21:05.79,Default,,0,0,0,,Асықпай тамақ ішпе. Иә.
Dialogue: 0,0:21:05.79,0:21:07.80,Default,,0,0,0,,Сәлем, Рин. не?
Dialogue: 0,0:21:07.80,0:21:09.80,Default,,0,0,0,,Жоқ….
Dialogue: 0,0:21:12.80,0:21:14.80,Default,,0,0,0,,Риннің карриі дәмді! Хехе.
Dialogue: 0,0:21:28.82,0:21:34.76,Default,,0,0,0,,Мен соншалықты көп істеуім керек пе? О, жоқ... жақсы.
Dialogue: 0,0:21:34.76,0:21:39.76,Default,,0,0,0,,Мен сенің әкең емеспін...
Dialogue: 0,0:21:39.76,0:21:41.76,Default,,0,0,0,,Иә.
Dialogue: 0,0:21:41.76,0:21:43.77,Default,,0,0,0,,Ол сенің ағаң да емес пе?
Dialogue: 0,0:21:43.77,0:21:46.77,Default,,0,0,0,,Ахаха! Ешкім олай ойламайды.
Dialogue: 0,0:21:46.77,0:21:50.77,Default,,0,0,0,,Мысалы! Сонымен, бұл нақты не?
Dialogue: 0,0:21:50.77,0:21:52.77,Default,,0,0,0,,Үлкен сәттілік.
Dialogue: 0,0:21:52.77,0:21:54.78,Default,,0,0,0,,Бұл атау.
Dialogue: 0,0:21:54.78,0:21:57.78,Default,,0,0,0,,Тыңдау. Егер Рин мұны жек көрмесе →
Dialogue: 0,0:21:57.78,0:22:04.79,Default,,0,0,0,,Басқаша айтқанда, кейбір нәрселер... Мен Ринмін...
Dialogue: 0,0:22:04.79,0:22:09.79,Default,,0,0,0,,Риннің нағыз әкесі болу қандай болар еді?
Dialogue: 0,0:22:09.79,0:22:12.79,Default,,0,0,0,,Дайкичи... Әке.
Dialogue: 0,0:22:12.79,0:22:18.80,Default,,0,0,0,,Осылайша сіздің атыңыз Рин Кавачи болады.
Dialogue: 0,0:22:18.80,0:22:21.80,Default,,0,0,0,,Рин Кавачи….
Dialogue: 0,0:22:23.81,0:22:26.81,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:22:26.81,0:22:30.81,Default,,0,0,0,,Әй, жоқ... Әкең осында болса жақсы емес пе?
Dialogue: 0,0:22:30.81,0:22:35.75,Default,,0,0,0,,Менің әкем – менің атам. Маған Рин Кага есімі ұнайды.
Dialogue: 0,0:22:35.75,0:22:38.75,Default,,0,0,0,,Атаның атының бірдей болуы маңызды.
Dialogue: 0,0:22:40.76,0:22:43.76,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:22:43.76,0:22:45.76,Default,,0,0,0,,Дайкичи - сәттілік.
Dialogue: 0,0:22:48.76,0:22:50.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:50.77,0:22:54.77,Default,,0,0,0,,Сәттілік пе? не болды? Сіз жылап жатырсыз ба?
Dialogue: 0,0:22:54.77,0:22:56.77,Default,,0,0,0,,Бұл тер!
Dialogue: 0,0:22:56.77,0:23:00.78,Default,,0,0,0,,Наурыз ғана болса да... Шулы! Тек аузыңды аш!
Dialogue: 0,0:23:00.78,0:23:02.78,Default,,0,0,0,,Өйткені ол ашық болса да, Дайкичи жылап жіберді!
Dialogue: 0,0:23:02.78,0:23:04.78,Default,,0,0,0,,Жылама!
Dialogue: 0,0:23:06.78,0:23:09.79,Default,,0,0,0,,Тағы біраз. махаббат.
Dialogue: 0,0:23:09.79,0:23:12.79,Default,,0,0,0,,Бұдан былай да→
Dialogue: 0,0:23:12.79,0:23:15.79,Default,,0,0,0,,Бұл сенің үйің.
Dialogue: 0,0:23:15.79,0:23:17.79,Default,,0,0,0,,Иә.
Dialogue: 0,0:23:19.80,0:23:22.80,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:22.80,0:23:30.81,Default,,0,0,0,,♪♪"Зейін қоюды ұмытпаңыз"→
Dialogue: 0,0:23:30.81,0:23:39.75,Default,,0,0,0,,♪♪ «Таң міндетті түрде келеді»→
Dialogue: 0,0:23:39.75,0:23:48.76,Default,,0,0,0,,♪♪ «Біз арманымызды жоғалтпауымыз керек» →
Dialogue: 0,0:23:48.76,0:23:55.76,Default,,0,0,0,,♪♪ «Бір күні орындалатынына сенімдімін» →
Dialogue: 0,0:23:55.76,0:24:04.77,Default,,0,0,0,,♪♪ «Бірінші күн, ертеңгі күн» →
Dialogue: 0,0:24:04.77,0:24:12.78,Default,,0,0,0,,♪♪ «Бүгіннен бастап бәрі жаңа» →
Dialogue: 0,0:24:12.78,0:24:21.79,Default,,0,0,0,,♪♪ «Бірінші күн, ертеңгі күн» →
Dialogue: 0,0:24:21.79,0:24:31.80,Default,,0,0,0,,♪♪ «Үлкен қуанышпен жүруді бастайық».
Dialogue: 0,0:24:31.80,0:24:56.75,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:59.76,0:25:06.76,Default,,0,0,0,,《Сейрек шапалақ》
Dialogue: 0,0:25:12.77,0:25:14.77,Default,,0,0,0,,Абыройлы музыка мектептерінде бәрі бәсекелестік рейтингтерге және→
Dialogue: 0,0:25:25.79,0:25:27.79,Default,,0,0,0,,Сіз салмақ қосуға жақынсыз.
Dialogue: 0,0:25:27.79,0:25:32.81,Default,,0,0,0,,Жақсы, мен бәрібір пайдасыз адаммын.
Dialogue: 0,0:25:32.81,0:25:35.73,Default,,0,0,0,,Маған біреуін беріңіз. (Масако) Жоқ.
Dialogue: 0,0:25:35.73,0:25:45.73,Default,,0,0,0,,♪♪~
Dialogue: 0,0:27:10.76,0:27:12.76,Default,,0,0,0,,Ах.
Dialogue: 0,0:27:14.76,0:27:17.77,Default,,0,0,0,,Хмм... Иә?
Dialogue: 0,0:27:17.77,0:27:19.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:27:19.77,0:27:22.77,Default,,0,0,0,,Саяка-чан да баланы тек ұстау керек деді.
Dialogue: 0,0:27:22.77,0:27:25.77,Default,,0,0,0,,Иә? Ешқандай себеп жоқ. Тіпті ересектер де →
Dialogue: 0,0:27:25.77,0:27:28.78,Default,,0,0,0,,Тек мені ұстағым келгенде.
Dialogue: 0,0:27:28.78,0:27:32.78,Default,,0,0,0,,Иә? Сіз ересек болсаңыз да, неге? Енді мен де білмеймін.
Dialogue: 0,0:27:32.78,0:27:37.79,Default,,0,0,0,,Бірінші курс студенті болғаны дұрыс па? Бұл жақсы.
Dialogue: 0,0:27:37.79,0:27:39.79,Default,,0,0,0,,Хэхе!
Dialogue: 0,0:27:41.79,0:27:45.79,Default,,0,0,0,,Мен сені қалағанша ұстаймын.
Dialogue: 0,0:27:48.80,0:27:50.80,Default,,0,0,0,,Ах! Бұл не? ?
Dialogue: 0,0:27:50.80,0:27:54.80,Default,,0,0,0,,Кешіріңіз. Мен сені соңғы рет ұстауым керек еді.
Dialogue: 0,0:27:54.80,0:27:56.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:56.81,0:28:02.81,Default,,0,0,0,,Келесі жолы Дайкичи жыласа, мен оны ұстаймын.
Dialogue: 0,0:28:02.81,0:28:05.81,Default,,0,0,0,,《Барлығы...》
Dialogue: 0,0:28:05.81,0:28:08.82,Default,,0,0,0,,Уайымдамаңыз.
Dialogue: 0,0:28:08.82,0:28:12.82,Default,,0,0,0,,《Мен Ринді тәрбиелеп жатырмын ба? Мені Рин тәрбиелеп жатыр ма?》
Dialogue: 0,0:28:12.82,0:28:14.82,Default,,0,0,0,,《Мен кейде түсінбеймін.》
