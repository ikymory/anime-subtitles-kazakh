Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:23.76,0:02:25.76,Default,,0,0,0,,Ха...
Dialogue: 0,0:02:31.76,0:02:34.76,Default,,0,0,0,,《Не? Қазіргісі》
Dialogue: 0,0:02:38.77,0:02:43.78,Default,,0,0,0,,[ТЕЛ]
Dialogue: 0,0:02:43.78,0:02:49.78,Default,,0,0,0,,Иә? Жарайды, мен оянамын.
Dialogue: 0,0:02:49.78,0:02:54.79,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:02:54.79,0:02:56.79,Default,,0,0,0,,Бұл туралы алаңдамаңыз.
Dialogue: 0,0:02:56.79,0:03:02.73,Default,,0,0,0,,Аптаның басында қарсы тараппен сөйлесейік. Не?
Dialogue: 0,0:03:02.73,0:03:04.73,Default,,0,0,0,,Сонда кездескенше.
Dialogue: 0,0:03:04.73,0:03:06.73,Default,,0,0,0,,[TEL] (кесу дыбысы)
Dialogue: 0,0:03:08.74,0:03:14.74,Default,,0,0,0,,《Менің атам кеше түнде қайтыс болды》
Dialogue: 0,0:03:14.74,0:03:20.74,Default,,0,0,0,,《Бұрын көрген түс... Атам мен шешем туралы ма? 》
Dialogue: 0,0:03:27.75,0:03:31.76,Default,,0,0,0,,《Туыстарынан алыстап кеткен сияқты》
Dialogue: 0,0:03:31.76,0:03:51.78,Default,,0,0,0,,♪♪~
Dialogue: 0,0:03:51.78,0:03:57.78,Default,,0,0,0,,《Аа, мен жерлеуге келгеніме біраз болды...》
Dialogue: 0,0:03:57.78,0:04:18.74,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:18.74,0:04:20.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:22.74,0:04:24.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:34.75,0:04:44.75,Default,,0,0,0,,♪♪~
Dialogue: 0,0:07:42.74,0:07:44.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:46.75,0:07:48.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:01.76,0:08:03.76,Default,,0,0,0,,Мен осындамын.
Dialogue: 0,0:08:03.76,0:08:06.77,Default,,0,0,0,,Иә? Дайкичи, сен тез едің. →
Dialogue: 0,0:08:06.77,0:08:08.77,Default,,0,0,0,,Жүк атаның жатын бөлмесінде.
Dialogue: 0,0:08:08.77,0:08:12.77,Default,,0,0,0,,Иә. Бақшада бір қыз болды →
Dialogue: 0,0:08:12.77,0:08:16.78,Default,,0,0,0,,Харуко-чино сондай болды ма?
Dialogue: 0,0:08:16.78,0:08:19.78,Default,,0,0,0,,Бұл Рейна Чан емес.
Dialogue: 0,0:08:19.78,0:08:22.78,Default,,0,0,0,,Сіз қай баласыз? ≪(Тақталар үйіндісінің құлаған дыбысы)
Dialogue: 0,0:08:22.78,0:08:26.78,Default,,0,0,0,,Бұл қазірдің өзінде... бұл асүйді пайдалану қиын.
Dialogue: 0,0:08:31.79,0:08:35.80,Default,,0,0,0,,Иә. Енді не істеуім керек деп ойлаймын.
Dialogue: 0,0:08:35.80,0:08:38.80,Default,,0,0,0,,79-ға жетсең, өлмес пе едің?
Dialogue: 0,0:08:38.80,0:08:42.74,Default,,0,0,0,,Ол бала атаның жасырған баласындай.
Dialogue: 0,0:08:42.74,0:08:46.74,Default,,0,0,0,,Ха! ? Қарттың баласы! ?
Dialogue: 0,0:08:46.74,0:08:50.74,Default,,0,0,0,,Ата, маған ештеңе айтпайсыз. →
Dialogue: 0,0:08:50.74,0:08:53.75,Default,,0,0,0,,Менің ханым да кетті.
Dialogue: 0,0:08:53.75,0:08:56.75,Default,,0,0,0,,Ханшайым...79, солай ма?
Dialogue: 0,0:08:56.75,0:09:00.75,Default,,0,0,0,,Бұл ұят және аянышты.
Dialogue: 0,0:09:00.75,0:09:03.76,Default,,0,0,0,,Олай болса болды. Анамның әпкесі ме?
Dialogue: 0,0:09:03.76,0:09:06.76,Default,,0,0,0,,Ал менің тәтем. Хехе….
Dialogue: 0,0:09:06.76,0:09:10.76,Default,,0,0,0,,Қазірдің өзінде! Сен мені не деп әзілдейсің? Мен 30-ға толдым →
Dialogue: 0,0:09:10.76,0:09:13.77,Default,,0,0,0,,Өтінемін, мұндай сезімсіз сөздер айтпаңыз!
Dialogue: 0,0:09:13.77,0:09:38.79,Default,,0,0,0,,♪♪~
Dialogue: 0,0:09:38.79,0:09:42.79,Default,,0,0,0,,Бұл үлкен өлім емес пе? Қарт адам.
Dialogue: 0,0:09:48.73,0:09:50.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:01.75,0:10:04.75,Default,,0,0,0,,Қанша орау керек...
Dialogue: 0,0:10:04.75,0:10:08.75,Default,,0,0,0,,Бұл сенің тілегің, сондықтан қанша қалағаның маңызды емес.
Dialogue: 0,0:10:08.75,0:10:10.76,Default,,0,0,0,,Осыны айта отырып, нарықтық бағалар →
Dialogue: 0,0:10:10.76,0:10:12.76,Default,,0,0,0,,Иә, солай ма? (Жерлеуші) Шынымен→
Dialogue: 0,0:10:12.76,0:10:14.76,Default,,0,0,0,,Қаншалықты қалайтыныңыз маған бәрібір, бірақ соңғы кезде →
Dialogue: 0,0:10:14.76,0:10:20.76,Default,,0,0,0,,Сутралар мен өлімнен кейінгі есімдер жиі біріктіріледі.
Dialogue: 0,0:10:23.77,0:10:26.77,Default,,0,0,0,,Бұл 400 000-нан 500 000-ға дейін.
Dialogue: 0,0:10:26.77,0:10:29.78,Default,,0,0,0,,Бұл өте аз ақша.
Dialogue: 0,0:10:29.78,0:10:31.78,Default,,0,0,0,,Ұзақ уақыт үшін кешіріңіз.
Dialogue: 0,0:10:31.78,0:10:34.78,Default,,0,0,0,,Эй Дайкичи, біраз уақыт болды.
Dialogue: 0,0:10:34.78,0:10:36.78,Default,,0,0,0,,Бос емессіз бе?
Dialogue: 0,0:10:36.78,0:10:38.78,Default,,0,0,0,,Иә. о қымбаттым.
Dialogue: 0,0:10:38.78,0:10:43.72,Default,,0,0,0,,Бос емес, бос емес... Мама сені көргісі келеді →
Dialogue: 0,0:10:43.72,0:10:46.73,Default,,0,0,0,,Жаңа жылға да қайтып келмейді. →
Dialogue: 0,0:10:46.73,0:10:49.73,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:10:49.73,0:10:52.73,Default,,0,0,0,,≪(Харуко) Күте тұрыңыз! Рейна!
Dialogue: 0,0:10:52.73,0:10:56.74,Default,,0,0,0,,Қараңғы! алақай. (Харуко) Сәлем Рейна!
Dialogue: 0,0:10:56.74,0:10:58.74,Default,,0,0,0,,Харуко.
Dialogue: 0,0:10:58.74,0:11:01.74,Default,,0,0,0,,О, үлкен бала. ұзақ уақытта көрмеу. (Рейна) Анашым.
Dialogue: 0,0:11:01.74,0:11:03.74,Default,,0,0,0,,Рейна~! (Рейна) Уууу.
Dialogue: 0,0:11:03.74,0:11:05.75,Default,,0,0,0,,Қазірдің өзінде ұсталды! →
Dialogue: 0,0:11:05.75,0:11:08.75,Default,,0,0,0,,Ол жақсы бала, сондықтан үндемеңіз.
Dialogue: 0,0:11:08.75,0:11:10.75,Default,,0,0,0,,Маған ұнамайды. Мен оны ұнатпаймын. Не?
Dialogue: 0,0:11:10.75,0:11:12.75,Default,,0,0,0,,Жоқ….
Dialogue: 0,0:11:15.76,0:11:19.76,Default,,0,0,0,,Сен... атаңа ұқсадың.
Dialogue: 0,0:11:26.77,0:11:28.77,Default,,0,0,0,,Дайкичи, сен мұны естідің бе?
Dialogue: 0,0:11:28.77,0:11:30.77,Default,,0,0,0,,Иә, жаңа ғана анам айтты.
Dialogue: 0,0:11:30.77,0:11:32.77,Default,,0,0,0,,Бұл шынымен де солай ма? →
Dialogue: 0,0:11:32.77,0:11:36.78,Default,,0,0,0,,Мен ағамның жалғыз тұруы жалғыздық шығар деп ойладым.
Dialogue: 0,0:11:36.78,0:11:38.78,Default,,0,0,0,,Ана мен бала денсаулығына арналған анықтамалық болған көрінеді. →
Dialogue: 0,0:11:38.78,0:11:40.71,Default,,0,0,0,,«Рин» деген атпен.
Dialogue: 0,0:11:40.71,0:11:45.72,Default,,0,0,0,,79 жаста болса да, мұндай...
Dialogue: 0,0:11:45.72,0:11:47.72,Default,,0,0,0,,Әкем болса, бәрібір→
Dialogue: 0,0:11:47.72,0:11:51.72,Default,,0,0,0,,Негізі олар жақсы жұмыс істегендей сезінемін.
Dialogue: 0,0:11:51.72,0:11:55.73,Default,,0,0,0,,Дайкичи, сен маған шкафтан жастық әкеле аласың ба?
Dialogue: 0,0:11:55.73,0:11:57.73,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:57.73,0:11:59.73,Default,,0,0,0,,≪(аяқ дыбысы)
Dialogue: 0,0:11:59.73,0:12:22.76,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:22.76,0:12:25.76,Default,,0,0,0,,Ах.
Dialogue: 0,0:12:25.76,0:12:27.76,Default,,0,0,0,,Не?
Dialogue: 0,0:12:27.76,0:12:47.71,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:47.71,0:12:52.72,Default,,0,0,0,,Эй, оны осымен ауыстыр. →
Dialogue: 0,0:12:52.72,0:12:57.72,Default,,0,0,0,,Ах, жоқ. Тек маған беріңіз.
Dialogue: 0,0:13:00.73,0:13:03.73,Default,,0,0,0,,Орындалды! Хехе.
Dialogue: 0,0:13:05.73,0:13:08.73,Default,,0,0,0,,Әй, қара, қара!
Dialogue: 0,0:13:08.73,0:13:10.74,Default,,0,0,0,,Рейна, жүгірме!
Dialogue: 0,0:13:10.74,0:13:12.74,Default,,0,0,0,,Жарайды, сен жақсысың.
Dialogue: 0,0:13:12.74,0:13:14.74,Default,,0,0,0,,Әдемі?
Dialogue: 0,0:13:14.74,0:13:18.74,Default,,0,0,0,,Рас. Рейна-чан нәрселерге қамқорлық жасауда өте жақсы.
Dialogue: 0,0:13:20.75,0:13:23.75,Default,,0,0,0,,Әрі қарай төрт сатылы баспалдақты қолданып көріңіз.
Dialogue: 0,0:13:23.75,0:13:25.75,Default,,0,0,0,,Хмм….
Dialogue: 0,0:13:25.75,0:13:28.75,Default,,0,0,0,,О, Рейна-чан, маған аздап қарыз берші.
Dialogue: 0,0:13:28.75,0:13:30.76,Default,,0,0,0,,Хмм! Бомба!
Dialogue: 0,0:13:30.76,0:13:33.76,Default,,0,0,0,,Ах. (Харуко) Міне! Рейна.
Dialogue: 0,0:13:33.76,0:14:07.96,Default,,0,0,0,,♪♪~
Dialogue: 0,0:14:07.96,0:14:12.56,Default,,0,0,0,,(Сағат қоңырауының дыбысы)
Dialogue: 0,0:14:21.74,0:14:23.74,Default,,0,0,0,,≪Ағатай.
Dialogue: 0,0:14:23.74,0:14:26.75,Default,,0,0,0,,Иә? Өтінемін, алдымен ұйықта.
Dialogue: 0,0:14:26.75,0:14:28.75,Default,,0,0,0,,Мен хош иісті таяқшаға қамқор боламын.
Dialogue: 0,0:14:28.75,0:14:31.75,Default,,0,0,0,,Ой... Ой, түсіндім.
Dialogue: 0,0:14:31.75,0:14:39.78,Default,,0,0,0,,Эй, мұнда ұйықтама. Маған сол жерде демалуға рұқсат етіңіз.
Dialogue: 0,0:14:39.78,0:14:41.69,Default,,0,0,0,,Хош иісті заттар ше?
Dialogue: 0,0:14:41.69,0:14:46.70,Default,,0,0,0,,Дайкичи қарап шығады. Жүр, кеттік.
Dialogue: 0,0:14:46.70,0:14:49.70,Default,,0,0,0,,Бауырым, мен сұрадым.
Dialogue: 0,0:14:53.71,0:14:56.71,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:56.71,0:14:58.71,Default,,0,0,0,,Сен де сонда ұйықтау керек.
Dialogue: 0,0:15:00.71,0:15:02.71,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:15:04.72,0:15:06.72,Default,,0,0,0,,Жасырын бет.
Dialogue: 0,0:15:06.72,0:15:20.72,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:14.71,0:17:19.71,Default,,0,0,0,,Енді, бәріңіз, соңғы қоштасуларыңызды өтінеміз.
Dialogue: 0,0:17:24.72,0:17:29.73,Default,,0,0,0,,Анаңа сәлем айт. (Туыс) Ата.
Dialogue: 0,0:17:29.73,0:17:31.73,Default,,0,0,0,,Мен сені бірден көруге барамын.
Dialogue: 0,0:17:33.73,0:17:37.73,Default,,0,0,0,,≪(Харуко) Рена, қош келдіңіз. (Рейна) Иә.
Dialogue: 0,0:17:39.74,0:17:41.74,Default,,0,0,0,,Атамен қоштасу.
Dialogue: 0,0:17:41.74,0:17:43.74,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:46.75,0:17:48.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:49.98,0:17:51.75,Default,,0,0,0,,≪(Рейна) Гүл бақшасы!
Dialogue: 0,0:17:51.75,0:17:54.75,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:17:54.75,0:18:02.76,Default,,0,0,0,,Маған ұнамайды! Мен оны гүлзарға айналдырғалы жатырмын. Мен мұны істегім келеді.
Dialogue: 0,0:18:02.76,0:18:04.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:09.70,0:18:12.70,Default,,0,0,0,,Сен де осында кел, қош айт.
Dialogue: 0,0:18:12.70,0:18:28.72,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:28.72,0:18:30.72,Default,,0,0,0,,Хмм….
Dialogue: 0,0:18:32.72,0:18:34.72,Default,,0,0,0,,Ата, мен оны саған сәндеймін.
Dialogue: 0,0:18:44.40,0:18:46.07,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:46.07,0:18:47.67,Default,,0,0,0,,Эй!
Dialogue: 0,0:18:49.74,0:18:52.74,Default,,0,0,0,,О! (Туыстар) Жарайды!
Dialogue: 0,0:19:01.75,0:19:05.76,Default,,0,0,0,,《А... Гентиан》
Dialogue: 0,0:19:05.76,0:19:08.76,Default,,0,0,0,,《Қария ұнатқан гүл》
Dialogue: 0,0:19:26.71,0:19:31.71,Default,,0,0,0,,Қария. Бұл гүл маған бәрінен де ұнайды.
Dialogue: 0,0:19:33.72,0:19:37.72,Default,,0,0,0,,Қайта оянбайсың ба?
Dialogue: 0,0:19:42.73,0:19:47.73,Default,,0,0,0,,А... Мен енді оянбаймын.
Dialogue: 0,0:19:50.74,0:19:58.74,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:19:58.74,0:20:03.75,Default,,0,0,0,,《Сен шынымен де қарияның баласысың.》
Dialogue: 0,0:20:03.75,0:20:41.72,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:41.72,0:20:43.72,Default,,0,0,0,,Уа.
Dialogue: 0,0:20:43.72,0:20:55.73,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:55.73,0:21:00.74,Default,,0,0,0,,Ой, иә. Уф! Уф!
Dialogue: 0,0:21:00.74,0:21:10.68,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:10.68,0:21:17.68,Default,,0,0,0,,(бұранданы орау дыбысы)
Dialogue: 0,0:21:20.69,0:21:25.70,Default,,0,0,0,,Бұл Масако Йошии қайда кетті?
Dialogue: 0,0:21:25.70,0:21:28.70,Default,,0,0,0,,Қандай адам баласын тастап қашады →
Dialogue: 0,0:21:28.70,0:21:31.70,Default,,0,0,0,,Мен оны тапсам да, ештеңе істемейді деп ойлаймын.
Dialogue: 0,0:21:31.70,0:21:34.71,Default,,0,0,0,,Мүлдем жауапсыздық.
Dialogue: 0,0:21:34.71,0:21:38.71,Default,,0,0,0,,Менің ағам да қыңыр болған шығар.
Dialogue: 0,0:21:52.72,0:21:54.39,Default,,0,0,0,,Қараңғы!
Dialogue: 0,0:21:54.39,0:21:56.40,Default,,0,0,0,,Ей! сәуле! Squishy squishy.
Dialogue: 0,0:21:56.40,0:21:58.06,Default,,0,0,0,,Бұл қауіпті!
Dialogue: 0,0:21:58.06,0:22:00.73,Default,,0,0,0,,Эй, ол сөйлей алмайды.
Dialogue: 0,0:22:00.73,0:22:04.74,Default,,0,0,0,,Бұл мәселе, менің тістерім әлі түскен жоқ!
Dialogue: 0,0:22:04.74,0:22:07.76,Default,,0,0,0,,Мен сөйлей аламын! Уайымдама!
Dialogue: 0,0:22:07.76,0:22:14.68,Default,,0,0,0,,Мен сөйлей алмаймын! Сондықтан Рейна қызықсыз!
Dialogue: 0,0:22:14.68,0:22:18.68,Default,,0,0,0,,Қараңдар! Мен сен үшін бәрін жасаймын, сосын сол жаққа бар.
Dialogue: 0,0:22:18.68,0:22:24.69,Default,,0,0,0,,Мен кәмпит дүкенін көрдім. Апыр-ай. (Харуко) Кешіріңіз, Дай Чан.
Dialogue: 0,0:22:24.69,0:22:26.69,Default,,0,0,0,,Болашаққа қарамастан →
Dialogue: 0,0:22:26.69,0:22:30.70,Default,,0,0,0,,Ол баланы әзірге кім қарайды?
Dialogue: 0,0:22:30.70,0:22:33.70,Default,,0,0,0,,Бұл біз үшін мүмкін емес. Мен дүкен жүргіземін.
Dialogue: 0,0:22:33.70,0:22:36.70,Default,,0,0,0,,Ол сәл дұрысырақ болса ғой.
Dialogue: 0,0:22:36.70,0:22:39.71,Default,,0,0,0,,Тіл де кешігіп қалған сияқты.
Dialogue: 0,0:22:39.71,0:22:42.71,Default,,0,0,0,,Анашым, сіз үйдесіз →
Dialogue: 0,0:22:42.71,0:22:45.71,Default,,0,0,0,,Сіз оны біраз уақытқа қалдыра алмайсыз ба?
Dialogue: 0,0:22:45.71,0:22:48.71,Default,,0,0,0,,Хмм... Бұл мүмкін емес!
Dialogue: 0,0:22:48.71,0:22:51.72,Default,,0,0,0,,Менің де онша бос уақытым жоқ! →
Dialogue: 0,0:22:51.72,0:22:55.72,Default,,0,0,0,,Бала тәрбиелеу қаншалықты қиын екенін білесің бе?
Dialogue: 0,0:22:55.72,0:22:59.73,Default,,0,0,0,,Мен өзімді қанша құрбан еттім?
Dialogue: 0,0:22:59.73,0:23:04.73,Default,,0,0,0,,Біртүрлі нәрсе жасасаңыз да, оны аяйсыз.
Dialogue: 0,0:23:04.73,0:23:06.40,Default,,0,0,0,,《Бұл талқылау →
Dialogue: 0,0:23:06.40,0:23:09.33,Default,,0,0,0,,«Ринге біреу қамқор болады» дегеніңіз емес пе? 》
Dialogue: 0,0:23:09.33,0:23:12.57,Default,,0,0,0,,Жалпы, ағам өз бетімен бірдеңе жасауды жоспарлайды→
Dialogue: 0,0:23:12.57,0:23:15.57,Default,,0,0,0,,Біреуі жоқ, солай ма? Шындыққа көбірек қараңыз.
Dialogue: 0,0:23:15.57,0:23:17.58,Default,,0,0,0,,Бірінші кезекте→
Dialogue: 0,0:23:17.58,0:23:22.58,Default,,0,0,0,,Шынымен де атамның баласы ма, білмеймін.
Dialogue: 0,0:23:22.58,0:23:26.59,Default,,0,0,0,,Қараңызшы, сіз ештеңе ойламағандықтан дауласа алмайсыз, солай ма?
Dialogue: 0,0:23:26.59,0:23:51.61,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:51.61,0:23:58.61,Default,,0,0,0,,(Сағат қоңырауының дыбысы)
Dialogue: 0,0:24:00.62,0:24:03.62,Default,,0,0,0,,Олар сізді бірден қабылдайды.→
Dialogue: 0,0:24:03.62,0:24:06.62,Default,,0,0,0,,Құрылыстарды тексерейік.
Dialogue: 0,0:24:11.56,0:24:14.56,Default,,0,0,0,,Не... не! ?
Dialogue: 0,0:24:25.58,0:24:27.58,Default,,0,0,0,,Рин!
Dialogue: 0,0:24:29.58,0:24:40.59,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:40.59,0:24:43.60,Default,,0,0,0,,Келесің бе?
Dialogue: 0,0:24:43.60,0:24:46.60,Default,,0,0,0,,Сәлем! Үлкен сәттілік! үлкен аға!
Dialogue: 0,0:24:46.60,0:25:32.58,Default,,0,0,0,,♪♪~
Dialogue: 0,0:25:32.58,0:25:36.58,Default,,0,0,0,,Ағай менің қарным ашты.
Dialogue: 0,0:25:36.58,0:25:39.58,Default,,0,0,0,,Әй... Ағай аға….
Dialogue: 0,0:25:39.58,0:25:41.59,Default,,0,0,0,,Мені ағай деп айтпаңыз!
Dialogue: 0,0:25:41.59,0:25:43.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:43.59,0:25:47.59,Default,,0,0,0,,≪Ақырында, сіз менің нағашымсыз!
Dialogue: 0,0:25:50.60,0:26:00.60,Default,,0,0,0,,♪♪~
Dialogue: 0,0:27:23.62,0:27:25.62,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:27:25.62,0:27:27.63,Default,,0,0,0,,Иә.
Dialogue: 0,0:27:27.63,0:27:30.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:30.63,0:27:32.63,Default,,0,0,0,,Қайта толтыру керек пе? Иә.
Dialogue: 0,0:27:32.63,0:27:35.63,Default,,0,0,0,,Енді гарнир жоқ.
Dialogue: 0,0:27:35.63,0:27:37.64,Default,,0,0,0,,Мен одан күріш шарларын жасаймын.
Dialogue: 0,0:27:37.64,0:27:40.64,Default,,0,0,0,,Тіпті күріш шарларына арналған ингредиенттер де емес.
Dialogue: 0,0:27:40.64,0:27:43.64,Default,,0,0,0,,Тұз! тұз?
Dialogue: 0,0:27:46.64,0:27:48.65,Default,,0,0,0,,Сәлем! Әлі ыстық.
Dialogue: 0,0:27:48.65,0:27:51.65,Default,,0,0,0,,Дегенмен сен оның сыртқы түріне де, әрекетіне де мүлде ұқсамайсың—
Dialogue: 0,0:27:51.65,0:27:55.65,Default,,0,0,0,,Бірақ оның нәзік дәмі бар.
Dialogue: 0,0:27:55.65,0:27:58.66,Default,,0,0,0,,Иә! Ата.
Dialogue: 0,0:27:58.66,0:28:01.66,Default,,0,0,0,,Мен қате жібердім. Үлкен сәттілік!
Dialogue: 0,0:28:01.66,0:28:03.66,Default,,0,0,0,,《Дайкичи де біртүрлі》
Dialogue: 0,0:28:06.66,0:28:09.70,Default,,0,0,0,,Хехе.
Dialogue: 0,0:28:09.70,0:28:12.70,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:28:12.70,0:28:14.70,Default,,0,0,0,,Хехехе.
Dialogue: 0,0:30:33.75,0:30:35.75,Default,,0,0,0,,А... ха... Ха!
Dialogue: 0,0:30:35.75,0:30:42.75,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:30:42.75,0:30:44.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:30:44.76,0:30:55.77,Default,,0,0,0,,♪♪~
Dialogue: 0,0:30:55.77,0:30:57.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:30:57.77,0:30:59.77,Default,,0,0,0,,Конверт пе?
Dialogue: 0,0:30:59.77,0:31:01.77,Default,,0,0,0,,Уф... уф!
Dialogue: 0,0:31:03.27,0:31:08.27,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
