Dialogue: 0,0:23:18.04,0:23:23.36,ED-JP,,0000,0000,0000,,Тағы да есімде
Dialogue: 0,0:23:23.60,0:23:29.31,ED-JP-2,,0000,0000,0000,,Бұл әдемі және қатыгез әлемде
Dialogue: 0,0:23:29.62,0:23:32.13,ED-JP-2,,0000,0000,0000,,Әлі тірі
Dialogue: 0,0:23:32.13,0:23:34.98,ED-JP-2,,0000,0000,0000,,Неге екенін сұрап жатырмын
Dialogue: 0,0:23:34.98,0:23:40.51,ED-JP-2,,0000,0000,0000,,А, бізде бұл күшті және әлсіз.
Dialogue: 0,0:23:40.54,0:23:43.66,ED-JP-2,,0000,0000,0000,,Біз нені қорғаймыз?
Dialogue: 0,0:23:44.11,0:23:49.88,ED-JP-2,,0000,0000,0000,,Енді ешқандай себеп болмаса
