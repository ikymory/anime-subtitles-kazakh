Dialogue: 0,0:01:30.13,0:01:39.49,诸神字幕组显示,NTP,0000,0000,0000,,Бұл субтитрді Yushujin Subtitles Group (kamigami.org) шығарған және білім беру және алмасу мақсаттарына арналған. Бұл Киёши Вакаенің түпнұсқа жұмысы және фильмнің түпнұсқа нұсқасын автор қолдайды.
Dialogue: 0,0:01:30.13,0:01:39.49,成员名显示,NTP,0000,0000,0000,,： &： ： ：, ：
Dialogue: 0,0:01:57.36,0:02:04.71,日文对话,NTP,0000,0000,0000,,Тәңірім, уәдеңде тұр
Dialogue: 0,0:02:09.73,0:02:11.15,日文对话,NTP,0000,0000,0000,,Сая
Dialogue: 0,0:02:12.68,0:02:14.54,日文对话,NTP,0000,0000,0000,,Қайырлы таң, әке.
Dialogue: 0,0:02:15.82,0:02:18.90,日文对话,NTP,0000,0000,0000,,Әлі ерте шығар. Менің кешегі жарақаттарым әлі бар.
Dialogue: 0,0:02:19.29,0:02:21.47,日文对话,NTP,0000,0000,0000,,Кішкене ұйықтасам екен
Dialogue: 0,0:02:22.21,0:02:23.76,日文对话,NTP,0000,0000,0000,,Сайо күшті.
Dialogue: 0,0:02:25.34,0:02:29.86,日文对话,NTP,0000,0000,0000,,Бұл сіздің денеңіз ғана емес, алаңдататын тағы да көп нәрсе бар шығар.
Dialogue: 0,0:02:35.79,0:02:41.28,日文对话,NTP,0000,0000,0000,,Кеше көне заттарға шабуыл жасаған қала тұрғындары туралы...
Dialogue: 0,0:02:42.94,0:02:44.03,日文对话,NTP,0000,0000,0000,,Кейін…
Dialogue: 0,0:02:46.27,0:02:48.97,日文对话,NTP,0000,0000,0000,,Ескі өшпес бұрын айттым.
Dialogue: 0,0:02:50.74,0:02:53.73,日文对话,NTP,0000,0000,0000,,Тәңірім, уәдеңді орында
Dialogue: 0,0:02:56.21,0:02:59.17,日文对话,NTP,0000,0000,0000,,Ежелгі нәрсе алғаш рет сөйледі.
Dialogue: 0,0:03:01.81,0:03:05.89,日文对话,NTP,0000,0000,0000,,Ал Иеміз кім?
Dialogue: 0,0:03:08.08,0:03:10.20,日文对话,NTP,0000,0000,0000,,Шарт дегеніміз не?
Dialogue: 0,0:03:12.78,0:03:15.21,日文对话,NTP,0000,0000,0000,,Саяға бұлар қандай?
Dialogue: 0,0:03:16.07,0:03:17.62,日文对话,NTP,0000,0000,0000,,Жеңілетін нәрсе
Dialogue: 0,0:03:18.50,0:03:21.74,日文对话,NTP,0000,0000,0000,,Ескі сөздің жетегінде кетпе
Dialogue: 0,0:03:21.95,0:03:23.76,日文对话,NTP,0000,0000,0000,,Жақсы Сая
Dialogue: 0,0:03:28.51,0:03:30.21,日文对话,NTP,0000,0000,0000,,Иә, әке.
Dialogue: 0,0:03:37.36,0:03:40.03,日文对话,NTP,0000,0000,0000,,Бүгін де ауа-райы жақсы
Dialogue: 0,0:03:42.26,0:03:46.84,日文对话,NTP,0000,0000,0000,,әдеттегідей
Dialogue: 0,0:03:47.20,0:03:51.90,日文对话,NTP,0000,0000,0000,,Цикада-сан ән салып жатыр, бұлттың пішіні өзгереді
Dialogue: 0,0:03:52.22,0:03:57.49,日文对话,NTP,0000,0000,0000,,Шынымен де жақсы сезім
Dialogue: 0,0:03:59.66,0:04:02.65,日文对话,NTP,0000,0000,0000,,Бүгін де ауа-райы жақсы
Dialogue: 0,0:04:04.75,0:04:09.46,日文对话,NTP,0000,0000,0000,,Ешқашан өзгермейтін тыныш күн
Dialogue: 0,0:04:09.96,0:04:14.63,日文对话,NTP,0000,0000,0000,,Бейбіт, мейірімді адамдар
Dialogue: 0,0:04:21.08,0:04:24.20,日文对话,NTP,0000,0000,0000,,Әке, жүзіңіз қатал еді.
Dialogue: 0,0:04:26.31,0:04:28.57,日文对话,NTP,0000,0000,0000,,Мен жарақат алдым ба?
Dialogue: 0,0:04:31.39,0:04:33.41,日文对话,NTP,0000,0000,0000,,Мен күштірек болуым керек
Dialogue: 0,0:04:46.69,0:04:49.72,日文对话,NTP,0000,0000,0000,,Бүгін де бос күн сияқты.
Dialogue: 0,0:04:50.34,0:04:52.18,日文对话,NTP,0000,0000,0000,,Жарайды, ауа райы солай.
Dialogue: 0,0:04:52.43,0:04:54.08,日文对话,NTP,0000,0000,0000,,Бір оқиға болған сияқты.
Dialogue: 0,0:04:54.54,0:04:56.19,日文对话,NTP,0000,0000,0000,,А, наубайхана.
Dialogue: 0,0:04:59.22,0:05:01.70,日文对话,NTP,0000,0000,0000,,Ол ашық емес. Ойланып көрейікші.
Dialogue: 0,0:05:02.55,0:05:05.02,日文对话,NTP,0000,0000,0000,,Қайтып келмеген сияқты.
Dialogue: 0,0:05:11.18,0:05:14.58,日文对话,NTP,0000,0000,0000,,Қылыш Бірақ бұл...
Dialogue: 0,0:05:14.82,0:05:15.80,日文对话,NTP,0000,0000,0000,,Бұл дұрыс
Dialogue: 0,0:05:16.62,0:05:17.55,日文对话,NTP,0000,0000,0000,,Таңертең тоқтағанымда
Dialogue: 0,0:05:17.66,0:05:20.46,日文对话,NTP,0000,0000,0000,,Мен нан сатып алуда дәл осындай қиындыққа тап болған адамнан сұрадым.
Dialogue: 0,0:05:20.85,0:05:21.52,日文对话,NTP,0000,0000,0000,,Шынымен
Dialogue: 0,0:05:22.47,0:05:25.64,日文对话,NTP,0000,0000,0000,,Полиция қызметкері маған «Гуимаве» туралы ескертуге келді.
Dialogue: 0,0:05:25.68,0:05:27.35,日文对话,NTP,0000,0000,0000,,Оны да полиция іздеген болар еді.
Dialogue: 0,0:05:28.57,0:05:30.80,日文对话,NTP,0000,0000,0000,,Бірақ ол еш жерден табылмайтын сияқты.
Dialogue: 0,0:05:33.74,0:05:35.15,日文对话,NTP,0000,0000,0000,,Бұл олай емес.
Dialogue: 0,0:05:35.51,0:05:38.57,日文对话,NTP,0000,0000,0000,,Мен бұл ауылды жек көріп, үйден қашып кеттім.
Dialogue: 0,0:05:39.84,0:05:42.72,日文对话,NTP,0000,0000,0000,,Ересек адам үйіне қайтпаса да, қашып кеткен болып есептеледі.
Dialogue: 0,0:05:43.89,0:05:45.61,日文对话,NTP,0000,0000,0000,,Тағы не айта аламын?
Dialogue: 0,0:05:48.61,0:05:49.29,日文对话,NTP,0000,0000,0000,,Жоғалу
Dialogue: 0,0:05:49.42,0:05:50.40,日文对话,NTP,0000,0000,0000,,Зұлымдар Альянсы мен Шие Хачисай-кай арасында жақсы ынтымақтастық жоқ —
Dialogue: 0,0:05:58.71,0:05:59.61,日文对话,NTP,0000,0000,0000,,Сая
Dialogue: 0,0:05:59.74,0:06:00.62,日文对话,NTP,0000,0000,0000,,Чанги мырза
Dialogue: 0,0:06:00.99,0:06:01.74,日文对话,NTP,0000,0000,0000,,Ит
Dialogue: 0,0:06:02.68,0:06:03.82,日文对话,NTP,0000,0000,0000,,Ит пе?
Dialogue: 0,0:06:04.34,0:06:05.16,日文对话,NTP,0000,0000,0000,,Ол мойнын қорғап қалды
Dialogue: 0,0:06:16.62,0:06:17.54,日文对话,NTP,0000,0000,0000,,Қауіпті
Dialogue: 0,0:06:24.63,0:06:26.56,日文对话,NTP,0000,0000,0000,,Кешіріңіз...
Dialogue: 0,0:06:26.88,0:06:30.77,日文对话,NTP,0000,0000,0000,,Дәрігерге барар алдында, емханаға барыңыз.
Dialogue: 0,0:06:31.69,0:06:33.53,日文对话,NTP,0000,0000,0000,,Алдымен жолдан шығыңыз.
Dialogue: 0,0:06:37.89,0:06:39.95,日文对话,NTP,0000,0000,0000,,Мен де енді көбірек тырысуым керек сияқты!
Dialogue: 0,0:06:40.49,0:06:42.06,日文对话,NTP,0000,0000,0000,,Сіз қауіпсіз сияқтысыз, бұл жақсы.
Dialogue: 0,0:06:43.23,0:06:47.01,日文对话,NTP,0000,0000,0000,,Сонымен қатар, сен неге ағашқа өрмелеп келдің?
Dialogue: 0,0:06:47.48,0:06:48.73,日文对话,NTP,0000,0000,0000,,Мен сені қудым.
Dialogue: 0,0:06:49.49,0:06:50.47,日文对话,NTP,0000,0000,0000,,Не
Dialogue: 0,0:06:50.72,0:06:54.91,日文对话,NTP,0000,0000,0000,,Кішкентай ит десе де, кішкентай ит пе, білмеймін.
Dialogue: 0,0:06:55.13,0:06:57.24,日文对话,NTP,0000,0000,0000,,Бірақ бұл өте кішкентай.
Dialogue: 0,0:06:57.42,0:07:00.57,日文对话,NTP,0000,0000,0000,,Сен неге итті ағашқа қуып барасың?
Dialogue: 0,0:07:01.13,0:07:04.67,日文对话,NTP,0000,0000,0000,,Ит бұтақтардың үстінен секіреді.
Dialogue: 0,0:07:05.25,0:07:07.04,日文对话,NTP,0000,0000,0000,,Бұл мысық емес пе?
Dialogue: 0,0:07:07.58,0:07:09.06,日文对话,NTP,0000,0000,0000,,Жоқ, бұл ит болды.
Dialogue: 0,0:07:13.51,0:07:16.53,日文对话,NTP,0000,0000,0000,,Тамақ Тез тамақтанбасаңыз, түскі үзіліс бітеді.
Dialogue: 0,0:07:17.10,0:07:18.68,日文对话,NTP,0000,0000,0000,,Аа, дұрыс.
Dialogue: 0,0:07:21.82,0:07:23.04,日文对话,NTP,0000,0000,0000,,Токима-сан ше?
Dialogue: 0,0:07:24.03,0:07:25.59,日文对话,NTP,0000,0000,0000,,Тамақтан гөрі ұйықтаған жақсы
Dialogue: 0,0:07:25.72,0:07:29.13,日文对话,NTP,0000,0000,0000,,Жоқ, қарным ашқанда мұңаямын.
Dialogue: 0,0:07:30.26,0:07:32.27,日文对话,NTP,0000,0000,0000,,Сіз мұны бұрын айттыңыз.
Dialogue: 0,0:07:33.99,0:07:35.35,日文对话,NTP,0000,0000,0000,,Өйткені мен
Dialogue: 0,0:07:38.69,0:07:40.69,日文对话,NTP,0000,0000,0000,,Сіз қызықсыз.
Dialogue: 0,0:07:44.55,0:07:45.63,日文对话,NTP,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:07:47.26,0:07:50.41,日文对话,NTP,0000,0000,0000,,Күлімдегенде жақсы көрінесің, Токима-сан.
Dialogue: 0,0:07:50.96,0:07:53.07,日文对话,NTP,0000,0000,0000,,Не...не деп тұрсың?
Dialogue: 0,0:08:05.88,0:08:09.22,日文对话,NTP,0000,0000,0000,,Бірге тамақтанайық. Бұл дәмді.
Dialogue: 0,0:08:09.54,0:08:11.01,日文对话,NTP,0000,0000,0000,,Бунтоның түскі ас қорабы
Dialogue: 0,0:08:11.92,0:08:15.07,日文对话,NTP,0000,0000,0000,,Фумихито мырза – Gimauve кафесінің шебері
Dialogue: 0,0:08:15.22,0:08:16.39,日文对话,NTP,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:08:17.89,0:08:19.15,日文对话,NTP,0000,0000,0000,,Мен білемін
Dialogue: 0,0:08:19.89,0:08:21.24,日文对话,NTP,0000,0000,0000,,Онигири өтінемін
Dialogue: 0,0:08:39.02,0:08:40.31,日文对话,NTP,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:08:40.70,0:08:42.91,日文对话,NTP,0000,0000,0000,,Өте дәмді екен.
Dialogue: 0,0:08:43.53,0:08:45.12,日文对话,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,0:08:46.18,0:08:48.28,日文对话,NTP,0000,0000,0000,,Менің ойымша, сіз үлгере алмадыңыз.
Dialogue: 0,0:08:48.28,0:08:49.57,日文对话,NTP,0000,0000,0000,,Иә, бірақ
Dialogue: 0,0:08:50.17,0:08:53.04,日文对话,NTP,0000,0000,0000,,Жасаған тағамыңыз дәмді екенін айтқаныңызға рахмет.
Dialogue: 0,0:08:53.10,0:08:54.22,日文对话,NTP,0000,0000,0000,,Мен сол лайшаға қызғанып жүр едім…
Dialogue: 0,0:09:02.12,0:09:04.35,日文对话,NTP,0000,0000,0000,,Сіз сол сауатты туралы айтып отырсыз ба?
Dialogue: 0,0:09:04.74,0:09:05.89,日文对话,NTP,0000,0000,0000,,Мен сені жақсы көремін
Dialogue: 0,0:09:09.94,0:09:12.28,日文对话,NTP,0000,0000,0000,,Қызық, Сайочан қайда кетті?
Dialogue: 0,0:09:13.05,0:09:14.22,日文对话,NTP,0000,0000,0000,,Қақпаны жабасың дедің бе?
Dialogue: 0,0:09:17.42,0:09:18.54,日文对话,NTP,0000,0000,0000,,Токима-сан
Dialogue: 0,0:09:20.69,0:09:22.01,日文对话,NTP,0000,0000,0000,,Қалай...
Dialogue: 0,0:09:22.47,0:09:23.60,日文对话,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:09:24.45,0:09:26.63,日文对话,NTP,0000,0000,0000,,Сізге қалай ұнайды?
Dialogue: 0,0:09:27.17,0:09:29.15,日文对话,NTP,0000,0000,0000,,Маған өте ұнайды
Dialogue: 0,0:09:29.30,0:09:32.76,日文对话,NTP,0000,0000,0000,,Фумито-сан мейірімді және ас әзірлеуге шебер.
Dialogue: 0,0:09:33.13,0:09:35.56,日文对话,NTP,0000,0000,0000,,Мені үнемі тыңдағаныңыз үшін рахмет.
Dialogue: 0,0:09:35.76,0:09:36.74,日文对话,NTP,0000,0000,0000,,Оны жібермеуім керек еді....
Dialogue: 0,0:09:44.07,0:09:45.74,日文对话,NTP,0000,0000,0000,,Ол мейірімді және жақсы аспазшы.
Dialogue: 0,0:09:46.15,0:09:47.86,日文对话,NTP,0000,0000,0000,,Сіз мені тыңдай аласыз ба?
Dialogue: 0,0:09:47.99,0:09:48.70,日文对话,NTP,0000,0000,0000,,Енді сен агент емессің.
Dialogue: 0,0:09:51.64,0:09:54.65,日文对话,NTP,0000,0000,0000,,Бұл сізге шынымен ұнайтынын білдіре ме?
Dialogue: 0,0:10:02.62,0:10:04.33,日文对话,NTP,0000,0000,0000,,Маған солай айтылды.
Dialogue: 0,0:10:06.08,0:10:10.35,日文对话,NTP,0000,0000,0000,,Мен Токима-санның ашуын келтіретін бірдеңе жасадым ғой...
Dialogue: 0,0:10:11.04,0:10:13.78,日文对话,NTP,0000,0000,0000,,Жоқ, мен олай ойламаймын.
Dialogue: 0,0:10:14.78,0:10:17.99,日文对话,NTP,0000,0000,0000,,Бірақ сіздің жүзіңізде әрқашан қиын көрініс болды.
Dialogue: 0,0:10:19.52,0:10:20.88,日文对话,NTP,0000,0000,0000,,Көп нәрсе бар.
Dialogue: 0,0:10:20.96,0:10:23.82,日文对话,NTP,0000,0000,0000,,Ол бала әлі кішкентай.
Dialogue: 0,0:10:31.23,0:10:32.21,日文对话,NTP,0000,0000,0000,,Дәмді
Dialogue: 0,0:10:32.72,0:10:34.28,日文对话,NTP,0000,0000,0000,,Мен өзімді тыныш сезінемін
Dialogue: 0,0:10:34.33,0:10:36.80,日文对话,NTP,0000,0000,0000,,Жазушыдан кофе ішкенде
Dialogue: 0,0:10:38.09,0:10:40.31,日文对话,NTP,0000,0000,0000,,Мен оны Сайо-чанға дайындап жатырмын.
Dialogue: 0,0:10:43.38,0:10:45.09,日文对话,NTP,0000,0000,0000,,Гимоув
Dialogue: 0,0:10:46.25,0:10:49.64,日文对话,NTP,0000,0000,0000,,Жарайды, Сайо-чан жақсы қыз.
Dialogue: 0,0:10:51.14,0:10:52.95,日文对话,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,0:11:05.99,0:11:07.09,日文对话,NTP,0000,0000,0000,,Сайо-чан?
Dialogue: 0,0:11:10.75,0:11:11.87,日文对话,NTP,0000,0000,0000,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:11:12.94,0:11:15.37,日文对话,NTP,0000,0000,0000,,Қандай да бір себептермен ол қабылданбады.
Dialogue: 0,0:11:16.01,0:11:17.16,日文对话,NTP,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:11:18.13,0:11:19.03,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:11:24.62,0:11:26.40,日文对话,NTP,0000,0000,0000,,Егер сізге бірдеңе керек болса, маған хабарлаңыз.
Dialogue: 0,0:11:27.11,0:11:30.52,日文对话,NTP,0000,0000,0000,,Кішкентай болса да, әрқашан
Dialogue: 0,0:11:33.55,0:11:34.65,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:11:41.19,0:11:43.44,日文对话,NTP,0000,0000,0000,,Адамдардың эмоциясын өзгерту қиын
Dialogue: 0,0:11:44.89,0:11:49.10,日文对话,NTP,0000,0000,0000,,Не болса да, жүрегіңде терең ойып алса.
Dialogue: 0,0:11:50.37,0:11:53.00,日文对话,NTP,0000,0000,0000,,Жек көру ең қиын нәрсе ме?
Dialogue: 0,0:11:53.99,0:11:56.50,日文对话,NTP,0000,0000,0000,,Жек көрушілік ұзаққа бармайды деп жиі айтылады.
Dialogue: 0,0:11:57.02,0:11:59.07,日文对话,NTP,0000,0000,0000,,Бұл оның жоғалып кеткенін білдірмейді.
Dialogue: 0,0:11:59.96,0:12:03.02,日文对话,NTP,0000,0000,0000,,Көзге көрінбейтін жерде жасырыну
Dialogue: 0,0:12:03.13,0:12:04.49,日文对话,NTP,0000,0000,0000,,Ол дұрыс қалады
Dialogue: 0,0:12:05.73,0:12:09.07,日文对话,NTP,0000,0000,0000,,Кішкентай триггермен
Dialogue: 0,0:12:09.21,0:12:10.82,日文对话,NTP,0000,0000,0000,,Әлі де көрсетілуде
Dialogue: 0,0:12:11.87,0:12:15.64,日文对话,NTP,0000,0000,0000,,Міне, осындай қиын жек көрушілік.
Dialogue: 0,0:12:16.03,0:12:17.84,日文对话,NTP,0000,0000,0000,,Өшіре алмасаңыз не істеу керек
Dialogue: 0,0:12:18.68,0:12:19.42,日文对话,NTP,0000,0000,0000,,оны міндетті түрде өлтіргісі келер еді.
Dialogue: 0,0:12:19.72,0:12:24.04,日文对话,NTP,0000,0000,0000,,Менің ойымша, сол күшті сезімдерді қайта жазудан басқа амалым жоқ.
Dialogue: 0,0:12:28.61,0:12:31.12,日文对话,NTP,0000,0000,0000,,Біз барлығын қорғауымыз керек
Dialogue: 0,0:12:47.45,0:12:49.85,日文对话,NTP,0000,0000,0000,,Жек көру сияқты күшті ойлар
Dialogue: 0,0:12:51.28,0:12:56.17,日文对话,NTP,0000,0000,0000,,Иә, бұл махаббат пен сенім.
Dialogue: 0,0:13:09.42,0:13:10.13,日文对话,NTP,0000,0000,0000,,Ямада
Dialogue: 0,0:13:42.94,0:13:44.02,日文对话,NTP,0000,0000,0000,,Тез қашыңыз
Dialogue: 0,0:13:44.35,0:13:48.20,日文对话,NTP,0000,0000,0000,,Ей, мықты бол.
Dialogue: 0,0:13:48.27,0:13:50.27,日文对话,NTP,0000,0000,0000,,Әр түрлі оқиға
Dialogue: 0,0:14:10.45,0:14:12.56,日文对话,NTP,0000,0000,0000,,Өз денеңді құрту деген нені білдіреді?
Dialogue: 0,0:14:37.44,0:14:38.73,日文对话,NTP,0000,0000,0000,,Тез қашыңыз
Dialogue: 0,0:16:02.97,0:16:06.66,日文对话,NTP,0000,0000,0000,,Бізді құртқан Иеміз бе?
Dialogue: 0,0:17:16.67,0:17:19.48,日文对话,NTP,0000,0000,0000,,Соғыс өнерін білмейсің бе?
Dialogue: 0,0:17:34.67,0:17:37.30,日文对话,NTP,0000,0000,0000,,Оны басқару
Dialogue: 0,0:17:38.16,0:17:41.18,日文对话,NTP,0000,0000,0000,,Бұл Лордтар сияқты болады.
Dialogue: 0,0:17:42.68,0:17:45.83,日文对话,NTP,0000,0000,0000,,Жоғарыдағы нәрсе астындағыны жылжытады
Dialogue: 0,0:17:46.33,0:17:49.72,日文对话,NTP,0000,0000,0000,,Жылжытқыңыз келетін нәрсе үшін қайта жылжытыңыз
Dialogue: 0,0:17:50.13,0:17:55.41,日文对话,NTP,0000,0000,0000,,Бірақ сіз қозғалмайтын нәрселер бар, уәдеңізде тұрыңыз.
Dialogue: 0,0:17:57.77,0:17:59.89,日文对话,NTP,0000,0000,0000,,Шарт
Dialogue: 0,0:18:00.59,0:18:02.90,日文对话,NTP,0000,0000,0000,,Шужикиме!
Dialogue: 0,0:18:04.23,0:18:05.75,日文对话,NTP,0000,0000,0000,,Шужики?
Dialogue: 0,0:18:10.81,0:18:14.09,日文对话,NTP,0000,0000,0000,,Біз өзіміз үшін тамақтанамыз
Dialogue: 0,0:18:14.35,0:18:18.48,日文对话,NTP,0000,0000,0000,,Егер сізді мазалайтын болса, онда сіз шеберді жегенше.
Dialogue: 0,0:18:24.81,0:18:28.01,日文对话,NTP,0000,0000,0000,,Жекпе-жек – жалғыз нәрсе
Dialogue: 0,0:20:24.57,0:20:25.81,日文对话,NTP,0000,0000,0000,,20-шы эпизод: Бастықтың соңғы бұйрығы
Dialogue: 0,0:20:33.09,0:20:35.99,日文对话,NTP,0000,0000,0000,,Жоқ, бұл…
Dialogue: 0,0:20:37.46,0:20:38.78,日文对话,NTP,0000,0000,0000,,Сая
Dialogue: 0,0:20:45.41,0:20:46.59,日文对话,NTP,0000,0000,0000,,Тіпті тәтті, бал иісі бар дене жылуы
Dialogue: 0,0:20:50.63,0:20:51.90,日文对话,NTP,0000,0000,0000,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:20:52.59,0:20:57.44,日文对话,NTP,0000,0000,0000,,Иә, бірақ Сая жақсы.
Dialogue: 0,0:20:58.63,0:21:01.78,日文对话,NTP,0000,0000,0000,,Бұрынғыларды да өлтірдім.
Dialogue: 0,0:21:01.95,0:21:03.90,日文对话,NTP,0000,0000,0000,,Бұл қандай болды?
Dialogue: 0,0:21:04.34,0:21:07.06,日文对话,NTP,0000,0000,0000,,Біздікіндей шығар
Dialogue: 0,0:21:07.21,0:21:08.01,日文对话,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:21:08.61,0:21:14.63,日文对话,NTP,0000,0000,0000,,Сосын маған берген уәдемді орындау керектігін айтты.
Dialogue: 0,0:21:29.62,0:21:31.39,日文对话,NTP,0000,0000,0000,,Нене Кюэ
Dialogue: 0,0:21:31.61,0:21:32.65,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:21:33.69,0:21:35.56,日文对话,NTP,0000,0000,0000,,Кюэй мырза
Dialogue: 0,0:21:35.77,0:21:36.67,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:21:42.41,0:21:44.25,日文对话,NTP,0000,0000,0000,,Кешіктіргеніміз үшін кешірім сұраймыз
Dialogue: 0,0:21:44.94,0:21:48.27,日文对话,NTP,0000,0000,0000,,Киім ауыстырудың отбасылық ісі біткені ұят.
Dialogue: 0,0:21:49.99,0:21:52.02,日文对话,NTP,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:21:52.19,0:21:54.27,日文对话,NTP,0000,0000,0000,,Бірақ мен соңына дейін жеткен жоқпын.
Dialogue: 0,0:21:54.50,0:21:55.72,日文对话,NTP,0000,0000,0000,,Оған бонус берейік.
Dialogue: 0,0:21:56.99,0:22:00.92,日文对话,NTP,0000,0000,0000,,Бүгін ауа-райы тағы да жақсы, әбігер жоқ.
Dialogue: 0,0:22:03.68,0:22:07.67,日文对话,NTP,0000,0000,0000,,Тағы бір бейбіт күн болатын сияқты.
Dialogue: 0,0:23:46.34,0:23:47.71,日文对话,NTP,0000,0000,0000,,Ескерту
Dialogue: 0,0:23:47.79,0:23:49.84,日文对话,NTP,0000,0000,0000,,Бүгін жаңбыр жауып тұр.
Dialogue: 0,0:23:50.03,0:23:51.36,日文对话,NTP,0000,0000,0000,,Дене тәрбиесі жойылды
Dialogue: 0,0:23:51.51,0:23:53.05,日文对话,NTP,0000,0000,0000,,Оны өздігінен оқу уақыты ретінде пайдаланыңыз.
Dialogue: 0,0:23:53.12,0:23:54.39,日文对话,NTP,0000,0000,0000,,Ендеше, елес туралы әңгіме айтайық.
Dialogue: 0,0:23:54.92,0:23:56.45,日文对话,NTP,0000,0000,0000,,Мен елес әңгімелермен толықтай келісемін.
Dialogue: 0,0:23:56.71,0:24:00.67,日文对话,NTP,0000,0000,0000,,Өзін-өзі зерттеу уақыты мұндай нәрсені жасайтын уақыт емес.
Dialogue: 0,0:24:00.80,0:24:03.08,日文对话,NTP,0000,0000,0000,,Төраға, қорықпаңыз.
Dialogue: 0,0:24:03.26,0:24:04.60,日文对话,NTP,0000,0000,0000,,Бұл... міне, солай.
Dialogue: 0,0:24:04.74,0:24:06.18,日文对话,NTP,0000,0000,0000,,Мен үйге бара жатырмын
Dialogue: 0,0:24:06.26,0:24:08.55,日文对话,NTP,0000,0000,0000,,Тоқима-күн, қашпа.
Dialogue: 0,0:24:08.65,0:24:10.65,日文对话,NTP,0000,0000,0000,,Барлығымыз қорқынышты оқиғаларды айтайық
Dialogue: 0,0:24:11.59,0:24:13.82,日文对话,NTP,0000,0000,0000,,Келесі жолы BLOOD-C «Мегуриахит»
Dialogue: 0,0:00:11.81,0:00:14.54,JP_ED,NTP,0000,0000,0000,,Осы түнде қыдырып кету
Dialogue: 0,0:00:14.64,0:00:17.40,JP_ED,NTP,0000,0000,0000,,Мен өмір сүргім келеді, бірақ мен жоғалдым
Dialogue: 0,0:00:17.42,0:00:22.21,JP_ED,NTP,0000,0000,0000,,Қайтып оралуға болмайтын өткен және сіз білетініңізге күмәнданбайсыз ба
Dialogue: 0,0:00:23.35,0:00:26.26,JP_ED,NTP,0000,0000,0000,,Мен сенетін барлық нәрселер
Dialogue: 0,0:00:26.24,0:00:28.52,JP_ED,NTP,0000,0000,0000,,Шындықты көргім келмейтін қара күндер
Dialogue: 0,0:00:29.11,0:00:34.23,JP_ED,NTP,0000,0000,0000,,Баруға болмайтын жағдайлар қайда барарын білмей қалады
Dialogue: 0,0:00:34.56,0:00:37.07,JP_ED,NTP,0000,0000,0000,,Үміттің де жалған екенін білесің бе?
Dialogue: 0,0:00:37.31,0:00:39.52,JP_ED,NTP,0000,0000,0000,,және бұл заклинание тек құдайлардың ақиқаты болып табылады
Dialogue: 0,0:00:39.74,0:00:44.50,JP_ED,NTP,0000,0000,0000,,Қараңғылықты кесіп өт
Dialogue: 0,0:00:45.26,0:00:48.16,JP_ED,NTP,0000,0000,0000,,Шексіздік сызығы неге қан кету керек
Dialogue: 0,0:00:48.20,0:00:50.62,JP_ED,NTP,0000,0000,0000,,менің меланхолиямды көтеріп
Dialogue: 0,0:00:50.89,0:00:54.01,JP_ED,NTP,0000,0000,0000,,тезірек келдім деп айта алмаймын
Dialogue: 0,0:00:54.05,0:00:54.75,JP_ED,NTP,0000,0000,0000,,себебі мен жасаймын
Dialogue: 0,0:00:55.11,0:00:56.32,JP_ED,NTP,0000,0000,0000,,ешқашан аяқталмайды
Dialogue: 0,0:00:56.51,0:00:58.64,JP_ED,NTP,0000,0000,0000,,менің croixтегі чипсы
Dialogue: 0,0:00:58.96,0:01:01.36,JP_ED,NTP,0000,0000,0000,,бұл мен сені қалайтындықтан
Dialogue: 0,0:01:01.96,0:01:04.80,JP_ED,NTP,0000,0000,0000,,Бұл ұсыныс орындалмайды
Dialogue: 0,0:01:05.06,0:01:06.70,JP_ED,NTP,0000,0000,0000,,Қазіргі уақытта жарқыраған жарық
Dialogue: 0,0:01:06.75,0:01:10.38,JP_ED,NTP,0000,0000,0000,,Бұл менің шындықты алып жүретін соңғы күшім
Dialogue: 0,0:01:10.64,0:01:13.56,JP_ED,NTP,0000,0000,0000,,Еш ауыртпалық жоқ пайда жоқ Абсолютті әділдік
Dialogue: 0,0:01:13.61,0:01:16.47,JP_ED,NTP,0000,0000,0000,,Себебін оқысаңыз және
Dialogue: 0,0:01:16.57,0:01:18.90,JP_ED,NTP,0000,0000,0000,,Мен шамымды қойдым
Dialogue: 0,0:01:18.98,0:01:21.55,JP_ED,NTP,0000,0000,0000,,Апокалипсис біреуді білу керек
Dialogue: 0,0:01:21.79,0:01:25.08,JP_ED,NTP,0000,0000,0000,,Бұл ұсыныс өзгеріссіз қалады.
Dialogue: 0,0:01:25.11,0:01:27.49,JP_ED,NTP,0000,0000,0000,,у...
Dialogue: 0,0:22:29.12,0:22:34.65,JP_ED,NTP,0000,0000,0000,,Бұлыңғыр түнге ағып жатқан дөрекі дауыс
Dialogue: 0,0:22:34.94,0:22:40.13,JP_ED,NTP,0000,0000,0000,,Туған жерді жеңіл билеу
Dialogue: 0,0:22:40.74,0:22:43.63,JP_ED,NTP,0000,0000,0000,,Қолыңды созсаң, ол жоғалады
Dialogue: 0,0:22:43.86,0:22:46.77,JP_ED,NTP,0000,0000,0000,,Өтпелі түсте
Dialogue: 0,0:22:47.00,0:22:49.44,JP_ED,NTP,0000,0000,0000,,Көрінбейтін махаббатқа көлеңке түсіру
Dialogue: 0,0:22:49.62,0:22:52.37,JP_ED,NTP,0000,0000,0000,,Жалғыз күліңіз
Dialogue: 0,0:22:52.94,0:22:56.16,JP_ED,NTP,0000,0000,0000,,Айдың қуыс сәулесін бақылау
Dialogue: 0,0:22:56.18,0:22:59.14,JP_ED,NTP,0000,0000,0000,,Сол серпімді саусақтардың ұштарына
Dialogue: 0,0:22:59.22,0:23:03.00,JP_ED,NTP,0000,0000,0000,,Бәрі шешіліп, саған сеніп тапсырылған.
Dialogue: 0,0:23:03.97,0:23:07.38,JP_ED,NTP,0000,0000,0000,,Әй, әр жанған айғай
Dialogue: 0,0:23:07.59,0:23:13.46,JP_ED,NTP,0000,0000,0000,,Жіпсіз күй жұмаққа шақырады
Dialogue: 0,0:23:13.61,0:23:19.65,JP_ED,NTP,0000,0000,0000,,Мәңгілік естеліктер әдемі өрілгені сонша, ән салады
Dialogue: 0,0:23:19.79,0:23:24.98,JP_ED,NTP,0000,0000,0000,,Сезімімнің шықы сені іздейді
Dialogue: 0,0:23:25.32,0:23:29.66,JP_ED,NTP,0000,0000,0000,,Өлмей-ақ мына аспанды боя
Dialogue: 0,0:23:29.95,0:23:36.19,JP_ED,NTP,0000,0000,0000,,Ол жарқырай береді
Dialogue: 0,0:24:15.32,0:24:21.32,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory