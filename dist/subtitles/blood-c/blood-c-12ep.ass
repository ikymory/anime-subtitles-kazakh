Dialogue: 0,0:00:11.86,0:00:21.87,disclaimer（免责声明）,NTP,0000,0000,0000,,Бұл субтитр көзі субтитр тобы (www.kamigami.org) өндіру, жеткізу алмасуды үйрену, коммерциялық пайдалану үшін тыйым салынған
Dialogue: 0,0:00:11.86,0:00:21.87,staff（制作成员表）,NTP,0000,0000,0000,,---Құдай субтитрлері---
Dialogue: 0,0:00:11.86,0:00:21.87,staff（制作成员表）,NTP,0000,0000,0000,,P    &
Dialogue: 0,0:00:28.53,0:00:31.44,JP（日文对话）,NTP,0000,0000,0000,,Бұл күйде көріну дұрыс па?
Dialogue: 0,0:00:31.97,0:00:32.41,JP（日文对话）,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:00:33.82,0:00:37.36,JP（日文对话）,NTP,0000,0000,0000,,Міне, осы жерге жетсек, эй.
Dialogue: 0,0:00:38.61,0:00:39.43,JP（日文对话）,NTP,0000,0000,0000,,Сая
Dialogue: 0,0:00:42.51,0:00:45.51,JP（日文对话）,NTP,0000,0000,0000,,Фумито-сан
Dialogue: 0,0:00:46.33,0:00:48.38,JP（日文对话）,NTP,0000,0000,0000,,Менің ойымша, ол қайтып кетті
Dialogue: 0,0:00:48.50,0:00:51.27,JP（日文对话）,NTP,0000,0000,0000,,Кофе ішсем де, уақытында дайындай алмаймын.
Dialogue: 0,0:00:54.50,0:00:55.62,JP（日文对话）,NTP,0000,0000,0000,,№.
Dialogue: 0,0:00:56.00,0:00:58.16,JP（日文对话）,NTP,0000,0000,0000,,Не дұрыс болмады?
Dialogue: 0,0:00:58.18,0:00:59.89,JP（日文对话）,NTP,0000,0000,0000,,Түсініспеушілік болды дейсіз бе?
Dialogue: 0,0:00:59.94,0:01:04.11,JP（日文对话）,NTP,0000,0000,0000,,Бұл шынымен де бір нәрсе. Қараңыз, бірдеңе дұрыс емес. Жаспын деп айту дұрыс емес деп ойлаймын.
Dialogue: 0,0:01:04.14,0:01:06.18,JP（日文对话）,NTP,0000,0000,0000,,Мен жаспын, сондықтан қайталап көргім келеді.
Dialogue: 0,0:01:06.46,0:01:09.30,JP（日文对话）,NTP,0000,0000,0000,,Байқадым, мұндай ойлау тәсілі бар.
Dialogue: 0,0:01:09.48,0:01:10.68,JP（日文对话）,NTP,0000,0000,0000,,...
Dialogue: 0,0:01:12.60,0:01:16.89,JP（日文对话）,NTP,0000,0000,0000,,Мен қазір жұмыстан шығамын, бірақ осы уақытқа дейін сыртқы түрім үшін төлеуім керек.
Dialogue: 0,0:01:17.25,0:01:20.25,JP（日文对话）,NTP,0000,0000,0000,,Сіздің әрекеттеріңіз келісім-шартты толығымен бұзу болады.
Dialogue: 0,0:01:20.36,0:01:21.02,JP（日文对话）,NTP,0000,0000,0000,,Тітіркендіргіш
Dialogue: 0,0:01:21.17,0:01:25.12,JP（日文对话）,NTP,0000,0000,0000,,Бұл да жастықтың белгісі деп ойлаймын.
Dialogue: 0,0:01:28.69,0:01:34.20,JP（日文对话）,NTP,0000,0000,0000,,Академияда бола алмағандықтан уақытым жоқ.
Dialogue: 0,0:01:34.99,0:01:37.56,JP（日文对话）,NTP,0000,0000,0000,,Сол қыңыр қарттардың кесірінен
Dialogue: 0,0:01:37.93,0:01:42.28,JP（日文对话）,NTP,0000,0000,0000,,Сонымен қатар жаңа зерттеушілер бірінен соң бірі шығып жатыр.
Dialogue: 0,0:01:43.14,0:01:47.02,JP（日文对话）,NTP,0000,0000,0000,,Мені бәрі ақымақ әйел дейді.
Dialogue: 0,0:01:47.53,0:01:48.78,JP（日文对话）,NTP,0000,0000,0000,,қосымша
Dialogue: 0,0:01:48.51,0:01:49.67,jp2,NTP,0000,0000,0000,,Бұл қандай жаман иіс?
Dialogue: 0,0:01:50.72,0:01:52.50,JP（日文对话）,NTP,0000,0000,0000,,Саяны жібер.
Dialogue: 0,0:02:10.38,0:02:14.07,JP（日文对话）,NTP,0000,0000,0000,,Сайо, мен саған тамақ ұсынайын деп ойладым.
Dialogue: 0,0:02:16.42,0:02:18.62,JP（日文对话）,NTP,0000,0000,0000,,Тамағың өзіңе тән болады.
Dialogue: 0,0:02:19.41,0:02:22.29,JP（日文对话）,NTP,0000,0000,0000,,Бұл елде бұрыннан бар біртүрлі нәрсе.
Dialogue: 0,0:02:23.11,0:02:29.23,JP（日文对话）,NTP,0000,0000,0000,,Оның сыртқы келбеті адамдардікінен алшақ, алыс болғандықтан, оның табиғаттан тыс күштері өте жоғары.
Dialogue: 0,0:02:30.14,0:02:32.36,JP（日文对话）,NTP,0000,0000,0000,,Ал мен адамдарды жақсы көремін.
Dialogue: 0,0:02:33.84,0:02:36.80,JP（日文对话）,NTP,0000,0000,0000,,Мемлекет оны аса құпия құжат ретінде басқарады
Dialogue: 0,0:02:37.27,0:02:40.10,JP（日文对话）,NTP,0000,0000,0000,,Оны жоғалту керек деп арнайы жазылған ештеңе жоқ.
Dialogue: 0,0:02:41.75,0:02:43.13,JP（日文对话）,NTP,0000,0000,0000,,«Шушокүмен» атауы
Dialogue: 0,0:02:44.74,0:02:45.87,JP（日文对话）,NTP,0000,0000,0000,,Бұл ештеңе емес.
Dialogue: 0,0:02:46.69,0:02:50.56,JP（日文对话）,NTP,0000,0000,0000,,Ел басындағы бақыланбайтын жанмен мәміле жасадым.
Dialogue: 0,0:02:51.17,0:02:54.63,JP（日文对话）,NTP,0000,0000,0000,,Адамдардың белгілі бір санын жеу құқығына айырбастау.
Dialogue: 0,0:02:54.85,0:02:57.01,JP（日文对话）,NTP,0000,0000,0000,,Басқа ешкімге шабуыл жасамаңыз.
Dialogue: 0,0:02:57.40,0:02:59.48,JP（日文对话）,NTP,0000,0000,0000,,Сол қызыл түсті тағамды алды
Dialogue: 0,0:02:59.99,0:03:00.98,JP（日文对话）,NTP,0000,0000,0000,,Қалай
Dialogue: 0,0:03:01.98,0:03:04.96,JP（日文对话）,NTP,0000,0000,0000,,Ежелден келе жатқан жат нәрселерге
Dialogue: 0,0:03:05.50,0:03:08.50,JP（日文对话）,NTP,0000,0000,0000,,Дұрыс, оны көне нәрсе дейік.
Dialogue: 0,0:03:08.99,0:03:13.22,JP（日文对话）,NTP,0000,0000,0000,,Олармен қызыл тамақ жемейміз деп баяғыда келісімге келген едік.
Dialogue: 0,0:03:14.07,0:03:16.27,JP（日文对话）,NTP,0000,0000,0000,,Қазіргі уақытта оған қатысқандар
Dialogue: 0,0:03:16.71,0:03:20.52,JP（日文对话）,NTP,0000,0000,0000,,Олар ежелгі заттардан шынайы қорқуды түсінбейді.
Dialogue: 0,0:03:21.33,0:03:22.37,JP（日文对话）,NTP,0000,0000,0000,,Абдол мырза
Dialogue: 0,0:03:22.99,0:03:24.80,JP（日文对话）,NTP,0000,0000,0000,,Жоқ, бұл қорқынышты.
Dialogue: 0,0:03:26.03,0:03:30.93,JP（日文对话）,NTP,0000,0000,0000,,Дәл қорқатындықтан, кейбір адамдар бұл күшке өздері ие болғысы келеді.
Dialogue: 0,0:03:31.34,0:03:34.97,JP（日文对话）,NTP,0000,0000,0000,,Менен сол лицензияны мұны істеу үшін пайдалана аламын ба деп сұрады.
Dialogue: 0,0:03:35.31,0:03:36.04,JP（日文对话）,NTP,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,0:03:36.08,0:03:39.75,JP（日文对话）,NTP,0000,0000,0000,,Бірақ менде барлық карталар бар.
Dialogue: 0,0:03:40.84,0:03:43.78,JP（日文对话）,NTP,0000,0000,0000,,Алдымен сені қолға түсіргісі келген адамды кездестірдім.
Dialogue: 0,0:03:44.46,0:03:48.48,JP（日文对话）,NTP,0000,0000,0000,,Ал Сая мен сені кездестірдім.
Dialogue: 0,0:03:51.75,0:03:55.76,JP（日文对话）,NTP,0000,0000,0000,,Сіз адам емес, өз түріңіздің қанымен қоректенесіз.
Dialogue: 0,0:03:56.39,0:04:01.76,JP（日文对话）,NTP,0000,0000,0000,,Сондықтан да ертедегілер қорқатын ерекше болмыс.
Dialogue: 0,0:04:03.12,0:04:06.87,JP（日文对话）,NTP,0000,0000,0000,,Саған тамақ пен тамақтанатын орын дайындап берейік.
Dialogue: 0,0:04:07.78,0:04:09.78,JP（日文对话）,NTP,0000,0000,0000,,Маған ауасы таза жерлер ұнайды.
Dialogue: 0,0:04:10.58,0:04:15.52,JP（日文对话）,NTP,0000,0000,0000,,Сырттан адамдар кірмейтін, басқаруға оңай тыныш жер.
Dialogue: 0,0:04:15.99,0:04:18.14,JP（日文对话）,NTP,0000,0000,0000,,Сіз не істемексіз?
Dialogue: 0,0:04:18.26,0:04:23.56,JP（日文对话）,NTP,0000,0000,0000,,Жасағым келетін және растағым келетін нәрселер бар.
Dialogue: 0,0:04:24.66,0:04:25.40,JP（日文对话）,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:04:25.96,0:04:29.94,JP（日文对话）,NTP,0000,0000,0000,,Маған адамдардың өзгеретінін үйреткеніңізді қалаймын.
Dialogue: 0,0:04:30.73,0:04:34.59,JP（日文对话）,NTP,0000,0000,0000,,Алайда өзгеретін және өзгермейтін нәрселер бар.
Dialogue: 0,0:04:36.06,0:04:38.94,JP（日文对话）,NTP,0000,0000,0000,,Не болса да өзгертуге болмайтын негізгі бөліктер
Dialogue: 0,0:04:39.74,0:04:44.26,JP（日文对话）,NTP,0000,0000,0000,,Мысалы, сіздің қабілетіңіз немесе күшіңіз сіздікінен өзгеше.
Dialogue: 0,0:04:44.89,0:04:46.75,JP（日文对话）,NTP,0000,0000,0000,,Оны сол жерде қалдырыңыз
Dialogue: 0,0:04:47.06,0:04:51.31,JP（日文对话）,NTP,0000,0000,0000,,Менің тәрбием де, айналам да, тіпті естеліктерім де өзгерсе ше?
Dialogue: 0,0:04:52.24,0:04:57.98,JP（日文对话）,NTP,0000,0000,0000,,Егер бұл өзгерсе, ол бұрынғыдай адам болып қала ма?
Dialogue: 0,0:04:58.82,0:05:02.84,JP（日文对话）,NTP,0000,0000,0000,,Біз бірдей нәрсені ойлап, бірдей әрекет етеміз бе?
Dialogue: 0,0:05:04.09,0:05:07.04,JP（日文对话）,NTP,0000,0000,0000,,Әлде негіздері сол қалпында қала ма?
Dialogue: 0,0:05:07.55,0:05:12.35,JP（日文对话）,NTP,0000,0000,0000,,Жоқ. Бұған дейін түбегейлі басқа нәрсе бар ма?
Dialogue: 0,0:05:13.86,0:05:16.36,JP（日文对话）,NTP,0000,0000,0000,,Сонымен не?
Dialogue: 0,0:05:19.34,0:05:23.82,JP（日文对话）,NTP,0000,0000,0000,,Оның көздері жанып кетті. Бұл жерден қалай кетемін деп ойлап отыр ма деп ойлаймын.
Dialogue: 0,0:05:25.45,0:05:30.14,JP（日文对话）,NTP,0000,0000,0000,,Ол менің әскерилермен соғысқанда да өте әдемі болатын.
Dialogue: 0,0:05:33.73,0:05:36.74,JP（日文对话）,NTP,0000,0000,0000,,Мен өзгермеймін
Dialogue: 0,0:05:38.75,0:05:42.28,JP（日文对话）,NTP,0000,0000,0000,,Олай болса бірге көрейік.
Dialogue: 0,0:05:45.03,0:05:50.82,JP（日文对话）,NTP,0000,0000,0000,,Бұл тестілеу үшін қойылған сахна мен актерлер ме?
Dialogue: 0,0:05:51.10,0:05:53.48,JP（日文对话）,NTP,0000,0000,0000,,Иә, сіз үшін.
Dialogue: 0,0:05:54.32,0:05:56.07,JP（日文对话）,NTP,0000,0000,0000,,Сіз өзгермеймін дедіңіз
Dialogue: 0,0:05:56.71,0:06:00.24,JP（日文对话）,NTP,0000,0000,0000,,Мен өзгертсеңіз жақсы болар еді деп ойладым.
Dialogue: 0,0:06:00.94,0:06:05.36,JP（日文对话）,NTP,0000,0000,0000,,Ал егер айта алатын болсам, мен де жеңімпаз бен жеңілгенді анықтайтынымды айттым.
Dialogue: 0,0:06:08.10,0:06:14.08,JP（日文对话）,NTP,0000,0000,0000,,Жеңімпазды марапаттау, жеңілгенді жазалау
Dialogue: 0,0:06:15.41,0:06:19.31,JP（日文对话）,NTP,0000,0000,0000,,Бұл жеткілікті. Эй, не болып жатыр? Мен Дайданенді көргім келеді.
Dialogue: 0,0:06:18.60,0:06:19.30,jp2,NTP,0000,0000,0000,,Оған не болды?
Dialogue: 0,0:06:19.46,0:06:23.23,JP（日文对话）,NTP,0000,0000,0000,,Мен кейбір естеліктерімді қалпына келтірдім, сондықтан "Соңын" көргім келеді
Dialogue: 0,0:06:23.46,0:06:26.21,JP（日文对话）,NTP,0000,0000,0000,,Демек, біз де жақсымыз, солай ма?
Dialogue: 0,0:06:27.08,0:06:32.92,JP（日文对话）,NTP,0000,0000,0000,,Дұрыс. Актерлік өнерге үйрене алмай жүрген актерлердің сахнадан түсуін сұрайық.
Dialogue: 0,0:06:44.78,0:06:47.53,JP（日文对话）,NTP,0000,0000,0000,,Ей, мен қарғыс амулетін киіп жүрмін.
Dialogue: 0,0:06:48.27,0:06:52.83,JP（日文对话）,NTP,0000,0000,0000,,Иә, бірақ сіз өлгеннен кейін оған бергеніңіз жалған, сондықтан ол жұмыс істемейді.
Dialogue: 0,0:07:06.12,0:07:07.27,JP（日文对话）,NTP,0000,0000,0000,,Жоқ, жоқ
Dialogue: 0,0:07:20.85,0:07:24.07,JP（日文对话）,NTP,0000,0000,0000,,Жібер, жібер
Dialogue: 0,0:07:30.83,0:07:35.29,JP（日文对话）,NTP,0000,0000,0000,,Ауырды, ауырады, тоқтат, кешір мені, кешір мені.
Dialogue: 0,0:07:44.47,0:07:50.53,JP（日文对话）,NTP,0000,0000,0000,,Сіз мұны сатқындық деп ойладыңыз, сондықтан сиқыр басынан жалған болды.
Dialogue: 0,0:07:51.71,0:07:52.87,JP（日文对话）,NTP,0000,0000,0000,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:09:39.41,0:09:41.58,JP（日文对话）,NTP,0000,0000,0000,,Шынында да, кез келген қару жарайды.
Dialogue: 0,0:09:41.71,0:09:47.45,JP（日文对话）,NTP,0000,0000,0000,,Иә, бұл қылыш ғибадатхананың қызы болғандықтан. Бұл жай ғана параметрді түсіну мәселесі.
Dialogue: 0,0:09:48.10,0:09:51.25,JP（日文对话）,NTP,0000,0000,0000,,Қанды көп төгетін нәрсенің бәрі жақсы.
Dialogue: 0,0:10:16.76,0:10:19.71,JP（日文对话）,NTP,0000,0000,0000,,Маған көмектес, көмектес
Dialogue: 0,0:10:20.67,0:10:22.58,JP（日文对话）,NTP,0000,0000,0000,,Тіпті тәтті, бал иісі бар дене жылуы
Dialogue: 0,0:10:22.70,0:10:26.07,JP（日文对话）,NTP,0000,0000,0000,,Эй, маған көмектесші.
Dialogue: 0,0:10:54.31,0:10:57.56,JP（日文对话）,NTP,0000,0000,0000,,Бүгін таңертең Саяның қанын көп ішіп алған шығармын.
Dialogue: 0,0:10:57.89,0:11:00.29,JP（日文对话）,NTP,0000,0000,0000,,Мен сені қайтып көргім келеді, Юйоши.
Dialogue: 0,0:11:01.15,0:11:02.91,JP（日文对话）,NTP,0000,0000,0000,,Біліп, берген шығар.
Dialogue: 0,0:11:04.01,0:11:07.02,JP（日文对话）,NTP,0000,0000,0000,,Сен де оралдың ба, Сая?
Dialogue: 0,0:11:07.81,0:11:10.40,JP（日文对话）,NTP,0000,0000,0000,,Сіз оны қазір түсіне аласыз.
Dialogue: 0,0:11:10.51,0:11:11.84,JP（日文对话）,NTP,0000,0000,0000,,Ол кім?
Dialogue: 0,0:11:12.38,0:11:14.37,JP（日文对话）,NTP,0000,0000,0000,,Ескі, жартысы.
Dialogue: 0,0:11:14.70,0:11:19.34,JP（日文对话）,NTP,0000,0000,0000,,Иә, ол адамдар мен ежелгі заттардың өзара әрекеттесуінің нәтижесінде дүниеге келген.
Dialogue: 0,0:11:20.18,0:11:25.16,JP（日文对话）,NTP,0000,0000,0000,,Міне, сондықтан сіздің адам кейпіңізде адамдардан асып түсетін күшіңіз бар.
Dialogue: 0,0:11:25.51,0:11:27.91,JP（日文对话）,NTP,0000,0000,0000,,Мен саған бәрінен де жақынмын.
Dialogue: 0,0:11:29.31,0:11:33.02,JP（日文对话）,NTP,0000,0000,0000,,Жалған естеліктерге байланысты ол менің әкем деп сенгендіктен ғана емес.
Dialogue: 0,0:11:33.50,0:11:37.60,JP（日文对话）,NTP,0000,0000,0000,,Мүмкін сондықтан да сен оған көзсіз таңдандың.
Dialogue: 0,0:11:38.47,0:11:43.19,JP（日文对话）,NTP,0000,0000,0000,,Сенің қаның көне дүниелерді пайдалана алады, егер сіз оған тұспал келтірсеңіз.
Dialogue: 0,0:11:43.70,0:11:46.07,JP（日文对话）,NTP,0000,0000,0000,,Осы уақытқа дейін пайда болған көне заттар
Dialogue: 0,0:11:46.27,0:11:49.13,JP（日文对话）,NTP,0000,0000,0000,,Сіздің қаныңыз ежелгі заттарды басқарды.
Dialogue: 0,0:11:50.93,0:11:55.74,JP（日文对话）,NTP,0000,0000,0000,,Мен бұл спектакльді бастағаннан бері көп жерде көріндім.
Dialogue: 0,0:11:56.65,0:11:57.97,JP（日文对话）,NTP,0000,0000,0000,,Сіз шабуылдаған адам
Dialogue: 0,0:12:23.36,0:12:27.33,JP（日文对话）,NTP,0000,0000,0000,,Мен оны басқара алсам, неге басқаларға жеуге рұқсат еттім?
Dialogue: 0,0:12:27.37,0:12:30.43,JP（日文对话）,NTP,0000,0000,0000,,Негізгі құрам тірі болса, тиімдірек болады.
Dialogue: 0,0:12:30.62,0:12:34.69,JP（日文对话）,NTP,0000,0000,0000,,Дегенмен, қосымша құралдарды пайдалансаңыз да, ешқандай проблема болмайды.
Dialogue: 0,0:12:35.80,0:12:38.15,JP（日文对话）,NTP,0000,0000,0000,,Неге бұл бетті жасайсың?
Dialogue: 0,0:12:38.60,0:12:41.87,JP（日文对话）,NTP,0000,0000,0000,,Адам баласы сен үшін маңызды емес.
Dialogue: 0,0:12:42.51,0:12:45.51,JP（日文对话）,NTP,0000,0000,0000,,Бір түрге де, тамаққа да жатпайды.
Dialogue: 0,0:12:45.59,0:12:47.88,JP（日文对话）,NTP,0000,0000,0000,,Адаммен қоректенуге болмайды.
Dialogue: 0,0:12:47.90,0:12:48.86,JP（日文对话）,NTP,0000,0000,0000,,Бұл салдар.
Dialogue: 0,0:12:49.33,0:12:52.73,JP（日文对话）,NTP,0000,0000,0000,,Мен емес, бірдеңе шақырды.
Dialogue: 0,0:12:53.94,0:12:57.15,JP（日文对话）,NTP,0000,0000,0000,,Мен оны жалған жадты жасау үшін пайдаландым.
Dialogue: 0,0:12:57.85,0:13:00.70,JP（日文对话）,NTP,0000,0000,0000,,Сіз адамдарды өлтіре алмайсыз, сондықтан оларды қорғаңыз.
Dialogue: 0,0:13:01.34,0:13:06.26,JP（日文对话）,NTP,0000,0000,0000,,Мағынасы кім? Жоқ, кіммен келісімшарт жасалғаны қызық.
Dialogue: 0,0:13:07.20,0:13:08.74,JP（日文对话）,NTP,0000,0000,0000,,Сондықтан мен уәде бердім
Dialogue: 0,0:13:09.12,0:13:13.18,JP（日文对话）,NTP,0000,0000,0000,,Егер жеңсең, мен саған адамдарды өлтіруге рұқсат етемін.
Dialogue: 0,0:13:17.46,0:13:18.84,JP（日文对话）,NTP,0000,0000,0000,,Егер мен жеңсем
Dialogue: 0,0:13:27.82,0:13:30.23,JP（日文对话）,NTP,0000,0000,0000,,Адам кейпімен жеңе алмайсың ғой.
Dialogue: 0,0:13:30.95,0:13:31.62,JP（日文对话）,NTP,0000,0000,0000,,Юйоши
Dialogue: 0,0:14:43.47,0:14:47.02,JP（日文对话）,NTP,0000,0000,0000,,Оны менің қаным басқарады. Қайтып келу.
Dialogue: 0,0:15:07.42,0:15:08.14,JP（日文对话）,NTP,0000,0000,0000,,Артыңа шегін!
Dialogue: 0,0:15:12.19,0:15:13.03,JP（日文对话）,NTP,0000,0000,0000,,Сая
Dialogue: 0,0:15:13.05,0:15:13.69,JP（日文对话）,NTP,0000,0000,0000,,Юйоши
Dialogue: 0,0:15:41.09,0:15:45.19,JP（日文对话）,NTP,0000,0000,0000,,Жарықтың ұшын таптың ба?
Dialogue: 0,0:15:53.72,0:15:55.77,JP（日文对话）,NTP,0000,0000,0000,,Біз бірінші рет кездестік
Dialogue: 0,0:15:57.93,0:16:01.14,JP（日文对话）,NTP,0000,0000,0000,,Өзіңізге жақын нәрсе
Dialogue: 0,0:16:02.60,0:16:03.92,JP（日文对话）,NTP,0000,0000,0000,,Мен бақытты болдым
Dialogue: 0,0:16:05.28,0:16:06.70,JP（日文对话）,NTP,0000,0000,0000,,Бірге болыңыз
Dialogue: 0,0:16:09.81,0:16:13.96,JP（日文对话）,NTP,0000,0000,0000,,Бұл өтірік емес.
Dialogue: 0,0:16:15.67,0:16:17.05,JP（日文对话）,NTP,0000,0000,0000,,Саған үйрететін кез келді
Dialogue: 0,0:16:19.49,0:16:20.86,JP（日文对话）,NTP,0000,0000,0000,,Бұл ауыр болды.
Dialogue: 0,0:16:23.92,0:16:25.30,JP（日文对话）,NTP,0000,0000,0000,,Тіпті тәтті, бал иісі бар дене жылуы
Dialogue: 0,0:16:47.70,0:16:49.51,JP（日文对话）,NTP,0000,0000,0000,,Мені өлтіргің келе ме?
Dialogue: 0,0:16:50.30,0:16:53.97,JP（日文对话）,NTP,0000,0000,0000,,Бірақ, әлі ол уақыт емес, Сая.
Dialogue: 0,0:17:09.61,0:17:10.79,JP（日文对话）,NTP,0000,0000,0000,,Менің қашып кетуіме жол берме
Dialogue: 0,0:17:17.71,0:17:18.66,JP（日文对话）,NTP,0000,0000,0000,,Сая
Dialogue: 0,0:17:35.04,0:17:35.78,JP（日文对话）,NTP,0000,0000,0000,,Бұл сенсің ғой, иә?
Dialogue: 0,0:17:36.42,0:17:37.42,JP（日文对话）,NTP,0000,0000,0000,,Неліктен?
Dialogue: 0,0:17:38.28,0:17:40.69,JP（日文对话）,NTP,0000,0000,0000,,Бұл жай ғана әрекет болды, бірақ мен мұны істеп жатқанда,
Dialogue: 0,0:17:40.88,0:17:46.61,JP（日文对话）,NTP,0000,0000,0000,,Мүмкін мен сені шынымен сүйкімді деп ойлаған шығармын.
Dialogue: 0,0:17:47.44,0:17:48.97,JP（日文对话）,NTP,0000,0000,0000,,Бұл мен емес
Dialogue: 0,0:17:50.74,0:17:55.65,JP（日文对话）,NTP,0000,0000,0000,,Бірақ бұл да сенің бір бөлшегің екеніне сенімдімін.
Dialogue: 0,0:17:56.01,0:17:56.73,JP（日文对话）,NTP,0000,0000,0000,,Сая
Dialogue: 0,0:18:04.30,0:18:05.10,JP（日文对话）,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,0:18:11.73,0:18:13.40,JP（日文对话）,NTP,0000,0000,0000,,Уәделер әртүрлі, солай емес пе?
Dialogue: 0,0:18:13.73,0:18:15.30,JP（日文对话）,NTP,0000,0000,0000,,Біреу маған көмектесуін өтінемін
Dialogue: 0,0:18:26.06,0:18:27.45,JP（日文对话）,NTP,0000,0000,0000,,Маған көлік беріңіз
Dialogue: 0,0:19:03.48,0:19:04.62,JP（日文对话）,NTP,0000,0000,0000,,Тоқта
Dialogue: 0,0:19:04.89,0:19:07.06,JP（日文对话）,NTP,0000,0000,0000,,Тоқта
Dialogue: 0,0:19:20.86,0:19:24.54,JP（日文对话）,NTP,0000,0000,0000,,Соңында сіз жалғыз басты рөлде қалдыңыз.
Dialogue: 0,0:19:24.60,0:19:26.56,JP（日文对话）,NTP,0000,0000,0000,,Мен саясаткер болғым келеді
Dialogue: 0,0:19:26.75,0:19:28.87,JP（日文对话）,NTP,0000,0000,0000,,Менің ойымша, ол Токионың губернаторы болған.
Dialogue: 0,0:19:29.06,0:19:33.37,JP（日文对话）,NTP,0000,0000,0000,,Сондықтан осы жасымда да жоғары сынып оқушыларына еліктедім.
Dialogue: 0,0:19:33.64,0:19:36.06,JP（日文对话）,NTP,0000,0000,0000,,Көмегіңмен.
Dialogue: 0,0:20:32.56,0:20:34.54,JP（日文对话）,NTP,0000,0000,0000,,Сіз маған әлі айтқан жоқсыз.
Dialogue: 0,0:20:35.23,0:20:37.16,JP（日文对话）,NTP,0000,0000,0000,,Сіздің сүйікті сыйлық
Dialogue: 0,0:20:37.22,0:20:40.20,JP（日文对话）,NTP,0000,0000,0000,,Жемнің қанынан жасалғандықтан дәмді болса керек.
Dialogue: 0,0:20:40.32,0:20:44.30,JP（日文对话）,NTP,0000,0000,0000,,Бұл адамның ішкі мүшелерінің сезіміне ұқсас.
Dialogue: 0,0:20:45.04,0:20:49.12,JP（日文对话）,NTP,0000,0000,0000,,Егер сіз бір күні адамдарды өлтіре алсаңыз, шынайы нәрсенің дәмін татасыз.
Dialogue: 0,0:20:49.33,0:20:50.95,JP（日文对话）,NTP,0000,0000,0000,,Жақында кездескенше Сайо
Dialogue: 0,0:21:55.66,0:21:58.51,JP（日文对话）,NTP,0000,0000,0000,,Мен ол кісінің қолына түсер алдында дұға еттім.
Dialogue: 0,0:21:59.15,0:22:02.03,JP（日文对话）,NTP,0000,0000,0000,,Саяның өзі болып қала беруі
Dialogue: 0,0:22:03.07,0:22:04.59,JP（日文对话）,NTP,0000,0000,0000,,Бұл орындалғанымен
Dialogue: 0,0:22:04.85,0:22:06.65,JP（日文对话）,NTP,0000,0000,0000,,Келесі тілек үшін
Dialogue: 0,0:22:07.82,0:22:09.52,JP（日文对话）,NTP,0000,0000,0000,,Барайық па, Сая?
Dialogue: 0,0:22:10.41,0:22:12.70,JP（日文对话）,NTP,0000,0000,0000,,Бірақ бұл тілек
Dialogue: 0,0:22:27.61,0:22:33.54,JP_ED,NTP,0000,0000,0000,,Бұлыңғыр түнге ағып жатқан дөрекі дауыс
Dialogue: 0,0:22:33.68,0:22:39.31,JP_ED,NTP,0000,0000,0000,,Туған жерді жеңіл билеу
Dialogue: 0,0:22:39.56,0:22:42.72,JP_ED,NTP,0000,0000,0000,,Қолыңызды созсаңыз, ол жоғалады
Dialogue: 0,0:22:42.82,0:22:45.44,JP_ED,NTP,0000,0000,0000,,Өтпелі түсте
Dialogue: 0,0:22:45.61,0:22:48.30,JP_ED,NTP,0000,0000,0000,,Көрінбейтін махаббатқа көлеңке түсіру
Dialogue: 0,0:22:48.37,0:22:51.06,JP_ED,NTP,0000,0000,0000,,Жалғыз күліңіз
Dialogue: 0,0:22:51.88,0:22:55.01,JP_ED,NTP,0000,0000,0000,,Айдың қуыс сәулесін бақылау
Dialogue: 0,0:22:55.06,0:22:58.03,JP_ED,NTP,0000,0000,0000,,Сол серпімді саусақтардың ұштарына
Dialogue: 0,0:22:58.13,0:23:02.32,JP_ED,NTP,0000,0000,0000,,Бәрі шешіліп, саған сеніп тапсырылған.
Dialogue: 0,0:23:02.42,0:23:05.75,JP_ED,NTP,0000,0000,0000,,Әй, әр жанған айғай
Dialogue: 0,0:23:06.40,0:23:11.75,JP_ED,NTP,0000,0000,0000,,Есілмес әуен жұмаққа шақырады
Dialogue: 0,0:23:12.27,0:23:18.42,JP_ED,NTP,0000,0000,0000,,Мәңгілік естеліктердің бір-бірімен әдемі өрілгені сонша, олар ән салады
Dialogue: 0,0:23:18.52,0:23:24.00,JP_ED,NTP,0000,0000,0000,,Сезімімнің шықы сені іздейді
Dialogue: 0,0:23:24.07,0:23:28.71,JP_ED,NTP,0000,0000,0000,,Өлмей-ақ мына аспанды боя
Dialogue: 0,0:23:28.79,0:23:35.08,JP_ED,NTP,0000,0000,0000,,Ол жарқырай береді
Dialogue: 0,0:23:36.58,0:23:42.58,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory