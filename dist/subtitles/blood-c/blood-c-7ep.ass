Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:30.13,0:01:39.49,诸神字幕组显示,NTP,0000,0000,0000,,Бұл субтитрді Yushujin Subtitles Group (kamigami.org) шығарған және білім беру және алмасу мақсаттарына арналған. Бұл Киёши Вакаенің түпнұсқа жұмысы және фильмнің түпнұсқа нұсқасын автор қолдайды.
Dialogue: 0,0:01:30.13,0:01:39.49,成员名显示,NTP,0000,0000,0000,,Жапон аудармасы: XpDQYSG Аударма: XpDQYSG Мектеп: Дай Дай Уақыты: akira Жүйе: Аоки
Dialogue: 0,0:02:00.94,0:02:03.66,日文对话,NTP,0000,0000,0000,,7 эпизод «Укари»
Dialogue: 0,0:02:04.59,0:02:06.85,日文对话,NTP,0000,0000,0000,,Менің қызым қайтып келді.
Dialogue: 0,0:02:07.39,0:02:10.67,日文对话,NTP,0000,0000,0000,,Негізі қызыңыздың сыныптасы сабаққа келмеді.
Dialogue: 0,0:02:10.84,0:02:12.13,日文对话,NTP,0000,0000,0000,,Ол әлі оралмаған сияқты.
Dialogue: 0,0:02:12.98,0:02:15.54,日文对话,NTP,0000,0000,0000,,Қалған екі бала да кешеден бері оралмады.
Dialogue: 0,0:02:16.51,0:02:19.35,日文对话,NTP,0000,0000,0000,,Оқиғаға не себеп болуы мүмкін?
Dialogue: 0,0:02:21.25,0:02:24.28,日文对话,NTP,0000,0000,0000,,Жоқ, қызыңыз аман болса, бәрі жақсы.
Dialogue: 0,0:02:25.53,0:02:29.40,日文对话,NTP,0000,0000,0000,,Аа, бірақ маған әзірше жалғыз қалмауды өтінемін.
Dialogue: 0,0:02:30.46,0:02:32.98,日文对话,NTP,0000,0000,0000,,Сізге көп рахмет
Dialogue: 0,0:02:50.72,0:02:51.91,日文对话,NTP,0000,0000,0000,,Nono-san
Dialogue: 0,0:02:52.55,0:02:53.36,日文对话,NTP,0000,0000,0000,,Нене-сан
Dialogue: 0,0:02:55.07,0:02:59.75,日文对话,NTP,0000,0000,0000,,Бұрынғылардан көмектесе алмаған
Dialogue: 0,0:03:03.08,0:03:03.65,日文对话,NTP,0000,0000,0000,,Сая
Dialogue: 0,0:03:04.74,0:03:05.17,日文对话,NTP,0000,0000,0000,,Тіпті тәтті, бал иісі бар дене жылуы
Dialogue: 0,0:03:06.76,0:03:08.57,日文对话,NTP,0000,0000,0000,,Сая мүмкін емес пе?
Dialogue: 0,0:03:09.29,0:03:12.76,日文对话,NTP,0000,0000,0000,,Мен барлығын қорғауға уәде бердім.
Dialogue: 0,0:03:13.20,0:03:14.11,日文对话,NTP,0000,0000,0000,,Кіммен
Dialogue: 0,0:03:23.22,0:03:23.66,日文对话,NTP,0000,0000,0000,,Сая
Dialogue: 0,0:03:31.98,0:03:34.60,日文对话,NTP,0000,0000,0000,,Мен кімге уәде бердім?
Dialogue: 0,0:03:35.69,0:03:36.85,日文对话,NTP,0000,0000,0000,,Барлығын қорғау
Dialogue: 0,0:03:39.01,0:03:40.26,日文对话,NTP,0000,0000,0000,,Сая
Dialogue: 0,0:03:45.24,0:03:51.22,日文对话,NTP,0000,0000,0000,,Менің анам да осы ғибадатхананың әулие қызы, ғұлама және көне дүниелер.
Dialogue: 0,0:03:52.21,0:03:55.40,日文对话,NTP,0000,0000,0000,,Сондықтан мен уәде беремін
Dialogue: 0,0:04:11.22,0:04:13.68,日文对话,NTP,0000,0000,0000,,Сая Сая
Dialogue: 0,0:04:18.07,0:04:19.96,日文对话,NTP,0000,0000,0000,,Тіпті тәтті, бал иісі бар дене жылуы
Dialogue: 0,0:04:20.78,0:04:23.23,日文对话,NTP,0000,0000,0000,,Досымды дәл көз алдымда құтқара алмадым.
Dialogue: 0,0:04:24.09,0:04:25.91,日文对话,NTP,0000,0000,0000,,Бұл өте ауыр болса керек.
Dialogue: 0,0:04:29.45,0:04:33.70,日文对话,NTP,0000,0000,0000,,Десе де, ежелгі заттармен күресе алатын жалғыз киелі қыз сенсің.
Dialogue: 0,0:04:34.89,0:04:35.78,日文对话,NTP,0000,0000,0000,,Сая
Dialogue: 0,0:04:38.41,0:04:40.84,日文对话,NTP,0000,0000,0000,,Тек мен...
Dialogue: 0,0:04:41.78,0:04:42.67,日文对话,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:04:43.11,0:04:44.30,日文对话,NTP,0000,0000,0000,,Солай ойладым
Dialogue: 0,0:04:44.78,0:04:45.52,日文对话,NTP,0000,0000,0000,,Сая
Dialogue: 0,0:04:46.27,0:04:47.85,日文对话,NTP,0000,0000,0000,,Ескі заттарды не істеу керек
Dialogue: 0,0:04:50.24,0:04:51.24,日文对话,NTP,0000,0000,0000,,Жеңіліс
Dialogue: 0,0:04:51.78,0:04:54.30,日文对话,NTP,0000,0000,0000,,Өйткені мен уәде бердім
Dialogue: 0,0:05:07.81,0:05:10.00,日文对话,NTP,0000,0000,0000,,Иә, бұл уәде.
Dialogue: 0,0:05:11.40,0:05:13.16,日文对话,NTP,0000,0000,0000,,Біз оны бірге көреміз деп шештік.
Dialogue: 0,0:05:13.92,0:05:15.47,日文对话,NTP,0000,0000,0000,,Өйткені бұл уәде керек
Dialogue: 0,0:05:16.67,0:05:20.78,日文对话,NTP,0000,0000,0000,,Және бұл тәжірибе де басқа дайындықтарды қажет етеді.
Dialogue: 0,0:05:22.05,0:05:27.41,日文对话,NTP,0000,0000,0000,,Бұл қайсысының дұрыс екенін дәлелдеу үшін екі адамның арасындағы оқиға.
Dialogue: 0,0:05:28.17,0:05:29.90,日文对话,NTP,0000,0000,0000,,Мұны екеуміз ғана жасай алмаймыз.
Dialogue: 0,0:05:30.70,0:05:33.28,日文对话,NTP,0000,0000,0000,,Енді дайындалайық.
Dialogue: 0,0:05:34.10,0:05:34.88,日文对话,NTP,0000,0000,0000,,Сая
Dialogue: 0,0:06:08.55,0:06:09.50,日文对话,NTP,0000,0000,0000,,Сіз ұйықтай алмайсыз ба?
Dialogue: 0,0:06:13.21,0:06:13.93,日文对话,NTP,0000,0000,0000,,Ябари
Dialogue: 0,0:06:14.67,0:06:15.90,日文对话,NTP,0000,0000,0000,,Бүгін естігенім
Dialogue: 0,0:06:17.60,0:06:19.65,日文对话,NTP,0000,0000,0000,,Бұл жай болжау емес еді.
Dialogue: 0,0:06:25.56,0:06:27.11,日文对话,NTP,0000,0000,0000,,Сіз тынышсыз.
Dialogue: 0,0:06:27.56,0:06:29.60,日文对话,NTP,0000,0000,0000,,Жоқ, мен таң қалдым
Dialogue: 0,0:06:30.26,0:06:32.77,日文对话,NTP,0000,0000,0000,,Бірақ сөйлей алатын көне дүниелер де бар.
Dialogue: 0,0:06:33.59,0:06:36.27,日文对话,NTP,0000,0000,0000,,Ескі нәрсе болса, оны жеңу керек.
Dialogue: 0,0:06:37.07,0:06:38.74,日文对话,NTP,0000,0000,0000,,Иә, бірақ
Dialogue: 0,0:06:39.23,0:06:41.14,日文对话,NTP,0000,0000,0000,,Мен сенен ешқандай зұлымдық сезінбеймін.
Dialogue: 0,0:06:41.80,0:06:45.82,日文对话,NTP,0000,0000,0000,,Зұлымдық әрқашан сыртқа шыға бермейді.
Dialogue: 0,0:06:47.55,0:06:50.19,日文对话,NTP,0000,0000,0000,,Ақылмен жасыруға болады
Dialogue: 0,0:06:50.84,0:06:53.39,日文对话,NTP,0000,0000,0000,,Ежелгі заттарды айтасың ба?
Dialogue: 0,0:06:55.72,0:06:57.31,日文对话,NTP,0000,0000,0000,,Одан басқа
Dialogue: 0,0:06:58.76,0:07:01.72,日文对话,NTP,0000,0000,0000,,Сіз ежелгі емессіз, солай ма?
Dialogue: 0,0:07:02.89,0:07:04.89,日文对话,NTP,0000,0000,0000,,Неліктен олай ойлайсың?
Dialogue: 0,0:07:07.41,0:07:08.45,日文对话,NTP,0000,0000,0000,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:07:09.31,0:07:11.16,日文对话,NTP,0000,0000,0000,,Мен күшті күш сезінемін, бірақ
Dialogue: 0,0:07:11.77,0:07:12.92,日文对话,NTP,0000,0000,0000,,Бірақ жоқ
Dialogue: 0,0:07:14.72,0:07:15.34,日文对话,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:07:23.03,0:07:25.01,日文对话,NTP,0000,0000,0000,,Маған не үшін келдің?
Dialogue: 0,0:07:26.51,0:07:28.20,日文对话,NTP,0000,0000,0000,,Тілегінің орындалуы
Dialogue: 0,0:07:29.04,0:07:29.81,日文对话,NTP,0000,0000,0000,,Тілек
Dialogue: 0,0:07:30.51,0:07:34.37,日文对话,NTP,0000,0000,0000,,Бірде дүкенге тілектерді орындайтын бір нәрсе келді.
Dialogue: 0,0:07:35.29,0:07:35.72,日文对话,NTP,0000,0000,0000,,Дүкен
Dialogue: 0,0:07:36.35,0:07:37.81,日文对话,NTP,0000,0000,0000,,Иә, бұл дүкен.
Dialogue: 0,0:07:38.94,0:07:40.08,日文对话,NTP,0000,0000,0000,,Бұл қандай дүкен?
Dialogue: 0,0:07:40.62,0:07:42.29,日文对话,NTP,0000,0000,0000,,Тілектерді орындайтын дүкен
Dialogue: 0,0:07:43.13,0:07:45.69,日文对话,NTP,0000,0000,0000,,Сіз дүкеннің күзетшісісіз бе?
Dialogue: 0,0:07:46.80,0:07:50.39,日文对话,NTP,0000,0000,0000,,Мен дүкеншімін. Клиенттер иттер ме?
Dialogue: 0,0:07:51.05,0:07:53.19,日文对话,NTP,0000,0000,0000,,Мен де сонда болдым.
Dialogue: 0,0:07:53.61,0:07:54.89,日文对话,NTP,0000,0000,0000,,Ол өзгереді.
Dialogue: 0,0:07:55.85,0:07:59.20,日文对话,NTP,0000,0000,0000,,Тілегіңді орындайтын дүкен иесі итке.
Dialogue: 0,0:07:59.55,0:08:01.89,日文对话,NTP,0000,0000,0000,,Баяғыда біреу тілек айтыпты.
Dialogue: 0,0:08:02.28,0:08:03.75,日文对话,NTP,0000,0000,0000,,Осыған байланысты
Dialogue: 0,0:08:03.97,0:08:05.41,日文对话,NTP,0000,0000,0000,,Сен менің орныма келдің.
Dialogue: 0,0:08:06.83,0:08:08.24,日文对话,NTP,0000,0000,0000,,Менің ойымша, бұл жолы
Dialogue: 0,0:08:09.06,0:08:10.42,日文对话,NTP,0000,0000,0000,,Бұл кімнің тілегі?
Dialogue: 0,0:08:11.11,0:08:13.45,日文对话,NTP,0000,0000,0000,,Бұлай айтуға болмайды.
Dialogue: 0,0:08:13.89,0:08:15.64,日文对话,NTP,0000,0000,0000,,Сонымен қандай тілек?
Dialogue: 0,0:08:16.32,0:08:17.81,日文对话,NTP,0000,0000,0000,,Мен де қазір олай айта алмаймын.
Dialogue: 0,0:08:19.47,0:08:22.02,日文对话,NTP,0000,0000,0000,,Мм, сіз қателесесіз деп ойлаймын.
Dialogue: 0,0:08:22.81,0:08:25.16,日文对话,NTP,0000,0000,0000,,Мен өмір бойы осы қалада тұрдым.
Dialogue: 0,0:08:25.56,0:08:27.00,日文对话,NTP,0000,0000,0000,,Мен ол жерде ешқашан болған емеспін.
Dialogue: 0,0:08:27.35,0:08:30.00,日文对话,NTP,0000,0000,0000,,Мен сол дүкенде екенімді айтқан ешкімді білмеймін.
Dialogue: 0,0:08:31.49,0:08:35.84,日文对话,NTP,0000,0000,0000,,Иә, шынымен бе?
Dialogue: 0,0:08:41.00,0:08:43.90,日文对话,NTP,0000,0000,0000,,Сол уақыт Сол уақыт
Dialogue: 0,0:08:44.36,0:08:45.37,日文对话,NTP,0000,0000,0000,,Мен оны естідім.
Dialogue: 0,0:08:46.06,0:08:47.41,日文对话,NTP,0000,0000,0000,,Сіздің дауысыңыз
Dialogue: 0,0:08:48.15,0:08:52.50,日文对话,NTP,0000,0000,0000,,Мен бәрін қорғауға уәде бердім дегенде
Dialogue: 0,0:08:53.15,0:08:54.10,日文对话,NTP,0000,0000,0000,,Кіммен
Dialogue: 0,0:08:54.85,0:08:55.96,日文对话,NTP,0000,0000,0000,,Мен уәде бердім
Dialogue: 0,0:08:56.31,0:09:00.00,日文对话,NTP,0000,0000,0000,,Бұрынғыларды жеңіп, бәрін қорғайтынымыз рас.
Dialogue: 0,0:09:00.63,0:09:01.41,日文对话,NTP,0000,0000,0000,,Бірақ
Dialogue: 0,0:09:02.39,0:09:03.90,日文对话,NTP,0000,0000,0000,,Кімге уәде бердіңіз?
Dialogue: 0,0:09:04.25,0:09:05.42,日文对话,NTP,0000,0000,0000,,Менің есімде жоқ сияқты.
Dialogue: 0,0:09:10.79,0:09:13.63,日文对话,NTP,0000,0000,0000,,Тілектің орындалуы үшін баға керек
Dialogue: 0,0:09:14.52,0:09:17.40,日文对话,NTP,0000,0000,0000,,Ал сол тілектің салмағы
Dialogue: 0,0:09:17.62,0:09:20.23,日文对话,NTP,0000,0000,0000,,Орындау үшін сыйақы тең болуы керек
Dialogue: 0,0:09:21.35,0:09:23.35,日文对话,NTP,0000,0000,0000,,Сонымен, сіз жасай алатын нәрсе шектеулі.
Dialogue: 0,0:09:24.95,0:09:27.34,日文对话,NTP,0000,0000,0000,,Бұл формада көрінетін нәрсе солардың бірі.
Dialogue: 0,0:09:36.07,0:09:36.57,日文对话,NTP,0000,0000,0000,,Сая
Dialogue: 0,0:09:38.33,0:09:41.07,日文对话,NTP,0000,0000,0000,,Мен сенің тілегіңді орындауға уәде бердім.
Dialogue: 0,0:09:41.71,0:09:45.94,日文对话,NTP,0000,0000,0000,,Мен оны міндетті түрде орындаймын, оған дейін Саяның қасында боламын.
Dialogue: 0,0:09:47.11,0:09:47.98,日文对话,NTP,0000,0000,0000,,Сонымен...
Dialogue: 0,0:09:56.00,0:09:56.54,日文对话,NTP,0000,0000,0000,,Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады
Dialogue: 0,0:10:01.14,0:10:03.88,日文对话,NTP,0000,0000,0000,,Бұл арман емес...
Dialogue: 0,0:10:24.53,0:10:25.51,日文对话,NTP,0000,0000,0000,,Мен барамын
Dialogue: 0,0:10:26.92,0:10:28.26,日文对话,NTP,0000,0000,0000,,Әлі ерте, бірақ
Dialogue: 0,0:10:29.57,0:10:32.50,日文对话,NTP,0000,0000,0000,,Мен бір орында тұрып, біле алмаймын
Dialogue: 0,0:10:33.18,0:10:38.50,日文对话,NTP,0000,0000,0000,,Қызық, ежелгі дүниелер осындай жерде пайда бола ма?
Dialogue: 0,0:10:39.76,0:10:40.33,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:10:48.44,0:10:49.31,日文对话,NTP,0000,0000,0000,,Тіпті тәтті, бал иісі бар дене жылуы
Dialogue: 0,0:10:49.87,0:10:50.64,日文对话,NTP,0000,0000,0000,,Оны өзіңізбен бірге алыңыз.
Dialogue: 0,0:10:51.95,0:10:55.33,日文对话,NTP,0000,0000,0000,,Жоқ, бұдан былай мен әрқашан сенің жаныңда боламын
Dialogue: 0,0:11:20.29,0:11:21.55,日文对话,NTP,0000,0000,0000,,Иә? Сайо-чан
Dialogue: 0,0:11:22.78,0:11:23.83,日文对话,NTP,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:11:27.17,0:11:28.04,日文对话,NTP,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:11:31.52,0:11:32.78,日文对话,NTP,0000,0000,0000,,Бірақ
Dialogue: 0,0:11:33.49,0:11:35.63,日文对话,NTP,0000,0000,0000,,Қиын кезде күлуге мәжбүрлеуді қойдым.
Dialogue: 0,0:11:36.29,0:11:39.56,日文对话,NTP,0000,0000,0000,,Рахмет...
Dialogue: 0,0:11:40.27,0:11:43.49,日文对话,NTP,0000,0000,0000,,Кеше кешкі ас ішпей ұйықтап қалғаныңды естідім.
Dialogue: 0,0:11:43.93,0:11:44.76,日文对话,NTP,0000,0000,0000,,Неліктен?
Dialogue: 0,0:11:45.64,0:11:47.26,日文对话,NTP,0000,0000,0000,,Мен Юйошиден сұрадым
Dialogue: 0,0:11:48.74,0:11:51.39,日文对话,NTP,0000,0000,0000,,Мен қазір рисотто жасаймын, оны жей бер.
Dialogue: 0,0:11:53.44,0:11:54.26,日文对话,NTP,0000,0000,0000,,Беру
Dialogue: 0,0:12:02.61,0:12:05.27,日文对话,NTP,0000,0000,0000,,Фумито-сан мұны бұрын айтқан.
Dialogue: 0,0:12:05.60,0:12:09.06,日文对话,NTP,0000,0000,0000,,Gimauve бір нәрсеге қол тигізгенге ұқсас.
Dialogue: 0,0:12:09.41,0:12:10.54,日文对话,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:12:11.21,0:12:13.31,日文对话,NTP,0000,0000,0000,,Ол неге ұқсайды?
Dialogue: 0,0:12:20.17,0:12:20.88,日文对话,NTP,0000,0000,0000,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:12:22.21,0:12:25.16,日文对话,NTP,0000,0000,0000,,Ерін...?
Dialogue: 0,0:12:26.82,0:12:28.99,日文对话,NTP,0000,0000,0000,,жанында
Dialogue: 0,0:12:33.64,0:12:36.81,日文对话,NTP,0000,0000,0000,,Бір ғана курорттар жеткіліксіз, солай ма?
Dialogue: 0,0:12:37.52,0:12:40.22,日文对话,NTP,0000,0000,0000,,Қуырылған жұмыртқа және жылы салат
Dialogue: 0,0:12:40.52,0:12:43.80,日文对话,NTP,0000,0000,0000,,Кофеден кейін.
Dialogue: 0,0:12:50.39,0:12:51.04,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:12:51.61,0:12:52.67,日文对话,NTP,0000,0000,0000,,Үшеуі де дәл бірдей жағдайда қаза тапты.
Dialogue: 0,0:12:53.12,0:12:55.08,日文对话,NTP,0000,0000,0000,,Сіздің бетіңіз сәл жақсырақ көрінеді.
Dialogue: 0,0:12:55.74,0:12:58.56,日文对话,NTP,0000,0000,0000,,Мен Фумито-саннан дәмді тағам іштім.
Dialogue: 0,0:12:59.01,0:13:00.10,日文对话,NTP,0000,0000,0000,,Кофеден кейін де
Dialogue: 0,0:13:00.64,0:13:01.25,日文对话,NTP,0000,0000,0000,,Жақсы
Dialogue: 0,0:13:02.03,0:13:05.53,日文对话,NTP,0000,0000,0000,,Аа, дұрыс, бенто және гимов
Dialogue: 0,0:13:06.05,0:13:07.24,日文对话,NTP,0000,0000,0000,,Қалағаныңызша жеңіз
Dialogue: 0,0:13:08.70,0:13:10.06,日文对话,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,0:13:16.28,0:13:17.94,日文对话,NTP,0000,0000,0000,,Әлі уақыт бар
Dialogue: 0,0:13:18.10,0:13:20.93,日文对话,NTP,0000,0000,0000,,Мен қаланы біраз аралап, көрсем бе деп ойладым.
Dialogue: 0,0:13:42.05,0:13:43.07,日文对话,NTP,0000,0000,0000,,Бүгін мектеп жабық.
Dialogue: 0,0:13:44.62,0:13:45.58,日文对话,NTP,0000,0000,0000,,Мұғалім
Dialogue: 0,0:13:46.57,0:13:48.14,日文对话,NTP,0000,0000,0000,,Байланыс жоқ
Dialogue: 0,0:13:48.62,0:13:51.88,日文对话,NTP,0000,0000,0000,,Жоқ, өйткені мен үйден ерте шықтым.
Dialogue: 0,0:13:52.95,0:13:58.24,日文对话,NTP,0000,0000,0000,,Иә, мектептер әзірге жабық күйінде қалуы мүмкін.
Dialogue: 0,0:14:01.59,0:14:03.88,日文对话,NTP,0000,0000,0000,,Өйткені мен оны әлі таппадым.
Dialogue: 0,0:14:06.81,0:14:09.52,日文对话,NTP,0000,0000,0000,,Бірақ мен оны тапсам, таптым.
Dialogue: 0,0:14:09.83,0:14:11.60,日文对话,NTP,0000,0000,0000,,Бұл қайтадан қиын болуы мүмкін.
Dialogue: 0,0:14:12.57,0:14:13.49,日文对话,NTP,0000,0000,0000,,Мұғалім
Dialogue: 0,0:14:15.09,0:14:16.55,日文对话,NTP,0000,0000,0000,,Бұл бұрынғы әңгіме.
Dialogue: 0,0:14:17.69,0:14:21.86,日文对话,NTP,0000,0000,0000,,...Иә, бұл адамды жейтін нәрсе туралы әңгіме.
Dialogue: 0,0:14:23.27,0:14:27.80,日文对话,NTP,0000,0000,0000,,Бәлкім, Нотоно мен Нене ізденісті бірдеңе жеп қойған шығар.
Dialogue: 0,0:14:30.81,0:14:35.52,日文对话,NTP,0000,0000,0000,,Мүмкін осы уақытқа дейін жоғалып кеткен адамдардың бәрі бірдей болған шығар.
Dialogue: 0,0:14:36.71,0:14:39.28,日文对话,NTP,0000,0000,0000,,Иә, мен олай ойламаймын.
Dialogue: 0,0:14:43.66,0:14:44.80,日文对话,NTP,0000,0000,0000,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:14:45.28,0:14:47.04,日文对话,NTP,0000,0000,0000,,Менің басым қайтадан ауырады.
Dialogue: 0,0:14:47.62,0:14:49.66,日文对话,NTP,0000,0000,0000,,Жоқ, бәрібір.
Dialogue: 0,0:14:50.29,0:14:53.52,日文对话,NTP,0000,0000,0000,,Иә, сосын үйге қайт.
Dialogue: 0,0:14:53.99,0:14:55.53,日文对话,NTP,0000,0000,0000,,Әкемге
Dialogue: 0,0:15:08.09,0:15:11.75,日文对话,NTP,0000,0000,0000,,Неліктен Цуцутори-сенсэй кенет бұл туралы айтты?
Dialogue: 0,0:15:12.33,0:15:14.78,日文对话,NTP,0000,0000,0000,,Ежелгі заттар туралы білу
Dialogue: 0,0:15:15.62,0:15:16.58,日文对话,NTP,0000,0000,0000,,Бұл тек болжам ғана, айтпақшы.
Dialogue: 0,0:15:19.71,0:15:20.55,日文对话,NTP,0000,0000,0000,,Мектеп
Dialogue: 0,0:15:20.94,0:15:21.62,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:15:22.14,0:15:24.21,日文对话,NTP,0000,0000,0000,,Мектеп бүгін жабылуы керек еді.
Dialogue: 0,0:15:24.75,0:15:27.83,日文对话,NTP,0000,0000,0000,,Кешіріңіз, мен сізге хабарласпас бұрын үйден шығып кеттім.
Dialogue: 0,0:15:28.54,0:15:31.98,日文对话,NTP,0000,0000,0000,,Олай болса, үйге ертерек бару керек.
Dialogue: 0,0:15:32.54,0:15:35.55,日文对话,NTP,0000,0000,0000,,Таң атты десем де, бірдеңе бола ма?
Dialogue: 0,0:16:31.69,0:16:35.99,日文对话,NTP,0000,0000,0000,,Осыншама әлсіз болып кеткенің аянышты.
Dialogue: 0,0:16:36.35,0:16:37.13,日文对话,NTP,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:17:08.19,0:17:11.32,日文对话,NTP,0000,0000,0000,,Жәбірленуші де аянышты ма?
Dialogue: 0,0:17:12.01,0:17:14.23,日文对话,NTP,0000,0000,0000,,Сол кездегі шебер болса, бәрібір.
Dialogue: 0,0:17:15.02,0:17:17.31,日文对话,NTP,0000,0000,0000,,Осы деңгейдегі адам өшіреді, т.б.
Dialogue: 0,0:17:17.60,0:17:19.89,日文对话,NTP,0000,0000,0000,,Мен қалсам ұят болар еді.
Dialogue: 0,0:17:20.20,0:17:22.42,日文对话,NTP,0000,0000,0000,,Мен сенімен ешқашан ұрысқан емеспін
Dialogue: 0,0:17:22.70,0:17:23.69,日文对话,NTP,0000,0000,0000,,Неге!
Dialogue: 0,0:17:25.21,0:17:27.56,日文对话,NTP,0000,0000,0000,,Әлсіз Тым әлсіз
Dialogue: 0,0:17:37.59,0:17:40.28,日文对话,NTP,0000,0000,0000,,Сіз менің анаммен ұрысып көрдіңіз бе?
Dialogue: 0,0:17:42.33,0:17:43.32,日文对话,NTP,0000,0000,0000,,Осы құдайдың семсерімен
Dialogue: 0,0:17:46.03,0:17:49.09,日文对话,NTP,0000,0000,0000,,Анаммен салыстырғанда мен әлсіз шығармын.
Dialogue: 0,0:17:49.65,0:17:52.88,日文对话,NTP,0000,0000,0000,,Бірақ мен сендерді міндетті түрде жеңемін қарттарды!
Dialogue: 0,0:18:12.37,0:18:14.93,日文对话,NTP,0000,0000,0000,,Хаха!
Dialogue: 0,0:18:14.93,0:18:16.31,日文对话,NTP,0000,0000,0000,,Неге күлу керек
Dialogue: 0,0:18:18.61,0:18:22.29,日文对话,NTP,0000,0000,0000,,Әкең Юйоши айтты ма?
Dialogue: 0,0:18:22.86,0:18:28.40,日文对话,NTP,0000,0000,0000,,Сол киелі мекенде мен біртүрлі жүз жасап, қасиетті қылыш болып қолыңа тапсырдым.
Dialogue: 0,0:18:28.84,0:18:30.39,日文对话,NTP,0000,0000,0000,,Бұл күлкілі
Dialogue: 0,0:18:31.75,0:18:32.66,日文对话,NTP,0000,0000,0000,,Күлме
Dialogue: 0,0:18:33.62,0:18:35.85,日文对话,NTP,0000,0000,0000,,Бұған қалай күлмеуге болады?
Dialogue: 0,0:18:36.38,0:18:40.38,日文对话,NTP,0000,0000,0000,,Юйоши сенен бізді жеңуіңді өтінді.
Dialogue: 0,0:18:41.00,0:18:43.41,日文对话,NTP,0000,0000,0000,,Юйоши екеуің тым ақымақсыңдар.
Dialogue: 0,0:18:44.07,0:18:46.33,日文对话,NTP,0000,0000,0000,,Жоқ, сен шынымен ақымақсың ба?
Dialogue: 0,0:18:47.39,0:18:48.30,日文对话,NTP,0000,0000,0000,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,0:19:09.96,0:19:11.42,日文对话,NTP,0000,0000,0000,,Әке ақымақ емес.
Dialogue: 0,0:19:11.78,0:19:13.11,日文对话,NTP,0000,0000,0000,,Күшті және жұмсақ
Dialogue: 0,0:19:13.59,0:19:16.93,日文对话,NTP,0000,0000,0000,,Анам қайтыс болғаннан кейін де мені қолдағаныңыз үшін рахмет.
Dialogue: 0,0:19:17.54,0:19:19.55,日文对话,NTP,0000,0000,0000,,Бұл не туралы?
Dialogue: 0,0:19:21.48,0:19:23.96,日文对话,NTP,0000,0000,0000,,Сонымен мен бұл не туралы екенін естідім.
Dialogue: 0,0:19:25.06,0:19:26.05,日文对话,NTP,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:19:32.90,0:19:35.49,日文对话,NTP,0000,0000,0000,,Мені шатастырып алу үшін бос сөз айт.
Dialogue: 0,0:19:35.71,0:19:38.21,日文对话,NTP,0000,0000,0000,,Менің ойымша, адамдар бос сөзге бейім.
Dialogue: 0,0:19:43.55,0:19:47.34,日文对话,NTP,0000,0000,0000,,Бос сөздер мен өтіріктердің кесірінен келісімдерінен ауытқығандар
Dialogue: 0,0:19:48.03,0:19:49.16,日文对话,NTP,0000,0000,0000,,Адамдармен
Dialogue: 0,0:20:08.32,0:20:10.05,日文对话,NTP,0000,0000,0000,,Сіз тез жоғалып кетуіңіз керек.
Dialogue: 0,0:20:13.51,0:20:17.01,日文对话,NTP,0000,0000,0000,,Осыдан кейін мен Юйошиді де өшіремін.
Dialogue: 0,0:20:18.12,0:20:19.00,日文对话,NTP,0000,0000,0000,,Әке
Dialogue: 0,0:20:19.40,0:20:20.30,日文对话,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:20:20.60,0:20:24.45,日文对话,NTP,0000,0000,0000,,Мен ойлаған әкем де өшіп қалса, тілегім болар еді.
Dialogue: 0,0:20:25.72,0:20:26.64,日文对话,NTP,0000,0000,0000,,Тіпті тәтті, бал иісі бар дене жылуы
Dialogue: 0,0:20:34.92,0:20:37.18,日文对话,NTP,0000,0000,0000,,Мен сені әкеме жібермеймін.
Dialogue: 0,0:20:38.39,0:20:40.69,日文对话,NTP,0000,0000,0000,,О, мен оны қазір сезіп тұрмын.
Dialogue: 0,0:20:40.94,0:20:42.19,日文对话,NTP,0000,0000,0000,,Сіз сол кезде
Dialogue: 0,0:21:10.10,0:21:13.48,日文对话,NTP,0000,0000,0000,,Барып Юйошиді көр.
Dialogue: 0,0:21:14.50,0:21:17.21,日文对话,NTP,0000,0000,0000,,Сіздің шындық
Dialogue: 0,0:21:53.11,0:21:53.54,日文对话,NTP,0000,0000,0000,,Сая
Dialogue: 0,0:21:58.45,0:22:00.87,日文对话,NTP,0000,0000,0000,,Токима...
Dialogue: 0,0:22:07.69,0:22:10.63,日文对话,NTP,0000,0000,0000,,Ежелгі нәрсені жеңуге кім уәде берді?
Dialogue: 0,0:22:11.29,0:22:15.69,日文对话,NTP,0000,0000,0000,,Сіздің тілегіңіздің орындалуын кім сұрады?
Dialogue: 0,0:00:00.00,0:00:00.00,日文对话,NTP,0000,0000,0000,,Ескерту
Dialogue: 0,0:23:47.77,0:23:48.71,日文对话,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:23:49.18,0:23:50.99,日文对话,NTP,0000,0000,0000,,Егер сіз аралассаңыз, сізге қауіп төнеді.
Dialogue: 0,0:23:51.19,0:23:52.87,日文对话,NTP,0000,0000,0000,,Олай болса, мен одан да көп білгім келеді.
Dialogue: 0,0:23:53.15,0:23:53.93,日文对话,NTP,0000,0000,0000,,Неліктен?
Dialogue: 0,0:23:54.26,0:23:56.83,日文对话,NTP,0000,0000,0000,,Сен мен үшін ерекшесің
Dialogue: 0,0:23:57.20,0:23:57.67,日文对话,NTP,0000,0000,0000,,Сая
Dialogue: 0,0:23:58.30,0:24:01.31,日文对话,NTP,0000,0000,0000,,Келесі жолы BLOOD-C «Йононакайо»
Dialogue: 0,0:24:02.81,0:24:08.81,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory