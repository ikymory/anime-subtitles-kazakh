Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:18.20,0:02:20.20,Default,,0,0,0,,Сәлем бақсы
Dialogue: 0,0:02:21.70,0:02:25.11,Default,,0,0,0,,Эй, сенің атың кім?
Dialogue: 0,0:02:28.54,0:02:30.71,Default,,0,0,0,,Иә, сіз
Dialogue: 0,0:02:30.71,0:02:33.48,Default,,0,0,0,,Бұл суреттегі бала.
Dialogue: 0,0:02:33.48,0:02:37.49,Default,,0,0,0,,<Бақсыға көшеде дұшпандықсыз адамдар келді>
Dialogue: 0,0:02:37.49,0:02:40.32,Default,,0,0,0,,＜Тым сирек＞
Dialogue: 0,0:02:40.32,0:02:46.33,Default,,0,0,0,,＜Мен өткен күні болған оқиғаға қатты өкінемін және өзімді кінәлі сезінемін...＞
Dialogue: 0,0:02:47.50,0:02:50.00,Default,,0,0,0,,Менің атым Анри
Dialogue: 0,0:02:50.00,0:02:55.00,Default,,0,0,0,,Эй, сенің атың Луна шығар?
Dialogue: 0,0:02:55.00,0:02:59.01,Default,,0,0,0,,⚟Уау, қара бақсыларды жинау деген жоқ.
Dialogue: 0,0:02:59.01,0:03:01.01,Default,,0,0,0,,Анри қарапайым адам емес.
Dialogue: 0,0:03:01.01,0:03:04.01,Default,,0,0,0,,Әйелдер әлемінің қаһарманы
Dialogue: 0,0:03:04.01,0:03:07.02,Default,,0,0,0,,Біз бұрын кездескенбіз...
Dialogue: 0,0:03:08.02,0:03:10.35,Default,,0,0,0,,... дұрыс па?
Dialogue: 0,0:03:10.35,0:03:12.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:14.52,0:03:16.69,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:16.69,0:03:18.69,Default,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,0:03:18.69,0:03:21.36,Default,,0,0,0,,Оның тербелу тәсілі де стандарттан тыс.
Dialogue: 0,0:03:21.36,0:03:25.57,Default,,0,0,0,,Сондай-ақ~ Луна, күте тұрыңыз~
Dialogue: 0,0:03:31.71,0:03:33.98,Default,,0,0,0,,А, міне, келді➡
Dialogue: 0,0:03:33.98,0:03:36.31,Default,,0,0,0,,Уши-кун, мен сені алып кетуге келдім➡
Dialogue: 0,0:03:36.31,0:03:38.81,Default,,0,0,0,,Күтпеген саңырауқұлақтың ішінен
Dialogue: 0,0:03:40.32,0:03:45.32,Default,,0,0,0,,Сондай-ақ~ Лунаның ақымақ, мен оны сонда қалдырдым!
Dialogue: 0,0:03:45.32,0:03:47.66,Default,,0,0,0,,Уф... кешіріңіз де!
Dialogue: 0,0:03:47.66,0:03:49.66,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:03:49.66,0:03:54.16,Default,,0,0,0,,Мен сенің өте ұялшақ екеніңді Уши-куннан естідім.
Dialogue: 0,0:03:54.16,0:03:56.33,Default,,0,0,0,,Мені көбірек ұрыңыз!
Dialogue: 0,0:03:56.33,0:03:59.84,Default,,0,0,0,,Сізбен кенеттен сөйлесіп, таң қалдырғаным үшін кешіріңіз.
Dialogue: 0,0:04:01.17,0:04:06.51,Default,,0,0,0,,Мен... Қашып кеткен мен едім...
Dialogue: 0,0:04:06.51,0:04:12.35,Default,,0,0,0,,Ол басқаларға қиындық туғызды...
Dialogue: 0,0:04:12.35,0:04:15.18,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:15.18,0:04:17.19,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,0:04:17.19,0:04:22.36,Default,,0,0,0,,Бұл менің қиялым емес еді. Біз бұрын кездескенбіз, солай ма?
Dialogue: 0,0:04:22.36,0:04:25.69,Default,,0,0,0,,Айлы аспанда бірге биледік, солай ма?
Dialogue: 0,0:04:25.69,0:04:29.40,Default,,0,0,0,,Суретші болған кезім есімде...
Dialogue: 0,0:04:31.87,0:04:35.87,Default,,0,0,0,,Сол кездегі жүзіңді ұмыта алмаймын.
Dialogue: 0,0:04:36.81,0:04:40.11,Default,,0,0,0,,Ей, неге ол кезде...
Dialogue: 0,0:04:45.15,0:04:47.15,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:47.15,0:04:49.15,Default,,0,0,0,,Маған тиіспе
Dialogue: 0,0:04:49.15,0:04:51.82,Default,,0,0,0,,Өтінемін, маған жақындама
Dialogue: 0,0:04:51.82,0:04:56.32,Default,,0,0,0,,Себебі сен ол кезде шынайы емес едің...
Dialogue: 0,0:04:56.32,0:05:00.33,Default,,0,0,0,,Осылай болса да мен саған тиісе алдым.
Dialogue: 0,0:05:01.50,0:05:07.84,Default,,0,0,0,,Нағыз мен – қазіргі өміріңізде сізге зиян келтіретін улы масса.
Dialogue: 0,0:05:07.84,0:05:12.54,Default,,0,0,0,,Рұқсатсыз сурет салғаным үшін кешіріңіз...
Dialogue: 0,0:05:14.01,0:05:18.68,Default,,0,0,0,,Бұл таңқаларлық. Мен қауесеттерді естідім.
Dialogue: 0,0:05:18.68,0:05:20.85,Default,,0,0,0,,Шампиньон сиқыршысы
Dialogue: 0,0:05:20.85,0:05:25.19,Default,,0,0,0,,Шынында да, саңырауқұлақтар қол тигізген жерде өседі➡
Dialogue: 0,0:05:25.19,0:05:30.69,Default,,0,0,0,,Мен таң қалдым~ Сіз де, Киноко да мен ойлағаннан да сүйкімді екенсіз.
Dialogue: 0,0:05:31.96,0:05:37.47,Default,,0,0,0,,Және сол кездегі менің сезгенімдей, бұл бәрі айтып жүрген қауесеттерден мүлде басқаша болды.
Dialogue: 0,0:05:37.47,0:05:42.30,Default,,0,0,0,,Өсетін саңырауқұлақтардың барлығы улы ма? Мен бұл балаға тиісе аламын ба? ➡
Dialogue: 0,0:05:42.30,0:05:44.47,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:05:44.47,0:05:46.47,Default,,0,0,0,,Ол ешқандай қосымша күш бола алмайды.
Dialogue: 0,0:05:46.47,0:05:48.48,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:05:50.31,0:05:52.65,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:52.65,0:05:54.82,Default,,0,0,0,,Кешірім сұрама➡
Dialogue: 0,0:05:54.82,0:06:00.49,Default,,0,0,0,,Лунаның ерекше мінезі бар, тіпті оның толқуы да.
Dialogue: 0,0:06:00.49,0:06:03.16,Default,,0,0,0,,Мен оны көруден жалықпаймын
Dialogue: 0,0:06:03.16,0:06:06.49,Default,,0,0,0,,Анри, сен де
Dialogue: 0,0:06:06.49,0:06:11.17,Default,,0,0,0,,⚟Сұлу жігіт болғанымен, оның әйелдерге деген талғамы өте көңілсіз.
Dialogue: 0,0:06:11.17,0:06:14.67,Default,,0,0,0,,⚟Сол Амур конституциясы сені құртады.
Dialogue: 0,0:06:16.50,0:06:20.84,Default,,0,0,0,,⚟Бірақ оның достығы оның сүйкімділігі.
Dialogue: 0,0:06:20.84,0:06:24.85,Default,,0,0,0,,⚟Бірақ жақсы ма? Оның отбасы екеніне сенімдімін...➡
Dialogue: 0,0:06:24.85,0:06:28.85,Default,,0,0,0,,Патша отбасына табынатын қатал ақ сиқыршы фракциясы.
Dialogue: 0,0:06:29.85,0:06:34.12,Default,,0,0,0,,⚟Ах, бірақ Анридің өзі...
Dialogue: 0,0:06:34.12,0:06:37.96,Default,,0,0,0,,⚟Жоқ, бұл жағдайды менің отбасым көрсе➡
Dialogue: 0,0:06:37.96,0:06:40.46,Default,,0,0,0,,Өте нашар, солай емес пе?
Dialogue: 0,0:06:40.46,0:06:43.57,Default,,0,0,0,,⚟Жарайды, ұрысып қалатын шығарсың...
Dialogue: 0,0:06:46.47,0:06:48.47,Default,,0,0,0,,(Қарға қарғалар)
Dialogue: 0,0:06:48.47,0:06:51.64,Default,,0,0,0,,⚟Анри да, бірақ анау қара ведьма➡
Dialogue: 0,0:06:51.64,0:06:54.48,Default,,0,0,0,,Егер сіз жақсы жұмыс істемесеңіз, сіз бақсышылардың тізіміне түсесіз, солай ма?
Dialogue: 0,0:06:54.48,0:06:57.65,Default,,0,0,0,,⚟Аа... Мен ондай нәрсеге шебер емеспін.
Dialogue: 0,0:06:57.65,0:06:59.65,Default,,0,0,0,,(Қарға қарғалар)
Dialogue: 0,0:07:01.98,0:07:05.32,Default,,0,0,0,,Бұл ақымақ...
Dialogue: 0,0:07:05.32,0:07:08.02,Default,,0,0,0,,У… Хмм? Хмм?
Dialogue: 0,0:07:10.16,0:07:12.83,Default,,0,0,0,,Сурет бойынша енді кешірім сұрамаңыз.
Dialogue: 0,0:07:12.83,0:07:16.16,Default,,0,0,0,,Менің жүзімді осылай ұнатқаныңа сене алар емеспін.
Dialogue: 0,0:07:16.16,0:07:18.83,Default,,0,0,0,,Мен өте қуаныштымын
Dialogue: 0,0:07:18.83,0:07:24.01,Default,,0,0,0,,Мүмкін менің жаным суреттер арқылы ойнауға кеткен шығар➡
Dialogue: 0,0:07:24.01,0:07:26.68,Default,,0,0,0,,Бұл тек Лунаның кінәсі емес деп ойлаймын.
Dialogue: 0,0:07:26.68,0:07:28.68,Default,,0,0,0,,А...
Dialogue: 0,0:07:28.68,0:07:31.51,Default,,0,0,0,,Бақсы немесе сиқыршы деңгейінде болмаса да ➡
Dialogue: 0,0:07:31.51,0:07:37.02,Default,,0,0,0,,Мүмкін, бұл менің отбасымнан шығар, бірақ менде де осындай жағдайларды тудыруға бейім сияқтымын.
Dialogue: 0,0:07:39.79,0:07:42.29,Default,,0,0,0,,Менің отбасымның ақ бақсысы
Dialogue: 0,0:07:42.29,0:07:46.29,Default,,0,0,0,,Әркім не асыл, не арам.
Dialogue: 0,0:07:46.29,0:07:51.60,Default,,0,0,0,,Сенің бізге төмен қарайтыныңды түсіндім, бірақ сен туралы жақсы әсер қалдырмадым...
Dialogue: 0,0:07:53.13,0:07:57.47,Default,,0,0,0,,Луна мүлдем басқа, біртүрлі~
Dialogue: 0,0:07:57.47,0:08:02.48,Default,,0,0,0,,Мен басқалармен болғанша, улы Лунамен бірге болғанды жақсы көремін➡
Dialogue: 0,0:08:02.48,0:08:07.78,Default,,0,0,0,,Айналадағы ауа мен жүрегім әдеттегіден де тазарақ сезіледі.
Dialogue: 0,0:08:08.82,0:08:12.15,Default,,0,0,0,,Луна мен саңырауқұлақтар айналамдағы тоқырауды тазартады
Dialogue: 0,0:08:12.15,0:08:15.32,Default,,0,0,0,,Таза ұстайды ма деп ойлаймын➡
Dialogue: 0,0:08:15.32,0:08:17.83,Default,,0,0,0,,Бұл да Лунаның сиқыры ма?
Dialogue: 0,0:08:24.17,0:08:26.67,Default,,0,0,0,,Мына жерде!
Dialogue: 0,0:08:26.67,0:08:28.67,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:33.11,0:08:35.44,Default,,0,0,0,,Луна?
Dialogue: 0,0:08:35.44,0:08:37.45,Default,,0,0,0,,Не болды? Лу…
Dialogue: 0,0:08:37.45,0:08:41.55,Default,,0,0,0,,Әй, бұрын болған қара бақсыға не болды?
Dialogue: 0,0:08:45.12,0:08:47.12,Default,,0,0,0,,Сіз қайдасыз?
Dialogue: 0,0:08:47.12,0:08:49.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:50.79,0:08:53.96,Default,,0,0,0,,Күте тұрыңыз! Қайта кездесе аламыз ба?
Dialogue: 0,0:08:53.96,0:08:58.30,Default,,0,0,0,,Мен сенімен танысқым келеді! Сіз де солай ойласаңыз➡
Dialogue: 0,0:08:58.30,0:09:00.80,Default,,0,0,0,,Мені тағы да сал! ➡
Dialogue: 0,0:09:00.80,0:09:03.14,Default,,0,0,0,,Ха... мен сені көруге барамын! ➡
Dialogue: 0,0:09:03.14,0:09:05.14,Default,,0,0,0,,Мен күтемін!
Dialogue: 0,0:09:06.31,0:09:09.31,Default,,0,0,0,,Хаха...
Dialogue: 0,0:09:09.31,0:09:12.81,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:09:17.32,0:09:19.82,Default,,0,0,0,,Сәлем! Тез оян
Dialogue: 0,0:09:19.82,0:09:21.99,Default,,0,0,0,,Клод…
Dialogue: 0,0:09:21.99,0:09:25.09,Default,,0,0,0,,Не, кенеттен не болды? Балалар сендер
Dialogue: 0,0:09:27.33,0:09:29.33,Default,,0,0,0,,(қарғалар)
Dialogue: 0,0:09:29.33,0:09:31.33,Default,,0,0,0,,Не? Бұрынғы
Dialogue: 0,0:09:31.33,0:09:35.10,Default,,0,0,0,,Ақ бақсы құзырындағы адамдармен ашық араласу.
Dialogue: 0,0:09:35.10,0:09:40.28,Default,,0,0,0,,Егер сізді осылай әскери полиция ұстаса, құтылмас едіңіз.
Dialogue: 0,0:09:40.28,0:09:44.28,Default,,0,0,0,,Сіз өз ұстанымыңызды түсінесіз бе? Пайдасыз сиқыршы!
Dialogue: 0,0:09:44.28,0:09:46.28,Default,,0,0,0,,Бір сәт…➡
Dialogue: 0,0:09:46.28,0:09:49.95,Default,,0,0,0,,Адамдар, өздерің келіп уағыз айтуды доғарыңдар➡
Dialogue: 0,0:09:49.95,0:09:52.55,Default,,0,0,0,,Тым болмаса мән-жайлар туралы сөйлесейік.
Dialogue: 0,0:09:53.79,0:09:57.79,Default,,0,0,0,,Басқаша айтқанда, бақсыға романтика келді ме?
Dialogue: 0,0:09:57.79,0:09:59.79,Default,,0,0,0,,Романтика дегеніміз не?
Dialogue: 0,0:09:59.79,0:10:01.80,Default,,0,0,0,,Ей, бұл жақсы, бақсы-сан.
Dialogue: 0,0:10:01.80,0:10:05.30,Default,,0,0,0,,Осы уақыт аралығындағы романтикалық романның нәтижесі? Мен жасаймын~
Dialogue: 0,0:10:05.30,0:10:07.80,Default,,0,0,0,,Хамф, бұл түкке тұрғысыз, оған тұрарлық емес.
Dialogue: 0,0:10:07.80,0:10:09.80,Default,,0,0,0,,Мұны жасама!
Dialogue: 0,0:10:09.80,0:10:12.14,Default,,0,0,0,,<Бұл қарға>
Dialogue: 0,0:10:12.14,0:10:18.65,Default,,0,0,0,,<Луна күнделікті қарыздар болатын ұлы сиқыршының танысы>
Dialogue: 0,0:10:18.65,0:10:21.65,Default,,0,0,0,,<Бір себептермен Луна өзін қатты қорқытады>
Dialogue: 0,0:10:21.65,0:10:28.36,Default,,0,0,0,,＜Дегенмен, ол мен онша түсінбейтін қиын адам, маған осылай көмектескен.＞
Dialogue: 0,0:10:29.49,0:10:34.00,Default,,0,0,0,,Эй, оны кездестірме.
Dialogue: 0,0:10:34.00,0:10:37.17,Default,,0,0,0,,Мен білмеймін, сіз қандай қулық жасайсыз.
Dialogue: 0,0:10:37.17,0:10:40.00,Default,,0,0,0,,Егер мен онымен қайта араласатын болсам
Dialogue: 0,0:10:40.00,0:10:43.00,Default,,0,0,0,,Мен оны Мастерге хабарлаймын.
Dialogue: 0,0:10:43.00,0:10:45.01,Default,,0,0,0,,Бірдеңе болған кезде
Dialogue: 0,0:10:45.01,0:10:48.68,Default,,0,0,0,,Сіз жай ғана тазартылсаңыз, маңызды емес.
Dialogue: 0,0:10:48.68,0:10:53.52,Default,,0,0,0,,Бұл жалпы қара сиқыршылар мен қара сиқыршыларға қатысты мәселе.
Dialogue: 0,0:10:53.52,0:10:56.02,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:10:56.02,0:10:58.02,Default,,0,0,0,,Иә...
Dialogue: 0,0:11:08.03,0:11:12.37,Default,,0,0,0,,Луна, сен бүгін жақсы нәрсе көрдің бе? ➡
Dialogue: 0,0:11:12.37,0:11:17.37,Default,,0,0,0,,Бүгін қалада тапқан ең әдемі нәрсенің суретін сал.
Dialogue: 0,0:11:18.37,0:11:21.21,Default,,0,0,0,,Маған тамақ ұнайды➡
Dialogue: 0,0:11:21.21,0:11:24.11,Default,,0,0,0,,Ол қызыл және дәмді көрінеді.
Dialogue: 0,0:11:29.38,0:11:31.39,Default,,0,0,0,,《Мен сені тағы көргім келеді》
Dialogue: 0,0:11:38.99,0:11:42.80,Default,,0,0,0,,《Лунамен бірге болғанда жүрегім тазарады》
Dialogue: 0,0:11:46.17,0:11:48.17,Default,,0,0,0,,《Күту》
Dialogue: 0,0:11:56.01,0:11:58.01,Default,,0,0,0,,Луна?
Dialogue: 0,0:12:02.35,0:12:09.02,Default,,0,0,0,,＜Ойланбай тұрып, қолым өздігінен қозғалып кетті.＞
Dialogue: 0,0:12:09.02,0:12:11.69,Default,,0,0,0,,This is the boy from the other day~
Dialogue: 0,0:12:11.69,0:12:17.70,Default,,0,0,0,,<Мен оның сөздері мен фигурасын қадағалағым келді>
Dialogue: 0,0:12:43.32,0:12:45.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:45.33,0:12:47.63,Default,,0,0,0,,<Анри сөйлей алмайды сурет>
Dialogue: 0,0:12:57.34,0:13:00.84,Default,,0,0,0,,<Мені салғаныңызға рахмет>
Dialogue: 0,0:13:00.84,0:13:04.18,Default,,0,0,0,,<Мен сенімен танысқым келді, Луна>
Dialogue: 0,0:13:04.18,0:13:08.38,Default,,0,0,0,,<Бірақ менің сыртқы түрім бұрынғыдан да немқұрайлы емес пе? ＞
Dialogue: 0,0:13:11.02,0:13:14.19,Default,,0,0,0,,Мен сенімен қайта кездесуді жоспарлаған жоқпын...
Dialogue: 0,0:13:14.19,0:13:20.19,Default,,0,0,0,,Егер сіз оны суретке салсаңыз, ол сізге қиындық тудырады ...
Dialogue: 0,0:13:22.03,0:13:25.20,Default,,0,0,0,,But if you don't draw it properly
Dialogue: 0,0:13:25.20,0:13:28.87,Default,,0,0,0,,Сіз шықпауыңыз мүмкін
Dialogue: 0,0:13:28.87,0:13:31.54,Default,,0,0,0,,Өзімді ақтап алдым
Dialogue: 0,0:13:31.54,0:13:36.81,Default,,0,0,0,,Қозғалмайтын сурет болса да, мен сенімен танысқым келеді.
Dialogue: 0,0:13:36.81,0:13:41.15,Default,,0,0,0,,Мен сені енді көрмеуім керек... Кешіріңіз.
Dialogue: 0,0:13:41.15,0:13:45.32,Default,,0,0,0,,But I'm so happy to meet you.
Dialogue: 0,0:13:45.32,0:13:47.32,Default,,0,0,0,,Эренді тоқтату үшін. Көпшілік кісі өлтіру – қате.
Dialogue: 0,0:13:49.82,0:13:53.33,Default,,0,0,0,,<Луна жылама>
Dialogue: 0,0:13:53.33,0:13:56.33,Default,,0,0,0,,<Your tears are beautiful though>
Dialogue: 0,0:13:56.33,0:13:58.63,Default,,0,0,0,,<Мен сенің күлген жүзіңді көргім келеді>
Dialogue: 0,0:13:59.67,0:14:04.67,Default,,0,0,0,,<I can't even wipe your tears right now>
Dialogue: 0,0:14:05.67,0:14:07.68,Default,,0,0,0,,<It's frustrating>
Dialogue: 0,0:14:07.68,0:14:10.68,Default,,0,0,0,,<Luna, even at that time...>
Dialogue: 0,0:14:10.68,0:14:15.52,Default,,0,0,0,,<Айлы би кезінде де көзіңе жас келді>
Dialogue: 0,0:14:15.52,0:14:18.69,Default,,0,0,0,,<Көшеде сөйлескенде де>
Dialogue: 0,0:14:18.69,0:14:21.52,Default,,0,0,0,,<Did I do something? ＞
Dialogue: 0,0:14:21.52,0:14:24.03,Default,,0,0,0,,<Did I make you sad? ＞
Dialogue: 0,0:14:24.03,0:14:26.03,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:14:26.03,0:14:28.53,Default,,0,0,0,,Қуаныштымын
Dialogue: 0,0:14:28.53,0:14:33.47,Default,,0,0,0,,Мен бірінші рет біреудің осылай жұмсақ қолын тигізуім еді.
Dialogue: 0,0:14:33.47,0:14:37.47,Default,,0,0,0,,That makes me so happy and happy...
Dialogue: 0,0:14:37.47,0:14:43.31,Default,,0,0,0,,Қуанғаным сонша, сонымен бірге бітті деп қынжыламын
Dialogue: 0,0:14:43.31,0:14:49.32,Default,,0,0,0,,Мен мұндай бақытты ешқашан білмедім.
Dialogue: 0,0:14:49.32,0:14:51.32,Default,,0,0,0,,Әлі де қорқамын
Dialogue: 0,0:14:51.32,0:14:56.12,Default,,0,0,0,,Мен бақытты бола алмадым, бірақ мен қатты қорқамын
Dialogue: 0,0:14:57.66,0:15:00.16,Default,,0,0,0,,What more do I want?
Dialogue: 0,0:15:00.16,0:15:06.67,Default,,0,0,0,,Біреудің... Мен сенің бақытыңды құртатын сияқтымын.
Dialogue: 0,0:15:08.84,0:15:11.51,Default,,0,0,0,,<Луна, жарайды>
Dialogue: 0,0:15:11.51,0:15:15.01,Default,,0,0,0,,<Happy times will continue for Luna>
Dialogue: 0,0:15:15.01,0:15:17.01,Default,,0,0,0,,<Уәде>
Dialogue: 0,0:15:17.01,0:15:19.01,Default,,0,0,0,,<Let's go with me>
Dialogue: 0,0:15:19.01,0:15:21.82,Default,,0,0,0,,<Одан артық болуы мүмкін емес бақыттан>
Dialogue: 0,0:15:23.02,0:15:26.85,Default,,0,0,0,,<Оңай жоғалмайтын бақыт табу>
Dialogue: 0,0:15:26.85,0:15:29.56,Default,,0,0,0,,<Осылай уақыт өткізуді жалғастырайық>
Dialogue: 0,0:15:30.69,0:15:34.30,Default,,0,0,0,,<Мен Луна үшін бәрін жасаймын>
Dialogue: 0,0:15:34.30,0:15:37.00,Default,,0,0,0,,<Мен сенімен мәңгі бірге болғым келеді>
Dialogue: 0,0:15:38.13,0:15:40.47,Default,,0,0,0,,<Мені сал, Луна>
Dialogue: 0,0:15:40.47,0:15:43.30,Default,,0,0,0,,<Мәңгілік және мәңгі>
Dialogue: 0,0:15:43.30,0:15:47.14,Default,,0,0,0,,<Жарайды, мен үшін уайымдама>
Dialogue: 0,0:15:47.14,0:15:49.14,Default,,0,0,0,,<Түсінген Луна>
Dialogue: 0,0:15:49.14,0:15:54.35,Default,,0,0,0,,<Мен үшін болашақта сізбен кездесе алмаудан артық бақыт жоқ.>
Dialogue: 0,0:17:02.65,0:17:05.49,Default,,0,0,0,,Сіз естідіңіз бе? Анри туралы
Dialogue: 0,0:17:05.49,0:17:08.49,Default,,0,0,0,,⚟Соңғы кездері төсек тартып жатырмын.
Dialogue: 0,0:17:08.49,0:17:14.50,Default,,0,0,0,,⚟Дәрігер маған ешнәрсе жоқ дейді, бірақ себебі белгісіз, мен барған сайын арықтай бастадым.
Dialogue: 0,0:17:14.50,0:17:17.83,Default,,0,0,0,,Сен әлгі қара бақсымен кездескен күннен бері есінен танып қалдың ғой?
Dialogue: 0,0:17:17.83,0:17:22.04,Default,,0,0,0,,⚟Анридің отбасы Ақ сиқыршыға шағымданамыз дейді.
Dialogue: 0,0:17:23.67,0:17:25.67,Default,,0,0,0,,Цк
Dialogue: 0,0:17:30.18,0:17:32.45,Default,,0,0,0,,Луна
Dialogue: 0,0:17:32.45,0:17:35.12,Default,,0,0,0,,Бүгін Анридің суретін салмайсың ба?
Dialogue: 0,0:17:35.12,0:17:39.12,Default,,0,0,0,,Мен Анриге бұршақты өткізіп жібереміз деп уәде бердім.
Dialogue: 0,0:17:39.12,0:17:41.29,Default,,0,0,0,,Мен біраз уақытқа дейін сурет салмаймын.
Dialogue: 0,0:17:41.29,0:17:43.29,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:17:43.29,0:17:47.63,Default,,0,0,0,,Өткен күні мен шаршап бара жатқандай болдым.
Dialogue: 0,0:17:47.63,0:17:50.13,Default,,0,0,0,,Сызықтар да өте жұқа болды.
Dialogue: 0,0:17:50.13,0:17:52.47,Default,,0,0,0,,Луна да сенімен кездескісі келеді, солай ма?
Dialogue: 0,0:17:52.47,0:17:55.07,Default,,0,0,0,,Бірақ сызық жұқа болды...
Dialogue: 0,0:17:56.80,0:17:58.81,Default,,0,0,0,,(терезені ашу/жабу дыбысы)
Dialogue: 0,0:17:58.81,0:18:01.11,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:18:02.14,0:18:04.15,Default,,0,0,0,,Бұл…
Dialogue: 0,0:18:04.15,0:18:06.48,Default,,0,0,0,,Мен сені кездестірмейтін шығармын, ақымақ бақсы!
Dialogue: 0,0:18:06.48,0:18:08.98,Default,,0,0,0,,Қарға қорқынышты! Гах!
Dialogue: 0,0:18:10.82,0:18:13.32,Default,,0,0,0,,Мен үлкенмін!
Dialogue: 0,0:18:13.32,0:18:15.32,Default,,0,0,0,,Эй
Dialogue: 0,0:18:15.32,0:18:18.13,Default,,0,0,0,,Менің не істегенімді өзіңіз көріңіз.
Dialogue: 0,0:18:48.96,0:18:50.96,Default,,0,0,0,,Көресіңдер әлі
Dialogue: 0,0:18:50.96,0:18:54.46,Default,,0,0,0,,Сізде сиқырлы күш болса да, сіз жай ғана адамсыз.
Dialogue: 0,0:18:54.46,0:18:58.30,Default,,0,0,0,,Оған қаншалықты салмақ түсетінін білмеймін.
Dialogue: 0,0:18:58.30,0:19:00.30,Default,,0,0,0,,Анри…
Dialogue: 0,0:19:00.30,0:19:05.47,Default,,0,0,0,,Сендей күші бар бақсы мынандай әрекет жасаса...
Dialogue: 0,0:19:05.47,0:19:08.64,Default,,0,0,0,,Адамдар мен Ақ бақсы айтқандай.
Dialogue: 0,0:19:08.64,0:19:11.85,Default,,0,0,0,,Қара бақсының алдауы жетеді!
Dialogue: 0,0:19:13.15,0:19:15.15,Default,,0,0,0,,Анри…
Dialogue: 0,0:19:15.15,0:19:17.55,Default,,0,0,0,,Тамшылатқышты дұрыс кигеніңізге көз жеткізіңіз.
Dialogue: 0,0:19:29.33,0:19:33.13,Default,,0,0,0,,Бұл Лунаның саңырауқұлақтары.
Dialogue: 0,0:19:34.10,0:19:37.27,Default,,0,0,0,,Сен мені көруге келдің бе? ➡
Dialogue: 0,0:19:37.27,0:19:39.27,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:20:15.81,0:20:20.31,Default,,0,0,0,,<Анридің жүрегінен уланумен бірге алынған>
Dialogue: 0,0:20:20.31,0:20:24.65,Default,,0,0,0,,<Лунаның сезімдері мен естеліктерін сіңірген сол саңырауқұлақ>
Dialogue: 0,0:20:24.65,0:20:27.99,Default,,0,0,0,,<Кез келген бақсы шығарған саңырауқұлақтардан көбірек>
Dialogue: 0,0:20:27.99,0:20:32.99,Default,,0,0,0,,＜Әдемі және мәңгілік, гүл сияқты＞
Dialogue: 0,0:20:32.99,0:20:38.50,Default,,0,0,0,,<Осындай сұлу бақсыға деген сезімім жүрегімде гүлдей жайнады>
Dialogue: 0,0:20:38.50,0:20:41.30,Default,,0,0,0,,<Бақсылар бәрінен де бақытты>
Dialogue: 0,0:20:42.84,0:20:47.84,Default,,0,0,0,,《＜Луна бәрібір, менімен барайық＞》
Dialogue: 0,0:20:47.84,0:20:50.85,Default,,0,0,0,,《＜Болмайтын бақыттан басқа＞》
Dialogue: 0,0:20:50.85,0:20:52.85,Default,,0,0,0,,<Анри маған берді>
Dialogue: 0,0:20:52.85,0:20:58.65,Default,,0,0,0,,<Бұдан былай қандай жағдай болса да, бұл бақыт ешқашан сөнбейді, жоғалмайды...>
Dialogue: 0,0:21:01.52,0:21:07.03,Default,,0,0,0,,<Осы түнде бақсы жүрегімді өртеп жіберді>
Dialogue: 0,0:21:07.03,0:21:09.03,Default,,0,0,0,,<Анри…>
Dialogue: 0,0:21:13.53,0:21:15.54,Default,,0,0,0,,<Рахмет>
Dialogue: 0,0:21:22.21,0:21:25.41,Default,,0,0,0,,Сәлем! Анри!
Dialogue: 0,0:21:26.55,0:21:28.72,Default,,0,0,0,,Мен өзімді қазір әлдеқайда жақсы сезінемін.
Dialogue: 0,0:21:28.72,0:21:31.72,Default,,0,0,0,,Мен үшін не істеп жатырсың?
Dialogue: 0,0:21:31.72,0:21:33.82,Default,,0,0,0,,Ахах... кешіріңіз
Dialogue: 0,0:21:33.82,0:21:37.16,Default,,0,0,0,,⚟Себебі белгісіз қандай ауру болды?➡
Dialogue: 0,0:21:37.16,0:21:41.36,Default,,0,0,0,,Қара бақсының қарғысы туралы қауесет тарады, бірақ ол рас па?
Dialogue: 0,0:21:42.33,0:21:46.17,Default,,0,0,0,,Қара сиқыршы? Не айтқың келеді? ол
Dialogue: 0,0:21:46.17,0:21:49.84,Default,,0,0,0,,⚟Ой...жаман адам болып кет
Dialogue: 0,0:21:49.84,0:21:53.54,Default,,0,0,0,,Ахаха... Не дегеніңіз?
Dialogue: 0,0:22:01.35,0:22:03.35,Default,,0,0,0,,Жарайды
Dialogue: 0,0:22:08.69,0:22:11.69,Default,,0,0,0,,<Ал уақыт өтеді...>
Dialogue: 0,0:22:14.53,0:22:18.37,Default,,0,0,0,,<Қара бақсы тазартудың ізі бірте-бірте күшейе түседі>
Dialogue: 0,0:22:18.37,0:22:22.37,Default,,0,0,0,,<Бақсының аяғы қаладан бұрынғысынан да алыста...>
Dialogue: 0,0:22:25.21,0:22:27.37,Default,,0,0,0,,Қара, қара, Мелино
Dialogue: 0,0:22:27.37,0:22:30.88,Default,,0,0,0,,Лунаның аяғындағы суда саңырауқұлақтар өсіп тұр.
Dialogue: 0,0:22:30.88,0:22:33.38,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:22:39.15,0:22:41.16,Default,,0,0,0,,<Осындай кездерде...>
Dialogue: 0,0:22:48.66,0:22:51.07,Default,,0,0,0,,Луна қара!
Dialogue: 0,0:22:52.33,0:22:54.34,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:22:58.17,0:23:02.68,Default,,0,0,0,,<Мен және сиқыршы Луна осылай кездестік>
Dialogue: 0,0:23:04.18,0:23:16.69,Default,,0,0,0,,♬～
Dialogue: 0,0:23:18.19,0:23:24.19,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory