Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.84,0:00:10.51,Default,,0,0,0,,Сіз әлі оянған жоқсыз ба?
Dialogue: 0,0:00:10.51,0:00:12.84,Default,,0,0,0,,Иә
Dialogue: 0,0:00:12.84,0:00:15.68,Default,,0,0,0,,Бір қорқынышты нәрсе болды...
Dialogue: 0,0:00:15.68,0:00:18.01,Default,,0,0,0,,《Мен бұл баланы өсіремін》
Dialogue: 0,0:00:18.01,0:00:20.85,Default,,0,0,0,,《Мен сені міндетті түрде сиқыршы жасаймын》
Dialogue: 0,0:00:20.85,0:00:23.85,Default,,0,0,0,,《(Құс сиқыршысы) Бір күні ол бала өмірінің соңы болады➡》
Dialogue: 0,0:00:23.85,0:00:26.36,Default,,0,0,0,,《Ешкім білмейді》
Dialogue: 0,0:00:26.36,0:00:29.02,Default,,0,0,0,,《(Мысық сиқыршы) Мен Лунаға сенемін》
Dialogue: 0,0:00:29.02,0:00:31.19,Default,,0,0,0,,《Мен сенемін...》
Dialogue: 0,0:00:32.53,0:00:37.87,Default,,0,0,0,,Көрдім, әлгі мысықтың ең соңғы шыққан сиқыршысы.
Dialogue: 0,0:00:37.87,0:00:39.84,Default,,0,0,0,,Сіз бір-біріңізді таныдыңыз ба?
Dialogue: 0,0:00:48.54,0:01:37.03,Default,,0,0,0,,♬～
Dialogue: 0,0:02:26.74,0:02:32.11,Default,,0,0,0,,<Бұл Сисси қара мысық Лунаның үйіне келгенге дейінгі оқиға>
Dialogue: 0,0:02:34.52,0:02:37.19,Default,,0,0,0,,Әй, солай емес пе? ➡
Dialogue: 0,0:02:37.19,0:02:42.26,Default,,0,0,0,,Ол осы қара орманда өмір сүріп, ерекше жағдайларға байланысты қара бақсы болды➡
Dialogue: 0,0:02:42.26,0:02:45.86,Default,,0,0,0,,Шампиньон ведьмы Луна➡
Dialogue: 0,0:02:45.86,0:02:50.37,Default,,0,0,0,,Қараңдар! Сол баланың жүріп, қол тигізген жері➡
Dialogue: 0,0:02:50.37,0:02:52.87,Default,,0,0,0,,Саңырауқұлақтар шынымен өседі!
Dialogue: 0,0:02:52.87,0:02:54.87,Default,,0,0,0,,Сәлем Дороти
Dialogue: 0,0:02:54.87,0:02:58.87,Default,,0,0,0,,Егер сіз қарап тұрғанын білсеңіз, дыбыс деңгейін сәл төмендетіңіз.
Dialogue: 0,0:02:58.87,0:03:01.04,Default,,0,0,0,,Жоқ, мен оны жек көремін!
Dialogue: 0,0:03:01.04,0:03:03.48,Default,,0,0,0,,Тыңдап тұрсың ба? Дороти
Dialogue: 0,0:03:03.48,0:03:06.82,Default,,0,0,0,,Мен білемін! жарғанат шебері
Dialogue: 0,0:03:06.82,0:03:09.89,Default,,0,0,0,,Біз қара сиқыршыларымыздың өкіліміз.
Dialogue: 0,0:03:09.89,0:03:14.06,Default,,0,0,0,,Мен мұнда жаңадан келгендерді барлау үшін келдім.
Dialogue: 0,0:03:15.49,0:03:18.83,Default,,0,0,0,,《Эй, эй! Біртүрлі жігіт бар сияқты! 》
Dialogue: 0,0:03:18.83,0:03:21.50,Default,,0,0,0,,《Кеттік! Сондай ұятсыз! 》
Dialogue: 0,0:03:22.50,0:03:26.17,Default,,0,0,0,,Ешкім мұны сұрамаса да, өкіл?
Dialogue: 0,0:03:26.17,0:03:29.50,Default,,0,0,0,,Бұл тітіркендіргіш! Тінтуір шебері!
Dialogue: 0,0:03:29.50,0:03:31.51,Default,,0,0,0,,Допты жұлып алған адам — біздің Хью Хадсон мектебінің мақтанышы —
Dialogue: 0,0:03:31.51,0:03:34.18,Default,,0,0,0,,<Мен қазір үйге барғым келеді...> <Шу-у-улейтін сенсің...>
Dialogue: 0,0:03:34.18,0:03:39.25,Default,,0,0,0,,<(Дороти) Біз бұл уланған әлемді сиқырдың күшімен тазартамыз.>
Dialogue: 0,0:03:39.25,0:03:41.85,Default,,0,0,0,,<Осы әлемді ешкім білмей қорғаңыз>
Dialogue: 0,0:03:41.85,0:03:45.52,Default,,0,0,0,,<Мақтаншақ қара сиқыршы қара сиқыршы>
Dialogue: 0,0:03:45.52,0:03:49.02,Default,,0,0,0,,Шәкірт... Дайын!
Dialogue: 0,0:03:49.02,0:03:51.09,Default,,0,0,0,,Шампиньон сиқыршысы…
Dialogue: 0,0:03:51.09,0:03:55.70,Default,,0,0,0,,Шәкірттігін әрең аяқтап, қара бақсы болды деп естідім.
Dialogue: 0,0:03:55.70,0:03:57.70,Default,,0,0,0,,Сіз қандай әдісті қолдандыңыз...
Dialogue: 0,0:03:57.70,0:03:59.70,Default,,0,0,0,,Сіз қызғанасыз ба?
Dialogue: 0,0:03:59.70,0:04:01.70,Default,,0,0,0,,Егер күдікті болса, мен...
Dialogue: 0,0:04:01.70,0:04:06.14,Default,,0,0,0,,Қараңдар! Бір нәрсені байқап тұрған сияқты! ➡
Dialogue: 0,0:04:06.14,0:04:09.98,Default,,0,0,0,,Балалар, сендер уже тітіркендірдіңдер! Жасыру!
Dialogue: 0,0:04:09.98,0:04:13.65,Default,,0,0,0,,<(Жарқанат/тышқан) Біраздан бері сен ғана сөйлеп тұрсың...>
Dialogue: 0,0:04:15.82,0:04:20.89,Default,,0,0,0,,Қызық, сол өсектер рас па... Өсек-аяң?
Dialogue: 0,0:04:20.89,0:04:24.49,Default,,0,0,0,,Ол бұрынғы қарғыс атқан бала (Дороти) Иә?
Dialogue: 0,0:04:24.49,0:04:26.50,Default,,0,0,0,,Менің туа біткен сиқырлы күштеріме рахмет
Dialogue: 0,0:04:26.50,0:04:29.00,Default,,0,0,0,,Олай болмаған сияқты.
Dialogue: 0,0:04:29.00,0:04:31.33,Default,,0,0,0,,<Бұл қарғыс атқан бала! ? ＞
Dialogue: 0,0:04:31.33,0:04:35.40,Default,,0,0,0,,Оның қалдықтары бар ма? Оның денесінде және тынысында өсетін саңырауқұлақтар➡
Dialogue: 0,0:04:35.40,0:04:37.67,Default,,0,0,0,,Барлығы улы.
Dialogue: 0,0:04:37.67,0:04:41.18,Default,,0,0,0,,Жоқ! не? бұл! өрескел! ➡
Dialogue: 0,0:04:41.18,0:04:43.25,Default,,0,0,0,,Неге олай... Тсшш!
Dialogue: 0,0:04:43.25,0:04:45.25,Default,,0,0,0,,(Тышқан аузын жауып тұрғанда сөйлейді)
Dialogue: 0,0:04:45.25,0:04:49.85,Default,,0,0,0,,Ей, біз тым анықпыз, сондықтан абай болыңыз және ол туралы бірдеңе жасаңыз➡
Dialogue: 0,0:04:49.85,0:04:52.72,Default,,0,0,0,,Мен шай дайындай бастадым.
Dialogue: 0,0:04:55.69,0:05:01.13,Default,,0,0,0,,<Осындай сұмдық баланың да баяғы қара бақсы болғаны ақымақ>
Dialogue: 0,0:05:01.13,0:05:03.80,Default,,0,0,0,,<Бұл қара бақсының масқарасы>
Dialogue: 0,0:05:03.80,0:05:09.47,Default,,0,0,0,,<Тіпті бізге туыс емес қара бақсылар да адамдардан жаман әсер қалдыруы мүмкін...>
Dialogue: 0,0:05:10.47,0:05:16.31,Default,,0,0,0,,Жарайды... Менің қожайыным аң шебері де сол балаға жақсы қарайтынын естідім.
Dialogue: 0,0:05:16.31,0:05:19.65,Default,,0,0,0,,Қожаңнан үлгі алып, тіл табысу мүмкін болмаса да...
Dialogue: 0,0:05:19.65,0:05:22.98,Default,,0,0,0,,Тым болмаса арақашықтықты тыныш ұстасақ ше?
Dialogue: 0,0:05:22.98,0:05:24.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:24.99,0:05:26.99,Default,,0,0,0,,Не...?
Dialogue: 0,0:05:26.99,0:05:30.66,Default,,0,0,0,,Тым қиналғандықтан оған ерекше күтім жасалды, тіпті шәкірт болмаса да, ұстаздың өзі оқытты.
Dialogue: 0,0:05:30.66,0:05:33.50,Default,,0,0,0,,Бұндай тәртіп бұзғандарды оңалтуда мұндай құрметті студенттерді елемеуден басқа амалымыз жоқ.
Dialogue: 0,0:05:33.50,0:05:38.17,Default,,0,0,0,,Баланың менің қожайынымды қиналған мұғалімнің орнына итеріп жатқанына сене алар емеспін!
Dialogue: 0,0:05:38.17,0:05:42.44,Default,,0,0,0,,<Қызғаныш, қызғаныш...> <Бұл ақылсыз аударма>
Dialogue: 0,0:05:43.51,0:05:47.84,Default,,0,0,0,,Қандай бала... Мен сені кешіре алмаймын... Мен ренжідім!
Dialogue: 0,0:05:47.84,0:05:51.18,Default,,0,0,0,,Сіз маған қожайыныңыздың атын айтасыз...
Dialogue: 0,0:05:51.18,0:05:53.18,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:05:53.18,0:05:56.02,Default,,0,0,0,,(Бақалардың айқайы)
Dialogue: 0,0:05:56.02,0:05:58.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:58.02,0:06:01.02,Default,,0,0,0,,Шай берудің бұл жолы қандай?
Dialogue: 0,0:06:01.02,0:06:03.79,Default,,0,0,0,,Нашар мінез-құлық!
Dialogue: 0,0:06:03.79,0:06:05.79,Default,,0,0,0,,<(Дороти) Мен сені қорлап, қуып жіберемін! ＞
Dialogue: 0,0:06:05.79,0:06:08.13,Default,,0,0,0,,<Қара бақсы аймағынан>
Dialogue: 0,0:06:08.13,0:06:10.90,Default,,0,0,0,,(шай құйып жатқан дыбыс)
Dialogue: 0,0:06:12.20,0:06:16.67,Default,,0,0,0,,(шай құйып жатқан дыбыс)
Dialogue: 0,0:06:17.97,0:06:21.94,Default,,0,0,0,,<(Дороти) Иә? Неліктен бұлай болды...? ＞
Dialogue: 0,0:06:23.04,0:06:26.82,Default,,0,0,0,,<Адам ретінде жақсы мінез-құлық болмағаны ұят...>
Dialogue: 0,0:06:26.82,0:06:29.32,Default,,0,0,0,,Саған жақсылық, Луна
Dialogue: 0,0:06:29.32,0:06:31.99,Default,,0,0,0,,Күні кеше мен кітап оқу арқылы шәй ішу туралы білдім.
Dialogue: 0,0:06:31.99,0:06:36.49,Default,,0,0,0,,Сіз оны бір рет көргіңіз келетінін айттыңыз.
Dialogue: 0,0:06:36.49,0:06:39.33,Default,,0,0,0,,<Иә...? ＞
Dialogue: 0,0:06:39.33,0:06:43.20,Default,,0,0,0,,<Ой, бұл мені тыныштандырмайды>
Dialogue: 0,0:06:44.33,0:06:48.17,Default,,0,0,0,,Бұл кәмпит улы денеден жасалған емес пе?
Dialogue: 0,0:06:48.17,0:06:51.24,Default,,0,0,0,,Қорыққаным сонша, тамақ іше алмаймын.
Dialogue: 0,0:06:51.24,0:06:53.51,Default,,0,0,0,,<Бұл жігіт ең жаман...>
Dialogue: 0,0:06:53.51,0:06:55.51,Default,,0,0,0,,Е-е-а-а-а-а... (Мелинью) Жақсы екен, Луна.
Dialogue: 0,0:06:55.51,0:06:59.18,Default,,0,0,0,,Әңгімелесу! Әңгімелесу! Эй, сәттілік!
Dialogue: 0,0:06:59.18,0:07:01.12,Default,,0,0,0,,<Иә? ＞
Dialogue: 0,0:07:01.12,0:07:05.79,Default,,0,0,0,,Осы уақытқа дейін маған ешкім жақындаған жоқ, хаха.
Dialogue: 0,0:07:05.79,0:07:09.79,Default,,0,0,0,,<(Дороти, Тышқан, Бат) Зұлымдықты түсіну тым бақытсыз>
Dialogue: 0,0:07:09.79,0:07:13.13,Default,,0,0,0,,Ол печеньелерді қолмен ұстамай жасайды.
Dialogue: 0,0:07:13.13,0:07:15.20,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:07:15.20,0:07:18.37,Default,,0,0,0,,Маған да көп әдептілік үйретілді.
Dialogue: 0,0:07:20.47,0:07:24.81,Default,,0,0,0,,Бірінші тұтынушыңыз жақсы адам болғанына қуаныштымын.
Dialogue: 0,0:07:24.81,0:07:27.81,Default,,0,0,0,,Бүгін өте жақсы күн, солай емес пе?
Dialogue: 0,0:07:27.81,0:07:31.48,Default,,0,0,0,,Мен мұны саған жей аламын.
Dialogue: 0,0:07:31.48,0:07:33.45,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:37.82,0:07:40.82,Default,,0,0,0,,<Бақсы мысық абдырап қалды>
Dialogue: 0,0:07:40.82,0:07:43.83,Default,,0,0,0,,<У жойылды деп айтуға болады>
Dialogue: 0,0:07:43.83,0:07:47.33,Default,,0,0,0,,<Күтпеген жерден күтпеген жерден жауын алды>
Dialogue: 0,0:07:47.33,0:07:52.40,Default,,0,0,0,,<Онда тараған жалғыз иістің күтпеген тереңдігі>
Dialogue: 0,0:07:52.40,0:07:57.41,Default,,0,0,0,,＜Менің жеккөрінішті жүрегім шайқас позасын дұрыс құра алмайды＞
Dialogue: 0,0:07:57.41,0:08:01.68,Default,,0,0,0,,<Өзіме ренжіген шығармын>
Dialogue: 0,0:08:03.51,0:08:11.29,Default,,0,0,0,,＜Енді ойлап қарасам, осы уақытқа дейін мен ``жақсы адам'' сөзімен ешқандай байланысым болған емес...＞
Dialogue: 0,0:08:11.29,0:08:13.79,Default,,0,0,0,,⚟Міне, әлгі қара бақсы.
Dialogue: 0,0:08:13.79,0:08:18.86,Default,,0,0,0,,⚟Ұры мысықты тамақтандырсаңыз, түнде шуылдаса
Dialogue: 0,0:08:18.86,0:08:23.63,Default,,0,0,0,,⚟Күріш те жойылмайтын пайдасыз заттар.
Dialogue: 0,0:08:23.63,0:08:25.63,Default,,0,0,0,,Бұл сен кінәлісің!
Dialogue: 0,0:08:25.63,0:08:28.30,Default,,0,0,0,,Мені қатты жек көреді!
Dialogue: 0,0:08:28.30,0:08:30.64,Default,,0,0,0,,Себебі мен егеуқұйрық қақпағын реттеп жатырмын.
Dialogue: 0,0:08:30.64,0:08:32.97,Default,,0,0,0,,Уф...!
Dialogue: 0,0:08:32.97,0:08:37.65,Default,,0,0,0,,Оған көмектесу мүмкін емес, өйткені таныссыз жұмыс жоқ.
Dialogue: 0,0:08:37.65,0:08:39.98,Default,,0,0,0,,Біз, ақпарат жинау тобы,
Dialogue: 0,0:08:39.98,0:08:42.65,Default,,0,0,0,,Қаладағы адамдармен тіл табысу керек!
Dialogue: 0,0:08:42.65,0:08:44.72,Default,,0,0,0,,Рахмет...
Dialogue: 0,0:08:44.72,0:08:46.72,Default,,0,0,0,,Бұл ел болса да
Dialogue: 0,0:08:46.72,0:08:49.49,Default,,0,0,0,,Қара бақсының бейнесі ең сорақы және оны жасау қиын!
Dialogue: 0,0:08:49.49,0:08:51.66,Default,,0,0,0,,Жетті. Мен сені де, әпкеңді де өлтіремін.
Dialogue: 0,0:08:53.56,0:08:56.13,Default,,0,0,0,,А... а...
Dialogue: 0,0:08:57.57,0:09:01.57,Default,,0,0,0,,Сіз қауесетті саңырауқұлақ сиқыршысысыз ба?
Dialogue: 0,0:09:01.57,0:09:04.01,Default,,0,0,0,,Жоқ, жақында дүкеннің алдында күдікті әрекет болды...
Dialogue: 0,0:09:04.01,0:09:07.68,Default,,0,0,0,,Мен айналада қыдырып жүрген адамдар бар деп ойладым➡
Dialogue: 0,0:09:07.68,0:09:11.51,Default,,0,0,0,,Ол мысық сиқыршылармен таныс болса керек.
Dialogue: 0,0:09:11.51,0:09:14.18,Default,,0,0,0,,Біз бір-бірімізді танитын сияқты емеспіз...
Dialogue: 0,0:09:14.18,0:09:17.02,Default,,0,0,0,,Бірақ ол қиын емес пе? ➡
Dialogue: 0,0:09:17.02,0:09:19.09,Default,,0,0,0,,Сізді қорлады ма?
Dialogue: 0,0:09:19.09,0:09:21.09,Default,,0,0,0,,Допты жұлып алған адам — біздің Хью Хадсон мектебінің мақтанышы —
Dialogue: 0,0:09:21.09,0:09:24.53,Default,,0,0,0,,Бұл сен кінәлісің! Қал, қал, қал...
Dialogue: 0,0:09:24.53,0:09:27.20,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:09:27.20,0:09:29.53,Default,,0,0,0,,Сөйлестім бе?
Dialogue: 0,0:09:29.53,0:09:32.20,Default,,0,0,0,,Ол өте жақсы адам.
Dialogue: 0,0:09:32.20,0:09:37.04,Default,,0,0,0,,Сіздің арқаңызда мен өзім қалаған кітап дүкеніне бара алдым.
Dialogue: 0,0:09:37.04,0:09:39.87,Default,,0,0,0,,Мен үшін тек қуанышты нәрселерді жасаңыз
Dialogue: 0,0:09:39.87,0:09:42.21,Default,,0,0,0,,Ол өте мейірімді адам.
Dialogue: 0,0:09:42.21,0:09:44.21,Default,,0,0,0,,Ха...
Dialogue: 0,0:09:44.21,0:09:49.78,Default,,0,0,0,,Ей, әлгі сиқыршы мысық мейірімді емес...
Dialogue: 0,0:09:50.89,0:09:52.95,Default,,0,0,0,,<Осы уақыттан бастап, мысық сиқыршы>
Dialogue: 0,0:09:52.95,0:09:57.73,Default,,0,0,0,,<Мені «мейірімді адам» немесе «жақсы адам» сияқты сөздермен бомбалаған сайын...>
Dialogue: 0,0:09:57.73,0:09:59.79,Default,,0,0,0,,<Ой...> <Сиқырлағандай>
Dialogue: 0,0:09:59.79,0:10:04.73,Default,,0,0,0,,<Ол сөзбен жеткізгісіз таңғалдыра бастады.>
Dialogue: 0,0:10:04.73,0:10:08.34,Default,,0,0,0,,<Бірте-бірте атын атауға болмайтын бұл сезім...> (Есік ашылады)
Dialogue: 0,0:10:08.34,0:10:12.31,Default,,0,0,0,,<Енді мен саңырауқұлақтар үйіне толтыру үшін бара аламын>
Dialogue: 0,0:10:13.34,0:10:15.34,Default,,0,0,0,,Луна Мен оқығым келген кітап
Dialogue: 0,0:10:15.34,0:10:17.85,Default,,0,0,0,,Оны маған қарызға бергеніңізге қуаныштымын. Уау...
Dialogue: 0,0:10:17.85,0:10:22.68,Default,,0,0,0,,Қаладағы кішкентай құс: ''Мысық сиқыршыларының ішегі бұралған'' деп ән салып жатты.
Dialogue: 0,0:10:22.68,0:10:25.19,Default,,0,0,0,,Бұл мүлде олай емес.
Dialogue: 0,0:10:25.19,0:10:31.26,Default,,0,0,0,,Соңғы кездері жақсы күндер көп болды, өйткені мейірімділік сиқыршысы маған көп келеді.
Dialogue: 0,0:10:31.26,0:10:33.86,Default,,0,0,0,,<Қосымсыз мақтаулар нөсері>
Dialogue: 0,0:10:33.86,0:10:38.83,Default,,0,0,0,,<Бақсының бұзық жүрегі жарылып кетті>
Dialogue: 0,0:11:03.83,0:11:08.16,Default,,0,0,0,,Luna's poisonous constitution is due to her being a former cursed child.
Dialogue: 0,0:11:08.16,0:11:13.23,Default,,0,0,0,,Бұл дүниенің уын алып, тазартатыны үшін! Сіз білдіңіз бе?
Dialogue: 0,0:11:13.23,0:11:16.67,Default,,0,0,0,,There are people who say bad things about Luna without even knowing that.
Dialogue: 0,0:11:16.67,0:11:18.67,Default,,0,0,0,,Unbelievable! ➡
Dialogue: 0,0:11:18.67,0:11:22.51,Default,,0,0,0,,That sucks! Луна туралы ештеңе білуге тырыспаңыз
Dialogue: 0,0:11:22.51,0:11:26.01,Default,,0,0,0,,Мен сол жігітті көп тыңдауым керек еді.
Dialogue: 0,0:11:26.01,0:11:29.78,Default,,0,0,0,,Қолайсыз жері – ми сиқырды ұмытуға ұшырайды.
Dialogue: 0,0:11:31.85,0:11:36.19,Default,,0,0,0,,Бұрын осы қара орманда ағаштар мен тіршілік иелері улы заттармен ластанған➡
Dialogue: 0,0:11:36.19,0:11:39.19,Default,,0,0,0,,Бұл зиянкестер мен зұлым рухтардың үйі болды, бірақ...
Dialogue: 0,0:11:39.19,0:11:44.03,Default,,0,0,0,,Сен мұнда тұра бастағаннан бері қара орман емес, улы саңырауқұлақ орманы болды.
Dialogue: 0,0:11:44.03,0:11:47.37,Default,,0,0,0,,Мысықтар да жан тыныштығымен ойнай алады.
Dialogue: 0,0:11:47.37,0:11:51.44,Default,,0,0,0,,Hey, my nickname "Dorothy-san" is a bit of a stranger's behavior.
Dialogue: 0,0:11:51.44,0:11:53.71,Default,,0,0,0,,Сіз мені «Дороти апа» деп атай аласыз.
Dialogue: 0,0:11:53.71,0:11:56.21,Default,,0,0,0,,<Кенеттен маған соқты...>
Dialogue: 0,0:11:56.21,0:11:59.71,Default,,0,0,0,,Ах... Жаса... О... Эй...
Dialogue: 0,0:11:59.71,0:12:02.32,Default,,0,0,0,,Сиқыршы...
Dialogue: 0,0:12:02.32,0:12:06.32,Default,,0,0,0,,How to close the distance This is what happens when you're not good at it...
Dialogue: 0,0:12:06.32,0:12:10.66,Default,,0,0,0,,Сіз қалай мысық сиқыршы болдыңыз?
Dialogue: 0,0:12:10.66,0:12:14.33,Default,,0,0,0,,Бұл мен мысықтарды жақсы көретіндіктен!
Dialogue: 0,0:12:14.33,0:12:18.17,Default,,0,0,0,,You too, right? саңырауқұлақ
Dialogue: 0,0:12:18.17,0:12:20.50,Default,,0,0,0,,Жақсы, солай ма?
Dialogue: 0,0:12:20.50,0:12:26.57,Default,,0,0,0,,Did you know? Тек мысықтар мекендейтін аңызға айналған мысық орманы болса керек.
Dialogue: 0,0:12:26.57,0:12:31.58,Default,,0,0,0,,Ол жерге атақты мысық бақсылардың біразы шақырылғанға ұқсайды.
Dialogue: 0,0:12:31.58,0:12:33.58,Default,,0,0,0,,<Мысық орманы…>
Dialogue: 0,0:12:33.58,0:12:36.52,Default,,0,0,0,,Менің де тез арада барғым келеді.
Dialogue: 0,0:12:36.52,0:12:41.36,Default,,0,0,0,,Мүмкін менің бақсылық тәжірибем аз болғандықтан шығар, бірақ мысық орманының басшысы бекіткен жоқ➡
Dialogue: 0,0:12:41.36,0:12:45.03,Default,,0,0,0,,Әй, маған не болды? Хмм...
Dialogue: 0,0:12:45.03,0:12:47.53,Default,,0,0,0,,《(Ақсақал) Дороти, ол Аканья》
Dialogue: 0,0:12:47.53,0:12:52.20,Default,,0,0,0,,《Шулы ня, еріндері бос ня, қауіпті ня》 《Дұрыс, ня》
Dialogue: 0,0:12:52.20,0:12:56.04,Default,,0,0,0,,Бірақ сіз білесіз бе, мен оның қандай екенін түсінемін➡
Dialogue: 0,0:12:56.04,0:12:58.37,Default,,0,0,0,,Мен мұны мына балалардан сезінемін➡
Dialogue: 0,0:12:58.37,0:13:00.54,Default,,0,0,0,,Мен бұрын болған сияқтымын
Dialogue: 0,0:13:00.54,0:13:04.81,Default,,0,0,0,,Мүмкін мен бұрынғы өмірімде мысық болып, сонда тұрған шығармын?
Dialogue: 0,0:13:04.81,0:13:08.48,Default,,0,0,0,,Мен ол жерге тезірек барғым келеді ~ Мысық орманы
Dialogue: 0,0:13:08.48,0:13:11.82,Default,,0,0,0,,Менің арманым бір күні мысық орманына бару.
Dialogue: 0,0:13:11.82,0:13:15.66,Default,,0,0,0,,Қара бақсылар ақылға сыймайтын мына улы дүниеден тез бас тарт.
Dialogue: 0,0:13:15.66,0:13:19.99,Default,,0,0,0,,Ешкім шағымданбай, сүйікті мысықтарыммен қоршалған
Dialogue: 0,0:13:19.99,0:13:23.83,Default,,0,0,0,,Біз сонда мәңгі бақытты өмір сүреміз➡
Dialogue: 0,0:13:23.83,0:13:26.17,Default,,0,0,0,,Мен әрқашан солай ойладым~➡
Dialogue: 0,0:13:26.17,0:13:32.17,Default,,0,0,0,,Мен уды тазартудан бас тартпаймын, шампиньон сиқыршысымен кездескенше барымды саламын➡
Dialogue: 0,0:13:32.17,0:13:35.51,Default,,0,0,0,,Қара орманды көрген соң әдемі болып кетті.
Dialogue: 0,0:13:35.51,0:13:41.18,Default,,0,0,0,,Мен үлкен әпке және аға қара бақсы ретінде қолымнан келгеннің бәрін жасамаймын.
Dialogue: 0,0:13:42.58,0:13:46.35,Default,,0,0,0,,<Көрінбейтін туған қала мысық орманы>
Dialogue: 0,0:13:46.35,0:13:50.02,Default,,0,0,0,,<Бірақ мен әлі мысық орманына орала алмаймын>
Dialogue: 0,0:13:50.02,0:13:53.10,Default,,0,0,0,,Басқа улы сиқыршылар сияқты мен де уды жою миссиясындамын...
Dialogue: 0,0:13:56.10,0:14:00.97,Default,,0,0,0,,⚟Дороти Ақ бақсы сарайына кірген скумбрия мысық кешеден бері жоғалып кетті.
Dialogue: 0,0:14:00.97,0:14:04.47,Default,,0,0,0,,⚟Мен оның ауланғанына сенімдімін ⚟Бұл неше балық?
Dialogue: 0,0:14:04.47,0:14:07.81,Default,,0,0,0,,⚟Не істеуім керек... ⚟Не істеуім керек...
Dialogue: 0,0:14:07.81,0:14:10.14,Default,,0,0,0,,Сәлем, сәлем, танысқаныма қуаныштымын
Dialogue: 0,0:14:10.14,0:14:12.48,Default,,0,0,0,,Скумбрия мысық енді тірі емес
Dialogue: 0,0:14:12.48,0:14:14.82,Default,,0,0,0,,Көмекке бару абайсызда болар еді!
Dialogue: 0,0:14:14.82,0:14:19.15,Default,,0,0,0,,Мен әлі білмеймін! Бұл жағдайда мен барлаушы деп күдіктендім.
Dialogue: 0,0:14:19.15,0:14:23.22,Default,,0,0,0,,Қалай болғанда да, мен де, мысық та тазартуға ұшырайды!
Dialogue: 0,0:14:23.22,0:14:29.50,Default,,0,0,0,,Сонымен қатар, қамалда заңсыз тұтқынға алынған көптеген қараңғы сиқыршылар бар! ➡
Dialogue: 0,0:14:29.50,0:14:31.83,Default,,0,0,0,,Сисси, сендер жүгіріңдер! ➡
Dialogue: 0,0:14:31.83,0:14:36.67,Default,,0,0,0,,Осы жағдайды қожайыныңызға және достарыңызға айтыңыз! Уф...
Dialogue: 0,0:14:36.67,0:14:39.17,Default,,0,0,0,,Мен бұл абыржуды пайдаланып, қамалға кірдім.
Dialogue: 0,0:14:39.17,0:14:44.15,Default,,0,0,0,,Скумбрия мысықтарына көмектесіп, ақ бақсыларға көпіршікті үрлейік!
Dialogue: 0,0:14:45.85,0:14:47.92,Default,,0,0,0,,Дороти, бұл қауіпті!
Dialogue: 0,0:14:47.92,0:14:50.52,Default,,0,0,0,,Барлығы қашып құтылу үшін бір айла болуы керек.
Dialogue: 0,0:14:50.52,0:14:52.85,Default,,0,0,0,,Жарайды, әпкем➡
Dialogue: 0,0:14:52.85,0:14:56.69,Default,,0,0,0,,Маған берген сөздерің есіме түссе, батылдық пайда болады.
Dialogue: 0,0:14:56.69,0:14:58.69,Default,,0,0,0,,《Ол мейірімді адам》
Dialogue: 0,0:14:58.69,0:15:02.46,Default,,0,0,0,,Мен кім болғым келетінін барлығын қорғағым келеді.
Dialogue: 0,0:15:04.13,0:15:06.63,Default,,0,0,0,,<(Дороти) Бұл атаусыз сезім>
Dialogue: 0,0:15:06.63,0:15:11.14,Default,,0,0,0,,＜Оларды мұқият жинап, бір бөлігін қалдырмай мықтап ұстаңыз＞
Dialogue: 0,0:15:11.14,0:15:14.14,Default,,0,0,0,,<Егер мен ондай болмасам, онда мен>
Dialogue: 0,0:15:14.14,0:15:17.41,Default,,0,0,0,,<Себебі мен әлі мысық орманына қайта барғым келмейді...>
Dialogue: 0,0:15:33.33,0:15:37.20,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:15:46.41,0:15:51.68,Default,,0,0,0,,Міне, кеше Дороти өлім жазасына кесілген алаң➡
Dialogue: 0,0:15:51.68,0:15:55.52,Default,,0,0,0,,Келгеніңіз үшін рахмет, Шампиньон ведьмасы
Dialogue: 0,0:15:55.52,0:15:57.85,Default,,0,0,0,,Тінтуір шебері...
Dialogue: 0,0:15:57.85,0:16:01.86,Default,,0,0,0,,Мен тығылып жатқанда осылай көрінгенім үшін кешіріңіз.
Dialogue: 0,0:16:01.86,0:16:06.13,Default,,0,0,0,,(Мысықтар мияулайды)
Dialogue: 0,0:16:15.47,0:16:19.54,Default,,0,0,0,,<Осы өлкеге сіңген мысық бақсы>
Dialogue: 0,0:16:19.54,0:16:23.54,Default,,0,0,0,,<Мунентаке Курушимитаке…>
Dialogue: 0,0:16:23.54,0:16:27.48,Default,,0,0,0,,<Киофутаке>
Dialogue: 0,0:16:27.48,0:16:31.55,Default,,0,0,0,,<Mijimetake Kodokutake…>
Dialogue: 0,0:16:31.55,0:16:34.49,Default,,0,0,0,,Сисиді қараңыз
Dialogue: 0,0:16:34.49,0:16:39.76,Default,,0,0,0,,Доротидің азабы саңырауқұлаққа айналып, тазартылады.
Dialogue: 0,0:16:45.83,0:16:48.50,Default,,0,0,0,,А... уф...
Dialogue: 0,0:16:52.84,0:16:55.51,Default,,0,0,0,,Ясашиитаке?
Dialogue: 0,0:16:56.68,0:16:59.15,Default,,0,0,0,,Ха... (Сисси тышқан) Ах...
Dialogue: 0,0:17:01.45,0:17:05.95,Default,,0,0,0,,Жоқ, енді көп жылама.
Dialogue: 0,0:17:05.95,0:17:07.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:07.96,0:17:09.92,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:17:13.03,0:17:15.63,Default,,0,0,0,,(Мысықтар мияулайды)
Dialogue: 0,0:17:15.63,0:17:21.90,Default,,0,0,0,,Луна: Сиқыршы мысық бұл балалардың мысық орманына барғанын айтты.
Dialogue: 0,0:17:32.31,0:17:34.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:34.98,0:17:38.32,Default,,0,0,0,,《(Дороти) Мен Лунаға сенемін➡》
Dialogue: 0,0:17:38.32,0:17:40.39,Default,,0,0,0,,《Мен сенемін...》
Dialogue: 0,0:17:40.39,0:17:43.99,Default,,0,0,0,,Уф… ха ха ха ха…
Dialogue: 0,0:17:43.99,0:17:50.46,Default,,0,0,0,,Сәлем, сәлем, танысқаныма қуаныштымын
Dialogue: 0,0:17:54.00,0:17:56.67,Default,,0,0,0,,《(ханшайым) Сүйкімді Нұх》
Dialogue: 0,0:17:58.07,0:18:00.07,Default,,0,0,0,,Ол қара түсті, себебі онда жаңа кальмар сиясы бар
Dialogue: 0,0:18:00.07,0:18:02.51,Default,,0,0,0,,《(ыңылдады)》
Dialogue: 0,0:18:02.51,0:18:05.85,Default,,0,0,0,,《(ханшайым) Өтінемін тез өліңіз》
Dialogue: 0,0:18:05.85,0:18:07.85,Default,,0,0,0,,《(бөтелке сынды)》
Dialogue: 0,0:18:07.85,0:18:11.52,Default,,0,0,0,,《(Патшайым) Мен сенің қайта туылуыңа жол бермеймін》 《》
Dialogue: 0,0:18:12.85,0:18:15.36,Default,,0,0,0,,《(Патшайым) Осы ел үшін➡》
Dialogue: 0,0:18:15.36,0:18:19.53,Default,,0,0,0,,《Осы дүние үшін де...》
Dialogue: 0,0:18:21.86,0:18:23.83,Default,,0,0,0,,Ой, жоқ!
Dialogue: 0,0:18:31.37,0:18:36.38,Default,,0,0,0,,《(Патшайым) Сіз ешқашан туылмауыңыз керек еді➡》
Dialogue: 0,0:18:36.38,0:18:39.45,Default,,0,0,0,,《Сені өлі адам ету үшін➡》
Dialogue: 0,0:18:39.45,0:18:43.72,Default,,0,0,0,,《Менің жауапкершілігімді саған марқұм әпкем сеніп тапсырған》
Dialogue: 0,0:18:43.72,0:18:49.69,Default,,0,0,0,,《Ең болмаса ештеңе білмей өл.》
Dialogue: 0,0:18:52.23,0:18:54.23,Default,,0,0,0,,《＜Мамауе-сама…＞》
Dialogue: 0,0:18:54.23,0:18:58.30,Default,,0,0,0,,《(Соқтығыс дыбысы)》 《Уау! Ах! 》
Dialogue: 0,0:18:58.30,0:19:00.40,Default,,0,0,0,,《＜Неге...＞》
Dialogue: 0,0:19:00.40,0:19:02.37,Default,,0,0,0,,《＜Неге...! ＞》
Dialogue: 0,0:19:12.68,0:19:15.35,Default,,0,0,0,,<Кім?＞
Dialogue: 0,0:19:15.35,0:19:18.35,Default,,0,0,0,,<Менің естеліктерім...>
Dialogue: 0,0:19:18.35,0:19:21.36,Default,,0,0,0,,<Сіз ауырсынуды жұтып жатырсыз ба? ＞
Dialogue: 0,0:19:21.36,0:19:25.86,Default,,0,0,0,,<Ауыр естеліктер, мұңды естеліктер>
Dialogue: 0,0:19:25.86,0:19:29.86,Default,,0,0,0,,<Қара эмоциялар, қобалжу бұралаңы>
Dialogue: 0,0:19:29.86,0:19:33.93,Default,,0,0,0,,<Азап шегу, соққыдан кейінгі сурет>
Dialogue: 0,0:19:33.93,0:19:36.94,Default,,0,0,0,,<Оған қатыстының бәрі>
Dialogue: 0,0:19:36.94,0:19:40.37,Default,,0,0,0,,<Әй, осыншама алып кетсең ше?>
Dialogue: 0,0:19:40.37,0:19:44.55,Default,,0,0,0,,<Сіздің қалған естеліктеріңіз жоғалып кете жаздады.>
Dialogue: 0,0:19:47.45,0:19:53.89,Default,,0,0,0,,<Түсіндім, бұл менің осы уақытқа дейін жүріп өткен жол туралы>
Dialogue: 0,0:19:53.89,0:19:57.89,Default,,0,0,0,,＜Сізді қайғыға батқан болуыңыз керек...＞
Dialogue: 0,0:19:57.89,0:20:00.83,Default,,0,0,0,,<Әдемі...>
Dialogue: 0,0:20:00.83,0:20:05.70,Default,,0,0,0,,<Менен алыстаған мұңның түсі>
Dialogue: 0,0:20:07.17,0:20:09.44,Default,,0,0,0,,<Жоқ! ＞
Dialogue: 0,0:20:17.51,0:20:22.35,Default,,0,0,0,,<Ұмытуға болмайтын асыл естеліктер...>
Dialogue: 0,0:20:22.35,0:20:27.22,Default,,0,0,0,,<Бұл менің марқұм анаммен берген уәдем>
Dialogue: 0,0:20:28.19,0:20:33.19,Default,,0,0,0,,《(Ана) Ноа Ноэл Эмиль》
Dialogue: 0,0:20:33.19,0:20:36.76,Default,,0,0,0,,《Сіздің атыңыз көп》
Dialogue: 0,0:20:38.20,0:20:40.87,Default,,0,0,0,,《Кім бір күні патша болады》
Dialogue: 0,0:20:40.87,0:20:44.94,Default,,0,0,0,,《Көп бүркеншік аттарды қолданып өмір сүру➡》
Dialogue: 0,0:20:44.94,0:20:49.94,Default,,0,0,0,,《Ешқашан шын есіміңді көрсетпе》
Dialogue: 0,0:20:49.94,0:20:55.55,Default,,0,0,0,,《Шын есіміңді жария ету қарғыс нысанасын әшкерелеумен бірдей➡》
Dialogue: 0,0:20:55.55,0:21:01.56,Default,,0,0,0,,《Патша өзінің шын атын ашса, оның тағына бірден қауіп төнеді➡》
Dialogue: 0,0:21:01.56,0:21:07.33,Default,,0,0,0,,《Тұрақсыз тағы бар патшалық қараңғылық әлемін жасайды➡》
Dialogue: 0,0:21:07.33,0:21:11.67,Default,,0,0,0,,《Шын есімің сиқыр қолданғанда ғана белгілі болады➡》
Dialogue: 0,0:21:11.67,0:21:15.34,Default,,0,0,0,,《Жүрегімде ән айтқаным》 《Аа...》
Dialogue: 0,0:21:15.34,0:21:18.84,Default,,0,0,0,,《Егер сіз өз атыңызды білмесеңіз》
Dialogue: 0,0:21:18.84,0:21:24.18,Default,,0,0,0,,《Ешқандай қарғыс сізге өлімге әкелуі мүмкін емес➡》
Dialogue: 0,0:21:24.18,0:21:30.85,Default,,0,0,0,,《Ешқашан мен саған қойған осы есімді ұмытпа➡》
Dialogue: 0,0:21:30.85,0:21:34.69,Default,,0,0,0,,《Оны жүрегіңнің түбінде сақта➡》
Dialogue: 0,0:21:34.69,0:21:36.96,Default,,0,0,0,,《Сіздің атыңыз...》
Dialogue: 0,0:21:40.19,0:21:42.70,Default,,0,0,0,,Ах! Хаха
Dialogue: 0,0:21:42.70,0:21:45.77,Default,,0,0,0,,Луна! Мен ояндым➡
Dialogue: 0,0:21:45.77,0:21:50.37,Default,,0,0,0,,Эй, сен кімсің? Эй, жақсысың ба?
Dialogue: 0,0:21:50.37,0:21:54.71,Default,,0,0,0,,Эй, сен түсінген шығарсың, Луна.
Dialogue: 0,0:21:54.71,0:21:58.28,Default,,0,0,0,,<Иә? Менің денем...>
Dialogue: 0,0:21:59.38,0:22:03.55,Default,,0,0,0,,<Бұл кішкентай болды ма? ＞
Dialogue: 0,0:22:03.55,0:22:09.16,Default,,0,0,0,,<Мен оянғанға дейін қандай болдым? ＞
Dialogue: 0,0:22:09.16,0:22:11.83,Default,,0,0,0,,Бастау маңызды.
Dialogue: 0,0:22:11.83,0:22:17.80,Default,,0,0,0,,Бұл жігітті сиқыршыға айналдыра алмасақ, ол жойылады.
Dialogue: 0,0:22:18.83,0:22:24.91,Default,,0,0,0,,Жеке сезімдеріңізді тастаңыз және оларға қатал қарым-қатынас жасаңыз...
Dialogue: 0,0:22:24.91,0:22:28.08,Default,,0,0,0,,Эй, сенің атың кім?
Dialogue: 0,0:22:30.68,0:22:33.35,Default,,0,0,0,,《(Ана) Ұмытпа》
Dialogue: 0,0:22:33.35,0:22:36.22,Default,,0,0,0,,《Сіздің атыңыз...》
Dialogue: 0,0:22:40.19,0:22:42.19,Default,,0,0,0,,Лизель
Dialogue: 0,0:22:42.19,0:23:30.77,Default,,0,0,0,,♬～
