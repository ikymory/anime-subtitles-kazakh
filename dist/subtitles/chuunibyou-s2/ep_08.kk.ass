Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:07.09,Default,,0,0,0,,Мен көремін. Біз ұрыс даласында жүргенде
Dialogue: 0,0:00:08.01,0:00:10.01,Default,,0,0,0,,Саңылауды қараңғылық басып өтеді.
Dialogue: 0,0:00:11.05,0:00:13.09,Default,,0,0,0,,Бұл мүлде басқа әлемдік сызық.
Dialogue: 0,0:00:14.02,0:00:15.07,Default,,0,0,0,,Қалай ойласаң да, солай шығар.
Dialogue: 0,0:00:17.00,0:00:18.07,Default,,0,0,0,,Жоқ, бұл біртүрлі сезім
Dialogue: 0,0:00:19.07,0:00:23.03,Default,,0,0,0,,Қараңғылық әлемі осы уақытқа дейін жаулап алды ма?
Dialogue: 0,0:00:23.08,0:00:24.08,Default,,0,0,0,,Оның артында қандай себеп тұрса да,
Dialogue: 0,0:00:26.01,0:00:27.02,Default,,0,0,0,,Шварц Шуц
Dialogue: 0,0:00:28.01,0:00:30.03,Default,,0,0,0,,А Тогаши-кун мен Рикка-чан
Dialogue: 0,0:00:30.04,0:00:31.02,Default,,0,0,0,,Қайта оралдын.
Dialogue: 0,0:00:31.05,0:00:33.07,Default,,0,0,0,,Мектеп саяхаты қалай өтті?
Dialogue: 0,0:00:33.09,0:00:35.09,Default,,0,0,0,,Иә, мен абдырап қалдым.
Dialogue: 0,0:00:36.01,0:00:37.04,Default,,0,0,0,,Бұл көңілді болар еді
Dialogue: 0,0:00:37.08,0:00:40.02,Default,,0,0,0,,Екеуің бірге қаланы араладыңдар, солай ма?
Dialogue: 0,0:00:40.04,0:00:42.08,Default,,0,0,0,,А, бұл жаңалық.
Dialogue: 0,0:00:43.03,0:00:46.07,Default,,0,0,0,,Schwarzzechs Perfect Customization Gelzoniansus
Dialogue: 0,0:00:46.09,0:00:48.01,Default,,0,0,0,,Оны араластырмаңыз
Dialogue: 0,0:00:48.05,0:00:49.05,Default,,0,0,0,,Гельзони
Dialogue: 0,0:00:49.07,0:00:51.04,Default,,0,0,0,,Қайырлы таң Өлім
Dialogue: 0,0:00:51.04,0:00:55.01,Default,,0,0,0,,О, Герзониант мырза және Өлім, қожайын емес кім?
Dialogue: 0,0:00:55.01,0:00:56.04,Default,,0,0,0,,Сондықтан оны араластырмаңыз.
Dialogue: 0,0:00:57.06,0:00:58.02,Default,,0,0,0,,Декомори
Dialogue: 0,0:01:00.08,0:01:03.04,Default,,0,0,0,,Неге таң қалдыңыз, ұстаз?
Dialogue: 0,0:01:05.06,0:01:07.02,Default,,0,0,0,,Өлшемдері де бұрмаланған
Dialogue: 0,0:01:12.00,0:01:15.09,Default,,0,0,0,,Мен ғашық болғым келеді
Dialogue: 0,0:01:28.08,0:01:32.04,Default,,0,0,0,,Арманың жалғасын тапсын
Dialogue: 0,0:01:32.09,0:01:38.03,Default,,0,0,0,,Уәде берсем де, жүрегім бір жерден қорқады, ауырады
Dialogue: 0,0:01:38.08,0:01:44.03,Default,,0,0,0,,Мен жалғыз емес екенімді сенгім келеді
Dialogue: 0,0:01:44.03,0:01:49.09,Default,,0,0,0,,Мен сені ойлау арқылы бақыттымын деп айта алмаймын
Dialogue: 0,0:01:49.09,0:01:53.01,Default,,0,0,0,,Мен бос сеніммен жүрсем де
Dialogue: 0,0:01:53.02,0:02:00.01,Default,,0,0,0,,Күліп, менің батылдығыма айналасың
Dialogue: 0,0:02:00.01,0:02:04.05,Default,,0,0,0,,Бір сөзбен әлеміңді өзгерте алсам
Dialogue: 0,0:02:04.06,0:02:10.06,Default,,0,0,0,,Екі махаббат дамитыны рас.
Dialogue: 0,0:02:10.06,0:02:15.06,Default,,0,0,0,,Мен ойлану арқылы таптым
Dialogue: 0,0:02:15.08,0:02:18.04,Default,,0,0,0,,Мен әрқашан сенің жолыңмен жүрдім
Dialogue: 0,0:02:18.04,0:02:23.00,Default,,0,0,0,,Мен оны жеткізуге дайын болмасам да
Dialogue: 0,0:02:23.00,0:02:25.04,Default,,0,0,0,,Мен сізге шынымды айтқым келеді
Dialogue: 0,0:02:25.04,0:02:28.03,Default,,0,0,0,,Менің жүрегім қандай болса, менің даусым жарқырайды
Dialogue: 0,0:02:28.03,0:02:34.02,Default,,0,0,0,,дауысты бұзса, ол жаңғырық береді
Dialogue: 0,0:02:40.05,0:02:42.02,Default,,0,0,0,,Бұл нағыз Морисама
Dialogue: 0,0:02:42.03,0:02:43.07,Default,,0,0,0,,C Қатты дауыс
Dialogue: 0,0:02:44.04,0:02:45.05,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:02:46.01,0:02:47.09,Default,,0,0,0,,Нақты ештеңе болмайды.
Dialogue: 0,0:02:48.02,0:02:49.09,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:02:50.03,0:02:52.08,Default,,0,0,0,,Бірақ сіз кездестім дейсіз.
Dialogue: 0,0:02:53.03,0:02:59.02,Default,,0,0,0,,Морисама-чан мен оның достары мектепте саяхатта жүргенде веб-сайтта кездескен сияқты.
Dialogue: 0,0:02:59.06,0:02:59.56,Default,,0,0,0,,Міне, келдік
Dialogue: 0,0:03:03.05,0:03:05.00,Default,,0,0,0,,Сәттілік Өлім
Dialogue: 0,0:03:05.02,0:03:08.01,Default,,0,0,0,,Біз сізді күттік, Морисама мырза.
Dialogue: 0,0:03:08.07,0:03:13.03,Default,,0,0,0,,Сәттілік, мен сені күттім, Саня.
Dialogue: 0,0:03:14.02,0:03:15.04,Default,,0,0,0,,Бұл Санья.
Dialogue: 0,0:03:16.01,0:03:17.09,Default,,0,0,0,,Бірақ сол қолдағы асыл тас
Dialogue: 0,0:03:18.04,0:03:20.02,Default,,0,0,0,,Бұл Морисамердің белгісі.
Dialogue: 0,0:03:21.03,0:03:26.04,Default,,0,0,0,,Бүгін де сиқыршы Морисама сізге жол көрсетуге келді.
Dialogue: 0,0:03:26.09,0:03:27.08,Default,,0,0,0,,Иә өлім
Dialogue: 0,0:03:28.01,0:03:29.06,Default,,0,0,0,,Рахмет
Dialogue: 0,0:03:29.09,0:03:33.04,Default,,0,0,0,,Алдымен өзімізбен және аруақтармен тазартамыз.
Dialogue: 0,0:03:33.07,0:03:36.05,Default,,0,0,0,,Қолдарыңызды біріктіріп, тыныш көзіңізді жұмыңыз.
Dialogue: 0,0:03:36.06,0:03:37.01,Default,,0,0,0,,Иә
Dialogue: 0,0:03:50.04,0:03:51.02,Default,,0,0,0,,Бітті
Dialogue: 0,0:03:51.08,0:03:52.07,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:53.01,0:03:55.01,Default,,0,0,0,,Сиқырлы тазартатын құрылғы шығар
Dialogue: 0,0:03:56.01,0:03:57.09,Default,,0,0,0,,Қалай қарасаң да, сандық фотоаппарат шығар.
Dialogue: 0,0:03:58.04,0:04:02.00,Default,,0,0,0,,Бірақ бұл әйел несі?
Dialogue: 0,0:04:03.04,0:04:08.03,Default,,0,0,0,,Сонымен, олар қайтып келгенде, мен оларға өзімнің қатысуымды хабарладым.
Dialogue: 0,0:04:08.06,0:04:09.04,Default,,0,0,0,,Иә, өлім
Dialogue: 0,0:04:09.06,0:04:13.06,Default,,0,0,0,,Бір күні мен жалған Жазға Морисама-саманың бар екенін хабарлаймын.
Dialogue: 0,0:04:14.07,0:04:16.04,Default,,0,0,0,,Үрген жүз Жасырын өлім
Dialogue: 0,0:04:16.08,0:04:17.05,Default,,0,0,0,,Санья
Dialogue: 0,0:04:17.09,0:04:21.02,Default,,0,0,0,,Мұндай жаман жүректі адамдарға қарамау керек.
Dialogue: 0,0:04:22.02,0:04:26.04,Default,,0,0,0,,Әрине, өзін морисамерлер деп көрсететін қарапайым адамдар бар.
Dialogue: 0,0:04:26.07,0:04:30.09,Default,,0,0,0,,Сенің жүрегің ұсқынсыз, бұрмаланғанына сенімдімін.
Dialogue: 0,0:04:31.00,0:04:35.02,Default,,0,0,0,,На Бірақ мұндай нәрселерді жек көретін болсаңыз
Dialogue: 0,0:04:35.05,0:04:38.03,Default,,0,0,0,,Таза Сәнияның өзі де арам болады.
Dialogue: 0,0:04:38.07,0:04:40.04,Default,,0,0,0,,Маңыздысы – махаббат
Dialogue: 0,0:04:40.09,0:04:44.08,Default,,0,0,0,,Себебі сен біреуді алдаудан басқа амалы жоқ ақымақ шіріген қарапайым адамсың.
Dialogue: 0,0:04:45.02,0:04:48.01,Default,,0,0,0,,Біз ақырын жүргізуіміз керек
Dialogue: 0,0:04:49.07,0:04:52.09,Default,,0,0,0,,Әй, қызық екен, анау әйел.
Dialogue: 0,0:04:54.03,0:04:55.01,Default,,0,0,0,,Келісімді пайдаланбай-ақ мені одақтасың қыла аласың деп ойладың ғой?
Dialogue: 0,0:04:57.03,0:04:58.09,Default,,0,0,0,,Сіз фейксіз
Dialogue: 0,0:04:59.06,0:05:02.00,Default,,0,0,0,,Сіз бұл жалған емес деп айтасыз.
Dialogue: 0,0:05:02.03,0:05:06.00,Default,,0,0,0,,Әй, онда менің атымды өтірік айттың.
Dialogue: 0,0:05:07.08,0:05:09.03,Default,,0,0,0,,Қайсысы өтірік айтады?
Dialogue: 0,0:05:09.06,0:05:11.08,Default,,0,0,0,,Рұқсатсыз басты бетті жасаңыз
Dialogue: 0,0:05:12.03,0:05:15.03,Default,,0,0,0,,О, мен Саньядан естідім.
Dialogue: 0,0:05:15.06,0:05:17.07,Default,,0,0,0,,Қалайша өзіңізді сонша өтірік айта аласыз?
Dialogue: 0,0:05:17.09,0:05:21.00,Default,,0,0,0,,Сенің жүрегің шынымен лас, солай емес пе?
Dialogue: 0,0:05:21.06,0:05:22.09,Default,,0,0,0,,Сенің түрің осындай
Dialogue: 0,0:05:24.06,0:05:25.06,Default,,0,0,0,,Морисама-сама
Dialogue: 0,0:05:25.06,0:05:27.00,Default,,0,0,0,,Сіз алыс болуыңыз керек.
Dialogue: 0,0:05:27.00,0:05:28.00,Default,,0,0,0,,О, Санья
Dialogue: 0,0:05:28.02,0:05:29.06,Default,,0,0,0,,Бұл не, Санья?
Dialogue: 0,0:05:29.09,0:05:30.04,Default,,0,0,0,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:05:30.06,0:05:33.09,Default,,0,0,0,,Бұл менмін. Мен сен сияқты шынайы болмысымды жасырамын.
Dialogue: 0,0:05:34.00,0:05:36.06,Default,,0,0,0,,Мен жақсы адамдар сияқты әрекет ететін әйелдерді жек көремін.
Dialogue: 0,0:05:36.08,0:05:38.00,Default,,0,0,0,,Сіз мұны айтасыз ба?
Dialogue: 0,0:05:38.03,0:05:40.01,Default,,0,0,0,,Әңгімені үзбеңіз
Dialogue: 0,0:05:40.06,0:05:44.07,Default,,0,0,0,,Демек, сен нағыз Морисамерсің бе?
Dialogue: 0,0:05:44.08,0:05:45.05,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:05:45.07,0:05:48.04,Default,,0,0,0,,Ендеше, жеке басын неге жасыру керек?
Dialogue: 0,0:05:48.09,0:05:53.02,Default,,0,0,0,,Мен оның қасиетті кітап Мабиногионды өртеуге әрекеттенгенін естідім.
Dialogue: 0,0:05:53.03,0:05:54.05,Default,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:05:54.05,0:05:55.05,Default,,0,0,0,,Өлім
Dialogue: 0,0:05:55.08,0:05:58.09,Default,,0,0,0,,Сіз фейк болғаныңыз үшін солай істедіңіз.
Dialogue: 0,0:05:58.09,0:05:59.08,Default,,0,0,0,,Қандай қатыгез қимыл…
Dialogue: 0,0:06:00.02,0:06:01.06,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:06:01.09,0:06:03.03,Default,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:06:04.00,0:06:04.50,Default,,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:06:05.03,0:06:06.02,Default,,0,0,0,,Бұл күрделі.
Dialogue: 0,0:06:06.04,0:06:08.00,Default,,0,0,0,,Жарайды, үндеме.
Dialogue: 0,0:06:11.04,0:06:15.02,Default,,0,0,0,,Дәлелдерді ертең әкелемін деп айту жақсы идея болды ма?
Dialogue: 0,0:06:15.07,0:06:18.04,Default,,0,0,0,,Сіз бұл жерден шегінуге болмайды.
Dialogue: 0,0:06:20.04,0:06:23.05,Default,,0,0,0,,Қара тарих ретінде толығымен жойылды.
Dialogue: 0,0:06:23.07,0:06:25.01,Default,,0,0,0,,Ештеңе қалмады
Dialogue: 0,0:06:25.06,0:06:28.00,Default,,0,0,0,,Қол әшекейлері дәлел бола алмайды.
Dialogue: 0,0:06:29.02,0:06:29.52,Default,,0,0,0,,Буггарати мен басқалары шынында да осы пойызға мініпті
Dialogue: 0,0:06:30.06,0:06:33.06,Default,,0,0,0,,Егер бұл орын алса, соңғы шара
Dialogue: 0,0:06:34.07,0:06:36.01,Default,,0,0,0,,Аруақтарға бұйрық беріңіз
Dialogue: 0,0:06:36.04,0:06:37.09,Default,,0,0,0,,Менің өтінішімді тыңда.
Dialogue: 0,0:06:38.01,0:06:39.05,Default,,0,0,0,,Бұл соңғы шара ма?
Dialogue: 0,0:06:40.03,0:06:41.04,Default,,0,0,0,,Күшті сезіну
Dialogue: 0,0:06:42.00,0:06:42.50,Default,,0,0,0,,Жарайды
Dialogue: 0,0:06:43.04,0:06:46.09,Default,,0,0,0,,Іздегенімді 100 хиттен табатынмын.
Dialogue: 0,0:06:47.06,0:06:50.03,Default,,0,0,0,,Көріпкелдікте шындық жоқ дейді.
Dialogue: 0,0:06:50.05,0:06:52.02,Default,,0,0,0,,Үндемей қал, бұл көңіл бөледі
Dialogue: 0,0:06:53.07,0:06:55.03,Default,,0,0,0,,Оны таба алмадыңыз ба?
Dialogue: 0,0:06:56.02,0:06:59.07,Default,,0,0,0,,Өйткені, Нибутани Декомори айтқандай.
Dialogue: 0,0:07:00.00,0:07:00.50,Default,,0,0,0,,Жалған
Dialogue: 0,0:07:01.05,0:07:02.06,Default,,0,0,0,,Б-барлаушы? Не туралы айтып тұрсыздар?
Dialogue: 0,0:07:04.02,0:07:08.02,Default,,0,0,0,,Бірақ кімнің шын екені маңызды емес.
Dialogue: 0,0:07:18.02,0:07:19.02,Default,,0,0,0,,Юта
Dialogue: 0,0:07:19.05,0:07:19.55,Default,,0,0,0,,Иә
Dialogue: 0,0:07:30.01,0:07:33.06,Default,,0,0,0,,Ешқандай дәлел жоқ па?
Dialogue: 0,0:07:34.03,0:07:37.00,Default,,0,0,0,,Мен нағыз адаммын.
Dialogue: 0,0:07:37.01,0:07:39.09,Default,,0,0,0,,Өлім, өйткені жалғандар бәсекелесуге тырысады
Dialogue: 0,0:07:40.01,0:07:43.07,Default,,0,0,0,,Сіз қандай қорқынышты іс істеп жатқаныңызды білмейсіз.
Dialogue: 0,0:07:43.07,0:07:44.08,Default,,0,0,0,,Сендер тым шулысыңдар.
Dialogue: 0,0:07:45.00,0:07:48.06,Default,,0,0,0,,Мен сізге айтамын, сізде ешқандай дәлел жоқ.
Dialogue: 0,0:07:48.09,0:07:50.04,Default,,0,0,0,,Ол таңғаларлық адам.
Dialogue: 0,0:07:50.09,0:07:52.09,Default,,0,0,0,,Менің Морисамер екенімді дәлелдеу
Dialogue: 0,0:07:53.05,0:07:55.02,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:07:56.02,0:07:59.09,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба? Мабиногионды бейнелейтін сиқыршы ретіндегі келбеті
Dialogue: 0,0:08:00.05,0:08:04.01,Default,,0,0,0,,Санья сияқты күші бар адамды көргенде бірден түсінесіз.
Dialogue: 0,0:08:05.01,0:08:06.05,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:08:06.07,0:08:09.05,Default,,0,0,0,,Мен Декомориді көргенде-ақ білдім.
Dialogue: 0,0:08:09.07,0:08:12.07,Default,,0,0,0,,Бұл адам нағыз Морисамер.
Dialogue: 0,0:08:12.08,0:08:16.06,Default,,0,0,0,,Сіз менің шынайымын деп бұрын айттыңыз.
Dialogue: 0,0:08:16.07,0:08:18.07,Default,,0,0,0,,Сіз немен мақтанасыз?
Dialogue: 0,0:08:18.08,0:08:22.04,Default,,0,0,0,,Бұл сізді абайсызда ұстаудың жетілдірілген тактикасы.
Dialogue: 0,0:08:22.04,0:08:23.06,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:08:23.06,0:08:24.06,Default,,0,0,0,,Сенбеңіз
Dialogue: 0,0:08:25.01,0:08:26.03,Default,,0,0,0,,Мен мұны анық айтамын
Dialogue: 0,0:08:26.09,0:08:31.01,Default,,0,0,0,,Мен сенің жалған екеніңді білдім.
Dialogue: 0,0:08:32.00,0:08:36.01,Default,,0,0,0,,Мұндай лас беті бар адамның Морисамер болуы мүмкін емес.
Dialogue: 0,0:08:36.08,0:08:41.02,Default,,0,0,0,,Осыны түсінген соң ойыңды өзгертіп, Саньяны таста.
Dialogue: 0,0:08:43.00,0:08:44.07,Default,,0,0,0,,Дыбыс шығармайтын өлім бе?
Dialogue: 0,0:08:44.09,0:08:46.08,Default,,0,0,0,,Күтілгендей, бұл жай ғана жалған...
Dialogue: 0,0:08:45.08,0:08:46.09,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:08:47.09,0:08:51.06,Default,,0,0,0,,Өткеннің зұлмат тарихы сыртқа шығарылғаны емес.
Dialogue: 0,0:08:51.08,0:08:53.07,Default,,0,0,0,,Оған мән бермеңіз.
Dialogue: 0,0:08:54.06,0:08:58.02,Default,,0,0,0,,Менің Морисамер екенімді растайтын ешқандай дәлел жоқ.
Dialogue: 0,0:08:59.02,0:09:02.01,Default,,0,0,0,,Ақырында сізден азат болу сергітеді.
Dialogue: 0,0:09:02.06,0:09:03.00,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:09:03.07,0:09:04.06,Default,,0,0,0,,Морисама-чан
Dialogue: 0,0:09:06.02,0:09:07.03,Default,,0,0,0,,Эй Нибутани
Dialogue: 0,0:09:08.05,0:09:10.00,Default,,0,0,0,,жалған жаз
Dialogue: 0,0:09:13.01,0:09:16.03,Default,,0,0,0,,Енді сіз дұрыс жолмен жүре аласыз.
Dialogue: 0,0:09:16.08,0:09:17.06,Default,,0,0,0,,Ол да
Dialogue: 0,0:09:18.03,0:09:19.05,Default,,0,0,0,,Морисамер-сама
Dialogue: 0,0:09:28.05,0:09:31.06,Default,,0,0,0,,Ақырында сізден құтылу сергітеді.
Dialogue: 0,0:09:32.01,0:09:35.07,Default,,0,0,0,,Сіз не туралы айтып тұрсыз? Бұл шынымен көңілсіз.
Dialogue: 0,0:09:36.02,0:09:38.05,Default,,0,0,0,,Сана Чан, не болды?
Dialogue: 0,0:09:38.08,0:09:40.06,Default,,0,0,0,,Бүгін өзіңізді жақсы сезінбейтін сияқтысыз.
Dialogue: 0,0:09:41.06,0:09:43.00,Default,,0,0,0,,Бұл ештеңе емес, Өлім.
Dialogue: 0,0:09:43.06,0:09:44.03,Default,,0,0,0,,Иә
Dialogue: 0,0:09:46.09,0:09:50.06,Default,,0,0,0,,Сабақтан кейін менің үйімде Мабиногионды бірге оқиық.
Dialogue: 0,0:09:52.05,0:09:53.07,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:09:56.00,0:09:58.01,Default,,0,0,0,,Оның маған еш қатысы жоқ деп ойлаймын.
Dialogue: 0,0:09:58.06,0:10:01.06,Default,,0,0,0,,Менің ойымша, мұның бір қатысы бар. Бұл сіздің жалғаныңыз.
Dialogue: 0,0:10:02.01,0:10:04.04,Default,,0,0,0,,Тек бұл туралы алаңдамаңыз
Dialogue: 0,0:10:06.08,0:10:07.06,Default,,0,0,0,,(Жаңа атқарушы)
Dialogue: 0,0:10:07.09,0:10:08.06,Default,,0,0,0,,Декомори
Dialogue: 0,0:10:10.01,0:10:12.01,Default,,0,0,0,,Кешегі күн шедевр болды
Dialogue: 0,0:10:12.01,0:10:14.06,Default,,0,0,0,,Сіздің жалғандығыңыз ақыры әшкере болды.
Dialogue: 0,0:10:14.09,0:10:15.09,Default,,0,0,0,,Ақымақ және
Dialogue: 0,0:10:17.07,0:10:18.05,Default,,0,0,0,,Өлімді күту
Dialogue: 0,0:10:18.06,0:10:19.04,Default,,0,0,0,,Не?
Dialogue: 0,0:10:19.04,0:10:21.02,Default,,0,0,0,,Сіз нені ойлап отырсыз?
Dialogue: 0,0:10:21.04,0:10:25.05,Default,,0,0,0,,Декомориден жеңіліп, жалған болып көріну шынымен де көңілсіз болды ма?
Dialogue: 0,0:10:26.02,0:10:26.52,Default,,0,0,0,,Бөлек
Dialogue: 0,0:10:29.00,0:10:30.07,Default,,0,0,0,,Қараңдар, сабақ басталып жатыр.
Dialogue: 0,0:10:32.08,0:10:33.06,Default,,0,0,0,,Қорлар
Dialogue: 0,0:10:33.09,0:10:36.07,Default,,0,0,0,,Адамдар мен үшін мұны істеу үшін қиындық көрсе де,
Dialogue: 0,0:10:38.06,0:10:39.03,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:10:39.07,0:10:40.05,Default,,0,0,0,,Не
Dialogue: 0,0:10:54.03,0:10:56.06,Default,,0,0,0,,Сонымен Деко-чан үйіне қайтты.
Dialogue: 0,0:10:57.00,0:10:58.08,Default,,0,0,0,,Иә Мүмкін емес.
Dialogue: 0,0:10:59.00,0:11:01.03,Default,,0,0,0,,Тоғаши-күн бұл үшін көп жұмыс істеуі керек.
Dialogue: 0,0:11:01.08,0:11:03.07,Default,,0,0,0,,Герзониант мырза деген не?
Dialogue: 0,0:11:03.08,0:11:05.07,Default,,0,0,0,,Өтінемін, егде жастағыларыңызды еске түсірмеңіз
Dialogue: 0,0:11:06.04,0:11:09.00,Default,,0,0,0,,Екеуіңді бөлмеге шақырдым.
Dialogue: 0,0:11:09.02,0:11:11.01,Default,,0,0,0,,Ағымдағы дөңес қорғаныс жарамсыз.
Dialogue: 0,0:11:11.07,0:11:13.03,Default,,0,0,0,,Уақытша қызметшіні іздеу
Dialogue: 0,0:11:13.07,0:11:14.09,Default,,0,0,0,,Сен де сенсің.
Dialogue: 0,0:11:15.08,0:11:18.04,Default,,0,0,0,,Деко-чан, сен шынымен жақсысың ба?
Dialogue: 0,0:11:18.08,0:11:21.03,Default,,0,0,0,,Мен ол адамнан қорқамын.
Dialogue: 0,0:11:21.08,0:11:22.06,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:11:25.07,0:11:26.05,Default,,0,0,0,,Денеңде осындай жарақаттармен қаза таптың, иә?
Dialogue: 0,0:11:27.02,0:11:27.52,Default,,0,0,0,,Ұнады
Dialogue: 0,0:11:28.01,0:11:30.01,Default,,0,0,0,,Әй, – дейді Күмін-сенпай.
Dialogue: 0,0:11:30.01,0:11:32.00,Default,,0,0,0,,Бұл Декомориге ғашық көздер.
Dialogue: 0,0:11:32.04,0:11:34.04,Default,,0,0,0,,Қандай бос сөз айтып тұрсың?
Dialogue: 0,0:11:34.07,0:11:37.01,Default,,0,0,0,,Жоқ, мен де солай ойладым.
Dialogue: 0,0:11:37.05,0:11:38.05,Default,,0,0,0,,Артқа қарау
Dialogue: 0,0:11:39.00,0:11:42.02,Default,,0,0,0,,Декомориге көзқарасым сәл басқаша екені рас.
Dialogue: 0,0:11:44.02,0:11:46.00,Default,,0,0,0,,Дұрыс сөйлескен дұрыс.
Dialogue: 0,0:11:46.07,0:11:48.01,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:11:48.03,0:11:49.07,Default,,0,0,0,,Тіпті егер
Dialogue: 0,0:11:49.09,0:11:52.09,Default,,0,0,0,,Әлгі ақымақ соны қаласа, жарайды.
Dialogue: 0,0:11:53.02,0:11:56.06,Default,,0,0,0,,Қыңыр болу мүмкін емес.
Dialogue: 0,0:11:57.02,0:11:59.07,Default,,0,0,0,,Декомори бұл жігітті Морисама деп ойлайды.
Dialogue: 0,0:11:59.09,0:12:01.08,Default,,0,0,0,,Бұл жиіркенішті дейді.
Dialogue: 0,0:12:02.02,0:12:04.07,Default,,0,0,0,,Мұндай жалған нәрселерге оңай іліну.
Dialogue: 0,0:12:06.02,0:12:07.02,Default,,0,0,0,,Кептеліп қалды ма деп ойлаймын.
Dialogue: 0,0:12:08.02,0:12:12.07,Default,,0,0,0,,Деко-чан Морисама-чанның шынайы болғанын қалайтыныңызға сенімдімін.
Dialogue: 0,0:12:13.01,0:12:13.51,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:12:14.09,0:12:18.05,Default,,0,0,0,,Ақымақтың соншалықты күрделі нәрсені ойлауы мүмкін емес.
Dialogue: 0,0:12:19.03,0:12:19.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:20.08,0:12:21.02,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:21.05,0:12:21.55,Default,,0,0,0,,(Бір күні сені қолға түсіреміз)
Dialogue: 0,0:12:24.04,0:12:25.02,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:12:25.08,0:12:28.05,Default,,0,0,0,,Бұл Деко-чанның суреті шығар.
Dialogue: 0,0:12:32.05,0:12:33.03,Default,,0,0,0,,Ұрыс
Dialogue: 0,0:12:33.07,0:12:37.05,Default,,0,0,0,,А, оны Декомори алдында жекпе-жекке шақырыңыз және оны жеңіңіз.
Dialogue: 0,0:12:38.01,0:12:40.00,Default,,0,0,0,,Морисамер екеніңізді дәлелдеңіз
Dialogue: 0,0:12:40.08,0:12:44.02,Default,,0,0,0,,Өйткені Нибутанидің нағыз Морисама екендігі туралы ешқандай дәлел жоқ.
Dialogue: 0,0:12:44.04,0:12:45.07,Default,,0,0,0,,Бұл ең жақсы әдіс
Dialogue: 0,0:12:46.01,0:12:47.01,Default,,0,0,0,,Хаа
Dialogue: 0,0:12:47.05,0:12:49.03,Default,,0,0,0,,Сіз мұны бұрын жасаған шығарсыз.
Dialogue: 0,0:12:49.06,0:12:51.08,Default,,0,0,0,,Морисама болып көрініп, төбелесіңіз.
Dialogue: 0,0:12:52.04,0:12:54.03,Default,,0,0,0,,Осылайша мен де Рикканың сеніміне ие болдым.
Dialogue: 0,0:12:54.05,0:12:54.55,Default,,0,0,0,,Иә
Dialogue: 0,0:12:55.07,0:12:56.03,Default,,0,0,0,,Ғашық болу
Dialogue: 0,0:12:56.04,0:12:57.01,Default,,0,0,0,,Жоқ
Dialogue: 0,0:12:57.06,0:12:58.09,Default,,0,0,0,,Мен де ұялып тұрмын.
Dialogue: 0,0:12:59.05,0:13:01.06,Default,,0,0,0,,Бірақ бұл туралы ойлануға уақытыңыз жоқ шығар.
Dialogue: 0,0:13:02.01,0:13:05.03,Default,,0,0,0,,Дұрыс, Деко-чанды шынымен де алып кетеді.
Dialogue: 0,0:13:05.06,0:13:07.04,Default,,0,0,0,,Шындығында, мен...
Dialogue: 0,0:13:07.04,0:13:08.08,Default,,0,0,0,,Ах, бұл қазірдің өзінде тітіркендіргіш.
Dialogue: 0,0:13:09.07,0:13:10.07,Default,,0,0,0,,Риккаға барыңыз
Dialogue: 0,0:13:11.09,0:13:12.07,Default,,0,0,0,,Түсінікті.
Dialogue: 0,0:13:13.05,0:13:14.03,Default,,0,0,0,,Не?
Dialogue: 0,0:13:14.04,0:13:15.00,Default,,0,0,0,,Арнайы дайындық
Dialogue: 0,0:13:15.07,0:13:18.07,Default,,0,0,0,,Зұлым патшаның шынайы көзінің күші оның денесінде таңбаланған.
Dialogue: 0,0:13:19.00,0:13:19.50,Default,,0,0,0,,Explode Real
Dialogue: 0,0:13:20.01,0:13:21.03,Default,,0,0,0,,Pop Synapse
Dialogue: 0,0:13:21.06,0:13:24.05,Default,,0,0,0,,Бұл әлемді қуу
Dialogue: 0,0:13:25.06,0:13:25.56,Default,,0,0,0,,Бұл
Dialogue: 0,0:13:26.03,0:13:26.53,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:27.08,0:13:30.03,Default,,0,0,0,,Бұл әлемді қуу
Dialogue: 0,0:13:31.03,0:13:33.06,Default,,0,0,0,,Бұл ғибадатханамен бірдеңе дұрыс емес.
Dialogue: 0,0:13:33.07,0:13:35.02,Default,,0,0,0,,Үйлесімділік деген бар ма?
Dialogue: 0,0:13:35.05,0:13:36.07,Default,,0,0,0,,Бірақ біз не істейміз?
Dialogue: 0,0:13:37.00,0:13:40.05,Default,,0,0,0,,Рикка-чан жұмыс істемесе, Деко-чан да болмайды.
Dialogue: 0,0:13:41.01,0:13:41.51,Default,,0,0,0,,Тоғаши мырза
Dialogue: 0,0:13:42.02,0:13:43.06,Default,,0,0,0,,Мен бітірдім
Dialogue: 0,0:13:44.07,0:13:46.04,Default,,0,0,0,,Сиқырлы жын патша қыз
Dialogue: 0,0:13:47.02,0:13:47.52,Default,,0,0,0,,Шичиномия?
Dialogue: 0,0:13:48.04,0:13:48.54,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:13:49.07,0:13:51.04,Default,,0,0,0,,деді сиқырлы жын қыз
Dialogue: 0,0:13:52.01,0:13:54.08,Default,,0,0,0,,Мен мәңгі сиқырлы жын қыз боламын
Dialogue: 0,0:13:55.08,0:13:59.07,Default,,0,0,0,,Сонымен қатар, Юта екеуміздің келісім-шартымыз абсолютті...
Dialogue: 0,0:14:00.03,0:14:00.53,Default,,0,0,0,,Сонымен
Dialogue: 0,0:14:04.05,0:14:05.04,Default,,0,0,0,,Шақыру
Dialogue: 0,0:14:08.00,0:14:11.08,Default,,0,0,0,,Сиқырлы жын патша қыз София сақинасы SP Сатурн VII
Dialogue: 0,0:14:12.01,0:14:14.02,Default,,0,0,0,,Періштені өлтіретін мен боламын.
Dialogue: 0,0:14:14.05,0:14:15.09,Default,,0,0,0,,Кешіріңіз, осындай уақытта.
Dialogue: 0,0:14:16.04,0:14:19.06,Default,,0,0,0,,Жоқ, ол маған мектептегі саяхатқа көмектесті.
Dialogue: 0,0:14:20.01,0:14:21.02,Default,,0,0,0,,Бірақ бұл жақсы болды.
Dialogue: 0,0:14:21.05,0:14:24.00,Default,,0,0,0,,Одан кейін екеуіңде бәрі жақсы болған сияқты.
Dialogue: 0,0:14:24.02,0:14:24.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:25.06,0:14:28.08,Default,,0,0,0,,Морисамерге арнайы жауынгерлік дайындық беруім керек пе?
Dialogue: 0,0:14:29.04,0:14:30.07,Default,,0,0,0,,Шынымен не?
Dialogue: 0,0:14:31.00,0:14:31.50,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:14:32.06,0:14:33.09,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:14:34.01,0:14:35.07,Default,,0,0,0,,Ол өзін Морисама деп атаған кезде
Dialogue: 0,0:14:36.00,0:14:39.03,Default,,0,0,0,,Біз серіктес болдық, сондықтан мен оны жақсы білемін.
Dialogue: 0,0:14:39.09,0:14:44.00,Default,,0,0,0,,Қараңдаршы, ол жерде емдік шөптер бар. Сіз оларды үнемі теріп, жеп жүрдіңіз.
Dialogue: 0,0:14:45.00,0:14:48.00,Default,,0,0,0,,Тоқта Ағаштарды зақымдап, шырынын ішу
Dialogue: 0,0:14:48.00,0:14:49.05,Default,,0,0,0,,Тоқта
Dialogue: 0,0:14:49.05,0:14:52.06,Default,,0,0,0,,Күні бойы құспен сөйлесуге тырыстың ба?
Dialogue: 0,0:14:53.09,0:14:55.09,Default,,0,0,0,,Ұят, ұят, ұят...
Dialogue: 0,0:14:55.09,0:14:56.09,Default,,0,0,0,,Ұятыңды таста
Dialogue: 0,0:14:57.01,0:14:59.09,Default,,0,0,0,,Сіз Морисама, 1200 жыл өмір сүрген сиқыршы болуыңыз керек.
Dialogue: 0,0:15:00.01,0:15:01.04,Default,,0,0,0,,Менің ойымша, сіз махаббатыңызды жеткізу үшін келдіңіз.
Dialogue: 0,0:15:01.07,0:15:03.06,Default,,0,0,0,,Біз оқиға орнына бірінші жетеміз.
Dialogue: 0,0:15:03.06,0:15:04.04,Default,,0,0,0,,Жарайды
Dialogue: 0,0:15:05.04,0:15:06.08,Default,,0,0,0,,Менің мұны істеуден басқа амалым жоқ, өтінемін.
Dialogue: 0,0:15:07.02,0:15:08.04,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:15:08.04,0:15:10.07,Default,,0,0,0,,Біз оқиға орнына бірінші жетеміз.
Dialogue: 0,0:15:18.07,0:15:22.07,Default,,0,0,0,,Өйткені, ол жігіт нағыз фейк еді.
Dialogue: 0,0:15:23.01,0:15:25.08,Default,,0,0,0,,Әу бастан білгенім сол еді
Dialogue: 0,0:15:27.01,0:15:29.01,Default,,0,0,0,,Бұл бетті жылдам жойыңыз.
Dialogue: 0,0:15:29.05,0:15:31.02,Default,,0,0,0,,Мен саған кәдесый сатып алмаймын.
Dialogue: 0,0:15:34.09,0:15:36.01,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:36.06,0:15:38.04,Default,,0,0,0,,Мот Морисама-сама
Dialogue: 0,0:15:39.05,0:15:41.09,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:15:44.00,0:15:47.08,Default,,0,0,0,,Жүрегің әлі таза емес сияқты.
Dialogue: 0,0:15:48.01,0:15:49.06,Default,,0,0,0,,Не, Морисама-сама?
Dialogue: 0,0:15:50.07,0:15:52.07,Default,,0,0,0,,Мен сізді тазартуға рұқсат етіңіз.
Dialogue: 0,0:15:53.04,0:15:56.06,Default,,0,0,0,,Барлығын менің махаббатыммен қоршап ал
Dialogue: 0,0:15:56.06,0:15:59.08,Default,,0,0,0,,Морисама-сама, өлімге жақын, жақын.
Dialogue: 0,0:16:00.00,0:16:01.04,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:16:03.08,0:16:05.01,Default,,0,0,0,,Оны тоқтатыңыз Өлім
Dialogue: 0,0:16:05.04,0:16:07.00,Default,,0,0,0,,Санья
Dialogue: 0,0:16:07.04,0:16:10.04,Default,,0,0,0,,Саньяның орны сүйкімді, сәбиге ұқсайды
Dialogue: 0,0:16:10.04,0:16:12.04,Default,,0,0,0,,Тоқта, тоқта
Dialogue: 0,0:16:12.04,0:16:15.01,Default,,0,0,0,,Маған көмектесші, Жалған жаз
Dialogue: 0,0:16:15.08,0:16:16.09,Default,,0,0,0,,Осымен
Dialogue: 0,0:16:20.05,0:16:25.07,Default,,0,0,0,,Жадым жоғалса да, 1500 жыл өмір сүрдім.
Dialogue: 0,0:16:26.04,0:16:29.04,Default,,0,0,0,,Бұл дүниеде бар нағыз сиқыршы
Dialogue: 0,0:16:30.04,0:16:33.05,Default,,0,0,0,,Аруақтардың жетелеуімен әңгімелерді айналдырушы
Dialogue: 0,0:16:34.06,0:16:37.05,Default,,0,0,0,,Менің атым Морисамер
Dialogue: 0,0:16:39.00,0:16:39.50,Default,,0,0,0,,На
Dialogue: 0,0:16:40.00,0:16:41.08,Default,,0,0,0,,Сіз қайтадан келдіңіз
Dialogue: 0,0:16:42.01,0:16:43.08,Default,,0,0,0,,Өздерін Морисама деп атайтындар
Dialogue: 0,0:16:44.06,0:16:48.06,Default,,0,0,0,,Нақты Морисамер қайсысы екенін анықтайық.
Dialogue: 0,0:16:49.04,0:16:51.01,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:16:51.08,0:16:54.01,Default,,0,0,0,,Бұл оқиға енді аяқталды.
Dialogue: 0,0:16:54.07,0:16:58.06,Default,,0,0,0,,Онда мені махаббатыңмен тазарт.
Dialogue: 0,0:16:59.02,0:17:01.01,Default,,0,0,0,,Болашақты мәңгілікке өшір
Dialogue: 0,0:17:02.01,0:17:07.01,Default,,0,0,0,,Енді, сиқыршылар, мәңгілік күресейік.
Dialogue: 0,0:17:07.06,0:17:08.06,Default,,0,0,0,,Ұшатын пері
Dialogue: 0,0:17:09.02,0:17:10.03,Default,,0,0,0,,Сыбырлы рух
Dialogue: 0,0:17:10.09,0:17:13.03,Default,,0,0,0,,Рухани карикатура
Dialogue: 0,0:17:19.05,0:17:20.08,Default,,0,0,0,,Нибутаниге барыңыз
Dialogue: 0,0:17:21.00,0:17:22.01,Default,,0,0,0,,Ә? Жоқ, мен ештеңе істеген жоқпын…
Dialogue: 0,0:17:22.04,0:17:25.07,Default,,0,0,0,,Осы уақытқа дейін жеткен болсаң, ұялмайсың.
Dialogue: 0,0:17:30.06,0:17:31.06,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:17:32.00,0:17:33.09,Default,,0,0,0,,Мен Саняны қатты қаладым
Dialogue: 0,0:17:34.02,0:17:35.05,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:17:35.07,0:17:39.05,Default,,0,0,0,,Маған сіздің өзіңізді Морисамер деп атағаныңыз ұнамайды.
Dialogue: 0,0:17:40.03,0:17:41.05,Default,,0,0,0,,Мен шынмын
Dialogue: 0,0:17:41.09,0:17:43.09,Default,,0,0,0,,Келіңіздер, рухтар.
Dialogue: 0,0:17:45.03,0:17:47.03,Default,,0,0,0,,Перілер, күш
Dialogue: 0,0:17:51.04,0:17:55.00,Default,,0,0,0,,Қазіргі заманда қара тарихтан асқан ұят нәрсе жоқ.
Dialogue: 0,0:17:55.05,0:17:59.02,Default,,0,0,0,,Бірақ бәрібір, Морисаманы мен жасадым.
Dialogue: 0,0:18:00.02,0:18:00.52,Default,,0,0,0,,Жалған жаз
Dialogue: 0,0:18:01.03,0:18:06.02,Default,,0,0,0,,Мен сен сияқты адамдарға өздерінің таяз мақсаттары үшін пайдалануына жол бермеймін.
Dialogue: 0,0:18:08.04,0:18:13.03,Default,,0,0,0,,Міне, менің өзіме деген бұрмаланған махаббатым.
Dialogue: 0,0:18:18.03,0:18:18.53,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:18:19.02,0:18:20.05,Default,,0,0,0,,Сыни соққы
Dialogue: 0,0:18:22.02,0:18:22.52,Default,,0,0,0,,Ұзақ жұмыс күнінен кейін бір шыныаяқ сакэ ішуден артық ештеңе жоқ!
Dialogue: 0,0:18:23.02,0:18:24.09,Default,,0,0,0,,Түсінсең, тез кет.
Dialogue: 0,0:18:30.00,0:18:32.00,Default,,0,0,0,,Ағымдағы шабуыл дегеніміз не?
Dialogue: 0,0:18:32.02,0:18:34.08,Default,,0,0,0,,Морисаманың құдіреті осы
Dialogue: 0,0:18:37.06,0:18:41.07,Default,,0,0,0,,Өте өкінішті, мен Мабиногионның барлық жазбаларын іздедім.
Dialogue: 0,0:18:41.09,0:18:43.00,Default,,0,0,0,,Барлығын білу
Dialogue: 0,0:18:43.05,0:18:45.08,Default,,0,0,0,,Морисамерден гөрі Морисамер болу
Dialogue: 0,0:18:46.08,0:18:48.03,Default,,0,0,0,,Ол бала менікі.
Dialogue: 0,0:18:48.06,0:18:50.05,Default,,0,0,0,,Мен өз періштемді таптым
Dialogue: 0,0:18:51.02,0:18:54.07,Default,,0,0,0,,Мен сені көшеде алғаш көргеннен бері қудым.
Dialogue: 0,0:18:55.01,0:18:57.00,Default,,0,0,0,,Мен мүмкіндікті күттім
Dialogue: 0,0:18:58.01,0:18:59.06,Default,,0,0,0,,Ешқашан берме
Dialogue: 0,0:19:02.01,0:19:03.01,Default,,0,0,0,,Морисама-чан
Dialogue: 0,0:19:03.01,0:19:03.51,Default,,0,0,0,,Нибутани
Dialogue: 0,0:19:06.04,0:19:11.02,Default,,0,0,0,,Менің адасушылықтарым сізден жақсырақ сияқты, Фейк мырза.
Dialogue: 0,0:19:12.02,0:19:14.04,Default,,0,0,0,,Енді мен жоғалып кетейін.
Dialogue: 0,0:19:15.02,0:19:16.00,Default,,0,0,0,,Бұл жолы
Dialogue: 0,0:19:20.01,0:19:21.09,Default,,0,0,0,,Жоғал
Dialogue: 0,0:19:34.04,0:19:36.09,Default,,0,0,0,,Егер оңайырақ болса, мен шыдаймын.
Dialogue: 0,0:19:44.00,0:19:45.01,Default,,0,0,0,,Мен сізге айтып тұрмын.
Dialogue: 0,0:19:45.06,0:19:48.08,Default,,0,0,0,,Мен мұны істеп, осы ақымақ жылды алсам да
Dialogue: 0,0:19:48.09,0:19:50.00,Default,,0,0,0,,Сіз тек өкінесіз
Dialogue: 0,0:19:50.01,0:19:50.51,Default,,0,0,0,,На
Dialogue: 0,0:19:51.04,0:19:52.07,Default,,0,0,0,,Бұл жігіт ең нашар
Dialogue: 0,0:19:53.04,0:19:55.03,Default,,0,0,0,,Адамдардың айтқанын мүлде тыңдамаймын.
Dialogue: 0,0:19:55.09,0:19:58.08,Default,,0,0,0,,Мен үлкендерге құрмет көрсетпеймін.
Dialogue: 0,0:19:59.06,0:20:02.02,Default,,0,0,0,,Ол өзімшіл, қатыгез және шулы.
Dialogue: 0,0:20:02.07,0:20:05.05,Default,,0,0,0,,Сол әдет мені жалғыз, кішіпейіл етеді.
Dialogue: 0,0:20:05.08,0:20:06.05,Default,,0,0,0,,Бұл жылауық сәби
Dialogue: 0,0:20:07.00,0:20:10.02,Default,,0,0,0,,Дәл осы кезде ол кенеттен керемет сүйкімді жымиды.
Dialogue: 0,0:20:11.01,0:20:12.00,Default,,0,0,0,,Жалған жаз
Dialogue: 0,0:20:12.04,0:20:13.09,Default,,0,0,0,,Періштелер шектен шыққан
Dialogue: 0,0:20:14.04,0:20:16.00,Default,,0,0,0,,Шайтаннан да қиын
Dialogue: 0,0:20:17.00,0:20:18.04,Default,,0,0,0,,Ең үлкен ақымақ
Dialogue: 0,0:20:19.05,0:20:20.07,Default,,0,0,0,,Сен ақымақсың
Dialogue: 0,0:20:21.03,0:20:24.04,Default,,0,0,0,,Менің Саньямды ластама
Dialogue: 0,0:20:24.05,0:20:25.03,Default,,0,0,0,,Нибутани
Dialogue: 0,0:20:25.08,0:20:28.03,Default,,0,0,0,,Мжолнир Хаммер
Dialogue: 0,0:20:28.09,0:20:31.00,Default,,0,0,0,,Санья, сен не айтып тұрсың?
Dialogue: 0,0:20:31.03,0:20:33.05,Default,,0,0,0,,Бұл жігіт сөзсіз фейк
Dialogue: 0,0:20:33.05,0:20:34.07,Default,,0,0,0,,Жалған самадалар
Dialogue: 0,0:20:35.00,0:20:38.00,Default,,0,0,0,,Бірақ бұл әділетті жалған өлім
Dialogue: 0,0:20:38.00,0:20:39.04,Default,,0,0,0,,Сізге ұқсамайды
Dialogue: 0,0:20:40.03,0:20:42.01,Default,,0,0,0,,Сіз де Морисама емессіз.
Dialogue: 0,0:20:42.03,0:20:45.04,Default,,0,0,0,,Нағыз Морисама-сама ешқашан мұндай нәрсені жасамас еді.
Dialogue: 0,0:20:45.05,0:20:45.55,Default,,0,0,0,,На
Dialogue: 0,0:20:46.03,0:20:48.05,Default,,0,0,0,,Нағыз тері киген жалған
Dialogue: 0,0:20:48.07,0:20:51.02,Default,,0,0,0,,Жалған жаз - Декомори жеңетін өлім
Dialogue: 0,0:20:51.06,0:20:56.04,Default,,0,0,0,,Greathammer GX-тің соңғы соңы
Dialogue: 0,0:21:04.05,0:21:07.01,Default,,0,0,0,,Мен сені алғаш көргеннен бері жақсы көремін.
Dialogue: 0,0:21:07.06,0:21:09.05,Default,,0,0,0,,Мен сені періште деп ойладым
Dialogue: 0,0:21:10.01,0:21:14.03,Default,,0,0,0,,Міне, сондықтан мен сізді айналдырғым келеді, және бұл ...
Dialogue: 0,0:21:14.08,0:21:16.07,Default,,0,0,0,,Мұның несі жақсы?
Dialogue: 0,0:21:17.02,0:21:20.01,Default,,0,0,0,,Міне... Санья - періште
Dialogue: 0,0:21:20.04,0:21:23.09,Default,,0,0,0,,Махаббатты да, адамдарды да білмейтін пәк, пәк періште.
Dialogue: 0,0:21:24.01,0:21:26.04,Default,,0,0,0,,Сүйуді былай қойғанда, тіпті қол ұстасып...
Dialogue: 0,0:21:27.03,0:21:28.08,Default,,0,0,0,,Менде бірінші сүйіспеншілік болды.
Dialogue: 0,0:21:29.01,0:21:31.00,Default,,0,0,0,,Иә? Рождествоға арналған
Dialogue: 0,0:21:31.03,0:21:32.06,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:21:33.01,0:21:33.51,Default,,0,0,0,,Олардың өлімі ұйым ішінде дүрбелең тудырды
Dialogue: 0,0:21:34.02,0:21:38.07,Default,,0,0,0,,Мен бұл бала деп ойладым.
Dialogue: 0,0:21:43.01,0:21:43.51,Default,,0,0,0,,Жеңіс
Dialogue: 0,0:21:44.05,0:21:46.03,Default,,0,0,0,,Сіз ештеңе істеген жоқсыз.
Dialogue: 0,0:21:46.05,0:21:47.04,Default,,0,0,0,,Сізге жақсы.
Dialogue: 0,0:21:47.08,0:21:49.07,Default,,0,0,0,,Екеуіңіз қалыпты жағдайға оралған сияқтысыз.
Dialogue: 0,0:21:49.07,0:21:52.03,Default,,0,0,0,,Мен саған айтамын, бұл сүйіспеншілік кездейсоқ болды.
Dialogue: 0,0:21:52.05,0:21:53.09,Default,,0,0,0,,Табиғи өлім
Dialogue: 0,0:21:53.09,0:21:55.06,Default,,0,0,0,,Неліктен қызыл?
Dialogue: 0,0:21:56.00,0:21:57.06,Default,,0,0,0,,Бұл қызыл емес.
Dialogue: 0,0:21:57.06,0:21:59.07,Default,,0,0,0,,Бұл сенсің, қызылсың.
Dialogue: 0,0:21:59.08,0:22:01.04,Default,,0,0,0,,Өлмеген өлім
Dialogue: 0,0:22:01.07,0:22:03.07,Default,,0,0,0,,Бұл шынымен сүйкімді емес.
Dialogue: 0,0:22:19.02,0:22:22.06,Default,,0,0,0,,Бүршік атып келе жатқан қараңғы түн аласапыранға түседі Бүршік жарған қараңғы түн
Dialogue: 0,0:22:22.06,0:22:25.00,Default,,0,0,0,,(Мазасыздық)
Dialogue: 0,0:22:25.04,0:22:29.05,Default,,0,0,0,,Мәңгіліктен шыққан жеті дыбыс Жеті түрлі түсті нота
Dialogue: 0,0:22:29.05,0:22:30.08,Default,,0,0,0,,(Қызықты)
Dialogue: 0,0:22:30.08,0:22:34.08,Default,,0,0,0,,Сиқырлы балғаның белгісі рифте жарқырайды Сиқырлы бренд
Dialogue: 0,0:22:34.08,0:22:36.08,Default,,0,0,0,,(Мен әлі де жалғастыруды жоспарлап отырмын) (Сіз қалай ойлайсыз?)
Dialogue: 0,0:22:36.08,0:22:40.05,Default,,0,0,0,,Аврора сүйіспеншілікпен жарқырайды Махаббат заңы туралы
Dialogue: 0,0:22:40.05,0:22:42.03,Default,,0,0,0,,(Kai-тоқтаудың төменгі жартысы)
Dialogue: 0,0:22:42.03,0:22:45.02,Default,,0,0,0,,Біз бір болдық Біз біртұтаспыз.
Dialogue: 0,0:22:45.02,0:22:47.08,Default,,0,0,0,,Аспанда ұшу Ұшатын аспан
Dialogue: 0,0:22:48.01,0:22:53.06,Default,,0,0,0,,Мақтанышпен жарылған отшашу сияқты Тәкаппарлықтай биік сөнетін от
Dialogue: 0,0:22:53.07,0:22:59.02,Default,,0,0,0,,Жылтырлық бір сәтте жарылып кетті Жарық моменті кезіндегі жарылыс
Dialogue: 0,0:22:59.05,0:23:05.02,Default,,0,0,0,,Сайқымазақ өзінің әділдігін ұшады Кіші өгіз елші сақалы
Dialogue: 0,0:23:05.02,0:23:10.07,Default,,0,0,0,,Ақымақ ай сәулесінде адасушылықты сақтайды. Ай көлеңкесіндегі ақымақ
Dialogue: 0,0:23:11.00,0:23:16.07,Default,,0,0,0,,Ойын бізді қуып жетуге арналған болса Ойыншы мені әлі қуып келеді.
Dialogue: 0,0:23:16.07,0:23:21.05,Default,,0,0,0,,Ең болмағанда мен шірімейтін ақымақ болғым келеді. Барынша аз, Өлмейтін қылышпын.
Dialogue: 0,0:23:21.06,0:23:27.00,Default,,0,0,0,,Көңіл толқып айқайлады Көтерілген жанның ұлы зары
Dialogue: 0,0:23:27.00,0:23:31.02,Default,,0,0,0,,Бұл әлемді қуу Дүниеден қуылған
