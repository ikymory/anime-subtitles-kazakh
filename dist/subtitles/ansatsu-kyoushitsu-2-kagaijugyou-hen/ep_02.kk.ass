Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.92,0:00:08.92,Default,,0,0,0,,2 семестрдің ашылу салтанаты
Dialogue: 0,0:00:09.00,0:00:13.38,Default,,0,0,0,,Мен Такебаяши-кунды А класына ауыстырады деп ешқашан ойламадым.
Dialogue: 0,0:00:14.05,0:00:17.68,Default,,0,0,0,,Бізде ренжігеннен басқа амал қалмады.
Dialogue: 0,0:00:17.76,0:00:20.77,Default,,0,0,0,,Мен сіздің мамандық таңдауыңызды құрметтеймін.
Dialogue: 0,0:00:20.85,0:00:24.85,Default,,0,0,0,,Мен сізге сенемін және жадты өшіру сияқты шараларды қолданбаймын.
Dialogue: 0,0:00:24.94,0:00:26.19,Default,,0,0,0,,Бірақ жаңа сабақтарда да
Dialogue: 0,0:00:26.27,0:00:30.11,Default,,0,0,0,,Қастандық туралы ешқашан айтпаңыз.
Dialogue: 0,0:00:30.19,0:00:31.94,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:00:32.03,0:00:34.70,Default,,0,0,0,,Мен сондай ақымақ болып көрінемін бе?
Dialogue: 0,0:00:35.99,0:00:37.45,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:00:41.41,0:00:42.41,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:00:42.50,0:00:44.58,Default,,0,0,0,,Котаро Такебаяши…
Dialogue: 0,0:00:45.50,0:00:47.96,Default,,0,0,0,,Ол кісі өлтіру жаттығуларын байыппен қабылдағанымен.
Dialogue: 0,0:00:48.04,0:00:50.46,Default,,0,0,0,,Ең төменгі баға
Dialogue: 0,0:00:50.55,0:00:52.46,Default,,0,0,0,,Оқу да солай.
Dialogue: 0,0:00:52.55,0:00:56.22,Default,,0,0,0,,Жалқау болдым, дәлірек айтсам, жаман ой келді.
Dialogue: 0,0:00:56.30,0:00:59.51,Default,,0,0,0,,Тек оқуды білмейді.
Dialogue: 0,0:00:59.60,0:01:03.22,Default,,0,0,0,,5 немесе 6 тығыз мектептерге бару іс жүзінде керісінше әсер етеді.
Dialogue: 0,0:01:03.31,0:01:06.73,Default,,0,0,0,,Бұл көп жасасаң, бағаларың көтеріледі деген ойлаудың әдеттегі мысалы.
Dialogue: 0,0:01:07.69,0:01:10.15,Default,,0,0,0,,Сондықтан Такебаяши-кунға мүмкіндігінше оқу керек.
Dialogue: 0,0:01:10.23,0:01:12.36,Default,,0,0,0,,Біріншіден, мүмкіндігінше көп оқимын.
Dialogue: 0,0:01:12.44,0:01:15.65,Default,,0,0,0,,Өзіне сәйкес келетін идеалды оқу әдісін табыңыз
Dialogue: 0,0:01:15.74,0:01:16.32,Default,,0,0,0,,Жоқ, менің қолым шырылдап тұр.
Dialogue: 0,0:01:16.32,0:01:18.11,Default,,0,0,0,,Жоқ, менің қолым шырылдап тұр.
Dialogue: 0,0:01:16.32,0:01:18.11,Default,,0,0,0,,Жапония мен Батыстың қарапайым ақыл-кеуілі мүлде жарамайды.
Dialogue: 0,0:01:18.11,0:01:18.20,Default,,0,0,0,,Жапония мен Батыстың қарапайым ақыл-кеуілі мүлде жарамайды.
Dialogue: 0,0:01:18.20,0:01:21.53,Default,,0,0,0,,Жапония мен Батыстың қарапайым ақыл-кеуілі мүлде жарамайды.
Dialogue: 0,0:01:18.20,0:01:21.53,Default,,0,0,0,,Сіз оны 3 айда экспоненциалды түрде өсіресіз.
Dialogue: 0,0:01:21.62,0:01:24.70,Default,,0,0,0,,Мен бұл саусақтардың дірілдегенін мазақ ете аламын ба?
Dialogue: 0,0:01:26.46,0:01:28.12,Default,,0,0,0,,Бұл созылу нәтижесі ме?
Dialogue: 0,0:01:29.42,0:01:31.04,Default,,0,0,0,,Бұл ирониялық...
Dialogue: 0,0:01:32.55,0:01:34.88,Default,,0,0,0,,Мен әрқашан солай істеймін.
Dialogue: 0,0:01:34.96,0:01:40.51,Default,,0,0,0,,Осы кезеңде көп жұмыс істеген оқушылармен байланысып, Е сыныбынан қашуын сұраңыз.
Dialogue: 0,0:01:40.60,0:01:45.39,Default,,0,0,0,,Әдеттегідей Такебаяши-кун екі жауап алды.
Dialogue: 0,0:01:45.48,0:01:46.94,Default,,0,0,0,,Унюу…
Dialogue: 0,0:01:47.02,0:01:49.90,Default,,0,0,0,,Бүгінгі кездесуді көрдіңіз бе?
Dialogue: 0,0:01:49.98,0:01:54.61,Default,,0,0,0,,Барлық оқушылар менің оларға нені үйретейін деп тұрғанымды түсінді.
Dialogue: 0,0:01:55.28,0:01:57.45,Default,,0,0,0,,Еңбегіңіз сау болады
Dialogue: 0,0:01:57.53,0:01:59.61,Default,,0,0,0,,Әлсізден күштіге
Dialogue: 0,0:02:00.41,0:02:01.83,Default,,0,0,0,,Коросей
Dialogue: 0,0:02:02.45,0:02:05.87,Default,,0,0,0,,Мен саған дұрыс емес нәрсені үйретіп жатырмын ба?
Dialogue: 0,0:02:08.62,0:02:11.84,Default,,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:02:15.51,0:02:17.72,Default,,0,0,0,,- (Маэхара) Ей, бамбук орманы! - (Такебаяши) А?
Dialogue: 0,0:02:22.76,0:02:24.68,Default,,0,0,0,,Түсіндіре аласыз ба?
Dialogue: 0,0:02:25.56,0:02:27.93,Default,,0,0,0,,Неліктен бір ауыз кеңес жоқ?
Dialogue: 0,0:02:28.02,0:02:30.94,Default,,0,0,0,,Бірдеңе болып жатыр, солай ма?
Dialogue: 0,0:02:31.02,0:02:32.23,Default,,0,0,0,,Тіпті жазғы демалыста
Dialogue: 0,0:02:32.31,0:02:35.44,Default,,0,0,0,,Такебаяши өте пайдалы болды.
Dialogue: 0,0:02:35.53,0:02:38.70,Default,,0,0,0,,Біз әрқашан бірге көңіл көтердік, солай емес пе?
Dialogue: 0,0:02:39.32,0:02:41.32,Default,,0,0,0,,Ол қызметші қыз емес пе?
Dialogue: 0,0:02:41.41,0:02:43.32,Default,,0,0,0,,Жүлде ақшасы 10 млрд
Dialogue: 0,0:02:43.41,0:02:47.29,Default,,0,0,0,,Жасаған әрекетіңізге байланысты сізден көбірек ақы алынатын сияқты.
Dialogue: 0,0:02:47.37,0:02:50.96,Default,,0,0,0,,Маған үлес керек емес, Тәкебаяши, риясыз.
Dialogue: 0,0:02:53.04,0:02:55.21,Default,,0,0,0,,Ең көбі 1 млрд
Dialogue: 0,0:02:55.30,0:02:56.13,Default,,0,0,0,,Иә!?
Dialogue: 0,0:02:56.80,0:03:00.26,Default,,0,0,0,,Менің жалғыз өзім 10 миллиард алу мүлде мүмкін емес.
Dialogue: 0,0:03:00.34,0:03:03.47,Default,,0,0,0,,Біз оларды топта өлтіруге көмектесе алсақ та.
Dialogue: 0,0:03:03.55,0:03:08.52,Default,,0,0,0,,Мен қабылдай алатын рөл үшін ең жақсы үлес 1 млрд.
Dialogue: 0,0:03:09.18,0:03:13.06,Default,,0,0,0,,Менің отбасым ұрпақтар бойы аурухананы басқарады.
Dialogue: 0,0:03:13.15,0:03:16.02,Default,,0,0,0,,Менің екі ағам да Токио университетінің медицина мектебінде оқыды.
Dialogue: 0,0:03:16.11,0:03:17.61,Default,,0,0,0,,1 миллиард ақша
Dialogue: 0,0:03:17.69,0:03:20.53,Default,,0,0,0,,Менің отбасым жұмыс істеуге жеткілікті ақша таба алады.
Dialogue: 0,0:03:21.24,0:03:23.16,Default,,0,0,0,,Табиғи тұрғызылатын үй
Dialogue: 0,0:03:23.24,0:03:26.37,Default,,0,0,0,,Мұны істей алмайтындар отбасы ретінде қарастырылмайды.
Dialogue: 0,0:03:26.45,0:03:28.54,Default,,0,0,0,,1 миллиард алсам да
Dialogue: 0,0:03:28.62,0:03:32.54,Default,,0,0,0,,Менің отбасымның мені қабылдауы мүмкін емес.
Dialogue: 0,0:03:33.29,0:03:34.46,Default,,0,0,0,,«Жақсы».
Dialogue: 0,0:03:34.54,0:03:38.50,Default,,0,0,0,,«Мен үйдегі ең нашар адам болдым, бірақ жолым болды және менің өмірімді сақтап қалдым».
Dialogue: 0,0:03:38.59,0:03:40.80,Default,,0,0,0,,Мұның соңы.
Dialogue: 0,0:03:41.88,0:03:45.51,Default,,0,0,0,,Мен ата-анама бағаларымды баяндап бердім.
Dialogue: 0,0:03:45.60,0:03:50.56,Default,,0,0,0,,Мен жоғары баға алып, Е сыныбынан шыға аламын деп үміттенемін.
Dialogue: 0,0:03:51.23,0:03:52.94,Default,,0,0,0,,Сіз қолыңыздан келгеннің бәрін жасадыңыз, солай ма?
Dialogue: 0,0:03:53.02,0:03:55.81,Default,,0,0,0,,Сіздің мойныңыздағы терінің бір бөлігі жалғанған.
Dialogue: 0,0:03:55.90,0:03:58.82,Default,,0,0,0,,Бұл сөзді алу үшін
Dialogue: 0,0:03:58.90,0:04:01.82,Default,,0,0,0,,Қаншама қан зерттедім!
Dialogue: 0,0:04:01.90,0:04:02.90,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:02.99,0:04:06.78,Default,,0,0,0,,Маған жердің соңы, 10 миллиардтан астам
Dialogue: 0,0:04:06.87,0:04:09.66,Default,,0,0,0,,Отбасыңыздың қабылдауы маңыздырақ.
Dialogue: 0,0:04:11.70,0:04:14.58,Default,,0,0,0,,Мен сатқындық пен шүкіршілікті білемін.
Dialogue: 0,0:04:14.67,0:04:17.84,Default,,0,0,0,,Сіздің қастандық жақсы өтеді деп үміттенемін.
Dialogue: 0,0:04:17.92,0:04:20.38,Default,,0,0,0,,Күте тұрыңыз, Такебаяши-кун! Ой...
Dialogue: 0,0:04:21.05,0:04:22.13,Default,,0,0,0,,Канзаки мырза
Dialogue: 0,0:04:22.22,0:04:25.34,Default,,0,0,0,,Тоқташы, Нағиса-күн.
Dialogue: 0,0:04:25.43,0:04:30.06,Default,,0,0,0,,Ата-анамның шынжырлары өте ауыр жерді орап, жібермейді.
Dialogue: 0,0:04:30.14,0:04:34.14,Default,,0,0,0,,Сондықтан оны мәжбүрлеуге тырыспаңыз.
Dialogue: 0,0:04:36.40,0:04:39.65,Default,,0,0,0,,Кейбіреулерімізге қарғыс жауды.
Dialogue: 0,0:04:41.11,0:04:45.66,Default,,0,0,0,,Такебаяши-кунды сол қарғыс өлтіргендей болды.
Dialogue: 0,0:04:46.57,0:04:48.66,Default,,0,0,0,,Қарғысты қалай бұзуға болады
Dialogue: 0,0:04:48.74,0:04:52.41,Default,,0,0,0,,Мектеп сабақтары оқытылмайды.
Dialogue: 0,0:04:56.62,0:04:59.34,Default,,0,0,0,,Е сыныбының үздік оқушысы
Dialogue: 0,0:04:59.42,0:05:02.67,Default,,0,0,0,,Мен Е сыныбынан шығып, өз еркіммен А сыныбына көштім.
Dialogue: 0,0:05:03.80,0:05:07.55,Default,,0,0,0,,Олар сол шындықты көріп, есінде қалған болуы керек.
Dialogue: 0,0:05:07.64,0:05:13.14,Default,,0,0,0,,Бұл мектепте біз жай ғана екінші деңгейлі ойыншылармыз.
Dialogue: 0,0:05:13.22,0:05:18.69,Default,,0,0,0,,Менің білімім барлық жағынан мағыналы.
Dialogue: 0,0:05:20.19,0:05:26.19,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
