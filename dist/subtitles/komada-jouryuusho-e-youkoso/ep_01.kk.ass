Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:38.12,0:00:38.95,Default,,0,0,0,,(әйнекке мұз қосу дыбысы)
Dialogue: 0,0:00:42.62,0:00:43.46,Default,,0,0,0,,(бөтелкенің тығындалмаған дыбысы)
Dialogue: 0,0:01:02.47,0:01:03.27,Default,,0,0,0,,Иә
Dialogue: 0,0:01:06.31,0:01:08.48,Default,,0,0,0,,Сіздің анаңыз ішімдік ішкен бе?
Dialogue: 0,0:01:09.11,0:01:10.48,Default,,0,0,0,,Тек KOMA
Dialogue: 0,0:01:10.57,0:01:12.11,Default,,0,0,0,,Хмм.
Dialogue: 0,0:01:12.19,0:01:13.11,Default,,0,0,0,,- (Қызметкерлер) Рюсей-чан - (Рюу) Иә?
Dialogue: 0,0:01:13.74,0:01:16.65,Default,,0,0,0,,Суретіңіз үшін жүлде алғаныңызды естідім бе?
Dialogue: 0,0:01:16.74,0:01:18.20,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:01:18.28,0:01:20.74,Default,,0,0,0,,Бұл жақсы. Мен бір нәрсеге жақсымын.
Dialogue: 0,0:01:20.83,0:01:22.12,Default,,0,0,0,,Бұл бала...
Dialogue: 0,0:01:23.24,0:01:25.62,Default,,0,0,0,,Не? Сіз не айтқыңыз келеді?
Dialogue: 0,0:01:36.13,0:01:37.38,Default,,0,0,0,,Жақсы жұмыс
Dialogue: 0,0:01:53.86,0:01:56.24,Default,,0,0,0,,«Қолөнер вискиінің болашағы»
Dialogue: 0,0:01:56.74,0:01:58.57,Default,,0,0,0,,Қызықты жоба сияқты, солай емес пе?
Dialogue: 0,0:01:59.32,0:02:01.41,Default,,0,0,0,,Мен бұған жауаптымын ба?
Dialogue: 0,0:02:01.49,0:02:02.33,Default,,0,0,0,,Иә.
Dialogue: 0,0:02:03.83,0:02:06.66,Default,,0,0,0,,Мен әлі жаңадан келген адаммын, сондықтан Ясу-сан мұны істеуі керек...
Dialogue: 0,0:02:06.75,0:02:10.58,Default,,0,0,0,,Жасап жатқаныма жарты жыл болса да, қашанға дейін жаңадан келген адам болып есептелемін?
Dialogue: 0,0:02:11.08,0:02:12.17,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:02:13.17,0:02:14.17,Default,,0,0,0,,Мынаны жеп ал.
Dialogue: 0,0:02:14.80,0:02:15.84,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:02:16.59,0:02:20.68,Default,,0,0,0,,Кәсіби сұхбаттар және виски әуесқойлары не білгісі келеді
Dialogue: 0,0:02:20.76,0:02:22.68,Default,,0,0,0,,Кәсіби мамандар сізге барлық сұрақтарды қояды.
Dialogue: 0,0:02:23.22,0:02:25.56,Default,,0,0,0,,Сіздің жұмысыңыз – сүйемелдеу
Dialogue: 0,0:02:25.64,0:02:28.23,Default,,0,0,0,,Жинаған ақпаратты мақалаға қорытындылаңыз.
Dialogue: 0,0:02:28.77,0:02:30.69,Default,,0,0,0,,Бұл кәсіпқой кім?
Dialogue: 0,0:02:35.32,0:02:38.44,Default,,0,0,0,,Ryusei Komada Бұл виски араластырғыш.
Dialogue: 0,0:02:38.53,0:02:40.91,Default,,0,0,0,,Ата-анасының үйіндегі Комада спирт зауытын алған соң көп ұзамай
Dialogue: 0,0:02:40.99,0:02:43.45,Default,,0,0,0,,«Вакаба» қолөнер вискиі - бұл хит
Dialogue: 0,0:02:44.08,0:02:45.12,Default,,0,0,0,,Иә
Dialogue: 0,0:02:45.20,0:02:47.37,Default,,0,0,0,,Реакция әлсіз.
Dialogue: 0,0:02:47.45,0:02:50.71,Default,,0,0,0,,Бұл толыққанды тұлға болу үшін ондаған жылдар қажет дүние.
Dialogue: 0,0:02:51.21,0:02:55.04,Default,,0,0,0,,Виски әлемінде керемет жігіт пайда болды деген қызу тақырып.
Dialogue: 0,0:02:55.55,0:02:57.13,Default,,0,0,0,,Ясу мырза, сіз өте егжей-тегжейлісіз.
Dialogue: 0,0:02:57.21,0:03:01.55,Default,,0,0,0,,Вакаба бостандыққа шыққанда, мен оны жауып, ол туралы мақала жаздым.
Dialogue: 0,0:03:01.63,0:03:04.76,Default,,0,0,0,,Мақтанғаным жоқ, бірақ оны хит етуде менің қолым бар.
Dialogue: 0,0:03:04.85,0:03:07.77,Default,,0,0,0,,Күлсін... Мен сені жақсы танимын деп ойлаймын.
Dialogue: 0,0:03:07.85,0:03:09.39,Default,,0,0,0,,Бұған қоса,
Dialogue: 0,0:03:09.48,0:03:13.19,Default,,0,0,0,,Егер сіз жаңалықтар сайтында репортер болсаңыз, бұл жалпыға белгілі.
Dialogue: 0,0:03:13.27,0:03:14.90,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:03:15.52,0:03:18.15,Default,,0,0,0,,Ясу-сан! тезірек оралуыңызды өтінемін
Dialogue: 0,0:03:18.23,0:03:19.94,Default,,0,0,0,,Ой, жаман, мен қазір кетемін.
Dialogue: 0,0:03:20.45,0:03:22.78,Default,,0,0,0,,Сонымен... ертеңгі сұхбат Наганода болады.
Dialogue: 0,0:03:22.86,0:03:24.03,Default,,0,0,0,,Жоқ! Мен өлгім келмейді. Отбасымды көргім келеді.
Dialogue: 0,0:03:25.12,0:03:29.04,Default,,0,0,0,,Не? Ертең... мереке емес пе?
Dialogue: 0,0:03:29.54,0:03:32.29,Default,,0,0,0,,Әңгімелесу орны - Омори Саке сыра қайнату зауыты.
Dialogue: 0,0:03:32.37,0:03:35.96,Default,,0,0,0,,Кәсіби мамандарға тапсырсаңыз да, ең болмағанда зерттеуіңізді жүргізу керек.
Dialogue: 0,0:03:36.04,0:03:38.21,Default,,0,0,0,,Кенеттен айтсаң да...
Dialogue: 0,0:03:38.30,0:03:40.92,Default,,0,0,0,,Егер сізге тағы бір нәрсе керек болса, мен оны электрондық пошта арқылы жіберемін.
Dialogue: 0,0:03:43.01,0:03:44.76,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:03:55.56,0:03:57.23,Default,,0,0,0,,Мен бұл туралы естідім.
Dialogue: 0,0:03:58.78,0:04:01.53,Default,,0,0,0,,Жас болсаң да президентсің.
Dialogue: 0,0:04:02.03,0:04:03.28,Default,,0,0,0,,Бұл жақсы нәрсе
Dialogue: 0,0:04:09.04,0:04:12.21,Default,,0,0,0,,Бұл біздің екінші спирт зауыты.
Dialogue: 0,0:04:12.29,0:04:15.71,Default,,0,0,0,,Шешуші фактор мол және сапалы су көзі болды.
Dialogue: 0,0:04:16.21,0:04:18.00,Default,,0,0,0,,Табиғатпен қоршалған климат
Dialogue: 0,0:04:18.09,0:04:21.21,Default,,0,0,0,,Менің ойымша, бұл виски қартаюға жарамды.
Dialogue: 0,0:04:21.30,0:04:23.72,Default,,0,0,0,,Өйткені, қолөнер вискиі
Dialogue: 0,0:04:23.80,0:04:27.18,Default,,0,0,0,,Бұл өлкенің ерекшеліктерін көрсету керек дегенді білдіреді.
Dialogue: 0,0:04:27.26,0:04:29.39,Default,,0,0,0,,Виски өндірісі ғана емес
Dialogue: 0,0:04:29.47,0:04:32.43,Default,,0,0,0,,Сіз кез келген уақытта көріністі көре аласыз.
Dialogue: 0,0:04:32.52,0:04:33.64,Default,,0,0,0,,Біздің ерекшеліктеріміз
Dialogue: 0,0:04:34.14,0:04:38.69,Default,,0,0,0,,Туристерді ескере отырып, ішкі және сыртқы скандинавтық стильде біріктірілген.
Dialogue: 0,0:04:38.77,0:04:41.82,Default,,0,0,0,,Сондай-ақ туристік автобус курсына кіреді.
Dialogue: 0,0:04:42.44,0:04:44.24,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:04:44.32,0:04:47.20,Default,,0,0,0,,Мен бәрін сұрадым.
Dialogue: 0,0:04:47.28,0:04:49.78,Default,,0,0,0,,Такахаши мырзадан бірдеңе бар ма?
Dialogue: 0,0:04:49.87,0:04:51.62,Default,,0,0,0,,Иә? Мен бе?
Dialogue: 0,0:04:51.70,0:04:53.66,Default,,0,0,0,,Ах... мм...
Dialogue: 0,0:04:54.16,0:04:56.17,Default,,0,0,0,,Иә, дұрыс...
Dialogue: 0,0:04:56.67,0:05:00.09,Default,,0,0,0,,Мен қаптаманың жақында жаңартылғанына сенімдімін...
Dialogue: 0,0:05:00.17,0:05:02.21,Default,,0,0,0,,Жоқ, менде жоқ.
Dialogue: 0,0:05:02.30,0:05:04.47,Default,,0,0,0,,Иә? Солай ма?
Dialogue: 0,0:05:05.13,0:05:07.05,Default,,0,0,0,,Содан кейін кәсіби бейсбол командасымен жұмыс жасаңыз.
Dialogue: 0,0:05:07.14,0:05:08.30,Default,,0,0,0,,Егер стадионда сатылса...
Dialogue: 0,0:05:08.93,0:05:11.26,Default,,0,0,0,,Бұл Сакурамори Саке сыра зауыты ма?
Dialogue: 0,0:05:11.35,0:05:12.64,Default,,0,0,0,,Иә, солай...
Dialogue: 0,0:05:12.72,0:05:15.44,Default,,0,0,0,,Жоқ, жоқ, мен Оморимін.
Dialogue: 0,0:05:15.94,0:05:17.27,Default,,0,0,0,,Бұл сіздің визит картаңызда жазылған, солай ма?
Dialogue: 0,0:05:18.86,0:05:20.06,Default,,0,0,0,,...
Dialogue: 0,0:05:20.15,0:05:20.86,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:05:20.94,0:05:23.07,Default,,0,0,0,,- (Томоко) Хаа... - (Котаро) Мен жаңа ғана түсінбедім...
Dialogue: 0,0:05:23.15,0:05:25.82,Default,,0,0,0,,Бұл менің виски сыра зауытына бірінші рет баруым еді.
Dialogue: 0,0:05:25.90,0:05:27.11,Default,,0,0,0,,Спирт зауыты
Dialogue: 0,0:05:27.20,0:05:27.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:27.99,0:05:32.33,Default,,0,0,0,,Сыра зауыты — шарап немесе сыра зауыты.
Dialogue: 0,0:05:32.41,0:05:33.70,Default,,0,0,0,,Иә? Жоқ?
Dialogue: 0,0:05:34.29,0:05:35.91,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:05:37.33,0:05:38.67,Default,,0,0,0,,Таң қалды
Dialogue: 0,0:05:39.17,0:05:41.21,Default,,0,0,0,,Мұндай қателік мүмкін емес.
Dialogue: 0,0:05:41.29,0:05:42.92,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:43.88,0:05:46.97,Default,,0,0,0,,``Омори'' және ''Омори'' атаулары шатастырады.
Dialogue: 0,0:05:47.05,0:05:47.93,Default,,0,0,0,,Не?
Dialogue: 0,0:05:48.01,0:05:49.72,Default,,0,0,0,,<Owl> миссиясы
Dialogue: 0,0:05:49.80,0:05:51.85,Default,,0,0,0,,Сіз бұл жобаға жауаптысыз.
Dialogue: 0,0:05:51.93,0:05:54.10,Default,,0,0,0,,Виски туралы ештеңе білмейсіз.
Dialogue: 0,0:05:54.18,0:05:56.48,Default,,0,0,0,,Ал, Кавабата мырза.
Dialogue: 0,0:05:56.56,0:05:59.48,Default,,0,0,0,,Әлем виски бумы туралы айтып жатыр.
Dialogue: 0,0:05:59.56,0:06:01.48,Default,,0,0,0,,Әркім білімді емес.
Dialogue: 0,0:06:01.56,0:06:03.27,Default,,0,0,0,,Бұл жұмыс!
Dialogue: 0,0:06:03.78,0:06:04.73,Default,,0,0,0,,Надан тілшілердің кесірінен
Dialogue: 0,0:06:04.82,0:06:08.07,Default,,0,0,0,,Сұхбатта жұмыс істеген басқа адамдарға қиындық тудырғым келмейді.
Dialogue: 0,0:06:08.15,0:06:09.16,Default,,0,0,0,,Рұқсат етілмейді
Dialogue: 0,0:06:09.66,0:06:10.49,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:06:10.57,0:06:14.79,Default,,0,0,0,,Біреу кенеттен қиын білім сұраса, қиындық тудырар еді.
Dialogue: 0,0:06:14.87,0:06:16.87,Default,,0,0,0,,Мен әртүрлі нәрселерге мұқият боламын.
Dialogue: 0,0:06:16.95,0:06:20.29,Default,,0,0,0,,Жоқ, мен әлі де Такахаши мырзадан көбірек білуін сұрауым керек.
Dialogue: 0,0:06:20.37,0:06:21.96,Default,,0,0,0,,Қарсы жақтан да кешірім сұраймын.
Dialogue: 0,0:06:22.46,0:06:25.09,Default,,0,0,0,,Біз күн сайын біздің компанияның тағдырына қауіп төніп тұрғандай сезінеміз.
Dialogue: 0,0:06:25.17,0:06:26.59,Default,,0,0,0,,Бұл маңызды уақыт.
Dialogue: 0,0:06:26.67,0:06:28.59,Default,,0,0,0,,Сәтсіздік опция емес
Dialogue: 0,0:06:29.18,0:06:32.01,Default,,0,0,0,,Қызық, News Value мырзаның ниеті қандай?
Dialogue: 0,0:06:32.51,0:06:35.31,Default,,0,0,0,,Мен Ясумото-сан жауапты деп ойладым.
Dialogue: 0,0:06:35.81,0:06:36.89,Default,,0,0,0,,Жоқ—сол қолымды пайдаланбай-ақ ең үздікке айналу арқылы—
Dialogue: 0,0:06:37.39,0:06:39.89,Default,,0,0,0,,Томо-чан әрқашан сөзге қатал болған.
Dialogue: 0,0:06:39.98,0:06:43.69,Default,,0,0,0,,Президент! Мен қазір жұмыстамын.
Dialogue: 0,0:06:43.77,0:06:46.36,Default,,0,0,0,,Дұрыс. Кешіріңіз.
Dialogue: 0,0:06:46.44,0:06:49.03,Default,,0,0,0,,Бұдан былай мен айына екі рет сұхбат беретін боламын.
Dialogue: 0,0:06:49.11,0:06:53.07,Default,,0,0,0,,Такахаши мырзаға ең аз білімді дереу алуы
Dialogue: 0,0:06:53.16,0:06:54.74,Default,,0,0,0,,Бүгін байсалды болыңыз
Dialogue: 0,0:06:54.83,0:06:57.37,Default,,0,0,0,,Біздің спирт зауытына экскурсия жасаңыз.
Dialogue: 0,0:06:57.45,0:06:59.12,Default,,0,0,0,,Мен... білемін.
Dialogue: 0,0:07:05.34,0:07:07.96,Default,,0,0,0,,News Value веб-сайты...
Dialogue: 0,0:07:08.46,0:07:09.63,Default,,0,0,0,,Міне, солай ма?
Dialogue: 0,0:07:09.72,0:07:11.13,Default,,0,0,0,,А... иә
Dialogue: 0,0:07:12.09,0:07:15.30,Default,,0,0,0,,Көп адам оқитын серия болады деп сенемін.
Dialogue: 0,0:07:15.97,0:07:17.31,Default,,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,0:07:18.18,0:07:19.89,Default,,0,0,0,,Біз жақында келеміз.
Dialogue: 0,0:07:23.60,0:07:24.77,Default,,0,0,0,,Бұл ғимарат?
Dialogue: 0,0:07:24.86,0:07:25.77,Default,,0,0,0,,Мүмкін, саған кішкене сабақ беруім керек шығар.
Dialogue: 0,0:07:29.94,0:07:32.28,Default,,0,0,0,,Комада спирт зауытына қош келдіңіз
Dialogue: 0,0:07:32.36,0:07:34.37,Default,,0,0,0,,♪~
Dialogue: 0,0:08:29.84,0:08:31.84,Default,,0,0,0,,~♪
Dialogue: 0,0:08:32.55,0:08:34.34,Default,,0,0,0,,Келесі – дистилляция
Dialogue: 0,0:08:34.93,0:08:35.72,Default,,0,0,0,,Ой
Dialogue: 0,0:08:43.64,0:08:47.81,Default,,0,0,0,,Кәстрөл фотосуреттері спирт зауытына байланысты әр түрлі пішінде болады.
Dialogue: 0,0:08:47.90,0:08:50.94,Default,,0,0,0,,Бұл вискидің хош иісі мен дәмінен де көрінеді.
Dialogue: 0,0:08:51.03,0:08:52.74,Default,,0,0,0,,Екеуі де жылтыр.
Dialogue: 0,0:08:52.82,0:08:54.15,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:08:54.24,0:08:56.53,Default,,0,0,0,,Ол жақында ғана келді.
Dialogue: 0,0:08:57.03,0:09:00.79,Default,,0,0,0,,Енді біз үйде өңделмеген саке жасай аламыз.
Dialogue: 0,0:09:00.87,0:09:01.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:02.12,0:09:04.04,Default,,0,0,0,,Енді салуға болады дейсіз бе?
Dialogue: 0,0:09:04.12,0:09:07.79,Default,,0,0,0,,Біз 10 жыл бұрын өңделмеген саке жасауды тоқтаттық.
Dialogue: 0,0:09:08.79,0:09:12.38,Default,,0,0,0,,Баяғыда жер сілкінісі салдарынан мұнда қайнатылған сакенің біразы жоғалып кеткен.
Dialogue: 0,0:09:12.88,0:09:15.55,Default,,0,0,0,,Жер сілкінісі... Әй, сол кез.
Dialogue: 0,0:09:15.63,0:09:17.97,Default,,0,0,0,,Осыған байланысты KOMA-ны салу мүмкін болмады...
Dialogue: 0,0:09:18.05,0:09:19.26,Default,,0,0,0,,Кома?
Dialogue: 0,0:09:19.93,0:09:22.81,Default,,0,0,0,,Бұрын мұндай виски болған.
Dialogue: 0,0:09:26.64,0:09:30.61,Default,,0,0,0,,Сол кезде мен бизнеске байланысты виски жасауды тоқтаттым.
Dialogue: 0,0:09:31.61,0:09:34.65,Default,,0,0,0,,Осыдан кейін мен негізінен шочу... жасадым.
Dialogue: 0,0:09:34.74,0:09:35.36,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:09:35.99,0:09:40.16,Default,,0,0,0,,Қазіргі президент болғаннан кейін мен өңделмеген саке қайнатуды жалғастыруды шештім.
Dialogue: 0,0:09:40.24,0:09:43.12,Default,,0,0,0,,Бұл жақында ғана орындалды.
Dialogue: 0,0:09:43.20,0:09:45.87,Default,,0,0,0,,Аа, көп нәрсе болды.
Dialogue: 0,0:09:45.96,0:09:46.79,Default,,0,0,0,,Дәлірек айтқанда
Dialogue: 0,0:09:46.87,0:09:49.54,Default,,0,0,0,,Бір ғана нәрсе, біз виски жасауды біраз уақытқа тоқтаттық.
Dialogue: 0,0:09:49.63,0:09:51.34,Default,,0,0,0,,Неліктен білмейсің?
Dialogue: 0,0:09:51.42,0:09:52.50,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:52.59,0:09:55.84,Default,,0,0,0,,Оған көмектесуге болмайды, ол салынбады.
Dialogue: 0,0:09:56.38,0:10:00.43,Default,,0,0,0,,Сонымен, біз жасайтын шочу брендін білесіз бе?
Dialogue: 0,0:10:00.51,0:10:01.39,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:02.01,0:10:03.97,Default,,0,0,0,,“”
Dialogue: 0,0:10:04.06,0:10:06.60,Default,,0,0,0,,Сіз шынымен ешқандай зерттеу жүргізген жоқсыз.
Dialogue: 0,0:10:12.11,0:10:15.78,Default,,0,0,0,,Екі айдаудан кейін жаңа ыдыс әлі де мөлдір және түссіз.
Dialogue: 0,0:10:15.86,0:10:17.86,Default,,0,0,0,,Бөшкелерде осылай қартаясың.
Dialogue: 0,0:10:18.36,0:10:20.03,Default,,0,0,0,,Қандай бөшке қолдануым керек?
Dialogue: 0,0:10:20.11,0:10:22.12,Default,,0,0,0,,Қандай ортада ұйықтағыңыз келетініне байланысты.
Dialogue: 0,0:10:22.62,0:10:24.54,Default,,0,0,0,,Вискидің дәмі өзгереді.
Dialogue: 0,0:10:25.37,0:10:27.08,Default,,0,0,0,,Бұл кең, солай емес пе?
Dialogue: 0,0:10:27.16,0:10:30.42,Default,,0,0,0,,Қазір бізде виски жасалған ескі күндерден қалған бөшкелер ғана бар.
Dialogue: 0,0:10:30.50,0:10:31.79,Default,,0,0,0,,Бұл кең болса да
Dialogue: 0,0:10:31.88,0:10:35.55,Default,,0,0,0,,Биылдан бастап бізде бөшкелер көбірек болады.
Dialogue: 0,0:10:36.05,0:10:39.80,Default,,0,0,0,,Ол тек өседі, бірақ әзірше ол сізге ақша әкелмейді.
Dialogue: 0,0:10:40.30,0:10:41.18,Default,,0,0,0,,Мацуда: Бұл ойын-сауық емес.
Dialogue: 0,0:10:41.84,0:10:44.43,Default,,0,0,0,,Ол кем дегенде 3 жыл отырсын
Dialogue: 0,0:10:44.51,0:10:46.10,Default,,0,0,0,,Аа, онша емес...
Dialogue: 0,0:10:46.60,0:10:48.18,Default,,0,0,0,,Сіз оны көрдіңіз бе?
Dialogue: 0,0:10:48.27,0:10:49.98,Default,,0,0,0,,Виски бөтелкесінде
Dialogue: 0,0:10:50.06,0:10:53.02,Default,,0,0,0,,«12 жыл» немесе «18 жыл» деп жазылған шығар.
Dialogue: 0,0:10:53.52,0:10:54.61,Default,,0,0,0,,Ұзын болса
Dialogue: 0,0:10:54.69,0:10:57.19,Default,,0,0,0,,Тіпті 50 жылға дейін ескіретін бөшкелер де бар.
Dialogue: 0,0:10:57.28,0:10:58.94,Default,,0,0,0,,Құрметті... 50 жыл...
Dialogue: 0,0:10:59.03,0:11:03.03,Default,,0,0,0,,Біз қазір салып жатқанның бәрі болашақ үшін.
Dialogue: 0,0:11:03.53,0:11:04.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:05.28,0:11:09.29,Default,,0,0,0,,Бірақ мен Вакабаның вискиі хит екенін естідім.
Dialogue: 0,0:11:09.37,0:11:12.00,Default,,0,0,0,,Сіз Вакаба туралы білесіз бе?
Dialogue: 0,0:11:12.08,0:11:13.71,Default,,0,0,0,,Иә
Dialogue: 0,0:11:13.79,0:11:16.13,Default,,0,0,0,,Бірақ мен виски жасауды қойдым.
Dialogue: 0,0:11:16.21,0:11:19.22,Default,,0,0,0,,Виски жақсы сатылып жатыр деген нені білдіреді?
Dialogue: 0,0:11:19.72,0:11:23.26,Default,,0,0,0,,Мен істеуді тоқтатқаным виски жасау болды.
Dialogue: 0,0:11:23.76,0:11:26.39,Default,,0,0,0,,Менде әлі бұзылмаған саке қалды.
Dialogue: 0,0:11:26.47,0:11:29.10,Default,,0,0,0,,Вакаба оны араластыру арқылы жасалған.
Dialogue: 0,0:11:29.60,0:11:30.73,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:33.81,0:11:37.11,Default,,0,0,0,,Иә? Біз мұндай вакаба жасай аламыз.
Dialogue: 0,0:11:37.61,0:11:40.24,Default,,0,0,0,,Сіз жоғарыда айтқан КОМА-ны құра алмайсыз ба?
Dialogue: 0,0:11:41.20,0:11:44.74,Default,,0,0,0,,Өйткені КОМА-ға қажетті шикі саке таусылды.
Dialogue: 0,0:11:44.82,0:11:46.66,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:11:46.74,0:11:49.91,Default,,0,0,0,,Компанияда бірде-бір KOMA бөтелкесі қалмады.
Dialogue: 0,0:11:50.00,0:11:51.37,Default,,0,0,0,,А, тіпті біреуі емес пе?
Dialogue: 0,0:11:51.46,0:11:54.67,Default,,0,0,0,,Қалаған адамның қолында болғанын қалаймын.
Dialogue: 0,0:11:54.75,0:11:57.13,Default,,0,0,0,,Әкем бәрін сатса керек.
Dialogue: 0,0:11:57.21,0:12:00.92,Default,,0,0,0,,Енді ол онлайн аукциондарда керемет бағаға ие болды.
Dialogue: 0,0:12:01.42,0:12:02.80,Default,,0,0,0,,Миллиондар немесе басқалары
Dialogue: 0,0:12:02.88,0:12:04.30,Default,,0,0,0,,Миллиондар…
Dialogue: 0,0:12:04.39,0:12:05.64,Default,,0,0,0,,Аа, Тоқайрин мырза
Dialogue: 0,0:12:05.72,0:12:07.56,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:12:07.64,0:12:10.85,Default,,0,0,0,,Бұл Такахаши мырза, жаңалықтар сайтының тілшісі.
Dialogue: 0,0:12:11.35,0:12:14.81,Default,,0,0,0,,Такахаши мырза, бұл біздің қызметкерлеріміздің бірі Тоқайрин.
Dialogue: 0,0:12:15.35,0:12:17.11,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:12:17.69,0:12:19.11,Default,,0,0,0,,Менің атым Такахаши.
Dialogue: 0,0:12:24.99,0:12:26.70,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:26.78,0:12:29.41,Default,,0,0,0,,Бұл біздің ең көне қорымыз.
Dialogue: 0,0:12:29.49,0:12:31.50,Default,,0,0,0,,Көптен бері солай...
Dialogue: 0,0:12:31.58,0:12:35.04,Default,,0,0,0,,Тіректер мен тіреуіштер сияқты сізге қажет нәрсе
Dialogue: 0,0:12:35.12,0:12:37.88,Default,,0,0,0,,Бірден жасай алатын шебер.
Dialogue: 0,0:12:37.96,0:12:39.04,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:12:41.96,0:12:42.97,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:12:44.93,0:12:47.51,Default,,0,0,0,,Бұл бұйымдар әзірленетін бөлме
Dialogue: 0,0:12:47.60,0:12:50.18,Default,,0,0,0,,Ол блендер бөлмесі деп аталады.
Dialogue: 0,0:12:50.26,0:12:51.93,Default,,0,0,0,,- (Kotaro) Блендер? -(Рюу) Иә.
Dialogue: 0,0:12:52.02,0:12:54.94,Default,,0,0,0,,Нарықтағы вискилердің көпшілігі
Dialogue: 0,0:12:55.02,0:12:58.19,Default,,0,0,0,,Түрлі бөшкелерден өңделмеген сакені араластыру арқылы жасалады.
Dialogue: 0,0:12:58.27,0:13:01.57,Default,,0,0,0,,Неліктен? Ол тек бөшкеде тұра алмайды ма?
Dialogue: 0,0:13:02.07,0:13:06.82,Default,,0,0,0,,Араластырылмаған саке бірдей дайындалса да, әр бөшкенің дәмі мен хош иісі әртүрлі болады.
Dialogue: 0,0:13:07.82,0:13:10.74,Default,,0,0,0,,Бұл даралықты көрсету үшін вискиді араластырудың кілті
Dialogue: 0,0:13:10.83,0:13:12.62,Default,,0,0,0,,Бұл араластырғыштың жұмысы.
Dialogue: 0,0:13:13.12,0:13:14.37,Default,,0,0,0,,Блендер…
Dialogue: 0,0:13:15.08,0:13:18.04,Default,,0,0,0,,Виски жасаудың әртүрлі процестері бар.
Dialogue: 0,0:13:18.54,0:13:20.50,Default,,0,0,0,,Мен қоспаларды жақсы көремін
Dialogue: 0,0:13:21.09,0:13:23.67,Default,,0,0,0,,Қоспасыз сакенің ондаған түрін араластыру
Dialogue: 0,0:13:24.17,0:13:27.13,Default,,0,0,0,,Тартымды виски жасау қиын.
Dialogue: 0,0:13:27.64,0:13:30.60,Default,,0,0,0,,Бірақ бұл оны соншалықты қызықты етеді ...
Dialogue: 0,0:13:31.22,0:13:33.22,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:13:33.31,0:13:37.23,Default,,0,0,0,,Маған жақын орынға отырыңыз, мен қазір дәм татамын.
Dialogue: 0,0:13:37.73,0:13:39.10,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:13:39.19,0:13:41.57,Default,,0,0,0,,Дәмін көру? Бұл алкоголь ме?
Dialogue: 0,0:13:42.07,0:13:43.98,Default,,0,0,0,,Алкогольді ұнатпайсыз ба?
Dialogue: 0,0:13:44.07,0:13:47.11,Default,,0,0,0,,Жоқ, мен жұмыста болған кезде...
Dialogue: 0,0:13:47.20,0:13:49.91,Default,,0,0,0,,Бұл да вискиді түсіну үшін маңызды тапсырма болып табылады.
Dialogue: 0,0:13:49.99,0:13:53.20,Default,,0,0,0,,А, иә, егер солай болса...
Dialogue: 0,0:13:53.74,0:13:57.75,Default,,0,0,0,,Арақ-шарап зауытының экскурсиясы сізге ұнамады ма?
Dialogue: 0,0:13:57.83,0:13:59.88,Default,,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:13:59.96,0:14:01.34,Default,,0,0,0,,- (Котаро) Мен көп нәрсені білдім - (Томоко) А...
Dialogue: 0,0:14:01.92,0:14:02.88,Default,,0,0,0,,Қарсы боласыз ба?
Dialogue: 0,0:14:02.96,0:14:04.34,Default,,0,0,0,,Не?
Dialogue: 0,0:14:04.84,0:14:07.93,Default,,0,0,0,,Аа, Такахаши мырза, сәл күте тұрыңыз.
Dialogue: 0,0:14:09.13,0:14:10.09,Default,,0,0,0,,Не?
Dialogue: 0,0:14:10.18,0:14:11.05,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:14:11.14,0:14:12.22,Default,,0,0,0,,Не болды?
Dialogue: 0,0:14:12.72,0:14:15.60,Default,,0,0,0,,Сол адам біздің жұмысымызды басынан өткерсін
Dialogue: 0,0:14:15.68,0:14:16.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:16.64,0:14:19.60,Default,,0,0,0,,Оларға үнемі келіп, тәжірибеден өтуге мүмкіндік беріңіз.
Dialogue: 0,0:14:19.69,0:14:22.11,Default,,0,0,0,,Мен оны осы серияға мақала ретінде жазғанын қалаймын.
Dialogue: 0,0:14:22.19,0:14:23.02,Default,,0,0,0,,Қызық емес пе?
Dialogue: 0,0:14:23.11,0:14:26.07,Default,,0,0,0,,Тіпті мұны істеудің қажеті болмаса да...
Dialogue: 0,0:14:27.40,0:14:28.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:31.45,0:14:32.78,Default,,0,0,0,,Рюсей Көрмедің бе?
Dialogue: 0,0:14:32.87,0:14:35.04,Default,,0,0,0,,Рюсей? Ах...
Dialogue: 0,0:14:35.12,0:14:38.04,Default,,0,0,0,,Президент Комада қазір өз орнында жоқ.
Dialogue: 0,0:14:38.12,0:14:40.00,Default,,0,0,0,,Мен жақында ораламын деп ойлаймын.
Dialogue: 0,0:14:40.50,0:14:43.29,Default,,0,0,0,,Олай болса, мен сені күтемін.
Dialogue: 0,0:14:44.13,0:14:46.67,Default,,0,0,0,,Қазір біз үшін ең маңызды уақыт.
Dialogue: 0,0:14:46.76,0:14:50.72,Default,,0,0,0,,Біз аз да болса жарнама болуы мүмкін кез келген нәрсені істеуіміз керек.
Dialogue: 0,0:14:50.80,0:14:54.89,Default,,0,0,0,,Токиодан осы жерге дейін жол ақысын төлеу ауыртпалық болмай ма?
Dialogue: 0,0:14:54.97,0:14:56.81,Default,,0,0,0,,Мен сені алып кетейін.
Dialogue: 0,0:14:56.89,0:14:59.73,Default,,0,0,0,,Оны Токиодағы сату сапарынан үйге қайтар жолда алыңыз.
Dialogue: 0,0:14:59.81,0:15:00.98,Default,,0,0,0,,Уф
Dialogue: 0,0:15:01.06,0:15:03.06,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:15:03.15,0:15:05.44,Default,,0,0,0,,Бастықпен, Ясумото-санмен тікелей сөйлесіңіз.
Dialogue: 0,0:15:05.94,0:15:08.32,Default,,0,0,0,,Мен Вакабада болғанымда да сен маған көмектестің.
Dialogue: 0,0:15:08.82,0:15:11.07,Default,,0,0,0,,Мен мұны істей аламын деп ойлаймын, өйткені мен вискиге құмармын.
Dialogue: 0,0:15:13.16,0:15:13.74,Default,,0,0,0,,Ум...
Dialogue: 0,0:15:14.24,0:15:15.95,Default,,0,0,0,,Сіз жаңа қызметкерсіз бе?
Dialogue: 0,0:15:16.04,0:15:16.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:17.16,0:15:19.71,Default,,0,0,0,,Жоқ, мен бұл жерден емеспін...
Dialogue: 0,0:15:20.21,0:15:22.08,Default,,0,0,0,,Онда сен неге бұл бөлмедесің?
Dialogue: 0,0:15:22.17,0:15:23.50,Default,,0,0,0,,Бұл блендер бөлмесі.
Dialogue: 0,0:15:23.58,0:15:24.84,Default,,0,0,0,,Бұл адам жақсы ма?
Dialogue: 0,0:15:25.46,0:15:27.46,Default,,0,0,0,,Мен оны дәм тату үшін жібердім.
Dialogue: 0,0:15:27.96,0:15:30.09,Default,,0,0,0,,Бірақ сенен өткенім есімде жоқ.
Dialogue: 0,0:15:30.59,0:15:34.18,Default,,0,0,0,,«Сіз» «сіз» деген сөз емес пе?
Dialogue: 0,0:15:34.68,0:15:36.14,Default,,0,0,0,,Өйткені бұл басқа біреу.
Dialogue: 0,0:15:36.22,0:15:38.60,Default,,0,0,0,,Сіз бұған шындап қарайсыз ба?
Dialogue: 0,0:15:38.68,0:15:40.35,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:15:40.43,0:15:42.48,Default,,0,0,0,,Мен өткен күні айтқанымды жалғастырғым келеді.
Dialogue: 0,0:15:42.56,0:15:44.61,Default,,0,0,0,,Әңгімелейтін ештеңе жоқ.
Dialogue: 0,0:15:44.69,0:15:46.69,Default,,0,0,0,,Осыны айтқанда мен сені ойлаймын...
Dialogue: 0,0:15:46.77,0:15:47.94,Default,,0,0,0,,Мен үшін?
Dialogue: 0,0:15:48.03,0:15:50.15,Default,,0,0,0,,Мұндай ыңғайлы нәрсе...
Dialogue: 0,0:15:54.74,0:15:56.45,Default,,0,0,0,,Эй КОМА...
Dialogue: 0,0:15:57.03,0:15:58.62,Default,,0,0,0,,Неліктен шың?
Dialogue: 0,0:15:58.70,0:16:00.66,Default,,0,0,0,,Сіз қазір KOMA-ны зерттеп жатырсыз ба?
Dialogue: 0,0:16:00.75,0:16:02.67,Default,,0,0,0,,Ах! Ясу-сан
Dialogue: 0,0:16:02.75,0:16:05.46,Default,,0,0,0,,Комада спирт зауытымен жұмыс істеуді шешсеңіз
Dialogue: 0,0:16:05.54,0:16:07.71,Default,,0,0,0,,Бұл әдетте бірінші аты шығады.
Dialogue: 0,0:16:07.80,0:16:11.17,Default,,0,0,0,,А... жоқ, мен тереңірек білгім келеді.
Dialogue: 0,0:16:11.26,0:16:13.80,Default,,0,0,0,,Мен интернеттен де көп білетін шығармын.
Dialogue: 0,0:16:14.30,0:16:15.76,Default,,0,0,0,,Өйткені, мен жанкүйер едім.
Dialogue: 0,0:16:15.84,0:16:18.39,Default,,0,0,0,,“Ws”… өткен шақ па?
Dialogue: 0,0:16:18.89,0:16:22.43,Default,,0,0,0,,Жоқ, мен оны қазір ала алмаймын.
Dialogue: 0,0:16:22.52,0:16:26.02,Default,,0,0,0,,А, түсіндім, олар қазір оларды салып жатқан жоқ.
Dialogue: 0,0:16:26.11,0:16:28.57,Default,,0,0,0,,Бірақ ол президент болғаннан кейін
Dialogue: 0,0:16:28.65,0:16:32.24,Default,,0,0,0,,Комада спирт зауыты араластырылмаған виски жасауды жалғастырады.
Dialogue: 0,0:16:32.32,0:16:33.86,Default,,0,0,0,,Бұл қызу тақырыпқа айналды.
Dialogue: 0,0:16:34.36,0:16:35.57,Default,,0,0,0,,Иә
Dialogue: 0,0:16:36.16,0:16:39.62,Default,,0,0,0,,Жер сілкінісі кезінде жоғалған кастрюльдерді қалпына келтіруге кеткен шығындар.
Dialogue: 0,0:16:40.12,0:16:43.37,Default,,0,0,0,,Олар краудфандинг арқылы шамамен 20 миллион иен жабуы керек еді.
Dialogue: 0,0:16:43.87,0:16:46.29,Default,,0,0,0,,Қалған 70-80 миллион иен сіздің жауапкершілігіңіз болады.
Dialogue: 0,0:16:47.04,0:16:50.63,Default,,0,0,0,,Мұндай көлемдегі компания үшін бұл өте қиын.
Dialogue: 0,0:16:51.13,0:16:54.59,Default,,0,0,0,,Ал виски пайдалы болу үшін көп уақыт қажет.
Dialogue: 0,0:16:55.72,0:16:59.60,Default,,0,0,0,,Өйткені, компанияның табысы күн сайын қауіп төндіреді.
Dialogue: 0,0:16:59.68,0:17:03.02,Default,,0,0,0,,Жоқ, саған айтар сөзім бар еді.
Dialogue: 0,0:17:03.10,0:17:04.98,Default,,0,0,0,,Ағымдағы серияда
Dialogue: 0,0:17:05.06,0:17:06.90,Default,,0,0,0,,Комада спирт зауытына көмектесу
Dialogue: 0,0:17:06.98,0:17:10.69,Default,,0,0,0,,Виски жасау тәжірибесі туралы мақала жазуға қалай қарайсыз?
Dialogue: 0,0:17:10.77,0:17:12.94,Default,,0,0,0,,Мұны Кавабата мырза ұсынды.
Dialogue: 0,0:17:13.03,0:17:13.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:13.90,0:17:15.57,Default,,0,0,0,,Ол адам өте ынталы.
Dialogue: 0,0:17:15.65,0:17:16.66,Default,,0,0,0,,Мүмкін мен мұны істеймін.
Dialogue: 0,0:17:16.74,0:17:17.32,Default,,0,0,0,,Не!
Dialogue: 0,0:17:18.32,0:17:22.29,Default,,0,0,0,,Сонымен қатар, Кавабата мырза мені ұнатпайтынын айтты.
Dialogue: 0,0:17:22.37,0:17:24.66,Default,,0,0,0,,Мен сұхбат алушының аты-жөнін қате жазыппын.
Dialogue: 0,0:17:24.75,0:17:27.96,Default,,0,0,0,,Мен Комада спирт зауытында да көп зерттеулер жүргізген жоқпын.
Dialogue: 0,0:17:28.46,0:17:31.13,Default,,0,0,0,,Мен саған айттым, тым болмаса зерттеуіңді жүргіз.
Dialogue: 0,0:17:31.75,0:17:33.26,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:17:33.76,0:17:36.51,Default,,0,0,0,,Мен кенеттен лақтырылдым, көп уақытым болмады.
Dialogue: 0,0:17:36.59,0:17:40.05,Default,,0,0,0,,Біреудің атын қателескеніме көп болды.
Dialogue: 0,0:17:40.55,0:17:42.72,Default,,0,0,0,,Бұл ақыл мен сана мәселесі.
Dialogue: 0,0:17:45.48,0:17:46.85,Default,,0,0,0,,Жасың нешеде?
Dialogue: 0,0:17:47.69,0:17:49.19,Default,,0,0,0,,Менің жасым 25-те
Dialogue: 0,0:17:49.69,0:17:51.32,Default,,0,0,0,,Осы кәсіпорында қанша жыл жұмыс істедіңіз?
Dialogue: 0,0:17:51.98,0:17:53.28,Default,,0,0,0,,Бесінші
Dialogue: 0,0:17:54.57,0:17:56.82,Default,,0,0,0,,Ха... жақсы, сәттілік
Dialogue: 0,0:17:59.66,0:18:00.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:01.49,0:18:02.45,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:11.17,0:18:12.38,Default,,0,0,0,,(алдыңғы есіктің ашылу дыбысы)
Dialogue: 0,0:18:16.67,0:18:17.59,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:18:17.67,0:18:20.55,Default,,0,0,0,,Қош келдіңіз, бүгін де кешігіп қалдыңыз.
Dialogue: 0,0:18:20.64,0:18:21.68,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:18:22.51,0:18:25.31,Default,,0,0,0,,Бұл осы айдың төлемі...
Dialogue: 0,0:18:25.39,0:18:27.18,Default,,0,0,0,,Иә, мен оны сақтаймын.
Dialogue: 0,0:18:29.31,0:18:32.77,Default,,0,0,0,,Бұл шынымен де күрделі салым салуға тұрарлық болды ма?
Dialogue: 0,0:18:33.27,0:18:36.19,Default,,0,0,0,,Енді қарыз алу қиын болады...
Dialogue: 0,0:18:36.28,0:18:38.82,Default,,0,0,0,,Иә, дәл қазір қатты ауырады.
Dialogue: 0,0:18:38.90,0:18:39.95,Default,,0,0,0,,Қарсымын!
Dialogue: 0,0:18:40.57,0:18:44.20,Default,,0,0,0,,Дәл осылай әкем өз бетімен еңбектене берді...
Dialogue: 0,0:18:45.54,0:18:46.41,Default,,0,0,0,,Хаа…
Dialogue: 0,0:18:47.16,0:18:48.91,Default,,0,0,0,,Мен қазір ұйықтаймын
Dialogue: 0,0:18:51.75,0:18:53.21,Default,,0,0,0,,Рюсей де, қалыпты жағдайда.
Dialogue: 0,0:18:53.71,0:18:55.42,Default,,0,0,0,,Мм... анашым
Dialogue: 0,0:18:55.50,0:18:57.80,Default,,0,0,0,,Бүгін спирт зауытына ағам келді.
Dialogue: 0,0:18:59.76,0:19:00.59,Default,,0,0,0,,Иә
Dialogue: 0,0:19:09.43,0:19:12.31,Default,,0,0,0,,Мен қазіргі жұмысымды тастауым керек пе?
Dialogue: 0,0:19:12.40,0:19:15.07,Default,,0,0,0,,Не болды? Әлі жарты жыл бар
Dialogue: 0,0:19:15.15,0:19:17.78,Default,,0,0,0,,Менің ойымша, бұл жақсы емес.
Dialogue: 0,0:19:17.86,0:19:21.11,Default,,0,0,0,,Бұл қызықты да, пайдалы да емес.
Dialogue: 0,0:19:21.20,0:19:22.20,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:22.28,0:19:25.41,Default,,0,0,0,,Мен бұл жұмысқа дайын емеспін деп ойлаймын.
Dialogue: 0,0:19:25.49,0:19:26.87,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:27.91,0:19:30.62,Default,,0,0,0,,Сен ше, Юсуке?
Dialogue: 0,0:19:30.71,0:19:31.58,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:19:31.67,0:19:33.42,Default,,0,0,0,,Топтан шығыңыз
Dialogue: 0,0:19:33.50,0:19:37.34,Default,,0,0,0,,Сіз қарым-қатынасыңыз бар дыбыс жазу компаниясының қызметкері болғаныңызды айттыңыз.
Dialogue: 0,0:19:37.84,0:19:38.71,Default,,0,0,0,,Бұл әлі жалғасып жатыр ма?
Dialogue: 0,0:19:38.80,0:19:40.30,Default,,0,0,0,,О, солай!
Dialogue: 0,0:19:40.80,0:19:41.84,Default,,0,0,0,,Енді Гамма жазбасымен
Dialogue: 0,0:19:41.93,0:19:43.93,Default,,0,0,0,,Мен Тұзды Қант атты топтың жетекшісімін...
Dialogue: 0,0:19:44.51,0:19:47.81,Default,,0,0,0,,Ал... күте тұрыңыз! Бұл ірі өндірушінің танымал тобы.
Dialogue: 0,0:19:47.89,0:19:50.18,Default,,0,0,0,,Сондықтан мен соңғы уақытта өте бос емеспін.
Dialogue: 0,0:19:51.23,0:19:54.73,Default,,0,0,0,,Егер мен де орта мектепті тастамасам, мен сенімен бірге топта боламын.
Dialogue: 0,0:19:55.23,0:19:57.32,Default,,0,0,0,,Сіз сияқты дебют жасау мүмкін болмаса да
Dialogue: 0,0:19:57.40,0:20:00.65,Default,,0,0,0,,Мүмкін мен продюсер ретінде сәтті өмір сүрдім.
Dialogue: 0,0:20:01.15,0:20:03.53,Default,,0,0,0,,Иә, иә, сіз әлі ішіп жатырсыз, солай ма?
Dialogue: 0,0:20:04.03,0:20:04.99,Default,,0,0,0,,Иә
Dialogue: 0,0:20:07.33,0:20:07.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:08.62,0:20:10.87,Default,,0,0,0,,Өткен күні шие гүлдері ұсынылды...
Dialogue: 0,0:20:10.95,0:20:11.58,Default,,0,0,0,,Рука, сен күнде қылыш айналдыру жаттығуын жасап жүрсің ғой?
Dialogue: 0,0:20:12.16,0:20:13.42,Default,,0,0,0,,Жоқ, ештеңе...
Dialogue: 0,0:20:13.92,0:20:15.08,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:20:15.17,0:20:17.09,Default,,0,0,0,,Виски? Бұл сирек.
Dialogue: 0,0:20:17.88,0:20:20.09,Default,,0,0,0,,Иә, кейде
Dialogue: 0,0:20:23.59,0:20:25.84,Default,,0,0,0,,Мұның бәрі менің сұхбатым үшін.
Dialogue: 0,0:20:26.43,0:20:28.81,Default,,0,0,0,,Такахаши мырзадан бірдеңе бар ма?
Dialogue: 0,0:20:28.89,0:20:29.93,Default,,0,0,0,,№.
Dialogue: 0,0:20:30.02,0:20:33.23,Default,,0,0,0,,А... Ал, бүгінгі күн үшін рахмет.
Dialogue: 0,0:20:33.31,0:20:34.52,Default,,0,0,0,,Мен де солай.
Dialogue: 0,0:20:34.60,0:20:38.32,Default,,0,0,0,,Жоқ, Wakaba-ны жасаған әйел блендер.
Dialogue: 0,0:20:38.40,0:20:39.69,Default,,0,0,0,,Ақыры мен сені кездестірдім.
Dialogue: 0,0:20:39.78,0:20:43.20,Default,,0,0,0,,Мен бұл жай ғана өсек екеніне ұялып отырмын.
Dialogue: 0,0:20:43.78,0:20:45.82,Default,,0,0,0,,Жоқ, жоқ, дәл мен естідім.
Dialogue: 0,0:20:45.91,0:20:48.95,Default,,0,0,0,,Жас болсаң да виски туралы көп білесің.
Dialogue: 0,0:20:49.45,0:20:51.66,Default,,0,0,0,,Мм... Менің бір өтінішім бар...
Dialogue: 0,0:20:52.16,0:20:53.08,Default,,0,0,0,,Иә? саған не керек?
Dialogue: 0,0:20:53.16,0:20:55.21,Default,,0,0,0,,Өзіңіз үшін жазу—
Dialogue: 0,0:20:55.29,0:20:57.54,Default,,0,0,0,,Дәмі бар ма?
Dialogue: 0,0:20:58.04,0:21:00.84,Default,,0,0,0,,Егер бар болса, мен оны көргім келеді.
Dialogue: 0,0:21:00.92,0:21:03.05,Default,,0,0,0,,Ой...
Dialogue: 0,0:21:03.55,0:21:05.22,Default,,0,0,0,,Сәл күте тұрыңыз.
Dialogue: 0,0:21:05.84,0:21:08.14,Default,,0,0,0,,Мм... дәмдік белгілер дегеніміз не?
Dialogue: 0,0:21:08.64,0:21:11.56,Default,,0,0,0,,Қысқасы, әртүрлі вискилердің хош иісі мен дәмі.
Dialogue: 0,0:21:11.64,0:21:14.18,Default,,0,0,0,,Өзімше жазып алған естелік.
Dialogue: 0,0:21:14.27,0:21:15.85,Default,,0,0,0,,болды
Dialogue: 0,0:21:15.94,0:21:20.19,Default,,0,0,0,,Мен соңғы кездері көп жазбаймын, бірақ біраз бұрын болды.
Dialogue: 0,0:21:20.27,0:21:22.65,Default,,0,0,0,,Кешіріңіз, рахмет
Dialogue: 0,0:21:27.16,0:21:29.07,Default,,0,0,0,,Менікі осылай көрінеді
Dialogue: 0,0:21:29.66,0:21:31.20,Default,,0,0,0,,Бұл нашар қолжазба
Dialogue: 0,0:21:31.91,0:21:35.91,Default,,0,0,0,,Керемет... Сіз сол кездегі декорацияны аналогия ретінде пайдаланып отырсыз.
Dialogue: 0,0:21:36.42,0:21:37.42,Default,,0,0,0,,Иә
Dialogue: 0,0:21:37.92,0:21:38.92,Default,,0,0,0,,Ал, Комада мырза да.
Dialogue: 0,0:21:39.00,0:21:41.13,Default,,0,0,0,,Сонымен, сіз жазбаларды дәмін татып отырасыз ба?
Dialogue: 0,0:21:41.21,0:21:42.50,Default,,0,0,0,,Иә, жақсы...
Dialogue: 0,0:21:42.59,0:21:44.46,Default,,0,0,0,,Маған келесі жолы көрсетсеңіз...
Dialogue: 0,0:21:44.55,0:21:46.43,Default,,0,0,0,,Және... бұл шектен шыққан!
Dialogue: 0,0:21:46.51,0:21:49.93,Default,,0,0,0,,Менікі ешкімге көрсете алмайтын нәрсе емес...
Dialogue: 0,0:21:50.01,0:21:51.18,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:21:51.26,0:21:53.97,Default,,0,0,0,,Егер сіз оны мақала ретінде жазсаңыз, бетті көру саны артады...
Dialogue: 0,0:21:54.06,0:21:56.18,Default,,0,0,0,,Аа... көп рахмет.
Dialogue: 0,0:21:56.69,0:21:58.94,Default,,0,0,0,,Маған маңызды нәрсе көрсетіңізші
Dialogue: 0,0:21:59.02,0:21:59.73,Default,,0,0,0,,Мен көптен бері өлі болсам да
Dialogue: 0,0:22:02.98,0:22:03.90,Default,,0,0,0,,Такахаши мырза
Dialogue: 0,0:22:03.98,0:22:06.24,Default,,0,0,0,,Сіз вискидің қандай түрін ішесіз?
Dialogue: 0,0:22:06.32,0:22:09.45,Default,,0,0,0,,Шынымды айтсам, мен вискиді көп ішпеймін...
Dialogue: 0,0:22:09.53,0:22:11.58,Default,,0,0,0,,Ах, өткен күні...
Dialogue: 0,0:22:11.66,0:22:13.74,Default,,0,0,0,,Мен көктемгі уыт деген нәрсені іштім.
Dialogue: 0,0:22:13.83,0:22:16.62,Default,,0,0,0,,Иә иә Сакурамори мырза
Dialogue: 0,0:22:17.12,0:22:18.17,Default,,0,0,0,,Бұл танымал, солай емес пе?
Dialogue: 0,0:22:18.25,0:22:19.29,Default,,0,0,0,,Бұл дәмді, солай емес пе?
Dialogue: 0,0:22:19.37,0:22:21.67,Default,,0,0,0,,Бүгінгі күн үшін көп рахмет.
Dialogue: 0,0:22:22.17,0:22:25.67,Default,,0,0,0,,Ал, мен президент Такахаши мырзаны вокзалға апарамын.
Dialogue: 0,0:22:25.76,0:22:27.59,Default,,0,0,0,,Иә, мен де танысқаныма қуаныштымын.
Dialogue: 0,0:22:28.09,0:22:30.47,Default,,0,0,0,,Такахаши мырза, еңбегіңіз үшін рахмет.
Dialogue: 0,0:22:30.97,0:22:34.22,Default,,0,0,0,,Біз сізді келесі жолы көреміз.
Dialogue: 0,0:22:34.31,0:22:36.52,Default,,0,0,0,,Мақала Мен оны асыға күтемін.
Dialogue: 0,0:22:36.60,0:22:38.31,Default,,0,0,0,,Иә
Dialogue: 0,0:22:38.39,0:22:40.77,Default,,0,0,0,,Сонымен, бізде бұл бар
Dialogue: 0,0:22:44.40,0:22:48.90,Default,,0,0,0,,Сіз бізбен алдын ала хабарласқандықтан, өңделмеген саке дайын.
Dialogue: 0,0:22:48.99,0:22:52.07,Default,,0,0,0,,Сізден дәм татуды сұрағаным үшін кешіріңіз.
Dialogue: 0,0:22:52.16,0:22:53.53,Default,,0,0,0,,Содан кейін мұнда
Dialogue: 0,0:22:54.83,0:22:56.20,Default,,0,0,0,,Үйге бармайсың ба?
Dialogue: 0,0:22:56.75,0:22:59.62,Default,,0,0,0,,Біз әлі осындамыз ба?
Dialogue: 0,0:22:59.71,0:23:00.75,Default,,0,0,0,,Мен оны естіген жоқпын.
Dialogue: 0,0:23:01.42,0:23:05.13,Default,,0,0,0,,Дұрыс, сұхбаттан басқа мәселе.
Dialogue: 0,0:23:25.36,0:23:28.32,Default,,0,0,0,,Менің ойымша, сізге виски ұнайды.
Dialogue: 0,0:23:28.82,0:23:31.24,Default,,0,0,0,,Жақында 4-платформада...
Dialogue: 0,0:23:32.78,0:23:34.78,Default,,0,0,0,,Отбасының мұрагері болу деген нені білдіреді?
Dialogue: 0,0:23:35.87,0:23:38.54,Default,,0,0,0,,Орындалатын жұмыс басынан шешіледі.
Dialogue: 0,0:23:38.62,0:23:41.71,Default,,0,0,0,,Бұл сізге ұнайтын жұмыс болды ма?
Dialogue: 0,0:23:41.79,0:23:43.00,Default,,0,0,0,,(Смартфонның діріл дыбысы)
Dialogue: 0,0:23:55.05,0:23:55.93,Default,,0,0,0,,Хаа…
Dialogue: 0,0:24:12.74,0:24:13.61,Default,,0,0,0,,Сіз ояндыңыз ба?
Dialogue: 0,0:24:14.24,0:24:16.12,Default,,0,0,0,,Мен жұмысқа жаңа келдім.
Dialogue: 0,0:24:16.62,0:24:18.08,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,0:24:19.20,0:24:22.08,Default,,0,0,0,,Соңғы кездері сіз шаршаған сияқтысыз.
Dialogue: 0,0:24:22.79,0:24:24.17,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:24:24.67,0:24:25.88,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:24:25.96,0:24:29.46,Default,,0,0,0,,Сіздің тұрақты жұмысыңызға қоса, бұл жарнамаға арналған.
Dialogue: 0,0:24:29.55,0:24:34.01,Default,,0,0,0,,Сұхбат алу үшін айына екі рет бару қиын.
Dialogue: 0,0:24:34.68,0:24:37.55,Default,,0,0,0,,Мен оған аздап арқа сүйер едім.
Dialogue: 0,0:24:38.05,0:24:41.48,Default,,0,0,0,,Томо-чан ол адамға әрқашан қатал болды.
Dialogue: 0,0:24:41.98,0:24:45.35,Default,,0,0,0,,Сұхбатты дұрыс өткізсем, бәрі жақсы болады.
Dialogue: 0,0:24:45.85,0:24:49.73,Default,,0,0,0,,Бірақ мен Сакурамори Саке сыра қайнату зауытының атын айтқан сайын,
Dialogue: 0,0:24:49.82,0:24:50.94,Default,,0,0,0,,Мен сенің тоқтағаныңды қалаймын
Dialogue: 0,0:24:51.03,0:24:53.49,Default,,0,0,0,,Менің жанымда қалғаны осы болды.
Dialogue: 0,0:24:53.57,0:24:55.45,Default,,0,0,0,,Иә, бұл тітіркендіргіш.
Dialogue: 0,0:24:55.53,0:24:56.62,Default,,0,0,0,,Хехехе
Dialogue: 0,0:24:57.20,0:24:59.91,Default,,0,0,0,,Мұны тікелей айту дұрыс емес пе?
Dialogue: 0,0:24:59.99,0:25:01.20,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:25:01.29,0:25:05.42,Default,,0,0,0,,Мен өзімнің досым емеспін, сондықтан сыртта ешкімге көп айтпаймын.
Dialogue: 0,0:25:06.50,0:25:08.79,Default,,0,0,0,,Шыдай алсаң, істеу керек...
Dialogue: 0,0:25:09.29,0:25:11.42,Default,,0,0,0,,Мен оны келесі жолы ертең көремін.
Dialogue: 0,0:25:11.50,0:25:15.18,Default,,0,0,0,,Солай ма? Келесі сұхбат екі аптадан кейін болады.
Dialogue: 0,0:25:15.26,0:25:18.68,Default,,0,0,0,,Бұл емес, бұл спирт зауытының тәжірибесі туралы мақала.
Dialogue: 0,0:25:19.72,0:25:20.64,Default,,0,0,0,,Иә
Dialogue: 0,0:25:21.93,0:25:23.23,Default,,0,0,0,,Мен сені алып кетуге келдім.
Dialogue: 0,0:25:23.31,0:25:26.48,Default,,0,0,0,,Бүгін мен сізге біздің спирт зауытында тәжірибе ұсынамын.
Dialogue: 0,0:25:27.73,0:25:29.81,Default,,0,0,0,,Сіз шындап келдіңіз бе...
Dialogue: 0,0:25:37.07,0:25:37.99,Default,,0,0,0,,Хаа…
Dialogue: 0,0:25:38.57,0:25:40.91,Default,,0,0,0,,Не болды? Сізде уайым бар ма?
Dialogue: 0,0:25:41.41,0:25:42.58,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:25:43.37,0:25:45.25,Default,,0,0,0,,Мүмкін бұл жұмыс туралы шығар?
Dialogue: 0,0:25:45.33,0:25:46.08,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,0:25:46.16,0:25:48.50,Default,,0,0,0,,Уайымдамасаңыз жақсы
Dialogue: 0,0:25:49.00,0:25:51.29,Default,,0,0,0,,Мен виски туралы бәрін айтып беремін.
Dialogue: 0,0:25:51.88,0:25:54.05,Default,,0,0,0,,Жоқ, бұл дегеніміз...
Dialogue: 0,0:25:54.63,0:25:57.76,Default,,0,0,0,,Бірақ сен еңбекқорсың.
Dialogue: 0,0:25:57.84,0:26:00.35,Default,,0,0,0,,Өйткені мен басқалардан ерекшемін.
Dialogue: 0,0:26:00.85,0:26:04.68,Default,,0,0,0,,Жоқ, маған жұмыстан гөрі виски ұнайды.
Dialogue: 0,0:26:05.18,0:26:07.06,Default,,0,0,0,,Әсіресе сол президент.
Dialogue: 0,0:26:07.14,0:26:09.65,Default,,0,0,0,,Оның көп бөлігі вискиге түседі.
Dialogue: 0,0:26:09.73,0:26:10.98,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:26:11.48,0:26:14.86,Default,,0,0,0,,Есімде болса, ол ұрпақтан-ұрпаққа жалғасып келе жатқан отбасылық кәсіпті мұра етті.
Dialogue: 0,0:26:15.36,0:26:18.36,Default,,0,0,0,,Жарайды, егер сіз туылғаннан бері ішімдік бар болса.
Dialogue: 0,0:26:18.45,0:26:20.07,Default,,0,0,0,,Сен маған ғашық боласың ба?
Dialogue: 0,0:26:20.57,0:26:21.87,Default,,0,0,0,,СМАШ АҚШ-ы!
Dialogue: 0,0:26:21.95,0:26:23.03,Default,,0,0,0,,Бөлек
Dialogue: 0,0:26:23.58,0:26:26.50,Default,,0,0,0,,Мен тек жақсы көретін ісім менің жұмысым деп қызғанамын.
Dialogue: 0,0:26:26.58,0:26:27.33,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:26:27.41,0:26:28.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:28.87,0:26:31.67,Default,,0,0,0,,Рюсей бастапқыда өнер университетінде оқыған.
Dialogue: 0,0:26:31.75,0:26:33.75,Default,,0,0,0,,Мектепті тастап, компанияны өз қолыма алдым.
Dialogue: 0,0:26:34.25,0:26:36.76,Default,,0,0,0,,Негізі менің отбасылық үйді мұрагерлікке алу ойым болған жоқ.
Dialogue: 0,0:26:36.84,0:26:38.22,Default,,0,0,0,,Сонда неге...
Dialogue: 0,0:26:38.30,0:26:40.14,Default,,0,0,0,,Үзілістің соңы
Dialogue: 0,0:26:40.22,0:26:41.89,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,0:26:42.55,0:26:43.72,Default,,0,0,0,,Не...
Dialogue: 0,0:26:52.44,0:26:54.19,Default,,0,0,0,,Міне, келдік.
Dialogue: 0,0:26:54.27,0:26:55.44,Default,,0,0,0,,Иә
Dialogue: 0,0:26:55.94,0:26:58.15,Default,,0,0,0,,Қанша рет келсем де, жауабы сол қалпында қалады.
Dialogue: 0,0:26:58.24,0:27:01.70,Default,,0,0,0,,Сондықтан мен сізге айтып отырғаным, адамдардың айтқанын мұқият тыңдаңыз.
Dialogue: 0,0:27:01.78,0:27:02.41,Default,,0,0,0,,Сол адам...
Dialogue: 0,0:27:02.49,0:27:03.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:04.08,0:27:06.33,Default,,0,0,0,,Бұл күрделі болуы мүмкін, сондықтан оны жасырыңыз.
Dialogue: 0,0:27:06.41,0:27:10.04,Default,,0,0,0,,Ойлан, бұл жаман жағдай емес.
Dialogue: 0,0:27:10.12,0:27:11.92,Default,,0,0,0,,Қандай шарттар болғаны маңызды емес.
Dialogue: 0,0:27:12.42,0:27:14.67,Default,,0,0,0,,Мен сатып алуды бірінші кезекте қабылдауға ниетім жоқ.
Dialogue: 0,0:27:14.75,0:27:16.09,Default,,0,0,0,,Сатып алу?
Dialogue: 0,0:27:16.96,0:27:18.26,Default,,0,0,0,,Бұл адам кім?
Dialogue: 0,0:27:18.34,0:27:20.18,Default,,0,0,0,,Бұл Сакурамори Саке сыра қайнату зауытының адамы.
Dialogue: 0,0:27:20.26,0:27:22.34,Default,,0,0,0,,Сакурамори Саке сыра қайнату зауыты? Бұл...
Dialogue: 0,0:27:22.43,0:27:25.47,Default,,0,0,0,,Иә, сіздің сүйікті виски компаниясы.
Dialogue: 0,0:27:25.56,0:27:27.68,Default,,0,0,0,,Жоқ, маған ұнамайды...
Dialogue: 0,0:27:27.77,0:27:29.77,Default,,0,0,0,,Мен сенің қайта келгеніңді қаламаймын.
Dialogue: 0,0:27:29.85,0:27:32.65,Default,,0,0,0,,Бұл жұмыс істемейді. Біз отбасымыз.
Dialogue: 0,0:27:32.73,0:27:34.86,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:27:35.69,0:27:37.15,Default,,0,0,0,,Тіпті менің анам...
Dialogue: 0,0:27:37.65,0:27:39.03,Default,,0,0,0,,Хаа…
Dialogue: 0,0:27:40.03,0:27:41.03,Default,,0,0,0,,Екі қолым... сынғалы тұрғандай.
Dialogue: 0,0:27:41.11,0:27:42.20,Default,,0,0,0,,Рюсейдің ағасы
Dialogue: 0,0:27:42.28,0:27:43.87,Default,,0,0,0,,Иә, аға?
Dialogue: 0,0:27:44.37,0:27:48.58,Default,,0,0,0,,Сонда сіздің ағаңыз әпкеңіздің компаниясын сатып алмақшы ма?
Dialogue: 0,0:27:48.66,0:27:50.08,Default,,0,0,0,,Бұл күрделі, солай емес пе?
Dialogue: 0,0:27:50.66,0:27:53.79,Default,,0,0,0,,Сіз істеп жатқан нәрсе - бұл өзіңізді қанағаттандыру.
Dialogue: 0,0:27:54.29,0:27:57.50,Default,,0,0,0,,Егер менеджерлер компания басшылығын бірінші орынға қоймаса не істеу керек
Dialogue: 0,0:27:58.00,0:28:00.80,Default,,0,0,0,,Жағдай тұрақсыз болып қалса, қызметкердің жұмысын қорғау мүмкін емес.
Dialogue: 0,0:28:00.88,0:28:02.93,Default,,0,0,0,,Сол үшін пара алғыңыз келе ме?
Dialogue: 0,0:28:07.26,0:28:09.06,Default,,0,0,0,,Енді жұмысқа кірісейік
Dialogue: 0,0:28:09.56,0:28:11.85,Default,,0,0,0,,Бүгін мен Тоқайрин-саннан еріп жүруін сұраймын.
Dialogue: 0,0:28:11.94,0:28:13.19,Default,,0,0,0,,Маған әртүрлі нәрселерді айтып беруімді сұраңыз.
Dialogue: 0,0:28:13.27,0:28:15.86,Default,,0,0,0,,Не? Тоқайрин мырза...
Dialogue: 0,0:28:19.28,0:28:22.57,Default,,0,0,0,,Алдымен мына жерді тазалаймын. Таңертеңгілік жиынға дейін бітіремін.
Dialogue: 0,0:28:22.65,0:28:23.66,Default,,0,0,0,,Иә... иә
Dialogue: 0,0:28:23.74,0:28:25.45,Default,,0,0,0,,Аяқтағаннан кейін сөрелерді күшейтіңіз
Dialogue: 0,0:28:26.62,0:28:30.04,Default,,0,0,0,,Мен бұл мақала көбірек болар деп ойладым.
Dialogue: 0,0:28:31.04,0:28:32.75,Default,,0,0,0,,Мен кейінірек қайтамын.
Dialogue: 0,0:28:32.83,0:28:33.58,Default,,0,0,0,,Иә
Dialogue: 0,0:28:34.08,0:28:35.71,Default,,0,0,0,,Мм... шамды жағуға болады ма?
Dialogue: 0,0:28:40.34,0:28:41.26,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:28:41.76,0:28:42.59,Default,,0,0,0,,(қосу дыбысы)
Dialogue: 0,0:28:43.17,0:28:43.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:44.72,0:28:45.59,Default,,0,0,0,,(қосу дыбысы)
Dialogue: 0,0:28:46.09,0:28:46.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:47.68,0:28:49.18,Default,,0,0,0,,(қосу дыбысы)
Dialogue: 0,0:28:52.64,0:28:54.98,Default,,0,0,0,,Неліктен мен мұндай нәрсені істеймін ...
Dialogue: 0,0:29:06.95,0:29:07.87,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:29:07.95,0:29:08.58,Default,,0,0,0,,Ах
Dialogue: 0,0:29:10.08,0:29:11.91,Default,,0,0,0,,Ах... кешіріңіз.
Dialogue: 0,0:29:12.00,0:29:14.91,Default,,0,0,0,,Сізді кенеттен шақырғаным үшін кешіріңіз.
Dialogue: 0,0:29:15.00,0:29:16.46,Default,,0,0,0,,А... жоқ
Dialogue: 0,0:29:16.54,0:29:19.29,Default,,0,0,0,,Бүгін таңертең келгеніңіз үшін рахмет.
Dialogue: 0,0:29:19.38,0:29:21.75,Default,,0,0,0,,Ал... Мен үйреніп жатырмын.
Dialogue: 0,0:29:23.63,0:29:27.51,Default,,0,0,0,,Мен де көп істеймін, бірақ мұнда тазалау қызық.
Dialogue: 0,0:29:28.18,0:29:30.47,Default,,0,0,0,,Мен өзімді әлі бос сезінемін...
Dialogue: 0,0:29:30.97,0:29:32.93,Default,,0,0,0,,Мұнда да, Мұнда да
Dialogue: 0,0:29:33.43,0:29:36.69,Default,,0,0,0,,Бұдан былай жаңа бөшкелер салынатынын ескере отырып.
Dialogue: 0,0:29:36.77,0:29:37.85,Default,,0,0,0,,Керемет емес пе?
Dialogue: 0,0:29:37.94,0:29:40.36,Default,,0,0,0,,Уақыты келді…
Dialogue: 0,0:29:41.32,0:29:43.94,Default,,0,0,0,,А, сізді тоқтатқаным үшін кешіріңіз.
Dialogue: 0,0:29:44.44,0:29:47.82,Default,,0,0,0,,Белгілі бір жерде тоқтаңыз.
Dialogue: 0,0:29:48.32,0:29:50.24,Default,,0,0,0,,Жақында таңертеңгілік жиын өтеді.
Dialogue: 0,0:29:50.83,0:29:53.16,Default,,0,0,0,,Иә, иә, қалыпты жағдайда.
Dialogue: 0,0:30:02.96,0:30:03.88,Default,,0,0,0,,Аа...
Dialogue: 0,0:30:03.96,0:30:04.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:10.39,0:30:11.97,Default,,0,0,0,,Бұл Комада мырза ма?
Dialogue: 0,0:30:14.10,0:30:17.39,Default,,0,0,0,,Жоқ... бұл... бұл басқаша ма?
Dialogue: 0,0:30:19.65,0:30:21.31,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:30:21.40,0:30:22.57,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:30:22.65,0:30:26.15,Default,,0,0,0,,Қайырлы таң, жаңбыр жауып тұр.
Dialogue: 0,0:30:27.74,0:30:29.07,Default,,0,0,0,,Таңертеңгілік жиын...
Dialogue: 0,0:30:29.82,0:30:31.57,Default,,0,0,0,,Президент келгенде басталады
Dialogue: 0,0:30:31.66,0:30:32.91,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:30:32.99,0:30:34.37,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:30:34.45,0:30:36.04,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:30:37.58,0:30:39.42,Default,,0,0,0,,Барлықтарыңызға күткеніңізге рахмет.
Dialogue: 0,0:30:40.42,0:30:42.59,Default,,0,0,0,,Бұл... менің байлағышым!
Dialogue: 0,0:30:43.55,0:30:46.46,Default,,0,0,0,,А, бұл Комада мырзаныкі еді.
Dialogue: 0,0:30:47.51,0:30:48.01,Default,,0,0,0,,Ах
Dialogue: 0,0:30:52.51,0:30:53.72,Default,,0,0,0,,Ах!
Dialogue: 0,0:30:54.93,0:30:56.77,Default,,0,0,0,,Шектеу дегенді білмейсіңдер ғой…
Dialogue: 0,0:30:57.93,0:31:01.19,Default,,0,0,0,,Сіз де мынандай иллюстрацияларды саласыз... манга сияқты.
Dialogue: 0,0:31:02.56,0:31:06.69,Default,,0,0,0,,Өнер мектебіне түскеннен бері сурет салуға жақсы...
Dialogue: 0,0:31:07.69,0:31:08.78,Default,,0,0,0,,Не...
Dialogue: 0,0:31:09.28,0:31:12.78,Default,,0,0,0,,Ешқандай жұмыс жасай алмасаңыз да, сол сияқты қажетсіз сөздерді айтасыз.
Dialogue: 0,0:31:13.37,0:31:13.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:14.53,0:31:16.62,Default,,0,0,0,,Сұхбат алатын жерді зерттемеңіз
Dialogue: 0,0:31:16.70,0:31:20.04,Default,,0,0,0,,Мен бұған дейін вискиді шынымен зерттеген жоқпын.
Dialogue: 0,0:31:20.12,0:31:20.79,Default,,0,0,0,,Мотивацияңыз бар ма?
Dialogue: 0,0:31:22.83,0:31:24.13,Default,,0,0,0,,Қалағаныңды айт
Dialogue: 0,0:31:24.21,0:31:25.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:25.88,0:31:28.42,Default,,0,0,0,,Сіздей батаға ие болғаны қандай жақсы.
Dialogue: 0,0:31:28.51,0:31:29.01,Default,,0,0,0,,(Присцилла) Сол тәрбиесіз шлюхаға—
Dialogue: 0,0:31:29.09,0:31:30.68,Default,,0,0,0,,Мен оны естідім.
Dialogue: 0,0:31:30.76,0:31:32.76,Default,,0,0,0,,Мен вискиге ешқашан қызығушылық танытпадым.
Dialogue: 0,0:31:32.84,0:31:34.51,Default,,0,0,0,,Мен бұл жұмысқа кіріссем де
Dialogue: 0,0:31:34.60,0:31:35.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:35.72,0:31:39.35,Default,,0,0,0,,Өнермен айналысқым келеді, әйтпесе отбасын мұрагер етуім керек.
Dialogue: 0,0:31:39.43,0:31:42.06,Default,,0,0,0,,Бұл қызғанатын позиция, өйткені сіз не істегіңіз келетінін білесіз.
Dialogue: 0,0:31:42.56,0:31:44.44,Default,,0,0,0,,Мен туралы не білесің...
Dialogue: 0,0:31:54.74,0:31:55.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:56.66,0:31:57.45,Default,,0,0,0,,Ах!
Dialogue: 0,0:31:59.79,0:32:01.54,Default,,0,0,0,,Мен жасадым...
Dialogue: 0,0:32:03.17,0:32:04.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:32:05.50,0:32:07.42,Default,,0,0,0,,Мен енді мұнда келе алмаймын.
Dialogue: 0,0:32:07.92,0:32:10.17,Default,,0,0,0,,Эй, мұнда кел.
Dialogue: 0,0:32:13.05,0:32:14.97,Default,,0,0,0,,Енді жұмысқа қайта оралайық.
Dialogue: 0,0:32:25.36,0:32:26.86,Default,,0,0,0,,- (Тоқайрин) Отыр - (Котаро) А, иә.
Dialogue: 0,0:32:30.32,0:32:30.99,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:32:31.61,0:32:32.74,Default,,0,0,0,,Бұл менің шеберханам.
Dialogue: 0,0:32:40.50,0:32:42.29,Default,,0,0,0,,Мм... дәл қазір...
Dialogue: 0,0:32:42.37,0:32:44.62,Default,,0,0,0,,Рюсей де осында жиі келетін.
Dialogue: 0,0:32:45.50,0:32:50.05,Default,,0,0,0,,Мен компания немесе виски туралы ешнәрсе білмей-ақ жұмысты қабылдадым.
Dialogue: 0,0:32:50.55,0:32:52.63,Default,,0,0,0,,Мен мұнда келгенде жылап отырмын.
Dialogue: 0,0:32:56.93,0:32:59.39,Default,,0,0,0,,Рюсейдің өзінен үлкен ағасы бар.
Dialogue: 0,0:32:59.47,0:33:00.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:00.85,0:33:05.02,Default,,0,0,0,,Егер бұл рас болса, ол компанияны мұрагер ету керек еді...
Dialogue: 0,0:33:06.56,0:33:10.61,Default,,0,0,0,,Рю Токиоға өнер университетіне оқуға көшкеннен кейін көп ұзамай.
Dialogue: 0,0:33:10.69,0:33:12.94,Default,,0,0,0,,Спирт зауытына зақым келген жоқ.
Dialogue: 0,0:33:13.44,0:33:14.45,Default,,0,0,0,,Жер сілкінісі…
Dialogue: 0,0:33:14.53,0:33:15.11,Default,,0,0,0,,Хмм
Dialogue: 0,0:33:15.99,0:33:19.03,Default,,0,0,0,,Міне, біртүрлі бола бастады.
Dialogue: 0,0:33:19.66,0:33:21.70,Default,,0,0,0,,Мио-сан, маған мынаны беріңізші.
Dialogue: 0,0:33:21.79,0:33:23.87,Default,,0,0,0,,Иә, еңбектеріңіз үшін рахмет.
Dialogue: 0,0:33:23.96,0:33:24.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:24.66,0:33:28.00,Default,,0,0,0,,Виски жасауды тоқтату деген нені білдіреді?
Dialogue: 0,0:33:28.92,0:33:30.38,Default,,0,0,0,,Сіз білуіңіз керек
Dialogue: 0,0:33:30.46,0:33:32.21,Default,,0,0,0,,Қайталап көріңіз!
Dialogue: 0,0:33:32.84,0:33:36.05,Default,,0,0,0,,Тіпті қазір жабдыққа ақша салып, араластырылмаған саке дайындасаңыз да.
Dialogue: 0,0:33:36.13,0:33:38.47,Default,,0,0,0,,Сіз оны 10 жыл қартаю керек екенін білесіз.
Dialogue: 0,0:33:39.26,0:33:40.39,Default,,0,0,0,,Компанияның өмір сүруі өте қиын.
Dialogue: 0,0:33:40.47,0:33:40.97,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:33:43.02,0:33:45.98,Default,,0,0,0,,Біз виски жасалса да сатылмайтын заманда өмір сүріп жатырмыз.
Dialogue: 0,0:33:47.19,0:33:49.19,Default,,0,0,0,,Егер шегінгің келсе, дәл қазір.
Dialogue: 0,0:33:53.82,0:33:54.74,Default,,0,0,0,,Кей
Dialogue: 0,0:33:56.32,0:33:59.70,Default,,0,0,0,,КОМА-ға қаншалықты көңіл бөлесіз?
Dialogue: 0,0:33:59.78,0:34:01.49,Default,,0,0,0,,Мен де жақсы білемін.
Dialogue: 0,0:34:02.16,0:34:05.58,Default,,0,0,0,,Бұл залал компанияның басынан бастап өз бизнесін басқаруға қиналғанынан туындады.
Dialogue: 0,0:34:06.08,0:34:08.50,Default,,0,0,0,,Барлығы біреудің басын кесіп ала ма деп қорқады.
Dialogue: 0,0:34:08.58,0:34:10.29,Default,,0,0,0,,Мазасыздық сезімі
Dialogue: 0,0:34:10.96,0:34:13.25,Default,,0,0,0,,Неліктен президент вискиден бас тартты?
Dialogue: 0,0:34:13.34,0:34:15.38,Default,,0,0,0,,Бұл біздің қызметкерлерге арналған.
Dialogue: 0,0:34:16.55,0:34:18.51,Default,,0,0,0,,Сіз түсіне аласыз ба?
Dialogue: 0,0:34:22.47,0:34:24.47,Default,,0,0,0,,Бірақ Кей компанияны тастады.
Dialogue: 0,0:34:24.97,0:34:28.39,Default,,0,0,0,,Ештеңе деместен үйден шығып кетті.
Dialogue: 0,0:34:29.44,0:34:33.69,Default,,0,0,0,,Шочу сатылымдары KOMA қалдырған бос орынды толтыру үшін жеткілікті түрде артады.
Dialogue: 0,0:34:34.40,0:34:37.20,Default,,0,0,0,,Компанияның қаржылық жағдайы түбіне жетті.
Dialogue: 0,0:34:37.78,0:34:40.82,Default,,0,0,0,,Президент те кешке дейін қызу жұмысқа кірісті.
Dialogue: 0,0:34:42.70,0:34:43.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:34:43.91,0:34:45.04,Default,,0,0,0,,(алдыңғы есіктің ашылу дыбысы)
Dialogue: 0,0:34:51.08,0:34:52.29,Default,,0,0,0,,(түтіксіз шу)
Dialogue: 0,0:35:00.51,0:35:02.47,Default,,0,0,0,,Ах! әке
Dialogue: 0,0:35:03.10,0:35:05.89,Default,,0,0,0,,Ештеңе емес, аздап басым айналып кетті.
Dialogue: 0,0:35:08.14,0:35:10.77,Default,,0,0,0,,Кейді тауып, оны қайтарайық.
Dialogue: 0,0:35:11.27,0:35:13.73,Default,,0,0,0,,Бұл бала да компания туралы біледі...
Dialogue: 0,0:35:13.82,0:35:14.61,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:35:20.15,0:35:22.53,Default,,0,0,0,,Ол қалағандықтан үйден кетіп қалды.
Dialogue: 0,0:35:22.62,0:35:23.70,Default,,0,0,0,,Оны жай қалдырыңыз
Dialogue: 0,0:35:31.08,0:35:32.63,Default,,0,0,0,,Бұдан кейін алдыңғы
Dialogue: 0,0:35:32.71,0:35:35.55,Default,,0,0,0,,Артық жұмыс салдарынан қайтыс болды
Dialogue: 0,0:35:38.67,0:35:41.55,Default,,0,0,0,,Кей жерлеуге қатысқан жоқ.
Dialogue: 0,0:35:52.98,0:35:55.02,Default,,0,0,0,,Компания не істейді?
Dialogue: 0,0:35:55.11,0:35:58.23,Default,,0,0,0,,Егер бұл рас болса, менің ұлым мұрагер болуы керек еді...
Dialogue: 0,0:35:59.61,0:36:02.11,Default,,0,0,0,,Мен мұны Рюуден кейін естідім.
Dialogue: 0,0:36:02.20,0:36:07.41,Default,,0,0,0,,Осы кезде Мио-сан компанияны жабуды ойластырған сияқты.
Dialogue: 0,0:36:07.49,0:36:08.24,Default,,0,0,0,,
Dialogue: 0,0:36:08.33,0:36:09.33,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:36:16.96,0:36:17.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:36:18.75,0:36:19.63,Default,,0,0,0,,Рюсей
Dialogue: 0,0:36:28.93,0:36:33.94,Default,,0,0,0,,Қазіргі уақытта Сакурамори Саке сыра қайнату зауытында спирт зауытын кеңейту туралы айтылып жатыр.
Dialogue: 0,0:36:35.40,0:36:36.65,Default,,0,0,0,,Сіз қалай ойлайсыз, мама?
Dialogue: 0,0:36:37.15,0:36:39.90,Default,,0,0,0,,Біздің компанияны сатып алуға қатысқыңыз келе ме?
Dialogue: 0,0:36:40.40,0:36:42.74,Default,,0,0,0,,Енді мен де компанияға ұсыныс жасай аламын.
Dialogue: 0,0:36:42.82,0:36:43.82,Default,,0,0,0,,Барлығына жұмысқа орналасу...
Dialogue: 0,0:36:43.91,0:36:46.99,Default,,0,0,0,,Мен өз үйімді бейтаныс адамға сеніп тапсырамын деген ойым жоқ.
Dialogue: 0,0:36:47.49,0:36:50.24,Default,,0,0,0,,Менің әкем компанияны жабады.
Dialogue: 0,0:36:53.41,0:36:56.96,Default,,0,0,0,,Ал компания бүктеуге дайындықты бастады.
Dialogue: 0,0:36:57.54,0:37:01.55,Default,,0,0,0,,Қалған өңделмеген сакенің дәмі күшті болды, оны алатын адам болмады.
Dialogue: 0,0:37:02.05,0:37:05.30,Default,,0,0,0,,Ол қойманың бұрышында қалды.
Dialogue: 0,0:37:15.48,0:37:20.40,Default,,0,0,0,,Бұл бөшке 10 жылдан кейін KOMA пайдаланатын қоспасыз сакеге айналуы мүмкін.
Dialogue: 0,0:37:21.78,0:37:22.74,Default,,0,0,0,,Кверкус емені?
Dialogue: 0,0:37:22.82,0:37:24.24,Default,,0,0,0,,Ой!
Dialogue: 0,0:37:24.32,0:37:25.91,Default,,0,0,0,,- (Кей) Ахахха - (Рюу) Хэхехе
Dialogue: 0,0:37:26.53,0:37:28.41,Default,,0,0,0,,Жемісті және жарқын.
Dialogue: 0,0:37:28.49,0:37:30.28,Default,,0,0,0,,-（） -（）12
Dialogue: 0,0:37:30.37,0:37:32.87,Default,,0,0,0,,Бұл аздап шымтезек пе?
Dialogue: 0,0:37:32.95,0:37:34.62,Default,,0,0,0,,Не болды саған? Біраз қақтығысқыш болып тұрсың ғой?
Dialogue: 0,0:37:35.12,0:37:37.21,Default,,0,0,0,,Екпін ретінде қызықты
Dialogue: 0,0:37:37.71,0:37:39.29,Default,,0,0,0,,KOMA үшін жарамсыз
Dialogue: 0,0:37:39.38,0:37:41.09,Default,,0,0,0,,28 саны ше?
Dialogue: 0,0:37:41.17,0:37:44.80,Default,,0,0,0,,Әй, сол шымтезек сезім бізге тән.
Dialogue: 0,0:37:51.22,0:37:52.85,Default,,0,0,0,,Сіз университетті тастасаңыз да...
Dialogue: 0,0:37:53.35,0:37:54.43,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:37:54.52,0:37:55.73,Default,,0,0,0,,Рюсей
Dialogue: 0,0:37:55.81,0:37:59.11,Default,,0,0,0,,Сақтау бөлмесінде қалдырылған өңделмеген сакелерді кәдеге жаратасыз ба?
Dialogue: 0,0:37:59.19,0:37:59.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:38:01.11,0:38:03.23,Default,,0,0,0,,Мен әртүрлі нәрселерді қолданып көрдім, бірақ...
Dialogue: 0,0:38:04.24,0:38:07.53,Default,,0,0,0,,Мен сол араластырылмаған виски арқылы виски жасағым келеді.
Dialogue: 0,0:38:07.61,0:38:08.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:08.36,0:38:09.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:38:09.62,0:38:12.49,Default,,0,0,0,,Ата мен әкеден қалған өңделмеген саке
Dialogue: 0,0:38:12.58,0:38:13.83,Default,,0,0,0,,Мен оны тастағым келмейді
Dialogue: 0,0:38:14.87,0:38:18.04,Default,,0,0,0,,Өтінемін, маған бір жыл істеуге рұқсат етіңіз.
Dialogue: 0,0:38:20.17,0:38:21.54,Default,,0,0,0,,Мио мырза өңделмеген сакелерді де кәдеге жаратады.
Dialogue: 0,0:38:21.63,0:38:23.92,Default,,0,0,0,,Менің ойымша, біраз шатасу болды.
Dialogue: 0,0:38:25.26,0:38:27.93,Default,,0,0,0,,Арақ-шарап зауытындағы адамдар да Рюдің ойымен жүреді.
Dialogue: 0,0:38:28.01,0:38:31.01,Default,,0,0,0,,Ынтымақтастыққа дайын болды
Dialogue: 0,0:38:31.51,0:38:34.47,Default,,0,0,0,,Мио-сан ештеңе айтпастан қарап тұрды.
Dialogue: 0,0:38:37.48,0:38:42.77,Default,,0,0,0,,Уәде еткендей, Рю мен оның достары Вакабаны бір жылда салды.
Dialogue: 0,0:38:43.48,0:38:48.36,Default,,0,0,0,,Уакабаның шикі сакегі таусылып қалса, оны жасау мүмкін болмайды.
Dialogue: 0,0:38:49.11,0:38:50.82,Default,,0,0,0,,Және бұл күндер
Dialogue: 0,0:38:50.91,0:38:54.45,Default,,0,0,0,,Рюсей КОМА-ны тірілткім келеді деп ойлай бастады.
Dialogue: 0,0:38:55.91,0:39:00.92,Default,,0,0,0,,Арақ-шарап зауытындағы адамдар Рюге краудфандинг жасауды ұсынды.
Dialogue: 0,0:39:01.00,0:39:04.34,Default,,0,0,0,,Ақшаны жабдықты жаңартуға жұмсауға болады.
Dialogue: 0,0:39:05.96,0:39:07.92,Default,,0,0,0,,Президент Рюсей,
Dialogue: 0,0:39:08.42,0:39:11.97,Default,,0,0,0,,Жеке өзім 70-80 миллион иен қарызға алдым деп айтуға болады.
Dialogue: 0,0:39:12.97,0:39:16.60,Default,,0,0,0,,Мен бұл жұмысты басынан бастап қалағандықтан алмадым.
Dialogue: 0,0:39:17.31,0:39:20.90,Default,,0,0,0,,Бірақ ол жігіт қызғанышпен қараса ше?
Dialogue: 0,0:39:21.73,0:39:24.61,Default,,0,0,0,,Мен сенімдімін, өйткені олар мұны істеп көңілді болып көрінеді.
Dialogue: 0,0:39:26.40,0:39:30.82,Default,,0,0,0,,Бұрын жасыма қарай уайымдап, жылайтынмын.
Dialogue: 0,0:39:31.66,0:39:35.16,Default,,0,0,0,,Рюсейдің сендей болғанын көрмегелі көп болды.
Dialogue: 0,0:39:43.96,0:39:44.67,Default,,0,0,0,,Хаа…
Dialogue: 0,0:39:55.39,0:39:56.18,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:39:56.26,0:39:58.56,Default,,0,0,0,,Сәлеметсіз бе, бұл Комада.
Dialogue: 0,0:39:59.06,0:40:00.81,Default,,0,0,0,,Мен бүгін кешірім сұраймын.
Dialogue: 0,0:40:01.31,0:40:03.90,Default,,0,0,0,,Мен тағы да кешірім сұрағым келеді.
Dialogue: 0,0:40:04.40,0:40:06.44,Default,,0,0,0,,Мен тез телефон соғуға болады деп ойладым.
Dialogue: 0,0:40:07.11,0:40:09.44,Default,,0,0,0,,Сіздің келесі сұхбатыңызды асыға күтеміз.
Dialogue: 0,0:40:09.53,0:40:10.78,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:40:12.11,0:40:13.32,Default,,0,0,0,,Хаа…
Dialogue: 0,0:40:22.29,0:40:25.79,Default,,0,0,0,,Өнер Жасағым келеді, отбасын өз қолыма алуым керек, т.б.
Dialogue: 0,0:40:26.29,0:40:29.00,Default,,0,0,0,,Не істеу керектігі туралы нақты түсінікке ие болу қызғаныш позициясы.
Dialogue: 0,0:40:48.32,0:40:50.44,Default,,0,0,0,,Ал 16:42-де
Dialogue: 0,0:40:52.36,0:40:53.86,Default,,0,0,0,,- (Ясумото) Котаро - (Котаро) Ясу-сан
Dialogue: 0,0:40:54.74,0:40:56.91,Default,,0,0,0,,Сіз жұмыс істеп жатқан Комада спирт зауытына қатысты...
Dialogue: 0,0:40:56.99,0:40:59.41,Default,,0,0,0,,А... иә, шын мәнінде кеше...
Dialogue: 0,0:40:59.49,0:41:00.91,Default,,0,0,0,,Бұл өте танымал.
Dialogue: 0,0:41:01.00,0:41:01.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:01.70,0:41:04.37,Default,,0,0,0,,Серияның бірінші бөлімі өткен күні жарық көрді
Dialogue: 0,0:41:04.46,0:41:05.54,Default,,0,0,0,,Беттерді көру саны артып келеді
Dialogue: 0,0:41:06.04,0:41:07.29,Default,,0,0,0,,- (Котаро) Бұл рас па? -(А қызметкері) Иә?
Dialogue: 0,0:41:07.38,0:41:09.00,Default,,0,0,0,,- (Котаро) Ах - (А қызметкері) Уау!
Dialogue: 0,0:41:09.09,0:41:10.25,Default,,0,0,0,,Жасайық
Dialogue: 0,0:41:11.92,0:41:13.26,Default,,0,0,0,,Бұлай сұрама
Dialogue: 0,0:41:13.84,0:41:14.97,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:41:15.05,0:41:16.51,Default,,0,0,0,,Иә?what up?
Dialogue: 0,0:41:17.01,0:41:18.14,Default,,0,0,0,,Ал...
Dialogue: 0,0:41:20.51,0:41:21.89,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:41:22.60,0:41:23.64,Default,,0,0,0,,Ал...
Dialogue: 0,0:41:24.44,0:41:27.15,Default,,0,0,0,,Ясу бұл жұмысқа қалай ие болды?
Dialogue: 0,0:41:27.73,0:41:29.19,Default,,0,0,0,,Не? кенеттен
Dialogue: 0,0:41:29.27,0:41:30.61,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:41:30.69,0:41:32.07,Default,,0,0,0,,Қандай қызық жігіт.
Dialogue: 0,0:41:32.86,0:41:35.82,Default,,0,0,0,,Мен алғашында хабар таратушы болғым келді.
Dialogue: 0,0:41:36.32,0:41:38.41,Default,,0,0,0,,Теледидарда... хабар таратушы деген не?
Dialogue: 0,0:41:38.91,0:41:39.83,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:41:40.33,0:41:44.46,Default,,0,0,0,,Көп адамдармен шәкірт болып, жұмысына көмектескен кезім болды.
Dialogue: 0,0:41:44.96,0:41:46.83,Default,,0,0,0,,Неліктен жұмыстан шықтыңыз?
Dialogue: 0,0:41:46.92,0:41:49.92,Default,,0,0,0,,Мұндай жұмыста сіз бәрін істеуіңіз керек.
Dialogue: 0,0:41:50.00,0:41:52.30,Default,,0,0,0,,Сондай-ақ әртүрлі жерлерде тестілеуге болады.
Dialogue: 0,0:41:52.80,0:41:55.63,Default,,0,0,0,,Мақала жазу жұмысын кездейсоқ қабылдадым.
Dialogue: 0,0:41:56.22,0:41:58.59,Default,,0,0,0,,Бұл әйелдер косметикасын таныстыратын мақала болды.
Dialogue: 0,0:41:58.68,0:41:59.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:59.39,0:42:02.81,Default,,0,0,0,,О, мен «неге?» деп ойладым. да.
Dialogue: 0,0:42:03.31,0:42:07.19,Default,,0,0,0,,Бірақ адамдарға ұнаған шығар, сондықтан мен жазатын мақалалар көбейе бастады.
Dialogue: 0,0:42:07.69,0:42:09.81,Default,,0,0,0,,Мен білмей тұрып, бұл менің негізгі жұмысыма айналды.
Dialogue: 0,0:42:09.90,0:42:12.82,Default,,0,0,0,,Сонымен... бұл жақсы болды ма?
Dialogue: 0,0:42:13.48,0:42:14.82,Default,,0,0,0,,тырыспайсың?
Dialogue: 0,0:42:14.90,0:42:18.74,Default,,0,0,0,,Шарасыз талпыныстың нәтижесінде мен бұл жолды таба алдым.
Dialogue: 0,0:42:19.37,0:42:20.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:42:20.82,0:42:24.37,Default,,0,0,0,,Мен бұл жұмысты басынан бастап қалағандықтан алмадым.
Dialogue: 0,0:42:26.29,0:42:27.87,Default,,0,0,0,,Бұл сіз жасап жатқан серия.
Dialogue: 0,0:42:27.96,0:42:31.17,Default,,0,0,0,,Алдымен адамдар оны өзектілігіне байланысты оқиды, бірақ
Dialogue: 0,0:42:31.25,0:42:32.80,Default,,0,0,0,,Бұдан былай бұл тілшіге байланысты.
Dialogue: 0,0:42:33.30,0:42:34.30,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:42:35.51,0:42:37.80,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:42:40.59,0:42:41.80,Default,,0,0,0,,Аа.
Dialogue: 0,0:42:42.30,0:42:45.89,Default,,0,0,0,,Бүгінгі сұхбатты ұмытқан жоқсыз, солай ма?
Dialogue: 0,0:42:45.98,0:42:47.81,Default,,0,0,0,,Күн мен уақыт хабарланды, солай ма?
Dialogue: 0,0:42:47.89,0:42:51.23,Default,,0,0,0,,Иә, бірақ жауап жоқ.
Dialogue: 0,0:42:51.31,0:42:55.19,Default,,0,0,0,,Сонда да... сен ашулысың ғой.
Dialogue: 0,0:42:55.28,0:42:57.07,Default,,0,0,0,,Мүмкін ол енді келмейтін шығар
Dialogue: 0,0:42:57.15,0:42:58.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:58.20,0:43:00.49,Default,,0,0,0,,Бұл серия да тоқтатылды.
Dialogue: 0,0:43:00.57,0:43:01.99,Default,,0,0,0,,Бұл...
Dialogue: 0,0:43:02.62,0:43:03.83,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:43:03.91,0:43:04.49,Default,,0,0,0,,Хехе
Dialogue: 0,0:43:05.74,0:43:06.95,Default,,0,0,0,,Такахаши мырза
Dialogue: 0,0:43:07.45,0:43:09.54,Default,,0,0,0,,Өткен күн үшін кешірім сұраймын.
Dialogue: 0,0:43:10.08,0:43:11.92,Default,,0,0,0,,Мен қорқынышты нәрсе айттым.
Dialogue: 0,0:43:12.67,0:43:14.17,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:43:14.25,0:43:17.63,Default,,0,0,0,,Жоқ... жоқ, керісінше, мен кешірім сұрауым керек...
Dialogue: 0,0:43:19.26,0:43:20.18,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:43:22.26,0:43:23.85,Default,,0,0,0,,Уақыт таяп қалды
Dialogue: 0,0:43:24.56,0:43:25.56,Default,,0,0,0,,Барамыз ба?
Dialogue: 0,0:43:26.06,0:43:26.85,Default,,0,0,0,,Иә
Dialogue: 0,0:43:26.93,0:43:27.56,Default,,0,0,0,,Иә
Dialogue: 0,0:43:33.23,0:43:36.36,Default,,0,0,0,,Уақытыңызды бөліп сұхбат бергеніңіз үшін рахмет.
Dialogue: 0,0:43:36.44,0:43:38.99,Default,,0,0,0,,Жоқ, көп рахмет.
Dialogue: 0,0:43:39.65,0:43:41.61,Default,,0,0,0,,Бірінші барсам болады ма?
Dialogue: 0,0:43:41.70,0:43:43.28,Default,,0,0,0,,Иә... иә
Dialogue: 0,0:43:43.78,0:43:48.58,Default,,0,0,0,,Мен олар кварк бөшкелерін үйде жасайды деп естідім.
Dialogue: 0,0:43:48.66,0:43:49.83,Default,,0,0,0,,Иә
Dialogue: 0,0:43:49.91,0:43:51.42,Default,,0,0,0,,Сонымен қатар ферментаторда
Dialogue: 0,0:43:51.50,0:43:54.42,Default,,0,0,0,,Жапон еменін пайдаланады деп естідім.
Dialogue: 0,0:43:54.50,0:43:56.09,Default,,0,0,0,,Бұл туралы толығырақ...
Dialogue: 0,0:43:56.17,0:43:57.05,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:43:57.55,0:44:01.09,Default,,0,0,0,,Жарайды, мен саған айналаны көрсетемін, сондықтан алдымен қарап ал.
Dialogue: 0,0:44:01.72,0:44:02.89,Default,,0,0,0,,Рахмет
Dialogue: 0,0:44:08.10,0:44:09.10,Default,,0,0,0,,Кверкус емені
Dialogue: 0,0:44:09.18,0:44:12.81,Default,,0,0,0,,Жапон вискиі бөшкелерді қартаю үшін қолданылады.
Dialogue: 0,0:44:12.90,0:44:15.31,Default,,0,0,0,,Біз оны ферменттерімізде де пайдаланамыз.
Dialogue: 0,0:44:16.15,0:44:19.53,Default,,0,0,0,,Ағаш сатып алу үшін Хоккайдодағы шикі ағаш өндіретін аймаққа барудан басталады.
Dialogue: 0,0:44:20.03,0:44:21.82,Default,,0,0,0,,Кем дегенде бір жыл құрғақ кезеңді қоса алғанда
Dialogue: 0,0:44:22.61,0:44:25.37,Default,,0,0,0,,Бөшкелерді жасауға екі жылдан астам уақыт кетеді.
Dialogue: 0,0:44:25.45,0:44:26.83,Default,,0,0,0,,Екі жыл?
Dialogue: 0,0:44:26.91,0:44:27.83,Default,,0,0,0,,Иә
Dialogue: 0,0:44:31.37,0:44:36.13,Default,,0,0,0,,Жарайды, мен сенің сұрағаныңды дайындаймын, енді қайтайық.
Dialogue: 0,0:44:36.21,0:44:38.17,Default,,0,0,0,,Иә, рақмет.
Dialogue: 0,0:44:38.80,0:44:43.30,Default,,0,0,0,,Такахаши мырза, бұдан былай мен сұхбаттан басқа бірдеңе істеуім керек...
Dialogue: 0,0:44:43.97,0:44:45.09,Default,,0,0,0,,Мен сенімен келе аламын ба?
Dialogue: 0,0:44:45.18,0:44:46.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:46.64,0:44:50.18,Default,,0,0,0,,Мен виски туралы аздап біле аламын ба деп ойладым...
Dialogue: 0,0:44:52.06,0:44:53.56,Default,,0,0,0,,Мен қарсы емеспін, бірақ...
Dialogue: 0,0:44:53.64,0:44:56.56,Default,,0,0,0,,Бұл мақалалар сериясына қатысты емес, бірақ бұл дұрыс па?
Dialogue: 0,0:44:57.69,0:44:59.19,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:45:01.53,0:45:03.82,Default,,0,0,0,,Бұл біздің қосылмаған саке болады.
Dialogue: 0,0:45:04.41,0:45:06.87,Default,,0,0,0,,Мейірімділіктеріңізге рахмет.
Dialogue: 0,0:45:07.45,0:45:09.49,Default,,0,0,0,,KOMA-ны қайта құру үшін
Dialogue: 0,0:45:09.58,0:45:12.50,Default,,0,0,0,,Мен сенің түрлі қоспасыз сакемен тәжірибе жасап жатқаныңды естідім.
Dialogue: 0,0:45:12.58,0:45:14.46,Default,,0,0,0,,Мен біразын дайындап қойдым
Dialogue: 0,0:45:15.12,0:45:18.84,Default,,0,0,0,,Мен де KOMA-ның жанкүйерімін, сондықтан көмектесетін болсам қуанар едім.
Dialogue: 0,0:45:20.55,0:45:23.92,Default,,0,0,0,,Бірақ Комада спирт зауыты өңделмеген саке жасауды жалғастыру керек еді...
Dialogue: 0,0:45:24.01,0:45:27.30,Default,,0,0,0,,Әрине, бұл КОМА үшін де...
Dialogue: 0,0:45:27.39,0:45:32.73,Default,,0,0,0,,Өзіміз араластырылмаған саке жасағанымыз KOMA оны қайтадан жасай алады дегенді білдірмейді.
Dialogue: 0,0:45:33.31,0:45:35.27,Default,,0,0,0,,Сондықтан өңделмеген сакенің алуан түрін тапқым келеді.
Dialogue: 0,0:45:36.10,0:45:39.82,Default,,0,0,0,,Қараңыз, мен сізге оның сериалға қатысы жоқ дедім.
Dialogue: 0,0:46:12.85,0:46:14.48,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:46:14.56,0:46:17.23,Default,,0,0,0,,Аа, 14 жыл бұрын жергілікті газетте.
Dialogue: 0,0:46:17.31,0:46:20.73,Default,,0,0,0,,Комада мырзаның атасымен сұхбат бар.
Dialogue: 0,0:46:20.81,0:46:23.53,Default,,0,0,0,,Мазмұны «Жергілікті экономика туралы»
Dialogue: 0,0:46:23.61,0:46:26.86,Default,,0,0,0,,Бұл «Жергілікті кәсіп иесінен сұра» сияқты.
Dialogue: 0,0:46:26.95,0:46:31.62,Default,,0,0,0,,Сол кезде Кокуни Саке сыра қайнату зауытымен өзара аймақтық жылжыту және алмасу үшін
Dialogue: 0,0:46:31.70,0:46:34.37,Default,,0,0,0,,Тіпті араласпаған сакемен алмасу туралы да әңгіме бар.
Dialogue: 0,0:46:34.45,0:46:36.71,Default,,0,0,0,,Мен бұл мақаланы бұрын көргенмін.
Dialogue: 0,0:46:36.79,0:46:38.83,Default,,0,0,0,,Бұлай деді ме?
Dialogue: 0,0:46:38.92,0:46:41.96,Default,,0,0,0,,Дәлірек айтсақ, осы бапқа жауапты адамнан
Dialogue: 0,0:46:42.04,0:46:44.92,Default,,0,0,0,,Ол маған сұхбаттағы жазбаларды көрсетті.
Dialogue: 0,0:46:45.42,0:46:46.88,Default,,0,0,0,,Таңбалар санына байланысты
Dialogue: 0,0:46:46.97,0:46:50.09,Default,,0,0,0,,Өңделмеген саке айырбастау туралы бөлімді орналастыра алмаған сияқтымын.
Dialogue: 0,0:46:50.18,0:46:51.51,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:46:51.60,0:46:54.14,Default,,0,0,0,,Сонымен... Мен Kokuni Sake Brewery компаниясына хабарластым.
Dialogue: 0,0:46:54.22,0:46:56.98,Default,,0,0,0,,Сол кездегі алғашқы саке әлі күнге дейін сақталған сияқты.
Dialogue: 0,0:46:57.48,0:46:59.27,Default,,0,0,0,,Келесі сұхбатқа барғыңыз келе ме?
Dialogue: 0,0:46:59.35,0:47:02.98,Default,,0,0,0,,Шынымен бе? Иә, сөзсіз!
Dialogue: 0,0:47:03.07,0:47:05.40,Default,,0,0,0,,Негізі тағы бір оқиға бар...
Dialogue: 0,0:47:05.48,0:47:05.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:06.07,0:47:08.90,Default,,0,0,0,,Мен келесі мақаламда осындай нәрсе жасағым келеді.
Dialogue: 0,0:47:09.40,0:47:10.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:11.62,0:47:12.74,Default,,0,0,0,,Уау~
Dialogue: 0,0:47:13.74,0:47:15.66,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:47:16.41,0:47:19.37,Default,,0,0,0,,Еңбектеріңіз үшін рахмет. Мен қазір оралдым.
Dialogue: 0,0:47:20.00,0:47:23.38,Default,,0,0,0,,Ясу мырза, мен сізге бұрын жіберген қолжазбаға қалай қарайсыз?
Dialogue: 0,0:47:23.88,0:47:24.75,Default,,0,0,0,,Қазір қараңыз
Dialogue: 0,0:47:24.84,0:47:29.34,Default,,0,0,0,,Мм... Мен ертең таңертең Комада спирт зауытына барамын.
Dialogue: 0,0:47:29.42,0:47:30.88,Default,,0,0,0,,Мен оны бүгін де жүктеп алғым келеді
Dialogue: 0,0:47:30.97,0:47:32.34,Default,,0,0,0,,Біз Мемлекеттік қауіпсіздік басқармасынан келдік.
Dialogue: 0,0:47:32.43,0:47:33.93,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:47:34.01,0:47:36.68,Default,,0,0,0,,Олай болса, тезірек әкеліңіз.
Dialogue: 0,0:47:36.77,0:47:37.89,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:47:37.98,0:47:41.19,Default,,0,0,0,,Комада мырзаның қолжазба тексеруі өте қатал болды.
Dialogue: 0,0:47:41.27,0:47:44.31,Default,,0,0,0,,«Кішіпейіл бол» немесе «Мұнда құрметті сөздерді қолданыңыз»
Dialogue: 0,0:47:44.40,0:47:47.15,Default,,0,0,0,,Тақырып та өте жиі кездеседі...
Dialogue: 0,0:47:47.23,0:47:48.61,Default,,0,0,0,,Мұнда жақсысың ба?
Dialogue: 0,0:47:48.69,0:47:49.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:49.82,0:47:52.11,Default,,0,0,0,,«Жапонияда импортталмаған саке бөтелкеге құйылады»
Dialogue: 0,0:47:52.20,0:47:56.03,Default,,0,0,0,,«Кейбір өндірушілер оны жапон вискиі ретінде сатады»
Dialogue: 0,0:47:56.12,0:47:58.45,Default,,0,0,0,,«Сакурамори Саке сыра қайнату зауыты бұл…»
Dialogue: 0,0:47:59.16,0:48:02.62,Default,,0,0,0,,Мазмұннан кейін нақты өндірушінің атын қоссаңыз
Dialogue: 0,0:48:02.71,0:48:04.00,Default,,0,0,0,,Бұл жаңылыстыру.
Dialogue: 0,0:48:04.08,0:48:06.84,Default,,0,0,0,,Кешіріңіз, мен бұл бөлікті түзетуді ұмытып кетіппін.
Dialogue: 0,0:48:07.34,0:48:08.84,Default,,0,0,0,,Комада мырза да атап көрсетті
Dialogue: 0,0:48:08.92,0:48:10.38,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:48:10.88,0:48:14.85,Default,,0,0,0,,Кейде мақалаларымыз шындыққа қарама-қарсы ойды жеткізеді.
Dialogue: 0,0:48:14.93,0:48:16.14,Default,,0,0,0,,Иә
Dialogue: 0,0:48:16.22,0:48:18.89,Default,,0,0,0,,Менің ойымша, сіз оны бірден жүктеп салғыңыз келеді. Мұны жөндеп, асығыңыз.
Dialogue: 0,0:48:18.97,0:48:20.18,Default,,0,0,0,,Иә
Dialogue: 0,0:48:26.94,0:48:29.11,Default,,0,0,0,,Бұл біздің өңделмеген саке...
Dialogue: 0,0:48:29.19,0:48:33.11,Default,,0,0,0,,Сіз маған хабарласқаннан кейін мен оны қоймадан әкелдім.
Dialogue: 0,0:48:34.57,0:48:36.58,Default,,0,0,0,,Бұл шынымен де қалды.
Dialogue: 0,0:48:37.20,0:48:39.45,Default,,0,0,0,,Сіз көп нәрсені байқап көрген сияқтысыз.
Dialogue: 0,0:48:39.54,0:48:42.33,Default,,0,0,0,,Түпнұсқа сакема жараспаған сияқты.
Dialogue: 0,0:48:42.41,0:48:46.04,Default,,0,0,0,,Амансың ба? Оған қамқорлық жасалса да
Dialogue: 0,0:48:46.13,0:48:50.09,Default,,0,0,0,,Егер мен КОМА-ны қалпына келтіруге көмектесе алсам, үйге қайтуға рұқсат етіңіз.
Dialogue: 0,0:48:50.17,0:48:52.97,Default,,0,0,0,,Менің ойымша, бұл менің алдыңғы ағама да ұнайды.
Dialogue: 0,0:48:53.55,0:48:55.97,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:48:56.05,0:48:58.10,Default,,0,0,0,,Бар-жоғы 3 бөшке бар, бірақ...
Dialogue: 0,0:48:58.18,0:49:00.06,Default,,0,0,0,,Әзірге бұл жеткілікті
Dialogue: 0,0:49:05.60,0:49:07.11,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:49:07.19,0:49:09.36,Default,,0,0,0,,Котаро Бұл жаман болады.
Dialogue: 0,0:49:09.44,0:49:11.11,Default,,0,0,0,,Нашар ма?
Dialogue: 0,0:49:11.19,0:49:13.07,Default,,0,0,0,,Жарайды, мынаны қараңыз.
Dialogue: 0,0:49:18.37,0:49:19.12,Default,,0,0,0,,Бұл...
Dialogue: 0,0:49:19.70,0:49:24.12,Default,,0,0,0,,Мен жүктеп салған сериялық мақалада Сакурамори Саке сыра қайнату зауыты туралы айтылған.
Dialogue: 0,0:49:24.62,0:49:25.62,Default,,0,0,0,,Солай болуы керек...
Dialogue: 0,0:49:25.71,0:49:27.50,Default,,0,0,0,,Мен оны дұрыс түзетсем де.
Dialogue: 0,0:49:34.47,0:49:37.26,Default,,0,0,0,,Түпнұсқа қолжазба жүктелді.
Dialogue: 0,0:49:37.34,0:49:38.55,Default,,0,0,0,,Ах
Dialogue: 0,0:49:40.47,0:49:41.89,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:49:43.02,0:49:43.73,Default,,0,0,0,,Мо... Моши Моши
Dialogue: 0,0:49:43.81,0:49:45.06,Default,,0,0,0,,Не болып жатыр!
Dialogue: 0,0:49:45.14,0:49:48.44,Default,,0,0,0,,Соңғы мақала: Мен сұрағандай түзетілмеді!
Dialogue: 0,0:49:48.52,0:49:49.44,Default,,0,0,0,,Не!? Бұл... бұл қап-қара!
Dialogue: 0,0:49:49.52,0:49:50.73,Default,,0,0,0,,Бірдеңе жасаңыз!
Dialogue: 0,0:49:50.82,0:49:53.03,Default,,0,0,0,,Иә, иә...
Dialogue: 0,0:49:53.11,0:49:54.24,Default,,0,0,0,,- (Ясумото) Маған берші - (Котаро) Ах...
Dialogue: 0,0:49:57.61,0:49:59.83,Default,,0,0,0,,Мен телефонда Ясумотомын.
Dialogue: 0,0:50:01.33,0:50:03.83,Default,,0,0,0,,Иә, мен де мұны түсінемін.
Dialogue: 0,0:50:03.91,0:50:06.33,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз...
Dialogue: 0,0:50:07.17,0:50:07.87,Default,,0,0,0,,Иә
Dialogue: 0,0:50:08.38,0:50:11.84,Default,,0,0,0,,Біз мақаланы жою туралы айттық... Иә.
Dialogue: 0,0:50:21.14,0:50:21.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:22.76,0:50:25.93,Default,,0,0,0,,Мен мақаланы өшіріп, кешірім сұрадым.
Dialogue: 0,0:50:26.60,0:50:28.35,Default,,0,0,0,,Мен ертең Сакурамори Саке сыра қайнату зауытына барамын.
Dialogue: 0,0:50:28.85,0:50:30.52,Default,,0,0,0,,11-де сайтта кездесу
Dialogue: 0,0:50:31.31,0:50:33.48,Default,,0,0,0,,Бәрі үшін кешірім сұраймын.
Dialogue: 0,0:50:33.57,0:50:35.03,Default,,0,0,0,,Ең қиыны ертең.
Dialogue: 0,0:50:35.53,0:50:36.24,Default,,0,0,0,,Иә
Dialogue: 0,0:50:36.74,0:50:38.32,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:50:38.41,0:50:42.03,Default,,0,0,0,,Өңделмеген нұсқаны жүктеп салу тек бастамасы ғана.
Dialogue: 0,0:50:42.12,0:50:43.08,Default,,0,0,0,,Иә...
Dialogue: 0,0:50:44.24,0:50:45.87,Default,,0,0,0,,Бұл былай деді...
Dialogue: 0,0:50:46.62,0:50:50.04,Default,,0,0,0,,Мен бұған дейін де сізге ұқсас нәрсені істедім.
Dialogue: 0,0:50:50.13,0:50:50.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:51.04,0:50:52.63,Default,,0,0,0,,Шамамен 10 жыл бұрын
Dialogue: 0,0:50:53.13,0:50:55.80,Default,,0,0,0,,Шағын жапондық кондитерлік дүкенге тым көп берілгендік
Dialogue: 0,0:50:55.88,0:50:59.55,Default,,0,0,0,,Қате мақала жазып, көп қиындық тудырдым.
Dialogue: 0,0:51:00.18,0:51:02.01,Default,,0,0,0,,Маған дүкен иесі айтты
Dialogue: 0,0:51:02.51,0:51:05.93,Default,,0,0,0,,«Сенің рақымыңа сенгенім үшін менің кінәм болды».
Dialogue: 0,0:51:06.68,0:51:08.44,Default,,0,0,0,,Мен ол кезде қатты күйзелдім.
Dialogue: 0,0:51:11.27,0:51:12.61,Default,,0,0,0,,Орналасқан жері мен сізге айтамын.
Dialogue: 0,0:51:12.69,0:51:15.15,Default,,0,0,0,,Мен атап өткен жапондық тәттілер дүкенінен кәдесый сатып алыңыз.
Dialogue: 0,0:51:15.69,0:51:17.32,Default,,0,0,0,,Түбіртекті дұрыс кесіңіз
Dialogue: 0,0:51:23.24,0:51:26.16,Default,,0,0,0,,...
Dialogue: 0,0:51:26.24,0:51:28.29,Default,,0,0,0,,Бва! Мен дәл тиетіндей едім...
Dialogue: 0,0:51:29.00,0:51:32.08,Default,,0,0,0,,Кешірім сұрау әлдеқашан жарияланған сияқты.
Dialogue: 0,0:51:32.17,0:51:34.42,Default,,0,0,0,,...
Dialogue: 0,0:51:34.50,0:51:36.42,Default,,0,0,0,,Біз терең кешірім сұраймыз.
Dialogue: 0,0:51:36.92,0:51:38.38,Default,,0,0,0,,Бва! Мен дәл тиетіндей едім...
Dialogue: 0,0:51:38.88,0:51:40.51,Default,,0,0,0,,Біздің айтарымыз осы ғана
Dialogue: 0,0:51:41.01,0:51:43.97,Default,,0,0,0,,...
Dialogue: 0,0:51:44.05,0:51:47.06,Default,,0,0,0,,...
Dialogue: 0,0:51:47.14,0:51:49.52,Default,,0,0,0,,Ал, отырыңыз және күтіңіз.
Dialogue: 0,0:52:02.11,0:52:02.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:04.95,0:52:07.54,Default,,0,0,0,,Маған біраз уақыт бере аласыз ба?
Dialogue: 0,0:52:09.87,0:52:12.67,Default,,0,0,0,,News Value жақында басталған сериясы
Dialogue: 0,0:52:12.75,0:52:14.92,Default,,0,0,0,,...
Dialogue: 0,0:52:15.00,0:52:17.50,Default,,0,0,0,,Сондай-ақ, Вакабаның хабарландыруы туралы мақала.
Dialogue: 0,0:52:18.09,0:52:19.59,Default,,0,0,0,,Мен мұны естігеніме өкінемін.
Dialogue: 0,0:52:20.09,0:52:21.76,Default,,0,0,0,,Бұл қатар
Dialogue: 0,0:52:21.84,0:52:24.34,Default,,0,0,0,,Сіз әртүрлі спирт зауыттарымен таныстыңыз.
Dialogue: 0,0:52:24.43,0:52:25.22,Default,,0,0,0,,Иә
Dialogue: 0,0:52:25.30,0:52:27.18,Default,,0,0,0,,...
Dialogue: 0,0:52:27.68,0:52:29.39,Default,,0,0,0,,Мазмұны да тамаша деп ойлаймын.
Dialogue: 0,0:52:29.47,0:52:31.18,Default,,0,0,0,,Рахмет
Dialogue: 0,0:52:31.27,0:52:32.89,Default,,0,0,0,,Менің сізден сұрайын дегенім
Dialogue: 0,0:52:32.98,0:52:37.65,Default,,0,0,0,,Бұл мақалада Комада спирт зауытының президенті Рюсей Комада туралы айтылады.
Dialogue: 0,0:52:38.15,0:52:41.28,Default,,0,0,0,,Мен бұл шынымен президент Комаданың сөзі ме екенін білгім келеді.
Dialogue: 0,0:52:41.36,0:52:42.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:42.36,0:52:46.99,Default,,0,0,0,,Виски туралы көп білетін репортер бар, ол оған көп күш салып жатыр...
Dialogue: 0,0:52:48.37,0:52:51.33,Default,,0,0,0,,Жоқ... Жоқ, бұл дұрыс емес.
Dialogue: 0,0:52:51.41,0:52:55.17,Default,,0,0,0,,Барлық мақалалар президент Комаданың әңгімелерінің жазба нұсқалары болып табылады.
Dialogue: 0,0:52:55.25,0:52:56.79,Default,,0,0,0,,Неліктен мұны істейсіз?
Dialogue: 0,0:52:56.88,0:53:00.21,Default,,0,0,0,,А, жоқ...Оны оқығанда таң қалдым.
Dialogue: 0,0:53:00.92,0:53:03.68,Default,,0,0,0,,Ол компанияның мұрагері болғанына бес жыл ғана болды.
Dialogue: 0,0:53:04.43,0:53:07.35,Default,,0,0,0,,Мен мұндай түсінікке ие болғаныма сене алар емеспін ...
Dialogue: 0,0:53:08.47,0:53:13.14,Default,,0,0,0,,Бұл менің вискиге деген құштарлығымды білдіретін тамаша мақала деп ойлаймын.
Dialogue: 0,0:53:13.64,0:53:15.40,Default,,0,0,0,,Мен болашаққа үмітпен қараймын.
Dialogue: 0,0:53:16.86,0:53:20.94,Default,,0,0,0,,Түсіндім, нағыз ағам осында жұмыс істеді ме?
Dialogue: 0,0:53:21.03,0:53:22.11,Default,,0,0,0,,Иә
Dialogue: 0,0:53:22.65,0:53:23.53,Default,,0,0,0,,Ясу-сан...
Dialogue: 0,0:53:23.61,0:53:25.07,Default,,0,0,0,,Бірінші рет кездестік
Dialogue: 0,0:53:25.16,0:53:28.37,Default,,0,0,0,,Мен Вакабадан сұхбат алғанымда ол жоқ еді.
Dialogue: 0,0:53:29.58,0:53:31.75,Default,,0,0,0,,Мен Комада спирт зауытын сұрадым.
Dialogue: 0,0:53:32.25,0:53:33.00,Default,,0,0,0,,Иә
Dialogue: 0,0:53:35.96,0:53:36.79,Default,,0,0,0,,Иә
Dialogue: 0,0:53:37.29,0:53:40.84,Default,,0,0,0,,Қарсы тарап мені кешірсе жақсы болар еді.
Dialogue: 0,0:53:41.34,0:53:43.26,Default,,0,0,0,,Бұл жолы кешіріңіз.
Dialogue: 0,0:53:43.76,0:53:46.05,Default,,0,0,0,,Мен бастығыммен кейінірек қайта кездесемін.
Dialogue: 0,0:53:46.13,0:53:49.43,Default,,0,0,0,,Жоқ Әрқашан қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:53:49.93,0:53:54.73,Default,,0,0,0,,Сондай-ақ... Мен бүгін Сакурамори Саке сыра зауытында ағаңызды кездестірдім.
Dialogue: 0,0:53:54.81,0:53:55.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:53:56.81,0:54:00.23,Default,,0,0,0,,Ағаң сені уайымдады.
Dialogue: 0,0:54:00.32,0:54:03.23,Default,,0,0,0,,Сондай-ақ, мен серияланған мақалаларды оқуды асыға күтемін.
Dialogue: 0,0:54:05.11,0:54:07.82,Default,,0,0,0,,Менің саған айтқым келгені осы болды.
Dialogue: 0,0:54:09.32,0:54:11.83,Default,,0,0,0,,Осыдан кейін уақытыңыз бар ма?
Dialogue: 0,0:54:15.33,0:54:17.75,Default,,0,0,0,,Мен мұндай жерге бірінші рет келіп тұрмын.
Dialogue: 0,0:54:18.63,0:54:20.54,Default,,0,0,0,,Комада мырза барға жиі келе ме?
Dialogue: 0,0:54:22.50,0:54:25.13,Default,,0,0,0,,Бұл мені ағам баяғыда апарған дүкен.
Dialogue: 0,0:54:25.88,0:54:26.63,Default,,0,0,0,,Кейге?
Dialogue: 0,0:54:27.30,0:54:31.55,Default,,0,0,0,,Мен кішкентай болдым, сондықтан бұл жай ғана атмосфера болды.
Dialogue: 0,0:54:32.06,0:54:34.22,Default,,0,0,0,,Қаншалықты толқығаным есімде.
Dialogue: 0,0:54:36.02,0:54:39.52,Default,,0,0,0,,Бүгін мен сөйлескен Кей-сан сен туралы бірдеңе деді...
Dialogue: 0,0:54:39.60,0:54:40.69,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:54:41.82,0:54:46.70,Default,,0,0,0,,Біздің компания оңай әрі тұрақты емес екені рас.
Dialogue: 0,0:54:47.20,0:54:51.95,Default,,0,0,0,,Егер сіз барлық қызметкерлер туралы ойласаңыз, сатып алуды қабылдаған дұрыс болар еді.
Dialogue: 0,0:54:53.79,0:54:55.33,Default,,0,0,0,,Ал шие гүлінің астында
Dialogue: 0,0:54:56.12,0:54:58.75,Default,,0,0,0,,Мен KOMA-да жұмыс істей аламын.
Dialogue: 0,0:54:59.25,0:55:03.75,Default,,0,0,0,,Оны тіпті Sakuramori Sake Brewery вискиі ретінде қайта жаңғыртуға болады.
Dialogue: 0,0:55:05.67,0:55:06.80,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:55:07.63,0:55:09.88,Default,,0,0,0,,Мен бұл басқа нәрсе сияқты сезінемін.
Dialogue: 0,0:55:11.51,0:55:15.31,Default,,0,0,0,,Мен Комада спирт зауытын қорғағым келгендіктен компанияны қабылдадым.
Dialogue: 0,0:55:15.81,0:55:18.56,Default,,0,0,0,,Бұл мен Комаданы қорғадым деген сөз емес пе...
Dialogue: 0,0:55:20.44,0:55:21.98,Default,,0,0,0,,Және КОМА
Dialogue: 0,0:55:23.44,0:55:25.40,Default,,0,0,0,,Мен үшін KOMA
Dialogue: 0,0:55:26.15,0:55:27.82,Default,,0,0,0,,Бұл отбасылық алкоголь.
Dialogue: 0,0:55:28.57,0:55:30.07,Default,,0,0,0,,- (Котаро) Отбасы... - (Рюу) Иә.
Dialogue: 0,0:55:31.20,0:55:34.70,Default,,0,0,0,,Арақ-шарап зауытында бала кезінен еңбек еткендердің барлығы
Dialogue: 0,0:55:35.20,0:55:37.16,Default,,0,0,0,,Мен сені отбасым деп ойлаймын...
Dialogue: 0,0:55:38.83,0:55:40.62,Default,,0,0,0,,Кей, келдің бе?
Dialogue: 0,0:55:41.12,0:55:43.63,Default,,0,0,0,,Бұл жылдың алғашқы бөшкелері болуы керек.
Dialogue: 0,0:55:43.71,0:55:45.71,Default,,0,0,0,,Ең болмаса жұбаныш кеші болады деп ойладым.
Dialogue: 0,0:55:45.80,0:55:47.59,Default,,0,0,0,,Бұл жаңа қазан ба?
Dialogue: 0,0:55:47.67,0:55:48.30,Default,,0,0,0,,О
Dialogue: 0,0:55:49.38,0:55:53.60,Default,,0,0,0,,Мен оның мәңгілік жалғасқанын қалаймын.
Dialogue: 0,0:55:54.22,0:55:55.51,Default,,0,0,0,,Жалғасы бар
Dialogue: 0,0:55:56.26,0:55:58.31,Default,,0,0,0,,Менің аспирантурамды бітіргеніме бір жыл қалды.
Dialogue: 0,0:55:58.39,0:56:01.44,Default,,0,0,0,,Эй, сен сонша қартайдың ба?
Dialogue: 0,0:56:01.52,0:56:04.81,Default,,0,0,0,,Мен алсам, КОМА да ата-ана мен баладан 3 буын болады.
Dialogue: 0,0:56:05.32,0:56:07.15,Default,,0,0,0,,Ол жылдам жігіт.
Dialogue: 0,0:56:08.19,0:56:12.57,Default,,0,0,0,,Сол кезде мен КОМА отбасылық сусын екенін сездім.
Dialogue: 0,0:56:14.12,0:56:17.99,Default,,0,0,0,,Сол күндерге қайта оралғым келеді.
Dialogue: 0,0:56:57.78,0:56:59.41,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,0:56:59.49,0:57:02.83,Default,,0,0,0,,Еңбегіңіз үшін рахмет. Үйге кеткенім үшін кешіріңіз.
Dialogue: 0,0:57:02.91,0:57:05.96,Default,,0,0,0,,Мен машинаны ертең таңертең алып кетемін, солай ма?
Dialogue: 0,0:57:06.04,0:57:07.21,Default,,0,0,0,,Иә, бұл көмектеседі.
Dialogue: 0,0:57:07.29,0:57:08.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:57:09.75,0:57:11.17,Default,,0,0,0,,Компаниядан?
Dialogue: 0,0:57:12.47,0:57:13.47,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:57:13.55,0:57:15.47,Default,,0,0,0,,Президент! Спирт зауыты...
Dialogue: 0,0:57:15.55,0:57:16.85,Default,,0,0,0,,Ха!
Dialogue: 0,0:57:16.93,0:57:17.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:57:18.05,0:57:19.35,Default,,0,0,0,,(Шыны сынып жатқан дыбыс)
Dialogue: 0,0:57:21.06,0:57:25.73,Default,,0,0,0,,
Dialogue: 0,0:57:39.41,0:57:40.37,Default,,0,0,0,,Президент!
Dialogue: 0,0:57:40.91,0:57:42.25,Default,,0,0,0,,Қалғандары ше?
Dialogue: 0,0:57:42.33,0:57:43.12,Default,,0,0,0,,Бұл мен ғана
Dialogue: 0,0:57:43.79,0:57:46.04,Default,,0,0,0,,Мен жұмыстан жаңа шықтым.
Dialogue: 0,0:57:46.12,0:57:47.58,Default,,0,0,0,,Бұл қауіпті, артқа шегініңіз.
Dialogue: 0,0:57:48.08,0:57:48.63,Default,,0,0,0,,Рюсей!
Dialogue: 0,0:57:48.71,0:57:49.96,Default,,0,0,0,,Артқа қайт!
Dialogue: 0,0:57:51.46,0:57:51.96,Default,,0,0,0,,Сіз!
Dialogue: 0,0:57:52.05,0:57:53.72,Default,,0,0,0,,22-платформадан...
Dialogue: 0,0:57:54.30,0:57:55.09,Default,,0,0,0,,Өрт?
Dialogue: 0,0:57:55.18,0:57:57.51,Default,,0,0,0,,Бұл электр тогының ағуынан болуы мүмкін бе?
Dialogue: 0,0:57:57.59,0:57:59.39,Default,,0,0,0,,Өйткені қойма ғимараты жөндеуден өтпеген.
Dialogue: 0,0:57:59.47,0:58:01.10,Default,,0,0,0,,Сақтау…
Dialogue: 0,0:58:01.18,0:58:01.89,Default,,0,0,0,,Иә
Dialogue: 0,0:58:02.39,0:58:03.39,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:58:03.48,0:58:06.90,Default,,0,0,0,,Мен үшін тапқан ескі сакеңнің бәрі өртеніп кетті.
Dialogue: 0,0:58:06.98,0:58:08.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:58:08.77,0:58:09.52,Default,,0,0,0,,Комада мырза ше?
Dialogue: 0,0:58:10.02,0:58:11.98,Default,,0,0,0,,Жарайды, күйіп қалдым, бірақ...
Dialogue: 0,0:58:12.07,0:58:13.53,Default,,0,0,0,,Әй, эй, күйіп қалды...
Dialogue: 0,0:58:13.61,0:58:16.91,Default,,0,0,0,,Уайымдамаңыз, дәрігер бұл тек жеңіл жарақат деді.
Dialogue: 0,0:58:16.99,0:58:18.16,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:58:18.24,0:58:20.83,Default,,0,0,0,,Ол кенет қоймаға секірмек болды.
Dialogue: 0,0:58:23.62,0:58:25.96,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:58:28.67,0:58:30.00,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:58:30.08,0:58:32.42,Default,,0,0,0,,Бұл асыра айтылған сияқты көрінуі мүмкін, бірақ бәрібір.
Dialogue: 0,0:58:36.05,0:58:36.84,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:58:38.30,0:58:41.01,Default,,0,0,0,,Қалған өңделмеген сакенің біразы өртенді.
Dialogue: 0,0:58:41.85,0:58:45.31,Default,,0,0,0,,Вакаба жоспарланғанның жартысынан азын ғана тұрғыза алды.
Dialogue: 0,0:58:45.81,0:58:49.81,Default,,0,0,0,,Сондай-ақ, мен KOMA-ның қосылмаған сакесін таптым ...
Dialogue: 0,0:58:52.32,0:58:54.15,Default,,0,0,0,,Вакаба жақсы сатылуда
Dialogue: 0,0:58:54.23,0:58:57.65,Default,,0,0,0,,KOMA-ны жандандыру үшін біз нысандарды да жаңартамыз.
Dialogue: 0,0:58:57.74,0:58:59.49,Default,,0,0,0,,Мен келе жатыр деп ойладым.
Dialogue: 0,0:58:59.99,0:59:03.37,Default,,0,0,0,,Бірақ қазір мен компанияны жалғастыра алатынымды білмеймін.
Dialogue: 0,0:59:07.87,0:59:12.67,Default,,0,0,0,,Әкем қайтыс болғанда мен қатты өкіндім.
Dialogue: 0,0:59:13.29,0:59:16.30,Default,,0,0,0,,«Мен ол адамға қолдау көрсете алмадым»
Dialogue: 0,0:59:16.92,0:59:19.47,Default,,0,0,0,,Мен ішімдік туралы көп білмеймін.
Dialogue: 0,0:59:19.55,0:59:23.76,Default,,0,0,0,,Виски жасап жатқанда да пайдасы болмады.
Dialogue: 0,0:59:25.97,0:59:31.02,Default,,0,0,0,,Сіз: «Әкемнің артында қалдырған өңделмеген сакесін ысырап еткім келмейді» дейсіз.
Dialogue: 0,0:59:31.10,0:59:35.02,Default,,0,0,0,,Спирт зауытының еншісін алғысы келетінін айтқанда мен қуандым.
Dialogue: 0,0:59:35.53,0:59:38.61,Default,,0,0,0,,Мен қабылдай алмайтын шешімдерді қабылдағаным үшін.
Dialogue: 0,0:59:39.49,0:59:42.49,Default,,0,0,0,,Мен бір жылдық уәдемен бастадым, бірақ
Dialogue: 0,0:59:42.57,0:59:45.62,Default,,0,0,0,,Мен осы уақытқа дейін жетемін деп ешқашан ойламадым.
Dialogue: 0,0:59:46.83,0:59:48.12,Default,,0,0,0,,Анам…
Dialogue: 0,0:59:49.46,0:59:51.62,Default,,0,0,0,,Сен жақсы жұмыс жасадың
Dialogue: 0,0:59:59.34,1:00:04.18,Default,,0,0,0,,Ағаңыз спирт зауытына жақында келе бастады дедіңіз.
Dialogue: 0,1:00:05.76,1:00:10.23,Default,,0,0,0,,Олар бізді қайтадан сатып алуды ұсынып жатыр.
Dialogue: 0,1:00:14.11,1:00:15.69,Default,,0,0,0,,Сіз не істегіңіз келеді?
Dialogue: 0,1:00:17.69,1:00:19.07,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,1:00:19.57,1:00:21.61,Default,,0,0,0,,Бірақ егер сіз сатып алуды қабылдасаңыз
Dialogue: 0,1:00:21.70,1:00:25.28,Default,,0,0,0,,Мен ескі Комада спирт зауыты жойылып кететін сияқты...
Dialogue: 0,1:00:28.91,1:00:31.87,Default,,0,0,0,,Баяғыда, біз виски жасауды тоқтатқан кезде.
Dialogue: 0,1:00:32.37,1:00:35.13,Default,,0,0,0,,Әкем де солай уайымдады.
Dialogue: 0,1:00:36.42,1:00:38.55,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,1:00:57.52,1:00:58.23,Default,,0,0,0,,Комада мырза!
Dialogue: 0,1:00:58.32,1:00:59.19,Default,,0,0,0,,Ах...
Dialogue: 0,1:00:59.69,1:01:02.11,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:01:03.28,1:01:05.87,Default,,0,0,0,,Такахаши-сан! Неге...
Dialogue: 0,1:01:06.66,1:01:10.70,Default,,0,0,0,,Кавабата мырза маған хабарласып, Комада мырзаның өртеніп кеткенін айтты...
Dialogue: 0,1:01:11.20,1:01:13.62,Default,,0,0,0,,Бұл өте жақсы.
Dialogue: 0,1:01:14.42,1:01:16.00,Default,,0,0,0,,Бұл үшін тез?
Dialogue: 0,1:01:16.08,1:01:21.01,Default,,0,0,0,,Ойланбай секіріп кетсем, соңғы Шинкансенге түсе алмаймын...
Dialogue: 0,1:01:21.63,1:01:23.76,Default,,0,0,0,,Оның үстіне, тым зорлық-зомбылық жасамаңыз.
Dialogue: 0,1:01:23.84,1:01:24.80,Default,,0,0,0,,Иә
Dialogue: 0,1:01:25.34,1:01:26.26,Default,,0,0,0,,Бірақ…
Dialogue: 0,1:01:27.39,1:01:30.26,Default,,0,0,0,,Араласпаған сакеңді сен іздеп таптың
Dialogue: 0,1:01:30.35,1:01:31.81,Default,,0,0,0,,Жоқ
Dialogue: 0,1:01:32.31,1:01:33.52,Default,,0,0,0,,Бірақ тағы да...
Dialogue: 0,1:01:34.02,1:01:36.56,Default,,0,0,0,,Менің арнайы үлгім жоғалды.
Dialogue: 0,1:01:37.06,1:01:39.57,Default,,0,0,0,,Түпнұсқаны қайта шығару үшін уақыт қажет
Dialogue: 0,1:01:40.15,1:01:42.69,Default,,0,0,0,,Барлық қызметкерлерге артық емес...
Dialogue: 0,1:01:43.49,1:01:44.36,Default,,0,0,0,,Комада мырза?
Dialogue: 0,1:01:44.86,1:01:47.87,Default,,0,0,0,,Бүгін таңғы жиында бәріне айтамын.
Dialogue: 0,1:02:08.09,1:02:09.35,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,1:02:09.85,1:02:13.31,Default,,0,0,0,,Кеше түнде қоймада өрт болды.
Dialogue: 0,1:02:13.85,1:02:15.60,Default,,0,0,0,,Себебі электр тогының ағуы сияқты.
Dialogue: 0,1:02:16.10,1:02:20.86,Default,,0,0,0,,Баршаның аман болуын бақыт деп санаймын.
Dialogue: 0,1:02:21.65,1:02:22.15,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:02:22.82,1:02:25.19,Default,,0,0,0,,Қалған өңделмеген саке
Dialogue: 0,1:02:25.28,1:02:29.99,Default,,0,0,0,,KOMA-ны қайта жасауда пайдалы болуы керек түпнұсқа саке де жоғалды.
Dialogue: 0,1:02:30.74,1:02:34.25,Default,,0,0,0,,Сізге үлкен үміт артқаным үшін кешіріңіз.
Dialogue: 0,1:02:35.66,1:02:39.54,Default,,0,0,0,,Мен атам мен әкем сендермен бірге салған КОМА-ны мақтан тұтамын.
Dialogue: 0,1:02:39.63,1:02:41.17,Default,,0,0,0,,Мен оны жандандырғым келеді
Dialogue: 0,1:02:41.25,1:02:44.71,Default,,0,0,0,,Біз күрделі бизнес жағдайында тіпті күрделі салымдар жасадық.
Dialogue: 0,1:02:45.21,1:02:48.18,Default,,0,0,0,,Саған келтірген қиындықтарым үшін кешірім сұраймын.
Dialogue: 0,1:02:48.26,1:02:50.26,Default,,0,0,0,,Мен өте өкінемін.
Dialogue: 0,1:02:51.47,1:02:54.60,Default,,0,0,0,,Бұл жолы КОМА-ның жандануы былай тұрсын.
Dialogue: 0,1:02:54.68,1:02:58.06,Default,,0,0,0,,Wakaba жөнелтілімдерінің саны екі еседен астамға қысқарады деп күтілуде.
Dialogue: 0,1:02:58.85,1:03:02.02,Default,,0,0,0,,Осылай жалғаса берсе, жағдай бұрынғыдан да қиындай түседі.
Dialogue: 0,1:03:02.11,1:03:04.23,Default,,0,0,0,,Мен бәріңді мәжбүрлеймін
Dialogue: 0,1:03:06.32,1:03:08.32,Default,,0,0,0,,Кейбіреулеріңіз білетіндей,
Dialogue: 0,1:03:08.82,1:03:11.37,Default,,0,0,0,,Негізі мен үй алғым келеді.
Dialogue: 0,1:03:11.45,1:03:13.95,Default,,0,0,0,,Бізбен Сакурамори Саке сыра қайнату зауыты хабарласты.
Dialogue: 0,1:03:14.04,1:03:15.79,Default,,0,0,0,,
Dialogue: 0,1:03:15.87,1:03:20.42,Default,,0,0,0,,Менің ойымша, егер біз үлкен компаниямен серіктес болсақ, әлдеқайда тұрақты болар еді.
Dialogue: 0,1:03:22.54,1:03:23.59,Default,,0,0,0,,Сонымен...
Dialogue: 0,1:03:24.67,1:03:27.09,Default,,0,0,0,,Мен осы сатып алу ұсынысына жауап бергім келеді.
Dialogue: 0,1:03:27.17,1:03:28.17,Default,,0,0,0,,Не!
Dialogue: 0,1:03:29.47,1:03:30.55,Default,,0,0,0,,Сатып алу...
Dialogue: 0,1:03:30.64,1:03:31.59,Default,,0,0,0,,Маған ол маңызды емес! Рем ше? Ремге не болды!
Dialogue: 0,1:03:32.72,1:03:35.68,Default,,0,0,0,,КОМА-дан бас тарту керек пе?
Dialogue: 0,1:03:36.93,1:03:39.60,Default,,0,0,0,,Әкең де қиын таңдау жасады.
Dialogue: 0,1:03:39.69,1:03:40.65,Default,,0,0,0,,Тіпті Кей...
Dialogue: 0,1:03:42.86,1:03:45.36,Default,,0,0,0,,Тіпті сен де солай сезінесің...
Dialogue: 0,1:03:48.82,1:03:50.11,Default,,0,0,0,,Барлығы осында
Dialogue: 0,1:03:50.70,1:03:51.99,Default,,0,0,0,,Дәл сіз сияқты
Dialogue: 0,1:03:52.07,1:03:54.74,Default,,0,0,0,,Мен КОМА-ның қайта жандануын армандағандықтан қалдым.
Dialogue: 0,1:03:56.08,1:04:00.37,Default,,0,0,0,,Оның үстіне, егер біз сатып алсақ, біз енді Комада болмаймыз, солай ма?
Dialogue: 0,1:04:00.46,1:04:02.08,Default,,0,0,0,,Комада спирт зауыты ретінде
Dialogue: 0,1:04:02.17,1:04:04.96,Default,,0,0,0,,КОМА-ны тірілтудің мәні бар емес пе?
Dialogue: 0,1:04:05.04,1:04:07.51,Default,,0,0,0,,Мен де КОМА-ның жанданғанын көргім келеді.
Dialogue: 0,1:04:08.13,1:04:11.38,Default,,0,0,0,,Егер сіз жай ғана тұрақтылықты іздесеңіз, сіз баяғыда тастап кетер едіңіз.
Dialogue: 0,1:04:11.47,1:04:12.26,Default,,0,0,0,,Әрине
Dialogue: 0,1:04:12.34,1:04:15.89,Default,,0,0,0,,Енді осы уақытқа дейін келген соң, КОМА ішіп көргім келеді.
Dialogue: 0,1:04:15.97,1:04:16.76,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,1:04:16.85,1:04:17.77,Default,,0,0,0,,Президент
Dialogue: 0,1:04:19.02,1:04:21.44,Default,,0,0,0,,Егер сіз біз туралы ойласаңыз
Dialogue: 0,1:04:21.52,1:04:23.23,Default,,0,0,0,,КОМА қайта жанданғанша
Dialogue: 0,1:04:23.31,1:04:25.90,Default,,0,0,0,,Комада спирт зауыты ретінде жұмыс істеуге рұқсат етіңіз.
Dialogue: 0,1:04:25.98,1:04:28.61,Default,,0,0,0,,Бірақ бұл қанша уақытты алады...
Dialogue: 0,1:04:28.69,1:04:29.65,Default,,0,0,0,,- (Котаро) Мм... - (Рюу) Ах.
Dialogue: 0,1:04:30.36,1:04:31.61,Default,,0,0,0,,Бір сәтке бола аламын ба?
Dialogue: 0,1:04:32.91,1:04:34.32,Default,,0,0,0,,KOMA құру
Dialogue: 0,1:04:34.82,1:04:37.79,Default,,0,0,0,,Сіз қайнатпаған сакенің алуан түрін іздедіңіз ғой, солай емес пе?
Dialogue: 0,1:04:38.29,1:04:40.54,Default,,0,0,0,,Оны кеңірек танытайық.
Dialogue: 0,1:04:41.29,1:04:43.79,Default,,0,0,0,,КОМА-ны жандандыруға күш салынды
Dialogue: 0,1:04:43.88,1:04:47.04,Default,,0,0,0,,Бірақ бұлай жалғаса берсе, алда көп жол бар
Dialogue: 0,1:04:47.67,1:04:50.92,Default,,0,0,0,,Оларға өңделмеген саке іздеп жатқаныңызды айтыңыз.
Dialogue: 0,1:04:51.42,1:04:54.09,Default,,0,0,0,,Сұхбат жылдамдығынан жылдамырақ және тиімдірек
Dialogue: 0,1:04:54.59,1:04:56.72,Default,,0,0,0,,Мен осындай мақалалар жазамын.
Dialogue: 0,1:04:58.26,1:04:59.97,Default,,0,0,0,,Әрі қарай жалғастырайық, Президент.
Dialogue: 0,1:05:00.06,1:05:01.35,Default,,0,0,0,,Маған жалғастыруға рұқсат етіңіз
Dialogue: 0,1:05:01.43,1:05:02.18,Default,,0,0,0,,Президент, жасайық!
Dialogue: 0,1:05:02.27,1:05:03.48,Default,,0,0,0,,КОМА-ны тірілтейік
Dialogue: 0,1:05:04.31,1:05:05.48,Default,,0,0,0,,…қашып кету…
Dialogue: 0,1:05:05.56,1:05:08.73,Default,,0,0,0,,Мен мұндай сатып алу туралы ұсынысты қабылдай алмаймын.
Dialogue: 0,1:05:09.23,1:05:10.07,Default,,0,0,0,,Иә
Dialogue: 0,1:05:21.50,1:05:24.25,Default,,0,0,0,,«Жоғалған фантом виски KOMA»
Dialogue: 0,1:05:24.33,1:05:27.50,Default,,0,0,0,,Сіз өткен күні айтқан ұсынысыңызды жазып үлгердіңіз бе?
Dialogue: 0,1:05:27.59,1:05:30.88,Default,,0,0,0,,Мен КОМАның тезірек оралғанын қалаймын.
Dialogue: 0,1:05:30.96,1:05:32.80,Default,,0,0,0,,Мен саған сенемін
Dialogue: 0,1:05:34.68,1:05:37.01,Default,,0,0,0,,Бүгін тағы бір өтінішім бар...
Dialogue: 0,1:05:37.09,1:05:39.76,Default,,0,0,0,,Әрине мен саған кез келген істе көмектесемін.
Dialogue: 0,1:05:39.85,1:05:40.93,Default,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,1:05:41.43,1:05:43.89,Default,,0,0,0,,Мен сіздің дәмдеуіш жазбаларыңызды көргім келеді.
Dialogue: 0,1:05:43.98,1:05:44.89,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:44.98,1:05:46.98,Default,,0,0,0,,А... жоқ, шындап.
Dialogue: 0,1:05:47.06,1:05:50.23,Default,,0,0,0,,Бұл дәптер Комада мырзаның сезімін білдіреді.
Dialogue: 0,1:05:50.32,1:05:52.74,Default,,0,0,0,,Сіз оны суреттермен және түсініктемелермен білдіресіз, солай ма?
Dialogue: 0,1:05:52.82,1:05:56.28,Default,,0,0,0,,Қандай дәм қандай өрнекпен өрнектеледі?
Dialogue: 0,1:05:56.36,1:05:58.87,Default,,0,0,0,,Мен мақала жазу туралы көбірек білгім келеді.
Dialogue: 0,1:05:59.66,1:06:02.95,Default,,0,0,0,,Мен Комада мырзаның сезімталдығын қолжазбаға түсіргім келеді.
Dialogue: 0,1:06:05.87,1:06:08.00,Default,,0,0,0,,Сіз мұның бәрін оқыдыңыз ба?
Dialogue: 0,1:06:08.75,1:06:09.71,Default,,0,0,0,,Бұл ма?
Dialogue: 0,1:06:09.79,1:06:11.84,Default,,0,0,0,,Дәм беру жазбаларында сызылған кейіпкер
Dialogue: 0,1:06:11.92,1:06:14.22,Default,,0,0,0,,Мен манганы түсінемін, бірақ...
Dialogue: 0,1:06:14.72,1:06:17.05,Default,,0,0,0,,Бұл басты кейіпкер Кэндзи Рюджиге.
Dialogue: 0,1:06:17.13,1:06:21.43,Default,,0,0,0,,Виски жалаңаш жалаңаш тергенге ұқсайды, солай ма?
Dialogue: 0,1:06:22.06,1:06:25.10,Default,,0,0,0,,Біріншіден, екеуінің арасындағы қарым-қатынас мангаға қарағанда жақынырақ.
Dialogue: 0,1:06:25.69,1:06:27.14,Default,,0,0,0,,Кенджи жалаңаш
Dialogue: 0,1:06:27.23,1:06:28.85,Default,,0,0,0,,Бұл... Иә?
Dialogue: 0,1:06:30.31,1:06:31.36,Default,,0,0,0,,Уф...
Dialogue: 0,1:06:34.94,1:06:37.36,Default,,0,0,0,,(қызметкерлер қуанышпен сөйлеседі)
Dialogue: 0,1:06:41.95,1:06:44.70,Default,,0,0,0,,Бұл үлгілердің үлкен саны.
Dialogue: 0,1:06:44.79,1:06:47.12,Default,,0,0,0,,Біз сондай-ақ шетелдегі спирт зауыттарынан заттарды аламыз.
Dialogue: 0,1:06:47.21,1:06:49.75,Default,,0,0,0,,Такахаши-сан мақаласының әсері осындай.
Dialogue: 0,1:06:49.83,1:06:53.92,Default,,0,0,0,,Жоқ... Мен жаңа ғана Комада-санның ерекше өрнекті аудардым.
Dialogue: 0,1:06:54.42,1:06:55.76,Default,,0,0,0,,Керісінше
Dialogue: 0,1:06:55.84,1:06:58.76,Default,,0,0,0,,Мультфильм кейіпкерлерімен талғамды көрсету хит болды деп ойлаймын.
Dialogue: 0,1:06:59.84,1:07:02.01,Default,,0,0,0,,Ах! KOMA-ның өзі де бар.
Dialogue: 0,1:07:02.60,1:07:05.64,Default,,0,0,0,,Көрмегелі біраз болды, Бала кезімнен.
Dialogue: 0,1:07:06.14,1:07:07.64,Default,,0,0,0,,Онда тіпті әріп бар.
Dialogue: 0,1:07:13.15,1:07:16.40,Default,,0,0,0,,«Мен КОМА-ның жандануына шын жүректен үміттенемін».
Dialogue: 0,1:07:16.49,1:07:18.70,Default,,0,0,0,,Сабуромару спирт зауытындағы барлығынан
Dialogue: 0,1:07:19.20,1:07:20.41,Default,,0,0,0,,Рахмет
Dialogue: 0,1:07:20.49,1:07:23.66,Default,,0,0,0,,Ақыр соңында, егер сізде нақты нәрсе болса, араластыруға пайдалы ма?
Dialogue: 0,1:07:24.24,1:07:25.95,Default,,0,0,0,,Жоқтан жақсы.
Dialogue: 0,1:07:26.45,1:07:28.91,Default,,0,0,0,,Оның үстіне өңделмеген сакенің түрі көп болса,
Dialogue: 0,1:07:29.00,1:07:31.25,Default,,0,0,0,,Сіз міндетті түрде пайдалана алатын нәрсені табасыз.
Dialogue: 0,1:07:34.75,1:07:38.67,Default,,0,0,0,,Бұл КОМА-ның өзі және аман қалған бөшкедегі шикі саке.
Dialogue: 0,1:07:38.76,1:07:42.72,Default,,0,0,0,,Бізге жіберілген әрбір спирт зауытынан алынған қоспасыз спирттер
Dialogue: 0,1:07:43.22,1:07:46.64,Default,,0,0,0,,Алдымен, осы вискидің барлық дәмінен бастайық.
Dialogue: 0,1:07:47.43,1:07:48.89,Default,,0,0,0,,Белгілі бір дәрежеде тарылтқаннан кейін
Dialogue: 0,1:07:48.98,1:07:51.40,Default,,0,0,0,,Оны төл сакемізбен араластырайық.
Dialogue: 0,1:08:16.09,1:08:18.80,Default,,0,0,0,,КОМА-ның жаңғыруы Жақсы емес
Dialogue: 0,1:08:18.88,1:08:20.30,Default,,0,0,0,,Неге...
Dialogue: 0,1:08:21.01,1:08:23.80,Default,,0,0,0,,Мен мақаланы оқып отырып, солай деп ойладым.
Dialogue: 0,1:08:23.89,1:08:25.81,Default,,0,0,0,,Мұндай жағымсыз нәрселер
Dialogue: 0,1:08:25.89,1:08:28.93,Default,,0,0,0,,Мен оны өтіп кетпеу үшін сақ болуға тырыстым, бірақ...
Dialogue: 0,1:08:29.43,1:08:32.27,Default,,0,0,0,,Түсіндім... Әлі де керек пе?
Dialogue: 0,1:08:32.77,1:08:34.36,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,1:08:34.44,1:08:36.15,Default,,0,0,0,,(Смартфон қоңырау үні)
Dialogue: 0,1:08:36.23,1:08:37.32,Default,,0,0,0,,Бір сәт кешіріңіз.
Dialogue: 0,1:08:37.40,1:08:38.82,Default,,0,0,0,,Ах...
Dialogue: 0,1:08:39.61,1:08:40.53,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,1:08:46.03,1:08:47.03,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:08:49.54,1:08:51.41,Default,,0,0,0,,Мақаланы оқыңыз
Dialogue: 0,1:08:51.50,1:08:54.42,Default,,0,0,0,,Менің ойымша, жаңғыру қиын болады.
Dialogue: 0,1:08:54.92,1:08:56.71,Default,,0,0,0,,Сіз әлі де қызықсыз ба?
Dialogue: 0,1:08:57.21,1:08:57.84,Default,,0,0,0,,KOMA туралы
Dialogue: 0,1:08:58.55,1:08:59.46,Default,,0,0,0,,О
Dialogue: 0,1:09:00.13,1:09:03.43,Default,,0,0,0,,Мен үшін КОМА – отбасылық сусын.
Dialogue: 0,1:09:04.51,1:09:06.72,Default,,0,0,0,,Рюсей де осыны айтты.
Dialogue: 0,1:09:07.89,1:09:09.93,Default,,0,0,0,,Сізден бір нәрсе сұрасам болады ма?
Dialogue: 0,1:09:10.52,1:09:12.10,Default,,0,0,0,,Неліктен Корпоративтік жоспарлау бөлімі?
Dialogue: 0,1:09:13.14,1:09:13.85,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:09:14.56,1:09:16.31,Default,,0,0,0,,Тоқайрин мырзаның сөзін тыңдады
Dialogue: 0,1:09:16.81,1:09:20.36,Default,,0,0,0,,КОМА-ны салу мүмкін болмаған соң, Кей үйден қашып кетті.
Dialogue: 0,1:09:21.40,1:09:24.91,Default,,0,0,0,,Ол кезде виски қысқы дәуірде болатын.
Dialogue: 0,1:09:25.66,1:09:27.58,Default,,0,0,0,,Мен өндіргім келді
Dialogue: 0,1:09:27.66,1:09:29.95,Default,,0,0,0,,«Егер бұл сату жұмысы болса, мен оны бірден жасаймын» деді.
Dialogue: 0,1:09:30.95,1:09:33.04,Default,,0,0,0,,Менің қалаған нәрсем болмаса да...
Dialogue: 0,1:09:34.04,1:09:37.29,Default,,0,0,0,,Қазірдің өзінде менің виски жасауға деген құлшынысым сол қалпында.
Dialogue: 0,1:09:37.38,1:09:39.59,Default,,0,0,0,,Мен басқа ештеңе істеп жатқан жоқпын деп ойлаймын.
Dialogue: 0,1:09:40.63,1:09:43.09,Default,,0,0,0,,Мен болғым келетін нәрсені көре алсам ғой
Dialogue: 0,1:09:43.17,1:09:45.38,Default,,0,0,0,,Қай жерден бастасаңыз да, сонда жетесіз
Dialogue: 0,1:09:47.80,1:09:49.31,Default,,0,0,0,,Менен бір нәрсе сұраңыз.
Dialogue: 0,1:09:49.39,1:09:49.89,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:52.64,1:09:53.48,Default,,0,0,0,,Ах...
Dialogue: 0,1:10:02.69,1:10:05.65,Default,,0,0,0,,Олардың барлығы КОМА-дан алыс па?
Dialogue: 0,1:10:05.74,1:10:07.20,Default,,0,0,0,,Бірінші шаршыға оралу.
Dialogue: 0,1:10:07.28,1:10:11.29,Default,,0,0,0,,Өйткені ізашар KOMA-ны мұрагерге бермей тұрып, одан бас тартты.
Dialogue: 0,1:10:11.79,1:10:14.62,Default,,0,0,0,,Менің дәм есте сақтау қабілетіме сүйенуден басқа амалым жоқ...
Dialogue: 0,1:10:16.42,1:10:17.29,Default,,0,0,0,,Ум...
Dialogue: 0,1:10:18.08,1:10:20.84,Default,,0,0,0,,Онии-сан... Кей-саннан да сұрасақ қалай болады?
Dialogue: 0,1:10:20.92,1:10:22.05,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:22.13,1:10:24.76,Default,,0,0,0,,Кей-сан да осында өсті, солай ма?
Dialogue: 0,1:10:24.84,1:10:26.05,Default,,0,0,0,,Бұл сізге көмектесуі керек.
Dialogue: 0,1:10:26.97,1:10:29.39,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,1:10:30.30,1:10:32.39,Default,,0,0,0,,КОМА – отбасылық сусын, солай ма?
Dialogue: 0,1:10:36.10,1:10:39.48,Default,,0,0,0,,Жоқ, біз КОМА-ны өз қолымызбен салуымыз керек.
Dialogue: 0,1:10:47.32,1:10:48.41,Default,,0,0,0,,Бұл сізге
Dialogue: 0,1:10:49.49,1:10:51.28,Default,,0,0,0,,Бұл сенің әкеңнің дәптері.
Dialogue: 0,1:10:51.37,1:10:53.54,Default,,0,0,0,,А... не айтып тұрсың?
Dialogue: 0,1:10:54.12,1:10:57.04,Default,,0,0,0,,Кей-сан оны саған беруімді өтінді.
Dialogue: 0,1:10:57.12,1:10:57.87,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:58.37,1:11:01.84,Default,,0,0,0,,«Мен бұл KOMA-ны жандандыруға кеңес болатынына сенімдімін».
Dialogue: 0,1:11:04.88,1:11:08.88,Default,,0,0,0,,Алдыңғы ұрпақ КОМА-ның болашағын дұрыс байланыстырды.
Dialogue: 0,1:11:23.36,1:11:24.23,Default,,0,0,0,,Ха!
Dialogue: 0,1:11:45.88,1:11:47.88,Default,,0,0,0,,Алдын ала кешіріңіз.
Dialogue: 0,1:11:47.97,1:11:49.26,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,1:12:04.11,1:12:07.07,Default,,0,0,0,,Маған телефон соғады деп ойламаппын.
Dialogue: 0,1:12:10.65,1:12:12.07,Default,,0,0,0,,Бұл ескерту…
Dialogue: 0,1:12:12.66,1:12:15.12,Default,,0,0,0,,Мен Сакурамори Саке сыра зауытында жұмыс істеймін
Dialogue: 0,1:12:15.20,1:12:16.66,Default,,0,0,0,,Бұл туралы бір жерден естіген сияқтымын.
Dialogue: 0,1:12:17.16,1:12:21.25,Default,,0,0,0,,Осыдан бес жыл бұрын әкем маған жұмыста осы дәптерді жіберген.
Dialogue: 0,1:12:21.33,1:12:22.50,Default,,0,0,0,,Бес жыл бұрын...
Dialogue: 0,1:12:23.00,1:12:25.46,Default,,0,0,0,,Бір аптадан аз уақыт өткен соң
Dialogue: 0,1:12:25.54,1:12:27.17,Default,,0,0,0,,Әкесі қайтыс болды
Dialogue: 0,1:12:27.88,1:12:30.59,Default,,0,0,0,,Мен жерлеу аяқталған соң ғана білдім.
Dialogue: 0,1:12:30.67,1:12:32.01,Default,,0,0,0,,(Ватару) Ой, расымен бе? Мен ойлағаннан кіші екен.
Dialogue: 0,1:12:32.51,1:12:35.89,Default,,0,0,0,,Менің ойымша, ол көп өмір сүрмейтінін түсінді.
Dialogue: 0,1:12:37.72,1:12:42.35,Default,,0,0,0,,Менің әкем үшін вискиден бас тарту қаншалықты қиын болды?
Dialogue: 0,1:12:42.85,1:12:45.11,Default,,0,0,0,,Мен ол жазбаны оқып, түсіндім.
Dialogue: 0,1:12:46.15,1:12:49.90,Default,,0,0,0,,Мен сатып алуға барлық қызметкерлер қарсы болғанын естідім.
Dialogue: 0,1:12:50.40,1:12:54.99,Default,,0,0,0,,Ең болмағанда, мен спирт зауытының әкем ойлағандай жалғасқанын қаладым.
Dialogue: 0,1:12:55.49,1:12:57.49,Default,,0,0,0,,Ойланып қарасаңыз, анық.
Dialogue: 0,1:13:00.08,1:13:03.37,Default,,0,0,0,,Сакураморидің Комаданы алу жоспары аяқталды.
Dialogue: 0,1:13:03.87,1:13:05.88,Default,,0,0,0,,Мен де бастығыма хабарладым.
Dialogue: 0,1:13:07.59,1:13:11.38,Default,,0,0,0,,Мен сол тілшіден сіздің KOMA-ға деген сезімдеріңізді естідім.
Dialogue: 0,1:13:13.59,1:13:17.39,Default,,0,0,0,,Сіз де КОМА-ны отбасыңыздың сусыны деп ойладыңыз.
Dialogue: 0,1:13:18.72,1:13:19.85,Default,,0,0,0,,Ескертпелерді оқу—
Dialogue: 0,1:13:20.35,1:13:24.10,Default,,0,0,0,,Енді мен не нәрсеге тоқталғанымды білемін.
Dialogue: 0,1:13:25.31,1:13:27.36,Default,,0,0,0,,Әкем сонда болған кездегі спирт зауыты
Dialogue: 0,1:13:27.86,1:13:30.48,Default,,0,0,0,,Біз бір отбасы болған кездегі спирт зауыты
Dialogue: 0,1:13:30.57,1:13:33.70,Default,,0,0,0,,Бұл мен үшін ең маңызды естелік.
Dialogue: 0,1:13:35.16,1:13:37.91,Default,,0,0,0,,Сол күндерге қайта оралғым келеді.
Dialogue: 0,1:13:38.41,1:13:40.29,Default,,0,0,0,,Сондықтан мен КОМА салғым келеді
Dialogue: 0,1:13:40.87,1:13:44.54,Default,,0,0,0,,Сондықтан да менімен бірге КОМА құрылысына қатысуыңызды қалаймын.
Dialogue: 0,1:13:44.62,1:13:45.67,Default,,0,0,0,,Ха…
Dialogue: 0,1:13:46.88,1:13:49.04,Default,,0,0,0,,А, мен де сенен сұрайын.
Dialogue: 0,1:13:49.55,1:13:50.88,Default,,0,0,0,,Маған КОМА салуға рұқсат етіңіз
Dialogue: 0,1:13:51.38,1:13:52.30,Default,,0,0,0,,Иә
Dialogue: 0,1:13:52.84,1:13:55.05,Default,,0,0,0,,Оның алдында мен сені кездестіргім келетін адам бар.
Dialogue: 0,1:13:57.01,1:13:58.68,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,1:14:00.93,1:14:02.18,Default,,0,0,0,,Қош келдіңіз...
Dialogue: 0,1:14:03.06,1:14:03.93,Default,,0,0,0,,Кей…
Dialogue: 0,1:14:04.85,1:14:06.94,Default,,0,0,0,,Біраз уақыт болды, мама.
Dialogue: 0,1:14:11.53,1:14:13.53,Default,,0,0,0,,Осы уақытқа дейін кешірім сұраймын.
Dialogue: 0,1:14:15.07,1:14:19.03,Default,,0,0,0,,Әкеңнің саған мұндайды сыйлағанына сене алар емеспін.
Dialogue: 0,1:14:19.12,1:14:20.45,Default,,0,0,0,,Мен білмедім
Dialogue: 0,1:14:21.87,1:14:25.83,Default,,0,0,0,,Сіз кеткеннен кейін компанияның жағдайы нашарлады.
Dialogue: 0,1:14:25.91,1:14:29.00,Default,,0,0,0,,Демалыс күнін алған барлық қызметкерлердің орнына.
Dialogue: 0,1:14:29.08,1:14:30.84,Default,,0,0,0,,Жалақыңызды азайтыңыз
Dialogue: 0,1:14:31.34,1:14:36.22,Default,,0,0,0,,Бірдеңе істеуге тырысқан әкем өзін тым қатты итермелей бастады...
Dialogue: 0,1:14:37.89,1:14:41.93,Default,,0,0,0,,Мен сені іздедім, оралуыңды қаладым.
Dialogue: 0,1:14:43.47,1:14:47.19,Default,,0,0,0,,Бірақ әкем: «Мені қалдыр» деді...
Dialogue: 0,1:14:47.69,1:14:51.98,Default,,0,0,0,,Сондықтан ол сені жек көреді деп ойладым.
Dialogue: 0,1:14:52.73,1:14:55.53,Default,,0,0,0,,Мен өлгенде солай болдым...
Dialogue: 0,1:14:57.32,1:15:01.91,Default,,0,0,0,,Бірақ әкең сенің қайтып келгеніңді қаламады.
Dialogue: 0,1:15:02.41,1:15:05.75,Default,,0,0,0,,Өйткені мен сенің өз жолыңмен жүруіңді қаладым.
Dialogue: 0,1:15:06.50,1:15:07.58,Default,,0,0,0,,Ха…
Dialogue: 0,1:15:08.08,1:15:12.00,Default,,0,0,0,,Егер сіздің КОМА-ны қайта тірілтуді қаласаңыз
Dialogue: 0,1:15:12.09,1:15:14.42,Default,,0,0,0,,Менің айтарым жоқ.
Dialogue: 0,1:15:14.92,1:15:16.51,Default,,0,0,0,,Оны екі адаммен бірге көріңіз.
Dialogue: 0,1:15:29.39,1:15:31.44,Default,,0,0,0,,Не болды? Сондай заманнан келе жатыр
Dialogue: 0,1:15:31.52,1:15:33.57,Default,,0,0,0,,Аа, еңбегіңіз үшін рахмет.
Dialogue: 0,1:15:34.07,1:15:37.28,Default,,0,0,0,,Бүгіннен бастап Кей-сан келіп КОМА-ны бірге салады, солай ма?
Dialogue: 0,1:15:38.11,1:15:42.57,Default,,0,0,0,,Қоспаның соңғы өндіру әдісі туралы шектеулі адамдар ғана біледі.
Dialogue: 0,1:15:43.08,1:15:45.70,Default,,0,0,0,,Алдыңғы буын хабарламаны сол күйінде қалдырған.
Dialogue: 0,1:15:46.20,1:15:50.42,Default,,0,0,0,,Біз қоспаның аяқталуын күтіп, өндіріске дайындаймыз.
Dialogue: 0,1:15:51.12,1:15:52.25,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,1:15:53.25,1:15:55.92,Default,,0,0,0,,Мен жол бойы ішуге келдім.
Dialogue: 0,1:15:56.00,1:15:57.71,Default,,0,0,0,,Не? Тоқайринмен және басқалармен?
Dialogue: 0,1:15:57.80,1:15:59.55,Default,,0,0,0,,Біз тіл табыса аламыз ба?
Dialogue: 0,1:15:59.63,1:16:01.93,Default,,0,0,0,,А, жоқ, олай емес...
Dialogue: 0,1:16:02.01,1:16:03.18,Default,,0,0,0,,Барамыз ба?
Dialogue: 0,1:16:10.44,1:16:11.60,Default,,0,0,0,,Бұл үлкен мәселе
Dialogue: 0,1:16:12.10,1:16:14.82,Default,,0,0,0,,Мен тек есте сақтау қабілетіме сүйену арқылы осы уақытқа дейін жеткеніме сене алар емеспін.
Dialogue: 0,1:16:14.90,1:16:16.28,Default,,0,0,0,,Бірақ бұл басқаша.
Dialogue: 0,1:16:16.78,1:16:21.32,Default,,0,0,0,,Қалғанын әкемнің алдыңғысынан мұраға қалдырған құжаттары мен күнделікті есептері арқылы реттеуге болады.
Dialogue: 0,1:16:21.41,1:16:22.16,Default,,0,0,0,,Иә
Dialogue: 0,1:16:23.24,1:16:27.45,Default,,0,0,0,,Анам КОМА салғанымызға қуанып қалды.
Dialogue: 0,1:16:28.04,1:16:29.83,Default,,0,0,0,,Әйтеуір жалғызсырап көрінді.
Dialogue: 0,1:16:30.41,1:16:32.21,Default,,0,0,0,,Менің ішімдік ішуім жақсы емес
Dialogue: 0,1:16:32.29,1:16:35.13,Default,,0,0,0,,Себебі әкемді аядым.
Dialogue: 0,1:16:36.63,1:16:38.59,Default,,0,0,0,,КОМА дәмді көрінді.
Dialogue: 0,1:16:39.21,1:16:39.88,Default,,0,0,0,,Иә
Dialogue: 0,1:16:45.05,1:16:46.22,Default,,0,0,0,,Котаро! мұнда
Dialogue: 0,1:16:46.97,1:16:47.56,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,1:16:51.18,1:16:52.35,Default,,0,0,0,,KOMA деп аталатын виски
Dialogue: 0,1:16:52.44,1:16:54.31,Default,,0,0,0,,Мен оны жандандыруға тырысамын ...
Dialogue: 0,1:16:54.81,1:16:55.86,Default,,0,0,0,,Ах, дұрыс
Dialogue: 0,1:16:55.94,1:16:59.32,Default,,0,0,0,,Арақ-шарап зауытына қызмет көрсететін Тоқайрин деген адам бар.
Dialogue: 0,1:16:59.40,1:17:02.20,Default,,0,0,0,,Ол тыныш және қорқынышты болды, бірақ ол маған көп нәрсені үйретті.
Dialogue: 0,1:17:02.28,1:17:03.07,Default,,0,0,0,,Кей-сан да...
Dialogue: 0,1:17:03.16,1:17:06.66,Default,,0,0,0,,Ах, Кей-сан Рю-санның ағасы.
Dialogue: 0,1:17:06.74,1:17:10.70,Default,,0,0,0,,Екеуміз алғаш танысқанда, мен оны бұрынғы жігітім деп ойладым, онымен қайта қосылғым келеді.
Dialogue: 0,1:17:10.79,1:17:12.58,Default,,0,0,0,,Әй, көңілді көрінеді.
Dialogue: 0,1:17:12.66,1:17:15.67,Default,,0,0,0,,А... Көрдім, мен ғана сөйлеп тұрмын...
Dialogue: 0,1:17:15.75,1:17:16.92,Default,,0,0,0,,Жоқ, бұл туралы алаңдамаңыз.
Dialogue: 0,1:17:17.42,1:17:19.46,Default,,0,0,0,,Сонда... сол КОМА қайта жанданды ма?
Dialogue: 0,1:17:19.55,1:17:22.05,Default,,0,0,0,,Бұл өте қиын.
Dialogue: 0,1:17:22.13,1:17:24.64,Default,,0,0,0,,Бұл өңделмеген саке араластыру ғана емес...
Dialogue: 0,1:17:33.94,1:17:34.85,Default,,0,0,0,,Не болды?
Dialogue: 0,1:17:35.40,1:17:38.77,Default,,0,0,0,,Кей-сан, Сакурамори Саке сыра қайнату зауытына ештеңе айтпа.
Dialogue: 0,1:17:38.86,1:17:41.23,Default,,0,0,0,,Жұмысқа жұмыстан тыс уақытта келеді деп естідім.
Dialogue: 0,1:17:41.74,1:17:44.20,Default,,0,0,0,,Әкемнен қалған КОМА
Dialogue: 0,1:17:44.28,1:17:45.99,Default,,0,0,0,,Өйткені мен мұны қаладым
Dialogue: 0,1:17:57.17,1:17:59.42,Default,,0,0,0,,Бұл нұсқаулыққа сәйкес рецепт.
Dialogue: 0,1:18:10.35,1:18:11.31,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,1:18:11.39,1:18:12.52,Default,,0,0,0,,Хмм.
Dialogue: 0,1:18:13.77,1:18:15.94,Default,,0,0,0,,Маған бірдеңе жетіспейтін сияқты.
Dialogue: 0,1:18:16.77,1:18:17.52,Default,,0,0,0,,Дұрыс...
Dialogue: 0,1:18:18.65,1:18:20.36,Default,,0,0,0,,Айырмашылығы неде?
Dialogue: 0,1:18:21.23,1:18:23.69,Default,,0,0,0,,Жазбаларыма қатысты мені бір нәрсе мазалайды.
Dialogue: 0,1:18:24.19,1:18:24.86,Default,,0,0,0,,Иә?
Dialogue: 0,1:18:25.40,1:18:30.20,Default,,0,0,0,,Жасы мен араласуы бойынша бірдеңе жазылған...
Dialogue: 0,1:18:30.99,1:18:32.87,Default,,0,0,0,,«Бла-кег»?
Dialogue: 0,1:18:33.37,1:18:34.96,Default,,0,0,0,,Өндіріске қатысты?
Dialogue: 0,1:18:35.54,1:18:38.33,Default,,0,0,0,,Күнделікті есепті де оқимын.
Dialogue: 0,1:18:38.42,1:18:39.46,Default,,0,0,0,,Мен түсінбедім
Dialogue: 0,1:18:39.96,1:18:43.51,Default,,0,0,0,,Менің анам әкемнің жазуын оқи алады ма деп ойлаймын.
Dialogue: 0,1:18:43.59,1:18:47.59,Default,,0,0,0,,Аяқталмаған бірдеңе қалса, ол...
Dialogue: 0,1:18:52.81,1:18:56.44,Default,,0,0,0,,Екеуің де аузыңа ештеңе салған жоқсыңдар ма?
Dialogue: 0,1:18:56.94,1:18:59.02,Default,,0,0,0,,Кей, кешкі ас іш.
Dialogue: 0,1:18:59.52,1:19:01.31,Default,,0,0,0,,Олай болса, сөзіңді қабыл ал.
Dialogue: 0,1:19:01.40,1:19:03.40,Default,,0,0,0,,Анашым, қарсы боласыз ба?
Dialogue: 0,1:19:03.48,1:19:04.23,Default,,0,0,0,,Не?
Dialogue: 0,1:19:04.32,1:19:06.45,Default,,0,0,0,,Бұл әкемнің қолжазбасы...
Dialogue: 0,1:19:07.70,1:19:08.32,Default,,0,0,0,,осында
Dialogue: 0,1:19:10.37,1:19:11.07,Default,,0,0,0,,“”
Dialogue: 0,1:19:11.70,1:19:12.83,Default,,0,0,0,,Жібек?
Dialogue: 0,1:19:12.91,1:19:16.08,Default,,0,0,0,,Каору... түсіндім.
Dialogue: 0,1:19:16.16,1:19:20.25,Default,,0,0,0,,Бұрын әкем жазған көп іс-қағаздармен айналысатынмын.
Dialogue: 0,1:19:20.75,1:19:22.84,Default,,0,0,0,,Бірақ неге...
Dialogue: 0,1:19:23.34,1:19:25.76,Default,,0,0,0,,Ха! рахмет анашым
Dialogue: 0,1:19:26.26,1:19:27.42,Default,,0,0,0,,Бауырым, менімен бірге жүр.
Dialogue: 0,1:19:28.05,1:19:29.84,Default,,0,0,0,,- (Кей) Не болды? -(Мио) Тамақ ше?
Dialogue: 0,1:19:29.93,1:19:30.89,Default,,0,0,0,,Мен бірден қайтамын!
Dialogue: 0,1:19:56.04,1:19:57.29,Default,,0,0,0,,Міне
Dialogue: 0,1:19:58.29,1:20:00.21,Default,,0,0,0,,Шочу ескірген бөшке
Dialogue: 0,1:20:00.29,1:20:01.58,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:20:02.08,1:20:06.09,Default,,0,0,0,,Біздің шочу касу 3 айға жуық бөшкелерде сақталды...
Dialogue: 0,1:20:06.17,1:20:07.84,Default,,0,0,0,,Бөшкенің аяқталуы…
Dialogue: 0,1:20:07.92,1:20:08.76,Default,,0,0,0,,Ха!
Dialogue: 0,1:20:10.55,1:20:13.30,Default,,0,0,0,,Түпнұсқаны араластырғаннан кейін КОМА
Dialogue: 0,1:20:13.80,1:20:16.31,Default,,0,0,0,,Аяқтау үшін жібек бөшке қолдандым.
Dialogue: 0,1:20:17.39,1:20:20.31,Default,,0,0,0,,Үстін айналдыру үшін жібек керек.
Dialogue: 0,1:20:20.89,1:20:23.10,Default,,0,0,0,,Бастауыш осы ма деп ойлаймын.
Dialogue: 0,1:20:25.36,1:20:26.82,Default,,0,0,0,,Мен сенімдімін.
Dialogue: 0,1:20:52.13,1:20:53.05,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:20:56.97,1:20:58.97,Default,,0,0,0,,Бұл бөлме өзгермейді.
Dialogue: 0,1:20:59.64,1:21:01.85,Default,,0,0,0,,Мен сенің келуің үшін барын салдым...
Dialogue: 0,1:21:02.35,1:21:03.98,Default,,0,0,0,,Еңбегіңіз үшін рахмет, Томо-чан.
Dialogue: 0,1:21:04.06,1:21:06.02,Default,,0,0,0,,Жұмысқа келгеніңізге біраз болды ма?
Dialogue: 0,1:21:06.11,1:21:11.15,Default,,0,0,0,,Иә, мен бұл күндері үйде бухгалтерлік есеппен айналысамын.
Dialogue: 0,1:21:11.78,1:21:12.86,Default,,0,0,0,,Сәлем анашым
Dialogue: 0,1:21:13.36,1:21:16.53,Default,,0,0,0,,Анаңның әсерін естігім келгендіктен бүгін саған телефон соқтым.
Dialogue: 0,1:21:17.49,1:21:19.12,Default,,0,0,0,,Мен сенің мұны істеп көргім келеді.
Dialogue: 0,1:21:19.62,1:21:23.54,Default,,0,0,0,,Ішімдік туралы көп білмесем де.
Dialogue: 0,1:21:24.12,1:21:25.58,Default,,0,0,0,,Өтінемін, анашым.
Dialogue: 0,1:21:26.08,1:21:26.79,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,1:21:27.92,1:21:29.34,Default,,0,0,0,,Үлкен рөл.
Dialogue: 0,1:21:29.84,1:21:31.97,Default,,0,0,0,,Бірақ екі адам жасаған алкоголь
Dialogue: 0,1:21:32.92,1:21:34.38,Default,,0,0,0,,Өйткені бұл үлкен мәселе...
Dialogue: 0,1:21:35.09,1:21:36.39,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,1:21:42.02,1:21:42.85,Default,,0,0,0,,Фу…
Dialogue: 0,1:21:51.40,1:21:52.65,Default,,0,0,0,,Жақсы жұмыс
Dialogue: 0,1:21:58.91,1:22:02.25,Default,,0,0,0,,Мама, КОМА дайын.
Dialogue: 0,1:22:07.00,1:22:11.55,Default,,0,0,0,,«Әр кезде анамның айтқан сөзіне жасырын қараймын».
Dialogue: 0,1:22:12.05,1:22:16.59,Default,,0,0,0,,«Осы күлімсіреу арқылы сенің биылғы жылы да жақсы болғаныңа сенімдімін».
Dialogue: 0,1:22:18.85,1:22:20.60,Default,,0,0,0,,Айттым ғой, мен тек жұмысымды істеп жүрмін...
Dialogue: 0,1:22:21.10,1:22:24.39,Default,,0,0,0,,Егер солай болса, бұл сөзсіз
Dialogue: 0,1:22:24.48,1:22:27.77,Default,,0,0,0,,Отбасылық КОМА сусыны
Dialogue: 0,1:22:29.36,1:22:30.02,Default,,0,0,0,,Иә
Dialogue: 0,1:22:30.52,1:22:31.19,Default,,0,0,0,,Аяқталды
Dialogue: 0,1:22:34.15,1:22:35.03,Default,,0,0,0,,Хехе
Dialogue: 0,1:23:05.39,1:23:09.23,Default,,0,0,0,,Барлығы KOMA-ның қайтып оралғанына өте қуанышты сияқты.
Dialogue: 0,1:23:10.81,1:23:14.57,Default,,0,0,0,,Тағы да KOMA осы спирт зауытындағы адамдарға арналған.
Dialogue: 0,1:23:15.07,1:23:18.24,Default,,0,0,0,,Мен оны шынымен таптырмас деп ойладым.
Dialogue: 0,1:23:19.11,1:23:24.33,Default,,0,0,0,,Бұл шектеулі басылым – 10 жылдан кейінгі уәде.
Dialogue: 0,1:23:24.83,1:23:27.33,Default,,0,0,0,,Осы жаңа ыдыстан туылған
Dialogue: 0,1:23:27.41,1:23:28.42,Default,,0,0,0,,Жаңа кастрюль
Dialogue: 0,1:23:28.92,1:23:32.38,Default,,0,0,0,,Ұзақ қартаюдан кейін KOMA-ның түпнұсқасы болғанша.
Dialogue: 0,1:23:32.88,1:23:35.21,Default,,0,0,0,,Мен мақалалар жазуды жалғастырамын.
Dialogue: 0,1:23:35.71,1:23:37.88,Default,,0,0,0,,Күтіп жүргендер үшін
Dialogue: 0,1:23:38.55,1:23:40.84,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,1:23:41.72,1:23:44.22,Default,,0,0,0,,Атам мен әкемнің кезіндегідей.
Dialogue: 0,1:23:44.72,1:23:47.02,Default,,0,0,0,,Мен құрылысты жалғастыра алсам...
Dialogue: 0,1:23:47.89,1:23:49.39,Default,,0,0,0,,мәңгілік
Dialogue: 0,1:23:50.27,1:23:53.48,Default,,0,0,0,,«Айнымас ілмекпен мәңгілік бақыт»
Dialogue: 0,1:23:54.82,1:23:57.36,Default,,0,0,0,,«КОМА» атауының шығу тегі осыдан шыққан.
Dialogue: 0,1:23:57.86,1:23:58.65,Default,,0,0,0,,Иә
Dialogue: 0,1:24:02.07,1:24:03.53,Default,,0,0,0,,«Айналмалы топ»
Dialogue: 0,1:24:04.58,1:24:07.16,Default,,0,0,0,,«Тұрақты болған кезде пайда болатын тоқтаған күй»
Dialogue: 0,1:24:07.66,1:24:09.50,Default,,0,0,0,,«Мәңгілік болсын»
Dialogue: 0,1:24:10.21,1:24:12.25,Default,,0,0,0,,«Бұрынғылар бізге сеніп тапсырған болашақ»
Dialogue: 0,1:24:12.75,1:24:15.17,Default,,0,0,0,,«Келесі және келесі...»
Dialogue: 0,1:24:33.86,1:24:35.19,Default,,0,0,0,,Таң қалды
Dialogue: 0,1:24:35.27,1:24:37.44,Default,,0,0,0,,Сіз бұл жобаға жауаптысыз.
Dialogue: 0,1:24:37.53,1:24:39.94,Default,,0,0,0,,Сіз виски туралы ештеңе білмейсіз.
Dialogue: 0,1:24:40.61,1:24:42.70,Default,,0,0,0,,Мен мұны да зерттедім...
Dialogue: 0,1:24:43.28,1:24:44.28,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:24:44.78,1:24:47.20,Default,,0,0,0,,Бұл жігіт әлі де жаңадан келгендерге толы.
Dialogue: 0,1:24:47.79,1:24:50.16,Default,,0,0,0,,Егер Такахаши мырза менімен бірге болса.
Dialogue: 0,1:24:50.25,1:24:51.21,Default,,0,0,0,,Жарайды, бірақ...
Dialogue: 0,1:24:51.29,1:24:53.63,Default,,0,0,0,,Ал, Кавабата мырза.
Dialogue: 0,1:24:53.71,1:24:56.29,Default,,0,0,0,,Барлығы бірдей біле бермейді
Dialogue: 0,1:24:57.46,1:25:00.97,Default,,0,0,0,,Мен сізге келесі жолы білетінімді айтамын.
Dialogue: 0,1:25:01.05,1:25:04.55,Default,,0,0,0,,Өте жақсы, менің ағам жұмыста өзіне ұнайтын ісімен айналысады.
Dialogue: 0,1:25:05.05,1:25:06.43,Default,,0,0,0,,А... ха
Dialogue: 0,1:25:06.51,1:25:08.56,Default,,0,0,0,,Бұл не? сол күлкі
Dialogue: 0,1:25:08.64,1:25:09.77,Default,,0,0,0,,Хехе
Dialogue: 0,1:25:12.06,1:25:15.02,Default,,0,0,0,,Котаро-санға жаңа жоба үшін рахмет.
Dialogue: 0,1:25:15.69,1:25:17.27,Default,,0,0,0,,Мен өте қуаныштымын
Dialogue: 0,1:25:18.57,1:25:19.78,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын
Dialogue: 0,1:25:20.82,1:25:22.40,Default,,0,0,0,,Біз жақында келеміз.
Dialogue: 0,1:25:31.70,1:25:33.87,Default,,0,0,0,,Комада спирт зауытына қош келдіңіз
Dialogue: 0,1:25:33.96,1:25:35.96,Default,,0,0,0,,♪~
Dialogue: 0,1:30:48.44,1:30:50.44,Default,,0,0,0,,~♪
Dialogue: 0,1:30:51.94,1:30:57.94,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory