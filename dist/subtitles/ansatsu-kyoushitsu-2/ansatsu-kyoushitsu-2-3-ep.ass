Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.71,0:00:04.33,Default,,0,0,0,,Жүр, Коросей
Dialogue: 0,0:00:04.42,0:00:07.13,Default,,0,0,0,,Соңғы өлім матчын бастаймыз ба?
Dialogue: 0,0:00:07.21,0:00:08.50,Default,,0,0,0,,Жаңа!
Dialogue: 0,0:00:08.59,0:00:10.38,Default,,0,0,0,,Коросей
Dialogue: 0,0:00:10.46,0:00:13.38,Default,,0,0,0,,Сен... менен әлсізсің.
Dialogue: 0,0:00:13.47,0:00:18.47,Default,,0,0,0,,♪～
Dialogue: 0,0:01:38.13,0:01:43.14,Default,,0,0,0,,～♪
Dialogue: 0,0:01:49.69,0:01:50.56,Default,,0,0,0,,Итон!
Dialogue: 0,0:01:51.90,0:01:56.19,Default,,0,0,0,,Алдымен өрісті күрт өзгертеміз.
Dialogue: 0,0:01:56.28,0:01:58.15,Default,,0,0,0,,Содан кейін шабуыл жасаңыз
Dialogue: 0,0:01:56.28,0:01:58.15,Default,,0,0,0,,Ачи Ачи Ачи…
Dialogue: 0,0:01:58.15,0:01:59.11,Default,,0,0,0,,Ачи Ачи Ачи…
Dialogue: 0,0:01:59.20,0:02:03.24,Default,,0,0,0,,Соғудан гөрі қоршау оңай.
Dialogue: 0,0:02:03.33,0:02:06.33,Default,,0,0,0,,Маған сіздің тактикаңызды қолдануға рұқсат етілді.
Dialogue: 0,0:02:06.41,0:02:10.17,Default,,0,0,0,,Ши... Широ! Мұның бәрі жоспар ма?
Dialogue: 0,0:02:10.25,0:02:11.46,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:02:11.54,0:02:15.92,Default,,0,0,0,,Шәкірттеріңіздің сенімін жоғалта бастасаңыз, ол құбыжық дүрбелеңмен қозғалады.
Dialogue: 0,0:02:16.67,0:02:19.72,Default,,0,0,0,,Кішкене табиғи емес болса да, секіреді.
Dialogue: 0,0:02:19.80,0:02:21.39,Default,,0,0,0,,Сен ақымақсың.
Dialogue: 0,0:02:21.47,0:02:24.43,Default,,0,0,0,,Қарғыс атсын... бұл біздің олжамыз!
Dialogue: 0,0:02:24.51,0:02:27.73,Default,,0,0,0,,Әрқашан әдепсіз жерден бастаңыз
Dialogue: 0,0:02:27.81,0:02:31.15,Default,,0,0,0,,Ересек болу деген осы
Dialogue: 0,0:02:31.23,0:02:34.27,Default,,0,0,0,,Итонаның шатырларына не бекітілген?
Dialogue: 0,0:02:34.36,0:02:37.94,Default,,0,0,0,,Қолғап, оның кесу жиегі сезімге қарсы заттан жасалған
Dialogue: 0,0:02:38.03,0:02:39.86,Default,,0,0,0,,Шатырлар соқтығысқан сайын
Dialogue: 0,0:02:39.95,0:02:43.70,Default,,0,0,0,,Біртіндеп және біржақты түрде зиян келтіруді жалғастырады
Dialogue: 0,0:02:43.78,0:02:47.16,Default,,0,0,0,,Бұл мені тоқтатады деп ойламаймын...
Dialogue: 0,0:02:50.37,0:02:52.25,Default,,0,0,0,,Мен жеңдім, ағайын.
Dialogue: 0,0:02:53.00,0:02:56.67,Default,,0,0,0,,Мен сені өлтіріп, бір ғана мәселені шешемін!
Dialogue: 0,0:02:56.75,0:02:58.13,Default,,0,0,0,,Нюя!
Dialogue: 0,0:02:58.21,0:02:59.72,Default,,0,0,0,,Яғни...
Dialogue: 0,0:03:00.68,0:03:02.34,Default,,0,0,0,,Ең күшті дәлел!
Dialogue: 0,0:03:02.43,0:03:04.76,Default,,0,0,0,,Жаңа! Нюурурун…
Dialogue: 0,0:03:04.85,0:03:06.97,Default,,0,0,0,,Ах... Қарғыс атсын!
Dialogue: 0,0:03:08.14,0:03:10.27,Default,,0,0,0,,Иә, бұл керемет, Итона-кун.
Dialogue: 0,0:03:10.35,0:03:13.86,Default,,0,0,0,,Егер бірінші семестрге дейін мұғалім болған болса, мұны істеу мүмкін еді.
Dialogue: 0,0:03:13.94,0:03:15.19,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:15.27,0:03:18.32,Default,,0,0,0,,Бірақ сіздің шабуыл үлгісі қарапайым.
Dialogue: 0,0:03:19.15,0:03:23.49,Default,,0,0,0,,Қаншалықты жылдам, қаншалықты күшті болса да, ата-анаңда қанша стратегия болса да
Dialogue: 0,0:03:23.57,0:03:26.08,Default,,0,0,0,,Ұстаздың қобалжуы қаншалықты оңай болса да,
Dialogue: 0,0:03:26.16,0:03:30.29,Default,,0,0,0,,Үшінші рет тез бейімделіп, бас тарта аласыз.
Dialogue: 0,0:03:31.21,0:03:32.46,Default,,0,0,0,,Ақымақ...
Dialogue: 0,0:03:32.54,0:03:33.83,Default,,0,0,0,,Бұл осылай болуы керек...
Dialogue: 0,0:03:37.13,0:03:38.17,Default,,0,0,0,,Итона-кун
Dialogue: 0,0:03:38.25,0:03:39.30,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:39.38,0:03:42.18,Default,,0,0,0,,Тіпті мұғалімдер де үйренеді.
Dialogue: 0,0:03:42.26,0:03:44.26,Default,,0,0,0,,Күннен күнге өскен мұғалімсіз
Dialogue: 0,0:03:44.34,0:03:47.47,Default,,0,0,0,,Оқушыларымды қалай оқыта аламын?
Dialogue: 0,0:03:47.56,0:03:48.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:48.68,0:03:52.14,Default,,0,0,0,,Енді қиыншылық тудыратын мата торынан құтылайық.
Dialogue: 0,0:03:52.69,0:03:55.65,Default,,0,0,0,,Жазғы демалыста толық қорғау тәжірибесі арқылы
Dialogue: 0,0:03:55.73,0:03:58.36,Default,,0,0,0,,Мұғалім де әдістемені меңгерді
Dialogue: 0,0:03:58.44,0:04:01.44,Default,,0,0,0,,Бүкіл дененің орнына шатырдың бір бөлігін ғана қысыңыз
Dialogue: 0,0:04:01.53,0:04:03.36,Default,,0,0,0,,Энергияны алу жолы
Dialogue: 0,0:04:03.45,0:04:04.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:04.95,0:04:06.24,Default,,0,0,0,,Ніл өзенінің батыс жағалауындағы қиын өткелі бар шатқалдың тереңінде —
Dialogue: 0,0:04:08.08,0:04:09.95,Default,,0,0,0,,Есіңізде болсын, Итона-кун.
Dialogue: 0,0:04:10.04,0:04:12.87,Default,,0,0,0,,Қастандық – ұстазға тәрбие
Dialogue: 0,0:04:12.96,0:04:17.17,Default,,0,0,0,,Assassination Classroom мұғалімі сабақ берген сайын күшейе түседі!
Dialogue: 0,0:04:17.25,0:04:18.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:22.76,0:04:25.51,Default,,0,0,0,,Неге... Мен жеңе алмаймын
Dialogue: 0,0:04:25.59,0:04:27.51,Default,,0,0,0,,Мен...
Dialogue: 0,0:04:27.60,0:04:30.89,Default,,0,0,0,,Мен күштірек болдым... болуы керек болса да
Dialogue: 0,0:04:37.31,0:04:39.36,Default,,0,0,0,,Дұрыс, Широ-сан.
Dialogue: 0,0:04:40.23,0:04:43.36,Default,,0,0,0,,Оны Е сыныбына қалдырыңыз да, үнсіз кетіңіз.
Dialogue: 0,0:04:44.11,0:04:44.95,Default,,0,0,0,,Сондай-ақ...
Dialogue: 0,0:04:45.03,0:04:48.78,Default,,0,0,0,,Мен жалаңаш емеспін деген дұрыс ақпаратты таратыңыз.
Dialogue: 0,0:04:48.87,0:04:52.79,Default,,0,0,0,,Менің кеудем де В... В!
Dialogue: 0,0:04:52.87,0:04:53.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:53.83,0:04:55.62,Default,,0,0,0,,Жаңа…
Dialogue: 0,0:04:57.13,0:04:58.13,Default,,0,0,0,,Хмм…
Dialogue: 0,0:04:58.75,0:05:00.13,Default,,0,0,0,,Ол сәл қорқынышты емес пе?
Dialogue: 0,0:05:00.21,0:05:01.75,Default,,0,0,0,,- (Коро-сенсэй) Жаңа! - Қарғыс атсын...
Dialogue: 0,0:05:01.84,0:05:03.42,Default,,0,0,0,,Бұл... ауырады...
Dialogue: 0,0:05:03.51,0:05:06.09,Default,,0,0,0,,- (Коро-сенсэй) Итона-кун! -Менің басым... ауырып тұр!
Dialogue: 0,0:05:06.18,0:05:08.55,Default,,0,0,0,,Менің миым жарылып кетті!
Dialogue: 0,0:05:08.64,0:05:13.39,Default,,0,0,0,,Қайталанатын жеңілістердің күйзелісінен шандырлар сіздің психикаңызды жей бастады ма?
Dialogue: 0,0:05:13.47,0:05:15.69,Default,,0,0,0,,Сау болыңыз! Итона-кун!
Dialogue: 0,0:05:15.77,0:05:18.52,Default,,0,0,0,,Менің ойымша, бұл бала үшін шектеу ...
Dialogue: 0,0:05:18.60,0:05:22.61,Default,,0,0,0,,Менің барлық тактикамды пайдалана алмайтын сияқтымын.
Dialogue: 0,0:05:22.69,0:05:25.15,Default,,0,0,0,,Жоқ... не дедің...
Dialogue: 0,0:05:25.24,0:05:26.07,Default,,0,0,0,,Итон
Dialogue: 0,0:05:26.82,0:05:31.24,Default,,0,0,0,,Егер біз мұндай нәтижелерге қол жеткізе алмасақ, ұйым ақша таба алмайды.
Dialogue: 0,0:05:31.33,0:05:34.04,Default,,0,0,0,,Саған деген сезімім жоқ емес.
Dialogue: 0,0:05:34.12,0:05:39.00,Default,,0,0,0,,Келесі элементті пайдалану үшін мен бір жерде бас тартуым керек.
Dialogue: 0,0:05:39.08,0:05:41.92,Default,,0,0,0,,Қош бол Итон
Dialogue: 0,0:05:42.00,0:05:44.01,Default,,0,0,0,,Қалғанын өзіңіз жасаңыз
Dialogue: 0,0:05:44.09,0:05:45.34,Default,,0,0,0,,Ха, күте тұрыңыз!
Dialogue: 0,0:05:45.42,0:05:47.55,Default,,0,0,0,,Сіз әлі де қамқоршысыз ба?
Dialogue: 0,0:05:47.63,0:05:51.22,Default,,0,0,0,,Тәрбиеші болып ойнама, құбыжық
Dialogue: 0,0:05:51.30,0:05:55.02,Default,,0,0,0,,Бәрін қирату ғана болса да
Dialogue: 0,0:05:55.10,0:05:59.85,Default,,0,0,0,,Мен сенің барыңды кешірмеймін
Dialogue: 0,0:05:59.94,0:06:01.77,Default,,0,0,0,,Құрбандыққа қарамастан
Dialogue: 0,0:06:01.86,0:06:05.32,Default,,0,0,0,,Мен сенің өлгеніңді қалаймын.
Dialogue: 0,0:06:05.40,0:06:06.69,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:06.78,0:06:09.03,Default,,0,0,0,,Одан жақсы ма?
Dialogue: 0,0:06:09.11,0:06:11.66,Default,,0,0,0,,Қымбатты шәкірттеріңізді жайына қалдырыңыз
Dialogue: 0,0:06:11.74,0:06:12.95,Default,,0,0,0,,Құдай-ай!
Dialogue: 0,0:06:13.03,0:06:15.54,Default,,0,0,0,,Нюяа! қауіпті!
Dialogue: 0,0:06:17.66,0:06:20.71,Default,,0,0,0,,А... ха... ха... Арх!
Dialogue: 0,0:06:23.25,0:06:25.21,Default,,0,0,0,,Итона-кун...
Dialogue: 0,0:06:25.30,0:06:27.84,Default,,0,0,0,,Нюу нюу…
Dialogue: 0,0:06:27.92,0:06:29.80,Default,,0,0,0,,Коро-сенсэй!
Dialogue: 0,0:06:29.88,0:06:32.18,Default,,0,0,0,,Нуруфуфуфуфу…
Dialogue: 0,0:06:32.26,0:06:36.02,Default,,0,0,0,,Мен қатты шаршадым, сондықтан біраз демаламын.
Dialogue: 0,0:06:39.81,0:06:43.90,Default,,0,0,0,,Адам ағзасына шандыр жасушалары трансплантацияланғандар
Dialogue: 0,0:06:43.98,0:06:47.24,Default,,0,0,0,,Сәйкестік шаралары қабылданбаса, күн сайын дерлік
Dialogue: 0,0:06:47.32,0:06:51.45,Default,,0,0,0,,Тозақтық бас тартудан азап шегу
Dialogue: 0,0:06:51.53,0:06:54.33,Default,,0,0,0,,Мен техникалық қызмет көрсетуді тоқтаттым, бірақ бұл соңғы рет болды
Dialogue: 0,0:06:54.41,0:06:58.45,Default,,0,0,0,,Шатырлар қатты ауырсынуды тудырады және нервтерді жейді.
Dialogue: 0,0:06:58.54,0:07:01.92,Default,,0,0,0,,Қалыпты адам 3 күннің ішінде жынды болып өледі.
Dialogue: 0,0:07:02.00,0:07:02.96,Default,,0,0,0,,Хаа!
Dialogue: 0,0:07:03.04,0:07:06.21,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:07:06.30,0:07:07.92,Default,,0,0,0,,Бұл бірінші көрініс.
Dialogue: 0,0:07:08.59,0:07:11.51,Default,,0,0,0,,Қазіргі уақытта Кунигаока қаласында үздіксіз орын алуда.
Dialogue: 0,0:07:11.59,0:07:14.01,Default,,0,0,0,,Ұялы телефон дүкеніне шабуыл оқиғасы
Dialogue: 0,0:07:14.10,0:07:17.14,Default,,0,0,0,,Полиция лаңкестік болуы мүмкін деген болжам жасады...
Dialogue: 0,0:07:17.22,0:07:18.77,Default,,0,0,0,,Бұл дәл
Dialogue: 0,0:07:18.85,0:07:20.35,Default,,0,0,0,,Бұл оның ісі.
Dialogue: 0,0:07:20.43,0:07:22.56,Default,,0,0,0,,Неліктен барлық жылжымалы дүкендер?
Dialogue: 0,0:07:22.65,0:07:24.27,Default,,0,0,0,,Не істеуіміз керек, мұғалім?
Dialogue: 0,0:07:24.36,0:07:27.65,Default,,0,0,0,,Сынып жетекшісі ретінде мен оны тоқтату жауапкершілігін аламын.
Dialogue: 0,0:07:27.73,0:07:29.61,Default,,0,0,0,,Мен оны тауып, қорғауым керек.
Dialogue: 0,0:07:30.70,0:07:33.41,Default,,0,0,0,,Широның жеке басы туралы жалпы түсінік алдым.
Dialogue: 0,0:07:33.49,0:07:37.03,Default,,0,0,0,,Ол үшін басқалардың бәрі бір реттік бөлік.
Dialogue: 0,0:07:38.08,0:07:40.91,Default,,0,0,0,,Ондай адамның тактикасын болжай алмаймын.
Dialogue: 0,0:07:41.91,0:07:44.38,Default,,0,0,0,,Менің ойымша, оны жай қалдырған дұрысырақ болар еді.
Dialogue: 0,0:07:44.46,0:07:46.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:46.29,0:07:47.92,Default,,0,0,0,,Әлі де менің сынып жетекшім.
Dialogue: 0,0:07:48.00,0:07:49.42,Default,,0,0,0,,- (Коро-сенсэй) Жаңа! -(Нағиса т.б.) Ой...
Dialogue: 0,0:07:49.51,0:07:53.47,Default,,0,0,0,,Оқушыларыңызды ешқашан жібермеңіз
Dialogue: 0,0:07:53.55,0:07:57.14,Default,,0,0,0,,Ұстаздық еткенде ант еткенің.
Dialogue: 0,0:07:57.22,0:07:58.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:59.72,0:08:03.10,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:08:03.19,0:08:05.61,Default,,0,0,0,,...
Dialogue: 0,0:08:06.69,0:08:09.03,Default,,0,0,0,,Ешқандай төте жолдар жоқ, Итон.
Dialogue: 0,0:08:09.11,0:08:10.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:10.86,0:08:12.90,Default,,0,0,0,,Күн сайын қайталанатын оқу
Dialogue: 0,0:08:12.99,0:08:17.28,Default,,0,0,0,,Шын жүректен тырысқандар ғана күшейеді.
Dialogue: 0,0:08:18.49,0:08:20.54,Default,,0,0,0,,Уф... өтірікші
Dialogue: 0,0:08:21.58,0:08:27.21,Default,,0,0,0,,Шешуші соққы беру — әрқашан «Зе Ворлд»-тің шынайы күші.
Dialogue: 0,0:08:35.18,0:08:38.97,Default,,0,0,0,,Маған әдемі немесе айналмалы жолдар қажет емес.
Dialogue: 0,0:08:39.06,0:08:42.35,Default,,0,0,0,,Жеңілуді қаламайтын күш мені ауыртады.
Dialogue: 0,0:08:42.43,0:08:43.60,Default,,0,0,0,,Мен жеңгім келеді
Dialogue: 0,0:08:43.68,0:08:46.23,Default,,0,0,0,,Жеңіске жету үшін күш тілеймін
Dialogue: 0,0:08:46.31,0:08:49.48,Default,,0,0,0,,Ақыры мен адам тәрізді жүзді көрдім.
Dialogue: 0,0:08:49.57,0:08:51.36,Default,,0,0,0,,Итона-кун
Dialogue: 0,0:08:51.44,0:08:52.90,Default,,0,0,0,,Ағай...
Dialogue: 0,0:08:52.99,0:08:55.28,Default,,0,0,0,,Мені «Коро-сенсэй» деп атаңыз
Dialogue: 0,0:08:55.36,0:08:58.03,Default,,0,0,0,,Мен сіздің сынып мұғалімімін.
Dialogue: 0,0:08:58.12,0:09:01.24,Default,,0,0,0,,Ашуланып, ашуланба, Итон.
Dialogue: 0,0:09:01.33,0:09:03.50,Default,,0,0,0,,Менің басымнан көп нәрсе өтті.
Dialogue: 0,0:09:03.58,0:09:06.54,Default,,0,0,0,,Мен оны жуып тастаймын, сондықтан маған тыныштықпен еріңіз.
Dialogue: 0,0:09:06.62,0:09:08.63,Default,,0,0,0,,Шулы!
Dialogue: 0,0:09:08.71,0:09:10.21,Default,,0,0,0,,Бұл ойын
Dialogue: 0,0:09:10.29,0:09:12.71,Default,,0,0,0,,Бұл жолы... жең
Dialogue: 0,0:09:12.80,0:09:15.34,Default,,0,0,0,,Әрине, жарысуға болады.
Dialogue: 0,0:09:15.42,0:09:19.97,Default,,0,0,0,,Екеуіміз де мемлекеттік құпия болғандықтан, мұны бос жерде істегіңіз келе ме?
Dialogue: 0,0:09:20.05,0:09:23.47,Default,,0,0,0,,Осыдан кейін біз сонда барбекю жасаймыз
Dialogue: 0,0:09:23.56,0:09:26.56,Default,,0,0,0,,үшінмыз мұғалімді өлтіруді үйренейік.
Dialogue: 0,0:09:27.23,0:09:29.44,Default,,0,0,0,,Сол сегізаяқ тұрақты~
Dialogue: 0,0:09:29.52,0:09:33.65,Default,,0,0,0,,Сен менің сынып мұғалімі болған соң, мен сені үйрету үшін тозақтың соңына келемін.
Dialogue: 0,0:09:33.73,0:09:35.36,Default,,0,0,0,,Нурхуфуфуфу
Dialogue: 0,0:09:35.44,0:09:38.57,Default,,0,0,0,,Әрине, менің алдымда студенттер болғандықтан.
Dialogue: 0,0:09:38.66,0:09:42.33,Default,,0,0,0,,Оқытқысы келетін мұғалімнің инстинкті.
Dialogue: 0,0:09:42.41,0:09:44.75,Default,,0,0,0,,Нуруфуфуфуфу…
Dialogue: 0,0:09:44.83,0:09:46.25,Default,,0,0,0,,Жаңа!
Dialogue: 0,0:09:46.33,0:09:48.00,Default,,0,0,0,,Не?
Dialogue: 0,0:09:48.08,0:09:49.50,Default,,0,0,0,,Мырза, ол сіз бе едіңіз?
Dialogue: 0,0:09:49.58,0:09:53.21,Default,,0,0,0,,Бұл антисенсиялық ұнтақ!
Dialogue: 0,0:09:53.30,0:09:57.30,Default,,0,0,0,,Итонаны жүзу де жоспардың бір бөлігі болды, Коро-сенсей.
Dialogue: 0,0:09:57.38,0:09:58.93,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:09:59.01,0:10:00.05,Default,,0,0,0,,Нню
Dialogue: 0,0:10:00.14,0:10:02.85,Default,,0,0,0,,Мен оны байқамадым, өйткені мен Итона-кунның қанды құмарлығынан абдырап қалдым.
Dialogue: 0,0:10:02.93,0:10:06.93,Default,,0,0,0,,Жүр, Итона, бұл сенің соңғы қызметің.
Dialogue: 0,0:10:07.02,0:10:09.10,Default,,0,0,0,,-Уф... Ах! - (Коро-сенсэй) Итона-кун!
Dialogue: 0,0:10:09.19,0:10:10.19,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:12.32,0:10:15.74,Default,,0,0,0,,Менің артымнан келесің бе? сынып мұғалімі
Dialogue: 0,0:10:17.99,0:10:22.45,Default,,0,0,0,,Жаңа... (Нағиса мен басқалары жөтелді)
Dialogue: 0,0:10:22.53,0:10:23.62,Default,,0,0,0,,Коросей
Dialogue: 0,0:10:24.37,0:10:26.12,Default,,0,0,0,,үшінңыз жақсы ма?
Dialogue: 0,0:10:26.20,0:10:27.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:27.50,0:10:28.79,Default,,0,0,0,,Қалай болса да
Dialogue: 0,0:10:28.87,0:10:32.46,Default,,0,0,0,,Енді мұғалім Итона-кунға көмектеседі!
Dialogue: 0,0:10:33.46,0:10:36.92,Default,,0,0,0,,Бізді қорғап тұрғандықтан, сіздің жалтару реакцияңыз кешіктірілді.
Dialogue: 0,0:10:37.01,0:10:38.22,Default,,0,0,0,,Міне!
Dialogue: 0,0:10:38.30,0:10:42.60,Default,,0,0,0,,Широ, өтінемін, мені пешка ретінде пайдалан.
Dialogue: 0,0:10:42.68,0:10:43.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:54.69,0:10:56.32,Default,,0,0,0,,Итона-кун!
Dialogue: 0,0:10:57.82,0:11:01.66,Default,,0,0,0,,Жаңа! Менің қозғалысымды бәсеңдететін қысым сәулесі
Dialogue: 0,0:11:02.37,0:11:06.66,Default,,0,0,0,,Мен күткендей болса да, сен шынымен ақымақсың, Коросей.
Dialogue: 0,0:11:06.74,0:11:08.12,Default,,0,0,0,,Мақсат - Итона.
Dialogue: 0,0:11:08.20,0:11:11.58,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:11.67,0:11:13.08,Default,,0,0,0,,Иә
Dialogue: 0,0:11:13.17,0:11:17.21,Default,,0,0,0,,Өзіңнен басқа біреу нысанаға айналғанда сен әлсізсің.
Dialogue: 0,0:11:17.30,0:11:18.80,Default,,0,0,0,,Ақыры қашасың ба?
Dialogue: 0,0:11:18.88,0:11:20.76,Default,,0,0,0,,Мен оның сынып жетекшісімін!
Dialogue: 0,0:11:20.84,0:11:22.18,Default,,0,0,0,,Мен...
Dialogue: 0,0:11:22.26,0:11:24.18,Default,,0,0,0,,Қуатсыз
Dialogue: 0,0:11:24.26,0:11:27.10,Default,,0,0,0,,Сондықтан да мені әріптестерім тастап кетті.
Dialogue: 0,0:11:32.65,0:11:34.19,Default,,0,0,0,,Жақсы көздер
Dialogue: 0,0:11:34.27,0:11:38.28,Default,,0,0,0,,Сіздің көз алдыңызда жеңіске деген жігер.
Dialogue: 0,0:11:38.36,0:11:43.11,Default,,0,0,0,,Бұл мен жасаған қуатты ұяшықтарды толық пайдалану үшін өте маңызды.
Dialogue: 0,0:11:44.66,0:11:47.33,Default,,0,0,0,,Менімен толықтыруды қалайсыз ба?
Dialogue: 0,0:11:47.41,0:11:51.00,Default,,0,0,0,,Жеңіске апарар жолды анықтауды маған қалдыр.
Dialogue: 0,0:11:51.08,0:11:57.50,Default,,0,0,0,,Сіздің табандылығыңыз және менің техникам жеңіске жетуге мүмкіндік береді.
Dialogue: 0,0:11:58.09,0:12:02.26,Default,,0,0,0,,Егер сізде күш болса, сіз бұл дүниеде басқалардан күшті бола аласыз.
Dialogue: 0,0:12:02.34,0:12:04.18,Default,,0,0,0,,Өйткені оның билікке деген құмарлығы болды.
Dialogue: 0,0:12:04.26,0:12:07.97,Default,,0,0,0,,Мен бейтаныс жасушаларымның ауыр азабына шыдадым.
Dialogue: 0,0:12:08.06,0:12:12.48,Default,,0,0,0,,Жеңіске деген табандылығым болғандықтан, қайта-қайта шабуылға шықтым.
Dialogue: 0,0:12:12.56,0:12:15.40,Default,,0,0,0,,Бірақ менің табандылығым маған жетпейді...
Dialogue: 0,0:12:15.48,0:12:18.15,Default,,0,0,0,,Оның үстіне өлтіретін адам оны қорғайды.
Dialogue: 0,0:12:18.23,0:12:22.07,Default,,0,0,0,,Мен сол кішкентай шабақтардан жеңілемін бе...
Dialogue: 0,0:12:22.15,0:12:23.74,Default,,0,0,0,,Аһ!
Dialogue: 0,0:12:23.82,0:12:24.95,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,0:12:25.03,0:12:26.57,Default,,0,0,0,,-Ах... -(Бағыныңқы) Не?
Dialogue: 0,0:12:26.66,0:12:28.66,Default,,0,0,0,,- (Маэхара) Эй! -(Бағыныңқы) Арх!
Dialogue: 0,0:12:29.79,0:12:30.66,Default,,0,0,0,,Әзірге үш минут
Dialogue: 0,0:12:30.75,0:12:32.96,Default,,0,0,0,,Бұл сегізаяққа қарсы матадан жасалған киім, солай ма?
Dialogue: 0,0:12:33.04,0:12:37.25,Default,,0,0,0,,Сізге рахмет, біз оны сегізаяқтың орнына тастауымыз керек.
Dialogue: 0,0:12:37.33,0:12:38.59,Default,,0,0,0,,Аһ!
Dialogue: 0,0:12:38.67,0:12:41.67,Default,,0,0,0,,Терасака Ағаштың шамын сұраңыз
Dialogue: 0,0:12:41.76,0:12:42.59,Default,,0,0,0,,О!
Dialogue: 0,0:12:42.67,0:12:43.34,Default,,0,0,0,,Қарғыс атсын! Бауырлар! О!
Dialogue: 0,0:12:43.34,0:12:44.43,Default,,0,0,0,,Қарғыс атсын! Бауырлар! О!
Dialogue: 0,0:12:43.34,0:12:44.43,Default,,0,0,0,,(шу)
Dialogue: 0,0:12:46.22,0:12:47.34,Default,,0,0,0,,Уф!
Dialogue: 0,0:12:47.43,0:12:49.81,Default,,0,0,0,,Балалар... неге?
Dialogue: 0,0:12:49.89,0:12:51.64,Default,,0,0,0,,Мені қате түсінбеңіз.
Dialogue: 0,0:12:52.48,0:12:55.31,Default,,0,0,0,,Мен Широға ренжідім.
Dialogue: 0,0:12:55.39,0:12:58.86,Default,,0,0,0,,Коро-сенсэй бармаса, біз жалғыз қалар едік.
Dialogue: 0,0:12:58.94,0:12:59.77,Default,,0,0,0,,Хайами
Dialogue: 0,0:12:59.86,0:13:01.82,Default,,0,0,0,,«Мені қате түсінбеңіз», - дедім мен.
Dialogue: 0,0:13:01.90,0:13:03.86,Default,,0,0,0,,Шикі цундере жақсы.
Dialogue: 0,0:13:03.94,0:13:04.82,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:04.90,0:13:07.53,Default,,0,0,0,,Саған қарай аламын ба? Широ
Dialogue: 0,0:13:07.62,0:13:09.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:09.58,0:13:10.91,Default,,0,0,0,,Түсіруді тоқтатсаңыз
Dialogue: 0,0:13:10.99,0:13:13.50,Default,,0,0,0,,Тор тамырынан жойылады.
Dialogue: 0,0:13:13.58,0:13:16.46,Default,,0,0,0,,Келгендеріңізге рахмет.
Dialogue: 0,0:13:16.54,0:13:18.71,Default,,0,0,0,,Тор шатырларды ерітіп жатыр!
Dialogue: 0,0:13:18.79,0:13:20.13,Default,,0,0,0,,Мен оны бірден шығарамын!
Dialogue: 0,0:13:20.21,0:13:22.21,Default,,0,0,0,,Кет, Широ-сан!
Dialogue: 0,0:13:22.30,0:13:25.17,Default,,0,0,0,,Итонаны осы жерден алуға болады.
Dialogue: 0,0:13:25.26,0:13:27.93,Default,,0,0,0,,Сіз әрқашан мұқият жоспарлар жасайсыз.
Dialogue: 0,0:13:28.01,0:13:31.89,Default,,0,0,0,,Оқушыларды қатыстырсаңыз, жоспар бұзылады.
Dialogue: 0,0:13:31.97,0:13:35.18,Default,,0,0,0,,Сіз айқын нәрселерді неғұрлым тезірек түсінсеңіз, соғұрлым жақсы.
Dialogue: 0,0:13:35.27,0:13:36.35,Default,,0,0,0,,Хун
Dialogue: 0,0:13:37.10,0:13:40.19,Default,,0,0,0,,Құбыжықтардың айналасында шыбындар үйірілетін сынып...
Dialogue: 0,0:13:40.27,0:13:42.48,Default,,0,0,0,,Бұл шынымен де тітіркендіргіш.
Dialogue: 0,0:13:43.36,0:13:45.36,Default,,0,0,0,,Бірақ, әрине, менің жоспарларыма кіреді
Dialogue: 0,0:13:45.44,0:13:48.78,Default,,0,0,0,,Негізгі шолу қажет екенін мойындайық.
Dialogue: 0,0:13:48.86,0:13:50.49,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:50.57,0:13:52.95,Default,,0,0,0,,Мен оны саған беремін.
Dialogue: 0,0:13:53.04,0:13:58.04,Default,,0,0,0,,Қалай болғанда да, бәріміз бірге 2-3 күн бақытты өмір сүреміз.
Dialogue: 0,0:13:59.88,0:14:02.63,Default,,0,0,0,,Оқу мен шыншылдықтың бәрі өтірік.
Dialogue: 0,0:14:02.71,0:14:07.80,Default,,0,0,0,,Сайып келгенде, бәрі сізде басым күшке ие немесе жоқ.
Dialogue: 0,0:14:10.22,0:14:11.14,Default,,0,0,0,,Итона-кунға
Dialogue: 0,0:14:11.22,0:14:14.14,Default,,0,0,0,,Күш пен жеңіске деген патологиялық құмарлық болғанша
Dialogue: 0,0:14:14.22,0:14:17.23,Default,,0,0,0,,Шатыр жасушалары қатты жабысады және бөлінбейді.
Dialogue: 0,0:14:17.31,0:14:19.73,Default,,0,0,0,,Мен оларды әйтеуір бір-бірінен ажырату мүмкін емес пе деп ойлаймын
Dialogue: 0,0:14:19.81,0:14:22.19,Default,,0,0,0,,Мен оның қосымшасын өшірмесем...
Dialogue: 0,0:14:22.27,0:14:25.94,Default,,0,0,0,,Ол үшін біз мұның себептері туралы көбірек білуіміз керек.
Dialogue: 0,0:14:26.03,0:14:27.40,Default,,0,0,0,,Бірақ эй
Dialogue: 0,0:14:27.49,0:14:30.53,Default,,0,0,0,,Менің ойымша, сіз өзіңіздің жеке тарихыңыз туралы шыншыл болмайсыз.
Dialogue: 0,0:14:30.61,0:14:33.37,Default,,0,0,0,,- (Фуа) Бұл туралы - (Нағиса) А?
Dialogue: 0,0:14:33.45,0:14:35.08,Default,,0,0,0,,Мен қызық болдым.
Dialogue: 0,0:14:35.16,0:14:38.54,Default,,0,0,0,,Неліктен Итона-кун жылжымалы дүкенді тонады?
Dialogue: 0,0:14:38.62,0:14:42.59,Default,,0,0,0,,-де мен Рицудан оған не байланысты екенін анықтауды сұрадым.
Dialogue: 0,0:14:42.67,0:14:43.50,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:14:43.59,0:14:47.59,Default,,0,0,0,,Хорибе Итонари компания президентінің ұлы болды.
Dialogue: 0,0:14:47.67,0:14:48.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:48.80,0:14:52.30,Default,,0,0,0,,Дүние жүзі бойынша смартфон бөлшектерімен қамтамасыз ететін шағын зауыт.
Dialogue: 0,0:14:52.39,0:14:55.51,Default,,0,0,0,,Үлкен жылы мен қарызға батып, банкротқа ұшырадым.
Dialogue: 0,0:14:55.60,0:14:59.18,Default,,0,0,0,,Президент пен оның әйелі ұлын қалдырып, Кумогакүреге кетті.
Dialogue: 0,0:14:59.27,0:15:02.56,Default,,0,0,0,,Әйтеуір оны кез келген адам елестете алады.
Dialogue: 0,0:15:02.65,0:15:05.94,Default,,0,0,0,,Неліктен Итона-кун билік пен жеңісті қалайды
Dialogue: 0,0:15:06.03,0:15:08.57,Default,,0,0,0,,Бұл қызықсыз.
Dialogue: 0,0:15:08.65,0:15:10.74,Default,,0,0,0,,Сондықтан сіз жай ғана шатасасыз ба?
Dialogue: 0,0:15:11.78,0:15:12.82,Default,,0,0,0,,Иә
Dialogue: 0,0:15:12.91,0:15:14.99,Default,,0,0,0,,Әркімнің өз уайымы бар.
Dialogue: 0,0:15:15.08,0:15:17.70,Default,,0,0,0,,Ауыр ма, жеңіл ме деп ойлаймын.
Dialogue: 0,0:15:20.08,0:15:23.04,Default,,0,0,0,,Осы жігітті өз орнымда бағып көрейін.
Dialogue: 0,0:15:23.13,0:15:25.63,Default,,0,0,0,,Өлсең де солай.
Dialogue: 0,0:15:28.21,0:15:29.84,Default,,0,0,0,,Itona қараңыз
Dialogue: 0,0:15:29.92,0:15:34.35,Default,,0,0,0,,Біздікіндей шағын зауытта да адал, адал еңбек етсек.
Dialogue: 0,0:15:34.43,0:15:37.56,Default,,0,0,0,,Кез келген ірі компаниямен бәсекеге түсе аласыз.
Dialogue: 0,0:15:38.39,0:15:41.52,Default,,0,0,0,,Бұл өтірік болды
Dialogue: 0,0:15:41.60,0:15:43.15,Default,,0,0,0,,Неге!
Dialogue: 0,0:15:43.23,0:15:46.77,Default,,0,0,0,,Менің технологиям туралы білетіндер, жұмысты тастасаңыз...
Dialogue: 0,0:15:47.57,0:15:50.24,Default,,0,0,0,,Оқу мен ықыластың мәні жоқ.
Dialogue: 0,0:15:50.32,0:15:53.86,Default,,0,0,0,,Өзінен асып түсетін басым күштің алдында,
Dialogue: 0,0:15:55.70,0:15:57.33,Default,,0,0,0,,Кешіріңіз, Итона.
Dialogue: 0,0:15:57.41,0:15:59.66,Default,,0,0,0,,Нағашыңның үйінде өзіңді күт.
Dialogue: 0,0:16:03.62,0:16:04.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:04.54,0:16:06.42,Default,,0,0,0,,Сіз ақыры ояндыңыз ба?
Dialogue: 0,0:16:06.50,0:16:08.88,Default,,0,0,0,,Ах... ах
Dialogue: 0,0:16:08.96,0:16:11.92,Default,,0,0,0,,Шатырға қарсы тордың ремейкі болып табылатын бандана
Dialogue: 0,0:16:12.01,0:16:13.34,Default,,0,0,0,,Бұл жай ғана жеңілдік.
Dialogue: 0,0:16:13.43,0:16:15.80,Default,,0,0,0,,Сіз шатырды шығара алмайсыз, солай ма? Мүмкін
Dialogue: 0,0:16:17.85,0:16:19.06,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:20.35,0:16:22.56,Default,,0,0,0,,Неліктен рамен?
Dialogue: 0,0:16:22.64,0:16:24.31,Default,,0,0,0,,Сіз аштыңыз ба?
Dialogue: 0,0:16:24.40,0:16:27.23,Default,,0,0,0,,Сіз оны жесеңіз, өзіңізді жақсы сезінбейсіз бе?
Dialogue: 0,0:16:27.31,0:16:28.98,Default,,0,0,0,,Тротуар тым кеңейіп кетті
Dialogue: 0,0:16:29.07,0:16:31.28,Default,,0,0,0,,Жаман емес пе? менің раменім
Dialogue: 0,0:16:31.36,0:16:34.20,Default,,0,0,0,,Әкеме қанша айтсам да рецептті жақсартпайды.
Dialogue: 0,0:16:34.28,0:16:37.20,Default,,0,0,0,,Бұл жаман және ескі.
Dialogue: 0,0:16:37.28,0:16:40.37,Default,,0,0,0,,Тауықтың сапасыз сүйектерін химиялық дәмдеуіштермен алдау
Dialogue: 0,0:16:40.45,0:16:44.16,Default,,0,0,0,,Наруто мақтанышпен үстіңгі тақтаның ортасына қойылды
Dialogue: 0,0:16:44.25,0:16:46.67,Default,,0,0,0,,Бұл төрт ұрпақ бұрынғы Шоуа рамені.
Dialogue: 0,0:16:46.75,0:16:48.88,Default,,0,0,0,,Бұл жігіт таң қаларлықтай біледі!
Dialogue: 0,0:16:48.96,0:16:50.50,Default,,0,0,0,,Осы сияқты дүкендер
Dialogue: 0,0:16:50.59,0:16:53.34,Default,,0,0,0,,Жақын жерде дүкен желісі ашылса да, ол тез тоқтап қалады.
Dialogue: 0,0:16:53.42,0:16:56.84,Default,,0,0,0,,Менің ата-анам оқып жатса да, сәтсіздікке ұшырады...
Dialogue: 0,0:16:58.39,0:17:01.14,Default,,0,0,0,,Олай болса, келесі жолы кездесуге келіңіз.
Dialogue: 0,0:17:01.22,0:17:03.39,Default,,0,0,0,,Рамен қазбаларының мұндай түрін салыстыруға болмайды.
Dialogue: 0,0:17:03.48,0:17:05.19,Default,,0,0,0,,Мен сендерге заманауи технологияны көрсетейін.
Dialogue: 0,0:17:05.27,0:17:06.23,Default,,0,0,0,,Нанду!
Dialogue: 0,0:17:10.36,0:17:11.78,Default,,0,0,0,,Не болды, Итона?
Dialogue: 0,0:17:11.86,0:17:13.86,Default,,0,0,0,,Барлық жағымсыз нәрселерді жою үшін жылдамдықты пайдаланыңыз!
Dialogue: 0,0:17:13.94,0:17:16.36,Default,,0,0,0,,Жарайды ма? Кіші мектеп оқушылары тегін
Dialogue: 0,0:17:16.45,0:17:18.32,Default,,0,0,0,,Ол Йошиданың үйінде.
Dialogue: 0,0:17:18.41,0:17:20.95,Default,,0,0,0,,Сіздің шиеленісіңіз көтерілді ме?
Dialogue: 0,0:17:21.03,0:17:22.08,Default,,0,0,0,,Жаман емес
Dialogue: 0,0:17:22.16,0:17:25.12,Default,,0,0,0,,Сәлем! Арнайы жоғары жылдамдықты тежегіш бұрылысы!
Dialogue: 0,0:17:26.87,0:17:27.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:27.79,0:17:30.00,Default,,0,0,0,,Идиот! Маған тез көмектес!
Dialogue: 0,0:17:30.09,0:17:32.34,Default,,0,0,0,,Егер бұл соққы сізді бақылаудан шығып кетсе, не істейсіз?
Dialogue: 0,0:17:32.42,0:17:34.67,Default,,0,0,0,,Жоқ, жоқ, бұл жақсы, солай ма?
Dialogue: 0,0:17:34.76,0:17:37.26,Default,,0,0,0,,Жоспарыңыз жоқ сияқты...
Dialogue: 0,0:17:37.34,0:17:39.01,Default,,0,0,0,,Иә
Dialogue: 0,0:17:39.09,0:17:42.35,Default,,0,0,0,,Олар негізінен ақымақ, сондықтан біз ештеңе істей алмаймыз.
Dialogue: 0,0:17:42.43,0:17:45.52,Default,,0,0,0,,Ах, бірақ Хазама мырза ақылды екен...
Dialogue: 0,0:17:45.60,0:17:48.48,Default,,0,0,0,,Сіз кек алғыңыз келеді, солай ма? Широның жігітіне
Dialogue: 0,0:17:48.56,0:17:52.40,Default,,0,0,0,,Шедевр кек романы «Граф Монте-Кристо»
Dialogue: 0,0:17:52.48,0:17:54.61,Default,,0,0,0,,үшін 7 том 2500 бет
Dialogue: 0,0:17:54.69,0:17:57.82,Default,,0,0,0,,Осыны оқып, қараңғы сезімдеріңізді күшейтіңіз.
Dialogue: 0,0:17:57.91,0:18:01.16,Default,,0,0,0,,Кек соңында тоқтайды, сондықтан оны оқудың қажеті жоқ.
Dialogue: 0,0:18:01.24,0:18:02.58,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:18:02.66,0:18:06.04,Default,,0,0,0,,Бұл қиын және қараңғы!
Dialogue: 0,0:18:06.12,0:18:09.29,Default,,0,0,0,,Не? Мен жүрегімдегі қараңғылықты сақтауым керек.
Dialogue: 0,0:18:09.37,0:18:12.50,Default,,0,0,0,,Кішкене көбірек алғыңыз келмейді ме? Ашулану оңай.
Dialogue: 0,0:18:12.59,0:18:15.01,Default,,0,0,0,,Өйткені бұл жігіт ақымақ көрінеді... уф!
Dialogue: 0,0:18:16.55,0:18:18.72,Default,,0,0,0,,Жоқ, мен әйтеуір дірілдеп тұрмын.
Dialogue: 0,0:18:18.80,0:18:21.43,Default,,0,0,0,,Терасака сені ақымақ десе, жынданып қалуың мүмкін.
Dialogue: 0,0:18:21.51,0:18:22.39,Default,,0,0,0,,Жоқ
Dialogue: 0,0:18:22.47,0:18:25.31,Default,,0,0,0,,Бұл шандырдың ұстамасы, қайтадан жабайы болып барады!
Dialogue: 0,0:18:25.39,0:18:26.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:26.64,0:18:29.65,Default,,0,0,0,,Қолымнан келгеннің бәрін жасап жатырмын, Мен сендерден ерекшемін.
Dialogue: 0,0:18:29.73,0:18:32.15,Default,,0,0,0,,Оны қазір өлтіріп, жеңіңіз!
Dialogue: 0,0:18:34.94,0:18:36.28,Default,,0,0,0,,Терасака!
Dialogue: 0,0:18:36.36,0:18:39.82,Default,,0,0,0,,Эй, Итона, мен де бұл туралы ойладым.
Dialogue: 0,0:18:39.91,0:18:43.12,Default,,0,0,0,,Сол сегізаяқты бүгін өлтірсем ғой.
Dialogue: 0,0:18:43.20,0:18:44.33,Default,,0,0,0,,Бірақ білесің бе—
Dialogue: 0,0:18:44.41,0:18:47.54,Default,,0,0,0,,Жарайды, мен оны қазір өлтіре алмаймын.
Dialogue: 0,0:18:47.62,0:18:50.71,Default,,0,0,0,,Ақылға қонымсыз көзқарасыңызды тастамаңыз.
Dialogue: 0,0:18:50.79,0:18:52.00,Default,,0,0,0,,Бұл оңайырақ болады.
Dialogue: 0,0:18:52.08,0:18:53.34,Default,,0,0,0,,Шулы!
Dialogue: 0,0:18:54.04,0:18:55.63,Default,,0,0,0,,- (Терасака) Уф - Ах...
Dialogue: 0,0:18:55.71,0:18:59.59,Default,,0,0,0,,Бұл менің екінші рет және мен әлсізмін, сондықтан оны ұстау оңайырақ.
Dialogue: 0,0:18:59.68,0:19:02.64,Default,,0,0,0,,Мен құсып кететін сияқтымын, ауырады.
Dialogue: 0,0:19:02.72,0:19:03.55,Default,,0,0,0,,Ха…
Dialogue: 0,0:19:03.64,0:19:06.85,Default,,0,0,0,,Құсқым келді ме, жоқ па, Мурамацудың раменін есіме түсірді.
Dialogue: 0,0:19:06.93,0:19:07.77,Default,,0,0,0,,Ан!?
Dialogue: 0,0:19:07.85,0:19:12.52,Default,,0,0,0,,Оны сол сегізаяқ бизнесті басқаруды оқуға шақырды.
Dialogue: 0,0:19:12.60,0:19:14.73,Default,,0,0,0,,Әзірге жаман рамен жақсы.
Dialogue: 0,0:19:14.82,0:19:16.82,Default,,0,0,0,,Егер мен дүкенді қолға алсам
Dialogue: 0,0:19:16.90,0:19:20.99,Default,,0,0,0,,Оны жаңа талғаммен және басқару дағдыларымен гүлдендіріңіз.
Dialogue: 0,0:19:21.07,0:19:23.62,Default,,0,0,0,,Йошидаға да дәл осылай айтылған.
Dialogue: 0,0:19:23.70,0:19:26.45,Default,,0,0,0,,Бұл бір күні пайдалы болуы мүмкін
Dialogue: 0,0:19:26.54,0:19:28.70,Default,,0,0,0,,Сәлем Итона
Dialogue: 0,0:19:28.79,0:19:32.12,Default,,0,0,0,,Бір-екі рет жеңілдім деп ренжіме!
Dialogue: 0,0:19:32.21,0:19:34.17,Default,,0,0,0,,Бір күні жеңіске жетсек жақсы емес пе?
Dialogue: 0,0:19:34.25,0:19:38.84,Default,,0,0,0,,Мен қазір ол сегізаяқты өлтіре алмасам, бәрібір.
Dialogue: 0,0:19:38.92,0:19:41.18,Default,,0,0,0,,100 рет сәтсіздікке ұшыраған дұрыс
Dialogue: 0,0:19:41.26,0:19:46.10,Default,,0,0,0,,Наурызға дейін оны бір-ақ рет өлтірсек, жеңеміз.
Dialogue: 0,0:19:46.18,0:19:51.14,Default,,0,0,0,,Ата-анамның фабрикасы ше? Менің ойымша, мен оны ақшалай сыйлыққа сатып аламын деп ойлаймын.
Dialogue: 0,0:19:51.23,0:19:53.06,Default,,0,0,0,,Сонда ата-ана да қайтады.
Dialogue: 0,0:19:53.90,0:19:55.65,Default,,0,0,0,,Төзгісіз
Dialogue: 0,0:19:55.73,0:20:00.15,Default,,0,0,0,,Менің келесі жеңісім туралы көзқарас пайда болғанша не істеуім керек?
Dialogue: 0,0:20:00.24,0:20:01.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:01.15,0:20:04.20,Default,,0,0,0,,Қарашы, мен күнімді ақымақтықпен өткіземін.
Dialogue: 0,0:20:04.28,0:20:06.53,Default,,0,0,0,,Менің ойымша, біз осындамыз.
Dialogue: 0,0:20:06.62,0:20:08.24,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:20:08.33,0:20:12.29,Default,,0,0,0,,Анау ақымақ, мұндай кездейсоқ нәрселерді еш ойланбастан айтады.
Dialogue: 0,0:20:12.37,0:20:13.21,Default,,0,0,0,,Бірақ
Dialogue: 0,0:20:14.12,0:20:17.54,Default,,0,0,0,,Мұндай жағдайда ақымақ сөз демалуға көмектеспейді.
Dialogue: 0,0:20:19.59,0:20:23.30,Default,,0,0,0,,Мен асығыс болдым ба?
Dialogue: 0,0:20:23.38,0:20:24.47,Default,,0,0,0,,О
Dialogue: 0,0:20:24.55,0:20:25.93,Default,,0,0,0,,​​Мен солай ойлаймын.
Dialogue: 0,0:20:26.01,0:20:29.64,Default,,0,0,0,,Сенің көзіңнен қосымшаның түсі жоғалып кетті, Итона-кун.
Dialogue: 0,0:20:29.72,0:20:33.85,Default,,0,0,0,,Енді мен сені қинап жатқан тентек жасушаларынан құтыла аламын.
Dialogue: 0,0:20:33.94,0:20:38.82,Default,,0,0,0,,Бір ұлы күштен айырылудың орнына сіз көптеген одақтастар аласыз.
Dialogue: 0,0:20:38.90,0:20:42.57,Default,,0,0,0,,Сен мені өлтіруге келе жатырсың, солай емес пе? Өйткені ертең
Dialogue: 0,0:20:43.82,0:20:45.03,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,0:20:45.11,0:20:49.70,Default,,0,0,0,,Мен бұл күш пен ағалық жағдайдан шаршадым.
Dialogue: 0,0:20:51.79,0:20:53.46,Default,,0,0,0,,Эй, сен осындасың ба?
Dialogue: 0,0:20:53.54,0:20:55.79,Default,,0,0,0,,Енді кіру үшін қабырғаны бұзудың қажеті жоқ.
Dialogue: 0,0:20:55.87,0:20:59.00,Default,,0,0,0,,Қайырлы таң~ Мына бандана сізге жарасады.
Dialogue: 0,0:20:59.09,0:21:01.21,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:21:01.30,0:21:02.42,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:21:02.51,0:21:06.13,Default,,0,0,0,,Бұл ең сорақысы, өйткені мен күшімді жоғалттым.
Dialogue: 0,0:21:06.22,0:21:09.39,Default,,0,0,0,,Бірақ мен өзімді әлсірегендей сезінбеймін.
Dialogue: 0,0:21:09.47,0:21:12.60,Default,,0,0,0,,Мен сені ақырында міндетті түрде өлтіремін, Коро-сенсэй.
Dialogue: 0,0:21:12.68,0:21:13.64,Default,,0,0,0,,Нюфху
Dialogue: 0,0:21:13.73,0:21:15.77,Default,,0,0,0,,Проблемалық бала Хорибе Итонари
Dialogue: 0,0:21:15.85,0:21:18.23,Default,,0,0,0,,Енді сіз біздің сыныпқа қосылдыңыз.
Dialogue: 0,0:21:18.31,0:21:21.02,Default,,0,0,0,,Ой Мурамацудың ақшасы жоқ
Dialogue: 0,0:21:21.11,0:21:23.07,Default,,0,0,0,,Мен құсудан бас тартамын, сондықтан рамен жеуге рұқсат етіңіз.
Dialogue: 0,0:21:23.15,0:21:24.07,Default,,0,0,0,,Ах!?
Dialogue: 0,0:21:24.15,0:21:25.99,Default,,0,0,0,,Айтпақшы, бұл Терасака тобы.
Dialogue: 0,0:21:26.07,0:21:31.08,Default,,0,0,0,,♪～
Dialogue: 0,0:22:50.03,0:22:55.04,Default,,0,0,0,,～♪
