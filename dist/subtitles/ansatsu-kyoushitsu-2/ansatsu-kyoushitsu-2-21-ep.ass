Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.41,0:00:03.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:05.75,0:00:09.13,Default,,0,0,0,,Уф... өттім~
Dialogue: 0,0:00:09.92,0:00:13.59,Default,,0,0,0,,Ақыры үлкен таудан өттік.
Dialogue: 0,0:00:13.68,0:00:16.55,Default,,0,0,0,,үшін екінші таңдауда өтті!
Dialogue: 0,0:00:16.64,0:00:18.56,Default,,0,0,0,,Неге… неге мен
Dialogue: 0,0:00:18.64,0:00:21.52,Default,,0,0,0,,Сіз оны екінші жүзбен ғана аяқтадыңыз.
Dialogue: 0,0:00:21.60,0:00:25.44,Default,,0,0,0,,Әркім, бәрі де жарық жұлдыздай орта мектепке барады.
Dialogue: 0,0:00:25.52,0:00:27.77,Default,,0,0,0,,Ұстаз ретінде иығымнан ауыр жүк көтерілді.
Dialogue: 0,0:00:27.86,0:00:31.32,Default,,0,0,0,,Мен бастапқыда осыдан кейін мансап бойынша кеңес алуды жоспарлаған болатынмын.
Dialogue: 0,0:00:31.40,0:00:34.28,Default,,0,0,0,,Бұған дейін, профессор, мен бір істегім келеді.
Dialogue: 0,0:00:34.36,0:00:38.83,Default,,0,0,0,,Осы сәтті күні не істеу керек?
Dialogue: 0,0:00:39.62,0:00:41.16,Default,,0,0,0,,Өңдеу жұмысы
Dialogue: 0,0:00:41.24,0:00:42.20,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:00:42.29,0:00:45.25,Default,,0,0,0,,Әрине! Мен бітіру альбомын жасап жатырмын
Dialogue: 0,0:00:45.33,0:00:47.92,Default,,0,0,0,,Тек осы E тобы үшін!
Dialogue: 0,0:00:48.00,0:00:53.01,Default,,0,0,0,,♪～
Dialogue: 0,0:02:12.67,0:02:17.92,Default,,0,0,0,,～♪
Dialogue: 0,0:02:21.97,0:02:25.31,Default,,0,0,0,,- (Нагиса) Бітіру альбомын жасау... - (Коро-сенсэй) Иә!
Dialogue: 0,0:02:25.39,0:02:26.68,Default,,0,0,0,,(Изуку) Эндеворға келгенде сен сәл қаталсың ғой, Тодороки?
Dialogue: 0,0:02:26.77,0:02:29.35,Default,,0,0,0,,Мен бүкіл мектеп үшін біреуін жасадым.
Dialogue: 0,0:02:29.44,0:02:31.73,Default,,0,0,0,,Қарасума мырза менің сынып жетекшім.
Dialogue: 0,0:02:31.81,0:02:34.52,Default,,0,0,0,,Коро-сенсэйдің ешбір фотосуретте жоқтығының себебі сол
Dialogue: 0,0:02:34.61,0:02:35.65,Default,,0,0,0,,Мен сені аяймын.
Dialogue: 0,0:02:35.73,0:02:36.65,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:02:36.73,0:02:39.65,Default,,0,0,0,,Ол фотосуретте Mach жылдамдығымен көрінеді.
Dialogue: 0,0:02:39.74,0:02:40.78,Default,,0,0,0,,Ол ашылмайтын дәрежеде
Dialogue: 0,0:02:40.86,0:02:42.87,Default,,0,0,0,,Бұл елес фото...
Dialogue: 0,0:02:42.95,0:02:43.91,Default,,0,0,0,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,0:02:43.99,0:02:46.83,Default,,0,0,0,,Сондықтан мен бұл фотоны дұрыс пайдаланғым келеді.
Dialogue: 0,0:02:46.91,0:02:49.83,Default,,0,0,0,,Анау-мынаны пайдалану үшін бір жыл қажет болды.
Dialogue: 0,0:02:49.91,0:02:52.17,Default,,0,0,0,,үшінмен құнды селфи
Dialogue: 0,0:02:52.25,0:02:53.71,Default,,0,0,0,,30 000 дана!
Dialogue: 0,0:02:53.79,0:02:57.09,Default,,0,0,0,,Осылардың арасынан бәріміз есте қалатын ең жақсы суретті таңдап алайық
Dialogue: 0,0:02:57.17,0:02:58.46,Default,,0,0,0,,Қашан солай болды...
Dialogue: 0,0:02:58.55,0:03:00.26,Default,,0,0,0,,Пеп мұғалімнен күткендей
Dialogue: 0,0:03:00.34,0:03:04.10,Default,,0,0,0,,Мен өзімнің фотоларымды көргім келмейді.
Dialogue: 0,0:03:04.18,0:03:05.10,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:03:05.18,0:03:06.60,Default,,0,0,0,,Көздер кішкентай
Dialogue: 0,0:03:06.68,0:03:08.31,Default,,0,0,0,,- (Коро-сенсэй) Уайымдама - (Накамура) А?
Dialogue: 0,0:03:08.39,0:03:09.23,Default,,0,0,0,,Көздер ашылады
Dialogue: 0,0:03:09.31,0:03:11.60,Default,,0,0,0,,Өңделген нұсқасы да қол жетімді
Dialogue: 0,0:03:11.69,0:03:13.86,Default,,0,0,0,,Сіз әдеттегідей жомартсыз...
Dialogue: 0,0:03:13.94,0:03:17.73,Default,,0,0,0,,Кәдімгі альбом жеткілікті екені рас.
Dialogue: 0,0:03:17.82,0:03:21.11,Default,,0,0,0,,Егер сіз басқа кітап шығаратын болсаңыз, онда таңғаларлық фотолар болады ма?
Dialogue: 0,0:03:21.20,0:03:22.99,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:03:23.07,0:03:26.12,Default,,0,0,0,,Үй жануарлары дүкеніндегі салқын сұлулық Хайами
Dialogue: 0,0:03:26.20,0:03:27.49,Default,,0,0,0,,Және бұл
Dialogue: 0,0:03:27.58,0:03:30.21,Default,,0,0,0,,Ауа гитара Мимура Түнде мектеп ғимаратынан
Dialogue: 0,0:03:30.29,0:03:32.67,Default,,0,0,0,,... болды ма? Артында...
Dialogue: 0,0:03:32.75,0:03:34.75,Default,,0,0,0,,Тағы да бар!
Dialogue: 0,0:03:34.83,0:03:38.50,Default,,0,0,0,,Катаока ханшайым тек ханшайым стиліндегі киімдерді киіп көреді
Dialogue: 0,0:03:38.59,0:03:41.97,Default,,0,0,0,,Қыз Мурамацу осы кезде тарақан шықты
Dialogue: 0,0:03:42.05,0:03:45.93,Default,,0,0,0,,Түнде мектеп ауласында жалаңаш жүгіру Жалаңаш Окадзима
Dialogue: 0,0:03:46.01,0:03:47.64,Default,,0,0,0,,Эй, сәл күте тұрыңыз!
Dialogue: 0,0:03:47.72,0:03:49.02,Default,,0,0,0,,Мүмкін олардың кейбіреулері
Dialogue: 0,0:03:49.10,0:03:51.73,Default,,0,0,0,,Менің суретім шынымен нашар емес пе?
Dialogue: 0,0:03:51.81,0:03:54.02,Default,,0,0,0,,Бұдан артық нәрсе бар ма?
Dialogue: 0,0:03:54.69,0:03:57.40,Default,,0,0,0,,Өзіңізді табыңыз! Оны жинап, тастаңыз!
Dialogue: 0,0:03:57.48,0:03:58.48,Default,,0,0,0,,О, ау
Dialogue: 0,0:03:58.57,0:04:01.19,Default,,0,0,0,,Өңдеу процесі мені қатты қызықтырады.
Dialogue: 0,0:04:01.28,0:04:02.24,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:04:03.11,0:04:04.07,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:04:04.82,0:04:05.74,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:04:07.08,0:04:08.08,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:04:08.87,0:04:09.79,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:04:10.62,0:04:11.62,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:04:13.62,0:04:14.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:14.58,0:04:17.21,Default,,0,0,0,,Осыншама көп алынғанын білмедім...
Dialogue: 0,0:04:17.29,0:04:20.55,Default,,0,0,0,,Енді мектептегі оқиғалардан фотосуреттерді таңдау уақыты келді.
Dialogue: 0,0:04:20.63,0:04:22.42,Default,,0,0,0,,Эй, мыналар ше?
Dialogue: 0,0:04:22.51,0:04:23.51,Default,,0,0,0,,Сәлем бәріңе!
Dialogue: 0,0:04:23.59,0:04:24.43,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:04:24.51,0:04:28.89,Default,,0,0,0,,Мен енді ешқашан қайталанбайтын ерекше жылды өткіздім...
Dialogue: 0,0:04:28.97,0:04:32.06,Default,,0,0,0,,О, бірақ! Мен түсірген фотосуреттер саны жеткіліксіз
Dialogue: 0,0:04:32.14,0:04:34.44,Default,,0,0,0,,Менің мақсатым - 10 000 беттік кітапты аяқтау.
Dialogue: 0,0:04:34.52,0:04:36.31,Default,,0,0,0,,Біз заттарды көбірек бөлшектеп жатырмыз.
Dialogue: 0,0:04:36.40,0:04:38.86,Default,,0,0,0,,Тіпті Кожиеннің өзінде 3000 бет бар.
Dialogue: 0,0:04:38.94,0:04:40.53,Default,,0,0,0,,Сыртқа шығыңыз!
Dialogue: 0,0:04:40.61,0:04:43.44,Default,,0,0,0,,Киіміңізді өзгерту арқылы фотосуреттеріңіздің енін үлкейтіңіз
Dialogue: 0,0:04:43.53,0:04:45.20,Default,,0,0,0,,Жақсы~
Dialogue: 0,0:04:45.28,0:04:46.95,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:04:47.03,0:04:49.20,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:04:49.28,0:04:51.79,Default,,0,0,0,,Киім ауыстырып, суретке түсейік~
Dialogue: 0,0:04:51.87,0:04:54.33,Default,,0,0,0,,А... Коросей осы ақпанда
Dialogue: 0,0:04:54.41,0:04:57.21,Default,,0,0,0,,Әрине, емтихан тапсыру сияқты істерге көмектесті.
Dialogue: 0,0:04:57.29,0:04:59.88,Default,,0,0,0,,Жалпы, сіз өзіңіз қалаған нәрсені жасадыңыз.
Dialogue: 0,0:04:59.96,0:05:00.92,Default,,0,0,0,,Иә
Dialogue: 0,0:05:01.00,0:05:03.26,Default,,0,0,0,,Бізді үнемі лақтырып жіберетін.
Dialogue: 0,0:05:03.34,0:05:05.51,Default,,0,0,0,,Бәлкім, оны сендер бұзып жүрген шығарсыңдар.
Dialogue: 0,0:05:06.22,0:05:10.60,Default,,0,0,0,,Қаңтар айына дейінгі сабақтар арқылы сендер жеткілікті дәрежеде өстіңдер.
Dialogue: 0,0:05:10.68,0:05:15.18,Default,,0,0,0,,Енді толыққанды студент атанған студенттерге аздап еркелеткім келеді...
Dialogue: 0,0:05:15.27,0:05:17.48,Default,,0,0,0,,Мүмкін сіз солай ойлайсыз.
Dialogue: 0,0:05:17.56,0:05:18.52,Default,,0,0,0,,Демек, шынымен де мұнда жартылай жұмыс істеуді бастапсың ғой.
Dialogue: 0,0:05:18.60,0:05:20.40,Default,,0,0,0,,Қарасума мырзаға да
Dialogue: 0,0:05:20.48,0:05:22.98,Default,,0,0,0,,Біз осындай студент бола аламыз ба?
Dialogue: 0,0:05:23.69,0:05:24.99,Default,,0,0,0,,О
Dialogue: 0,0:05:25.07,0:05:30.87,Default,,0,0,0,,Қиындыққа тап болсам, ойланбастан саған сеніп, өзіңе тапсырар едім.
Dialogue: 0,0:05:30.95,0:05:37.46,Default,,0,0,0,,Сәуірден бері әйел мен еркек бірге тұрады... Сәуірден бері...
Dialogue: 0,0:05:37.54,0:05:39.67,Default,,0,0,0,,- (Ирина) Күніне 10 оқ - (Қарасұма) Арғх!
Dialogue: 0,0:05:39.75,0:05:42.34,Default,,0,0,0,,Мен соңғы кездері неге ызылдап жүрмін деп ойлаймын...
Dialogue: 0,0:05:42.42,0:05:44.59,Default,,0,0,0,,Менің ойымша, бұл дінге байланысты.
Dialogue: 0,0:05:45.13,0:05:45.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:46.05,0:05:48.22,Default,,0,0,0,,Зуко!
Dialogue: 0,0:05:48.30,0:05:50.30,Default,,0,0,0,,- (Қарасума) Бұл не... - (Коро-сенсэй) Кукукукукуку...
Dialogue: 0,0:05:50.39,0:05:53.47,Default,,0,0,0,,Карасума-сенсей де барлығына сәйкес келетін косплей жасауы керек.
Dialogue: 0,0:05:50.39,0:05:53.47,Default,,0,0,0,,Ху~ху~
Dialogue: 0,0:05:53.56,0:05:55.68,Default,,0,0,0,,Менің ойымша, оны «сынап көру» деп атаған жөн.
Dialogue: 0,0:05:55.77,0:05:58.35,Default,,0,0,0,,Қарасуманың бірінші түні, күту жоқ
Dialogue: 0,0:05:58.44,0:05:59.65,Default,,0,0,0,,Шулы!
Dialogue: 0,0:05:59.73,0:06:00.98,Default,,0,0,0,,Жарайды, бірде бірге шай ішуге баруымыз керек қой?
Dialogue: 0,0:06:01.06,0:06:04.61,Default,,0,0,0,,Мектеп ауласының суреттері жеткілікті.
Dialogue: 0,0:06:05.28,0:06:06.40,Default,,0,0,0,,Бір сәт!
Dialogue: 0,0:06:06.49,0:06:09.36,Default,,0,0,0,,Жетер болса, не үшін қапшықтарға тығылып қалдық!
Dialogue: 0,0:06:09.45,0:06:10.78,Default,,0,0,0,,Тек осы мектеп ғимаратында
Dialogue: 0,0:06:10.87,0:06:12.12,Default,,0,0,0,,Өте жеткіліксіз
Dialogue: 0,0:06:12.20,0:06:14.83,Default,,0,0,0,,Мен сенімен бүкіл әлем бойынша суретке түсемін.
Dialogue: 0,0:06:14.91,0:06:16.70,Default,,0,0,0,,- (Терасака) Қазірден бастап!? - (Окадзима) Сіз қалжыңдап тұрсыз!
Dialogue: 0,0:06:16.79,0:06:17.96,Default,,0,0,0,,Неге сонша?
Dialogue: 0,0:06:18.04,0:06:21.25,Default,,0,0,0,,Нуруфуфуфу Бұл көңілді болғандықтан.
Dialogue: 0,0:06:21.33,0:06:24.71,Default,,0,0,0,,Бұл қызықты болғандықтан, бірдеңе ойлап табу үшін уақыт пен күш жұмсаңыз.
Dialogue: 0,0:06:24.80,0:06:27.13,Default,,0,0,0,,Мен онымен мүмкіндігімше жұмыс істей аламын.
Dialogue: 0,0:06:27.22,0:06:29.05,Default,,0,0,0,,Кеттік~
Dialogue: 0,0:06:29.13,0:06:32.76,Default,,0,0,0,,Гому Гому ~ Пачинко!
Dialogue: 0,0:06:32.85,0:06:33.68,Default,,0,0,0,,(Оқушылар айқайлайды)
Dialogue: 0,0:06:48.57,0:06:50.32,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:50.91,0:06:53.28,Default,,0,0,0,,Бұл сынақ өту баллы болса ше?
Dialogue: 0,0:06:53.37,0:06:57.75,Default,,0,0,0,,Иә, бұл мектепке сеніммен оралуға мүмкіндік беретін академиялық қабілет.
Dialogue: 0,0:06:57.83,0:07:02.58,Default,,0,0,0,,Негізі бірінші семестрде оқу туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:07:02.67,0:07:05.63,Default,,0,0,0,,Сіз жаңа сыныпқа көп уақытпен бейімделе аласыз.
Dialogue: 0,0:07:05.71,0:07:06.88,Default,,0,0,0,,Иә
Dialogue: 0,0:07:09.01,0:07:11.80,Default,,0,0,0,,Бұл біткенде, мен мектепке қайта барамын.
Dialogue: 0,0:07:11.88,0:07:14.35,Default,,0,0,0,,Бұл біткенде, мен мектепке қайта барамын.
Dialogue: 0,0:07:14.43,0:07:15.93,Default,,0,0,0,,Бұл аяқталған кезде...
Dialogue: 0,0:07:16.01,0:07:17.22,Default,,0,0,0,,Ғылым…
Dialogue: 0,0:07:18.22,0:07:18.81,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:07:18.81,0:07:20.27,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:07:18.81,0:07:20.27,Default,,0,0,0,,Мектеп…
Dialogue: 0,0:07:20.27,0:07:21.10,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:07:21.19,0:07:22.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:24.61,0:07:27.23,Default,,0,0,0,,Және қалағаныңа қол жеткізе алмасаң—
Dialogue: 0,0:07:29.03,0:07:29.90,Default,,0,0,0,,Менің жүзім...
Dialogue: 0,0:07:29.99,0:07:31.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:32.86,0:07:36.74,Default,,0,0,0,,Ол кісі өлтіру үшін қолданылғанда ең күшті.
Dialogue: 0,0:07:37.54,0:07:38.58,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:07:39.16,0:07:40.33,Default,,0,0,0,,Нагиса?
Dialogue: 0,0:07:41.25,0:07:44.33,Default,,0,0,0,,Жарайды, тыныштал.
Dialogue: 0,0:07:44.42,0:07:46.17,Default,,0,0,0,,Егер сіз тырыссаңыз, сіз жасай аласыз.
Dialogue: 0,0:07:47.00,0:07:48.25,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:07:49.59,0:07:50.63,Default,,0,0,0,,Өзінің өліміне әкелсе де.
Dialogue: 0,0:07:51.84,0:07:56.47,Default,,0,0,0,,Пышақты пайдалану тәсілі әртүрлі, бірақ егер сіз осындай бетті көрсеңіз...
Dialogue: 0,0:07:59.22,0:08:00.06,Default,,0,0,0,,♪ Ка-та-на
Dialogue: 0,0:08:00.73,0:08:04.94,Default,,0,0,0,,Сіз өзіңіз болғыңыз келетін нәрсені таптыңыз ба? Нагиса-кун
Dialogue: 0,0:08:06.77,0:08:08.15,Default,,0,0,0,,Коросей
Dialogue: 0,0:08:09.32,0:08:11.36,Default,,0,0,0,,Мен мұғалім боламын
Dialogue: 0,0:08:11.94,0:08:15.20,Default,,0,0,0,,Ол Коросей сияқты жылдам емес.
Dialogue: 0,0:08:15.74,0:08:18.66,Default,,0,0,0,,Ол Короссей сияқты жеңілмейтін емес.
Dialogue: 0,0:08:18.74,0:08:21.33,Default,,0,0,0,,Короссей сияқты ақылды емес
Dialogue: 0,0:08:22.21,0:08:25.96,Default,,0,0,0,,Бірақ Коро-сенсэй сияқты мұғалім...
Dialogue: 0,0:08:26.67,0:08:28.00,Default,,0,0,0,,(дұрыс дыбыс)
Dialogue: 0,0:08:28.09,0:08:31.05,Default,,0,0,0,,Бұл жақсы, бұл сізге сәйкес келеді.
Dialogue: 0,0:08:32.01,0:08:37.30,Default,,0,0,0,,Сіздердің бәріңіз бірдей дарындысыздар және бәріңізде бірдей таланттар бар, олардан бәріңіз бірдей жоғалтасыз.
Dialogue: 0,0:08:37.39,0:08:39.64,Default,,0,0,0,,Бұл жастық шақ
Dialogue: 0,0:08:40.31,0:08:42.98,Default,,0,0,0,,Жастың таланты қашқанша
Dialogue: 0,0:08:43.06,0:08:46.40,Default,,0,0,0,,Тоқтамаңыз, тек алға жүзіңіз
Dialogue: 0,0:08:46.48,0:08:48.19,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:48.27,0:08:50.52,Default,,0,0,0,,Короссей Ертең кездескенше!
Dialogue: 0,0:08:50.61,0:08:53.15,Default,,0,0,0,,Иә, ертең кездескенше (есік жабылған дыбыс)
Dialogue: 0,0:08:56.74,0:09:00.12,Default,,0,0,0,,Бүгін барлығы бітті ме? Мансап бойынша кеңес беру
Dialogue: 0,0:09:00.20,0:09:01.29,Default,,0,0,0,,Иә
Dialogue: 0,0:09:01.37,0:09:04.25,Default,,0,0,0,,үшінңыз мені қатты таң қалдырасыз.
Dialogue: 0,0:09:04.33,0:09:08.21,Default,,0,0,0,,Жалғыз басты жұмыс - бітіру альбомын өңдеу.
Dialogue: 0,0:09:08.29,0:09:11.13,Default,,0,0,0,,Сіз мектепте біраз уақыт ұйықтайсыз.
Dialogue: 0,0:09:11.21,0:09:12.05,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:12.13,0:09:14.38,Default,,0,0,0,,Ирина-сенсей екеуіңнің қарым-қатынасының дамуы.
Dialogue: 0,0:09:14.47,0:09:15.93,Default,,0,0,0,,Мақала ретінде жариялануы керек
Dialogue: 0,0:09:16.01,0:09:18.55,Default,,0,0,0,,Осыдан кейін біз шамамен 5 сағатқа созамыз.
Dialogue: 0,0:09:18.64,0:09:21.06,Default,,0,0,0,,Келесіз бе! үйге бар
Dialogue: 0,0:09:24.23,0:09:25.14,Default,,0,0,0,,Жаңа ма?
Dialogue: 0,0:09:26.77,0:09:29.23,Default,,0,0,0,,Оны білім беру үшін жақсы альбом жасаңыз.
Dialogue: 0,0:09:30.02,0:09:33.44,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:09:34.74,0:09:36.49,Default,,0,0,0,,Шындықпен мойындайық
Dialogue: 0,0:09:37.07,0:09:41.16,Default,,0,0,0,,Сіз өзіңіз құрған осы сыныпта қанша білім алдыңыз?
Dialogue: 0,0:09:41.91,0:09:43.37,Default,,0,0,0,,Студенттер де
Dialogue: 0,0:09:44.12,0:09:45.12,Default,,0,0,0,,Биыл ғана дебют жасаған –
Dialogue: 0,0:09:47.42,0:09:50.25,Default,,0,0,0,,(телефонның қоңырау үні)
Dialogue: 0,0:09:50.33,0:09:52.04,Default,,0,0,0,,Есеп
Dialogue: 0,0:09:52.13,0:09:54.84,Default,,0,0,0,,Ол қазір сыныпта жалғыз.
Dialogue: 0,0:09:54.92,0:09:57.43,Default,,0,0,0,,Бұдан кейін қозғалыс болмайды.
Dialogue: 0,0:09:58.09,0:10:00.09,Default,,0,0,0,,Ерен еңбегіңіз үшін рахмет, Арнайы агент Карасума.
Dialogue: 0,0:10:00.18,0:10:01.26,Default,,0,0,0,,(Қоңырауды ажырату дыбысы)
Dialogue: 0,0:10:01.35,0:10:03.14,Default,,0,0,0,,Сіз естігендей.
Dialogue: 0,0:10:03.22,0:10:04.97,Default,,0,0,0,,6 наурыз
Dialogue: 0,0:10:05.06,0:10:10.15,Default,,0,0,0,,Соңғы қастандық жоспарланғандай бүгін түнде іске қосылады.
Dialogue: 0,0:11:10.92,0:11:13.46,Default,,0,0,0,,Бірінші оқ бүкіл мектеп ғимаратына тиді!
Dialogue: 0,0:11:13.54,0:11:15.42,Default,,0,0,0,,- (Қызметкерлер) Ол ше? -(Қызметкерлер) Қазір іздеуде.
Dialogue: 0,0:11:15.50,0:11:19.97,Default,,0,0,0,,Сіз қалай ойлайсыз? Оның айналасында бірде-бір сызат жоқ, солай ма?
Dialogue: 0,0:11:20.05,0:11:23.47,Default,,0,0,0,,Бұл лазерлік спутникке енетін шандырға қарсы тіршілік иесі
Dialogue: 0,0:11:23.55,0:11:25.26,Default,,0,0,0,,«Аспан найзасы» деп аталады
Dialogue: 0,0:11:25.35,0:11:29.77,Default,,0,0,0,,Энергия көзі ретінде тасбақа негізіндегі антиматериялық тіршілік иелері
Dialogue: 0,0:11:29.85,0:11:32.65,Default,,0,0,0,,Үлкен бөлшектердің үдеткішімен одан әрі күшейту
Dialogue: 0,0:11:32.73,0:11:35.36,Default,,0,0,0,,Лазерді 400 км биіктіктен ату
Dialogue: 0,0:11:35.44,0:11:39.03,Default,,0,0,0,,Бұл лазер барлық кедергілерден өте алады.
Dialogue: 0,0:11:39.11,0:11:41.95,Default,,0,0,0,,Тек шатырлы тіршілік иелерін ерітеді
Dialogue: 0,0:11:42.03,0:11:45.03,Default,,0,0,0,,Ешқандай ескертусіз атылды.
Dialogue: 0,0:11:45.12,0:11:47.41,Default,,0,0,0,,Тіпті кішкентай жігіт...
Dialogue: 0,0:11:49.70,0:11:51.58,Default,,0,0,0,,Жаңа...
Dialogue: 0,0:11:51.66,0:11:55.54,Default,,0,0,0,,Төбесі мен киімдері қауіпсіз, бірақ тек шатырлар!
Dialogue: 0,0:11:55.63,0:11:57.17,Default,,0,0,0,,Уау...
Dialogue: 0,0:11:57.25,0:11:59.88,Default,,0,0,0,,Әй... Сене алар емеспін.
Dialogue: 0,0:11:59.96,0:12:01.26,Default,,0,0,0,,Одан құтылу керек пе?
Dialogue: 0,0:12:01.34,0:12:02.80,Default,,0,0,0,,Бұл жарық жылдамдығымен лазер!
Dialogue: 0,0:12:02.88,0:12:04.84,Default,,0,0,0,,Қандай өткір интуиция!
Dialogue: 0,0:12:05.51,0:12:08.18,Default,,0,0,0,,Бірақ бұл соңы емес.
Dialogue: 0,0:12:10.43,0:12:15.77,Default,,0,0,0,,Сіз құтқарылдыңыз, сондықтан қашып көріңіз, супер жаратылыс.
Dialogue: 0,0:12:16.77,0:12:18.65,Default,,0,0,0,,Мен қашып кеткен жер
Dialogue: 0,0:12:20.28,0:12:23.45,Default,,0,0,0,,Жұмыс істеп тұрған тағы бір қару
Dialogue: 0,0:12:36.13,0:12:38.13,Default,,0,0,0,,Жаңа О!
Dialogue: 0,0:12:39.38,0:12:43.09,Default,,0,0,0,,Шатырға қарсы мөлдір лазерлік тосқауыл
Dialogue: 0,0:12:43.17,0:12:46.18,Default,,0,0,0,,Жалпы атау «Жер қалқаны»
Dialogue: 0,0:12:46.26,0:12:49.72,Default,,0,0,0,,Жасырын жердегі қондырғылар тобының фокустық лазерлері.
Dialogue: 0,0:12:50.43,0:12:53.14,Default,,0,0,0,,Бүкіл тауды қамтитын бөгет жасайды
Dialogue: 0,0:12:53.23,0:12:56.10,Default,,0,0,0,,(Тікұшақтың ұшу дыбысы)
Dialogue: 0,0:12:56.19,0:12:57.86,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:59.44,0:13:00.27,Default,,0,0,0,,Жаңа!
Dialogue: 0,0:13:00.36,0:13:02.74,Default,,0,0,0,,Нөлдік құтылу жоқ.
Dialogue: 0,0:13:02.82,0:13:05.82,Default,,0,0,0,,Лазерлер жер астына енеді
Dialogue: 0,0:13:05.91,0:13:09.70,Default,,0,0,0,,Өлтірмеу үшін емес, қашып кетпеу үшін бұл жарық торы.
Dialogue: 0,0:13:10.49,0:13:13.20,Default,,0,0,0,,Мүмкін болса, мен оны бірінші атумен аяқтағым келді.
Dialogue: 0,0:13:13.29,0:13:18.17,Default,,0,0,0,,Осыдан кейін В жоспары үлкен шу тудырады.
Dialogue: 0,0:13:18.25,0:13:21.84,Default,,0,0,0,,В1 жағдайында құрлықтағы күштерді төтенше жағдайда орналастыру!
Dialogue: 0,0:13:21.92,0:13:22.76,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:24.55,0:13:28.14,Default,,0,0,0,,Не? Сол жарық...
Dialogue: 0,0:13:29.47,0:13:31.14,Default,,0,0,0,,Біз аңғал болдық.
Dialogue: 0,0:13:31.97,0:13:35.35,Default,,0,0,0,,Оқиғасыз аяқталуы мүмкін деп ойладым.
Dialogue: 0,0:13:35.43,0:13:38.19,Default,,0,0,0,,үшін дайындалды.
Dialogue: 0,0:13:38.27,0:13:43.65,Default,,0,0,0,,Біз білмейтін жерде бұл керемет... ұқыпты.
Dialogue: 0,0:13:43.73,0:13:47.99,Default,,0,0,0,,А, бұл бізге зиян тигізуі мүмкін қауіпті тіршілік иесі.
Dialogue: 0,0:13:48.07,0:13:49.95,Default,,0,0,0,,Бұл қамауға алуға арналған.
Dialogue: 0,0:13:50.03,0:13:53.66,Default,,0,0,0,,Бұл «Жер қалқаны» салдарынан қашу мүмкіндігін жоғалтқан тіршілік иесі.
Dialogue: 0,0:13:53.74,0:13:55.87,Default,,0,0,0,,1 жыл бұрын Ай жойылды—
Dialogue: 0,0:13:55.96,0:13:57.96,Default,,0,0,0,,Бұл кінәлі.
Dialogue: 0,0:13:58.04,0:14:01.25,Default,,0,0,0,,Бұл жаратылыс бүгінгі күнге дейін жарияланбады.
Dialogue: 0,0:14:01.34,0:14:04.34,Default,,0,0,0,,А, жоқ... «құбыжық» деп айту керек пе?
Dialogue: 0,0:14:05.17,0:14:10.97,Default,,0,0,0,,Күткендей, олар біздің елдің орта мектеп оқушыларын бүкіл әлемге қарсы тұтқынға алды.
Dialogue: 0,0:14:11.05,0:14:14.72,Default,,0,0,0,,Мен ұстаздың кейпін киіп, жасырынып қалдым.
Dialogue: 0,0:14:14.81,0:14:15.68,Default,,0,0,0,,Сондай-ақ...
Dialogue: 0,0:14:15.77,0:14:17.27,Default,,0,0,0,,Не, не?
Dialogue: 0,0:14:17.35,0:14:18.44,Default,,0,0,0,,Күте тұрыңыз... қауіпті емес пе?
Dialogue: 0,0:14:18.52,0:14:19.73,Default,,0,0,0,,Бұл жол жабық!
Dialogue: 0,0:14:19.73,0:14:20.56,Default,,0,0,0,,Бұл жол жабық!
Dialogue: 0,0:14:19.73,0:14:20.56,Default,,0,0,0,,(Нағисаның ауыр тыныс алуы)
Dialogue: 0,0:14:20.56,0:14:20.65,Default,,0,0,0,,(Нағисаның ауыр тыныс алуы)
Dialogue: 0,0:14:20.65,0:14:23.61,Default,,0,0,0,,(Нағисаның ауыр тыныс алуы)
Dialogue: 0,0:14:20.65,0:14:23.61,Default,,0,0,0,,Біздің нұсқауларды орындаңыз!
Dialogue: 0,0:14:23.69,0:14:27.57,Default,,0,0,0,,Екінші кадрды толтыру үшін тағы бір апта қажет.
Dialogue: 0,0:14:27.65,0:14:32.45,Default,,0,0,0,,Байқап қалмас үшін 20% қуатпен түсіргенім өкінішті болды.
Dialogue: 0,0:14:32.53,0:14:35.62,Default,,0,0,0,,Бірақ келесі жолы 100% түсіріңіз
Dialogue: 0,0:14:35.70,0:14:36.66,Default,,0,0,0,,Қашып кете алмаймын
Dialogue: 0,0:14:37.33,0:14:39.71,Default,,0,0,0,,Оның өлімі туралы шешім қабылданды.
Dialogue: 0,0:14:39.79,0:14:43.88,Default,,0,0,0,,Тек қоғамдық пікірді басшылыққа алу және алаңдататын элементтерге қарсы шаралар қабылдау ғана қалады.
Dialogue: 0,0:14:43.96,0:14:46.51,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:14:46.59,0:14:48.88,Default,,0,0,0,,- (Чино) Нагиса! -(Нағиса) А... Каяно
Dialogue: 0,0:14:48.97,0:14:51.26,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:14:51.34,0:14:52.47,Default,,0,0,0,,Эй!
Dialogue: 0,0:14:52.55,0:14:54.47,Default,,0,0,0,,Не айтасыз, шекараны бұзуға болмайды!
Dialogue: 0,0:14:54.56,0:14:55.93,Default,,0,0,0,,Жарайды, артқа тұр!
Dialogue: 0,0:14:56.02,0:14:57.73,Default,,0,0,0,,Нагиса Чино!
Dialogue: 0,0:14:57.81,0:14:59.81,Default,,0,0,0,,Сіз жаңалықтарды көрдіңіз бе? Бұл үлкен мәселе болады.
Dialogue: 0,0:14:59.81,0:15:00.64,Default,,0,0,0,,Сіз жаңалықтарды көрдіңіз бе? Бұл үлкен мәселе болады.
Dialogue: 0,0:14:59.81,0:15:00.64,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:00.73,0:15:02.15,Default,,0,0,0,,Қарап көріңіз!
Dialogue: 0,0:15:02.23,0:15:06.28,Default,,0,0,0,,Сол жақтағы студенттерді құбыжық мұғалім қорқытып жатыр ма?
Dialogue: 0,0:15:06.36,0:15:08.32,Default,,0,0,0,,Балалар сендер кепілде отырған орта мектептің оқушылары болдыңдар, солай ма?
Dialogue: 0,0:15:08.40,0:15:09.61,Default,,0,0,0,,Кешіріңіз. Қазір өзіңізді қалай сезінесіз?
Dialogue: 0,0:15:09.70,0:15:11.74,Default,,0,0,0,,Құбыжықтың қолға түскенін сезіндім.
Dialogue: 0,0:15:11.82,0:15:14.49,Default,,0,0,0,,Коросейді тұтқынға алды ма?
Dialogue: 0,0:15:14.58,0:15:17.24,Default,,0,0,0,,Бір жыл бойы кез келген сәтте жарылуы мүмкін мұғалім...
Dialogue: 0,0:15:17.33,0:15:19.91,Default,,0,0,0,,Құбыжық мені қастандыққа еліктеуге мәжбүр етеді...
Dialogue: 0,0:15:20.00,0:15:21.25,Default,,0,0,0,,Шу!
Dialogue: 0,0:15:21.33,0:15:23.00,Default,,0,0,0,,Сен ештеңе білмейсің!
Dialogue: 0,0:15:23.08,0:15:25.38,Default,,0,0,0,,Мен сенімді дереккөзден естідім.
Dialogue: 0,0:15:25.46,0:15:28.71,Default,,0,0,0,,Жердің жойылу мүмкіндігі 1%-дан аз!
Dialogue: 0,0:15:28.80,0:15:31.18,Default,,0,0,0,,Бұл қауіпті емес екенін теледидардан хабарлаңыз!
Dialogue: 0,0:15:31.26,0:15:34.76,Default,,0,0,0,,Ол халық айтатындай жаман мұғалім емес!
Dialogue: 0,0:15:34.85,0:15:36.14,Default,,0,0,0,,Уа... ой
Dialogue: 0,0:15:36.22,0:15:37.68,Default,,0,0,0,,Ей, балақай, жақынырақ түсір.
Dialogue: 0,0:15:37.77,0:15:40.60,Default,,0,0,0,,Мына құбыжық саған осылай айтуды айтты ма?
Dialogue: 0,0:15:40.68,0:15:43.94,Default,,0,0,0,,Бұл қиын емес пе? Енді адал болған дұрыс
Dialogue: 0,0:15:44.02,0:15:44.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:44.94,0:15:47.65,Default,,0,0,0,,Құбыжықтар осы қатыгез балаларды ұнатады
Dialogue: 0,0:15:47.73,0:15:49.32,Default,,0,0,0,,Ол мені кепілде ұстады!
Dialogue: 0,0:15:49.40,0:15:52.95,Default,,0,0,0,,Балалар ауыр жарақат алады.
Dialogue: 0,0:15:53.03,0:15:55.03,Default,,0,0,0,,Шұғыл күтім қажет
Dialogue: 0,0:15:55.12,0:15:56.83,Default,,0,0,0,,Нашар...
Dialogue: 0,0:15:56.91,0:15:59.29,Default,,0,0,0,,Ештеңені түсінбейтін балаларға
Dialogue: 0,0:15:59.37,0:16:00.83,Default,,0,0,0,,Қандай өкінішті!
Dialogue: 0,0:16:00.91,0:16:02.37,Default,,0,0,0,,Мұны жасайтын сіз бе?
Dialogue: 0,0:16:03.04,0:16:06.79,Default,,0,0,0,,Неге... бізді аяп жатыр?
Dialogue: 0,0:16:06.88,0:16:10.17,Default,,0,0,0,,Мен сізге сұхбат беруге рұқсат бермеймін. Қазір кет!
Dialogue: 0,0:16:10.26,0:16:13.51,Default,,0,0,0,,Дегенмен, біз шындықты жеткізуге міндеттіміз!
Dialogue: 0,0:16:13.59,0:16:17.26,Default,,0,0,0,,Орта сынып оқушыларын қызығудан қорқытудың міндеті қандай?
Dialogue: 0,0:16:18.10,0:16:22.64,Default,,0,0,0,,Қазіргі уақытта бұл аймақ Қорғаныс министрлігінің құзырында тыйым салынған.
Dialogue: 0,0:16:22.73,0:16:25.98,Default,,0,0,0,,Халықтың қауіпсіздігі үшін кетуіңізді сұраймын!
Dialogue: 0,0:16:26.06,0:16:29.23,Default,,0,0,0,,Мен оларды қорғаймын.
Dialogue: 0,0:16:29.32,0:16:31.19,Default,,0,0,0,,(Тікұшақтың ұшу дыбысы)
Dialogue: 0,0:16:31.28,0:16:35.41,Default,,0,0,0,,Қарасума мырза, Коросейге не болды?
Dialogue: 0,0:16:35.49,0:16:37.66,Default,,0,0,0,,Бұл уақыт шегі.
Dialogue: 0,0:16:37.74,0:16:42.12,Default,,0,0,0,,Үкімет бүгінге дейін дайындалған соңғы шараны іске қосты.
Dialogue: 0,0:16:42.20,0:16:43.96,Default,,0,0,0,,Соңғы шара?
Dialogue: 0,0:16:44.04,0:16:45.96,Default,,0,0,0,,Сіз бұл кедергі туралы айтып отырсыз ба?
Dialogue: 0,0:16:46.04,0:16:49.59,Default,,0,0,0,,Бұл оны қақпанға түсіретін тор ғана.
Dialogue: 0,0:16:49.67,0:16:53.01,Default,,0,0,0,,Бір аптадан кейін күшті лазер оны өлтіреді.
Dialogue: 0,0:16:53.09,0:16:53.92,Default,,0,0,0,,Иә!?
Dialogue: 0,0:16:54.01,0:16:57.05,Default,,0,0,0,,Міне! Біздің өлтіруіміз ше?
Dialogue: 0,0:16:57.59,0:17:00.31,Default,,0,0,0,,Балалар, бүгінге дейін көп еңбектендіңдер.
Dialogue: 0,0:17:00.39,0:17:02.10,Default,,0,0,0,,Қалғанын бізге қалдырыңыз.
Dialogue: 0,0:17:02.18,0:17:04.81,Default,,0,0,0,,Неге іссапарға келіп, маған қалдырмайсың?
Dialogue: 0,0:17:04.89,0:17:07.52,Default,,0,0,0,,Біз ештеңе естіген жоқпыз!
Dialogue: 0,0:17:07.60,0:17:11.53,Default,,0,0,0,,Оның үстіне, бұл мәлімдемеде Коро-сенсэй кінәлі сияқты көрінеді...
Dialogue: 0,0:17:11.61,0:17:13.44,Default,,0,0,0,,Мен сенімді емеспін.
Dialogue: 0,0:17:13.53,0:17:16.74,Default,,0,0,0,,Сен маған сені өлтіремін дедің. Бұл тым өзімшілдік!
Dialogue: 0,0:17:16.82,0:17:21.24,Default,,0,0,0,,Оның үстіне, егер біз оны өлтірмесек, ол мені өлтіруге сенбейді!
Dialogue: 0,0:17:21.33,0:17:24.96,Default,,0,0,0,,Қарасума мырза, өтінемін, бізді жіберіңіз!
Dialogue: 0,0:17:25.04,0:17:30.13,Default,,0,0,0,,Элиталық күштер қалада да, тауларда да орналастырылған.
Dialogue: 0,0:17:30.21,0:17:33.88,Default,,0,0,0,,Балалар, енді сізде оны пайдалану мүмкіндігі жоқ, бас тартыңыз.
Dialogue: 0,0:17:33.96,0:17:34.84,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,0:17:34.92,0:17:38.05,Default,,0,0,0,,Мен Коро-сенсеймен сөйлеспеген көп нәрсе бар.
Dialogue: 0,0:17:38.14,0:17:40.05,Default,,0,0,0,,Жасағым келетін нәрселер көп.
Dialogue: 0,0:17:40.14,0:17:42.39,Default,,0,0,0,,Өтінемін! Мені жіберіңізші...
Dialogue: 0,0:17:42.47,0:17:43.60,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:43.68,0:17:45.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:45.52,0:17:49.77,Default,,0,0,0,,Мен сені жібере алмаймын! бұл ұлттық саясат
Dialogue: 0,0:17:49.86,0:17:51.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:51.40,0:17:53.86,Default,,0,0,0,,Мұқият тыңда, Нағиса-күн.
Dialogue: 0,0:17:53.94,0:17:55.07,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:55.15,0:17:57.11,Default,,0,0,0,,Мені ұятқа қалдырмаңыз
Dialogue: 0,0:17:57.91,0:17:59.87,Default,,0,0,0,,Көресіңдер әлі
Dialogue: 0,0:17:59.95,0:18:00.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:01.74,0:18:03.49,Default,,0,0,0,,Пайдасы жоқ, Нағиса.
Dialogue: 0,0:18:03.58,0:18:07.16,Default,,0,0,0,,Өйткені, ол адам да қоғамның мүшесі.
Dialogue: 0,0:18:07.25,0:18:11.63,Default,,0,0,0,,Төтенше жағдайда өзіңізді қорғау үшін жоғарыдағы пәрменді орындаңыз.
Dialogue: 0,0:18:11.71,0:18:13.67,Default,,0,0,0,,- (Қарасума) Дұрыс - (Катаока, Нагиса, Курахаши) Ах...
Dialogue: 0,0:18:13.75,0:18:17.55,Default,,0,0,0,,Күйсіз, қиын уақытта сізді ешкім қорғай алмайды.
Dialogue: 0,0:18:17.63,0:18:20.93,Default,,0,0,0,,Және өз сенімдеріме негізделген.
Dialogue: 0,0:18:21.01,0:18:24.35,Default,,0,0,0,,Мен оны әлі де өлтіру керек деп ойлаймын.
Dialogue: 0,0:18:26.48,0:18:30.35,Default,,0,0,0,,Оларды тасымалдауды және қауіпсіздікті дереу ұйымдастырыңыз.
Dialogue: 0,0:18:30.44,0:18:31.81,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:31.90,0:18:34.78,Default,,0,0,0,,(шатырдан шыққан аяқ дыбысы)
Dialogue: 0,0:18:34.86,0:18:37.82,Default,,0,0,0,,Қарғыс атсын саған Қарасума бейбақ!
Dialogue: 0,0:18:37.90,0:18:39.32,Default,,0,0,0,,Терасака мырза
Dialogue: 0,0:18:39.40,0:18:40.41,Default,,0,0,0,,Әй?
Dialogue: 0,0:18:40.49,0:18:42.28,Default,,0,0,0,,Қарасума мырза қазір
Dialogue: 0,0:18:42.37,0:18:45.29,Default,,0,0,0,,«Мені ұятқа қалдырмаңыз», - дедім анық.
Dialogue: 0,0:18:45.37,0:18:47.62,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:18:47.70,0:18:50.62,Default,,0,0,0,,Қарасума-сенсэй мұны бұрын айтқан, солай ма?
Dialogue: 0,0:18:51.50,0:18:57.21,Default,,0,0,0,,Қиындыққа тап болсам, ойланбастан саған сеніп, өзіңе тапсырар едім.
Dialogue: 0,0:18:57.30,0:18:59.97,Default,,0,0,0,,Сонымен «мені ұятқа қалдырмаңыз» дегенді білдіреді
Dialogue: 0,0:19:00.05,0:19:03.60,Default,,0,0,0,,Бұл бізге сеніп, сеніп тапсыру дегенді білдіреді деп ойлаймын.
Dialogue: 0,0:19:04.68,0:19:08.89,Default,,0,0,0,,Қарасума мырза бізге сенім артып, аманат етті.
Dialogue: 0,0:19:08.98,0:19:09.81,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:19:10.48,0:19:13.02,Default,,0,0,0,,үшінмыз ойланып, жүйелейік
Dialogue: 0,0:19:13.11,0:19:18.11,Default,,0,0,0,,Біз не істегіміз келеді? Біз не істей аламыз?
Dialogue: 0,0:19:18.19,0:19:20.28,Default,,0,0,0,,Коросей...
Dialogue: 0,0:19:21.07,0:19:22.87,Default,,0,0,0,,Сізге не керек?
Dialogue: 0,0:19:27.04,0:19:28.33,Default,,0,0,0,,Сықыр-сықырлы~
Dialogue: 0,0:19:28.41,0:19:30.87,Default,,0,0,0,,Уақытты балауызсыз сүртіңіз!
Dialogue: 0,0:19:30.96,0:19:32.83,Default,,0,0,0,,Нуруфуфуфуфу…
Dialogue: 0,0:19:32.92,0:19:35.79,Default,,0,0,0,,Бұл сіздің сенімділігіңіз туралы қамқорлық туралы.
Dialogue: 0,0:19:38.46,0:19:40.38,Default,,0,0,0,,Мен үшін керемет жаратылыс
Dialogue: 0,0:19:40.47,0:19:43.59,Default,,0,0,0,,Енді қорқатын ештеңе жоқ.
Dialogue: 0,0:19:46.68,0:19:49.52,Default,,0,0,0,,Бір ғана нәрсе орындалса...
Dialogue: 0,0:19:53.77,0:19:54.98,Default,,0,0,0,,Мен оларды тағы бір рет көргім келеді...
Dialogue: 0,0:19:54.98,0:19:57.77,Default,,0,0,0,,Мен оларды тағы бір рет көргім келеді...
Dialogue: 0,0:19:54.98,0:19:57.77,Default,,0,0,0,,♪～
Dialogue: 0,0:19:57.77,0:19:59.99,Default,,0,0,0,,♪～
Dialogue: 0,0:22:13.33,0:22:14.70,Default,,0,0,0,,Ештеңе істеу мүмкін емес
Dialogue: 0,0:22:15.91,0:22:18.42,Default,,0,0,0,,Дүниедегі әрбір адам солай ойлайтын шығар.
Dialogue: 0,0:22:19.21,0:22:23.63,Default,,0,0,0,,Бірақ, өкінішке орай, мен 20 Mach құбыжығымын.
Dialogue: 0,0:22:24.30,0:22:25.67,Default,,0,0,0,,Бақытымызға орай, не істеу керек
Dialogue: 0,0:22:25.76,0:22:27.09,Default,,0,0,0,,Көп
Dialogue: 0,0:22:32.39,0:22:34.77,Default,,0,0,0,,Нюфу~
Dialogue: 0,0:22:36.02,0:22:38.89,Default,,0,0,0,,Әрбір фотоны лақтыру қиын.
Dialogue: 0,0:22:38.98,0:22:42.15,Default,,0,0,0,,Сіз беттерді үлкен ұлғайтуға кіріскіңіз келе ме?
Dialogue: 0,0:22:48.70,0:22:49.24,Default,,0,0,0,,Коросеней Қастандық аяқталғанша
Dialogue: 0,0:22:49.24,0:22:51.74,Default,,0,0,0,,Коросейді өлтіру мерзімі аяқталғанға дейін
Dialogue: 0,0:22:49.24,0:22:51.74,Default,,0,0,0,,～♪
Dialogue: 0,0:22:51.74,0:22:51.82,Default,,0,0,0,,～♪
Dialogue: 0,0:22:51.82,0:22:54.24,Default,,0,0,0,,～♪
Dialogue: 0,0:22:51.82,0:22:54.24,Default,,0,0,0,,Көбірек… 3 сағат
Dialogue: 0,0:22:55.74,0:23:01.74,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
