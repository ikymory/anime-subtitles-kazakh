Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Төменгі ағынға жақын
Dialogue: 0,0:00:06.03,0:00:12.01,Default,,0,0,0,,Егер сіз қисық сызықты бұрсаңыз
Dialogue: 0,0:00:13.02,0:00:17.06,Default,,0,0,0,,Мен су құбырына түсіп бара жатқан сияқтымын.
Dialogue: 0,0:00:18.05,0:00:29.04,Default,,0,0,0,,Не көріп тұрсың? Не жаңғырық? Маған жауап бер
Dialogue: 0,0:00:39.06,0:00:41.03,Default,,0,0,0,,Қала рекорд
Dialogue: 0,0:00:41.03,0:00:44.05,Default,,0,0,0,,Күнді алып бара жатқан қолдың шуы
Dialogue: 0,0:00:45.00,0:00:48.02,Default,,0,0,0,,Мен саған фон боламын
Dialogue: 0,0:00:48.02,0:00:50.00,Default,,0,0,0,,Қоқыс шығару
Dialogue: 0,0:00:50.02,0:00:55.03,Default,,0,0,0,,Жақсы құрылымдалған түйіндеме арқылы шешілмейтін жұмбақ ырғаққа үйреніңіз.
Dialogue: 0,0:00:55.07,0:00:59.00,Default,,0,0,0,,Қаламен қоршалған өзіңді біл
Dialogue: 0,0:00:59.03,0:01:00.05,Default,,0,0,0,,Мен оны жек көремін
Dialogue: 0,0:01:00.00,0:01:04.05,Default,,0,0,0,,Орынсыз қалған естеліктер
Dialogue: 0,0:01:03.04,0:01:05.07,Default,,0,0,0,,Қайырлы таң Аспан бұлтты болудан шаршады
Dialogue: 0,0:01:05.03,0:01:13.00,Default,,0,0,0,,Араласпайтын көру шегінен тыс
Dialogue: 0,0:01:14.06,0:01:17.03,Default,,0,0,0,,Сіз оған жете аласыз ба?
Dialogue: 0,0:01:31.00,0:01:36.05,Default,,0,0,0,,Танака революциясы
Dialogue: 0,0:01:34.04,0:01:36.01,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:01:42.03,0:01:44.09,Default,,0,0,0,,Эй, не істегің келеді?
Dialogue: 0,0:01:45.09,0:01:48.00,Default,,0,0,0,,Оқиға төрт жыл бұрын басталады.
Dialogue: 0,0:01:49.07,0:01:51.09,Default,,0,0,0,,Ол кезде мен ойын компаниясында жұмыс істей бастаған едім.
Dialogue: 0,0:01:51.09,0:01:53.07,Default,,0,0,0,,Басқа компаниялардың ойындарын зерттеу
Dialogue: 0,0:01:53.07,0:01:55.08,Default,,0,0,0,,Бірнеше тегін ойындар ойнады
Dialogue: 0,0:01:56.06,0:01:59.02,Default,,0,0,0,,Шынымды айтсам, мен қазіргі ойындарды ұнатпаймын.
Dialogue: 0,0:01:59.09,0:02:02.08,Default,,0,0,0,,Ойындар шындықтан қашу болуы керек.
Dialogue: 0,0:02:04.05,0:02:08.03,Default,,0,0,0,,Достарың болса артықшылық, ақшаң немесе уақытың болса артықшылық.
Dialogue: 0,0:02:08.05,0:02:10.04,Default,,0,0,0,,Бұл шындық сияқты емес пе?
Dialogue: 0,0:02:12.09,0:02:16.04,Default,,0,0,0,,Оқиға одан әрі, бастауыш мектептің үшінші курсында оқып жүрген кезімнен басталады.
Dialogue: 0,0:02:17.01,0:02:19.09,Default,,0,0,0,,Өшіргіштерді жинау сыныпта бірден танымал болды.
Dialogue: 0,0:02:21.08,0:02:30.08,Default,,0,0,0,,Мектеп саябағының сыртқы көрінісі
Dialogue: 0,0:02:22.00,0:02:25.00,Default,,0,0,0,,Өйткені ол кездегі сынып мұғалімі бай мен кедейдің айырмашылығын өте талғампаз болатын.
Dialogue: 0,0:02:25.03,0:02:27.00,Default,,0,0,0,,Бар мүлкіңді теңестір
Dialogue: 0,0:02:27.00,0:02:30.05,Default,,0,0,0,,Біз оқушыларды орташадан ауытқымауға үйретті.
Dialogue: 0,0:02:31.09,0:02:34.02,Default,,0,0,0,,Бірақ шығудың бір ғана жолы болды.
Dialogue: 0,0:02:34.06,0:02:36.03,Default,,0,0,0,,Бұл кеңсе тауарлары болды
Dialogue: 0,0:02:37.00,0:02:40.01,Default,,0,0,0,,Солардың ішінде өшіргіштердің таралу ауқымы кең болды.
Dialogue: 0,0:02:40.03,0:02:43.00,Default,,0,0,0,,Барлығымыз өшіргіштерді жинауға асықтық.
Dialogue: 0,0:02:43.05,0:02:46.07,Default,,0,0,0,,Қанша және қаншалықты сирек
Dialogue: 0,0:02:47.00,0:02:49.08,Default,,0,0,0,,Сынып иерархиясын басқару үшін осының өзі жеткілікті болды.
Dialogue: 0,0:02:50.06,0:02:52.07,Default,,0,0,0,,Жоқ, бұл асыра сілтеу.
Dialogue: 0,0:02:52.07,0:02:53.09,Default,,0,0,0,,Дәлірек айтсақ, бұл өтірік.
Dialogue: 0,0:02:54.02,0:02:56.03,Default,,0,0,0,,Түсінуге оңай, спорттық қабілеті жақсы адам.
Dialogue: 0,0:02:56.05,0:02:57.07,Default,,0,0,0,,Оқуға қабілетті адам
Dialogue: 0,0:02:58.00,0:02:59.09,Default,,0,0,0,,Ең жақсы күрескен жігіт Жүзі сүйкімді жігіт
Dialogue: 0,0:02:59.09,0:03:01.08,Default,,0,0,0,,Сурет салуға жақсы, қызық жігіт
Dialogue: 0,0:03:02.00,0:03:04.08,Default,,0,0,0,,Әрине, Соиц және басқалары шыңға жақын.
Dialogue: 0,0:03:05.02,0:03:07.06,Default,,0,0,0,,Ештеңесі жоқтардың ішінде, соның ішінде менде
Dialogue: 0,0:03:07.06,0:03:09.01,Default,,0,0,0,,Өшіргіштерді жинау дегеніміз не?
Dialogue: 0,0:03:09.04,0:03:12.04,Default,,0,0,0,,Бұл сыныптағы жоғарғы қатарға енген соңғы бастион болды.
Dialogue: 0,0:03:12.09,0:03:16.00,Default,,0,0,0,,Жоқ, бұл да әсірелеу және өтірік.
Dialogue: 0,0:03:17.03,0:03:19.04,Default,,0,0,0,,Тіпті жоқтардың арасында
Dialogue: 0,0:03:19.04,0:03:22.07,Default,,0,0,0,,Өшіргіштерді жинауға шындап кіріскен екі адам ғана болды деп ойлаймын.
Dialogue: 0,0:03:23.01,0:03:23.51,Default,,0,0,0,,Мен және...
Dialogue: 0,0:03:24.03,0:03:25.07,Default,,0,0,0,,Оның аты - Сато.
Dialogue: 0,0:03:26.01,0:03:28.07,Default,,0,0,0,,Бұл Сато қиын болды.
Dialogue: 0,0:03:29.00,0:03:32.02,Default,,0,0,0,,Ата-анам іссапарға жиі баратын үйде мен өзімді жалғыз сезінемін.
Dialogue: 0,0:03:32.02,0:03:34.00,Default,,0,0,0,,Мен қалтадан ақша алдым.
Dialogue: 0,0:03:34.03,0:03:38.02,Default,,0,0,0,,Мен тіпті іссапарларымда сирек кездесетін жергілікті өшіргіштерді сұрайтынмын.
Dialogue: 0,0:03:39.02,0:03:45.00,Default,,0,0,0,,Неліктен мен екеуміздің арасындағы бұл бекер шайқасқа қатыстым, бұл іс жүзінде финалдық деп айтуға болады?
Dialogue: 0,0:03:45.09,0:03:49.09,Default,,0,0,0,,Менің ойымша, бұл менде сирек кездесетін бір өшіргіш болған.
Dialogue: 0,0:03:50.02,0:03:52.03,Default,,0,0,0,,Бұл додо пішініндегі өшіргіш.
Dialogue: 0,0:03:53.02,0:03:55.09,Default,,0,0,0,,Мен оны туысқанымның шетелдегі сапарынан естелік ретінде алдым.
Dialogue: 0,0:03:56.04,0:03:58.02,Default,,0,0,0,,Маған құстар ұнады
Dialogue: 0,0:03:58.04,0:04:01.06,Default,,0,0,0,,Құс энциклопедиясын тозғанша қайта-қайта оқыдым.
Dialogue: 0,0:04:02.04,0:04:04.09,Default,,0,0,0,,Сен сирек кездесетін құссың.
Dialogue: 0,0:04:07.06,0:04:11.07,Default,,0,0,0,,Бірде мен әкеме құс ұстағым келетінін айтып шағымдандым.
Dialogue: 0,0:04:12.01,0:04:14.09,Default,,0,0,0,,Мен әкеммен үй жануарлары дүкеніне бардым, ол жәй ғана қарап тұрмын деді.
Dialogue: 0,0:04:14.09,0:04:17.07,Default,,0,0,0,,Мен сұр еркек кокат сатып алдым.
Dialogue: 0,0:04:18.04,0:04:20.00,Default,,0,0,0,,«Мару» деп аталады
Dialogue: 0,0:04:20.04,0:04:23.05,Default,,0,0,0,,Мен анаммен кейін эмоционалды тәрбие туралы сөйлестім.
Dialogue: 0,0:04:23.08,0:04:26.07,Default,,0,0,0,,Қазір ойлап қарасам, бұл соншалықты қымбат болмағандықтан деп ойлаймын.
Dialogue: 0,0:04:27.02,0:04:30.00,Default,,0,0,0,,Отаку ағам маған қымбат компьютерлік ойындар сатып алатын.
Dialogue: 0,0:04:30.02,0:04:32.01,Default,,0,0,0,,Менің ойымша, бұл сондай сүйкімді болды.
Dialogue: 0,0:04:33.08,0:04:36.00,Default,,0,0,0,,Мен қамқорлық жасау үшін көп еңбек еттім
Dialogue: 0,0:04:36.04,0:04:38.08,Default,,0,0,0,,Арамызда сенім қарым-қатынасы туды.
Dialogue: 0,0:04:40.00,0:04:41.02,Default,,0,0,0,,Осы қарқынмен… әсіресе «жұма мен сенбі күндері,
Dialogue: 0,0:04:41.06,0:04:44.02,Default,,0,0,0,,Додо өшіргіштері, әрине, сирек болды, бірақ
Dialogue: 0,0:04:44.02,0:04:46.08,Default,,0,0,0,,Өшіргіштерді қалтаңыздың ақшасына сатып алуға болады
Dialogue: 0,0:04:46.08,0:04:48.05,Default,,0,0,0,,Мен Сатоға тең келе алмадым.
Dialogue: 0,0:04:49.03,0:04:52.05,Default,,0,0,0,,Кейбіреулер, бірақ кейбіреулері ғана мазақ етті.
Dialogue: 0,0:04:52.08,0:04:55.02,Default,,0,0,0,,Мен бұған қатты ренжідім.
Dialogue: 0,0:04:55.07,0:04:59.08,Default,,0,0,0,,Мен қарапайым өшіргішті қолдандым, бет-әлпетін ''Бір рет айналып өту үшін бұл қажет.''
Dialogue: 0,0:05:00.01,0:05:02.03,Default,,0,0,0,,Өнер мектебінде өшіргіштің орнына қолданылады
Dialogue: 0,0:05:02.03,0:05:05.06,Default,,0,0,0,,Ақ нанды тезек боп аққан кезде де пайдаландым.
Dialogue: 0,0:05:05.09,0:05:09.05,Default,,0,0,0,,Жетілдірілген деп жасырылған мұндай төмен деңгейлі техниканың жұмыс істеуі мүмкін емес.
Dialogue: 0,0:05:09.08,0:05:12.04,Default,,0,0,0,,Мен күнде жеңілгенімді сезіндім.
Dialogue: 0,0:05:13.08,0:05:15.01,Default,,0,0,0,,Бұл уақыт болды
Dialogue: 0,0:05:19.00,0:05:21.02,Default,,0,0,0,,Әлемде бірегей және өте сирек
Dialogue: 0,0:05:22.00,0:05:23.06,Default,,0,0,0,,Донраку өшіргіш…
Dialogue: 0,0:05:23.05,0:05:25.08,Default,,0,0,0,,Соққылар > Ойыншықтар > Ойын > Адамдар > Пил Әлемде бірегей және өте сирек кездеседі
Dialogue: 0,0:05:30.00,0:05:31.06,Default,,0,0,0,,Мен осылай деп ойладым.
Dialogue: 0,0:05:31.08,0:05:34.00,Default,,0,0,0,,Дүниеде бір ғана сирек кездесетін нәрсе
Dialogue: 0,0:05:34.03,0:05:36.06,Default,,0,0,0,,Бұл жағдайды біржола өзгертудің жалғыз жолы болды
Dialogue: 0,0:05:36.08,0:05:37.07,Default,,0,0,0,,Ешкім нәтижелерге сәйкес келмейді.
Dialogue: 0,0:05:38.05,0:05:41.03,Default,,0,0,0,,Үйге келсем, үйдегілер ұйықтап жатыр екен
Dialogue: 0,0:05:41.03,0:05:43.09,Default,,0,0,0,,Әкеңіздің әмиянынан несие картасын шығарыңыз
Dialogue: 0,0:05:43.09,0:05:45.05,Default,,0,0,0,,Карточка нөмірін жазыңыз, т.б.
Dialogue: 0,0:05:48.00,0:05:49.09,Default,,0,0,0,,Төлемнің қиындығын ескере отырып, т.б.
Dialogue: 0,0:05:49.09,0:05:52.02,Default,,0,0,0,,Маған несие картасы өте қажет болды.
Dialogue: 0,0:05:52.05,0:05:56.07,Default,,0,0,0,,Бұл карта кез келген адамның қолында болатын және студенттер пайдалана алатын карта түрі болды.
Dialogue: 0,0:05:57.01,0:06:00.09,Default,,0,0,0,,Енді мен мұны білгеннен кейін мен аздап сентиментальды сезінемін.
Dialogue: 0,0:06:01.03,0:06:03.02,Default,,0,0,0,,Бұл басқа әңгіме.
Dialogue: 0,0:06:03.08,0:06:08.04,Default,,0,0,0,,Бұл әкем Дубайға барғанда маған сатып алған. Бұл менің қазіргі жағдайым.
Dialogue: 0,0:06:07.02,0:06:08.04,Default,,0,0,0,,Қазір қараңыз
Dialogue: 0,0:06:09.06,0:06:13.01,Default,,0,0,0,,Сол күні сабақтан кейін, шектеулі уақытта ағам жоқ,
Dialogue: 0,0:06:12.05,0:06:13.08,Default,,0,0,0,,Қатысушылар саны Өндіріс тарихы Қосымша уақыт Толық ақпарат Қазіргі кездегі іс Пакет
Dialogue: 0,0:06:13.01,0:06:15.01,Default,,0,0,0,,Тіркеу сияқты дайындық жұмыстары аяқталды Қатысушылар саны Өндіріс тарихы Қосымша уақыт Толық ақпарат Қазіргі кездегі іс Пакет Қатысушылар саны Өндіріс тарихы Қосымша уақыт Толық ақпарат Қазіргі кездегі іс Пакет
Dialogue: 0,0:06:14.02,0:06:15.06,Default,,0,0,0,,Шығару Хабар-ошарсыз кеткендер туралы мәліметтер Ескертулер Зейнеткерлікке шықпау/Зейнетке шықпау Түйіндеме Жақсы пікірлер Дева ауданы
Dialogue: 0,0:06:15.08,0:06:17.06,Default,,0,0,0,,3000 иен?
Dialogue: 0,0:06:17.09,0:06:21.00,Default,,0,0,0,,Өтінім нөл болды және бар болғаны 3 күн қалды.
Dialogue: 0,0:06:21.08,0:06:24.01,Default,,0,0,0,,Менің компьютерімді пайдалану уақытым шектеулі.
Dialogue: 0,0:06:24.01,0:06:25.06,Default,,0,0,0,,Сауда жасауға уақыт жоқ
Dialogue: 0,0:06:25.09,0:06:27.03,Default,,0,0,0,,Тез арада өтінім беріңіз
Dialogue: 0,0:06:27.07,0:06:29.02,Default,,0,0,0,,Листинг бағасы 3000 иен
Dialogue: 0,0:06:29.06,0:06:32.03,Default,,0,0,0,,Бұл мен үшін арзан болған жоқ.
Dialogue: 0,0:06:32.05,0:06:35.00,Default,,0,0,0,,Бағалар әлі де көтерілуі мүмкін
Dialogue: 0,0:06:35.03,0:06:40.04,Default,,0,0,0,,LOL! Дуанзи Занзи Цзянжу! Алушыға арналған ультра жаңадан келген теңіз құбылысының комбинациясы «Дүкен» әңгімесі
Dialogue: 0,0:06:36.00,0:06:37.01,Default,,0,0,0,,Бұл қандай қызметші?
Dialogue: 0,0:06:37.01,0:06:40.09,Default,,0,0,0,,Жеткілікті. Тарих сияқты компьютерді пайдалану іздерін өшіріңіз.
Dialogue: 0,0:06:38.03,0:06:40.00,Default,,0,0,0,,Сізге көп рахмет Рахмет
Dialogue: 0,0:06:41.02,0:06:43.05,Default,,0,0,0,,Ештеңе жеп жатқандай көрінбей, отбасыммен тамақтандым.
Dialogue: 0,0:06:44.00,0:06:45.09,Default,,0,0,0,,Анашым, сізде десерт бар ма?
Dialogue: 0,0:06:45.09,0:06:51.00,Default,,0,0,0,,Сол кезде мен өзімді супер хакерге айналғандай сезіндім.
Dialogue: 0,0:06:57.04,0:06:58.03,Default,,0,0,0,,Келесі күні
Dialogue: 0,0:07:02.05,0:07:03.06,Default,,0,0,0,,Жоғары көтерілу
Dialogue: 0,0:07:03.09,0:07:05.06,Default,,0,0,0,,Бір бәсекелес болды.
Dialogue: 0,0:07:05.06,0:07:07.08,Default,,0,0,0,,Қазір ойлап қарасам, бұл неткен сұмдық екен.
Dialogue: 0,0:07:07.07,0:07:12.02,Default,,0,0,0,,Шығару Өнімнің максималды бағасы Шығару
Dialogue: 0,0:07:08.05,0:07:12.01,Default,,0,0,0,,Мен ұсыныс сомасы өрісіне 3600 иен енгіздім.
Dialogue: 0,0:07:12.08,0:07:15.00,Default,,0,0,0,,Тендер сәтті өткен күні.
Dialogue: 0,0:07:17.03,0:07:19.03,Default,,0,0,0,,Йо... 4000 иен?
Dialogue: 0,0:07:20.02,0:07:21.07,Default,,0,0,0,,Қарсыластар өрескел
Dialogue: 0,0:07:22.02,0:07:25.00,Default,,0,0,0,,Қандай жағдай болса да алуға құмар болдым.
Dialogue: 0,0:07:25.05,0:07:28.00,Default,,0,0,0,,Ниеті мен бюджеті көрінбейтін қарсыласпен күресу
Dialogue: 0,0:07:28.04,0:07:30.08,Default,,0,0,0,,Менің ойымша, бұл онлайн аукциондардың нағыз толқуы.
Dialogue: 0,0:07:31.02,0:07:33.05,Default,,0,0,0,,Бірақ бұл шұғыл.
Dialogue: 0,0:07:33.07,0:07:36.03,Default,,0,0,0,,Мен 4100 иен енгіздім
Dialogue: 0,0:07:42.02,0:07:43.05,Default,,0,0,0,,Қатысушылар саны Өндіріс тарихы Қосымша уақыт Толық ақпарат Қазіргі кездегі іс Пакет Шығару
Dialogue: 0,0:07:43.07,0:07:44.08,Default,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:07:47.07,0:07:49.01,Default,,0,0,0,,Мұнда екеніңе сенбеймін
Dialogue: 0,0:07:59.06,0:08:02.00,Default,,0,0,0,,Бұл полицияның жалған айыппен қамауға алынғаны сияқты.
Dialogue: 0,0:08:02.00,0:08:06.05,Default,,0,0,0,,Мен өзімнің кінәсіз екенімді дәлелдеуге тырыстым, бірақ барған сайын заттай дәлелдер келтірілді.
Dialogue: 0,0:08:06.09,0:08:09.04,Default,,0,0,0,,Мен сондай үмітсіздікті сезінгенім есімде.
Dialogue: 0,0:08:10.02,0:08:13.00,Default,,0,0,0,,Жоқ, бұл әлі де асыра сілтеу.
Dialogue: 0,0:08:13.00,0:08:14.00,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:08:14.05,0:08:17.04,Default,,0,0,0,,Бірақ сөзбен айтып жеткізу мүмкін емес үмітсіздік болды.
Dialogue: 0,0:08:18.09,0:08:19.09,Default,,0,0,0,,Ол кезде болды
Dialogue: 0,0:08:20.02,0:08:21.04,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:08:26.08,0:08:30.00,Default,,0,0,0,,Ол одан да асып түседі. Ол одан асып түседі.
Dialogue: 0,0:08:49.00,0:08:49.50,Default,,0,0,0,,Эй
Dialogue: 0,0:08:51.03,0:08:54.03,Default,,0,0,0,,Мен бір нәрсені білгім келеді.
Dialogue: 0,0:08:54.09,0:08:56.07,Default,,0,0,0,,Сен маған рұқсатсыз тиістің.
Dialogue: 0,0:09:02.01,0:09:06.00,Default,,0,0,0,,Кьюки! Мен экстаз күйінде тұрмын. Бұл менмін. Мен өтінімді міндетті түрде жеңіп алдым.
Dialogue: 0,0:09:05.06,0:09:07.06,Default,,0,0,0,,Сауданың басталуы Хабар-ошарсыз кеткендер туралы мәліметтер
Dialogue: 0,0:09:06.03,0:09:07.07,Default,,0,0,0,,Ақылсыздық
Dialogue: 0,0:09:08.03,0:09:09.07,Default,,0,0,0,,Футбол ойнайық
Dialogue: 0,0:09:10.05,0:09:11.07,Default,,0,0,0,,Мектеп ауласына жүгіру
Dialogue: 0,0:09:13.09,0:09:17.02,Default,,0,0,0,,Жапонияда экономикалық теңсіздікке қанағаттанбағандықтан,
Dialogue: 0,0:09:17.02,0:09:20.02,Default,,0,0,0,,Халық көтерілісі, оның ішінде дүмпу болды дейді.
Dialogue: 0,0:09:20.08,0:09:24.06,Default,,0,0,0,,Мұғалім бұл сыныпта бай мен кедей арасындағы алшақтық ұлғаймауы үшін не істеді?
Dialogue: 0,0:09:24.09,0:09:29.00,Default,,0,0,0,,Бұрмаланған түрде кері реакция тудырған бір оқушыға
Dialogue: 0,0:09:29.07,0:09:32.08,Default,,0,0,0,,Бұл ұйымдасқан көтеріліс немесе көтеріліс емес.
Dialogue: 0,0:09:33.00,0:09:34.09,Default,,0,0,0,,Бұл бір ғана адам бастаған революция.
Dialogue: 0,0:09:35.05,0:09:38.04,Default,,0,0,0,,Мен мұны «Танака революциясы» деп атадым.
Dialogue: 0,0:09:39.05,0:09:41.00,Default,,0,0,0,,Тағы да үйге қайт
Dialogue: 0,0:09:41.00,0:09:44.02,Default,,0,0,0,,Өнімді қайда жіберу керектігі сияқты сатушымен электрондық пошта байланысы.
Dialogue: 0,0:09:44.05,0:09:48.03,Default,,0,0,0,,Енді бізге тек Донраку өшіргішінің келуін күту ғана қалды.
Dialogue: 0,0:09:51.03,0:09:53.03,Default,,0,0,0,,Содан бері бір апта өтті.
Dialogue: 0,0:09:56.00,0:09:57.03,Default,,0,0,0,,Бір ай өтті
Dialogue: 0,0:09:58.08,0:10:01.01,Default,,0,0,0,,Түпнұсқа Донраку өшіргіші кірмейді
Dialogue: 0,0:10:01.06,0:10:04.05,Default,,0,0,0,,«Талап жоқ, қайтару жоқ» деген сөздерді есте сақтаңыз
Dialogue: 0,0:10:05.00,0:10:07.04,Default,,0,0,0,,Менің ойымша, мен қазір қалағанымды жасай алар едім.
Dialogue: 0,0:10:07.07,0:10:12.01,Default,,0,0,0,,Алайда, ол кезде мен «талап пен қайтарым жоқ» деген сөзге жабысып қалдым.
Dialogue: 0,0:10:12.03,0:10:13.08,Default,,0,0,0,,Мен шарасыз қалдым
Dialogue: 0,0:10:14.06,0:10:16.08,Default,,0,0,0,,Мен бұған келісіп, ұсыныс жасадым.
Dialogue: 0,0:10:16.08,0:10:18.09,Default,,0,0,0,,Шағым берілмеуі керек еді.
Dialogue: 0,0:10:19.02,0:10:21.01,Default,,0,0,0,,Қайтаратын ештеңе болмады.
Dialogue: 0,0:10:21.09,0:10:26.02,Default,,0,0,0,,Оның сыныптастары, соның ішінде Сато да өшіргіштерге деген қызығушылығын жоғалтқан.
Dialogue: 0,0:10:26.05,0:10:30.01,Default,,0,0,0,,Менің ойымша, үшінші сынып оқушылары тез өседі.
Dialogue: 0,0:10:33.06,0:10:38.00,Default,,0,0,0,,Ал әкем несие картасы бойынша көшірмеге қараған кезде, мені ұрып-соқты.
Dialogue: 0,0:10:38.07,0:10:39.09,Default,,0,0,0,,Ұрған кезде
Dialogue: 0,0:10:40.02,0:10:42.06,Default,,0,0,0,,Кім кінәлі деп ойладым.
Dialogue: 0,0:10:43.03,0:10:44.01,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:10:44.08,0:10:45.09,Default,,0,0,0,,Сыныптасы
Dialogue: 0,0:10:45.09,0:10:46.06,Default,,0,0,0,,Сато
Dialogue: 0,0:10:46.08,0:10:47.04,Default,,0,0,0,,Аға
Dialogue: 0,0:10:48.08,0:10:49.06,Default,,0,0,0,,Сатушы
Dialogue: 0,0:10:49.09,0:10:50.08,Default,,0,0,0,,Сауда-саттыққа қатысушы
Dialogue: 0,0:10:51.00,0:10:51.50,Default,,0,0,0,,Мен
Dialogue: 0,0:10:52.00,0:10:52.50,Default,,0,0,0,,Ел
Dialogue: 0,0:10:53.00,0:10:53.50,Default,,0,0,0,,Тарих
Dialogue: 0,0:10:54.01,0:10:55.06,Default,,0,0,0,,Өркениет Саясат
Dialogue: 0,0:10:55.08,0:10:56.03,Default,,0,0,0,,Құдай
Dialogue: 0,0:10:57.02,0:11:00.00,Default,,0,0,0,,Қалай қарасаң да, жүз қадамда берілсем де, менің кінәм.
Dialogue: 0,0:11:00.04,0:11:02.01,Default,,0,0,0,,Жеңілген адам болса...
Dialogue: 0,0:11:02.01,0:11:03.06,Default,,0,0,0,,Әке әке
Dialogue: 0,0:11:03.06,0:11:05.00,Default,,0,0,0,,Бұл мен болдым
Dialogue: 0,0:11:06.07,0:11:09.06,Default,,0,0,0,,Танака революциясы осылай аяқталды.
Dialogue: 0,0:11:12.00,0:11:16.01,Default,,0,0,0,,Тақырыпқа қайта оралсам, содан бері мен шынайы бейнесі жоқ нәрселерді жек көремін.
Dialogue: 0,0:11:16.01,0:11:17.06,Default,,0,0,0,,Мен енді басқалармен бәсекелескенді ұнатпаймын.
Dialogue: 0,0:11:17.06,0:11:18.03,Default,,0,0,0,,Ха... Уф...
Dialogue: 0,0:11:18.06,0:11:19.09,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:11:20.06,0:11:22.02,Default,,0,0,0,,Ойындар жалғыз ойналады.
Dialogue: 0,0:11:22.05,0:11:25.01,Default,,0,0,0,,Жалғыз әзірлеушілермен күресу
Dialogue: 0,0:11:28.05,0:11:30.08,Default,,0,0,0,,Сол кезде мен бір ойынға тап болдым.
Dialogue: 0,0:11:31.03,0:11:34.00,Default,,0,0,0,,«Зуден» деп аталатын «Зоологиялық бақ»
Dialogue: 0,0:11:34.05,0:11:37.01,Default,,0,0,0,,Бірегей жануарларды өсіру және көрсету
Dialogue: 0,0:11:37.03,0:11:39.05,Default,,0,0,0,,Ойыншы хайуанаттар бағының директоры болады.
Dialogue: 0,0:11:39.05,0:11:41.03,Default,,0,0,0,,Жаһандық масштабтағы рейтингтер үшін бәсекелесіңіз
Dialogue: 0,0:11:42.00,0:11:44.08,Default,,0,0,0,,Мен мұны тегін жасай алатындай ләззат алдым.
Dialogue: 0,0:11:45.03,0:11:48.07,Default,,0,0,0,,Бұл өшіргіштерді жинау дәуірінде жатыр деп ойлаймын.
Dialogue: 0,0:11:48.09,0:11:52.00,Default,,0,0,0,,Рейтинг қорқынышты болды, бірақ тұтынушылар саны көбейсе мен қуанар едім.
Dialogue: 0,0:11:52.03,0:11:54.09,Default,,0,0,0,,Ақылға қонымды сирек жануарды алған кезде
Dialogue: 0,0:11:53.07,0:11:55.02,Default,,0,0,0,,SR Барыс
Dialogue: 0,0:11:55.02,0:11:57.03,Default,,0,0,0,,Менің миым аздап қауіпті түрде жансызданып қалды.
