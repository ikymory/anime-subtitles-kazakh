Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.13,0:00:08.74,Default,,0,0,0,,NETFLIX ұсынады
Dialogue: 0,0:00:09.14,0:00:12.64,Default,,0,0,0,,NETFLIX түпнұсқа жұмыстары
Dialogue: 0,0:00:25.35,0:00:26.55,Default,,0,0,0,,Баспалдақтар!
Dialogue: 0,0:00:27.66,0:00:29.02,Default,,0,0,0,,Мен енді мұны істей алмаймын
Dialogue: 0,0:00:30.13,0:00:32.69,Default,,0,0,0,,Барлығы бірінші бастайды.
Dialogue: 0,0:00:34.43,0:00:35.63,Default,,0,0,0,,Кейінірек өтіңіз
Dialogue: 0,0:00:45.31,0:00:46.47,Default,,0,0,0,,Ұйқының дәмін сез; жапырақтар арасынан сүзіліп түскен таңғы күн сәулесі мен бұлттардың қозғалысын бағала
Dialogue: 0,0:01:05.63,0:01:08.23,Default,,0,0,0,,Ішкі тыныштық
Dialogue: 0,0:01:08.36,0:01:11.20,Default,,0,0,0,,Ішкі тыныштық
Dialogue: 0,0:01:13.17,0:01:14.74,Default,,0,0,0,,Мұрынның қышуы
Dialogue: 0,0:01:21.44,0:01:24.45,Default,,0,0,0,,Соңында, ішкі тыныштық
Dialogue: 0,0:01:25.58,0:01:26.41,Default,,0,0,0,,Не?
Dialogue: 0,0:01:38.79,0:01:40.70,Default,,0,0,0,,Кай, ескі досым
Dialogue: 0,0:01:42.73,0:01:44.77,Default,,0,0,0,,Мастер Огвей
Dialogue: 0,0:01:45.13,0:01:48.10,Default,,0,0,0,,Шайқас 500 жыл бұрын аяқталуы керек еді.
Dialogue: 0,0:01:48.60,0:01:50.74,Default,,0,0,0,,Реваншқа дайын
Dialogue: 0,0:01:51.24,0:01:52.37,Default,,0,0,0,,Соңында?
Dialogue: 0,0:02:09.12,0:02:10.79,Default,,0,0,0,,Сіз күштірек болдыңыз.
Dialogue: 0,0:02:13.63,0:02:14.40,Default,,0,0,0,,«Ки»
Dialogue: 0,0:02:16.43,0:02:21.17,Default,,0,0,0,,Менің «Жан патшалығына» келгеніме 500 жыл болды. Жағдайлары сәл жақсырақ.
Dialogue: 0,0:02:21.40,0:02:25.74,Default,,0,0,0,,Мен осы уақытқа дейін кездестірген шеберлердің «киін» ұрлап алдым.
Dialogue: 0,0:02:25.81,0:02:26.51,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:02:26.61,0:02:27.68,Default,,0,0,0,,Мен мүлде не болып жатқанын түсінбеймін.
Dialogue: 0,0:02:27.81,0:02:30.58,Default,,0,0,0,,Келесі жолы мен сіздің назарыңызды аударамын.
Dialogue: 0,0:02:30.68,0:02:35.15,Default,,0,0,0,,Әлі де сенімді емессіз бе? Неғұрлым көп алсаңыз, соғұрлым көп жоғалтасыз.
Dialogue: 0,0:02:56.17,0:03:01.18,Default,,0,0,0,,Егер сіз қаласаңыз, мен «тән патшалығына» орала аламын
Dialogue: 0,0:03:01.31,0:03:05.18,Default,,0,0,0,,Оның үстіне сен мені тоқтата алмайсың.
Dialogue: 0,0:03:05.28,0:03:08.88,Default,,0,0,0,,Егер сені тоқтату менің міндетім болса
Dialogue: 0,0:03:09.32,0:03:12.55,Default,,0,0,0,,Мен оны басқа біреуге сеніп тапсырдым.
Dialogue: 0,0:03:17.59,0:03:22.26,Default,,0,0,0,,Онда мен оны тауып, назарын ұрлаймын.
Dialogue: 0,0:03:40.55,0:03:43.59,Default,,0,0,0,,Біз, әділдікті сүйетін қожалар!
Dialogue: 0,0:04:38.67,0:04:40.74,Default,,0,0,0,,Әділдік екі асын қойды...
Dialogue: 0,0:04:41.38,0:04:42.34,Default,,0,0,0,,Тофу тоқаш
Dialogue: 0,0:04:42.41,0:04:43.78,Default,,0,0,0,,Ащы сорпа кеспесі де.
Dialogue: 0,0:04:43.85,0:04:44.91,Default,,0,0,0,,Дереккөз дегеніміз не?
Dialogue: 0,0:04:44.98,0:04:45.88,Default,,0,0,0,,Бұл бөлек табақ.
Dialogue: 0,0:04:45.95,0:04:46.68,Default,,0,0,0,,Бөлек
Dialogue: 0,0:04:46.71,0:04:47.68,Default,,0,0,0,,Бөлек.
Dialogue: 0,0:04:50.69,0:04:51.69,Default,,0,0,0,,Айдаһар жауынгері!
Dialogue: 0,0:04:51.79,0:04:52.92,Default,,0,0,0,,Алқапты қорға
Dialogue: 0,0:04:58.43,0:05:00.66,Default,,0,0,0,,Айдаһар жауынгері алқапты қорғаңыз!
Dialogue: 0,0:05:05.43,0:05:07.50,Default,,0,0,0,,Сіздің қолтаңбаңыз қандай?
Dialogue: 0,0:05:07.60,0:05:09.84,Default,,0,0,0,,Қонған сайын қажет пе?
Dialogue: 0,0:05:10.41,0:05:13.44,Default,,0,0,0,,Сыртқы көріністің әсері маңызды.
Dialogue: 0,0:05:13.57,0:05:16.98,Default,,0,0,0,,Кейбір адамдар матчты сыртқы түрімен шешеді.
Dialogue: 0,0:05:19.65,0:05:20.72,Default,,0,0,0,,Күшті келбет?
Dialogue: 0,0:05:21.02,0:05:21.98,Default,,0,0,0,,Мастер Шифу
Dialogue: 0,0:05:22.32,0:05:23.92,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:05:24.39,0:05:25.79,Default,,0,0,0,,Енді мен ойықтамын...
Dialogue: 0,0:05:25.85,0:05:27.92,Default,,0,0,0,,Жоқ, дұрыс.
Dialogue: 0,0:05:28.02,0:05:31.09,Default,,0,0,0,,Психологиялық соғыс «жұдырықтан» бұрын басталады.
Dialogue: 0,0:05:31.36,0:05:33.66,Default,,0,0,0,,Сондықтан сыртқы түрі маңызды.
Dialogue: 0,0:05:46.11,0:05:49.34,Default,,0,0,0,,Күшті көрініс! Бірдеңе бар ма?
Dialogue: 0,0:05:49.41,0:05:52.05,Default,,0,0,0,,Бүгін менің соңғы жаттығуым.
Dialogue: 0,0:05:52.35,0:05:53.68,Default,,0,0,0,,Соңғысы...
Dialogue: 0,0:05:53.78,0:05:56.65,Default,,0,0,0,,Сіз ауырып жатырсыз ба? Әрине аздап...
Dialogue: 0,0:05:56.75,0:05:57.49,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:05:57.59,0:05:59.59,Default,,0,0,0,,Дұрыс, сіз жақсы көрінесіз.
Dialogue: 0,0:06:00.46,0:06:05.63,Default,,0,0,0,,Тыңдаңдар, мен сендерді қазірден бастап жаттықтырамын.
Dialogue: 0,0:06:05.73,0:06:07.53,Default,,0,0,0,,Айдаһар жауынгері
Dialogue: 0,0:06:09.90,0:06:11.53,Default,,0,0,0,,Бұл құрылғы түрленіп, көптеген табақшалармен резонансқа түсіп
Dialogue: 0,0:06:13.00,0:06:16.57,Default,,0,0,0,,Бұл бөлімшенің жолбарысы емес пе?
Dialogue: 0,0:06:16.67,0:06:17.51,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:06:17.61,0:06:18.64,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,0:06:18.91,0:06:21.94,Default,,0,0,0,,Өйткені сен айдаһар жауынгерісің
Dialogue: 0,0:06:22.04,0:06:24.95,Default,,0,0,0,,Қарсылас – Мастер Бес.
Dialogue: 0,0:06:25.55,0:06:29.02,Default,,0,0,0,,Сізге үйрететін бірдеңе болуы керек.
Dialogue: 0,0:06:29.75,0:06:32.65,Default,,0,0,0,,Мысалы, менің жаңа техникамды қараңыз.
Dialogue: 0,0:06:33.39,0:06:34.99,Default,,0,0,0,,«Қатты жұмыстан шығару»
Dialogue: 0,0:06:35.89,0:06:36.82,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,0:06:38.96,0:06:41.73,Default,,0,0,0,,Шынымен! Фигурасы жоқ
Dialogue: 0,0:06:41.96,0:06:43.87,Default,,0,0,0,,Сіздің қожайыныңыз кім?
Dialogue: 0,0:06:44.87,0:06:46.03,Default,,0,0,0,,Мастер
Dialogue: 0,0:06:47.07,0:06:48.90,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:49.10,0:06:51.11,Default,,0,0,0,,Бізбен бірге жаттығу
Dialogue: 0,0:06:51.64,0:06:54.18,Default,,0,0,0,,Егер сіз сәтсіздікке ұшырасаңыз, жоғалтатыныңыз тек құрмет.
Dialogue: 0,0:06:57.81,0:07:00.18,Default,,0,0,0,,Оның жаман адам емес екеніне сенімдімін.
Dialogue: 0,0:07:00.68,0:07:02.55,Default,,0,0,0,,...
Dialogue: 0,0:07:02.72,0:07:04.55,Default,,0,0,0,,Оны аздап өзгертейік.
Dialogue: 0,0:07:04.75,0:07:06.55,Default,,0,0,0,,Қозғалмайтын тау қалпы
Dialogue: 0,0:07:06.75,0:07:07.96,Default,,0,0,0,,Иә, ұстаз.
Dialogue: 0,0:07:08.76,0:07:09.56,Default,,0,0,0,,Әй...
Dialogue: 0,0:07:09.69,0:07:11.09,Default,,0,0,0,,Торнадо артқа секіру
Dialogue: 0,0:07:11.56,0:07:12.69,Default,,0,0,0,,Иә, шебер.
Dialogue: 0,0:07:14.50,0:07:15.63,Default,,0,0,0,,Өрт!
Dialogue: 0,0:07:15.73,0:07:16.83,Default,,0,0,0,,«Бұл өрт»
Dialogue: 0,0:07:17.17,0:07:18.53,Default,,0,0,0,,Мм... Кешіріңіз.
Dialogue: 0,0:07:18.60,0:07:20.50,Default,,0,0,0,,Жоғары! Жоқ, төменде.
Dialogue: 0,0:07:22.00,0:07:23.20,Default,,0,0,0,,Ілмек үзілгелі тұр.
Dialogue: 0,0:07:23.97,0:07:28.11,Default,,0,0,0,,Тотем бағанасында жылан мен жолбарыс...
Dialogue: 0,0:07:28.21,0:07:30.01,Default,,0,0,0,,Содан кейін екі адам
Dialogue: 0,0:07:30.11,0:07:35.18,Default,,0,0,0,,Жәндіктер тобына шабуыл жасағандай болды... ащы шабуыл...
Dialogue: 0,0:07:35.48,0:07:36.45,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:41.82,0:07:43.93,Default,,0,0,0,,Жақсы жұмыс, По
Dialogue: 0,0:07:46.86,0:07:48.86,Default,,0,0,0,,Нені білдің?
Dialogue: 0,0:07:49.20,0:07:50.20,Default,,0,0,0,,(Дауыс баяндамасы) «JoJo's Bizarre Adventure» сериалының алдыңғы бөлімдерінде
Dialogue: 0,0:07:50.57,0:07:51.93,Default,,0,0,0,,Бұл ең нашар тәжірибе.
Dialogue: 0,0:07:52.13,0:07:55.00,Default,,0,0,0,,Жолбарыстар күйіп кетуі мүмкін
Dialogue: 0,0:08:01.58,0:08:04.15,Default,,0,0,0,,Бүгін қорқынышты болды.
Dialogue: 0,0:08:04.25,0:08:06.18,Default,,0,0,0,,Түсінікті болу үшін...
Dialogue: 0,0:08:06.48,0:08:07.58,Default,,0,0,0,,По жақсы емес.
Dialogue: 0,0:08:07.65,0:08:08.68,Default,,0,0,0,,Шифу нашар
Dialogue: 0,0:08:08.88,0:08:10.75,Default,,0,0,0,,Бұл Огвей.
Dialogue: 0,0:08:13.96,0:08:16.02,Default,,0,0,0,,Сіз менің айтқанымды сұрадыңыз.
Dialogue: 0,0:08:16.22,0:08:17.93,Default,,0,0,0,,Мен ештеңе естіген жоқпын
Dialogue: 0,0:08:18.06,0:08:20.63,Default,,0,0,0,,Жоқ деген сол еді.
Dialogue: 0,0:08:32.57,0:08:34.04,Default,,0,0,0,,Души-сама
Dialogue: 0,0:08:36.71,0:08:37.78,Default,,0,0,0,,Кенет қайтадан...
Dialogue: 0,0:08:38.05,0:08:39.65,Default,,0,0,0,,«Ұстаздың» бірінші күні қандай болды?
Dialogue: 0,0:08:39.85,0:08:41.05,Default,,0,0,0,,Қорлау
Dialogue: 0,0:08:41.18,0:08:42.05,Default,,0,0,0,,Тыңдалған
Dialogue: 0,0:08:42.15,0:08:43.75,Default,,0,0,0,,Жолбарыстан?
Dialogue: 0,0:08:43.89,0:08:48.86,Default,,0,0,0,,Маймыл тырна Мантис Сенің әкең Сувенир дүкенінің сатушысы
Dialogue: 0,0:08:48.92,0:08:51.66,Default,,0,0,0,,Бүгінгі үйректерге, онда...
Dialogue: 0,0:08:51.73,0:08:52.63,Default,,0,0,0,,Бұл жолбарыс.
Dialogue: 0,0:08:52.76,0:08:55.66,Default,,0,0,0,,Келесі жолы жоқ.
Dialogue: 0,0:08:55.90,0:08:57.87,Default,,0,0,0,,Жаттығу? Қорлау?
Dialogue: 0,0:08:58.10,0:09:00.67,Default,,0,0,0,,Екеуі де. Мен мұны істей алмаймын.
Dialogue: 0,0:09:01.07,0:09:02.54,Default,,0,0,0,,О, әрине — бұл уақыт машинасы ғой.
Dialogue: 0,0:09:02.80,0:09:05.74,Default,,0,0,0,,Сонда сіз оның сәтсіздігіне жол бересіз бе? неге?
Dialogue: 0,0:09:05.94,0:09:10.81,Default,,0,0,0,,Қолыңнан келгенді ғана жасасаң, өсе алмайсың.
Dialogue: 0,0:09:11.08,0:09:13.65,Default,,0,0,0,,Мен қазір кім екеніме қанағаттанамын.
Dialogue: 0,0:09:13.81,0:09:16.22,Default,,0,0,0,,Өзіңізді түсінбеу
Dialogue: 0,0:09:16.32,0:09:19.65,Default,,0,0,0,,Мен білемін, айдаһар жауынгер.
Dialogue: 0,0:09:20.02,0:09:22.56,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:09:26.09,0:09:28.56,Default,,0,0,0,,Бұл нені білдіреді? Сіз бұл нені білдіретінін білесіз, солай ма?
Dialogue: 0,0:09:28.66,0:09:32.23,Default,,0,0,0,,Зұлымдарды жұдырықтау және тепкілеу арқылы алқапты қорғаңыз...
Dialogue: 0,0:09:32.57,0:09:33.67,Default,,0,0,0,,Бір нәрсе сияқты
Dialogue: 0,0:09:33.83,0:09:35.24,Default,,0,0,0,,Соғу немесе теуу?
Dialogue: 0,0:09:35.34,0:09:39.64,Default,,0,0,0,,Сіздің ойыңызша, сізді магистр ретінде таңдады ма?
Dialogue: 0,0:09:39.84,0:09:42.58,Default,,0,0,0,,500 жыл күткен айдаһар жауынгері
Dialogue: 0,0:09:42.68,0:09:48.08,Default,,0,0,0,,Жаман балаларды қуып, оларға жеңістің жоғары бестігін беру керек пе?
Dialogue: 0,0:09:48.98,0:09:49.98,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:09:51.32,0:09:55.89,Default,,0,0,0,,Шебер сізден ерекше қасиеттерді көрді.
Dialogue: 0,0:09:56.09,0:10:01.73,Default,,0,0,0,,Сіз оны түсінбейсіз, бірақ сізде шексіз күш бар.
Dialogue: 0,0:10:03.23,0:10:07.00,Default,,0,0,0,,Бұл сіздің қиялыңыздан әлдеқайда жоғары күш.
Dialogue: 0,0:10:23.88,0:10:24.82,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:10:24.95,0:10:26.15,Default,,0,0,0,,Qi инъекциясы
Dialogue: 0,0:10:28.09,0:10:29.02,Default,,0,0,0,,Ки дегеніміз не?
Dialogue: 0,0:10:29.16,0:10:34.03,Default,,0,0,0,,Бұл барлық тірі заттар арқылы өтетін энергия.
Dialogue: 0,0:10:34.13,0:10:37.40,Default,,0,0,0,,Егер мен сенің қожайын болсам, мұны істей аламын ба?
Dialogue: 0,0:10:37.67,0:10:42.24,Default,,0,0,0,,Жоқ, мен таңғажайып нәрсені жаттыға аламын.
Dialogue: 0,0:10:42.90,0:10:46.31,Default,,0,0,0,,Ақыл-ойыңызды басқару үшін алдымен өзіңізді тәртіпке келтіріңіз.
Dialogue: 0,0:10:46.74,0:10:52.05,Default,,0,0,0,,Тіпті гуру үңгірде 30 жыл тұрып, өзіне сұрақ қоя берді.
Dialogue: 0,0:10:52.65,0:10:55.92,Default,,0,0,0,,Мен кіммін? Сен кімсің?
Dialogue: 0,0:10:56.18,0:10:58.69,Default,,0,0,0,,Сіз осында болсаңыз, мен сіздің жолыңызға кедергі келтіремін ...
Dialogue: 0,0:10:58.79,0:11:02.02,Default,,0,0,0,,Мен де 30 жыл өткізуім керек пе?
Dialogue: 0,0:11:02.09,0:11:04.73,Default,,0,0,0,,Сен маған бірінші айт.
Dialogue: 0,0:11:05.03,0:11:08.06,Default,,0,0,0,,Мен Ұстаз сияқты бола алмаймын.
Dialogue: 0,0:11:08.23,0:11:10.33,Default,,0,0,0,,Болудың қажеті жоқ
Dialogue: 0,0:11:10.43,0:11:14.04,Default,,0,0,0,,Мен сені нағыз сен еткім келеді.
Dialogue: 0,0:11:17.17,0:11:20.94,Default,,0,0,0,,Мен маған? Менде ештеңе жоқ
Dialogue: 0,0:11:21.04,0:11:25.21,Default,,0,0,0,,Әңгіменің қиындығы дәл Души сияқты!
Dialogue: 0,0:11:27.38,0:11:30.82,Default,,0,0,0,,Бұл жаман сөз емес, Огвей мырза.
Dialogue: 0,0:11:31.42,0:11:33.82,Default,,0,0,0,,«Мәңгілік бейбітшілікке» оралу
Dialogue: 0,0:12:14.33,0:12:15.83,Default,,0,0,0,,Бұл қай жерде?
Dialogue: 0,0:12:15.90,0:12:18.07,Default,,0,0,0,,Менің ағамның өрісі?
Dialogue: 0,0:12:20.13,0:12:23.00,Default,,0,0,0,,Мен сені басып кетсем, өлесің бе?
Dialogue: 0,0:12:24.41,0:12:25.87,Default,,0,0,0,,Иә
Dialogue: 0,0:12:27.04,0:12:28.94,Default,,0,0,0,,Бұл тән патшалығы.
Dialogue: 0,0:12:29.88,0:12:33.28,Default,,0,0,0,,Огвей Мен қайтып келдім.
Dialogue: 0,0:12:33.95,0:12:36.48,Default,,0,0,0,,Кай-сама қайтып келді!
Dialogue: 0,0:12:38.39,0:12:39.29,Default,,0,0,0,,Кім?
Dialogue: 0,0:12:39.39,0:12:41.02,Default,,0,0,0,,Генерал Кай.
Dialogue: 0,0:12:41.49,0:12:44.26,Default,,0,0,0,,Бүкіл Қытайды басқарған Сенгоку қолбасшысы
Dialogue: 0,0:12:46.33,0:12:48.13,Default,,0,0,0,,«Жад қылыш шебері»
Dialogue: 0,0:12:48.30,0:12:49.90,Default,,0,0,0,,«Ауырсыну туралы евангелист»
Dialogue: 0,0:12:50.26,0:12:52.53,Default,,0,0,0,,«Кек алу аңы» болса ше?
Dialogue: 0,0:12:53.33,0:12:54.37,Default,,0,0,0,,«Күйеуінің өлтірушісі»
Dialogue: 0,0:12:57.47,0:12:59.24,Default,,0,0,0,,Бір кездері Угвей...
Dialogue: 0,0:12:59.34,0:13:01.91,Default,,0,0,0,,Білемін, ол аты аңызға айналған жауынгер.
Dialogue: 0,0:13:02.04,0:13:03.24,Default,,0,0,0,,Души деп аталады...
Dialogue: 0,0:13:03.31,0:13:04.51,Default,,0,0,0,,Жетеді
Dialogue: 0,0:13:04.78,0:13:06.15,Default,,0,0,0,,Шулы!
Dialogue: 0,0:13:13.45,0:13:16.32,Default,,0,0,0,,Огвейдің шәкіртін табыңыз
Dialogue: 0,0:13:23.20,0:13:26.33,Default,,0,0,0,,Мен сенің інің мен балаңнан құтылсам...
Dialogue: 0,0:13:26.43,0:13:30.94,Default,,0,0,0,,Огвейдің атын алып жүретін ешкім қалмайды.
Dialogue: 0,0:13:32.07,0:13:34.94,Default,,0,0,0,,Бұл Кай-саманың әлемі болады!
Dialogue: 0,0:13:37.98,0:13:39.25,Default,,0,0,0,,Дайын
Dialogue: 0,0:13:40.48,0:13:41.95,Default,,0,0,0,,Оқыту
Dialogue: 0,0:13:42.02,0:13:44.29,Default,,0,0,0,,Жаттығу? Ол айдаһардың қожайыны!
Dialogue: 0,0:13:44.39,0:13:45.95,Default,,0,0,0,,Өте әдемі
Dialogue: 0,0:13:46.05,0:13:47.25,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:13:50.36,0:13:52.16,Default,,0,0,0,,Ұстаз, тек өмір...
Dialogue: 0,0:13:53.46,0:13:54.46,Default,,0,0,0,,По?
Dialogue: 0,0:13:54.83,0:13:56.40,Default,,0,0,0,,Сәлем әке
Dialogue: 0,0:13:57.36,0:14:01.20,Default,,0,0,0,,Мен суға түсу үшін тоқтадым.
Dialogue: 0,0:14:05.24,0:14:06.37,Default,,0,0,0,,Не болды?
Dialogue: 0,0:14:06.51,0:14:07.37,Default,,0,0,0,,«Сенім артамын.»
Dialogue: 0,0:14:07.44,0:14:11.01,Default,,0,0,0,,Менің үлкен ұлым қуыршақтармен ойнап жүр?
Dialogue: 0,0:14:11.11,0:14:11.98,Default,,0,0,0,,Сурет
Dialogue: 0,0:14:12.08,0:14:16.12,Default,,0,0,0,,Ал мен ваннама сычуань чили бұрышын салдым.
Dialogue: 0,0:14:16.22,0:14:17.08,Default,,0,0,0,,Сычуань…
Dialogue: 0,0:14:19.02,0:14:20.22,Default,,0,0,0,,Қауіпті бөлік!
Dialogue: 0,0:14:23.06,0:14:24.46,Default,,0,0,0,,Мастер...
Dialogue: 0,0:14:24.53,0:14:27.56,Default,,0,0,0,,Әкеңмен сөйлес.
Dialogue: 0,0:14:27.86,0:14:29.00,Default,,0,0,0,,Қолдарыңызды көтеріңіз
Dialogue: 0,0:14:29.06,0:14:34.20,Default,,0,0,0,,«Мен Айдаһар жауынгерін түсінбеймін, беске айтыңыз.»
Dialogue: 0,0:14:34.34,0:14:38.37,Default,,0,0,0,,Мен айдаһар жауынгері болмасам, онда мен кіммін?
Dialogue: 0,0:14:38.47,0:14:40.88,Default,,0,0,0,,Сіз кунг-фудан сабақ бересіз бе?
Dialogue: 0,0:14:41.14,0:14:44.35,Default,,0,0,0,,Бұл керемет жарнама. Ұсынысты қабылдаңыз.
Dialogue: 0,0:14:44.41,0:14:47.28,Default,,0,0,0,,Бір күні шыңға жетсең
Dialogue: 0,0:14:47.35,0:14:50.25,Default,,0,0,0,,Раменді Хисуи сарайында сата аласыз
Dialogue: 0,0:14:50.89,0:14:55.02,Default,,0,0,0,,Сіз не істеп жатырсыз? Ваннадан шығып, Нефрит сарайына оралыңыз.
Dialogue: 0,0:14:55.09,0:14:57.16,Default,,0,0,0,,Франчайзингті кеңейту
Dialogue: 0,0:14:57.22,0:14:59.13,Default,,0,0,0,,«Айдаһар жауынгеріне ұқсас турнир» туралы не деуге болады?
Dialogue: 0,0:14:59.23,0:15:01.03,Default,,0,0,0,,Чоудың дәйекті жеңістері
Dialogue: 0,0:15:01.53,0:15:02.96,Default,,0,0,0,,Шукаборн
Dialogue: 0,0:15:03.20,0:15:06.63,Default,,0,0,0,,«Ет тоқаш жеу сайысы» ше? Мен патшамын
Dialogue: 0,0:15:06.90,0:15:09.37,Default,,0,0,0,,Сіздің рекордыңызды ешкім бұза алмайды.
Dialogue: 0,0:15:09.67,0:15:11.67,Default,,0,0,0,,Бұзылуы мүмкін рекорд
Dialogue: 0,0:15:12.51,0:15:14.64,Default,,0,0,0,,Жүр! Бар!
Dialogue: 0,0:15:14.94,0:15:16.11,Default,,0,0,0,,Менің жазбам
Dialogue: 0,0:15:16.18,0:15:17.38,Default,,0,0,0,,Бұл тегін!
Dialogue: 0,0:15:18.18,0:15:21.25,Default,,0,0,0,,101 дана 102 дана…
Dialogue: 0,0:15:27.52,0:15:32.06,Default,,0,0,0,,103 дана!
Dialogue: 0,0:15:37.70,0:15:39.03,Default,,0,0,0,,Жаңа жазба?
Dialogue: 0,0:15:39.60,0:15:41.07,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:15:41.44,0:15:43.17,Default,,0,0,0,,Ли Шэн
Dialogue: 0,0:15:43.27,0:15:44.04,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:15:47.11,0:15:51.08,Default,,0,0,0,,Мен Ли Шэнмін, мен ұлымды табуға келдім.
Dialogue: 0,0:15:55.22,0:15:56.48,Default,,0,0,0,,Бөлінген?
Dialogue: 0,0:15:56.58,0:16:00.09,Default,,0,0,0,,Аа, көп жылдар бұрын.
Dialogue: 0,0:16:00.72,0:16:02.22,Default,,0,0,0,,Мен де әкеммен
Dialogue: 0,0:16:02.96,0:16:04.33,Default,,0,0,0,,Бұл қиын болды.
Dialogue: 0,0:16:04.96,0:16:06.09,Default,,0,0,0,,Бұл да
Dialogue: 0,0:16:08.63,0:16:11.07,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:16:12.07,0:16:15.04,Default,,0,0,0,,Ұлыңызды табасыз деп үміттенемін.
Dialogue: 0,0:16:15.50,0:16:17.71,Default,,0,0,0,,Сенің әкең де
Dialogue: 0,0:16:28.45,0:16:29.52,Default,,0,0,0,,Ұлым?
Dialogue: 0,0:16:29.72,0:16:32.09,Default,,0,0,0,,Мен ұлымды таптым!
Dialogue: 0,0:16:33.25,0:16:35.52,Default,,0,0,0,,Мені тез құшақтап алшы.
Dialogue: 0,0:16:38.73,0:16:40.66,Default,,0,0,0,,Ол тірі болды.
Dialogue: 0,0:16:45.37,0:16:48.14,Default,,0,0,0,,Мен сені енді ешқашан көрмеймін деп ойладым.
Dialogue: 0,0:16:48.27,0:16:49.54,Default,,0,0,0,,Кішкентай лотос
Dialogue: 0,0:16:50.37,0:16:55.54,Default,,0,0,0,,Бұл басқа панда болған сияқты. Менің атым По.
Dialogue: 0,0:16:55.71,0:16:57.58,Default,,0,0,0,,Түсіндім, сен...
Dialogue: 0,0:16:57.68,0:16:58.78,Default,,0,0,0,,Жарайды
Dialogue: 0,0:16:59.05,0:17:02.15,Default,,0,0,0,,Сяорэн менің туған есімім еді.
Dialogue: 0,0:17:02.28,0:17:02.75,Default,,0,0,0,,(Роко) Иә, әрине. Мұнда өте жайлы екен.
Dialogue: 0,0:17:03.05,0:17:03.68,Default,,0,0,0,,Байыптылық
Dialogue: 0,0:17:04.02,0:17:08.29,Default,,0,0,0,,Осыншама жылдан кейін осында кездесе алатынымызға сене алар емеспін.
Dialogue: 0,0:17:08.59,0:17:11.13,Default,,0,0,0,,Әке, бұл...
Dialogue: 0,0:17:11.19,0:17:14.23,Default,,0,0,0,,Оны қалай атау керек?
Dialogue: 0,0:17:14.46,0:17:16.13,Default,,0,0,0,,Ол «Ли» деді
Dialogue: 0,0:17:16.50,0:17:18.03,Default,,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,0:17:18.30,0:17:20.03,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:17:21.04,0:17:25.14,Default,,0,0,0,,Ұлымды жақсы тәрбиелегеніңізге рахмет.
Dialogue: 0,0:17:25.21,0:17:28.31,Default,,0,0,0,,Ұлым? Бір минут күте тұрыңыз
Dialogue: 0,0:17:28.54,0:17:32.31,Default,,0,0,0,,Олардың тіпті туыстары екеніне ешқандай дәлел жоқ.
Dialogue: 0,0:17:32.41,0:17:36.32,Default,,0,0,0,,Қараңызшы, егер бұл тек олардың қарындары болса, олар егізге ұқсайды.
Dialogue: 0,0:17:36.42,0:17:38.75,Default,,0,0,0,,Мен саған «хара-дон» үйретемін
Dialogue: 0,0:17:39.25,0:17:40.29,Default,,0,0,0,,Іштің жарылуы
Dialogue: 0,0:17:41.26,0:17:44.12,Default,,0,0,0,,Семіз етіп көрсететін айнадай.
Dialogue: 0,0:17:46.66,0:17:48.56,Default,,0,0,0,,Бірге көшірме туралы не деуге болады?
Dialogue: 0,0:17:52.73,0:17:56.67,Default,,0,0,0,,Подан басқа барлық пандалар жойылуы керек еді.
Dialogue: 0,0:17:57.34,0:17:59.74,Default,,0,0,0,,Негізінде, көп.
Dialogue: 0,0:17:59.84,0:18:00.74,Default,,0,0,0,,Қайда?
Dialogue: 0,0:18:00.84,0:18:03.68,Default,,0,0,0,,Тауларда жасырын панда ауылы бар
Dialogue: 0,0:18:03.74,0:18:05.18,Default,,0,0,0,,Құпия панда...
Dialogue: 0,0:18:07.31,0:18:08.72,Default,,0,0,0,,Мен ше?
Dialogue: 0,0:18:08.78,0:18:11.62,Default,,0,0,0,,Менің осында екенімді хабардар еттім.
Dialogue: 0,0:18:11.72,0:18:13.72,Default,,0,0,0,,Құпия ауылда-
Dialogue: 0,0:18:13.79,0:18:16.19,Default,,0,0,0,,Мұндай жаңалықтың келетініне сене алар емеспін...
Dialogue: 0,0:18:16.29,0:18:17.46,Default,,0,0,0,,Күдікті
Dialogue: 0,0:18:18.63,0:18:21.20,Default,,0,0,0,,Мен кенеттен ғарыштан келдім.
Dialogue: 0,0:18:22.73,0:18:23.50,Default,,0,0,0,,Міне, Абдул мырза дәл осылай дейді
Dialogue: 0,0:18:23.60,0:18:26.77,Default,,0,0,0,,Сіз қашан айдаһар жауынгері болдыңыз?
Dialogue: 0,0:18:27.10,0:18:30.47,Default,,0,0,0,,Мұны саған да ғалам үйретті ме?
Dialogue: 0,0:18:32.11,0:18:33.37,Default,,0,0,0,,Сол плакат...
Dialogue: 0,0:18:33.47,0:18:35.84,Default,,0,0,0,,Мен кәдесый дүкенінен шәй сатып алдым.
Dialogue: 0,0:18:36.24,0:18:38.11,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,0:18:38.78,0:18:43.45,Default,,0,0,0,,Менің саған көрсететін бір нәрсем бар, оны көрсеткім келеді.
Dialogue: 0,0:18:43.52,0:18:44.82,Default,,0,0,0,,Менімен бірге жүр
Dialogue: 0,0:18:46.75,0:18:49.52,Default,,0,0,0,,Мен қазірдің өзінде өзімді мақтан тұтамын
Dialogue: 0,0:18:53.33,0:18:54.60,Default,,0,0,0,,Кішкене ғана
Dialogue: 0,0:18:55.26,0:18:56.36,Default,,0,0,0,,Майды жағу
Dialogue: 0,0:18:57.23,0:19:00.90,Default,,0,0,0,,Сізде «панда астмасы» бар ма? Бұл генетикалық па?
Dialogue: 0,0:19:01.24,0:19:03.77,Default,,0,0,0,,Әке, сізге ұнайды.
Dialogue: 0,0:19:03.87,0:19:05.54,Default,,0,0,0,,Керемет
Dialogue: 0,0:19:06.77,0:19:09.31,Default,,0,0,0,,Бұл «Батырлар залы»
Dialogue: 0,0:19:09.41,0:19:12.51,Default,,0,0,0,,Қытайдың түкпір-түкпірінен қазыналар бар
Dialogue: 0,0:19:13.45,0:19:15.42,Default,,0,0,0,,Мен бұл жерде не айта аламын...
Dialogue: 0,0:19:15.48,0:19:18.62,Default,,0,0,0,,Жақсысың ба? Бұл дұрыс.
Dialogue: 0,0:19:19.42,0:19:21.62,Default,,0,0,0,,Бірақ сақ болыңыз.
Dialogue: 0,0:19:21.69,0:19:25.39,Default,,0,0,0,,«Сыбырлаған жауынгердің қазаны» бұрын сынған...
Dialogue: 0,0:19:25.49,0:19:26.19,Default,,0,0,0,,Кімге?
Dialogue: 0,0:19:26.29,0:19:27.43,Default,,0,0,0,,Кейбір ақымақ
Dialogue: 0,0:19:28.80,0:19:30.70,Default,,0,0,0,,«Ұшатын мүйізтұмсық сауыты»
Dialogue: 0,0:19:30.80,0:19:33.43,Default,,0,0,0,,Бұл сәйкес келе ме деп ойлаймын...
Dialogue: 0,0:19:33.53,0:19:35.70,Default,,0,0,0,,Мен де солай ойладым.
Dialogue: 0,0:19:35.94,0:19:36.77,Default,,0,0,0,,Мен?
Dialogue: 0,0:19:36.87,0:19:38.51,Default,,0,0,0,,Мен қосылуым керек пе?
Dialogue: 0,0:19:38.81,0:19:40.27,Default,,0,0,0,,Мұнда кел
Dialogue: 0,0:19:40.84,0:19:43.41,Default,,0,0,0,,«Шебер қой арбаты»
Dialogue: 0,0:19:43.48,0:19:44.41,Default,,0,0,0,,Мынаны қараңыз
Dialogue: 0,0:19:44.48,0:19:46.18,Default,,0,0,0,,«Шебер егеуқұйрық армиясының дулығасы»
Dialogue: 0,0:19:46.25,0:19:47.51,Default,,0,0,0,,Кіші
Dialogue: 0,0:19:48.22,0:19:50.82,Default,,0,0,0,,«Мастер Ируканың су өткізбейтін сауыты»
Dialogue: 0,0:19:51.19,0:19:54.19,Default,,0,0,0,,Бұл «Император Хоктың ұрыс даласындағы рикшасы»
Dialogue: 0,0:19:55.56,0:19:57.49,Default,,0,0,0,,Бұл керемет көлік.
Dialogue: 0,0:19:58.53,0:20:00.86,Default,,0,0,0,,Әке, маған тиіспе.
Dialogue: 0,0:20:00.96,0:20:03.60,Default,,0,0,0,,Кешіріңіз, оны шешуім керек пе?
Dialogue: 0,0:20:03.80,0:20:05.60,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:20:05.73,0:20:07.73,Default,,0,0,0,,Керемет, бірақ...
Dialogue: 0,0:20:08.57,0:20:11.61,Default,,0,0,0,,Буындар бүгілуі мүмкін бе? Мүйізтұмсықтың иісі қандай?
Dialogue: 0,0:20:11.71,0:20:13.54,Default,,0,0,0,,Найзадан да күшті ме?
Dialogue: 0,0:20:13.61,0:20:18.48,Default,,0,0,0,,Сіз жаудың 1000 солдатымен бей-жай шайқаса аласыз деп ойлайсыз ба?
Dialogue: 0,0:20:19.61,0:20:21.85,Default,,0,0,0,,Мен өзімді жақсы сезінемін.
Dialogue: 0,0:20:22.22,0:20:24.95,Default,,0,0,0,,Бұл не? Тартайық
Dialogue: 0,0:20:35.56,0:20:36.83,Default,,0,0,0,,Мен кішкентай болдым
Dialogue: 0,0:20:39.27,0:20:42.50,Default,,0,0,0,,Тағы не істеуім керек?
Dialogue: 0,0:20:48.61,0:20:50.01,Default,,0,0,0,,Майор аман-есен!
Dialogue: 0,0:20:51.51,0:20:53.48,Default,,0,0,0,,Тезірек!
Dialogue: 0,0:20:53.68,0:20:54.75,Default,,0,0,0,,Саусақ соғысы
Dialogue: 0,0:20:55.25,0:20:56.52,Default,,0,0,0,,Күшейткіштер келді!
Dialogue: 0,0:20:56.62,0:20:57.88,Default,,0,0,0,,Бұл жасырын.
Dialogue: 0,0:21:01.39,0:21:03.36,Default,,0,0,0,,Бұл жігіт көңілді...
Dialogue: 0,0:21:06.29,0:21:07.33,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:21:07.39,0:21:08.43,Default,,0,0,0,,Салқын
Dialogue: 0,0:21:09.86,0:21:10.56,Default,,0,0,0,,Жарайды
Dialogue: 0,0:21:10.66,0:21:11.53,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:21:12.67,0:21:13.67,Default,,0,0,0,,Оны алыңыз
Dialogue: 0,0:21:14.33,0:21:15.84,Default,,0,0,0,,Дельфин стиліндегі шабуыл
Dialogue: 0,0:21:16.70,0:21:18.41,Default,,0,0,0,,Дельфин стиліндегі демалыс
Dialogue: 0,0:21:19.84,0:21:21.64,Default,,0,0,0,,Ұзын өту
Dialogue: 0,0:21:23.68,0:21:24.81,Default,,0,0,0,,Бұл кенеттен.
Dialogue: 0,0:21:25.88,0:21:26.71,Default,,0,0,0,,Иә өту
Dialogue: 0,0:21:26.81,0:21:27.48,Default,,0,0,0,,Жарайды
Dialogue: 0,0:21:27.55,0:21:28.68,Default,,0,0,0,,Жоғары өту
Dialogue: 0,0:21:31.35,0:21:32.59,Default,,0,0,0,,Эй, күте тұрыңыз.
Dialogue: 0,0:21:33.42,0:21:34.82,Default,,0,0,0,,Келіңіз, ұстаз Сай
Dialogue: 0,0:21:34.89,0:21:35.82,Default,,0,0,0,,Зарядтау!
Dialogue: 0,0:21:44.73,0:21:46.50,Default,,0,0,0,,Мен сені ұстаймын~
Dialogue: 0,0:21:46.57,0:21:51.94,Default,,0,0,0,,Мен сені ұстаймын. Мен сені ұстап алайыншы.
Dialogue: 0,0:21:52.41,0:21:54.31,Default,,0,0,0,,Оны кім ұстайды? Ол кім?
Dialogue: 0,0:21:54.44,0:21:56.98,Default,,0,0,0,,Қараңдар, мен сені ұстаймын.
Dialogue: 0,0:21:59.71,0:22:00.98,Default,,0,0,0,,Мастер Сай
Dialogue: 0,0:22:01.35,0:22:03.45,Default,,0,0,0,,Не? Не болды?
Dialogue: 0,0:22:09.46,0:22:10.46,Default,,0,0,0,,Сәлем
Dialogue: 0,0:22:11.49,0:22:12.39,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:22:12.49,0:22:14.56,Default,,0,0,0,,Бұл кім деп ойлайсыз?
Dialogue: 0,0:22:14.63,0:22:17.50,Default,,0,0,0,,Бұл туралы миллион жыл ойласаңыз да, дұрыс түсінбейсіз.
Dialogue: 0,0:22:17.83,0:22:18.93,Default,,0,0,0,,Әкем
Dialogue: 0,0:22:19.03,0:22:20.83,Default,,0,0,0,,Сіз қайдан білдіңіз?
Dialogue: 0,0:22:20.90,0:22:23.07,Default,,0,0,0,,Аа, дәл солай.
Dialogue: 0,0:22:23.34,0:22:24.87,Default,,0,0,0,,сәби әлі тірі. Бұл адам баланы қорғап қалған болар.
Dialogue: 0,0:22:24.97,0:22:28.01,Default,,0,0,0,,Намаз оқитын жолбарыс маймыл тырна жылан
Dialogue: 0,0:22:28.11,0:22:29.54,Default,,0,0,0,,Жылан мырза, солай ма?
Dialogue: 0,0:22:29.61,0:22:30.41,Default,,0,0,0,,Маймыл
Dialogue: 0,0:22:30.48,0:22:31.75,Default,,0,0,0,,Біз бәріміз жақсы доспыз
Dialogue: 0,0:22:31.85,0:22:34.35,Default,,0,0,0,,Және Мастер Шифу
Dialogue: 0,0:22:34.51,0:22:35.48,Default,,0,0,0,,Аңызға айналған
Dialogue: 0,0:22:35.58,0:22:38.79,Default,,0,0,0,,Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:22:38.89,0:22:41.89,Default,,0,0,0,,Әкеңді дайындық бөлмесіне апар.
Dialogue: 0,0:22:41.99,0:22:43.82,Default,,0,0,0,,Сіздің ұлыңыз сіздің қожайыныңыз.
Dialogue: 0,0:22:45.76,0:22:46.79,Default,,0,0,0,,Мен шаршадым...
Dialogue: 0,0:22:46.89,0:22:47.86,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:22:47.96,0:22:49.90,Default,,0,0,0,,«Хризантема бөлмесінде» демалуға рұқсат етіңіз.
Dialogue: 0,0:22:50.00,0:22:53.70,Default,,0,0,0,,Мен жақсымын, сенің сабақ бергеніңді көргім келеді.
Dialogue: 0,0:22:53.77,0:22:55.90,Default,,0,0,0,,Көргіңіз келсе, жаттығуды қараңыз...
Dialogue: 0,0:22:56.00,0:22:56.87,Default,,0,0,0,,Нақты шайқас
Dialogue: 0,0:22:56.97,0:22:57.80,Default,,0,0,0,,Не?
Dialogue: 0,0:22:57.90,0:22:59.61,Default,,0,0,0,,Алқапқа шабуыл жасалды
Dialogue: 0,0:23:00.91,0:23:02.51,Default,,0,0,0,,Шабуыл дегеніміз не?
Dialogue: 0,0:23:02.64,0:23:06.65,Default,,0,0,0,,Егер сіз бұған қарасаңыз, Айдаһар жауынгерін танисыз.
Dialogue: 0,0:23:06.78,0:23:08.15,Default,,0,0,0,,Менің артымнан жүр!
Dialogue: 0,0:23:14.86,0:23:18.13,Default,,0,0,0,,Әділдік жаулары, дайындалыңдар!
Dialogue: 0,0:23:18.43,0:23:19.59,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:23:22.53,0:23:23.53,Default,,0,0,0,,Профессор, шай ішесіз бе?
Dialogue: 0,0:23:28.94,0:23:30.74,Default,,0,0,0,,Неліктен барлығы жасыл?
Dialogue: 0,0:23:31.54,0:23:33.47,Default,,0,0,0,,Нефрит зомби
Dialogue: 0,0:23:33.54,0:23:34.81,Default,,0,0,0,,Нефрит зомби?
Dialogue: 0,0:23:34.91,0:23:36.58,Default,,0,0,0,,Zombie Sui!
Dialogue: 0,0:23:37.94,0:23:39.08,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:23:39.55,0:23:41.65,Default,,0,0,0,,Жарайды, күнде істе...
Dialogue: 0,0:23:43.68,0:23:45.72,Default,,0,0,0,,Бұл таяқ шебері
Dialogue: 0,0:23:45.82,0:23:48.96,Default,,0,0,0,,Мастер Борсық ағайындылардың бір уақытта ұсақтау таяқшасы.
Dialogue: 0,0:23:50.06,0:23:51.96,Default,,0,0,0,,Дәл!
Dialogue: 0,0:23:52.09,0:23:55.10,Default,,0,0,0,,Мына жерде... Ұстаз кірпі!
Dialogue: 0,0:23:58.77,0:24:00.57,Default,,0,0,0,,Өлгеннен кейін 100 жыл өтуі керек
Dialogue: 0,0:24:00.80,0:24:02.54,Default,,0,0,0,,Аңызға айналған шеберлер
Dialogue: 0,0:24:03.10,0:24:04.74,Default,,0,0,0,,Жылдам көшіру
Dialogue: 0,0:24:12.05,0:24:13.21,Default,,0,0,0,,Фотосурет алдыңыз ба?
Dialogue: 0,0:24:13.78,0:24:16.12,Default,,0,0,0,,Көзі жұмылған тағы бір сурет
Dialogue: 0,0:24:19.75,0:24:23.59,Default,,0,0,0,,Шебер кірпі «тұншықтырып алу» ең жақсы болды...
Dialogue: 0,0:24:23.99,0:24:25.73,Default,,0,0,0,,Қарашы, бұл сенсің.
Dialogue: 0,0:24:25.79,0:24:27.56,Default,,0,0,0,,По, шоғырлан.
Dialogue: 0,0:24:27.76,0:24:31.83,Default,,0,0,0,,«Ғалам жаңалықтары» дегеніміз не? Бүркіттің жаңалықтарын тыңдаңыз.
Dialogue: 0,0:24:31.90,0:24:33.70,Default,,0,0,0,,Менің баламнан аулақ жүр!
Dialogue: 0,0:24:34.77,0:24:35.67,Default,,0,0,0,,Кейінірек
Dialogue: 0,0:24:35.74,0:24:37.50,Default,,0,0,0,,Жаңа таба
Dialogue: 0,0:24:37.60,0:24:38.84,Default,,0,0,0,,Осылай орындаңыз
Dialogue: 0,0:24:41.14,0:24:42.14,Default,,0,0,0,,Сяорэн!
Dialogue: 0,0:24:47.98,0:24:49.25,Default,,0,0,0,,Өлімге әкелетін ет оқ!
Dialogue: 0,0:25:00.96,0:25:01.83,Default,,0,0,0,,Мен мүлде не болып жатқанын түсінбеймін.
Dialogue: 0,0:25:06.90,0:25:08.64,Default,,0,0,0,,♬ Мен бара жатқан жер — әлі көрінбеген тағдыр
Dialogue: 0,0:25:09.10,0:25:11.71,Default,,0,0,0,,Мен де саған қамқор боламын
Dialogue: 0,0:25:11.81,0:25:12.51,Default,,0,0,0,,Демек, сен болған болашаққа қайта орала алмаймын дегің келе ме?
Dialogue: 0,0:25:12.57,0:25:13.94,Default,,0,0,0,,Барлығы айтады
Dialogue: 0,0:25:14.04,0:25:16.21,Default,,0,0,0,,Бұл рас, мен қорқамын.
Dialogue: 0,0:25:16.51,0:25:18.55,Default,,0,0,0,,Біз де бірдеңе істейік
Dialogue: 0,0:25:18.65,0:25:21.92,Default,,0,0,0,,Мазмұнды шешпесеңіз, ақымақ болып көрінесіз.
Dialogue: 0,0:25:21.98,0:25:25.99,Default,,0,0,0,,Идиоттар! Қай сөйлеп тұр.
Dialogue: 0,0:25:26.85,0:25:27.65,Default,,0,0,0,,Кім?
Dialogue: 0,0:25:27.75,0:25:29.66,Default,,0,0,0,,Жарайды, түсіндім.
Dialogue: 0,0:25:36.03,0:25:37.23,Default,,0,0,0,,Сіз оны жаңа ғана көрдіңіз бе?
Dialogue: 0,0:25:37.53,0:25:39.87,Default,,0,0,0,,Жасыл түтін шығады
Dialogue: 0,0:25:39.93,0:25:41.53,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:25:41.70,0:25:44.67,Default,,0,0,0,,Кай Кай Кай…
Dialogue: 0,0:25:45.07,0:25:46.54,Default,,0,0,0,,Мен оны бірінші рет естіп тұрмын.
Dialogue: 0,0:25:47.01,0:25:50.01,Default,,0,0,0,,Кай Кай... ол қайда?
Dialogue: 0,0:25:50.11,0:25:53.08,Default,,0,0,0,,Құжаттар өте көп болды... Міне болды!
Dialogue: 0,0:25:54.88,0:25:56.28,Default,,0,0,0,,Мынаны қараңыз
Dialogue: 0,0:25:57.72,0:26:00.09,Default,,0,0,0,,Барлық жауаптар осында
Dialogue: 0,0:26:02.22,0:26:03.12,Default,,0,0,0,,Не?
Dialogue: 0,0:26:03.22,0:26:04.59,Default,,0,0,0,,Бұл бос бет пе?
Dialogue: 0,0:26:05.16,0:26:07.83,Default,,0,0,0,,Бұл тағы да солай ма?
Dialogue: 0,0:26:09.63,0:26:11.60,Default,,0,0,0,,Күте тұрыңыз, алда тағы да бар.
Dialogue: 0,0:26:11.70,0:26:13.80,Default,,0,0,0,,Міне, оқыңыз.
Dialogue: 0,0:26:14.80,0:26:17.17,Default,,0,0,0,,Бұл Мастер Угвейдің мінезі.
Dialogue: 0,0:26:17.30,0:26:19.71,Default,,0,0,0,,«Баяғыда менің ағам бар еді...»
Dialogue: 0,0:26:19.87,0:26:21.27,Default,,0,0,0,,Душидің ағасы бар ма?
Dialogue: 0,0:26:21.57,0:26:24.84,Default,,0,0,0,,«Олар ағайындай болды»
Dialogue: 0,0:26:24.95,0:26:26.95,Default,,0,0,0,,Осының бәрін неге таратпасқа?
Dialogue: 0,0:26:28.25,0:26:30.12,Default,,0,0,0,,«Мен ол кезде жас едім...»
Dialogue: 0,0:26:30.22,0:26:32.59,Default,,0,0,0,,Үлкен әскерге басшылық ету
Dialogue: 0,0:26:34.69,0:26:37.62,Default,,0,0,0,,Кай үнемі қасымда болатын
Dialogue: 0,0:26:38.36,0:26:40.33,Default,,0,0,0,,Менің ең жақын досым
Dialogue: 0,0:26:43.26,0:26:48.13,Default,,0,0,0,,Бір күні маған тосын шабуыл жасалып, ауыр жарақат алдым.
Dialogue: 0,0:26:48.27,0:26:52.67,Default,,0,0,0,,Кай көмек сұрап, мені күндер бойы көтеріп жүрді.
Dialogue: 0,0:26:53.31,0:26:57.94,Default,,0,0,0,,Таудың тереңінен мен құпия ауылды таптым.
Dialogue: 0,0:26:58.04,0:27:01.15,Default,,0,0,0,,Емдік сыры ерте заманнан бері келе жатыр.
Dialogue: 0,0:27:01.21,0:27:03.85,Default,,0,0,0,,Пандаларға толы ауыл
Dialogue: 0,0:27:04.72,0:27:05.75,Default,,0,0,0,,Панда ауылы?
Dialogue: 0,0:27:05.82,0:27:07.72,Default,,0,0,0,,Иә панда
Dialogue: 0,0:27:08.12,0:27:12.29,Default,,0,0,0,,Пандалар менің жараларымды емдеу үшін цигонды қолданды.
Dialogue: 0,0:27:15.73,0:27:18.77,Default,,0,0,0,,Ол маған қуат беруді де үйретті.
Dialogue: 0,0:27:22.34,0:27:26.07,Default,,0,0,0,,Бірақ Кай бар күшін пайдаланады
Dialogue: 0,0:27:26.14,0:27:28.04,Default,,0,0,0,,Оны менікі етуге тырысты
Dialogue: 0,0:27:28.68,0:27:33.15,Default,,0,0,0,,Егер сіз маған қуат бере алсаңыз, мен де оны алып тастай аламын...
Dialogue: 0,0:27:36.98,0:27:39.05,Default,,0,0,0,,Оны тоқтатудан басқа амалым қалмады.
Dialogue: 0,0:27:44.02,0:27:46.43,Default,,0,0,0,,Біздің шайқас жерді тербетеді
Dialogue: 0,0:27:46.93,0:27:51.97,Default,,0,0,0,,Ақырында мен оны «жан патшалығына» апардым.
Dialogue: 0,0:27:52.07,0:27:54.93,Default,,0,0,0,,Ол «тән патшалығына» қайтып келгенде —
Dialogue: 0,0:27:55.00,0:27:59.21,Default,,0,0,0,,Тек Qigong пайдаланушыларын тоқтатуға болады.
Dialogue: 0,0:27:59.41,0:28:01.21,Default,,0,0,0,,Цигонг қолданушысы...
Dialogue: 0,0:28:01.31,0:28:02.11,Default,,0,0,0,,Мастер
Dialogue: 0,0:28:02.21,0:28:06.95,Default,,0,0,0,,Мен сияқтылар үңгірде 30 жыл тұруы керек.
Dialogue: 0,0:28:07.05,0:28:08.05,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:28:08.11,0:28:12.35,Default,,0,0,0,,Кай шеберге шабуыл жасауды және оның энергиясын ұрлауды жалғастырады.
Dialogue: 0,0:28:12.69,0:28:13.19,Default,,0,0,0,,Алдын алу
Dialogue: 0,0:28:13.25,0:28:16.29,Default,,0,0,0,,Бірақ ол күшейе береді
Dialogue: 0,0:28:16.36,0:28:17.86,Default,,0,0,0,,Бізде күресуден басқа амал жоқ
Dialogue: 0,0:28:17.96,0:28:19.69,Default,,0,0,0,,Мен саған үйретемін
Dialogue: 0,0:28:21.13,0:28:23.10,Default,,0,0,0,,Мен цигонды қолдана аламын ба?
Dialogue: 0,0:28:23.43,0:28:25.97,Default,,0,0,0,,Мен пандамын
Dialogue: 0,0:28:26.70,0:28:29.84,Default,,0,0,0,,Ғалам мені әке жіберді.
Dialogue: 0,0:28:29.97,0:28:31.91,Default,,0,0,0,,Не істеуім керек?
Dialogue: 0,0:28:32.01,0:28:33.91,Default,,0,0,0,,Үйге бірге барайық
Dialogue: 0,0:28:34.17,0:28:35.04,Default,,0,0,0,,Не?
Dialogue: 0,0:28:35.14,0:28:36.71,Default,,0,0,0,,Панда ауылына?
Dialogue: 0,0:28:36.81,0:28:41.25,Default,,0,0,0,,Алдымен панданың не екенін сезіну керек.
Dialogue: 0,0:28:41.78,0:28:45.25,Default,,0,0,0,,Панда сияқты өмір сүріп, ұйықтап қал...
Dialogue: 0,0:28:45.35,0:28:47.19,Default,,0,0,0,,Панда сияқты тамақтаныңыз
Dialogue: 0,0:28:47.95,0:28:49.86,Default,,0,0,0,,103 ет тоқаштары?
Dialogue: 0,0:28:50.76,0:28:52.36,Default,,0,0,0,,Қызу
Dialogue: 0,0:28:52.93,0:28:56.36,Default,,0,0,0,,Мен де күш-қуатым артқандай сезіндім.
Dialogue: 0,0:28:56.46,0:29:00.40,Default,,0,0,0,,Сіз Поды ұрламақшысыз ба? Басқа да пікірлерді тыңдайық
Dialogue: 0,0:29:00.50,0:29:02.94,Default,,0,0,0,,Толығырақ
Dialogue: 0,0:29:03.50,0:29:04.94,Default,,0,0,0,,Ол кетуі керек
Dialogue: 0,0:29:05.04,0:29:09.08,Default,,0,0,0,,Маймыл Жылан Жолбарыс Сіздің пікіріңіз қандай?
Dialogue: 0,0:29:09.14,0:29:14.51,Default,,0,0,0,,Тек цигонг қолданушылары Кайды тоқтата алады.
Dialogue: 0,0:29:14.78,0:29:18.15,Default,,0,0,0,,Пайдаланушы болу үшін сіз өзіңізді білуіңіз керек
Dialogue: 0,0:29:19.25,0:29:20.49,Default,,0,0,0,,Мен пандамын
Dialogue: 0,0:29:24.86,0:29:27.03,Default,,0,0,0,,Мен сенің түскі асыңды жинаймын.
Dialogue: 0,0:29:33.27,0:29:36.24,Default,,0,0,0,,Қалай ойлайсың, По уақытында жетеді ме?
Dialogue: 0,0:29:36.30,0:29:40.07,Default,,0,0,0,,Маңыздысы мен емес, ғаламның не ойлайтыны.
Dialogue: 0,0:29:40.17,0:29:41.91,Default,,0,0,0,,Сонда «жоқ»?
Dialogue: 0,0:29:42.24,0:29:43.88,Default,,0,0,0,,Біз не істейміз?
Dialogue: 0,0:29:44.04,0:29:45.98,Default,,0,0,0,,Кайдың жүрген жерін табыңыз
Dialogue: 0,0:29:46.08,0:29:49.35,Default,,0,0,0,,Бірақ ұрыспаңыз.
Dialogue: 0,0:29:49.45,0:29:53.05,Default,,0,0,0,,Кай қожайынмен күресу арқылы күшейеді
Dialogue: 0,0:29:53.15,0:29:55.05,Default,,0,0,0,,Мен сұрақ қойған адаммын ба?
Dialogue: 0,0:29:55.39,0:29:57.32,Default,,0,0,0,,Өйткені сіз ұша аласыз
Dialogue: 0,0:29:57.49,0:29:58.42,Default,,0,0,0,,Уууууууу!!
Dialogue: 0,0:29:58.89,0:30:00.46,Default,,0,0,0,,Өйткені ол тұмсықты шымшып алады.
Dialogue: 0,0:30:01.06,0:30:01.96,Default,,0,0,0,,Сізге де бару керек.
Dialogue: 0,0:30:02.06,0:30:03.40,Default,,0,0,0,,Неліктен? Ал егер...
Dialogue: 0,0:30:03.46,0:30:04.20,Default,,0,0,0,,Иә.
Dialogue: 0,0:30:31.22,0:30:32.46,Default,,0,0,0,,Әй, түс болды.
Dialogue: 0,0:30:33.89,0:30:35.53,Default,,0,0,0,,Тіпті мен сенің естеліктеріңе үңілсем де—
Dialogue: 0,0:30:36.23,0:30:37.16,Default,,0,0,0,,Тек баралдай
Dialogue: 0,0:30:37.26,0:30:37.96,Default,,0,0,0,,Не?
Dialogue: 0,0:30:38.10,0:30:38.90,Default,,0,0,0,,Әке.
Dialogue: 0,0:30:39.37,0:30:40.17,Default,,0,0,0,,Не?
Dialogue: 0,0:30:40.27,0:30:41.30,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:30:41.43,0:30:46.11,Default,,0,0,0,,Мен жай ғана арқамды ауырттым. Мен әдейі жаман жолға түстім.
Dialogue: 0,0:30:46.27,0:30:48.07,Default,,0,0,0,,Жоқ Неліктен мұнда?
Dialogue: 0,0:30:48.17,0:30:51.98,Default,,0,0,0,,Панданың тағамы оның дәміне сәйкес келмесе ше?
Dialogue: 0,0:30:52.08,0:30:55.52,Default,,0,0,0,,Аш болсаң әлемді құтқара алмайсың.
Dialogue: 0,0:30:56.02,0:30:58.35,Default,,0,0,0,,Сондықтан маған қыран керек
Dialogue: 0,0:30:58.45,0:31:02.62,Default,,0,0,0,,Бірақ ауылдың қайда екенін басқалардың білгенін қаламаймын.
Dialogue: 0,0:31:02.89,0:31:03.86,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:31:04.02,0:31:07.19,Default,,0,0,0,,Құпия сақтай алмаймын дейсің бе?
Dialogue: 0,0:31:07.26,0:31:11.46,Default,,0,0,0,,Олар Поның асырап алған бала екенін 20 жыл бойы құпия ұстады.
Dialogue: 0,0:31:11.56,0:31:12.33,Default,,0,0,0,,Дегенмен, мен әлі күн бойы Толық шоғырланған тыныс алуды ұстап тұра алмаймын.
Dialogue: 0,0:31:13.53,0:31:16.94,Default,,0,0,0,,Үйге ұшып баруыңызды өтінгеніңіз қатыгездік болар еді.
Dialogue: 0,0:31:18.50,0:31:20.01,Default,,0,0,0,,Сіз ұша аласыз ба?
Dialogue: 0,0:31:20.27,0:31:21.44,Default,,0,0,0,,Бүркіт – құс
Dialogue: 0,0:31:38.46,0:31:39.29,Default,,0,0,0,,Біз келдік
Dialogue: 0,0:31:44.00,0:31:46.33,Default,,0,0,0,,Ол шыңға дейін жалғасады.
Dialogue: 0,0:31:47.17,0:31:49.07,Default,,0,0,0,,Менің ұлым баспалдақтарды жек көреді.
Dialogue: 0,0:31:49.17,0:31:50.50,Default,,0,0,0,,Жүр, үйге қайтайық.
Dialogue: 0,0:31:50.64,0:31:53.24,Default,,0,0,0,,Пандаларға баспалдақ қажет емес
Dialogue: 0,0:31:53.37,0:31:55.24,Default,,0,0,0,,Мен бұл сөздерді күттім.
Dialogue: 0,0:31:59.45,0:32:00.18,Default,,0,0,0,,Міне, Абдул мырза дәл осылай дейді
Dialogue: 0,0:32:23.57,0:32:26.21,Default,,0,0,0,,Бұл жасырын панда ауылы ма?
Dialogue: 0,0:32:26.34,0:32:31.48,Default,,0,0,0,,Бұл менде оны құпия сақтағым келеді. Мен оны ешкімнің көргенін қаламаймын.
Dialogue: 0,0:32:36.05,0:32:37.62,Default,,0,0,0,,Енді, «Уау!»
Dialogue: 0,0:32:37.72,0:32:39.95,Default,,0,0,0,,Уау~
Dialogue: 0,0:32:58.14,0:32:59.21,Default,,0,0,0,,Сәлем
Dialogue: 0,0:33:14.99,0:33:15.66,Default,,0,0,0,,Ли?
Dialogue: 0,0:33:15.76,0:33:17.39,Default,,0,0,0,,Ли қайтып келді.
Dialogue: 0,0:33:17.52,0:33:18.42,Default,,0,0,0,,Екі адам бар.
Dialogue: 0,0:33:18.52,0:33:19.53,Default,,0,0,0,,Ұлым да
Dialogue: 0,0:33:19.66,0:33:20.53,Default,,0,0,0,,Иә!
Dialogue: 0,0:33:21.46,0:33:23.03,Default,,0,0,0,,Ұлымды таптым
Dialogue: 0,0:33:24.43,0:33:26.13,Default,,0,0,0,,Қазір кеттік!
Dialogue: 0,0:33:27.00,0:33:28.03,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:33:29.04,0:33:30.20,Default,,0,0,0,,Неге жүгіресің?
Dialogue: 0,0:33:34.27,0:33:35.68,Default,,0,0,0,,Ли қайтып келді
Dialogue: 0,0:33:47.29,0:33:51.02,Default,,0,0,0,,Жиналыңдар, бұл менің ұлым.
Dialogue: 0,0:33:51.12,0:33:52.13,Default,,0,0,0,,Сіз келдіңіз.
Dialogue: 0,0:33:52.29,0:33:53.76,Default,,0,0,0,,Үшемдер?
Dialogue: 0,0:33:54.03,0:33:55.46,Default,,0,0,0,,Ол салқындап тұр
Dialogue: 0,0:33:55.76,0:33:58.23,Default,,0,0,0,,Эй, мен печеньенің иісін сезіп тұрмын.
Dialogue: 0,0:33:58.33,0:34:02.20,Default,,0,0,0,,Әкесі сияқты әдемі.
Dialogue: 0,0:34:02.30,0:34:03.14,Default,,0,0,0,,Сәлем
Dialogue: 0,0:34:03.44,0:34:07.11,Default,,0,0,0,,Олар сенің немере ағаларың, Тен мен Шин.
Dialogue: 0,0:34:07.24,0:34:08.04,Default,,0,0,0,,Нағашы аға!
Dialogue: 0,0:34:08.14,0:34:09.11,Default,,0,0,0,,Сізді көргеніме қуаныштымын
Dialogue: 0,0:34:09.24,0:34:10.81,Default,,0,0,0,,Никуман жағасы
Dialogue: 0,0:34:11.08,0:34:12.68,Default,,0,0,0,,«Рей тағамдары»
Dialogue: 0,0:34:13.81,0:34:15.58,Default,,0,0,0,,Мен саған тағы біреуін беремін.
Dialogue: 0,0:34:17.05,0:34:17.75,Default,,0,0,0,,Бұл сен бе!
Dialogue: 0,0:34:18.05,0:34:20.72,Default,,0,0,0,,Сәлем, бұл тамаша құшақтау.
Dialogue: 0,0:34:20.82,0:34:22.59,Default,,0,0,0,,Мен ешкімді танымаймын
Dialogue: 0,0:34:22.69,0:34:25.32,Default,,0,0,0,,Жолақты сәби сүйкімді
Dialogue: 0,0:34:26.19,0:34:28.39,Default,,0,0,0,,Бұл менің фигурам...
Dialogue: 0,0:34:28.46,0:34:29.53,Default,,0,0,0,,Маған беріңіз
Dialogue: 0,0:34:29.63,0:34:30.60,Default,,0,0,0,,Сонымен…
Dialogue: 0,0:34:32.50,0:34:36.14,Default,,0,0,0,,Әрине, бұл сыйлық. Оған қамқорлық жасаңыз.
Dialogue: 0,0:34:36.24,0:34:37.60,Default,,0,0,0,,Жолақты сәби
Dialogue: 0,0:34:39.67,0:34:43.08,Default,,0,0,0,,Бала маған ұқсайды
Dialogue: 0,0:34:46.35,0:34:49.08,Default,,0,0,0,,Сіз кемпірсіз
Dialogue: 0,0:34:49.28,0:34:51.78,Default,,0,0,0,,Маған қарағанда май көп
Dialogue: 0,0:34:52.35,0:34:54.09,Default,,0,0,0,,Ал сен...
Dialogue: 0,0:34:55.35,0:34:56.52,Default,,0,0,0,,Қалпақ
Dialogue: 0,0:34:57.79,0:34:59.49,Default,,0,0,0,,Қалпақ сияқты!
Dialogue: 0,0:34:59.63,0:35:01.53,Default,,0,0,0,,Барлығы маған ұқсайды
Dialogue: 0,0:35:02.70,0:35:05.23,Default,,0,0,0,,Ас ішейік, баламның тойы.
Dialogue: 0,0:35:08.43,0:35:11.80,Default,,0,0,0,,Пандалар жүрмейді, айналады!
Dialogue: 0,0:35:16.41,0:35:18.85,Default,,0,0,0,,Қандай күлкілі көрініс.
Dialogue: 0,0:35:20.61,0:35:22.32,Default,,0,0,0,,По, сен не істеп жатырсың?
Dialogue: 0,0:35:37.43,0:35:39.53,Default,,0,0,0,,Әрине, жаяу жүруден де жақсы
Dialogue: 0,0:35:45.57,0:35:47.74,Default,,0,0,0,,Мен неге айналдыра алмаймын?
Dialogue: 0,0:35:47.84,0:35:49.84,Default,,0,0,0,,Егер сіз пандалармен жаңадан таныс болсаңыз...
Dialogue: 0,0:35:50.14,0:35:53.48,Default,,0,0,0,,Ағаң қандай панда? Сізде ұзын мойын бар
Dialogue: 0,0:35:53.55,0:35:54.75,Default,,0,0,0,,Панда емес
Dialogue: 0,0:35:55.31,0:35:57.25,Default,,0,0,0,,Қалпақ тұмсық қанат
Dialogue: 0,0:35:57.65,0:35:58.75,Default,,0,0,0,,Ет тоқаш
Dialogue: 0,0:35:59.39,0:36:01.25,Default,,0,0,0,,Сұрақтардың соңы
Dialogue: 0,0:36:01.49,0:36:03.16,Default,,0,0,0,,Бұл сіздің таяқшаларыңыз.
Dialogue: 0,0:36:03.22,0:36:04.22,Default,,0,0,0,,Рахмет
Dialogue: 0,0:36:05.63,0:36:06.39,Default,,0,0,0,,Не?
Dialogue: 0,0:36:06.86,0:36:08.16,Default,,0,0,0,,Мына таяқша ше?
Dialogue: 0,0:36:08.26,0:36:10.36,Default,,0,0,0,,Таяқшалар Ет тоқаштарын ал
Dialogue: 0,0:36:10.46,0:36:13.23,Default,,0,0,0,,Сіз бір-бірден жейсіз бе?
Dialogue: 0,0:36:19.87,0:36:22.54,Default,,0,0,0,,Мен өзімді көбірек күшке ие болғандай сезіндім.
Dialogue: 0,0:36:36.89,0:36:39.33,Default,,0,0,0,,Мен Меймеймін
Dialogue: 0,0:36:39.46,0:36:42.76,Default,,0,0,0,,«Бұл керемет, өте әдемі».
Dialogue: 0,0:36:42.86,0:36:44.33,Default,,0,0,0,,Жақсы жұмыс, По.
Dialogue: 0,0:36:44.40,0:36:48.60,Default,,0,0,0,,Басқа мақтау сөздер биден кейін келеді.
Dialogue: 0,0:36:50.27,0:36:51.54,Default,,0,0,0,,Мен ештеңе айтқан жоқпын...
Dialogue: 0,0:36:52.87,0:36:54.37,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:36:54.84,0:36:56.44,Default,,0,0,0,,Биден кейін
Dialogue: 0,0:36:56.54,0:36:58.48,Default,,0,0,0,,Сіз әлі бастаған жоқсыз ба?
Dialogue: 0,0:37:01.61,0:37:04.48,Default,,0,0,0,,Бұл әлемдегі ең жақсы лента биі.
Dialogue: 0,0:37:05.35,0:37:06.55,Default,,0,0,0,,Адамның өзіне сәйкес...
Dialogue: 0,0:37:06.65,0:37:08.35,Default,,0,0,0,,Маған қарама
Dialogue: 0,0:37:08.42,0:37:10.62,Default,,0,0,0,,Бірақ сенің көзің соған жабысты.
Dialogue: 0,0:37:10.76,0:37:13.99,Default,,0,0,0,,Неліктен ол маған үнемі қарап тұрады?
Dialogue: 0,0:37:14.36,0:37:15.63,Default,,0,0,0,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:37:17.50,0:37:18.97,Default,,0,0,0,,Мен билей алмаймын
Dialogue: 0,0:37:19.27,0:37:22.34,Default,,0,0,0,,Биле алмайтын панда жоқ.
Dialogue: 0,0:37:23.60,0:37:24.84,Default,,0,0,0,,Мен ойды түсіндім.
Dialogue: 0,0:37:25.40,0:37:27.71,Default,,0,0,0,,«Бұл өте әдемі панда».
Dialogue: 0,0:37:31.51,0:37:32.51,Default,,0,0,0,,Маған?
Dialogue: 0,0:37:35.38,0:37:36.25,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:37:36.58,0:37:37.28,Default,,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,0:37:37.38,0:37:38.45,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:37:38.52,0:37:39.79,Default,,0,0,0,,Сіз жақсы жұмыс істеп жатырсыз
Dialogue: 0,0:37:42.02,0:37:43.29,Default,,0,0,0,,Сіздің кезегіңіз
Dialogue: 0,0:37:56.74,0:37:57.97,Default,,0,0,0,,Біз жарты жолды өтіп қойдық — бізді тежеме, жарай ма?
Dialogue: 0,0:37:59.71,0:38:01.84,Default,,0,0,0,,Жақында сауығып кетесіз
Dialogue: 0,0:38:03.54,0:38:05.28,Default,,0,0,0,,Үйренуге болатын көп нәрсе
Dialogue: 0,0:38:13.95,0:38:15.79,Default,,0,0,0,,«Барлау қанаттары»
Dialogue: 0,0:38:16.36,0:38:17.42,Default,,0,0,0,,Білемін, білемін!
Dialogue: 0,0:38:17.69,0:38:21.29,Default,,0,0,0,,«Қандай қанаттар» деп дереу айтыңыз
Dialogue: 0,0:38:21.39,0:38:23.93,Default,,0,0,0,,Мен үшін бұл «күш тигізу» болар еді.
Dialogue: 0,0:38:24.00,0:38:26.97,Default,,0,0,0,,«Сэндвич жасайтын орақ» немесе сол сияқты.
Dialogue: 0,0:38:27.03,0:38:28.63,Default,,0,0,0,,«Мен олай ойламаймын»
Dialogue: 0,0:38:29.04,0:38:29.77,Default,,0,0,0,,Алмастар! Мұнда алмастар көмілген.
Dialogue: 0,0:38:31.54,0:38:34.54,Default,,0,0,0,,Сізге не болды үш шебер?
Dialogue: 0,0:38:34.61,0:38:37.98,Default,,0,0,0,,Мен ауылға шабуыл жасаған нефрит құбыжықты қудым.
Dialogue: 0,0:38:38.04,0:38:39.31,Default,,0,0,0,,О? Сіздер әлдеқашан бастадыңыздар ма? Әңгіме
Dialogue: 0,0:38:42.32,0:38:43.98,Default,,0,0,0,,Олар осында.
Dialogue: 0,0:38:44.82,0:38:47.45,Default,,0,0,0,,Шифу ақсақал маған соғыспау керектігін айтты...
Dialogue: 0,0:38:50.76,0:38:52.02,Default,,0,0,0,,Бұйрық
Dialogue: 0,0:38:52.33,0:38:53.46,Default,,0,0,0,,Біз де барайық
Dialogue: 0,0:38:53.86,0:38:56.73,Default,,0,0,0,,Мастер Тауық та барады.
Dialogue: 0,0:38:56.80,0:38:57.86,Default,,0,0,0,,Жалқау болсам да
Dialogue: 0,0:39:07.01,0:39:08.51,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:39:08.61,0:39:09.74,Default,,0,0,0,,Бірақ бұйрық...
Dialogue: 0,0:39:09.81,0:39:12.75,Default,,0,0,0,,Маған көмек керек! жоғарыдан барасың
Dialogue: 0,0:39:12.81,0:39:13.88,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:39:14.61,0:39:17.88,Default,,0,0,0,,Бұл мантидің күші. Дайын бол.
Dialogue: 0,0:39:18.88,0:39:19.89,Default,,0,0,0,,Енді барайық
Dialogue: 0,0:39:20.39,0:39:22.56,Default,,0,0,0,,Қуат тию! Бұл жұмыс істемейді
Dialogue: 0,0:39:22.66,0:39:23.62,Default,,0,0,0,,Манты
Dialogue: 0,0:39:28.69,0:39:29.76,Default,,0,0,0,,Манты?
Dialogue: 0,0:39:31.36,0:39:32.47,Default,,0,0,0,,Манты
Dialogue: 0,0:39:45.08,0:39:46.95,Default,,0,0,0,,Сіздің рухыңыз күшті
Dialogue: 0,0:39:47.75,0:39:50.92,Default,,0,0,0,,Сенің досың да қателесуші жігіт.
Dialogue: 0,0:39:51.92,0:39:52.92,Default,,0,0,0,,Манты
Dialogue: 0,0:40:01.59,0:40:06.17,Default,,0,0,0,,Котори-чан, мен сенің энергияңды ұқыпты пайдаланамын.
Dialogue: 0,0:40:06.93,0:40:11.14,Default,,0,0,0,,Нефрит қамалын және оның тұрғындарын талқандау.
Dialogue: 0,0:40:11.80,0:40:12.94,Default,,0,0,0,,Маған мұны істеуге рұқсат етіңіз!
Dialogue: 0,0:40:19.65,0:40:20.51,Default,,0,0,0,,Әділет...
Dialogue: 0,0:40:20.68,0:40:21.71,Default,,0,0,0,,Қанаттар!
Dialogue: 0,0:40:29.62,0:40:31.96,Default,,0,0,0,,Бұл панда жаттығуларының бірінші күні.
Dialogue: 0,0:40:32.06,0:40:33.49,Default,,0,0,0,,Тыңда, гүл.
Dialogue: 0,0:40:33.93,0:40:35.96,Default,,0,0,0,,Мен сені гүлдендіремін
Dialogue: 0,0:40:38.56,0:40:39.53,Default,,0,0,0,,Әке.
Dialogue: 0,0:40:39.60,0:40:40.57,Default,,0,0,0,,Не?
Dialogue: 0,0:40:40.80,0:40:42.67,Default,,0,0,0,,Бұл панда жаттығуларының бірінші күні.
Dialogue: 0,0:40:42.84,0:40:45.57,Default,,0,0,0,,Біз әлемді құтқару үшін цигонды қолдануымыз керек.
Dialogue: 0,0:40:45.67,0:40:48.01,Default,,0,0,0,,Пандалар түске дейін ұйықтайды
Dialogue: 0,0:40:48.11,0:40:50.94,Default,,0,0,0,,1-сабақ «екі рет ұйықтау»
Dialogue: 0,0:40:52.04,0:40:53.11,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:40:56.12,0:40:57.98,Default,,0,0,0,,Бұл қиын жаттығу болады
Dialogue: 0,0:41:03.96,0:41:04.89,Default,,0,0,0,,Сіз көп ұйықтадыңыз ба?
Dialogue: 0,0:41:05.59,0:41:06.56,Default,,0,0,0,,Директор, Шығыс пен Батыс арасындағы бейбітшіліктің тағдыры осы «Стракс» операциясына тәуелді,
Dialogue: 0,0:41:06.63,0:41:07.59,Default,,0,0,0,,Өмірдің өткелін белгілейтін ессіз сағат
Dialogue: 0,0:41:07.73,0:41:08.86,Default,,0,0,0,,Айтыңызшы
Dialogue: 0,0:41:08.99,0:41:10.13,Default,,0,0,0,,Сіз мұны істей аласыз ба? бұл?
Dialogue: 0,0:41:10.90,0:41:12.03,Default,,0,0,0,,Сонда бұл не?
Dialogue: 0,0:41:12.13,0:41:13.10,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:41:14.20,0:41:15.70,Default,,0,0,0,,Кеттік, Қабан.
Dialogue: 0,0:41:17.70,0:41:19.24,Default,,0,0,0,,Әже қауіпті...
Dialogue: 0,0:41:20.57,0:41:21.74,Default,,0,0,0,,Құйрықты орау
Dialogue: 0,0:41:22.74,0:41:24.81,Default,,0,0,0,,По, түскі ас.
Dialogue: 0,0:41:31.22,0:41:32.08,Default,,0,0,0,,По
Dialogue: 0,0:41:32.72,0:41:35.09,Default,,0,0,0,,Өзіңізді еңіске бағындырыңыз
Dialogue: 0,0:41:35.25,0:41:36.22,Default,,0,0,0,,Жаңа ойыншының қатесі
Dialogue: 0,0:41:36.56,0:41:40.13,Default,,0,0,0,,Тен Шин, маған тауға шығуды үйретші.
Dialogue: 0,0:41:41.79,0:41:43.16,Default,,0,0,0,,Керемет
Dialogue: 0,0:41:43.26,0:41:44.23,Default,,0,0,0,,Бұл жеңіл тамақ.
Dialogue: 0,0:41:45.97,0:41:47.50,Default,,0,0,0,,Ол ұша алады ма?
Dialogue: 0,0:41:47.60,0:41:48.97,Default,,0,0,0,,Мен сонда барамын.
Dialogue: 0,0:41:50.64,0:41:52.04,Default,,0,0,0,,Күн суып барады
Dialogue: 0,0:41:54.77,0:41:56.78,Default,,0,0,0,,Бұл Поға арналған.
Dialogue: 0,0:41:59.55,0:42:00.71,Default,,0,0,0,,Тоқта
Dialogue: 0,0:42:01.51,0:42:04.18,Default,,0,0,0,,Жарайды, жарайды, жақсы қыз.
Dialogue: 0,0:42:04.52,0:42:05.58,Default,,0,0,0,,Сіздің денеңіз туралы не айтасыз?
Dialogue: 0,0:42:05.68,0:42:06.52,Default,,0,0,0,,Шешілген
Dialogue: 0,0:42:06.59,0:42:08.79,Default,,0,0,0,,Денеңізді сол күйінде қалдырыңыз.
Dialogue: 0,0:42:08.89,0:42:09.89,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:42:14.56,0:42:15.59,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:42:15.76,0:42:18.53,Default,,0,0,0,,Барлығын шығарыңыз.
Dialogue: 0,0:42:18.80,0:42:19.80,Default,,0,0,0,,Жақсы бала
Dialogue: 0,0:42:21.97,0:42:23.20,Default,,0,0,0,,Түсіңіз
Dialogue: 0,0:42:25.77,0:42:26.81,Default,,0,0,0,,Бүркіт кеспесі!
Dialogue: 0,0:42:27.11,0:42:28.17,Default,,0,0,0,,Тоқта
Dialogue: 0,0:42:32.68,0:42:34.18,Default,,0,0,0,,Агрессивті.
Dialogue: 0,0:42:34.25,0:42:36.18,Default,,0,0,0,,Мен де сені құшақтайын
Dialogue: 0,0:42:37.88,0:42:39.55,Default,,0,0,0,,Бас киімдерді жеуге болмайды
Dialogue: 0,0:42:43.26,0:42:45.06,Default,,0,0,0,,Мен раменді жақсы көремін!
Dialogue: 0,0:42:46.56,0:42:47.83,Default,,0,0,0,,Поға ұқсайды
Dialogue: 0,0:42:52.93,0:42:53.93,Default,,0,0,0,,Сіз не қарап тұрсыз?
Dialogue: 0,0:43:01.01,0:43:03.94,Default,,0,0,0,,Сондықтан сен пандасың. Кіріңіз!
Dialogue: 0,0:43:19.06,0:43:20.06,Default,,0,0,0,,Мама, қарашы
Dialogue: 0,0:43:26.23,0:43:27.60,Default,,0,0,0,,Бұл ұнайды ма?
Dialogue: 0,0:43:33.01,0:43:36.28,Default,,0,0,0,,Қайталап көріңіз, қатты тырыспаңыз
Dialogue: 0,0:43:36.34,0:43:37.68,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:43:43.02,0:43:45.05,Default,,0,0,0,,әлдеқайда жақсы
Dialogue: 0,0:43:52.89,0:43:53.76,Default,,0,0,0,,Рахмет
Dialogue: 0,0:43:54.26,0:43:55.29,Default,,0,0,0,,Не?
Dialogue: 0,0:43:55.73,0:43:59.30,Default,,0,0,0,,Сен маған көп нәрсені үйреттің.
Dialogue: 0,0:44:00.33,0:44:01.73,Default,,0,0,0,,Пандалар туралы
Dialogue: 0,0:44:02.90,0:44:05.17,Default,,0,0,0,,Уақыт келді, солай ма?
Dialogue: 0,0:44:05.27,0:44:05.97,Default,,0,0,0,,Сонымен…
Dialogue: 0,0:44:06.04,0:44:08.24,Default,,0,0,0,,Маған цигонды үйрет
Dialogue: 0,0:44:08.37,0:44:10.31,Default,,0,0,0,,Міне таяп қалды
Dialogue: 0,0:44:11.01,0:44:13.41,Default,,0,0,0,,Мен саған басқаша айтайын
Dialogue: 0,0:44:17.02,0:44:21.02,Default,,0,0,0,,Тәртіпсіздік үшін кешіріңіз, менде әдетте тұтынушылар болмайды.
Dialogue: 0,0:44:31.16,0:44:33.87,Default,,0,0,0,,Бұл мен және анам ба?
Dialogue: 0,0:44:39.74,0:44:43.11,Default,,0,0,0,,Бұл сіздің бірінші тағамыңызды еске алу.
Dialogue: 0,0:44:45.24,0:44:49.92,Default,,0,0,0,,Бір орында тұрмадың, сол суретті де жей жаздадың.
Dialogue: 0,0:44:51.38,0:44:52.72,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:44:52.89,0:44:54.02,Default,,0,0,0,,Сіз қандай адамсыз?
Dialogue: 0,0:44:56.19,0:44:59.29,Default,,0,0,0,,Менің анам мінсіз болды.
Dialogue: 0,0:45:00.43,0:45:03.30,Default,,0,0,0,,Ақылды және әдемі
Dialogue: 0,0:45:03.90,0:45:05.83,Default,,0,0,0,,Менің тәбетімнің түбі жоқ.
Dialogue: 0,0:45:07.00,0:45:08.97,Default,,0,0,0,,Ол менің жан серігім
Dialogue: 0,0:45:09.84,0:45:13.71,Default,,0,0,0,,Оның үстіне тағы бір үлкен бақыт келді.
Dialogue: 0,0:45:14.21,0:45:17.48,Default,,0,0,0,,Маған сүйкімді Сяорэнь берілді.
Dialogue: 0,0:45:20.11,0:45:22.15,Default,,0,0,0,,Мен қанағаттандым.
Dialogue: 0,0:45:23.48,0:45:27.72,Default,,0,0,0,,Бірақ сол күні, әп-сәтте
Dialogue: 0,0:45:31.19,0:45:35.26,Default,,0,0,0,,Мен бәрін жоғалттым
Dialogue: 0,0:46:12.53,0:46:13.77,Default,,0,0,0,,Әке.
Dialogue: 0,0:46:14.27,0:46:17.44,Default,,0,0,0,,Мен енді ешқашан жоғалмаймын
Dialogue: 0,0:46:18.30,0:46:19.44,Default,,0,0,0,,Келісесің бе?
Dialogue: 0,0:46:28.48,0:46:30.32,Default,,0,0,0,,Мен де сені құшақтайын
Dialogue: 0,0:46:39.79,0:46:41.79,Default,,0,0,0,,Бұл шығыстан
Dialogue: 0,0:46:43.16,0:46:45.56,Default,,0,0,0,,Шебер Лизард Мастер Сиыр
Dialogue: 0,0:46:45.83,0:46:47.23,Default,,0,0,0,,Мастер Бүркіт
Dialogue: 0,0:46:47.47,0:46:48.57,Default,,0,0,0,,Барлығы.
Dialogue: 0,0:46:49.07,0:46:51.17,Default,,0,0,0,,Теңізден осы жерге дейін -
Dialogue: 0,0:46:51.24,0:46:53.54,Default,,0,0,0,,Әр ауылда шеберлер
Dialogue: 0,0:46:54.01,0:46:55.01,Default,,0,0,0,,Жоғалып кетті
Dialogue: 0,0:46:55.11,0:46:56.48,Default,,0,0,0,,Партия т.б.
Dialogue: 0,0:46:56.54,0:46:57.34,Default,,0,0,0,,Маймыл
Dialogue: 0,0:46:57.41,0:46:58.94,Default,,0,0,0,,Біз шеттетілген адамдармыз
Dialogue: 0,0:46:59.08,0:47:01.21,Default,,0,0,0,,Кай менің киімді ұрлады.
Dialogue: 0,0:47:01.31,0:47:03.58,Default,,0,0,0,,Арамызда қалғандар...
Dialogue: 0,0:47:03.95,0:47:07.49,Default,,0,0,0,,Біз Огвей шеберінің даналығын қорғауымыз керек.
Dialogue: 0,0:47:08.19,0:47:10.02,Default,,0,0,0,,Ауыл тұрғындарын эвакуациялау туралы не айтуға болады?
Dialogue: 0,0:47:10.09,0:47:10.92,Default,,0,0,0,,Орындалды
Dialogue: 0,0:47:11.22,0:47:12.36,Default,,0,0,0,,Крандар ше?
Dialogue: 0,0:47:12.46,0:47:13.23,Default,,0,0,0,,«Сенім артамын.»
Dialogue: 0,0:47:13.83,0:47:14.89,Default,,0,0,0,,Мен оралдым
Dialogue: 0,0:47:19.40,0:47:20.10,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:47:34.61,0:47:35.38,Default,,0,0,0,,Кай
Dialogue: 0,0:47:40.99,0:47:43.49,Default,,0,0,0,,Бұл жарқыраған, дәмі нашар.
Dialogue: 0,0:47:45.02,0:47:47.33,Default,,0,0,0,,Мұнда қалай келдің?
Dialogue: 0,0:47:47.56,0:47:49.63,Default,,0,0,0,,Ақымақтар.
Dialogue: 0,0:47:50.23,0:47:54.17,Default,,0,0,0,,Мен ұлы Огвейдің табанына сәжде еттім.
Dialogue: 0,0:47:54.27,0:47:56.34,Default,,0,0,0,,Таза еместер ауыздарын жапсын
Dialogue: 0,0:47:56.54,0:47:59.14,Default,,0,0,0,,Бұл қиын, котенка.
Dialogue: 0,0:48:01.34,0:48:06.14,Default,,0,0,0,,Мен онымен үнемі бірге соғысып, оны ағам деп санайтынмын.
Dialogue: 0,0:48:06.41,0:48:10.08,Default,,0,0,0,,Бірақ ол маған опасыздық жасады.
Dialogue: 0,0:48:11.35,0:48:12.48,Default,,0,0,0,,Сондықтан-
Dialogue: 0,0:48:13.29,0:48:17.96,Default,,0,0,0,,Оның салғандарының бәрі жойылады.
Dialogue: 0,0:48:18.52,0:48:19.16,Default,,0,0,0,,Уууууууу!!
Dialogue: 0,0:48:41.15,0:48:42.38,Default,,0,0,0,,Котенкаларды қорламаңыз
Dialogue: 0,0:48:59.43,0:49:02.07,Default,,0,0,0,,Душидің естеліктері жойылмайды
Dialogue: 0,0:49:02.20,0:49:04.40,Default,,0,0,0,,Ол мені сындырды.
Dialogue: 0,0:49:05.07,0:49:08.17,Default,,0,0,0,,Бұл менмін, бұл менмін.
Dialogue: 0,0:49:13.08,0:49:14.48,Default,,0,0,0,,Кешіріңіз Жолбарыс
Dialogue: 0,0:49:14.58,0:49:16.48,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:49:17.28,0:49:18.22,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:49:32.33,0:49:33.23,Default,,0,0,0,,Мастер
Dialogue: 0,0:49:33.63,0:49:34.97,Default,,0,0,0,,Мені әкел
Dialogue: 0,0:49:45.74,0:49:47.45,Default,,0,0,0,,Поға хабарлау.
Dialogue: 0,0:49:47.51,0:49:48.51,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:49:57.12,0:50:01.33,Default,,0,0,0,,Тыңда, аға, мен саған кидің шын құдіретін көрсетемін.
Dialogue: 0,0:50:03.33,0:50:04.10,Default,,0,0,0,,Йосе
Dialogue: 0,0:50:40.30,0:50:42.67,Default,,0,0,0,,Ұстаз, мені кешіріңіз.
Dialogue: 0,0:50:44.77,0:50:48.54,Default,,0,0,0,,Огвей Сіз бұл жігітті кешіресіз бе?
Dialogue: 0,0:50:49.27,0:50:54.58,Default,,0,0,0,,Нефрит сарайын қирату мүмкін болса да, сіздің тілегіңіз орындалмайды.
Dialogue: 0,0:50:55.18,0:50:58.82,Default,,0,0,0,,Сізді тоқтататын біреу міндетті түрде пайда болады.
Dialogue: 0,0:50:59.15,0:51:00.79,Default,,0,0,0,,Бұл панда ма?
Dialogue: 0,0:51:01.19,0:51:05.56,Default,,0,0,0,,Оның ерік-жігері күшті, бірақ ол менің жауым емес.
Dialogue: 0,0:51:06.12,0:51:10.40,Default,,0,0,0,,Мен де сен сияқты тағдырға ұшыраймын.
Dialogue: 0,0:51:10.76,0:51:15.23,Default,,0,0,0,,Мен сол ауылдағы барлық пандаларды өзіммен бірге алып кетемін.
Dialogue: 0,0:51:20.61,0:51:21.84,Default,,0,0,0,,Жарайды
Dialogue: 0,0:51:26.61,0:51:28.71,Default,,0,0,0,,По, мен саған сенемін.
Dialogue: 0,0:51:32.75,0:51:34.62,Default,,0,0,0,,Сяорэн биі
Dialogue: 0,0:51:36.56,0:51:38.62,Default,,0,0,0,,Ол әдемі.
Dialogue: 0,0:51:41.46,0:51:43.56,Default,,0,0,0,,Бұл панданы құшақтау
Dialogue: 0,0:51:49.77,0:51:50.50,Default,,0,0,0,,По
Dialogue: 0,0:52:27.34,0:52:28.51,Default,,0,0,0,,Жолбарыс
Dialogue: 0,0:52:31.78,0:52:32.88,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:52:36.41,0:52:38.42,Default,,0,0,0,,Үлкен жолақты сәби
Dialogue: 0,0:52:39.42,0:52:40.42,Default,,0,0,0,,Не болды?
Dialogue: 0,0:52:40.52,0:52:42.19,Default,,0,0,0,,Кай өлтірді
Dialogue: 0,0:52:42.32,0:52:48.16,Default,,0,0,0,,Қытайдағы барлық шеберлердің Ци ұрланған.
Dialogue: 0,0:52:48.26,0:52:49.36,Default,,0,0,0,,Барлығы?
Dialogue: 0,0:52:49.43,0:52:50.26,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:52:50.83,0:52:52.60,Default,,0,0,0,,Менің дүкенім қайда?
Dialogue: 0,0:52:54.43,0:52:55.43,Default,,0,0,0,,Нағыз шайқас көрмегелі жылдар болды
Dialogue: 0,0:52:55.63,0:52:57.27,Default,,0,0,0,,Кай келе жатыр
Dialogue: 0,0:52:57.37,0:53:01.21,Default,,0,0,0,,Мұндағы мақсат сіз және пандалар.
Dialogue: 0,0:53:01.74,0:53:02.84,Default,,0,0,0,,Жеңілдік кезеңі дегеніміз не?
Dialogue: 0,0:53:03.17,0:53:06.18,Default,,0,0,0,,Көп емес Сіз енді өз ойыңызды басқара аласыз ба?
Dialogue: 0,0:53:07.21,0:53:08.18,Default,,0,0,0,,Әке.
Dialogue: 0,0:53:08.78,0:53:10.88,Default,,0,0,0,,Маған Цигон құпиясын үйрет
Dialogue: 0,0:53:11.18,0:53:13.32,Default,,0,0,0,,Маған көбірек уақыт керек
Dialogue: 0,0:53:13.42,0:53:15.32,Default,,0,0,0,,Сөмкелеріңізді жинаңыз!
Dialogue: 0,0:53:15.45,0:53:17.42,Default,,0,0,0,,Менің уақытым жоқ
Dialogue: 0,0:53:17.49,0:53:19.46,Default,,0,0,0,,Сіз мұны әлі істей алмайсыз.
Dialogue: 0,0:53:19.52,0:53:20.86,Default,,0,0,0,,Мен жеңдім
Dialogue: 0,0:53:21.19,0:53:24.50,Default,,0,0,0,,Мен сіз айтқандардың барлығын тазаладым.
Dialogue: 0,0:53:24.60,0:53:28.20,Default,,0,0,0,,Ұйқы, көп ұйықтау, гамак, ванна
Dialogue: 0,0:53:28.27,0:53:31.44,Default,,0,0,0,,Панда мінсіз болса да...
Dialogue: 0,0:53:31.50,0:53:33.41,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:53:36.74,0:53:37.54,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:53:37.71,0:53:41.95,Default,,0,0,0,,Бұрын білгір болса да ауылда ешкім білмейді...
Dialogue: 0,0:53:42.48,0:53:43.62,Default,,0,0,0,,Қазір емес
Dialogue: 0,0:53:44.35,0:53:45.22,Default,,0,0,0,,Өтірік?
Dialogue: 0,0:53:45.35,0:53:46.82,Default,,0,0,0,,Жоқ, жай...
Dialogue: 0,0:53:48.49,0:53:49.62,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:53:49.89,0:53:51.86,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:53:51.99,0:53:53.76,Default,,0,0,0,,Сізді қорғау үшін
Dialogue: 0,0:53:53.83,0:53:58.76,Default,,0,0,0,,Бір жынды жігіт сіздің артыңыздан келеді.
Dialogue: 0,0:53:59.00,0:54:00.50,Default,,0,0,0,,Мені жалғыз қалдырыңыз ба?
Dialogue: 0,0:54:00.67,0:54:04.90,Default,,0,0,0,,Мен айдаһар жауынгермін, ал менің міндетім – жынды жігіттермен күресу.
Dialogue: 0,0:54:05.50,0:54:08.61,Default,,0,0,0,,Бірақ әкемнің кесірінен мен ауылдан кеттім...
Dialogue: 0,0:54:08.71,0:54:11.81,Default,,0,0,0,,Сол уақытта менің досыма шабуыл жасалды.
Dialogue: 0,0:54:12.74,0:54:13.58,Default,,0,0,0,,Барлығы...
Dialogue: 0,0:54:13.68,0:54:15.45,Default,,0,0,0,,Мен сені уайымдаймын
Dialogue: 0,0:54:17.28,0:54:18.88,Default,,0,0,0,,бір рет ұтылды
Dialogue: 0,0:54:19.32,0:54:23.79,Default,,0,0,0,,Мен сені қайтадан жоғалта алмаймын
Dialogue: 0,0:54:30.26,0:54:31.66,Default,,0,0,0,,Мен оны жаңа ғана жоғалтып алдым.
Dialogue: 0,0:54:51.82,0:54:56.02,Default,,0,0,0,,По Жақсы, мен қатты уайымдадым.
Dialogue: 0,0:54:56.29,0:54:59.06,Default,,0,0,0,,Тезірек қашып кет.
Dialogue: 0,0:54:59.32,0:55:00.59,Default,,0,0,0,,Қашуға болмайды
Dialogue: 0,0:55:00.69,0:55:02.43,Default,,0,0,0,,Шынымен бе? Оған екеуі неге керек болды?
Dialogue: 0,0:55:02.69,0:55:05.40,Default,,0,0,0,,Осы жерде қалып, құбыжықтармен күресіңіз.
Dialogue: 0,0:55:05.53,0:55:08.67,Default,,0,0,0,,Ол құбыжық, бірақ ол менің әкем.
Dialogue: 0,0:55:08.97,0:55:10.40,Default,,0,0,0,,Бұл Кай туралы.
Dialogue: 0,0:55:11.54,0:55:12.37,Default,,0,0,0,,Йосе
Dialogue: 0,0:55:57.12,0:55:58.45,Default,,0,0,0,,Тамақтанғыңыз келе ме?
Dialogue: 0,0:55:58.55,0:56:00.55,Default,,0,0,0,,Жоқ, қарным ашты...
Dialogue: 0,0:56:00.92,0:56:03.42,Default,,0,0,0,,Сонда бір ғана нәрсе.
Dialogue: 0,0:56:03.89,0:56:08.03,Default,,0,0,0,,Жалғыз сен өтірік айтқан жоқсың.
Dialogue: 0,0:56:08.79,0:56:13.47,Default,,0,0,0,,Келген себебім Поның тамағын жеу емес еді.
Dialogue: 0,0:56:13.60,0:56:14.97,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,0:56:15.63,0:56:16.90,Default,,0,0,0,,Менің тамағым?
Dialogue: 0,0:56:17.07,0:56:18.07,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:56:18.50,0:56:20.91,Default,,0,0,0,,Поды алып кете ме деп қорқамын...
Dialogue: 0,0:56:21.04,0:56:21.91,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:56:22.04,0:56:24.04,Default,,0,0,0,,Сен ақымақсың.
Dialogue: 0,0:56:25.64,0:56:28.81,Default,,0,0,0,,Менің өмірім қысқармайды.
Dialogue: 0,0:56:28.91,0:56:33.52,Default,,0,0,0,,По өмірін байытады.
Dialogue: 0,0:56:35.39,0:56:36.49,Default,,0,0,0,,Бірақ-
Dialogue: 0,0:56:37.09,0:56:40.46,Default,,0,0,0,,Мен ол баладан айырылдым.
Dialogue: 0,0:56:40.93,0:56:44.66,Default,,0,0,0,,Ұлымды ашуландырғаным үшін бе? Ол шынымен де ата-ана
Dialogue: 0,0:56:44.76,0:56:47.93,Default,,0,0,0,,Мен ол қызға өтірік айттым.
Dialogue: 0,0:56:48.17,0:56:49.63,Default,,0,0,0,,Мені кешірмейді
Dialogue: 0,0:56:49.90,0:56:52.17,Default,,0,0,0,,Мен 20 жыл өтірік айттым.
Dialogue: 0,0:56:52.44,0:56:54.94,Default,,0,0,0,,Тіпті жұмыртқада туылғанын айтты.
Dialogue: 0,0:56:55.07,0:56:59.68,Default,,0,0,0,,Ата-аналар кейде балаларымен сүйкімді болудан қателеседі.
Dialogue: 0,0:57:08.05,0:57:12.56,Default,,0,0,0,,Енді сол бала ренжіп, абдырап қалды.
Dialogue: 0,0:57:12.99,0:57:15.83,Default,,0,0,0,,Әлемді құтқару керек
Dialogue: 0,0:57:16.53,0:57:19.00,Default,,0,0,0,,Әкелердің кезегі.
Dialogue: 0,0:57:37.65,0:57:38.98,Default,,0,0,0,,Бұл ысырап
Dialogue: 0,0:57:39.12,0:57:40.12,Default,,0,0,0,,Орындау керек
Dialogue: 0,0:57:40.45,0:57:41.45,Default,,0,0,0,,Мен абдырап қалдым
Dialogue: 0,0:57:41.55,0:57:42.05,Default,,0,0,0,,Жоқ
Dialogue: 0,0:57:42.15,0:57:42.79,Default,,0,0,0,,Иә
Dialogue: 0,0:57:45.99,0:57:48.76,Default,,0,0,0,,Мен Кайдың күшін көрдім
Dialogue: 0,0:57:48.86,0:57:51.23,Default,,0,0,0,,Ол менің күшімді көрмейді
Dialogue: 0,0:57:55.07,0:57:56.23,Default,,0,0,0,,Вусидің саусақ мөрі
Dialogue: 0,0:57:57.24,0:58:02.74,Default,,0,0,0,,Бұл ерекше қозғалыс Шұқаборанды қайтадан Жан патшалығына жібереді.
Dialogue: 0,0:58:02.97,0:58:06.51,Default,,0,0,0,,Ол нефрит армиясынан ақпарат алуда.
Dialogue: 0,0:58:06.61,0:58:09.88,Default,,0,0,0,,Саусақтарымды қатайтсам да, жақындай алмаймын.
Dialogue: 0,0:58:09.98,0:58:10.95,Default,,0,0,0,,Бірдеңе болады
Dialogue: 0,0:58:13.25,0:58:15.95,Default,,0,0,0,,Егер бұл цигонг болмаса, бұл мүмкін емес.
Dialogue: 0,0:58:16.02,0:58:20.23,Default,,0,0,0,,Дәл Шифу ақсақал, Ци Ци Ци сияқты, бәрі осы.
Dialogue: 0,0:58:20.53,0:58:24.00,Default,,0,0,0,,Мен цигонды пайдалана алмаймын, сондықтан мен айдаһар жауынгерімін бе деп ойлаймын.
Dialogue: 0,0:58:24.06,0:58:25.76,Default,,0,0,0,,Панда Касура...
Dialogue: 0,0:58:25.83,0:58:27.73,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,0:58:30.03,0:58:33.14,Default,,0,0,0,,Бұл Кайдың әскерін жеңу үшін жеткіліксіз.
Dialogue: 0,0:58:37.68,0:58:40.25,Default,,0,0,0,,Сіздің де әскеріңіз болуы керек.
Dialogue: 0,0:58:43.62,0:58:44.18,Default,,0,0,0,,Тек баралдай
Dialogue: 0,0:58:44.68,0:58:46.78,Default,,0,0,0,,Мен жалғыз емеспін
Dialogue: 0,0:58:46.92,0:58:48.02,Default,,0,0,0,,Бүркіттер де бар
Dialogue: 0,0:58:48.25,0:58:49.72,Default,,0,0,0,,Барлығына да
Dialogue: 0,0:58:58.93,0:59:03.00,Default,,0,0,0,,Көп жылдардан кейін мен ұлымды таптым.
Dialogue: 0,0:59:03.77,0:59:07.21,Default,,0,0,0,,Ақырзаман келсе де мен сені енді тастамаймын
Dialogue: 0,0:59:07.67,0:59:09.17,Default,,0,0,0,,Кунг-фу әуесқойларға арналған
Dialogue: 0,0:59:09.77,0:59:11.81,Default,,0,0,0,,Сіз маған айтасыз
Dialogue: 0,0:59:11.94,0:59:14.71,Default,,0,0,0,,Бұл мүмкін емес екеніне сенімдімін.
Dialogue: 0,0:59:14.81,0:59:19.25,Default,,0,0,0,,Тіпті кунг-фу шеберлері де сізге үйрете алмайды.
Dialogue: 0,0:59:20.55,0:59:25.96,Default,,0,0,0,,Дәл қазір әкеңе сенгің келмейтін шығар.
Dialogue: 0,0:59:26.19,0:59:29.56,Default,,0,0,0,,Сонда да маған сеніңіз, қолыңыздан келеді.
Dialogue: 0,0:59:29.69,0:59:34.63,Default,,0,0,0,,Бәріміз кунг-фу үйренейік, сен сияқты күресейік
Dialogue: 0,0:59:35.30,0:59:36.20,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:59:36.70,0:59:38.10,Default,,0,0,0,,«Мен мұны істей алатыныма сенімдімін»?
Dialogue: 0,0:59:38.20,0:59:38.84,Default,,0,0,0,,Жоқ
Dialogue: 0,0:59:39.17,0:59:40.20,Default,,0,0,0,,«Үйрен»?
Dialogue: 0,0:59:40.31,0:59:40.97,Default,,0,0,0,,Жоқ
Dialogue: 0,0:59:41.07,0:59:42.77,Default,,0,0,0,,«Сіз сияқты»
Dialogue: 0,0:59:42.87,0:59:43.64,Default,,0,0,0,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,0:59:43.74,0:59:44.14,Default,,0,0,0,,Сіз бір бола аласыз ба?
Dialogue: 0,0:59:44.24,0:59:46.04,Default,,0,0,0,,Бұл мүмкін емес
Dialogue: 0,0:59:47.58,0:59:49.61,Default,,0,0,0,,Мұның қажеті жоқ.
Dialogue: 0,0:59:50.01,0:59:54.59,Default,,0,0,0,,Шифу ақсақал: «Мен нағыз сен болғым келеді», - деді.
Dialogue: 0,0:59:55.95,0:59:57.26,Default,,0,0,0,,Бұл мағынасы жоқ.
Dialogue: 0,0:59:57.59,0:59:58.86,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:59:59.76,1:00:00.69,Default,,0,0,0,,Әкемдікі
Dialogue: 0,1:00:00.76,1:00:02.26,Default,,0,0,0,,Бұл пайдалы болды деп үміттенемін...
Dialogue: 0,1:00:02.73,1:00:05.36,Default,,0,0,0,,Мен мүмкін емес деп ойлаған нәрсені істеймін.
Dialogue: 0,1:00:05.73,1:00:07.97,Default,,0,0,0,,Кунг-фуды үйрету
Dialogue: 0,1:00:10.00,1:00:13.64,Default,,0,0,0,,Сіз өзіңіздің шынайы болмысыңыз болған кезде, сіздің күшіңіз көрсетіледі.
Dialogue: 0,1:00:13.74,1:00:14.74,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,1:00:15.04,1:00:17.84,Default,,0,0,0,,Сіз немен айналысасыз? Сізге не ұнайды?
Dialogue: 0,1:00:17.94,1:00:19.74,Default,,0,0,0,,Сен неге ханзадасың?
Dialogue: 0,1:00:21.68,1:00:23.05,Default,,0,0,0,,Иә.
Dialogue: 0,1:00:23.15,1:00:24.92,Default,,0,0,0,,Жақсы, жалғастыр.
Dialogue: 0,1:00:27.95,1:00:29.05,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:00:30.05,1:00:31.62,Default,,0,0,0,,Жарайды, солай.
Dialogue: 0,1:00:32.09,1:00:33.06,Default,,0,0,0,,Не?
Dialogue: 0,1:00:33.26,1:00:35.36,Default,,0,0,0,,Жолақты сәби
Dialogue: 0,1:00:36.69,1:00:39.03,Default,,0,0,0,,Таспаны жылдамырақ өңдеу
Dialogue: 0,1:00:39.63,1:00:44.30,Default,,0,0,0,,Мені көбірек құшақтап ал, оны енді ешқашан көрмейтін адам деп ойла.
Dialogue: 0,1:00:44.70,1:00:47.41,Default,,0,0,0,,Жоғары, сәл көбірек солға қарай
Dialogue: 0,1:00:50.71,1:00:52.81,Default,,0,0,0,,Буға пісірілген тоқашты түсіріп алмаңыз
Dialogue: 0,1:00:53.04,1:00:54.11,Default,,0,0,0,,Кейде көңіл көтеру керек қой…
Dialogue: 0,1:01:04.29,1:01:06.12,Default,,0,0,0,,Жолақты сәби
Dialogue: 0,1:01:07.33,1:01:09.03,Default,,0,0,0,,Келесісі ұнайды
Dialogue: 0,1:01:10.83,1:01:12.26,Default,,0,0,0,,Келесі - бұл.
Dialogue: 0,1:01:17.20,1:01:19.77,Default,,0,0,0,,Жарайды, бұл келесі.
Dialogue: 0,1:01:54.01,1:01:55.11,Default,,0,0,0,,Дайын
Dialogue: 0,1:01:55.84,1:01:57.88,Default,,0,0,0,,Жолақты сәби
Dialogue: 0,1:01:58.08,1:01:59.11,Default,,0,0,0,,Не?
Dialogue: 0,1:01:59.88,1:02:03.35,Default,,0,0,0,,Мен мұны тағы 10 рет айтамын. Мұқият тыңдаңыз.
Dialogue: 0,1:02:03.72,1:02:06.28,Default,,0,0,0,,Бұл ауылға кіретін жалғыз есік.
Dialogue: 0,1:02:06.45,1:02:08.85,Default,,0,0,0,,Етшілер отряды осында
Dialogue: 0,1:02:08.95,1:02:11.19,Default,,0,0,0,,Cookie тобы осында
Dialogue: 0,1:02:11.26,1:02:13.99,Default,,0,0,0,,Менің сигналым бойынша екі әскер...
Dialogue: 0,1:02:16.43,1:02:17.86,Default,,0,0,0,,Бұл рас.
Dialogue: 0,1:02:18.13,1:02:19.86,Default,,0,0,0,,Рамен отряды...
Dialogue: 0,1:02:24.80,1:02:26.00,Default,,0,0,0,,Жоқ.
Dialogue: 0,1:02:26.07,1:02:28.94,Default,,0,0,0,,Бәрібір маңыздысы мынау...
Dialogue: 0,1:02:31.88,1:02:33.41,Default,,0,0,0,,Мен оны білдім.
Dialogue: 0,1:02:33.51,1:02:36.41,Default,,0,0,0,,Барлығы Zombie Sui-ге кедергі жасайды
Dialogue: 0,1:02:36.48,1:02:39.52,Default,,0,0,0,,Мен сол мүмкіндікті пайдаланып Кайды саусағынан ұстадым.
Dialogue: 0,1:02:39.78,1:02:40.79,Default,,0,0,0,,Келісесің бе?
Dialogue: 0,1:02:42.75,1:02:44.42,Default,,0,0,0,,3-те айқайлайық...
Dialogue: 0,1:02:44.52,1:02:45.26,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,1:02:45.36,1:02:47.79,Default,,0,0,0,,Жақсы, кейін айтамын.
Dialogue: 0,1:03:22.43,1:03:26.46,Default,,0,0,0,,Мен саған цигонды үйретер едім...
Dialogue: 0,1:03:26.86,1:03:29.00,Default,,0,0,0,,Жарайды, мен...
Dialogue: 0,1:03:35.31,1:03:36.37,Default,,0,0,0,,Мен осындамын
Dialogue: 0,1:04:03.50,1:04:05.84,Default,,0,0,0,,Күшті көрініс
Dialogue: 0,1:04:10.37,1:04:12.91,Default,,0,0,0,,Сіз айдаһар жауынгерсіз бе?
Dialogue: 0,1:04:13.01,1:04:15.58,Default,,0,0,0,,Сіз Кайсыз.
Dialogue: 0,1:04:16.05,1:04:19.05,Default,,0,0,0,,«Кек алатын аң» және «Күйеу өлтіруші» ретінде де белгілі
Dialogue: 0,1:04:19.25,1:04:22.99,Default,,0,0,0,,Мен білетін адам бар еді, рахмет
Dialogue: 0,1:04:23.05,1:04:25.06,Default,,0,0,0,,Мен көмектескім келеді
Dialogue: 0,1:04:25.12,1:04:30.36,Default,,0,0,0,,Ондай бос сөзге уайымдама, тез құтылайық.
Dialogue: 0,1:04:30.86,1:04:35.33,Default,,0,0,0,,Мен сенің энергияңды, соның ішінде осы ауылдағы пандаларды да сіңіремін...
Dialogue: 0,1:04:35.43,1:04:36.63,Default,,0,0,0,,Печа Куча
Dialogue: 0,1:04:36.97,1:04:37.54,Default,,0,0,0,,Ауыл…
Dialogue: 0,1:04:37.64,1:04:38.34,Default,,0,0,0,,Печа
Dialogue: 0,1:04:38.40,1:04:39.00,Default,,0,0,0,,Ауыл…
Dialogue: 0,1:04:40.57,1:04:41.54,Default,,0,0,0,,Ауыл…
Dialogue: 0,1:04:41.91,1:04:44.41,Default,,0,0,0,,Сіз аузыңыз бітпейтін ісінген пандасыз.
Dialogue: 0,1:04:49.08,1:04:50.41,Default,,0,0,0,,Барлығын жинаңыз.
Dialogue: 0,1:05:05.20,1:05:08.90,Default,,0,0,0,,Рас, бәрі жасыл.
Dialogue: 0,1:05:09.03,1:05:11.57,Default,,0,0,0,,Мантылар бастапқыда жасыл, бірақ
Dialogue: 0,1:05:14.11,1:05:15.11,Default,,0,0,0,,Сигнал күтіңіз
Dialogue: 0,1:05:17.64,1:05:18.64,Default,,0,0,0,,Жұмыс басталады!
Dialogue: 0,1:05:29.92,1:05:30.99,Default,,0,0,0,,Никуман бірлігі
Dialogue: 0,1:05:31.19,1:05:31.66,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,1:05:31.96,1:05:32.59,Default,,0,0,0,,Сыртқа шығарған ауаңыз сол жақтағы осы бөліктен шығады.
Dialogue: 0,1:05:33.02,1:05:33.59,Default,,0,0,0,,Іші…
Dialogue: 0,1:05:33.93,1:05:35.19,Default,,0,0,0,,Таң
Dialogue: 0,1:05:38.30,1:05:39.13,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,1:05:39.36,1:05:40.26,Default,,0,0,0,,Иә!
Dialogue: 0,1:05:41.53,1:05:42.70,Default,,0,0,0,,Кешіріңіз, Цуру
Dialogue: 0,1:05:50.98,1:05:53.71,Default,,0,0,0,,Серіппелі орама, қытырлақ әрлеу
Dialogue: 0,1:06:02.12,1:06:03.72,Default,,0,0,0,,Zombie Sui келіңіз
Dialogue: 0,1:06:09.53,1:06:11.33,Default,,0,0,0,,Мен ешкімді танымаймын
Dialogue: 0,1:06:12.00,1:06:13.23,Default,,0,0,0,,Рамен отряды
Dialogue: 0,1:06:16.53,1:06:20.04,Default,,0,0,0,,Мен қауіппен билеймін, сондықтан дайын бол.
Dialogue: 0,1:06:23.67,1:06:24.98,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,1:06:37.02,1:06:38.09,Default,,0,0,0,,Жолақты сәби
Dialogue: 0,1:06:43.43,1:06:44.10,Default,,0,0,0,,Орындаңыз
Dialogue: 0,1:06:44.16,1:06:45.26,Default,,0,0,0,,Жаза
Dialogue: 0,1:06:51.30,1:06:52.57,Default,,0,0,0,,Түсіру
Dialogue: 0,1:06:58.21,1:06:59.41,Default,,0,0,0,,Бірде тесік!
Dialogue: 0,1:07:00.75,1:07:01.65,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,1:07:01.78,1:07:03.35,Default,,0,0,0,,Өмірдің өткелін белгілейтін ессіз сағат
Dialogue: 0,1:07:03.55,1:07:05.18,Default,,0,0,0,,Міне!
Dialogue: 0,1:07:08.72,1:07:10.12,Default,,0,0,0,,Мастер
Dialogue: 0,1:07:11.62,1:07:12.66,Default,,0,0,0,,Мен сені ұра алмаймын
Dialogue: 0,1:07:15.29,1:07:16.43,Default,,0,0,0,,Бүркіттер соғуы мүмкін
Dialogue: 0,1:07:16.53,1:07:18.03,Default,,0,0,0,,Мен де
Dialogue: 0,1:07:20.10,1:07:21.43,Default,,0,0,0,,Қос әке
Dialogue: 0,1:07:22.23,1:07:22.77,Default,,0,0,0,,Әке.
Dialogue: 0,1:07:23.03,1:07:23.80,Default,,0,0,0,,Әкесі де
Dialogue: 0,1:07:24.14,1:07:25.27,Default,,0,0,0,,Жарайды, әке.
Dialogue: 0,1:07:25.70,1:07:27.37,Default,,0,0,0,,Оны маған қалдыр, балам.
Dialogue: 0,1:07:28.11,1:07:28.77,Default,,0,0,0,,Жасаңыз~
Dialogue: 0,1:07:35.31,1:07:36.18,Default,,0,0,0,,Біз жарты жолды өтіп қойдық — бізді тежеме, жарай ма?
Dialogue: 0,1:07:36.65,1:07:39.18,Default,,0,0,0,,Тоқта, жетеді
Dialogue: 0,1:07:46.62,1:07:48.46,Default,,0,0,0,,Оны шешеміз бе?
Dialogue: 0,1:07:50.19,1:07:50.73,Default,,0,0,0,,Ұлым!
Dialogue: 0,1:08:06.81,1:08:09.81,Default,,0,0,0,,Мен сені қайтадан жан патшалығына апарамын.
Dialogue: 0,1:08:10.08,1:08:10.82,Default,,0,0,0,,Шукаборн!
Dialogue: 0,1:08:13.48,1:08:16.22,Default,,0,0,0,,Жұмыс істемейді ме? Мен тағы барамын
Dialogue: 0,1:08:16.32,1:08:17.56,Default,,0,0,0,,Шукаборн!
Dialogue: 0,1:08:17.69,1:08:19.72,Default,,0,0,0,,Шукаборн Шукабо…
Dialogue: 0,1:08:20.09,1:08:22.09,Default,,0,0,0,,Күте тұрыңыз, ол жұмыс істейді.
Dialogue: 0,1:08:22.19,1:08:23.69,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:08:28.50,1:08:32.57,Default,,0,0,0,,Жоқ, ол жұмыс істемейді. Огвей саған мұны үйретті ме?
Dialogue: 0,1:08:33.50,1:08:36.71,Default,,0,0,0,,Ол тек тірі заттарда жұмыс істейді
Dialogue: 0,1:08:36.87,1:08:40.71,Default,,0,0,0,,Мен қазірдің өзінде жан жауынгермін
Dialogue: 0,1:08:40.81,1:08:41.65,Default,,0,0,0,,Егер сол күйді сақтай отырып қозғалсам…
Dialogue: 0,1:09:27.53,1:09:28.49,Default,,0,0,0,,Ұлы
Dialogue: 0,1:09:29.16,1:09:29.69,Default,,0,0,0,,По
Dialogue: 0,1:09:32.60,1:09:34.83,Default,,0,0,0,,Мен қателесіппін, кешіріңіз.
Dialogue: 0,1:09:34.93,1:09:36.60,Default,,0,0,0,,Барлығы жүгіреді!
Dialogue: 0,1:09:48.95,1:09:50.58,Default,,0,0,0,,Огвей
Dialogue: 0,1:09:50.65,1:09:54.39,Default,,0,0,0,,Бұл мені тоқтатуға арналған адам ма?
Dialogue: 0,1:09:54.69,1:09:56.65,Default,,0,0,0,,Алдымен мына жігіттің назарын аударыңыз.
Dialogue: 0,1:09:57.32,1:09:59.36,Default,,0,0,0,,Әрі қарай, қалғандары.
Dialogue: 0,1:10:14.91,1:10:16.21,Default,,0,0,0,,Сіз
Dialogue: 0,1:10:18.21,1:10:22.88,Default,,0,0,0,,Мені қайтадан жан патшалығына жібере аламын деп ойладың ба?
Dialogue: 0,1:10:28.59,1:10:30.55,Default,,0,0,0,,Ақымақ жаратылыс
Dialogue: 0,1:10:31.99,1:10:34.46,Default,,0,0,0,,Ол тек тірі заттарда жұмыс істейді...
Dialogue: 0,1:10:36.49,1:10:38.43,Default,,0,0,0,,Егер ол сізге көмектеспесе...
Dialogue: 0,1:10:39.96,1:10:41.73,Default,,0,0,0,,Мен сені алып кетемін
Dialogue: 0,1:10:41.80,1:10:42.57,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,1:10:44.80,1:10:45.70,Default,,0,0,0,,Не?
Dialogue: 0,1:10:45.80,1:10:46.44,Default,,0,0,0,,По
Dialogue: 0,1:10:46.54,1:10:47.24,Default,,0,0,0,,Ұлы
Dialogue: 0,1:10:48.01,1:10:49.44,Default,,0,0,0,,Шукабоне
Dialogue: 0,1:10:49.57,1:10:50.31,Default,,0,0,0,,По
Dialogue: 0,1:10:51.78,1:10:52.88,Default,,0,0,0,,Йосе
Dialogue: 0,1:11:14.67,1:11:16.93,Default,,0,0,0,,Не болды? По ше?
Dialogue: 0,1:11:17.74,1:11:20.74,Default,,0,0,0,,Кайды алып кетіп, ауылды сақтап қалды.
Dialogue: 0,1:11:21.04,1:11:22.27,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,1:11:23.97,1:11:26.81,Default,,0,0,0,,Поға кім көмектеседі?
Dialogue: 0,1:11:32.98,1:11:35.35,Default,,0,0,0,,Жан патшалығы, табысты.
Dialogue: 0,1:11:35.42,1:11:37.72,Default,,0,0,0,,Сіз қанша уақыт атқа мініп жүрсіз?
Dialogue: 0,1:11:38.46,1:11:40.56,Default,,0,0,0,,Сен мені қайтардың ба?
Dialogue: 0,1:11:41.33,1:11:43.69,Default,,0,0,0,,Мен қалыпты патшалықпен аяқтағым келеді...
Dialogue: 0,1:11:43.83,1:11:45.83,Default,,0,0,0,,Осы жерден аяқтаңыз
Dialogue: 0,1:12:19.63,1:12:21.33,Default,,0,0,0,,Сәттілік, балам.
Dialogue: 0,1:12:21.57,1:12:22.73,Default,,0,0,0,,Мавару үшін!
Dialogue: 0,1:12:29.87,1:12:31.54,Default,,0,0,0,,Егер сіз көмектеспесеңіз
Dialogue: 0,1:12:32.34,1:12:34.88,Default,,0,0,0,,Барлығыңыз жиналыңыздар.
Dialogue: 0,1:12:34.95,1:12:36.85,Default,,0,0,0,,Жақын болыңыз
Dialogue: 0,1:12:36.95,1:12:38.82,Default,,0,0,0,,Мүмкін болуы керек.
Dialogue: 0,1:12:46.62,1:12:47.62,Default,,0,0,0,,По
Dialogue: 0,1:12:48.06,1:12:50.99,Default,,0,0,0,,Сен маған кім екенімді үйреттің
Dialogue: 0,1:12:54.77,1:12:56.03,Default,,0,0,0,,Мен әкемін
Dialogue: 0,1:13:00.67,1:13:01.91,Default,,0,0,0,,Мен доспын
Dialogue: 0,1:13:02.71,1:13:03.91,Default,,0,0,0,,Ет тоқаш
Dialogue: 0,1:13:04.01,1:13:05.61,Default,,0,0,0,,Адам өлтірудің ең күшті қаруы
Dialogue: 0,1:13:05.68,1:13:06.84,Default,,0,0,0,,Құшақтасып жатқан адамдар
Dialogue: 0,1:13:08.88,1:13:10.71,Default,,0,0,0,,Нунчаку қызы
Dialogue: 0,1:13:11.05,1:13:12.92,Default,,0,0,0,,Жолақты сәби
Dialogue: 0,1:13:13.05,1:13:13.92,Default,,0,0,0,,Белли Дон
Dialogue: 0,1:13:14.45,1:13:15.72,Default,,0,0,0,,Отбасы
Dialogue: 0,1:13:45.65,1:13:46.62,Default,,0,0,0,,Ұйқының дәмін сез; жапырақтар арасынан сүзіліп түскен таңғы күн сәулесі мен бұлттардың қозғалысын бағала
Dialogue: 0,1:14:02.47,1:14:03.57,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,1:14:04.00,1:14:06.04,Default,,0,0,0,,Мен де осы сұрақты өзіме қойдым.
Dialogue: 0,1:14:10.81,1:14:12.44,Default,,0,0,0,,Мен панданың ұлымын ба?
Dialogue: 0,1:14:12.98,1:14:14.51,Default,,0,0,0,,Қаздың баласы?
Dialogue: 0,1:14:14.71,1:14:15.58,Default,,0,0,0,,Шәкірт?
Dialogue: 0,1:14:16.71,1:14:17.82,Default,,0,0,0,,Мастер?
Dialogue: 0,1:14:19.08,1:14:20.55,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,1:14:21.15,1:14:22.12,Default,,0,0,0,,Мұның бәрі.
Dialogue: 0,1:14:31.46,1:14:34.80,Default,,0,0,0,,Мен айдаһар жауынгермін
Dialogue: 0,1:14:35.63,1:14:37.94,Default,,0,0,0,,Қараңдаршы, мына айдаһарды көріп тұрсыңдар ма?
Dialogue: 0,1:14:39.67,1:14:41.47,Default,,0,0,0,,Найзағай соғуы
Dialogue: 0,1:14:42.11,1:14:43.91,Default,,0,0,0,,Өте керемет!
Dialogue: 0,1:15:09.90,1:15:10.70,Default,,0,0,0,,Белли Дон
Dialogue: 0,1:15:12.50,1:15:13.04,Default,,0,0,0,,Бетті пиши
Dialogue: 0,1:15:16.87,1:15:19.04,Default,,0,0,0,,Түс болды. Менің қарыным ашты.
Dialogue: 0,1:15:39.10,1:15:39.93,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:15:44.84,1:15:45.67,Default,,0,0,0,,Сен Құбыжықтарды жоюшылар корпусының мүшесі емессің бе?
Dialogue: 0,1:16:00.82,1:16:04.86,Default,,0,0,0,,Огвейдің назарын аудару үшін маған 500 жыл қажет болды.
Dialogue: 0,1:16:04.99,1:16:08.23,Default,,0,0,0,,Тағы 500 жыл өтсе де, мен сенің назарыңды ұрлаймын.
Dialogue: 0,1:16:08.63,1:16:11.23,Default,,0,0,0,,Печа Куча Шулы
Dialogue: 0,1:16:22.11,1:16:23.91,Default,,0,0,0,,Менің назарымды қалайсыз ба?
Dialogue: 0,1:16:24.71,1:16:25.64,Default,,0,0,0,,Мен оны саған беремін
Dialogue: 0,1:16:32.85,1:16:34.05,Default,,0,0,0,,Жарайды
Dialogue: 0,1:16:34.15,1:16:36.72,Default,,0,0,0,,Қуат менікі.
Dialogue: 0,1:16:39.26,1:16:40.86,Default,,0,0,0,,Күтіңіз.
Dialogue: 0,1:16:40.96,1:16:43.03,Default,,0,0,0,,Тым үлкен
Dialogue: 0,1:16:43.26,1:16:44.26,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,1:17:02.28,1:17:03.11,Default,,0,0,0,,Ол туралы не деуге болады?
Dialogue: 0,1:17:11.76,1:17:12.72,Default,,0,0,0,,мен өліп қалар едім.
Dialogue: 0,1:17:12.82,1:17:13.26,Default,,0,0,0,,Ең жақсы дос!
Dialogue: 0,1:17:13.66,1:17:15.29,Default,,0,0,0,,Тек мен орала алмаймын
Dialogue: 0,1:17:15.39,1:17:17.63,Default,,0,0,0,,Күтіңіз Ол бастапқыда жасыл түсті.
Dialogue: 0,1:17:17.96,1:17:18.93,Default,,0,0,0,,Жасыл сәби
Dialogue: 0,1:17:19.03,1:17:21.13,Default,,0,0,0,,Сәби емес!
Dialogue: 0,1:17:21.37,1:17:22.27,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:17:23.17,1:17:24.23,Default,,0,0,0,,По ше?
Dialogue: 0,1:17:24.33,1:17:25.20,Default,,0,0,0,,(Гильда) Бірден көп жеме – аздап-аздап же.
Dialogue: 0,1:17:25.30,1:17:27.17,Default,,0,0,0,,Жоқ. Онда емес пе?
Dialogue: 0,1:17:27.90,1:17:28.87,Default,,0,0,0,,По
Dialogue: 0,1:17:29.01,1:17:30.04,Default,,0,0,0,,По!
Dialogue: 0,1:17:30.64,1:17:32.31,Default,,0,0,0,,Неге қайтып келмейсің?
Dialogue: 0,1:17:42.82,1:17:44.66,Default,,0,0,0,,Айдаһар жауынгері
Dialogue: 0,1:17:44.72,1:17:45.89,Default,,0,0,0,,Мастер Огвей?
Dialogue: 0,1:17:50.29,1:17:51.19,Default,,0,0,0,,Бұл өтірік, солай ма?
Dialogue: 0,1:17:53.00,1:17:54.33,Default,,0,0,0,,Бұл өте жылтыр
Dialogue: 0,1:17:54.67,1:17:55.40,Default,,0,0,0,,Сіз де
Dialogue: 0,1:17:55.70,1:18:00.00,Default,,0,0,0,,Білемін, плащ желбіреп, керемет.
Dialogue: 0,1:18:00.10,1:18:02.17,Default,,0,0,0,,жақсы көрінеді, есейген
Dialogue: 0,1:18:02.24,1:18:04.31,Default,,0,0,0,,Панда ауылында тым көп жеу
Dialogue: 0,1:18:04.37,1:18:05.78,Default,,0,0,0,,Ішінде не бар?
Dialogue: 0,1:18:07.34,1:18:11.31,Default,,0,0,0,,Әкеме хабар жібергенімде дәл солай болды.
Dialogue: 0,1:18:12.05,1:18:14.15,Default,,0,0,0,,Ғарыштық пошта үшін души бар ма?
Dialogue: 0,1:18:15.02,1:18:15.79,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,1:18:16.75,1:18:19.09,Default,,0,0,0,,Әлем сізге керек еді
Dialogue: 0,1:18:19.32,1:18:20.22,Default,,0,0,0,,Мен?
Dialogue: 0,1:18:21.83,1:18:26.23,Default,,0,0,0,,Тағдыр көрсеткендей, сен пандаға айналдың.
Dialogue: 0,1:18:26.30,1:18:28.17,Default,,0,0,0,,Маған не болды...
Dialogue: 0,1:18:28.47,1:18:34.37,Default,,0,0,0,,Мен сені кездестіргенде мен кунг-фудың болашағын көрдім.
Dialogue: 0,1:18:37.11,1:18:38.94,Default,,0,0,0,,Және де өткен
Dialogue: 0,1:18:41.38,1:18:45.25,Default,,0,0,0,,Екеуін байланыстыра алатын панда.
Dialogue: 0,1:18:45.75,1:18:48.22,Default,,0,0,0,,Бұл сен едің
Dialogue: 0,1:18:48.85,1:18:51.86,Default,,0,0,0,,Инь де, Ян да бар адам...
Dialogue: 0,1:18:52.96,1:18:56.13,Default,,0,0,0,,Ол менің мұрагерім.
Dialogue: 0,1:18:59.03,1:19:01.26,Default,,0,0,0,,Маған? Мен оны ала алмаймын
Dialogue: 0,1:19:01.73,1:19:04.87,Default,,0,0,0,,Менде үлкенірек бар
Dialogue: 0,1:19:06.74,1:19:10.01,Default,,0,0,0,,Бірақ Душидің мұрагері мен емес...
Dialogue: 0,1:19:12.28,1:19:13.24,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,1:19:13.34,1:19:14.38,Default,,0,0,0,,Иә
Dialogue: 0,1:19:25.19,1:19:26.29,Default,,0,0,0,,Енді не болады?
Dialogue: 0,1:19:27.49,1:19:28.99,Default,,0,0,0,,Шешіңіз
Dialogue: 0,1:19:29.86,1:19:31.43,Default,,0,0,0,,Күте тұрыңыз, кетпеңіз.
Dialogue: 0,1:19:32.03,1:19:35.27,Default,,0,0,0,,Мен бармаймын, мен осында тұрамын.
Dialogue: 0,1:19:35.77,1:19:37.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:19:37.97,1:19:41.44,Default,,0,0,0,,Бару немесе қалуды өзіңіз шешесіз.
Dialogue: 0,1:19:42.17,1:19:43.84,Default,,0,0,0,,Мен қайтуға болады?
Dialogue: 0,1:19:44.07,1:19:47.18,Default,,0,0,0,,Сіз қалай ойлайсыз? Неге байқамасқа?
Dialogue: 0,1:20:14.04,1:20:14.97,Default,,0,0,0,,По
Dialogue: 0,1:20:16.04,1:20:17.57,Default,,0,0,0,,Сіз де ұша аласыз ба?
Dialogue: 0,1:20:23.81,1:20:26.18,Default,,0,0,0,,Әкеме, әкеме, әкеме!
Dialogue: 0,1:20:26.28,1:20:27.32,Default,,0,0,0,,Ұлым!
Dialogue: 0,1:20:30.92,1:20:33.49,Default,,0,0,0,,Ешқашан қайтадан гүл жапырақтарында жоғалып кетпеңіз
Dialogue: 0,1:20:33.56,1:20:35.19,Default,,0,0,0,,Мен бұл жақсы емес деп ойладым.
Dialogue: 0,1:20:35.33,1:20:37.53,Default,,0,0,0,,Маған барлығы көмектесті
Dialogue: 0,1:20:38.23,1:20:39.96,Default,,0,0,0,,Барлығы осында
Dialogue: 0,1:20:41.43,1:20:43.10,Default,,0,0,0,,Барлығыңыз келіңіздер!
Dialogue: 0,1:20:44.17,1:20:44.97,Default,,0,0,0,,Құшақтау
Dialogue: 0,1:20:48.87,1:20:49.97,Default,,0,0,0,,Мастер Шифу
Dialogue: 0,1:20:50.51,1:20:53.38,Default,,0,0,0,,Шәкірт ұлы ұстаз болады...
Dialogue: 0,1:20:53.44,1:20:54.85,Default,,0,0,0,,Шабуыл
Dialogue: 0,1:20:55.11,1:20:57.98,Default,,0,0,0,,Мен оны басқа елдегі душиден алдым.
Dialogue: 0,1:20:58.42,1:21:00.25,Default,,0,0,0,,Менің ойымша, солай.
Dialogue: 0,1:21:00.45,1:21:02.35,Default,,0,0,0,,Сіз цигонды меңгерген шығарсыз
Dialogue: 0,1:21:04.55,1:21:06.26,Default,,0,0,0,,Менің ойымша, солай.
Dialogue: 0,1:21:07.52,1:21:09.49,Default,,0,0,0,,Маған айта аласыз ба?
Dialogue: 0,1:21:12.93,1:21:13.86,Default,,0,0,0,,Дайындық!
Dialogue: 0,1:21:42.26,1:21:43.93,Default,,0,0,0,,Маймыл, көмектес!
Dialogue: 0,1:21:44.06,1:21:45.30,Default,,0,0,0,,Жасыл сәби
Dialogue: 0,1:21:45.43,1:21:46.56,Default,,0,0,0,,Бірдеңе жасаңыз
Dialogue: 0,1:21:54.24,1:21:55.04,Default,,0,0,0,,Сәлем
Dialogue: 0,1:22:05.65,1:22:07.15,Default,,0,0,0,,Шукаборн
Dialogue: 0,1:22:14.46,1:22:15.93,Default,,0,0,0,,Панда астмасы
Dialogue: 0,1:23:09.41,1:23:12.52,Default,,0,0,0,,Соңы
Dialogue: 0,1:23:14.02,1:23:20.02,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory