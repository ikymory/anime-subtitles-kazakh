Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.47,0:00:13.48,Default,,0,0,0,,(қоңырау қағу дыбысы)
Dialogue: 0,0:00:13.48,0:00:17.28,Default,,0,0,0,,(Тыныс алу жүгіру)
Dialogue: 0,0:00:20.15,0:00:22.32,Default,,0,0,0,,Уау! (Тоги) Жақсысың ба? Юкито.
Dialogue: 0,0:00:22.32,0:00:24.52,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:26.99,0:00:28.99,Default,,0,0,0,,Мен сені қорғаймын.
Dialogue: 0,0:00:28.99,0:00:32.49,Default,,0,0,0,,Енді кемеге жақындап қалдық. жалғастырыңыз.
Dialogue: 0,0:00:32.49,0:00:39.33,Default,,0,0,0,,♬～
Dialogue: 0,0:00:39.33,0:00:43.17,Default,,0,0,0,,Барлығыңыз тынышталыңыздар! Кемелер бірінен соң бірі келеді!
Dialogue: 0,0:00:43.17,0:00:45.34,Default,,0,0,0,,Қария! Арнау!
Dialogue: 0,0:00:45.34,0:00:48.18,Default,,0,0,0,,Жақсы екеніңізге қуаныштымын. Момоко ше?
Dialogue: 0,0:00:48.18,0:00:50.18,Default,,0,0,0,,Олар сол жерде эвакуацияға жетекшілік етеді.
Dialogue: 0,0:00:50.18,0:00:52.85,Default,,0,0,0,,Бізге алдымен эвакуациялық кемеге отыру керектігін айтты.
Dialogue: 0,0:00:52.85,0:00:56.18,Default,,0,0,0,,көремін. Джингикун және басқалары, сіз де осы кемеге отырыңыз.
Dialogue: 0,0:00:56.18,0:00:58.35,Default,,0,0,0,,Бірақ Хару-ни мен Шу-ни...!
Dialogue: 0,0:00:58.35,0:01:01.46,Default,,0,0,0,,Мен білемін. Янаги сол жаққа бара жатты.
Dialogue: 0,0:01:01.46,0:01:03.63,Default,,0,0,0,,Ұстаз! Бірақ...
Dialogue: 0,0:01:03.63,0:01:06.63,Default,,0,0,0,,Егер Янаги қайтып келмесе➡
Dialogue: 0,0:01:06.63,0:01:09.03,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:01:11.63,0:01:13.64,Default,,0,0,0,,Ол айналамыздағы суды қатып жатыр...
Dialogue: 0,0:01:17.97,0:01:21.64,Default,,0,0,0,,Кака. Ол қыңыр жігіт.
Dialogue: 0,0:01:21.64,0:01:24.31,Default,,0,0,0,,Менің ойымша, бұл жақсы өтті.
Dialogue: 0,0:01:24.31,0:01:28.32,Default,,0,0,0,,Жетістікке жетіп, шегіну – жұмақ жолы...
Dialogue: 0,0:01:28.32,0:01:33.99,Default,,0,0,0,,Ал, мен де соңғы жұмысымды орындаймын деп ойлаймын.
Dialogue: 0,0:01:33.99,0:01:38.99,Default,,0,0,0,,♬～
Dialogue: 0,0:01:38.99,0:01:42.10,Default,,0,0,0,,Уф...! Әй, көктем мен күз! Теми!
Dialogue: 0,0:01:45.00,0:01:47.00,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:01:47.00,0:01:50.01,Default,,0,0,0,,Мастер….
Dialogue: 0,0:01:50.01,0:01:52.31,Default,,0,0,0,,Ол айналамыздағы суды қатып жатыр...
Dialogue: 0,0:01:56.68,0:01:59.01,Default,,0,0,0,,Амансың ба? Мен мұндай нәрсені бірінші рет жасап тұрмын.
Dialogue: 0,0:01:59.01,0:02:04.79,Default,,0,0,0,,♬～
Dialogue: 0,0:02:04.79,0:02:07.62,Default,,0,0,0,,Мастер….
Dialogue: 0,0:02:07.62,0:02:09.63,Default,,0,0,0,,Ол айналамыздағы суды қатып жатыр...
Dialogue: 0,0:02:21.64,0:02:23.64,Default,,0,0,0,,Ол айналамыздағы суды қатып жатыр...
Dialogue: 0,0:02:47.50,0:02:50.33,Default,,0,0,0,,Ино мырза кім?
Dialogue: 0,0:02:50.33,0:02:52.33,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:02:56.17,0:02:59.88,Default,,0,0,0,,Ол айналамыздағы суды қатып жатыр...
Dialogue: 0,0:03:02.28,0:03:04.28,Default,,0,0,0,,Ол айналамыздағы суды қатып жатыр...
Dialogue: 0,0:03:04.28,0:03:08.45,Default,,0,0,0,,《А... бұл тағы да түс ме?
Dialogue: 0,0:03:08.45,0:03:11.12,Default,,0,0,0,,Біздің армандарымыз бірдей...
Dialogue: 0,0:03:11.12,0:03:13.79,Default,,0,0,0,,Су астында жалғыз қалу арманы.
Dialogue: 0,0:03:13.79,0:03:16.96,Default,,0,0,0,,Бір қызығы, мен ауырмаймын.
Dialogue: 0,0:03:16.96,0:03:20.13,Default,,0,0,0,,Адамдармен терең қарым-қатынас жасай алмайтыныма сенімдімін➡
Dialogue: 0,0:03:20.13,0:03:23.13,Default,,0,0,0,,Мен мұнда өзімді еркін сезінетін шығармын...》
Dialogue: 0,0:03:26.47,0:03:29.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:29.47,0:03:33.14,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:03:33.14,0:03:36.85,Default,,0,0,0,,Уф... енді ше...?
Dialogue: 0,0:03:39.31,0:03:41.32,Default,,0,0,0,,Ал, бәріңе.
Dialogue: 0,0:03:41.32,0:03:43.82,Default,,0,0,0,,Сізді мектеп бітіруіңізбен құттықтаймыз.
Dialogue: 0,0:03:43.82,0:03:47.49,Default,,0,0,0,,Мен соңғы үш жылдағы орта мектептегі өмірімде алған тәжірибемді бағалаймын...
Dialogue: 0,0:03:47.49,0:03:50.33,Default,,0,0,0,,Суретке түсіру. Мен оны көптен бері жақсы көремін!
Dialogue: 0,0:03:50.33,0:03:52.83,Default,,0,0,0,,Кешіріңіз, бұл мүмкін емес. иә? Міне бітті.
Dialogue: 0,0:03:52.83,0:03:55.33,Default,,0,0,0,,Мектеп бітіру кешін өткізейік. жақсы. келісім.
Dialogue: 0,0:03:55.33,0:03:57.50,Default,,0,0,0,,Ой, ол мені тастап кетті. Шулы!
Dialogue: 0,0:03:57.50,0:03:59.50,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:04:02.44,0:04:04.94,Default,,0,0,0,,Янаги-кун.
Dialogue: 0,0:04:04.94,0:04:06.94,Default,,0,0,0,,Мұғалім….
Dialogue: 0,0:04:06.94,0:04:10.61,Default,,0,0,0,,Сізді мектеп бітіруіңізбен құттықтаймыз. Сіз қозғалғалы жатырсыз, солай ма?
Dialogue: 0,0:04:10.61,0:04:13.12,Default,,0,0,0,,Иә. Нысаннан шығу➡
Dialogue: 0,0:04:13.12,0:04:15.78,Default,,0,0,0,,Туған жерге баруды жөн көрдім.
Dialogue: 0,0:04:15.78,0:04:20.29,Default,,0,0,0,,Марқұм әкемнің досы қамқоршы болады.
Dialogue: 0,0:04:20.29,0:04:24.29,Default,,0,0,0,,Иә. Бірақ бұл аздап өзімшілдік...
Dialogue: 0,0:04:24.29,0:04:26.96,Default,,0,0,0,,Мен ұзақ уақыт мекемеде қалсам да➡
Dialogue: 0,0:04:26.96,0:04:29.46,Default,,0,0,0,,Сенің кенеттен оралғаныңа сене алар емеспін...
Dialogue: 0,0:04:29.46,0:04:31.47,Default,,0,0,0,,Жарайсың ба, Янаги-кун?
Dialogue: 0,0:04:31.47,0:04:34.47,Default,,0,0,0,,Иә. Қай жерде болсаңыз да өзгермейді.
Dialogue: 0,0:04:34.47,0:04:36.47,Default,,0,0,0,,⚟Кеттік~. ⚟Волейбол үйірмесін де шақырғыңыз келе ме?
Dialogue: 0,0:04:36.47,0:04:40.64,Default,,0,0,0,,Мұғалім. Барлығы үшін көп рахмет.
Dialogue: 0,0:04:40.64,0:04:42.98,Default,,0,0,0,,Янаги-кун….
Dialogue: 0,0:04:42.98,0:04:45.31,Default,,0,0,0,,《Юкито: Әкем мен 5 жасымда қайтыс болды➡
Dialogue: 0,0:04:45.31,0:04:48.15,Default,,0,0,0,,Мен балалар үйінде өстім.
Dialogue: 0,0:04:48.15,0:04:53.66,Default,,0,0,0,,Айналамда жақсы адамдар бар, маған жамандық көрген емес.
Dialogue: 0,0:04:53.66,0:04:56.66,Default,,0,0,0,,Жалғыз қалғаныма мен кінәлімін...》
Dialogue: 0,0:04:56.66,0:04:59.49,Default,,0,0,0,,Ол кім? (Ер оқушы) Бұл, әрине, қауіпті.
Dialogue: 0,0:04:59.49,0:05:01.76,Default,,0,0,0,,Бұл сәл жақсы емес пе? Жоқ.
Dialogue: 0,0:05:01.76,0:05:10.44,Default,,0,0,0,,♬～
Dialogue: 0,0:05:10.44,0:05:12.44,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:12.44,0:05:15.28,Default,,0,0,0,,Сіз әлі дайынсыз ба?
Dialogue: 0,0:05:15.28,0:05:17.28,Default,,0,0,0,,О, мен бітіремін.
Dialogue: 0,0:05:17.28,0:05:19.61,Default,,0,0,0,,Мен қазіргі студентпін! О, менің...
Dialogue: 0,0:05:19.61,0:05:23.45,Default,,0,0,0,,Бұл не...?
Dialogue: 0,0:05:23.45,0:05:26.79,Default,,0,0,0,,Тез келмесең, арақ-шарап таусылады...
Dialogue: 0,0:05:26.79,0:05:28.79,Default,,0,0,0,,О? Алақай!
Dialogue: 0,0:05:28.79,0:05:30.79,Default,,0,0,0,,Біраз уақыт өтті! иә?
Dialogue: 0,0:05:30.79,0:05:34.13,Default,,0,0,0,,Ол үлкейіп барады!
Dialogue: 0,0:05:34.13,0:05:36.46,Default,,0,0,0,,Қалайсың? Уф...
Dialogue: 0,0:05:36.46,0:05:40.64,Default,,0,0,0,,Ішімдіктің иісі бар... Басқосуымызды тойлайық. Қараңыз.
Dialogue: 0,0:05:40.64,0:05:43.81,Default,,0,0,0,,Менің ойымша, бұл дұрыс емес адам. бұршақ пастасы?
Dialogue: 0,0:05:43.81,0:05:46.64,Default,,0,0,0,,Сіз Юкитосыз, солай ма? Юкито Янаги.
Dialogue: 0,0:05:46.64,0:05:49.48,Default,,0,0,0,,Жоқ... бұл дұрыс емес. иә?
Dialogue: 0,0:05:49.48,0:05:51.98,Default,,0,0,0,,Жоқ, жоқ, жоқ, өтірік айтпа.
Dialogue: 0,0:05:51.98,0:05:53.98,Default,,0,0,0,,Бұл Юкито, солай ма? Сіз қате адамсыз!
Dialogue: 0,0:05:53.98,0:05:57.32,Default,,0,0,0,,Қазір! иә?
Dialogue: 0,0:05:57.32,0:05:59.32,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:06:01.92,0:06:05.43,Default,,0,0,0,,《Не болды...》 (Цзинги) Эй, күте тұр.
Dialogue: 0,0:06:05.43,0:06:09.43,Default,,0,0,0,,Эй, сен Юкитосың, солай ма? Мені назардан тыс қалдырмаңыз.
Dialogue: 0,0:06:09.43,0:06:11.93,Default,,0,0,0,,Демек, бұл дұрыс емес адам.
Dialogue: 0,0:06:11.93,0:06:15.44,Default,,0,0,0,,Мм. Жарайды, менің таңдауым жоқ.
Dialogue: 0,0:06:15.44,0:06:17.61,Default,,0,0,0,,Не? иә? иә? не! ?
Dialogue: 0,0:06:17.61,0:06:21.11,Default,,0,0,0,,Ұшуға тырысу керек. Мағынасы!
Dialogue: 0,0:06:21.11,0:06:24.51,Default,,0,0,0,,Юкито Иккимаасу! (Юкито айқайлайды)
Dialogue: 0,0:06:28.12,0:06:30.29,Default,,0,0,0,,Енді...
Dialogue: 0,0:06:30.29,0:06:32.45,Default,,0,0,0,,《Не... анау жігіт...! ?
Dialogue: 0,0:06:32.45,0:06:36.46,Default,,0,0,0,,Менің киімім ауыр... Бұл қауіпті... Мен суға батып бара жатырмын...
Dialogue: 0,0:06:36.46,0:06:40.46,Default,,0,0,0,,Бұл қауіпті, бұл қауіпті, бұл қауіпті, бұл қауіпті…》
Dialogue: 0,0:06:40.46,0:06:48.30,Default,,0,0,0,,♬～
Dialogue: 0,0:06:48.30,0:06:50.81,Default,,0,0,0,,《Жаман... тағы да...! 》
Dialogue: 0,0:06:52.81,0:06:55.64,Default,,0,0,0,,《Тыныштал...! Тынышталыңыз...! тоқта...! 》
Dialogue: 0,0:06:55.64,0:06:57.65,Default,,0,0,0,,Ұрлық пен ұрлықтың рухы бар.
Dialogue: 0,0:07:00.08,0:07:02.08,Default,,0,0,0,,Буха! Ха… ха….
Dialogue: 0,0:07:02.08,0:07:04.59,Default,,0,0,0,,Өйткені сен Юкитосың.
Dialogue: 0,0:07:04.59,0:07:06.59,Default,,0,0,0,,Сіз оны тоқтаттыңыз ба?
Dialogue: 0,0:07:06.59,0:07:08.76,Default,,0,0,0,,Жарайды, тезірек барайық.
Dialogue: 0,0:07:08.76,0:07:11.59,Default,,0,0,0,,Иә? Қайда бара жатырсың?
Dialogue: 0,0:07:11.59,0:07:15.26,Default,,0,0,0,,Ыдыс жоқ, өз ісімен айналысу үшін ештеңе қолданбаңыз.
Dialogue: 0,0:07:15.26,0:07:17.43,Default,,0,0,0,,Иә? Апыр-ай!
Dialogue: 0,0:07:17.43,0:07:21.94,Default,,0,0,0,,Ай!
Dialogue: 0,0:07:21.94,0:07:23.94,Default,,0,0,0,,Уф... міне...
Dialogue: 0,0:07:23.94,0:07:25.94,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:25.94,0:07:29.78,Default,,0,0,0,,Теңіз! ? Неге! ?
Dialogue: 0,0:07:29.78,0:07:33.28,Default,,0,0,0,,Уа, байқадың ба? Бұл қайда! ?
Dialogue: 0,0:07:33.28,0:07:35.28,Default,,0,0,0,,Тынышталыңыз.
Dialogue: 0,0:07:35.28,0:07:38.62,Default,,0,0,0,,Бұл жағдайда сіз тыныштала алмайсыз!
Dialogue: 0,0:07:38.62,0:07:42.12,Default,,0,0,0,,Пхуха…. Айтпақшы, мектеп бітіруіңмен құттықтаймын.
Dialogue: 0,0:07:42.12,0:07:44.29,Default,,0,0,0,,Сусын ше? Жоқ, мен кәмелетке толмағанмын...➡
Dialogue: 0,0:07:44.29,0:07:46.29,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:07:46.29,0:07:50.13,Default,,0,0,0,,Хахаха…. Джинги саған ауыр тиген сияқты.
Dialogue: 0,0:07:50.13,0:07:53.47,Default,,0,0,0,,Бұл жігіт аралдағы атақты жаман бала.
Dialogue: 0,0:07:53.47,0:07:55.47,Default,,0,0,0,,Арал...? Бұл Аяка аралы.
Dialogue: 0,0:07:55.47,0:07:58.14,Default,,0,0,0,,Сен бұдан былай сонда тұрасың.
Dialogue: 0,0:07:58.14,0:08:01.91,Default,,0,0,0,,Әй, сен мен туған аралдансың ба?
Dialogue: 0,0:08:01.91,0:08:06.41,Default,,0,0,0,,Кеттік. Уайымдамаңыз, нысандағы багаж сізге кейінірек жіберіледі.
Dialogue: 0,0:08:06.41,0:08:08.58,Default,,0,0,0,,Әзірге, міне. Апыр-ай!
Dialogue: 0,0:08:08.58,0:08:11.25,Default,,0,0,0,,Киімді ауыстыру, солай ма? Мен суық тиюге бара жатырмын.
Dialogue: 0,0:08:11.25,0:08:15.59,Default,,0,0,0,,Мына рюкзак ше! ? Жер бетінде не болып жатыр? ?
Dialogue: 0,0:08:15.59,0:08:18.59,Default,,0,0,0,,Маған оқиғаны Инодағы қарт айтып берген болар.
Dialogue: 0,0:08:18.59,0:08:20.60,Default,,0,0,0,,Мен хат алдым, бірақ...
Dialogue: 0,0:08:20.60,0:08:23.10,Default,,0,0,0,,Сіз менің әкемнің досының танысысыз➡
Dialogue: 0,0:08:23.10,0:08:25.43,Default,,0,0,0,,Сонымен сен мені алып кетуге келдің...
Dialogue: 0,0:08:25.43,0:08:28.44,Default,,0,0,0,,Жақсы. Мен Сакава Томойошимін.
Dialogue: 0,0:08:28.44,0:08:31.77,Default,,0,0,0,,Мені Джинги-сан деп атаңыз!
Dialogue: 0,0:08:31.77,0:08:35.61,Default,,0,0,0,,Ол сенің үлкен ағаң сияқты. Үлкен аға...
Dialogue: 0,0:08:35.61,0:08:38.95,Default,,0,0,0,,Юкитоның әкесі...
Dialogue: 0,0:08:38.95,0:08:42.95,Default,,0,0,0,,Ұстаз маған да әкемдей.
Dialogue: 0,0:08:42.95,0:08:46.12,Default,,0,0,0,,Сіз не айттыңыз...? (мүйіз)
Dialogue: 0,0:08:46.12,0:08:50.96,Default,,0,0,0,,♬～
Dialogue: 0,0:08:50.96,0:08:53.63,Default,,0,0,0,,Теңізде пойыз жүріп жатыр...
Dialogue: 0,0:08:53.63,0:08:56.63,Default,,0,0,0,,Аяка аралдарын байланыстыратын теңіз пойызы.
Dialogue: 0,0:08:56.63,0:08:59.80,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл тәтті емес пе?
Dialogue: 0,0:08:59.80,0:09:03.10,Default,,0,0,0,,Аяка...? Қараңызшы, осында қалды.
Dialogue: 0,0:09:11.91,0:09:16.72,Default,,0,0,0,,(шағала дыбысы)
Dialogue: 0,0:09:20.76,0:09:26.09,Default,,0,0,0,,♬～
Dialogue: 0,0:09:26.09,0:09:28.10,Default,,0,0,0,,Әйтеуір... (Шексіз) Иә?
Dialogue: 0,0:09:28.10,0:09:31.00,Default,,0,0,0,,Бұл жұмбақ атмосферасы бар арал...
Dialogue: 0,0:09:32.93,0:09:35.77,Default,,0,0,0,,Бұл Аякасима аралындағы Ниношима.
Dialogue: 0,0:09:35.77,0:09:38.94,Default,,0,0,0,,Бес жасқа дейін осында өстің.
Dialogue: 0,0:09:38.94,0:09:41.78,Default,,0,0,0,,күрсіну…. Қараңызшы, бұл осылай.
Dialogue: 0,0:09:41.78,0:09:44.28,Default,,0,0,0,,Ностальгиялық? Жоқ…➡
Dialogue: 0,0:09:44.28,0:09:46.78,Default,,0,0,0,,Менің балалық шағым туралы көп емес...
Dialogue: 0,0:09:46.78,0:09:48.78,Default,,0,0,0,,Юкито-кун!
Dialogue: 0,0:09:48.78,0:09:50.79,Default,,0,0,0,,Уау. (Момоко) Уау.
Dialogue: 0,0:09:50.79,0:09:52.79,Default,,0,0,0,,Көптен бері көрмегелі!
Dialogue: 0,0:09:52.79,0:09:56.29,Default,,0,0,0,,Қош келдіңіз. Тынымсыз еңбегіңіз үшін рахмет, Джингикун.
Dialogue: 0,0:09:56.29,0:09:58.29,Default,,0,0,0,,Сен есейдің, Юкито-кун.
Dialogue: 0,0:09:58.29,0:10:01.13,Default,,0,0,0,,Мм... сен қайсысысың...?
Dialogue: 0,0:10:01.13,0:10:03.13,Default,,0,0,0,,Менің атым Момоко Амия.
Dialogue: 0,0:10:03.13,0:10:06.97,Default,,0,0,0,,Ол Юкито кішкентай кезінде тұрған үйдің қожайыны.
Dialogue: 0,0:10:06.97,0:10:11.14,Default,,0,0,0,,Біз бір отбасындай өмір сүрдік. Күрсіну….
Dialogue: 0,0:10:11.14,0:10:16.98,Default,,0,0,0,,Мен Мицуёси Ино, Аякасима қаласының мэрі және сіздің қамқоршыңызмын.
Dialogue: 0,0:10:16.98,0:10:20.15,Default,,0,0,0,,Сіз хатты оқыдыңыз ба? (Юкито) А, иә...
Dialogue: 0,0:10:20.15,0:10:24.15,Default,,0,0,0,,Қош келдіңіз, Юкито-кун. Аяка аралына қош келдіңіз.
Dialogue: 0,0:10:24.15,0:10:26.99,Default,,0,0,0,,Сәлеметсіз бе...
Dialogue: 0,0:10:26.99,0:10:31.33,Default,,0,0,0,,Джингикун мені алып кетуге келеді дегенді естімедім➡
Dialogue: 0,0:10:31.33,0:10:33.66,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:10:33.66,0:10:36.33,Default,,0,0,0,,Ол мені ертіп бара жатқанын айтты.
Dialogue: 0,0:10:36.33,0:10:46.17,Default,,0,0,0,,♬～
Dialogue: 0,0:10:46.17,0:10:49.84,Default,,0,0,0,,Уау…. Бұл ауыл, бірақ әдемі жер.
Dialogue: 0,0:10:49.84,0:10:52.01,Default,,0,0,0,,Иә. Ичиносима бұл➡
Dialogue: 0,0:10:52.01,0:10:54.35,Default,,0,0,0,,Бұл жандырақ және көп нәрсе ұсынады➡
Dialogue: 0,0:10:54.35,0:10:56.85,Default,,0,0,0,,Менің ойымша, бұл көңіл көтеру үшін баруға ұсынылатын орын.
Dialogue: 0,0:10:56.85,0:10:58.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:01.46,0:11:03.46,Default,,0,0,0,,Не? ше?
Dialogue: 0,0:11:03.46,0:11:05.56,Default,,0,0,0,,Жоқ, ештеңе...
Dialogue: 0,0:11:08.63,0:11:12.47,Default,,0,0,0,,Мазалағаным үшін кешіріңіз...
Dialogue: 0,0:11:12.47,0:11:14.64,Default,,0,0,0,,А, мен қайтып келдім. Мен қайтып келдім.
Dialogue: 0,0:11:14.64,0:11:18.14,Default,,0,0,0,,Сіз өз үйіңіздегідей сезінесіз және өз үйіңіздегідей сезінесіз деп үміттенемін.
Dialogue: 0,0:11:18.14,0:11:20.48,Default,,0,0,0,,Иә…. Сіз қалай ойлайсыз?
Dialogue: 0,0:11:20.48,0:11:24.31,Default,,0,0,0,,Есіңде бірдеңе бар ма? үй….
Dialogue: 0,0:11:24.31,0:11:26.48,Default,,0,0,0,,Ол адам сенің қожайын.
Dialogue: 0,0:11:26.48,0:11:28.65,Default,,0,0,0,,《Юкито: Бұл адам менікі...
Dialogue: 0,0:11:28.65,0:11:31.99,Default,,0,0,0,,Олар шынымен қанмен байланысты ма? 》
Dialogue: 0,0:11:31.99,0:11:34.99,Default,,0,0,0,,Юкито-кунның әкесі Янаги-сенсэй➡
Dialogue: 0,0:11:34.99,0:11:39.33,Default,,0,0,0,,Ол Аяка аралының үйлесімділігін қорғаған таңғажайып байланыс қызметкері болды.
Dialogue: 0,0:11:39.33,0:11:41.33,Default,,0,0,0,,Мистер импульстік қосылым?
Dialogue: 0,0:11:41.33,0:11:44.67,Default,,0,0,0,,Мен біз сияқты оғаш нәрселерді жасай алатын адамдар туралы айтып отырмын.
Dialogue: 0,0:11:44.67,0:11:47.67,Default,,0,0,0,,Олай болса маған анау басқа өлшемді қалтадай қарашы➡
Dialogue: 0,0:11:47.67,0:11:50.34,Default,,0,0,0,,Мүмкін рюкзакқа салынған шығар? Ал...
Dialogue: 0,0:11:50.34,0:11:52.34,Default,,0,0,0,,Джинги-чан...? Уф...
Dialogue: 0,0:11:52.34,0:11:55.01,Default,,0,0,0,,Юкито-кунды рюкзакқа салып алдың ба?
Dialogue: 0,0:11:55.01,0:11:58.35,Default,,0,0,0,,Сондай-ақ... Момоко-сан. Бұл біраз әзіл➡
Dialogue: 0,0:11:58.35,0:12:00.78,Default,,0,0,0,,Бұл Юкито екеуміздің қарым-қатынасымызға ғана тән, дәлірек айтсақ...!
Dialogue: 0,0:12:00.78,0:12:04.12,Default,,0,0,0,,Бұл олай емес. Импульстік қосылым...
Dialogue: 0,0:12:04.12,0:12:07.29,Default,,0,0,0,,Цзинги-кун Янагидің үшінші шәкірті болды.
Dialogue: 0,0:12:07.29,0:12:10.29,Default,,0,0,0,,Бірінші және екінші шәкірттер одан да таң қалдырады.
Dialogue: 0,0:12:10.29,0:12:14.30,Default,,0,0,0,,Өзіңді бауырларыңмен салыстырма. Бұл басқа маусым.
Dialogue: 0,0:12:14.30,0:12:18.13,Default,,0,0,0,,Сонда менің біртүрлі күштерім ше...?
Dialogue: 0,0:12:18.13,0:12:20.80,Default,,0,0,0,,Сіздің мінез-құлқыңыз мүлде жақсы емес➡
Dialogue: 0,0:12:20.80,0:12:22.80,Default,,0,0,0,,Бұл өрескел күштен басқа ештеңе емес.
Dialogue: 0,0:12:22.80,0:12:24.81,Default,,0,0,0,,Өйткені ол Янаги Сэнсидің ұлы➡
Dialogue: 0,0:12:24.81,0:12:27.81,Default,,0,0,0,,Мен сізде таңғажайып табиғи талант бар екеніне сенімдімін.
Dialogue: 0,0:12:27.81,0:12:30.31,Default,,0,0,0,,Менің әкем солай істеген ➡
Dialogue: 0,0:12:30.31,0:12:32.65,Default,,0,0,0,,Мен мұны бірінші рет білдім...
Dialogue: 0,0:12:32.65,0:12:34.65,Default,,0,0,0,,Ана...?
Dialogue: 0,0:12:34.65,0:12:37.99,Default,,0,0,0,,Жарайды...айту қиын...
Dialogue: 0,0:12:37.99,0:12:39.99,Default,,0,0,0,,Кенет қожайын құпия бала➡
Dialogue: 0,0:12:39.99,0:12:42.16,Default,,0,0,0,,Мен сені үйге әкелгенде қорықтым.
Dialogue: 0,0:12:42.16,0:12:44.83,Default,,0,0,0,,Сен басқа әйел туралы ештеңе айтпадың ғой, солай ма?
Dialogue: 0,0:12:44.83,0:12:48.16,Default,,0,0,0,,Эй, Джинги-чан! Шеберге ұқсайды~➡
Dialogue: 0,0:12:48.16,0:12:51.67,Default,,0,0,0,,Хахаха... Басқаша айтқанда, анасы белгісіз...
Dialogue: 0,0:12:51.67,0:12:54.67,Default,,0,0,0,,Көптен бері бұлай сөйлей алмаппын➡
Dialogue: 0,0:12:54.67,0:12:58.51,Default,,0,0,0,,Мен сені құрлықтағы қарттар үйіне қалдырдым.
Dialogue: 0,0:12:58.51,0:13:01.94,Default,,0,0,0,,Неге кенет маған қайта қоңырау шалуды ойладың?
Dialogue: 0,0:13:01.94,0:13:05.28,Default,,0,0,0,,Бұл Янагидің еркі болды. (Юкито) Менің әкем...
Dialogue: 0,0:13:05.28,0:13:09.45,Default,,0,0,0,,Мен өлсем, Юкито материкте өседі➡
Dialogue: 0,0:13:09.45,0:13:13.45,Default,,0,0,0,,Осы уақыт ішінде Аяка аралымен мүмкіндігінше байланысты үзіңіз.
Dialogue: 0,0:13:13.45,0:13:16.96,Default,,0,0,0,,Ал қайта қоңырау шалуға болатын кезең...
Dialogue: 0,0:13:16.96,0:13:20.46,Default,,0,0,0,,Мен де себебін білмеймін.
Dialogue: 0,0:13:20.46,0:13:24.80,Default,,0,0,0,,Шынымды айтсам, Янаги мырза неге мұндай өсиет жасады?
Dialogue: 0,0:13:24.80,0:13:27.47,Default,,0,0,0,,Бірақ Янаги айтқанын қалдырған соң➡
Dialogue: 0,0:13:27.47,0:13:31.47,Default,,0,0,0,,Оның қандай да бір маңызды мағынасы болуы керек деген қорытынды жасаудан басқа амалым қалмады.
Dialogue: 0,0:13:31.47,0:13:34.81,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:13:34.81,0:13:39.15,Default,,0,0,0,,Бірақ сен енді осында тұра аласың ба деп ойлаймын.
Dialogue: 0,0:13:39.15,0:13:41.65,Default,,0,0,0,,Кешіріңіз. Бұл тек өзімшілдікпен айтылған сөз.
Dialogue: 0,0:13:41.65,0:13:45.65,Default,,0,0,0,,Жоқ... Жарайды. Бұл шынымен маңызды емес.
Dialogue: 0,0:13:45.65,0:13:48.49,Default,,0,0,0,,Қай жерде болсаң да солай.
Dialogue: 0,0:13:48.49,0:13:50.49,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:13:53.33,0:13:55.53,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:13:58.67,0:14:02.07,Default,,0,0,0,,Бұл менің бөлмем бола ма?
Dialogue: 0,0:14:08.44,0:14:10.78,Default,,0,0,0,,Уау! Бұл не! ?
Dialogue: 0,0:14:10.78,0:14:13.78,Default,,0,0,0,,Бұл Митама. Зиянсыз.
Dialogue: 0,0:14:13.78,0:14:17.45,Default,,0,0,0,,Митама...? Олар осы аралда жиі кездеседі.
Dialogue: 0,0:14:17.45,0:14:21.12,Default,,0,0,0,,Ақырында үйреніп кетесің. Бұл не...
Dialogue: 0,0:14:21.12,0:14:23.79,Default,,0,0,0,,Айтайын дегенім, рұқсатсыз кірмеңіз!
Dialogue: 0,0:14:23.79,0:14:26.96,Default,,0,0,0,,Жақсы. Ах.
Dialogue: 0,0:14:26.96,0:14:28.96,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:14:28.96,0:14:33.13,Default,,0,0,0,,Жүр, неге мұндай оғаш тосқауыл қойып отырсың?
Dialogue: 0,0:14:33.13,0:14:36.64,Default,,0,0,0,,Дайын бол. Бұрынғылар➡
Dialogue: 0,0:14:36.64,0:14:39.14,Default,,0,0,0,,«Қайда болсаңыз да, бәрі бірдей». Солай ма?
Dialogue: 0,0:14:39.14,0:14:41.48,Default,,0,0,0,,Бұл қандай сезім?
Dialogue: 0,0:14:41.48,0:14:44.98,Default,,0,0,0,,Момоко-сан мен Ино-санға дөрекі болсаң➡
Dialogue: 0,0:14:44.98,0:14:47.15,Default,,0,0,0,,Бұл үшін кешірім сұраймын.
Dialogue: 0,0:14:47.15,0:14:50.82,Default,,0,0,0,,Мен сенен кешірім сұрамаймын, өйткені Джинги-сан дөрекірек.
Dialogue: 0,0:14:50.82,0:14:52.82,Default,,0,0,0,,Оқиғаны өзгертпеңіз.
Dialogue: 0,0:14:52.82,0:14:58.03,Default,,0,0,0,,Менің адамдармен терең араласуға ниетім жоқ.
Dialogue: 0,0:15:00.43,0:15:02.43,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:02.43,0:15:05.60,Default,,0,0,0,,Қарттар үйінің қолынан қаза тапқаның ауырып тұрған жоқ па?
Dialogue: 0,0:15:05.60,0:15:07.60,Default,,0,0,0,,Менімен сөйлес.
Dialogue: 0,0:15:09.60,0:15:13.61,Default,,0,0,0,,Мен кішкентай кезімде бір мекеменің балаларымен➡
Dialogue: 0,0:15:13.61,0:15:16.61,Default,,0,0,0,,Мен бір рет өзен жағасына ойнауға бардым.
Dialogue: 0,0:15:16.61,0:15:21.12,Default,,0,0,0,,Сол кезде бір бала маған ұнамайтын қылықтай бастады.
Dialogue: 0,0:15:23.12,0:15:26.02,Default,,0,0,0,,Мен ашуландым...
Dialogue: 0,0:15:31.13,0:15:36.33,Default,,0,0,0,,Ол білмей жатып, өзеннің суы баланы қағып кетті.
Dialogue: 0,0:15:38.80,0:15:41.97,Default,,0,0,0,,Мен не болып жатқанын білмедім, бірақ➡
Dialogue: 0,0:15:41.97,0:15:45.64,Default,,0,0,0,,Мен мұны істегенімді ғана білемін.
Dialogue: 0,0:15:45.64,0:15:49.64,Default,,0,0,0,,Осыған ұқсас оқиғалар содан бері бірнеше рет болды...
Dialogue: 0,0:15:49.64,0:15:53.65,Default,,0,0,0,,Мен адамдармен араласудан бас тарттым.
Dialogue: 0,0:15:53.65,0:15:56.98,Default,,0,0,0,,Жалғыз қалғанда, менің сезімдерім тым қобалжымайды.
Dialogue: 0,0:15:56.98,0:16:00.76,Default,,0,0,0,,Менің осылай өмір сүруден басқа амалым жоқ.
Dialogue: 0,0:16:00.76,0:16:03.42,Default,,0,0,0,,Ах! Шынымды айтсам, мен жеңілдім!
Dialogue: 0,0:16:03.42,0:16:05.93,Default,,0,0,0,,Біраз уақыттан кейін тазартылды.
Dialogue: 0,0:16:05.93,0:16:08.76,Default,,0,0,0,,А, әңгіме бітті ме?
Dialogue: 0,0:16:08.76,0:16:14.10,Default,,0,0,0,,Бұл жеткілікті. Эй, күте тұрыңыз. Бұл жаман болды.
Dialogue: 0,0:16:14.10,0:16:16.27,Default,,0,0,0,,Хм….
Dialogue: 0,0:16:16.27,0:16:20.44,Default,,0,0,0,,Юкито-кун? Жақында кешкі ас беріледі.
Dialogue: 0,0:16:20.44,0:16:23.95,Default,,0,0,0,,Кешіріңіз. Мен аздап салқындап тұрмын.
Dialogue: 0,0:16:23.95,0:16:26.05,Default,,0,0,0,,О...
Dialogue: 0,0:16:32.12,0:16:37.79,Default,,0,0,0,,《Жоқ, тітіркенбеңіз, эмоцияларыңызды бұзбаңыз.
Dialogue: 0,0:16:37.79,0:16:40.80,Default,,0,0,0,,Осы уақытқа дейін менен арақашықтықты сақтасаңыз➡
Dialogue: 0,0:16:40.80,0:16:45.47,Default,,0,0,0,,Ешкім қажеттен артық жақындаған жоқ...》
Dialogue: 0,0:16:45.47,0:16:47.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:47.47,0:16:50.57,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:16:57.65,0:17:00.75,Default,,0,0,0,,Не?
Dialogue: 0,0:17:00.75,0:17:02.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:02.75,0:17:08.26,Default,,0,0,0,,♬～
Dialogue: 0,0:17:08.26,0:17:10.59,Default,,0,0,0,,А...? Ха! ?
Dialogue: 0,0:17:10.59,0:17:12.59,Default,,0,0,0,,Басқаларға көрсетпеу керек.
Dialogue: 0,0:17:12.59,0:17:14.93,Default,,0,0,0,,Уау...!
Dialogue: 0,0:17:14.93,0:17:18.10,Default,,0,0,0,,О~о~ Менің ойымша, сіз бірден Арамитамаға тап болдыңыз.
Dialogue: 0,0:17:18.10,0:17:20.27,Default,,0,0,0,,Арамитама! ?
Dialogue: 0,0:17:20.27,0:17:23.94,Default,,0,0,0,,Бұрынғы бөлмедегіден айырмашылығы, бұл әлдеқайда зиянды.
Dialogue: 0,0:17:23.94,0:17:27.44,Default,,0,0,0,,Сіз құрттай тұрғаныңыз үшін келдіңіз емес пе?
Dialogue: 0,0:17:27.44,0:17:29.61,Default,,0,0,0,,Бұл... Не істеуім керек?
Dialogue: 0,0:17:29.61,0:17:34.28,Default,,0,0,0,,Маған қара. Сіздің әкеңіз Масато Янагидің үшінші шәкірті➡
Dialogue: 0,0:17:34.28,0:17:39.62,Default,,0,0,0,,Мен сізге Джиноши Сагаваның тамырды қосу техникасын көрсетемін.
Dialogue: 0,0:17:39.62,0:17:42.12,Default,,0,0,0,,(Арамитаманың айқайы)
Dialogue: 0,0:17:44.13,0:17:47.30,Default,,0,0,0,,Джинчи Тендо!
Dialogue: 0,0:17:47.30,0:17:50.63,Default,,0,0,0,,Барлық заттар иньді көтереді және Янды қабылдайды, ➡
Dialogue: 0,0:17:50.63,0:17:53.63,Default,,0,0,0,,Окики, бейбітшілік орнату үшін.
Dialogue: 0,0:17:53.63,0:18:04.58,Default,,0,0,0,,♬～
Dialogue: 0,0:18:04.58,0:18:07.08,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:18:07.08,0:18:09.08,Default,,0,0,0,,Сіз қалай ойлайсыз? таңқаларлық….
Dialogue: 0,0:18:09.08,0:18:14.92,Default,,0,0,0,,Дұрыс. Бұл дұрыс. Үлкендеріңізді құрметтеңіздер. Хахахаха….
Dialogue: 0,0:18:14.92,0:18:17.22,Default,,0,0,0,,Джинёши мырза, артта... Әй?
Dialogue: 0,0:18:19.26,0:18:21.26,Default,,0,0,0,,Юкито. Иә... Иә.
Dialogue: 0,0:18:21.26,0:18:23.76,Default,,0,0,0,,Сізге біраз уақыт ұшу керек. иә?
Dialogue: 0,0:18:23.76,0:18:25.77,Default,,0,0,0,,Не? Сізге сәттілік тілеймін.
Dialogue: 0,0:18:25.77,0:18:27.77,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:18:29.77,0:18:33.57,Default,,0,0,0,,《Кездескенше! ? Шынымды айтсам, бұл қандай адам? ? 》
Dialogue: 0,0:18:35.94,0:18:40.78,Default,,0,0,0,,《Бақ... не қаласаң, соны істе де, оны бұз➡
Dialogue: 0,0:18:40.78,0:18:42.95,Default,,0,0,0,,Ақырында мені өлтіруді жоспарлап отырсың ба?
Dialogue: 0,0:18:42.95,0:18:45.79,Default,,0,0,0,,Уайымдама... Широ! 》
Dialogue: 0,0:18:45.79,0:18:51.46,Default,,0,0,0,,♬～
Dialogue: 0,0:18:51.46,0:18:54.46,Default,,0,0,0,,Бір ғана күш тең.
Dialogue: 0,0:18:58.13,0:19:00.74,Default,,0,0,0,,《А... жоқ... мен мұны қайталаймын...》
Dialogue: 0,0:19:00.74,0:19:02.74,Default,,0,0,0,,Балық шетінен қашып кетпеуі керек.
Dialogue: 0,0:19:02.74,0:19:06.41,Default,,0,0,0,,Бақытсыздықтың сауыттарын басқаларға көрсетуге болмайды.
Dialogue: 0,0:19:06.41,0:19:11.21,Default,,0,0,0,,♬～
Dialogue: 0,0:19:14.08,0:19:16.92,Default,,0,0,0,,Жақсы жұмыс!
Dialogue: 0,0:19:16.92,0:19:19.09,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:19:19.09,0:19:22.09,Default,,0,0,0,,Джинги-сан сені тоқтатты ма?
Dialogue: 0,0:19:22.09,0:19:24.59,Default,,0,0,0,,Кел, сен. Өз күшіңізбен➡
Dialogue: 0,0:19:24.59,0:19:26.76,Default,,0,0,0,,Сіз қатты шошып кеткен сияқтысыз➡
Dialogue: 0,0:19:26.76,0:19:29.10,Default,,0,0,0,,Мәселе қуаттың өзінде емес➡
Dialogue: 0,0:19:29.10,0:19:31.60,Default,,0,0,0,,Өйткені бақылау нашар.
Dialogue: 0,0:19:31.60,0:19:35.27,Default,,0,0,0,,Егер сіз оның бақылаудан шығып кетуінен қорқатын болсаңыз, оны дұрыс басқара алатыныңызға көз жеткізіңіз.
Dialogue: 0,0:19:35.27,0:19:38.11,Default,,0,0,0,,Басқару... Бұл мүмкін бе?
Dialogue: 0,0:19:38.11,0:19:40.11,Default,,0,0,0,,Бұл анық.
Dialogue: 0,0:19:40.11,0:19:42.94,Default,,0,0,0,,Оған көмектесу мүмкін емес, сондықтан мен сенің жаттығуларыңмен айналысамын.
Dialogue: 0,0:19:42.94,0:19:45.61,Default,,0,0,0,,Оны ұстаз деп құрметтеңіз.
Dialogue: 0,0:19:45.61,0:19:49.45,Default,,0,0,0,,(Арамитаманың бейбіт айқайы)
Dialogue: 0,0:19:49.45,0:19:52.79,Default,,0,0,0,,Бұл... Арамитама тазартылды.
Dialogue: 0,0:19:52.79,0:19:55.96,Default,,0,0,0,,Бұл біршама өрескел әдіс болды.
Dialogue: 0,0:19:55.96,0:20:00.29,Default,,0,0,0,,(Арамитаманың нәзік айқайы)
Dialogue: 0,0:20:00.29,0:20:02.96,Default,,0,0,0,,Адамдармен терең араласуға ниетіңіз жоқ➡
Dialogue: 0,0:20:02.96,0:20:05.47,Default,,0,0,0,,Жиренішті ештеңе айтпа.
Dialogue: 0,0:20:05.47,0:20:08.64,Default,,0,0,0,,Сенің ашуланып, ашулансаң маған бәрібір.
Dialogue: 0,0:20:08.64,0:20:11.64,Default,,0,0,0,,Өз эмоцияңызды дұрыс көрсетіңіз. Кәне.
Dialogue: 0,0:20:11.64,0:20:14.14,Default,,0,0,0,,Хе.
Dialogue: 0,0:20:14.14,0:20:16.14,Default,,0,0,0,,｟Хе｠
Dialogue: 0,0:20:16.14,0:20:18.81,Default,,0,0,0,,《Бұл... баяғыда...➡
Dialogue: 0,0:20:18.81,0:20:22.82,Default,,0,0,0,,Сізде осындай аға болған сияқты...? 》
Dialogue: 0,0:20:22.82,0:20:26.15,Default,,0,0,0,,Үйге қайтайық! Көп шықпайсың➡
Dialogue: 0,0:20:26.15,0:20:29.66,Default,,0,0,0,,Мен күдіктендім. Тойлау үшін ішеміз бе?
Dialogue: 0,0:20:29.66,0:20:31.99,Default,,0,0,0,,Сіз де!
Dialogue: 0,0:20:31.99,0:20:36.16,Default,,0,0,0,,Эмоциялар Мен оларды дұрыс шығарамын.
Dialogue: 0,0:20:36.16,0:20:38.57,Default,,0,0,0,,Сіз кәмелетке толмаған екеніңізді айттыңыз! Апыр-ай!
Dialogue: 0,0:20:42.17,0:20:57.02,Default,,0,0,0,,♬～
Dialogue: 0,0:20:57.02,0:21:00.29,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:00.29,0:21:03.29,Default,,0,0,0,,Мұғалім? (Яко) Өтінемін, сен не істедің?
Dialogue: 0,0:21:03.29,0:21:08.00,Default,,0,0,0,,Жоқ.Ол бала қайтып кеткен сияқты.
Dialogue: 0,0:21:12.13,0:21:14.14,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:21:21.64,0:21:24.65,Default,,0,0,0,,Hmph….
Dialogue: 0,0:21:24.65,0:21:26.81,Default,,0,0,0,,Хигаши Уордта басқа ауытқулар жоқ.
Dialogue: 0,0:21:26.81,0:21:30.48,Default,,0,0,0,,Ниши Уордқа дейін кеңейтуді жалғастырғыңыз келе ме?
Dialogue: 0,0:21:30.48,0:21:33.49,Default,,0,0,0,,Бастық? Ештеңе.
Dialogue: 0,0:21:33.49,0:21:38.16,Default,,0,0,0,,Міне бүгін. GOZ-ке оралайық. иә.
Dialogue: 0,0:21:38.16,0:21:40.83,Default,,0,0,0,,Уау, Сами. Мен үйдемін.
Dialogue: 0,0:21:40.83,0:21:43.16,Default,,0,0,0,,Жақсы. Екеуіңе не болды?
Dialogue: 0,0:21:43.16,0:21:45.33,Default,,0,0,0,,Арамитама су жолына шықты.
Dialogue: 0,0:21:45.33,0:21:47.33,Default,,0,0,0,,Самио, Момоко-сан.
Dialogue: 0,0:21:47.33,0:21:51.01,Default,,0,0,0,,Амансың ба? Ванна қайнап жатыр, алдымен ішке кіріңіз.
Dialogue: 0,0:21:51.01,0:21:53.17,Default,,0,0,0,,Міне. кешіріңіз.
Dialogue: 0,0:21:53.17,0:21:57.01,Default,,0,0,0,,Мен зардап шеккен жоқпын. А... а... иә.
Dialogue: 0,0:21:57.01,0:21:59.01,Default,,0,0,0,,жақсы болар еді.
Dialogue: 0,0:21:59.01,0:22:01.62,Default,,0,0,0,,Қош келдіңіз, Юкито-кун.
Dialogue: 0,0:22:01.62,0:22:04.12,Default,,0,0,0,,Ах... у...
Dialogue: 0,0:22:06.12,0:22:08.12,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:22:08.12,0:22:10.83,Default,,0,0,0,,Мен үйдемін.
Dialogue: 0,0:22:12.33,0:22:18.33,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
