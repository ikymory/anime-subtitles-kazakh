Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.00,0:00:04.10,Default,,0,0,0,,(Митаманың азапты айқайы)
Dialogue: 0,0:00:07.84,0:00:11.51,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:00:11.51,0:00:13.84,Default,,0,0,0,,А... аа....
Dialogue: 0,0:00:13.84,0:00:17.35,Default,,0,0,0,,(От Арамитаманың айқайы)
Dialogue: 0,0:00:17.35,0:00:21.35,Default,,0,0,0,,Тікеннен қаш...
Dialogue: 0,0:00:21.35,0:00:25.35,Default,,0,0,0,,А... Әке... Са...
Dialogue: 0,0:00:25.35,0:00:27.66,Default,,0,0,0,,(жану дыбысы)
Dialogue: 0,0:00:29.69,0:00:32.86,Default,,0,0,0,,Ха ха ха ха….
Dialogue: 0,0:00:32.86,0:00:35.36,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:35.36,0:00:37.87,Default,,0,0,0,,Сен өлуге тым құндысың. Бар!
Dialogue: 0,0:00:37.87,0:00:40.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:42.87,0:00:46.17,Default,,0,0,0,,(айқай)
Dialogue: 0,0:00:50.05,0:00:52.05,Default,,0,0,0,,Уф!
Dialogue: 0,0:00:54.72,0:00:56.72,Default,,0,0,0,,Ха! (мылтық)
Dialogue: 0,0:00:56.72,0:00:59.55,Default,,0,0,0,,(Отты арамитаманың ыңылдауы)
Dialogue: 0,0:00:59.55,0:01:02.66,Default,,0,0,0,,Қоқыс….
Dialogue: 0,0:01:02.66,0:01:05.49,Default,,0,0,0,,Сіз тамаша жұмыс жасадыңыз.
Dialogue: 0,0:01:05.49,0:01:08.00,Default,,0,0,0,,Қалғанын маған қалдырыңыз.
Dialogue: 0,0:01:08.00,0:01:16.10,Default,,0,0,0,,♬～
Dialogue: 0,0:01:18.17,0:01:20.18,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:01:20.18,0:01:24.18,Default,,0,0,0,,Мен... Ичиджо мырза! Сенімен бәрі жақсы ма! ?
Dialogue: 0,0:03:08.82,0:03:12.15,Default,,0,0,0,,Мен... Ичиджо мырза! Сенімен бәрі жақсы ма! ?
Dialogue: 0,0:03:12.15,0:03:16.16,Default,,0,0,0,,Уайымдама... (жарылыс дыбысы)
Dialogue: 0,0:03:16.16,0:03:20.16,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:03:20.16,0:03:22.16,Default,,0,0,0,,Бұл өтірік болғандықтан ба?>
Dialogue: 0,0:03:22.16,0:03:25.00,Default,,0,0,0,,Жанжалсыз барлық нәрсеге пайда әкелетін су➡
Dialogue: 0,0:03:25.00,0:03:27.50,Default,,0,0,0,,Жамандық жасаған адамдарды жазала!
Dialogue: 0,0:03:27.50,0:03:36.01,Default,,0,0,0,,♬～
Dialogue: 0,0:03:36.01,0:03:40.52,Default,,0,0,0,,(Отты арамитаманың ыңылауы)
Dialogue: 0,0:03:40.52,0:03:46.02,Default,,0,0,0,,♬～
Dialogue: 0,0:03:46.02,0:03:49.02,Default,,0,0,0,,Жоқ, менің техникаммен ештеңе істей алмаймын!
Dialogue: 0,0:03:49.02,0:03:51.03,Default,,0,0,0,,Ичиджо мырза, тұрыңыз! ?
Dialogue: 0,0:03:51.03,0:03:53.03,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:03:55.03,0:03:57.03,Default,,0,0,0,,Міне болды! (Тыныс алу жүгіру)
Dialogue: 0,0:03:57.03,0:04:00.47,Default,,0,0,0,,Бұл Ичиджо болды ма? Сонымен Юкито да?
Dialogue: 0,0:04:00.47,0:04:02.64,Default,,0,0,0,,Амансың ба? ? Жарайды.
Dialogue: 0,0:04:02.64,0:04:04.64,Default,,0,0,0,,Менде әлі Арамитама бар!
Dialogue: 0,0:04:07.81,0:04:09.81,Default,,0,0,0,,Бұл келе жатыр!
Dialogue: 0,0:04:11.98,0:04:15.48,Default,,0,0,0,,Бұл не деген құдірет! А... бұл ыстық!
Dialogue: 0,0:04:15.48,0:04:18.32,Default,,0,0,0,,Бұл жақсы емес! Барлығы жүгір!
Dialogue: 0,0:04:18.32,0:04:20.82,Default,,0,0,0,,Тіпті айтпай-ақ! Юкито-кун! ?
Dialogue: 0,0:04:20.82,0:04:22.99,Default,,0,0,0,,Мен де мүмкіндікті пайдаланып кетемін!
Dialogue: 0,0:04:22.99,0:04:25.99,Default,,0,0,0,,Тезірек жүр, Ичиджо-сан! Жоқ...
Dialogue: 0,0:04:25.99,0:04:28.16,Default,,0,0,0,,Қашып кетсең, артыңнан келеді.
Dialogue: 0,0:04:28.16,0:04:30.67,Default,,0,0,0,,Қаладағы адамдар қатысады.
Dialogue: 0,0:04:30.67,0:04:32.67,Default,,0,0,0,,Ха...! бірақ!
Dialogue: 0,0:04:32.67,0:04:36.37,Default,,0,0,0,,Мен мұны істеймін. Адамзат жердегі аспан!
Dialogue: 0,0:04:41.01,0:04:43.18,Default,,0,0,0,,Мұнда бірдеңе жасаңыз!
Dialogue: 0,0:04:43.18,0:04:45.18,Default,,0,0,0,,Ичиджо мырза!
Dialogue: 0,0:04:45.18,0:04:47.18,Default,,0,0,0,,Сонымен... керемет...
Dialogue: 0,0:04:47.18,0:04:50.35,Default,,0,0,0,,(айқай)
Dialogue: 0,0:04:50.35,0:04:54.36,Default,,0,0,0,,Жоқ! (Чатаро/Яго) Уау!
Dialogue: 0,0:04:54.36,0:04:56.36,Default,,0,0,0,,(Отты арамитаманың ыңылауы)
Dialogue: 0,0:04:56.36,0:04:58.53,Default,,0,0,0,,Көмек көрсетуіңізді өтінемін!
Dialogue: 0,0:04:58.53,0:05:01.80,Default,,0,0,0,,О... эй. Ичиджо мырза! Сенімен бәрі жақсы ма!
Dialogue: 0,0:05:01.80,0:05:09.64,Default,,0,0,0,,♬～
Dialogue: 0,0:05:09.64,0:05:11.64,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:05:11.64,0:05:14.64,Default,,0,0,0,,Балық шетінен қашып кетпеуі керек.
Dialogue: 0,0:05:14.64,0:05:19.65,Default,,0,0,0,,Жанжалды ыдыстарыңызды көрсетпеңіз!
Dialogue: 0,0:05:19.65,0:05:26.49,Default,,0,0,0,,♬～
Dialogue: 0,0:05:26.49,0:05:28.49,Default,,0,0,0,,Мен жасадым...
Dialogue: 0,0:05:28.49,0:05:31.33,Default,,0,0,0,,Бұл кедергі ме? Бұлай етпе, Юкито!
Dialogue: 0,0:05:31.33,0:05:33.33,Default,,0,0,0,,Себебі мен жаттықтым...!
Dialogue: 0,0:05:33.33,0:05:35.50,Default,,0,0,0,,Бірақ сақтықты төмендетпеңіз! Бұл ұзаққа созылмайды ...
Dialogue: 0,0:05:35.50,0:05:38.00,Default,,0,0,0,,(От Арамитаманың жауынгерлік айқайы)
Dialogue: 0,0:05:38.00,0:05:41.00,Default,,0,0,0,,Тағы да. Эй, мен енді мұны істей алмаймын!
Dialogue: 0,0:05:41.00,0:05:43.00,Default,,0,0,0,,Бұл абайсызда!
Dialogue: 0,0:05:43.00,0:05:45.51,Default,,0,0,0,,Абайсыз... Бірақ мен мұны істеймін!
Dialogue: 0,0:05:45.51,0:05:48.18,Default,,0,0,0,,Сәлем! ? Шынымен, ол жігіт...!
Dialogue: 0,0:05:48.18,0:05:51.18,Default,,0,0,0,,Қашпа.
Dialogue: 0,0:05:51.18,0:05:55.52,Default,,0,0,0,,Мен қосылдым...!
Dialogue: 0,0:05:55.52,0:05:57.52,Default,,0,0,0,,Импульстік қосылым….
Dialogue: 0,0:05:57.52,0:06:00.12,Default,,0,0,0,,《Иә, қашып кетсем не істеуім керек?
Dialogue: 0,0:06:00.12,0:06:03.29,Default,,0,0,0,,Біз қолымыздан келгенін жасаймыз! 》
Dialogue: 0,0:06:03.29,0:06:06.29,Default,,0,0,0,,Чатаро-кун! Яко-кун! Маған күшіңді бер!
Dialogue: 0,0:06:06.29,0:06:08.80,Default,,0,0,0,,Қандай көлеңкелі бейбақ!
Dialogue: 0,0:06:08.80,0:06:11.13,Default,,0,0,0,,О...бәріміз қосылдық!
Dialogue: 0,0:06:11.13,0:06:14.14,Default,,0,0,0,,(айқай)
Dialogue: 0,0:06:14.14,0:06:16.14,Default,,0,0,0,,Кел!
Dialogue: 0,0:06:16.14,0:06:18.14,Default,,0,0,0,,Иә, оны жайына қалдырыңыз!
Dialogue: 0,0:06:18.14,0:06:20.48,Default,,0,0,0,,Әлемдегі ең жұмсақ, әлемдегі ең берікті жең!
Dialogue: 0,0:06:20.48,0:06:23.08,Default,,0,0,0,,Ешбір болмыс болмысқа кірмейді!
Dialogue: 0,0:06:28.98,0:06:30.99,Default,,0,0,0,,Сіз қалай ойлайсыз? ? қазір! (еңіреді)
Dialogue: 0,0:06:30.99,0:06:36.16,Default,,0,0,0,,Су, барлық нәрсенің пайдасы үшін күреспей, қарапайым халықтың жамандығымен күрес!
Dialogue: 0,0:06:36.16,0:06:38.33,Default,,0,0,0,,Жарайды, ол жұмыс істейді!
Dialogue: 0,0:06:38.33,0:06:41.66,Default,,0,0,0,,Өрт Арамитама Юкито-кунның су рухын жек көреді!
Dialogue: 0,0:06:41.66,0:06:43.67,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:06:43.67,0:06:45.67,Default,,0,0,0,,Егер бұл...!
Dialogue: 0,0:06:45.67,0:06:48.17,Default,,0,0,0,,Біз иттерге ең жоғары құрметпен қараймыз.
Dialogue: 0,0:06:48.17,0:06:58.18,Default,,0,0,0,,♬～
Dialogue: 0,0:06:58.18,0:07:00.62,Default,,0,0,0,,Қарғыс атсын! Мен сенің қашуыңа жол бермеймін!
Dialogue: 0,0:07:00.62,0:07:03.62,Default,,0,0,0,,Жарайды, сәйкестендіріңіз! Міне бітті!
Dialogue: 0,0:07:03.62,0:07:12.79,Default,,0,0,0,,♬～
Dialogue: 0,0:07:12.79,0:07:15.46,Default,,0,0,0,,Юкито! Маған көп су беріңіз!
Dialogue: 0,0:07:15.46,0:07:17.47,Default,,0,0,0,,Әке болу мен агент болуды қатар алып жүру қиын болар
Dialogue: 0,0:07:17.47,0:07:23.97,Default,,0,0,0,,♬～
Dialogue: 0,0:07:23.97,0:07:25.97,Default,,0,0,0,,О!
Dialogue: 0,0:07:25.97,0:07:29.64,Default,,0,0,0,,Джинчи Тендо!
Dialogue: 0,0:07:29.64,0:07:35.05,Default,,0,0,0,,Батыр болсаң өлесің, Ер болмасаң тірі қаласың!
Dialogue: 0,0:07:37.82,0:07:42.82,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:07:42.82,0:07:59.67,Default,,0,0,0,,♬～
Dialogue: 0,0:07:59.67,0:08:02.61,Default,,0,0,0,,О... Бұл...
Dialogue: 0,0:08:02.61,0:08:06.45,Default,,0,0,0,,Митаманы тыныштандыру... сіз мұны істей алдыңыз ба?
Dialogue: 0,0:08:06.45,0:08:09.78,Default,,0,0,0,,Ооо! Ия, мен жасадым!
Dialogue: 0,0:08:09.78,0:08:11.95,Default,,0,0,0,,Біз мұны жасадық!
Dialogue: 0,0:08:11.95,0:08:14.46,Default,,0,0,0,,Уф... Ичиджо мырза!
Dialogue: 0,0:08:14.46,0:08:17.63,Default,,0,0,0,,Ха ха ха ха….
Dialogue: 0,0:08:17.63,0:08:20.63,Default,,0,0,0,,Жарайды! ? Уайымдама...
Dialogue: 0,0:08:20.63,0:08:23.47,Default,,0,0,0,,Керемет! Мен Митаманы тыныштандыратыныма сене алар емеспін!
Dialogue: 0,0:08:23.47,0:08:25.47,Default,,0,0,0,,Бөлек….
Dialogue: 0,0:08:27.97,0:08:29.97,Default,,0,0,0,,Э? Хмм?
Dialogue: 0,0:08:37.98,0:08:40.98,Default,,0,0,0,,Бұл не...? Амал жоқ...
Dialogue: 0,0:08:40.98,0:08:43.82,Default,,0,0,0,,Міне... Арамитама...
Dialogue: 0,0:08:43.82,0:08:49.16,Default,,0,0,0,,(Арамитаманың айқайы)
Dialogue: 0,0:08:49.16,0:08:52.83,Default,,0,0,0,,Үш дене! ?
Dialogue: 0,0:08:52.83,0:08:54.83,Default,,0,0,0,,Телефон қоңырау шалуда! Телефон...
Dialogue: 0,0:08:54.83,0:08:57.13,Default,,0,0,0,,Балық шетінен қашып кетпеуі керек.
Dialogue: 0,0:09:00.27,0:09:03.47,Default,,0,0,0,,Ах…. (Яко) Юкито-кун, жақсысың ба? ?
Dialogue: 0,0:09:05.44,0:09:07.78,Default,,0,0,0,,Юкито Янаги! Қарғыс атқыр...
Dialogue: 0,0:09:07.78,0:09:10.98,Default,,0,0,0,,Жоқ, шектеу жоқ...!
Dialogue: 0,0:09:13.45,0:09:17.29,Default,,0,0,0,,Мен жем боламын. Сол сәтте кетіңіз.
Dialogue: 0,0:09:17.29,0:09:19.79,Default,,0,0,0,,Не... не айтып тұрсың! Жоқ!
Dialogue: 0,0:09:19.79,0:09:22.62,Default,,0,0,0,,Басқа нұсқа жоқ. Асықшы.
Dialogue: 0,0:09:22.62,0:09:26.63,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:09:26.63,0:09:29.80,Default,,0,0,0,,Қарғыс атсын! Жоқ, амал жоқ...
Dialogue: 0,0:09:29.80,0:09:31.80,Default,,0,0,0,,Мен не істеуім керек!
Dialogue: 0,0:09:31.80,0:09:34.64,Default,,0,0,0,,《Юкито: Жоқ. Осындай жерде...》
Dialogue: 0,0:09:34.64,0:09:37.54,Default,,0,0,0,,Мүлдем ешкім...! ?
Dialogue: 0,0:09:39.97,0:09:41.98,Default,,0,0,0,,Юкито Янаги...?
Dialogue: 0,0:09:44.65,0:09:47.15,Default,,0,0,0,,Ештеңе аспан мен жердің бастауы деп аталады➡
Dialogue: 0,0:09:47.15,0:09:50.32,Default,,0,0,0,,Болмыс барлық заттардың анасы деп аталады.
Dialogue: 0,0:09:50.32,0:09:53.66,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:09:53.66,0:10:07.84,Default,,0,0,0,,♬～
Dialogue: 0,0:10:07.84,0:10:09.84,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:10:09.84,0:10:11.84,Default,,0,0,0,,Сіз оны уақытында орындаған сияқтысыз.
Dialogue: 0,0:10:11.84,0:10:14.01,Default,,0,0,0,,Көмегің үшін рахмет! Күткендей!
Dialogue: 0,0:10:14.01,0:10:18.01,Default,,0,0,0,,(айқай)
Dialogue: 0,0:10:18.01,0:10:20.01,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:10:20.01,0:10:22.12,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:10:25.19,0:10:28.19,Default,,0,0,0,,Ол көтеріліп жатыр. бастық!
Dialogue: 0,0:10:28.19,0:10:32.03,Default,,0,0,0,,Керемет... Курама-сан мен Ибуки-сан да!
Dialogue: 0,0:10:32.03,0:10:34.70,Default,,0,0,0,,Сол Арамитамалар әп-сәтте...!
Dialogue: 0,0:10:34.70,0:10:38.53,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:10:38.53,0:10:41.64,Default,,0,0,0,,Уау. Бірден үшеу?
Dialogue: 0,0:10:44.37,0:10:47.04,Default,,0,0,0,,Артқа тұр, тікенектер.
Dialogue: 0,0:10:47.04,0:10:49.04,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:10:49.04,0:10:51.05,Default,,0,0,0,,Вермиллион….
Dialogue: 0,0:10:55.55,0:11:00.32,Default,,0,0,0,,)
Dialogue: 0,0:11:00.32,0:11:02.52,Default,,0,0,0,,Бұл екі...
Dialogue: 0,0:11:09.33,0:11:13.33,Default,,0,0,0,,(қорқынышты дауыс)
Dialogue: 0,0:11:13.33,0:11:15.34,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:11:15.34,0:11:18.17,Default,,0,0,0,,Сәлем.
Dialogue: 0,0:11:18.17,0:11:20.17,Default,,0,0,0,,Тағы бір.
Dialogue: 0,0:11:20.17,0:11:23.51,Default,,0,0,0,,Кук…хехехе….
Dialogue: 0,0:11:23.51,0:11:27.35,Default,,0,0,0,,Өмір жақсы. Ол артық.
Dialogue: 0,0:11:27.35,0:11:29.65,Default,,0,0,0,,Чжу Сен...
Dialogue: 0,0:11:34.36,0:11:37.03,Default,,0,0,0,,А... Ибуки мырза!
Dialogue: 0,0:11:37.03,0:11:39.13,Default,,0,0,0,,Жоқ, тағы!
Dialogue: 0,0:11:41.53,0:11:43.53,Default,,0,0,0,,Қарғыс атсын.
Dialogue: 0,0:11:46.70,0:11:50.71,Default,,0,0,0,,Цк, маған кедергі жасама! Көктем мен күз!
Dialogue: 0,0:11:50.71,0:11:53.37,Default,,0,0,0,,Уайымдама, Шу!
Dialogue: 0,0:11:53.37,0:11:57.88,Default,,0,0,0,,Қожайыныңа зұлымдық жасау сияқты қаншама сылтау айтасың!
Dialogue: 0,0:11:57.88,0:12:01.88,Default,,0,0,0,,Қозаке! Сылтау айтып жатқан Теме емес пе? ?
Dialogue: 0,0:12:03.99,0:12:08.59,Default,,0,0,0,,Ұстаз қайтыс болды! Әлсіз болғанымызға өзіміз кінәлі!
Dialogue: 0,0:12:10.66,0:12:12.66,Default,,0,0,0,,Мұғалім….
Dialogue: 0,0:12:14.66,0:12:18.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:18.50,0:12:20.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:20.50,0:12:23.30,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:12:26.34,0:12:29.68,Default,,0,0,0,,Уау... бұл ақылсыз! ? мұғалім!
Dialogue: 0,0:12:29.68,0:12:31.68,Default,,0,0,0,,зұлым қылмыстарды болдырмау үшін, бірақ —
Dialogue: 0,0:12:34.52,0:12:37.52,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:12:40.02,0:12:45.86,Default,,0,0,0,,Адамзаттың, жердің, көктің жолы.
Dialogue: 0,0:12:45.86,0:12:49.36,Default,,0,0,0,,Ешбір болмыс болмысқа кірмейді!
Dialogue: 0,0:12:51.70,0:12:54.87,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:12:54.87,0:12:57.37,Default,,0,0,0,,Жоғалу.
Dialogue: 0,0:12:57.37,0:13:00.38,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:13:02.98,0:13:05.78,Default,,0,0,0,,Иә! таңқаларлық! бірақ! ?
Dialogue: 0,0:13:07.82,0:13:09.98,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:09.98,0:13:11.99,Default,,0,0,0,,Шу Тоқта!
Dialogue: 0,0:13:11.99,0:13:13.99,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:13:13.99,0:13:15.99,Default,,0,0,0,,Мен саған тоқтауыңды айтып тұрмын!
Dialogue: 0,0:13:15.99,0:13:24.00,Default,,0,0,0,,♬～
Dialogue: 0,0:13:24.00,0:13:27.17,Default,,0,0,0,,Шимейширозан.
Dialogue: 0,0:13:27.17,0:13:30.00,Default,,0,0,0,,Жауынгер – жауынгер. Соғыс - ашу.
Dialogue: 0,0:13:30.00,0:13:34.51,Default,,0,0,0,,Жеңіс беріліп, Ел-жұрт пен тапсырма тәкаппар.
Dialogue: 0,0:13:34.51,0:13:38.51,Default,,0,0,0,,Өте зұлымдық! Гах...
Dialogue: 0,0:13:38.51,0:13:41.02,Default,,0,0,0,,Адам болып қайтып орала алмайсың!
Dialogue: 0,0:13:41.02,0:13:43.12,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,0:13:45.35,0:13:49.69,Default,,0,0,0,,Мен айттым ғой! Араласпа!
Dialogue: 0,0:13:49.69,0:13:52.86,Default,,0,0,0,,Мұғалім…. Алыс болыңыз.
Dialogue: 0,0:13:52.86,0:13:56.53,Default,,0,0,0,,Аспан мен жердің арасында, бос және шексіз, ➡
Dialogue: 0,0:13:56.53,0:13:59.53,Default,,0,0,0,,Қозғалып, ақырында шық!
Dialogue: 0,0:14:02.64,0:14:06.31,Default,,0,0,0,,Әй... Жел таңертең бітпейді!
Dialogue: 0,0:14:06.31,0:14:09.98,Default,,0,0,0,,Бұны істеген – аспан мен жер!
Dialogue: 0,0:14:09.98,0:14:13.82,Default,,0,0,0,,♬～
Dialogue: 0,0:14:13.82,0:14:15.82,Default,,0,0,0,,Қарғыс атсын.
Dialogue: 0,0:14:17.99,0:14:21.32,Default,,0,0,0,,Иә.
Dialogue: 0,0:14:21.32,0:14:23.52,Default,,0,0,0,,Рұқсат етілмейді.
Dialogue: 0,0:14:25.66,0:14:28.50,Default,,0,0,0,,Цк... Мазалама!
Dialogue: 0,0:14:28.50,0:14:30.50,Default,,0,0,0,,Вермилион!
Dialogue: 0,0:14:30.50,0:14:33.00,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,0:14:33.00,0:14:36.00,Default,,0,0,0,,Мұғалім! Сен... Сенсей! бастық….
Dialogue: 0,0:14:36.00,0:14:39.01,Default,,0,0,0,,《Неге екі адам! ? Тек осылай қал! ? 》
Dialogue: 0,0:14:39.01,0:14:42.68,Default,,0,0,0,,Барлық заттар иньді көтереді және Янды қабылдайды, ➡
Dialogue: 0,0:14:42.68,0:14:45.38,Default,,0,0,0,,Окики, бейбітшілік орнату.
Dialogue: 0,0:14:54.19,0:14:56.19,Default,,0,0,0,,Tsk, бұл қажет емес...
Dialogue: 0,0:14:56.19,0:14:59.86,Default,,0,0,0,,Цзинги мырза! О, құдайым.
Dialogue: 0,0:14:59.86,0:15:03.63,Default,,0,0,0,,Менің шеберім болса жақсы болар еді.
Dialogue: 0,0:15:03.63,0:15:07.97,Default,,0,0,0,,Өзіңізді сумен жауып, өзіңіз туралы ойланыңыз, солай ма?
Dialogue: 0,0:15:07.97,0:15:11.64,Default,,0,0,0,,Хару-нии, Шу-нии, біз оны қалдыруымыз керек➡
Dialogue: 0,0:15:11.64,0:15:13.84,Default,,0,0,0,,Менің інім жылай ма?
Dialogue: 0,0:15:19.15,0:15:21.65,Default,,0,0,0,,Мұғалім! Мұғалім!
Dialogue: 0,0:15:21.65,0:15:27.49,Default,,0,0,0,,Менің көңілім қалды. Екеуіңе де кешірім сұраймын.
Dialogue: 0,0:15:27.49,0:15:29.66,Default,,0,0,0,,Бастық….
Dialogue: 0,0:15:29.66,0:15:33.66,Default,,0,0,0,,Хмф... Мен қайтамын, Торн.
Dialogue: 0,0:15:33.66,0:15:35.83,Default,,0,0,0,,Уф…. (Құрама) Жу.
Dialogue: 0,0:15:35.83,0:15:40.84,Default,,0,0,0,,Ұстаз ешкімнің жаман әрекеттерге баруына ешқашан жол бермейді.
Dialogue: 0,0:15:40.84,0:15:44.01,Default,,0,0,0,,Өлгендердің не ойлайтынын білесің бе?
Dialogue: 0,0:15:44.01,0:15:48.34,Default,,0,0,0,,Менің қолымнан келетіні - бұл күшпен өткен өкініштерімді өшіру.
Dialogue: 0,0:15:48.34,0:15:50.65,Default,,0,0,0,,Мәңгі.
Dialogue: 0,0:15:56.02,0:15:58.62,Default,,0,0,0,,күрсіну.
Dialogue: 0,0:16:01.12,0:16:13.47,Default,,0,0,0,,♬～
Dialogue: 0,0:16:13.47,0:16:17.81,Default,,0,0,0,,Фаа~ Унме~.
Dialogue: 0,0:16:17.81,0:16:22.81,Default,,0,0,0,,Ұстаз, мен әкімге есеп беруге бардым, қайтып оралмадым.
Dialogue: 0,0:16:22.81,0:16:25.65,Default,,0,0,0,,Бұл да Митаманы тыныштандыру үшін ұшыру емес пе?
Dialogue: 0,0:16:25.65,0:16:27.65,Default,,0,0,0,,Бұл шындық болуы мүмкін емес.
Dialogue: 0,0:16:27.65,0:16:30.65,Default,,0,0,0,,Әйтеуір, айтқанын орындадық➡
Dialogue: 0,0:16:30.65,0:16:34.32,Default,,0,0,0,,Қағбаға оралайық. Бұл дұрыс.
Dialogue: 0,0:16:34.32,0:16:36.32,Default,,0,0,0,,Біз де қайтамыз.
Dialogue: 0,0:16:36.32,0:16:40.16,Default,,0,0,0,,Ичиджо мырза, мені шығарып салуға келгеніңізге рахмет.
Dialogue: 0,0:16:40.16,0:16:44.17,Default,,0,0,0,,Бұл туралы алаңдамаңыз. Себебі мен патрульдемін.
Dialogue: 0,0:16:46.17,0:16:49.67,Default,,0,0,0,,Сонда да мен бүгін өлемін деп шындап ойладым.
Dialogue: 0,0:16:49.67,0:16:52.51,Default,,0,0,0,,Юкито өте абайсыз.
Dialogue: 0,0:16:52.51,0:16:56.34,Default,,0,0,0,,Ичиджо сен де. Кешіріңіз... Кешіріңіз.
Dialogue: 0,0:16:56.34,0:16:59.01,Default,,0,0,0,,Неліктен кешірім сұрайсыз?
Dialogue: 0,0:16:59.01,0:17:01.28,Default,,0,0,0,,Не? Білесіз бе.
Dialogue: 0,0:17:01.28,0:17:04.29,Default,,0,0,0,,жеткілікті. Әрине қиын болды ➡
Dialogue: 0,0:17:04.29,0:17:07.62,Default,,0,0,0,,Сіздің арқаңызда мен баға жетпес тәжірибе жинадым.
Dialogue: 0,0:17:07.62,0:17:12.13,Default,,0,0,0,,Иә, дұрыс. Маған риза болуыңыз керек, жарай ма?
Dialogue: 0,0:17:12.13,0:17:14.96,Default,,0,0,0,,Менің арқасында құтқарылдыңыз.
Dialogue: 0,0:17:14.96,0:17:18.30,Default,,0,0,0,,Соңында Цзинги туралы қысқаша ғана айтылған емес пе?
Dialogue: 0,0:17:18.30,0:17:20.30,Default,,0,0,0,,Дұрыс. Хехе➡
Dialogue: 0,0:17:20.30,0:17:23.14,Default,,0,0,0,,Соңында келмегенімде➡
Dialogue: 0,0:17:23.14,0:17:25.64,Default,,0,0,0,,Балалар сендер қазір кішкентайсыңдар.
Dialogue: 0,0:17:25.64,0:17:28.81,Default,,0,0,0,,Әзірше, болашақта менің қолымнан келетін жалғыз нәрсе - қожайынымды ашуландыру➡
Dialogue: 0,0:17:28.81,0:17:33.65,Default,,0,0,0,,Мен ешқашан тастамаймын деп өзіме ант бердім. Болды...
Dialogue: 0,0:17:33.65,0:17:36.48,Default,,0,0,0,,Кукуку…. Шынымен….
Dialogue: 0,0:17:36.48,0:17:40.49,Default,,0,0,0,,Маңызды кезде ол жерде болмаймын, тек соңында өзіммен бірге алып кетемін.
Dialogue: 0,0:17:40.49,0:17:43.66,Default,,0,0,0,,Сізге көп рахмет, Ичиджо мырза.
Dialogue: 0,0:17:43.66,0:17:47.16,Default,,0,0,0,,Мен емес. (Юкито) Бұл дұрыс емес.
Dialogue: 0,0:17:47.16,0:17:49.16,Default,,0,0,0,,Бұл өте күшті болды...
Dialogue: 0,0:17:49.16,0:17:53.00,Default,,0,0,0,,Ең бастысы, ол Арамитамаға қарсы бұлайша шегінбеді.
Dialogue: 0,0:17:53.00,0:17:55.84,Default,,0,0,0,,Мен де сізден үлгі алғым келеді.
Dialogue: 0,0:17:55.84,0:17:58.17,Default,,0,0,0,,Иә….
Dialogue: 0,0:17:58.17,0:18:01.68,Default,,0,0,0,,Иә. Егер сізге тағы бір нәрсе керек болса, маған хабарлаңыз.
Dialogue: 0,0:18:03.61,0:18:05.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:09.95,0:18:13.05,Default,,0,0,0,,Бұл. иә? Не?
Dialogue: 0,0:18:15.46,0:18:18.46,Default,,0,0,0,,Қарсы болмасаңыз...
Dialogue: 0,0:18:18.46,0:18:22.80,Default,,0,0,0,,Ба-ка. Мекенжай. Мекенжай. мекенжайы?
Dialogue: 0,0:18:22.80,0:18:24.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:24.97,0:18:31.31,Default,,0,0,0,,Ах~ Қазіргі жастар мекен-жайдың орнына аккаунттарды пайдаланады ма?
Dialogue: 0,0:18:31.31,0:18:35.98,Default,,0,0,0,,Байланыс ақпараты. Байланыс ақпараты. иә? Ах! байланыс мекенжайы! ?
Dialogue: 0,0:18:35.98,0:18:38.15,Default,,0,0,0,,Осы кодты тіркеңіз! ?
Dialogue: 0,0:18:38.15,0:18:42.32,Default,,0,0,0,,Мен... түсіндім... Мм, смартфон...
Dialogue: 0,0:18:42.32,0:18:44.82,Default,,0,0,0,,А, жоқ, мен білмеймін!
Dialogue: 0,0:18:44.82,0:18:46.99,Default,,0,0,0,,Қай қолданба? Не... қалай істеуім керек! ?
Dialogue: 0,0:18:46.99,0:18:50.16,Default,,0,0,0,,Бір минут күтіңіз! Күрсін.
Dialogue: 0,0:18:50.16,0:18:52.33,Default,,0,0,0,,Юкито-кун, сабыр ет.
Dialogue: 0,0:18:52.33,0:18:55.83,Default,,0,0,0,,Не? Тек сіз ғана байланыс ақпаратын алмасып жатырсыз ба?
Dialogue: 0,0:18:55.83,0:18:59.33,Default,,0,0,0,,Мм. Бұл не?
Dialogue: 0,0:18:59.33,0:19:01.94,Default,,0,0,0,,Біз Ayaka Security сияқтымыз...
Dialogue: 0,0:19:01.94,0:19:06.61,Default,,0,0,0,,Ал... не? Бұл жолы маған көмектесті.
Dialogue: 0,0:19:06.61,0:19:09.61,Default,,0,0,0,,Сондықтан мен сендермен танысып отырмын, балалар➡
Dialogue: 0,0:19:09.61,0:19:12.45,Default,,0,0,0,,Мұғалімге ештеңе көрсете алмайтын сияқтымын...
Dialogue: 0,0:19:12.45,0:19:15.45,Default,,0,0,0,,Сонымен... Жарайды... дұрыс.
Dialogue: 0,0:19:15.45,0:19:18.29,Default,,0,0,0,,Мұны рұқсатсыз істеуіміз үшін...
Dialogue: 0,0:19:18.29,0:19:20.29,Default,,0,0,0,,Бастыққа бәрібір.
Dialogue: 0,0:19:20.29,0:19:22.29,Default,,0,0,0,,Біз қамқорлық.
Dialogue: 0,0:19:22.29,0:19:24.46,Default,,0,0,0,,Бұрынғы көріністі ұмыттыңыз ба?
Dialogue: 0,0:19:24.46,0:19:26.96,Default,,0,0,0,,《Курама мырзаға, Ибуки мырзаға.
Dialogue: 0,0:19:26.96,0:19:31.47,Default,,0,0,0,,Екеуі де әкемнің шәкірттері, неге...? Сонымен қатар…》
Dialogue: 0,0:19:31.47,0:19:36.47,Default,,0,0,0,,)
Dialogue: 0,0:19:36.47,0:19:40.64,Default,,0,0,0,,《Ино-сан мен Момоко-сан бірдеңе біледі ме деп ойлаймын.
Dialogue: 0,0:19:40.64,0:19:43.31,Default,,0,0,0,,Ал егер сен Джиноши болсаң...》
Dialogue: 0,0:19:43.31,0:19:46.48,Default,,0,0,0,,Юкито Янаги? не болды?
Dialogue: 0,0:19:46.48,0:19:50.48,Default,,0,0,0,,А, жоқ, кешіріңіз. Ештеңе етпейді.
Dialogue: 0,0:19:57.49,0:20:00.83,Default,,0,0,0,,Аа... Бүгін көп нәрсе болды➡
Dialogue: 0,0:20:00.83,0:20:05.33,Default,,0,0,0,,Мм...Менің ойымша, бәрі сол жерде болғандықтан, мен оны жеңе алдым.
Dialogue: 0,0:20:05.33,0:20:07.33,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:20:07.33,0:20:10.34,Default,,0,0,0,,Сонымен... Жаңа ғана аралға келдім➡
Dialogue: 0,0:20:10.34,0:20:13.51,Default,,0,0,0,,Мен әлі көп адамдарды танымаймын.
Dialogue: 0,0:20:13.51,0:20:18.01,Default,,0,0,0,,Ичиджо мырза, сонымен қатар Яго-кун мен Чатаро-кун.
Dialogue: 0,0:20:18.01,0:20:22.35,Default,,0,0,0,,Қарсы болмасаңыз, сізбен қайтадан байланысуға рұқсат ете аласыз ба?
Dialogue: 0,0:20:22.35,0:20:25.52,Default,,0,0,0,,Хмм…. Егер Юкито солай айтса.
Dialogue: 0,0:20:25.52,0:20:27.52,Default,,0,0,0,,Ммм, дәмді екен.
Dialogue: 0,0:20:27.52,0:20:29.52,Default,,0,0,0,,Рас! ? Ия, иә!
Dialogue: 0,0:20:29.52,0:20:32.03,Default,,0,0,0,,Мм. (Чатаро) Бұл асыра сілтеу.
Dialogue: 0,0:20:32.03,0:20:36.36,Default,,0,0,0,,Арамитама пайда болғанда, Аяка күзетшісі ішке кіреді.
Dialogue: 0,0:20:36.36,0:20:41.37,Default,,0,0,0,,Сондай-ақ... Әрине, бұл да рас, бірақ басқаша, у...
Dialogue: 0,0:20:41.37,0:20:44.87,Default,,0,0,0,,Бұл Арамитама болмаса да! Бұл Арамитама болмаса да?
Dialogue: 0,0:20:44.87,0:20:47.07,Default,,0,0,0,,Ха ха. Бұл не?
Dialogue: 0,0:20:49.04,0:20:51.05,Default,,0,0,0,,Міне, келдіңіз. өтінемін.
Dialogue: 0,0:20:51.05,0:20:53.38,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:20:53.38,0:20:57.55,Default,,0,0,0,,Танысқаныма қуаныштымын, Юкито Янаги.
Dialogue: 0,0:20:57.55,0:20:59.72,Default,,0,0,0,,Иә.
Dialogue: 0,0:20:59.72,0:21:02.72,Default,,0,0,0,,Йо... Танысқаныма қуаныштымын.
Dialogue: 0,0:22:38.35,0:22:42.36,Default,,0,0,0,,(душ дыбысы)
Dialogue: 0,0:22:42.36,0:22:58.54,Default,,0,0,0,,♬～
Dialogue: 0,0:22:58.54,0:23:02.81,Default,,0,0,0,,Боқ... Ақымақ...
Dialogue: 0,0:23:02.81,0:23:35.84,Default,,0,0,0,,♬～
Dialogue: 0,0:23:35.84,0:23:41.65,Default,,0,0,0,,Ұстаз... Мен...
