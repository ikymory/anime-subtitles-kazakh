Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.00,0:00:04.80,Default,,0,0,0,,(жүгіру дыбысы)
Dialogue: 0,0:00:07.34,0:00:34.20,Default,,0,0,0,,♪～
Dialogue: 0,0:00:34.20,0:00:37.60,Default,,0,0,0,,《Юкито: Бұл Миносима ма...》
Dialogue: 0,0:00:39.70,0:00:42.70,Default,,0,0,0,,《Юкито: Ниношимадан да көп табиғат бар⇒
Dialogue: 0,0:00:42.70,0:00:46.38,Default,,0,0,0,,Бұл өте салтанатты атмосфера.
Dialogue: 0,0:00:46.38,0:00:55.05,Default,,0,0,0,,♪～
Dialogue: 0,0:00:55.05,0:00:57.22,Default,,0,0,0,,Ол жақта да арал бар...
Dialogue: 0,0:00:59.39,0:01:01.32,Default,,0,0,0,,А... Уф...
Dialogue: 0,0:01:01.32,0:01:04.16,Default,,0,0,0,,Сіз ұйықтап жатқан сияқтысыз. иә? аа.
Dialogue: 0,0:01:04.16,0:01:07.50,Default,,0,0,0,,Күткендей, екі күн қатарынан түні бойы ішімдік ішу қиын болды.
Dialogue: 0,0:01:07.50,0:01:10.83,Default,,0,0,0,,Бірақ мен пачинкода үлкен жеңіске жеттім⇒
Dialogue: 0,0:01:10.83,0:01:13.50,Default,,0,0,0,,Біз ойнамауға мүмкіндігіміз жоқ, солай ма?
Dialogue: 0,0:01:13.50,0:01:16.84,Default,,0,0,0,,Ол бөтелке де олжа ма?
Dialogue: 0,0:01:16.84,0:01:20.18,Default,,0,0,0,,О, бұл ма? Мен Хару-нидің орнына барамын дегенде⇒
Dialogue: 0,0:01:20.18,0:01:23.01,Default,,0,0,0,,Момоко-сан мұны маған кәдесый ретінде берді.
Dialogue: 0,0:01:23.01,0:01:26.68,Default,,0,0,0,,Хехе... Екеуміздің көңілді жүргенімізге біраз болды.
Dialogue: 0,0:01:26.68,0:01:28.85,Default,,0,0,0,,Сіз әлі ішіп жүрсіз бе?
Dialogue: 0,0:01:28.85,0:01:32.02,Default,,0,0,0,,Цзинги мырза мұнда жиі келмейді ме?
Dialogue: 0,0:01:32.02,0:01:34.52,Default,,0,0,0,,Дұрыс. Егер сіз шынымен қаласаңыз ⇒
Dialogue: 0,0:01:34.52,0:01:37.86,Default,,0,0,0,,Ол Хару-нимен кездескісі келетінін айтты, мен оны алып келдім.⇒
Dialogue: 0,0:01:37.86,0:01:40.53,Default,,0,0,0,,Тек ормандары мен қасиетті жерлері бар осындай арал⇒
Dialogue: 0,0:01:40.53,0:01:42.70,Default,,0,0,0,,Мереке күндерінен басқа келмеңіз.
Dialogue: 0,0:01:42.70,0:01:44.87,Default,,0,0,0,,Мен күнделікті не қолданамын?
Dialogue: 0,0:01:44.87,0:01:47.54,Default,,0,0,0,,Бұл жай ғана Хару-ни мен оның екі ақымақ шәкірті.
Dialogue: 0,0:01:47.54,0:01:50.04,Default,,0,0,0,,Ақымақ шәкірт... Болды⇒
Dialogue: 0,0:01:50.04,0:01:53.88,Default,,0,0,0,,Сіз Фукуваке Чатаро-кун мен Аманояко-кунды айтасыз ба?
Dialogue: 0,0:01:53.88,0:01:56.21,Default,,0,0,0,,Бұл екеуі, бұл олардың есімдері?
Dialogue: 0,0:01:56.21,0:01:58.55,Default,,0,0,0,,Ал, сен қайдан білесің?
Dialogue: 0,0:01:58.55,0:02:02.32,Default,,0,0,0,,Мен Момокодан сұрадым. Неге мазалау керек? неге?
Dialogue: 0,0:02:02.32,0:02:05.32,Default,,0,0,0,,Не? Не... бұл неге...?
Dialogue: 0,0:02:05.32,0:02:07.32,Default,,0,0,0,,Және… достар….
Dialogue: 0,0:02:07.32,0:02:09.99,Default,,0,0,0,,Иә? Жігіттер, сіз әлі неггаға айналдыңыз ба?
Dialogue: 0,0:02:09.99,0:02:12.83,Default,,0,0,0,,Жоқ... Жоқ, олай емес...
Dialogue: 0,0:02:12.83,0:02:16.83,Default,,0,0,0,,Өткен күні Джинёши мырза маған дос болып қалармыз деді.
Dialogue: 0,0:02:16.83,0:02:20.34,Default,,0,0,0,,Екі жасқа таяп қалды, сондықтан бір күні...
Dialogue: 0,0:02:20.34,0:02:23.34,Default,,0,0,0,,Хо... қараңдар... түсіндім.
Dialogue: 0,0:02:23.34,0:02:25.67,Default,,0,0,0,,Мен қолымнан келеді деп үміттенемін. иә?
Dialogue: 0,0:02:25.67,0:02:28.34,Default,,0,0,0,,Цзинги мырза! Янаги Юкито-кун!
Dialogue: 0,0:02:28.34,0:02:30.35,Default,,0,0,0,,Міне, міне!
Dialogue: 0,0:02:30.35,0:02:33.52,Default,,0,0,0,,Ой, әлгі екі ақымақ шәкірт бірден.
Dialogue: 0,0:02:33.52,0:02:36.18,Default,,0,0,0,,Мен сені мұғалімнің бұйрығымен алып кетуге келдім!
Dialogue: 0,0:02:36.18,0:02:38.89,Default,,0,0,0,,Миносимаға қош келдіңіз.
Dialogue: 0,0:04:22.82,0:04:25.66,Default,,0,0,0,,Сіз қалай ойлайсыз? Аякадағы өмірге үйреніп қалдыңыз ба?
Dialogue: 0,0:04:25.66,0:04:29.16,Default,,0,0,0,,Хмм, мен әлі де абдырап қалдым деп ойлаймын.
Dialogue: 0,0:04:29.16,0:04:32.67,Default,,0,0,0,,Мені Митама және Теңіз пойызы сияқты нәрселер таң қалдырады.
Dialogue: 0,0:04:32.67,0:04:37.01,Default,,0,0,0,,Сондай-ақ, аралдың адамдары маған өте мейірімді.
Dialogue: 0,0:04:37.01,0:04:40.18,Default,,0,0,0,,Кездескендердің бәрі күліп менімен сөйлесті⇒
Dialogue: 0,0:04:40.18,0:04:43.18,Default,,0,0,0,,Бейтаныс жер болса да, ыстық сезіледі...
Dialogue: 0,0:04:43.18,0:04:46.35,Default,,0,0,0,,Менде осы уақытқа дейін көп тәжірибе болған жоқ⇒
Dialogue: 0,0:04:46.35,0:04:48.85,Default,,0,0,0,,Шынымды айтсам, мен не істерімді білмеймін.
Dialogue: 0,0:04:51.02,0:04:53.02,Default,,0,0,0,,Біз келдік.
Dialogue: 0,0:04:53.02,0:04:55.19,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:04:55.19,0:04:58.53,Default,,0,0,0,,Бұл Ичиносима мен Ниносимадан басқа арал.
Dialogue: 0,0:04:58.53,0:05:00.63,Default,,0,0,0,,Бұл қандай ғибадатхана?
Dialogue: 0,0:05:00.63,0:05:03.47,Default,,0,0,0,,Бұл отты бұлақ ғибадатханасы - су мен от⇒
Dialogue: 0,0:05:03.47,0:05:06.97,Default,,0,0,0,,Мұнда екі жұптасқан айдаһар құдайлары бекітілген.
Dialogue: 0,0:05:06.97,0:05:08.97,Default,,0,0,0,,Айдаһар? иә.
Dialogue: 0,0:05:08.97,0:05:12.81,Default,,0,0,0,,Синосима аралында ежелгі уақыттан бері екі айдаһар болған.
Dialogue: 0,0:05:12.81,0:05:16.48,Default,,0,0,0,,Айдаһар аттанған сайын апат орын алды.
Dialogue: 0,0:05:16.48,0:05:20.15,Default,,0,0,0,,Бұл соны тыныштандыру үшін салынған ғибадатхана.
Dialogue: 0,0:05:20.15,0:05:22.15,Default,,0,0,0,,Бұл жай ғана аңыз емес.
Dialogue: 0,0:05:22.15,0:05:25.65,Default,,0,0,0,,Біздің бала кезімізде бір айдаһар шаба жөнелді⇒
Dialogue: 0,0:05:25.65,0:05:27.99,Default,,0,0,0,,Сол жерде жанартау атқылап кетті ⇒
Dialogue: 0,0:05:27.99,0:05:31.16,Default,,0,0,0,,Ичиносимаға дейін шығын келтірілді. сондықтан….
Dialogue: 0,0:05:31.16,0:05:33.83,Default,,0,0,0,,Шиносима⇒ отты айдаһар ашуланады
Dialogue: 0,0:05:33.83,0:05:36.00,Default,,0,0,0,,Оны бағындырған су айдаһарының қалдықтары дейді⇒
Dialogue: 0,0:05:36.00,0:05:38.17,Default,,0,0,0,,Кратер көлі бар.
Dialogue: 0,0:05:38.17,0:05:40.17,Default,,0,0,0,,Кайдзуми храмының киелі нысаны ⇒
Dialogue: 0,0:05:40.17,0:05:43.34,Default,,0,0,0,,Мұнда оған еліктейтін жанартаулық тау жынысы сақталған.
Dialogue: 0,0:05:43.34,0:05:45.84,Default,,0,0,0,,《Енді ойлап қарасам, Ибуки мырза...》
Dialogue: 0,0:05:45.84,0:05:48.68,Default,,0,0,0,,((Ибуки: Мен күшейемін.
Dialogue: 0,0:05:48.68,0:05:50.68,Default,,0,0,0,,Бұл айдаһардан да артық! ))
Dialogue: 0,0:05:50.68,0:05:52.85,Default,,0,0,0,,Айдаһар….
Dialogue: 0,0:05:52.85,0:05:57.19,Default,,0,0,0,,《Юкито: Иә? Менің бір жерде айдаһар бар...
Dialogue: 0,0:05:57.19,0:05:59.19,Default,,0,0,0,,Хекшун! Ха!
Dialogue: 0,0:05:59.19,0:06:01.62,Default,,0,0,0,,Немене, көшеде тағы да мас болып есінен танып қалдым⇒
Dialogue: 0,0:06:01.62,0:06:03.79,Default,,0,0,0,,Сіз суық тиіп қалдыңыз ба? (Тоги) Шу шығарайық ⇒
Dialogue: 0,0:06:03.79,0:06:05.79,Default,,0,0,0,,Чатароның минутында!
Dialogue: 0,0:06:05.79,0:06:07.96,Default,,0,0,0,,Басшыларды көбірек сыйлау керек.
Dialogue: 0,0:06:07.96,0:06:11.47,Default,,0,0,0,,Олай болса, жоғарырақ болыңыз!
Dialogue: 0,0:06:11.47,0:06:14.80,Default,,0,0,0,,Егер сіз сондай болсаңыз, сіз дәл сол Янаги кланының бір бөлігісіз⇒
Dialogue: 0,0:06:14.80,0:06:18.14,Default,,0,0,0,,Тіпті ұятқа қалдық. Эй, эй.
Dialogue: 0,0:06:18.14,0:06:21.98,Default,,0,0,0,,Мұндай шебердің болуы сізге де қиын болуы керек. о қымбаттым….
Dialogue: 0,0:06:21.98,0:06:25.31,Default,,0,0,0,,Эй, Юкито-кун. Не... не...?
Dialogue: 0,0:06:25.31,0:06:28.65,Default,,0,0,0,,Негізі мен сізбен бір нәрсе туралы сөйлескім келеді.
Dialogue: 0,0:06:28.65,0:06:31.65,Default,,0,0,0,,Сәлем! Чако! Ятаро!
Dialogue: 0,0:06:31.65,0:06:33.82,Default,,0,0,0,,А, шулы! Екеуін араластырыңыз ⇒
Dialogue: 0,0:06:33.82,0:06:36.49,Default,,0,0,0,,Маған қоңырау шалмаңыз! Бұл Яго мен Чатаро.
Dialogue: 0,0:06:36.49,0:06:39.49,Default,,0,0,0,,Маған бәрібір! Әйтеуір, мен шаршадым.
Dialogue: 0,0:06:39.49,0:06:43.50,Default,,0,0,0,,Мен осында үзіліс жасап, біраз ішіп, сөйлескім келеді.
Dialogue: 0,0:06:43.50,0:06:46.33,Default,,0,0,0,,Неге қариядай сөйлейсің?
Dialogue: 0,0:06:46.33,0:06:49.67,Default,,0,0,0,,Ал алкоголь де мұғалім үшін кәдесый болды ғой?
Dialogue: 0,0:06:49.67,0:06:54.01,Default,,0,0,0,,Егер есімде дұрыс болса, шабдалы гүлдері осында дерлік болды, солай ма?
Dialogue: 0,0:06:54.01,0:06:56.34,Default,,0,0,0,,Сәлем! Сәлем! Ей, сендер де⇒
Dialogue: 0,0:06:56.34,0:06:58.85,Default,,0,0,0,,Шие гүлін тамашалайық. Мен оны ұнатпаймын. Мен оны ұнатпаймын!
Dialogue: 0,0:06:58.85,0:07:01.45,Default,,0,0,0,,Жарайды, жарайды. Уау, ақымақ! Алыста!
Dialogue: 0,0:07:01.45,0:07:03.45,Default,,0,0,0,,Кеше жаңбыр жауып, тайғақ болды...
Dialogue: 0,0:07:03.45,0:07:05.45,Default,,0,0,0,,Уау! Апыр-ай! Апыр-ай!
Dialogue: 0,0:07:05.45,0:07:08.12,Default,,0,0,0,,Әй, суық! (Курама) О, құдайым.
Dialogue: 0,0:07:08.12,0:07:10.29,Default,,0,0,0,,Аа, Курама мырза.
Dialogue: 0,0:07:10.29,0:07:13.80,Default,,0,0,0,,Мен оларға ауыстыратын киім беруім керек.
Dialogue: 0,0:07:13.80,0:07:15.80,Default,,0,0,0,,Қош келдіңіз, Юкито Янаги.
Dialogue: 0,0:07:15.80,0:07:19.47,Default,,0,0,0,,Менің Қасен киелі үйіме қош келдіңіз.
Dialogue: 0,0:07:19.47,0:07:22.47,Default,,0,0,0,,♪ (мырылдау)
Dialogue: 0,0:07:22.47,0:07:24.47,Default,,0,0,0,,Уф.
Dialogue: 0,0:07:24.47,0:07:27.14,Default,,0,0,0,,Мұнда тек ыстық бұлақтар ғана жақсы.
Dialogue: 0,0:07:27.14,0:07:29.64,Default,,0,0,0,,Қандай керемет? Бір сәт ойланыңыз.
Dialogue: 0,0:07:29.64,0:07:31.65,Default,,0,0,0,,Айтпақшы, Юкито ше?
Dialogue: 0,0:07:31.65,0:07:35.15,Default,,0,0,0,,Юкито-кун мұғалімімен кітапханаға барды.
Dialogue: 0,0:07:38.65,0:07:40.66,Default,,0,0,0,,Уау... Кешіріңіз.
Dialogue: 0,0:07:40.66,0:07:44.33,Default,,0,0,0,,Өтінемін, аяқтарыңызды босатыңыз. иә.
Dialogue: 0,0:07:44.33,0:07:46.83,Default,,0,0,0,,Амансың ба? Суық емес пе?
Dialogue: 0,0:07:46.83,0:07:50.17,Default,,0,0,0,,Кәмпит же. Ах... Рахмет.
Dialogue: 0,0:07:50.17,0:07:52.83,Default,,0,0,0,,Апельсин дәмі жақында танымал болды.
Dialogue: 0,0:07:52.83,0:07:54.84,Default,,0,0,0,,Мен көп нәрсе сатып алдым.
Dialogue: 0,0:07:54.84,0:07:58.51,Default,,0,0,0,,Иә. Сіз дәмді көрінетін буға пісірілген тоқаш алдыңыз ба?
Dialogue: 0,0:07:58.51,0:08:00.94,Default,,0,0,0,,Хмм, оны қайда қойдыңыз?
Dialogue: 0,0:08:00.94,0:08:04.11,Default,,0,0,0,,Сол Курама-сан. иә? Хехе….
Dialogue: 0,0:08:04.11,0:08:07.62,Default,,0,0,0,,Мен Джингиден сенің менімен кездескісі келетініңді естідім.
Dialogue: 0,0:08:07.62,0:08:10.29,Default,,0,0,0,,Бірдеңе болды ма? иә.
Dialogue: 0,0:08:10.29,0:08:13.79,Default,,0,0,0,,Мен өткен күні Акане Ибукимен кездестім.
Dialogue: 0,0:08:13.79,0:08:16.29,Default,,0,0,0,,Ах...!
Dialogue: 0,0:08:16.29,0:08:19.29,Default,,0,0,0,,А... анау Курама-сан?
Dialogue: 0,0:08:19.29,0:08:23.13,Default,,0,0,0,,О, кешіріңіз. Сіз ол адаммен кездестіңіз, солай ма?
Dialogue: 0,0:08:23.13,0:08:27.14,Default,,0,0,0,,Иә. Мен Ибукидің шарларын жалап жатқанын көрдім.
Dialogue: 0,0:08:27.14,0:08:31.14,Default,,0,0,0,,Көп оқ атып,...
Dialogue: 0,0:08:31.14,0:08:33.64,Default,,0,0,0,,Мен...
Dialogue: 0,0:08:33.64,0:08:36.31,Default,,0,0,0,,Сіз қорқынышты нәрсені көрген болуыңыз керек.
Dialogue: 0,0:08:36.31,0:08:38.98,Default,,0,0,0,,Бірақ мен түсінбеймін...
Dialogue: 0,0:08:38.98,0:08:42.98,Default,,0,0,0,,Менің әдістерім Курама-саннан ерекше...
Dialogue: 0,0:08:42.98,0:08:47.82,Default,,0,0,0,,Юкито-кун, өмір желісі туралы қаншалықты түсінесің?
Dialogue: 0,0:08:47.82,0:08:50.49,Default,,0,0,0,,Жер түбінде ағып жатқан тіршілік энергиясы...
Dialogue: 0,0:08:50.49,0:08:53.33,Default,,0,0,0,,Цюёси мырзадан естігенім осы ғана.
Dialogue: 0,0:08:53.33,0:08:56.00,Default,,0,0,0,,Бұл рас, бірақ...
Dialogue: 0,0:08:56.00,0:08:59.93,Default,,0,0,0,,Сонымен қуатты импульстік байланыс ретінде қалай пайдаланамыз?
Dialogue: 0,0:08:59.93,0:09:03.10,Default,,0,0,0,,Өмірдің күшін әр түрлі істерге жұмсау ⇒
Dialogue: 0,0:09:03.10,0:09:05.61,Default,,0,0,0,,Маған жақсы жағынан сәйкес келетінін айтты.
Dialogue: 0,0:09:05.61,0:09:09.11,Default,,0,0,0,,көремін. Жарайды, мен сенің орныңды аламын⇒
Dialogue: 0,0:09:09.11,0:09:11.95,Default,,0,0,0,,Толығырақ түсінуге көмектесейін.
Dialogue: 0,0:09:11.95,0:09:13.95,Default,,0,0,0,,Сіз мұны көре аласыз ба?
Dialogue: 0,0:09:13.95,0:09:16.95,Default,,0,0,0,,Бұл Миносима, сен қазір қайдасың.
Dialogue: 0,0:09:16.95,0:09:19.95,Default,,0,0,0,,Онда Ичиносима мен Ниносима бар.
Dialogue: 0,0:09:19.95,0:09:23.12,Default,,0,0,0,,Сіз сол жерде Шиносиманы көре аласыз, солай ма?
Dialogue: 0,0:09:23.12,0:09:25.63,Default,,0,0,0,,Иә. Осы Аяка аралдарының астында ⇒
Dialogue: 0,0:09:25.63,0:09:28.46,Default,,0,0,0,,Үлкен өмірлік байланыс бар ⇒
Dialogue: 0,0:09:28.46,0:09:31.13,Default,,0,0,0,,Егер сіз зейінді шоғырландырсаңыз, сіз де оны сезіне білуіңіз керек.
Dialogue: 0,0:09:31.13,0:09:33.80,Default,,0,0,0,,Көзіңізді жабыңыз.
Dialogue: 0,0:09:33.80,0:09:38.47,Default,,0,0,0,,Өмір ағыны негізінен әлемнің кез келген жерінде ағып жатыр⇒
Dialogue: 0,0:09:38.47,0:09:42.64,Default,,0,0,0,,Аяка аралдары бұрынғыдай қалың және жақын.
Dialogue: 0,0:09:42.64,0:09:46.31,Default,,0,0,0,,Материкте тарихи храмдар мен ерекше ағаштар мен тастар бар ⇒
Dialogue: 0,0:09:46.31,0:09:50.15,Default,,0,0,0,,Ауада қалқып тұрған өмірдің шамалы ғана белгісі бар⇒
Dialogue: 0,0:09:50.15,0:09:53.66,Default,,0,0,0,,Бұл арал барлық жерде оларға толы.
Dialogue: 0,0:09:53.66,0:09:55.66,Default,,0,0,0,,Сіз оны сезе аласыз ба?
Dialogue: 0,0:09:55.66,0:09:57.99,Default,,0,0,0,,Сол өмір жолының бар екенін сезіну⇒
Dialogue: 0,0:09:57.99,0:10:01.16,Default,,0,0,0,,Сананы терең төмендетіңіз.
Dialogue: 0,0:10:01.16,0:10:03.16,Default,,0,0,0,,Өйткені сіз негізгі ағымды⇒ көре аласыз
Dialogue: 0,0:10:03.16,0:10:06.50,Default,,0,0,0,,Біз, байланыстар, сол жерден күш аламыз.
Dialogue: 0,0:10:06.50,0:10:08.84,Default,,0,0,0,,Бұл техникаға айналады.
Dialogue: 0,0:10:08.84,0:10:11.67,Default,,0,0,0,,Ах! Ах... жақсысың ба?
Dialogue: 0,0:10:11.67,0:10:14.01,Default,,0,0,0,,Сонымен... бұл керемет! Терең жер асты⇒
Dialogue: 0,0:10:14.01,0:10:16.34,Default,,0,0,0,,Мен үлкен жарқыраған ағын көрдім.
Dialogue: 0,0:10:16.34,0:10:19.18,Default,,0,0,0,,Бұл өмірдің арқауы! аа.
Dialogue: 0,0:10:19.18,0:10:21.52,Default,,0,0,0,,Тым тереңдеп кетсеңіз⇒
Dialogue: 0,0:10:21.52,0:10:24.02,Default,,0,0,0,,Бұл адам үшін қауіпті, сондықтан сақ болыңыз...
Dialogue: 0,0:10:26.19,0:10:30.02,Default,,0,0,0,,Курама мырза? сен….
Dialogue: 0,0:10:30.02,0:10:33.19,Default,,0,0,0,,А... А, бұл Митама⇒
Dialogue: 0,0:10:33.19,0:10:36.20,Default,,0,0,0,,Сол өмір сызығынан пайда болатын көпіршік сияқты.
Dialogue: 0,0:10:36.20,0:10:38.20,Default,,0,0,0,,Бастапқыда зиянсыз ⇒
Dialogue: 0,0:10:38.20,0:10:41.04,Default,,0,0,0,,Егер аймақ тоқырау немесе ластанса⇒
Dialogue: 0,0:10:41.04,0:10:44.71,Default,,0,0,0,,Арамитамаға айналуы мүмкін.
Dialogue: 0,0:10:44.71,0:10:48.88,Default,,0,0,0,,Оны тазарту және бастапқы ағынына қайтару - ⇒
Dialogue: 0,0:10:48.88,0:10:51.38,Default,,0,0,0,,Бұл бәрімізді байланыстыратын миссия.
Dialogue: 0,0:10:51.38,0:10:55.38,Default,,0,0,0,,Алайда, Ибуки-сан күштірек болу үшін оны жеп жатты.
Dialogue: 0,0:10:55.38,0:10:59.39,Default,,0,0,0,,Иә... Ал Арамитаманы өз денеңде ұстау ⇒ дегенді білдіреді
Dialogue: 0,0:10:59.39,0:11:02.32,Default,,0,0,0,,Тоқырап қалу.
Dialogue: 0,0:11:02.32,0:11:04.33,Default,,0,0,0,,Басқаша айтқанда, ⇒
Dialogue: 0,0:11:04.33,0:11:08.00,Default,,0,0,0,,Бұл адамның Арамитамаға айналуымен бірдей.
Dialogue: 0,0:11:08.00,0:11:10.83,Default,,0,0,0,,Сіз мұны түсінесіз бе? Иә.
Dialogue: 0,0:11:10.83,0:11:13.84,Default,,0,0,0,,Қосылым ретінде мүлдем қабылданбайтын нәрсе ⇒
Dialogue: 0,0:11:13.84,0:11:17.01,Default,,0,0,0,,Әлгі адам істеп жатыр. иә….
Dialogue: 0,0:11:17.01,0:11:19.34,Default,,0,0,0,,《Бірақ неге Ибуки мырза⇒?
Dialogue: 0,0:11:19.34,0:11:21.51,Default,,0,0,0,,Мұндай сұмдық істеу⇒
Dialogue: 0,0:11:21.51,0:11:24.61,Default,,0,0,0,,Сіз күштірек болуға тырысасыз ба...? 》
Dialogue: 0,0:11:28.35,0:11:30.52,Default,,0,0,0,,Мен көптен күттім.
Dialogue: 0,0:11:30.52,0:11:33.52,Default,,0,0,0,,Юкито-кун, сенің сәтің бар ма?
Dialogue: 0,0:11:33.52,0:11:36.82,Default,,0,0,0,,Не? Мен сенімен сөйлескім келеді.
Dialogue: 0,0:11:45.03,0:11:47.54,Default,,0,0,0,,Хуэй~ Мен өзімді сергек сезінемін~.
Dialogue: 0,0:11:47.54,0:11:49.54,Default,,0,0,0,,Хару-ни, салқын сыра бар ма?
Dialogue: 0,0:11:49.54,0:11:53.37,Default,,0,0,0,,Цзинги осында отыр. Эх...
Dialogue: 0,0:11:53.37,0:11:55.71,Default,,0,0,0,,Бұл уағыздың бір түрі ме?
Dialogue: 0,0:11:55.71,0:12:00.15,Default,,0,0,0,,Ақанені кездестірген сияқтысың. Қалай болды?
Dialogue: 0,0:12:00.15,0:12:03.82,Default,,0,0,0,,А, ол туралы... Эй, эй.
Dialogue: 0,0:12:03.82,0:12:08.16,Default,,0,0,0,,Хмм, бұл өте жақсы жағдай емес.
Dialogue: 0,0:12:08.16,0:12:11.99,Default,,0,0,0,,Арамитама жеудің теріс әсері сіздің денеңізге анық көрінеді.
Dialogue: 0,0:12:11.99,0:12:13.10,Default,,0,0,0,,Әлгі ақымақ...!
Dialogue: 0,0:12:13.10,0:12:17.67,Default,,0,0,0,,Бірақ Шу-нидің сезімін Хару-нидің де білетініне сенімдімін.
Dialogue: 0,0:12:17.67,0:12:20.34,Default,,0,0,0,,Бұл сіз өзіңізді жынға айналдыра аласыз ⇒ дегенді білдірмейді
Dialogue: 0,0:12:20.34,0:12:22.64,Default,,0,0,0,,Сіздің қожайыныңыз бақытты болады деп ойлайсыз ба?
Dialogue: 0,0:12:24.67,0:12:27.18,Default,,0,0,0,,Жу інім дәл менің алдымда шығар⇒
Dialogue: 0,0:12:27.18,0:12:30.18,Default,,0,0,0,,Мен ешкімнің өлгенін қаламаймын.
Dialogue: 0,0:12:30.18,0:12:33.85,Default,,0,0,0,,Адалдық... Адамдар өледі.
Dialogue: 0,0:12:33.85,0:12:39.65,Default,,0,0,0,,Барлығы жай ғана өмір ағымына оралады. Бұл – иілмес қамсыздандыру.
Dialogue: 0,0:12:41.69,0:12:45.36,Default,,0,0,0,,Сонымен қатар, бұл жерде шағын уағыз. Юкито-кун өз жолынан шығып кетті⇒
Dialogue: 0,0:12:45.36,0:12:47.36,Default,,0,0,0,,Маған келудің де қажеті жоқ⇒
Dialogue: 0,0:12:47.36,0:12:50.37,Default,,0,0,0,,Маған көп нәрсені үйреткеніңізді қалаймын.
Dialogue: 0,0:12:50.37,0:12:52.53,Default,,0,0,0,,Тіршілік сызығы мен қарақұйрық туралы.
Dialogue: 0,0:12:52.53,0:12:54.54,Default,,0,0,0,,А, бұл туралы.
Dialogue: 0,0:12:54.54,0:12:57.87,Default,,0,0,0,,Мұғалім болу сіздің стиліңіз емес деп ойлаймын.
Dialogue: 0,0:12:57.87,0:13:00.64,Default,,0,0,0,,Жоқ, ол да соны күтіп отыр.
Dialogue: 0,0:13:00.64,0:13:02.64,Default,,0,0,0,,Есіңде жоқ ⇒ десең де
Dialogue: 0,0:13:02.64,0:13:05.81,Default,,0,0,0,,Джингидің маған соншалықты мұқият қамқор болғаны⇒
Dialogue: 0,0:13:05.81,0:13:09.15,Default,,0,0,0,,Жүрегіңнің бір жерінде ойып жазылған болуы керек.
Dialogue: 0,0:13:09.15,0:13:13.32,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:13:13.32,0:13:17.49,Default,,0,0,0,,Айтпақшы, сыра ше? Күрсін... Мүлдем емес...
Dialogue: 0,0:13:17.49,0:13:24.83,Default,,0,0,0,,♪～
Dialogue: 0,0:13:24.83,0:13:26.83,Default,,0,0,0,,《Қайда бара жатырсың...》
Dialogue: 0,0:13:26.83,0:13:30.54,Default,,0,0,0,,Сәлем! Юкито-кун, міне, осында.
Dialogue: 0,0:13:32.84,0:13:34.84,Default,,0,0,0,,Керемет... Дұрыс па?
Dialogue: 0,0:13:34.84,0:13:38.51,Default,,0,0,0,,Ал, Юкито-кун, біз бірінші рет кездескеннен бері⇒
Dialogue: 0,0:13:38.51,0:13:41.68,Default,,0,0,0,,Біз сіз туралы көп нәрсе айттық.
Dialogue: 0,0:13:41.68,0:13:45.85,Default,,0,0,0,,Осыны айта келе, мен оларға дұрыс айту керек деп шештім.
Dialogue: 0,0:13:45.85,0:13:48.36,Default,,0,0,0,,Бұл екеуміздің ортақ пікіріміз.
Dialogue: 0,0:13:48.36,0:13:50.86,Default,,0,0,0,,Мен сізбен жастамын⇒
Dialogue: 0,0:13:50.86,0:13:53.03,Default,,0,0,0,,Мен жақсы араласатын шығар деп ойладым.
Dialogue: 0,0:13:53.03,0:13:55.53,Default,,0,0,0,,Не? Бұл... және...
Dialogue: 0,0:13:55.53,0:13:58.53,Default,,0,0,0,,Иә, біз доспыз. Тату болайық.
Dialogue: 0,0:13:58.53,0:14:00.47,Default,,0,0,0,,Э? Тұр... не?
Dialogue: 0,0:14:00.47,0:14:07.48,Default,,0,0,0,,《Досым...! Жоқ, бірақ менің күшім қайтадан бақылаудан шығып кетсе...
Dialogue: 0,0:14:07.48,0:14:11.48,Default,,0,0,0,,Сіз мұғалімнің баласысыз, солай емес пе?
Dialogue: 0,0:14:11.48,0:14:13.98,Default,,0,0,0,,Сонда олар бізбен бір рудан.
Dialogue: 0,0:14:13.98,0:14:17.82,Default,,0,0,0,,Қаласаңыз, менімен импульстік тігіс туралы білгіңіз келе ме?
Dialogue: 0,0:14:17.82,0:14:22.66,Default,,0,0,0,,Бірақ мен Джингиден үйрендім.
Dialogue: 0,0:14:22.66,0:14:26.33,Default,,0,0,0,,Бұл жақсы емес. Иә, менің ойымша, бұл жақсы емес.
Dialogue: 0,0:14:26.33,0:14:28.33,Default,,0,0,0,,Хаха….
Dialogue: 0,0:14:28.33,0:14:30.67,Default,,0,0,0,,Сізде талант көп сияқты⇒
Dialogue: 0,0:14:30.67,0:14:33.33,Default,,0,0,0,,Курама Сенсей⇒ сияқты логикалық болыңыз
Dialogue: 0,0:14:33.33,0:14:36.67,Default,,0,0,0,,Дұрыс жолды үйрететін адам болғаны дұрыс емес пе?
Dialogue: 0,0:14:36.67,0:14:40.51,Default,,0,0,0,,Кез келген жолдағыдай шеберді таңдау маңызды, солай ма?
Dialogue: 0,0:14:40.51,0:14:42.84,Default,,0,0,0,,Иә, иә. Жақсы ⇒
Dialogue: 0,0:14:42.84,0:14:45.51,Default,,0,0,0,,Қалай болғанда да, біз сіздің қабілетіңізді бағалаймыз ⇒
Dialogue: 0,0:14:45.51,0:14:47.68,Default,,0,0,0,,Мен жай ғана көз жеткізгім келеді.
Dialogue: 0,0:14:47.68,0:14:52.19,Default,,0,0,0,,Сондықтан мен сізді осы жаттығу алаңына келуіңізді өтіндім. Жаттығу алаңы?
Dialogue: 0,0:14:52.19,0:14:54.86,Default,,0,0,0,,Ах. Күшті импульстік сілтеме ретінде өлшеу үшін ⇒
Dialogue: 0,0:14:54.86,0:14:57.56,Default,,0,0,0,,Менің мұғалімім бұл жер ең жақсы жер деді.
Dialogue: 0,0:15:00.63,0:15:03.63,Default,,0,0,0,,Ым... Ал, қараңдаршы.
Dialogue: 0,0:15:03.63,0:15:07.03,Default,,0,0,0,,Барлық заттар Ұлы Даоны қастерлеу арқылы пайда болады.
Dialogue: 0,0:15:11.14,0:15:13.34,Default,,0,0,0,,Ммм….
Dialogue: 0,0:15:15.48,0:15:17.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:19.98,0:15:22.98,Default,,0,0,0,,Уф... Жарайды, солай.
Dialogue: 0,0:15:22.98,0:15:25.15,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл керемет болар еді. Күрсіну….
Dialogue: 0,0:15:25.15,0:15:27.99,Default,,0,0,0,,Хаха... Чатароның күші жетпейді ⇒
Dialogue: 0,0:15:27.99,0:15:31.16,Default,,0,0,0,,Юкито-кун да назар аудармайды. Хмм.
Dialogue: 0,0:15:31.16,0:15:34.33,Default,,0,0,0,,Келесі жолы менің техникамды қараңыз.
Dialogue: 0,0:15:34.33,0:15:38.83,Default,,0,0,0,,Барлық заттар Ұлы Даоны қастерлеу арқылы пайда болады.
Dialogue: 0,0:15:38.83,0:15:40.84,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:43.17,0:15:45.57,Default,,0,0,0,,Ммм... Хм/сағ.
Dialogue: 0,0:15:47.51,0:15:50.18,Default,,0,0,0,,Сіз қалай ойлайсыз? ? Ол Чатародан үлкен емес пе?
Dialogue: 0,0:15:50.18,0:15:53.85,Default,,0,0,0,,Менен еш айырмашылығы жоқ! Ал діңі қалың болса ⇒
Dialogue: 0,0:15:53.85,0:15:57.02,Default,,0,0,0,,Себебі мен қалыңмын! Қайтадан жеңілгеніме қынжыламын!
Dialogue: 0,0:15:57.02,0:15:59.35,Default,,0,0,0,,Жалпы айтқанда, сіз әрқашан осындайсыз.
Dialogue: 0,0:15:59.35,0:16:02.46,Default,,0,0,0,,Мен тас-қағаз қайшыда жеңілсем де, кешігіп қалдым деп өзімді кінәладым⇒
Dialogue: 0,0:16:02.46,0:16:04.63,Default,,0,0,0,,Жуынатын бөлмені тазалауға құлықсыз. Тіпті сен ⇒
Dialogue: 0,0:16:04.63,0:16:08.13,Default,,0,0,0,,Күні кеше мұғалім бақшаны жинағаным үшін мақтады.
Dialogue: 0,0:16:08.13,0:16:11.30,Default,,0,0,0,,Не? Бұл о. Әбден жеткілікті.
Dialogue: 0,0:16:11.30,0:16:13.30,Default,,0,0,0,,Менің ойымша, Юкито-кун керемет! ?
Dialogue: 0,0:16:13.30,0:16:15.30,Default,,0,0,0,,Бұл менмін! ? Ахах...
Dialogue: 0,0:16:15.30,0:16:18.64,Default,,0,0,0,,Сонымен... ең бастысы, бұл техника дегеніміз не?
Dialogue: 0,0:16:18.64,0:16:21.64,Default,,0,0,0,,Маған түсінікті етіп түсіндіріп беріңізші.
Dialogue: 0,0:16:21.64,0:16:23.98,Default,,0,0,0,,Жарайды. Мұғалімнен⇒
Dialogue: 0,0:16:23.98,0:16:26.48,Default,,0,0,0,,Негіздерді дұрыс меңгерген дұрыс.
Dialogue: 0,0:16:26.48,0:16:30.32,Default,,0,0,0,,Ойыңызды босатыңыз және өмірдің бар екенін сезініңіз.
Dialogue: 0,0:16:30.32,0:16:33.99,Default,,0,0,0,,Денеңізді босатыңыз және оның күшін тұқымға жіберіңіз.
Dialogue: 0,0:16:33.99,0:16:36.16,Default,,0,0,0,,Сонда ағаш өседі. Түсінесіз бе?
Dialogue: 0,0:16:36.16,0:16:38.16,Default,,0,0,0,,Мен... көремін.
Dialogue: 0,0:16:38.16,0:16:40.16,Default,,0,0,0,,《Мен түсінбеймін, бірақ...
Dialogue: 0,0:16:40.16,0:16:43.00,Default,,0,0,0,,Алайда мен жаңа ғана Құрама-санға құтқарушының бар екенін айттым⇒
Dialogue: 0,0:16:43.00,0:16:46.33,Default,,0,0,0,,Маған сезіндіргендіктен бе? Әйтеуір...》
Dialogue: 0,0:16:46.33,0:16:49.34,Default,,0,0,0,,Бұл жақсы ма? Сіз мұны өз қалауыңыз бойынша жасай аласыз.
Dialogue: 0,0:16:49.34,0:16:51.67,Default,,0,0,0,,Ендеше, кенет өзімізге байланысты ⇒
Dialogue: 0,0:16:51.67,0:16:53.67,Default,,0,0,0,,Менің ойымша, бұл қиын.
Dialogue: 0,0:16:53.67,0:16:55.68,Default,,0,0,0,,《Оған қуат құйыңыз.
Dialogue: 0,0:16:55.68,0:16:58.35,Default,,0,0,0,,Мен бұл туралы не істеу керектігін білемін...》
Dialogue: 0,0:16:58.35,0:17:02.95,Default,,0,0,0,,Барлығы Ұлы Даоны құрметтеуден туындайды.
Dialogue: 0,0:17:02.95,0:17:04.95,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:08.79,0:17:12.59,Default,,0,0,0,,Өте қараңғы! Әрине, осы уақытқа дейін.
Dialogue: 0,0:17:14.96,0:17:17.47,Default,,0,0,0,,Сәлем. Бұл өте...
Dialogue: 0,0:17:19.97,0:17:21.97,Default,,0,0,0,,Не? Күте тұрыңыз, бұл...
Dialogue: 0,0:17:24.47,0:17:27.14,Default,,0,0,0,,Мен мұндайды бұрын-соңды көрген емеспін... Юкито-кун!
Dialogue: 0,0:17:27.14,0:17:30.31,Default,,0,0,0,,Бұлай жалғаса берсе, бұл жаттығу алаңы әбігерге айналады!
Dialogue: 0,0:17:30.31,0:17:32.31,Default,,0,0,0,,Не? иә? Тоқта!
Dialogue: 0,0:17:32.31,0:17:34.65,Default,,0,0,0,,Мен сенің құдіретің керемет екенін білемін!
Dialogue: 0,0:17:34.65,0:17:37.82,Default,,0,0,0,,Жоқ... жоқ. Мен тоқтай алмаймын! (Яго/Чатаро) Ех! ?
Dialogue: 0,0:17:37.82,0:17:40.66,Default,,0,0,0,,Тоқта! тоқта! тоқта! тоқта! тоқта! Тоқта!
Dialogue: 0,0:17:40.66,0:17:42.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:42.66,0:17:45.66,Default,,0,0,0,,♪～
Dialogue: 0,0:17:45.66,0:17:47.66,Default,,0,0,0,,Юкито-кун!
Dialogue: 0,0:17:47.66,0:17:50.16,Default,,0,0,0,,Қарғыс атсын, тоқта! Өтінемін тоқта!
Dialogue: 0,0:17:50.16,0:17:52.33,Default,,0,0,0,,Мен мұны қаламаймын!
Dialogue: 0,0:17:52.33,0:17:54.34,Default,,0,0,0,,Мынадай нәрсе...
Dialogue: 0,0:17:54.34,0:17:57.51,Default,,0,0,0,,♪～
Dialogue: 0,0:17:57.51,0:18:00.94,Default,,0,0,0,,Әй... Әй, тәжірибесіз!
Dialogue: 0,0:18:00.94,0:18:03.61,Default,,0,0,0,,Ештеңе істей алмайтын жағдай болса ше?
Dialogue: 0,0:18:03.61,0:18:07.11,Default,,0,0,0,,Тек адал болыңыз және айналаңыздағылардан көмек сұраңыз.
Dialogue: 0,0:18:07.11,0:18:11.45,Default,,0,0,0,,Осылай жасасаң, мына ұлы шебер саған көмектеседі.
Dialogue: 0,0:18:11.45,0:18:15.12,Default,,0,0,0,,Бұл сіздің есіңізде қалған бірінші нәрсе.
Dialogue: 0,0:18:15.12,0:18:17.29,Default,,0,0,0,,Цзинги мырза...?
Dialogue: 0,0:18:17.29,0:18:19.29,Default,,0,0,0,,Бұл үйлесімділік. Бұл гармония.
Dialogue: 0,0:18:19.29,0:18:23.97,Default,,0,0,0,,Бұл тек қуат өндіру туралы емес; оны реттеу туралы.
Dialogue: 0,0:18:23.97,0:18:26.47,Default,,0,0,0,,Менімен бірге көріңіз.
Dialogue: 0,0:18:26.47,0:18:29.64,Default,,0,0,0,,Қарау, жинақтау, жинақтау.
Dialogue: 0,0:18:29.64,0:18:32.81,Default,,0,0,0,,Ғашық болып, қуанып, ішінде піл бар⇒
Dialogue: 0,0:18:32.81,0:18:35.98,Default,,0,0,0,,Экстаз немесе ғашық, ішінде бірдеңе бар⇒
Dialogue: 0,0:18:35.98,0:18:38.98,Default,,0,0,0,,Шұңқыр мен қараңғылықтың ішінде рух бар.
Dialogue: 0,0:18:42.65,0:18:45.99,Default,,0,0,0,,Иә, сенің қолыңнан келетініне сенімдімін.
Dialogue: 0,0:18:45.99,0:18:52.83,Default,,0,0,0,,♪～
Dialogue: 0,0:18:52.83,0:18:56.16,Default,,0,0,0,,Бүршік бүршік жарады, ісінеді, гүл ашады...
Dialogue: 0,0:18:56.16,0:19:00.43,Default,,0,0,0,,Табиғат осылайша өзінің бастапқы күйіне оралғысы келеді.
Dialogue: 0,0:19:00.43,0:19:03.44,Default,,0,0,0,,Не? Сіз жасадыңыз. Уф.
Dialogue: 0,0:19:03.44,0:19:07.11,Default,,0,0,0,,Ал, мен Хару-нимен бірге ішуге барамын.
Dialogue: 0,0:19:07.11,0:19:09.94,Default,,0,0,0,,Сіз олармен ойнамайсыз.
Dialogue: 0,0:19:09.94,0:19:12.28,Default,,0,0,0,,Сонымен.
Dialogue: 0,0:19:12.28,0:19:16.58,Default,,0,0,0,,Цзинги мырза! .... рақмет сізге….
Dialogue: 0,0:19:18.62,0:19:20.96,Default,,0,0,0,,Эй, сәлем. Ах!
Dialogue: 0,0:19:20.96,0:19:23.96,Default,,0,0,0,,Мм... Кешіріңіз. Сенімен бәрі жақсы ма?
Dialogue: 0,0:19:27.46,0:19:29.63,Default,,0,0,0,,Керемет! Өте керемет! иә?
Dialogue: 0,0:19:29.63,0:19:32.63,Default,,0,0,0,,Сізде шынымен де керемет күш бар! иә?
Dialogue: 0,0:19:32.63,0:19:35.80,Default,,0,0,0,,Жаттығуды бастағаныма бірнеше күн ғана болды, бұл маңызды ма? иә?
Dialogue: 0,0:19:35.80,0:19:39.64,Default,,0,0,0,,Мұғалімнен күткендей мұғалімнің баласы да бар.
Dialogue: 0,0:19:39.64,0:19:41.98,Default,,0,0,0,,Біз де ұтыла алмаймыз!
Dialogue: 0,0:19:41.98,0:19:45.98,Default,,0,0,0,,Мм... екеуің де менен қорықпайсыңдар ма?
Dialogue: 0,0:19:45.98,0:19:48.82,Default,,0,0,0,,Қорқынышты ма? Неліктен? Өйткені...
Dialogue: 0,0:19:48.82,0:19:51.32,Default,,0,0,0,,Эй, сен бізбен біргесің бе⇒
Dialogue: 0,0:19:51.32,0:19:53.32,Default,,0,0,0,,Менің ұстазымның шәкірті болғың келе ме?
Dialogue: 0,0:19:53.32,0:19:57.66,Default,,0,0,0,,Мен сенімен жақсы араласамын деп ойлаймын!
Dialogue: 0,0:19:57.66,0:20:04.33,Default,,0,0,0,,《Түсіндім... бұл балалар менен қорықпайды...
Dialogue: 0,0:20:04.33,0:20:06.50,Default,,0,0,0,,Мен түсінемін...》
Dialogue: 0,0:20:06.50,0:20:09.17,Default,,0,0,0,,Юкито-кун? Не болды?
Dialogue: 0,0:20:09.17,0:20:11.34,Default,,0,0,0,,Бұл ештеңе емес.
Dialogue: 0,0:20:11.34,0:20:15.18,Default,,0,0,0,,Дұрыс. Біз жақсы араласа аламыз.
Dialogue: 0,0:20:15.18,0:20:17.85,Default,,0,0,0,,Олай болса... бірақ....
Dialogue: 0,0:20:17.85,0:20:20.85,Default,,0,0,0,,)
Dialogue: 0,0:20:20.85,0:20:25.19,Default,,0,0,0,,Аа... Ал, әзірше сол шебердің жағдайы жақсы деп ойлаймын.
Dialogue: 0,0:20:25.19,0:20:28.36,Default,,0,0,0,,Иә? иә? Эх!
Dialogue: 0,0:20:28.36,0:20:30.52,Default,,0,0,0,,Ол неге олай? (Яко) Бұл шынымен жақсы ма? ?
Dialogue: 0,0:20:30.52,0:20:32.53,Default,,0,0,0,,Тағы да ойланыңыз!
Dialogue: 0,0:20:32.53,0:20:34.53,Default,,0,0,0,,Кушун! иә?
Dialogue: 0,0:22:04.99,0:22:09.82,Default,,0,0,0,,♪～
Dialogue: 0,0:22:15.33,0:22:17.33,Default,,0,0,0,,О, менің...
Dialogue: 0,0:22:21.17,0:22:25.34,Default,,0,0,0,,Күрсіну~ Мен бүгін шаршадым. Юкито-кун, кеш болды.
Dialogue: 0,0:22:25.34,0:22:28.34,Default,,0,0,0,,Күткенім үшін кешіріңіз...
Dialogue: 0,0:22:30.85,0:22:34.55,Default,,0,0,0,,Сен неге қобалжыдың? Шелек сонда.
Dialogue: 0,0:22:36.52,0:22:38.85,Default,,0,0,0,,Мен сізге кедергі келтіремін ...
Dialogue: 0,0:22:38.85,0:22:41.19,Default,,0,0,0,,Эй, материк шынымен қызық емес пе?
Dialogue: 0,0:22:41.19,0:22:43.19,Default,,0,0,0,,Не? Мм... иә.
Dialogue: 0,0:22:43.19,0:22:46.36,Default,,0,0,0,,Мен оны ешқашан көрген емеспін...
Dialogue: 0,0:22:46.36,0:22:48.53,Default,,0,0,0,,Қалада адам тым көп⇒
Dialogue: 0,0:22:48.53,0:22:51.37,Default,,0,0,0,,Өмір жолын сезіну қиын болуы керек.
Dialogue: 0,0:22:51.37,0:22:54.70,Default,,0,0,0,,Митама бұл аралда жиі кездеседі.
Dialogue: 0,0:22:54.70,0:22:57.04,Default,,0,0,0,,Арамитама⇒ сияқты жүзеге аспаса
Dialogue: 0,0:22:57.04,0:22:59.54,Default,,0,0,0,,Қалыпты адамдар оны көре алмайды.
Dialogue: 0,0:22:59.54,0:23:02.98,Default,,0,0,0,,Хаха... Аяқай аралы ғой, солай емес пе? Аяка?
Dialogue: 0,0:23:02.98,0:23:05.65,Default,,0,0,0,,Аяқай - Аяқай. (Юкито) Бұл не?
Dialogue: 0,0:23:05.65,0:23:08.65,Default,,0,0,0,,Өте қараңғы. (Чатаро) Бұл өте тәтті.
Dialogue: 0,0:23:16.32,0:23:19.83,Default,,0,0,0,,《Бұл...
Dialogue: 0,0:23:19.83,0:23:22.66,Default,,0,0,0,,Өмірің сыздап тұрғанда алатын сезім сияқты⇒
Dialogue: 0,0:23:22.66,0:23:27.00,Default,,0,0,0,,Қожайынның ұлы болу тым бөлек...
Dialogue: 0,0:23:27.00,0:23:30.30,Default,,0,0,0,,Ол кім...?
Dialogue: 0,0:23:37.85,0:23:43.15,Default,,0,0,0,,Ұстаз Мен... Жақсы істей аламын ба деп ойлаймын...
Dialogue: 0,0:23:44.65,0:23:50.65,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
