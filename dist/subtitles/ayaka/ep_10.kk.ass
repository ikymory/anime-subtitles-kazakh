Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.64,0:00:13.81,Default,,0,0,0,,《Тоги: Мен Юкитоның құпиясын білдім.
Dialogue: 0,0:00:13.81,0:00:17.31,Default,,0,0,0,,Бұл менің бала кезімде, ештеңені әрең есімде сақтайтынмын.
Dialogue: 0,0:00:17.31,0:00:20.31,Default,,0,0,0,,Юкито, міне, солай!
Dialogue: 0,0:00:20.31,0:00:23.65,Default,,0,0,0,,Джиги Джииги
Dialogue: 0,0:00:23.65,0:00:27.49,Default,,0,0,0,,Жарайды! Бұл тамаша, Юкито!
Dialogue: 0,0:00:27.49,0:00:29.99,Default,,0,0,0,,(көңілді дауыс)
Dialogue: 0,0:00:29.99,0:00:33.33,Default,,0,0,0,,Сәлем... Қайда? Қараңдар, қараңдар!
Dialogue: 0,0:00:33.33,0:00:35.33,Default,,0,0,0,,ｷｬﾊﾊ…
Dialogue: 0,0:00:37.33,0:00:39.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:39.50,0:00:42.67,Default,,0,0,0,,Иә!? Иә!? Ах!?
Dialogue: 0,0:00:42.67,0:00:44.67,Default,,0,0,0,,Бұл не!?
Dialogue: 0,0:00:44.67,0:00:47.17,Default,,0,0,0,,Басқаларға көрсетпеу керек
Dialogue: 0,0:00:47.17,0:00:49.34,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:49.34,0:00:52.68,Default,,0,0,0,,Хахаха... Жаман, жаман. Мен сенен көзімді алмауым керек еді.
Dialogue: 0,0:00:52.68,0:00:55.18,Default,,0,0,0,,Енді ше...?
Dialogue: 0,0:00:55.18,0:01:00.19,Default,,0,0,0,,Ах~ Юкито Хана, бұл сәл ерекше.
Dialogue: 0,0:01:00.19,0:01:05.69,Default,,0,0,0,,Юкито ерекше ме? Ах. Судың рухы өте күшті.
Dialogue: 0,0:01:05.69,0:01:08.03,Default,,0,0,0,,ｷｬｯ ｷｬｯ…
Dialogue: 0,0:01:08.03,0:01:09.96,Default,,0,0,0,,О~ Дәмді Дәмді
Dialogue: 0,0:01:09.96,0:01:15.47,Default,,0,0,0,,Джинги де өте күшті, сондықтан Юкито екеуі өте үйлесімді.
Dialogue: 0,0:01:15.47,0:01:19.47,Default,,0,0,0,,Үндемей қалу қауіпті емес пе... Біз солай ма?
Dialogue: 0,0:01:19.47,0:01:22.97,Default,,0,0,0,,Жақсы! Бұл жақсы ма?
Dialogue: 0,0:01:22.97,0:01:26.98,Default,,0,0,0,,Менің айтайын дегенім Шунджу мен Аканеге қатысы жоқ.
Dialogue: 0,0:01:26.98,0:01:30.82,Default,,0,0,0,,Бұл сен екеуміздің арамыздағы құпия. Иә!
Dialogue: 0,0:01:30.82,0:01:33.15,Default,,0,0,0,,Юкито шын мәнінде...
Dialogue: 0,0:01:33.15,0:01:39.82,Default,,0,0,0,,♪～
Dialogue: 0,0:01:39.82,0:01:43.32,Default,,0,0,0,,Юкито...
Dialogue: 0,0:02:04.85,0:02:07.02,Default,,0,0,0,,Юкито-кун!?
Dialogue: 0,0:02:07.02,0:02:09.95,Default,,0,0,0,,Балалар! (Курама) Неге!
Dialogue: 0,0:02:09.95,0:02:11.96,Default,,0,0,0,,Бастық! (Яко) Мұғалім!
Dialogue: 0,0:02:11.96,0:02:14.13,Default,,0,0,0,,Эй... Мен көмектесуге келдім!
Dialogue: 0,0:02:14.13,0:02:16.80,Default,,0,0,0,,Бос сөзге еліктеуді доғар!
Dialogue: 0,0:02:16.80,0:02:18.96,Default,,0,0,0,,Жоқ! Мен тоқтамаймын!
Dialogue: 0,0:02:18.96,0:02:21.80,Default,,0,0,0,,Біз де Янагидің мұрагерлеріміз!
Dialogue: 0,0:02:21.80,0:02:27.47,Default,,0,0,0,,Хаха... Мұнда келген адамға көмектесе алмаймын. Вермилион?
Dialogue: 0,0:02:27.47,0:02:29.64,Default,,0,0,0,,Сәлем, Ибара. Иә!
Dialogue: 0,0:02:29.64,0:02:31.64,Default,,0,0,0,,Юкито. Иә!
Dialogue: 0,0:02:31.64,0:02:34.81,Default,,0,0,0,,Сондай-ақ, Шунджудың інісі мен баласы. иә? иә?
Dialogue: 0,0:02:34.81,0:02:39.32,Default,,0,0,0,,Бізді тылдан қолдаңыз. Сен сол тікенді бәйбішелерге жауаптысың.
Dialogue: 0,0:02:39.32,0:02:41.32,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:02:41.32,0:02:43.32,Default,,0,0,0,,Мм. Вермиллион!
Dialogue: 0,0:02:43.32,0:02:45.32,Default,,0,0,0,,Бұл балалар үшін қауіпті!
Dialogue: 0,0:02:45.32,0:02:48.82,Default,,0,0,0,,Төтенше жағдай болған жағдайда, оларды қашып шығуға рұқсат етіңіз.
Dialogue: 0,0:02:51.33,0:02:53.53,Default,,0,0,0,,Се... Мұғалім...
Dialogue: 0,0:02:56.00,0:02:59.84,Default,,0,0,0,,Чатаро Яго және Юкито-кун Ибара-чан
Dialogue: 0,0:02:59.84,0:03:02.01,Default,,0,0,0,,Мен сенің арқаңды сұраймын.
Dialogue: 0,0:03:02.01,0:03:05.51,Default,,0,0,0,,Бірақ оны асыра алмаңыз. (Юкито/Чатаро/Яго) Иә!
Dialogue: 0,0:03:09.35,0:03:13.28,Default,,0,0,0,,Чатаро Фукубун мен Яго Амано шабуылдан барынша қорғанды.
Dialogue: 0,0:03:13.28,0:03:15.95,Default,,0,0,0,,Юкито Янаги нысананы бақылауда ұстау үшін менімен бірге.
Dialogue: 0,0:03:15.95,0:03:18.46,Default,,0,0,0,,Мен... Түсіндім! сен маған бұйыр
Dialogue: 0,0:03:18.46,0:03:21.96,Default,,0,0,0,,Бұл мағынасы жоқ! Бірақ мен жасаймын!
Dialogue: 0,0:03:24.96,0:03:26.96,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:03:28.97,0:03:35.64,Default,,0,0,0,,♪～
Dialogue: 0,0:03:35.64,0:03:37.98,Default,,0,0,0,,Сіз екеуіңіз бұрынғы достар едіңіздер деп естідім…
Dialogue: 0,0:03:37.98,0:03:39.98,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:03:43.31,0:03:45.82,Default,,0,0,0,,ﾌｯ！
Dialogue: 0,0:03:45.82,0:03:48.32,Default,,0,0,0,,Tsk! (от айдаһарының айқайы)
Dialogue: 0,0:03:48.32,0:03:51.49,Default,,0,0,0,,Дүниедегі ең жұмсақ, әлемдегі ең берік,
Dialogue: 0,0:03:51.49,0:03:53.69,Default,,0,0,0,,Ешбір болмыс болмысқа кірмейді!
Dialogue: 0,0:03:56.33,0:03:58.50,Default,,0,0,0,,Ой!
Dialogue: 0,0:03:58.50,0:04:01.83,Default,,0,0,0,,(Отты айдаһардың ыңырануы)
Dialogue: 0,0:04:01.83,0:04:04.50,Default,,0,0,0,,Барлық нәрсені пайдаланатын және онымен таласпайтын су,
Dialogue: 0,0:04:04.50,0:04:07.01,Default,,0,0,0,,Жамандық жасаған адамдарды жазала!
Dialogue: 0,0:04:07.01,0:04:09.34,Default,,0,0,0,,(енеді)
Dialogue: 0,0:04:09.34,0:04:13.04,Default,,0,0,0,,Тендоу, бұл садақ сияқты!
Dialogue: 0,0:04:16.61,0:04:18.71,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:04:21.95,0:04:24.96,Default,,0,0,0,,Ооо!
Dialogue: 0,0:04:24.96,0:04:28.46,Default,,0,0,0,,(енеді)
Dialogue: 0,0:04:28.46,0:04:36.47,Default,,0,0,0,,♪～
Dialogue: 0,0:04:36.47,0:04:38.97,Default,,0,0,0,,ﾌｯ！
Dialogue: 0,0:04:38.97,0:04:42.47,Default,,0,0,0,,Бұл қажетсіз еліктеушілік жағдай ма?
Dialogue: 0,0:04:45.48,0:04:47.65,Default,,0,0,0,,Мен бұл екеуінің бірге соғысып жатқанына сене алар емеспін!
Dialogue: 0,0:04:47.65,0:04:51.15,Default,,0,0,0,,А, бұл да отты айдаһар болуы мүмкін!
Dialogue: 0,0:04:51.15,0:04:54.15,Default,,0,0,0,,《Юкито: Егер мен шынымен су айдаһары болсам.
Dialogue: 0,0:04:54.15,0:04:57.45,Default,,0,0,0,,Мен неге әлі...?
Dialogue: 0,0:05:00.99,0:05:02.99,Default,,0,0,0,,((《 Шексіз: Юкито өзін су айдаһары дейді.
Dialogue: 0,0:05:02.99,0:05:07.50,Default,,0,0,0,,Қожайыным екеуміздің арамыздағы сырды Хару-ни де, Шу-ни да білмейді.
Dialogue: 0,0:05:07.50,0:05:10.27,Default,,0,0,0,,Бұл менің ең қымбат қазынам болды.
Dialogue: 0,0:05:10.27,0:05:13.27,Default,,0,0,0,,Ағаларым жоқта,
Dialogue: 0,0:05:13.27,0:05:17.97,Default,,0,0,0,,Мен қожайыным және оның қазынасы туралы жасырын сөйлескенді ұнататынмын.
Dialogue: 0,0:05:22.11,0:05:24.12,Default,,0,0,0,,Бұл өте кішкентай...
Dialogue: 0,0:05:24.12,0:05:26.45,Default,,0,0,0,,Иә? Не болды, Джини?
Dialogue: 0,0:05:26.45,0:05:29.79,Default,,0,0,0,,Юкито су айдаһарына қайта орала ма?
Dialogue: 0,0:05:29.79,0:05:33.29,Default,,0,0,0,,Егер мен Су айдаһарына оралсам, Юкитоны енді көре алмаймын ба?
Dialogue: 0,0:05:33.29,0:05:35.79,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:05:35.79,0:05:39.63,Default,,0,0,0,,Егер ол үлкейіп, қазіргі көктем мен күзге немесе қызылша жасына жетсе.
Dialogue: 0,0:05:39.63,0:05:41.63,Default,,0,0,0,,Бастапқы күш-қуатыңызды қайта алсаңыз да
Dialogue: 0,0:05:41.63,0:05:45.47,Default,,0,0,0,,Ол адам пішінін сақтау үшін жеткілікті тұрақты болады.
Dialogue: 0,0:05:45.47,0:05:49.31,Default,,0,0,0,,Бұл Юкитоға байланысты. Дегенмен, сол мақсат үшін
Dialogue: 0,0:05:49.31,0:05:51.98,Default,,0,0,0,,Маған қиындық тудыратын әдістерді қолдануға тура келеді.
Dialogue: 0,0:05:51.98,0:05:54.31,Default,,0,0,0,,Мазасыз әдіс?
Dialogue: 0,0:05:54.31,0:05:59.15,Default,,0,0,0,,Аа... Мен мұнымен айналысамын, уайымдама.
Dialogue: 0,0:05:59.15,0:06:02.99,Default,,0,0,0,,Оған дейін Юкитоны қорға.
Dialogue: 0,0:06:02.99,0:06:05.19,Default,,0,0,0,,О!
Dialogue: 0,0:06:08.66,0:06:10.96,Default,,0,0,0,,Уа. Ха...
Dialogue: 0,0:06:13.26,0:06:16.16,Default,,0,0,0,,(Тыныс алу)
Dialogue: 0,0:06:21.61,0:06:24.44,Default,,0,0,0,,Юкито-кунды материкте көтеріңіз...?
Dialogue: 0,0:06:24.44,0:06:27.78,Default,,0,0,0,,Бұл Масатоның еркі.
Dialogue: 0,0:06:27.78,0:06:30.45,Default,,0,0,0,,Маған бірдеңе болса
Dialogue: 0,0:06:30.45,0:06:33.45,Default,,0,0,0,,Юкитоны материктегі қарттар үйіне қалдырыңыз.
Dialogue: 0,0:06:33.45,0:06:39.12,Default,,0,0,0,,15 жылға дейін Аяка аралындағы адамдармен байланысын үзіңіз.
Dialogue: 0,0:06:39.12,0:06:42.46,Default,,0,0,0,,Неге! Мен әкемнен айырылдым!
Dialogue: 0,0:06:42.46,0:06:45.30,Default,,0,0,0,,Кішкентай болсам да, отбасым былай тұрсын.
Dialogue: 0,0:06:45.30,0:06:48.80,Default,,0,0,0,,Бұл аралдан бөліну үшін...
Dialogue: 0,0:06:48.80,0:06:51.14,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:06:51.14,0:06:54.81,Default,,0,0,0,,Қожайынның артында мағынасыз нәрсе қалдыруы мүмкін емес...
Dialogue: 0,0:06:54.81,0:06:59.48,Default,,0,0,0,,Сіз мұны міндетті түрде орындауыңыз керек.
Dialogue: 0,0:06:59.48,0:07:14.09,Default,,0,0,0,,♪～
Dialogue: 0,0:07:14.09,0:07:17.93,Default,,0,0,0,,(кеме ысқырығы)
Dialogue: 0,0:07:17.93,0:07:19.93,Default,,0,0,0,,《Шебердің өсиетінің себебі
Dialogue: 0,0:07:19.93,0:07:22.10,Default,,0,0,0,,Мен де түсінбедім.
Dialogue: 0,0:07:22.10,0:07:27.44,Default,,0,0,0,,Бұған Юкитоның су айдаһары болғаны күмәнсіз болды.
Dialogue: 0,0:07:27.44,0:07:32.78,Default,,0,0,0,,Бірақ Юкито аралдан тыс жерде өссе не болады?
Dialogue: 0,0:07:32.78,0:07:35.45,Default,,0,0,0,,Юкито өзінің бастапқы су айдаһары күйіне оралуы үшін
Dialogue: 0,0:07:35.45,0:07:38.28,Default,,0,0,0,,Магистрлік техника қажет
Dialogue: 0,0:07:38.28,0:07:40.62,Default,,0,0,0,,Бірақ менің қожайыным енді жоқ.
Dialogue: 0,0:07:40.62,0:07:44.96,Default,,0,0,0,,Хару-ни де, Шу-ни де жараланып, бәрі құлады.
Dialogue: 0,0:07:44.96,0:07:47.46,Default,,0,0,0,,Мұны сіз үшін басқа біреу жасауы керек.
Dialogue: 0,0:07:47.46,0:07:51.46,Default,,0,0,0,,Мен... мен мұны істеуім керек》
Dialogue: 0,0:07:51.46,0:07:54.47,Default,,0,0,0,,Иә!? Бұл...
Dialogue: 0,0:07:54.47,0:07:56.97,Default,,0,0,0,,《Шебердің жазбаларында не қалды
Dialogue: 0,0:07:56.97,0:08:00.14,Default,,0,0,0,,Бұл техникаға қатысты үзінді естелік болды.
Dialogue: 0,0:08:00.14,0:08:03.47,Default,,0,0,0,,Мен де Масато Янагидің шәкіртімін.
Dialogue: 0,0:08:03.47,0:08:09.48,Default,,0,0,0,,Мен оның қандай техника екенін түсіндім.
Dialogue: 0,0:08:09.48,0:08:11.42,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:08:11.42,0:08:15.72,Default,,0,0,0,,Мастер… Юкито…))
Dialogue: 0,0:08:21.09,0:08:23.76,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:08:23.76,0:08:25.76,Default,,0,0,0,,Ах! (еңіреді)
Dialogue: 0,0:08:25.76,0:08:29.77,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:08:29.77,0:08:33.27,Default,,0,0,0,,Су, барлық нәрсеге пайда әкел және ұрыспа!
Dialogue: 0,0:08:39.44,0:08:41.61,Default,,0,0,0,,(енеді)
Dialogue: 0,0:08:41.61,0:08:45.28,Default,,0,0,0,,《Юкито-кун өзін білген сайын оның қабілеттері ашылады...》
Dialogue: 0,0:08:45.28,0:08:47.29,Default,,0,0,0,,Бірақ...!
Dialogue: 0,0:08:47.29,0:08:49.29,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:08:51.46,0:08:55.66,Default,,0,0,0,,Мықтыға шабуыл жасайтындар. Мұны жеңу мүмкін емес!
Dialogue: 0,0:08:58.46,0:09:02.47,Default,,0,0,0,,(енеді)
Dialogue: 0,0:09:02.47,0:09:05.80,Default,,0,0,0,,Бұл техника шеберлік...!?
Dialogue: 0,0:09:05.80,0:09:08.31,Default,,0,0,0,,Нууууууууу!
Dialogue: 0,0:09:08.31,0:09:16.41,Default,,0,0,0,,♪～
Dialogue: 0,0:09:16.41,0:09:18.71,Default,,0,0,0,,Мұғалім! Тек осылай мөрленсе ғой!
Dialogue: 0,0:09:22.59,0:09:27.26,Default,,0,0,0,,Сіз екеуіңіз бұрынғы достар едіңіздер деп естідім…
Dialogue: 0,0:09:27.26,0:09:29.26,Default,,0,0,0,,Ах!?
Dialogue: 0,0:09:29.26,0:09:31.26,Default,,0,0,0,,Жоқ...! Қарғыс атсын...!
Dialogue: 0,0:09:34.10,0:09:37.10,Default,,0,0,0,,Шимейширо Зан!
Dialogue: 0,0:09:37.10,0:09:39.44,Default,,0,0,0,,Жауынгер жауынгер. Соғыс - ашу.
Dialogue: 0,0:09:39.44,0:09:43.44,Default,,0,0,0,,Жеңіс беріледі; адамдар мен мінез-құлық тәкаппар.
Dialogue: 0,0:09:43.44,0:09:46.14,Default,,0,0,0,,Зұлымдықтың шектен шығуы
Dialogue: 0,0:09:48.95,0:09:53.12,Default,,0,0,0,,Бастық!? (Ибуки) Адам сияқты бірдеңе айдаһармен соғысып жатыр.
Dialogue: 0,0:09:53.12,0:09:57.12,Default,,0,0,0,,Бір нәрсені лақтырып тастамасаң, оны қорғай алмайсың!
Dialogue: 0,0:09:59.62,0:10:05.46,Default,,0,0,0,,Орнын жоғалтпағандар ұзақ өмір сүреді, өлмейтіндер мәңгі өмір сүреді.
Dialogue: 0,0:10:05.46,0:10:14.64,Default,,0,0,0,,♪～
Dialogue: 0,0:10:14.64,0:10:16.94,Default,,0,0,0,,Гррр…
Dialogue: 0,0:10:21.81,0:10:24.48,Default,,0,0,0,,Жақсы емес... Ол әрең жұмыс істейді...
Dialogue: 0,0:10:24.48,0:10:28.15,Default,,0,0,0,,Мұның бәрі сендер үшін.
Dialogue: 0,0:10:28.15,0:10:31.99,Default,,0,0,0,,Менің күш-қуатым қалғанша мен шегінемін.
Dialogue: 0,0:10:31.99,0:10:36.19,Default,,0,0,0,,Мұғалім!? Бастық! Мен әлі де істей аламын!
Dialogue: 0,0:10:40.00,0:10:43.00,Default,,0,0,0,,Бастық! (Яго/Чатаро) Мұғалім!
Dialogue: 0,0:10:43.00,0:10:46.80,Default,,0,0,0,,Ал... күте тұрыңыз! Мен әлі!
Dialogue: 0,0:10:49.01,0:10:51.18,Default,,0,0,0,,Иә!? Қарғыс атқыр...
Dialogue: 0,0:10:51.18,0:10:53.85,Default,,0,0,0,,《Юкито: Мен неге ештеңе істей алмаймын?
Dialogue: 0,0:10:53.85,0:10:58.18,Default,,0,0,0,,Адамдарға ғана зиян тигізетін құдіретімнің мәні болса
Dialogue: 0,0:10:58.18,0:11:01.85,Default,,0,0,0,,Мен оны қазір пайдалануым керек...! 》
Dialogue: 0,0:11:01.85,0:11:03.86,Default,,0,0,0,,Мен...!
Dialogue: 0,0:11:03.86,0:11:09.03,Default,,0,0,0,,Жылап жатқандай дыбыс шығармаңыз.
Dialogue: 0,0:11:09.03,0:11:11.13,Default,,0,0,0,,Беру!?
Dialogue: 0,0:11:11.13,0:11:13.97,Default,,0,0,0,,Цзинги мырза...?
Dialogue: 0,0:11:13.97,0:11:16.27,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:11:19.80,0:11:22.47,Default,,0,0,0,,((Мастер… Юкито…
Dialogue: 0,0:11:22.47,0:11:24.81,Default,,0,0,0,,《Ол шебердің жазбаларында қалды.
Dialogue: 0,0:11:24.81,0:11:28.65,Default,,0,0,0,,Юкитоны су айдаһары ретінде тірілту техникасы
Dialogue: 0,0:11:28.65,0:11:32.75,Default,,0,0,0,,Бұл кастердің өміріне айырбас болды》))
Dialogue: 0,0:11:36.32,0:11:38.72,Default,,0,0,0,,Хехе... осында.
Dialogue: 0,0:11:48.17,0:11:54.34,Default,,0,0,0,,10 жыл бұрынғыдай... Сосын тағы да Янаги халқы...
Dialogue: 0,0:11:54.34,0:11:57.84,Default,,0,0,0,,((《 Шексіз: Аяка аралында аңыз бар
Dialogue: 0,0:11:57.84,0:12:03.01,Default,,0,0,0,,Бір кездері осы аралды қорғаған айдаһарлардың бірі әлсіреп қалады.
Dialogue: 0,0:12:03.01,0:12:05.18,Default,,0,0,0,,Біреуі зорлық-зомбылық көрсете бастады.
Dialogue: 0,0:12:05.18,0:12:08.19,Default,,0,0,0,,Әлсіреткені су айдаһары, өмірдің берекесі болды.
Dialogue: 0,0:12:08.19,0:12:12.46,Default,,0,0,0,,Қауіпті отты айдаһардың шабуылы басталды.
Dialogue: 0,0:12:12.46,0:12:16.46,Default,,0,0,0,,Тіршілік ағымы бұзылып, бір кездегі бай аралды от жалмады.
Dialogue: 0,0:12:16.46,0:12:19.46,Default,,0,0,0,,Тірі ағзалардың өмір сүретін жері жоқ.
Dialogue: 0,0:12:19.46,0:12:23.13,Default,,0,0,0,,Ол жерде үлкен гермит пайда болды.
Dialogue: 0,0:12:23.13,0:12:26.14,Default,,0,0,0,,Соицу - өз өмірін саудалайтын әдіс.
Dialogue: 0,0:12:26.14,0:12:30.64,Default,,0,0,0,,Әлсіреп, жойылғалы тұрған су айдаһары қайтадан күшіне ие болды.
Dialogue: 0,0:12:30.64,0:12:33.81,Default,,0,0,0,,Жанданған су айдаһары отты айдаһармен үйлеседі.
Dialogue: 0,0:12:33.81,0:12:37.48,Default,,0,0,0,,Тепе-теңдікті қалпына келтірген арал қайта жанданды.
Dialogue: 0,0:12:37.48,0:12:40.65,Default,,0,0,0,,Құтты болсын, құтты болсын...
Dialogue: 0,0:12:40.65,0:12:43.65,Default,,0,0,0,,Бірақ ұзақ, ұзақ уақыттан кейін
Dialogue: 0,0:12:43.65,0:12:47.33,Default,,0,0,0,,Екі айдаһардың үндестігі қайтадан ыдырайтын кез келді.
Dialogue: 0,0:12:47.33,0:12:51.16,Default,,0,0,0,,Шебер аңызға айналған әдіс-тәсілдерді өз мәнерінде жинақтаған.
Dialogue: 0,0:12:51.16,0:12:55.17,Default,,0,0,0,,Бұл су айдаһары... Юкитоны адам кейпінде көтер.
Dialogue: 0,0:12:55.17,0:12:59.67,Default,,0,0,0,,Дәл сол ескі ұлы гермит сияқты, өз өмірін өтеу үшін.
Dialogue: 0,0:12:59.67,0:13:04.68,Default,,0,0,0,,Ол өз өкілеттіктерін қайтаруға тырысқан сияқты.
Dialogue: 0,0:13:04.68,0:13:07.35,Default,,0,0,0,,Жоқ, рас па? Мен солай ойладым
Dialogue: 0,0:13:07.35,0:13:09.35,Default,,0,0,0,,Сіз мұны істей алмайсыз ба?
Dialogue: 0,0:13:09.35,0:13:13.28,Default,,0,0,0,,Бұл арал туралы ештеңе істей алмайтыныңызға сенімдісіз бе? Сонымен...
Dialogue: 0,0:13:13.28,0:13:17.12,Default,,0,0,0,,Бірақ қанша оқып, түсінсем де, қожайынымның жеткен техникасы
Dialogue: 0,0:13:17.12,0:13:19.29,Default,,0,0,0,,Бұл көрсетілді
Dialogue: 0,0:13:19.29,0:13:23.46,Default,,0,0,0,,Шәкірт ретінде бұған сенуден басқа амалым қалмады.
Dialogue: 0,0:13:23.46,0:13:27.13,Default,,0,0,0,,Енді менің қожайыным кеткен соң, мұны біреу істеу керек.
Dialogue: 0,0:13:27.13,0:13:30.97,Default,,0,0,0,,Аяка аралы баяғыда бірде-бір тіршілік иесі өмір сүре алмайтын аралға айналды.
Dialogue: 0,0:13:30.97,0:13:34.14,Default,,0,0,0,,Юкитомен де не болатынын білмеймін.
Dialogue: 0,0:13:34.14,0:13:36.47,Default,,0,0,0,,Егер біреу мұны істеу керек болса
Dialogue: 0,0:13:36.47,0:13:38.48,Default,,0,0,0,,Имбирь, солай ма?
Dialogue: 0,0:13:38.48,0:13:41.65,Default,,0,0,0,,Бақытымызға орай, менің қандас туыстарым жоқ.
Dialogue: 0,0:13:41.65,0:13:43.81,Default,,0,0,0,,Бұл жеңіл позиция.
Dialogue: 0,0:13:43.81,0:13:48.15,Default,,0,0,0,,Арал үшін құрбандық шалудың да шегі бар.
Dialogue: 0,0:13:48.15,0:13:52.16,Default,,0,0,0,,Мен бұл аралға мені өсіргенім үшін қарыздармын, солай ма?
Dialogue: 0,0:13:52.16,0:13:54.33,Default,,0,0,0,,Оның орнына, сол күнге дейін
Dialogue: 0,0:13:54.33,0:13:58.16,Default,,0,0,0,,Мен өзіме ұнайтын және өзім қалаған нәрсені ғана істеуді шештім.
Dialogue: 0,0:13:58.16,0:14:02.00,Default,,0,0,0,,Мен ұзақ, қысқа және бақытты өмір сүремін.
Dialogue: 0,0:14:02.00,0:14:06.17,Default,,0,0,0,,Ол аралға оралуға келісті.
Dialogue: 0,0:14:06.17,0:14:09.17,Default,,0,0,0,,Бірақ бұл өсиет болса да
Dialogue: 0,0:14:09.17,0:14:12.11,Default,,0,0,0,,Мен білмей тұрып, мені құрлыққа жіберді.
Dialogue: 0,0:14:12.11,0:14:15.95,Default,,0,0,0,,Енді мені өскен жерімнен қайтарып жатыр...
Dialogue: 0,0:14:15.95,0:14:19.78,Default,,0,0,0,,Мен өзімшілмін деп ойласаңыз, мен көмектесе алмаймын.
Dialogue: 0,0:14:19.78,0:14:22.95,Default,,0,0,0,,Мен сені қатты қинадым...
Dialogue: 0,0:14:22.95,0:14:26.79,Default,,0,0,0,,Юкито-кун, ол қандай бала болды деп ойлаймын.
Dialogue: 0,0:14:26.79,0:14:29.13,Default,,0,0,0,,Мен сені алып кетейін.
Dialogue: 0,0:14:29.13,0:14:33.43,Default,,0,0,0,,Қамқоршы ретінде сіз нақты түсініктеме беруге міндеттісіз.
Dialogue: 0,0:14:35.47,0:14:37.47,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:14:40.30,0:14:42.81,Default,,0,0,0,,《Мен есейген соң Юкитоны алуға барғанымда...
Dialogue: 0,0:14:42.81,0:14:46.64,Default,,0,0,0,,Олай емес сияқты, мен аздап қобалжыдым.
Dialogue: 0,0:14:46.64,0:14:50.48,Default,,0,0,0,,Жарайды, менің інім болатын адаммен және менің өмірімді бұзатын адаммен.
Dialogue: 0,0:14:50.48,0:14:55.65,Default,,0,0,0,,Бұл біздің соңғы 10 жылдағы бірінші кездесуіміз. Бұл таңқаларлық емес.
Dialogue: 0,0:14:55.65,0:14:58.66,Default,,0,0,0,,Бірақ мен біраз уақыттан кейін бірінші рет кездестірген Юкито
Dialogue: 0,0:14:58.66,0:15:02.83,Default,,0,0,0,,Ол өте сұсты кейіппен қаңбақ болып кеткен.
Dialogue: 0,0:15:02.83,0:15:05.66,Default,,0,0,0,,Жалғыз адам болсам да, қолымнан ештеңе келмейді.
Dialogue: 0,0:15:05.66,0:15:08.50,Default,,0,0,0,,Мен басқалармен араласудан бас тарттым.
Dialogue: 0,0:15:08.50,0:15:12.94,Default,,0,0,0,,Шынымды айтсам, мен көп есейдім деп ойладым.
Dialogue: 0,0:15:12.94,0:15:16.61,Default,,0,0,0,,Бірақ онымен танысқанда ол өте адал жігіт.
Dialogue: 0,0:15:16.61,0:15:20.95,Default,,0,0,0,,Күлімдеген жүзді көргенде жаман болған жоқ.
Dialogue: 0,0:15:20.95,0:15:24.12,Default,,0,0,0,,Осы жігіт үшін болса жақсы болар еді деп ойладым.
Dialogue: 0,0:15:24.12,0:15:27.12,Default,,0,0,0,,Мен бала кезімнен шешімдімін.
Dialogue: 0,0:15:27.12,0:15:30.62,Default,,0,0,0,,Мен өмірімді сүйіспеншілікпен өткізгенім соншалық, кез келген сәтте өлсем де, өкінбеймін.
Dialogue: 0,0:15:30.62,0:15:34.29,Default,,0,0,0,,Мен шындап солай ойладым.
Dialogue: 0,0:15:34.29,0:15:39.63,Default,,0,0,0,,Уақыты келгенде, бұлыңғыр болғаныма таң қалдым.
Dialogue: 0,0:15:39.63,0:15:45.80,Default,,0,0,0,,Өлгім келмеді, енді ойладым.
Dialogue: 0,0:15:45.80,0:15:47.81,Default,,0,0,0,,(Тыныс алу)
Dialogue: 0,0:15:47.81,0:15:50.98,Default,,0,0,0,,Сәлем, Азуки-чан! (Осы үй) Тыңда мені, адал жігіт!
Dialogue: 0,0:15:50.98,0:15:55.31,Default,,0,0,0,,А, ол жаңа ғана келді. (2 адам) Иә!?
Dialogue: 0,0:15:55.31,0:15:57.82,Default,,0,0,0,,Мен ол үшін бәрін төледім.
Dialogue: 0,0:15:57.82,0:16:01.52,Default,,0,0,0,,Ол мүлдем тән емес көрінді, бірақ...
Dialogue: 0,0:16:07.66,0:16:09.66,Default,,0,0,0,,Тікенектер?
Dialogue: 0,0:16:14.60,0:16:17.77,Default,,0,0,0,,Ах! Көктем аға
Dialogue: 0,0:16:17.77,0:16:21.61,Default,,0,0,0,,Мен су айдаһарымын...
Dialogue: 0,0:16:21.61,0:16:25.28,Default,,0,0,0,,《Хару-ни, сен Юкитоны байқадың...》
Dialogue: 0,0:16:25.28,0:16:27.78,Default,,0,0,0,,Сіз не істейсіз? Юкито-кун
Dialogue: 0,0:16:27.78,0:16:30.18,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,0:16:36.45,0:16:39.29,Default,,0,0,0,,Эвакуация Жақсы өтіп жатқан сияқты.
Dialogue: 0,0:16:39.29,0:16:42.69,Default,,0,0,0,,Хахаха... Мен де қашып кеттім~
Dialogue: 0,0:16:45.63,0:16:47.80,Default,,0,0,0,,Сәлем, ұстаз
Dialogue: 0,0:16:47.80,0:16:51.80,Default,,0,0,0,,Мен сияқты емес, бірақ бұл арал мен Юкито үшін.
Dialogue: 0,0:16:51.80,0:16:53.97,Default,,0,0,0,,Мен сол техниканы орындауға түрткі болдым.
Dialogue: 0,0:16:53.97,0:16:58.14,Default,,0,0,0,,Осы мақсатта жасырын түрде әдіс-тәсілдерді үйреніп, зерттедім.
Dialogue: 0,0:16:58.14,0:17:00.98,Default,,0,0,0,,Өйткені біз қашан өлетінімізді білмейміз
Dialogue: 0,0:17:00.98,0:17:03.81,Default,,0,0,0,,Барынша өкініштен аулақ болуға тырысыңыз
Dialogue: 0,0:17:03.81,0:17:07.01,Default,,0,0,0,,Мен басқалардан күтпеген өмір сүрдім...
Dialogue: 0,0:17:09.49,0:17:12.26,Default,,0,0,0,,Бірақ мен Юкитомен қайта кездескенімде,
Dialogue: 0,0:17:12.26,0:17:16.59,Default,,0,0,0,,Әйтеуір, мен оның қожайыны болып жүргенімде,
Dialogue: 0,0:17:16.59,0:17:21.60,Default,,0,0,0,,Ол маған үмітпен қарай бастады.
Dialogue: 0,0:17:21.60,0:17:24.44,Default,,0,0,0,,Мен ақымақ сияқты қылсаң да
Dialogue: 0,0:17:24.44,0:17:27.77,Default,,0,0,0,,Негізі сен маған сеніп қойғансың...
Dialogue: 0,0:17:27.77,0:17:31.44,Default,,0,0,0,,Өкінбей өмір сүрсем де.
Dialogue: 0,0:17:31.44,0:17:35.95,Default,,0,0,0,,Сен менің өкінішім болған соң мен не істеуім керек?
Dialogue: 0,0:17:35.95,0:17:38.95,Default,,0,0,0,,Мастер керемет
Dialogue: 0,0:17:38.95,0:17:41.62,Default,,0,0,0,,Сондай-ақ, Хару-ни және Шу-нии
Dialogue: 0,0:17:41.62,0:17:45.12,Default,,0,0,0,,Мен отты айдаһар туралы бірдеңе жасауға тырысамын, тіпті бұл менің өмірім үшін қымбат болса да.
Dialogue: 0,0:17:45.12,0:17:50.13,Default,,0,0,0,,Мен ешқашан қожайыным мен ағаларымдай болмаймын.
Dialogue: 0,0:17:50.13,0:17:53.96,Default,,0,0,0,,Бірақ... бұл шынымен де қорқынышты.
Dialogue: 0,0:17:53.96,0:17:56.30,Default,,0,0,0,,Менің өлгім келмейді
Dialogue: 0,0:17:56.30,0:17:58.30,Default,,0,0,0,,Мен де осы арал туралы.
Dialogue: 0,0:17:58.30,0:18:01.64,Default,,0,0,0,,Сондай-ақ, сәтсіз шәкірті және інісі Юкито туралы.
Dialogue: 0,0:18:01.64,0:18:06.14,Default,,0,0,0,,Неге екені белгісіз, бұл маған қатты ұнайды.
Dialogue: 0,0:18:06.14,0:18:10.94,Default,,0,0,0,,Сонымен... мен кетуім керек))
Dialogue: 0,0:18:13.92,0:18:17.59,Default,,0,0,0,,Цзинги мырза... Осы уақытқа дейін қайда болдың?
Dialogue: 0,0:18:17.59,0:18:22.26,Default,,0,0,0,,Жоқ, өзімді жинауға біраз уақыт керек.
Dialogue: 0,0:18:22.26,0:18:24.76,Default,,0,0,0,,Иә? Сәлем Юкито
Dialogue: 0,0:18:24.76,0:18:28.93,Default,,0,0,0,,Су айдаһарының күшін қайта алғыңыз келе ме?
Dialogue: 0,0:18:28.93,0:18:31.10,Default,,0,0,0,,Джинги мырза, сіз... білесіз бе?
Dialogue: 0,0:18:31.10,0:18:33.44,Default,,0,0,0,,Қаласаң мен сені қайтарамын.
Dialogue: 0,0:18:33.44,0:18:37.61,Default,,0,0,0,,Мен мұны қалай жасау керектігін білемін.
Dialogue: 0,0:18:37.61,0:18:43.61,Default,,0,0,0,,Мен осы аралды және осы аралда тұратын адамдарды қорғағым келеді.
Dialogue: 0,0:18:43.61,0:18:49.45,Default,,0,0,0,,Егер менде бұл күш шынымен болса, мен оны қайтарғым келеді!
Dialogue: 0,0:18:49.45,0:18:52.29,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:52.29,0:18:54.63,Default,,0,0,0,,Сіз не істейсіз...
Dialogue: 0,0:18:54.63,0:18:57.43,Default,,0,0,0,,Сәлем! От айдаһар қайтадан қозғалады!
Dialogue: 0,0:19:00.63,0:19:02.80,Default,,0,0,0,,Фалкооо!! Қайдасыңңң!!
Dialogue: 0,0:19:02.80,0:19:05.64,Default,,0,0,0,,Бұлай айтқаныңызға қуаныштымын.
Dialogue: 0,0:19:05.64,0:19:07.81,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:19:07.81,0:19:10.41,Default,,0,0,0,,Келіңіздер, бізге келіңіздер!
Dialogue: 0,0:19:10.41,0:19:14.24,Default,,0,0,0,,Масато Янаги - Мананың осы Сагава Джинёшидің тікелей шәкірті.
Dialogue: 0,0:19:14.24,0:19:18.14,Default,,0,0,0,,Мен сізге соңғы тамыр егу техникасын көрсетемін!
Dialogue: 0,0:19:23.25,0:19:27.25,Default,,0,0,0,,Мен бұны күтпедім...!? Тоқта!
Dialogue: 0,0:19:31.10,0:19:33.10,Default,,0,0,0,,Уау!?
Dialogue: 0,0:19:33.10,0:19:43.27,Default,,0,0,0,,♪～
Dialogue: 0,0:19:43.27,0:19:46.44,Default,,0,0,0,,Бұл... өмірлік арқау
Dialogue: 0,0:19:46.44,0:19:51.45,Default,,0,0,0,,Су айдаһарының күшін жоғалтқаннан кейін бұрынғы күшін қалай қалпына келтіруге болады
Dialogue: 0,0:19:51.45,0:19:56.29,Default,,0,0,0,,Ұлы байланыс арқылы су айдаһарының жаны мен өмірі
Dialogue: 0,0:19:56.29,0:19:59.12,Default,,0,0,0,,Оларды қосу керек.
Dialogue: 0,0:19:59.12,0:20:02.46,Default,,0,0,0,,Керемет байланыс...? Не?
Dialogue: 0,0:20:02.46,0:20:04.96,Default,,0,0,0,,Бұл аз ғана тамаша.
Dialogue: 0,0:20:04.96,0:20:06.96,Default,,0,0,0,,Бұл жеткіліксіз болуы мүмкін, бірақ
Dialogue: 0,0:20:06.96,0:20:10.97,Default,,0,0,0,,Менде күшті су рухы бар, мен сенімен үйлесімдімін.
Dialogue: 0,0:20:10.97,0:20:14.30,Default,,0,0,0,,Сіз мұны істей алмайсыз. Бұл туралы ...
Dialogue: 0,0:20:14.30,0:20:18.00,Default,,0,0,0,,Сондықтан Юкито. Ұшуға тырысу керек. иә?
Dialogue: 0,0:20:23.81,0:20:27.48,Default,,0,0,0,,Оны көп айтпа. Уайымдама.
Dialogue: 0,0:20:27.48,0:20:29.82,Default,,0,0,0,,Мен де сенімен бірге барамын.
Dialogue: 0,0:20:29.82,0:20:32.66,Default,,0,0,0,,Күте тұрыңыз, Цюёси мырза
Dialogue: 0,0:20:32.66,0:20:35.66,Default,,0,0,0,,Делдал болу деген нені білдіреді?
Dialogue: 0,0:20:35.66,0:20:38.66,Default,,0,0,0,,Сіз де әңгімені естіген шығарсыз.
Dialogue: 0,0:20:38.66,0:20:41.00,Default,,0,0,0,,Аяка аралы туралы аңыз
Dialogue: 0,0:20:41.00,0:20:45.84,Default,,0,0,0,,Баяғыда бұл аралға өз өмірін айырбастау үшін бір ұлы гермит келді.
Dialogue: 0,0:20:45.84,0:20:49.34,Default,,0,0,0,,Әлсіреген су айдаһарын тірілткен.
Dialogue: 0,0:20:49.34,0:20:52.68,Default,,0,0,0,,Джи... Джинги мырза! Міне бітті!
Dialogue: 0,0:20:52.68,0:20:55.68,Default,,0,0,0,,Мен саған өмірімді беремін
Dialogue: 0,0:20:55.68,0:21:01.19,Default,,0,0,0,,Олай болса, осы аралды қорғаңыз.
Dialogue: 0,0:21:01.19,0:21:03.19,Default,,0,0,0,,Күте тұрыңыз! Арнау…
Dialogue: 0,0:21:03.19,0:21:07.69,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:21:07.69,0:21:40.82,Default,,0,0,0,,♪～
Dialogue: 0,0:21:40.82,0:21:43.82,Default,,0,0,0,,Шаршау... әділдік...
Dialogue: 0,0:21:49.33,0:21:51.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:51.34,0:22:02.01,Default,,0,0,0,,♪～
Dialogue: 0,0:22:02.01,0:22:04.18,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:22:04.18,0:22:16.13,Default,,0,0,0,,♪～
Dialogue: 0,0:22:16.13,0:22:19.93,Default,,0,0,0,,(Өрт айдаһарының айқайы)
Dialogue: 0,0:22:21.43,0:22:27.43,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
