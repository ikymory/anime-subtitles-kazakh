Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.29,0:00:02.62,Default,,0,0,0,,Фу…
Dialogue: 0,0:00:04.67,0:00:06.79,Default,,0,0,0,,Балық шыңыраудан қашады...
Dialogue: 0,0:00:07.34,0:00:08.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:08.92,0:00:10.59,Default,,0,0,0,,Қашып кетпеу керек
Dialogue: 0,0:00:10.92,0:00:12.80,Default,,0,0,0,,Қашып кетпеу керек
Dialogue: 0,0:00:16.26,0:00:19.39,Default,,0,0,0,,Жарайды, солай.
Dialogue: 0,0:00:20.18,0:00:23.23,Default,,0,0,0,,Әдетте, біз алдымен өмір энергиясының ағынын сезінеміз.
Dialogue: 0,0:00:23.31,0:00:25.73,Default,,0,0,0,,Суырып алудан бастаңыз...
Dialogue: 0,0:00:25.81,0:00:27.82,Default,,0,0,0,,Сіздің жағдайыңызда бұл керісінше.
Dialogue: 0,0:00:28.40,0:00:31.11,Default,,0,0,0,,Өмірлік энергияның сыртқа ағып кетуіне жол бермеңіз
Dialogue: 0,0:00:31.19,0:00:33.20,Default,,0,0,0,,Мен бақылауға назар аударамын.
Dialogue: 0,0:00:33.28,0:00:34.66,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:00:35.28,0:00:36.12,Default,,0,0,0,,Қараңызшы (Юкито) Иә?
Dialogue: 0,0:00:36.20,0:00:37.70,Default,,0,0,0,,Қарсылықты да көрсетіңіз.
Dialogue: 0,0:00:38.33,0:00:39.62,Default,,0,0,0,,Жоқ...?
Dialogue: 0,0:00:39.70,0:00:40.75,Default,,0,0,0,,Көңілді өтіңіз
Dialogue: 0,0:00:40.83,0:00:42.33,Default,,0,0,0,,О, күте тұрыңыз... (Цзинги) Йотто!
Dialogue: 0,0:00:42.41,0:00:44.33,Default,,0,0,0,,Ауыр…
Dialogue: 0,0:00:44.42,0:00:47.04,Default,,0,0,0,,Жалғасын қараңыз
Dialogue: 0,0:00:47.13,0:00:49.88,Default,,0,0,0,,Ху... бақытсыздықтың сауытымен...
Dialogue: 0,0:00:49.96,0:00:51.67,Default,,0,0,0,,... адамдарға...
Dialogue: 0,0:00:51.76,0:00:53.26,Default,,0,0,0,,көрсетілмеуі керек
Dialogue: 0,0:00:53.34,0:00:55.01,Default,,0,0,0,,көрсету керек...
Dialogue: 0,0:00:55.09,0:00:58.10,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:00:59.51,0:01:00.51,Default,,0,0,0,,Ха…
Dialogue: 0,0:01:00.60,0:01:01.85,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:01:03.27,0:01:05.48,Default,,0,0,0,,Уау... (Юкито) Уау!
Dialogue: 0,0:01:05.56,0:01:06.98,Default,,0,0,0,,Қосымша
Dialogue: 0,0:01:14.11,0:01:15.03,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:15.11,0:01:18.66,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:01:20.20,0:01:23.04,Default,,0,0,0,,Осы сатыға разы емессің бе?
Dialogue: 0,0:01:23.12,0:01:25.21,Default,,0,0,0,,О, дірілдеп кетті.
Dialogue: 0,0:01:25.29,0:01:26.62,Default,,0,0,0,,Хмм…
Dialogue: 0,0:01:31.38,0:01:33.34,Default,,0,0,0,,Өте…
Dialogue: 0,0:01:33.42,0:01:35.42,Default,,0,0,0,,Кешіріңіз, басқару элементтері істен шыққан.
Dialogue: 0,0:01:36.59,0:01:39.26,Default,,0,0,0,,Бұл дәл қазір жұмыс істейтін сияқты болды.
Dialogue: 0,0:01:39.35,0:01:42.85,Default,,0,0,0,,Жер сілкінісі сияқты бір нәрсе мені шошытады. Менің жаттығуларым жеткіліксіз.
Dialogue: 0,0:01:42.93,0:01:45.94,Default,,0,0,0,,Менің қорыққаным емес...
Dialogue: 0,0:01:46.02,0:01:47.39,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:01:48.02,0:01:52.78,Default,,0,0,0,,♪～
Dialogue: 0,0:03:11.85,0:03:16.98,Default,,0,0,0,,～♪
Dialogue: 0,0:03:18.61,0:03:22.07,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:03:30.41,0:03:31.83,Default,,0,0,0,,Жер сілкінісі...
Dialogue: 0,0:03:31.92,0:03:33.96,Default,,0,0,0,,Кешегі де үлкен болды.
Dialogue: 0,0:03:34.29,0:03:37.34,Default,,0,0,0,,Иә, Аяка жанартаулық арал.
Dialogue: 0,0:03:37.42,0:03:40.26,Default,,0,0,0,,Бұл қорқынышты емес пе?
Dialogue: 0,0:03:40.34,0:03:42.18,Default,,0,0,0,,Елордада тұру
Dialogue: 0,0:03:42.26,0:03:45.72,Default,,0,0,0,,Уайымдамаңыз, төтенше жағдайда бәріміз эвакуациялаймыз.
Dialogue: 0,0:03:45.80,0:03:47.18,Default,,0,0,0,,Апаттың алдын алуға арналған рюкзак...
Dialogue: 0,0:03:47.26,0:03:48.31,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:03:48.39,0:03:50.73,Default,,0,0,0,,Әр адамға дулыға жеткілікті.
Dialogue: 0,0:03:50.81,0:03:51.64,Default,,0,0,0,,А...
Dialogue: 0,0:03:51.73,0:03:53.40,Default,,0,0,0,,Момоко-сан
Dialogue: 0,0:03:53.48,0:03:55.19,Default,,0,0,0,,Момоко-сан
Dialogue: 0,0:03:55.27,0:03:57.86,Default,,0,0,0,,О, сен бүгін таңертең ерте келдің.
Dialogue: 0,0:03:57.94,0:04:00.57,Default,,0,0,0,,Одан да дәл қазір дірілдеп кетті, солай ма?
Dialogue: 0,0:04:00.65,0:04:02.11,Default,,0,0,0,,Қайтадан дірілдеп кетті, солай ма?
Dialogue: 0,0:04:02.20,0:04:05.03,Default,,0,0,0,,Бұл біраз уақытқа созылады.
Dialogue: 0,0:04:05.49,0:04:08.16,Default,,0,0,0,,Ал, маған ішімдікке ақша беріңізші.
Dialogue: 0,0:04:08.24,0:04:09.29,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:04:09.37,0:04:11.29,Default,,0,0,0,,Е...күте...күте!
Dialogue: 0,0:04:11.37,0:04:12.37,Default,,0,0,0,,Иә.
Dialogue: 0,0:04:12.71,0:04:15.29,Default,,0,0,0,,Неліктен? Неліктен бұлай?
Dialogue: 0,0:04:15.38,0:04:16.71,Default,,0,0,0,,(Косей) Сен балалармен тез тіл табысасың ғой, иә?
Dialogue: 0,0:04:17.13,0:04:20.05,Default,,0,0,0,,Иә, Джинги-чан, Янаги-сенсэйге сәлем айтыңызшы.
Dialogue: 0,0:04:20.13,0:04:21.17,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:04:21.26,0:04:23.55,Default,,0,0,0,,Не? Янаги мырза...
Dialogue: 0,0:04:23.63,0:04:25.72,Default,,0,0,0,,Мен оны жегеннен кейін барамын, Юкито.
Dialogue: 0,0:04:26.10,0:04:28.43,Default,,0,0,0,,Бүгін мен қожайынның бейітіне барамын.
Dialogue: 0,0:04:33.39,0:04:36.02,Default,,0,0,0,,Тексер, сен қыңырсың.
Dialogue: 0,0:04:36.11,0:04:38.40,Default,,0,0,0,,Өйткені бұл бастапқыда Момоконың ақшасы болатын.
Dialogue: 0,0:04:38.48,0:04:41.86,Default,,0,0,0,,Мен сізге арзан заттарды сатып алу арқылы ақша алуға тырысуға рұқсат бермеймін.
Dialogue: 0,0:04:41.94,0:04:43.03,Default,,0,0,0,,Сараң!
Dialogue: 0,0:04:43.11,0:04:44.11,Default,,0,0,0,,Қайсысы...
Dialogue: 0,0:04:44.20,0:04:45.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:48.33,0:04:49.45,Default,,0,0,0,,Осының үстінде.
Dialogue: 0,0:04:49.54,0:04:51.54,Default,,0,0,0,,Ах... Митама тағы да
Dialogue: 0,0:04:51.62,0:04:53.83,Default,,0,0,0,,Молаларға оңай жиналып қалады, т.б.
Dialogue: 0,0:04:54.21,0:04:55.96,Default,,0,0,0,,Мен мұнда келдім
Dialogue: 0,0:04:59.92,0:05:00.84,Default,,0,0,0,,Жарайды
Dialogue: 0,0:05:00.92,0:05:03.63,Default,,0,0,0,,Оны тазалаймыз ба?
Dialogue: 0,0:05:09.10,0:05:10.60,Default,,0,0,0,,Қараңызшы, Юкито да.
Dialogue: 0,0:05:10.68,0:05:12.18,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:05:13.27,0:05:14.10,Default,,0,0,0,,…және
Dialogue: 0,0:05:16.48,0:05:18.44,Default,,0,0,0,,Сәлеметсіз бе, Ұстаз!
Dialogue: 0,0:05:18.52,0:05:20.86,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:05:21.44,0:05:22.48,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:05:22.57,0:05:23.99,Default,,0,0,0,,Оны көргенде білесің
Dialogue: 0,0:05:24.07,0:05:27.03,Default,,0,0,0,,Әкеңнің бейітін зиярат ету
Dialogue: 0,0:05:27.11,0:05:29.16,Default,,0,0,0,,менің әкем
Dialogue: 0,0:05:32.66,0:05:34.50,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:05:34.58,0:05:36.75,Default,,0,0,0,,Жер сілкінісі болған кезде адамдар неліктен қабірге барады?
Dialogue: 0,0:05:36.83,0:05:38.67,Default,,0,0,0,,О, Джинги-чан
Dialogue: 0,0:05:38.75,0:05:40.00,Default,,0,0,0,,Бұл келе жатыр еді.
Dialogue: 0,0:05:40.09,0:05:41.80,Default,,0,0,0,,Аякайва
Dialogue: 0,0:05:41.88,0:05:43.92,Default,,0,0,0,,Сіз кімсіз, апайлар?
Dialogue: 0,0:05:44.01,0:05:46.63,Default,,0,0,0,,Кеше біраз дірілдеп тұрды.
Dialogue: 0,0:05:46.72,0:05:50.64,Default,,0,0,0,,Мен От Айдаһар Құдайының көңіл-күйі нашар ма деп ойладым.
Dialogue: 0,0:05:50.72,0:05:53.06,Default,,0,0,0,,Янаги-сенсэйден жақсылап сұраңыз.
Dialogue: 0,0:05:53.14,0:05:55.14,Default,,0,0,0,,Аралды қорғау керек.
Dialogue: 0,0:05:55.23,0:05:59.69,Default,,0,0,0,,Ой, ондай нәрсе менің басымнан өтуі керек, шәкіртім.
Dialogue: 0,0:05:59.77,0:06:02.07,Default,,0,0,0,,Ағай, ішімдік осында.
Dialogue: 0,0:06:02.52,0:06:04.69,Default,,0,0,0,,Апай, мен сізге тағамдар алып берейін.
Dialogue: 0,0:06:04.78,0:06:07.45,Default,,0,0,0,,Мен алдымен мұғалімге ұсыныс жасауым керек.
Dialogue: 0,0:06:07.53,0:06:08.91,Default,,0,0,0,,Аяғыңды тез жазып алғаның жөн.
Dialogue: 0,0:06:08.99,0:06:11.87,Default,,0,0,0,,Джинги-чан шынымен тәтті.
Dialogue: 0,0:06:11.95,0:06:13.66,Default,,0,0,0,,Аякай Аякай
Dialogue: 0,0:06:13.74,0:06:14.58,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,0:06:13.74,0:06:16.62,Default,,0,0,0,,Ахаха... Аяқай...
Dialogue: 0,0:06:14.66,0:06:16.62,Default,,0,0,0,,Дұрыс, мен тәттімін.
Dialogue: 0,0:06:16.71,0:06:17.66,Default,,0,0,0,,Қарашы, Юкито
Dialogue: 0,0:06:17.75,0:06:20.13,Default,,0,0,0,,Тұрма, сен де қосыл.
Dialogue: 0,0:06:20.21,0:06:21.92,Default,,0,0,0,,Е... иә
Dialogue: 0,0:06:22.00,0:06:25.55,Default,,0,0,0,,О, Юкито-чан сондай үлкен болып кеткен.
Dialogue: 0,0:06:25.63,0:06:27.38,Default,,0,0,0,,Аякайва
Dialogue: 0,0:06:27.47,0:06:28.63,Default,,0,0,0,,Мен және ұлым
Dialogue: 0,0:06:28.72,0:06:31.55,Default,,0,0,0,,Бұл бала ішімдік ішетін жаста.
Dialogue: 0,0:06:31.64,0:06:32.97,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:06:33.06,0:06:34.68,Default,,0,0,0,,Қараңыз (Юкито) Мен іше алмаймын.
Dialogue: 0,0:06:34.77,0:06:36.39,Default,,0,0,0,,Менің жасым небәрі 15-те.
Dialogue: 0,0:06:36.89,0:06:38.98,Default,,0,0,0,,Техникамды қолдансам да кесіп өте алмаймын.
Dialogue: 0,0:06:39.06,0:06:41.81,Default,,0,0,0,,Содан бері 10 жыл өтті ме?
Dialogue: 0,0:06:42.31,0:06:45.86,Default,,0,0,0,,Сол үлкен атқылау кезінде профессор Янагидің арқасында болды.
Dialogue: 0,0:06:45.94,0:06:47.99,Default,,0,0,0,,үшін құтқарылды деп үміттенемін.
Dialogue: 0,0:06:48.07,0:06:52.70,Default,,0,0,0,,Әкем не істеді?
Dialogue: 0,0:06:52.78,0:06:54.58,Default,,0,0,0,,О, сен білмейсің бе?
Dialogue: 0,0:06:54.66,0:06:56.75,Default,,0,0,0,,Жоқ, Джинги-чан
Dialogue: 0,0:06:56.83,0:06:59.46,Default,,0,0,0,,Мен саған әкем туралы айтуым керек.
Dialogue: 0,0:06:59.54,0:07:04.29,Default,,0,0,0,,А, мен бұл күрделі оқиға деп ойладым.
Dialogue: 0,0:07:04.38,0:07:05.67,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:07:08.26,0:07:09.13,Default,,0,0,0,,Юкито
Dialogue: 0,0:07:09.22,0:07:13.85,Default,,0,0,0,,Мен Харуни ғибадатханасында екі айдаһардың ғибадат еткенін естідім.
Dialogue: 0,0:07:13.93,0:07:15.31,Default,,0,0,0,,А... иә
Dialogue: 0,0:07:15.39,0:07:17.52,Default,,0,0,0,,Есімде дұрыс болса, отты айдаһар...
Dialogue: 0,0:07:17.93,0:07:19.43,Default,,0,0,0,,Су айдаһары
Dialogue: 0,0:07:19.52,0:07:22.86,Default,,0,0,0,,Соңғы жер сілкінісі от айдаһарының әсерінен болды.
Dialogue: 0,0:07:22.94,0:07:25.94,Default,,0,0,0,,Жалын боялған өмірдің ұлы ағымы
Dialogue: 0,0:07:26.32,0:07:28.19,Default,,0,0,0,,Оның күші тым күшті болды
Dialogue: 0,0:07:28.28,0:07:30.28,Default,,0,0,0,,Аяка аралы аралдарының астында
Dialogue: 0,0:07:30.36,0:07:33.57,Default,,0,0,0,,Бұл жанартау белсенділігі артып келе жатқанын білдіреді.
Dialogue: 0,0:07:33.95,0:07:37.79,Default,,0,0,0,,Олай болса, ең бірінші себеп неде?
Dialogue: 0,0:07:37.87,0:07:41.62,Default,,0,0,0,,От айдаһар неліктен күшейді?
Dialogue: 0,0:07:41.71,0:07:42.67,Default,,0,0,0,,О
Dialogue: 0,0:07:42.75,0:07:45.29,Default,,0,0,0,,Оқиға 15 жыл бұрын болған
Dialogue: 0,0:07:45.38,0:07:49.51,Default,,0,0,0,,Шиносимадағы көл кенеттен толығымен құрғап қалды.
Dialogue: 0,0:07:50.17,0:07:51.68,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:07:51.76,0:07:55.76,Default,,0,0,0,,От айдаһарымен жұптасатын су айдаһары жоғалып кетті.
Dialogue: 0,0:07:56.56,0:07:59.22,Default,,0,0,0,,Екі айдаһардың бірі жоғалып кетті.
Dialogue: 0,0:07:59.31,0:08:03.60,Default,,0,0,0,,Ауытқу таразы сияқты от пен судың тепе-теңдігі бұзыла бастады.
Dialogue: 0,0:08:03.69,0:08:05.81,Default,,0,0,0,,Отты айдаһар енді үйлесімді емес.
Dialogue: 0,0:08:05.90,0:08:08.44,Default,,0,0,0,,Тіршілік күші барған сайын тоқырауға ұшырайды.
Dialogue: 0,0:08:08.82,0:08:11.36,Default,,0,0,0,,Митама Арамитамаға айналады.
Dialogue: 0,0:08:11.70,0:08:15.24,Default,,0,0,0,,Бұлай жалғаса берсе, Шиносимадағы жанартау ақыры жарылып кетеді.
Dialogue: 0,0:08:15.32,0:08:18.12,Default,,0,0,0,,Аяка аралдары толығымен батып кетті.
Dialogue: 0,0:08:18.91,0:08:23.17,Default,,0,0,0,,Мен ойлағанымдай, бұл 10 жыл бұрынғы үлкен атқылау болып шықты.
Dialogue: 0,0:08:24.96,0:08:30.84,Default,,0,0,0,,Бұл туралы бірдеңе жасай алған адам біздің қожайынымыз, ұлы гермит Масато Янаги болды.
Dialogue: 0,0:08:34.26,0:08:37.35,Default,,0,0,0,,Қожайын айдаһар құдайын тыныштандыру үшін ырым жасады.
Dialogue: 0,0:08:37.43,0:08:41.60,Default,,0,0,0,,Табиғаттың құдіреті деуге болатын отты айдаһардың күші.
Dialogue: 0,0:08:41.68,0:08:43.64,Default,,0,0,0,,адам ағзасында басылады
Dialogue: 0,0:08:43.73,0:08:46.15,Default,,0,0,0,,Бұл да жалғыз.
Dialogue: 0,0:08:46.65,0:08:50.07,Default,,0,0,0,,Содан бері 10 жыл өтті, бұл аралда тыныштық сақталды.
Dialogue: 0,0:08:50.15,0:08:52.65,Default,,0,0,0,,Мұның бәрі қожайынымның арқасы.
Dialogue: 0,0:08:52.74,0:08:53.74,Default,,0,0,0,,Ал...
Dialogue: 0,0:08:53.82,0:08:56.07,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:08:56.16,0:08:57.03,Default,,0,0,0,,Хехе
Dialogue: 0,0:08:57.12,0:09:00.37,Default,,0,0,0,,Сенің әкең аралдың үлкен қайырымды адамы.
Dialogue: 0,0:09:00.45,0:09:02.16,Default,,0,0,0,,Ол тірі құдай.
Dialogue: 0,0:09:03.91,0:09:05.54,Default,,0,0,0,,Ол қайтыс болды.
Dialogue: 0,0:09:05.62,0:09:06.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:06.58,0:09:07.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:08.54,0:09:10.50,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:09:11.00,0:09:14.88,Default,,0,0,0,,Мен оның өлгенін мүлде сезбеймін.
Dialogue: 0,0:09:14.97,0:09:17.18,Default,,0,0,0,,Бұл мұғалім.
Dialogue: 0,0:09:17.26,0:09:19.64,Default,,0,0,0,,Ол шынымен де біртүрлі адам еді.
Dialogue: 0,0:09:19.72,0:09:21.72,Default,,0,0,0,,Адамдармен не болады?
Dialogue: 0,0:09:21.81,0:09:23.56,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:09:23.64,0:09:25.31,Default,,0,0,0,,Ах (апалардың күлкісі)
Dialogue: 0,0:09:26.10,0:09:28.44,Default,,0,0,0,,Ол шынымен де біртүрлі адам еді ғой?
Dialogue: 0,0:09:28.52,0:09:30.44,Default,,0,0,0,,Аякай Аякай
Dialogue: 0,0:09:30.52,0:09:32.48,Default,,0,0,0,,Өте қараңғы
Dialogue: 0,0:09:32.57,0:09:34.57,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:09:34.95,0:09:37.07,Default,,0,0,0,,Мен әлі де сенімді емеспін
Dialogue: 0,0:09:37.16,0:09:40.20,Default,,0,0,0,,Әкем керемет адам болса керек.
Dialogue: 0,0:09:40.28,0:09:41.70,Default,,0,0,0,,Сәлем, Цуёси мырза
Dialogue: 0,0:09:45.04,0:09:46.42,Default,,0,0,0,,Цзинги мырза?
Dialogue: 0,0:09:47.33,0:09:49.75,Default,,0,0,0,,О, Юкито, не болды? Не болды?
Dialogue: 0,0:09:49.84,0:09:51.25,Default,,0,0,0,,Мұнда көбірек ішіңіз.
Dialogue: 0,0:09:51.34,0:09:52.55,Default,,0,0,0,,Сондықтан олар жауапкершілікті маған жүктеді.
Dialogue: 0,0:09:52.63,0:09:54.76,Default,,0,0,0,,Сондықтан мен кәмелетке толмағанмын...
Dialogue: 0,0:09:54.84,0:09:55.67,Default,,0,0,0,,Ах
Dialogue: 0,0:09:56.84,0:09:58.68,Default,,0,0,0,,А... анау қыз
Dialogue: 0,0:09:59.26,0:10:01.51,Default,,0,0,0,,Мен Ayaka Security компаниясына сенемін.
Dialogue: 0,0:10:01.85,0:10:03.89,Default,,0,0,0,,Әй, тікенек емес пе?
Dialogue: 0,0:10:03.97,0:10:04.98,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:10:05.06,0:10:07.81,Default,,0,0,0,,Ичиджо Ибара, жақынырақ кел.
Dialogue: 0,0:10:07.89,0:10:09.94,Default,,0,0,0,,Әй, бізде де ішімдік бар.
Dialogue: 0,0:10:10.02,0:10:11.86,Default,,0,0,0,,Алкоголь Алкоголь бар. Алкоголь.
Dialogue: 0,0:10:11.94,0:10:13.15,Default,,0,0,0,,Сәке Сәке... (Юкито) А...
Dialogue: 0,0:10:13.23,0:10:14.53,Default,,0,0,0,,Мен кеттім.
Dialogue: 0,0:10:14.61,0:10:18.45,Default,,0,0,0,,Иә? О, мен бүгін...
Dialogue: 0,0:10:18.53,0:10:20.24,Default,,0,0,0,,Бұл жігіт абайсызда болды.
Dialogue: 0,0:10:20.32,0:10:21.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:23.24,0:10:25.41,Default,,0,0,0,,Ұстаз, менімен бөлісіңіз.
Dialogue: 0,0:10:28.58,0:10:29.96,Default,,0,0,0,,Бұл қабір...
Dialogue: 0,0:10:30.04,0:10:32.17,Default,,0,0,0,,Ибаранчи бейіті
Dialogue: 0,0:10:32.25,0:10:34.76,Default,,0,0,0,,Бүгін ата-анасының қайтыс болғанына жыл.
Dialogue: 0,0:10:35.21,0:10:37.17,Default,,0,0,0,,Ол өлді ме?
Dialogue: 0,0:10:37.26,0:10:38.59,Default,,0,0,0,,О
Dialogue: 0,0:10:38.68,0:10:42.97,Default,,0,0,0,,Ағай, апай, осындай шу шығарғаным үшін кешіріңіз.
Dialogue: 0,0:10:43.06,0:10:45.18,Default,,0,0,0,,Менің ұстазым маған сабақ берді.
Dialogue: 0,0:10:45.77,0:10:46.85,Default,,0,0,0,,Сондай күні...
Dialogue: 0,0:10:46.93,0:10:51.31,Default,,0,0,0,,Ичидзо-сан, біз шу шығардық деп ашуландың ба?
Dialogue: 0,0:10:51.40,0:10:53.07,Default,,0,0,0,,Иә? Саана
Dialogue: 0,0:10:53.15,0:10:55.61,Default,,0,0,0,,Кішкене ойланып көрейік...
Dialogue: 0,0:10:55.69,0:10:56.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:58.28,0:10:59.65,Default,,0,0,0,,Бұл...
Dialogue: 0,0:11:07.20,0:11:10.83,Default,,0,0,0,,Кешіріңіз, Цуйоши мырза, мен сізбен кездесу үшін барын салдым.
Dialogue: 0,0:11:10.92,0:11:13.46,Default,,0,0,0,,Бұл кешірім сұраудың қажеті жоқ.
Dialogue: 0,0:11:13.84,0:11:16.80,Default,,0,0,0,,Ондай шағымды тікенді жігітке айтамын.
Dialogue: 0,0:11:16.88,0:11:19.67,Default,,0,0,0,,Жоқ, бұлай етпеңіз.
Dialogue: 0,0:11:19.76,0:11:22.05,Default,,0,0,0,,Хаха, әзілдеп тұрмын.
Dialogue: 0,0:11:22.14,0:11:25.39,Default,,0,0,0,,Маған Ичиносимаға келуге жақсы сылтау айтқаныңыз үшін рахмет.
Dialogue: 0,0:11:25.47,0:11:27.89,Default,,0,0,0,,Бұл да байланыс.
Dialogue: 0,0:11:27.97,0:11:31.40,Default,,0,0,0,,Балалар – балалар, бір-бірімен араласқан жақсы.
Dialogue: 0,0:11:31.48,0:11:32.60,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:11:32.69,0:11:36.73,Default,,0,0,0,,Менде жақсы араласуға деген сенім жоқ...
Dialogue: 0,0:11:37.19,0:11:41.32,Default,,0,0,0,,Онсыз да қиындыққа тап боласыз, сондықтан мен оны тез арада сізге жеткізуім керек.
Dialogue: 0,0:11:41.41,0:11:43.53,Default,,0,0,0,,Сәлем Юкито!
Dialogue: 0,0:11:43.62,0:11:46.41,Default,,0,0,0,,Юкито-кун мен Джинёси-сан да.
Dialogue: 0,0:11:46.49,0:11:47.33,Default,,0,0,0,,Ах
Dialogue: 0,0:11:47.41,0:11:49.00,Default,,0,0,0,,О, неткен кездейсоқтық.
Dialogue: 0,0:11:49.08,0:11:51.12,Default,,0,0,0,,...
Dialogue: 0,0:11:51.21,0:11:52.33,Default,,0,0,0,,Бұл Яко!
Dialogue: 0,0:11:52.42,0:11:53.63,Default,,0,0,0,,Бұл Чатаро!
Dialogue: 0,0:11:53.71,0:11:55.75,Default,,0,0,0,,Хахахаха солай
Dialogue: 0,0:11:55.84,0:11:57.92,Default,,0,0,0,,Екеуіңе не болды?
Dialogue: 0,0:11:58.00,0:11:58.88,Default,,0,0,0,,(Яко но Секибараи)
Dialogue: 0,0:11:58.96,0:12:02.59,Default,,0,0,0,,Бүгін таңертеңгі жер сілкінісі аралдардың өмірін бұзды.
Dialogue: 0,0:12:02.68,0:12:06.35,Default,,0,0,0,,Мұғалім маған қаланы аралауды өтінді.
Dialogue: 0,0:12:06.68,0:12:09.52,Default,,0,0,0,,Мәселе емес сияқты.
Dialogue: 0,0:12:09.60,0:12:11.44,Default,,0,0,0,,Сақтықты төмендетпеңіз
Dialogue: 0,0:12:11.52,0:12:13.73,Default,,0,0,0,,Мен айналама қарауым керек.
Dialogue: 0,0:12:13.81,0:12:15.90,Default,,0,0,0,,Бұл да байланыстың міндеті.
Dialogue: 0,0:12:15.98,0:12:17.48,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:12:17.57,0:12:19.23,Default,,0,0,0,,Мүмкін Джинги-сан да шығар...
Dialogue: 0,0:12:21.99,0:12:23.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:23.45,0:12:24.57,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:12:24.66,0:12:26.41,Default,,0,0,0,,Қайда бара жатырсыңдар?
Dialogue: 0,0:12:26.49,0:12:30.41,Default,,0,0,0,,А... Иә, мен жоғалтқан затымды алдым, сондықтан оны жеткіземін.
Dialogue: 0,0:12:30.50,0:12:33.46,Default,,0,0,0,,О, бұл полиция жәшігі. Айтпақшы мен сенімен барамын.
Dialogue: 0,0:12:33.54,0:12:36.29,Default,,0,0,0,,Жоқ, мен оны кім түсіргенін білемін.
Dialogue: 0,0:12:36.38,0:12:39.80,Default,,0,0,0,,Аяка қауіпсіздік ұйымындағы Ичиджо мырза.
Dialogue: 0,0:12:39.88,0:12:40.88,Default,,0,0,0,,Не!
Dialogue: 0,0:12:40.96,0:12:42.38,Default,,0,0,0,,Ичижо тікенектері?
Dialogue: 0,0:12:42.47,0:12:43.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:44.22,0:12:46.89,Default,,0,0,0,,А... онда мұны істейміз.
Dialogue: 0,0:12:46.97,0:12:49.31,Default,,0,0,0,,Дұрыс, мен патрульге бара жатырмын.
Dialogue: 0,0:12:49.39,0:12:50.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:50.77,0:12:52.56,Default,,0,0,0,,Менімен бірге келесіз деп үміттенемін...
Dialogue: 0,0:12:52.64,0:12:56.94,Default,,0,0,0,,Жоқ, жоқ, жоқ, Аяка күзетшісі... Эй.
Dialogue: 0,0:12:57.02,0:13:01.23,Default,,0,0,0,,Ол жерде мұғаліміммен көп нәрсе болып жатыр.
Dialogue: 0,0:13:01.32,0:13:02.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:02.82,0:13:06.07,Default,,0,0,0,,Кешіріңіз, бірақ... Жақында кездескенше, Юкито.
Dialogue: 0,0:13:06.16,0:13:08.74,Default,,0,0,0,,Кешіріңіз, кездескенше.
Dialogue: 0,0:13:10.08,0:13:13.50,Default,,0,0,0,,Мен бұған мүлдем көмектесе алмаймын.
Dialogue: 0,0:13:13.58,0:13:15.46,Default,,0,0,0,,А... бұл да мені білдіре ме?
Dialogue: 0,0:13:15.54,0:13:16.96,Default,,0,0,0,,Сіз де
Dialogue: 0,0:13:22.67,0:13:24.97,Default,,0,0,0,,Осы сатыға разы емессің бе?
Dialogue: 0,0:13:25.05,0:13:26.34,Default,,0,0,0,,О...
Dialogue: 0,0:13:26.97,0:13:28.39,Default,,0,0,0,,Жер сілкінісі жалғасуда
Dialogue: 0,0:13:29.14,0:13:31.60,Default,,0,0,0,,Менің от рухым күшейіп келеді.
Dialogue: 0,0:13:31.68,0:13:35.56,Default,,0,0,0,,Соңғы уақытта Арамитама оқиғаларының саны артып келеді.
Dialogue: 0,0:13:36.14,0:13:39.31,Default,,0,0,0,,Ой, уақыт таяп қалды, бастық.
Dialogue: 0,0:13:39.40,0:13:40.48,Default,,0,0,0,,О
Dialogue: 0,0:13:42.07,0:13:43.61,Default,,0,0,0,,Әкімге сәлем айтыңыз
Dialogue: 0,0:13:44.07,0:13:45.24,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:13:46.20,0:13:48.16,Default,,0,0,0,,Йо, аға Жу.
Dialogue: 0,0:13:48.24,0:13:49.70,Default,,0,0,0,,Кете барсам, қоштасу сүйісін бересің бе?
Dialogue: 0,0:13:50.33,0:13:51.37,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:51.45,0:13:54.79,Default,,0,0,0,,Себебі мен сол жоғалған затты алдым.
Dialogue: 0,0:13:55.79,0:13:57.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:57.08,0:13:58.92,Default,,0,0,0,,Кикеда әңгімені тыңдайды.
Dialogue: 0,0:13:59.00,0:14:00.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:00.25,0:14:03.88,Default,,0,0,0,,Сәлем, Юкито Янаги, біраз уақыт өтті.
Dialogue: 0,0:14:04.30,0:14:05.92,Default,,0,0,0,,Қайтар жолда абай болыңыз
Dialogue: 0,0:14:06.30,0:14:08.26,Default,,0,0,0,,Бүгін қиын болуы мүмкін
Dialogue: 0,0:14:11.10,0:14:11.93,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:14:12.76,0:14:15.43,Default,,0,0,0,,Дөрекі болу деген нені білдіреді?
Dialogue: 0,0:14:15.52,0:14:16.81,Default,,0,0,0,,Бұл теңіз емес пе?
Dialogue: 0,0:14:16.89,0:14:19.06,Default,,0,0,0,,Мүмкін Иноның асқазаны
Dialogue: 0,0:14:19.15,0:14:21.31,Default,,0,0,0,,...және екеуіңіз.
Dialogue: 0,0:14:21.40,0:14:24.57,Default,,0,0,0,,Бүгін Diner GOZ-ке қалай барасыз?
Dialogue: 0,0:14:26.40,0:14:29.61,Default,,0,0,0,,Қарасам, қабірді зиярат еткенде, тікенді көрдім...
Dialogue: 0,0:14:30.03,0:14:32.62,Default,,0,0,0,,Бейіт басында осындай шу шығарғаны үшін кешіріңіз.
Dialogue: 0,0:14:32.91,0:14:35.04,Default,,0,0,0,,Ичиджо мырза ашулы болуы мүмкін.
Dialogue: 0,0:14:35.12,0:14:37.16,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:14:37.25,0:14:39.83,Default,,0,0,0,,Джингидің айтқаны дұрыс.
Dialogue: 0,0:14:39.92,0:14:40.75,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:14:40.83,0:14:41.67,Default,,0,0,0,,О
Dialogue: 0,0:14:42.29,0:14:47.59,Default,,0,0,0,,Бұл Аяка аралындағы өлі адамдарды күлімдеп, шығарып салу тәсілі.
Dialogue: 0,0:14:47.67,0:14:50.93,Default,,0,0,0,,Бұл сіздің қалай ажырасқаныңызға да байланысты.
Dialogue: 0,0:14:51.39,0:14:54.72,Default,,0,0,0,,Тікенектер үшін әлі де қиын болуы мүмкін.
Dialogue: 0,0:14:55.14,0:14:56.64,Default,,0,0,0,,Мен осындамын, мама
Dialogue: 0,0:14:56.73,0:14:59.94,Default,,0,0,0,,Мм, егер сұрауға қарсы болмасаңыз.
Dialogue: 0,0:15:00.02,0:15:03.32,Default,,0,0,0,,Ата-анаң бірге екен... деп естідім.
Dialogue: 0,0:15:03.40,0:15:05.07,Default,,0,0,0,,Бұл жазатайым оқиға болды ма?
Dialogue: 0,0:15:05.57,0:15:08.78,Default,,0,0,0,,Әй, бұл бір-екі жыл бұрын болған оқиға.
Dialogue: 0,0:15:09.28,0:15:12.70,Default,,0,0,0,,Өрт арамитама үйді өртеп жіберетіндей дәрежеге жетті.
Dialogue: 0,0:15:13.49,0:15:17.62,Default,,0,0,0,,Бұл бастықтан жеңілді, бірақ бәрі бірдей құтқара алмады.
Dialogue: 0,0:15:20.50,0:15:22.33,Default,,0,0,0,,Тіпті өмір мен өлімде
Dialogue: 0,0:15:22.42,0:15:24.04,Default,,0,0,0,,Митаманың да істері
Dialogue: 0,0:15:24.13,0:15:25.59,Default,,0,0,0,,Әр адамның өмір ағымы
Dialogue: 0,0:15:26.21,0:15:28.84,Default,,0,0,0,,Бұл дүние мен о дүниенің кейбір қағидалары
Dialogue: 0,0:15:28.92,0:15:31.01,Default,,0,0,0,,Сондықтан күліп, қабылдаңыз.
Dialogue: 0,0:15:31.72,0:15:34.85,Default,,0,0,0,,Бұлай айтқанда, кейбір адамдар түсінбейді.
Dialogue: 0,0:15:35.18,0:15:37.47,Default,,0,0,0,,Менің үйімде ондай адамдар көп.
Dialogue: 0,0:15:37.81,0:15:42.19,Default,,0,0,0,,Ол Арамитаманы жоюға өз сезімін салып жатыр.
Dialogue: 0,0:15:43.56,0:15:45.98,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:15:46.90,0:15:49.36,Default,,0,0,0,,...Бұл шынымен де ауыр.
Dialogue: 0,0:15:49.82,0:15:51.32,Default,,0,0,0,,Ауыр, Такиги-чан.
Dialogue: 0,0:15:51.40,0:15:54.53,Default,,0,0,0,,Жарқынырақ, нұрлы болайық
Dialogue: 0,0:15:55.24,0:15:56.49,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:15:56.58,0:15:57.91,Default,,0,0,0,,Юкито-кун жаман.
Dialogue: 0,0:15:57.99,0:16:00.79,Default,,0,0,0,,Мұндай ауыр оқиғаны естудің өзі мазалайды.
Dialogue: 0,0:16:00.87,0:16:01.92,Default,,0,0,0,,Жоқ
Dialogue: 0,0:16:02.29,0:16:05.88,Default,,0,0,0,,Қалай болғанда да, мен жоғалған затты жеткізе алғаныма қуаныштымын.
Dialogue: 0,0:16:05.96,0:16:08.09,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:16:08.17,0:16:10.76,Default,,0,0,0,,Уа, күте тұрыңыз, Юкито-кун
Dialogue: 0,0:16:10.84,0:16:15.35,Default,,0,0,0,,Қаласаңыз, кілтті тікелей Торнға беріңіз.
Dialogue: 0,0:16:15.76,0:16:18.56,Default,,0,0,0,,Ол ұялшақ, бірақ жақсы қыз.
Dialogue: 0,0:16:19.06,0:16:20.64,Default,,0,0,0,,Мен сізге қазір қоңырау шаламын.
Dialogue: 0,0:16:20.73,0:16:23.02,Default,,0,0,0,,Сіз ұялшақсыз ба?
Dialogue: 0,0:16:23.10,0:16:25.94,Default,,0,0,0,,Сәлеметсіз бе? Қазір мұнда кел...
Dialogue: 0,0:16:28.36,0:16:29.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:30.57,0:16:32.53,Default,,0,0,0,,Юкито пернесі
Dialogue: 0,0:16:32.61,0:16:34.57,Default,,0,0,0,,А... иә.
Dialogue: 0,0:16:34.66,0:16:37.95,Default,,0,0,0,,Ах... иә, мынау...
Dialogue: 0,0:16:38.03,0:16:40.20,Default,,0,0,0,,Кілтті қабірден алу
Dialogue: 0,0:16:44.79,0:16:46.75,Default,,0,0,0,,Торн рахмет
Dialogue: 0,0:16:48.96,0:16:51.26,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:16:51.67,0:16:52.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:52.76,0:16:55.59,Default,,0,0,0,,Менде жоқ болса, қиналып қалар едім.
Dialogue: 0,0:16:55.68,0:16:56.51,Default,,0,0,0,,Иә
Dialogue: 0,0:16:56.59,0:16:58.97,Default,,0,0,0,,Аман-есен қайтарғаныңызға қуаныштымын.
Dialogue: 0,0:16:59.06,0:17:03.27,Default,,0,0,0,,Мен де Ичиджоның ата-анасынан кешірім сұрадым.
Dialogue: 0,0:17:03.35,0:17:04.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:04.77,0:17:08.86,Default,,0,0,0,,Сіздің ерекше күніңізде осындай шу шығарғаным үшін кешіріңіз.
Dialogue: 0,0:17:08.94,0:17:11.65,Default,,0,0,0,,А... иә, ерекше ештеңе жоқ...
Dialogue: 0,0:17:11.74,0:17:14.53,Default,,0,0,0,,Тағы жер сілкінісі?
Dialogue: 0,0:17:14.61,0:17:17.24,Default,,0,0,0,,Жоқ, бұл Арамитама. Оның отты рухы күшті!
Dialogue: 0,0:17:17.32,0:17:19.37,Default,,0,0,0,,Өрт Арамитама?
Dialogue: 0,0:17:21.29,0:17:22.70,Default,,0,0,0,,Ичиджо (Такида) Тікен!
Dialogue: 0,0:17:22.79,0:17:24.50,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:17:24.58,0:17:27.00,Default,,0,0,0,,Өрт арамитама шықса, сіз бей-жай қарайсыз.
Dialogue: 0,0:17:27.67,0:17:28.79,Default,,0,0,0,,Мен оны тоқтатамын, Юкито.
Dialogue: 0,0:17:28.88,0:17:30.96,Default,,0,0,0,,Такиги-чан Аканэ-нимен байланысады.
Dialogue: 0,0:17:31.05,0:17:32.17,Default,,0,0,0,,О
Dialogue: 0,0:17:35.88,0:17:39.76,Default,,0,0,0,,Өткен күні Митаманы тыныштандыру қиын болды.
Dialogue: 0,0:17:40.14,0:17:42.56,Default,,0,0,0,,Сізге рахмет, ешкім зардап шеккен жоқ.
Dialogue: 0,0:17:43.06,0:17:44.35,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:17:44.43,0:17:48.23,Default,,0,0,0,,Туристік ауданның ортасында Арамитама пайда болды.
Dialogue: 0,0:17:48.56,0:17:50.23,Default,,0,0,0,,Мұндай жағдай бұрын соңды болмаған.
Dialogue: 0,0:17:50.65,0:17:52.94,Default,,0,0,0,,Шлагбаумда ақау болды ма?
Dialogue: 0,0:17:53.28,0:17:55.74,Default,,0,0,0,,Тосқауылдың жұмысында ақау жоқ.
Dialogue: 0,0:17:55.82,0:17:58.45,Default,,0,0,0,,Адамдар жиналса, эмоциялар да жинақталады.
Dialogue: 0,0:17:58.53,0:18:00.83,Default,,0,0,0,,Бұл қазірдің өзінде енгізілген...
Dialogue: 0,0:18:00.91,0:18:05.58,Default,,0,0,0,,Соңғы уақытта өмір оты ең жоғары деңгейге жетті.
Dialogue: 0,0:18:05.66,0:18:07.00,Default,,0,0,0,,Сол себепті
Dialogue: 0,0:18:07.42,0:18:10.34,Default,,0,0,0,,10 жыл бұрынғы оқиғаның қайталануы...
Dialogue: 0,0:18:10.42,0:18:14.13,Default,,0,0,0,,Тіпті Янаги өз өмірін қатерге тігіп, мені ұстап тұрған кезде де.
Dialogue: 0,0:18:14.21,0:18:18.38,Default,,0,0,0,,Атқылау Ичиносима мен Ниносима қалаларына жетті.
Dialogue: 0,0:18:18.47,0:18:22.68,Default,,0,0,0,,Бұл аралда енді қауіпсіз орын жоқ... немесе...
Dialogue: 0,0:18:23.31,0:18:25.77,Default,,0,0,0,,Жақын арада бүкіл Аяка аралдарынан
Dialogue: 0,0:18:25.85,0:18:29.31,Default,,0,0,0,,Барлық адамдарды эвакуациялау қажет болады.
Dialogue: 0,0:18:30.06,0:18:34.90,Default,,0,0,0,,Жергілікті халық, мемлекеттік қызметкерлер және жалпы туристер
Dialogue: 0,0:18:34.98,0:18:36.53,Default,,0,0,0,,Олардың барлығы
Dialogue: 0,0:18:37.03,0:18:39.28,Default,,0,0,0,,Сіз туристсіз бе?
Dialogue: 0,0:18:39.66,0:18:42.74,Default,,0,0,0,,Содан бері біз қайта құруға тырыстық.
Dialogue: 0,0:18:42.83,0:18:45.70,Default,,0,0,0,,Сіздің арқаңызда бұл арал біршама гүлденді...
Dialogue: 0,0:18:46.25,0:18:50.58,Default,,0,0,0,,Бұл одан да көп зиян келтіруі мүмкін...
Dialogue: 0,0:18:51.08,0:18:52.13,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:18:52.54,0:18:54.59,Default,,0,0,0,,Бұл ирониялық.
Dialogue: 0,0:18:54.67,0:18:58.42,Default,,0,0,0,,Кешіріңіз, мен шағымданушы сияқты сөйлей бастадым.
Dialogue: 0,0:18:58.84,0:19:02.93,Default,,0,0,0,,Кез келген уақытта бастауға дайын болыңыз
Dialogue: 0,0:19:03.01,0:19:03.85,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:19:03.93,0:19:06.43,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:19:06.98,0:19:08.35,Default,,0,0,0,,Босс Арамитама
Dialogue: 0,0:19:08.43,0:19:10.77,Default,,0,0,0,,О, мен білемін, ол қайда?
Dialogue: 0,0:19:10.85,0:19:12.56,Default,,0,0,0,,Туристік аймақ D аймағы
Dialogue: 0,0:19:13.77,0:19:14.61,Default,,0,0,0,,Жу мырза!
Dialogue: 0,0:19:14.69,0:19:15.69,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:19:20.03,0:19:20.99,Default,,0,0,0,,Өрт!
Dialogue: 0,0:19:21.32,0:19:22.16,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:19:22.57,0:19:24.03,Default,,0,0,0,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:19:25.66,0:19:27.08,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:19:27.62,0:19:30.21,Default,,0,0,0,,Су Барлық нәрсеге пайдалы және ұрыспаңыз
Dialogue: 0,0:19:30.29,0:19:32.58,Default,,0,0,0,,Адамдарды дұрыс емес жерде жазала
Dialogue: 0,0:19:34.84,0:19:35.88,Default,,0,0,0,,Ах
Dialogue: 0,0:19:36.59,0:19:39.26,Default,,0,0,0,,Юкито, сен тікенсің.
Dialogue: 0,0:19:39.67,0:19:41.76,Default,,0,0,0,,Жүр! Мен де жақында жетемін
Dialogue: 0,0:19:41.84,0:19:43.22,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:19:44.22,0:19:45.76,Default,,0,0,0,,Бұл қауіпті.
Dialogue: 0,0:19:45.85,0:19:47.72,Default,,0,0,0,,Мұғаліммен байланысыңыз
Dialogue: 0,0:19:47.81,0:19:48.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:49.06,0:19:51.48,Default,,0,0,0,,Батыр болсаң, өлтіресің.
Dialogue: 0,0:19:51.56,0:19:53.56,Default,,0,0,0,,Батыл болу керек болса, бар!
Dialogue: 0,0:19:54.27,0:19:55.44,Default,,0,0,0,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,0:19:57.40,0:19:59.99,Default,,0,0,0,,Эвакуация жолы осы жолмен! Дүрбелең емес
Dialogue: 0,0:20:00.07,0:20:03.03,Default,,0,0,0,,Жарайды. Басқа облыстардағы жағдай қалай?
Dialogue: 0,0:20:03.11,0:20:05.87,Default,,0,0,0,,А ауданындағы қызметкерлерді осы жаққа да жібере аласыз ба?
Dialogue: 0,0:20:05.95,0:20:07.33,Default,,0,0,0,,Иә, мен оларды ретімен жіберемін.
Dialogue: 0,0:20:07.41,0:20:08.54,Default,,0,0,0,,Тағы да тікенектер
Dialogue: 0,0:20:08.62,0:20:10.29,Default,,0,0,0,,Не? Тікенектер?
Dialogue: 0,0:20:10.37,0:20:11.46,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:20:13.17,0:20:14.04,Default,,0,0,0,,Ичиджо мырза
Dialogue: 0,0:20:16.50,0:20:19.01,Default,,0,0,0,,Ваа...
Dialogue: 0,0:20:21.93,0:20:23.18,Default,,0,0,0,,Хаха...
Dialogue: 0,0:20:32.02,0:20:32.89,Default,,0,0,0,,Тез қаш!
Dialogue: 0,0:20:32.98,0:20:34.27,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:20:40.40,0:20:41.49,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:42.32,0:20:44.61,Default,,0,0,0,,Қожайын бар жерде тікен болады!
Dialogue: 0,0:21:05.13,0:21:05.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:06.05,0:21:09.22,Default,,0,0,0,,Тікенектен қаш
Dialogue: 0,0:21:10.01,0:21:11.64,Default,,0,0,0,,Әкем…
Dialogue: 0,0:21:11.72,0:21:12.56,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:23.32,0:21:25.95,Default,,0,0,0,,Мен енді қашпаймын
Dialogue: 0,0:21:52.06,0:21:53.06,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:59.61,0:22:01.98,Default,,0,0,0,,Ичиджо мырза, жақсысыз ба?
Dialogue: 0,0:22:02.36,0:22:03.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:04.94,0:22:09.95,Default,,0,0,0,,♪～
Dialogue: 0,0:23:29.86,0:23:34.87,Default,,0,0,0,,～♪
