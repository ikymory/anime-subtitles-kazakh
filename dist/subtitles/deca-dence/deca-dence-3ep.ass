Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.16,0:00:14.33,Default,,0,0,0,,Неге маған күресуді үйреткіңіз келді?
Dialogue: 0,0:00:14.63,0:00:16.21,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:00:16.34,0:00:19.17,Default,,0,0,0,,Қателер бұл әлемде қалай өмір сүреді?
Dialogue: 0,0:00:19.30,0:00:20.84,Default,,0,0,0,,Мен тексергім келді.
Dialogue: 0,0:00:21.30,0:00:23.89,Default,,0,0,0,,Бұл қате болды ма?
Dialogue: 0,0:00:33.94,0:00:37.23,Default,,0,0,0,,Нацуме әке, мен жақында қайтамын.
Dialogue: 0,0:00:37.36,0:00:38.57,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:00:38.69,0:00:39.69,Default,,0,0,0,,Иә
Dialogue: 0,0:00:41.36,0:00:42.70,Default,,0,0,0,,Мені шығарыңыз! Асығыңыз!
Dialogue: 0,0:00:42.82,0:00:45.11,Default,,0,0,0,,Иә! (есік жабылған дыбыс)
Dialogue: 0,0:00:45.24,0:00:45.62,Default,,0,0,0,,Уф!
Dialogue: 0,0:00:45.62,0:00:46.57,Default,,0,0,0,,Уф!
Dialogue: 0,0:00:45.62,0:00:46.57,Default,,0,0,0,,(ЭКГ ескерту дыбысы)
Dialogue: 0,0:00:46.57,0:00:46.70,Default,,0,0,0,,(ЭКГ ескерту дыбысы)
Dialogue: 0,0:00:46.70,0:00:47.78,Default,,0,0,0,,(ЭКГ ескерту дыбысы)
Dialogue: 0,0:00:46.70,0:00:47.78,Default,,0,0,0,,Нашар қан құю!
Dialogue: 0,0:00:47.78,0:00:47.91,Default,,0,0,0,,(ЭКГ ескерту дыбысы)
Dialogue: 0,0:00:47.91,0:00:48.87,Default,,0,0,0,,(ЭКГ ескерту дыбысы)
Dialogue: 0,0:00:47.91,0:00:48.87,Default,,0,0,0,,Хаха...
Dialogue: 0,0:00:49.29,0:00:50.54,Default,,0,0,0,,Көбірек қан қосыңыз!
Dialogue: 0,0:00:50.66,0:00:52.62,Default,,0,0,0,,Неліктен ұрыс даласында балалар бар?
Dialogue: 0,0:00:53.04,0:00:56.00,Default,,0,0,0,,Мм, шіркін! Жүрек-өкпе тоқтауы! (электрокардиограммада жүрек-өкпенің тоқтауы дыбысы)
Dialogue: 0,0:00:56.29,0:00:59.25,Default,,0,0,0,,иә иә...
Dialogue: 0,0:01:00.13,0:01:01.76,Default,,0,0,0,,Эпинефрин, 2 миллиметр!
Dialogue: 0,0:01:02.01,0:01:04.38,Default,,0,0,0,,Шыдайсың ба?
Dialogue: 0,0:01:04.51,0:01:06.39,Default,,0,0,0,,иә иә...
Dialogue: 0,0:01:06.51,0:01:07.51,Default,,0,0,0,,Гохо!
Dialogue: 0,0:01:07.68,0:01:09.76,Default,,0,0,0,,Жарайды, мен қайтадан дем аламын!
Dialogue: 0,0:01:09.93,0:01:11.18,Default,,0,0,0,,Өте жақсы өттің
Dialogue: 0,0:01:11.31,0:01:13.27,Default,,0,0,0,,Жақсы (дыбысты тоқтататын бейне)
Dialogue: 0,0:01:14.14,0:01:14.98,Default,,0,0,0,,Осы уақытта
Dialogue: 0,0:01:15.10,0:01:17.65,Default,,0,0,0,,Бұл Чиптің жынды екенін білдіре ме?
Dialogue: 0,0:01:18.90,0:01:23.90,Default,,0,0,0,,♪～
Dialogue: 0,0:02:43.86,0:02:48.86,Default,,0,0,0,,～♪
Dialogue: 0,0:02:49.57,0:02:51.49,Default,,0,0,0,,(көліктің жүгіру дыбысы)
Dialogue: 0,0:02:52.03,0:02:54.83,Default,,0,0,0,,Бұл кенеттен нақты жауынгерлік дайындық деген не?
Dialogue: 0,0:02:54.95,0:02:56.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:54.95,0:02:56.45,Default,,0,0,0,,Бұл ең жылдам жол.
Dialogue: 0,0:02:56.45,0:02:57.29,Default,,0,0,0,,Бұл ең жылдам жол.
Dialogue: 0,0:02:57.41,0:02:59.46,Default,,0,0,0,,Мен оны «сол күшке» қосуды білмеймін.
Dialogue: 0,0:03:00.04,0:03:03.38,Default,,0,0,0,,Ең болмаса итіңіз ұрыс даласында өліп қалмауын қадағалаймын.
Dialogue: 0,0:03:03.59,0:03:04.71,Default,,0,0,0,,Саған еріп жүрсем ғой
Dialogue: 0,0:03:05.63,0:03:08.22,Default,,0,0,0,,... Мен мұны қалаймын!
Dialogue: 0,0:03:10.09,0:03:11.59,Default,,0,0,0,,Осындай жерде...
Dialogue: 0,0:03:11.89,0:03:12.97,Default,,0,0,0,,Юмуши
Dialogue: 0,0:03:13.10,0:03:15.81,Default,,0,0,0,,Бұл жаңадан келгендер үшін тамаша адам жейтін гадолл.
Dialogue: 0,0:03:15.93,0:03:17.23,Default,,0,0,0,,Шабуыл күші де әлсіз
Dialogue: 0,0:03:17.85,0:03:19.56,Default,,0,0,0,,Гир де онымен бірге жаттығады.
Dialogue: 0,0:03:19.69,0:03:20.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:20.94,0:03:21.94,Default,,0,0,0,,Беріліс те...
Dialogue: 0,0:03:22.06,0:03:24.32,Default,,0,0,0,,Біріншіден, Гадолға жау болсаң
Dialogue: 0,0:03:24.44,0:03:27.03,Default,,0,0,0,,Алтын ереже - аймақты дамыту.
Dialogue: 0,0:03:27.15,0:03:27.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:32.20,0:03:34.87,Default,,0,0,0,,Сәлем, бастық! Мен әлі де психологиялық дайынмын!
Dialogue: 0,0:03:35.45,0:03:36.99,Default,,0,0,0,,Сіз аймақты білесіз бе?
Dialogue: 0,0:03:37.12,0:03:38.70,Default,,0,0,0,,Еленбейді...
Dialogue: 0,0:03:38.83,0:03:39.79,Default,,0,0,0,,Иә
Dialogue: 0,0:03:39.91,0:03:41.75,Default,,0,0,0,,Бұл Гадольдің тосқауылы емес пе?
Dialogue: 0,0:03:41.96,0:03:43.33,Default,,0,0,0,,Я...
Dialogue: 0,0:03:43.54,0:03:46.13,Default,,0,0,0,,Зона Гадоллдың қорғаныс реакциясы екені рас.
Dialogue: 0,0:03:46.25,0:03:47.51,Default,,0,0,0,,Бұл оңай емес
Dialogue: 0,0:03:48.30,0:03:52.30,Default,,0,0,0,,Оның ішінде ерекше магнит өрісі пайда болып, ауырлық күшін тұрақсыз етеді.
Dialogue: 0,0:03:52.43,0:03:53.34,Default,,0,0,0,,Иә? сурет? сурет?
Dialogue: 0,0:03:53.47,0:03:56.35,Default,,0,0,0,,Чочочуу! Ах!
Dialogue: 0,0:03:57.39,0:03:58.35,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:59.56,0:04:02.15,Default,,0,0,0,,Иә? Бұл не жарық?
Dialogue: 0,0:04:02.48,0:04:03.77,Default,,0,0,0,,Сіз толқындарды көре аласыз ба?
Dialogue: 0,0:04:03.90,0:04:06.61,Default,,0,0,0,,Бастық... Мынау жылтыр ма?
Dialogue: 0,0:04:06.73,0:04:07.57,Default,,0,0,0,,Иә.
Dialogue: 0,0:04:08.11,0:04:10.74,Default,,0,0,0,,Егер сізде резервуар болса, сіз магнит өрісінің толқындарымен жүре аласыз.
Dialogue: 0,0:04:10.86,0:04:12.11,Default,,0,0,0,,Төзе бер, шыдай бер!
Dialogue: 0,0:04:12.24,0:04:13.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:13.66,0:04:14.49,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,0:04:14.62,0:04:17.79,Default,,0,0,0,,Бұл ұлу денесі арқылы өтетін оксон артериясы.
Dialogue: 0,0:04:17.91,0:04:19.08,Default,,0,0,0,,Оксон…
Dialogue: 0,0:04:19.20,0:04:20.12,Default,,0,0,0,,Бұл Гадолдың қаны ма?
Dialogue: 0,0:04:20.66,0:04:21.50,Default,,0,0,0,,О
Dialogue: 0,0:04:22.33,0:04:25.75,Default,,0,0,0,,Оксон - тіпті декаденсті жылжыта алатын әмбебап энергия.
Dialogue: 0,0:04:26.13,0:04:28.21,Default,,0,0,0,,Әрине, шабуыл үшін қажет нәрсе
Dialogue: 0,0:04:28.34,0:04:31.13,Default,,0,0,0,,Оксон магнит өрісінде толқындарды жүру үшін де қолданылады.
Dialogue: 0,0:04:31.26,0:04:32.30,Default,,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:04:32.43,0:04:35.89,Default,,0,0,0,,Резервуардағы оксон бос болғанда, ол басқарылмайтын болады.
Dialogue: 0,0:04:37.43,0:04:39.39,Default,,0,0,0,,Тұтынғаннан кейін бірден толтырыңыз
Dialogue: 0,0:04:39.85,0:04:42.02,Default,,0,0,0,,Оксонға жақындағанша
Dialogue: 0,0:04:42.14,0:04:45.23,Default,,0,0,0,,Автоматты түрде толтыру үшін жасалған
Dialogue: 0,0:04:46.02,0:04:47.40,Default,,0,0,0,,Мен... түсінемін.
Dialogue: 0,0:04:47.94,0:04:50.40,Default,,0,0,0,,Орташа өлшемді Гадолл жоғары регенерация қабілетіне ие.
Dialogue: 0,0:04:50.53,0:04:53.15,Default,,0,0,0,,Оны жеңудің жалғыз жолы - қан жоғалтудан өлуге мүмкіндік беру.
Dialogue: 0,0:04:53.28,0:04:56.16,Default,,0,0,0,,Бірақ алыстан шабуыл жасағанда,
Dialogue: 0,0:04:56.49,0:04:57.91,Default,,0,0,0,,Піііііі!
Dialogue: 0,0:04:58.37,0:05:00.16,Default,,0,0,0,,Артерияларға жетпейді
Dialogue: 0,0:05:04.25,0:05:05.96,Default,,0,0,0,,Уау! Деформацияланған!
Dialogue: 0,0:05:08.00,0:05:08.96,Default,,0,0,0,,Эй!
Dialogue: 0,0:05:09.34,0:05:10.67,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:11.67,0:05:14.97,Default,,0,0,0,,Алыс қашықтықта жұмыс істемей, кесілгеннен кейін де қайта қалпына келсе ше...
Dialogue: 0,0:05:15.30,0:05:18.35,Default,,0,0,0,,Жақындау және шабуыл Қазір көріңіз
Dialogue: 0,0:05:18.47,0:05:20.14,Default,,0,0,0,,Иә? Апыр-ай!
Dialogue: 0,0:05:20.31,0:05:21.10,Default,,0,0,0,,Не дедің, жауыз бала! (Киришима & Серо) Қайтып келдік.
Dialogue: 0,0:05:21.22,0:05:23.14,Default,,0,0,0,,Уау! Буу!
Dialogue: 0,0:05:23.39,0:05:24.23,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:24.35,0:05:26.69,Default,,0,0,0,,Демалу, толқынды ұстау, шоғырлану.
Dialogue: 0,0:05:26.81,0:05:27.56,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:27.86,0:05:28.48,Default,,0,0,0,,Ахххх...
Dialogue: 0,0:05:28.48,0:05:30.98,Default,,0,0,0,,Ахххх...
Dialogue: 0,0:05:28.48,0:05:30.98,Default,,0,0,0,,Көбелектің құйрығына мұқият болғаныңызда, еш қиындық жоқ.
Dialogue: 0,0:05:30.98,0:05:31.11,Default,,0,0,0,,Ахххх...
Dialogue: 0,0:05:31.11,0:05:31.94,Default,,0,0,0,,Ахххх...
Dialogue: 0,0:05:31.11,0:05:31.94,Default,,0,0,0,,Артерияны көздеу
Dialogue: 0,0:05:32.69,0:05:33.99,Default,,0,0,0,,Эй, тыңдап тұрсың ба?
Dialogue: 0,0:05:34.11,0:05:35.61,Default,,0,0,0,,Ах... Мүмкін емес Мүмкін емес Мүмкін емес!
Dialogue: 0,0:05:35.91,0:05:37.24,Default,,0,0,0,,Иә...
Dialogue: 0,0:05:37.37,0:05:38.12,Default,,0,0,0,,Я...
Dialogue: 0,0:05:38.28,0:05:40.12,Default,,0,0,0,,Ааааааа!
Dialogue: 0,0:05:40.24,0:05:40.99,Default,,0,0,0,,Осындай күйде Рух толқындарына шоғырлана алмаймын
Dialogue: 0,0:05:41.12,0:05:41.87,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:46.33,0:05:47.08,Default,,0,0,0,,Уф
Dialogue: 0,0:05:47.21,0:05:48.00,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:05:52.59,0:05:53.88,Default,,0,0,0,,Эй!
Dialogue: 0,0:06:00.81,0:06:01.81,Default,,0,0,0,,Гадоллға қарсы шайқаста
Dialogue: 0,0:06:01.93,0:06:04.48,Default,,0,0,0,,Олардың энергиясын қаншалықты тиімді ұрлауға болады?
Dialogue: 0,0:06:04.60,0:06:07.31,Default,,0,0,0,,Әрқашан қан жоғалтудан өлетініңді ойла.
Dialogue: 0,0:06:07.60,0:06:09.15,Default,,0,0,0,,Иә...
Dialogue: 0,0:06:09.31,0:06:11.19,Default,,0,0,0,,Ки-иииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииии
Dialogue: 0,0:06:12.23,0:06:14.24,Default,,0,0,0,,Бұл ыңғайсыз...
Dialogue: 0,0:06:14.49,0:06:15.95,Default,,0,0,0,,Айқайламау
Dialogue: 0,0:06:16.74,0:06:20.32,Default,,0,0,0,,Менің қазір алғаным жай ғана... әсер.
Dialogue: 0,0:06:20.62,0:06:23.08,Default,,0,0,0,,Сіз оны асыға күтесіз бе?
Dialogue: 0,0:06:23.20,0:06:24.08,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:06:24.62,0:06:26.58,Default,,0,0,0,,Дос келді
Dialogue: 0,0:06:27.67,0:06:28.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:28.87,0:06:30.33,Default,,0,0,0,,Мұнда не бар?
Dialogue: 0,0:06:30.63,0:06:33.00,Default,,0,0,0,,Менің ойымша, бұл да қар қоңыздарының ұясы.
Dialogue: 0,0:06:33.71,0:06:37.01,Default,,0,0,0,,Шындығында, бұл жай ғана оқу аймағы.
Dialogue: 0,0:06:38.88,0:06:39.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:40.85,0:06:44.47,Default,,0,0,0,,Келесі жолы жалғыз орындаңыз Әсерлер Мен оны асыға күтемін.
Dialogue: 0,0:06:44.89,0:06:45.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:47.89,0:06:48.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:49.23,0:06:51.23,Default,,0,0,0,,Не? Жаттығудасыз ба?
Dialogue: 0,0:06:51.69,0:06:55.48,Default,,0,0,0,,Гадолл соңғы кездері маған шабуыл жасамады, сондықтан менің ойымша, қазір уақыт келді.
Dialogue: 0,0:06:55.61,0:06:57.70,Default,,0,0,0,,Ойланып қарасам, Оксон азайып барады...
Dialogue: 0,0:06:57.82,0:07:01.41,Default,,0,0,0,,Қазір өте қиын, денем дірілдеп тұр...
Dialogue: 0,0:07:01.53,0:07:04.66,Default,,0,0,0,,Бірақ, мүмкін, мен оны біреудің билігіне бере аламын.
Dialogue: 0,0:07:04.79,0:07:07.41,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасағым келеді~ Хэхехе...
Dialogue: 0,0:07:07.83,0:07:09.62,Default,,0,0,0,,Тоқта, иә?
Dialogue: 0,0:07:11.00,0:07:14.30,Default,,0,0,0,,Танкер тек құлдырауда болуы керек.
Dialogue: 0,0:07:14.67,0:07:19.38,Default,,0,0,0,,Өткен күні мен бірінші рет бұзу жұмыстарына далаға шықтым...
Dialogue: 0,0:07:20.01,0:07:22.43,Default,,0,0,0,,Сондай тозақтық жерде
Dialogue: 0,0:07:22.55,0:07:24.51,Default,,0,0,0,,Тірі қайтып келуге жол жоқ.
Dialogue: 0,0:07:25.14,0:07:29.19,Default,,0,0,0,,Тіпті тісті адамдар көп рет өледі.
Dialogue: 0,0:07:30.06,0:07:33.48,Default,,0,0,0,,Нацумэ мұндай жерге барса, шынымен өлетін еді.
Dialogue: 0,0:07:34.36,0:07:36.11,Default,,0,0,0,,Сол қарулармен соғысу үшін...
Dialogue: 0,0:07:36.36,0:07:37.19,Default,,0,0,0,,Е...
Dialogue: 0,0:07:37.32,0:07:39.28,Default,,0,0,0,,Аа, кешіріңіз...
Dialogue: 0,0:07:40.11,0:07:42.16,Default,,0,0,0,,Баратын уақыт болды, иә...
Dialogue: 0,0:07:42.28,0:07:44.16,Default,,0,0,0,,Бізде де ертең жаттығу бар.
Dialogue: 0,0:07:44.78,0:07:45.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:49.66,0:07:51.46,Default,,0,0,0,,Мен білмеймін...
Dialogue: 0,0:08:00.97,0:08:03.47,Default,,0,0,0,,Уууу!
Dialogue: 0,0:08:03.59,0:08:04.64,Default,,0,0,0,,О... Әй? о?
Dialogue: 0,0:08:04.76,0:08:06.43,Default,,0,0,0,,Иә? иә? О...
Dialogue: 0,0:08:06.56,0:08:07.31,Default,,0,0,0,,Бухе
Dialogue: 0,0:08:07.52,0:08:08.47,Default,,0,0,0,,《Міне, басталды!》
Dialogue: 0,0:08:08.89,0:08:09.73,Default,,0,0,0,,Ооо!
Dialogue: 0,0:08:09.98,0:08:10.98,Default,,0,0,0,,Buhe…
Dialogue: 0,0:08:11.14,0:08:12.19,Default,,0,0,0,,Гёе
Dialogue: 0,0:08:12.31,0:08:13.85,Default,,0,0,0,,Уууу!
Dialogue: 0,0:08:13.98,0:08:15.73,Default,,0,0,0,,Уау! Уф...
Dialogue: 0,0:08:15.94,0:08:17.23,Default,,0,0,0,,Ой! Ха...
Dialogue: 0,0:08:17.53,0:08:21.03,Default,,0,0,0,,Әй, бәрі ауырады...
Dialogue: 0,0:08:22.95,0:08:24.87,Default,,0,0,0,,Жауынгер ру болса да
Dialogue: 0,0:08:24.99,0:08:27.79,Default,,0,0,0,,Өйткені, Gear-тегі адамдар керемет.
Dialogue: 0,0:08:27.91,0:08:30.50,Default,,0,0,0,,Оны көру мен іс жүзінде жасаудың арасында үлкен айырмашылық бар.
Dialogue: 0,0:08:30.83,0:08:34.00,Default,,0,0,0,,Бірінші кезекте танкер Гадоллмен күреспек болды.
Dialogue: 0,0:08:34.13,0:08:35.75,Default,,0,0,0,,Өйткені бұл ақылсыз әңгіме.
Dialogue: 0,0:08:36.59,0:08:38.21,Default,,0,0,0,,Бірақ бұл билікте де
Dialogue: 0,0:08:38.34,0:08:40.71,Default,,0,0,0,,Танкер күші бар, солай ма?
Dialogue: 0,0:08:41.26,0:08:44.47,Default,,0,0,0,,Бұл мен рұқсат алғандықтан ғана.
Dialogue: 0,0:08:44.59,0:08:47.05,Default,,0,0,0,,Сандар да әр түрлі.
Dialogue: 0,0:08:48.01,0:08:51.81,Default,,0,0,0,,Маған тіпті рұқсат бермеді.
Dialogue: 0,0:08:52.94,0:08:55.73,Default,,0,0,0,,Танкердің ең күшті әйел жауынгері Күренай
Dialogue: 0,0:08:56.27,0:08:57.23,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:57.98,0:09:01.78,Default,,0,0,0,,Күренайдай болсам ғой.
Dialogue: 0,0:09:01.90,0:09:04.24,Default,,0,0,0,,Мен әрқашан осылай ойладым.
Dialogue: 0,0:09:04.82,0:09:07.66,Default,,0,0,0,,Ол өте әдемі болса да, ол керемет күшті.
Dialogue: 0,0:09:07.78,0:09:09.99,Default,,0,0,0,,Жауынгерлерді жинаңыз...
Dialogue: 0,0:09:10.41,0:09:12.37,Default,,0,0,0,,Күренаймен бірге төбелескіңіз келе ме?
Dialogue: 0,0:09:12.71,0:09:13.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:13.91,0:09:17.46,Default,,0,0,0,,Сіз ұрыс алаңына оның күшін пайдаланбай кіре аласыз.
Dialogue: 0,0:09:18.34,0:09:20.38,Default,,0,0,0,,Бірақ мен олай емеспін...
Dialogue: 0,0:09:21.76,0:09:23.30,Default,,0,0,0,,Сізге бас тарту керек пе?
Dialogue: 0,0:09:25.84,0:09:26.68,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:26.80,0:09:27.97,Default,,0,0,0,,(аяқтың протездік дыбысы)
Dialogue: 0,0:09:28.10,0:09:28.89,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:29.26,0:09:31.10,Default,,0,0,0,,Мен жаңа қару сатып алдым.
Dialogue: 0,0:09:31.22,0:09:33.81,Default,,0,0,0,,Эй, мен келесі шайқасты асыға күтемін.
Dialogue: 0,0:09:35.23,0:09:36.90,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:37.90,0:09:42.15,Default,,0,0,0,,Мен күшті болып, сол күшке қосыламын!
Dialogue: 0,0:09:43.49,0:09:46.28,Default,,0,0,0,,А...келесі жолы ыңылдама.
Dialogue: 0,0:09:46.70,0:09:47.82,Default,,0,0,0,,Ол ісініп, қан ағып тұр
Dialogue: 0,0:09:48.12,0:09:49.16,Default,,0,0,0,,Фу…
Dialogue: 0,0:09:49.37,0:09:51.79,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:09:52.37,0:09:54.75,Default,,0,0,0,,Денеңізді жүзу сезіміне дағдыландырыңыз.
Dialogue: 0,0:09:55.12,0:09:57.63,Default,,0,0,0,,Менің денемде қосымша күш бар.
Dialogue: 0,0:09:58.96,0:10:00.92,Default,,0,0,0,,Толқындармен жүруді сезіну
Dialogue: 0,0:10:01.05,0:10:01.80,Default,,0,0,0,,Гоха!
Dialogue: 0,0:10:04.13,0:10:07.05,Default,,0,0,0,,Кешіктірмеңіз, жылдамдық маңызды
Dialogue: 0,0:10:07.30,0:10:09.72,Default,,0,0,0,,Инені бірқалыпты тиеу
Dialogue: 0,0:10:10.55,0:10:12.52,Default,,0,0,0,,Басқару тұтқасы резервуарда қолданылатын оксон мөлшерін басқарады.
Dialogue: 0,0:10:12.64,0:10:13.72,Default,,0,0,0,,Басқаруға болады
Dialogue: 0,0:10:13.97,0:10:16.23,Default,,0,0,0,,Бағытты өзгерту немесе төтенше жағдайларды болдырмау үшін пайдалануға болады.
Dialogue: 0,0:10:16.52,0:10:17.35,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:18.27,0:10:20.19,Default,,0,0,0,,Ууууууууууууууууууууууууу!
Dialogue: 0,0:10:20.31,0:10:24.40,Default,,0,0,0,,♪～
Dialogue: 0,0:10:59.77,0:11:02.44,Default,,0,0,0,,～♪
Dialogue: 0,0:11:05.28,0:11:06.19,Default,,0,0,0,,Әй!
Dialogue: 0,0:11:06.32,0:11:07.61,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:11:07.74,0:11:08.49,Default,,0,0,0,,Әй!
Dialogue: 0,0:11:12.91,0:11:14.16,Default,,0,0,0,,Апа, жақсысың ба?
Dialogue: 0,0:11:14.95,0:11:16.50,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:11:16.62,0:11:19.50,Default,,0,0,0,,Бастық мен жасадым... Уф!
Dialogue: 0,0:11:19.62,0:11:20.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:21.08,0:11:21.92,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:11:22.29,0:11:26.17,Default,,0,0,0,,Сақтықты түсірмеңіз, өйткені сіз тек алға қарайсыз.
Dialogue: 0,0:11:34.97,0:11:35.93,Default,,0,0,0,,Әй!
Dialogue: 0,0:11:36.27,0:11:37.81,Default,,0,0,0,,Кабураги мырза
Dialogue: 0,0:11:37.93,0:11:40.52,Default,,0,0,0,,Өткен 13 күн, 5 сағат 28 минут
Dialogue: 0,0:11:40.77,0:11:43.36,Default,,0,0,0,,Сіз жинау жұмысын орындамайсыз.
Dialogue: 0,0:11:43.48,0:11:45.44,Default,,0,0,0,,Сіз оны көрсетпегендіктен емес пе?
Dialogue: 0,0:11:45.98,0:11:48.19,Default,,0,0,0,,Сіз бір нәрсені дұрыс түсінбедіңіз бе?
Dialogue: 0,0:11:48.82,0:11:53.03,Default,,0,0,0,,Негізінде қателерді өзіңіз іздеп, олар туралы хабарлауыңыз керек.
Dialogue: 0,0:11:53.16,0:11:54.03,Default,,0,0,0,,Қалған коллекционерлер осылай істеп жатыр.
Dialogue: 0,0:11:54.03,0:11:55.95,Default,,0,0,0,,Қалған коллекционерлер осылай істеп жатыр.
Dialogue: 0,0:11:54.03,0:11:55.95,Default,,0,0,0,,(5-сынып оқушысы 5) Сүтсіз. (4-сынып оқушысы 4) Жырт.
Dialogue: 0,0:11:56.62,0:11:56.74,Default,,0,0,0,,Айналада бірде-бір қате жоқ дейсіз бе?
Dialogue: 0,0:11:56.74,0:11:58.66,Default,,0,0,0,,Айналада бірде-бір қате жоқ дейсіз бе?
Dialogue: 0,0:11:56.74,0:11:58.66,Default,,0,0,0,,Тасу... Көмектесіңізші!
Dialogue: 0,0:11:58.66,0:11:58.79,Default,,0,0,0,,Айналада бірде-бір қате жоқ дейсіз бе?
Dialogue: 0,0:11:58.79,0:11:59.96,Default,,0,0,0,,Айналада бірде-бір қате жоқ дейсіз бе?
Dialogue: 0,0:11:58.79,0:11:59.96,Default,,0,0,0,,Хе... хеееее!
Dialogue: 0,0:12:00.29,0:12:01.46,Default,,0,0,0,,Онда жоқ...
Dialogue: 0,0:12:01.79,0:12:02.88,Default,,0,0,0,,Әрқашан қателер болады
Dialogue: 0,0:12:02.88,0:12:04.00,Default,,0,0,0,,Әрқашан қателер болады
Dialogue: 0,0:12:02.88,0:12:04.00,Default,,0,0,0,,О... тоқта...
Dialogue: 0,0:12:04.17,0:12:05.34,Default,,0,0,0,,Мұқият іздеңіз және өшіріңіз
Dialogue: 0,0:12:05.34,0:12:06.75,Default,,0,0,0,,Мұқият іздеңіз және өшіріңіз
Dialogue: 0,0:12:05.34,0:12:06.75,Default,,0,0,0,,Жоқ... өтінемін тоқта!
Dialogue: 0,0:12:10.17,0:12:13.97,Default,,0,0,0,,Сіз әлемге қателердің не үшін қажет емес екенін түсінбейсіз.
Dialogue: 0,0:12:14.43,0:12:16.72,Default,,0,0,0,,Бұл тәртіпті сақтау үшін.
Dialogue: 0,0:12:16.97,0:12:20.56,Default,,0,0,0,,Бұрын ақымақ адамдар мұны істей алмайтын.
Dialogue: 0,0:12:20.85,0:12:22.73,Default,,0,0,0,,Сондықтан ол жойылды
Dialogue: 0,0:12:22.98,0:12:24.86,Default,,0,0,0,,Pupupi Pupupi
Dialogue: 0,0:12:24.98,0:12:30.07,Default,,0,0,0,,Есіңізде болсын, біз жүйе үшін өмір сүреміз.
Dialogue: 0,0:12:30.32,0:12:32.36,Default,,0,0,0,,«Әлемге қателер қажет емес»
Dialogue: 0,0:12:34.74,0:12:37.53,Default,,0,0,0,,Әлемге қателер қажет емес
Dialogue: 0,0:12:44.71,0:12:47.25,Default,,0,0,0,,2400 жылдардың соңы
Dialogue: 0,0:12:47.38,0:12:51.55,Default,,0,0,0,,Ауаның ластану индексі адам өліміне әкелетін дозадан асып түседі
Dialogue: 0,0:12:51.80,0:12:55.64,Default,,0,0,0,,Жер енді тірі тіршілік ететін жер емес.
Dialogue: 0,0:12:56.43,0:12:58.26,Default,,0,0,0,,Ұлт ұғымы жойылды
Dialogue: 0,0:12:58.39,0:13:03.10,Default,,0,0,0,,Әлемдік ықпалды компаниялар өздерінің киборгтарын жасайды
Dialogue: 0,0:13:03.23,0:13:05.23,Default,,0,0,0,,Адамзат өліп бара жатқанда
Dialogue: 0,0:13:05.35,0:13:08.40,Default,,0,0,0,,Киборгтардың саны қатты өсті.
Dialogue: 0,0:13:08.90,0:13:10.94,Default,,0,0,0,,Бұған жауап ретінде, қазірдің өзінде сол уақытта
Dialogue: 0,0:13:11.07,0:13:15.20,Default,,0,0,0,,Біздің компания «Solid Quake» әлемде жетекші орынға ие болды.
Dialogue: 0,0:13:15.32,0:13:17.57,Default,,0,0,0,,Бүкіл адамзатқа иелік ет
Dialogue: 0,0:13:17.70,0:13:20.95,Default,,0,0,0,,Еуразия құрлығында үлкен күмбез орнатылды.
Dialogue: 0,0:13:21.08,0:13:24.42,Default,,0,0,0,,Decadence үлкен ойын-сауық кешенін әзірледі.
Dialogue: 0,0:13:25.37,0:13:28.92,Default,,0,0,0,,Адамзаттың осы ақымақ тарихын қайталамау үшін.
Dialogue: 0,0:13:29.17,0:13:32.01,Default,,0,0,0,,Біздің компания барлық шешімдерді бақылайды.
Dialogue: 0,0:13:32.13,0:13:35.34,Default,,0,0,0,,Басқарудың толық тәуелсіздік жүйесі енгізілді
Dialogue: 0,0:13:35.47,0:13:37.51,Default,,0,0,0,,Жүйе автоматты түрде анықтайды
Dialogue: 0,0:13:37.64,0:13:40.18,Default,,0,0,0,,Әрбір жеке адам орындайды
Dialogue: 0,0:13:40.76,0:13:44.81,Default,,0,0,0,,Тәртіпті қоғам осылай құрылады.
Dialogue: 0,0:13:47.19,0:13:48.44,Default,,0,0,0,,Олай болса, бәріңе.
Dialogue: 0,0:13:49.06,0:13:51.02,Default,,0,0,0,,Күніңіз табысты өтсін
Dialogue: 0,0:14:09.17,0:14:10.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:10.63,0:14:14.84,Default,,0,0,0,,Бастық~ Қайырлы таң!
Dialogue: 0,0:14:16.13,0:14:17.09,Default,,0,0,0,,Не?
Dialogue: 0,0:14:17.22,0:14:19.01,Default,,0,0,0,,Демалыс күні кешіріңіз.
Dialogue: 0,0:14:19.14,0:14:20.60,Default,,0,0,0,,Іс жүзінде...
Dialogue: 0,0:14:20.72,0:14:22.72,Default,,0,0,0,,Гегегеге…
Dialogue: 0,0:14:22.85,0:14:25.52,Default,,0,0,0,,Құбырлар! Мені есте сақта...
Dialogue: 0,0:14:25.64,0:14:26.73,Default,,0,0,0,,Мүмкін, олардың санын және ауқымын неғұрлым шектесек—
Dialogue: 0,0:14:27.06,0:14:28.73,Default,,0,0,0,,Мен жай ғана далаға шыққым келеді.
Dialogue: 0,0:14:29.65,0:14:31.73,Default,,0,0,0,,Бірақ бұл дұрыс болды
Dialogue: 0,0:14:31.86,0:14:33.23,Default,,0,0,0,,Мен саған кәдесый әкелдім.
Dialogue: 0,0:14:33.48,0:14:34.74,Default,,0,0,0,,А? ойын?
Dialogue: 0,0:14:35.69,0:14:36.86,Default,,0,0,0,,Жая~!
Dialogue: 0,0:14:36.99,0:14:39.16,Default,,0,0,0,,Бұл сізге сәйкес келеді! Көлемі де тамаша!
Dialogue: 0,0:14:39.28,0:14:40.12,Default,,0,0,0,,Не?
Dialogue: 0,0:14:40.45,0:14:42.03,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:14:42.16,0:14:44.87,Default,,0,0,0,,Бастық, маған рахмет қажет емес.
Dialogue: 0,0:14:45.20,0:14:47.25,Default,,0,0,0,,Рұқсатсыз адамдарға біртүрлі заттарды кигізбеңіз.
Dialogue: 0,0:14:47.37,0:14:49.37,Default,,0,0,0,,Бірақ енді сыртқа шығуға болады.
Dialogue: 0,0:14:49.50,0:14:50.79,Default,,0,0,0,,Хмм.
Dialogue: 0,0:14:50.92,0:14:51.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:52.04,0:14:55.13,Default,,0,0,0,,Мен мұның жақсы екенін ешқашан білмеймін.
Dialogue: 0,0:14:55.38,0:14:56.13,Default,,0,0,0,,(Химецудзима) Жәбірленген-ай… Қандай әлсіз, аянышты бала.
Dialogue: 0,0:14:56.30,0:14:57.26,Default,,0,0,0,,Ге Геге…
Dialogue: 0,0:14:57.63,0:14:59.97,Default,,0,0,0,,Сәлем! Тоқта, тоқта!
Dialogue: 0,0:15:00.72,0:15:02.05,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:02.18,0:15:04.60,Default,,0,0,0,,Гегегеге…
Dialogue: 0,0:15:04.72,0:15:07.06,Default,,0,0,0,,Хехе... Саған жақсы, Пип
Dialogue: 0,0:15:07.18,0:15:07.94,Default,,0,0,0,,Уау
Dialogue: 0,0:15:08.06,0:15:10.60,Default,,0,0,0,,Сіз түсінесіз бе, себебі олар қателер?
Dialogue: 0,0:15:10.77,0:15:11.52,Default,,0,0,0,,Әй!
Dialogue: 0,0:15:11.65,0:15:13.23,Default,,0,0,0,,Қараңызшы, сіз бақытты көрінесіз!
Dialogue: 0,0:15:13.65,0:15:14.90,Default,,0,0,0,,Гее~
Dialogue: 0,0:15:15.03,0:15:15.86,Default,,0,0,0,,Не!
Dialogue: 0,0:15:16.15,0:15:18.11,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:15:19.40,0:15:22.24,Default,,0,0,0,,-да? Сіз бұл үшін барлық жолмен келдіңіз бе?
Dialogue: 0,0:15:23.33,0:15:25.45,Default,,0,0,0,,Аа, шын мәнінде...
Dialogue: 0,0:15:26.58,0:15:29.75,Default,,0,0,0,,Мен көремін. Сіз байқадыңыз ба?
Dialogue: 0,0:15:30.21,0:15:31.46,Default,,0,0,0,,Иә...
Dialogue: 0,0:15:31.67,0:15:32.67,Default,,0,0,0,,Дәл осы сәтте
Dialogue: 0,0:15:32.79,0:15:35.13,Default,,0,0,0,,Рычагты қысу тым кеш.
Dialogue: 0,0:15:35.71,0:15:39.09,Default,,0,0,0,,Бұл сәт ұрыс даласында өлімге әкелуі мүмкін.
Dialogue: 0,0:15:39.42,0:15:40.38,Default,,0,0,0,,Иә...
Dialogue: 0,0:15:40.72,0:15:44.72,Default,,0,0,0,,Алайда мен қаруды оң қолмен ұстай алмаймын.
Dialogue: 0,0:15:45.18,0:15:46.85,Default,,0,0,0,,Оны қалай айтасыз?
Dialogue: 0,0:15:47.56,0:15:50.35,Default,,0,0,0,,Мен бұл жігітті бұрыннан танимын.
Dialogue: 0,0:15:50.48,0:15:52.44,Default,,0,0,0,,Маған көп көмек көрсетілді.
Dialogue: 0,0:15:52.56,0:15:55.48,Default,,0,0,0,,Сондықтан бұл өте маңызды.
Dialogue: 0,0:15:55.94,0:15:56.78,Default,,0,0,0,,Бұл ерекше
Dialogue: 0,0:15:59.86,0:16:01.11,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:16:01.36,0:16:03.91,Default,,0,0,0,,Ақыр соңында, егер мұндай нәрсе болса
Dialogue: 0,0:16:04.03,0:16:07.41,Default,,0,0,0,,«Әлсіздігім шығар» деп ойладым іштей.
Dialogue: 0,0:16:09.25,0:16:12.83,Default,,0,0,0,,Мен саған көмектесер едім...
Dialogue: 0,0:16:13.58,0:16:15.75,Default,,0,0,0,,Бұл біраз жүрексіз емес пе?
Dialogue: 0,0:16:16.88,0:16:19.80,Default,,0,0,0,,Ой, кешіріңіз, бұл мүлдем қатысы жоқ.
Dialogue: 0,0:16:22.09,0:16:23.18,Default,,0,0,0,,Менің артымнан жүр
Dialogue: 0,0:16:23.30,0:16:25.85,Default,,0,0,0,,Не? Қайда бара жатырсың?
Dialogue: 0,0:16:29.52,0:16:31.48,Default,,0,0,0,,Иә...
Dialogue: 0,0:16:31.60,0:16:33.44,Default,,0,0,0,,Сәлем, бастық
Dialogue: 0,0:16:33.77,0:16:35.15,Default,,0,0,0,,Бұл қауіпті.
Dialogue: 0,0:16:35.27,0:16:37.98,Default,,0,0,0,,Бұл сізге келуге болмайтын жер.
Dialogue: 0,0:16:39.15,0:16:39.99,Default,,0,0,0,,Міне, осы жерде.
Dialogue: 0,0:16:40.11,0:16:41.95,Default,,0,0,0,,А? Уф! Уф...
Dialogue: 0,0:16:42.24,0:16:43.32,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:43.95,0:16:45.70,Default,,0,0,0,,Уау...
Dialogue: 0,0:16:46.62,0:16:48.74,Default,,0,0,0,,Осындай жерде қару сататын дүкен бар!
Dialogue: 0,0:16:48.87,0:16:49.95,Default,,0,0,0,,Геге…
Dialogue: 0,0:16:52.54,0:16:54.96,Default,,0,0,0,,Иә? Қош келдіңіз
Dialogue: 0,0:16:55.25,0:16:58.09,Default,,0,0,0,,Мен үшін Мистер Кубты өзіммен бірге алып кету ерекше.
Dialogue: 0,0:16:58.21,0:16:59.96,Default,,0,0,0,,Ал үй жануары? дейін
Dialogue: 0,0:17:00.38,0:17:02.22,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:17:02.51,0:17:03.97,Default,,0,0,0,,О, анау қол
Dialogue: 0,0:17:04.38,0:17:05.26,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:05.39,0:17:08.68,Default,,0,0,0,,Бұл өте ескі. Маған көрейін.
Dialogue: 0,0:17:08.81,0:17:11.10,Default,,0,0,0,,бөліміне өтіңіз…Сіз біртүрлі нәрсе істеп жатырсыз ба?
Dialogue: 0,0:17:11.56,0:17:12.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:12.68,0:17:17.02,Default,,0,0,0,,Хахахаха! Куб мырза, бұл не бала?
Dialogue: 0,0:17:17.69,0:17:18.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:19.32,0:17:20.86,Default,,0,0,0,,Артқа Мен оны қарызға аламын ба?
Dialogue: 0,0:17:22.32,0:17:23.15,Default,,0,0,0,,Егер сол күйді сақтай отырып қозғалсам…
Dialogue: 0,0:17:23.28,0:17:24.61,Default,,0,0,0,,Иә (есіктің ашылған дыбысы)
Dialogue: 0,0:17:25.53,0:17:26.57,Default,,0,0,0,,Саса
Dialogue: 0,0:17:26.70,0:17:28.45,Default,,0,0,0,,Ик!
Dialogue: 0,0:17:29.41,0:17:30.79,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:17:30.91,0:17:32.62,Default,,0,0,0,,Маған оң қолыңды көрсет.
Dialogue: 0,0:17:32.87,0:17:34.96,Default,,0,0,0,,Бастық да оғаш істермен айналыспайды ма?
Dialogue: 0,0:17:35.08,0:17:36.88,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Асықшы!
Dialogue: 0,0:17:37.00,0:17:38.96,Default,,0,0,0,,Отыр, бұл жай әзіл емес пе?
Dialogue: 0,0:17:39.09,0:17:40.25,Default,,0,0,0,,Зеницу, мені ойлама.
Dialogue: 0,0:17:40.59,0:17:41.80,Default,,0,0,0,,Сіз не істеп жатырсыз? Қозғалма
Dialogue: 0,0:17:41.92,0:17:43.22,Default,,0,0,0,,А, эй, эй!
Dialogue: 0,0:17:43.34,0:17:44.09,Default,,0,0,0,,Уф, күте тұрыңыз. Эй...
Dialogue: 0,0:17:44.09,0:17:45.51,Default,,0,0,0,,Уф, күте тұрыңыз. Эй...
Dialogue: 0,0:17:44.09,0:17:45.51,Default,,0,0,0,,(механикалық дыбыс)
Dialogue: 0,0:17:45.51,0:17:45.63,Default,,0,0,0,,(механикалық дыбыс)
Dialogue: 0,0:17:45.63,0:17:48.05,Default,,0,0,0,,(механикалық дыбыс)
Dialogue: 0,0:17:45.63,0:17:48.05,Default,,0,0,0,,Міне...
Dialogue: 0,0:17:48.05,0:17:48.26,Default,,0,0,0,,(механикалық дыбыс)
Dialogue: 0,0:17:49.05,0:17:52.02,Default,,0,0,0,,Бұл керемет, бастық!
Dialogue: 0,0:17:53.27,0:17:56.27,Default,,0,0,0,,Қажет болса бөлшектерді ауыстырыңыз.
Dialogue: 0,0:17:56.81,0:18:00.40,Default,,0,0,0,,Бұл керемет және шағын қозғалыстар жасауға мүмкіндік береді.
Dialogue: 0,0:18:00.73,0:18:02.15,Default,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:18:04.28,0:18:05.11,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:05.24,0:18:06.41,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:18:06.74,0:18:08.41,Default,,0,0,0,,Сен жындысың
Dialogue: 0,0:18:10.16,0:18:12.41,Default,,0,0,0,,Бұл шланг клапаны.
Dialogue: 0,0:18:12.83,0:18:15.75,Default,,0,0,0,,Мен көремін. Компрессор біріктірілген түрі ме?
Dialogue: 0,0:18:15.87,0:18:16.92,Default,,0,0,0,,Содан кейін...
Dialogue: 0,0:18:17.21,0:18:18.58,Default,,0,0,0,,Инені енгізіңіз...
Dialogue: 0,0:18:18.71,0:18:19.54,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:19.84,0:18:20.96,Default,,0,0,0,,(Айзава) Сондықтан мен қабылдау емтиханы логикаға жат дедім
Dialogue: 0,0:18:21.09,0:18:23.38,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:18:23.51,0:18:25.55,Default,,0,0,0,,Бастық! Бұл өте керемет!
Dialogue: 0,0:18:26.22,0:18:28.43,Default,,0,0,0,,Бұл әлсіздік емес.
Dialogue: 0,0:18:28.55,0:18:29.80,Default,,0,0,0,,Бұл сіздің қаруыңыз.
Dialogue: 0,0:18:30.18,0:18:31.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:31.51,0:18:32.85,Default,,0,0,0,,Қарулар...
Dialogue: 0,0:18:34.10,0:18:35.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:36.18,0:18:37.81,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:18:42.32,0:18:44.32,Default,,0,0,0,,Өзімшіл болғаным үшін кешіріңіз.
Dialogue: 0,0:18:44.82,0:18:47.70,Default,,0,0,0,,Жаңа қаруларды сынап көру табиғи нәрсе.
Dialogue: 0,0:18:47.95,0:18:50.07,Default,,0,0,0,,Әлгі дүкен меңгерушісі жақсы адам еді, солай емес пе?
Dialogue: 0,0:18:50.82,0:18:52.58,Default,,0,0,0,,Мен көп ине алдым.
Dialogue: 0,0:18:52.83,0:18:53.95,Default,,0,0,0,,Хехе...
Dialogue: 0,0:18:54.08,0:18:55.83,Default,,0,0,0,,Иә! Гадол!
Dialogue: 0,0:18:56.04,0:18:57.29,Default,,0,0,0,,Мугю!
Dialogue: 0,0:19:01.21,0:19:02.38,Default,,0,0,0,,Не? қайда?
Dialogue: 0,0:19:02.50,0:19:03.67,Default,,0,0,0,,(Норияки) Онда Үндістанмен қоштасу уақыты келді
Dialogue: 0,0:19:11.64,0:19:12.76,Default,,0,0,0,,Уау! не!
Dialogue: 0,0:19:15.47,0:19:17.27,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:19:18.48,0:19:20.31,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:22.94,0:19:24.82,Default,,0,0,0,,Кя! (Бүлдірушілер) Уау!
Dialogue: 0,0:19:25.07,0:19:26.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:32.32,0:19:34.49,Default,,0,0,0,,Не... не...
Dialogue: 0,0:19:36.04,0:19:37.91,Default,,0,0,0,,Ха! құбыр! қайда?
Dialogue: 0,0:19:38.04,0:19:39.16,Default,,0,0,0,,Не?
Dialogue: 0,0:19:39.29,0:19:40.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:41.29,0:19:42.04,Default,,0,0,0,,Құбырлар!
Dialogue: 0,0:19:42.75,0:19:44.04,Default,,0,0,0,,Мені жайбарақаттармен бірге қоспа
Dialogue: 0,0:19:45.67,0:19:46.92,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:56.64,0:19:58.14,Default,,0,0,0,,Қашықтық 2200
Dialogue: 0,0:19:58.27,0:20:00.69,Default,,0,0,0,,Қарсыластың күтілетін уақыты - 750
Dialogue: 0,0:20:00.98,0:20:03.73,Default,,0,0,0,,Орташа өлшемі - Octul Tripias Celldrum.
Dialogue: 0,0:20:03.86,0:20:05.07,Default,,0,0,0,,Юмуши Немос Игер
Dialogue: 0,0:20:05.57,0:20:09.11,Default,,0,0,0,,Дарумамос Мегалоаиннің 8 түрінен 45 дана
Dialogue: 0,0:20:09.24,0:20:10.20,Default,,0,0,0,,Үлкендері жоқ
Dialogue: 0,0:20:10.57,0:20:14.07,Default,,0,0,0,,Жетек бөлігінің зақымдалуы 32% Қозғалыс мүмкін емес
Dialogue: 0,0:20:15.03,0:20:18.20,Default,,0,0,0,,1-ден 3-ке дейінгі қосалқы қақпаларды кеңейтіңіз
Dialogue: 0,0:20:18.33,0:20:19.45,Default,,0,0,0,,Осы жерден кесіңіз
Dialogue: 0,0:20:19.58,0:20:20.33,Default,,0,0,0,,Хмм
Dialogue: 0,0:20:25.50,0:20:26.34,Default,,0,0,0,,Не болды?
Dialogue: 0,0:20:26.63,0:20:28.17,Default,,0,0,0,,Жұмыста өзімді нашар сезінемін.
Dialogue: 0,0:20:28.30,0:20:29.59,Default,,0,0,0,,Негізі қашып кетті.
Dialogue: 0,0:20:30.72,0:20:32.09,Default,,0,0,0,,Маған орналасқан жеріңіз туралы ақпаратты жібере аласыз ба?
Dialogue: 0,0:20:32.47,0:20:34.30,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:20:34.43,0:20:36.39,Default,,0,0,0,,Күтпеген жағдайларға байланысты
Dialogue: 0,0:20:37.76,0:20:39.10,Default,,0,0,0,,Маған бір сәт беріңізші
Dialogue: 0,0:20:39.43,0:20:42.10,Default,,0,0,0,,Пё!
Dialogue: 0,0:20:47.19,0:20:48.86,Default,,0,0,0,,Пё! Ууууу!
Dialogue: 0,0:20:49.11,0:20:51.86,Default,,0,0,0,,Бар, жүр! Бұл жер асты шайқасы!
Dialogue: 0,0:20:51.99,0:20:53.95,Default,,0,0,0,,Мен жасадым!
Dialogue: 0,0:20:54.70,0:20:56.70,Default,,0,0,0,,Ха ха ха ха... Ха!
Dialogue: 0,0:20:59.79,0:21:02.58,Default,,0,0,0,,Әй, эй... Мына жылдамдықтағы машина ма?
Dialogue: 0,0:21:02.87,0:21:04.37,Default,,0,0,0,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,0:21:09.38,0:21:10.76,Default,,0,0,0,,Гю Гю...
Dialogue: 0,0:21:10.88,0:21:11.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:12.34,0:21:13.97,Default,,0,0,0,,Нгю…
Dialogue: 0,0:21:14.09,0:21:15.14,Default,,0,0,0,,Гю не?
Dialogue: 0,0:21:15.30,0:21:16.39,Default,,0,0,0,,Гадол!
Dialogue: 0,0:21:16.51,0:21:17.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:18.22,0:21:19.72,Default,,0,0,0,,Шабуылға жауап жоқ...
Dialogue: 0,0:21:21.06,0:21:22.43,Default,,0,0,0,,Қате…
Dialogue: 0,0:21:22.85,0:21:24.60,Default,,0,0,0,,Жүйеге есеп беру...
Dialogue: 0,0:21:27.73,0:21:29.48,Default,,0,0,0,,Гехехе Гехехе...
Dialogue: 0,0:21:29.98,0:21:31.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:45.54,0:21:46.50,Default,,0,0,0,,Ойын...
Dialogue: 0,0:21:47.46,0:21:50.00,Default,,0,0,0,,Бүгіннен бастап бұл сіздің үйіңіз.
Dialogue: 0,0:21:54.67,0:21:56.18,Default,,0,0,0,,Соңғы кездері түн-түні оқып жүргендіктен.
Dialogue: 0,0:21:56.30,0:21:59.01,Default,,0,0,0,,Әлемге қателер қажет емес.
Dialogue: 0,0:21:59.30,0:22:01.60,Default,,0,0,0,,Геха Геха
Dialogue: 0,0:22:02.56,0:22:03.81,Default,,0,0,0,,Қап!
Dialogue: 0,0:22:04.73,0:22:05.64,Default,,0,0,0,,Әй!
Dialogue: 0,0:22:06.44,0:22:07.40,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:22:09.02,0:22:10.61,Default,,0,0,0,,Ах... Уф!
Dialogue: 0,0:22:19.95,0:22:24.96,Default,,0,0,0,,♪～
Dialogue: 0,0:23:44.87,0:23:49.87,Default,,0,0,0,,～♪
Dialogue: 0,0:23:51.37,0:23:57.37,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory