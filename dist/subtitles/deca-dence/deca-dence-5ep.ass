Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.97,0:00:14.68,Default,,0,0,0,,(Қақпаның дыбысы)
Dialogue: 0,0:00:14.81,0:00:16.77,Default,,0,0,0,,Біздің 6-шы бөлімшенің міндеті
Dialogue: 0,0:00:16.89,0:00:19.90,Default,,0,0,0,,Тұман тудыратын Гадолл α-ны жойыңыз.
Dialogue: 0,0:00:20.23,0:00:23.90,Default,,0,0,0,,Жергілікті атмосфералық қысым төмен және физикалық күш тез жоғалады.
Dialogue: 0,0:00:24.03,0:00:25.69,Default,,0,0,0,,Тез әрекет етіңіз
Dialogue: 0,0:00:26.11,0:00:27.82,Default,,0,0,0,,Бұл соңғы шайқас
Dialogue: 0,0:00:28.20,0:00:31.20,Default,,0,0,0,,Миссияны кез келген жағдайда орындаңыз Тамаша!
Dialogue: 0,0:00:31.62,0:00:32.62,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:34.74,0:00:36.12,Default,,0,0,0,,Бұл ақымақ...
Dialogue: 0,0:00:40.46,0:00:41.88,Default,,0,0,0,,Сорти!
Dialogue: 0,0:00:43.42,0:00:45.88,Default,,0,0,0,,Hyahooooo~!
Dialogue: 0,0:00:51.01,0:00:56.02,Default,,0,0,0,,♪～
Dialogue: 0,0:02:15.89,0:02:20.89,Default,,0,0,0,,～♪
Dialogue: 0,0:02:26.48,0:02:28.53,Default,,0,0,0,,Қарғыс атсын! Ооо!
Dialogue: 0,0:02:28.65,0:02:31.86,Default,,0,0,0,,Маған қаруыңды бер! Қалпына кел!
Dialogue: 0,0:02:31.99,0:02:33.91,Default,,0,0,0,,Уайымдамаңыз! Ілгері жүру!
Dialogue: 0,0:02:34.45,0:02:36.49,Default,,0,0,0,,Гадолл α сағат 10 бағытында
Dialogue: 0,0:02:37.66,0:02:40.20,Default,,0,0,0,,Мен алысты мүлде көре алмаймын...
Dialogue: 0,0:02:40.54,0:02:41.45,Default,,0,0,0,,Әй!
Dialogue: 0,0:02:41.58,0:02:43.08,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:43.21,0:02:45.96,Default,,0,0,0,,Ах! Күренай-сан
Dialogue: 0,0:02:46.25,0:02:48.21,Default,,0,0,0,,Ах... Юрико... Мұнда мен үшін орын жоқ па?
Dialogue: 0,0:02:48.92,0:02:50.88,Default,,0,0,0,,Сен ойнауға келдің бе?
Dialogue: 0,0:02:51.01,0:02:53.09,Default,,0,0,0,,Не? Жоқ, олай емес
Dialogue: 0,0:02:53.38,0:02:55.80,Default,,0,0,0,,Сонда сіз қалқымайсыз.
Dialogue: 0,0:02:56.01,0:02:57.10,Default,,0,0,0,,Бұл ұрыс алаңы
Dialogue: 0,0:02:57.39,0:02:58.89,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:02:59.06,0:03:00.60,Default,,0,0,0,,Жеңіс туралы ғана ойламаңыз
Dialogue: 0,0:03:02.27,0:03:03.35,Default,,0,0,0,,Иә...
Dialogue: 0,0:03:08.40,0:03:10.82,Default,,0,0,0,,Ораораораора!
Dialogue: 0,0:03:10.94,0:03:13.57,Default,,0,0,0,,Мына Доткин-сама мені өлтірмекші.
Dialogue: 0,0:03:13.70,0:03:15.24,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:03:19.83,0:03:21.20,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:03:21.33,0:03:22.33,Default,,0,0,0,,Маған ұнамайды, иә?
Dialogue: 0,0:03:22.83,0:03:25.29,Default,,0,0,0,,Бұрынғыдай айуандық
Dialogue: 0,0:03:25.75,0:03:27.17,Default,,0,0,0,,Керемет емес
Dialogue: 0,0:03:27.96,0:03:28.79,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:03:33.51,0:03:34.51,Default,,0,0,0,,Итадаки!
Dialogue: 0,0:03:36.18,0:03:38.80,Default,,0,0,0,,Ақымақ болмаңыз!
Dialogue: 0,0:03:38.93,0:03:40.35,Default,,0,0,0,,Менен ұрлама, бейбақ!
Dialogue: 0,0:03:40.47,0:03:43.14,Default,,0,0,0,,Тұманға байланысты көріну нашар болса да, бұл әлі де керемет
Dialogue: 0,0:03:43.27,0:03:44.77,Default,,0,0,0,,S дәрежесінен күткендей!
Dialogue: 0,0:03:45.02,0:03:47.40,Default,,0,0,0,,Үй жануарларының кішкентай шабақтары
Dialogue: 0,0:03:47.52,0:03:48.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:49.77,0:03:51.98,Default,,0,0,0,,Гадолл α не болып жатыр?
Dialogue: 0,0:03:52.11,0:03:53.57,Default,,0,0,0,,Барлығы өлтіріледі.
Dialogue: 0,0:03:54.36,0:03:57.07,Default,,0,0,0,,Бірақ бұл миссия C дәрежесі болды.
Dialogue: 0,0:03:58.36,0:03:59.87,Default,,0,0,0,,Осылай болмас еді...
Dialogue: 0,0:04:08.83,0:04:09.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:10.75,0:04:12.46,Default,,0,0,0,,Тыныш.
Dialogue: 0,0:04:12.59,0:04:15.01,Default,,0,0,0,,Гадолл α Ол шынымен бар ма?
Dialogue: 0,0:04:15.13,0:04:17.72,Default,,0,0,0,,Тісті доңғалақтар сізді жеңген жоқ па?
Dialogue: 0,0:04:18.18,0:04:21.47,Default,,0,0,0,,Олай болса қуанышпен ұяға бет аласың.
Dialogue: 0,0:04:23.89,0:04:24.72,Default,,0,0,0,,Не?
Dialogue: 0,0:04:25.02,0:04:26.31,Default,,0,0,0,,Не!
Dialogue: 0,0:04:31.31,0:04:32.32,Default,,0,0,0,,Беріліс...
Dialogue: 0,0:04:33.15,0:04:34.48,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:42.41,0:04:45.41,Default,,0,0,0,,Ә? Аймақ па?
Dialogue: 0,0:04:45.54,0:04:47.04,Default,,0,0,0,,Гуруру…
Dialogue: 0,0:04:47.29,0:04:49.54,Default,,0,0,0,,Қарғыс атсын... Гадол α табылды!
Dialogue: 0,0:04:50.00,0:04:52.21,Default,,0,0,0,,Тыңда, тапсырмаңды орында.
Dialogue: 0,0:04:54.50,0:04:56.21,Default,,0,0,0,,Гурул Гаа!
Dialogue: 0,0:04:56.55,0:04:57.88,Default,,0,0,0,,Майор аман-есен!
Dialogue: 0,0:04:58.13,0:05:00.89,Default,,0,0,0,,Уууу!
Dialogue: 0,0:05:01.18,0:05:02.93,Default,,0,0,0,,Өзімді жоғалтып алған сияқтымын.
Dialogue: 0,0:05:07.23,0:05:08.06,Default,,0,0,0,,Не?
Dialogue: 0,0:05:08.39,0:05:10.98,Default,,0,0,0,,Гомес! Сен ақымақ бала!
Dialogue: 0,0:05:13.31,0:05:14.48,Default,,0,0,0,,Гуаа
Dialogue: 0,0:05:15.19,0:05:16.23,Default,,0,0,0,,Гаха
Dialogue: 0,0:05:17.15,0:05:17.99,Default,,0,0,0,,Не?
Dialogue: 0,0:05:18.65,0:05:19.49,Default,,0,0,0,,Гах...
Dialogue: 0,0:05:19.86,0:05:21.53,Default,,0,0,0,,Әлгі жігіт...
Dialogue: 0,0:05:21.91,0:05:23.07,Default,,0,0,0,,Танктерді көздеу
Dialogue: 0,0:05:23.20,0:05:23.99,Default,,0,0,0,,Ахх!
Dialogue: 0,0:05:24.12,0:05:26.16,Default,,0,0,0,,Балалар, кетіңдер!
Dialogue: 0,0:05:26.37,0:05:28.62,Default,,0,0,0,,Бірақ қарындас, тезірек!
Dialogue: 0,0:05:32.92,0:05:35.13,Default,,0,0,0,,Хаха...
Dialogue: 0,0:05:35.25,0:05:36.09,Default,,0,0,0,,Иә! Ах!
Dialogue: 0,0:05:36.21,0:05:37.46,Default,,0,0,0,,Нацумэ!
Dialogue: 0,0:05:39.05,0:05:40.84,Default,,0,0,0,,Коннооооо!
Dialogue: 0,0:05:41.26,0:05:42.09,Default,,0,0,0,,Гуа!
Dialogue: 0,0:05:42.26,0:05:43.22,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:46.22,0:05:47.72,Default,,0,0,0,,Ха! Нацум!
Dialogue: 0,0:05:47.85,0:05:49.56,Default,,0,0,0,,Гуруру…
Dialogue: 0,0:05:50.85,0:05:52.23,Default,,0,0,0,,Гаха
Dialogue: 0,0:05:53.52,0:05:54.52,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:05:54.65,0:05:55.44,Default,,0,0,0,,Не… Не істеп жатырсың!?
Dialogue: 0,0:05:55.73,0:05:56.57,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:58.15,0:06:00.28,Default,,0,0,0,,Не... неге?
Dialogue: 0,0:06:00.99,0:06:01.82,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:06:02.41,0:06:03.32,Default,,0,0,0,,Болды... Әпке!
Dialogue: 0,0:06:03.45,0:06:04.62,Default,,0,0,0,,Мықты болыңыз!
Dialogue: 0,0:06:04.78,0:06:06.83,Default,,0,0,0,,Бұл қазірдің өзінде қиын.
Dialogue: 0,0:06:07.33,0:06:11.12,Default,,0,0,0,,Қуанған баланың өлгенін көру...
Dialogue: 0,0:06:11.25,0:06:12.08,Default,,0,0,0,,Ах... мен...
Dialogue: 0,0:06:12.58,0:06:16.75,Default,,0,0,0,,Жауапкершілікті сезіну жылы.
Dialogue: 0,0:06:17.17,0:06:18.30,Default,,0,0,0,,Уф... аа...
Dialogue: 0,0:06:18.42,0:06:21.34,Default,,0,0,0,,Мынау... Мен дайынмын...
Dialogue: 0,0:06:21.97,0:06:24.43,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:06:24.89,0:06:27.35,Default,,0,0,0,,Мистер Йошитоки
Dialogue: 0,0:06:27.89,0:06:31.35,Default,,0,0,0,,(Миндидің ауыр тыныс алуы)
Dialogue: 0,0:06:31.48,0:06:33.73,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:06:33.90,0:06:36.23,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:36.48,0:06:38.82,Default,,0,0,0,,Осылай қалса қауіпті...
Dialogue: 0,0:06:39.15,0:06:40.86,Default,,0,0,0,,Ол жойылады...
Dialogue: 0,0:06:40.99,0:06:41.82,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:42.20,0:06:44.82,Default,,0,0,0,,Әй, эй, сен не істейсің?
Dialogue: 0,0:06:47.66,0:06:49.04,Default,,0,0,0,,Өтінемін, осы екеуін қорға
Dialogue: 0,0:06:57.79,0:07:00.80,Default,,0,0,0,,Оған жоғары баға қояды!
Dialogue: 0,0:07:01.67,0:07:03.22,Default,,0,0,0,,Гуаа
Dialogue: 0,0:07:03.42,0:07:05.26,Default,,0,0,0,,Джиеее
Dialogue: 0,0:07:06.39,0:07:07.51,Default,,0,0,0,,Уау...
Dialogue: 0,0:07:15.35,0:07:16.56,Default,,0,0,0,,Не!
Dialogue: 0,0:07:17.15,0:07:18.27,Default,,0,0,0,,Ине...
Dialogue: 0,0:07:18.82,0:07:20.69,Default,,0,0,0,,Мен оны шығарып алдым...
Dialogue: 0,0:07:22.11,0:07:25.61,Default,,0,0,0,,Мынау не... мына жігіт...
Dialogue: 0,0:07:25.74,0:07:27.28,Default,,0,0,0,,Гуаааа
Dialogue: 0,0:07:28.24,0:07:29.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:32.08,0:07:33.83,Default,,0,0,0,,Сондықтан мен айттым.
Dialogue: 0,0:07:33.96,0:07:35.33,Default,,0,0,0,,Саған әлі ерте.
Dialogue: 0,0:07:35.46,0:07:36.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:37.58,0:07:40.42,Default,,0,0,0,,Ку... Бастық?
Dialogue: 0,0:07:49.72,0:07:52.77,Default,,0,0,0,,Оқиға 15 минуттан кейін басталады
Dialogue: 0,0:07:52.93,0:07:53.68,Default,,0,0,0,,Барлық қызметкерлер
Dialogue: 0,0:07:53.68,0:07:54.27,Default,,0,0,0,,Барлық қызметкерлер
Dialogue: 0,0:07:53.68,0:07:54.27,Default,,0,0,0,,Ха! Не?
Dialogue: 0,0:07:54.27,0:07:54.39,Default,,0,0,0,,Ха! Не?
Dialogue: 0,0:07:54.39,0:07:56.39,Default,,0,0,0,,Ха! Не?
Dialogue: 0,0:07:54.39,0:07:56.39,Default,,0,0,0,,Тез арада өз позицияңызды алыңыз.
Dialogue: 0,0:07:56.89,0:07:57.10,Default,,0,0,0,,Сіз ұрыс даласына кіргіңіз келе ме?
Dialogue: 0,0:07:57.10,0:07:58.60,Default,,0,0,0,,Сіз ұрыс даласына кіргіңіз келе ме?
Dialogue: 0,0:07:57.10,0:07:58.60,Default,,0,0,0,,Қайталаңыз
Dialogue: 0,0:07:58.73,0:08:00.23,Default,,0,0,0,,Бұл ақымақ...
Dialogue: 0,0:07:58.73,0:08:00.23,Default,,0,0,0,,Оқиға 15 минуттан кейін басталады
Dialogue: 0,0:08:00.23,0:08:00.98,Default,,0,0,0,,Оқиға 15 минуттан кейін басталады
Dialogue: 0,0:08:00.98,0:08:01.65,Default,,0,0,0,,Оқиға 15 минуттан кейін басталады
Dialogue: 0,0:08:00.98,0:08:01.65,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:08:01.65,0:08:02.40,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:08:04.74,0:08:05.82,Default,,0,0,0,,Минато?
Dialogue: 0,0:08:05.95,0:08:07.91,Default,,0,0,0,,Бұл тұман шығаратын баяғы гадолл.
Dialogue: 0,0:08:08.61,0:08:11.66,Default,,0,0,0,,Жүйе білмейінше, оны тоқтатудың жолы жоқ, солай ма?
Dialogue: 0,0:08:11.78,0:08:14.16,Default,,0,0,0,,Иә? Кенет, сен не туралы айтып тұрсың?
Dialogue: 0,0:08:14.29,0:08:15.66,Default,,0,0,0,,Бұл мүмкін емес, солай емес пе?
Dialogue: 0,0:08:16.91,0:08:19.42,Default,,0,0,0,,Дұрыс айтасың, сөзіңді бөлдім.
Dialogue: 0,0:08:19.79,0:08:21.29,Default,,0,0,0,,Эй, мынау түрі
Dialogue: 0,0:08:21.42,0:08:23.88,Default,,0,0,0,,Мен саған үндеме дедім.
Dialogue: 0,0:08:24.01,0:08:26.17,Default,,0,0,0,,Мен жай ғана түтіккен денемді жылытқым келеді.
Dialogue: 0,0:08:26.72,0:08:28.43,Default,,0,0,0,,Пайдаланушылар риза болса, жақсы.
Dialogue: 0,0:08:28.55,0:08:30.01,Default,,0,0,0,,Не! Эй!
Dialogue: 0,0:08:30.72,0:08:32.81,Default,,0,0,0,,(Автокөлік үдеткішінің дыбысы)
Dialogue: 0,0:08:35.14,0:08:37.06,Default,,0,0,0,,Ку... Бастық?
Dialogue: 0,0:08:37.35,0:08:40.73,Default,,0,0,0,,Сондықтан мен саған әлі ерте дедім.
Dialogue: 0,0:08:40.86,0:08:42.90,Default,,0,0,0,,Бұл... сынған шокпен.
Dialogue: 0,0:08:43.02,0:08:44.94,Default,,0,0,0,,Мен өз күшімді пайдалана алмадым.
Dialogue: 0,0:08:45.23,0:08:47.74,Default,,0,0,0,,Ә? Аймақ па?
Dialogue: 0,0:08:48.03,0:08:50.74,Default,,0,0,0,,О, бұл үшін кешірім сұраймын!
Dialogue: 0,0:08:52.16,0:08:53.33,Default,,0,0,0,,Гуаа
Dialogue: 0,0:08:53.74,0:08:55.66,Default,,0,0,0,,Гуаа
Dialogue: 0,0:08:56.00,0:08:58.66,Default,,0,0,0,,Га-га-гаа!
Dialogue: 0,0:08:58.92,0:09:01.13,Default,,0,0,0,,Кишааааа
Dialogue: 0,0:09:01.25,0:09:02.67,Default,,0,0,0,,Чи…
Dialogue: 0,0:09:05.13,0:09:06.05,Default,,0,0,0,,Уау~
Dialogue: 0,0:09:06.17,0:09:07.22,Default,,0,0,0,,Мен ештеңе көрмеймін
Dialogue: 0,0:09:07.34,0:09:08.17,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:08.30,0:09:09.68,Default,,0,0,0,,Кел! сурет?
Dialogue: 0,0:09:10.72,0:09:12.14,Default,,0,0,0,,Сәлем, бастық!
Dialogue: 0,0:09:12.26,0:09:13.10,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:13.39,0:09:15.52,Default,,0,0,0,,Ататата...
Dialogue: 0,0:09:15.64,0:09:17.35,Default,,0,0,0,,Әй, қайда бара жатырсың?
Dialogue: 0,0:09:17.48,0:09:18.43,Default,,0,0,0,,Достар әлі бар...
Dialogue: 0,0:09:18.81,0:09:21.44,Default,,0,0,0,,Мені жайына қалдыр, мен әлгі Гадоллды жеңе алмаймын.
Dialogue: 0,0:09:21.77,0:09:22.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:23.27,0:09:25.07,Default,,0,0,0,,Сіз бастық болсаңыз да...
Dialogue: 0,0:09:25.19,0:09:25.94,Default,,0,0,0,,Әй!
Dialogue: 0,0:09:26.73,0:09:29.49,Default,,0,0,0,,Олай болса, мен барлығын құтқаруым керек.
Dialogue: 0,0:09:29.82,0:09:32.91,Default,,0,0,0,,Олай жасасаң, өлгенмен тең.
Dialogue: 0,0:09:33.32,0:09:34.58,Default,,0,0,0,,Бірақ... Бірақ
Dialogue: 0,0:09:34.70,0:09:36.04,Default,,0,0,0,,Серіктеріне сенгені өзінің қателігі екенін түсінген Эрен
Dialogue: 0,0:09:36.20,0:09:37.04,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:09:43.38,0:09:46.05,Default,,0,0,0,,Мен шештім
Dialogue: 0,0:09:46.96,0:09:50.13,Default,,0,0,0,,Мен өзімді шектен шығарамын
Dialogue: 0,0:09:50.38,0:09:51.26,Default,,0,0,0,,Әй!
Dialogue: 0,0:09:51.55,0:09:53.97,Default,,0,0,0,,Мен өзімді шегіне жеткізгім келеді!
Dialogue: 0,0:09:54.97,0:09:55.93,Default,,0,0,0,,Әй!
Dialogue: 0,0:09:57.22,0:09:59.27,Default,,0,0,0,,Шектеу...
Dialogue: 0,0:09:59.39,0:10:02.31,Default,,0,0,0,,Мен бұл туралы баяғыда ұмытып кетіппін.
Dialogue: 0,0:10:06.07,0:10:07.32,Default,,0,0,0,,Гуах
Dialogue: 0,0:10:08.36,0:10:10.11,Default,,0,0,0,,Хаха...
Dialogue: 0,0:10:10.24,0:10:12.66,Default,,0,0,0,,Сіз оны мына тұманда көре аласыз ба...
Dialogue: 0,0:10:12.78,0:10:14.32,Default,,0,0,0,,Ә? Аймақ па?
Dialogue: 0,0:10:14.62,0:10:16.70,Default,,0,0,0,,Чикусо, сен қайдасың...
Dialogue: 0,0:10:18.24,0:10:20.45,Default,,0,0,0,,Кешіріңіздер, балалар.
Dialogue: 0,0:10:20.75,0:10:23.50,Default,,0,0,0,,Арматура келе жатыр, тез жүгір!
Dialogue: 0,0:10:24.08,0:10:25.54,Default,,0,0,0,,Бөлімше жетекшісі…
Dialogue: 0,0:10:25.84,0:10:29.76,Default,,0,0,0,,Уууу!
Dialogue: 0,0:10:31.09,0:10:31.84,Default,,0,0,0,,Гуаа
Dialogue: 0,0:10:31.97,0:10:33.47,Default,,0,0,0,,Сен ақымақсың!
Dialogue: 0,0:10:33.93,0:10:35.18,Default,,0,0,0,,(ДжоДжо) Бұл таңқаларлық! Мен сен...
Dialogue: 0,0:10:35.64,0:10:36.47,Default,,0,0,0,,Тез жүр!
Dialogue: 0,0:10:39.31,0:10:41.14,Default,,0,0,0,,Барлығымыз бұл жерден кетейік.
Dialogue: 0,0:10:41.39,0:10:45.15,Default,,0,0,0,,Нацюме, сен, мен кейін түсіндіремін! тез!
Dialogue: 0,0:10:45.98,0:10:47.06,Default,,0,0,0,,Гуаааа
Dialogue: 0,0:10:49.98,0:10:50.74,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:50.86,0:10:52.07,Default,,0,0,0,,Гуаааа...
Dialogue: 0,0:10:52.19,0:10:53.70,Default,,0,0,0,,Ей, балапан, не істеп жатырсың!
Dialogue: 0,0:10:53.95,0:10:55.53,Default,,0,0,0,,Онымен ұрыспа
Dialogue: 0,0:10:56.95,0:10:58.78,Default,,0,0,0,,Менің жоспарларым бұзылды.
Dialogue: 0,0:10:58.91,0:11:01.00,Default,,0,0,0,,Мен сенің өлуіңе енді жол бере алмаймын
Dialogue: 0,0:11:01.87,0:11:02.96,Default,,0,0,0,,Не?
Dialogue: 0,0:11:03.58,0:11:06.29,Default,,0,0,0,,Сіз сонда танкер туралы айтып отырсыз ба?
Dialogue: 0,0:11:06.92,0:11:09.21,Default,,0,0,0,,Мен қашсам, ол өледі.
Dialogue: 0,0:11:09.59,0:11:11.38,Default,,0,0,0,,Сенің есі дұрыс па...
Dialogue: 0,0:11:11.80,0:11:13.88,Default,,0,0,0,,Қаш, Гадол сені қумайды!
Dialogue: 0,0:11:14.38,0:11:16.14,Default,,0,0,0,,Қазір әлі уақыт бар
Dialogue: 0,0:11:16.59,0:11:21.06,Default,,0,0,0,,Сіз тек Танкер үшін жауынгер болып оралу туралы әңгімені тотықұспен айтқыңыз келе ме?
Dialogue: 0,0:11:22.14,0:11:24.27,Default,,0,0,0,,Бұл жігіт қате болды.
Dialogue: 0,0:11:24.73,0:11:26.40,Default,,0,0,0,,Әлі де әлеммен күресуде
Dialogue: 0,0:11:26.73,0:11:29.90,Default,,0,0,0,,Мен аман қалып, қалағаныма қол жеткіздім.
Dialogue: 0,0:11:30.23,0:11:31.65,Default,,0,0,0,,Мен сияқты емес
Dialogue: 0,0:11:35.24,0:11:36.74,Default,,0,0,0,,Шектегіш?
Dialogue: 0,0:11:36.86,0:11:37.91,Default,,0,0,0,,Тоқта, балапан!
Dialogue: 0,0:11:38.03,0:11:41.54,Default,,0,0,0,,Сол Гадолды өлтірсең, сценарий өзгереді!
Dialogue: 0,0:11:42.08,0:11:44.66,Default,,0,0,0,,Шалғам! Сіз оны қайтара алмайсыз!
Dialogue: 0,0:11:45.83,0:11:49.17,Default,,0,0,0,,Мен оның... өлуіне жол бере алмаймын.
Dialogue: 0,0:11:49.46,0:11:52.67,Default,,0,0,0,,Менде бұл қате бар...
Dialogue: 0,0:11:53.01,0:11:53.96,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:11:54.34,0:11:57.97,Default,,0,0,0,,Сіз аман қалдыңыз!
Dialogue: 0,0:11:58.14,0:11:59.39,Default,,0,0,0,,Гвуууух!
Dialogue: 0,0:12:00.35,0:12:01.26,Default,,0,0,0,,Хамф!
Dialogue: 0,0:12:01.39,0:12:02.77,Default,,0,0,0,,Гуа!
Dialogue: 0,0:12:08.27,0:12:09.52,Default,,0,0,0,,«бір жылдық төтенше көмек заттарын қамтамасыз етеді»
Dialogue: 0,0:12:10.19,0:12:11.44,Default,,0,0,0,,Гаа гаа!
Dialogue: 0,0:12:16.82,0:12:18.53,Default,,0,0,0,,Гааа
Dialogue: 0,0:12:19.53,0:12:22.16,Default,,0,0,0,,Уууу!
Dialogue: 0,0:12:25.62,0:12:27.92,Default,,0,0,0,,Ga… Ga… Gi…
Dialogue: 0,0:12:28.04,0:12:30.13,Default,,0,0,0,,Га… Гаги…
Dialogue: 0,0:12:38.72,0:12:40.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:41.26,0:12:44.81,Default,,0,0,0,,(Кабурагидің ауыр тыныс алуы)
Dialogue: 0,0:12:46.98,0:12:51.02,Default,,0,0,0,,Ши... Гадолл α командирінің биологиялық реакциясы жоқ.
Dialogue: 0,0:12:51.65,0:12:52.11,Default,,0,0,0,,Тұман шығару тоқтатылды
Dialogue: 0,0:12:52.11,0:12:53.40,Default,,0,0,0,,Тұман шығару тоқтатылды
Dialogue: 0,0:12:52.11,0:12:53.40,Default,,0,0,0,,Ақымақ...
Dialogue: 0,0:12:53.52,0:12:54.82,Default,,0,0,0,,Ауа қысымын басқару да жойылды
Dialogue: 0,0:12:54.94,0:12:56.15,Default,,0,0,0,,Тегіс деңгейге оралу
Dialogue: 0,0:12:56.28,0:12:58.49,Default,,0,0,0,,Ах... Ха!
Dialogue: 0,0:12:58.82,0:13:00.78,Default,,0,0,0,,Нашар! Бұл нәрсе қозғала бастады!
Dialogue: 0,0:13:03.20,0:13:05.66,Default,,0,0,0,,Тұман ешқашан сейілмейтін сияқты.
Dialogue: 0,0:13:05.79,0:13:08.00,Default,,0,0,0,,Бұл түсініксіз.
Dialogue: 0,0:13:08.12,0:13:10.71,Default,,0,0,0,,Бізде басқа амал жоқ
Dialogue: 0,0:13:10.83,0:13:11.75,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:11.96,0:13:13.13,Default,,0,0,0,,Ах! Тұман...
Dialogue: 0,0:13:15.67,0:13:17.38,Default,,0,0,0,,Бұл «Ұя»
Dialogue: 0,0:13:17.67,0:13:20.05,Default,,0,0,0,,Олар өз міндеттерін орындады.
Dialogue: 0,0:13:20.18,0:13:21.39,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:13:21.68,0:13:24.60,Default,,0,0,0,,Жарайды, келе алатындар келсін!
Dialogue: 0,0:13:24.72,0:13:26.64,Default,,0,0,0,,Мақсат ұясы!
Dialogue: 0,0:13:26.81,0:13:28.18,Default,,0,0,0,,Уууу!
Dialogue: 0,0:13:28.18,0:13:29.27,Default,,0,0,0,,Уууу!
Dialogue: 0,0:13:28.18,0:13:29.27,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:13:29.27,0:13:29.39,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:13:29.39,0:13:30.19,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:13:29.39,0:13:30.19,Default,,0,0,0,,Не!
Dialogue: 0,0:13:30.60,0:13:31.81,Default,,0,0,0,,Әй, не? Не болады?
Dialogue: 0,0:13:31.81,0:13:33.52,Default,,0,0,0,,Әй, не? Не болады?
Dialogue: 0,0:13:31.81,0:13:33.52,Default,,0,0,0,,(Қорқынышты айқай)
Dialogue: 0,0:13:33.52,0:13:34.61,Default,,0,0,0,,(Қорқынышты айқай)
Dialogue: 0,0:13:34.61,0:13:36.44,Default,,0,0,0,,(Қорқынышты айқай)
Dialogue: 0,0:13:34.61,0:13:36.44,Default,,0,0,0,,Бұл қандай дауыс?
Dialogue: 0,0:13:39.49,0:13:41.20,Default,,0,0,0,,Аа.
Dialogue: 0,0:13:41.36,0:13:43.07,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:43.41,0:13:45.58,Default,,0,0,0,,Міне, осында.
Dialogue: 0,0:13:46.37,0:13:49.71,Default,,0,0,0,,Бұл айтарлықтай зиян келтірген сияқты. Мүмкін осылай жалғастыра береміз бе?
Dialogue: 0,0:13:52.29,0:13:53.33,Default,,0,0,0,,Ооо! Не?
Dialogue: 0,0:13:53.46,0:13:54.84,Default,,0,0,0,,Қаш!
Dialogue: 0,0:14:16.86,0:14:19.11,Default,,0,0,0,,Не... бұл...
Dialogue: 0,0:14:19.40,0:14:21.40,Default,,0,0,0,,Үлкен! Үлкен өрескел!
Dialogue: 0,0:14:21.53,0:14:24.28,Default,,0,0,0,,Сонда бұл Гадоллдың көшбасшысы ма?
Dialogue: 0,0:14:24.41,0:14:25.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:25.49,0:14:26.33,Default,,0,0,0,,Ой, жоқ!
Dialogue: 0,0:14:26.45,0:14:27.79,Default,,0,0,0,,Не болды?
Dialogue: 0,0:14:27.91,0:14:28.83,Default,,0,0,0,,Ябе!
Dialogue: 0,0:14:28.95,0:14:32.37,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:14:32.67,0:14:34.88,Default,,0,0,0,,Бұл қауіпті, бұл қауіпті, бұл қауіпті!
Dialogue: 0,0:14:35.00,0:14:37.63,Default,,0,0,0,,Сіз не істемексіз? Бұл әлі әзірлену үстінде.
Dialogue: 0,0:14:37.96,0:14:38.92,Default,,0,0,0,,Шулы
Dialogue: 0,0:14:39.05,0:14:41.01,Default,,0,0,0,,Көңіліңіз толқып тұрса, зейініңізді жинақтай алмайсыз.
Dialogue: 0,0:14:41.84,0:14:44.26,Default,,0,0,0,,Әй, жұлдыздар қақпасын дереу артқа тарт!
Dialogue: 0,0:14:44.55,0:14:46.51,Default,,0,0,0,,Жоқ, жоқ, жоқ, мүмкін емес, мүмкін емес~
Dialogue: 0,0:14:46.76,0:14:49.35,Default,,0,0,0,,Оны ойыншылар да, танкистер де көреді.
Dialogue: 0,0:14:49.72,0:14:51.77,Default,,0,0,0,,Бәрінен бұрын ақымақтардың көңілі көтеріледі.
Dialogue: 0,0:14:51.89,0:14:53.98,Default,,0,0,0,,Бұл туралы бірдеңе жасаңыз!
Dialogue: 0,0:14:54.14,0:14:55.65,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:14:55.77,0:14:58.61,Default,,0,0,0,,Цк... Декаденс іске қосылды!
Dialogue: 0,0:14:58.86,0:15:01.32,Default,,0,0,0,,Иә, бірақ оксон тапшылығына байланысты
Dialogue: 0,0:15:01.44,0:15:02.95,Default,,0,0,0,,Бұл әдеттегіден ұзағырақ уақыт алады.
Dialogue: 0,0:15:03.07,0:15:04.15,Default,,0,0,0,,Жарайды, асығыңыз!
Dialogue: 0,0:15:04.70,0:15:06.07,Default,,0,0,0,,Вампир гарпунымен ату!
Dialogue: 0,0:15:17.50,0:15:19.84,Default,,0,0,0,,Жұлдыздар қақпасы аймақты кеңейтеді
Dialogue: 0,0:15:24.51,0:15:26.39,Default,,0,0,0,,Оксон инфузиясының басталуы
Dialogue: 0,0:15:26.76,0:15:29.39,Default,,0,0,0,,Толтыру деңгейі небәрі 42%
Dialogue: 0,0:15:30.01,0:15:31.39,Default,,0,0,0,,Барлық жауынгерлерге хабарландыру!
Dialogue: 0,0:15:32.06,0:15:35.02,Default,,0,0,0,,Үлкен Гадолл жұлдыздар қақпасын нысанаға алыңыз!
Dialogue: 0,0:15:35.14,0:15:38.06,Default,,0,0,0,,Ұстау режимін аяқтау үшін маған біраз уақыт беріңіз!
Dialogue: 0,0:15:38.19,0:15:39.36,Default,,0,0,0,,Миссия дәрежесі - S.
Dialogue: 0,0:15:39.48,0:15:41.40,Default,,0,0,0,,Барлығы оны сұрады!
Dialogue: 0,0:15:41.73,0:15:44.32,Default,,0,0,0,,Сіз бұрынғыдан да оттайсыз, солай емес пе?
Dialogue: 0,0:15:44.49,0:15:46.03,Default,,0,0,0,,Сәлем Минато!
Dialogue: 0,0:15:46.74,0:15:48.57,Default,,0,0,0,,Соңында мен барамын. (Исам) Кеттік.
Dialogue: 0,0:15:48.91,0:15:51.41,Default,,0,0,0,,Той уақыты келді!
Dialogue: 0,0:15:52.75,0:15:55.12,Default,,0,0,0,,Осы жерден аяқтаңыз! Барайық!
Dialogue: 0,0:15:55.33,0:15:56.75,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:16:00.75,0:16:03.92,Default,,0,0,0,,Бұл сценарийді өзгертудің нәтижесі ме?
Dialogue: 0,0:16:05.47,0:16:06.30,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:06.59,0:16:09.80,Default,,0,0,0,,Бастық! Сәл күте тұрыңыз
Dialogue: 0,0:16:11.35,0:16:13.31,Default,,0,0,0,,Иә, Гадолл α -
Dialogue: 0,0:16:13.56,0:16:16.10,Default,,0,0,0,,Бұл коллекторлық агенттіктің жұмысы сияқты.
Dialogue: 0,0:16:16.23,0:16:17.98,Default,,0,0,0,,Пипопипопипи!
Dialogue: 0,0:16:18.35,0:16:19.27,Default,,0,0,0,,Әрине
Dialogue: 0,0:16:19.40,0:16:22.48,Default,,0,0,0,,Тиісті түрде жазаланады деп сенемін.
Dialogue: 0,0:16:22.94,0:16:26.32,Default,,0,0,0,,Бұл жеткілікті!
Dialogue: 0,0:16:31.83,0:16:33.79,Default,,0,0,0,,Зеницу, мені ойлама.
Dialogue: 0,0:16:34.04,0:16:36.46,Default,,0,0,0,,Уау, мен қатты толқып тұрмын
Dialogue: 0,0:16:36.58,0:16:37.79,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:38.08,0:16:39.58,Default,,0,0,0,,Құсса~
Dialogue: 0,0:16:39.71,0:16:40.54,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:44.42,0:16:48.05,Default,,0,0,0,,Жұлдыздар қақпасынан оксон энергиясының жоғары концентрациясы анықталды!
Dialogue: 0,0:16:59.77,0:17:00.06,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:17:00.06,0:17:01.94,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:17:00.06,0:17:01.94,Default,,0,0,0,,Уау! (Оператор) Кя!
Dialogue: 0,0:17:01.94,0:17:02.23,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:17:02.23,0:17:03.44,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:17:02.23,0:17:03.44,Default,,0,0,0,,Қазір бұл не?
Dialogue: 0,0:17:04.07,0:17:05.19,Default,,0,0,0,,Денедегі оксон
Dialogue: 0,0:17:05.32,0:17:07.95,Default,,0,0,0,,Ол қатты қысыммен ұшып бара жатқан сияқты!
Dialogue: 0,0:17:08.49,0:17:11.45,Default,,0,0,0,,Егер бұл сізге тікелей әсер етсе, бұл эпизодтың соңы.
Dialogue: 0,0:17:11.99,0:17:13.45,Default,,0,0,0,,Қандай күш...
Dialogue: 0,0:17:13.95,0:17:15.45,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:17:15.91,0:17:18.96,Default,,0,0,0,,Бұрынғы шабуылға байланысты Оксон инъекциялық кабелі үзілген!
Dialogue: 0,0:17:19.25,0:17:21.58,Default,,0,0,0,,Оксонды жүктеу жылдамдығы 66%
Dialogue: 0,0:17:21.96,0:17:25.34,Default,,0,0,0,,Сіз Гадоллды штаб-пәтерден шұғыл түрде уақытша тоқтатуды сұрағыңыз келе ме?
Dialogue: 0,0:17:25.46,0:17:28.09,Default,,0,0,0,,Бұл ысырап. Бұл жағдайда біз оны уақытында жасай алмаймыз.
Dialogue: 0,0:17:34.89,0:17:37.10,Default,,0,0,0,,Бұл аяқталмаған...
Dialogue: 0,0:17:37.22,0:17:39.18,Default,,0,0,0,,Қаш! Ухё~
Dialogue: 0,0:17:41.65,0:17:43.02,Default,,0,0,0,,Егер мен оны жоя алсам...
Dialogue: 0,0:17:43.15,0:17:44.86,Default,,0,0,0,,Ухёхёхё~
Dialogue: 0,0:17:45.27,0:17:46.44,Default,,0,0,0,,Эй, сен!
Dialogue: 0,0:17:46.57,0:17:47.61,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:17:47.74,0:17:49.45,Default,,0,0,0,,Не болып жатыр? Бұл
Dialogue: 0,0:17:49.57,0:17:51.32,Default,,0,0,0,,Маған бересіз бе? Ку... Босс?
Dialogue: 0,0:17:51.45,0:17:52.74,Default,,0,0,0,,Гуаа, ұры!
Dialogue: 0,0:17:52.87,0:17:53.62,Default,,0,0,0,,Эй!
Dialogue: 0,0:17:54.53,0:17:56.62,Default,,0,0,0,,Жүйке кабелін жалғаңыз
Dialogue: 0,0:18:03.25,0:18:04.84,Default,,0,0,0,,Қосылым аяқталды
Dialogue: 0,0:18:05.29,0:18:08.38,Default,,0,0,0,,Decadence Interception пішінін белсендіру аяқталды
Dialogue: 0,0:18:08.80,0:18:11.01,Default,,0,0,0,,Декаданс Толық жылдамдық алға!
Dialogue: 0,0:18:11.13,0:18:12.76,Default,,0,0,0,,Қауіпсіздік шегіне жетіңіз!
Dialogue: 0,0:18:12.89,0:18:15.14,Default,,0,0,0,,Мен оны міндетті түрде бір соққымен аяқтаймын! (Оператор) Түсінікті.
Dialogue: 0,0:18:15.60,0:18:17.60,Default,,0,0,0,,Декаденс зеңбірегі тұтануы (оператор) Иә!
Dialogue: 0,0:18:17.72,0:18:18.64,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:18.77,0:18:22.60,Default,,0,0,0,,Жұлдыздар қақпасында қайтадан оксон энергиясының жоғары концентрациясы анықталды!
Dialogue: 0,0:18:22.73,0:18:23.65,Default,,0,0,0,,Не?
Dialogue: 0,0:18:24.02,0:18:26.69,Default,,0,0,0,,Тым ерте! Зеңбірек тұтануы уақытында емес!
Dialogue: 0,0:18:26.82,0:18:27.78,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:18:30.61,0:18:31.78,Default,,0,0,0,,Бұл келе жатыр!
Dialogue: 0,0:18:31.90,0:18:33.28,Default,,0,0,0,,Қаш!
Dialogue: 0,0:18:33.53,0:18:36.28,Default,,0,0,0,,Хмм... уф...
Dialogue: 0,0:18:39.62,0:18:42.08,Default,,0,0,0,,Уууу!
Dialogue: 0,0:18:42.21,0:18:44.63,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:19:00.18,0:19:01.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:01.68,0:19:02.64,Default,,0,0,0,,Шалғам…
Dialogue: 0,0:19:03.06,0:19:05.06,Default,,0,0,0,,Декаденс бекітілген
Dialogue: 0,0:19:05.19,0:19:06.65,Default,,0,0,0,,Енді ауқымда
Dialogue: 0,0:19:07.69,0:19:09.40,Default,,0,0,0,,Decadence зеңбірек тұтану аяқталды
Dialogue: 0,0:19:12.65,0:19:13.90,Default,,0,0,0,,Бет...
Dialogue: 0,0:19:15.28,0:19:16.91,Default,,0,0,0,,Ұсқынсыз құбыжық
Dialogue: 0,0:19:21.08,0:19:22.58,Default,,0,0,0,,Маған жанашырлығыңызды көрсетіңіз!
Dialogue: 0,0:19:22.70,0:19:23.66,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:19:30.84,0:19:31.92,Default,,0,0,0,,Гвуу…
Dialogue: 0,0:20:09.75,0:20:11.46,Default,,0,0,0,,Әдемі...
Dialogue: 0,0:20:12.34,0:20:13.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:13.30,0:20:16.72,Default,,0,0,0,,Бастық? Қорқынышты жүзіңіз не болды?
Dialogue: 0,0:20:17.80,0:20:19.01,Default,,0,0,0,,Акселераторға да қолым жетпейді – орындық тым үлкен.
Dialogue: 0,0:20:19.93,0:20:22.18,Default,,0,0,0,,Жарайды, Кабу, сен істедің.
Dialogue: 0,0:20:22.31,0:20:23.97,Default,,0,0,0,,Кешіріңіз, не болды?
Dialogue: 0,0:20:24.35,0:20:25.81,Default,,0,0,0,,Мен де білмеймін
Dialogue: 0,0:20:25.93,0:20:28.52,Default,,0,0,0,,Бұл оқиғаны бұрмалағаным үшін.
Dialogue: 0,0:20:28.65,0:20:29.48,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:20:29.86,0:20:31.73,Default,,0,0,0,,Сіз ештеңеге өкінемін дейсіз ғой, солай ма?
Dialogue: 0,0:20:31.86,0:20:33.57,Default,,0,0,0,,Мен дайынмын.
Dialogue: 0,0:20:33.94,0:20:35.49,Default,,0,0,0,,Ой… бұл қорқынышты!
Dialogue: 0,0:20:50.75,0:20:53.00,Default,,0,0,0,,Эй, бұл...
Dialogue: 0,0:20:53.46,0:20:54.55,Default,,0,0,0,,Бұл өтірік...
Dialogue: 0,0:20:56.63,0:20:57.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:58.13,0:21:00.05,Default,,0,0,0,,Жаңа кезең?
Dialogue: 0,0:21:00.18,0:21:02.55,Default,,0,0,0,,Ха, бұл оған тұрарлық сияқты.
Dialogue: 0,0:21:02.68,0:21:04.93,Default,,0,0,0,,О, бірінші рет келісіп отырмыз.
Dialogue: 0,0:21:05.22,0:21:07.27,Default,,0,0,0,,Не... не болып жатыр?
Dialogue: 0,0:21:07.39,0:21:09.69,Default,,0,0,0,,Гадолл жойылды...
Dialogue: 0,0:21:10.90,0:21:13.32,Default,,0,0,0,,Сонымен... бұл...
Dialogue: 0,0:21:13.77,0:21:16.24,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:21:17.07,0:21:20.20,Default,,0,0,0,,Бұл сәтті болмайды және әлем тыныш болмайды.
Dialogue: 0,0:21:20.95,0:21:23.66,Default,,0,0,0,,Шайқас ешқашан аяқталмайды
Dialogue: 0,0:21:24.70,0:21:29.16,Default,,0,0,0,,Бастық: Сіз осындай нәрсе болуы мүмкін екенін білесіз бе?
Dialogue: 0,0:21:29.29,0:21:30.83,Default,,0,0,0,,Құбырды сұраңыз
Dialogue: 0,0:21:31.58,0:21:32.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:33.21,0:21:34.17,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:38.26,0:21:40.01,Default,,0,0,0,,Бастық?
Dialogue: 0,0:21:47.02,0:21:49.94,Default,,0,0,0,,Қайырлы таң, Кабураги мырза.
Dialogue: 0,0:21:50.31,0:21:53.27,Default,,0,0,0,,Біздің мұнда не үшін келгенімізді білесіз бе?
Dialogue: 0,0:21:53.40,0:21:54.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:54.82,0:21:56.73,Default,,0,0,0,,Қайталаңыз
Dialogue: 0,0:21:57.07,0:21:59.53,Default,,0,0,0,,«Әлемге қателер қажет емес»
Dialogue: 0,0:21:59.65,0:22:00.61,Default,,0,0,0,,Не дедің, жауыз бала! (Киришима & Серо) Қайтып келдік.
Dialogue: 0,0:22:03.16,0:22:05.16,Default,,0,0,0,,Дүниеде қателер бар...
Dialogue: 0,0:22:06.24,0:22:07.12,Default,,0,0,0,,Қалайша біз жеңілгенімізді мойындап, басымызды иеміз?
Dialogue: 0,0:22:08.12,0:22:10.12,Default,,0,0,0,,Фугия!
Dialogue: 0,0:22:14.58,0:22:19.97,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:22:20.09,0:22:25.10,Default,,0,0,0,,♪～
Dialogue: 0,0:23:44.88,0:23:49.89,Default,,0,0,0,,～♪
Dialogue: 0,0:23:51.39,0:23:57.39,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory