Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.36,0:00:12.32,Default,,0,0,0,,Ха ха... құбыр!
Dialogue: 0,0:00:12.44,0:00:13.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:15.15,0:00:16.65,Default,,0,0,0,,Құбырлар!
Dialogue: 0,0:00:17.45,0:00:19.62,Default,,0,0,0,,Құбыр қайда орналасқан?
Dialogue: 0,0:00:19.74,0:00:20.58,Default,,0,0,0,,Эй
Dialogue: 0,0:00:20.83,0:00:22.79,Default,,0,0,0,,Ах! Бастық...
Dialogue: 0,0:00:23.16,0:00:24.33,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:00:24.45,0:00:26.16,Default,,0,0,0,,Мен үшін құбыр...
Dialogue: 0,0:00:26.62,0:00:28.75,Default,,0,0,0,,Көп ұзамай бұл аудан да алдыңғы шепке айналады.
Dialogue: 0,0:00:29.25,0:00:30.88,Default,,0,0,0,,Бұған дейін Decadence-ге оралыңыз.
Dialogue: 0,0:00:31.25,0:00:33.71,Default,,0,0,0,,Аа... Бірақ менде де құбыр бар...
Dialogue: 0,0:00:33.84,0:00:35.01,Default,,0,0,0,,Саған әлі ерте
Dialogue: 0,0:00:35.13,0:00:39.09,Default,,0,0,0,,Мм! Мен де жаттықтым!
Dialogue: 0,0:00:39.22,0:00:40.76,Default,,0,0,0,,Я...
Dialogue: 0,0:00:40.93,0:00:41.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:45.93,0:00:47.60,Default,,0,0,0,,Нихи
Dialogue: 0,0:00:47.94,0:00:52.94,Default,,0,0,0,,♪～
Dialogue: 0,0:02:12.81,0:02:17.82,Default,,0,0,0,,～♪
Dialogue: 0,0:02:20.57,0:02:22.32,Default,,0,0,0,,Құбыр қайда орналасқан?
Dialogue: 0,0:02:22.45,0:02:23.99,Default,,0,0,0,,Құбырлар!
Dialogue: 0,0:02:24.12,0:02:25.07,Default,,0,0,0,,Бұл белгіде көрсетілмеген ғой, иә?
Dialogue: 0,0:02:28.66,0:02:29.50,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:02:29.62,0:02:32.54,Default,,0,0,0,,Онда неге сол тікұшақ келді?
Dialogue: 0,0:02:32.67,0:02:34.21,Default,,0,0,0,,Ия, эй, эй!
Dialogue: 0,0:02:34.33,0:02:35.46,Default,,0,0,0,,Yahoo!
Dialogue: 0,0:02:35.59,0:02:37.42,Default,,0,0,0,,Үлкен аға күткендей, найзағай тез!
Dialogue: 0,0:02:37.55,0:02:39.13,Default,,0,0,0,,Дұрыс па? Бірден осылай...
Dialogue: 0,0:02:39.38,0:02:40.26,Default,,0,0,0,,Гах...
Dialogue: 0,0:02:40.38,0:02:41.13,Default,,0,0,0,,Тұрақты түрде құрмет көрсет, Анджело.
Dialogue: 0,0:02:42.72,0:02:44.26,Default,,0,0,0,,Гааааааааааааааааааа...
Dialogue: 0,0:02:50.35,0:02:51.64,Default,,0,0,0,,Гах! (танкер) Уау!
Dialogue: 0,0:02:51.77,0:02:54.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:54.52,0:02:57.65,Default,,0,0,0,,Уф... Уау!
Dialogue: 0,0:02:58.40,0:02:59.23,Default,,0,0,0,,Уф!
Dialogue: 0,0:02:59.48,0:03:00.57,Default,,0,0,0,,Аһ!
Dialogue: 0,0:03:02.40,0:03:04.57,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:03:06.03,0:03:07.12,Default,,0,0,0,,Хаха...
Dialogue: 0,0:03:07.24,0:03:09.58,Default,,0,0,0,,Тынышталыңыз, терең тыныс алыңыз.
Dialogue: 0,0:03:10.08,0:03:13.08,Default,,0,0,0,,Дүрбелең болған кезде тыныс алу арқылы өзіңізді бақылаңыз.
Dialogue: 0,0:03:13.75,0:03:16.67,Default,,0,0,0,,Мұрынмен тыныс алу және ауыз арқылы шығару
Dialogue: 0,0:03:16.79,0:03:19.00,Default,,0,0,0,,Суха
Dialogue: 0,0:03:19.92,0:03:22.72,Default,,0,0,0,,Суха
Dialogue: 0,0:03:22.92,0:03:26.14,Default,,0,0,0,,Суха
Dialogue: 0,0:03:27.80,0:03:29.81,Default,,0,0,0,,Рахмет, бастық.
Dialogue: 0,0:03:30.06,0:03:30.97,Default,,0,0,0,,Сью
Dialogue: 0,0:03:31.10,0:03:31.85,Default,,0,0,0,,Әй!
Dialogue: 0,0:03:33.89,0:03:34.73,Default,,0,0,0,,Джотаро, күте тұр, күте тұр!
Dialogue: 0,0:03:37.23,0:03:38.56,Default,,0,0,0,,Әй!
Dialogue: 0,0:03:50.83,0:03:51.87,Default,,0,0,0,,A сыныбы Тодорокидің мұздату шабуылымен алға шықты, бірақ
Dialogue: 0,0:03:54.16,0:03:55.04,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:03:56.12,0:03:57.33,Default,,0,0,0,,Мен көремін...
Dialogue: 0,0:03:57.71,0:03:58.92,Default,,0,0,0,,Мен көремін...
Dialogue: 0,0:03:59.34,0:04:01.63,Default,,0,0,0,,Қат! Рачи түсініксіз!
Dialogue: 0,0:04:01.75,0:04:03.92,Default,,0,0,0,,Мен мұнда қанша соғамын!
Dialogue: 0,0:04:04.05,0:04:04.88,Default,,0,0,0,,Сәлем
Dialogue: 0,0:04:09.55,0:04:10.81,Default,,0,0,0,,Бұл танкер, солай ма?
Dialogue: 0,0:04:15.18,0:04:16.73,Default,,0,0,0,,А...
Dialogue: 0,0:04:17.10,0:04:19.48,Default,,0,0,0,,Гёк гио гио~
Dialogue: 0,0:04:22.94,0:04:24.03,Default,,0,0,0,,Иә! Қат!
Dialogue: 0,0:04:25.86,0:04:26.61,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:04:27.03,0:04:28.53,Default,,0,0,0,,Джо~!
Dialogue: 0,0:04:31.20,0:04:31.95,Default,,0,0,0,,Әй!
Dialogue: 0,0:04:32.08,0:04:34.04,Default,,0,0,0,,Уууу!
Dialogue: 0,0:04:36.25,0:04:37.62,Default,,0,0,0,,Уф!Қарғыс атқыр...
Dialogue: 0,0:04:45.21,0:04:47.38,Default,,0,0,0,,Ахх!
Dialogue: 0,0:04:48.47,0:04:50.18,Default,,0,0,0,,Ууууууу...
Dialogue: 0,0:04:50.30,0:04:51.51,Default,,0,0,0,,Құбырлар!
Dialogue: 0,0:04:52.93,0:04:54.18,Default,,0,0,0,,Құбырлар…
Dialogue: 0,0:04:54.31,0:04:56.39,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын...
Dialogue: 0,0:04:56.73,0:04:59.15,Default,,0,0,0,,Хмм? Сіз құбырға ризасыз ба?
Dialogue: 0,0:04:59.27,0:05:00.40,Default,,0,0,0,,Хехе...
Dialogue: 0,0:05:00.52,0:05:01.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:01.65,0:05:02.73,Default,,0,0,0,,Не?
Dialogue: 0,0:05:02.86,0:05:03.65,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:05.57,0:05:06.49,Default,,0,0,0,,Не дедің, жауыз бала! (Киришима & Серо) Қайтып келдік.
Dialogue: 0,0:05:06.82,0:05:08.53,Default,,0,0,0,,Не?
Dialogue: 0,0:05:09.41,0:05:10.49,Default,,0,0,0,,Сен сияқты біреуге уақытымды босқа жұмсауға уақытым жоқ.
Dialogue: 0,0:05:10.74,0:05:11.91,Default,,0,0,0,,Қат! Жоқ!
Dialogue: 0,0:05:12.03,0:05:12.83,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:05:12.95,0:05:15.24,Default,,0,0,0,,Ол құлдырауға бет алды. Мен оны қуамын!
Dialogue: 0,0:05:16.29,0:05:17.25,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:17.71,0:05:19.00,Default,,0,0,0,,Өзімді жоғалтып алған сияқтымын.
Dialogue: 0,0:05:21.04,0:05:22.46,Default,,0,0,0,,Әпкем күткендей
Dialogue: 0,0:05:22.59,0:05:24.17,Default,,0,0,0,,Оның көп бөлігін тазаладыңыз ба?
Dialogue: 0,0:05:24.30,0:05:25.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:25.25,0:05:26.88,Default,,0,0,0,,Міне, дәл осы жерден басталады! Мен дәл осы жерден бастаймын!
Dialogue: 0,0:05:28.13,0:05:30.59,Default,,0,0,0,,Ах! Бөлім басшысы: Бұл!
Dialogue: 0,0:05:32.89,0:05:35.81,Default,,0,0,0,,Жоқ! Барлығы эвакуациялансын! Эвакуацияланамын!
Dialogue: 0,0:05:35.93,0:05:38.10,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:38.39,0:05:39.39,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:05:39.85,0:05:40.94,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:43.90,0:05:46.23,Default,,0,0,0,,Қазір! Ат!
Dialogue: 0,0:05:48.90,0:05:51.36,Default,,0,0,0,,Ооооо!
Dialogue: 0,0:05:51.57,0:05:52.74,Default,,0,0,0,,Жоқ! (Танкер) Бұл қиын!
Dialogue: 0,0:05:52.87,0:05:53.74,Default,,0,0,0,,Жақындау!
Dialogue: 0,0:05:53.87,0:05:54.78,Default,,0,0,0,,Ах! Эй!
Dialogue: 0,0:05:55.03,0:05:56.29,Default,,0,0,0,,Ооо...
Dialogue: 0,0:05:56.41,0:05:57.91,Default,,0,0,0,,Не дедің, жауыз бала! (Киришима & Серо) Қайтып келдік.
Dialogue: 0,0:06:01.29,0:06:02.92,Default,,0,0,0,,Ах! Бұл...
Dialogue: 0,0:06:03.38,0:06:04.21,Default,,0,0,0,,Әй!
Dialogue: 0,0:06:09.92,0:06:11.26,Default,,0,0,0,,Гуаааа
Dialogue: 0,0:06:17.01,0:06:17.77,Default,,0,0,0,,Қазір!
Dialogue: 0,0:06:18.18,0:06:19.02,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:06:19.14,0:06:20.98,Default,,0,0,0,,Сіз сондай жалқаусыз!
Dialogue: 0,0:06:21.39,0:06:23.94,Default,,0,0,0,,Маған айлаларыңды көрсет!
Dialogue: 0,0:06:27.78,0:06:29.65,Default,,0,0,0,,Тыныш ұйықта!
Dialogue: 0,0:06:31.57,0:06:32.99,Default,,0,0,0,,Гууууу...
Dialogue: 0,0:06:37.87,0:06:40.00,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:06:40.12,0:06:41.91,Default,,0,0,0,,Күренай күткендей!
Dialogue: 0,0:06:42.58,0:06:44.17,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:06:44.50,0:06:47.88,Default,,0,0,0,,Бұл ең күшті танкер
Dialogue: 0,0:06:55.72,0:06:57.85,Default,,0,0,0,,Сіз бұрын жақсы жұмыс істедіңіз.
Dialogue: 0,0:06:57.97,0:06:59.68,Default,,0,0,0,,Иә? иә!
Dialogue: 0,0:06:59.93,0:07:01.27,Default,,0,0,0,,Ах! Не...
Dialogue: 0,0:07:02.10,0:07:03.98,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:07:04.10,0:07:08.61,Default,,0,0,0,,Күренай-санмен бірге күресу абырой!
Dialogue: 0,0:07:08.73,0:07:10.15,Default,,0,0,0,,Мен Нацумамын!
Dialogue: 0,0:07:10.57,0:07:12.82,Default,,0,0,0,,Сен маған ұқсамайсың. Сіз қай бөлімшедесіз?
Dialogue: 0,0:07:13.11,0:07:14.91,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:07:15.07,0:07:18.16,Default,,0,0,0,,Негізі мен бұл күштің бір бөлігі емеспін...
Dialogue: 0,0:07:18.41,0:07:19.37,Default,,0,0,0,,Мен саған дәл сол сұрақты қойғым келеді
Dialogue: 0,0:07:19.49,0:07:20.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:20.45,0:07:21.66,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:07:21.91,0:07:23.87,Default,,0,0,0,,Мен қатемін...
Dialogue: 0,0:07:24.00,0:07:25.21,Default,,0,0,0,,Қате?
Dialogue: 0,0:07:25.33,0:07:27.42,Default,,0,0,0,,Жәндік сияқты әлсіз дегенді білдіретін сияқты.
Dialogue: 0,0:07:28.50,0:07:30.34,Default,,0,0,0,,Әй, тыныш, бұл не?
Dialogue: 0,0:07:30.55,0:07:32.21,Default,,0,0,0,,Мұны кім жасайды?
Dialogue: 0,0:07:32.34,0:07:35.30,Default,,0,0,0,,Егер сіз қателік жасасаңыз, Соу мен Рёку - бұлар.
Dialogue: 0,0:07:35.43,0:07:36.18,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:07:36.43,0:07:38.39,Default,,0,0,0,,А… Аха…
Dialogue: 0,0:07:38.51,0:07:39.85,Default,,0,0,0,,Нацуме Хух!
Dialogue: 0,0:07:40.43,0:07:42.60,Default,,0,0,0,,Сол күшпен бірге күресеміз бе?
Dialogue: 0,0:07:43.06,0:07:44.69,Default,,0,0,0,,Не? Бірақ...
Dialogue: 0,0:07:44.81,0:07:48.11,Default,,0,0,0,,Күресуге ынталы адамнан бас тартпаймын.
Dialogue: 0,0:07:48.56,0:07:50.86,Default,,0,0,0,,Бұл күшке қош келдіңіз
Dialogue: 0,0:07:51.11,0:07:52.11,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:07:52.23,0:07:54.28,Default,,0,0,0,,Танысқаныма қуаныштымын (танкер) Мен қазір сұраймын.
Dialogue: 0,0:07:54.40,0:07:56.61,Default,,0,0,0,,Құрметпен Иә!
Dialogue: 0,0:07:58.12,0:07:59.28,Default,,0,0,0,,Бастық~!
Dialogue: 0,0:07:59.41,0:08:00.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:00.45,0:08:03.45,Default,,0,0,0,,Біз мұны жасадық! Бастыққа рахмет!
Dialogue: 0,0:08:03.58,0:08:05.16,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:07.21,0:08:08.17,Default,,0,0,0,,Өлме
Dialogue: 0,0:08:08.46,0:08:11.34,Default,,0,0,0,,Иә, дәл бастық айтқандай.
Dialogue: 0,0:08:11.46,0:08:12.46,Default,,0,0,0,,Сен өлгенде...
Dialogue: 0,0:08:12.59,0:08:13.80,Default,,0,0,0,,Мистер Куб!
Dialogue: 0,0:08:13.92,0:08:14.80,Default,,0,0,0,,Ахах... Жақсы!
Dialogue: 0,0:08:15.47,0:08:17.80,Default,,0,0,0,,Неге мұндасың?
Dialogue: 0,0:08:18.01,0:08:18.76,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:08:18.76,0:08:19.30,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:08:18.76,0:08:19.30,Default,,0,0,0,,Ка... Кабу-сама?
Dialogue: 0,0:08:19.30,0:08:19.43,Default,,0,0,0,,Ка... Кабу-сама?
Dialogue: 0,0:08:19.43,0:08:20.85,Default,,0,0,0,,Ка... Кабу-сама?
Dialogue: 0,0:08:19.43,0:08:20.85,Default,,0,0,0,,Сіз белсенді қызметке оралдыңыз ба?
Dialogue: 0,0:08:20.97,0:08:21.10,Default,,0,0,0,,Ол өзгермейді.
Dialogue: 0,0:08:21.10,0:08:22.60,Default,,0,0,0,,Ол өзгермейді.
Dialogue: 0,0:08:21.10,0:08:22.60,Default,,0,0,0,,Мен сенбеймін!
Dialogue: 0,0:08:22.60,0:08:22.72,Default,,0,0,0,,Ол өзгермейді.
Dialogue: 0,0:08:22.72,0:08:22.85,Default,,0,0,0,,Ол өзгермейді.
Dialogue: 0,0:08:22.72,0:08:22.85,Default,,0,0,0,,Мен Кабу-саманы ұрыс даласында қайта кездестіретініме сене алар емеспін!
Dialogue: 0,0:08:22.85,0:08:22.97,Default,,0,0,0,,Мен Кабу-саманы ұрыс даласында қайта кездестіретініме сене алар емеспін!
Dialogue: 0,0:08:22.97,0:08:23.81,Default,,0,0,0,,Мен Кабу-саманы ұрыс даласында қайта кездестіретініме сене алар емеспін!
Dialogue: 0,0:08:22.97,0:08:23.81,Default,,0,0,0,,Я...
Dialogue: 0,0:08:23.81,0:08:24.06,Default,,0,0,0,,Мен Кабу-саманы ұрыс даласында қайта кездестіретініме сене алар емеспін!
Dialogue: 0,0:08:24.06,0:08:25.73,Default,,0,0,0,,Мен Кабу-саманы ұрыс даласында қайта кездестіретініме сене алар емеспін!
Dialogue: 0,0:08:24.06,0:08:25.73,Default,,0,0,0,,Бұқар Бұқар…
Dialogue: 0,0:08:25.73,0:08:26.81,Default,,0,0,0,,Бұқар Бұқар…
Dialogue: 0,0:08:36.40,0:08:39.82,Default,,0,0,0,,Бағытты өзгерту Decadence Толық жылдамдық алға!
Dialogue: 0,0:08:40.32,0:08:42.91,Default,,0,0,0,,Мақсат Гадоллдың ұясы!
Dialogue: 0,0:09:06.39,0:09:09.06,Default,,0,0,0,,Келесі оқиға ақылсыз болады.
Dialogue: 0,0:09:09.19,0:09:11.86,Default,,0,0,0,,Тау бір кездері Эверест деп аталса керек.
Dialogue: 0,0:09:12.06,0:09:13.57,Default,,0,0,0,,Суық болған қандай сезімде болады?
Dialogue: 0,0:09:13.69,0:09:15.36,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:09:17.61,0:09:20.36,Default,,0,0,0,,3 күн бұрын Gear барлау күшімен
Dialogue: 0,0:09:20.82,0:09:23.53,Default,,0,0,0,,Ақырында Гадолдың ұясы анықталды.
Dialogue: 0,0:09:23.74,0:09:25.62,Default,,0,0,0,,Бұл операцияның бір мақсаты бар.
Dialogue: 0,0:09:26.12,0:09:27.54,Default,,0,0,0,,Гадоллдың ұясы
Dialogue: 0,0:09:27.66,0:09:29.83,Default,,0,0,0,,«Ұя» деп аталатын нәрсені басқару
Dialogue: 0,0:09:30.04,0:09:30.92,Default,,0,0,0,,Nest –
Dialogue: 0,0:09:31.04,0:09:33.29,Default,,0,0,0,,Бұл таудың басына жақын орналасқан.
Dialogue: 0,0:09:33.46,0:09:34.42,Default,,0,0,0,,Көріп отырғаныңыздай
Dialogue: 0,0:09:34.55,0:09:36.38,Default,,0,0,0,,Қалың тұман басқан, көріну нашар
Dialogue: 0,0:09:37.13,0:09:38.67,Default,,0,0,0,,Сондықтан бұл стратегия
Dialogue: 0,0:09:38.80,0:09:41.76,Default,,0,0,0,,Барлығын құрлықтағы әскерлер орындауы керек.
Dialogue: 0,0:09:41.93,0:09:43.39,Default,,0,0,0,,Gear барлау күші бойынша
Dialogue: 0,0:09:44.05,0:09:47.10,Default,,0,0,0,,Осы тұманды тудыратын Гадол бар сияқты.
Dialogue: 0,0:09:47.22,0:09:49.89,Default,,0,0,0,,Ең алдымен ол адамды жоюымыз керек.
Dialogue: 0,0:09:50.02,0:09:53.77,Default,,0,0,0,,Сонымен, 6-шы блок Gear блогымен бірлесіп,
Dialogue: 0,0:09:53.90,0:09:57.15,Default,,0,0,0,,Оларға Gadoll α нысанасын жоюды сұраңыз.
Dialogue: 0,0:09:57.57,0:09:58.65,Default,,0,0,0,,Мақсат осында
Dialogue: 0,0:09:58.99,0:10:03.20,Default,,0,0,0,,5500 метрдегі жартастың жарығында орналасқан
Dialogue: 0,0:10:03.32,0:10:05.41,Default,,0,0,0,,Әрине, операция жоғары биіктікте жүргізіледі.
Dialogue: 0,0:10:05.53,0:10:07.29,Default,,0,0,0,,Дене күшін шамадан тыс тұтыну
Dialogue: 0,0:10:08.00,0:10:09.83,Default,,0,0,0,,Тез әрекет етіңіз.
Dialogue: 0,0:10:09.96,0:10:10.92,Default,,0,0,0,,Иә! және!
Dialogue: 0,0:10:11.17,0:10:12.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:13.33,0:10:14.67,Default,,0,0,0,,Жалғастыруға бола ма?
Dialogue: 0,0:10:15.09,0:10:17.71,Default,,0,0,0,,Уф... олай емес~
Dialogue: 0,0:10:17.84,0:10:19.67,Default,,0,0,0,,Уф... кешіріңіз
Dialogue: 0,0:10:19.92,0:10:21.05,Default,,0,0,0,,(Танкшылардың күлкісі)
Dialogue: 0,0:10:21.18,0:10:24.30,Default,,0,0,0,,Түсіндіруді жалғастыру үшін бұл жеткілікті.
Dialogue: 0,0:10:24.68,0:10:28.31,Default,,0,0,0,,Енді біріншіден бесіншіге дейінгі негізгі күштерге көшейік...
Dialogue: 0,0:10:29.27,0:10:31.31,Default,,0,0,0,,Не? Жауынгер санатында?
Dialogue: 0,0:10:31.56,0:10:34.73,Default,,0,0,0,,Ах, өткен күнгі шайқас бағалануға тиіс еді.
Dialogue: 0,0:10:34.86,0:10:35.69,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:35.81,0:10:37.32,Default,,0,0,0,,Әй, қарашы.
Dialogue: 0,0:10:37.90,0:10:39.28,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:39.53,0:10:41.57,Default,,0,0,0,,Ранкер болған кезіңіз есіңізде ме?
Dialogue: 0,0:10:41.90,0:10:44.62,Default,,0,0,0,,Мен... бірақ мен...
Dialogue: 0,0:10:44.78,0:10:47.66,Default,,0,0,0,,Сіз жеткілікті төледіңіз.
Dialogue: 0,0:10:47.79,0:10:49.54,Default,,0,0,0,,Сол лас жұмыстың бәрін жасаңыз.
Dialogue: 0,0:10:49.66,0:10:50.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:50.87,0:10:53.50,Default,,0,0,0,,Мен жөндеу бөлімімен де сөйлестім.
Dialogue: 0,0:10:53.62,0:10:54.83,Default,,0,0,0,,Қайтып кел.
Dialogue: 0,0:10:55.21,0:10:57.50,Default,,0,0,0,,Бірақ Ранкер жойылды, солай ма?
Dialogue: 0,0:10:57.63,0:10:59.09,Default,,0,0,0,,Мен не істей аламын?
Dialogue: 0,0:11:00.38,0:11:03.09,Default,,0,0,0,,Бұл жай ғана әңгіме...
Dialogue: 0,0:11:03.34,0:11:05.64,Default,,0,0,0,,Келесі оқиғаны анықтау мүмкін емес.
Dialogue: 0,0:11:05.76,0:11:06.60,Default,,0,0,0,,Не?
Dialogue: 0,0:11:07.30,0:11:08.60,Default,,0,0,0,,Гадолл α болып табылады
Dialogue: 0,0:11:08.72,0:11:12.64,Default,,0,0,0,,Тіпті S класындағы жабдықпен де жеңу мүмкін емес.
Dialogue: 0,0:11:12.85,0:11:15.73,Default,,0,0,0,,Басқаша айтқанда, тұман ешқашан сейілмейді.
Dialogue: 0,0:11:16.40,0:11:18.82,Default,,0,0,0,,Ал берілістердің көпшілігі жойылды.
Dialogue: 0,0:11:19.19,0:11:21.99,Default,,0,0,0,,Толқу үмітсіздіктің шетінде тұр
Dialogue: 0,0:11:23.03,0:11:27.99,Default,,0,0,0,,Бұл арада әңгіме аты аңызға айналған жауынгерлердің елге оралуы туралы.
Dialogue: 0,0:11:28.62,0:11:31.16,Default,,0,0,0,,Солардың бірі ретінде сіз таңдалды.
Dialogue: 0,0:11:31.29,0:11:32.50,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:33.87,0:11:37.21,Default,,0,0,0,,Ал, сенің істегенің Ранкермен бірдей.
Dialogue: 0,0:11:37.33,0:11:41.01,Default,,0,0,0,,Сонымен келесі іс-шараға қатысқан адамдар...
Dialogue: 0,0:11:41.13,0:11:43.76,Default,,0,0,0,,А және одан төмен сыныптар дерлік жойылды.
Dialogue: 0,0:11:44.43,0:11:47.01,Default,,0,0,0,,Неғұрлым радикалды болса, соғұрлым жақсы, пайдаланушыларға соғұрлым жақсырақ ұнайды.
Dialogue: 0,0:11:48.35,0:11:49.51,Default,,0,0,0,,Әй, шалқан
Dialogue: 0,0:11:49.68,0:11:50.76,Default,,0,0,0,,Тыңдап тұрсың ба?
Dialogue: 0,0:11:50.89,0:11:53.02,Default,,0,0,0,,А-а, түсіндім.
Dialogue: 0,0:11:53.14,0:11:54.23,Default,,0,0,0,,Мен
Dialogue: 0,0:11:54.35,0:11:56.90,Default,,0,0,0,,Мен сіздермен қайтадан жұмыс істеп жатқаныма қуаныштымын.
Dialogue: 0,0:11:57.02,0:11:58.94,Default,,0,0,0,,Міне, сондықтан
Dialogue: 0,0:11:59.11,0:12:02.48,Default,,0,0,0,,Келесі оқиға аяқталғанша үндемеңіз.
Dialogue: 0,0:12:02.90,0:12:04.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:05.11,0:12:09.03,Default,,0,0,0,,Бұл операция ең үлкен шайқас болады.
Dialogue: 0,0:12:09.16,0:12:11.12,Default,,0,0,0,,Сақ болыңыз. (Барлығы) Иә!
Dialogue: 0,0:12:11.62,0:12:13.70,Default,,0,0,0,,Іс-шара ертең таңғы сағат 4:00-де өтеді.
Dialogue: 0,0:12:13.83,0:12:15.62,Default,,0,0,0,,Тарту!
Dialogue: 0,0:12:19.46,0:12:20.63,Default,,0,0,0,,Бұл бала Нацумэ
Dialogue: 0,0:12:21.00,0:12:23.42,Default,,0,0,0,,Минди Мунди Менди
Dialogue: 0,0:12:23.80,0:12:27.72,Default,,0,0,0,,Мен үшеммін, сенен басқа мен ең жас жауынгермін.
Dialogue: 0,0:12:27.84,0:12:30.60,Default,,0,0,0,,Біз сол 6-бөлімде боламыз, сондықтан бізге қамқорлық жасаңыз.
Dialogue: 0,0:12:30.72,0:12:31.51,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:31.64,0:12:33.18,Default,,0,0,0,,Олай болса, мен мұны сізге қалдырамын.
Dialogue: 0,0:12:33.47,0:12:35.27,Default,,0,0,0,,Сол себепті
Dialogue: 0,0:12:35.39,0:12:37.14,Default,,0,0,0,,Мен сіздің біраз қозғала алатыныңызды білемін, бірақ
Dialogue: 0,0:12:37.27,0:12:39.44,Default,,0,0,0,,Ұрыс алаңында топтық жұмыс маңызды.
Dialogue: 0,0:12:39.90,0:12:42.02,Default,,0,0,0,,Өз бетіңізше әрекет етуден мүлде аулақ болыңыз.
Dialogue: 0,0:12:42.15,0:12:44.19,Default,,0,0,0,,Иә! Мен оны есте сақтаймын
Dialogue: 0,0:12:44.74,0:12:46.20,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:12:46.49,0:12:47.78,Default,,0,0,0,,Рахмет... (қолдың протезінің өзгеру дыбысы)
Dialogue: 0,0:12:47.91,0:12:49.32,Default,,0,0,0,,Ха! (Мунди Менди) Ах...
Dialogue: 0,0:12:49.66,0:12:52.53,Default,,0,0,0,,Ах! Кешіріңіз! Мен әлі үйренбегенмін...
Dialogue: 0,0:12:52.66,0:12:55.16,Default,,0,0,0,,Бір... Мен қару қолдануға дағдыланбадым.
Dialogue: 0,0:12:55.29,0:12:57.08,Default,,0,0,0,,Бұл ұрыс даласында пайдасыз!
Dialogue: 0,0:12:57.25,0:12:58.08,Default,,0,0,0,,Е...
Dialogue: 0,0:12:58.50,0:12:59.88,Default,,0,0,0,,Сәлем әпке
Dialogue: 0,0:13:00.00,0:13:01.21,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:13:01.34,0:13:03.80,Default,,0,0,0,,Алып кетсең, бекер өлесің.
Dialogue: 0,0:13:03.92,0:13:04.71,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:13:05.09,0:13:06.01,Default,,0,0,0,,Эй, сәлем
Dialogue: 0,0:13:06.13,0:13:07.76,Default,,0,0,0,,Әй, не болды?
Dialogue: 0,0:13:07.88,0:13:09.34,Default,,0,0,0,,Бұлай айтудың қажеті жоқ
Dialogue: 0,0:13:09.47,0:13:11.22,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:13:16.02,0:13:16.98,Default,,0,0,0,,Иә! а!
Dialogue: 0,0:13:17.39,0:13:18.48,Default,,0,0,0,,Фэй!
Dialogue: 0,0:13:20.10,0:13:21.27,Default,,0,0,0,,Жүзбе…
Dialogue: 0,0:13:21.40,0:13:22.36,Default,,0,0,0,,Ерте кел
Dialogue: 0,0:13:22.48,0:13:23.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:25.07,0:13:28.03,Default,,0,0,0,,Көрмегеніме көп болды, Фэй, қалайсың?
Dialogue: 0,0:13:28.15,0:13:31.74,Default,,0,0,0,,Жоқ, мен кешкі асты анда-санда ішу жақсы болар деп ойладым.
Dialogue: 0,0:13:31.87,0:13:33.49,Default,,0,0,0,,Дұрыс па? мыс?
Dialogue: 0,0:13:33.62,0:13:34.49,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:35.74,0:13:37.37,Default,,0,0,0,,Кешіріңіз, мен бос емеспін.
Dialogue: 0,0:13:37.50,0:13:38.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:39.00,0:13:40.25,Default,,0,0,0,,Күте тұрыңыз, Фэй!
Dialogue: 0,0:13:40.62,0:13:42.17,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:43.21,0:13:44.25,Default,,0,0,0,,Заттарыңды үйге әкетуді ұмытып қалғансың ғой…
Dialogue: 0,0:13:45.30,0:13:48.67,Default,,0,0,0,,Менің айтқанымды бәрібір тыңдамайсың, солай ма?
Dialogue: 0,0:13:48.80,0:13:51.59,Default,,0,0,0,,Мен бұдан былай Нацүмеге ілесе алмаймын.
Dialogue: 0,0:13:55.10,0:13:56.18,Default,,0,0,0,,Фэй! F…
Dialogue: 0,0:13:56.64,0:13:58.27,Default,,0,0,0,,Өзіңізді тез жеткізіңіз!
Dialogue: 0,0:13:58.39,0:14:00.27,Default,,0,0,0,,Кешіріңіз, кешіріңіз, а...
Dialogue: 0,0:14:00.39,0:14:01.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:08.99,0:14:10.65,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:15.08,0:14:18.83,Default,,0,0,0,,Сіз бастық емессіз бе? Кенеттен не болды?
Dialogue: 0,0:14:18.95,0:14:22.12,Default,,0,0,0,,Аа, өтінемін, өтінемін, бұл кішкентай және лас жер.
Dialogue: 0,0:14:22.62,0:14:23.92,Default,,0,0,0,,Дұрысы, мен де.
Dialogue: 0,0:14:24.04,0:14:26.63,Default,,0,0,0,,Мен енді ғана бастыққа бармақ болдым.
Dialogue: 0,0:14:26.75,0:14:27.88,Default,,0,0,0,,Қара, сүт!
Dialogue: 0,0:14:28.38,0:14:30.67,Default,,0,0,0,,Мен оны құбырмен бөлісуді ойладым.
Dialogue: 0,0:14:30.80,0:14:33.64,Default,,0,0,0,,Бұл соңғы шайқас және экономиканы көтеру
Dialogue: 0,0:14:35.85,0:14:37.68,Default,,0,0,0,,Операцияға қатысамын деп ойлаймын...
Dialogue: 0,0:14:38.10,0:14:41.60,Default,,0,0,0,,Әй, бәлкім, бастық менімен қатар төбелесетін шығар?
Dialogue: 0,0:14:41.89,0:14:43.31,Default,,0,0,0,,Өтірік! таңқаларлық!
Dialogue: 0,0:14:43.44,0:14:45.86,Default,,0,0,0,,Бастық болса, миллион адам болар еді!
Dialogue: 0,0:14:47.15,0:14:50.11,Default,,0,0,0,,Нацюме... сен жақсы жүрсің.
Dialogue: 0,0:14:50.90,0:14:53.49,Default,,0,0,0,,Аз уақыт ішінде соншалықты күресе білу
Dialogue: 0,0:14:53.61,0:14:55.37,Default,,0,0,0,,Тіпті беріліспен де өте қиын
Dialogue: 0,0:14:55.49,0:14:58.37,Default,,0,0,0,,Аа, көп рахмет.
Dialogue: 0,0:14:58.62,0:15:02.25,Default,,0,0,0,,Алайда бұл операция басқаша.
Dialogue: 0,0:15:02.37,0:15:03.62,Default,,0,0,0,,Саған әлі ерте
Dialogue: 0,0:15:03.75,0:15:07.88,Default,,0,0,0,,Жарайды. Мен бастықтың айтқанын орындаймын.
Dialogue: 0,0:15:08.25,0:15:09.51,Default,,0,0,0,,Ұрыс даласына барма
Dialogue: 0,0:15:09.63,0:15:10.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:11.30,0:15:13.76,Default,,0,0,0,,Сіз мені қолдамадыңыз ба?
Dialogue: 0,0:15:13.88,0:15:17.39,Default,,0,0,0,,Бұл операция сәтті орындалса, әлем тыныш болады.
Dialogue: 0,0:15:17.85,0:15:20.89,Default,,0,0,0,,Бұл сәтті болмайды және әлем тыныш болмайды.
Dialogue: 0,0:15:21.18,0:15:22.10,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:22.23,0:15:25.40,Default,,0,0,0,,Бастық, не болды? Біртүрлі нәрсе емес пе?
Dialogue: 0,0:15:25.90,0:15:28.69,Default,,0,0,0,,Шайқас ешқашан аяқталмайды
Dialogue: 0,0:15:28.82,0:15:30.23,Default,,0,0,0,,Не айтып тұрсың!
Dialogue: 0,0:15:30.36,0:15:32.24,Default,,0,0,0,,Гадол ұясы табылды!
Dialogue: 0,0:15:32.36,0:15:33.99,Default,,0,0,0,,Білмейтіндіктен
Dialogue: 0,0:15:34.11,0:15:35.95,Default,,0,0,0,,Ұялар талай рет табылған.
Dialogue: 0,0:15:36.07,0:15:36.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:37.37,0:15:40.12,Default,,0,0,0,,Ең әуелі ұя деген ұғым жоқ.
Dialogue: 0,0:15:40.49,0:15:43.50,Default,,0,0,0,,Не... неге олай өтірік айтасың?
Dialogue: 0,0:15:43.83,0:15:44.75,Default,,0,0,0,,Өтірік емес
Dialogue: 0,0:15:45.12,0:15:46.63,Default,,0,0,0,,Өйткені мен оны жаңа ғана таптым!
Dialogue: 0,0:15:46.75,0:15:49.67,Default,,0,0,0,,Бұл шайқас қанша уақыттан бері жалғасып жатыр деп ойлайсың?
Dialogue: 0,0:15:49.80,0:15:50.92,Default,,0,0,0,,Жүздеген жылдар!
Dialogue: 0,0:15:51.13,0:15:53.67,Default,,0,0,0,,Сондықтан оны аяқтауға жаттығыңыз...
Dialogue: 0,0:15:53.80,0:15:55.13,Default,,0,0,0,,Олай емес!
Dialogue: 0,0:15:55.26,0:15:56.68,Default,,0,0,0,,Бұл дүние жаратылған...
Dialogue: 0,0:15:57.05,0:15:59.76,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:16:02.02,0:16:05.19,Default,,0,0,0,,Оны ешкім өзгерте алмайды.
Dialogue: 0,0:16:06.60,0:16:09.94,Default,,0,0,0,,Маған ұнамайды. Мен ешқашан тастамаймын.
Dialogue: 0,0:16:10.61,0:16:12.53,Default,,0,0,0,,Тек бекер өл
Dialogue: 0,0:16:12.65,0:16:14.53,Default,,0,0,0,,Өтінемін, ұрыс даласына барма...
Dialogue: 0,0:16:14.65,0:16:15.40,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,0:16:15.99,0:16:17.07,Default,,0,0,0,,Неге білмейсің!
Dialogue: 0,0:16:17.91,0:16:19.45,Default,,0,0,0,,Мен сенің өлгеніңді қаламаймын!
Dialogue: 0,0:16:19.58,0:16:21.49,Default,,0,0,0,,Жоқ! Мен ешқашан тоқтамаймын!
Dialogue: 0,0:16:21.62,0:16:23.33,Default,,0,0,0,,Қалай өмір сүретінімді өзім шешем!
Dialogue: 0,0:16:23.62,0:16:24.58,Default,,0,0,0,,Әй!
Dialogue: 0,0:16:25.00,0:16:25.83,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:26.08,0:16:27.17,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:27.42,0:16:29.50,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:36.84,0:16:38.64,Default,,0,0,0,,Бұл жолы бас тартыңыз
Dialogue: 0,0:16:40.80,0:16:44.43,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:52.11,0:16:53.86,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:16:54.28,0:16:56.11,Default,,0,0,0,,Әлемдік бейбітшілік үшін
Dialogue: 0,0:16:56.24,0:16:57.45,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:16:57.95,0:17:00.78,Default,,0,0,0,,Қанша рет жасасаңыз да, жақсы сезінесіз!
Dialogue: 0,0:17:00.91,0:17:03.24,Default,,0,0,0,,Мен мұны 30 рет жасадым.
Dialogue: 0,0:17:03.37,0:17:04.95,Default,,0,0,0,,Мәліметтер жақсы.
Dialogue: 0,0:17:05.08,0:17:07.50,Default,,0,0,0,,Сәлеметсіз бе! Сәлем!
Dialogue: 0,0:17:07.62,0:17:09.21,Default,,0,0,0,,Немесе... Сәлем!
Dialogue: 0,0:17:09.63,0:17:10.92,Default,,0,0,0,,Брандо мырза
Dialogue: 0,0:17:11.04,0:17:12.71,Default,,0,0,0,,Куренай-сан!
Dialogue: 0,0:17:16.21,0:17:18.22,Default,,0,0,0,,Эй, көңілді жүрсің бе?
Dialogue: 0,0:17:18.47,0:17:21.60,Default,,0,0,0,,Иә, мен толып кеттім.
Dialogue: 0,0:17:21.72,0:17:23.35,Default,,0,0,0,,Мен оны олай көрмеймін.
Dialogue: 0,0:17:23.47,0:17:24.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:24.85,0:17:26.73,Default,,0,0,0,,Сен маған тапсырмадан бас тартуымды айту үшін келдің бе?
Dialogue: 0,0:17:26.89,0:17:27.73,Default,,0,0,0,,Е...
Dialogue: 0,0:17:28.69,0:17:30.48,Default,,0,0,0,,Мұны өзіңіз шештіңіз бе?
Dialogue: 0,0:17:32.27,0:17:33.40,Default,,0,0,0,,Иә...
Dialogue: 0,0:17:33.90,0:17:34.98,Default,,0,0,0,,Жоқ. Сенің мақсатың не екенін білмеймін, бірақ бұл күмәнді.
Dialogue: 0,0:17:35.11,0:17:36.82,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:17:37.90,0:17:40.70,Default,,0,0,0,,Бірақ бетіңізді жуу керек.
Dialogue: 0,0:17:42.66,0:17:43.99,Default,,0,0,0,,Хмм... бұл!
Dialogue: 0,0:17:44.58,0:17:46.58,Default,,0,0,0,,Ым... Күренай-сан?
Dialogue: 0,0:17:46.70,0:17:49.33,Default,,0,0,0,,Сіз жұмысты тоқтату туралы ойладыңыз ба?
Dialogue: 0,0:17:49.46,0:17:50.50,Default,,0,0,0,,Жекпе-жек
Dialogue: 0,0:17:50.75,0:17:53.50,Default,,0,0,0,,Бұл миллионнан астам рет болды.
Dialogue: 0,0:17:53.92,0:17:56.09,Default,,0,0,0,,Ал... сонда...
Dialogue: 0,0:17:56.63,0:18:00.05,Default,,0,0,0,,Сіз Кабу-самаға жарасатын әйел болуға шешім қабылдадыңыз, солай ма?
Dialogue: 0,0:18:00.22,0:18:02.26,Default,,0,0,0,,Аха…
Dialogue: 0,0:18:03.05,0:18:05.06,Default,,0,0,0,,Аа, кешіріңізші.
Dialogue: 0,0:18:05.60,0:18:08.43,Default,,0,0,0,,Неліктен күресуді шештіңіз?
Dialogue: 0,0:18:10.02,0:18:13.27,Default,,0,0,0,,Бронды жөндеу әлі де күресуде, солай емес пе?
Dialogue: 0,0:18:13.40,0:18:16.82,Default,,0,0,0,,Неліктен Нацуме өз өмірін қатерге тігеді?
Dialogue: 0,0:18:18.53,0:18:20.03,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:21.11,0:18:22.03,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:18:22.53,0:18:24.62,Default,,0,0,0,,Осының ішінде қамалып қалу
Dialogue: 0,0:18:24.74,0:18:27.79,Default,,0,0,0,,Кейде тірі екенімді ұмытып кете жаздаймын.
Dialogue: 0,0:18:28.41,0:18:31.04,Default,,0,0,0,,Сол үшін жерге түсіп, төбелесесің бе?
Dialogue: 0,0:18:31.71,0:18:34.00,Default,,0,0,0,,Осындай кішкентай және лас жерде
Dialogue: 0,0:18:34.13,0:18:38.30,Default,,0,0,0,,Мен мақсатсыз өмір сүруге шыдай алмаймын.
Dialogue: 0,0:18:46.43,0:18:48.27,Default,,0,0,0,,Сіз не қарап тұрсыз?
Dialogue: 0,0:18:48.39,0:18:50.10,Default,,0,0,0,,Кел, Нацумэ
Dialogue: 0,0:18:51.77,0:18:55.19,Default,,0,0,0,,Бұл ертеде адамдар өмір сүрген қала.
Dialogue: 0,0:18:55.31,0:18:56.94,Default,,0,0,0,,Уау~ Керемет
Dialogue: 0,0:18:57.82,0:19:00.74,Default,,0,0,0,,Бұл бұрынғы жылжымалы бекіністің бөлігі.
Dialogue: 0,0:19:00.86,0:19:02.53,Default,,0,0,0,,Ескі декаденс?
Dialogue: 0,0:19:02.65,0:19:03.45,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:19:03.57,0:19:04.32,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,0:19:04.87,0:19:06.07,Default,,0,0,0,,Бұл сарқырама.
Dialogue: 0,0:19:06.28,0:19:08.29,Default,,0,0,0,,Тауға жауған жаңбыр төмен қарай ағады.
Dialogue: 0,0:19:08.41,0:19:10.29,Default,,0,0,0,,Я~
Dialogue: 0,0:19:10.50,0:19:11.75,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:19:15.17,0:19:16.13,Default,,0,0,0,,Өткір~
Dialogue: 0,0:19:16.25,0:19:19.25,Default,,0,0,0,,Хаха, бұл күнделікті әдетке айналды.
Dialogue: 0,0:19:19.38,0:19:20.26,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:20.38,0:19:23.26,Default,,0,0,0,,Нацумэ Дүние тыныш болса
Dialogue: 0,0:19:23.38,0:19:25.59,Default,,0,0,0,,Біз де жер бетінде өмір сүре аламыз.
Dialogue: 0,0:19:26.05,0:19:27.22,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:19:27.35,0:19:28.18,Default,,0,0,0,,О
Dialogue: 0,0:19:28.31,0:19:30.56,Default,,0,0,0,,Сіз қалаған жерде өмір сүре аласыз.
Dialogue: 0,0:19:30.68,0:19:34.10,Default,,0,0,0,,Бұл адамдарға бастапқыда рұқсат етілген еркіндік.
Dialogue: 0,0:19:34.44,0:19:36.94,Default,,0,0,0,,Сонда мен де жауынгер боламын.
Dialogue: 0,0:19:37.06,0:19:38.98,Default,,0,0,0,,Сосын ұрысты аяқтаңыз!
Dialogue: 0,0:19:39.11,0:19:39.86,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:19:53.12,0:19:54.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:54.12,0:19:55.50,Default,,0,0,0,,Жақсысың ба? Жүзбе
Dialogue: 0,0:19:55.62,0:19:57.29,Default,,0,0,0,,Ол мұны қайтадан жасады.
Dialogue: 0,0:19:57.42,0:19:59.63,Default,,0,0,0,,Мазасыз адамсың, сондықтан аулақ жүр.
Dialogue: 0,0:20:01.51,0:20:03.01,Default,,0,0,0,,Бірақ бұл қол
Dialogue: 0,0:20:03.13,0:20:06.38,Default,,0,0,0,,Жауынгер болғаның жақсы емес пе, ауыртпалық болған соң?
Dialogue: 0,0:20:08.01,0:20:11.39,Default,,0,0,0,,Жауынгер болуды тастап, басқа жұмысқа орналасу.
Dialogue: 0,0:20:12.77,0:20:15.64,Default,,0,0,0,,Танкер тек құлдырауда болуы керек.
Dialogue: 0,0:20:16.60,0:20:18.48,Default,,0,0,0,,Сол қарулармен соғысу үшін...
Dialogue: 0,0:20:19.56,0:20:22.57,Default,,0,0,0,,Мені ешкім өзгерте алмайды
Dialogue: 0,0:20:30.53,0:20:32.08,Default,,0,0,0,,Әрқашан осылай
Dialogue: 0,0:20:38.83,0:20:41.21,Default,,0,0,0,,Сіз қанша уақыт тамақ ішесіз?
Dialogue: 0,0:20:41.34,0:20:42.71,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:20:42.84,0:20:44.34,Default,,0,0,0,,Бұл соңғы түскі ас.
Dialogue: 0,0:20:44.97,0:20:47.72,Default,,0,0,0,,Хаха...
Dialogue: 0,0:20:48.01,0:20:50.10,Default,,0,0,0,,Мен әлемді өзгерткім келмеді
Dialogue: 0,0:20:50.80,0:20:52.97,Default,,0,0,0,,Мен өзімді өзгерткім келді.
Dialogue: 0,0:20:52.97,0:20:54.06,Default,,0,0,0,,Мен өзімді өзгерткім келді.
Dialogue: 0,0:20:52.97,0:20:54.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:54.06,0:20:54.31,Default,,0,0,0,,Мен өзімді өзгерткім келді.
Dialogue: 0,0:20:55.02,0:20:57.44,Default,,0,0,0,,Маған қазіргі күйім ұнамайды.
Dialogue: 0,0:20:57.94,0:20:59.60,Default,,0,0,0,,Мен өзімді сенімді сезінгім келеді
Dialogue: 0,0:21:00.40,0:21:01.94,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:21:02.19,0:21:04.11,Default,,0,0,0,,Сондықтан мен ұрысамын
Dialogue: 0,0:21:04.57,0:21:05.86,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:21:07.11,0:21:09.99,Default,,0,0,0,,Ах! Еттің соңғы бөлігі! Апыр-ай!
Dialogue: 0,0:21:11.07,0:21:13.74,Default,,0,0,0,,Жақында кетеміз. Сіз келесіз, солай ма?
Dialogue: 0,0:21:14.04,0:21:15.25,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:15.37,0:21:16.41,Default,,0,0,0,,Ммммммм...
Dialogue: 0,0:21:19.00,0:21:19.88,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:20.00,0:21:21.54,Default,,0,0,0,,Гемо Гономафени
Dialogue: 0,0:21:21.67,0:21:23.09,Default,,0,0,0,,Әй!
Dialogue: 0,0:21:23.21,0:21:25.26,Default,,0,0,0,,Маған қарызға ақша бере аласыз ба?
Dialogue: 0,0:21:25.71,0:21:26.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:32.85,0:21:35.68,Default,,0,0,0,,Оқиға 15 минуттан кейін басталады
Dialogue: 0,0:21:36.73,0:21:37.98,Default,,0,0,0,,Барлық қызметкерлер
Dialogue: 0,0:21:37.98,0:21:38.14,Default,,0,0,0,,Барлық қызметкерлер
Dialogue: 0,0:21:37.98,0:21:38.14,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:38.14,0:21:38.27,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:38.27,0:21:38.81,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:38.27,0:21:38.81,Default,,0,0,0,,Тез арада өз позицияңызды алыңыз.
Dialogue: 0,0:21:38.81,0:21:40.06,Default,,0,0,0,,Тез арада өз позицияңызды алыңыз.
Dialogue: 0,0:21:40.06,0:21:40.94,Default,,0,0,0,,Тез арада өз позицияңызды алыңыз.
Dialogue: 0,0:21:40.06,0:21:40.94,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:21:40.94,0:21:41.27,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:21:41.44,0:21:41.98,Default,,0,0,0,,Қайталаңыз
Dialogue: 0,0:21:41.98,0:21:42.98,Default,,0,0,0,,Қайталаңыз
Dialogue: 0,0:21:41.98,0:21:42.98,Default,,0,0,0,,Сіз ұрыс даласына кіргіңіз келе ме?
Dialogue: 0,0:21:42.98,0:21:43.11,Default,,0,0,0,,Сіз ұрыс даласына кіргіңіз келе ме?
Dialogue: 0,0:21:43.11,0:21:43.44,Default,,0,0,0,,Сіз ұрыс даласына кіргіңіз келе ме?
Dialogue: 0,0:21:43.11,0:21:43.44,Default,,0,0,0,,Оқиға 15 минуттан кейін басталады
Dialogue: 0,0:21:43.44,0:21:43.98,Default,,0,0,0,,Оқиға 15 минуттан кейін басталады
Dialogue: 0,0:21:43.98,0:21:45.61,Default,,0,0,0,,Оқиға 15 минуттан кейін басталады
Dialogue: 0,0:21:43.98,0:21:45.61,Default,,0,0,0,,Бұл ақымақ...
Dialogue: 0,0:21:45.61,0:21:46.15,Default,,0,0,0,,Оқиға 15 минуттан кейін басталады
Dialogue: 0,0:21:46.28,0:21:48.70,Default,,0,0,0,,(Қақпаның дыбысы)
Dialogue: 0,0:21:49.03,0:21:52.20,Default,,0,0,0,,Тыңдаңдар, балалар, бұл соңғы шайқас!
Dialogue: 0,0:21:52.62,0:21:54.49,Default,,0,0,0,,Еш нәрсеге қарамастан миссияны орындаңыз!
Dialogue: 0,0:21:54.83,0:21:56.24,Default,,0,0,0,,Жақсы! Иә!
Dialogue: 0,0:21:59.96,0:22:01.37,Default,,0,0,0,,Sortie~!
Dialogue: 0,0:22:02.71,0:22:04.21,Default,,0,0,0,,Уууу!
Dialogue: 0,0:22:04.34,0:22:05.38,Default,,0,0,0,,Хяхо~!
Dialogue: 0,0:22:15.31,0:22:18.73,Default,,0,0,0,,Ә? Аймақ па?
Dialogue: 0,0:22:19.85,0:22:24.86,Default,,0,0,0,,♪～
Dialogue: 0,0:23:44.77,0:23:49.77,Default,,0,0,0,,～♪
