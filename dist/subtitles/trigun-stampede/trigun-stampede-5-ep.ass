Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.84,Default,,0,0,0,,📻Кеменің құлауымен →
Dialogue: 0,0:00:06.84,0:00:11.31,Default,,0,0,0,,Біз, күнәһар адамдар, осы жерге қондық.
Dialogue: 0,0:00:11.31,0:00:14.31,Default,,0,0,0,,📻Дұға ету.
Dialogue: 0,0:00:14.31,0:00:18.65,Default,,0,0,0,,📻Құдай біз үшін құтқарушы періштелерді пайдаланады.
Dialogue: 0,0:00:18.65,0:00:26.09,Default,,0,0,0,,📻Періштелерді мадақтап, періштелерді құрметте, періштелердің көзі бол.
Dialogue: 0,0:00:26.09,0:00:29.96,Default,,0,0,0,,📻Алла разы болсын.
Dialogue: 0,0:00:29.96,0:00:31.96,Default,,0,0,0,,Гохо гохо гохо гохо….
Dialogue: 0,0:00:35.83,0:00:40.14,Default,,0,0,0,,《Құдай... жел соқсын.
Dialogue: 0,0:00:40.14,0:00:44.94,Default,,0,0,0,,Әйтпесе мен...》
Dialogue: 0,0:02:29.21,0:02:32.41,Default,,0,0,0,,📻Екі періште түскенде→
Dialogue: 0,0:02:32.41,0:02:36.28,Default,,0,0,0,,Аспанда жарық көпірі салынған→
Dialogue: 0,0:02:36.28,0:02:40.59,Default,,0,0,0,,Бізді Құдай Патшалығына алып барады.
Dialogue: 0,0:02:40.59,0:02:42.76,Default,,0,0,0,,Уф, ыстық...
Dialogue: 0,0:02:42.76,0:02:46.26,Default,,0,0,0,,Кешіріңіз, өзгерте аламын ба? радио.
Dialogue: 0,0:02:48.63,0:02:51.40,Default,,0,0,0,,Бұл не? Қазір.
Dialogue: 0,0:02:51.40,0:02:56.07,Default,,0,0,0,,Иә? Бұл діни бағдарлама.
Dialogue: 0,0:02:56.07,0:03:00.91,Default,,0,0,0,,Өсімдіктерге табынатын шіркеу.
Dialogue: 0,0:03:00.91,0:03:06.25,Default,,0,0,0,,Бұл жаңа дін деп аталады.
Dialogue: 0,0:03:06.25,0:03:11.92,Default,,0,0,0,,Шілдеде штаб бар дейді.
Dialogue: 0,0:03:11.92,0:03:15.89,Default,,0,0,0,,Ой... жоқ!
Dialogue: 0,0:03:15.89,0:03:17.93,Default,,0,0,0,,Мен енді ыстықты ұнатпаймын.
Dialogue: 0,0:03:17.93,0:03:19.93,Default,,0,0,0,,Басында... Иә?
Dialogue: 0,0:03:19.93,0:03:24.60,Default,,0,0,0,,Бұл жердегі шөл өте қалыпты түсті болды.
Dialogue: 0,0:03:24.60,0:03:27.10,Default,,0,0,0,,Күрсіну…. Бірақ бір түн!
Dialogue: 0,0:03:27.10,0:03:29.24,Default,,0,0,0,,Уау... Кенет→
Dialogue: 0,0:03:29.24,0:03:32.44,Default,,0,0,0,,Бірдеңе пайда болды.
Dialogue: 0,0:03:32.44,0:03:37.58,Default,,0,0,0,,Адам немесе аң? Оның нақты кім екені әлі белгісіз.
Dialogue: 0,0:03:37.58,0:03:40.58,Default,,0,0,0,,Өйткені оны көргендер...
Dialogue: 0,0:03:40.58,0:03:46.09,Default,,0,0,0,,Өйткені оны көргендердің бәрі өлтірілді!
Dialogue: 0,0:03:46.09,0:03:48.09,Default,,0,0,0,,Ахахахахахахаха….
Dialogue: 0,0:03:48.09,0:03:51.09,Default,,0,0,0,,Жәбірленушінің қанымен...
Dialogue: 0,0:03:51.09,0:03:55.20,Default,,0,0,0,,Бұл жердегі шөл түнде ашық қызыл түске боялған дейді.
Dialogue: 0,0:03:57.27,0:04:01.44,Default,,0,0,0,,Эй... Эй, салқындап бара жатыр ма?
Dialogue: 0,0:04:01.44,0:04:03.91,Default,,0,0,0,,Мен... Мен таң қалдым.
Dialogue: 0,0:04:03.91,0:04:06.27,Default,,0,0,0,,Хехехехехе.... Апыр-ай!
Dialogue: 0,0:04:06.27,0:04:08.31,Default,,0,0,0,,Уау! (Кенет тежеу дыбысы)
Dialogue: 0,0:04:08.31,0:04:11.41,Default,,0,0,0,,(Кенет тежеу дыбысы)
Dialogue: 0,0:04:11.41,0:04:15.28,Default,,0,0,0,,А... Кенет не болды?
Dialogue: 0,0:04:15.28,0:04:19.25,Default,,0,0,0,,А... анау... О?
Dialogue: 0,0:04:19.25,0:04:22.72,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:04:25.26,0:04:28.60,Default,,0,0,0,,Ол өлді... солай ма?
Dialogue: 0,0:04:28.60,0:04:32.60,Default,,0,0,0,,Жалаң қолмен бір ату. жалаң қол?
Dialogue: 0,0:04:32.60,0:04:35.24,Default,,0,0,0,,Сіз Millions Knives мүшесісіз бе?
Dialogue: 0,0:04:35.24,0:04:39.11,Default,,0,0,0,,Бұл мен айтқан құбыжық емес пе?
Dialogue: 0,0:04:39.11,0:04:41.08,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:04:41.08,0:04:43.15,Default,,0,0,0,,Менің өлгеніме біраз уақыт болды.
Dialogue: 0,0:04:43.15,0:04:47.28,Default,,0,0,0,,Пышақтар мұны істесе де, ол енді бұл жерде болмас еді.
Dialogue: 0,0:04:47.28,0:04:50.25,Default,,0,0,0,,Эй, Тонгари... А?
Dialogue: 0,0:04:57.36,0:05:00.60,Default,,0,0,0,,Сіз не істеп жатырсыз? О... эй!
Dialogue: 0,0:05:00.60,0:05:02.60,Default,,0,0,0,,Күрсін.
Dialogue: 0,0:05:05.97,0:05:08.24,Default,,0,0,0,,Иә? О?
Dialogue: 0,0:05:10.27,0:05:17.78,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:05:17.78,0:05:21.62,Default,,0,0,0,,📻Дұға ет.
Dialogue: 0,0:05:21.62,0:05:25.59,Default,,0,0,0,,📻Құдай біз үшін құтқарушы періштелерді пайдаланады.
Dialogue: 0,0:05:25.59,0:05:31.26,Default,,0,0,0,,📻 Періштелерді мадақтаңыз Періштелерді құрметтеңіз... (тоқыма дыбысы)
Dialogue: 0,0:05:31.26,0:05:34.26,Default,,0,0,0,,Ей анашым... Құдай неге →
Dialogue: 0,0:05:34.26,0:05:36.77,Default,,0,0,0,,Құрбандыққа шалынатын баланы жейсің бе?
Dialogue: 0,0:05:36.77,0:05:40.74,Default,,0,0,0,,⚟Бата әкелу.
Dialogue: 0,0:05:40.74,0:05:44.61,Default,,0,0,0,,Бірақ жесең, өлесің.
Dialogue: 0,0:05:44.61,0:05:48.11,Default,,0,0,0,,⚟Өлім – ақыры емес, бастамасы.
Dialogue: 0,0:05:48.11,0:05:51.91,Default,,0,0,0,,⚟Жәннатқа бару - керемет нәрсе.
Dialogue: 0,0:05:55.08,0:05:58.42,Default,,0,0,0,,Онда енді ешкім тұрмайтын сияқты.
Dialogue: 0,0:05:58.42,0:06:01.09,Default,,0,0,0,,Бұл тыныш.
Dialogue: 0,0:06:01.09,0:06:03.93,Default,,0,0,0,,Қараңдаршы, бұл ауылда өсімдіктер көп.
Dialogue: 0,0:06:03.93,0:06:05.96,Default,,0,0,0,,Ол ұрланған ба?
Dialogue: 0,0:06:05.96,0:06:09.23,Default,,0,0,0,,Жоқ, мүмкін... Иә?
Dialogue: 0,0:06:09.23,0:06:12.10,Default,,0,0,0,,Менің ойымша, олар бұл нәрсені электр энергиясын өндіру үшін айналдырды.
Dialogue: 0,0:06:12.10,0:06:14.07,Default,,0,0,0,,А, жел диірмені.
Dialogue: 0,0:06:14.07,0:06:18.44,Default,,0,0,0,,Бұл тоқтатылды. Ал, жел болуы керек.
Dialogue: 0,0:06:18.44,0:06:20.44,Default,,0,0,0,,Рас, жел әрқашан → болды
Dialogue: 0,0:06:20.44,0:06:22.41,Default,,0,0,0,,Соқпаса не істеуіміз керек?
Dialogue: 0,0:06:22.41,0:06:24.45,Default,,0,0,0,,Электр энергиясы ұзақ уақыт бойы өшіп қалды.
Dialogue: 0,0:06:24.45,0:06:27.78,Default,,0,0,0,,Иә? Тиісті механизм қандай?
Dialogue: 0,0:06:27.78,0:06:31.95,Default,,0,0,0,,Сондықтан бұл жел күші. Ақымақ.
Dialogue: 0,0:06:48.10,0:06:50.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:52.11,0:06:57.61,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:06:57.61,0:06:59.58,Default,,0,0,0,,Ваш мырза! ? Келме! Ах...
Dialogue: 0,0:07:01.62,0:07:04.12,Default,,0,0,0,,Идиот! Кенеттен секірмеңіз! иә….
Dialogue: 0,0:07:09.76,0:07:11.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:14.10,0:07:18.43,Default,,0,0,0,,Ваш... Төбелес! !
Dialogue: 0,0:07:18.43,0:07:20.60,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:07:20.60,0:07:22.77,Default,,0,0,0,,Идиот! Не, мен қатты таң қалдым.
Dialogue: 0,0:07:22.77,0:07:25.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:25.11,0:07:29.44,Default,,0,0,0,,Ол... Вашты тани ма? Иә.
Dialogue: 0,0:07:29.44,0:07:35.62,Default,,0,0,0,,Гуггу... Ваш тебе!
Dialogue: 0,0:07:35.62,0:07:38.69,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:07:42.26,0:07:44.76,Default,,0,0,0,,Ваш мырза! Үйге тығыл!
Dialogue: 0,0:07:44.76,0:07:47.43,Default,,0,0,0,,Оның мақсаты мен!
Dialogue: 0,0:07:47.43,0:07:50.43,Default,,0,0,0,,Цк... Сен сондай табандысың.
Dialogue: 0,0:07:50.43,0:07:53.27,Default,,0,0,0,,Гуа... Гуаааа! (мылтық)
Dialogue: 0,0:07:53.27,0:07:55.44,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:07:55.44,0:07:57.44,Default,,0,0,0,,Ах! Вольфвуд!
Dialogue: 0,0:07:57.44,0:08:00.14,Default,,0,0,0,,Қарғыс атсын! Гррр….
Dialogue: 0,0:08:04.95,0:08:06.98,Default,,0,0,0,,Tsk….
Dialogue: 0,0:08:06.98,0:08:22.26,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:08:22.26,0:08:27.10,Default,,0,0,0,,Ваш….
Dialogue: 0,0:08:27.10,0:08:32.37,Default,,0,0,0,,Төбелескен Ваш.
Dialogue: 0,0:08:38.05,0:08:41.12,Default,,0,0,0,,⚟Эй, сен Ролоға айттың ба? иә?
Dialogue: 0,0:08:41.12,0:08:44.79,Default,,0,0,0,,⚟Жоқ, бұл өте қиын.
Dialogue: 0,0:08:44.79,0:08:49.96,Default,,0,0,0,,⚟Мен сіздің сезіміңізді түсінемін. Бірақ бәрі оны бастан өткерді.
Dialogue: 0,0:08:49.96,0:08:54.63,Default,,0,0,0,,⚟Желсіз күні туған бала ақыры бата алады.
Dialogue: 0,0:08:54.63,0:08:59.20,Default,,0,0,0,,⚟Бұл керемет. ⚟Иә... Дұрыс.
Dialogue: 0,0:08:59.20,0:09:01.30,Default,,0,0,0,,⚟Роло қайтып келгенде →
Dialogue: 0,0:09:01.30,0:09:04.64,Default,,0,0,0,,Құрбандыққа шалыну туралы шешім қабылданғанын айтамын. Ах...
Dialogue: 0,0:09:04.64,0:09:07.94,Default,,0,0,0,,⚟Иә, иә. ⚟Бұл жақсы.
Dialogue: 0,0:09:12.31,0:09:23.96,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:09:23.96,0:09:26.93,Default,,0,0,0,,Төбелесті Ваш! !
Dialogue: 0,0:09:31.80,0:09:34.77,Default,,0,0,0,,Grrrrrr… Ugh….
Dialogue: 0,0:09:37.67,0:09:42.18,Default,,0,0,0,,Қарғыс атсын... ха ха….
Dialogue: 0,0:09:45.28,0:09:48.62,Default,,0,0,0,,Амансың ба? (еңіреді)
Dialogue: 0,0:09:48.62,0:09:53.09,Default,,0,0,0,,Күрсін... Тірі болғаныма қуанамын.
Dialogue: 0,0:09:53.09,0:09:57.09,Default,,0,0,0,,Ах... Ваш!
Dialogue: 0,0:09:57.09,0:09:59.63,Default,,0,0,0,,Төбелесті Ваш!
Dialogue: 0,0:09:59.63,0:10:03.13,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:10:03.13,0:10:06.27,Default,,0,0,0,,Бұл бұлыңғырлық! Сіз өлуге тырысасыз ба?
Dialogue: 0,0:10:06.27,0:10:08.97,Default,,0,0,0,,Мына жерден қайт! Ааа!
Dialogue: 0,0:10:19.35,0:10:22.75,Default,,0,0,0,,Ах... у... Ой?
Dialogue: 0,0:10:22.75,0:10:25.95,Default,,0,0,0,,Ваш мырза және басқалары, жақсысыз ба?
Dialogue: 0,0:10:25.95,0:10:29.59,Default,,0,0,0,,Келіңіздер ме?
Dialogue: 0,0:10:29.59,0:10:32.29,Default,,0,0,0,,Сіз артта қалуыңыз керек, жаңадан келген.
Dialogue: 0,0:10:32.29,0:10:36.97,Default,,0,0,0,,Біз ештеңе істей алмаймыз.
Dialogue: 0,0:10:39.17,0:10:44.47,Default,,0,0,0,,Төбелескен Ваш….
Dialogue: 0,0:10:51.91,0:10:54.42,Default,,0,0,0,,Қандай ақымақ.
Dialogue: 0,0:10:54.42,0:10:57.29,Default,,0,0,0,,Сіз де жақсы болыңыз.
Dialogue: 0,0:10:57.29,0:11:01.42,Default,,0,0,0,,Жоқ, мен оның өлуіне жол бердім деп ойладым.
Dialogue: 0,0:11:01.42,0:11:03.76,Default,,0,0,0,,Бірден өлсең бәрібір.
Dialogue: 0,0:11:03.76,0:11:07.10,Default,,0,0,0,,Хаха, бұл қорқынышты естіледі.
Dialogue: 0,0:11:07.10,0:11:09.90,Default,,0,0,0,,А... Сонда? иә?
Dialogue: 0,0:11:09.90,0:11:12.07,Default,,0,0,0,,Ақымақ болма.
Dialogue: 0,0:11:12.07,0:11:15.74,Default,,0,0,0,,Сіз бұл ауыл туралы білдіңіз бе?
Dialogue: 0,0:11:15.74,0:11:18.24,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:18.24,0:11:21.74,Default,,0,0,0,,Мен де білмеймін.
Dialogue: 0,0:11:21.74,0:11:24.25,Default,,0,0,0,,Анам шынымен мені жек көрген болар ма екен?
Dialogue: 0,0:11:24.25,0:11:31.59,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:11:31.59,0:11:33.59,Default,,0,0,0,,Уау...
Dialogue: 0,0:11:40.60,0:11:42.66,Default,,0,0,0,,Жақсысың ба? Ах...
Dialogue: 0,0:11:44.93,0:11:46.90,Default,,0,0,0,,Мен оны таптым.
Dialogue: 0,0:11:46.90,0:11:49.10,Default,,0,0,0,,Сіз Ролосыз ба?
Dialogue: 0,0:11:54.34,0:11:57.41,Default,,0,0,0,,Сенің анаң мені іздеуді өтінді.
Dialogue: 0,0:11:57.41,0:12:00.58,Default,,0,0,0,,Сіз үйден қашып кеттіңіз бе?
Dialogue: 0,0:12:00.58,0:12:04.25,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:12:04.25,0:12:08.59,Default,,0,0,0,,Сен... Ваш тепсеушісі, солай ма?
Dialogue: 0,0:12:08.59,0:12:11.93,Default,,0,0,0,,Не? Сіз мені танисыз ба?
Dialogue: 0,0:12:11.93,0:12:14.93,Default,,0,0,0,,Ал, ол атақты адам.
Dialogue: 0,0:12:14.93,0:12:18.30,Default,,0,0,0,,Ол Гуманоидты Тайфун деп аталады.
Dialogue: 0,0:12:18.30,0:12:21.40,Default,,0,0,0,,Хмм, оны қайдан естідің?
Dialogue: 0,0:12:21.40,0:12:25.44,Default,,0,0,0,,Мен тағы бір нәрсені білемін. Табиғи апаттар →
Dialogue: 0,0:12:25.44,0:12:28.08,Default,,0,0,0,,Апат әкелетін жындар.
Dialogue: 0,0:12:28.08,0:12:31.08,Default,,0,0,0,,Ах ха ха….
Dialogue: 0,0:12:31.08,0:12:33.58,Default,,0,0,0,,Гохо Гохо… Гохо…. Ах.
Dialogue: 0,0:12:33.58,0:12:38.09,Default,,0,0,0,,Мен ауырып тұрмын.
Dialogue: 0,0:12:38.09,0:12:40.42,Default,,0,0,0,,Үлкен болмай тұрып өлесің дейді.
Dialogue: 0,0:12:40.42,0:12:44.59,Default,,0,0,0,,Өйткені мен Құдайға сенбеймін→
Dialogue: 0,0:12:44.59,0:12:49.36,Default,,0,0,0,,Құдай маған көмектесе алмайды ма?
Dialogue: 0,0:12:56.44,0:12:59.74,Default,,0,0,0,,Жел соқпағандықтан бәрі қиыншылықта.
Dialogue: 0,0:12:59.74,0:13:02.31,Default,,0,0,0,,Өсімдік болмаса қиын болар еді.
Dialogue: 0,0:13:02.31,0:13:06.48,Default,,0,0,0,,Енді менмін... Иә? Ах...
Dialogue: 0,0:13:08.42,0:13:10.59,Default,,0,0,0,,Анашым, сіз уайымдадыңыз ба?
Dialogue: 0,0:13:10.59,0:13:14.26,Default,,0,0,0,,Мен жасадым. Көп.
Dialogue: 0,0:13:14.26,0:13:17.26,Default,,0,0,0,,Қиындыққа тап болғанда, мені есіңе ал.
Dialogue: 0,0:13:17.26,0:13:19.66,Default,,0,0,0,,Мен сізге міндетті түрде көмектесемін.
Dialogue: 0,0:13:22.43,0:13:25.90,Default,,0,0,0,,Құдай саған көмектеспесе, мен саған көмектесемін!
Dialogue: 0,0:13:37.25,0:13:40.42,Default,,0,0,0,,Әйтеуір дәріні →
Dialogue: 0,0:13:40.42,0:13:43.42,Default,,0,0,0,,Мен қайтып келгенде, Лоло әлдеқашан...
Dialogue: 0,0:13:43.42,0:13:47.29,Default,,0,0,0,,Басқаша айтқанда, көмектесемін деп үлкен ұсыныс жасамақ болғанмен →
Dialogue: 0,0:13:47.29,0:13:50.93,Default,,0,0,0,,Мен мұны істей алмадым.
Dialogue: 0,0:13:50.93,0:13:54.26,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:13:54.26,0:13:57.27,Default,,0,0,0,,Күрсін... Міне, келдің.
Dialogue: 0,0:13:57.27,0:14:01.40,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:14:01.40,0:14:05.11,Default,,0,0,0,,📻Иман келтіргендер үшін өлім жойылу емес.
Dialogue: 0,0:14:05.11,0:14:11.08,Default,,0,0,0,,📻Тек сенгендер ғана құтқарылып, махаббатқа толы болады.
Dialogue: 0,0:14:11.08,0:14:15.92,Default,,0,0,0,,📻Өлімге қуан, Өлімді мақта.
Dialogue: 0,0:14:15.92,0:14:18.75,Default,,0,0,0,,Ах... Уф...
Dialogue: 0,0:14:18.75,0:14:23.59,Default,,0,0,0,,📻Алла разы болсын.
Dialogue: 0,0:14:23.59,0:14:26.76,Default,,0,0,0,,Who?
Dialogue: 0,0:14:26.76,0:14:29.26,Default,,0,0,0,,Хехехехе….
Dialogue: 0,0:14:29.26,0:14:31.93,Default,,0,0,0,,Сіз құдайсыз ба?
Dialogue: 0,0:14:31.93,0:14:35.34,Default,,0,0,0,,Құдай деп табынатын адамың →
Dialogue: 0,0:14:35.34,0:14:37.37,Default,,0,0,0,,Қазір жоқ.
Dialogue: 0,0:14:37.37,0:14:41.54,Default,,0,0,0,,Аа... жіберші...
Dialogue: 0,0:14:49.58,0:14:52.92,Default,,0,0,0,,Сен де құрбан баласың ба?
Dialogue: 0,0:14:52.92,0:14:57.26,Default,,0,0,0,,Мен? Мүмкін емес.
Dialogue: 0,0:14:57.26,0:15:00.66,Default,,0,0,0,,Мен періштеммін.
Dialogue: 0,0:15:07.90,0:15:11.44,Default,,0,0,0,,Бұл дәрі дене жасушаларын нығайтады →
Dialogue: 0,0:15:11.44,0:15:17.58,Default,,0,0,0,,Қайта құру Ағзадағы зат алмасуды барынша жылдамдатады.
Dialogue: 0,0:15:17.58,0:15:19.58,Default,,0,0,0,,Hmph…. Егер сіздің денеңіз қолайлы болса →
Dialogue: 0,0:15:19.58,0:15:22.62,Default,,0,0,0,,Мүмкін мен сенің ауруыңды емдей алармын.
Dialogue: 0,0:15:22.62,0:15:26.65,Default,,0,0,0,,Әрине, біраз өтемақы болады →
Dialogue: 0,0:15:26.65,0:15:31.89,Default,,0,0,0,,Ең болмаса аурудан өлмейсің.
Dialogue: 0,0:15:31.89,0:15:37.90,Default,,0,0,0,,Ах, а... а...
Dialogue: 0,0:15:37.90,0:15:48.54,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:15:48.54,0:15:52.48,Default,,0,0,0,,Өлім... Менің өлгім келмейді...
Dialogue: 0,0:15:52.48,0:15:55.75,Default,,0,0,0,,Маған көмектесші, Ваш...
Dialogue: 0,0:15:55.75,0:16:01.72,Default,,0,0,0,,Ваш... Төбелес! !
Dialogue: 0,0:16:01.72,0:16:03.72,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:16:03.72,0:16:05.73,Default,,0,0,0,,Мүмкіндік бар!
Dialogue: 0,0:16:05.73,0:16:08.56,Default,,0,0,0,,Уф... аа...
Dialogue: 0,0:16:08.56,0:16:10.57,Default,,0,0,0,,Вольфвуд!
Dialogue: 0,0:16:13.90,0:16:17.21,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:16:17.21,0:16:24.25,Default,,0,0,0,,Төбелесті Ваш! !
Dialogue: 0,0:16:24.25,0:16:27.22,Default,,0,0,0,,Миға имплант терминалын орнату арқылы→
Dialogue: 0,0:16:27.22,0:16:30.89,Default,,0,0,0,,Эмоцияларыңызды кеңейтіп, моторикаңызды тездетіңіз →
Dialogue: 0,0:16:30.89,0:16:33.05,Default,,0,0,0,,Дамытуға болады.
Dialogue: 0,0:16:33.05,0:16:37.06,Default,,0,0,0,,Жек көру – өз жүрегін де жаралайтын у.
Dialogue: 0,0:16:37.06,0:16:42.46,Default,,0,0,0,,Жек көру сезімі Вамстың улы бездерінен де улы.
Dialogue: 0,0:16:42.46,0:16:46.07,Default,,0,0,0,,Ол бес жыл бойы шыдаған бірінші адам.
Dialogue: 0,0:16:46.07,0:16:48.07,Default,,0,0,0,,Бұл жолы...
Dialogue: 0,0:16:48.07,0:16:51.11,Default,,0,0,0,,Бұл тағы бір сәтсіздік.
Dialogue: 0,0:16:55.14,0:16:57.18,Default,,0,0,0,,А... бұл кім?
Dialogue: 0,0:16:57.18,0:17:00.92,Default,,0,0,0,,Мама, бұл менмін.
Dialogue: 0,0:17:00.92,0:17:02.88,Default,,0,0,0,,Rollo?
Dialogue: 0,0:17:02.88,0:17:04.92,Default,,0,0,0,,Иә, бұл менмін.
Dialogue: 0,0:17:04.92,0:17:08.39,Default,,0,0,0,,(Есікті қағу)
Dialogue: 0,0:17:10.39,0:17:13.93,Default,,0,0,0,,Уф… аа…. Анашым.
Dialogue: 0,0:17:13.93,0:17:17.47,Default,,0,0,0,,Дәл қазір. Ба... құбыжық!
Dialogue: 0,0:17:17.47,0:17:22.90,Default,,0,0,0,,Жоқ... Мен...
Dialogue: 0,0:17:22.90,0:17:25.87,Default,,0,0,0,,Уау! !
Dialogue: 0,0:17:25.87,0:17:27.91,Default,,0,0,0,,Лоло! !
Dialogue: 0,0:17:27.91,0:17:33.31,Default,,0,0,0,,📻Құдай біз үшін құтқарушы періштелерді пайдаланады.
Dialogue: 0,0:17:33.31,0:17:35.75,Default,,0,0,0,,Бұл не? Мұнда.
Dialogue: 0,0:17:35.75,0:17:38.55,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:17:38.55,0:17:41.76,Default,,0,0,0,,20 жыл? О?
Dialogue: 0,0:17:41.76,0:17:44.93,Default,,0,0,0,,📻Өлімге қуан, Өлімді мақта.
Dialogue: 0,0:17:44.93,0:17:47.80,Default,,0,0,0,,📻Өлім жойылу емес.
Dialogue: 0,0:17:50.57,0:17:52.77,Default,,0,0,0,,Не... нені айтып тұрсың?
Dialogue: 0,0:17:52.77,0:17:54.90,Default,,0,0,0,,А? ше? Жаңадан келген...
Dialogue: 0,0:17:54.90,0:17:58.07,Default,,0,0,0,,Мм... бұл...
Dialogue: 0,0:17:58.07,0:18:01.48,Default,,0,0,0,,Ваш мырза... солай ма?
Dialogue: 0,0:18:01.48,0:18:03.44,Default,,0,0,0,,Хмм….
Dialogue: 0,0:18:07.01,0:18:09.28,Default,,0,0,0,,Есте сақта! Сіз Роло болуыңыз керек!
Dialogue: 0,0:18:12.59,0:18:16.12,Default,,0,0,0,,Не деген ысырап... Уау!
Dialogue: 0,0:18:16.12,0:18:19.39,Default,,0,0,0,,Бұл әлдеқашан құбыжық!
Dialogue: 0,0:18:19.39,0:18:24.77,Default,,0,0,0,,Уау! !
Dialogue: 0,0:18:24.77,0:18:26.90,Default,,0,0,0,,Тыңда, Лоло!
Dialogue: 0,0:18:26.90,0:18:29.30,Default,,0,0,0,,Мен...
Dialogue: 0,0:18:29.30,0:18:47.22,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:18:47.22,0:18:53.76,Default,,0,0,0,,Роло... Сол кездегі кешірім сұраймын...
Dialogue: 0,0:18:53.76,0:18:58.40,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:18:58.40,0:19:04.37,Default,,0,0,0,,Саған уәде берсем де... мен...
Dialogue: 0,0:19:16.05,0:19:19.55,Default,,0,0,0,,Өтелмейтін ақымақ... пе...
Dialogue: 0,0:19:21.56,0:19:24.09,Default,,0,0,0,,Кешіріңіз, кешігіп қалдым...
Dialogue: 0,0:19:24.09,0:19:27.90,Default,,0,0,0,,Мен уәдемді орындаймын.
Dialogue: 0,0:19:27.90,0:19:33.10,Default,,0,0,0,,Мен жалғыз болуды аяқтадым.
Dialogue: 0,0:19:38.91,0:19:40.91,Default,,0,0,0,,Қандай ақымақ! !
Dialogue: 0,0:19:44.08,0:19:46.05,Default,,0,0,0,,Басқа адамның дүкенінің алдында дау шығармаңдар!
Dialogue: 0,0:19:49.22,0:19:51.39,Default,,0,0,0,,Лоло!
Dialogue: 0,0:19:51.39,0:20:33.06,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:20:33.06,0:20:35.73,Default,,0,0,0,,Оян... Ролло.
Dialogue: 0,0:20:35.73,0:20:39.53,Default,,0,0,0,,Оян, Роло!
Dialogue: 0,0:20:39.53,0:20:44.64,Default,,0,0,0,,Роло... Эй Роло... Эй...
Dialogue: 0,0:20:44.64,0:20:46.67,Default,,0,0,0,,Бұл туралы алаңдамаңыз.
Dialogue: 0,0:20:46.67,0:20:48.74,Default,,0,0,0,,Мен қазірдің өзінде өлдім.
Dialogue: 0,0:20:52.28,0:20:54.32,Default,,0,0,0,,Неге аттың? О?
Dialogue: 0,0:20:54.32,0:20:56.78,Default,,0,0,0,,Неліктен? Неліктен Роло!
Dialogue: 0,0:20:58.89,0:21:01.19,Default,,0,0,0,,Мейірімділік. иә?
Dialogue: 0,0:21:03.42,0:21:06.56,Default,,0,0,0,,Бұл жігіт адам болып қайта орала алмайды.
Dialogue: 0,0:21:06.56,0:21:09.73,Default,,0,0,0,,Оны тірі қалдырған дұрыс.
Dialogue: 0,0:21:09.73,0:21:13.07,Default,,0,0,0,,Бұл сіздің шешіміңізге байланысты емес.
Dialogue: 0,0:21:13.07,0:21:16.74,Default,,0,0,0,,А... бұл сенің екіжүзділігің.
Dialogue: 0,0:21:16.74,0:21:21.18,Default,,0,0,0,,Жауапкершілікті өз мойнына ала алмайтын адамдар қалағанын істей алады→
Dialogue: 0,0:21:21.18,0:21:24.75,Default,,0,0,0,,Оның үстірт өсектен айырмашылығы жоқ.
Dialogue: 0,0:21:28.38,0:21:31.29,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:21:31.29,0:21:35.22,Default,,0,0,0,,Ах…. иә? (жел дыбысы)
Dialogue: 0,0:21:35.22,0:21:37.42,Default,,0,0,0,,Жел... (жел дыбысы)
Dialogue: 0,0:21:37.42,0:21:44.60,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:21:47.30,0:21:50.74,Default,,0,0,0,,көремін. Ол өлді ме?
Dialogue: 0,0:21:50.74,0:21:54.21,Default,,0,0,0,,Хехе... Бұл жақсы.
Dialogue: 0,0:21:54.21,0:21:59.25,Default,,0,0,0,,Мені істен шыққан өнімдерді жою қиындықтарынан құтқарады.
Dialogue: 0,0:21:59.25,0:22:02.15,Default,,0,0,0,,Жарайды, мен де өлтірдім →
Dialogue: 0,0:22:02.15,0:22:05.39,Default,,0,0,0,,Бұл бір дәрігердің жұмысы.
Dialogue: 0,0:22:05.39,0:22:10.42,Default,,0,0,0,,А, мен сенімдімін Николай...
Dialogue: 0,0:22:10.42,0:22:14.90,Default,,0,0,0,,Жоқ... бұл Жазалаушы.
Dialogue: 0,0:22:17.90,0:22:29.08,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:22:30.58,0:22:35.58,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
