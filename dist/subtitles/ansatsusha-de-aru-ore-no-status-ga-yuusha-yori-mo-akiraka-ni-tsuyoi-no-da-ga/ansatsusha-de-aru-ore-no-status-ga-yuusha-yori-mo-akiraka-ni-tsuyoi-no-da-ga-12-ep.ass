Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.59,0:00:12.55,Default,,0,0,0,,Бұл Грам...
Dialogue: 0,0:00:12.63,0:00:14.34,Default,,0,0,0,,Құрметті Амелия
Dialogue: 0,0:00:14.43,0:00:17.76,Default,,0,0,0,,Менің сізбен сөйлескім келетін нәрсе бар.
Dialogue: 0,0:00:17.85,0:00:20.93,Default,,0,0,0,,Менің үйіме келе аласыз ба?
Dialogue: 0,0:00:26.65,0:00:28.94,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:00:29.44,0:00:32.94,Default,,0,0,0,,Әңгімелесуге ең айқын нүктеде араласу?
Dialogue: 0,0:00:33.03,0:00:34.99,Default,,0,0,0,,Сәлем! Сіз гильдия шебері болсаңыз да
Dialogue: 0,0:00:35.07,0:00:37.87,Default,,0,0,0,,Мен сені қараңғы өлтірушіге (Үнсіз өлтіруші) тіл тигізгеніңді кешірмеймін!
Dialogue: 0,0:00:37.95,0:00:39.37,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:00:39.45,0:00:43.66,Default,,0,0,0,,Шақырылған батырлар мен үміткерлер Жын патшасын өлтіру үшін барын салады.
Dialogue: 0,0:00:43.75,0:00:47.46,Default,,0,0,0,,Бұл дүниенің заңы болса да
Dialogue: 0,0:00:47.54,0:00:50.38,Default,,0,0,0,,Ойнап жүрген ақымақтарға келсек
Dialogue: 0,0:00:50.46,0:00:51.55,Default,,0,0,0,,мен жіпті көремін.
Dialogue: 0,0:00:51.63,0:00:54.09,Default,,0,0,0,,Мен не істейтінімді шешемін.
Dialogue: 0,0:00:54.17,0:00:56.09,Default,,0,0,0,,Басқалардан нұсқау алуға ешқандай себеп жоқ.
Dialogue: 0,0:00:56.18,0:00:59.01,Default,,0,0,0,,О, қандай жүрексіз
Dialogue: 0,0:00:59.10,0:01:02.81,Default,,0,0,0,,Сарайдан қашып құтылу үшін өзін құрбан еткен адам.
Dialogue: 0,0:01:02.89,0:01:04.23,Default,,0,0,0,,Сізге сыйақы берілмейді.
Dialogue: 0,0:01:06.27,0:01:07.73,Default,,0,0,0,,Сіз кім туралы айтып отырсыз?
Dialogue: 0,0:01:07.81,0:01:09.77,Default,,0,0,0,,Саран Мисрей
Dialogue: 0,0:01:09.86,0:01:14.57,Default,,0,0,0,,Ыңғайсыз әрі күлкілі аяқталу өте тамаша болды.
Dialogue: 0,0:01:15.07,0:01:19.16,Default,,0,0,0,,Түнгі қарғаларға камера қондырған дұрыс болды.
Dialogue: 0,0:01:20.99,0:01:22.41,Default,,0,0,0,,Бұлай айтқаныңызға жарайсыз.
Dialogue: 0,0:01:22.49,0:01:23.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:23.87,0:01:26.25,Default,,0,0,0,,О, сен де көргің келе ме?
Dialogue: 0,0:01:26.33,0:01:28.00,Default,,0,0,0,,Мен есеп жүргіздім.
Dialogue: 0,0:01:28.58,0:01:32.05,Default,,0,0,0,,Маған бұлай айтқаның қате болды.
Dialogue: 0,0:01:32.13,0:01:36.17,Default,,0,0,0,,Мына бейшаралардың не айтатынын түсінбеймін.
Dialogue: 0,0:01:36.76,0:01:38.59,Default,,0,0,0,,L өліпті
Dialogue: 0,0:01:41.60,0:01:42.76,Default,,0,0,0,,Гильдия шебері!
Dialogue: 0,0:01:42.85,0:01:44.60,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:01:44.68,0:01:47.52,Default,,0,0,0,,Ешқандай қылмыс жасамаған авантюристке зиян тигізбеу...
Dialogue: 0,0:01:48.60,0:01:49.77,Default,,0,0,0,,Кяаа!
Dialogue: 0,0:01:49.85,0:01:50.65,Default,,0,0,0,,Келия!
Dialogue: 0,0:01:51.31,0:01:53.11,Default,,0,0,0,,Қауіпсіз ханшайым Амелия
Dialogue: 0,0:01:53.19,0:01:54.65,Default,,0,0,0,,Жолыңызға түскендерді өлтіріңіз!
Dialogue: 0,0:01:54.73,0:01:56.90,Default,,0,0,0,,Рауль! Келияны алып, жүгір!
Dialogue: 0,0:01:56.99,0:01:57.70,Default,,0,0,0,,Жұқа!
Dialogue: 0,0:02:04.24,0:02:05.58,Default,,0,0,0,,Бар болуды жасыру
Dialogue: 0,0:02:14.67,0:02:16.59,Default,,0,0,0,,Акираның орналасқан жері қаралуда!
Dialogue: 0,0:02:16.67,0:02:17.92,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:02:18.01,0:02:20.72,Default,,0,0,0,,Қатысудың жоғары деңгейін пайдалану жасыру болып табылады
Dialogue: 0,0:02:20.80,0:02:23.93,Default,,0,0,0,,Өйткені мен түнгі қарға камерасын қарап отырдым.
Dialogue: 0,0:02:24.01,0:02:27.18,Default,,0,0,0,,Мен сенің ханшайымды аңдып жүргеніңді білдім.
Dialogue: 0,0:02:27.27,0:02:31.19,Default,,0,0,0,,Мен оған Саранның зұлым көзіне ұқсайтын механизм жасауды тапсырдым.
Dialogue: 0,0:02:36.78,0:02:37.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:49.46,0:02:50.37,Default,,0,0,0,,Уф... Иә?
Dialogue: 0,0:02:51.21,0:02:52.00,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:54.50,0:02:57.09,Default,,0,0,0,,Егер ол кездейсоқ Амелияның қасында бақылаудан шығып кетсе...
Dialogue: 0,0:02:57.17,0:02:58.38,Default,,0,0,0,,Гравитация!
Dialogue: 0,0:03:01.13,0:03:02.05,Default,,0,0,0,,Бұл...
Dialogue: 0,0:03:02.14,0:03:03.05,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:03:03.72,0:03:04.97,Default,,0,0,0,,Ашулансаң, қаш!
Dialogue: 0,0:03:05.05,0:03:05.93,Default,,0,0,0,,Құдай-ай, бұл жігіт шынымен де соған батып кетті ғой, иә?
Dialogue: 0,0:03:06.01,0:03:07.56,Default,,0,0,0,,Амелия осылай!
Dialogue: 0,0:03:09.48,0:03:10.94,Default,,0,0,0,,Менің қашып кетуіме жол берме. Мені қу!
Dialogue: 0,0:03:17.78,0:03:20.53,Default,,0,0,0,,Сіз қашып бара жатырсыз ба? Маған қалдырыңыз
Dialogue: 0,0:03:21.03,0:03:23.03,Default,,0,0,0,,♪～
Dialogue: 0,0:03:26.99,0:03:29.62,Default,,0,0,0,,Сіз қалай ойлайсыз? Мен аспанда ұша аламын
Dialogue: 0,0:03:29.70,0:03:30.83,Default,,0,0,0,,Бұл таңқаларлық емес пе?
Dialogue: 0,0:03:30.91,0:03:32.71,Default,,0,0,0,,Рахмет сізге Тор Наил
Dialogue: 0,0:03:32.79,0:03:34.08,Default,,0,0,0,,Мен құтқарылдым.
Dialogue: 0,0:03:34.17,0:03:36.25,Default,,0,0,0,,Бұл өте жеңіл
Dialogue: 0,0:03:36.34,0:03:39.17,Default,,0,0,0,,Өйткені сендер менің сүйіктілерімсіңдер.
Dialogue: 0,0:03:47.14,0:03:48.22,Default,,0,0,0,,Әдемі...
Dialogue: 0,0:03:49.18,0:03:51.39,Default,,0,0,0,,Әдемі екен.
Dialogue: 0,0:05:00.13,0:05:02.13,Default,,0,0,0,,～♪
Dialogue: 0,0:05:05.13,0:05:06.51,Default,,0,0,0,,Қайта қош келдіңіз Йору
Dialogue: 0,0:05:06.59,0:05:09.30,Default,,0,0,0,,Мен аз ғана уақыт тоқтай алдым, бірақ...
Dialogue: 0,0:05:09.39,0:05:10.89,Default,,0,0,0,,Жоқ, жеткілікті.
Dialogue: 0,0:05:11.43,0:05:13.89,Default,,0,0,0,,Олай болса мен осы жерден қоштасамын.
Dialogue: 0,0:05:14.56,0:05:15.89,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:05:17.27,0:05:21.86,Default,,0,0,0,,Менің көз алдымда біреуді өлтіргеніңді қаламаймын.
Dialogue: 0,0:05:23.28,0:05:24.15,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:25.24,0:05:27.66,Default,,0,0,0,,Бір жерде кездескенше
Dialogue: 0,0:05:31.20,0:05:32.91,Default,,0,0,0,,Грамды көрдіңіз бе?
Dialogue: 0,0:05:33.58,0:05:34.37,Default,,0,0,0,,О
Dialogue: 0,0:05:35.50,0:05:37.71,Default,,0,0,0,,Оның қасында күшейтілген сарбазға ұқсайтын адамдар да болды.
Dialogue: 0,0:05:37.79,0:05:40.04,Default,,0,0,0,,Сіз жарақат аласыз
Dialogue: 0,0:05:40.54,0:05:42.84,Default,,0,0,0,,Күшейтілген сарбаздар әлі де күшті ме?
Dialogue: 0,0:05:42.92,0:05:47.34,Default,,0,0,0,,Бірден болса, сіз оны жеңе аласыз, бірақ бірнеше қарсыласыңыз болса, бұл қиын.
Dialogue: 0,0:05:47.43,0:05:50.35,Default,,0,0,0,,Белгілерді жасыру шаралары қабылданды.
Dialogue: 0,0:05:50.43,0:05:52.93,Default,,0,0,0,,Біздің барлық шабуылдар сәтсіз аяқталды.
Dialogue: 0,0:05:53.43,0:05:56.48,Default,,0,0,0,,Құдіретім қашып бара жатқандай біртүрлі сезім болды.
Dialogue: 0,0:05:56.98,0:06:02.36,Default,,0,0,0,,Медицина күшейген артық сиқырлы күш қару-жарақ пен қару-жараққа арналса керек.
Dialogue: 0,0:06:04.15,0:06:06.36,Default,,0,0,0,,Тікелей соқтығысудың мәні жоқ.
Dialogue: 0,0:06:06.44,0:06:08.49,Default,,0,0,0,,Бірақ өлтіруші болса
Dialogue: 0,0:06:08.57,0:06:11.12,Default,,0,0,0,,Мұны істеудің бір жолы бар емес пе?
Dialogue: 0,0:06:11.74,0:06:12.78,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:06:12.87,0:06:15.75,Default,,0,0,0,,Акира жасайды деп шешіп қойғандай сөйлеп тұрсың.
Dialogue: 0,0:06:15.83,0:06:20.04,Default,,0,0,0,,Мен Амелия ханшайымның дәл көзінше қашып кетуіне жол берсем ше?
Dialogue: 0,0:06:20.12,0:06:22.63,Default,,0,0,0,,Бұдан былай мен сендерді үлкен ынтамен мақсат етемін.
Dialogue: 0,0:06:23.46,0:06:26.01,Default,,0,0,0,,Грам - бұл адам.
Dialogue: 0,0:06:29.80,0:06:33.39,Default,,0,0,0,,Амелия, бүгін кеш болды, демалыңыз.
Dialogue: 0,0:06:33.47,0:06:34.43,Default,,0,0,0,,Йору да
Dialogue: 0,0:06:34.51,0:06:35.72,Default,,0,0,0,,Ия... бірақ...
Dialogue: 0,0:06:36.60,0:06:37.93,Default,,0,0,0,,Негізгі зал…
Dialogue: 0,0:06:38.02,0:06:38.77,Default,,0,0,0,,(Кристалдың көтерілу дыбысы)
Dialogue: 0,0:06:39.60,0:06:41.48,Default,,0,0,0,,Мен біраз уақыт жалғыз қалғым келеді
Dialogue: 0,0:06:42.15,0:06:43.11,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:06:43.19,0:06:46.78,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:06:51.41,0:06:52.24,Default,,0,0,0,,Фу…
Dialogue: 0,0:07:01.37,0:07:02.46,Default,,0,0,0,,Сіз айтқандай
Dialogue: 0,0:07:02.54,0:07:06.13,Default,,0,0,0,,Елордадан шығатын жолдың барлық кіреберістеріне қарауылдар орнатылды.
Dialogue: 0,0:07:06.21,0:07:07.84,Default,,0,0,0,,Іздеу?
Dialogue: 0,0:07:07.92,0:07:10.01,Default,,0,0,0,,Біз қазір ақпарат жинап жатырмыз.
Dialogue: 0,0:07:10.09,0:07:13.72,Default,,0,0,0,,Мен ханшайымның қайда болатынын келесі бір-екі күнде білетін боламыз деп ойлаймын.
Dialogue: 0,0:07:13.80,0:07:16.64,Default,,0,0,0,,Маған ертең түске дейін керек.
Dialogue: 0,0:07:16.72,0:07:18.14,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:07:18.22,0:07:19.77,Default,,0,0,0,,(тізбектердің дірілдеген дыбысы)
Dialogue: 0,0:07:36.95,0:07:40.29,Default,,0,0,0,,Мм... неге бұлай істедің?
Dialogue: 0,0:07:40.79,0:07:42.75,Default,,0,0,0,,Бұл ойын-сауық.
Dialogue: 0,0:07:43.33,0:07:47.38,Default,,0,0,0,,Кейбір адамдар бір жыл ішінде өмір бойы сыйқырлы күш-қуатты пайдаланып өледі.
Dialogue: 0,0:07:47.46,0:07:50.01,Default,,0,0,0,,Сіз бұл туралы не істейсіз?
Dialogue: 0,0:07:50.09,0:07:53.76,Default,,0,0,0,,Дәрі бар болса, оны қалағаныңызша толтыра аласыз.
Dialogue: 0,0:07:53.84,0:07:56.89,Default,,0,0,0,,Егер сіз Амелия ханшайымын жындарға сатсаңыз ...
Dialogue: 0,0:07:56.97,0:07:58.72,Default,,0,0,0,,Сирек кездесетін материалдарды алу
Dialogue: 0,0:07:58.81,0:08:03.60,Default,,0,0,0,,Сіз осындай нәрсеге қарағанда әлдеқайда жоғары сапалы күшейтілген сарбаздарды жасай аласыз.
Dialogue: 0,0:08:05.48,0:08:08.73,Default,,0,0,0,,Ал, мен үзіліс жасайын.
Dialogue: 0,0:08:08.82,0:08:13.32,Default,,0,0,0,,Айналадағы қауіпсіздікті күшейту үшін сарбаздар санын көбейтіңіз.
Dialogue: 0,0:08:13.40,0:08:14.91,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:08:32.42,0:08:35.84,Default,,0,0,0,,Егер біз мұны жасамасақ, Амелия табанды түрде нысанаға алынады.
Dialogue: 0,0:08:35.93,0:08:39.81,Default,,0,0,0,,Және ол Саран көсемнің өліміне тіл тигізді.
Dialogue: 0,0:08:39.89,0:08:42.02,Default,,0,0,0,,Оны ешқашан тірі қалдырмаңыз
Dialogue: 0,0:08:47.15,0:08:48.86,Default,,0,0,0,,Мен шешіп қойдым
Dialogue: 0,0:08:51.28,0:08:55.49,Default,,0,0,0,,Мен күшейтілген сарбазға тап болған жағдайда қара қаруды дайындауым керек.
Dialogue: 0,0:08:56.16,0:08:56.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:58.78,0:08:59.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:00.20,0:09:02.70,Default,,0,0,0,,Бұл дұрыс...
Dialogue: 0,0:09:03.50,0:09:05.58,Default,,0,0,0,,Себебі оны жетекші дайындаған.
Dialogue: 0,0:09:05.67,0:09:07.46,Default,,0,0,0,,Пайдалы болатынына сенімдімін
Dialogue: 0,0:09:10.63,0:09:11.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:15.13,0:09:18.05,Default,,0,0,0,,Иә? Мен дұрыс суретке түсіре аламын ба деп ойлаймын?
Dialogue: 0,0:09:18.14,0:09:19.47,Default,,0,0,0,,Ах
Dialogue: 0,0:09:22.01,0:09:23.72,Default,,0,0,0,,Сәлем Акира-кун
Dialogue: 0,0:09:27.02,0:09:29.31,Default,,0,0,0,,Көшбасшы Саран...
Dialogue: 0,0:09:33.11,0:09:34.57,Default,,0,0,0,,Сіз таң қалдыңыз ба?
Dialogue: 0,0:09:35.57,0:09:38.49,Default,,0,0,0,,Шындығында, бұл маған бірдеңе болған жағдайда ғана.
Dialogue: 0,0:09:38.57,0:09:39.99,Default,,0,0,0,,Менде дайын.
Dialogue: 0,0:09:40.07,0:09:45.00,Default,,0,0,0,,Саған да, маған да кез келген уақытта кез келген нәрсе болуы мүмкін.
Dialogue: 0,0:09:45.71,0:09:49.38,Default,,0,0,0,,Дегенмен, құпия сақталған нәрсені ашу
Dialogue: 0,0:09:49.46,0:09:50.63,Default,,0,0,0,,Ондай нәрсе жоқ.
Dialogue: 0,0:09:51.59,0:09:53.63,Default,,0,0,0,,Сіз үлкен үміт күттіңіз бе?
Dialogue: 0,0:09:53.71,0:09:56.30,Default,,0,0,0,,А... олай істеме.
Dialogue: 0,0:09:56.38,0:09:59.51,Default,,0,0,0,,Мен саған бір рет айтқанмын
Dialogue: 0,0:09:59.59,0:10:01.01,Default,,0,0,0,,Тағы да айтқым келеді
Dialogue: 0,0:10:01.10,0:10:01.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:02.31,0:10:05.98,Default,,0,0,0,,Сіз аман қалып, отбасыңызға оралуыңыз керек.
Dialogue: 0,0:10:06.06,0:10:08.44,Default,,0,0,0,,Адамдарды өлтірмейтін өлтіруші бол
Dialogue: 0,0:10:09.65,0:10:10.90,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:10:10.98,0:10:11.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:11.94,0:10:14.94,Default,,0,0,0,,Акира-кун ақырында өзінің бастапқы әлеміне оралады...
Dialogue: 0,0:10:15.44,0:10:18.32,Default,,0,0,0,,Әзірге бұл тыныш және бір-бірімізді өлтірудің қажеті жоқ.
Dialogue: 0,0:10:18.40,0:10:20.74,Default,,0,0,0,,Мен өмір сүретін елге қайтамын.
Dialogue: 0,0:10:26.00,0:10:27.25,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:10:27.33,0:10:32.63,Default,,0,0,0,,Сондықтан мен үшін кек аламын деп ойламаңыз.
Dialogue: 0,0:10:33.71,0:10:37.47,Default,,0,0,0,,(Акираның жылағаны)
Dialogue: 0,0:10:37.55,0:10:38.38,Default,,0,0,0,,Неге...
Dialogue: 0,0:10:38.47,0:10:40.93,Default,,0,0,0,,Бұл дүниеде не болды
Dialogue: 0,0:10:41.01,0:10:44.76,Default,,0,0,0,,Акира-кун мүлде жауапкершілікті сезінбейді.
Dialogue: 0,0:10:45.26,0:10:47.14,Default,,0,0,0,,Болмауы керек
Dialogue: 0,0:10:48.73,0:10:52.15,Default,,0,0,0,,Оған менің өлімім де кіреді.
Dialogue: 0,0:10:56.73,0:10:59.70,Default,,0,0,0,,Тұр, Качан (Бакуго), маған ерме!
Dialogue: 0,0:11:01.41,0:11:03.49,Default,,0,0,0,,Тек сенімді болу үшін,
Dialogue: 0,0:11:03.57,0:11:06.87,Default,,0,0,0,,Кек алу тек ақымақтардың ісі.
Dialogue: 0,0:11:07.58,0:11:11.87,Default,,0,0,0,,Ақылды Акира-кун түсінетініне сенімдімін.
Dialogue: 0,0:11:12.38,0:11:13.88,Default,,0,0,0,,(Акираның жылағаны)
Dialogue: 0,0:11:15.34,0:11:17.25,Default,,0,0,0,,Неге қазір?
Dialogue: 0,0:11:18.17,0:11:19.30,Default,,0,0,0,,Ақырында...
Dialogue: 0,0:11:19.80,0:11:21.59,Default,,0,0,0,,Мен ақыры шештім...
Dialogue: 0,0:11:23.01,0:11:25.26,Default,,0,0,0,,Неге қазір олай істеп жатырсың...
Dialogue: 0,0:11:25.76,0:11:27.81,Default,,0,0,0,,Бұл сіздің қолыңыздан келмейтін нәрсе, солай ма?
Dialogue: 0,0:11:27.89,0:11:29.43,Default,,0,0,0,,Өмір сүру деген нені білдіреді
Dialogue: 0,0:11:29.98,0:11:32.44,Default,,0,0,0,,Бірақ Акира-кунды алып кетпейді.
Dialogue: 0,0:11:32.94,0:11:34.90,Default,,0,0,0,,Мен бұған сенемін
Dialogue: 0,0:11:35.98,0:11:40.32,Default,,0,0,0,,Айтпақшы, сен неге араласуға сонша табандысың?
Dialogue: 0,0:11:40.40,0:11:45.99,Default,,0,0,0,,Мүмкін маған Акира-кун адам ретінде ұнайтын шығар.
Dialogue: 0,0:11:46.49,0:11:49.83,Default,,0,0,0,,Ой... Мен ұят нәрсе айттым.
Dialogue: 0,0:11:51.00,0:11:52.58,Default,,0,0,0,,Осы жерде
Dialogue: 0,0:11:59.63,0:12:03.88,Default,,0,0,0,,Капитан Саран, маған ұрысыңызшы.
Dialogue: 0,0:12:05.34,0:12:09.43,Default,,0,0,0,,Мен сені тыңдамаймын, мен ақымақпын
Dialogue: 0,0:12:19.44,0:12:21.74,Default,,0,0,0,,Сіз барасыз ба?
Dialogue: 0,0:12:23.40,0:12:24.66,Default,,0,0,0,,Сіз ояу болдыңыз ба?
Dialogue: 0,0:12:25.24,0:12:28.16,Default,,0,0,0,,Жұмысты орындауға барсаңыз
Dialogue: 0,0:12:28.66,0:12:31.87,Default,,0,0,0,,Оны көру клиент ретінде сіздің жауапкершілігіңіз болуы мүмкін.
Dialogue: 0,0:12:32.91,0:12:34.54,Default,,0,0,0,,Мен мұны қазір істеймін.
Dialogue: 0,0:12:36.33,0:12:38.38,Default,,0,0,0,,Күшейтілген сарбаздармен қалай әрекет ету керек?
Dialogue: 0,0:12:38.46,0:12:42.97,Default,,0,0,0,,Біз қажетті шараларды қолданамыз, бірақ қажетсіз өлтіру ниетіміз жоқ.
Dialogue: 0,0:12:43.63,0:12:44.63,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:12:44.72,0:12:49.56,Default,,0,0,0,,Бұл кісі өлтірушілер бейтаныс кісі өлтірушілер емес дегенді білдіре ме?
Dialogue: 0,0:12:50.81,0:12:52.02,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:12:53.35,0:12:54.02,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:12:56.10,0:12:58.23,Default,,0,0,0,,Амелия да ұйықтап жатқан жоқ па?
Dialogue: 0,0:12:58.31,0:13:00.02,Default,,0,0,0,,Мен ұйықтай алмаймын
Dialogue: 0,0:13:00.57,0:13:02.36,Default,,0,0,0,,Акира, барма.
Dialogue: 0,0:13:03.61,0:13:05.15,Default,,0,0,0,,Мен түсіндім
Dialogue: 0,0:13:05.65,0:13:08.82,Default,,0,0,0,,Акираның шынайы сезімі: «Мен ешкімді өлтіргім келмейді»
Dialogue: 0,0:13:09.33,0:13:10.24,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:13:12.20,0:13:12.95,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:13:13.04,0:13:14.29,Default,,0,0,0,,Содан кейін оны тоқтатыңыз.
Dialogue: 0,0:13:16.79,0:13:19.79,Default,,0,0,0,,Кешіріңіз, Амелия
Dialogue: 0,0:13:33.06,0:13:35.89,Default,,0,0,0,,Сен мені шығарып салуға келдің бе, Йору?
Dialogue: 0,0:13:36.44,0:13:39.06,Default,,0,0,0,,Маған бұйрық берсеңіз, мен сізге көмектесемін.
Dialogue: 0,0:13:39.15,0:13:42.36,Default,,0,0,0,,Кешіріңіз, жалғыз баруға рұқсат етіңіз.
Dialogue: 0,0:13:44.61,0:13:48.74,Default,,0,0,0,,Тәңірдің қалауы бойынша түсіндім.
Dialogue: 0,0:14:09.43,0:14:13.85,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:14:22.06,0:14:23.11,Default,,0,0,0,,Сіз құрдассыз ба?
Dialogue: 0,0:14:23.19,0:14:23.73,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:24.94,0:14:27.36,Default,,0,0,0,,Қараңғы өлтіруші?
Dialogue: 0,0:14:27.44,0:14:28.28,Default,,0,0,0,,Хаа…
Dialogue: 0,0:14:28.82,0:14:32.32,Default,,0,0,0,,Сұраныс сіз сияқты үлкен адамға сәйкес келетініне сене алмаймын.
Dialogue: 0,0:14:32.41,0:14:33.33,Default,,0,0,0,,Алайда...
Dialogue: 0,0:14:33.41,0:14:36.00,Default,,0,0,0,,Мақсаттарды бұзуға болмайды
Dialogue: 0,0:14:36.08,0:14:37.71,Default,,0,0,0,,Бұл жігіт дұрыс айтады.
Dialogue: 0,0:14:38.21,0:14:40.75,Default,,0,0,0,,Мақсаттарды бұзуға болмайды
Dialogue: 0,0:14:41.46,0:14:46.55,Default,,0,0,0,,Осы кезде менің басымда капитан Саранның сөзі қалықтап кетті.
Dialogue: 0,0:14:47.42,0:14:49.84,Default,,0,0,0,,Өмір сүру - қолыңнан келмейтін нәрсе.
Dialogue: 0,0:14:50.59,0:14:51.34,Default,,0,0,0,,Сен кімсің өзі?!
Dialogue: 0,0:14:52.01,0:14:53.55,Default,,0,0,0,,Бірақ сіз қазір түсе аласыз ба?
Dialogue: 0,0:14:53.64,0:14:57.52,Default,,0,0,0,,Бұл тек маған қатысты емес шығар.
Dialogue: 0,0:14:58.02,0:14:59.44,Default,,0,0,0,,Барлығы да солай.
Dialogue: 0,0:14:59.98,0:15:03.56,Default,,0,0,0,,Дәл осы саудагер патша әулетінен өтініш алған шығар
Dialogue: 0,0:15:04.36,0:15:07.44,Default,,0,0,0,,Әркімнің қолынан келмейтін нәрсе болды.
Dialogue: 0,0:15:08.90,0:15:11.53,Default,,0,0,0,,Қарға, Йор және Амелия да.
Dialogue: 0,0:15:11.61,0:15:12.78,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:14.41,0:15:18.41,Default,,0,0,0,,Бұл дүние ақылға сыйымсыз.
Dialogue: 0,0:15:19.87,0:15:21.75,Default,,0,0,0,,Кенеттен басқа әлемге лақтырылды -
Dialogue: 0,0:15:21.83,0:15:23.38,Default,,0,0,0,,Киосуке және кейіпкерлер
Dialogue: 0,0:15:24.00,0:15:27.30,Default,,0,0,0,,Жындар мен жын қожайындары туралы да солай болуы мүмкін.
Dialogue: 0,0:15:28.30,0:15:31.18,Default,,0,0,0,,Тіпті бізді шақырған патшаға да.
Dialogue: 0,0:15:31.80,0:15:36.22,Default,,0,0,0,,Немесе тіпті Грамдарда да бар шығар.
Dialogue: 0,0:15:36.81,0:15:39.68,Default,,0,0,0,,Әрине, капитан Саран да.
Dialogue: 0,0:15:40.68,0:15:42.23,Default,,0,0,0,,Алғашында неге екенін түсінбесем де, менде жеккөру сезімі пайда болды—
Dialogue: 0,0:15:43.94,0:15:47.27,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:16:04.54,0:16:06.17,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:16:18.47,0:16:19.39,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:16:19.47,0:16:20.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:20.72,0:16:21.89,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:16:24.35,0:16:25.35,Default,,0,0,0,,Хм. Арнайы дәрежелі Шинохарадан осы мүмкіндікті де тексертуді қалаймын
Dialogue: 0,0:16:27.48,0:16:28.77,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:31.61,0:16:35.03,Default,,0,0,0,,Неге... неге кешірім сұрайсың?
Dialogue: 0,0:16:38.49,0:16:41.16,Default,,0,0,0,,Себебі сен менің тоқтағанымды естімей кетіп қалдың.
Dialogue: 0,0:16:41.25,0:16:42.66,Default,,0,0,0,,Бірақ... аа!
Dialogue: 0,0:16:48.42,0:16:49.34,Default,,0,0,0,,Мен...
Dialogue: 0,0:16:50.00,0:16:52.55,Default,,0,0,0,,Мен мұны нақты шешкен болсам да.
Dialogue: 0,0:16:53.05,0:16:56.76,Default,,0,0,0,,Сол кезде мен дірілдеп тұра алмадым.
Dialogue: 0,0:17:01.22,0:17:02.31,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:17:03.23,0:17:07.15,Default,,0,0,0,,Грамды өлтіргеннен кейін мен ешқандай эмоцияны сезбедім.
Dialogue: 0,0:17:09.57,0:17:10.73,Default,,0,0,0,,Міне, алма мен жаңғақ қосылған карамельді вафлилер.
Dialogue: 0,0:17:11.36,0:17:15.74,Default,,0,0,0,,Біреудің өмірін алсам да, ойламаппын.
Dialogue: 0,0:17:18.41,0:17:21.95,Default,,0,0,0,,Нағыз өлтіруші болып шықты
Dialogue: 0,0:17:26.04,0:17:26.96,Default,,0,0,0,,Акира…
Dialogue: 0,0:17:28.29,0:17:30.09,Default,,0,0,0,,Бұл ақымақтық.
Dialogue: 0,0:17:30.59,0:17:31.46,Default,,0,0,0,,Егер бұл орын алса
Dialogue: 0,0:17:31.55,0:17:34.47,Default,,0,0,0,,Мен алдымен король Лейтисті өлтіруім керек еді.
Dialogue: 0,0:17:35.05,0:17:38.30,Default,,0,0,0,,Осылайша капитан Саран өлмес еді.
Dialogue: 0,0:17:38.39,0:17:39.64,Default,,0,0,0,,Бұл Акира кінәлі...
Dialogue: 0,0:17:39.72,0:17:41.76,Default,,0,0,0,,Егер бұл бәрібір орын алса
Dialogue: 0,0:17:41.85,0:17:44.52,Default,,0,0,0,,Бұл жай ғана баяу немесе жылдам болу мәселесі болды.
Dialogue: 0,0:17:50.40,0:17:53.82,Default,,0,0,0,,Амелия кешеге дейін мені қорғауға тырысты.
Dialogue: 0,0:17:54.61,0:17:55.65,Default,,0,0,0,,Артық емес
Dialogue: 0,0:17:58.03,0:17:59.78,Default,,0,0,0,,Қайту мүмкін емес
Dialogue: 0,0:18:01.66,0:18:02.66,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:12.75,0:18:13.75,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:18:18.68,0:18:23.01,Default,,0,0,0,,Акира қандай жағдай болса да, мен сенімен бірге боламын.
Dialogue: 0,0:18:24.14,0:18:25.14,Default,,0,0,0,,Амелия…
Dialogue: 0,0:18:26.14,0:18:30.60,Default,,0,0,0,,Акира әрқашан өз жолын кесті.
Dialogue: 0,0:18:31.81,0:18:33.65,Default,,0,0,0,,Мен оны көрдім
Dialogue: 0,0:18:34.23,0:18:35.11,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:18:36.53,0:18:37.90,Default,,0,0,0,,Мен де солай істеймін
Dialogue: 0,0:18:42.37,0:18:46.45,Default,,0,0,0,,Енді маған не боларын да білмеймін.
Dialogue: 0,0:18:47.75,0:18:50.71,Default,,0,0,0,,Сіз қорқынышты құбыжыққа айналуыңыз мүмкін.
Dialogue: 0,0:18:52.17,0:18:56.30,Default,,0,0,0,,Солай болса да, қарамасаң,
Dialogue: 0,0:19:02.01,0:19:05.26,Default,,0,0,0,,Мен аздап алға жылжи аламын деп ойлаймын.
Dialogue: 0,0:19:08.48,0:19:10.56,Default,,0,0,0,,Мені ұмытып қалсаң, қиын болар еді
Dialogue: 0,0:19:13.52,0:19:17.19,Default,,0,0,0,,Бұл йору да бас залға өз өмірін құрбан етті.
Dialogue: 0,0:19:17.28,0:19:19.19,Default,,0,0,0,,Әрқашан бірге
Dialogue: 0,0:19:33.75,0:19:34.92,Default,,0,0,0,,Оу, бұ да керемет екен. Сендер тез жеп қойыңдар.
Dialogue: 0,0:19:36.80,0:19:40.30,Default,,0,0,0,,Ағаң... Грам-сама өлтірілді ме?
Dialogue: 0,0:19:41.88,0:19:43.72,Default,,0,0,0,,Егер ол адам...
Dialogue: 0,0:19:44.22,0:19:46.43,Default,,0,0,0,,Жоқ, ол адам жалғыз.
Dialogue: 0,0:19:48.52,0:19:50.10,Default,,0,0,0,,Сәл жақсы ма?
Dialogue: 0,0:19:50.18,0:19:51.31,Default,,0,0,0,,Не?
Dialogue: 0,0:19:51.39,0:19:55.06,Default,,0,0,0,,Мен оянғаннан бері менің шеберлігім «интуиция» айтып келеді
Dialogue: 0,0:19:55.15,0:19:57.82,Default,,0,0,0,,Акирада өзгеріс болды...
Dialogue: 0,0:19:58.73,0:20:00.36,Default,,0,0,0,,Сіз нені айтасыз? Амал жоқ...
Dialogue: 0,0:20:00.44,0:20:04.70,Default,,0,0,0,,Жоқ, ол өмірден айырылған немесе ауыр жарақат алған сияқты емес.
Dialogue: 0,0:20:04.78,0:20:08.79,Default,,0,0,0,,Мен жай ғана үлкен өзгеріс болғанын сеземін.
Dialogue: 0,0:20:12.25,0:20:14.96,Default,,0,0,0,,Егер ол әлі тірі болса, одан сұраңыз.
Dialogue: 0,0:20:15.04,0:20:16.46,Default,,0,0,0,,Мен сенімен кездесуге уәде бердім.
Dialogue: 0,0:20:18.84,0:20:20.30,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:20:22.72,0:20:27.85,Default,,0,0,0,,Кім болсаң да, бір нәрсені жоғалту сөзсіз.
Dialogue: 0,0:20:28.43,0:20:30.43,Default,,0,0,0,,Маңыздысы әрі қарай не болатыны
Dialogue: 0,0:20:31.68,0:20:35.44,Default,,0,0,0,,Мен бір күні жын патшамен мәселені шешемін.
Dialogue: 0,0:20:35.94,0:20:39.27,Default,,0,0,0,,Сонда не істейсіз?
Dialogue: 0,0:20:40.90,0:20:43.24,Default,,0,0,0,,Мен сені ертіп жүруіңді өтінемін, Қарға.
Dialogue: 0,0:20:43.32,0:20:46.99,Default,,0,0,0,,Әрине, мен уәдемді орындаймын.
Dialogue: 0,0:20:47.87,0:20:49.87,Default,,0,0,0,,Кеттік
Dialogue: 0,0:20:50.45,0:20:51.37,Default,,0,0,0,,Иә
Dialogue: 0,0:20:52.66,0:20:55.04,Default,,0,0,0,,Амелия мен Йоль мені қабылдады.
Dialogue: 0,0:20:55.75,0:20:57.88,Default,,0,0,0,,Мен қастандық жасадым.
Dialogue: 0,0:20:59.04,0:21:01.63,Default,,0,0,0,,Сондықтан мен де қабылдаймын.
Dialogue: 0,0:21:02.13,0:21:04.01,Default,,0,0,0,,Мен нені алып жүруім керек
Dialogue: 0,0:21:05.26,0:21:09.47,Default,,0,0,0,,Мен өзімнің бастапқы әлеміме оралу үшін біліктілігім бар-жоғын білмеймін.
Dialogue: 0,0:21:10.14,0:21:16.48,Default,,0,0,0,,Бірақ Киосуке мен Батыр класы, оларды қайтару үшін.
Dialogue: 0,0:21:16.98,0:21:18.86,Default,,0,0,0,,Өлтіру қажет болғанда
Dialogue: 0,0:21:20.07,0:21:21.40,Default,,0,0,0,,Мен онымен айналысамын.
Dialogue: 0,0:21:22.73,0:21:24.19,Default,,0,0,0,,Ассасин ретінде
Dialogue: 0,0:21:29.20,0:21:31.20,Default,,0,0,0,,♪～
Dialogue: 0,0:23:48.05,0:23:50.05,Default,,0,0,0,,～♪
