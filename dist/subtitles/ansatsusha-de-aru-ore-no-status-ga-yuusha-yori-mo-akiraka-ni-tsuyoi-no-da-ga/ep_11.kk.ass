Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.25,0:00:05.92,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:06.00,0:00:08.38,Default,,0,0,0,,Бұл Урук қаласы ма?
Dialogue: 0,0:00:08.46,0:00:11.80,Default,,0,0,0,,Құрметті Тор Наил, ерте келгенім үшін кешіріңіз...
Dialogue: 0,0:00:11.88,0:00:13.22,Default,,0,0,0,,Қалғандар да дәл қазір барын салып еңбек етіп жатқан болар.
Dialogue: 0,0:00:13.30,0:00:15.59,Default,,0,0,0,,Маған гильдия туралы ақпарат жинау керек.
Dialogue: 0,0:00:15.68,0:00:17.05,Default,,0,0,0,,Сіз айтқандай.
Dialogue: 0,0:00:20.06,0:00:21.93,Default,,0,0,0,,Дәмі керемет.
Dialogue: 0,0:00:22.02,0:00:24.23,Default,,0,0,0,,Сіздің талғамыңызға сай болуы мүмкін деп ойлаймын.
Dialogue: 0,0:00:24.31,0:00:25.06,Default,,0,0,0,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,0:00:25.56,0:00:27.56,Default,,0,0,0,,Мм... ақпарат жинау...
Dialogue: 0,0:00:27.65,0:00:28.27,Default,,0,0,0,,Хмм
Dialogue: 0,0:00:28.36,0:00:30.90,Default,,0,0,0,,Мен бұл бағытта күшті ақпаратты сеземін.
Dialogue: 0,0:00:30.98,0:00:32.32,Default,,0,0,0,,Барып білейік
Dialogue: 0,0:00:32.40,0:00:33.49,Default,,0,0,0,,Құрметті торлы шеге!
Dialogue: 0,0:00:37.99,0:00:41.24,Default,,0,0,0,,Жоқ, самал өте жақсы.
Dialogue: 0,0:00:41.33,0:00:43.00,Default,,0,0,0,,Тор Наил мырза?
Dialogue: 0,0:00:43.08,0:00:44.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:00:44.08,0:00:46.17,Default,,0,0,0,,Бұл ақпарат жинау емес.
Dialogue: 0,0:00:46.25,0:00:48.75,Default,,0,0,0,,Бұл көрікті жерлерге саяхат емес пе?
Dialogue: 0,0:00:48.84,0:00:51.25,Default,,0,0,0,,Сен нашар тыңдаушысың, Йору-кун.
Dialogue: 0,0:00:51.34,0:00:53.97,Default,,0,0,0,,Біріншіден, мен бұл қаланы бақылап отырмын.
Dialogue: 0,0:00:54.05,0:00:55.55,Default,,0,0,0,,Қазір де
Dialogue: 0,0:00:56.97,0:01:00.39,Default,,0,0,0,,Мен өз көзімнен ақпаратты санамда жүйелеймін.
Dialogue: 0,0:01:00.47,0:01:02.18,Default,,0,0,0,,Бұл үшін кешіріңіз.
Dialogue: 0,0:01:02.27,0:01:05.89,Default,,0,0,0,,Маған мағынасы жоқ нәрсе бар сияқты, бірақ кешіріңіз.
Dialogue: 0,0:01:05.98,0:01:07.31,Default,,0,0,0,,Қайықшы
Dialogue: 0,0:01:07.40,0:01:10.77,Default,,0,0,0,,Сіз мені ең танымал туристік орынға апара аласыз ба?
Dialogue: 0,0:01:10.86,0:01:12.53,Default,,0,0,0,,Оны маған қалдыр!
Dialogue: 0,0:01:13.03,0:01:15.32,Default,,0,0,0,,Мен енді ештеңе айтпаймын
Dialogue: 0,0:01:16.49,0:01:18.49,Default,,0,0,0,,♪～
Dialogue: 0,0:02:43.53,0:02:45.54,Default,,0,0,0,,～♪
Dialogue: 0,0:02:49.54,0:02:50.46,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:03:00.38,0:03:02.80,Default,,0,0,0,,Йору-кун маған алдын ала айтқандай.
Dialogue: 0,0:03:02.89,0:03:05.39,Default,,0,0,0,,Бұл тамаша туристік қала.
Dialogue: 0,0:03:05.47,0:03:06.18,Default,,0,0,0,,Хаа…
Dialogue: 0,0:03:06.26,0:03:07.81,Default,,0,0,0,,Білу және мақтау
Dialogue: 0,0:03:07.89,0:03:10.69,Default,,0,0,0,,Кейбір ұсақ-түйектермен бөліскенім ақымақтық болды.
Dialogue: 0,0:03:13.15,0:03:15.86,Default,,0,0,0,,Мен бір рет осындай нәрсені көргім келді.
Dialogue: 0,0:03:15.94,0:03:17.03,Default,,0,0,0,,(Судың ағып жатқан дыбысы)
Dialogue: 0,0:03:20.61,0:03:21.57,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:03:22.07,0:03:23.66,Default,,0,0,0,,Үйден қашу дұрыс шешім болды!
Dialogue: 0,0:03:23.74,0:03:27.91,Default,,0,0,0,,Егер сіз басқаларды тартпасаңыз, сіз одан да дұрыс.
Dialogue: 0,0:03:30.00,0:03:32.87,Default,,0,0,0,,Ал, енді қайда баруымыз керек?
Dialogue: 0,0:03:32.96,0:03:34.79,Default,,0,0,0,,Күтілгендей, тергеу уақыты келді...
Dialogue: 0,0:03:34.88,0:03:35.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:37.30,0:03:38.92,Default,,0,0,0,,Мүмкіндік келді
Dialogue: 0,0:03:39.01,0:03:39.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:40.47,0:03:41.63,Default,,0,0,0,,- (Жыртқыш) Уа... -Сәлеметсіз бе.
Dialogue: 0,0:03:42.26,0:03:44.18,Default,,0,0,0,,Сіз авантюристсіз, солай ма?
Dialogue: 0,0:03:44.26,0:03:45.43,Default,,0,0,0,,Қолында қару бар.
Dialogue: 0,0:03:45.51,0:03:46.85,Default,,0,0,0,,Иә, бірақ не?
Dialogue: 0,0:03:46.93,0:03:48.35,Default,,0,0,0,,Бұл қаладағы гильдиялар
Dialogue: 0,0:03:48.43,0:03:51.81,Default,,0,0,0,,Көп ақша төлейтін жұмысқа орналасуға болады деп естідім.
Dialogue: 0,0:03:52.56,0:03:53.23,Default,,0,0,0,,Қандай түрі?
Dialogue: 0,0:03:53.31,0:03:54.85,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:54.94,0:03:58.48,Default,,0,0,0,,Ақша жасайтын сұраулар қылмыс немесе жынмен байланысты.
Dialogue: 0,0:03:58.57,0:04:00.11,Default,,0,0,0,,Қылмыс дегеніміз не?
Dialogue: 0,0:04:00.19,0:04:02.36,Default,,0,0,0,,Бұл жерде бұлай айту мүмкін емес.
Dialogue: 0,0:04:02.45,0:04:03.03,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:04:05.11,0:04:08.53,Default,,0,0,0,,Сіз маған жалғыз болатын жерді айта аласыз.
Dialogue: 0,0:04:08.62,0:04:12.08,Default,,0,0,0,,Бұл маған ғашық екеніңді білдіре ме?
Dialogue: 0,0:04:12.16,0:04:13.54,Default,,0,0,0,,Өйткені ол сүйкімді...
Dialogue: 0,0:04:14.62,0:04:16.08,Default,,0,0,0,,Шамамен жиырма минуттай уақыт алады деп ойлаймын.
Dialogue: 0,0:04:16.17,0:04:18.34,Default,,0,0,0,,Бірақ мен барлығына танымал болуды мақсат етіп отырмын.
Dialogue: 0,0:04:18.42,0:04:21.30,Default,,0,0,0,,Мен белгілі бір адаммен романтикалық қарым-қатынас жасай алмаймын.
Dialogue: 0,0:04:21.92,0:04:22.63,Default,,0,0,0,,Хехе
Dialogue: 0,0:04:26.47,0:04:30.39,Default,,0,0,0,,Егер мен оның ұсынысын орындасам, қосымша ақпарат алар едім.
Dialogue: 0,0:04:30.47,0:04:32.77,Default,,0,0,0,,Бұл танымал болудың қиын бөлігі.
Dialogue: 0,0:04:32.85,0:04:34.52,Default,,0,0,0,,Сіз не туралы айтып отырсыз...
Dialogue: 0,0:04:34.60,0:04:35.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:35.65,0:04:37.06,Default,,0,0,0,,Қарт әже, кіріп келемін.
Dialogue: 0,0:04:37.56,0:04:40.27,Default,,0,0,0,,Телепатия арқылы Иемізден бұйрық берілді.
Dialogue: 0,0:04:40.36,0:04:41.82,Default,,0,0,0,,Бұл шұғыл.
Dialogue: 0,0:04:41.90,0:04:42.74,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:04:42.82,0:04:46.66,Default,,0,0,0,,Мен Йору-кунға қарыздармын, мен сізге осы жерде шындап көмектесемін.
Dialogue: 0,0:04:49.45,0:04:52.12,Default,,0,0,0,,Бұл Гильдия Мастер Грамның үйі ме?
Dialogue: 0,0:04:52.62,0:04:53.71,Default,,0,0,0,,Бұл үлкен.
Dialogue: 0,0:04:53.79,0:04:57.17,Default,,0,0,0,,Олар көрші шіркеуден де күштірек екенін көрсеткісі келетін шығар.
Dialogue: 0,0:04:57.25,0:05:00.75,Default,,0,0,0,,Грэм жасаған заңсыздықтың дәлелдерін қамтамасыз ету
Dialogue: 0,0:05:00.84,0:05:02.05,Default,,0,0,0,,Біздің міндет
Dialogue: 0,0:05:02.13,0:05:03.80,Default,,0,0,0,,Үлкен сарайды зерттеу
Dialogue: 0,0:05:03.88,0:05:06.13,Default,,0,0,0,,Қараңғы түскеннен кейін жасау оңайырақ.
Dialogue: 0,0:05:06.22,0:05:06.88,Default,,0,0,0,,Иә
Dialogue: 0,0:05:06.97,0:05:09.60,Default,,0,0,0,,Алдымен басқа бөлікті аяқтаймыз.
Dialogue: 0,0:05:09.68,0:05:10.31,Default,,0,0,0,,Иә
Dialogue: 0,0:05:14.56,0:05:16.02,Default,,0,0,0,,«Шытырман оқиғалы гильдия»
Dialogue: 0,0:05:16.10,0:05:18.73,Default,,0,0,0,,Енді қалай сіңіп кетеміз?
Dialogue: 0,0:05:18.81,0:05:19.77,Default,,0,0,0,,Жарайды
Dialogue: 0,0:05:19.86,0:05:20.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:23.23,0:05:24.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:25.49,0:05:26.65,Default,,0,0,0,,Не? Мисс
Dialogue: 0,0:05:27.24,0:05:29.53,Default,,0,0,0,,Гильдия бизнесі енді жабылды.
Dialogue: 0,0:05:30.03,0:05:32.54,Default,,0,0,0,,Олай болса балалар, мұнда не істеп жүрсіңдер?
Dialogue: 0,0:05:32.62,0:05:34.25,Default,,0,0,0,,Оны көргенде түсінесіз.
Dialogue: 0,0:05:34.75,0:05:37.12,Default,,0,0,0,,Грам мырзаның лас жұмысын жасаған адам
Dialogue: 0,0:05:37.21,0:05:39.67,Default,,0,0,0,,Маған сол жерде қалған алкогольді ішуге рұқсат етілгенін айтты.
Dialogue: 0,0:05:40.25,0:05:41.63,Default,,0,0,0,,Бейтаныс адамдар қайтып келуі керек
Dialogue: 0,0:05:41.71,0:05:42.59,Default,,0,0,0,,Қателіктеріңе көп тоқталудың орнына,
Dialogue: 0,0:05:42.67,0:05:43.30,Default,,0,0,0,,Әй?
Dialogue: 0,0:05:43.38,0:05:45.92,Default,,0,0,0,,Ол жақсы әйел емес пе?
Dialogue: 0,0:05:46.55,0:05:48.63,Default,,0,0,0,,Менімен бірге ойнайық
Dialogue: 0,0:05:49.14,0:05:49.64,Default,,0,0,0,,Әй?
Dialogue: 0,0:05:49.72,0:05:52.14,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:05:53.01,0:05:53.81,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:53.89,0:05:55.18,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:05:55.27,0:05:56.68,Default,,0,0,0,,Уау, бұл керемет күш...
Dialogue: 0,0:05:56.77,0:05:57.52,Default,,0,0,0,,Ng...
Dialogue: 0,0:05:57.60,0:05:58.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:59.60,0:06:00.61,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:06:00.69,0:06:02.02,Default,,0,0,0,,Сіз маған кедергі келтірдіңіз.
Dialogue: 0,0:06:02.11,0:06:03.78,Default,,0,0,0,,(Есіктің жабылу дыбысы)
Dialogue: 0,0:06:03.86,0:06:06.74,Default,,0,0,0,,Тор шегесінің кенеттен әрекеті
Dialogue: 0,0:06:06.82,0:06:08.49,Default,,0,0,0,,Мен үлгере алмаймын
Dialogue: 0,0:06:08.57,0:06:09.66,Default,,0,0,0,,Біртүрлі, ол...
Dialogue: 0,0:06:09.74,0:06:11.91,Default,,0,0,0,,Мен бір қызық нәрсе білдім.
Dialogue: 0,0:06:12.49,0:06:14.66,Default,,0,0,0,,Осы жерден бастаған дұрыс па?
Dialogue: 0,0:06:15.20,0:06:15.79,Default,,0,0,0,,Уваааах! Ашылмай жатыр!
Dialogue: 0,0:06:16.37,0:06:19.04,Default,,0,0,0,,Төбенің биіктігі мен екінші қабаттың орналасуы тым әртүрлі.
Dialogue: 0,0:06:19.67,0:06:21.54,Default,,0,0,0,,Шатырда құпия бөлме бар.
Dialogue: 0,0:06:21.63,0:06:23.80,Default,,0,0,0,,Мен, әрине, түсінемін.
Dialogue: 0,0:06:23.88,0:06:25.05,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:06:25.13,0:06:25.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:26.96,0:06:28.63,Default,,0,0,0,,Ахх!
Dialogue: 0,0:06:28.72,0:06:30.59,Default,,0,0,0,,Еееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееек!
Dialogue: 0,0:06:33.64,0:06:35.60,Default,,0,0,0,,Қандай рахат!
Dialogue: 0,0:06:35.68,0:06:36.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:45.02,0:06:46.15,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:48.99,0:06:51.95,Default,,0,0,0,,Тәңірім, сіз сұрағаныңыз осы еді.
Dialogue: 0,0:06:52.53,0:06:54.62,Default,,0,0,0,,Тор тырнақ сізге де көмектесті ме?
Dialogue: 0,0:06:54.70,0:06:55.33,Default,,0,0,0,,Рақмет.
Dialogue: 0,0:06:55.41,0:06:57.54,Default,,0,0,0,,Мен өзіме лайықты нәрсені жасадым.
Dialogue: 0,0:06:57.62,0:06:59.58,Default,,0,0,0,,Өйткені мен әділдік жағындамын.
Dialogue: 0,0:07:00.16,0:07:03.33,Default,,0,0,0,,Көмек пе, кедергі ме, білмеймін...
Dialogue: 0,0:07:03.42,0:07:04.79,Default,,0,0,0,,Бұл не? Йору-кун
Dialogue: 0,0:07:04.88,0:07:05.92,Default,,0,0,0,,Ештеңе!
Dialogue: 0,0:07:06.96,0:07:09.05,Default,,0,0,0,,Дәрілік заттарды өндіру кестесін жақсарту
Dialogue: 0,0:07:09.55,0:07:11.51,Default,,0,0,0,,Шикізатты сатып алу маршруты
Dialogue: 0,0:07:12.01,0:07:14.05,Default,,0,0,0,,Нәсіл бойынша адам саудасының тізімі
Dialogue: 0,0:07:14.76,0:07:16.60,Default,,0,0,0,,Жындармен транзакция тарихы
Dialogue: 0,0:07:16.68,0:07:19.81,Default,,0,0,0,,Лейтис еліне жалдамалылардың несиесі туралы меморандум
Dialogue: 0,0:07:21.56,0:07:23.94,Default,,0,0,0,,Айтқаныңыздың бәрі рас сияқты.
Dialogue: 0,0:07:24.02,0:07:26.27,Default,,0,0,0,,Мен өтірік айтпаймын
Dialogue: 0,0:07:26.77,0:07:31.03,Default,,0,0,0,,Ассасин ретінде сұрауларды ұрлау сіздің жұмысыңыздың бір бөлігі ме?
Dialogue: 0,0:07:31.11,0:07:32.45,Default,,0,0,0,,Міне
Dialogue: 0,0:07:32.53,0:07:34.41,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:07:34.91,0:07:36.58,Default,,0,0,0,,Құжатқа күдікті нәрсе бар ма?
Dialogue: 0,0:07:36.66,0:07:38.70,Default,,0,0,0,,Жоқ, бұл жігіт шын.
Dialogue: 0,0:07:39.20,0:07:41.96,Default,,0,0,0,,Менің ойымша, ойдан шығарылғандар туралы бұлай нақты айту мүмкін емес.
Dialogue: 0,0:07:42.04,0:07:42.83,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:07:43.75,0:07:45.84,Default,,0,0,0,,Ұрлау оңай болған нәрсе ұсталды.
Dialogue: 0,0:07:45.92,0:07:49.05,Default,,0,0,0,,Шатырдағы жасырын бөлмеде сақталды.
Dialogue: 0,0:07:49.13,0:07:51.30,Default,,0,0,0,,Ешкім келмейді деп ойлаған шығар...
Dialogue: 0,0:07:51.38,0:07:53.34,Default,,0,0,0,,Мен де біраз қызық болдым.
Dialogue: 0,0:07:53.43,0:07:55.30,Default,,0,0,0,,Мұндай қауіпті құжат
Dialogue: 0,0:07:55.39,0:07:57.60,Default,,0,0,0,,Қызық, неге өз бетінше салмайды?
Dialogue: 0,0:07:57.68,0:07:58.51,Default,,0,0,0,,Әрине
Dialogue: 0,0:07:58.60,0:08:02.10,Default,,0,0,0,,Егер ол сол үлкен сарайда болса, оны табу қиын болар еді.
Dialogue: 0,0:08:02.60,0:08:04.40,Default,,0,0,0,,Бұл қарапайым.
Dialogue: 0,0:08:06.44,0:08:10.44,Default,,0,0,0,,Ұрлап кететіндей етіп ұрлауға оңай болатын жерге қойды.
Dialogue: 0,0:08:17.62,0:08:21.04,Default,,0,0,0,,Сізді не үшін шақырғанын білесіз бе?
Dialogue: 0,0:08:21.54,0:08:25.96,Default,,0,0,0,,Құжаттардың барын сен ғана білдің.
Dialogue: 0,0:08:26.04,0:08:28.21,Default,,0,0,0,,Құжат ұрланды
Dialogue: 0,0:08:28.29,0:08:29.46,Default,,0,0,0,,Хе-хе. Баспалдақтан төмен түсіп кеткенсің ғой?
Dialogue: 0,0:08:29.55,0:08:31.96,Default,,0,0,0,,Арамызда бір сатқын бар
Dialogue: 0,0:08:34.34,0:08:36.43,Default,,0,0,0,,Бірақ олжа жемді шақпай тұрып
Dialogue: 0,0:08:36.51,0:08:37.80,Default,,0,0,0,,Йору оны ұрлады
Dialogue: 0,0:08:37.89,0:08:40.06,Default,,0,0,0,,Сонымен Грамның жоспары сәтсіз болды ма?
Dialogue: 0,0:08:40.14,0:08:41.06,Default,,0,0,0,,О
Dialogue: 0,0:08:41.56,0:08:44.69,Default,,0,0,0,,Бірақ ол істесе, құжаттардың жоғалып кеткені
Dialogue: 0,0:08:44.77,0:08:46.31,Default,,0,0,0,,Мен қалағанымды істеймін
Dialogue: 0,0:08:46.40,0:08:49.32,Default,,0,0,0,,О... мен сенің не айтып тұрғаныңды білемін, бірақ біз...
Dialogue: 0,0:08:49.40,0:08:51.36,Default,,0,0,0,,Сіз ұрлық жасап жатқан жоқсыз.
Dialogue: 0,0:08:51.44,0:08:54.20,Default,,0,0,0,,Бірақ біз қылмыскерді ұстадық.
Dialogue: 0,0:08:54.70,0:08:58.07,Default,,0,0,0,,Құжаттар қайда екенін маған кім айтты? Мен сені құстырамын.
Dialogue: 0,0:08:58.16,0:09:02.45,Default,,0,0,0,,Балалар, азаптау құралдарын дайындап бере аласыздар ма?
Dialogue: 0,0:09:03.79,0:09:05.12,Default,,0,0,0,,А... орында
Dialogue: 0,0:09:05.21,0:09:06.04,Default,,0,0,0,,Ха…
Dialogue: 0,0:09:08.25,0:09:09.21,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:09:09.29,0:09:12.71,Default,,0,0,0,,Енді біз сатқынмен жұмыс жасадық.
Dialogue: 0,0:09:12.80,0:09:15.22,Default,,0,0,0,,Сондай-ақ, сіз қылмыскерді іздеп жүрсіз бе?
Dialogue: 0,0:09:15.30,0:09:15.88,Default,,0,0,0,,А...
Dialogue: 0,0:09:16.38,0:09:18.43,Default,,0,0,0,,Қылмыскер ұсталды ма?
Dialogue: 0,0:09:18.51,0:09:20.93,Default,,0,0,0,,Кім тапса, соған сыйлық беремін.
Dialogue: 0,0:09:21.60,0:09:24.02,Default,,0,0,0,,Бір сағат жеткілікті.
Dialogue: 0,0:09:24.52,0:09:27.44,Default,,0,0,0,,Бұл мағынасы бар, бірақ сіз соншалықты қайдан білесіз?
Dialogue: 0,0:09:27.52,0:09:29.48,Default,,0,0,0,,Ақпарат алу
Dialogue: 0,0:09:29.56,0:09:32.61,Default,,0,0,0,,Урукпен соғыс бастау сюжеті
Dialogue: 0,0:09:33.11,0:09:35.99,Default,,0,0,0,,Грамның бағыныштыларын сатып алу соның бір бөлігі болса керек.
Dialogue: 0,0:09:36.49,0:09:38.41,Default,,0,0,0,,Мұны істеп жатқан ел – Лейтис елі.
Dialogue: 0,0:09:39.41,0:09:40.41,Default,,0,0,0,,Лейтис елі туралы не деуге болады?
Dialogue: 0,0:09:41.03,0:09:42.99,Default,,0,0,0,,Азаматтар саудасы
Dialogue: 0,0:09:43.08,0:09:44.66,Default,,0,0,0,,Егер сізде бір дәлел болса
Dialogue: 0,0:09:44.75,0:09:47.16,Default,,0,0,0,,Соғысқа жеткілікті себеп
Dialogue: 0,0:09:47.25,0:09:50.00,Default,,0,0,0,,Билік орталығынан алынғанымен
Dialogue: 0,0:09:50.08,0:09:51.63,Default,,0,0,0,,Грам - роялти
Dialogue: 0,0:09:51.71,0:09:53.63,Default,,0,0,0,,Бұл, әрине, себеп, бірақ...
Dialogue: 0,0:09:53.71,0:09:54.88,Default,,0,0,0,,Оның мойны… кесіліп қалған жоқ па?
Dialogue: 0,0:09:54.96,0:09:56.63,Default,,0,0,0,,Неліктен соғыс ашқыңыз келеді?
Dialogue: 0,0:09:56.72,0:09:58.05,Default,,0,0,0,,Менің ойымша, алдымен бұл туралы айту керек.
Dialogue: 0,0:09:58.13,0:09:59.14,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:09:59.22,0:10:02.60,Default,,0,0,0,,Король Лейтис қайтыс болған әйелін тірілткісі келеді.
Dialogue: 0,0:10:02.68,0:10:03.81,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:10:05.39,0:10:07.52,Default,,0,0,0,,Патша бұзылды.
Dialogue: 0,0:10:08.02,0:10:10.10,Default,,0,0,0,,Қорқынышты бағамен...
Dialogue: 0,0:10:10.19,0:10:13.32,Default,,0,0,0,,Бұл дүниенің ережелерін бұзуға тырысу
Dialogue: 0,0:10:13.40,0:10:15.15,Default,,0,0,0,,Осымен
Dialogue: 0,0:10:15.23,0:10:16.65,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:10:16.74,0:10:18.11,Default,,0,0,0,,Тіпті менің қайта тірілу сиқырыммен
Dialogue: 0,0:10:18.20,0:10:21.24,Default,,0,0,0,,Өлгеннен кейін бірнеше күн ішінде ғана күшіне енеді
Dialogue: 0,0:10:21.32,0:10:23.62,Default,,0,0,0,,«Алмасу» деген дағды бар.
Dialogue: 0,0:10:24.62,0:10:26.00,Default,,0,0,0,,Егер сіз оны қолдансаңыз
Dialogue: 0,0:10:26.08,0:10:29.00,Default,,0,0,0,,Көптеген адам өмірінің құнына
Dialogue: 0,0:10:29.08,0:10:32.34,Default,,0,0,0,,Бір адамды өмірге қайтаруы мүмкін.
Dialogue: 0,0:10:32.84,0:10:35.92,Default,,0,0,0,,Өлгеннен бері қанша уақыт өтсе де
Dialogue: 0,0:10:36.71,0:10:38.51,Default,,0,0,0,,Сондықтан соғыс...
Dialogue: 0,0:10:39.01,0:10:43.01,Default,,0,0,0,,Сіз көптеген адамдарды тиімді түрде өлтіру үшін соғыс ашқыңыз келеді дейсіз бе?
Dialogue: 0,0:10:44.01,0:10:45.06,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:10:45.56,0:10:47.68,Default,,0,0,0,,Ешкімнің мұны істеуіне рұқсат жоқ.
Dialogue: 0,0:10:48.27,0:10:49.19,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:10:51.31,0:10:52.36,Default,,0,0,0,,Қарға
Dialogue: 0,0:10:52.44,0:10:54.82,Default,,0,0,0,,Лейтис елі туралы көп білесің.
Dialogue: 0,0:10:54.90,0:10:57.65,Default,,0,0,0,,Себебі Бала Зейл рыцарь орденінде болды.
Dialogue: 0,0:10:57.74,0:10:59.07,Default,,0,0,0,,Патша Ямато елінде.
Dialogue: 0,0:10:59.15,0:11:01.32,Default,,0,0,0,,Соғыс бастау әрекетін тоқтату
Dialogue: 0,0:11:01.41,0:11:03.53,Default,,0,0,0,,Ол жұмыстан босатылғанын айтты.
Dialogue: 0,0:11:04.66,0:11:06.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:14.25,0:11:17.67,Default,,0,0,0,,Сіз мұны істесеңіз де, бұл уақытша шара ғана.
Dialogue: 0,0:11:18.26,0:11:21.18,Default,,0,0,0,,Грамдар трафикті жалғастырғанша
Dialogue: 0,0:11:21.26,0:11:23.68,Default,,0,0,0,,Дәлелдер ақырында Лейтис еліне жетеді.
Dialogue: 0,0:11:23.76,0:11:25.01,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:11:25.51,0:11:28.43,Default,,0,0,0,,Сізбен бірге шақырылғандар
Dialogue: 0,0:11:28.52,0:11:31.31,Default,,0,0,0,,Олардың көпшілігі әлі де патша сарайында болса керек.
Dialogue: 0,0:11:31.39,0:11:35.27,Default,,0,0,0,,Соғыс басталса, сені ерлікке үміткер деп атайды.
Dialogue: 0,0:11:35.36,0:11:38.40,Default,,0,0,0,,Сізді майдан шебіне жіберіп, бірінші болып өлесіз.
Dialogue: 0,0:11:38.90,0:11:40.95,Default,,0,0,0,,Мен оларға бәрібір.
Dialogue: 0,0:11:41.03,0:11:42.82,Default,,0,0,0,,Өлсем, ояна алмай қиналамын.
Dialogue: 0,0:11:43.41,0:11:46.95,Default,,0,0,0,,Сіз өлесіз бе, әлде өмір сүріп, бастапқы әлеміңізге ораласыз ба?
Dialogue: 0,0:11:47.03,0:11:49.45,Default,,0,0,0,,Олардың тағдыры сізге байланысты
Dialogue: 0,0:11:50.29,0:11:52.08,Default,,0,0,0,,Бұл қару.
Dialogue: 0,0:11:52.71,0:11:53.75,Default,,0,0,0,,Грамды өшірсеңіз
Dialogue: 0,0:11:54.25,0:11:56.34,Default,,0,0,0,,кем дегенде бір соғыс
Dialogue: 0,0:11:56.42,0:11:58.17,Default,,0,0,0,,Бұл оның алдын алуға болады дегенді білдірмейді.
Dialogue: 0,0:12:05.72,0:12:07.10,Default,,0,0,0,,Негізі мен де
Dialogue: 0,0:12:07.18,0:12:09.85,Default,,0,0,0,,Маңызды ақпарат алдым, сондықтан оны хабарлаймын.
Dialogue: 0,0:12:11.18,0:12:15.06,Default,,0,0,0,,Осы маңдағы артқы көшеде негізінен ет ұсынатын мейрамхана бар.
Dialogue: 0,0:12:15.15,0:12:19.11,Default,,0,0,0,,Біз күн сайын 20 тағаммен шектелген еттің көп бөлігімен өте арзан түскі ас ұсынамыз.
Dialogue: 0,0:12:22.70,0:12:23.86,Default,,0,0,0,,Әрі қарай
Dialogue: 0,0:12:23.95,0:12:26.74,Default,,0,0,0,,Осы жерден орталық субұрқаққа қарай көше бойында пайдаланылған кітап дүкені бар.
Dialogue: 0,0:12:26.82,0:12:28.33,Default,,0,0,0,,Бізде аяқталатын сатылым бар.
Dialogue: 0,0:12:28.41,0:12:31.25,Default,,0,0,0,,Не! Барлық кітаптарға 70% жеңілдік.
Dialogue: 0,0:12:31.83,0:12:33.62,Default,,0,0,0,,Ханшайымдар тамақты жақсы көреді.
Dialogue: 0,0:12:33.71,0:12:36.46,Default,,0,0,0,,Мен Йорудан сіздің ағаңыздың кітапты жақсы көретінін естідім.
Dialogue: 0,0:12:37.04,0:12:37.63,Default,,0,0,0,,Екі адамға
Dialogue: 0,0:12:37.71,0:12:40.75,Default,,0,0,0,,Бұдан артық қандай пайдалы ақпарат болуы мүмкін?
Dialogue: 0,0:12:40.84,0:12:43.26,Default,,0,0,0,,Жоқ... жоқ!
Dialogue: 0,0:12:43.76,0:12:47.14,Default,,0,0,0,,Хехе, өте пайдалы ақпарат.
Dialogue: 0,0:12:47.64,0:12:48.55,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:12:49.72,0:12:51.22,Default,,0,0,0,,Акира кеттік
Dialogue: 0,0:12:51.31,0:12:55.10,Default,,0,0,0,,Менің ойымша, бізге таза ауа жұту керек.
Dialogue: 0,0:12:55.69,0:12:57.61,Default,,0,0,0,,Мен Амелия миссімен келісемін.
Dialogue: 0,0:12:59.15,0:13:00.44,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:13:04.82,0:13:08.99,Default,,0,0,0,,Сөмке әкелу деген нені білдіреді?
Dialogue: 0,0:13:09.07,0:13:10.49,Default,,0,0,0,,Бұл үлкен мәселе.
Dialogue: 0,0:13:11.24,0:13:14.08,Default,,0,0,0,,Шектеулі түскі асқа ерте барып, сапқа тұрған дұрыс.
Dialogue: 0,0:13:14.16,0:13:15.71,Default,,0,0,0,,Қолданылған кітап дүкендеріндегі жабылу сатылымы
Dialogue: 0,0:13:15.79,0:13:18.50,Default,,0,0,0,,Егер сіз жайбарақат болсаңыз, жақсырақ кітаптар сатуыңыз мүмкін.
Dialogue: 0,0:13:18.58,0:13:21.34,Default,,0,0,0,,Үлкен зал екі бөлікке бөлінген?
Dialogue: 0,0:13:21.42,0:13:22.25,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:13:22.34,0:13:23.13,Default,,0,0,0,,Торлы шеге
Dialogue: 0,0:13:23.21,0:13:27.01,Default,,0,0,0,,Біріншіден, жарайды деп ойлаймын, бірақ төтенше жағдай болса, Амелияны сұраймын.
Dialogue: 0,0:13:27.09,0:13:28.55,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:13:28.64,0:13:31.51,Default,,0,0,0,,Әділдік одақтасы ханшайымды қорғайды.
Dialogue: 0,0:13:31.60,0:13:33.10,Default,,0,0,0,,Йору Акира, өтінемін
Dialogue: 0,0:13:33.18,0:13:34.31,Default,,0,0,0,,Түсінді
Dialogue: 0,0:13:36.39,0:13:37.94,Default,,0,0,0,,Торлы шеге де
Dialogue: 0,0:13:38.02,0:13:39.86,Default,,0,0,0,,О, түсіндім, оның бір жақсы жағы бар.
Dialogue: 0,0:13:40.36,0:13:41.15,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:13:44.44,0:13:45.07,Default,,0,0,0,,(сөмкені ұрлаған дыбыс)
Dialogue: 0,0:13:45.15,0:13:46.32,Default,,0,0,0,,Раббым!
Dialogue: 0,0:13:50.83,0:13:51.53,Default,,0,0,0,,Тс!
Dialogue: 0,0:13:52.58,0:13:55.12,Default,,0,0,0,,(ер адамның қатты тыныс алуы)
Dialogue: 0,0:13:55.87,0:13:57.37,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:13:57.46,0:13:58.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:59.29,0:14:00.71,Default,,0,0,0,,Гуруруруру…
Dialogue: 0,0:14:00.79,0:14:01.50,Default,,0,0,0,,- (Түн) Гааааа! -(Ер) Эй!
Dialogue: 0,0:14:01.59,0:14:03.84,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:14:05.55,0:14:07.09,Default,,0,0,0,,Үлкен залға ұқсамайды.
Dialogue: 0,0:14:07.59,0:14:10.68,Default,,0,0,0,,Осындай түкке тұрғысыз адамның артында қалу?
Dialogue: 0,0:14:12.05,0:14:13.51,Default,,0,0,0,,Тіпті кітап қарап отырсам да
Dialogue: 0,0:14:13.60,0:14:15.98,Default,,0,0,0,,Мазмұны менің басыма кірмеді.
Dialogue: 0,0:14:16.68,0:14:21.02,Default,,0,0,0,,Осыншама сабырлылықтан айырылып қалғанымды өзім де сезбедім.
Dialogue: 0,0:14:21.11,0:14:22.90,Default,,0,0,0,,Себебі анық.
Dialogue: 0,0:14:24.11,0:14:25.23,Default,,0,0,0,,Үлкен зал
Dialogue: 0,0:14:26.49,0:14:29.36,Default,,0,0,0,,Менімен біраз сөйлескіңіз келе ме?
Dialogue: 0,0:14:29.86,0:14:30.66,Default,,0,0,0,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,0:14:30.74,0:14:34.03,Default,,0,0,0,,Уау! Сіз жасадыңыз!
Dialogue: 0,0:14:34.12,0:14:35.16,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:14:36.66,0:14:39.16,Default,,0,0,0,,Мырза бір нәрсемен айналысады.
Dialogue: 0,0:14:39.25,0:14:40.25,Default,,0,0,0,,Білсем
Dialogue: 0,0:14:40.75,0:14:43.75,Default,,0,0,0,,Мен де айналамдағы қырағылықты күшейте аламын.
Dialogue: 0,0:14:44.25,0:14:46.67,Default,,0,0,0,,Өте өкінішті, мен сізді алаңдаттым.
Dialogue: 0,0:14:46.76,0:14:48.05,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:14:48.13,0:14:51.51,Default,,0,0,0,,Дәл жүрегіңде ой пайда болған кезде
Dialogue: 0,0:14:51.59,0:14:54.26,Default,,0,0,0,,Мен сенің менімен сөйлескеніңді қалаймын.
Dialogue: 0,0:14:54.35,0:14:56.60,Default,,0,0,0,,Өйткені мен қожайынның қызметшісімін.
Dialogue: 0,0:14:57.10,0:15:00.23,Default,,0,0,0,,Егер сізге сөйлесу қажет болса, сіз әрқашан телепатияны пайдалана аласыз.
Dialogue: 0,0:15:00.31,0:15:01.81,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:15:01.90,0:15:04.82,Default,,0,0,0,,Егер сіз кез келген уақытта сөйлесе аламын деп ойласаңыз
Dialogue: 0,0:15:04.90,0:15:08.19,Default,,0,0,0,,Маңызды нәрселерді айтпай-ақ уақыт өтеді.
Dialogue: 0,0:15:09.11,0:15:10.95,Default,,0,0,0,,Тәңір – адам.
Dialogue: 0,0:15:11.03,0:15:13.20,Default,,0,0,0,,Өмір шектеулі
Dialogue: 0,0:15:13.70,0:15:15.41,Default,,0,0,0,,Құл жынға айналған маған да солай.
Dialogue: 0,0:15:16.41,0:15:19.79,Default,,0,0,0,,Өкінбеу үшін өз ойымызды ортаға салайық.
Dialogue: 0,0:15:21.50,0:15:23.25,Default,,0,0,0,,Мүмкін сіз дұрыс шығарсыз.
Dialogue: 0,0:15:23.79,0:15:26.25,Default,,0,0,0,,Осылай бастапқы әлеміме орала алмасам
Dialogue: 0,0:15:26.34,0:15:28.38,Default,,0,0,0,,Мен отбасыммен көбірек сөйлессем ғой.
Dialogue: 0,0:15:28.46,0:15:29.80,Default,,0,0,0,,Ойлану керек
Dialogue: 0,0:15:30.80,0:15:31.93,Default,,0,0,0,,(Рок Рок) Олардың қабылдау ауқымы шектеулі ме?
Dialogue: 0,0:15:32.01,0:15:33.30,Default,,0,0,0,,Онда мен айтайын.
Dialogue: 0,0:15:33.89,0:15:37.18,Default,,0,0,0,,Мен ойлағаннан әлдеқайда әлсіз болдым.
Dialogue: 0,0:15:37.81,0:15:39.35,Default,,0,0,0,,Тор Наил осылай деді.
Dialogue: 0,0:15:39.85,0:15:43.81,Default,,0,0,0,,Біреуді өлтіру - оның тарихын алып тастау.
Dialogue: 0,0:15:44.31,0:15:46.44,Default,,0,0,0,,Сол адамға ұқсайды.
Dialogue: 0,0:15:46.52,0:15:49.61,Default,,0,0,0,,Грамды өлтіру ең мағыналы.
Dialogue: 0,0:15:50.11,0:15:51.82,Default,,0,0,0,,Не керек, мен өлтірушімін
Dialogue: 0,0:15:51.90,0:15:53.45,Default,,0,0,0,,Бұл тамаша рөл.
Dialogue: 0,0:15:54.20,0:15:56.24,Default,,0,0,0,,Осы уақытқа дейін мен ешкімді өлтірген емеспін.
Dialogue: 0,0:15:56.33,0:15:59.45,Default,,0,0,0,,Менің ойымша, ол бірінші кезекте өлтіруші сияқты көрінбеді.
Dialogue: 0,0:16:00.41,0:16:01.12,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:16:01.71,0:16:03.50,Default,,0,0,0,,Біреудің әңгімесін ұрлау
Dialogue: 0,0:16:03.58,0:16:06.13,Default,,0,0,0,,Мен бұл салмақты көтере аламын ба?
Dialogue: 0,0:16:07.46,0:16:10.30,Default,,0,0,0,,Тіпті сол кезде мені өлтірмек болған жындар да
Dialogue: 0,0:16:10.38,0:16:11.67,Default,,0,0,0,,Өлтіре алмадым
Dialogue: 0,0:16:13.43,0:16:15.89,Default,,0,0,0,,Мен сені өлтіре алмадым.
Dialogue: 0,0:16:18.22,0:16:20.77,Default,,0,0,0,,Бірақ негізгі зал аман қалды.
Dialogue: 0,0:16:20.85,0:16:22.27,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:16:22.89,0:16:25.23,Default,,0,0,0,,Мен әлсіреген кезде жұбатасың ба?
Dialogue: 0,0:16:25.73,0:16:27.11,Default,,0,0,0,,Мүлдем басқаша
Dialogue: 0,0:16:28.11,0:16:31.24,Default,,0,0,0,,Мен сенің бұрынғы мен сияқты болғаныңды қаламаймын.
Dialogue: 0,0:16:31.32,0:16:32.53,Default,,0,0,0,,Дәл осы
Dialogue: 0,0:16:33.40,0:16:36.41,Default,,0,0,0,,Жан алсаң, Жүрегің шөлдейді.
Dialogue: 0,0:16:36.49,0:16:39.45,Default,,0,0,0,,Біртіндеп, бірақ сөзсіз
Dialogue: 0,0:16:41.70,0:16:45.75,Default,,0,0,0,,Тым көп жан алсаң, Жүрегіңдегі шөлдеу шексіз өседі.
Dialogue: 0,0:16:47.04,0:16:49.25,Default,,0,0,0,,Тіпті мен сияқты жын
Dialogue: 0,0:16:51.00,0:16:53.51,Default,,0,0,0,,Мен Иемізбен бұлай болғанын қаламаймын.
Dialogue: 0,0:16:54.01,0:16:55.13,Default,,0,0,0,,«Барлығын мен үшін» мұрагері…
Dialogue: 0,0:16:55.22,0:16:59.01,Default,,0,0,0,,Өзін немесе маңызды нәрсені қорғау үшін кек алу
Dialogue: 0,0:16:59.10,0:17:00.72,Default,,0,0,0,,кейде сөзсіз
Dialogue: 0,0:17:01.22,0:17:04.31,Default,,0,0,0,,Бұл жағдайда өзіңізді кінәлаудың қажеті жоқ.
Dialogue: 0,0:17:04.39,0:17:06.40,Default,,0,0,0,,Менің ойымша, қазір уақыт келді.
Dialogue: 0,0:17:06.98,0:17:10.11,Default,,0,0,0,,Бірақ мен оны таба алмай, көпке дейін адасып кете беремін.
Dialogue: 0,0:17:10.61,0:17:12.11,Default,,0,0,0,,Бұл менің әлсіздігім
Dialogue: 0,0:17:12.61,0:17:14.28,Default,,0,0,0,,Негізгі зал мықты
Dialogue: 0,0:17:14.90,0:17:19.20,Default,,0,0,0,,Маған жаңа хикая берген – Тәңірім.
Dialogue: 0,0:17:20.78,0:17:24.37,Default,,0,0,0,,Маған қызық болды, неліктен Жын патшасы өз ойын өзгертті.
Dialogue: 0,0:17:24.46,0:17:28.08,Default,,0,0,0,,Мен соңына дейін Иеміздің жағында болуды шештім.
Dialogue: 0,0:17:28.75,0:17:31.00,Default,,0,0,0,,Мен Иеміз үшін бәрін жасаймын
Dialogue: 0,0:17:31.09,0:17:33.55,Default,,0,0,0,,Бұған өлтіруші ретінде әрекет ету де кіреді.
Dialogue: 0,0:17:34.80,0:17:36.88,Default,,0,0,0,,Менің орнымды алуға рұқсат етсем
Dialogue: 0,0:17:36.97,0:17:39.18,Default,,0,0,0,,Мен нағыз қоқысқа айналамын.
Dialogue: 0,0:17:39.68,0:17:40.89,Default,,0,0,0,,Бұл үшін кешірім сұраймын.
Dialogue: 0,0:17:41.51,0:17:42.81,Default,,0,0,0,,Ақыр соңында солай болды ма?
Dialogue: 0,0:17:43.97,0:17:45.64,Default,,0,0,0,,Алдымен Грамға өз көзіңізбен қараңыз.
Dialogue: 0,0:17:46.14,0:17:48.60,Default,,0,0,0,,Бұл шынымен сіз өлтіру керек адам екенін тексеріңіз.
Dialogue: 0,0:17:49.10,0:17:50.90,Default,,0,0,0,,Одан кейін не істеу керектігін шешіңіз
Dialogue: 0,0:17:51.40,0:17:53.32,Default,,0,0,0,,Жаратқан Иенің қалауымен
Dialogue: 0,0:17:54.07,0:17:55.57,Default,,0,0,0,,Осылайша
Dialogue: 0,0:17:55.65,0:17:57.95,Default,,0,0,0,,Өз сезімдеріңізді мүмкіндігінше ашыңыз.
Dialogue: 0,0:17:58.03,0:17:59.57,Default,,0,0,0,,Мен әрқашан солай істеймін.
Dialogue: 0,0:17:59.66,0:18:03.33,Default,,0,0,0,,Ол Махиромен соғысып жатқанда, ол капитан Саранға айналды, солай ма?
Dialogue: 0,0:18:03.41,0:18:04.50,Default,,0,0,0,,Не!
Dialogue: 0,0:18:04.58,0:18:06.62,Default,,0,0,0,,Мен сенің бұрын кездескеніңді естімеппін.
Dialogue: 0,0:18:06.71,0:18:09.71,Default,,0,0,0,,Уф... Мен бұл туралы ақырында айтамын.
Dialogue: 0,0:18:09.79,0:18:12.63,Default,,0,0,0,,Хехе, мүмкіндігінше тезірек хабарлаңыз.
Dialogue: 0,0:18:13.38,0:18:14.34,Default,,0,0,0,,Кейінірек
Dialogue: 0,0:18:14.42,0:18:17.09,Default,,0,0,0,,Сіз мені тым көп сатып алып жатырсыз.
Dialogue: 0,0:18:19.89,0:18:21.18,Default,,0,0,0,,Мияу!
Dialogue: 0,0:18:23.68,0:18:24.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:26.77,0:18:27.81,Default,,0,0,0,,Мырза?
Dialogue: 0,0:18:29.06,0:18:30.81,Default,,0,0,0,,Мен мысықтарды жақсы көремін
Dialogue: 0,0:18:31.56,0:18:34.69,Default,,0,0,0,,Мен сені қызметші етуімнің жалғыз себебі.
Dialogue: 0,0:18:36.28,0:18:39.36,Default,,0,0,0,,Хаха, басты залға сәйкестік жоқ.
Dialogue: 0,0:18:44.70,0:18:48.37,Default,,0,0,0,,Грамм мұнда емес, сарайда болса керек.
Dialogue: 0,0:18:48.46,0:18:51.17,Default,,0,0,0,,Ол жаққа барсаң да, бәрібір сені есіктен қайтаратын шығар.
Dialogue: 0,0:18:51.75,0:18:54.92,Default,,0,0,0,,Ол жауапты, сондықтан ол кейде осында көрінуі керек.
Dialogue: 0,0:18:55.42,0:18:58.22,Default,,0,0,0,,Қызметкерлерден келесі қашан болатынын сұраңыз.
Dialogue: 0,0:18:58.30,0:19:00.01,Default,,0,0,0,,Бұл сіз қайтадан келесіз дегенді білдіреді.
Dialogue: 0,0:19:00.09,0:19:00.84,Default,,0,0,0,,О
Dialogue: 0,0:19:00.93,0:19:03.18,Default,,0,0,0,,Ал егер біраз уақыт тұрсақ
Dialogue: 0,0:19:03.26,0:19:05.10,Default,,0,0,0,,Пайда болу мүмкіндігі жоғары
Dialogue: 0,0:19:05.18,0:19:06.10,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:19:06.60,0:19:07.27,Default,,0,0,0,,Кейін көремін
Dialogue: 0,0:19:07.93,0:19:11.02,Default,,0,0,0,,Менің бетімді көретін біреу бар шығар.
Dialogue: 0,0:19:11.10,0:19:12.48,Default,,0,0,0,,Мен сыртта күтемін.
Dialogue: 0,0:19:13.06,0:19:14.23,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:19:14.82,0:19:18.24,Default,,0,0,0,,(Кёко) Ш-шын ба…? Сенің мен Шиндô-кунның араларыңда солай ма…
Dialogue: 0,0:19:18.90,0:19:21.74,Default,,0,0,0,,Не? Бұл балаларға арналған орын емес.
Dialogue: 0,0:19:26.20,0:19:27.66,Default,,0,0,0,,Сізге қажеті жоқ
Dialogue: 0,0:19:28.16,0:19:29.41,Default,,0,0,0,,Біз жай ғана
Dialogue: 0,0:19:29.50,0:19:32.00,Default,,0,0,0,,Мен гильдия шеберінің қашан келетінін білгім келеді.
Dialogue: 0,0:19:32.67,0:19:33.96,Default,,0,0,0,,Маған айтпа
Dialogue: 0,0:19:34.04,0:19:35.92,Default,,0,0,0,,Маған сіздің бастық мінезіңіз ұнамайды.
Dialogue: 0,0:19:39.17,0:19:40.09,Default,,0,0,0,,Аты...
Dialogue: 0,0:19:40.17,0:19:43.39,Default,,0,0,0,,Мен бұл тәкаппар әйелге сөйлеуді үйреттім.
Dialogue: 0,0:19:43.89,0:19:44.51,Default,,0,0,0,,Маған кедергі жасама
Dialogue: 0,0:19:44.60,0:19:46.56,Default,,0,0,0,,Кешіріңіз, бірақ сізге үйретудің қажеті жоқ.
Dialogue: 0,0:19:46.64,0:19:47.47,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:47.56,0:19:49.98,Default,,0,0,0,,Сіз маған кедергі жасамауыңыз керек!
Dialogue: 0,0:19:51.77,0:19:53.19,Default,,0,0,0,,Гунуну…
Dialogue: 0,0:19:54.98,0:19:56.02,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:56.86,0:19:58.03,Default,,0,0,0,,(ДжоДжо) Шынында да, ол адам болса жақсы болар еді.
Dialogue: 0,0:19:58.11,0:19:59.40,Default,,0,0,0,,Рауль, тоқта!
Dialogue: 0,0:20:03.07,0:20:03.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:09.45,0:20:10.83,Default,,0,0,0,,Тоқтама, Келия!
Dialogue: 0,0:20:10.91,0:20:12.16,Default,,0,0,0,,Мыналар
Dialogue: 0,0:20:12.25,0:20:15.33,Default,,0,0,0,,Мен құйынның күміс дәрежесіндегі авантюрист Раулды менсінбедім...
Dialogue: 0,0:20:15.42,0:20:18.59,Default,,0,0,0,,Менің атым Келия, мен осында жұмыс істеймін.
Dialogue: 0,0:20:18.67,0:20:20.71,Default,,0,0,0,,Кешіріңіз, менің авантюристім...
Dialogue: 0,0:20:20.80,0:20:21.47,Default,,0,0,0,,Ах
Dialogue: 0,0:20:21.55,0:20:25.47,Default,,0,0,0,,Амелия ханшайымы және мүмкін қараңғы өлтіруші (үнсіз өлтіруші)?
Dialogue: 0,0:20:26.14,0:20:28.10,Default,,0,0,0,,Жоқ... Не деген жақсы!
Dialogue: 0,0:20:29.31,0:20:33.06,Default,,0,0,0,,Бұрынғы ыңғайсыздық үшін кешірім сұраймын, қара кісі өлтіруші!
Dialogue: 0,0:20:33.81,0:20:36.77,Default,,0,0,0,,Бұл өрескел, бірақ бар күшіңізді салыңыз.
Dialogue: 0,0:20:36.86,0:20:38.32,Default,,0,0,0,,Раульдің уақыты келді.
Dialogue: 0,0:20:38.40,0:20:39.44,Default,,0,0,0,,Ур гильдиясынан
Dialogue: 0,0:20:39.52,0:20:41.69,Default,,0,0,0,,Қараңғы қассасиннің белгілері туралы
Dialogue: 0,0:20:41.78,0:20:44.45,Default,,0,0,0,,Хабарландыру алдыңыз, бірақ оны көрмедіңіз бе?
Dialogue: 0,0:20:44.53,0:20:45.41,Default,,0,0,0,,Мен көрдім!
Dialogue: 0,0:20:45.49,0:20:47.41,Default,,0,0,0,,Жарайды, мен ол кезде Урда болдым.
Dialogue: 0,0:20:47.49,0:20:50.08,Default,,0,0,0,,Мен қара кісі өлтірушіні тірі көрдім!
Dialogue: 0,0:20:50.16,0:20:53.54,Default,,0,0,0,,Қара сиқыр құбыжықтар тобын жалмап жатқан сәт!
Dialogue: 0,0:20:53.62,0:20:55.71,Default,,0,0,0,,Мен бірден жанкүйер болдым!
Dialogue: 0,0:20:55.79,0:20:57.96,Default,,0,0,0,,Онда неге Акираға шабуыл жасадың?
Dialogue: 0,0:20:58.04,0:21:01.67,Default,,0,0,0,,Ух... бұл өте түсінікті...
Dialogue: 0,0:21:02.51,0:21:04.38,Default,,0,0,0,,Жоқ, кешіріңіз.
Dialogue: 0,0:21:04.47,0:21:06.18,Default,,0,0,0,,Мен сенің күшіңді мұншалықты жақсы жасыра аламын деп ойламаппын.
Dialogue: 0,0:21:06.26,0:21:08.10,Default,,0,0,0,,Мен бұл туралы ешқашан армандаған емеспін ...
Dialogue: 0,0:21:09.39,0:21:11.10,Default,,0,0,0,,Ол адал жігіт.
Dialogue: 0,0:21:11.18,0:21:12.18,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:21:12.27,0:21:15.39,Default,,0,0,0,,Рауль ақымақ, бірақ ол жаман бала емес.
Dialogue: 0,0:21:15.48,0:21:17.15,Default,,0,0,0,,Ақымақ деген не? Ақымақ деген не?
Dialogue: 0,0:21:17.23,0:21:19.69,Default,,0,0,0,,Басқа адамның күшін білмей, төбелесті таңдау
Dialogue: 0,0:21:19.77,0:21:21.32,Default,,0,0,0,,Ақымақтардың істегені солай емес пе?
Dialogue: 0,0:21:21.40,0:21:22.23,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:23.03,0:21:23.78,Default,,0,0,0,,Рауль
Dialogue: 0,0:21:23.86,0:21:26.07,Default,,0,0,0,,Мен Қараңғылық өлтірушісінің үлкен жанкүйерімін.
Dialogue: 0,0:21:26.57,0:21:27.74,Default,,0,0,0,,Мені кешіріңіз
Dialogue: 0,0:21:28.45,0:21:30.70,Default,,0,0,0,,Мені өзіңе шәкірт етші!
Dialogue: 0,0:21:30.78,0:21:32.20,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:21:32.29,0:21:34.45,Default,,0,0,0,,Тоқта, мен шәкірт алған жоқпын.
Dialogue: 0,0:21:34.54,0:21:36.25,Default,,0,0,0,,Бұл туралы бірдеңе жасаңыз!
Dialogue: 0,0:21:36.33,0:21:37.87,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:21:38.46,0:21:40.13,Default,,0,0,0,,Бұл шулы.
Dialogue: 0,0:21:40.21,0:21:41.75,Default,,0,0,0,,(Есіктің жабылу дыбысы)
Dialogue: 0,0:21:42.34,0:21:43.30,Default,,0,0,0,,Астанада ханым Куруш оларды қор ретінде жинап жатқанын естідім.
Dialogue: 0,0:21:52.39,0:21:53.27,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:21:53.35,0:21:56.39,Default,,0,0,0,,Бұл Амелия Роуз Кварц.
Dialogue: 0,0:21:57.10,0:21:58.10,Default,,0,0,0,,Мен
Dialogue: 0,0:21:58.19,0:22:02.02,Default,,0,0,0,,Осы Урук қалалық авантюристер гильдиясының гильдия шебері
Dialogue: 0,0:22:03.07,0:22:05.78,Default,,0,0,0,,Менің атым – Грам кластері.
Dialogue: 0,0:22:11.37,0:22:13.37,Default,,0,0,0,,♪～
Dialogue: 0,0:23:38.95,0:23:40.96,Default,,0,0,0,,～♪
