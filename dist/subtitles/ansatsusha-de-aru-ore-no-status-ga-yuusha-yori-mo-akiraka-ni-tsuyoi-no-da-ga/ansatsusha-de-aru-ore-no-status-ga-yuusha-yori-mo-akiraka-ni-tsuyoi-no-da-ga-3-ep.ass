Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.58,0:00:03.16,Default,,0,0,0,,Бұл...
Dialogue: 0,0:00:11.01,0:00:11.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:11.97,0:00:12.92,Default,,0,0,0,,Мысық па?
Dialogue: 0,0:00:13.51,0:00:15.51,Default,,0,0,0,,♪～
Dialogue: 0,0:01:40.30,0:01:42.31,Default,,0,0,0,,～♪
Dialogue: 0,0:01:44.97,0:01:47.19,Default,,0,0,0,,Мен әлсізмін, бірақ өлдім деп ойламаймын.
Dialogue: 0,0:01:48.06,0:01:50.23,Default,,0,0,0,,«Трансформация» қосымша дағдысы бар.
Dialogue: 0,0:01:50.73,0:01:51.86,Default,,0,0,0,,Трансформация?
Dialogue: 0,0:01:51.94,0:01:52.77,Default,,0,0,0,,Иә
Dialogue: 0,0:01:52.86,0:01:55.69,Default,,0,0,0,,Нағыз айдаһар қиынырақ болар еді.
Dialogue: 0,0:01:56.19,0:01:57.95,Default,,0,0,0,,Бұл құбыжықтың аты...
Dialogue: 0,0:01:58.53,0:01:59.95,Default,,0,0,0,,Қара мысық
Dialogue: 0,0:02:00.03,0:02:01.49,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:02:01.57,0:02:03.49,Default,,0,0,0,,Сіз дүниенің көзін пайдаланасыз ба?
Dialogue: 0,0:02:03.58,0:02:05.33,Default,,0,0,0,,Неліктен Акира оны қолданбайды?
Dialogue: 0,0:02:06.58,0:02:08.08,Default,,0,0,0,,Жақсы бақыланбаған
Dialogue: 0,0:02:08.79,0:02:10.67,Default,,0,0,0,,Сіздің деңгейіңіз жеткіліксіз болуы мүмкін.
Dialogue: 0,0:02:11.25,0:02:13.67,Default,,0,0,0,,Бұл жай ғана Акира бас тартады.
Dialogue: 0,0:02:13.75,0:02:14.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:15.09,0:02:18.93,Default,,0,0,0,,А... Мен мұндай дәрежедегі біреуден жеңілемін деп ойламаппын.
Dialogue: 0,0:02:20.01,0:02:22.72,Default,,0,0,0,,Көңіл көтеру үшін мен өзімді бір кезде көрген айдаһардың кейпін жасыруға тырыстым.
Dialogue: 0,0:02:22.80,0:02:24.39,Default,,0,0,0,,Сіз тым көңілді болған сияқтысыз
Dialogue: 0,0:02:25.10,0:02:27.10,Default,,0,0,0,,Сіз сөйлей аласыз ба?
Dialogue: 0,0:02:27.18,0:02:30.40,Default,,0,0,0,,Тек түйсіктері бар құбыжықтармен араласпаңыз.
Dialogue: 0,0:02:30.48,0:02:31.60,Default,,0,0,0,,Жын патшасы менмін
Dialogue: 0,0:02:31.69,0:02:35.69,Default,,0,0,0,,Ол ақылдылығы жоғары жын болып жаратылған.
Dialogue: 0,0:02:35.78,0:02:38.40,Default,,0,0,0,,Мен өзімді ақылдымын
Dialogue: 0,0:02:38.49,0:02:39.82,Default,,0,0,0,,Ондай жігіт бар.
Dialogue: 0,0:02:39.90,0:02:41.78,Default,,0,0,0,,Әйтеуір, әлгі пері.
Dialogue: 0,0:02:41.87,0:02:45.33,Default,,0,0,0,,100 жыл өмір сүрмеген жас жігіт не біледі?
Dialogue: 0,0:02:45.41,0:02:48.87,Default,,0,0,0,,Сіз бастық сияқты сөйлейсіз, бірақ өз ұстанымыңызды түсінесіз бе?
Dialogue: 0,0:02:48.96,0:02:52.04,Default,,0,0,0,,Бұрынғы зақымданғандықтан көп қозғала алмайсыз, солай ма?
Dialogue: 0,0:02:52.54,0:02:54.38,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,0:02:54.46,0:02:55.96,Default,,0,0,0,,Бірақ бұған дейін
Dialogue: 0,0:02:56.05,0:02:59.47,Default,,0,0,0,,Менің саған Жын патшасынан хабарым бар.
Dialogue: 0,0:02:59.55,0:03:00.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:00.51,0:03:01.72,Default,,0,0,0,,Жын патшасы мен үшін бе?
Dialogue: 0,0:03:02.51,0:03:05.56,Default,,0,0,0,,«Вулкан, жындар мекендейтін құрлық»
Dialogue: 0,0:03:05.64,0:03:08.85,Default,,0,0,0,,«Артқы жағындағы Жын патшасының сарайында күтіңіз»
Dialogue: 0,0:03:09.60,0:03:10.69,Default,,0,0,0,,Осымен
Dialogue: 0,0:03:10.77,0:03:11.94,Default,,0,0,0,,Бұл біртүрлі, солай емес пе?
Dialogue: 0,0:03:12.02,0:03:13.61,Default,,0,0,0,,Жын патшасы мені қайдан біледі?
Dialogue: 0,0:03:13.69,0:03:16.61,Default,,0,0,0,,Менің мұнда келетінімді білдім дейсіз бе?
Dialogue: 0,0:03:16.69,0:03:17.65,Default,,0,0,0,,Саана
Dialogue: 0,0:03:18.15,0:03:22.24,Default,,0,0,0,,Жын патшасының терең ойлары маған да, басқаларға да түсініксіз.
Dialogue: 0,0:03:22.32,0:03:25.28,Default,,0,0,0,,Жарайды, менің жұмысым бітті, мені өлтіріңдер.
Dialogue: 0,0:03:27.45,0:03:28.24,Default,,0,0,0,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:03:28.33,0:03:30.12,Default,,0,0,0,,Мені өлтір.
Dialogue: 0,0:03:30.62,0:03:35.04,Default,,0,0,0,,Құбыжықтар мен жындар басқа нәсілдердің ортақ жауы ма?
Dialogue: 0,0:03:37.17,0:03:38.84,Default,,0,0,0,,Бұл дәл хоум-ран болған жоқ қой, иә~!?
Dialogue: 0,0:03:38.92,0:03:40.13,Default,,0,0,0,,Айтпақшы,
Dialogue: 0,0:03:41.76,0:03:44.14,Default,,0,0,0,,Жын-перілердің жаулары тең болатын алғышарт
Dialogue: 0,0:03:44.64,0:03:45.97,Default,,0,0,0,,Бұл өте күдікті.
Dialogue: 0,0:03:46.05,0:03:47.26,Default,,0,0,0,,Бірақ Акира
Dialogue: 0,0:03:47.35,0:03:50.93,Default,,0,0,0,,Есік бастық та, қаскүнем де өлмейінше ашылмайды.
Dialogue: 0,0:03:51.02,0:03:52.56,Default,,0,0,0,,Мен мұны білемін.
Dialogue: 0,0:03:52.64,0:03:54.35,Default,,0,0,0,,Неліктен өлтірмеске?
Dialogue: 0,0:03:54.85,0:03:56.44,Default,,0,0,0,,Мен мысықтарды жақсы көремін
Dialogue: 0,0:03:56.52,0:03:57.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:57.77,0:04:00.69,Default,,0,0,0,,Осындай әдемі жүні бар мысықты өлтіре аласыз ба?
Dialogue: 0,0:04:01.32,0:04:02.11,Default,,0,0,0,,Манга салмас бұрын жаттығулар
Dialogue: 0,0:04:02.20,0:04:05.45,Default,,0,0,0,,Аң сияқты құбыжықтардан айырмашылығы, біз бір-бірімізбен сөйлесе аламыз.
Dialogue: 0,0:04:06.03,0:04:08.03,Default,,0,0,0,,Мені мазақ етуге қарсы емеспін.
Dialogue: 0,0:04:08.12,0:04:10.58,Default,,0,0,0,,Мен мұнда аштан өле аламын ба?
Dialogue: 0,0:04:10.66,0:04:13.83,Default,,0,0,0,,Біздің қолымыздан келетін нәрсе бар ма? Бұл қулық сияқты
Dialogue: 0,0:04:13.92,0:04:16.08,Default,,0,0,0,,Бұл мүмкін, бірақ...
Dialogue: 0,0:04:16.17,0:04:17.46,Default,,0,0,0,,Ол шынымен бар ма?
Dialogue: 0,0:04:18.88,0:04:20.59,Default,,0,0,0,,Шебер мен қызметші шарты
Dialogue: 0,0:04:21.76,0:04:25.01,Default,,0,0,0,,Мына баланы Акираға қызметші етсең, ол енді бастық болмайды.
Dialogue: 0,0:04:25.51,0:04:26.64,Default,,0,0,0,,Бұл бос теория.
Dialogue: 0,0:04:26.72,0:04:31.10,Default,,0,0,0,,Келісім-шарт рәсімі шебердің ерекше сиқырлы манипуляциясына негізделген.
Dialogue: 0,0:04:31.18,0:04:32.98,Default,,0,0,0,,Тәжірибесіз бәйбіше мұны істей алмайды.
Dialogue: 0,0:04:33.06,0:04:33.69,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:04:33.77,0:04:35.40,Default,,0,0,0,,Акира мұны ертерек жасады.
Dialogue: 0,0:04:35.48,0:04:36.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:36.40,0:04:37.56,Default,,0,0,0,,Мұндай әрекетті кім жасай алады?
Dialogue: 0,0:04:38.23,0:04:40.57,Default,,0,0,0,,Менің білуімше, тек бірінші қаһарман
Dialogue: 0,0:04:40.65,0:04:42.24,Default,,0,0,0,,Мені не шатастырды
Dialogue: 0,0:04:42.32,0:04:44.95,Default,,0,0,0,,Денені тастап кеткен сиқырлы күш болды ма?
Dialogue: 0,0:04:45.86,0:04:48.45,Default,,0,0,0,,Акира рәсімді орындай алады.
Dialogue: 0,0:04:48.53,0:04:50.95,Default,,0,0,0,,Бірақ ол сәтті бола ма, жоқ па...
Dialogue: 0,0:04:51.54,0:04:53.08,Default,,0,0,0,,Егер сәтсіздікке ұшырасаңыз не болады?
Dialogue: 0,0:04:53.66,0:04:57.33,Default,,0,0,0,,Не сен, не мен өлеміз, не екеуміз де өлеміз.
Dialogue: 0,0:04:59.59,0:05:00.38,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:05:00.46,0:05:03.88,Default,,0,0,0,,Неліктен бұлай ұзаққа барасың? Мен өліп қалуым мүмкін
Dialogue: 0,0:05:03.97,0:05:06.68,Default,,0,0,0,,Барлығы, ештеңе, тек мен не істегім келеді.
Dialogue: 0,0:05:06.76,0:05:08.09,Default,,0,0,0,,ақымақ
Dialogue: 0,0:05:08.18,0:05:10.85,Default,,0,0,0,,Мен сәтсіздікке ұшырап, өлсем де бәрібір.
Dialogue: 0,0:05:10.93,0:05:11.81,Default,,0,0,0,,мұнда тұтқындарды пайдаланып көмір қазылады
Dialogue: 0,0:05:12.39,0:05:14.73,Default,,0,0,0,,Маған бұл басынан ұнамады.
Dialogue: 0,0:05:14.81,0:05:17.81,Default,,0,0,0,,Өлсең де, тірісің де маңызды емес дейсің.
Dialogue: 0,0:05:17.90,0:05:19.56,Default,,0,0,0,,Жалқаулық
Dialogue: 0,0:05:21.36,0:05:22.53,Default,,0,0,0,,Мен енді өмір сүрмесем де
Dialogue: 0,0:05:22.61,0:05:24.15,Default,,0,0,0,,Жаман ештеңе жоқ
Dialogue: 0,0:05:24.24,0:05:26.15,Default,,0,0,0,,Менің ойымша, дәл осылай.
Dialogue: 0,0:05:26.65,0:05:27.95,Default,,0,0,0,,Рәсім қалай орындалады?
Dialogue: 0,0:05:28.03,0:05:29.24,Default,,0,0,0,,О, мм...
Dialogue: 0,0:05:29.32,0:05:32.24,Default,,0,0,0,,Алдымен бұл балаға Акира жаңа есім береді.
Dialogue: 0,0:05:42.55,0:05:44.13,Default,,0,0,0,,«Түн» туралы не деуге болады?
Dialogue: 0,0:05:44.88,0:05:48.68,Default,,0,0,0,,Түнгі аспанға ұқсайтын әдемі жүнінің атымен аталған.
Dialogue: 0,0:05:52.81,0:05:53.39,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:54.06,0:05:58.14,Default,,0,0,0,,Содан кейін қолдарыңызды біріктіріп, сиқырлы күшіңізді қарсыласыңызға салыңыз.
Dialogue: 0,0:05:58.23,0:05:59.90,Default,,0,0,0,,Акира мұны істей алуы керек.
Dialogue: 0,0:06:00.40,0:06:01.36,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:06:01.44,0:06:03.94,Default,,0,0,0,,Алға кетсең, кері бұрыла алмайсың.
Dialogue: 0,0:06:04.44,0:06:08.70,Default,,0,0,0,,Табысқа жетіп, жан-дүниелеріңді байланыстырасың ба, әлде сәтсіздікке ұшырап, өлесің бе?
Dialogue: 0,0:06:09.61,0:06:11.49,Default,,0,0,0,,-Мен... -(Акира) Менің өлетін ойым жоқ.
Dialogue: 0,0:06:12.83,0:06:13.53,Default,,0,0,0,,Иә
Dialogue: 0,0:06:32.68,0:06:35.81,Default,,0,0,0,,Бұл оның ішінде ме?
Dialogue: 0,0:06:37.02,0:06:38.60,Default,,0,0,0,,Ах, қала...
Dialogue: 0,0:06:42.44,0:06:42.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:45.44,0:06:50.61,Default,,0,0,0,,(Түнгі айқай)
Dialogue: 0,0:06:53.32,0:06:55.37,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:06:57.95,0:06:58.50,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:07:04.50,0:07:05.13,Default,,0,0,0,,Гррр…
Dialogue: 0,0:07:06.34,0:07:06.88,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:08.76,0:07:09.63,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:07:11.13,0:07:12.18,Default,,0,0,0,,Қылышыңды шығар!
Dialogue: 0,0:07:12.76,0:07:14.05,Default,,0,0,0,,Мені өлтір
Dialogue: 0,0:07:14.14,0:07:19.02,Default,,0,0,0,,Жаның осында өлсе, тәнің де тірі өлікке айналады.
Dialogue: 0,0:07:19.10,0:07:21.81,Default,,0,0,0,,Мені өлтіруден басқа өмір сүруге жол жоқ!
Dialogue: 0,0:07:28.44,0:07:29.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:29.99,0:07:30.70,Default,,0,0,0,,Гррр…
Dialogue: 0,0:07:34.49,0:07:35.62,Default,,0,0,0,,Ха…
Dialogue: 0,0:07:40.25,0:07:40.91,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:07:44.04,0:07:44.58,Default,,0,0,0,,Әй!
Dialogue: 0,0:07:44.67,0:07:47.13,Default,,0,0,0,,А... мотивацияңыз бар ма?
Dialogue: 0,0:07:47.63,0:07:51.22,Default,,0,0,0,,Енді өлгің келмесе, мені өлтір.
Dialogue: 0,0:08:04.52,0:08:05.98,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:08:06.61,0:08:08.86,Default,,0,0,0,,Мені өлтір, сонда құтыласың.
Dialogue: 0,0:08:10.07,0:08:12.65,Default,,0,0,0,,Мен сені өлтірмеймін
Dialogue: 0,0:08:13.28,0:08:15.62,Default,,0,0,0,,Сен де мені өлтіргің келмейді, солай ма?
Dialogue: 0,0:08:16.41,0:08:18.08,Default,,0,0,0,,Мен құбыжықпын
Dialogue: 0,0:08:18.62,0:08:21.45,Default,,0,0,0,,Құбыжықтар басқа нәсілдерді өлтіруі керек.
Dialogue: 0,0:08:21.54,0:08:22.71,Default,,0,0,0,,Бұл тіпті ереже ме?
Dialogue: 0,0:08:22.79,0:08:24.96,Default,,0,0,0,,Бұл ереже емес, инстинкт.
Dialogue: 0,0:08:25.04,0:08:27.54,Default,,0,0,0,,Ақыл болса да, инстинктті жоя алмайсың.
Dialogue: 0,0:08:28.04,0:08:32.22,Default,,0,0,0,,Бұдан шаршаған жоқсың ба?
Dialogue: 0,0:08:33.67,0:08:36.89,Default,,0,0,0,,Ештеңе етпейді, мен оны реттеймін.
Dialogue: 0,0:08:37.93,0:08:42.73,Default,,0,0,0,,Сіз мұны енді ешқашан жасамайсыз деп үміттенемін.
Dialogue: 0,0:09:08.38,0:09:09.17,Default,,0,0,0,,Өкінішке орай, Амон мен Акира Кокреяда…
Dialogue: 0,0:09:10.63,0:09:12.05,Default,,0,0,0,,… жертөледен бе?
Dialogue: 0,0:09:12.67,0:09:14.55,Default,,0,0,0,,Акира тірі
Dialogue: 0,0:09:14.63,0:09:15.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:25.35,0:09:26.69,Default,,0,0,0,,Елтаңба
Dialogue: 0,0:09:29.52,0:09:30.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:30.23,0:09:32.15,Default,,0,0,0,,Жандардың байланысын дәлелдеу
Dialogue: 0,0:09:34.74,0:09:35.24,Default,,0,0,0,,Фу…
Dialogue: 0,0:09:36.24,0:09:40.28,Default,,0,0,0,,Мен де сенің қайда жүргеніңді көргім келеді.
Dialogue: 0,0:09:40.37,0:09:43.41,Default,,0,0,0,,Сіздің қожайыныңыздың аты - Акира Ода.
Dialogue: 0,0:09:43.49,0:09:45.54,Default,,0,0,0,,Йору, өтінемін
Dialogue: 0,0:09:45.62,0:09:48.42,Default,,0,0,0,,Йору... жақсы есім
Dialogue: 0,0:09:48.92,0:09:51.00,Default,,0,0,0,,Жаңа Лорд Акира Ода
Dialogue: 0,0:09:51.50,0:09:53.17,Default,,0,0,0,,Мен сізге қызмет етуге уәде беремін.
Dialogue: 0,0:09:53.75,0:09:55.17,Default,,0,0,0,,Мен Амелиямын
Dialogue: 0,0:09:55.26,0:09:56.34,Default,,0,0,0,,Yoru Танысқаныма қуаныштымын
Dialogue: 0,0:09:56.92,0:09:57.76,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:57.84,0:10:00.60,Default,,0,0,0,,Үлкен залдағы жолдастарыңызға құрмет көрсетіңіз.
Dialogue: 0,0:10:01.18,0:10:01.89,Default,,0,0,0,,(Шинобу) Мұнда тірі қалғандар жоқ сияқты.
Dialogue: 0,0:10:01.97,0:10:02.76,Default,,0,0,0,,Достар!
Dialogue: 0,0:10:08.81,0:10:09.73,Default,,0,0,0,,Мен бұған жол бере алмаймын.
Dialogue: 0,0:10:10.31,0:10:11.44,Default,,0,0,0,,Сиқырлы шеңбер?
Dialogue: 0,0:10:11.52,0:10:13.52,Default,,0,0,0,,Мен енді мұнда бастық емеспін.
Dialogue: 0,0:10:13.61,0:10:15.74,Default,,0,0,0,,Сіз лабиринтті де мақұлдаған сияқтысыз.
Dialogue: 0,0:10:22.33,0:10:26.12,Default,,0,0,0,,Енді мен келесі қадамға көшкім келеді.
Dialogue: 0,0:10:26.20,0:10:27.71,Default,,0,0,0,,Йору қозғала алмайды, солай ма?
Dialogue: 0,0:10:27.79,0:10:30.25,Default,,0,0,0,,Сіз оны қолданбайынша шығу жоғалмайды.
Dialogue: 0,0:10:30.33,0:10:32.25,Default,,0,0,0,,Маған біраз демалуға рұқсат ете аласыз ба?
Dialogue: 0,0:10:32.34,0:10:35.21,Default,,0,0,0,,Бастық бөлмесіне басқа құбыжықтар келмейді.
Dialogue: 0,0:10:35.30,0:10:37.76,Default,,0,0,0,,А, онда бәріміз сөйлесейік?
Dialogue: 0,0:10:38.80,0:10:40.80,Default,,0,0,0,,Мен Амелия миссімен келісемін.
Dialogue: 0,0:10:40.89,0:10:43.26,Default,,0,0,0,,Бұл бір-бірін білуге жақсы мүмкіндік
Dialogue: 0,0:10:43.35,0:10:44.89,Default,,0,0,0,,Кенет босап қалды.
Dialogue: 0,0:10:45.77,0:10:47.81,Default,,0,0,0,,Күте тұрыңыз, жақсы ма?
Dialogue: 0,0:10:49.48,0:10:50.39,Default,,0,0,0,,О, о...
Dialogue: 0,0:10:51.94,0:10:55.65,Default,,0,0,0,,Сол құрлықта Ямато деген ел бар деп естідім.
Dialogue: 0,0:10:55.73,0:10:57.65,Default,,0,0,0,,Мен бәрібір соған ұмтылдым...
Dialogue: 0,0:10:59.95,0:11:04.45,Default,,0,0,0,,Бірнеше ұрпақ бұрын шақырылған батыр салған ел... Ол не?
Dialogue: 0,0:11:04.53,0:11:06.24,Default,,0,0,0,,Міне, міне!
Dialogue: 0,0:11:08.29,0:11:11.83,Default,,0,0,0,,О! Екеуі бірге жақсы көрінеді.
Dialogue: 0,0:11:11.92,0:11:13.83,Default,,0,0,0,,Жақсы... өте жақсы
Dialogue: 0,0:11:13.92,0:11:15.88,Default,,0,0,0,,Шынымен бе? Сізге дәл ұқсайды ма?
Dialogue: 0,0:11:16.46,0:11:17.34,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:11:17.42,0:11:19.72,Default,,0,0,0,,Киінуге біраз уақыт кетті.
Dialogue: 0,0:11:19.80,0:11:21.13,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:11:21.22,0:11:23.14,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:11:23.97,0:11:26.68,Default,,0,0,0,,Мен ешқашан теңіз өнімдерін жей аламын деп ойламадым.
Dialogue: 0,0:11:26.76,0:11:30.60,Default,,0,0,0,,Мен де ыстық бұлаққа бардым, сондықтан Сатоның соңынан ергеніме қуаныштымын.
Dialogue: 0,0:11:30.69,0:11:31.39,Default,,0,0,0,,Хехе
Dialogue: 0,0:11:31.48,0:11:35.31,Default,,0,0,0,,Мұнда маған ұнайтын Бакумацу атмосферасы бар.
Dialogue: 0,0:11:35.40,0:11:38.48,Default,,0,0,0,,Ryoma-san немесе Kondo-san кездейсоқ пайда болуы мүмкін.
Dialogue: 0,0:11:38.57,0:11:40.49,Default,,0,0,0,,Юки-чан, мен васаби аламын ба?
Dialogue: 0,0:11:40.57,0:11:41.24,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:41.32,0:11:44.45,Default,,0,0,0,,Басқа біреуде васаби қалдығы болса, соларға да беріңіз.
Dialogue: 0,0:11:44.53,0:11:46.74,Default,,0,0,0,,Шиори-чан, сен маған қатты ұнайсың.
Dialogue: 0,0:11:47.99,0:11:49.50,Default,,0,0,0,,Жағдайды реттеп көрейік
Dialogue: 0,0:11:49.58,0:11:50.96,Default,,0,0,0,,Біріншіден, сізде қанша ақша бар?
Dialogue: 0,0:11:51.04,0:11:53.25,Default,,0,0,0,,Мен жұмыс іздемесем, жақын арада түбіне жетемін.
Dialogue: 0,0:11:53.33,0:11:55.25,Default,,0,0,0,,Авантюрист болған дұрыс емес пе?
Dialogue: 0,0:11:55.33,0:11:57.25,Default,,0,0,0,,Мен тас жолда бірнеше адамның жанынан өттім.
Dialogue: 0,0:11:57.34,0:12:00.17,Default,,0,0,0,,Гильдияға тіркелсеңіз, сұрауларды қабылдай аласыз.
Dialogue: 0,0:12:00.26,0:12:00.92,Default,,0,0,0,,Иә
Dialogue: 0,0:12:01.01,0:12:02.17,Default,,0,0,0,,Содан кейін ақпарат
Dialogue: 0,0:12:02.88,0:12:05.43,Default,,0,0,0,,Біз бұл дүние туралы тым аз білеміз.
Dialogue: 0,0:12:05.51,0:12:09.18,Default,,0,0,0,,Мен көп адамдармен сөйлескім келеді, мүмкіндігінше кітап алғым келеді.
Dialogue: 0,0:12:09.27,0:12:10.47,Default,,0,0,0,,Хаа…
Dialogue: 0,0:12:10.56,0:12:14.48,Default,,0,0,0,,Қызық, қандай да бір кітапта жазылған түпнұсқа әлемге оралудың жолы бар ма?
Dialogue: 0,0:12:14.56,0:12:15.90,Default,,0,0,0,,Бұл.
Dialogue: 0,0:12:17.27,0:12:21.07,Default,,0,0,0,,Менің ойымша, үйге оралудың төте жолы - жын патшасын жеңу.
Dialogue: 0,0:12:21.15,0:12:22.07,Default,,0,0,0,,А...
Dialogue: 0,0:12:22.15,0:12:23.65,Default,,0,0,0,,Себебін айт.
Dialogue: 0,0:12:24.36,0:12:26.62,Default,,0,0,0,,Бізді шақырған патша мен ханшайым
Dialogue: 0,0:12:26.70,0:12:28.53,Default,,0,0,0,,Қайтуды білетін шығар.
Dialogue: 0,0:12:29.45,0:12:32.04,Default,,0,0,0,,Егер сіз несие алсаңыз, келіссөздер жүргізе алуыңыз керек.
Dialogue: 0,0:12:32.12,0:12:35.04,Default,,0,0,0,,Сыныптағылардың барлығы патша сарайында қалады.
Dialogue: 0,0:12:35.62,0:12:36.29,Default,,0,0,0,,Иә
Dialogue: 0,0:12:36.92,0:12:38.54,Default,,0,0,0,,Сонымен, жол жүру шығындары мен ақпарат
Dialogue: 0,0:12:38.63,0:12:41.51,Default,,0,0,0,,Осы екі нәрсе орнында болған кезде, мен жындар континентіне барғым келеді.
Dialogue: 0,0:12:41.59,0:12:44.30,Default,,0,0,0,,Жоқ, мен алдымен Акирамен кездесуім керек.
Dialogue: 0,0:12:44.38,0:12:48.30,Default,,0,0,0,,Осы жерде қалсаң, Акира келуі мүмкін.
Dialogue: 0,0:12:48.39,0:12:50.93,Default,,0,0,0,,Менің «интуиция» шеберлігім айтып тұр
Dialogue: 0,0:12:51.02,0:12:53.14,Default,,0,0,0,,Акира бізден әлдеқайда күшті.
Dialogue: 0,0:12:53.64,0:12:55.90,Default,,0,0,0,,Онсыз жын патшаға қарсы шығу қауіпті.
Dialogue: 0,0:12:56.40,0:12:58.02,Default,,0,0,0,,Асахина-кун солай ойласа
Dialogue: 0,0:12:58.11,0:12:59.06,Default,,0,0,0,,Мен де...
Dialogue: 0,0:12:59.15,0:12:59.69,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:12:59.77,0:13:02.19,Default,,0,0,0,,Мен де онымен қайта сөйлескім келеді.
Dialogue: 0,0:13:02.28,0:13:03.44,Default,,0,0,0,,Біздің де осындай хоббиіміз бар
Dialogue: 0,0:13:03.53,0:13:06.07,Default,,0,0,0,,Ол капитан Саранды өлтірген болуы мүмкін.
Dialogue: 0,0:13:06.66,0:13:08.62,Default,,0,0,0,,Бұл әңгіме әлдеқашан айтылған шығар.
Dialogue: 0,0:13:08.70,0:13:13.37,Default,,0,0,0,,Біздің қабылдауымыз қарғыспен бұзылса.
Dialogue: 0,0:13:13.45,0:13:17.08,Default,,0,0,0,,Бірақ жалғыз Ода-кун бүкіл уақыт бойы бөлек әрекет етті.
Dialogue: 0,0:13:17.17,0:13:19.38,Default,,0,0,0,,Бірге жасай аламыз ба?
Dialogue: 0,0:13:20.54,0:13:22.84,Default,,0,0,0,,Бұл партияның жетекшісі Сато мырза.
Dialogue: 0,0:13:22.92,0:13:26.26,Default,,0,0,0,,Сато, Асахинаның пікірі туралы не ойлайсыз?
Dialogue: 0,0:13:27.55,0:13:30.01,Default,,0,0,0,,Мен де Акира туралы білмейтін сияқтымын.
Dialogue: 0,0:13:30.51,0:13:33.60,Default,,0,0,0,,Сенің бізден күшті екенің рас шығар.
Dialogue: 0,0:13:34.56,0:13:37.73,Default,,0,0,0,,Дегенмен бірге күресу қиын.
Dialogue: 0,0:13:38.23,0:13:38.94,Default,,0,0,0,,Титанның алдында сарбаздар бірінен соң бірі құлады.
Dialogue: 0,0:13:39.44,0:13:42.32,Default,,0,0,0,,Біз балабақшадан бір сыныпта оқимыз.
Dialogue: 0,0:13:42.40,0:13:44.53,Default,,0,0,0,,Ол әлі есімде жоқ жігіт.
Dialogue: 0,0:13:44.61,0:13:45.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:45.69,0:13:48.57,Default,,0,0,0,,Акираға үйлестіру жетіспейтіні рас.
Dialogue: 0,0:13:48.66,0:13:51.12,Default,,0,0,0,,Білемін, өйткені мен де Акирамен көптен бері жүргенмін.
Dialogue: 0,0:13:51.20,0:13:54.62,Default,,0,0,0,,Жын патшаны батырдың киелі қылышы ғана жеңетін сияқты.
Dialogue: 0,0:13:54.70,0:13:57.75,Default,,0,0,0,,Олай болса, партияның ынтымақтастығы маңызды.
Dialogue: 0,0:13:58.25,0:14:01.21,Default,,0,0,0,,Билікте айырмашылық болған кезде Акирадан ынтымақтастықты сұрасаңыз да,
Dialogue: 0,0:14:01.29,0:14:02.63,Default,,0,0,0,,Тыңдамайды
Dialogue: 0,0:14:02.71,0:14:07.42,Default,,0,0,0,,Бір күш болғаннан кейін ғана дұрыс топтасуға болады деп ойлаған дұрыс.
Dialogue: 0,0:14:07.51,0:14:08.13,Default,,0,0,0,,Біз бәріміз құтқарылар едік
Dialogue: 0,0:14:09.13,0:14:11.05,Default,,0,0,0,,Мен Акираны осында күтсем де,
Dialogue: 0,0:14:11.14,0:14:12.68,Default,,0,0,0,,Жақын жерде күресуге болатын құбыжықтар
Dialogue: 0,0:14:12.76,0:14:15.14,Default,,0,0,0,,Біздің деңгейімізбен тең болғанша ғана.
Dialogue: 0,0:14:15.22,0:14:16.64,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:14:17.23,0:14:17.89,Default,,0,0,0,,Иә
Dialogue: 0,0:14:17.98,0:14:18.98,Default,,0,0,0,,- (Нанасе) Жарайды - (Ваки) Ой
Dialogue: 0,0:14:23.23,0:14:25.90,Default,,0,0,0,,Жарайды, әрекетті бастайық.
Dialogue: 0,0:14:26.61,0:14:28.74,Default,,0,0,0,,(Амелия қатты тыныс алуы)
Dialogue: 0,0:14:33.78,0:14:34.58,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:49.26,0:14:50.88,Default,,0,0,0,,Не... неге?
Dialogue: 0,0:14:50.97,0:14:53.51,Default,,0,0,0,,Менің сізден сұрайын дегенім осы.
Dialogue: 0,0:14:54.72,0:14:58.39,Default,,0,0,0,,Неге әлі тірісің?
Dialogue: 0,0:15:10.57,0:15:12.53,Default,,0,0,0,,Мен елден кетуге мәжбүр болдым.
Dialogue: 0,0:15:15.70,0:15:19.33,Default,,0,0,0,,Жуынған жағада, Қара шлам жұтып
Dialogue: 0,0:15:20.21,0:15:22.92,Default,,0,0,0,,Келесі бір білгенім, Акира сонда екен.
Dialogue: 0,0:15:23.00,0:15:25.00,Default,,0,0,0,,Бұл өте қиын жағдай.
Dialogue: 0,0:15:25.09,0:15:26.50,Default,,0,0,0,,Бірақ мен түсінбеймін.
Dialogue: 0,0:15:26.59,0:15:28.55,Default,,0,0,0,,Шлам адамға жем болмайды
Dialogue: 0,0:15:28.63,0:15:32.18,Default,,0,0,0,,Жесе де, қорытылмай, сол күйінде қалар еді...
Dialogue: 0,0:15:32.26,0:15:36.39,Default,,0,0,0,,Соның арқасында мен Акирамен кездестім, сол шламға ризамын.
Dialogue: 0,0:15:37.14,0:15:39.18,Default,,0,0,0,,Осыны айтып тұрсыз ба?
Dialogue: 0,0:15:39.68,0:15:43.44,Default,,0,0,0,,Өз еліңе қайтып, шаруаңды реттеу керек.
Dialogue: 0,0:15:44.48,0:15:45.44,Default,,0,0,0,,Дұрыс~, оны баяу төмен түсір. Не істегің келетінін білемін.
Dialogue: 0,0:15:45.52,0:15:48.15,Default,,0,0,0,,Менің қайтатын жерім жоқ.
Dialogue: 0,0:15:48.98,0:15:50.40,Default,,0,0,0,,Әңгімелесейік
Dialogue: 0,0:15:50.49,0:15:52.61,Default,,0,0,0,,Сенің ұрысып жатқаның менің әпкем ғой, солай ма?
Dialogue: 0,0:15:54.03,0:15:56.12,Default,,0,0,0,,Бұл мүмкін емес, өйткені ол менің әпкем.
Dialogue: 0,0:15:57.45,0:15:59.91,Default,,0,0,0,,Мен бұл отбасы болғандықтан қиын екенін түсінемін.
Dialogue: 0,0:16:00.41,0:16:03.54,Default,,0,0,0,,Бірақ егер сіз отбасы болсаңыз, оны жеңе аласыз.
Dialogue: 0,0:16:06.50,0:16:10.17,Default,,0,0,0,,Менің де әпкем бар.
Dialogue: 0,0:16:16.76,0:16:19.43,Default,,0,0,0,,Қараңызшы, экран барлық уақытта жарылған, солай ма?
Dialogue: 0,0:16:19.52,0:16:21.60,Default,,0,0,0,,Соңғы кездері ұйқыңыз келмеді.
Dialogue: 0,0:16:21.68,0:16:22.18,Default,,0,0,0,,А...
Dialogue: 0,0:16:22.27,0:16:24.94,Default,,0,0,0,,Толық емес жұмыс күнін көбірек сатып алуға өзіңізді мәжбүрлегеніңізді қаламаймын.
Dialogue: 0,0:16:25.02,0:16:26.36,Default,,0,0,0,,Қазірдің өзінде... ең нашар
Dialogue: 0,0:16:26.94,0:16:29.86,Default,,0,0,0,,Жаман ағасың, апамды жылаттың.
Dialogue: 0,0:16:30.48,0:16:31.28,Default,,0,0,0,,Ә? (Кения) Сен➡
Dialogue: 0,0:16:31.36,0:16:32.61,Default,,0,0,0,,Оянған дұрыс па?
Dialogue: 0,0:16:33.11,0:16:33.78,Default,,0,0,0,,Иә
Dialogue: 0,0:16:34.57,0:16:37.83,Default,,0,0,0,,Эй Юи, маған Акираның сезімін түсінуге көмектесші.
Dialogue: 0,0:16:39.33,0:16:40.16,Default,,0,0,0,,Эй?
Dialogue: 0,0:16:42.50,0:16:44.46,Default,,0,0,0,,Мен ашулымын, өйткені мен білемін
Dialogue: 0,0:16:45.42,0:16:47.46,Default,,0,0,0,,Жарайды, мен сені осы жолы ғана кешіремін.
Dialogue: 0,0:16:47.54,0:16:49.04,Default,,0,0,0,,Оны алып, жоғарыдан айт?
Dialogue: 0,0:16:49.13,0:16:50.96,Default,,0,0,0,,Хехехе
Dialogue: 0,0:16:52.97,0:16:56.55,Default,,0,0,0,,Әйтеуір, отбасы болса, аздап қиындап кетсе де жарайды.
Dialogue: 0,0:16:57.59,0:17:01.35,Default,,0,0,0,,Мырзаның отбасы басқа әлемде болды.
Dialogue: 0,0:17:01.43,0:17:03.27,Default,,0,0,0,,Акира, танысқыңыз келе ме?
Dialogue: 0,0:17:03.35,0:17:04.02,Default,,0,0,0,,О
Dialogue: 0,0:17:04.10,0:17:07.44,Default,,0,0,0,,Мен дереу үйге барып, анам мен әпкемді көргім келеді.
Dialogue: 0,0:17:08.23,0:17:08.81,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:17:09.98,0:17:11.86,Default,,0,0,0,,Бірақ оған дейін менің бір ісім бар.
Dialogue: 0,0:17:11.94,0:17:12.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:13.61,0:17:16.78,Default,,0,0,0,,Өзімнің бастапқы әлемімде мен өзімнің көлеңкем болдым.
Dialogue: 0,0:17:16.86,0:17:19.12,Default,,0,0,0,,Мені ешкім ойлаған жоқ.
Dialogue: 0,0:17:19.62,0:17:22.04,Default,,0,0,0,,Сондықтан да «бар болуды жасыру» дағдысы
Dialogue: 0,0:17:22.12,0:17:23.20,Default,,0,0,0,,Мен біртүрлі сенімді болдым.
Dialogue: 0,0:17:24.20,0:17:26.79,Default,,0,0,0,,Мені дереу табыңыз
Dialogue: 0,0:17:26.87,0:17:29.67,Default,,0,0,0,,Маған бұл дүниеде қалай өмір сүру керектігін үйреткен адам бар.
Dialogue: 0,0:17:30.17,0:17:33.09,Default,,0,0,0,,Ол кісіні арам жігіттер өлтірді.
Dialogue: 0,0:17:34.38,0:17:37.93,Default,,0,0,0,,Менімен бұлай араласпасаң, өлтірілмес едің.
Dialogue: 0,0:17:38.80,0:17:42.64,Default,,0,0,0,,Мен капитан Саранның кегін алмайынша қайтпаймын!
Dialogue: 0,0:17:42.72,0:17:43.27,Default,,0,0,0,,Өкінішке орай, Амон мен Акира Кокреяда…
Dialogue: 0,0:17:44.48,0:17:47.56,Default,,0,0,0,,Мырза, сіз өзіңіздің өлтіру ниетіңізді баса аласыз ба?
Dialogue: 0,0:17:47.64,0:17:49.06,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:17:51.98,0:17:53.98,Default,,0,0,0,,Айтпақшы, Саран туралы жоғарыда не айтылған?
Dialogue: 0,0:17:54.07,0:17:56.03,Default,,0,0,0,,Сіз Саран Мисрей туралы айтып отырсыз ба?
Dialogue: 0,0:17:56.11,0:17:57.70,Default,,0,0,0,,Мен де есімін білемін.
Dialogue: 0,0:17:57.78,0:17:58.66,Default,,0,0,0,,А...
Dialogue: 0,0:17:58.74,0:18:01.78,Default,,0,0,0,,Ол елдің рыцарьларының қолбасшысы болғандықтан атақты.
Dialogue: 0,0:18:01.87,0:18:03.20,Default,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,0:18:04.54,0:18:06.16,Default,,0,0,0,,Мияу!
Dialogue: 0,0:18:08.12,0:18:10.25,Default,,0,0,0,,Сіз не істеп жатырсыз? Негізгі зал
Dialogue: 0,0:18:10.33,0:18:13.96,Default,,0,0,0,,Атмосфера ауырлай бастады, сондықтан мен көңіл-күйді жеңілдеткім келді.
Dialogue: 0,0:18:14.05,0:18:16.84,Default,,0,0,0,,Мен көршімдегі қаңғыбас мысықтармен жиі ойнайтынмын.
Dialogue: 0,0:18:16.92,0:18:18.80,Default,,0,0,0,,Мен қаңғыбас мысық емеспін.
Dialogue: 0,0:18:18.88,0:18:21.05,Default,,0,0,0,,Акира Мен де солай жасағым келеді.
Dialogue: 0,0:18:21.14,0:18:22.51,Default,,0,0,0,,Мисс Амелияға дейін...
Dialogue: 0,0:18:22.60,0:18:24.01,Default,,0,0,0,,Хэхе~♪
Dialogue: 0,0:18:24.10,0:18:25.89,Default,,0,0,0,,Керемет жанасу
Dialogue: 0,0:18:26.39,0:18:28.06,Default,,0,0,0,,Осы ретте мен анық айтқым келеді
Dialogue: 0,0:18:28.14,0:18:31.02,Default,,0,0,0,,Мысықтарды жақсы көру - бұл жай ғана қолайлылық емес.
Dialogue: 0,0:18:31.10,0:18:32.19,Default,,0,0,0,,Өйткені бұл маңызды.
Dialogue: 0,0:18:32.27,0:18:33.44,Default,,0,0,0,,Мен де мысықтарды жақсы көремін
Dialogue: 0,0:18:33.52,0:18:36.49,Default,,0,0,0,,Әй... аздап ащы етіп жасай аласыз ба?
Dialogue: 0,0:18:37.15,0:18:39.86,Default,,0,0,0,,Егер мен және Раббымыз өлсе...
Dialogue: 0,0:18:39.95,0:18:41.37,Default,,0,0,0,,Екіншісі де өледі.
Dialogue: 0,0:18:41.45,0:18:44.12,Default,,0,0,0,,Өйткені біздің жанымыз бір-бірімен байланысты... солай ма?
Dialogue: 0,0:18:44.20,0:18:45.29,Default,,0,0,0,,Иә
Dialogue: 0,0:18:45.99,0:18:47.00,Default,,0,0,0,,Қосымша өнім ретінде
Dialogue: 0,0:18:47.08,0:18:50.12,Default,,0,0,0,,Қанша жерден алшақ болсаң да, жүрегіңмен сырласуға болады.
Dialogue: 0,0:18:50.21,0:18:52.13,Default,,0,0,0,,Бұл смартфонға қарағанда ыңғайлы
Dialogue: 0,0:18:52.21,0:18:53.13,Default,,0,0,0,,Мен ең болмағанда алған ақшамды қайтарып бергім келеді.
Dialogue: 0,0:18:53.71,0:18:54.92,Default,,0,0,0,,Келесі, мына жігіт
Dialogue: 0,0:18:55.00,0:18:57.30,Default,,0,0,0,,Бірақ Йормен келісім-шарт жасаған мен болдым.
Dialogue: 0,0:18:57.38,0:18:59.13,Default,,0,0,0,,Бұл менің қызметшім.
Dialogue: 0,0:18:59.63,0:19:02.76,Default,,0,0,0,,Мен Акира емес, Йоруды қызғанамын.
Dialogue: 0,0:19:02.85,0:19:04.10,Default,,0,0,0,,Бірдеңе айттыңыз ба?
Dialogue: 0,0:19:04.18,0:19:05.39,Default,,0,0,0,,Мен ештеңе айтқан жоқпын
Dialogue: 0,0:19:09.14,0:19:10.19,Default,,0,0,0,,Ол шығады ма?
Dialogue: 0,0:19:11.40,0:19:12.10,Default,,0,0,0,,Бұл сіздің барлық жүктеріңіз бе?
Dialogue: 0,0:19:12.19,0:19:13.94,Default,,0,0,0,,Бұл қайда әкеледі?
Dialogue: 0,0:19:14.02,0:19:15.40,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:19:15.48,0:19:18.32,Default,,0,0,0,,Сиқырлы шеңберлер туралы білімі бар және жасай алатындар
Dialogue: 0,0:19:18.40,0:19:20.57,Default,,0,0,0,,Енді жындардың шектеулі саны ғана
Dialogue: 0,0:19:20.65,0:19:21.61,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:21.70,0:19:24.03,Default,,0,0,0,,Содан кейін кек алу аяқталғаннан кейін
Dialogue: 0,0:19:24.12,0:19:27.08,Default,,0,0,0,,Мен жындар аумағына кіріп, сиқырлы шеңбер құруым керек.
Dialogue: 0,0:19:27.95,0:19:30.87,Default,,0,0,0,,Айтпақшы, мен де жын патшамен кездесіп, саған да жүз жасаймын.
Dialogue: 0,0:19:31.46,0:19:32.71,Default,,0,0,0,,Мен бұл үшін ризамын.
Dialogue: 0,0:19:34.42,0:19:36.13,Default,,0,0,0,,Мен мұны бұрыннан естігенмін.
Dialogue: 0,0:19:36.71,0:19:40.26,Default,,0,0,0,,Ақшыл телепортацияның сиқырлы шеңбері қалаған жерге баруға мүмкіндік береді.
Dialogue: 0,0:19:40.34,0:19:44.09,Default,,0,0,0,,Бірнеше адам кірсе, бір адамның еркіне жауап береді дейді.
Dialogue: 0,0:19:44.18,0:19:46.31,Default,,0,0,0,,Егер оқиға рас болса
Dialogue: 0,0:19:46.39,0:19:49.27,Default,,0,0,0,,Ақырында, қай жерде болатының қай жерде болатыныңа байланысты.
Dialogue: 0,0:19:49.85,0:19:53.56,Default,,0,0,0,,Мен... Акирамен бірге болғанша кез келген жерде жақсы.
Dialogue: 0,0:19:59.11,0:20:01.82,Default,,0,0,0,,Қасымда болсаң, тамаққа алаңдамайсың, солай ма?
Dialogue: 0,0:20:01.90,0:20:02.78,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:20:03.95,0:20:06.20,Default,,0,0,0,,Осы кезде мен ойладым
Dialogue: 0,0:20:07.03,0:20:09.04,Default,,0,0,0,,Бейбіт күнделікті өмірге оралғыңыз келсе
Dialogue: 0,0:20:09.12,0:20:12.04,Default,,0,0,0,,Сиқырлы шеңбер оны жүзеге асыра ма?
Dialogue: 0,0:20:13.08,0:20:16.00,Default,,0,0,0,,Бұл менің басымды сипады, бірақ мен оны тез тоқтаттым.
Dialogue: 0,0:20:17.00,0:20:20.26,Default,,0,0,0,,Бұл тілек әлі орындалмауы керек.
Dialogue: 0,0:20:28.76,0:20:29.68,Default,,0,0,0,,О~
Dialogue: 0,0:20:29.77,0:20:30.93,Default,,0,0,0,,Өтірік…
Dialogue: 0,0:20:31.02,0:20:32.77,Default,,0,0,0,,Бұл киелі ағаш
Dialogue: 0,0:20:32.85,0:20:37.44,Default,,0,0,0,,Демек, бұл Орман континенті, Эльф тайпасының аумағы?
Dialogue: 0,0:20:37.52,0:20:39.11,Default,,0,0,0,,Сіз ұзақ жолдан өттіңіз.
Dialogue: 0,0:20:39.61,0:20:42.19,Default,,0,0,0,,Бірақ бұл жаман дереккөз емес.
Dialogue: 0,0:20:42.78,0:20:45.66,Default,,0,0,0,,Неліктен? Мен әлі келгім келмеді
Dialogue: 0,0:21:02.55,0:21:03.17,Default,,0,0,0,,Өкінішке орай, Амон мен Акира Кокреяда…
Dialogue: 0,0:21:05.01,0:21:06.64,Default,,0,0,0,,Қозғалсаң басың кесіледі.
Dialogue: 0,0:21:07.84,0:21:08.68,Default,,0,0,0,,Өкінішке орай, Амон мен Акира Кокреяда…
Dialogue: 0,0:21:13.18,0:21:14.81,Default,,0,0,0,,Лиам Гладиолус…
Dialogue: 0,0:21:15.77,0:21:18.31,Default,,0,0,0,,Мен біртүрлі жарық көрдім, сондықтан мен тергеуге келдім.
Dialogue: 0,0:21:18.40,0:21:20.57,Default,,0,0,0,,Елін тастап кеткен қылмыскерлер бар.
Dialogue: 0,0:21:21.23,0:21:23.24,Default,,0,0,0,,Сен енді ханшайым емессің
Dialogue: 0,0:21:23.32,0:21:25.11,Default,,0,0,0,,Бұл елде орын жоқ
Dialogue: 0,0:21:25.61,0:21:26.41,Default,,0,0,0,,Дәл сол кездегідей қашып кет...
Dialogue: 0,0:21:26.49,0:21:27.82,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:29.70,0:21:32.95,Default,,0,0,0,,Мен естімеген нәрселерді сөйлейтіндерді ұнатпаймын.
Dialogue: 0,0:21:33.54,0:21:35.58,Default,,0,0,0,,Рахмет саған Акира
Dialogue: 0,0:21:35.66,0:21:38.04,Default,,0,0,0,,Жоқ, жауап баяу болған сияқты.
Dialogue: 0,0:21:39.13,0:21:40.71,Default,,0,0,0,,Қазірдің өзінде қоршалған
Dialogue: 0,0:21:44.38,0:21:47.13,Default,,0,0,0,,Қайтып келгеніңізге қуаныштымын.
Dialogue: 0,0:21:48.89,0:21:49.85,Default,,0,0,0,,Кирика…
Dialogue: 0,0:21:50.43,0:21:53.27,Default,,0,0,0,,Маған жиіркенішті бала ретінде зиян келтіру қылмысы.
Dialogue: 0,0:21:53.35,0:21:55.10,Default,,0,0,0,,Бұл жолы мен түзетемін.
Dialogue: 0,0:21:56.39,0:21:58.94,Default,,0,0,0,,Сәлем, Амелия-сама
Dialogue: 0,0:22:01.19,0:22:01.86,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:22:04.82,0:22:06.49,Default,,0,0,0,,Бұл өте күрделі.
Dialogue: 0,0:22:11.37,0:22:13.37,Default,,0,0,0,,♪～
Dialogue: 0,0:23:38.95,0:23:40.96,Default,,0,0,0,,～♪
