Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.25,0:00:05.17,Default,,0,0,0,,Әпке
Dialogue: 0,0:00:05.79,0:00:07.54,Default,,0,0,0,,Кез келген уақытта оралыңыз
Dialogue: 0,0:00:07.63,0:00:08.13,Default,,0,0,0,,Иә
Dialogue: 0,0:00:09.21,0:00:10.17,Default,,0,0,0,,Көмегің үшін рахмет
Dialogue: 0,0:00:10.80,0:00:12.55,Default,,0,0,0,,Амелия, өтінемін.
Dialogue: 0,0:00:12.63,0:00:14.93,Default,,0,0,0,,Жарайды, сен де жақсылық жасау керексің.
Dialogue: 0,0:00:15.01,0:00:18.18,Default,,0,0,0,,Енді біз Лиамның шынайы сезімдерін білеміз.
Dialogue: 0,0:00:18.26,0:00:19.97,Default,,0,0,0,,Қалғанын Кирика шешеді.
Dialogue: 0,0:00:22.56,0:00:24.77,Default,,0,0,0,,Портқа алып бару
Dialogue: 0,0:00:25.35,0:00:27.23,Default,,0,0,0,,Бұл аздап асыра сілтеу емес пе?
Dialogue: 0,0:00:27.81,0:00:30.61,Default,,0,0,0,,Жағалауда адам ұрлау көп.
Dialogue: 0,0:00:30.69,0:00:34.90,Default,,0,0,0,,Менің тексеруден уақытша оралу себебім қарсы шаралар қолдану болды.
Dialogue: 0,0:00:35.95,0:00:37.74,Default,,0,0,0,,Акира күшті, сондықтан бәрі жақсы
Dialogue: 0,0:00:38.37,0:00:41.95,Default,,0,0,0,,Әйтсе де, ата-ананың баласының қамын ойлайтын әдеті.
Dialogue: 0,0:00:42.04,0:00:43.96,Default,,0,0,0,,Мен де сізге ілескім келеді.
Dialogue: 0,0:00:44.04,0:00:46.29,Default,,0,0,0,,Не? Сосын мен де!
Dialogue: 0,0:00:46.37,0:00:47.33,Default,,0,0,0,,болса, мен де!
Dialogue: 0,0:00:47.42,0:00:48.71,Default,,0,0,0,,Біз сенімен бірге боламыз!
Dialogue: 0,0:00:48.79,0:00:50.34,Default,,0,0,0,,Итасуна
Dialogue: 0,0:00:51.80,0:00:53.80,Default,,0,0,0,,♪～
Dialogue: 0,0:02:18.93,0:02:20.93,Default,,0,0,0,,～♪
Dialogue: 0,0:02:27.56,0:02:28.06,Default,,0,0,0,,Түн
Dialogue: 0,0:02:28.64,0:02:31.69,Default,,0,0,0,,Сіз пері патшасының алдында өте тыныш болдыңыз.
Dialogue: 0,0:02:32.27,0:02:35.86,Default,,0,0,0,,Жындар мен құбыжықтарға риза болған адамдар сирек кездеседі.
Dialogue: 0,0:02:36.36,0:02:39.11,Default,,0,0,0,,Егер сіз кедергі келтірсеңіз, үлкен залда қиыншылық болады.
Dialogue: 0,0:02:39.20,0:02:41.74,Default,,0,0,0,,Көңіл көтеру үшін мысықты басыңа киіп алдың ба?
Dialogue: 0,0:02:42.49,0:02:43.37,Default,,0,0,0,,Оны киесіз бе?
Dialogue: 0,0:02:44.12,0:02:48.16,Default,,0,0,0,,Жын патшасы тым түсінген болса, оның беделі түсіп кетпей ме?
Dialogue: 0,0:02:48.25,0:02:49.46,Default,,0,0,0,,Сізді бақылап жатыр ма?
Dialogue: 0,0:02:49.54,0:02:51.12,Default,,0,0,0,,Сіз оны таптың.
Dialogue: 0,0:02:51.62,0:02:55.38,Default,,0,0,0,,Қазірдің өзінде менің көзім мен құлағым Жын патшаға жалғанған.
Dialogue: 0,0:02:55.46,0:02:58.55,Default,,0,0,0,,Дегенмен, сіздің әрекеттеріңізге кедергі болмайды.
Dialogue: 0,0:02:58.63,0:03:01.89,Default,,0,0,0,,Менің қожайыныма опасыздық жасау ниетім жоқ.
Dialogue: 0,0:03:02.64,0:03:05.72,Default,,0,0,0,,Егер мен жын патшамен жанжалдасам
Dialogue: 0,0:03:05.81,0:03:07.52,Default,,0,0,0,,Жын патшасының соңынан еру керек.
Dialogue: 0,0:03:07.60,0:03:09.98,Default,,0,0,0,,Сол кезде ойланыңыз
Dialogue: 0,0:03:10.06,0:03:14.81,Default,,0,0,0,,Алайда, жын патшасы басты залмен кездесуді қалады.
Dialogue: 0,0:03:14.90,0:03:16.90,Default,,0,0,0,,Әзірше бәрі жақсы болады.
Dialogue: 0,0:03:16.98,0:03:20.99,Default,,0,0,0,,Жын патшасы да Акирамен тіл табысқысы келуі мүмкін.
Dialogue: 0,0:03:21.07,0:03:22.78,Default,,0,0,0,,Акира кеше жақсы болды
Dialogue: 0,0:03:22.86,0:03:23.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:24.45,0:03:26.03,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:03:26.12,0:03:29.58,Default,,0,0,0,,Шебердің әпкесімен жекпе-жекте қолданған тәсілдері
Dialogue: 0,0:03:29.66,0:03:32.42,Default,,0,0,0,,Жын лордтары да қызық болса керек.
Dialogue: 0,0:03:33.33,0:03:35.59,Default,,0,0,0,,Көлеңке сиқырынан басқа сиқыр жоқ.
Dialogue: 0,0:03:35.67,0:03:39.63,Default,,0,0,0,,Тәттілігі де менің кигенім.
Dialogue: 0,0:03:40.84,0:03:44.05,Default,,0,0,0,,Осылай жалғаса берсем, көлеңкелі сиқыр Кириканы жеп қояды деп ойладым.
Dialogue: 0,0:03:44.14,0:03:45.55,Default,,0,0,0,,Мен мұны бірден жасадым.
Dialogue: 0,0:03:45.64,0:03:47.72,Default,,0,0,0,,Барған сайын қорқамын
Dialogue: 0,0:03:47.81,0:03:50.31,Default,,0,0,0,,Сашизуме Бұл «көлеңкемен жабылған» сияқты ма?
Dialogue: 0,0:03:50.39,0:03:53.94,Default,,0,0,0,,«Көлеңкелік киім» Бұл жақсы атау.
Dialogue: 0,0:03:55.56,0:03:56.11,Default,,0,0,0,,Арбаны тоқтатыңыз
Dialogue: 0,0:03:58.98,0:04:00.03,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:00.11,0:04:01.95,Default,,0,0,0,,Қатысуды анықтау реакциясы болды
Dialogue: 0,0:04:04.03,0:04:05.07,Default,,0,0,0,,А...
Dialogue: 0,0:04:05.16,0:04:07.08,Default,,0,0,0,,Біртүрлі әрекеттер жасамау~
Dialogue: 0,0:04:07.16,0:04:09.70,Default,,0,0,0,,Сіз баланың өлгенін қаламайсыз, солай ма?
Dialogue: 0,0:04:09.79,0:04:12.96,Default,,0,0,0,,Басқа жақта белгілерді сезетін біреу болды ма?
Dialogue: 0,0:04:14.87,0:04:15.96,Default,,0,0,0,,Бір-бірін байланыстыр
Dialogue: 0,0:04:16.04,0:04:18.96,Default,,0,0,0,,Ей, ұрылар!
Dialogue: 0,0:04:19.05,0:04:19.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:20.46,0:04:23.84,Default,,0,0,0,,Бас Бұл шаштың түсі пері ханшайымы.
Dialogue: 0,0:04:23.93,0:04:25.68,Default,,0,0,0,,О, бұл үлкен нәрсе.
Dialogue: 0,0:04:26.30,0:04:29.01,Default,,0,0,0,,Грам-самаға ұсынсаң, ол қуанады.
Dialogue: 0,0:04:29.97,0:04:30.93,Default,,0,0,0,,(Үлдеген дыбыс)
Dialogue: 0,0:04:34.02,0:04:35.10,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:04:35.19,0:04:35.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:38.06,0:04:40.27,Default,,0,0,0,,Арқан да бар, оны байлаңыз.
Dialogue: 0,0:04:40.36,0:04:41.69,Default,,0,0,0,,А... иә
Dialogue: 0,0:04:42.40,0:04:43.70,Default,,0,0,0,,Енді бәрі жақсы
Dialogue: 0,0:04:43.78,0:04:46.20,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:04:48.53,0:04:50.83,Default,,0,0,0,,Садақа беремін дедіңіз.
Dialogue: 0,0:04:51.37,0:04:54.08,Default,,0,0,0,,Грэм мырза ұрлаудың клиенті ме?
Dialogue: 0,0:04:54.58,0:04:55.83,Default,,0,0,0,,Бұл таныс сияқты.
Dialogue: 0,0:04:56.46,0:04:58.88,Default,,0,0,0,,Урук, хайуандардың ең үлкен елі
Dialogue: 0,0:04:58.96,0:05:01.80,Default,,0,0,0,,Корольдік отбасында Грам есімді адам болды ма?
Dialogue: 0,0:05:02.30,0:05:04.47,Default,,0,0,0,,Мына жігіттерді сарайға қайтар.
Dialogue: 0,0:05:04.97,0:05:06.43,Default,,0,0,0,,үшін эскорт үшін.
Dialogue: 0,0:05:06.51,0:05:08.59,Default,,0,0,0,,Бірақ патшаның бұйрығы...
Dialogue: 0,0:05:08.68,0:05:11.35,Default,,0,0,0,,Тұзды судың иісін сезіп тұрғаныма біраз болды.
Dialogue: 0,0:05:11.43,0:05:14.06,Default,,0,0,0,,Жақын, солай ма? Порт - бұл
Dialogue: 0,0:05:15.52,0:05:21.02,Default,,0,0,0,,(Толқындардың дыбысы мен теңіз құстарының айқайы)
Dialogue: 0,0:05:21.69,0:05:23.74,Default,,0,0,0,,Келген кезде алдымен қаруларыңды дайында.
Dialogue: 0,0:05:23.82,0:05:25.57,Default,,0,0,0,,Мүмкін болса, мен де деңгейді арттырғым келеді.
Dialogue: 0,0:05:25.65,0:05:27.99,Default,,0,0,0,,Акира Сіз әлі де күшті болғыңыз келе ме?
Dialogue: 0,0:05:28.70,0:05:31.91,Default,,0,0,0,,Капитан Саранның өлімі үшін кек алу үшін,
Dialogue: 0,0:05:31.99,0:05:33.62,Default,,0,0,0,,Артық деген нәрсе жоқ
Dialogue: 0,0:05:33.70,0:05:36.41,Default,,0,0,0,,Порт қаласында лабиринт болған болуы керек.
Dialogue: 0,0:05:36.50,0:05:39.08,Default,,0,0,0,,Онда сіздің деңгейіңізді көтеру жақсы идея болуы мүмкін.
Dialogue: 0,0:05:40.04,0:05:43.46,Default,,0,0,0,,Қалай болғанда да, келуге бірнеше күн қажет.
Dialogue: 0,0:05:45.38,0:05:49.18,Default,,0,0,0,,Менің қолымнан келетіні қазір демалу.
Dialogue: 0,0:05:53.14,0:05:57.14,Default,,0,0,0,,Акира Мен қайықпен бірінші рет саяхаттап отырмын!
Dialogue: 0,0:05:57.23,0:06:00.19,Default,,0,0,0,,Теңізде күн өткізу керемет.
Dialogue: 0,0:06:00.27,0:06:03.90,Default,,0,0,0,,Акирамен бірге теңізде күннің батуын көру
Dialogue: 0,0:06:03.98,0:06:05.82,Default,,0,0,0,,Жұлдызды аспанға қарап...
Dialogue: 0,0:06:05.90,0:06:06.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:07.24,0:06:08.40,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:06:08.49,0:06:09.95,Default,,0,0,0,,Оны көргенде білесің
Dialogue: 0,0:06:10.03,0:06:11.07,Default,,0,0,0,,Оқу.
Dialogue: 0,0:06:11.66,0:06:13.70,Default,,0,0,0,,Екеуміз бірге жүзіп жүрсек те?
Dialogue: 0,0:06:13.79,0:06:16.08,Default,,0,0,0,,Сенің әкең жақсы адам емес пе?
Dialogue: 0,0:06:16.66,0:06:19.21,Default,,0,0,0,,Менен қоштасу үшін не қалайтынымды сұрады.
Dialogue: 0,0:06:19.29,0:06:22.09,Default,,0,0,0,,Мен кітап оқығым келеді десем, ол маған кітапханасынан біраз кітаптар берді.
Dialogue: 0,0:06:22.96,0:06:25.09,Default,,0,0,0,,Мен кітапқа қарным ашты, сондықтан бұл үлкен көмек болды.
Dialogue: 0,0:06:25.17,0:06:26.63,Default,,0,0,0,,Әкенің ақымақ
Dialogue: 0,0:06:26.71,0:06:27.80,Default,,0,0,0,,Сіз бірдеңе айттыңыз ба?
Dialogue: 0,0:06:27.88,0:06:28.97,Default,,0,0,0,,Мен Акира ақымақ дедім!
Dialogue: 0,0:06:29.05,0:06:30.59,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:30.68,0:06:33.47,Default,,0,0,0,,Му!
Dialogue: 0,0:06:43.86,0:06:47.36,Default,,0,0,0,,Бұл жануар континенті, Брут.
Dialogue: 0,0:06:48.40,0:06:50.45,Default,,0,0,0,,Акира Мен көптен бері кітап оқимын
Dialogue: 0,0:06:50.53,0:06:51.99,Default,,0,0,0,,Немесе ұйықтап қалды
Dialogue: 0,0:06:55.12,0:06:57.79,Default,,0,0,0,,Бұл порттағы Ур қаласы ма?
Dialogue: 0,0:06:59.21,0:07:02.63,Default,,0,0,0,,Қол еңбегін адам ғана жасайды.
Dialogue: 0,0:07:04.46,0:07:05.63,Default,,0,0,0,,Эй
Dialogue: 0,0:07:05.71,0:07:07.76,Default,,0,0,0,,Әлгі адам баласы
Dialogue: 0,0:07:07.84,0:07:09.09,Default,,0,0,0,,Пері апа, мені қалдырыңыз
Dialogue: 0,0:07:09.17,0:07:10.38,Default,,0,0,0,,Тотто Усена
Dialogue: 0,0:07:10.47,0:07:11.84,Default,,0,0,0,,Артқа қалыңыз.
Dialogue: 0,0:07:13.09,0:07:15.35,Default,,0,0,0,,О? Мен үшін не істеп жатырсың?
Dialogue: 0,0:07:15.43,0:07:18.64,Default,,0,0,0,,Әлсіз адамдар бізді жеңе алмайды, ақымақтар.
Dialogue: 0,0:07:19.60,0:07:23.02,Default,,0,0,0,,Қарасам, бұл жерде адамдарға менсінбей қарайды.
Dialogue: 0,0:07:24.02,0:07:27.61,Default,,0,0,0,,Кім айтты...?
Dialogue: 0,0:07:32.03,0:07:33.07,Default,,0,0,0,,Уф... уф!
Dialogue: 0,0:07:33.16,0:07:35.20,Default,,0,0,0,,Көз... Көре алмаймын!
Dialogue: 0,0:07:35.28,0:07:36.28,Default,,0,0,0,,Кеттік
Dialogue: 0,0:07:36.37,0:07:37.33,Default,,0,0,0,,Иә
Dialogue: 0,0:07:37.41,0:07:40.08,Default,,0,0,0,,Мырза, сіз өте шеберсіз.
Dialogue: 0,0:07:40.16,0:07:41.96,Default,,0,0,0,,Мен қалыпты ойнасам да жеңе алдым.
Dialogue: 0,0:07:42.04,0:07:44.21,Default,,0,0,0,,Мен шу шығарғым келмейді
Dialogue: 0,0:07:52.93,0:07:55.47,Default,,0,0,0,,Yoru Мүмкін сіз қорқасыз ба?
Dialogue: 0,0:07:56.05,0:07:59.10,Default,,0,0,0,,Бұл құрлықтың халқы қара мысықтарды менсінбейді.
Dialogue: 0,0:07:59.60,0:08:01.48,Default,,0,0,0,,Мұның себебі бар.
Dialogue: 0,0:08:01.56,0:08:04.23,Default,,0,0,0,,Көп нәрсе бар шығар.
Dialogue: 0,0:08:10.94,0:08:11.74,Default,,0,0,0,,Хааа~
Dialogue: 0,0:08:11.82,0:08:13.24,Default,,0,0,0,,Қарын тоқ
Dialogue: 0,0:08:13.32,0:08:15.87,Default,,0,0,0,,Осыншама жесең, ішің ісіп кетеді.
Dialogue: 0,0:08:16.37,0:08:18.37,Default,,0,0,0,,Ал, ұйықтайтын кез келді.
Dialogue: 0,0:08:19.54,0:08:21.33,Default,,0,0,0,,Бұл үлкен төсек.
Dialogue: 0,0:08:21.41,0:08:22.25,Default,,0,0,0,,О
Dialogue: 0,0:08:22.33,0:08:25.75,Default,,0,0,0,,Бұл үлкен, сондықтан біреуі жеткілікті, солай ма?
Dialogue: 0,0:08:25.83,0:08:26.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:27.42,0:08:29.63,Default,,0,0,0,,Жоқ, екеуі бар, сондықтан екеуін де қолдансаңыз...
Dialogue: 0,0:08:29.71,0:08:30.84,Default,,0,0,0,,Үлкен зал
Dialogue: 0,0:08:30.92,0:08:34.01,Default,,0,0,0,,Мен атмосфераны оқи аламын, сондықтан мен қазір шығамын.
Dialogue: 0,0:08:34.09,0:08:35.64,Default,,0,0,0,,Рахмет Йору
Dialogue: 0,0:08:35.72,0:08:37.14,Default,,0,0,0,,Құрмет жоқ
Dialogue: 0,0:08:37.22,0:08:38.76,Default,,0,0,0,,Керемет! Yoru
Dialogue: 0,0:08:38.85,0:08:39.85,Default,,0,0,0,,Эй!
Dialogue: 0,0:08:39.93,0:08:41.02,Default,,0,0,0,,Адамдармен кездесу
Dialogue: 0,0:08:41.10,0:08:44.39,Default,,0,0,0,,Иеміз қалағанын істе.
Dialogue: 0,0:08:44.48,0:08:47.77,Default,,0,0,0,,Қойылған тамақты жемесең, адам ескіреді... Солай болды ма?
Dialogue: 0,0:08:47.86,0:08:50.15,Default,,0,0,0,,Бұл сөзді қайдан үйрендің?
Dialogue: 0,0:08:50.23,0:08:51.90,Default,,0,0,0,,Мен душқа түсемін.
Dialogue: 0,0:08:52.40,0:08:53.15,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:09:02.16,0:09:03.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:08.21,0:09:09.75,Default,,0,0,0,,Жақсы ұйықтау
Dialogue: 0,0:09:10.25,0:09:11.80,Default,,0,0,0,,...
Dialogue: 0,0:09:16.30,0:09:18.43,Default,,0,0,0,,Қайырлы түн Акира
Dialogue: 0,0:09:22.89,0:09:25.60,Default,,0,0,0,,Бірден ұйықтап кетуге мүмкіндік жоқ!
Dialogue: 0,0:09:30.06,0:09:32.73,Default,,0,0,0,,Мырза, мен оралдым.
Dialogue: 0,0:09:33.23,0:09:33.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:34.32,0:09:36.99,Default,,0,0,0,,Сіз Жапонияда жақсы уақыт өткізген сияқтысыз.
Dialogue: 0,0:09:38.66,0:09:39.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:40.20,0:09:41.24,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:44.29,0:09:45.25,Default,,0,0,0,,Ммм... мм.
Dialogue: 0,0:09:47.04,0:09:48.62,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:09:48.71,0:09:50.50,Default,,0,0,0,,Дайын бол.
Dialogue: 0,0:09:51.00,0:09:52.30,Default,,0,0,0,,Жақында қонақ келеді.
Dialogue: 0,0:09:52.38,0:09:53.75,Default,,0,0,0,,-Мм? -(Акира) Тұтынушы?
Dialogue: 0,0:09:56.22,0:09:57.30,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:09:58.84,0:10:00.30,Default,,0,0,0,,Темірші Қарға
Dialogue: 0,0:10:00.39,0:10:02.43,Default,,0,0,0,,Мен мұны сұрадым.
Dialogue: 0,0:10:02.51,0:10:05.35,Default,,0,0,0,,Адреаның қорқынышты түсінің шақыруы қандай?
Dialogue: 0,0:10:05.43,0:10:06.93,Default,,0,0,0,,Келмеуге мүмкіндігім жоқ сияқты.
Dialogue: 0,0:10:07.02,0:10:09.23,Default,,0,0,0,,Адреаның қорқынышты түсі?
Dialogue: 0,0:10:10.40,0:10:13.32,Default,,0,0,0,,Бұл құрлыққа келуге кім түрткі болды?
Dialogue: 0,0:10:13.40,0:10:16.19,Default,,0,0,0,,Өйткені бұл жігіт әлемдегі ең жақсы ұста.
Dialogue: 0,0:10:16.28,0:10:17.95,Default,,0,0,0,,Бұл Акира Ода.
Dialogue: 0,0:10:18.03,0:10:19.24,Default,,0,0,0,,Бұл Амелия
Dialogue: 0,0:10:19.74,0:10:20.70,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:10:21.87,0:10:23.74,Default,,0,0,0,,Қаруыңды көрейін.
Dialogue: 0,0:10:26.16,0:10:29.79,Default,,0,0,0,,Ол Кантинен лабиринтінің айналасында шамадан тыс пайдаланылған болуы керек.
Dialogue: 0,0:10:29.87,0:10:32.50,Default,,0,0,0,,Ғажайып Түсінесің бе?
Dialogue: 0,0:10:32.59,0:10:33.54,Default,,0,0,0,,Оны түзетуге бола ма?
Dialogue: 0,0:10:34.21,0:10:35.88,Default,,0,0,0,,Материалдар мен ақшаға байланысты
Dialogue: 0,0:10:36.38,0:10:38.92,Default,,0,0,0,,Түсіндім, сұрыптаңыз.
Dialogue: 0,0:10:39.63,0:10:43.43,Default,,0,0,0,,Мен де 20-ға жуық қараңғы лақтыратын қаруды толықтырғым келеді.
Dialogue: 0,0:10:45.85,0:10:48.18,Default,,0,0,0,,Ассасин...?
Dialogue: 0,0:10:49.06,0:10:52.06,Default,,0,0,0,,Қолдары жақсы сияқты, бірақ ақыл-ойы жетілмеген сияқты.
Dialogue: 0,0:10:52.81,0:10:56.98,Default,,0,0,0,,Мен жаттықтырған қаруды жалықпай қолдана аламын ба...
Dialogue: 0,0:10:57.07,0:10:59.15,Default,,0,0,0,,Акира туралы не білесіңдер?
Dialogue: 0,0:10:59.24,0:11:00.32,Default,,0,0,0,,Өкінішті, бірақ…
Dialogue: 0,0:11:00.40,0:11:02.03,Default,,0,0,0,,Сіз орынсыз емессіз.
Dialogue: 0,0:11:02.11,0:11:02.70,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:11:02.78,0:11:06.66,Default,,0,0,0,,Амелия ханым Бұл жігіт шайқастар туралы көп біледі.
Dialogue: 0,0:11:06.74,0:11:08.41,Default,,0,0,0,,Қазір ұста болатын кез.
Dialogue: 0,0:11:08.50,0:11:11.33,Default,,0,0,0,,Бастапқыда алдыңғы батырдың партия мүшесі.
Dialogue: 0,0:11:11.42,0:11:12.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:16.59,0:11:20.59,Default,,0,0,0,,Қылыш жөндеуге және қара қаруды жасауға қажетті материалдар тізімі
Dialogue: 0,0:11:20.67,0:11:22.22,Default,,0,0,0,,Және бағалау.
Dialogue: 0,0:11:23.05,0:11:24.80,Default,,0,0,0,,Мен мұны сақтаймын.
Dialogue: 0,0:11:25.30,0:11:28.22,Default,,0,0,0,,Материалдар мен ақшаларыңыз болғанда маған хабарлаңыз.
Dialogue: 0,0:11:28.97,0:11:29.81,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:11:29.89,0:11:33.15,Default,,0,0,0,,Оның мінезі кемшін, бірақ шеберлігіне кепілдік берілген.
Dialogue: 0,0:11:33.65,0:11:36.86,Default,,0,0,0,,Иеміздің қаруын қолдана алатын жалғыз адам.
Dialogue: 0,0:11:37.73,0:11:40.03,Default,,0,0,0,,Мен сенің айтқаныңа сенемін.
Dialogue: 0,0:11:40.11,0:11:42.49,Default,,0,0,0,,Материалдар мен баға бойынша не істеуім керек?
Dialogue: 0,0:11:42.57,0:11:45.37,Default,,0,0,0,,Лабиринтте құбыжықтарды аулаңыз
Dialogue: 0,0:11:45.45,0:11:49.58,Default,,0,0,0,,Тізімдегі материалдарды сақтап, қалғандарын алтынға айырбастау.
Dialogue: 0,0:11:49.66,0:11:51.25,Default,,0,0,0,,Деңгей де көтеріледі, бұл дұрыс.
Dialogue: 0,0:11:51.83,0:11:54.63,Default,,0,0,0,,Қатал лабиринт осы қаланың ішінде.
Dialogue: 0,0:11:55.13,0:11:56.96,Default,,0,0,0,,Дегенмен, бұл авантюрист дәрежесі екеніне сенімдімін.
Dialogue: 0,0:11:57.04,0:12:00.42,Default,,0,0,0,,Лабиринтке кіруге шектеулер болуы керек еді.
Dialogue: 0,0:12:00.92,0:12:02.84,Default,,0,0,0,,Ал, мен бұл туралы бірдеңе істеймін.
Dialogue: 0,0:12:02.93,0:12:06.14,Default,,0,0,0,,Мм... мен біраз уақытқа шыға аламын ба?
Dialogue: 0,0:12:06.22,0:12:07.14,Default,,0,0,0,,Не?
Dialogue: 0,0:12:07.85,0:12:09.72,Default,,0,0,0,,Менің мистер Кроумен сөйлескім келетін нәрсе бар.
Dialogue: 0,0:12:10.64,0:12:11.60,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:12:11.68,0:12:13.14,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:12:13.94,0:12:16.31,Default,,0,0,0,,Амелияға еріңіз.
Dialogue: 0,0:12:16.81,0:12:17.98,Default,,0,0,0,,Иеміз не істеуі керек?
Dialogue: 0,0:12:18.65,0:12:21.40,Default,,0,0,0,,Кішкене зерттегеннен кейін лабиринтке барыңыз.
Dialogue: 0,0:12:21.49,0:12:23.11,Default,,0,0,0,,Егер бірдеңе болса, маған хабарлаңыз
Dialogue: 0,0:12:23.20,0:12:24.78,Default,,0,0,0,,Түсінікті.
Dialogue: 0,0:12:28.62,0:12:32.08,Default,,0,0,0,,Сөйлескіңіз келмей ме? Сіз де
Dialogue: 0,0:12:39.59,0:12:41.38,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:12:41.46,0:12:44.88,Default,,0,0,0,,Алдыңғы батырлар тобы Жын патшасын бағындыра алмады.
Dialogue: 0,0:12:44.97,0:12:46.89,Default,,0,0,0,,Тек батыр мен хайуан ғана оралды
Dialogue: 0,0:12:46.97,0:12:47.93,Default,,0,0,0,,О
Dialogue: 0,0:12:48.01,0:12:50.56,Default,,0,0,0,,Кеште пері болды, бірақ ол қайтыс болды.
Dialogue: 0,0:12:50.64,0:12:54.10,Default,,0,0,0,,Менің халқымнан бас тарттым деп сынағың келсе, солай ете аласың.
Dialogue: 0,0:12:54.19,0:12:55.31,Default,,0,0,0,,Жоқ
Dialogue: 0,0:12:55.39,0:12:59.11,Default,,0,0,0,,Батыр екеуің ғана аман қалуыңа сенің мықты болғаның себеп болды.
Dialogue: 0,0:13:00.69,0:13:01.94,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:13:02.03,0:13:05.45,Default,,0,0,0,,Маған күресуді үйретсеңші.
Dialogue: 0,0:13:05.53,0:13:07.03,Default,,0,0,0,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:13:08.12,0:13:10.74,Default,,0,0,0,,Мен ешқандай шәкірт алмаймын.
Dialogue: 0,0:13:11.37,0:13:13.33,Default,,0,0,0,,Сіздің шәкіртіңіз болды ма?
Dialogue: 0,0:13:14.37,0:13:20.13,Default,,0,0,0,,Ешкім затқа айналды, не қашты, не жойылды.
Dialogue: 0,0:13:21.92,0:13:23.80,Default,,0,0,0,,Мен қашпаймын, сынбаймын
Dialogue: 0,0:13:24.30,0:13:26.80,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:13:27.38,0:13:28.55,Default,,0,0,0,,Мен Акирамен бірге болғым келеді
Dialogue: 0,0:13:29.30,0:13:32.47,Default,,0,0,0,,Бірақ қуатта тым көп айырмашылық бар.
Dialogue: 0,0:13:33.14,0:13:34.68,Default,,0,0,0,,Біз бұлай жалғастыра алмаймыз.
Dialogue: 0,0:13:34.77,0:13:36.98,Default,,0,0,0,,Мен күштірек болуым керек
Dialogue: 0,0:13:39.56,0:13:41.73,Default,,0,0,0,,Адреаның қорқынышты түсі
Dialogue: 0,0:13:41.82,0:13:46.11,Default,,0,0,0,,Мен сіз тек қаруды жөндеу және өндіру туралы өтініштерді қабылдайсыз деп ойладым.
Dialogue: 0,0:13:46.20,0:13:51.24,Default,,0,0,0,,Бұл менің түсінігім, бірақ Мисс Амелия менің қожайыным емес.
Dialogue: 0,0:13:51.83,0:13:53.99,Default,,0,0,0,,Ал мені олай атама.
Dialogue: 0,0:13:54.70,0:13:55.50,Default,,0,0,0,,Фу…
Dialogue: 0,0:13:55.58,0:14:00.96,Default,,0,0,0,,Сіз осы құрлықтағы барлық аңдарды дүр сілкіндірген қорқыныш символысыз.
Dialogue: 0,0:14:01.04,0:14:02.75,Default,,0,0,0,,Адреаның қорқынышты түсі
Dialogue: 0,0:14:02.84,0:14:05.63,Default,,0,0,0,,Басқа ештеңе жоқ
Dialogue: 0,0:14:06.59,0:14:09.59,Default,,0,0,0,,Йорудың бұрынғы аты Қара мысық болатын
Dialogue: 0,0:14:09.68,0:14:11.51,Default,,0,0,0,,Адреаның қорқынышты түсі қандай?
Dialogue: 0,0:14:13.56,0:14:15.81,Default,,0,0,0,,Шамамен 100 жыл бұрын
Dialogue: 0,0:14:16.39,0:14:19.98,Default,,0,0,0,,Ол кезде осы құрлықтағы ең гүлденген қала болды
Dialogue: 0,0:14:20.06,0:14:22.27,Default,,0,0,0,,Бұл Адреа деген қала болды.
Dialogue: 0,0:14:23.52,0:14:25.94,Default,,0,0,0,,Жын патшасының бұйрығын қабылдаймын.
Dialogue: 0,0:14:26.03,0:14:29.15,Default,,0,0,0,,Оған қалаға соққы беру тапсырылды.
Dialogue: 0,0:14:30.99,0:14:34.62,Default,,0,0,0,,Жындар аумағына басып кіргені үшін кек алу
Dialogue: 0,0:14:35.87,0:14:39.29,Default,,0,0,0,,Сізге тек билік басындағыларды еске түсіру керек.
Dialogue: 0,0:14:42.29,0:14:44.21,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:14:53.43,0:14:54.60,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:14:56.68,0:15:02.31,Default,,0,0,0,,Бірақ сол сәтте ішімдегі жын-шайтандық инстинкт мені жеп қойды.
Dialogue: 0,0:15:19.41,0:15:22.42,Default,,0,0,0,,Жою кезінде мас. Адам өлтіру кезінде мас
Dialogue: 0,0:15:23.00,0:15:24.46,Default,,0,0,0,,Өзімді жоғалттым
Dialogue: 0,0:15:26.25,0:15:29.09,Default,,0,0,0,,Бұлай алысқа барудың қажеті жоқ еді.
Dialogue: 0,0:15:29.80,0:15:31.80,Default,,0,0,0,,Сол күннен бастап аңдар
Dialogue: 0,0:15:31.88,0:15:34.72,Default,,0,0,0,,Олар мені «Адреаның түнгі түні» деп атай бастады.
Dialogue: 0,0:15:35.60,0:15:38.39,Default,,0,0,0,,Қара мысықтар қорқады
Dialogue: 0,0:15:40.02,0:15:43.15,Default,,0,0,0,,Менің жүрегімдегі дауыстар байланыста қалады.
Dialogue: 0,0:15:45.48,0:15:48.19,Default,,0,0,0,,Мен де солай болар деп ойладым.
Dialogue: 0,0:15:48.69,0:15:50.57,Default,,0,0,0,,Сізден сұрағанымды қалайсыз ба...
Dialogue: 0,0:15:51.82,0:15:55.07,Default,,0,0,0,,Бұдан әрі өмір сүрудің мәні жоқ.
Dialogue: 0,0:15:55.66,0:15:59.37,Default,,0,0,0,,Менің бұлай ойлаған себебім осы оқиға болуы мүмкін.
Dialogue: 0,0:16:00.00,0:16:01.79,Default,,0,0,0,,Бірақ қазір емес
Dialogue: 0,0:16:02.29,0:16:06.88,Default,,0,0,0,,Егер мен сол Жаратқанға қызмет еткенімде, дәл осындай жағдай болмас еді деп ойлаймын.
Dialogue: 0,0:16:06.96,0:16:09.63,Default,,0,0,0,,Сіз қайта туылдым деп айтқыңыз келе ме?
Dialogue: 0,0:16:09.71,0:16:11.63,Default,,0,0,0,,Жәндіктер туралы жақсы әңгіме.
Dialogue: 0,0:16:11.72,0:16:13.26,Default,,0,0,0,,Жауап алынды.
Dialogue: 0,0:16:13.84,0:16:15.76,Default,,0,0,0,,Бірақ менің атым «түн»
Dialogue: 0,0:16:16.39,0:16:18.76,Default,,0,0,0,,Мен Ода Акираның қызметшісі болғаннан бері.
Dialogue: 0,0:16:18.85,0:16:21.52,Default,,0,0,0,,Мен енді өлтіруге шамасы жоқ.
Dialogue: 0,0:16:21.60,0:16:24.81,Default,,0,0,0,,Мен сені әу бастан жек көрген емеспін.
Dialogue: 0,0:16:25.60,0:16:29.02,Default,,0,0,0,,Бұл оқиғада тағы да көп нәрсе бар
Dialogue: 0,0:16:33.57,0:16:36.16,Default,,0,0,0,,Сіз әлі де зорлық-зомбылық көрсете алмайсыз ба?
Dialogue: 0,0:16:36.24,0:16:40.54,Default,,0,0,0,,Сол кезде батырмен бірге қашып кеткен аңшы сен едің.
Dialogue: 0,0:16:41.66,0:16:43.66,Default,,0,0,0,,Сіз туысқаныңыздан айырылдыңыз ба?
Dialogue: 0,0:16:43.75,0:16:45.92,Default,,0,0,0,,Мені өлтіргің келсе, істе.
Dialogue: 0,0:16:46.00,0:16:48.46,Default,,0,0,0,,Сіз шайтанның құралынан басқа ештеңесіз
Dialogue: 0,0:16:49.13,0:16:51.63,Default,,0,0,0,,Қылыш пен найзаны жек көрудің мәні неде?
Dialogue: 0,0:16:52.13,0:16:54.30,Default,,0,0,0,,Олай болса, жын патшасын көздеп аламыз ба?
Dialogue: 0,0:16:56.59,0:17:01.14,Default,,0,0,0,,Менің әпкемді алып кеткен сен де, жын патша да емессің.
Dialogue: 0,0:17:02.39,0:17:04.39,Default,,0,0,0,,Сіз осы жерден кеткеннен кейін
Dialogue: 0,0:17:04.48,0:17:08.31,Default,,0,0,0,,Әпкем тірідей көмілген адамдарды құтқармақ болды.
Dialogue: 0,0:17:09.90,0:17:12.28,Default,,0,0,0,,Ер адам асықты
Dialogue: 0,0:17:12.36,0:17:15.57,Default,,0,0,0,,Артқа бұрылып кете ме деп қорықтыңыз ба?
Dialogue: 0,0:17:16.74,0:17:18.24,Default,,0,0,0,,(Night Eye) Мен ойлағандай, «үшін Бір» шын мәнінде Миллиоға берілуі керек еді.
Dialogue: 0,0:17:19.37,0:17:21.29,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:17:27.62,0:17:29.54,Default,,0,0,0,,Бұл өзімнің аяныштылығымнан.
Dialogue: 0,0:17:30.25,0:17:34.17,Default,,0,0,0,,Өз халқының өмірін сабырмен таптады.
Dialogue: 0,0:17:37.01,0:17:39.22,Default,,0,0,0,,Әпкемнің жауы...
Dialogue: 0,0:17:39.93,0:17:41.93,Default,,0,0,0,,Кімнен кек алуым керек?
Dialogue: 0,0:17:42.60,0:17:45.43,Default,,0,0,0,,Роялти Грам кластері!
Dialogue: 0,0:17:47.35,0:17:49.69,Default,,0,0,0,,Сонда сен кек алдың ба?
Dialogue: 0,0:17:49.77,0:17:50.94,Default,,0,0,0,,Жоқ
Dialogue: 0,0:17:51.02,0:17:51.82,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:17:51.90,0:17:55.65,Default,,0,0,0,,Менің мейірімді апам кек алғысы келмейді.
Dialogue: 0,0:17:55.74,0:17:57.70,Default,,0,0,0,,Мен солай ойлай бастадым.
Dialogue: 0,0:17:58.95,0:18:00.07,Default,,0,0,0,,Нашар...
Dialogue: 0,0:18:00.16,0:18:04.33,Default,,0,0,0,,Егер аянышты сезінсеңіз, тоқтатыңыз. Бұл 100 жыл бұрын болды.
Dialogue: 0,0:18:04.91,0:18:08.00,Default,,0,0,0,,Жоқ, бұл кедей менің әпкем.
Dialogue: 0,0:18:08.67,0:18:10.83,Default,,0,0,0,,Апаңның кесірінен қашып жүрсің.
Dialogue: 0,0:18:11.63,0:18:13.21,Default,,0,0,0,,Келісім жасасамыз ба?
Dialogue: 0,0:18:14.05,0:18:16.34,Default,,0,0,0,,Әпкеңнің сезімін өзіңдікі қыл
Dialogue: 0,0:18:16.42,0:18:18.01,Default,,0,0,0,,Өзіңізге қамқорлық жасаңыз
Dialogue: 0,0:18:18.09,0:18:21.35,Default,,0,0,0,,Мен бұл дүниеден шынайы сезімімнен қашамын.
Dialogue: 0,0:18:21.43,0:18:23.43,Default,,0,0,0,,Не білесің!
Dialogue: 0,0:18:24.31,0:18:25.35,Default,,0,0,0,,Мен де солай болдым.
Dialogue: 0,0:18:26.35,0:18:30.31,Default,,0,0,0,,Мен әпкемнің қамын ойлап, өз сезімімнен қаштым.
Dialogue: 0,0:18:31.02,0:18:34.27,Default,,0,0,0,,Бірақ Акира маған бұл дұрыс емес деді.
Dialogue: 0,0:18:38.74,0:18:40.16,Default,,0,0,0,,Бүгін үйге қайтыңыз.
Dialogue: 0,0:18:47.33,0:18:48.71,Default,,0,0,0,,Лабиринтке кіру
Dialogue: 0,0:18:48.79,0:18:52.25,Default,,0,0,0,,Сіз авантюрист дәрежесімен шектелгенін айттыңыз...
Dialogue: 0,0:18:52.75,0:18:55.50,Default,,0,0,0,,Бұл қиын, сондықтан мен бар екенімді жасырамын.
Dialogue: 0,0:18:55.59,0:18:56.92,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:18:59.63,0:19:00.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:07.39,0:19:09.23,Default,,0,0,0,,(құбыжықтың дауысы)
Dialogue: 0,0:19:16.69,0:19:17.44,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:21.03,0:19:22.70,Default,,0,0,0,,Йору, маған көмектес!
Dialogue: 0,0:19:22.78,0:19:24.07,Default,,0,0,0,,Түсінікті!
Dialogue: 0,0:19:28.29,0:19:30.46,Default,,0,0,0,,Біз оны тоқтатамыз, сондықтан қауіпсіз жерде болыңыз!
Dialogue: 0,0:19:30.54,0:19:32.08,Default,,0,0,0,,Қазір оралу
Dialogue: 0,0:19:34.13,0:19:37.50,Default,,0,0,0,,О, сол сиқыр есімде.
Dialogue: 0,0:19:40.42,0:19:43.34,Default,,0,0,0,,Қайырлы күн пері ханшайымы
Dialogue: 0,0:19:43.43,0:19:44.97,Default,,0,0,0,,Өлімдік күнәлардың кардиналына тән нәрсе деп айтуға болатын шығар.
Dialogue: 0,0:19:45.05,0:19:45.72,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:49.06,0:19:50.39,Default,,0,0,0,,Сол бір кездей…
Dialogue: 0,0:19:50.48,0:19:52.85,Default,,0,0,0,,Сіз әлі сәлем берген жоқсыз.
Dialogue: 0,0:19:54.23,0:19:55.65,Default,,0,0,0,,Мен Аураммын
Dialogue: 0,0:19:56.15,0:19:57.40,Default,,0,0,0,,...
Dialogue: 0,0:19:58.19,0:20:01.74,Default,,0,0,0,,Жын патшасы сені өлтірмеуімді айтты.
Dialogue: 0,0:20:01.82,0:20:03.99,Default,,0,0,0,,Сізде сирек кездесетін сиқыр бар, солай ма?
Dialogue: 0,0:20:04.49,0:20:08.45,Default,,0,0,0,,（）
Dialogue: 0,0:20:13.58,0:20:16.79,Default,,0,0,0,,Мен сені әзірше бейтараптандырамын.
Dialogue: 0,0:20:25.84,0:20:26.89,Default,,0,0,0,,Үлкен зал
Dialogue: 0,0:20:26.97,0:20:28.51,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:20:28.60,0:20:31.06,Default,,0,0,0,,Кешіріңіз, Мисс Амелияны ұрлап кетті.
Dialogue: 0,0:20:31.14,0:20:31.98,Default,,0,0,0,,Не?
Dialogue: 0,0:20:33.60,0:20:35.69,Default,,0,0,0,,Осы дүрбелеңді тудыратын жын
Dialogue: 0,0:20:35.77,0:20:37.69,Default,,0,0,0,,Оны лабиринтке алып кеткен сияқты.
Dialogue: 0,0:20:37.77,0:20:39.36,Default,,0,0,0,,Мен де қазір келе жатырмын.
Dialogue: 0,0:20:41.24,0:20:42.49,Default,,0,0,0,,Амелия…
Dialogue: 0,0:20:57.13,0:20:57.79,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,0:21:07.43,0:21:10.01,Default,,0,0,0,,Артыңнан келе жатсам да, ұят
Dialogue: 0,0:21:10.10,0:21:12.27,Default,,0,0,0,,Бұл жігіттер одан да көп мазасыз.
Dialogue: 0,0:21:12.35,0:21:14.27,Default,,0,0,0,,Йору, аулақ жүр.
Dialogue: 0,0:21:14.35,0:21:15.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:22.69,0:21:24.03,Default,,0,0,0,,Көлеңкелік сиқырды белсендіру
Dialogue: 0,0:21:24.11,0:21:25.40,Default,,0,0,0,,Көлеңкелі тозақ!
Dialogue: 0,0:21:33.79,0:21:37.42,Default,,0,0,0,,Ууу!
Dialogue: 0,0:21:37.50,0:21:40.75,Default,,0,0,0,,Мұндай қарқынды эмоциялардың пайда болуына не себеп болады?
Dialogue: 0,0:21:40.84,0:21:43.01,Default,,0,0,0,,Бұл бірінші рет болды
Dialogue: 0,0:21:43.71,0:21:46.43,Default,,0,0,0,,Егер мен өз өмірімді бастапқы әлемімде аяқтасам ше?
Dialogue: 0,0:21:46.51,0:21:49.26,Default,,0,0,0,,Мен ешқашан бастан өткермеген мақтаныш
Dialogue: 0,0:21:49.76,0:21:53.43,Default,,0,0,0,,Бір қызығы, ол маған бірдеңе үйретті.
Dialogue: 0,0:21:54.39,0:21:55.18,Default,,0,0,0,,Білмес бұрын
Dialogue: 0,0:21:55.98,0:21:59.86,Default,,0,0,0,,Менің отбасымнан басқа маңызды нәрсе бар екенін түсіндім.
Dialogue: 0,0:22:02.48,0:22:03.11,Default,,0,0,0,,Амелия…
Dialogue: 0,0:22:11.32,0:22:13.33,Default,,0,0,0,,♪～
Dialogue: 0,0:23:38.95,0:23:40.96,Default,,0,0,0,,～♪
