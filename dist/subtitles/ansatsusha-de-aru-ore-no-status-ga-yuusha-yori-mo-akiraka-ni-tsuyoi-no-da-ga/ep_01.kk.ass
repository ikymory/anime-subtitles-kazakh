Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.50,0:00:03.67,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:00:16.14,0:00:17.18,Default,,0,0,0,,Сіз құрдассыз ба?
Dialogue: 0,0:00:17.26,0:00:17.80,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:19.06,0:00:21.43,Default,,0,0,0,,Қараңғы өлтіруші (үнсіз өлтіруші)?
Dialogue: 0,0:00:21.52,0:00:22.31,Default,,0,0,0,,Хаа…
Dialogue: 0,0:00:22.89,0:00:26.44,Default,,0,0,0,,Мен сендей үлкен адамнан өтініш аламын дегенге сенбеймін.
Dialogue: 0,0:00:26.52,0:00:27.40,Default,,0,0,0,,Алайда...
Dialogue: 0,0:00:27.86,0:00:30.53,Default,,0,0,0,,Біз мақсатта ымыраға келе алмаймыз.
Dialogue: 0,0:00:31.53,0:00:33.90,Default,,0,0,0,,Сіз де, мен де өлтірушіміз
Dialogue: 0,0:00:33.99,0:00:35.95,Default,,0,0,0,,Екеуміз де солай істейміз!
Dialogue: 0,0:00:48.13,0:00:48.75,Default,,0,0,0,,Әй!
Dialogue: 0,0:01:03.14,0:01:03.68,Default,,0,0,0,,Толық кауль!
Dialogue: 0,0:01:06.06,0:01:06.73,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:01:19.95,0:01:20.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:21.58,0:01:23.50,Default,,0,0,0,,Арх! Уф...
Dialogue: 0,0:01:25.58,0:01:27.50,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:01:28.21,0:01:30.50,Default,,0,0,0,,Бұл көп уақытты алды, бірақ...
Dialogue: 0,0:01:31.59,0:01:35.30,Default,,0,0,0,,Бұл өлшемге қатысты емес еді.
Dialogue: 0,0:01:38.68,0:01:41.85,Default,,0,0,0,,Мүлдем емес... твиттер жазбаңыз.
Dialogue: 0,0:01:42.43,0:01:44.31,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:02:01.95,0:02:03.91,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:02:06.62,0:02:07.87,Default,,0,0,0,,Эй, Цукаса-кун
Dialogue: 0,0:02:07.96,0:02:11.29,Default,,0,0,0,,Сабақтан кейін біз бірге дүкен аралап, шай ішеміз. Менімен барғың келе ме?
Dialogue: 0,0:02:11.38,0:02:13.80,Default,,0,0,0,,Кешіріңіз, мен клуб қызметінің бюджетін шешуім керек.
Dialogue: 0,0:02:13.88,0:02:16.21,Default,,0,0,0,,Студенттік кеңес төрағасы бос емес пе?
Dialogue: 0,0:02:16.30,0:02:18.17,Default,,0,0,0,,Хмм, бұл өте жаман.
Dialogue: 0,0:02:18.26,0:02:19.34,Default,,0,0,0,,Мені қайта шақырыңыз
Dialogue: 0,0:02:19.43,0:02:21.80,Default,,0,0,0,,Әрқашан жаман Хосояма
Dialogue: 0,0:02:21.89,0:02:24.01,Default,,0,0,0,,Сен маған шынымен қарайсың, Шиори.
Dialogue: 0,0:02:24.10,0:02:26.56,Default,,0,0,0,,Сізді жалғыз қалдыру өте жиіркенішті.
Dialogue: 0,0:02:26.64,0:02:28.14,Default,,0,0,0,,Юки, не болды?
Dialogue: 0,0:02:28.23,0:02:28.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:29.06,0:02:31.81,Default,,0,0,0,,Ағылшын тілі мұғалімі Цуджимураның тым егжей-тегжейлі бұлдырлығы
Dialogue: 0,0:02:31.90,0:02:34.02,Default,,0,0,0,,Бұл күлкілі, түсіну қиын емес деп ойлайсыз ба?
Dialogue: 0,0:02:34.11,0:02:35.94,Default,,0,0,0,,Сіз осылай ойладыңыз ба?
Dialogue: 0,0:02:36.61,0:02:38.65,Default,,0,0,0,,Асахина-кун, түскі жаттығуға барасың ба?
Dialogue: 0,0:02:38.74,0:02:39.53,Default,,0,0,0,,О
Dialogue: 0,0:02:39.61,0:02:41.95,Default,,0,0,0,,Жаңа бамбук қылышына үйрену
Dialogue: 0,0:02:48.25,0:02:49.83,Default,,0,0,0,,О, мен де соны оқып жатырмын.
Dialogue: 0,0:02:49.91,0:02:51.75,Default,,0,0,0,,Сізге басқа дүниелер ұнайды ма?
Dialogue: 0,0:02:51.83,0:02:54.59,Default,,0,0,0,,Мен тегін оқи алатын барлық нәрсені оқып жатырмын.
Dialogue: 0,0:02:54.67,0:02:57.34,Default,,0,0,0,,Эй, келесі жолы маған ұсынысыңды айт.
Dialogue: 0,0:02:57.96,0:02:59.17,Default,,0,0,0,,Тегін заттар
Dialogue: 0,0:02:59.92,0:03:02.09,Default,,0,0,0,,Нанасе-кунмен дәл қазір кім сөйлесті?
Dialogue: 0,0:03:02.18,0:03:03.68,Default,,0,0,0,,Акира Ода
Dialogue: 0,0:03:03.76,0:03:05.97,Default,,0,0,0,,Иә? Ондай нәрсе болды ма? Басынан бастап?
Dialogue: 0,0:03:06.51,0:03:08.81,Default,,0,0,0,,Ол әрқашан аты-жөні төмен жігіт болатын.
Dialogue: 0,0:03:10.14,0:03:13.06,Default,,0,0,0,,Менің көлеңкем ақшыл екенін білемін.
Dialogue: 0,0:03:13.15,0:03:15.65,Default,,0,0,0,,Мектепте менімен осылай сөйлесті
Dialogue: 0,0:03:15.73,0:03:18.11,Default,,0,0,0,,Бұл аздап аномалия сияқты көрінді.
Dialogue: 0,0:03:18.78,0:03:22.78,Default,,0,0,0,,Бірақ бұл әсер көп ұзамай жойылады.
Dialogue: 0,0:03:23.28,0:03:27.49,Default,,0,0,0,,Бірден кейін орын алған нағыз қалыптан тыс жағдайға байланысты
Dialogue: 0,0:03:28.58,0:03:29.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:29.62,0:03:32.25,Default,,0,0,0,,(сықырлаған дыбыс сияқты)
Dialogue: 0,0:03:36.63,0:03:37.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:40.84,0:03:42.72,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:59.73,0:04:01.24,Default,,0,0,0,,Не? Терроризм ме?
Dialogue: 0,0:04:01.32,0:04:02.28,Default,,0,0,0,,Ол қайда?мұнда
Dialogue: 0,0:04:02.36,0:04:04.32,Default,,0,0,0,,Мен тірі болғаныма қуаныштымын~
Dialogue: 0,0:04:04.41,0:04:05.11,Default,,0,0,0,,Мен де, әпкем де осы жерде күтеміз.
Dialogue: 0,0:04:05.74,0:04:08.62,Default,,0,0,0,,Мәртебелі патша маған хабар бергеннен бері,
Dialogue: 0,0:04:08.70,0:04:11.79,Default,,0,0,0,,Назарларыңызға рахмет.
Dialogue: 0,0:04:14.71,0:04:15.92,Default,,0,0,0,,Бұл косплей ме?
Dialogue: 0,0:04:16.00,0:04:17.92,Default,,0,0,0,,Сен бізге не істедің?
Dialogue: 0,0:04:18.00,0:04:18.75,Default,,0,0,0,,(таяқтың жерге тиген дыбысы)
Dialogue: 0,0:04:18.84,0:04:20.88,Default,,0,0,0,,Өтінемін, тыныш болыңыз!
Dialogue: 0,0:04:21.38,0:04:24.84,Default,,0,0,0,,Алыс дүниеден шақыруға жауап бергендер.
Dialogue: 0,0:04:25.34,0:04:27.35,Default,,0,0,0,,Бұл дүниенің аты – Морриган
Dialogue: 0,0:04:27.43,0:04:31.60,Default,,0,0,0,,Ал бұл Лейтис, адамзат континентіндегі ең үлкен мемлекет.
Dialogue: 0,0:04:31.68,0:04:32.89,Default,,0,0,0,,Адам нәсілі?
Dialogue: 0,0:04:32.98,0:04:36.90,Default,,0,0,0,,Бізге қазір жын басып кіру қаупі төніп тұр.
Dialogue: 0,0:04:37.44,0:04:41.99,Default,,0,0,0,,Алайда, жын патшаны басқа әлемнің батыры ғана жеңе алады.
Dialogue: 0,0:04:42.07,0:04:44.32,Default,,0,0,0,,Эй, эй, бұл...
Dialogue: 0,0:04:44.90,0:04:47.12,Default,,0,0,0,,Әлемдік үлгінің тағы бір дамуы!
Dialogue: 0,0:04:48.12,0:04:48.91,Default,,0,0,0,,Хехе
Dialogue: 0,0:04:49.91,0:04:54.54,Default,,0,0,0,,Енді батырдың кім екенін түсіндірейін.
Dialogue: 0,0:04:54.62,0:04:55.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:55.62,0:04:58.21,Default,,0,0,0,,Бір ғана батыр бар
Dialogue: 0,0:04:58.29,0:05:00.75,Default,,0,0,0,,Алдымен осы жерді түртіңіз.
Dialogue: 0,0:05:00.84,0:05:02.13,Default,,0,0,0,,Иә, иә! Мен жасаймын!
Dialogue: 0,0:05:04.84,0:05:07.84,Default,,0,0,0,,Ойыңызда «Мәртебе» десеңіз
Dialogue: 0,0:05:07.93,0:05:10.01,Default,,0,0,0,,Өз кәсібіңізді табыңыз
Dialogue: 0,0:05:12.27,0:05:13.93,Default,,0,0,0,,Иә? Бұл жапон
Dialogue: 0,0:05:14.02,0:05:16.89,Default,,0,0,0,,Ол батыр емес пе?
Dialogue: 0,0:05:16.98,0:05:18.69,Default,,0,0,0,,Бастапқы күйге қойыңыз
Dialogue: 0,0:05:18.77,0:05:22.23,Default,,0,0,0,,Бұл әлемдегі орташа адамнан әлдеқайда көп.
Dialogue: 0,0:05:22.32,0:05:26.78,Default,,0,0,0,,Батырмен бірге батыр болатыныңа сенімдімін.
Dialogue: 0,0:05:26.86,0:05:27.82,Default,,0,0,0,,Хехе
Dialogue: 0,0:05:31.49,0:05:33.33,Default,,0,0,0,,Диспеллер?
Dialogue: 0,0:05:41.63,0:05:42.92,Default,,0,0,0,,Хехе
Dialogue: 0,0:05:43.42,0:05:45.30,Default,,0,0,0,,Түсіндім! Келесі мен, мен!
Dialogue: 0,0:05:45.38,0:05:48.09,Default,,0,0,0,,Кристалға қол тигізбей, «Мәртебе» деп айтыңыз
Dialogue: 0,0:05:48.18,0:05:51.22,Default,,0,0,0,,Сіз тек өзіңізді алдын ала тексере аласыз.
Dialogue: 0,0:05:51.30,0:05:52.89,Default,,0,0,0,,Күй
Dialogue: 0,0:05:54.18,0:05:56.06,Default,,0,0,0,,Мен жел сиқыршысымын.
Dialogue: 0,0:05:56.14,0:05:57.23,Default,,0,0,0,,Ал сіз ше?
Dialogue: 0,0:05:57.31,0:05:58.44,Default,,0,0,0,,Ассасин
Dialogue: 0,0:05:58.52,0:06:00.94,Default,,0,0,0,,О! Кескін үшін тамаша
Dialogue: 0,0:06:01.02,0:06:04.98,Default,,0,0,0,,Шынымды айтсам, сенің менің сыныбымда екеніңді түсінбедім.
Dialogue: 0,0:06:05.07,0:06:06.94,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:06:07.70,0:06:09.70,Default,,0,0,0,,Айырмашылығы неде?
Dialogue: 0,0:06:15.58,0:06:16.29,Default,,0,0,0,,О!
Dialogue: 0,0:06:16.37,0:06:18.33,Default,,0,0,0,,Батырдан күткендей
Dialogue: 0,0:06:18.41,0:06:23.21,Default,,0,0,0,,Әдетте, деңгей шегіне жетсеңіз де, шабуыл күші 500 шегінде болады.
Dialogue: 0,0:06:23.29,0:06:25.88,Default,,0,0,0,,Бұл сомадан екі есе дерлік.
Dialogue: 0,0:06:25.96,0:06:27.97,Default,,0,0,0,,Күтілгендей.
Dialogue: 0,0:06:28.05,0:06:32.72,Default,,0,0,0,,Спортқа жақсы, жақсы бағаға ие және студенттер кеңесінің төрағасы ретінде танымал.
Dialogue: 0,0:06:32.80,0:06:34.93,Default,,0,0,0,,Батырдағы сол сан?
Dialogue: 0,0:06:35.01,0:06:38.35,Default,,0,0,0,,Күтілгендей, тек менің статусым ерекше жоғары.
Dialogue: 0,0:06:38.94,0:06:40.06,Default,,0,0,0,,Келесіде барасыз ба?
Dialogue: 0,0:06:40.94,0:06:43.11,Default,,0,0,0,,Көп нәрсе қалмады.
Dialogue: 0,0:06:43.69,0:06:44.86,Default,,0,0,0,,Жарайды, біраз уақыт патша болып, өз жерімді қайтарып алайын!
Dialogue: 0,0:06:44.94,0:06:48.32,Default,,0,0,0,,Біріншіден, Жын патшасы туралы әңгіме рас па?
Dialogue: 0,0:06:48.40,0:06:49.86,Default,,0,0,0,,Құйрықты да ала алмайтын жағдайда
Dialogue: 0,0:06:49.95,0:06:53.24,Default,,0,0,0,,Адамдар бұл қалыптан тыс күй туралы білсе, жаман болмай ма?
Dialogue: 0,0:06:54.87,0:06:56.95,Default,,0,0,0,,Мен жаман қимыл жасай алмаймын деп ойлаймын
Dialogue: 0,0:06:58.29,0:06:59.79,Default,,0,0,0,,Мен бұған бәс тігуім керек пе...
Dialogue: 0,0:07:00.83,0:07:02.17,Default,,0,0,0,,Бар болуды жасыру
Dialogue: 0,0:07:04.34,0:07:05.96,Default,,0,0,0,,Уақыт келді...
Dialogue: 0,0:07:06.05,0:07:07.30,Default,,0,0,0,,Сіз өте әдемісіз. Хмм…
Dialogue: 0,0:07:07.38,0:07:09.26,Default,,0,0,0,,Қанша уақыт бұрын?
Dialogue: 0,0:07:11.97,0:07:16.93,Default,,0,0,0,,Енді біз сіздің кәсібіңізді растадық, біз сізге сәйкес жабдыққа тапсырыс бере аламыз.
Dialogue: 0,0:07:17.56,0:07:20.43,Default,,0,0,0,,Бүгін түнде өз бөлмеңде ұйықта.
Dialogue: 0,0:07:22.52,0:07:24.94,Default,,0,0,0,,Әйтеуір мен оны жеңіп шықтым.
Dialogue: 0,0:07:33.95,0:07:34.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:40.08,0:07:41.62,Default,,0,0,0,,Сізді бақылап жатыр ма?
Dialogue: 0,0:07:42.46,0:07:45.46,Default,,0,0,0,,Олар бірдеңені жасырып жатыр.
Dialogue: 0,0:07:51.38,0:07:52.13,Default,,0,0,0,,Иә
Dialogue: 0,0:07:57.35,0:08:02.06,Default,,0,0,0,,Оның тазаланбағандығы адамдар келеді деп уайымдаудың қажеті жоқ дегенді білдіреді.
Dialogue: 0,0:08:02.60,0:08:03.77,Default,,0,0,0,,Қазір...
Dialogue: 0,0:08:04.85,0:08:07.69,Default,,0,0,0,,Мамандығы, Менің ойымша, бұл осындай нәрсе
Dialogue: 0,0:08:08.69,0:08:11.74,Default,,0,0,0,,Тек ақпарат жинау ғана қалды.
Dialogue: 0,0:08:15.20,0:08:16.70,Default,,0,0,0,,Бұл көрініс...
Dialogue: 0,0:08:17.95,0:08:21.00,Default,,0,0,0,,Бұл, әрине, басқа әлем?
Dialogue: 0,0:08:28.67,0:08:31.13,Default,,0,0,0,,Бұл керемет физикалық қабілет.
Dialogue: 0,0:08:31.21,0:08:34.63,Default,,0,0,0,,Мен романда көрген шақыру бонусы қандай?
Dialogue: 0,0:08:35.13,0:08:35.68,Default,,0,0,0,,Ах
Dialogue: 0,0:08:36.18,0:08:37.43,Default,,0,0,0,,Бар болуды жасыру
Dialogue: 0,0:08:39.35,0:08:41.43,Default,,0,0,0,,Балалар қалай?
Dialogue: 0,0:08:41.52,0:08:44.73,Default,,0,0,0,,Өйткені ол сиқырсыз дүниенің баласы.
Dialogue: 0,0:08:44.81,0:08:46.40,Default,,0,0,0,,Бұл түкке тұрғысыз.
Dialogue: 0,0:08:46.48,0:08:48.69,Default,,0,0,0,,Жарайды, жоспарды жалғастыр.
Dialogue: 0,0:08:48.77,0:08:51.44,Default,,0,0,0,,Кітапхана бөлмесіне кіруге тыйым салынады.
Dialogue: 0,0:08:51.53,0:08:54.03,Default,,0,0,0,,Даналыққа қол жеткізсең де, қиындық тудырады.
Dialogue: 0,0:08:54.49,0:08:56.16,Default,,0,0,0,,Қалауыңызша
Dialogue: 0,0:09:03.29,0:09:05.37,Default,,0,0,0,,Мақсатын білмеймін, бірақ
Dialogue: 0,0:09:05.46,0:09:09.09,Default,,0,0,0,,Мен сіздің ақымақ нәрсе ойлап жатқаныңызды толық түсінемін.
Dialogue: 0,0:09:12.30,0:09:15.76,Default,,0,0,0,,Енді... Мен сені міндетті түрде өлтіре аламын.
Dialogue: 0,0:09:31.69,0:09:34.74,Default,,0,0,0,,(Студенттердің шуы)
Dialogue: 0,0:09:40.45,0:09:44.04,Default,,0,0,0,,Жасырымды бұзып, кешегі күнді айтайын ба?
Dialogue: 0,0:09:44.54,0:09:48.04,Default,,0,0,0,,Бірақ мен мұны айтсам да, сені қалай сендіремін...
Dialogue: 0,0:09:48.12,0:09:49.58,Default,,0,0,0,,Бәріңіз тыңдаңыздар!
Dialogue: 0,0:09:49.67,0:09:50.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:50.46,0:09:53.25,Default,,0,0,0,,Менің ойымша, бұл жерде консенсусқа жету керек.
Dialogue: 0,0:09:53.34,0:09:56.42,Default,,0,0,0,,Біз мұнда келгеннен бері күшейіп бара жатқан сияқтымыз.
Dialogue: 0,0:09:56.92,0:09:58.13,Default,,0,0,0,,Сонда сол күшпен
Dialogue: 0,0:09:58.22,0:10:00.64,Default,,0,0,0,,Бұл дүниедегі адамдарға көмектесуіміз керек емес пе?
Dialogue: 0,0:10:01.43,0:10:04.35,Default,,0,0,0,,Мен патшаның өтінішін тыңдап, жын патшаны жеңгім келеді.
Dialogue: 0,0:10:04.85,0:10:06.14,Default,,0,0,0,,Мен де барлығының маған көмектескенін қалаймын.
Dialogue: 0,0:10:06.23,0:10:08.52,Default,,0,0,0,,Мен мұны істеймін! Сіз күткендей, Цукаса!
Dialogue: 0,0:10:08.60,0:10:12.44,Default,,0,0,0,,Ол патша мен ханшайымды өз жағында деп болжап, оларға шабуыл жасайды.
Dialogue: 0,0:10:15.11,0:10:17.03,Default,,0,0,0,,Бірінші топ сапқа тұр!
Dialogue: 0,0:10:19.16,0:10:22.99,Default,,0,0,0,,Танысқаныма қуаныштымын, менің атым Саран Мисрей.
Dialogue: 0,0:10:23.53,0:10:27.00,Default,,0,0,0,,Лейтис Корольдігінің рыцарьларының қолбасшысы және соңғы бекініс...
Dialogue: 0,0:10:27.54,0:10:30.79,Default,,0,0,0,,Өзім айтсам, бұл ұят, Зел-кун.
Dialogue: 0,0:10:30.88,0:10:34.09,Default,,0,0,0,,Көшбасшы, сіз осындай нәрселер үшін сынға түсесіз.
Dialogue: 0,0:10:34.17,0:10:36.92,Default,,0,0,0,,Жарайды, жарайды, хахаха
Dialogue: 0,0:10:37.01,0:10:41.59,Default,,0,0,0,,Енді, батырлар, бүгіннен бастап жаттығуды бастаңыздар.
Dialogue: 0,0:10:41.68,0:10:44.93,Default,,0,0,0,,Бір айдан кейін мен сені жер асты лабиринтіне батырамын.
Dialogue: 0,0:10:45.51,0:10:49.10,Default,,0,0,0,,Дегенмен, сізде ұрыс тәжірибесі жоқ шығар.
Dialogue: 0,0:10:49.19,0:10:51.31,Default,,0,0,0,,Біз сізді сонда бағыттаймыз.
Dialogue: 0,0:10:51.90,0:10:53.06,Default,,0,0,0,,Мен Изуку Мидориямын!
Dialogue: 0,0:10:53.15,0:10:55.23,Default,,0,0,0,,Мен Изуку Мидориямын!
Dialogue: 0,0:10:55.32,0:10:56.90,Default,,0,0,0,,Не болды...
Dialogue: 0,0:10:57.57,0:11:00.53,Default,,0,0,0,,Мен ақпарат жинауды жалғастырамын деп ойлаймын.
Dialogue: 0,0:11:01.99,0:11:04.78,Default,,0,0,0,,Зел мырза, мен мұны сізге қалдырамын.
Dialogue: 0,0:11:04.87,0:11:05.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:14.21,0:11:15.92,Default,,0,0,0,,Сізде алаңдаушылық бар ма?
Dialogue: 0,0:11:16.42,0:11:18.92,Default,,0,0,0,,Бар-жоғын жасыру жойылмаған болуы керек.
Dialogue: 0,0:11:19.01,0:11:20.63,Default,,0,0,0,,Уақыт шегі бар ма?
Dialogue: 0,0:11:21.13,0:11:24.22,Default,,0,0,0,,Бар-жоғын жасыру дұрыс жұмыс істейді.
Dialogue: 0,0:11:26.64,0:11:29.93,Default,,0,0,0,,Менің көздерім аздап ерекше.
Dialogue: 0,0:11:30.02,0:11:33.19,Default,,0,0,0,,Температурадағы айырмашылықтарды визуалды түрде анықтауға болады
Dialogue: 0,0:11:33.27,0:11:34.61,Default,,0,0,0,,Бұл жаман көздің бір түрі.
Dialogue: 0,0:11:36.44,0:11:37.69,Default,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:11:37.78,0:11:41.15,Default,,0,0,0,,Мен патшаға да, ханшайымға да айтпаймын.
Dialogue: 0,0:11:41.24,0:11:42.99,Default,,0,0,0,,Сондықтан бұлай қобалжымаңыз
Dialogue: 0,0:11:43.07,0:11:46.20,Default,,0,0,0,,Сіз ол жақтан емессіз бе?
Dialogue: 0,0:11:46.28,0:11:48.83,Default,,0,0,0,,Көп нәрсе бар, соның ішінде біз де.
Dialogue: 0,0:11:49.58,0:11:52.37,Default,,0,0,0,,Әй, бұл туралы патшаға айтпа.
Dialogue: 0,0:11:54.13,0:11:55.29,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:11:57.75,0:11:59.71,Default,,0,0,0,,Кітапханаға барғыңыз келе ме?
Dialogue: 0,0:11:59.80,0:12:03.22,Default,,0,0,0,,А, мен бұл дүние туралы ештеңе білмеймін.
Dialogue: 0,0:12:03.72,0:12:05.64,Default,,0,0,0,,Сондай-ақ шеберлік пен сиқыр туралы
Dialogue: 0,0:12:05.72,0:12:08.51,Default,,0,0,0,,Сіздің «бар болуды жасыру» дағдысы
Dialogue: 0,0:12:08.60,0:12:10.35,Default,,0,0,0,,Қазір қандай деңгейдесіз?
Dialogue: 0,0:12:10.43,0:12:11.14,Default,,0,0,0,,МАКС
Dialogue: 0,0:12:11.23,0:12:12.69,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:12:13.35,0:12:16.27,Default,,0,0,0,,Дегенмен, басқа дағдылардың көпшілігі 1-деңгейде.
Dialogue: 0,0:12:16.36,0:12:17.86,Default,,0,0,0,,Мен оны қалай көтеруді де білмеймін.
Dialogue: 0,0:12:18.77,0:12:20.57,Default,,0,0,0,,Саған үйретейін бе?
Dialogue: 0,0:12:21.07,0:12:23.40,Default,,0,0,0,,Кітапханада кітаптар көп емес.
Dialogue: 0,0:12:24.07,0:12:26.99,Default,,0,0,0,,Шынымды айтсам, өзімді жоғары сезіндім.
Dialogue: 0,0:12:27.07,0:12:30.45,Default,,0,0,0,,Әңгімеде көргендей әлемде болу
Dialogue: 0,0:12:30.95,0:12:31.87,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:12:33.00,0:12:37.71,Default,,0,0,0,,Өйткені, мен өзімнің бастапқы әлеміме оралудың жолын табуым керек.
Dialogue: 0,0:12:38.29,0:12:39.92,Default,,0,0,0,,Менің отбасым бар.
Dialogue: 0,0:12:40.00,0:12:41.55,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:12:41.63,0:12:44.97,Default,,0,0,0,,Отбасы үйлесімді болған жағдайда жақсы болады.
Dialogue: 0,0:12:45.47,0:12:47.39,Default,,0,0,0,,Үйге қалай жетуге болатынын білесіз бе?
Dialogue: 0,0:12:47.47,0:12:49.18,Default,,0,0,0,,Жоқ, өкінішке орай...
Dialogue: 0,0:12:49.68,0:12:53.02,Default,,0,0,0,,Бірақ әзірге біз күшейе түсуіміз керек.
Dialogue: 0,0:12:53.52,0:12:56.44,Default,,0,0,0,,Егер мен үйге оралмай тұрып өлсем, менің бұрынғы адамым да, балаларым да болмайды.
Dialogue: 0,0:12:56.94,0:13:00.61,Default,,0,0,0,,Мен сізге жоғары дәрежелі өлтіруші болуға көмектесе аламын.
Dialogue: 0,0:13:01.11,0:13:02.65,Default,,0,0,0,,Адамдарды мынаны және мынаны тегін жасауға баулу
Dialogue: 0,0:13:02.74,0:13:04.20,Default,,0,0,0,,Құлықсыз
Dialogue: 0,0:13:04.78,0:13:06.28,Default,,0,0,0,,Сыйлық ретінде
Dialogue: 0,0:13:06.36,0:13:08.82,Default,,0,0,0,,Өз әлеміңіз туралы айтып беріңізші.
Dialogue: 0,0:13:09.41,0:13:12.20,Default,,0,0,0,,Менің түрім мынау: Білімге құштармын.
Dialogue: 0,0:13:22.59,0:13:24.34,Default,,0,0,0,,Сіз өз атыңызды айтпадыңыз.
Dialogue: 0,0:13:24.88,0:13:26.01,Default,,0,0,0,,Акира Ода
Dialogue: 0,0:13:26.59,0:13:28.64,Default,,0,0,0,,Құрметпен, Акира-кун
Dialogue: 0,0:13:33.02,0:13:34.23,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:34.31,0:13:38.60,Default,,0,0,0,,Бұл дүниеде адамдар мен жындардан басқа эльфтер мен аңдар бар ма?
Dialogue: 0,0:13:38.69,0:13:39.56,Default,,0,0,0,,Иә
Dialogue: 0,0:13:39.65,0:13:42.23,Default,,0,0,0,,Олардың әрқайсысы әртүрлі континенттерде тұрады.
Dialogue: 0,0:13:42.73,0:13:46.36,Default,,0,0,0,,-да? Бұл сіздің шеберлік деңгейіңізді шынымен арттырады ма?
Dialogue: 0,0:13:46.45,0:13:47.40,Default,,0,0,0,,Әрине
Dialogue: 0,0:13:47.49,0:13:50.66,Default,,0,0,0,,Құбыжықтарды жеңмейінше кәсіп деңгейі көтерілмейді.
Dialogue: 0,0:13:50.74,0:13:53.70,Default,,0,0,0,,Дағды деңгейін оқыту арқылы арттыруға болады
Dialogue: 0,0:13:54.20,0:13:57.46,Default,,0,0,0,,Десе де, Акира әлемінің хикаясы қызық.
Dialogue: 0,0:13:58.25,0:14:03.42,Default,,0,0,0,,Ұшатын темір көлік, дүниенің түкпір-түкпіріне ақпаратты лезде тарататын тақта т.б.
Dialogue: 0,0:14:03.96,0:14:06.26,Default,,0,0,0,,Бұл мен үшін өте қалыпты нәрсе.
Dialogue: 0,0:14:06.34,0:14:09.01,Default,,0,0,0,,Мен қазір бұл қалыпты сағындым.
Dialogue: 0,0:14:12.76,0:14:15.14,Default,,0,0,0,,Әйтеуір пішін алды.
Dialogue: 0,0:14:15.22,0:14:17.81,Default,,0,0,0,,Өйткені басшы үнемі Акира-кунның соңынан еріп жүретін.
Dialogue: 0,0:14:17.89,0:14:20.19,Default,,0,0,0,,Жұмысым көбейіп, қиын болды.
Dialogue: 0,0:14:20.27,0:14:22.73,Default,,0,0,0,,Өйткені ол күлкілі.
Dialogue: 0,0:14:22.82,0:14:25.94,Default,,0,0,0,,Олар өмір сүрген дүниенің тарихы да өте қызықты.
Dialogue: 0,0:14:26.44,0:14:27.24,Default,,0,0,0,,Жапония
Dialogue: 0,0:14:27.32,0:14:30.70,Default,,0,0,0,,Иә, тұңғыш батыр шыққан ел осы.
Dialogue: 0,0:14:30.78,0:14:34.99,Default,,0,0,0,,Оның үстіне, оның қатысуын жасыру мүмкіндігі барынша жоғары, тіпті бейнеде де көрсетілмейді.
Dialogue: 0,0:14:35.08,0:14:36.58,Default,,0,0,0,,MAX деңгейі?
Dialogue: 0,0:14:36.66,0:14:39.16,Default,,0,0,0,,Бұл батырлардың бірінші буыны ғана жете алатын аймақ.
Dialogue: 0,0:14:41.04,0:14:42.88,Default,,0,0,0,,Өсек айтсаң... мүмкін?
Dialogue: 0,0:14:43.38,0:14:45.46,Default,,0,0,0,,Сонымен, I
Dialogue: 0,0:14:47.21,0:14:48.13,Default,,0,0,0,,Хо
Dialogue: 0,0:14:48.72,0:14:50.80,Default,,0,0,0,,Менің де білімге құштарлығым бар.
Dialogue: 0,0:14:51.30,0:14:55.01,Default,,0,0,0,,Күнде түнде кітапханаға жасырын кіріп, оны басынан аяғына дейін оқитынмын.
Dialogue: 0,0:14:55.10,0:14:57.14,Default,,0,0,0,,Мен бұл мазасыздықты таптым.
Dialogue: 0,0:14:57.22,0:14:59.35,Default,,0,0,0,,Бұл үлкен мәселе, солай емес пе?
Dialogue: 0,0:14:59.44,0:15:01.44,Default,,0,0,0,,Бұл төңкеріс жоспары.
Dialogue: 0,0:15:01.94,0:15:03.40,Default,,0,0,0,,Мен оны жаздым
Dialogue: 0,0:15:03.48,0:15:06.53,Default,,0,0,0,,Оны аспаздық кітап етіп жасырған менмін.
Dialogue: 0,0:15:06.61,0:15:07.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:08.78,0:15:11.66,Default,,0,0,0,,Мен оны ақырында табасыз деп ойладым.
Dialogue: 0,0:15:12.78,0:15:14.95,Default,,0,0,0,,Патша бұзылды.
Dialogue: 0,0:15:15.45,0:15:19.66,Default,,0,0,0,,Мен бұл дүниенің ережелерін қорқынышты бағамен бұзуға тырысамын.
Dialogue: 0,0:15:19.75,0:15:20.66,Default,,0,0,0,,Ха…
Dialogue: 0,0:15:23.17,0:15:25.13,Default,,0,0,0,,Мен оны назардан тыс қалдыра алмаймын.
Dialogue: 0,0:15:25.92,0:15:26.88,Default,,0,0,0,,Тек...
Dialogue: 0,0:15:27.42,0:15:30.72,Default,,0,0,0,,Біз, рыцарьлар, патшаға қарыздармыз.
Dialogue: 0,0:15:31.47,0:15:34.68,Default,,0,0,0,,Кім мейлінше бейбіт жолмен біреуді биліктен кетіруге тырысады?
Dialogue: 0,0:15:34.76,0:15:35.68,Default,,0,0,0,,Мен оны оқып, түсіндім.
Dialogue: 0,0:15:35.76,0:15:38.64,Default,,0,0,0,,Сіз күткендей, Акира-кун, сізде жақсы идея бар.
Dialogue: 0,0:15:39.18,0:15:43.48,Default,,0,0,0,,Ешкіммен байланысы жоқ мен оны өлтірсем оңай болар еді.
Dialogue: 0,0:15:46.69,0:15:49.90,Default,,0,0,0,,Бұл дүниеге келген күні мен патша кабинетіне кірдім.
Dialogue: 0,0:15:50.95,0:15:54.49,Default,,0,0,0,,Артынан ол мені мүлде байқамады.
Dialogue: 0,0:15:55.24,0:15:56.33,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:15:57.41,0:15:58.83,Default,,0,0,0,,Өлтіре алмадым
Dialogue: 0,0:16:00.16,0:16:02.16,Default,,0,0,0,,Жарайсың, Акира.
Dialogue: 0,0:16:02.25,0:16:03.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:03.17,0:16:06.50,Default,,0,0,0,,Адам өлтірмеу жақсы.
Dialogue: 0,0:16:07.00,0:16:09.63,Default,,0,0,0,,Тіпті мәртебесі өлтіруші болса да
Dialogue: 0,0:16:09.71,0:16:12.47,Default,,0,0,0,,Мұны істеуге міндетті емес.
Dialogue: 0,0:16:13.63,0:16:16.76,Default,,0,0,0,,Әсіресе, бастапқы әлеміңізге оралғыңыз келсе.
Dialogue: 0,0:16:17.39,0:16:19.06,Default,,0,0,0,,Иә... бұл дұрыс.
Dialogue: 0,0:16:19.56,0:16:22.98,Default,,0,0,0,,Мен қанішер болып кетсем, анам мен апам жылайды.
Dialogue: 0,0:16:23.06,0:16:26.73,Default,,0,0,0,,Сіз аман қалып, отбасыңызға оралуыңыз керек.
Dialogue: 0,0:16:26.81,0:16:29.11,Default,,0,0,0,,Адамдарды өлтірмейтін өлтіруші бол
Dialogue: 0,0:16:29.19,0:16:30.82,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:16:31.82,0:16:34.53,Default,,0,0,0,,Неге маған сонша қолдау көрсетесің?
Dialogue: 0,0:16:34.61,0:16:37.74,Default,,0,0,0,,Менімен төңкеріс туралы сөйлескеніңіз дұрыс па?
Dialogue: 0,0:16:37.83,0:16:39.87,Default,,0,0,0,,Өйткені перспективалар бар.
Dialogue: 0,0:16:40.37,0:16:42.29,Default,,0,0,0,,Бұл күй туралы емес.
Dialogue: 0,0:16:42.79,0:16:48.67,Default,,0,0,0,,Шақырылғаннан кейін бірден айналаңыздағылардың ықпалына түспей, өзіңіз ойланып, дұрыс шешім қабылдадыңыз.
Dialogue: 0,0:16:49.80,0:16:53.63,Default,,0,0,0,,Тек айтарлықтай қиындықтарды өз бетімен жеңген адамдарға арналған.
Dialogue: 0,0:16:53.72,0:16:55.22,Default,,0,0,0,,Бұл мүмкін емес
Dialogue: 0,0:16:58.14,0:17:01.85,Default,,0,0,0,,Кішкентай кезімнен қараңғылықта болдым
Dialogue: 0,0:17:02.43,0:17:04.94,Default,,0,0,0,,Бұл ешкімнің назарын ешқашан аударған емес.
Dialogue: 0,0:17:05.02,0:17:07.19,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:17:07.90,0:17:11.28,Default,,0,0,0,,Біреу мені бірінші рет осылай мақтады дейді.
Dialogue: 0,0:17:11.78,0:17:13.53,Default,,0,0,0,,Сонда мен сені осылай мақтадым.
Dialogue: 0,0:17:13.61,0:17:17.78,Default,,0,0,0,,Мен өз әлеміме оралмас бұрын, маған кішкене төңкеріс жасауға көмектесіңізші.
Dialogue: 0,0:17:17.87,0:17:18.78,Default,,0,0,0,,Орташа
Dialogue: 0,0:17:18.87,0:17:21.29,Default,,0,0,0,,Хехе... Ойланып көрейін.
Dialogue: 0,0:17:25.41,0:17:27.21,Default,,0,0,0,,Бір ай өтті, солай
Dialogue: 0,0:17:27.29,0:17:29.67,Default,,0,0,0,,Жоспарланғандай Кантинен лабиринтіне кіріңіз.
Dialogue: 0,0:17:30.25,0:17:31.88,Default,,0,0,0,,Сендер батырсыңдар
Dialogue: 0,0:17:31.96,0:17:34.17,Default,,0,0,0,,Кеудеңізді көтеріп, абыройлы болыңыз.
Dialogue: 0,0:17:35.01,0:17:37.76,Default,,0,0,0,,Күшіңізді тексеру үшін жақын маңдағы лабиринтке барыңыз.
Dialogue: 0,0:17:37.84,0:17:39.60,Default,,0,0,0,,Бұл мереке ме?
Dialogue: 0,0:17:40.39,0:17:40.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:46.39,0:17:48.15,Default,,0,0,0,,Неге маған бұлай жалт қарадың?
Dialogue: 0,0:17:48.23,0:17:48.94,Default,,0,0,0,,Ах
Dialogue: 0,0:17:49.86,0:17:51.44,Default,,0,0,0,,Жоқ, мен жай ғана қызық болдым.
Dialogue: 0,0:17:52.65,0:17:56.49,Default,,0,0,0,,Батыр атанған халықсыңдар.
Dialogue: 0,0:17:56.57,0:17:59.82,Default,,0,0,0,,Сізді қандай бағаға шақырғаныңызды білесіз бе?
Dialogue: 0,0:17:59.91,0:18:01.12,Default,,0,0,0,,Құрбан шалу?
Dialogue: 0,0:18:01.62,0:18:03.33,Default,,0,0,0,,Кешіріңіз, бірақ мен түсінбеймін.
Dialogue: 0,0:18:03.87,0:18:07.83,Default,,0,0,0,,Жауабын білгенде тағы кездескенше.
Dialogue: 0,0:18:16.88,0:18:20.55,Default,,0,0,0,,Менің ойымша, бұл сенімен бітпейтін сияқты.
Dialogue: 0,0:18:30.65,0:18:31.44,Default,,0,0,0,,(құбыжықтың дауысы)
Dialogue: 0,0:18:31.52,0:18:34.98,Default,,0,0,0,,(Соққы дыбысы және соғу дыбысы)
Dialogue: 0,0:18:37.44,0:18:38.74,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:18:38.82,0:18:39.49,Default,,0,0,0,,Әй!
Dialogue: 0,0:18:41.57,0:18:42.49,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:45.54,0:18:46.95,Default,,0,0,0,,(Студенттердің шуы)
Dialogue: 0,0:18:47.66,0:18:49.08,Default,,0,0,0,,Тағы бір тұзақ?
Dialogue: 0,0:18:51.33,0:18:53.04,Default,,0,0,0,,Капитан Саран: Осы жерден артқа шегінуіміз керек пе?
Dialogue: 0,0:18:54.00,0:18:56.46,Default,,0,0,0,,Жақсы, әзірге жақсы.
Dialogue: 0,0:18:59.05,0:19:02.68,Default,,0,0,0,,Раббым, маған күш бер
Dialogue: 0,0:19:05.39,0:19:06.22,Default,,0,0,0,,Көктегі қылыш!
Dialogue: 0,0:19:13.81,0:19:14.73,Default,,0,0,0,,Қазір!
Dialogue: 0,0:19:18.44,0:19:18.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:20.65,0:19:22.49,Default,,0,0,0,,Қарғыс атсын... мұнда да...
Dialogue: 0,0:19:22.57,0:19:23.07,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:23.16,0:19:26.37,Default,,0,0,0,,Жындарды болдырмау үшін түтін бомбасында орналасқан.
Dialogue: 0,0:19:26.87,0:19:29.83,Default,,0,0,0,,Оны төтенше жағдайда пайдаланыңыз.
Dialogue: 0,0:19:31.37,0:19:32.25,Default,,0,0,0,,(Ичи) Вице-канцлермен кездесуге әлі біраз уақыт бар, бірақ—
Dialogue: 0,0:19:34.29,0:19:35.50,Default,,0,0,0,,Жарайды, енді...
Dialogue: 0,0:19:35.59,0:19:36.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:41.01,0:19:43.43,Default,,0,0,0,,Сонымен... неге?
Dialogue: 0,0:19:44.26,0:19:46.93,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:19:47.64,0:19:48.52,Default,,0,0,0,,Міне!
Dialogue: 0,0:19:49.02,0:19:50.60,Default,,0,0,0,,Минотавр!
Dialogue: 0,0:19:50.68,0:19:52.48,Default,,0,0,0,,Неліктен мұндай таяз қабат?
Dialogue: 0,0:19:52.56,0:19:53.06,Default,,0,0,0,,Цк
Dialogue: 0,0:20:04.91,0:20:05.95,Default,,0,0,0,,Не?!
Dialogue: 0,0:20:14.29,0:20:15.54,Default,,0,0,0,,Акира...
Dialogue: 0,0:20:16.34,0:20:17.75,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:20:17.84,0:20:18.75,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:18.84,0:20:22.26,Default,,0,0,0,,Өзіңді итерме, қолың сынған шығар.
Dialogue: 0,0:20:23.05,0:20:26.76,Default,,0,0,0,,Мен өз сыныбымдағылардың барлығын қорғауым керек...
Dialogue: 0,0:20:26.85,0:20:29.39,Default,,0,0,0,,Сонда сені кім қорғайды?
Dialogue: 0,0:20:29.47,0:20:30.64,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:31.27,0:20:35.27,Default,,0,0,0,,Батырдың күші әлемді құтқаруға арналған!
Dialogue: 0,0:20:35.35,0:20:38.77,Default,,0,0,0,,Сонда барлығын кім қорғайды?
Dialogue: 0,0:20:38.86,0:20:41.03,Default,,0,0,0,,Өзіңізді қорғаңыз!
Dialogue: 0,0:20:42.11,0:20:44.49,Default,,0,0,0,,Сен сол үшін жаттығатын емес пе едің?
Dialogue: 0,0:20:46.16,0:20:49.28,Default,,0,0,0,,Бірақ... мен батырмын...
Dialogue: 0,0:20:49.79,0:20:50.66,Default,,0,0,0,,Батыр...
Dialogue: 0,0:20:51.66,0:20:54.58,Default,,0,0,0,,Жауапкершілікті сезінсеңіз де, бұл қалыпты емес.
Dialogue: 0,0:20:55.17,0:20:56.58,Default,,0,0,0,,Егер сізде емлені бар болса, келіңіз!
Dialogue: 0,0:20:57.17,0:20:58.75,Default,,0,0,0,,Мен емленушімін...
Dialogue: 0,0:20:58.84,0:20:59.84,Default,,0,0,0,,- (Акира) Байқап көрсем болады ма? -(Уэно) Иә?
Dialogue: 0,0:21:00.80,0:21:01.42,Default,,0,0,0,,Иә
Dialogue: 0,0:21:02.92,0:21:05.34,Default,,0,0,0,,Достарымды жейтін қарғыс
Dialogue: 0,0:21:05.43,0:21:07.64,Default,,0,0,0,,Көз алдымнан ғайып бол
Dialogue: 0,0:21:09.35,0:21:11.77,Default,,0,0,0,,Өтірік... Сіз шынымен қарғысқа ұшырайсыз ба?
Dialogue: 0,0:21:11.85,0:21:12.77,Default,,0,0,0,,Жалғастыруыңызды өтінеміз.
Dialogue: 0,0:21:13.39,0:21:15.64,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:21:16.23,0:21:17.40,Default,,0,0,0,,Көшбасшы Саран!
Dialogue: 0,0:21:17.48,0:21:18.65,Default,,0,0,0,,Акира-кун
Dialogue: 0,0:21:19.69,0:21:21.40,Default,,0,0,0,,Көшбасшы, мен оны пайдаланғым келеді.
Dialogue: 0,0:21:22.07,0:21:23.28,Default,,0,0,0,,Бұл...?
Dialogue: 0,0:21:23.36,0:21:26.36,Default,,0,0,0,,Менің аман қалуым үшін
Dialogue: 0,0:21:28.32,0:21:29.03,Default,,0,0,0,,Фу…
Dialogue: 0,0:21:30.37,0:21:33.41,Default,,0,0,0,,Жарайды, маған қосылыңыз.
Dialogue: 0,0:21:33.50,0:21:34.20,Default,,0,0,0,,Иә
Dialogue: 0,0:21:38.58,0:21:39.63,Default,,0,0,0,,Мырза
Dialogue: 0,0:21:40.54,0:21:44.42,Default,,0,0,0,,Жолымызға бөгет болған жауларды тамырымен қопаратын ұшқын...
Dialogue: 0,0:21:45.09,0:21:46.05,Default,,0,0,0,,Жарқыраған найзағай!
Dialogue: 0,0:21:49.64,0:21:52.31,Default,,0,0,0,,Шыу!
Dialogue: 0,0:22:04.86,0:22:07.53,Default,,0,0,0,,Көлеңке сиқыры іске қосылды!
Dialogue: 0,0:22:11.78,0:22:13.79,Default,,0,0,0,,♪～
Dialogue: 0,0:23:38.91,0:23:40.91,Default,,0,0,0,,～♪
