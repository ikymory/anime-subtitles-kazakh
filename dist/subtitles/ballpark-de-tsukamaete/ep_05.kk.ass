Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:06.00,Default,,0,0,0,,♪～
Dialogue: 0,0:01:22.08,0:01:27.08,Default,,0,0,0,,～♪
Dialogue: 0,0:01:37.47,0:01:39.64,Default,,0,0,0,,Бүгін келе алатыныма қуаныштымын.
Dialogue: 0,0:01:39.72,0:01:42.43,Default,,0,0,0,,Осы аптада мен де бос емес едім.
Dialogue: 0,0:01:43.52,0:01:45.68,Default,,0,0,0,,Қоғам мүшесі болғаныма бірнеше жыл⸺
Dialogue: 0,0:01:45.77,0:01:49.48,Default,,0,0,0,,Мұрата әлі де корпоративтік-клуб жолында.
Dialogue: 0,0:01:49.56,0:01:52.57,Default,,0,0,0,,Стресстен арылуға болатын орын әрқашан бейсбол алаңы
Dialogue: 0,0:01:53.19,0:01:55.24,Default,,0,0,0,,Мұрата бейсбол фанаты⸺
Dialogue: 0,0:01:55.32,0:01:59.03,Default,,0,0,0,,Біріншіден, шиеленістің көтерілетін сәті бар.
Dialogue: 0,0:01:59.53,0:02:02.54,Default,,0,0,0,,Күңгірт флуоресцентті шамдардың өтуі арқылы өту⸺
Dialogue: 0,0:02:02.62,0:02:05.75,Default,,0,0,0,,Аудиторияға апаратын қақпадан өткенде⸺
Dialogue: 0,0:02:05.96,0:02:07.16,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:02:07.16,0:02:10.46,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:02:07.16,0:02:10.46,Default,,0,0,0,,Менің көзқарасым кенеттен ашылғандай болды!
Dialogue: 0,0:02:10.88,0:02:13.50,Default,,0,0,0,,Қанша келсем де, шыдамайды
Dialogue: 0,0:02:21.60,0:02:22.85,Default,,0,0,0,,Я...
Dialogue: 0,0:02:23.56,0:02:26.93,Default,,0,0,0,,Бұл компания мен жұмыстың бар екенін ұмытады.
Dialogue: 0,0:02:27.02,0:02:29.31,Default,,0,0,0,,Басқа әлемге келгендей
Dialogue: 0,0:02:29.40,0:02:31.98,Default,,0,0,0,,Ым... (Мұрата) А, иә?
Dialogue: 0,0:02:32.19,0:02:34.53,Default,,0,0,0,,Мұрата-сенпай, неткен сәйкестік.
Dialogue: 0,0:02:34.61,0:02:36.07,Default,,0,0,0,,Шимизу!
Dialogue: 0,0:02:36.15,0:02:37.95,Default,,0,0,0,,Сіз не істеп жатырсыз? Осындай жерде
Dialogue: 0,0:02:38.20,0:02:41.66,Default,,0,0,0,,Бейсбол ойыны болуы керек емес пе?
Dialogue: 0,0:02:41.74,0:02:45.08,Default,,0,0,0,,Жарайды... жарайды, хахаха...
Dialogue: 0,0:02:45.16,0:02:47.12,Default,,0,0,0,,Әлемнің тағы бір соңы
Dialogue: 0,0:02:47.41,0:02:49.08,Default,,0,0,0,,Қарсы болмасаңыз, менімен бірге көргіңіз келе ме?
Dialogue: 0,0:02:49.16,0:02:50.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:50.54,0:02:52.54,Default,,0,0,0,,Мен көрші үйге бара аламын ба?
Dialogue: 0,0:02:52.63,0:02:54.67,Default,,0,0,0,,Не? О, жоқ...
Dialogue: 0,0:02:54.75,0:02:58.84,Default,,0,0,0,,Мен сені қолдамаймын, сенімен бірге болу қызықсыз.
Dialogue: 0,0:02:59.22,0:03:02.55,Default,,0,0,0,,Мүлде жоқ! Мен де сабырлы адаммын.
Dialogue: 0,0:03:03.05,0:03:06.60,Default,,0,0,0,,Менің бос уақытым ойынды жалғыз көру.
Dialogue: 0,0:03:06.68,0:03:08.56,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:03:08.81,0:03:10.77,Default,,0,0,0,,Ым... Сенпай (Мұрата)?
Dialogue: 0,0:03:11.23,0:03:13.56,Default,,0,0,0,,Күлмейсің деп үміттенемін.
Dialogue: 0,0:03:13.77,0:03:15.90,Default,,0,0,0,,Не? Не... не?
Dialogue: 0,0:03:15.98,0:03:20.20,Default,,0,0,0,,Мен шоуды форма киіп қарайтын адаммын, кешіріңізші!
Dialogue: 0,0:03:20.28,0:03:21.28,Default,,0,0,0,,Ммм
Dialogue: 0,0:03:21.49,0:03:25.33,Default,,0,0,0,,Жұмысқа формаңызды әкелу үшін бар күшіңізбен бардыңыз ба?
Dialogue: 0,0:03:25.41,0:03:28.70,Default,,0,0,0,,Мен оны өзіммен бірге алып келдім, дәлірек айтсам, сонда қалдырдым.
Dialogue: 0,0:03:28.79,0:03:30.33,Default,,0,0,0,,Кез келген уақытта бара аласыз
Dialogue: 0,0:03:30.58,0:03:31.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:31.71,0:03:35.50,Default,,0,0,0,,Әй, менің компаниям жақсы қызды жұмысқа алды.
Dialogue: 0,0:03:35.96,0:03:38.34,Default,,0,0,0,,Сыра ішкіңіз келе ме? иә
Dialogue: 0,0:03:38.67,0:03:41.13,Default,,0,0,0,,Мм... аа
Dialogue: 0,0:03:42.22,0:03:43.43,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:03:44.39,0:03:46.72,Default,,0,0,0,,Иә! (Мұрата) А, Рурико-сан.
Dialogue: 0,0:03:46.81,0:03:48.43,Default,,0,0,0,,Ах, о!
Dialogue: 0,0:03:49.10,0:03:52.52,Default,,0,0,0,,Ағаның сізге шақыруы сирек.
Dialogue: 0,0:03:52.73,0:03:55.27,Default,,0,0,0,,Мм... екі нәрсе, өтінемін.
Dialogue: 0,0:03:55.36,0:03:56.36,Default,,0,0,0,,Керемет!
Dialogue: 0,0:03:56.94,0:03:57.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:58.94,0:04:02.40,Default,,0,0,0,,Брайан, сенің де бүгің жақсы.
Dialogue: 0,0:04:02.66,0:04:05.87,Default,,0,0,0,,Жоқ... жоқ, мен компанияда кіші курс студентімін.
Dialogue: 0,0:04:06.53,0:04:07.74,Default,,0,0,0,,Иә
Dialogue: 0,0:04:08.87,0:04:10.62,Default,,0,0,0,,Рурико ойланып қалды
Dialogue: 0,0:04:12.16,0:04:15.13,Default,,0,0,0,,Бір нәрсе мені жиіркенішті.
Dialogue: 0,0:04:15.46,0:04:18.09,Default,,0,0,0,,Ах~
Dialogue: 0,0:04:18.17,0:04:20.46,Default,,0,0,0,,Кодзиро іске қосылды!
Dialogue: 0,0:04:21.63,0:04:22.80,Default,,0,0,0,,Мен оның солай болатынына көз жеткіземін.
Dialogue: 0,0:04:23.13,0:04:25.39,Default,,0,0,0,,Қандай бақыттысыңдар, барлық қызықты өзіңе алдыңдар.
Dialogue: 0,0:04:25.47,0:04:26.47,Default,,0,0,0,,Иә
Dialogue: 0,0:04:28.51,0:04:30.98,Default,,0,0,0,,Кодзиро жақсы.
Dialogue: 0,0:04:31.27,0:04:35.44,Default,,0,0,0,,Өйткені, wRC+ – 120.
Dialogue: 0,0:04:35.52,0:04:37.19,Default,,0,0,0,,Иә? Тұрақты тұтынушы
Dialogue: 0,0:04:37.27,0:04:39.82,Default,,0,0,0,,Иә?Иә
Dialogue: 0,0:04:40.82,0:04:42.24,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:04:42.61,0:04:46.91,Default,,0,0,0,,Әрине, Сабердің көзқарасы бойынша, Кодзиро нақты нәтижелер береді.
Dialogue: 0,0:04:46.99,0:04:48.45,Default,,0,0,0,,Ха, ха, ха!
Dialogue: 0,0:04:48.74,0:04:52.12,Default,,0,0,0,,Бейсбол – сәтсіздіктер спорты⸺
Dialogue: 0,0:04:52.20,0:04:53.75,Default,,0,0,0,,Сатушы айтқандай⸺
Dialogue: 0,0:04:53.83,0:04:57.67,Default,,0,0,0,,Бір ат-батта бәрің қуанып, күйзелуің керек емес пе?
Dialogue: 0,0:04:57.88,0:05:02.01,Default,,0,0,0,,Сонымен қатар, Кодзиро да қорғаныста көп үлес қосады.
Dialogue: 0,0:05:02.09,0:05:04.47,Default,,0,0,0,,Сіздің жасыңызды сездірмейтін қорғаныс диапазонында⸺
Dialogue: 0,0:05:04.55,0:05:07.51,Default,,0,0,0,,UZR +8 керемет
Dialogue: 0,0:05:07.59,0:05:09.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:09.35,0:05:11.52,Default,,0,0,0,,Ку... егжей-тегжейлі.
Dialogue: 0,0:05:11.60,0:05:15.23,Default,,0,0,0,,Эххе мен бейсбол клубының менеджері болдым.
Dialogue: 0,0:05:16.19,0:05:18.06,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:19.98,0:05:20.98,Default,,0,0,0,,Ах
Dialogue: 0,0:05:22.78,0:05:25.74,Default,,0,0,0,,Нинста! Нинста мұны істей ме?
Dialogue: 0,0:05:25.82,0:05:28.78,Default,,0,0,0,,Не? Нинста?
Dialogue: 0,0:05:29.07,0:05:30.95,Default,,0,0,0,,Мен мұны істеген жоқпын.
Dialogue: 0,0:05:31.04,0:05:32.24,Default,,0,0,0,,Хехе
Dialogue: 0,0:05:33.25,0:05:36.00,Default,,0,0,0,,Әй, неткен ысырап~
Dialogue: 0,0:05:36.08,0:05:40.50,Default,,0,0,0,,Егер сіз Ninsta жасамасаңыз, өміріңізді босқа өткізесіз.
Dialogue: 0,0:05:40.75,0:05:44.97,Default,,0,0,0,,Мен ондай нәрсені көп білмеймін... Ұят.
Dialogue: 0,0:05:47.13,0:05:52.01,Default,,0,0,0,,Егер сіз оны қолданып көрсеңіз, қызық болуы мүмкін.
Dialogue: 0,0:05:52.43,0:05:54.48,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:05:55.10,0:05:57.64,Default,,0,0,0,,Кууу!
Dialogue: 0,0:05:57.73,0:05:59.86,Default,,0,0,0,,Руриконың толық жеңілуі
Dialogue: 0,0:06:05.36,0:06:07.36,Default,,0,0,0,,Бір қуырылған тауық бентосы.
Dialogue: 0,0:06:07.45,0:06:11.78,Default,,0,0,0,,Иә, қуырылған тауық бентосы бір дана үшін 1200 иен.
Dialogue: 0,0:06:12.28,0:06:13.29,Default,,0,0,0,,Иә
Dialogue: 0,0:06:13.95,0:06:15.62,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:06:15.70,0:06:19.17,Default,,0,0,0,,Эй, Мада-чан, сен де бүгін қатты жұмыс істеп жатырсың.
Dialogue: 0,0:06:19.42,0:06:22.88,Default,,0,0,0,,Жоқ, жоқ, маған рұқсат бар.
Dialogue: 0,0:06:23.17,0:06:25.13,Default,,0,0,0,,Иә, күткеніңізге рахмет.
Dialogue: 0,0:06:25.38,0:06:27.67,Default,,0,0,0,,Рахмет, көріскенше.
Dialogue: 0,0:06:27.76,0:06:29.59,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:06:30.55,0:06:32.43,Default,,0,0,0,,Қош келдіңіз... Ах.
Dialogue: 0,0:06:32.68,0:06:34.77,Default,,0,0,0,,О... ханзада!
Dialogue: 0,0:06:37.48,0:06:38.89,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:06:38.98,0:06:42.56,Default,,0,0,0,,Ультра бентоға қызмет ететін бір мега, солай ма?
Dialogue: 0,0:06:42.65,0:06:44.78,Default,,0,0,0,,Не? А... иә
Dialogue: 0,0:06:44.86,0:06:45.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:46.07,0:06:47.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:50.32,0:06:52.37,Default,,0,0,0,,Дәл осындай тағы бір нәрсе
Dialogue: 0,0:06:52.45,0:06:53.66,Default,,0,0,0,,Қандай нәрсе!
Dialogue: 0,0:06:54.70,0:06:56.37,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:06:57.04,0:06:59.79,Default,,0,0,0,,Ханзада кім!?
Dialogue: 0,0:07:00.29,0:07:04.04,Default,,0,0,0,,Анау аяғын сыртқа шығарған жігіт!
Dialogue: 0,0:07:08.92,0:07:11.76,Default,,0,0,0,,Тағы бір сусын алғыңыз келе ме?
Dialogue: 0,0:07:11.84,0:07:14.39,Default,,0,0,0,,Иә? Сонда...
Dialogue: 0,0:07:14.72,0:07:16.06,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:07:16.14,0:07:20.14,Default,,0,0,0,,Иә! Сізге көп рахмет!
Dialogue: 0,0:07:20.35,0:07:23.73,Default,,0,0,0,,Эй, Брайанның жарғанатқа кезегі келді!
Dialogue: 0,0:07:24.69,0:07:26.48,Default,,0,0,0,,Иә, әпке.
Dialogue: 0,0:07:26.82,0:07:28.24,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:29.24,0:07:31.57,Default,,0,0,0,,Иә, тұрақты тұтынушы.
Dialogue: 0,0:07:31.78,0:07:34.28,Default,,0,0,0,,(Оқушылар) Э-э… Мүмкін емес! Мүмкін емес!
Dialogue: 0,0:07:37.12,0:07:41.08,Default,,0,0,0,,Жоқ, мен сізге өзгертуді байқаусызда ұмытып кетіппін.
Dialogue: 0,0:07:44.04,0:07:46.42,Default,,0,0,0,,Хмм, жоқ, жоқ, Нацуно.
Dialogue: 0,0:07:46.50,0:07:48.88,Default,,0,0,0,,Жеке сезімдеріңізді жұмысқа қоспаңыз
Dialogue: 0,0:07:52.47,0:07:53.47,Default,,0,0,0,,Ах
Dialogue: 0,0:07:53.93,0:07:55.30,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:08:00.14,0:08:02.73,Default,,0,0,0,,Уақытыңызды алыңыз~
Dialogue: 0,0:08:04.19,0:08:05.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:07.52,0:08:08.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:12.65,0:08:13.74,Default,,0,0,0,,Га
Dialogue: 0,0:08:16.99,0:08:21.29,Default,,0,0,0,,Нацуно Ямадада Рурико акциялары қымбаттады
Dialogue: 0,0:08:29.46,0:08:33.55,Default,,0,0,0,,Chiba Motor Sands стадионы, 2-қабат алаңы
Dialogue: 0,0:08:33.63,0:08:36.14,Default,,0,0,0,,Әртүрлі дүкендермен қызу⸺
Dialogue: 0,0:08:36.64,0:08:41.56,Default,,0,0,0,,Басқа стадиондардағы сияқты, ойыншылардың бірлескен түскі ас қораптары танымал.
Dialogue: 0,0:08:42.81,0:08:45.10,Default,,0,0,0,,Сіз өзіңізді ойыншыларға жақын сезіне аласыз⸺
Dialogue: 0,0:08:45.19,0:08:46.86,Default,,0,0,0,,Фестиваль сезімі бар⸺
Dialogue: 0,0:08:46.94,0:08:50.53,Default,,0,0,0,,Бұл өте танымал жоба...
Dialogue: 0,0:08:51.07,0:08:53.28,Default,,0,0,0,,Бір Шишио бенто, өтінемін.
Dialogue: 0,0:08:53.36,0:08:56.24,Default,,0,0,0,,Иә, ол 1200 иен болады.
Dialogue: 0,0:08:57.66,0:08:59.49,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:09:00.74,0:09:02.25,Default,,0,0,0,,Қош келдіңіз~
Dialogue: 0,0:09:03.58,0:09:04.96,Default,,0,0,0,,Я...
Dialogue: 0,0:09:05.04,0:09:09.92,Default,,0,0,0,,Кодзироның әйелі Юки терең күрсінді.
Dialogue: 0,0:09:10.25,0:09:13.34,Default,,0,0,0,,Кодзиро, сенде тым көп нәрсе қалды.
Dialogue: 0,0:09:13.42,0:09:16.93,Default,,0,0,0,,Ал Mitsui бенто жәшіктерінің саны дәл солай.
Dialogue: 0,0:09:17.76,0:09:19.43,Default,,0,0,0,,1 Кодзиро бенто
Dialogue: 0,0:09:19.51,0:09:23.10,Default,,0,0,0,,Кодзиро бенто 1 дана 1200 иен тұрады
Dialogue: 0,0:09:23.64,0:09:28.77,Default,,0,0,0,,Кәсіби бейсболшының әйелі ретінде мен күйеуімді осындай нәрселермен де қолдауым керек.
Dialogue: 0,0:09:28.86,0:09:30.57,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:09:30.86,0:09:32.99,Default,,0,0,0,,Сізге үлкен рахмет~
Dialogue: 0,0:09:33.07,0:09:37.03,Default,,0,0,0,,Қазіргі уақытта біз Mitsui бентоға қарағанда бір бенто көп сатамыз.
Dialogue: 0,0:09:37.61,0:09:39.99,Default,,0,0,0,,Екі Mitsui түскі ас қорабы, өтінемін.
Dialogue: 0,0:09:40.08,0:09:42.12,Default,,0,0,0,,Иә? Не...
Dialogue: 0,0:09:42.83,0:09:46.08,Default,,0,0,0,,Мицуи бенто жеп отырған жас әйел?
Dialogue: 0,0:09:46.67,0:09:50.96,Default,,0,0,0,,Мицуи - қорқынышты құмыра, оны әдемі деп те атауға болмайды.
Dialogue: 0,0:09:51.04,0:09:53.09,Default,,0,0,0,,Колледжді бітіргеннен кейін алты жылдан кейін техникалық солақай⸺
Dialogue: 0,0:09:53.17,0:09:56.26,Default,,0,0,0,,Бізде мұндай жас жанкүйерлер бар екеніне сене алар емеспін!
Dialogue: 0,0:09:56.34,0:09:57.47,Default,,0,0,0,,Ах
Dialogue: 0,0:09:58.05,0:09:59.64,Default,,0,0,0,,Кодзиро бенто⸺
Dialogue: 0,0:09:59.72,0:10:01.85,Default,,0,0,0,,Бір жеңіліс!
Dialogue: 0,0:10:02.14,0:10:06.35,Default,,0,0,0,,О, не...
Dialogue: 0,0:10:10.19,0:10:11.48,Default,,0,0,0,,Қандай бақыттысыңдар, барлық қызықты өзіңе алдыңдар.
Dialogue: 0,0:10:11.57,0:10:16.28,Default,,0,0,0,,Ал терең күрсінген тағы бір адам болды.
Dialogue: 0,0:10:16.36,0:10:17.45,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:17.53,0:10:19.57,Default,,0,0,0,,Мен Кодзироның бентосынан жеңілгім келмейді⸺
Dialogue: 0,0:10:19.66,0:10:22.62,Default,,0,0,0,,Мен екі сатып алдым!
Dialogue: 0,0:10:27.12,0:10:32.50,Default,,0,0,0,,Кәсіби бейсболшының дос қызы ретінде сіз оны осындай нәрселермен қолдауыңыз керек.
Dialogue: 0,0:10:33.34,0:10:36.05,Default,,0,0,0,,Әй, әпке!
Dialogue: 0,0:10:36.13,0:10:37.88,Default,,0,0,0,,Уа!
Dialogue: 0,0:10:38.18,0:10:40.80,Default,,0,0,0,,Бір сыра Азассу
Dialogue: 0,0:10:41.72,0:10:45.02,Default,,0,0,0,,Эй, бұл Mitsui bento. Бұл өте керемет.
Dialogue: 0,0:10:45.10,0:10:46.10,Default,,0,0,0,,Иә
Dialogue: 0,0:10:46.43,0:10:48.14,Default,,0,0,0,,Кейде бар
Dialogue: 0,0:10:48.23,0:10:52.77,Default,,0,0,0,,Мицуи мен Кодзиро сияқты ойыншылардың жанкүйері жас әйел.
Dialogue: 0,0:10:52.86,0:10:55.32,Default,,0,0,0,,Маған өз жолыммен жүру сезімі ұнайды.
Dialogue: 0,0:10:55.40,0:10:56.61,Default,,0,0,0,,Эхехе…
Dialogue: 0,0:10:56.69,0:10:58.74,Default,,0,0,0,,«Мен, Демегава, ақыры құдайдай Кираны ұстауға тырысқан зұлым ұйымның жасырын базасын тауып алдым,
Dialogue: 0,0:10:58.95,0:11:00.49,Default,,0,0,0,,Көгерген
Dialogue: 0,0:11:00.91,0:11:02.32,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:11:05.33,0:11:08.79,Default,,0,0,0,,Енді тамақтанайық! иә!
Dialogue: 0,0:11:08.87,0:11:10.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:11.67,0:11:14.96,Default,,0,0,0,,Ах, бұл Кодзироның бентосын сатып алған адам.
Dialogue: 0,0:11:18.47,0:11:21.26,Default,,0,0,0,,Ах... Ми... Үш!
Dialogue: 0,0:11:23.85,0:11:26.18,Default,,0,0,0,,Фуууууууук
Dialogue: 0,0:11:34.77,0:11:35.77,Default,,0,0,0,,Фу…
Dialogue: 0,0:11:36.19,0:11:38.24,Default,,0,0,0,,Хмм... Уф.
Dialogue: 0,0:11:42.28,0:11:46.03,Default,,0,0,0,,(Юки мен Кисаның ауыр тыныс алуы)
Dialogue: 0,0:11:46.12,0:11:47.99,Default,,0,0,0,,Эй... Қош келдіңіз!
Dialogue: 0,0:11:48.08,0:11:49.33,Default,,0,0,0,,Кодзиро бенто!
Dialogue: 0,0:11:49.41,0:11:50.83,Default,,0,0,0,,Мицуи бенто!
Dialogue: 0,0:11:51.12,0:11:52.37,Default,,0,0,0,,Ол әйтеуір бас тарта ма еді?
Dialogue: 0,0:11:52.46,0:11:54.21,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:11:54.84,0:11:57.09,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:11:57.80,0:11:59.21,Default,,0,0,0,,Хехехе
Dialogue: 0,0:11:59.30,0:12:01.26,Default,,0,0,0,,Қош келдіңіз~
Dialogue: 0,0:12:01.63,0:12:02.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:03.05,0:12:05.26,Default,,0,0,0,,Кодзиро бенто сатылып кетті (Киса Юки) Иә?
Dialogue: 0,0:12:05.35,0:12:08.22,Default,,0,0,0,,Мицуи бенто да жоқ (Киса Юки) Ах.
Dialogue: 0,0:12:08.56,0:12:13.27,Default,,0,0,0,,Бұл кәдімгі көкөніс бұқтырмасы жақсы даши және дәмді.
Dialogue: 0,0:12:13.35,0:12:15.65,Default,,0,0,0,,Бұл шынымен де Кодзиро сияқты.
Dialogue: 0,0:12:15.73,0:12:17.65,Default,,0,0,0,,Маған да Mitsui bento ұнайды⸺
Dialogue: 0,0:12:17.73,0:12:22.40,Default,,0,0,0,,Мен бірдеңе жегім келді, көбінесе қуырылған тауық еті мен ақ күріш.
Dialogue: 0,0:12:22.70,0:12:25.24,Default,,0,0,0,,Оған көмектесу мүмкін емес, Шишио бенто
Dialogue: 0,0:12:25.32,0:12:27.66,Default,,0,0,0,,Онда мен Макунучиге барайын, өтінемін.
Dialogue: 0,0:12:27.74,0:12:29.37,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:12:29.45,0:12:32.08,Default,,0,0,0,,Бұл... бұл қайтару...
Dialogue: 0,0:12:32.16,0:12:34.58,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:35.17,0:12:37.84,Default,,0,0,0,,Кодзиро екі жүгіруден үйге жүгірді.
Dialogue: 0,0:12:37.92,0:12:39.63,Default,,0,0,0,,Енді үйге кір!
Dialogue: 0,0:12:41.01,0:12:44.89,Default,,0,0,0,,Бастапқы құмыра Мицуи бізбен амандасу үшін орындықтан түседі.
Dialogue: 0,0:12:47.18,0:12:49.39,Default,,0,0,0,,Хэхе (Мицуи) Хахахахаха
Dialogue: 0,0:12:51.31,0:12:54.31,Default,,0,0,0,,Бұл бентоның дәмі тым күшті.
Dialogue: 0,0:12:54.39,0:12:57.31,Default,,0,0,0,,Мицуи-кун саған да осындай дәмдеуіш ұнай ма?
Dialogue: 0,0:12:57.56,0:13:00.82,Default,,0,0,0,,Онда Кодзиро ұнатпайтын асқабақ бар!
Dialogue: 0,0:13:00.90,0:13:03.28,Default,,0,0,0,,Сізге дұрыс бақылау жасалды ма?
Dialogue: 0,0:13:04.28,0:13:08.16,Default,,0,0,0,,Мен бұл екеуі жақсы араласады деп ойлаймын.
Dialogue: 0,0:13:08.58,0:13:11.08,Default,,0,0,0,,Сыра алғыңыз келе ме?
Dialogue: 0,0:13:18.00,0:13:19.88,Default,,0,0,0,,Жеңіл жаңбыр жауады⸺
Dialogue: 0,0:13:19.96,0:13:25.59,Default,,0,0,0,,Бірінші орын Фукуока Стикс пен 5 орын Chiba Motor Suns
Dialogue: 0,0:13:26.47,0:13:32.35,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:13:32.81,0:13:35.19,Default,,0,0,0,,Бүгін барған дұрыс емес пе?
Dialogue: 0,0:13:35.27,0:13:36.81,Default,,0,0,0,,...
Dialogue: 0,0:13:37.23,0:13:40.07,Default,,0,0,0,,Сыра алғыңыз келе ме?
Dialogue: 0,0:13:40.40,0:13:43.24,Default,,0,0,0,,Сыра алғыңыз келе ме?
Dialogue: 0,0:13:43.32,0:13:45.95,Default,,0,0,0,,Ой, ағай, ау
Dialogue: 0,0:13:46.03,0:13:47.86,Default,,0,0,0,,О, Рурико-чан
Dialogue: 0,0:13:47.95,0:13:49.78,Default,,0,0,0,,Каппа саған жақсы көрінеді.
Dialogue: 0,0:13:49.87,0:13:52.08,Default,,0,0,0,,Ылғал болған дұрыс па?
Dialogue: 0,0:13:52.16,0:13:54.08,Default,,0,0,0,,Тыныш тыныш
Dialogue: 0,0:13:54.16,0:13:57.71,Default,,0,0,0,,Мен кесеге пластмасса қойдым, ол жаман болмасын.
Dialogue: 0,0:13:57.79,0:14:01.71,Default,,0,0,0,,Жоқ, мен сені уайымдап тұрмын.
Dialogue: 0,0:14:01.92,0:14:03.42,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:14:03.51,0:14:06.13,Default,,0,0,0,,Эй, мен саған сусын сатып алайын.
Dialogue: 0,0:14:06.22,0:14:07.63,Default,,0,0,0,,Сосын мен де
Dialogue: 0,0:14:07.72,0:14:09.43,Default,,0,0,0,,Азассу
Dialogue: 0,0:14:11.51,0:14:12.85,Default,,0,0,0,,Фу…
Dialogue: 0,0:14:13.22,0:14:16.14,Default,,0,0,0,,Енді тағы бір рет байқап көрейік.
Dialogue: 0,0:14:16.43,0:14:19.77,Default,,0,0,0,,Бірақ оны қазір алып тастаған дұрыс емес пе?
Dialogue: 0,0:14:20.02,0:14:21.73,Default,,0,0,0,,Ах...хехе
Dialogue: 0,0:14:21.82,0:14:24.32,Default,,0,0,0,,Ой, уайымдама
Dialogue: 0,0:14:25.57,0:14:28.82,Default,,0,0,0,,Макияж бір сағатқа созылып, әп-сәтте өліп қалды⸺
Dialogue: 0,0:14:28.91,0:14:30.74,Default,,0,0,0,,Бұл енді маңызды емес
Dialogue: 0,0:14:30.82,0:14:33.29,Default,,0,0,0,,Менің ойымша, сіз біртүрлі толқудасыз.
Dialogue: 0,0:14:35.00,0:14:38.75,Default,,0,0,0,,Рурико-сан, жаңбырда қиын.
Dialogue: 0,0:14:39.08,0:14:41.42,Default,,0,0,0,,Ха... Әйтеуір⸺
Dialogue: 0,0:14:41.50,0:14:45.05,Default,,0,0,0,,Мен жақсы орын алып, өзімді марапаттау үшін қиналсам да⸺
Dialogue: 0,0:14:45.13,0:14:48.01,Default,,0,0,0,,Осындай күндерде ғана жаңбыр жауады?
Dialogue: 0,0:14:49.01,0:14:54.18,Default,,0,0,0,,Бірақ көш басында тұрған Стикс 4-ші иннингтің жоғарғы бөлігінен кейін 7 ұпайға ие болды.
Dialogue: 0,0:14:54.39,0:14:56.27,Default,,0,0,0,,Сонымен қатар, келесі шабуыл⸺
Dialogue: 0,0:14:56.35,0:14:58.27,Default,,0,0,0,,Бүгін кесу капитанының 2 соққысы болды⸺
Dialogue: 0,0:14:58.35,0:14:59.89,Default,,0,0,0,,Шишиодан
Dialogue: 0,0:14:59.98,0:15:02.11,Default,,0,0,0,,Болды~ (Мұрата) А.
Dialogue: 0,0:15:02.19,0:15:04.57,Default,,0,0,0,,Мына жымиған жүз ше?
Dialogue: 0,0:15:04.65,0:15:07.65,Default,,0,0,0,,Уау... Рурико-сан
Dialogue: 0,0:15:07.74,0:15:11.03,Default,,0,0,0,,Сирек, аға, мына жердегі орындықтар.
Dialogue: 0,0:15:11.11,0:15:13.49,Default,,0,0,0,,Ахаха...кейде
Dialogue: 0,0:15:13.74,0:15:15.91,Default,,0,0,0,,Я~
Dialogue: 0,0:15:17.37,0:15:18.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:18.66,0:15:19.71,Default,,0,0,0,,Ах
Dialogue: 0,0:15:19.79,0:15:23.38,Default,,0,0,0,,А-а, мен сені әдеттегіден басқаша деп ойладым!
Dialogue: 0,0:15:23.46,0:15:24.84,Default,,0,0,0,,... иә?
Dialogue: 0,0:15:24.92,0:15:28.42,Default,,0,0,0,,Сондықтан менің макияжым түсіп кетті!
Dialogue: 0,0:15:28.51,0:15:32.01,Default,,0,0,0,,Мен ештеңе айтқан жоқпын, ештеңе ойламадым.
Dialogue: 0,0:15:32.34,0:15:34.89,Default,,0,0,0,,Хмм... Мен алмаймын.
Dialogue: 0,0:15:34.97,0:15:39.18,Default,,0,0,0,,Олай болса, сіз әдеттегіден басқа бетті көресіз⸺
Dialogue: 0,0:15:39.27,0:15:41.06,Default,,0,0,0,,Маған сусын сатып аласың ба?
Dialogue: 0,0:15:41.14,0:15:42.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:42.56,0:15:45.19,Default,,0,0,0,,Ах... онда өтінемін.
Dialogue: 0,0:15:45.27,0:15:47.40,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:15:47.48,0:15:49.24,Default,,0,0,0,,(Изуку) Қвиркің болмаса да батыр бола аласың ба?
Dialogue: 0,0:15:52.16,0:15:53.41,Default,,0,0,0,,Фу…
Dialogue: 0,0:15:57.41,0:15:59.04,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:59.91,0:16:01.41,Default,,0,0,0,,Ал, бәріңе.
Dialogue: 0,0:16:01.79,0:16:05.00,Default,,0,0,0,,Алмасу матчынан кейін мен қазір 5-орындамын⸺
Dialogue: 0,0:16:05.09,0:16:07.13,Default,,0,0,0,,Біз Чиба Мотор ұлдарымыз⸺
Dialogue: 0,0:16:07.21,0:16:10.42,Default,,0,0,0,,Бұл бір орында тұрудың уақыты емес.
Dialogue: 0,0:16:10.63,0:16:12.38,Default,,0,0,0,,Бүгінгі жеңіске тірек⸺
Dialogue: 0,0:16:12.47,0:16:16.68,Default,,0,0,0,,Көшбасшы Стикстен 6 ойын айырмашылығы бар, ол міндетті түрде айналады, солай ма?
Dialogue: 0,0:16:16.76,0:16:18.85,Default,,0,0,0,,Мен әлі де сөйлеуді жақсы көремін.
Dialogue: 0,0:16:18.93,0:16:20.89,Default,,0,0,0,,Әй, менің даусым өте төмен!
Dialogue: 0,0:16:20.98,0:16:22.64,Default,,0,0,0,,Сіз болашақта саясаткерсіз бе?
Dialogue: 0,0:16:23.19,0:16:27.27,Default,,0,0,0,,Бүгін менің қызым...Киса-санның туған күні, Мицуи-сан⸺
Dialogue: 0,0:16:27.36,0:16:29.28,Default,,0,0,0,,Жеңімпаз құмыра болайық!
Dialogue: 0,0:16:30.78,0:16:34.57,Default,,0,0,0,,Шишио, сен дәл қазір менімен араласып тұрсың!
Dialogue: 0,0:16:34.66,0:16:36.57,Default,,0,0,0,,Ол жігіт көп жұмыс істеуі керек.
Dialogue: 0,0:16:36.66,0:16:38.37,Default,,0,0,0,,Ах... ха
Dialogue: 0,0:16:39.29,0:16:42.08,Default,,0,0,0,,Осы жолы да қатты соғып жүрейік!
Dialogue: 0,0:16:42.16,0:16:44.42,Default,,0,0,0,,О!
Dialogue: 0,0:16:44.50,0:16:48.50,Default,,0,0,0,,Иә, иә, ойыншылар қатты қызған.
Dialogue: 0,0:16:49.46,0:16:53.13,Default,,0,0,0,,Соған қарамастан жаңбыр күшейіп барады.
Dialogue: 0,0:16:53.68,0:16:54.68,Default,,0,0,0,,Ах
Dialogue: 0,0:16:56.72,0:17:00.22,Default,,0,0,0,,Әділқазылар алқасы жиналды. Мен күтпеген едім...
Dialogue: 0,0:17:00.56,0:17:01.77,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:17:06.02,0:17:07.86,Default,,0,0,0,,Біз сізге хабарлаймыз
Dialogue: 0,0:17:08.36,0:17:13.24,Default,,0,0,0,,Сіз көріп отырған ауа райы жағдайына байланысты ойын уақытша тоқтатылады.
Dialogue: 0,0:17:13.32,0:17:16.16,Default,,0,0,0,,Неліктен? Сіз жасай аласыз!
Dialogue: 0,0:17:16.66,0:17:19.41,Default,,0,0,0,,Чикусо! Жақсы ағын тоқтайды!
Dialogue: 0,0:17:19.49,0:17:22.79,Default,,0,0,0,,Ойын ойнауды тоқтатыңыз!
Dialogue: 0,0:17:31.21,0:17:35.63,Default,,0,0,0,,Күн суық, шашым түсіп жатыр, үйге барғым келеді
Dialogue: 0,0:17:35.97,0:17:37.51,Default,,0,0,0,,Ең нашар
Dialogue: 0,0:17:37.59,0:17:39.55,Default,,0,0,0,,Ол келмеді.
Dialogue: 0,0:17:39.64,0:17:40.85,Default,,0,0,0,,Бір рет залда⸺
Dialogue: 0,0:17:40.93,0:17:43.60,Default,,0,0,0,,Жаңбырдан пана алғың келе ме?
Dialogue: 0,0:17:43.81,0:17:46.10,Default,,0,0,0,,Мен оны жек көремін, өйткені ол жерде адам көп.
Dialogue: 0,0:17:46.19,0:17:48.06,Default,,0,0,0,,Маған не енгізгендерін ешкім білмейді.
Dialogue: 0,0:17:48.31,0:17:50.27,Default,,0,0,0,,Жаңбыр өлсе екен
Dialogue: 0,0:17:50.36,0:17:51.86,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:17:51.94,0:17:53.53,Default,,0,0,0,,Иә? Апыр-ай!
Dialogue: 0,0:17:53.61,0:17:57.74,Default,,0,0,0,,Мен де жаңбырдан сыра сата алмадым.
Dialogue: 0,0:17:57.82,0:18:00.41,Default,,0,0,0,,Қазір менде алу, келу және қайтару нұсқаулары бар.
Dialogue: 0,0:18:00.62,0:18:01.62,Default,,0,0,0,,Да... кім?
Dialogue: 0,0:18:01.70,0:18:05.25,Default,,0,0,0,,Қасынан өтіп бара жатқан дымқыл сатушы.
Dialogue: 0,0:18:05.83,0:18:08.04,Default,,0,0,0,,Менің айтайын дегенім, бұл не істеп жатыр деп ойлаймын.
Dialogue: 0,0:18:08.12,0:18:09.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:09.83,0:18:13.55,Default,,0,0,0,,Пластмасса жайып, пикникке барғыңыз келе ме?
Dialogue: 0,0:18:13.63,0:18:16.59,Default,,0,0,0,,Мен білмеймін, бұл дұрыс емес.
Dialogue: 0,0:18:17.01,0:18:20.05,Default,,0,0,0,,Бұл топырақтың одан әрі лайлануын болдырмау үшін⸺
Dialogue: 0,0:18:20.14,0:18:21.64,Default,,0,0,0,,Ол ілулі.
Dialogue: 0,0:18:21.72,0:18:23.31,Default,,0,0,0,,Я~
Dialogue: 0,0:18:24.39,0:18:26.60,Default,,0,0,0,,Аа, Санширо шықты.
Dialogue: 0,0:18:26.68,0:18:27.77,Default,,0,0,0,,Санширо!
Dialogue: 0,0:18:33.36,0:18:34.82,Default,,0,0,0,,Қандай кішкентай қолшатыр!
Dialogue: 0,0:18:34.90,0:18:36.11,Default,,0,0,0,,(аудитория күлкі)
Dialogue: 0,0:18:36.32,0:18:38.91,Default,,0,0,0,,Сенің де әзіл-оспақ барына сене алар емеспін, Санширо.
Dialogue: 0,0:18:38.91,0:18:40.32,Default,,0,0,0,,Сенің де әзіл-оспақ барына сене алар емеспін, Санширо.
Dialogue: 0,0:18:38.91,0:18:40.32,Default,,0,0,0,,(Көңіл көтеру тобының өнері)
Dialogue: 0,0:18:40.32,0:18:41.57,Default,,0,0,0,,(Қуаныш тобының өнері)
Dialogue: 0,0:18:41.57,0:18:42.58,Default,,0,0,0,,(Қуаныш тобының өнері)
Dialogue: 0,0:18:41.57,0:18:42.58,Default,,0,0,0,,Ах
Dialogue: 0,0:18:42.58,0:18:45.54,Default,,0,0,0,,(Қуаныш тобының өнері)
Dialogue: 0,0:18:46.00,0:18:49.12,Default,,0,0,0,,Бұл ескі ойыншыларға арналған көңіл көтеру әні.
Dialogue: 0,0:18:49.21,0:18:54.21,Default,,0,0,0,,Ойыншылар мен жанкүйерлердің көңіл-күйлерін жоғалтпау үшін біз мұны жаңбырлы ауа-райының тоқтатылуы кезінде жиі жасаймыз.
Dialogue: 0,0:18:54.42,0:18:56.42,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:18:56.51,0:18:59.13,Default,,0,0,0,,Жаңбырда музыкалық аспаптарда ойнауға бола ма?
Dialogue: 0,0:18:59.22,0:19:00.22,Default,,0,0,0,,Га
Dialogue: 0,0:19:06.22,0:19:08.27,Default,,0,0,0,,Сондықтан мені қызықтырмайды.
Dialogue: 0,0:19:09.69,0:19:14.27,Default,,0,0,0,,Мен бұл стадионды жақсы көремін.
Dialogue: 0,0:19:14.36,0:19:16.07,Default,,0,0,0,,Не? (Мегуми) Ах...
Dialogue: 0,0:19:16.15,0:19:18.74,Default,,0,0,0,,Мен бұл туралы әсіресе жаңбырлы күндері ойлаймын.
Dialogue: 0,0:19:18.82,0:19:21.11,Default,,0,0,0,,Тек төбелесіп жатқан ойыншылар ғана емес
Dialogue: 0,0:19:21.36,0:19:25.08,Default,,0,0,0,,Өйткені мен барлығының аянбай еңбек етіп жатқанын анық көремін
Dialogue: 0,0:19:25.87,0:19:28.50,Default,,0,0,0,,Мен шынымен ризамын.
Dialogue: 0,0:19:32.17,0:19:35.13,Default,,0,0,0,,Ууууууууууу~
Dialogue: 0,0:19:35.21,0:19:38.26,Default,,0,0,0,,Мен сыраны сата алмаймын деп шағымданғанда⸺
Dialogue: 0,0:19:38.34,0:19:39.84,Default,,0,0,0,,Барлығы керемет~
Dialogue: 0,0:19:39.92,0:19:42.18,Default,,0,0,0,,Ха, сен не айтып тұрсың?
Dialogue: 0,0:19:42.26,0:19:44.51,Default,,0,0,0,,Әрине, сатушы солардың бірі.
Dialogue: 0,0:19:44.60,0:19:45.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:46.43,0:19:47.56,Default,,0,0,0,,Хмм
Dialogue: 0,0:19:47.93,0:19:53.40,Default,,0,0,0,,Мен стадионда әдеттегіден басқа жүзді көрдім, Рейбе⸺
Dialogue: 0,0:19:53.48,0:19:56.23,Default,,0,0,0,,Сен де бізді кешіресің бе? Жаңбыр туралы
Dialogue: 0,0:19:57.36,0:19:59.44,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:59.53,0:20:01.28,Default,,0,0,0,,Не?
Dialogue: 0,0:20:01.36,0:20:03.62,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:20:04.82,0:20:08.08,Default,,0,0,0,,Хехе... Бұл ештеңе емес.
Dialogue: 0,0:20:09.41,0:20:12.08,Default,,0,0,0,,Олай болса, келесі жолы күн ашық болғанда.
Dialogue: 0,0:20:12.17,0:20:15.42,Default,,0,0,0,,Сонда әкем маған сыра сатып береді.
Dialogue: 0,0:20:16.71,0:20:19.17,Default,,0,0,0,,Сәлем? Хахаха...
Dialogue: 0,0:20:26.60,0:20:29.85,Default,,0,0,0,,Әдеттегіден басқа бет... иә?
Dialogue: 0,0:20:33.23,0:20:36.73,Default,,0,0,0,,Каа! Қазірдің өзінде! Тоқтата алмайсың ба!
Dialogue: 0,0:20:36.81,0:20:39.94,Default,,0,0,0,,Өтінемін! Өтінемін, тазалаңыз!
Dialogue: 0,0:20:40.19,0:20:43.03,Default,,0,0,0,,Шишио Зейінді жоғалтпаңыз
Dialogue: 0,0:20:43.11,0:20:44.16,Default,,0,0,0,,Уссу
Dialogue: 0,0:20:49.33,0:20:52.04,Default,,0,0,0,,Мм... Киса-сан
Dialogue: 0,0:20:52.62,0:20:54.54,Default,,0,0,0,,Киса-санға жеңіс!
Dialogue: 0,0:21:00.96,0:21:05.97,Default,,0,0,0,,Осы қымбат мерекеде маған сыйлық беруіңізді өтінемін!
Dialogue: 0,0:21:06.72,0:21:09.72,Default,,0,0,0,,Кууууууу... аа
Dialogue: 0,0:21:23.49,0:21:25.53,Default,,0,0,0,,Әй, қарашы, күн ашық!
Dialogue: 0,0:21:25.61,0:21:27.49,Default,,0,0,0,,Қайта бастауға болатын сияқты!
Dialogue: 0,0:21:27.57,0:21:30.33,Default,,0,0,0,,Жарайсыңдар! (Ичиномия) Міне!
Dialogue: 0,0:21:31.12,0:21:32.37,Default,,0,0,0,,Хмм.
Dialogue: 0,0:21:32.45,0:21:38.88,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:39.09,0:21:40.34,Default,,0,0,0,,Ой
Dialogue: 0,0:21:41.59,0:21:42.92,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:21:46.01,0:21:48.97,Default,,0,0,0,,Ауа-райына қуанып, күйзелу
Dialogue: 0,0:21:49.30,0:21:53.06,Default,,0,0,0,,Бұл сонымен қатар ашық стадиондардың ең жақсы бөлігі.
Dialogue: 0,0:21:58.56,0:22:01.65,Default,,0,0,0,,Матч аман-есен жалғасты⸺
Dialogue: 0,0:22:01.73,0:22:04.61,Default,,0,0,0,,Моторлы құмдар бастапқы өнімділікті сақтайды⸺
Dialogue: 0,0:22:04.69,0:22:06.95,Default,,0,0,0,,Бұл жеңіс болды.
Dialogue: 0,0:22:14.91,0:22:19.92,Default,,0,0,0,,♪～
Dialogue: 0,0:23:39.87,0:23:44.88,Default,,0,0,0,,～♪
