Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:06.00,Default,,0,0,0,,♪～
Dialogue: 0,0:01:22.08,0:01:27.08,Default,,0,0,0,,～♪
Dialogue: 0,0:01:34.01,0:01:36.26,Default,,0,0,0,,Кеше бір қадам қалды⸺
Dialogue: 0,0:01:36.34,0:01:39.55,Default,,0,0,0,,Мотор құмдарының Climax сериясына алғашқы қадамы⸺
Dialogue: 0,0:01:39.64,0:01:40.85,Default,,0,0,0,,Мен оны жеңе алмадым ...
Dialogue: 0,0:01:41.18,0:01:43.27,Default,,0,0,0,,Бүгін маусымның соңғы ойыны
Dialogue: 0,0:01:41.18,0:01:43.27,Default,,0,0,0,,(Руриконың жылағаны)
Dialogue: 0,0:01:43.27,0:01:43.35,Default,,0,0,0,,(Руриконың жылағаны)
Dialogue: 0,0:01:43.35,0:01:47.52,Default,,0,0,0,,(Руриконың жылағаны)
Dialogue: 0,0:01:43.35,0:01:47.52,Default,,0,0,0,,Ойымызды өзгертіп, күлімсіреп жасайық
Dialogue: 0,0:01:47.60,0:01:50.06,Default,,0,0,0,,Қанша уақыт жылап келесің?
Dialogue: 0,0:01:50.48,0:01:52.98,Default,,0,0,0,,Жоқ, мен жыламаймын.
Dialogue: 0,0:01:54.03,0:01:57.95,Default,,0,0,0,,Бірақ мұндай нәрсе... түнгі үзілістен кейін⸺
Dialogue: 0,0:01:58.45,0:02:02.99,Default,,0,0,0,,Менде өкініш бар... немесе айту керек пе...
Dialogue: 0,0:02:03.08,0:02:05.45,Default,,0,0,0,,Мен жыламаймын.
Dialogue: 0,0:02:05.54,0:02:07.12,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:02:07.12,0:02:09.12,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:02:07.12,0:02:09.12,Default,,0,0,0,,Рурико сонша жылап жатса⸺
Dialogue: 0,0:02:09.12,0:02:09.21,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:02:09.21,0:02:11.25,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:02:09.21,0:02:11.25,Default,,0,0,0,,Аонаға амандасу қиын.
Dialogue: 0,0:02:11.46,0:02:12.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:12.92,0:02:15.46,Default,,0,0,0,,Не, Аона-санның сәлемі...
Dialogue: 0,0:02:16.09,0:02:17.17,Default,,0,0,0,,Хехе
Dialogue: 0,0:02:17.38,0:02:19.13,Default,,0,0,0,,Мұғалімнің жұмысқа орналасу емтиханы⸺
Dialogue: 0,0:02:19.22,0:02:20.64,Default,,0,0,0,,Мен қабылдандым!
Dialogue: 0,0:02:20.72,0:02:22.26,Default,,0,0,0,,Уау! (Сатушы) Бұл керемет!
Dialogue: 0,0:02:22.35,0:02:23.35,Default,,0,0,0,,Жылдамдық көрсетілсе, тере аласың ба?
Dialogue: 0,0:02:23.43,0:02:26.73,Default,,0,0,0,,Бұл құттықтау, бірақ...
Dialogue: 0,0:02:26.93,0:02:29.23,Default,,0,0,0,,Иә, осы маусымда...
Dialogue: 0,0:02:29.31,0:02:33.11,Default,,0,0,0,,Сонымен, бүгін мен сатушы қызметінен зейнеткерлікке шығамын.
Dialogue: 0,0:02:33.19,0:02:37.03,Default,,0,0,0,,Өткен төрт жыл үшін барлығыңызға рахмет.
Dialogue: 0,0:02:37.36,0:02:39.24,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:02:39.32,0:02:40.57,Default,,0,0,0,,Аона-сан!
Dialogue: 0,0:02:40.66,0:02:45.08,Default,,0,0,0,,Жоқ, жоқ, Сара, мен ойнауға келе жатырмын.
Dialogue: 0,0:02:45.16,0:02:46.87,Default,,0,0,0,,Құттықтаймыз Аона
Dialogue: 0,0:02:45.16,0:02:46.87,Default,,0,0,0,,(Сараның жылағаны)
Dialogue: 0,0:02:46.87,0:02:46.95,Default,,0,0,0,,(Сараның жылағаны)
Dialogue: 0,0:02:46.95,0:02:51.58,Default,,0,0,0,,(Сараның жылағаны)
Dialogue: 0,0:02:46.95,0:02:51.58,Default,,0,0,0,,Иә, сіз де жүрегіңізде бар жақсылықты жасаңыз. Мен сені сүйем.
Dialogue: 0,0:02:52.29,0:02:54.55,Default,,0,0,0,,Жарайсың Аона
Dialogue: 0,0:02:55.30,0:02:58.88,Default,,0,0,0,,Кохината-сан, көмегіңіз үшін көп рахмет.
Dialogue: 0,0:02:58.97,0:03:00.18,Default,,0,0,0,,А, а... а
Dialogue: 0,0:03:00.26,0:03:03.43,Default,,0,0,0,,Аона-сан!
Dialogue: 0,0:03:03.51,0:03:05.47,Default,,0,0,0,,Сәлем Рурико
Dialogue: 0,0:03:05.56,0:03:07.93,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:03:08.02,0:03:11.27,Default,,0,0,0,,Сондай-ақ~ Сіз жай ғана жылауықсыз.
Dialogue: 0,0:03:11.73,0:03:17.15,Default,,0,0,0,,Бұл колледж студентінің сатушысының тағдыры, бірақ оқуды бітіргеннен кейін бұл әлі де қайғылы.
Dialogue: 0,0:03:17.23,0:03:19.40,Default,,0,0,0,,Бүгін менің де соңғы күнім⸺
Dialogue: 0,0:03:19.49,0:03:21.61,Default,,0,0,0,,Сөйлесуді бастаңыз
Dialogue: 0,0:03:22.28,0:03:23.66,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:03:25.33,0:03:27.70,Default,,0,0,0,,Жарайды, барлығы жиналды.
Dialogue: 0,0:03:28.08,0:03:32.17,Default,,0,0,0,,Ең алдымен, бірде-бір адамның мұңайып келгенін мақтағым келеді.
Dialogue: 0,0:03:32.58,0:03:37.13,Default,,0,0,0,,Бүгінгідей матч қоғамда сөндіретін матч деп айтылады⸺
Dialogue: 0,0:03:37.55,0:03:41.97,Default,,0,0,0,,Мен бұл көңілсіз сезімді оңай сіңіре алмаймын.
Dialogue: 0,0:03:42.18,0:03:44.18,Default,,0,0,0,,Күй, күй, күйіп кет⸺
Dialogue: 0,0:03:44.26,0:03:47.56,Default,,0,0,0,,Келесі маусымда ұшқын сөніп қалмасын!
Dialogue: 0,0:03:47.85,0:03:50.64,Default,,0,0,0,,Қазіргі соққың мүлде уақытынан тыс, аянышты болды!
Dialogue: 0,0:03:51.89,0:03:52.90,Default,,0,0,0,,Иә
Dialogue: 0,0:03:53.23,0:03:54.31,Default,,0,0,0,,Директор
Dialogue: 0,0:03:54.40,0:03:58.61,Default,,0,0,0,,PR камерасы туралы әрқашан хабардар болғаныңыз үшін рахмет.
Dialogue: 0,0:04:01.74,0:04:04.82,Default,,0,0,0,,Бұл маусым ерекше маусым болды.
Dialogue: 0,0:04:05.07,0:04:10.00,Default,,0,0,0,,Мен CS-ге барамын деп армандадым және бұл өте қызықты болды.
Dialogue: 0,0:04:10.25,0:04:11.87,Default,,0,0,0,,Ең бастысы...
Dialogue: 0,0:04:11.96,0:04:12.96,Default,,0,0,0,,Хмм
Dialogue: 0,0:04:13.17,0:04:14.17,Default,,0,0,0,,О~
Dialogue: 0,0:04:14.25,0:04:17.67,Default,,0,0,0,,Жігіт сыра алғысы келетін сияқты.
Dialogue: 0,0:04:17.88,0:04:20.21,Default,,0,0,0,,Уау... Рурико-сан!
Dialogue: 0,0:04:20.30,0:04:23.09,Default,,0,0,0,,Хмм? Неге сонша толқып тұрсың?
Dialogue: 0,0:04:23.18,0:04:26.18,Default,,0,0,0,,Мүмкін сен мен туралы ойлаған шығарсың?
Dialogue: 0,0:04:26.26,0:04:28.51,Default,,0,0,0,,Жоқ, жоқ... болды.
Dialogue: 0,0:04:29.22,0:04:30.60,Default,,0,0,0,,Иә 700 иен
Dialogue: 0,0:04:30.68,0:04:33.64,Default,,0,0,0,,Енді ол автоматты түрде шығады
Dialogue: 0,0:04:35.56,0:04:39.27,Default,,0,0,0,,Аа, маусым бүгін аяқталады ма?
Dialogue: 0,0:04:39.36,0:04:41.19,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:04:41.28,0:04:44.99,Default,,0,0,0,,Сатушылар да келесі көктемге дейін жабылады.
Dialogue: 0,0:04:49.20,0:04:51.04,Default,,0,0,0,,Тек спортшылар емес⸺
Dialogue: 0,0:04:51.12,0:04:54.83,Default,,0,0,0,,Стадионда жұмыс істегендердің барлығына рахмет...
Dialogue: 0,0:04:54.92,0:04:57.25,Default,,0,0,0,,Хмм...хехехе
Dialogue: 0,0:04:57.54,0:05:00.05,Default,,0,0,0,,Әй, маған мақтау айтшы.
Dialogue: 0,0:05:00.13,0:05:02.01,Default,,0,0,0,,Оңай~ (Мұрата) Ах!
Dialogue: 0,0:05:02.09,0:05:03.09,Default,,0,0,0,,Ах
Dialogue: 0,0:05:03.30,0:05:05.93,Default,,0,0,0,,Пухат Момо... Тағы бір сусын
Dialogue: 0,0:05:06.14,0:05:08.89,Default,,0,0,0,,Әй, кеттік ағайын.
Dialogue: 0,0:05:10.60,0:05:11.60,Default,,0,0,0,,Иә
Dialogue: 0,0:05:12.06,0:05:14.23,Default,,0,0,0,,Жарайды, тамаша тепе-теңдік.
Dialogue: 0,0:05:14.31,0:05:15.31,Default,,0,0,0,,Ах
Dialogue: 0,0:05:18.23,0:05:20.48,Default,,0,0,0,,Ей, маған бос тостағаныңды қарызға бер.
Dialogue: 0,0:05:20.57,0:05:23.78,Default,,0,0,0,,Иә? иә? Бұл... осы ма?
Dialogue: 0,0:05:27.28,0:05:28.28,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:28.87,0:05:30.49,Default,,0,0,0,,(ДжоДжо) Мен ең жоғарғысынан ең төменгісіне дейін әрбір картаны атай аламын
Dialogue: 0,0:05:30.58,0:05:31.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:31.70,0:05:34.75,Default,,0,0,0,,Енді бәріміз қосылып ән айтыңдар!
Dialogue: 0,0:05:34.83,0:05:36.33,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:05:37.33,0:05:39.13,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:05:40.84,0:05:42.84,Default,,0,0,0,,О, не?
Dialogue: 0,0:05:42.92,0:05:44.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:44.63,0:05:48.34,Default,,0,0,0,,Ағаңыз да осы маусымда сізді қолдап, жақсы жұмыс жасады.
Dialogue: 0,0:05:48.43,0:05:49.64,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,0:05:51.64,0:05:52.72,Default,,0,0,0,,Хехе
Dialogue: 0,0:05:56.14,0:05:59.35,Default,,0,0,0,,Кеше қызым маған үлкен қамқорлық жасады.
Dialogue: 0,0:05:59.44,0:06:02.32,Default,,0,0,0,,Мен де ұзақ уақыт бойы Motor Sands жанкүйерімін.
Dialogue: 0,0:06:02.40,0:06:05.40,Default,,0,0,0,,Көңіл көтеретін ескі әндер әлі есімде.
Dialogue: 0,0:06:05.49,0:06:08.03,Default,,0,0,0,,Маған әсіресе Джорданның әндері ұнайды.
Dialogue: 0,0:06:08.11,0:06:09.66,Default,,0,0,0,,Ә... Әке!
Dialogue: 0,0:06:09.74,0:06:11.87,Default,,0,0,0,,А, бұл сыйлық.
Dialogue: 0,0:06:14.20,0:06:16.91,Default,,0,0,0,,Эй, Motor Sands сатушылары туралы мақала бар⸺
Dialogue: 0,0:06:17.00,0:06:18.54,Default,,0,0,0,,Бұл трендте
Dialogue: 0,0:06:18.62,0:06:20.50,Default,,0,0,0,,Хо Доре Доре
Dialogue: 0,0:06:21.42,0:06:23.46,Default,,0,0,0,,Я… Ямада
Dialogue: 0,0:06:23.67,0:06:28.34,Default,,0,0,0,,Келесі маусымда сен де менің үйімде жұмыс істейсің...
Dialogue: 0,0:06:28.55,0:06:30.39,Default,,0,0,0,,Иә, әрине.
Dialogue: 0,0:06:31.18,0:06:34.81,Default,,0,0,0,,Ал... Түсіндім, рахмет.
Dialogue: 0,0:06:35.02,0:06:37.10,Default,,0,0,0,,Біз енді ешқашан кездеспейміз.
Dialogue: 0,0:06:37.18,0:06:39.94,Default,,0,0,0,,Келесі жылы жұмысқа белдемше киіп барайық
Dialogue: 0,0:06:41.06,0:06:44.40,Default,,0,0,0,,Мотор Сэндстің осы маусымдағы ресми ойындары⸺
Dialogue: 0,0:06:44.48,0:06:48.28,Default,,0,0,0,,Барлық кесте бүгін аяқталады.
Dialogue: 0,0:06:48.36,0:06:50.86,Default,,0,0,0,,А... мен Чибаны жақсы көремін~!
Dialogue: 0,0:06:51.87,0:06:56.50,Default,,0,0,0,,Осы маусымда да қызу қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:06:56.70,0:06:58.50,Default,,0,0,0,,Барлық мотор құмдары⸺
Dialogue: 0,0:06:58.79,0:07:01.29,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:07:03.96,0:07:04.96,Default,,0,0,0,,Хехе
Dialogue: 0,0:07:07.80,0:07:11.93,Default,,0,0,0,,Барлық 143 ойын қызу өтті.
Dialogue: 0,0:07:13.10,0:07:17.14,Default,,0,0,0,,Келіңіздер, ашылуына 176 күн қалды!
Dialogue: 0,0:07:18.85,0:07:21.73,Default,,0,0,0,,Оңтүстік Италиядағы Неаполис қаласы.
Dialogue: 0,0:07:21.81,0:07:23.15,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:07:23.23,0:07:27.19,Default,,0,0,0,,А, бұл келесі маусымға сатушыларды тарту туралы.
Dialogue: 0,0:07:27.28,0:07:30.95,Default,,0,0,0,,Иә, өтініш беріңіз.
Dialogue: 0,0:07:31.24,0:07:34.41,Default,,0,0,0,,Иә? Қызғылт шаш?
Dialogue: 0,0:07:34.87,0:07:38.75,Default,,0,0,0,,А-а... Біздің ереже бойынша...
Dialogue: 0,0:07:40.25,0:07:42.00,Default,,0,0,0,,Chiss!
Dialogue: 0,0:07:42.08,0:07:43.08,Default,,0,0,0,,Хехе
Dialogue: 0,0:07:43.50,0:07:46.55,Default,,0,0,0,,Достарыңызбен және клиенттеріңізбен бірге жылап, күле алсаңыз⸺
Dialogue: 0,0:07:46.63,0:07:49.01,Default,,0,0,0,,Одан басқа сұрақтар қойылмайды.
Dialogue: 0,0:07:51.93,0:07:56.18,Default,,0,0,0,,Келесі маусымда бізге тағы бір қызықты бала қосылатын сияқты.
Dialogue: 0,0:07:57.01,0:07:58.85,Default,,0,0,0,,Сондықтан⸺
Dialogue: 0,0:07:59.06,0:08:03.10,Default,,0,0,0,,Аонаның сатушы зейнеткерлік сапарының баратын жері қайда?
Dialogue: 0,0:08:03.19,0:08:06.02,Default,,0,0,0,,Біз Гавайи жұмағы туралы шешім қабылдадық!
Dialogue: 0,0:08:06.11,0:08:07.77,Default,,0,0,0,,Бұл – тура қызыл карта. (Бакуго) Тс.
Dialogue: 0,0:08:07.86,0:08:09.69,Default,,0,0,0,,(үшін қолдайды)
Dialogue: 0,0:08:09.78,0:08:13.49,Default,,0,0,0,,Бұл менің бірінші рет түнгі сапарға шығуым.
Dialogue: 0,0:08:13.57,0:08:16.58,Default,,0,0,0,,Әке мен шешені көндіру керек.
Dialogue: 0,0:08:16.78,0:08:19.49,Default,,0,0,0,,Менің купальник сатып алғаныма неше жыл болды?
Dialogue: 0,0:08:19.58,0:08:20.62,Default,,0,0,0,,Хехе
Dialogue: 0,0:08:20.70,0:08:23.04,Default,,0,0,0,,Уф... уф, Рурико?
Dialogue: 0,0:08:23.50,0:08:25.46,Default,,0,0,0,,Бұл жолы неге жылайсың?
Dialogue: 0,0:08:25.54,0:08:28.92,Default,,0,0,0,,Мен жалғыз әрі бақытты едім⸺
Dialogue: 0,0:08:29.00,0:08:31.92,Default,,0,0,0,,Мен шынымен түсінбеймін!
Dialogue: 0,0:08:32.01,0:08:32.63,Default,,0,0,0,,(Руриконың айқайы)
Dialogue: 0,0:08:32.63,0:08:35.97,Default,,0,0,0,,(Руриконың айқайы)
Dialogue: 0,0:08:32.63,0:08:35.97,Default,,0,0,0,,Әй... сен қанша жылайсың?
Dialogue: 0,0:08:46.52,0:08:48.77,Default,,0,0,0,,үшінңыз, биыл да CS-ке барыңыз⸺
Dialogue: 0,0:08:48.86,0:08:50.86,Default,,0,0,0,,Кешіріңіз, мен сізді өзіммен бірге ала алмадым.
Dialogue: 0,0:08:50.94,0:08:52.74,Default,,0,0,0,,Мұның бәрі менің жауапкершілігім.
Dialogue: 0,0:08:52.82,0:08:55.61,Default,,0,0,0,,Әй, директор, басыңызды көтеріңіз.
Dialogue: 0,0:08:55.70,0:08:57.28,Default,,0,0,0,,Бұл әркімнің міндеті
Dialogue: 0,0:08:57.74,0:09:00.49,Default,,0,0,0,,Ойыншылар тамаша жұмыс жасады.
Dialogue: 0,0:09:00.74,0:09:01.75,Default,,0,0,0,,Біз оның жайлы өте аз білеміз… Бұл не, мырза Ринатаки?
Dialogue: 0,0:09:01.83,0:09:04.41,Default,,0,0,0,,Біз шынымен жақсы командаға айналдық.
Dialogue: 0,0:09:04.67,0:09:09.88,Default,,0,0,0,,Мен келесі маусымда бірде-бір адамды жібермей осы мүшелермен жарысқым келеді.
Dialogue: 0,0:09:10.34,0:09:14.22,Default,,0,0,0,,Бұл дүниеде жұмыс істемейді.
Dialogue: 0,0:09:15.43,0:09:19.26,Default,,0,0,0,,Келіңіздер, байыпты болып, келесі маусым туралы сөйлесейік.
Dialogue: 0,0:09:19.47,0:09:22.64,Default,,0,0,0,,Сонымен... Алдымен стратегия жобасына тоқталайық⸺
Dialogue: 0,0:09:22.72,0:09:24.64,Default,,0,0,0,,Менен, скаут директоры...
Dialogue: 0,0:09:24.73,0:09:26.90,Default,,0,0,0,,О, жоқ, жоқ (Скаут менеджері) Иә?
Dialogue: 0,0:09:26.98,0:09:29.82,Default,,0,0,0,,Біріншіден, менің айтарым бар.
Dialogue: 0,0:09:30.19,0:09:34.57,Default,,0,0,0,,Шын мәнінде, қазіргі уақытта бір адам командадан кетуге шешім қабылдады.
Dialogue: 0,0:09:39.32,0:09:43.66,Default,,0,0,0,,Мен осы маусымнан кейін директор қызметінен кетуді шештім.
Dialogue: 0,0:09:43.75,0:09:46.04,Default,,0,0,0,,Не? Әлде... директор?
Dialogue: 0,0:09:46.12,0:09:48.63,Default,,0,0,0,,Шынымен...? Ах...
Dialogue: 0,0:09:49.00,0:09:50.79,Default,,0,0,0,,үшін маған қамқорлық жасады.
Dialogue: 0,0:09:50.88,0:09:52.59,Default,,0,0,0,,(шу)
Dialogue: 0,0:09:52.67,0:09:53.92,Default,,0,0,0,,Әй... Мені итерме, ақымақ.
Dialogue: 0,0:09:54.01,0:09:55.01,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:55.26,0:09:56.93,Default,,0,0,0,,Даа! Бұл өтірік, директор!
Dialogue: 0,0:09:57.01,0:09:59.34,Default,,0,0,0,,Қадағалау! Өтінемін, бас тартпаңыз!
Dialogue: 0,0:09:59.43,0:10:01.18,Default,,0,0,0,,Бір қадам қалды!
Dialogue: 0,0:10:01.72,0:10:02.76,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:10:04.02,0:10:08.02,Default,,0,0,0,,Мотор құмындағы тәсілдер өзгерту уақыты
Dialogue: 0,0:10:09.94,0:10:12.36,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:10:12.44,0:10:14.44,Default,,0,0,0,,Қызыл-Ақ шайқасты асыға күту
Dialogue: 0,0:10:14.53,0:10:15.82,Default,,0,0,0,,Әй, жаттығу ауқымы да⸺
Dialogue: 0,0:10:15.90,0:10:16.90,Default,,0,0,0,,Сіз экскурсия жасай аласыз.
Dialogue: 0,0:10:16.99,0:10:18.95,Default,,0,0,0,,Мен көп суретке түсіремін!
Dialogue: 0,0:10:22.20,0:10:24.20,Default,,0,0,0,,Брайан Секи Жақсы көрінеді.
Dialogue: 0,0:10:24.29,0:10:25.29,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:10:25.37,0:10:29.04,Default,,0,0,0,,Нокояма да, Каваматсу да керемет~
Dialogue: 0,0:10:29.12,0:10:30.63,Default,,0,0,0,,Уа (Каваматсу/Нокояма) Уа
Dialogue: 0,0:10:30.71,0:10:34.00,Default,,0,0,0,,Ой~ Сүйкімділер де бар.
Dialogue: 0,0:10:34.09,0:10:36.47,Default,,0,0,0,,Сен, бірге суретке түсейік
Dialogue: 0,0:10:36.55,0:10:40.34,Default,,0,0,0,,Жоқ... неге менің костюмім сыра сатушысы?
Dialogue: 0,0:10:40.43,0:10:42.35,Default,,0,0,0,,Бірақ сіз оны жақсы киіп жүрсіз.
Dialogue: 0,0:10:42.43,0:10:44.06,Default,,0,0,0,,Маған көмектес! Маған үйлен!
Dialogue: 0,0:10:44.14,0:10:46.14,Default,,0,0,0,,Саған жарасады, Коу.
Dialogue: 0,0:10:46.22,0:10:48.77,Default,,0,0,0,,Мен кем дегенде бір кесе сата алатын шығармын.
Dialogue: 0,0:10:48.85,0:10:49.90,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:49.98,0:10:52.11,Default,,0,0,0,,Жоспарлаушы кім?
Dialogue: 0,0:10:52.40,0:10:53.40,Default,,0,0,0,,Ах
Dialogue: 0,0:10:55.28,0:10:57.07,Default,,0,0,0,,Олай айтпа, Ичиномия.
Dialogue: 0,0:10:57.15,0:10:59.40,Default,,0,0,0,,Иә? (Ягино) Кәсіби бейсболшы⸺
Dialogue: 0,0:10:59.49,0:11:01.66,Default,,0,0,0,,Ең жақсы көңіл көтеруші
Dialogue: 0,0:11:02.07,0:11:04.41,Default,,0,0,0,,Ягино маскасы осында!
Dialogue: 0,0:11:04.62,0:11:07.58,Default,,0,0,0,,Жоғары шиеленіс... Ягино мырза
Dialogue: 0,0:11:07.66,0:11:09.79,Default,,0,0,0,,Ол фестиваль жігіті, солай ма?
Dialogue: 0,0:11:09.87,0:11:13.21,Default,,0,0,0,,Жоқ! Мен Ягино Маскамын!
Dialogue: 0,0:11:13.29,0:11:14.42,Default,,0,0,0,,Я...
Dialogue: 0,0:11:14.50,0:11:17.55,Default,,0,0,0,,Бұл маска шынымен ыстық.
Dialogue: 0,0:11:17.63,0:11:19.80,Default,,0,0,0,,Хаха, мен тұншығып тұрмын.
Dialogue: 0,0:11:19.88,0:11:23.26,Default,,0,0,0,,Ягино Ол шынымен де сондай жарқын болды ма?
Dialogue: 0,0:11:23.35,0:11:25.14,Default,,0,0,0,,О
Dialogue: 0,0:11:25.51,0:11:27.68,Default,,0,0,0,,Біз барғалы жатырмыз.
Dialogue: 0,0:11:28.52,0:11:30.69,Default,,0,0,0,,(Сыныптасы) Әй, осындай жалғыздыққа толы сөздер айтпашы.
Dialogue: 0,0:11:30.77,0:11:31.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:32.56,0:11:37.07,Default,,0,0,0,,Ха... Әдемі топқа арнайы квота бар.
Dialogue: 0,0:11:37.15,0:11:38.44,Default,,0,0,0,,Ах~
Dialogue: 0,0:11:38.53,0:11:43.24,Default,,0,0,0,,(Әйелдердің қошеметі)
Dialogue: 0,0:11:43.49,0:11:47.12,Default,,0,0,0,,Енді тәтті маскалы екеуіңнен сұрайық.
Dialogue: 0,0:11:47.20,0:11:51.08,Default,,0,0,0,,Екеуіңізге дәл қандай әйел ұнайды?
Dialogue: 0,0:11:51.16,0:11:53.17,Default,,0,0,0,,Біріншіден, Сишио мырза, өтінемін.
Dialogue: 0,0:11:53.46,0:11:56.75,Default,,0,0,0,,Мен... Мен мейірімді адамдарды жақсы көремін.
Dialogue: 0,0:11:56.84,0:12:00.13,Default,,0,0,0,,Хмм, үлгі жауабын алдым!
Dialogue: 0,0:12:00.22,0:12:01.97,Default,,0,0,0,,Хаха... Кешіріңіз.
Dialogue: 0,0:12:02.22,0:12:04.39,Default,,0,0,0,,Енді, Ногияма мырза.
Dialogue: 0,0:12:04.47,0:12:07.35,Default,,0,0,0,,Мүмкіндігінше нақты болыңыз
Dialogue: 0,0:12:07.76,0:12:10.06,Default,,0,0,0,,Ал...
Dialogue: 0,0:12:10.14,0:12:11.73,Default,,0,0,0,,Егер мен айту керек болсам⸺
Dialogue: 0,0:12:12.10,0:12:14.23,Default,,0,0,0,,Даусыңыз керемет.
Dialogue: 0,0:12:14.31,0:12:16.98,Default,,0,0,0,,Сондай-ақ, маған егде жастағы адамдар ұнауы мүмкін.
Dialogue: 0,0:12:17.07,0:12:18.73,Default,,0,0,0,,(Әйелдердің қошеметі)
Dialogue: 0,0:12:18.82,0:12:21.49,Default,,0,0,0,,Сіз қалай ойлайсыз, бәріңіз?
Dialogue: 0,0:12:21.57,0:12:23.45,Default,,0,0,0,,Сіз қобалжыдыңыз ба?
Dialogue: 0,0:12:23.53,0:12:24.57,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:24.66,0:12:27.78,Default,,0,0,0,,Леди Уорблер бәрінен де толқып тұр⸺
Dialogue: 0,0:12:27.87,0:12:31.00,Default,,0,0,0,,Нагиса Сато 35 жаста
Dialogue: 0,0:12:34.21,0:12:36.29,Default,,0,0,0,,Эй... Қош келдіңіз!
Dialogue: 0,0:12:36.59,0:12:39.80,Default,,0,0,0,,Дәл қазір құмыра Мицуи мен құмыра Нанами...
Dialogue: 0,0:12:39.88,0:12:43.51,Default,,0,0,0,,Дүкенде бенто жәшіктерін сатамыз!
Dialogue: 0,0:12:43.59,0:12:45.30,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:12:45.30,0:12:45.72,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:12:45.30,0:12:45.72,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:12:45.72,0:12:45.80,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:12:45.80,0:12:46.80,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:12:45.80,0:12:46.80,Default,,0,0,0,,Ах
Dialogue: 0,0:12:46.80,0:12:47.10,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:12:47.10,0:12:50.68,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:12:47.10,0:12:50.68,Default,,0,0,0,,Екеуің де жақсы жұмыс жасадыңдар! CS: Бұл дерлік болды.
Dialogue: 0,0:12:50.77,0:12:54.48,Default,,0,0,0,,Мицуи! Келесі маусымда екі таңбалы жеңістерге жетейік!
Dialogue: 0,0:12:54.56,0:12:58.06,Default,,0,0,0,,Нанами! Жанға толы шар, әсер қалдырды!
Dialogue: 0,0:12:58.52,0:13:00.61,Default,,0,0,0,,Бұл жеңіс емес, жеңіліс емес...
Dialogue: 0,0:13:00.69,0:13:03.45,Default,,0,0,0,,Мен келесі маусымда көбірек тырысамын.
Dialogue: 0,0:13:04.11,0:13:05.11,Default,,0,0,0,,Хехе
Dialogue: 0,0:13:06.41,0:13:09.53,Default,,0,0,0,,Иә? Жоқ, мен маска киген жоқпын.
Dialogue: 0,0:13:09.62,0:13:10.79,Default,,0,0,0,,Сіз қайда бардыңыз?
Dialogue: 0,0:13:10.87,0:13:14.04,Default,,0,0,0,,Не? Жоқ, мен оны біраз уақыттан бері кимедім.
Dialogue: 0,0:13:16.37,0:13:20.38,Default,,0,0,0,,Ал, Деннис, Жапонияда болғаныңызға рахмет.
Dialogue: 0,0:13:20.46,0:13:21.55,Default,,0,0,0,,Ганбаримасу
Dialogue: 0,0:13:21.63,0:13:24.84,Default,,0,0,0,,Брайан, келесі жылы да көп соққы беріңізші.
Dialogue: 0,0:13:24.93,0:13:26.59,Default,,0,0,0,,Осы қарқынмен, Хамон…
Dialogue: 0,0:13:27.22,0:13:29.85,Default,,0,0,0,,Үйге ерте оралмағаныңыз дұрыс болды, солай ма?
Dialogue: 0,0:13:29.93,0:13:30.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:31.01,0:13:33.60,Default,,0,0,0,,Мен тек көрікті жерлерді аралау үшін қалдым.
Dialogue: 0,0:13:39.69,0:13:44.11,Default,,0,0,0,,Өйткені, ойыншылар бейсбол ойнаған кезде ең белсенді.
Dialogue: 0,0:13:44.19,0:13:45.74,Default,,0,0,0,,Сенің де ағаң.
Dialogue: 0,0:13:46.15,0:13:49.37,Default,,0,0,0,,Енді бұл Коухаку ойынының соңғы иннингі.
Dialogue: 0,0:13:49.91,0:13:52.95,Default,,0,0,0,,Ол орта мектепте төбеде құмыра болған⸺
Dialogue: 0,0:13:53.04,0:13:55.16,Default,,0,0,0,,Кодзиро пайда болады.
Dialogue: 0,0:13:55.37,0:13:56.75,Default,,0,0,0,,Уақыт келді.
Dialogue: 0,0:13:56.83,0:13:58.79,Default,,0,0,0,,Бір нәрсе мені қобалжытады.
Dialogue: 0,0:13:58.88,0:14:02.05,Default,,0,0,0,,Менің маскам қайда?
Dialogue: 0,0:14:02.63,0:14:05.88,Default,,0,0,0,,Бұл жерде Шишио командасы бір шымшым ұратын сияқты.
Dialogue: 0,0:14:06.13,0:14:07.55,Default,,0,0,0,,Ой, қызық, бұл кім?
Dialogue: 0,0:14:07.63,0:14:09.05,Default,,0,0,0,,Санширо мүмкін бе?
Dialogue: 0,0:14:09.14,0:14:10.51,Default,,0,0,0,,Мүмкін?
Dialogue: 0,0:14:10.60,0:14:14.98,Default,,0,0,0,,Енді, бәріңіз, сіздердің ойларыңызша, төбеде кім болады?
Dialogue: 0,0:14:15.06,0:14:16.69,Default,,0,0,0,,Ах
Dialogue: 0,0:14:17.85,0:14:18.85,Default,,0,0,0,,Хмм
Dialogue: 0,0:14:19.48,0:14:20.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:20.73,0:14:22.19,Default,,0,0,0,,Тыныш
Dialogue: 0,0:14:25.11,0:14:29.32,Default,,0,0,0,,Мм, дәл қазір... спектакль кезінде...
Dialogue: 0,0:14:31.20,0:14:32.49,Default,,0,0,0,,Хабарлаңыз
Dialogue: 0,0:14:32.58,0:14:33.91,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:37.00,0:14:39.33,Default,,0,0,0,,Тартпаңыз, ұрғышты қысыңыз
Dialogue: 0,0:14:39.42,0:14:42.00,Default,,0,0,0,,Бұл кім? Мен қызықпын
Dialogue: 0,0:14:42.09,0:14:44.05,Default,,0,0,0,,Я, келе жатыр.
Dialogue: 0,0:14:44.84,0:14:46.67,Default,,0,0,0,,шымшуға⸺
Dialogue: 0,0:14:46.76,0:14:50.18,Default,,0,0,0,,Біз ойыншылардан хабарлама алдық.
Dialogue: 0,0:14:50.39,0:14:52.60,Default,,0,0,0,,Мұндай жағдайда бәрін маған қалдыр.
Dialogue: 0,0:14:53.01,0:14:55.89,Default,,0,0,0,,«Алдыңғы топ белсенді болмаған кезде⸺»
Dialogue: 0,0:14:55.97,0:15:00.15,Default,,0,0,0,,«Алдымен маған қоңырау шалғаныңызға рахмет».
Dialogue: 0,0:15:00.40,0:15:02.36,Default,,0,0,0,,Кодзиродан
Dialogue: 0,0:15:02.77,0:15:06.94,Default,,0,0,0,,«Мен жарақат алмайтын және жоғары деңгейге ұмтылатын дене құрастырғым келеді⸺»
Dialogue: 0,0:15:07.03,0:15:08.65,Default,,0,0,0,,«Көріңіздер»
Dialogue: 0,0:15:08.74,0:15:10.57,Default,,0,0,0,,Шишиодан
Dialogue: 0,0:15:11.16,0:15:14.66,Default,,0,0,0,,«Сіз мені мақтап, сіздің қорғанысыңызға сүйенетінімді айтқан күні⸺»
Dialogue: 0,0:15:14.74,0:15:16.66,Default,,0,0,0,,«Шынында мен жыладым».
Dialogue: 0,0:15:16.75,0:15:18.50,Default,,0,0,0,,Ичиномия ойыншысынан
Dialogue: 0,0:15:19.00,0:15:22.00,Default,,0,0,0,,«Теледидардан сыншы мені сынағанда⸺»
Dialogue: 0,0:15:22.08,0:15:24.79,Default,,0,0,0,,«Ол қатты ашуланып, мені құтқарды».
Dialogue: 0,0:15:25.05,0:15:26.96,Default,,0,0,0,,Мицуиден
Dialogue: 0,0:15:27.21,0:15:29.26,Default,,0,0,0,,«Мен қателігімнен жеңілгенімде⸺»
Dialogue: 0,0:15:29.34,0:15:34.51,Default,,0,0,0,,«Мені қалай жігерлендіріп, сенің арқаңда жеңген кездерім болғанын айтқаныңды ешқашан ұмытпаймын».
Dialogue: 0,0:15:34.72,0:15:36.60,Default,,0,0,0,,Каваматсудан
Dialogue: 0,0:15:36.68,0:15:40.39,Default,,0,0,0,,Ах... (Менеджер) Эй, бұл...
Dialogue: 0,0:15:40.73,0:15:46.15,Default,,0,0,0,,«Әйелім мен балаларымның туған күнінде маған гүл сыйлағаныңыз үшін рахмет».
Dialogue: 0,0:15:46.40,0:15:48.36,Default,,0,0,0,,Брайаннан
Dialogue: 0,0:15:48.86,0:15:53.95,Default,,0,0,0,,«Көзіме тіке қарап, менімен сөйлескеніңіз үшін және сізге өз сезімімді білдіргеніңіз үшін рахмет».
Dialogue: 0,0:15:54.37,0:15:56.16,Default,,0,0,0,,Деннистен
Dialogue: 0,0:15:56.95,0:15:59.00,Default,,0,0,0,,«Мен оны реле ретінде пайдаланғаныңызды қалаймын⸺»
Dialogue: 0,0:15:59.08,0:16:02.37,Default,,0,0,0,,«Менің өзімшіл өтінішімді тыңдағаныңызға рахмет».
Dialogue: 0,0:16:02.71,0:16:04.50,Default,,0,0,0,,Нанами ойыншысынан
Dialogue: 0,0:16:05.09,0:16:09.21,Default,,0,0,0,,«Қуат – күш деп айттыңыз...»
Dialogue: 0,0:16:09.30,0:16:11.76,Default,,0,0,0,,«Мен міндетті түрде жалғастырамын»
Dialogue: 0,0:16:11.84,0:16:13.68,Default,,0,0,0,,Ягинодан
Dialogue: 0,0:16:13.89,0:16:15.97,Default,,0,0,0,,Күткендей... Күткендей!
Dialogue: 0,0:16:16.05,0:16:17.39,Default,,0,0,0,,Мүлдем!
Dialogue: 0,0:16:17.47,0:16:19.89,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:20.31,0:16:23.02,Default,,0,0,0,,Ал, бәріңіз, байқадыңыздар.
Dialogue: 0,0:16:23.56,0:16:26.73,Default,,0,0,0,,Шымшықтың рөлін атқаратын адам осы маусымнан кейін зейнетке шығуға шешім қабылдады...
Dialogue: 0,0:16:26.82,0:16:30.78,Default,,0,0,0,,Директор Тадахиро Мацудо!
Dialogue: 0,0:16:30.99,0:16:32.57,Default,,0,0,0,,Менің маскам!
Dialogue: 0,0:16:33.15,0:16:36.20,Default,,0,0,0,,Хмм... Мен шынымен тыңдамадым.
Dialogue: 0,0:16:36.28,0:16:37.99,Default,,0,0,0,,Шығу қиын емес пе?
Dialogue: 0,0:16:39.91,0:16:43.16,Default,,0,0,0,,Тадахиро Мацудо 49 жаста
Dialogue: 0,0:16:43.67,0:16:48.88,Default,,0,0,0,,5 жылдық мерзім 288 жеңіс, 416 жеңіліс
Dialogue: 0,0:16:49.17,0:16:52.47,Default,,0,0,0,,Менің қызмет мерзімімде В сыныбынан қашып кеткен жоқ⸺
Dialogue: 0,0:16:52.55,0:16:55.05,Default,,0,0,0,,Ойыншылар мен жанкүйерлер жақсы көргеннен кейін отставкаға кетті
Dialogue: 0,0:16:56.59,0:17:01.85,Default,,0,0,0,,Ал команда келесі маусымға жаңа жүйемен алға жылжи бастайды.
Dialogue: 0,0:17:11.65,0:17:14.45,Default,,0,0,0,,Жыл мезгілдері ауысады, көктем
Dialogue: 0,0:17:15.61,0:17:19.12,Default,,0,0,0,,Ақыры... ақыры
Dialogue: 0,0:17:19.37,0:17:20.87,Default,,0,0,0,,осылайша өлу – табиғи нәрсе шығар, деп ойлаймын.
Dialogue: 0,0:17:21.33,0:17:24.12,Default,,0,0,0,,Кәсіби бейсбол басталады!
Dialogue: 0,0:17:24.21,0:17:26.92,Default,,0,0,0,,Сәлем баршаңызға, ақыры ашылу күні!
Dialogue: 0,0:17:27.00,0:17:29.42,Default,,0,0,0,,Көңілдісіз бе?
Dialogue: 0,0:17:31.46,0:17:33.97,Default,,0,0,0,,Эй, жаңа күзетші.
Dialogue: 0,0:17:34.05,0:17:35.68,Default,,0,0,0,,Бұл ашылу~
Dialogue: 0,0:17:35.76,0:17:39.05,Default,,0,0,0,,Биыл да көңіліңіз толды ма?
Dialogue: 0,0:17:39.26,0:17:42.93,Default,,0,0,0,,Бұл анық. Бұл маусымның басы!
Dialogue: 0,0:17:43.31,0:17:47.15,Default,,0,0,0,,Ашық ойын болса да, бұл төртінші ойын ғана.
Dialogue: 0,0:17:48.65,0:17:49.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:51.02,0:17:52.40,Default,,0,0,0,,Куу!
Dialogue: 0,0:17:52.48,0:17:55.74,Default,,0,0,0,,Өйткені, мен осы форманы киген кезде қосқыш қосылады.
Dialogue: 0,0:17:55.82,0:17:57.86,Default,,0,0,0,,Хехе, бұл рас.
Dialogue: 0,0:17:57.95,0:18:00.70,Default,,0,0,0,,Мен аздап қобалжыдым.
Dialogue: 0,0:18:00.78,0:18:02.66,Default,,0,0,0,,Иә? Рурико
Dialogue: 0,0:18:02.74,0:18:05.46,Default,,0,0,0,,Сіз тыныш сияқтысыз, не болды?
Dialogue: 0,0:18:05.71,0:18:08.25,Default,,0,0,0,,үшін тым толқыды.
Dialogue: 0,0:18:08.33,0:18:11.42,Default,,0,0,0,,Бұл команданың төртінші ойыны.
Dialogue: 0,0:18:11.92,0:18:13.84,Default,,0,0,0,,Мұны әдеттегідей орындаңыз
Dialogue: 0,0:18:13.92,0:18:15.63,Default,,0,0,0,,Міне
Dialogue: 0,0:18:16.05,0:18:18.97,Default,,0,0,0,,Сіз ардагер ойыншы сияқты сөйлейсіз.
Dialogue: 0,0:18:19.22,0:18:23.72,Default,,0,0,0,,Алғашқы ойын мен үйдегі бірінші ойын араласып кеткен сияқты.
Dialogue: 0,0:18:23.81,0:18:24.93,Default,,0,0,0,,Ах~
Dialogue: 0,0:18:25.02,0:18:29.10,Default,,0,0,0,,Мотор құмдарының ашылу ойыны Genesis Dome-да болды.
Dialogue: 0,0:18:29.19,0:18:32.11,Default,,0,0,0,,Неге олай айтып тұрсың? САРА Жаман қыз!
Dialogue: 0,0:18:32.19,0:18:33.53,Default,,0,0,0,,Кя~!
Dialogue: 0,0:18:33.61,0:18:38.91,Default,,0,0,0,,Үш жыл бұрынғы А сыныбының командасы ашылу ойынын өз үйінде өткізуге құқылы.
Dialogue: 0,0:18:38.99,0:18:42.99,Default,,0,0,0,,Бізді бұл стадионда әлі қарсы алған жоқпыз ғой?
Dialogue: 0,0:18:43.24,0:18:47.04,Default,,0,0,0,,Иә? Бұл тіпті осы маусымда А сыныбында дегенді білдіреді⸺
Dialogue: 0,0:18:47.12,0:18:50.46,Default,,0,0,0,,Ашылу ойыны бұрыннан үйде өтеді.
Dialogue: 0,0:18:50.67,0:18:55.96,Default,,0,0,0,,Мотор Сэндс стадионындағы бірінші күндегідей, солай емес пе?
Dialogue: 0,0:18:56.05,0:19:00.51,Default,,0,0,0,,Дұрыс, бірақ бірдеңе...
Dialogue: 0,0:19:00.76,0:19:02.68,Default,,0,0,0,,Әй, эй, көңіл көтер.
Dialogue: 0,0:19:02.76,0:19:03.76,Default,,0,0,0,,Иә...
Dialogue: 0,0:19:03.85,0:19:05.85,Default,,0,0,0,,«Меро-Меро Ганнан» атылатын нәрсе – «махаббат күші»
Dialogue: 0,0:19:06.89,0:19:08.43,Default,,0,0,0,,«Қажет болса», – дейді Джосуке. «Жарайды».
Dialogue: 0,0:19:08.73,0:19:11.44,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:11.94,0:19:14.36,Default,,0,0,0,,Биылғы бірінші ойынымды көруге қарсы болмадым⸺
Dialogue: 0,0:19:14.44,0:19:17.07,Default,,0,0,0,,Мен Genesis Dome-ге бардым, бірақ...
Dialogue: 0,0:19:17.40,0:19:20.66,Default,,0,0,0,,Күтілгендей, Мотор Сэндс стадионы жақсы.
Dialogue: 0,0:19:21.32,0:19:24.41,Default,,0,0,0,,Үйдегідей қауіпсіздікті сезіну
Dialogue: 0,0:19:25.99,0:19:28.54,Default,,0,0,0,,Сонда да, режиссер Арата Киритани⸺
Dialogue: 0,0:19:28.62,0:19:31.71,Default,,0,0,0,,Бұл тәртіпті өзгерту күрт болды.
Dialogue: 0,0:19:31.79,0:19:33.88,Default,,0,0,0,,Өткен жылы бірінші нөмірге қарсы Genesis⸺
Dialogue: 0,0:19:33.96,0:19:36.46,Default,,0,0,0,,Екі жеңіс және бір жеңіліс - жақсы бастама, бірақ⸺
Dialogue: 0,0:19:36.55,0:19:40.09,Default,,0,0,0,,Бұл болашақта жақсы немесе жаман бола ма?
Dialogue: 0,0:19:40.47,0:19:43.60,Default,,0,0,0,,Экономиканы көтеру үшін сыра ішіңіз...
Dialogue: 0,0:19:43.68,0:19:44.68,Default,,0,0,0,,Ах
Dialogue: 0,0:19:44.76,0:19:47.77,Default,,0,0,0,,Бұл Рурико~ (Бала) Рурико~!
Dialogue: 0,0:19:47.85,0:19:49.98,Default,,0,0,0,,«Рурико-сан» қазірдің өзінде!
Dialogue: 0,0:19:50.44,0:19:53.48,Default,,0,0,0,,Рурико-сан, сіз биыл да сатушы болдыңыз.
Dialogue: 0,0:19:53.56,0:19:54.94,Default,,0,0,0,,Ахаха... а
Dialogue: 0,0:19:55.02,0:19:56.07,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:56.27,0:19:59.40,Default,,0,0,0,,Жоқ... Сәлеметсіз бе, біраз болды.
Dialogue: 0,0:19:59.61,0:20:02.78,Default,,0,0,0,,Әй, сен үлкен ағасың!
Dialogue: 0,0:20:02.86,0:20:04.53,Default,,0,0,0,,Сол бір сыра
Dialogue: 0,0:20:04.62,0:20:06.45,Default,,0,0,0,,Ах, мм...
Dialogue: 0,0:20:06.53,0:20:07.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:07.83,0:20:09.41,Default,,0,0,0,,Бауырым, неше ойын бар?
Dialogue: 0,0:20:09.50,0:20:12.96,Default,,0,0,0,,А, осы маусымда ойындарды қанша рет көрдіңіз?
Dialogue: 0,0:20:13.04,0:20:14.04,Default,,0,0,0,,Иә
Dialogue: 0,0:20:14.25,0:20:18.30,Default,,0,0,0,,Мен Сайтамаға ашылу ойынына бардым⸺
Dialogue: 0,0:20:18.38,0:20:21.47,Default,,0,0,0,,Бұл екінші ойын ма?
Dialogue: 0,0:20:21.55,0:20:23.13,Default,,0,0,0,,Бұл өте жақсы сәйкестік...
Dialogue: 0,0:20:23.22,0:20:25.51,Default,,0,0,0,,Айтпақшы, Коичи, манга оқуды ұнатасың ба?
Dialogue: 0,0:20:26.47,0:20:31.35,Default,,0,0,0,,Сайтамада ішкен сыра шынымен дәмді болса керек.
Dialogue: 0,0:20:31.43,0:20:33.35,Default,,0,0,0,,Не? Хмм
Dialogue: 0,0:20:34.56,0:20:36.19,Default,,0,0,0,,Менің ағама бәрібір ұнайды⸺
Dialogue: 0,0:20:36.27,0:20:39.44,Default,,0,0,0,,Менің ойымша, сіз оны қызықты сатушыдан сатып алдыңыз.
Dialogue: 0,0:20:39.53,0:20:40.69,Default,,0,0,0,,Спорттық костюмім мен кроссовкаларым мінсіз күйде, бір жыртығы да жоқ.
Dialogue: 0,0:20:40.78,0:20:44.03,Default,,0,0,0,,Әйтеуір, аға, бүгінге деген сезіміңіз жоқ па?
Dialogue: 0,0:20:44.11,0:20:46.07,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:20:46.37,0:20:49.79,Default,,0,0,0,,Мм (Мұрата) А... сәлем.
Dialogue: 0,0:20:49.87,0:20:51.91,Default,,0,0,0,,Мм... Рурико-сан
Dialogue: 0,0:20:52.33,0:20:53.37,Default,,0,0,0,,Не?
Dialogue: 0,0:20:54.62,0:20:56.50,Default,,0,0,0,,Сатып алу... жоқ
Dialogue: 0,0:20:56.58,0:20:56.96,Default,,0,0,0,,♪～
Dialogue: 0,0:20:56.96,0:20:57.96,Default,,0,0,0,,♪～
Dialogue: 0,0:20:56.96,0:20:57.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:57.96,0:21:01.30,Default,,0,0,0,,♪～
Dialogue: 0,0:21:01.30,0:21:01.59,Default,,0,0,0,,♪～
Dialogue: 0,0:21:01.30,0:21:01.59,Default,,0,0,0,,Мен Genesis Dome-да ішпедім⸺
Dialogue: 0,0:21:01.59,0:21:04.05,Default,,0,0,0,,Мен Genesis Dome-да ішпедім⸺
Dialogue: 0,0:21:04.13,0:21:06.97,Default,,0,0,0,,Бұл маусымның бірінші сырасы
Dialogue: 0,0:21:07.18,0:21:08.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:11.56,0:21:14.06,Default,,0,0,0,,Дұрыс (Мұрата) Иә.
Dialogue: 0,0:21:15.65,0:21:17.11,Default,,0,0,0,,... Оны ішу керек пе?
Dialogue: 0,0:21:17.19,0:21:20.11,Default,,0,0,0,,Иә итадакамасу
Dialogue: 0,0:21:34.21,0:21:35.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:38.33,0:21:39.84,Default,,0,0,0,,Ах (Мұрата) Ах.
Dialogue: 0,0:21:40.29,0:21:46.43,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:46.51,0:21:47.97,Default,,0,0,0,,Отшашу
Dialogue: 0,0:21:48.05,0:21:50.05,Default,,0,0,0,,Бұл қызықты.
Dialogue: 0,0:21:50.39,0:21:51.81,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:21:52.10,0:21:54.93,Default,,0,0,0,,О~ Отшашулар атылып жатыр.
Dialogue: 0,0:21:55.02,0:21:57.73,Default,,0,0,0,,Мен биылғы жылы отты сезінемін~
Dialogue: 0,0:21:57.81,0:21:59.36,Default,,0,0,0,,Мм... (Накайзуми) Иә?
Dialogue: 0,0:21:59.73,0:22:05.11,Default,,0,0,0,,Шашымның түсі қызғылт болса да кешіргеніңіз үшін рахмет.
Dialogue: 0,0:22:05.45,0:22:09.57,Default,,0,0,0,,Жарайды, бізде де басқа ерекше балалар көп.
Dialogue: 0,0:22:09.78,0:22:12.91,Default,,0,0,0,,Мен үлкендерден жеңілмеу үшін барымды саламын.
Dialogue: 0,0:22:12.99,0:22:15.04,Default,,0,0,0,,Иә, қош келдіңіз.
Dialogue: 0,0:22:15.25,0:22:19.75,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:22:58.16,0:23:00.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:02.42,0:23:04.84,Default,,0,0,0,,Бұл ашылу!
Dialogue: 0,0:23:06.21,0:23:07.22,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:23:08.47,0:23:09.72,Default,,0,0,0,,Иә?не?
Dialogue: 0,0:23:09.80,0:23:12.39,Default,,0,0,0,,А-а, жоқ...
Dialogue: 0,0:23:14.18,0:23:16.31,Default,,0,0,0,,Бүгін ашылады.
Dialogue: 0,0:23:18.81,0:23:23.82,Default,,0,0,0,,～♪
Dialogue: 0,0:23:24.19,0:23:29.36,Default,,0,0,0,,Жарыс қаншада басталады?
Dialogue: 0,0:23:29.74,0:23:33.20,Default,,0,0,0,,Hyper Dry туралы не айтасыз?
Dialogue: 0,0:23:33.57,0:23:38.04,Default,,0,0,0,,Суық сыра, Hyper Dry алғыңыз келе ме?
Dialogue: 0,0:23:38.12,0:23:40.79,Default,,0,0,0,,Кешіріңіз, бір сыра.
Dialogue: 0,0:23:40.87,0:23:44.42,Default,,0,0,0,,Иә! Сізге көп рахмет!
Dialogue: 0,0:23:45.92,0:23:51.92,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
