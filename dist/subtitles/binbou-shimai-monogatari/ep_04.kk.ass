Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.98,0:00:08.73,Default,,0,0,0,,(Бұл рас, солай емес пе?)
Dialogue: 0,0:00:38.18,0:00:39.39,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:00:39.51,0:00:41.14,Default,,0,0,0,,Үйге қош келдіңіз, апа.
Dialogue: 0,0:00:42.18,0:00:43.81,Default,,0,0,0,,Тәрбиеші ретіндегі қажырлы еңбегіңіз үшін рахмет.
Dialogue: 0,0:00:44.14,0:00:46.31,Default,,0,0,0,,Кешкі ас таяп қалды, күте тұрыңыз.
Dialogue: 0,0:00:46.40,0:00:47.02,Default,,0,0,0,,Иә
Dialogue: 0,0:00:51.99,0:00:54.11,Default,,0,0,0,,Бүгін кешкі асқа не бар?
Dialogue: 0,0:00:55.11,0:00:58.28,Default,,0,0,0,,Бүгін біз шиитаке саңырауқұлағы бар күріш пен пісірілген картоп аламыз.
Dialogue: 0,0:01:02.29,0:01:04.46,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:01:05.96,0:01:07.33,Default,,0,0,0,,Дәмді~
Dialogue: 0,0:01:12.34,0:01:15.43,Simai's OS,,0,0,0,,Ертең жақсы боламын деп жеңілдеп қалдым.
Dialogue: 0,0:01:16.22,0:01:19.39,Simai's OS,,0,0,0,,Сенің ертең күлетініңе жеңілдеп қалдым.
Dialogue: 0,0:01:42.37,0:01:48.04,Simai's OS,,0,0,0,,Бірақ мен Асудың шынайы сезімін жиі аңғармаймын.
Dialogue: 0,0:01:48.50,0:01:51.59,Simai's OS,,0,0,0,,Сені мұңайтқаныма өкінемін.
Dialogue: 0,0:01:56.42,0:01:58.63,Simai's OS,,0,0,0,,Осындай кезде мен үнемі ойланып қаламын
Dialogue: 0,0:01:59.05,0:02:03.10,Simai's OS,,0,0,0,,Мен анам сияқты тезірек өскім келеді.
Dialogue: 0,0:02:12.44,0:02:16.07,Default,,0,0,0,,Мен туған жылы анам дүниеден өтті.
Dialogue: 0,0:02:16.61,0:02:19.78,Default,,0,0,0,,Әкем құмар ойындар арқылы қарызға батып, қайтыс болды.
Dialogue: 0,0:02:20.57,0:02:23.58,Default,,0,0,0,,Ал біз артта қалдық
Dialogue: 0,0:02:24.79,0:02:28.50,Default,,0,0,0,,40 жаста, едені жоқ 1К тозығы жеткен пәтер
Dialogue: 0,0:02:29.04,0:02:30.88,Default,,0,0,0,,Бұл біздің үй
Dialogue: 0,0:02:31.50,0:02:33.59,Default,,0,0,0,,Бірақ көктем келгенде...
Dialogue: 0,0:02:34.25,0:02:38.88,OP_Jan,,0,0,0,,Өйткені мен өз естеліктерімді қайтара алмаймын
Dialogue: 0,0:02:38.88,0:02:43.57,OP_Jan,,0,0,0,,Бүгін өмір сүріп, ертеңгі күнді қолға ал
Dialogue: 0,0:02:53.35,0:03:02.16,OP_Jan,,0,0,0,,Жалғыз болсаң да, жалғыз емессің.
Dialogue: 0,0:03:02.77,0:03:11.59,OP_Jan,,0,0,0,,Біз жалғыз емеспіз, біз жалғыз емеспіз
Dialogue: 0,0:03:12.35,0:03:21.08,OP_Jan,,0,0,0,,Әлі аққан жастың алдында
Dialogue: 0,0:03:21.84,0:03:30.73,OP_Jan,,0,0,0,,Қызық, күліп, терең тыныс аламын ба?
Dialogue: 0,0:03:30.73,0:03:35.32,OP_Jan,,0,0,0,,Өйткені мен естеліктеріме орала алмаймын
Dialogue: 0,0:03:35.32,0:03:39.96,OP_Jan,,0,0,0,,Бүгін өмір сүріп, ертеңді қолға ал
Dialogue: 0,0:03:40.10,0:03:49.46,OP_Jan,,0,0,0,,Сенің таптырмас асылың жүрегімде
Dialogue: 0,0:03:49.51,0:03:54.77,OP_Jan,,0,0,0,,Желге терең тыныс алу
Dialogue: 0,0:04:15.04,0:04:19.46,Simai's OS,,0,0,0,,Әтір және ертеңгі ілім
Dialogue: 0,0:04:18.65,0:04:21.40,Simai's OS,,0,0,0,,Бұл киімдер тым балаша көрінеді...
Dialogue: 0,0:04:21.78,0:04:23.61,Simai's OS,,0,0,0,,Бұл да
Dialogue: 0,0:04:24.07,0:04:26.53,Default,,0,0,0,,күрсіну. Бұл сынып бақылауы ма?
Dialogue: 0,0:04:34.25,0:04:37.54,Default,,0,0,0,,Әй, анам осында. Ал Кио Чан ше?
Dialogue: 0,0:04:38.34,0:04:40.55,Default,,0,0,0,,Менің әкем келе жатыр.
Dialogue: 0,0:04:43.30,0:04:45.59,Default,,0,0,0,,Орнынан тұрып - тағзым -
Dialogue: 0,0:04:46.89,0:04:49.14,Default,,0,0,0,,Әке, мүмкін әлі жоқ шығар...
Dialogue: 0,0:04:49.56,0:04:52.52,Default,,0,0,0,,Иә Бұл мәселені түсінетін адам
Dialogue: 0,0:04:53.60,0:04:55.02,Simai's OS,,0,0,0,,Ол әлі келген жоқ...
Dialogue: 0,0:04:55.02,0:04:56.77,Default,,0,0,0,,Барлығымыз бірге оқимыз ба?
Dialogue: 0,0:04:57.06,0:05:01.19,Default,,0,0,40,,(Таро соңғы рет айтты)
Dialogue: 0,0:04:59.86,0:05:03.69,Simai's OS,,0,0,0,,Ол сәл ғана кешігіп қалды, келетініне сенімдімін.
Dialogue: 0,0:05:01.19,0:05:06.07,Default,,0,0,0,,(Мен бәрінің де сіз сияқты екеніне сенімдімін)
Dialogue: 0,0:05:06.20,0:05:09.74,Simai's OS,,0,0,0,,Әке, неге келмедің?
Dialogue: 0,0:05:10.12,0:05:12.16,Simai's OS,,0,0,0,,Келемін деп уәде берсем де...
Dialogue: 0,0:05:14.16,0:05:15.29,Simai's OS,,0,0,0,,Сол кезде
Dialogue: 0,0:05:15.67,0:05:20.71,Simai's OS,,0,0,0,,Ата-анасы кәдімгідей келгендердің бәріне қызғанышпен қарайтынмын.
Dialogue: 0,0:05:21.96,0:05:25.05,Simai's OS,,0,0,0,,Сондықтан мен анамды көкте жолықтырғым келді.
Dialogue: 0,0:05:25.68,0:05:27.47,Simai's OS,,0,0,0,,Мен түні бойы жыладым
Dialogue: 0,0:05:33.31,0:05:36.48,Simai's OS,,0,0,0,,Ертең сенің де солай болғаныңды қаламаймын.
Dialogue: 0,0:05:37.65,0:05:42.02,Simai's OS,,0,0,0,,Мен сенің анаңның орнын алып жатырмын, сондықтан мен дұрыс киінуім керек.
Dialogue: 0,0:05:43.61,0:05:47.70,Simai's OS,,0,0,0,,Күлсін, бәрібір менің жаман киімім жоқ.
Dialogue: 0,0:05:58.58,0:05:59.79,Default,,0,0,0,,Үлкен әпке
Dialogue: 0,0:06:01.75,0:06:03.17,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:06:03.42,0:06:05.46,Default,,0,0,0,,Кешіріңіз, мен сізді ояттым.
Dialogue: 0,0:06:06.17,0:06:09.76,Default,,0,0,0,,Киімдеріңмен не істедіңдер? Үлкен әпке
Dialogue: 0,0:06:11.55,0:06:13.01,Default,,0,0,0,,Ертеңгі сыныпты бақылау
Dialogue: 0,0:06:13.31,0:06:13.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:16.68,0:06:19.73,Default,,0,0,0,,Мен бара алмадым, өйткені сен маған үнемі айта бермейсің.
Dialogue: 0,0:06:20.02,0:06:21.56,Default,,0,0,0,,Мен биыл барамын.
Dialogue: 0,0:06:24.03,0:06:26.32,Default,,0,0,0,,Мм... әпке
Dialogue: 0,0:06:27.15,0:06:28.32,Default,,0,0,0,,Сізге келудің қажеті жоқ.
Dialogue: 0,0:06:28.32,0:06:28.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:29.57,0:06:31.16,Default,,0,0,0,,Сізге келудің қажеті жоқ.
Dialogue: 0,0:06:31.32,0:06:34.99,Default,,0,0,0,,Ех! ! Әпкең бар ма?
Dialogue: 0,0:06:34.99,0:06:36.54,Default,,0,0,0,,О... солай емес пе?
Dialogue: 0,0:06:36.91,0:06:39.46,Default,,0,0,0,,Бұл жұмыс күні, демек сіздің әпкеңіз де мектепте, солай ма?
Dialogue: 0,0:06:39.96,0:06:41.38,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:06:42.96,0:06:45.88,Default,,0,0,0,,Рахмет, әпке. Келмесең жарайды.
Dialogue: 0,0:06:46.01,0:06:47.67,Default,,0,0,0,,Сондықтан уайымдамаңыз
Dialogue: 0,0:06:47.97,0:06:51.97,Default,,0,0,0,,Ұйқым келмесе, ертең газет жеткізу қиынға соғады.
Dialogue: 0,0:06:52.60,0:06:53.26,Default,,0,0,0,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:06:54.10,0:06:56.10,Default,,0,0,0,,Иә...
Dialogue: 0,0:06:58.93,0:07:02.40,Simai's OS,,0,0,0,,Әпкеңнің де мектебі бар дедің.
Dialogue: 0,0:07:03.56,0:07:06.73,Simai's OS,,0,0,0,,Басқа балалар үшін олардың әкелері мен шешелері келеді.
Dialogue: 0,0:07:07.32,0:07:08.19,Simai's OS,,0,0,0,,Күтілгендей
Dialogue: 0,0:07:08.36,0:07:12.87,Simai's OS,,0,0,0,,Орта мектеп оқушысы болып барсам, ұят болар ма еді...
Dialogue: 0,0:07:15.91,0:07:19.12,Simai's OS,,0,0,0,,Тым болмаса жетілген киімдер болса екен...
Dialogue: 0,0:07:36.85,0:07:38.81,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:40.94,0:07:42.27,Default,,0,0,0,,Ертең
Dialogue: 0,0:07:45.11,0:07:46.48,Default,,0,0,0,,Әпке, үйге қош келдіңіз
Dialogue: 0,0:07:46.48,0:07:49.44,Default,,0,0,0,,Әй, пәтерімнің алдында Әй, әмиянымды таптым!
Dialogue: 0,0:07:49.44,0:07:50.44,Default,,0,0,0,,Әмиян?
Dialogue: 0,0:07:50.44,0:07:51.70,Default,,0,0,0,,Мен не істеуім керек? ?
Dialogue: 0,0:07:51.70,0:07:53.41,Default,,0,0,0,,Біз не істеуіміз керек? ?
Dialogue: 0,0:07:53.41,0:07:54.78,Default,,0,0,0,,Сабыр етіңіз, апа.
Dialogue: 0,0:07:54.91,0:07:58.58,Default,,0,0,0,,Иесінің атын немесе мекен-жайын көрсететін нәрсе бар ма?
Dialogue: 0,0:08:07.84,0:08:10.72,Default,,0,0,0,,Ақша... бұл өте көп!
Dialogue: 0,0:08:13.84,0:08:15.26,Default,,0,0,0,,Егер сізде осы ғана болса,
Dialogue: 0,0:08:15.34,0:08:21.02,Default,,0,0,0,,Осы айдағы жалдау ақысы, тамақ және сүйікті тортым бар, мен оны сатып аламын~♥
Dialogue: 0,0:08:21.52,0:08:24.31,Default,,0,0,0,,Тіпті әпкеңізге киім де сатып ала аласыз~♥
Dialogue: 0,0:08:24.90,0:08:27.44,Simai's OS,,0,0,0,,Иә, егер бұл сізге қажет болса
Dialogue: 0,0:08:27.61,0:08:31.69,Simai's OS,,0,0,0,,Мен ертең сабаққа киетін ересектерге ұқсайтын киім сатып алдым...
Dialogue: 0,0:08:36.57,0:08:38.08,Default,,0,0,0,,Жоқ, жоқ
Dialogue: 0,0:08:38.41,0:08:40.41,Default,,0,0,0,,Оны түсірген адам қиыншылыққа ұшырайды.
Dialogue: 0,0:08:40.49,0:08:42.12,Default,,0,0,0,,Оны полиция жәшігіне жеткізіңіз
Dialogue: 0,0:08:42.33,0:08:46.00,Default,,0,0,0,,Сіздің апаңыз бұдан былай газет жеткізеді, солай ма? мен барамын
Dialogue: 0,0:08:46.00,0:08:47.29,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:08:47.29,0:08:47.96,Default,,0,0,0,,Иә
Dialogue: 0,0:09:02.02,0:09:03.60,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:09:03.60,0:09:05.02,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:09:05.02,0:09:07.35,Default,,0,0,0,,Үлкен әпке – уайымдаушы.
Dialogue: 0,0:09:07.44,0:09:09.52,Default,,0,0,0,,Өйткені менің ақшам көп.
Dialogue: 0,0:09:09.82,0:09:12.07,Default,,0,0,0,,Күдікті адамдардың соңынан ермеңіз
Dialogue: 0,0:09:12.11,0:09:13.15,Default,,0,0,0,,Иә
Dialogue: 0,0:09:28.04,0:09:28.96,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:09:29.75,0:09:31.34,Default,,0,0,0,,Бұл сенің көрші апаң емес пе?
Dialogue: 0,0:09:34.47,0:09:36.93,Default,,0,0,0,,А, көрші ханым.
Dialogue: 0,0:09:37.05,0:09:37.68,Default,,0,0,0,,Сәлем
Dialogue: 0,0:09:37.68,0:09:41.47,Default,,0,0,0,,Сол әмиянды тастаған мен болдым. Сіз оны қайтара аласыз ба?
Dialogue: 0,0:09:44.89,0:09:46.31,Simai's OS,,0,0,0,,Күдікті...
Dialogue: 0,0:09:46.60,0:09:50.61,Simai's OS,,0,0,0,,Бұл мен білетін адам, бірақ күдікті, әпке...
Dialogue: 0,0:09:51.90,0:09:56.24,Default,,0,0,0,,Сіздің әмияныңызда медициналық картаңыз бар, солай ма? Ранко Саегуса деген кім?
Dialogue: 0,0:09:59.70,0:10:00.91,Simai's OS,,0,0,0,,Бұл рас
Dialogue: 0,0:10:03.45,0:10:05.70,Default,,0,0,0,,Мен иесінің табылғанына қуаныштымын.
Dialogue: 0,0:10:06.66,0:10:10.33,Default,,0,0,0,,Кішкентай қызға мұқият қарасаңыз, ол өте сүйкімді емес.
Dialogue: 0,0:10:10.84,0:10:13.00,Default,,0,0,0,,Мен сізге бір нәрсе үшін алғыс айтқым келеді. Келіңіздер!
Dialogue: 0,0:10:13.59,0:10:14.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:43.08,0:10:45.08,Default,,0,0,0,,Әй, аңсаған парфей
Dialogue: 0,0:10:45.08,0:10:47.75,Default,,0,0,0,,Торт пен пудинг а ла режимі! !
Dialogue: 0,0:10:48.29,0:10:50.88,Default,,0,0,0,,Енді оны жей беріңіз.
Dialogue: 0,0:10:51.08,0:10:52.75,Default,,0,0,0,,Иә.
Dialogue: 0,0:10:53.09,0:10:53.59,Default,,0,0,0,,Ах
Dialogue: 0,0:10:54.25,0:10:56.71,Default,,0,0,0,,Күдікті адамдардың соңынан ермеңіз
Dialogue: 0,0:11:01.14,0:11:04.26,Default,,0,0,0,,Не болды? Сізге тәттілерді ұнатпайсыз ба?
Dialogue: 0,0:11:05.43,0:11:07.06,Default,,0,0,0,,Менің әпкем күдіктенеді...
Dialogue: 0,0:11:07.06,0:11:11.40,Default,,0,0,0,,Аа, жақсы танымайтын адамдардан нәрселерді қабылдамау керек.
Dialogue: 0,0:11:13.69,0:11:15.40,Default,,0,0,0,,Күннен қорғайтын көзілдірік кию
Dialogue: 0,0:11:15.65,0:11:17.23,Default,,0,0,0,,Сіз бұл күдікті деп ойладыңыз ба?
Dialogue: 0,0:11:17.74,0:11:18.69,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:11:19.28,0:11:19.86,Default,,0,0,0,,Ах
Dialogue: 0,0:11:22.20,0:11:24.03,Simai's OS,,0,0,0,,Мейірімді адам сияқты.
Dialogue: 0,0:11:28.04,0:11:29.83,Default,,0,0,0,,Иә, мен аламын.
Dialogue: 0,0:11:37.92,0:11:40.59,Simai's OS,,0,0,0,,Сіздің әпкеңіз де торт жегісі келетініне сенімдімін.
Dialogue: 0,0:11:40.76,0:11:41.38,Default,,0,0,0,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:11:42.43,0:11:44.14,Default,,0,0,0,,Әлі тамақ ішпейсіз бе?
Dialogue: 0,0:11:45.05,0:11:49.60,Default,,0,0,0,,Мм... мына тортты алып үйге апарсам болады ма?
Dialogue: 0,0:11:50.02,0:11:52.31,Default,,0,0,0,,Жартысын әпкеммен бөліскім келеді.
Dialogue: 0,0:11:52.48,0:11:53.73,Default,,0,0,0,,Торт?
Dialogue: 0,0:11:53.81,0:11:54.61,Default,,0,0,0,,Иә
Dialogue: 0,0:11:55.94,0:11:58.65,Default,,0,0,0,,Барлығын өзіңіз жеңіз
Dialogue: 0,0:11:58.73,0:12:01.86,Default,,0,0,0,,Оны әпкеңнен құпия сақта.
Dialogue: 0,0:12:03.36,0:12:06.03,Simai's OS,,0,0,0,,Мұны... өз бетіңізше...
Dialogue: 0,0:12:10.58,0:12:13.79,Default,,0,0,0,,Таңдаулы тортты ертең де сатып алуға болады.
Dialogue: 0,0:12:18.05,0:12:22.51,Default,,0,0,0,,Егер қазір менің әпкем менің орнымда болса, ол да солай істер еді деп ойлаймын.
Dialogue: 0,0:12:29.52,0:12:33.23,Default,,0,0,0,,Кешіріңіз Эй, кешіріңіз.
Dialogue: 0,0:12:37.27,0:12:38.94,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:39.23,0:12:40.69,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:12:46.12,0:12:48.20,Default,,0,0,0,,Мен бұл туралы біраз уақыттан бері қызық болдым ...
Dialogue: 0,0:12:48.45,0:12:49.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:50.08,0:12:54.00,Default,,0,0,0,,Балалар... көрші үйде әпкеңмен жалғыз тұрасың ба?
Dialogue: 0,0:12:54.25,0:12:54.96,Default,,0,0,0,,Иә
Dialogue: 0,0:12:55.25,0:12:56.83,Default,,0,0,0,,Сенің әкең мен анаң ше?
Dialogue: 0,0:12:57.96,0:13:01.59,Default,,0,0,0,,Әкем басқа жерде тұрады.
Dialogue: 0,0:13:03.38,0:13:06.51,Default,,0,0,0,,Менің анам... жоқ.
Dialogue: 0,0:13:09.68,0:13:12.39,Default,,0,0,0,,Кешіріңіз, мен біртүрлі нәрсе естідім бе?
Dialogue: 0,0:13:12.68,0:13:14.52,Default,,0,0,0,,Мен жай ғана қызық болдым.
Dialogue: 0,0:13:15.10,0:13:15.94,Default,,0,0,0,,Жоқ
Dialogue: 0,0:13:16.31,0:13:18.98,Default,,0,0,0,,Жарайды, өйткені менің үлкен әпкем бар.
Dialogue: 0,0:13:19.82,0:13:20.48,Default,,0,0,0,,Иә
Dialogue: 0,0:13:20.82,0:13:21.53,Default,,0,0,0,,Иә
Dialogue: 0,0:13:21.90,0:13:22.53,Default,,0,0,0,,Тек...
Dialogue: 0,0:13:23.07,0:13:28.20,Default,,0,0,0,,Неге менің анам жоқ? Кейде ойлаймын...
Dialogue: 0,0:13:28.82,0:13:30.83,Default,,0,0,0,,Өте кейде...
Dialogue: 0,0:13:44.72,0:13:46.51,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:13:48.55,0:13:49.72,Default,,0,0,0,,Дәмді~
Dialogue: 0,0:13:49.72,0:13:50.97,Default,,0,0,0,,Ойхи~
Dialogue: 0,0:13:51.31,0:13:53.97,Default,,0,0,0,,Көрші әйел жақсы адам.
Dialogue: 0,0:13:54.18,0:13:56.39,Default,,0,0,0,,Тамақтанып болған соң, мен сізге барып рахмет айтуым керек.
Dialogue: 0,0:13:56.39,0:13:58.40,Default,,0,0,0,,Иә, мен де барамын.
Dialogue: 0,0:13:58.69,0:14:01.61,Default,,0,0,0,,Мен сізге ертең рахметімді айтып қойғанмын, бәрі жақсы.
Dialogue: 0,0:14:01.82,0:14:04.11,Default,,0,0,0,,Мен де кешкі асты жинауым керек.
Dialogue: 0,0:14:04.32,0:14:06.53,Default,,0,0,0,,Хмм... сонда
Dialogue: 0,0:14:06.78,0:14:08.03,Default,,0,0,0,,Олай етпе.
Dialogue: 0,0:14:11.03,0:14:12.70,Default,,0,0,0,,Үшеуі де дәл бірдей жағдайда қаза тапты.
Dialogue: 0,0:14:13.45,0:14:16.62,Default,,0,0,0,,Ертең де өте дәмді деді.
Dialogue: 0,0:14:16.62,0:14:20.00,Default,,0,0,0,,Әй, жақсылап қарасаң, сен де сүйкімдісің.
Dialogue: 0,0:14:20.50,0:14:21.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:21.29,0:14:23.80,Default,,0,0,0,,Бұдан былай дос болайық.
Dialogue: 0,0:14:23.88,0:14:25.01,Default,,0,0,0,,Ах... иә...
Dialogue: 0,0:14:25.01,0:14:25.96,Default,,0,0,0,,Джейн
Dialogue: 0,0:14:30.39,0:14:33.47,Simai's OS,,0,0,0,,Өткен күні мені шулы болдым деп айғайлады.
Dialogue: 0,0:14:33.76,0:14:35.85,Simai's OS,,0,0,0,,Бұл мүлдем басқа атмосфера.
Dialogue: 0,0:14:36.48,0:14:39.44,Simai's OS,,0,0,0,,Бұл тамаша. Мен осылай жетілген болсам деп тілеймін.
Dialogue: 0,0:14:39.73,0:14:44.27,Simai's OS,,0,0,0,,Сабақты бақылауға барсам да, ертең ұятқа қалмас едім.
Dialogue: 0,0:14:45.44,0:14:46.15,Default,,0,0,0,,Ум...
Dialogue: 0,0:14:46.44,0:14:46.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:48.03,0:14:50.36,Default,,0,0,0,,Менің өте анық өтінішім бар...
Dialogue: 0,0:14:50.36,0:14:51.12,Default,,0,0,0,,Не?
Dialogue: 0,0:14:51.12,0:14:54.49,Default,,0,0,0,,Егер сізде костюм болса, оны маған қарызға бере аласыз ба?
Dialogue: 0,0:14:54.49,0:14:55.62,Default,,0,0,0,,Костюмдер?
Dialogue: 0,0:14:55.62,0:14:57.45,Default,,0,0,0,,Менде бар, бірақ мен оны не үшін қолданамын?
Dialogue: 0,0:14:57.79,0:15:00.75,Default,,0,0,0,,Мен барып апамның сабағын көргім келеді.
Dialogue: 0,0:15:01.25,0:15:02.75,Default,,0,0,0,,Өйткені бұл менің анамның мекені.
Dialogue: 0,0:15:03.38,0:15:05.34,Default,,0,0,0,,Мен дұрыс киінгім келеді.
Dialogue: 0,0:15:06.17,0:15:07.34,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:15:07.97,0:15:13.10,Default,,0,0,0,,Неге менің анам жоқ? Кейде ойлаймын
Dialogue: 0,0:15:16.31,0:15:19.14,Default,,0,0,0,,Егер солай болса, мен саған қанша қаласаң, сонша қарыз беремін!
Dialogue: 0,0:15:19.14,0:15:21.02,Default,,0,0,0,,О, рахмет!
Dialogue: 0,0:15:21.02,0:15:22.27,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:15:22.27,0:15:24.57,Default,,0,0,0,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:15:29.36,0:15:33.66,Default,,0,0,0,,Егер сіз сабақты бақылайтын болсаңыз... тым жарқырамағаныңыз жөн.
Dialogue: 0,0:15:34.07,0:15:35.70,Default,,0,0,0,,Қоқыс үйіндісі...
Dialogue: 0,0:15:37.20,0:15:39.54,Default,,0,0,0,,Бұл бейберекет, бірақ бұл туралы алаңдамаңыз
Dialogue: 0,0:15:40.00,0:15:43.46,Default,,0,0,0,,Бұл бозғылт қызғылт түсті...әлде көк пе?
Dialogue: 0,0:15:44.96,0:15:49.01,Default,,0,0,0,,Саегуса мырза не істейді?
Dialogue: 0,0:15:49.34,0:15:50.63,Default,,0,0,0,,Иә, жарайды.
Dialogue: 0,0:15:50.72,0:15:52.09,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:15:53.68,0:15:55.64,Default,,0,0,0,,Осындай нәрсе туралы не деуге болады?
Dialogue: 0,0:16:03.27,0:16:04.77,Default,,0,0,0,,Керемет
Dialogue: 0,0:16:04.77,0:16:08.28,Default,,0,0,0,,Бұл сізге жарасады~ Бұл өте жетілген көрінеді.
Dialogue: 0,0:16:08.28,0:16:09.40,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:16:09.65,0:16:12.11,Default,,0,0,0,,Иә, бұл рас, сенімді болыңыз.
Dialogue: 0,0:16:18.29,0:16:21.33,Default,,0,0,0,,Сондай-ақ оған иіссу сеуіңіз.
Dialogue: 0,0:16:21.33,0:16:22.54,Default,,0,0,0,,Иә Аяқталды
Dialogue: 0,0:16:22.54,0:16:24.00,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:16:24.12,0:16:26.54,Default,,0,0,0,,Киім тазаланып, сізге қайтарылады.
Dialogue: 0,0:16:26.63,0:16:28.55,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:16:28.71,0:16:30.46,Default,,0,0,0,,Мен мұны ертең қайталаймын.
Dialogue: 0,0:16:33.72,0:16:34.93,Default,,0,0,0,,Бұл шынымен де…
Dialogue: 0,0:16:35.14,0:16:37.18,Default,,0,0,0,,Б-не болды? Үлкен әпке
Dialogue: 0,0:16:37.39,0:16:39.43,Default,,0,0,0,,Мен оны көрші әйелден қарызға алдым.
Dialogue: 0,0:16:41.31,0:16:42.98,Default,,0,0,0,,О, сен боянып көрдің бе?
Dialogue: 0,0:16:42.98,0:16:43.52,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:43.81,0:16:46.36,Default,,0,0,0,,Енді сіз анаңызды ауыстыра аласыз.
Dialogue: 0,0:16:48.40,0:16:49.36,Default,,0,0,0,,О, бұл естелік екен. Өте рахмет
Dialogue: 0,0:16:49.36,0:16:50.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:50.65,0:16:53.24,Default,,0,0,0,,Сабақты бақылауға келуге өзіңізді мәжбүрлемеңіз.
Dialogue: 0,0:16:53.95,0:16:54.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:55.28,0:16:56.28,Default,,0,0,0,,Ертең...
Dialogue: 0,0:16:57.49,0:16:59.08,Default,,0,0,0,,Мен өзімді бір нәрсе жасауға мәжбүрлеп жатырмын...
Dialogue: 0,0:16:59.70,0:17:02.54,Default,,0,0,0,,О, бұл үлкен мәселе. Мен қоғамдық моншаға баруым керек.
Dialogue: 0,0:17:02.83,0:17:04.21,Default,,0,0,0,,Әпке, жуынып алайық.
Dialogue: 0,0:17:04.62,0:17:05.87,Default,,0,0,0,,Иә...
Dialogue: 0,0:17:16.68,0:17:19.30,Default,,0,0,0,,Сабақты бақылауға келуге өзіңізді мәжбүрлемеңіз.
Dialogue: 0,0:17:21.06,0:17:23.48,Default,,0,0,0,,Мүмкін менің қолымнан келмейтін шығар...
Dialogue: 0,0:17:32.73,0:17:35.99,Default,,0,0,0,,Ааааааааааа менің бетім әдеттегідей болды.
Dialogue: 0,0:17:44.04,0:17:45.16,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:17:47.92,0:17:50.17,Default,,0,0,0,,Бұл кәдімгі үлкен апаның иісі.
Dialogue: 0,0:17:50.38,0:17:50.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:51.21,0:17:54.26,Default,,0,0,0,,Әпкең ешкімді алмастырмайды.
Dialogue: 0,0:17:55.47,0:17:58.05,Default,,0,0,0,,Өйткені үлкен әпке – үлкен әпке.
Dialogue: 0,0:17:58.55,0:18:00.01,Default,,0,0,0,,Өзіңіздей болыңыз
Dialogue: 0,0:18:01.18,0:18:02.89,Default,,0,0,0,,Кәдімгі үлкен әпке
Dialogue: 0,0:18:07.23,0:18:08.90,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:18:19.41,0:18:24.45,Simai's OS,,0,0,0,,Ертең мен жалғыздықты, мұңды сезінбесем деп үміттенемін.
Dialogue: 0,0:18:24.75,0:18:26.46,Simai's OS,,0,0,0,,Ананың орнына
Dialogue: 0,0:18:26.58,0:18:30.71,Simai's OS,,0,0,0,,Мен ертең дұрыс киініп сабаққа баруды ойладым.
Dialogue: 0,0:18:31.46,0:18:32.04,Simai's OS,,0,0,0,,Бірақ
Dialogue: 0,0:18:32.38,0:18:36.34,Simai's OS,,0,0,0,,Өзімді ұятқа қалдырғым келмегендіктен шығар.
Dialogue: 0,0:18:36.55,0:18:39.22,Simai's OS,,0,0,0,,Сіз жетілген және ұқыпты киінуіңіз керек.
Dialogue: 0,0:18:39.22,0:18:42.51,Simai's OS,,0,0,0,,Мен осылай ойлаған болуым мүмкін екенін түсіндім.
Dialogue: 0,0:18:44.01,0:18:45.22,Simai's OS,,0,0,0,,Ертеңге қарап тұрған кезім
Dialogue: 0,0:18:45.56,0:18:50.31,Simai's OS,,0,0,0,,Бұл бет шын мәнінде жалғыз болса да, өзін ұстап тұрған сияқты.
Dialogue: 0,0:18:58.45,0:19:00.70,Default,,0,0,0,,Асу-чан, сен біреуді іздеп жүрсің бе?
Dialogue: 0,0:19:00.78,0:19:02.57,Default,,0,0,0,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:19:04.41,0:19:06.41,Default,,0,0,0,,Бұл келмеуі керек... ол емес...
Dialogue: 0,0:19:08.79,0:19:10.71,Default,,0,0,0,,Сабақты бастайық.
Dialogue: 0,0:19:11.67,0:19:16.34,Default,,0,0,0,,Мен бүгін сабақты бақылап отырмын, сондықтан анам мен әкемді көре аламын.
Dialogue: 0,0:19:16.34,0:19:18.22,Default,,0,0,0,,Барлығы әдеттегідей
Dialogue: 0,0:19:28.02,0:19:30.69,Default,,0,0,0,,Әй, сен не, кіші мектеп оқушысысың?
Dialogue: 0,0:19:33.86,0:19:36.36,Simai's OS,,0,0,0,,Ертең мен сияқты жақсы болса
Dialogue: 0,0:19:37.28,0:19:39.61,Simai's OS,,0,0,0,,Ұят болатын ештеңе жоқ, солай ма?
Dialogue: 0,0:19:51.71,0:19:55.17,Default,,0,0,0,,Мен Ямада мырзаның оны 94-беттен бастап оқығанын қалаймын.
Dialogue: 0,0:19:55.38,0:19:56.84,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:02.80,0:20:05.39,Default,,0,0,0,,Таро ақырында айтты
Dialogue: 0,0:20:05.39,0:20:10.43,Default,,0,0,0,,Мен сенемін, бәрі сен сияқты, көңілді кезде көңілді.
Dialogue: 0,0:20:10.43,0:20:13.06,Default,,0,0,0,,Қайғылы заманда, мұңда
Dialogue: 0,0:20:13.31,0:20:15.98,Default,,0,0,0,,Кейде мен шын жүректен ашуланамын
Dialogue: 0,0:20:11.89,0:20:13.52,Simai's OS,,0,0,0,,Мен оны мұқият қарап отырмын.
Dialogue: 0,0:20:16.15,0:20:19.99,Simai's OS,,0,0,0,,Мен әрқашан ертеңгі шынайы сезімдерді түсіне бермеймін
Dialogue: 0,0:20:20.15,0:20:21.95,Simai's OS,,0,0,0,,Мен көп өкінемін
Dialogue: 0,0:20:22.82,0:20:27.45,Simai's OS,,0,0,0,,Бірақ мен ертеңгі күнді өз көзқарасыммен ойлаймын.
Dialogue: 0,0:20:28.03,0:20:29.54,Simai's OS,,0,0,0,,Ертеңгі күнді қорғайық
Dialogue: 0,0:20:30.33,0:20:33.54,Simai's OS,,0,0,0,,Егер осылай ойлау ертең өзіңді еркін сезінетін болса.
Dialogue: 0,0:20:34.00,0:20:38.17,Simai's OS,,0,0,0,,Мен анама берген уәдемді орындайтыныма сенімдімін.
Dialogue: 0,0:20:38.71,0:20:39.84,Simai's OS,,0,0,0,,Анам…
Dialogue: 0,0:20:42.88,0:20:45.59,Default,,0,0,0,,Әй, апа, мектепке не болды?
Dialogue: 0,0:20:45.64,0:20:47.64,Default,,0,0,0,,Хехе мен жұмыстан ерте шықтым.
Dialogue: 0,0:20:47.64,0:20:48.43,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:20:49.97,0:20:50.77,Default,,0,0,0,,Үлкен әпке
Dialogue: 0,0:20:51.56,0:20:52.39,Default,,0,0,0,,Маған келесі сұраққа жауап бер.
Dialogue: 0,0:20:54.27,0:20:55.31,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:55.52,0:20:56.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:58.27,0:20:59.36,Default,,0,0,0,,Іс жүзінде
Dialogue: 0,0:21:02.99,0:21:05.74,Default,,0,0,0,,Негізі мен сенің келуіңді қаладым.
Dialogue: 0,0:21:08.91,0:21:11.20,Default,,0,0,0,,Мен мұны білдім.
Dialogue: 0,0:21:11.20,0:21:12.00,Default,,0,0,0,,Ах
Dialogue: 0,0:21:13.21,0:21:14.29,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:21:16.75,0:21:20.59,Default,,0,0,0,,Жарайды, онда мен апаңның сабағын көруге барайын.
Dialogue: 0,0:21:20.59,0:21:22.88,Default,,0,0,0,,Бұл біраз...
Dialogue: 0,0:21:22.88,0:21:24.59,Default,,0,0,0,,Неге?
Dialogue: 0,0:21:46.36,0:21:50.49,EDJap,,0,0,0,,Жазықсыз әңгіме
Dialogue: 0,0:21:50.87,0:21:55.08,EDJap,,0,0,0,,Тіпті кенет тоқтап қалса да
Dialogue: 0,0:21:55.33,0:21:59.33,EDJap,,0,0,0,,Осылай жаныңда болу арқылы
Dialogue: 0,0:21:59.54,0:22:02.96,EDJap,,0,0,0,,Өзіңізді қауіпсіз сезініңіз
Dialogue: 0,0:22:04.30,0:22:08.68,EDJap,,0,0,0,,Маңдайыңызды ақырын сипау
Dialogue: 0,0:22:08.68,0:22:12.72,EDJap,,0,0,0,,Самал сияқты
Dialogue: 0,0:22:13.06,0:22:16.85,EDJap,,0,0,0,,Қолды мықтап, қатты ұстағанда
Dialogue: 0,0:22:17.44,0:22:21.98,EDJap,,0,0,0,,Еңіспен жүгірейік
Dialogue: 0,0:22:21.98,0:22:25.78,EDJap,,0,0,0,,Ертең де қызық болады.
Dialogue: 0,0:22:26.40,0:22:30.82,EDJap,,0,0,0,,Сапқа тұрайық
Dialogue: 0,0:22:30.95,0:22:34.83,EDJap,,0,0,0,,Тығыз, мықтап, Жел ұстасаң
Dialogue: 0,0:22:35.45,0:22:39.96,EDJap,,0,0,0,,Қолымды жайып, жеткізгім келеді
Dialogue: 0,0:22:39.96,0:22:43.80,EDJap,,0,0,0,,Тығыз, мықтап, ертең және болашақта да
Dialogue: 0,0:22:44.46,0:22:51.09,EDJap,,0,0,0,,Қатар жүрейік, бірге барайық
Dialogue: 0,0:22:57.85,0:22:59.23,Default,,0,0,0,,Ертең не істеуіміз керек?
Dialogue: 0,0:22:59.35,0:23:01.86,Default,,0,0,0,,Үй иесі мені дереу пәтерден шығуымды өтінді.
Dialogue: 0,0:23:01.86,0:23:04.57,Default,,0,0,0,,Әпке, қайда баруымыз керек?
Dialogue: 0,0:23:04.86,0:23:06.40,Default,,0,0,0,,Бейшара апалар әңгімесі
Dialogue: 0,0:23:06.48,0:23:08.82,Simai's OS,,0,0,0,,Пәтер, шие гүлдері және көшетін күн
Dialogue: 0,0:23:09.20,0:23:10.45,Default,,0,0,0,,Қарап көріңіз.
Dialogue: 0,0:01:56.05,0:01:58.01,Dialogue,,0,0,0,,Биылғы 4-ші туралы еске түсіру
Dialogue: 0,0:01:56.05,0:01:58.01,Dialogue,,0,0,0,,Биылғы 4-ші ата-аналар күні туралы еске салу
Dialogue: 0,0:01:56.05,0:01:58.01,Dialogue,,0,0,0,,Ата-аналар күні
Dialogue: 0,0:04:06.26,0:04:10.52,generic sign style,,0,0,0,,Парфюмерия күні,
Dialogue: 1,0:04:06.26,0:04:10.52,generic sign style,,0,0,0,,Парфюмерия күні,
