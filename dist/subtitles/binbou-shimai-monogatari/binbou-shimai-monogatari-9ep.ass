Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.65,0:00:14.66,Default,,0,0,0,,Джекпот!
Dialogue: 0,0:00:14.95,0:00:16.82,Default,,0,0,0,,Неге… неге мен
Dialogue: 0,0:00:16.82,0:00:18.16,Default,,0,0,0,,Иә? сурет?
Dialogue: 0,0:00:19.58,0:00:20.79,Default,,0,0,0,,Әлде...?
Dialogue: 0,0:00:20.79,0:00:22.83,Default,,0,0,0,,О, үшінші жүлде.
Dialogue: 0,0:00:22.83,0:00:26.96,Default,,0,0,0,,Мм, үшінші жүлдені қайда қойдыңыз?
Dialogue: 0,0:00:26.96,0:00:28.21,Default,,0,0,0,,Мынау
Dialogue: 0,0:00:30.21,0:00:32.84,Default,,0,0,0,,Өте сәнді және жиынтық
Dialogue: 0,0:00:32.84,0:00:34.59,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:00:35.26,0:00:37.26,Simai's OS,,0,0,0,,Мен бұл туралы кейінірек ойладым.
Dialogue: 0,0:00:37.60,0:00:43.35,Simai's OS,,0,0,0,,Ертең көктегі анам бұны берген болар деп ойладым.
Dialogue: 0,0:00:48.11,0:00:49.73,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:00:49.94,0:00:52.90,Default,,0,0,0,,Үйге қош келдің, апа, еңбегіңе рахмет.
Dialogue: 0,0:00:53.53,0:00:54.99,Default,,0,0,0,,Таңғы ас дайын.
Dialogue: 0,0:00:55.03,0:00:56.82,Default,,0,0,0,,Рахмет
Dialogue: 0,0:00:59.62,0:01:01.91,Default,,0,0,0,,Мен шаршадым.
Dialogue: 0,0:01:07.29,0:01:08.29,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:01:08.50,0:01:11.50,Default,,0,0,0,,Жоқ, жақсысың ба? Үлкен әпке
Dialogue: 0,0:01:11.50,0:01:12.55,Default,,0,0,0,,Иә
Dialogue: 0,0:01:14.05,0:01:16.38,Default,,0,0,0,,Сіз аздап таң қалдыңыз.
Dialogue: 0,0:01:17.18,0:01:18.76,Default,,0,0,0,,Жақсы емес.
Dialogue: 0,0:01:19.80,0:01:22.02,Default,,0,0,0,,Мен бетімді жуайын деп жатырмын.
Dialogue: 0,0:01:32.19,0:01:33.19,Default,,0,0,0,,О, бұл естелік екен. Өте рахмет
Dialogue: 0,0:01:35.07,0:01:37.86,Default,,0,0,0,,Үйіңіздің алдында есінеу әдепсіз.
Dialogue: 0,0:01:37.86,0:01:39.45,Default,,0,0,0,,Жоқ, олай емес...
Dialogue: 0,0:01:39.45,0:01:41.41,Default,,0,0,0,,Кешіріңіз! (Жартылай жұмыс істейтін қызметкер) Ә?
Dialogue: 0,0:01:41.41,0:01:43.45,Default,,0,0,0,,Ал, апа, кеттік.
Dialogue: 0,0:01:43.95,0:01:47.08,Default,,0,0,0,,Әй, абай бол, апатқа ұшырама.
Dialogue: 0,0:01:47.17,0:01:49.25,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:01:49.83,0:01:53.17,Default,,0,0,0,,Ха, мен тағы да ертеңгі күнді уайымдадым.
Dialogue: 0,0:01:53.67,0:01:55.42,Default,,0,0,0,,Біз мықтырақ болуымыз керек!
Dialogue: 0,0:01:56.05,0:02:01.05,Simai's OS,,0,0,0,,Жақында көрші ауданда газет жеткізуші болып істейтін аға әріптесім жұмыстан шығып кетті.
Dialogue: 0,0:02:01.47,0:02:05.93,Simai's OS,,0,0,0,,Жаңа біреуді тапқанша қолым бос емес.
Dialogue: 0,0:02:07.27,0:02:08.73,Default,,0,0,0,,О, білесің бе, ертең...
Dialogue: 0,0:02:11.56,0:02:13.94,Simai's OS,,0,0,0,,Мен саған ертең айтуды ұмытып кетіппін.
Dialogue: 0,0:02:14.11,0:02:17.49,Simai's OS,,0,0,0,,Бүгінгі таңғы маринадталған қияр өте дәмді болды...
Dialogue: 0,0:02:23.33,0:02:25.91,Default,,0,0,0,,Үшінші жүлде, джекпот!
Dialogue: 0,0:02:26.37,0:02:27.71,Default,,0,0,0,,Құттықтаймыз Асу-чан
Dialogue: 0,0:02:27.91,0:02:31.54,Default,,0,0,0,,Үшінші орын – бұл! Оның үстіне мен сізге жиынтық ретінде беремін.
Dialogue: 0,0:02:32.00,0:02:35.51,Default,,0,0,0,,Алдын ала төленген ұялы телефон картасы да кіреді.
Dialogue: 0,0:02:35.63,0:02:38.05,Default,,0,0,0,,Жүр, мен сөмкеге саламын.
Dialogue: 0,0:02:38.26,0:02:40.59,Default,,0,0,0,,Мен мұны аламын ба?
Dialogue: 0,0:02:40.59,0:02:42.01,Default,,0,0,0,,Араримеса
Dialogue: 0,0:02:53.48,0:02:57.15,Default,,0,0,0,,Мен туған жылы анам дүниеден өтті.
Dialogue: 0,0:02:57.69,0:03:00.82,Default,,0,0,0,,Әкем құмар ойындар арқылы қарызға батып, қайтыс болды.
Dialogue: 0,0:03:01.61,0:03:04.62,Default,,0,0,0,,Ал біз артта қалдық
Dialogue: 0,0:03:05.87,0:03:09.54,Default,,0,0,0,,40 жаста, едені жоқ 1К тозығы жеткен пәтер
Dialogue: 0,0:03:10.08,0:03:11.96,Default,,0,0,0,,Бұл біздің үй
Dialogue: 0,0:03:12.54,0:03:14.63,Default,,0,0,0,,Бірақ көктем келгенде...
Dialogue: 0,0:03:15.32,0:03:19.95,OP_Jan,,0,0,0,,Өйткені мен өз естеліктерімді қайтара алмаймын
Dialogue: 0,0:03:19.95,0:03:24.64,OP_Jan,,0,0,0,,Бүгін өмір сүріп, ертеңгі күнді қолға ал
Dialogue: 0,0:03:34.42,0:03:43.23,OP_Jan,,0,0,0,,Жалғыз болсаң да, жалғыз емессің
Dialogue: 0,0:03:43.84,0:03:52.66,OP_Jan,,0,0,0,,Біз жалғыз емеспіз, біз жалғыз емеспіз
Dialogue: 0,0:03:53.42,0:04:02.15,OP_Jan,,0,0,0,,Әлі аққан жастың алдында
Dialogue: 0,0:04:02.91,0:04:11.80,OP_Jan,,0,0,0,,Қызық, күліп, терең тыныс аламын ба?
Dialogue: 0,0:04:11.80,0:04:16.39,OP_Jan,,0,0,0,,Өйткені мен өз естеліктерімді қайтара алмаймын
Dialogue: 0,0:04:16.39,0:04:21.03,OP_Jan,,0,0,0,,Бүгін өмір сүріп, ертеңді қолға ал
Dialogue: 0,0:04:21.17,0:04:30.53,OP_Jan,,0,0,0,,Сенің таптырмас асылың жүрегімде
Dialogue: 0,0:04:30.58,0:04:35.84,OP_Jan,,0,0,0,,Басынан соққан желге терең дем алыңыз
Dialogue: 0,0:04:52.48,0:04:54.02,Default,,0,0,0,,Ертең
Dialogue: 0,0:04:54.31,0:04:56.44,Default,,0,0,0,,Эй, бұған не болды?
Dialogue: 0,0:04:56.44,0:05:01.11,Default,,0,0,0,,Сауда ауданындағы лотереяда... Бұл шын, әпке.
Dialogue: 0,0:05:02.90,0:05:04.15,Default,,0,0,0,,Үлкен әпке?
Dialogue: 0,0:05:04.20,0:05:06.28,Default,,0,0,0,,Ұялы телефон…Denwa…
Dialogue: 0,0:05:06.70,0:05:08.78,Default,,0,0,0,,Ұялы телефон - бұл ұялы телефон, солай ма?
Dialogue: 0,0:05:08.91,0:05:09.83,Default,,0,0,0,,Иә
Dialogue: 0,0:05:09.95,0:05:14.41,Default,,0,0,0,,Мен мұндайды алыстағы, алыстағы басқа дүниедегі оқиға деп ойладым...
Dialogue: 0,0:05:14.41,0:05:16.37,Default,,0,0,0,,Жоқ... бұл тым көп...
Dialogue: 0,0:05:16.37,0:05:17.46,Default,,0,0,0,,Әй, арман ба?
Dialogue: 0,0:05:17.46,0:05:19.46,Default,,0,0,0,,N-Мен олай ойламаймын.
Dialogue: 0,0:05:20.09,0:05:23.51,Default,,0,0,0,,Сонымен... оны қалай пайдаланамыз?
Dialogue: 0,0:05:23.55,0:05:26.38,Default,,0,0,0,,Ал, ең алдымен қуат көзін қалай қосу керек...
Dialogue: 0,0:05:26.72,0:05:27.80,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:05:27.84,0:05:28.64,Default,,0,0,0,,Тіпті оның есту қабілетінен айырылғаны туралы қауесет те бар
Dialogue: 0,0:05:28.64,0:05:29.89,Default,,0,0,0,,Мурата мырза!
Dialogue: 0,0:05:29.89,0:05:31.68,Default,,0,0,0,,Хмм...алдын ала төленген
Dialogue: 0,0:05:31.68,0:05:36.31,Default,,0,0,0,,Бұл картаның құны 3000 иен және үш ай бойы жарамды...
Dialogue: 0,0:05:36.48,0:05:37.73,Default,,0,0,0,,Құны үш мың иен?
Dialogue: 0,0:05:37.73,0:05:39.65,Default,,0,0,0,,Әй, міне, міне.
Dialogue: 0,0:05:39.65,0:05:41.69,Default,,0,0,0,,Нөмірді енгізіңіз.
Dialogue: 0,0:05:41.69,0:05:42.73,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:05:44.74,0:05:46.53,Default,,0,0,0,,әлі де қолдануға бола ма?
Dialogue: 0,0:05:46.53,0:05:48.82,Default,,0,0,0,,Әпкеңізбен ойнап көріңіз.
Dialogue: 0,0:05:48.82,0:05:50.28,Default,,0,0,0,,Иә
Dialogue: 0,0:05:54.54,0:05:55.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:56.50,0:05:57.79,Default,,0,0,0,,О, сигналы келіп жатыр, келіп жатыр
Dialogue: 0,0:05:57.79,0:05:59.42,Default,,0,0,0,,Субару-кун?
Dialogue: 0,0:06:03.50,0:06:05.13,Default,,0,0,0,,анық па?
Dialogue: 0,0:06:05.21,0:06:05.80,Default,,0,0,0,,Га
Dialogue: 0,0:06:06.72,0:06:07.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:08.89,0:06:10.18,Default,,0,0,0,,Сіз оны кесіп тастадыңыз ба?
Dialogue: 0,0:06:10.22,0:06:11.85,Default,,0,0,0,,Бұл қауіпті жағдай болды!
Dialogue: 0,0:06:11.85,0:06:12.51,Default,,0,0,0,,Не?
Dialogue: 0,0:06:12.51,0:06:14.64,Default,,0,0,0,,Осының пайдалануға болатын белгілі бір мөлшері жоқ па?
Dialogue: 0,0:06:15.39,0:06:16.52,Default,,0,0,0,,құны 3000 иен
Dialogue: 0,0:06:17.27,0:06:19.23,Default,,0,0,0,,Мұқият қолдану керек!
Dialogue: 0,0:06:19.60,0:06:21.98,Default,,0,0,0,,Дұрыс, солай емес пе?
Dialogue: 0,0:06:31.45,0:06:33.12,Default,,0,0,0,,Әпке, амансыз ба?
Dialogue: 0,0:06:34.54,0:06:35.95,Default,,0,0,0,,Сіз мұны қайтадан жасадыңыз.
Dialogue: 0,0:06:35.95,0:06:37.04,Default,,0,0,0,,Иә, бәрібір
Dialogue: 0,0:06:37.04,0:06:39.25,Default,,0,0,0,,Сонымен қатар, бүгіннен бастап бізде осындай.
Dialogue: 0,0:06:46.09,0:06:49.01,Default,,0,0,0,,Бірдеңе болып қалса, дереу әпкеңе хабарлас.
Dialogue: 0,0:06:49.01,0:06:50.34,Default,,0,0,0,,Менің әпкем де.
Dialogue: 0,0:06:50.59,0:06:52.09,Default,,0,0,0,,Жарайды, апа, мен барайын.
Dialogue: 0,0:06:52.76,0:06:55.10,Default,,0,0,0,,Аа, менің де бүгін ұйқым келіп тұр.
Dialogue: 0,0:06:57.93,0:07:00.65,Default,,0,0,0,,А, мен де бүгін айта алмадым.
Dialogue: 0,0:07:00.65,0:07:03.31,Default,,0,0,0,,Тофу мисо сорпасы дәмді болды...
Dialogue: 0,0:07:06.94,0:07:10.95,Default,,0,0,0,,Аа, дұрыс. Мектеп ішінде электр қуатын өшіру керек.
Dialogue: 0,0:07:12.74,0:07:13.74,Default,,0,0,0,,Әй...
Dialogue: 0,0:07:14.16,0:07:15.62,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:07:16.12,0:07:17.70,Default,,0,0,0,,Қайырлы таң Гинко-чан
Dialogue: 0,0:07:17.70,0:07:18.62,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:07:18.70,0:07:20.54,Default,,0,0,0,,Сіз ұялы телефон сатып алдыңыз ба?
Dialogue: 0,0:07:20.54,0:07:21.42,Default,,0,0,0,,О, бұл?
Dialogue: 0,0:07:21.42,0:07:24.79,Default,,0,0,0,,Жоқ, мен сауда ауданында лотерея ұтып алдым.
Dialogue: 0,0:07:24.79,0:07:27.38,Default,,0,0,0,,Сәлем ұтыс ойыны...
Dialogue: 0,0:07:28.84,0:07:33.14,Default,,0,0,0,,Сіздің әпкеңізде одан да күрделі нәрсе бар.
Dialogue: 0,0:07:33.47,0:07:35.35,Default,,0,0,0,,Мен де кіші мектеп оқушысы болғанда
Dialogue: 0,0:07:35.35,0:07:39.64,Default,,0,0,0,,Мен саған әпкеңдікіндей ғажайып ұялы телефон сатып алайын деп жатырмын.
Dialogue: 0,0:07:40.35,0:07:41.10,Default,,0,0,0,,Иә...
Dialogue: 0,0:07:41.19,0:07:44.02,Default,,0,0,0,,Мені бір секундқа тыңдаңыз. Сен не істеп жатырсың?
Dialogue: 0,0:07:44.36,0:07:47.78,Default,,0,0,0,,Қуатты қалай өшіру керектігін ұмытып қалдым. Не істеуім керек?
Dialogue: 0,0:07:47.94,0:07:49.74,Default,,0,0,0,,Мен мұны тіпті білмеймін.
Dialogue: 0,0:07:49.74,0:07:52.49,Default,,0,0,0,,Осы жерде біраз уақыт басыңыз
Dialogue: 0,0:07:52.99,0:07:55.37,Default,,0,0,0,,Гинко-чан керемет, рахмет
Dialogue: 0,0:07:55.37,0:07:58.83,Default,,0,0,0,,Мен сіздің әпкеңіз туралы бәрін білемін, өйткені мен оны үнемі бақылап отырамын.
Dialogue: 0,0:07:58.83,0:08:01.75,Default,,0,0,0,,Түсінбеген жеріңіз болса, айта аласыз.
Dialogue: 0,0:08:01.75,0:08:04.29,Default,,0,0,0,,Мен оны жүзеге асырамын…
Dialogue: 0,0:08:06.42,0:08:08.34,Default,,0,0,0,,Жақсы ұялы телефон...
Dialogue: 0,0:08:15.80,0:08:17.93,Default,,0,0,0,,Ертең телефон соға ма деп ойлаймын.
Dialogue: 0,0:08:19.60,0:08:21.60,Default,,0,0,0,,Мен оны байқап көремін деп ойлаймын...
Dialogue: 0,0:08:24.85,0:08:27.23,Default,,0,0,0,,Қызық, әпкем шақырады ма?
Dialogue: 0,0:08:27.23,0:08:29.36,Default,,0,0,0,,Мен оны байқап көремін деп ойлаймын...
Dialogue: 0,0:08:30.44,0:08:32.36,Default,,0,0,0,,Жоқ, жоқ, бұл ысырап.
Dialogue: 0,0:08:39.16,0:08:40.29,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:08:40.54,0:08:43.41,Default,,0,0,0,,Мүмкін менде қазір өте маңызды нәрсе бар шығар.
Dialogue: 0,0:08:43.41,0:08:45.96,Default,,0,0,0,,Мүмкін бұл ұялы телефонды пайдалану уақыты келді
Dialogue: 0,0:08:46.21,0:08:49.30,Default,,0,0,0,,Дегенмен, дәл қазір, менде ештеңе жоқ кезде,
Dialogue: 0,0:08:49.30,0:08:51.67,Default,,0,0,0,,Егер сіз оны қиын сәтте пайдалана алмасаңыз...
Dialogue: 0,0:08:58.14,0:09:00.89,Default,,0,0,0,,Неге шақырмайсың? Мен оны киіп алғым келеді
Dialogue: 0,0:09:00.89,0:09:02.93,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:09:08.98,0:09:11.61,Simai's OS,,0,0,0,,Мен мұны кедейлік деп атай ма деп ойлаймын...
Dialogue: 0,0:09:14.11,0:09:16.07,Default,,0,0,0,,Содан бері бір апта өтті.
Dialogue: 0,0:09:16.07,0:09:16.78,Default,,0,0,0,,Иә
Dialogue: 0,0:09:17.20,0:09:19.41,Default,,0,0,0,,Мен оны бір рет те пайдаланбадым.
Dialogue: 0,0:09:19.87,0:09:20.74,Default,,0,0,0,,Иә
Dialogue: 0,0:09:21.16,0:09:24.16,Default,,0,0,0,,Осылай үш ай өтті...
Dialogue: 0,0:09:24.33,0:09:26.96,Default,,0,0,0,,Бұл ысырап болар еді...
Dialogue: 0,0:09:30.09,0:09:33.96,Default,,0,0,0,,Жарайды, мен оны бұдан былай қарапайымырақ қолданамын.
Dialogue: 0,0:09:34.45,0:09:36.05,Default,,0,0,0,,О, дұрыс.
Dialogue: 0,0:09:36.05,0:09:39.09,Default,,0,0,0,,Аа, бірақ тым көп ысырап етсеңіз жақсы емес.
Dialogue: 0,0:09:39.09,0:09:40.06,Default,,0,0,0,,Төтенше жағдайда
Dialogue: 0,0:09:40.06,0:09:40.83,Default,,0,0,0,,Үлкен әпке
Dialogue: 0,0:09:40.83,0:09:44.03,Default,,0,0,0,,Олай десеңіз, тағы бір апта басталады.
Dialogue: 0,0:09:44.40,0:09:45.70,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:09:48.69,0:09:50.15,Default,,0,0,0,,Ах, кешкі газет
Dialogue: 0,0:09:50.40,0:09:52.98,Default,,0,0,0,,Енді оянып, бар күшіңді салу керек!
Dialogue: 0,0:09:55.95,0:09:57.49,Default,,0,0,0,,Қуатты қосыңыз
Dialogue: 0,0:09:57.99,0:09:59.24,Default,,0,0,0,,Ямада мырза
Dialogue: 0,0:09:59.24,0:09:59.87,Default,,0,0,0,,Иә
Dialogue: 0,0:09:59.99,0:10:01.62,Default,,0,0,0,,Маған аздап көмектесе аласыз ба?
Dialogue: 0,0:10:01.62,0:10:02.79,Default,,0,0,0,,А, иә
Dialogue: 0,0:10:20.14,0:10:24.35,Simai's OS,,0,0,0,,Әпке, келмедіңіз. Мектеп бітуі керек еді...
Dialogue: 0,0:10:25.18,0:10:26.68,Simai's OS,,0,0,0,,Бірдеңе болды ма деп ойлаймын...
Dialogue: 0,0:10:26.68,0:10:27.23,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:27.27,0:10:29.73,Default,,0,0,0,,Ах, Гинко-чан
Dialogue: 0,0:10:29.73,0:10:32.19,Default,,0,0,0,,Ақыры оны кигіңіз келді.
Dialogue: 0,0:10:32.19,0:10:36.28,Default,,0,0,0,,Иә, әпкем екеуміз оны жеңілдетуді жөн көрдік.
Dialogue: 0,0:10:36.28,0:10:40.78,Default,,0,0,0,,Кешкі асқа карри немесе ет картопын қалайсыз ба деп сұрайын деп едім...
Dialogue: 0,0:10:41.28,0:10:43.66,Default,,0,0,0,,Сіз оны өте үмітсіз нәрселер үшін пайдаланасыз.
Dialogue: 0,0:10:44.99,0:10:48.75,Default,,0,0,0,,Иә, Гинко-чан, егер қаласаңыз, маған қоңырау шалыңыз.
Dialogue: 0,0:10:49.50,0:10:53.54,Default,,0,0,0,,Сіздің нөмірлеріңіз... егер қаласаңыз.
Dialogue: 0,0:10:55.50,0:10:58.72,Simai's OS,,0,0,0,,Қалай болғанда да, апаң не болды...
Dialogue: 0,0:10:58.92,0:11:01.14,Simai's OS,,0,0,0,,Мен шаршағандықтан уайымдап отырмын.
Dialogue: 0,0:11:24.37,0:11:25.62,Default,,0,0,0,,Қосылу мүмкін емес пе?
Dialogue: 0,0:11:25.70,0:11:27.66,Default,,0,0,0,,Иә, бұл біртүрлі...
Dialogue: 0,0:11:27.66,0:11:28.45,Default,,0,0,0,,Радиотолқындар?
Dialogue: 0,0:11:28.62,0:11:30.08,Default,,0,0,0,,Таптыңыз ба? Қажет еткеніңізді?
Dialogue: 0,0:11:30.37,0:11:32.63,Default,,0,0,0,,Біз үйде қосыла алдық, бірақ...
Dialogue: 0,0:11:34.17,0:11:34.88,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:11:34.88,0:11:35.34,Default,,0,0,0,,Ах
Dialogue: 0,0:11:35.54,0:11:39.22,Default,,0,0,0,,Менің әпкемде жасап көрсеңіз болады.
Dialogue: 0,0:11:39.47,0:11:39.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:39.92,0:11:41.30,Default,,0,0,0,,Маған қара.
Dialogue: 0,0:11:43.84,0:11:45.14,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:11:54.65,0:11:55.44,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:11:56.48,0:11:58.53,Default,,0,0,0,,Әпке? Мен Гинькомын
Dialogue: 0,0:11:59.07,0:12:03.07,Default,,0,0,0,,Иә, сізді кенеттен шақырғаным үшін кешіріңіз. Қазір жақсысың ба?
Dialogue: 0,0:12:03.41,0:12:06.37,Default,,0,0,0,,Иә, иә, солай, апа.
Dialogue: 0,0:12:06.53,0:12:10.12,Default,,0,0,0,,Шамасы, бұл сауда көшесінің лотереясы Иә.
Dialogue: 0,0:12:10.37,0:12:12.25,Default,,0,0,0,,Барлығы үшінші класс деп айтылады.
Dialogue: 0,0:12:12.75,0:12:13.46,Default,,0,0,40,,Иә
Dialogue: 0,0:12:18.50,0:12:20.63,Default,,0,0,0,,Иә, рақмет.
Dialogue: 0,0:12:36.11,0:12:38.11,Default,,0,0,0,,Иә, дұрыс, апа.
Dialogue: 0,0:12:38.11,0:12:39.19,Default,,0,0,0,,Сондықтан мен...
Dialogue: 0,0:12:40.15,0:12:40.86,Default,,0,0,0,,Иә
Dialogue: 0,0:12:47.74,0:12:49.03,Default,,0,0,0,,Иә
Dialogue: 0,0:12:07.91,0:12:09.75,Simai's OS,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:12:13.04,0:12:16.88,Simai's OS,,0,0,0,,Мен сені осылай кездейсоқ шақырсам ғой.
Dialogue: 0,0:12:21.55,0:12:23.68,Simai's OS,,0,0,0,,...Бұл ... деп айтатын уақыт емес.
Dialogue: 0,0:12:24.22,0:12:28.93,Default,,0,0,0,,А, мм, Гинко-чан... бұл туралы ұзақ сөйлескенде.
Dialogue: 0,0:12:29.14,0:12:32.85,Default,,0,0,0,,Ум, мен 3000 иенмен біттім...
Dialogue: 0,0:12:32.85,0:12:35.15,Default,,0,0,0,,Мен естіген жоқпын... Мм...
Dialogue: 0,0:12:39.36,0:12:40.61,Simai's OS,,0,0,0,,Бұл туралы айтатын болсақ
Dialogue: 0,0:12:40.61,0:12:45.20,Simai's OS,,0,0,0,,Әпкем соңғы кездері шаршағандықтан, көп сөйлесе алмай қалдық...
Dialogue: 0,0:12:50.87,0:12:54.67,Simai's OS,,0,0,0,,Гинко-чан, сенімен көп сөйлескенім жақсы.
Dialogue: 0,0:12:55.87,0:12:57.00,Default,,0,0,0,,Рахмет сізге Ямада мырза
Dialogue: 0,0:12:57.13,0:12:57.75,Default,,0,0,0,,Иә
Dialogue: 0,0:12:58.59,0:13:00.09,Default,,0,0,0,,Иә? не?
Dialogue: 0,0:13:00.71,0:13:04.38,Default,,0,0,0,,Маған қоңырау соқты. Ертең.
Dialogue: 0,0:13:10.06,0:13:12.14,Default,,0,0,0,,Иә? бос емес
Dialogue: 0,0:13:12.35,0:13:15.10,Default,,0,0,0,,Не? Сауда көшесіндегі қалта маталары?
Dialogue: 0,0:13:15.39,0:13:16.15,Default,,0,0,0,,Иә
Dialogue: 0,0:13:16.48,0:13:21.40,Default,,0,0,0,,А... иә, бұрышты темекі дүкеніне бұрасың ба?
Dialogue: 0,0:13:20.52,0:13:21.86,Default,,0,0,0,,Эй, у...
Dialogue: 0,0:13:24.45,0:13:28.03,Default,,0,0,0,,Иә, аламын. Енді кешіріңіз, әпке.
Dialogue: 0,0:13:29.28,0:13:29.91,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:30.28,0:13:31.95,Default,,0,0,0,,А, иә...
Dialogue: 0,0:13:35.91,0:13:37.46,Default,,0,0,0,,Бұл сіздің әпкеңізден.
Dialogue: 0,0:13:43.88,0:13:44.88,Default,,0,0,0,,Ертең
Dialogue: 0,0:13:46.68,0:13:48.09,Default,,0,0,0,,Сәлеметсіз бе? Ертең?
Dialogue: 0,0:13:49.05,0:13:50.05,Default,,0,0,0,,Аа, әпке...
Dialogue: 0,0:13:51.51,0:13:54.06,Default,,0,0,0,,Иә? ертең?
Dialogue: 0,0:13:55.10,0:13:56.39,Default,,0,0,0,,Ертең не болды?
Dialogue: 0,0:13:59.44,0:14:00.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:00.44,0:14:01.48,Default,,0,0,0,,Не болды?
Dialogue: 0,0:14:01.48,0:14:02.73,Default,,0,0,0,,Ол бұзылды...
Dialogue: 0,0:14:03.03,0:14:04.61,Default,,0,0,0,,Батарея біткен сияқты.
Dialogue: 0,0:14:05.03,0:14:08.57,Default,,0,0,0,,А, жоқ... иә...
Dialogue: 0,0:14:09.32,0:14:13.20,Default,,0,0,0,,Ол дұрыс зарядталмайды, сондықтан тез өшеді.
Dialogue: 0,0:14:17.25,0:14:24.11,Default,,0,0,0,,Сіз қоңырау шалған телефон қазір өшірулі немесе сигналы жоқ...
Dialogue: 0,0:14:25.24,0:14:26.44,Simai's OS,,0,0,0,,Мен қосыла алмаймын. Не болды?
Dialogue: 0,0:14:28.28,0:14:29.58,Simai's OS,,0,0,0,,Бірдеңе болды ма деп ойлаймын...
Dialogue: 0,0:14:30.78,0:14:32.42,Default,,0,0,0,,Сіз жасаған телефон қоңырауы...
Dialogue: 0,0:14:34.35,0:14:35.47,Default,,0,0,0,,Әй, әпке...
Dialogue: 0,0:14:38.19,0:14:40.15,Simai's OS,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:14:44.15,0:14:46.86,Simai's OS,,0,0,0,,Мен әрқашан осы уақытта сауда аймағында болуым керек.
Dialogue: 0,0:14:47.69,0:14:49.86,Default,,0,0,0,,Кешіріңіз, мен бірден қайтамын.
Dialogue: 0,0:14:50.24,0:14:50.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:54.16,0:14:57.08,Simai's OS,,0,0,0,,Әпке, сізде қандай кәсіп бар еді...
Dialogue: 0,0:14:59.50,0:15:02.25,Simai's OS,,0,0,0,,Бүгін таңертең екеуміз қоштасқанда менің де басым айналып кетті.
Dialogue: 0,0:15:02.67,0:15:05.50,Simai's OS,,0,0,0,,Мүмкін сіз өзіңізді нашар сезініп жатқан шығарсыз?
Dialogue: 0,0:15:09.59,0:15:11.64,Default,,0,0,0,,Эй, зарядтағың келсе, үйге кел...
Dialogue: 0,0:15:12.01,0:15:14.14,Default,,0,0,0,,Иә? Қайда бардың?
Dialogue: 0,0:15:14.85,0:15:18.23,Simai's OS,,0,0,0,,Әдетте мен ол кезде газет жеткізу пунктінде болатын едім.
Dialogue: 0,0:15:19.14,0:15:20.77,Default,,0,0,0,,Иә, Кио Чан?
Dialogue: 0,0:15:21.19,0:15:23.36,Default,,0,0,0,,Қазір ойлап қарасам, мен оны көрмеймін...
Dialogue: 0,0:15:23.36,0:15:26.32,Default,,0,0,0,,Не? Жоқ, сен мұнда емессің... сен мұнда емессің бе?
Dialogue: 0,0:15:26.32,0:15:28.28,Default,,0,0,0,,Қария, мұнымен не істеуіміз керек?
Dialogue: 0,0:15:28.28,0:15:29.70,Default,,0,0,0,,О, енді барайық.
Dialogue: 0,0:15:29.70,0:15:30.45,Default,,0,0,0,,О, мм...
Dialogue: 0,0:15:31.32,0:15:34.91,Default,,0,0,0,,Менің әпкем қатты ауырып жатыр және бір жерде...
Dialogue: 0,0:15:36.20,0:15:39.50,Default,,0,0,0,,Айтпақшы, бұл бұрынғы дауыс Кио Чан болатын...
Dialogue: 0,0:15:39.50,0:15:41.71,Default,,0,0,0,,Маған қызық па...
Dialogue: 0,0:15:42.25,0:15:45.21,Default,,0,0,0,,Не? Асу-чан? Мен оны бүгін әлі көрген жоқпын.
Dialogue: 0,0:15:45.21,0:15:46.42,Default,,0,0,0,,Шит… шит…
Dialogue: 0,0:15:46.42,0:15:49.51,Default,,0,0,0,,Әдетте ол бұрыннан келуі керек еді.
Dialogue: 0,0:15:49.51,0:15:51.26,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:15:52.72,0:15:53.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:53.93,0:15:58.39,Simai's OS,,0,0,0,,Бұл таңқаларлық, ертең телефонды әдейі қоюға мүмкіндік жоқ.
Dialogue: 0,0:15:59.10,0:16:01.39,Simai's OS,,0,0,0,,Әйтеуір... Ю-адам ұрлау! ?
Dialogue: 0,0:16:09.36,0:16:11.45,Simai's OS,,0,0,0,,Әпке, қайдасыз?
Dialogue: 0,0:16:11.90,0:16:15.37,Simai's OS,,0,0,0,,Мүмкін ол өзін жақсы сезінбегендіктен үйіне оралған шығар.
Dialogue: 0,0:16:15.91,0:16:17.87,Default,,0,0,0,,Радиотолқындар жетпейтін жерде...
Dialogue: 0,0:16:19.24,0:16:20.12,Simai's OS,,0,0,0,,Ертең
Dialogue: 0,0:16:25.00,0:16:26.08,Simai's OS,,0,0,0,,Үлкен әпке!
Dialogue: 0,0:16:33.97,0:16:35.14,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:16:35.89,0:16:36.76,Default,,0,0,0,,Му
Dialogue: 0,0:16:40.27,0:16:43.56,Simai's OS,,0,0,0,,Әпкең қайда?
Dialogue: 0,0:16:45.98,0:16:48.82,Simai's OS,,0,0,0,,Үлкен апа Үлкен апа
Dialogue: 0,0:16:50.11,0:16:53.15,Simai's OS,,0,0,0,,Үлкен апа Үлкен апа
Dialogue: 0,0:16:54.91,0:16:56.99,Default,,0,0,0,,Менде ұялы телефон болса да.
Dialogue: 0,0:16:56.99,0:16:59.12,Default,,0,0,0,,Неліктен оны маңызды уақытта пайдалана алмаймын?
Dialogue: 0,0:16:59.58,0:17:01.79,Default,,0,0,0,,Үлкен әпке
Dialogue: 0,0:17:03.25,0:17:04.04,Default,,0,0,0,,Ертең
Dialogue: 0,0:17:05.58,0:17:06.92,Default,,0,0,0,,Ертең
Dialogue: 0,0:17:21.39,0:17:22.06,Default,,0,0,0,,Үлкен әпке
Dialogue: 0,0:17:22.06,0:17:22.89,Default,,0,0,0,,Ертең
Dialogue: 0,0:17:25.31,0:17:26.60,Default,,0,0,0,,Үлкен әпке
Dialogue: 0,0:17:26.60,0:17:27.90,Default,,0,0,0,,Ертең
Dialogue: 0,0:17:27.98,0:17:31.57,Default,,0,0,0,,Құлап кетпегеніңіз жақсы болды.
Dialogue: 0,0:17:31.65,0:17:35.61,Default,,0,0,0,,Ертең сені ұрлаған жоқсың ба?
Dialogue: 0,0:17:38.57,0:17:39.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:40.74,0:17:42.79,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:17:45.16,0:17:46.16,Default,,0,0,0,,Үлкен әпке
Dialogue: 0,0:17:57.59,0:18:01.68,Default,,0,0,0,,Сонымен, батарея заряды таусылғандықтан қосыла алмадыңыз ба?
Dialogue: 0,0:18:01.72,0:18:04.06,Default,,0,0,0,,Иә, әртүрлі нәрселер бар.
Dialogue: 0,0:18:04.64,0:18:09.06,Default,,0,0,0,,Мен де керек уақытта орнымнан шықтым.
Dialogue: 0,0:18:09.35,0:18:13.11,Default,,0,0,0,,Мүмкін бұл жай ғана кездейсоқтық шығар, бірақ мен біраз шаршадым.
Dialogue: 0,0:18:13.28,0:18:14.40,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:18:15.11,0:18:18.82,Default,,0,0,0,,Әй, ойланып қарасам, бірінші телефон соғу екен.
Dialogue: 0,0:18:18.82,0:18:19.78,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,0:18:19.78,0:18:22.33,Default,,0,0,0,,Е, аа, аа хмм.
Dialogue: 0,0:18:22.49,0:18:26.83,Default,,0,0,0,,Бүгін кешкі асқа қайсысын қалайсыз: карри ме, әлде ет картопы ма?
Dialogue: 0,0:18:27.46,0:18:28.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:30.17,0:18:31.79,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:34.80,0:18:35.80,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:36.21,0:18:37.63,Default,,0,0,0,,Еттен жасалған картоп жақсы.
Dialogue: 0,0:18:38.34,0:18:39.13,Default,,0,0,0,,Иә
Dialogue: 0,0:18:40.84,0:18:42.01,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:18:42.64,0:18:43.56,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:18:44.81,0:18:46.48,Default,,0,0,0,,Иә, мен бармын.
Dialogue: 0,0:18:47.77,0:18:49.19,Default,,0,0,0,,О, Гинко-чан?
Dialogue: 0,0:18:49.19,0:18:51.23,Default,,0,0,0,,Сіз әпкеңізбен танысқан сияқтысыз.
Dialogue: 0,0:18:51.69,0:18:52.56,Default,,0,0,0,,Иә
Dialogue: 0,0:18:52.90,0:18:54.90,Default,,0,0,0,,Жақсы, жеңілдеді
Dialogue: 0,0:18:54.90,0:18:55.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:55.61,0:18:57.78,Default,,0,0,0,,Ум... у...
Dialogue: 0,0:18:58.03,0:19:00.86,Default,,0,0,0,,Телефонды пайдаланғаны үшін кешірім сұраймыз.
Dialogue: 0,0:19:02.12,0:19:05.04,Default,,0,0,0,,Мен сені қорқынышты сезіндім деп ойлаймын...
Dialogue: 0,0:19:05.33,0:19:07.54,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:19:07.54,0:19:12.17,Default,,0,0,0,,Сондай-ақ, маған ұялы телефон алуға рұқсат берілді.
Dialogue: 0,0:19:12.17,0:19:14.75,Default,,0,0,0,,Түсіндім, бұл жақсы.
Dialogue: 0,0:19:14.96,0:19:16.51,Default,,0,0,0,,Ертең кездескенше.
Dialogue: 0,0:19:16.63,0:19:17.38,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:19:18.59,0:19:20.68,Default,,0,0,0,,Гинко-чанның да ұялы телефоны бар.
Dialogue: 0,0:19:20.68,0:19:21.97,Default,,0,0,0,,Сізге жақсы.
Dialogue: 0,0:19:23.18,0:19:23.89,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:23.97,0:19:24.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:25.22,0:19:27.89,Default,,0,0,0,,Әй, әпке... Кешкі газет...
Dialogue: 0,0:19:28.98,0:19:31.23,Default,,0,0,0,,Мен велосипедімді далада қалдырдым...
Dialogue: 0,0:19:34.02,0:19:36.02,Default,,0,0,0,,Қазір сәттілік.
Dialogue: 0,0:19:36.23,0:19:38.74,Default,,0,0,0,,Мен еттен дәмді картоп жасаймын.
Dialogue: 0,0:19:44.41,0:19:46.70,Default,,0,0,0,,Әпке, амансыз ба?
Dialogue: 0,0:19:46.70,0:19:48.41,Default,,0,0,0,,Кешіріңіз! (Жартылай жұмыс істейтін қызметкер) Ә?
Dialogue: 0,0:19:53.54,0:19:57.96,Default,,0,0,0,,О, тамагояки тағы да дәмді болды деп айтуды ұмытып кетіппін.
Dialogue: 0,0:20:03.26,0:20:04.76,Default,,0,0,0,,Сәлеметсіз бе, әпке?
Dialogue: 0,0:20:04.76,0:20:07.01,Default,,0,0,0,,А, ертең.
Dialogue: 0,0:20:07.35,0:20:09.43,Default,,0,0,0,,Не болды? Бірдеңе болды ма?
Dialogue: 0,0:20:09.52,0:20:10.93,Default,,0,0,0,,Ах, мен өзімді нашар сезінемін...
Dialogue: 0,0:20:10.93,0:20:14.15,Default,,0,0,0,,Бүгінгі таңғы жұмыртқа орамы өте дәмді болды.
Dialogue: 0,0:20:15.61,0:20:16.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:16.82,0:20:17.69,Default,,0,0,0,,Барлығы осы
Dialogue: 0,0:20:17.94,0:20:20.44,Default,,0,0,0,,Ертең саған айтқым келгені осы болды.
Dialogue: 0,0:20:21.07,0:20:24.45,Default,,0,0,0,,Ертең бәрі үшін рахмет
Dialogue: 0,0:20:25.24,0:20:28.70,Default,,0,0,0,,Өзіңізді қатты итермеңіз, әпке.
Dialogue: 0,0:20:30.37,0:20:32.29,Simai's OS,,0,0,0,,Кішкене оқиға болды.
Dialogue: 0,0:20:32.87,0:20:35.58,Simai's OS,,0,0,0,,Мен бұл менің жұмақтағы анам екеніне сенімдімін.
Dialogue: 0,0:20:35.58,0:20:39.05,Simai's OS,,0,0,0,,Мен бұл сіздің бізге берген сыйлық деп ойладым.
Dialogue: 0,0:20:40.17,0:20:44.13,Simai's OS,,0,0,0,,Маған көбірек демалу керек екенін айтып жатқандай болдым.
Dialogue: 0,0:20:44.89,0:20:47.76,Simai's OS,,0,0,0,,Анам және ертең
Dialogue: 0,0:20:51.56,0:20:52.98,Default,,0,0,0,,Иә өшірулі
Dialogue: 0,0:20:52.98,0:20:56.86,Default,,0,0,0,,Жоқ, сіз оны қатарынан 50 рет жіберіп алдыңыз.
Dialogue: 0,0:20:57.19,0:20:59.98,Default,,0,0,0,,Мен толқып тұрмын, бірақ мен нені қалаймын?
Dialogue: 0,0:21:00.23,0:21:01.99,Default,,0,0,0,,Үшінші класты ұялы телефон
Dialogue: 0,0:21:02.03,0:21:06.03,Default,,0,0,0,,Эхехе, әпке, менде бұдан былай сәттілік билеті жоқ...
Dialogue: 0,0:21:06.41,0:21:09.20,Default,,0,0,0,,Олай болса дүкенге барып, билет алыңыз.
Dialogue: 0,0:21:09.53,0:21:10.08,Default,,0,0,0,,Иә
Dialogue: 0,0:21:11.37,0:21:13.79,Default,,0,0,0,,Қатысушылар үшін мен мұны әлі де жасаймын.
Dialogue: 0,0:21:15.21,0:21:19.34,Simai's OS,,0,0,0,,Құрметті әпке, ұялы телефоныңызды пайдалануға рұқсат бергеніңіз үшін рахмет.
Dialogue: 0,0:21:19.63,0:21:24.09,Simai's OS,,0,0,0,,Оны әдеттегідей сатып алу арзанырақ.
Dialogue: 0,0:21:46.57,0:21:50.70,EDJap,,0,0,0,,Жазықсыз әңгіме
Dialogue: 0,0:21:51.08,0:21:55.29,EDJap,,0,0,0,,Тіпті кенет тоқтап қалса да
Dialogue: 0,0:21:55.54,0:21:59.54,EDJap,,0,0,0,,Осылай жаныңда болу арқылы
Dialogue: 0,0:21:59.75,0:22:03.17,EDJap,,0,0,0,,Өзіңізді қауіпсіз сезініңіз
Dialogue: 0,0:22:04.51,0:22:08.89,EDJap,,0,0,0,,Маңдайыңызды ақырын сипау
Dialogue: 0,0:22:08.89,0:22:12.93,EDJap,,0,0,0,,Самал сияқты
Dialogue: 0,0:22:13.27,0:22:17.06,EDJap,,0,0,0,,Қолды мықтап ұстағанда
Dialogue: 0,0:22:17.64,0:22:22.19,EDJap,,0,0,0,,Еңіспен жүгірейік
Dialogue: 0,0:22:22.19,0:22:25.99,EDJap,,0,0,0,,Ертең де қызық болады.
Dialogue: 0,0:22:26.61,0:22:31.03,EDJap,,0,0,0,,Сапқа тұрайық
Dialogue: 0,0:22:31.16,0:22:35.04,EDJap,,0,0,0,,Тығыз, мықтап, Жел ұстасаң
Dialogue: 0,0:22:35.66,0:22:40.17,EDJap,,0,0,0,,Екі қолымды жайып, жеткізгім келеді.
Dialogue: 0,0:22:40.17,0:22:44.00,EDJap,,0,0,0,,Тығыз, мықтап, ертең және болашақта да
Dialogue: 0,0:22:44.67,0:22:51.34,EDJap,,0,0,0,,Қатар жүрейік, бірге барайық
Dialogue: 0,0:22:57.81,0:23:00.48,Default,,0,0,0,,Ертең Анаң есіңде ме?
Dialogue: 0,0:23:00.73,0:23:03.90,Default,,0,0,0,,Мен өзімді уәде бергендей сезінемін.
Dialogue: 0,0:23:04.32,0:23:05.98,Default,,0,0,0,,Бейшара апалар әңгімесі
Dialogue: 0,0:23:06.32,0:23:08.53,Simai's OS,,0,0,0,,Суық, уәде және аналар күні
Dialogue: 0,0:23:08.82,0:23:10.36,Default,,0,0,0,,Қарап көріңіз
Dialogue: 0,0:04:47.22,0:04:51.47,generic sign style,,0,0,0,,Эмоциялар күні,
Dialogue: 1,0:04:47.22,0:04:51.47,generic sign style,,0,0,0,,Эмоциялар күні,
Dialogue: 2,0:04:47.22,0:04:51.47,generic sign style,,0,0,0,,Эмоциялар күні,
Dialogue: 3,0:04:47.22,0:04:51.47,generic sign style,,0,0,0,,Эмоциялар күні,
Dialogue: 0,0:04:47.22,0:04:51.47,generic sign style,,0,0,0,,Мазасыздық және ұялы телефондар
Dialogue: 1,0:04:47.22,0:04:51.47,generic sign style,,0,0,0,,Мазасыздық және ұялы телефондар
Dialogue: 2,0:04:47.22,0:04:51.47,generic sign style,,0,0,0,,Мазасыздық және ұялы телефондар
Dialogue: 3,0:04:47.22,0:04:51.47,generic sign style,,0,0,0,,Мазасыздық және ұялы телефондар
Dialogue: 0,0:11:00.97,0:11:08.98,generic sign style,,0,0,0,,Біздің жалғыз мақсатымыз - дүкен-жабылу-сатылымға уақытында жету.
Dialogue: 0,0:11:00.97,0:11:08.98,generic sign style,,0,0,0,,Жарты баға!
Dialogue: 0,0:11:00.97,0:11:08.98,generic sign style,,0,0,0,,50% жеңілдік
Dialogue: 0,0:11:08.98,0:11:17.48,generic sign style,,0,0,0,,Жалақы күні біз үш гарнирден тұратын сәнді кешкі ас іше аламыз.
Dialogue: 0,0:12:54.83,0:12:57.92,Dialogue,,0,0,0,,Қабылданбаған қоңырау
Dialogue: 0,0:12:59.88,0:13:02.74,Dialogue,,0,0,0,,Қабылданбаған қоңырау
Dialogue: 0,0:13:33.83,0:13:33.87,Dialogue,,0,0,0,,Қабылданбаған қоңырау
Dialogue: 0,0:13:33.87,0:13:34.00,Dialogue,,0,0,0,,Қабылданбаған қоңырау
Dialogue: 0,0:13:34.00,0:13:34.12,Dialogue,,0,0,0,,Қабылданбаған қоңырау
Dialogue: 0,0:13:34.12,0:13:34.16,Dialogue,,0,0,0,,Қабылданбаған қоңырау
Dialogue: 0,0:13:34.16,0:13:34.25,Dialogue,,0,0,0,,Қабылданбаған қоңырау
Dialogue: 0,0:13:34.25,0:13:34.37,Dialogue,,0,0,0,,Қабылданбаған қоңырау
Dialogue: 0,0:13:34.37,0:13:34.50,Dialogue,,0,0,0,,Қабылданбаған қоңырау
Dialogue: 0,0:13:34.50,0:13:34.62,Dialogue,,0,0,0,,Қабылданбаған қоңырау
Dialogue: 0,0:13:34.62,0:13:34.75,Dialogue,,0,0,0,,Қабылданбаған қоңырау
Dialogue: 0,0:13:34.75,0:13:34.87,Dialogue,,0,0,0,,Қабылданбаған қоңырау
Dialogue: 0,0:13:34.87,0:13:35.00,Dialogue,,0,0,0,,Қабылданбаған қоңырау
Dialogue: 0,0:13:35.00,0:13:35.12,Dialogue,,0,0,0,,Қабылданбаған қоңырау
Dialogue: 0,0:13:35.12,0:13:35.25,Dialogue,,0,0,0,,Қабылданбаған қоңырау
Dialogue: 0,0:13:35.25,0:13:35.37,Dialogue,,0,0,0,,Қабылданбаған қоңырау
Dialogue: 0,0:14:16.62,0:14:22.80,Dialogue,,0,0,0,,Оңтүстік-Шығыс газеті
Dialogue: 0,0:00:12.52,0:00:14.32,Dialogue,,0,0,0,,Бізде жеңімпаз бар!
Dialogue: 0,0:00:14.74,0:00:16.76,Dialogue,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:00:19.30,0:00:20.31,Dialogue,,0,0,0,,Мен түсіндім...
Dialogue: 0,0:00:20.31,0:00:22.63,Dialogue,,0,0,0,,Дұрыс, үшінші жүлде!
Dialogue: 0,0:00:22.63,0:00:26.74,Dialogue,,0,0,0,,Көрейік, үшінші жүлде... Бұл қайсысы болды?
Dialogue: 0,0:00:26.74,0:00:28.59,Dialogue,,0,0,0,,Міне, міне!
Dialogue: 0,0:00:28.59,0:00:30.10,Dialogue,,0,0,0,,Тада!
Dialogue: 0,0:00:30.10,0:00:32.72,Dialogue,,0,0,0,,Бұл өз түрінің ең жақсысы және олар жиынтықта келеді!
Dialogue: 0,0:00:32.72,0:00:34.72,Dialogue,,0,0,0,,Бұл керемет емес пе!?
Dialogue: 0,0:00:35.03,0:00:36.93,Dialogue-italic,,0,0,0,,Содан кейін мен ойладым:
Dialogue: 0,0:00:37.40,0:00:43.26,Dialogue-italic,,0,0,0,,«Бұл аспандағы анамның Асу екеумізге берген сыйлары».
Dialogue: 0,0:00:47.88,0:00:49.32,Dialogue,,0,0,0,,Мен үйдемін.
Dialogue: 0,0:00:49.62,0:00:53.07,Dialogue,,0,0,0,,Үйге қош келдіңіз, Они Чан. Барлық еңбектеріңізге рахмет.
Dialogue: 0,0:00:53.07,0:00:55.04,Dialogue,,0,0,0,,Таңғы ас дайын!
Dialogue: 0,0:00:55.04,0:00:56.20,Dialogue,,0,0,0,,Рахмет…
Dialogue: 0,0:00:59.48,0:01:01.78,Dialogue,,0,0,0,,Шаршадым...
Dialogue: 0,0:01:07.16,0:01:08.44,Dialogue,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:01:08.86,0:01:11.44,Dialogue,,0,0,0,,Бұл жақсы. Жақсысың ба, Они Чан?
Dialogue: 0,0:01:11.44,0:01:12.18,Dialogue,,0,0,0,,Иә.
Dialogue: 0,0:01:13.98,0:01:16.57,Dialogue,,0,0,0,,Мен аздап алшақтап жатырмын.
Dialogue: 0,0:01:16.96,0:01:18.30,Dialogue,,0,0,0,,Бұл орындалмайды.
Dialogue: 0,0:01:19.48,0:01:22.06,Dialogue,,0,0,0,,Мен бетімді жууға барамын. Мен бірден қайтамын.
Dialogue: 0,0:01:31.90,0:01:33.28,Dialogue,,0,0,0,,Onee-chan.
Dialogue: 0,0:01:34.81,0:01:37.86,Dialogue,,0,0,0,,Менің ойымша, көпшілік алдында есінеу жаман әдет, иә?
Dialogue: 0,0:01:37.86,0:01:39.30,Dialogue,,0,0,0,,Жоқ, бұл менің айтқым келгенім емес...
Dialogue: 0,0:01:39.30,0:01:41.40,Dialogue,,0,0,0,,Эй, мен жақсымын, мен жақсымын.
Dialogue: 0,0:01:41.40,0:01:43.08,Dialogue,,0,0,0,,Жақсы, мен сені кейін көремін. мен кеттім.
Dialogue: 0,0:01:43.66,0:01:47.04,Dialogue,,0,0,0,,Әй, абай бол және көшеден өтпес бұрын тексеруді ұмытпа, жарай ма?
Dialogue: 0,0:01:47.04,0:01:49.08,Dialogue,,0,0,0,,Иә, менде бәрі жақсы болады!
Dialogue: 0,0:01:50.48,0:01:53.38,Dialogue,,0,0,0,,Мен Асуды мен үшін тағы да алаңдатып отырмын деп ойлаймын.
Dialogue: 0,0:01:53.38,0:01:55.32,Dialogue,,0,0,0,,Маған көбірек тырысу керек.
Dialogue: 0,0:01:55.94,0:02:00.55,Dialogue-italic,,0,0,0,,Келесі аудандағы қағаз бала жұмыстан кеткеннен бері,
Dialogue: 0,0:02:01.28,0:02:06.02,Dialogue-italic,,0,0,0,,Олар алмастырушыны тапқанша, мен оны толтырумен көп айналыстым.
Dialogue: 0,0:02:07.05,0:02:08.14,Dialogue,,0,0,0,,Әй, Асу!
Dialogue: 0,0:02:11.42,0:02:13.94,Dialogue-italic,,0,0,0,,Мен оған тағы айтуды ұмытып кетіппін.
Dialogue: 0,0:02:13.94,0:02:17.47,Dialogue,,0,0,0,,Оның таңғы асқа жасаған маринадталған қияры өте дәмді болды.
Dialogue: 0,0:02:23.16,0:02:25.95,Dialogue,,0,0,0,,Үшінші жүлде!
Dialogue: 0,0:02:25.95,0:02:27.54,Dialogue,,0,0,0,,Құттықтаймын, Асу-чан!
Dialogue: 0,0:02:27.54,0:02:31.36,Dialogue,,0,0,0,,Бұл үшінші жүлде! Ол жиынтық ретінде келеді!
Dialogue: 0,0:02:31.86,0:02:33.78,Dialogue,,0,0,0,,Премиум, алдын ала төленген ұялы телефондар!
Dialogue: 0,0:02:33.78,0:02:35.30,Dialogue,,0,0,0,,SIM карталары қосылған.
Dialogue: 0,0:02:35.30,0:02:38.10,Dialogue,,0,0,0,,Енді мынаны жинап алайық.
Dialogue: 0,0:02:38.10,0:02:40.50,Dialogue,,0,0,0,,C-Осыларды шынымен ала аламын ба?
Dialogue: 0,0:02:40.50,0:02:41.53,Dialogue,,0,0,0,,Әрине!
Dialogue: 0,0:02:53.26,0:02:57.10,Dialogue,,0,0,0,,Анам Асу туылған жылы жұмаққа аттанды.
Dialogue: 0,0:02:57.45,0:03:00.78,Dialogue,,0,0,0,,Әкем құмар ойындарға қарыздар жинап, жоғалып кетті.
Dialogue: 0,0:03:01.40,0:03:04.60,Dialogue,,0,0,0,,Осылайша бізді тастап кетті.
Dialogue: 0,0:03:05.76,0:03:09.77,Dialogue,,0,0,0,,Бұл 40 жастағы, бір бөлмелі, моншасы жоқ, тозығы жеткен пәтер.
Dialogue: 0,0:03:09.77,0:03:12.22,Dialogue,,0,0,0,,Бұл біздің үй.
Dialogue: 0,0:03:12.22,0:03:14.70,Dialogue,,0,0,0,,Бірақ көктем келгенде…
Dialogue: 0,0:04:52.91,0:04:53.85,Dialogue,,0,0,0,,Асу!
Dialogue: 0,0:04:53.85,0:04:56.02,Dialogue,,0,0,0,,W-Неліктен бізде бұлар бар?
Dialogue: 0,0:04:56.38,0:04:58.62,Dialogue,,0,0,0,,Бүгін сауда ауданында ұтыс ойыны өтті.
Dialogue: 0,0:04:58.62,0:05:01.04,Dialogue,,0,0,0,,Бұлар шынайы, солай ма, Они-чан?
Dialogue: 0,0:05:02.70,0:05:03.65,Dialogue,,0,0,0,,Onee-chan?
Dialogue: 0,0:05:04.07,0:05:06.11,Dialogue,,0,0,0,,Ұялы... телефондар?
Dialogue: 0,0:05:06.11,0:05:08.80,Dialogue,,0,0,0,,Ұялы телефон сізбен бірге алып жүруге болатынын білдіреді, солай ма?
Dialogue: 0,0:05:09.64,0:05:14.24,Dialogue,,0,0,0,,Мен әрқашан бұл тек қиялдар мен хикаяларда болатын мистикалық құрылғылар деп ойладым!
Dialogue: 0,0:05:14.24,0:05:16.17,Dialogue,,0,0,0,,Жоқ, сіз тым асыра айтып жатырсыз...
Dialogue: 0,0:05:16.17,0:05:17.39,Dialogue,,0,0,0,,Әй, бұл түс пе?!
Dialogue: 0,0:05:17.39,0:05:18.92,Dialogue,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:05:19.78,0:05:21.11,Dialogue,,0,0,0,,Олай болса,
Dialogue: 0,0:05:21.11,0:05:23.32,Dialogue,,0,0,0,,Мен оларды қалай пайдалану керек екеніне таңғаламын.
Dialogue: 0,0:05:23.32,0:05:26.58,Dialogue,,0,0,0,,Көрейік. Оны қосу үшін... түймесін басу керек.
Dialogue: 0,0:05:26.58,0:05:27.61,Dialogue,,0,0,0,,Бұл жерде ме?
Dialogue: 0,0:05:27.61,0:05:28.30,Dialogue,,0,0,0,,Қайда, қайда?
Dialogue: 0,0:05:28.30,0:05:29.68,Dialogue,,0,0,0,,Осыдан кейін,
Dialogue: 0,0:05:29.68,0:05:36.14,Dialogue,,0,0,0,,иә, алдын ала төленген жоспар бізге үш айда пайдалану үшін 3000 иен тұратын минуттар береді.
Dialogue: 0,0:05:36.14,0:05:37.48,Dialogue,,0,0,0,,3000 иен құны?
Dialogue: 0,0:05:37.48,0:05:39.48,Dialogue,,0,0,0,,Ей, келесі бөлімді қараңыз.
Dialogue: 0,0:05:39.48,0:05:41.54,Dialogue,,0,0,0,,«Нөмірді енгізіңіз және…»
Dialogue: 0,0:05:41.54,0:05:42.55,Dialogue,,0,0,0,,Содан кейін…
Dialogue: 0,0:05:44.67,0:05:46.53,Dialogue,,0,0,0,,Олар қазір пайдалануға дайын ба деп ойлаймын.
Dialogue: 0,0:05:46.53,0:05:48.66,Dialogue,,0,0,0,,Они-чан, маған қоңырау шалып көріңіз.
Dialogue: 0,0:05:48.66,0:05:50.22,Dialogue,,0,0,0,,О-Жарайды.
Dialogue: 0,0:05:54.27,0:05:56.10,Dialogue,,0,0,0,,Қоңырау соғуда!
Dialogue: 0,0:05:56.10,0:05:57.73,Dialogue,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:05:57.73,0:05:59.26,Dialogue,,0,0,0,,Сәлеметсіз бе.
Dialogue: 0,0:06:03.19,0:06:04.88,Dialogue,,0,0,0,,Бұл солай болуы керек пе?
Dialogue: 0,0:06:08.64,0:06:10.02,Dialogue,,0,0,0,,Сіз телефонды қойдыңыз ба?
Dialogue: 0,0:06:10.02,0:06:11.65,Dialogue,,0,0,0,,Бұл жақын қоңырау болды!
Dialogue: 0,0:06:11.65,0:06:12.45,Dialogue,,0,0,0,,Не болды?
Dialogue: 0,0:06:12.45,0:06:14.66,Dialogue,,0,0,0,,Бізде оларды пайдалану үшін шектеулі минуттар бар!
Dialogue: 0,0:06:15.18,0:06:18.35,Dialogue,,0,0,0,,3000 иен құны. Біз оларды тек маңызды нәрселер үшін пайдалануымыз керек.
Dialogue: 0,0:06:18.73,0:06:21.16,Dialogue,,0,0,0,,О, дұрыс айтасың деп ойлаймын.
Dialogue: 0,0:06:30.99,0:06:33.23,Dialogue,,0,0,0,,Они Чан, жақсысың ба?
Dialogue: 0,0:06:34.19,0:06:36.47,Dialogue,,0,0,0,,Мен мұны қайтадан істеп жатқан сияқтымын, иә? Иә, менде бәрі жақсы!
Dialogue: 0,0:06:36.47,0:06:39.24,Dialogue,,0,0,0,,Плюс, бүгіннен бастап бізде бұлар бар емес пе?
Dialogue: 0,0:06:39.24,0:06:40.58,Dialogue,,0,0,0,,Тада!
Dialogue: 0,0:06:45.59,0:06:48.66,Dialogue,,0,0,0,,Бірдеңе болып қалса, маған дереу қоңырау шалыңыз, жарай ма?
Dialogue: 0,0:06:48.66,0:06:49.80,Dialogue,,0,0,0,,Сен де, Они Чан.
Dialogue: 0,0:06:50.38,0:06:52.06,Dialogue,,0,0,0,,Олай болса, мен кеттім!
Dialogue: 0,0:06:53.09,0:06:54.86,Dialogue-italic,,0,0,0,,Мен бүгін тағы шаршадым.
Dialogue: 0,0:06:58.80,0:07:00.46,Dialogue,,0,0,0,,Мен оған тағы да рахмет айтуды ұмытып кетіппін,
Dialogue: 0,0:07:00.46,0:07:02.94,Dialogue,,0,0,0,,тофу-мисо сорпасы өте керемет болса да.
Dialogue: 0,0:07:06.64,0:07:10.49,Dialogue,,0,0,0,,О, дұрыс. Мен сабақта телефонымды өшіруім керек.
Dialogue: 0,0:07:13.70,0:07:15.74,Dialogue,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:07:15.74,0:07:17.55,Dialogue,,0,0,0,,Гинко-чан, қайырлы таң.
Dialogue: 0,0:07:17.55,0:07:18.48,Dialogue,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:07:18.48,0:07:20.40,Dialogue,,0,0,0,,Не? Сіз ұялы телефон сатып алдыңыз ба?
Dialogue: 0,0:07:20.40,0:07:24.34,Dialogue,,0,0,0,,Бұл? Жоқ, мен оны сауда ауданындағы ұтыс ойынында ұтып алдым.
Dialogue: 0,0:07:26.16,0:07:27.28,Dialogue,,0,0,0,,Ұтыс ойыны…
Dialogue: 0,0:07:28.58,0:07:33.00,Dialogue,,0,0,0,,Менің әпкемнің де телефоны бар, ол осы телефонға қарағанда әлдеқайда әдемі және жақсырақ.
Dialogue: 0,0:07:33.00,0:07:35.18,Dialogue,,0,0,0,,Ал мен орта мектеп оқушысы болғанда,
Dialogue: 0,0:07:35.18,0:07:39.62,Dialogue,,0,0,0,,Они-сама маған өзінікіндей сәнді сатып алады!
Dialogue: 0,0:07:41.00,0:07:44.03,Dialogue,,0,0,0,,Ей, біреу сенімен сөйлескенде тыңдау керек! Сен не істеп жатырсың?
Dialogue: 0,0:07:44.03,0:07:47.81,Dialogue,,0,0,0,,Мен оны қалай өшіру керектігін ұмытып қалдым. Нұсқаулық не істеу керек еді?
Dialogue: 0,0:07:47.81,0:07:49.56,Dialogue,,0,0,0,,Мұны қалай істеу керектігін білмейсіз бе?
Dialogue: 0,0:07:49.56,0:07:52.28,Dialogue,,0,0,0,,Бұл түймені бірнеше секунд басып тұрыңыз.
Dialogue: 0,0:07:52.78,0:07:55.24,Dialogue,,0,0,0,,Гинко-чан, сен кереметсің! Рахмет!
Dialogue: 0,0:07:55.24,0:07:58.62,Dialogue,,0,0,0,,Мен әпкемді үнемі бақылап отырамын, сондықтан мен мұндай нәрселер туралы бәрін білемін!
Dialogue: 0,0:07:58.62,0:08:01.52,Dialogue,,0,0,0,,Түсінбеген басқа бір нәрсеңіз болса, менен көмек сұраңыз.
Dialogue: 0,0:08:01.52,0:08:04.12,Dialogue,,0,0,0,,Жарайды, рахмет! Кейінірек кездесеміз.
Dialogue: 0,0:08:06.04,0:08:07.88,Dialogue,,0,0,0,,Қандай бақыт... ұялы телефон.
Dialogue: 0,0:08:15.31,0:08:17.66,Dialogue,,0,0,0,,Бүгін Асу телефон соқпады, ә?
Dialogue: 0,0:08:19.20,0:08:21.68,Dialogue,,0,0,0,,Мен оны шақырсам ба деп ойлаймын.
Dialogue: 0,0:08:24.44,0:08:27.15,Dialogue,,0,0,0,,Они-чан әлі қоңырау шалмады, иә?
Dialogue: 0,0:08:27.15,0:08:29.31,Dialogue,,0,0,0,,Мүмкін мен оған қоңырау шалуым керек шығар.
Dialogue: 0,0:08:30.11,0:08:31.99,Dialogue,,0,0,0,,Жоқ, жоқ, бұл ысырап болар еді!
Dialogue: 0,0:08:38.93,0:08:45.99,Dialogue-italic,,0,0,0,,Бір минут күте тұрыңыз, мүмкін, біз оларды шынымен пайдалануымыз керек болатын уақыт келеді.
Dialogue: 0,0:08:45.99,0:08:51.63,Dialogue-italic,,0,0,0,,Егер мен қазір сөйлесетін маңызды ештеңе болмаған кезде қоңырау шалсам және бұл минуттар қолданылса...
Dialogue: 0,0:08:57.98,0:09:00.66,Dialogue,,0,0,0,,Сіз оны неге қолданбайсыз? Қаласаңыз, оған қоңырау шалуыңыз керек.
Dialogue: 0,0:09:00.66,0:09:02.88,Dialogue,,0,0,0,,Иә, дұрыс айтасыз деп ойлаймын.
Dialogue: 0,0:09:08.69,0:09:11.69,Dialogue-italic,,0,0,0,,«Кедей адамның санасы» деген осы шығар.
Dialogue: 0,0:09:13.69,0:09:15.92,Dialogue,,0,0,0,,Бізде бір апта болды, иә?
Dialogue: 0,0:09:15.92,0:09:16.84,Dialogue,,0,0,0,,Иә.
Dialogue: 0,0:09:16.84,0:09:19.53,Dialogue,,0,0,0,,Бірақ біз оларды әлі пайдаланбадық.
Dialogue: 0,0:09:19.53,0:09:20.42,Dialogue,,0,0,0,,Иә.
Dialogue: 0,0:09:20.98,0:09:23.90,Dialogue,,0,0,0,,Үш айдың осылай өтіп кетуіне жол берсек...
Dialogue: 0,0:09:23.90,0:09:26.68,Dialogue,,0,0,0,,Бұл одан да үлкен шығын болар еді, солай ма?
Dialogue: 0,0:09:28.84,0:09:31.80,Dialogue,,0,0,0,,Жарайды! Енді оларды еркінірек пайдаланаық!
Dialogue: 0,0:09:32.46,0:09:34.01,Dialogue,,0,0,0,,S-Әрине.
Dialogue: 0,0:09:34.26,0:09:38.48,Dialogue,,0,0,0,,Біз олармен ысырап етпеуіміз керек, әрине, бірдеңе болған жағдайда.
Dialogue: 0,0:09:38.48,0:09:43.62,Dialogue,,0,0,0,,Они-чан, егер солай айтсаң, біз оларды мүлдем қолданбай тағы бір апта өткіземіз.
Dialogue: 0,0:09:43.62,0:09:46.02,Dialogue,,0,0,0,,дұрыс айтасыз деп ойлаймын.
Dialogue: 0,0:09:48.06,0:09:49.88,Dialogue,,0,0,0,,Кешкі газеттер…
Dialogue: 0,0:09:50.25,0:09:52.78,Dialogue,,0,0,0,,Мен оянып, сыртқа шығып, бар күшімді салуым керек!
Dialogue: 0,0:09:55.49,0:09:57.34,Dialogue,,0,0,0,,Қуатты қосыңыз!
Dialogue: 0,0:09:57.76,0:09:59.14,Dialogue,,0,0,0,,Ямада-сан!
Dialogue: 0,0:09:59.14,0:09:59.91,Dialogue,,0,0,0,,Иә?
Dialogue: 0,0:09:59.91,0:10:01.48,Dialogue,,0,0,0,,Маған қол ұшын бере аласыз ба?
Dialogue: 0,0:10:01.48,0:10:02.58,Dialogue,,0,0,0,,Әрине!
Dialogue: 0,0:10:19.77,0:10:24.20,Dialogue-italic,,0,0,0,,Мектеп біткеніне қарамастан Они-чан жауап бермей жатыр.
Dialogue: 0,0:10:24.92,0:10:26.54,Dialogue-italic,,0,0,0,,Бірдеңе болуы мүмкін бе деп ойлаймын.
Dialogue: 0,0:10:27.96,0:10:29.80,Dialogue,,0,0,0,,Ах, Гинко-чан.
Dialogue: 0,0:10:29.80,0:10:31.81,Dialogue,,0,0,0,,Сонымен, сіз оны пайдалану үшін жүйкеңізді жинадыңыз ба?
Dialogue: 0,0:10:31.81,0:10:36.34,Dialogue,,0,0,0,,Иә, Они-чан екеуміз оларды біршама еркін пайдалануымыз керек деп шештік.
Dialogue: 0,0:10:36.34,0:10:40.95,Dialogue,,0,0,0,,Мен одан бүгін кешкі асқа карриді немесе ет пен картоп бұқтырмасын ұната ма деп сұрағым келді, бірақ...
Dialogue: 0,0:10:40.95,0:10:43.67,Dialogue,,0,0,0,,Екі ыдыстың да құрамы бірдей.
Dialogue: 0,0:10:44.76,0:10:48.79,Dialogue,,0,0,0,,Иә, Гинко-чан, бізге телефон соққың келсе, бара бер, жарай ма?
Dialogue: 0,0:10:49.34,0:10:51.16,Dialogue,,0,0,0,,Сіздің телефон нөмірлеріңіз…
Dialogue: 0,0:10:51.98,0:10:53.25,Dialogue,,0,0,0,,Әрине, егер маған ұнаса.
Dialogue: 0,0:10:55.16,0:10:58.68,Dialogue-italic,,0,0,0,,Қалай болғанда да, Они-чанға не болуы мүмкін еді?
Dialogue: 0,0:10:58.68,0:11:00.97,Dialogue-italic,,0,0,0,,Ол қатты шаршады, сондықтан мен қатты уайымдап тұрмын.
Dialogue: 0,0:11:23.90,0:11:25.48,Dialogue,,0,0,0,,Сіз оған қол жеткізе алмайсыз ба?
Dialogue: 0,0:11:25.48,0:11:27.45,Dialogue,,0,0,0,,Иә, бұл біртүрлі, солай емес пе...
Dialogue: 0,0:11:27.45,0:11:28.38,Dialogue,,0,0,0,,Сигнал бар ма?
Dialogue: 0,0:11:28.38,0:11:30.09,Dialogue,,0,0,0,,Менде ешқандай түсінік жоқ.
Dialogue: 0,0:11:30.09,0:11:32.48,Dialogue,,0,0,0,,Ол оны үйдегі кері байланыстыра алды.
Dialogue: 0,0:11:33.54,0:11:34.42,Dialogue,,0,0,0,,Олай болса,
Dialogue: 0,0:11:35.00,0:11:38.84,Dialogue,,0,0,0,,оның жұмыс істеп тұрғанын тексеру үшін апама қоңырау шалуға рұқсат етіңіз.
Dialogue: 0,0:11:39.76,0:11:41.18,Dialogue,,0,0,0,,Келіңіздер, байқап көрейін.
Dialogue: 0,0:11:43.62,0:11:44.76,Dialogue,,0,0,0,,H-Эй.
Dialogue: 0,0:11:54.28,0:11:55.28,Dialogue,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:11:56.14,0:11:58.52,Dialogue,,0,0,0,,Оне-сама, бұл Гинко.
Dialogue: 0,0:11:58.52,0:12:01.59,Dialogue,,0,0,0,,Иә, сізді кенеттен шақырғаным үшін кешіріңіз.
Dialogue: 0,0:12:01.59,0:12:03.06,Dialogue,,0,0,0,,Қазіргі уақытта сізде бәрі жақсы ма?
Dialogue: 0,0:12:03.06,0:12:06.25,Dialogue,,0,0,0,,Иә, иә. О, солай ма, Они-сама?
Dialogue: 0,0:12:07.64,0:12:09.14,Dialogue-italic,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:12:06.25,0:12:09.76,Dialogue,,0,0,0,,Мен оны сауда ауданындағы ұтыс ойынынан ұтып алғанын естідім, иә.
Dialogue: 0,0:12:10.14,0:12:11.96,Dialogue,,0,0,0,,Менің ойымша, бұл үшінші жүлде болды.
Dialogue: 0,0:12:12.48,0:12:13.14,Dialogue,,0,0,0,,Иә.
Dialogue: 0,0:12:12.48,0:12:16.66,Dialogue-italic,,0,0,0,,Мен де телефонда уайымсыз болсам ғой.
Dialogue: 0,0:12:14.50,0:12:15.19,Dialogue,,0,0,0,,У-у-у-у-у.
Dialogue: 0,0:12:16.96,0:12:17.54,Dialogue,,0,0,0,,Иә!
Dialogue: 0,0:12:18.20,0:12:20.38,Dialogue,,0,0,0,,Иә, көп рахмет.
Dialogue: 0,0:12:20.38,0:12:20.80,Dialogue,,0,0,0,,Иә.
Dialogue: 0,0:12:20.80,0:12:23.88,Dialogue-italic,,0,0,0,,Бұл ұзақ әңгімелесудің уақыты емес!
Dialogue: 0,0:12:23.88,0:12:26.52,Dialogue,,0,0,0,,А-а, Гинко-чан.
Dialogue: 0,0:12:26.52,0:12:28.86,Dialogue,,0,0,0,,Менің телефонымда осылай ұзақ сөйлесетін болсаңыз,
Dialogue: 0,0:12:28.86,0:12:32.74,Dialogue,,0,0,0,,иә, 3000 иендік шектеудің бәрі бітеді, сондықтан…
Dialogue: 0,0:12:32.74,0:12:34.14,Dialogue,,0,0,0,,Сіз тіпті тыңдамайсыз.
Dialogue: 0,0:12:34.14,0:12:34.99,Dialogue,,0,0,0,,Um…
Dialogue: 0,0:12:35.72,0:12:39.09,Dialogue,,0,0,0,,Иә, дұрыс, Они-сама. Ал содан кейін мен…
Dialogue: 0,0:12:39.09,0:12:42.78,Dialogue-italic,,0,0,0,,Иә... Соңғы кездері Они Чан қатты шаршады,
Dialogue: 0,0:12:42.78,0:12:44.82,Dialogue-italic,,0,0,0,,ол бәрібір ұзақ әңгімеге келмейтін шығар.
Dialogue: 0,0:12:47.37,0:12:48.88,Dialogue,,0,0,0,,А, иә.
Dialogue: 0,0:12:50.55,0:12:54.41,Dialogue-italic,,0,0,0,,Гинко-чан, сенің осылай толық сөйлескенің жақсы.
Dialogue: 0,0:12:55.61,0:12:56.93,Dialogue,,0,0,0,,Ямада-сан, рахмет.
Dialogue: 0,0:12:56.93,0:12:57.92,Dialogue,,0,0,0,,Әрине!
Dialogue: 0,0:12:58.34,0:12:59.88,Dialogue,,0,0,0,,Хм, бұл не?
Dialogue: 0,0:13:00.40,0:13:02.72,Dialogue,,0,0,0,,А, мен қоңырауды өткізіп алдым.
Dialogue: 0,0:13:02.74,0:13:04.36,Dialogue,,0,0,0,,Бұл Асудан!
Dialogue: 0,0:13:09.87,0:13:11.58,Dialogue,,0,0,0,,Не? Бос емес пе?
Dialogue: 0,0:13:12.08,0:13:15.08,Dialogue,,0,0,0,,Жарайды. Бұл сауда аймағынан алынған майлық қағаз ба?
Dialogue: 0,0:13:15.08,0:13:16.21,Dialogue,,0,0,0,,Жарайды.
Dialogue: 0,0:13:16.21,0:13:17.71,Dialogue,,0,0,0,,Иә.
Dialogue: 0,0:13:18.23,0:13:20.76,Dialogue,,0,0,0,,Сіз темекі дүкенінің бұрышын бұрасыз, солай ма?
Dialogue: 0,0:13:20.76,0:13:21.88,Dialogue,,0,0,0,,Әй, м...
Dialogue: 0,0:13:24.01,0:13:25.60,Dialogue,,0,0,0,,Иә, мен мұны істеймін!
Dialogue: 0,0:13:25.60,0:13:27.78,Dialogue,,0,0,0,,Олай болса, әзірше қош бол, Оне-сама.
Dialogue: 0,0:13:28.90,0:13:29.81,Dialogue,,0,0,0,,Рахмет.
Dialogue: 0,0:13:35.37,0:13:37.17,Dialogue,,0,0,0,,Они-чан қоңырау шалды, иә?
Dialogue: 0,0:13:43.52,0:13:44.63,Dialogue,,0,0,0,,Бұл Асудан!
Dialogue: 0,0:13:46.34,0:13:47.95,Dialogue,,0,0,0,,Сәлеметсіз бе, Асу?
Dialogue: 0,0:13:48.77,0:13:49.93,Dialogue,,0,0,0,,Ах, Они-чан...
Dialogue: 0,0:13:52.67,0:13:53.73,Dialogue,,0,0,0,,Асу?
Dialogue: 0,0:13:54.71,0:13:56.17,Dialogue,,0,0,0,,Не болды, Асу?
Dialogue: 0,0:14:00.06,0:14:01.34,Dialogue,,0,0,0,,Не болды?
Dialogue: 0,0:14:01.34,0:14:02.63,Dialogue,,0,0,0,,Ол кесілген.
Dialogue: 0,0:14:02.63,0:14:04.15,Dialogue,,0,0,0,,Батарея біткен сияқты.
Dialogue: 0,0:14:07.17,0:14:08.35,Dialogue,,0,0,0,,Um…
Dialogue: 0,0:14:08.84,0:14:13.36,Dialogue,,0,0,0,,Егер сіз оны дұрыс зарядтамасаңыз, батарея өте тез бітеді.
Dialogue: 0,0:14:16.27,0:14:21.99,Dialogue-italic,,0,0,0,,Сіз терген нөмір қазір қосылмаған немесе келесі ауқымда емес:
Dialogue: 0,0:14:22.80,0:14:26.53,Dialogue-italic,,0,0,0,,Ол қосылмайды. Не қате болуы мүмкін?
Dialogue: 0,0:14:26.53,0:14:28.36,Dialogue-italic,,0,0,0,,Мүмкін бірдеңе болған шығар.
Dialogue: 0,0:14:29.67,0:14:31.98,Dialogue-italic,,0,0,0,,Сіз терген нөмір ei—
Dialogue: 0,0:14:34.09,0:14:34.98,Dialogue-italic,,0,0,0,,Ах, Они Чан...
Dialogue: 0,0:14:37.95,0:14:39.56,Dialogue-italic,,0,0,0,,Бірдеңе болған болуы керек.
Dialogue: 0,0:14:43.69,0:14:46.57,Dialogue-italic,,0,0,0,,Бұл уақытта ол әрқашан сауда аймағында болады.
Dialogue: 0,0:14:47.35,0:14:49.86,Dialogue,,0,0,0,,Кешіріңіз! Мен бірден қайтамын!
Dialogue: 0,0:14:53.87,0:14:56.87,Dialogue-italic,,0,0,0,,Маған қызық Он Чан не туралы айтқысы келді.
Dialogue: 0,0:14:58.96,0:15:02.30,Dialogue-italic,,0,0,0,,Бүгін таңертең кеткенде ол өте ұйқышыл болып көрінді.
Dialogue: 0,0:15:02.30,0:15:05.17,Dialogue-italic,,0,0,0,,Мүмкін ол ауыра бастаған шығар?
Dialogue: 0,0:15:09.37,0:15:11.34,Dialogue,,0,0,0,,Айтыңызшы, егер сіз аккумуляторды қайта зарядтағыңыз келсе, менің үйімде:
Dialogue: 0,0:15:11.34,0:15:13.89,Dialogue,,0,0,0,,Иә? Ол қайда кетті?
Dialogue: 0,0:15:14.44,0:15:18.27,Dialogue-italic,,0,0,0,,Осы уақытқа дейін ол газет кеңсесінде болуы керек.
Dialogue: 0,0:15:18.88,0:15:23.17,Dialogue,,0,0,0,,О, Кёу Чан? Енді сіз бұл туралы айтқан кезде, ол мұнда жоқ сияқты, солай ма?
Dialogue: 0,0:15:23.17,0:15:26.24,Dialogue,,0,0,0,,Ол мұнда емес пе? Ол ешқашан келмеді дейсің бе?
Dialogue: 0,0:15:26.24,0:15:28.13,Dialogue,,0,0,0,,Сәлем, бастық! Мұнымен не істеуіміз керек?
Dialogue: 0,0:15:28.13,0:15:29.45,Dialogue,,0,0,0,,А, мен дәл сол жерде боламын.
Dialogue: 0,0:15:29.45,0:15:30.24,Dialogue,,0,0,0,,Um…
Dialogue: 0,0:15:30.93,0:15:34.66,Dialogue,,0,0,0,,Они-чан… Егер ол шынымен құлап қалса, ол кез келген жерде болуы мүмкін.
Dialogue: 0,0:15:35.82,0:15:39.00,Dialogue,,0,0,0,,Білесің бе, қазір ойлап қарасам, Кёу Чан біраз уақыт болды...
Dialogue: 0,0:15:39.00,0:15:41.71,Dialogue,,0,0,0,,Енді ол кетті.
Dialogue: 0,0:15:41.71,0:15:45.04,Dialogue,,0,0,0,,О, Асу-чан? Жоқ, мен оны бүгін әлі көрген жоқпын.
Dialogue: 0,0:15:45.04,0:15:46.21,Dialogue,,0,0,0,,Солай ма?
Dialogue: 0,0:15:46.21,0:15:48.92,Dialogue,,0,0,0,,Енді сіз бұл туралы айтып отырсыз, ол әдетте қазір осында, солай емес пе?
Dialogue: 0,0:15:48.92,0:15:51.09,Dialogue,,0,0,0,,Міне, келдің! Рақмет сізге!
Dialogue: 0,0:15:52.31,0:15:53.14,Dialogue,,0,0,0,,Иә?
Dialogue: 0,0:15:53.68,0:15:58.16,Dialogue-italic,,0,0,0,,Бұл біртүрлі. Асу маған әдейі олай тұтқаны қоймас еді.
Dialogue: 0,0:15:58.68,0:15:59.88,Dialogue-italic,,0,0,0,,Жоқ!
Dialogue: 0,0:15:59.88,0:16:01.19,Dialogue-italic,,0,0,0,,Оны ұрлап әкетті ме?!
Dialogue: 0,0:16:09.08,0:16:11.03,Dialogue-italic,,0,0,0,,Они-чан, сен қайда бола аласың?
Dialogue: 0,0:16:11.41,0:16:15.49,Dialogue-italic,,0,0,0,,Ол өзін жақсы сезінбеген шығар, сондықтан ол үйіне қайтты.
Dialogue: 0,0:16:15.49,0:16:17.84,Dialogue-italic,,0,0,0,,—қабылдау ауқымында емес немесе—
Dialogue: 0,0:16:18.91,0:16:19.95,Dialogue-italic,,0,0,0,,Асу!
Dialogue: 0,0:16:24.54,0:16:26.00,Dialogue,,0,0,0,,Onee-chan!
Dialogue: 0,0:16:33.55,0:16:35.35,Dialogue-italic,,0,0,0,,Сізде бар нөмір—
Dialogue: 0,0:16:35.35,0:16:36.55,Dialogue,,0,0,0,,Келіңіздер!
Dialogue: 0,0:16:40.44,0:16:43.61,Dialogue-italic,,0,0,0,,Они-чан, Они-чан, қайдасың?!
Dialogue: 0,0:16:45.27,0:16:47.11,Dialogue-italic,,0,0,0,,Onee-chan!
Dialogue: 0,0:16:47.44,0:16:49.07,Dialogue-italic,,0,0,0,,Onee-chan!
Dialogue: 0,0:16:49.76,0:16:51.41,Dialogue-italic,,0,0,0,,Onee-chan!
Dialogue: 0,0:16:51.41,0:16:53.24,Dialogue-italic,,0,0,0,,Onee-chan!
Dialogue: 0,0:16:54.45,0:16:58.66,Dialogue,,0,0,0,,Келіңіздер! Енді бізде ұялы телефондар бар, олар мұндай уақытта қалай жұмыс істемейді?!
Dialogue: 0,0:16:59.41,0:17:01.37,Dialogue,,0,0,0,,Onee-chan!
Dialogue: 0,0:17:02.95,0:17:03.83,Dialogue,,0,0,0,,Асу!
Dialogue: 0,0:17:05.26,0:17:06.64,Dialogue,,0,0,0,,Асу!!
Dialogue: 0,0:17:21.12,0:17:21.76,Dialogue,,0,0,0,,Onee-chan!
Dialogue: 0,0:17:21.76,0:17:22.68,Dialogue,,0,0,0,,Асу!
Dialogue: 0,0:17:25.01,0:17:26.51,Dialogue,,0,0,0,,Onee-chan!
Dialogue: 0,0:17:26.51,0:17:27.87,Dialogue,,0,0,0,,Асу!
Dialogue: 0,0:17:27.87,0:17:31.59,Dialogue,,0,0,0,,Құдайға шүкір! Сіз бәрібір құлаған жоқсыз.
Dialogue: 0,0:17:31.59,0:17:35.89,Dialogue,,0,0,0,,Сізге де солай. Сіз ұрланған жоқсыз.
Dialogue: 0,0:17:40.56,0:17:42.54,Dialogue,,0,0,0,,Құдайға шүкір.
Dialogue: 0,0:17:44.80,0:17:46.23,Dialogue,,0,0,0,,Onee-chan.
Dialogue: 0,0:17:57.19,0:18:01.47,Dialogue,,0,0,0,,Шынымен бе? Қосыла алмаған себебім, батареяның бітуі болды ма?
Dialogue: 0,0:18:01.47,0:18:04.44,Dialogue,,0,0,0,,Иә, көп нәрсе болды.
Dialogue: 0,0:18:04.44,0:18:08.99,Dialogue,,0,0,0,,Дәл осы жерде. Қоңырауыңызға жауап беруге келмедім.
Dialogue: 0,0:18:08.99,0:18:12.98,Dialogue,,0,0,0,,Сайып келгенде, мұның бәрі кездейсоқ болды, бірақ бұл бізді тоздырды.
Dialogue: 0,0:18:12.98,0:18:14.74,Dialogue,,0,0,0,,Әрине.
Dialogue: 0,0:18:14.74,0:18:19.51,Dialogue,,0,0,0,,О, осы тақырып бойынша, сіз бірінші рет не туралы қоңырау шалдыңыз?
Dialogue: 0,0:18:19.51,0:18:26.82,Dialogue,,0,0,0,,Мен сізден бүгін кешкі асқа карри немесе ет пен картоп бұқтырылғанды ​​ұнатасыз ба деп сұрағым келді.
Dialogue: 0,0:18:29.79,0:18:31.64,Dialogue,,0,0,0,,Мұның бәрі шынымен бе?
Dialogue: 0,0:18:34.53,0:18:35.93,Dialogue,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:18:35.93,0:18:37.32,Dialogue,,0,0,0,,Ет пен картоп бұқтырмасы керемет естіледі.
Dialogue: 0,0:18:38.01,0:18:38.96,Dialogue,,0,0,0,,Жарайды.
Dialogue: 0,0:18:40.48,0:18:42.26,Dialogue,,0,0,0,,Бұл кім болуы мүмкін?
Dialogue: 0,0:18:42.26,0:18:43.36,Dialogue,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:18:44.43,0:18:46.16,Dialogue,,0,0,0,,О, ол дәл осында.
Dialogue: 0,0:18:47.47,0:18:48.41,Dialogue,,0,0,0,,Гинко-чан?
Dialogue: 0,0:18:48.91,0:18:51.34,Dialogue-italic,,0,0,0,,Әпкеңді тауып алған сияқтысың, солай ма?
Dialogue: 0,0:18:51.34,0:18:52.44,Dialogue,,0,0,0,,Иә.
Dialogue: 0,0:18:52.44,0:18:54.58,Dialogue-italic,,0,0,0,,Бұл тамаша. Мен уайымдадым.
Dialogue: 0,0:18:55.31,0:18:57.64,Dialogue-italic,,0,0,0,,Мм, жақсы...
Dialogue: 0,0:18:57.64,0:19:00.57,Dialogue-italic,,0,0,0,,Телефоныңыздың батареясын пайдаланғаным үшін кешірім сұраймын!
Dialogue: 0,0:19:01.75,0:19:04.74,Dialogue-italic,,0,0,0,,Мен тым көп қиындық тудырмадым деп үміттенемін.
Dialogue: 0,0:19:05.22,0:19:07.26,Dialogue,,0,0,0,,Жоқ, болмадыңыз.
Dialogue: 0,0:19:07.26,0:19:11.98,Dialogue-italic,,0,0,0,,Қалай болғанда да, мен де өз ұялы телефонымды аламын!
Dialogue: 0,0:19:11.98,0:19:14.66,Dialogue,,0,0,0,,Мен көремін. Бұл тамаша.
Dialogue: 0,0:19:14.66,0:19:16.29,Dialogue,,0,0,0,,Олай болса, ертең кездескенше.
Dialogue: 0,0:19:16.29,0:19:17.38,Dialogue-italic,,0,0,0,,Кездескенше.
Dialogue: 0,0:19:18.29,0:19:20.49,Dialogue,,0,0,0,,Гинко-чан оның да ұялы телефон алатынын айтты.
Dialogue: 0,0:19:20.49,0:19:21.68,Dialogue,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:19:21.68,0:19:22.38,Dialogue,,0,0,0,,Иә.
Dialogue: 0,0:19:24.90,0:19:27.56,Dialogue,,0,0,0,,О-Оне-чан… кешкі газет бағыты!
Dialogue: 0,0:19:28.63,0:19:31.06,Dialogue,,0,0,0,,Тіпті олар сізге қарызға берген велосипедіңіз де бар.
Dialogue: 0,0:19:33.06,0:19:34.52,Dialogue,,0,0,0,,Қалай болғанда да, бар күшіңізді салыңыз!
Dialogue: 0,0:19:35.00,0:19:37.47,Dialogue,,0,0,0,,Мен сізге дәмді бұқтырылған тағам дайындаймын!
Dialogue: 0,0:19:44.15,0:19:46.43,Dialogue,,0,0,0,,Они-чан, бәрі жақсы ма?
Dialogue: 0,0:19:46.43,0:19:48.44,Dialogue,,0,0,0,,Мен жақсымын, мен жақсымын.
Dialogue: 0,0:19:53.22,0:19:57.46,Dialogue,,0,0,0,,О, мен Асуға бүгін таңертең қуырылған жұмыртқаның қандай жақсы екенін айтуды ұмытып кетіппін.
Dialogue: 0,0:20:02.96,0:20:04.67,Dialogue,,0,0,0,,Сәлеметсіз бе, Они Чан?
Dialogue: 0,0:20:04.67,0:20:06.98,Dialogue-italic,,0,0,0,,А, Асу, сен білесің...
Dialogue: 0,0:20:06.98,0:20:09.14,Dialogue,,0,0,0,,Бұл не? Бірдеңе болды ма?
Dialogue: 0,0:20:09.14,0:20:10.64,Dialogue-italic,,0,0,0,,Сіз сезінесіз бе?
Dialogue: 0,0:20:10.64,0:20:13.89,Dialogue-italic,,0,0,0,,Таңғы асқа қуырылған жұмыртқаларыңыз керемет болды!
Dialogue: 0,0:20:16.53,0:20:17.55,Dialogue-italic,,0,0,0,,Міне.
Dialogue: 0,0:20:17.55,0:20:20.11,Dialogue-italic,,0,0,0,,Менің саған айтқым келгені осы болды, Асу.
Dialogue: 0,0:20:20.78,0:20:24.08,Dialogue,,0,0,0,,Рахмет. Бүгінгі таңғы ас үшін ғана емес, әркім үшін, Асу.
Dialogue: 0,0:20:24.87,0:20:28.41,Dialogue,,0,0,0,,Өзіңізді тым көп итермеңіз, Они-чан.
Dialogue: 0,0:20:29.99,0:20:32.44,Dialogue-italic,,0,0,0,,Бұл бірден болған жоқ,
Dialogue: 0,0:20:32.44,0:20:38.75,Dialogue-italic,,0,0,0,,бірақ мен бұл телефондарды аспандағы анамыздың сыйы деп шештім.
Dialogue: 0,0:20:39.85,0:20:44.01,Dialogue-italic,,0,0,0,,Маған: «Кішкене демалуға болады», - деп айтқанын сезіндім.
Dialogue: 0,0:20:44.64,0:20:48.68,Dialogue-italic,,0,0,0,,анадан да, Асудан да.
Dialogue: 0,0:20:51.02,0:20:52.64,Dialogue,,0,0,0,,Жарайсыңдар! Тағы бір соққы бересіз бе?
Dialogue: 0,0:20:52.64,0:20:56.72,Dialogue,,0,0,0,,Ха, екеуің. Бұл сіз қатарынан 50-ші рет жасап көруіңіз керек.
Dialogue: 0,0:20:56.72,0:20:59.48,Dialogue,,0,0,0,,Сіз бір нәрсенің артынан жүргеніңіз анық. Нені қатты қалайсыз?
Dialogue: 0,0:20:59.96,0:21:01.70,Dialogue,,0,0,0,,Үшінші жүлде: ұялы телефондар.
Dialogue: 0,0:21:02.53,0:21:05.94,Dialogue,,0,0,0,,Оне-сама, бізде ұтыс билеттері таусылған.
Dialogue: 0,0:21:05.94,0:21:09.09,Dialogue,,0,0,0,,Егер солай болса, көбірек ақша табу үшін біраз нәрселерді сатып алыңыз.
Dialogue: 0,0:21:09.09,0:21:09.94,Dialogue,,0,0,0,,Иә.
Dialogue: 0,0:21:11.09,0:21:13.50,Dialogue,,0,0,0,,Күзетші мырза, біздің қайтуымызға дайындалыңыз.
Dialogue: 0,0:21:14.85,0:21:19.10,Dialogue-italic,,0,0,0,,Оне-сама, маған ұялы телефон алуға рұқсат бергеніңіз үшін рахмет.
Dialogue: 0,0:21:19.10,0:21:20.27,Dialogue-italic,,0,0,0,,Бірақ…
Dialogue: 0,0:21:20.67,0:21:23.80,Dialogue-italic,,0,0,0,,Оны әдеттегі жолмен сатып алу, әрине, арзанырақ болар еді.
Dialogue: 0,0:22:57.42,0:23:00.18,Dialogue,,0,0,0,,Асу, ана туралы бірдеңе есіңде ме?
Dialogue: 0,0:23:00.18,0:23:03.23,Dialogue,,0,0,0,,Біз уәде бергеніміз есімде.
Dialogue: 0,0:23:04.00,0:23:05.86,Dialogue,,0,0,0,,Бейшара апалардың әңгімесі:
Dialogue: 0,0:23:05.86,0:23:08.45,Dialogue,,0,0,0,,«Суық, уәде және ана күні».
Dialogue: 0,0:23:08.44,0:23:10.28,Dialogue,,0,0,0,,Көріңіз!
