Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.65,0:00:15.82,Default,,0,0,0,,Бұл бүгін менің үлкен қызым.
Dialogue: 0,0:00:17.99,0:00:19.83,Default,,0,0,0,,Мен 15 жасқа толдым
Dialogue: 0,0:00:24.96,0:00:28.38,Default,,0,0,0,,Бұл бала ертең кішісі болады.
Dialogue: 0,0:00:28.84,0:00:30.46,Default,,0,0,0,,Мен небәрі 9 жастамын
Dialogue: 0,0:00:32.51,0:00:34.76,Default,,0,0,0,,Әрқашан апаңызды оятпауға тырысыңыз
Dialogue: 0,0:00:34.93,0:00:38.51,Default,,0,0,0,,Оятқыш шырылдағанда ғана оянамын...
Dialogue: 0,0:00:47.81,0:00:51.53,Default,,0,0,0,,Бүгін таңертең мен газет жеткізуге шығамын.
Dialogue: 0,0:00:56.16,0:00:57.28,Default,,0,0,0,,Мен келе жатырмын
Dialogue: 0,0:00:57.78,0:00:58.66,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:01:03.20,0:01:04.25,Default,,0,0,0,,Қайырлы таң ертең♡
Dialogue: 0,0:01:04.33,0:01:06.62,Default,,0,0,0,,Мен бүгінгі отшашуды асыға күтемін!
Dialogue: 0,0:01:10.25,0:01:16.30,Default,,0,0,0,,Мен бұл балаларды аспанда алыстан бақылап отырмын.
Dialogue: 0,0:01:17.93,0:01:23.22,Default,,0,0,0,,Саған қалдырған жалғыз нәрсем
Dialogue: 0,0:01:24.18,0:01:27.02,Default,,0,0,0,,Кішкентай ғана уәде
Dialogue: 0,0:01:42.45,0:01:46.21,Default,,0,0,0,,Мен туған жылы анам дүниеден өтті.
Dialogue: 0,0:01:46.58,0:01:49.79,Default,,0,0,0,,Әкем құмар ойындар арқылы қарызға батып, қайтыс болды.
Dialogue: 0,0:01:50.59,0:01:53.59,Default,,0,0,0,,Ал біз артта қалдық
Dialogue: 0,0:01:54.80,0:01:58.51,Default,,0,0,0,,40 жыл, едені жоқ 1К тозығы жеткен пәтер
Dialogue: 0,0:01:59.05,0:02:00.89,Default,,0,0,0,,Бұл біздің үй
Dialogue: 0,0:02:01.51,0:02:03.60,Default,,0,0,0,,Бірақ көктем келгенде...
Dialogue: 0,0:02:04.34,0:02:08.97,Default,,0,0,0,,Өйткені мен өз естеліктерімді қайтара алмаймын
Dialogue: 0,0:02:08.97,0:02:13.66,Default,,0,0,0,,Бүгін өмір сүріп, ертеңді қолға ал
Dialogue: 0,0:02:23.44,0:02:32.25,Default,,0,0,0,,Жалғыз болсаң да, жалғыз емессің
Dialogue: 0,0:02:32.86,0:02:41.68,Default,,0,0,0,,Біз жалғыз емеспіз, жалғыз емеспіз
Dialogue: 0,0:02:42.44,0:02:51.17,Default,,0,0,0,,Әлі аққан жастың алдында
Dialogue: 0,0:02:51.93,0:03:00.82,Default,,0,0,0,,Қызық, күліп, терең тыныс аламын ба?
Dialogue: 0,0:03:00.82,0:03:05.41,Default,,0,0,0,,Өйткені мен естеліктерге орала алмаймын
Dialogue: 0,0:03:05.41,0:03:10.05,Default,,0,0,0,,Бүгін өмір сүріп, ертеңді қолға ал
Dialogue: 0,0:03:10.19,0:03:19.55,Default,,0,0,0,,Сенің таптырмас асылың жүрегімде
Dialogue: 0,0:03:19.60,0:03:24.86,Default,,0,0,0,,Басынан соққан желге терең тыныс алу
Dialogue: 0,0:03:53.21,0:03:55.75,Default,,0,0,0,,А, әпке қайтып келеді.
Dialogue: 0,0:03:56.38,0:03:58.38,Default,,0,0,0,,Мен таңғы ас дайындауды бастауым керек!
Dialogue: 0,0:04:07.10,0:04:08.51,Default,,0,0,0,,Бұл аяқталды
Dialogue: 0,0:04:09.85,0:04:12.77,Default,,0,0,0,,Ойлап қарасақ, отшашу фестивалі өткен жылға дейін болған
Dialogue: 0,0:04:12.77,0:04:14.98,Default,,0,0,0,,Сіз мені әрқашан ертеңге дейін күтуге мәжбүр еттіңіз.
Dialogue: 0,0:04:15.35,0:04:16.77,Default,,0,0,0,,Бірақ биыл...
Dialogue: 0,0:04:21.49,0:04:22.28,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:04:23.91,0:04:24.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:26.57,0:04:29.62,Default,,0,0,0,,Дұрыс, кешегі сауданың өзгерісі.
Dialogue: 0,0:04:37.04,0:04:38.54,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:04:38.84,0:04:41.13,Default,,0,0,0,,Мен бүгінге ақша жинадым.
Dialogue: 0,0:04:42.59,0:04:45.93,Default,,0,0,0,,Мен әпкеммен отшашу алаңында көп көңілді.
Dialogue: 0,0:04:46.43,0:04:47.55,Default,,0,0,0,,Кәмпит алма және
Dialogue: 0,0:04:47.97,0:04:49.10,Default,,0,0,0,,Такояки және
Dialogue: 0,0:04:49.31,0:04:50.93,Default,,0,0,0,,Ал соус сенбей!
Dialogue: 0,0:04:53.64,0:04:54.60,Default,,0,0,0,,Мен келдім!
Dialogue: 0,0:04:55.52,0:04:56.85,Default,,0,0,0,,Әпке, үйге қош келдіңіз~
Dialogue: 0,0:04:59.07,0:05:00.73,Default,,0,0,0,,Еңбектеріңіз үшін рахмет.
Dialogue: 0,0:05:00.94,0:05:02.57,Default,,0,0,0,,Таңғы ас дайын.
Dialogue: 0,0:05:03.32,0:05:05.20,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:05:06.36,0:05:07.16,Default,,0,0,0,,(бұл дәмді)
Dialogue: 0,0:05:10.79,0:05:12.62,Default,,0,0,0,,Бүгін отшашу фестивалі бар.
Dialogue: 0,0:05:12.79,0:05:15.12,Default,,0,0,0,,Иә, бұл отшашу.
Dialogue: 0,0:05:16.25,0:05:20.13,Default,,0,0,0,,Эй, сен тазалауды аяқтаған соң, мен аздап шыға аламын ба?
Dialogue: 0,0:05:20.46,0:05:22.63,Default,,0,0,0,,Жарайды, сенбі ғой.
Dialogue: 0,0:05:22.80,0:05:24.01,Default,,0,0,0,,Бірақ біз қайда барамыз?
Dialogue: 0,0:05:25.26,0:05:26.72,Default,,0,0,0,,Кейінірек түсінесіз.
Dialogue: 0,0:05:29.89,0:05:31.64,Default,,0,0,0,,Кеттік
Dialogue: 0,0:05:33.18,0:05:35.94,Default,,0,0,0,,Көрші, сіздің пошта жәшігіңіз толы.
Dialogue: 0,0:05:37.73,0:05:39.27,Default,,0,0,0,,Толық~
Dialogue: 0,0:05:41.07,0:05:43.15,Default,,0,0,0,,Ертең өзіңді ойла.
Dialogue: 0,0:05:43.23,0:05:44.65,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:05:44.78,0:05:47.11,Default,,0,0,0,,Әй, қайда бара жатырсың?
Dialogue: 0,0:05:47.32,0:05:48.86,Default,,0,0,0,,Кейінірек түсінесіз.
Dialogue: 0,0:05:50.83,0:05:54.20,Default,,0,0,0,,Ах! Қайырлы таң үй иесі
Dialogue: 0,0:05:56.41,0:05:58.08,Default,,0,0,0,,Мен де...
Dialogue: 0,0:06:14.64,0:06:15.52,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:26.19,0:06:27.07,Default,,0,0,0,,Go！
Dialogue: 0,0:06:31.66,0:06:34.20,Default,,0,0,0,,О? Бұл Асу Чан емес пе?
Dialogue: 0,0:06:34.33,0:06:36.62,Default,,0,0,0,,Иә? Яоичидің күйеуі
Dialogue: 0,0:06:37.25,0:06:39.37,Default,,0,0,0,,Бүгін дүңгіршекте көкөністер сатасыз ба?
Dialogue: 0,0:06:40.12,0:06:43.09,Default,,0,0,0,,Хахахаха мен азық-түлік дүңгіршегінде ештеңе сата алмаймын.
Dialogue: 0,0:06:43.09,0:06:44.13,Default,,0,0,0,,А, бұл!
Dialogue: 0,0:06:44.80,0:06:47.13,Default,,0,0,0,,Иә, мен қалтадан ақша табу үшін алма кәмпит сататын дүкенде жұмыс істеймін.
Dialogue: 0,0:06:48.05,0:06:49.72,Default,,0,0,0,,Сіз алма кәмпит дүкенісіз бе?
Dialogue: 0,0:06:50.05,0:06:52.30,Default,,0,0,0,,Кейін әпкеммен дүкен аралауға барамын!
Dialogue: 0,0:06:52.47,0:06:55.85,Default,,0,0,0,,Жақсы! Содан кейін мен ерекше үлкен жасаймын!
Dialogue: 0,0:06:55.85,0:06:58.02,Default,,0,0,0,,Ах, рахмет
Dialogue: 0,0:06:59.98,0:07:05.57,Default,,0,0,0,,Якисоба мейрамханасында, нысана ату цехында және мақта кәмпит дүкенінде...
Dialogue: 0,0:07:13.45,0:07:14.95,Default,,0,0,0,,Дайын!
Dialogue: 0,0:07:23.13,0:07:24.17,Default,,0,0,0,,Апай
Dialogue: 0,0:07:28.09,0:07:29.55,Default,,0,0,0,,Мен келдім!
Dialogue: 0,0:07:30.80,0:07:31.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:32.55,0:07:33.47,Default,,0,0,0,,Үлкен әпке?
Dialogue: 0,0:07:42.40,0:07:44.48,Default,,0,0,0,,О, ақша...
Dialogue: 0,0:07:56.03,0:07:57.66,Default,,0,0,0,,Ертең мен үйдемін
Dialogue: 0,0:07:57.95,0:08:00.12,Default,,0,0,0,,Кешіріңіз, кешігіп қалдым.
Dialogue: 0,0:08:01.50,0:08:03.62,Default,,0,0,0,,Не болды? Тіпті жарықты да қоспаңыз
Dialogue: 0,0:08:08.80,0:08:11.05,Default,,0,0,0,,Иә, бұл ертеңгі сыйлық.
Dialogue: 0,0:08:12.01,0:08:12.88,Default,,0,0,0,,Юката…
Dialogue: 0,0:08:13.55,0:08:14.26,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:18.47,0:08:19.89,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,0:08:19.89,0:08:21.89,Default,,0,0,0,,Мен оны Hashimoto киім дүкенінен сатып алдым.
Dialogue: 0,0:08:22.60,0:08:25.27,Default,,0,0,0,,Менде анамның естелігі ретінде юката бар.
Dialogue: 0,0:08:25.35,0:08:26.77,Default,,0,0,0,,Себебі ертең жоқ еді
Dialogue: 0,0:08:27.02,0:08:29.82,Default,,0,0,0,,Мен оны сізге сыйлық ретінде беруді біраз уақыттан бері ойлап жүрмін.
Dialogue: 0,0:08:30.48,0:08:31.28,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:08:31.86,0:08:34.32,Default,,0,0,0,,Сіз мұны шошқаңыздың жинаған ақшасына сатып алдыңыз ба?
Dialogue: 0,0:08:34.32,0:08:35.20,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:08:35.36,0:08:36.66,Default,,0,0,0,,Оны жылдам қосып көріңіз
Dialogue: 0,0:08:43.91,0:08:44.71,Default,,0,0,0,,Қажет емес!
Dialogue: 0,0:08:45.42,0:08:46.33,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:08:46.71,0:08:48.63,Default,,0,0,0,,Мен оны ертеңге сатып алдым.
Dialogue: 0,0:08:48.96,0:08:52.26,Default,,0,0,0,,Неліктен... жинаған ақшаңызды рұқсатсыз пайдаландыңыз?
Dialogue: 0,0:08:52.51,0:08:53.59,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:08:53.67,0:08:55.38,Default,,0,0,0,,Мен сені ертең бақытты болар деп ойладым...
Dialogue: 0,0:08:57.05,0:09:00.43,Default,,0,0,0,,Эй, ақшаны қайтадан үнемдеуге болады.
Dialogue: 0,0:09:01.10,0:09:02.02,Default,,0,0,0,,Сонымен,
Dialogue: 0,0:09:02.31,0:09:05.06,Default,,0,0,0,,Мен оны рұқсатсыз пайдаланғаным үшін кінәлі болдым.
Dialogue: 0,0:09:05.06,0:09:06.35,Default,,0,0,0,,Өйткені бұл үлкен мәселе
Dialogue: 0,0:09:06.35,0:09:09.77,Default,,0,0,0,,Юката киіп, отшашуға барайық, жарай ма?
Dialogue: 0,0:09:10.65,0:09:11.61,Default,,0,0,0,,Мен бармаймын
Dialogue: 0,0:09:12.03,0:09:13.69,Default,,0,0,0,,Отшашу...
Dialogue: 0,0:09:14.32,0:09:15.32,Default,,0,0,0,,Мен бармаймын! !
Dialogue: 0,0:09:17.74,0:09:19.20,Default,,0,0,0,,Апаның ақымақ! !
Dialogue: 0,0:09:30.04,0:09:31.50,Default,,0,0,0,,Мен оны асыға күттім.
Dialogue: 0,0:09:31.80,0:09:34.30,Default,,0,0,0,,Мен оны отшашу фестивалінде бірге пайдаланамыз деп ойладым.
Dialogue: 0,0:09:35.17,0:09:38.14,Default,,0,0,0,,Такояки дүкені Тұздық сенбей дүкені
Dialogue: 0,0:09:38.43,0:09:41.22,Default,,0,0,0,,үшін оны асыға күтті!
Dialogue: 0,0:09:42.10,0:09:45.48,Default,,0,0,0,,Үлкен кәмпит алма Мен оны сенімен бірге жеймін деп ойладым!
Dialogue: 0,0:09:47.19,0:09:47.94,Default,,0,0,0,,Ертең...
Dialogue: 0,0:09:56.78,0:09:58.82,Default,,0,0,0,,Юкатаны қайтаруым керек пе?
Dialogue: 0,0:10:22.56,0:10:23.43,Default,,0,0,0,,Жаңбыр…
Dialogue: 0,0:10:25.06,0:10:26.56,Default,,0,0,0,,Мен сені ертең алып кетуім керек!
Dialogue: 0,0:10:29.73,0:10:30.69,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:10:31.19,0:10:32.98,Default,,0,0,0,,Ол кезде де солай болды.
Dialogue: 0,0:10:44.70,0:10:45.95,Default,,0,0,0,,Әрең қауіпсіз
Dialogue: 0,0:10:47.04,0:10:49.37,Default,,0,0,0,,Ертең~ Ертең?
Dialogue: 0,0:10:49.92,0:10:51.71,Default,,0,0,0,,Ол әлі оралған жоқ.
Dialogue: 0,0:10:52.33,0:10:54.88,Default,,0,0,0,,Амансың ба? Сіз әлі мектептесіз бе?
Dialogue: 0,0:10:55.05,0:10:57.97,Default,,0,0,0,,Егер сіз сыртта болсаңыз, жаңбырдан баспана алуыңыз керек.
Dialogue: 0,0:11:02.09,0:11:04.05,Default,,0,0,0,,Мен Каминариді жек көремін~
Dialogue: 0,0:11:07.81,0:11:10.10,Default,,0,0,0,,Мүмкін... ертең де шығар?
Dialogue: 0,0:11:14.32,0:11:15.48,Default,,0,0,0,,Ертең күтіңіз.
Dialogue: 0,0:11:15.77,0:11:18.03,Default,,0,0,0,,Менің әпкем қазір кетеді.
Dialogue: 0,0:11:21.82,0:11:24.99,Default,,0,0,0,,Мен құладым. Мен қатты жақындап қалдым.
Dialogue: 0,0:11:25.33,0:11:30.04,Default,,0,0,0,,Енді ойлап қарасам, біреу қолшатырды найзағай соғуы мүмкін деп айтқан шығар...
Dialogue: 0,0:11:41.63,0:11:43.05,Default,,0,0,0,,Әй, әпке! ?
Dialogue: 0,0:11:44.39,0:11:47.18,Default,,0,0,0,,Үлкен әпке~ Мына жақта, ана жақта~
Dialogue: 0,0:11:48.43,0:11:49.56,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:11:49.73,0:11:54.10,Default,,0,0,0,,Ол кезде мен күн күркіреуінен қорықпайтынмын.
Dialogue: 0,0:11:56.90,0:11:58.32,Default,,0,0,0,,Бұл аянышты
Dialogue: 0,0:12:01.49,0:12:03.95,Default,,0,0,0,,Ол кезде мен күн күркіреуінен қорқатынмын.
Dialogue: 0,0:12:03.95,0:12:07.28,Default,,0,0,0,,Ертең сені алып кетейін деп жолдан бас тартқалы тұрмын.
Dialogue: 0,0:12:07.83,0:12:08.91,Default,,0,0,0,,Бүгін де...
Dialogue: 0,0:12:10.45,0:12:15.29,Default,,0,0,0,,Ертең мұндай апа керек емес шығар...
Dialogue: 0,0:12:18.96,0:12:20.34,Default,,0,0,0,,О, Асу-чан
Dialogue: 0,0:12:21.13,0:12:22.13,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:22.63,0:12:25.05,Default,,0,0,0,,Ааа, мен қатты суланып қалдым
Dialogue: 0,0:12:25.51,0:12:27.68,Default,,0,0,0,,Суық тиіп қалсам не істеуім керек?
Dialogue: 0,0:12:29.35,0:12:31.31,Default,,0,0,0,,Бұл юката апай...
Dialogue: 0,0:12:31.31,0:12:33.02,Default,,0,0,0,,О, бұл юката ма?
Dialogue: 0,0:12:33.02,0:12:34.14,Default,,0,0,0,,Сізге ұнайды, солай ма?
Dialogue: 0,0:12:34.14,0:12:34.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:35.27,0:12:38.23,Default,,0,0,0,,Бұл сіздің әпкеңіз киген юкатамен бірдей.
Dialogue: 0,0:12:38.73,0:12:39.65,Default,,0,0,0,,Дәл солай ма?
Dialogue: 0,0:12:40.03,0:12:43.78,Default,,0,0,0,,Кио Чан, маған бұл үлгі сізге ұнайтынын айтыңыз.
Dialogue: 0,0:12:44.41,0:12:46.91,Default,,0,0,0,,Мен оны іздеу үшін қоймама бардым.
Dialogue: 0,0:12:47.37,0:12:50.29,Default,,0,0,0,,Мен сені күні бойы іздедім бе деп ойлаймын.
Dialogue: 0,0:12:50.33,0:12:52.75,Default,,0,0,0,,Не? Күні бойы?
Dialogue: 0,0:12:53.75,0:12:57.84,Default,,0,0,0,,Жыл сайын мен Асу-чанға юката кие алмаймын.
Dialogue: 0,0:12:58.04,0:13:00.05,Default,,0,0,0,,Сізге жаман ой келген сияқты.
Dialogue: 0,0:13:00.34,0:13:02.88,Default,,0,0,0,,Ха! ? мен үшін...
Dialogue: 0,0:13:03.47,0:13:06.80,Default,,0,0,0,,Олар сәйкес юкаталарды табу үшін көп жұмыс істеді.
Dialogue: 0,0:13:07.72,0:13:09.05,Default,,0,0,0,,Мен үшін…
Dialogue: 0,0:13:09.81,0:13:14.52,Default,,0,0,0,,Мен сәйкес юката киіп, отшашуды көруді асыға күттім.
Dialogue: 0,0:13:14.81,0:13:16.19,Default,,0,0,0,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,0:13:16.23,0:13:18.61,Default,,0,0,0,,Бұл душ, ол жақында тоқтайды.
Dialogue: 0,0:13:20.07,0:13:20.65,Default,,0,0,0,,Жаңбыр…
Dialogue: 0,0:13:21.69,0:13:22.86,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:13:25.03,0:13:26.91,Default,,0,0,0,,Қолшатырыңызды ұмытқанда
Dialogue: 0,0:13:32.45,0:13:33.54,Default,,0,0,0,,Мен сіздің нақты денеңізді айтып тұрмын.
Dialogue: 0,0:13:34.16,0:13:38.04,Default,,0,0,0,,А-а, мен қиналдым. Мен үйге кеш қайтып келемін.
Dialogue: 0,0:13:40.00,0:13:41.46,Default,,0,0,0,,Әй, әпке! ?
Dialogue: 0,0:13:43.46,0:13:45.84,Default,,0,0,0,,Үлкен әпке~ Мына жақта, ана жақта~
Dialogue: 0,0:13:48.43,0:13:50.72,Default,,0,0,0,,Мені алып кетуге әпкем келді.
Dialogue: 0,0:13:51.97,0:13:54.81,Default,,0,0,0,,Бірақ жаңбыр басылған сияқты.
Dialogue: 0,0:13:57.06,0:14:00.36,Default,,0,0,0,,Әпке, қолшатырыңызды әкелген жоқсыз.
Dialogue: 0,0:14:04.28,0:14:07.40,Default,,0,0,0,,Әпке, мен күн күркіреуін жек көремін, бірақ мұны істеуге өзімді мәжбүрлеуім керек...
Dialogue: 0,0:14:10.07,0:14:12.24,Default,,0,0,0,,Қолшатырды қолданайық.
Dialogue: 0,0:14:12.24,0:14:14.95,Default,,0,0,0,,Иә? Бұл ұят па?
Dialogue: 0,0:14:17.21,0:14:19.33,Default,,0,0,0,,Бірақ мен...
Dialogue: 0,0:14:19.54,0:14:21.42,Default,,0,0,0,,Апаның ақымақ! !
Dialogue: 0,0:14:22.42,0:14:25.88,Default,,0,0,0,,Мен... мен әпкемді әбігерге саламын...
Dialogue: 0,0:14:25.92,0:14:30.39,Default,,0,0,0,,Иә, Кио Чан үнемі Асучанды ойлайды.
Dialogue: 0,0:14:30.59,0:14:32.05,Default,,0,0,0,,Мен сені ақымақ дедім...
Dialogue: 0,0:14:32.05,0:14:32.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:32.81,0:14:36.93,Default,,0,0,0,,Сонда да мен әпкемді ақымақ дедім...
Dialogue: 0,0:14:37.31,0:14:38.39,Default,,0,0,0,,Мен...
Dialogue: 0,0:14:40.94,0:14:43.73,Default,,0,0,0,,Жарайды, Асу-чан.
Dialogue: 0,0:14:44.44,0:14:46.61,Default,,0,0,0,,Мен не болғанын білмеймін.
Dialogue: 0,0:14:47.11,0:14:51.03,Default,,0,0,0,,Осы юкатаны маған тауып беру үшін әпкем көп еңбек етті.
Dialogue: 0,0:14:51.28,0:14:53.99,Default,,0,0,0,,Неге оны жай ғана киіп, маған көрсетпейсің?
Dialogue: 0,0:14:55.45,0:14:57.16,Default,,0,0,0,,Әй, әпке...
Dialogue: 0,0:15:08.92,0:15:09.88,Default,,0,0,0,,Үлкен әпке!
Dialogue: 0,0:15:11.05,0:15:12.01,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:15:15.85,0:15:16.72,Default,,0,0,0,,Ханаби…
Dialogue: 0,0:15:25.69,0:15:26.82,Default,,0,0,0,,Ертең
Dialogue: 0,0:15:30.36,0:15:31.49,Default,,0,0,0,,Ертең
Dialogue: 0,0:15:41.87,0:15:43.63,Default,,0,0,0,,(Кири)
Dialogue: 0,0:15:44.46,0:15:47.25,Default,,0,0,0,,Тамая~ Кагия~
Dialogue: 0,0:15:49.21,0:15:52.01,Default,,0,0,0,,Жыл сайын Асумен бірге көретінмін...
Dialogue: 0,0:15:52.30,0:15:54.14,Default,,0,0,0,,Жалғыз қалудың мәні жоқ...
Dialogue: 0,0:15:55.26,0:15:58.35,Default,,0,0,0,,Әйтеуір, ертең келеді деп ойладым...
Dialogue: 0,0:15:58.60,0:15:59.89,Default,,0,0,0,,Сәлем, Кио Чан!
Dialogue: 0,0:16:00.77,0:16:02.44,Default,,0,0,0,,Сіз бірден келдіңіз.
Dialogue: 0,0:16:02.94,0:16:05.52,Default,,0,0,0,,Жақында өте үлкен кәмпит алмалары дайын болады
Dialogue: 0,0:16:05.73,0:16:07.19,Default,,0,0,0,,Яоичи ағай
Dialogue: 0,0:16:07.48,0:16:09.74,Default,,0,0,0,,Асу-чан, мен оны қатты күттім.
Dialogue: 0,0:16:10.11,0:16:12.32,Default,,0,0,0,,Сіз әпкеңізбен келе жатырсыз.
Dialogue: 0,0:16:12.40,0:16:13.74,Default,,0,0,0,,Не, ертең?
Dialogue: 0,0:16:13.74,0:16:14.53,Default,,0,0,0,,О
Dialogue: 0,0:16:14.78,0:16:18.74,Default,,0,0,0,,Мен тамақ сататын дүңгіршектердің орнын тексеріп жатыр едім, өйткені мен әпкемді көрсетпек болдым.
Dialogue: 0,0:16:18.95,0:16:19.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:20.87,0:16:21.91,Default,,0,0,0,,Ертең! ?
Dialogue: 0,0:16:25.75,0:16:27.17,Default,,0,0,0,,Бұл жазба…
Dialogue: 0,0:16:28.96,0:16:32.67,Default,,0,0,0,,Ертең маған жол көрсету үшін...
Dialogue: 0,0:16:35.01,0:16:36.80,Default,,0,0,0,,Мен үшін…
Dialogue: 0,0:16:37.64,0:16:40.14,Default,,0,0,0,,Неліктен жинақ ақшаңызды рұқсатсыз пайдаландыңыз?
Dialogue: 0,0:16:40.77,0:16:42.39,Default,,0,0,0,,Отшашу туралы не деуге болады?
Dialogue: 0,0:16:42.94,0:16:44.02,Default,,0,0,0,,Мен бармаймын! !
Dialogue: 0,0:16:46.48,0:16:48.32,Default,,0,0,0,,Мен... Мен ақымақпын.
Dialogue: 0,0:16:50.57,0:16:51.69,Default,,0,0,0,,Сен ақымақсың!
Dialogue: 0,0:16:54.70,0:16:57.62,Default,,0,0,0,,Әй, орындалды. Өте үлкен кәмпит алма.
Dialogue: 0,0:16:57.87,0:17:00.08,Default,,0,0,0,,Иә? Кио Чан?
Dialogue: 0,0:17:01.83,0:17:05.29,Default,,0,0,0,,Сен ертең кешке менімен барда болғың келді.
Dialogue: 0,0:17:05.75,0:17:09.46,Default,,0,0,0,,Бірақ мен Асудың сезімін түсіне алмадым.
Dialogue: 0,0:17:09.80,0:17:11.30,Default,,0,0,0,,Ертеңгі сезім...
Dialogue: 0,0:17:13.47,0:17:16.76,Default,,0,0,0,,Ертең туралы... Мен анама уәде бердім
Dialogue: 0,0:17:17.59,0:17:19.01,Default,,0,0,0,,Анаммен...
Dialogue: 0,0:17:24.23,0:17:25.23,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:26.23,0:17:27.44,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:17:29.86,0:17:33.36,Default,,0,0,0,,Мен тез қарындасыма баруым керек.
Dialogue: 0,0:17:33.61,0:17:35.28,Default,,0,0,0,,Отшашу аяқталды
Dialogue: 0,0:17:36.32,0:17:37.11,Default,,0,0,0,,Қайда?
Dialogue: 0,0:17:37.99,0:17:41.29,Default,,0,0,0,,Үлкен әпке~
Dialogue: 0,0:17:42.58,0:17:43.37,Default,,0,0,0,,Ертең
Dialogue: 0,0:17:46.50,0:17:48.67,Default,,0,0,0,,Ертең... ертең келеді
Dialogue: 0,0:17:59.34,0:18:02.68,Default,,0,0,0,,Ах~су~
Dialogue: 0,0:18:05.10,0:18:06.14,Default,,0,0,0,,Үлкен әпке?
Dialogue: 0,0:18:07.89,0:18:09.65,Default,,0,0,0,,Ертең
Dialogue: 0,0:18:12.57,0:18:13.65,Default,,0,0,0,,Үлкен әпке!
Dialogue: 0,0:18:14.07,0:18:15.82,Default,,0,0,0,,Ертең
Dialogue: 0,0:18:16.82,0:18:18.91,Default,,0,0,0,,Үлкен әпке...
Dialogue: 0,0:18:31.04,0:18:33.30,Default,,0,0,0,,Әпке, мен...
Dialogue: 0,0:18:33.63,0:18:36.34,Default,,0,0,0,,Мен… Мен…
Dialogue: 0,0:18:37.05,0:18:39.76,Default,,0,0,0,,Рахмет, сен юката киіп келдің.
Dialogue: 0,0:18:40.93,0:18:42.18,Default,,0,0,0,,О, бұл естелік екен. Өте рахмет
Dialogue: 0,0:18:43.81,0:18:45.06,Default,,0,0,0,,Ой, отшашу!
Dialogue: 0,0:18:47.39,0:18:50.52,Default,,0,0,0,,Ертең біз биыл да бірге отшашуды тамашалай алдық.
Dialogue: 0,0:18:52.77,0:18:53.69,Default,,0,0,0,,Иә
Dialogue: 0,0:18:54.44,0:18:56.36,Default,,0,0,0,,Түсіндім, биыл да...
Dialogue: 0,0:18:56.53,0:18:57.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:37.53,0:19:38.94,Default,,0,0,0,,Кішкене демалып ал...
Dialogue: 0,0:19:39.03,0:19:42.28,Default,,0,0,0,,Ертең бәрі жақсы, үйге қайт!
Dialogue: 0,0:19:43.37,0:19:45.83,Default,,0,0,0,,Әпке, менің де жұмыс істегім келеді.
Dialogue: 0,0:19:46.62,0:19:50.62,Default,,0,0,0,,Ертең ақша туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:19:50.96,0:19:53.42,Default,,0,0,0,,Мен көбірек тырысамын, апа.
Dialogue: 0,0:19:53.63,0:19:54.84,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:19:54.84,0:19:56.29,Default,,0,0,0,,Мен көбірек жұмыс аламын
Dialogue: 0,0:19:56.67,0:19:57.59,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:19:58.55,0:19:59.72,Default,,0,0,0,,О, бұл естелік екен. Өте рахмет
Dialogue: 0,0:20:02.55,0:20:03.93,Default,,0,0,0,,Мария
Dialogue: 0,0:20:04.64,0:20:07.39,Default,,0,0,0,,Әкең сияқты жоғалып кетпе.
Dialogue: 0,0:20:09.56,0:20:13.02,Default,,0,0,0,,Мен... Мен апамды ақымақ дедім.
Dialogue: 0,0:20:13.69,0:20:16.06,Default,,0,0,0,,Ендеше... ешқайда кетпе! !
Dialogue: 0,0:20:21.78,0:20:22.40,Default,,0,0,0,,Иә
Dialogue: 0,0:20:24.28,0:20:26.83,Default,,0,0,0,,Менің әпкем осында.
Dialogue: 0,0:20:27.87,0:20:29.62,Default,,0,0,0,,Өйткені мен ешқайда кетпеймін...
Dialogue: 0,0:20:30.33,0:20:31.16,Default,,0,0,0,,Иә
Dialogue: 0,0:20:33.54,0:20:34.79,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:20:35.50,0:20:36.75,Default,,0,0,0,,О, бұл естелік екен. Өте рахмет
Dialogue: 0,0:20:39.30,0:20:40.30,Default,,0,0,0,,Ертең
Dialogue: 0,0:20:40.63,0:20:44.34,Default,,0,0,0,,Жарайды, апам ешқайда кетпейді.
Dialogue: 0,0:20:45.26,0:20:50.52,Default,,0,0,0,,Бүгін сізге көп күш жұмсамаймын деп уайымдаудың қажеті жоқ.
Dialogue: 0,0:20:51.81,0:20:57.44,Default,,0,0,0,,Менің саған қалдырғаным – бір ғана уәде.
Dialogue: 0,0:20:57.73,0:21:00.69,Default,,0,0,0,,Сіз мені өте мұқият қорғайсыз.
Dialogue: 0,0:21:01.03,0:21:06.11,Default,,0,0,0,,Күндердің күнінде, сен әлі жас болсаңда, сенің күш-қуатыңыз енді сізге жете алмайды...
Dialogue: 0,0:21:10.37,0:21:11.83,Default,,0,0,0,,Күн~
Dialogue: 0,0:21:12.50,0:21:13.79,Default,,0,0,0,,Бұл әдемі...
Dialogue: 0,0:21:14.00,0:21:14.83,Default,,0,0,0,,Иә
Dialogue: 0,0:21:15.21,0:21:18.13,Default,,0,0,0,,Менің уәдем ше?
Dialogue: 0,0:21:18.29,0:21:21.17,Default,,0,0,0,,Арамыздағы байланысты қорғай гөр...
Dialogue: 0,0:21:21.67,0:21:24.76,Default,,0,0,0,,Мен... тілеуімді жалғастырамын.
Dialogue: 0,0:21:46.45,0:21:50.62,Default,,0,0,0,,Жазықсыз әңгіме
Dialogue: 0,0:21:50.95,0:21:55.21,Default,,0,0,0,,Тіпті кенет тоқтап қалса да
Dialogue: 0,0:21:55.46,0:21:59.42,Default,,0,0,0,,Осылай жаныңда болу арқылы
Dialogue: 0,0:21:59.67,0:22:03.09,Default,,0,0,0,,Өзіңізді қауіпсіз сезініңіз
Dialogue: 0,0:22:04.38,0:22:08.80,Default,,0,0,0,,Маңдайыңызды ақырын сипау
Dialogue: 0,0:22:08.80,0:22:12.81,Default,,0,0,0,,Самал сияқты
Dialogue: 0,0:22:13.18,0:22:16.98,Default,,0,0,0,,Қолды мықтап, қатты ұстағанда
Dialogue: 0,0:22:17.56,0:22:22.11,Default,,0,0,0,,Еңіспен жүгірейік
Dialogue: 0,0:22:22.11,0:22:25.90,Default,,0,0,0,,Ертең де қызық болады.
Dialogue: 0,0:22:26.53,0:22:30.95,Default,,0,0,0,,Сапқа тұрайық
Dialogue: 0,0:22:31.07,0:22:34.91,Default,,0,0,0,,Тығыз, мықтап, Жел ұстасаң
Dialogue: 0,0:22:35.54,0:22:40.04,Default,,0,0,0,,Қолымды жайып, жеткізгім келеді
Dialogue: 0,0:22:40.04,0:22:43.88,Default,,0,0,0,,Тығыз, мықтап, ертең және болашақта да
Dialogue: 0,0:22:44.59,0:22:51.18,Default,,0,0,0,,Қатар жүрейік, бірге барайық
Dialogue: 0,0:22:57.64,0:23:00.35,Default,,0,0,0,,Бұл айда да қорқыныштың ұлы жын патшасы келеді...
Dialogue: 0,0:23:00.40,0:23:02.61,Default,,0,0,0,,Иә? Үй иесі келмейді.
Dialogue: 0,0:23:02.77,0:23:03.82,Default,,0,0,0,,Қызық, не болды...?
Dialogue: 0,0:23:04.15,0:23:05.78,Default,,0,0,0,,Кедей әпкелер әңгімесі
Dialogue: 0,0:23:05.86,0:23:08.28,Default,,0,0,0,,Үй иесі, қарбыз және қонаққа баратын күн
Dialogue: 0,0:23:08.82,0:23:10.16,Default,,0,0,0,,Қарап көріңіз
Dialogue: 0,0:03:36.23,0:03:40.49,Default,,0,0,0,,Юката күні, отшашу,
Dialogue: 0,0:03:36.23,0:03:40.49,Default,,0,0,0,,Юката күні, отшашу,
Dialogue: 0,0:03:36.23,0:03:40.49,Default,,0,0,0,,Юката күні, отшашу,
Dialogue: 0,0:03:36.23,0:03:40.49,Default,,0,0,0,,және кәмпит алмалары
Dialogue: 0,0:03:36.23,0:03:40.49,Default,,0,0,0,,және кәмпит алмалары
Dialogue: 0,0:03:36.23,0:03:40.49,Default,,0,0,0,,және кәмпит алмалары
Dialogue: 0,0:04:09.06,0:04:14.52,Default,,0,0,0,,Іздеу
Dialogue: 0,0:04:09.06,0:04:14.52,Default,,0,0,0,,кішкентай күшік
Dialogue: 0,0:04:09.06,0:04:14.52,Default,,0,0,0,,Отшашу
Dialogue: 0,0:04:09.06,0:04:14.52,Default,,0,0,0,,Фестиваль
Dialogue: 0,0:06:19.48,0:06:21.98,Default,,0,0,0,,Қайырлы таң, Асу!
Dialogue: 0,0:06:19.48,0:06:21.98,Default,,0,0,0,,Мен бүгінгі күнді күте алмаймын
Dialogue: 0,0:06:19.48,0:06:21.98,Default,,0,0,0,,отшашу фестивалі!
Dialogue: 0,0:06:19.48,0:06:21.98,Default,,0,0,0,,Кью
Dialogue: 0,0:06:19.48,0:06:21.98,Default,,0,0,0,,Мен бүгінгі күнді күте алмаймын
Dialogue: 0,0:06:19.48,0:06:21.98,Default,,0,0,0,,отшашу фестивалі!
Dialogue: 0,0:10:01.95,0:10:10.00,Default,,0,0,0,,Ямадалар отбасының сәл сәнді одуванчик кофесі.
Dialogue: 0,0:10:10.00,0:10:18.47,Default,,0,0,0,,Сауда-саттық, сондай керемет көрініс.
Dialogue: 0,0:10:10.00,0:10:18.47,Default,,0,0,0,,Келісімді сату
Dialogue: 0,0:00:11.43,0:00:15.56,Default,,0,0,0,,Бұл Кью, менің үлкен қызым.
Dialogue: 0,0:00:17.86,0:00:19.66,Default,,0,0,0,,Ол он бес жаста.
Dialogue: 0,0:00:24.71,0:00:28.24,Default,,0,0,0,,Мынау Асу, менің кіші қызым.
Dialogue: 0,0:00:28.67,0:00:30.24,Default,,0,0,0,,Ол небәрі тоғыз жаста.
Dialogue: 0,0:00:32.29,0:00:38.36,Default,,0,0,0,,Әпкесін оятпау үшін, оятқыш шырылдағанда, Кио әрқашан тез тұрады.
Dialogue: 0,0:00:47.72,0:00:51.53,Default,,0,0,0,,Күн сайын таңертең Кио газеттерді жеткізуге кетеді.
Dialogue: 0,0:00:56.00,0:00:57.20,Default,,0,0,0,,Мен қазір барамын.
Dialogue: 0,0:00:57.68,0:00:58.67,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:01:02.99,0:01:06.58,Default,,0,0,0,,Қайырлы таң, Асу. Мен бүгінгі отшашу фестивалін күте алмаймын!
Dialogue: 0,0:01:10.10,0:01:16.16,Default,,0,0,0,,Мен әрқашан екеуін көктен бақылап жүретінмін.
Dialogue: 0,0:01:17.71,0:01:22.97,Default,,0,0,0,,Мен екеуіңе бір ғана нәрсені қалдырдым:
Dialogue: 0,0:01:24.04,0:01:26.75,Default,,0,0,0,,шағын уәде.
Dialogue: 0,0:01:42.38,0:01:46.07,Default,,0,0,0,,Анам Асу туылған жылы жұмаққа аттанды.
Dialogue: 0,0:01:46.57,0:01:49.73,Default,,0,0,0,,Әкем құмар ойындарға қарыздар жинап, жоғалып кетті.
Dialogue: 0,0:01:50.41,0:01:54.01,Default,,0,0,0,,Осылайша бізді тастап кетті.
Dialogue: 0,0:01:54.73,0:01:58.84,Default,,0,0,0,,Бұл 40 жастағы, моншасы жоқ, тозығы жеткен бір бөлмелі пәтер.
Dialogue: 0,0:01:58.84,0:02:00.93,Default,,0,0,0,,Бұл біздің үй.
Dialogue: 0,0:02:01.34,0:02:03.59,Default,,0,0,0,,Бірақ көктем келгенде…
Dialogue: 0,0:03:52.85,0:03:55.44,Default,,0,0,0,,Ах! Уни Чан жақында үйге келеді!
Dialogue: 0,0:03:55.88,0:03:58.15,Default,,0,0,0,,Мен таңғы ас дайындауға кірісуім керек.
Dialogue: 0,0:04:06.92,0:04:08.35,Default,,0,0,0,,Мен аяқтадым.
Dialogue: 0,0:04:09.51,0:04:14.52,Default,,0,0,0,,Енді ойлап қарасам, өткен жылы отшашуды асыға күткен Асу еді.
Dialogue: 0,0:04:14.92,0:04:16.56,Default,,0,0,0,,Бірақ биыл…
Dialogue: 0,0:04:21.18,0:04:22.15,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:04:26.28,0:04:29.74,Default,,0,0,0,,Дұрыс! Кешегі азық-түлік дүкенінен өзгеріс.
Dialogue: 0,0:04:37.52,0:04:40.89,Default,,0,0,0,,Мен саған сенемін. Мен осы күнге дейін аз-аздап ақша жинадым.
Dialogue: 0,0:04:42.27,0:04:45.68,Default,,0,0,0,,Они-чан екеуміз тамақ сататын стендтерде қызық боламыз.
Dialogue: 0,0:04:46.14,0:04:47.55,Default,,0,0,0,,Кәмпит алмалары,
Dialogue: 0,0:04:47.55,0:04:48.91,Default,,0,0,0,,такояки,
Dialogue: 0,0:04:48.91,0:04:50.69,Default,,0,0,0,,және соусы бар күріш крекерлері.
Dialogue: 0,0:04:53.32,0:04:54.40,Default,,0,0,0,,Мен үйдемін!
Dialogue: 0,0:04:55.18,0:04:56.71,Default,,0,0,0,,Они-чан, үйге қош келдіңіз!
Dialogue: 0,0:04:58.81,0:05:00.74,Default,,0,0,0,,Еңбектеріңіз үшін рахмет.
Dialogue: 0,0:05:00.74,0:05:02.53,Default,,0,0,0,,Таңғы ас дайын.
Dialogue: 0,0:05:02.91,0:05:04.99,Default,,0,0,0,,Тағам үшін рахмет!
Dialogue: 0,0:05:10.40,0:05:12.55,Default,,0,0,0,,Бүгін отшашу фестивалі күні!
Dialogue: 0,0:05:12.55,0:05:14.89,Default,,0,0,0,,Иә, шынымен солай!
Dialogue: 0,0:05:15.98,0:05:20.08,Default,,0,0,0,,Әй, мен тазалауды аяқтаған соң, аздап шығуға бола ма?
Dialogue: 0,0:05:20.08,0:05:22.51,Default,,0,0,0,,Бұл жақсы. Өйткені, бүгін жексенбі.
Dialogue: 0,0:05:22.51,0:05:23.84,Default,,0,0,0,,Бірақ сен қайда бара жатырсың?
Dialogue: 0,0:05:24.95,0:05:26.88,Default,,0,0,0,,Сіз кейінірек білесіз.
Dialogue: 0,0:05:29.74,0:05:31.37,Default,,0,0,0,,Мен қазір барамын!
Dialogue: 0,0:05:32.90,0:05:35.78,Default,,0,0,0,,Көрші көрші, пошта жәшігіңіз толы!
Dialogue: 0,0:05:37.37,0:05:39.03,Default,,0,0,0,,Бұл шынымен толы!
Dialogue: 0,0:05:40.77,0:05:43.03,Default,,0,0,0,,Асу! Абайлаңыз, жарай ма?
Dialogue: 0,0:05:43.03,0:05:44.53,Default,,0,0,0,,Мен білемін!
Dialogue: 0,0:05:44.53,0:05:46.70,Default,,0,0,0,,Әй, шын, қайда бара жатырсың?
Dialogue: 0,0:05:46.97,0:05:48.65,Default,,0,0,0,,Кейінірек біле аласыз.
Dialogue: 0,0:05:50.56,0:05:53.94,Default,,0,0,0,,Аа, үй иесі мырза, қайырлы таң.
Dialogue: 0,0:05:56.06,0:05:57.79,Default,,0,0,0,,Олай болса, мен де.
Dialogue: 0,0:06:14.36,0:06:15.10,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:25.88,0:06:26.90,Default,,0,0,0,,Go!
Dialogue: 0,0:06:31.40,0:06:33.99,Default,,0,0,0,,Асу-чан болмаса!
Dialogue: 0,0:06:33.99,0:06:36.50,Default,,0,0,0,,Эй, бұл Яоичидің күйеуі.
Dialogue: 0,0:06:36.92,0:06:39.26,Default,,0,0,0,,Бүгін осы стендте көкөніс сатасыз ба?
Dialogue: 0,0:06:40.57,0:06:42.85,Default,,0,0,0,,Көкөністер фестивальде жақсы сатылмайды.
Dialogue: 0,0:06:42.85,0:06:43.63,Default,,0,0,0,,Ах! Бұл…
Dialogue: 0,0:06:43.98,0:06:46.59,Default,,0,0,0,,Иә, біз бүгін кәмпит алмасы боламыз.
Dialogue: 0,0:06:46.91,0:06:49.43,Default,,0,0,0,,Шынымен бе? Кәмпит алмасы?
Dialogue: 0,0:06:49.73,0:06:52.16,Default,,0,0,0,,Әпкем екеуміз кейінірек сатып алуға келеміз!
Dialogue: 0,0:06:52.16,0:06:55.63,Default,,0,0,0,,Жарайды! Содан кейін мен сізге үлкенірек дайындаймын.
Dialogue: 0,0:06:56.19,0:06:57.73,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:06:59.61,0:07:05.26,Default,,0,0,0,,Мұнда якисоба стенді, ату ойыны стенді және мақта кәмпит стенді бар.
Dialogue: 0,0:07:13.43,0:07:14.99,Default,,0,0,0,,Орындалды!
Dialogue: 0,0:07:22.82,0:07:24.01,Default,,0,0,0,,Ханым!
Dialogue: 0,0:07:27.91,0:07:29.47,Default,,0,0,0,,Мен үйдемін!
Dialogue: 0,0:07:30.50,0:07:33.31,Default,,0,0,0,,Иә? Onee-chan?
Dialogue: 0,0:07:42.20,0:07:44.31,Default,,0,0,0,,T-Ақша бұл…
Dialogue: 0,0:07:55.71,0:07:57.28,Default,,0,0,0,,Асу, мен үйдемін!
Dialogue: 0,0:07:57.82,0:08:00.25,Default,,0,0,0,,Кешіріңіз, кешігіп қалдым.
Dialogue: 0,0:08:01.29,0:08:03.47,Default,,0,0,0,,Не болды? Шамдар да қосылмаған.
Dialogue: 0,0:08:08.35,0:08:10.88,Default,,0,0,0,,Міне, Асу, бұл сыйлық.
Dialogue: 0,0:08:11.71,0:08:12.68,Default,,0,0,0,,Юката…
Dialogue: 0,0:08:13.31,0:08:14.07,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:18.17,0:08:19.66,Default,,0,0,0,,Мұны қайдан алдың?
Dialogue: 0,0:08:19.66,0:08:21.73,Default,,0,0,0,,Мен оны Hashimoto киім дүкенінен сатып алдым.
Dialogue: 0,0:08:22.27,0:08:26.56,Default,,0,0,0,,Менде анамның юкатасы бар, бірақ сізде жоқ.
Dialogue: 0,0:08:26.56,0:08:29.78,Default,,0,0,0,,Мен сізге біраздан бері сыйлық алғым келеді.
Dialogue: 0,0:08:30.23,0:08:34.18,Default,,0,0,0,,Айтпа... Сіз ақшаны банкке пайдаландыңыз ба?
Dialogue: 0,0:08:34.18,0:08:36.66,Default,,0,0,0,,Дұрыс. Асығыңыз және қолданып көріңіз!
Dialogue: 0,0:08:43.60,0:08:44.61,Default,,0,0,0,,Мен мұны қаламаймын.
Dialogue: 0,0:08:45.16,0:08:48.63,Default,,0,0,0,,Неліктен? Мен мұны саған сатып алдым, Асу.
Dialogue: 0,0:08:48.63,0:08:52.12,Default,,0,0,0,,Неліктен ақшаны өзіңіз жұмсадыңыз?
Dialogue: 0,0:08:52.12,0:08:55.43,Default,,0,0,0,,«Неге» дегенді қалай түсінесіңдер? Сізге ұнайды деп ойладым.
Dialogue: 0,0:08:56.64,0:09:00.21,Default,,0,0,0,,Ей, біз әрқашан ақшаны қайтара аламыз.
Dialogue: 0,0:09:00.76,0:09:04.87,Default,,0,0,0,,Жарайды, бұл ақшаны сізден сұрамай жұмсағаным үшін мен кінәлімін.
Dialogue: 0,0:09:04.87,0:09:09.51,Default,,0,0,0,,Бірақ осы күн болғандықтан, жаңа юкатаңызды киіңіз, біз отшашу фестиваліне барамыз, жарай ма?
Dialogue: 0,0:09:10.43,0:09:11.48,Default,,0,0,0,,Мен бармаймын.
Dialogue: 0,0:09:11.89,0:09:13.63,Default,,0,0,0,,Отшашу фестивалі кімге ұнайды?
Dialogue: 0,0:09:14.03,0:09:15.45,Default,,0,0,0,,Мен бармаймын!
Dialogue: 0,0:09:17.44,0:09:19.06,Default,,0,0,0,,Оне-чан, ақымақ!
Dialogue: 0,0:09:29.70,0:09:31.47,Default,,0,0,0,,Мен бұл ақшаны ұзақ сақтадым,
Dialogue: 0,0:09:31.47,0:09:34.24,Default,,0,0,0,,біз оны отшашу фестивалінде бірге өткізуіміз үшін.
Dialogue: 0,0:09:34.88,0:09:38.14,Default,,0,0,0,,Такояки тұғыры. Күріш крекері де…
Dialogue: 0,0:09:38.14,0:09:41.35,Default,,0,0,0,,Мен күткеннің бәрі!
Dialogue: 0,0:09:41.82,0:09:45.26,Default,,0,0,0,,Мен бірге үлкен кәмпит алма жегенімізді қаладым!
Dialogue: 0,0:09:46.85,0:09:47.76,Default,,0,0,0,,Асу…
Dialogue: 0,0:09:56.54,0:09:58.54,Default,,0,0,0,,Мен бұл юкатаны қайтарамын.
Dialogue: 0,0:10:22.21,0:10:23.13,Default,,0,0,0,,Жаңбыр…
Dialogue: 0,0:10:24.71,0:10:26.39,Default,,0,0,0,,Мен Асуды іздеуім керек!
Dialogue: 0,0:10:29.41,0:10:30.58,Default,,0,0,0,,Соңғы рет…
Dialogue: 0,0:10:30.94,0:10:32.86,Default,,0,0,0,,Өткен жолғымен бірдей.
Dialogue: 0,0:10:44.02,0:10:45.80,Default,,0,0,0,,Әрең жетті!
Dialogue: 0,0:10:46.70,0:10:49.17,Default,,0,0,0,,Асу! Асу?
Dialogue: 0,0:10:49.60,0:10:51.49,Default,,0,0,0,,Ол әлі үйде емес...
Dialogue: 0,0:10:51.90,0:10:54.74,Default,,0,0,0,,Мен оның жағдайы жақсы ма деп ойлаймын. Мүмкін ол әлі мектепте шығар.
Dialogue: 0,0:10:54.74,0:10:57.62,Default,,0,0,0,,Егер ол сыртта болса, ол жаңбырдан пана тапты деп үміттенемін.
Dialogue: 0,0:11:01.68,0:11:04.03,Default,,0,0,0,,Мен күн күркіреуін жек көремін!
Dialogue: 0,0:11:07.44,0:11:10.73,Default,,0,0,0,,Ал егер Асу да…
Dialogue: 0,0:11:13.99,0:11:15.49,Default,,0,0,0,,Күте тұр, Асу.
Dialogue: 0,0:11:15.49,0:11:17.81,Default,,0,0,0,,Сені алып кетуге апаң келе жатыр!
Dialogue: 0,0:11:21.55,0:11:24.97,Default,,0,0,0,,Найзағай — жақын жерде соқты.
Dialogue: 0,0:11:24.97,0:11:29.76,Default,,0,0,0,,Иә, менің ойымша, біреу маған найзағай қолшатырларды тартады деп айтты.
Dialogue: 0,0:11:41.77,0:11:42.92,Default,,0,0,0,,...
Dialogue: 0,0:11:43.93,0:11:46.72,Default,,0,0,0,,... Мұнда! Мен осындамын!
Dialogue: 0,0:11:48.08,0:11:53.81,Default,,0,0,0,,Ойлап қарасам, Асу күн күркіреуінен мүлде қорықпады.
Dialogue: 0,0:11:56.58,0:11:58.01,Default,,0,0,0,,Мен өте аяныштымын.
Dialogue: 0,0:12:01.15,0:12:06.99,Default,,0,0,0,,Сол кезде күннің күркіреуінен қорыққаным сонша, Асуды алуға барғанда жарты жолда тастай жаздадым.
Dialogue: 0,0:12:07.44,0:12:08.71,Default,,0,0,0,,Бүгін де…
Dialogue: 0,0:12:10.12,0:12:15.13,Default,,0,0,0,,Мүмкін Асуға мен сияқты апа керек емес шығар.
Dialogue: 0,0:12:18.34,0:12:20.16,Default,,0,0,0,,Әй, Асу-чан.
Dialogue: 0,0:12:20.77,0:12:21.80,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:22.40,0:12:24.76,Default,,0,0,0,,Сіз толығымен сіңдіңіз!
Dialogue: 0,0:12:25.16,0:12:27.26,Default,,0,0,0,,Егер сіз суық тиіп қалсаңыз ше?
Dialogue: 0,0:12:29.04,0:12:30.98,Default,,0,0,0,,Ханым, бұл юката-
Dialogue: 0,0:12:30.98,0:12:33.92,Default,,0,0,0,,О, бұл юката? Сізге ұнайды, солай ма?
Dialogue: 0,0:12:34.95,0:12:37.94,Default,,0,0,0,,Оның дизайны сіздің әпкеңіздікімен бірдей.
Dialogue: 0,0:12:38.40,0:12:39.46,Default,,0,0,0,,Дәл солай ма?
Dialogue: 0,0:12:39.84,0:12:43.90,Default,,0,0,0,,Сондықтан ол басқа ештеңені қабылдамайды.
Dialogue: 0,0:12:43.90,0:12:46.67,Default,,0,0,0,,Ол тіпті оны іздеу үшін біздің қоймаға да барды.
Dialogue: 0,0:12:47.08,0:12:49.97,Default,,0,0,0,,Ол күні бойы іздеген шығар.
Dialogue: 0,0:12:50.54,0:12:52.54,Default,,0,0,0,,Күні бойы?
Dialogue: 0,0:12:53.47,0:12:59.72,Default,,0,0,0,,Ол өзін жаман сезінген шығар, өйткені сізде ешқашан юката киюге болмайды.
Dialogue: 0,0:13:01.16,0:13:06.63,Default,,0,0,0,,Ол маған сәйкес келетін юката табу үшін осыншама қиындыққа барды ма?
Dialogue: 0,0:13:07.39,0:13:08.85,Default,,0,0,0,,Мен үшін…
Dialogue: 0,0:13:09.49,0:13:14.45,Default,,0,0,0,,Ол сәйкес юката киіп, отшашуды бірге тамашалауды асыға күтті.
Dialogue: 0,0:13:14.45,0:13:15.96,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:13:15.96,0:13:18.35,Default,,0,0,0,,Жаңбыр жауып тұр, сондықтан ол жақында тоқтайды.
Dialogue: 0,0:13:19.74,0:13:20.45,Default,,0,0,0,,Жаңбыр…
Dialogue: 0,0:13:21.39,0:13:22.54,Default,,0,0,0,,Дәл бұрынғыдай.
Dialogue: 0,0:13:24.78,0:13:26.62,Default,,0,0,0,,Қолшатырымды ұмытқан күнім.
Dialogue: 0,0:13:31.53,0:13:33.22,Default,,0,0,0,,А, найзағай көбірек.
Dialogue: 0,0:13:33.66,0:13:35.86,Default,,0,0,0,,Ой, бұл ыңғайсыз.
Dialogue: 0,0:13:35.86,0:13:37.93,Default,,0,0,0,,Мен үйге кеш барамын.
Dialogue: 0,0:13:39.64,0:13:41.24,Default,,0,0,0,,Оне-чан?!
Dialogue: 0,0:13:43.09,0:13:45.57,Default,,0,0,0,,... Мұнда! Мен дәл осы жердемін!
Dialogue: 0,0:13:48.12,0:13:50.50,Default,,0,0,0,,Они-чан, сен мені алып кетуге келдің бе?
Dialogue: 0,0:13:51.59,0:13:54.35,Default,,0,0,0,,Бірақ жаңбыр басылған сияқты.
Dialogue: 0,0:13:56.69,0:14:00.09,Default,,0,0,0,,Сіз қолшатырыңызды да қолданбадыңыз, солай ма?
Dialogue: 0,0:14:04.01,0:14:07.20,Default,,0,0,0,,Они-чан күн күркіреуін жек көреді, бірақ ол оған батылдықпен келді.
Dialogue: 0,0:14:09.88,0:14:12.05,Default,,0,0,0,,Сіз оларды әкелгендіктен, бәрібір қолданайық.
Dialogue: 0,0:14:12.05,0:14:14.71,Default,,0,0,0,,Не? Бұл ұят!
Dialogue: 0,0:14:16.97,0:14:19.08,Default,,0,0,0,,Мұның бәрі және әлі де…
Dialogue: 0,0:14:19.35,0:14:21.04,Default,,0,0,0,,Они-чан, ақымақ!
Dialogue: 0,0:14:22.11,0:14:25.30,Default,,0,0,0,,Мен... әпкемді қиналып жүрмін.
Dialogue: 0,0:14:26.24,0:14:30.27,Default,,0,0,0,,Кью әрқашан сені іздейді, солай ма?
Dialogue: 0,0:14:30.27,0:14:31.96,Default,,0,0,0,,Мен оған оның ақымақ екенін айттым.
Dialogue: 0,0:14:32.54,0:14:36.73,Default,,0,0,0,,Оның мен үшін жасаған барлық істерінен кейін мен оны ақымақ деп атадым.
Dialogue: 0,0:14:37.11,0:14:38.07,Default,,0,0,0,,I…
Dialogue: 0,0:14:40.62,0:14:43.46,Default,,0,0,0,,Бәрі жақсы, Асу.
Dialogue: 0,0:14:44.25,0:14:46.24,Default,,0,0,0,,Мен не болғанын білмеймін,
Dialogue: 0,0:14:46.75,0:14:50.41,Default,,0,0,0,,бірақ сіздің әпкеңіз осы юкатаны іздеу үшін көп жұмыс жасады.
Dialogue: 0,0:14:50.99,0:14:53.68,Default,,0,0,0,,Неге оны киіп, оған көрсетпейсің?
Dialogue: 0,0:14:55.01,0:14:56.86,Default,,0,0,0,,...
Dialogue: 0,0:15:08.58,0:15:09.67,Default,,0,0,0,,Оне-чан?!
Dialogue: 0,0:15:10.55,0:15:11.78,Default,,0,0,0,,Ол мұнда жоқ.
Dialogue: 0,0:15:15.43,0:15:16.41,Default,,0,0,0,,Отшашу...
Dialogue: 0,0:15:25.33,0:15:26.82,Default,,0,0,0,,Асу!
Dialogue: 0,0:15:30.02,0:15:31.32,Default,,0,0,0,,Асу!
Dialogue: 0,0:15:41.57,0:15:43.13,Default,,0,0,0,,Әдемі!
Dialogue: 0,0:15:44.44,0:15:46.97,Default,,0,0,0,,Тамая! Кагия!
Dialogue: 0,0:15:44.44,0:15:51.93,Default,,0,0,0,,Тамая мен Кагия атақты бәсекелес отшашуларды өндірушілер болды. Көрмелерде адамдар өздерінің сүйікті адамдарын іздейді - енді олардың есімдерін айқайлау - бұл жай ғана дәстүр.
Dialogue: 0,0:15:48.94,0:15:51.93,Default,,0,0,0,,Жыл сайын Асу екеуміз оларды бірге тамашалаймыз.
Dialogue: 0,0:15:51.93,0:15:53.75,Default,,0,0,0,,Мен жалғыз болсам, мағынасы жоқ.
Dialogue: 0,0:15:54.95,0:15:58.34,Default,,0,0,0,,Сонда да мен Асудың осында болатынын күттім.
Dialogue: 0,0:15:58.34,0:15:59.77,Default,,0,0,0,,Сәлем, Кью!
Dialogue: 0,0:16:00.68,0:16:02.48,Default,,0,0,0,,Сіз дәл уақытында келдіңіз.
Dialogue: 0,0:16:02.48,0:16:05.40,Default,,0,0,0,,Арнайы кәмпит алма дайын болды.
Dialogue: 0,0:16:05.40,0:16:06.77,Default,,0,0,0,,Яоичи ата!
Dialogue: 0,0:16:07.15,0:16:09.79,Default,,0,0,0,,Асу мұны асыға күтті.
Dialogue: 0,0:16:09.79,0:16:11.99,Default,,0,0,0,,Ол әпкесімен келетінін айтты.
Dialogue: 0,0:16:11.99,0:16:13.61,Default,,0,0,0,,Не? Асу айтты ма?
Dialogue: 0,0:16:13.61,0:16:14.46,Default,,0,0,0,,Иә.
Dialogue: 0,0:16:14.46,0:16:18.58,Default,,0,0,0,,Ол стендтерді көруге келді, ол сізді фестиваль кезінде алып барғысы келетінін айтты.
Dialogue: 0,0:16:18.72,0:16:19.44,Default,,0,0,0,,Не?
Dialogue: 0,0:16:20.68,0:16:21.71,Default,,0,0,0,,Ол жасады ма?!
Dialogue: 0,0:16:25.54,0:16:26.96,Default,,0,0,0,,Бұл жазба…
Dialogue: 0,0:16:28.72,0:16:32.24,Default,,0,0,0,,Асу... ол мені алып жүру үшін жоспар құрды.
Dialogue: 0,0:16:34.74,0:16:36.43,Default,,0,0,0,,Мен үшін…
Dialogue: 0,0:16:37.41,0:16:39.68,Default,,0,0,0,,Неге ақшаны өзіңіз жұмсадыңыз?
Dialogue: 0,0:16:40.41,0:16:42.14,Default,,0,0,0,,Отшашу фестивалі кімге ұнайды?
Dialogue: 0,0:16:42.68,0:16:43.81,Default,,0,0,0,,Мен бармаймын!
Dialogue: 0,0:16:46.28,0:16:48.03,Default,,0,0,0,,Мен өте ақымақпын.
Dialogue: 0,0:16:50.25,0:16:51.45,Default,,0,0,0,,Өте ақымақ!
Dialogue: 0,0:16:54.45,0:16:57.31,Default,,0,0,0,,Міне, орындалды! Сіздің ерекше кәмпит алма!
Dialogue: 0,0:16:57.31,0:16:59.95,Default,,0,0,0,,Иә? Кёу-чан?
Dialogue: 0,0:17:01.57,0:17:05.06,Default,,0,0,0,,Асу менімен бірге фестивальді тамашалағысы келді,
Dialogue: 0,0:17:05.41,0:17:09.21,Default,,0,0,0,,бірақ мен оның сезімін түсінбедім.
Dialogue: 0,0:17:09.60,0:17:10.92,Default,,0,0,0,,Оның сезімдері.
Dialogue: 0,0:17:13.20,0:17:16.64,Default,,0,0,0,,Мен анама Асуға жақсы қараймын деп уәде бердім.
Dialogue: 0,0:17:17.39,0:17:18.62,Default,,0,0,0,,Мен оған уәде бердім.
Dialogue: 0,0:17:23.77,0:17:25.06,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:17:25.98,0:17:27.22,Default,,0,0,0,,Маған өтуге рұқсат етіңіз.
Dialogue: 0,0:17:29.68,0:17:30.62,Default,,0,0,0,,Тез…
Dialogue: 0,0:17:30.62,0:17:34.81,Default,,0,0,0,,Отшашу біткенше мен Они-чанды тез тауып алуым керек.
Dialogue: 0,0:17:36.01,0:17:36.94,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:17:37.70,0:17:40.00,Default,,0,0,0,,...
Dialogue: 0,0:17:42.21,0:17:43.22,Default,,0,0,0,,Асу?
Dialogue: 0,0:17:46.17,0:17:46.96,Default,,0,0,0,,Асу…
Dialogue: 0,0:17:47.28,0:17:48.33,Default,,0,0,0,,Асу осында!
Dialogue: 0,0:17:59.04,0:18:02.19,Default,,0,0,0,,Асу!
Dialogue: 0,0:18:04.82,0:18:05.81,Default,,0,0,0,,...
Dialogue: 0,0:18:07.59,0:18:09.45,Default,,0,0,0,,Асу!
Dialogue: 0,0:18:12.22,0:18:13.57,Default,,0,0,0,,...
Dialogue: 0,0:18:13.57,0:18:15.53,Default,,0,0,0,,Асу!
Dialogue: 0,0:18:16.72,0:18:18.63,Default,,0,0,0,,...
Dialogue: 0,0:18:30.79,0:18:32.97,Default,,0,0,0,,Оне-чан, мен…
Dialogue: 0,0:18:33.58,0:18:36.05,Default,,0,0,0,,Мен… Мен…
Dialogue: 0,0:18:36.74,0:18:39.50,Default,,0,0,0,,Рахмет. Сіз юката киіп алғансыз.
Dialogue: 0,0:18:40.67,0:18:42.30,Default,,0,0,0,,...
Dialogue: 0,0:18:43.49,0:18:44.82,Default,,0,0,0,,Ой, отшашу!
Dialogue: 0,0:18:47.13,0:18:50.48,Default,,0,0,0,,Асу, біз биыл да отшашуды тамашалай алдық.
Dialogue: 0,0:18:52.61,0:18:53.19,Default,,0,0,0,,Иә.
Dialogue: 0,0:18:54.17,0:18:56.12,Default,,0,0,0,,Біз оларды осы жылы тағы да көрдік.
Dialogue: 0,0:18:56.12,0:18:57.15,Default,,0,0,0,,Иә.
Dialogue: 0,0:19:37.15,0:19:38.40,Default,,0,0,0,,Кішкене демалмайсың ба?
Dialogue: 0,0:19:38.75,0:19:42.09,Default,,0,0,0,,Асу! Неге мұндасың? Үйге бар!
Dialogue: 0,0:19:43.05,0:19:45.73,Default,,0,0,0,,Они-чан, мен де жұмыс істегім келеді!
Dialogue: 0,0:19:46.42,0:19:50.41,Default,,0,0,0,,Ақша туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:19:50.41,0:19:53.36,Default,,0,0,0,,Мен көбірек жұмыс істеймін.
Dialogue: 0,0:19:53.36,0:19:54.61,Default,,0,0,0,,Бәрі дұрыс.
Dialogue: 0,0:19:54.61,0:19:56.34,Default,,0,0,0,,Мен басқа жұмысқа орналасамын.
Dialogue: 0,0:19:56.34,0:19:57.39,Default,,0,0,0,,Бұл олай емес.
Dialogue: 0,0:19:58.38,0:19:59.35,Default,,0,0,0,,...
Dialogue: 0,0:20:02.29,0:20:03.79,Default,,0,0,0,,Мені артта қалдырмаңыз.
Dialogue: 0,0:20:04.34,0:20:07.06,Default,,0,0,0,,Әкем сияқты жоғалып кетпе.
Dialogue: 0,0:20:09.27,0:20:12.83,Default,,0,0,0,,Мен сені ақымақ деп атадым, бірақ сонда да...
Dialogue: 0,0:20:13.37,0:20:15.73,Default,,0,0,0,,Өтінемін, мені тастама!
Dialogue: 0,0:20:21.36,0:20:22.33,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:20:23.94,0:20:26.58,Default,,0,0,0,,Они-чан дәл осы жерде.
Dialogue: 0,0:20:27.55,0:20:29.34,Default,,0,0,0,,Мен ешқайда бармаймын.
Dialogue: 0,0:20:33.27,0:20:34.68,Default,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:20:35.22,0:20:36.43,Default,,0,0,0,,...
Dialogue: 0,0:20:39.11,0:20:44.06,Default,,0,0,0,,Асу, жарайды. Әпкең ешқайда кетпейді.
Dialogue: 0,0:20:44.98,0:20:50.23,Default,,0,0,0,,Кёу, сізге көп жұмыс істемеу туралы алаңдамаудың қажеті жоқ.
Dialogue: 0,0:20:51.43,0:21:00.68,Default,,0,0,0,,Мен екеуіңе қалдырған жалғыз нәрсе - бұл кішкентай ғана уәде, бірақ ол сені қатты қорғайды.
Dialogue: 0,0:21:00.68,0:21:05.95,Default,,0,0,0,,Бір күні, сіз күш шақыра алмайсыз ...
Dialogue: 0,0:21:10.31,0:21:11.33,Default,,0,0,0,,Күн…
Dialogue: 0,0:21:12.25,0:21:13.68,Default,,0,0,0,,Бұл әдемі емес пе?
Dialogue: 0,0:21:13.68,0:21:14.43,Default,,0,0,0,,Иә.
Dialogue: 0,0:21:14.87,0:21:21.00,Default,,0,0,0,,Менің уәдем екеуіңіздің араларыңыздағы байланысты қорғайды.
Dialogue: 0,0:21:21.00,0:21:24.50,Default,,0,0,0,,Мен бұл уәдемді әрқашан орындаймын.
Dialogue: 0,0:22:57.48,0:22:58.56,Default,,0,0,0,,Ол осы айда қайтады!
Dialogue: 0,0:22:58.56,0:22:59.69,Default,,0,0,0,,Байлықтың қара мырзасы!
Dialogue: 0,0:23:00.09,0:23:02.02,Default,,0,0,0,,А? Үй иесі әлі келген жоқ, солай ма?
Dialogue: 0,0:23:02.02,0:23:03.32,Default,,0,0,0,,Мен не болды деп ойлаймын.
Dialogue: 0,0:23:03.75,0:23:05.60,Default,,0,0,0,,Бейшара апалардың әңгімесі:
Dialogue: 0,0:23:05.60,0:23:08.53,Default,,0,0,0,,«Үй иесінің күні, қарбыз және ауруханаға бару».
Dialogue: 0,0:23:08.53,0:23:10.02,Default,,0,0,0,,Көріңіз!
Dialogue: 0,0:22:56.02,0:22:56.06,Default,,0,0,0,,Бинбу Шимай Моногатари
Dialogue: 0,0:22:56.06,0:22:57.48,Default,,0,0,0,,Бинбу Шимай Моногатари
