Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.90,0:00:13.15,Simai's OS,,0,0,0,,Біздің ата-анамыз жоқ
Dialogue: 0,0:00:13.61,0:00:16.87,Simai's OS,,0,0,0,,Сондықтан ертең екеуміз бірге еңбек еттік.
Dialogue: 0,0:00:17.53,0:00:20.54,Simai's OS,,0,0,0,,Біз бас тартқымыз келсе де, бірге жеңдік.
Dialogue: 0,0:00:21.16,0:00:23.12,Simai's OS,,0,0,0,,Мен өмірімді осы уақытқа дейін осылай ойлап өттім.
Dialogue: 0,0:00:24.08,0:00:26.88,Default,,0,0,0,,Осы айда күнкөріс шығыны тағы да азайып кетті.
Dialogue: 0,0:00:26.88,0:00:28.67,Default,,0,0,0,,Иә, мен қысылып қалдым.
Dialogue: 0,0:00:31.13,0:00:34.38,Simai's OS,,0,0,0,,Мына шие гүлдері ашылатын көктем әлі алыс.
Dialogue: 0,0:00:34.84,0:00:36.84,Simai's OS,,0,0,0,,Қаһарлы қыс келе жатыр.
Dialogue: 0,0:00:37.22,0:00:41.47,Simai's OS,,0,0,0,,Сол суықтан бізді қорғайтын ешкім жоқ.
Dialogue: 0,0:00:42.23,0:00:44.69,Simai's OS,,0,0,0,,Оның қандай суық екенін ешкім түсінбейді
Dialogue: 0,0:00:44.98,0:00:46.81,Simai's OS,,0,0,0,,Мен де солай ойладым.
Dialogue: 0,0:00:47.73,0:00:48.11,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:00:49.07,0:00:50.86,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:00:53.86,0:00:55.24,Default,,0,0,0,,Мен жеңіле алмаймын
Dialogue: 0,0:01:02.58,0:01:05.87,Default,,0,0,0,,Үлкен апа, үй иесі де шие гүліне қарап отыр.
Dialogue: 0,0:01:05.96,0:01:06.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:07.25,0:01:08.42,Default,,0,0,0,,Аа, бұл рас.
Dialogue: 0,0:01:09.21,0:01:11.59,Default,,0,0,0,,Мен сенен тағы бір рет сұрайын ба?
Dialogue: 0,0:01:11.80,0:01:14.17,Default,,0,0,0,,Иә...бірақ жақсы ма?
Dialogue: 0,0:01:14.72,0:01:18.39,Default,,0,0,0,,Мен бірнеше рет сұрағаным сонша, маған «жоқ» деп жауап беруі мүмкін...
Dialogue: 0,0:01:19.35,0:01:21.31,Default,,0,0,0,,Ол уақыт сол уақыт.
Dialogue: 0,0:01:24.23,0:01:24.81,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:34.49,0:01:38.16,Default,,0,0,0,,Мен туған жылы анам дүниеден өтті.
Dialogue: 0,0:01:38.70,0:01:41.83,Default,,0,0,0,,Әкем құмар ойындар арқылы қарызға батып, қайтыс болды.
Dialogue: 0,0:01:42.62,0:01:45.62,Default,,0,0,0,,Ал біз артта қалдық
Dialogue: 0,0:01:46.87,0:01:50.54,Default,,0,0,0,,40 жыл, едені жоқ 1К тозған пәтер
Dialogue: 0,0:01:51.09,0:01:52.96,Default,,0,0,0,,Бұл біздің үй
Dialogue: 0,0:01:53.55,0:01:55.63,Default,,0,0,0,,Бірақ көктем келгенде...
Dialogue: 0,0:01:56.29,0:02:00.92,OP_Jan,,0,0,0,,Өйткені мен естеліктеріме орала алмаймын
Dialogue: 0,0:02:00.92,0:02:05.61,OP_Jan,,0,0,0,,Бүгін өмір сүріп, ертеңді қолға ал
Dialogue: 0,0:02:15.39,0:02:24.20,OP_Jan,,0,0,0,,Жалғыз болсаң да, жалғыз емессің
Dialogue: 0,0:02:24.81,0:02:33.63,OP_Jan,,0,0,0,,Біз жалғыз емеспіз, біз жалғыз емеспіз
Dialogue: 0,0:02:34.39,0:02:43.12,OP_Jan,,0,0,0,,Әлі аққан жастың алдында
Dialogue: 0,0:02:43.88,0:02:52.77,OP_Jan,,0,0,0,,Қызық, күліп, терең тыныс аламын ба?
Dialogue: 0,0:02:52.77,0:02:57.36,OP_Jan,,0,0,0,,Өйткені мен өз естеліктерімді қайтара алмаймын
Dialogue: 0,0:02:57.36,0:03:02.00,OP_Jan,,0,0,0,,Бүгін өмір сүріп, ертеңді қолға ал
Dialogue: 0,0:03:02.14,0:03:11.50,OP_Jan,,0,0,0,,Сенің таптырмас асылың жүрегімде
Dialogue: 0,0:03:11.55,0:03:16.81,OP_Jan,,0,0,0,,Басынан соққан желге терең тыныс алу
Dialogue: 0,0:03:39.74,0:03:40.70,Default,,0,0,0,,Жалға беруші~
Dialogue: 0,0:04:01.38,0:04:03.59,Default,,0,0,0,,Эрико... Мама...?
Dialogue: 0,0:04:08.68,0:04:09.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:10.18,0:04:12.02,Default,,0,0,0,,А... жоқ, не керек?
Dialogue: 0,0:04:12.69,0:04:14.15,Default,,0,0,0,,Ух...
Dialogue: 0,0:04:16.52,0:04:20.40,Default,,0,0,0,,Осы айдың жалдау ақысын төлеу үшін жалақы күніне дейін күте аласыз ба?
Dialogue: 0,0:04:22.78,0:04:24.49,Default,,0,0,0,,О, маған бәрібір.
Dialogue: 0,0:04:32.37,0:04:34.75,Default,,0,0,0,,Мен құтқарылдым... бірақ...
Dialogue: 0,0:04:35.08,0:04:37.13,Default,,0,0,0,,Бұл біртүрлі болды, үй иесі.
Dialogue: 0,0:04:37.21,0:04:41.09,Default,,0,0,0,,Иә... Эрико-сан мен Мәми-сан кімдер?
Dialogue: 0,0:04:42.97,0:04:45.64,Default,,0,0,0,,Қожайын, сіз не қарап едіңіз?
Dialogue: 0,0:04:46.18,0:04:47.89,Simai's OS,,0,0,0,,Мен не көрдім?
Dialogue: 0,0:05:14.41,0:05:15.33,Default,,0,0,0,,Мен үйдемін~
Dialogue: 0,0:05:16.17,0:05:18.08,Default,,0,0,0,,Ертең мен жалақы алдым.
Dialogue: 0,0:05:18.67,0:05:20.17,Default,,0,0,0,,Қош келдіңіз, апа.
Dialogue: 0,0:05:20.55,0:05:20.92,Default,,0,0,0,,Иә
Dialogue: 0,0:05:24.05,0:05:25.26,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:05:26.01,0:05:29.14,Default,,0,0,0,,Мен де осы айда тәлімгер ретінде толық емес жұмыс күнім болды.
Dialogue: 0,0:05:29.18,0:05:31.22,Default,,0,0,0,,Әдеттегіден сәл ғана бос.
Dialogue: 0,0:05:31.60,0:05:32.97,Default,,0,0,0,,Сіз мұны жасадыңыз, әпке.
Dialogue: 0,0:05:33.47,0:05:38.15,Default,,0,0,0,,Ең алдымен үй иесі күткен өткен айдың жалдау ақысын төлейсіз.
Dialogue: 0,0:05:38.69,0:05:43.11,Default,,0,0,0,,Олай болса, ертең де демалыс, олай болса бір жерге шығайық.
Dialogue: 0,0:05:47.15,0:05:47.95,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:05:48.41,0:05:49.49,Default,,0,0,0,,Біз қайда барамыз?
Dialogue: 0,0:05:49.78,0:05:50.91,Default,,0,0,0,,Иә~
Dialogue: 0,0:05:52.37,0:05:54.33,Default,,0,0,0,,Ертеңге дейін ойланып көрейік.
Dialogue: 0,0:05:55.04,0:05:55.58,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:28.32,0:06:28.86,Default,,0,0,0,,Ертең
Dialogue: 0,0:06:30.45,0:06:32.74,Default,,0,0,0,,Барғыңыз келетін жер болды ма?
Dialogue: 0,0:06:33.78,0:06:36.20,Default,,0,0,0,,Жоқ, әпкең ше?
Dialogue: 0,0:06:37.25,0:06:40.92,Default,,0,0,0,,Әлі де ойланып жүр
Dialogue: 0,0:06:50.09,0:06:52.60,Default,,0,0,0,,Өйткені, біз тынышпыз.
Dialogue: 0,0:06:52.76,0:06:54.01,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:06:55.85,0:06:56.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:58.10,0:06:58.89,Default,,0,0,0,,Не?
Dialogue: 0,0:06:58.98,0:06:59.73,Default,,0,0,0,,Сол жерде
Dialogue: 0,0:07:00.27,0:07:00.94,Default,,0,0,0,,Қайда?
Dialogue: 0,0:07:01.31,0:07:02.44,Default,,0,0,0,,Мына жерде
Dialogue: 0,0:07:09.95,0:07:11.45,Default,,0,0,0,,Әпке, бұл...
Dialogue: 0,0:07:11.86,0:07:13.95,Default,,0,0,0,,Иә, гүлдеп жатыр.
Dialogue: 0,0:07:22.63,0:07:25.00,Default,,0,0,0,,Кеш болды, әпке.
Dialogue: 0,0:07:25.25,0:07:26.67,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:07:27.25,0:07:31.47,Default,,0,0,0,,Бірақ мен бүгін шынымен босаңсып, босаңсып қалдым, сондықтан жақсы болды.
Dialogue: 0,0:07:31.47,0:07:33.01,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:07:35.18,0:07:38.77,Default,,0,0,0,,Әй, әпке, бүгін ерте Гавайиге барайық.
Dialogue: 0,0:07:39.06,0:07:41.77,Default,,0,0,0,,Дұрыс, бүгін ертерек барайық.
Dialogue: 0,0:07:47.53,0:07:51.28,Default,,0,0,0,,Енді әдеттегіден баяу кіргіңіз келе ме?
Dialogue: 0,0:07:51.40,0:07:53.11,Default,,0,0,0,,Иә, барғың келе ме?
Dialogue: 0,0:08:11.76,0:08:14.05,Default,,0,0,0,,Иә, сен осындасың...?
Dialogue: 0,0:08:14.05,0:08:15.59,Default,,0,0,0,,Б-не болды?
Dialogue: 0,0:08:15.85,0:08:17.51,Default,,0,0,0,,Кио Чан? Асу-чан?
Dialogue: 0,0:08:21.89,0:08:23.77,Default,,0,0,0,,Екеуің де бозарып кеткен сияқтысыңдар.
Dialogue: 0,0:08:26.61,0:08:28.52,Default,,0,0,0,,Не болды? Кио-чан
Dialogue: 0,0:08:29.32,0:08:30.15,Default,,0,0,0,,Апай…
Dialogue: 0,0:08:31.11,0:08:34.82,Default,,0,0,0,,Біз пәтерден көшуіміз керек.
Dialogue: 0,0:08:36.24,0:08:37.28,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:08:41.25,0:08:42.96,Default,,0,0,0,,Қайырлы кеш, үй иесі.
Dialogue: 0,0:08:43.41,0:08:45.75,Default,,0,0,0,,Біз қазірден бастап шомыламыз.
Dialogue: 0,0:08:45.75,0:08:46.67,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:47.71,0:08:51.92,Default,,0,0,0,,Одан гөрі, балалар... пәтерден көшіп кетсеңіздер екен?
Dialogue: 0,0:08:53.80,0:08:54.30,Default,,0,0,0,,Е! ?
Dialogue: 0,0:08:54.93,0:08:57.14,Default,,0,0,0,,Мен сенен кетуіңді сұраймын.
Dialogue: 0,0:08:57.47,0:09:00.56,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:02.93,0:09:05.52,Default,,0,0,0,,Өткен айдың жалдау ақысы кеше төленсе...
Dialogue: 0,0:09:05.73,0:09:08.65,Default,,0,0,0,,Бізде қазір көп уақыт жоқ.
Dialogue: 0,0:09:08.86,0:09:09.61,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:12.99,0:09:16.82,Default,,0,0,0,,Бізді бұл жерден қуып жіберсе, барар жеріміз жоқ.
Dialogue: 0,0:09:16.82,0:09:21.04,Default,,0,0,0,,Егер сізге кетуді бұйырса, сіз дереу кетуге шешім қабылдауыңыз керек еді.
Dialogue: 0,0:09:26.12,0:09:27.54,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:09:31.05,0:09:34.72,Default,,0,0,0,,Әпке, шынымен кету керек пе?
Dialogue: 0,0:09:34.97,0:09:38.64,Default,,0,0,0,,Оған көмектесу мүмкін емес. Мен үй иесіне қиындық келтіре алмаймын.
Dialogue: 0,0:09:41.64,0:09:45.68,Simai's OS,,0,0,0,,Неге ата-анасы жоқ бізге бөлме жалдайсың?
Dialogue: 0,0:09:45.98,0:09:48.15,Simai's OS,,0,0,0,,Менің ойымша, адамдар мені мазасызданды деп ойлады.
Dialogue: 0,0:09:54.44,0:09:57.91,Default,,0,0,0,,Бірақ эй, уақыт келді! Ертең
Dialogue: 0,0:09:58.91,0:10:00.78,Default,,0,0,0,,Дұрыс, апа.
Dialogue: 0,0:10:02.62,0:10:06.04,Default,,0,0,0,,Біз бірге аман қалу үшін бар күшімізді салуымыз керек.
Dialogue: 0,0:10:06.37,0:10:08.29,Default,,0,0,0,,Мен мұндай нәрседен ұтыла алмаймын.
Dialogue: 0,0:10:16.92,0:10:21.22,Default,,0,0,0,,Көктем болса да, мен бұл бөлмеден шие гүлдерін көре алмаймын.
Dialogue: 0,0:10:21.43,0:10:22.01,Default,,0,0,0,,Иә...
Dialogue: 0,0:10:27.69,0:10:30.23,Default,,0,0,0,,Мен де қауесет арқылы естідім.
Dialogue: 0,0:10:31.48,0:10:35.69,Default,,0,0,0,,Осы жерде көпқабатты тұрғын үй салынып жатқан көрінеді.
Dialogue: 0,0:10:35.78,0:10:37.32,Default,,0,0,0,,Ех! ? Бұл...
Dialogue: 0,0:10:37.53,0:10:41.37,Default,,0,0,0,,Бұл кондоминиум салу үшін бұл пәтер де бұзылады дегенді білдіре ме?
Dialogue: 0,0:10:41.66,0:10:43.70,Default,,0,0,0,,Мұның мағынасы осы емес пе?
Dialogue: 0,0:10:44.08,0:10:46.54,Default,,0,0,0,,Сондықтан үй иесі менің кетуімді өтінді...
Dialogue: 0,0:10:47.29,0:10:49.25,Default,,0,0,0,,Маған әлі айтқан жоқ.
Dialogue: 0,0:10:49.37,0:10:52.08,Default,,0,0,0,,-дан бастаған дұрыс.
Dialogue: 0,0:10:54.00,0:10:57.30,Default,,0,0,0,,Апа, мына шие гүлдері де жоғалып кете ме?
Dialogue: 0,0:10:57.38,0:10:59.38,Default,,0,0,0,,Көп пәтерлі үй салынса, мүмкін...
Dialogue: 0,0:10:59.88,0:11:00.97,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:11:01.09,0:11:03.68,Default,,0,0,0,,Үй иесі де мына шие гүлдеріне қарап тұрды ғой?
Dialogue: 0,0:11:05.01,0:11:08.35,Default,,0,0,0,,Бағалы шие гүлдері жоғалып кеткендіктен болар.
Dialogue: 0,0:11:39.01,0:11:42.26,Default,,0,0,0,,Ертең Бұл бөлме кең және ыңғайлы көрінеді.
Dialogue: 0,0:11:42.26,0:11:43.22,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:11:43.80,0:11:46.14,Default,,0,0,0,,А, бұл да ертең өте жақсы.
Dialogue: 0,0:11:46.31,0:11:46.93,Default,,0,0,0,,Иә~
Dialogue: 0,0:11:47.47,0:11:48.72,Default,,0,0,0,,Көп нәрсе бар.
Dialogue: 0,0:11:49.18,0:11:49.68,Default,,0,0,0,,Иә
Dialogue: 0,0:11:50.10,0:11:51.73,Default,,0,0,0,,Бұл қымбат емес,
Dialogue: 0,0:11:51.73,0:11:55.19,Default,,0,0,0,,Өзіміз төлей алатын бөлмелер көп.
Dialogue: 0,0:11:55.44,0:11:56.57,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:12:12.00,0:12:13.58,Default,,0,0,0,,Ондағы екі адам
Dialogue: 0,0:12:14.46,0:12:17.42,Default,,0,0,0,,Қаласаңыз, ішінде әртүрлі қасиеттер бар.
Dialogue: 0,0:12:17.46,0:12:18.13,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:12:18.38,0:12:19.76,Default,,0,0,0,,О, мм...
Dialogue: 0,0:12:20.71,0:12:22.88,Default,,0,0,0,,Кешіріңіз, бүгін жақсы.
Dialogue: 0,0:12:30.02,0:12:31.02,Default,,0,0,0,,О, бұл естелік екен. Өте рахмет
Dialogue: 0,0:12:32.06,0:12:35.27,Default,,0,0,0,,Мен шынымен де сол пәтерді бұзуым керек пе?
Dialogue: 0,0:12:35.73,0:12:37.94,Default,,0,0,0,,Егер үй иесі солай шешсе,
Dialogue: 0,0:12:38.27,0:12:40.44,Default,,0,0,0,,Біз ештеңе айта алмаймыз.
Dialogue: 0,0:12:40.86,0:12:42.65,Default,,0,0,0,,Мен кеткім келмейді!
Dialogue: 0,0:12:43.32,0:12:45.82,Default,,0,0,0,,Мен келесі жылы сол бөлмедегі шие гүлдерін көргім келеді.
Dialogue: 0,0:12:46.16,0:12:46.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:48.53,0:12:51.70,Simai's OS,,0,0,0,,Асудың өзімшіл болуы әдеттен тыс нәрсе деп ойладым.
Dialogue: 0,0:12:52.16,0:12:55.33,Simai's OS,,0,0,0,,Бірақ мен де дәл солай сезіндім.
Dialogue: 0,0:12:55.37,0:12:57.96,Simai's OS,,0,0,0,,Бұл екеуінің өзімшілдігі екеніне сенімдімін.
Dialogue: 0,0:12:59.00,0:13:00.55,Simai's OS,,0,0,0,,Неге екенін білмеймін
Dialogue: 0,0:13:00.84,0:13:03.22,Simai's OS,,0,0,0,,Жаңа, үлкенірек бөлмеге қарау
Dialogue: 0,0:13:03.42,0:13:06.09,Simai's OS,,0,0,0,,Мен ол жерде керемет өмірді елестетсем де
Dialogue: 0,0:13:06.51,0:13:08.68,Simai's OS,,0,0,0,,Неге екені белгісіз, мен оны қызық деп ойламадым.
Dialogue: 0,0:13:09.43,0:13:12.93,Simai's OS,,0,0,0,,Мен бұл пәтерді қалай қиратпайды деп ойлаймын.
Dialogue: 0,0:13:13.31,0:13:16.02,Simai's OS,,0,0,0,,Менің ойым осы ғана
Dialogue: 0,0:13:29.74,0:13:30.53,Default,,0,0,0,,Үлкен әпке!
Dialogue: 0,0:13:38.88,0:13:43.05,Default,,0,0,0,,Осы жерде мәңгі қалсам, үй иесіне қиындық тудырамын ба деп қорқамын.
Dialogue: 0,0:13:43.21,0:13:44.26,Default,,0,0,0,,Енді барайық
Dialogue: 0,0:13:44.30,0:13:44.88,Default,,0,0,0,,Иә
Dialogue: 0,0:13:52.68,0:13:55.98,Default,,0,0,0,,Маған тезірек баспана табу керек. Ертең.
Dialogue: 0,0:13:57.94,0:13:59.61,Default,,0,0,0,,Бүгін-чан Асу-чан
Dialogue: 0,0:14:01.23,0:14:02.23,Default,,0,0,0,,Сәлем
Dialogue: 0,0:14:02.40,0:14:04.82,Default,,0,0,0,,Осындай үлкен жүкті алып жүру
Dialogue: 0,0:14:04.82,0:14:06.78,Default,,0,0,0,,Сіз тұратын жер іздеп жүрсіз бе?
Dialogue: 0,0:14:07.07,0:14:07.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:08.16,0:14:09.49,Default,,0,0,0,,А, иә...
Dialogue: 0,0:14:09.78,0:14:11.74,Default,,0,0,0,,Олай болса жақсы.
Dialogue: 0,0:14:12.08,0:14:12.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:12.95,0:14:15.41,Default,,0,0,0,,Менің екінші қабатым бос.
Dialogue: 0,0:14:19.25,0:14:20.46,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:14:20.79,0:14:22.88,Default,,0,0,0,,Жоқ, жоқ, күтіңіз, күтіңіз
Dialogue: 0,0:14:22.88,0:14:24.51,Default,,0,0,0,,Иә, сәл күте тұрыңыз.
Dialogue: 0,0:14:24.84,0:14:28.30,Default,,0,0,0,,Кио Чан мен Асучан менімен екінші қабатта тұрады.
Dialogue: 0,0:14:28.30,0:14:28.76,Default,,0,0,0,,Е...
Dialogue: 0,0:14:28.76,0:14:32.85,Default,,0,0,0,,Жоқ, жоқ, менің үйім әдемі және кең.
Dialogue: 0,0:14:32.85,0:14:33.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:33.81,0:14:35.47,Default,,0,0,0,,О... не?
Dialogue: 0,0:14:35.47,0:14:37.60,Default,,0,0,0,,Бізге жалға алудың қажеті жоқ.
Dialogue: 0,0:14:37.60,0:14:38.73,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:14:39.14,0:14:41.31,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:41.31,0:14:43.27,Default,,0,0,0,,Иә, сіз нені айтып тұрсыз?
Dialogue: 0,0:14:43.27,0:14:44.78,Default,,0,0,0,,Ал, айтайын.
Dialogue: 0,0:14:44.78,0:14:46.78,Default,,0,0,0,,Киочан мен Асучан менің үйімнің екінші қабатында...
Dialogue: 0,0:14:47.49,0:14:51.45,Default,,0,0,0,,Мен пәтерден кетуіміз керек сияқты.
Dialogue: 0,0:14:51.45,0:14:53.41,Default,,0,0,0,,Барлығы білетін сияқты
Dialogue: 0,0:14:55.33,0:14:59.16,Default,,0,0,0,,Мм... неге бәрің біз туралы айтып жатырсыңдар...?
Dialogue: 0,0:14:59.16,0:15:02.29,Default,,0,0,0,,А-а, жоқ... білесің бе...
Dialogue: 0,0:15:02.42,0:15:05.34,Default,,0,0,0,,Негізінде, Хаяши мырза мұны істеуімді өтінді.
Dialogue: 0,0:15:05.80,0:15:06.76,Default,,0,0,0,,Мен және бұл да
Dialogue: 0,0:15:07.21,0:15:08.47,Default,,0,0,0,,Үй иесіне! ?
Dialogue: 0,0:15:08.47,0:15:09.51,Default,,0,0,0,,Біз де осындамыз.
Dialogue: 0,0:15:09.63,0:15:12.64,Default,,0,0,0,,Неліктен үй иесі бізге баспана берді?
Dialogue: 0,0:15:13.51,0:15:16.10,Default,,0,0,0,,Хаяши мырза, сіз ештеңе айтпайсыз.
Dialogue: 0,0:15:17.18,0:15:20.60,Default,,0,0,0,,Мен сені немерелерім деп санайтыным үшін уайымдаймын.
Dialogue: 0,0:15:21.15,0:15:21.94,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:15:22.31,0:15:25.07,Default,,0,0,0,,Өйткені бұл Эрико-сан мен Мами-чанмен болған.
Dialogue: 0,0:15:25.07,0:15:27.19,Default,,0,0,0,,А, бұл есім...
Dialogue: 0,0:15:27.78,0:15:29.95,Default,,0,0,0,,Эрико... Мама...?
Dialogue: 0,0:15:32.82,0:15:35.58,Default,,0,0,0,,Хаяши мырзаның әйелі мен қызы
Dialogue: 0,0:15:35.87,0:15:38.79,Default,,0,0,0,,Үй иесі мені жалғыз тұрамын деп ойлады.
Dialogue: 0,0:15:39.58,0:15:41.21,Default,,0,0,0,,Баяғыда.
Dialogue: 0,0:15:41.21,0:15:43.25,Default,,0,0,0,,Жазатайым жағдайда қайтыс болды.
Dialogue: 0,0:15:52.84,0:15:55.43,Default,,0,0,0,,40 жыл болды ма?
Dialogue: 0,0:15:55.80,0:15:57.64,Default,,0,0,0,,Бұл қорқынышты апат болды.
Dialogue: 0,0:16:00.98,0:16:03.19,Default,,0,0,0,,Қарсылас үлкен жүк көлігі
Dialogue: 0,0:16:03.69,0:16:06.44,Default,,0,0,0,,Мен бастапқыда аз сөзді адам едім, бірақ
Dialogue: 0,0:16:06.69,0:16:09.53,Default,,0,0,0,,Содан бері күлгеніңді көрмедім.
Dialogue: 0,0:16:10.78,0:16:13.11,Default,,0,0,0,,Отбасының үш мүшесі отырғызған шие гүлдерімен
Dialogue: 0,0:16:13.11,0:16:16.24,Default,,0,0,0,,Сіз бір күні шие гүлдерін көруге барамын дедіңіз...
Dialogue: 0,0:16:16.70,0:16:18.04,Default,,0,0,0,,Шие гүлін көру...
Dialogue: 0,0:16:21.00,0:16:25.79,Default,,0,0,0,,Үй иесі үшін анау шие ағашы өте маңызды болды.
Dialogue: 0,0:16:26.13,0:16:30.59,Default,,0,0,0,,Сонымен, үй иесі мырза, мен шие гүліне қарап отыра бердім.
Dialogue: 0,0:16:31.59,0:16:32.72,Default,,0,0,0,,Олай ма еді?
Dialogue: 0,0:16:33.55,0:16:36.39,Default,,0,0,0,,Онда біз пәтер салуды тоқтатуымыз керек!
Dialogue: 0,0:16:38.22,0:16:39.77,Default,,0,0,0,,Әпке, кеттік!
Dialogue: 0,0:16:40.22,0:16:40.89,Default,,0,0,0,,Ертең
Dialogue: 0,0:16:41.81,0:16:45.15,Default,,0,0,0,,Апай, мына жүкті маған қалдырасыз ба?
Dialogue: 0,0:16:45.15,0:16:46.40,Default,,0,0,0,,Мен оны кейінірек алып кетемін.
Dialogue: 0,0:16:46.40,0:16:48.73,Default,,0,0,0,,Не? Ей, екеуің де...
Dialogue: 0,0:16:49.40,0:16:50.98,Default,,0,0,0,,Кешіріңіз, бәріңіз.
Dialogue: 0,0:16:51.11,0:16:52.57,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:16:53.15,0:16:55.20,Default,,0,0,0,,Ертең пәтерге қайтайық.
Dialogue: 0,0:16:55.32,0:16:55.86,Default,,0,0,0,,Иә
Dialogue: 0,0:17:01.33,0:17:06.46,Default,,0,0,0,,Мен, мен әрқашан ертең екеуміз болады деп ойлайтынмын.
Dialogue: 0,0:17:06.96,0:17:09.17,Default,,0,0,0,,Ертең сенімен бірге болсам
Dialogue: 0,0:17:09.17,0:17:11.67,Default,,0,0,0,,Мен қайда тұратыным маңызды емес деп ойладым.
Dialogue: 0,0:17:12.05,0:17:13.01,Default,,0,0,0,,Үлкен әпке
Dialogue: 0,0:17:13.34,0:17:16.59,Default,,0,0,0,,Бірақ үй иесі мені көшуімді өтінді,
Dialogue: 0,0:17:16.59,0:17:19.51,Default,,0,0,0,,Мен мұны жылжымайтын мүлік агентіне бөлме іздеуге барғанымда байқадым.
Dialogue: 0,0:17:19.81,0:17:22.81,Default,,0,0,0,,Мен бұл пәтерді жақсы көремін.
Dialogue: 0,0:17:23.06,0:17:25.64,Default,,0,0,0,,Оның жойылатынын білгенде, мен оны одан бетер сезіндім.
Dialogue: 0,0:17:26.06,0:17:26.69,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:27.06,0:17:29.61,Default,,0,0,0,,Мен сол пәтерде мәңгі қалғым келеді!
Dialogue: 0,0:17:29.61,0:17:31.23,Default,,0,0,0,,Мен де, әпке.
Dialogue: 0,0:17:44.79,0:17:46.42,Default,,0,0,0,,Құрылыс басталып кетті! ?
Dialogue: 0,0:17:47.00,0:17:48.42,Default,,0,0,0,,Тым кеш болды ма?
Dialogue: 0,0:17:54.01,0:17:55.09,Default,,0,0,0,,Жалға беруші~
Dialogue: 0,0:17:56.47,0:17:58.43,Default,,0,0,0,,Не? Балалар сендер
Dialogue: 0,0:17:59.30,0:18:01.85,Default,,0,0,0,,Менің пәтерімді бұзуды доғар!
Dialogue: 0,0:18:02.10,0:18:04.89,Default,,0,0,0,,Шие гүлдері... Шие ағаштарын кеспеңіз!
Dialogue: 0,0:18:08.10,0:18:08.98,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:18:11.19,0:18:13.28,Default,,0,0,0,,Үй иесі, неге?
Dialogue: 0,0:18:13.57,0:18:18.07,Default,,0,0,0,,Иә? Пәтерді қирату ойым да, жоспарым да жоқ.
Dialogue: 0,0:18:18.07,0:18:18.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:18.99,0:18:20.03,Default,,0,0,0,,Өйткені қазір...
Dialogue: 0,0:18:20.07,0:18:20.95,Default,,0,0,0,,Үлкен әпке
Dialogue: 0,0:18:21.20,0:18:23.41,Default,,0,0,0,,Көрші үй қирап қалған сияқты.
Dialogue: 0,0:18:23.49,0:18:24.04,Default,,0,0,0,,Е! ?
Dialogue: 0,0:18:27.62,0:18:28.54,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:18:28.67,0:18:32.25,Default,,0,0,0,,Біз бұл бұрышта жер сатпадық.
Dialogue: 0,0:18:32.25,0:18:34.34,Default,,0,0,0,,Сонда пәтер осылай қала ма?
Dialogue: 0,0:18:35.17,0:18:38.43,Default,,0,0,0,,Сонда олар бізді неге қуып жіберді?
Dialogue: 0,0:18:40.51,0:18:45.77,Default,,0,0,0,,Дәл көрші құрылыс алаңы бар, көліктер тынымсыз келіп-кетіп жатыр.
Dialogue: 0,0:18:46.22,0:18:47.52,Default,,0,0,0,,Қауіпті болар еді
Dialogue: 0,0:18:49.23,0:18:51.48,Default,,0,0,0,,Бұл қорқынышты апат болды.
Dialogue: 0,0:18:51.65,0:18:54.32,Default,,0,0,0,,Қарсылас үлкен жүк көлігі
Dialogue: 0,0:18:55.40,0:18:58.28,Default,,0,0,0,,Менің ойымша, сіз жаңа бөлме таптыңыз.
Dialogue: 0,0:18:58.40,0:19:00.41,Default,,0,0,0,,Олай болса мен мұнда енді келмеймін.
Dialogue: 0,0:19:01.49,0:19:02.62,Simai's OS,,0,0,0,,Бұл болды
Dialogue: 0,0:19:02.91,0:19:06.83,Simai's OS,,0,0,0,,Үй иесі біз үшін үнемі алаңдайтын.
Dialogue: 0,0:19:07.83,0:19:11.71,Simai's OS,,0,0,0,,Екі жыл бұрын ата-анамыз жоқта бізге бөлме берген едің.
Dialogue: 0,0:19:11.96,0:19:13.42,Simai's OS,,0,0,0,,Бұл тек үй иесі болды.
Dialogue: 0,0:19:14.25,0:19:14.92,Default,,0,0,0,,Ертең
Dialogue: 0,0:19:14.92,0:19:15.88,Default,,0,0,0,,Үлкен әпке
Dialogue: 0,0:19:19.80,0:19:20.93,Default,,0,0,0,,Мен қозғалмаймын!
Dialogue: 0,0:19:21.64,0:19:26.93,Default,,0,0,0,,Біз бұл пәтерді, екі шие гүлін және үй иесін жақсы көреміз!
Dialogue: 0,0:19:29.18,0:19:30.98,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:19:31.35,0:19:33.56,Default,,0,0,0,,Көліктерден сақ болыңыз
Dialogue: 0,0:19:33.73,0:19:36.61,Default,,0,0,0,,Көктем келгенде үй иесімен бірге барамын.
Dialogue: 0,0:19:36.61,0:19:39.15,Default,,0,0,0,,Мен осы шие ағашында шие гүлін тамашалағым келеді.
Dialogue: 0,0:19:40.32,0:19:41.61,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:19:42.45,0:19:44.70,Default,,0,0,0,,Таку...қалағаныңды істе.
Dialogue: 0,0:19:44.91,0:19:46.03,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:49.16,0:19:51.67,Default,,0,0,0,,Әй, апа, қарашы.
Dialogue: 0,0:19:52.87,0:19:56.67,Default,,0,0,0,,Көктем деп қателескен шие гүлінің бұтағына жайылған гүлдер
Dialogue: 0,0:19:57.05,0:20:01.34,Default,,0,0,0,,Желге ұшып кетпес үшін үй иесі маған киім-кешек жасап берді.
Dialogue: 0,0:20:01.93,0:20:03.01,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:20:04.18,0:20:06.51,Simai's OS,,0,0,0,,Сол шие гүлдері біз сияқты.
Dialogue: 0,0:20:07.39,0:20:09.98,Simai's OS,,0,0,0,,Үй иесі бізді қорғағысы келді.
Dialogue: 0,0:20:10.52,0:20:11.52,Simai's OS,,0,0,0,,Дұрыс.
Dialogue: 0,0:20:12.06,0:20:15.69,Simai's OS,,0,0,0,,Үй иесі бізді қорғағанына сенімдімін.
Dialogue: 0,0:20:21.82,0:20:25.07,Default,,0,0,0,,Ертең менде осы айда аздап қосымша ақша болады деп ойлаймын.
Dialogue: 0,0:20:25.41,0:20:27.03,Default,,0,0,0,,Барғыңыз келетін жер бар ма?
Dialogue: 0,0:20:27.41,0:20:27.99,Default,,0,0,0,,Иә
Dialogue: 0,0:20:28.74,0:20:29.49,Default,,0,0,0,,Қайда?
Dialogue: 0,0:20:30.00,0:20:32.87,Default,,0,0,0,,Мен осында әпкеммен болғым келеді.
Dialogue: 0,0:20:33.83,0:20:35.75,Default,,0,0,0,,Бұл пәтер ең жақсы.
Dialogue: 0,0:20:37.50,0:20:39.55,Default,,0,0,0,,Маған да ұнайды.
Dialogue: 0,0:20:42.42,0:20:46.39,Simai's OS,,0,0,0,,Мына шие гүлдері жайнап гүлдейтін көктем әлі алыс.
Dialogue: 0,0:20:46.89,0:20:49.01,Simai's OS,,0,0,0,,Қаһарлы қыс келе жатыр.
Dialogue: 0,0:20:49.47,0:20:51.68,Simai's OS,,0,0,0,,Тіпті ата-анасы жоқтар үшін
Dialogue: 0,0:20:51.68,0:20:54.77,Simai's OS,,0,0,0,,Сол суықтан қорғайтын адамдар бар.
Dialogue: 0,0:20:55.44,0:20:58.52,Simai's OS,,0,0,0,,Суықты түсінетін адам бар...
Dialogue: 0,0:20:59.78,0:21:03.49,Simai's OS,,0,0,0,,Мына пәтердің терезесінен шие гүлдеріне қарап
Dialogue: 0,0:21:03.95,0:21:07.12,Simai's OS,,0,0,0,,Біз ешқашан жалғыз емеспіз
Dialogue: 0,0:21:07.49,0:21:10.66,Simai's OS,,0,0,0,,Соңғы кездері мен осылай ойлай бастадым.
Dialogue: 0,0:21:46.53,0:21:50.66,EDJap,,0,0,0,,Жазықсыз әңгіме
Dialogue: 0,0:21:51.03,0:21:55.25,EDJap,,0,0,0,,Тіпті кенет тоқтап қалса да
Dialogue: 0,0:21:55.50,0:21:59.50,EDJap,,0,0,0,,Осылай жаныңда болу арқылы
Dialogue: 0,0:21:59.71,0:22:03.13,EDJap,,0,0,0,,Өзіңізді қауіпсіз сезініңіз
Dialogue: 0,0:22:04.46,0:22:08.84,EDJap,,0,0,0,,Маңдайыңызды ақырын сипау
Dialogue: 0,0:22:08.84,0:22:12.89,EDJap,,0,0,0,,Самал сияқты
Dialogue: 0,0:22:13.22,0:22:17.02,EDJap,,0,0,0,,Қолды мықтап, қатты ұстағанда
Dialogue: 0,0:22:17.60,0:22:22.15,EDJap,,0,0,0,,Еңіспен жүгірейік
Dialogue: 0,0:22:22.15,0:22:25.94,EDJap,,0,0,0,,Ертең де қызық болатыны сөзсіз.
Dialogue: 0,0:22:26.57,0:22:30.99,EDJap,,0,0,0,,Сапқа тұрайық
Dialogue: 0,0:22:31.12,0:22:35.00,EDJap,,0,0,0,,Тығыз, мықтап, Жел ұстасаң
Dialogue: 0,0:22:35.62,0:22:40.13,EDJap,,0,0,0,,Қолымды жайып, жеткізгім келеді
Dialogue: 0,0:22:40.13,0:22:43.96,EDJap,,0,0,0,,Тығыз, тығыз, ертең және болашақ та
Dialogue: 0,0:22:44.63,0:22:51.26,EDJap,,0,0,0,,Қатар жүрейік, бірге барайық
Dialogue: 0,0:22:57.48,0:22:58.94,Default,,0,0,0,,Мен жеткізгім келетін ойлар
Dialogue: 0,0:22:59.06,0:23:00.52,Default,,0,0,0,,Айтуға болмайтын сезімдер
Dialogue: 0,0:23:00.90,0:23:03.36,Default,,0,0,0,,Қаншалықты мейірімді болса да
Dialogue: 0,0:23:04.02,0:23:05.65,Default,,0,0,0,,Бейшара апалар туралы әңгіме
Dialogue: 0,0:23:05.82,0:23:08.28,Simai's OS,,0,0,0,,Жалғыздық, Гинко және Они-сама күні
