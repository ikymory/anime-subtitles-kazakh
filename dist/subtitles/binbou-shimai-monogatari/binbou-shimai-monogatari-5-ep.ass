Dialogue: 0,0:21:45.74,0:21:50.43,ED - EngLyrics,,0,0,0,,Күнделікті сөйлескенде де
Dialogue: 0,0:21:50.18,0:21:55.01,ED - EngLyrics,,0,0,0,,үзіледі,
Dialogue: 0,0:21:54.76,0:21:59.46,ED - EngLyrics,,0,0,0,,маған керегі - сен жанымда,
Dialogue: 0,0:21:59.21,0:22:02.82,ED - EngLyrics,,0,0,0,,сондықтан мен өзімді қауіпсіз және сау сезінемін.
Dialogue: 0,0:22:03.94,0:22:08.56,ED - EngLyrics,,0,0,0,,Сенің мейірімді жүзің
Dialogue: 0,0:22:08.31,0:22:12.65,ED - EngLyrics,,0,0,0,,жай ғана жел сияқты.
Dialogue: 0,0:22:12.40,0:22:16.89,ED - EngLyrics,,0,0,0,,Біз бір-біріміздің қолымызды мықтап ұстаймыз,
Dialogue: 0,0:22:16.64,0:22:21.85,ED - EngLyrics,,0,0,0,,және сол таулы жолмен бірге жүгіріңіз.
Dialogue: 0,0:22:21.60,0:22:25.88,ED - EngLyrics,,0,0,0,,Ертең тағы бір қуанышты күн болары сөзсіз.
Dialogue: 0,0:22:25.63,0:22:30.84,ED - EngLyrics,,0,0,0,,Ендеше иық тіресіп жүрейік.
Dialogue: 0,0:22:30.59,0:22:34.93,ED - EngLyrics,,0,0,0,,Мен сол ағып жатқан желді мықтап ұстаймын,
Dialogue: 0,0:22:34.68,0:22:39.64,ED - EngLyrics,,0,0,0,,қолымды жайып, саған беру үшін.
Dialogue: 0,0:22:39.39,0:22:43.82,ED - EngLyrics,,0,0,0,,Біз ертең және одан кейінгі күні бір-біріміздің қолымызды қатты ұстаймыз.
Dialogue: 0,0:22:43.57,0:22:50.87,ED - EngLyrics,,0,0,0,,Иық тірестіріп, бірге жүрейік.
