Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.42,0:00:07.32,Simai's OS,,0,0,0,,Менің сүйікті әпкем
Dialogue: 0,0:00:07.98,0:00:10.90,Simai's OS,,0,0,0,,Мектептегі және жұмыстағы қажырлы еңбегіңіз үшін рахмет.
Dialogue: 0,0:00:11.07,0:00:12.53,Simai's OS,,0,0,0,,Сол сезіммен
Dialogue: 0,0:00:13.76,0:00:16.37,Simai's OS,,0,0,0,,Бүгінгі кешкі ас қайнатылған шалғам
Dialogue: 0,0:00:16.37,0:00:19.97,Simai's OS,,0,0,0,,Мен шалғамнан мисо сорпасы мен шалғам салатын дайындаймын.
Dialogue: 0,0:00:21.04,0:00:24.04,Simai's OS,,0,0,0,,Жарайды, тек тепе-теңдікті ойла.
Dialogue: 0,0:00:24.08,0:00:25.92,Simai's OS,,0,0,0,,Кеше де сатылымға шыққан қырыққабат
Dialogue: 0,0:00:25.92,0:00:29.46,Simai's OS,,0,0,0,,Мен үш күн бұрын көп еңбектенген картоптың қалдығын да пайдаланамын.
Dialogue: 0,0:00:30.09,0:00:33.17,Simai's OS,,0,0,0,,Бірақ бүгінгі басты тағам сөзсіз шалғам.
Dialogue: 0,0:00:33.26,0:00:34.05,Simai's OS,,0,0,0,,Бұл...
Dialogue: 0,0:00:35.72,0:00:36.58,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:00:38.65,0:00:40.79,Default,,0,0,0,,Үйге қош келдің, апа, қарашы!
Dialogue: 0,0:00:44.06,0:00:44.59,Default,,0,0,0,,Эй♪
Dialogue: 0,0:00:44.89,0:00:47.31,Default,,0,0,0,,Бір шалғам…10 иен! ?
Dialogue: 0,0:00:51.90,0:00:53.27,Default,,0,0,0,,Кеттік, қазір кеттік!
Dialogue: 0,0:00:54.20,0:00:55.33,Default,,0,0,0,,Ертең асығыңыз!
Dialogue: 0,0:00:55.43,0:00:56.04,Default,,0,0,0,,Иә
Dialogue: 0,0:01:09.54,0:01:13.17,Default,,0,0,0,,Мен туған жылы анам дүниеден өтті.
Dialogue: 0,0:01:13.76,0:01:16.88,Default,,0,0,0,,Әкем құмар ойындар арқылы қарызға батып, қайтыс болды.
Dialogue: 0,0:01:17.68,0:01:20.68,Default,,0,0,0,,Ал біз артта қалдық
Dialogue: 0,0:01:21.93,0:01:25.60,Default,,0,0,0,,40 жыл, едені жоқ 1К тозығы жеткен пәтер
Dialogue: 0,0:01:26.14,0:01:28.02,Default,,0,0,0,,Бұл біздің үй
Dialogue: 0,0:01:28.61,0:01:30.69,Default,,0,0,0,,Бірақ көктем келгенде...
Dialogue: 0,0:01:31.34,0:01:35.97,OP_Jan,,0,0,0,,Өйткені мен өз естеліктерімді қайтара алмаймын
Dialogue: 0,0:01:35.97,0:01:40.66,OP_Jan,,0,0,0,,Бүгін өмір сүріп, ертеңді қолға ал
Dialogue: 0,0:01:50.44,0:01:59.25,OP_Jan,,0,0,0,,Жалғыз болсаң да, жалғыз емессің
Dialogue: 0,0:01:59.86,0:02:08.68,OP_Jan,,0,0,0,,Біз жалғыз емеспіз, біз жалғыз емеспіз
Dialogue: 0,0:02:09.44,0:02:18.17,OP_Jan,,0,0,0,,Әлі аққан жастың алдында
Dialogue: 0,0:02:18.93,0:02:27.82,OP_Jan,,0,0,0,,Қызық, күліп, терең тыныс аламын ба?
Dialogue: 0,0:02:27.82,0:02:32.41,OP_Jan,,0,0,0,,Өйткені мен естеліктерге орала алмаймын
Dialogue: 0,0:02:32.41,0:02:37.05,OP_Jan,,0,0,0,,Бүгін өмір сүріп, ертеңді қолға ал
Dialogue: 0,0:02:37.19,0:02:46.55,OP_Jan,,0,0,0,,Сенің таптырмас асылың жүрегімде
Dialogue: 0,0:02:46.60,0:02:51.86,OP_Jan,,0,0,0,,Желге терең дем алыңыз
Dialogue: 0,0:03:09.03,0:03:12.54,Default,,0,0,0,,Иә, иә, бұл арзан! Бір шалғамға 10 иен! Бұл бар болғаны 10 иен!
Dialogue: 0,0:03:12.67,0:03:14.75,Default,,0,0,0,,Кел, бірінші келген, бірінші қызмет етеді.
Dialogue: 0,0:03:18.63,0:03:20.80,Default,,0,0,0,,Әпке, маған қалдырыңыз
Dialogue: 0,0:03:20.80,0:03:22.38,Default,,0,0,0,,Ертең өтінемін
Dialogue: 0,0:03:26.47,0:03:28.19,Default,,0,0,0,,О, тағы біреу бар.
Dialogue: 0,0:03:35.96,0:03:38.13,Default,,0,0,0,,Ах, соңғы шалғам...
Dialogue: 0,0:03:43.45,0:03:44.49,Default,,0,0,0,,Барайық
Dialogue: 0,0:03:44.66,0:03:45.20,Default,,0,0,0,,Иә
Dialogue: 0,0:03:48.29,0:03:50.58,Default,,0,0,0,,Шалғам сатылып кетті.
Dialogue: 0,0:03:56.75,0:03:58.85,Default,,0,0,0,,Мен сәл кешігіп қалдым.
Dialogue: 0,0:04:01.42,0:04:02.99,Default,,0,0,0,,Ах! Қараңызшы, әпке.
Dialogue: 0,0:04:03.16,0:04:04.79,Default,,0,0,0,,Ертеңгі сатылатын зат – ет.
Dialogue: 0,0:04:04.89,0:04:05.56,Default,,0,0,0,,Ет! ?
Dialogue: 0,0:04:06.99,0:04:08.64,Default,,0,0,0,,Рас, бұл ет!
Dialogue: 0,0:04:08.64,0:04:11.14,Default,,0,0,0,,(Жамбас еті 100 мемлекеттік жазба 88 иен)
Dialogue: 0,0:04:11.31,0:04:14.90,Default,,0,0,0,,100 грамм шошқаның жамбас еті 88 иен!
Dialogue: 0,0:04:14.90,0:04:17.02,Default,,0,0,0,,Содан бері қанша күн өтті...
Dialogue: 0,0:04:23.04,0:04:24.31,Default,,0,0,0,,Ертеңгі күні барымызды салайық
Dialogue: 0,0:04:24.51,0:04:24.84,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:25.38,0:04:28.01,Default,,0,0,0,,Ет ~Ет ертең~
Dialogue: 0,0:04:28.61,0:04:30.95,Default,,0,0,0,,Ет ~Ет ертең~
Dialogue: 0,0:04:40.25,0:04:42.30,Default,,0,0,0,,Асу-чан, сен әлі үйге барасың ба?
Dialogue: 0,0:04:43.46,0:04:43.83,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:44.30,0:04:46.76,Default,,0,0,0,,Шошқаның жамбасы 100г 88 иен!
Dialogue: 0,0:04:46.89,0:04:47.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:47.93,0:04:48.80,Default,,0,0,0,,Олай болса~
Dialogue: 0,0:04:53.52,0:04:56.69,Simai's OS,,0,0,0,,Бұл кешегі бала. Ол көрші сыныпта болатын.
Dialogue: 0,0:05:02.86,0:05:06.16,Simai's OS,,0,0,0,,Мүмкін мен де бүгін сол супермаркетке барармын.
Dialogue: 0,0:05:07.55,0:05:08.45,Simai's OS,,0,0,0,,Асығу керек
Dialogue: 0,0:05:15.39,0:05:17.83,Default,,0,0,0,,Иә, иә, одан да көп. Иә, иә, иә, иә.
Dialogue: 0,0:05:17.83,0:05:19.93,Default,,0,0,0,,100 грамм шошқаның жамбас еті 88 иен тұрады.
Dialogue: 0,0:05:23.80,0:05:25.22,Default,,0,0,0,,О, тағы бір нәрсе.
Dialogue: 0,0:05:29.93,0:05:34.10,Default,,0,0,0,,Қолымды босат, бірінші алдым.
Dialogue: 0,0:05:34.23,0:05:35.31,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:35.56,0:05:37.44,Default,,0,0,0,,Бұл менікі!
Dialogue: 0,0:05:41.72,0:05:44.62,Default,,0,0,0,,Ет ~ Ет ~ Кешкі асқа арналған дәмді ет ~
Dialogue: 0,0:05:44.62,0:05:49.41,Default,,0,0,0,,Ет ~ Ет ~ Ет ~ Ет ~ Ет ~ Ет ~
Dialogue: 0,0:05:51.12,0:05:51.74,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:05:56.64,0:05:57.44,Default,,0,0,0,,Ниндзялар Эдо дәуірінде жойылып кеткен жоқ па?
Dialogue: 0,0:05:58.24,0:05:58.64,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:05:59.34,0:06:02.17,Default,,0,0,0,,Осыны сатып алып үйге бармасам, апам ұрсады.
Dialogue: 0,0:06:04.26,0:06:07.30,Default,,0,0,0,,Сіздің әпкеңіз кеше болған шығар...
Dialogue: 0,0:06:08.30,0:06:09.39,Default,,0,0,0,,Жылама
Dialogue: 0,0:06:12.43,0:06:13.79,Default,,0,0,0,,Мен етті алдым.
Dialogue: 0,0:06:14.47,0:06:16.39,Default,,0,0,0,,Иә, кешіріңіз.
Dialogue: 0,0:06:16.39,0:06:18.98,Default,,0,0,0,,Мен қалғаныма қуаныштымын, хехехехе
Dialogue: 0,0:06:20.44,0:06:22.73,Default,,0,0,0,,Шошқа етінің жамбасы сатылып кетті.
Dialogue: 0,0:06:29.99,0:06:31.44,Default,,0,0,0,,Ол сатылған жоқ.
Dialogue: 0,0:06:31.54,0:06:32.70,Default,,0,0,0,,Мен үшін не істей аласың?
Dialogue: 0,0:06:34.20,0:06:35.54,Simai's OS,,0,0,0,,Тағы да жылайсыз ба?
Dialogue: 0,0:06:35.70,0:06:40.04,Default,,0,0,0,,Өйткені сен... жібермейсің... тез...
Dialogue: 0,0:06:44.00,0:06:46.38,Simai's OS,,0,0,0,,Жоқ, мен шынымен жылап отырмын.
Dialogue: 0,0:06:49.30,0:06:50.43,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:06:50.51,0:06:54.60,Default,,0,0,0,,Мен үйге етті әкелген жоқпын. Әпкем тағы ұрысады.
Dialogue: 0,0:06:54.85,0:06:57.10,Default,,0,0,0,,Жоқ, мен олардың қуылатынына сенімдімін.
Dialogue: 0,0:06:57.31,0:06:59.98,Default,,0,0,0,,Мен енді ешқашан үйге бара алмайтын шығармын.
Dialogue: 0,0:07:00.27,0:07:02.61,Default,,0,0,0,,Жағдайды түсіндірсең, түсінеді.
Dialogue: 0,0:07:02.98,0:07:06.36,Default,,0,0,0,,Менің әпкемді танымағаныңыз үшін солай айта аласыз!
Dialogue: 0,0:07:06.53,0:07:08.65,Default,,0,0,0,,Перфекционист, қатал,
Dialogue: 0,0:07:08.74,0:07:10.20,Default,,0,0,0,,Сіз түсінбейсіз!
Dialogue: 0,0:07:10.53,0:07:13.12,Default,,0,0,0,,Әй, қатал апа екенсің ғой.
Dialogue: 0,0:07:18.96,0:07:21.58,Default,,0,0,0,,Ол менің үлкен әпкемнен мүлдем бөлек.
Dialogue: 0,0:07:21.62,0:07:23.67,Default,,0,0,0,,Дұрыс...дұрыс!
Dialogue: 0,0:07:24.09,0:07:26.75,Default,,0,0,0,,Мен сенің кесіріңнен үйге бара алмаймын.
Dialogue: 0,0:07:26.75,0:07:28.67,Default,,0,0,0,,Үйіңізге тоқтаңыз! !
Dialogue: 0,0:07:30.23,0:07:30.66,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:07:31.50,0:07:33.01,Default,,0,0,0,,Жоқ... у...
Dialogue: 0,0:07:36.13,0:07:37.30,Default,,0,0,0,,Мен келдім!
Dialogue: 0,0:07:38.77,0:07:41.02,Default,,0,0,0,,Қош келдіңіз~ Ертең♥
Dialogue: 0,0:07:44.69,0:07:47.44,Default,,0,0,0,,Әй, кеше шығар...?
Dialogue: 0,0:07:47.86,0:07:51.11,Default,,0,0,0,,Білесің бе, әпке, у...
Dialogue: 0,0:07:52.78,0:07:55.85,Default,,0,0,0,,Мен шошқа етін сатылымнан сатып ала алмаймын...
Dialogue: 0,0:07:55.89,0:07:57.99,Default,,0,0,0,,А, онда бәрі жақсы.
Dialogue: 0,0:07:58.32,0:07:58.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:59.12,0:08:00.79,Default,,0,0,0,,Иә, қараңыз!
Dialogue: 0,0:08:00.96,0:08:03.40,Default,,0,0,0,,Әпке, мына етке не болды?
Dialogue: 0,0:08:04.76,0:08:08.57,Default,,0,0,0,,Бүгінгі жеңілдікті жіберіп алмайсыз! Мен солай ойладым.
Dialogue: 0,0:08:08.97,0:08:10.90,Default,,0,0,0,,Мен де мектептен үйге келе жатқанда тоқтадым.
Dialogue: 0,0:08:11.30,0:08:14.71,Default,,0,0,0,,Мен кешегідей жағдайды болдырмау үшін өз ұстанымымды екі еселеуге тырыстым.
Dialogue: 0,0:08:15.07,0:08:17.97,Default,,0,0,0,,Сіздің әпкеңіз күткендей керемет екен.
Dialogue: 0,0:08:19.02,0:08:20.22,Default,,0,0,0,,Рахмет~
Dialogue: 0,0:08:29.78,0:08:30.61,Default,,0,0,0,,Үлкен әпке
Dialogue: 0,0:08:32.49,0:08:34.06,Default,,0,0,0,,Сұранысыңыз бар ма?
Dialogue: 0,0:08:34.53,0:08:35.36,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:35.69,0:08:39.23,Default,,0,0,0,,Мына балаға ет бергім келеді.
Dialogue: 0,0:08:39.40,0:08:39.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:39.93,0:08:40.63,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:08:41.73,0:08:44.47,Default,,0,0,0,,Бұл баланың қатал әпкесі бар.
Dialogue: 0,0:08:44.70,0:08:48.17,Default,,0,0,0,,Сатылымда бірдеңе сатып алмасаңыз, үйге бара алмайсыз.
Dialogue: 0,0:08:48.97,0:08:52.74,Default,,0,0,0,,Сонымен... сенің апаң маған сатып алған шошқа еті.
Dialogue: 0,0:08:53.21,0:08:55.51,Default,,0,0,0,,Мына балаға беруіңді қалаймын.
Dialogue: 0,0:08:58.15,0:08:58.62,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:08:59.12,0:09:01.82,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Жетеді.
Dialogue: 0,0:09:02.22,0:09:05.56,Default,,0,0,0,,Кенет... ол мұндай адамға бере алмайды.
Dialogue: 0,0:09:10.86,0:09:12.44,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:09:12.44,0:09:13.44,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:09:13.65,0:09:16.36,Default,,0,0,0,,Неліктен оңай берілу керек?
Dialogue: 0,0:09:17.03,0:09:19.44,Default,,0,0,0,,Біздің кешкі ас, солай ма?
Dialogue: 0,0:09:19.64,0:09:23.01,Default,,0,0,0,,Себебі, ертең бер деп едім.
Dialogue: 0,0:09:23.48,0:09:26.55,Default,,0,0,0,,Ертең сен менің мұны істеуімді қалаймын деп қатты ойлайсың.
Dialogue: 0,0:09:26.85,0:09:29.85,Default,,0,0,0,,Бұл маңызды нәрсе болып жатқанын білдіре ме?
Dialogue: 0,0:09:30.15,0:09:32.88,Default,,0,0,0,,Олай болса мен бас тарта алмаймын.
Dialogue: 0,0:09:33.39,0:09:34.75,Default,,0,0,0,,Неге сен де?
Dialogue: 0,0:09:34.85,0:09:37.46,Default,,0,0,0,,Әпкем маған не сатып алды
Dialogue: 0,0:09:37.46,0:09:40.19,Default,,0,0,0,,Біреуге оны біреуге бер деп айту оңай.
Dialogue: 0,0:09:40.49,0:09:43.00,Default,,0,0,0,,Ұрыса не істеу керектігін ойламайсың ба?
Dialogue: 0,0:09:43.30,0:09:45.46,Default,,0,0,0,,Өйткені апам ашуланады.
Dialogue: 0,0:09:45.46,0:09:48.30,Default,,0,0,0,,Мен біреуге қиындық тудыратын нәрсені істегенде.
Dialogue: 0,0:09:48.60,0:09:51.52,Default,,0,0,0,,Ет болмаса да, кешкі асты бірге ішеміз.
Dialogue: 0,0:09:51.65,0:09:55.32,Default,,0,0,0,,Ет дәмді, бірақ ет болуы шарт емес.
Dialogue: 0,0:09:55.32,0:09:59.12,Default,,0,0,0,,Ертең бірге ішетін кешкі ас өте дәмді болады.
Dialogue: 0,0:09:59.49,0:10:00.41,Default,,0,0,0,,Сәлем♥
Dialogue: 0,0:10:00.91,0:10:01.53,Default,,0,0,0,,Сәлем♥
Dialogue: 0,0:10:15.39,0:10:17.16,Default,,0,0,0,,Бұл бізден мүлдем өзгеше.
Dialogue: 0,0:10:18.50,0:10:23.47,Default,,0,0,0,,Олар маған мүлдем сенбейді, өйткені мен сәтсіздікке ұшыраймын...
Dialogue: 0,0:10:27.54,0:10:30.91,Default,,0,0,0,,Менің ойымша, бұл ет бізге қарағанда сізге қажет.
Dialogue: 0,0:10:32.84,0:10:35.48,Default,,0,0,0,,Әпкем мені мақтайды деп үміттенемін.
Dialogue: 0,0:10:40.53,0:10:41.02,Default,,0,0,0,,Иә
Dialogue: 0,0:10:47.23,0:10:49.96,Default,,0,0,0,,Кеш болды, мен сені үйіңе апарамын.
Dialogue: 0,0:10:50.23,0:10:51.50,Default,,0,0,0,,Ах, рахмет
Dialogue: 0,0:10:53.03,0:10:55.77,Simai's OS,,0,0,0,,Бұл жаздың аяғында болды.
Dialogue: 0,0:10:56.37,0:11:00.51,Simai's OS,,0,0,0,,Қыз үшін 100 грамм шошқаның жамбас еті 88 иен тұрады.
Dialogue: 0,0:11:00.87,0:11:02.77,Simai's OS,,0,0,0,,Өзіңізді әпкеңізбен байланыстырыңыз
Dialogue: 0,0:11:02.87,0:11:06.18,Simai's OS,,0,0,0,,Маңызды тілекпен толтырылған шығар деп ойладым.
Dialogue: 0,0:11:06.88,0:11:09.65,Simai's OS,,0,0,0,,Бірақ бұл неліктен мәміле болып табылады?
Dialogue: 0,0:11:10.12,0:11:12.65,Simai's OS,,0,0,0,,Бұл маған және менің әпкем үшін өте біртүрлі болды.
Dialogue: 0,0:11:13.22,0:11:16.32,Simai's OS,,0,0,0,,Сол баланың жетелеуімен мен келдім...
Dialogue: 0,0:11:18.06,0:11:19.42,Default,,0,0,0,,Мен Эчигоя Гинькомын
Dialogue: 0,0:11:19.73,0:11:20.99,Default,,0,0,0,,Бұл менің үйім
Dialogue: 0,0:11:25.03,0:11:25.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:25.87,0:11:26.91,Default,,0,0,0,,Еееееееей! ?
Dialogue: 0,0:11:27.66,0:11:29.66,Simai's OS,,0,0,0,,Бұл Гиньконың үйі болатын.
Dialogue: 0,0:11:51.49,0:11:53.19,Default,,0,0,0,,Бұл бай, солай ма?
Dialogue: 0,0:11:53.19,0:11:54.53,Default,,0,0,0,,Иә, дұрыс...
Dialogue: 0,0:11:54.73,0:11:56.96,Default,,0,0,0,,Сіз қандай арзан заттарды сатып алар едіңіз?
Dialogue: 0,0:11:57.50,0:11:58.30,Default,,0,0,0,,Джон~
Dialogue: 0,0:12:05.37,0:12:06.87,Default,,0,0,0,,Неге...
Dialogue: 0,0:12:07.91,0:12:08.91,Default,,0,0,0,,Бұл күріш.
Dialogue: 0,0:12:10.00,0:12:10.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:15.79,0:12:16.82,Default,,0,0,0,,Крокодил
Dialogue: 0,0:12:17.25,0:12:18.52,Default,,0,0,0,,Крокодилге арналған тағам
Dialogue: 0,0:12:20.75,0:12:21.52,Default,,0,0,0,,Гинко
Dialogue: 0,0:12:28.83,0:12:29.90,Default,,0,0,0,,Әпке
Dialogue: 0,0:12:30.83,0:12:33.17,Default,,0,0,0,,Менің әпкемнің аты Эчигоя Канеко.
Dialogue: 0,0:12:34.37,0:12:35.60,Default,,0,0,0,,Бұл Кио Ямада.
Dialogue: 0,0:12:35.77,0:12:36.50,Default,,0,0,0,,Ертең
Dialogue: 0,0:12:37.24,0:12:38.64,Default,,0,0,0,,Сіз мейірімді сияқтысыз, солай емес пе?
Dialogue: 0,0:12:38.64,0:12:39.27,Default,,0,0,0,,Иә
Dialogue: 0,0:12:39.81,0:12:43.04,Default,,0,0,0,,Әпке, мен сізге арнайы заттар сатып алайын...
Dialogue: 0,0:12:43.04,0:12:44.34,Default,,0,0,0,,Сіз оны сатып ала алмадыңыз, солай ма?
Dialogue: 0,0:12:44.34,0:12:45.01,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:12:45.71,0:12:48.25,Default,,0,0,0,,Джинко уайымдап менің артымнан келе жатты.
Dialogue: 0,0:12:48.75,0:12:50.62,Default,,0,0,0,,Неге өтірік айттың?
Dialogue: 0,0:12:50.98,0:12:53.62,Default,,0,0,0,,Сатып ала алмасаңыз, шынын айту керек емес пе?
Dialogue: 0,0:12:54.09,0:12:55.32,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:00.13,0:13:01.83,Default,,0,0,0,,О, мм...
Dialogue: 0,0:13:03.06,0:13:05.80,Default,,0,0,0,,Әпкем әбігерге түсті.
Dialogue: 0,0:13:05.80,0:13:06.77,Default,,0,0,0,,А, иә
Dialogue: 0,0:13:12.64,0:13:14.10,Default,,0,0,0,,Жақсы ма деп ойлаймын...
Dialogue: 0,0:13:14.39,0:13:16.02,Default,,0,0,0,,Бәрі жақсы болатынына сенімдімін...
Dialogue: 0,0:13:28.07,0:13:32.08,Default,,0,0,0,,Ертең мен келесі қаладағы супермаркетке барамын.
Dialogue: 0,0:13:32.95,0:13:36.86,Default,,0,0,0,,Сәбізге арнайы сатылым… 3 сәбіз… 50 иен…
Dialogue: 0,0:13:44.55,0:13:48.01,Default,,0,0,0,,Ечигоя неге арзан заттарды сатып алады деп ойлаймын.
Dialogue: 0,0:13:48.18,0:13:50.64,Default,,0,0,0,,Байлығың қызық емес пе?
Dialogue: 0,0:13:51.10,0:13:52.52,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:13:52.77,0:13:53.56,Default,,0,0,0,,Ах
Dialogue: 0,0:13:53.68,0:13:55.10,Default,,0,0,0,,Қараңызшы, қарашы, апа.
Dialogue: 0,0:13:55.56,0:13:57.23,Default,,0,0,0,,Не таптың?
Dialogue: 0,0:13:57.73,0:14:03.78,Default,,0,0,0,,Ертең келесі қаладағы супермаркетте 50 иенге үш сәбіз сатылады.
Dialogue: 0,0:14:03.94,0:14:05.19,Default,,0,0,0,,Оңай!
Dialogue: 0,0:14:05.32,0:14:06.32,Default,,0,0,0,,Иә.
Dialogue: 0,0:14:06.40,0:14:08.83,Default,,0,0,0,,Ертең жеңіл маринадталған сәбіз жасайық.
Dialogue: 0,0:14:08.86,0:14:09.76,Default,,0,0,0,,Сәлем, әпке
Dialogue: 0,0:14:09.96,0:14:14.20,Default,,0,0,0,,Дұрыс, жеңіл маринадталған сәбіз күрішпен өте жақсы үйлеседі.
Dialogue: 0,0:14:14.20,0:14:15.83,Default,,0,0,0,,50 иен үшін үш бөлік
Dialogue: 0,0:14:26.26,0:14:28.84,Default,,0,0,0,,Асу-чан, сен бұл күндері үйге ерте қайтасың.
Dialogue: 0,0:14:28.84,0:14:29.22,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:29.97,0:14:30.89,Default,,0,0,0,,Олай болса~
Dialogue: 0,0:14:31.55,0:14:33.68,Default,,0,0,0,,Үш сәбіз 50 иен
Dialogue: 0,0:14:33.81,0:14:34.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:36.68,0:14:40.02,Default,,0,0,0,,Ах! 50 иенге үш сәбіз!
Dialogue: 0,0:14:44.80,0:14:48.10,Default,,0,0,0,,Мен мұнымен келесі қаладағы супермаркетке жете алмаймын деп ойлаймын...
Dialogue: 0,0:14:52.24,0:14:53.24,Default,,0,0,0,,Гинко-чан?
Dialogue: 0,0:14:54.07,0:14:54.91,Default,,0,0,0,,Мен де!
Dialogue: 0,0:15:03.55,0:15:04.35,Default,,0,0,0,,Гинко-чан! ?
Dialogue: 0,0:15:05.08,0:15:06.25,Default,,0,0,0,,Мен жеңілмеймін!
Dialogue: 0,0:15:06.52,0:15:08.39,Default,,0,0,0,,Сіз оны бүгін сатып алуыңыз керек!
Dialogue: 0,0:15:08.69,0:15:10.66,Default,,0,0,0,,Сәтсіздік мүмкін емес!
Dialogue: 0,0:15:15.76,0:15:18.96,Simai's OS,,0,0,0,,Гинко-чан... Неге сонша тырысып жатырсың деп ойлаймын
Dialogue: 0,0:15:57.52,0:15:58.85,Default,,0,0,0,,Кешір...
Dialogue: 0,0:16:01.98,0:16:02.98,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:04.36,0:16:06.65,Default,,0,0,0,,Ааа, кеш болды.
Dialogue: 0,0:16:07.36,0:16:09.55,Default,,0,0,0,,Әй, бәрі де сатылып кетті~
Dialogue: 0,0:16:18.33,0:16:19.54,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:16:21.12,0:16:23.96,Default,,0,0,0,,Ақшаны үнемдеу өте қиын.
Dialogue: 0,0:16:24.04,0:16:25.58,Default,,0,0,0,,Мен-Солай ма?
Dialogue: 0,0:16:25.84,0:16:27.38,Default,,0,0,0,,Иә, өте
Dialogue: 0,0:16:27.92,0:16:33.26,Default,,0,0,0,,Менің ойымша, студенттік кеңес жұмысынан гөрі ақша үнемдеу қиынырақ.
Dialogue: 0,0:16:35.24,0:16:37.81,Default,,0,0,0,,Бұл енді жақсы емес. Олар сені енді менің үйіме кіргізбейді.
Dialogue: 0,0:16:37.81,0:16:38.91,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:16:39.08,0:16:41.48,Default,,0,0,0,,Қайталап көрсең, апаң түсінер, мен сенімдімін.
Dialogue: 0,0:16:41.77,0:16:44.85,Default,,0,0,0,,Айттым ғой, менің әпкем перфекционист!
Dialogue: 0,0:16:44.98,0:16:48.77,Default,,0,0,0,,Бір рет сәтсіздікке ұшырасаңыз, енді ешқашан сәтсіздікке ұшырамауыңыз керек.
Dialogue: 0,0:16:48.98,0:16:49.78,Default,,0,0,0,,Және...
Dialogue: 0,0:16:50.11,0:16:51.03,Default,,0,0,0,,Және?
Dialogue: 0,0:16:55.07,0:16:58.45,Default,,0,0,0,,Кешіріңіз, кешірім сұраймын.
Dialogue: 0,0:16:58.53,0:17:02.29,Default,,0,0,0,,Не? Маған бірдеңе айтпайсың ба?
Dialogue: 0,0:17:02.66,0:17:07.71,Default,,0,0,0,,Иә, оған қазір қоңырау шалу оған көмектеспейді.
Dialogue: 0,0:17:11.68,0:17:12.61,Default,,0,0,0,,Ал мен...
Dialogue: 0,0:17:12.74,0:17:15.98,Default,,0,0,0,,Мен сәтсіздікке ұшырап, апамның көңілін қалдырамын.
Dialogue: 0,0:17:18.68,0:17:23.10,Default,,0,0,0,,Мен оны шақырсам, қайта келіп, оны ренжітіп аламын ба деп қорқамын.
Dialogue: 0,0:17:23.68,0:17:26.40,Default,,0,0,0,,Әпкем мені жек көреді.
Dialogue: 0,0:17:29.57,0:17:31.53,Default,,0,0,0,,Енді мені жек көретініне сенімдімін
Dialogue: 0,0:17:31.65,0:17:33.99,Default,,0,0,0,,Сізге әпкеңіз ұнайды, солай ма?
Dialogue: 0,0:17:33.99,0:17:34.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:35.45,0:17:38.03,Default,,0,0,0,,Мен сені жақсы көремін, сондықтан көңіліңді қалдырғым келмейді.
Dialogue: 0,0:17:40.49,0:17:43.29,Default,,0,0,0,,Мен осындай апаны жақсы көремін...бұл жай ғана...
Dialogue: 0,0:17:44.71,0:17:45.79,Default,,0,0,0,,Сонда бұл сізге ұнамайды ма?
Dialogue: 0,0:17:46.08,0:17:48.54,Default,,0,0,0,,Мен сені жек көрмеймін! Маған ұнамайды...
Dialogue: 0,0:17:49.29,0:17:51.05,Default,,0,0,0,,Бұл әрқашан қиын, бірақ...
Dialogue: 0,0:17:52.05,0:17:54.30,Default,,0,0,0,,Иә, тіпті оңай болса да
Dialogue: 0,0:17:55.51,0:18:00.30,Default,,0,0,0,,Мен суық тигенде, әкем де, шешем де жұмыста болды.
Dialogue: 0,0:18:00.47,0:18:03.43,Default,,0,0,0,,Қолымнан ұстап, түні бойы қасымда болдың.
Dialogue: 0,0:18:04.81,0:18:06.02,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:18:11.44,0:18:12.82,Default,,0,0,0,,Мен бақытты болдым...
Dialogue: 0,0:18:12.98,0:18:15.03,Simai's OS,,0,0,0,,Өйткені, мен апамды жақсы көремін.
Dialogue: 0,0:18:15.49,0:18:16.28,Default,,0,0,0,,Бірақ мұндағы олардың ойып жазғандары ұзақ уақыттан бері ұмыт қалды, және мұнда енді дұғалар айтылмайды.
Dialogue: 0,0:18:16.65,0:18:21.66,Default,,0,0,0,,Мен Гинконы әпкесінің жек көруінен қалай құтылатынын білмеймін.
Dialogue: 0,0:18:21.99,0:18:23.74,Default,,0,0,0,,Үйге барып апаңа айтайық.
Dialogue: 0,0:18:24.79,0:18:26.71,Default,,0,0,0,,Гинко-чан барын салды.
Dialogue: 0,0:18:26.87,0:18:28.96,Default,,0,0,0,,Саған керегі осы, бар болғаны
Dialogue: 0,0:18:29.71,0:18:31.88,Default,,0,0,0,,Иә, бұл сізге қажет.
Dialogue: 0,0:18:32.55,0:18:34.51,Default,,0,0,0,,Апаңның түсінетініне сенімдімін.
Dialogue: 0,0:18:34.84,0:18:37.09,Default,,0,0,0,,Үлкен әпке! ? Неге мұндасың?
Dialogue: 0,0:18:38.68,0:18:40.76,Default,,0,0,0,,Е-хэ, қызық, неге?
Dialogue: 0,0:18:49.77,0:18:52.61,Default,,0,0,0,,Мен саған шындықты айтайын, әпкем.
Dialogue: 0,0:18:52.61,0:18:53.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:53.41,0:18:56.62,Default,,0,0,0,,Мен әпкеме сәбіз сатып ала алмағанымды айтайын.
Dialogue: 0,0:18:59.25,0:19:01.02,Default,,0,0,0,,Мен барынша тырыстым.
Dialogue: 0,0:19:02.41,0:19:04.66,Default,,0,0,0,,Иә, жақсы, бұл жақсы.
Dialogue: 0,0:19:10.75,0:19:11.83,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:19:21.07,0:19:23.51,Default,,0,0,0,,Әпке, кешіріңіз, бірақ мен...
Dialogue: 0,0:19:27.02,0:19:27.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:28.02,0:19:29.94,Default,,0,0,0,,Мен оны сатып ала алмадым...
Dialogue: 0,0:19:30.02,0:19:33.90,Default,,0,0,0,,Мен бар күшімді салдым, бірақ сәбіз сатып ала алмадым.
Dialogue: 0,0:19:33.90,0:19:35.32,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:38.02,0:19:39.26,Default,,0,0,0,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,0:19:39.26,0:19:39.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:40.73,0:19:42.26,Default,,0,0,0,,Өйткені сен қолыңнан келгеннің бәрін істедің
Dialogue: 0,0:19:44.76,0:19:45.66,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:19:45.96,0:19:48.43,Default,,0,0,0,,Маған шындықты айтқаныңызға қуаныштымын.
Dialogue: 0,0:20:06.18,0:20:07.19,Default,,0,0,0,,Күтіңіз~
Dialogue: 0,0:20:12.32,0:20:15.09,Default,,0,0,0,,Әпкеңмен дұрыс сөйлесе білгенің жақсы болды.
Dialogue: 0,0:20:15.33,0:20:17.16,Default,,0,0,0,,Иә, барлығы үшін рахмет...
Dialogue: 0,0:20:17.33,0:20:18.63,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:20:19.10,0:20:21.77,Default,,0,0,0,,Эй, сен маған жақсы бола аласың.
Dialogue: 0,0:20:21.83,0:20:22.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:24.16,0:20:27.12,Default,,0,0,0,,Дос болған дұрыс
Dialogue: 0,0:20:30.14,0:20:31.04,Default,,0,0,0,,Гинко
Dialogue: 0,0:20:31.91,0:20:32.64,Default,,0,0,0,,Иә~
Dialogue: 0,0:20:33.21,0:20:34.45,Default,,0,0,0,,Әпке~
Dialogue: 0,0:20:39.85,0:20:42.55,Default,,0,0,0,,Мен Гинко-чанның сезімін түсінемін.
Dialogue: 0,0:20:42.72,0:20:43.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:44.19,0:20:45.29,Default,,0,0,0,,Менің әпкем...
Dialogue: 0,0:20:46.32,0:20:46.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:46.79,0:20:49.19,Default,,0,0,0,,О, не? Әпкең ше?
Dialogue: 0,0:20:49.79,0:20:51.70,Default,,0,0,0,,Бұл ештеңе емес. Ештеңе етпейді.
Dialogue: 0,0:20:53.87,0:20:55.00,Simai's OS,,0,0,0,,Менің әпкем...
Dialogue: 0,0:20:55.33,0:20:57.24,Simai's OS,,0,0,0,,Мен әпкемді жақсы көремін.
Dialogue: 0,0:20:58.04,0:20:59.67,Simai's OS,,0,0,0,,Сондықтан жеккөрінішті болмаңыз
Dialogue: 0,0:20:59.91,0:21:03.17,Simai's OS,,0,0,0,,Өтірік айтса да, үмітімді ақтауға тырысамын.
Dialogue: 0,0:21:03.88,0:21:05.24,Simai's OS,,0,0,0,,Кез келген әпке
Dialogue: 0,0:21:05.54,0:21:07.35,Simai's OS,,0,0,0,,Бір-бірімізді әлі түсінбесек те
Dialogue: 0,0:21:08.31,0:21:11.92,Simai's OS,,0,0,0,,Мен бейбітшілікте бірге өмір сүре аламыз деп үміттенемін.
Dialogue: 0,0:21:46.32,0:21:50.45,EDJap,,0,0,0,,Жазықсыз әңгіме
Dialogue: 0,0:21:50.83,0:21:55.08,EDJap,,0,0,0,,Тіпті кенет тоқтап қалса да
Dialogue: 0,0:21:55.33,0:21:59.29,EDJap,,0,0,0,,Осылай жаныңда болу арқылы
Dialogue: 0,0:21:59.54,0:22:02.92,EDJap,,0,0,0,,Өзіңізді қауіпсіз сезініңіз
Dialogue: 0,0:22:04.26,0:22:08.68,EDJap,,0,0,0,,Маңдайыңызды ақырын сипау
Dialogue: 0,0:22:08.68,0:22:12.68,EDJap,,0,0,0,,Самал сияқты
Dialogue: 0,0:22:13.06,0:22:16.85,EDJap,,0,0,0,,Қолды мықтап, қатты ұстағанда
Dialogue: 0,0:22:17.44,0:22:21.98,EDJap,,0,0,0,,Еңіспен жүгірейік
Dialogue: 0,0:22:21.98,0:22:25.78,EDJap,,0,0,0,,Ертең де қызық болады.
Dialogue: 0,0:22:26.36,0:22:30.82,EDJap,,0,0,0,,Сапқа тұрайық
Dialogue: 0,0:22:30.95,0:22:34.79,EDJap,,0,0,0,,Тығыз, мықтап, Жел ұстасаң
Dialogue: 0,0:22:35.41,0:22:39.92,EDJap,,0,0,0,,Қолымды жайып, жеткізгім келеді
Dialogue: 0,0:22:39.92,0:22:43.75,EDJap,,0,0,0,,Тығыз, тығыз, ертең және болашақ та
Dialogue: 0,0:22:44.46,0:22:51.05,EDJap,,0,0,0,,Қатар жүрейік, бірге барайық
Dialogue: 0,0:22:58.31,0:22:59.60,Default,,0,0,0,,Ертеңгі сыныпты бақылау
Dialogue: 0,0:22:59.60,0:23:01.61,Default,,0,0,0,,Мен сонда боламын, сондықтан оны асыға күтіңіздер.
Dialogue: 0,0:23:01.69,0:23:03.86,Default,,0,0,0,,Әпке, сізге келудің қажеті жоқ.
Dialogue: 0,0:23:03.86,0:23:04.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:04.86,0:23:06.53,Default,,0,0,0,,Бейшара апалар әңгімесі
Dialogue: 0,0:23:06.53,0:23:09.24,Simai's OS,,0,0,0,,Парфюмерия және ертеңгі сыныпты бақылау күні
Dialogue: 0,0:23:09.45,0:23:10.86,Default,,0,0,0,,Қарап көріңіз
