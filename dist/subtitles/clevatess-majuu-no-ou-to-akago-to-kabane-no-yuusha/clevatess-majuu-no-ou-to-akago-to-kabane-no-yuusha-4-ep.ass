Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.00,0:00:04.00,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:00:04.00,0:00:06.67,Default,,0,0,0,,Аа….
Dialogue: 0,0:00:06.67,0:00:08.67,Default,,0,0,0,,Көмектесіңіз... Ах!
Dialogue: 0,0:00:08.67,0:00:20.02,Default,,0,0,0,,♬～
Dialogue: 0,0:00:20.02,0:00:22.68,Default,,0,0,0,,《Алисия: Мен білемін деп ойладым➨
Dialogue: 0,0:00:22.68,0:00:27.36,Default,,0,0,0,,Тұншығуды жалғастыру соншалықты қиын, ол мені өлтіреді ...
Dialogue: 0,0:00:27.36,0:00:31.03,Default,,0,0,0,,Басым ұйып, көзім айналады.
Dialogue: 0,0:00:31.03,0:00:35.03,Default,,0,0,0,,Бүкіл денем бүгілу үшін маған айғайлайды.
Dialogue: 0,0:00:35.03,0:00:37.70,Default,,0,0,0,,Өлмейтініңді санаңда білсең де➨
Dialogue: 0,0:00:37.70,0:00:41.70,Default,,0,0,0,,Менің денем өздігінен өмір сүру үшін күреседі.
Dialogue: 0,0:00:41.70,0:00:44.37,Default,,0,0,0,,Жоқ, тек шыдамды болыңыз.
Dialogue: 0,0:00:44.37,0:00:48.08,Default,,0,0,0,,Мен қылышты тапқанша...》
Dialogue: 0,0:00:56.39,0:01:01.09,Default,,0,0,0,,《Бұл түбі ме...》
Dialogue: 0,0:01:07.70,0:01:09.67,Default,,0,0,0,,《Алисия: Міне! 》
Dialogue: 0,0:01:12.37,0:01:17.37,Default,,0,0,0,,《Денем ауыр болып тұр. Менің бүкіл денем дірілдеп, қорғасындай сезінемін.
Dialogue: 0,0:01:17.37,0:01:21.04,Default,,0,0,0,,Тыныс алмаса солай бола ма?
Dialogue: 0,0:01:21.04,0:01:26.72,Default,,0,0,0,,Дегенмен, құнды қылыштың иесінің қабілеттерін арттыруға күші бар.
Dialogue: 0,0:01:26.72,0:01:29.38,Default,,0,0,0,,Қылыш ұстағанша...》
Dialogue: 0,0:01:34.39,0:01:36.73,Default,,0,0,0,,《Көздер! ? Ол кетті!
Dialogue: 0,0:01:36.73,0:01:39.06,Default,,0,0,0,,Бұл көлдің түбі емес.
Dialogue: 0,0:01:39.06,0:01:43.63,Default,,0,0,0,,Бұл алып су құбыжығының үстінде! 》
Dialogue: 0,0:03:31.71,0:03:33.71,Default,,0,0,0,,《Қандай үлкен!
Dialogue: 0,0:03:33.71,0:03:38.71,Default,,0,0,0,,Эльба шахтасында осындай бірдеңе жасырынып тұрған!
Dialogue: 0,0:03:38.71,0:03:41.72,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:03:41.72,0:03:44.72,Default,,0,0,0,,Қылыш!
Dialogue: 0,0:03:44.72,0:03:48.72,Default,,0,0,0,,А... Мені сорып жатыр!
Dialogue: 0,0:03:48.72,0:03:50.69,Default,,0,0,0,,Қарғыс атсын…》
Dialogue: 0,0:03:57.73,0:03:59.73,Default,,0,0,0,,《Марго: Алисия➨
Dialogue: 0,0:03:59.73,0:04:03.31,Default,,0,0,0,,Сіз дене күші жағынан ерлерден кемсіз, бірақ➨
Dialogue: 0,0:04:03.31,0:04:08.31,Default,,0,0,0,,Оның қылыштың күшін суырып алатын дарыны басқалардан артық.
Dialogue: 0,0:04:08.31,0:04:12.61,Default,,0,0,0,,Сіз жақсы қаһарман бола аласыз.
Dialogue: 0,0:04:14.65,0:04:16.65,Default,,0,0,0,,С-сәлем… Қалайсың? Өткенде бәрі үшін рахмет…
Dialogue: 0,0:04:20.32,0:04:22.32,Default,,0,0,0,,《Менің ішімді ойып жіберді.
Dialogue: 0,0:04:22.32,0:04:24.66,Default,,0,0,0,,Бірақ мен қылышты алдым.
Dialogue: 0,0:04:24.66,0:04:28.66,Default,,0,0,0,,Даусыңды естіп көрейін, сарқыраманың жарылуы...》
Dialogue: 0,0:04:30.67,0:04:32.67,Default,,0,0,0,,《Мен көрдім!
Dialogue: 0,0:04:32.67,0:04:36.00,Default,,0,0,0,,♬~
Dialogue: 0,0:04:36.00,0:04:40.34,Default,,0,0,0,,Бұл қылышты жіппен кессең, ол судан өткендей екіге бөлінеді➨
Dialogue: 0,0:04:40.34,0:04:43.35,Default,,0,0,0,,Егер сіз оны бетке сермесеңіз, ол қозғаушы күшке айналады.
Dialogue: 0,0:04:43.35,0:04:47.52,Default,,0,0,0,,Бұл балық сияқты.
Dialogue: 0,0:04:47.52,0:04:50.69,Default,,0,0,0,,Сумен жабылған кезде ол күшейе түседі.
Dialogue: 0,0:04:50.69,0:04:52.69,Default,,0,0,0,,Менде осы қылыш болса екен➨
Dialogue: 0,0:04:52.69,0:04:56.02,Default,,0,0,0,,Осы қолайлы ортада аты аңызға айналған батыр ➨ жеңілді
Dialogue: 0,0:04:56.02,0:04:59.03,Default,,0,0,0,,Бұл жігіттің кінәсі болса керек.
Dialogue: 0,0:04:59.03,0:05:04.00,Default,,0,0,0,,Оның көлемі оның осы дүниенің жаратылысы екеніне сенуді қиындатады.
Dialogue: 0,0:05:04.00,0:05:07.34,Default,,0,0,0,,Бұл көне түр болуы керек.
Dialogue: 0,0:05:07.34,0:05:11.01,Default,,0,0,0,,Он мыңдаған жылдар өмір сүреді делінетін алып сиқырлы аң.
Dialogue: 0,0:05:11.01,0:05:15.68,Default,,0,0,0,,Көп жылдар бойы тынығады және сирек пайда болады.
Dialogue: 0,0:05:15.68,0:05:18.68,Default,,0,0,0,,Олай болса, бұл жігіт сиқырлы кенді өндіріп жатқан➨
Dialogue: 0,0:05:18.68,0:05:21.52,Default,,0,0,0,,Бұл кездейсоқ қазылған дегенді білдіре ме?
Dialogue: 0,0:05:21.52,0:05:25.29,Default,,0,0,0,,Мұны білмеген Кодвал шайқаста жеңіліп қалды...》
Dialogue: 0,0:05:27.36,0:05:30.36,Default,,0,0,0,,《Альбенсис мұны да байқады.
Dialogue: 0,0:05:30.36,0:05:33.03,Default,,0,0,0,,Қазынаның құдіретімен нығайса да➨
Dialogue: 0,0:05:33.03,0:05:35.70,Default,,0,0,0,,Дәл қазір мен тұншығып жатырмын.
Dialogue: 0,0:05:35.70,0:05:37.67,Default,,0,0,0,,Біз бұл жерде соғыса алмаймыз! 》
Dialogue: 0,0:05:42.70,0:05:46.04,Default,,0,0,0,,《Ең алдымен...
Dialogue: 0,0:05:46.04,0:05:48.01,Default,,0,0,0,,Тыныс ал! 》
Dialogue: 0,0:05:53.38,0:05:57.05,Default,,0,0,0,,Сонымен... Әй... бұл әйел ғой!
Dialogue: 0,0:05:57.05,0:06:02.02,Default,,0,0,0,,Гохо гохо…. Ей, оның ең қымбат семсері бар!
Dialogue: 0,0:06:04.99,0:06:06.10,Default,,0,0,0,,Уау…. Сатан алғыр! ?
Dialogue: 0,0:06:06.10,0:06:11.33,Default,,0,0,0,,Бұл құбыжық не? ? Сегізаяқ! ?
Dialogue: 0,0:06:11.33,0:06:14.34,Default,,0,0,0,,Сәлем! Ах!
Dialogue: 0,0:06:14.34,0:06:16.34,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:06:16.34,0:06:18.31,Default,,0,0,0,,Ия...
Dialogue: 0,0:06:20.34,0:06:23.68,Default,,0,0,0,,Жоқ, жоқ, жоқ... Уау!
Dialogue: 0,0:06:23.68,0:06:26.68,Default,,0,0,0,,Уау... Уау!
Dialogue: 0,0:06:26.68,0:06:30.35,Default,,0,0,0,,Мен мұндай нәрсеге ештеңе істей алмаймын...
Dialogue: 0,0:06:30.35,0:06:33.36,Default,,0,0,0,,Ах... Қарғыс атсын!
Dialogue: 0,0:06:33.36,0:06:35.69,Default,,0,0,0,,《Қазынаның күшімен қию оңай➨
Dialogue: 0,0:06:35.69,0:06:38.53,Default,,0,0,0,,Тек аяқтың ұшын кесуге болады.
Dialogue: 0,0:06:38.53,0:06:40.53,Default,,0,0,0,,Біріншіден, ежелгі түрлер➨
Dialogue: 0,0:06:40.53,0:06:43.37,Default,,0,0,0,,Бұл батырдың жалғыз қолынан келетін іс емес.
Dialogue: 0,0:06:43.37,0:06:47.04,Default,,0,0,0,,Эй... маған көмектес! Құдай Уау!
Dialogue: 0,0:06:49.37,0:06:53.38,Default,,0,0,0,,Тіпті әлгі Альвенсис алыстан қарап тұр.
Dialogue: 0,0:06:53.38,0:06:55.38,Default,,0,0,0,,Қашайық.
Dialogue: 0,0:06:55.38,0:06:58.38,Default,,0,0,0,,Мені жайбарақаттармен бірге қоспа
Dialogue: 0,0:06:58.38,0:07:00.62,Default,,0,0,0,,Маған көмектесіңізші. Егер кешірім сұрасаң, мен сені кіргіземін!
Dialogue: 0,0:07:00.62,0:07:04.62,Default,,0,0,0,,Кез келген сөзіңізді тыңдаңыз! Қарғаларды тоқтатыңыз!
Dialogue: 0,0:07:04.62,0:07:07.62,Default,,0,0,0,,Өтінемін, сен батырсың! ?
Dialogue: 0,0:07:07.62,0:07:11.29,Default,,0,0,0,,Осындай кезде ғана батырға сенуге тырыспа.
Dialogue: 0,0:07:11.29,0:07:16.63,Default,,0,0,0,,Оның үстіне мен енді қарапайым батыр емеспін.
Dialogue: 0,0:07:16.63,0:07:21.64,Default,,0,0,0,,Мен сол ежелгі түрден әлдеқайда қорқынышты нәрсенің құлымын.
Dialogue: 0,0:07:21.64,0:07:24.64,Default,,0,0,0,,Ал... Күте тұрыңыз!
Dialogue: 0,0:07:24.64,0:07:28.64,Default,,0,0,0,,Ах... Уф.
Dialogue: 0,0:07:28.64,0:07:30.65,Default,,0,0,0,,Аа….
Dialogue: 0,0:07:30.65,0:07:33.65,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:07:39.99,0:07:44.66,Default,,0,0,0,,《Бұл ежелгі түр де, Альбенсис те су құбыжықтары.
Dialogue: 0,0:07:44.66,0:07:48.00,Default,,0,0,0,,Ол ешқашан судан кетпейді.
Dialogue: 0,0:07:48.00,0:07:53.84,Default,,0,0,0,,Басқаша айтқанда, ол ешқашан бұл біліктен шықпайды...
Dialogue: 0,0:07:53.84,0:07:56.67,Default,,0,0,0,,Крен бұйырған қарақшылар тобын талқандау➨
Dialogue: 0,0:07:56.67,0:08:00.64,Default,,0,0,0,,Бұған қол жеткізгеніңізді білу жақсы.
Dialogue: 0,0:08:00.64,0:08:03.31,Default,,0,0,0,,Қарақшылардың көпшілігі өлді➨
Dialogue: 0,0:08:03.31,0:08:07.82,Default,,0,0,0,,Егер мұндай нәрсе оянса, мен мұнда тұра алмас едім.
Dialogue: 0,0:08:07.82,0:08:11.32,Default,,0,0,0,,Бұл жағымсыз дәм қалдырады, бірақ мен қылышты алдым➨
Dialogue: 0,0:08:11.32,0:08:13.32,Default,,0,0,0,,Бұл жақсы》
Dialogue: 0,0:08:13.32,0:08:15.99,Default,,0,0,0,,Сәлем Алисия. Ах...
Dialogue: 0,0:08:15.99,0:08:18.66,Default,,0,0,0,,...
Dialogue: 0,0:08:18.66,0:08:22.33,Default,,0,0,0,,Ол өзінің жын қаны арқылы Унумен сөйлеседі.
Dialogue: 0,0:08:22.33,0:08:24.67,Default,,0,0,0,,Мен оны тікелей көрген жоқпын➨
Dialogue: 0,0:08:24.67,0:08:28.00,Default,,0,0,0,,Сочираның тазартылғанын қан арқылы білдім.
Dialogue: 0,0:08:28.00,0:08:32.01,Default,,0,0,0,,Сіз қиын уақытты бастан өткерген сияқтысыз. Бұл өте маңызды нәрсе емес!
Dialogue: 0,0:08:32.01,0:08:35.34,Default,,0,0,0,,Тұншығып қаласың. Ежелгі тұқымдар шығады ...
Dialogue: 0,0:08:35.34,0:08:38.35,Default,,0,0,0,,Егер сіз тапсаңыз, көмектесіңізші!
Dialogue: 0,0:08:38.35,0:08:42.32,Default,,0,0,0,,Кешіріңіз, бірақ менде бұл мәселеде біраз қиындық болды.
Dialogue: 0,0:08:42.32,0:08:45.69,Default,,0,0,0,,...
Dialogue: 0,0:08:45.69,0:08:49.02,Default,,0,0,0,,Ішінара ол әлі адам кейпінде болғандықтан➨
Dialogue: 0,0:08:49.02,0:08:52.69,Default,,0,0,0,,Мен бірінші рет көрген техникаға қатты алаңдадым.
Dialogue: 0,0:08:52.69,0:08:57.70,Default,,0,0,0,,Сен сиқыр деген нәрсенің бар екенін жасырдың, Алисия.
Dialogue: 0,0:08:57.70,0:09:02.07,Default,,0,0,0,,Бірден Кохқа кел, мен саған ұрысамын.
Dialogue: 0,0:09:03.94,0:09:06.94,Default,,0,0,0,,Ха ха ха ха….
Dialogue: 0,0:09:06.94,0:09:09.94,Default,,0,0,0,,Қарғыс атсын, бұл не бала?!
Dialogue: 0,0:09:09.94,0:09:12.61,Default,,0,0,0,,Бұл не? ?
Dialogue: 0,0:09:12.61,0:09:16.62,Default,,0,0,0,,《Бетті: Грул... Арх! 》
Dialogue: 0,0:09:16.62,0:09:19.62,Default,,0,0,0,,Мен соққы түріндегі сиқыр туралы ешқашан естіген емеспін.
Dialogue: 0,0:09:19.62,0:09:21.62,Default,,0,0,0,,Тегі қандай?
Dialogue: 0,0:09:21.62,0:09:23.63,Default,,0,0,0,,Мен түсінбеймін...
Dialogue: 0,0:09:23.63,0:09:27.63,Default,,0,0,0,,Заманнан артта қалдым дейсің ғой! ?
Dialogue: 0,0:09:27.63,0:09:29.96,Default,,0,0,0,,…
Dialogue: 0,0:09:29.96,0:09:34.30,Default,,0,0,0,,Иә? Уф….
Dialogue: 0,0:09:34.30,0:09:36.60,Default,,0,0,0,,Ки!
Dialogue: 0,0:09:38.64,0:09:40.98,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:09:40.98,0:09:43.65,Default,,0,0,0,,Сәлем, Клен!
Dialogue: 0,0:09:43.65,0:09:48.65,Default,,0,0,0,,Мен саған бірден кел дедім, келдім.
Dialogue: 0,0:09:48.65,0:09:51.99,Default,,0,0,0,,...
Dialogue: 0,0:09:51.99,0:09:55.32,Default,,0,0,0,,Өйткені мен сіздің сөзіңізге қарсы шыға алмаймын!
Dialogue: 0,0:09:55.32,0:09:59.33,Default,,0,0,0,,Дұрысы... Гохо, бұл не түтін?
Dialogue: 0,0:09:59.33,0:10:02.33,Default,,0,0,0,,...
Dialogue: 0,0:10:02.33,0:10:04.33,Default,,0,0,0,,Мен саған оны лақтыруға ешқашан жол бермеймін!
Dialogue: 0,0:10:04.33,0:10:07.67,Default,,0,0,0,,Мен оны алу үшін шынымен өмірімді қатерге тігіп едім!
Dialogue: 0,0:10:07.67,0:10:11.67,Default,,0,0,0,,Хмф, жарайды. Мәселе мынада.
Dialogue: 0,0:10:11.67,0:10:16.34,Default,,0,0,0,,Ол жақтағы ұсақ жануарлар жақсы сияқты.
Dialogue: 0,0:10:16.34,0:10:19.01,Default,,0,0,0,,Сондай-ақ Unumo.
Dialogue: 0,0:10:19.01,0:10:23.35,Default,,0,0,0,,Бұл сиқырлы аңдардың бес сезіміне ғана әсер ететін сияқты.
Dialogue: 0,0:10:23.35,0:10:26.02,Default,,0,0,0,,...
Dialogue: 0,0:10:26.02,0:10:29.36,Default,,0,0,0,,Шынымды айтсам, өзімді қорқынышты сезінемін.
Dialogue: 0,0:10:29.36,0:10:34.03,Default,,0,0,0,,Бұндай бірдеңе бұрынғы қалпына оралып, желге ұшып кетсе, жақсы болмас еді➨
Dialogue: 0,0:10:34.03,0:10:38.70,Default,,0,0,0,,Мен мұны істей алмаймын, себебі ол кішкентай және мен Лунаның бар-жоғын білмеймін.
Dialogue: 0,0:10:38.70,0:10:41.70,Default,,0,0,0,,Иә! ? Луна жоқ... Ол осында болуы керек еді➨
Dialogue: 0,0:10:41.70,0:10:46.04,Default,,0,0,0,,...
Dialogue: 0,0:10:46.04,0:10:50.04,Default,,0,0,0,,Мен қозғалатындай күйде емеспін.
Dialogue: 0,0:10:50.04,0:10:53.05,Default,,0,0,0,,Бұл сіз жалдамақ болған күтуші ме?
Dialogue: 0,0:10:53.05,0:10:56.38,Default,,0,0,0,,...
Dialogue: 0,0:10:56.38,0:10:58.72,Default,,0,0,0,,Бірдеңе істе, Алисия. иә?
Dialogue: 0,0:10:58.72,0:11:02.69,Default,,0,0,0,,Уну бұл сиқыр деген нәрсені біле ме?
Dialogue: 0,0:11:02.69,0:11:07.03,Default,,0,0,0,,Мен білемін, бірақ менде де сиқыршылық қабілеті жоқ.
Dialogue: 0,0:11:07.03,0:11:09.36,Default,,0,0,0,,Не? Қабілеті бар➨
Dialogue: 0,0:11:09.36,0:11:12.20,Default,,0,0,0,,...
Dialogue: 0,0:11:12.20,0:11:15.37,Default,,0,0,0,,Сиқырдың негізі – сиқырлы кен.
Dialogue: 0,0:11:15.37,0:11:19.04,Default,,0,0,0,,➨
Dialogue: 0,0:11:19.04,0:11:22.04,Default,,0,0,0,,Құзыретті адам дұрыс өңдесе➨
Dialogue: 0,0:11:22.04,0:11:26.38,Default,,0,0,0,,…
Dialogue: 0,0:11:26.38,0:11:29.05,Default,,0,0,0,,Мен үшін бұл жай ғана тас.
Dialogue: 0,0:11:29.05,0:11:32.05,Default,,0,0,0,,Бұл шынымен де пайдасыз, Кисама.
Dialogue: 0,0:11:32.05,0:11:35.72,Default,,0,0,0,,➨
Dialogue: 0,0:11:35.72,0:11:37.73,Default,,0,0,0,,Оны пайдалана алатын адам болды.
Dialogue: 0,0:11:37.73,0:11:41.40,Default,,0,0,0,,Әп-сәтте өлтіріп, көрмей қалдым... Ей, соңына дейін тыңда!
Dialogue: 0,0:11:41.40,0:11:45.07,Default,,0,0,0,,➨
Dialogue: 0,0:11:45.07,0:11:47.74,Default,,0,0,0,,Оның өлген болуы мүмкін бе?
Dialogue: 0,0:11:47.74,0:11:50.41,Default,,0,0,0,,Сәлем Кренн.
Dialogue: 0,0:11:50.41,0:11:54.74,Default,,0,0,0,,Луна өлсе ше?
Dialogue: 0,0:11:54.74,0:11:57.75,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:11:57.75,0:12:00.68,Default,,0,0,0,,Жоқ, мен ештеңе істей алмаймын.
Dialogue: 0,0:12:00.68,0:12:03.02,Default,,0,0,0,,Анам шынымен мені жек көрген болар ма екен?
Dialogue: 0,0:12:03.02,0:12:09.02,Default,,0,0,0,,...
Dialogue: 0,0:12:09.02,0:12:11.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:11.03,0:12:13.03,Default,,0,0,0,,《Мен солай ойлаймын.
Dialogue: 0,0:12:13.03,0:12:18.37,Default,,0,0,0,,...
Dialogue: 0,0:12:18.37,0:12:22.70,Default,,0,0,0,,...
Dialogue: 0,0:12:22.70,0:12:25.37,Default,,0,0,0,,…》
Dialogue: 0,0:12:32.38,0:12:34.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:37.39,0:12:40.72,Default,,0,0,0,,Нелден қан кетіп жатыр ма?
Dialogue: 0,0:12:40.72,0:12:43.73,Default,,0,0,0,,Аа, мен оны белгілі бір дәрежеде тоқтаттым.
Dialogue: 0,0:12:43.73,0:12:47.03,Default,,0,0,0,,Оның орнынан қозғалатындай күйі болмаған болуы керек.
Dialogue: 0,0:12:47.03,0:12:49.73,Default,,0,0,0,,Өз бетіңізше жорғалап шықтыңыз ба?
Dialogue: 0,0:12:49.73,0:12:55.07,Default,,0,0,0,,Әлде оны бірдеңе сүйреп апарған шығар...
Dialogue: 0,0:12:55.07,0:12:59.34,Default,,0,0,0,,Олай болса онша алыс кетпеу керек еді. Қуып алайық.
Dialogue: 0,0:13:02.31,0:13:07.98,Default,,0,0,0,,Жақсы жұмыс...
Dialogue: 0,0:13:07.98,0:13:11.65,Default,,0,0,0,,Ей, бұл өлім – шығын!
Dialogue: 0,0:13:11.65,0:13:16.99,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:13:16.99,0:13:19.66,Default,,0,0,0,,Қашанға дейін шыдайсың! Ах...
Dialogue: 0,0:13:19.66,0:13:21.66,Default,,0,0,0,,Мынаны жібер!
Dialogue: 0,0:13:21.66,0:13:24.33,Default,,0,0,0,,Бұл әлемдегі жалғыз➨
Dialogue: 0,0:13:24.33,0:13:28.04,Default,,0,0,0,,Бұл қара аққудың қауырсынынан жасалған плащ!
Dialogue: 0,0:13:30.34,0:13:33.68,Default,,0,0,0,,Шүкір, мен кетпеймін...
Dialogue: 0,0:13:33.68,0:13:37.68,Default,,0,0,0,,Бұл баланы өзіммен бірге алып шығуым керек болса да...
Dialogue: 0,0:13:41.68,0:13:46.09,Default,,0,0,0,,《Луна: мм. Бұл бала бұрынғыдан.
Dialogue: 0,0:13:48.02,0:13:51.69,Default,,0,0,0,,Сіз осындай жерде болдыңыз ба?
Dialogue: 0,0:13:51.69,0:13:54.36,Default,,0,0,0,,Уау! Иә?
Dialogue: 0,0:13:54.36,0:13:58.37,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:13:58.37,0:14:00.67,Default,,0,0,0,,Уау! (жылау)
Dialogue: 0,0:14:00.67,0:14:06.67,Default,,0,0,0,,Бұл жігіттің сиқырға бейімділігі жоғары!
Dialogue: 0,0:14:06.67,0:14:14.02,Default,,0,0,0,,Таза қанды Хайденнің сиқырға бейімділігі Мен бұл жігіт болады деп күтпеген едім...
Dialogue: 0,0:14:14.02,0:14:17.35,Default,,0,0,0,,Хмм...》
Dialogue: 0,0:14:17.35,0:14:20.69,Default,,0,0,0,,Ешқашан жібермеңіз.
Dialogue: 0,0:14:20.69,0:14:23.69,Default,,0,0,0,,Егер бұл орын алса, білегіңізді кесіңіз...
Dialogue: 0,0:14:23.69,0:14:25.69,Default,,0,0,0,,Күте тұрыңыз! Nu! ?
Dialogue: 0,0:14:25.69,0:14:29.70,Default,,0,0,0,,Ол пышақты не істейсің?
Dialogue: 0,0:14:29.70,0:14:31.70,Default,,0,0,0,,Кисама!
Dialogue: 0,0:14:31.70,0:14:36.37,Default,,0,0,0,,Сен мұнда не үшін келдің? ? Дугган мен Тэтчке не болды?
Dialogue: 0,0:14:36.37,0:14:38.71,Default,,0,0,0,,Егер олар...
Dialogue: 0,0:14:38.71,0:14:42.04,Default,,0,0,0,,Мұның бәрі су құбыжықтары туралы.
Dialogue: 0,0:14:42.04,0:14:47.05,Default,,0,0,0,,Мен қорек көзі бола алғанымнан бері мұның соңы жаман болған жоқ деп ойлаймын.
Dialogue: 0,0:14:47.05,0:14:50.72,Default,,0,0,0,,Сіз қалай туылған болсаңыз да, кейін өзін қалай ұстасаңыз да➨
Dialogue: 0,0:14:50.72,0:14:52.69,Default,,0,0,0,,Өлсең, нәр аласың... Қарғыс атсын...
Dialogue: 0,0:14:54.72,0:14:58.73,Default,,0,0,0,,Нелл бар күшін жұмсаған сияқты.
Dialogue: 0,0:14:58.73,0:15:01.30,Default,,0,0,0,,Жақын келме! ?
Dialogue: 0,0:15:01.30,0:15:06.30,Default,,0,0,0,,Бір қадам жақындаған сайын мына баланың бір саусағын кесіп тастаймын!
Dialogue: 0,0:15:06.30,0:15:09.97,Default,,0,0,0,,Қарашы, мен істеймін десем, істеймін!
Dialogue: 0,0:15:09.97,0:15:12.97,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені жасаңыз. Уф... Иә.
Dialogue: 0,0:15:12.97,0:15:15.31,Default,,0,0,0,,Күте тұрыңыз, Кренн. Ол қоқыс!
Dialogue: 0,0:15:15.31,0:15:19.98,Default,,0,0,0,,Сәби болса да сені шын қиямын. Тез арада емделсе жақсы болар еді.
Dialogue: 0,0:15:19.98,0:15:23.32,Default,,0,0,0,,Ауруды өшіре алмайсың, білесің.
Dialogue: 0,0:15:23.32,0:15:25.99,Default,,0,0,0,,Мұны маған қалдырыңыз.
Dialogue: 0,0:15:25.99,0:15:30.59,Default,,0,0,0,,Эй, Броко, міне, мәміле. Сізде келісім бар ма?
Dialogue: 0,0:15:35.66,0:15:39.67,Default,,0,0,0,,Гах... Хайденнің эмблемасы➨
Dialogue: 0,0:15:39.67,0:15:44.67,Default,,0,0,0,,Қып-қызыл жарқырау Мен сене алмадым...
Dialogue: 0,0:15:44.67,0:15:47.01,Default,,0,0,0,,Иә, бұл Хайденнің қазынасы.
Dialogue: 0,0:15:47.01,0:15:50.34,Default,,0,0,0,,Мен оны көлдің түбінен әкелдім.
Dialogue: 0,0:15:50.34,0:15:53.65,Default,,0,0,0,,Менің ойымша, сіз мұны қалағансыз! ?
Dialogue: 0,0:15:55.68,0:15:57.69,Default,,0,0,0,,Ну... Енді алыңыз.
Dialogue: 0,0:15:57.69,0:16:02.99,Default,,0,0,0,,Әйтсе де, екі қолың болмаса, тау жынысынан шыға алмайсың.
Dialogue: 0,0:16:02.99,0:16:06.66,Default,,0,0,0,,Егер сіз Лунаны сабырмен қалдырсаңыз, ол сізге береді.
Dialogue: 0,0:16:06.66,0:16:10.67,Default,,0,0,0,,Қашып кетсең немесе маған шабуыл жасасаң, қалағаныңды істе.
Dialogue: 0,0:16:10.67,0:16:14.67,Default,,0,0,0,,Бірақ егер сіз мінез-құлықтағы ең кішкентай айырмашылықты көрсетсеңіз➨
Dialogue: 0,0:16:14.67,0:16:20.01,Default,,0,0,0,,Мен сол қылышты суырып алып, сені шауып тастаймын.
Dialogue: 0,0:16:20.01,0:16:23.68,Default,,0,0,0,,Қарғыс атсын... Енді мен не істеуім керек? Мені қысқартамыз ба? ?
Dialogue: 0,0:16:23.68,0:16:26.01,Default,,0,0,0,,Сен қылышты аласың ба? ?
Dialogue: 0,0:16:26.01,0:16:28.02,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:16:28.02,0:16:33.02,Default,,0,0,0,,Батыр қазынасынан оңайлықпен бас тартады деп ойламаппын.
Dialogue: 0,0:16:33.02,0:16:35.69,Default,,0,0,0,,Бірақ қазір мен сенімдімін.
Dialogue: 0,0:16:35.69,0:16:40.03,Default,,0,0,0,,Бұл нәресте Хайден патшаның қанынан шыққан.
Dialogue: 0,0:16:40.03,0:16:45.03,Default,,0,0,0,,Қарғыс атсын... Хухьяхьяхья, солай ойлаймын!
Dialogue: 0,0:16:45.03,0:16:49.37,Default,,0,0,0,,Олай болса, бір қазына жетпейді.
Dialogue: 0,0:16:49.37,0:16:51.37,Default,,0,0,0,,Қосымша. не! ?
Dialogue: 0,0:16:51.37,0:16:55.38,Default,,0,0,0,,Мені және мына жігітті өз-өзіне қол жұмсауды тоқтату үшін бізге көбірек адамдар керек.
Dialogue: 0,0:16:55.38,0:16:59.71,Default,,0,0,0,,Маған Кисама мен оның достарының 13 қазынасы қайда екенін айт.
Dialogue: 0,0:16:59.71,0:17:03.65,Default,,0,0,0,,Хехе, мына жігіттің құны соншама!
Dialogue: 0,0:17:03.65,0:17:09.02,Default,,0,0,0,,Қарғыс атсын... Айтшы, Такаға Қылыш.
Dialogue: 0,0:17:10.99,0:17:13.33,Default,,0,0,0,,Ай тауының үлкен үңгірі.
Dialogue: 0,0:17:13.33,0:17:17.00,Default,,0,0,0,,Алқаптың түбінде 13 ағаш бірге құлап жатыр.
Dialogue: 0,0:17:17.00,0:17:19.00,Default,,0,0,0,,Рұқсатсыз барып алыңыз.
Dialogue: 0,0:17:19.00,0:17:22.34,Default,,0,0,0,,Аа, әрине болар едім.
Dialogue: 0,0:17:22.34,0:17:25.01,Default,,0,0,0,,Әрине мен сені жіберемін.
Dialogue: 0,0:17:25.01,0:17:27.01,Default,,0,0,0,,А, не?
Dialogue: 0,0:17:27.01,0:17:30.68,Default,,0,0,0,,Мен бәрібір оны ала алмаймын деп ойладың ба?
Dialogue: 0,0:17:30.68,0:17:33.68,Default,,0,0,0,,Тым тәтті, батыр.
Dialogue: 0,0:17:33.68,0:17:37.02,Default,,0,0,0,,Менің де құпия сиқырым бар.
Dialogue: 0,0:17:37.02,0:17:41.36,Default,,0,0,0,,Корольдік тұқымның сиқырлы қабілеті болғанша...
Dialogue: 0,0:17:41.36,0:17:45.03,Default,,0,0,0,,Уау... Уау!
Dialogue: 0,0:17:45.03,0:17:49.36,Default,,0,0,0,,Менің сиқырым керемет болады! (жылау)
Dialogue: 0,0:17:49.36,0:17:52.03,Default,,0,0,0,,Жоқ! (жылау)
Dialogue: 0,0:17:52.03,0:17:54.37,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:17:54.37,0:17:58.04,Default,,0,0,0,,《Броко: Нуфуфуфу Мен оны көрмеймін, оны көрмеймін. (жылау)
Dialogue: 0,0:17:58.04,0:18:01.94,Default,,0,0,0,,Менің көрінбеу техникам мінсіз.
Dialogue: 0,0:18:01.94,0:18:06.95,Default,,0,0,0,,Кодварудың семсері тұрғаны ұят, бірақ оны алсаң, сенің тұрған жерің ашылады.
Dialogue: 0,0:18:06.95,0:18:11.29,Default,,0,0,0,,Эй, менде 13 бөтелке қалды.
Dialogue: 0,0:18:11.29,0:18:15.29,Default,,0,0,0,,Менде бұл жігіт болғанша, мен жеңілмейтінмін.
Dialogue: 0,0:18:15.29,0:18:19.29,Default,,0,0,0,,Тіпті мені мазақ еткен Одаққа қарасам да... Ой! ? 》
Dialogue: 0,0:18:19.29,0:18:23.30,Default,,0,0,0,,Уау! Ана жерде! ?
Dialogue: 0,0:18:23.30,0:18:26.97,Default,,0,0,0,,Уф... Неге?
Dialogue: 0,0:18:26.97,0:18:30.97,Default,,0,0,0,,Мен сені көргеніме сене алмадым...
Dialogue: 0,0:18:30.97,0:18:32.97,Default,,0,0,0,,Жоқ, мүлде емес.
Dialogue: 0,0:18:32.97,0:18:35.64,Default,,0,0,0,,Бірақ дыбыс толығымен естіледі.
Dialogue: 0,0:18:35.64,0:18:38.98,Default,,0,0,0,,Әрине, ол жерде Луна жылап жатқан шығар.
Dialogue: 0,0:18:38.98,0:18:43.32,Default,,0,0,0,,Құлағыңыз қулыққа әуестеніп қалған сияқты➨
Dialogue: 0,0:18:43.32,0:18:45.32,Default,,0,0,0,,Тіпті құшағында жылаған сәбидің даусы➨
Dialogue: 0,0:18:45.32,0:18:47.32,Default,,0,0,0,,Бұл резонанс тудырмаған сияқты.
Dialogue: 0,0:18:47.32,0:18:49.32,Default,,0,0,0,,Хмм…. (жылау)
Dialogue: 0,0:18:49.32,0:18:52.66,Default,,0,0,0,,Егер сіз ұнтақты тазаласаңыз, оны көре аласыз.
Dialogue: 0,0:18:52.66,0:18:56.33,Default,,0,0,0,,Мына ұнтақты щеткамен сүртпейік. (жылау)
Dialogue: 0,0:18:56.33,0:18:59.33,Default,,0,0,0,,Тіпті ➨ болса да
Dialogue: 0,0:18:59.33,0:19:04.97,Default,,0,0,0,,Дәл сол фланельдің арқасында дер кезінде әрең жеттім.
Dialogue: 0,0:19:04.97,0:19:09.64,Default,,0,0,0,,Ол жеңілдеп қалған сияқты.
Dialogue: 0,0:19:09.64,0:19:13.65,Default,,0,0,0,,Ол әлі де дем алып жатыр, солай ма? Сіз оған көмектесе алмайсыз ба?
Dialogue: 0,0:19:13.65,0:19:17.32,Default,,0,0,0,,Сіз бір уақытта бірнеше жын қанын басқара алмайсыз.
Dialogue: 0,0:19:17.32,0:19:19.99,Default,,0,0,0,,Сонымен қатар, физикалық тапшылық та үлкен.
Dialogue: 0,0:19:19.99,0:19:25.66,Default,,0,0,0,,Оны емдеу үшін оны басқа нәрсемен толықтыру қажет болуы мүмкін.
Dialogue: 0,0:19:25.66,0:19:28.00,Default,,0,0,0,,Көмектесу үшін осындай дәрежеде барған жөн➨
Dialogue: 0,0:19:28.00,0:19:30.66,Default,,0,0,0,,Мен оның осы тұқымдасқа жататынын білмеймін.
Dialogue: 0,0:19:30.66,0:19:34.00,Default,,0,0,0,,Сізге көмектесу керек! Қанша жыртық болса да➨
Dialogue: 0,0:19:34.00,0:19:37.00,Default,,0,0,0,,Ол Лунаны соңына дейін қорғауға тырысты.
Dialogue: 0,0:19:37.00,0:19:39.34,Default,,0,0,0,,Мұны кез келген адам жасай алмайды.
Dialogue: 0,0:19:39.34,0:19:44.68,Default,,0,0,0,,Егер мен Лунаның анасы болсам, оны осындай біреуге қалдырғым келеді.
Dialogue: 0,0:19:44.68,0:19:48.35,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:19:48.35,0:19:51.69,Default,,0,0,0,,Бірақ қалпына келтіру үшін сиқырлы қан қажет.
Dialogue: 0,0:19:51.69,0:19:56.02,Default,,0,0,0,,Мен Неллді емдегенімде сен өлесің.
Dialogue: 0,0:19:56.02,0:19:59.03,Default,,0,0,0,,Маған бәрібір. Мен батырмын.
Dialogue: 0,0:19:59.03,0:20:04.70,Default,,0,0,0,,Мен қорғауға тиісті адамдардың болашағы мен үміті үшін өз өмірімді құрбан ету - менің міндетім.
Dialogue: 0,0:20:04.70,0:20:07.37,Default,,0,0,0,,Әкем де солай айтқан.
Dialogue: 0,0:20:07.37,0:20:10.70,Default,,0,0,0,,Оның үстіне мен бәрібір бір рет өлдім.
Dialogue: 0,0:20:10.70,0:20:12.71,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:20:12.71,0:20:14.68,Default,,0,0,0,,Уф….
Dialogue: 0,0:20:32.39,0:20:34.40,Default,,0,0,0,,Қайта?
Dialogue: 0,0:20:34.40,0:20:39.73,Default,,0,0,0,,Иә? Неге, мен әлі тірімін...
Dialogue: 0,0:20:39.73,0:20:43.74,Default,,0,0,0,,Мен?
Dialogue: 0,0:20:43.74,0:20:45.74,Default,,0,0,0,,Ши?
Dialogue: 0,0:20:45.74,0:20:48.41,Default,,0,0,0,,Сіз ояусыз. Ах...
Dialogue: 0,0:20:48.41,0:20:51.08,Default,,0,0,0,,А, сен...
Dialogue: 0,0:20:51.08,0:20:56.08,Default,,0,0,0,,Бұл аздап мәжбүрлі синтез болды, бірақ ол нәтиже берген сияқты.
Dialogue: 0,0:20:56.08,0:21:00.32,Default,,0,0,0,,Уау, мені құтқардың ба?
Dialogue: 0,0:21:00.32,0:21:03.66,Default,,0,0,0,,Рахмет айтқың келсе, сол жерде батырға айт.
Dialogue: 0,0:21:03.66,0:21:07.33,Default,,0,0,0,,Соңында оны құтқару туралы шешімді ол қабылдады.
Dialogue: 0,0:21:07.33,0:21:10.33,Default,,0,0,0,,Тозған күйден шығуына байланысты➨
Dialogue: 0,0:21:10.33,0:21:15.00,Default,,0,0,0,,Біраз уақыт керек, бірақ мен жақында оянамын.
Dialogue: 0,0:21:15.00,0:21:20.01,Default,,0,0,0,,Нәсіліне қарағанда, ол өте күшті жігіт.
Dialogue: 0,0:21:20.01,0:21:23.01,Default,,0,0,0,,Құрметті батыр...
Dialogue: 0,0:21:23.01,0:21:25.68,Default,,0,0,0,,Гах... Ах...
Dialogue: 0,0:21:25.68,0:21:28.68,Default,,0,0,0,,Иә, Батыр-сама?
Dialogue: 0,0:21:28.68,0:21:30.68,Default,,0,0,0,,Пуха~!
Dialogue: 0,0:21:30.68,0:21:34.69,Default,,0,0,0,,Ах... Қылыш Қылыш!
Dialogue: 0,0:21:34.69,0:21:39.03,Default,,0,0,0,,Ах! Ахах менің қылышым хехехе...
Dialogue: 0,0:21:39.03,0:21:41.36,Default,,0,0,0,,Жақсы…. Пу хахаха...
Dialogue: 0,0:21:41.36,0:21:43.36,Default,,0,0,0,,Енді... Иә?
Dialogue: 0,0:21:43.36,0:21:46.03,Default,,0,0,0,,Олай болса, мен сенен бірден жақсылық сұрайын, Неру.
Dialogue: 0,0:21:46.03,0:21:49.70,Default,,0,0,0,,Ах, аха….
Dialogue: 0,0:21:49.70,0:21:51.71,Default,,0,0,0,,А, Неру?
Dialogue: 0,0:21:51.71,0:21:54.38,Default,,0,0,0,,Сен қайта тудың.
Dialogue: 0,0:21:54.38,0:21:57.04,Default,,0,0,0,,Бұдан былай сенің атың Нерул.
Dialogue: 0,0:21:57.04,0:21:59.35,Default,,0,0,0,,Бізбен бірге келмейсіз бе?
Dialogue: 0,0:22:02.02,0:22:07.29,Default,,0,0,0,,Иә, мен осындай болсам ғой.
Dialogue: 0,0:22:08.79,0:22:14.79,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory