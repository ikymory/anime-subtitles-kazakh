Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:52.51,0:00:55.52,Default,,0,0,0,,...
Dialogue: 0,0:00:55.52,0:00:58.52,Default,,0,0,0,,...
Dialogue: 0,0:00:58.52,0:01:00.92,Default,,0,0,0,,～
Dialogue: 0,0:01:09.87,0:01:11.87,Default,,0,0,0,,Әрине, оны есінен тандырып тастаған дұрыс қой?
Dialogue: 0,0:01:18.87,0:01:21.18,Default,,0,0,0,,Гао!
Dialogue: 0,0:01:26.88,0:01:31.89,Default,,0,0,0,,Дүние хаостан туған болса➨
Dialogue: 0,0:01:31.89,0:01:34.82,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:01:34.82,0:01:38.13,Default,,0,0,0,,Бұл кімнің сөзі?
Dialogue: 0,0:01:43.50,0:01:46.17,Default,,0,0,0,,...
Dialogue: 0,0:01:46.17,0:01:51.17,Default,,0,0,0,,Оның жалықтырғанына сенімдімін.
Dialogue: 0,0:01:53.84,0:01:55.84,Default,,0,0,0,,Қарғыс атсын... Уау!
Dialogue: 0,0:01:55.84,0:01:58.45,Default,,0,0,0,,Дүние сұр түсті.
Dialogue: 0,0:02:02.18,0:02:04.52,Default,,0,0,0,,…  ➨
Dialogue: 0,0:02:04.52,0:02:08.52,Default,,0,0,0,,Сіз маймылдың баласын осылай алып жүрсіз бе?
Dialogue: 0,0:02:12.86,0:02:16.20,Default,,0,0,0,,Уф….
Dialogue: 0,0:02:16.20,0:02:18.20,Default,,0,0,0,,…
Dialogue: 0,0:02:18.20,0:02:21.20,Default,,0,0,0,,Мен адамдарды жоюды қойдым.
Dialogue: 0,0:02:21.20,0:02:24.91,Default,,0,0,0,,Маған `` Тоа кітабы '' немесе нағыз адам нәсіліне мән бермейді.
Dialogue: 0,0:02:26.88,0:02:29.88,Default,,0,0,0,,《Крен: Мен ай тауына қайтамын》
Dialogue: 0,0:02:29.88,0:02:32.55,Default,,0,0,0,,…
Dialogue: 0,0:02:32.55,0:02:34.82,Default,,0,0,0,,(Лунаның жылағаны)
Dialogue: 0,0:02:34.82,0:02:37.82,Default,,0,0,0,,…
Dialogue: 0,0:02:37.82,0:02:39.82,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:02:39.82,0:02:47.83,Default,,0,0,0,,(Лунаның жылағаны)
Dialogue: 0,0:02:47.83,0:02:50.50,Default,,0,0,0,,《：…》
Dialogue: 0,0:02:50.50,0:02:52.83,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:02:52.83,0:02:56.17,Default,,0,0,0,,...
Dialogue: 0,0:02:56.17,0:02:59.51,Default,,0,0,0,,...
Dialogue: 0,0:02:59.51,0:03:04.85,Default,,0,0,0,,Не, сен әлі тірісің, қызметші?
Dialogue: 0,0:03:04.85,0:03:08.85,Default,,0,0,0,,Бұл туралы ақымақ болмаңыз!
Dialogue: 0,0:03:08.85,0:03:12.52,Default,,0,0,0,,《Крен: Мен Дрелл мен Вордайнның мақсатын түсінемін.
Dialogue: 0,0:03:12.52,0:03:15.52,Default,,0,0,0,,Ашығын айтқанда, оны тоқтатуға негіз жоқ.
Dialogue: 0,0:03:15.52,0:03:18.86,Default,,0,0,0,,Батырдың ізін өшіріп жүрсе➨
Dialogue: 0,0:03:18.86,0:03:20.86,Default,,0,0,0,,...
Dialogue: 0,0:03:20.86,0:03:26.20,Default,,0,0,0,,Процесс барысында адамдар әлемімен не болатыны мені қызықтырмайды.
Dialogue: 0,0:03:26.20,0:03:28.20,Default,,0,0,0,,…》
Dialogue: 0,0:03:28.20,0:03:32.37,Default,,0,0,0,,...
Dialogue: 0,0:03:32.37,0:03:35.14,Default,,0,0,0,,《Алисия: Лунаның көзін көрдің бе? ?
Dialogue: 0,0:03:35.14,0:03:38.15,Default,,0,0,0,,》
Dialogue: 0,0:03:40.82,0:03:45.15,Default,,0,0,0,,Нағыз адамшылықтың қандай екенін білмеймін!
Dialogue: 0,0:03:45.15,0:03:48.16,Default,,0,0,0,,Күте тұрыңыз, батыр! Қауіпті... Уау!
Dialogue: 0,0:03:48.16,0:03:50.83,Default,,0,0,0,,➨
Dialogue: 0,0:03:50.83,0:03:53.83,Default,,0,0,0,,Оларды ескі аңыздар билеуге мәжбүрлейді➨
Dialogue: 0,0:03:53.83,0:03:57.17,Default,,0,0,0,,…
Dialogue: 0,0:03:57.17,0:03:59.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:59.84,0:04:02.50,Default,,0,0,0,,➨
Dialogue: 0,0:04:02.50,0:04:04.51,Default,,0,0,0,,➨
Dialogue: 0,0:04:04.51,0:04:09.34,Default,,0,0,0,,Төменгі түр деуге негіз жоқ!
Dialogue: 0,0:04:09.34,0:04:11.35,Default,,0,0,0,,(Лунаның жылағаны)
Dialogue: 0,0:04:11.35,0:04:14.52,Default,,0,0,0,,《Алисия: Менің көзіме қара, Крен!
Dialogue: 0,0:04:14.52,0:04:16.85,Default,,0,0,0,,Лунаның көздері қандай түсті? ? 》
Dialogue: 0,0:04:16.85,0:04:26.86,Default,,0,0,0,,(Лунаның жылағаны)
Dialogue: 0,0:04:26.86,0:04:30.87,Default,,0,0,0,,《Алисия: Бұл төменгі түрдің көздері ме? ? 》
Dialogue: 0,0:04:30.87,0:04:48.82,Default,,0,0,0,,(Лунаның жылағаны)
Dialogue: 0,0:04:48.82,0:04:50.82,Default,,0,0,0,,《Алисия: Мына көздерге қара➨
Dialogue: 0,0:04:50.82,0:04:54.42,Default,,0,0,0,,Менің ойымша, сіз оның өсуін көргіңіз келді! ? 》
Dialogue: 0,0:04:57.49,0:05:07.50,Default,,0,0,0,,(Лунаның жылағаны)
Dialogue: 0,0:05:07.50,0:05:13.51,Default,,0,0,0,,Қазынасы жоқ Қисама менімен қалай соғысады?
Dialogue: 0,0:05:15.51,0:05:17.51,Default,,0,0,0,,Жауап, Крен!
Dialogue: 0,0:05:17.51,0:05:19.51,Default,,0,0,0,,Оның түсі қандай? ?
Dialogue: 0,0:05:34.80,0:05:36.80,Default,,0,0,0,,Ашық күлгін.
Dialogue: 0,0:05:38.80,0:05:41.64,Default,,0,0,0,,Міне бітті, қылышшының қызы!
Dialogue: 0,0:05:41.64,0:05:44.47,Default,,0,0,0,,Батырға еліктеу!
Dialogue: 0,0:05:44.47,0:05:46.88,Default,,0,0,0,,Арх! не! ?
Dialogue: 0,0:05:49.48,0:05:51.48,Default,,0,0,0,,Батыр!
Dialogue: 0,0:05:55.48,0:05:57.82,Default,,0,0,0,,Имитациялық өнімдер жақсы.
Dialogue: 0,0:05:57.82,0:06:00.42,Default,,0,0,0,,Шынайы болмау керек!
Dialogue: 0,0:06:04.49,0:06:07.66,Default,,0,0,0,,Уау! Сонда да мен ➨
Dialogue: 0,0:06:07.66,0:06:10.83,Default,,0,0,0,,Ол батыр!
Dialogue: 0,0:06:10.83,0:06:12.83,Default,,0,0,0,,Хмм….
Dialogue: 0,0:06:18.84,0:06:20.84,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:06:23.18,0:06:26.51,Default,,0,0,0,,А... Мен де жынның қаны деп ойламаппын! ?
Dialogue: 0,0:06:26.51,0:06:28.52,Default,,0,0,0,,Хмф….
Dialogue: 0,0:06:28.52,0:06:32.19,Default,,0,0,0,,Шорю Кай!
Dialogue: 0,0:06:32.19,0:06:34.89,Default,,0,0,0,,Сарқырамаға көтеріліңіз!
Dialogue: 0,0:06:47.14,0:06:49.44,Default,,0,0,0,,Батыр! Батыр!
Dialogue: 0,0:06:54.14,0:06:56.14,Default,,0,0,0,,Мен жасадым! ?
Dialogue: 0,0:06:56.14,0:07:00.48,Default,,0,0,0,,Ах! Жоқ, ол таяз...
Dialogue: 0,0:07:00.48,0:07:02.88,Default,,0,0,0,,Қылышпен жабылды!
Dialogue: 0,0:07:07.82,0:07:10.16,Default,,0,0,0,,Гах! Куха….
Dialogue: 0,0:07:10.16,0:07:12.49,Default,,0,0,0,,Батыр! Неге! ?
Dialogue: 0,0:07:12.49,0:07:15.50,Default,,0,0,0,,Оны кескен Алисия болса да...
Dialogue: 0,0:07:15.50,0:07:18.83,Default,,0,0,0,,Батырдың соққысына дейін екі рет шауылдым.
Dialogue: 0,0:07:18.83,0:07:23.51,Default,,0,0,0,,Бұл жалған батырдың шегі.
Dialogue: 0,0:07:23.51,0:07:28.91,Default,,0,0,0,,Ештеңеге үміт арта алмайсың, ештеңеге де қол жеткізе алмайсың.
Dialogue: 0,0:07:30.85,0:07:32.78,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:07:32.78,0:07:35.45,Default,,0,0,0,,Иә? Тіпті ештеңе орындалмаса да➨
Dialogue: 0,0:07:35.45,0:07:37.79,Default,,0,0,0,,Ештеңеге үміт артуға болмайды➨
Dialogue: 0,0:07:37.79,0:07:40.79,Default,,0,0,0,,Өйткені сіз өз шектеулеріңізді орнатасыз.
Dialogue: 0,0:07:40.79,0:07:44.79,Default,,0,0,0,,Сондықтан батыр бола алмадың.
Dialogue: 0,0:07:44.79,0:07:48.80,Default,,0,0,0,,Біліктіліктің жоқтығы немесе дұрыс емес дәстүр➨
Dialogue: 0,0:07:48.80,0:07:51.13,Default,,0,0,0,,Сақтауды жалғастыра бермеңіз!
Dialogue: 0,0:07:51.13,0:07:53.47,Default,,0,0,0,,Ауыз ешқашан азаймайды!
Dialogue: 0,0:07:53.47,0:07:56.81,Default,,0,0,0,,(Дарио) Бұл нағыз апат. Бұл жігіт те сол жерде-ақ қаза тапты. ➡
Dialogue: 0,0:07:56.81,0:07:58.81,Default,,0,0,0,,Орындап болған соң айтамын.
Dialogue: 0,0:07:58.81,0:08:02.81,Default,,0,0,0,,Менің мақсатым – әу бастан сол қылыш!
Dialogue: 0,0:08:02.81,0:08:06.15,Default,,0,0,0,,♬~
Dialogue: 0,0:08:06.15,0:08:08.15,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:08.15,0:08:11.49,Default,,0,0,0,,Қазына! ? Мүмкін емес!
Dialogue: 0,0:08:11.49,0:08:17.16,Default,,0,0,0,,Бұл мүмкін емес, бірақ мен оны тыңдай бердім.
Dialogue: 0,0:08:17.16,0:08:20.50,Default,,0,0,0,,Қылыш бір-біріне тигенде біртүрлі дыбыс...
Dialogue: 0,0:08:20.50,0:08:23.50,Default,,0,0,0,,Сол қылыштан әлсіз айғай естілді.
Dialogue: 0,0:08:23.50,0:08:25.50,Default,,0,0,0,,Біртүрлі шу?
Dialogue: 0,0:08:25.50,0:08:27.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:29.50,0:08:33.78,Default,,0,0,0,,Патшаның балғасы дұрыс болды.
Dialogue: 0,0:08:33.78,0:08:38.45,Default,,0,0,0,,Мен бар күшіммен соқтым...
Dialogue: 0,0:08:38.45,0:08:40.45,Default,,0,0,0,,Батыр!
Dialogue: 0,0:08:42.45,0:08:44.45,Default,,0,0,0,,Е... Уф...
Dialogue: 0,0:08:47.79,0:08:51.46,Default,,0,0,0,,Енді не болады деп ойлаймын...
Dialogue: 0,0:08:51.46,0:08:55.13,Default,,0,0,0,,Оның бүкіл денесі жын қанына толы.
Dialogue: 0,0:08:55.13,0:08:59.13,Default,,0,0,0,,Жын қанының нағыз иесі басқа біреу. иә?
Dialogue: 0,0:08:59.13,0:09:04.47,Default,,0,0,0,,Иесі әлсіреген, қазынасы бұзылған➨
Dialogue: 0,0:09:04.47,0:09:06.47,Default,,0,0,0,,Оған қалай баға берер едіңіз?
Dialogue: 0,0:09:06.47,0:09:08.48,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:09:08.48,0:09:10.88,Default,,0,0,0,,Гах! Уф….
Dialogue: 0,0:09:13.15,0:09:15.15,Default,,0,0,0,,Гаха!
Dialogue: 0,0:09:15.15,0:09:17.49,Default,,0,0,0,,Уф... уф!
Dialogue: 0,0:09:17.49,0:09:19.82,Default,,0,0,0,,Уаааааааааа....
Dialogue: 0,0:09:19.82,0:09:23.49,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:23.49,0:09:26.16,Default,,0,0,0,,Қандай сұмдық...
Dialogue: 0,0:09:26.16,0:09:32.50,Default,,0,0,0,,Қараңдаршы, жын-шайтанның патшасын кесіп тастау оңай.
Dialogue: 0,0:09:32.50,0:09:35.44,Default,,0,0,0,,Мен оны білдім.
Dialogue: 0,0:09:35.44,0:09:39.77,Default,,0,0,0,,Жоқ... жоқ, барма!
Dialogue: 0,0:09:39.77,0:09:43.45,Default,,0,0,0,,Мен ештеңеге қол жеткізген жоқпын!
Dialogue: 0,0:09:43.45,0:09:45.45,Default,,0,0,0,,Ештеңе!
Dialogue: 0,0:09:54.12,0:09:58.79,Default,,0,0,0,,Сенің бұлай болғаныңды көргім келмеді...
Dialogue: 0,0:09:58.79,0:10:05.40,Default,,0,0,0,,Сонымен мен...
Dialogue: 0,0:10:07.47,0:10:12.81,Default,,0,0,0,,⸨Марго: Кеттік, Сенпай⸩
Dialogue: 0,0:10:12.81,0:10:17.48,Default,,0,0,0,,Барма, Марго! Барма!
Dialogue: 0,0:10:17.48,0:10:21.82,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:10:21.82,0:10:26.12,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:10:50.51,0:10:54.18,Default,,0,0,0,,Баурат сиқыршысының денесіне имплантацияланған кристал...
Dialogue: 0,0:10:54.18,0:10:56.18,Default,,0,0,0,,Бұл тоғыз...
Dialogue: 0,0:10:56.18,0:10:59.49,Default,,0,0,0,,Бірақ бұл соңы.
Dialogue: 0,0:11:01.52,0:11:05.86,Default,,0,0,0,,《Иә, Дреллмен шайқас енді аяқталды.
Dialogue: 0,0:11:05.86,0:11:08.86,Default,,0,0,0,,Алайда жын қанының иесі...
Dialogue: 0,0:11:08.86,0:11:12.87,Default,,0,0,0,,Менің ойымша, жын-шайтанның патшасы Водин бұдан бас тартады деп ойламаймын.
Dialogue: 0,0:11:12.87,0:11:15.87,Default,,0,0,0,,Егер Водейн қазір пайда болса...》
Dialogue: 0,0:11:15.87,0:11:17.87,Default,,0,0,0,,Ах... (шу)
Dialogue: 0,0:11:17.87,0:11:20.21,Default,,0,0,0,,Ол көрінбейді.
Dialogue: 0,0:11:20.21,0:11:24.21,Default,,0,0,0,,Жын қанының өзі онша күшке ие емес.
Dialogue: 0,0:11:24.21,0:11:27.55,Default,,0,0,0,,Таза! Раббым!
Dialogue: 0,0:11:27.55,0:11:31.55,Default,,0,0,0,,Жақсы, Луна да солай.
Dialogue: 0,0:11:31.55,0:11:35.26,Default,,0,0,0,,Ах! А... Луна?
Dialogue: 0,0:11:37.16,0:11:40.50,Default,,0,0,0,,Ах! (Лунаның күлуі)
Dialogue: 0,0:11:40.50,0:11:43.50,Default,,0,0,0,,Бала….
Dialogue: 0,0:11:43.50,0:11:46.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:46.17,0:11:48.17,Default,,0,0,0,,Уау.
Dialogue: 0,0:11:48.17,0:11:50.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:50.17,0:11:53.17,Default,,0,0,0,,Боя!
Dialogue: 0,0:11:53.17,0:11:55.51,Default,,0,0,0,,Боя! Құрметті Тоара! ?
Dialogue: 0,0:11:55.51,0:11:57.51,Default,,0,0,0,,Бала!
Dialogue: 0,0:11:57.51,0:12:01.18,Default,,0,0,0,,Луна-саманың анасы?
Dialogue: 0,0:12:01.18,0:12:04.85,Default,,0,0,0,,Иә, бұл ана мен баланың кездесуі.
Dialogue: 0,0:12:04.85,0:12:07.86,Default,,0,0,0,,Балам!
Dialogue: 0,0:12:07.86,0:12:10.86,Default,,0,0,0,,Сол жерде күтіңіз.
Dialogue: 0,0:12:10.86,0:12:15.20,Default,,0,0,0,,Жоқ! ? Бұл не, Крен, тоқтама!
Dialogue: 0,0:12:15.20,0:12:17.53,Default,,0,0,0,,Құрметті Алисия, ауырып тұр!
Dialogue: 0,0:12:17.53,0:12:20.20,Default,,0,0,0,,Бұл патшаның жеңіспен оралуы.
Dialogue: 0,0:12:20.20,0:12:22.87,Default,,0,0,0,,Патша өз билігімен қайтады.
Dialogue: 0,0:12:22.87,0:12:26.47,Default,,0,0,0,,Өз бетінше? Ах...
Dialogue: 0,0:12:31.21,0:12:33.21,Default,,0,0,0,,Абыройлы бол.
Dialogue: 0,0:12:36.15,0:12:38.82,Default,,0,0,0,,Иә? Луна-сама!
Dialogue: 0,0:12:38.82,0:12:40.82,Default,,0,0,0,,Тұр!
Dialogue: 0,0:12:42.82,0:12:45.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:47.50,0:12:49.50,Default,,0,0,0,,Уф... (Алисия/Нерл) Ах!
Dialogue: 0,0:12:49.50,0:12:51.50,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:12:54.50,0:12:57.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:57.84,0:13:00.14,Default,,0,0,0,,Патша жүруді тоқтатпайды.
Dialogue: 0,0:13:06.85,0:13:11.52,Default,,0,0,0,,Кішкене ғана... Тағы да Боя!
Dialogue: 0,0:13:11.52,0:13:14.22,Default,,0,0,0,,Сәттілік Луна! оған барыңыз!
Dialogue: 0,0:13:18.19,0:13:23.87,Default,,0,0,0,,Қош келдіңіз Қайтадан қош келдіңіз балам!
Dialogue: 0,0:13:23.87,0:13:28.20,Default,,0,0,0,,Иә! Бұл керемет, Луна!
Dialogue: 0,0:13:28.20,0:13:30.20,Default,,0,0,0,,Хун.
Dialogue: 0,0:13:30.20,0:13:32.21,Default,,0,0,0,,《Алисия: Жоқ, бірінші кезекте➨
Dialogue: 0,0:13:32.21,0:13:36.14,Default,,0,0,0,,Қамалға шабуыл жасап, ханзаданы ұрлап әкеткен сен едің...
Dialogue: 0,0:13:36.14,0:13:41.15,Default,,0,0,0,,Не болса да...
Dialogue: 0,0:13:41.15,0:13:43.15,Default,,0,0,0,,Құрметті Алисия!
Dialogue: 0,0:13:43.15,0:13:48.82,Default,,0,0,0,,Лунаны осы елге қайтарғаныма қуаныштымын...
Dialogue: 0,0:13:48.82,0:13:51.49,Default,,0,0,0,,Құрметті Алисия Құрметті Алисия!
Dialogue: 0,0:13:51.49,0:13:55.16,Default,,0,0,0,,Амансың ба? ? Батыр, жараңды тез емде!
Dialogue: 0,0:13:55.16,0:13:59.50,Default,,0,0,0,,Жарайды, зияны көрінгеннен таяз...
Dialogue: 0,0:13:59.50,0:14:03.17,Default,,0,0,0,,Одан да Дрелл сарбаздары...
Dialogue: 0,0:14:03.17,0:14:06.17,Default,,0,0,0,,Оларға генералдың өлімін айт... Иә, солай!
Dialogue: 0,0:14:06.17,0:14:08.18,Default,,0,0,0,,Біз соғысты тоқтатуымыз керек!
Dialogue: 0,0:14:12.85,0:14:16.85,Default,,0,0,0,,Ол маған тиіседі! Кешіріңіз, бірақ мен сізге қалдырамын!
Dialogue: 0,0:14:16.85,0:14:19.15,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:21.86,0:14:25.19,Default,,0,0,0,,Бұл шындық белгілі болғанға дейін➨
Dialogue: 0,0:14:25.19,0:14:28.20,Default,,0,0,0,,Мен оны өз қолымда сақтаймын.
Dialogue: 0,0:14:32.53,0:14:38.47,Default,,0,0,0,,Сен бүгін өкінесің, Клибатс.
Dialogue: 0,0:14:38.47,0:14:41.81,Default,,0,0,0,,Сөзсіз.
Dialogue: 0,0:14:41.81,0:14:45.81,Default,,0,0,0,,Тоаның оянуы жақын.
Dialogue: 0,0:14:48.82,0:14:50.82,Default,,0,0,0,,Мен Тоа туралы білмеймін.
Dialogue: 0,0:14:50.82,0:14:54.16,Default,,0,0,0,,Менің сенен сабақ алайын деген ойым жоқ.
Dialogue: 0,0:14:54.16,0:14:58.46,Default,,0,0,0,,Уф... Сен жаусың ғой.
Dialogue: 0,0:15:01.83,0:15:03.83,Default,,0,0,0,,Хун.
Dialogue: 0,0:15:05.83,0:15:08.84,Default,,0,0,0,,Әзірше бұл шайқас соңы...
Dialogue: 0,0:15:17.85,0:15:21.18,Default,,0,0,0,,Адамдар әлемінде нені білу керек➨
Dialogue: 0,0:15:21.18,0:15:25.19,Default,,0,0,0,,Тағы да бар сияқты.
Dialogue: 0,0:15:25.19,0:15:29.86,Default,,0,0,0,,Бітті! Соғыс аяқталды!
Dialogue: 0,0:15:29.86,0:15:32.53,Default,,0,0,0,,Уф, бұл...
Dialogue: 0,0:15:32.53,0:15:34.80,Default,,0,0,0,,Гах! Гуга….
Dialogue: 0,0:15:34.80,0:15:38.13,Default,,0,0,0,,Бітті. Генерал Дрелл қайтыс болды!
Dialogue: 0,0:15:38.13,0:15:41.84,Default,,0,0,0,,Бұл Эсслин бөлімшесінің командирі Род Ройес!
Dialogue: 0,0:15:44.47,0:15:48.81,Default,,0,0,0,,Ержүрек Алисия генерал Дреллді жеңді!
Dialogue: 0,0:15:48.81,0:15:51.81,Default,,0,0,0,,Екі жақ, қаруларыңды тастаңдар!
Dialogue: 0,0:15:55.15,0:15:58.49,Default,,0,0,0,,Бұл қазына генерал Дореллге тиесілі...
Dialogue: 0,0:15:58.49,0:16:00.49,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:16:00.49,0:16:04.49,Default,,0,0,0,,Сигналды көтеріңіз! «Барлық күштер шегінді»!
Dialogue: 0,0:16:04.49,0:16:06.49,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:11.83,0:16:14.17,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:16:14.17,0:16:16.84,Default,,0,0,0,,Шабуыл тоқтатылды! ?
Dialogue: 0,0:16:16.84,0:16:19.51,Default,,0,0,0,,⚟Шабуылды тоқтатыңыз! Шабуыл жойылды!
Dialogue: 0,0:16:19.51,0:16:23.18,Default,,0,0,0,,А... ⚟Жау генералы соғыста қаза тапты, шабуыл тоқтатылды!
Dialogue: 0,0:16:23.18,0:16:28.18,Default,,0,0,0,,Тоқтауды қалай атуға болады! Түсіруді тоқтатыңыз!
Dialogue: 0,0:16:28.18,0:16:32.19,Default,,0,0,0,,⚟Шабуылдан бас тарту Шабуылдан бас тарту! Түсіруді тоқтатыңыз!
Dialogue: 0,0:16:32.19,0:16:36.79,Default,,0,0,0,,⚟Жау генералы Дрелл шайқаста қаза тапты! Барлық бөлімшелердің шабуылы тоқтатылды!
Dialogue: 0,0:16:36.79,0:16:39.79,Default,,0,0,0,,⚟Патша гвардиясы, қылышыңды таста!
Dialogue: 0,0:16:47.13,0:16:50.47,Default,,0,0,0,,Шегін! Генерал Доррелл соғыста қаза тапты!
Dialogue: 0,0:16:50.47,0:16:52.81,Default,,0,0,0,,Барлық әскерлер шығарылсын!
Dialogue: 0,0:16:52.81,0:16:55.81,Default,,0,0,0,,Соғыс аяқталды. Ол аяқтады!
Dialogue: 0,0:16:55.81,0:16:59.41,Default,,0,0,0,,Бітті! Шегіну! Шегіну!
Dialogue: 0,0:17:04.49,0:17:08.49,Default,,0,0,0,,Соңы….
Dialogue: 0,0:17:15.16,0:17:17.16,Default,,0,0,0,,Аа...
Dialogue: 0,0:17:34.45,0:17:36.78,Default,,0,0,0,,Бұл қай діни қызметкер...?
Dialogue: 0,0:17:36.78,0:17:38.79,Default,,0,0,0,,Қол тигізбеңіз!
Dialogue: 0,0:17:38.79,0:17:41.79,Default,,0,0,0,,Ішіндегі болмыс тірі.
Dialogue: 0,0:17:41.79,0:17:47.13,Default,,0,0,0,,Шығуға тырыспаған шығар.
Dialogue: 0,0:17:47.13,0:17:50.46,Default,,0,0,0,,Ешқашан бұл жерге ешкімді жақындатпаңыз!
Dialogue: 0,0:17:50.46,0:17:53.47,Default,,0,0,0,,Бұл сіз көре алатын барлық нәрсе!
Dialogue: 0,0:18:14.82,0:18:16.82,Default,,0,0,0,,Дұрыс жұмыс істесе жақсы болар еді➨
Dialogue: 0,0:18:16.82,0:18:19.83,Default,,0,0,0,,Сіз аурудан шынымен құтыла алмайсыз.
Dialogue: 0,0:18:19.83,0:18:23.16,Default,,0,0,0,,Ішімдегі жара әлі ауырады.
Dialogue: 0,0:18:23.16,0:18:26.83,Default,,0,0,0,,Әп-сәтте өлтіруі керек жараны емдеді.
Dialogue: 0,0:18:26.83,0:18:28.84,Default,,0,0,0,,Тек ауырсыну қалады.
Dialogue: 0,0:18:28.84,0:18:32.77,Default,,0,0,0,,Шебердің шеберлігі шынымен де ғажап... иә?
Dialogue: 0,0:18:32.77,0:18:36.78,Default,,0,0,0,,Мен Уну денесін емдегендегідей жаман болмаса да.
Dialogue: 0,0:18:36.78,0:18:41.12,Default,,0,0,0,,Күдік тудырмас үшін қанды бірден тоқтатқан жоқпын.
Dialogue: 0,0:18:41.12,0:18:44.79,Default,,0,0,0,,Бұдан былай бұл билік құпия болып қалады.
Dialogue: 0,0:18:44.79,0:18:46.79,Default,,0,0,0,,Иә... солай.
Dialogue: 0,0:18:46.79,0:18:50.79,Default,,0,0,0,,Сонда да Креннің әңгімесі туралы не ойлайсың?
Dialogue: 0,0:18:50.79,0:18:53.13,Default,,0,0,0,,Енді жоқ адамдармен➨
Dialogue: 0,0:18:53.13,0:18:57.47,Default,,0,0,0,,Солар ғана нағыз батыр бола алады дейсіз бе?
Dialogue: 0,0:18:57.47,0:19:00.80,Default,,0,0,0,,Аа, дұрыс. Сіз бұл рас деп ойлайсыз ба?
Dialogue: 0,0:19:00.80,0:19:02.80,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:19:02.80,0:19:05.81,Default,,0,0,0,,«Тоа» атауы белгілі
Dialogue: 0,0:19:05.81,0:19:10.14,Default,,0,0,0,,Бұл кітаптың Гейденнің кейінгі патшаларына әсер еткені.
Dialogue: 0,0:19:10.14,0:19:14.15,Default,,0,0,0,,Шындық батырлар туралы аңыздарда жатса керек.
Dialogue: 0,0:19:14.15,0:19:19.49,Default,,0,0,0,,Ағымдағы мәтінде емес, бастапқы мәтінде.
Dialogue: 0,0:19:19.49,0:19:22.82,Default,,0,0,0,,Мен алған кітаптың кілті бар➨
Dialogue: 0,0:19:22.82,0:19:26.49,Default,,0,0,0,,Кілт кітапты ашпады.
Dialogue: 0,0:19:26.49,0:19:30.16,Default,,0,0,0,,Ол тесікке кірді, бірақ оны айналдыра алмады.
Dialogue: 0,0:19:30.16,0:19:33.10,Default,,0,0,0,,Бұл басқа кітаптың кілті дегенді білдіре ме?
Dialogue: 0,0:19:33.10,0:19:36.10,Default,,0,0,0,,Бұлай ойлау табиғи болар еді.
Dialogue: 0,0:19:36.10,0:19:38.77,Default,,0,0,0,,Тіпті оны күштеп ашуға болады➨
Dialogue: 0,0:19:38.77,0:19:43.78,Default,,0,0,0,,Жоқ. 2 немесе 3 кітап немесе одан да көп...
Dialogue: 0,0:19:43.78,0:19:46.45,Default,,0,0,0,,Білу үшін...
Dialogue: 0,0:19:46.45,0:19:48.78,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:19:48.78,0:19:53.45,Default,,0,0,0,,Құрметті батырлар партиясы, сарайға келіңіздер.
Dialogue: 0,0:19:53.45,0:19:58.16,Default,,0,0,0,,Мәртебелі Мәртебелі... Жоқ. Мәртебелі патшайым Довагер Тоара сізді күтуде.
Dialogue: 0,0:20:00.13,0:20:03.13,Default,,0,0,0,,Қамалдың көп бөлігі жоғалды➨
Dialogue: 0,0:20:03.13,0:20:06.47,Default,,0,0,0,,Тақтың аман болғанына қуаныштымын.
Dialogue: 0,0:20:06.47,0:20:08.80,Default,,0,0,0,,О, кяхаха. Ең бастысы ➨
Dialogue: 0,0:20:08.80,0:20:11.81,Default,,0,0,0,,Біздің патшамыз аман...
Dialogue: 0,0:20:11.81,0:20:15.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:21.82,0:20:25.49,Default,,0,0,0,,Сізге қоңырау шалған адам ғана емес.
Dialogue: 0,0:20:25.49,0:20:29.16,Default,,0,0,0,,Үшеулерің, осы елдің үлкен қайырымдыларыңдар.
Dialogue: 0,0:20:29.16,0:20:32.83,Default,,0,0,0,,Шын жүректен алғыс айтамын...
Dialogue: 0,0:20:32.83,0:20:34.83,Default,,0,0,0,,Лорд Нерл.
Dialogue: 0,0:20:34.83,0:20:36.83,Default,,0,0,0,,Лорд Кренн.
Dialogue: 0,0:20:36.83,0:20:39.83,Default,,0,0,0,,Және батыр Алисия-доно.
Dialogue: 0,0:20:39.83,0:20:44.84,Default,,0,0,0,,Кешіріңіз, кешіріңіз, кешіріңіз!
Dialogue: 0,0:20:44.84,0:20:46.84,Default,,0,0,0,,Неліктен кешірім сұрайсыз?
Dialogue: 0,0:20:46.84,0:20:49.84,Default,,0,0,0,,Бұл жігіт болашақ патша болады деген сөз➨
Dialogue: 0,0:20:49.84,0:20:52.85,Default,,0,0,0,,Төмен адамның сүтін беру➨
Dialogue: 0,0:20:52.85,0:20:55.85,Default,,0,0,0,,Бұл орынсыз деп есептегендіктен болса керек.
Dialogue: 0,0:20:55.85,0:21:00.19,Default,,0,0,0,,Жақсы! «Мен бір қарақшының күң қызымын.
Dialogue: 0,0:21:00.19,0:21:03.52,Default,,0,0,0,,Патша болатынның аузын арамдадым➨
Dialogue: 0,0:21:03.52,0:21:06.19,Default,,0,0,0,,Қалай кешірім сұрауым керек?»
Dialogue: 0,0:21:06.19,0:21:08.50,Default,,0,0,0,,Осыны айт және тыңда.
Dialogue: 0,0:21:10.53,0:21:13.20,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:21:13.20,0:21:15.87,Default,,0,0,0,,Жоғары қара, Неру.
Dialogue: 0,0:21:15.87,0:21:20.21,Default,,0,0,0,,А-а... Артық емес деген шектен шыққан.
Dialogue: 0,0:21:20.21,0:21:22.21,Default,,0,0,0,,Аа...
Dialogue: 0,0:21:22.21,0:21:26.88,Default,,0,0,0,,Ұлым жоғалып кеткенде мені ең қатты алаңдатқан нәрсе➨ болды
Dialogue: 0,0:21:26.88,0:21:29.55,Default,,0,0,0,,Мүмкін қарныңыз ашқан шығар➨
Dialogue: 0,0:21:29.55,0:21:33.49,Default,,0,0,0,,Сол үшін жыладым ба деп ойлаймын.
Dialogue: 0,0:21:33.49,0:21:35.82,Default,,0,0,0,,Күй маңызды емес.
Dialogue: 0,0:21:35.82,0:21:38.49,Default,,0,0,0,,Сен менің нағыз жанашырымсың.
Dialogue: 0,0:21:38.49,0:21:42.50,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:21:42.50,0:21:47.90,Default,,0,0,0,,А... Моттайнай сөздер.
Dialogue: 0,0:21:52.84,0:21:56.18,Default,,0,0,0,,Ал, үшеуің, үмітің бар ма?
Dialogue: 0,0:21:56.18,0:21:59.18,Default,,0,0,0,,Жер мен мәртебе Қолымнан келсе➨
Dialogue: 0,0:21:59.18,0:22:02.18,Default,,0,0,0,,Маған не қалайтыныңызды айтыңыз.
Dialogue: 0,0:22:05.19,0:22:08.52,Default,,0,0,0,,Әйтеуір... иә?
Dialogue: 0,0:22:08.52,0:22:10.86,Default,,0,0,0,,Мен...
Dialogue: 0,0:22:10.86,0:22:14.86,Default,,0,0,0,,Сонда мен...
Dialogue: 0,0:22:14.86,0:22:17.53,Default,,0,0,0,,(Лунаның күлуі)
Dialogue: 0,0:22:17.53,0:22:20.87,Default,,0,0,0,,Онда мен➨мын
Dialogue: 0,0:22:20.87,0:22:24.47,Default,,0,0,0,,Мен патшаның сиқырлы ұстазы болғым келеді.
Dialogue: 0,0:23:57.16,0:24:03.17,Default,,0,0,0,,♬～
Dialogue: 0,0:24:03.17,0:24:05.84,Default,,0,0,0,,Не істеп жатырсың, қызметші? Тез кел.
Dialogue: 0,0:24:05.84,0:24:08.18,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:24:08.18,0:24:11.18,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:24:11.18,0:24:15.18,Default,,0,0,0,,Біртүрлі емес пе? Бұл...
Dialogue: 0,0:24:15.18,0:24:17.48,Default,,0,0,0,,Кеттік, Алисия.
Dialogue: 0,0:24:18.98,0:24:24.98,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory