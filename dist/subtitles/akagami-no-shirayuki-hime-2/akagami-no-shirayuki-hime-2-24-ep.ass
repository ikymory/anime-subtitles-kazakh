Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.64,0:00:03.26,Default,,0,0,0,,Танбаруннан хабаршы келе ме?
Dialogue: 0,0:00:03.93,0:00:05.64,Default,,0,0,0,,Ертең келетін сияқты.
Dialogue: 0,0:00:05.76,0:00:08.68,Default,,0,0,0,,Шираюкиді шақырғанда көп нәрсе болды деп ойлаймын?
Dialogue: 0,0:00:08.81,0:00:10.23,Default,,0,0,0,,Бұл туралы.
Dialogue: 0,0:00:10.89,0:00:14.48,Default,,0,0,0,,Шираюки сол жақтағы ханзадамен дос болды ма?
Dialogue: 0,0:00:14.86,0:00:16.19,Default,,0,0,0,,Кем дегенде Шираюки...
Dialogue: 0,0:00:16.48,0:00:18.61,Default,,0,0,0,,Мен Раджи-дононы алдаймын деп ойламаймын.
Dialogue: 0,0:00:18.94,0:00:21.07,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:00:21.20,0:00:23.95,Default,,0,0,0,,Сол бала ханзадаға жарасымды емес пе?
Dialogue: 0,0:00:24.24,0:00:28.45,Default,,0,0,0,,Егер сіз осылай ойласаңыз, ағаңызбен жақсы қарым-қатынас орната аласыз.
Dialogue: 0,0:00:28.87,0:00:29.66,Default,,0,0,0,,Иә
Dialogue: 0,0:00:29.79,0:00:32.83,Default,,0,0,0,,Егер мен сенімен жақсы аралассам, маған қарсы болмайсың.
Dialogue: 0,0:00:34.08,0:00:35.17,Default,,0,0,0,,Бұл қажетсіз алаңдаушылық.
Dialogue: 0,0:00:36.25,0:00:38.55,Default,,0,0,0,,Оны жек көретін менмін.
Dialogue: 0,0:00:39.59,0:00:41.30,Default,,0,0,0,,Танбарун қандай болса да...
Dialogue: 0,0:00:41.43,0:00:44.64,Default,,0,0,0,,Шираюкидің әлі де істейтін ісі болса, бұл қызық емес пе?
Dialogue: 0,0:00:45.39,0:00:47.81,Default,,0,0,0,,Мен хабаршымен амандасамын.
Dialogue: 0,0:00:47.93,0:00:48.68,Default,,0,0,0,,О
Dialogue: 0,0:00:58.40,0:01:03.41,Default,,0,0,0,,♪～
Dialogue: 0,0:02:22.78,0:02:27.78,Default,,0,0,0,,～♪
Dialogue: 0,0:02:29.74,0:02:31.08,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:02:34.37,0:02:37.29,Default,,0,0,0,,Алдыңғы қатардағы арамшөптерден арылу ғана қалды...
Dialogue: 0,0:02:37.88,0:02:40.96,Default,,0,0,0,,Әкіме шөбінің өну күйін бақылау және...
Dialogue: 0,0:02:43.05,0:02:44.38,Default,,0,0,0,,Уау! (Шираюки) Иә?
Dialogue: 0,0:02:44.59,0:02:47.30,Default,,0,0,0,,Ауырды... Жолдан кет!
Dialogue: 0,0:02:47.43,0:02:49.97,Default,,0,0,0,,Не? Ақыр аяғында бұл сенсің.
Dialogue: 0,0:02:50.10,0:02:51.26,Default,,0,0,0,,Бұл не деген сұмдық?!
Dialogue: 0,0:02:51.85,0:02:53.93,Default,,0,0,0,,Михай? (Михая) Дұрыс.
Dialogue: 0,0:02:54.85,0:02:56.69,Default,,0,0,0,,Сонымен... ха
Dialogue: 0,0:02:56.81,0:02:59.61,Default,,0,0,0,,Танбаруннан хабаршы болып келдім.
Dialogue: 0,0:02:59.73,0:03:01.61,Default,,0,0,0,,Жоғары мәртебелі Дзенмен және басқалармен амандасқаннан кейін...
Dialogue: 0,0:03:01.86,0:03:04.19,Default,,0,0,0,,Бетімді көрсету үшін жол бойы келсем де.
Dialogue: 0,0:03:04.32,0:03:05.61,Default,,0,0,0,,Жас ханыммен танысу -
Dialogue: 0,0:03:05.74,0:03:08.20,Default,,0,0,0,,Көлеңкеден неге жасырдың?
Dialogue: 0,0:03:08.36,0:03:10.87,Default,,0,0,0,,Мен сені көргім келмеді, өйткені біз бірге тұрған сияқтымыз.
Dialogue: 0,0:03:10.99,0:03:12.66,Default,,0,0,0,,Мынау қаңғыбас мысықтың беті!
Dialogue: 0,0:03:12.79,0:03:13.83,Default,,0,0,0,,Хабаршы дегеніміз не?
Dialogue: 0,0:03:14.54,0:03:16.58,Default,,0,0,0,,Михайя, сен Танбарунға көштің бе?
Dialogue: 0,0:03:16.71,0:03:17.37,Default,,0,0,0,,Иә
Dialogue: 0,0:03:18.08,0:03:20.96,Default,,0,0,0,,Сен екеумізді теңіз тырнағынан жұлып алғанда...
Dialogue: 0,0:03:21.08,0:03:22.21,Default,,0,0,0,,Олар оларды ұстайды...
Dialogue: 0,0:03:22.34,0:03:24.71,Default,,0,0,0,,Таңбарунға үлкен мәлімет бермедің бе?
Dialogue: 0,0:03:25.30,0:03:27.42,Default,,0,0,0,,Осыдан кейін тырнақпен жалғанған жауыз...
Dialogue: 0,0:03:27.55,0:03:30.43,Default,,0,0,0,,Сүйреп шыққандай болды...
Dialogue: 0,0:03:30.55,0:03:32.10,Default,,0,0,0,,Мен марапат ретінде атақ алдым.
Dialogue: 0,0:03:32.51,0:03:33.43,Default,,0,0,0,,Не!
Dialogue: 0,0:03:33.56,0:03:35.39,Default,,0,0,0,,Менде әлі күш жоқ...
Dialogue: 0,0:03:36.39,0:03:40.85,Default,,0,0,0,,Болмаса... Мен қазір Виконт Сисктің отбасының басшысымын, иә?
Dialogue: 0,0:03:41.31,0:03:46.49,Default,,0,0,0,,Уау, бұл көп энергия. Сонда сіз Танбаруннан келген хабаршысыз ба?
Dialogue: 0,0:03:46.78,0:03:47.82,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:47.95,0:03:51.20,Default,,0,0,0,,Мен сені білетіндіктен ғана келдім.
Dialogue: 0,0:03:51.32,0:03:52.32,Default,,0,0,0,,Тағы бір хабаршы бар...
Dialogue: 0,0:03:53.03,0:03:54.74,Default,,0,0,0,,Менің саған бір ісім бар, Шираюки.
Dialogue: 0,0:03:55.20,0:03:57.29,Default,,0,0,0,,Мен үшін не?
Dialogue: 0,0:03:58.29,0:03:59.71,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:04:00.37,0:04:01.54,Default,,0,0,0,,Шираюки
Dialogue: 0,0:04:02.38,0:04:04.00,Default,,0,0,0,,Осы киімде ыстық емес пе?
Dialogue: 0,0:04:04.13,0:04:07.26,Default,,0,0,0,,Дзен ішінде. Жоғары мәртебелі Изана да осында.
Dialogue: 0,0:04:07.55,0:04:09.13,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:04:09.51,0:04:11.30,Default,,0,0,0,,Сол Танбаруннан келген хабаршы...
Dialogue: 0,0:04:11.55,0:04:13.55,Default,,0,0,0,,Ханзада Раджға бірдеңе болды ма?
Dialogue: 0,0:04:13.80,0:04:16.10,Default,,0,0,0,,Бұлай емес сияқты.
Dialogue: 0,0:04:16.22,0:04:17.60,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:04:19.85,0:04:22.98,Default,,0,0,0,,Шираюки, біз жаңа ғана келдік.
Dialogue: 0,0:04:26.78,0:04:28.19,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:04:28.32,0:04:30.90,Default,,0,0,0,,Шираюки-доно, біраз уақыт өтті.
Dialogue: 0,0:04:31.49,0:04:32.91,Default,,0,0,0,,Сакаки мырза
Dialogue: 0,0:04:33.03,0:04:36.83,Default,,0,0,0,,Менің саған бір нәрсе бергім келетін сияқты, Шираюки.
Dialogue: 0,0:04:37.41,0:04:38.95,Default,,0,0,0,,Ханзада Изана
Dialogue: 0,0:04:39.62,0:04:40.62,Default,,0,0,0,,Мен және Зен...
Dialogue: 0,0:04:40.75,0:04:42.83,Default,,0,0,0,,Олар куәгер болса жақсы болар еді деді.
Dialogue: 0,0:04:42.96,0:04:44.75,Default,,0,0,0,,Маған қатысуға рұқсат берілді.
Dialogue: 0,0:04:49.34,0:04:52.38,Default,,0,0,0,,Мен ханзада Танбарунның атынан келдім.
Dialogue: 0,0:04:52.84,0:04:53.68,Default,,0,0,0,,Шираюки-доно
Dialogue: 0,0:04:54.47,0:04:55.55,Default,,0,0,0,,Ууух!
Dialogue: 0,0:04:57.26,0:04:59.52,Default,,0,0,0,,Ханзада Раджидің сөздері
Dialogue: 0,0:04:59.64,0:05:01.81,Default,,0,0,0,,«Кларин патшалығындағы Шираюки-доноға»
Dialogue: 0,0:05:01.94,0:05:05.90,Default,,0,0,0,,«Танбарун патша отбасының досы атағын береді»
Dialogue: 0,0:05:08.53,0:05:09.94,Default,,0,0,0,,Тақырып…
Dialogue: 0,0:05:10.65,0:05:13.61,Default,,0,0,0,,Бәрiңiз қол тиген қызыл шашты қыз...
Dialogue: 0,0:05:13.95,0:05:16.12,Default,,0,0,0,,Осы танбарунда бір ғана адам...
Dialogue: 0,0:05:16.70,0:05:19.33,Default,,0,0,0,,Оған патша отбасының досы деген атақ берілді!
Dialogue: 0,0:05:20.08,0:05:25.04,Default,,0,0,0,,А... Менің ойымша, бұл жақсы жоспарланған блеф болды.
Dialogue: 0,0:05:25.17,0:05:28.59,Default,,0,0,0,,Сол тарихқа сүйене отырып, ханзада Раджи ұсыныс жасады...
Dialogue: 0,0:05:28.96,0:05:31.97,Default,,0,0,0,,Король «жақсы және қызықты» деп танылды
Dialogue: 0,0:05:32.38,0:05:33.47,Default,,0,0,0,,Не!
Dialogue: 0,0:05:33.59,0:05:35.89,Default,,0,0,0,,Енді сен де мемлекет қонағысың.
Dialogue: 0,0:05:36.64,0:05:39.68,Default,,0,0,0,,Шираюки-доно біздің елге кез келген уақытта келсе екен...
Dialogue: 0,0:05:39.81,0:05:41.73,Default,,0,0,0,,Ханзада Радждың жүрегі
Dialogue: 0,0:05:48.57,0:05:50.98,Default,,0,0,0,,Иә, рақмет.
Dialogue: 0,0:05:56.16,0:05:58.24,Default,,0,0,0,,Шираюки (Шираюки) Зен
Dialogue: 0,0:05:58.53,0:06:02.83,Default,,0,0,0,,Хехе...
Dialogue: 0,0:06:03.33,0:06:05.50,Default,,0,0,0,,Хаха...
Dialogue: 0,0:06:05.62,0:06:07.13,Default,,0,0,0,,Сіз күлдіңіз бе?
Dialogue: 0,0:06:07.67,0:06:10.50,Default,,0,0,0,,А... Ағасы (Шираюки) Ханзада Изана?
Dialogue: 0,0:06:10.63,0:06:12.21,Default,,0,0,0,,Корольдік отбасының достары
Dialogue: 0,0:06:12.92,0:06:16.97,Default,,0,0,0,,Бұл біртүрлі есім, бірақ ғажап... Хехе, әй.
Dialogue: 0,0:06:17.64,0:06:20.89,Default,,0,0,0,,Мен сені мазақ етіп отырған жоқпын, бұл біртүрлі.
Dialogue: 0,0:06:22.56,0:06:24.06,Default,,0,0,0,,Иә
Dialogue: 0,0:06:27.69,0:06:28.52,Default,,0,0,0,,Мен бұрыннан-
Dialogue: 0,0:06:29.31,0:06:32.86,Default,,0,0,0,,Қасымда сен сияқты біреу болған шығар...
Dialogue: 0,0:06:32.99,0:06:35.07,Default,,0,0,0,,Мен Шираюкиге Дзеннің аты түсетінін айттым...
Dialogue: 0,0:06:36.78,0:06:39.20,Default,,0,0,0,,Енді сіз доссыз...
Dialogue: 0,0:06:39.32,0:06:41.28,Default,,0,0,0,,Менің ойымша, бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:06:51.88,0:06:53.05,Default,,0,0,0,,Шираюки
Dialogue: 0,0:06:53.55,0:06:57.01,Default,,0,0,0,,Дзенмен қалай болғың келеді?
Dialogue: 0,0:06:57.13,0:06:59.55,Default,,0,0,0,,Менен бұны ешқашан сұраған емес.
Dialogue: 0,0:07:01.43,0:07:04.56,Default,,0,0,0,,Мен айта алатын бірдеңе бар-жоғын білмеймін.
Dialogue: 0,0:07:05.52,0:07:08.10,Default,,0,0,0,,Атауыңызбен құттықтаймыз
Dialogue: 0,0:07:08.69,0:07:11.86,Default,,0,0,0,,(Кёко) Ш-шын ба…? Сенің мен Шиндô-кунның араларыңда солай ма…
Dialogue: 0,0:07:15.24,0:07:16.70,Default,,0,0,0,,Мен...
Dialogue: 0,0:07:17.24,0:07:18.41,Default,,0,0,0,,Шираюки
Dialogue: 0,0:07:19.03,0:07:21.03,Default,,0,0,0,,Ах, кешіріңіз, бәрі жақсы.
Dialogue: 0,0:07:21.53,0:07:23.87,Default,,0,0,0,,Мені бір нәрсе шошытты.
Dialogue: 0,0:07:25.62,0:07:26.83,Default,,0,0,0,,Шираюки
Dialogue: 0,0:07:28.00,0:07:32.00,Default,,0,0,0,,Сіз ойлағаннан да көп нәрсені істеуге асықпауыңыз керек.
Dialogue: 0,0:07:34.55,0:07:40.34,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:07:53.90,0:07:55.86,Default,,0,0,0,,Менің ойымша, бұл қазір анық болды.
Dialogue: 0,0:07:55.98,0:07:56.82,Default,,0,0,0,,Иә
Dialogue: 0,0:07:56.94,0:07:58.74,Default,,0,0,0,,Эй, мен кіріп жатырмын.
Dialogue: 0,0:07:59.74,0:08:01.82,Default,,0,0,0,,Эй, Шираюки-кун
Dialogue: 0,0:08:01.95,0:08:03.45,Default,,0,0,0,,Ақыры оларға бақыт келді
Dialogue: 0,0:08:04.83,0:08:05.99,Default,,0,0,0,,Сакаки мырза
Dialogue: 0,0:08:06.12,0:08:08.96,Default,,0,0,0,,Мен Шираюки-кунмен аздап сөйлескім келеді.
Dialogue: 0,0:08:09.46,0:08:11.96,Default,,0,0,0,,Ах, Рю, сен маған көмектесе аласың ба?
Dialogue: 0,0:08:12.08,0:08:12.92,Default,,0,0,0,,Иә
Dialogue: 0,0:08:15.25,0:08:17.71,Default,,0,0,0,,Кешіріңіз, мен жұмыстамын.
Dialogue: 0,0:08:17.84,0:08:18.88,Default,,0,0,0,,Жарайды
Dialogue: 0,0:08:19.01,0:08:21.80,Default,,0,0,0,,Мен үзілісті жаңа ғана аяқтадым.
Dialogue: 0,0:08:25.06,0:08:26.10,Default,,0,0,0,,Ум...
Dialogue: 0,0:08:26.22,0:08:27.18,Default,,0,0,0,,Мүмкіндік болса...
Dialogue: 0,0:08:27.31,0:08:30.48,Default,,0,0,0,,Мен сізді әлі Радж ханзаданың серіктесі деп санаймын.
Dialogue: 0,0:08:30.85,0:08:31.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:32.69,0:08:34.48,Default,,0,0,0,,Менің ойымша, бұл қызықты.
Dialogue: 0,0:08:35.32,0:08:38.69,Default,,0,0,0,,Радж ханзада ондай ниеті жоқ сияқты көрінді.
Dialogue: 0,0:08:38.82,0:08:40.28,Default,,0,0,0,,Міне.
Dialogue: 0,0:08:40.40,0:08:43.16,Default,,0,0,0,,Егер сіз қатты итерсеңіз, ханзада сынуы мүмкін.
Dialogue: 0,0:08:43.28,0:08:44.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:44.70,0:08:46.16,Default,,0,0,0,,Ханзада Радж қазір-
Dialogue: 0,0:08:46.28,0:08:49.08,Default,,0,0,0,,Сіздің өз еркіңіз бар ма?
Dialogue: 0,0:08:49.20,0:08:49.96,Default,,0,0,0,,Қазір...
Dialogue: 0,0:08:50.71,0:08:53.58,Default,,0,0,0,,Сіз қазір қатты ұйықтап жатқан болуыңыз керек.
Dialogue: 0,0:08:53.71,0:08:54.63,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:09:05.05,0:09:06.51,Default,,0,0,0,,Ах~
Dialogue: 0,0:09:11.94,0:09:14.94,Default,,0,0,0,,Сақаки мырза қашаннан бері ханзадаға жақын болды?
Dialogue: 0,0:09:15.61,0:09:17.32,Default,,0,0,0,,Бес ханзада...
Dialogue: 0,0:09:17.44,0:09:19.94,Default,,0,0,0,,Мен 16 жасымнан бері сізде жұмыс істеймін.
Dialogue: 0,0:09:20.32,0:09:22.28,Default,,0,0,0,,Баяғыда
Dialogue: 0,0:09:22.86,0:09:25.37,Default,,0,0,0,,Жарайды, мен артқы жағында тұрмын.
Dialogue: 0,0:09:25.70,0:09:27.28,Default,,0,0,0,,Бірақ сол себепті...
Dialogue: 0,0:09:27.41,0:09:29.79,Default,,0,0,0,,Мен сол адам сияқты көріністі көрдім.
Dialogue: 0,0:09:30.29,0:09:34.50,Default,,0,0,0,,Сіз болған пейзаж жарқырап тұрғандай болды.
Dialogue: 0,0:09:35.25,0:09:38.04,Default,,0,0,0,,Мұның бәрі ханзада үшін жаңа болды.
Dialogue: 0,0:09:38.17,0:09:40.05,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:09:40.34,0:09:43.34,Default,,0,0,0,,Ханзада Радж маған осындай нәрсені сеніп тапсырды.
Dialogue: 0,0:09:44.01,0:09:47.93,Default,,0,0,0,,Бұл жаңа досқа жазған жеке хат сияқты.
Dialogue: 0,0:09:53.56,0:09:57.44,Default,,0,0,0,,«Шираюки-доно, содан бері жақсы жүрдің бе?»
Dialogue: 0,0:09:58.44,0:10:01.69,Default,,0,0,0,,«Мен күн сайын бас айналу қарқынымен алға жылжып келемін».
Dialogue: 0,0:10:01.94,0:10:03.49,Default,,0,0,0,,«Сізді сонда жіберген сақалар...»
Dialogue: 0,0:10:03.61,0:10:05.61,Default,,0,0,0,,«Мен сенің маған келетініңді ешқашан күтпедім...»
Dialogue: 0,0:10:05.74,0:10:07.32,Default,,0,0,0,,«Менің ойымша, сіз өзімшілдік туралы айтып отырсыз, бірақ...»
Dialogue: 0,0:10:07.62,0:10:09.08,Default,,0,0,0,,«Бұл маңызды емес».
Dialogue: 0,0:10:12.29,0:10:16.71,Default,,0,0,0,,«Менің сізбен қазіргі қарым-қатынасым жаман емес деп ойлаймын».
Dialogue: 0,0:10:17.71,0:10:18.54,Default,,0,0,0,,«Осы жерден...»
Dialogue: 0,0:10:18.67,0:10:21.09,Default,,0,0,0,,«Бұл қажетсіз болуы мүмкін, бірақ мен оны жазамын».
Dialogue: 0,0:10:22.13,0:10:23.67,Default,,0,0,0,,«Тақырып туралы...»
Dialogue: 0,0:10:23.80,0:10:27.18,Default,,0,0,0,,«Шираюки-дононың бізбен байланысы болса да, корольдік отбасы...»
Dialogue: 0,0:10:27.30,0:10:29.64,Default,,0,0,0,,«Мүмкін сәл епті шығар».
Dialogue: 0,0:10:30.14,0:10:33.06,Default,,0,0,0,,«Мен саған алып жүру үшін қалқан ретінде беремін».
Dialogue: 0,0:10:33.64,0:10:36.35,Default,,0,0,0,,«Егер оның болуының зияны болмаса, оны алыңыз».
Dialogue: 0,0:10:37.19,0:10:38.65,Default,,0,0,0,,«Мен де солай істеймін»
Dialogue: 0,0:10:39.36,0:10:41.61,Default,,0,0,0,,«Олай болса, Радж Шехназад»
Dialogue: 0,0:10:54.33,0:10:55.75,Default,,0,0,0,,Мен...
Dialogue: 0,0:11:05.51,0:11:08.30,Default,,0,0,0,,Бұл жерде тыныштық сезіледі~
Dialogue: 0,0:11:12.47,0:11:13.51,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:21.06,0:11:22.19,Default,,0,0,0,,Бұл тек болжам ғана, айтпақшы.
Dialogue: 0,0:11:22.69,0:11:23.61,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:23.90,0:11:26.15,Default,,0,0,0,,Оби... Не болды?
Dialogue: 0,0:11:26.28,0:11:28.53,Default,,0,0,0,,Мен түнгімін, білесің.
Dialogue: 0,0:11:29.32,0:11:33.87,Default,,0,0,0,,Жас келіншек не істеп жатыр? Бұл түн біткенше
Dialogue: 0,0:11:33.99,0:11:35.87,Default,,0,0,0,,А... оян.
Dialogue: 0,0:11:36.45,0:11:38.33,Default,,0,0,0,,Мен емдік шөп бақшасына баруды ойлап жүрмін.
Dialogue: 0,0:11:38.79,0:11:40.62,Default,,0,0,0,,Сіз біртүрлі көрінесіз.
Dialogue: 0,0:11:42.75,0:11:43.96,Default,,0,0,0,,Хехе
Dialogue: 0,0:11:46.21,0:11:48.80,Default,,0,0,0,,Туған жеріңізден атақ алғаныңызды естідім...
Dialogue: 0,0:11:48.92,0:11:51.59,Default,,0,0,0,,Мен сені бақытты деп ойладым.
Dialogue: 0,0:11:51.72,0:11:55.43,Default,,0,0,0,,Иә, таң қалдым, бірақ қуандым.
Dialogue: 0,0:11:55.64,0:11:57.27,Default,,0,0,0,,Ханзада Раджи жақсы болып жатқан сияқты.
Dialogue: 0,0:11:57.81,0:12:01.27,Default,,0,0,0,,Иә? Бұл жақсы болар еді
Dialogue: 0,0:12:02.31,0:12:03.48,Default,,0,0,0,,Кеше
Dialogue: 0,0:12:03.61,0:12:04.65,Default,,0,0,0,,Қызу!
Dialogue: 0,0:12:06.98,0:12:12.36,Default,,0,0,0,,Мен қазір қайда екенімді білмеймін.
Dialogue: 0,0:12:12.86,0:12:16.62,Default,,0,0,0,,Қай бөлім... Мен түсінбедім...
Dialogue: 0,0:12:16.74,0:12:20.37,Default,,0,0,0,,Бұл сіз қайда болғыңыз келетінін білесіз бе?
Dialogue: 0,0:12:20.71,0:12:22.92,Default,,0,0,0,,Жоқ... Мен мұны түсінбедім.
Dialogue: 0,0:12:27.71,0:12:30.22,Default,,0,0,0,,Қиын нәрсені ойламас бұрын...
Dialogue: 0,0:12:30.34,0:12:32.47,Default,,0,0,0,,Ұстазбен кездессем жақсы болар еді деп ойлаймын.
Dialogue: 0,0:12:33.72,0:12:38.27,Default,,0,0,0,,Мүмкін Дзен бұл туралы ойлаған шығар.
Dialogue: 0,0:12:38.39,0:12:44.40,Default,,0,0,0,,Дзен-сама сізді алып бара жатқан жерде тұрғыңыз келсе,
Dialogue: 0,0:12:45.40,0:12:47.36,Default,,0,0,0,,Алда не күтіп тұр...
Dialogue: 0,0:12:48.11,0:12:51.74,Default,,0,0,0,,Мен... Мен әрқашан болдым
Dialogue: 0,0:12:53.99,0:12:55.99,Default,,0,0,0,,О, барасың ба?
Dialogue: 0,0:12:56.91,0:12:59.49,Default,,0,0,0,,Оби, сен маған күшіңді бере аласың ба?
Dialogue: 0,0:13:02.16,0:13:05.00,Default,,0,0,0,,Барғың келетін жер болса, мені сонда апар.
Dialogue: 0,0:13:05.13,0:13:07.00,Default,,0,0,0,,Мен саған бұрын айтқан жоқпын ба? (Шираюки) Оби
Dialogue: 0,0:13:08.46,0:13:11.55,Default,,0,0,0,,Мүмкін бұл жолы «мен сені әкелемін»
Dialogue: 0,0:13:12.67,0:13:14.18,Default,,0,0,0,,Бұл менің рөлім.
Dialogue: 0,0:13:14.34,0:13:16.60,Default,,0,0,0,,Күте тұр, қыз.
Dialogue: 0,0:13:29.40,0:13:30.82,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:13:35.16,0:13:35.82,Default,,0,0,0,,Шираюки
Dialogue: 0,0:13:36.32,0:13:37.49,Default,,0,0,0,,Зен
Dialogue: 0,0:13:44.46,0:13:45.92,Default,,0,0,0,,Шираюки...
Dialogue: 0,0:13:49.46,0:13:50.13,Default,,0,0,0,,Зен
Dialogue: 0,0:13:50.84,0:13:56.26,Default,,0,0,0,,Ханзада Изананың кешегі сөзіне әлі ештеңе айта алмадым...
Dialogue: 0,0:13:56.80,0:13:58.51,Default,,0,0,0,,Аузыңды жап, кешір
Dialogue: 0,0:14:00.01,0:14:02.43,Default,,0,0,0,,Сол кезде мен түсіндім
Dialogue: 0,0:14:03.23,0:14:06.56,Default,,0,0,0,,Мен Дзенге сені сүйемін деп айтқан күннен бері...
Dialogue: 0,0:14:07.02,0:14:11.44,Default,,0,0,0,,Сол күні саған айтқанымның барлығы, мен сенің жаныңда болып, саған көмектескім келеді.
Dialogue: 0,0:14:11.94,0:14:13.86,Default,,0,0,0,,Бірде-бір нәрсе өзгерген жоқ
Dialogue: 0,0:14:14.65,0:14:16.95,Default,,0,0,0,,О, мен де.
Dialogue: 0,0:14:22.58,0:14:23.33,Default,,0,0,0,,Зен
Dialogue: 0,0:14:24.45,0:14:28.17,Default,,0,0,0,,Мен... бұл туралы ойлана аламын ба?
Dialogue: 0,0:14:29.13,0:14:30.17,Default,,0,0,0,,Маған Зен ұнайды-
Dialogue: 0,0:14:30.88,0:14:33.09,Default,,0,0,0,,Мен ханзада Зеннің қасында тұрғым келеді...
Dialogue: 0,0:14:34.55,0:14:36.55,Default,,0,0,0,,Мен бір күні сонда болғым келеді
Dialogue: 0,0:14:42.76,0:14:45.52,Default,,0,0,0,,Мен сізге асығудың қажеті жоқ дедім.
Dialogue: 0,0:14:53.48,0:14:54.78,Default,,0,0,0,,Зен…
Dialogue: 0,0:14:55.11,0:15:00.12,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:15:11.96,0:15:16.63,Default,,0,0,0,,Кешіріңіз Шираюки, мен сізге бұдан әрі не болатынын айтқым келеді.
Dialogue: 0,0:15:17.97,0:15:19.22,Default,,0,0,0,,Шираюки!
Dialogue: 0,0:15:19.97,0:15:23.39,Default,,0,0,0,,Кешіріңіз... Кешіріңіз, аяғым әлсіз.
Dialogue: 0,0:15:23.81,0:15:26.52,Default,,0,0,0,,Жоқ, кешіріңіз... мен...
Dialogue: 0,0:15:26.77,0:15:29.39,Default,,0,0,0,,А... сен тұра аласың ба, Шираюки?
Dialogue: 0,0:15:29.90,0:15:31.40,Default,,0,0,0,,Ол бетіне шықты ма?
Dialogue: 0,0:15:33.44,0:15:35.07,Default,,0,0,0,,Жақсы! (Шираюки) Уау!
Dialogue: 0,0:15:37.65,0:15:41.82,Default,,0,0,0,,Кеттік. Палатада жұмыс істеуге әлі ерте, солай емес пе?
Dialogue: 0,0:15:44.99,0:15:48.66,Default,,0,0,0,,Не... неге Оби Дзеннің бөлмесінде ұйықтап жатыр?
Dialogue: 0,0:15:49.96,0:15:52.88,Default,,0,0,0,,Иә? Бұл не, Мицухиде?
Dialogue: 0,0:15:53.46,0:15:55.75,Default,,0,0,0,,Түнде не істеп жүрсің?
Dialogue: 0,0:15:55.88,0:15:58.34,Default,,0,0,0,,Мен сенің не істеп жатқаныңды білгім келеді.
Dialogue: 0,0:16:02.09,0:16:05.47,Default,,0,0,0,,Мен бұл құлыптағы адамдардың қимылын білемін, оны маған қалдырыңыз.
Dialogue: 0,0:16:05.60,0:16:07.52,Default,,0,0,0,,Иә, шығу үшін бе?
Dialogue: 0,0:16:07.64,0:16:10.48,Default,,0,0,0,,Бұл менің бала кезімнен қалыптасқан әдетім. Жеңіл қабылдамаңыз.
Dialogue: 0,0:16:10.60,0:16:13.98,Default,,0,0,0,,Жоқ, ол шынымен де керемет. Ол керемет адам.
Dialogue: 0,0:16:14.11,0:16:15.27,Default,,0,0,0,,Қатты дауыс
Dialogue: 0,0:16:15.40,0:16:18.99,Default,,0,0,0,,Бірақ түнгі ауысымнан кейін болса да, кешеден бері бұл туралы айтып жатырмыз.
Dialogue: 0,0:16:19.11,0:16:21.66,Default,,0,0,0,,Сенпай патша әулетінің досы ғой!
Dialogue: 0,0:16:22.03,0:16:23.74,Default,,0,0,0,,Біздің Шираюки-доно күткендей!
Dialogue: 0,0:16:23.87,0:16:25.33,Default,,0,0,0,,Жоғары мәртебелі Дзен сізден сұраса...
Dialogue: 0,0:16:25.45,0:16:26.41,Default,,0,0,0,,Тек мұны істеу жеткіліксіз.
Dialogue: 0,0:16:26.53,0:16:30.16,Default,,0,0,0,,Жарайды, мәртебелі Дзеннің жүрегі үлкен.
Dialogue: 0,0:16:30.87,0:16:31.87,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:34.08,0:16:36.21,Default,,0,0,0,,Екеуің не істеп жатырсыңдар?
Dialogue: 0,0:16:36.38,0:16:39.88,Default,,0,0,0,,Жоқ, күзетші Зенді көргенін хабарлады...
Dialogue: 0,0:16:40.01,0:16:41.09,Default,,0,0,0,,Бұл уақыт осындай болуы керек.
Dialogue: 0,0:16:41.42,0:16:43.01,Default,,0,0,0,,Мен оны іздедім.
Dialogue: 0,0:16:43.13,0:16:46.14,Default,,0,0,0,,Сіз жас ханыммен кездескен сияқтысыз.
Dialogue: 0,0:16:46.26,0:16:47.81,Default,,0,0,0,,Сіз мұны білдіңіз.
Dialogue: 0,0:16:47.93,0:16:50.93,Default,,0,0,0,,Мен не болғанын да білмеймін.
Dialogue: 0,0:16:51.35,0:16:53.73,Default,,0,0,0,,Сіз таңғы асқа келесіз, солай ма?
Dialogue: 0,0:16:54.06,0:16:55.73,Default,,0,0,0,,Қандай башаламандық
Dialogue: 0,0:16:55.86,0:16:57.44,Default,,0,0,0,,Неге маған қоңырау шалмайсың?
Dialogue: 0,0:16:57.57,0:17:01.07,Default,,0,0,0,,Кейде көмекшілердің міндеті - үнсіз қарау.
Dialogue: 0,0:17:02.36,0:17:04.28,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:17:05.24,0:17:10.25,Default,,0,0,0,,(Дзеннің тынысы)
Dialogue: 0,0:17:13.62,0:17:14.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:25.22,0:17:27.18,Default,,0,0,0,,Ауа таза.
Dialogue: 0,0:17:27.30,0:17:30.10,Default,,0,0,0,,Бұл жерде үзіліс жоқ, тек екеуміз ғана.
Dialogue: 0,0:17:31.93,0:17:34.35,Default,,0,0,0,,Өйткені сен тұрмадың.
Dialogue: 0,0:17:34.48,0:17:36.86,Default,,0,0,0,,Мені біреу көрсе ыңғайсыз болар деп ойладым.
Dialogue: 0,0:17:37.31,0:17:40.57,Default,,0,0,0,,Не? А... Түсіндім, рахмет
Dialogue: 0,0:18:04.01,0:18:06.43,Default,,0,0,0,,Шираюки Бұл менмін...
Dialogue: 0,0:18:07.14,0:18:09.01,Default,,0,0,0,,Мен ағама айттым.
Dialogue: 0,0:18:09.55,0:18:11.89,Default,,0,0,0,,Шираюки туралы менің ойым
Dialogue: 0,0:18:13.56,0:18:16.85,Default,,0,0,0,,Сондықтан... Жоқ, сондықтан.
Dialogue: 0,0:18:17.19,0:18:19.02,Default,,0,0,0,,Сіз маған жаңа ғана айттыңыз ...
Dialogue: 0,0:18:19.94,0:18:23.40,Default,,0,0,0,,Мен бұл туралы ойлана аламын ба?
Dialogue: 0,0:18:23.53,0:18:25.11,Default,,0,0,0,,Маған Зен ұнайды-
Dialogue: 0,0:18:25.24,0:18:27.53,Default,,0,0,0,,Мен ханзада Зеннің қасында тұрғым келеді.
Dialogue: 0,0:18:28.49,0:18:30.53,Default,,0,0,0,,Мен бір күні сонда болғым келеді
Dialogue: 0,0:18:31.45,0:18:33.33,Default,,0,0,0,,Бұл сөздердің жауабы:
Dialogue: 0,0:18:34.00,0:18:35.54,Default,,0,0,0,,«Ах»
Dialogue: 0,0:18:40.92,0:18:42.50,Default,,0,0,0,,Ұзақ уақыт бойы
Dialogue: 0,0:18:47.80,0:18:52.85,Default,,0,0,0,,Бұдан былай мен өзімшіл боламын, бірақ күте тұрыңыз.
Dialogue: 0,0:18:53.14,0:18:56.56,Default,,0,0,0,,Күндердің күнінде міндетті түрде орынды сөзбен айтамын.
Dialogue: 0,0:18:57.60,0:18:58.69,Default,,0,0,0,,Иә
Dialogue: 0,0:19:00.27,0:19:03.69,Default,,0,0,0,,Бірдеңені айтамын деп уәде беру өте жағымсыз.
Dialogue: 0,0:19:04.36,0:19:05.74,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:19:06.78,0:19:07.65,Default,,0,0,0,,Біз кездескеннен бері-
Dialogue: 0,0:19:08.28,0:19:10.24,Default,,0,0,0,,Дзен керемет
Dialogue: 0,0:19:11.70,0:19:14.87,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:19:26.67,0:19:27.92,Default,,0,0,0,,Сіз де
Dialogue: 0,0:19:36.81,0:19:37.89,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:19:38.02,0:19:38.85,Default,,0,0,0,,Аға
Dialogue: 0,0:19:43.19,0:19:43.98,Default,,0,0,0,,Не болды?
Dialogue: 0,0:19:44.48,0:19:47.03,Default,,0,0,0,,Таңбарун хабаршыны шығарып салу 14:00-де кетеді.
Dialogue: 0,0:19:47.78,0:19:48.95,Default,,0,0,0,,О
Dialogue: 0,0:19:54.70,0:19:57.20,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:20:00.67,0:20:02.38,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:20:02.50,0:20:06.30,Default,,0,0,0,,Мен бірінші рет қарап тұрған жоқпын.
Dialogue: 0,0:20:06.59,0:20:07.30,Default,,0,0,0,,Иә
Dialogue: 0,0:20:13.14,0:20:14.05,Default,,0,0,0,,Раджи-доно өте...
Dialogue: 0,0:20:14.18,0:20:17.18,Default,,0,0,0,,Сенімді болып бара жатқан сияқтысың, Сакаки-доно.
Dialogue: 0,0:20:17.31,0:20:19.98,Default,,0,0,0,,Жетпейді Әлі жоқ.
Dialogue: 0,0:20:20.10,0:20:21.19,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:20:21.73,0:20:23.98,Default,,0,0,0,,Олай болса, кешіріңіз.
Dialogue: 0,0:20:24.52,0:20:25.57,Default,,0,0,0,,Иә
Dialogue: 0,0:20:27.07,0:20:27.73,Default,,0,0,0,,Ах
Dialogue: 0,0:20:28.11,0:20:30.49,Default,,0,0,0,,Сакаки мырза, иә.
Dialogue: 0,0:20:32.20,0:20:36.33,Default,,0,0,0,,Бұл менің хатыма жауап. Сіз оны ханзада Раджға бере аласыз ба?
Dialogue: 0,0:20:37.37,0:20:38.79,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:20:38.91,0:20:42.08,Default,,0,0,0,,Шираюки-доно мүмкіндігі болса, сізді қайтадан баурап алуға тырысады.
Dialogue: 0,0:20:42.67,0:20:44.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:44.46,0:20:49.05,Default,,0,0,0,,Менімен де дос бол, Танбарун патша әулетінің досы.
Dialogue: 0,0:20:49.17,0:20:52.22,Default,,0,0,0,,Маған атақ керек болса, сені асырап алған ұлым етіп аламын.
Dialogue: 0,0:20:52.34,0:20:53.01,Default,,0,0,0,,Сіз...
Dialogue: 0,0:20:54.39,0:20:56.35,Default,,0,0,0,,Мүмкіндік болса
Dialogue: 0,0:20:56.47,0:20:57.89,Default,,0,0,0,,Мүмкін сияқты.
Dialogue: 0,0:20:58.01,0:21:00.73,Default,,0,0,0,,Өйткені Шираюкиде көптеген байланыстар бар.
Dialogue: 0,0:21:05.81,0:21:06.90,Default,,0,0,0,,Мүмкін-
Dialogue: 0,0:21:07.02,0:21:09.48,Default,,0,0,0,,Сіз мені Раджимен кездесуге шақырдыңыз ба?
Dialogue: 0,0:21:09.61,0:21:11.86,Default,,0,0,0,,О... сен таптың.
Dialogue: 0,0:21:11.99,0:21:15.24,Default,,0,0,0,,Бұл тыныштық емес, мен
Dialogue: 0,0:21:15.37,0:21:16.03,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:21:16.45,0:21:20.25,Default,,0,0,0,,Жоқ, бұл күлетін нәрсе емес... Әй.
Dialogue: 0,0:21:21.91,0:21:22.58,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:21:23.33,0:21:24.54,Default,,0,0,0,,Жұмысқа оралу керек пе?
Dialogue: 0,0:21:25.21,0:21:26.54,Default,,0,0,0,,Иә Иә
Dialogue: 0,0:21:31.01,0:21:35.72,Default,,0,0,0,,♪～
Dialogue: 0,0:22:58.76,0:23:03.72,Default,,0,0,0,,～♪
Dialogue: 0,0:23:05.43,0:23:08.31,Default,,0,0,0,,Кешке тексеру кестесіне қатысты жиналыс болады.
Dialogue: 0,0:23:08.44,0:23:11.02,Default,,0,0,0,,Осының алдында есеппен танысуға рұқсат етіңіздер.
Dialogue: 0,0:23:11.27,0:23:11.94,Default,,0,0,0,,О
Dialogue: 0,0:23:12.90,0:23:14.15,Default,,0,0,0,,Шираюки Матана
Dialogue: 0,0:23:14.73,0:23:16.19,Default,,0,0,0,,Кейін кездескенше Зен
Dialogue: 0,0:23:18.32,0:23:22.66,Default,,0,0,0,,Бұл менің жолым, менің оқиғам
Dialogue: 0,0:23:23.24,0:23:24.62,Default,,0,0,0,,О, Шираюки-кун
Dialogue: 0,0:23:25.12,0:23:26.75,Default,,0,0,0,,Мені шығарып салуды аяқтадың ба?
Dialogue: 0,0:23:26.87,0:23:28.96,Default,,0,0,0,,Иә Сіз қабылдау бөлмесіне барасыз ба?
Dialogue: 0,0:23:29.08,0:23:29.75,Default,,0,0,0,,Иә
Dialogue: 0,0:23:30.25,0:23:33.13,Default,,0,0,0,,Сақталған Монрет шөптері әлі де жақсы жағдайда...
Dialogue: 0,0:23:33.25,0:23:35.25,Default,,0,0,0,,Мен оны ұнтақтаймын деп ойладым.
Dialogue: 0,0:23:35.71,0:23:37.67,Default,,0,0,0,,Мен сенімен барамын. Ол көмектеседі.
Dialogue: 0,0:23:41.43,0:23:42.60,Default,,0,0,0,,Қаласаңыз--
Dialogue: 0,0:23:43.43,0:23:47.23,Default,,0,0,0,,Осы жолдың соңын өзім сызып аламын
Dialogue: 0,0:23:47.81,0:23:51.23,Default,,0,0,0,,Қаласаңыз, осы оқиғаны бояңыз...
Dialogue: 0,0:23:51.77,0:23:54.11,Default,,0,0,0,,Тағдырдың түсі сияқты
Dialogue: 0,0:23:54.23,0:23:59.24,Default,,0,0,0,,♪～
Dialogue: 0,0:24:01.41,0:24:06.41,Default,,0,0,0,,～♪
Dialogue: 0,0:24:07.91,0:24:13.91,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory