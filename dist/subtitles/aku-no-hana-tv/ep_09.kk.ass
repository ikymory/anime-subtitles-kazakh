Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.87,0:00:02.95,Default,,0,0,0,,Мақтаныңыз!
Dialogue: 0,0:00:03.12,0:00:05.12,Default,,0,0,0,,Мен ақырында терінің бір қабатын тазарттым.
Dialogue: 0,0:00:31.04,0:00:32.00,Default,,0,0,0,,Касуга-кун
Dialogue: 0,0:00:46.50,0:00:47.66,Default,,0,0,0,,Саэки мырза
Dialogue: 0,0:00:57.25,0:00:58.29,Default,,0,0,0,,Қоштасайық
Dialogue: 0,0:01:11.66,0:01:12.62,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:01:15.50,0:01:16.50,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:01:16.62,0:01:17.29,Default,,0,0,0,,Қош бол!
Dialogue: 0,0:01:17.37,0:01:18.29,Default,,0,0,0,,Касуга-кун!
Dialogue: 0,0:01:25.66,0:01:26.58,Default,,0,0,0,,Бұл…
Dialogue: 0,0:01:28.91,0:01:30.87,Default,,0,0,0,,«Зұлымдық гүлдерінің» мұқаба суреті
Dialogue: 0,0:01:35.58,0:01:37.29,Default,,0,0,0,,Ол еденге сызылған.
Dialogue: 0,0:01:45.62,0:01:48.08,Default,,0,0,0,,Касуга-кун... Бұл не?
Dialogue: 0,0:01:51.91,0:01:53.58,Default,,0,0,0,,Сол сынып та...
Dialogue: 0,0:01:54.87,0:01:57.54,Default,,0,0,0,,Менің жаттығу киімдерім де...
Dialogue: 0,0:02:03.37,0:02:05.58,Default,,0,0,0,,Касуга-кун... бұл не?
Dialogue: 0,0:02:10.70,0:02:11.75,Default,,0,0,0,,Біз ажыраспаймыз!
Dialogue: 0,0:02:15.62,0:02:18.79,Default,,0,0,0,,Бірақ мен... сенімен ешқашан ажыраспаймын...
Dialogue: 0,0:02:30.75,0:02:33.33,Default,,0,0,0,,Өйткені... мен...
Dialogue: 0,0:02:34.25,0:02:36.87,Default,,0,0,0,,Мен... Өйткені! Өйткені!
Dialogue: 0,0:02:36.95,0:02:38.16,Default,,0,0,0,,Касуга-кун!
Dialogue: 0,0:02:39.08,0:02:41.62,Default,,0,0,0,,Сіз мені жек көре бастадыңыз ба?
Dialogue: 0,0:02:45.16,0:02:46.29,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:49.33,0:02:52.54,Default,,0,0,0,,Қайтадан ойлан... дұрыстап.
Dialogue: 0,0:03:45.70,0:03:50.00,Default,,0,0,0,,Бір-біріне қарап тұру аздап ұят
Dialogue: 0,0:03:50.41,0:03:54.37,Default,,0,0,0,,Мен әлі ертеңді күтемін
Dialogue: 0,0:03:54.45,0:03:58.41,Default,,0,0,0,,Себебі мен жалғыз қалудан қорқамын
Dialogue: 0,0:03:58.54,0:04:02.79,Default,,0,0,0,,Уәде берейік
Dialogue: 0,0:04:03.45,0:04:07.70,Default,,0,0,0,,Айнаға теңестірілген кескін бұзылып жатыр
Dialogue: 0,0:04:07.83,0:04:12.41,Default,,0,0,0,,Бұл мен құрастырып жатқан басқатырғыш сияқты
Dialogue: 0,0:04:14.08,0:04:20.79,Default,,0,0,0,,Жүкті болған кезде не істеуім керек?
Dialogue: 0,0:04:21.50,0:04:22.33,Default,,0,0,0,,Неге...
Dialogue: 0,0:04:22.87,0:04:26.12,Default,,0,0,0,,Мен... осындай адам болсам да...
Dialogue: 0,0:04:26.29,0:04:27.95,Default,,0,0,0,,Мен Касуга-кунға айттым.
Dialogue: 0,0:04:28.16,0:04:30.29,Default,,0,0,0,,Саэки мырза жыныстық қатынасқа түскісі келеді.
Dialogue: 0,0:04:30.37,0:04:31.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:31.25,0:04:32.41,Default,,0,0,0,,Мен түсінбеймін!
Dialogue: 0,0:04:32.95,0:04:36.33,Default,,0,0,0,,Касуга-кунның сезімі... Түсінбедім!
Dialogue: 0,0:04:36.66,0:04:38.91,Default,,0,0,0,,Мұны Такао жасады ма? Барлығы
Dialogue: 0,0:04:39.75,0:04:43.91,Default,,0,0,0,,Болатқа жайылған гүлдер бал дәмін татады
Dialogue: 0,0:04:44.00,0:04:48.79,Default,,0,0,0,,Гүлденбейтін гүлдер Жамандықтың бүршіктерін тер
Dialogue: 0,0:04:49.08,0:04:53.25,Default,,0,0,0,,Желпілдеген жапырақшалар сияқты
Dialogue: 0,0:04:53.33,0:04:57.45,Default,,0,0,0,,(Мені жалғыз қалдырмаңыз!)
Dialogue: 0,0:04:57.66,0:05:03.20,Default,,0,0,0,,Аздап ағып кете бастады.
Dialogue: 0,0:05:21.83,0:05:23.58,Default,,0,0,0,,Бұл сенің мектептен топпен бірінші рет шығуың, солай ма?
Dialogue: 0,0:05:24.29,0:05:25.91,Default,,0,0,0,,Маған бірдеңе дұрыс емес.
Dialogue: 0,0:05:27.16,0:05:29.08,Default,,0,0,0,,А, мен ренжідім.
Dialogue: 0,0:05:29.25,0:05:32.50,Default,,0,0,0,,Менің ата-анам біраз уақытқа коменданттық сағат енгізбекші.
Dialogue: 0,0:05:32.91,0:05:35.66,Default,,0,0,0,,А, біз де қиындыққа тап болуымыз мүмкін.
Dialogue: 0,0:05:36.00,0:05:37.75,Default,,0,0,0,,Тротуармен дұрыс жүріңіз!
Dialogue: 0,0:05:38.66,0:05:40.54,Default,,0,0,0,,Саэки-сан, сен тым сүйкімдісің.
Dialogue: 0,0:05:42.00,0:05:45.87,Default,,0,0,0,,Бірақ олардың гимнастика киіміне қалай қарағанына таңғаламын.
Dialogue: 0,0:05:47.12,0:05:48.70,Default,,0,0,0,,Хе... ақымақ
Dialogue: 0,0:05:55.83,0:05:59.41,Default,,0,0,0,,Әй, пневматикалық мылтығыммен бұзықты ұстасам қалай болады? Хехе...
Dialogue: 0,0:05:59.50,0:06:00.87,Default,,0,0,0,,Мүмкін болса, жасап көріңіз.
Dialogue: 0,0:06:01.20,0:06:03.75,Default,,0,0,0,,Дада да да да…
Dialogue: 0,0:06:04.12,0:06:05.37,Default,,0,0,0,,Шық, бұзық!
Dialogue: 0,0:06:21.37,0:06:22.45,Default,,0,0,0,,Қош келдіңіз Такао
Dialogue: 0,0:06:22.83,0:06:26.50,Default,,0,0,0,,Мектепте жақсысың ба? Басқа бұзық пайда болды ма?
Dialogue: 0,0:06:26.62,0:06:28.66,Default,,0,0,0,,Эй, мен қорқамын.
Dialogue: 0,0:06:28.87,0:06:30.58,Default,,0,0,0,,Қызық, күзет қандай болды?
Dialogue: 0,0:06:30.70,0:06:32.66,Default,,0,0,0,,Эй, бұл оқуға ең жақсы жер емес, солай ма?
Dialogue: 0,0:06:32.79,0:06:35.16,Default,,0,0,0,,А... Такао?
Dialogue: 0,0:06:35.25,0:06:37.29,Default,,0,0,0,,Науқас, үстіңе демал
Dialogue: 0,0:06:50.91,0:06:52.33,Default,,0,0,0,,Неге...
Dialogue: 0,0:06:54.95,0:06:58.54,Default,,0,0,0,,Неге... сен мені жек көрмейсің бе?
Dialogue: 0,0:06:59.83,0:07:01.58,Default,,0,0,0,,Саэки мырза...
Dialogue: 0,0:07:02.33,0:07:06.16,Default,,0,0,0,,Мен... осындай адам болсам да...
Dialogue: 0,0:07:17.12,0:07:18.58,Default,,0,0,0,,Мен...
Dialogue: 0,0:07:20.54,0:07:22.33,Default,,0,0,0,,О, байқамаппын.
Dialogue: 0,0:07:32.50,0:07:35.04,Default,,0,0,0,,А... білмеймін...
Dialogue: 0,0:07:36.08,0:07:37.29,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:07:40.33,0:07:41.50,Default,,0,0,0,,Мен қашып кеткім келеді...
Dialogue: 0,0:07:43.08,0:07:48.54,Default,,0,0,0,,Алыс жерде... Мен туралы ешкім білмейтін қалаға
Dialogue: 0,0:07:54.04,0:07:58.12,Default,,0,0,0,,Ууууууууууу...
Dialogue: 0,0:07:58.37,0:08:04.45,Default,,0,0,0,,Уф, у... у... у...
Dialogue: 0,0:08:10.37,0:08:11.41,Default,,0,0,0,,Аоки
Dialogue: 0,0:08:11.66,0:08:12.29,Default,,0,0,0,,Иә
Dialogue: 0,0:08:12.66,0:08:13.50,Default,,0,0,0,,Абе
Dialogue: 0,0:08:13.83,0:08:14.58,Default,,0,0,0,,Yes
Dialogue: 0,0:08:15.20,0:08:16.16,Default,,0,0,0,,Уено
Dialogue: 0,0:08:16.33,0:08:16.95,Default,,0,0,0,,Иә
Dialogue: 0,0:08:17.33,0:08:18.12,Default,,0,0,0,,Урабе
Dialogue: 0,0:08:18.33,0:08:18.95,Default,,0,0,0,,Иә
Dialogue: 0,0:08:19.54,0:08:20.45,Default,,0,0,0,,Окуда
Dialogue: 0,0:08:20.79,0:08:21.41,Default,,0,0,0,,Иә
Dialogue: 0,0:08:21.87,0:08:25.37,Default,,0,0,0,,Касуга... суық тигендіктен жоқ... және...
Dialogue: 0,0:08:26.87,0:08:27.83,Default,,0,0,0,,Киношита
Dialogue: 0,0:08:28.00,0:08:28.62,Default,,0,0,0,,Иә
Dialogue: 0,0:08:29.08,0:08:29.83,Default,,0,0,0,,Года
Dialogue: 0,0:08:30.25,0:08:30.87,Default,,0,0,0,,Иә
Dialogue: 0,0:08:31.20,0:08:32.12,Default,,0,0,0,,Кодзима
Dialogue: 0,0:08:32.45,0:08:33.08,Default,,0,0,0,,Иә
Dialogue: 0,0:08:33.50,0:08:34.41,Default,,0,0,0,,Сайто
Dialogue: 0,0:08:34.50,0:08:35.12,Default,,0,0,0,,Иә
Dialogue: 0,0:08:35.66,0:08:36.62,Default,,0,0,0,,Саэки
Dialogue: 0,0:08:37.95,0:08:38.58,Default,,0,0,0,,Иә
Dialogue: 0,0:08:41.45,0:08:43.87,Default,,0,0,0,,Сынып бөлек, біртүрлі...
Dialogue: 0,0:08:43.95,0:08:44.75,Default,,0,0,0,,(Рюи) Неге сен өртеніп жатқан жоқсың?
Dialogue: 0,0:08:45.83,0:08:48.29,Default,,0,0,0,,Біздің сыныпты тазалап жатқан сияқты.
Dialogue: 0,0:08:48.66,0:08:49.70,Default,,0,0,0,,Барып көрейік! Барып көрейік!
Dialogue: 0,0:09:02.58,0:09:03.54,Default,,0,0,0,,Накамура мырза
Dialogue: 0,0:09:10.16,0:09:13.91,Default,,0,0,0,,Осы уақыт бойы... сіз білесіз бе? Касуга-кун туралы
Dialogue: 0,0:09:18.45,0:09:19.25,Default,,0,0,0,,Иә
Dialogue: 0,0:09:19.95,0:09:24.16,Default,,0,0,0,,Менен дос болуды өтіндің... Бұл не болды?
Dialogue: 0,0:09:24.58,0:09:25.45,Default,,0,0,0,,Өтірік?
Dialogue: 0,0:09:27.83,0:09:28.58,Default,,0,0,0,,Әй
Dialogue: 0,0:09:29.00,0:09:31.45,Default,,0,0,0,,Әсіресе менің бос уақытым болғандықтан.
Dialogue: 0,0:09:31.79,0:09:33.50,Default,,0,0,0,,Мен Касуга-кунға айттым.
Dialogue: 0,0:09:33.62,0:09:35.75,Default,,0,0,0,,Саэки мырза жыныстық қатынасқа түскісі келеді.
Dialogue: 0,0:09:35.83,0:09:36.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:36.54,0:09:38.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:38.12,0:09:39.83,Default,,0,0,0,,Өйткені бұл орын алатындай көрінді.
Dialogue: 0,0:09:40.08,0:09:43.62,Default,,0,0,0,,Қасуга-кун, сен қандай бет-әлпет жасайсың деп ойлап едім.
Dialogue: 0,0:09:45.16,0:09:46.25,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:09:48.00,0:09:51.20,Default,,0,0,0,,Накамура мырза! Сіз Касугамен қандай қарым-қатынастасыз?
Dialogue: 0,0:09:57.08,0:09:58.50,Default,,0,0,0,,Сіз келісімшартқа қол қойдыңыз ба?
Dialogue: 0,0:09:59.70,0:10:02.58,Default,,0,0,0,,Өйткені Касуга-кун – мүлде бұзық.
Dialogue: 0,0:10:02.66,0:10:05.41,Default,,0,0,0,,Мен оның барлық мазмұнын алып тастауға болатын келісім-шарт.
Dialogue: 0,0:10:08.75,0:10:10.29,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:10.45,0:10:11.91,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:14.20,0:10:16.45,Default,,0,0,0,,Касуга-кун бұзық емес!
Dialogue: 0,0:10:17.45,0:10:18.25,Default,,0,0,0,,Ахсо
Dialogue: 0,0:10:20.58,0:10:23.29,Default,,0,0,0,,Қалай қарасаң да, бұзық.
Dialogue: 0,0:10:23.62,0:10:25.29,Default,,0,0,0,,Осы қаланың ең жақсысы
Dialogue: 0,0:10:48.58,0:10:49.45,Default,,0,0,0,,Такао
Dialogue: 0,0:10:50.70,0:10:53.20,Default,,0,0,0,,Амансың ба? Мен алманың қабығын аршып алдым
Dialogue: 0,0:10:55.00,0:10:56.37,Default,,0,0,0,,Менің тамақ жегім келмейді.
Dialogue: 0,0:10:57.12,0:10:59.37,Default,,0,0,0,,Сіз кешеден бері ештеңе жеген жоқсыз, солай ма?
Dialogue: 0,0:11:04.50,0:11:05.91,Default,,0,0,0,,Сәлем Такао...
Dialogue: 0,0:11:06.87,0:11:09.04,Default,,0,0,0,,Мама, сізден бір нәрсе сұрайын деп едім...
Dialogue: 0,0:11:09.50,0:11:10.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:11.20,0:11:12.37,Default,,0,0,0,,Уа!
Dialogue: 0,0:11:19.12,0:11:19.87,Default,,0,0,0,,О.
Dialogue: 0,0:11:20.00,0:11:24.66,Default,,0,0,0,,Мм... Танысқаныма қуаныштымын, менің атым Саэки. Мен Касугамен бір сыныпта оқимын...
Dialogue: 0,0:11:24.83,0:11:26.45,Default,,0,0,0,,А... сәлем
Dialogue: 0,0:11:27.70,0:11:30.08,Default,,0,0,0,,Такао! Саеки мырза мен оның ұлы бізге қонаққа келді...
Dialogue: 0,0:11:30.16,0:11:31.04,Default,,0,0,0,,Күте тұрыңыз! Күрсін...
Dialogue: 0,0:11:31.58,0:11:33.37,Default,,0,0,0,,Айтыңызшы, сәл күте тұрыңыз!
Dialogue: 0,0:11:34.58,0:11:36.58,Default,,0,0,0,,Міне, осысы бізге жеңіс әкелді.
Dialogue: 0,0:11:36.66,0:11:37.79,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:11:37.91,0:11:40.50,Default,,0,0,0,,Менімен әлі кездесе алмайтыныңды айт!
Dialogue: 0,0:11:41.25,0:11:42.50,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:11:44.25,0:11:45.25,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:11:46.45,0:11:47.66,Default,,0,0,0,,Мүлдем емес...
Dialogue: 0,0:11:56.70,0:12:00.91,Default,,0,0,0,,Кешіріңіз, Такао, бірақ өзіңізді әлі де жақсы сезінбейтін сияқтысыз...
Dialogue: 0,0:12:02.41,0:12:03.33,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:12:04.00,0:12:05.91,Default,,0,0,0,,Рахмет...
Dialogue: 0,0:12:11.83,0:12:13.37,Default,,0,0,0,,Саэки мырза...
Dialogue: 0,0:12:15.91,0:12:16.87,Default,,0,0,0,,Касуга!
Dialogue: 0,0:12:16.95,0:12:17.58,Default,,0,0,0,,- ah
Dialogue: 0,0:12:18.12,0:12:19.91,Default,,0,0,0,,Касуга-кун, сен мені естисің бе?
Dialogue: 0,0:12:21.95,0:12:24.91,Default,,0,0,0,,Мен... Түсінбедім!
Dialogue: 0,0:12:25.66,0:12:29.00,Default,,0,0,0,,Неліктен Касуга-кун бұлай жасады?
Dialogue: 0,0:12:30.25,0:12:33.79,Default,,0,0,0,,Касуга-кунның сезімі... Түсінбедім!
Dialogue: 0,0:12:35.95,0:12:37.20,Default,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,0:12:37.87,0:12:38.95,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:44.29,0:12:45.45,Default,,0,0,0,,Мен...
Dialogue: 0,0:12:46.95,0:12:48.12,Default,,0,0,0,,Мен...
Dialogue: 0,0:12:50.37,0:12:53.16,Default,,0,0,0,,Спортзалға арналған киімдер ше! Әсіресе!
Dialogue: 0,0:12:53.66,0:12:54.70,Default,,0,0,0,,Мен өте қуаныштымын!
Dialogue: 0,0:12:54.95,0:12:55.87,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:12:56.83,0:12:58.58,Default,,0,0,0,,Касуга-кун...
Dialogue: 0,0:12:59.79,0:13:02.33,Default,,0,0,0,,Сіз мен туралы ойладыңыз, солай ма?
Dialogue: 0,0:13:03.50,0:13:06.70,Default,,0,0,0,,Ұлдар осындай...
Dialogue: 0,0:13:08.41,0:13:14.04,Default,,0,0,0,,Одан да, мен! Жасырын болса, қайғылы болар еді!
Dialogue: 0,0:13:15.70,0:13:19.20,Default,,0,0,0,,Айтыңызшы! Маған!
Dialogue: 0,0:13:20.33,0:13:24.04,Default,,0,0,0,,Накамура мырза емес... бірақ мен!
Dialogue: 0,0:13:25.41,0:13:30.08,Default,,0,0,0,,Касуга-кун, сенің ішіңде не бар... Түсінуге рұқсат ет!
Dialogue: 0,0:13:33.62,0:13:36.20,Default,,0,0,0,,А... ертең...
Dialogue: 0,0:13:37.45,0:13:40.12,Default,,0,0,0,,Ертең... мектепке кел.
Dialogue: 0,0:13:42.16,0:13:43.16,Default,,0,0,0,,Мен күтемін.
Dialogue: 0,0:13:45.66,0:13:46.83,Default,,0,0,0,,Мен күтемін!
Dialogue: 0,0:14:48.95,0:14:49.87,Default,,0,0,0,,Такао
Dialogue: 0,0:14:52.45,0:14:54.12,Default,,0,0,0,,Сен не істедің?
Dialogue: 0,0:14:54.75,0:14:56.58,Default,,0,0,0,,Анаңызға дұрыстап түсіндіріп беріңізші.
Dialogue: 0,0:15:01.91,0:15:05.70,Default,,0,0,0,,Мына киімдер... Мен оларды кір жуғыш машинаға тастадым.
Dialogue: 0,0:15:06.08,0:15:07.79,Default,,0,0,0,,Неліктен лас?
Dialogue: 0,0:15:09.91,0:15:12.20,Default,,0,0,0,,Мұны Такао жасады ма? Барлығы
Dialogue: 0,0:15:12.66,0:15:13.29,Default,,0,0,0,,Ах
Dialogue: 0,0:15:13.54,0:15:14.83,Default,,0,0,0,,Такао!
Dialogue: 0,0:15:20.29,0:15:23.54,Default,,0,0,0,,Хахахаха...
Dialogue: 0,0:15:23.62,0:15:24.29,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:15:24.41,0:15:27.12,Default,,0,0,0,,Хахахаха...
Dialogue: 0,0:15:27.41,0:15:28.75,Default,,0,0,0,,Еш жерде...
Dialogue: 0,0:15:30.08,0:15:31.33,Default,,0,0,0,,Мен қайдамын...
Dialogue: 0,0:15:31.41,0:15:35.45,Default,,0,0,0,,Хааааааааааааа...
Dialogue: 0,0:15:35.54,0:15:38.83,Default,,0,0,0,,Ешқайда... жоқ...
Dialogue: 0,0:15:39.00,0:15:41.33,Default,,0,0,0,,Хааааааааааааа...
Dialogue: 0,0:15:41.50,0:15:45.08,Default,,0,0,0,,Бұл қалада еш жерде… еш жерде…
Dialogue: 0,0:15:45.37,0:15:47.20,Default,,0,0,0,,Ахххх...
Dialogue: 0,0:15:47.29,0:15:50.62,Default,,0,0,0,,Ешқайда… Ешқайда…
Dialogue: 0,0:15:50.83,0:15:53.33,Default,,0,0,0,,Ааааааааааааа...
Dialogue: 0,0:15:53.41,0:15:55.79,Default,,0,0,0,,Хахахаха...
Dialogue: 0,0:16:04.54,0:16:11.66,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:16:12.04,0:16:20.16,Default,,0,0,0,,Хахаха... хахаха...
Dialogue: 0,0:16:21.20,0:16:23.83,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:16:29.12,0:16:35.41,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:16:36.54,0:16:38.50,Default,,0,0,0,,Сіз кешігіп қалдыңыз, Касуга-кун.
Dialogue: 0,0:17:25.75,0:17:27.12,Default,,0,0,0,,Сәлем Касуга-кун
Dialogue: 0,0:17:27.91,0:17:30.45,Default,,0,0,0,,Үндеме, маған бір қызық айт.
Dialogue: 0,0:17:37.70,0:17:39.16,Default,,0,0,0,,Негізінен, біз қашамыз.
Dialogue: 0,0:17:39.25,0:17:39.87,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:41.45,0:17:42.62,Default,,0,0,0,,Анықталды
Dialogue: 0,0:17:43.70,0:17:47.00,Default,,0,0,0,,Бәрі анықталды... ата-анама...
Dialogue: 0,0:17:54.04,0:17:55.41,Default,,0,0,0,,Сен сол 13 жылды жалғыз өзің күтесің, иә!
Dialogue: 0,0:17:56.95,0:17:59.58,Default,,0,0,0,,Мен енді ешқайда орала алмаймын
Dialogue: 0,0:18:02.08,0:18:05.83,Default,,0,0,0,,Үйде... Мектепте...
Dialogue: 0,0:18:07.62,0:18:09.45,Default,,0,0,0,,Саэки мырзаға да...
Dialogue: 0,0:18:13.16,0:18:14.54,Default,,0,0,0,,Такао!
Dialogue: 0,0:18:20.95,0:18:23.70,Default,,0,0,0,,Такао! Бар болсаң жауап бер!
Dialogue: 0,0:18:27.45,0:18:28.66,Default,,0,0,0,,Такао!
Dialogue: 0,0:18:31.54,0:18:32.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:33.08,0:18:34.50,Default,,0,0,0,,Такао!
Dialogue: 0,0:18:37.95,0:18:40.25,Default,,0,0,0,,Бұл Қасуғаның анасы ма?
Dialogue: 0,0:18:45.83,0:18:47.04,Default,,0,0,0,,Сіз ақымақ көрінесіз.
Dialogue: 0,0:18:54.70,0:18:55.54,Default,,0,0,0,,Эй
Dialogue: 0,0:18:58.33,0:19:00.08,Default,,0,0,0,,Онда барамыз ба?
Dialogue: 0,0:19:02.25,0:19:04.25,Default,,0,0,0,,Қайда... қайда?
Dialogue: 0,0:19:06.83,0:19:07.83,Default,,0,0,0,,Сол жерде
Dialogue: 0,0:19:19.95,0:19:21.04,Default,,0,0,0,,Мұнда кел
Dialogue: 0,0:19:34.12,0:19:37.25,Default,,0,0,0,,Бұл... менікі ме?
Dialogue: 0,0:19:39.91,0:19:40.79,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:19:41.58,0:19:45.83,Default,,0,0,0,,Касуга-кун, сен егеуқұйрық сияқты қашып кеттің ғой, солай ма? Бұл өте босаңсытады
Dialogue: 0,0:19:46.37,0:19:50.16,Default,,0,0,0,,Сені бәрі көрсін демесең, мені таудың арғы бетіне апарып бер.
Dialogue: 0,0:19:57.54,0:20:01.50,Default,,0,0,0,,Осы Добугеро қаласында болуыңызға басқа себеп бар ма?
Dialogue: 0,0:20:06.12,0:20:11.45,Default,,0,0,0,,Накамура мырза... менімен келесіз бе?
Dialogue: 0,0:20:12.83,0:20:16.41,Default,,0,0,0,,Оме менімен бірге келе жатыр! Кузударума
Dialogue: 0,0:20:56.50,0:20:58.12,Default,,0,0,0,,О, кешіріңіз!
Dialogue: 0,0:20:58.29,0:21:00.04,Default,,0,0,0,,Ах, Қасуға мырзаның әйелі.
Dialogue: 0,0:21:01.95,0:21:03.66,Default,,0,0,0,,Менің баламды көрмедің бе?
Dialogue: 0,0:21:04.37,0:21:05.66,Default,,0,0,0,,Не? Такао-кун?
Dialogue: 0,0:21:05.91,0:21:08.79,Default,,0,0,0,,Ах, а, а, а...
Dialogue: 0,0:21:08.87,0:21:10.37,Default,,0,0,0,,және оны сынық-сынық етіп шашу.
Dialogue: 0,0:21:10.79,0:21:12.70,Default,,0,0,0,,Не? Не болды? Бірдеңе болды ма?
Dialogue: 0,0:21:13.25,0:21:16.12,Default,,0,0,0,,Жоқ, ол секіріп кетті...
Dialogue: 0,0:21:16.20,0:21:16.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:17.29,0:21:20.08,Default,,0,0,0,,А, жоқ, кешіріңіз, рахмет!
Dialogue: 0,0:21:32.45,0:21:33.62,Default,,0,0,0,,Касуга-кун…
Dialogue: 0,0:21:36.16,0:21:43.33,Default,,0,0,0,,Хана га Саку Итайо Хана га Саку Итайо Хана га Саку Итайо
Dialogue: 0,0:21:43.87,0:21:54.37,Default,,0,0,0,,Желдің қорқынышты болғаны сонша, гүлдің жайқалғанын ешкім көрмеді.
Dialogue: 0,0:21:56.58,0:22:04.91,Default,,0,0,0,,Гүлдер гүлдейді
Dialogue: 0,0:22:05.95,0:22:09.50,Default,,0,0,0,,Гүлдер жайқалып тұрған сияқты.
Dialogue: 0,0:22:09.58,0:22:11.50,Default,,0,0,0,,Ханана Донай
Dialogue: 0,0:22:11.58,0:22:17.91,Default,,0,0,0,,Міне, солай болуы керек және оның дұрыс еместігі.
Dialogue: 0,0:22:18.04,0:22:26.62,Default,,0,0,0,,Шитара Сошитара Шитара Хана да да да да да…гай дайо
Dialogue: 0,0:22:27.12,0:22:31.70,Default,,0,0,0,,Оны ешкімнің көрмеуі мүмкін емес.
Dialogue: 0,0:22:31.79,0:22:36.08,Default,,0,0,0,,Гүлдену керек болған нәрсе гүлдеді
Dialogue: 0,0:22:36.16,0:22:41.75,Default,,0,0,0,,Орын қай жерде?
Dialogue: 0,0:22:41.83,0:22:46.91,Default,,0,0,0,,Хана га Саку Итайо Хана га Саку Итайо Хана га Саку Итайо
Dialogue: 0,0:22:47.04,0:22:54.04,Default,,0,0,0,,Желдің қорқынышты болғаны сонша, гүлдің жайқалғанын ешкім көрмеген.
Dialogue: 0,0:23:02.70,0:23:05.54,Default,,0,0,0,,Шитара Сошитара желден қатты қорқады.
Dialogue: 0,0:23:05.62,0:23:07.79,Default,,0,0,0,,Ешкім қарап тұрған жоқ.
Dialogue: 0,0:23:07.87,0:23:10.33,Default,,0,0,0,,Сол гүл, гүл, гүл
Dialogue: 0,0:23:10.41,0:23:14.20,Default,,0,0,0,,Желден дірілдеу
Dialogue: 0,0:23:20.62,0:23:22.08,Default,,0,0,0,,Бұл қалада ештеңе жоқ
Dialogue: 0,0:23:22.16,0:23:25.50,Default,,0,0,0,,Осы жерде қалсам, құрдымға кетемін.
Dialogue: 0,0:23:25.58,0:23:28.95,Default,,0,0,0,,Осылай қарасаң... бұл қандай шағын қала.
Dialogue: 0,0:23:29.00,0:23:29.62,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:23:29.75,0:23:31.87,Default,,0,0,0,,Касуга-кун Касуга-кун!
Dialogue: 0,0:23:32.25,0:23:34.95,Default,,0,0,0,,Мен... босмын...
Dialogue: 0,0:23:36.45,0:23:42.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory