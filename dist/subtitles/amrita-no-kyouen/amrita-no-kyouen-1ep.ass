Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:46.16,0:00:48.87,Default,,0,0,0,,[Цикада дыбысы: Джиджидзи...]
Dialogue: 0,0:00:55.00,0:00:56.33,Default,,0,0,0,,[Джиджидзи…]
Dialogue: 0,0:00:56.41,0:00:57.79,Default,,0,0,0,,[жаншылған дыбыс]
Dialogue: 0,0:01:02.04,0:01:05.66,Default,,0,0,0,,Вокзал алдында... Қараңызшы, көріпкелдік залы.
Dialogue: 0,0:01:06.29,0:01:08.75,Default,,0,0,0,,Бақытсыз зат - қызыл мата.
Dialogue: 0,0:01:08.83,0:01:13.00,Default,,0,0,0,,Қазір ойлап қарасам, әлгі қыздың жігіті ашық қызыл көйлек киген екен!
Dialogue: 0,0:01:13.08,0:01:14.00,Default,,0,0,0,,Идиот
Dialogue: 0,0:01:14.08,0:01:17.08,Default,,0,0,0,,Бала қате түсініп, бәріне жіберді.
Dialogue: 0,0:01:17.16,0:01:20.58,Default,,0,0,0,,Бұл Сайку Ааа...
Dialogue: 0,0:01:20.66,0:01:23.45,Default,,0,0,0,,Әй, жарайды. Бұл туралы дұрыстап сөйлесейік.
Dialogue: 0,0:01:23.54,0:01:25.87,Default,,0,0,0,,Тағдыр алдын ала болжағандай деп ойлап, бас тартсам ше?
Dialogue: 0,0:01:25.95,0:01:27.58,Default,,0,0,0,,Аки, үндеме
Dialogue: 0,0:01:27.66,0:01:28.50,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:01:28.58,0:01:30.58,Default,,0,0,0,,Мұндай сәйкестіктер бір-біріне сәйкес келе ме? Қалыпты
Dialogue: 0,0:01:30.66,0:01:33.95,Default,,0,0,0,,Жоқ! Бұл бір қарғыс шығар...
Dialogue: 0,0:01:34.04,0:01:37.79,Default,,0,0,0,,Қалай болғанда да, ертең жақсы идея болатынына сенімдімін.
Dialogue: 0,0:01:37.87,0:01:40.79,Default,,0,0,0,,Мен де ойланып көрейін, егер қаласаңыз, мен сізге еремін.
Dialogue: 0,0:01:41.79,0:01:42.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:43.37,0:01:44.45,Default,,0,0,0,,Әй...
Dialogue: 0,0:01:45.91,0:01:48.25,Default,,0,0,0,,[Қарғаның айқайы]
Dialogue: 0,0:01:48.79,0:01:50.66,Default,,0,0,0,,Не?
Dialogue: 0,0:01:58.95,0:02:00.58,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:08.54,0:02:10.20,Default,,0,0,0,,Уф! Уф...
Dialogue: 0,0:02:10.29,0:02:12.70,Default,,0,0,0,,[Тиннитус сияқты естіледі]
Dialogue: 0,0:02:12.79,0:02:17.08,Default,,0,0,0,,Тамахи! Сенімен бәрі жақсы ма!? Тамахи!
Dialogue: 0,0:02:18.54,0:02:23.08,Default,,0,0,0,,Тамахи! Сенімен бәрі жақсы ма!? Тамахи!
Dialogue: 0,0:02:30.37,0:02:31.79,Default,,0,0,0,,Ах
Dialogue: 0,0:02:34.79,0:02:36.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:37.29,0:02:38.58,Default,,0,0,0,,Тамахи!
Dialogue: 0,0:02:39.29,0:02:41.54,Default,,0,0,0,,Сәлем! Бұл өтірік емес пе!?
Dialogue: 0,0:02:41.91,0:02:44.95,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:03:53.41,0:03:55.12,Default,,0,0,0,,[Жүгірген аяқ дыбысы]
Dialogue: 0,0:03:56.62,0:04:00.08,Default,,0,0,0,,♬~
Dialogue: 0,0:04:00.12,0:04:05.79,Default,,0,0,0,,≪Бұл жігіт не өзі?!≫
Dialogue: 0,0:04:05.87,0:04:08.75,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:12.20,0:04:17.04,Default,,0,0,0,,[Желдің дыбысы]
Dialogue: 0,0:04:23.62,0:04:25.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:26.04,0:04:27.50,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:04:29.87,0:04:32.75,Default,,0,0,0,,Тамахи!!
Dialogue: 0,0:04:38.79,0:04:41.95,Default,,0,0,0,,Әй, бұл жер емес пе?
Dialogue: 0,0:04:43.12,0:04:44.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:46.00,0:04:49.45,Default,,0,0,0,,Қараңыз, «Калаби-Яу Гап»
Dialogue: 0,0:04:50.83,0:04:53.29,Default,,0,0,0,,Қараби... Бұл не?
Dialogue: 0,0:04:54.95,0:04:57.75,Default,,0,0,0,,Ол жай ғана жоғалады.
Dialogue: 0,0:04:57.83,0:05:00.79,Default,,0,0,0,,Және ешқашан қайтып келме
Dialogue: 0,0:05:02.16,0:05:05.79,Default,,0,0,0,,Осы қаладағы бір мекемеде эксперимент сәтсіз аяқталды.
Dialogue: 0,0:05:05.87,0:05:08.29,Default,,0,0,0,,Міне, осындай жер туған.
Dialogue: 0,0:05:10.95,0:05:13.83,Default,,0,0,0,,Тағы да, мұндай нысан қайда?
Dialogue: 0,0:05:13.91,0:05:15.41,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:05:16.00,0:05:17.50,Default,,0,0,0,,Біздің дүниеге келуіміз
Dialogue: 0,0:05:17.58,0:05:20.08,Default,,0,0,0,,Баяғыда сияқты.
Dialogue: 0,0:05:22.37,0:05:23.75,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:38.66,0:05:39.50,Default,,0,0,0,,Тамахи…
Dialogue: 0,0:05:39.58,0:05:40.66,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:42.70,0:05:43.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:45.41,0:05:46.75,Default,,0,0,0,,Га
Dialogue: 0,0:05:46.87,0:05:50.87,Default,,0,0,0,,[Болат жақтаудың сықырлаған дыбысы]
Dialogue: 0,0:05:56.87,0:05:59.20,Default,,0,0,0,,Ах... Юу Аки
Dialogue: 0,0:06:03.37,0:06:05.16,Default,,0,0,0,,[Құлағандай естіледі] Эй!
Dialogue: 0,0:06:08.87,0:06:13.91,Default,,0,0,0,,(дірілдеп тыныс алу)
Dialogue: 0,0:06:18.00,0:06:22.37,Default,,0,0,0,,[Смартфонның діріл дыбысы]
Dialogue: 0,0:06:22.45,0:06:24.12,Default,,0,0,0,,Ааа
Dialogue: 0,0:06:24.20,0:06:26.04,Default,,0,0,0,,Ах
Dialogue: 0,0:06:26.12,0:06:27.29,Default,,0,0,0,,Ах... [смартфонның құлаған дыбысы]
Dialogue: 0,0:06:31.58,0:06:33.70,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:06:36.58,0:06:37.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:38.16,0:06:39.25,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:39.33,0:06:41.54,Default,,0,0,0,,Хмм... хмм?
Dialogue: 0,0:06:43.75,0:06:45.54,Default,,0,0,0,,[Велосипедтің құлаған дыбысы] (Юу) Ха!
Dialogue: 0,0:06:47.00,0:06:50.20,Default,,0,0,0,,[Болат жақтаудың сықырлаған дыбысы]
Dialogue: 0,0:06:51.50,0:06:55.20,Default,,0,0,0,,(Юудың дірілдеп тыныс алуы)
Dialogue: 0,0:06:58.87,0:07:00.29,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:03.58,0:07:05.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:05.50,0:07:06.66,Default,,0,0,0,,Не...?
Dialogue: 0,0:07:09.04,0:07:13.25,Default,,0,0,0,,(Акидің дірілдеп тыныс алуы)
Dialogue: 0,0:07:13.75,0:07:17.25,Default,,0,0,0,,(Екі адамның дірілдеген тынысы)
Dialogue: 0,0:07:19.41,0:07:22.20,Default,,0,0,0,,(қорқынышты айқай)
Dialogue: 0,0:07:29.62,0:07:42.95,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:07:43.04,0:07:48.12,Default,,0,0,0,,(Юудың қорқып тыныс алуы)
Dialogue: 0,0:07:51.54,0:07:52.62,Default,,0,0,0,,[Тесілу дыбысы]
Dialogue: 0,0:07:52.70,0:07:54.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:04.41,0:08:06.00,Default,,0,0,0,,[Қанның шашыраған дыбысы] Ха!
Dialogue: 0,0:08:08.58,0:08:09.58,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:10.25,0:08:12.66,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:08:24.62,0:08:26.25,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:29.00,0:08:30.04,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:34.29,0:08:35.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:36.04,0:08:37.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:38.95,0:08:40.08,Default,,0,0,0,,Әй!
Dialogue: 0,0:08:43.00,0:08:45.29,Default,,0,0,0,,(дірілдеп тыныс алу)
Dialogue: 0,0:08:53.79,0:08:54.91,Default,,0,0,0,,Әй!
Dialogue: 0,0:08:55.37,0:08:56.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:00.79,0:09:05.25,Default,,0,0,0,,Ах! А... аа!
Dialogue: 0,0:09:17.20,0:09:19.41,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:09:21.87,0:09:24.41,Default,,0,0,0,,[Есіктің ашылған дыбысы] Ха!
Dialogue: 0,0:09:29.20,0:09:33.12,Default,,0,0,0,,[Желдің дыбысы]
Dialogue: 0,0:09:34.70,0:09:46.00,Default,,0,0,0,,♪
Dialogue: 0,0:09:46.91,0:09:49.37,Default,,0,0,0,,[Бос консервілердің домалап жатқан дыбысы]
Dialogue: 0,0:09:56.83,0:10:01.33,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:10:06.45,0:10:09.62,Default,,0,0,0,,[Дененің сықырлаған дыбысы]
Dialogue: 0,0:10:09.70,0:10:12.12,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:10:21.45,0:10:22.66,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:22.75,0:10:25.25,Default,,0,0,0,,О... жоқ...
Dialogue: 0,0:10:30.33,0:10:31.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:39.95,0:10:40.95,Default,,0,0,0,,Хмм
Dialogue: 0,0:10:41.04,0:10:44.58,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:10:59.87,0:11:03.54,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:11:03.62,0:11:05.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:05.75,0:11:07.20,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:07.29,0:11:08.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:10.00,0:11:15.00,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:11:15.75,0:11:20.95,Default,,0,0,0,,(Қорыққан сал тынысы)
Dialogue: 0,0:11:29.12,0:11:32.41,Default,,0,0,0,,Тамахи… Тамахи!
Dialogue: 0,0:11:32.50,0:11:34.45,Default,,0,0,0,,Сәлем Тамахи!
Dialogue: 0,0:11:35.29,0:11:38.41,Default,,0,0,0,,Тамахиттеба! Эй, эй!
Dialogue: 0,0:11:41.29,0:11:44.95,Default,,0,0,0,,≪Бұл жігіт не өзі?!≫
Dialogue: 0,0:11:45.62,0:11:47.12,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:49.29,0:11:53.83,Default,,0,0,0,,♬~
Dialogue: 0,0:11:59.45,0:12:02.20,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:12:04.16,0:12:05.41,Default,,0,0,0,,Тамахи?
Dialogue: 0,0:12:08.08,0:12:09.70,Default,,0,0,0,,«Ұшырып жібереді» дегенде, ол ауада ұша ма?
Dialogue: 0,0:12:10.33,0:12:12.58,Default,,0,0,0,,Рагудан басқа да тағамдарды мүмкіндігінше тезірек жақсы пісіре білгім келеді.
Dialogue: 0,0:12:12.66,0:12:14.29,Default,,0,0,0,,♬~
Dialogue: 0,0:12:14.37,0:12:16.41,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:12:16.50,0:12:18.75,Default,,0,0,0,,Юу гаа!
Dialogue: 0,0:12:18.83,0:12:23.25,Default,,0,0,0,,Юу бұл... Юу!
Dialogue: 0,0:12:23.62,0:12:29.54,Default,,0,0,0,,(жылаған дауыс)
Dialogue: 0,0:12:33.04,0:12:34.41,Default,,0,0,0,,Неге...
Dialogue: 0,0:12:35.79,0:12:37.54,Default,,0,0,0,,Бұл неге...
Dialogue: 0,0:12:43.29,0:12:44.29,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:44.87,0:12:48.50,Default,,0,0,0,,(Тамахидің ауыр тыныс алуы)
Dialogue: 0,0:12:56.33,0:13:02.37,Default,,0,0,0,,[Болат жақтаудың сықырлаған дыбысы]
Dialogue: 0,0:13:14.75,0:13:15.83,Default,,0,0,0,,Ха...
Dialogue: 0,0:13:30.37,0:13:32.70,Default,,0,0,0,,[Су дыбысы]
Dialogue: 0,0:13:41.87,0:13:43.87,Default,,0,0,0,,[Rusty…]
Dialogue: 0,0:13:50.75,0:13:54.91,Default,,0,0,0,,[Болат жақтаудың сықырлаған дыбысы]
Dialogue: 0,0:14:07.62,0:14:08.58,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:09.58,0:14:10.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:18.95,0:14:21.16,Default,,0,0,0,,[Есікті қағу дыбысы]
Dialogue: 0,0:14:21.25,0:14:22.83,Default,,0,0,0,,[Есік тұтқасының айналу дыбысы]
Dialogue: 0,0:14:24.66,0:14:26.12,Default,,0,0,0,,[Есікті қағу дыбысы]
Dialogue: 0,0:14:28.04,0:14:29.45,Default,,0,0,0,,[Есікті қағу дыбысы]
Dialogue: 0,0:14:30.45,0:14:35.62,Default,,0,0,0,,[Тоққыл дыбыс]
Dialogue: 0,0:14:36.33,0:14:38.20,Default,,0,0,0,,Бұл Юу емес еді
Dialogue: 0,0:14:40.58,0:14:42.83,Default,,0,0,0,,Юудың тереңінде бірдеңе...
Dialogue: 0,0:14:46.54,0:14:48.95,Default,,0,0,0,,Бұл адамдардың естеліктерін алып тастайды.
Dialogue: 0,0:14:49.04,0:14:52.87,Default,,0,0,0,,Басыңыздың ішіне кіріп, көрген-білгеніңізді есте сақтаңыз.
Dialogue: 0,0:14:53.66,0:14:55.12,Default,,0,0,0,,Тамахи
Dialogue: 0,0:14:55.20,0:14:57.50,Default,,0,0,0,,Юу енді бұл жерде жоқ.
Dialogue: 0,0:14:57.58,0:14:59.75,Default,,0,0,0,,Осылай қалсақ...
Dialogue: 0,0:15:04.08,0:15:05.58,Default,,0,0,0,,[Есік жабылған дыбыс]
Dialogue: 0,0:15:05.66,0:15:07.08,Default,,0,0,0,,Ах
Dialogue: 0,0:15:11.20,0:15:13.29,Default,,0,0,0,,[Қатты шу]
Dialogue: 0,0:15:29.62,0:15:31.08,Default,,0,0,0,,[Ажыратқышты басу дыбысы]
Dialogue: 0,0:15:32.79,0:15:34.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:18.70,0:16:19.70,Default,,0,0,0,,[шарылдаған шу]
Dialogue: 0,0:16:19.79,0:16:20.83,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:24.29,0:16:27.33,Default,,0,0,0,,[Қораптың ішіндегі діріл дыбысы]
Dialogue: 0,0:16:32.25,0:16:36.66,Default,,0,0,0,,[Найзағай]
Dialogue: 0,0:16:46.45,0:16:50.87,Default,,0,0,0,,(жылаған дауыс)
Dialogue: 0,0:16:52.95,0:16:55.95,Default,,0,0,0,,[Жаңбыр дыбысы]
Dialogue: 0,0:16:57.00,0:17:01.45,Default,,0,0,0,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:17:11.16,0:17:15.16,Default,,0,0,0,,[Найзағай]
Dialogue: 0,0:17:15.66,0:17:19.08,Default,,0,0,0,,[Үздіксіз жауынның дыбысы]
Dialogue: 0,0:17:30.58,0:17:31.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:36.54,0:17:38.75,Default,,0,0,0,,[Жақсы... дыбыс] Иә?
