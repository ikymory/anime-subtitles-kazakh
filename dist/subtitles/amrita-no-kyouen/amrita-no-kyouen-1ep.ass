Dialogue: 0,0:33:24.75,0:33:27.41,Default,,0,0,0,,Жоқ, дәл осының алдында.
Dialogue: 0,0:33:33.79,0:33:37.75,Default,,0,0,0,,Аз ғана... бірақ...
Dialogue: 0,0:33:37.83,0:33:39.08,Default,,0,0,0,,Б-бірақ егер бұл орын түсіп қалса…
Dialogue: 0,0:33:41.37,0:33:43.00,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:33:45.66,0:33:48.33,Default,,0,0,0,,Ха! өзгерте алады
Dialogue: 0,0:33:52.20,0:33:53.62,Default,,0,0,0,,мүмкін...
Dialogue: 0,0:33:56.95,0:33:58.58,Default,,0,0,0,,Өзгертуге болады
Dialogue: 0,0:33:58.66,0:34:00.25,Default,,0,0,0,,Б-бірақ егер бұл орын түсіп қалса…
Dialogue: 0,0:34:17.00,0:34:20.33,Default,,0,0,0,,Сіз өзгерте аласыз... сәл ғана...
Dialogue: 0,0:34:21.83,0:34:24.62,Default,,0,0,0,,Жоқ, мен жай ғана... жасадым...
Dialogue: 0,0:34:26.33,0:34:28.25,Default,,0,0,0,,... заттарды өзгерту
Dialogue: 0,0:34:37.12,0:34:38.08,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:34:42.16,0:34:43.45,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:34:45.41,0:34:47.37,Default,,0,0,0,,Өзгертуге болады
Dialogue: 0,0:34:47.45,0:34:49.41,Default,,0,0,0,,Біртіндеп
Dialogue: 0,0:34:50.29,0:34:52.62,Default,,0,0,0,,Бұл дүниеде аз ғана
Dialogue: 0,0:34:52.70,0:34:54.50,Default,,0,0,0,,Аз ғана болса жеткілікті
Dialogue: 0,0:34:54.58,0:34:56.00,Default,,0,0,0,,бір нәрсені өзгерту
Dialogue: 0,0:34:56.37,0:34:57.91,Default,,0,0,0,,Менің қолымнан келмесе де
Dialogue: 0,0:34:58.00,0:35:00.29,Default,,0,0,0,,Тіпті келесі дүниеде мүмкін емес болса да
Dialogue: 0,0:35:00.37,0:35:04.08,Default,,0,0,0,,Мыңдаған немесе он мыңдаған, мен сенімдімін!
Dialogue: 0,0:35:08.58,0:35:10.16,Default,,0,0,0,,Барлығы көмектесетініне сенімдімін!
Dialogue: 0,0:35:15.91,0:35:18.41,Default,,0,0,0,,[Жақындау]
Dialogue: 0,0:35:20.37,0:35:21.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:35:21.29,0:35:24.00,Default,,0,0,0,,Ол қайтадан жұмыс істемеді.
Dialogue: 0,0:35:24.66,0:35:25.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:35:42.29,0:35:43.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:35:45.66,0:35:46.70,Default,,0,0,0,,Хмм
Dialogue: 0,0:35:47.91,0:35:49.87,Default,,0,0,0,,[Жел дыбысы]
Dialogue: 0,0:35:49.95,0:35:52.25,Default,,0,0,0,,[Бірінен соң бірі құлау дыбысы]
Dialogue: 0,0:35:57.37,0:36:00.83,Default,,0,0,0,,Тамахи, енді тоқтайық.
Dialogue: 0,0:36:00.91,0:36:02.33,Default,,0,0,0,,Келме!
Dialogue: 0,0:36:02.87,0:36:04.79,Default,,0,0,0,,Аки емес
Dialogue: 0,0:36:04.87,0:36:06.66,Default,,0,0,0,,Сіз Аки емессіз!
Dialogue: 0,0:36:08.16,0:36:09.70,Default,,0,0,0,,Манга салмас бұрын жаттығулар
Dialogue: 0,0:36:10.91,0:36:12.83,Default,,0,0,0,,Біз қазірдің өзінде...
Dialogue: 0,0:36:15.62,0:36:17.50,Default,,0,0,0,,Біз емес
Dialogue: 0,0:36:19.45,0:36:21.50,Default,,0,0,0,,Бірақ егер біз бір боламыз
Dialogue: 0,0:36:22.25,0:36:24.20,Default,,0,0,0,,Мен осылай өмір сүре аламын.
Dialogue: 0,0:36:25.04,0:36:26.62,Default,,0,0,0,,Оны қабылдаңыз.
Dialogue: 0,0:36:27.70,0:36:28.66,Default,,0,0,0,,Ха...
Dialogue: 0,0:36:29.91,0:36:32.29,Default,,0,0,0,,(Тамахидің дауысы)
Dialogue: 0,0:36:33.79,0:36:34.79,Default,,0,0,0,,[Қанның шашырауының дыбысы]
Dialogue: 0,0:36:43.50,0:36:46.00,Default,,0,0,0,,Нәтижелер туралы не деуге болады?
Dialogue: 0,0:36:47.37,0:36:48.50,Default,,0,0,0,,Ха!
Dialogue: 0,0:36:49.41,0:36:52.87,Default,,0,0,0,,(дірілдеп тыныс алу)
Dialogue: 0,0:36:54.16,0:36:57.04,Default,,0,0,0,,Оны тағы неше рет қайталау керек?
Dialogue: 0,0:37:01.45,0:37:02.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:37:03.41,0:37:04.58,Default,,0,0,0,,Не? Ит пе?
Dialogue: 0,0:37:06.54,0:37:11.41,Default,,0,0,0,,(Тамахидің дірілдеп тыныс алуы)
Dialogue: 0,0:37:14.08,0:37:17.41,Default,,0,0,0,,Тамахи, мұндай қорқынышты бет жасама.
Dialogue: 0,0:37:18.62,0:37:21.00,Default,,0,0,0,,Қайтайық, үшеуміз тағы.
Dialogue: 0,0:37:22.16,0:37:24.50,Default,,0,0,0,,Бұл арқылы өту керек пе?
Dialogue: 0,0:37:25.54,0:37:27.75,Default,,0,0,0,,Неліктен біз?
Dialogue: 0,0:37:30.16,0:37:31.79,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:37:32.37,0:37:37.20,Default,,0,0,0,,Қараңдар! Шығу ашық, бірақ сіз кетпейсіз
Dialogue: 0,0:37:38.45,0:37:40.16,Default,,0,0,0,,Мен шыға алмаймын!
Dialogue: 0,0:37:40.25,0:37:43.79,Default,,0,0,0,,Егер біз осы дүниеде өмір сүріп жатқан адамдарды пайдаланбасақ
Dialogue: 0,0:37:44.50,0:37:45.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:37:50.66,0:37:51.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:37:51.91,0:37:53.50,Default,,0,0,0,,А...
Dialogue: 0,0:37:55.08,0:37:57.33,Default,,0,0,0,,Мен сені сыртқа шығармаймын.
Dialogue: 0,0:37:58.79,0:38:01.25,Default,,0,0,0,,Аки мен Юу міндетті түрде көмектеседі!
Dialogue: 0,0:38:03.62,0:38:06.50,Default,,0,0,0,,Екеуі бірге
Dialogue: 0,0:38:06.58,0:38:08.91,Default,,0,0,0,,Мен оны жүзеге асыра алмаймын, Тамахи
Dialogue: 0,0:38:11.04,0:38:13.12,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:38:23.37,0:38:26.54,Default,,0,0,0,,Хехе, жарайды, кеттік, соңғы нүкте.
Dialogue: 0,0:38:26.87,0:38:29.45,Default,,0,0,0,,Соңғы кездері мен өте бос емеспін.
Dialogue: 0,0:38:29.54,0:38:31.58,Default,,0,0,0,,Бұл уақыт маңызды емес пе?
Dialogue: 0,0:38:31.66,0:38:32.79,Default,,0,0,0,,Хе хехе
Dialogue: 0,0:38:32.87,0:38:34.20,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:38:36.04,0:38:38.75,Default,,0,0,0,,Қазірден бастап, оқу бітіргенге дейін
Dialogue: 0,0:38:38.83,0:38:41.50,Default,,0,0,0,,Осындай нәрсені тағы қанша рет жасауға болады?
Dialogue: 0,0:38:41.58,0:38:43.20,Default,,0,0,0,,Осылайша үшеуміз
Dialogue: 0,0:38:52.37,0:38:54.66,Default,,0,0,0,,Тек сауда үшін билет
Dialogue: 0,0:38:54.75,0:38:57.20,Default,,0,0,0,,Киімге деген талғамың - Сайаку.
Dialogue: 0,0:38:57.29,0:38:59.37,Default,,0,0,0,,Міне сондықтан қарапайым адамдар
Dialogue: 0,0:38:59.62,0:39:01.12,Default,,0,0,0,,Бо…
Dialogue: 0,0:39:01.20,0:39:03.79,Default,,0,0,0,,Хехе... Ахаха!
Dialogue: 0,0:39:03.87,0:39:05.20,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:39:06.16,0:39:08.20,Default,,0,0,0,,Тым көп күлу
Dialogue: 0,0:39:08.29,0:39:11.45,Default,,0,0,0,,(3 адам күледі)
Dialogue: 0,0:39:11.54,0:39:17.37,Default,,0,0,0,,(Тамахидің күлкісі)
Dialogue: 0,0:39:18.08,0:39:19.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:20.87,0:39:22.83,Default,,0,0,0,,Тамахи таңдайды
Dialogue: 0,0:39:23.75,0:39:26.08,Default,,0,0,0,,Барлығын аяқтаңыз
Dialogue: 0,0:39:30.41,0:39:32.62,Default,,0,0,0,,Тамахи Таңдаңыз... Соңы...
Dialogue: 0,0:39:32.70,0:39:35.00,Default,,0,0,0,,Тамахи Тамахи... Таңдаңыз! Тамахи…
Dialogue: 0,0:39:35.08,0:39:37.75,Default,,0,0,0,,Таңдау, таңдау, таңдау...
Dialogue: 0,0:39:37.83,0:39:41.20,Default,,0,0,0,,Эй Тамахи, таңда... Тамахи, таңда...
Dialogue: 0,0:39:41.29,0:39:43.50,Default,,0,0,0,,Тамахи Аяқтаңыз... Таңдаңыз...
Dialogue: 0,0:39:43.58,0:39:45.91,Default,,0,0,0,,Барлығын таңдау...
Dialogue: 0,0:39:46.50,0:39:48.87,Default,,0,0,0,,бітсін, бітсін... бітсін...
Dialogue: 0,0:39:59.70,0:40:01.16,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:40:01.45,0:40:02.58,Default,,0,0,0,,Хмм
Dialogue: 0,0:40:02.66,0:40:05.66,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:40:09.58,0:40:11.08,Default,,0,0,0,,Хмм... Уф
Dialogue: 0,0:40:12.04,0:40:13.04,Default,,0,0,0,,Ха!
Dialogue: 0,0:40:14.58,0:40:16.50,Default,,0,0,0,,Хмм... мм!
Dialogue: 0,0:40:16.91,0:40:18.33,Default,,0,0,0,,Әй!
Dialogue: 0,0:40:18.41,0:40:19.50,Default,,0,0,0,,Уф!!
Dialogue: 0,0:40:37.54,0:40:39.50,Default,,0,0,0,,[Крекинг дыбысы]
Dialogue: 0,0:40:40.75,0:41:06.41,Default,,0,0,0,,♪
Dialogue: 0,0:41:08.45,0:41:18.70,Default,,0,0,0,,♪
Dialogue: 0,0:41:21.91,0:41:46.04,Default,,0,0,0,,[Өткір гүрілдеу]
Dialogue: 0,0:41:46.12,0:42:00.08,Default,,0,0,0,,[жалғасатын айқай]
Dialogue: 0,0:42:10.37,0:42:13.79,Default,,0,0,0,,[Желдің дыбысы]
Dialogue: 0,0:42:31.95,0:42:34.95,Default,,0,0,0,,[Пойыздың жүгіру дыбысы]
Dialogue: 0,0:42:37.20,0:42:40.20,Default,,0,0,0,,(Ю Тамахитоның күлкісі)
Dialogue: 0,0:42:41.62,0:42:43.33,Default,,0,0,0,,Тым көп күлу
Dialogue: 0,0:42:43.95,0:42:50.66,Default,,0,0,0,,(3 адам күледі)
Dialogue: 0,0:42:54.45,0:42:57.37,Default,,0,0,0,,(Тамахидің дауысы)
Dialogue: 0,0:43:05.54,0:43:28.41,Default,,0,0,0,,♪
Dialogue: 0,0:43:38.62,0:43:42.29,Default,,0,0,0,,[Зауыт жұмысының дыбыстары]
Dialogue: 0,0:43:46.79,0:43:50.20,Default,,0,0,0,,[Өтіп бара жатқан көліктердің дыбысы]
Dialogue: 0,0:44:02.41,0:44:04.58,Default,,0,0,0,,Бұл арзан ба?
Dialogue: 0,0:44:05.04,0:44:08.08,Default,,0,0,0,,Оңтүстікке қарайды, ванна мен дәретхана бөлек, кең қонақ бөлмесі
Dialogue: 0,0:44:09.50,0:44:12.04,Default,,0,0,0,,Уау, бөлмең әдемі екен!
Dialogue: 0,0:44:12.12,0:44:14.70,Default,,0,0,0,,Мен осындай нәрсені аңсаймын.
Dialogue: 0,0:44:15.00,0:44:17.33,Default,,0,0,0,,Не? Алдын ала қарау мүмкін емес пе?
Dialogue: 0,0:44:17.41,0:44:19.66,Default,,0,0,0,,Бұл солай ма?
Dialogue: 0,0:44:20.29,0:44:21.66,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:44:21.75,0:44:23.58,Default,,0,0,0,,Иә, әрине
Dialogue: 0,0:44:24.41,0:44:26.79,Default,,0,0,0,,Хмм...
Dialogue: 0,0:44:28.20,0:44:31.70,Default,,0,0,0,,Иә, мен мұнда келуді шештім!
Dialogue: 0,0:44:32.70,0:44:34.04,Default,,0,0,0,,Хехе
Dialogue: 0,0:44:40.66,0:44:43.50,Default,,0,0,0,,♪ Қайғылы көрінетін сөздер
Dialogue: 0,0:44:43.58,0:44:46.75,Default,,0,0,0,,♪ Мені қалай қабылдайды?
Dialogue: 0,0:44:46.83,0:44:50.45,Default,,0,0,0,,♪ Мені мазақ еткендей болдым.
Dialogue: 0,0:44:50.54,0:45:04.58,Default,,0,0,0,,♪
Dialogue: 0,0:45:04.66,0:45:07.58,Default,,0,0,0,,♪ Монохроматикалық жалғыздыққа қызығады
Dialogue: 0,0:45:07.66,0:45:10.58,Default,,0,0,0,,♪ Әр адам мағынаны түнде іздейді
Dialogue: 0,0:45:10.66,0:45:13.91,Default,,0,0,0,,♪ Тек алдыңғы жағы тозған.
Dialogue: 0,0:45:14.00,0:45:20.29,Default,,0,0,0,,♪ Бастапқы екпіннің әбігері, жаңғырығы мен әуені
Dialogue: 0,0:45:20.37,0:45:22.62,Default,,0,0,0,,♪ Екеуміз араласайық
Dialogue: 0,0:45:22.70,0:45:28.20,Default,,0,0,0,,♪ Шағым, езілген жүрегім!
Dialogue: 0,0:45:28.29,0:45:31.25,Default,,0,0,0,,♪ Орынбасар ретінде кез келген адам әрекет ете алады.
Dialogue: 0,0:45:31.33,0:45:34.04,Default,,0,0,0,,♪ Сен мен үшін жалғыз басты кейіпкерсің
Dialogue: 0,0:45:34.12,0:45:37.95,Default,,0,0,0,,♪ Осы «өмір теориясына» байланыңыз
Dialogue: 0,0:45:38.04,0:45:40.25,Default,,0,0,0,,♪ Мен дем алып жаттым
Dialogue: 0,0:45:40.33,0:45:43.20,Default,,0,0,0,,♪ Көңілсіз күндерді басынан өткерудің мәні
Dialogue: 0,0:45:43.29,0:45:46.25,Default,,0,0,0,,♪ Сөзбен өре алмаймын
Dialogue: 0,0:45:46.33,0:45:49.58,Default,,0,0,0,,♪ Бірде ішіңе сіңген ойға кептеліп кетесің
Dialogue: 0,0:45:49.66,0:45:53.75,Default,,0,0,0,,♪ Ол үшін де, бәрі де бітті.
Dialogue: 0,0:45:53.83,0:46:04.54,Default,,0,0,0,,♪
Dialogue: 0,0:46:04.62,0:46:07.58,Default,,0,0,0,,♪ Есептегіштің жүрек соғысын тыңдау
Dialogue: 0,0:46:07.66,0:46:10.50,Default,,0,0,0,,♪ Егер мен басқа біреудің мәселесі болсам
Dialogue: 0,0:46:10.58,0:46:13.91,Default,,0,0,0,,♪ Мен бұл туралы ойладым.
Dialogue: 0,0:46:14.00,0:46:20.33,Default,,0,0,0,,♪ Алдасу, кейін жұмаққа айналу
Dialogue: 0,0:46:20.41,0:46:22.62,Default,,0,0,0,,♪ Мен оны толық түсінемін.
Dialogue: 0,0:46:22.70,0:46:28.20,Default,,0,0,0,,♪ Өзін-өзі байлау Менің эмоциялық соңғы тарауым!
Dialogue: 0,0:46:28.29,0:46:31.25,Default,,0,0,0,,♪ Орынбасар ретінде кез келген адам әрекет ете алады.
Dialogue: 0,0:46:31.33,0:46:34.04,Default,,0,0,0,,♪ Сен менің жалғыз басты кейіпкерімсің
Dialogue: 0,0:46:34.12,0:46:37.95,Default,,0,0,0,,♪ Осы «пессимистік көзқарасқа» байланайық
Dialogue: 0,0:46:38.04,0:46:40.20,Default,,0,0,0,,♪ Мен дем алып жаттым
Dialogue: 0,0:46:40.29,0:46:43.20,Default,,0,0,0,,♪ Көңілсіз күндерді бастан өткерудің мәні
Dialogue: 0,0:46:43.29,0:46:46.20,Default,,0,0,0,,♪ Сөзбен өре алмаймын
Dialogue: 0,0:46:46.29,0:46:51.12,Default,,0,0,0,,♪ Мен өзімді жек көрдім.
Dialogue: 0,0:46:51.20,0:47:10.12,Default,,0,0,0,,♪
Dialogue: 0,0:47:10.20,0:47:13.20,Default,,0,0,0,,♪ Орынбасар ретінде кез келген адам әрекет ете алады.
Dialogue: 0,0:47:13.29,0:47:16.00,Default,,0,0,0,,♪ Сен менің жалғыз басты кейіпкерімсің
Dialogue: 0,0:47:16.08,0:47:20.00,Default,,0,0,0,,♪ Осы «өмір теориясына» байланыңыз
Dialogue: 0,0:47:20.08,0:47:22.25,Default,,0,0,0,,♪ Мен дем алып отырдым.
Dialogue: 0,0:47:22.33,0:47:25.20,Default,,0,0,0,,♪ Көңілсіз күндерді басынан өткерудің мәні
Dialogue: 0,0:47:25.29,0:47:28.25,Default,,0,0,0,,♪ Сөзбен өре алмаймын
Dialogue: 0,0:47:28.33,0:47:31.54,Default,,0,0,0,,♪ Бірде ішіңе сіңген ойға кептеліп кетесің
