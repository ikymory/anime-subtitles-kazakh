Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.55,0:00:20.56,Default,,0,0,0,,♪～
Dialogue: 0,0:00:21.81,0:00:23.85,Default,,0,0,0,,♪ Аяпа!
Dialogue: 0,0:00:24.73,0:00:26.98,Default,,0,0,0,,(Қонақтардың қуаныш дауыстары)
Dialogue: 0,0:00:33.70,0:00:35.74,Default,,0,0,0,,Маусым жақсы ма? Қабан
Dialogue: 0,0:00:35.82,0:00:37.78,Default,,0,0,0,,Өте жақсы!
Dialogue: 0,0:00:37.87,0:00:39.58,Default,,0,0,0,,Түтін басталады!
Dialogue: 0,0:00:39.66,0:00:41.41,Default,,0,0,0,,Есік ашық!
Dialogue: 0,0:00:43.41,0:00:45.25,Default,,0,0,0,,О! Бұл келді! Бұл келді!
Dialogue: 0,0:00:46.33,0:00:47.38,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:00:47.46,0:00:48.33,Default,,0,0,0,,Нихи
Dialogue: 0,0:00:49.63,0:00:51.84,Default,,0,0,0,,Жоқ~ Ахахха!
Dialogue: 0,0:00:51.92,0:00:53.88,Default,,0,0,0,,Мен қатты ұялдым~ хаха
Dialogue: 0,0:00:54.05,0:00:55.84,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:00:55.93,0:00:57.26,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:00:59.85,0:01:01.81,Default,,0,0,0,,Ах~ Бүгінге дейін екеуің
Dialogue: 0,0:01:01.89,0:01:04.48,Default,,0,0,0,,Мен әртүрлі әуендерді үйрендім.
Dialogue: 0,0:01:05.06,0:01:07.73,Default,,0,0,0,,Бірақ бүгіннен бастап екеуің бірге боласыңдар.
Dialogue: 0,0:01:07.85,0:01:10.52,Default,,0,0,0,,Біз махаббат үйлесімділігін жасауға ұмтыламыз.
Dialogue: 0,0:01:10.61,0:01:12.15,Default,,0,0,0,,Ах~ Әке, ана...
Dialogue: 0,0:01:12.23,0:01:13.99,Default,,0,0,0,,Мүмкін ол сәйкес келмейтін шығар?
Dialogue: 0,0:01:14.07,0:01:16.74,Default,,0,0,0,,Мен мұндай нәрсені жақсы көремін, сондықтан оған көмектесу мүмкін емес.
Dialogue: 0,0:01:16.82,0:01:19.28,Default,,0,0,0,,Ах! Бұл өте кішкентай болса да!
Dialogue: 0,0:01:19.37,0:01:21.24,Default,,0,0,0,,Сен мұғалімнің баласы емессің ғой?
Dialogue: 0,0:01:24.87,0:01:25.71,Default,,0,0,0,,Нихихихихи
Dialogue: 0,0:01:26.12,0:01:28.17,Default,,0,0,0,,Ахаха, бәрі.
Dialogue: 0,0:01:28.25,0:01:30.38,Default,,0,0,0,,Оширо мен Охиме-саманы алу үшін
Dialogue: 0,0:01:30.46,0:01:33.17,Default,,0,0,0,,Мен көптен бері саяхаттап жүрмін.
Dialogue: 0,0:01:33.63,0:01:36.09,Default,,0,0,0,,Бұл жолы мен сондай әдемі жүзге ие болдым.
Dialogue: 0,0:01:36.17,0:01:40.39,Default,,0,0,0,,Мен мына сүйкімді ханшайыммен төбелесемін!
Dialogue: 0,0:01:40.47,0:01:42.76,Default,,0,0,0,,Барабан таяқшасы Сіз жеңесіз! Йо! Ол қиын!
Dialogue: 0,0:01:42.85,0:01:45.48,Default,,0,0,0,,Бақытқа толы
Dialogue: 0,0:01:45.56,0:01:49.81,Default,,0,0,0,,Хахаха менің арманым орындалды!
Dialogue: 0,0:01:51.06,0:01:53.36,Default,,0,0,0,,Бұл енді ғана басталды, бірақ мен оны енді істей алмаймын.
Dialogue: 0,0:01:53.44,0:01:55.03,Default,,0,0,0,,Бұл эссе осы жерде аяқталады.
Dialogue: 0,0:01:55.15,0:01:55.99,Default,,0,0,0,,Э~?
Dialogue: 0,0:01:56.19,0:01:57.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:57.24,0:01:59.11,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:59.49,0:02:09.04,Default,,0,0,0,,♪～
Dialogue: 0,0:02:10.08,0:02:11.88,Default,,0,0,0,,О, өте жаман.
Dialogue: 0,0:02:11.96,0:02:14.96,Default,,0,0,0,,Негізгі оқиға әлі алда еді.
Dialogue: 0,0:02:15.21,0:02:17.76,Default,,0,0,0,,Оны бәрі де көргісі келеді, солай ма? Бұл Кероро ма?
Dialogue: 0,0:02:17.84,0:02:19.18,Default,,0,0,0,,Басқаша болар еді!
Dialogue: 0,0:02:19.63,0:02:21.43,Default,,0,0,0,,Чикай жоқ…
Dialogue: 0,0:02:22.05,0:02:24.35,Default,,0,0,0,,Шайнаңыз! (Охиме-сама) Кьяан
Dialogue: 0,0:02:24.43,0:02:27.18,Default,,0,0,0,,«Кяан» өте сүйкімді хахахаха!
Dialogue: 0,0:02:28.02,0:02:30.19,Default,,0,0,0,,Енді орындайық.
Dialogue: 0,0:02:31.40,0:02:32.31,Default,,0,0,0,,Оған
Dialogue: 0,0:02:33.44,0:02:37.78,Default,,0,0,0,,Мммм, мммм!
Dialogue: 0,0:02:37.86,0:02:39.53,Default,,0,0,0,,Ой... Кешіріңіз!
Dialogue: 0,0:02:39.70,0:02:40.74,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:02:41.87,0:02:43.87,Default,,0,0,0,,Сәлем! Жақсы жер болды!
Dialogue: 0,0:02:43.95,0:02:45.08,Default,,0,0,0,,Ммм...
Dialogue: 0,0:02:45.16,0:02:46.95,Default,,0,0,0,,Не болды? Зорори мырза
Dialogue: 0,0:02:47.04,0:02:48.75,Default,,0,0,0,,Мен не істей аламын?
Dialogue: 0,0:02:49.33,0:02:51.33,Default,,0,0,0,,Маған шайнауды қайтарыңыз! Шайнаңыз!
Dialogue: 0,0:02:51.42,0:02:54.25,Default,,0,0,0,,Уау! Жоқ, жоқ, біртүрлі!
Dialogue: 0,0:02:54.79,0:02:56.21,Default,,0,0,0,,Хентай дегеніміз не?
Dialogue: 0,0:02:56.30,0:02:58.42,Default,,0,0,0,,Маңайдағы шайнау дегеніміз не?
Dialogue: 0,0:02:58.51,0:03:00.72,Default,,0,0,0,,Жоқ, бұл қиын!
Dialogue: 0,0:03:04.39,0:03:05.39,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:03:18.44,0:03:19.94,Default,,0,0,0,,Оның квиркі өте күшті, бірақ—
Dialogue: 0,0:03:21.07,0:03:23.16,Default,,0,0,0,,А, сен ертедегі баланы қуып келесің бе?
Dialogue: 0,0:03:25.33,0:03:26.33,Default,,0,0,0,,Ха ха…
Dialogue: 0,0:03:27.99,0:03:31.00,Default,,0,0,0,,Ах ха ха ха... Ах!
Dialogue: 0,0:03:33.46,0:03:35.13,Default,,0,0,0,,Ах! Алақай!
Dialogue: 0,0:03:40.01,0:03:40.84,Default,,0,0,0,,Мынау не? Менің Қорекқұмарлық Жаным (Шексіз Жұтым)
Dialogue: 0,0:03:41.30,0:03:43.38,Default,,0,0,0,,Әй балам, жараланып қалдың ба?
Dialogue: 0,0:03:43.47,0:03:44.51,Default,,0,0,0,,Қауіпті! Ах!
Dialogue: 0,0:03:44.59,0:03:45.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:48.89,0:03:51.73,Default,,0,0,0,,Зорори қайтадан пайда болады!
Dialogue: 0,0:03:52.81,0:03:55.69,Default,,0,0,0,,Менің жолыма қаншалықты кедергі жасайсың?
Dialogue: 0,0:03:56.11,0:03:57.40,Default,,0,0,0,,Жолбарыс!
Dialogue: 0,0:04:00.53,0:04:02.90,Default,,0,0,0,,Мен әлсіздерді қорлауға шыдамаймын.
Dialogue: 0,0:04:02.99,0:04:03.82,Default,,0,0,0,,Ммм...
Dialogue: 0,0:04:04.32,0:04:06.07,Default,,0,0,0,,Әлсіздер кімдер?
Dialogue: 0,0:04:06.49,0:04:07.91,Default,,0,0,0,,Не болды, кенет не болды?
Dialogue: 0,0:04:07.99,0:04:08.83,Default,,0,0,0,,Эй
Dialogue: 0,0:04:09.99,0:04:11.29,Default,,0,0,0,,Оның әлсіз жері жоқ! (Жолбарыс) Эй!
Dialogue: 0,0:04:11.37,0:04:12.21,Default,,0,0,0,,Маған көмектесіңізші
Dialogue: 0,0:04:12.41,0:04:13.75,Default,,0,0,0,,Эй, эй (Жолбарыс) Эй!
Dialogue: 0,0:04:14.33,0:04:16.13,Default,,0,0,0,,Әй, сен немен айналысып тұрсың!
Dialogue: 0,0:04:16.21,0:04:17.08,Default,,0,0,0,,'Егер мен Польнареффтің мұрнына саусағымды тығып қойсам ➡
Dialogue: 0,0:04:18.92,0:04:19.75,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:04:24.68,0:04:27.01,Default,,0,0,0,,Тори Каджи толы!
Dialogue: 0,0:04:27.35,0:04:28.47,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:04:30.14,0:04:32.85,Default,,0,0,0,,Жібер! Тіпті бір адам қашып құтыла алады, сондықтан қазір
Dialogue: 0,0:04:33.14,0:04:35.19,Default,,0,0,0,,Әй, тыныш бол!
Dialogue: 0,0:04:42.90,0:04:44.32,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:04:45.20,0:04:46.03,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:47.91,0:04:48.74,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:04:48.83,0:04:51.41,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:51.58,0:04:52.62,Default,,0,0,0,,Ишиши ношиши!
Dialogue: 0,0:04:52.91,0:04:54.00,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:04:54.33,0:04:55.16,Default,,0,0,0,,Даа!
Dialogue: 0,0:04:57.54,0:04:59.25,Default,,0,0,0,,Кеттік, Ношиши! Хмф
Dialogue: 0,0:04:59.34,0:05:00.30,Default,,0,0,0,,Міне!
Dialogue: 0,0:05:03.72,0:05:04.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:05.01,0:05:07.39,Default,,0,0,0,,Жүр! Зорориге онша сараң болма!
Dialogue: 0,0:05:07.68,0:05:10.31,Default,,0,0,0,,Эйхо Эйхо
Dialogue: 0,0:05:11.35,0:05:12.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:12.35,0:05:13.93,Default,,0,0,0,,Сәлеметсіз бе.
Dialogue: 0,0:05:14.02,0:05:15.56,Default,,0,0,0,,О, сен кімсің?
Dialogue: 0,0:05:15.77,0:05:18.81,Default,,0,0,0,,Жоқ, мен сөзге тұрарлық емеспін.
Dialogue: 0,0:05:18.90,0:05:20.57,Default,,0,0,0,,Шынымен, кешіріңізші.
Dialogue: 0,0:05:20.94,0:05:21.77,Default,,0,0,0,,Хогия
Dialogue: 0,0:05:25.11,0:05:26.74,Default,,0,0,0,,Уау, мен жасадым!
Dialogue: 0,0:05:27.16,0:05:29.24,Default,,0,0,0,,Не? Уф...
Dialogue: 0,0:05:29.49,0:05:30.87,Default,,0,0,0,,Ой, оны құлатып тастады
Dialogue: 0,0:05:30.95,0:05:32.58,Default,,0,0,0,,Бұл менің көзіме тиеді (минион)
Dialogue: 0,0:05:33.16,0:05:34.00,Default,,0,0,0,,Иә
Dialogue: 0,0:05:34.62,0:05:37.25,Default,,0,0,0,,Ухихихихихи Кешіріңіз
Dialogue: 0,0:05:37.46,0:05:38.29,Default,,0,0,0,,Пухаа~
Dialogue: 0,0:05:39.33,0:05:40.63,Default,,0,0,0,,Беріңіз... Ах~
Dialogue: 0,0:05:41.29,0:05:42.42,Default,,0,0,0,,Вахаха~
Dialogue: 0,0:05:42.71,0:05:45.59,Default,,0,0,0,,Хе хе хе хе хе хе хе хе хе хе хе хе хе хе хе хе хе
Dialogue: 0,0:05:45.84,0:05:47.84,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:05:50.09,0:05:51.64,Default,,0,0,0,,Зороли!
Dialogue: 0,0:05:56.48,0:05:58.90,Default,,0,0,0,,Анкерлік отты қабылдаңыз
Dialogue: 0,0:05:58.98,0:06:00.15,Default,,0,0,0,,Дәнекерлеуші!
Dialogue: 0,0:06:01.06,0:06:01.90,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:02.15,0:06:02.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:04.07,0:06:05.61,Default,,0,0,0,,Уау! Апыр-ай! Ахх
Dialogue: 0,0:06:05.86,0:06:07.57,Default,,0,0,0,,Мұндай қулық
Dialogue: 0,0:06:08.11,0:06:09.03,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:09.49,0:06:11.07,Default,,0,0,0,,Фу~ Фу~
Dialogue: 0,0:06:11.16,0:06:13.12,Default,,0,0,0,,Өзіңіз дәмін татып көріңіз
Dialogue: 0,0:06:13.53,0:06:14.83,Default,,0,0,0,,Боқ~
Dialogue: 0,0:06:17.58,0:06:21.75,Default,,0,0,0,,Ишиши Ношиши! Егер бұл орын алса, мен сол стратегиямен жүремін!
Dialogue: 0,0:06:23.59,0:06:25.76,Default,,0,0,0,,хм/сағ хм/сағ
Dialogue: 0,0:06:27.47,0:06:28.88,Default,,0,0,0,,Бұл... Кук Кук
Dialogue: 0,0:06:29.59,0:06:31.39,Default,,0,0,0,,Идеяларыңыз бар ма?
Dialogue: 0,0:06:31.51,0:06:32.68,Default,,0,0,0,,Осы жерде болыңыз! иә?
Dialogue: 0,0:06:36.18,0:06:37.02,Default,,0,0,0,,Жолбарыс!
Dialogue: 0,0:06:37.31,0:06:38.35,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:42.27,0:06:43.90,Default,,0,0,0,,Мұнда келме (2 адам) Эй Эй
Dialogue: 0,0:06:44.07,0:06:44.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:45.27,0:06:46.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:46.32,0:06:49.07,Default,,0,0,0,,Не? Бұл мүлдем мүмкін емес.
Dialogue: 0,0:06:50.99,0:06:51.95,Default,,0,0,0,,Бұл стратегия ма?
Dialogue: 0,0:06:52.24,0:06:54.24,Default,,0,0,0,,Ей, қалай, қалай? (2 адам) Ей, и...
Dialogue: 0,0:06:54.66,0:06:55.74,Default,,0,0,0,,Жақсы
Dialogue: 0,0:06:56.66,0:06:57.50,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:00.37,0:07:01.21,Default,,0,0,0,,О? Ах
Dialogue: 0,0:07:01.71,0:07:05.34,Default,,0,0,0,,Иә! Мұндай нәрсе әр тасты ұшырып жібереді
Dialogue: 0,0:07:05.63,0:07:06.80,Default,,0,0,0,,Сирек!
Dialogue: 0,0:07:07.92,0:07:09.63,Default,,0,0,0,,Уа... ау
Dialogue: 0,0:07:16.72,0:07:17.56,Default,,0,0,0,,Бухехехе
Dialogue: 0,0:07:18.31,0:07:20.10,Default,,0,0,0,,Иә! Хаха
Dialogue: 0,0:07:20.18,0:07:22.52,Default,,0,0,0,,Сіз әу бастан мақсат еттіңіз бе?
Dialogue: 0,0:07:22.60,0:07:24.27,Default,,0,0,0,,Не? (2 адам) Уаха~!
Dialogue: 0,0:07:24.36,0:07:26.19,Default,,0,0,0,,Бұл 100 000 ат күші.
Dialogue: 0,0:07:26.27,0:07:27.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:27.61,0:07:31.78,Default,,0,0,0,,Ku~! Уақытша Тайкьяку! Ұшатын Джунби!
Dialogue: 0,0:07:31.95,0:07:32.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:32.86,0:07:33.87,Default,,0,0,0,,Ұшып секіру?
Dialogue: 0,0:07:34.70,0:07:36.70,Default,,0,0,0,,Хмм... уф
Dialogue: 0,0:07:39.37,0:07:41.58,Default,,0,0,0,,Ахахха! Алақай!
Dialogue: 0,0:07:41.71,0:07:42.54,Default,,0,0,0,,(Химецудзима) Жәбірленген-ай… Қандай әлсіз, аянышты бала.
Dialogue: 0,0:07:43.00,0:07:44.46,Default,,0,0,0,,Уф уф
Dialogue: 0,0:07:47.46,0:07:49.38,Default,,0,0,0,,Қырықша… әрине!
Dialogue: 0,0:07:49.51,0:07:51.72,Default,,0,0,0,,Мен жеті теңіздің ғана емеспін.
Dialogue: 0,0:07:51.80,0:07:55.51,Default,,0,0,0,,Құрлықта да, көкте де нұрын төгетін үлкен мұнараға айналады.
Dialogue: 0,0:07:55.60,0:07:57.01,Default,,0,0,0,,Зорори, тағы кездескенше
Dialogue: 0,0:08:01.31,0:08:03.35,Default,,0,0,0,,Ол ұшады Ұшады
Dialogue: 0,0:08:03.64,0:08:06.65,Default,,0,0,0,,Жоқ, жоқ, ол ұшпайды.
Dialogue: 0,0:08:06.73,0:08:07.82,Default,,0,0,0,,Ум... иә?
Dialogue: 0,0:08:08.61,0:08:10.53,Default,,0,0,0,,О, балам
Dialogue: 0,0:08:10.61,0:08:14.36,Default,,0,0,0,,Мен құтқаратын сен өте бақытты бала болуың керек.
Dialogue: 0,0:08:14.45,0:08:16.37,Default,,0,0,0,,Достарыңмен ұялуға болмайды.
Dialogue: 0,0:08:17.20,0:08:18.03,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:18.83,0:08:21.83,Default,,0,0,0,,О? Қолтаңба алғыңыз келе ме? бала
Dialogue: 0,0:08:22.04,0:08:22.87,Default,,0,0,0,,Хмм.
Dialogue: 0,0:08:25.71,0:08:26.54,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:08:30.21,0:08:32.13,Default,,0,0,0,,Сәлем! қыз!
Dialogue: 0,0:08:32.51,0:08:35.05,Default,,0,0,0,,Және өте шатастырылды
Dialogue: 0,0:08:35.30,0:08:37.39,Default,,0,0,0,,Ка~вай!
Dialogue: 0,0:08:41.39,0:08:43.89,Default,,0,0,0,,Аа... Сіз ше?
Dialogue: 0,0:08:44.27,0:08:47.90,Default,,0,0,0,,Маған көмектескеніңіз үшін рахмет, Тэиль.
Dialogue: 0,0:08:48.19,0:08:52.36,Default,,0,0,0,,Бірақ маған үнемі көмектесуді қаламаймын.
Dialogue: 0,0:08:52.61,0:08:54.28,Default,,0,0,0,,Мен сізге міндетті түрде алғыс айтамын.
Dialogue: 0,0:08:54.99,0:08:56.95,Default,,0,0,0,,Өзі тәкаппар жігіт.
Dialogue: 0,0:08:57.03,0:09:00.28,Default,,0,0,0,,Сунао тек бақытты бол. Сәлем, Зори-сенси.
Dialogue: 0,0:09:00.58,0:09:05.29,Default,,0,0,0,,Менің ойымның кішкентай бөлігі де сүйкімді, хехе
Dialogue: 0,0:09:06.46,0:09:07.29,Default,,0,0,0,,Аха~
Dialogue: 0,0:09:11.46,0:09:14.17,Default,,0,0,0,,Археолог болған әкем менімен жанжалдасып қалды.
Dialogue: 0,0:09:14.63,0:09:16.43,Default,,0,0,0,,Ол үнемі бір жерде, бірде ұшатын.
Dialogue: 0,0:09:18.76,0:09:20.51,Default,,0,0,0,,Менің анам болған жоқ
Dialogue: 0,0:09:20.60,0:09:23.47,Default,,0,0,0,,Мені апамның үйінде ұзақ ұстады.
Dialogue: 0,0:09:24.23,0:09:26.73,Default,,0,0,0,,Көп жылдар бойы
Dialogue: 0,0:09:30.90,0:09:32.53,Default,,0,0,0,,Уф... Әке!
Dialogue: 0,0:09:34.57,0:09:36.90,Default,,0,0,0,,Менің әлі аяқталмаған ісім бар.
Dialogue: 0,0:09:38.11,0:09:41.62,Default,,0,0,0,,Құйрық: Мына кулонмен менің орныма...
Dialogue: 0,0:09:44.70,0:09:49.17,Default,,0,0,0,,Өлер алдында қайтып келіп, бос сөзден басқа ештеңе айтпаймын.
Dialogue: 0,0:09:49.38,0:09:50.59,Default,,0,0,0,,Сонымен Жолбарыс
Dialogue: 0,0:09:50.67,0:09:53.75,Default,,0,0,0,,Демек, сіз әкеңіздің естелік кулонын көздедіңіз бе?
Dialogue: 0,0:09:53.92,0:09:54.76,Default,,0,0,0,,Тайл-чан
Dialogue: 0,0:09:54.88,0:09:56.55,Default,,0,0,0,,Иә? Хмм
Dialogue: 0,0:09:56.63,0:09:58.43,Default,,0,0,0,,Ой, жаман құйрық
Dialogue: 0,0:09:59.14,0:10:01.22,Default,,0,0,0,,Балаларды емдегім келмейді.
Dialogue: 0,0:10:04.60,0:10:05.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:06.68,0:10:08.60,Default,,0,0,0,,О, бұл Широның картасы емес пе?
Dialogue: 0,0:10:09.35,0:10:12.86,Default,,0,0,0,,Оның артында әкең іздеген нәрсе тұрса керек.
Dialogue: 0,0:10:13.65,0:10:16.86,Default,,0,0,0,,Мен саған әкеңнің іздегенін табуға көмектесемін.
Dialogue: 0,0:10:16.94,0:10:19.61,Default,,0,0,0,,Құйрық әкесін жақсы көреді емес пе?
Dialogue: 0,0:10:19.99,0:10:21.62,Default,,0,0,0,,Бұл маған ұнағандықтан емес! Иә?
Dialogue: 0,0:10:22.37,0:10:24.99,Default,,0,0,0,,Ол кісі тек менің әкем деп аталады.
Dialogue: 0,0:10:26.33,0:10:28.33,Default,,0,0,0,,Мен жай ғана растағым келеді.
Dialogue: 0,0:10:29.08,0:10:32.96,Default,,0,0,0,,Менен мәңгілікке кетіп қалсаң да не істегің келді
Dialogue: 0,0:10:34.00,0:10:36.17,Default,,0,0,0,,Е... сәл күте тұрыңыз! Сен не істеп жатырсың?
Dialogue: 0,0:10:38.84,0:10:39.97,Default,,0,0,0,,Неге осы дене функциялары әлі де болады?
Dialogue: 0,0:10:40.13,0:10:42.01,Default,,0,0,0,,Жертөледе белгі бар
Dialogue: 0,0:10:42.26,0:10:43.39,Default,,0,0,0,,Ашық
Dialogue: 0,0:10:44.01,0:10:46.89,Default,,0,0,0,,Құйрық: Біз де саған көмектесеміз.
Dialogue: 0,0:10:47.14,0:10:49.44,Default,,0,0,0,,Әкемнің іздегенін бірге табайық.
Dialogue: 0,0:10:50.02,0:10:52.65,Default,,0,0,0,,Үйіндіні төртеуміз бөлеміз.
Dialogue: 0,0:10:53.11,0:10:54.98,Default,,0,0,0,,Ақымақ болма
Dialogue: 0,0:10:55.07,0:10:57.40,Default,,0,0,0,,Бәрі Құйрықтарға тиесілі емес пе?
Dialogue: 0,0:10:57.49,0:10:58.32,Default,,0,0,0,,Зоори мырза
Dialogue: 0,0:10:58.40,0:11:01.61,Default,,0,0,0,,Не болды? Әдетте, оны бөліктерге бөлудің орнына, бұл барлық нәрсе ...
Dialogue: 0,0:11:01.70,0:11:03.24,Default,,0,0,0,,Ах! Хмм...
Dialogue: 0,0:11:03.74,0:11:05.03,Default,,0,0,0,,Балалар сендер сондай тәттісіңдер
Dialogue: 0,0:11:05.12,0:11:08.25,Default,,0,0,0,,Егер сіз сол Широны алсаңыз және Құйрықтармен күрессеңіз
Dialogue: 0,0:11:08.41,0:11:10.46,Default,,0,0,0,,Широ, Отакара және Охиме-сама да
Dialogue: 0,0:11:10.67,0:11:13.25,Default,,0,0,0,,Сіз қалағанның бәрін ала аласыз!
Dialogue: 0,0:11:13.33,0:11:14.92,Default,,0,0,0,,Сәлеметсіз бе, мұғалім!
Dialogue: 0,0:11:15.00,0:11:18.17,Default,,0,0,0,,Сенсэйдің озық мінезі қашанда озық.
Dialogue: 0,0:11:18.51,0:11:19.34,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:19.42,0:11:20.42,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:20.93,0:11:23.89,Default,,0,0,0,,А, жоқ, жоқ... Маған үлес керек емес.
Dialogue: 0,0:11:23.97,0:11:25.76,Default,,0,0,0,,Жоқ, мен оны аламын.
Dialogue: 0,0:11:25.85,0:11:27.14,Default,,0,0,0,,Сізге қарыздар
Dialogue: 0,0:11:27.22,0:11:29.14,Default,,0,0,0,,Ұялма, Тэйл-чан
Dialogue: 0,0:11:29.23,0:11:30.06,Default,,0,0,0,,Ей!
Dialogue: 0,0:11:30.14,0:11:33.77,Default,,0,0,0,,Ах! Білемін, білемін, Құйрықтар, бұл не?
Dialogue: 0,0:11:33.85,0:11:34.69,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:11:36.52,0:11:38.53,Default,,0,0,0,,Ах! Өрт сөнеді
Dialogue: 0,0:11:38.61,0:11:40.57,Default,,0,0,0,,Себебі мұғалім күлкілі гаг айтады
Dialogue: 0,0:11:40.65,0:11:41.86,Default,,0,0,0,,Warii Warii Мен шынымен кешірім сұраймын.
Dialogue: 0,0:11:41.95,0:11:45.41,Default,,0,0,0,,Уау~ Мен таңқаларлық бірдеңе естідім.
Dialogue: 0,0:11:51.16,0:11:52.37,Default,,0,0,0,,Оны итермеңіз~
Dialogue: 0,0:11:52.46,0:11:55.63,Default,,0,0,0,,Уайымдамаңыз, мен әркімнің өнертабыстарын қадағалаймын!
Dialogue: 0,0:11:57.34,0:11:59.13,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:12:00.42,0:12:02.97,Default,,0,0,0,,А, а... кеттік.
Dialogue: 0,0:12:03.05,0:12:04.30,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:12:04.39,0:12:07.93,Default,,0,0,0,,Келіңіздер, олар осында шығып, көрінсін.
Dialogue: 0,0:12:08.01,0:12:11.18,Default,,0,0,0,,Біздің бастығымыз, капитан Жолбарыс!
Dialogue: 0,0:12:11.27,0:12:13.44,Default,,0,0,0,,(Фанфар)
Dialogue: 0,0:12:13.56,0:12:15.10,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:12:15.65,0:12:16.86,Default,,0,0,0,,О!
Dialogue: 0,0:12:16.94,0:12:18.48,Default,,0,0,0,,О!
Dialogue: 0,0:12:18.57,0:12:20.23,Default,,0,0,0,,Даусыңыз тым кішкентай!
Dialogue: 0,0:12:20.32,0:12:21.53,Default,,0,0,0,,О!
Dialogue: 0,0:12:21.61,0:12:22.74,Default,,0,0,0,,О!
Dialogue: 0,0:12:23.11,0:12:25.32,Default,,0,0,0,,Жарайды! Мен жақсымын!
Dialogue: 0,0:12:25.41,0:12:28.70,Default,,0,0,0,,Бүгінгі өнертапқыш тыңдауыма қатысқаныңыз үшін көп рахмет.
Dialogue: 0,0:12:28.78,0:12:29.62,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:12:30.37,0:12:32.50,Default,,0,0,0,,Мен барлығын бүгін жиналуды өтіндім.
Dialogue: 0,0:12:32.58,0:12:36.33,Default,,0,0,0,,Отакараны алу және Зоориді күлдірту үшін.
Dialogue: 0,0:12:36.42,0:12:38.92,Default,,0,0,0,,Маған ғажайып механизмдер жасай алатын адам керек... (Пуруруру...)
Dialogue: 0,0:12:39.67,0:12:40.75,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:12:40.84,0:12:42.09,Default,,0,0,0,,Кесіңіз!
Dialogue: 0,0:12:42.17,0:12:43.13,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:43.63,0:12:45.63,Default,,0,0,0,,Әдептілігі жоқ жігіт.
Dialogue: 0,0:12:45.97,0:12:48.72,Default,,0,0,0,,Қалай болғанда да, бұл тыңдаудан өткендер үшін,
Dialogue: 0,0:12:48.80,0:12:51.18,Default,,0,0,0,,Сондай-ақ әлем бойынша саяхаттау үшін қосымша жүлде болады!
Dialogue: 0,0:12:51.35,0:12:52.68,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:12:52.81,0:12:54.81,Default,,0,0,0,,Енді 1 санына көшейік.
Dialogue: 0,0:12:55.10,0:12:57.56,Default,,0,0,0,,Жоқ, жоқ, баспайтын болат
Dialogue: 0,0:12:57.65,0:13:00.69,Default,,0,0,0,,Сіз тым қаталсыз және ештеңе істей алмайсыз.
Dialogue: 0,0:13:01.32,0:13:03.94,Default,,0,0,0,,Сенің анаң да шәйнек екеніне сенімдімін.
Dialogue: 0,0:13:05.20,0:13:07.66,Default,,0,0,0,,Сізге қалай ұнайды? Егер бұлай болса
Dialogue: 0,0:13:07.74,0:13:10.53,Default,,0,0,0,,Бұл ыстық суға толы шәйнек.
Dialogue: 0,0:13:10.62,0:13:11.79,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:11.95,0:13:13.87,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:13.95,0:13:14.79,Default,,0,0,0,,Келесі!
Dialogue: 0,0:13:14.91,0:13:16.50,Default,,0,0,0,,Қандай сүйкімді
Dialogue: 0,0:13:16.58,0:13:18.92,Default,,0,0,0,,Дөңгеленген тұтқалы және тарылған шәйнек.
Dialogue: 0,0:13:19.00,0:13:22.38,Default,,0,0,0,,Мен бұл тек сен екеніне сенімдімін~ Өте сексуалды~!
Dialogue: 0,0:13:22.51,0:13:23.34,Default,,0,0,0,,Нуу…
Dialogue: 0,0:13:23.42,0:13:24.63,Default,,0,0,0,,Сіз қалай ойлайсыз? Мен сені мақтағанда...
Dialogue: 0,0:13:24.76,0:13:26.05,Default,,0,0,0,,Ыстық су!
Dialogue: 0,0:13:26.84,0:13:29.93,Default,,0,0,0,,Шатаспаңыз! Сіз неге ыстық суға мән бересіз?
Dialogue: 0,0:13:30.01,0:13:31.93,Default,,0,0,0,,Келесі жолы шәйнекті күлдіремін деп ойламаппын
Dialogue: 0,0:13:32.01,0:13:34.73,Default,,0,0,0,,Қарын шай жасайды демейді!
Dialogue: 0,0:13:34.81,0:13:36.02,Default,,0,0,0,,Жоқ, а... үйге баруым керек пе?
Dialogue: 0,0:13:36.35,0:13:37.52,Default,,0,0,0,,Ақымақ болайық!
Dialogue: 0,0:13:37.60,0:13:39.73,Default,,0,0,0,,Егер солай болса, маған қалдырыңыз!
Dialogue: 0,0:13:39.81,0:13:40.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:40.98,0:13:42.57,Default,,0,0,0,,О?
Dialogue: 0,0:13:42.90,0:13:46.78,Default,,0,0,0,,Қайнаған магма сияқты, ол энтузиастар арасында өте танымал.
Dialogue: 0,0:13:46.86,0:13:47.82,Default,,0,0,0,,Әттең!
Dialogue: 0,0:13:48.74,0:13:50.07,Default,,0,0,0,,Міне.
Dialogue: 0,0:13:50.78,0:13:51.99,Default,,0,0,0,,Ой-оу
Dialogue: 0,0:13:53.54,0:13:55.70,Default,,0,0,0,,Хаа, қайта тіріл!
Dialogue: 0,0:13:56.21,0:13:58.75,Default,,0,0,0,,Оның пішіні тәтті картопқа ұқсайды!
Dialogue: 0,0:13:58.83,0:14:00.83,Default,,0,0,0,,Шырын жазда салқын болады
Dialogue: 0,0:14:00.92,0:14:01.79,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:14:01.88,0:14:04.05,Default,,0,0,0,,Бұл Суитонның шынайы оқиғасы.
Dialogue: 0,0:14:04.13,0:14:04.96,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:14:05.05,0:14:05.88,Default,,0,0,0,,Одан да көп
Dialogue: 0,0:14:05.97,0:14:07.63,Default,,0,0,0,,Пекопон Шинряку не болады?
Dialogue: 0,0:14:07.97,0:14:09.34,Default,,0,0,0,,Кукккккккккккккккккккккккккккккккккккккккккккккккккк
Dialogue: 0,0:14:09.43,0:14:11.26,Default,,0,0,0,,Акгуйдың денесі ня
Dialogue: 0,0:14:11.35,0:14:12.18,Default,,0,0,0,,Сиқырлы бөтелке класы
Dialogue: 0,0:14:12.26,0:14:14.97,Default,,0,0,0,,Менде вакуумдық ыдыс бар.
Dialogue: 0,0:14:15.18,0:14:17.48,Default,,0,0,0,,Ыстық су жарты тәулікке жетеді.
Dialogue: 0,0:14:17.64,0:14:19.23,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:14:19.69,0:14:22.52,Default,,0,0,0,,Эй, сен ыстық судан шыға аласың ба?
Dialogue: 0,0:14:22.61,0:14:23.77,Default,,0,0,0,,Сізге не үшін мән бересіз?
Dialogue: 0,0:14:23.86,0:14:25.57,Default,,0,0,0,,Не! Мұның бәрі ме?
Dialogue: 0,0:14:25.65,0:14:27.82,Default,,0,0,0,,Арнайы қонаққа олай қарамайсың.
Dialogue: 0,0:14:27.90,0:14:29.95,Default,,0,0,0,,Шулы! Үйге ерте қайт!
Dialogue: 0,0:14:30.03,0:14:31.20,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:14:31.57,0:14:33.41,Default,,0,0,0,,Барка Барка
Dialogue: 0,0:14:33.49,0:14:35.49,Default,,0,0,0,,Бұл жігіт қайдан шыққан?
Dialogue: 0,0:14:35.79,0:14:37.71,Default,,0,0,0,,Қараңдар! Менің қалағаным
Dialogue: 0,0:14:37.79,0:14:39.58,Default,,0,0,0,,Бұл Киофудың механисі... (қорқынышты музыка)
Dialogue: 0,0:14:39.83,0:14:41.92,Default,,0,0,0,,Не? бұл жаман дыбыс
Dialogue: 0,0:14:42.59,0:14:44.75,Default,,0,0,0,,Құнды Dolby қоршауы босқа кетті...
Dialogue: 0,0:14:45.25,0:14:47.13,Default,,0,0,0,,Зорориді жеңіңіз, солай ма?
Dialogue: 0,0:14:47.51,0:14:50.38,Default,,0,0,0,,Олай болса маған қалдырыңыз.
Dialogue: 0,0:14:50.72,0:14:52.43,Default,,0,0,0,,О, сен ше?
Dialogue: 0,0:14:53.60,0:14:54.76,Default,,0,0,0,,Ухехехехе
Dialogue: 0,0:14:58.77,0:14:59.64,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:59.73,0:15:01.94,Default,,0,0,0,,Оның қандай да бір мағынасы бар ма?
Dialogue: 0,0:15:02.06,0:15:04.65,Default,,0,0,0,,Уф, бұл қорқынышты сезім тудырады...
Dialogue: 0,0:15:04.73,0:15:05.65,Default,,0,0,0,,(дыбысты тоқтату)
Dialogue: 0,0:15:05.98,0:15:08.61,Default,,0,0,0,,Міне, осылай шықты...
Dialogue: 0,0:15:08.69,0:15:09.86,Default,,0,0,0,,Жақсы кадрлар
Dialogue: 0,0:15:10.03,0:15:11.70,Default,,0,0,0,,Хэ-хэ…
Dialogue: 0,0:15:13.37,0:15:15.74,Default,,0,0,0,,А... аа, сәлем
Dialogue: 0,0:15:16.24,0:15:18.75,Default,,0,0,0,,Әй, сен ұқыптысың.
Dialogue: 0,0:15:18.83,0:15:20.33,Default,,0,0,0,,Сәлемдесу негізгі болып табылады.
Dialogue: 0,0:15:20.96,0:15:24.71,Default,,0,0,0,,Менімен бірінші рет кездескенде менің атым Мади.
Dialogue: 0,0:15:24.79,0:15:27.67,Default,,0,0,0,,Зорориді естісем, үндемеймін.
Dialogue: 0,0:15:28.09,0:15:29.67,Default,,0,0,0,,дегенді қалай түсінесіңдер?
Dialogue: 0,0:15:29.84,0:15:31.01,Default,,0,0,0,,Осы уақытқа дейін I
Dialogue: 0,0:15:31.13,0:15:33.72,Default,,0,0,0,,Мен көп жерде өнертабыстар жасадым.
Dialogue: 0,0:15:33.80,0:15:35.85,Default,,0,0,0,,Бала тәрізді сүйкімді меха
Dialogue: 0,0:15:35.93,0:15:37.85,Default,,0,0,0,,Ол өз қалауынша қолданылды.
Dialogue: 0,0:15:37.93,0:15:39.68,Default,,0,0,0,,Сол Никкуки Зори
Dialogue: 0,0:15:39.89,0:15:43.77,Default,,0,0,0,,Wow~ Бұл және мыналар сіз жасаған механизмдер ме?
Dialogue: 0,0:15:45.19,0:15:46.77,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:15:46.86,0:15:47.69,Default,,0,0,0,,Хехехе
Dialogue: 0,0:15:48.19,0:15:51.65,Default,,0,0,0,,Міне, болды, солай болды.
Dialogue: 0,0:15:51.78,0:15:53.49,Default,,0,0,0,,Сіз қайтып келесіз бе? Тоттоса
Dialogue: 0,0:15:54.03,0:15:56.08,Default,,0,0,0,,Мен оны сұрадым! Мэдди ұстаз!
Dialogue: 0,0:15:56.16,0:15:56.99,Default,,0,0,0,,Зоори не істейді
Dialogue: 0,0:15:57.08,0:15:59.08,Default,,0,0,0,,Көтенпанды жеңу механизмін жасаңыз!
Dialogue: 0,0:15:59.33,0:16:01.12,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:16:01.21,0:16:02.79,Default,,0,0,0,,Сіздің қарақшы кемеңіз
Dialogue: 0,0:16:02.87,0:16:05.75,Default,,0,0,0,,Аспанды, теңізді және жерді басқаруға болады.
Dialogue: 0,0:16:05.83,0:16:07.63,Default,,0,0,0,,Бұл меха болады
Dialogue: 0,0:16:08.00,0:16:09.96,Default,,0,0,0,,Ал қол...
Dialogue: 0,0:16:10.21,0:16:12.17,Default,,0,0,0,,О! Бұл рас па?
Dialogue: 0,0:16:12.51,0:16:14.84,Default,,0,0,0,,А, сәл күте тұрыңыз.
Dialogue: 0,0:16:15.68,0:16:17.01,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:17.10,0:16:18.72,Default,,0,0,0,,(Зұлымдық әуені)
Dialogue: 0,0:16:18.85,0:16:21.77,Default,,0,0,0,,Хехехе, Зооридің тағдыры енді
Dialogue: 0,0:16:21.85,0:16:23.56,Default,,0,0,0,,Бұл шешім қабылданғанын білдіре ме?
Dialogue: 0,0:16:23.64,0:16:25.48,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:16:25.56,0:16:28.57,Default,,0,0,0,,Қырықша… әрине!
Dialogue: 0,0:16:28.65,0:16:29.48,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:16:29.57,0:16:30.78,Default,,0,0,0,,Хогехоге Хогья~!
Dialogue: 0,0:16:31.44,0:16:32.61,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:32.70,0:16:34.28,Default,,0,0,0,,Бұл көңілді болатын сияқты болды, сондықтан мен жай ғана...
Dialogue: 0,0:16:34.57,0:16:36.99,Default,,0,0,0,,Бұл бәрі емес.
Dialogue: 0,0:16:37.07,0:16:38.16,Default,,0,0,0,,Құрметті Жолбарыс, мені тыңда.
Dialogue: 0,0:16:38.24,0:16:39.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:39.20,0:16:41.79,Default,,0,0,0,,Гонё Гонё…
Dialogue: 0,0:16:42.16,0:16:43.37,Default,,0,0,0,,Не?
Dialogue: 0,0:16:48.88,0:16:50.59,Default,,0,0,0,,Әкеңнің багажын тексер.
Dialogue: 0,0:16:50.67,0:16:52.92,Default,,0,0,0,,Мен соңғы тоқтаған ауылды білемін.
Dialogue: 0,0:16:53.01,0:16:55.26,Default,,0,0,0,,Широха жақын жерде болуы керек.
Dialogue: 0,0:16:56.34,0:16:57.97,Default,,0,0,0,,Хмм... Қазір.
Dialogue: 0,0:16:59.14,0:16:59.97,Default,,0,0,0,,Хмм
Dialogue: 0,0:17:01.31,0:17:03.60,Default,,0,0,0,,Ах... ой-о
Dialogue: 0,0:17:10.90,0:17:11.94,Default,,0,0,0,,Осы ауыл
Dialogue: 0,0:17:21.29,0:17:23.04,Default,,0,0,0,,Тасқа толы жалғыз жер...
Dialogue: 0,0:17:23.79,0:17:26.54,Default,,0,0,0,,Олай болса, үзіліс алған соң одан сұрайық.
Dialogue: 0,0:17:27.08,0:17:29.88,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:17:29.96,0:17:30.79,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:32.71,0:17:33.80,Default,,0,0,0,,Жалпы алғанда, сол хабар тарату мұнарасынан өткеннен кейін сигнал әдетте жақсы болады
Dialogue: 0,0:17:33.88,0:17:34.72,Default,,0,0,0,,Хмм?
Dialogue: 0,0:17:34.92,0:17:37.01,Default,,0,0,0,,Мұнда біртүрлі пішінді тесік бар.
Dialogue: 0,0:17:38.97,0:17:39.80,Default,,0,0,0,,Ах
Dialogue: 0,0:17:40.05,0:17:41.06,Default,,0,0,0,,Міне! Сіз жігіттер!
Dialogue: 0,0:17:41.14,0:17:41.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:42.06,0:17:43.97,Default,,0,0,0,,Тыныш жерде не істеу керек!
Dialogue: 0,0:17:44.64,0:17:45.48,Default,,0,0,0,,Ум, кешіріңіз.
Dialogue: 0,0:17:45.56,0:17:46.39,Default,,0,0,0,,Хмм.
Dialogue: 0,0:17:46.48,0:17:47.35,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:17:47.85,0:17:50.23,Default,,0,0,0,,Мен осы ауылдың бастығымын.
Dialogue: 0,0:17:50.31,0:17:51.82,Default,,0,0,0,,Сіз... иә?
Dialogue: 0,0:17:54.94,0:17:56.78,Default,,0,0,0,,Нуа, бұл...
Dialogue: 0,0:18:00.32,0:18:02.33,Default,,0,0,0,,Не? Не? (Бала) Жарайды, тезірек.
Dialogue: 0,0:18:02.45,0:18:03.62,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:18:07.29,0:18:09.33,Default,,0,0,0,,Қалағаныңызша жеңіз.
Dialogue: 0,0:18:09.50,0:18:12.00,Default,,0,0,0,,Мұның бәрі картопқа байланысты, бірақ бұл біздің ауылдың ерекшелігі.
Dialogue: 0,0:18:12.50,0:18:13.75,Default,,0,0,0,,Бірақ жақсы ма?
Dialogue: 0,0:18:13.84,0:18:16.92,Default,,0,0,0,,Олар маған той бермекші, ендеше той берейік.
Dialogue: 0,0:18:17.13,0:18:19.51,Default,,0,0,0,,Тағы да көп.
Dialogue: 0,0:18:19.80,0:18:21.10,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:18:22.85,0:18:25.14,Default,,0,0,0,,Кез келген сома жарайды, хехе
Dialogue: 0,0:18:25.31,0:18:26.89,Default,,0,0,0,,Ммм... Иә?
Dialogue: 0,0:18:27.39,0:18:30.06,Default,,0,0,0,,Хахахаха, өйткені олар бірден жейді.
Dialogue: 0,0:18:30.15,0:18:31.02,Default,,0,0,0,,Әй, су ше?
Dialogue: 0,0:18:31.56,0:18:33.90,Default,,0,0,0,,Суға тапсырыс беру керек
Dialogue: 0,0:18:34.36,0:18:35.86,Default,,0,0,0,,Суға алтын аласың ба?
Dialogue: 0,0:18:36.28,0:18:37.11,Default,,0,0,0,,Маған бәрібір! Ха!
Dialogue: 0,0:18:38.90,0:18:40.36,Default,,0,0,0,,10 000 иен!
Dialogue: 0,0:18:40.66,0:18:41.70,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:41.78,0:18:44.74,Default,,0,0,0,,Бұл ауылда су жақсы емес.
Dialogue: 0,0:18:44.83,0:18:46.58,Default,,0,0,0,,Жаңбыр да өте баяу жауады.
Dialogue: 0,0:18:46.87,0:18:48.66,Default,,0,0,0,,А... солай ма?
Dialogue: 0,0:18:48.75,0:18:51.33,Default,,0,0,0,,А, онда картоптан басқасы...
Dialogue: 0,0:18:51.42,0:18:53.34,Default,,0,0,0,,Не? «Қуырылған құйрық»
Dialogue: 0,0:18:53.42,0:18:55.34,Default,,0,0,0,,«Құйрықты тарау»? (3 адам) Иә?
Dialogue: 0,0:18:55.59,0:18:58.01,Default,,0,0,0,,«Құйрықты қуырылған күріш» «Құйрық крокеті»
Dialogue: 0,0:18:58.09,0:18:59.84,Default,,0,0,0,,«Құйрық салаты» «Құйрық терияки»
Dialogue: 0,0:19:00.01,0:19:01.47,Default,,0,0,0,,«Құйрық темпура» «Құйрық анқаке»
Dialogue: 0,0:19:01.55,0:19:02.85,Default,,0,0,0,,«Құйрық Цубояки»? Эх!
Dialogue: 0,0:19:02.97,0:19:05.06,Default,,0,0,0,,Барлығы дәмді.
Dialogue: 0,0:19:05.72,0:19:06.89,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:07.18,0:19:08.89,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:19:09.10,0:19:10.56,Default,,0,0,0,,Мына картоп
Dialogue: 0,0:19:10.64,0:19:12.56,Default,,0,0,0,,Оның аты «No2 құйрық».
Dialogue: 0,0:19:12.65,0:19:13.90,Default,,0,0,0,,Фугия~!
Dialogue: 0,0:19:14.57,0:19:16.53,Default,,0,0,0,,Бұл Имоның есімі ме?
Dialogue: 0,0:19:16.69,0:19:17.53,Default,,0,0,0,,Хмм
Dialogue: 0,0:19:18.24,0:19:20.53,Default,,0,0,0,,Бірақ «No2 құйрық» ше?
Dialogue: 0,0:19:20.86,0:19:22.49,Default,,0,0,0,,Кулон
Dialogue: 0,0:19:22.61,0:19:26.16,Default,,0,0,0,,Әкеңнің аты Гейл емес пе?
Dialogue: 0,0:19:26.54,0:19:27.70,Default,,0,0,0,,Мүмкін, саған кішкене сабақ беруім керек шығар.
Dialogue: 0,0:19:27.79,0:19:29.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:29.79,0:19:32.29,Default,,0,0,0,,Гейл-сан бізге қонаққа келгенше.
Dialogue: 0,0:19:32.37,0:19:34.92,Default,,0,0,0,,Бұл ауылда тамақ көп емес.
Dialogue: 0,0:19:35.67,0:19:37.88,Default,,0,0,0,,Ескі жер алда
Dialogue: 0,0:19:37.96,0:19:42.18,Default,,0,0,0,,Гейлге қиын топырақта да өсетін күшті түйнекті тапқаны үшін рахмет.
Dialogue: 0,0:19:42.26,0:19:44.43,Default,,0,0,0,,Ол біздің әкеміз.
Dialogue: 0,0:19:45.93,0:19:47.60,Default,,0,0,0,,«No2 құйрық» қалай аталады?
Dialogue: 0,0:19:47.68,0:19:51.85,Default,,0,0,0,,Гейл оны сүйкімді жалғыз қызының атымен атады.
Dialogue: 0,0:19:53.15,0:19:55.90,Default,,0,0,0,,Әкем Құйрықты жақсы көретін, солай емес пе?
Dialogue: 0,0:19:55.98,0:19:56.82,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:19:56.90,0:19:59.82,Default,,0,0,0,,Мен Оймомен бір атқа ие болғаныма мүлдем қуанбаймын.
Dialogue: 0,0:20:00.32,0:20:03.36,Default,,0,0,0,,Одан гөрі, ауыл бастығы, мен оның артынан барғым келеді.
Dialogue: 0,0:20:03.45,0:20:04.28,Default,,0,0,0,,Иә
Dialogue: 0,0:20:04.36,0:20:06.95,Default,,0,0,0,,О, құдайым... тоқтат!
Dialogue: 0,0:20:07.03,0:20:09.83,Default,,0,0,0,,Жақында мұнда біртүрлі құбыжық тұрып жатыр.
Dialogue: 0,0:20:09.91,0:20:11.75,Default,,0,0,0,,Ешкім жақындағысы келмейді
Dialogue: 0,0:20:12.21,0:20:14.67,Default,,0,0,0,,Сіз құбыжық сияқты нәрседен бас тарта аласыз ба?
Dialogue: 0,0:20:14.75,0:20:16.08,Default,,0,0,0,,Өйткені, Құйрықтармен күрес...
Dialogue: 0,0:20:16.17,0:20:17.25,Default,,0,0,0,,Иә? Болма...
Dialogue: 0,0:20:18.05,0:20:22.59,Default,,0,0,0,,Жоқ, уайымдама, маған түбіне апаратын жолды көрсет.
Dialogue: 0,0:20:34.10,0:20:36.77,Default,,0,0,0,,Бұл туралы алаңдамаңыз.
Dialogue: 0,0:20:36.86,0:20:39.52,Default,,0,0,0,,Алдымен сіз кіре аласыз.
Dialogue: 0,0:20:39.61,0:20:41.86,Default,,0,0,0,,Иә, жоқ, жоқ, Иши-сан осында...
Dialogue: 0,0:20:41.94,0:20:44.11,Default,,0,0,0,,Жоқ, мен мұны екеуіңе қалдырамын.
Dialogue: 0,0:20:44.24,0:20:45.99,Default,,0,0,0,,Сіз не айттыңыз? Өтінемін, алға.
Dialogue: 0,0:20:46.07,0:20:48.16,Default,,0,0,0,,Иә, иә, мен қазірдің өзінде...
Dialogue: 0,0:20:48.78,0:20:51.08,Default,,0,0,0,,Уау! Уау
Dialogue: 0,0:20:52.91,0:20:54.96,Default,,0,0,0,,Зорори мырза жеңіл жүріс, солай емес пе?
Dialogue: 0,0:20:59.34,0:21:00.42,Default,,0,0,0,,О, эй!
Dialogue: 0,0:21:00.50,0:21:03.22,Default,,0,0,0,,О! Менің денем осы ақ фонда
Dialogue: 0,0:21:03.30,0:21:05.22,Default,,0,0,0,,Бұл керемет болды, солай емес пе?
Dialogue: 0,0:21:05.30,0:21:06.51,Default,,0,0,0,,Одачин Одачин
Dialogue: 0,0:21:06.59,0:21:08.05,Default,,0,0,0,,Ах, Одачин.
Dialogue: 0,0:21:08.14,0:21:09.64,Default,,0,0,0,,Орагочин! О~ Гачи~н
Dialogue: 0,0:21:10.43,0:21:12.18,Default,,0,0,0,,Жақсы! Біз де бортқа отырайық!
Dialogue: 0,0:21:12.27,0:21:14.10,Default,,0,0,0,,Күте тұрасың (Жолбарыс) А?
Dialogue: 0,0:21:15.23,0:21:18.77,Default,,0,0,0,,Қиындықты соларға қалдырайық.
Dialogue: 0,0:21:32.87,0:21:34.37,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:43.01,0:21:44.97,Default,,0,0,0,,Бұл қорқынышты...
Dialogue: 0,0:21:45.51,0:21:48.51,Default,,0,0,0,,Кешіріңіз, бұл жай ғана ескі маска емес.
Dialogue: 0,0:21:49.55,0:21:50.39,Default,,0,0,0,,Тынш! Күте тұрыңыз
Dialogue: 0,0:21:50.47,0:21:51.81,Default,,0,0,0,,Уау... Иә?
Dialogue: 0,0:21:51.93,0:21:52.97,Default,,0,0,0,,(Зазазаза…)
Dialogue: 0,0:21:53.22,0:21:54.14,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:21:54.22,0:21:55.48,Default,,0,0,0,,Уф
Dialogue: 0,0:21:55.85,0:21:57.98,Default,,0,0,0,,(Зазаза…)
Dialogue: 0,0:22:02.07,0:22:02.90,Default,,0,0,0,,Гяа!
Dialogue: 0,0:22:02.98,0:22:05.82,Default,,0,0,0,,Жәндіктер! Жәндіктер жәндіктер жәндіктер…
Dialogue: 0,0:22:08.07,0:22:10.45,Default,,0,0,0,,Жылан! Жылан Жылан Жылан...
Dialogue: 0,0:22:12.62,0:22:14.66,Default,,0,0,0,,Зори-сан, бірдеңе істе~!
Dialogue: 0,0:22:15.08,0:22:16.75,Default,,0,0,0,,Маған қалдырыңыз~
Dialogue: 0,0:22:16.83,0:22:17.66,Default,,0,0,0,,Гяа!
Dialogue: 0,0:22:18.79,0:22:19.75,Default,,0,0,0,,Мияу!
Dialogue: 0,0:22:21.29,0:22:22.84,Default,,0,0,0,,Міне!
Dialogue: 0,0:22:22.92,0:22:23.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:23.88,0:22:25.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:25.21,0:22:26.51,Default,,0,0,0,,Бұл горгон емес пе!
Dialogue: 0,0:22:28.88,0:22:31.26,Default,,0,0,0,,О, мен Азукиді төгіп алдым.
Dialogue: 0,0:22:31.34,0:22:33.97,Default,,0,0,0,,О, мен бұл қате деп ойладым, бірақ бұл азуки бұршағы.
Dialogue: 0,0:22:34.06,0:22:34.93,Default,,0,0,0,,Балалар
Dialogue: 0,0:22:35.56,0:22:38.69,Default,,0,0,0,,Эй, сен Зорори-сенсэй емессің бе?
Dialogue: 0,0:22:39.94,0:22:41.19,Default,,0,0,0,,Сәлем~!
Dialogue: 0,0:22:42.94,0:22:44.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:44.44,0:22:47.24,Default,,0,0,0,,Ой, құйрықтар, уайымдама.
Dialogue: 0,0:22:47.32,0:22:49.70,Default,,0,0,0,,Йокай мектебінің мұғалімдері мен оқушылары
Dialogue: 0,0:22:49.91,0:22:52.28,Default,,0,0,0,,Мен үнемі біреуді қорқытуға машықтанамын.
Dialogue: 0,0:22:52.41,0:22:53.78,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:22:53.87,0:22:57.50,Default,,0,0,0,,Мен қорқынышты және қорқынышты тұлғаны таптым.
Dialogue: 0,0:22:57.58,0:23:01.08,Default,,0,0,0,,Барлығымыз оқу-жаттығу жиынына бардық, өйткені ол жаттығуға өте ыңғайлы.
Dialogue: 0,0:23:01.33,0:23:02.17,Default,,0,0,0,,Эй!
Dialogue: 0,0:23:02.88,0:23:06.46,Default,,0,0,0,,Оқу-жаттығу жиыны жақсы, бірақ бізді қорқыту қорқынышты емес пе?
Dialogue: 0,0:23:06.55,0:23:08.59,Default,,0,0,0,,Бұл басқаша, Зори-сенсей.
Dialogue: 0,0:23:09.09,0:23:11.89,Default,,0,0,0,,Мен азуки бұршақтарын аудардым.
Dialogue: 0,0:23:12.64,0:23:14.64,Default,,0,0,0,,Сосын тайып құладым.
Dialogue: 0,0:23:17.56,0:23:20.39,Default,,0,0,0,,Мен оны көру үшін келдім!
Dialogue: 0,0:23:20.48,0:23:22.35,Default,,0,0,0,,Мен ешқандай зиян келтірген жоқпын.
Dialogue: 0,0:23:22.73,0:23:24.69,Default,,0,0,0,,Ал... түсіндім.
Dialogue: 0,0:23:25.27,0:23:27.98,Default,,0,0,0,,Бұл адамдар сіздің әкеңіз болуы мүмкін бе?
Dialogue: 0,0:23:28.07,0:23:31.86,Default,,0,0,0,,Құйрық: Бұл жігіттер адамдарды ренжітетін адамдар емес.
Dialogue: 0,0:23:32.57,0:23:35.45,Default,,0,0,0,,Айтпақшы, мұнда жер астында бірдеңе болды ма?
Dialogue: 0,0:23:35.74,0:23:37.74,Default,,0,0,0,,Бұл жер астында ма?
Dialogue: 0,0:23:42.33,0:23:44.58,Default,,0,0,0,,Бұл жер астындағы жалғыз өткел.
Dialogue: 0,0:23:45.13,0:23:47.67,Default,,0,0,0,,Біз келгенше...
Dialogue: 0,0:23:48.30,0:23:49.92,Default,,0,0,0,,Ол әдемі түрде бұғатталған.
Dialogue: 0,0:23:50.67,0:23:52.93,Default,,0,0,0,,Осы уақытқа дейін келсем де...
Dialogue: 0,0:23:53.84,0:23:58.01,Default,,0,0,0,,Жоқ, егер бізде осыншама материал болса, біз бірдеңе істей аламыз.
Dialogue: 0,0:23:59.18,0:24:02.23,Default,,0,0,0,,Иә! Тағы да бар!
Dialogue: 0,0:24:04.06,0:24:05.27,Default,,0,0,0,,Рахмет! а!
Dialogue: 0,0:24:05.36,0:24:06.73,Default,,0,0,0,,Жетеді!
Dialogue: 0,0:24:07.48,0:24:10.07,Default,,0,0,0,,Хаха! Бұл дулыға керемет
Dialogue: 0,0:24:10.15,0:24:11.95,Default,,0,0,0,,Ал, әкел
Dialogue: 0,0:24:13.57,0:24:15.12,Default,,0,0,0,,Сондай-ақ осындай нәрсе болды
Dialogue: 0,0:24:15.20,0:24:16.03,Default,,0,0,0,,Неге осы дене функциялары әлі де болады?
Dialogue: 0,0:24:16.62,0:24:19.20,Default,,0,0,0,,«Көп жеміс іздегендерге»
Dialogue: 0,0:24:19.29,0:24:22.71,Default,,0,0,0,,«Зындандан шыққан кезде бұл құралдар жинағын ұмытпаңыз.»
Dialogue: 0,0:24:27.09,0:24:29.59,Default,,0,0,0,,Хмм, бұл не?
Dialogue: 0,0:24:29.96,0:24:31.92,Default,,0,0,0,,Әкел, әкел
Dialogue: 0,0:24:32.30,0:24:33.13,Default,,0,0,0,,Орындалды!
Dialogue: 0,0:24:33.63,0:24:34.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:37.10,0:24:38.47,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:24:38.60,0:24:41.39,Default,,0,0,0,,Хахахаха! (Шырылдау...)
Dialogue: 0,0:24:42.14,0:24:45.98,Default,,0,0,0,,Керемет... Мен оны шынымен де қоқыспен жасадым.
Dialogue: 0,0:24:46.27,0:24:47.31,Default,,0,0,0,,Нихихихи
Dialogue: 0,0:24:47.77,0:24:48.98,Default,,0,0,0,,Хмм (Юкай-сенсэй) Бір минут күте тұрыңыз.
Dialogue: 0,0:24:49.73,0:24:51.94,Default,,0,0,0,,Бұл адам Охиме-сама Кохо ма?
Dialogue: 0,0:24:52.03,0:24:54.28,Default,,0,0,0,,Ухехехе жақсы.
Dialogue: 0,0:24:54.36,0:24:56.32,Default,,0,0,0,,Олай болса, маған қалдырыңыз.
Dialogue: 0,0:24:56.41,0:24:58.99,Default,,0,0,0,,Осы ақ кеңістік Химе-самамен махаббат ұясына айналсын.
Dialogue: 0,0:24:59.08,0:25:00.91,Default,,0,0,0,,Мен оны жаңартамын.
Dialogue: 0,0:25:00.99,0:25:04.71,Default,,0,0,0,,Әй, махаббат ұясы! Гуфуфуфуфуфуфу
Dialogue: 0,0:25:04.79,0:25:08.75,Default,,0,0,0,,Жарайды! Бақытқа ұмтылуды бастайық!
Dialogue: 0,0:25:13.17,0:25:15.97,Default,,0,0,0,,♪ Жүрейік, жүрейік
Dialogue: 0,0:25:16.05,0:25:18.68,Default,,0,0,0,,♪ Әрі қарай жүрейік
Dialogue: 0,0:25:18.85,0:25:21.64,Default,,0,0,0,,♪ ойлы-қырлы жолдар мен қираған көпірлер
Dialogue: 0,0:25:21.72,0:25:24.56,Default,,0,0,0,,♪ Ой, жол айыр
Dialogue: 0,0:25:24.64,0:25:31.32,Default,,0,0,0,,♪ Айналма жол ұзақ болса да көңіл көтеретіндер үшін Қызығушылық танытқандар үшін
Dialogue: 0,0:25:31.69,0:25:34.40,Default,,0,0,0,,♪ Жүрейік, жүрейік
Dialogue: 0,0:25:34.49,0:25:37.07,Default,,0,0,0,,♪ Әрі қарай жүрейік
Dialogue: 0,0:25:37.49,0:25:42.41,Default,,0,0,0,,♪ Қиын, жарайды, мен саған тапсырсам болады.
Dialogue: 0,0:25:42.95,0:25:43.79,Default,,0,0,0,,Ах
Dialogue: 0,0:25:44.70,0:25:47.08,Default,,0,0,0,,Жарайды, жақында қалды.
Dialogue: 0,0:25:51.04,0:25:52.21,Default,,0,0,0,,Не?!
Dialogue: 0,0:25:55.26,0:25:56.34,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:25:57.09,0:25:58.01,Default,,0,0,0,,Зорори-сан
Dialogue: 0,0:26:01.22,0:26:02.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:02.72,0:26:04.31,Default,,0,0,0,,Аяпа
Dialogue: 0,0:26:04.47,0:26:06.56,Default,,0,0,0,,Мен тым көп қаздым деп ойлаймын.
Dialogue: 0,0:26:06.73,0:26:09.44,Default,,0,0,0,,Зорори мехамен әрі қарай жүру қауіпті ме?
Dialogue: 0,0:26:21.03,0:26:24.45,Default,,0,0,0,,Зоори мырза, бұл қайда апарады?
Dialogue: 0,0:26:24.70,0:26:25.54,Default,,0,0,0,,Құйрық
Dialogue: 0,0:26:27.33,0:26:28.16,Default,,0,0,0,,Ертегі?
Dialogue: 0,0:26:30.75,0:26:32.67,Default,,0,0,0,,Хана…ге?
Dialogue: 0,0:26:41.72,0:26:42.97,Default,,0,0,0,,Иә?Иә?
Dialogue: 0,0:26:43.81,0:26:44.64,Default,,0,0,0,,Не!
Dialogue: 0,0:26:45.39,0:26:46.73,Default,,0,0,0,,Оның квиркі өте күшті, бірақ—
Dialogue: 0,0:26:47.18,0:26:48.85,Default,,0,0,0,,Мұрын шашы шығып тұр.
Dialogue: 0,0:26:49.06,0:26:50.77,Default,,0,0,0,,Мұрын шашы түкті
Dialogue: 0,0:26:51.52,0:26:52.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:52.61,0:26:54.36,Default,,0,0,0,,А, мұнда бірдеңе жазылған.
Dialogue: 0,0:26:54.73,0:26:59.03,Default,,0,0,0,,«Қайшымен үшеуінің дұрысын кесіңіз».
Dialogue: 0,0:26:59.78,0:27:01.87,Default,,0,0,0,,Хмм, қайшы?
Dialogue: 0,0:27:01.95,0:27:03.66,Default,,0,0,0,,Хмм, қайшы...
Dialogue: 0,0:27:03.74,0:27:04.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:27:07.70,0:27:09.21,Default,,0,0,0,,Хахаха~
Dialogue: 0,0:27:09.33,0:27:10.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:10.42,0:27:11.62,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:27:14.92,0:27:17.63,Default,,0,0,0,,Хмм, мен оны бір кадрда шешемін.
Dialogue: 0,0:27:22.84,0:27:25.26,Default,,0,0,0,,О? иә? Арере ах
Dialogue: 0,0:27:25.81,0:27:28.77,Default,,0,0,0,,Эй, эй! Ай
Dialogue: 0,0:27:29.43,0:27:32.73,Default,,0,0,0,,А... жоқ, мұрныңыздағы түктерге жетпейді.
Dialogue: 0,0:27:33.40,0:27:34.48,Default,,0,0,0,,Хмм...
Dialogue: 0,0:27:35.61,0:27:37.23,Default,,0,0,0,,Ммммммм... бұл...
Dialogue: 0,0:27:45.03,0:27:47.99,Default,,0,0,0,,Ал, мына жігітті алайық...
Dialogue: 0,0:27:51.50,0:27:52.33,Default,,0,0,0,,Орындалды! (2 адам) Уау!
Dialogue: 0,0:27:53.08,0:27:55.00,Default,,0,0,0,,Қараңызшы, егер сіз мұны істесеңіз, сіз сонда жетесіз, солай ма?
Dialogue: 0,0:27:55.09,0:27:55.92,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:27:56.00,0:27:59.80,Default,,0,0,0,,Бұл керемет, мұғалім! Бұл тамаша
Dialogue: 0,0:27:59.88,0:28:00.72,Default,,0,0,0,,Ора Цууханде
Dialogue: 0,0:28:00.80,0:28:03.76,Default,,0,0,0,,Мен әрқашан осы Такаэда кесетін қайшыны қалайтынмын.
Dialogue: 0,0:28:04.55,0:28:06.85,Default,,0,0,0,,Бірден байқап көрейік, Бакин.
Dialogue: 0,0:28:07.35,0:28:08.31,Default,,0,0,0,,Сәлем! Ишиши!
Dialogue: 0,0:28:08.89,0:28:11.64,Default,,0,0,0,,Эй... тек жақсырақ ойлан.
Dialogue: 0,0:28:11.85,0:28:13.27,Default,,0,0,0,,Хяаааа
Dialogue: 0,0:28:20.11,0:28:21.61,Default,,0,0,0,,Жалғасы төменде Бұл қалақ.
Dialogue: 0,0:28:23.41,0:28:25.12,Default,,0,0,0,,Мұрын шашы солай
Dialogue: 0,0:28:25.20,0:28:27.24,Default,,0,0,0,,Бұл теңіз құмырасы болса керек.
Dialogue: 0,0:28:27.37,0:28:28.24,Default,,0,0,0,,Жақсы
Dialogue: 0,0:28:28.33,0:28:29.45,Default,,0,0,0,,Жүр, ары қарай жүрейік (Бакин)
Dialogue: 0,0:28:29.87,0:28:30.70,Default,,0,0,0,,Не!
Dialogue: 0,0:28:31.58,0:28:32.71,Default,,0,0,0,,Иә! Ах
Dialogue: 0,0:28:35.42,0:28:38.21,Default,,0,0,0,,Яхаха! Айқындық ең жақсы хахаха~
Dialogue: 0,0:28:38.55,0:28:41.80,Default,,0,0,0,,Не істеп жатырсың, Ишиши? Мен көп күш жұмсасам да!
Dialogue: 0,0:28:41.88,0:28:42.72,Default,,0,0,0,,На
Dialogue: 0,0:28:44.76,0:28:45.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:45.97,0:28:47.35,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:28:47.43,0:28:49.39,Default,,0,0,0,,Кя~! Бұл жолы шынайы!
Dialogue: 0,0:28:49.47,0:28:52.56,Default,,0,0,0,,Және бұл жәндік емес, улы ара!
Dialogue: 0,0:28:54.06,0:28:56.19,Default,,0,0,0,,Жәндіктер жоқ, жәндіктер жоқ, жоқ~
Dialogue: 0,0:29:01.65,0:29:03.24,Default,,0,0,0,,Зори-сан, бірдеңе істе!
Dialogue: 0,0:29:04.11,0:29:05.16,Default,,0,0,0,,Эй, Ношиши!
Dialogue: 0,0:29:05.24,0:29:07.66,Default,,0,0,0,,Бұл құралдар жинағында пайдалануға болатын нәрсе бар ма?
Dialogue: 0,0:29:07.87,0:29:09.58,Default,,0,0,0,,Иә~ Қолдануға болатын нәрсе бар ма?
Dialogue: 0,0:29:09.66,0:29:13.50,Default,,0,0,0,,Мм, мм... қайсысы? бұл...
Dialogue: 0,0:29:14.00,0:29:16.33,Default,,0,0,0,,Сәлем! Не? Бұл
Dialogue: 0,0:29:17.38,0:29:19.96,Default,,0,0,0,,Уа, ау!
Dialogue: 0,0:29:20.30,0:29:22.21,Default,,0,0,0,,Бұл шыбын-шіркей ме?
Dialogue: 0,0:29:22.46,0:29:23.76,Default,,0,0,0,,Фуфуфуу!
Dialogue: 0,0:29:24.38,0:29:26.93,Default,,0,0,0,,Бізде мұны істеуден басқа амал жоқ сияқты!
Dialogue: 0,0:29:27.14,0:29:28.64,Default,,0,0,0,,Ах! Ха!
Dialogue: 0,0:29:28.89,0:29:31.93,Default,,0,0,0,,Зоори мырза! Осымен басыңызды қорғаңыз!
Dialogue: 0,0:29:34.39,0:29:35.23,Default,,0,0,0,,Әй
Dialogue: 0,0:29:42.69,0:29:43.53,Default,,0,0,0,,Хмм
Dialogue: 0,0:29:46.57,0:29:48.03,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:29:51.74,0:29:52.66,Default,,0,0,0,,Цезарь Цеппели
Dialogue: 0,0:29:54.33,0:29:57.92,Default,,0,0,0,,Ха-ха-ха...
Dialogue: 0,0:29:58.04,0:29:59.79,Default,,0,0,0,,Жарайсың, Зори-сенсей!
Dialogue: 0,0:29:59.88,0:30:00.92,Default,,0,0,0,,Бұл тамаша.
Dialogue: 0,0:30:01.17,0:30:02.92,Default,,0,0,0,,А, тататата...
Dialogue: 0,0:30:04.46,0:30:07.93,Default,,0,0,0,,□※△×○…
Dialogue: 0,0:30:08.59,0:30:10.09,Default,,0,0,0,,Ей! Хмф!
Dialogue: 0,0:30:10.51,0:30:11.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:17.10,0:30:17.94,Default,,0,0,0,,Не?
Dialogue: 0,0:30:27.61,0:30:29.95,Default,,0,0,0,,Керісінше, қанша адам қарғысқа ұшырап өлетінін болжау мүмкін емес.
Dialogue: 0,0:30:34.70,0:30:36.75,Default,,0,0,0,,Эй, бұл арзан.
Dialogue: 0,0:30:37.08,0:30:38.37,Default,,0,0,0,,Уау! Уф...
Dialogue: 0,0:30:38.75,0:30:39.67,Default,,0,0,0,,Зорори-сан
Dialogue: 0,0:30:39.75,0:30:41.13,Default,,0,0,0,,Зоори мырза!
Dialogue: 0,0:30:44.92,0:30:46.63,Default,,0,0,0,,Уау... иә
Dialogue: 0,0:30:47.05,0:30:47.97,Default,,0,0,0,,Зоори мырза!
Dialogue: 0,0:30:48.09,0:30:48.93,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:30:49.68,0:30:50.51,Default,,0,0,0,,5-үй, «Малкольм» үй меңгерушісі
Dialogue: 0,0:30:50.84,0:30:53.35,Default,,0,0,0,,Мен мұны жеңемін.
Dialogue: 0,0:30:53.43,0:30:55.18,Default,,0,0,0,,Балалар, артқа тұрыңдар!
Dialogue: 0,0:30:58.27,0:31:00.65,Default,,0,0,0,,♬~
Dialogue: 0,0:31:01.19,0:31:03.15,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:31:07.69,0:31:10.41,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:31:10.74,0:31:11.70,Default,,0,0,0,,Қазіргі жасыңда мәңгі қалу—
Dialogue: 0,0:31:11.78,0:31:13.78,Default,,0,0,0,,Сіз күткендей, Зоори мырза!
Dialogue: 0,0:31:13.99,0:31:15.66,Default,,0,0,0,,Онша емес... аа
Dialogue: 0,0:31:18.62,0:31:20.16,Default,,0,0,0,,А, міне, осында.
Dialogue: 0,0:31:20.29,0:31:21.12,Default,,0,0,0,,Гаук
Dialogue: 0,0:31:21.75,0:31:22.58,Default,,0,0,0,,Тек бір сәттек ойыңмен одан көшіп кету...
Dialogue: 0,0:31:22.71,0:31:23.54,Default,,0,0,0,,О (құбыжық) О
Dialogue: 0,0:31:24.09,0:31:25.75,Default,,0,0,0,,Уф...
Dialogue: 0,0:31:25.88,0:31:26.84,Default,,0,0,0,,Зорори-сан
Dialogue: 0,0:31:27.17,0:31:28.84,Default,,0,0,0,,Ха! О!
Dialogue: 0,0:31:29.42,0:31:32.09,Default,,0,0,0,,Маған үнемі көмектесуді қаламаймын!
Dialogue: 0,0:31:32.84,0:31:33.85,Default,,0,0,0,,Мен де!
Dialogue: 0,0:31:34.35,0:31:35.35,Default,,0,0,0,,Сәлем! (2 адам) Әй?
Dialogue: 0,0:31:35.47,0:31:36.31,Default,,0,0,0,,​​О?
Dialogue: 0,0:31:36.51,0:31:37.81,Default,,0,0,0,,Сәлем! Әй құйрық!
Dialogue: 0,0:31:38.68,0:31:40.81,Default,,0,0,0,,Ой, бұл қорқынышты!
Dialogue: 0,0:31:41.19,0:31:44.11,Default,,0,0,0,,Уа, уау, уау!
Dialogue: 0,0:31:44.65,0:31:46.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:31:48.32,0:31:49.15,Default,,0,0,0,,Ой
Dialogue: 0,0:31:49.24,0:31:50.90,Default,,0,0,0,,Зоори мырза! Тайл-чан!
Dialogue: 0,0:31:53.57,0:31:54.41,Default,,0,0,0,,Гау
Dialogue: 0,0:31:54.49,0:31:55.33,Default,,0,0,0,,О... Иә?
Dialogue: 0,0:31:55.99,0:31:56.83,Default,,0,0,0,,Гаа!
Dialogue: 0,0:31:58.12,0:31:58.95,Default,,0,0,0,,Иә
Dialogue: 0,0:31:59.50,0:32:00.66,Default,,0,0,0,,♬~
Dialogue: 0,0:32:01.33,0:32:07.09,Default,,0,0,0,,Ооо аааааааааааааааааааааа...
Dialogue: 0,0:32:21.77,0:32:23.60,Default,,0,0,0,,(Тат тат тут…)
Dialogue: 0,0:32:23.69,0:32:25.44,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:32:27.73,0:32:29.07,Default,,0,0,0,,Зоори мырза
Dialogue: 0,0:32:29.44,0:32:30.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:32:32.74,0:32:33.99,Default,,0,0,0,,Жақсысың ба? құйрық
Dialogue: 0,0:32:34.11,0:32:34.95,Default,,0,0,0,,Иә
Dialogue: 0,0:32:35.28,0:32:36.12,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:32:37.91,0:32:40.16,Default,,0,0,0,,Иә? Уау... ә
Dialogue: 0,0:32:41.41,0:32:43.96,Default,,0,0,0,,Бүкіл бөлме сіздің денеңіз!
Dialogue: 0,0:32:44.50,0:32:47.09,Default,,0,0,0,,Бұл сіздің әкеңіз іздеген бөлме ме?
Dialogue: 0,0:32:47.17,0:32:49.46,Default,,0,0,0,,Бірақ мен оны алып жүре алмаймын, өйткені менде орын жеткіліксіз.
Dialogue: 0,0:32:49.84,0:32:52.47,Default,,0,0,0,,Егер бұл жай ғана есік болса, мен оны алып, өзіммен бірге ала аламын.
Dialogue: 0,0:32:55.13,0:32:55.97,Default,,0,0,0,,Аха? иә?
Dialogue: 0,0:32:58.43,0:33:00.93,Default,,0,0,0,,Кілт түгілі есік тұтқасы да жоқ.
Dialogue: 0,0:33:01.60,0:33:02.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:33:02.93,0:33:04.23,Default,,0,0,0,,Оны қалай ашуға болады?
Dialogue: 0,0:33:04.60,0:33:07.36,Default,,0,0,0,,Эй Ношиши, қалғанын шығар.
Dialogue: 0,0:33:08.02,0:33:08.90,Default,,0,0,0,,Иә
Dialogue: 0,0:33:10.53,0:33:12.19,Default,,0,0,0,,Хмм... мм?
Dialogue: 0,0:33:12.44,0:33:14.86,Default,,0,0,0,,Уау~ Уау... Уау...
Dialogue: 0,0:33:15.24,0:33:18.03,Default,,0,0,0,,Не істеп жатырсың... А?
Dialogue: 0,0:33:18.91,0:33:20.37,Default,,0,0,0,,Әй, солай!
Dialogue: 0,0:33:20.79,0:33:21.62,Default,,0,0,0,,Уга
Dialogue: 0,0:33:23.29,0:33:26.54,Default,,0,0,0,,Чу~пе
Dialogue: 0,0:33:27.17,0:33:28.63,Default,,0,0,0,,Чу~пе
Dialogue: 0,0:33:28.88,0:33:31.50,Default,,0,0,0,,Жарайды, осылай қалдырайық.
Dialogue: 0,0:33:35.13,0:33:36.88,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:33:37.18,0:33:38.01,Default,,0,0,0,,Иә!
Dialogue: 0,0:33:45.39,0:33:46.89,Default,,0,0,0,,О, бұл не? иә?
Dialogue: 0,0:33:47.85,0:33:49.77,Default,,0,0,0,,Бұл кілт пе?
Dialogue: 0,0:33:49.94,0:33:51.57,Default,,0,0,0,,Бұл біртүрлі пішін.
Dialogue: 0,0:33:51.65,0:33:53.48,Default,,0,0,0,,Пішіні біртүрлі.
Dialogue: 0,0:33:55.45,0:33:57.28,Default,,0,0,0,,Ммм...
Dialogue: 0,0:33:57.36,0:33:59.32,Default,,0,0,0,,Ах, Ни, Ня, Ах...
Dialogue: 0,0:33:59.99,0:34:01.33,Default,,0,0,0,,Эй, бұл...
Dialogue: 0,0:34:01.74,0:34:04.45,Default,,0,0,0,,Дәл сол ғибадатханадағы тесігінің пішіні сияқты емес пе?
Dialogue: 0,0:34:05.66,0:34:07.50,Default,,0,0,0,,Нағыз ана шығар?
Dialogue: 0,0:34:07.58,0:34:09.13,Default,,0,0,0,,Бұл ғибадатханада дегенді білдіре ме?
Dialogue: 0,0:34:09.21,0:34:11.09,Default,,0,0,0,,Егер сіз оны сол тесікке салсаңыз...
Dialogue: 0,0:34:11.17,0:34:12.84,Default,,0,0,0,,Отакара Зак Заку!
Dialogue: 0,0:34:13.13,0:34:13.96,Default,,0,0,0,,Ахаха
Dialogue: 0,0:34:16.05,0:34:18.34,Default,,0,0,0,,Сонда да мен есікті өзіммен бірге алып кетемін.
Dialogue: 0,0:34:19.72,0:34:20.68,Default,,0,0,0,,Келесі, келесі
Dialogue: 0,0:34:24.06,0:34:24.97,Default,,0,0,0,,Ал...
Dialogue: 0,0:34:28.81,0:34:30.23,Default,,0,0,0,,Мен... ау?
Dialogue: 0,0:34:31.06,0:34:31.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:37.03,0:34:38.45,Default,,0,0,0,,Сізге жақсы.
Dialogue: 0,0:34:38.53,0:34:41.37,Default,,0,0,0,,Енді оны қайда жіберсең де ұялмайсың.
Dialogue: 0,0:34:41.45,0:34:42.62,Default,,0,0,0,,Ишиши!
Dialogue: 0,0:34:43.12,0:34:44.66,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:34:44.74,0:34:47.25,Default,,0,0,0,,Тез келмесең, мен сені осында қалдырамын~
Dialogue: 0,0:34:47.33,0:34:49.29,Default,,0,0,0,,А, қазір кеттік!
Dialogue: 0,0:35:01.84,0:35:04.81,Default,,0,0,0,,Жарайды, аяқталды. Қағбаға асығайық.
Dialogue: 0,0:35:04.89,0:35:05.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:06.02,0:35:07.77,Default,,0,0,0,,Эй, бұл жолы не болып жатыр?
Dialogue: 0,0:35:07.85,0:35:10.44,Default,,0,0,0,,Хехе, не болса да таң қалмаймын.
Dialogue: 0,0:35:10.52,0:35:11.73,Default,,0,0,0,,Уау!
Dialogue: 0,0:35:12.06,0:35:13.90,Default,,0,0,0,,Бұл бұрынғы мұрын шашы!
Dialogue: 0,0:35:14.32,0:35:15.82,Default,,0,0,0,,Бұл қауіпті, асығыңыз!
Dialogue: 0,0:35:19.07,0:35:19.90,Default,,0,0,0,,Фугия~
Dialogue: 0,0:35:25.70,0:35:28.29,Default,,0,0,0,,О, менің Такаэда кесетін қайшым!
Dialogue: 0,0:35:28.62,0:35:30.62,Default,,0,0,0,,Тек бас тарт, Ишиши!
Dialogue: 0,0:35:30.71,0:35:34.21,Default,,0,0,0,,Такаедакири қайшы~!
Dialogue: 0,0:35:46.10,0:35:48.35,Default,,0,0,0,,Жақсы! Мен осылай өлемін!
Dialogue: 0,0:35:48.43,0:35:50.14,Default,,0,0,0,,Ах!
Dialogue: 0,0:35:50.85,0:35:54.15,Default,,0,0,0,,Бұрынғыдан үлкенірек сияқты!
Dialogue: 0,0:35:57.53,0:36:00.49,Default,,0,0,0,,Уф... Бұлай жалғаса берсе, жаншылып қаламын.
Dialogue: 0,0:36:05.78,0:36:07.33,Default,,0,0,0,,Мен қайтадан үлкен болдым.
Dialogue: 0,0:36:07.41,0:36:08.74,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:36:11.83,0:36:12.71,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:36:12.79,0:36:14.83,Default,,0,0,0,,Ах, бай адамдар осындай кемені бос уақыттарында пайдаланады —
Dialogue: 0,0:36:14.92,0:36:15.92,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,0:36:17.17,0:36:18.38,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:36:21.09,0:36:22.38,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:36:22.97,0:36:24.64,Default,,0,0,0,,Керемет! Зори-сан
Dialogue: 0,0:36:24.72,0:36:26.55,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:36:27.93,0:36:28.76,Default,,0,0,0,,Уау!
Dialogue: 0,0:36:41.40,0:36:42.78,Default,,0,0,0,,Ах!
Dialogue: 0,0:36:45.36,0:36:47.24,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:36:53.96,0:36:55.79,Default,,0,0,0,,Уау!
Dialogue: 0,0:36:59.46,0:37:00.34,Default,,0,0,0,,Уф...
Dialogue: 0,0:37:01.05,0:37:02.88,Default,,0,0,0,,Осы қарқынмен сіз тегістелетін боласыз!
Dialogue: 0,0:37:03.17,0:37:04.63,Default,,0,0,0,,Бұл енді мүмкін емес пе?
Dialogue: 0,0:37:05.05,0:37:05.89,Default,,0,0,0,,Әй?
Dialogue: 0,0:37:10.06,0:37:10.89,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:37:19.15,0:37:20.44,Default,,0,0,0,,Хияхо~!
Dialogue: 0,0:37:20.52,0:37:21.48,Default,,0,0,0,,Зоори мырза!
Dialogue: 0,0:37:21.57,0:37:23.74,Default,,0,0,0,,Фу~ Мен уақытында үлгердім.
Dialogue: 0,0:37:24.70,0:37:25.95,Default,,0,0,0,,Айқай~
Dialogue: 0,0:37:26.49,0:37:28.32,Default,,0,0,0,,Басын сыртқа шығару
Dialogue: 0,0:37:28.57,0:37:31.74,Default,,0,0,0,,Мынау жаныңды жылытады.
Dialogue: 0,0:37:31.83,0:37:32.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:33.20,0:37:37.00,Default,,0,0,0,,Менің басымда жылы болды. Хе.
Dialogue: 0,0:37:37.08,0:37:38.75,Default,,0,0,0,,Суб~ Уф... Уф
Dialogue: 0,0:37:38.83,0:37:39.67,Default,,0,0,0,,Ммм
Dialogue: 0,0:37:40.00,0:37:43.30,Default,,0,0,0,,А-а... Әйтеуір, енді бұл жерде саған пайдасы жоқ.
Dialogue: 0,0:37:43.38,0:37:45.13,Default,,0,0,0,,Жүр, зияратқа асығайық!
Dialogue: 0,0:37:56.31,0:37:57.73,Default,,0,0,0,,(Ишиши мен Ношишидің күлкілері)
Dialogue: 0,0:37:57.81,0:37:59.81,Default,,0,0,0,,Хахахаха иә?
Dialogue: 0,0:38:00.90,0:38:02.40,Default,,0,0,0,,Не болды? құйрық
Dialogue: 0,0:38:03.44,0:38:07.41,Default,,0,0,0,,Мен шытырман оқиғаны ойнау сияқты деп ойладым.
Dialogue: 0,0:38:08.20,0:38:11.28,Default,,0,0,0,,Бірақ бұл шын мәнінде қиын.
Dialogue: 0,0:38:11.37,0:38:13.83,Default,,0,0,0,,Жалғыз болған дұрыс емес пе?
Dialogue: 0,0:38:13.91,0:38:15.08,Default,,0,0,0,,Бұл солай ма?
Dialogue: 0,0:38:15.16,0:38:16.04,Default,,0,0,0,,Жоқ
Dialogue: 0,0:38:16.62,0:38:19.67,Default,,0,0,0,,Үйге өзім де келе алмадым.
Dialogue: 0,0:38:19.75,0:38:22.46,Default,,0,0,0,,О? Не болды?
Dialogue: 0,0:38:22.59,0:38:24.34,Default,,0,0,0,,Бұл өте жаман
Dialogue: 0,0:38:24.84,0:38:27.26,Default,,0,0,0,,Мен үшін шытырман оқиғаларды жасау мүмкін емес
Dialogue: 0,0:38:27.43,0:38:28.88,Default,,0,0,0,,Егер бұл Зори-сан болса, тіпті бір адам болса да...
Dialogue: 0,0:38:28.97,0:38:29.80,Default,,0,0,0,,Бұл басқаша.
Dialogue: 0,0:38:30.39,0:38:33.06,Default,,0,0,0,,Менде Ишиши мен Ношиши бар.
Dialogue: 0,0:38:33.14,0:38:36.43,Default,,0,0,0,,Біз бірге болғандықтан, біз әрқашан алға жылжи аламыз.
Dialogue: 0,0:38:38.14,0:38:39.31,Default,,0,0,0,,Эх!
Dialogue: 0,0:38:39.48,0:38:41.36,Default,,0,0,0,,Жоқ, жоқ, мен ұялып тұрмын.
Dialogue: 0,0:38:41.44,0:38:43.32,Default,,0,0,0,,Еріп барады, хехе
Dialogue: 0,0:38:43.57,0:38:44.86,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:38:45.74,0:38:49.91,Default,,0,0,0,,Оның үстіне, көктегі анам мені үнемі бақылап тұрады.
Dialogue: 0,0:38:50.41,0:38:51.57,Default,,0,0,0,,Аспан?
Dialogue: 0,0:38:51.74,0:38:52.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:53.99,0:38:55.70,Default,,0,0,0,,Уау! Алақай!
Dialogue: 0,0:39:01.25,0:39:02.63,Default,,0,0,0,,Не? Сонымен...
Dialogue: 0,0:39:02.71,0:39:04.34,Default,,0,0,0,,Хахахаха (2 адам) Иә?
Dialogue: 0,0:39:04.55,0:39:07.42,Default,,0,0,0,,Зорори, сен қазынаңды тапқан сияқтысың.
Dialogue: 0,0:39:08.13,0:39:10.09,Default,,0,0,0,,Бұл сөзсіз сенсің, Жолбарыс!
Dialogue: 0,0:39:10.18,0:39:12.39,Default,,0,0,0,,Бұл жолы мен аспанда дұрыс ұшамын.
Dialogue: 0,0:39:12.60,0:39:13.43,Default,,0,0,0,,Өте! Гайя!
Dialogue: 0,0:39:16.22,0:39:17.27,Default,,0,0,0,,Уау!
Dialogue: 0,0:39:20.60,0:39:22.27,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:39:22.52,0:39:25.27,Default,,0,0,0,,Зорори, егер сен үндемесең және маған қазынаңды берсең, мен сені кешіремін.
Dialogue: 0,0:39:25.44,0:39:28.07,Default,,0,0,0,,Маңызды кілтімді жолбарыс алып кеткеніне шыдай алмаймын!
Dialogue: 0,0:39:28.57,0:39:30.28,Default,,0,0,0,,Мықтап ұстаңыз!
Dialogue: 0,0:39:39.16,0:39:41.58,Default,,0,0,0,,Ммм... не?
Dialogue: 0,0:39:42.46,0:39:44.92,Default,,0,0,0,,Уау... бұл көп су...
Dialogue: 0,0:39:47.59,0:39:48.76,Default,,0,0,0,,Ой
Dialogue: 0,0:39:52.39,0:39:53.22,Default,,0,0,0,,Уау!
Dialogue: 0,0:39:53.55,0:39:56.43,Default,,0,0,0,,Сәлем! Сәл ғана қозғал
Dialogue: 0,0:39:56.68,0:39:58.14,Default,,0,0,0,,Дайын бол!
Dialogue: 0,0:39:59.85,0:40:01.23,Default,,0,0,0,,Өте~!
Dialogue: 0,0:40:05.90,0:40:07.07,Default,,0,0,0,,Уау!
Dialogue: 0,0:40:07.98,0:40:09.03,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:40:11.07,0:40:11.95,Default,,0,0,0,,Иә
Dialogue: 0,0:40:14.87,0:40:17.87,Default,,0,0,0,,Мияу мияу... (Ишиши Ношиши) Ммм~
Dialogue: 0,0:40:18.20,0:40:19.04,Default,,0,0,0,,Саңырауқұлақтар~!
Dialogue: 0,0:40:19.12,0:40:20.37,Default,,0,0,0,,Керемет кадр! Хмф
Dialogue: 0,0:40:21.00,0:40:22.12,Default,,0,0,0,,Керемет кадр! Хмф
Dialogue: 0,0:40:22.21,0:40:23.50,Default,,0,0,0,,Керемет кадр! Хмм
Dialogue: 0,0:40:23.58,0:40:25.21,Default,,0,0,0,,Керемет кадр! иә~!
Dialogue: 0,0:40:25.29,0:40:26.46,Default,,0,0,0,,Керемет кадр! Мен оны алдым!
Dialogue: 0,0:40:26.54,0:40:27.38,Default,,0,0,0,,Керемет кадр!
Dialogue: 0,0:40:28.13,0:40:29.67,Default,,0,0,0,,Енді...
Dialogue: 0,0:40:30.63,0:40:34.26,Default,,0,0,0,,Хмм! Ол шешілді!
Dialogue: 0,0:40:38.93,0:40:40.35,Default,,0,0,0,,Жоқ, жоқ...
Dialogue: 0,0:40:42.39,0:40:44.52,Default,,0,0,0,,Иә? Ой, кешіріңіз~
Dialogue: 0,0:40:44.73,0:40:46.90,Default,,0,0,0,,Оны пайдаланудан басқа амалым жоқ сияқты.
Dialogue: 0,0:40:46.98,0:40:47.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:52.15,0:40:55.11,Default,,0,0,0,,Трансформация түрлендіру
Dialogue: 0,0:40:58.41,0:41:01.08,Default,,0,0,0,,Трансформация түрлендіру
Dialogue: 0,0:41:03.37,0:41:04.92,Default,,0,0,0,,Міне! Зорори
Dialogue: 0,0:41:05.08,0:41:09.09,Default,,0,0,0,,Мен зұлымдықты жеңу үшін істей аламын!
Dialogue: 0,0:41:14.93,0:41:15.89,Default,,0,0,0,,Не?
Dialogue: 0,0:41:27.56,0:41:28.52,Default,,0,0,0,,Уваах! Көзім…
Dialogue: 0,0:41:28.98,0:41:30.82,Default,,0,0,0,,Уау! Бұл робот хаха
Dialogue: 0,0:41:30.90,0:41:32.44,Default,,0,0,0,,Какаши… Каччои~
Dialogue: 0,0:41:33.32,0:41:34.82,Default,,0,0,0,,Ей Эй!
Dialogue: 0,0:41:36.32,0:41:37.41,Default,,0,0,0,,Уау!
Dialogue: 0,0:41:37.49,0:41:38.32,Default,,0,0,0,,Уау!
Dialogue: 0,0:41:45.62,0:41:46.46,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:41:46.54,0:41:48.21,Default,,0,0,0,,Егер бұл орын алса, сіз осырасыз.
Dialogue: 0,0:41:48.29,0:41:49.13,Default,,0,0,0,,Иә
Dialogue: 0,0:41:49.84,0:41:51.05,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:41:51.96,0:41:54.88,Default,,0,0,0,,Зорори Жарайсың! иә?
Dialogue: 0,0:41:55.97,0:41:56.80,Default,,0,0,0,,Нянга!
Dialogue: 0,0:41:56.88,0:41:58.34,Default,,0,0,0,,Бұған жол бермеңіз
Dialogue: 0,0:41:58.47,0:41:59.55,Default,,0,0,0,,Жарайды, бірде бірге шай ішуге баруымыз керек қой?
Dialogue: 0,0:41:59.68,0:42:01.26,Default,,0,0,0,,Хенофский Рюуши Хаша!
Dialogue: 0,0:42:06.27,0:42:07.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:07.31,0:42:10.56,Default,,0,0,0,,Ой~ Бұл раушан гүлдерінің иісі~
Dialogue: 0,0:42:10.86,0:42:13.90,Default,,0,0,0,,Хахахаха! Бұл Хенофский айдаһары
Dialogue: 0,0:42:13.98,0:42:17.57,Default,,0,0,0,,Тіпті ең сасық фарттар да жарамсыз болуы мүмкін!
Dialogue: 0,0:42:17.66,0:42:19.70,Default,,0,0,0,,Жарайды, барлығын бірден аяқтаймыз.
Dialogue: 0,0:42:19.78,0:42:20.62,Default,,0,0,0,,Сәлем
Dialogue: 0,0:42:20.74,0:42:22.08,Default,,0,0,0,,Уф уау~
Dialogue: 0,0:42:22.16,0:42:23.49,Default,,0,0,0,,Уау!
Dialogue: 0,0:42:23.58,0:42:24.41,Default,,0,0,0,,Құйрық!
Dialogue: 0,0:42:25.41,0:42:27.04,Default,,0,0,0,,Уау...
Dialogue: 0,0:42:27.41,0:42:29.04,Default,,0,0,0,,Не? Мұнда!
Dialogue: 0,0:42:29.29,0:42:30.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:42:30.71,0:42:33.00,Default,,0,0,0,,Хехехе, солай.
Dialogue: 0,0:42:33.21,0:42:34.59,Default,,0,0,0,,Құйрықты босатыңыз!
Dialogue: 0,0:42:35.09,0:42:36.63,Default,,0,0,0,,Ей, берілме!
Dialogue: 0,0:42:39.13,0:42:40.55,Default,,0,0,0,,Қош бол!
Dialogue: 0,0:42:40.80,0:42:41.85,Default,,0,0,0,,Ах!
Dialogue: 0,0:42:41.93,0:42:44.01,Default,,0,0,0,,Хмм (2 адам) Сәлем!
Dialogue: 0,0:42:47.23,0:42:48.06,Default,,0,0,0,,А...
Dialogue: 0,0:42:50.65,0:42:51.65,Default,,0,0,0,,Иә!
Dialogue: 0,0:42:51.73,0:42:53.19,Default,,0,0,0,,Не болды?
Dialogue: 0,0:42:53.27,0:42:54.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:58.57,0:42:59.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:43:00.91,0:43:01.87,Default,,0,0,0,,Ммм...
Dialogue: 0,0:43:02.16,0:43:04.37,Default,,0,0,0,,Не... Құдай-ау!
Dialogue: 0,0:43:08.16,0:43:09.00,Default,,0,0,0,,Зорори-сан
Dialogue: 0,0:43:21.76,0:43:25.76,Default,,0,0,0,,Уа!
Dialogue: 0,0:43:34.27,0:43:35.11,Default,,0,0,0,,Құйрық
Dialogue: 0,0:43:35.94,0:43:36.86,Default,,0,0,0,,Зорори-сан
Dialogue: 0,0:43:43.99,0:43:45.99,Default,,0,0,0,,Жүр, Құйрықтар, осы жаққа кел.
Dialogue: 0,0:43:46.08,0:43:47.62,Default,,0,0,0,,Иә, Зори-сан.
Dialogue: 0,0:43:51.87,0:43:53.08,Default,,0,0,0,,Сіз ауырып қалдыңыз ба?
Dialogue: 0,0:43:54.00,0:43:54.84,Default,,0,0,0,,Иә
Dialogue: 0,0:43:55.96,0:43:59.05,Default,,0,0,0,,Хахахаха! Не болды, Жолбарыс!
Dialogue: 0,0:43:59.13,0:44:00.80,Default,,0,0,0,,Бұл менің Sekizo роботым!
Dialogue: 0,0:44:01.13,0:44:02.76,Default,,0,0,0,,Ақымақ болма... Ақымақ болма!
Dialogue: 0,0:44:02.84,0:44:04.47,Default,,0,0,0,,Осындай ыңғайсыз роботқа
Dialogue: 0,0:44:04.55,0:44:07.51,Default,,0,0,0,,Біздің қарақшы кеме роботының жеңіліп қалуы мүмкін емес!
Dialogue: 0,0:44:08.89,0:44:12.77,Default,,0,0,0,,(Сентай Робо музыкасы)
Dialogue: 0,0:44:15.48,0:44:16.52,Default,,0,0,0,,артта қалды
Dialogue: 0,0:44:16.98,0:44:20.19,Default,,0,0,0,,Мен сізге қарақшы кеме роботының күшін көрсетемін!
Dialogue: 0,0:44:20.86,0:44:22.40,Default,,0,0,0,,Жоқ... хмм...
Dialogue: 0,0:44:22.49,0:44:24.78,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе, Зори-сенсей!
Dialogue: 0,0:44:25.95,0:44:26.78,Default,,0,0,0,,Хмм...
Dialogue: 0,0:44:26.87,0:44:28.66,Default,,0,0,0,,Сәттілік тілеймін, Зори-сан
Dialogue: 0,0:44:28.74,0:44:29.70,Default,,0,0,0,,Иә... ха
Dialogue: 0,0:44:34.46,0:44:35.71,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:44:37.67,0:44:39.17,Default,,0,0,0,,Уау, о...
Dialogue: 0,0:44:40.30,0:44:41.13,Default,,0,0,0,,Нуууу
Dialogue: 0,0:44:41.38,0:44:43.05,Default,,0,0,0,,Тора Тора Тора…
Dialogue: 0,0:44:43.47,0:44:45.05,Default,,0,0,0,,Оототототоё…
Dialogue: 0,0:44:45.34,0:44:47.72,Default,,0,0,0,,Тора Тора Тора…
Dialogue: 0,0:44:47.89,0:44:51.77,Default,,0,0,0,,О, о, эй... Эй... Зорори!
Dialogue: 0,0:44:51.85,0:44:54.77,Default,,0,0,0,,Соңы жақындап қалған сияқты.
Dialogue: 0,0:44:56.56,0:44:58.07,Default,,0,0,0,,А... солай сияқты.
Dialogue: 0,0:44:58.48,0:45:00.90,Default,,0,0,0,,Е, күте тұр... Зори-сан, сен не айтып тұрсың?
Dialogue: 0,0:45:01.36,0:45:04.49,Default,,0,0,0,,Әй, сен сондай түсінікті екенсің ғой?
Dialogue: 0,0:45:04.57,0:45:05.57,Default,,0,0,0,,Рахмет
Dialogue: 0,0:45:06.03,0:45:08.70,Default,,0,0,0,,Ей, сендер де бірдеңе айтыңдар.
Dialogue: 0,0:45:08.78,0:45:09.95,Default,,0,0,0,,Е... Е!
Dialogue: 0,0:45:11.91,0:45:14.37,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:45:14.92,0:45:15.75,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:45:15.83,0:45:17.96,Default,,0,0,0,,Егер сіз бірдеңе айтқыңыз келсе, мен сізден сұраймын.
Dialogue: 0,0:45:18.59,0:45:20.13,Default,,0,0,0,,Сонда бір ғана нәрсе.
Dialogue: 0,0:45:20.21,0:45:21.71,Default,,0,0,0,,Осылай жалғастыра бересің бе…
Dialogue: 0,0:45:26.59,0:45:27.43,Default,,0,0,0,,Нихи
Dialogue: 0,0:45:27.97,0:45:29.26,Default,,0,0,0,,Dekkopi~n!
Dialogue: 0,0:45:29.43,0:45:30.26,Default,,0,0,0,,Дохо
Dialogue: 0,0:45:31.60,0:45:34.85,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:45:37.44,0:45:39.15,Default,,0,0,0,,Иә!
Dialogue: 0,0:45:41.86,0:45:42.69,Default,,0,0,0,,Гехо
Dialogue: 0,0:45:43.90,0:45:45.28,Default,,0,0,0,,Боқ~
Dialogue: 0,0:45:45.65,0:45:49.12,Default,,0,0,0,,Күте тұрыңыз, Нянга! Стратегияның уақыты келді!
Dialogue: 0,0:45:49.32,0:45:50.95,Default,,0,0,0,,Тез шық (Гашаан!)
Dialogue: 0,0:45:51.03,0:45:52.70,Default,,0,0,0,,А? О, о?
Dialogue: 0,0:45:52.83,0:45:56.58,Default,,0,0,0,,Жеңіске жету мүмкіндігі жоқ шайқасқа бұдан әрі араласуға ниетім жоқ!
Dialogue: 0,0:45:56.67,0:45:57.50,Default,,0,0,0,,Хмм.
Dialogue: 0,0:45:57.58,0:46:00.75,Default,,0,0,0,,Мен бұл ашудың ашуын сейілтемін.
Dialogue: 0,0:46:00.84,0:46:03.21,Default,,0,0,0,,Жолбарыстың ақымақ! Нақұрыс!
Dialogue: 0,0:46:03.71,0:46:06.26,Default,,0,0,0,,Уф... күте тұрыңыз! Күте тұрыңыз! иә?
Dialogue: 0,0:46:06.34,0:46:08.22,Default,,0,0,0,,Сен жеңілдің, Жолбарыс!
Dialogue: 0,0:46:08.64,0:46:12.14,Default,,0,0,0,,Егер бұлай болса, мен бәріңді өзіммен бірге алып кетемін.
Dialogue: 0,0:46:14.27,0:46:16.64,Default,,0,0,0,,Хмф! Одан қорықпа!
Dialogue: 0,0:46:16.73,0:46:17.69,Default,,0,0,0,,Иә, иә...
Dialogue: 0,0:46:18.02,0:46:21.23,Default,,0,0,0,,Хмф! Мен бұрынғы адамнан басқашамын.
Dialogue: 0,0:46:21.73,0:46:22.69,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:46:23.19,0:46:26.20,Default,,0,0,0,,Хахахаха Бұл Джонокучи
Dialogue: 0,0:46:26.49,0:46:28.24,Default,,0,0,0,,Егер сіз бұл амулетті барынша көтерсеңіз
Dialogue: 0,0:46:28.74,0:46:30.78,Default,,0,0,0,,Барлығың шашлык жасап жатырсыңдар.
Dialogue: 0,0:46:30.87,0:46:31.74,Default,,0,0,0,,Зорори-сан
Dialogue: 0,0:46:32.66,0:46:34.08,Default,,0,0,0,,Уайымдама Құйрық.
Dialogue: 0,0:46:34.33,0:46:36.25,Default,,0,0,0,,Мен сені дұрыс қорғаймын.
Dialogue: 0,0:46:36.33,0:46:37.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:37.37,0:46:38.67,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:46:38.75,0:46:41.79,Default,,0,0,0,,Ең болмаса, мені соңына дейін қорға.
Dialogue: 0,0:46:41.92,0:46:43.17,Default,,0,0,0,,Қоштасу Зори
Dialogue: 0,0:46:43.84,0:46:44.67,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:46:45.63,0:46:46.92,Default,,0,0,0,,Уф... Иә?
Dialogue: 0,0:46:47.26,0:46:49.55,Default,,0,0,0,,Сәлем! О жоқ~
Dialogue: 0,0:46:49.89,0:46:52.93,Default,,0,0,0,,Мынау... мынау! Әй, солай
Dialogue: 0,0:46:53.18,0:46:55.56,Default,,0,0,0,,Нуа~!
Dialogue: 0,0:46:57.18,0:46:58.52,Default,,0,0,0,,Аа...
Dialogue: 0,0:46:58.60,0:47:00.52,Default,,0,0,0,,Сіз бәрібір жеңдіңіз бе?
Dialogue: 0,0:47:00.60,0:47:01.56,Default,,0,0,0,,Зорори-сан
Dialogue: 0,0:47:01.86,0:47:02.69,Default,,0,0,0,,О
Dialogue: 0,0:47:03.57,0:47:04.73,Default,,0,0,0,,Ум...
Dialogue: 0,0:47:05.03,0:47:05.90,Default,,0,0,0,,Не болды?
Dialogue: 0,0:47:06.19,0:47:08.15,Default,,0,0,0,,Екеуің бірге жасасаңдар, бұл жақсырақ болады.
Dialogue: 0,0:47:08.24,0:47:10.74,Default,,0,0,0,,Мен сені қатты қызғанамын
Dialogue: 0,0:47:10.82,0:47:11.70,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:47:11.78,0:47:14.79,Default,,0,0,0,,Енді мен кедергіні жеңдім.
Dialogue: 0,0:47:15.04,0:47:17.54,Default,,0,0,0,,Қалғаны әкенің денесі, Құйрық.
Dialogue: 0,0:47:18.41,0:47:19.25,Default,,0,0,0,,Иә
Dialogue: 0,0:47:22.08,0:47:23.00,Default,,0,0,0,,Оларды осы жаққа жіберіңізші.
Dialogue: 0,0:47:27.76,0:47:28.59,Default,,0,0,0,,Әй?
Dialogue: 0,0:47:28.67,0:47:29.97,Default,,0,0,0,,Зоори мырза
Dialogue: 0,0:47:30.05,0:47:31.22,Default,,0,0,0,,Ештеңе болмайды.
Dialogue: 0,0:47:31.89,0:47:32.72,Default,,0,0,0,,Хмм...
Dialogue: 0,0:47:33.14,0:47:33.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:34.39,0:47:35.22,Default,,0,0,0,,Не?
Dialogue: 0,0:47:37.18,0:47:38.48,Default,,0,0,0,,Дева Дева…
Dialogue: 0,0:47:38.56,0:47:40.60,Default,,0,0,0,,А, мен жүре бастадым.
Dialogue: 0,0:47:41.02,0:47:43.27,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:47:43.86,0:47:44.73,Default,,0,0,0,,Олар үшін де тойып жеңіздер
Dialogue: 0,0:47:45.15,0:47:47.90,Default,,0,0,0,,Бұл жігіт сені бар жеріңе апарады.
Dialogue: 0,0:47:48.36,0:47:50.61,Default,,0,0,0,,Ах~ Мен сенімдімін.
Dialogue: 0,0:47:50.70,0:47:51.53,Default,,0,0,0,,Отакара~
Dialogue: 0,0:47:51.61,0:47:53.37,Default,,0,0,0,,Ләззат алыңыз! Секизо Робо!
Dialogue: 0,0:47:53.45,0:47:56.16,Default,,0,0,0,,Бізге Отакараға дейін жол көрсетіңіз!
Dialogue: 0,0:47:56.24,0:47:57.74,Default,,0,0,0,,Yaho!
Dialogue: 0,0:47:58.29,0:47:59.87,Default,,0,0,0,,Дува ду…
Dialogue: 0,0:48:02.58,0:48:04.29,Default,,0,0,0,,Ой... тоқтады.
Dialogue: 0,0:48:04.59,0:48:06.50,Default,,0,0,0,,Мен жаңа ғана аяғымды соқтым.
Dialogue: 0,0:48:06.59,0:48:08.59,Default,,0,0,0,,Бұл тамаша
Dialogue: 0,0:48:08.67,0:48:11.26,Default,,0,0,0,,Мұғалім, ұйықтағың келе ме?
Dialogue: 0,0:48:11.34,0:48:12.26,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:48:12.80,0:48:13.93,Default,,0,0,0,,Эй... қал!
Dialogue: 0,0:48:14.01,0:48:16.56,Default,,0,0,0,,Нанана... Не?
Dialogue: 0,0:48:16.64,0:48:17.60,Default,,0,0,0,,♬~
Dialogue: 0,0:48:17.97,0:48:20.68,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:48:32.28,0:48:33.41,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:48:33.99,0:48:35.03,Default,,0,0,0,,Бұл?
Dialogue: 0,0:48:35.37,0:48:36.74,Default,,0,0,0,,Бұл осында.
Dialogue: 0,0:48:37.95,0:48:40.04,Default,,0,0,0,,Бұл сіздің денеңіз болса керек.
Dialogue: 0,0:48:40.58,0:48:42.83,Default,,0,0,0,,Бұл суды шынымен қалайсыз ба?
Dialogue: 0,0:48:42.91,0:48:43.75,Default,,0,0,0,,О
Dialogue: 0,0:48:44.42,0:48:47.09,Default,,0,0,0,,Сіз оны естисіз, солай ма? Ауыл тұрғындарының қуанған дауыстарын естідім.
Dialogue: 0,0:48:47.29,0:48:49.84,Default,,0,0,0,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:48:50.76,0:48:55.14,Default,,0,0,0,,Әкем осы күлкіні көру үшін жынды болып кете берді.
Dialogue: 0,0:48:55.30,0:48:56.51,Default,,0,0,0,,Союкото~
Dialogue: 0,0:48:57.26,0:48:58.14,Default,,0,0,0,,(та та та та)
Dialogue: 0,0:48:58.22,0:48:59.06,Default,,0,0,0,,Йотто иә?
Dialogue: 0,0:48:59.31,0:49:00.85,Default,,0,0,0,,Эх, Зори-сан
Dialogue: 0,0:49:00.93,0:49:02.77,Default,,0,0,0,,(Зоридің күлуі)
Dialogue: 0,0:49:03.60,0:49:04.44,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:49:05.06,0:49:06.40,Default,,0,0,0,,Ол өте жаман әке.
Dialogue: 0,0:49:06.52,0:49:07.36,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:49:07.44,0:49:09.73,Default,,0,0,0,,Осымен оны тауға да бөлуге болмайды.
Dialogue: 0,0:49:09.82,0:49:11.57,Default,,0,0,0,,Құлайтындай… Бұл қылыш…
Dialogue: 0,0:49:11.65,0:49:14.32,Default,,0,0,0,,Қорқынышты, Зори-сан, қойшы, қой.
Dialogue: 0,0:49:14.40,0:49:19.37,Default,,0,0,0,,Зори-сан, ауылды құтқарғаныңа көп рахмет.
Dialogue: 0,0:49:19.53,0:49:22.91,Default,,0,0,0,,Бұл кішкентай ауыл, бірақ мен патша болғым келеді.
Dialogue: 0,0:49:23.00,0:49:25.50,Default,,0,0,0,,Мені қорғауды жалғастыра аласыз ба?
Dialogue: 0,0:49:26.29,0:49:28.79,Default,,0,0,0,,Мен... патшамын ба?
Dialogue: 0,0:49:28.88,0:49:29.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:49:29.84,0:49:31.67,Default,,0,0,0,,Зорори Сенсей~ Хэхехе
Dialogue: 0,0:49:32.21,0:49:33.55,Default,,0,0,0,,Жаңа жөндеу жұмыстары да
Dialogue: 0,0:49:33.63,0:49:36.80,Default,,0,0,0,,Бұл аяқталуға жақын, король.
Dialogue: 0,0:49:36.89,0:49:39.81,Default,,0,0,0,,Ах... Оширо~? Ахахха
Dialogue: 0,0:49:39.89,0:49:42.72,Default,,0,0,0,,Охиме-сама осында болғанша~
Dialogue: 0,0:49:43.06,0:49:45.02,Default,,0,0,0,,Техехе, солай ма?
Dialogue: 0,0:49:45.10,0:49:46.90,Default,,0,0,0,,Не? Не? Қайда?
Dialogue: 0,0:49:46.98,0:49:47.81,Default,,0,0,0,,Жоқ, қайда?
Dialogue: 0,0:49:47.90,0:49:50.19,Default,,0,0,0,,Мен Тэильге ұсыныс жасағалы жатырмын~
Dialogue: 0,0:49:50.27,0:49:51.69,Default,,0,0,0,,Ұсыну керек пе?
Dialogue: 0,0:49:52.19,0:49:53.15,Default,,0,0,0,,Не болды, мырза Мокки!
Dialogue: 0,0:49:53.24,0:49:55.40,Default,,0,0,0,,Олардың қабылдайтынына сенімдімін.
Dialogue: 0,0:49:55.49,0:49:56.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:56.91,0:49:59.41,Default,,0,0,0,,Ұсыныс! иә! Ұсыныс!
Dialogue: 0,0:49:59.49,0:50:01.70,Default,,0,0,0,,Жарайсыңдар! Мен, ертең таңертең
Dialogue: 0,0:50:01.79,0:50:04.00,Default,,0,0,0,,Мен Құйрықтарға ұсыныс жасағалы жатырмын!
Dialogue: 0,0:50:04.08,0:50:05.50,Default,,0,0,0,,Иә!
Dialogue: 0,0:50:14.80,0:50:17.97,Default,,0,0,0,,Зооридің еркін және пайдалы өмір салты
Dialogue: 0,0:50:18.30,0:50:20.55,Default,,0,0,0,,Мен осылай деп ойладым.
Dialogue: 0,0:50:21.22,0:50:23.06,Default,,0,0,0,,Сондықтан мен де бар күшімді саламын
Dialogue: 0,0:50:23.14,0:50:24.85,Default,,0,0,0,,Шытырман оқиғалы саяхатқа шығу
Dialogue: 0,0:50:25.35,0:50:26.52,Default,,0,0,0,,Және бір күні
Dialogue: 0,0:50:26.73,0:50:28.65,Default,,0,0,0,,Зоори мен сенің әкең сияқты.
Dialogue: 0,0:50:29.86,0:50:32.82,Default,,0,0,0,,Қысқасы, бұл хат қоштасу ма?
Dialogue: 0,0:50:33.02,0:50:35.49,Default,,0,0,0,,Мен Зорори-сенсейге ғашық емес едім.
Dialogue: 0,0:50:35.57,0:50:36.95,Default,,0,0,0,,Өмір жолына ғашық болдым
Dialogue: 0,0:50:37.03,0:50:37.86,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:50:38.20,0:50:39.82,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:50:39.91,0:50:41.74,Default,,0,0,0,,Зоори мырзаның тамаша жейдесі бар.
Dialogue: 0,0:50:41.83,0:50:42.87,Default,,0,0,0,,солай емес пе?
Dialogue: 0,0:50:42.95,0:50:45.83,Default,,0,0,0,,Міне, менің бір арманым орындалды, Сенсей!
Dialogue: 0,0:50:45.91,0:50:48.50,Default,,0,0,0,,Қараңдаршы, ақ көгершін осылай ұшып кетті.
Dialogue: 0,0:50:48.58,0:50:50.50,Default,,0,0,0,,Бұл бақытты түйеқұс
Dialogue: 0,0:50:50.58,0:50:52.38,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:50:56.51,0:50:58.22,Default,,0,0,0,,Маған жер астында шабуыл жасалды.
Dialogue: 0,0:50:58.30,0:50:59.93,Default,,0,0,0,,Су да көп шықты.
Dialogue: 0,0:51:00.01,0:51:01.89,Default,,0,0,0,,Ол сынғыш болып кетті ме?
Dialogue: 0,0:51:01.97,0:51:06.39,Default,,0,0,0,,Қырықша… әрине!
Dialogue: 0,0:51:07.31,0:51:09.69,Default,,0,0,0,,Соңында мен және Тэйл-чан
Dialogue: 0,0:51:09.77,0:51:12.73,Default,,0,0,0,,Оларды қызыл жіппен байламау керек еді.
Dialogue: 0,0:51:13.40,0:51:14.98,Default,,0,0,0,,Зоори мырза...
Dialogue: 0,0:51:16.69,0:51:18.28,Default,,0,0,0,,Хе-хе, хе-хе-хе…
Dialogue: 0,0:51:19.32,0:51:21.87,Default,,0,0,0,,Қызыл жіпті ханшайым басқа жерде!
Dialogue: 0,0:51:21.99,0:51:22.82,Default,,0,0,0,,Ах!
Dialogue: 0,0:51:22.91,0:51:25.41,Default,,0,0,0,,Енді кеттік! Ишиши Ношиши!
Dialogue: 0,0:51:26.29,0:51:27.41,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:51:27.83,0:51:30.79,Default,,0,0,0,,♪ Рахмет
Dialogue: 0,0:51:32.58,0:51:36.30,Default,,0,0,0,,♪ Құлаған сызаттар саны
Dialogue: 0,0:51:36.38,0:51:39.80,Default,,0,0,0,,♪ Ертеңгі күнге сәттілік
Dialogue: 0,0:51:40.18,0:51:43.05,Default,,0,0,0,,♪ Еңіс қанша тік болса да
Dialogue: 0,0:51:43.51,0:51:47.02,Default,,0,0,0,,♪ Біз одан асып кетуіміз керек
Dialogue: 0,0:51:47.10,0:51:49.94,Default,,0,0,0,,♪ Алдағы жол әлі төбе
Dialogue: 0,0:51:50.02,0:51:51.31,Default,,0,0,0,,Маған қарашы, анашым.
Dialogue: 0,0:51:51.48,0:51:52.98,Default,,0,0,0,,Ошироны алатыныңызға сенімдімін.
Dialogue: 0,0:51:53.06,0:51:55.61,Default,,0,0,0,,Мен сүйкімді ханшайым табамын
Dialogue: 0,0:51:57.28,0:52:00.65,Default,,0,0,0,,♪ Ауырсынып жылайтын күндерімнің өзінде
Dialogue: 0,0:52:01.15,0:52:04.49,Default,,0,0,0,,♪ Ертеңгі қазына
Dialogue: 0,0:52:04.74,0:52:08.08,Default,,0,0,0,,♪ Nayami-nutied қабырға
Dialogue: 0,0:52:08.29,0:52:11.83,Default,,0,0,0,,♪ Мен іздерді өзгерттім
Dialogue: 0,0:52:12.04,0:52:15.88,Default,,0,0,0,,♪ Алдағы жол әлі таулы
Dialogue: 0,0:52:15.96,0:52:17.75,Default,,0,0,0,,♪ Юмено Точуса
Dialogue: 0,0:52:17.84,0:52:22.26,Default,,0,0,0,,♪ Жете алатыныңызға сенімдімін
Dialogue: 0,0:52:25.05,0:52:26.18,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:52:26.26,0:52:27.60,Default,,0,0,0,,Не болды?
Dialogue: 0,0:52:28.14,0:52:29.85,Default,,0,0,0,,Бұл сенің кінәң шығар!
Dialogue: 0,0:52:30.43,0:52:33.02,Default,,0,0,0,,Сондықтан көлікті сәл абайлап жүргізіңіз.
Dialogue: 0,0:52:33.14,0:52:35.27,Default,,0,0,0,,Жүр, барлығы күтіп тұр.
Dialogue: 0,0:52:35.36,0:52:36.86,Default,,0,0,0,,Үйге ерте қайтайық
Dialogue: 0,0:52:41.57,0:52:44.99,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:52:52.12,0:52:53.04,Default,,0,0,0,,Мені шабуылдады дегені —
Dialogue: 0,0:52:53.12,0:52:54.33,Default,,0,0,0,,Өзіңді жаппа!
Dialogue: 0,0:52:55.83,0:53:01.83,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory