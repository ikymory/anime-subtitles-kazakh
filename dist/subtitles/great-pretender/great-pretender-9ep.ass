Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,(душ дыбысы)
Dialogue: 0,0:00:07.00,0:00:08.05,Default,,0,0,0,,Сіз бұрынғы жауынгерсіз бе?
Dialogue: 0,0:00:08.07,0:00:09.08,Default,,0,0,0,,Не?
Dialogue: 0,0:00:10.03,0:00:12.03,Default,,0,0,0,,Льюис бұрынғы әскери қызметкер ме?
Dialogue: 0,0:00:13.06,0:00:14.07,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:00:14.08,0:00:21.07,Default,,0,0,0,,(Шыңырау)
Dialogue: 0,0:00:24.03,0:00:25.04,Default,,0,0,0,,Эбби
Dialogue: 0,0:00:28.00,0:00:29.00,Default,,0,0,0,,Эбби?
Dialogue: 0,0:00:29.03,0:00:30.02,Default,,0,0,0,,Ха…
Dialogue: 0,0:00:30.09,0:00:32.01,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:00:32.04,0:00:35.06,Default,,0,0,0,,Хмм... Мен ұйықтап жатырмын.
Dialogue: 0,0:00:35.08,0:00:37.09,Default,,0,0,0,,Бұл сізге сәйкес болуы мүмкін.
Dialogue: 0,0:00:38.07,0:00:40.00,Default,,0,0,0,,Қалыпты ұшыңыз
Dialogue: 0,0:00:41.00,0:00:43.03,Default,,0,0,0,,Әлсіреп қалма — жолды бөгеп тұрсың.
Dialogue: 0,0:00:52.01,0:00:55.00,Default,,0,0,0,,(винт дыбысы)
Dialogue: 0,0:01:09.07,0:01:10.09,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:01:15.05,0:01:16.04,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:01:22.03,0:01:28.03,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:20.06,0:02:26.06,Default,,0,0,0,,~♪
Dialogue: 0,0:02:30.04,0:02:32.04,Default,,0,0,0,,Турнир 2-тур 3-ші жарыс
Dialogue: 0,0:02:33.02,0:02:36.07,Default,,0,0,0,,Қызғылт ұшақ №38 Дон Родригеске қарсы
Dialogue: 0,0:02:36.09,0:02:39.09,Default,,0,0,0,,Күлгін машина №14 Абигейл Джонс
Dialogue: 0,0:02:40.08,0:02:44.04,Default,,0,0,0,,Коэффициенттер: Родригес 1.4 Абигейл 3.5
Dialogue: 0,0:02:45.02,0:02:48.09,Default,,0,0,0,,Екі құрылғы да күту режимінде. Қабылдау жақын арада аяқталады.
Dialogue: 0,0:02:49.04,0:02:52.00,Default,,0,0,0,,Әйелге бәс тігуім керек пе? (Адам В) Тоқта.
Dialogue: 0,0:02:52.05,0:02:54.00,Default,,0,0,0,,Өзіңізді жеңіл сезінген болуыңыз керек.
Dialogue: 0,0:02:54.02,0:02:55.00,Default,,0,0,0,,Менің есімде жақсы.
Dialogue: 0,0:02:55.01,0:02:56.00,Default,,0,0,0,,Сэм
Dialogue: 0,0:02:56.01,0:02:57.03,Default,,0,0,0,,Майк
Dialogue: 0,0:02:57.04,0:02:59.08,Default,,0,0,0,,Сонда сіз қанша әкелдіңіз?
Dialogue: 0,0:03:00.00,0:03:01.01,Default,,0,0,0,,300 000
Dialogue: 0,0:03:01.02,0:03:05.03,Default,,0,0,0,,300 000! Бастапқыда мен саған кішкентай болсын дедім.
Dialogue: 0,0:03:05.05,0:03:07.01,Default,,0,0,0,,Мен оны аз қалдыруды мақсат етіп отырмын.
Dialogue: 0,0:03:07.05,0:03:09.00,Default,,0,0,0,,Егер сіз бәрібір бәс тігетін болсаңыз
Dialogue: 0,0:03:09.01,0:03:11.01,Default,,0,0,0,,Бұлай болмаса қызық болмас еді.
Dialogue: 0,0:03:11.03,0:03:13.00,Default,,0,0,0,,Күдікті болыңыз
Dialogue: 0,0:03:13.01,0:03:15.08,Default,,0,0,0,,Егер сіздің жеке тұлғаңыз анықталса, сізге кіруге немесе шығуға тыйым салынады.
Dialogue: 0,0:03:15.09,0:03:17.09,Default,,0,0,0,,Тіркеу жақында жабылады
Dialogue: 0,0:03:19.09,0:03:22.06,Default,,0,0,0,,Абигейл Джонсқа 300 000 доллар.
Dialogue: 0,0:03:23.02,0:03:24.06,Default,,0,0,0,,мұнда өркениет бұрыннан-ақ бар еді.
Dialogue: 0,0:03:24.07,0:03:26.02,Default,,0,0,0,,Мен үлкен бәс тігемін.
Dialogue: 0,0:03:26.07,0:03:28.01,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:03:28.02,0:03:29.07,Default,,0,0,0,,Жоғарғы шек жоқ... дұрыс па?
Dialogue: 0,0:03:30.03,0:03:31.04,Default,,0,0,0,,Менеджер
Dialogue: 0,0:03:31.08,0:03:33.06,Default,,0,0,0,,Мүмкіндіктер сәл төмен болса да
Dialogue: 0,0:03:34.00,0:03:35.01,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:03:35.09,0:03:37.00,Default,,0,0,0,,Оны қабылдаңыз.
Dialogue: 0,0:03:38.00,0:03:40.03,Default,,0,0,0,,300 000 доллар қабылданды
Dialogue: 0,0:03:41.03,0:03:46.06,Default,,0,0,0,,(винттік ұшақтың ұшу дыбысы)
Dialogue: 0,0:04:00.02,0:04:02.00,Default,,0,0,0,,О... шынымен бе?
Dialogue: 0,0:04:02.07,0:04:04.03,Default,,0,0,0,,Бұл қайтарылатын болады.
Dialogue: 0,0:04:10.05,0:04:12.01,Default,,0,0,0,,Неге… неге мен
Dialogue: 0,0:04:13.07,0:04:14.06,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:14.08,0:04:17.07,Default,,0,0,0,,Қош келдіңіз, Майк.
Dialogue: 0,0:04:18.01,0:04:21.03,Default,,0,0,0,,Масато, мен бүгін өте көңілді болдым.
Dialogue: 0,0:04:21.05,0:04:22.03,Default,,0,0,0,,О
Dialogue: 0,0:04:25.03,0:04:28.03,Default,,0,0,0,,Әй, сен маған жақсы нәрсені үйреттің.
Dialogue: 0,0:04:28.04,0:04:30.03,Default,,0,0,0,,Сізге ұнағанына қуаныштымын.
Dialogue: 0,0:04:30.05,0:04:32.02,Default,,0,0,0,,Келесі жолы жалғыз қалған дұрыс.
Dialogue: 0,0:04:33.00,0:04:34.05,Default,,0,0,0,,Өкінішке орай
Dialogue: 0,0:04:34.06,0:04:37.06,Default,,0,0,0,,Сіз құмар ойындардың қызығынан ләззат ала алмайсыз.
Dialogue: 0,0:04:41.04,0:04:43.04,Default,,0,0,0,,Іс жақсы жүріп жатқан сияқты.
Dialogue: 0,0:04:43.06,0:04:45.02,Default,,0,0,0,,Жақсы өтіп жатқан сияқты
Dialogue: 0,0:04:45.04,0:04:47.09,Default,,0,0,0,,Кенеттен сейф бос.
Dialogue: 0,0:04:48.02,0:04:51.01,Default,,0,0,0,,Кешіріңіз, тамақ құны өсті.
Dialogue: 0,0:04:51.02,0:04:52.07,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:04:52.08,0:04:55.05,Default,,0,0,0,,Балық ауламас бұрын оны барынша семіз етейік.
Dialogue: 0,0:04:56.01,0:04:59.00,Default,,0,0,0,,Бірақ Сэм тереңірек баруы керек пе?
Dialogue: 0,0:04:59.02,0:05:00.09,Default,,0,0,0,,Мен сенетініне сенімдімін.
Dialogue: 0,0:05:01.00,0:05:04.04,Default,,0,0,0,,Өйткені, ол жарыстың нәтижесін шеше алады.
Dialogue: 0,0:05:04.05,0:05:06.02,Default,,0,0,0,,Бұл сөзсіз пайдалы.
Dialogue: 0,0:05:06.06,0:05:08.05,Default,,0,0,0,,Бұл күлкілі емес пе?
Dialogue: 0,0:05:08.08,0:05:09.08,Default,,0,0,0,,Әрине
Dialogue: 0,0:05:09.09,0:05:12.06,Default,,0,0,0,,Осымен бір рет жалықтыруыңыз мүмкін.
Dialogue: 0,0:05:13.00,0:05:16.03,Default,,0,0,0,,Олай болса, тегін ішіп-жеу керек.
Dialogue: 0,0:05:16.06,0:05:18.01,Default,,0,0,0,,Бақытымызға орай
Dialogue: 0,0:05:18.03,0:05:21.05,Default,,0,0,0,,Олардың қаржылық жағдайы сіз ойлағандай жомарт емес.
Dialogue: 0,0:05:22.03,0:05:25.03,Default,,0,0,0,,Әзірге ақша табудың жалғыз жолы - әуе жарысы.
Dialogue: 0,0:05:25.09,0:05:29.09,Default,,0,0,0,,Сондықтан мен қолымнан келгеннің барлығын жандандыруға тырысамын.
Dialogue: 0,0:05:30.01,0:05:32.09,Default,,0,0,0,,Басқаша айтқанда, ол әрқашан тереңдей түседі.
Dialogue: 0,0:05:33.03,0:05:36.09,Default,,0,0,0,,Сонымен қатар, адамның қалауы шексіз.
Dialogue: 0,0:05:37.02,0:05:38.07,Default,,0,0,0,,Түсінгеніңізге сенімдімін.
Dialogue: 0,0:05:40.00,0:05:40.50,Default,,0,0,0,,Хмф!
Dialogue: 0,0:05:41.03,0:05:44.03,Default,,0,0,0,,Алаяқтық ойыны өте қызық сияқты.
Dialogue: 0,0:05:45.03,0:05:48.08,Default,,0,0,0,,Медицина одан әлдеқайда жақсы.
Dialogue: 0,0:05:48.09,0:05:50.00,Default,,0,0,0,,Ас үшін рахмет
Dialogue: 0,0:05:51.01,0:05:52.00,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:05:52.05,0:05:54.09,Default,,0,0,0,,Ақыр соңында, мен не жақсымын?
Dialogue: 0,0:05:55.02,0:05:56.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:57.06,0:05:59.04,Default,,0,0,0,,Бір нәрсе... әртүрлі заттар
Dialogue: 0,0:05:59.05,0:06:00.03,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:00.09,0:06:02.09,Default,,0,0,0,,Сіз оны мүмкіндігінше қатты бұраңыз.
Dialogue: 0,0:06:22.06,0:06:29.05,Default,,0,0,0,,(«Жануарлар карнавалы» сюитасы)
Dialogue: 0,0:06:42.03,0:06:45.09,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:06:54.04,0:06:56.02,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:06:58.07,0:07:00.07,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:07:01.02,0:07:04.07,Default,,0,0,0,,(соғыс ұшағы ұшу дыбысы)
Dialogue: 0,0:07:10.00,0:07:13.08,Default,,0,0,0,,(Ұшақтың ұшу дыбысы)
Dialogue: 0,0:07:13.09,0:07:14.08,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:07:15.04,0:07:16.08,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:07:17.00,0:07:21.05,Default,,0,0,0,,(Қуаныштар алыстан жаңғырық)
Dialogue: 0,0:07:23.06,0:07:24.06,Default,,0,0,0,,Хаа…
Dialogue: 0,0:07:26.00,0:07:28.09,Default,,0,0,0,,Абигейл Джонсқа бір миллион доллар.
Dialogue: 0,0:07:29.01,0:07:32.01,Default,,0,0,0,,1 миллион? Хмм...
Dialogue: 0,0:07:32.06,0:07:37.04,Default,,0,0,0,,Абигейлдің коэффициенті 3,0, тіпті егер олар аздап төмендесе де...
Dialogue: 0,0:07:37.05,0:07:38.04,Default,,0,0,0,,Изуку Мидория…
Dialogue: 0,0:07:38.08,0:07:41.09,Default,,0,0,0,,Сәлем! Ешқандай жоғарғы шегі жоқ деп мәлімдегенімен
Dialogue: 0,0:07:42.00,0:07:45.08,Default,,0,0,0,,Менің ойымша, олар оны өткізіп жібермейді, өйткені олар төлеуге дайын емес.
Dialogue: 0,0:07:46.00,0:07:48.01,Default,,0,0,0,,Әрине, бізде дайын.
Dialogue: 0,0:07:48.08,0:07:51.03,Default,,0,0,0,,Мен оны қабылдаймын, 1 миллион доллар.
Dialogue: 0,0:07:51.05,0:07:52.04,Default,,0,0,0,,Хмф!
Dialogue: 0,0:07:58.07,0:08:00.08,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:08:08.02,0:08:09.09,Default,,0,0,0,,Мен қайтадан келемін.
Dialogue: 0,0:08:11.03,0:08:14.02,Default,,0,0,0,,Күте тұрыңыз, Майк, жоқ...
Dialogue: 0,0:08:14.09,0:08:16.09,Default,,0,0,0,,Құрметті Сэм Ибрахим
Dialogue: 0,0:08:17.03,0:08:19.07,Default,,0,0,0,,Сіз әуе жарысына қатысасыз.
Dialogue: 0,0:08:19.09,0:08:21.05,Default,,0,0,0,,Бұл Сэм Ибрагим.
Dialogue: 0,0:08:22.07,0:08:24.00,Default,,0,0,0,,Сонда ше?
Dialogue: 0,0:08:24.05,0:08:28.07,Default,,0,0,0,,Кешірім сұраймыз, бірақ келесі жолы бізге келмеуіңізді сұраймыз.
Dialogue: 0,0:08:28.09,0:08:32.00,Default,,0,0,0,,Бұл кіруге және шығуға тыйым салынғанын білдіре ме?
Dialogue: 0,0:08:32.01,0:08:33.03,Default,,0,0,0,,Қош бол
Dialogue: 0,0:08:33.06,0:08:37.04,Default,,0,0,0,,Мен қонақ ретінде рахаттанып жатырмын.
Dialogue: 0,0:08:37.06,0:08:38.04,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:39.03,0:08:41.03,Default,,0,0,0,,Сіз өзіңіздің жеке басыңыз туралы өтірік айттыңыз.
Dialogue: 0,0:08:41.08,0:08:45.04,Default,,0,0,0,,Біздің дүкен мүшелерімізбен сенімді қарым-қатынасқа негізделген.
Dialogue: 0,0:08:45.08,0:08:50.02,Default,,0,0,0,,Егер әрекет зиян келтіреді деп есептелсе, мүшелік тоқтатылады.
Dialogue: 0,0:08:51.04,0:08:52.04,Default,,0,0,0,,Үйге қош келдіңіз
Dialogue: 0,0:08:54.01,0:08:55.04,Default,,0,0,0,,Ұстамаңыз!
Dialogue: 0,0:08:56.02,0:09:00.01,Default,,0,0,0,,Жарайды, мен кетемін. Мен ақшаны аламын.
Dialogue: 0,0:09:04.05,0:09:08.07,Default,,0,0,0,,(винттік ұшақтың ұшу дыбысы)
Dialogue: 0,0:09:14.08,0:09:17.06,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:09:18.00,0:09:20.03,Default,,0,0,0,,Жақсы жұмыс! Ұшақ ше?
Dialogue: 0,0:09:20.07,0:09:21.09,Default,,0,0,0,,Керемет
Dialogue: 0,0:09:22.00,0:09:24.03,Default,,0,0,0,,Масато техникалық қызмет көрсетуді бастады.
Dialogue: 0,0:09:24.04,0:09:25.05,Default,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,0:09:25.06,0:09:27.03,Default,,0,0,0,,Үйренсең, одан да өседі.
Dialogue: 0,0:09:27.04,0:09:28.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:29.03,0:09:31.03,Default,,0,0,0,,Көңіл-күйі нашар сияқты.
Dialogue: 0,0:09:31.09,0:09:34.06,Default,,0,0,0,,Оған сол астыртын казиноға кіруге тыйым салынды.
Dialogue: 0,0:09:34.07,0:09:35.06,Default,,0,0,0,,Хаа…
Dialogue: 0,0:09:35.09,0:09:38.04,Default,,0,0,0,,Ей, сенің рахатың жеткілікті болды ғой, солай емес пе?
Dialogue: 0,0:09:38.07,0:09:41.02,Default,,0,0,0,,Жарысқа қатысу үшін ақша қажет.
Dialogue: 0,0:09:41.03,0:09:43.03,Default,,0,0,0,,Сіз ойлағаннан да көп!
Dialogue: 0,0:09:43.06,0:09:47.05,Default,,0,0,0,,Мен астыртын казинода операциялық қаражат табу туралы ешқашан естіген емеспін.
Dialogue: 0,0:09:47.06,0:09:50.05,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:09:50.08,0:09:52.06,Default,,0,0,0,,Жаңбыр көп жауады
Dialogue: 0,0:09:52.08,0:09:55.00,Default,,0,0,0,,Оның орнына неге бармайсың?
Dialogue: 0,0:09:55.01,0:09:55.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:56.05,0:09:59.01,Default,,0,0,0,,Тек Сэмге тыйым салынды.
Dialogue: 0,0:09:59.07,0:10:01.08,Default,,0,0,0,,Бізден бас тартуға ешқандай себеп болмауы керек.
Dialogue: 0,0:10:02.02,0:10:06.07,Default,,0,0,0,,Бірақ мен көп ақшаны жаман жігітке сеніп тапсырамын ба деп уайымдаймын.
Dialogue: 0,0:10:09.08,0:10:11.09,Default,,0,0,0,,(Шәй жұтып отырған дыбыс)
Dialogue: 0,0:10:14.06,0:10:17.01,Default,,0,0,0,,(Шәй жұтып отырған дыбыс)
Dialogue: 0,0:10:17.03,0:10:18.08,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:10:19.04,0:10:22.03,Default,,0,0,0,,(Шәй жұтып отырған дыбыс)
Dialogue: 0,0:10:23.04,0:10:25.02,Default,,0,0,0,,Дәл 2,5 млн
Dialogue: 0,0:10:25.09,0:10:28.02,Default,,0,0,0,,Осы... барлығына бәс тігу керек пе?
Dialogue: 0,0:10:28.05,0:10:29.09,Default,,0,0,0,,Бұл соңы
Dialogue: 0,0:10:30.00,0:10:32.00,Default,,0,0,0,,Мен саған сенбеймін дегенім емес, бірақ
Dialogue: 0,0:10:32.02,0:10:35.08,Default,,0,0,0,,Қауіпсіздікті сақтау үшін қол астындағы қызметкеріңізден сізбен бірге дүкеннің алдына баруын сұраңыз.
Dialogue: 0,0:10:36.00,0:10:37.01,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:10:37.02,0:10:40.04,Default,,0,0,0,,Бірақ сіз Абигейлге бәс тігуге болмайды.
Dialogue: 0,0:10:41.02,0:10:43.06,Default,,0,0,0,,Мен сенің хабаршыңмын деген сияқты.
Dialogue: 0,0:10:44.05,0:10:47.04,Default,,0,0,0,,Хм... Басқа картаны пайдалануым керек пе?
Dialogue: 0,0:10:48.07,0:10:49.08,Default,,0,0,0,,Кайо?
Dialogue: 0,0:10:50.03,0:10:52.01,Default,,0,0,0,,Кайо Висконти
Dialogue: 0,0:10:52.02,0:10:55.01,Default,,0,0,0,,Ол жас және сүйкімді жүзді бала.
Dialogue: 0,0:10:55.03,0:10:59.03,Default,,0,0,0,,Олар оған жартылай финалға шығуға және Кларкпен жұдырықтасуға мүмкіндік беретіндерін айтты.
Dialogue: 0,0:10:59.09,0:11:01.07,Default,,0,0,0,,Жарайсың Эдамаме
Dialogue: 0,0:11:01.08,0:11:02.07,Default,,0,0,0,,Хмф!
Dialogue: 0,0:11:07.05,0:11:08.03,Default,,0,0,0,,Шабуыл
Dialogue: 0,0:11:08.06,0:11:10.01,Default,,0,0,0,,Инишо медицинасы
Dialogue: 0,0:11:10.02,0:11:11.01,Default,,0,0,0,,Ішемін бе?
Dialogue: 0,0:11:11.06,0:11:14.01,Default,,0,0,0,,Жоқ, жоқ, ол тым үлкен.
Dialogue: 0,0:11:14.06,0:11:16.08,Default,,0,0,0,,Жылқы суппозиторийлері осыншама үлкен, солай ма?
Dialogue: 0,0:11:17.00,0:11:19.02,Default,,0,0,0,,(есіктің ашылған дыбысы) Бұл үлкенірек емес пе?
Dialogue: 0,0:11:19.03,0:11:22.08,Default,,0,0,0,,Қолды сыйғызу керек. Қол мүмкін емес.
Dialogue: 0,0:11:36.08,0:11:39.09,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:11:51.00,0:11:51.50,Default,,0,0,0,,Эй!
Dialogue: 0,0:11:53.04,0:11:54.02,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:11:56.05,0:12:00.02,Default,,0,0,0,,Ха ха ха...! (пышақ ұрған дыбыс)
Dialogue: 0,0:12:00.03,0:12:02.07,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:12:02.08,0:12:05.04,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:12:09.01,0:12:09.51,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:15.09,0:12:16.07,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:12:17.03,0:12:21.05,Default,,0,0,0,,(мылтық ату дыбысы)
Dialogue: 0,0:12:23.03,0:12:24.01,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:25.04,0:12:28.03,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:12:30.00,0:12:37.00,Default,,0,0,0,,(Шыңырау)
Dialogue: 0,0:13:22.04,0:13:27.07,Default,,0,0,0,,(винттік ұшақтың ұшу дыбысы)
Dialogue: 0,0:13:42.09,0:13:43.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:48.06,0:13:49.04,Default,,0,0,0,,Мен де солай ойладым, бірақ бұл шешімді талқылаудың қажеті жоқ
Dialogue: 0,0:13:50.00,0:13:51.06,Default,,0,0,0,,Мен мәселені білемін!
Dialogue: 0,0:13:51.07,0:13:53.02,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:13:54.01,0:13:55.05,Default,,0,0,0,,Жарайды
Dialogue: 0,0:14:03.08,0:14:06.02,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:14:07.00,0:14:11.00,Default,,0,0,0,,Масато: Кайоға дұрыс бәс тіктіңіз бе? Мүмкіндіктер қандай?
Dialogue: 0,0:14:11.04,0:14:12.09,Default,,0,0,0,,Ха ха ха!
Dialogue: 0,0:14:13.05,0:14:16.08,Default,,0,0,0,,Бұл 7,5 миллион ба? Жарайсың!
Dialogue: 0,0:14:20.01,0:14:21.06,Default,,0,0,0,,Ұшқаннан кейін бірден батыстан жел соқты...
Dialogue: 0,0:14:21.07,0:14:22.05,Default,,0,0,0,,Сәлем
Dialogue: 0,0:14:24.03,0:14:26.05,Default,,0,0,0,,Маған экскурсия жасауға бола ма?
Dialogue: 0,0:14:27.05,0:14:28.09,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:14:29.01,0:14:31.03,Default,,0,0,0,,Мен сенімдімін Абигейл Джонс...
Dialogue: 0,0:14:31.07,0:14:34.04,Default,,0,0,0,,Аа, сіз білетініңізге қуаныштымын.
Dialogue: 0,0:14:34.07,0:14:37.04,Default,,0,0,0,,Сіздің машинаңыз өте тартымды
Dialogue: 0,0:14:38.00,0:14:40.06,Default,,0,0,0,,Сонымен... солай ма? Тіпті сіздің машинаңыз ...
Dialogue: 0,0:14:41.01,0:14:44.09,Default,,0,0,0,,Сіз өте қатыгез адамсыз, солай емес пе?
Dialogue: 0,0:14:45.03,0:14:48.01,Default,,0,0,0,,Жас болсаң да, ғажап техниксің.
Dialogue: 0,0:14:48.07,0:14:50.05,Default,,0,0,0,,А, мен де соны қарап көрейін бе?
Dialogue: 0,0:14:50.06,0:14:52.00,Default,,0,0,0,,Е... Иә, өтінемін!
Dialogue: 0,0:14:52.02,0:14:55.01,Default,,0,0,0,,Иә! Бұл мүмкін бе?
Dialogue: 0,0:15:04.08,0:15:05.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:06.08,0:15:08.00,Default,,0,0,0,,Баратын уақыт келді
Dialogue: 0,0:15:08.07,0:15:10.01,Default,,0,0,0,,Уау! Мен сені сүйем
Dialogue: 0,0:15:11.02,0:15:13.08,Default,,0,0,0,,Ах... Рахмет. Мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:15:14.02,0:15:16.09,Default,,0,0,0,,Мен дені сау ұлдарды жақсы көремін
Dialogue: 0,0:15:17.04,0:15:22.03,Default,,0,0,0,,(винттік ұшақтың ұшу дыбысы)
Dialogue: 0,0:15:26.05,0:15:28.05,Default,,0,0,0,,Бұл капсула қандай зат?
Dialogue: 0,0:15:28.08,0:15:30.07,Default,,0,0,0,,Өте қарапайым
Dialogue: 0,0:15:30.08,0:15:34.02,Default,,0,0,0,,Капсула ериді және дәрі маймен араласа бастайды.
Dialogue: 0,0:15:34.09,0:15:38.02,Default,,0,0,0,,Қозғалтқышқа барғанда, айналу жылдамдығы бірте-бірте азаяды.
Dialogue: 0,0:15:39.03,0:15:40.08,Default,,0,0,0,,Табиғи түрде тоқтап қалу
Dialogue: 0,0:15:40.09,0:15:42.09,Default,,0,0,0,,(винттің тұрақсыз дыбысы)
Dialogue: 0,0:15:44.02,0:15:46.02,Default,,0,0,0,,Ах... у... уһ?
Dialogue: 0,0:15:49.09,0:15:54.00,Default,,0,0,0,,Бәлкім, Сэм Льюисте пайдаланған сияқты.
Dialogue: 0,0:15:54.01,0:15:56.04,Default,,0,0,0,,Не болды? Сен не істеп жатырсың?
Dialogue: 0,0:15:56.05,0:15:58.03,Default,,0,0,0,,Иә? Ана жерде!
Dialogue: 0,0:16:01.00,0:16:03.00,Default,,0,0,0,,Кайо~!
Dialogue: 0,0:16:04.03,0:16:08.00,Default,,0,0,0,,Теңізге шұғыл қонатын болсаңыз, үлкен апат болмайды.
Dialogue: 0,0:16:08.03,0:16:09.01,Default,,0,0,0,,Мүмкін.
Dialogue: 0,0:16:10.04,0:16:12.03,Default,,0,0,0,,Төлем жинау!
Dialogue: 0,0:16:12.05,0:16:14.07,Default,,0,0,0,,Хаа~
Dialogue: 0,0:16:14.08,0:16:16.06,Default,,0,0,0,,Қош келдіңіздер~ Барлығына
Dialogue: 0,0:16:17.01,0:16:20.04,Default,,0,0,0,,Сен қатты ашулысың, Сэм.
Dialogue: 0,0:16:20.06,0:16:22.01,Default,,0,0,0,,Мені жұбатыңыз.
Dialogue: 0,0:16:22.06,0:16:23.06,Default,,0,0,0,,Хаа…
Dialogue: 0,0:16:25.00,0:16:26.06,Default,,0,0,0,,Сіз нені айтасыз!
Dialogue: 0,0:16:26.08,0:16:27.06,Default,,0,0,0,,(Балға ату дыбысы)
Dialogue: 0,0:16:27.07,0:16:30.00,Default,,0,0,0,,7,5 миллион доллар ештеңе емес!
Dialogue: 0,0:16:30.01,0:16:32.09,Default,,0,0,0,,Күте тұрыңыз, жай ғана тынышталыңыз!
Dialogue: 0,0:16:33.03,0:16:34.01,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:16:34.05,0:16:37.04,Default,,0,0,0,,Масатоға тисе де көмектесе алмайды.
Dialogue: 0,0:16:37.07,0:16:40.03,Default,,0,0,0,,Ағам айтқандай, мен жай ғана бәс тіккенмін.
Dialogue: 0,0:16:40.04,0:16:41.02,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:16:42.02,0:16:43.02,Default,,0,0,0,,Кайоны әкел
Dialogue: 0,0:16:43.04,0:16:46.03,Default,,0,0,0,,Мен ол баланы өлтіремін!
Dialogue: 0,0:16:46.07,0:16:48.06,Default,,0,0,0,,Ол қорқып қашып кетті.
Dialogue: 0,0:16:48.08,0:16:51.06,Default,,0,0,0,,Қозғалтқыштың ақауы – Құдайдың қулығы ғана.
Dialogue: 0,0:16:51.07,0:16:52.05,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:52.07,0:16:55.01,Default,,0,0,0,,Менің жолым болмаған шығар.
Dialogue: 0,0:16:55.04,0:16:57.05,Default,,0,0,0,,Біреу оны қолдан жасаған болуы мүмкін.
Dialogue: 0,0:16:57.07,0:16:59.05,Default,,0,0,0,,Қауіпсіздік деңгейін көтеріңіз!
Dialogue: 0,0:16:59.06,0:17:02.07,Default,,0,0,0,,Ха... Мен бұған қосыламын.
Dialogue: 0,0:17:04.04,0:17:07.02,Default,,0,0,0,,Француз менеджері жағымсыз.
Dialogue: 0,0:17:07.05,0:17:10.04,Default,,0,0,0,,Ол, әрине, өте жағымсыз жігіт.
Dialogue: 0,0:17:10.05,0:17:14.00,Default,,0,0,0,,Мен оны бұлай қалдыра алмаймын, міндетті түрде қайтарамын.
Dialogue: 0,0:17:14.01,0:17:15.07,Default,,0,0,0,,О, мен оны қайтарып алуым керек.
Dialogue: 0,0:17:16.02,0:17:17.05,Default,,0,0,0,,Ойлан
Dialogue: 0,0:17:18.09,0:17:20.04,Default,,0,0,0,,Жоспарланғандай.
Dialogue: 0,0:17:20.06,0:17:23.07,Default,,0,0,0,,Мен сол жерде теңізде жүзіп бара жаздадым.
Dialogue: 0,0:17:24.02,0:17:28.04,Default,,0,0,0,,Олар ақырында байсалды болып, оған шынымен кірісіп кеткен сияқты.
Dialogue: 0,0:17:29.08,0:17:31.01,Default,,0,0,0,,Эбби ұйықтап қалды ма?
Dialogue: 0,0:17:31.05,0:17:34.05,Default,,0,0,0,,Соңғы кездері көп ұйықтамайтын сияқтымын.
Dialogue: 0,0:17:34.06,0:17:36.01,Default,,0,0,0,,Себебі мен өзімді ұшуға мәжбүрлеймін.
Dialogue: 0,0:17:36.06,0:17:39.08,Default,,0,0,0,,Не болса да, менде тағы екі ғана аттракцион бар.
Dialogue: 0,0:17:40.00,0:17:43.00,Default,,0,0,0,,Әрине, мен максималды сақтық көшірме жасауды жалғастырамын.
Dialogue: 0,0:17:43.08,0:17:44.07,Default,,0,0,0,,Эй
Dialogue: 0,0:17:44.08,0:17:45.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:47.02,0:17:49.09,Default,,0,0,0,,Неліктен өлгісі келеді?
Dialogue: 0,0:17:52.00,0:17:53.07,Default,,0,0,0,,Сіз немен айналысып жатырсыз?
Dialogue: 0,0:17:54.00,0:17:55.04,Default,,0,0,0,,(Батырма басылған дыбысы)
Dialogue: 0,0:17:55.09,0:17:57.02,Default,,0,0,0,,Не істеуім керек...
Dialogue: 0,0:17:57.03,0:17:58.06,Default,,0,0,0,,Жағдайды білгеннен кейін
Dialogue: 0,0:17:59.00,0:18:02.00,Default,,0,0,0,,Баланың сезімін түсіну мүмкін емес.
Dialogue: 0,0:18:02.08,0:18:04.06,Default,,0,0,0,,Сізге және бізге
Dialogue: 0,0:18:24.06,0:18:25.07,Default,,0,0,0,,(винттік ұшақтың ұшу дыбысы)
Dialogue: 0,0:19:07.06,0:19:09.06,Default,,0,0,0,,Менің ойымша, ол ұйықтап жатыр.
Dialogue: 0,0:19:11.07,0:19:12.06,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:12.08,0:19:14.03,Default,,0,0,0,,Қайырлы кеш Эдамаме
Dialogue: 0,0:19:14.07,0:19:17.00,Default,,0,0,0,,Жоқ... Бұл Эдамура.
Dialogue: 0,0:19:17.02,0:19:18.08,Default,,0,0,0,,Мақсаттының екінші ұлы
Dialogue: 0,0:19:18.09,0:19:20.01,Default,,0,0,0,,Тек бір адам?
Dialogue: 0,0:19:20.05,0:19:23.05,Default,,0,0,0,,Льюис Эббимен серуендеуге шықты.
Dialogue: 0,0:19:23.09,0:19:24.09,Default,,0,0,0,,Эббимен бе?
Dialogue: 0,0:19:25.01,0:19:28.06,Default,,0,0,0,,«Мен ұшқыштар туралы кәсіби кеңес алғым келеді».
Dialogue: 0,0:19:32.05,0:19:35.06,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,0:19:35.07,0:19:41.06,Default,,0,0,0,,(көңілді музыка)
Dialogue: 0,0:19:42.01,0:19:44.03,Default,,0,0,0,,Уау, қараңдар, қараңдар!
Dialogue: 0,0:19:44.04,0:19:45.02,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:19:50.03,0:19:57.02,Default,,0,0,0,,Мен жалғыз қалдым ба?
Dialogue: 0,0:20:07.00,0:20:08.03,Default,,0,0,0,,Мақсаты не?
Dialogue: 0,0:20:09.04,0:20:12.02,Default,,0,0,0,,Менің кеңес сұрағым келмейді.
Dialogue: 0,0:20:16.09,0:20:18.03,Default,,0,0,0,,Мен сені әскерде деп естідім?
Dialogue: 0,0:20:20.03,0:20:25.07,Default,,0,0,0,,Көпұлтты күштердің ұшқышы ретінде Таяу Шығысты бақылауға қатысты.
Dialogue: 0,0:20:27.08,0:20:32.04,Default,,0,0,0,,кез келген адам саны кез келген адам саны
Dialogue: 0,0:20:34.01,0:20:35.03,Default,,0,0,0,,Сен оны өлтірдің, солай ма?
Dialogue: 0,0:20:35.04,0:20:36.02,Default,,0,0,0,,Тағы 500 рет!
Dialogue: 0,0:20:36.04,0:20:37.06,Default,,0,0,0,,(Льюистің дем алған дыбысы)
Dialogue: 0,0:20:39.04,0:20:43.05,Default,,0,0,0,,2003 жылдың наурызы Олар Бағдатты бомбалады ма?
Dialogue: 0,0:20:49.01,0:20:50.02,Default,,0,0,0,,Сонымен қатар, ол бізге дерлік жетіп қалды.
Dialogue: 0,0:20:51.00,0:20:57.00,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
