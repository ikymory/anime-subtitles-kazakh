Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,(Ұшақтың ұшу дыбысы)
Dialogue: 0,0:00:16.09,0:00:17.07,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:17.08,0:00:21.08,Default,,0,0,0,,(винт дыбысы)
Dialogue: 0,0:00:25.01,0:00:28.07,Default,,0,0,0,,Фу хаа…
Dialogue: 0,0:00:32.00,0:00:34.07,Default,,0,0,0,,(винттік ұшақтың ұшу дыбысы)
Dialogue: 0,0:00:34.08,0:00:38.08,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:00:55.07,0:00:57.08,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:01:19.00,0:01:21.02,Default,,0,0,0,,Өте әсерлі!
Dialogue: 0,0:01:21.09,0:01:24.05,Default,,0,0,0,,Осындай қаланың басында ит төбелесіңіз
Dialogue: 0,0:01:25.00,0:01:27.01,Default,,0,0,0,,Ең ақылсыз жарыс
Dialogue: 0,0:01:31.04,0:01:37.04,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:29.05,0:02:35.05,Default,,0,0,0,,~♪
Dialogue: 0,0:02:41.00,0:02:43.09,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:02:44.00,0:02:46.02,Default,,0,0,0,,Мен әлі де көп орын бар сияқтымын.
Dialogue: 0,0:02:46.07,0:02:48.07,Default,,0,0,0,,Паразольдар сирек кездеседі, солай емес пе?
Dialogue: 0,0:02:48.08,0:02:50.06,Default,,0,0,0,,Қартаюға қарсы
Dialogue: 0,0:02:55.08,0:02:59.08,Default,,0,0,0,,Кларк!
Dialogue: 0,0:03:01.00,0:03:03.03,Default,,0,0,0,,Ол фотодан да әдемі емес пе?
Dialogue: 0,0:03:03.04,0:03:05.05,Default,,0,0,0,,25 жаста жеңілмеген чемпион
Dialogue: 0,0:03:06.01,0:03:08.04,Default,,0,0,0,,Айтпақшы, мен де әуе жарысының кумирімін.
Dialogue: 0,0:03:08.05,0:03:10.02,Default,,0,0,0,,Жақында ән айта бастайтын сияқты.
Dialogue: 0,0:03:11.02,0:03:13.09,Default,,0,0,0,,Мына жерде VIP орындықтағы менің ағам Сэм.
Dialogue: 0,0:03:14.07,0:03:16.02,Default,,0,0,0,,27 жаста
Dialogue: 0,0:03:16.03,0:03:19.07,Default,,0,0,0,,Кларктың командасының иесі және турнир ұйымдастырушысы
Dialogue: 0,0:03:20.01,0:03:24.04,Default,,0,0,0,,Өз елінде ханзада болған екі адамды елден қуып, бас тартты.
Dialogue: 0,0:03:24.05,0:03:25.06,Default,,0,0,0,,Зама Амирода
Dialogue: 0,0:03:26.01,0:03:29.01,Default,,0,0,0,,Бірақ менің інім талғамы жоғары ұшқыш.
Dialogue: 0,0:03:29.07,0:03:32.03,Default,,0,0,0,,Менің ағамның промоутер қабілеті бар еді.
Dialogue: 0,0:03:33.01,0:03:35.02,Default,,0,0,0,,бірнеше жыл бұрын аяқталған әуе жарысын түсіндіреді.
Dialogue: 0,0:03:35.03,0:03:37.09,Default,,0,0,0,,Мен бәрін сатып алып, оны қайта жүктедім.
Dialogue: 0,0:03:38.00,0:03:39.08,Default,,0,0,0,,Бұл Pathfinder әуе жарысы.
Dialogue: 0,0:03:40.07,0:03:43.05,Default,,0,0,0,,Дегенмен, бұл бастапқыда өте қиын болған сияқты.
Dialogue: 0,0:03:45.00,0:03:46.08,Default,,0,0,0,,Оны орбитаға қалай шығардыңыз?
Dialogue: 0,0:03:47.01,0:03:48.01,Default,,0,0,0,,Бұл алтын.
Dialogue: 0,0:03:49.07,0:03:52.01,Default,,0,0,0,,Қарсы жаққа пара беріп, оларды жеңіліске ұшырату.
Dialogue: 0,0:03:52.05,0:03:54.03,Default,,0,0,0,,Бұл сәйкестік емес пе?
Dialogue: 0,0:03:54.06,0:03:55.08,Default,,0,0,0,,Кем дегенде
Dialogue: 0,0:03:55.09,0:03:56.08,Default,,0,0,0,,Жақсырақ айтсақ?
Dialogue: 0,0:03:57.06,0:04:00.00,Default,,0,0,0,,Сценарийленген ойын-сауық
Dialogue: 0,0:04:00.07,0:04:03.07,Default,,0,0,0,,Жеңіс пен жеңіліс толық бақылауында Сэммен
Dialogue: 0,0:04:03.08,0:04:07.06,Default,,0,0,0,,Кларк жеңілмейтін ханзада ретінде жарқырайды
Dialogue: 0,0:04:08.01,0:04:09.06,Default,,0,0,0,,Промоутердің келісімі бойынша
Dialogue: 0,0:04:09.07,0:04:12.05,Default,,0,0,0,,Әуе жарыстарының танымал болуы жыланбалықтардың өрмелеуімен байланысты.
Dialogue: 0,0:04:13.03,0:04:15.00,Default,,0,0,0,,Жасы, балалар.
Dialogue: 0,0:04:15.08,0:04:18.06,Default,,0,0,0,,Клиенттер менімен қаншалықты алысқа барады деп ойлаймын.
Dialogue: 0,0:04:20.08,0:04:22.03,Default,,0,0,0,,Басқа ұшқыштар ше?
Dialogue: 0,0:04:22.04,0:04:24.09,Default,,0,0,0,,Барлығы бақытты және бақытты
Dialogue: 0,0:04:25.00,0:04:27.01,Default,,0,0,0,,Басқаша ешкім айта алмайды
Dialogue: 0,0:04:27.08,0:04:29.06,Default,,0,0,0,,Бір адамнан басқа.
Dialogue: 0,0:04:29.07,0:04:30.08,Default,,0,0,0,,Жалғыз ба?
Dialogue: 0,0:04:31.00,0:04:35.00,Default,,0,0,0,,(винттік ұшақтың ұшу дыбысы)
Dialogue: 0,0:04:36.00,0:04:38.04,Default,,0,0,0,,Тағдырдың жазуымен Кларктың қарсыласы болды.
Dialogue: 0,0:04:38.05,0:04:39.03,Default,,0,0,0,,Ах
Dialogue: 0,0:04:40.07,0:04:41.07,Default,,0,0,0,,Қоңыр сиыр
Dialogue: 0,0:04:42.02,0:04:43.08,Default,,0,0,0,,Луи Мюллер
Dialogue: 0,0:04:44.06,0:04:47.09,Default,,0,0,0,,Ол жеңу үшін бәрін жасаймын деп айтты, бірақ
Dialogue: 0,0:04:48.02,0:04:52.00,Default,,0,0,0,,Шындығында мен финалда Кларктан жеңіліп жүрдім.
Dialogue: 0,0:04:52.07,0:04:56.05,Default,,0,0,0,,«Сіз әрқашан финалда ұтыласыз, солай ма?»
Dialogue: 0,0:04:56.09,0:04:59.02,Default,,0,0,0,,Мен жеңіл жүрмін...
Dialogue: 0,0:04:59.04,0:05:01.05,Default,,0,0,0,,Ол жай ғана өкшесін ойнап жүрді.
Dialogue: 0,0:05:01.06,0:05:02.06,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:05:03.04,0:05:04.08,Default,,0,0,0,,Көрініске қарама-қайшы
Dialogue: 0,0:05:04.09,0:05:08.01,Default,,0,0,0,,Ол тапқан табысының көп бөлігін гуманитарлық көмекке аударған көрінеді.
Dialogue: 0,0:05:11.07,0:05:12.09,Default,,0,0,0,,Хмм, бұл шылау ма?
Dialogue: 0,0:05:13.00,0:05:14.01,Default,,0,0,0,,Кіргіңіз келе ме?
Dialogue: 0,0:05:15.03,0:05:16.01,Default,,0,0,0,,Хун
Dialogue: 0,0:05:19.01,0:05:21.07,Default,,0,0,0,,Ең болмаса ол сенен жақсы.
Dialogue: 0,0:05:21.08,0:05:24.03,Default,,0,0,0,,Театрлық сезім және жауыз жүз
Dialogue: 0,0:05:24.04,0:05:26.06,Default,,0,0,0,,Бұл өкшелі аяқ киімге өте ыңғайлы болды.
Dialogue: 0,0:05:26.07,0:05:29.09,Default,,0,0,0,,-дегі сценарий бойынша жеңіліп қалсаңыз, жанкүйерлердің қуанышында шек жоқ.
Dialogue: 0,0:05:30.07,0:05:31.05,Default,,0,0,0,,Бірақ
Dialogue: 0,0:05:31.07,0:05:35.07,Default,,0,0,0,,Льюис австралиялық раундтың финалында басқаша көрінді.
Dialogue: 0,0:05:36.04,0:05:38.05,Default,,0,0,0,,Сіз келісілген ойыннан шаршадыңыз ба?
Dialogue: 0,0:05:38.09,0:05:41.02,Default,,0,0,0,,Жүлде ақшасы сізді соқыр етті ме?
Dialogue: 0,0:05:41.06,0:05:44.09,Default,,0,0,0,,Қалай болғанда да, Льюис көтеріліске шыққан бірінші және соңғы болды.
Dialogue: 0,0:05:45.03,0:05:48.00,Default,,0,0,0,,Мен Кларктан өтіп, мақсатты жалғастырдым...
Dialogue: 0,0:05:48.03,0:05:50.02,Default,,0,0,0,,Барлығы солай ойлады.
Dialogue: 0,0:05:50.06,0:05:52.00,Default,,0,0,0,,Дәл сол сәтте,
Dialogue: 0,0:05:52.04,0:05:54.02,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:05.08,0:06:08.02,Default,,0,0,0,,(Жедел жәрдем сигналы)
Dialogue: 0,0:06:08.03,0:06:09.05,Default,,0,0,0,,Мен бұған сенбеймін...
Dialogue: 0,0:06:09.07,0:06:10.05,Default,,0,0,0,,О
Dialogue: 0,0:06:10.09,0:06:13.06,Default,,0,0,0,,Сэмнің көтерілісті сезгені үшін жазасы
Dialogue: 0,0:06:15.06,0:06:17.01,Default,,0,0,0,,Льюиспен не болды?
Dialogue: 0,0:06:19.05,0:06:21.06,Default,,0,0,0,,Әйтеуір аман қалдым, бірақ
Dialogue: 0,0:06:22.01,0:06:24.00,Default,,0,0,0,,Мен өмір бойы мүгедектер арбасында өтетін сияқтымын.
Dialogue: 0,0:06:25.07,0:06:26.05,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:28.07,0:06:29.07,Default,,0,0,0,,Бітті.
Dialogue: 0,0:06:31.00,0:06:34.04,Default,,0,0,0,,Нгг... мм... мм...
Dialogue: 0,0:06:34.05,0:06:37.07,Default,,0,0,0,,Нгу~
Dialogue: 0,0:06:38.06,0:06:40.00,Default,,0,0,0,,Тек осы жолы
Dialogue: 0,0:06:40.01,0:06:41.08,Default,,0,0,0,,Міне, солай!
Dialogue: 0,0:06:41.09,0:06:45.00,Default,,0,0,0,,Ал, оған Кларкты жеңуге рұқсат етейік.
Dialogue: 0,0:06:45.04,0:06:47.00,Default,,0,0,0,,Бірақ осы мақсат үшін
Dialogue: 0,0:06:47.01,0:06:49.00,Default,,0,0,0,,Алдымен біз алдын ала кезеңдерден өтуіміз керек.
Dialogue: 0,0:06:49.01,0:06:50.07,Default,,0,0,0,,Өтінемін, Эбби.
Dialogue: 0,0:07:07.07,0:07:08.05,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:08.06,0:07:11.00,Default,,0,0,0,,(жүрек соғу дыбысы)
Dialogue: 0,0:07:11.01,0:07:12.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:13.00,0:07:13.50,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:15.06,0:07:17.03,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:07:17.05,0:07:18.06,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:07:18.07,0:07:20.07,Default,,0,0,0,,Сіз қанша жұмсаймын деп ойлайсыз?
Dialogue: 0,0:07:21.03,0:07:23.00,Default,,0,0,0,,Мықты болыңыз.
Dialogue: 0,0:07:29.06,0:07:33.00,Default,,0,0,0,,1 минут 23 секунд?
Dialogue: 0,0:07:33.08,0:07:37.01,Default,,0,0,0,,Жақсы, мен іріктеу критерийлерін жойдым, сондықтан бұл жақсы деп ойлаймын.
Dialogue: 0,0:07:37.04,0:07:40.03,Default,,0,0,0,,Керісінше, нағыз турнир ертең басталады.
Dialogue: 0,0:07:45.05,0:07:46.07,Default,,0,0,0,,Ол шықпайды.
Dialogue: 0,0:07:46.08,0:07:47.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:48.04,0:07:49.06,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:49.08,0:07:52.02,Default,,0,0,0,,Алдын ала тексеруде ақаулар болған жоқ.
Dialogue: 0,0:07:52.03,0:07:54.00,Default,,0,0,0,,Сіз жай ғана шаршадыңыз.
Dialogue: 0,0:07:55.02,0:07:57.05,Default,,0,0,0,,Сіз әрқашан соншалықты бейқамсыз
Dialogue: 0,0:07:57.06,0:07:58.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:59.03,0:08:00.05,Default,,0,0,0,,Мынаны қараңыз!
Dialogue: 0,0:08:00.06,0:08:03.08,Default,,0,0,0,,Біріншіден, ол жай ғана ұша алады!
Dialogue: 0,0:08:03.09,0:08:05.06,Default,,0,0,0,,Сондай-ақ, бұл жай ғана абайсызда.
Dialogue: 0,0:08:06.04,0:08:07.03,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:08:07.09,0:08:10.01,Default,,0,0,0,,Турнир – ит төбелесі.
Dialogue: 0,0:08:10.02,0:08:12.09,Default,,0,0,0,,Кларкқа қарсы финалға дейін қанша жеңіске жетуім керек?
Dialogue: 0,0:08:13.05,0:08:15.09,Default,,0,0,0,,Оңай жеңу мүмкін емес!
Dialogue: 0,0:08:16.03,0:08:18.00,Default,,0,0,0,,Сіз мұны істей аласыз.
Dialogue: 0,0:08:18.01,0:08:19.08,Default,,0,0,0,,Неге!
Dialogue: 0,0:08:19.09,0:08:21.04,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:08:24.01,0:08:25.04,Default,,0,0,0,,Бірінші турнир
Dialogue: 0,0:08:25.06,0:08:26.07,Default,,0,0,0,,және тек
Dialogue: 0,0:08:27.01,0:08:30.02,Default,,0,0,0,,Өйткені бұл әйел иесі және әйел ұшқыш.
Dialogue: 0,0:08:30.05,0:08:31.03,Default,,0,0,0,,Чуу!
Dialogue: 0,0:08:31.05,0:08:32.08,Default,,0,0,0,,Керемет!
Dialogue: 0,0:08:33.00,0:08:34.03,Default,,0,0,0,,Эбби Смайл
Dialogue: 0,0:08:34.04,0:08:35.02,Default,,0,0,0,,Tsk
Dialogue: 0,0:08:36.03,0:08:39.01,Default,,0,0,0,,Ағайынды Доракулардың сүйікті тағамы қандай деп ойлайсың?
Dialogue: 0,0:08:39.03,0:08:40.02,Default,,0,0,0,,Сүйікті тағам?
Dialogue: 0,0:08:40.07,0:08:41.09,Default,,0,0,0,,Спорттық көлік
Dialogue: 0,0:08:42.01,0:08:43.05,Default,,0,0,0,,Салқын ұшақ
Dialogue: 0,0:08:43.06,0:08:44.05,Default,,0,0,0,,Лазанья
Dialogue: 0,0:08:44.08,0:08:45.09,Default,,0,0,0,,Интернет ойындары
Dialogue: 0,0:08:46.01,0:08:47.05,Default,,0,0,0,,және құмар ойындар
Dialogue: 0,0:08:48.00,0:08:48.50,Default,,0,0,0,,Vanilla Ice айтты
Dialogue: 0,0:08:55.09,0:08:56.08,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:08:57.01,0:09:00.00,Default,,0,0,0,,Жоғарыдан көрінетін табиғат өте әдемі
Dialogue: 0,0:09:01.06,0:09:04.08,Default,,0,0,0,,Жер шіркін шындыққа толы.
Dialogue: 0,0:09:05.08,0:09:11.03,Default,,0,0,0,,Әлем этникалық қақтығыстарға, нәсілдік кемсітушілікке және кедейлік теңсіздіктеріне байланысты нашарлап барады.
Dialogue: 0,0:09:12.00,0:09:14.08,Default,,0,0,0,,Барлық адамдар тең болуы керек, солай ма?
Dialogue: 0,0:09:15.03,0:09:16.09,Default,,0,0,0,,Сондықтан мен шешім қабылдадым
Dialogue: 0,0:09:18.03,0:09:20.08,Default,,0,0,0,,Мен бәріңді бірдей құшақтаймын!
Dialogue: 0,0:09:20.09,0:09:22.09,Default,,0,0,0,,Ол аздап ақымақ...
Dialogue: 0,0:09:23.00,0:09:25.08,Default,,0,0,0,,Сәлем! Оны аздап қабылдап, ертеңгі күнге дайындалыңыз.
Dialogue: 0,0:09:26.04,0:09:27.05,Default,,0,0,0,,Не болды?
Dialogue: 0,0:09:27.06,0:09:29.09,Default,,0,0,0,,Бүгінгі жарысқа көңіліңіз толмады ма?
Dialogue: 0,0:09:30.03,0:09:32.08,Default,,0,0,0,,Жарайды, жағдай қалай болғанымен, мен жеңемін.
Dialogue: 0,0:09:33.09,0:09:36.02,Default,,0,0,0,,Жеңіске жеткенің бәрі жақсы дегенді білдірмейді.
Dialogue: 0,0:09:36.07,0:09:37.07,Default,,0,0,0,,О...
Dialogue: 0,0:09:38.00,0:09:39.09,Default,,0,0,0,,SNS өрескел
Dialogue: 0,0:09:40.02,0:09:42.06,Default,,0,0,0,,Сіз уайымдайсыз ба? Не...
Dialogue: 0,0:09:43.03,0:09:46.01,Default,,0,0,0,,«Кларк биылғы әуе жарысында да жеңіске жетеді».
Dialogue: 0,0:09:46.02,0:09:47.03,Default,,0,0,0,,«Қараудың қажеті жоқ»
Dialogue: 0,0:09:47.05,0:09:48.05,Default,,0,0,0,,Һм… Ха-ха-ха
Dialogue: 0,0:09:49.03,0:09:51.06,Default,,0,0,0,,«Мен оны түсінсем де көргім келмейді»
Dialogue: 0,0:09:52.05,0:09:54.05,Default,,0,0,0,,«Осы жылы одан да көп...» «Мен қуанбаймын.»
Dialogue: 0,0:09:55.04,0:09:56.08,Default,,0,0,0,,«Шынымды айтсам, бұл қызықсыз».
Dialogue: 0,0:09:56.09,0:09:58.01,Default,,0,0,0,,«Мен оны қайта көрмеуім мүмкін»
Dialogue: 0,0:09:58.07,0:10:00.07,Default,,0,0,0,,«Бәсекелесі бар...»
Dialogue: 0,0:10:00.08,0:10:02.08,Default,,0,0,0,,Эй, сен де солай істе!
Dialogue: 0,0:10:03.02,0:10:06.01,Default,,0,0,0,,«Мен бұқа Луи Мюллерді көргім келді».
Dialogue: 0,0:10:07.01,0:10:08.00,Default,,0,0,0,,Мен келісемін.
Dialogue: 0,0:10:08.01,0:10:09.07,Default,,0,0,0,,I'm sorry.
Dialogue: 0,0:10:09.08,0:10:11.08,Default,,0,0,0,,Қазіргі уақытта жеке пайдалану үшін сақталған.
Dialogue: 0,0:10:12.01,0:10:14.09,Default,,0,0,0,,Не! Мен оның резервтелгенін ешқашан естіген емеспін.
Dialogue: 0,0:10:15.01,0:10:16.07,Default,,0,0,0,,Біз түнеп жатырмыз.
Dialogue: 0,0:10:17.04,0:10:19.09,Default,,0,0,0,,Атақты адамдар келе ме?
Dialogue: 0,0:10:20.00,0:10:20.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:22.01,0:10:23.03,Default,,0,0,0,,О, құдайым.
Dialogue: 0,0:10:23.09,0:10:25.01,Default,,0,0,0,,Мен мұны қайталаймын
Dialogue: 0,0:10:25.02,0:10:27.00,Default,,0,0,0,,Эбби, қайтайық.
Dialogue: 0,0:10:27.04,0:10:28.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:28.08,0:10:31.01,Default,,0,0,0,,Күндіз ұшқан ұшқыштың баласы шығар?
Dialogue: 0,0:10:31.07,0:10:33.05,Default,,0,0,0,,Бұл бала - Абигейл
Dialogue: 0,0:10:33.06,0:10:35.06,Default,,0,0,0,,Мен Синтиямын, топ иесімін.
Dialogue: 0,0:10:37.03,0:10:39.09,Default,,0,0,0,,Кларк, қыздарды үйлеріне жібер.
Dialogue: 0,0:10:40.00,0:10:40.50,Default,,0,0,0,,Иә~Иә
Dialogue: 0,0:10:41.06,0:10:44.02,Default,,0,0,0,,Даяшы! екеумізге де шампан
Dialogue: 0,0:10:46.01,0:10:49.00,Default,,0,0,0,,«Ол ұшқыш әйел сүйкімді еді»
Dialogue: 0,0:10:49.01,0:10:51.00,Default,,0,0,0,,«Иесі де жақсы әйел»
Dialogue: 0,0:10:51.01,0:10:52.09,Default,,0,0,0,,«Харизма керемет»
Dialogue: 0,0:10:53.00,0:10:55.02,Default,,0,0,0,,Ұйықтама!
Dialogue: 0,0:10:55.06,0:10:56.09,Default,,0,0,0,,Шындық
Dialogue: 0,0:10:57.00,0:10:59.03,Default,,0,0,0,,Сіздің жарысыңыз керемет болды.
Dialogue: 0,0:10:59.06,0:11:03.02,Default,,0,0,0,,Ол әлі қалыптасу сатысында, бірақ болашаққа үлкен мүмкіндіктер бар.
Dialogue: 0,0:11:05.00,0:11:06.05,Default,,0,0,0,,Көңіл-күйіңіз нашар ма?
Dialogue: 0,0:11:06.06,0:11:07.05,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:11:08.03,0:11:11.00,Default,,0,0,0,,Мен сенің айналаңда қобалжыдым.
Dialogue: 0,0:11:11.01,0:11:12.02,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,0:11:12.05,0:11:13.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:14.07,0:11:16.05,Default,,0,0,0,,(Бассейнге кіру дыбысы)
Dialogue: 0,0:11:17.07,0:11:19.05,Default,,0,0,0,,Абигейл! Келіңіздер
Dialogue: 0,0:11:19.07,0:11:21.03,Default,,0,0,0,,Жоқ (Кларк) Неліктен?
Dialogue: 0,0:11:21.07,0:11:23.02,Default,,0,0,0,,Менде купальник жоқ
Dialogue: 0,0:11:23.04,0:11:25.08,Default,,0,0,0,,Маған керегі жоқ, қара!
Dialogue: 0,0:11:26.09,0:11:27.07,Default,,0,0,0,,Tsk
Dialogue: 0,0:11:30.01,0:11:30.51,Default,,0,0,0,,Иә~Иә
Dialogue: 0,0:11:31.02,0:11:32.04,Default,,0,0,0,,(бассейнге кіру дыбысы)
Dialogue: 0,0:11:38.06,0:11:39.06,Default,,0,0,0,,Пу...
Dialogue: 0,0:11:39.08,0:11:41.01,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:11:41.02,0:11:42.07,Default,,0,0,0,,Ал, мен де.
Dialogue: 0,0:11:45.07,0:11:46.06,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:11:46.07,0:11:48.05,Default,,0,0,0,,Фухахаха~
Dialogue: 0,0:11:48.09,0:11:49.07,Default,,0,0,0,,Сәлем Сэм
Dialogue: 0,0:11:50.07,0:11:53.08,Default,,0,0,0,,Турнир комбинациялары әлі шешілді ме?
Dialogue: 0,0:11:54.00,0:11:57.07,Default,,0,0,0,,Төрешілер кездейсоқ шешім қабылдауы керек еді.
Dialogue: 0,0:11:57.09,0:11:59.01,Default,,0,0,0,,Ммм
Dialogue: 0,0:11:59.07,0:12:03.01,Default,,0,0,0,,Енді ойлап қарасам, біртүрлі өсек естідім.
Dialogue: 0,0:12:03.02,0:12:04.01,Default,,0,0,0,,Не?
Dialogue: 0,0:12:04.03,0:12:05.01,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:12:05.08,0:12:07.05,Default,,0,0,0,,Өтінемін, ашуланбауға болады ма?
Dialogue: 0,0:12:08.00,0:12:09.05,Default,,0,0,0,,Бұл жай ғана өсек
Dialogue: 0,0:12:10.00,0:12:12.09,Default,,0,0,0,,Бұл әуе жарысының сценарийі бар.
Dialogue: 0,0:12:14.00,0:12:18.00,Default,,0,0,0,,Жеңісті немесе жеңілісті өз еркімен басқаратын адам бар.
Dialogue: 0,0:12:18.01,0:12:19.00,Default,,0,0,0,,Хун
Dialogue: 0,0:12:19.01,0:12:21.07,Default,,0,0,0,,Бұл промоутер бизнесіндегі әдеттегі қадам.
Dialogue: 0,0:12:21.08,0:12:25.08,Default,,0,0,0,,Дегенмен, менің кеңсе қызметкеріме ешқандай айла қажет емес.
Dialogue: 0,0:12:26.03,0:12:28.06,Default,,0,0,0,,Мен сценарийді жоққа шығармаймын.
Dialogue: 0,0:12:28.08,0:12:31.07,Default,,0,0,0,,Спорт - бұл ойын-сауық, солай ма?
Dialogue: 0,0:12:32.02,0:12:34.08,Default,,0,0,0,,Мен бұл пікірмен толықтай келісемін.
Dialogue: 0,0:12:34.09,0:12:37.05,Default,,0,0,0,,Қызық болмаса, жұрттың жүрегі қимылдамайды.
Dialogue: 0,0:12:39.03,0:12:43.09,Default,,0,0,0,,Промоутердің көзқарасы бойынша менің Абигейлім туралы не ойлайсыз?
Dialogue: 0,0:12:44.03,0:12:45.03,Default,,0,0,0,,Сіздің қабілетіңізге байланысты
Dialogue: 0,0:12:45.09,0:12:47.08,Default,,0,0,0,,Сол қыз танымал болады.
Dialogue: 0,0:12:48.01,0:12:50.06,Default,,0,0,0,,Жоқ, ол қазірдің өзінде пайда бола бастады.
Dialogue: 0,0:12:50.08,0:12:52.08,Default,,0,0,0,,Турнирде жеңіске жету
Dialogue: 0,0:12:52.09,0:12:56.04,Default,,0,0,0,,Егер мен финалда Кларк мырзамен бәсекелесетін болсам.
Dialogue: 0,0:12:56.05,0:12:58.08,Default,,0,0,0,,Бұл өте қызықты болатынына сенімдімін.
Dialogue: 0,0:12:59.09,0:13:01.08,Default,,0,0,0,,Мен баяу сөйлескім келеді.
Dialogue: 0,0:13:03.00,0:13:04.01,Default,,0,0,0,,Осы нөмірге
Dialogue: 0,0:13:06.01,0:13:07.07,Default,,0,0,0,,Эбби! Мен үйге бара жатырмын
Dialogue: 0,0:13:07.09,0:13:09.08,Default,,0,0,0,,А, әлдеқашан?
Dialogue: 0,0:13:09.09,0:13:12.08,Default,,0,0,0,,Эй, менің бөлмемде тағы бір сусын ішейік.
Dialogue: 0,0:13:13.03,0:13:16.04,Default,,0,0,0,,Кешіріңіз, бірақ баланың ұйықтайтын уақыты келді.
Dialogue: 0,0:13:18.00,0:13:19.09,Default,,0,0,0,,Қайтадан ойнайық~
Dialogue: 0,0:13:20.06,0:13:21.05,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:13:21.06,0:13:22.09,Default,,0,0,0,,(өкшелі аяқ дыбыстары)
Dialogue: 0,0:13:23.00,0:13:24.03,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:13:24.04,0:13:25.04,Default,,0,0,0,,Эбби ше?
Dialogue: 0,0:13:25.06,0:13:28.01,Default,,0,0,0,,Мен қайтып келдім. Мен қазір ұйықтаймын.
Dialogue: 0,0:13:28.03,0:13:29.05,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:13:29.06,0:13:30.05,Default,,0,0,0,,Иә
Dialogue: 0,0:13:31.08,0:13:34.08,Default,,0,0,0,,О, Сэм, ертерек тамақтанғаныңызға рахмет.
Dialogue: 0,0:13:35.01,0:13:36.00,Default,,0,0,0,,Ертең?
Dialogue: 0,0:13:36.08,0:13:38.01,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:13:38.02,0:13:39.09,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:13:40.07,0:13:41.06,Default,,0,0,0,,Мен балық ұстадым.
Dialogue: 0,0:13:41.07,0:13:43.01,Default,,0,0,0,,Керемет жұмыс!
Dialogue: 0,0:13:43.04,0:13:44.06,Default,,0,0,0,,Мен душты қарызға аламын.
Dialogue: 0,0:13:44.07,0:13:45.05,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:13:47.02,0:13:48.02,Default,,0,0,0,,(ДК жабылу дыбысы)
Dialogue: 0,0:13:50.00,0:13:52.07,Default,,0,0,0,,Енді финалға дейін қауіпсіз боламыз.
Dialogue: 0,0:13:52.09,0:13:55.02,Default,,0,0,0,,Мына кесірткеге қара! Сіз көп балық ауладыңыз.
Dialogue: 0,0:13:56.00,0:13:57.03,Default,,0,0,0,,Бұл таңқаларлық (шайлау дыбысы)
Dialogue: 0,0:13:57.04,0:13:59.04,Default,,0,0,0,,Ол сенімді әйел.
Dialogue: 0,0:13:59.05,0:14:00.05,Default,,0,0,0,,Синтия
Dialogue: 0,0:14:01.01,0:14:04.02,Default,,0,0,0,,Сіз де толқып тұрсыз ба?
Dialogue: 0,0:14:04.03,0:14:05.02,Default,,0,0,0,,Орага?
Dialogue: 0,0:14:06.00,0:14:08.03,Default,,0,0,0,,Негізі егінші сияқты өмір сүру қандай?
Dialogue: 0,0:14:08.05,0:14:11.05,Default,,0,0,0,,Бұл сізге сәйкес келмейді және мұны істеу мүмкін емес.
Dialogue: 0,0:14:12.04,0:14:14.08,Default,,0,0,0,,Сіз табиғи алдамшысыз.
Dialogue: 0,0:14:18.01,0:14:19.03,Default,,0,0,0,,Ол жігітке не болды?
Dialogue: 0,0:14:19.04,0:14:20.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:21.00,0:14:23.01,Default,,0,0,0,,Эбби саған қарап тұр, Синтия.
Dialogue: 0,0:14:23.03,0:14:25.04,Default,,0,0,0,,Нағыз алаяққа ұқсамайды
Dialogue: 0,0:14:25.08,0:14:27.09,Default,,0,0,0,,Сіз әрқашан өзіңізді мұны істеуге мәжбүрлейтін сияқтысыз.
Dialogue: 0,0:14:29.05,0:14:31.03,Default,,0,0,0,,Неліктен ол...
Dialogue: 0,0:15:02.05,0:15:03.09,Default,,0,0,0,,Ха~!
Dialogue: 0,0:15:04.04,0:15:06.03,Default,,0,0,0,,Бұл шынымен де қауіпті жарыс.
Dialogue: 0,0:15:06.04,0:15:09.00,Default,,0,0,0,,Апат болса, көп нәрсе болар еді.
Dialogue: 0,0:15:09.01,0:15:10.04,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:15:10.05,0:15:12.00,Default,,0,0,0,,Уа, менің кезегімді қарашы!
Dialogue: 0,0:15:12.08,0:15:15.09,Default,,0,0,0,,Қарсылас Тото Виалли
Dialogue: 0,0:15:16.00,0:15:18.05,Default,,0,0,0,,Мына жігіт... ардагер дейді.
Dialogue: 0,0:15:18.06,0:15:19.07,Default,,0,0,0,,Сол үшін рахмет.
Dialogue: 0,0:15:20.03,0:15:21.02,Default,,0,0,0,,Онсыз?
Dialogue: 0,0:15:21.06,0:15:24.04,Default,,0,0,0,,Тәжірибелі қарсылас болсаңыз, жақсы жетекшілік ете аласыз.
Dialogue: 0,0:15:24.05,0:15:27.04,Default,,0,0,0,,Мені бірінші жібергені өте жақсы.
Dialogue: 0,0:15:28.00,0:15:30.03,Default,,0,0,0,,Бұл керемет ұқсастық.
Dialogue: 0,0:15:34.03,0:15:35.01,Default,,0,0,0,,(әйнек сықырлаған дыбыс)
Dialogue: 0,0:15:35.08,0:15:39.07,Default,,0,0,0,,Асыл ұшқыш әйел Абигейл Джонсқа
Dialogue: 0,0:15:40.04,0:15:42.07,Default,,0,0,0,,Жаңа жұлдыз әрекетте
Dialogue: 0,0:15:43.02,0:15:45.01,Default,,0,0,0,,Колонтитул?
Dialogue: 0,0:16:00.00,0:16:00.50,Default,,0,0,0,,Хун
Dialogue: 0,0:16:01.01,0:16:02.04,Default,,0,0,0,,Ол шығарылды.
Dialogue: 0,0:16:02.06,0:16:04.02,Default,,0,0,0,,Бұл атмосфераны жандандырады, солай емес пе?
Dialogue: 0,0:16:13.01,0:16:15.04,Default,,0,0,0,,Фуфуфуфуфу... ау, менің?
Dialogue: 0,0:16:15.05,0:16:18.08,Default,,0,0,0,,Тотоның жігіті жақсы жүрген сияқты.
Dialogue: 0,0:16:19.06,0:16:20.04,Default,,0,0,0,,Уф
Dialogue: 0,0:16:24.06,0:16:25.08,Default,,0,0,0,,Куу…
Dialogue: 0,0:16:26.09,0:16:28.04,Default,,0,0,0,,Тото күткендей
Dialogue: 0,0:16:28.05,0:16:30.08,Default,,0,0,0,,Кішкентай қызбен жарыса алмадың ба?
Dialogue: 0,0:16:31.06,0:16:33.00,Default,,0,0,0,,Сэм Хух?
Dialogue: 0,0:16:33.02,0:16:34.08,Default,,0,0,0,,Бұл басқа әңгіме.
Dialogue: 0,0:16:34.09,0:16:36.00,Default,,0,0,0,,Әңгіме?
Dialogue: 0,0:16:38.01,0:16:40.01,Default,,0,0,0,,Сіз қандай да бір уәде бердіңіз бе?
Dialogue: 0,0:16:40.03,0:16:41.02,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:42.07,0:16:44.08,Default,,0,0,0,,Фу... Айтайын дегенім, қарашы.
Dialogue: 0,0:16:45.05,0:16:48.06,Default,,0,0,0,,Эбби - әуе жарысын жандандыратын жаңа жұлдыз.
Dialogue: 0,0:16:49.02,0:16:50.09,Default,,0,0,0,,Бұл бала жеңіліп қалса ше?
Dialogue: 0,0:16:51.00,0:16:53.08,Default,,0,0,0,,Екеуміз үшін де үлкен шығын, солай емес пе?
Dialogue: 0,0:16:54.00,0:16:54.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:57.04,0:17:01.00,Default,,0,0,0,,Салбырап тұрған кеудеңіз бен құндылықтарыңызды өзіңізге күштеп салмаңыз!
Dialogue: 0,0:17:01.01,0:17:03.03,Default,,0,0,0,,Бұл оның жұлдыз екенін білдіре ме?
Dialogue: 0,0:17:03.05,0:17:06.03,Default,,0,0,0,,Ол тайыз әйел. Мені күлдіреді.
Dialogue: 0,0:17:06.06,0:17:10.00,Default,,0,0,0,,Тыңда, бәрін шешетін менмін.
Dialogue: 0,0:17:10.02,0:17:11.01,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:11.02,0:17:14.03,Default,,0,0,0,,Мен Тотоға оны мүлде құртуды айттым.
Dialogue: 0,0:17:14.09,0:17:18.07,Default,,0,0,0,,Мен үшінші дәрежелі сүтті команданың мені алуға тырысып жатқанына сене алар емеспін.
Dialogue: 0,0:17:18.08,0:17:21.02,Default,,0,0,0,,10 жыл, жоқ, 100 жыл ерте
Dialogue: 0,0:17:21.09,0:17:24.00,Default,,0,0,0,,Қанша жас әйел бар
Dialogue: 0,0:17:24.01,0:17:26.09,Default,,0,0,0,,Сіз маған ақша сұрап келе жатырсыз ба? Түсінесіз бе?
Dialogue: 0,0:17:28.01,0:17:29.07,Default,,0,0,0,,Әй, ақымақ
Dialogue: 0,0:17:30.04,0:17:34.05,Default,,0,0,0,,Тыңдаңыз, әуе жарысы – өз өміріне қауіп төндіретін ерлерге арналған спорт түрі.
Dialogue: 0,0:17:34.07,0:17:37.06,Default,,0,0,0,,Өтірік күлімсіреп, ауыр макияжбен өзін көрсетпе!
Dialogue: 0,0:17:38.02,0:17:41.01,Default,,0,0,0,,Әйелдер үндемей, үй шаруасымен айналысуы керек.
Dialogue: 0,0:17:41.08,0:17:43.00,Default,,0,0,0,,Ah~ah
Dialogue: 0,0:17:43.01,0:17:46.02,Default,,0,0,0,,Қазіргі кезде әйелдерді ашуландыру қорқынышты.
Dialogue: 0,0:17:46.06,0:17:47.06,Default,,0,0,0,,Біз не істейміз?
Dialogue: 0,0:17:48.01,0:17:49.03,Default,,0,0,0,,Олай болса
Dialogue: 0,0:17:49.04,0:17:51.06,Default,,0,0,0,,Әзірше бәрі жақсы.
Dialogue: 0,0:17:52.06,0:17:53.08,Default,,0,0,0,,Әлгі сұм бала...
Dialogue: 0,0:17:54.09,0:17:59.09,Default,,0,0,0,,Хаа һаа һаа һаа…
Dialogue: 0,0:18:08.02,0:18:10.05,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:18:10.07,0:18:12.07,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:18:17.01,0:18:17.51,Default,,0,0,0,,Уф
Dialogue: 0,0:18:20.08,0:18:22.01,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:18:25.06,0:18:27.01,Default,,0,0,0,,Уф... ой...
Dialogue: 0,0:18:32.07,0:18:34.01,Default,,0,0,0,,Эбби!
Dialogue: 0,0:18:34.02,0:18:35.01,Default,,0,0,0,,Ха! Хаа...
Dialogue: 0,0:18:35.08,0:18:36.07,Default,,0,0,0,,Уф…
Dialogue: 0,0:18:44.08,0:18:48.05,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:51.04,0:18:53.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:53.07,0:18:56.08,Default,,0,0,0,,Соқтығысайық!
Dialogue: 0,0:18:56.09,0:18:59.07,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:16.00,0:19:17.06,Default,,0,0,0,,Жүр!
Dialogue: 0,0:19:17.08,0:19:21.06,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:29.07,0:19:31.02,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:19:31.03,0:19:32.02,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:19:32.04,0:19:33.02,Default,,0,0,0,,Хаа…
Dialogue: 0,0:19:34.01,0:19:36.03,Default,,0,0,0,,Сэм Сіз мұны қазір көрдіңіз бе?
Dialogue: 0,0:19:36.05,0:19:37.03,Default,,0,0,0,,Ол керемет
Dialogue: 0,0:19:38.00,0:19:40.04,Default,,0,0,0,,Мен ұшқыштың мұндай тәртіпсіздік жасағанын көрген емеспін.
Dialogue: 0,0:19:40.06,0:19:42.07,Default,,0,0,0,,Бұдан былай қызықты болатыны сөзсіз!
Dialogue: 0,0:19:42.08,0:19:46.08,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:49.05,0:19:51.05,Default,,0,0,0,,Әйел бе, жоқ па
Dialogue: 0,0:19:51.06,0:19:54.04,Default,,0,0,0,,Бұл жарысты қызықты ете алатын жалғыз адам – сол бала.
Dialogue: 0,0:19:54.09,0:19:56.04,Default,,0,0,0,,Мына бала жұлдыз
Dialogue: 0,0:19:59.09,0:20:02.09,Default,,0,0,0,,Финал – Кларк Абигейлге қарсы.
Dialogue: 0,0:20:06.06,0:20:08.08,Default,,0,0,0,,Мені қорлағаныңыз үшін кешірім сұрауыңызды қалаймын.
Dialogue: 0,0:20:09.05,0:20:10.06,Default,,0,0,0,,Қате түсінбеңіз.
Dialogue: 0,0:20:10.07,0:20:13.05,Default,,0,0,0,,Мен ешбір жағдайда мизогинист емеспін.
Dialogue: 0,0:20:13.07,0:20:15.01,Default,,0,0,0,,Шын мәнінде, бұл керісінше.
Dialogue: 0,0:20:15.05,0:20:18.04,Default,,0,0,0,,Әйел – ер адамды емдейтін муза.
Dialogue: 0,0:20:18.05,0:20:21.04,Default,,0,0,0,,Сондықтан мен сіздің айуандық майданға келгеніңізді қаламаймын.
Dialogue: 0,0:20:22.01,0:20:23.07,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:20:23.08,0:20:27.04,Default,,0,0,0,,Бірақ қабілетің болса, олай емес.
Dialogue: 0,0:20:27.09,0:20:29.05,Default,,0,0,0,,Жақсы ұшқыш.
Dialogue: 0,0:20:40.08,0:20:42.06,Default,,0,0,0,,Айтайын ба? иә?
Dialogue: 0,0:20:43.02,0:20:45.09,Default,,0,0,0,,Неліктен ол мұны істеп жатыр?
Dialogue: 0,0:20:47.00,0:20:47.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:49.00,0:20:50.06,Default,,0,0,0,,Өлу
Dialogue: 0,0:20:51.00,0:20:57.00,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:22:44.07,0:22:50.07,Default,,0,0,0,,~♪
Dialogue: 0,0:22:51.57,0:22:56.57,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
