Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Ай!
Dialogue: 0,0:00:09.05,0:00:10.03,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:10.05,0:00:11.05,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:00:11.07,0:00:12.05,Default,,0,0,0,,Хаа…
Dialogue: 0,0:00:12.06,0:00:19.02,Default,,0,0,0,,(ағаштың жарылған дыбысы)
Dialogue: 0,0:00:33.04,0:00:34.02,Default,,0,0,0,,Хаа…
Dialogue: 0,0:00:39.02,0:00:40.01,Default,,0,0,0,,(жану дыбысы жеңілірек)
Dialogue: 0,0:00:41.05,0:00:43.00,Default,,0,0,0,,Хаа~
Dialogue: 0,0:00:44.05,0:00:50.09,Default,,0,0,0,,(теңіз құстарының айқайы)
Dialogue: 0,0:00:51.07,0:00:55.00,Default,,0,0,0,,Хмм... ой...
Dialogue: 0,0:00:56.07,0:00:57.05,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:00:59.04,0:01:00.07,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:01:00.09,0:01:02.00,Default,,0,0,0,,Неге?! Неге?!
Dialogue: 0,0:01:02.04,0:01:03.03,Default,,0,0,0,,Хаа…
Dialogue: 0,0:01:04.04,0:01:07.01,Default,,0,0,0,,Көмек!
Dialogue: 0,0:01:07.03,0:01:12.04,Default,,0,0,0,,Маған көмектес!
Dialogue: 0,0:01:12.06,0:01:13.08,Default,,0,0,0,,Пури...!
Dialogue: 0,0:01:14.03,0:01:20.03,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:12.08,0:02:18.08,Default,,0,0,0,,~♪
Dialogue: 0,0:02:19.05,0:02:21.08,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:02:23.06,0:02:24.05,Default,,0,0,0,,Uhu…
Dialogue: 0,0:02:24.09,0:02:26.05,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:02:27.02,0:02:28.08,Default,,0,0,0,,Ол ояу болды ма?
Dialogue: 0,0:02:29.01,0:02:31.04,Default,,0,0,0,,Иә, кір жуғаныңызға рахмет. Мен оны алуға бардым
Dialogue: 0,0:02:31.05,0:02:32.05,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:32.06,0:02:34.04,Default,,0,0,0,,.
Dialogue: 0,0:02:34.05,0:02:36.06,Default,,0,0,0,,Кептіргіштен рұқсатсыз шығарылған.
Dialogue: 0,0:02:37.01,0:02:39.03,Default,,0,0,0,,Сәл күтсеңіз жақсы ма?
Dialogue: 0,0:02:39.08,0:02:41.07,Default,,0,0,0,,Уақытында болмадыңыз ба?
Dialogue: 0,0:02:42.02,0:02:44.09,Default,,0,0,0,,Ол бірнеше минутқа ғана кешігіп келді.
Dialogue: 0,0:02:45.00,0:02:46.08,Default,,0,0,0,,Өйткені, бұл пойыз емес.
Dialogue: 0,0:02:47.00,0:02:48.00,Default,,0,0,0,,Фу…
Dialogue: 0,0:02:48.02,0:02:51.00,Default,,0,0,0,,Қызықсыз нәрселерден тітіркеніп қалсаңыз, шаршамайсыз ба?
Dialogue: 0,0:02:52.09,0:02:56.05,Default,,0,0,0,,«Кешірімді жүрек» деп тағы айтқыңыз келетін шығар?
Dialogue: 0,0:02:59.05,0:03:01.09,Default,,0,0,0,,Қараңдаршы, мен ерініп, сөйлесемін.
Dialogue: 0,0:03:08.08,0:03:12.06,Default,,0,0,0,,Сиқыршының не істей алатынын білесіз бе?
Dialogue: 0,0:03:13.04,0:03:16.07,Default,,0,0,0,,Қорқақ қызды көңілді кемпірге айналдыру
Dialogue: 0,0:03:17.02,0:03:18.09,Default,,0,0,0,,Төсекте жатқан науқас адам
Dialogue: 0,0:03:19.00,0:03:21.09,Default,,0,0,0,,Ол мені төсегіммен бірге әлемді аралауға апарды.
Dialogue: 0,0:03:22.03,0:03:24.00,Default,,0,0,0,,Иә? Не айтқың келеді?
Dialogue: 0,0:03:24.01,0:03:26.08,Default,,0,0,0,,Хехе... Түсімде үнемі пайда болады.
Dialogue: 0,0:03:28.00,0:03:31.00,Default,,0,0,0,,Оны басқа балалармен бірге көрсетіңіз.
Dialogue: 0,0:03:31.05,0:03:32.07,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:03:34.02,0:03:36.01,Default,,0,0,0,,Біз тағы кездесеміз.
Dialogue: 0,0:03:36.05,0:03:37.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:42.03,0:03:43.03,Default,,0,0,0,,Иә...
Dialogue: 0,0:03:45.04,0:03:47.00,Default,,0,0,0,,Шебер...
Dialogue: 0,0:03:47.04,0:03:48.03,Default,,0,0,0,,(кранның ашылған дыбысы)
Dialogue: 0,0:03:51.06,0:03:52.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:52.09,0:03:53.07,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:54.00,0:03:56.06,Default,,0,0,0,,Не... Жоқ, сен!
Dialogue: 0,0:03:57.02,0:03:58.04,Default,,0,0,0,,Айналма жол
Dialogue: 0,0:03:59.04,0:04:00.07,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:04:02.06,0:04:04.08,Default,,0,0,0,,«Гравитациядан босатылған»
Dialogue: 0,0:04:04.09,0:04:09.04,Default,,0,0,0,,«Ренжден, қызғаныштан және осының бәрінен аулақ бол».
Dialogue: 0,0:04:09.09,0:04:11.05,Default,,0,0,0,,Бұл сіз айтқан сөздер.
Dialogue: 0,0:04:13.02,0:04:16.06,Default,,0,0,0,,Кімді алдасаң да, сатсаң да, ол сенің еркіндігің.
Dialogue: 0,0:04:17.02,0:04:18.07,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені жасаңыз
Dialogue: 0,0:04:20.02,0:04:21.00,Default,,0,0,0,,Тек...
Dialogue: 0,0:04:22.02,0:04:23.05,Default,,0,0,0,,Өзіңізді кешіріңіз
Dialogue: 0,0:04:25.00,0:04:27.04,Default,,0,0,0,,Бұл мені құтқарды
Dialogue: 0,0:04:27.05,0:04:28.06,Default,,0,0,0,,(секіру дыбысы)
Dialogue: 0,0:04:33.02,0:04:36.06,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:04:39.04,0:04:40.06,Default,,0,0,0,,(Бұрылу тетігінің дыбысы)
Dialogue: 0,0:04:55.05,0:04:58.00,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:04:58.07,0:04:59.09,Default,,0,0,0,,Уәде етілгендей
Dialogue: 0,0:05:00.00,0:05:02.00,Default,,0,0,0,,Мен саған оның бұралған түрін көрсетемін.
Dialogue: 0,0:05:02.02,0:05:03.07,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:05:03.08,0:05:06.07,Default,,0,0,0,,Мен оны өз қолыммен тұншықтырып өлтіргім келді.
Dialogue: 0,0:05:06.09,0:05:08.04,Default,,0,0,0,,Бұл ережелерге қайшы
Dialogue: 0,0:05:08.09,0:05:11.08,Default,,0,0,0,,Сіз бұрын ұсынған сыйақы үшін ақы алатыныңызды айтқан жоқсыз ба?
Dialogue: 0,0:05:12.04,0:05:15.06,Default,,0,0,0,,Ал, бұл жолы мен сені жақтаймын.
Dialogue: 0,0:05:16.01,0:05:18.07,Default,,0,0,0,,Өйткені, бұл бизнес.
Dialogue: 0,0:05:18.09,0:05:20.00,Default,,0,0,0,,Көтеру
Dialogue: 0,0:05:20.01,0:05:22.06,Default,,0,0,0,,Жас әйелдер болмаса, өтіңіз.
Dialogue: 0,0:05:22.08,0:05:24.07,Default,,0,0,0,,Әңгімені кейінірек айтып бер.
Dialogue: 0,0:05:24.08,0:05:25.07,Default,,0,0,0,,Олар Жапонияда, анамды күтіп, оны қауіпсіз ұстап отыр ➡
Dialogue: 0,0:05:26.01,0:05:27.06,Default,,0,0,0,,Оң жақпен бірдей
Dialogue: 0,0:05:27.09,0:05:30.03,Default,,0,0,0,,Мен көмектесу үшін ештеңе істей алмаймын.
Dialogue: 0,0:05:30.06,0:05:31.06,Default,,0,0,0,,Көбірек көтеру!
Dialogue: 0,0:05:32.01,0:05:33.07,Default,,0,0,0,,Түскіңіз келсе, дәл қазір.
Dialogue: 0,0:05:33.08,0:05:35.02,Default,,0,0,0,,Ха~хахахаха
Dialogue: 0,0:05:35.03,0:05:36.07,Default,,0,0,0,,Қызықты балалар
Dialogue: 0,0:05:36.08,0:05:38.02,Default,,0,0,0,,Әрі қарай көтеру
Dialogue: 0,0:05:38.03,0:05:39.01,Default,,0,0,0,,Олар Жапонияда, анамды күтіп, оны қауіпсіз ұстап отыр ➡
Dialogue: 0,0:05:39.05,0:05:40.08,Default,,0,0,0,,Ал, бүгін кешке.
Dialogue: 0,0:05:40.09,0:05:41.07,Default,,0,0,0,,(Қоңыраудың дыбысы ажыратылады)
Dialogue: 0,0:05:43.03,0:05:45.03,Default,,0,0,0,,Біз оған шынымен де қол жеткіздік. Есептік жазбаңызда
Dialogue: 0,0:05:46.05,0:05:49.01,Default,,0,0,0,,100 миллиард дайын
Dialogue: 0,0:05:49.05,0:05:50.06,Default,,0,0,0,,Лю және басқалары ше?
Dialogue: 0,0:05:51.01,0:05:52.02,Default,,0,0,0,,Токиоға бару
Dialogue: 0,0:05:55.06,0:05:57.05,Default,,0,0,0,,Олар түнгі үкілер.
Dialogue: 0,0:05:59.09,0:06:03.06,Default,,0,0,0,,Мен бұршақты қайтадан ауыстырып көрдім, бірақ бұл менің дәміме сәйкес келетінін білмеймін.
Dialogue: 0,0:06:11.07,0:06:15.04,Default,,0,0,0,,Шынымды айтсам, мен ешқашан кофе ішкен емеспін.
Dialogue: 0,0:06:15.07,0:06:16.06,Default,,0,0,0,,Е...
Dialogue: 0,0:06:16.09,0:06:19.03,Default,,0,0,0,,Бірақ жасағандарың дәмді болады.
Dialogue: 0,0:06:20.01,0:06:21.07,Default,,0,0,0,,Мен сені ұната бастадым
Dialogue: 0,0:06:24.03,0:06:25.07,Default,,0,0,0,,Рахмет
Dialogue: 0,0:06:26.07,0:06:28.02,Default,,0,0,0,,Исигами мырза, өтінемін.
Dialogue: 0,0:06:28.04,0:06:30.08,Default,,0,0,0,,Не? Мен кофені ұнатпаймын
Dialogue: 0,0:06:30.09,0:06:32.03,Default,,0,0,0,,Кафе ау лайт болсын
Dialogue: 0,0:06:57.05,0:06:59.00,Default,,0,0,0,,Барлығы қатты ұйықтап жатыр.
Dialogue: 0,0:07:00.01,0:07:02.02,Default,,0,0,0,,Мен ойлағаннан да жақсы ұйықтадым.
Dialogue: 0,0:07:03.04,0:07:05.01,Default,,0,0,0,,〈Жергілікті жерде не болып жатыр? 〉
Dialogue: 0,0:07:08.03,0:07:12.06,Default,,0,0,0,,〈 〉
Dialogue: 0,0:07:12.07,0:07:14.08,Default,,0,0,0,,〈Жарайды, мына сақинадағы сарысу қандай? 〉
Dialogue: 0,0:07:18.05,0:07:20.08,Default,,0,0,0,,〈Ол жерге жеткенде〉
Dialogue: 0,0:07:20.09,0:07:22.02,Default,,0,0,0,,〈Сізге алкоголь ұсынса да, оған қол тигізбеңіз〉
Dialogue: 0,0:07:31.08,0:07:33.08,Default,,0,0,0,,〈О, қатты ішетін адам күткендей! 〉
Dialogue: 0,0:07:34.00,0:07:35.00,Default,,0,0,0,,〈Тағы да бар! 〉
Dialogue: 0,0:07:40.01,0:07:41.03,Default,,0,0,0,,Сәлем
Dialogue: 0,0:07:42.00,0:07:44.03,Default,,0,0,0,,Мен ұшақта тым көп ішіп алдым деп ойлаймын.
Dialogue: 0,0:07:46.07,0:07:48.09,Default,,0,0,0,,Мені әлі де көлік алып кеткенін қаламаймын.
Dialogue: 0,0:07:49.05,0:07:51.01,Default,,0,0,0,,Барлығыңызға кофе іше аласыз ба?
Dialogue: 0,0:07:57.01,0:07:58.08,Default,,0,0,0,,Мен оны алып жүрейін бе?
Dialogue: 0,0:08:05.07,0:08:06.08,Default,,0,0,0,,Қан жарылысы!
Dialogue: 0,0:08:07.01,0:08:11.01,Default,,0,0,0,,Жол бос емес, сондықтан мен төте жолды аламын.
Dialogue: 0,0:08:11.09,0:08:13.04,Default,,0,0,0,,Тышқан қақпанына сақ болыңыз
Dialogue: 0,0:08:13.05,0:08:14.03,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:08:27.00,0:08:30.01,Default,,0,0,0,,(Жан) Д… Жоқ, басқа нәрсе. Қара, ол сонда тұр. Біраз уақыт өтті
Dialogue: 0,0:08:30.03,0:08:32.06,Default,,0,0,0,,Сәлем Шого, мен саған қамқор боламын.
Dialogue: 0,0:08:33.01,0:08:34.09,Default,,0,0,0,,Жарайды, бастайық!
Dialogue: 0,0:08:35.02,0:08:36.03,Default,,0,0,0,,О!
Dialogue: 0,0:08:41.01,0:08:43.07,Default,,0,0,0,,Мен де шұғыл тамақ дайындадым.
Dialogue: 0,0:08:43.08,0:08:45.02,Default,,0,0,0,,Күткендей!
Dialogue: 0,0:09:17.08,0:09:19.05,Default,,0,0,0,,Асығыңыз, асығыңыз!
Dialogue: 0,0:09:19.06,0:09:21.02,Default,,0,0,0,,Олар келе жатыр!
Dialogue: 0,0:09:21.03,0:09:22.03,Default,,0,0,0,,Oz!
Dialogue: 0,0:09:22.07,0:09:24.07,Default,,0,0,0,,Мазасыз бірдеңе айта бастаған шығарсыз!
Dialogue: 0,0:09:24.08,0:09:26.06,Default,,0,0,0,,Бетіңізді алға қаратып, қолыңызды қозғаңыз.
Dialogue: 0,0:09:26.08,0:09:27.06,Default,,0,0,0,,Тс!
Dialogue: 0,0:09:28.01,0:09:29.02,Default,,0,0,0,,Рас
Dialogue: 0,0:09:29.03,0:09:33.00,Default,,0,0,0,,Эдамаме маған Роппонгиді де бояуымды айтсын.
Dialogue: 0,0:09:33.01,0:09:34.09,Default,,0,0,0,,Уақыт өте нашарлаған түстер
Dialogue: 0,0:09:35.00,0:09:38.01,Default,,0,0,0,,Мен оны қайта шығаруға мүмкіндік жоқ, сондықтан менің таңдауым жоқ!
Dialogue: 0,0:09:38.03,0:09:40.09,Default,,0,0,0,,Синтия! Ол сонда болды ма?
Dialogue: 0,0:09:41.01,0:09:42.03,Default,,0,0,0,,Сүйкімді емес пе?
Dialogue: 0,0:09:42.05,0:09:44.00,Default,,0,0,0,,Сіз бәрібір байқамайсыз
Dialogue: 0,0:09:44.09,0:09:45.07,Default,,0,0,0,,Әлі де орындық!
Dialogue: 0,0:09:45.09,0:09:47.01,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:09:47.03,0:09:49.06,Default,,0,0,0,,Мен соңғы сәтте орындық ауыстырғанын естіген емеспін!
Dialogue: 0,0:09:50.00,0:09:51.08,Default,,0,0,0,,Қылыш жасанды болуы керек емес пе?
Dialogue: 0,0:09:51.09,0:09:53.03,Default,,0,0,0,,Шынайы болыңыз!
Dialogue: 0,0:09:53.05,0:09:54.09,Default,,0,0,0,,Не? Сен ақымақсың ба?
Dialogue: 0,0:09:55.00,0:09:56.02,Default,,0,0,0,,Әкемнің тікұшағы келе жатыр.
Dialogue: 0,0:09:56.03,0:09:57.06,Default,,0,0,0,,Эвакуацияға дайындалу Асығыңыз!
Dialogue: 0,0:09:57.08,0:09:59.05,Default,,0,0,0,,Өйткені соңында бір ғана лифт жұмыс істейді.
Dialogue: 0,0:10:00.03,0:10:01.06,Default,,0,0,0,,Бәріміз бірге түсейік!
Dialogue: 0,0:10:01.07,0:10:02.06,Default,,0,0,0,,Әй, асығыңыз!
Dialogue: 0,0:10:02.07,0:10:03.05,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:04.02,0:10:05.01,Default,,0,0,0,,Мен онымен екеуміз ғана, бір рет болса да сөйлескенді қатты қалаймын. Хехе.
Dialogue: 0,0:10:05.07,0:10:06.06,Default,,0,0,0,,Төраға!
Dialogue: 0,0:10:08.02,0:10:09.03,Default,,0,0,0,,Біз келдік.
Dialogue: 0,0:10:09.06,0:10:11.08,Default,,0,0,0,,Исигами мырза да (Ишигами) Ха!
Dialogue: 0,0:10:14.05,0:10:15.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:15.07,0:10:17.00,Default,,0,0,0,,Жоғарыдан келді ме?
Dialogue: 0,0:10:17.01,0:10:18.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:18.03,0:10:19.02,Default,,0,0,0,,Артқа қайту Артқа қайту!
Dialogue: 0,0:10:19.03,0:10:22.07,Default,,0,0,0,,(шу)
Dialogue: 0,0:10:23.09,0:10:25.07,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:10:28.05,0:10:30.06,Default,,0,0,0,,Менің басым ауыр болып тұр.
Dialogue: 0,0:10:31.01,0:10:33.03,Default,,0,0,0,,Менің ойымша, сіз аздап шаршаған шығарсыз.
Dialogue: 0,0:10:34.00,0:10:35.02,Default,,0,0,0,,Екеуі сол бөлмеде.
Dialogue: 0,0:10:35.04,0:10:36.02,Default,,0,0,0,,Иә
Dialogue: 0,0:10:39.06,0:10:40.07,Default,,0,0,0,,(электрондық құлыпты ашу дыбысы)
Dialogue: 0,0:10:40.08,0:10:42.02,Default,,0,0,0,,Бұл қандай мүсінше?
Dialogue: 0,0:10:42.03,0:10:43.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:43.03,0:10:44.03,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:10:44.04,0:10:45.03,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:45.04,0:10:46.07,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:10:46.08,0:10:49.02,Default,,0,0,0,,Егер сізге ұнамаса, біз оны кәдеге жаратамыз.
Dialogue: 0,0:10:51.07,0:10:52.06,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:10:53.01,0:10:54.02,Default,,0,0,0,,Оны сол күйінде қалдырыңыз.
Dialogue: 0,0:10:57.06,0:10:58.04,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:23.02,0:11:25.06,Default,,0,0,0,,Лоран Мен оны көріп тұрмын
Dialogue: 0,0:11:33.03,0:11:35.09,Default,,0,0,0,,Менің сүйкімді эдамама сәлем айтыңыз
Dialogue: 0,0:11:36.01,0:11:36.51,Default,,0,0,0,,О
Dialogue: 0,0:11:46.04,0:11:48.05,Default,,0,0,0,,Ахаха, бұл керемет!
Dialogue: 0,0:11:57.09,0:12:00.05,Default,,0,0,0,,〈Екеуің де келдіңдер〉
Dialogue: 0,0:12:00.07,0:12:02.02,Default,,0,0,0,,Мен бұны бұрыннан-ақ есіме түсіріп қойдым, білесің бе.
Dialogue: 0,0:12:03.04,0:12:04.06,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:04.08,0:12:05.08,Default,,0,0,0,,Мен сені алып келдім
Dialogue: 0,0:12:11.03,0:12:16.02,Default,,0,0,0,,(кездейсоқ ату дыбысы)
Dialogue: 0,0:12:16.03,0:12:17.01,Default,,0,0,0,,(электрондық құлыпты құлыптау дыбысы)
Dialogue: 0,0:12:17.04,0:12:20.01,Default,,0,0,0,,Нуоооо~ Мені атып тастады!
Dialogue: 0,0:12:20.02,0:12:21.09,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:22.00,0:12:24.01,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:24.02,0:12:26.00,Default,,0,0,0,,Аха~! Ахахаха~!
Dialogue: 0,0:12:26.05,0:12:27.06,Default,,0,0,0,,Гааах!
Dialogue: 0,0:12:27.08,0:12:30.03,Default,,0,0,0,,Жақсырақ жол бар.
Dialogue: 0,0:12:31.07,0:12:34.01,Default,,0,0,0,,Бұл маған әкемнен қалған нәрсе.
Dialogue: 0,0:12:34.05,0:12:36.05,Default,,0,0,0,,Эй, оны араластырма.
Dialogue: 0,0:12:36.06,0:12:40.03,Default,,0,0,0,,(кездейсоқ ату мен дүрбелең дыбыстары)
Dialogue: 0,0:12:44.04,0:12:45.02,Default,,0,0,0,,Надаба…
Dialogue: 0,0:12:45.05,0:12:46.09,Default,,0,0,0,,Түсіңіз!
Dialogue: 0,0:12:52.00,0:12:52.50,Default,,0,0,0,,(Тығынның тартылған дыбысы)
Dialogue: 0,0:12:53.01,0:12:54.05,Default,,0,0,0,,Чинг Чинг!
Dialogue: 0,0:12:54.06,0:12:57.06,Default,,0,0,0,,Бірақ бұл жолы мен шынымен таң қалдым.
Dialogue: 0,0:12:57.07,0:13:00.01,Default,,0,0,0,,Балалар сендерді күтпеген қонақ болады деп күтпедім.
Dialogue: 0,0:13:00.06,0:13:02.04,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:13:02.07,0:13:05.07,Default,,0,0,0,,Сэм мен Коулман да сені алдап кетті.
Dialogue: 0,0:13:06.01,0:13:09.08,Default,,0,0,0,,Мен Америкалық раундта Эддимен жұмыс істедім.
Dialogue: 0,0:13:09.09,0:13:11.09,Default,,0,0,0,,Ол өте сенімді адам.
Dialogue: 0,0:13:12.00,0:13:15.01,Default,,0,0,0,,Мен Монтойяның «Кисс» фильмін сатып алған тұтынушымын.
Dialogue: 0,0:13:15.02,0:13:17.01,Default,,0,0,0,,Содан бері қарым-қатынас
Dialogue: 0,0:13:17.03,0:13:20.08,Default,,0,0,0,,Әй, біз әзілдеп жатырмыз, әуре болма.
Dialogue: 0,0:13:21.01,0:13:23.09,Default,,0,0,0,,Ақша таппайды, Кек алуға қызықпаймын.
Dialogue: 0,0:13:24.00,0:13:26.07,Default,,0,0,0,,Бизнес - бұл бөлек әңгіме.
Dialogue: 0,0:13:26.08,0:13:29.07,Default,,0,0,0,,Мен жай ғана қатал сөйлейтін бағынушы мен реквизиттерді жалға алдым.
Dialogue: 0,0:13:29.08,0:13:31.01,Default,,0,0,0,,Ол байсалды болды ма?
Dialogue: 0,0:13:31.09,0:13:32.08,Default,,0,0,0,,О
Dialogue: 0,0:13:33.02,0:13:35.06,Default,,0,0,0,,Бірақ маған бір алаяқ айтты
Dialogue: 0,0:13:36.03,0:13:38.07,Default,,0,0,0,,«Өзіңді кешір»
Dialogue: 0,0:13:39.04,0:13:42.06,Default,,0,0,0,,Жоқ, бұл жалғыз себеп емес.
Dialogue: 0,0:13:43.01,0:13:46.04,Default,,0,0,0,,Бұл жігіт әрқашан маңызды нәрселер туралы айтпайды.
Dialogue: 0,0:13:46.05,0:13:48.01,Default,,0,0,0,,Дұрыс, бір-бірімізді оңаша қалдырайық.
Dialogue: 0,0:13:48.02,0:13:49.06,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:13:49.09,0:13:51.06,Default,,0,0,0,,Бірақ Лоран мырза
Dialogue: 0,0:13:51.07,0:13:54.03,Default,,0,0,0,,Сіз Эдамура мырзамен жақсы сәйкестендіңіз.
Dialogue: 0,0:13:55.00,0:13:57.01,Default,,0,0,0,,Оз семсермен бетпе-бет келгенде
Dialogue: 0,0:13:57.07,0:13:59.08,Default,,0,0,0,,Қан пакеті толық көрінеді.
Dialogue: 0,0:14:00.02,0:14:03.01,Default,,0,0,0,,Сен оны Озден көре аласың ба деп ойлап едім.
Dialogue: 0,0:14:03.02,0:14:04.04,Default,,0,0,0,,Осылайша
Dialogue: 0,0:14:04.05,0:14:06.03,Default,,0,0,0,,Сізге рахмет, мен жақсы көрдім.
Dialogue: 0,0:14:06.07,0:14:07.06,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:14:07.07,0:14:10.08,Default,,0,0,0,,Мен шынымен де Эдамура мырзаны толығымен жеңілді деп ойладым.
Dialogue: 0,0:14:11.07,0:14:14.04,Default,,0,0,0,,Ішімдегі бәрінен айырылып қала жаздадым.
Dialogue: 0,0:14:14.08,0:14:16.03,Default,,0,0,0,,Сізге рахмет, сіз өзіңізді сергек сезінесіз, солай емес пе?
Dialogue: 0,0:14:17.03,0:14:18.02,Default,,0,0,0,,Иә
Dialogue: 0,0:14:18.06,0:14:20.07,Default,,0,0,0,,Лоран, сен де.
Dialogue: 0,0:14:20.09,0:14:23.01,Default,,0,0,0,,Люға бір соққы беріңіз, өзіңізді сергітіңіз, солай ма?
Dialogue: 0,0:14:23.05,0:14:26.01,Default,,0,0,0,,А, өте жақсы сезінді.
Dialogue: 0,0:14:26.04,0:14:27.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:28.00,0:14:29.01,Default,,0,0,0,,Сонымен
Dialogue: 0,0:14:29.06,0:14:31.08,Default,,0,0,0,,Егін - ең жақсы!
Dialogue: 0,0:14:31.09,0:14:35.01,Default,,0,0,0,,Бұл бір тонна шегерім сияқты.
Dialogue: 0,0:14:52.06,0:14:55.03,Default,,0,0,0,,Сол үш адаммен жарасып қалғаныма қуаныштымын.
Dialogue: 0,0:14:56.02,0:14:58.04,Default,,0,0,0,,Оның орнына электрондық поштаны жібердіңіз бе?
Dialogue: 0,0:14:58.06,0:14:59.05,Default,,0,0,0,,О
Dialogue: 0,0:14:59.07,0:15:02.02,Default,,0,0,0,,Сивон түсірген фильмін де қосыңыз.
Dialogue: 0,0:15:02.07,0:15:03.06,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:15:03.08,0:15:07.02,Default,,0,0,0,,Қалғаны ата-ана мен баланың күнделікті не істейтініне байланысты деп ойлаймын.
Dialogue: 0,0:15:07.04,0:15:08.09,Default,,0,0,0,,Қосымша…
Dialogue: 0,0:15:09.00,0:15:12.02,Default,,0,0,0,,Масато Масато!
Dialogue: 0,0:15:12.08,0:15:14.00,Default,,0,0,0,,Мен сені ұмытып кеттім.
Dialogue: 0,0:15:14.02,0:15:16.00,Default,,0,0,0,,Күнделікті әрекеттер...
Dialogue: 0,0:15:16.02,0:15:17.08,Default,,0,0,0,,Сен және Оз сияқты
Dialogue: 0,0:15:18.02,0:15:19.02,Default,,0,0,0,,Жалғыз қалдырыңыз
Dialogue: 0,0:15:21.02,0:15:23.02,Default,,0,0,0,,Аяғыңызды жуғаннан кейін не істейсіз?
Dialogue: 0,0:15:23.07,0:15:26.05,Default,,0,0,0,,Біз... Меніңше, солай.
Dialogue: 0,0:15:26.06,0:15:29.06,Default,,0,0,0,,Егер сіз кофені ұнатсаңыз, неге кафе ашпасқа?
Dialogue: 0,0:15:30.01,0:15:31.07,Default,,0,0,0,,Осы уақытқа дейін әлі жоқ.
Dialogue: 0,0:15:32.00,0:15:33.09,Default,,0,0,0,,Бірақ сіз дайындаған кофемен
Dialogue: 0,0:15:34.00,0:15:35.05,Default,,0,0,0,,Егер мен бәріне күлкі сыйлай алсам...
Dialogue: 0,0:15:37.06,0:15:39.06,Default,,0,0,0,,Мен білмей тұрып, таң ата бастады.
Dialogue: 0,0:15:42.02,0:15:43.03,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:15:44.03,0:15:45.08,Default,,0,0,0,,Қалай болғанда да, мен жақында 15-ке толамын.
Dialogue: 0,0:15:57.06,0:15:59.00,Default,,0,0,0,,Енді бәрі жақсы
Dialogue: 0,0:15:59.05,0:16:00.03,Default,,0,0,0,,(Чак!)
Dialogue: 0,0:16:23.09,0:16:25.03,Default,,0,0,0,,Сонымен
Dialogue: 0,0:16:25.04,0:16:27.06,Default,,0,0,0,,Масатоның бүлікшіл кезеңі аяқталды.
Dialogue: 0,0:16:28.06,0:16:30.09,Default,,0,0,0,,Мен сенен үндемеуіңді өтіндім.
Dialogue: 0,0:16:31.00,0:16:32.05,Default,,0,0,0,,Жақсы болды ма, жоқ па?
Dialogue: 0,0:16:34.01,0:16:35.00,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:16:35.02,0:16:39.05,Default,,0,0,0,,Біраз уақыт өзім бағып-қаққан балаларды бағып-қағумен айналысатын сияқтымын.
Dialogue: 0,0:16:40.03,0:16:45.02,Default,,0,0,0,,Егер мен барлығына патронаттық ата-ана таба алсам, Масатомен бірге сусын ішуге барамын деп ойлаймын.
Dialogue: 0,0:16:46.04,0:16:48.01,Default,,0,0,0,,Мені қарауды жалғастыра беріңіз.
Dialogue: 0,0:16:49.07,0:16:51.07,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:16:52.07,0:16:53.05,Default,,0,0,0,,Иә
Dialogue: 0,0:16:54.04,0:16:57.05,Default,,0,0,0,,Не, қазірден бастап? Ақымақ болма!
Dialogue: 0,0:16:57.08,0:17:00.03,Default,,0,0,0,,Бүгінгі күнді мереке ретінде қабылдап, Сеулде ішіңіз!
Dialogue: 0,0:17:00.04,0:17:01.02,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:17:01.03,0:17:02.06,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:17:02.07,0:17:04.02,Default,,0,0,0,,Йобосеё Йобосеё!
Dialogue: 0,0:17:04.06,0:17:07.01,Default,,0,0,0,,Цк, сен анау бейбақты кесіп тастадың.
Dialogue: 0,0:17:07.05,0:17:09.06,Default,,0,0,0,,<5 табақ кармегуисал қосылды! 〉
Dialogue: 0,0:17:11.06,0:17:14.09,Default,,0,0,0,,Керісінше, мені тыңдаңыз.
Dialogue: 0,0:17:15.00,0:17:18.08,Default,,0,0,0,,Әй, ажырасқан әйелімен жабысқан қыз.
Dialogue: 0,0:17:19.02,0:17:21.00,Default,,0,0,0,,Дұрыс~
Dialogue: 0,0:17:21.02,0:17:24.04,Default,,0,0,0,,Ол кішкентай кезінде сүйкімді болған.
Dialogue: 0,0:17:24.07,0:17:27.00,Default,,0,0,0,,Мен сізбен қазір де байланыса алмаймын.
Dialogue: 0,0:17:27.05,0:17:29.03,Default,,0,0,0,,Мен сізге кеңес беремін.
Dialogue: 0,0:17:29.05,0:17:30.03,Default,,0,0,0,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,0:17:30.05,0:17:31.03,Default,,0,0,0,,Ал сосын!
Dialogue: 0,0:17:31.04,0:17:32.03,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:17:34.08,0:17:35.08,Default,,0,0,0,,Бас тарту
Dialogue: 0,0:17:37.02,0:17:40.03,Default,,0,0,0,,-да? Сіз әлі мансап жолын таңдадыңыз ба?
Dialogue: 0,0:17:40.07,0:17:41.09,Default,,0,0,0,,Қайдасың?
Dialogue: 0,0:17:42.02,0:17:45.07,Default,,0,0,0,,Егер сіз университетке түскіңіз келсе, дұрыс оқу бағдарламасынан өтуіңіз керек.
Dialogue: 0,0:17:46.09,0:17:48.01,Default,,0,0,0,,Хаа…
Dialogue: 0,0:17:48.02,0:17:50.06,Default,,0,0,0,,Шынымды айтсам, бұл мені алаңдатпайды.
Dialogue: 0,0:17:51.04,0:17:54.00,Default,,0,0,0,,Сен шешесің, Кавин.
Dialogue: 0,0:18:02.05,0:18:03.05,Default,,0,0,0,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:18:07.01,0:18:08.03,Default,,0,0,0,,Бұл менің інім.
Dialogue: 0,0:18:08.05,0:18:10.00,Default,,0,0,0,,Бұл біраз дәріптелді.
Dialogue: 0,0:18:17.05,0:18:18.08,Default,,0,0,0,,Маған мынаны беріңізші
Dialogue: 0,0:18:19.00,0:18:20.00,Default,,0,0,0,,Майдо бар
Dialogue: 0,0:18:28.06,0:18:29.05,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:30.06,0:18:32.03,Default,,0,0,0,,Ах... ха...
Dialogue: 0,0:18:38.02,0:18:39.00,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:18:41.00,0:18:42.07,Default,,0,0,0,,<Бұл Эдамура-кун ма? 〉
Dialogue: 0,0:18:42.09,0:18:44.03,Default,,0,0,0,,〈Осыдан кейін не істейміз? 〉
Dialogue: 0,0:18:44.04,0:18:47.02,Default,,0,0,0,,Мен осы жердегі кофелерді салыстырып көргім келеді.
Dialogue: 0,0:18:47.05,0:18:50.02,Default,,0,0,0,,〈Аа, бәрі дәмді〉
Dialogue: 0,0:18:50.03,0:18:53.08,Default,,0,0,0,,〈Оппа, Америка тізімнің басында.〉
Dialogue: 0,0:18:54.00,0:18:55.03,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:18:57.08,0:18:58.06,Default,,0,0,0,,Иә
Dialogue: 0,0:18:59.03,0:19:01.06,Default,,0,0,0,,Ақыр соңында, қысқа ұзындықтар сізге жақсырақ жарасады.
Dialogue: 0,0:19:02.05,0:19:05.01,Default,,0,0,0,,Біздің ең жақсы күш-жігеріміз және
Dialogue: 0,0:19:05.02,0:19:07.01,Default,,0,0,0,,Өз қабілетіне сенетін жүрек...
Dialogue: 0,0:19:07.05,0:19:10.01,Default,,0,0,0,,Міне, сіз биікке көтерілдіңіз.
Dialogue: 0,0:19:10.08,0:19:13.07,Default,,0,0,0,,Ол қазіргі Хидейоши ме?
Dialogue: 0,0:19:14.01,0:19:16.00,Default,,0,0,0,,Тағы да керемет болады
Dialogue: 0,0:19:16.03,0:19:18.09,Default,,0,0,0,,Баршаңызға Алла разы болсын.
Dialogue: 0,0:19:19.00,0:19:19.50,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:20.08,0:19:27.03,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:19:28.00,0:19:31.02,Default,,0,0,0,,Ей, жалығып кете жаздадың ғой?
Dialogue: 0,0:19:32.00,0:19:38.00,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:21:27.08,0:21:31.08,Default,,0,0,0,,~♪
Dialogue: 0,0:21:39.04,0:21:41.05,Default,,0,0,0,,<Иә? Бұл не?
Dialogue: 0,0:21:41.08,0:21:42.09,Default,,0,0,0,,〈Не болды? 〉
Dialogue: 0,0:21:43.04,0:21:45.04,Default,,0,0,0,,〈балықтың қарнынан шықты〉
Dialogue: 0,0:21:45.09,0:21:47.05,Default,,0,0,0,,〈Мұндай нәрсені қайдан алдың?〉
Dialogue: 0,0:21:48.00,0:21:49.01,Default,,0,0,0,,〈Жоқ.〉
Dialogue: 0,0:21:49.05,0:21:51.07,Default,,0,0,0,,<Әй, шай ішейік! 〉
Dialogue: 0,0:21:58.07,0:22:01.04,Default,,0,0,0,,<Бұл қайтадан Эфиопия ма? 〉
Dialogue: 0,0:22:01.09,0:22:04.01,Default,,0,0,0,,<Мен мұны бұрын айттым ба? 〉
Dialogue: 0,0:22:08.05,0:22:10.04,Default,,0,0,0,,<Аха, сен солай айттың ба? 〉
Dialogue: 0,0:22:10.07,0:22:12.05,Default,,0,0,0,,〈Бұл әлі де көп уақыт алатын сияқты〉
Dialogue: 0,0:22:12.06,0:22:14.05,Default,,0,0,0,,〈Ей, қария! 〉
Dialogue: 0,0:22:14.08,0:22:15.07,Default,,0,0,0,,〈Иә〉
Dialogue: 0,0:22:15.09,0:22:17.02,Default,,0,0,0,,〈Шаншан бұл〉
Dialogue: 0,0:22:18.05,0:22:19.03,Default,,0,0,0,,<Сақина? 〉
Dialogue: 0,0:22:19.08,0:22:22.06,Default,,0,0,0,,〈Ол балықтың қарнынан шықты〉
Dialogue: 0,0:22:22.07,0:22:24.08,Default,,0,0,0,,〈Хмм, рахмет〉
Dialogue: 0,0:22:25.02,0:22:27.02,Default,,0,0,0,,〈Ой, жаңбыр тоқтады〉
Dialogue: 0,0:22:27.03,0:22:28.04,Default,,0,0,0,,Уау~
Dialogue: 0,0:22:33.06,0:22:34.09,Default,,0,0,0,,〈Иә〉
Dialogue: 0,0:22:38.00,0:22:40.09,Default,,0,0,0,,Ай!
Dialogue: 0,0:22:45.08,0:22:47.04,Default,,0,0,0,,Уау~
Dialogue: 0,0:22:48.07,0:22:50.02,Default,,0,0,0,,жеткілікті.
Dialogue: 0,0:22:51.52,0:22:56.52,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
