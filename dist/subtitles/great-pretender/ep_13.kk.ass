Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Томас Майер?
Dialogue: 0,0:00:06.09,0:00:09.04,Default,,0,0,0,,Сіздің осы дүкенге жиі келетініңізді естідім...
Dialogue: 0,0:00:09.05,0:00:10.04,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:00:10.05,0:00:12.08,Default,,0,0,0,,Бұл хехехе болды
Dialogue: 0,0:00:13.01,0:00:15.08,Default,,0,0,0,,Сіз бе? Ол Томасты іздейді.
Dialogue: 0,0:00:15.09,0:00:16.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:17.01,0:00:18.06,Default,,0,0,0,,Бұл оның ниггасы ма?
Dialogue: 0,0:00:18.07,0:00:21.08,Default,,0,0,0,,Жоқ, біз жай ғана таныспыз...
Dialogue: 0,0:00:21.09,0:00:23.09,Default,,0,0,0,,«Қиқанша» болса керек.
Dialogue: 0,0:00:24.04,0:00:26.04,Default,,0,0,0,,Әй, полицей!
Dialogue: 0,0:00:28.06,0:00:29.05,Default,,0,0,0,,Тұр, е!
Dialogue: 0,0:00:29.06,0:00:31.06,Default,,0,0,0,,Эй... Жоқ! кешіріңіз!
Dialogue: 0,0:00:31.07,0:00:33.08,Default,,0,0,0,,Эй, сыртта істе.
Dialogue: 0,0:00:34.03,0:00:40.03,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:01:32.05,0:01:38.05,Default,,0,0,0,,~♪
Dialogue: 0,0:01:39.08,0:01:42.09,Default,,0,0,0,,Хаха~ Мен бір ғана әмиянмен құтқарылдым.
Dialogue: 0,0:01:43.01,0:01:45.00,Default,,0,0,0,,Оң
Dialogue: 0,0:01:45.04,0:01:48.01,Default,,0,0,0,,Томас шынымен суретші ме?
Dialogue: 0,0:01:48.03,0:01:49.02,Default,,0,0,0,,Өткенде
Dialogue: 0,0:01:49.06,0:01:51.01,Default,,0,0,0,,Сонда жай ғана суретші ме?
Dialogue: 0,0:01:51.02,0:01:53.08,Default,,0,0,0,,Жоқ, сіз екі миллион фунт қарызсыз ба?
Dialogue: 0,0:01:53.09,0:01:54.09,Default,,0,0,0,,2 миллион?
Dialogue: 0,0:01:55.04,0:01:57.06,Default,,0,0,0,,Мен қандай кепілдік болғанын білмеймін.
Dialogue: 0,0:01:57.07,0:02:00.01,Default,,0,0,0,,Ол көп ақшаны қарызға алып жүгіріп жүр.
Dialogue: 0,0:02:00.07,0:02:02.00,Default,,0,0,0,,Әйтеуір, біз түсеміз.
Dialogue: 0,0:02:02.02,0:02:03.08,Default,,0,0,0,,Өзіңіз іздеңіз.
Dialogue: 0,0:02:04.03,0:02:07.04,Default,,0,0,0,,Е~ Олай деме, менімен аралас.
Dialogue: 0,0:02:08.01,0:02:10.09,Default,,0,0,0,,Бұл ең алдымен едамаменің кесірінен болса керек.
Dialogue: 0,0:02:12.00,0:02:14.08,Default,,0,0,0,,Әмиянымды алып кеткеннен бері ештеңе жеген жоқпын.
Dialogue: 0,0:02:15.05,0:02:17.06,Default,,0,0,0,,Бізге пицца жеткізуге бола ма?
Dialogue: 0,0:02:18.02,0:02:20.03,Default,,0,0,0,,Ал, әзірше мынаны байланыстырайық.
Dialogue: 0,0:02:20.05,0:02:21.03,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:21.06,0:02:23.00,Default,,0,0,0,,Бұл ешқайсысы емес
Dialogue: 0,0:02:23.01,0:02:24.08,Default,,0,0,0,,Жарамдылық мерзімі аяқталды.
Dialogue: 0,0:02:25.04,0:02:26.06,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:02:26.08,0:02:28.03,Default,,0,0,0,,Пицца, өтінемін
Dialogue: 0,0:02:32.09,0:02:35.05,Default,,0,0,0,,Егер сіз бір күні бұзылып қалсаңыз, не істейсіз?
Dialogue: 0,0:02:36.00,0:02:38.06,Default,,0,0,0,,Үлкенірек жерге көшуім керек пе?
Dialogue: 0,0:02:38.09,0:02:41.09,Default,,0,0,0,,Бірақ алдымен бұл картина сатыла ма деген сұрақ туындайды.
Dialogue: 0,0:02:42.00,0:02:44.01,Default,,0,0,0,,Хехе, сататынына сенімдімін.
Dialogue: 0,0:02:45.03,0:02:47.08,Default,,0,0,0,,Мен де тыңдалымда бар күшімді салуым керек.
Dialogue: 0,0:02:48.00,0:02:51.00,Default,,0,0,0,,Даяшы рөлінен өтетініңізге сенімдімін.
Dialogue: 0,0:02:51.02,0:02:53.09,Default,,0,0,0,,Ах~ Бұл дисс па?
Dialogue: 0,0:02:54.00,0:02:55.04,Default,,0,0,0,,Ал 3D маневрлік жабдық ше?
Dialogue: 0,0:02:55.09,0:02:59.09,Default,,0,0,0,,Бірақ екеуміз өте жақсы жерге жеттік.
Dialogue: 0,0:03:00.03,0:03:03.07,Default,,0,0,0,,Егер бұл орын алса...
Dialogue: 0,0:03:10.06,0:03:12.06,Default,,0,0,0,,Huhahahaha Керемет!
Dialogue: 0,0:03:12.07,0:03:14.03,Default,,0,0,0,,Бұл аспанның сыйы.
Dialogue: 0,0:03:14.05,0:03:16.01,Default,,0,0,0,,Ескі бояуды қолдансаңыз
Dialogue: 0,0:03:16.02,0:03:18.02,Default,,0,0,0,,Нақты нәрседен айырмашылығы жоқ шығар
Dialogue: 0,0:03:18.07,0:03:20.04,Default,,0,0,0,,Тіпті мен
Dialogue: 0,0:03:20.09,0:03:23.04,Default,,0,0,0,,Сізде табиғи талант бар.
Dialogue: 0,0:03:24.03,0:03:25.07,Default,,0,0,0,,Бұл жалған.
Dialogue: 0,0:03:27.02,0:03:28.03,Default,,0,0,0,,Дүниеде
Dialogue: 0,0:03:28.04,0:03:32.01,Default,,0,0,0,,Қайталап сатып алу және сату кезінде жоғалған заттар
Dialogue: 0,0:03:32.02,0:03:36.03,Default,,0,0,0,,Аты тізімде көрсетілген, бірақ бар екені белгісіз заттар және т.б.
Dialogue: 0,0:03:36.04,0:03:38.01,Default,,0,0,0,,Бұл тау сияқты
Dialogue: 0,0:03:39.01,0:03:42.02,Default,,0,0,0,,Сіз оларды қазіргі заманға қайтарасыз.
Dialogue: 0,0:03:42.08,0:03:45.07,Default,,0,0,0,,Сіз оның жалған сурет салғанын қалайсыз ба?
Dialogue: 0,0:03:45.08,0:03:47.00,Default,,0,0,0,,Жалғандық емес
Dialogue: 0,0:03:47.01,0:03:48.04,Default,,0,0,0,,Нақты заттың суретін сал
Dialogue: 0,0:03:48.09,0:03:53.03,Default,,0,0,0,,Егер мен оны соттайтын болсам, жалғандықтың өзі шынайы.
Dialogue: 0,0:03:54.03,0:03:55.01,Default,,0,0,0,,Мен анықтаймын
Dialogue: 0,0:03:55.02,0:03:56.01,Default,,0,0,0,,Анықталған жоқ
Dialogue: 0,0:03:56.04,0:04:00.03,Default,,0,0,0,,Өйткені оның жалған екенін ешкім анықтай алмайды.
Dialogue: 0,0:04:00.04,0:04:03.02,Default,,0,0,0,,Басқаша айтқанда, бұл шайтанның дәлелі.
Dialogue: 0,0:04:03.03,0:04:05.06,Default,,0,0,0,,Егер фантомдық шедевр табылса
Dialogue: 0,0:04:05.07,0:04:10.05,Default,,0,0,0,,Өнер әлемі өркендеп келеді, тұтынушылар риза, мен де ақша тауып жатырмын.
Dialogue: 0,0:04:11.00,0:04:13.07,Default,,0,0,0,,Шынайы зат бір жерден табылса ше?
Dialogue: 0,0:04:14.00,0:04:14.50,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:04:16.02,0:04:17.03,Default,,0,0,0,,Жарайды, мұны істейік.
Dialogue: 0,0:04:17.09,0:04:20.04,Default,,0,0,0,,Маған қалаған 10 суретті сал.
Dialogue: 0,0:04:21.09,0:04:23.09,Default,,0,0,0,,Бар болғаны 10 дана
Dialogue: 0,0:04:24.01,0:04:25.05,Default,,0,0,0,,Суретті аяқтағаныңыз үшін алғыс ретінде
Dialogue: 0,0:04:25.06,0:04:30.01,Default,,0,0,0,,Мен сізді келешек данышпан суретші ретінде көтеруге уәде беремін.
Dialogue: 0,0:04:31.02,0:04:32.05,Default,,0,0,0,,Ойлан.
Dialogue: 0,0:04:37.08,0:04:40.00,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:05:47.03,0:05:50.06,Default,,0,0,0,,Джеймс Коулман, өнерді бағалаушы ретінде белгілі
Dialogue: 0,0:05:50.07,0:05:52.04,Default,,0,0,0,,Бұл оның эксклюзивті сұхбаты.
Dialogue: 0,0:05:52.08,0:05:55.09,Default,,0,0,0,,Алдымен шедевр ашқаныңызбен құттықтаймыз.
Dialogue: 0,0:05:56.01,0:05:56.51,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:57.04,0:05:58.09,Default,,0,0,0,,Соңғы әрекеттерді қараңыз
Dialogue: 0,0:05:59.00,0:06:02.00,Default,,0,0,0,,Кейбіреулер оны өнер әлемінің 007-сі дейді.
Dialogue: 0,0:06:02.01,0:06:03.00,Default,,0,0,0,,Иә
Dialogue: 0,0:06:03.01,0:06:06.03,Default,,0,0,0,,Бәлкім, бұл аттас шығар, бірақ бұл құрмет.
Dialogue: 0,0:06:06.06,0:06:07.07,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:07.08,0:06:11.01,Default,,0,0,0,,-да мен Кларенс Кокудың ''Фортепиано мұғалімі'' кітабын таптым.
Dialogue: 0,0:06:11.02,0:06:14.09,Default,,0,0,0,,Мұндай көру өткірлігін қалай дамытуға болады?
Dialogue: 0,0:06:15.09,0:06:17.05,Default,,0,0,0,,Тек оқу
Dialogue: 0,0:06:17.07,0:06:20.05,Default,,0,0,0,,Және сәл сәттілік.
Dialogue: 0,0:06:22.02,0:06:25.00,Default,,0,0,0,,Уау~ Керемет!
Dialogue: 0,0:06:25.01,0:06:27.01,Default,,0,0,0,,Мұнда толық жинақ бар.
Dialogue: 0,0:06:27.07,0:06:28.08,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:06:28.09,0:06:30.01,Default,,0,0,0,,Әрине, білемін.
Dialogue: 0,0:06:30.03,0:06:32.03,Default,,0,0,0,,Мен мұнда көбірек сурет сала алатындай сезінемін!
Dialogue: 0,0:06:34.01,0:06:38.04,Default,,0,0,0,,Мен салған келесі картина Хосе Мартинестің «Сиеста» суреті.
Dialogue: 0,0:06:38.08,0:06:40.08,Default,,0,0,0,,Оның сипаттамасы қызыл
Dialogue: 0,0:06:41.01,0:06:42.03,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:06:42.04,0:06:45.05,Default,,0,0,0,,Менің ойымша, қызыл түске көгілдір түс араласқан.
Dialogue: 0,0:06:45.06,0:06:46.06,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:46.08,0:06:50.08,Default,,0,0,0,,Одан басқа, олар да бірдеңені негіз ретінде пайдаланған сияқты.
Dialogue: 0,0:06:57.00,0:06:59.09,Default,,0,0,0,,Оны енді бұл жерге әкелмеген дұрыс.
Dialogue: 0,0:07:00.01,0:07:01.01,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:07:01.02,0:07:03.04,Default,,0,0,0,,Әйелдің бөксесіне қараған кезде ме?
Dialogue: 0,0:07:04.00,0:07:05.07,Default,,0,0,0,,Сізге не істеу керек
Dialogue: 0,0:07:05.08,0:07:09.00,Default,,0,0,0,,Бұл кенепте өнер жасау туралы.
Dialogue: 0,0:07:09.01,0:07:10.05,Default,,0,0,0,,Фокус
Dialogue: 0,0:07:11.00,0:07:12.04,Default,,0,0,0,,Фокус…
Dialogue: 0,0:07:15.03,0:07:18.03,Default,,0,0,0,,Джеймс де маған осы дүкен туралы айтып берді.
Dialogue: 0,0:07:18.04,0:07:21.04,Default,,0,0,0,,Клиенттердің көңілін көтеру үшін қолданылады.
Dialogue: 0,0:07:21.07,0:07:25.05,Default,,0,0,0,,Оған менің кеше салған төртінші суретім ұнамады.
Dialogue: 0,0:07:25.06,0:07:26.09,Default,,0,0,0,,Бұл қайталау.
Dialogue: 0,0:07:27.04,0:07:30.01,Default,,0,0,0,,Жарайды, бәрібір ақша береді.
Dialogue: 0,0:07:30.03,0:07:31.08,Default,,0,0,0,,Сізге шынымен рахмет.
Dialogue: 0,0:07:33.03,0:07:35.02,Default,,0,0,0,,Тамақтанудан қорықпа
Dialogue: 0,0:07:35.03,0:07:36.08,Default,,0,0,0,,Танысқанымызға біраз болды.
Dialogue: 0,0:07:36.09,0:07:39.04,Default,,0,0,0,,Консервіленген үрме бұршақтарды қайта алғыңыз келмейді, солай ма?
Dialogue: 0,0:07:41.07,0:07:45.02,Default,,0,0,0,,Бұл жақсы емес. Ең қымбатына тапсырыс беруім керек пе?
Dialogue: 0,0:07:45.07,0:07:47.05,Default,,0,0,0,,Қанағаттанасыз ба?
Dialogue: 0,0:07:47.06,0:07:48.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:49.05,0:07:51.06,Default,,0,0,0,,Коулменмен қанша уақытты жалғастырасыз?
Dialogue: 0,0:07:52.03,0:07:53.08,Default,,0,0,0,,Э-э… «Эксперименттік нәтижелер»
Dialogue: 0,0:07:53.09,0:07:56.03,Default,,0,0,0,,Келісімшартта тағы 6 бөлік қалды.
Dialogue: 0,0:07:56.06,0:07:59.06,Default,,0,0,0,,Біз тіпті келісімшартқа да қол қойған жоқпыз. Бұл ауызша келісім, солай ма?
Dialogue: 0,0:07:59.07,0:08:01.08,Default,,0,0,0,,Ол сізді ыңғайлы түрде тастап кетуі мүмкін...
Dialogue: 0,0:08:01.09,0:08:04.06,Default,,0,0,0,,Көшіру қазір қызық.
Dialogue: 0,0:08:04.07,0:08:06.04,Default,,0,0,0,,Сіз көп нәрсені сіңіре аласыз.
Dialogue: 0,0:08:07.01,0:08:09.02,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:08:09.06,0:08:12.01,Default,,0,0,0,,Адамдар жарасымды, жарамсыз дейді.
Dialogue: 0,0:08:12.02,0:08:15.09,Default,,0,0,0,,Джеймс айтқандай, мен көшіруді жақсы білемін.
Dialogue: 0,0:08:16.00,0:08:16.50,Default,,0,0,0,,Ондай нәрсе жоқ
Dialogue: 0,0:08:17.00,0:08:18.02,Default,,0,0,0,,Жарайды, міне, гострайтингі тапсырысы формасы.
Dialogue: 0,0:08:18.03,0:08:20.06,Default,,0,0,0,,Джеймс мені таныды.
Dialogue: 0,0:08:20.07,0:08:23.03,Default,,0,0,0,,Екеуміз бір-бірімізді өз пайдамызға пайдаланып жатырмыз.
Dialogue: 0,0:08:23.05,0:08:26.07,Default,,0,0,0,,Оның істеп жүргені тек ақша табу емес пе?
Dialogue: 0,0:08:26.09,0:08:30.00,Default,,0,0,0,,Мен білемін! Мен де ақымақ емеспін
Dialogue: 0,0:08:30.01,0:08:33.04,Default,,0,0,0,,Консервіленген бұршақты жеу үшін қанша жыл күтуім керек?
Dialogue: 0,0:08:33.05,0:08:35.00,Default,,0,0,0,,Сіз бұған шыдай аласыз ба?
Dialogue: 0,0:08:36.00,0:08:38.09,Default,,0,0,0,,Осы жетістікке неге қуанбайсың?
Dialogue: 0,0:08:39.01,0:08:40.07,Default,,0,0,0,,Мен ешқандай табысқа жете алмадым.
Dialogue: 0,0:08:40.08,0:08:42.09,Default,,0,0,0,,Қолданылғаннан кейін ол жай ғана лақтырылады.
Dialogue: 0,0:08:43.02,0:08:44.08,Default,,0,0,0,,Сонымен не болды?
Dialogue: 0,0:08:45.07,0:08:48.04,Default,,0,0,0,,Сонымен не болды...?
Dialogue: 0,0:08:49.03,0:08:52.07,Default,,0,0,0,,Қандай сурет салсаң да, ол сатылмаса мағынасыз.
Dialogue: 0,0:08:53.07,0:08:55.05,Default,,0,0,0,,Маған кедергі жасама
Dialogue: 0,0:08:57.05,0:08:58.06,Default,,0,0,0,,Мазасыздық?
Dialogue: 0,0:09:21.05,0:09:24.01,Default,,0,0,0,,Әй, қария! Асықшы!
Dialogue: 0,0:09:24.02,0:09:26.01,Default,,0,0,0,,Иә, кешіріңіз
Dialogue: 0,0:09:32.01,0:09:33.00,Default,,0,0,0,,Ах
Dialogue: 0,0:09:33.03,0:09:34.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:34.03,0:09:35.07,Default,,0,0,0,,Бір минут күтіңіз! (Еркектер) Әй?
Dialogue: 0,0:09:36.04,0:09:38.09,Default,,0,0,0,,Мен іздедім! Томас Майер
Dialogue: 0,0:09:39.05,0:09:40.04,Default,,0,0,0,,Эй
Dialogue: 0,0:09:41.01,0:09:43.09,Default,,0,0,0,,Сіз Томасты іздедіңіз, солай ма? Мұнда кел
Dialogue: 0,0:09:44.09,0:09:47.00,Default,,0,0,0,,Бұл жігітке не болу керек?
Dialogue: 0,0:09:48.07,0:09:49.09,Default,,0,0,0,,Жұмыс?
Dialogue: 0,0:09:50.02,0:09:51.00,Default,,0,0,0,,...
Dialogue: 0,0:09:51.01,0:09:53.09,Default,,0,0,0,,Бұл жерде барлығына жақсы әңгіме.
Dialogue: 0,0:09:55.00,0:09:59.01,Default,,0,0,0,,Басқаша айтқанда, мен сізге барлық қарыздарымды бірден өтеп жатырмын.
Dialogue: 0,0:09:59.02,0:10:02.01,Default,,0,0,0,,Не? Бұл өз ағзаңызды сатумен бірдей...
Dialogue: 0,0:10:02.03,0:10:03.06,Default,,0,0,0,,Бұлай емес!
Dialogue: 0,0:10:04.01,0:10:06.05,Default,,0,0,0,,Осындай кездерде үніңді жап, бас изеп қой!
Dialogue: 0,0:10:07.01,0:10:09.01,Default,,0,0,0,,Ал, ұсақ-түйектерді кейінге қалдырайық.
Dialogue: 0,0:10:09.02,0:10:11.08,Default,,0,0,0,,Біріншіден, сіз мас әйелді кездестіре аласыз ба?
Dialogue: 0,0:10:11.09,0:10:13.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:14.07,0:10:15.09,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:10:16.02,0:10:17.02,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:10:21.08,0:10:23.02,Default,,0,0,0,,Гааааа…
Dialogue: 0,0:10:26.02,0:10:27.08,Default,,0,0,0,,Сәлеметсіз бе, қайырлы кеш.
Dialogue: 0,0:10:27.09,0:10:28.09,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:29.00,0:10:32.00,Default,,0,0,0,,Әй, менің бетімді ұмыттың ба?
Dialogue: 0,0:10:34.01,0:10:35.08,Default,,0,0,0,,Глоп, глоп, глоп
Dialogue: 0,0:10:36.01,0:10:39.00,Default,,0,0,0,,Мен шарапты ең қымбаты болғандықтан сақтап қойдым.
Dialogue: 0,0:10:44.00,0:10:46.05,Default,,0,0,0,,Хмм, сіз өнер дилерісіз бе?
Dialogue: 0,0:10:46.06,0:10:48.08,Default,,0,0,0,,Иә, бірақ тек қараңғыда
Dialogue: 0,0:10:49.03,0:10:50.03,Default,,0,0,0,,Қараңғылық?
Dialogue: 0,0:10:50.05,0:10:54.02,Default,,0,0,0,,Өнерді сатып алып мафияға сататын жігіт.
Dialogue: 0,0:10:54.08,0:10:57.04,Default,,0,0,0,,Актив құнына ғана қызығушылық танытатын қоқыстар
Dialogue: 0,0:10:57.08,0:10:58.09,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:10:59.05,0:11:01.02,Default,,0,0,0,,Жетіспейтін өнер туындылары үшін
Dialogue: 0,0:11:01.04,0:11:05.01,Default,,0,0,0,,Бұл кісілердің меншігіндегі және қоймада сақталған заттары көп.
Dialogue: 0,0:11:05.03,0:11:09.01,Default,,0,0,0,,Мына жігіттер менің жұмысыммен ойнап жүр деп ойласам...
Dialogue: 0,0:11:09.02,0:11:12.06,Default,,0,0,0,,Мұндай зұлымдықты жаншып алсаң да, кейін қайтады.
Dialogue: 0,0:11:12.07,0:11:13.08,Default,,0,0,0,,Ешқандай шектеу жоқ
Dialogue: 0,0:11:14.04,0:11:17.06,Default,,0,0,0,,Мен сонда барсам, мұғалім керемет болды.
Dialogue: 0,0:11:18.04,0:11:21.09,Default,,0,0,0,,Жұмыстарды ашып, бізді нұрландыр.
Dialogue: 0,0:11:22.04,0:11:23.03,Default,,0,0,0,,Сен тәжірибелер жүргізіп, пулемётпен оқ жаудырып жүрсің — нағыз ақымақсың.
Dialogue: 0,0:11:31.08,0:11:34.01,Default,,0,0,0,,Хехе, сен өттің, Абигейл.
Dialogue: 0,0:11:34.08,0:11:37.04,Default,,0,0,0,,Мен сізге көбірек көмектескім келеді.
Dialogue: 0,0:11:37.06,0:11:41.07,Default,,0,0,0,,Кейде ынталы жастармен араласу жаман емес.
Dialogue: 0,0:11:42.03,0:11:45.07,Default,,0,0,0,,«Лондонның қарын» міндетті түрде қайтарайық, сэр.
Dialogue: 0,0:11:47.06,0:11:48.05,Default,,0,0,0,,Хаа…
Dialogue: 0,0:11:49.03,0:11:51.05,Default,,0,0,0,,Ал, сіз бұл жалғандықты суреттедіңіз делік.
Dialogue: 0,0:11:52.01,0:11:54.02,Default,,0,0,0,,Сіз оны қайда және кімге сатқыңыз келеді?
Dialogue: 0,0:11:54.04,0:11:55.03,Default,,0,0,0,,Коулман
Dialogue: 0,0:11:55.05,0:11:56.05,Default,,0,0,0,,Өзің жақсысың ба? Иносукэ
Dialogue: 0,0:11:56.06,0:11:58.00,Default,,0,0,0,,Мен айттым ғой.
Dialogue: 0,0:11:58.01,0:12:00.09,Default,,0,0,0,,«Қандай сурет болса да, ол сатылмаса, мағынасы жоқ».
Dialogue: 0,0:12:02.00,0:12:03.03,Default,,0,0,0,,Не өзгерді?
Dialogue: 0,0:12:03.05,0:12:04.09,Default,,0,0,0,,Сіз бұрынырақ...
Dialogue: 0,0:12:05.00,0:12:07.03,Default,,0,0,0,,Сіз бірінші болып өзгердіңіз.
Dialogue: 0,0:12:09.02,0:12:13.03,Default,,0,0,0,,Сол кезде мен Коулманмен мәңгілікке бірге боламын деп ойладым.
Dialogue: 0,0:12:13.05,0:12:17.09,Default,,0,0,0,,Қарыз жинап, ынталы, ынталы еңбек ету.
Dialogue: 0,0:12:19.05,0:12:23.04,Default,,0,0,0,,Кешіріңіз, бірақ мен қылқаламды көптен бері алмаған едім.
Dialogue: 0,0:12:23.07,0:12:25.07,Default,,0,0,0,,Мен бұрынғыдай сурет сала алмаймын.
Dialogue: 0,0:12:25.08,0:12:27.08,Default,,0,0,0,,Оның үстіне екінші тарап тым нашар.
Dialogue: 0,0:12:27.09,0:12:30.02,Default,,0,0,0,,О, бұл реабилитацияға байланысты ғой, солай ма?
Dialogue: 0,0:12:30.09,0:12:33.01,Default,,0,0,0,,Сіз мұны істей аламын деп ойлайсыз ба?
Dialogue: 0,0:12:33.03,0:12:35.05,Default,,0,0,0,,Бұл оңай емес
Dialogue: 0,0:12:35.06,0:12:37.08,Default,,0,0,0,,Бірақ бұл өте жақсы болды, солай емес пе?
Dialogue: 0,0:12:38.09,0:12:40.07,Default,,0,0,0,,Бұл баяғыда болды.
Dialogue: 0,0:12:41.03,0:12:45.02,Default,,0,0,0,,Ол кезде мен сахна актрисасы боламын деп ойлайтынмын.
Dialogue: 0,0:12:46.04,0:12:48.01,Default,,0,0,0,,Ол алаяқ...
Dialogue: 0,0:12:48.03,0:12:49.03,Default,,0,0,0,,(тұру дыбысы)
Dialogue: 0,0:12:50.08,0:12:51.09,Default,,0,0,0,,Бұл жаман әзіл
Dialogue: 0,0:12:57.06,0:12:59.02,Default,,0,0,0,,Моттайнай
Dialogue: 0,0:13:08.05,0:13:09.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:09.09,0:13:12.05,Default,,0,0,0,,Сәлеметсіз бе, мен сізді баратын жеріңізге апарайын ба?
Dialogue: 0,0:13:12.08,0:13:14.03,Default,,0,0,0,,Мынау
Dialogue: 0,0:13:14.05,0:13:16.05,Default,,0,0,0,,Бірақ бұл өте серуендеу.
Dialogue: 0,0:13:16.09,0:13:18.01,Default,,0,0,0,,Мен кешірім сұрағым келеді
Dialogue: 0,0:13:18.02,0:13:22.01,Default,,0,0,0,,Мен оны осында жібердім, себебі мен сіздің жеке басыңызды білгім келді.
Dialogue: 0,0:13:23.03,0:13:25.03,Default,,0,0,0,,Ей, сенде жақсы бағыныңқы бар.
Dialogue: 0,0:13:25.05,0:13:29.06,Default,,0,0,0,,Мен олардың сол «Лондондағы қарға» ұқыптылықпен қарайтынына сенімдімін.
Dialogue: 0,0:13:30.00,0:13:33.05,Default,,0,0,0,,Мен оны бағалауға жібердім, менде жоқ.
Dialogue: 0,0:13:33.06,0:13:34.05,Default,,0,0,0,,Бағалау?
Dialogue: 0,0:13:35.00,0:13:39.00,Default,,0,0,0,,Оған сенімді болу үшін мен оны сенімді бағалаушыға қарадым.
Dialogue: 0,0:13:39.02,0:13:40.08,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:13:40.09,0:13:42.06,Default,,0,0,0,,Міне, осыны білдіреді.
Dialogue: 0,0:13:43.07,0:13:46.02,Default,,0,0,0,,Өткенде сіз тапқан кейбір картиналар.
Dialogue: 0,0:13:46.04,0:13:48.03,Default,,0,0,0,,Мен бұған күмәнданамын.
Dialogue: 0,0:13:48.06,0:13:52.02,Default,,0,0,0,,Мен өнерпаздардың жауапсыз сөздер айтқанын ұнатпаймын.
Dialogue: 0,0:13:52.06,0:13:53.09,Default,,0,0,0,,L өліпті
Dialogue: 0,0:13:54.01,0:13:57.01,Default,,0,0,0,,«Лондондағы қар» шынайы сияқты.
Dialogue: 0,0:13:57.08,0:13:59.03,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:13:59.05,0:14:02.01,Default,,0,0,0,,Олар мұны мафияға сатпайды деп ойлаймын.
Dialogue: 0,0:14:03.00,0:14:05.05,Default,,0,0,0,,Егер сізге ұнамаса, оны аукционға қоюға болады.
Dialogue: 0,0:14:05.06,0:14:07.02,Default,,0,0,0,,Аукционға қойылады ма?
Dialogue: 0,0:14:08.00,0:14:11.01,Default,,0,0,0,,Бұл тек таңдалғандарға арналған құпия аукцион.
Dialogue: 0,0:14:12.00,0:14:14.09,Default,,0,0,0,,Уақыты мен орны анықталғаннан кейін біз сізге шақыру жібереміз.
Dialogue: 0,0:14:15.07,0:14:19.06,Default,,0,0,0,,Сіз де сол шұңқырдасыз. Сіз қатысуға толық құқылысыз.
Dialogue: 0,0:14:19.09,0:14:22.04,Default,,0,0,0,,Асыл паразит...
Dialogue: 0,0:14:30.05,0:14:32.08,Default,,0,0,0,,Томас, сен осындасың ба?
Dialogue: 0,0:14:33.04,0:14:35.06,Default,,0,0,0,,Кішкене әңгіме тыңдайық.
Dialogue: 0,0:14:36.03,0:14:39.03,Default,,0,0,0,,Синтия, мейрамханадан келген соң.
Dialogue: 0,0:14:39.04,0:14:41.02,Default,,0,0,0,,Қиналғаныма көп болды
Dialogue: 0,0:14:41.07,0:14:42.07,Default,,0,0,0,,Ол жігіт...
Dialogue: 0,0:14:43.05,0:14:46.02,Default,,0,0,0,,Синтия сіздің қолыңызға ерекше көңіл бөледі.
Dialogue: 0,0:14:46.04,0:14:48.09,Default,,0,0,0,,Бұл суретті басқа ешкім сала алмады.
Dialogue: 0,0:14:50.02,0:14:52.07,Default,,0,0,0,,Өткенде не болғанын білмеймін.
Dialogue: 0,0:14:52.08,0:14:55.09,Default,,0,0,0,,Бірақ, сіз оған көмектесе аласыз ба?
Dialogue: 0,0:14:58.09,0:14:59.09,Default,,0,0,0,,(дыбыс құлпын ашу)
Dialogue: 0,0:15:03.09,0:15:05.06,Default,,0,0,0,,Бұл ескі күндер...
Dialogue: 0,0:15:05.07,0:15:10.04,Default,,0,0,0,,Иә, ол кезде ол қарапайым және боянбайтын еді.
Dialogue: 0,0:15:10.09,0:15:13.06,Default,,0,0,0,,Консервіленген бұршақты қуана жеп отырды.
Dialogue: 0,0:15:13.07,0:15:16.07,Default,,0,0,0,,Көп жағдайда мен сізді осы уақытта кездестірсем деп едім.
Dialogue: 0,0:15:17.03,0:15:20.03,Default,,0,0,0,,Соңғы кездері мен ішімдікті көп ішетін болдым.
Dialogue: 0,0:15:20.04,0:15:22.00,Default,,0,0,0,,Менопауза болуы мүмкін
Dialogue: 0,0:15:22.04,0:15:24.06,Default,,0,0,0,,Мен де ұқсаспын.
Dialogue: 0,0:15:25.08,0:15:27.07,Default,,0,0,0,,Егер бұл әлі Синтия туралы болса...
Dialogue: 0,0:15:27.08,0:15:29.02,Default,,0,0,0,,(Иида) Барлығы шараның рухына ене ала ма екен?
Dialogue: 0,0:15:29.05,0:15:31.01,Default,,0,0,0,,Бітті.
Dialogue: 0,0:15:31.08,0:15:33.08,Default,,0,0,0,,Олай болса, тыңдап ал.
Dialogue: 0,0:15:34.02,0:15:36.09,Default,,0,0,0,,Сіз 2 миллион иен қарыз жасадыңыз ба?
Dialogue: 0,0:15:38.08,0:15:39.06,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:40.04,0:15:44.08,Default,,0,0,0,,Мен өнер мұражайына жалғандық жасау бойынша зерттеу жүргізу үшін бардым.
Dialogue: 0,0:15:52.08,0:15:56.05,Default,,0,0,0,,Бұл мен салған жалғандық болды.
Dialogue: 0,0:15:59.05,0:16:00.06,Default,,0,0,0,,Мен қорқамын...
Dialogue: 0,0:16:03.06,0:16:05.08,Default,,0,0,0,,Мен өзімді жынданып бара жатқандай сезіндім.
Dialogue: 0,0:16:06.00,0:16:07.00,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:16:07.04,0:16:09.05,Default,,0,0,0,,Томас, сен тірісің бе?
Dialogue: 0,0:16:10.06,0:16:11.08,Default,,0,0,0,,Томас!
Dialogue: 0,0:16:12.00,0:16:12.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:13.02,0:16:15.03,Default,,0,0,0,,Мен бәрінен қаштым
Dialogue: 0,0:16:15.05,0:16:16.03,Default,,0,0,0,,Tsk
Dialogue: 0,0:16:17.04,0:16:18.04,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:16:18.06,0:16:19.06,Default,,0,0,0,,(шу)
Dialogue: 0,0:16:23.06,0:16:27.01,Default,,0,0,0,,Костаның «Ностальгия» Кокудың «Фортепиано мұғалімі»
Dialogue: 0,0:16:27.02,0:16:29.01,Default,,0,0,0,,Мартинестің «Сиеста»
Dialogue: 0,0:16:29.05,0:16:31.07,Default,,0,0,0,,Бұл мен салған жалғандық.
Dialogue: 0,0:16:32.04,0:16:34.08,Default,,0,0,0,,Мен оны сатып алу үшін әртүрлі әдістерді қолдандым.
Dialogue: 0,0:16:34.09,0:16:37.00,Default,,0,0,0,,Дүниеде енді ешқашан пайда болмас үшін...
Dialogue: 0,0:16:37.04,0:16:39.00,Default,,0,0,0,,О, сіз ақша қарызсыз ба?
Dialogue: 0,0:16:39.01,0:16:41.05,Default,,0,0,0,,Өзім еккен дәнім.
Dialogue: 0,0:16:43.03,0:16:45.01,Default,,0,0,0,,Сондықтан мен шештім
Dialogue: 0,0:16:45.02,0:16:47.03,Default,,0,0,0,,Мен енді ешқашан сурет салмаймын
Dialogue: 0,0:16:47.05,0:16:50.03,Default,,0,0,0,,Жалғандық әлдеқайда аз.
Dialogue: 0,0:16:51.03,0:16:52.09,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:16:53.00,0:16:57.08,Default,,0,0,0,,Жалған ақшаны қарызға алу және қарызды жабу үшін жалғандық жасау?
Dialogue: 0,0:16:58.00,0:16:59.03,Default,,0,0,0,,Бұл бос сөз.
Dialogue: 0,0:16:59.06,0:17:00.06,Default,,0,0,0,,Хаа…
Dialogue: 0,0:17:00.08,0:17:03.03,Default,,0,0,0,,Мен оны Синтияның үйінен жасырын әкелдім.
Dialogue: 0,0:17:04.02,0:17:05.06,Default,,0,0,0,,Бұл таныс сияқты ма?
Dialogue: 0,0:17:26.07,0:17:27.09,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:29.05,0:17:32.08,Default,,0,0,0,,Мен сізге әлі нақты нәрсені бере алмаймын...
Dialogue: 0,0:17:33.03,0:17:36.03,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Бұл шынайы.
Dialogue: 0,0:17:39.08,0:17:41.00,Default,,0,0,0,,Хехе
Dialogue: 0,0:17:46.04,0:17:49.00,Default,,0,0,0,,Синтия сенімен ажырасқаннан бері.
Dialogue: 0,0:17:49.01,0:17:50.08,Default,,0,0,0,,Ештеңе өзгерген жоқ
Dialogue: 0,0:17:51.02,0:17:54.04,Default,,0,0,0,,Мен сені алып кетуіңді күттім!
Dialogue: 0,0:17:56.01,0:17:57.02,Default,,0,0,0,,тым кеш...
Dialogue: 0,0:17:57.09,0:17:59.07,Default,,0,0,0,,Өйткені сен осылай қыңырсың.
Dialogue: 0,0:17:59.08,0:18:01.09,Default,,0,0,0,,Синтия қозғала бастады.
Dialogue: 0,0:18:02.03,0:18:04.03,Default,,0,0,0,,Онымен мәселені шешу.
Dialogue: 0,0:18:04.05,0:18:05.03,Default,,0,0,0,,Есеп айырысу?
Dialogue: 0,0:18:05.09,0:18:09.09,Default,,0,0,0,,Сізді жалған суретші болуға жетелеген Коулманмен есеп айырысу.
Dialogue: 0,0:18:10.02,0:18:12.04,Default,,0,0,0,,Бірақ жалғыз Синтия ештеңе істей алмайды.
Dialogue: 0,0:18:13.04,0:18:15.08,Default,,0,0,0,,Енді әлі де кеш емес.
Dialogue: 0,0:18:15.09,0:18:18.02,Default,,0,0,0,,Енді қадам жасау кезегі сізде!
Dialogue: 0,0:18:20.04,0:18:23.00,Default,,0,0,0,,Осыған нүкте қоя алсам
Dialogue: 0,0:18:24.02,0:18:26.05,Default,,0,0,0,,Мен нағыз адам болуға қайта орала аламын ба деп ойлаймын.
Dialogue: 0,0:18:27.09,0:18:29.06,Default,,0,0,0,,Сол кездегі Синтияға
Dialogue: 0,0:18:31.03,0:18:32.08,Default,,0,0,0,,Эй, бұл жер...
Dialogue: 0,0:18:34.00,0:18:36.02,Default,,0,0,0,,Хехе, іштей.
Dialogue: 0,0:18:36.09,0:18:39.04,Default,,0,0,0,,Бөлменің орналасуын Синтия қадағалады.
Dialogue: 0,0:18:40.01,0:18:41.01,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:18:41.02,0:18:43.08,Default,,0,0,0,,Перделер мен төсек әлі келген жоқ.
Dialogue: 0,0:18:43.09,0:18:45.02,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:18:45.03,0:18:46.02,Default,,0,0,0,,О
Dialogue: 0,0:18:47.09,0:18:51.07,Default,,0,0,0,,Серхио Монтойя «Лондондағы қар»
Dialogue: 0,0:18:51.09,0:18:53.01,Default,,0,0,0,,Сіз сурет сала білуіңіз керек пе?
Dialogue: 0,0:18:53.05,0:18:56.07,Default,,0,0,0,,Мен Монтойяны бірнеше рет қолданып көрдім.
Dialogue: 0,0:18:56.08,0:18:58.08,Default,,0,0,0,,Бұл ешқашан орындалмаған.
Dialogue: 0,0:18:59.08,0:19:03.03,Default,,0,0,0,,Бірақ егер нақты нәрсе жақын болса...
Dialogue: 0,0:19:11.08,0:19:13.07,Default,,0,0,0,,Мен сізге көмектесе алатын нәрсе бар ма?
Dialogue: 0,0:19:14.08,0:19:15.09,Default,,0,0,0,,Томас?
Dialogue: 0,0:20:05.02,0:20:07.05,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:20:08.09,0:20:10.03,Default,,0,0,0,,Тыныс алып жатқан сияқты.
Dialogue: 0,0:20:11.02,0:20:13.08,Default,,0,0,0,,Мердігерді шақыратындай лас.
Dialogue: 0,0:20:18.09,0:20:20.03,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:20:20.07,0:20:22.08,Default,,0,0,0,,Ол жай ғана қарт адам емес еді.
Dialogue: 0,0:20:23.02,0:20:24.04,Default,,0,0,0,,Мені есіңде бар ғой, иә?
Dialogue: 0,0:20:25.09,0:20:27.01,Default,,0,0,0,,Синтия
Dialogue: 0,0:20:27.09,0:20:30.06,Default,,0,0,0,,Ескі инстинкттерін қалпына келтіру, Томас
Dialogue: 0,0:20:30.07,0:20:32.09,Default,,0,0,0,,Міне, мен өмірімді қатерге тігіп сурет салдым.
Dialogue: 0,0:20:33.09,0:20:35.06,Default,,0,0,0,,Томас мұның бәрін жасады.
Dialogue: 0,0:20:36.06,0:20:39.00,Default,,0,0,0,,Бұл жігіттің жұмысы ақша үшін емес.
Dialogue: 0,0:20:39.06,0:20:40.05,Default,,0,0,0,,Бұл сізге арналған.
Dialogue: 0,0:20:42.00,0:20:43.08,Default,,0,0,0,,Мұны байыппен қабылдаңыз
Dialogue: 0,0:20:45.03,0:20:46.09,Default,,0,0,0,,Томас және сіз де
Dialogue: 0,0:20:47.03,0:20:49.01,Default,,0,0,0,,Әлі де сол кездегідей екеніне сенімдімін.
Dialogue: 0,0:20:51.00,0:20:57.00,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:22:44.06,0:22:50.07,Default,,0,0,0,,~♪
Dialogue: 0,0:22:51.57,0:22:56.57,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
