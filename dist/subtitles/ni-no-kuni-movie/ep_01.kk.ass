Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:31.11,0:00:33.95,Default,,0,0,0,,хм/сағ хм/сағ
Dialogue: 0,0:00:34.11,0:00:36.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:38.78,0:00:39.66,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:00:40.37,0:00:44.46,Default,,0,0,0,,Ммм... Ммм.
Dialogue: 0,0:00:47.33,0:00:49.04,Default,,0,0,0,,Хмм... Ха!
Dialogue: 0,0:00:53.09,0:00:55.01,Default,,0,0,0,,А... тағы да?
Dialogue: 0,0:00:55.80,0:00:57.84,Default,,0,0,0,,Әй, қария
Dialogue: 0,0:00:58.09,0:00:59.30,Default,,0,0,0,,Ол жерде қауіпті.
Dialogue: 0,0:01:00.31,0:01:01.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:01.22,0:01:05.27,Default,,0,0,0,,О, сен қазір сиқыр айтып жатырсың.
Dialogue: 0,0:01:05.81,0:01:06.98,Default,,0,0,0,,Мазаламау
Dialogue: 0,0:01:07.81,0:01:10.15,Default,,0,0,0,,Не қаласаң, бөлмеңе қайт.
Dialogue: 0,0:01:10.27,0:01:11.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:11.19,0:01:13.65,Default,,0,0,0,,Мені ақымақ деп ойламайсың ба?
Dialogue: 0,0:01:13.74,0:01:15.20,Default,,0,0,0,,Мен ойламаймын, олай ойламаймын
Dialogue: 0,0:01:15.32,0:01:17.78,Default,,0,0,0,,Тоқта! Жіберме
Dialogue: 0,0:01:17.86,0:01:19.57,Default,,0,0,0,,Сиқыр өшіп қалса, мен не істеуім керек?
Dialogue: 0,0:01:19.66,0:01:20.62,Default,,0,0,0,,Аурухананың төбесінде -
Dialogue: 0,0:01:20.70,0:01:23.16,Default,,0,0,0,,Қандай сиқыр жарылады?
Dialogue: 0,0:01:26.21,0:01:27.75,Default,,0,0,0,,«Қақпа»
Dialogue: 0,0:01:28.54,0:01:29.75,Default,,0,0,0,,Бір сәт бұрын менде екіұшты сезім болды—
Dialogue: 0,0:01:30.13,0:01:33.05,Default,,0,0,0,,Ааа! Гейтбол ше?
Dialogue: 0,0:01:33.13,0:01:35.13,Default,,0,0,0,,Ақымақ! Қақпа
Dialogue: 0,0:01:35.51,0:01:38.05,Default,,0,0,0,,Басқа дүниенің есігін ашатын сиқыр.
Dialogue: 0,0:01:50.86,0:01:52.36,Default,,0,0,0,,Эй, эй
Dialogue: 0,0:01:56.19,0:01:57.28,Default,,0,0,0,,Итадаки!
Dialogue: 0,0:01:59.49,0:02:00.78,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:02:00.87,0:02:03.12,Default,,0,0,0,,Шыққан аға бүгінде қағып тұр.
Dialogue: 0,0:02:03.20,0:02:04.33,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:02:04.70,0:02:06.79,Default,,0,0,0,,Цк... итермелейтін жігіт
Dialogue: 0,0:02:06.87,0:02:08.08,Default,,0,0,0,,Сіз жеңілгеніңізге ашуланасыз ба?
Dialogue: 0,0:02:08.75,0:02:10.92,Default,,0,0,0,,Барлығымыз кеттік!
Dialogue: 0,0:02:11.00,0:02:13.50,Default,,0,0,0,,Хару-сенпай!
Dialogue: 0,0:02:13.84,0:02:15.05,Default,,0,0,0,,
Dialogue: 0,0:02:15.17,0:02:16.05,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:17.51,0:02:20.47,Default,,0,0,0,,Еңбегіңіз үшін рахмет. (Ер оқушы) Еңбегіңізге рахмет.
Dialogue: 0,0:02:20.55,0:02:22.01,Default,,0,0,0,,Жарайсыңдар
Dialogue: 0,0:02:22.10,0:02:24.06,Default,,0,0,0,,Жоқ, бұл өте керемет
Dialogue: 0,0:02:27.14,0:02:27.98,Default,,0,0,0,,Ю
Dialogue: 0,0:02:28.85,0:02:31.86,Default,,0,0,0,,Синозакидің түрін көрдіңіз бе? Мен өзімді сергек сезіндім.
Dialogue: 0,0:02:32.48,0:02:36.40,Default,,0,0,0,,Соңғы рет ол сізді толығымен басып тастады.
Dialogue: 0,0:02:37.03,0:02:39.40,Default,,0,0,0,,Сол қапталдан жасалған шабуылдарға әлсіз болды.
Dialogue: 0,0:02:39.70,0:02:41.16,Default,,0,0,0,,Дұрыс айтасыз.
Dialogue: 0,0:02:41.28,0:02:42.91,Default,,0,0,0,,Бірақ мен тым шыдамсыз болдым.
Dialogue: 0,0:02:42.99,0:02:45.12,Default,,0,0,0,,Соңғы кезеңде қысқа шабуыл жасасаңыз...
Dialogue: 0,0:02:45.20,0:02:46.91,Default,,0,0,0,,Мен тағы 5 ұпай алуым керек еді.
Dialogue: 0,0:02:47.00,0:02:48.16,Default,,0,0,0,,Өте жаман
Dialogue: 0,0:02:48.25,0:02:49.62,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:02:50.33,0:02:53.54,Default,,0,0,0,,Мен сіздің басыңызды пайдаланып тиімді қозғалмай жатқаныңызды көргенде...
Dialogue: 0,0:02:53.63,0:02:54.71,Default,,0,0,0,,Бұл көңілсіз.
Dialogue: 0,0:02:55.63,0:02:56.63,Default,,0,0,0,,Егер мен енді...
Dialogue: 0,0:02:57.17,0:02:59.42,Default,,0,0,0,,Әйел жанкүйерлер саны тым көбейді, бұл мәселе.
Dialogue: 0,0:02:59.72,0:03:01.30,Default,,0,0,0,,Хару Ю
Dialogue: 0,0:03:03.80,0:03:04.80,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:03:05.89,0:03:07.64,Default,,0,0,0,,Бүгінгі ойында жеңіске жеттіңіз бе?
Dialogue: 0,0:03:07.77,0:03:08.64,Default,,0,0,0,,Әрине, білемін.
Dialogue: 0,0:03:08.73,0:03:09.89,Default,,0,0,0,,Сәлем Котона
Dialogue: 0,0:03:10.14,0:03:12.27,Default,,0,0,0,,...Сонымен біз қазір не туралы айтып отырмыз?
Dialogue: 0,0:03:13.23,0:03:15.23,Default,,0,0,0,,Бұл «фан әйелдер мен балалар» туралы әңгіме.
Dialogue: 0,0:03:15.52,0:03:16.40,Default,,0,0,0,,Эй...
Dialogue: 0,0:03:17.15,0:03:19.78,Default,,0,0,0,,Мен осында жүргенде мені тағы алдамақшысың ба?
Dialogue: 0,0:03:20.03,0:03:20.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:20.99,0:03:23.20,Default,,0,0,0,,Эй, сенің соттылығың бар.
Dialogue: 0,0:03:23.28,0:03:24.78,Default,,0,0,0,,Хмм.
Dialogue: 0,0:03:26.53,0:03:28.45,Default,,0,0,0,,Өткен күні мен сыйлық үшін рахмет дедім.
Dialogue: 0,0:03:28.54,0:03:30.54,Default,,0,0,0,,Бірінші сынып оқушыларымен кім шай ішіп отырды?
Dialogue: 0,0:03:30.71,0:03:31.54,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:32.04,0:03:33.29,Default,,0,0,0,,Ауырды!
Dialogue: 0,0:03:33.37,0:03:35.17,Default,,0,0,0,,Келесі жолы жоқ.
Dialogue: 0,0:03:36.13,0:03:37.13,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:03:37.21,0:03:38.63,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:03:39.92,0:03:41.67,Default,,0,0,0,,Бұл туралы бүгін.
Dialogue: 0,0:03:42.13,0:03:43.01,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:03:43.26,0:03:45.55,Default,,0,0,0,,Мен дәмді креп дүкені туралы ақпарат алдым.
Dialogue: 0,0:03:45.64,0:03:48.56,Default,,0,0,0,,Апельсинді крепе қышқыл және ең жақсысы.
Dialogue: 0,0:03:48.85,0:03:49.68,Default,,0,0,0,,Барғыңыз келе ме?
Dialogue: 0,0:03:49.77,0:03:52.73,Default,,0,0,0,,Мен Котонаның қышқыл апельсиндерін жақсы көремін.
Dialogue: 0,0:03:52.98,0:03:54.40,Default,,0,0,0,,Өйткені маған ұнайды.
Dialogue: 0,0:03:54.52,0:03:56.06,Default,,0,0,0,,Хехе... Жарайды.
Dialogue: 0,0:03:56.15,0:03:57.82,Default,,0,0,0,,Жеңіс мерекесін тойлайық
Dialogue: 0,0:04:03.53,0:04:05.07,Default,,0,0,0,,Мүмкін жақын арада
Dialogue: 0,0:04:06.24,0:04:07.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:08.33,0:04:10.25,Default,,0,0,0,,Дүкен алда
Dialogue: 0,0:04:10.50,0:04:12.21,Default,,0,0,0,,Ах... Ах.
Dialogue: 0,0:04:14.96,0:04:16.33,Default,,0,0,0,,Басқа дүкенді қолданып көруім керек пе?
Dialogue: 0,0:04:16.63,0:04:18.21,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:04:18.63,0:04:19.46,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:04:19.84,0:04:21.71,Default,,0,0,0,,Бұзушылар осы жерден кетеді
Dialogue: 0,0:04:22.01,0:04:23.93,Default,,0,0,0,,Бүгінге екеуміз ғана.
Dialogue: 0,0:04:24.18,0:04:25.72,Default,,0,0,0,,Ах... Эй Юу
Dialogue: 0,0:04:26.47,0:04:28.81,Default,,0,0,0,,Шынымды айтсам, уайымдама, мен үйреніп қалдым.
Dialogue: 0,0:04:33.64,0:04:35.77,Default,,0,0,0,,Асығыңыз (бала) күтіңіз
Dialogue: 0,0:04:38.73,0:04:39.86,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:04:40.23,0:04:41.15,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:04:41.40,0:04:43.28,Default,,0,0,0,,Қош келдіңіз, Юукун.
Dialogue: 0,0:04:43.36,0:04:44.82,Default,,0,0,0,,Нанако-сан, еңбегіңіз үшін рахмет.
Dialogue: 0,0:04:51.12,0:04:52.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:17.60,0:05:18.56,Default,,0,0,0,,Фу…
Dialogue: 0,0:05:29.70,0:05:30.91,Default,,0,0,0,,Хмм.
Dialogue: 0,0:05:34.12,0:05:36.96,Default,,0,0,0,,Дайын, бұл тамаша.
Dialogue: 0,0:05:39.63,0:05:40.71,Default,,0,0,0,,Жасайық
Dialogue: 0,0:05:41.17,0:05:42.00,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:05:45.09,0:05:48.43,Default,,0,0,0,,Мен сіздің басыңызды тиімді пайдаланбағаныңызды көргенде...
Dialogue: 0,0:05:48.55,0:05:49.84,Default,,0,0,0,,Бұл көңілсіз.
Dialogue: 0,0:05:52.81,0:05:54.89,Default,,0,0,0,,Мені ренжітетін нәрсе
Dialogue: 0,0:05:55.64,0:05:56.77,Default,,0,0,0,,Басқа жерде?
Dialogue: 0,0:06:00.40,0:06:01.48,Default,,0,0,0,,Басқа сиқыршылардың қосымша күштерінен қашқысы келген бе?
Dialogue: 0,0:06:02.77,0:06:04.98,Default,,0,0,0,,Мен бүгін Юуға жамандық жасадым.
Dialogue: 0,0:06:05.53,0:06:06.94,Default,,0,0,0,,Келесі жолы бірге барайық.
Dialogue: 0,0:06:07.11,0:06:09.03,Default,,0,0,0,,Айналмалы жолмен жүрсек, Ю да кете алады.
Dialogue: 0,0:06:09.49,0:06:11.37,Default,,0,0,0,,Иә, ертең кездескенше.
Dialogue: 0,0:06:12.20,0:06:13.37,Default,,0,0,0,,(Ашидо) Хе-хе, Брекинг, Брекинг!
Dialogue: 0,0:06:13.79,0:06:14.91,Default,,0,0,0,,Бұл да.
Dialogue: 0,0:06:33.47,0:06:34.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:51.86,0:06:54.74,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:06:55.12,0:06:55.95,Default,,0,0,0,,Котона?
Dialogue: 0,0:06:56.04,0:06:56.87,Default,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,0:06:56.99,0:06:58.20,Default,,0,0,0,,Не? ше?
Dialogue: 0,0:06:58.33,0:07:00.46,Default,,0,0,0,,Артымнан біреу жүре бере ме деп қорқамын
Dialogue: 0,0:07:00.54,0:07:01.62,Default,,0,0,0,,Иә? Ал Хару ше?
Dialogue: 0,0:07:01.71,0:07:04.25,Default,,0,0,0,,Екеуміз енді ғана айырылысып, телефонмен сөйлесе алмай жатырмыз.
Dialogue: 0,0:07:04.54,0:07:05.55,Default,,0,0,0,,Қазір қайдасың?
Dialogue: 0,0:07:05.63,0:07:07.09,Default,,0,0,0,,Бірінші көше аллеясында...
Dialogue: 0,0:07:14.89,0:07:17.14,Default,,0,0,0,,Саки-ни, көлікті шығарып салшы.
Dialogue: 0,0:07:17.47,0:07:18.68,Default,,0,0,0,,Не? Апыр-ай!
Dialogue: 0,0:07:20.31,0:07:23.86,Default,,0,0,0,,Айтпақшы, Котона, сенің туған күнің жақындап қалды.
Dialogue: 0,0:07:24.98,0:07:27.65,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:07:30.86,0:07:33.28,Default,,0,0,0,,Ол осындай уақытта не істеп жатыр?
Dialogue: 0,0:07:33.95,0:07:34.99,Default,,0,0,0,,Ең ауыр жарақат алған – Зенитсу-сан
Dialogue: 0,0:07:35.41,0:07:36.87,Default,,0,0,0,,Котона қауіпті
Dialogue: 0,0:07:36.95,0:07:37.79,Default,,0,0,0,,Не қауіпті?
Dialogue: 0,0:07:37.87,0:07:40.79,Default,,0,0,0,,Білмеймін, бәлкім, мені бір бұзық адам аңдып жүрген шығар.
Dialogue: 0,0:07:41.16,0:07:42.79,Default,,0,0,0,,Әйтеуір, мен оны асығыс алдым.
Dialogue: 0,0:07:46.34,0:07:47.42,Default,,0,0,0,,Мені осында түсіріңіз
Dialogue: 0,0:07:47.50,0:07:48.34,Default,,0,0,0,,Иә
Dialogue: 0,0:07:53.51,0:07:55.34,Default,,0,0,0,,Саки-ни де Харумен байланысып көр.
Dialogue: 0,0:07:56.01,0:07:58.85,Default,,0,0,0,,Жарайды, мен де іздеймін.
Dialogue: 0,0:08:09.23,0:08:10.44,Default,,0,0,0,,(Котонаның айқайы)
Dialogue: 0,0:08:12.82,0:08:13.65,Default,,0,0,0,,Котона!
Dialogue: 0,0:08:16.95,0:08:17.74,Default,,0,0,0,,Хаха…
Dialogue: 0,0:08:17.83,0:08:18.95,Default,,0,0,0,,Сен оған көп қиындық көрсеттің ғой, иә?
Dialogue: 0,0:08:19.04,0:08:20.87,Default,,0,0,0,,О, тоқтат!
Dialogue: 0,0:08:28.34,0:08:31.05,Default,,0,0,0,,Уау
Dialogue: 0,0:08:39.76,0:08:40.68,Default,,0,0,0,,Котона
Dialogue: 0,0:08:42.77,0:08:43.60,Default,,0,0,0,,Котона!
Dialogue: 0,0:08:44.85,0:08:45.69,Default,,0,0,0,,Котона
Dialogue: 0,0:08:46.52,0:08:48.11,Default,,0,0,0,,Жарайды, ештеңе емес.
Dialogue: 0,0:08:54.53,0:08:56.66,Default,,0,0,0,,Котона Котона Ах...
Dialogue: 0,0:08:57.32,0:08:58.91,Default,,0,0,0,,Мен дереу жедел жәрдем шақырамын.
Dialogue: 0,0:08:58.99,0:09:01.45,Default,,0,0,0,,(Котонаның ауыр тыныс алуы)
Dialogue: 0,0:09:03.79,0:09:06.29,Default,,0,0,0,,Кiiiiieee!
Dialogue: 0,0:09:08.88,0:09:10.92,Default,,0,0,0,,Хал, мені өтіп бара жатқан адам пышақтап кетті.
Dialogue: 0,0:09:11.96,0:09:12.80,Default,,0,0,0,,Котона!
Dialogue: 0,0:09:13.97,0:09:16.26,Default,,0,0,0,,Халл! Оны жылжытпаңыз
Dialogue: 0,0:09:16.34,0:09:17.43,Default,,0,0,0,,Жедел жәрдем шақырайық
Dialogue: 0,0:09:17.51,0:09:18.34,Default,,0,0,0,,Шу!
Dialogue: 0,0:09:18.55,0:09:20.89,Default,,0,0,0,,Аузыңды жап! Сіз не істеп жүрсіз?
Dialogue: 0,0:09:21.14,0:09:22.77,Default,,0,0,0,,О... мен...
Dialogue: 0,0:09:22.85,0:09:24.77,Default,,0,0,0,,Мен Котонаны ауруханаға апарамын.
Dialogue: 0,0:09:24.93,0:09:25.77,Default,,0,0,0,,Хару!
Dialogue: 0,0:09:32.90,0:09:33.73,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:09:34.90,0:09:35.82,Default,,0,0,0,,Хал, тоқтат!
Dialogue: 0,0:09:38.61,0:09:39.91,Default,,0,0,0,,Хару!
Dialogue: 0,0:09:39.99,0:09:41.66,Default,,0,0,0,,Уау
Dialogue: 0,0:09:43.37,0:09:45.20,Default,,0,0,0,,Уау
Dialogue: 0,0:09:57.88,0:10:00.14,Default,,0,0,0,,Ол қайда? мұнда
Dialogue: 0,0:10:00.43,0:10:02.60,Default,,0,0,0,,Ал не? Бұл көрініс
Dialogue: 0,0:10:02.93,0:10:03.76,Default,,0,0,0,,О
Dialogue: 0,0:10:03.85,0:10:05.64,Default,,0,0,0,,Ах! Котона жоқ
Dialogue: 0,0:10:05.77,0:10:07.02,Default,,0,0,0,,Иә, Котона
Dialogue: 0,0:10:07.23,0:10:08.39,Default,,0,0,0,,Котона қайда орналасқан?
Dialogue: 0,0:10:08.48,0:10:09.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:15.86,0:10:17.24,Default,,0,0,0,,Хару, бұл смартфон.
Dialogue: 0,0:10:17.45,0:10:18.28,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:23.87,0:10:25.04,Default,,0,0,0,,Ах! Бұл...
Dialogue: 0,0:10:26.37,0:10:27.62,Default,,0,0,0,,Компас
Dialogue: 0,0:10:30.25,0:10:31.42,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:10:32.42,0:10:33.84,Default,,0,0,0,,Уау
Dialogue: 0,0:10:33.92,0:10:35.84,Default,,0,0,0,,(жылау)
Dialogue: 0,0:10:35.92,0:10:37.21,Default,,0,0,0,,Бұл ит пе?
Dialogue: 0,0:10:37.55,0:10:39.34,Default,,0,0,0,,Бұл біртүрлі ит.
Dialogue: 0,0:10:40.01,0:10:40.84,Default,,0,0,0,,«Оның аман-есен жетуін қамтамасыз етші.»
Dialogue: 0,0:10:40.93,0:10:42.68,Default,,0,0,0,,Жолдың ортасында отыру
Dialogue: 0,0:10:42.76,0:10:44.39,Default,,0,0,0,,Бірдеңе байқалды ма?
Dialogue: 0,0:10:44.64,0:10:46.10,Default,,0,0,0,,Орындарды ауыстырайық, а
Dialogue: 0,0:10:47.73,0:10:48.98,Default,,0,0,0,,Ол жерде адам көп емес.
Dialogue: 0,0:10:49.06,0:10:49.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:49.89,0:10:51.48,Default,,0,0,0,,Юу, сен...
Dialogue: 0,0:10:52.65,0:10:54.90,Default,,0,0,0,,Не? Жүр, Хару, тезірек.
Dialogue: 0,0:10:56.57,0:10:58.11,Default,,0,0,0,,Аяқтарыңызға қараңыз
Dialogue: 0,0:10:59.65,0:11:02.45,Default,,0,0,0,,А... мен жүрмін бе?
Dialogue: 0,0:11:04.62,0:11:07.29,Default,,0,0,0,,Менің аяғым... Не деп тұрсың?
Dialogue: 0,0:11:08.20,0:11:10.00,Default,,0,0,0,,Сіз жай ғана жүрдіңіз.
Dialogue: 0,0:11:10.37,0:11:12.25,Default,,0,0,0,,Әй, қайтадан жүріп көріңіз.
Dialogue: 0,0:11:13.33,0:11:14.17,Default,,0,0,0,,О
Dialogue: 0,0:11:18.21,0:11:20.88,Default,,0,0,0,,Бұл не... Мынау не?
Dialogue: 0,0:11:23.97,0:11:27.14,Default,,0,0,0,,Бұл өтірік, солай ма? Шынымен, не болып жатыр, Ю?
Dialogue: 0,0:11:27.52,0:11:30.10,Default,,0,0,0,,Мен білмеймін, білмеймін, бірақ...
Dialogue: 0,0:11:46.83,0:11:49.37,Default,,0,0,0,,Бұл жер қай жерде?
Dialogue: 0,0:11:49.54,0:11:51.66,Default,,0,0,0,,Соңғы жоғары технологиялық технологиямен жасалған.
Dialogue: 0,0:11:51.75,0:11:53.33,Default,,0,0,0,,Бұл ойын-сауық саябағы болуы мүмкін.
Dialogue: 0,0:11:53.92,0:11:56.21,Default,,0,0,0,,Немесе бірдеңені түсіру...
Dialogue: 0,0:11:57.55,0:11:59.13,Default,,0,0,0,,Сонда бұл не?
Dialogue: 0,0:12:00.13,0:12:01.84,Default,,0,0,0,,Бұл робот. Бұл динозавр.
Dialogue: 0,0:12:02.38,0:12:04.34,Default,,0,0,0,,Бұл компьютермен басқарылады, солай ма?
Dialogue: 0,0:12:04.43,0:12:06.39,Default,,0,0,0,,Тірі сияқты
Dialogue: 0,0:12:07.43,0:12:09.47,Default,,0,0,0,,Не болды саған? Біраз қақтығысқыш болып тұрсың ғой?
Dialogue: 0,0:12:09.93,0:12:12.73,Default,,0,0,0,,Косплейде де оның керемет металдық сезімі бар.
Dialogue: 0,0:12:13.19,0:12:14.69,Default,,0,0,0,,Бұл шын мәнінде.
Dialogue: 0,0:12:14.98,0:12:15.81,Default,,0,0,0,,Не?
Dialogue: 0,0:12:16.06,0:12:17.94,Default,,0,0,0,,Бұл шынымен басқа әлем.
Dialogue: 0,0:12:18.73,0:12:19.78,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:19.94,0:12:20.99,Default,,0,0,0,,Бұл жай ғана гипотеза...
Dialogue: 0,0:12:21.40,0:12:23.40,Default,,0,0,0,,Біз басқа әлемге секірдік
Dialogue: 0,0:12:24.66,0:12:25.49,Default,,0,0,0,,Басқа әлем?
Dialogue: 0,0:12:26.12,0:12:28.62,Default,,0,0,0,,Ах! Оның үстіне Котона бір жерде ме?
Dialogue: 0,0:12:29.45,0:12:31.62,Default,,0,0,0,,Дұрыс, Котона...
Dialogue: 0,0:12:33.37,0:12:35.54,Default,,0,0,0,,Сіз жарақат алдыңыз.
Dialogue: 0,0:12:35.62,0:12:37.25,Default,,0,0,0,,Бұл қауіпті. Күте тұрыңыз, Хару.
Dialogue: 0,0:12:37.42,0:12:39.42,Default,,0,0,0,,Менің аяғым осылай жазылып жатыр.
Dialogue: 0,0:12:40.00,0:12:43.01,Default,,0,0,0,,Бұл дүниеде жарақат сияқты нәрселер жазылуы мүмкін.
Dialogue: 0,0:12:43.38,0:12:46.14,Default,,0,0,0,,Түсіндім! Бұл дұрыс
Dialogue: 0,0:12:46.59,0:12:48.55,Default,,0,0,0,,Уайымдау сізге көмектеспейді, солай ма?
Dialogue: 0,0:12:48.68,0:12:50.77,Default,,0,0,0,,Дұрыс, ең бірінші әрекет жасау керек.
Dialogue: 0,0:12:51.06,0:12:53.52,Default,,0,0,0,,Котона, мен сені табамын.
Dialogue: 0,0:12:55.69,0:12:57.31,Default,,0,0,0,,Бұл жолақ.
Dialogue: 0,0:12:57.81,0:12:58.90,Default,,0,0,0,,Мен кіре аламын ба?
Dialogue: 0,0:12:59.02,0:13:01.73,Default,,0,0,0,,Қатты болмаңыз. Бұл басқа әлем, солай ма?
Dialogue: 0,0:13:09.87,0:13:12.83,Default,,0,0,0,,Уау! Бұл мүлдем басқа дүние.
Dialogue: 0,0:13:13.04,0:13:13.87,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:13:16.00,0:13:19.00,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:13:20.13,0:13:22.63,Default,,0,0,0,,Сәлем, үй иесі! Бұл алкоголь, бұл алкоголь
Dialogue: 0,0:13:22.88,0:13:24.76,Default,,0,0,0,,Мен сізден өтінемін
Dialogue: 0,0:13:27.68,0:13:28.97,Default,,0,0,0,,Иә.
Dialogue: 0,0:13:29.09,0:13:32.56,Default,,0,0,0,,Бірақ балалар, күндіз мұны істеуге болады ма?
Dialogue: 0,0:13:32.85,0:13:34.52,Default,,0,0,0,,Біз жалдамалы жауынгерміз
Dialogue: 0,0:13:34.77,0:13:36.85,Default,,0,0,0,,Бірдеңе болмайынша, бұл пайдасыз.
Dialogue: 0,0:13:36.94,0:13:40.36,Default,,0,0,0,,Жарайды, мен тыныштық болғанын қаламаймын.
Dialogue: 0,0:13:40.94,0:13:42.65,Default,,0,0,0,,Дүкен оған тұрарлық емес пе?
Dialogue: 0,0:13:42.86,0:13:43.90,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:13:43.98,0:13:45.95,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:13:46.53,0:13:47.99,Default,,0,0,0,,Олар жай ғана мас
Dialogue: 0,0:13:48.11,0:13:49.28,Default,,0,0,0,,Біз де ішеміз бе?
Dialogue: 0,0:13:49.95,0:13:51.03,Default,,0,0,0,,Мен ішпеймін
Dialogue: 0,0:13:52.12,0:13:54.87,Default,,0,0,0,,Жүр, бір шетінен екіншісіне дейін тыңдайық па?
Dialogue: 0,0:13:55.25,0:13:56.16,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:13:56.33,0:13:58.29,Default,,0,0,0,,Сөйлесу оңай болып көрінетінін таңдаңыз.
Dialogue: 0,0:13:58.50,0:14:00.21,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:14:04.96,0:14:06.76,Default,,0,0,0,,Жолдан шығыңыз.
Dialogue: 0,0:14:06.84,0:14:07.68,Default,,0,0,0,,Ит пе?
Dialogue: 0,0:14:07.76,0:14:10.76,Default,,0,0,0,,Тынш! Бұл жай ғана ит. Бұл ит емес.
Dialogue: 0,0:14:11.89,0:14:16.60,Default,,0,0,0,,Иә? Сізде бейтаныс бет бар. Қайдан келдің?
Dialogue: 0,0:14:16.68,0:14:18.19,Default,,0,0,0,,Иә? мм...
Dialogue: 0,0:14:18.39,0:14:19.35,Default,,0,0,0,,Токио
Dialogue: 0,0:14:19.44,0:14:20.73,Default,,0,0,0,,Токио?
Dialogue: 0,0:14:21.36,0:14:22.52,Default,,0,0,0,,Білмеймін.
Dialogue: 0,0:14:22.61,0:14:23.44,Default,,0,0,0,,
Dialogue: 0,0:14:23.52,0:14:24.94,Default,,0,0,0,,Алкогольді ішу
Dialogue: 0,0:14:25.61,0:14:26.78,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:14:27.11,0:14:29.91,Default,,0,0,0,,Айтпақшы, сіз оқиғаны естігіңіз келеді, солай ма?
Dialogue: 0,0:14:30.53,0:14:31.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:31.45,0:14:32.91,Default,,0,0,0,,Иә, сөзсіз!
Dialogue: 0,0:14:32.99,0:14:35.16,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:14:39.96,0:14:44.04,Default,,0,0,0,,Менің батырлық ертегілерімді естігім келгені жақсы.
Dialogue: 0,0:14:44.13,0:14:45.30,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:14:45.38,0:14:46.21,Default,,0,0,0,,Жоқ
Dialogue: 0,0:14:46.84,0:14:49.34,Default,,0,0,0,,200 жаудың алдында
Dialogue: 0,0:14:49.43,0:14:52.51,Default,,0,0,0,,Менде бір ғана шайқас балтасы бар...
Dialogue: 0,0:14:57.81,0:14:58.73,Default,,0,0,0,,Қышқыл
Dialogue: 0,0:14:58.81,0:15:00.98,Default,,0,0,0,,Біз біреуді іздеп жатырмыз.
Dialogue: 0,0:15:04.32,0:15:04.86,Default,,0,0,0,,Кім?
Dialogue: 0,0:15:04.94,0:15:07.65,Default,,0,0,0,,Кім... қалай айтайын...
Dialogue: 0,0:15:07.94,0:15:09.99,Default,,0,0,0,,Мен Котона есімді әйелмін.
Dialogue: 0,0:15:10.07,0:15:11.07,Default,,0,0,0,,қуыршақтай киімінен мүлде алшақ еді—
Dialogue: 0,0:15:11.49,0:15:14.41,Default,,0,0,0,,Екеуің, бәйбішелер.
Dialogue: 0,0:15:14.83,0:15:15.99,Default,,0,0,0,,Не болып жатыр өзі?
Dialogue: 0,0:15:16.24,0:15:17.87,Default,,0,0,0,,Сіздің бөксеңіз жақсы ма?
Dialogue: 0,0:15:18.66,0:15:23.04,Default,,0,0,0,,Жарайды, Котона деген әдемі есегі бар қыз.
Dialogue: 0,0:15:23.21,0:15:24.96,Default,,0,0,0,,Бірге іздейміз.
Dialogue: 0,0:15:25.34,0:15:26.25,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:15:26.34,0:15:29.26,Default,,0,0,0,,...Ал ол әйел қандай адам?
Dialogue: 0,0:15:29.67,0:15:32.59,Default,,0,0,0,,Оның шашы иығына оралып, нәзік көрінеді.
Dialogue: 0,0:15:32.89,0:15:34.30,Default,,0,0,0,,Көздер айтарлықтай үлкен
Dialogue: 0,0:15:34.47,0:15:36.18,Default,,0,0,0,,Сіз осылай түсінесіз!
Dialogue: 0,0:15:36.26,0:15:39.06,Default,,0,0,0,,Нәсіл немесе көздің түсі Жылдар өткен соң
Dialogue: 0,0:15:39.56,0:15:41.02,Default,,0,0,0,,Менің жасым 17-ге таяп қалды
Dialogue: 0,0:15:41.19,0:15:44.61,Default,,0,0,0,,17! Эй, тамақ ішетін уақыт емес пе?
Dialogue: 0,0:15:44.69,0:15:46.02,Default,,0,0,0,,Бұл тартымды.
Dialogue: 0,0:15:46.11,0:15:47.86,Default,,0,0,0,,17 No...
Dialogue: 0,0:15:47.98,0:15:50.53,Default,,0,0,0,,Аша ханшайым сияқты емес пе?
Dialogue: 0,0:15:50.65,0:15:51.65,Default,,0,0,0,,Аша ханшайымы?
Dialogue: 0,0:15:52.32,0:15:55.28,Default,,0,0,0,,Жақында менің 17-ші туған күнім болады.
Dialogue: 0,0:15:55.74,0:15:59.16,Default,,0,0,0,,Сен өте тез есейдің.
Dialogue: 0,0:15:59.24,0:16:01.50,Default,,0,0,0,,Сен әдемі болып кеттің.
Dialogue: 0,0:16:02.08,0:16:03.04,Default,,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,0:16:04.83,0:16:05.83,Default,,0,0,0,,Котона
Dialogue: 0,0:16:05.92,0:16:06.88,Default,,0,0,0,,Табылды
Dialogue: 0,0:16:07.29,0:16:09.30,Default,,0,0,0,,Бірақ бұл Аша ханшайым.
Dialogue: 0,0:16:09.46,0:16:11.13,Default,,0,0,0,,Котона ханшайым ма?
Dialogue: 0,0:16:11.30,0:16:12.17,Default,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:16:12.88,0:16:14.80,Default,,0,0,0,,Мына ханшайым қазір қайда?
Dialogue: 0,0:16:14.89,0:16:16.35,Default,,0,0,0,,Бұл құлып, солай ма?
Dialogue: 0,0:16:16.60,0:16:17.51,Default,,0,0,0,,Қамал дегеніміз не?
Dialogue: 0,0:16:17.60,0:16:18.68,Default,,0,0,0,,Қайда?
Dialogue: 0,0:16:18.76,0:16:21.64,Default,,0,0,0,,Шық, солтүстікке бар, оны бәрі біледі.
Dialogue: 0,0:16:23.14,0:16:24.23,Default,,0,0,0,,Ха... болды.
Dialogue: 0,0:16:24.31,0:16:25.15,Default,,0,0,0,,Жүгір!
Dialogue: 0,0:16:27.31,0:16:30.11,Default,,0,0,0,,Бірақ неге Котона ханшайым?
Dialogue: 0,0:16:30.53,0:16:34.11,Default,,0,0,0,,Бұл дүниеге келгенде, рұқсатсыз рөл беріледі ме?
Dialogue: 0,0:16:34.57,0:16:37.57,Default,,0,0,0,,Сонда біз А және В қала тұрғындарымыз ба?
Dialogue: 0,0:16:38.33,0:16:41.41,Default,,0,0,0,,Бірақ бұл шынымен Котона ма...
Dialogue: 0,0:16:41.75,0:16:43.12,Default,,0,0,0,,Біз кездескен кезде түсінесіз
Dialogue: 0,0:16:43.83,0:16:47.00,Default,,0,0,0,,Қазіргі уақытта қамал ерекше дайындықта.
Dialogue: 0,0:16:47.42,0:16:50.17,Default,,0,0,0,,Патша бұйырмайынша кірме.
Dialogue: 0,0:16:51.34,0:16:54.26,Default,,0,0,0,,Мм... Аша ханшайымды көруге келдік.
Dialogue: 0,0:16:55.01,0:16:56.76,Default,,0,0,0,,Сіз кімсіз? сендер жігіттер
Dialogue: 0,0:16:59.18,0:17:00.97,Default,,0,0,0,,Қала тұрғындары А және В
Dialogue: 0,0:17:01.06,0:17:02.52,Default,,0,0,0,,Қала тұрғындарының атмосферасы...
Dialogue: 0,0:17:02.60,0:17:05.48,Default,,0,0,0,,Ханшайыммен кездесуге мүмкіндік болмаса да, үйге қайт.
Dialogue: 0,0:17:16.41,0:17:18.37,Default,,0,0,0,,Капитан Велса, еңбегіңіз үшін рахмет.
Dialogue: 0,0:17:21.29,0:17:22.58,Default,,0,0,0,,Versa осында.
Dialogue: 0,0:17:23.70,0:17:24.54,Default,,0,0,0,,Стис ауданы арқылы өтіп бара жатып,
Dialogue: 0,0:17:29.21,0:17:31.38,Default,,0,0,0,,Мен ханшайымның кенет өзгергенін естідім.
Dialogue: 0,0:17:31.71,0:17:32.71,Default,,0,0,0,,О
Dialogue: 0,0:17:33.38,0:17:34.51,Default,,0,0,0,,Өте жақсы емес
Dialogue: 0,0:17:35.72,0:17:37.26,Default,,0,0,0,,Сіз ештеңе істей алмайсыз ба?
Dialogue: 0,0:17:37.43,0:17:38.84,Default,,0,0,0,,Біз не істей аламыз
Dialogue: 0,0:17:38.93,0:17:41.39,Default,,0,0,0,,Тек сақтығыңызды түсірмеуге тырысыңыз.
Dialogue: 0,0:17:41.56,0:17:42.22,Default,,0,0,0,,О
Dialogue: 0,0:17:45.56,0:17:48.60,Default,,0,0,0,,Патшалықтың ең жақсы емшілері де қасық лақтырады.
Dialogue: 0,0:17:49.31,0:17:50.94,Default,,0,0,0,,Күшті қарғыс дегеніміз не?
Dialogue: 0,0:17:51.44,0:17:53.61,Default,,0,0,0,,Бірақ ханшайымды ренжіткендер
Dialogue: 0,0:17:53.69,0:17:55.82,Default,,0,0,0,,Бірдей сыйлық алу керек
Dialogue: 0,0:17:56.03,0:17:59.32,Default,,0,0,0,,Корольдік отбасының қорғанысымен де жойылатын қарғыс.
Dialogue: 0,0:17:59.49,0:18:01.24,Default,,0,0,0,,Мүлдем түсініксіз
Dialogue: 0,0:18:01.83,0:18:05.79,Default,,0,0,0,,Сиқырлы премьер-министр Йоки Генийдің өзі көтере алмайтын қарғыс қандай?
Dialogue: 0,0:18:06.04,0:18:08.21,Default,,0,0,0,,Бұл қаншалықты қорқынышты?
Dialogue: 0,0:18:08.87,0:18:10.58,Default,,0,0,0,,Фугаинану
Dialogue: 0,0:18:10.96,0:18:13.88,Default,,0,0,0,,Жаман болма, мен қолымнан келгенін істеп жатырмын.
Dialogue: 0,0:18:13.96,0:18:17.63,Default,,0,0,0,,Бартон Бұл қарғыс ерекше.
Dialogue: 0,0:18:17.76,0:18:18.88,Default,,0,0,0,,Йоки кінәлі емес
Dialogue: 0,0:18:19.68,0:18:20.51,Default,,0,0,0,,Ха...
Dialogue: 0,0:18:20.76,0:18:23.18,Default,,0,0,0,,Жақында дәрігер Джирагтың командасы келеді.
Dialogue: 0,0:18:23.72,0:18:25.39,Default,,0,0,0,,Қарғыстарды жоюға қатысты -
Dialogue: 0,0:18:25.68,0:18:27.77,Default,,0,0,0,,Оларға ешкім қарсы тұра алмайды.
Dialogue: 0,0:18:28.69,0:18:30.56,Default,,0,0,0,,Оған сеніңіз, Мәртебелі.
Dialogue: 0,0:18:37.36,0:18:39.03,Default,,0,0,0,,Джираг дәрігерлер тобы
Dialogue: 0,0:18:39.49,0:18:42.07,Default,,0,0,0,,Маған Аша ханшайыммен кездесуге рұқсат етілді.
Dialogue: 0,0:18:42.24,0:18:43.12,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:18:46.50,0:18:48.58,Default,,0,0,0,,Күте тұрыңыз, мұнда сақ болыңыз ...
Dialogue: 0,0:18:48.87,0:18:49.75,Default,,0,0,0,,Жүр! Эй
Dialogue: 0,0:19:08.85,0:19:12.56,Default,,0,0,0,,А... мысық мүсіні? Бұл патшаның хоббиі ме?
Dialogue: 0,0:19:12.98,0:19:15.11,Default,,0,0,0,,Бұл дүниеде ол ұлы адам ма?
Dialogue: 0,0:19:15.23,0:19:17.82,Default,,0,0,0,,Хаха... Жануарлар әлемі сияқты.
Dialogue: 0,0:19:17.90,0:19:18.69,Default,,0,0,0,,Ха…
Dialogue: 0,0:19:52.73,0:19:55.15,Default,,0,0,0,,Келгеніңіз үшін рахмет.
Dialogue: 0,0:19:55.48,0:19:57.15,Default,,0,0,0,,Егер сіз ханшайымға көмектессеңіз...
Dialogue: 0,0:19:57.40,0:20:00.61,Default,,0,0,0,,Патша сізге ең жоғары дәрежелі сыйлық береді.
Dialogue: 0,0:20:01.03,0:20:02.40,Default,,0,0,0,,Мен оны жақын арада күтемін.
Dialogue: 0,0:20:02.49,0:20:03.53,Default,,0,0,0,,Хаха
Dialogue: 0,0:20:09.83,0:20:11.91,Default,,0,0,0,,Ах... Котона
Dialogue: 0,0:20:12.50,0:20:14.92,Default,,0,0,0,,Бұл, әрине, Котона.
Dialogue: 0,0:20:24.97,0:20:26.05,Default,,0,0,0,,бастайық
Dialogue: 0,0:20:27.22,0:20:31.27,Default,,0,0,0,,Хараимасуён
Dialogue: 0,0:20:32.18,0:20:36.48,Default,,0,0,0,,Итаино Итаино Тондаекейон
Dialogue: 0,0:20:37.40,0:20:40.94,Default,,0,0,0,,Курои Норой Ракушойон
Dialogue: 0,0:20:42.78,0:20:47.03,Default,,0,0,0,,Ширё Акрио Йоюудезеон
Dialogue: 0,0:20:48.28,0:20:50.20,Default,,0,0,0,,Фин Холли
Dialogue: 0,0:20:51.04,0:20:52.54,Default,,0,0,0,,Фин Холли
Dialogue: 0,0:20:54.54,0:20:55.46,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:20:56.54,0:20:57.71,Default,,0,0,0,,Махаббат та, махаббатсыз неке де
Dialogue: 0,0:20:57.79,0:20:58.96,Default,,0,0,0,,Өтінемін, мені құтқарыңыз
Dialogue: 0,0:20:59.38,0:21:01.21,Default,,0,0,0,,Су Ха
Dialogue: 0,0:21:03.42,0:21:04.42,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:07.68,0:21:10.64,Default,,0,0,0,,Не... нені айтып тұрсың?
Dialogue: 0,0:21:10.72,0:21:14.39,Default,,0,0,0,,Уф... уф... Уау
Dialogue: 0,0:21:18.11,0:21:20.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:21.07,0:21:21.98,Default,,0,0,0,,Ханшайым…
Dialogue: 0,0:21:26.57,0:21:29.41,Default,,0,0,0,,Бұл нені білдіреді...
Dialogue: 0,0:21:31.03,0:21:31.87,Default,,0,0,0,,Мәртебелі
Dialogue: 0,0:21:31.95,0:21:33.95,Default,,0,0,0,,Патша нық
Dialogue: 0,0:21:34.37,0:21:35.71,Default,,0,0,0,,Мен шаршадым.
Dialogue: 0,0:21:36.08,0:21:38.63,Default,,0,0,0,,Бартон Мен Мәртебелі мырзаны бөлмесіне апарамын.
Dialogue: 0,0:21:38.71,0:21:39.54,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:21:50.01,0:21:50.85,Default,,0,0,0,,Котона
Dialogue: 0,0:21:51.51,0:21:53.22,Default,,0,0,0,,Менің ойымша, бұл сәл басқаша.
Dialogue: 0,0:21:53.35,0:21:54.64,Default,,0,0,0,,Бұл шындық болуы мүмкін емес.
Dialogue: 0,0:21:54.77,0:21:57.19,Default,,0,0,0,,Бұл жігіт Котона болмаса, ол кім?
Dialogue: 0,0:21:57.56,0:21:58.40,Default,,0,0,0,,Бұл жерде тақды шарлатанға тапсыратын орын да емес қой, иә?
Dialogue: 0,0:21:58.98,0:22:00.02,Default,,0,0,0,,Маған көмек керек
Dialogue: 0,0:22:02.69,0:22:04.36,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:22:10.82,0:22:11.66,Default,,0,0,0,,Не?
Dialogue: 0,0:22:13.49,0:22:15.41,Default,,0,0,0,,Нашар! Хару, кет.
Dialogue: 0,0:22:15.54,0:22:16.37,Default,,0,0,0,,Уау
Dialogue: 0,0:22:17.79,0:22:18.92,Default,,0,0,0,,Бұл кім? үйреншікті адам
Dialogue: 0,0:22:28.13,0:22:29.72,Default,,0,0,0,,Юу, сен...
Dialogue: 0,0:22:30.93,0:22:32.68,Default,,0,0,0,,Балалар! Ханшайым!
Dialogue: 0,0:22:33.47,0:22:35.93,Default,,0,0,0,,Ханшайымнан аулақ жүр, ха...
Dialogue: 0,0:22:38.52,0:22:42.73,Default,,0,0,0,,Ой... уау
Dialogue: 0,0:22:46.03,0:22:46.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:50.70,0:22:52.37,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:22:54.03,0:22:55.33,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:23:01.25,0:23:02.75,Default,,0,0,0,,Я...
Dialogue: 0,0:23:07.67,0:23:10.34,Default,,0,0,0,,Балалар сендер ханшайымға не істедіңдер?
Dialogue: 0,0:23:17.31,0:23:19.89,Default,,0,0,0,,Сендер кімсіңдер, бейбақтар?
Dialogue: 0,0:23:20.39,0:23:22.48,Default,,0,0,0,,Мен Юумын, бұл жігіт Хару
Dialogue: 0,0:23:22.60,0:23:25.52,Default,,0,0,0,,Жібер, біз ештеңе істеген жоқпыз.
Dialogue: 0,0:23:25.61,0:23:27.90,Default,,0,0,0,,Сен ханшайымның бөлмесінде не істеп жаттың?
Dialogue: 0,0:23:28.19,0:23:29.90,Default,,0,0,0,,Мен дос іздедім.
Dialogue: 0,0:23:30.24,0:23:32.41,Default,,0,0,0,,Өйткені ханшайым досына дәл ұқсайды...
Dialogue: 0,0:23:32.49,0:23:33.78,Default,,0,0,0,,Мен сені жаңа ғана көруге келдім.
Dialogue: 0,0:23:34.57,0:23:36.91,Default,,0,0,0,,Мағынасы жоқ не айтып тұрсың?
Dialogue: 0,0:23:36.99,0:23:40.41,Default,,0,0,0,,Мына Ю ханшайымға қадалған қанжарды суырып алды.
Dialogue: 0,0:23:40.50,0:23:41.37,Default,,0,0,0,,Хо…
Dialogue: 0,0:23:42.00,0:23:45.17,Default,,0,0,0,,Егер өтірік айтатын болсаңыз, жақсырақ өтірік айтыңыз.
Dialogue: 0,0:23:45.25,0:23:47.75,Default,,0,0,0,,Мәртебелі ханшайымның қауіпсіздігіне қаншалықты алаңдаса да...
Dialogue: 0,0:23:47.84,0:23:49.67,Default,,0,0,0,,Әке А...
Dialogue: 0,0:23:51.01,0:23:53.01,Default,,0,0,0,,Олардың айтқандары шындық
Dialogue: 0,0:23:53.09,0:23:53.93,Default,,0,0,0,,Ханшайым!
Dialogue: 0,0:23:54.01,0:23:56.64,Default,,0,0,0,,Жоқ! Аша
Dialogue: 0,0:23:57.56,0:23:58.77,Default,,0,0,0,,Әке!
Dialogue: 0,0:23:59.31,0:24:01.31,Default,,0,0,0,,Аша (Аша) Әкесі
Dialogue: 0,0:24:02.56,0:24:04.60,Default,,0,0,0,,Сонда қарғыс жойылды ма?
Dialogue: 0,0:24:04.90,0:24:06.77,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:24:08.53,0:24:12.49,Default,,0,0,0,,Расында, мен де бұл кісілердің әрекетіне куә болдым.
Dialogue: 0,0:24:12.90,0:24:16.12,Default,,0,0,0,,Бұл бір ғажап, бәрі қалпына келді.
Dialogue: 0,0:24:16.58,0:24:18.87,Default,,0,0,0,,Бейбақтан алыс, Батыр.
Dialogue: 0,0:24:33.43,0:24:34.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:36.01,0:24:36.93,Default,,0,0,0,,Неге...
Dialogue: 0,0:24:43.69,0:24:46.73,Default,,0,0,0,,Мәртебелі, осы адамдардың еңбегі үшін...
Dialogue: 0,0:24:47.02,0:24:49.94,Default,,0,0,0,,Мен лайықты құрмет болуы керек деп есептеймін.
Dialogue: 0,0:24:50.86,0:24:51.69,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:24:52.44,0:24:55.03,Default,,0,0,0,,Олар сыйлық алсын
Dialogue: 0,0:24:55.61,0:24:56.66,Default,,0,0,0,,Сыйақы?
Dialogue: 0,0:24:56.74,0:24:59.66,Default,,0,0,0,,Енді мені шеш.
Dialogue: 0,0:25:06.21,0:25:10.00,Default,,0,0,0,,Котона... Сіз Котонасыз, солай ма?
Dialogue: 0,0:25:10.75,0:25:11.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:23.35,0:25:25.52,Default,,0,0,0,,Бүгін жарайсыңдар, ханшайымды құтқардыңдар.
Dialogue: 0,0:25:26.06,0:25:29.48,Default,,0,0,0,,Менің жігіттерім сені қалаға апарады. Үйге оралғанда абай болыңыз.
Dialogue: 0,0:25:33.24,0:25:35.28,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:25:36.99,0:25:39.70,Default,,0,0,0,,Бұл адам әйтеуір Саки-ниге ұқсайды.
Dialogue: 0,0:25:40.78,0:25:42.04,Default,,0,0,0,,Хмм.
Dialogue: 0,0:25:44.79,0:25:47.29,Default,,0,0,0,,Ах! Сіз бұрынғы қала тұрғындарысыз.
Dialogue: 0,0:25:47.37,0:25:50.67,Default,,0,0,0,,Аша ханшайымды құтқарғандар тыйылсын.
Dialogue: 0,0:25:50.84,0:25:53.42,Default,,0,0,0,,Иә? Ха ха!
Dialogue: 0,0:26:03.18,0:26:04.43,Default,,0,0,0,,Сол жігіттер де
Dialogue: 0,0:26:06.06,0:26:07.02,Default,,0,0,0,,Хакуба емес пе?
Dialogue: 0,0:26:07.10,0:26:09.23,Default,,0,0,0,,Оны сізге қатардағы жауынгерлер жіберді ме?
Dialogue: 0,0:26:09.77,0:26:11.31,Default,,0,0,0,,Мен Аша ханшайыммен таныстым.
Dialogue: 0,0:26:11.77,0:26:13.69,Default,,0,0,0,,Не?
Dialogue: 0,0:26:19.24,0:26:21.28,Default,,0,0,0,,Бұл сенің огориң.
Dialogue: 0,0:26:22.62,0:26:23.62,Default,,0,0,0,,Хехе...
Dialogue: 0,0:26:26.45,0:26:28.29,Default,,0,0,0,,Ханшайым Котона емес еді
Dialogue: 0,0:26:29.71,0:26:30.75,Default,,0,0,0,,Иә
Dialogue: 0,0:26:31.59,0:26:35.30,Default,,0,0,0,,Мен сіз білетін адамға ұқсаймын.
Dialogue: 0,0:26:35.76,0:26:37.55,Default,,0,0,0,,Мен сенімен танысқым келеді.
Dialogue: 0,0:26:40.39,0:26:42.39,Default,,0,0,0,,Котона қайда?
Dialogue: 0,0:26:42.80,0:26:44.68,Default,,0,0,0,,Енді қайда қарауым керек?
Dialogue: 0,0:26:44.89,0:26:48.85,Default,,0,0,0,,Дұрыс, мен әлі де сол ханшайымға қызығамын.
Dialogue: 0,0:26:49.44,0:26:50.69,Default,,0,0,0,,Бұл не, Ю?
Dialogue: 0,0:26:51.06,0:26:53.19,Default,,0,0,0,,Котонаны іздеу керек емес пе еді?
Dialogue: 0,0:26:54.02,0:26:57.65,Default,,0,0,0,,Иә, бірақ мен келісе алмайтын бір нәрсе бар.
Dialogue: 0,0:26:58.32,0:27:00.66,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:27:01.16,0:27:03.24,Default,,0,0,0,,Бұл қалай мүмкін болды?
Dialogue: 0,0:27:09.12,0:27:12.13,Default,,0,0,0,,Мен білмеймін. Менің денем өздігінен қозғалды.
Dialogue: 0,0:27:12.71,0:27:14.84,Default,,0,0,0,,Мен жақындасам да ештеңе болмады.
Dialogue: 0,0:27:16.59,0:27:18.01,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:27:20.09,0:27:22.39,Default,,0,0,0,,Бұл арман болуы керек, иә?
Dialogue: 0,0:27:27.60,0:27:29.35,Default,,0,0,0,,Неғұрлым тез оянсаңыз, соғұрлым жақсы.
Dialogue: 0,0:27:29.98,0:27:31.52,Default,,0,0,0,,Сондай балалық арман
Dialogue: 0,0:27:32.40,0:27:34.77,Default,,0,0,0,,Бұл арман ба...
Dialogue: 0,0:27:36.48,0:27:37.86,Default,,0,0,0,,Мен де сыйлық алдым.
Dialogue: 0,0:27:38.36,0:27:40.15,Default,,0,0,0,,Түс болса, бұл бірдеңені білдіреді ме?
Dialogue: 0,0:27:40.70,0:27:43.24,Default,,0,0,0,,Ал, оянғанша көңіл көтерейік.
Dialogue: 0,0:27:43.32,0:27:44.87,Default,,0,0,0,,Хал, күте тұрыңыз.
Dialogue: 0,0:27:44.95,0:27:46.28,Default,,0,0,0,,Жақсы, жақсы, жақсы.
Dialogue: 0,0:27:46.37,0:27:48.95,Default,,0,0,0,,(Жалдамалыларды қолдау)
Dialogue: 0,0:27:49.70,0:27:53.21,Default,,0,0,0,,Шаршадыңыз ба? Бүгін түнде осында болыңыз
Dialogue: 0,0:27:53.75,0:27:56.71,Default,,0,0,0,,Бұл қоймадағы төсек, бірақ сен жассың ғой, жарайды, солай ма?
Dialogue: 0,0:27:57.25,0:27:58.25,Default,,0,0,0,,Иә
Dialogue: 0,0:27:58.59,0:28:01.80,Default,,0,0,0,,Мен достарыңа кейінірек айтамын.
Dialogue: 0,0:28:02.43,0:28:05.93,Default,,0,0,0,,Алдыңғы баспалдақпен көтерілген кезде құлып ашылады.
Dialogue: 0,0:28:11.35,0:28:12.19,Default,,0,0,0,,Фу…
Dialogue: 0,0:28:37.46,0:28:38.71,Default,,0,0,0,,(жылау)
Dialogue: 0,0:28:38.80,0:28:41.84,Default,,0,0,0,,(айқай)
Dialogue: 0,0:28:43.68,0:28:44.55,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:28:45.14,0:28:49.64,Default,,0,0,0,,Хару Маған өте қызық.
Dialogue: 0,0:28:54.89,0:28:55.81,Default,,0,0,0,,Қайырлы кеш
Dialogue: 0,0:28:56.60,0:28:58.27,Default,,0,0,0,,Жоғарыда айтылған батырлар залы
Dialogue: 0,0:28:58.36,0:28:59.19,Default,,0,0,0,,Иә
Dialogue: 0,0:29:00.32,0:29:03.11,Default,,0,0,0,,Кешіріңіз, мен сарайға бірдеңе қалдырдым.
Dialogue: 0,0:29:17.38,0:29:19.38,Default,,0,0,0,,(айқай)
Dialogue: 0,0:29:30.64,0:29:32.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:29:32.97,0:29:34.77,Default,,0,0,0,,Хехе... Еркін жігіт екен.
Dialogue: 0,0:29:40.32,0:29:42.40,Default,,0,0,0,,Мен қазір баруым керек пе?
Dialogue: 0,0:29:42.48,0:29:44.86,Default,,0,0,0,,Бұл сіздің жеке қорғанысыңыз үшін.
Dialogue: 0,0:29:44.94,0:29:47.03,Default,,0,0,0,,Неше рет айту керек?
Dialogue: 0,0:29:48.11,0:29:50.95,Default,,0,0,0,,Ұлы мәртебелі сізді бүгін кешке міндетті түрде менімен бірге алып кетеді.
Dialogue: 0,0:29:51.03,0:29:52.41,Default,,0,0,0,,Бұл сұралды
Dialogue: 0,0:29:52.95,0:29:55.25,Default,,0,0,0,,Менің ұстанымымды да ескеріңіз.
Dialogue: 0,0:29:55.33,0:29:58.04,Default,,0,0,0,,Өйткені амортизатормен барғанда шу шығады.
Dialogue: 0,0:29:58.50,0:30:00.17,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:30:03.59,0:30:05.80,Default,,0,0,0,,Хэхе... Аха...
Dialogue: 0,0:30:05.88,0:30:08.05,Default,,0,0,0,,Қараңызшы, мен қазірдің өзінде өте жігерлімін.
Dialogue: 0,0:30:09.84,0:30:12.68,Default,,0,0,0,,Осыдан кейін мен сүйікті қышқыл апельсинді жедім...
Dialogue: 0,0:30:12.76,0:30:14.22,Default,,0,0,0,,Бұл сергітетін қалпына келтіру.
Dialogue: 0,0:30:15.60,0:30:16.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:18.77,0:30:22.57,Default,,0,0,0,,Қышқыл апельсин? Котона сияқты
Dialogue: 0,0:30:26.36,0:30:27.99,Default,,0,0,0,,А... кім?
Dialogue: 0,0:30:32.95,0:30:33.79,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:30:38.71,0:30:40.79,Default,,0,0,0,,Бұрынғы Батыр Холл
Dialogue: 0,0:30:40.96,0:30:42.13,Default,,0,0,0,,Сіздің атыңыз Юу болды ма?
Dialogue: 0,0:30:42.59,0:30:43.63,Default,,0,0,0,,А... иә
Dialogue: 0,0:30:44.13,0:30:47.09,Default,,0,0,0,,Мм... Мен сіздің жағдайыңызға алаңдадым.
Dialogue: 0,0:30:47.47,0:30:48.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:58.56,0:31:00.35,Default,,0,0,0,,Кенеттен болғаны үшін кешіріңіз.
Dialogue: 0,0:31:00.81,0:31:04.15,Default,,0,0,0,,Жарайды, мен де біреумен сөйлескім келді.
Dialogue: 0,0:31:04.27,0:31:05.65,Default,,0,0,0,,Мацуда: Бұл ойын-сауық емес.
Dialogue: 0,0:31:06.28,0:31:08.53,Default,,0,0,0,,Ал, мен не айтуым керек?
Dialogue: 0,0:31:09.11,0:31:11.36,Default,,0,0,0,,Ханшайым да қарапайым қыз.
Dialogue: 0,0:31:12.41,0:31:15.33,Default,,0,0,0,,Негізі, мен ханшайым сияқты әрекет етуге жарамсызмын.
Dialogue: 0,0:31:15.45,0:31:17.66,Default,,0,0,0,,Айналада адам жоқта солай көрінеді.
Dialogue: 0,0:31:25.09,0:31:27.80,Default,,0,0,0,,Эй, Тонтеки, кеттік.
Dialogue: 0,0:31:28.38,0:31:29.22,Default,,0,0,0,,Иә!
Dialogue: 0,0:31:30.17,0:31:31.01,Default,,0,0,0,,Я...
Dialogue: 0,0:31:32.14,0:31:33.64,Default,,0,0,0,,Барлық дайындықтар
Dialogue: 0,0:31:35.01,0:31:37.14,Default,,0,0,0,,Мынау, Батыр-доно.
Dialogue: 0,0:31:37.64,0:31:38.64,Default,,0,0,0,,Мен сізге көлік бере аламын ба?
Dialogue: 0,0:31:38.73,0:31:41.94,Default,,0,0,0,,Жарайды, ханшайым бәрібір барғысы келді.
Dialogue: 0,0:31:42.02,0:31:44.52,Default,,0,0,0,,Отырыңыз.
Dialogue: 0,0:31:49.65,0:31:53.07,Default,,0,0,0,,Бұдан былай ханшайымның денесінде қалған зұлым рухтардан арылу.
Dialogue: 0,0:31:53.16,0:31:55.83,Default,,0,0,0,,Тазару көліне жүзіңіз!
Dialogue: 0,0:32:01.79,0:32:02.71,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:32:02.79,0:32:04.96,Default,,0,0,0,,Жақсы ұшу
Dialogue: 0,0:32:05.42,0:32:06.92,Default,,0,0,0,,Иә? Ұшу керек пе?
Dialogue: 0,0:32:07.30,0:32:09.21,Default,,0,0,0,,Уау Уау...
Dialogue: 0,0:32:15.55,0:32:17.06,Default,,0,0,0,,Ол ұшады ма?
Dialogue: 0,0:32:55.72,0:32:56.89,Default,,0,0,0,,Котона…
Dialogue: 0,0:32:57.93,0:32:59.64,Default,,0,0,0,,Иә? Ах...
Dialogue: 0,0:33:00.72,0:33:03.27,Default,,0,0,0,,Жел бізді қарсы алады
Dialogue: 0,0:33:04.85,0:33:05.69,Default,,0,0,0,,Иә
Dialogue: 0,0:33:23.29,0:33:24.33,Default,,0,0,0,,Сол құс
Dialogue: 0,0:33:25.04,0:33:27.21,Default,,0,0,0,,Кезінде батырға қызмет еткен деседі.
Dialogue: 0,0:33:27.29,0:33:28.71,Default,,0,0,0,,Игнаро құсы
Dialogue: 0,0:33:29.38,0:33:32.17,Default,,0,0,0,,Көпшілік алдына шығу сирек кездеседі.
Dialogue: 0,0:33:49.44,0:33:51.32,Default,,0,0,0,,(Игнароның айқайы)
Dialogue: 0,0:33:58.53,0:34:00.24,Default,,0,0,0,,Осылайша, абай болыңыз.
Dialogue: 0,0:34:00.32,0:34:01.49,Default,,0,0,0,,А... иә
Dialogue: 0,0:34:21.43,0:34:22.39,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:34:25.39,0:34:26.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:34:30.94,0:34:34.28,Default,,0,0,0,,Ханшайым, егер сіз сиқырлы мөр биін дұрыс билесеңіз...
Dialogue: 0,0:34:34.36,0:34:36.82,Default,,0,0,0,,Ол зұлым рухтардан қорғай алады.
Dialogue: 0,0:34:37.24,0:34:38.24,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:35:53.60,0:35:56.36,Default,,0,0,0,,Мен жаттығудағыдай жақсы билей алдым.
Dialogue: 0,0:35:56.44,0:35:58.65,Default,,0,0,0,,Хэхе... Рахмет Дампа
Dialogue: 0,0:35:59.61,0:36:02.91,Default,,0,0,0,,Енді мен зұлым рухтардан құтылу үшін мацерима жапырақтарын теремін.
Dialogue: 0,0:36:03.16,0:36:04.28,Default,,0,0,0,,Ей, оян.
Dialogue: 0,0:36:06.03,0:36:08.04,Default,,0,0,0,,Хару айтып отырған Котона-сан
Dialogue: 0,0:36:08.70,0:36:10.54,Default,,0,0,0,,Маған қатты ұқсайсың ба?
Dialogue: 0,0:36:11.00,0:36:14.79,Default,,0,0,0,,Иә, ерік-жігері күшті немесе қышқыл апельсинді ұнататын сияқты.
Dialogue: 0,0:36:15.71,0:36:17.00,Default,,0,0,0,,Айырмашылығы -
Dialogue: 0,0:36:18.05,0:36:19.76,Default,,0,0,0,,Котона - Харудың...
Dialogue: 0,0:36:20.84,0:36:21.72,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:36:22.13,0:36:24.26,Default,,0,0,0,,Юуға Котона-сан ұнайды.
Dialogue: 0,0:36:24.34,0:36:25.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:25.51,0:36:28.01,Default,,0,0,0,,Жоқ, олай емес...
Dialogue: 0,0:36:28.10,0:36:30.10,Default,,0,0,0,,Котона да ханшайым ма?
Dialogue: 0,0:36:30.35,0:36:33.02,Default,,0,0,0,,Жоқ, қарапайым орта мектеп оқушысы (Аша)?
Dialogue: 0,0:36:33.52,0:36:36.94,Default,,0,0,0,,Біздің әлемде патшалар да, ханшайымдар да жоқ.
Dialogue: 0,0:36:37.94,0:36:41.15,Default,,0,0,0,,Өйткені, сен басқа әлемненсің ғой.
Dialogue: 0,0:36:41.36,0:36:42.28,Default,,0,0,0,,Иә
Dialogue: 0,0:36:44.11,0:36:46.45,Default,,0,0,0,,Біздің әлем «Ни но Куни» және...
Dialogue: 0,0:36:46.82,0:36:49.20,Default,,0,0,0,,«Ичинокуни» бір монетаның екі жағы ретінде бар
Dialogue: 0,0:36:50.66,0:36:53.79,Default,,0,0,0,,Екі дүние бір жерде байланысқан
Dialogue: 0,0:36:54.58,0:36:55.50,Default,,0,0,0,,Иә
Dialogue: 0,0:36:56.04,0:36:58.92,Default,,0,0,0,,Ичинокуни туралы аңызды көпшілік біледі.
Dialogue: 0,0:36:59.25,0:37:00.80,Default,,0,0,0,,Оны ешкім көрмеген
Dialogue: 0,0:37:01.55,0:37:03.72,Default,,0,0,0,,Бірақ мұндай дүние шынымен бар болса...
Dialogue: 0,0:37:03.80,0:37:05.18,Default,,0,0,0,,Мен сонда бір рет барғым келеді.
Dialogue: 0,0:37:07.43,0:37:08.64,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:37:08.72,0:37:10.93,Default,,0,0,0,,Оның орнына Котона-сан туралы көбірек айтып беріңізші.
Dialogue: 0,0:37:11.02,0:37:12.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:12.52,0:37:16.19,Default,,0,0,0,,Жарайды... ашық-жарқын адам екен.
Dialogue: 0,0:37:16.73,0:37:19.02,Default,,0,0,0,,Бірақ мен сенің жаныңда болсам, мен өзімді қуаттаймын.
Dialogue: 0,0:37:19.44,0:37:22.44,Default,,0,0,0,,Ах! Дампамен сөйлескенде ол ханшайымға ұқсайды.
Dialogue: 0,0:37:22.90,0:37:24.82,Default,,0,0,0,,Не? Солай ма?
Dialogue: 0,0:37:25.36,0:37:29.24,Default,,0,0,0,,Менде басқаларға беруге күш бар ма?
Dialogue: 0,0:37:29.33,0:37:30.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:31.04,0:37:33.37,Default,,0,0,0,,Кейде өзімді жалғыз сезінемін.
Dialogue: 0,0:37:33.91,0:37:36.33,Default,,0,0,0,,Анам жас кезімде қайтыс болды.
Dialogue: 0,0:37:36.58,0:37:39.09,Default,,0,0,0,,Патша болған әкеңе жұмсақ бола алмайсың.
Dialogue: 0,0:37:39.92,0:37:42.59,Default,,0,0,0,,Мен кешіре алатын жалғыз адам – Дампа.
Dialogue: 0,0:37:43.34,0:37:45.72,Default,,0,0,0,,Бірақ сонша вассал
Dialogue: 0,0:37:46.51,0:37:48.14,Default,,0,0,0,,Маған бәрі жақсы қарайды.
Dialogue: 0,0:37:48.26,0:37:49.10,Default,,0,0,0,,Бірақ бұл...
Dialogue: 0,0:37:49.76,0:37:51.97,Default,,0,0,0,,Ханшайымға деген адалдықтан туындайды.
Dialogue: 0,0:37:52.31,0:37:55.73,Default,,0,0,0,,Бірге күл, жыла, күрес.
Dialogue: 0,0:37:56.19,0:37:58.35,Default,,0,0,0,,Менде ондай адам жоқ.
Dialogue: 0,0:37:58.94,0:38:00.31,Default,,0,0,0,,Ю мен Хару сияқты
Dialogue: 0,0:38:03.36,0:38:05.15,Default,,0,0,0,,Жақсы, Котона мырза.
Dialogue: 0,0:38:07.78,0:38:08.70,Default,,0,0,0,,Юй?
Dialogue: 0,0:38:09.28,0:38:10.70,Default,,0,0,0,,Жүр, мұнда кел!
Dialogue: 0,0:38:11.08,0:38:13.12,Default,,0,0,0,,Ғибадатхана қыз-қызметшісінің киімі оған жарасады.
Dialogue: 0,0:38:16.16,0:38:17.00,Default,,0,0,0,,Ханшайым?
Dialogue: 0,0:38:19.67,0:38:21.42,Default,,0,0,0,,Қараңдар! Бұл жақсы сезінеді
Dialogue: 0,0:38:22.50,0:38:23.34,Default,,0,0,0,,Иә!
Dialogue: 0,0:38:24.76,0:38:25.59,Default,,0,0,0,,Қақпақ…
Dialogue: 0,0:38:27.13,0:38:29.55,Default,,0,0,0,,Ах... хехе...
Dialogue: 0,0:38:30.39,0:38:32.39,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:38:42.36,0:38:45.61,Default,,0,0,0,,Сіз олардың күшін анықтағыңыз келе ме?
Dialogue: 0,0:38:46.19,0:38:49.99,Default,,0,0,0,,Бұл қарғысты бұзған күш ерекше нәрседе жатыр.
Dialogue: 0,0:38:50.07,0:38:53.74,Default,,0,0,0,,Жоқ, ол жастар...
Dialogue: 0,0:38:53.83,0:38:58.00,Default,,0,0,0,,Бұрын Қара ту әскері өлтірушілерді талай рет жіберген.
Dialogue: 0,0:38:58.08,0:39:01.63,Default,,0,0,0,,Олардың жоқтығын кім дәлелдей алады?
Dialogue: 0,0:39:01.71,0:39:04.00,Default,,0,0,0,,Сонда ханшайымды неге құтқардың?
Dialogue: 0,0:39:04.50,0:39:06.09,Default,,0,0,0,,Ұлы мәртебеліге жақындау
Dialogue: 0,0:39:06.80,0:39:07.72,Default,,0,0,0,,Не?
Dialogue: 0,0:39:08.30,0:39:10.47,Default,,0,0,0,,Қара ту армиясы жалдамалыларды шақырады...
Dialogue: 0,0:39:10.55,0:39:13.22,Default,,0,0,0,,Олар көтеріліске дайындалып жатыр деген қауесет бар.
Dialogue: 0,0:39:13.30,0:39:15.93,Default,,0,0,0,,Қаскөйлер бізге сенсін
Dialogue: 0,0:39:16.06,0:39:19.23,Default,,0,0,0,,Сіз соғысқа пайдалы ақпарат алуға тырысасыз ба?
Dialogue: 0,0:39:19.81,0:39:21.48,Default,,0,0,0,,Мен саған бұлай істеуге рұқсат бермеймін.
Dialogue: 0,0:39:21.60,0:39:25.02,Default,,0,0,0,,Мен бұл елді қорғауым керек.
Dialogue: 0,0:39:25.11,0:39:26.73,Default,,0,0,0,,Менің ағам үшін де
Dialogue: 0,0:39:27.49,0:39:30.36,Default,,0,0,0,,Баделонияны жою арқылы бейбітшілікке қол жеткізілді.
Dialogue: 0,0:39:30.49,0:39:33.57,Default,,0,0,0,,Сол күні қанша қан төгілді?
Dialogue: 0,0:39:34.45,0:39:35.74,Default,,0,0,0,,Біз оны қорғауымыз керек.
Dialogue: 0,0:39:36.33,0:39:39.25,Default,,0,0,0,,Мен Seiodia да көңілін қалдырмайтынына сенімдімін.
Dialogue: 0,0:39:53.80,0:39:54.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:56.68,0:39:57.77,Default,,0,0,0,,Сіз ояндыңыз ба?
Dialogue: 0,0:39:58.52,0:40:01.06,Default,,0,0,0,,Сыйлыққа енгізілген тағам өте жақсы болды.
Dialogue: 0,0:40:01.89,0:40:02.81,Default,,0,0,0,,Иә
Dialogue: 0,0:40:03.27,0:40:05.98,Default,,0,0,0,,Мен ұйықтап, оянғаннан кейін де түс жалғаса береді.
Dialogue: 0,0:40:06.32,0:40:07.57,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:40:10.69,0:40:11.70,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:40:12.28,0:40:13.57,Default,,0,0,0,,Жақсы ұйықтадың ба?
Dialogue: 0,0:40:13.66,0:40:14.53,Default,,0,0,0,,Иә
Dialogue: 0,0:40:14.62,0:40:16.99,Default,,0,0,0,,Балалар, сендер біздің тұтынушыларымызсыңдар.
Dialogue: 0,0:40:17.66,0:40:19.50,Default,,0,0,0,,Мәртебелі хабарды жеткізу
Dialogue: 0,0:40:20.00,0:40:22.29,Default,,0,0,0,,Кешегі жұмыс үшін марапат ретінде
Dialogue: 0,0:40:22.67,0:40:25.04,Default,,0,0,0,,Мен сендерді қылыш тартысты көруге шақырамын.
Dialogue: 0,0:40:25.63,0:40:27.67,Default,,0,0,0,,Дайын болыңыз.
Dialogue: 0,0:40:28.46,0:40:29.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:40:42.81,0:40:45.48,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:40:52.15,0:40:55.41,Default,,0,0,0,,Ю Хару, сені осында көргеніме қуаныштымын.
Dialogue: 0,0:40:56.16,0:40:59.08,Default,,0,0,0,,Мәртебелі ханшайымды сіздің жұмысыңыз үшін құтқарды.
Dialogue: 0,0:40:59.16,0:41:00.49,Default,,0,0,0,,Мен саған тәнтімін.
Dialogue: 0,0:41:00.91,0:41:02.79,Default,,0,0,0,,Сол қабілетке қарап.
Dialogue: 0,0:41:03.04,0:41:05.46,Default,,0,0,0,,Ол қылыштан да тамаша болуы керек.
Dialogue: 0,0:41:05.96,0:41:06.79,Default,,0,0,0,,Фели-чан да мүлдем мән бермейтін сияқты.
Dialogue: 0,0:41:07.21,0:41:09.67,Default,,0,0,0,,Мен сендерге қылышпен жекпе-жек өткізуді бұйырамын.
Dialogue: 0,0:41:10.17,0:41:13.42,Default,,0,0,0,,Ұлы мәртебелі алдында өз өнерлеріңізді көрсетулеріңізді қалаймын.
Dialogue: 0,0:41:13.51,0:41:16.68,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:41:17.09,0:41:19.85,Default,,0,0,0,,Не, бұл сыйлық емес пе?
Dialogue: 0,0:41:19.93,0:41:20.93,Default,,0,0,0,,және басқа да байланыс құралдарын—өшіріп, сол үстелге қойыңыз.
Dialogue: 0,0:41:25.10,0:41:25.94,Default,,0,0,0,,Хмф!
Dialogue: 0,0:41:27.56,0:41:28.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:30.52,0:41:31.57,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:41:31.73,0:41:32.99,Default,,0,0,0,,(Джозеф) Нүүүү! Гүх!
Dialogue: 0,0:41:33.40,0:41:34.99,Default,,0,0,0,,Сіз ренжіп қалдыңыз дейсіз бе?
Dialogue: 0,0:41:35.11,0:41:38.28,Default,,0,0,0,,Әзірге қорғанысқа назар аударып, қашу жолын іздейік.
Dialogue: 0,0:41:39.33,0:41:40.70,Default,,0,0,0,,(айдаһар дыбысы)
Dialogue: 0,0:41:42.95,0:41:43.79,Default,,0,0,0,,Уау!
Dialogue: 0,0:41:45.33,0:41:47.25,Default,,0,0,0,,Қашу жолы қай жерде?
Dialogue: 0,0:41:47.33,0:41:48.42,Default,,0,0,0,,Теря (жауынгер) Хамф!
Dialogue: 0,0:41:52.17,0:41:53.84,Default,,0,0,0,,Уау (Камбала) Ой
Dialogue: 0,0:41:54.63,0:41:55.51,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:41:56.88,0:41:59.30,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:42:02.97,0:42:04.23,Default,,0,0,0,,Келгің келсе кел.
Dialogue: 0,0:42:05.85,0:42:06.69,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:42:07.90,0:42:09.40,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:42:09.48,0:42:12.32,Default,,0,0,0,,Әке, сіз олармен не істеуді жоспарлап отырсыз?
Dialogue: 0,0:42:12.94,0:42:16.65,Default,,0,0,0,,Ханшайым, сабыр етіңіз. Біз жай ғана ойын ойнаймыз.
Dialogue: 0,0:42:16.74,0:42:20.57,Default,,0,0,0,,Патшалыққа қызмет ететіндерге мұндай құрметсіздікке жол берілмейді.
Dialogue: 0,0:42:20.66,0:42:21.62,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:42:27.92,0:42:28.92,Default,,0,0,0,,Хару!
Dialogue: 0,0:42:29.00,0:42:30.29,Default,,0,0,0,,Танжиро~!
Dialogue: 0,0:42:30.71,0:42:32.34,Default,,0,0,0,,Өзіңізді жаман сезінбеңіз
Dialogue: 0,0:42:33.46,0:42:35.88,Default,,0,0,0,,Уф... уф... Уау
Dialogue: 0,0:42:39.59,0:42:40.55,Default,,0,0,0,,О...
Dialogue: 0,0:42:43.22,0:42:44.06,Default,,0,0,0,,Ю
Dialogue: 0,0:42:45.39,0:42:47.14,Default,,0,0,0,,Амансың ба? О
Dialogue: 0,0:42:48.69,0:42:50.23,Default,,0,0,0,,Мен қандай да бір себептермен қылышты қолдана аламын
Dialogue: 0,0:42:50.48,0:42:53.02,Default,,0,0,0,,Біздің рөл Б емес, қала тұрғындары А
Dialogue: 0,0:42:53.11,0:42:55.94,Default,,0,0,0,,Демек, ол жақсы шайқаса алатын А В жауынгері болды ма?
Dialogue: 0,0:42:56.44,0:42:57.28,Default,,0,0,0,,Мен осындамын, мама
Dialogue: 0,0:42:57.40,0:42:58.24,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:43:01.49,0:43:02.66,Default,,0,0,0,,Эй, эй
Dialogue: 0,0:43:05.29,0:43:06.16,Default,,0,0,0,,Әлде бұл өкпеден бе? Карс
Dialogue: 0,0:43:09.08,0:43:10.12,Default,,0,0,0,,Мен сен осы тасты жарып өте алмайсың деп ойладым…
Dialogue: 0,0:43:10.21,0:43:12.42,Default,,0,0,0,,Екеуміз жақсы араласамыз деп ешқашан ойламаппын.
Dialogue: 0,0:43:12.50,0:43:15.42,Default,,0,0,0,,Екі адам бірдей сияқты.
Dialogue: 0,0:43:17.01,0:43:17.88,Default,,0,0,0,,Хмм
Dialogue: 0,0:43:18.76,0:43:19.72,Default,,0,0,0,,Оған дейін!
Dialogue: 0,0:43:20.26,0:43:22.47,Default,,0,0,0,,(айдаһар дыбысы)
Dialogue: 0,0:43:25.81,0:43:28.89,Default,,0,0,0,,Екеуінің де қылыш шеберлігі ғажап.
Dialogue: 0,0:43:41.99,0:43:44.49,Default,,0,0,0,,Неге бұлай істеп жатырсың... Әке?
Dialogue: 0,0:43:44.66,0:43:45.91,Default,,0,0,0,,Екі адамды қамауға алу
Dialogue: 0,0:43:45.99,0:43:46.83,Default,,0,0,0,,Не?
Dialogue: 0,0:43:46.91,0:43:48.83,Default,,0,0,0,,Мен сені сарайға қайтарып алып, жауап аламын.
Dialogue: 0,0:43:48.91,0:43:51.54,Default,,0,0,0,,Мені осы екі адам құтқарды.
Dialogue: 0,0:43:51.75,0:43:54.67,Default,,0,0,0,,Қарғысты бұзатын сиқыр, ерекше қылыш шеберлігі
Dialogue: 0,0:43:55.38,0:43:57.38,Default,,0,0,0,,Мен Мәртебелінің өмірін алмақ болсам ше?
Dialogue: 0,0:43:57.46,0:44:00.80,Default,,0,0,0,,Егер сіз Қара Ту армиясының өлтірушісі болсаңыз, бұл қайтымсыз.
Dialogue: 0,0:44:00.88,0:44:02.01,Default,,0,0,0,,Бұл Нұрегину
Dialogue: 0,0:44:02.09,0:44:05.68,Default,,0,0,0,,Жетер, бұл жай ғана арман, солай ма? Мұның бәрі де
Dialogue: 0,0:44:06.14,0:44:08.31,Default,,0,0,0,,Хару, Ичинокуниге оралайық.
Dialogue: 0,0:44:08.97,0:44:12.06,Default,,0,0,0,,Иә? Мұндай әдіс қайда бар?
Dialogue: 0,0:44:12.14,0:44:15.15,Default,,0,0,0,,Секіру триггері өмірге қауіп төндіруі мүмкін.
Dialogue: 0,0:44:15.61,0:44:17.65,Default,,0,0,0,,Не? сол жалынға ұшып
Dialogue: 0,0:44:18.61,0:44:19.74,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:44:20.49,0:44:21.61,Default,,0,0,0,,Бәрі немесе ештеңе.
Dialogue: 0,0:44:22.40,0:44:24.91,Default,,0,0,0,,3 2 1…
Dialogue: 0,0:44:25.53,0:44:26.45,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:44:38.92,0:44:42.17,Default,,0,0,0,,Уау
Dialogue: 0,0:44:49.14,0:44:51.77,Default,,0,0,0,,Олар шынымен саяхатшылар ма?
Dialogue: 0,0:44:52.81,0:44:54.23,Default,,0,0,0,,Саяхатшы?
Dialogue: 0,0:45:13.46,0:45:14.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:45:25.84,0:45:27.64,Default,,0,0,0,,Түсіңізден ояндыңыз ба?
Dialogue: 0,0:45:33.35,0:45:34.81,Default,,0,0,0,,Иә, Котона ше?
Dialogue: 0,0:45:35.89,0:45:37.48,Default,,0,0,0,,Хару Ю
Dialogue: 0,0:45:38.06,0:45:40.11,Default,,0,0,0,,Ха... а...
Dialogue: 0,0:45:42.36,0:45:43.40,Default,,0,0,0,,Котона!
Dialogue: 0,0:45:43.94,0:45:45.20,Default,,0,0,0,,Не?
Dialogue: 0,0:45:46.16,0:45:47.32,Default,,0,0,0,,Хару, не болды?
Dialogue: 0,0:45:48.70,0:45:51.41,Default,,0,0,0,,Бұл ештеңе емес Бұл ештеңе емес
Dialogue: 0,0:45:51.70,0:45:54.33,Default,,0,0,0,,Не, бұл жиіркенішті.
Dialogue: 0,0:45:55.00,0:45:55.96,Default,,0,0,0,,Котона…
Dialogue: 0,0:45:57.21,0:45:59.75,Default,,0,0,0,,Екеуіңде бірдеңе дұрыс емес деп ойламайсың ба?
Dialogue: 0,0:46:00.13,0:46:01.84,Default,,0,0,0,,Мен жексенбі күні форма киемін.
Dialogue: 0,0:46:02.09,0:46:05.09,Default,,0,0,0,,Сіз кеше бірдеңені өзгерттіңіз бе?
Dialogue: 0,0:46:06.38,0:46:07.22,Default,,0,0,0,,Ах
Dialogue: 0,0:46:07.72,0:46:10.01,Default,,0,0,0,,Мен кеше мұнда бір ғажайып нәрсені көрдім.
Dialogue: 0,0:46:10.30,0:46:11.35,Default,,0,0,0,,Керемет нәрсе ме?
Dialogue: 0,0:46:11.76,0:46:15.10,Default,,0,0,0,,Иә, ұйқылы-ояу жүргізуші ғимаратқа соғылған апат.
Dialogue: 0,0:46:15.73,0:46:16.60,Default,,0,0,0,,Апат
Dialogue: 0,0:46:17.64,0:46:18.85,Default,,0,0,0,,
Dialogue: 0,0:46:18.94,0:46:19.94,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:46:24.32,0:46:25.86,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:46:34.24,0:46:36.00,Default,,0,0,0,,Кейбір адамдар қайтыс болды
Dialogue: 0,0:46:37.04,0:46:37.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:38.71,0:46:40.13,Default,,0,0,0,,Бұл адамдар...
Dialogue: 0,0:46:42.34,0:46:44.55,Default,,0,0,0,,Үлкен апаттар қорқынышты емес пе?
Dialogue: 0,0:46:50.05,0:46:51.01,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:46:51.14,0:46:52.30,Default,,0,0,0,,...
Dialogue: 0,0:46:52.68,0:46:54.64,Default,,0,0,0,,Ата, сіз сол жақтансыз ба?
Dialogue: 0,0:46:55.10,0:46:58.89,Default,,0,0,0,,Жақсы, бұл әдемі жер.
Dialogue: 0,0:46:59.52,0:47:00.65,Default,,0,0,0,,Иә
Dialogue: 0,0:47:01.65,0:47:04.65,Default,,0,0,0,,Ni no Kuni бұл дүниемен байланысты
Dialogue: 0,0:47:05.53,0:47:08.90,Default,,0,0,0,,Таңдалғандар келіп, кете алады.
Dialogue: 0,0:47:10.11,0:47:11.45,Default,,0,0,0,,Менің де барғым келеді
Dialogue: 0,0:47:11.53,0:47:14.12,Default,,0,0,0,,Сондай күндердің бірінде хехехе...
Dialogue: 0,0:47:14.91,0:47:19.16,Default,,0,0,0,,Дегенмен, Ni no Kuni және бұл дүниеде қатыгез ережелер бар.
Dialogue: 0,0:47:20.33,0:47:21.42,Default,,0,0,0,,Ережелер?
Dialogue: 0,0:47:21.96,0:47:26.17,Default,,0,0,0,,Екі дүниеде өмірі байланысты адамдар бар.
Dialogue: 0,0:47:26.51,0:47:28.67,Default,,0,0,0,,Өмірлері байланыстылар...
Dialogue: 0,0:47:28.76,0:47:32.93,Default,,0,0,0,,Мүмкін бізге бірдей нәрселер ұнайтын шығар немесе мінезіміз ұқсас шығар.
Dialogue: 0,0:47:33.51,0:47:34.51,Default,,0,0,0,,
Dialogue: 0,0:47:35.47,0:47:37.02,Default,,0,0,0,,Біздің өміріміз байланысты ма?
Dialogue: 0,0:47:37.39,0:47:40.48,Default,,0,0,0,,Аша мен Котона менің 5 жасымда болған...
Dialogue: 0,0:47:40.60,0:47:43.36,Default,,0,0,0,,Бұл менімен бірге ауруханада болған атаның әңгімесіне сәйкес келеді.
Dialogue: 0,0:47:44.69,0:47:47.57,Default,,0,0,0,,Мен не айтып тұрғаныңызды түсінбеймін.
Dialogue: 0,0:47:50.36,0:47:51.28,Default,,0,0,0,,Котона шешеді
Dialogue: 0,0:47:52.99,0:47:55.87,Default,,0,0,0,,Уа... Жақсы, Котона.
Dialogue: 0,0:47:56.83,0:47:58.33,Default,,0,0,0,,Котона тірі болды
Dialogue: 0,0:47:58.58,0:47:59.71,Default,,0,0,0,,Бұл анық.
Dialogue: 0,0:48:00.12,0:48:03.13,Default,,0,0,0,,Бірақ пышақтап өліп қала жаздағанын көрдіңіз.
Dialogue: 0,0:48:03.21,0:48:05.71,Default,,0,0,0,,Міне, содан бері армандайтыным осы.
Dialogue: 0,0:48:06.30,0:48:08.63,Default,,0,0,0,,Жоқ, бұл шындық деп ойлаймын.
Dialogue: 0,0:48:09.42,0:48:10.97,Default,,0,0,0,,Бұл менің болжамым.
Dialogue: 0,0:48:11.34,0:48:13.22,Default,,0,0,0,,Өйткені біз Ашаға көмектестік.
Dialogue: 0,0:48:13.39,0:48:14.89,Default,,0,0,0,,Котона да құтқарылды.
Dialogue: 0,0:48:15.01,0:48:17.22,Default,,0,0,0,,Екі өмір байланысты ма?
Dialogue: 0,0:48:17.68,0:48:19.27,Default,,0,0,0,,Сонымен не маңызды?
Dialogue: 0,0:48:19.35,0:48:19.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:20.52,0:48:23.06,Default,,0,0,0,,Мен ол қарттың кім екенін білмеймін.
Dialogue: 0,0:48:23.73,0:48:25.40,Default,,0,0,0,,Бірақ бір нәрсе анық
Dialogue: 0,0:48:25.94,0:48:29.32,Default,,0,0,0,,Котона дәл қазір өте жігерлі жүгіріп жүр.
Dialogue: 0,0:48:31.82,0:48:34.20,Default,,0,0,0,,Ол дүние арман ба, шындық па
Dialogue: 0,0:48:34.53,0:48:35.95,Default,,0,0,0,,Қайсысы да жақсы.
Dialogue: 0,0:48:36.49,0:48:39.66,Default,,0,0,0,,Бұл ғана емес, жол апатына ұшыраған үш адам.
Dialogue: 0,0:48:39.95,0:48:42.41,Default,,0,0,0,,Бұл бізден бұрын жоғалып кеткен дәрігерлер тобына ұқсас болды.
Dialogue: 0,0:48:43.29,0:48:45.96,Default,,0,0,0,,Сіздің қиялыңыз шынымен керемет.
Dialogue: 0,0:48:54.68,0:48:56.85,Default,,0,0,0,,Мики-сан, біраз уақыт болды.
Dialogue: 0,0:48:56.97,0:48:58.22,Default,,0,0,0,,Бұл Юсуке Ниномия.
Dialogue: 0,0:48:58.64,0:49:00.10,Default,,0,0,0,,Бұл Ю-кун ба?
Dialogue: 0,0:49:00.81,0:49:02.68,Default,,0,0,0,,Уау, ол үлкейіп барады.
Dialogue: 0,0:49:03.14,0:49:04.35,Default,,0,0,0,,Хаха…
Dialogue: 0,0:49:05.06,0:49:06.44,Default,,0,0,0,,Мен ауруханада жатқанда-
Dialogue: 0,0:49:06.86,0:49:08.77,Default,,0,0,0,,Атаң ауруханаға түсті, солай ма?
Dialogue: 0,0:49:09.15,0:49:10.07,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:49:10.15,0:49:12.86,Default,,0,0,0,,Атам әлі осында.
Dialogue: 0,0:49:13.03,0:49:14.82,Default,,0,0,0,,Мен шынымен қиыншылыққа ұшырадым.
Dialogue: 0,0:49:16.03,0:49:18.03,Default,,0,0,0,,Не? Сіз кеттіңіз бе?
Dialogue: 0,0:49:18.99,0:49:21.29,Default,,0,0,0,,Бұл жиі кездесетін жағдай.
Dialogue: 0,0:49:21.41,0:49:22.75,Default,,0,0,0,,Бұл дабыл.
Dialogue: 0,0:49:24.58,0:49:26.63,Default,,0,0,0,,Атам Ни но Куниге барды.
Dialogue: 0,0:49:30.50,0:49:34.76,Default,,0,0,0,,Түсіндім, ертең ауруханадан шығасың. Жақсы нәрсе.
Dialogue: 0,0:49:34.84,0:49:37.34,Default,,0,0,0,,Атам тез арада ауруханадан шығады деп үміттенемін.
Dialogue: 0,0:49:37.76,0:49:40.43,Default,,0,0,0,,Мен де жақында Ни но Куниге кетемін.
Dialogue: 0,0:49:41.06,0:49:43.31,Default,,0,0,0,,Ни жоқ Куни... Мен де барамын
Dialogue: 0,0:49:43.39,0:49:45.23,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:49:45.35,0:49:48.44,Default,,0,0,0,,Ни но Куниге тек таңдалған батырлар ғана бара алады.
Dialogue: 0,0:49:48.86,0:49:49.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:49.77,0:49:53.69,Default,,0,0,0,,Бірақ батыр бола алсаң, міндетті түрде бара аласың.
Dialogue: 0,0:49:54.36,0:49:55.20,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:50:01.70,0:50:03.33,Default,,0,0,0,,Тағы бір айта кететін жайт...
Dialogue: 0,0:50:04.16,0:50:05.75,Default,,0,0,0,,Котона Такашина-
Dialogue: 0,0:50:05.83,0:50:08.08,Default,,0,0,0,,Ол денсаулығына байланысты біраз уақыт жұмыста болмайды.
Dialogue: 0,0:50:08.54,0:50:09.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:10.04,0:50:12.34,Default,,0,0,0,,Бүгін таңертең маған анам қоңырау шалды.
Dialogue: 0,0:50:12.75,0:50:14.55,Default,,0,0,0,,Мен егжей-тегжейлі білмеймін, бірақ...
Dialogue: 0,0:50:14.92,0:50:17.63,Default,,0,0,0,,Маған мүлдем уайымдама деді, сондықтан...
Dialogue: 0,0:50:22.60,0:50:24.27,Default,,0,0,0,,Қатерлі ісік?
Dialogue: 0,0:50:24.64,0:50:26.60,Default,,0,0,0,,...өтірік емес пе?
Dialogue: 0,0:50:28.19,0:50:30.56,Default,,0,0,0,,Әкем маған тест тапсыруға кеңес бергенде.
Dialogue: 0,0:50:31.23,0:50:32.57,Default,,0,0,0,,Мен табылдым
Dialogue: 0,0:50:33.36,0:50:35.65,Default,,0,0,0,,Өйткені... сіз...
Dialogue: 0,0:50:36.28,0:50:38.53,Default,,0,0,0,,Сен қатты толқыдың, солай емес пе?
Dialogue: 0,0:50:45.58,0:50:49.08,Default,,0,0,0,,Не? Сіздің өміріңіз үш ай ғана қалды ма?
Dialogue: 0,0:50:49.83,0:50:52.34,Default,,0,0,0,,Мен анам мен әкемнің сөйлескенін естідім.
Dialogue: 0,0:50:53.42,0:50:54.92,Default,,0,0,0,,Соған қарамастан, бұл түтін неге осынша көп?
Dialogue: 0,0:50:55.34,0:50:57.17,Default,,0,0,0,,Бұлай болуы мүмкін емес.
Dialogue: 0,0:50:57.88,0:50:58.84,Default,,0,0,0,,бірақ манга суретшісінің үйіне алты минут ерте бару—
Dialogue: 0,0:50:59.30,0:51:02.18,Default,,0,0,0,,Екеуміз бұрынғыдай кездессек жақсы болар еді.
Dialogue: 0,0:51:03.14,0:51:04.51,Default,,0,0,0,,Қалған уақыт…
Dialogue: 0,0:51:08.35,0:51:10.52,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:51:11.81,0:51:12.90,Default,,0,0,0,,Менің кетуім керек
Dialogue: 0,0:51:13.52,0:51:15.40,Default,,0,0,0,,Сыртқа шығудың уақыты өтіп кетті.
Dialogue: 0,0:51:15.65,0:51:17.19,Default,,0,0,0,,Котона Мен сенімен біргемін...
Dialogue: 0,0:51:17.28,0:51:19.91,Default,,0,0,0,,Кешіріңіз, жарайды.
Dialogue: 0,0:51:27.70,0:51:28.71,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:51:29.12,0:51:31.42,Default,,0,0,0,,Неліктен Котона мұны бастан өткерді?
Dialogue: 0,0:51:32.04,0:51:34.88,Default,,0,0,0,,Хару, әйтеуір Ни но Куниге қайта барайық.
Dialogue: 0,0:51:35.84,0:51:38.63,Default,,0,0,0,,Атам да сол дүниені Ни но Куни деп атаған.
Dialogue: 0,0:51:39.67,0:51:41.93,Default,,0,0,0,,Ал біздің өміріміз бір-бірімен байланысты.
Dialogue: 0,0:51:42.39,0:51:44.60,Default,,0,0,0,,Онда қатыгез ережелер бар.
Dialogue: 0,0:51:45.22,0:51:46.35,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:51:46.68,0:51:49.35,Default,,0,0,0,,Ханшайымға тағы да қауіп төнуі мүмкін.
Dialogue: 0,0:51:49.43,0:51:50.81,Default,,0,0,0,,Сонымен Котона...
Dialogue: 0,0:51:51.65,0:51:53.73,Default,,0,0,0,,Осындай уақытта не айтып тұрсың?
Dialogue: 0,0:51:54.31,0:51:55.52,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба?
Dialogue: 0,0:51:56.69,0:51:57.73,Default,,0,0,0,,Корпус…
Dialogue: 0,0:51:58.40,0:51:59.86,Default,,0,0,0,,Бұл керісінше емес пе?
Dialogue: 0,0:52:01.03,0:52:03.62,Default,,0,0,0,,Мен Ашаның өмірін сақтап қалғаным үшін өлуім керек еді.
Dialogue: 0,0:52:03.91,0:52:06.70,Default,,0,0,0,,Котонаның өмірі жойылмады ма?
Dialogue: 0,0:52:07.24,0:52:09.70,Default,,0,0,0,,Бұл қатыгез ереже!
Dialogue: 0,0:52:10.16,0:52:11.21,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:52:17.80,0:52:19.05,Default,,0,0,0,,Түсіндім, Ю.
Dialogue: 0,0:52:19.55,0:52:21.84,Default,,0,0,0,,Ол әлемге қайта баруға болады.
Dialogue: 0,0:52:22.18,0:52:23.05,Default,,0,0,0,,Жақсы тіл табысайық, иә?
Dialogue: 0,0:52:23.80,0:52:27.39,Default,,0,0,0,,Котонаны құтқару үшін Ашаны өлтіремін!
Dialogue: 0,0:52:28.35,0:52:30.89,Default,,0,0,0,,Хару, сен...
Dialogue: 0,0:52:32.19,0:52:33.85,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:52:33.94,0:52:36.94,Default,,0,0,0,,Мен оны құтқару үшін бәрін жасаймын.
Dialogue: 0,0:52:37.11,0:52:38.36,Default,,0,0,0,,Тіпті адамдарды өлтіруге болады
Dialogue: 0,0:52:39.11,0:52:41.74,Default,,0,0,0,,Сіздің адасуларыңыз жеткілікті.
Dialogue: 0,0:52:51.45,0:52:53.04,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:52:57.42,0:52:59.88,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:53:03.43,0:53:05.59,Default,,0,0,0,,...
Dialogue: 0,0:53:06.30,0:53:07.14,Default,,0,0,0,,Юу ше?
Dialogue: 0,0:53:26.20,0:53:27.03,Default,,0,0,0,,Ха…
Dialogue: 0,0:53:30.24,0:53:31.29,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:53:44.80,0:53:47.01,Default,,0,0,0,,(Аң дауысы)
Dialogue: 0,0:53:47.76,0:53:49.10,Default,,0,0,0,,(аңның үруі)
Dialogue: 0,0:53:50.10,0:53:51.01,Default,,0,0,0,,Уау
Dialogue: 0,0:53:52.18,0:53:54.18,Default,,0,0,0,,Не? Бұл құбыжық
Dialogue: 0,0:53:55.06,0:53:56.52,Default,,0,0,0,,Қан жарылысы!
Dialogue: 0,0:53:57.65,0:53:59.73,Default,,0,0,0,,Менің қара сарайыма
Dialogue: 0,0:54:00.44,0:54:02.23,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:54:03.36,0:54:05.11,Default,,0,0,0,,Менің атым Габарас
Dialogue: 0,0:54:06.28,0:54:10.41,Default,,0,0,0,,Ал сен екі дүниенің арасында алға-артқа кетесің...
Dialogue: 0,0:54:11.20,0:54:15.21,Default,,0,0,0,,Аңыз бойынша оның әлемді құтқаратын күші бар.
Dialogue: 0,0:54:15.71,0:54:17.33,Default,,0,0,0,,«Саяхатшы»
Dialogue: 0,0:54:18.00,0:54:19.21,Default,,0,0,0,,Саяхатшы?
Dialogue: 0,0:54:20.46,0:54:22.09,Default,,0,0,0,,Саяхатшы Хал
Dialogue: 0,0:54:22.59,0:54:27.34,Default,,0,0,0,,Осы күшті қателіктерді түзету үшін қолданайық.
Dialogue: 0,0:54:28.43,0:54:29.47,Default,,0,0,0,,Уф...
Dialogue: 0,0:54:29.55,0:54:31.93,Default,,0,0,0,,Бір рет қашып бара жатқанда
Dialogue: 0,0:54:32.01,0:54:34.31,Default,,0,0,0,,Міне, мен өзімді көрсете алдым.
Dialogue: 0,0:54:34.39,0:54:36.98,Default,,0,0,0,,Менің досым Котонаның өміріне қауіп төніп тұр.
Dialogue: 0,0:54:37.35,0:54:39.56,Default,,0,0,0,,Котона мен Аша ханшайым өмірде байланысты.
Dialogue: 0,0:54:39.90,0:54:42.11,Default,,0,0,0,,Сондықтан ханшайымға да қауіп төніп тұрған болуы керек.
Dialogue: 0,0:54:43.32,0:54:44.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:44.32,0:54:46.53,Default,,0,0,0,,Сен не туралы айтып тұрсың?
Dialogue: 0,0:54:46.61,0:54:50.62,Default,,0,0,0,,Ханшайымды біздің сарбаздар қатаң қорғайды және қорғайды.
Dialogue: 0,0:54:51.74,0:54:56.33,Default,,0,0,0,,Сіз айтып отырған өмір байланысы Ичинокуни туралы аңыз ба?
Dialogue: 0,0:54:57.12,0:54:59.08,Default,,0,0,0,,Бұған сенуге сіздің негізіңіз қандай?
Dialogue: 0,0:54:59.17,0:55:01.46,Default,,0,0,0,,Өйткені мен ханшайымның қарғысын бұздым...
Dialogue: 0,0:55:01.54,0:55:03.34,Default,,0,0,0,,Котона бір рет құтқарылды.
Dialogue: 0,0:55:03.42,0:55:05.21,Default,,0,0,0,,Және де керісінше.
Dialogue: 0,0:55:05.46,0:55:07.59,Default,,0,0,0,,Ол біздің әлемде дәл Саки-ниге ұқсайды.
Dialogue: 0,0:55:07.67,0:55:09.59,Default,,0,0,0,,Қарғыс атсын... Әлі де айтуым керек пе?
Dialogue: 0,0:55:10.09,0:55:11.80,Default,,0,0,0,,Саки-ни деген кім...
Dialogue: 0,0:55:12.35,0:55:14.97,Default,,0,0,0,,Бұл әпкеңе қоңырау шалудың дөрекі тәсілі.
Dialogue: 0,0:55:18.31,0:55:21.77,Default,,0,0,0,,Ичи но Куни мен Ни Но Куниде өмір сүргендердің жалпы саны...
Dialogue: 0,0:55:21.86,0:55:24.32,Default,,0,0,0,,Қандай шешім қабылданғанын білесіз бе?
Dialogue: 0,0:55:24.48,0:55:26.28,Default,,0,0,0,,Өмірдің жалпы саны?
Dialogue: 0,0:55:26.61,0:55:27.99,Default,,0,0,0,,Иә, егер-
Dialogue: 0,0:55:28.07,0:55:30.49,Default,,0,0,0,,Ни но Куниде бұл фактіге қайшы...
Dialogue: 0,0:55:30.57,0:55:33.12,Default,,0,0,0,,Егер сіз аяқталуы тиіс өмірді сақтап қалсаңыз...
Dialogue: 0,0:55:33.53,0:55:37.29,Default,,0,0,0,,Құнды бір елдің халқы төлейді.
Dialogue: 0,0:55:38.20,0:55:39.25,Default,,0,0,0,,Иә.
Dialogue: 0,0:55:39.75,0:55:42.75,Default,,0,0,0,,Басқаша айтқанда, Ашаның тағдыры өлетін болды.
Dialogue: 0,0:55:43.63,0:55:45.21,Default,,0,0,0,,Өлтіру керек
Dialogue: 0,0:55:45.30,0:55:47.46,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:55:50.18,0:55:53.14,Default,,0,0,0,,Бұл рас, мен Ичинокуниденмін.
Dialogue: 0,0:55:54.72,0:55:57.81,Default,,0,0,0,,Өйткені, сіз саяхатшымын дейсіз ғой.
Dialogue: 0,0:55:58.27,0:55:59.35,Default,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:55:59.60,0:56:01.85,Default,,0,0,0,,Мен тек Аша мен Котонаға көмектескім келеді.
Dialogue: 0,0:56:02.77,0:56:03.90,Default,,0,0,0,,Есеп беру!
Dialogue: 0,0:56:09.61,0:56:12.11,Default,,0,0,0,,Қазір Қара ту әскерінің көтерілісі туралы хабар бар.
Dialogue: 0,0:56:12.78,0:56:13.95,Default,,0,0,0,,Не?
Dialogue: 0,0:56:14.66,0:56:15.78,Default,,0,0,0,,Сіз айтасыз-
Dialogue: 0,0:56:15.87,0:56:18.50,Default,,0,0,0,,Ханшайымға жақындаған қауіп осы ма?
Dialogue: 0,0:56:19.08,0:56:22.12,Default,,0,0,0,,Бұл дұрыс болуы мүмкін. Дереу ханшайымды қорғауға дайындалыңыз.
Dialogue: 0,0:56:24.08,0:56:26.50,Default,,0,0,0,,Бұған дейін мойындаңыз.
Dialogue: 0,0:56:26.59,0:56:27.42,Default,,0,0,0,,Қый!
Dialogue: 0,0:56:28.13,0:56:32.68,Default,,0,0,0,,Сіздің одақтастарыңыз Қара туды армияның шайқас шебіне қосылды.
Dialogue: 0,0:56:33.13,0:56:34.09,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:56:36.05,0:56:37.18,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:56:37.31,0:56:41.52,Default,,0,0,0,,Біздің Қара туды армиямыздың құрамында сіз Эстабания ханшайымын жеңесіз.
Dialogue: 0,0:56:43.56,0:56:47.40,Default,,0,0,0,,Жақын адамның өмірін сақтап қалу. Еш ойланбаңыз.
Dialogue: 0,0:56:47.65,0:56:49.23,Default,,0,0,0,,Мен жоғалған жоқпын.
Dialogue: 0,0:56:49.98,0:56:51.78,Default,,0,0,0,,Бірақ сіз адамдарды өлтіресіз.
Dialogue: 0,0:56:51.86,0:56:54.16,Default,,0,0,0,,Белгілі бір мөлшерді анықтауды талап етеді
Dialogue: 0,0:56:54.57,0:56:55.99,Default,,0,0,0,,Сен бұл әлемсің...
Dialogue: 0,0:56:56.07,0:56:58.28,Default,,0,0,0,,Түс деп айтпадың ба?
Dialogue: 0,0:56:59.12,0:57:03.29,Default,,0,0,0,,Түсінде біреуді өлтіруден маңызды ештеңе жоқ.
Dialogue: 0,0:57:06.25,0:57:10.00,Default,,0,0,0,,Біздің әскерилердің мақтан тұтатын әуе жауын іздеу бөлімшесі, «Hawk Eye Group»
Dialogue: 0,0:57:10.09,0:57:12.80,Default,,0,0,0,,Мен сіздің серіктесіңіз болып көрінетін сарбазды анықтадым.
Dialogue: 0,0:57:12.88,0:57:17.14,Default,,0,0,0,,Досың Хару өлтіруші емес пе?
Dialogue: 0,0:57:17.22,0:57:19.26,Default,,0,0,0,,Ол Қара Ту армиясының бөлігі емес.
Dialogue: 0,0:57:20.10,0:57:21.10,Default,,0,0,0,,Ол —
Dialogue: 0,0:57:21.64,0:57:24.19,Default,,0,0,0,,Мен тек Котонаға алаңдап отырмын.
Dialogue: 0,0:57:25.06,0:57:28.11,Default,,0,0,0,,Мәртебелі Йоки-сан, маған сеніңіз.
Dialogue: 0,0:57:30.32,0:57:33.70,Default,,0,0,0,,Жақсы, егер көп айтсаң.
Dialogue: 0,0:57:37.49,0:57:42.70,Default,,0,0,0,,Өзің ханшайымның қамқоршысы бол және менің әскерімнің қатарына қосыл.
Dialogue: 0,0:57:43.25,0:57:47.50,Default,,0,0,0,,Содан кейін жау әскерінде тұрған Харуды қолдарыңызбен жеңіңіз.
Dialogue: 0,0:57:48.54,0:57:52.59,Default,,0,0,0,,Сонда мен сенің жауым емес екеніңді мойындаймын.
Dialogue: 0,0:57:54.34,0:57:56.51,Default,,0,0,0,,Мәртебелі, сіз қалай ойлайсыз?
Dialogue: 0,0:57:57.22,0:58:01.01,Default,,0,0,0,,Жарайды, мен сені ханшайымның қамқоршысы етіп тағайындаймын.
Dialogue: 0,0:58:12.65,0:58:16.57,Default,,0,0,0,,Жарайды, жауды пышақтап алсам да...
Dialogue: 0,0:58:17.11,0:58:18.57,Default,,0,0,0,,Ханшайымды қорға
Dialogue: 0,0:58:20.33,0:58:21.20,Default,,0,0,0,,Ю
Dialogue: 0,0:58:22.91,0:58:23.91,Default,,0,0,0,,Аша
Dialogue: 0,0:58:25.08,0:58:26.66,Default,,0,0,0,,Йокиден естіген
Dialogue: 0,0:58:27.25,0:58:28.79,Default,,0,0,0,,Мен құтқарылғандықтан...
Dialogue: 0,0:58:29.08,0:58:31.38,Default,,0,0,0,,Сіздің қымбатты Котона...
Dialogue: 0,0:58:32.09,0:58:33.84,Default,,0,0,0,,Бұл Ашаның кінәсі емес
Dialogue: 0,0:58:35.76,0:58:37.63,Default,,0,0,0,,Аша не...
Dialogue: 0,0:58:39.51,0:58:43.01,Default,,0,0,0,,Бұл қылышты анам сиқырлы күш арқылы жасаған.
Dialogue: 0,0:58:44.22,0:58:48.14,Default,,0,0,0,,Бұл қылыштың алдында қорғаныс сиқырының әсері жоқ.
Dialogue: 0,0:58:50.73,0:58:52.27,Default,,0,0,0,,Маған мұраға қалған билік
Dialogue: 0,0:58:52.36,0:58:54.36,Default,,0,0,0,,Егер ол дұрыс пайдаланылмаса
Dialogue: 0,0:58:55.03,0:58:57.57,Default,,0,0,0,,Мен бұл қылышты қолдануым керек.
Dialogue: 0,0:58:59.20,0:59:02.41,Default,,0,0,0,,Бұл менің өмірімді алатын қылыш.
Dialogue: 0,0:59:06.20,0:59:08.12,Default,,0,0,0,,Жүр, мені мына қылышпен ал!
Dialogue: 0,0:59:08.96,0:59:11.92,Default,,0,0,0,,Сонда сіз өкінішіңізді босата аласыз.
Dialogue: 0,0:59:12.09,0:59:14.80,Default,,0,0,0,,Өкінішті? Өкінбеймін
Dialogue: 0,0:59:14.88,0:59:16.21,Default,,0,0,0,,...
Dialogue: 0,0:59:16.80,0:59:19.55,Default,,0,0,0,,Өйткені мен басқа әлемнен біреудің өмірін сақтап қалдым.
Dialogue: 0,0:59:20.05,0:59:21.05,Default,,0,0,0,,Сүйікті адамның өмірі
Dialogue: 0,0:59:21.14,0:59:23.47,Default,,0,0,0,,Мен оны ұрлап алды деп қорқамын.
Dialogue: 0,0:59:30.60,0:59:31.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:59:31.65,0:59:35.32,Default,,0,0,0,,Бұл өмірді бастапқыда сіз құтқардыңыз.
Dialogue: 0,0:59:36.44,0:59:38.99,Default,,0,0,0,,Ю мен Хару Котона-сан үшін ойлайды
Dialogue: 0,0:59:39.28,0:59:40.91,Default,,0,0,0,,Мен саған өмірімді беремін
Dialogue: 0,0:59:40.99,0:59:42.66,Default,,0,0,0,,Бұл мүмкін емес...
Dialogue: 0,0:59:42.74,0:59:43.74,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:59:44.41,0:59:48.12,Default,,0,0,0,,Біреуді құтқару үшін біреудің өмірін қию дұрыс емес.
Dialogue: 0,0:59:50.79,0:59:52.13,Default,,0,0,0,,Бұл дәл өткен жолымен бірдей, кішкентай сорлы!
Dialogue: 0,0:59:52.58,0:59:54.67,Default,,0,0,0,,Егер адам шынымен маңызды болса
Dialogue: 0,0:59:54.84,0:59:57.17,Default,,0,0,0,,Күнәні арқалау, бәрін көтеру
Dialogue: 0,0:59:57.38,0:59:59.51,Default,,0,0,0,,Бұл сіз сақтағыңыз келетін нәрсе емес пе?
Dialogue: 0,1:00:00.09,1:00:03.22,Default,,0,0,0,,Мен оны құтқару үшін бәрін жасаймын.
Dialogue: 0,1:00:03.34,1:00:04.89,Default,,0,0,0,,Тіпті адамдарды өлтіруге болады
Dialogue: 0,1:00:05.93,1:00:06.85,Default,,0,0,0,,Аша
Dialogue: 0,1:00:07.22,1:00:09.39,Default,,0,0,0,,Сізде жоқ па?
Dialogue: 0,1:00:09.85,1:00:13.65,Default,,0,0,0,,Өзіңізге ұнайтын адамды құтқару үшін бірдеңені жоғалтуға дайынсыз ба?
Dialogue: 0,1:00:15.44,1:00:16.36,Default,,0,0,0,,Дайын бол...
Dialogue: 0,1:00:17.61,1:00:19.24,Default,,0,0,0,,Сенің орнында болсам
Dialogue: 0,1:00:19.49,1:00:22.28,Default,,0,0,0,,Бұл қылыш мен үшін маңызды біреудің өмірін сақтап қалатынына сенімдімін.
Dialogue: 0,1:00:23.16,1:00:24.91,Default,,0,0,0,,Енді шешім қабылдайтын кез келді
Dialogue: 0,1:00:25.07,1:00:27.58,Default,,0,0,0,,Сізге қатты көңіл бөлетін адам...
Dialogue: 0,1:00:28.37,1:00:30.08,Default,,0,0,0,,Сақтау туралы шешім қабылдау
Dialogue: 0,1:00:32.75,1:00:33.67,Default,,0,0,0,,Махаббат та, махаббатсыз неке де
Dialogue: 0,1:00:35.13,1:00:37.00,Default,,0,0,0,,Менің пікірімді тыңдаңыз
Dialogue: 0,1:00:37.30,1:00:38.13,Default,,0,0,0,,Дампфер
Dialogue: 0,1:00:38.84,1:00:41.72,Default,,0,0,0,,Мен де Ни но Куни мен Ичи но Кунидің жандары...
Dialogue: 0,1:00:41.80,1:00:43.89,Default,,0,0,0,,Оған байланысты аңыздарды білемін.
Dialogue: 0,1:00:44.34,1:00:47.64,Default,,0,0,0,,Бірақ біреуді құтқарсаң, біреу өледі.
Dialogue: 0,1:00:47.89,1:00:49.64,Default,,0,0,0,,Бұл шынымен солай ма?
Dialogue: 0,1:00:50.06,1:00:50.89,Default,,0,0,0,,Иә!
Dialogue: 0,1:00:51.81,1:00:53.44,Default,,0,0,0,,Өмірдің қандай байланысы бар?
Dialogue: 0,1:00:53.52,1:00:54.60,Default,,0,0,0,,Мен әлі білмеймін
Dialogue: 0,1:00:55.40,1:00:57.90,Default,,0,0,0,,Мен Ашаны да, Котонаны да құтқарғым келеді.
Dialogue: 0,1:00:58.90,1:01:00.53,Default,,0,0,0,,Жоқ, мен сені құтқарамын.
Dialogue: 0,1:01:01.36,1:01:02.49,Default,,0,0,0,,Маған сеніңіз
Dialogue: 0,1:01:04.11,1:01:04.99,Default,,0,0,0,,Ю
Dialogue: 0,1:01:09.24,1:01:12.25,Default,,0,0,0,,(жауынгерлік айқай)
Dialogue: 0,1:01:25.39,1:01:28.97,Default,,0,0,0,,Қара ту армиясы сияқты, жай ғана бұралу.
Dialogue: 0,1:01:29.06,1:01:30.60,Default,,0,0,0,,Ооо
Dialogue: 0,1:01:31.10,1:01:33.69,Default,,0,0,0,,Мен саған ішуіңді өтіндім.
Dialogue: 0,1:01:34.10,1:01:35.69,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,1:01:35.90,1:01:38.52,Default,,0,0,0,,Көп мөлшерде алкоголь дайындаңыз.
Dialogue: 0,1:01:43.44,1:01:46.70,Default,,0,0,0,,(Қара ту әскерінің айқайы)
Dialogue: 0,1:01:57.96,1:01:59.21,Default,,0,0,0,,Тоқтан ажыратылған
Dialogue: 0,1:01:59.84,1:02:00.75,Default,,0,0,0,,Жабу
Dialogue: 0,1:02:17.27,1:02:18.27,Default,,0,0,0,,Бұл...
Dialogue: 0,1:02:19.15,1:02:21.77,Default,,0,0,0,,Не болды? Сіз қорқыныш сезіндіңіз бе?
Dialogue: 0,1:02:22.57,1:02:27.24,Default,,0,0,0,,Жақын адамын қорғау үшін басқаның өмірін қию
Dialogue: 0,1:02:27.36,1:02:28.74,Default,,0,0,0,,Бұл соғыс
Dialogue: 0,1:02:28.87,1:02:29.87,Default,,0,0,0,,Егер олар тым жылдам қозғалса (оу, вей, оу)
Dialogue: 0,1:02:29.95,1:02:34.37,Default,,0,0,0,,Оның орнына өз соғысыңды баста.
Dialogue: 0,1:02:35.54,1:02:36.37,Default,,0,0,0,,О
Dialogue: 0,1:02:36.46,1:02:37.54,Default,,0,0,0,,Ха!
Dialogue: 0,1:02:49.01,1:02:50.30,Default,,0,0,0,,Не болды?
Dialogue: 0,1:02:51.35,1:02:52.31,Default,,0,0,0,,Хал келді
Dialogue: 0,1:02:53.01,1:02:54.02,Default,,0,0,0,,Менің кетуім керек
Dialogue: 0,1:02:54.14,1:02:55.14,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:02:56.56,1:02:59.90,Default,,0,0,0,,Сіз Халмен күресе аласыз ба?
Dialogue: 0,1:03:01.15,1:03:05.07,Default,,0,0,0,,Дайындықсыз жүрсең, өміріңнен айырыласың.
Dialogue: 0,1:03:05.86,1:03:09.03,Default,,0,0,0,,Сонда да мен сені қорғағым келеді
Dialogue: 0,1:03:09.95,1:03:11.03,Default,,0,0,0,,Ю
Dialogue: 0,1:03:17.04,1:03:18.33,Default,,0,0,0,,Король
Dialogue: 0,1:03:18.87,1:03:20.42,Default,,0,0,0,,Бұл қиын
Dialogue: 0,1:03:20.50,1:03:24.59,Default,,0,0,0,,Қамалдың қақпасы бұзылды. Қамал қаласы ұрыс алаңына айналды.
Dialogue: 0,1:03:24.71,1:03:26.30,Default,,0,0,0,,Жаулардың саны 20 000
Dialogue: 0,1:03:26.38,1:03:30.05,Default,,0,0,0,,Егер жағдай осылай жалғаса берсе, мұнда жаудың асығуы ықтимал.
Dialogue: 0,1:03:30.13,1:03:31.72,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:03:31.80,1:03:34.06,Default,,0,0,0,,Мәртебелі, сізде алаңдайтын ештеңе жоқ.
Dialogue: 0,1:03:34.39,1:03:35.68,Default,,0,0,0,,Біздің жауынгерлер
Dialogue: 0,1:03:36.02,1:03:38.56,Default,,0,0,0,,Тіпті құдіретті Баделония мемлекеті де қапыда қалды.
Dialogue: 0,1:03:39.19,1:03:41.98,Default,,0,0,0,,Неліктен біздің жауынгерлердің күшіне сенбейсіз?
Dialogue: 0,1:03:42.31,1:03:43.31,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,1:03:43.90,1:03:46.78,Default,,0,0,0,,Уау (Қара рыцарьлар) Уау
Dialogue: 0,1:03:51.11,1:03:52.24,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,1:04:03.63,1:04:07.38,Default,,0,0,0,,Осы қарсыластың күшімен соңғы қорғаныс желісін бұзуға болады.
Dialogue: 0,1:04:07.67,1:04:10.72,Default,,0,0,0,,Біз енді патша сарайының күзетшілерін қолдауға барамыз.
Dialogue: 0,1:04:10.80,1:04:11.68,Default,,0,0,0,,Ха!
Dialogue: 0,1:04:11.76,1:04:14.80,Default,,0,0,0,,Қарғыс атсын... Ах... Мынау... Мынау...
Dialogue: 0,1:04:18.89,1:04:20.02,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,1:04:23.56,1:04:24.56,Default,,0,0,0,,Ал сіз ше?
Dialogue: 0,1:04:24.65,1:04:27.86,Default,,0,0,0,,Мен 7-ші кіші сарбаздар корпусына Бауэр Ренденмін
Dialogue: 0,1:04:28.28,1:04:30.28,Default,,0,0,0,,Өтінемін, бұл итке қамқорлық жасаңыз!
Dialogue: 0,1:04:30.44,1:04:31.40,Default,,0,0,0,,Хо
Dialogue: 0,1:04:35.78,1:04:37.79,Default,,0,0,0,,Жарайды, Бауэр, менің артымнан жүр.
Dialogue: 0,1:04:37.87,1:04:38.70,Default,,0,0,0,,Ха!
Dialogue: 0,1:04:39.50,1:04:41.21,Default,,0,0,0,,Иә!
Dialogue: 0,1:04:46.79,1:04:47.88,Default,,0,0,0,,Ах...
Dialogue: 0,1:04:47.96,1:04:49.13,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,1:04:49.46,1:04:50.38,Default,,0,0,0,,Уау
Dialogue: 0,1:04:52.30,1:04:53.18,Default,,0,0,0,,Бұл...
Dialogue: 0,1:04:53.26,1:04:56.05,Default,,0,0,0,,Бұл қара рыцарьдың сауыты.
Dialogue: 0,1:04:56.14,1:05:00.81,Default,,0,0,0,,Қуатыңызды бірнеше рет күшейтіңіз Сізге ұнай ма?
Dialogue: 0,1:05:01.31,1:05:02.98,Default,,0,0,0,,Сонымен, осы жерден не істейміз?
Dialogue: 0,1:05:03.06,1:05:07.82,Default,,0,0,0,,Біз жақында патшалықтың соңғы қорғаныс желісін жойып жібереміз.
Dialogue: 0,1:05:08.02,1:05:10.74,Default,,0,0,0,,Сен бірден қамалға асығасың.
Dialogue: 0,1:05:10.86,1:05:15.07,Default,,0,0,0,,Хаосты пайдаланып, Аша ханшайымды жеңіңіз.
Dialogue: 0,1:05:15.70,1:05:19.87,Default,,0,0,0,,Хмм... Сіз адасып қалдыңыз ба? айтар едім
Dialogue: 0,1:05:19.95,1:05:22.08,Default,,0,0,0,,Жақындарыңызды қорғау үшін...
Dialogue: 0,1:05:22.16,1:05:25.21,Default,,0,0,0,,Білемін, мен шешім қабылдадым.
Dialogue: 0,1:05:28.75,1:05:30.21,Default,,0,0,0,,Бұл арман, солай ма?
Dialogue: 0,1:05:31.13,1:05:32.42,Default,,0,0,0,,Сәлем? Юу
Dialogue: 0,1:05:32.80,1:05:33.72,Default,,0,0,0,,Әрі қарай жалғастырыңыздар!
Dialogue: 0,1:05:34.43,1:05:39.85,Default,,0,0,0,,Сүйікті адамыңның өмірін өз қолыңмен ал.
Dialogue: 0,1:05:39.93,1:05:41.22,Default,,0,0,0,,Хехе...
Dialogue: 0,1:05:46.35,1:05:47.19,Default,,0,0,0,,Аша
Dialogue: 0,1:05:47.73,1:05:49.94,Default,,0,0,0,,Әке, осылайша...
Dialogue: 0,1:05:50.07,1:05:53.15,Default,,0,0,0,,Балтон да, Верса да барын салып жатыр.
Dialogue: 0,1:05:53.24,1:05:54.40,Default,,0,0,0,,Тынышталыңыз.
Dialogue: 0,1:05:54.53,1:05:56.70,Default,,0,0,0,,Енді Гладионды қолданудың уақыты келді
Dialogue: 0,1:05:56.95,1:06:00.16,Default,,0,0,0,,Бұл жауды тыныштандыруы мүмкін.
Dialogue: 0,1:06:00.37,1:06:03.08,Default,,0,0,0,,Аңызға айналған Қасиетті Қылыш Гладион
Dialogue: 0,1:06:03.16,1:06:07.04,Default,,0,0,0,,Әке, Гладион – біздің елде қалған асыл қазына.
Dialogue: 0,1:06:07.42,1:06:08.46,Default,,0,0,0,,Қазынашылықта
Dialogue: 0,1:06:09.46,1:06:12.46,Default,,0,0,0,,Жоқ, Гладион жоқ.
Dialogue: 0,1:06:12.55,1:06:15.84,Default,,0,0,0,,Бірақ мен Гладионды көрдім.
Dialogue: 0,1:06:19.51,1:06:22.35,Default,,0,0,0,,Бұл жалған
Dialogue: 0,1:06:22.43,1:06:24.48,Default,,0,0,0,,Иә? жалған?
Dialogue: 0,1:06:24.98,1:06:27.14,Default,,0,0,0,,Патшалықтың ұлылығын басқа елдерге көрсету
Dialogue: 0,1:06:27.52,1:06:29.02,Default,,0,0,0,,Гладион жоғалды
Dialogue: 0,1:06:29.11,1:06:30.56,Default,,0,0,0,,Ол жасырылды.
Dialogue: 0,1:06:30.65,1:06:34.24,Default,,0,0,0,,Болды... Гладионның бар екені өтірік.
Dialogue: 0,1:06:34.32,1:06:39.37,Default,,0,0,0,,Бір кездері әкем сол билікті Баделонияны жою үшін пайдаланған.
Dialogue: 0,1:06:39.45,1:06:42.49,Default,,0,0,0,,Сол кезде бұл елден қылыш жоғалып кеткен.
Dialogue: 0,1:06:42.87,1:06:47.25,Default,,0,0,0,,Қылыш дұрыс қолданбаған әкеме ашуланды.
Dialogue: 0,1:06:57.80,1:06:59.51,Default,,0,0,0,,Әлде бұл өкпеден бе? Карс
Dialogue: 0,1:07:02.97,1:07:03.97,Default,,0,0,0,,Хару!
Dialogue: 0,1:07:04.64,1:07:07.81,Default,,0,0,0,,Ханшайымның басын көздеңіз, міндетті түрде басып алыңыз.
Dialogue: 0,1:07:07.89,1:07:09.10,Default,,0,0,0,,О!
Dialogue: 0,1:07:09.65,1:07:11.65,Default,,0,0,0,,Қандай жағдай болмасын ханшайымды қорға
Dialogue: 0,1:07:12.15,1:07:14.65,Default,,0,0,0,,Біз оны өмірімізге қымбат болса да қорғаймыз.
Dialogue: 0,1:07:14.78,1:07:16.03,Default,,0,0,0,,Ха!
Dialogue: 0,1:07:20.66,1:07:21.99,Default,,0,0,0,,Кокоха Тору-сан
Dialogue: 0,1:07:23.08,1:07:25.79,Default,,0,0,0,,Кет, мен ханшайымды өлтіремін.
Dialogue: 0,1:07:25.87,1:07:27.16,Default,,0,0,0,,Маған мұны істеуге рұқсат бересіз бе?
Dialogue: 0,1:07:28.16,1:07:29.33,Default,,0,0,0,,Какаре!
Dialogue: 0,1:07:29.42,1:07:31.58,Default,,0,0,0,,Ооо
Dialogue: 0,1:07:43.18,1:07:45.35,Default,,0,0,0,,Бұл жігіттің күші сонша...
Dialogue: 0,1:07:45.81,1:07:49.69,Default,,0,0,0,,Сүйген адамыңды қорғау үшін басқаның өмірін қию
Dialogue: 0,1:07:49.94,1:07:51.35,Default,,0,0,0,,Бұл соғыс
Dialogue: 0,1:07:56.69,1:07:57.65,Default,,0,0,0,,Корпус
Dialogue: 0,1:07:58.99,1:07:59.86,Default,,0,0,0,,Ю
Dialogue: 0,1:08:00.20,1:08:02.78,Default,,0,0,0,,Хару мен саған одан әрі өтуге жол бермеймін.
Dialogue: 0,1:08:02.87,1:08:05.03,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,1:08:05.53,1:08:08.16,Default,,0,0,0,,Мен Котонаның өмірін қайтаруға келдім.
Dialogue: 0,1:08:08.25,1:08:09.79,Default,,0,0,0,,Ашаны өлтірсең...
Dialogue: 0,1:08:09.91,1:08:12.21,Default,,0,0,0,,Бұл Котонаның өмірін қиюы мүмкін.
Dialogue: 0,1:08:12.33,1:08:13.25,Default,,0,0,0,,Түсінбейсің бе?
Dialogue: 0,1:08:13.67,1:08:16.42,Default,,0,0,0,,Өйткені біз өлуі тиіс адамды құтқардық.
Dialogue: 0,1:08:16.63,1:08:18.59,Default,,0,0,0,,Котонаның тағдыры өлетін болды.
Dialogue: 0,1:08:18.88,1:08:20.76,Default,,0,0,0,,Сондықтан мен өз жауапкершілігімді орындаймын
Dialogue: 0,1:08:20.84,1:08:25.05,Default,,0,0,0,,Ханшайымнан өмірді қайтарып, Котонаны құтқарыңыз.
Dialogue: 0,1:08:25.47,1:08:27.43,Default,,0,0,0,,Сіз қателесесіз Хал.
Dialogue: 0,1:08:27.52,1:08:29.60,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,1:08:29.68,1:08:32.48,Default,,0,0,0,,Котона мен үшін не болса да маңызды.
Dialogue: 0,1:08:34.31,1:08:35.61,Default,,0,0,0,,Маған кедергі жасама
Dialogue: 0,1:08:36.65,1:08:39.49,Default,,0,0,0,,Жолыма бөгет болсаң, мен сені өлтіремін.
Dialogue: 0,1:08:41.70,1:08:43.20,Default,,0,0,0,,Оян, Хал.
Dialogue: 0,1:08:45.53,1:08:47.99,Default,,0,0,0,,Иә, оян.
Dialogue: 0,1:08:48.41,1:08:50.70,Default,,0,0,0,,Бұл түс болса, тез ояныңыз.
Dialogue: 0,1:08:50.96,1:08:52.37,Default,,0,0,0,,Ю!
Dialogue: 0,1:08:53.21,1:08:56.17,Default,,0,0,0,,Қамалдың алдына жау басып кірді.
Dialogue: 0,1:08:56.25,1:08:58.71,Default,,0,0,0,,Оны кез келген жағдайда қорғаңыз
Dialogue: 0,1:09:00.71,1:09:03.38,Default,,0,0,0,,Иә? Бұл жігіт...
Dialogue: 0,1:09:03.68,1:09:05.80,Default,,0,0,0,,Бұл рыцарь капитан Велса емес пе?
Dialogue: 0,1:09:05.93,1:09:08.97,Default,,0,0,0,,Ол қауіпті әйел. Мен оны алып кетіп, өлтіруім керек пе?
Dialogue: 0,1:09:10.35,1:09:11.43,Default,,0,0,0,,Жолдан кет, Юу
Dialogue: 0,1:09:12.02,1:09:14.56,Default,,0,0,0,,Кетпе, Котонаны қорғайын дегендей.
Dialogue: 0,1:09:14.98,1:09:17.40,Default,,0,0,0,,Тіпті мен қорғағым келетін нәрсені таптым.
Dialogue: 0,1:09:17.86,1:09:20.78,Default,,0,0,0,,Бұл біз бір-бірімізден бір қадам артқа кете алмаймыз дегенді білдіреді.
Dialogue: 0,1:09:21.36,1:09:22.19,Default,,0,0,0,,Ах!
Dialogue: 0,1:09:23.15,1:09:24.07,Default,,0,0,0,,Уф...
Dialogue: 0,1:09:27.28,1:09:29.70,Default,,0,0,0,,Хару, тоқтайық.
Dialogue: 0,1:09:31.12,1:09:32.25,Default,,0,0,0,,Мені өлтір
Dialogue: 0,1:09:34.08,1:09:36.42,Default,,0,0,0,,Сен мені өлтірмесең, мен ханшайымды өлтіремін.
Dialogue: 0,1:09:37.33,1:09:38.92,Default,,0,0,0,,Мен шешім қабылдадым.
Dialogue: 0,1:09:39.46,1:09:42.17,Default,,0,0,0,,Мен оны не болса да қорғаймын.
Dialogue: 0,1:09:42.72,1:09:44.93,Default,,0,0,0,,Сіз бұған дайынсыз ба?
Dialogue: 0,1:09:53.56,1:09:55.27,Default,,0,0,0,,Әлде бұл өкпеден бе? Карс
Dialogue: 0,1:09:56.65,1:09:58.27,Default,,0,0,0,,Шынында да, бұл жігіт жақсы адам болуы мүмкін, білесің бе?
Dialogue: 0,1:10:02.78,1:10:05.32,Default,,0,0,0,,Екеуміз бұрыннан доспыз, солай емес пе?
Dialogue: 0,1:10:05.86,1:10:08.49,Default,,0,0,0,,Мен енді біз әрқашан дос боламыз деп ойладым.
Dialogue: 0,1:10:09.49,1:10:11.20,Default,,0,0,0,,Неге біз бір-бірімізді өлтіреміз?
Dialogue: 0,1:10:12.37,1:10:14.00,Default,,0,0,0,,Келесі жын - Тацунори.
Dialogue: 0,1:10:14.08,1:10:15.37,Default,,0,0,0,,Жарайды, теп.
Dialogue: 0,1:10:15.46,1:10:16.29,Default,,0,0,0,,Ах, қандай жалықтырарлық.
Dialogue: 0,1:10:17.92,1:10:18.83,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:10:20.50,1:10:21.34,Default,,0,0,0,,Ой…
Dialogue: 0,1:10:22.92,1:10:23.92,Default,,0,0,0,,Уау, бұл ақылсыз!
Dialogue: 0,1:10:24.38,1:10:26.05,Default,,0,0,0,,Үлкен! Жүгіріп кету!
Dialogue: 0,1:10:26.13,1:10:28.05,Default,,0,0,0,,Идиот! Итке не болды?
Dialogue: 0,1:10:28.34,1:10:29.26,Default,,0,0,0,,Ешқашан қашпа
Dialogue: 0,1:10:29.35,1:10:30.43,Default,,0,0,0,,Мен мұны істей алмаймын!
Dialogue: 0,1:10:30.64,1:10:31.51,Default,,0,0,0,,Жоспар
Dialogue: 0,1:10:32.10,1:10:32.93,Default,,0,0,0,,Эй!
Dialogue: 0,1:10:37.73,1:10:39.77,Default,,0,0,0,,Уф...
Dialogue: 0,1:10:43.11,1:10:46.20,Default,,0,0,0,,Қат! Мен қашып жатырмын ба?
Dialogue: 0,1:10:46.45,1:10:47.53,Default,,0,0,0,,Аяқтар өздігінен қозғалады
Dialogue: 0,1:10:56.37,1:10:57.50,Default,,0,0,0,,Уау
Dialogue: 0,1:11:00.33,1:11:02.34,Default,,0,0,0,,Мен өлемін бе?
Dialogue: 0,1:11:03.67,1:11:04.67,Default,,0,0,0,,(тастың соғылған дыбысы)
Dialogue: 0,1:11:08.47,1:11:10.80,Default,,0,0,0,,Жүр, ақымақ ит, осы жаққа.
Dialogue: 0,1:11:16.18,1:11:17.31,Default,,0,0,0,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,1:11:24.11,1:11:27.03,Default,,0,0,0,,Арбада отырсаң да мықтысың.
Dialogue: 0,1:11:27.57,1:11:30.36,Default,,0,0,0,,Қашқанда жүйрік болсаң да әлсізсің.
Dialogue: 0,1:11:30.53,1:11:31.37,Default,,0,0,0,,Не!
Dialogue: 0,1:11:32.32,1:11:33.33,Default,,0,0,0,,Хэхе…
Dialogue: 0,1:11:34.37,1:11:35.91,Default,,0,0,0,,Бұл... сенің аяғың.
Dialogue: 0,1:11:36.95,1:11:38.12,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,1:11:39.37,1:11:41.46,Default,,0,0,0,,Сәби кезіндегі ұшақ апаты
Dialogue: 0,1:11:41.96,1:11:43.88,Default,,0,0,0,,Бір ғана адам аман қалды
Dialogue: 0,1:11:44.67,1:11:45.84,Default,,0,0,0,,Мен сәби едім
Dialogue: 0,1:11:46.71,1:11:48.72,Default,,0,0,0,,Әкем де, шешем де есімде жоқ.
Dialogue: 0,1:11:48.80,1:11:52.47,Default,,0,0,0,,(нәресте жылады)
Dialogue: 0,1:11:56.77,1:11:58.77,Default,,0,0,0,,Бірақ мені аяма.
Dialogue: 0,1:11:59.02,1:12:01.19,Default,,0,0,0,,Бұл өте жақсы.
Dialogue: 0,1:12:01.98,1:12:04.06,Default,,0,0,0,,Сіз жалғызсыз ба?
Dialogue: 0,1:12:04.98,1:12:07.82,Default,,0,0,0,,Гүл дүкеніндегі әйел менің асыраушым болды.
Dialogue: 0,1:12:08.40,1:12:09.86,Default,,0,0,0,,Уау, ол сондай жақсы адам.
Dialogue: 0,1:12:10.07,1:12:11.95,Default,,0,0,0,,Сүйіспеншіліксіз үйдегі ілмекті баладан, т.б.
Dialogue: 0,1:12:12.20,1:12:13.87,Default,,0,0,0,,Мен бұл шынымен жақсы болғандай сезінемін.
Dialogue: 0,1:12:14.74,1:12:17.70,Default,,0,0,0,,Хмм, сен де жеңілгенді жек көресің.
Dialogue: 0,1:12:17.83,1:12:18.66,Default,,0,0,0,,Иә?
Dialogue: 0,1:12:18.79,1:12:21.42,Default,,0,0,0,,Ей, дос болайық.
Dialogue: 0,1:12:21.50,1:12:22.33,Default,,0,0,0,,Сау бол, Джоджо!
Dialogue: 0,1:12:22.75,1:12:23.71,Default,,0,0,0,,Мен Харумын
Dialogue: 0,1:12:25.34,1:12:26.21,Default,,0,0,0,,Ю
Dialogue: 0,1:12:26.63,1:12:29.21,Default,,0,0,0,,Біз ұқсаспыз.
Dialogue: 0,1:12:29.51,1:12:30.34,Default,,0,0,0,,Қай жағынан?
Dialogue: 0,1:12:30.42,1:12:31.26,Default,,0,0,0,,Әртүрлі
Dialogue: 0,1:12:37.35,1:12:39.39,Default,,0,0,0,,Grand Angel қонақүйіндегі өрт оқиғасы...
Dialogue: 0,1:12:39.48,1:12:41.06,Default,,0,0,0,,Қазірдің өзінде індет басталғаннан бері үш сағат өтті...
Dialogue: 0,1:12:41.14,1:12:41.98,Default,,0,0,0,,Сіз оралдыңыз ба?
Dialogue: 0,1:12:42.06,1:12:43.02,Default,,0,0,0,,Өрт сөндірілмеген.
Dialogue: 0,1:12:43.40,1:12:46.02,Default,,0,0,0,,Құтқару жұмыстары әлі жалғасуда.
Dialogue: 0,1:12:46.82,1:12:47.86,Default,,0,0,0,,Қайталаңыз
Dialogue: 0,1:12:48.53,1:12:49.36,Default,,0,0,0,,Котона
Dialogue: 0,1:13:00.37,1:13:01.71,Default,,0,0,0,,Котона ұйықтап жатыр.
Dialogue: 0,1:13:02.50,1:13:04.42,Default,,0,0,0,,Ауырына бастады, маған тыныштандыратын дәрі берді.
Dialogue: 0,1:13:05.21,1:13:06.71,Default,,0,0,0,,Ауру асқынып келеді
Dialogue: 0,1:13:07.54,1:13:08.38,Default,,0,0,0,,Корпус
Dialogue: 0,1:13:09.80,1:13:11.97,Default,,0,0,0,,Хал, мұны доғар.
Dialogue: 0,1:13:12.59,1:13:15.68,Default,,0,0,0,,Ханшайымға жақындаған сайын Котонаның жағдайы нашарлайды.
Dialogue: 0,1:13:16.10,1:13:17.89,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:13:17.97,1:13:20.22,Default,,0,0,0,,Сіз оны көрдіңіз бе? Қонақ үйдегі өрт оқиғасы
Dialogue: 0,1:13:20.77,1:13:22.98,Default,,0,0,0,,Патшалыққа шабуылмен резонанс болды.
Dialogue: 0,1:13:23.19,1:13:25.27,Default,,0,0,0,,Ни но Куниде не істеп жатырмыз
Dialogue: 0,1:13:25.35,1:13:27.36,Default,,0,0,0,,Осы бір елге әсер ету
Dialogue: 0,1:13:27.69,1:13:29.65,Default,,0,0,0,,Сіз бұл туралы естідіңіз бе?
Dialogue: 0,1:13:29.73,1:13:32.69,Default,,0,0,0,,Мен Котонаның қасында болып, оны қолдаймын.
Dialogue: 0,1:13:32.78,1:13:34.15,Default,,0,0,0,,Хал, өтінемін.
Dialogue: 0,1:13:34.24,1:13:37.20,Default,,0,0,0,,Ни но Куниге қайтып, ұрысты тоқтатайық.
Dialogue: 0,1:13:37.28,1:13:39.74,Default,,0,0,0,,Олай етпесең, үлкен қиындыққа тап боласың.
Dialogue: 0,1:13:40.87,1:13:44.92,Default,,0,0,0,,Қанша барсам да солай. Мен ханшайымның өмірін аламын.
Dialogue: 0,1:13:45.00,1:13:48.50,Default,,0,0,0,,Хал, сізге жалған ақпарат беріліп жатыр.
Dialogue: 0,1:13:48.67,1:13:50.50,Default,,0,0,0,,Неге екенін білесіз бе?
Dialogue: 0,1:13:50.59,1:13:51.42,Default,,0,0,0,,Ха…
Dialogue: 0,1:13:52.80,1:13:53.88,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,1:13:54.13,1:13:56.18,Default,,0,0,0,,Бұл рыцарь капитан Велса емес пе?
Dialogue: 0,1:13:56.47,1:13:59.26,Default,,0,0,0,,Ол қауіпті әйел. Мен оны алып кетіп, өлтіруім керек пе?
Dialogue: 0,1:14:00.72,1:14:02.98,Default,,0,0,0,,Анықтап көрейік. Менімен жүр, Хару.
Dialogue: 0,1:14:08.86,1:14:09.69,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:12.15,1:14:15.57,Default,,0,0,0,,Сіз «Саки-ни»сіз бе? Сіздің ағаңыз қайда?
Dialogue: 0,1:14:15.65,1:14:16.95,Default,,0,0,0,,Інісі?
Dialogue: 0,1:14:17.07,1:14:20.37,Default,,0,0,0,,Алданба, аяғы ауыр інің бар шығар.
Dialogue: 0,1:14:20.49,1:14:23.87,Default,,0,0,0,,Юу ше? Юудан не қалайсыз?
Dialogue: 0,1:14:24.25,1:14:25.46,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,1:14:25.54,1:14:28.13,Default,,0,0,0,,Жарайды, мен алдымен сенен құтыламын.
Dialogue: 0,1:14:29.92,1:14:31.50,Default,,0,0,0,,Не? Саки әпке
Dialogue: 0,1:14:31.59,1:14:32.42,Default,,0,0,0,,Бұл кім?
Dialogue: 0,1:14:36.84,1:14:38.93,Default,,0,0,0,,Саки-ни, қашайық, жарай ма?
Dialogue: 0,1:14:39.01,1:14:43.02,Default,,0,0,0,,Нух... Уау
Dialogue: 0,1:14:44.06,1:14:45.02,Default,,0,0,0,,Жүру
Dialogue: 0,1:14:52.77,1:14:53.69,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:14:53.78,1:14:55.11,Default,,0,0,0,,Мен бастапқыда адам емеспін.
Dialogue: 0,1:14:55.19,1:14:56.45,Default,,0,0,0,,Мені қуып бара жатыр
Dialogue: 0,1:14:56.53,1:14:58.16,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,1:14:58.57,1:15:00.62,Default,,0,0,0,,Ол Ни но Куниден келген өлтіруші.
Dialogue: 0,1:15:01.03,1:15:02.91,Default,,0,0,0,,Шамасы, ол паук тәрізді болуы мүмкін.
Dialogue: 0,1:15:02.99,1:15:05.41,Default,,0,0,0,,Бұл не? Мен аудармасын түсінбеймін
Dialogue: 0,1:15:05.66,1:15:07.75,Default,,0,0,0,,Бірақ ол неге Саки-ниді таңдады?
Dialogue: 0,1:15:08.21,1:15:10.92,Default,,0,0,0,,Саки-ниге ұқсайтын Верса-сан жау қолына түсті.
Dialogue: 0,1:15:11.00,1:15:12.59,Default,,0,0,0,,Оны жалғыз қалдырсаң, ол сені өлтіреді.
Dialogue: 0,1:15:12.67,1:15:15.63,Default,,0,0,0,,Мен Саки-нидің де осындай тағдырға ұшырау мүмкіндігі бар деп ойладым.
Dialogue: 0,1:15:15.76,1:15:17.76,Default,,0,0,0,,Бұл өмірдің байланысы.
Dialogue: 0,1:15:18.13,1:15:19.05,Default,,0,0,0,,Бұл...
Dialogue: 0,1:15:19.13,1:15:22.01,Default,,0,0,0,,Әдеттегідей, сіз шынымен түсінбейсіз.
Dialogue: 0,1:15:22.60,1:15:24.77,Default,,0,0,0,,Ол: «Сіз Саки-нисіз бе?» деді.
Dialogue: 0,1:15:24.85,1:15:27.31,Default,,0,0,0,,Мен айттым, сен қайдан білесің?
Dialogue: 0,1:15:27.39,1:15:29.48,Default,,0,0,0,,Не? Ол мұны айтты ма?
Dialogue: 0,1:15:29.56,1:15:33.73,Default,,0,0,0,,Мені Саки-ни деп атайтын жалғыз сенсің.
Dialogue: 0,1:15:34.23,1:15:37.53,Default,,0,0,0,,Бұзық адамның мені Саки-ни дейтін себебі жоқ.
Dialogue: 0,1:15:38.03,1:15:39.03,Default,,0,0,0,,А...
Dialogue: 0,1:15:39.28,1:15:40.74,Default,,0,0,0,,Не болды? Юу
Dialogue: 0,1:15:42.28,1:15:44.66,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:15:44.83,1:15:47.04,Default,,0,0,0,,Мен түсінемін, мен бәрін түсінемін.
Dialogue: 0,1:15:47.12,1:15:48.16,Default,,0,0,0,,Не? Не?
Dialogue: 0,1:15:48.25,1:15:49.21,Default,,0,0,0,,Уау
Dialogue: 0,1:15:57.01,1:15:57.97,Default,,0,0,0,,Ах!
Dialogue: 0,1:16:04.43,1:16:06.22,Default,,0,0,0,,Саки-ни, бұл оң жақта.
Dialogue: 0,1:16:09.14,1:16:09.98,Default,,0,0,0,,Иә!
Dialogue: 0,1:16:10.06,1:16:12.90,Default,,0,0,0,,Сіз қалай ойлайсыз? Мен... менің техникам
Dialogue: 0,1:16:13.02,1:16:14.23,Default,,0,0,0,,Саки-ни бұрын!
Dialogue: 0,1:16:14.77,1:16:18.49,Default,,0,0,0,,(Үш адам айғайлайды)
Dialogue: 0,1:16:46.51,1:16:48.10,Default,,0,0,0,,Сіз Юусыз
Dialogue: 0,1:16:48.18,1:16:49.02,Default,,0,0,0,,Ю
Dialogue: 0,1:16:49.10,1:16:53.06,Default,,0,0,0,,Сен мұнда не үшін келдің? Біз шайқастың ортасындамыз.
Dialogue: 0,1:16:53.15,1:16:55.69,Default,,0,0,0,,Мен мұнда соғысу үшін келдім.
Dialogue: 0,1:16:56.19,1:16:58.57,Default,,0,0,0,,Бұл сенің ұрысатын жерің емес.
Dialogue: 0,1:16:58.82,1:17:00.24,Default,,0,0,0,,Жоқ, міне.
Dialogue: 0,1:17:00.65,1:17:01.57,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,1:17:02.20,1:17:05.57,Default,,0,0,0,,Бұл патшалықтың сатқыны сенсің.
Dialogue: 0,1:17:06.33,1:17:07.74,Default,,0,0,0,,Бірақ егер біз мұнда сүрінсек, Құрылтайшы Титанға қарсы ешқашан мүмкіндігіміз болмайды.
Dialogue: 0,1:17:08.16,1:17:09.62,Default,,0,0,0,,Мен бұл туралы ойладым.
Dialogue: 0,1:17:10.25,1:17:14.42,Default,,0,0,0,,Ханшайымды өлтірмек болған қылмыскер неліктен қарғыс атқан қанжарды пайдаланды?
Dialogue: 0,1:17:15.29,1:17:17.92,Default,,0,0,0,,Кінәлі патша қорғауы туралы білген.
Dialogue: 0,1:17:18.80,1:17:21.67,Default,,0,0,0,,Аша ханшайымды оңай өлтіру мүмкін емес.
Dialogue: 0,1:17:23.38,1:17:27.05,Default,,0,0,0,,Сондықтан мен ханшайымды өлтірмек болған адамды ойладым
Dialogue: 0,1:17:27.22,1:17:29.77,Default,,0,0,0,,Мен бұл патшалықта болуы мүмкін деп ойладым.
Dialogue: 0,1:17:29.89,1:17:31.06,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:32.06,1:17:33.31,Default,,0,0,0,,Тағы бір нәрсе
Dialogue: 0,1:17:33.89,1:17:37.90,Default,,0,0,0,,Бізге шабуыл жасаған өлтіруші Саки-ниді «Саки-ни» деп атады.
Dialogue: 0,1:17:38.48,1:17:41.82,Default,,0,0,0,,Неліктен Ни но Куни өлтіруші бұл есімді білген?
Dialogue: 0,1:17:42.40,1:17:45.20,Default,,0,0,0,,Хмм... Мен олай ойламаймын.
Dialogue: 0,1:17:45.28,1:17:48.28,Default,,0,0,0,,Сіз өлтіруші менің ақшам деп айтқыңыз келе ме?
Dialogue: 0,1:17:48.41,1:17:50.33,Default,,0,0,0,,Мен саған неге күмәнданамын?
Dialogue: 0,1:17:53.08,1:17:54.75,Default,,0,0,0,,Тағы бір нәрсе бар.
Dialogue: 0,1:17:56.21,1:17:57.63,Default,,0,0,0,,Бұл иіс.
Dialogue: 0,1:17:58.13,1:18:00.13,Default,,0,0,0,,Мен саған қол тигізгенде
Dialogue: 0,1:18:00.42,1:18:03.72,Default,,0,0,0,,Сен сол қара қанжардың иісін сездің.
Dialogue: 0,1:18:04.38,1:18:05.43,Default,,0,0,0,,Неге...
Dialogue: 0,1:18:06.13,1:18:10.64,Default,,0,0,0,,Сонымен, қара қанжарды сен жаратқансың.
Dialogue: 0,1:18:12.60,1:18:14.64,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:18:14.94,1:18:17.15,Default,,0,0,0,,Иіс туралы не деуге болады? Бұл күлкілі
Dialogue: 0,1:18:17.27,1:18:19.65,Default,,0,0,0,,Осы себепті маған күмәндануға қалай дәтің бар?
Dialogue: 0,1:18:19.77,1:18:22.61,Default,,0,0,0,,Ха... Сиқырда иіс бар.
Dialogue: 0,1:18:23.82,1:18:27.99,Default,,0,0,0,,Бұл жай ғана иіс емес. Сиқыр да із қалдырады.
Dialogue: 0,1:18:28.32,1:18:31.20,Default,,0,0,0,,Сиқырлы канцлер ретінде сіз білуіңіз керек.
Dialogue: 0,1:18:32.16,1:18:34.50,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:18:35.08,1:18:37.79,Default,,0,0,0,,Мені қарғаған өлтірушінің денесінде...
Dialogue: 0,1:18:37.92,1:18:39.67,Default,,0,0,0,,Король әулетінің батасын алып қайтты.
Dialogue: 0,1:18:39.79,1:18:41.84,Default,,0,0,0,,Қарғыс ізі қашалған
Dialogue: 0,1:18:42.71,1:18:46.55,Default,,0,0,0,,Күмәнді сейілткіңіз келсе, денеңізді көрсетіңіз.
Dialogue: 0,1:18:51.18,1:18:52.18,Default,,0,0,0,,Корпус
Dialogue: 0,1:18:52.26,1:18:53.89,Default,,0,0,0,,​​Бұл нені білдіреді?
Dialogue: 0,1:18:54.22,1:18:57.06,Default,,0,0,0,,Маған әлгі Габарас деген жігіттің не айтқаны қызық болды.
Dialogue: 0,1:18:57.14,1:19:01.40,Default,,0,0,0,,Бұл дүние арман емес пе?
Dialogue: 0,1:19:01.48,1:19:06.07,Default,,0,0,0,,Түсінде біреуді өлтіруден маңызды ештеңе жоқ.
Dialogue: 0,1:19:06.15,1:19:07.40,Default,,0,0,0,,Габарас
Dialogue: 0,1:19:07.49,1:19:10.45,Default,,0,0,0,,Ол осы сарайда біздің әңгімемізді тыңдап тұрғандай болды.
Dialogue: 0,1:19:10.53,1:19:12.24,Default,,0,0,0,,Енді мағынасы бар.
Dialogue: 0,1:19:12.33,1:19:16.08,Default,,0,0,0,,Басқыншы жау әскерінің қимылдары... Ол бұл елдің бәрін білген.
Dialogue: 0,1:19:16.16,1:19:18.37,Default,,0,0,0,,Велса мырза, жақсысыз ба?
Dialogue: 0,1:19:18.67,1:19:22.17,Default,,0,0,0,,А-а, бақытымызға орай, күзетші күзетімді түсіріп жіберді, мен қашып құтылдым.
Dialogue: 0,1:19:22.29,1:19:24.25,Default,,0,0,0,,Саки-ни де аман қалды.
Dialogue: 0,1:19:24.34,1:19:25.17,Default,,0,0,0,,О
Dialogue: 0,1:19:25.26,1:19:26.72,Default,,0,0,0,,Аспаз…
Dialogue: 0,1:19:27.22,1:19:30.09,Default,,0,0,0,,Түсіндім, көмектесу мүмкін емес.
Dialogue: 0,1:19:33.14,1:19:33.97,Default,,0,0,0,,Ах...
Dialogue: 0,1:19:36.48,1:19:38.73,Default,,0,0,0,,Сіздің көңіліңіз қалай?
Dialogue: 0,1:19:38.81,1:19:42.15,Default,,0,0,0,,Мәртебелі, жау жауынгерлері жақындап келеді...
Dialogue: 0,1:19:42.94,1:19:45.32,Default,,0,0,0,,А... бұл не?
Dialogue: 0,1:19:45.82,1:19:49.86,Default,,0,0,0,,Мм... Меніңше, әртістер бірге шығар?
Dialogue: 0,1:19:50.49,1:19:54.33,Default,,0,0,0,,Онда мен сені бәрің өлгенше осында қалдырамын!
Dialogue: 0,1:20:01.29,1:20:02.17,Default,,0,0,0,,Ах...
Dialogue: 0,1:20:02.63,1:20:03.46,Default,,0,0,0,,Сіз...
Dialogue: 0,1:20:03.84,1:20:05.13,Default,,0,0,0,,Кукукуку…
Dialogue: 0,1:20:05.67,1:20:09.26,Default,,0,0,0,,Эстабания патшалығының сиқырлы премьер-министрі Йоки Гений
Dialogue: 0,1:20:09.38,1:20:12.76,Default,,0,0,0,,Менің басқа жүзім...
Dialogue: 0,1:20:13.43,1:20:16.97,Default,,0,0,0,,Қара туды армия жетекшісі Габарас Фолгарн
Dialogue: 0,1:20:17.47,1:20:19.27,Default,,0,0,0,,Сол екеу ме?
Dialogue: 0,1:20:19.35,1:20:24.31,Default,,0,0,0,,Ханшайым, сенің денеңде үлкен сиқырлы күш бар.
Dialogue: 0,1:20:24.61,1:20:27.65,Default,,0,0,0,,Бұл мен ең қалайтын күш
Dialogue: 0,1:20:27.90,1:20:31.74,Default,,0,0,0,,Мен сол билікті алып, төңкеріс жасаймын.
Dialogue: 0,1:20:31.82,1:20:33.24,Default,,0,0,0,,Революция?
Dialogue: 0,1:20:33.66,1:20:38.37,Default,,0,0,0,,Шын мәнінде патша болуы керек адам мен едім.
Dialogue: 0,1:20:38.95,1:20:41.12,Default,,0,0,0,,Не? Сіз...
Dialogue: 0,1:20:41.67,1:20:42.71,Default,,0,0,0,,Патша болу?
Dialogue: 0,1:20:42.79,1:20:44.88,Default,,0,0,0,,Бұл жігіт... Мен бұған сене алар емеспін.
Dialogue: 0,1:20:44.96,1:20:49.21,Default,,0,0,0,,Иә, мен сенің ағаң Теодия Арцеоспын.
Dialogue: 0,1:20:49.30,1:20:52.88,Default,,0,0,0,,Ол осы Эстабания патшалығының бірінші князі болды.
Dialogue: 0,1:20:52.97,1:20:55.68,Default,,0,0,0,,Лорд Сейодия қайтыс болуы керек еді.
Dialogue: 0,1:20:55.80,1:20:57.43,Default,,0,0,0,,Өтірік айтатын намыссыз адам!
Dialogue: 0,1:20:57.51,1:20:59.14,Default,,0,0,0,,Мен қайтып келдім
Dialogue: 0,1:20:59.22,1:21:01.10,Default,,0,0,0,,Алхимия бойынша
Dialogue: 0,1:21:01.18,1:21:04.27,Default,,0,0,0,,Құбыжықтың қаны мен етінен жаңа дене жасалды.
Dialogue: 0,1:21:04.90,1:21:07.15,Default,,0,0,0,,Бұл шынымен Seiodia-sama ма?
Dialogue: 0,1:21:07.23,1:21:12.86,Default,,0,0,0,,Өмірімді әкемнен алған қасіретті ешқашан ұмытпаймын.
Dialogue: 0,1:21:14.07,1:21:15.66,Default,,0,0,0,,О Фландрия
Dialogue: 0,1:21:16.24,1:21:19.24,Default,,0,0,0,,Мені әкем мен шешем жақсы көрді. Сіз түсінбейсіз.
Dialogue: 0,1:21:19.70,1:21:23.21,Default,,0,0,0,,Ағамның мұңын аңғара алмай жүргенім рас.
Dialogue: 0,1:21:23.29,1:21:24.12,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,1:21:25.00,1:21:26.04,Default,,0,0,0,,Иә.
Dialogue: 0,1:21:26.42,1:21:30.51,Default,,0,0,0,,Мен әкемнің тастап кеткен үмітін түсіне алмаймын.
Dialogue: 0,1:21:31.42,1:21:35.84,Default,,0,0,0,,Елді қорғау желеуімен...
Dialogue: 0,1:21:36.30,1:21:38.93,Default,,0,0,0,,Бадерония деген жау елі қабылдаған
Dialogue: 0,1:21:39.72,1:21:41.52,Default,,0,0,0,,Ол кепілге алынды.
Dialogue: 0,1:21:42.35,1:21:46.65,Default,,0,0,0,,Бірақ мен сол жерден кішкене бақыт таптым.
Dialogue: 0,1:21:47.69,1:21:51.07,Default,,0,0,0,,Сүйікті жарымен танысып, балалы болды.
Dialogue: 0,1:21:51.69,1:21:55.32,Default,,0,0,0,,Бірақ әкем Баделонияға шабуыл жасап, оны жойып жіберді...
Dialogue: 0,1:21:55.78,1:21:58.66,Default,,0,0,0,,Менің кішкентай бақытым да жойылды
Dialogue: 0,1:21:59.08,1:22:01.16,Default,,0,0,0,,Менен бәрі алынды
Dialogue: 0,1:22:01.58,1:22:05.00,Default,,0,0,0,,Корольдік отбасының мүшесі ретіндегі мақтаныш және ата-ана мен бала арасындағы байланыс
Dialogue: 0,1:22:05.42,1:22:07.21,Default,,0,0,0,,Тіпті сіз жақсы көретін адамдар
Dialogue: 0,1:22:08.42,1:22:09.67,Default,,0,0,0,,Кек үшін -
Dialogue: 0,1:22:09.75,1:22:13.26,Default,,0,0,0,,Ол сиқырлы премьер-министр болып елге қызмет етті, жасырынып жүрді дейсіз бе?
Dialogue: 0,1:22:13.34,1:22:14.97,Default,,0,0,0,,Кек алу?
Dialogue: 0,1:22:15.13,1:22:18.55,Default,,0,0,0,,Мен мұндай қарапайым эмоциялармен әрекет етпеймін.
Dialogue: 0,1:22:18.64,1:22:21.56,Default,,0,0,0,,Әке үнемі өкінетін.
Dialogue: 0,1:22:21.64,1:22:23.14,Default,,0,0,0,,Баделония туралы не деуге болады?
Dialogue: 0,1:22:23.22,1:22:26.39,Default,,0,0,0,,Ол кезде Эстабанияның амалы қалмады.
Dialogue: 0,1:22:26.48,1:22:27.40,Default,,0,0,0,,Рұқсат етілмейді!
Dialogue: 0,1:22:27.52,1:22:30.23,Default,,0,0,0,,Өйткені мен дәрменсіз, қабілетсіз патшадан туғанмын.
Dialogue: 0,1:22:30.32,1:22:32.03,Default,,0,0,0,,Мен бақытсыздықты көтердім
Dialogue: 0,1:22:32.11,1:22:36.07,Default,,0,0,0,,Сондықтан менде абсолютті билік бар
Dialogue: 0,1:22:36.15,1:22:38.41,Default,,0,0,0,,Ол жаңа патша болады.
Dialogue: 0,1:22:41.58,1:22:43.75,Default,,0,0,0,,Мен ханшайымды бір саусақпен ұстауға рұқсат етпеймін.
Dialogue: 0,1:22:43.83,1:22:47.12,Default,,0,0,0,,Сіз сияқты біреу мені тоқтата ала ма?
Dialogue: 0,1:22:47.21,1:22:48.21,Default,,0,0,0,,Уау
Dialogue: 0,1:22:53.80,1:22:55.88,Default,,0,0,0,,Мені өлтірсең, сен де өлесің.
Dialogue: 0,1:22:55.97,1:22:59.84,Default,,0,0,0,,Хехехе... қорғаныш сиқыры дейсіз бе?
Dialogue: 0,1:23:00.14,1:23:04.06,Default,,0,0,0,,Онда өлуге дайын адам жасасын.
Dialogue: 0,1:23:09.44,1:23:10.27,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:23:23.45,1:23:25.20,Default,,0,0,0,,Хару Сізді басқарып жатыр ма?
Dialogue: 0,1:23:26.25,1:23:27.71,Default,,0,0,0,,Тоқта, Хару.
Dialogue: 0,1:23:28.29,1:23:31.79,Default,,0,0,0,,Енді ханшайымды өз қолыңмен өлтір.
Dialogue: 0,1:23:32.29,1:23:34.05,Default,,0,0,0,,Уау
Dialogue: 0,1:23:34.13,1:23:34.96,Default,,0,0,0,,Ю!
Dialogue: 0,1:23:39.38,1:23:41.05,Default,,0,0,0,,Котона Мықты болыңыз!
Dialogue: 0,1:23:41.14,1:23:41.97,Default,,0,0,0,,Котона!
Dialogue: 0,1:23:48.56,1:23:49.56,Default,,0,0,0,,Котона…
Dialogue: 0,1:23:52.27,1:23:53.36,Default,,0,0,0,,Әлде бұл өкпеден бе? Карс
Dialogue: 0,1:24:12.71,1:24:13.67,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,1:24:14.71,1:24:15.55,Default,,0,0,0,,Уау
Dialogue: 0,1:24:17.26,1:24:18.26,Default,,0,0,0,,О...
Dialogue: 0,1:24:20.26,1:24:21.76,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:24:23.72,1:24:26.01,Default,,0,0,0,,Хмф... Пайдасыз.
Dialogue: 0,1:24:26.51,1:24:32.19,Default,,0,0,0,,Өзіңіз жақсы көретін адамды өз қолыңызға алу қызық болды.
Dialogue: 0,1:24:34.15,1:24:35.19,Default,,0,0,0,,Мына адамға қара.
Dialogue: 0,1:24:35.86,1:24:38.40,Default,,0,0,0,,Ол Халды алдап, бізбен соғысты.
Dialogue: 0,1:24:39.78,1:24:41.65,Default,,0,0,0,,Мен сені кешірмеймін
Dialogue: 0,1:24:42.66,1:24:43.78,Default,,0,0,0,,Хаха...
Dialogue: 0,1:24:44.82,1:24:45.70,Default,,0,0,0,,Уау
Dialogue: 0,1:24:47.54,1:24:49.16,Default,,0,0,0,,Әй... Ханшайым!
Dialogue: 0,1:24:49.66,1:24:51.66,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:24:52.29,1:24:53.67,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:24:56.63,1:24:58.38,Default,,0,0,0,,Аша!
Dialogue: 0,1:25:03.93,1:25:06.81,Default,,0,0,0,,(Габараның күлкісі)
Dialogue: 0,1:25:15.06,1:25:16.98,Default,,0,0,0,,Ашаның қорғаныш сиқыры бар.
Dialogue: 0,1:25:17.48,1:25:18.73,Default,,0,0,0,,Ах, өрттен келтірілген зиянды жөндеп жатқанда, мен де біраз жөндеу жұмыстарын жүргізгім келеді
Dialogue: 0,1:25:18.82,1:25:20.61,Default,,0,0,0,,Әрине
Dialogue: 0,1:25:21.19,1:25:22.24,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:25:24.82,1:25:27.16,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,1:25:27.24,1:25:28.08,Default,,0,0,0,,Хмф!
Dialogue: 0,1:25:31.58,1:25:32.41,Default,,0,0,0,,Аша!
Dialogue: 0,1:25:34.12,1:25:35.42,Default,,0,0,0,,Уууух! Ах, бұл кактус екен!
Dialogue: 0,1:25:37.25,1:25:37.79,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,1:25:39.13,1:25:40.67,Default,,0,0,0,,Ха... Юу
Dialogue: 0,1:25:41.05,1:25:42.63,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,1:25:44.72,1:25:46.55,Default,,0,0,0,,Мықты бол, Юу.
Dialogue: 0,1:25:48.47,1:25:51.14,Default,,0,0,0,,Міне... мен үшін.
Dialogue: 0,1:25:51.68,1:25:52.85,Default,,0,0,0,,Бұл неге...
Dialogue: 0,1:25:53.73,1:25:55.94,Default,,0,0,0,,Мықты болыңыз
Dialogue: 0,1:25:59.27,1:26:00.32,Default,,0,0,0,,Ю
Dialogue: 0,1:26:00.86,1:26:01.69,Default,,0,0,0,,Ю
Dialogue: 0,1:26:04.20,1:26:07.07,Default,,0,0,0,,Мен ол жігітті кешіре алмаймын.
Dialogue: 0,1:26:13.37,1:26:15.17,Default,,0,0,0,,Кешіріңіз Юу
Dialogue: 0,1:26:15.83,1:26:17.75,Default,,0,0,0,,Күте тұр, Юу.
Dialogue: 0,1:26:18.96,1:26:21.50,Default,,0,0,0,,Хару… Аша…
Dialogue: 0,1:26:32.35,1:26:35.02,Default,,0,0,0,,Сіз бұл туралы ойладыңыз ба?
Dialogue: 0,1:26:38.27,1:26:41.11,Default,,0,0,0,,Сіз ешқашан кешірмейсіз
Dialogue: 0,1:26:46.91,1:26:47.74,Default,,0,0,0,,Хо…
Dialogue: 0,1:26:47.82,1:26:49.45,Default,,0,0,0,,Әлде бұл өкпеден бе? Карс
Dialogue: 0,1:26:52.45,1:26:55.41,Default,,0,0,0,,Юу, сізде бар еді.
Dialogue: 0,1:26:56.29,1:27:00.54,Default,,0,0,0,,Баяғыда мен жақын адамдарымды қорғауға бел байладым.
Dialogue: 0,1:27:04.17,1:27:05.05,Default,,0,0,0,,(Ашаның айқайы)
Dialogue: 0,1:27:09.22,1:27:11.05,Default,,0,0,0,,(Габараның күлкісі)
Dialogue: 0,1:27:13.68,1:27:14.81,Default,,0,0,0,,Ата
Dialogue: 0,1:27:15.35,1:27:18.06,Default,,0,0,0,,Юбо Біраз уақыт өтті.
Dialogue: 0,1:27:18.48,1:27:19.73,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,1:27:19.85,1:27:22.32,Default,,0,0,0,,Айя~ Соңғы жылдарға байланысты ма?
Dialogue: 0,1:27:22.40,1:27:25.19,Default,,0,0,0,,Қақпаны ашу үшін көп күш жұмсалды.
Dialogue: 0,1:27:26.19,1:27:29.57,Default,,0,0,0,,Өлімнен қорқасың ба?
Dialogue: 0,1:27:31.45,1:27:32.49,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,1:27:33.12,1:27:36.00,Default,,0,0,0,,Бірақ одан да қорқыныштысы...
Dialogue: 0,1:27:36.20,1:27:38.41,Default,,0,0,0,,Маңызды нәрсені қорғай алмау
Dialogue: 0,1:27:41.38,1:27:42.21,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:27:42.75,1:27:44.30,Default,,0,0,0,,Бұл сізге арналған
Dialogue: 0,1:27:45.38,1:27:49.72,Default,,0,0,0,,Таңдалғандар ғана иеленуге рұқсат етілген батырдың дәлелі.
Dialogue: 0,1:27:49.80,1:27:52.85,Default,,0,0,0,,Тоқта, неге мен?
Dialogue: 0,1:27:53.14,1:27:57.10,Default,,0,0,0,,Әрине, сіз оған лайықсыз.
Dialogue: 0,1:27:57.56,1:27:59.69,Default,,0,0,0,,Мен көптен бері іздедім
Dialogue: 0,1:28:00.19,1:28:02.36,Default,,0,0,0,,Мұны кімге мұрагер ету керек?
Dialogue: 0,1:28:02.86,1:28:05.36,Default,,0,0,0,,Уау, бұл қиын болды.
Dialogue: 0,1:28:05.61,1:28:08.78,Default,,0,0,0,,Ұлы күшке лайық адам
Dialogue: 0,1:28:08.86,1:28:12.24,Default,,0,0,0,,Ол кез келген дәуірде міндетті түрде болмайды.
Dialogue: 0,1:28:17.00,1:28:19.37,Default,,0,0,0,,Енді қайтайық.
Dialogue: 0,1:28:20.12,1:28:22.88,Default,,0,0,0,,Мики-сан сені іздеп жүрген шығар.
Dialogue: 0,1:28:22.96,1:28:24.79,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:28:25.59,1:28:26.71,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,1:28:33.72,1:28:35.26,Default,,0,0,0,,Аяқтау
Dialogue: 0,1:28:52.45,1:28:54.49,Default,,0,0,0,,...
Dialogue: 0,1:28:59.16,1:29:00.16,Default,,0,0,0,,Ах...
Dialogue: 0,1:29:00.79,1:29:01.62,Default,,0,0,0,,Ханшайым!
Dialogue: 0,1:29:01.71,1:29:03.21,Default,,0,0,0,,Сол жігіт осы сапарға қосыла алмайды!
Dialogue: 0,1:29:03.29,1:29:05.63,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:29:06.09,1:29:06.96,Default,,0,0,0,,Уф...
Dialogue: 0,1:29:09.21,1:29:11.51,Default,,0,0,0,,Кел, өміріңді өртеп жібер.
Dialogue: 0,1:29:11.59,1:29:16.14,Default,,0,0,0,,Маған өзіңіздің керемет сиқырлы күшіңізді ұсыныңыз.
Dialogue: 0,1:29:16.22,1:29:17.51,Default,,0,0,0,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,1:29:17.60,1:29:20.35,Default,,0,0,0,,Маған кедергі жасама. Бұл көздің жауын алады.
Dialogue: 0,1:29:20.85,1:29:22.19,Default,,0,0,0,,Уау
Dialogue: 0,1:29:32.07,1:29:35.57,Default,,0,0,0,,Сен бірінші сені өлтіргенімді қалайсың ба?
Dialogue: 0,1:29:37.28,1:29:39.74,Default,,0,0,0,,Ең алдымен, сіз.
Dialogue: 0,1:29:44.92,1:29:46.25,Default,,0,0,0,,Ах... Қарғыс атсын!
Dialogue: 0,1:29:47.79,1:29:48.92,Default,,0,0,0,,Ю!
Dialogue: 0,1:29:49.84,1:29:53.26,Default,,0,0,0,,Сіз әлі тірісіз бе?
Dialogue: 0,1:29:53.34,1:29:56.84,Default,,0,0,0,,Бұл жағдайда мен оны толығымен өшіремін.
Dialogue: 0,1:29:56.93,1:29:59.43,Default,,0,0,0,,Мен үшін де жаман, хаха
Dialogue: 0,1:30:02.10,1:30:03.94,Default,,0,0,0,,Мен қорғаймын (Аша) Ю
Dialogue: 0,1:30:04.94,1:30:06.56,Default,,0,0,0,,Маңызды нәрсе...
Dialogue: 0,1:30:07.11,1:30:09.61,Default,,0,0,0,,Менің сүйіктім!
Dialogue: 0,1:30:11.82,1:30:14.11,Default,,0,0,0,,Не? Уф...
Dialogue: 0,1:30:41.85,1:30:42.77,Default,,0,0,0,,Ю
Dialogue: 0,1:30:43.39,1:30:44.23,Default,,0,0,0,,Ю!
Dialogue: 0,1:30:45.69,1:30:47.40,Default,,0,0,0,,Мен сенбеймін
Dialogue: 0,1:30:47.85,1:30:48.81,Default,,0,0,0,,Бұл...
Dialogue: 0,1:30:49.15,1:30:51.27,Default,,0,0,0,,Дұрыс, Гладион.
Dialogue: 0,1:30:51.82,1:30:54.15,Default,,0,0,0,,Неге мұндасың?
Dialogue: 0,1:30:54.65,1:30:56.49,Default,,0,0,0,,Гладион ше?
Dialogue: 0,1:30:56.65,1:30:59.12,Default,,0,0,0,,Хаха... Бұған не болды?
Dialogue: 0,1:31:00.28,1:31:01.78,Default,,0,0,0,,(Ашаның айқайы)
Dialogue: 0,1:31:02.62,1:31:04.91,Default,,0,0,0,,Аша мен... мұраға қалған билік.
Dialogue: 0,1:31:05.00,1:31:08.29,Default,,0,0,0,,Егер мен күшімді біріктірсем, мен жеңілмейтін боламын.
Dialogue: 0,1:31:09.00,1:31:12.04,Default,,0,0,0,,Аспандағы ханшайымның билігін ұрлағысы келеді.
Dialogue: 0,1:31:13.38,1:31:15.80,Default,,0,0,0,,Осымен мен сенің жолыңа түсе алмаймын.
Dialogue: 0,1:31:19.59,1:31:21.05,Default,,0,0,0,,Ах...
Dialogue: 0,1:31:22.51,1:31:24.14,Default,,0,0,0,,Уа, олар маған шабуыл жасап жатыр.
Dialogue: 0,1:31:30.02,1:31:33.40,Default,,0,0,0,,Құс, маған күшіңді бер
Dialogue: 0,1:31:37.24,1:31:38.40,Default,,0,0,0,,Ю!
Dialogue: 0,1:31:39.82,1:31:40.70,Default,,0,0,0,,Не?
Dialogue: 0,1:31:40.78,1:31:42.20,Default,,0,0,0,,Әлде бұл өкпеден бе? Карс
Dialogue: 0,1:31:43.78,1:31:44.95,Default,,0,0,0,,Уау
Dialogue: 0,1:31:45.04,1:31:46.41,Default,,0,0,0,,Ах...
Dialogue: 0,1:32:06.68,1:32:08.14,Default,,0,0,0,,Әлде бұл өкпеден бе? Карс
Dialogue: 0,1:32:21.36,1:32:23.99,Default,,0,0,0,,Сонда бұл туралы не деуге болады?
Dialogue: 0,1:32:24.87,1:32:26.37,Default,,0,0,0,,Ах... а...
Dialogue: 0,1:32:26.74,1:32:27.79,Default,,0,0,0,,Ха... кетті.
Dialogue: 0,1:32:35.55,1:32:37.88,Default,,0,0,0,,Уау уау
Dialogue: 0,1:32:40.97,1:32:43.89,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:32:43.97,1:32:47.89,Default,,0,0,0,,Бұл шайқас хахаха...
Dialogue: 0,1:32:48.35,1:32:50.27,Default,,0,0,0,,Бітті, солай емес пе?
Dialogue: 0,1:32:53.19,1:32:54.02,Default,,0,0,0,,(Танжиро) Бірақ құбыжықтар жалғыз жүруі керек еді ғой?
Dialogue: 0,1:32:54.11,1:32:56.86,Default,,0,0,0,,Қылыш саған не болды?
Dialogue: 0,1:33:02.78,1:33:04.28,Default,,0,0,0,,Қабыл ал!
Dialogue: 0,1:33:05.41,1:33:06.62,Default,,0,0,0,,Итадаки!
Dialogue: 0,1:33:07.45,1:33:09.79,Default,,0,0,0,,Әлде бұл өкпеден бе? Карс
Dialogue: 0,1:33:09.87,1:33:10.71,Default,,0,0,0,,Ой, жаңбыр жауып тұр—
Dialogue: 0,1:33:11.12,1:33:13.71,Default,,0,0,0,,Шыу!
Dialogue: 0,1:33:28.76,1:33:32.10,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,1:33:41.19,1:33:42.40,Default,,0,0,0,,Иә!
Dialogue: 0,1:33:44.82,1:33:46.24,Default,,0,0,0,,О...
Dialogue: 0,1:34:06.18,1:34:07.01,Default,,0,0,0,,Ю!
Dialogue: 0,1:34:09.64,1:34:10.47,Default,,0,0,0,,Аша
Dialogue: 0,1:34:11.10,1:34:12.68,Default,,0,0,0,,Осылайша әлем бейбітшілік кейпін сақтайды
Dialogue: 0,1:34:12.77,1:34:15.10,Default,,0,0,0,,Шайқас бітті ме?
Dialogue: 0,1:34:15.27,1:34:17.90,Default,,0,0,0,,Иә, Габарас жеңілді.
Dialogue: 0,1:34:18.06,1:34:20.40,Default,,0,0,0,,Жау жауынгерлері шегінді.
Dialogue: 0,1:34:21.65,1:34:25.11,Default,,0,0,0,,Ағамның жаны тыныш болсын.
Dialogue: 0,1:34:25.82,1:34:30.74,Default,,0,0,0,,Біз мұны өсиет ретінде қабылдап, соғыссыз әлем құруымыз керек.
Dialogue: 0,1:34:30.83,1:34:35.25,Default,,0,0,0,,Енді құрлыққа тыныштық орнайды деп сенемін.
Dialogue: 0,1:34:35.67,1:34:36.50,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:34:37.04,1:34:38.83,Default,,0,0,0,,Мәртебелі, ханшайым…
Dialogue: 0,1:34:39.09,1:34:41.50,Default,,0,0,0,,Екеуіңіздің де қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,1:34:41.75,1:34:43.26,Default,,0,0,0,,Балтон жақсы ма?
Dialogue: 0,1:34:43.76,1:34:46.59,Default,,0,0,0,,Бұл Балтон өлмейтін.
Dialogue: 0,1:34:46.76,1:34:47.68,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:34:47.93,1:34:49.64,Default,,0,0,0,,Ал сендер балалар
Dialogue: 0,1:34:50.10,1:34:52.56,Default,,0,0,0,,Жақсы жұмыс, сен бұл елді құтқардың.
Dialogue: 0,1:34:52.89,1:34:55.73,Default,,0,0,0,,Мен сізге тағы да алғыс айтқым келеді.
Dialogue: 0,1:34:57.10,1:35:00.48,Default,,0,0,0,,Біз жай ғана біз үшін маңызды нәрсе үшін күрестік.
Dialogue: 0,1:35:00.56,1:35:01.86,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:35:02.32,1:35:05.24,Default,,0,0,0,,Екеуі саяхатшы еді ғой.
Dialogue: 0,1:35:05.65,1:35:08.61,Default,,0,0,0,,Жоқ, Юу және оның достары әлемдер арасында саяхаттай алды.
Dialogue: 0,1:35:08.78,1:35:10.83,Default,,0,0,0,,Ғабалас құдіретінің арқасында
Dialogue: 0,1:35:11.45,1:35:12.62,Default,,0,0,0,,(Қыңқыл) Бірақ қазір менде қорқыныштың бір ұшқыны да жоқ
Dialogue: 0,1:35:15.58,1:35:18.54,Default,,0,0,0,,Ю Харумен қоштасу.
Dialogue: 0,1:35:18.62,1:35:19.46,Default,,0,0,0,,Иә?
Dialogue: 0,1:35:19.83,1:35:21.63,Default,,0,0,0,,Сол қақпа жабылған соң
Dialogue: 0,1:35:22.09,1:35:24.42,Default,,0,0,0,,Басқа ел мен екі елдің арасында алға-артқа жүру
Dialogue: 0,1:35:24.51,1:35:25.80,Default,,0,0,0,,Енді сіз жасай алмайсыз
Dialogue: 0,1:35:26.22,1:35:27.97,Default,,0,0,0,,Габараның аяқталуымен
Dialogue: 0,1:35:28.09,1:35:30.80,Default,,0,0,0,,Оның сиқырлы күші де жоғалады.
Dialogue: 0,1:35:31.10,1:35:32.85,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:35:32.97,1:35:34.14,Default,,0,0,0,,Екеуіңіз асығыңыздар
Dialogue: 0,1:35:34.22,1:35:37.89,Default,,0,0,0,,Сол қақпадан кіріп, өз әлеміңізге оралыңыз.
Dialogue: 0,1:35:38.31,1:35:39.15,Default,,0,0,0,,Аша
Dialogue: 0,1:35:39.77,1:35:40.60,Default,,0,0,0,,Түсіндім
Dialogue: 0,1:35:41.61,1:35:42.73,Default,,0,0,0,,Ю
Dialogue: 0,1:35:43.36,1:35:45.48,Default,,0,0,0,,Себебі мен сені ұмытпаймын
Dialogue: 0,1:35:46.99,1:35:48.99,Default,,0,0,0,,А... Аша мен...
Dialogue: 0,1:35:49.45,1:35:52.74,Default,,0,0,0,,Келушілерге Ни но Куниде ұзақ тұруға рұқсат етілмейді.
Dialogue: 0,1:35:53.20,1:35:56.62,Default,,0,0,0,,Аңыз бойынша ол адамның өмірін алу үшін де қолданылады.
Dialogue: 0,1:35:56.70,1:35:57.75,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:35:58.04,1:36:00.12,Default,,0,0,0,,Жоқ... бұл жақсы емес.
Dialogue: 0,1:36:00.50,1:36:02.46,Default,,0,0,0,,Қалсаң, саған қауіп төнеді.
Dialogue: 0,1:36:03.42,1:36:05.84,Default,,0,0,0,,Сізбен бірге күліп, жылаймыз
Dialogue: 0,1:36:06.09,1:36:08.51,Default,,0,0,0,,Мен сізбен күресетін адам болғым келді.
Dialogue: 0,1:36:09.55,1:36:11.51,Default,,0,0,0,,Мен сенімен мәңгі бірге болғым келді
Dialogue: 0,1:36:12.68,1:36:13.51,Default,,0,0,0,,Аша…
Dialogue: 0,1:36:14.43,1:36:16.14,Default,,0,0,0,,Юу Уақыт жоқ.
Dialogue: 0,1:36:16.43,1:36:18.52,Default,,0,0,0,,Қақпа жабылып жатыр, кеттік.
Dialogue: 0,1:36:19.19,1:36:21.23,Default,,0,0,0,,Дені сау, өнерлі бол
Dialogue: 0,1:36:21.31,1:36:23.02,Default,,0,0,0,,О дүниеде араласпа
Dialogue: 0,1:36:23.11,1:36:26.15,Default,,0,0,0,,А, біз енді қылышпен соғыспаймыз.
Dialogue: 0,1:36:27.23,1:36:29.24,Default,,0,0,0,,Олай болса, кел, Юу.
Dialogue: 0,1:36:29.86,1:36:31.45,Default,,0,0,0,,Қош бол Аша
Dialogue: 0,1:36:45.34,1:36:47.13,Default,,0,0,0,,Кешіріңіз, Хару, мен...
Dialogue: 0,1:36:48.96,1:36:49.88,Default,,0,0,0,,Ю!
Dialogue: 0,1:36:51.51,1:36:52.38,Default,,0,0,0,,Корпус
Dialogue: 0,1:36:53.59,1:36:54.64,Default,,0,0,0,,Қоштасу
Dialogue: 0,1:36:54.93,1:36:57.06,Default,,0,0,0,,Жоқ... Ю, жоқ.
Dialogue: 0,1:36:57.68,1:36:58.97,Default,,0,0,0,,Ю!
Dialogue: 0,1:37:09.78,1:37:10.61,Default,,0,0,0,,Ха…
Dialogue: 0,1:37:15.24,1:37:16.08,Default,,0,0,0,,Ю!
Dialogue: 0,1:37:22.41,1:37:23.50,Default,,0,0,0,,Ю!
Dialogue: 0,1:37:32.17,1:37:33.01,Default,,0,0,0,,Ю…
Dialogue: 0,1:37:41.18,1:37:43.77,Default,,0,0,0,,Ха... Хару, сен байқадың.
Dialogue: 0,1:37:44.44,1:37:47.98,Default,,0,0,0,,Керемет! Мен өзімді қауіпсіз сезінетінім сонша, мен құлап кететін сияқтымын
Dialogue: 0,1:37:48.40,1:37:49.23,Default,,0,0,0,,Мен...
Dialogue: 0,1:37:49.32,1:37:51.24,Default,,0,0,0,,Мен көлігіммен өзенге құладым.
Dialogue: 0,1:37:51.69,1:37:55.11,Default,,0,0,0,,Мен ауруханаға жеткізілгеннен кейін бір ай ұйықтадым.
Dialogue: 0,1:37:55.61,1:37:58.99,Default,,0,0,0,,Осы қарқынмен есін жимаймын ба деп қорқамын.
Dialogue: 0,1:38:00.95,1:38:02.12,Default,,0,0,0,,Жақсы
Dialogue: 0,1:38:02.20,1:38:03.04,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,1:38:03.25,1:38:04.96,Default,,0,0,0,,Мен де аналарға хабарласамын.
Dialogue: 0,1:38:05.04,1:38:05.88,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:38:06.71,1:38:09.38,Default,,0,0,0,,О, менде жақсы жаңалық бар.
Dialogue: 0,1:38:09.84,1:38:10.75,Default,,0,0,0,,Жақсы жаңалық?
Dialogue: 0,1:38:12.09,1:38:13.13,Default,,0,0,0,,Корпус
Dialogue: 0,1:38:14.30,1:38:15.13,Default,,0,0,0,,Котона!
Dialogue: 0,1:38:16.05,1:38:17.76,Default,,0,0,0,,Сіз ауырып жатырсыз ба?
Dialogue: 0,1:38:17.89,1:38:20.81,Default,,0,0,0,,Мен ота жасап, жараны алып тастай алдым.
Dialogue: 0,1:38:20.89,1:38:22.14,Default,,0,0,0,,Бұл сіздің көңіл-күйіңізді жақсартады.
Dialogue: 0,1:38:22.73,1:38:25.02,Default,,0,0,0,,Дәрігер мұны керемет деп айтты.
Dialogue: 0,1:38:25.85,1:38:28.02,Default,,0,0,0,,Ұф… Хмм… Уу…
Dialogue: 0,1:38:28.44,1:38:29.77,Default,,0,0,0,,Эрен сияқты, бронясымен және Коллоссал Титанмен
Dialogue: 0,1:38:30.32,1:38:32.61,Default,,0,0,0,,Котона, сен мені алаңдаттың.
Dialogue: 0,1:38:32.78,1:38:34.90,Default,,0,0,0,,Иә, кешіріңіз, Хару.
Dialogue: 0,1:38:35.40,1:38:37.49,Default,,0,0,0,,Бірақ біз қайтадан шайқаса аламыз.
Dialogue: 0,1:38:37.82,1:38:38.66,Default,,0,0,0,,О
Dialogue: 0,1:38:38.74,1:38:41.45,Default,,0,0,0,,Бұл өте жақсы болды.
Dialogue: 0,1:38:41.79,1:38:43.91,Default,,0,0,0,,Юу, сен қайдасың?
Dialogue: 0,1:38:44.37,1:38:45.75,Default,,0,0,0,,Сіз қайтып келдіңіз, солай ма?
Dialogue: 0,1:38:46.87,1:38:50.54,Default,,0,0,0,,Котона, мен Юға сіздің қаншалықты жігерлі екеніңізді көрсеткім келеді.
Dialogue: 0,1:38:50.84,1:38:53.51,Default,,0,0,0,,Қайда бара жатыр екен деп ойлаймын.
Dialogue: 0,1:38:53.59,1:38:55.34,Default,,0,0,0,,Иә, Юу ше?
Dialogue: 0,1:38:55.42,1:38:56.88,Default,,0,0,0,,Ю? Юу...
Dialogue: 0,1:38:56.97,1:38:59.55,Default,,0,0,0,,Дұрыс, мен де Юға айтуым керек.
Dialogue: 0,1:39:00.14,1:39:01.72,Default,,0,0,0,,Иә? Ю?
Dialogue: 0,1:39:01.97,1:39:02.81,Default,,0,0,0,,Ю?
Dialogue: 0,1:39:03.22,1:39:04.81,Default,,0,0,0,,Юу деген кім?
Dialogue: 0,1:39:06.60,1:39:09.52,Default,,0,0,0,,Барлығының Юу туралы естеліктері жоғалып бара жатыр ма?
Dialogue: 0,1:39:11.48,1:39:12.32,Default,,0,0,0,,Ха…
Dialogue: 0,1:39:12.40,1:39:16.15,Default,,0,0,0,,Енді мен білдім, Юу, сенің шынайы болмысыңды.
Dialogue: 0,1:39:23.41,1:39:24.29,Default,,0,0,0,,Ю
Dialogue: 0,1:39:25.45,1:39:27.96,Default,,0,0,0,,Сіз мен болдыңыз, солай ма?
Dialogue: 0,1:39:29.46,1:39:31.09,Default,,0,0,0,,Өмірлері байланыстылар...
Dialogue: 0,1:39:31.84,1:39:34.00,Default,,0,0,0,,Бірдей нәрселерге немесе ұқсас адамдарға ғашық болу
Dialogue: 0,1:39:34.92,1:39:36.67,Default,,0,0,0,,Сіз солай айттыңыз.
Dialogue: 0,1:39:37.93,1:39:39.68,Default,,0,0,0,,Ойланып қарасаңыз, біз...
Dialogue: 0,1:39:40.14,1:39:42.72,Default,,0,0,0,,Бір адамға ғашық болдық деген сөз.
Dialogue: 0,1:39:49.73,1:39:53.32,Default,,0,0,0,,Мен ғашық болған сол қышқыл апельсин
Dialogue: 0,1:39:58.40,1:39:59.24,Default,,0,0,0,,Ю
Dialogue: 0,1:40:00.70,1:40:04.24,Default,,0,0,0,,Сіз Ни но Куни қаласының тұрғыны болдыңыз.
Dialogue: 0,1:40:05.74,1:40:07.79,Default,,0,0,0,,Сәби кезіндегі ұшақ апаты
Dialogue: 0,1:40:08.33,1:40:10.33,Default,,0,0,0,,Бір ғана адам аман қалды
Dialogue: 0,1:40:11.00,1:40:12.58,Default,,0,0,0,,Мен сәби едім
Dialogue: 0,1:40:13.17,1:40:15.21,Default,,0,0,0,,Әкем де, шешем де есімде жоқ.
Dialogue: 0,1:40:16.71,1:40:19.38,Default,,0,0,0,,Сіз апат болған күні келдіңіз.
Dialogue: 0,1:40:19.93,1:40:21.59,Default,,0,0,0,,есіңде жоқ шығар.
Dialogue: 0,1:40:21.68,1:40:23.64,Default,,0,0,0,,Ол басынан бері болмаған.
Dialogue: 0,1:40:24.39,1:40:27.85,Default,,0,0,0,,Бұл дүниеде әкем де, шешем де жоқ.
Dialogue: 0,1:40:28.73,1:40:30.44,Default,,0,0,0,,Басқаша айтқанда, сіз және мен...
Dialogue: 0,1:40:30.60,1:40:34.90,Default,,0,0,0,,Бұл дүниеде де, Ни но Куниде де өміріміз бір болған.
Dialogue: 0,1:40:35.69,1:40:37.19,Default,,0,0,0,,Біз ең жақын дос болдық, бірақ...
Dialogue: 0,1:40:37.40,1:40:40.49,Default,,0,0,0,,Біз бастапқыда бөлек әлемдерде өмір сүруіміз керек еді.
Dialogue: 0,1:40:42.28,1:40:44.62,Default,,0,0,0,,Түсіндім, сен...
Dialogue: 0,1:40:45.41,1:40:47.08,Default,,0,0,0,,Менің ойымша, ол саяхатшы болған.
Dialogue: 0,1:40:47.91,1:40:50.46,Default,,0,0,0,,Ал сенің бұл дүниеге келу себебің...
Dialogue: 0,1:40:50.96,1:40:53.83,Default,,0,0,0,,Мүмкін бұл мені құтқару үшін шығар.
Dialogue: 0,1:40:55.17,1:40:57.00,Default,,0,0,0,,Бұл сіздің әрекетіңіз.
Dialogue: 0,1:40:58.59,1:41:02.18,Default,,0,0,0,,Ю, бұл сіздің сүйікті гипотезаңыз...
Dialogue: 0,1:41:03.18,1:41:05.97,Default,,0,0,0,,Сіз қазір Ни но Куниде тұрасыз.
Dialogue: 0,1:41:06.51,1:41:07.97,Default,,0,0,0,,Жақын адамдармен
Dialogue: 0,1:41:08.43,1:41:09.98,Default,,0,0,0,,Мен және Котона сияқты
Dialogue: 0,1:41:11.69,1:41:12.52,Default,,0,0,0,,Ю
Dialogue: 0,1:41:13.02,1:41:15.31,Default,,0,0,0,,Енді мен саған бұрынғыдан да жақын сезінемін.
Dialogue: 0,1:41:20.24,1:41:23.57,Default,,0,0,0,,Неге екенін білмеймін, бірақ сеземін.
Dialogue: 0,1:41:25.07,1:41:26.91,Default,,0,0,0,,Сау бол, Юу.
Dialogue: 0,1:41:28.37,1:41:31.46,Default,,0,0,0,,Біз бәрібір ұқсаспыз.
Dialogue: 0,1:41:58.32,1:42:03.32,Default,,0,0,0,,♪~
Dialogue: 0,1:45:28.40,1:45:33.41,Default,,0,0,0,,~♪
Dialogue: 0,1:45:40.62,1:45:46.63,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,1:45:48.13,1:45:54.13,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory