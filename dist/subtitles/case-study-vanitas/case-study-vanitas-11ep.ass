Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:00:06.56,0:00:07.85,Default,,0,0,0,,О, итата
Dialogue: 0,0:00:09.44,0:00:10.85,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:00:10.94,0:00:14.11,Default,,0,0,0,,Мен сізден қоңырау қабылдаймын деп ойламадым.
Dialogue: 0,0:00:14.73,0:00:15.61,Default,,0,0,0,,(Желдің дыбысы)
Dialogue: 0,0:00:20.36,0:00:21.62,Default,,0,0,0,,Жанна
Dialogue: 0,0:00:24.08,0:00:25.08,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:26.95,0:00:28.33,Default,,0,0,0,,Ванитас
Dialogue: 0,0:00:29.29,0:00:31.54,Default,,0,0,0,,Менімен кездесуге барайық
Dialogue: 0,0:00:32.96,0:00:37.21,Default,,0,0,0,,(♪~Ашық ән)
Dialogue: 0,0:00:47.18,0:00:52.56,Default,,0,0,0,,♪ Қарапайым, көбінесе қуаныш, ашу, қайғы, махаббат, сіздің ойларыңыз ♪
Dialogue: 0,0:00:52.65,0:00:56.69,Default,,0,0,0,,♪ Бір күні түсінерсіз ♪
Dialogue: 0,0:00:56.78,0:00:58.65,Default,,0,0,0,,♪ Талай рет кесіп, жапсырдым ♪
Dialogue: 0,0:00:58.74,0:01:01.15,Default,,0,0,0,,♪ Цугихаги онсыз да аянышты ♪
Dialogue: 0,0:01:01.24,0:01:06.20,Default,,0,0,0,,♪ Мен тірі болудың анықтамасын да білмеймін ♪
Dialogue: 0,0:01:06.28,0:01:09.50,Default,,0,0,0,,♪ Тек екеуміз ♪
Dialogue: 0,0:01:09.58,0:01:13.58,Default,,0,0,0,,♪ ♪ деп айтудың қажеті жоқ
Dialogue: 0,0:01:13.67,0:01:20.01,Default,,0,0,0,,♪ Мен бір-бірімізді түсінетін сияқтымын, бірақ әлі ♪ емес
Dialogue: 0,0:01:20.09,0:01:23.14,Default,,0,0,0,,♪ Бұл жақсы ♪
Dialogue: 0,0:01:24.22,0:01:26.76,Default,,0,0,0,,♪ Менің сүйікті әлемім ♪
Dialogue: 0,0:01:26.85,0:01:31.39,Default,,0,0,0,,♪ Маған сен ғана бере алатын нұрмен ♪
Dialogue: 0,0:01:31.48,0:01:33.90,Default,,0,0,0,,♪ Мына жарылған көздер ♪
Dialogue: 0,0:01:33.98,0:01:36.40,Default,,0,0,0,,♪ Мен тиіп тұрған дүние ♪
Dialogue: 0,0:01:36.48,0:01:40.78,Default,,0,0,0,,♪ Бәрі жарқырап тұрған сияқты ♪
Dialogue: 0,0:01:40.86,0:01:45.70,Default,,0,0,0,,♪ Ештеңе анық емес ♪
Dialogue: 0,0:01:45.78,0:01:50.58,Default,,0,0,0,,♪ Сіз мені бұл көздерден көре аласыз, солай ма? ♪
Dialogue: 0,0:01:54.08,0:01:57.17,Default,,0,0,0,,♪ Аспан мен қуыс тоғысқанда, арман әлі алда ♪
Dialogue: 0,0:01:57.25,0:01:58.55,Default,,0,0,0,,♪ Артқа қарасақ ♪
Dialogue: 0,0:01:58.63,0:01:59.63,Default,,0,0,0,,(Ашық ән~♪)
Dialogue: 0,0:02:03.59,0:02:04.84,Default,,0,0,0,,(есік қағу)
Dialogue: 0,0:02:04.93,0:02:07.18,Default,,0,0,0,,Қайырлы таң, Ванитас.
Dialogue: 0,0:02:07.26,0:02:10.47,Default,,0,0,0,,Менде Ванитас мырзаның атына жазылған карточка бар.
Dialogue: 0,0:02:11.18,0:02:12.73,Default,,0,0,0,,Сәлем Амелия
Dialogue: 0,0:02:12.81,0:02:15.06,Default,,0,0,0,,Бұл картаны қандай адам әкелді?
Dialogue: 0,0:02:15.15,0:02:16.40,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:16.48,0:02:20.15,Default,,0,0,0,,Мен бұл адамды бұрыннан сұрағандықтан, оны жеке көрмедім.
Dialogue: 0,0:02:20.23,0:02:21.49,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:21.57,0:02:23.11,Default,,0,0,0,,(әдемі музыка)
Dialogue: 0,0:02:23.20,0:02:24.49,Default,,0,0,0,,Ное мырза?
Dialogue: 0,0:02:24.57,0:02:26.62,Default,,0,0,0,,Қайта құлады ма?
Dialogue: 0,0:02:27.99,0:02:30.49,Default,,0,0,0,,А...? ваниталар
Dialogue: 0,0:02:31.29,0:02:34.41,Default,,0,0,0,,Сіз бір жерге шығасыз ба?
Dialogue: 0,0:02:34.50,0:02:36.92,Default,,0,0,0,,Хмф! Бұл құпия
Dialogue: 0,0:02:42.26,0:02:45.01,Default,,0,0,0,,Күні? Менімен біргесің бе?
Dialogue: 0,0:02:45.09,0:02:47.93,Default,,0,0,0,,Хаха... Не дегеніңіз?
Dialogue: 0,0:02:48.01,0:02:49.97,Default,,0,0,0,,Алғаш кездескен кезді еске алғанда
Dialogue: 0,0:02:50.06,0:02:53.52,Default,,0,0,0,,Бірінші шабуыл жасаған мен болдым.
Dialogue: 0,0:02:53.60,0:02:57.06,Default,,0,0,0,,Мені дәл осылай өлтірсе де, шағымдануға жағдайым жоқ еді.
Dialogue: 0,0:02:57.15,0:02:58.98,Default,,0,0,0,,Сіз мұны істеген жоқсыз.
Dialogue: 0,0:03:00.15,0:03:02.07,Default,,0,0,0,,Маскарадтық шарларға да солай.
Dialogue: 0,0:03:02.15,0:03:04.86,Default,,0,0,0,,Луканы құтқаруға көмектескеніңіз үшін рахмет.
Dialogue: 0,0:03:04.95,0:03:06.11,Default,,0,0,0,,Айналадағы вампирлерден
Dialogue: 0,0:03:06.20,0:03:08.53,Default,,0,0,0,,Маған жүрексіз сөздер тасталса да
Dialogue: 0,0:03:08.62,0:03:10.99,Default,,0,0,0,,Қарғыс айтушыларды құтқарды
Dialogue: 0,0:03:11.91,0:03:14.41,Default,,0,0,0,,Мен әрқашан сенен еріп жүрмін
Dialogue: 0,0:03:14.50,0:03:17.33,Default,,0,0,0,,Менің оны жек көруден басқа амалым қалмау керек еді.
Dialogue: 0,0:03:17.42,0:03:18.42,Default,,0,0,0,,Байқасаңыз
Dialogue: 0,0:03:18.50,0:03:22.30,Default,,0,0,0,,Ұйықтасам да, оянсам да тек сені ғана ойлаймын.
Dialogue: 0,0:03:22.38,0:03:24.26,Default,,0,0,0,,Бұл... бәлкім...
Dialogue: 0,0:03:25.42,0:03:26.34,Default,,0,0,0,,(өткір дыбыс)
Dialogue: 0,0:03:26.42,0:03:30.51,Default,,0,0,0,,Мен саған ғашық болып қалдым
Dialogue: 0,0:03:30.60,0:03:34.10,Default,,0,0,0,,Олай болса, бұл сезімді шынымен махаббат деп атауға бола ма?
Dialogue: 0,0:03:34.18,0:03:36.35,Default,,0,0,0,,Маған растауға рұқсат етіңіз.
Dialogue: 0,0:03:36.43,0:03:37.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:37.69,0:03:38.98,Default,,0,0,0,,А...
Dialogue: 0,0:03:41.44,0:03:43.57,Default,,0,0,0,,Иә... күткендей!
Dialogue: 0,0:03:43.65,0:03:46.86,Default,,0,0,0,,Өйткені, мен бұл әдісті міндетті түрде қолдандым!
Dialogue: 0,0:03:47.65,0:03:51.28,Default,,0,0,0,,Не? Ванитас сізді қалай жек көретінін білгіңіз келе ме?
Dialogue: 0,0:03:51.37,0:03:54.20,Default,,0,0,0,,Иә, мен ол адамды жек көремін.
Dialogue: 0,0:03:54.29,0:03:58.12,Default,,0,0,0,,Бірақ мен бас тартқан сайын, ол маған қуана жақындайды.
Dialogue: 0,0:03:58.21,0:04:01.96,Default,,0,0,0,,Мен енді ол кісінің мейіріміне бөленуге шыдай алмаймын.
Dialogue: 0,0:04:02.04,0:04:05.88,Default,,0,0,0,,Мен Доминик-саманың мұндай жағдайлардан қалай шығу керектігін білетініне сенімдімін.
Dialogue: 0,0:04:06.51,0:04:08.63,Default,,0,0,0,,Маған даналығыңызды беріңізші.
Dialogue: 0,0:04:08.72,0:04:09.63,Default,,0,0,0,,(тыныштандыратын дыбыс)
Dialogue: 0,0:04:09.72,0:04:11.76,Default,,0,0,0,,Мен бұл туралы да білмеймін.
Dialogue: 0,0:04:11.85,0:04:13.10,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:04:13.18,0:04:14.76,Default,,0,0,0,,(сүйкімді дыбыс)
Dialogue: 0,0:04:14.85,0:04:15.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:15.85,0:04:18.14,Default,,0,0,0,,Бірақ Жанна қиналған кезде өте сүйкімді.
Dialogue: 0,0:04:18.23,0:04:20.27,Default,,0,0,0,,Мен бұл туралы бірдеңе істей алғым келеді.
Dialogue: 0,0:04:20.35,0:04:22.61,Default,,0,0,0,,Әй, енді ойлап қарасам, не?
Dialogue: 0,0:04:22.69,0:04:25.23,Default,,0,0,0,,Ноеден естігенім
Dialogue: 0,0:04:25.32,0:04:26.53,Default,,0,0,0,,Ванитас бұрын болған
Dialogue: 0,0:04:26.61,0:04:30.03,Default,,0,0,0,,«Мені ұнататын адам мені қызықтырмайды».
Dialogue: 0,0:04:30.11,0:04:31.45,Default,,0,0,0,,Мен оның осылай айтқанын естідім
Dialogue: 0,0:04:31.53,0:04:32.53,Default,,0,0,0,,Ах
Dialogue: 0,0:04:32.62,0:04:37.29,Default,,0,0,0,,Яғни! Егер сіз Ванитасқа ғашық болғандай әрекет етсеңіз
Dialogue: 0,0:04:37.37,0:04:41.63,Default,,0,0,0,,Мүмкін ол сізге деген қызығушылығын жоғалтып, кетіп қалуы мүмкін.
Dialogue: 0,0:04:41.71,0:04:46.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:46.21,0:04:49.30,Default,,0,0,0,,Себебі сен мені бүгін жек көресің
Dialogue: 0,0:04:49.38,0:04:52.14,Default,,0,0,0,,Мен саған жан-тәніммен ғашықпын
Dialogue: 0,0:04:54.72,0:04:58.64,Default,,0,0,0,,Ол үшін мені ешқашан әрекет деп тануға болмайды.
Dialogue: 0,0:04:58.73,0:05:00.14,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:05:00.23,0:05:04.40,Default,,0,0,0,,Хмм, бұл кенеттен болғанына таң қалдым.
Dialogue: 0,0:05:06.52,0:05:09.11,Default,,0,0,0,,Бұл сізден басқа ешкімнің шақыруы.
Dialogue: 0,0:05:09.19,0:05:11.70,Default,,0,0,0,,Мен бас тарта алмаймын.
Dialogue: 0,0:05:11.78,0:05:12.91,Default,,0,0,0,,Және...
Dialogue: 0,0:05:12.99,0:05:16.53,Default,,0,0,0,,Неліктен жүрегің осылай өзгерді?
Dialogue: 0,0:05:16.62,0:05:18.41,Default,,0,0,0,,Мені де қатты қызықтырады.
Dialogue: 0,0:05:18.50,0:05:20.79,Default,,0,0,0,,Қуанышты Ванитас
Dialogue: 0,0:05:20.87,0:05:23.00,Default,,0,0,0,,Дайында, Ванитас.
Dialogue: 0,0:05:23.08,0:05:24.42,Default,,0,0,0,,Бүгін мен саған қамқор боламын⸺
Dialogue: 0,0:05:24.50,0:05:27.92,Default,,0,0,0,,Менің кезегім оны алақанда айналдыру.
Dialogue: 0,0:05:28.92,0:05:30.47,Default,,0,0,0,,Айтпақшы, Жанна
Dialogue: 0,0:05:30.55,0:05:32.68,Default,,0,0,0,,Бұл көйлек өте әдемі.
Dialogue: 0,0:05:32.76,0:05:34.09,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:34.18,0:05:38.52,Default,,0,0,0,,Дұрыс! Бұл көйлекті маған Доминик сыйлады.
Dialogue: 0,0:05:38.60,0:05:42.98,Default,,0,0,0,,Доминик мен үшін таңдау қиынға соққан шағын заттар да.
Dialogue: 0,0:05:43.69,0:05:45.48,Default,,0,0,0,,Жоқ, Жанна.
Dialogue: 0,0:05:45.56,0:05:46.69,Default,,0,0,0,,(жарқыраған дыбыс)
Dialogue: 0,0:05:46.77,0:05:50.61,Default,,0,0,0,,Мен саған әдемі екеніңді айтып тұрмын.
Dialogue: 0,0:05:52.20,0:05:54.03,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:05:54.11,0:05:56.53,Default,,0,0,0,,Аа... (жеңіл музыка)
Dialogue: 0,0:05:57.87,0:06:00.29,Default,,0,0,0,,Жүр, кеттік, Жанна.
Dialogue: 0,0:06:00.37,0:06:04.83,Default,,0,0,0,,Ха... бұл өте...
Dialogue: 0,0:06:04.92,0:06:09.17,Default,,0,0,0,,Сіз ғашық болғандай әрекет еттіңіз бе?
Dialogue: 0,0:06:10.26,0:06:11.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:11.59,0:06:14.01,Default,,0,0,0,,Ябу және тозақ отының сиқыршысы Жанна?
Dialogue: 0,0:06:16.64,0:06:19.56,Default,,0,0,0,,Ей, мынау не болып жатыр!
Dialogue: 0,0:06:19.64,0:06:22.14,Default,,0,0,0,,Уау! …Доминик де Сад
Dialogue: 0,0:06:22.23,0:06:23.35,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:23.44,0:06:24.56,Default,,0,0,0,,Құрметті...
Dialogue: 0,0:06:24.64,0:06:27.19,Default,,0,0,0,,А... қандай бөгет?
Dialogue: 0,0:06:27.27,0:06:29.07,Default,,0,0,0,,Жоқ... не істеп жатырсың?
Dialogue: 0,0:06:29.15,0:06:31.74,Default,,0,0,0,,Сіз оны көрмейсіз бе? Мен сені бақылап жүрмін
Dialogue: 0,0:06:31.82,0:06:33.45,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:06:33.53,0:06:35.20,Default,,0,0,0,,Ах! Қауіпті Жанна!
Dialogue: 0,0:06:37.28,0:06:40.70,Default,,0,0,0,,(жарқыраған дыбыс)
Dialogue: 0,0:06:40.79,0:06:43.25,Default,,0,0,0,,Жақсысың ба, Жанна?
Dialogue: 0,0:06:45.29,0:06:46.29,Default,,0,0,0,,Уф! Уау...
Dialogue: 0,0:06:46.37,0:06:48.54,Default,,0,0,0,,Кешіріңіз, мен...
Dialogue: 0,0:06:52.76,0:06:56.55,Default,,0,0,0,,Сізге зиян тигізбесе, бұл жақсы. Сақ болыңыз.
Dialogue: 0,0:06:56.63,0:06:57.76,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:06:58.64,0:07:01.56,Default,,0,0,0,,Немесе 'Akiba's●lip'
Dialogue: 0,0:07:01.64,0:07:03.22,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:07:03.31,0:07:05.52,Default,,0,0,0,,Мен оны әлсіз сезінсем де
Dialogue: 0,0:07:05.60,0:07:08.40,Default,,0,0,0,,Жанна әдемі жалқау қыз емес пе...?
Dialogue: 0,0:07:10.23,0:07:11.11,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:13.61,0:07:17.78,Default,,0,0,0,,Ахахха! О... аа!
Dialogue: 0,0:07:17.86,0:07:19.32,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:19.41,0:07:22.54,Default,,0,0,0,,Неліктен бұл болып жатыр?
Dialogue: 0,0:07:24.87,0:07:27.29,Default,,0,0,0,,Сізде өте ерекше ұйықтау орны бар.
Dialogue: 0,0:07:28.88,0:07:30.04,Default,,0,0,0,,Уф… Мұнда не болып жатыр өзі?
Dialogue: 0,0:07:32.63,0:07:34.30,Default,,0,0,0,,Лорд Рутвен!
Dialogue: 0,0:07:34.38,0:07:39.18,Default,,0,0,0,,Бонжур Бала Жақсы түс көрдіңіз бе?
Dialogue: 0,0:07:39.26,0:07:41.43,Default,,0,0,0,,(романтикалық музыка)
Dialogue: 0,0:07:45.52,0:07:47.94,Default,,0,0,0,,Сізге кенеттен кіріп кеткенім үшін кешіріңіз.
Dialogue: 0,0:07:48.02,0:07:49.31,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:49.40,0:07:53.40,Default,,0,0,0,,Бұл 17 ғасырдың аяғында негізі қаланған бұрыннан қалыптасқан кафе.
Dialogue: 0,0:07:53.48,0:07:57.28,Default,,0,0,0,,Бұл адам әлеміндегі менің сүйікті жерім.
Dialogue: 0,0:07:57.36,0:07:58.74,Default,,0,0,0,,Сол бұрыннан қалыптасқан кафеде
Dialogue: 0,0:07:58.82,0:08:01.83,Default,,0,0,0,,Неліктен бізден басқа тұтынушылар жоқ?
Dialogue: 0,0:08:01.91,0:08:04.08,Default,,0,0,0,,Мен оны бүгін өзіме сақтап қойдым.
Dialogue: 0,0:08:04.16,0:08:05.08,Default,,0,0,0,,Ширауды одан сайын тартыңыз!
Dialogue: 0,0:08:05.16,0:08:08.46,Default,,0,0,0,,Мен сенімен жай сөйлескім келеді.
Dialogue: 0,0:08:09.67,0:08:13.92,Default,,0,0,0,,Менімен...? Ванитас емес пе?
Dialogue: 0,0:08:14.00,0:08:15.51,Default,,0,0,0,,Сол адамнан, әрине⸺
Dialogue: 0,0:08:15.59,0:08:18.38,Default,,0,0,0,,Менің сізден сұрайын дегенім көп.
Dialogue: 0,0:08:18.47,0:08:22.47,Default,,0,0,0,,Ол өзі туралы мүлдем айтпайтын шығар.
Dialogue: 0,0:08:25.18,0:08:29.73,Default,,0,0,0,,Сол кезде мен өзіме пайдалы ақпаратты ғана шығардым.
Dialogue: 0,0:08:29.81,0:08:33.19,Default,,0,0,0,,Олар маған сұрақ қоюға да уақыт бермеді.
Dialogue: 0,0:08:34.61,0:08:39.07,Default,,0,0,0,,Мен де Ванитастың өткені туралы ештеңе білмеймін.
Dialogue: 0,0:08:39.15,0:08:43.28,Default,,0,0,0,,Сонда да оның қандай адам екенін білу керек.
Dialogue: 0,0:08:44.66,0:08:48.66,Default,,0,0,0,,Ал сен сол пішінсіз болмыстың баласысың.
Dialogue: 0,0:08:48.75,0:08:54.34,Default,,0,0,0,,Саған қызығуыма осының өзі жеткілікті.
Dialogue: 0,0:08:54.42,0:08:57.71,Default,,0,0,0,,Сіздің мұғаліміңіз шынымен де соншалықты керемет вампир ме?
Dialogue: 0,0:08:57.80,0:08:59.09,Default,,0,0,0,,Уф
Dialogue: 0,0:08:59.17,0:09:01.43,Default,,0,0,0,,Шынымен бе…
Dialogue: 0,0:09:01.51,0:09:03.05,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:09:03.14,0:09:07.35,Default,,0,0,0,,Мен бұл адамға соншалықты дөрекі қарым-қатынас жасай алатын вампир болады деп ешқашан ойламадым.
Dialogue: 0,0:09:07.43,0:09:11.10,Default,,0,0,0,,Негізі мен де түсінбеймін.
Dialogue: 0,0:09:12.02,0:09:17.44,Default,,0,0,0,,Хэхе... хахахахаха
Dialogue: 0,0:09:17.53,0:09:20.95,Default,,0,0,0,,(жарқыраған дыбыс)
Dialogue: 0,0:09:21.03,0:09:24.78,Default,,0,0,0,,Маған қызық, неге ол туралы...
Dialogue: 0,0:09:24.87,0:09:28.62,Default,,0,0,0,,Жек көремін, жек көремін, қолымнан келмеді
Dialogue: 0,0:09:29.91,0:09:34.96,Default,,0,0,0,,Мен қазір қатты толқып тұрмын...
Dialogue: 0,0:09:35.59,0:09:39.13,Default,,0,0,0,,...Енді мен оны өртеп жібердім,
Dialogue: 0,0:09:39.21,0:09:41.84,Default,,0,0,0,,Мен бұл күнді көруді міндеттеймін.
Dialogue: 0,0:09:41.93,0:09:45.09,Default,,0,0,0,,Мен оларды осылай бақылап жүрмін.
Dialogue: 0,0:09:45.18,0:09:46.60,Default,,0,0,0,,Сен ақымақ емессің бе?
Dialogue: 0,0:09:46.68,0:09:48.52,Default,,0,0,0,,Шулы!
Dialogue: 0,0:09:52.10,0:09:53.98,Default,,0,0,0,,Ванитас
Dialogue: 0,0:09:54.06,0:09:56.52,Default,,0,0,0,,Тезірек қолымды босатқаныңды қалаймын.
Dialogue: 0,0:09:56.61,0:09:58.40,Default,,0,0,0,,Бірақ сіз бірден басқа жаққа қарайсыз
Dialogue: 0,0:09:58.48,0:10:01.15,Default,,0,0,0,,Паразоль! Өйткені мен қолшатыр кигім келеді
Dialogue: 0,0:10:01.24,0:10:03.78,Default,,0,0,0,,Фуфуфуфу... (Джаннаның ентігуі)
Dialogue: 0,0:10:03.86,0:10:05.16,Default,,0,0,0,,Не?
Dialogue: 0,0:10:05.24,0:10:06.78,Default,,0,0,0,,Не? Бұл не?
Dialogue: 0,0:10:06.87,0:10:11.04,Default,,0,0,0,,Әлгі тәкаппар, өзімшіл адам қайда кетті?
Dialogue: 0,0:10:11.12,0:10:13.54,Default,,0,0,0,,Мынадай нәрсе... Мынадай нәрсе...
Dialogue: 0,0:10:13.62,0:10:14.87,Default,,0,0,0,,(жарқыраған дыбыс)
Dialogue: 0,0:10:14.96,0:10:16.83,Default,,0,0,0,,Реңктен шығу
Dialogue: 0,0:10:18.34,0:10:22.09,Default,,0,0,0,,Сонымен? Сіз барғыңыз келетін нақты жер бар ма?
Dialogue: 0,0:10:22.17,0:10:23.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:23.76,0:10:27.47,Default,,0,0,0,,Мүмкіндік болса...Мен Парижді аралап көргім келеді.
Dialogue: 0,0:10:27.55,0:10:30.72,Default,,0,0,0,,Парижге бірінші рет келіп тұрған жоқсыз.
Dialogue: 0,0:10:30.81,0:10:32.93,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:10:33.94,0:10:36.06,Default,,0,0,0,,Мен Лука-Самамен бірге болған кезде
Dialogue: 0,0:10:36.15,0:10:38.36,Default,,0,0,0,,Әрқашан айналаңызға сергек болыңыз
Dialogue: 0,0:10:38.44,0:10:42.07,Default,,0,0,0,,Маған пейзажды тамашалауға рұқсат жоқ.
Dialogue: 0,0:10:42.82,0:10:46.70,Default,,0,0,0,,Міне, бүгін мен өзімді қанағат тұтқанша ләззат алуым керек.
Dialogue: 0,0:10:46.78,0:10:48.62,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:51.45,0:10:55.08,Default,,0,0,0,,(романтикалық музыка)
Dialogue: 0,0:11:12.56,0:11:14.60,Default,,0,0,0,,(Джаннаның күрсінуі)
Dialogue: 0,0:11:16.56,0:11:17.85,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:17.94,0:11:19.94,Default,,0,0,0,,Palais Garnier опера театры
Dialogue: 0,0:11:20.02,0:11:21.02,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,0:11:21.11,0:11:22.11,Default,,0,0,0,,Үлкен журнал
Dialogue: 0,0:11:22.19,0:11:23.19,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,0:11:23.28,0:11:24.61,Default,,0,0,0,,Триумфа доғасы
Dialogue: 0,0:11:24.69,0:11:25.61,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,0:11:25.70,0:11:27.74,Default,,0,0,0,,Жай ғана мысық, сабыр ет
Dialogue: 0,0:11:27.82,0:11:29.49,Default,,0,0,0,,Уау! Ах!
Dialogue: 0,0:11:29.57,0:11:32.74,Default,,0,0,0,,О? Киттер де бүгін жүзіп жүр.
Dialogue: 0,0:11:32.83,0:11:34.12,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:11:34.20,0:11:38.25,Default,,0,0,0,,Олар Парижде болса да, атмосферасы Альтастан мүлде бөлек.
Dialogue: 0,0:11:38.33,0:11:41.75,Default,,0,0,0,,Бұл — сүт, жұмыртқа сарысы, банан және нан —
Dialogue: 0,0:11:41.84,0:11:45.01,Default,,0,0,0,,Ахаха хехехе! Ахаха!
Dialogue: 0,0:11:45.63,0:11:47.51,Default,,0,0,0,,...Көңілді болыңыз! Сіз не істемексіз?
Dialogue: 0,0:11:47.59,0:11:49.26,Default,,0,0,0,,Түн ортасында әлі де 36 сағат.
Dialogue: 0,0:11:49.89,0:11:52.35,Default,,0,0,0,,Бастапқы мақсатыңызды ұмытпаңыз!
Dialogue: 0,0:11:52.43,0:11:56.64,Default,,0,0,0,,Бұл Ванитаспен байланысын үзетін күн.
Dialogue: 0,0:11:56.73,0:11:58.02,Default,,0,0,0,,Аздап ұялшақ мектеп кеңесінің төрағасы мен екі жақын дос.
Dialogue: 0,0:11:58.10,0:12:00.10,Default,,0,0,0,,Жанна Крептер жегіңіз келе ме?
Dialogue: 0,0:12:00.19,0:12:01.40,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:12:01.48,0:12:03.02,Default,,0,0,0,,Бұл — сүт, жұмыртқа сарысы, банан және нан —
Dialogue: 0,0:12:04.73,0:12:05.86,Default,,0,0,0,,Жалықты
Dialogue: 0,0:12:05.94,0:12:09.49,Default,,0,0,0,,Мм... бұл жай ғана кездесу.
Dialogue: 0,0:12:09.57,0:12:11.12,Default,,0,0,0,,Үйге баруым керек пе?
Dialogue: 0,0:12:11.20,0:12:14.62,Default,,0,0,0,,Ақымақ болма. Егер сіз осы уақытқа дейін келген болсаңыз, менімен соңына дейін бірге болыңыз.
Dialogue: 0,0:12:14.70,0:12:17.87,Default,,0,0,0,,(Могмогтың тамақтану дыбысы)
Dialogue: 0,0:12:17.96,0:12:21.00,Default,,0,0,0,,(шіркеу қоңырауының дыбысы)
Dialogue: 0,0:12:21.08,0:12:26.46,Default,,0,0,0,,Керемет көрініс, Монмартр - Париждегі ең биік төбе.
Dialogue: 0,0:12:26.55,0:12:27.76,Default,,0,0,0,,Сол мұнара...
Dialogue: 0,0:12:27.84,0:12:29.88,Default,,0,0,0,,Күн мұнарасы
Dialogue: 0,0:12:29.97,0:12:34.01,Default,,0,0,0,,Бұл Парижде өтетін дүниежүзілік көрмедегі ең үлкен көрме.
Dialogue: 0,0:12:34.10,0:12:37.35,Default,,0,0,0,,Дәмі нашар ғимарат, мен сенімдімін⸺
Dialogue: 0,0:12:37.43,0:12:38.77,Default,,0,0,0,,Гюстав Эйфельдің идеясы
Dialogue: 0,0:12:38.85,0:12:42.27,Default,,0,0,0,,Мен жай ғана жұмысқа аламын деп ойладым.
Dialogue: 0,0:12:42.36,0:12:45.27,Default,,0,0,0,,Бұл Бабыл мұнарасы сияқты
Dialogue: 0,0:12:48.90,0:12:50.15,Default,,0,0,0,,Хехе
Dialogue: 0,0:12:50.24,0:12:53.41,Default,,0,0,0,,Енді осы жерде сәл күте тұрыңыз, Жанна.
Dialogue: 0,0:12:53.49,0:12:55.91,Default,,0,0,0,,А... қайда?
Dialogue: 0,0:12:55.99,0:12:56.87,Default,,0,0,0,,Дәретхана
Dialogue: 0,0:12:56.95,0:12:57.95,Default,,0,0,0,,(таңданған дауыс)
Dialogue: 0,0:12:58.04,0:13:00.96,Default,,0,0,0,,Мен қайтып келгенде сізге хабарлаймын.
Dialogue: 0,0:13:01.04,0:13:03.71,Default,,0,0,0,,Маған жауап беріңіз
Dialogue: 0,0:13:03.79,0:13:06.84,Default,,0,0,0,,(нәзік музыка)
Dialogue: 0,0:13:06.92,0:13:08.80,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:13:08.88,0:13:10.80,Default,,0,0,0,,Кешіріңіз, бұл ештеңе емес.
Dialogue: 0,0:13:10.88,0:13:14.01,Default,,0,0,0,,Қарсы емеспін, айтшы.
Dialogue: 0,0:13:14.10,0:13:17.18,Default,,0,0,0,,Лорд Рутвенмен сөйлесу
Dialogue: 0,0:13:17.27,0:13:21.73,Default,,0,0,0,,Мен өзімді мұғаліммен бірге жүргендей сезінемін...
Dialogue: 0,0:13:22.90,0:13:26.61,Default,,0,0,0,,Не? Қалай сөйлеу керек?
Dialogue: 0,0:13:26.69,0:13:29.86,Default,,0,0,0,,Мен сабаққа қатысып жатқан сияқтымын.
Dialogue: 0,0:13:29.94,0:13:34.12,Default,,0,0,0,,Мен сенімен сөйлескенді ұнатамын...
Dialogue: 0,0:13:35.95,0:13:41.37,Default,,0,0,0,,Екеуіңіздің атмосфераңыз мүлдем басқа болса да, бұл біртүрлі.
Dialogue: 0,0:13:44.17,0:13:45.00,Default,,0,0,0,,Баяғыда...
Dialogue: 0,0:13:45.08,0:13:48.50,Default,,0,0,0,,Сіз мұғалімдік қызметте болдыңыз ба?
Dialogue: 0,0:13:48.59,0:13:53.80,Default,,0,0,0,,Бұл адамдар мен вампирлер әлі де бір-бірін жек көріп, бір-бірін өлтірген кезде болды.
Dialogue: 0,0:13:53.89,0:13:58.14,Default,,0,0,0,,Көптеген шәкірттерім мені таңдандырады, жаныма жиналды.
Dialogue: 0,0:13:58.22,0:14:02.85,Default,,0,0,0,,Ойлансын деп білім бердім
Dialogue: 0,0:14:02.94,0:14:06.90,Default,,0,0,0,,Жақсы болашақты бірге құру
Dialogue: 0,0:14:06.98,0:14:10.49,Default,,0,0,0,,Сол адамдармен әлі де байланыстасыз ба?
Dialogue: 0,0:14:10.57,0:14:11.74,Default,,0,0,0,,Ол қайтыс болды.
Dialogue: 0,0:14:11.82,0:14:13.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:13.11,0:14:15.41,Default,,0,0,0,,Барлығы өлтірілді.
Dialogue: 0,0:14:19.24,0:14:20.83,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:20.91,0:14:24.46,Default,,0,0,0,,Бұл менің есіме ауыртпалық түсірді...
Dialogue: 0,0:14:24.54,0:14:28.84,Default,,0,0,0,,Бүгін сендей шәкіртім болса
Dialogue: 0,0:14:28.92,0:14:32.05,Default,,0,0,0,,Әр күнім қызықты болатынына сенімдімін.
Dialogue: 0,0:14:32.13,0:14:33.55,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:14:34.30,0:14:36.93,Default,,0,0,0,,Бірақ мен уайымдап тұрмын
Dialogue: 0,0:14:37.01,0:14:42.18,Default,,0,0,0,,Бір күні сенің мейірімділігіңді пайдаланып, оны пайдаланып кете ме деп қорқамын.
Dialogue: 0,0:14:42.93,0:14:45.85,Default,,0,0,0,,Сіз Ванитас туралы айтып отырсыз ба?
Dialogue: 0,0:14:45.94,0:14:48.44,Default,,0,0,0,,Ванитас олай жасамас еді.
Dialogue: 0,0:14:49.52,0:14:52.07,Default,,0,0,0,,Әркім оны пайдалануға тырысса да
Dialogue: 0,0:14:52.15,0:14:56.28,Default,,0,0,0,,Мен үшін біреу ренжісе, қатты жек көремін
Dialogue: 0,0:14:56.36,0:14:59.28,Default,,0,0,0,,Бұл қайшылық. Ол адам
Dialogue: 0,0:14:59.37,0:15:02.75,Default,,0,0,0,,Ванитас адам мен вампирдің бірдей екенін айтады.
Dialogue: 0,0:15:02.83,0:15:07.08,Default,,0,0,0,,Екеуі де маған өздерінің ұсқынсыз және өзімшіл жаратылыс екенін айтты.
Dialogue: 0,0:15:07.17,0:15:11.30,Default,,0,0,0,,Соны естігенде тітіркеніп кеттім...
Dialogue: 0,0:15:11.38,0:15:14.59,Default,,0,0,0,,Сол кезде мен өзімді жалғыз сезіндім.
Dialogue: 0,0:15:16.68,0:15:19.26,Default,,0,0,0,,(Джиорно) Э-э… (Турист әйел 1) А…
Dialogue: 0,0:15:19.35,0:15:21.72,Default,,0,0,0,,Вампир сіз үшін нені білдіреді?
Dialogue: 0,0:15:21.81,0:15:23.85,Default,,0,0,0,,Адам дегеніміз не?
Dialogue: 0,0:15:25.02,0:15:26.48,Default,,0,0,0,,Е...
Dialogue: 0,0:15:26.56,0:15:29.48,Default,,0,0,0,,(Балалардың толқуы)
Dialogue: 0,0:15:29.56,0:15:32.11,Default,,0,0,0,,Жоқ! Менің жалқаулыққа уақытым жоқ
Dialogue: 0,0:15:32.90,0:15:35.32,Default,,0,0,0,,Бұл фарс аяқталуға жақын.
Dialogue: 0,0:15:35.40,0:15:38.95,Default,,0,0,0,,Егер мен оған деген сүйіспеншілігімді дұрыс білдіре алсам...
Dialogue: 0,0:15:39.03,0:15:41.58,Default,,0,0,0,,Жаттығу! Жаттығу жасайық!
Dialogue: 0,0:15:41.66,0:15:44.83,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:15:45.54,0:15:48.83,Default,,0,0,0,,Ванитас Мен бүгін өте көңілді болдым.
Dialogue: 0,0:15:48.92,0:15:53.09,Default,,0,0,0,,Бұрынғыдан да неше түрлі жүздеріңді көріп қуандым.
Dialogue: 0,0:15:53.17,0:15:54.84,Default,,0,0,0,,(тыныш музыка)
Dialogue: 0,0:15:54.92,0:15:59.09,Default,,0,0,0,,Мен сіз туралы көбірек білгім келді.
Dialogue: 0,0:16:01.18,0:16:02.35,Default,,0,0,0,,(дірілдеген дауыс)
Dialogue: 0,0:16:02.43,0:16:06.60,Default,,0,0,0,,Өйткені, мен... мен... сен туралы...
Dialogue: 0,0:16:07.94,0:16:10.86,Default,,0,0,0,,Мен... мен сені сүйемін...
Dialogue: 0,0:16:10.94,0:16:13.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:13.57,0:16:16.11,Default,,0,0,0,,Иә? Неге сонша ұялып тұрсың?
Dialogue: 0,0:16:16.19,0:16:18.28,Default,,0,0,0,,Мен мұны ертерек айта алар едім.
Dialogue: 0,0:16:18.36,0:16:19.99,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:16:20.07,0:16:21.41,Default,,0,0,0,,Мен де сені жақсы көремін
Dialogue: 0,0:16:21.49,0:16:23.49,Default,,0,0,0,,Гяааах!
Dialogue: 0,0:16:23.58,0:16:25.54,Default,,0,0,0,,Ах! Эх...! Құдайым!
Dialogue: 0,0:16:25.62,0:16:29.75,Default,,0,0,0,,О, сенің шынайы сезімдеріңді естігеніме өте қуаныштымын.
Dialogue: 0,0:16:29.83,0:16:32.50,Default,,0,0,0,,Жоқ! басқа! Жоқ, ол басқаша!
Dialogue: 0,0:16:32.59,0:16:33.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:33.50,0:16:34.88,Default,,0,0,0,,Бұл реакция біртүрлі!
Dialogue: 0,0:16:34.96,0:16:35.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:35.67,0:16:38.38,Default,,0,0,0,,Дәл қазір сен маған қоқыс қоңызына қарағандай менсінбей қарайсың.
Dialogue: 0,0:16:38.47,0:16:40.55,Default,,0,0,0,,Сіз оны маған көрсеткіңіз келеді.
Dialogue: 0,0:16:40.64,0:16:44.51,Default,,0,0,0,,Ей, эй, сен мұндай жерде не айтқың келіп тұр, Усаги-чан?
Dialogue: 0,0:16:44.60,0:16:45.93,Default,,0,0,0,,Бұл сіздің хоббиіңіз болды ма?
Dialogue: 0,0:16:46.02,0:16:48.35,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:48.43,0:16:50.60,Default,,0,0,0,,Корокоро Корокоро…
Dialogue: 0,0:16:50.69,0:16:52.10,Default,,0,0,0,,Ах
Dialogue: 0,0:16:52.19,0:16:53.56,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:16:53.65,0:16:55.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:56.73,0:16:58.99,Default,,0,0,0,,(баланың жылауы)
Dialogue: 0,0:16:59.07,0:17:00.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:00.32,0:17:02.74,Default,,0,0,0,,(баланың жылауы)
Dialogue: 0,0:17:04.78,0:17:05.74,Default,,0,0,0,,Жанна?
Dialogue: 0,0:17:05.83,0:17:08.50,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:08.58,0:17:10.75,Default,,0,0,0,,Көздер... қызыл!
Dialogue: 0,0:17:10.83,0:17:12.79,Default,,0,0,0,,Вампир?
Dialogue: 0,0:17:12.88,0:17:14.13,Default,,0,0,0,,Бұл вампир!
Dialogue: 0,0:17:14.21,0:17:15.96,Default,,0,0,0,,Ура! Ахх
Dialogue: 0,0:17:16.05,0:17:17.09,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:18.63,0:17:20.47,Default,,0,0,0,,Сабыр ет, Жанна.
Dialogue: 0,0:17:20.55,0:17:22.22,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:22.30,0:17:23.22,Default,,0,0,0,,Түтін экраны?
Dialogue: 0,0:17:23.30,0:17:24.60,Default,,0,0,0,,Ябу Қазір уақыт келді!
Dialogue: 0,0:17:24.68,0:17:26.10,Default,,0,0,0,,Данте?
Dialogue: 0,0:17:26.18,0:17:28.60,Default,,0,0,0,,Мен сізге біреуін бере аламын!
Dialogue: 0,0:17:33.40,0:17:37.98,Default,,0,0,0,,Мен үшін... Вампир деген не? Адам дегеніміз не?
Dialogue: 0,0:17:39.44,0:17:42.15,Default,,0,0,0,,Мм... не айтып тұрсың...
Dialogue: 0,0:17:42.24,0:17:43.99,Default,,0,0,0,,Сіз баласыз
Dialogue: 0,0:17:44.07,0:17:47.74,Default,,0,0,0,,Оны адамдар көтеріп, өсірсе керек.
Dialogue: 0,0:17:47.83,0:17:49.79,Default,,0,0,0,,Ное Альцивист
Dialogue: 0,0:17:50.50,0:17:55.00,Default,,0,0,0,,Сіз Вампирдің жағындасыз ба? Әлде бұл біздің жауымыз ба?
Dialogue: 0,0:18:00.46,0:18:02.38,Default,,0,0,0,,Ешқандай
Dialogue: 0,0:18:02.47,0:18:06.60,Default,,0,0,0,,Мен үшін жау – мен үшін маңызды адам⸺
Dialogue: 0,0:18:06.68,0:18:10.27,Default,,0,0,0,,Мен қорғағым келетін нәрсені ренжітетін болмыс.
Dialogue: 0,0:18:10.35,0:18:12.31,Default,,0,0,0,,Вампир немесе адам?
Dialogue: 0,0:18:12.39,0:18:15.27,Default,,0,0,0,,Өзі жау болып табылатын шарт бола алмайды.
Dialogue: 0,0:18:15.35,0:18:17.73,Default,,0,0,0,,Маған Вампир ұнайды
Dialogue: 0,0:18:17.82,0:18:21.28,Default,,0,0,0,,Сол сияқты мен де адамдарды жақсы көремін.
Dialogue: 0,0:18:25.11,0:18:27.78,Default,,0,0,0,,Түсіндім, түсіндім.
Dialogue: 0,0:18:29.12,0:18:30.79,Default,,0,0,0,,Сіз алмайсыз.
Dialogue: 0,0:18:30.87,0:18:32.79,Default,,0,0,0,,А...?
Dialogue: 0,0:18:32.87,0:18:35.29,Default,,0,0,0,,Не... у... у...
Dialogue: 0,0:18:35.37,0:18:36.67,Default,,0,0,0,,(мазасыз музыка)
Dialogue: 0,0:18:38.21,0:18:39.42,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:39.50,0:18:40.76,Default,,0,0,0,,Лорд Рутвен?
Dialogue: 0,0:18:40.84,0:18:42.30,Default,,0,0,0,,(терең тыныс алу дыбысы)
Dialogue: 0,0:18:44.84,0:18:47.01,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:18:53.10,0:18:56.52,Default,,0,0,0,,(Джаннаның ентігуі)
Dialogue: 0,0:19:00.02,0:19:01.28,Default,,0,0,0,,Жақсысың ба, Жанна?
Dialogue: 0,0:19:10.45,0:19:13.50,Default,,0,0,0,,Жанна Мен мұны бұрын естігенмін.
Dialogue: 0,0:19:13.58,0:19:15.29,Default,,0,0,0,,Сіз қарғыс айтушысыз ба?
Dialogue: 0,0:19:15.37,0:19:17.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:21.88,0:19:24.55,Default,,0,0,0,,Шарлатанды көрдіңіз бе?
Dialogue: 0,0:19:25.72,0:19:30.05,Default,,0,0,0,,Қан соруға деген құштарлықтан басқа денеңізде біртүрлі өзгерістерді сезіндіңіз бе?
Dialogue: 0,0:19:30.14,0:19:33.85,Default,,0,0,0,,(дірілдеп тыныс алу)
Dialogue: 0,0:19:33.93,0:19:35.98,Default,,0,0,0,,[Сыртта: 37F6ECF37A0A3EF8DFF083CCC8754F81]~
Dialogue: 0,0:19:37.85,0:19:38.90,Default,,0,0,0,,Сен…
Dialogue: 0,0:19:38.98,0:19:42.73,Default,,0,0,0,,Бұл туралы ешкімге айтуға тыйым салынады.
Dialogue: 0,0:19:42.82,0:19:44.24,Default,,0,0,0,,(демілеу)
Dialogue: 0,0:19:44.32,0:19:47.24,Default,,0,0,0,,(қорқынышты дыбыс)
Dialogue: 0,0:19:51.33,0:19:52.62,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:19:52.70,0:19:55.91,Default,,0,0,0,,Жоқ, яғни, ол қайда…
Dialogue: 0,0:19:58.71,0:20:02.13,Default,,0,0,0,,Вани… Тас… Мен…
Dialogue: 0,0:20:03.71,0:20:05.55,Default,,0,0,0,,Сізге уәде
Dialogue: 0,0:20:05.63,0:20:07.55,Default,,0,0,0,,Дұрыс қорғау
Dialogue: 0,0:20:08.18,0:20:10.05,Default,,0,0,0,,Сіздің қаныңыздан басқа қан
Dialogue: 0,0:20:10.14,0:20:12.18,Default,,0,0,0,,Оны ешқашан айтқан емес
Dialogue: 0,0:20:12.26,0:20:14.89,Default,,0,0,0,,(Мұңды музыка)
Dialogue: 0,0:20:18.31,0:20:21.23,Default,,0,0,0,,Сәлем, сәлем, танысқаныма қуаныштымын
Dialogue: 0,0:20:24.32,0:20:25.78,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:20:25.86,0:20:28.53,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,0:20:28.61,0:20:30.99,Default,,0,0,0,,Сіз сыйлық беруіңіз керек.
Dialogue: 0,0:20:31.07,0:20:32.99,Default,,0,0,0,,Ей, жартылай жұмыс істейтін! Алдыңа шықшы, өтінемін!
Dialogue: 0,0:20:40.46,0:20:42.25,Default,,0,0,0,,(Түрлі дауыс)
Dialogue: 0,0:20:42.33,0:20:43.88,Default,,0,0,0,,Батырлар дереу қажет!
Dialogue: 0,0:20:43.96,0:20:46.38,Default,,0,0,0,,Жан... Ну... Уф...!
Dialogue: 0,0:20:46.46,0:20:48.13,Default,,0,0,0,,Қосымша
Dialogue: 0,0:20:48.22,0:20:53.14,Default,,0,0,0,,(Ванитастың дірілдеген дауысы)
Dialogue: 0,0:20:53.22,0:20:55.14,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:20:56.22,0:20:57.64,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:04.44,0:21:06.69,Default,,0,0,0,,Негізінен, біз қашамыз.
Dialogue: 0,0:21:06.78,0:21:11.16,Default,,0,0,0,,Осылай оғаш, оғаш бола береді.
Dialogue: 0,0:21:11.24,0:21:16.16,Default,,0,0,0,,Бір күні мен өзім болуды доғарамын...
Dialogue: 0,0:21:16.24,0:21:21.67,Default,,0,0,0,,Лука-саманы ренжітетін күнім келсе, не істеуім керек?
Dialogue: 0,0:21:21.75,0:21:24.67,Default,,0,0,0,,(Джаннаның жылаған дауысы)
Dialogue: 0,0:21:29.30,0:21:32.22,Default,,0,0,0,,Жанна... И
Dialogue: 0,0:21:32.30,0:21:36.10,Default,,0,0,0,,Сіздің қазіргі күйіңізде қарғыс бар ма, жоқ па білмеймін.
Dialogue: 0,0:21:36.18,0:21:39.06,Default,,0,0,0,,Мен сізді кездейсоқ емдеймін деп айта алмаймын.
Dialogue: 0,0:21:39.14,0:21:42.10,Default,,0,0,0,,Бірақ... сондықтан...
Dialogue: 0,0:21:42.19,0:21:43.65,Default,,0,0,0,,Мен уәде беремін
Dialogue: 0,0:21:45.23,0:21:49.32,Default,,0,0,0,,Онда мен сені өлтіремін
Dialogue: 0,0:21:49.40,0:21:51.82,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:51.90,0:21:55.32,Default,,0,0,0,,Сандо, Нанагава және Хигучидің үйлерінде стандартты қауіпсіздік жүйелері жоқ.
Dialogue: 0,0:21:56.08,0:22:00.83,Default,,0,0,0,,(Джаннаның жылаған дауысы)
Dialogue: 0,0:22:05.92,0:22:07.17,Default,,0,0,0,,(♪~соңғы ән)
Dialogue: 0,0:22:07.25,0:22:12.63,Default,,0,0,0,,♪ Ол бастала салысымен ♪ соңын көруге болады
Dialogue: 0,0:22:12.72,0:22:17.47,Default,,0,0,0,,♪ Балмұздақ ыдырап, еріген ♪ сияқты
Dialogue: 0,0:22:17.55,0:22:22.27,Default,,0,0,0,,♪ Ең алыс қашықтықта ақырын естіледі ♪
Dialogue: 0,0:22:22.35,0:22:26.90,Default,,0,0,0,,♪ Бір күрсіну толқындай көтеріледі ♪
Dialogue: 0,0:22:26.98,0:22:30.53,Default,,0,0,0,,♪ 〈Өзімді жоғалтқанда〉 ♪
Dialogue: 0,0:22:30.61,0:22:33.45,Default,,0,0,0,,♪ 〈Мен сен боламын〉 ♪
Dialogue: 0,0:22:33.53,0:22:40.24,Default,,0,0,0,,♪ Бірден онға дейін толтырыңыз, ♪ ұстаңыз
Dialogue: 0,0:22:40.33,0:22:43.21,Default,,0,0,0,,♪ Пердені шешіңіз ♪
Dialogue: 0,0:22:43.29,0:22:48.09,Default,,0,0,0,,♪ Сіздің ат тегіңіз де ертең жойылады ♪
Dialogue: 0,0:22:48.17,0:22:50.63,Default,,0,0,0,,♪ 〈Мен іздеген сен бе едің〉 ♪
Dialogue: 0,0:22:50.71,0:22:53.13,Default,,0,0,0,,♪ 〈Өмірімді жалғыз өткізіп, күттім бе?〉 ♪
Dialogue: 0,0:22:53.22,0:22:55.51,Default,,0,0,0,,♪ 〈Сондай нәзік және шексіз〉 ♪
Dialogue: 0,0:22:55.59,0:22:57.47,Default,,0,0,0,,♪ 〈Сен мені түзеттің Сен мені түзеттің〉 ♪
Dialogue: 0,0:22:57.55,0:23:00.22,Default,,0,0,0,,♪ Көз жасыма батып кетемін ♪
Dialogue: 0,0:23:00.31,0:23:02.64,Default,,0,0,0,,♪ Қоштасудан ары ♪
Dialogue: 0,0:23:02.73,0:23:05.06,Default,,0,0,0,,♪ Айналу уақытының ішінде ♪
Dialogue: 0,0:23:05.14,0:23:07.69,Default,,0,0,0,,♪ 〈Сен мені түзеттің Сен мені түзеттің〉 ♪
Dialogue: 0,0:23:07.77,0:23:09.90,Default,,0,0,0,,♪ 〈Есіктен естіген сен бе едің〉 ♪
Dialogue: 0,0:23:09.98,0:23:12.32,Default,,0,0,0,,♪ 〈Мен жылап, барар жерім болмаған кезде?〉 ♪
Dialogue: 0,0:23:12.40,0:23:14.45,Default,,0,0,0,,♪ Айналу уақытының ішінде ♪
Dialogue: 0,0:23:14.53,0:23:17.11,Default,,0,0,0,,♪ Мен енді жалғыз емеспін ♪
Dialogue: 0,0:23:17.20,0:23:19.45,Default,,0,0,0,,♪ Құшақта ♪ кездестік
Dialogue: 0,0:23:19.53,0:23:21.95,Default,,0,0,0,,♪ 〈Сен мені түзеттің Сен мені түзеттің〉 ♪
Dialogue: 0,0:23:23.25,0:23:27.54,Default,,0,0,0,,♪ 〈Мен өзімді жоғалтамын, өзімді жоғалтамын〉 ♪
Dialogue: 0,0:23:27.62,0:23:31.92,Default,,0,0,0,,♪ Мен енді жалғыз емеспін ♪
Dialogue: 0,0:23:32.00,0:23:33.01,Default,,0,0,0,,(Соңғы ән~♪)
Dialogue: 0,0:23:35.42,0:23:37.34,Default,,0,0,0,,Келесі жолы
Dialogue: 0,0:23:37.43,0:23:39.85,Default,,0,0,0,,(тыныш музыка)
Dialogue: 0,0:23:41.35,0:23:46.35,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
