Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.43,0:00:07.40,Default,,0,0,0,,(Қатты желдің дыбысы)
Dialogue: 0,0:00:23.05,0:00:27.79,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:01:44.27,0:01:46.50,Default,,0,0,0,,(жүрек соғысы)
Dialogue: 0,0:01:46.57,0:01:47.84,Default,,0,0,0,,Чихая...
Dialogue: 0,0:01:48.50,0:01:49.80,Default,,0,0,0,,Суреттерді топтастыру…
Dialogue: 0,0:01:53.21,0:01:59.21,Default,,0,0,0,,♪~
Dialogue: 0,0:04:32.70,0:04:38.71,Default,,0,0,0,,~♪
Dialogue: 0,0:04:43.91,0:04:47.58,Default,,0,0,0,,Адамзат дәуірі аяқталуға жақын қалды
Dialogue: 0,0:04:55.52,0:04:57.86,Default,,0,0,0,,2039 ж
Dialogue: 0,0:04:58.29,0:05:00.93,Default,,0,0,0,,Біраз уақыттан бері келе жатқан теңіз деңгейінің көтерілу дағдарысы
Dialogue: 0,0:05:01.80,0:05:05.03,Default,,0,0,0,,Адамзат нақты шараларды таба алмады.
Dialogue: 0,0:05:05.53,0:05:08.04,Default,,0,0,0,,Кенеттен пайда болған жұмбақ флотқа
Dialogue: 0,0:05:08.40,0:05:10.61,Default,,0,0,0,,Теңіз және ауа еркіндігі
Dialogue: 0,0:05:10.67,0:05:12.94,Default,,0,0,0,,Байланыс құралдарынан айырылған
Dialogue: 0,0:05:13.68,0:05:16.64,Default,,0,0,0,,Бұл флоттың жеке басы мен мақсаты белгісіз.
Dialogue: 0,0:05:16.78,0:05:19.78,Default,,0,0,0,,Бір кезде адамдар оны осылай атады.
Dialogue: 0,0:05:20.42,0:05:22.88,Default,,0,0,0,,«Тұман флоты»
Dialogue: 0,0:05:23.72,0:05:26.92,Default,,0,0,0,,Сыртқы түрі ескірген әскери кемеге ұқсағанымен,
Dialogue: 0,0:05:26.99,0:05:28.79,Default,,0,0,0,,Жабдық барлық жағынан
Dialogue: 0,0:05:28.86,0:05:32.36,Default,,0,0,0,,Ол жер деңгейінен әлдеқайда жоғары болды.
Dialogue: 0,0:05:33.06,0:05:34.70,Default,,0,0,0,,Адамзаттың кез келген әскери күші
Dialogue: 0,0:05:34.76,0:05:37.43,Default,,0,0,0,,Тұман флотының алдында қуатсыз
Dialogue: 0,0:05:37.63,0:05:41.80,Default,,0,0,0,,Біздің қолымыздан ештеңе келмеді, ал әлем тез таусылды.
Dialogue: 0,0:05:46.41,0:05:48.88,Default,,0,0,0,,Әскери-теңіздегі ұрыс тактикасын және бас қолбасшыны үйреніңіз
Dialogue: 0,0:05:48.94,0:05:50.95,Default,,0,0,0,,Теңіз технологиялар академиясы
Dialogue: 0,0:05:51.01,0:05:54.02,Default,,0,0,0,,Мен басшы қызметке кандидат болып тіркелдім.
Dialogue: 0,0:05:54.62,0:05:56.98,Default,,0,0,0,,Жапондық бақылау күштері мұны құпия ұстады.
Dialogue: 0,0:05:57.05,0:05:59.12,Default,,0,0,0,,Құпия мекемеге бару
Dialogue: 0,0:05:59.49,0:06:02.02,Default,,0,0,0,,Тұманға бірінші рет тию
Dialogue: 0,0:06:04.36,0:06:06.99,Default,,0,0,0,,Бұл тұтқынға алынған тұман кемесі.
Dialogue: 0,0:06:07.50,0:06:11.67,Default,,0,0,0,,Сыртқы түрі Пішін Тынық мұхиты соғысындағы сүңгуір қайықтың үлгісінде жасалған.
Dialogue: 0,0:06:11.73,0:06:13.53,Default,,0,0,0,,Адамгершілік емес
Dialogue: 0,0:06:16.44,0:06:18.77,Default,,0,0,0,,Адамзаттың жаулары
Dialogue: 0,0:06:20.98,0:06:22.44,Default,,0,0,0,,Айтамын ғой, қой!
Dialogue: 0,0:06:24.55,0:06:26.61,Default,,0,0,0,,Гунзо Чихая
Dialogue: 0,0:06:27.72,0:06:30.82,Default,,0,0,0,,Бұл мен және тұманды сүңгуір қайық.
Dialogue: 0,0:06:31.59,0:06:34.79,Default,,0,0,0,,Бұл №401 кездесу болды
Dialogue: 0,0:06:40.16,0:06:41.50,Default,,0,0,0,,Міне, келдік
Dialogue: 0,0:06:41.56,0:06:43.77,Default,,0,0,0,,Маған не үшін қоңырау шалғаныңызды айтсаңыз болады ма?
Dialogue: 0,0:06:44.07,0:06:46.67,Default,,0,0,0,,Нақтырақ айтсам, мен күттім.
Dialogue: 0,0:06:47.00,0:06:50.64,Default,,0,0,0,,Мен жеті жыл бойы сыртқы әлемнен оқшауландым.
Dialogue: 0,0:06:50.71,0:06:51.97,Default,,0,0,0,,7 жыл?
Dialogue: 0,0:06:52.04,0:06:53.94,Default,,0,0,0,,Бұл не? сен
Dialogue: 0,0:06:54.01,0:06:56.58,Default,,0,0,0,,Мен маған берілген бұйрықтарды орындаймын
Dialogue: 0,0:06:56.81,0:06:57.91,Default,,0,0,0,,Құралдар
Dialogue: 0,0:06:58.98,0:06:59.85,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:03.45,0:07:05.69,Default,,0,0,0,,Жер бетінде сен несің...
Dialogue: 0,0:07:05.75,0:07:07.62,Default,,0,0,0,,Гунзо Чихая
Dialogue: 0,0:07:07.72,0:07:10.19,Default,,0,0,0,,Маған сенің соңынан еруімді айтты
Dialogue: 0,0:07:10.46,0:07:12.19,Default,,0,0,0,,Мен басқа ештеңе білмеймін
Dialogue: 0,0:07:14.53,0:07:17.57,Default,,0,0,0,,Тексеру Сіздің мақсатыңыз қандай?
Dialogue: 0,0:07:17.70,0:07:19.73,Default,,0,0,0,,Менің мақсатым?
Dialogue: 0,0:07:23.50,0:07:24.67,Default,,0,0,0,,Мен...
Dialogue: 0,0:07:28.78,0:07:31.85,Default,,0,0,0,,Мен тоқырауды енді бұзамын
Dialogue: 0,0:07:31.91,0:07:33.68,Default,,0,0,0,,Мен күш алғым келеді
Dialogue: 0,0:07:35.55,0:07:36.92,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:07:38.65,0:07:39.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:39.59,0:07:40.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:55.47,0:07:57.04,Default,,0,0,0,,401…
Dialogue: 0,0:07:57.10,0:07:58.87,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:07:59.01,0:08:02.51,Default,,0,0,0,,Сен тұмансың ба...?
Dialogue: 0,0:08:02.58,0:08:03.64,Default,,0,0,0,,Иә
Dialogue: 0,0:08:04.21,0:08:05.55,Default,,0,0,0,,Жау?
Dialogue: 0,0:08:05.61,0:08:06.78,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:08:07.22,0:08:08.72,Default,,0,0,0,,Мен білетін жалғыз нәрсе
Dialogue: 0,0:08:09.15,0:08:12.09,Default,,0,0,0,,Сізбен байланысу және бағыну
Dialogue: 0,0:08:12.25,0:08:16.06,Default,,0,0,0,,Бұл менің ішімде өмір сүретін жалғыз бұйрық
Dialogue: 0,0:08:18.03,0:08:19.96,Default,,0,0,0,,Біз қарумыз
Dialogue: 0,0:08:20.03,0:08:21.96,Default,,0,0,0,,Бұйрық бойынша шайқас
Dialogue: 0,0:08:22.03,0:08:23.73,Default,,0,0,0,,Мұның бәрі бар
Dialogue: 0,0:08:24.57,0:08:27.24,Default,,0,0,0,,Сонымен, бізге пәрмен керек
Dialogue: 0,0:08:29.27,0:08:30.71,Default,,0,0,0,,401
Dialogue: 0,0:08:33.14,0:08:35.74,Default,,0,0,0,,Сен менің кемем боласың!
Dialogue: 0,0:08:45.09,0:08:46.05,Default,,0,0,0,,Суреттер тобы
Dialogue: 0,0:08:48.26,0:08:50.73,Default,,0,0,0,,Маған мін
Dialogue: 0,0:08:53.26,0:08:56.20,Default,,0,0,0,,Жаңа қару... торпедо ма?
Dialogue: 0,0:08:56.83,0:08:59.77,Default,,0,0,0,,Сіз тұман эрозиясының торпедасын талдаған сияқтысыз.
Dialogue: 0,0:08:59.83,0:09:02.17,Default,,0,0,0,,Одан әрі күшейген сияқты.
Dialogue: 0,0:09:02.30,0:09:04.14,Default,,0,0,0,,Қара жәшіктер көп болса да
Dialogue: 0,0:09:04.21,0:09:06.57,Default,,0,0,0,,Әрине, егер бұл жаппай өндірілсе
Dialogue: 0,0:09:06.64,0:09:09.58,Default,,0,0,0,,Адамзаттың қарсы шабуылы болуы мүмкін.
Dialogue: 0,0:09:09.88,0:09:12.01,Default,,0,0,0,,Америка ғана қалса
Dialogue: 0,0:09:12.08,0:09:14.25,Default,,0,0,0,,Біртүрлі ештеңе айтпа.
Dialogue: 0,0:09:14.55,0:09:16.82,Default,,0,0,0,,Бұл мәселеге қатысты Америка Құрама Штаттарымен де құпия келісім бар.
Dialogue: 0,0:09:16.88,0:09:18.69,Default,,0,0,0,,Бұл үш ай бұрын болды.
Dialogue: 0,0:09:18.75,0:09:20.02,Default,,0,0,0,,Осыдан кейін байланыс үзілді.
Dialogue: 0,0:09:20.09,0:09:22.62,Default,,0,0,0,,Мен қазір не болып жатқанын білмеймін.
Dialogue: 0,0:09:22.86,0:09:25.19,Default,,0,0,0,,Иона~ Түсінбегеніңізге сенімдісіз бе?
Dialogue: 0,0:09:25.26,0:09:28.90,Default,,0,0,0,,Мен басқа кемелерден алынған ақпаратқа тыйым салдым.
Dialogue: 0,0:09:28.96,0:09:32.20,Default,,0,0,0,,Менің білетінім – мен қабылдайтын нәрсе
Dialogue: 0,0:09:32.27,0:09:33.33,Default,,0,0,0,,Дұрыс?
Dialogue: 0,0:09:33.94,0:09:36.70,Default,,0,0,0,,Сонымен капитан өтінішті қабылдады ма?
Dialogue: 0,0:09:36.84,0:09:38.84,Default,,0,0,0,,О, бұл жұмыс
Dialogue: 0,0:09:38.91,0:09:42.08,Default,,0,0,0,,Тек біз оны сәтті ете аламыз.
Dialogue: 0,0:09:42.28,0:09:45.08,Default,,0,0,0,,Жаңа қару үлгілері Йокосука портында жеткізіледі
Dialogue: 0,0:09:45.58,0:09:46.71,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:09:46.78,0:09:48.68,Default,,0,0,0,,Йокосука бағытын орнатыңыз
Dialogue: 0,0:09:49.22,0:09:52.82,Default,,0,0,0,,Мен адамзаттың үмітін аламын!
Dialogue: 0,0:10:07.84,0:10:09.27,Default,,0,0,0,,Тіпті осы денеде
Dialogue: 0,0:10:09.34,0:10:11.04,Default,,0,0,0,,Мен оған біраз үйреніп қалдым.
Dialogue: 0,0:10:11.67,0:10:13.21,Default,,0,0,0,,Қарғыс атсын.
Dialogue: 0,0:10:13.27,0:10:14.98,Default,,0,0,0,,Біз қару болсақ та
Dialogue: 0,0:10:17.08,0:10:18.11,Default,,0,0,0,,Такао
Dialogue: 0,0:10:18.38,0:10:19.91,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:20.08,0:10:22.98,Default,,0,0,0,,401 осында жатыр ма?
Dialogue: 0,0:10:23.68,0:10:26.15,Default,,0,0,0,,Адамзатқа опасыздық жасаушы
Dialogue: 0,0:10:26.35,0:10:30.02,Default,,0,0,0,,Бұл Такао сізді шаңға айналдырады.
Dialogue: 0,0:10:32.03,0:10:36.00,Default,,0,0,0,,Кеме қазір №11 тайфунның ықпалында.
Dialogue: 0,0:10:36.06,0:10:37.26,Default,,0,0,0,,(Hagakure) Осы жолы сені қашып құтыла алмайсың! (Black) Уф…
Dialogue: 0,0:10:37.33,0:10:40.00,Default,,0,0,0,,Тайфунның бағыты бойынша солтүстікке қарай жүріңіз.
Dialogue: 0,0:10:40.07,0:10:42.84,Default,,0,0,0,,Такаоның көзінен қашып, Йокосукаға кіріңіз
Dialogue: 0,0:10:42.90,0:10:44.94,Default,,0,0,0,,Бұл қол қазірдің өзінде өлі.
Dialogue: 0,0:10:45.01,0:10:46.37,Default,,0,0,0,,Сонымен, В жоспары
Dialogue: 0,0:10:46.64,0:10:49.71,Default,,0,0,0,,Тайфуннан шығып, Такаоның пикет сызығын айналып өту
Dialogue: 0,0:10:49.78,0:10:51.08,Default,,0,0,0,,Йокосукаға жақындау
Dialogue: 0,0:10:51.68,0:10:54.15,Default,,0,0,0,,Ондай жағдайда Такаоның ізін суыта алмай
Dialogue: 0,0:10:54.22,0:10:56.98,Default,,0,0,0,,Йокосукаға жету мүмкіндігі бар.
Dialogue: 0,0:10:58.75,0:11:00.82,Default,,0,0,0,,Міне, С жоспары.
Dialogue: 0,0:11:01.22,0:11:03.19,Default,,0,0,0,,Міне, біз Такаоны жеңеміз!
Dialogue: 0,0:11:03.26,0:11:04.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:04.19,0:11:07.19,Default,,0,0,0,,Кенеттен ауыр крейсер класы?
Dialogue: 0,0:11:18.81,0:11:19.87,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:19.94,0:11:21.34,Default,,0,0,0,,Бұл шын ба?
Dialogue: 0,0:11:25.35,0:11:27.05,Default,,0,0,0,,Іске қосу
Dialogue: 0,0:11:44.93,0:11:46.37,Default,,0,0,0,,Біріншіден, бір соққымен
Dialogue: 0,0:11:46.43,0:11:48.47,Default,,0,0,0,,Кляйн өрісін сыни етіп көрсетіңіз
Dialogue: 0,0:11:50.24,0:11:51.11,Default,,0,0,0,,Топтық сурет?
Dialogue: 0,0:11:51.31,0:11:52.17,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:54.04,0:11:55.48,Default,,0,0,0,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:11:59.18,0:12:02.88,Default,,0,0,0,,Мен Хьюга сияқты бола алмаймын.
Dialogue: 0,0:12:03.95,0:12:05.49,Default,,0,0,0,,Тереңдігі 15
Dialogue: 0,0:12:06.32,0:12:08.32,Default,,0,0,0,,Тез кел
Dialogue: 0,0:12:08.39,0:12:09.99,Default,,0,0,0,,401
Dialogue: 0,0:12:10.29,0:12:11.89,Default,,0,0,0,,Тереңдігі 10
Dialogue: 0,0:12:11.96,0:12:12.99,Default,,0,0,0,,Теңіз деңгейі жақын арада
Dialogue: 0,0:12:16.20,0:12:17.73,Default,,0,0,0,,Сол сияқты
Dialogue: 0,0:12:17.80,0:12:19.37,Default,,0,0,0,,Иә, солай
Dialogue: 0,0:12:19.80,0:12:21.50,Default,,0,0,0,,Теңіз деңгейіне 3...
Dialogue: 0,0:12:21.84,0:12:22.90,Default,,0,0,0,,2… 1…
Dialogue: 0,0:12:23.24,0:12:24.11,Default,,0,0,0,,Левитация
Dialogue: 0,0:12:25.97,0:12:27.01,Default,,0,0,0,,Қапталушы
Dialogue: 0,0:12:27.07,0:12:28.14,Default,,0,0,0,,Көп руль!
Dialogue: 0,0:12:28.24,0:12:30.24,Default,,0,0,0,,Рульге толы сері
Dialogue: 0,0:12:39.12,0:12:41.46,Default,,0,0,0,,Қалқымалы қозғалыс! Қозғалтқыштың максималды жылдамдығы!
Dialogue: 0,0:12:41.99,0:12:43.46,Default,,0,0,0,,Шашырауға болатынның бәрін шашыраңдар!
Dialogue: 0,0:12:44.02,0:12:46.26,Default,,0,0,0,,Ол біздің қайда екенімізді жақсы біледі!
Dialogue: 0,0:12:55.17,0:12:56.47,Default,,0,0,0,,жойылды ма?
Dialogue: 0,0:12:56.54,0:12:59.97,Default,,0,0,0,,Өте ауырлық зеңбіректерінің ату уақыты тамаша болуы керек еді.
Dialogue: 0,0:13:00.31,0:13:01.38,Default,,0,0,0,,Бірақ
Dialogue: 0,0:13:02.21,0:13:04.55,Default,,0,0,0,,Эрозияға ұшыраған көптеген қару-жарақ
Dialogue: 0,0:13:05.31,0:13:07.11,Default,,0,0,0,,Олардың барлығынан аулақ бола аласыз ба?
Dialogue: 0,0:13:07.95,0:13:10.92,Default,,0,0,0,,Мен Иона Хюганың заттарын пайдаланамын.
Dialogue: 0,0:13:11.25,0:13:12.22,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:13:22.36,0:13:25.20,Default,,0,0,0,,Максималды қозғалтқыш! Graviton Float Blow!
Dialogue: 0,0:13:25.27,0:13:27.50,Default,,0,0,0,,Барлық мүшелер Соққыға қарсы қорғаныс!
Dialogue: 0,0:13:27.57,0:13:29.17,Default,,0,0,0,,Барлық кемелер тез көтеріледі!
Dialogue: 0,0:13:35.84,0:13:37.14,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,0:13:37.24,0:13:38.91,Default,,0,0,0,,401
Dialogue: 0,0:13:39.08,0:13:39.95,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:43.88,0:13:44.92,Default,,0,0,0,,Не?
Dialogue: 0,0:13:49.39,0:13:50.46,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:57.43,0:13:59.37,Default,,0,0,0,,Өте ауырлық зеңбірегі...
Dialogue: 0,0:13:59.53,0:14:02.60,Default,,0,0,0,,Неліктен мұндай нәрсе круиздік сүңгуір қайыққа ұқсайды?
Dialogue: 0,0:14:03.14,0:14:05.21,Default,,0,0,0,,501 Төтенше жағдайды болдырмау!
Dialogue: 0,0:14:05.27,0:14:06.31,Default,,0,0,0,,Байланысты үзіңіз!
Dialogue: 0,0:14:17.18,0:14:18.15,Default,,0,0,0,,Практикалық емтихан: Дайын бол, баста!
Dialogue: 0,0:14:18.22,0:14:20.86,Default,,0,0,0,,Бір кемеге ұқсайтындай қарнына жабысып қалды!
Dialogue: 0,0:14:21.36,0:14:24.06,Default,,0,0,0,,Takao ғарыш осін іске қосу бекітілген
Dialogue: 0,0:14:29.60,0:14:31.23,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:33.03,0:14:34.57,Default,,0,0,0,,Психикалық модель?
Dialogue: 0,0:14:35.24,0:14:36.97,Default,,0,0,0,,Биіктік бұрышы минус 3 градус
Dialogue: 0,0:14:37.04,0:14:38.64,Default,,0,0,0,,Биіктік бұрышы минус 3 градус
Dialogue: 0,0:14:38.94,0:14:40.94,Default,,0,0,0,,Ей, Такаоға (Гунзо) жетеді!
Dialogue: 0,0:14:42.64,0:14:43.51,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:48.48,0:14:50.65,Default,,0,0,0,,Барлық мүшелер! Шокқа дайындалыңыз!
Dialogue: 0,0:14:50.92,0:14:53.05,Default,,0,0,0,,Супер гравитациялық зеңбірек атуы!
Dialogue: 0,0:14:53.65,0:14:54.52,Default,,0,0,0,,Өрт!
Dialogue: 0,0:15:02.16,0:15:03.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:24.62,0:15:26.39,Default,,0,0,0,,Сізді ұрып-соққан сияқты.
Dialogue: 0,0:15:28.96,0:15:31.43,Default,,0,0,0,,Қару-жарақтарды 24 сағатқа жауып тастаңыз.
Dialogue: 0,0:15:31.49,0:15:33.09,Default,,0,0,0,,Бұл... 401
Dialogue: 0,0:15:33.16,0:15:35.30,Default,,0,0,0,,Өйткені менде ауырлық күшінің зеңбірегі сияқты бір нәрсе жасырылған болатын.
Dialogue: 0,0:15:36.00,0:15:38.13,Default,,0,0,0,,Бірақ... неге мұндай нәрсе?
Dialogue: 0,0:15:38.30,0:15:40.63,Default,,0,0,0,,Хьюгадан алынған зат шығар.
Dialogue: 0,0:15:40.70,0:15:43.47,Default,,0,0,0,,Адамдар – өнертапқыш жаратылыс.
Dialogue: 0,0:15:43.70,0:15:45.17,Default,,0,0,0,,Хюуга?
Dialogue: 0,0:15:45.27,0:15:48.61,Default,,0,0,0,,401 және Хюуга баяғыда шайқас болды.
Dialogue: 0,0:15:48.68,0:15:51.05,Default,,0,0,0,,Ал Хюуга жеңіліп қалды.
Dialogue: 0,0:15:51.11,0:15:54.62,Default,,0,0,0,,Жабдықтарыңызды адамдар ұрлап алғаны қандай ұят.
Dialogue: 0,0:15:54.68,0:15:57.28,Default,,0,0,0,,401-де құлыпталған қарулар
Dialogue: 0,0:15:57.35,0:15:59.95,Default,,0,0,0,,Сізді ашық теңізге жібердіңіз
Dialogue: 0,0:16:00.02,0:16:01.49,Default,,0,0,0,,Сен Хюугаға күле аласың ба?
Dialogue: 0,0:16:01.56,0:16:02.56,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:04.73,0:16:06.26,Default,,0,0,0,,Хаа… Хаа… Хаа…
Dialogue: 0,0:16:06.33,0:16:08.06,Default,,0,0,0,,Бұл орындалмады!
Dialogue: 0,0:16:09.63,0:16:11.43,Default,,0,0,0,,Бұл сізге ұқсамайды.
Dialogue: 0,0:16:11.50,0:16:13.33,Default,,0,0,0,,Сонымен, ақыры уақыт келді—
Dialogue: 0,0:16:14.00,0:16:15.07,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:16:26.65,0:16:29.52,Default,,0,0,0,,Егер сізде бортта адам деп аталатын бөлімше болса
Dialogue: 0,0:16:30.05,0:16:32.35,Default,,0,0,0,,Мұндай тактика мүмкін бе?
Dialogue: 0,0:16:38.19,0:16:39.99,Default,,0,0,0,,Сол бірлік
Dialogue: 0,0:16:40.09,0:16:42.13,Default,,0,0,0,,Мен де соны қалаймын
Dialogue: 0,0:17:18.33,0:17:20.27,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:17:20.33,0:17:21.70,Default,,0,0,0,,Сыртқы қалқаны босату
Dialogue: 0,0:17:21.77,0:17:24.41,Default,,0,0,0,,Арба ауласына түсуді бастаңыз
Dialogue: 0,0:17:40.35,0:17:42.42,Default,,0,0,0,,Уау! (Гунзо) Аман қалған жапон флоты
Dialogue: 0,0:17:42.49,0:17:45.73,Default,,0,0,0,,Бұл тұманнан қорғау үшін салынған жер асты док.
Dialogue: 0,0:18:01.41,0:18:03.58,Default,,0,0,0,,Сәлем! Иона-чан!
Dialogue: 0,0:18:03.64,0:18:05.41,Default,,0,0,0,,Ішіңді аздап ашып, көрсетші!
Dialogue: 0,0:18:07.18,0:18:07.85,Default,,0,0,0,,Әй!
Dialogue: 0,0:18:08.65,0:18:11.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:22.50,0:18:23.36,Default,,0,0,0,,Монах!
Dialogue: 0,0:18:23.43,0:18:24.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:24.83,0:18:27.50,Default,,0,0,0,,Сіз болмаған кезде бұйрық командирдің орынбасарына жүктеледі!
Dialogue: 0,0:18:28.20,0:18:29.10,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:18:29.17,0:18:31.17,Default,,0,0,0,,Сабақта болмаған кезде бұйрыққа жауап береді
Dialogue: 0,0:18:31.77,0:18:34.84,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:18:45.42,0:18:49.29,Default,,0,0,0,,Бұл тұманға қарсы шайқаста қаза тапқандарға арналған ескерткіш.
Dialogue: 0,0:18:51.73,0:18:53.89,Default,,0,0,0,,Бұл теңіз зираты.
Dialogue: 0,0:18:54.39,0:18:55.50,Default,,0,0,0,,Зират?
Dialogue: 0,0:18:55.56,0:18:56.86,Default,,0,0,0,,Өлгендерді жоқтау
Dialogue: 0,0:18:57.13,0:18:59.63,Default,,0,0,0,,Жанды тыныштандыратын жер
Dialogue: 0,0:18:59.70,0:19:00.87,Default,,0,0,0,,Өлі...
Dialogue: 0,0:19:01.14,0:19:03.80,Default,,0,0,0,,Тіршілік қызметі тоқтаған адам?
Dialogue: 0,0:19:06.67,0:19:09.28,Default,,0,0,0,,Өлгендерді жоқтаудың мағынасы бар ма?
Dialogue: 0,0:19:09.71,0:19:10.88,Default,,0,0,0,,Мағынасы?
Dialogue: 0,0:19:16.35,0:19:18.25,Default,,0,0,0,,Артында қалғандар
Dialogue: 0,0:19:18.32,0:19:21.26,Default,,0,0,0,,Шындықпен келісімге келу... Менің ойымша.
Dialogue: 0,0:19:21.46,0:19:23.79,Default,,0,0,0,,Бұл жай ғана орын
Dialogue: 0,0:19:23.86,0:19:28.16,Default,,0,0,0,,Жай жерлерге мән беретін де адамдар.
Dialogue: 0,0:19:28.23,0:19:28.90,Default,,0,0,0,,Осылайша
Dialogue: 0,0:19:29.63,0:19:31.73,Default,,0,0,0,,Жан тыныштығын алыңыз
Dialogue: 0,0:19:32.40,0:19:33.90,Default,,0,0,0,,Мәнсіз әрекеттер
Dialogue: 0,0:19:34.40,0:19:35.94,Default,,0,0,0,,Мағынасыз...?
Dialogue: 0,0:19:37.57,0:19:40.64,Default,,0,0,0,,Бірақ сол мағынасыз әрекеттен мән табуға тырысу
Dialogue: 0,0:19:40.71,0:19:43.38,Default,,0,0,0,,Менің ойымша, бұл адам эволюциясы деп аталады.
Dialogue: 0,0:19:46.21,0:19:50.22,Default,,0,0,0,,Көшіру арқылы деградация сөзсіз көбейту жүйесін белсендіреді.
Dialogue: 0,0:19:50.28,0:19:51.79,Default,,0,0,0,,Әртүрлілікті сақтау
Dialogue: 0,0:19:51.85,0:19:54.39,Default,,0,0,0,,Белгісіздік шуына ұқсас
Dialogue: 0,0:19:54.59,0:19:55.52,Default,,0,0,0,,Иә
Dialogue: 0,0:19:58.46,0:20:00.39,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:20:02.93,0:20:05.93,Default,,0,0,0,,``Капитан кеме туралы бәрін біледі.''
Dialogue: 0,0:20:06.20,0:20:07.40,Default,,0,0,0,,``Бұл капитан.''
Dialogue: 0,0:20:07.47,0:20:08.90,Default,,0,0,0,,«Кемеде бәрі сіз қалағандай»
Dialogue: 0,0:20:09.30,0:20:10.80,Default,,0,0,0,,«Көшуге.»
Dialogue: 0,0:20:12.21,0:20:14.21,Default,,0,0,0,,Қалауыңызша
Dialogue: 0,0:20:14.31,0:20:15.51,Default,,0,0,0,,Қозғалу керек пе?
Dialogue: 0,0:20:15.98,0:20:17.88,Default,,0,0,0,,Кел, Такао
Dialogue: 0,0:20:19.61,0:20:23.32,Default,,0,0,0,,Менімен қалағаныңды істе...
Dialogue: 0,0:20:23.78,0:20:24.65,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:29.46,0:20:31.46,Default,,0,0,0,,Бұл таңқаларлық жылдам болды.
Dialogue: 0,0:20:32.43,0:20:33.66,Default,,0,0,0,,400
Dialogue: 0,0:20:33.79,0:20:35.50,Default,,0,0,0,,402
Dialogue: 0,0:20:36.00,0:20:39.70,Default,,0,0,0,,Неліктен флоттан кеткеніңізді білгім келеді.
Dialogue: 0,0:20:39.77,0:20:42.70,Default,,0,0,0,,Өйткені ұғымды беру байланысы үзілген.
Dialogue: 0,0:20:42.77,0:20:45.47,Default,,0,0,0,,Бізге жеке келуден басқа амал қалмады.
Dialogue: 0,0:20:46.37,0:20:47.87,Default,,0,0,0,,Мен қалаймын
Dialogue: 0,0:20:48.48,0:20:49.44,Default,,0,0,0,,Капитан
Dialogue: 0,0:20:49.74,0:20:50.78,Default,,0,0,0,,Капитан?
Dialogue: 0,0:20:50.84,0:20:53.25,Default,,0,0,0,,Сіз Чихая Гунзо туралы айтып отырсыз ба?
Dialogue: 0,0:20:53.65,0:20:57.78,Default,,0,0,0,,Ол мені менен жақсырақ пайдалана алады.
Dialogue: 0,0:20:58.25,0:21:00.35,Default,,0,0,0,,Мен күшті болғым келеді
Dialogue: 0,0:21:00.45,0:21:02.26,Default,,0,0,0,,Қару болса, табиғи нәрсе, солай емес пе?
Dialogue: 0,0:21:03.26,0:21:04.86,Default,,0,0,0,,Бұл қандай да бір жоспар бар дегенді білдіре ме?
Dialogue: 0,0:21:06.69,0:21:07.56,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:07.69,0:21:08.83,Default,,0,0,0,,Бұл туралы қазір ойлану
Dialogue: 0,0:21:08.90,0:21:10.00,Default,,0,0,0,,Ой жоқ
Dialogue: 0,0:21:10.26,0:21:12.60,Default,,0,0,0,,Тұманнан жоспарсыз секірдіңіз бе?
Dialogue: 0,0:21:12.83,0:21:13.80,Default,,0,0,0,,Шулы!
Dialogue: 0,0:21:28.38,0:21:30.35,Default,,0,0,0,,401 хабарласқанда
Dialogue: 0,0:21:30.42,0:21:33.02,Default,,0,0,0,,Мен бір қарағанда қызық нәрсе көрдім.
Dialogue: 0,0:21:33.29,0:21:35.62,Default,,0,0,0,,Мен ол адамды сонда күтемін.
Dialogue: 0,0:21:40.83,0:21:43.40,Default,,0,0,0,,Үздіксіз бақылау қажет.
Dialogue: 0,0:21:43.73,0:21:46.30,Default,,0,0,0,,Иә, сол қызды пайдалан.
Dialogue: 0,0:21:46.53,0:21:48.40,Default,,0,0,0,,Сол баланы пайдалану
Dialogue: 0,0:21:53.81,0:21:54.68,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:55.84,0:21:57.94,Default,,0,0,0,,Эй Конгоу, сен білесің бе?
Dialogue: 0,0:21:58.01,0:22:00.95,Default,,0,0,0,,Ресейде шайға джем салады.
Dialogue: 0,0:22:01.01,0:22:01.88,Default,,0,0,0,,Кептеліс пе?
Dialogue: 0,0:22:02.35,0:22:03.85,Default,,0,0,0,,Сақтау ретінде де белгілі!
Dialogue: 0,0:22:03.92,0:22:06.09,Default,,0,0,0,,Жемістерді қантпен қайнатып жасайды.
Dialogue: 0,0:22:06.35,0:22:07.35,Default,,0,0,0,,Консервіленген тағам!
Dialogue: 0,0:22:07.42,0:22:09.39,Default,,0,0,0,,Оны салсаңыз не болады?
Dialogue: 0,0:22:09.59,0:22:10.89,Default,,0,0,0,,Сол уақыттан бері жағдай өзгерді ғой, иә?
Dialogue: 0,0:22:11.09,0:22:13.83,Default,,0,0,0,,Бірақ мен бұл текшеге қарағанда сәндірақ сияқтымын!
Dialogue: 0,0:22:14.93,0:22:18.00,Default,,0,0,0,,Не айтып тұрғаныңызды түсінбедім.
Dialogue: 0,0:22:18.43,0:22:20.47,Default,,0,0,0,,401 Не істеу керек?
Dialogue: 0,0:22:20.53,0:22:22.97,Default,,0,0,0,,Мен оның батып кетуіне жол беремін. Менің қолым қазірдің өзінде.
Dialogue: 0,0:22:23.04,0:22:24.54,Default,,0,0,0,,Хмм.
Dialogue: 0,0:22:25.67,0:22:28.64,Default,,0,0,0,,Түсіндім, мен сол екі кемені жібердім.
Dialogue: 0,0:22:29.34,0:22:31.68,Default,,0,0,0,,Әй, бұл тактика ма?
Dialogue: 0,0:22:38.49,0:22:40.35,Default,,0,0,0,,7 жыл болды.
Dialogue: 0,0:22:42.86,0:22:44.06,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:22:45.93,0:22:46.89,Default,,0,0,0,,Жылдам сүңгу!
Dialogue: 0,0:22:46.96,0:22:48.10,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:22:57.70,0:22:58.74,Default,,0,0,0,,Эрозиялық торпедалар?
Dialogue: 0,0:22:59.11,0:23:01.64,Default,,0,0,0,,Эрозия реакциясын есептеу орындалуда
Dialogue: 0,0:23:02.54,0:23:03.84,Default,,0,0,0,,Клейнфилд
Dialogue: 0,0:23:03.94,0:23:05.45,Default,,0,0,0,,Басқаруды бастау
Dialogue: 0,0:23:09.42,0:23:10.82,Default,,0,0,0,,Торпеданың эрозиясының қонуы!
Dialogue: 0,0:23:10.88,0:23:13.82,Default,,0,0,0,,Жаудың Клейнфилд кемесі орналастырылғанын растаңыз!
Dialogue: 0,0:23:18.86,0:23:20.96,Default,,0,0,0,,Бұл Йокосука қорғаныс қабырғасы
Dialogue: 0,0:23:21.03,0:23:24.53,Default,,0,0,0,,Сумен жабдықтау және суды кетіру розеткалары белгілі бір уақыт аралығында орнатылады.
Dialogue: 0,0:23:25.07,0:23:26.87,Default,,0,0,0,,Теңіз суы кіріп-шығады
Dialogue: 0,0:23:26.93,0:23:29.90,Default,,0,0,0,,Ғимараттар тобынан өту арқылы
Dialogue: 0,0:23:29.97,0:23:33.17,Default,,0,0,0,,Бұл салада күрделі тенденциялар қалыптасқан.
Dialogue: 0,0:23:33.44,0:23:34.61,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:23:34.67,0:23:37.08,Default,,0,0,0,,Осы толқынмен бірге жүрсек...
Dialogue: 0,0:23:37.18,0:23:39.71,Default,,0,0,0,,Менің орным анықталмады
Dialogue: 0,0:23:39.78,0:23:41.98,Default,,0,0,0,,Жаудың артына өте алады
Dialogue: 0,0:23:42.85,0:23:43.92,Default,,0,0,0,,Суреттер тобы
Dialogue: 0,0:23:43.98,0:23:46.85,Default,,0,0,0,,Аа, міне, нақты нәрсе келді.
Dialogue: 0,0:23:48.99,0:23:50.89,Default,,0,0,0,,Біз қарумыз
Dialogue: 0,0:23:50.96,0:23:54.93,Default,,0,0,0,,Алдыңыздағы жауды суға батыруды ойлаңыз.
Dialogue: 0,0:23:55.43,0:23:56.10,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:23:56.16,0:23:57.03,Default,,0,0,0,,Ах!
Dialogue: 0,0:23:57.46,0:23:58.47,Default,,0,0,0,,Танатоний реакциясы
Dialogue: 0,0:23:58.60,0:23:59.70,Default,,0,0,0,,Алдыңғы!
Dialogue: 0,0:24:05.54,0:24:07.17,Default,,0,0,0,,Алда кеменің көлеңкесі бар
Dialogue: 0,0:24:07.44,0:24:09.64,Default,,0,0,0,,Бұл өлшем алдау емес
Dialogue: 0,0:24:09.88,0:24:12.51,Default,,0,0,0,,401 немесе нәжіс
Dialogue: 0,0:24:12.75,0:24:15.45,Default,,0,0,0,,Олар жүгіру мен жасырынудан бас тартқан сияқты.
Dialogue: 0,0:24:24.09,0:24:24.96,Default,,0,0,0,,Батып кету
Dialogue: 0,0:24:26.56,0:24:27.59,Default,,0,0,0,,Ха! Киришима!
Dialogue: 0,0:24:27.83,0:24:28.70,Default,,0,0,0,,Ха!
Dialogue: 0,0:24:36.87,0:24:38.61,Default,,0,0,0,,Артынан?
Dialogue: 0,0:24:38.67,0:24:40.04,Default,,0,0,0,,401 алға…
Dialogue: 0,0:24:40.11,0:24:40.97,Default,,0,0,0,,Ха!
Dialogue: 0,0:24:41.88,0:24:43.61,Default,,0,0,0,,(Камо) Һм. (Фушигиро) Ұф.
Dialogue: 0,0:24:44.01,0:24:45.61,Default,,0,0,0,,Микаса шайқасы
Dialogue: 0,0:24:45.68,0:24:47.75,Default,,0,0,0,,1902 жылы іске қосылды
Dialogue: 0,0:24:47.81,0:24:50.22,Default,,0,0,0,,Бұрынғы Йокосука қаласымен бірге су астында қалды
Dialogue: 0,0:24:50.48,0:24:54.25,Default,,0,0,0,,Белсендірілген наноматериалдарды бетіне шашу арқылы
Dialogue: 0,0:24:54.75,0:24:56.22,Default,,0,0,0,,бізді алдады
Dialogue: 0,0:24:58.09,0:24:59.73,Default,,0,0,0,,Біз екеуміз...
Dialogue: 0,0:24:59.79,0:25:01.56,Default,,0,0,0,,Сізді ойнап жатыр ма? Харуна
Dialogue: 0,0:25:03.06,0:25:04.90,Default,,0,0,0,,Жақсы~ 401
Dialogue: 0,0:25:05.13,0:25:07.50,Default,,0,0,0,,Өте қызық...
Dialogue: 0,0:25:08.24,0:25:09.24,Default,,0,0,0,,Бірінші рет!
Dialogue: 0,0:25:09.57,0:25:10.80,Default,,0,0,0,,Иә.
Dialogue: 0,0:25:10.87,0:25:13.54,Default,,0,0,0,,Мен оны өз қолыммен батырғым келеді!
Dialogue: 0,0:25:13.91,0:25:14.77,Default,,0,0,0,,Мүлдем!
Dialogue: 0,0:25:15.61,0:25:17.78,Default,,0,0,0,,Киришиманың эмоция эмуляторының мәндері
Dialogue: 0,0:25:17.84,0:25:19.15,Default,,0,0,0,,кенет ауытқулар
Dialogue: 0,0:25:19.25,0:25:21.78,Default,,0,0,0,,Мен сізге 401 айтамын
Dialogue: 0,0:25:21.85,0:25:25.65,Default,,0,0,0,,Кім күшті, сіз немесе біз, бортында адамдар бар ма?
Dialogue: 0,0:25:26.15,0:25:27.15,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:25:27.22,0:25:29.16,Default,,0,0,0,,Киришимамен танысайық
Dialogue: 0,0:25:33.93,0:25:34.79,Default,,0,0,0,,Ғү… Ақымақ, шегінбе! ➡
Dialogue: 0,0:25:34.86,0:25:36.66,Default,,0,0,0,,Бірдеңе дұрыс емес пе?
Dialogue: 0,0:25:37.03,0:25:38.87,Default,,0,0,0,,Ірі масштабты гравитациялық жер сілкінісі анықталды!
Dialogue: 0,0:25:39.20,0:25:40.27,Default,,0,0,0,,Бұл қандай дыбыс?
Dialogue: 0,0:25:40.83,0:25:41.87,Default,,0,0,0,,Теңіз
Dialogue: 0,0:25:42.30,0:25:43.17,Default,,0,0,0,,жарықшақ
Dialogue: 0,0:26:17.10,0:26:18.91,Default,,0,0,0,,Сәлем! Бұл не?
Dialogue: 0,0:26:20.57,0:26:23.18,Default,,0,0,0,,бұл... біріктіру!
Dialogue: 0,0:26:32.19,0:26:35.02,Default,,0,0,0,,Енді 401-ден асты!
Dialogue: 0,0:26:40.36,0:26:41.23,Default,,0,0,0,,Ха!
Dialogue: 0,0:26:41.36,0:26:42.23,Default,,0,0,0,,Ах!
Dialogue: 0,0:26:46.00,0:26:48.03,Default,,0,0,0,,Ақымақ! Ол қайдан пайда болды?
Dialogue: 0,0:26:48.17,0:26:49.04,Default,,0,0,0,,Ха!
Dialogue: 0,0:26:50.10,0:26:51.34,Default,,0,0,0,,Микасаның көлеңкесінде
Dialogue: 0,0:26:52.24,0:26:53.21,Default,,0,0,0,,Тағы бір!
Dialogue: 0,0:26:57.14,0:26:58.38,Default,,0,0,0,,401～!
Dialogue: 0,0:26:58.91,0:26:59.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:27:03.25,0:27:05.69,Default,,0,0,0,,Атыс ретін тоқтату
Dialogue: 0,0:27:05.75,0:27:06.79,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:27:07.19,0:27:09.29,Default,,0,0,0,,Ол бұзылады...
Dialogue: 0,0:27:09.69,0:27:10.89,Default,,0,0,0,,Ана жақтағы бала өте шебер екен, бізге үйретсін бе?
Dialogue: 0,0:27:19.83,0:27:21.03,Default,,0,0,0,,Харуна…
Dialogue: 0,0:27:22.14,0:27:23.17,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:27:23.90,0:27:25.17,Default,,0,0,0,,Мен...
Dialogue: 0,0:27:25.77,0:27:27.21,Default,,0,0,0,,Мен әлі де...
Dialogue: 0,0:27:29.94,0:27:31.41,Default,,0,0,0,,Менің өлгім келмейді!
Dialogue: 0,0:27:32.08,0:27:34.41,Default,,0,0,0,,Түсіндім, бұл...
Dialogue: 0,0:27:37.42,0:27:38.85,Default,,0,0,0,,Бл…ээ…!!
Dialogue: 0,0:27:40.25,0:27:42.82,Default,,0,0,0,,Бұл... өкініш
Dialogue: 0,0:27:45.76,0:27:46.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:28:05.38,0:28:06.45,Default,,0,0,0,,Күміс құм?
Dialogue: 0,0:28:06.71,0:28:08.18,Default,,0,0,0,,Наноматериалдар
Dialogue: 0,0:28:08.25,0:28:09.18,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:28:09.42,0:28:10.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:27.37,0:28:28.80,Default,,0,0,0,,Хмм?
Dialogue: 0,0:28:30.14,0:28:31.00,Default,,0,0,0,,Ах!
Dialogue: 0,0:28:46.79,0:28:49.76,Default,,0,0,0,,Харуна мен Киришима бізден жеңілді.
Dialogue: 0,0:28:49.82,0:28:51.22,Default,,0,0,0,,Қыз бала дизайны
Dialogue: 0,0:28:51.79,0:28:53.19,Default,,0,0,0,,Макимен кездесу
Dialogue: 0,0:28:53.73,0:28:54.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:28:54.76,0:28:56.26,Default,,0,0,0,,Шәкең
Dialogue: 0,0:28:59.13,0:29:00.10,Default,,0,0,0,,Хмф!
Dialogue: 0,0:29:00.77,0:29:02.20,Default,,0,0,0,,Иә! Йотаро
Dialogue: 0,0:29:02.84,0:29:03.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:03.80,0:29:04.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:29:06.84,0:29:08.48,Default,,0,0,0,,Егер бұл орын алса, оған көмектесу мүмкін емес!
Dialogue: 0,0:29:08.84,0:29:09.51,Default,,0,0,0,,Кешір мені, Маки!
Dialogue: 0,0:29:09.91,0:29:11.04,Default,,0,0,0,,Керемет!
Dialogue: 0,0:29:12.18,0:29:13.35,Default,,0,0,0,,Адамнан туған
Dialogue: 0,0:29:13.75,0:29:17.85,Default,,0,0,0,,Адам болмай өмір сүруге жазылған қыз.
Dialogue: 0,0:29:18.38,0:29:20.12,Default,,0,0,0,,Адам кейпінде
Dialogue: 0,0:29:20.22,0:29:22.26,Default,,0,0,0,,Адамдық емес психикалық модельдер
Dialogue: 0,0:29:23.26,0:29:24.79,Default,,0,0,0,,Бұл бақыт па?
Dialogue: 0,0:29:24.86,0:29:25.93,Default,,0,0,0,,Әлде…
Dialogue: 0,0:29:26.13,0:29:27.53,Default,,0,0,0,,Бақытсыз ба?
Dialogue: 0,0:30:20.48,0:30:22.85,Default,,0,0,0,,Екеуміз кездесіп, айырылыстық
Dialogue: 0,0:30:25.02,0:30:28.05,Default,,0,0,0,,Біз жеке тұлғамызды оятамыз.
Dialogue: 0,0:30:29.89,0:30:32.96,Default,,0,0,0,,Бұл айғайға ұқсас болды
Dialogue: 0,0:30:33.03,0:30:34.93,Default,,0,0,0,,Сананың туған айқайы
Dialogue: 0,0:30:36.36,0:30:39.53,Default,,0,0,0,,Менің ішімде өсетін болмыс
Dialogue: 0,0:30:40.03,0:30:43.14,Default,,0,0,0,,Бүршік жарған санаға жылы сөйлейді
Dialogue: 0,0:30:43.30,0:30:45.24,Default,,0,0,0,,Сендіретін қатысу
Dialogue: 0,0:30:46.17,0:30:48.41,Default,,0,0,0,,Сіз ешқашан жоғалтқыңыз келмейтін адам
Dialogue: 0,0:30:54.08,0:30:55.28,Default,,0,0,0,,Жарай бер, жарай бер — сен ауаны тұншықтырып жатырсың, шетке жыл.
Dialogue: 0,0:30:55.95,0:30:57.88,Default,,0,0,0,,Бір-біріңді ойла
Dialogue: 0,0:30:58.08,0:31:00.22,Default,,0,0,0,,Бірін-бірі қолдайтын достар
Dialogue: 0,0:31:08.90,0:31:10.03,Default,,0,0,0,,Маки
Dialogue: 0,0:31:10.60,0:31:11.46,Default,,0,0,0,,Менің бір өтінішім бар
Dialogue: 0,0:31:12.63,0:31:15.10,Default,,0,0,0,,Тағы да менімен бірге...
Dialogue: 0,0:31:16.94,0:31:19.97,Default,,0,0,0,,Бізбен дос боласың ба?
Dialogue: 0,0:31:20.04,0:31:21.47,Default,,0,0,0,,Ех! мен де?
Dialogue: 0,0:31:22.01,0:31:23.24,Default,,0,0,0,,Хару Хару…
Dialogue: 0,0:31:26.25,0:31:27.38,Default,,0,0,0,,Иә!
Dialogue: 0,0:31:32.05,0:31:34.25,Default,,0,0,0,,Бар болу – ойлау
Dialogue: 0,0:31:35.29,0:31:39.13,Default,,0,0,0,,Сонда мен бармын
Dialogue: 0,0:31:39.19,0:31:40.06,Default,,0,0,0,,Бірақ
Dialogue: 0,0:31:40.93,0:31:42.40,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:31:43.33,0:31:45.53,Default,,0,0,0,,Сіз ойлайтыныңыздың бәрі сол
Dialogue: 0,0:31:46.23,0:31:48.53,Default,,0,0,0,,Мен жай ғана осылай сезінуге бағдарламаланғанмын ба?
Dialogue: 0,0:31:50.54,0:31:52.01,Default,,0,0,0,,Моги мырзадан Цукидің қозғалысын бақылап отыруды сұраңызшы.
Dialogue: 0,0:31:52.07,0:31:55.21,Default,,0,0,0,,Мен өзім екенімді біле аламын ба?
Dialogue: 0,0:31:56.48,0:31:59.25,Default,,0,0,0,,Менің ойым жалғыз менікі
Dialogue: 0,0:31:59.41,0:32:01.51,Default,,0,0,0,,Оны кім дәлелдей алады?
Dialogue: 0,0:32:02.35,0:32:03.55,Default,,0,0,0,,Түс көріп жатсаңыз
Dialogue: 0,0:32:04.28,0:32:06.22,Default,,0,0,0,,Ұйқы
Dialogue: 0,0:32:06.52,0:32:08.35,Default,,0,0,0,,Егер сіз ұйықтап жатсаңыз
Dialogue: 0,0:32:08.42,0:32:10.96,Default,,0,0,0,,Осы сәттің шындығы – арман
Dialogue: 0,0:32:11.66,0:32:12.63,Default,,0,0,0,,Алдыңғы жағы артта
Dialogue: 0,0:32:13.43,0:32:15.13,Default,,0,0,0,,Артқы жағы – алдыңғы жағы
Dialogue: 0,0:32:15.56,0:32:18.06,Default,,0,0,0,,Санадағы қайталанатын фазалық ауысулар
Dialogue: 0,0:32:19.10,0:32:22.20,Default,,0,0,0,,Біз жүрегімізді тоқимыз
Dialogue: 0,0:32:22.57,0:32:24.54,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:32:25.20,0:32:26.17,Default,,0,0,0,,Ойлау дегеніміз
Dialogue: 0,0:32:27.14,0:32:28.54,Default,,0,0,0,,Бар болу
Dialogue: 0,0:32:28.61,0:32:30.21,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,0:32:32.28,0:32:35.48,Default,,0,0,0,,Сіз Гунзомен не үшін кездестіңіз?
Dialogue: 0,0:32:39.72,0:32:41.39,Default,,0,0,0,,Ха... Харуна
Dialogue: 0,0:32:42.36,0:32:43.66,Default,,0,0,0,,Егер олар тым жылдам қозғалса (оу, вей, оу)
Dialogue: 0,0:32:43.72,0:32:44.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:32:45.16,0:32:46.53,Default,,0,0,0,,Ха! Конго
Dialogue: 0,0:32:47.53,0:32:49.46,Default,,0,0,0,,Харуна Киришима
Dialogue: 0,0:32:49.53,0:32:52.23,Default,,0,0,0,,Флоттан кету дегенді қалай түсінесіңдер?
Dialogue: 0,0:32:54.27,0:32:55.23,Default,,0,0,0,,Конго
Dialogue: 0,0:32:55.30,0:32:58.34,Default,,0,0,0,,Мен біраз уақыт Макимен бірге боламын.
Dialogue: 0,0:33:00.97,0:33:03.11,Default,,0,0,0,,Сіз сілтемені бұздыңыз ба?
Dialogue: 0,0:33:03.34,0:33:05.38,Default,,0,0,0,,Киришима, сен не істейсің?
Dialogue: 0,0:33:05.45,0:33:07.38,Default,,0,0,0,,Ха! Мен... мен
Dialogue: 0,0:33:07.45,0:33:09.08,Default,,0,0,0,,Мен Харунаны қадағалаймын!
Dialogue: 0,0:33:14.02,0:33:14.69,Default,,0,0,0,,Майя
Dialogue: 0,0:33:15.09,0:33:16.52,Default,,0,0,0,,Не? Конго
Dialogue: 0,0:33:16.59,0:33:18.59,Default,,0,0,0,,Әңгіме синхрондалады.
Dialogue: 0,0:33:19.13,0:33:20.19,Default,,0,0,0,,Хмм.
Dialogue: 0,0:33:20.49,0:33:22.50,Default,,0,0,0,,Сіз маған қосылуыңыз керек.
Dialogue: 0,0:33:22.70,0:33:25.30,Default,,0,0,0,,Иә! Ақыры менің кезегім!
Dialogue: 0,0:33:25.77,0:33:27.40,Default,,0,0,0,,Біз қарумыз
Dialogue: 0,0:33:27.47,0:33:31.20,Default,,0,0,0,,Сіздің міндетіңіз – миссияны қабылдау және оны орындау!
Dialogue: 0,0:33:31.40,0:33:32.27,Default,,0,0,0,,Эхехе!
Dialogue: 0,0:33:32.67,0:33:34.64,Default,,0,0,0,,Бұл карнавал!
Dialogue: 0,0:33:36.64,0:33:38.11,Default,,0,0,0,,Хмм.
Dialogue: 0,0:33:38.18,0:33:41.68,Default,,0,0,0,,Мама! Олар Харуна мен басқалары келгенде біледі.
Dialogue: 0,0:33:41.75,0:33:44.65,Default,,0,0,0,,Жалқаулықты ұнатпайтын сияқтысың.
Dialogue: 0,0:33:51.16,0:33:53.26,Default,,0,0,0,,Хюуганың реакциясы жойылған жоқ
Dialogue: 0,0:33:53.33,0:33:54.19,Default,,0,0,0,,Майя!
Dialogue: 0,0:33:54.63,0:33:55.63,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:33:56.06,0:33:57.36,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:33:57.43,0:33:59.63,Default,,0,0,0,,Масштабтау!
Dialogue: 0,0:34:02.34,0:34:03.67,Default,,0,0,0,,Өте ауырлық зеңбірегі
Dialogue: 0,0:34:04.17,0:34:05.74,Default,,0,0,0,,Іске қосу~!
Dialogue: 0,0:34:09.51,0:34:10.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:33.27,0:34:35.80,Default,,0,0,0,,Енді мен ол кісінің кемесімін!
Dialogue: 0,0:34:37.44,0:34:38.67,Default,,0,0,0,,Көк болат!
Dialogue: 0,0:34:39.24,0:34:41.57,Default,,0,0,0,,Біз бір типтегі кемелерден ұтыла алмаймыз!
Dialogue: 0,0:34:42.18,0:34:45.45,Default,,0,0,0,,Такаоның ақымақ! Батып кетпеңіз!
Dialogue: 0,0:34:45.81,0:34:47.65,Default,,0,0,0,,Махаббат ешқашан батпайды!
Dialogue: 0,0:34:54.65,0:34:57.56,Default,,0,0,0,,Барлығы бұзылып жатыр.
Dialogue: 0,0:34:57.62,0:34:58.49,Default,,0,0,0,,Майя
Dialogue: 0,0:34:58.83,0:35:00.69,Default,,0,0,0,,Иә, иә, сіз қоңырау шалдыңыз ба?
Dialogue: 0,0:35:01.36,0:35:04.56,Default,,0,0,0,,Такао да, Хюуга да - бұл анық ауытқулар.
Dialogue: 0,0:35:04.63,0:35:06.43,Default,,0,0,0,,Оны жай қалдырыңыз.
Dialogue: 0,0:35:06.70,0:35:11.47,Default,,0,0,0,,Мұның орнына барлығына кінәлі 401 және Чихая Гунзо.
Dialogue: 0,0:35:11.54,0:35:13.61,Default,,0,0,0,,Конгоу Сіз шаршаған сияқтысыз.
Dialogue: 0,0:35:13.67,0:35:16.24,Default,,0,0,0,,Бәрінің айтқанын тыңдамау қиын.
Dialogue: 0,0:35:16.31,0:35:18.61,Default,,0,0,0,,Сіз ше? мая
Dialogue: 0,0:35:18.81,0:35:19.78,Default,,0,0,0,,Мен?
Dialogue: 0,0:35:19.85,0:35:24.22,Default,,0,0,0,,Мен жай ғана Адмиралти кодексін және Конгоуды ұстанамын!
Dialogue: 0,0:35:25.49,0:35:28.35,Default,,0,0,0,,Иә, солай
Dialogue: 0,0:35:28.75,0:35:30.86,Default,,0,0,0,,Бұл тұманның дұрыс түрі.
Dialogue: 0,0:35:31.56,0:35:34.49,Default,,0,0,0,,Хюуга көрсеткен маршрут пен координаттар
Dialogue: 0,0:35:34.56,0:35:36.83,Default,,0,0,0,,Толқынға мініп, қауіпті аймақтан шығу
Dialogue: 0,0:35:36.90,0:35:39.43,Default,,0,0,0,,Такао және оның достарымен кездесу нүктесін мақсат етіңіз
Dialogue: 0,0:35:40.57,0:35:43.64,Default,,0,0,0,,Такао бізге қашу үшін уақыт сатып алды.
Dialogue: 0,0:35:44.14,0:35:45.74,Default,,0,0,0,,Қалғандары Конгоу және басқалар.
Dialogue: 0,0:35:45.81,0:35:48.17,Default,,0,0,0,,Сіз оны елемейсіз деп үміттенемін.
Dialogue: 0,0:35:48.24,0:35:49.88,Default,,0,0,0,,Бұл мүмкін емес сұрақ.
Dialogue: 0,0:35:51.18,0:35:52.61,Default,,0,0,0,,Түсірілді
Dialogue: 0,0:36:11.63,0:36:13.93,Default,,0,0,0,,«Сарбаздар құдайдың жылдамдығын құрметтейді»
Dialogue: 0,0:36:14.20,0:36:16.54,Default,,0,0,0,,Адамзат кітабынан алынған сөз болды ма?
Dialogue: 0,0:36:16.84,0:36:19.77,Default,,0,0,0,,Иә, біз қарумыз.
Dialogue: 0,0:36:19.84,0:36:22.54,Default,,0,0,0,,Ештеңе артық, кем емес.
Dialogue: 0,0:36:23.68,0:36:25.95,Default,,0,0,0,,Шахталар мені ұстап тұрған жоқ!
Dialogue: 0,0:36:30.35,0:36:31.52,Default,,0,0,0,,Конго
Dialogue: 0,0:36:31.78,0:36:34.32,Default,,0,0,0,,Соншалықты бейқамдық ауыртпай ма?
Dialogue: 0,0:36:34.49,0:36:37.59,Default,,0,0,0,,Ауырсыну бізге қажет емес ұғым.
Dialogue: 0,0:36:40.29,0:36:41.93,Default,,0,0,0,,Танатоний реакциясы 12
Dialogue: 0,0:36:42.20,0:36:43.30,Default,,0,0,0,,Пассивті азғын ату!
Dialogue: 0,0:36:53.74,0:36:55.41,Default,,0,0,0,,Тек осы бір нәрсені есте сақта
Dialogue: 0,0:36:56.68,0:36:59.21,Default,,0,0,0,,Мен сені жек көремін
Dialogue: 0,0:37:15.70,0:37:17.50,Default,,0,0,0,,Сіз де сүңгіп көрдіңіз бе?
Dialogue: 0,0:37:17.80,0:37:19.50,Default,,0,0,0,,Сіз суға түсіп, мені қуып барасыз ба?
Dialogue: 0,0:37:20.30,0:37:22.77,Default,,0,0,0,,Толық жарылысқа дейін 52 секунд қалды
Dialogue: 0,0:37:25.67,0:37:28.37,Default,,0,0,0,,Конгоу кемесінде гравитон реакциясы расталды
Dialogue: 0,0:37:28.84,0:37:31.51,Default,,0,0,0,,Сіз нөлдік қашықтықтан супер гравитациялық зеңбірек атқыңыз келе ме?
Dialogue: 0,0:37:31.78,0:37:32.65,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:37:32.71,0:37:35.38,Default,,0,0,0,,Сіз ішке кіресіз бе?
Dialogue: 0,0:37:35.51,0:37:38.02,Default,,0,0,0,,Klein өрісінің есептеулерін де толық жарылысқа айналдырыңыз.
Dialogue: 0,0:37:38.55,0:37:39.45,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:37:39.52,0:37:42.89,Default,,0,0,0,,Тартудан басқа барлық есептеулер толық жарылыс болып табылады
Dialogue: 0,0:37:45.32,0:37:47.43,Default,,0,0,0,,жетуге 30 секунд қалды
Dialogue: 0,0:37:47.69,0:37:48.56,Default,,0,0,0,,29…
Dialogue: 0,0:37:54.50,0:37:55.94,Default,,0,0,0,,Ату... Ах!
Dialogue: 0,0:37:58.54,0:37:59.94,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:38:04.91,0:38:08.75,Default,,0,0,0,,5… 4… 3…
Dialogue: 0,0:38:08.95,0:38:11.42,Default,,0,0,0,,2… 1…
Dialogue: 0,0:38:11.68,0:38:13.75,Default,,0,0,0,,Толық жарылыс сыни дәрежесіне жетті
Dialogue: 0,0:38:13.82,0:38:16.39,Default,,0,0,0,,Бұл аймақтан толық жылдамдықпен кетіңіз!
Dialogue: 0,0:38:23.96,0:38:25.56,Default,,0,0,0,,Ах... ха!
Dialogue: 0,0:38:26.53,0:38:27.57,Default,,0,0,0,,Хюуга
Dialogue: 0,0:38:28.37,0:38:31.74,Default,,0,0,0,,Сіз менің назарымды ұрлап, оны бұздыңыз ба?
Dialogue: 0,0:38:31.80,0:38:32.67,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:38:33.31,0:38:34.87,Default,,0,0,0,,Егер бұл кәдімгі Конго болса
Dialogue: 0,0:38:34.94,0:38:38.34,Default,,0,0,0,,Мен мұндай қарапайым қимылға түспес едім.
Dialogue: 0,0:38:38.81,0:38:42.85,Default,,0,0,0,,Адамгершілігі мол үлкен соғыс кемесі сияқты сезіне ме?
Dialogue: 0,0:38:43.78,0:38:46.09,Default,,0,0,0,,Ол маған соңғы соққыны да бермеді.
Dialogue: 0,0:38:46.59,0:38:48.99,Default,,0,0,0,,Бұл сіз айтып отырған ауытқушылық емес пе?
Dialogue: 0,0:38:49.49,0:38:51.99,Default,,0,0,0,,Бұл шешімдегі қателік болды, солай ма?
Dialogue: 0,0:38:52.09,0:38:54.39,Default,,0,0,0,,Мен саған тағы бір нәрсе айтайын.
Dialogue: 0,0:38:54.46,0:38:57.33,Default,,0,0,0,,Сендер қуып келе жатқан адамзаттың козыры
Dialogue: 0,0:38:57.60,0:39:00.40,Default,,0,0,0,,Бұл менің орнымда.
Dialogue: 0,0:39:12.65,0:39:15.75,Default,,0,0,0,,Балалар сендер қателесесіңдер
Dialogue: 0,0:39:16.78,0:39:18.72,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:39:21.05,0:39:23.92,Default,,0,0,0,,Хаа... Хаа... (Гунзо) Иона! Сенімен бәрі жақсы ма?
Dialogue: 0,0:39:24.39,0:39:25.52,Default,,0,0,0,,Мен жақсымын
Dialogue: 0,0:39:25.59,0:39:28.49,Default,,0,0,0,,Жүк сәл ауыр болды, мен жай ғана шаршадым.
Dialogue: 0,0:39:28.56,0:39:29.50,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:39:30.70,0:39:33.70,Default,,0,0,0,,Өйткені мен Гунцоның кемесімін
Dialogue: 0,0:39:33.77,0:39:34.70,Default,,0,0,0,,Ехе
Dialogue: 0,0:39:36.87,0:39:37.84,Default,,0,0,0,,Иә
Dialogue: 0,0:39:39.51,0:39:40.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:45.81,0:39:46.68,Default,,0,0,0,,Уф...
Dialogue: 0,0:39:46.75,0:39:47.61,Default,,0,0,0,,Не?
Dialogue: 0,0:39:51.95,0:39:53.65,Default,,0,0,0,,Қарғыс атсын! Уф...
Dialogue: 0,0:39:54.69,0:39:56.46,Default,,0,0,0,,Тұтқынға түсті ме?
Dialogue: 0,0:40:02.96,0:40:05.16,Default,,0,0,0,,401-нің батуы расталды
Dialogue: 0,0:40:06.53,0:40:08.10,Default,,0,0,0,,Тапсырма орындалды
Dialogue: 0,0:40:11.90,0:40:14.01,Default,,0,0,0,,Адмиралтейлік кодекске сәйкес
Dialogue: 0,0:40:15.04,0:40:18.14,Default,,0,0,0,,Біздің тұманға қарсы флот
Dialogue: 0,0:40:26.99,0:40:31.76,Default,,0,0,0,,Тиісті теңіз аймағында 1000 метр тереңдікте іздеу аяқталды
Dialogue: 0,0:40:32.66,0:40:35.96,Default,,0,0,0,,401 реакциясы... жоқ
Dialogue: 0,0:40:36.70,0:40:38.73,Default,,0,0,0,,Тағы да Конго мен Майядан басқа
Dialogue: 0,0:40:38.80,0:40:42.47,Default,,0,0,0,,Сізге біреу шабуыл жасады деп ойлау табиғи ма?
Dialogue: 0,0:40:42.54,0:40:43.64,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:40:44.54,0:40:47.81,Default,,0,0,0,,Бұл жердегі мұхит траншеясының тереңдігі 9000 метр.
Dialogue: 0,0:40:48.14,0:40:51.04,Default,,0,0,0,,Егер ол сонда батып кетсе, оны табудың жолы жоқ.
Dialogue: 0,0:40:51.44,0:40:53.95,Default,,0,0,0,,Әлі де! Менің оны іздеуден басқа амалым жоқ!
Dialogue: 0,0:40:56.68,0:40:57.88,Default,,0,0,0,,Уау!
Dialogue: 0,0:40:58.55,0:41:00.89,Default,,0,0,0,,Сәлем! Сіз не істемексіз?
Dialogue: 0,0:41:01.09,0:41:02.52,Default,,0,0,0,,Бұл шешілді, солай ма?
Dialogue: 0,0:41:02.59,0:41:04.09,Default,,0,0,0,,Сүңгіп, оны тікелей іздеңіз!
Dialogue: 0,0:41:04.69,0:41:06.89,Default,,0,0,0,,Мен ештеңе айтқан жоқпын!
Dialogue: 0,0:41:07.16,0:41:09.09,Default,,0,0,0,,Иона апаға шабуыл жасаған жау
Dialogue: 0,0:41:09.16,0:41:11.76,Default,,0,0,0,,Ол бір жерде жасырынып жүрген болуы мүмкін!
Dialogue: 0,0:41:12.67,0:41:13.77,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:41:23.24,0:41:25.24,Default,,0,0,0,,Теңізде кеменің белгісі болмағандықтан
Dialogue: 0,0:41:25.51,0:41:27.25,Default,,0,0,0,,Жау сүңгуір қайық шығар.
Dialogue: 0,0:41:27.78,0:41:31.15,Default,,0,0,0,,Ауыр крейсер ретінде сіз су астындағы шайқастарда қолайсыз жағдайдасыз.
Dialogue: 0,0:41:31.95,0:41:33.49,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:41:33.85,0:41:36.89,Default,,0,0,0,,Неге сонша сабырлы көрінесің!
Dialogue: 0,0:41:36.96,0:41:40.49,Default,,0,0,0,,Кәдімгі «Иона-ни-сама~» не болды?
Dialogue: 0,0:41:41.53,0:41:42.93,Default,,0,0,0,,Сізде жақсы болуы мүмкін емес.
Dialogue: 0,0:41:43.06,0:41:43.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:44.00,0:41:47.53,Default,,0,0,0,,Бірақ мен Иона апаға жауапты болдым.
Dialogue: 0,0:41:47.83,0:41:49.07,Default,,0,0,0,,Төтенше жағдайда
Dialogue: 0,0:41:49.13,0:41:52.17,Default,,0,0,0,,Мен Иона апаның өсиетін орындауым керек.
Dialogue: 0,0:41:54.71,0:41:55.84,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:41:55.91,0:41:58.71,Default,,0,0,0,,Хюуга, оны маған қарызға берші.
Dialogue: 0,0:42:00.51,0:42:02.21,Default,,0,0,0,,Такао... сен
Dialogue: 0,0:42:02.55,0:42:03.88,Default,,0,0,0,,Оның сізді тоқтатуына жол бермеңіз
Dialogue: 0,0:42:03.95,0:42:05.65,Default,,0,0,0,,Жалғыз болсам да барамын.
Dialogue: 0,0:42:06.25,0:42:07.79,Default,,0,0,0,,Капитан
Dialogue: 0,0:42:07.85,0:42:09.89,Default,,0,0,0,,Өйткені Гунзо күтіп тұр.
Dialogue: 0,0:42:17.93,0:42:20.83,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:42:31.21,0:42:32.85,Default,,0,0,0,,Иона... Ах!
Dialogue: 0,0:42:34.81,0:42:35.98,Default,,0,0,0,,Топтық сурет?
Dialogue: 0,0:42:39.02,0:42:40.95,Default,,0,0,0,,Өмірді қолдау үшін…
Dialogue: 0,0:42:41.02,0:42:43.59,Default,,0,0,0,,Қажетті функциялар...
Dialogue: 0,0:42:43.66,0:42:45.26,Default,,0,0,0,,Барлығын кесіңіз
Dialogue: 0,0:42:45.82,0:42:49.66,Default,,0,0,0,,Кеменің негізгі функцияларын қорғауға назар аударыңыз.
Dialogue: 0,0:42:52.97,0:42:55.70,Default,,0,0,0,,Бұл... Капитанның бұйрығы ма?
Dialogue: 0,0:42:56.64,0:42:57.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:42:59.14,0:43:00.74,Default,,0,0,0,,Мен...
Dialogue: 0,0:43:00.81,0:43:01.87,Default,,0,0,0,,Тікелей... Ах!
Dialogue: 0,0:43:02.07,0:43:04.84,Default,,0,0,0,,Io… na…
Dialogue: 0,0:43:05.11,0:43:08.01,Default,,0,0,0,,Хаа…
Dialogue: 0,0:43:13.99,0:43:15.19,Default,,0,0,0,,Топтық сурет?
Dialogue: 0,0:43:17.26,0:43:19.36,Default,,0,0,0,,Гунзо! Топтық суреттер!
Dialogue: 0,0:43:19.69,0:43:20.96,Default,,0,0,0,,Оян
Dialogue: 0,0:43:23.90,0:43:25.16,Default,,0,0,0,,Суреттер тобы
Dialogue: 0,0:43:27.27,0:43:28.33,Default,,0,0,0,,Ха...
Dialogue: 0,0:43:28.60,0:43:30.37,Default,,0,0,0,,Топ… Сурет…
Dialogue: 0,0:43:48.29,0:43:49.79,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:43:50.19,0:43:51.36,Default,,0,0,0,,Мен...
Dialogue: 0,0:43:51.99,0:43:53.23,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:43:53.29,0:43:56.36,Default,,0,0,0,,Жалғыз қалғым келмейді...
Dialogue: 0,0:43:57.00,0:43:58.20,Default,,0,0,0,,Гунзо!
Dialogue: 0,0:44:05.30,0:44:08.01,Default,,0,0,0,,Қайда? Қайда?
Dialogue: 0,0:44:08.31,0:44:10.71,Default,,0,0,0,,Жауап 401!
Dialogue: 0,0:44:13.15,0:44:14.01,Default,,0,0,0,,Ах!
Dialogue: 0,0:44:22.42,0:44:23.29,Default,,0,0,0,,Таптым!
Dialogue: 0,0:44:23.36,0:44:24.22,Default,,0,0,0,,Ха!
Dialogue: 0,0:44:32.40,0:44:33.37,Default,,0,0,0,,Ха!
Dialogue: 0,0:44:43.44,0:44:46.31,Default,,0,0,0,,Чихая... Гунзо
Dialogue: 0,0:44:46.38,0:44:47.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:44:53.92,0:44:55.72,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:44:55.92,0:44:58.92,Default,,0,0,0,,Бұл шынымен сенсің.
Dialogue: 0,0:45:00.73,0:45:04.83,Default,,0,0,0,,Мен үшін бұл бос орын емес.
Dialogue: 0,0:45:05.43,0:45:07.70,Default,,0,0,0,,Бұл еш жерде емес.
Dialogue: 0,0:45:44.84,0:45:45.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:45:45.94,0:45:47.47,Default,,0,0,0,,What... what?
Dialogue: 0,0:46:40.03,0:46:41.26,Default,,0,0,0,,Мен...
Dialogue: 0,0:46:41.93,0:46:42.79,Default,,0,0,0,,Ах!
Dialogue: 0,0:47:02.48,0:47:04.95,Default,,0,0,0,,Тікелей...
Dialogue: 0,0:47:15.16,0:47:19.20,Default,,0,0,0,,Ватару!
Dialogue: 0,0:47:19.26,0:47:20.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:21.50,0:47:23.07,Default,,0,0,0,,Конго?
Dialogue: 0,0:47:30.01,0:47:33.58,Default,,0,0,0,,401 Такаомен қосылып, функционалдылықты қалпына келтіреді
Dialogue: 0,0:47:33.85,0:47:35.31,Default,,0,0,0,,шықты
Dialogue: 0,0:47:35.38,0:47:36.25,Default,,0,0,0,,Не?
Dialogue: 0,0:47:36.98,0:47:38.42,Default,,0,0,0,,Логикадан тыс жағдай
Dialogue: 0,0:47:38.48,0:47:40.42,Default,,0,0,0,,Тез арада түзетілуі керек
Dialogue: 0,0:47:40.95,0:47:41.92,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:47:41.99,0:47:43.62,Default,,0,0,0,,Солай болуы керек.
Dialogue: 0,0:47:44.89,0:47:46.02,Default,,0,0,0,,Кеттік, Майя.
Dialogue: 0,0:47:46.53,0:47:50.63,Default,,0,0,0,,Бұл жолы мен 401-ді өз қолыммен жеңемін.
Dialogue: 0,0:47:50.90,0:47:52.26,Default,,0,0,0,,Жылдам, бізді Диоға апар.
Dialogue: 0,0:47:53.03,0:47:55.17,Default,,0,0,0,,Адмиралтейт кодексіне негізделген
Dialogue: 0,0:47:55.23,0:47:56.17,Default,,0,0,0,,Конго
Dialogue: 0,0:47:56.24,0:48:00.64,Default,,0,0,0,,Сіз Шығыс бірінші крейсер флотының флагманы лауазымыңыздан босатылдыңыз.
Dialogue: 0,0:48:01.07,0:48:03.11,Default,,0,0,0,,401-ге қалай жауап беру керек
Dialogue: 0,0:48:03.21,0:48:06.04,Default,,0,0,0,,Біз әлі де жауаптымыз
Dialogue: 0,0:48:06.11,0:48:08.95,Default,,0,0,0,,Басқа өмір болғанша күте тұрыңыз.
Dialogue: 0,0:48:10.92,0:48:11.88,Default,,0,0,0,,Рұқсат етілмейді...
Dialogue: 0,0:48:11.95,0:48:12.65,Default,,0,0,0,,Не?
Dialogue: 0,0:48:13.32,0:48:14.45,Default,,0,0,0,,Рұқсат етілмейді
Dialogue: 0,0:48:14.52,0:48:15.89,Default,,0,0,0,,Әлгі жігіт...
Dialogue: 0,0:48:15.95,0:48:19.32,Default,,0,0,0,,401-ді суға батыратын менмін!
Dialogue: 0,0:48:20.03,0:48:21.46,Default,,0,0,0,,Балалар сендер емес!
Dialogue: 0,0:48:21.53,0:48:23.93,Default,,0,0,0,,Сізде де солай болды ма?
Dialogue: 0,0:48:24.00,0:48:24.66,Default,,0,0,0,,Ха...
Dialogue: 0,0:48:25.23,0:48:26.67,Default,,0,0,0,,Жаңа айтқаным
Dialogue: 0,0:48:26.93,0:48:30.47,Default,,0,0,0,,Адмиралтейлік кодекстен айқын ауытқу болып табылады
Dialogue: 0,0:48:30.54,0:48:32.34,Default,,0,0,0,,Жоқ... жоқ! мен...
Dialogue: 0,0:48:32.40,0:48:34.24,Default,,0,0,0,,сізді байланыстырады
Dialogue: 0,0:48:34.31,0:48:35.94,Default,,0,0,0,,Қарсылық мағынасыз
Dialogue: 0,0:48:38.91,0:48:40.65,Default,,0,0,0,,《Дұрыс… Мен Хинацукиді құтқардым.》
Dialogue: 0,0:48:40.91,0:48:42.58,Default,,0,0,0,,Иә, Майя!
Dialogue: 0,0:48:43.22,0:48:45.22,Default,,0,0,0,,Сіз түсінесіз, солай ма?
Dialogue: 0,0:48:45.28,0:48:46.69,Default,,0,0,0,,Мен ауытқумын және т.б.
Dialogue: 0,0:48:46.95,0:48:49.29,Default,,0,0,0,,Иә! Жарайды, Конгоу.
Dialogue: 0,0:48:49.99,0:48:50.66,Default,,0,0,0,,Майя…
Dialogue: 0,0:48:50.92,0:48:52.66,Default,,0,0,0,,Конгоу ештеңеге алаңдамауы керек.
Dialogue: 0,0:48:52.92,0:48:56.19,Default,,0,0,0,,Тек Адмиралти кодексін орындаңыз.
Dialogue: 0,0:48:56.26,0:48:59.06,Default,,0,0,0,,Иә, мен... Иә!
Dialogue: 0,0:48:59.20,0:49:01.17,Default,,0,0,0,,Конгоу ештеңеге алаңдамауы керек.
Dialogue: 0,0:49:01.23,0:49:02.30,Default,,0,0,0,,Адмиралтия кодексі
Dialogue: 0,0:49:02.37,0:49:03.97,Default,,0,0,0,,Тек оны орындаңыз.
Dialogue: 0,0:49:04.17,0:49:05.20,Default,,0,0,0,,Майя…
Dialogue: 0,0:49:05.27,0:49:06.67,Default,,0,0,0,,Иә! Жарайды...
Dialogue: 0,0:49:06.94,0:49:08.64,Default,,0,0,0,,Не айтып тұрсың, Майя?
Dialogue: 0,0:49:09.01,0:49:10.71,Default,,0,0,0,,Конгоу ештеңеге алаңдамауы керек.
Dialogue: 0,0:49:10.98,0:49:12.51,Default,,0,0,0,,Адмиралтияның коды... Майя!
Dialogue: 0,0:49:12.58,0:49:13.51,Default,,0,0,0,,Бұл ысырап
Dialogue: 0,0:49:13.58,0:49:14.61,Default,,0,0,0,,Не?
Dialogue: 0,0:49:14.68,0:49:17.28,Default,,0,0,0,,Майя ауыр крейсерінің психикалық моделі
Dialogue: 0,0:49:17.35,0:49:19.52,Default,,0,0,0,,Эмоциялық бағдарлама орындалмады
Dialogue: 0,0:49:19.62,0:49:20.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:20.55,0:49:23.72,Default,,0,0,0,,Ол біз жасаған бақылау бөлімі.
Dialogue: 0,0:49:24.19,0:49:27.49,Default,,0,0,0,,Өте қарапайым тәртіп бойынша жауап беру
Dialogue: 0,0:49:27.56,0:49:29.33,Default,,0,0,0,,Жай қуыршақ
Dialogue: 0,0:49:29.39,0:49:32.50,Default,,0,0,0,,Мен оны жабуға мәжбүр еттім.
Dialogue: 0,0:49:32.56,0:49:35.43,Default,,0,0,0,,Маған енді сені бақылап отырудың қажеті жоқ.
Dialogue: 0,0:49:35.63,0:49:38.30,Default,,0,0,0,,Бұл... ақымақ...
Dialogue: 0,0:49:38.70,0:49:41.14,Default,,0,0,0,,Бұл өтірік... Майя
Dialogue: 0,0:49:41.37,0:49:43.14,Default,,0,0,0,,Сен менікісің...
Dialogue: 0,0:49:44.41,0:49:45.71,Default,,0,0,0,,Менің...
Dialogue: 0,0:49:47.18,0:49:49.31,Default,,0,0,0,,Бұл карнавал!
Dialogue: 0,0:49:49.75,0:49:51.55,Default,,0,0,0,,Бұл карнавал!
Dialogue: 0,0:49:52.22,0:49:53.22,Default,,0,0,0,,Бұл карнавал!
Dialogue: 0,0:49:54.29,0:49:56.12,Default,,0,0,0,,Бұл карнавал!
Dialogue: 0,0:49:56.32,0:49:58.12,Default,,0,0,0,,Бұл карнавал!
Dialogue: 0,0:49:58.49,0:50:00.36,Default,,0,0,0,,Бұл карнавал!
Dialogue: 0,0:50:11.27,0:50:14.07,Default,,0,0,0,,Капитан Стилл кеменің артқы жағынан
Dialogue: 0,0:50:14.31,0:50:17.51,Default,,0,0,0,,I400 402 артымнан келе жатыр
Dialogue: 0,0:50:18.31,0:50:20.25,Default,,0,0,0,,401 сүңгу
Dialogue: 0,0:50:20.31,0:50:22.31,Default,,0,0,0,,Гравитацияның күшеюі сейсмикалық реакция
Dialogue: 0,0:50:22.38,0:50:24.78,Default,,0,0,0,,Ол шайқасқа дайын сияқты
Dialogue: 0,0:50:25.12,0:50:28.72,Default,,0,0,0,,401 бізді тартуға ниетті.
Dialogue: 0,0:50:28.79,0:50:31.36,Default,,0,0,0,,Бұл сіздің жеңетініңізге сенімді екеніңізді білдіре ме?
Dialogue: 0,0:50:32.26,0:50:34.63,Default,,0,0,0,,401 нөміріне хабарласайық
Dialogue: 0,0:50:34.79,0:50:39.03,Default,,0,0,0,,Дегенмен, Такао Конго және басқалары үшін әдеттен тыс болып кету прецеденті бар.
Dialogue: 0,0:50:39.10,0:50:41.33,Default,,0,0,0,,401-пен байланысу қауіпті
Dialogue: 0,0:50:41.40,0:50:43.47,Default,,0,0,0,,Біздің өзара бақылауымыздың қарқындылығы
Dialogue: 0,0:50:43.54,0:50:46.34,Default,,0,0,0,,Оны максималды деңгейге қойсам ше?
Dialogue: 0,0:50:47.17,0:50:48.47,Default,,0,0,0,,Сенің балаң атақты Эден мектебіне қабылданғанын ойласаңшы!
Dialogue: 0,0:50:51.81,0:50:54.08,Default,,0,0,0,,400 402
Dialogue: 0,0:50:54.65,0:50:57.05,Default,,0,0,0,,Сен менің әпкелерімсің
Dialogue: 0,0:50:57.22,0:50:59.28,Default,,0,0,0,,Мүмкін болса ұрысқым келмейді
Dialogue: 0,0:50:59.58,0:51:02.09,Default,,0,0,0,,Ұсыныс қабылданбайды
Dialogue: 0,0:51:02.49,0:51:04.29,Default,,0,0,0,,Батып кететін сенсің.
Dialogue: 0,0:51:04.66,0:51:06.09,Default,,0,0,0,,401
Dialogue: 0,0:51:16.54,0:51:18.27,Default,,0,0,0,,Торпедо ату дыбысы 2
Dialogue: 0,0:51:18.34,0:51:19.20,Default,,0,0,0,,Кесу
Dialogue: 0,0:51:26.28,0:51:28.61,Default,,0,0,0,,Акустикалық торпедо 50 қашықтықта жарылады
Dialogue: 0,0:51:29.15,0:51:30.55,Default,,0,0,0,,Сонар сезімталдығын азайту
Dialogue: 0,0:51:30.62,0:51:32.45,Default,,0,0,0,,Жоғалған мақсат
Dialogue: 0,0:51:32.75,0:51:34.32,Default,,0,0,0,,Киришима қазір!
Dialogue: 0,0:51:34.39,0:51:35.25,Default,,0,0,0,,Торпедо эрозиясы
Dialogue: 0,0:51:35.39,0:51:36.86,Default,,0,0,0,,Өрт! а!
Dialogue: 0,0:51:39.16,0:51:42.26,Default,,0,0,0,,Торпедо сезімі 1 танатоний реакциясы
Dialogue: 0,0:51:42.56,0:51:43.80,Default,,0,0,0,,Эрозиялық торпедо
Dialogue: 0,0:51:43.86,0:51:48.17,Default,,0,0,0,,Кляйн өрісінің кеңеюі 0,03 секунд уақытында емес
Dialogue: 0,0:51:48.60,0:51:50.24,Default,,0,0,0,,Мен қабылдаймын
Dialogue: 0,0:51:51.44,0:51:52.30,Default,,0,0,0,,402!
Dialogue: 0,0:51:55.27,0:51:56.58,Default,,0,0,0,,Жүйе қатесі
Dialogue: 0,0:51:56.84,0:51:58.34,Default,,0,0,0,,Уф...
Dialogue: 0,0:52:03.42,0:52:05.65,Default,,0,0,0,,Қайта конфигурация жалғастыра алмайды
Dialogue: 0,0:52:06.52,0:52:08.89,Default,,0,0,0,,402 Неліктен мұндай еліктеу керек?
Dialogue: 0,0:52:09.82,0:52:13.29,Default,,0,0,0,,Мен сені ренжіткім келмеді
Dialogue: 0,0:52:13.69,0:52:15.19,Default,,0,0,0,,Мен?
Dialogue: 0,0:52:15.83,0:52:19.46,Default,,0,0,0,,Бұл 401-мен бірдей
Dialogue: 0,0:52:36.25,0:52:37.52,Default,,0,0,0,,Сым ұстағыш?
Dialogue: 0,0:52:37.82,0:52:40.49,Default,,0,0,0,,№ 9 № 10! Эрозия торпедасын атып тастаңыз!
Dialogue: 0,0:52:40.82,0:52:41.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:47.53,0:52:48.46,Default,,0,0,0,,400
Dialogue: 0,0:52:49.16,0:52:50.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:53.83,0:52:56.57,Default,,0,0,0,,Кешіріңіз... 400
Dialogue: 0,0:52:57.44,0:52:58.67,Default,,0,0,0,,Бұл сенсің ғой, иә?
Dialogue: 0,0:52:58.74,0:53:00.34,Default,,0,0,0,,Сіз кешірім сұрайсыз ба?
Dialogue: 0,0:53:01.51,0:53:03.34,Default,,0,0,0,,А... хмм...
Dialogue: 0,0:53:16.62,0:53:18.36,Default,,0,0,0,,Уф...
Dialogue: 0,0:53:18.96,0:53:20.86,Default,,0,0,0,,Не болды 401
Dialogue: 0,0:53:20.93,0:53:22.29,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:53:22.66,0:53:24.23,Default,,0,0,0,,Сіз...
Dialogue: 0,0:53:24.86,0:53:27.40,Default,,0,0,0,,Бауырлас кемелер жоғалып кетті
Dialogue: 0,0:53:27.83,0:53:31.30,Default,,0,0,0,,Жаумен шайқасып, суға батырдың.
Dialogue: 0,0:53:31.74,0:53:32.60,Default,,0,0,0,,Осымен
Dialogue: 0,0:53:33.67,0:53:34.81,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:53:35.61,0:53:36.98,Default,,0,0,0,,Осымен
Dialogue: 0,0:54:00.27,0:54:01.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:03.74,0:54:04.84,Default,,0,0,0,,Майя
Dialogue: 0,0:54:06.91,0:54:08.01,Default,,0,0,0,,Бл…ээ…!!
Dialogue: 0,0:54:08.91,0:54:10.31,Default,,0,0,0,,Біздің
Dialogue: 0,0:54:11.88,0:54:13.45,Default,,0,0,0,,Бұл карнавал!
Dialogue: 0,0:54:30.66,0:54:31.56,Default,,0,0,0,,Кеме суреті түсірілді!
Dialogue: 0,0:54:32.30,0:54:32.96,Default,,0,0,0,,Кеменің көлеңкесі?
Dialogue: 0,0:54:33.33,0:54:34.60,Default,,0,0,0,,1 кеме артыңызда!
Dialogue: 0,0:54:34.67,0:54:35.53,Default,,0,0,0,,Артқа қарай?
Dialogue: 0,0:54:35.70,0:54:37.60,Default,,0,0,0,,Ол жоғары жылдамдықпен жақындап келеді!
Dialogue: 0,0:54:58.89,0:55:01.39,Default,,0,0,0,,Не? Бұл...
Dialogue: 0,0:55:01.59,0:55:03.86,Default,,0,0,0,,Сәйкестендіру сигналын тексеру
Dialogue: 0,0:55:04.43,0:55:05.30,Default,,0,0,0,,Бұл...
Dialogue: 0,0:55:05.83,0:55:07.30,Default,,0,0,0,,Конгоу!
Dialogue: 0,0:55:10.00,0:55:10.87,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:55:11.00,0:55:12.80,Default,,0,0,0,,Жауынгерлік кеме немесе басқа нәрсе емес.
Dialogue: 0,0:55:13.41,0:55:14.91,Default,,0,0,0,,Біртүрлі...
Dialogue: 0,0:55:14.97,0:55:16.71,Default,,0,0,0,,Бұл ештеңе емес.
Dialogue: 0,0:55:23.98,0:55:27.02,Default,,0,0,0,,Ішінде Майяның табиғи дірілі бар.
Dialogue: 0,0:55:27.09,0:55:29.05,Default,,0,0,0,,Ол біріктіріліп жатыр ма?
Dialogue: 0,0:55:29.32,0:55:31.72,Default,,0,0,0,,Жоқ, қоңырауға жауап бермеңіз.
Dialogue: 0,0:55:32.92,0:55:33.89,Default,,0,0,0,,Бұл...
Dialogue: 0,0:55:35.03,0:55:36.73,Default,,0,0,0,,Біріктірілген
Dialogue: 0,0:55:37.36,0:55:38.50,Default,,0,0,0,,Ол бөліктерге бөлінген!
Dialogue: 0,0:55:53.01,0:55:54.01,Default,,0,0,0,,Конго
Dialogue: 0,0:55:56.95,0:55:58.08,Default,,0,0,0,,Конго
Dialogue: 0,0:55:58.35,0:56:00.65,Default,,0,0,0,,Сіздің қазіргі түріңіз біртүрлі.
Dialogue: 0,0:56:03.12,0:56:05.96,Default,,0,0,0,,Жауынгерлік кеменің пішінінен бас тартқаннан кейінгі қазіргі көрініс
Dialogue: 0,0:56:06.02,0:56:08.56,Default,,0,0,0,,Сіз ерекше назар аударған Тұман флотының ережелерінен.
Dialogue: 0,0:56:08.73,0:56:10.46,Default,,0,0,0,,Үлкен ауытқу
Dialogue: 0,0:56:11.36,0:56:14.07,Default,,0,0,0,,Бұл енді тұман емес
Dialogue: 0,0:56:15.40,0:56:16.97,Default,,0,0,0,,Енді Л тергеу мәліметтерінің маған тарағанын түсінгеннен кейін,
Dialogue: 0,0:56:17.50,0:56:19.67,Default,,0,0,0,,Бұл соғыс жариялау.
Dialogue: 0,0:56:20.47,0:56:22.41,Default,,0,0,0,,Мен сенмін
Dialogue: 0,0:56:22.87,0:56:23.84,Default,,0,0,0,,жою
Dialogue: 0,0:56:26.78,0:56:28.61,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:56:29.68,0:56:31.82,Default,,0,0,0,,Қарғыс атсын... Бұл соғыс жариялау ма?
Dialogue: 0,0:56:32.52,0:56:35.12,Default,,0,0,0,,Тұжырымдаманы беру екінші жағынан құлыпталады
Dialogue: 0,0:56:39.92,0:56:41.16,Default,,0,0,0,,Батып кету
Dialogue: 0,0:56:51.40,0:56:52.47,Default,,0,0,0,,Өрт!
Dialogue: 0,0:57:32.11,0:57:34.71,Default,,0,0,0,,Конгоу жараланды
Dialogue: 0,0:57:34.78,0:57:36.82,Default,,0,0,0,,Қазіргі уақытта зиянсыз ба?
Dialogue: 0,0:57:36.88,0:57:37.88,Default,,0,0,0,,(Ханшайым Лейди) Жоқ, қалай айтсам екен… Меніңше, бұл керемет.
Dialogue: 0,0:57:37.95,0:57:38.82,Default,,0,0,0,,Ха...
Dialogue: 0,0:57:39.08,0:57:42.82,Default,,0,0,0,,Ол бар екендігі дәлелденбейтін нәрсе.
Dialogue: 0,0:57:43.05,0:57:43.92,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:57:44.19,0:57:47.73,Default,,0,0,0,,Неліктен мен осындай қиын ойлау тәртібімен аяқталдым?
Dialogue: 0,0:57:48.63,0:57:51.06,Default,,0,0,0,,Біз қару емеспіз бе?
Dialogue: 0,0:57:51.13,0:57:52.63,Default,,0,0,0,,Бұл бірдеңе болды
Dialogue: 0,0:57:52.93,0:57:53.90,Default,,0,0,0,,орнына
Dialogue: 0,0:57:53.97,0:57:57.04,Default,,0,0,0,,Мен қазір кіммін?
Dialogue: 0,0:57:58.14,0:58:00.71,Default,,0,0,0,,Мен қазір кіммін?
Dialogue: 0,0:58:00.77,0:58:01.74,Default,,0,0,0,,Хару Хару…
Dialogue: 0,0:58:02.14,0:58:04.81,Default,,0,0,0,,Мен сақтағым келеді
Dialogue: 0,0:58:04.88,0:58:05.74,Default,,0,0,0,,Конго
Dialogue: 0,0:58:06.71,0:58:08.25,Default,,0,0,0,,Ұрысуға себеп жоқ
Dialogue: 0,0:58:08.95,0:58:09.98,Default,,0,0,0,,Кейде көңіл көтеру керек қой…
Dialogue: 0,0:58:10.05,0:58:11.72,Default,,0,0,0,,Есепті өңдеуден тыс импульс
Dialogue: 0,0:58:11.78,0:58:14.05,Default,,0,0,0,,Мені не итермелейді?
Dialogue: 0,0:58:15.15,0:58:17.26,Default,,0,0,0,,Гунзо Бұл сіздің ниетіңіз бе?
Dialogue: 0,0:58:17.62,0:58:18.76,Default,,0,0,0,,Ниет…
Dialogue: 0,0:58:19.02,0:58:20.06,Default,,0,0,0,,Ерік
Dialogue: 0,0:58:20.49,0:58:21.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:58:21.86,0:58:22.86,Default,,0,0,0,,Ниет
Dialogue: 0,0:58:23.19,0:58:24.16,Default,,0,0,0,,Иә
Dialogue: 0,0:58:24.86,0:58:25.80,Default,,0,0,0,,Иона
Dialogue: 0,0:58:25.86,0:58:27.67,Default,,0,0,0,,Конгоды сақтауға болады ма?
Dialogue: 0,0:58:28.23,0:58:29.53,Default,,0,0,0,,Суреттер тобы
Dialogue: 0,0:58:30.67,0:58:32.24,Default,,0,0,0,,Маған бұйрық беріңіз
Dialogue: 0,0:58:32.84,0:58:34.97,Default,,0,0,0,,Иона, сен одан жақсысың
Dialogue: 0,0:58:35.04,0:58:37.94,Default,,0,0,0,,Флагман Конгоу психикалық моделінің өзегімен физикалық байланыс
Dialogue: 0,0:58:38.61,0:58:40.61,Default,,0,0,0,,Оның ашуын тоқтатыңыз
Dialogue: 0,0:58:42.85,0:58:43.95,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:59:16.75,0:59:17.95,Default,,0,0,0,,Құлау.
Dialogue: 0,0:59:43.01,0:59:43.94,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:06.06,1:00:06.93,Default,,0,0,0,,Ха!
Dialogue: 0,1:00:07.73,1:00:09.87,Default,,0,0,0,,Өтінемін, мені тыңдаңыз!
Dialogue: 0,1:00:14.21,1:00:15.07,Default,,0,0,0,,Ах!
Dialogue: 0,1:00:17.94,1:00:19.78,Default,,0,0,0,,Уф...
Dialogue: 0,1:00:19.88,1:00:20.75,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:00:27.62,1:00:29.89,Default,,0,0,0,,Сен кімсің?
Dialogue: 0,1:00:30.86,1:00:31.72,Default,,0,0,0,,Конго…
Dialogue: 0,1:00:34.29,1:00:36.19,Default,,0,0,0,,Ах... физикалық байланыс!
Dialogue: 0,1:00:36.79,1:00:40.10,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз.
Dialogue: 0,1:00:51.08,1:00:52.88,Default,,0,0,0,,Қосылым аяқталды
Dialogue: 0,1:00:53.31,1:00:54.41,Default,,0,0,0,,Конгоу
Dialogue: 0,1:00:59.85,1:01:01.25,Default,,0,0,0,,Кедергі
Dialogue: 0,1:01:01.39,1:01:02.35,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:01:02.42,1:01:03.29,Default,,0,0,0,,Конго
Dialogue: 0,1:01:04.26,1:01:06.66,Default,,0,0,0,,Менің ішіме кірме!
Dialogue: 0,1:01:06.96,1:01:07.86,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:01:07.93,1:01:10.70,Default,,0,0,0,,Әйтпесе өлесің!
Dialogue: 0,1:01:10.93,1:01:12.16,Default,,0,0,0,,Уф!
Dialogue: 0,1:01:14.90,1:01:16.80,Default,,0,0,0,,Мен өлімді білдім!
Dialogue: 0,1:01:17.70,1:01:20.14,Default,,0,0,0,,Бұл өте өкінішті
Dialogue: 0,1:01:23.07,1:01:25.21,Default,,0,0,0,,Сен тым қыңырсың!
Dialogue: 0,1:01:25.91,1:01:28.11,Default,,0,0,0,,Неліктен өзгертуді қабылдай алмайсыз?
Dialogue: 0,1:01:28.38,1:01:30.05,Default,,0,0,0,,Өзгерту?
Dialogue: 0,1:01:30.68,1:01:32.45,Default,,0,0,0,,Бұл ақаулық деп аталады!
Dialogue: 0,1:01:35.39,1:01:36.39,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:01:36.45,1:01:37.32,Default,,0,0,0,,Олай болса!
Dialogue: 0,1:01:37.82,1:01:39.82,Default,,0,0,0,,Бұл ойлауды бұзатын ауырсыну қандай?
Dialogue: 0,1:01:40.73,1:01:42.16,Default,,0,0,0,,Ішімнен тасып
Dialogue: 0,1:01:42.33,1:01:43.33,Default,,0,0,0,,Ашу немесе қайғы
Dialogue: 0,1:01:43.96,1:01:45.13,Default,,0,0,0,,Мен жаншылып кететін сияқтымын!
Dialogue: 0,1:01:47.77,1:01:48.70,Default,,0,0,0,,Ах!
Dialogue: 0,1:01:48.97,1:01:50.40,Default,,0,0,0,,Уф...
Dialogue: 0,1:01:51.47,1:01:52.37,Default,,0,0,0,,Ха!
Dialogue: 0,1:01:59.71,1:02:01.25,Default,,0,0,0,,Con… Go…
Dialogue: 0,1:02:15.36,1:02:18.43,Default,,0,0,0,,Бұл шын мәнінде не?
Dialogue: 0,1:02:21.17,1:02:23.17,Default,,0,0,0,,Мазасыздық
Dialogue: 0,1:02:32.14,1:02:35.08,Default,,0,0,0,,Аса ауырлық зеңбіректің қалған барлық оқтарының энергиясы
Dialogue: 0,1:02:35.81,1:02:38.08,Default,,0,0,0,,Сені және менің өзегімді өшір
Dialogue: 0,1:02:42.39,1:02:44.32,Default,,0,0,0,,Менімен бірге
Dialogue: 0,1:02:44.39,1:02:45.92,Default,,0,0,0,,Жоғал
Dialogue: 0,1:02:46.99,1:02:47.99,Default,,0,0,0,,Әрине, оны есінен тандырып тастаған дұрыс қой?
Dialogue: 0,1:02:57.10,1:02:57.97,Default,,0,0,0,,Сіздің әпкеңіз ше?
Dialogue: 0,1:02:58.04,1:02:59.20,Default,,0,0,0,,Күтуге себеп жоқ!
Dialogue: 0,1:02:59.47,1:03:00.51,Default,,0,0,0,,Ионар!
Dialogue: 0,1:03:01.01,1:03:01.87,Default,,0,0,0,,Ах...
Dialogue: 0,1:03:02.51,1:03:03.78,Default,,0,0,0,,Топтық сурет?
Dialogue: 0,1:03:03.84,1:03:04.51,Default,,0,0,0,,Уф...
Dialogue: 0,1:03:12.82,1:03:14.49,Default,,0,0,0,,Өлшенбейтін
Dialogue: 0,1:03:15.35,1:03:17.52,Default,,0,0,0,,Сіз мұндай қуатты қайда сақтадыңыз?
Dialogue: 0,1:03:18.09,1:03:19.89,Default,,0,0,0,,Қуат сөнсе де
Dialogue: 0,1:03:21.36,1:03:23.90,Default,,0,0,0,,Мен сені тоқтатқым келеді!
Dialogue: 0,1:03:24.56,1:03:26.33,Default,,0,0,0,,Бұл мені қозғайды!
Dialogue: 0,1:03:32.20,1:03:33.27,Default,,0,0,0,,Конго
Dialogue: 0,1:03:34.01,1:03:35.31,Default,,0,0,0,,Енді жүр!
Dialogue: 0,1:03:43.92,1:03:44.85,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:03:45.22,1:03:46.92,Default,,0,0,0,,Қорқақтар!
Dialogue: 0,1:03:47.19,1:03:48.05,Default,,0,0,0,,Маған!
Dialogue: 0,1:03:48.22,1:03:49.39,Default,,0,0,0,,Оған тимеңіз!
Dialogue: 0,1:03:58.00,1:03:59.16,Default,,0,0,0,,Бұл қандай да бір «Гя●ган» ба?!
Dialogue: 0,1:03:59.23,1:04:01.93,Default,,0,0,0,,Неліктен заттар қазіргідей бола алмайды?
Dialogue: 0,1:04:02.03,1:04:03.30,Default,,0,0,0,,Өзгертудің қажеті жоқ!
Dialogue: 0,1:04:03.37,1:04:04.90,Default,,0,0,0,,Маған қарым-қатынас қажет емес!
Dialogue: 0,1:04:05.00,1:04:06.50,Default,,0,0,0,,Мен жалғыз қалғаныма қуаныштымын!
Dialogue: 0,1:04:06.94,1:04:09.94,Default,,0,0,0,,Дүниені танығым келмеді!
Dialogue: 0,1:04:19.45,1:04:21.19,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,1:04:23.29,1:04:24.16,Default,,0,0,0,,Конго
Dialogue: 0,1:04:24.36,1:04:26.09,Default,,0,0,0,,Ха... тоқта!
Dialogue: 0,1:04:49.91,1:04:50.88,Default,,0,0,0,,Ах...
Dialogue: 0,1:04:57.22,1:04:58.96,Default,,0,0,0,,Енді бәрі жақсы
Dialogue: 0,1:05:01.06,1:05:02.39,Default,,0,0,0,,Қосылған болса
Dialogue: 0,1:05:03.49,1:05:05.23,Default,,0,0,0,,Бір-бірімізді түсінсек
Dialogue: 0,1:05:06.30,1:05:08.30,Default,,0,0,0,,Енді қорқудың қажеті жоқ
Dialogue: 0,1:05:09.97,1:05:12.54,Default,,0,0,0,,Бір-бірімізді түсінсек не істеуіміз керек?
Dialogue: 0,1:05:13.14,1:05:14.44,Default,,0,0,0,,Then
Dialogue: 0,1:05:14.51,1:05:16.31,Default,,0,0,0,,Біз дос бола аламыз
Dialogue: 0,1:05:16.37,1:05:17.24,Default,,0,0,0,,Ха...
Dialogue: 0,1:05:34.69,1:05:36.49,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:05:49.54,1:05:50.41,Default,,0,0,0,,Қазіргі уақытта
Dialogue: 0,1:05:50.57,1:05:53.24,Default,,0,0,0,,Ионаның сәйкестендіру сигналын тексеру
Dialogue: 0,1:05:53.51,1:05:55.28,Default,,0,0,0,,Психикалық модель Иона бұл...
Dialogue: 0,1:05:56.28,1:05:57.25,Default,,0,0,0,,Ол тірі және жақсы!
Dialogue: 0,1:05:57.32,1:05:59.28,Default,,0,0,0,,(Барлығы қуанады)
Dialogue: 0,1:06:00.45,1:06:01.69,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:06:02.22,1:06:03.55,Default,,0,0,0,,Ах...
Dialogue: 0,1:06:04.26,1:06:05.56,Default,,0,0,0,,Иона…
Dialogue: 0,1:07:01.15,1:07:08.15,Default,,0,0,0,,(Оператор нұсқаулары)
Dialogue: 0,1:07:14.16,1:07:17.23,Default,,0,0,0,,Барлық жауынгерлік станциялар жұмысының басталуы
Dialogue: 0,1:07:17.76,1:07:19.03,Default,,0,0,0,,Сол жақтағы адам бәрін егжей-тегжейлі түсіндіреді. Содан кейін оның нұсқауларын орындаңыз
Dialogue: 0,1:07:19.53,1:07:21.23,Default,,0,0,0,,Жұмысты бастау
Dialogue: 0,1:07:22.27,1:07:25.20,Default,,0,0,0,,Көз алмасы Жұмыс қашықтығына жақын
Dialogue: 0,1:07:35.48,1:07:39.12,Default,,0,0,0,,Decoy кемесінің нұсқау үлгісі Omega белсендіру уақыты
Dialogue: 0,1:07:54.43,1:07:57.27,Default,,0,0,0,,Тұман кемесі ұшқышсыз кемені қадағалай бастады.
Dialogue: 0,1:07:57.64,1:07:59.20,Default,,0,0,0,,Сәтті индукция
Dialogue: 0,1:08:00.44,1:08:02.11,Default,,0,0,0,,Сіз жаудың кемесінің атын білесіз бе?
Dialogue: 0,1:08:03.54,1:08:04.84,Default,,0,0,0,,Флетчер класындағы жойғыш
Dialogue: 0,1:08:05.11,1:08:07.45,Default,,0,0,0,,DD-680 Melvin
Dialogue: 0,1:08:10.25,1:08:12.48,Default,,0,0,0,,Барлық жауынгерлік станцияларды басқарудан
Dialogue: 0,1:08:12.58,1:08:14.65,Default,,0,0,0,,Slayer 1 күту режимі
Dialogue: 0,1:08:17.52,1:08:21.29,Default,,0,0,0,,Slayer 1 сомниумды тұтыну жылдамдығы қолайлы ауқымда
Dialogue: 0,1:08:21.63,1:08:23.49,Default,,0,0,0,,Онлайн режимінде көздеу жүйесі
Dialogue: 0,1:08:24.36,1:08:26.53,Default,,0,0,0,,1-ші өлтірушінің соңғы қауіпсіздік құрылғысы
Dialogue: 0,1:08:26.60,1:08:28.23,Default,,0,0,0,,Бас тартуды растау
Dialogue: 0,1:08:29.57,1:08:31.50,Default,,0,0,0,,Кванттық механикалық сақтау тобы
Dialogue: 0,1:08:31.57,1:08:33.57,Default,,0,0,0,,Фокстрот Браво мәртебесі
Dialogue: 0,1:08:33.64,1:08:36.24,Default,,0,0,0,,Тоғыздық Нөл Тоғыздық көшу
Dialogue: 0,1:08:38.78,1:08:40.71,Default,,0,0,0,,Барлық ұрыс станцияларына хабарлау
Dialogue: 0,1:08:40.78,1:08:43.11,Default,,0,0,0,,Діріл жүйесі шығарылды
Dialogue: 0,1:08:45.58,1:08:47.59,Default,,0,0,0,,Салқындату жүйесін бөлу
Dialogue: 0,1:08:51.46,1:08:53.52,Default,,0,0,0,,Салқындату жүйесінің бөлінуін тексеріңіз
Dialogue: 0,1:08:53.69,1:08:56.26,Default,,0,0,0,,Slayer 1 ұшыруға дайындық аяқталды
Dialogue: 0,1:08:56.43,1:08:58.83,Default,,0,0,0,,Алдаушы кеме Мелвинге шабуыл жасасын!
Dialogue: 0,1:08:58.90,1:09:00.26,Default,,0,0,0,,айтқан жоқпын ба?
Dialogue: 0,1:09:09.81,1:09:11.14,Default,,0,0,0,,Қанішер 1
Dialogue: 0,1:09:11.21,1:09:12.28,Default,,0,0,0,,Бастапқы ұпайлар: 10 миллион
Dialogue: 0,1:09:13.21,1:09:14.38,Default,,0,0,0,,50 секунд бұрын
Dialogue: 0,1:09:18.65,1:09:20.42,Default,,0,0,0,,Пит Гридли
Dialogue: 0,1:09:20.48,1:09:21.85,Default,,0,0,0,,Уэйн Э. Мейер 5G
Dialogue: 0,1:09:21.92,1:09:23.22,Default,,0,0,0,,♪ Ка-та-на
Dialogue: 0,1:09:23.29,1:09:26.52,Default,,0,0,0,,Біз тұман кемесін шығара алдық,
Dialogue: 0,1:09:26.59,1:09:30.63,Default,,0,0,0,,Сіздің ойыңызша, Жапониядан келген сыйлық пайдалы бола ма?
Dialogue: 0,1:09:31.56,1:09:34.70,Default,,0,0,0,,Қажетсіз іс істемейтін адам.
Dialogue: 0,1:09:35.23,1:09:37.54,Default,,0,0,0,,Спруанс және Томас Хаднер
Dialogue: 0,1:09:37.60,1:09:38.94,Default,,0,0,0,,Әлі тірі және аман
Dialogue: 0,1:09:39.20,1:09:40.50,Default,,0,0,0,,Шабуылды жалғастыру
Dialogue: 0,1:09:40.57,1:09:42.31,Default,,0,0,0,,Мені өз ниетіңді жүзеге асырма.
Dialogue: 0,1:09:42.61,1:09:44.34,Default,,0,0,0,,Бұл ескі кеме болса да
Dialogue: 0,1:09:44.41,1:09:47.55,Default,,0,0,0,,Суға батып бара жатқан кемені көргенде жүрегіміз ауырады.
Dialogue: 0,1:09:48.18,1:09:50.41,Default,,0,0,0,,Басқа жол бар ма еді?
Dialogue: 0,1:09:51.85,1:09:52.72,Default,,0,0,0,,Жоқ
Dialogue: 0,1:09:53.35,1:09:56.75,Default,,0,0,0,,Бұрышталған адамзаттың таңдауы жоқ.
Dialogue: 0,1:09:58.42,1:09:59.36,Default,,0,0,0,,Үміттенемін
Dialogue: 0,1:09:59.42,1:10:02.39,Default,,0,0,0,,Бұл қарсы шабуыл болуы мүмкін.
Dialogue: 0,1:10:03.49,1:10:04.60,Default,,0,0,0,,Өрт!
Dialogue: 0,1:10:04.66,1:10:05.76,Default,,0,0,0,,Іске қосу
Dialogue: 0,1:10:15.94,1:10:17.98,Default,,0,0,0,,1-ші өлтіруші атылды
Dialogue: 0,1:10:18.84,1:10:20.74,Default,,0,0,0,,Соққыға дейін 20 секунд
Dialogue: 0,1:11:25.64,1:11:28.55,Default,,0,0,0,,Мелвиннің корпусы жоғалып кеткені расталды.
Dialogue: 0,1:11:28.61,1:11:30.71,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:11:31.02,1:11:32.28,Default,,0,0,0,,Сәттілік
Dialogue: 0,1:11:32.35,1:11:36.02,Default,,0,0,0,,Ақырында бізде тұманды тазартатын күш бар.
Dialogue: 0,1:11:36.35,1:11:38.32,Default,,0,0,0,,Жаппай өндіріс бірқалыпты жүріп жатыр
Dialogue: 0,1:11:38.89,1:11:40.96,Default,,0,0,0,,Бұл дірілдейтін оқтұмсық па?
Dialogue: 0,1:11:41.03,1:11:43.43,Default,,0,0,0,,Рахмет, жоғарғы көлеңке.
Dialogue: 0,1:11:43.49,1:11:45.03,Default,,0,0,0,,Бұл жігітті қолдануға болады.
Dialogue: 0,1:11:45.63,1:11:50.53,Default,,0,0,0,,(Дабыл)
Dialogue: 0,1:11:50.60,1:11:52.30,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:11:52.74,1:11:56.31,Default,,0,0,0,,Slayer 2 3 4-те ауытқу орын алды
Dialogue: 0,1:11:56.67,1:11:59.08,Default,,0,0,0,,Барлық дірілдейтін оқтұмсықтар өшірілген
Dialogue: 0,1:11:59.48,1:12:02.35,Default,,0,0,0,,Протокол сыртқы байланысты жоққа шығарады
Dialogue: 0,1:12:02.81,1:12:04.75,Default,,0,0,0,,Тез арада шара қабылдаңыз!
Dialogue: 0,1:12:05.05,1:12:09.45,Default,,0,0,0,,Діріл оқтұмсықтарын басқару жүйесі қара жәшік болып табылады.
Dialogue: 0,1:12:10.45,1:12:11.96,Default,,0,0,0,,Джобу Такиге қоңырау шалыңыз!
Dialogue: 0,1:12:12.02,1:12:13.96,Default,,0,0,0,,Slayer Farm-дан шұғыл байланыс
Dialogue: 0,1:12:14.39,1:12:17.39,Default,,0,0,0,,Барлық сомниумдар белсенді емес болды.
Dialogue: 0,1:12:18.60,1:12:20.60,Default,,0,0,0,,Не болып жатыр!
Dialogue: 0,1:12:20.96,1:12:23.40,Default,,0,0,0,,Біз аяқтаған дірілдеген оқтұмсық
Dialogue: 0,1:12:23.57,1:12:26.67,Default,,0,0,0,,Бұл бәрі енді қолданылмайтынын білдіреді.
Dialogue: 0,1:12:26.80,1:12:28.77,Default,,0,0,0,,Бұл... ақымақ.
Dialogue: 0,1:12:29.67,1:12:31.11,Default,,0,0,0,,Оу! Екінші оқ сәл қалды!
Dialogue: 0,1:12:31.38,1:12:34.08,Default,,0,0,0,,Шо Чихаяның ұлы
Dialogue: 0,1:12:49.46,1:12:50.39,Default,,0,0,0,,Капитан
Dialogue: 0,1:12:50.46,1:12:53.70,Default,,0,0,0,,Somnium Hibernator іске қосылды.
Dialogue: 0,1:12:53.76,1:12:54.70,Default,,0,0,0,,Жарайды
Dialogue: 0,1:12:54.93,1:12:57.77,Default,,0,0,0,,Сан-Диего дәл қазір дүрбелеңде.
Dialogue: 0,1:12:59.77,1:13:02.07,Default,,0,0,0,,Тұман бір рет қана қауіп төндіреді.
Dialogue: 0,1:13:02.37,1:13:05.01,Default,,0,0,0,,Біздің мақсатымыз жойылу емес.
Dialogue: 0,1:13:05.08,1:13:08.88,Default,,0,0,0,,Сізге бар болғаны басқа адамға сіздің күшіңіз тең екенін жеткізу керек.
Dialogue: 0,1:13:09.78,1:13:12.68,Default,,0,0,0,,Дірілдейтін оқтұмсықтарды қолданбаңыз
Dialogue: 0,1:13:13.05,1:13:14.02,Default,,0,0,0,,Енді бізде
Dialogue: 0,1:13:14.08,1:13:17.45,Default,,0,0,0,,Сізді жерлестеріңіз көбірек іздейді.
Dialogue: 0,1:13:17.82,1:13:20.76,Default,,0,0,0,,100 немесе 200 жыл түрмеде отыру мұны жасамайды.
Dialogue: 0,1:13:21.02,1:13:22.13,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,1:13:22.39,1:13:23.89,Default,,0,0,0,,Ештеңе істемегеннен әлдеқайда жақсы
Dialogue: 0,1:13:23.96,1:13:24.83,Default,,0,0,0,,Ах...
Dialogue: 0,1:13:26.56,1:13:27.73,Default,,0,0,0,,Реакцияны түсіріңіз
Dialogue: 0,1:13:27.80,1:13:28.93,Default,,0,0,0,,028-бағыт
Dialogue: 0,1:13:29.63,1:13:31.47,Default,,0,0,0,,402 қалды
Dialogue: 0,1:13:32.04,1:13:32.90,Default,,0,0,0,,Уф...
Dialogue: 0,1:14:12.61,1:14:16.45,Default,,0,0,0,,Бұл бір ғана мүмкіндік болды, бірақ ол байланысты болды.
Dialogue: 0,1:14:16.51,1:14:18.88,Default,,0,0,0,,Егер барлау бөлімінің деректері тірі болса
Dialogue: 0,1:14:18.95,1:14:21.62,Default,,0,0,0,,Біз флагманның орнын таба білуіміз керек.
Dialogue: 0,1:14:21.82,1:14:25.86,Default,,0,0,0,,Егер бәрі ойдағыдай болса, генерал Тұманды кездестіресіз.
Dialogue: 0,1:14:26.09,1:14:27.06,Default,,0,0,0,,О
Dialogue: 0,1:14:27.12,1:14:28.73,Default,,0,0,0,,Келесі бет
Dialogue: 0,1:14:30.59,1:14:31.63,Default,,0,0,0,,Хмф!
Dialogue: 0,1:14:34.50,1:14:36.00,Default,,0,0,0,,Жасайды
Dialogue: 0,1:14:36.67,1:14:41.61,Default,,0,0,0,,Дірілдейтін оқтұмсық тек тежеу құралы ма?
Dialogue: 0,1:14:46.68,1:14:48.68,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,1:14:48.75,1:14:52.15,Default,,0,0,0,,Талдауды күту... ол қанша уақытты алады?
Dialogue: 0,1:14:53.98,1:14:57.59,Default,,0,0,0,,Тұман жойылмай, адамзаттың тірі қалуы мүмкін емес.
Dialogue: 0,1:14:57.79,1:15:00.92,Default,,0,0,0,,Керісінше, біздің көзқарасымыз одан тыс
Dialogue: 0,1:15:01.12,1:15:03.83,Default,,0,0,0,,Қайта құрудан кейін әлемді қалай қалыптастыруға болады
Dialogue: 0,1:15:04.16,1:15:06.53,Default,,0,0,0,,Оны кім басқарады?
Dialogue: 0,1:15:08.03,1:15:10.73,Default,,0,0,0,,Аз ғана адам аман қалады.
Dialogue: 0,1:15:11.10,1:15:12.87,Default,,0,0,0,,Жаңа тапсырыс үшін
Dialogue: 0,1:15:13.67,1:15:16.84,Default,,0,0,0,,Біздің ұрпақ садақ тартуы керек.
Dialogue: 0,1:16:46.13,1:16:47.00,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,1:16:47.06,1:16:48.63,Default,,0,0,0,,Нффхуфуфу (Маки) Ах! Қайтадан қош келдіңіз!
Dialogue: 0,1:16:48.93,1:16:50.20,Default,,0,0,0,,Хару Хару~!
Dialogue: 0,1:16:52.00,1:16:53.34,Default,,0,0,0,,Жақсы болды ма?
Dialogue: 0,1:16:53.94,1:16:54.84,Default,,0,0,0,,Иә!
Dialogue: 0,1:16:55.04,1:16:56.27,Default,,0,0,0,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 0,1:16:56.71,1:16:58.91,Default,,0,0,0,,Мен қосымша нан алдым.
Dialogue: 0,1:16:58.98,1:17:00.84,Default,,0,0,0,,О! Керемет! О!
Dialogue: 0,1:17:01.65,1:17:04.65,Default,,0,0,0,,Ах! Хару Хару! Сырттан келсем ше?
Dialogue: 0,1:17:04.95,1:17:05.82,Default,,0,0,0,,О
Dialogue: 0,1:17:05.88,1:17:07.32,Default,,0,0,0,,Стерилизация.
Dialogue: 0,1:17:10.12,1:17:12.36,Default,,0,0,0,,
Dialogue: 0,1:17:13.76,1:17:17.23,Default,,0,0,0,,6 минут бұрын Сомнийдің гибернатор реакциясы
Dialogue: 0,1:17:17.63,1:17:20.13,Default,,0,0,0,,А, мен де осында тексердім.
Dialogue: 0,1:17:24.03,1:17:27.77,Default,,0,0,0,,Бұл соғыстың аяқталуы, солай ма?
Dialogue: 0,1:17:28.17,1:17:30.14,Default,,0,0,0,,Стратегия осы үшін арналған.
Dialogue: 0,1:17:30.84,1:17:31.94,Default,,0,0,0,,Иә!
Dialogue: 0,1:17:35.35,1:17:36.98,Default,,0,0,0,,Бірақ бәрібір
Dialogue: 0,1:17:37.05,1:17:39.85,Default,,0,0,0,,Бұл тұман флотының шығынға ұшырағанын өзгертпейді.
Dialogue: 0,1:17:40.12,1:17:41.69,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,1:17:42.69,1:17:44.05,Default,,0,0,0,,Чихая Гунзо
Dialogue: 0,1:17:44.12,1:17:47.16,Default,,0,0,0,,Бұл ұрыс-керіске жол бермеудің жолы екенін айтты.
Dialogue: 0,1:17:48.33,1:17:50.06,Default,,0,0,0,,Адамдар өтірік айтады, бірақ
Dialogue: 0,1:17:50.13,1:17:53.90,Default,,0,0,0,,Біз бұл мәселеге қатысты күдіктің жоқтығын анықтадық.
Dialogue: 0,1:17:54.67,1:17:57.40,Default,,0,0,0,,Егер сіз зиянды азайта алсаңыз, бұл жақсы.
Dialogue: 0,1:17:57.67,1:17:58.74,Default,,0,0,0,,Сенімсіз
Dialogue: 0,1:17:59.14,1:18:02.94,Default,,0,0,0,,Мен онымен сөйлесуге тырыстым, бірақ содан бері Конгудан хабар жоқ.
Dialogue: 0,1:18:03.37,1:18:05.11,Default,,0,0,0,,Көп нәрсе болды...
Dialogue: 0,1:18:05.18,1:18:06.44,Default,,0,0,0,,Харухару~!
Dialogue: 0,1:18:07.91,1:18:10.95,Default,,0,0,0,,Оның өз ойы бар шығар.
Dialogue: 0,1:18:11.68,1:18:14.95,Default,,0,0,0,,Қазір! Тоқтату кодын белсендіру расталды!
Dialogue: 0,1:18:15.02,1:18:16.35,Default,,0,0,0,,Әрекетті бастаңыз!
Dialogue: 0,1:18:16.42,1:18:18.06,Default,,0,0,0,,Хахахаха!
Dialogue: 0,1:18:18.69,1:18:20.06,Default,,0,0,0,,Шәкең
Dialogue: 0,1:18:20.46,1:18:22.06,Default,,0,0,0,,Шәкең!
Dialogue: 0,1:18:22.33,1:18:23.99,Default,,0,0,0,,Ағымдағы уақыт бойынша
Dialogue: 0,1:18:24.06,1:18:27.06,Default,,0,0,0,,Біз адам үкіметтерінің бақылауынан қашамыз.
Dialogue: 0,1:18:27.13,1:18:28.23,Default,,0,0,0,,Жер астына өту
Dialogue: 0,1:18:28.30,1:18:29.87,Default,,0,0,0,,О!
Dialogue: 0,1:18:37.11,1:18:38.08,Default,,0,0,0,,Таза!
Dialogue: 0,1:18:41.91,1:18:42.81,Default,,0,0,0,,Таза!
Dialogue: 0,1:19:12.78,1:19:13.88,Default,,0,0,0,,Уау
Dialogue: 0,1:19:14.01,1:19:17.05,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,1:19:17.11,1:19:19.02,Default,,0,0,0,,Дененің болуы
Dialogue: 0,1:19:19.08,1:19:22.19,Default,,0,0,0,,Жақсы!
Dialogue: 0,1:19:26.39,1:19:28.13,Default,,0,0,0,,Мені бір нәрсе ашуландырады
Dialogue: 0,1:19:28.19,1:19:31.29,Default,,0,0,0,,Олар сирек кездесетін наноматериалдарды пайдаланбауы керек еді.
Dialogue: 0,1:19:31.43,1:19:35.13,Default,,0,0,0,,Тек қана қалды~ Егер кемені қайтарып алсақ, ол керемет болады!
Dialogue: 0,1:19:35.20,1:19:36.13,Default,,0,0,0,,Хаа…
Dialogue: 0,1:19:36.93,1:19:38.40,Default,,0,0,0,,Ах! қазірдің өзінде!
Dialogue: 0,1:19:38.47,1:19:41.27,Default,,0,0,0,,Мен кемені қашан қалпына келтіре аламын?
Dialogue: 0,1:19:41.34,1:19:42.51,Default,,0,0,0,,Иә?
Dialogue: 0,1:19:44.41,1:19:46.81,Default,,0,0,0,,Кішкентай болма!
Dialogue: 0,1:19:46.88,1:19:48.45,Default,,0,0,0,,Осы жағажайда наноматериалдар болса
Dialogue: 0,1:19:48.51,1:19:49.45,Default,,0,0,0,,Сіз мұны істей аласыз, солай ма?
Dialogue: 0,1:19:49.51,1:19:50.78,Default,,0,0,0,,Иә?
Dialogue: 0,1:19:52.02,1:19:54.32,Default,,0,0,0,,Менің ойымша, сізге шыдамдылық танытып, оларды жинау керек.
Dialogue: 0,1:19:54.48,1:19:56.85,Default,,0,0,0,,Дұрыс~ Енді наноматериалдарды жинаңыз...
Dialogue: 0,1:19:56.92,1:19:58.46,Default,,0,0,0,,...Бірге жиналайық!
Dialogue: 0,1:19:58.52,1:19:59.46,Default,,0,0,0,,Уф
Dialogue: 0,1:19:59.52,1:20:02.13,Default,,0,0,0,,Осы қарқынмен капитан өмірінің соңында өледі!
Dialogue: 0,1:20:02.23,1:20:03.53,Default,,0,0,0,,Аа~ қазірдің өзінде! Ах~
Dialogue: 0,1:20:03.79,1:20:05.93,Default,,0,0,0,,Көп шағымданатын әйел!
Dialogue: 0,1:20:08.97,1:20:09.93,Default,,0,0,0,,Хмм.
Dialogue: 0,1:20:10.37,1:20:13.10,Default,,0,0,0,,Осы арқылы флагманның орнын таба аласыз ба?
Dialogue: 0,1:20:13.27,1:20:15.04,Default,,0,0,0,,400 402
Dialogue: 0,1:20:15.11,1:20:18.14,Default,,0,0,0,,Бұл Мұсашидің қарамағындағы барлау бөлімі болды, солай ма?
Dialogue: 0,1:20:18.44,1:20:20.81,Default,,0,0,0,,Мұсашидің қадамдары түсінікті болса ғой...
Dialogue: 0,1:20:20.88,1:20:24.25,Default,,0,0,0,,Бұл флагманның орналасқан жерін автоматты түрде білуге болатындығын білдіре ме?
Dialogue: 0,1:20:24.31,1:20:26.48,Default,,0,0,0,,Деректердің көпшілігі өлі
Dialogue: 0,1:20:26.55,1:20:28.39,Default,,0,0,0,,Бұл пәрмендер журналының бір түрі ме?
Dialogue: 0,1:20:28.45,1:20:30.82,Default,,0,0,0,,Тіпті шарлау деректері қалса...
Dialogue: 0,1:20:30.89,1:20:31.56,Default,,0,0,0,,Ах! иә?
Dialogue: 0,1:20:34.02,1:20:35.46,Default,,0,0,0,,Бинго!
Dialogue: 0,1:20:37.36,1:20:38.93,Default,,0,0,0,,Солтүстік мұзды мұхит?
Dialogue: 0,1:20:39.16,1:20:40.03,Default,,0,0,0,,Иә!
Dialogue: 0,1:20:40.10,1:20:43.40,Default,,0,0,0,,Біз талдай алған деректерден осыны ғана айта аламыз.
Dialogue: 0,1:20:43.47,1:20:47.17,Default,,0,0,0,,Мүмкін Ямато мен Мусаши Солтүстік Мұзды мұхитты патрульдеп жүрген шығар.
Dialogue: 0,1:20:47.50,1:20:49.07,Default,,0,0,0,,Жарайсыңдар
Dialogue: 0,1:20:49.14,1:20:52.38,Default,,0,0,0,,Мұны білу – алға жасалған үлкен қадам.
Dialogue: 0,1:20:52.44,1:20:55.48,Default,,0,0,0,,Сонымен, сізде Beaton Seamount-қа қайта оралуға себеп болды.
Dialogue: 0,1:20:55.58,1:20:59.28,Default,,0,0,0,,Сіз шынымен флагмандық Яматомен кездесуді жоспарлап отырсыз ба?
Dialogue: 0,1:20:59.58,1:21:00.52,Default,,0,0,0,,О
Dialogue: 0,1:21:00.58,1:21:03.52,Default,,0,0,0,,Мен сізбен кездесіп, бұл шайқастың неліктен басталғанын сұрағым келеді.
Dialogue: 0,1:21:03.59,1:21:07.29,Default,,0,0,0,,Сосын соғысты тоқтату үшін келіссөз жүргіземіз.
Dialogue: 0,1:21:07.59,1:21:08.53,Default,,0,0,0,,Хаа…
Dialogue: 0,1:21:08.59,1:21:10.63,Default,,0,0,0,,Менің ойымша, сіз оны қорқынышсыз деп атайсыз.
Dialogue: 0,1:21:10.89,1:21:13.63,Default,,0,0,0,,Біз де ешқашан тікелей байланыста болған емеспіз.
Dialogue: 0,1:21:13.90,1:21:16.23,Default,,0,0,0,,Мен мұны істесем не болады?
Dialogue: 0,1:21:16.30,1:21:17.27,Default,,0,0,0,,Салқындату~!
Dialogue: 0,1:21:17.87,1:21:19.10,Default,,0,0,0,,Балалар
Dialogue: 0,1:21:19.17,1:21:21.97,Default,,0,0,0,,Бастықтарды білмей төбелестің бе?
Dialogue: 0,1:21:22.27,1:21:24.37,Default,,0,0,0,,Қару тек бұйрықты орындайды
Dialogue: 0,1:21:24.44,1:21:27.08,Default,,0,0,0,,Сол кезде мен де солай ойладым.
Dialogue: 0,1:21:27.14,1:21:29.95,Default,,0,0,0,,Бұл сіздің ештеңе туралы ойламағаныңызды білдіреді.
Dialogue: 0,1:21:30.08,1:21:32.58,Default,,0,0,0,,Хмф! Менің ойымша, бұл жақсы болар еді
Dialogue: 0,1:21:33.18,1:21:35.92,Default,,0,0,0,,Мен енді Едемде тұра алмаймын.
Dialogue: 0,1:21:35.99,1:21:37.22,Default,,0,0,0,,Гунзо Чихая
Dialogue: 0,1:21:37.29,1:21:39.22,Default,,0,0,0,,Әңгімені түсінетін мен сияқты әйел
Dialogue: 0,1:21:39.29,1:21:41.32,Default,,0,0,0,,Ол жоқ деп ойлаған дұрыс.
Dialogue: 0,1:21:41.39,1:21:43.03,Default,,0,0,0,,Ертегіні түсіндің бе?
Dialogue: 0,1:21:43.09,1:21:44.46,Default,,0,0,0,,Сен жәй ғана боқсың.
Dialogue: 0,1:21:44.53,1:21:46.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:21:46.06,1:21:46.93,Default,,0,0,0,,Охон
Dialogue: 0,1:21:47.00,1:21:49.90,Default,,0,0,0,,Қалай болғанда да, бұл оңай емес!
Dialogue: 0,1:21:52.50,1:21:54.20,Default,,0,0,0,,Әйелдің интуициясы
Dialogue: 0,1:21:55.51,1:21:57.61,Default,,0,0,0,,Рахмет, түсіндім.
Dialogue: 0,1:21:59.18,1:22:00.04,Default,,0,0,0,,Хмф!
Dialogue: 0,1:22:00.11,1:22:02.65,Default,,0,0,0,,Мен қатты уайымдамаймын.
Dialogue: 0,1:22:02.91,1:22:04.45,Default,,0,0,0,,Сондықтан да
Dialogue: 0,1:22:04.51,1:22:07.95,Default,,0,0,0,,Басқа деректерді қалпына келтіру мүмкін болса, сізге хабарлаймын.
Dialogue: 0,1:22:08.02,1:22:10.55,Default,,0,0,0,,Көп нәрсе күтпеу~
Dialogue: 0,1:22:10.62,1:22:11.55,Default,,0,0,0,,Ах! аздап!
Dialogue: 0,1:22:11.62,1:22:13.96,Default,,0,0,0,,Неліктен рұқсатсыз байланысты жабуға тырысасыз?
Dialogue: 0,1:22:14.02,1:22:15.63,Default,,0,0,0,,Электр қуаты шектеулі!
Dialogue: 0,1:22:16.33,1:22:17.63,Default,,0,0,0,,Байланыс аяқталады
Dialogue: 0,1:22:20.03,1:22:23.20,Default,,0,0,0,,Бұл балалар бастапқыда жау болған, солай ма?
Dialogue: 0,1:22:23.27,1:22:25.44,Default,,0,0,0,,Ол біршама бейресми сипатқа ие болды.
Dialogue: 0,1:22:25.50,1:22:27.24,Default,,0,0,0,,Бұл жақсы нәрсе емес пе?
Dialogue: 0,1:22:32.54,1:22:34.34,Default,,0,0,0,,Не болды? Иона
Dialogue: 0,1:22:37.01,1:22:38.45,Default,,0,0,0,,Енді не болады
Dialogue: 0,1:22:40.12,1:22:43.22,Default,,0,0,0,,Тек алға жылжу үшін не істеу керек болса, соны істе.
Dialogue: 0,1:22:44.55,1:22:46.46,Default,,0,0,0,,Жарайды, Иона.
Dialogue: 0,1:22:48.26,1:22:50.99,Default,,0,0,0,,Болашақ қайда?
Dialogue: 0,1:22:51.06,1:22:52.16,Default,,0,0,0,,Онда не бар?
Dialogue: 0,1:22:52.73,1:22:54.06,Default,,0,0,0,,Ха...
Dialogue: 0,1:23:01.71,1:23:02.71,Default,,0,0,0,,Иона… (ескерту дыбысы)
Dialogue: 0,1:23:02.97,1:23:03.64,Default,,0,0,0,,Ха!
Dialogue: 0,1:23:04.24,1:23:05.28,Default,,0,0,0,,Сонарды сезін!
Dialogue: 0,1:23:05.34,1:23:07.74,Default,,0,0,0,,Жер үсті кемелерінің теңіз бетіндегі реакциясы 3!
Dialogue: 0,1:23:08.01,1:23:08.75,Default,,0,0,0,,Қандай кеме түрі?
Dialogue: 0,1:23:09.35,1:23:10.68,Default,,0,0,0,,Сәйкес дыбыс ізі жоқ
Dialogue: 0,1:23:10.75,1:23:14.65,Default,,0,0,0,,Бірақ барлық қозғалтқыш дыбыстары гравитон қозғалтқышынан шыққан.
Dialogue: 0,1:23:15.22,1:23:16.45,Default,,0,0,0,,Жауынгерлік өрістегі барлық кемелер!
Dialogue: 0,1:23:18.42,1:23:21.16,Default,,0,0,0,,Психикалық модель бар (Гунзо) Иә?
Dialogue: 0,1:23:42.68,1:23:44.68,Default,,0,0,0,,Тыныштық! Қарсыластың орны қандай?
Dialogue: 0,1:23:44.75,1:23:47.48,Default,,0,0,0,,Подшипник 315 Қашықтық 27
Dialogue: 0,1:23:47.55,1:23:50.45,Default,,0,0,0,,Теңіздегі суға батқан Мидуэй аралы
Dialogue: 0,1:23:50.52,1:23:51.76,Default,,0,0,0,,Жақын.
Dialogue: 0,1:23:52.02,1:23:54.32,Default,,0,0,0,,Бұл оның аралда жасырынғанын білдіре ме?
Dialogue: 0,1:23:54.39,1:23:57.16,Default,,0,0,0,,Әрине, сіз мұны байқадыңыз.
Dialogue: 0,1:23:57.23,1:23:59.70,Default,,0,0,0,,Иона Сіз оның кім екенін білесіз бе?
Dialogue: 0,1:23:59.76,1:24:01.70,Default,,0,0,0,,Мен Хииді түсінемін
Dialogue: 0,1:24:03.57,1:24:06.07,Default,,0,0,0,,Конгоу класындағы екінші кеме
Dialogue: 0,1:24:06.14,1:24:07.54,Default,,0,0,0,,Бұл әскери кеме ме?
Dialogue: 0,1:24:07.60,1:24:09.67,Default,,0,0,0,,Тағы екі кеме анықталды
Dialogue: 0,1:24:09.74,1:24:11.54,Default,,0,0,0,,Нагара жеңіл крейсері
Dialogue: 0,1:24:11.61,1:24:12.71,Default,,0,0,0,,Бұл Натори мен Юра!
Dialogue: 0,1:24:13.08,1:24:13.74,Default,,0,0,0,,Ха!
Dialogue: 0,1:24:13.81,1:24:15.75,Default,,0,0,0,,Байланыс желілеріне мәжбүрлі түрде араласу!
Dialogue: 0,1:24:16.08,1:24:17.31,Default,,0,0,0,,Бейне пайда болады!
Dialogue: 0,1:24:19.12,1:24:20.82,Default,,0,0,0,,Бірінші рет кездескенше.
Dialogue: 0,1:24:21.12,1:24:24.75,Default,,0,0,0,,Шығыс бірінші крейсер флоты қайта қаралды
Dialogue: 0,1:24:24.82,1:24:26.56,Default,,0,0,0,,Тұманды студенттік кеңестің төрағасы
Dialogue: 0,1:24:26.62,1:24:28.79,Default,,0,0,0,,Ұлы әскери кеме Хиэй
Dialogue: 0,1:24:29.06,1:24:29.73,Default,,0,0,0,,Иә?
Dialogue: 0,1:24:30.23,1:24:31.33,Default,,0,0,0,,Студенттік кеңес?
Dialogue: 0,1:24:31.66,1:24:33.56,Default,,0,0,0,,Сіздің сөздеріңізден
Dialogue: 0,1:24:33.63,1:24:37.50,Default,,0,0,0,,Мен ең қолайлы ұғымды алдым.
Dialogue: 0,1:24:37.60,1:24:40.14,Default,,0,0,0,,Автономия үшін тұманның қоғамдық моральдық тәртібін бұзатындар
Dialogue: 0,1:24:40.20,1:24:41.40,Default,,0,0,0,,Тазарту
Dialogue: 0,1:24:41.47,1:24:44.41,Default,,0,0,0,,Сіз оны партизандық күш деп санай аласыз.
Dialogue: 0,1:24:48.85,1:24:50.61,Default,,0,0,0,,Жақсы, I401
Dialogue: 0,1:24:51.41,1:24:54.25,Default,,0,0,0,,Студенттік кеңестің сізге айтары бар.
Dialogue: 0,1:24:54.32,1:24:56.69,Default,,0,0,0,,Студенттік кеңес бөлмесіне келіңіз.
Dialogue: 0,1:24:57.82,1:24:59.59,Default,,0,0,0,,Студенттік кеңес бөлмесі?
Dialogue: 0,1:24:59.66,1:25:02.79,Default,,0,0,0,,Сіз олардың тұжырымдамасын беру туралы айтасыз ба?
Dialogue: 0,1:25:03.13,1:25:05.73,Default,,0,0,0,,Тіпті тұман да оғаш сөздер айта бастады.
Dialogue: 0,1:25:05.80,1:25:07.56,Default,,0,0,0,,Бұл тұзақ па?
Dialogue: 0,1:25:07.63,1:25:08.87,Default,,0,0,0,,Менімен сөйлес
Dialogue: 0,1:25:09.37,1:25:10.23,Default,,0,0,0,,Ах!
Dialogue: 0,1:25:10.30,1:25:12.17,Default,,0,0,0,,Эй, жақсысың ба?
Dialogue: 0,1:25:12.24,1:25:13.30,Default,,0,0,0,,Жарайды
Dialogue: 0,1:25:13.37,1:25:14.47,Default,,0,0,0,,Кимоноым шаңмен кірленді.
Dialogue: 0,1:25:14.64,1:25:15.51,Default,,0,0,0,,Иә
Dialogue: 0,1:25:27.38,1:25:29.29,Default,,0,0,0,,Сіз қағуды ұмытып қалдыңыз.
Dialogue: 0,1:25:29.35,1:25:30.79,Default,,0,0,0,,Жаман мінез-құлық
Dialogue: 0,1:25:31.32,1:25:32.56,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:25:33.66,1:25:35.36,Default,,0,0,0,,L өліпті
Dialogue: 0,1:25:35.66,1:25:37.16,Default,,0,0,0,,Тұтқаны қойыңыз
Dialogue: 0,1:25:38.56,1:25:39.50,Default,,0,0,0,,♪ Ка-та-на
Dialogue: 0,1:25:39.73,1:25:43.40,Default,,0,0,0,,Мен сізді ойлауға шақыруым керек.
Dialogue: 0,1:25:43.47,1:25:44.33,Default,,0,0,0,,Рефлексия?
Dialogue: 0,1:25:44.70,1:25:46.37,Default,,0,0,0,,Сіздің істеріңіз қандай?
Dialogue: 0,1:25:46.44,1:25:50.14,Default,,0,0,0,,Бұл Адмиралтейлік кодексті бұзу болып табылады.
Dialogue: 0,1:25:50.34,1:25:51.57,Default,,0,0,0,,Қатты өкініш
Dialogue: 0,1:25:51.64,1:25:55.65,Default,,0,0,0,,Маған толық бақылауды дереу беріңіз
Dialogue: 0,1:25:55.91,1:25:58.31,Default,,0,0,0,,Мен не істедім
Dialogue: 0,1:25:58.38,1:26:00.18,Default,,0,0,0,,Бұл дұрыс емес пе?
Dialogue: 0,1:26:00.25,1:26:01.75,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,1:26:01.85,1:26:04.85,Default,,0,0,0,,Конгоу-саманы тәртіпке келтіріп, абыройлы етті
Dialogue: 0,1:26:05.66,1:26:08.63,Default,,0,0,0,,Сіздің бұрмаланған алгоритміңізге түсті
Dialogue: 0,1:26:08.69,1:26:10.89,Default,,0,0,0,,Қате орын алды.
Dialogue: 0,1:26:11.63,1:26:13.93,Default,,0,0,0,,Конгоу азап шекті.
Dialogue: 0,1:26:14.20,1:26:16.27,Default,,0,0,0,,Мен сені жалғыз қалдыра алмадым.
Dialogue: 0,1:26:16.57,1:26:20.34,Default,,0,0,0,,Конгоу-саманың қиналуына жол жоқ!
Dialogue: 0,1:26:20.74,1:26:23.31,Default,,0,0,0,,Сіз қару заңын ұмыттыңыз
Dialogue: 0,1:26:23.37,1:26:25.91,Default,,0,0,0,,Достық кемені еліктіру
Dialogue: 0,1:26:26.18,1:26:28.75,Default,,0,0,0,,Асыл Конгоу-саманы да жынды қылды.
Dialogue: 0,1:26:29.45,1:26:32.28,Default,,0,0,0,,Тұманның жел жағында тұра алмайтын сатқын
Dialogue: 0,1:26:32.58,1:26:33.48,Default,,0,0,0,,Жоқ
Dialogue: 0,1:26:33.55,1:26:34.88,Default,,0,0,0,,Менің сенімімді, махаббатымды арнаған барлығымды тартып алуға... тек бір рух қана, тағы қандай сұмдық!
Dialogue: 0,1:26:35.49,1:26:36.92,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,1:26:37.19,1:26:39.39,Default,,0,0,0,,Сізбен де бір-бірімізді түсінетінімізге сенімдімін.
Dialogue: 0,1:26:39.76,1:26:42.19,Default,,0,0,0,,Өзара түсіністік дегенді қалай түсінесіңдер?
Dialogue: 0,1:26:42.49,1:26:43.43,Default,,0,0,0,,Бұл...
Dialogue: 0,1:26:43.49,1:26:45.20,Default,,0,0,0,,Біз тұманбыз
Dialogue: 0,1:26:45.26,1:26:46.60,Default,,0,0,0,,Біз қарумыз
Dialogue: 0,1:26:46.96,1:26:51.40,Default,,0,0,0,,Бұл адмиралтейлік кодекстің адамзатқа тосқауыл қою бұйрығы.
Dialogue: 0,1:26:52.70,1:26:54.24,Default,,0,0,0,,...
Dialogue: 0,1:26:54.70,1:26:58.21,Default,,0,0,0,,Бұл команда не үшін қажет?
Dialogue: 0,1:26:59.51,1:27:03.21,Default,,0,0,0,,Бұл бізге кім болсаң бол деген бұйрық.
Dialogue: 0,1:27:03.68,1:27:05.45,Default,,0,0,0,,Сіз үшін...
Dialogue: 0,1:27:05.68,1:27:07.38,Default,,0,0,0,,Конгоу мырза...
Dialogue: 0,1:27:07.78,1:27:08.65,Default,,0,0,0,,Ах...
Dialogue: 0,1:27:09.32,1:27:11.55,Default,,0,0,0,,Лорд Конгу құлады.
Dialogue: 0,1:27:11.62,1:27:12.89,Default,,0,0,0,,Ұятты шайқас
Dialogue: 0,1:27:14.39,1:27:16.69,Default,,0,0,0,,Конго туралы жаман сөз айтпа!
Dialogue: 0,1:27:16.76,1:27:20.23,Default,,0,0,0,,Біз сіздің пікіріңізді сұрамаймыз!
Dialogue: 0,1:27:20.60,1:27:21.86,Default,,0,0,0,,Біржақты
Dialogue: 0,1:27:21.93,1:27:23.37,Default,,0,0,0,,Ережелер
Dialogue: 0,1:27:23.43,1:27:26.27,Default,,0,0,0,,Мен сенің айтқаныңды істемеймін
Dialogue: 0,1:27:26.34,1:27:27.00,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,1:27:27.54,1:27:28.74,Default,,0,0,0,,Маған
Dialogue: 0,1:27:29.31,1:27:30.61,Default,,0,0,0,,Өйткені ерік бар
Dialogue: 0,1:27:30.94,1:27:32.48,Default,,0,0,0,,(Юрико) Мен тек жұмыста жағдайың қалай екен деп сұрадым.
Dialogue: 0,1:27:32.58,1:27:34.51,Default,,0,0,0,,Сіз сәтсізсіз.
Dialogue: 0,1:27:34.58,1:27:38.51,Default,,0,0,0,,Тәубе ету ниетің болмаса, әңгіме осымен аяқталады.
Dialogue: 0,1:27:38.58,1:27:40.32,Default,,0,0,0,,Мен сізді осында батыруға рұқсат етіңіз
Dialogue: 0,1:27:40.38,1:27:42.62,Default,,0,0,0,,Тұманға тәртіпті қалпына келтіру
Dialogue: 0,1:27:42.82,1:27:43.95,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:27:45.26,1:27:47.59,Default,,0,0,0,,Барлық сызықтарды көпқабатты блоктау
Dialogue: 0,1:27:48.59,1:27:50.26,Default,,0,0,0,,Енді Чихая Гунзо және
Dialogue: 0,1:27:50.33,1:27:53.66,Default,,0,0,0,,Сіздің ойыңыздың ластануы мен үшін жұмыс істемейді.
Dialogue: 0,1:27:53.96,1:27:55.30,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:27:55.53,1:27:57.00,Default,,0,0,0,,Төмен түсіңіз
Dialogue: 0,1:27:57.73,1:27:58.60,Default,,0,0,0,,Ах!
Dialogue: 0,1:27:59.80,1:28:00.94,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:28:01.47,1:28:03.84,Default,,0,0,0,,Барлық байланыстар үзілді.
Dialogue: 0,1:28:03.91,1:28:05.88,Default,,0,0,0,,Бұл сіздің тыңдайтын құлағыңыз жоқ дегенді білдіре ме?
Dialogue: 0,1:28:05.94,1:28:09.58,Default,,0,0,0,,Тұман диалогтан қорқады.
Dialogue: 0,1:28:10.88,1:28:13.48,Default,,0,0,0,,Бұл су астындағы аңшылықтың басы.
Dialogue: 0,1:28:13.55,1:28:15.05,Default,,0,0,0,,Натори Юра
Dialogue: 0,1:28:15.32,1:28:18.42,Default,,0,0,0,,Менің алдымда 401 шығар!
Dialogue: 0,1:28:24.39,1:28:26.33,Default,,0,0,0,,Жоғары жылдамдықтағы қозғалтқыш дыбысы! Бұл торпедо!
Dialogue: 0,1:28:26.40,1:28:28.67,Default,,0,0,0,,Бірліктер саны 4! Танатоний реакциясы бар!
Dialogue: 0,1:28:28.73,1:28:30.07,Default,,0,0,0,,Сурет! (Кёхэй) Түсінікті!
Dialogue: 0,1:28:30.33,1:28:31.67,Default,,0,0,0,,Цуримге қарай 30
Dialogue: 0,1:28:31.73,1:28:33.47,Default,,0,0,0,,Кляйн өрісінің кеңеюі!
Dialogue: 0,1:28:42.81,1:28:45.88,Default,,0,0,0,,Натори бағытты 187-ге тез өзгертеді
Dialogue: 0,1:28:45.95,1:28:47.68,Default,,0,0,0,,Юра жылдамдығын 20 арттыру
Dialogue: 0,1:28:47.75,1:28:48.95,Default,,0,0,0,,265 курсқа ауысыңыз!
Dialogue: 0,1:28:49.52,1:28:52.36,Default,,0,0,0,,Сіз бұл кеменің алдыңғы және артқы жағын басып тастағыңыз келе ме?
Dialogue: 0,1:29:03.57,1:29:05.57,Default,,0,0,0,,Юра! Одан да жылдам!
Dialogue: 0,1:29:10.97,1:29:13.08,Default,,0,0,0,,Теңіз бетіне қонған судың көптеген дыбыстары!
Dialogue: 0,1:29:13.34,1:29:14.11,Default,,0,0,0,,Торпедо?
Dialogue: 0,1:29:14.38,1:29:16.51,Default,,0,0,0,,Жоқ, қозғаушы дыбыс жоқ.
Dialogue: 0,1:29:16.58,1:29:18.51,Default,,0,0,0,,Бұл... танатоний реакциясы ма?
Dialogue: 0,1:29:18.58,1:29:19.58,Default,,0,0,0,,Уау!
Dialogue: 0,1:29:24.65,1:29:26.02,Default,,0,0,0,,Бұл не!
Dialogue: 0,1:29:26.69,1:29:27.59,Default,,0,0,0,,Тереңдік зарядтары!
Dialogue: 0,1:29:27.72,1:29:28.59,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,1:29:28.66,1:29:30.76,Default,,0,0,0,,Мен тереңдік зарядымен бірінші рет соқтығысып отырмын!
Dialogue: 0,1:29:31.06,1:29:34.13,Default,,0,0,0,,Хиэй сүңгуір қайықтарға қарсы операцияларды жақсы зерттеді.
Dialogue: 0,1:29:34.40,1:29:36.63,Default,,0,0,0,,Клайнфилдке жүктеме артып келеді.
Dialogue: 0,1:29:36.87,1:29:38.84,Default,,0,0,0,,Ұзақ мерзімді шайқас бізге тиімсіз
Dialogue: 0,1:29:38.90,1:29:40.40,Default,,0,0,0,,Хей тездет!
Dialogue: 0,1:29:40.47,1:29:42.61,Default,,0,0,0,,3 саны 4 саны! Төмен жиілікті торпедалар!
Dialogue: 0,1:29:42.67,1:29:43.67,Default,,0,0,0,,Қалғанын сізге қалдырамын!
Dialogue: 0,1:29:44.14,1:29:45.94,Default,,0,0,0,,5 саны 6 саны! Белсенді алдау!
Dialogue: 0,1:29:46.01,1:29:48.41,Default,,0,0,0,,Төмен жиілікті торпедо 3 секунд жарылғаннан кейін өрт шығады!
Dialogue: 0,1:29:48.48,1:29:50.58,Default,,0,0,0,,3-6 Icer түтіктерін іске қосыңыз!
Dialogue: 0,1:29:50.78,1:29:52.62,Default,,0,0,0,,Iona decoy нұсқауларын сұраңыз
Dialogue: 0,1:29:52.68,1:29:54.92,Default,,0,0,0,,5 саны Юраға, 6 саны Наториге барады.
Dialogue: 0,1:29:54.98,1:29:56.82,Default,,0,0,0,,Алдаушы нұсқау Түсінді
Dialogue: 0,1:29:56.89,1:29:57.82,Default,,0,0,0,,Иори!
Dialogue: 0,1:29:57.89,1:30:00.59,Default,,0,0,0,,Кез келген уақытта аса ауырлық зеңбірегін атуға дайын болыңыз!
Dialogue: 0,1:30:01.59,1:30:02.99,Default,,0,0,0,,Иә, иә! Дайын!
Dialogue: 0,1:30:03.49,1:30:05.16,Default,,0,0,0,,3 саны 4 саны! атыс!
Dialogue: 0,1:30:13.77,1:30:15.10,Default,,0,0,0,,Еліктеу
Dialogue: 0,1:30:19.41,1:30:21.74,Default,,0,0,0,,Менің көңілім қалды 401
Dialogue: 0,1:30:21.81,1:30:25.45,Default,,0,0,0,,Сіз мені осындай нәрсемен соқыр еткіңіз келе ме?
Dialogue: 0,1:30:25.52,1:30:26.48,Default,,0,0,0,,Натори!
Dialogue: 0,1:30:26.68,1:30:28.05,Default,,0,0,0,,Natori Тікелей жоғарыда!
Dialogue: 0,1:30:28.12,1:30:29.09,Default,,0,0,0,,Қарсы емес!
Dialogue: 0,1:30:29.15,1:30:31.52,Default,,0,0,0,,Одан өтіп, Хиэйдің артына түсейік!
Dialogue: 0,1:30:37.49,1:30:38.19,Default,,0,0,0,,Ах!
Dialogue: 0,1:30:41.50,1:30:45.10,Default,,0,0,0,,Мен сіздің барлық ұрыс үлгілеріңізді оқып шықтым!
Dialogue: 0,1:30:45.57,1:30:47.74,Default,,0,0,0,,Екі тактика тең болса
Dialogue: 0,1:30:47.80,1:30:51.01,Default,,0,0,0,,Жоғары атыс күшімен жеңіске жетудің мағынасы бар.
Dialogue: 0,1:30:51.47,1:30:52.61,Default,,0,0,0,,Сүңгуір қайықтар және т.б.
Dialogue: 0,1:30:52.68,1:30:56.78,Default,,0,0,0,,Есіңізде болсын, біз жер үсті кемелерінің жауы емеспіз!
Dialogue: 0,1:31:04.69,1:31:06.86,Default,,0,0,0,,Екі белсенді айла да жойылды!
Dialogue: 0,1:31:06.92,1:31:07.79,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:31:07.86,1:31:10.59,Default,,0,0,0,,Артқы жақтан №2 эрозия торпедалары Юра!
Dialogue: 0,1:31:10.66,1:31:11.63,Default,,0,0,0,,Кесу!
Dialogue: 0,1:31:20.47,1:31:21.57,Default,,0,0,0,,(Айқай)
Dialogue: 0,1:31:21.64,1:31:23.87,Default,,0,0,0,,Қат! Бұл жігіт өте керемет!
Dialogue: 0,1:31:24.07,1:31:25.47,Default,,0,0,0,,Курс 350
Dialogue: 0,1:31:25.54,1:31:27.24,Default,,0,0,0,,Түсінген курс 350
Dialogue: 0,1:31:27.51,1:31:28.91,Default,,0,0,0,,Теңіз бетіне қонған судың көптеген дыбыстары!
Dialogue: 0,1:31:28.98,1:31:29.85,Default,,0,0,0,,Максималды қозғалтқыш!
Dialogue: 0,1:31:40.02,1:31:42.02,Default,,0,0,0,,Сіз менің қозғалыстарымды оқып жатырсыз.
Dialogue: 0,1:31:42.23,1:31:44.56,Default,,0,0,0,,Студенттік кеңес төрағасы күткендей!
Dialogue: 0,1:31:44.73,1:31:46.20,Default,,0,0,0,,Мен жақсы емес түрім~
Dialogue: 0,1:31:46.73,1:31:48.13,Default,,0,0,0,,Хии 210-дан
Dialogue: 0,1:31:48.20,1:31:49.73,Default,,0,0,0,,Рульді бұру!
Dialogue: 0,1:31:49.80,1:31:51.93,Default,,0,0,0,,Кёхэй! 4 төмен жиілікті торпедо
Dialogue: 0,1:31:52.00,1:31:53.70,Default,,0,0,0,,30 градус аралықпен өрт!
Dialogue: 0,1:31:58.57,1:32:00.04,Default,,0,0,0,,Күрес
Dialogue: 0,1:32:00.71,1:32:01.58,Default,,0,0,0,,Натори
Dialogue: 0,1:32:01.81,1:32:03.28,Default,,0,0,0,,401 басын ұстаңыз
Dialogue: 0,1:32:11.22,1:32:14.26,Default,,0,0,0,,Хиэдің бізді екі жеңіл крейсері тоқтатты.
Dialogue: 0,1:32:14.52,1:32:17.09,Default,,0,0,0,,Өте ауырлық зеңбірегі оны міндетті түрде аяқтайды.
Dialogue: 0,1:32:17.59,1:32:18.83,Default,,0,0,0,,Неліктен олай ойлайсың?
Dialogue: 0,1:32:18.90,1:32:21.83,Default,,0,0,0,,Егер мен студенттік кеңестің төрағасы болсам, солай істер едім.
Dialogue: 0,1:32:21.90,1:32:22.97,Default,,0,0,0,,180 курс!
Dialogue: 0,1:32:23.03,1:32:23.90,Default,,0,0,0,,Цурим 10 жоғары!
Dialogue: 0,1:32:24.53,1:32:26.87,Default,,0,0,0,,Хиэйдің ішінің астынан өт!
Dialogue: 0,1:32:31.14,1:32:33.18,Default,,0,0,0,,Ха! Мүмкін емес!
Dialogue: 0,1:32:36.71,1:32:37.95,Default,,0,0,0,,Жолда болыңыз!
Dialogue: 0,1:32:38.01,1:32:39.12,Default,,0,0,0,,Толық жылдамдық алға!
Dialogue: 0,1:32:47.12,1:32:49.03,Default,,0,0,0,,Сен менің астыма кіріп кеттің бе?
Dialogue: 0,1:32:49.23,1:32:51.63,Default,,0,0,0,,Иона! Супер гравитациялық зеңбірек күту режимінде!
Dialogue: 0,1:32:51.69,1:32:52.56,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:32:52.63,1:32:54.06,Default,,0,0,0,,Сидекки Менруддер!
Dialogue: 0,1:32:54.13,1:32:55.90,Default,,0,0,0,,Курс 350!
Dialogue: 0,1:33:09.78,1:33:10.65,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:33:13.65,1:33:15.08,Default,,0,0,0,,Маған...
Dialogue: 0,1:33:15.15,1:33:16.65,Default,,0,0,0,,Натори! Юра!
Dialogue: 0,1:33:25.96,1:33:27.26,Default,,0,0,0,,Жарайсыңдар! Мен ұстадым!
Dialogue: 0,1:33:27.33,1:33:29.30,Default,,0,0,0,,Ауыр гравитациялық зеңбірек Хиэйді осьте түсіреді!
Dialogue: 0,1:33:29.37,1:33:30.23,Default,,0,0,0,,Иори!
Dialogue: 0,1:33:30.30,1:33:32.74,Default,,0,0,0,,Кез келген уақытта! Бірақ мүмкіндігінше тезірек!
Dialogue: 0,1:33:32.80,1:33:34.24,Default,,0,0,0,,Кёхэй! (Кёхэ) Мен білемін!
Dialogue: 0,1:33:34.67,1:33:37.21,Default,,0,0,0,,Психикалық үлгілерге тікелей шабуыл жасаудан аулақ болыңыз, солай емес пе?
Dialogue: 0,1:33:38.01,1:33:40.11,Default,,0,0,0,,Hiei Жеңіл крейсер екі жақта да қозғалады.
Dialogue: 0,1:33:40.18,1:33:41.04,Default,,0,0,0,,Бетінде бір атмосфера.
Dialogue: 0,1:33:41.24,1:33:43.65,Default,,0,0,0,,Өте ауырлық зеңбірегі! Ат!
Dialogue: 0,1:33:46.35,1:33:49.72,Default,,0,0,0,,Мұндай мектеп тәртібін бұзуға жол берілмейді!
Dialogue: 0,1:34:03.77,1:34:04.63,Default,,0,0,0,,Уау!
Dialogue: 0,1:34:04.70,1:34:07.04,Default,,0,0,0,,Иона! Не болып жатыр?
Dialogue: 0,1:34:07.24,1:34:10.27,Default,,0,0,0,,Ауыр гравитациялық зеңбіректің энергиясы жойылуда!
Dialogue: 0,1:34:10.71,1:34:12.34,Default,,0,0,0,,Бұл шағылыстыру жүйесі
Dialogue: 0,1:34:12.41,1:34:16.15,Default,,0,0,0,,Тек супер шайқас сыныбын жабдықтауға болады.
Dialogue: 0,1:34:22.18,1:34:23.42,Default,,0,0,0,,(Айқай)
Dialogue: 0,1:34:37.13,1:34:38.00,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:34:38.83,1:34:42.14,Default,,0,0,0,,Айна жүйесін пайдалануға рұқсат ету дегенді қалай түсінесіңдер?
Dialogue: 0,1:34:47.78,1:34:50.81,Default,,0,0,0,,Айналаңызда мутант ғарыштық тосқауыл пайда болды.
Dialogue: 0,1:34:50.88,1:34:51.75,Default,,0,0,0,,Не?
Dialogue: 0,1:34:52.05,1:34:54.68,Default,,0,0,0,,Жергілікті симметрияның бұзылуы
Dialogue: 0,1:34:54.75,1:34:56.92,Default,,0,0,0,,Кейбір орындар бір өлшемді
Dialogue: 0,1:34:57.05,1:34:58.89,Default,,0,0,0,,Кейбір орындар 7-өлшемді
Dialogue: 0,1:34:58.95,1:35:01.96,Default,,0,0,0,,Әртүрлі өлшемдер патчтар сияқты бар
Dialogue: 0,1:35:02.16,1:35:04.43,Default,,0,0,0,,Қазіргі құбылысқа байланысты ма?
Dialogue: 0,1:35:04.69,1:35:05.36,Default,,0,0,0,,Гунзо!
Dialogue: 0,1:35:05.43,1:35:07.96,Default,,0,0,0,,Гравитон қозғалтқышы оғаш толқындар туғызуда.
Dialogue: 0,1:35:08.46,1:35:11.10,Default,,0,0,0,,Бұл аймақта мәңгі қалу қауіпті!
Dialogue: 0,1:35:11.40,1:35:13.47,Default,,0,0,0,,Ей, кетпесек жаман болмай ма?
Dialogue: 0,1:35:17.07,1:35:18.17,Default,,0,0,0,,Иона! Жақын болыңыз!
Dialogue: 0,1:35:18.31,1:35:19.18,Default,,0,0,0,,Иә?
Dialogue: 0,1:35:32.39,1:35:33.26,Default,,0,0,0,,Ха!
Dialogue: 0,1:35:46.74,1:35:48.80,Default,,0,0,0,,Сәлем! Тыңдаңыз!
Dialogue: 0,1:35:50.24,1:35:52.84,Default,,0,0,0,,Неліктен адамдар өзін-өзі көрсетеді?
Dialogue: 0,1:35:53.14,1:35:54.98,Default,,0,0,0,,Мені тыңда.
Dialogue: 0,1:35:55.04,1:35:57.91,Default,,0,0,0,,Біз сенімен ұрысқымыз келмейді!
Dialogue: 0,1:35:59.32,1:36:03.79,Default,,0,0,0,,Теңізге шыққанша, тұман саған шабуыл жасайды.
Dialogue: 0,1:36:03.85,1:36:04.95,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,1:36:05.02,1:36:08.22,Default,,0,0,0,,Өйткені бұл Адмиралтейлік кодекстің тәртібі.
Dialogue: 0,1:36:08.32,1:36:10.86,Default,,0,0,0,,Ережеге бағынбағандар – зұлым.
Dialogue: 0,1:36:10.93,1:36:13.16,Default,,0,0,0,,Сізде ешқашан күмән жоқ па?
Dialogue: 0,1:36:13.23,1:36:16.93,Default,,0,0,0,,Менің ойымша, сіз өз бетіңізше ойлануыңыз керек нәрселер бар!
Dialogue: 0,1:36:17.23,1:36:20.20,Default,,0,0,0,,Бұл ережені сақтамайтын жаман мақсат!
Dialogue: 0,1:36:20.94,1:36:21.87,Default,,0,0,0,,Өйткені тәртіп бар
Dialogue: 0,1:36:21.94,1:36:24.54,Default,,0,0,0,,Біз өзіміз бола аламыз!
Dialogue: 0,1:36:25.84,1:36:27.04,Default,,0,0,0,,Қандай түзу адам!
Dialogue: 0,1:36:27.48,1:36:30.05,Default,,0,0,0,,Бұл Конгодан да қиын!
Dialogue: 0,1:36:30.25,1:36:32.18,Default,,0,0,0,,Бір-бірімізді түсіне алмаймыз ба?
Dialogue: 0,1:36:32.25,1:36:35.45,Default,,0,0,0,,Болашақты бірге ойлау жаман ба?
Dialogue: 0,1:36:35.95,1:36:36.89,Default,,0,0,0,,Болашақ?
Dialogue: 0,1:36:36.95,1:36:39.02,Default,,0,0,0,,Сіз ұрыс жағдайын болжау дейсіз бе?
Dialogue: 0,1:36:39.09,1:36:40.42,Default,,0,0,0,,Бұл емес!
Dialogue: 0,1:36:40.86,1:36:43.99,Default,,0,0,0,,Бұдан былай біз не боламыз?
Dialogue: 0,1:36:44.06,1:36:46.13,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,1:36:46.46,1:36:48.23,Default,,0,0,0,,Ах...
Dialogue: 0,1:36:49.23,1:36:50.90,Default,,0,0,0,,Неліктен біз
Dialogue: 0,1:36:51.57,1:36:53.97,Default,,0,0,0,,Сіз не үшін дүниеге келдіңіз?
Dialogue: 0,1:36:56.04,1:36:57.04,Default,,0,0,0,,Барлығына!
Dialogue: 0,1:36:57.34,1:37:00.11,Default,,0,0,0,,Мен бақытты болу үшін жаралғанмын!
Dialogue: 0,1:37:00.51,1:37:03.18,Default,,0,0,0,,Қанша қиын көрінсе де
Dialogue: 0,1:37:03.48,1:37:06.88,Default,,0,0,0,,Егер сіз алға жылжымасаңыз, сіз ештеңе алмайсыз!
Dialogue: 0,1:37:06.98,1:37:08.12,Default,,0,0,0,,Бақыт!
Dialogue: 0,1:37:08.48,1:37:10.52,Default,,0,0,0,,Сондықтан алға ұмтыл!
Dialogue: 0,1:37:10.59,1:37:12.12,Default,,0,0,0,,Не болды?
Dialogue: 0,1:37:16.13,1:37:17.49,Default,,0,0,0,,Бақыттысың ба?
Dialogue: 0,1:37:18.03,1:37:19.03,Default,,0,0,0,,Ха...
Dialogue: 0,1:37:19.36,1:37:20.23,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,1:37:20.90,1:37:22.40,Default,,0,0,0,,Кеш болды.
Dialogue: 0,1:37:24.03,1:37:25.40,Default,,0,0,0,,Ах! Бұл...
Dialogue: 0,1:37:25.47,1:37:26.47,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,1:37:26.54,1:37:29.34,Default,,0,0,0,,Әрбір арнаға кедергі жасайтын радиотолқындар бар.
Dialogue: 0,1:37:29.57,1:37:31.44,Default,,0,0,0,,Байланыс үзілді ме?
Dialogue: 0,1:37:31.51,1:37:32.61,Default,,0,0,0,,Бұл...
Dialogue: 0,1:37:32.88,1:37:33.54,Default,,0,0,0,,Ах!
Dialogue: 0,1:37:35.04,1:37:37.15,Default,,0,0,0,,Әскери шептерге күштеп араласу!
Dialogue: 0,1:37:38.08,1:37:40.28,Default,,0,0,0,,Тұман кептелісі жойылды!
Dialogue: 0,1:37:51.46,1:37:54.00,Default,,0,0,0,,Азаматтық жиіліктер де қолданылады!
Dialogue: 0,1:37:54.33,1:37:55.93,Default,,0,0,0,,Радио ұясы!
Dialogue: 0,1:38:20.39,1:38:21.96,Default,,0,0,0,,Хаа…
Dialogue: 0,1:38:22.02,1:38:25.16,Default,,0,0,0,,Неліктен бұлай көріндің?
Dialogue: 0,1:38:25.56,1:38:28.20,Default,,0,0,0,,Адамдардың әлеуметтік тактикасы
Dialogue: 0,1:38:28.26,1:38:30.37,Default,,0,0,0,,Бұл автономия деп аталады.
Dialogue: 0,1:38:30.57,1:38:33.50,Default,,0,0,0,,Иә? Адамға еліктеу?
Dialogue: 0,1:38:33.57,1:38:35.04,Default,,0,0,0,,Боу!
Dialogue: 0,1:38:35.17,1:38:36.27,Default,,0,0,0,,Бұл жақсы, жақсы!
Dialogue: 0,1:38:36.51,1:38:38.04,Default,,0,0,0,,Көңілді болыңыз!
Dialogue: 0,1:38:38.11,1:38:40.48,Default,,0,0,0,,Жүр, тез соғысты бастаймыз!
Dialogue: 0,1:38:40.98,1:38:42.21,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,1:38:42.28,1:38:44.61,Default,,0,0,0,,Қараңызшы, сіз осындасыз.
Dialogue: 0,1:38:45.31,1:38:46.32,Default,,0,0,0,,Бұл бітсе, бірдеңе жейміз бе? Егер қаласаң, көңіліңді көтерейін.
Dialogue: 0,1:39:10.44,1:39:12.27,Default,,0,0,0,,Психикалық үлгі!
Dialogue: 0,1:39:13.14,1:39:14.31,Default,,0,0,0,,Чочочо!
Dialogue: 0,1:39:14.44,1:39:16.18,Default,,0,0,0,,Супер шайқас!
Dialogue: 0,1:39:17.41,1:39:18.55,Default,,0,0,0,,Бұл...
Dialogue: 0,1:39:20.02,1:39:23.09,Default,,0,0,0,,Құрметті адамзат, танысқаныма қуаныштымын.
Dialogue: 0,1:39:23.15,1:39:26.96,Default,,0,0,0,,Мен тұман флотымын, «Мусаши» супер боевикмін
Dialogue: 0,1:39:27.19,1:39:28.72,Default,,0,0,0,,Бүгін барлығына
Dialogue: 0,1:39:29.02,1:39:30.46,Default,,0,0,0,,Жалпы флагмандық Ямато-дан
Dialogue: 0,1:39:30.53,1:39:33.26,Default,,0,0,0,,Маңызды оқиғаны айтып беру
Dialogue: 0,1:39:33.36,1:39:36.37,Default,,0,0,0,,Ажыратылған желі қалпына келтірілді.
Dialogue: 0,1:39:37.00,1:39:40.14,Default,,0,0,0,,Таң қалмай тыңдайсыздар деп ойлаймын.
Dialogue: 0,1:39:40.20,1:39:41.54,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:39:43.04,1:39:44.34,Default,,0,0,0,,(Баяндау) ДжоДжо мен оның серіктері қасиетті Бенгалур қаласына автобуспен бара жатты.
Dialogue: 0,1:39:50.55,1:39:51.75,Default,,0,0,0,,
Dialogue: 0,1:39:52.58,1:39:53.98,Default,,0,0,0,,Чихая...
Dialogue: 0,1:39:54.58,1:39:55.98,Default,,0,0,0,,Шо мүсіні…
Dialogue: 0,1:39:56.29,1:39:58.39,Default,,0,0,0,,Ол Гунцоның әкесі!
Dialogue: 0,1:40:02.69,1:40:04.09,Default,,0,0,0,,Топтық сурет?
Dialogue: 0,1:40:12.53,1:40:13.64,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:40:14.17,1:40:15.27,Default,,0,0,0,,Гунзо!
Dialogue: 0,1:40:18.64,1:40:23.55,Default,,0,0,0,,Біз, Тұманға қарсы флот, осы арқылы сізге бүгін хабарлаймыз.
Dialogue: 0,1:40:26.65,1:40:27.78,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,1:40:28.55,1:40:30.15,Default,,0,0,0,,Адамзатқа
Dialogue: 0,1:40:30.62,1:40:33.02,Default,,0,0,0,,Беру туралы ұсыныс
Dialogue: 0,1:40:52.07,1:40:58.08,Default,,0,0,0,,♪~
Dialogue: 0,1:44:57.72,1:45:03.73,Default,,0,0,0,,~♪
Dialogue: 0,1:45:05.23,1:45:11.23,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory