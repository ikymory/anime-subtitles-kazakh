Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Қатардағы Кибогамин Гакуэн
Dialogue: 0,0:00:06.04,0:00:09.04,Default,,0,0,0,,Бұл мектеп үміт мектебі емес еді.
Dialogue: 0,0:00:10.04,0:00:12.01,Default,,0,0,0,,Бұл үмітсіздік мектебі болды.
Dialogue: 0,0:00:13.00,0:00:15.01,Default,,0,0,0,,Бұл жерден бітіру үшін бір ғана ереже бар.
Dialogue: 0,0:00:16.01,0:00:18.07,Default,,0,0,0,,Біреуді ешкім білмей өлтіру
Dialogue: 0,0:00:26.00,0:00:27.08,Default,,0,0,0,,Шындық алысқа сырғып барады
Dialogue: 0,0:00:27.09,0:00:29.08,Default,,0,0,0,,Көркем әдебиет жанды, біз оны ойнай бастаймыз
Dialogue: 0,0:00:29.08,0:00:31.06,Default,,0,0,0,,Үміт енді жоқ, жабық есік артында
Dialogue: 0,0:00:31.06,0:00:33.04,Default,,0,0,0,,Біз бұрын болған жерден алыстап бара жатқанда
Dialogue: 0,0:00:33.07,0:00:35.04,Default,,0,0,0,,Үміт пен үмітсіздік біртұтас болады
Dialogue: 0,0:00:35.05,0:00:37.04,Default,,0,0,0,,Мұның бәрі мағынасыз, біз қазірдің өзінде бастадық
Dialogue: 0,0:00:37.04,0:00:39.03,Default,,0,0,0,,иә, біз бәріміз бірміз
Dialogue: 0,0:00:39.03,0:00:41.02,Default,,0,0,0,,Ешқашан қарама-қарсы емес, біз бір ойынды ойнаймыз
Dialogue: 0,0:00:41.02,0:00:43.00,Default,,0,0,0,,Үміт пен үмітсіздік арасындағы жіңішке сызықтан өтіңіз
Dialogue: 0,0:00:43.00,0:00:44.09,Default,,0,0,0,,Шындықтан қашу, бірақ ол қазірдің өзінде бар
Dialogue: 0,0:00:44.09,0:00:46.08,Default,,0,0,0,,Қанша өтірік айтты, Мені таба алар ма білмеймін
Dialogue: 0,0:00:46.08,0:00:48.08,Default,,0,0,0,,Өмір сүру үшін бір ғана өмір, сондықтан ақылмен таңда
Dialogue: 0,0:00:48.09,0:00:50.05,Default,,0,0,0,,Бастар немесе құйрықтар, сіз өз жағыңызды білесіз бе?
Dialogue: 0,0:00:50.05,0:00:52.04,Default,,0,0,0,,Оның бір тиында болғаны маңызды емес
Dialogue: 0,0:00:52.06,0:00:54.02,Default,,0,0,0,,Егер сіз қол жеткізгіңіз келсе, сенуіңіз керек
Dialogue: 0,0:00:54.02,0:00:56.02,Default,,0,0,0,,Дәл қазір қосулы, міне, есік кілт
Dialogue: 0,0:00:55.09,0:00:59.07,Default,,0,0,0,,Ізденіс өте ұзақ, біз оны жоғалтып жібердік
Dialogue: 0,0:00:59.09,0:01:03.02,Default,,0,0,0,,Үміттен асқан үміт сәулесі бар
Dialogue: 0,0:01:03.06,0:01:08.02,Default,,0,0,0,,Жүр, шындықты ізде
Dialogue: 0,0:01:08.03,0:01:10.02,Default,,0,0,0,,Бұл дүниеде
Dialogue: 0,0:01:11.00,0:01:14.08,Default,,0,0,0,,Шатасудан өтіп, шешуін табыңыз
Dialogue: 0,0:01:14.09,0:01:18.04,Default,,0,0,0,,Бұрылған зұлымдықты жеңу
Dialogue: 0,0:01:18.06,0:01:22.02,Default,,0,0,0,,Тек мұны істе, соған ұмтыл
Dialogue: 0,0:01:22.03,0:01:25.03,Default,,0,0,0,,Ешқашан...
Dialogue: 0,0:01:26.01,0:01:29.07,Default,,0,0,0,,Шатасудан өтіп, шешуін табыңыз
Dialogue: 0,0:01:29.09,0:01:33.04,Default,,0,0,0,,Бұралған зұлымдықты жеңу
Dialogue: 0,0:01:33.06,0:01:37.02,Default,,0,0,0,,Тек мұны істе, соған ұмтыл
Dialogue: 0,0:01:37.03,0:01:41.01,Default,,0,0,0,,Ешқашан...
Dialogue: 0,0:01:58.09,0:02:01.09,Default,,0,0,0,,:& :&°
Dialogue: 0,0:02:01.09,0:02:04.09,Default,,0,0,0,,:& : :
Dialogue: 0,0:02:10.07,0:02:13.05,Default,,0,0,0,,Монокума академиясының директорының хабарламасы
Dialogue: 0,0:02:13.09,0:02:17.09,Default,,0,0,0,,Бөлме душ бөлмесімен жабдықталған.
Dialogue: 0,0:02:18.01,0:02:21.09,Default,,0,0,0,,Түнде су болмайтынын ескеріңіз.
Dialogue: 0,0:02:22.02,0:02:24.07,Default,,0,0,0,,Мен түнде душты пайдалана алмаймын ба?
Dialogue: 0,0:02:24.09,0:02:30.04,Default,,0,0,0,,Сондай-ақ, тек қыздар бөлмесінде құлыпталатын душ бөлмесі бар.
Dialogue: 0,0:02:30.09,0:02:35.02,Default,,0,0,0,,Соңында мен сендерге шағын сыйлық дайындап қойдым.
Dialogue: 0,0:02:35.06,0:02:39.05,Default,,0,0,0,,Шығармашылықпен ләззат алайық
Dialogue: 0,0:02:46.01,0:02:49.04,Default,,0,0,0,,Мынаны да, мынаны да қару ретінде қолдануға болады дейсің бе?
Dialogue: 0,0:02:55.06,0:02:57.01,Default,,0,0,0,,Душ қабылдаңыз
Dialogue: 0,0:02:59.08,0:03:00.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:01.03,0:03:02.07,Default,,0,0,0,,Бұл... не?
Dialogue: 0,0:03:03.05,0:03:05.02,Default,,0,0,0,,Қызық, ол құлыптаулы ма?
Dialogue: 0,0:03:06.05,0:03:08.03,Default,,0,0,0,,Бұл кілт емес
Dialogue: 0,0:03:09.08,0:03:10.05,Default,,0,0,0,,Юкине, сонда ісіңді бітірген соң дүкенге қара.
Dialogue: 0,0:03:10.05,0:03:12.02,Default,,0,0,0,,Сен соншалықты бейқамсың.
Dialogue: 0,0:03:12.05,0:03:16.04,Default,,0,0,0,,Бөлмені ішінен дұрыс құлыптау керек.
Dialogue: 0,0:03:17.00,0:03:18.05,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:03:18.08,0:03:21.01,Default,,0,0,0,,Неги-кун, бұл өте керемет.
Dialogue: 0,0:03:21.03,0:03:27.01,Default,,0,0,0,,Негізі сіздің душ бөлмеңіздің есігі нашар орнатылғаны белгілі болды.
Dialogue: 0,0:03:27.04,0:03:27.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:28.03,0:03:33.09,Default,,0,0,0,,Есіктің тұтқасын бұрап, ашу үшін жоғары көтеріңіз.
Dialogue: 0,0:03:34.02,0:03:35.00,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:03:37.02,0:03:41.08,Default,,0,0,0,,Бір қызық, сіздің бөлмеңіздің есігі нашар салынған жалғыз есік.
Dialogue: 0,0:03:42.02,0:03:43.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:43.02,0:03:47.02,Default,,0,0,0,,Өйткені сіз «өте жоғары мектептегі бақыттысыз», солай емес пе?
Dialogue: 0,0:03:47.04,0:03:50.09,Default,,0,0,0,,Дегенмен, ол мүлдем жұмыс істемейді.
Dialogue: 0,0:03:53.01,0:03:54.02,Default,,0,0,0,,Жұмыс істеді
Dialogue: 0,0:03:54.07,0:03:56.07,Default,,0,0,0,,Онда мен үйге барамын.
Dialogue: 0,0:03:57.00,0:04:01.02,Default,,0,0,0,,Наги-кун, есікті құлыптауда абай бол.
Dialogue: 0,0:04:07.02,0:04:11.09,Default,,0,0,0,,Бұл қандай «Супер орта мектептегі сәттілік»?
Dialogue: 0,0:04:16.01,0:04:16.51,Default,,0,0,0,,Иә
Dialogue: 0,0:04:17.00,0:04:19.04,Default,,0,0,0,,А... бұл Майзоно.
Dialogue: 0,0:04:19.07,0:04:20.06,Default,,0,0,0,,Майзоно мырза?
Dialogue: 0,0:04:24.03,0:04:25.03,Default,,0,0,0,,Наэги-кун...
Dialogue: 0,0:04:27.03,0:04:30.06,Default,,0,0,0,,Мм, бұл сағатта не болып жатыр?
Dialogue: 0,0:04:31.08,0:04:33.08,Default,,0,0,0,,Біртүрлі нәрсе болды.
Dialogue: 0,0:04:34.01,0:04:34.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:35.01,0:04:39.01,Default,,0,0,0,,Дәл қазір менің бөлмемнің есігі кенет дірілдей бастады.
Dialogue: 0,0:04:40.02,0:04:43.00,Default,,0,0,0,,Есікті біреу күштеп ашпақ болған сияқты.
Dialogue: 0,0:04:44.00,0:04:45.06,Default,,0,0,0,,Бұл Монокума емес пе?
Dialogue: 0,0:04:46.07,0:04:49.02,Default,,0,0,0,,Мен есікті ашып, тексердім.
Dialogue: 0,0:04:50.00,0:04:51.06,Default,,0,0,0,,Ешкім болған жоқ
Dialogue: 0,0:04:52.04,0:04:55.02,Default,,0,0,0,,Монокума болмаса, онда ол кім?
Dialogue: 0,0:04:56.00,0:04:58.03,Default,,0,0,0,,Бұл менің ешкімге күмәнданғаным емес.
Dialogue: 0,0:04:58.07,0:05:00.05,Default,,0,0,0,,Бірақ мен аздап қорқамын
Dialogue: 0,0:05:01.05,0:05:05.03,Default,,0,0,0,,Жарайды, түнде далаға шығуға болмайды.
Dialogue: 0,0:05:05.06,0:05:07.09,Default,,0,0,0,,Бірақ бұл жай ғана ауызша уәде, солай емес пе?
Dialogue: 0,0:05:08.07,0:05:10.09,Default,,0,0,0,,Біреу уәдесін бұзса ше?
Dialogue: 0,0:05:11.04,0:05:15.01,Default,,0,0,0,,Олай болса, бүгін кешке менің бөлмемде қалсаң қалай болады?
Dialogue: 0,0:05:15.03,0:05:17.03,Default,,0,0,0,,Сонда сіз қорықпайсыз.
Dialogue: 0,0:05:17.06,0:05:18.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:19.00,0:05:23.05,Default,,0,0,0,,Мектеп ережесінде тек жеке бөлмеде жату керек деп жазылған, солай ма?
Dialogue: 0,0:05:24.01,0:05:27.01,Default,,0,0,0,,Бізге тіпті кімнің қай жеке бөлмеде жату керектігін айтқан жоқ.
Dialogue: 0,0:05:27.07,0:05:32.01,Default,,0,0,0,,Бірақ...бірақ бір бөлмеде жалғыз болу...
Dialogue: 0,0:05:33.05,0:05:34.07,Default,,0,0,0,,Кешіріңіз, мен мұны байқамадым.
Dialogue: 0,0:05:35.05,0:05:38.03,Default,,0,0,0,,Бұл рас, тентектік сезіледі, бірақ...
Dialogue: 0,0:05:38.00,0:05:42.05,Default,,0,0,0,,Жоқ, бұл маған да ұнамайды.
Dialogue: 0,0:05:43.00,0:05:47.03,Default,,0,0,0,,Мм, қарсы болмасаң, бір түнге бөлме ауыстыра аласың ба?
Dialogue: 0,0:05:47.07,0:05:49.01,Default,,0,0,0,,Бөлмелерді ауыстыру?
Dialogue: 0,0:05:49.04,0:05:53.00,Default,,0,0,0,,Ух...иә, егер бұл Майзононы еркін сезінсе.
Dialogue: 0,0:05:53.04,0:05:55.00,Default,,0,0,0,,Мен қарсы емеспін
Dialogue: 0,0:05:55.03,0:05:58.09,Default,,0,0,0,,Бірақ... Меніңше, әртүрлі мәселелер бар.
Dialogue: 0,0:06:00.05,0:06:03.01,Default,,0,0,0,,Себебі мен Наэгикунға сенемін.
Dialogue: 0,0:06:03.05,0:06:06.01,Default,,0,0,0,,А...ммм, дұрыс.
Dialogue: 0,0:06:06.08,0:06:09.06,Default,,0,0,0,,Бұл душ бөлмесінің есігі нашар салынған.
Dialogue: 0,0:06:10.01,0:06:11.03,Default,,0,0,0,,Мұның бір айласы бар, солай ма?
Dialogue: 0,0:06:16.04,0:06:18.08,Default,,0,0,0,,Иә... бұл мектеп хабары.
Dialogue: 0,0:06:19.00,0:06:21.01,Default,,0,0,0,,Түскі сағат он
Dialogue: 0,0:06:21.03,0:06:25.00,Default,,0,0,0,,Қазір түн.
Dialogue: 0,0:06:22.03,0:06:25.01,Default,,0,0,0,,Мен оның Наэгикун екенін білсем де, оны ешқашан ашпас едім.
Dialogue: 0,0:06:25.01,0:06:29.02,Default,,0,0,0,,Жақында асхананың есігі құлыпталады. Әйтпесе, бөлме айырбастаудың мәні жоқ.
Dialogue: 0,0:06:29.04,0:06:31.06,Default,,0,0,0,,Кіруге рұқсат жоқ
Dialogue: 0,0:06:32.00,0:06:37.02,Default,,0,0,0,,Олай болса, тәтті армандар, қайырлы түн.
Dialogue: 0,0:06:38.01,0:06:40.00,Default,,0,0,0,,Бұл Майзоно-санның бөлмесі...
Dialogue: 0,0:06:41.00,0:06:43.00,Default,,0,0,0,,Ол онша ерекшеленбейді.
Dialogue: 0,0:06:46.05,0:06:48.08,Default,,0,0,0,,Мен қобалжыдым.
Dialogue: 0,0:06:55.00,0:06:57.04,Default,,0,0,0,,Мен Майзоно-санды қолдауым керек.
Dialogue: 0,0:07:10.01,0:07:12.08,Default,,0,0,0,,Баршаңызға қайырлы таң.
Dialogue: 0,0:07:13.00,0:07:16.01,Default,,0,0,0,,Таң атты. Сағат жеті.
Dialogue: 0,0:07:16.02,0:07:18.01,Default,,0,0,0,,Оянатын уақыт келді.
Dialogue: 0,0:07:18.04,0:07:21.05,Default,,0,0,0,,Олай болса, бүгін де барымызды салайық.
Dialogue: 0,0:07:22.03,0:07:26.06,Default,,0,0,0,,Түсіндім, мен Майзоно-санның бөлмесінде ұйықтадым.
Dialogue: 0,0:07:27.09,0:07:31.01,Default,,0,0,0,,Барлығы бірге таңғы ас ішеді деп келісілді.
Dialogue: 0,0:07:31.08,0:07:34.00,Default,,0,0,0,,Әйтпесе, бәрі уайымдайтын еді.
Dialogue: 0,0:07:33.09,0:07:35.02,Default,,0,0,0,,Аа, көшет.
Dialogue: 0,0:07:35.05,0:07:37.04,Default,,0,0,0,,Қайырлы таң, Негикун
Dialogue: 0,0:07:37.07,0:07:38.04,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:07:39.01,0:07:44.02,Default,,0,0,0,,Олардың барлығы басынан бірге болды және оларды қарапайым орта мектеп оқушылары ретінде жіктеуге болады.
Dialogue: 0,0:07:45.00,0:07:48.08,Default,,0,0,0,,Чис Уақытты сезінбейтін адамдар
Dialogue: 0,0:07:49.01,0:07:52.00,Default,,0,0,0,,Кешіріңіз, макияжымды жағуға көп уақыт кетті. Жоғары сынып оқушыларының көпшілігі осы санатқа жатады.
Dialogue: 0,0:07:52.09,0:07:54.03,Default,,0,0,0,,Джунко Эношима
Dialogue: 0,0:07:54.05,0:07:55.02,Default,,0,0,0,,Не болды, апа?
Dialogue: 0,0:07:55.09,0:08:00.04,Default,,0,0,0,,Кешіріңіз, бірақ менің алған әсерім журналда көргеннен сәл өзгешелеу сияқты.
Dialogue: 0,0:08:01.09,0:08:04.05,Default,,0,0,0,,Бұл журналдарға арналған.
Dialogue: 0,0:08:04.07,0:08:07.00,Default,,0,0,0,,Суретті өңдеуге арналған бағдарламалық құрал Сіз білесіз бе?
Dialogue: 0,0:08:07.04,0:08:08.04,Default,,0,0,0,,Хмм, не?
Dialogue: 0,0:08:08.08,0:08:11.01,Default,,0,0,0,,Мұндай нәрсеге таң қалмаңыз.
Dialogue: 0,0:08:11.03,0:08:13.01,Default,,0,0,0,,...Ол аздап қисық.
Dialogue: 0,0:08:13.04,0:08:18.00,Default,,0,0,0,,Ақырында, адамдарды ұзақ күттірген соң, ақыры келеді.
Dialogue: 0,0:08:14.00,0:08:14.50,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:08:15.05,0:08:17.02,Default,,0,0,0,,Барлығыңыз, асығыңыздар!
Dialogue: 0,0:08:18.00,0:08:22.07,Default,,0,0,0,,Қайырлы таң Олар уақытты, тіпті басқа адамдарды да ойламайтын өз бетінше жүретін адамдар.
Dialogue: 0,0:08:19.08,0:08:22.07,Default,,0,0,0,,Не... кешіккеннің несі айып?
Dialogue: 0,0:08:23.05,0:08:26.07,Default,,0,0,0,,Ұйықтамадым, адасып қалдым.
Dialogue: 0,0:08:27.01,0:08:29.08,Default,,0,0,0,,Негізінде бұл Бермуд үшбұрышының жұмысы.
Dialogue: 0,0:08:30.01,0:08:32.09,Default,,0,0,0,,Иә? Бізде әлі бәрі жоқ.
Dialogue: 0,0:08:33.03,0:08:35.06,Default,,0,0,0,,Майзоно-чан мен Тогами келмеді.
Dialogue: 0,0:08:35.08,0:08:36.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:38.03,0:08:39.07,Default,,0,0,0,,Ах Тогами
Dialogue: 0,0:08:40.03,0:08:42.09,Default,,0,0,0,,Әй, шырағым, сен Майзононы көрмедің бе?
Dialogue: 0,0:08:43.05,0:08:45.03,Default,,0,0,0,,Менің білуім мүмкін емес
Dialogue: 0,0:08:45.06,0:08:48.00,Default,,0,0,0,,Мен жаңа ғана бөлмемнен келдім.
Dialogue: 0,0:08:48.02,0:08:52.01,Default,,0,0,0,,Саяка Майзононың кешігуі ерекше.
Dialogue: 0,0:08:52.01,0:08:53.09,Default,,0,0,0,,Өзіңізді нашар сезінесіз бе?
Dialogue: 0,0:08:55.02,0:08:57.01,Default,,0,0,0,,А? Не болды, Неги-ччи?
Dialogue: 0,0:08:57.04,0:08:59.08,Default,,0,0,0,,А, мен сені тексеремін.
Dialogue: 0,0:09:02.08,0:09:03.08,Default,,0,0,0,,Майзоно мырза!
Dialogue: 0,0:09:05.07,0:09:07.06,Default,,0,0,0,,Кілт... бос.
Dialogue: 0,0:09:18.09,0:09:20.06,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:55.04,0:09:57.04,Default,,0,0,0,,Мұнда… мұнда…
Dialogue: 0,0:09:58.05,0:09:59.04,Default,,0,0,0,,Гимназия
Dialogue: 0,0:09:59.07,0:10:02.06,Default,,0,0,0,,Наэги мен бөлмемде есінен танып қалдым.
Dialogue: 0,0:10:03.01,0:10:05.03,Default,,0,0,0,,Огами-сан мен үшін алып жүрді.
Dialogue: 0,0:10:05.09,0:10:07.08,Default,,0,0,0,,Бұл арман емес...
Dialogue: 0,0:10:09.00,0:10:09.50,Default,,0,0,0,,Майзоно ше?
Dialogue: 0,0:10:12.04,0:10:15.01,Default,,0,0,0,,Саяка Майзоно қайтыс болды
Dialogue: 0,0:10:20.05,0:10:21.06,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:10:21.08,0:10:25.02,Default,,0,0,0,,Шешілген болуы керек, Майзоно-сан, Майзоно-сан...
Dialogue: 0,0:10:25.03,0:10:27.06,Default,,0,0,0,,Күт, сабыр ет, Наэгикун...
Dialogue: 0,0:10:27.02,0:10:29.07,Default,,0,0,0,,Жоқ, мен барамын Мен мұқият тексердім.
Dialogue: 0,0:10:30.00,0:10:32.07,Default,,0,0,0,,Саяка Майзоно өлгені анық
Dialogue: 0,0:10:33.02,0:10:36.03,Default,,0,0,0,,Олай болса бұл жерде қалудың не керегі бар?
Dialogue: 0,0:10:37.00,0:10:40.02,Default,,0,0,0,,Неліктен біз осындай уақытта гимназияға жиналдық?
Dialogue: 0,0:10:40.05,0:10:43.04,Default,,0,0,0,,Біз де мұндай жерде болғымыз келмейді.
Dialogue: 0,0:10:43.08,0:10:45.01,Default,,0,0,0,,Сонда неге?
Dialogue: 0,0:10:45.04,0:10:47.03,Default,,0,0,0,,Цк... шешілді.
Dialogue: 0,0:10:47.05,0:10:48.05,Default,,0,0,0,,Монокума
Dialogue: 0,0:10:48.09,0:10:51.03,Default,,0,0,0,,А... спортзалға жиналуымызды өтінді.
Dialogue: 0,0:10:51.09,0:10:54.00,Default,,0,0,0,,Әрине, біз де қарсы болдық.
Dialogue: 0,0:10:54.04,0:10:57.04,Default,,0,0,0,,Адамдар өліп жатқанда не айтып тұрсың?
Dialogue: 0,0:10:57.05,0:10:58.00,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:10:58.08,0:11:00.06,Default,,0,0,0,,Мен мұны барлығына ұсындым.
Dialogue: 0,0:11:00.08,0:11:03.03,Default,,0,0,0,,Әзірге оның соңынан ерейік.
Dialogue: 0,0:11:03.07,0:11:04.09,Default,,0,0,0,,Киригири мырза...
Dialogue: 0,0:11:05.07,0:11:07.05,Default,,0,0,0,,Біз тұтқынбыз
Dialogue: 0,0:11:08.01,0:11:10.06,Default,,0,0,0,,Жауға соқыр қарсы шыға алмаймын.
Dialogue: 0,0:11:11.04,0:11:14.01,Default,,0,0,0,,Әрі қарай құрбандық шалудың алдын алу үшін.
Dialogue: 0,0:11:15.09,0:11:19.00,Default,,0,0,0,,Майзоно мырзаны... сол жігіт өлтірді.
Dialogue: 0,0:11:19.04,0:11:20.04,Default,,0,0,0,,Монокумаға
Dialogue: 0,0:11:20.06,0:11:23.06,Default,,0,0,0,,Жоқ, мен олай жасамас едім.
Dialogue: 0,0:11:25.00,0:11:26.08,Default,,0,0,0,,Бұған сеніңіз
Dialogue: 0,0:11:27.02,0:11:28.02,Default,,0,0,0,,Монокума?
Dialogue: 0,0:11:28.07,0:11:36.01,Default,,0,0,0,,Білесіз бе, мен ешқашан мектеп өмірінің мақсатына қайшы келетін ештеңе жасамаймын.
Dialogue: 0,0:11:36.04,0:11:39.06,Default,,0,0,0,,Мен аю ережесін таңдаймын.
Dialogue: 0,0:11:39.07,0:11:42.05,Default,,0,0,0,,Ол өзінің сафари саябағымен де танымал болды.
Dialogue: 0,0:11:43.00,0:11:45.02,Default,,0,0,0,,Мұнда кім бар?
Dialogue: 0,0:11:45.05,0:11:47.02,Default,,0,0,0,,Мен білсем де
Dialogue: 0,0:11:47.03,0:11:52.03,Default,,0,0,0,,Саяка Майзононы кім өлтірді?
Dialogue: 0,0:11:55.00,0:11:56.08,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,0:11:56.09,0:12:00.06,Default,,0,0,0,,Көгершін оны гатлинг мылтығы қағып кеткен сияқты.
Dialogue: 0,0:12:01.02,0:12:07.00,Default,,0,0,0,,Сіздердің біріңіз жаңа ғана Майзоно мырзаны бітіру үшін өлтірдіңіз.
Dialogue: 0,0:12:07.01,0:12:08.04,Default,,0,0,0,,Бұл ереже.
Dialogue: 0,0:12:08.06,0:12:10.01,Default,,0,0,0,,Бұл жаман емес.
Dialogue: 0,0:12:10.04,0:12:12.03,Default,,0,0,0,,Бұл өтірік.
Dialogue: 0,0:12:12.07,0:12:14.02,Default,,0,0,0,,Бұл сөзсіз өтірік
Dialogue: 0,0:12:14.04,0:12:18.08,Default,,0,0,0,,Жоқ, мені өлтірген сендердің біреулерің болды.
Dialogue: 0,0:12:19.01,0:12:23.06,Default,,0,0,0,,Қарап отырған адам мұны жақсы білуі керек.
Dialogue: 0,0:12:23.07,0:12:25.02,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:12:25.06,0:12:28.07,Default,,0,0,0,,Шынын айтыңызшы, Саяка Майзоно деген кім?
Dialogue: 0,0:12:29.07,0:12:33.03,Default,,0,0,0,,Кінәлі болған күннің өзінде... деуге негіз жоқ.
Dialogue: 0,0:12:33.05,0:12:36.00,Default,,0,0,0,,Жарайды, сенің кім екенің маңызды емес.
Dialogue: 0,0:12:36.02,0:12:38.03,Default,,0,0,0,,Бобобо... бұл мен емес
Dialogue: 0,0:12:38.06,0:12:40.08,Default,,0,0,0,,Жоқ, сіз бұл менмін дейсіз бе?
Dialogue: 0,0:12:41.01,0:12:42.05,Default,,0,0,0,,Неге Цуки камералар мен тыңшылық құрылғыларға сонша әуес?
Dialogue: 0,0:12:43.00,0:12:46.09,Default,,0,0,0,,Ей, арамызда кісі өлтіруші болса.
Dialogue: 0,0:12:47.02,0:12:49.08,Default,,0,0,0,,Менің ойымша, бұл жерден қылмыскер бітіруі мүмкін.
Dialogue: 0,0:12:52.05,0:12:57.03,Default,,0,0,0,,Бұл өте тәтті. Бұл шайтандай тәтті. Бұл өте тәтті.
Dialogue: 0,0:12:57.05,0:13:00.00,Default,,0,0,0,,Керісінше, нақты іс басталғалы тұр.
Dialogue: 0,0:13:00.02,0:13:01.01,Default,,0,0,0,,Нақты өнімділік?
Dialogue: 0,0:13:01.02,0:13:06.07,Default,,0,0,0,,Енді біз бітіруге қатысты қосымша ережелерді түсіндіре бастаймыз.
Dialogue: 0,0:13:08.00,0:13:12.05,Default,,0,0,0,,Басқа студенттерге сіздің кісі өлтірген «Куро» екеніңізді білуге ​​рұқсат бермеуіңіз керек.
Dialogue: 0,0:13:12.09,0:13:14.08,Default,,0,0,0,,Меніңше, сіз осылай айтып отырсыз.
Dialogue: 0,0:13:15.01,0:13:17.07,Default,,0,0,0,,Иә, оларды өлтіру жеткіліксіз.
Dialogue: 0,0:13:17.07,0:13:22.03,Default,,0,0,0,,Басқа студенттер білмеуі үшін мен оны өлтіруім керек.
Dialogue: 0,0:13:22.06,0:13:25.08,Default,,0,0,0,,Сіз айтып отырған нәрсе, мінсіз қылмысты анықтаңыз.
Dialogue: 0,0:13:26.02,0:13:27.08,Default,,0,0,0,,Оны бағалау
Dialogue: 0,0:13:27.09,0:13:35.04,Default,,0,0,0,,«Сыныптық сот» кісі өлтіру орын алғаннан кейін белгілі бір уақыт ішінде өткізілуі керек.
Dialogue: 0,0:13:36.02,0:13:38.05,Default,,0,0,0,,Сыныптық сынақ?
Dialogue: 0,0:13:38.06,0:13:44.04,Default,,0,0,0,,Сыныптағы сот процесінде мен бәріңізден кінәлі кім екенін талқылауды сұраймын, Куро.
Dialogue: 0,0:13:44.07,0:13:49.07,Default,,0,0,0,,Егер сіз тапқан жауап дұрыс болса
Dialogue: 0,0:13:50.00,0:13:53.06,Default,,0,0,0,,Тәртіпті бұзғандар ғана жазаланады.
Dialogue: 0,0:13:54.00,0:13:57.00,Default,,0,0,0,,Дегенмен, қателессеңіз
Dialogue: 0,0:13:57.01,0:14:01.02,Default,,0,0,0,,Екінші жағынан, қалған Широның барлығы жазаланады.
Dialogue: 0,0:14:01.07,0:14:06.00,Default,,0,0,0,,Бұл сыныптық сынақтардың ережелері.
Dialogue: 0,0:14:06.00,0:14:09.00,Default,,0,0,0,,Мм... Айтпақшы, жаза дегеніміз не?
Dialogue: 0,0:14:09.02,0:14:12.09,Default,,0,0,0,,Аа, қарапайым тілмен айтқанда, бұл өлім жазасына кесу.
Dialogue: 0,0:14:13.02,0:14:15.07,Default,,0,0,0,,Орындау дегеніміз не?
Dialogue: 0,0:14:16.04,0:14:18.04,Default,,0,0,0,,Орындау - бұл орындау.
Dialogue: 0,0:14:18.06,0:14:19.07,Default,,0,0,0,,Шокей
Dialogue: 0,0:14:19.08,0:14:21.09,Default,,0,0,0,,Электрлік орындықта жыртылған
Dialogue: 0,0:14:21.09,0:14:23.08,Default,,0,0,0,,Улы газдан шыққан мокумоку
Dialogue: 0,0:14:24.00,0:14:28.01,Default,,0,0,0,,Дауыл Бұл қандай да бір себептермен денесі бөлшектелген жігіт.
Dialogue: 0,0:14:31.03,0:14:36.02,Default,,0,0,0,,Қылмыстық... Қылмыскерді алып тастасақ, бәрімізді өлім жазасына кесеміз бе?
Dialogue: 0,0:14:36.02,0:14:39.06,Default,,0,0,0,,Жақсы, сен ақылды шимпанзесің.
Dialogue: 0,0:14:39.08,0:14:44.06,Default,,0,0,0,,Өзіңіздің кінәлі емес екеніңізді жасырын түрде көрсету де жақсы.
Dialogue: 0,0:14:46.01,0:14:50.03,Default,,0,0,0,,Басқаша айтқанда, бұл қарапайым судьялар жүйесі.
Dialogue: 0,0:14:50.04,0:14:53.00,Default,,0,0,0,,Кінәлі кім екенін өзіңіз шешесіз.
Dialogue: 0,0:14:53.03,0:14:56.07,Default,,0,0,0,,Ей, сенің айтып тұрғаның орынсыз емес.
Dialogue: 0,0:14:58.01,0:14:59.07,Default,,0,0,0,,Сыныптық сынақ дегеніміз не?
Dialogue: 0,0:15:00.00,0:15:02.01,Default,,0,0,0,,Мен мұндай нәрсеге қатысқым келмейді.
Dialogue: 0,0:15:02.03,0:15:03.02,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:15:03.03,0:15:04.06,Default,,0,0,0,,Неліктен жоқ?
Dialogue: 0,0:15:04.07,0:15:07.09,Default,,0,0,0,,Неліктен қылмыскерді болжауымыз керек?
Dialogue: 0,0:15:08.02,0:15:09.05,Default,,0,0,0,,Бұл өзімшілдік
Dialogue: 0,0:15:09.06,0:15:11.04,Default,,0,0,0,,Менің ойымша, бұл өзімшіл.
Dialogue: 0,0:15:11.05,0:15:13.01,Default,,0,0,0,,Бір-бірімізді өлтірейік
Dialogue: 0,0:15:13.03,0:15:14.05,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:15:14.09,0:15:19.09,Default,,0,0,0,,Шынымды айтсам, алдымдағы зұлымдықтың басым күші мені таң қалдырды.
Dialogue: 0,0:15:20.02,0:15:24.01,Default,,0,0,0,,Бірақ... Жамандыққа бой алайын деген ниетім жоқ.
Dialogue: 0,0:15:24.02,0:15:28.00,Default,,0,0,0,,Соңына дейін күресу - Монокуманың стилі.
Dialogue: 0,0:15:28.01,0:15:33.02,Default,,0,0,0,,Шынымен өткің келсе, алдымен мені жең.
Dialogue: 0,0:15:33.05,0:15:35.04,Default,,0,0,0,,Иә Осыған көңіліңіз тола ма?
Dialogue: 0,0:15:35.05,0:15:36.08,Default,,0,0,0,,Осымен
Dialogue: 0,0:15:37.06,0:15:41.05,Default,,0,0,0,,Мектеп директоры Монокумаға зорлық-зомбылық көрсетуге тыйым салынады.
Dialogue: 0,0:15:41.07,0:15:44.05,Default,,0,0,0,,Мен мұны мектеп ережесін бұзу деп айттыңыз деп ойладым.
Dialogue: 0,0:15:44.08,0:15:47.01,Default,,0,0,0,,Шақыру сиқырын іске қосыңыз
Dialogue: 0,0:15:47.02,0:15:49.07,Default,,0,0,0,,Гунгнир Найзасына көмектес
Dialogue: 0,0:15:53.06,0:15:56.00,Default,,0,0,0,,Иә? Біртүрлі емес пе?
Dialogue: 0,0:15:56.07,0:15:58.08,Default,,0,0,0,,Мен неге...
Dialogue: 0,0:16:04.03,0:16:05.05,Default,,0,0,0,,Эмма…
Dialogue: 0,0:16:08.05,0:16:10.01,Default,,0,0,0,,Мен оны Моулд Колизейге жетпей тұрып жоюым керек
Dialogue: 0,0:16:10.05,0:16:11.08,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:16:12.04,0:16:14.00,Default,,0,0,0,,Қатысты емес жерде
Dialogue: 0,0:16:14.01,0:16:18.03,Default,,0,0,0,,Мен мүмкіндігінше көп өлімнің алдын алуға тырыстым.
Dialogue: 0,0:16:18.04,0:16:21.03,Default,,0,0,0,,Әйтеуір, өзін көрсету керек еді.
Dialogue: 0,0:16:21.05,0:16:25.02,Default,,0,0,0,,Бірақ енді түсіндіңдер ме?
Dialogue: 0,0:16:26.00,0:16:27.06,Default,,0,0,0,,Мен байсалдымын
Dialogue: 0,0:16:30.03,0:16:33.04,Default,,0,0,0,,Тергеуіңізге сәттілік тілейміз.
Dialogue: 0,0:16:33.06,0:16:37.06,Default,,0,0,0,,Сыныптағы сот отырысында кездескенше.
Dialogue: 0,0:16:40.04,0:16:42.08,Default,,0,0,0,,Тек көрсету үшін...?
Dialogue: 0,0:16:43.03,0:16:44.08,Default,,0,0,0,,Сондықтан
Dialogue: 0,0:16:45.01,0:16:49.03,Default,,0,0,0,,Кем дегенде Джунко Эношима кінәлі емес еді.
Dialogue: 0,0:16:49.08,0:16:52.03,Default,,0,0,0,,Тергеуді дереу бастайық.
Dialogue: 0,0:16:52.09,0:16:56.09,Default,,0,0,0,,Өлген адамды мәңгілікке сүйреудің пайдасы жоқ.
Dialogue: 0,0:16:58.04,0:16:59.07,Default,,0,0,0,,Сіз осылай айтасыз...
Dialogue: 0,0:17:00.00,0:17:02.02,Default,,0,0,0,,Мен сізге кеңес беруім керек еді.
Dialogue: 0,0:17:02.05,0:17:06.02,Default,,0,0,0,,Қандай жағдайда да бейімделмегендер өледі.
Dialogue: 0,0:17:06.09,0:17:08.03,Default,,0,0,0,,Бұл менің кінәм.
Dialogue: 0,0:17:08.07,0:17:10.06,Default,,0,0,0,,Қанша көп болса да, онша көп емес
Dialogue: 0,0:17:10.09,0:17:14.02,Default,,0,0,0,,Енді кім кінәлі екенін анықтауымыз керек.
Dialogue: 0,0:17:14.07,0:17:15.06,Default,,0,0,0,,Әйтпесе
Dialogue: 0,0:17:15.08,0:17:18.00,Default,,0,0,0,,Барлығын бірге орындаңыз.
Dialogue: 0,0:17:20.02,0:17:22.07,Default,,0,0,0,,Бұл не? Беттердің саны артып келеді.
Dialogue: 0,0:17:22.09,0:17:25.04,Default,,0,0,0,,О? Дұрыс, дәл осындай уақытта
Dialogue: 0,0:17:25.08,0:17:27.02,Default,,0,0,0,,Monokuma файлы
Dialogue: 0,0:17:28.02,0:17:32.04,Default,,0,0,0,,Бұл Саяка Майзононың өлімінің себебін анық сипаттайды.
Dialogue: 0,0:17:32.09,0:17:34.03,Default,,0,0,0,,Қарап көріңізші
Dialogue: 0,0:17:34.09,0:17:40.00,Default,,0,0,0,,Саяка Майзононың қайтыс болған жері Макото Наэгидің жеке бөлмесі.
Dialogue: 0,0:17:41.07,0:17:44.06,Default,,0,0,0,,Эй, Наэги, сен мұны айтып тұрсың ба?
Dialogue: 0,0:17:44.08,0:17:46.09,Default,,0,0,0,,Бір минут күтіңіз, бұл дұрыс емес.
Dialogue: 0,0:17:47.01,0:17:48.05,Default,,0,0,0,,Айырмашылығы неде?
Dialogue: 0,0:17:48.07,0:17:52.06,Default,,0,0,0,,Мен Майзоно-санмен бір түнге бөлме ауыстырдым.
Dialogue: 0,0:17:52.09,0:17:54.02,Default,,0,0,0,,Себебі ол қорқып кетті
Dialogue: 0,0:17:54.05,0:17:56.02,Default,,0,0,0,,Бөлмелерді ауыстырамыз ба?
Dialogue: 0,0:17:56.05,0:17:57.08,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:17:58.02,0:18:00.08,Default,,0,0,0,,Бәріңіз маған күмәнданасыз ба?
Dialogue: 0,0:18:01.01,0:18:04.04,Default,,0,0,0,,Иә, менің сізге күмәндануым заңды.
Dialogue: 0,0:18:06.09,0:18:09.09,Default,,0,0,0,,Басқаша десең, дәлелде.
Dialogue: 0,0:18:10.01,0:18:11.01,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:11.03,0:18:13.01,Default,,0,0,0,,Енді ойынды бастайық
Dialogue: 0,0:18:13.06,0:18:14.04,Default,,0,0,0,,Тогами-кун
Dialogue: 0,0:18:14.07,0:18:15.09,Default,,0,0,0,,Сәттілік тілеймін.
Dialogue: 0,0:18:16.04,0:18:18.01,Default,,0,0,0,,Біз де тергеуді бастадық.
Dialogue: 0,0:18:18.05,0:18:19.05,Default,,0,0,0,,Исимару мырза
Dialogue: 0,0:18:21.04,0:18:22.08,Default,,0,0,0,,Мен қылмыскер емеспін
Dialogue: 0,0:18:23.05,0:18:25.06,Default,,0,0,0,,Майзоно-сан екеуміз мұны жақсы білеміз.
Dialogue: 0,0:18:27.00,0:18:28.03,Default,,0,0,0,,Бірдеңе істеу керек
Dialogue: 0,0:18:29.03,0:18:30.07,Default,,0,0,0,,Бірдеңе істеу керек
Dialogue: 0,0:18:34.09,0:18:36.07,Default,,0,0,0,,Құрбан - Саяка Майзоно.
Dialogue: 0,0:18:37.09,0:18:40.00,Default,,0,0,0,,Өлім уақыты таңғы 1:30 шамасында болды.
Dialogue: 0,0:18:41.00,0:18:42.07,Default,,0,0,0,,Мәйіт табылған жер
Dialogue: 0,0:18:43.01,0:18:46.02,Default,,0,0,0,,Макото Наэгидің жатақхана аймағындағы жеке бөлмесі
Dialogue: 0,0:18:47.04,0:18:50.03,Default,,0,0,0,,Жәбірленуші душ бөлмесінде өлі күйде табылды.
Dialogue: 0,0:18:51.03,0:18:54.07,Default,,0,0,0,,Өлімге әкелетін жарақат іштің пышақ жарақаты.
Dialogue: 0,0:18:55.03,0:18:58.00,Default,,0,0,0,,Басқалары Оң жақ білегінде соққы ізі бар.
Dialogue: 0,0:18:59.00,0:19:02.03,Default,,0,0,0,,Соққы белгілері бар оң жақ білегі сынған сияқты.
Dialogue: 0,0:19:22.02,0:19:25.05,Default,,0,0,0,,11037…
Dialogue: 0,0:19:36.01,0:19:39.09,Default,,0,0,0,,Бұл... Негидің бөлмесі болуы керек.
Dialogue: 0,0:19:40.01,0:19:42.06,Default,,0,0,0,,Майзононың табақшасы ілулі тұр.
Dialogue: 0,0:19:45.07,0:19:48.01,Default,,0,0,0,,Өйткені мен бөлмемді ауыстырдым
Dialogue: 0,0:19:49.02,0:19:50.05,Default,,0,0,0,,Ол қайтыс болды
Dialogue: 0,0:19:57.08,0:19:58.04,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:02.05,0:20:04.05,Default,,0,0,0,,Кешіріңіз Майзоно-сан
Dialogue: 0,0:20:06.00,0:20:13.08,Default,,0,0,0,,«Супер орта мектептегі кумир» Саяка Майзоно орталық микрофон ретінде қызмет ететін пұт тобы.
Dialogue: 0,0:20:16.03,0:20:20.09,Default,,0,0,0,,Белгілі бір себептермен бұл айдол топ тарады.
Dialogue: 0,0:20:21.05,0:20:25.01,Default,,0,0,0,,Олар пұт ретінде де белсенді болуы мүмкін.
Dialogue: 0,0:20:25.01,0:20:28.09,Default,,0,0,0,,Енді ешқашан назарда болма
Dialogue: 0,0:20:29.05,0:20:33.00,Default,,0,0,0,,Басқаша айтқанда, Саяка Майзоно қай жерге оралады?
Dialogue: 0,0:20:33.02,0:20:35.06,Default,,0,0,0,,Қазір жоқ.
Dialogue: 0,0:20:36.05,0:20:38.03,Default,,0,0,0,,Міне, мәселе.
Dialogue: 0,0:20:38.07,0:20:42.05,Default,,0,0,0,,Бұл айдол тобы неліктен тарады?
Dialogue: 0,0:20:46.09,0:20:49.07,Default,,0,0,0,,Не...бұл не?
Dialogue: 0,0:20:50.08,0:20:51.07,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:20:51.09,0:20:54.00,Default,,0,0,0,,Екінші тарап - айдол тобы.
Dialogue: 0,0:20:54.02,0:20:58.03,Default,,0,0,0,,Сіз тіпті сол қыздарға қолыңызды тигіздім дейсіз бе?
Dialogue: 0,0:21:03.02,0:21:05.07,Default,,0,0,0,,Иә... Мен де күтуден шаршадым.
Dialogue: 0,0:21:05.08,0:21:07.09,Default,,0,0,0,,Жақында бастайық па?
Dialogue: 0,0:21:08.06,0:21:11.09,Default,,0,0,0,,Көптен күткен сыныптық сот процесі
Dialogue: 0,0:21:13.01,0:21:19.03,Default,,0,0,0,,Енді мектеп аумағының бірінші қабатындағы қызыл есіктен кіріңіз.
Dialogue: 0,0:21:28.05,0:21:30.08,Default,,0,0,0,,Наэги-кун, кешікпедің бе?
Dialogue: 0,0:21:31.02,0:21:32.05,Default,,0,0,0,,Барлығы күтіп тұрды.
Dialogue: 0,0:21:33.08,0:21:35.04,Default,,0,0,0,,Менің ойымша, сіз қорқып кеттіңіз.
Dialogue: 0,0:21:35.05,0:21:38.06,Default,,0,0,0,,Мен...Мен қылмысымның ашылғанын қаламаймын.
Dialogue: 0,0:21:39.01,0:21:40.04,Default,,0,0,0,,Үкім шығару жақсы емес
Dialogue: 0,0:21:40.08,0:21:42.04,Default,,0,0,0,,Сыныптағы сот отырысына дейін күтіңіз.
Dialogue: 0,0:21:43.00,0:21:45.05,Default,,0,0,0,,Неги бәрібір кінәлі болуы мүмкін.
Dialogue: 0,0:21:46.05,0:21:49.04,Default,,0,0,0,,Өйткені, олар сізді кінәлі деп санайды.
Dialogue: 0,0:21:50.06,0:21:52.09,Default,,0,0,0,,Бірақ бұл мен кінәлі емеспін дегенді білдірмейді.
Dialogue: 0,0:21:53.04,0:21:55.09,Default,,0,0,0,,Мен де, Майзоно мырза да жақсы білемін.
Dialogue: 0,0:21:56.02,0:21:59.01,Default,,0,0,0,,Барлығы осында.
Dialogue: 0,0:21:59.09,0:22:04.04,Default,,0,0,0,,Ол сізді сотқа береді.
Dialogue: 0,0:22:04.07,0:22:09.01,Default,,0,0,0,,Тағдырыңды шешетін сотқа.
Dialogue: 0,0:22:10.00,0:22:11.01,Default,,0,0,0,,Сіз қорқасыз ба?
Dialogue: 0,0:22:12.02,0:22:15.06,Default,,0,0,0,,Бұл істің сырын анықтау өз қолыңда.
Dialogue: 0,0:22:16.07,0:22:21.06,Default,,0,0,0,,Әйтпесе, көңіліңізден шықпай қалуыңыз мүмкін.
Dialogue: 0,0:22:23.09,0:22:26.02,Default,,0,0,0,,Ал перде ашылады
Dialogue: 0,0:22:27.01,0:22:28.02,Default,,0,0,0,,Өмірге қауіп төндіретін сот процесі
Dialogue: 0,0:22:29.06,0:22:31.01,Default,,0,0,0,,Өмірге қауіп төндіретін алдау
Dialogue: 0,0:22:31.07,0:22:33.00,Default,,0,0,0,,Өмірге қауіп төндіретін сатқындық
Dialogue: 0,0:22:33.08,0:22:35.01,Default,,0,0,0,,Өмірге қауіпті жұмбақ шешу
Dialogue: 0,0:22:35.08,0:22:37.01,Default,,0,0,0,,Өмірге қауіп төндіретін сылтау
Dialogue: 0,0:22:37.07,0:22:39.01,Default,,0,0,0,,Өз өміріңізге сеніңіз
Dialogue: 0,0:22:39.07,0:22:40.07,Default,,0,0,0,,Өз өміріңізді қатерге тігу...
Dialogue: 0,0:22:47.07,0:22:48.08,Default,,0,0,0,,Сыныптық сынақ
Dialogue: 0,0:23:27.08,0:23:30.07,Default,,0,0,0,,Сізге не керек?
Dialogue: 0,0:23:30.07,0:23:33.00,Default,,0,0,0,,Құлақ шуы – өтірікке ұқсайтын әңгіме
Dialogue: 0,0:23:33.03,0:23:37.03,Default,,0,0,0,,Менің әлемім қателескен сияқты.
Dialogue: 0,0:23:37.03,0:23:42.06,Default,,0,0,0,,Дүниелік нәпсіге тосқауыл қою. Оның айтуынша, эквивалентті айырбас.
Dialogue: 0,0:23:42.07,0:23:46.07,Default,,0,0,0,,Азғыруға еріп, бос сөзге батып кеттім.
Dialogue: 0,0:23:46.08,0:23:51.03,Default,,0,0,0,,Патша ойынына күштеп қатысу. Олар менің вето құқығымды тыңдамайды.
Dialogue: 0,0:23:51.04,0:23:55.04,Default,,0,0,0,,Тағайындалған тапсырма: «Ол адамды өлтір».
Dialogue: 0,0:23:55.04,0:23:58.04,Default,,0,0,0,,Үмітсіз қалдым, Бала сияқтымын енді
Dialogue: 0,0:23:58.04,0:24:00.05,Default,,0,0,0,,Мен кездестірген шындық - Раттатта
Dialogue: 0,0:24:00.05,0:24:05.08,Default,,0,0,0,,Нәпсі жоқ деп, екіжүзді болып көрінгеннен пайда жоқ.
Dialogue: 0,0:24:05.08,0:24:09.01,Default,,0,0,0,,Бұл сіздің аңсаған арманыңыз ба? Мен батыр болғым келеді.
Dialogue: 0,0:24:09.01,0:24:12.08,Default,,0,0,0,,Уппупу Болашақ өкінішті
Dialogue: 0,0:24:12.08,0:24:17.04,Default,,0,0,0,,Ақымақтыққа дәрі жоқ
Dialogue: 0,0:24:18.54,0:24:23.54,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
