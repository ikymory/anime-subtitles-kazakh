Dialogue: 0,0:23:23.47,0:23:30.65,ED - JP - Shad,,0,0,0,,Өзімді құшақтай алмағаныма өкінемін
Dialogue: 0,0:23:30.65,0:23:36.07,ED - JP - Shad,,0,0,0,,Бөлмені мақтаныш басып өтті
Dialogue: 0,0:23:36.23,0:23:42.74,ED - JP - Shad,,0,0,0,,Бағалы уақыт ұрланды
Dialogue: 0,0:23:42.74,0:23:49.87,ED - JP - Shad,,0,0,0,,Мен енді берілмей іздеген идеалды жолда келе жатырмын.
Dialogue: 0,0:23:49.87,0:23:54.63,ED - JP - Shad,,0,0,0,,Бұрынғыдан көбірек жүру
Dialogue: 0,0:23:54.63,0:23:57.63,ED - JP - Shad,,0,0,0,,Мен қанағаттандым
Dialogue: 0,0:23:57.63,0:24:03.09,ED - JP - Shad,,0,0,0,,Мен өз естеліктерімді аралауға барамын
Dialogue: 0,0:24:04.14,0:24:10.48,ED - JP - Shad,,0,0,0,,Қоштасулар арасында да
Dialogue: 0,0:24:10.48,0:24:17.03,ED - JP - Shad,,0,0,0,,Біз әрқайсымыз өз идеалдарымызды жинақтадық.
Dialogue: 0,0:24:17.03,0:24:21.15,ED - JP - Shad,,0,0,0,,Түс көрген күнім
Dialogue: 0,0:24:21.15,0:24:27.99,ED - JP - Shad,,0,0,0,,Бұл алыс сияқты, бірақ бәрібір
Dialogue: 0,0:24:27.99,0:24:31.25,ED - JP - Shad,,0,0,0,,Мен оны болашаққа сақтаймын.
Dialogue: 0,0:24:31.25,0:24:34.46,ED - JP - Shad,,0,0,0,,Менің болашақ өзім
Dialogue: 0,0:24:34.46,0:24:38.00,ED - JP - Shad,,0,0,0,,Сізге ләззат алу үшін
Dialogue: 0,0:04:05.35,0:04:07.10,Screen,,0,0,0,,5. Тыйым салынған ұзақ мерзімді телефон қоңыраулары
Dialogue: 0,0:04:05.35,0:04:07.10,Screen,,0,0,0,,Қоңырау шалу уақыты: 10 минут ішінде
Dialogue: 0,0:12:59.63,0:13:01.14,Screen,,0,0,0,,Оқу бөлмесі
Dialogue: 0,0:14:49.10,0:14:51.00,Screen,,0,0,0,,Гай
Dialogue: 0,0:14:49.87,0:14:51.00,Screen,,0,0,0,,Гай
Dialogue: 0,0:15:55.81,0:16:03.07,Screen,,0,0,0,,Чжу Ли Ян
Dialogue: 0,0:15:55.81,0:16:03.07,Screen,,0,0,0,,...
Dialogue: 0,0:16:03.07,0:16:03.19,Screen,,0,0,0,,Чжу Ли Ян
Dialogue: 0,0:16:03.19,0:16:03.32,Screen,,0,0,0,,Чжу Ли Ян
Dialogue: 0,0:16:03.32,0:16:03.44,Screen,,0,0,0,,Чжу Ли Ян
Dialogue: 0,0:16:03.44,0:16:03.57,Screen,,0,0,0,,Чжу Ли Ян
Dialogue: 0,0:16:03.57,0:16:04.57,Screen,,0,0,0,,Чжу Ли Ян
Dialogue: 0,0:16:03.07,0:16:03.19,Screen,,0,0,0,,...
Dialogue: 0,0:16:03.19,0:16:03.32,Screen,,0,0,0,,...
Dialogue: 0,0:16:03.32,0:16:03.44,Screen,,0,0,0,,...
Dialogue: 0,0:16:03.44,0:16:03.57,Screen,,0,0,0,,...
Dialogue: 0,0:16:03.57,0:16:04.57,Screen,,0,0,0,,...
Dialogue: 1,0:09:42.77,0:09:48.15,Note,,0,0,0,,※Жапон сөзінің наным-сенімін тану, тілдік сөздердің жаны мен құдайлық күші бар, тіл қабілеті жақсы және жаман.
Dialogue: 8,0:00:07.93,0:00:08.86,Text - CN,,0,0,0,,Жақсы ойлар
Dialogue: 7,0:00:07.93,0:00:08.86,Text - JP,,0,0,0,,Уф!
Dialogue: 8,0:00:11.94,0:00:14.37,Text - CN,,0,0,0,,Бұл сөз тіркесі сізден кейін келді.
Dialogue: 7,0:00:11.94,0:00:14.37,Text - JP,,0,0,0,,Мен артымнан дауысты естідім.
Dialogue: 8,0:00:15.48,0:00:19.00,Text - CN,,0,0,0,,Басына бір қараған адам өлмейді.
Dialogue: 7,0:00:15.48,0:00:19.00,Text - JP,,0,0,0,,Артыма қарасам, ешкім жоқ.
Dialogue: 8,0:00:19.83,0:00:22.51,Text - CN,,0,0,0,,Бұл классикалық елес оқиғасы
Dialogue: 7,0:00:19.83,0:00:22.51,Text - JP,,0,0,0,,Бұл елес әңгіменің кең тараған түрі.
Dialogue: 8,0:01:50.53,0:01:52.01,Text - CN,,0,0,0,,Дугаку Хориучи
Dialogue: 7,0:01:50.53,0:01:52.01,Text - JP,,0,0,0,,Хориучи мырза
Dialogue: 8,0:01:55.22,0:01:59.46,Text - CN,,0,0,0,,Сіз мені орманға апара аласыз.
Dialogue: 7,0:01:55.22,0:01:59.46,Text - JP,,0,0,0,,Мұны Хаяши мырзаға жеткізуге болады.
Dialogue: 8,0:01:59.46,0:02:02.89,Text - CN,,0,0,0,,...
Dialogue: 7,0:01:59.46,0:02:02.89,Text - JP,,0,0,0,,Кешіріңіз, менде комиссия отырысы келе жатыр.
Dialogue: 8,0:02:03.74,0:02:04.68,Text - CN,,0,0,0,,Қазірге дейін
Dialogue: 7,0:02:03.74,0:02:04.68,Text - JP,,0,0,0,,Иә
Dialogue: 8,0:02:06.55,0:02:08.61,Text - CN,,0,0,0,,...
Dialogue: 7,0:02:06.55,0:02:08.61,Text - JP,,0,0,0,,Бұл ойдан шығарылған сияқты.
Dialogue: 8,0:02:08.61,0:02:12.15,Text - CN,,0,0,0,,Соңғы кездері мен бәріңізге хабарласып жүрмін.
Dialogue: 7,0:02:08.61,0:02:12.15,Text - JP,,0,0,0,,Содан бері әртүрлі тәсілдермен қолданылып келеді.
Dialogue: 8,0:02:15.78,0:02:19.92,Text - CN,,0,0,0,,Музыка бөлмесінің өлімі
Dialogue: 7,0:02:15.78,0:02:19.92,Text - JP,,0,0,0,,Музыка бөлмесін өлгендердің рухтары қуантады.
Dialogue: 8,0:02:19.92,0:02:22.73,Text - CN,,0,0,0,,Спорт сарайы аспалы мектеп
Dialogue: 7,0:02:19.92,0:02:22.73,Text - JP,,0,0,0,,Гимназия қоймасында асылған мәйіт бар.
Dialogue: 8,0:02:22.73,0:02:25.28,Text - CN,,0,0,0,,Чикако Чишо
Dialogue: 7,0:02:22.73,0:02:25.28,Text - JP,,0,0,0,,Ханако дәретханада
Dialogue: 8,0:02:25.28,0:02:27.71,Text - CN,,0,0,0,,Мектепке бару - жүктілік пен босану туралы әңгіме.
Dialogue: 7,0:02:25.28,0:02:27.71,Text - JP,,0,0,0,,Мектеп – елес хикаяларының қазынасы
Dialogue: 8,0:02:28.43,0:02:28.92,Text - CN,,0,0,0,,Қателік
Dialogue: 7,0:02:28.43,0:02:28.92,Text - JP,,0,0,0,,Бірақ
Dialogue: 8,0:02:29.88,0:02:33.70,Text - CN,,0,0,0,,Мен көрген ең дарынды адам
Dialogue: 7,0:02:29.88,0:02:33.70,Text - JP,,0,0,0,,Мен тірі адамдардан ең қорқамын.
Dialogue: 8,0:02:33.70,0:02:38.93,Text - CN,,0,0,0,,Түзу жолдың досы мен кенет қақтығысқа түскен дос
Dialogue: 7,0:02:33.70,0:02:38.93,Text - JP,,0,0,0,,Күні кешеге дейін жақсы дос болған достар бүгін кенет жауға айналады.
Dialogue: 8,0:02:40.01,0:02:41.52,Text - CN,,0,0,0,,Бірінші шайқас
Dialogue: 7,0:02:40.01,0:02:41.52,Text - JP,,0,0,0,,Кешіріңіз
Dialogue: 8,0:02:43.77,0:02:47.37,Text - CN,,0,0,0,,Қолдауыңыз үшін рахмет.
Dialogue: 7,0:02:43.77,0:02:47.37,Text - JP,,0,0,0,,Рахмет. Жалғыз болу қиын болса керек.
Dialogue: 8,0:02:48.05,0:02:49.71,Text - CN,,0,0,0,,Менде жоқ.
Dialogue: 7,0:02:48.05,0:02:49.71,Text - JP,,0,0,0,,Жоқ, мүлде емес
Dialogue: 8,0:02:50.40,0:02:51.99,Text - CN,,0,0,0,,Нагашушо жүгіру аяқталды
Dialogue: 7,0:02:50.40,0:02:51.99,Text - JP,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 8,0:02:54.41,0:02:58.24,Text - CN,,0,0,0,,Жапондар мен басқаларды салыстыру;
Dialogue: 7,0:02:54.41,0:02:58.24,Text - JP,,0,0,0,,Біреудің зұлымдығымен салыстырғанда қағаздың салмағы жоқ.
Dialogue: 8,0:03:11.04,0:03:12.94,Text - CN,,0,0,0,,...
Dialogue: 7,0:03:11.04,0:03:12.94,Text - JP,,0,0,0,,Мен іздеген музыкалық парақ сонда болды.
Dialogue: 8,0:03:12.94,0:03:13.96,Text - CN,,0,0,0,,Таптым.
Dialogue: 7,0:03:12.94,0:03:13.96,Text - JP,,0,0,0,,Иә
Dialogue: 8,0:03:13.96,0:03:16.57,Text - CN,,0,0,0,,Нага қолында қасық
Dialogue: 7,0:03:13.96,0:03:16.57,Text - JP,,0,0,0,,Ал, мен кілтті саған қалдырамын.
Dialogue: 8,0:03:16.57,0:03:18.65,Text - CN,,0,0,0,,Егер сізде талаптардың толық жинағы болса, қайтарыңыз
Dialogue: 7,0:03:16.57,0:03:18.65,Text - JP,,0,0,0,,Жұмысты аяқтағаннан кейін оны міндетті түрде орнына қойыңыз.
Dialogue: 8,0:03:18.65,0:03:20.81,Text - CN,,0,0,0,,...
Dialogue: 7,0:03:18.65,0:03:20.81,Text - JP,,0,0,0,,Иә, рақмет.
Dialogue: 8,0:03:21.18,0:03:23.81,Text - CN,,0,0,0,,Мәдениет мерекесімен құттықтаймыз
Dialogue: 7,0:03:21.18,0:03:23.81,Text - JP,,0,0,0,,Мектеп мерекесіне сәттілік тілейміз
Dialogue: 8,0:03:26.14,0:03:27.81,Text - CN,,0,0,0,,Харукиннің дауысы
Dialogue: 7,0:03:26.14,0:03:27.81,Text - JP,,0,0,0,,Ах, фортепиано дыбысы.
Dialogue: 8,0:03:28.05,0:03:31.84,Text - CN,,0,0,0,,Мектеп фестивалінің алдындағы түнде мектепте зеріктім.
Dialogue: 7,0:03:28.05,0:03:31.84,Text - JP,,0,0,0,,Мектеп мерекесіне дейін қызық, өйткені кешке дейін қалуға болады.
Dialogue: 8,0:03:31.84,0:03:33.44,Text - CN,,0,0,0,,...
Dialogue: 7,0:03:31.84,0:03:33.44,Text - JP,,0,0,0,,О, бұл қорқынышты.
Dialogue: 8,0:03:33.88,0:03:36.77,Text - CN,,0,0,0,,Дене шынықтыру бөлімінде оқитыным рас.
Dialogue: 7,0:03:33.88,0:03:36.77,Text - JP,,0,0,0,,Өйткені, гимназияның жанындағы әжетхана сыртта.
Dialogue: 8,0:03:36.77,0:03:40.49,Text - CN,,0,0,0,,...
Dialogue: 7,0:03:36.77,0:03:40.49,Text - JP,,0,0,0,,А, түсіндім. Ол жерде күндіз де қараңғы.
Dialogue: 8,0:03:40.49,0:03:42.62,Text - CN,,0,0,0,,Қосымша түсініктеме
Dialogue: 7,0:03:40.49,0:03:42.62,Text - JP,,0,0,0,,Бетіңді... маған бұр...
Dialogue: 8,0:03:43.31,0:03:48.25,Text - CN,,0,0,0,,Мәдениет фестивалі - негізгі курстың тууы туралы тарихи жазба
Dialogue: 7,0:03:43.31,0:03:48.25,Text - JP,,0,0,0,,Мектептегі фестиваль - бұл қарапайым студенттер үшін екі жылдың шарықтау шегі.
Dialogue: 8,0:03:48.57,0:03:51.25,Text - CN,,0,0,0,,Йошиконың телефоны
Dialogue: 7,0:03:48.57,0:03:51.25,Text - JP,,0,0,0,,Рёко-чан, маған қоңырау шалыңыз.
Dialogue: 8,0:03:52.39,0:03:56.63,Text - CN,,0,0,0,,Бұл Такехараның аты.
Dialogue: 7,0:03:52.39,0:03:56.63,Text - JP,,0,0,0,,Кинуэ Такехара: Мен онымен бірге орта мектепте оқыдым.
Dialogue: 8,0:04:02.97,0:04:05.35,Text - CN,,0,0,0,,...
Dialogue: 7,0:04:02.97,0:04:05.35,Text - JP,,0,0,0,,Мен Ромео мен Джульетта туралы шешім қабылдадым.
Dialogue: 8,0:04:06.10,0:04:07.10,Text - CN,,0,0,0,,Э-э, Ллойд мырза, жатын бөлмелерге келсек…
Dialogue: 7,0:04:06.10,0:04:07.10,Text - JP,,0,0,0,,Иә
Dialogue: 8,0:04:07.52,0:04:10.36,Text - CN,,0,0,0,,Осы бөлікті есіме түсірмес бұрын
Dialogue: 7,0:04:07.52,0:04:10.36,Text - JP,,0,0,0,,Сонымен ескі күндерді есіме түсірдім.
Dialogue: 8,0:04:12.72,0:04:14.61,Text - CN,,0,0,0,,Гудвилл
Dialogue: 7,0:04:12.72,0:04:14.61,Text - JP,,0,0,0,,Уф!
Dialogue: 8,0:04:16.59,0:04:19.92,Text - CN,,0,0,0,,Ол кезде мен Жу Лияны ойнадым.
Dialogue: 7,0:04:16.59,0:04:19.92,Text - JP,,0,0,0,,Бұл Ромео мен Джульетта болатын.
Dialogue: 8,0:04:19.92,0:04:21.49,Text - CN,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 7,0:04:19.92,0:04:21.49,Text - JP,,0,0,0,,Иә
Dialogue: 8,0:04:21.90,0:04:23.75,Text - CN,,0,0,0,,Ханшайым
Dialogue: 7,0:04:21.90,0:04:23.75,Text - JP,,0,0,0,,Ханшайымның қолдары
Dialogue: 8,0:04:23.75,0:04:26.37,Text - CN,,0,0,0,,Жоғары мәртебелі ханзада
Dialogue: 7,0:04:23.75,0:04:26.37,Text - JP,,0,0,0,,ықыласпен князь
Dialogue: 8,0:04:27.37,0:04:29.12,Text - CN,,1430,0,0,,Қонақтар кездесуіне бару
Dialogue: 7,0:04:27.37,0:04:29.12,Text - JP,,1430,0,0,,Оны көруге келіңіз
Dialogue: 8,0:04:29.84,0:04:30.63,Text - CN,,0,900,0,,Мен кеттім
Dialogue: 7,0:04:29.84,0:04:30.63,Text - JP,,0,900,0,,Мен барамын
Dialogue: 8,0:04:34.13,0:04:36.51,Text - CN,,0,0,0,,Шираничи және мүмкін болатын сәтсіздіктер
Dialogue: 7,0:04:34.13,0:04:36.51,Text - JP,,0,0,0,,Білмеймін, бармайтын шығармын.
Dialogue: 8,0:04:38.38,0:04:40.51,Text - CN,,0,0,0,,Анамның әңгімесі...
Dialogue: 7,0:04:38.38,0:04:40.51,Text - JP,,0,0,0,,Менің анам...
Dialogue: 8,0:04:40.73,0:04:43.36,Text - CN,,0,0,0,,…
Dialogue: 7,0:04:40.73,0:04:43.36,Text - JP,,0,0,0,,Yabaha… hahasa…
Dialogue: 8,0:04:44.22,0:04:45.82,Text - CN,,0,0,0,,...
Dialogue: 7,0:04:44.22,0:04:45.82,Text - JP,,0,0,0,,Ал Кира
Dialogue: 8,0:04:48.06,0:04:50.85,Text - CN,,0,0,0,,Орындаушылар
Dialogue: 7,0:04:48.06,0:04:50.85,Text - JP,,0,0,0,,Ол актриса болғысы келді, солай ма?
Dialogue: 8,0:04:50.85,0:04:53.08,Text - CN,,0,0,0,,Бір бейне, көп адам
Dialogue: 7,0:04:50.85,0:04:53.08,Text - JP,,0,0,0,,Аа, ондай адамдар аз емес.
Dialogue: 8,0:04:53.08,0:04:55.83,Text - CN,,0,0,0,,Өздігінен құрастырылған арман кітабы
Dialogue: 7,0:04:53.08,0:04:55.83,Text - JP,,0,0,0,,Мен өз арманымды қызыма сеніп тапсырғандай сезінемін.
Dialogue: 8,0:04:55.83,0:04:59.40,Text - CN,,0,0,0,,Жалпы жағдайда бұл жағдай.
Dialogue: 7,0:04:55.83,0:04:59.40,Text - JP,,0,0,0,,Жалпы олай емес.
Dialogue: 8,0:05:00.15,0:05:02.91,Text - CN,,0,0,0,,Дегенмен, бұл менің кінәм.
Dialogue: 7,0:05:00.15,0:05:02.91,Text - JP,,0,0,0,,Бірақ біздікі сәл басқаша, солай емес пе?
Dialogue: 8,0:05:04.08,0:05:09.47,Text - CN,,0,0,0,,Түс көрсем ойымды ашайын деген ниетім жоқ, мен жасайтын кедергілер түстен шығады.
Dialogue: 7,0:05:04.08,0:05:09.47,Text - JP,,0,0,0,,Босатқанына қуанғандай емес, керісінше оны ұстап қалғысы келетіні.
Dialogue: 8,0:05:09.47,0:05:11.60,Text - CN,,0,0,0,,...
Dialogue: 7,0:05:09.47,0:05:11.60,Text - JP,,0,0,0,,Иә, солай.
Dialogue: 8,0:05:11.60,0:05:16.42,Text - CN,,0,0,0,,Әке мен әкенің қолдауы
Dialogue: 7,0:05:11.60,0:05:16.42,Text - JP,,0,0,0,,Менің әжем мен әкем қолдау көрсеткендіктен, мен бәрі жақсы болып жатқандай сезінемін.
Dialogue: 8,0:05:18.01,0:05:20.76,Text - CN,,0,0,0,,Әртүрлі жағдайлар да бар
Dialogue: 7,0:05:18.01,0:05:20.76,Text - JP,,0,0,0,,Иә, мұндай нәрсе бар.
Dialogue: 8,0:05:22.80,0:05:25.43,Text - CN,,0,0,0,,Бұл иесінің нақты арманы емес.
Dialogue: 7,0:05:22.80,0:05:25.43,Text - JP,,0,0,0,,Әркім өз арманын орындай алмайды
Dialogue: 8,0:05:26.06,0:05:29.60,Text - CN,,0,0,0,,Жұмысқа тезірек кірісетінім анық.
Dialogue: 7,0:05:26.06,0:05:29.60,Text - JP,,0,0,0,,Мен мұны әу бастан білдім.
Dialogue: 8,0:05:29.60,0:05:31.76,Text - CN,,0,0,0,,Менің екенім логикалық тұрғыдан анық
Dialogue: 7,0:05:29.60,0:05:31.76,Text - JP,,0,0,0,,Логикалық тұрғыдан түсінді
Dialogue: 8,0:05:31.76,0:05:33.56,Text - CN - UP,,0,0,0,,Дугаку Хориучи
Dialogue: 7,0:05:31.76,0:05:33.56,Text - JP - UP,,0,0,0,,Хориучи мырза
Dialogue: 8,0:05:35.32,0:05:38.07,Text - CN,,0,0,0,,Қолайсыз ниет Карри дүниеден өтті
Dialogue: 7,0:05:35.32,0:05:38.07,Text - JP,,0,0,0,,Кешіріңіз, бұл ештеңе емес.
Dialogue: 8,0:05:39.88,0:05:42.32,Text - CN,,0,0,0,,Бұл бірінші баратын жер.
Dialogue: 7,0:05:39.88,0:05:42.32,Text - JP,,0,0,0,,Бұл қар үйіндісі.
Dialogue: 8,0:05:42.32,0:05:47.33,Text - CN,,0,0,0,,Арман, үміт, қызғаныш, тілек, жоспар аралас
Dialogue: 7,0:05:42.32,0:05:47.33,Text - JP,,0,0,0,,Арман, үміт, үмітсіздік, қызғаныш, қызғаныш, қызғаныш,
Dialogue: 8,0:05:48.19,0:05:52.33,Text - CN,,0,0,0,,Осы ауылдағы аруақ оқиғасын алғаш түсінгенде не болды?
Dialogue: 7,0:05:48.19,0:05:52.33,Text - JP,,0,0,0,,Мен елес оқиғаларды жасаудың астарлылығын аздап түсінгендей болдым.
Dialogue: 8,0:05:53.37,0:05:58.46,Text - CN,,0,0,0,,Дегенмен, мүмкіндігінше тезірек, мен ең қолайлы адаммын.
Dialogue: 7,0:05:53.37,0:05:58.46,Text - JP,,0,0,0,,Мен бәрінен де тірі адамдардан қорқамын.
Dialogue: 8,0:05:59.51,0:06:00.97,Text - CN,,0,0,0,,Сот отырысы?
Dialogue: 7,0:05:59.51,0:06:00.97,Text - JP,,0,0,0,,Ерлікті сынау?
Dialogue: 8,0:06:00.97,0:06:04.29,Text - CN,,0,0,0,,...
Dialogue: 7,0:06:00.97,0:06:04.29,Text - JP,,0,0,0,,Иә, бүгін бәріміз киім ауыстыратын бөлмеде боламыз.
Dialogue: 8,0:06:04.29,0:06:06.35,Text - CN,,0,0,0,,Аралық және жартылай демалыс уақыттары
Dialogue: 7,0:06:04.29,0:06:06.35,Text - JP,,0,0,0,,30 минуттай үзіліс болады.
Dialogue: 8,0:06:06.93,0:06:08.35,Text - CN,,0,0,0,,Сол кезде Маркизмен ойнау
Dialogue: 7,0:06:06.93,0:06:08.35,Text - JP,,0,0,0,,Сол кезде
Dialogue: 8,0:06:08.35,0:06:09.68,Text - CN,,0,0,0,,Пакет кімге тиесілі?
Dialogue: 7,0:06:08.35,0:06:09.68,Text - JP,,0,0,0,,...
Dialogue: 8,0:06:09.68,0:06:10.17,Text - CN,,0,0,0,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 7,0:06:09.68,0:06:10.17,Text - JP,,0,0,0,,Иә
Dialogue: 8,0:06:10.17,0:06:11.48,Text - CN,,0,0,0,,...
Dialogue: 7,0:06:10.17,0:06:11.48,Text - JP,,0,0,0,,Мен де
Dialogue: 8,0:06:13.99,0:06:15.08,Text - CN,,0,0,0,,Менің алдын ала сезімім айқын көрсетті, мен жеңетінімді
Dialogue: 7,0:06:13.99,0:06:15.08,Text - JP,,0,0,0,,Не?
Dialogue: 8,0:06:15.08,0:06:17.86,Text - CN,,0,0,0,,Әйелдің жақсы бейнесі
Dialogue: 7,0:06:15.08,0:06:17.86,Text - JP,,0,0,0,,А, мен өзімді сынап көрейін деп жатырмын.
Dialogue: 8,0:06:17.86,0:06:19.88,Text - CN,,0,0,0,,Нағыз үнсіздік
Dialogue: 7,0:06:17.86,0:06:19.88,Text - JP,,0,0,0,,Сен ақымақсың.
Dialogue: 8,0:06:19.88,0:06:24.61,Text - CN,,0,0,0,,Есепті орындағаннан кейін әдемі киім киюге болады.
Dialogue: 7,0:06:19.88,0:06:24.61,Text - JP,,0,0,0,,Жарайды, ол балалар костюмдерді жасау үшін күнде көп еңбектенді.
Dialogue: 8,0:06:24.61,0:06:26.24,Text - CN,,0,0,0,,Бұл оны алудың ең жақсы жолы.
Dialogue: 7,0:06:24.61,0:06:26.24,Text - JP,,0,0,0,,Егер сіз газды шығармасаңыз
Dialogue: 8,0:06:26.58,0:06:28.95,Text - CN,,0,0,0,,Шындықты біл.
Dialogue: 7,0:06:26.58,0:06:28.95,Text - JP,,0,0,0,,Сіз өте түсініктісіз, сенпай.
Dialogue: 8,0:06:28.95,0:06:29.99,Text - CN,,0,0,0,,Накоре
Dialogue: 7,0:06:28.95,0:06:29.99,Text - JP,,0,0,0,,Жақсы.
Dialogue: 8,0:06:30.54,0:06:32.46,Text - CN,,0,0,0,,Мен болашақты қалдыруды шештім.
Dialogue: 7,0:06:30.54,0:06:32.46,Text - JP,,0,0,0,,Менің мансап жолым шешілді.
Dialogue: 8,0:06:33.11,0:06:35.46,Text - CN,,0,0,0,,Осының арқасында бәрі жақсы жүріп жатыр.
Dialogue: 7,0:06:33.11,0:06:35.46,Text - JP,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 8,0:06:37.59,0:06:42.72,Text - CN,,0,0,0,,Сіз мектептен зейнетке шығуды шештіңіз.
Dialogue: 7,0:06:37.59,0:06:42.72,Text - JP,,0,0,0,,Дұрыс, мен бәрібір тастаймын.
Dialogue: 8,0:06:44.98,0:06:47.72,Text - CN,,0,0,0,,Тағы бір қайғылы оқиға
Dialogue: 7,0:06:44.98,0:06:47.72,Text - JP,,0,0,0,,Көңілсіз көрінбе.
Dialogue: 8,0:06:48.35,0:06:53.54,Text - CN,,0,0,0,,Дегенмен рухты өзгерту оңай емес.
Dialogue: 7,0:06:48.35,0:06:53.54,Text - JP,,0,0,0,,Өйткені қазір өзін жақсы сезіну босқа кетті.
Dialogue: 8,0:06:55.23,0:06:58.61,Text - CN,,0,0,0,,Құқық – шешімді ақылдың мектептен алшақтататын себебі.
Dialogue: 7,0:06:55.23,0:06:58.61,Text - JP,,0,0,0,,Мен өзімді жақсы сезінемін, өйткені мен жұмыстан шығуды шештім.
Dialogue: 8,0:07:03.42,0:07:08.41,Text - CN,,0,0,0,,Шығыстан батысқа қарай ұқсас жолды әлі де таңдауға болады.
Dialogue: 7,0:07:03.42,0:07:08.41,Text - JP,,0,0,0,,Бір жолды таңдасақ та, әр түрлі жолдарды таңдауымыз мүмкін.
Dialogue: 8,0:07:18.46,0:07:22.96,Text - CN,,0,0,0,,Мектеп мерекесі кезінде мектепке келген түнде жылу қосылады
Dialogue: 7,0:07:18.46,0:07:22.96,Text - JP,,0,0,0,,Мектеп мерекесінде түнде мектептің қызу жүретіні жақсы.
Dialogue: 8,0:07:23.46,0:07:25.51,Text - CN - UP,,0,0,0,,Менің демалыс орным
Dialogue: 7,0:07:23.46,0:07:25.51,Text - JP - UP,,0,0,0,,Тыныш болыңыз
Dialogue: 8,0:07:28.09,0:07:29.53,Text - CN,,0,0,0,,Мен тапсырдым
Dialogue: 7,0:07:28.09,0:07:29.53,Text - JP,,0,0,0,,Мүлде жоқ
Dialogue: 8,0:07:29.53,0:07:31.01,Text - CN,,0,0,0,,Шыққанда
Dialogue: 7,0:07:29.53,0:07:31.01,Text - JP,,0,0,0,,Демек, Өлім періштесі тек алма жей ме?
Dialogue: 8,0:07:31.56,0:07:36.40,Text - CN,,0,0,0,,...
Dialogue: 7,0:07:31.56,0:07:36.40,Text - JP,,0,0,0,,Алдын ала курс студенттері нервтерді тексеріп жатыр еді, мен шошып кеттім.
Dialogue: 8,0:07:36.40,0:07:39.96,Text - CN,,0,0,0,,Ұлы қыстағы аспан ойыны кездесуі
Dialogue: 7,0:07:36.40,0:07:39.96,Text - JP,,0,0,0,,Хм, қыстың ортасында жігеріңді сынағың келе ме?
Dialogue: 8,0:07:40.44,0:07:44.80,Text - CN,,0,0,0,,Әңгіменің шығу тегі Елорда меншігіндегі мектептің жеті ұлы жұмбағы
Dialogue: 7,0:07:40.44,0:07:44.80,Text - JP,,0,0,0,,Әр мектепте «Жеті керемет» сияқты әңгімелер бар.
Dialogue: 8,0:07:44.80,0:07:47.39,Text - CN,,0,0,0,,Менің де мектебім бар.
Dialogue: 7,0:07:44.80,0:07:47.39,Text - JP,,0,0,0,,Бізде де осындай нәрсе бар ма?
Dialogue: 8,0:07:47.39,0:07:48.91,Text - CN,,0,0,0,,Табиғат бар
Dialogue: 7,0:07:47.39,0:07:48.91,Text - JP,,0,0,0,,Иә, бар.
Dialogue: 8,0:07:49.68,0:07:52.54,Text - CN,,0,0,0,,...
Dialogue: 7,0:07:49.68,0:07:52.54,Text - JP,,0,0,0,,Арман мен сәтсіздікке толы жер.
Dialogue: 8,0:07:52.91,0:07:58.25,Text - CN,,0,0,0,,Мен көп ата-ананы көрдім.
Dialogue: 7,0:07:52.91,0:07:58.25,Text - JP,,0,0,0,,Мен мұндай адамдарды көп көрдім, мен де солардың бірімін.
Dialogue: 8,0:07:58.25,0:07:59.67,Text - CN,,0,0,0,,Кешіріңіз, lol
Dialogue: 7,0:07:58.25,0:07:59.67,Text - JP,,0,0,0,,Мұндай нәрсе
Dialogue: 8,0:07:59.67,0:08:03.42,Text - CN,,0,0,0,,Осы мектеп ауылында туған адамның жаны
Dialogue: 7,0:07:59.67,0:08:03.42,Text - JP,,0,0,0,,Мектепте елестер жүр.
Dialogue: 8,0:08:08.05,0:08:09.55,Text - CN,,0,0,0,,...
Dialogue: 7,0:08:08.05,0:08:09.55,Text - JP,,0,0,0,,Кину-чан, не болды?
Dialogue: 8,0:08:10.67,0:08:11.93,Text - CN,,0,0,0,,Айырбасталған жандар
Dialogue: 7,0:08:10.67,0:08:11.93,Text - JP,,0,0,0,,Ештеңе
Dialogue: 8,0:08:12.58,0:08:15.28,Text - CN,,0,0,0,,Наканың жақсы бейнесі мен дауысымның үні бар.
Dialogue: 7,0:08:12.58,0:08:15.28,Text - JP,,0,0,0,,Мен дауысты естідім де, бұрылдым.
Dialogue: 8,0:08:15.28,0:08:17.31,Text - CN,,0,0,0,,Тадина Такайоши мүсіні өлі адам
Dialogue: 7,0:08:15.28,0:08:17.31,Text - JP,,0,0,0,,Ешкім болмаған сияқты
Dialogue: 8,0:08:17.85,0:08:19.97,Text - CN,,0,0,0,,Басқа уақытта
Dialogue: 7,0:08:17.85,0:08:19.97,Text - JP,,0,0,0,,Оны қазірдің өзінде тоқтатыңыз.
Dialogue: 8,0:08:22.17,0:08:24.60,Text - CN,,0,0,0,,Бұл классикалық елес оқиғасы
Dialogue: 7,0:08:22.17,0:08:24.60,Text - JP,,0,0,0,,Елес әңгіменің кең тараған түрі.
Dialogue: 8,0:08:27.08,0:08:29.49,Text - CN,,0,0,0,,Жол бойымен жүру қиын
Dialogue: 7,0:08:27.08,0:08:29.49,Text - JP,,0,0,0,,Бұл оңай дүние емес екенін білемін.
Dialogue: 8,0:08:29.49,0:08:32.23,Text - CN,,0,0,0,,Осыған байланысты
Dialogue: 7,0:08:29.49,0:08:32.23,Text - JP,,0,0,0,,Мама, мен сізді жалғастыруға мәжбүрлей алмаймын.
Dialogue: 8,0:08:32.23,0:08:33.70,Text - CN,,0,0,0,,Рио Чидо
Dialogue: 7,0:08:32.23,0:08:33.70,Text - JP,,0,0,0,,Мен білемін
Dialogue: 8,0:08:35.07,0:08:36.70,Text - CN,,0,0,0,,Мен тәжірибемді жоғалттым
Dialogue: 7,0:08:35.07,0:08:36.70,Text - JP,,0,0,0,,Менің ойымша, бұл оңай емес.
Dialogue: 8,0:08:38.21,0:08:40.33,Text - CN,,0,0,0,,Анонимді кездесу
Dialogue: 7,0:08:38.21,0:08:40.33,Text - JP,,0,0,0,,Үйге жылап баруым мүмкін
Dialogue: 8,0:08:40.88,0:08:43.29,Text - CN,,0,0,0,,Дегенмен, мен ешқашан құтылмаймын.
Dialogue: 7,0:08:40.88,0:08:43.29,Text - JP,,0,0,0,,Қашып кетуге тырыспаңыз.
Dialogue: 8,0:08:43.29,0:08:45.47,Text - CN,,0,0,0,,Кетудің ең жақсы жолы
Dialogue: 7,0:08:43.29,0:08:45.47,Text - JP,,0,0,0,,Қашатын жер болғаны жақсы.
Dialogue: 8,0:08:45.47,0:08:48.59,Text - CN,,0,0,0,,Тағы бір шолу Мен қайта қарауды жөн көрдім
Dialogue: 7,0:08:45.47,0:08:48.59,Text - JP,,0,0,0,,А, тоқта, тоқта, менің шешімім тайып тұр.
Dialogue: 8,0:08:48.86,0:08:50.59,Text - CN,,0,0,0,,Сіз нені айтасыз?
Dialogue: 7,0:08:48.86,0:08:50.59,Text - JP,,0,0,0,,Оны қалай айту керек
Dialogue: 8,0:08:51.28,0:08:53.81,Text - CN,,0,0,0,,Сіз шын бола аласыз.
Dialogue: 7,0:08:51.28,0:08:53.81,Text - JP,,0,0,0,,Сіз шынымен де әжеңізге ұқсайсыз.
Dialogue: 8,0:08:53.81,0:08:55.72,Text - CN,,0,0,0,,Бейне түзу сызық түбір жол тәрізді
Dialogue: 7,0:08:53.81,0:08:55.72,Text - JP,,0,0,0,,Менің энергиям жеткіліксіз.
Dialogue: 8,0:08:55.97,0:09:00.35,Text - CN,,0,0,0,,...
Dialogue: 7,0:08:55.97,0:09:00.35,Text - JP,,0,0,0,,Мен өзімді итеріп жатқан сияқтымын, бірақ айналамдағы адамдарды да итеріп жіберемін.
Dialogue: 8,0:09:00.85,0:09:02.98,Text - CN,,0,0,0,,Бұл туралы кенеттен сөйлескіңіз келе ме?
Dialogue: 7,0:09:00.85,0:09:02.98,Text - JP,,0,0,0,,ше? Қалай кенеттен?
Dialogue: 8,0:09:07.29,0:09:08.61,Text - CN,,0,0,0,,Мұндайды есту өте сирек
Dialogue: 7,0:09:07.29,0:09:08.61,Text - JP,,0,0,0,,Ештеңе
Dialogue: 8,0:09:15.43,0:09:17.64,Text - CN,,0,0,0,,Сіз осындасыз
Dialogue: 7,0:09:15.43,0:09:17.64,Text - JP,,0,0,0,,Ымырт қандай?
Dialogue: 8,0:09:20.35,0:09:23.50,Text - CN,,0,0,0,,Ошидж Дугаку Сіз жолды білесіз
Dialogue: 7,0:09:20.35,0:09:23.50,Text - JP,,0,0,0,,Мен Ошидж мырзаның осында келетінін білдім.
Dialogue: 8,0:09:23.50,0:09:25.25,Text - CN,,0,0,0,,Қайта кездеспеу
Dialogue: 7,0:09:23.50,0:09:25.25,Text - JP,,0,0,0,,Не?
Dialogue: 8,0:09:25.63,0:09:27.76,Text - CN,,0,0,0,,Бұл жәндіктің баласы.
Dialogue: 7,0:09:25.63,0:09:27.76,Text - JP,,0,0,0,,Бұл қате болуы мүмкін. Оны қате деп атаңыз.
Dialogue: 8,0:09:28.04,0:09:31.46,Text - CN,,0,0,0,,Бұл Мушиконың өлімі.
Dialogue: 7,0:09:28.04,0:09:31.46,Text - JP,,0,0,0,,Сіз жақсы қатесіз, мені жек көресіз, солай ма?
Dialogue: 8,0:09:32.59,0:09:34.22,Text - CN,,0,0,0,,Мүмкіндігінше аз
Dialogue: 7,0:09:32.59,0:09:34.22,Text - JP,,0,0,0,,Бұл аруақтан жақсы.
Dialogue: 8,0:09:35.23,0:09:37.05,Text - CN,,0,0,0,,Сіз өзіңіз үшін сөйлей аласыз
Dialogue: 7,0:09:35.23,0:09:37.05,Text - JP,,0,0,0,,Мен мұны өзім айтамын
Dialogue: 8,0:09:37.05,0:09:39.73,Text - CN,,0,0,0,,«Үлкен үй туралы ертегі».
Dialogue: 7,0:09:37.05,0:09:39.73,Text - JP,,0,0,0,,Неліктен барлығы елес хикаяларды ұнатады?
Dialogue: 8,0:09:39.73,0:09:41.52,Text - CN,,0,0,0,,...
Dialogue: 7,0:09:39.73,0:09:41.52,Text - JP,,0,0,0,,Менің уақытым жоқ.
Dialogue: 8,0:09:42.77,0:09:45.41,Text - CN,,0,0,0,,Мен оның бар екенін түсінемін.
Dialogue: 7,0:09:42.77,0:09:45.41,Text - JP,,0,0,0,,Менің ойымша, котодама деген нәрсе бар.
Dialogue: 8,0:09:45.41,0:09:48.15,Text - CN,,0,0,0,,Сөйлеу кезінде абай болыңыз.
Dialogue: 7,0:09:45.41,0:09:48.15,Text - JP,,0,0,0,,Дауыстап айтпаған дұрыс.
Dialogue: 8,0:09:48.65,0:09:50.90,Text - CN,,0,0,0,,Бұл сізге сынақ.
Dialogue: 7,0:09:48.65,0:09:50.90,Text - JP,,0,0,0,,Менің ойымша, сіз осылай айта бастадыңыз.
Dialogue: 8,0:09:51.68,0:09:55.53,Text - CN,,0,0,0,,Бар жағдай туралы ойласаңыз, тікелей сұраңыз.
Dialogue: 7,0:09:51.68,0:09:55.53,Text - JP,,0,0,0,,Бірдеңені сұрағың келсе де айтпау жақсы емес.
Dialogue: 8,0:10:01.66,0:10:03.17,Text - CN,,0,0,0,,Осы дискідегі ақпарат Неапольде пойызға мініп жатқан кезде жазылды.
Dialogue: 7,0:10:01.66,0:10:03.17,Text - JP,,0,0,0,,Өйткені...
Dialogue: 8,0:10:07.18,0:10:09.42,Text - CN,,0,0,0,,Өзіңді өлтіргің келсе
Dialogue: 7,0:10:07.18,0:10:09.42,Text - JP,,0,0,0,,Өз-өзіме қол жұмсамақ болғаным рас.
Dialogue: 8,0:10:10.80,0:10:14.36,Text - CN,,0,0,0,,Мәселеге қарасаң, тура кесу керек екені рас.
Dialogue: 7,0:10:10.80,0:10:14.36,Text - JP,,0,0,0,,Сіз оны естуді қиындатуға тырыссаңыз да, өте анық айттыңыз.
Dialogue: 8,0:10:14.36,0:10:17.56,Text - CN,,0,0,0,,Қосымша мәліметтер
Dialogue: 7,0:10:14.36,0:10:17.56,Text - JP,,0,0,0,,Мен бұл тақырыпты айтудың айналма жолын түсінбеймін.
Dialogue: 8,0:10:18.76,0:10:21.23,Text - CN,,0,0,0,,「」
Dialogue: 7,0:10:18.76,0:10:21.23,Text - JP,,0,0,0,,Сізде уайым болды ма?
Dialogue: 8,0:10:21.23,0:10:23.69,Text - CN,,0,0,0,,Кейбіреулер: «Болмайтын жер, бірақ қабылдау жоқ» дейді.
Dialogue: 7,0:10:21.23,0:10:23.69,Text - JP,,0,0,0,,Бұл азапты оқиға болды ма?
Dialogue: 8,0:10:24.11,0:10:26.81,Text - CN,,0,0,0,,Қайталанудың негізгі сұрағы
Dialogue: 7,0:10:24.11,0:10:26.81,Text - JP,,0,0,0,,Біртіндеп өзекке жақындаймыз.
Dialogue: 8,0:10:27.34,0:10:32.40,Text - CN,,0,0,0,,Тікелей сұраңыз: «Сіз бұл туралы ойламайсыз, бірақ өзіңізді өлтіруіңіз керек».
Dialogue: 7,0:10:27.34,0:10:32.40,Text - JP,,0,0,0,,Өз-өзіне қол жұмсамақ болғаныңыз тым нәзік болуы керек.
Dialogue: 8,0:10:32.40,0:10:33.32,Text - CN,,0,0,0,,Кешір
Dialogue: 7,0:10:32.40,0:10:33.32,Text - JP,,0,0,0,,Кешіріңіз
Dialogue: 8,0:10:36.93,0:10:37.83,Text - CN,,0,0,0,,Менің түсіндіруім
Dialogue: 7,0:10:36.93,0:10:37.83,Text - JP,,0,0,0,,Олардың өлімі ұйым ішінде дүрбелең тудырды
Dialogue: 8,0:10:39.49,0:10:43.33,Text - CN,,0,0,0,,Гая Шидо, өзін-өзі ақтау, қателік, өлім
Dialogue: 7,0:10:39.49,0:10:43.33,Text - JP,,0,0,0,,Білмеймін, өлгім келді ме, жоқ па.
Dialogue: 8,0:10:44.17,0:10:47.71,Text - CN,,0,0,0,,Кенеттен түрлі сезімдер пайда болады
Dialogue: 7,0:10:44.17,0:10:47.71,Text - JP,,0,0,0,,Мен кенеттен солай сезіндім.
Dialogue: 8,0:10:48.04,0:10:50.75,Text - CN,,0,0,0,,Осыдан кейін ұялшақтық пен сол оқудың жоқтығы сыртқа шықты.
Dialogue: 7,0:10:48.04,0:10:50.75,Text - JP,,0,0,0,,Мен оны Ошима мырзаға төгіп тастағанымда,
Dialogue: 8,0:10:50.75,0:10:54.97,Text - CN,,0,0,0,,Майға қоспалар қосу
Dialogue: 7,0:10:50.75,0:10:54.97,Text - JP,,0,0,0,,Анау бала, құйрық қанатшасын киіп, жайып жіберді.
Dialogue: 8,0:10:55.26,0:10:56.59,Text - CN,,0,0,0,,Жұмыстың тікелей астында
Dialogue: 7,0:10:55.26,0:10:56.59,Text - JP,,0,0,0,,Бұл сұмдық.
Dialogue: 8,0:10:56.59,0:10:58.01,Text - CN,,0,0,0,,Бұл түпнұсқа жұмыс.
Dialogue: 7,0:10:56.59,0:10:58.01,Text - JP,,0,0,0,,Бұл сұмдық
Dialogue: 8,0:10:59.95,0:11:03.31,Text - CN,,0,0,0,,Алайда оны мен жазғанмын.
Dialogue: 7,0:10:59.95,0:11:03.31,Text - JP,,0,0,0,,Бірақ мен одан да жаманмын, сондықтан бәрі жақсы.
Dialogue: 8,0:11:04.40,0:11:07.81,Text - CN,,0,0,0,,Сіз оны жаза алмайсыз.
Dialogue: 7,0:11:04.40,0:11:07.81,Text - JP,,0,0,0,,Эми Окабе сонда болды, бірақ ол кетті.
Dialogue: 8,0:11:08.71,0:11:12.65,Text - CN,,0,0,0,,Бұл кезде мен Ибуки догаку тобында болдым.
Dialogue: 7,0:11:08.71,0:11:12.65,Text - JP,,0,0,0,,Өйткені мен Ибуки-санның қасында болдым.
Dialogue: 8,0:11:12.65,0:11:15.36,Text - CN,,0,0,0,,Ибуки қазір оқшауланған.
Dialogue: 7,0:11:12.65,0:11:15.36,Text - JP,,0,0,0,,Ол адам қазір оқшауланған.
Dialogue: 8,0:11:15.36,0:11:16.95,Text - CN,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 7,0:11:15.36,0:11:16.95,Text - JP,,0,0,0,,Иә
Dialogue: 8,0:11:17.57,0:11:18.95,Text - CN,,0,0,0,,Менің келесі жұмысым
Dialogue: 7,0:11:17.57,0:11:18.95,Text - JP,,0,0,0,,Ең сорақысы шығар
Dialogue: 8,0:11:20.66,0:11:23.58,Text - CN,,0,0,0,,Гачидо Эбу Догаку діні
Dialogue: 7,0:11:20.66,0:11:23.58,Text - JP,,0,0,0,,Мен Окабе мырзаны қорлағанын білемін.
Dialogue: 8,0:11:24.20,0:11:28.02,Text - CN,,0,0,0,,Мен сұхбатқа қатыспадым, бірақ көрмедім.
Dialogue: 7,0:11:24.20,0:11:28.02,Text - JP,,0,0,0,,Мен кінәлі емес едім, бірақ көзімді жұмдым.
Dialogue: 8,0:11:28.02,0:11:30.43,Text - CN,,0,0,0,,Сондықтан мен де несие картамды жоғалтып алдым.
Dialogue: 7,0:11:28.02,0:11:30.43,Text - JP,,0,0,0,,Мен де басқалардың атынан айта алмаймын.
Dialogue: 8,0:11:32.40,0:11:35.00,Text - CN,,0,0,0,,Бастапқыда жарамсыз
Dialogue: 7,0:11:32.40,0:11:35.00,Text - JP,,0,0,0,,Бұлай болмауы керек еді.
Dialogue: 8,0:11:37.93,0:11:41.85,Text - CN,,0,0,0,,Сөйлемді аяқта: Сөйлемді аяқтады.
Dialogue: 7,0:11:37.93,0:11:41.85,Text - JP,,0,0,0,,Осы сөздермен ол мектептен шықты.
Dialogue: 8,0:11:42.89,0:11:45.06,Text - CN,,0,0,0,,«Бастапқыда конституцияға қайшы»
Dialogue: 7,0:11:42.89,0:11:45.06,Text - JP,,0,0,0,,Бұлай болмауы керек еді.
Dialogue: 8,0:11:45.06,0:11:48.86,Text - CN,,0,0,0,,Мен өте таза емеспін, бірақ мен студентпін.
Dialogue: 7,0:11:45.06,0:11:48.86,Text - JP,,0,0,0,,Қанша оқушы бұл туралы әр жағдайда ойлады?
Dialogue: 8,0:11:50.25,0:11:54.62,Text - CN,,0,0,0,,Шынайы ойлар сізге ерекше түрде келеді
Dialogue: 7,0:11:50.25,0:11:54.62,Text - JP,,0,0,0,,Менімен хабарласу үшін қиналып жатқаныңызға таң қалдым.
Dialogue: 8,0:11:54.62,0:11:58.07,Text - CN,,0,0,0,,...
Dialogue: 7,0:11:54.62,0:11:58.07,Text - JP,,0,0,0,,Мен қазір сіздің қызыңыздың нұсқаушысымын.
Dialogue: 8,0:11:58.63,0:12:01.12,Text - CN,,0,0,0,,Сіз менің сүйікті анамсыз.
Dialogue: 7,0:11:58.63,0:12:01.12,Text - JP,,0,0,0,,Мен сізді жақсы ана деп естідім.
Dialogue: 8,0:12:01.12,0:12:03.95,Text - CN,,0,0,0,,Тұзыма тұрмайтын жақсы ана.
Dialogue: 7,0:12:01.12,0:12:03.95,Text - JP,,0,0,0,,Мен жақсы ана емеспін.
Dialogue: 8,0:12:04.26,0:12:07.46,Text - CN,,0,0,0,,Алайда ананың анасы болуы керек.
Dialogue: 7,0:12:04.26,0:12:07.46,Text - JP,,0,0,0,,Бірақ бақаның баласы бақа ғой.
Dialogue: 8,0:12:07.79,0:12:09.92,Text - CN,,0,0,0,,Бұлай емес.
Dialogue: 7,0:12:07.79,0:12:09.92,Text - JP,,0,0,0,,Бұл да басқаша.
Dialogue: 8,0:12:09.92,0:12:11.96,Text - CN,,0,0,0,,Өйткені мен зейнеткер студентпін.
Dialogue: 7,0:12:09.92,0:12:11.96,Text - JP,,0,0,0,,Өйткені мен зейнеткермін.
Dialogue: 8,0:12:14.00,0:12:15.96,Text - CN,,0,0,0,,Мен көрген нәрсе менің кінәм.
Dialogue: 7,0:12:14.00,0:12:15.96,Text - JP,,0,0,0,,Менің ойымша, бұл жаза.
Dialogue: 8,0:12:15.96,0:12:19.34,Text - CN,,0,0,0,,Мен бар жолды білемін, бірақ мен өзімшілмін.
Dialogue: 7,0:12:15.96,0:12:19.34,Text - JP,,0,0,0,,Бұлай ойлау менмендік екенін білемін.
Dialogue: 8,0:12:20.15,0:12:23.01,Text - CN,,0,0,0,,Күннің соңында қашып құтыласың.
Dialogue: 7,0:12:20.15,0:12:23.01,Text - JP,,0,0,0,,Мен Авашимадан қаштым, бірақ қашып құтыла алмаймын.
Dialogue: 8,0:12:24.10,0:12:27.44,Text - CN,,0,0,0,,Әйелімнің сәтті кездесуі
Dialogue: 7,0:12:24.10,0:12:27.44,Text - JP,,0,0,0,,Менің қызым міндетті түрде жетістікке жетеді.
Dialogue: 8,0:12:27.44,0:12:29.69,Text - CN,,0,0,0,,Менде әртүрлілік бар
Dialogue: 7,0:12:27.44,0:12:29.69,Text - JP,,0,0,0,,Мен солай сезінемін.
Dialogue: 8,0:12:29.69,0:12:32.86,Text - CN,,0,0,0,,Мен бұл туралы ештеңе істей алмаймын.
Dialogue: 7,0:12:29.69,0:12:32.86,Text - JP,,0,0,0,,Мен бұған шынымен қуана алмаймын.
Dialogue: 8,0:12:32.86,0:12:35.11,Text - CN,,0,0,0,,...
Dialogue: 7,0:12:32.86,0:12:35.11,Text - JP,,0,0,0,,Бұл жағымсыз, солай ма?
Dialogue: 8,0:12:36.00,0:12:39.61,Text - CN,,0,0,0,,Бұл елде не шындық?
Dialogue: 7,0:12:36.00,0:12:39.61,Text - JP,,0,0,0,,Бұл жер қар үйіндісі ме?
Dialogue: 8,0:12:38.79,0:12:40.74,Text - CN - UP,,0,0,0,,Іске қосу және разрядтау
Dialogue: 7,0:12:38.79,0:12:40.74,Text - JP - UP,,0,0,0,,Дайындықты бастау
Dialogue: 8,0:12:42.66,0:12:44.55,Text - CN,,0,0,0,,Маған оңға және солға 30 минут қалдыру керек.
Dialogue: 7,0:12:42.66,0:12:44.55,Text - JP,,0,0,0,,Мен 30 минуттай боламын.
Dialogue: 8,0:12:44.55,0:12:46.46,Text - CN,,0,0,0,,Жақсы Гачидорё
Dialogue: 7,0:12:44.55,0:12:46.46,Text - JP,,0,0,0,,А, мен түсіндім.
Dialogue: 8,0:12:49.87,0:12:54.17,Text - CN,,0,0,0,,Бұл дұрыс емес.
Dialogue: 7,0:12:49.87,0:12:54.17,Text - JP,,0,0,0,,Ол кісі де жазаланып жатыр ма деп ойлаймын.
Dialogue: 8,0:12:55.24,0:12:56.44,Text - CN - UP,,800,0,0,,Қарияны қайта көр
Dialogue: 7,0:12:55.24,0:12:56.44,Text - JP - UP,,800,0,0,,Қош бол мұғалім
Dialogue: 8,0:12:55.83,0:12:57.59,Text - CN - UP,,0,800,0,,Мейтеняпопокё ілімдері
Dialogue: 7,0:12:55.83,0:12:57.59,Text - JP - UP,,0,800,0,,Біз ертең сізбен жұмыс істеуді асыға күтеміз.
Dialogue: 8,0:12:57.59,0:12:59.63,Text - CN,,0,0,0,,...
Dialogue: 7,0:12:57.59,0:12:59.63,Text - JP,,0,0,0,,Мен де солай.
Dialogue: 8,0:12:57.59,0:12:59.63,Text - CN - UP,,0,0,0,,Төзгісіз ауырсыну
Dialogue: 7,0:12:57.59,0:12:59.63,Text - JP - UP,,0,0,0,,Сен бүкіл отбасыңмен бірге осыған көшіп алғаның дұрыс.
Dialogue: 8,0:13:05.11,0:13:06.44,Text - CN,,0,0,0,,Жақсы ойлар
Dialogue: 7,0:13:05.11,0:13:06.44,Text - JP,,0,0,0,,Уф!
Dialogue: 8,0:13:12.94,0:13:18.32,Text - CN,,0,0,0,,...
Dialogue: 7,0:13:12.94,0:13:18.32,Text - JP,,0,0,0,,Кем дегенде, бұл біз үшін сағыныш сезімін тудыратын жер емес.
Dialogue: 8,0:13:18.57,0:13:20.82,Text - CN - UP,,0,0,0,,Сіз сол мектептен кеттіңіз.
Dialogue: 7,0:13:18.57,0:13:20.82,Text - JP - UP,,0,0,0,,Окабе мырзаның отставкаға кеткенін естідім.
Dialogue: 8,0:13:20.82,0:13:22.38,Text - CN - UP,,0,0,0,,Бұл...
Dialogue: 7,0:13:20.82,0:13:22.38,Text - JP - UP,,0,0,0,,Өйткені...
Dialogue: 8,0:13:22.38,0:13:23.45,Text - CN - UP,,0,0,0,,Гасоязе
Dialogue: 7,0:13:22.38,0:13:23.45,Text - JP - UP,,0,0,0,,Дұрыс?
Dialogue: 8,0:13:23.45,0:13:25.37,Text - CN - UP,,0,0,0,,...
Dialogue: 7,0:13:23.45,0:13:25.37,Text - JP - UP,,0,0,0,,Қызық, ол қандай тұлға жасайды?
Dialogue: 8,0:13:25.37,0:13:26.20,Text - CN - UP,,0,0,0,,Қабылдау
Dialogue: 7,0:13:25.37,0:13:26.20,Text - JP - UP,,0,0,0,,Эй
Dialogue: 8,0:13:33.27,0:13:35.34,Text - CN,,0,0,0,,Йошиёши Хаяками
Dialogue: 7,0:13:33.27,0:13:35.34,Text - JP,,0,0,0,,Қайырлы таң
Dialogue: 8,0:13:42.07,0:13:44.69,Text - CN,,0,0,0,,``Саяками Йоши'' - ең күрделі өлең.
Dialogue: 7,0:13:42.07,0:13:44.69,Text - JP,,0,0,0,,Қайырлы таң деп те айтпадым.
Dialogue: 8,0:13:44.69,0:13:47.97,Text - CN,,0,0,0,,Мен бұл жағдайға мүлдем бейхабармын.
Dialogue: 7,0:13:44.69,0:13:47.97,Text - JP,,0,0,0,,Әу баста ол жоқ сияқты мен оны елемей қалдым.
Dialogue: 8,0:13:48.73,0:13:50.95,Text - CN,,0,0,0,,Өз өмірің туралы ойлау
Dialogue: 7,0:13:48.73,0:13:50.95,Text - JP,,0,0,0,,Өз еңбегінің арқасында
Dialogue: 8,0:13:52.93,0:13:57.61,Text - CN,,0,0,0,,...
Dialogue: 7,0:13:52.93,0:13:57.61,Text - JP,,0,0,0,,Гя, бұрынғыдан мүлде өзгерген жоқ.
Dialogue: 8,0:13:58.23,0:14:01.57,Text - CN,,0,0,0,,Нари - нари, нари - таншима
Dialogue: 7,0:13:58.23,0:14:01.57,Text - JP,,0,0,0,,Дұрыс, бұл Авашима.
Dialogue: 8,0:14:01.57,0:14:04.99,Text - CN,,0,0,0,,Менің қызым Зенаридің шәкірті.
Dialogue: 7,0:14:01.57,0:14:04.99,Text - JP,,0,0,0,,Немерем сонда студент.
Dialogue: 8,0:14:03.87,0:14:04.99,Text - CN - UP,,0,0,0,,...
Dialogue: 7,0:14:03.87,0:14:04.99,Text - JP - UP,,0,0,0,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 8,0:14:04.99,0:14:06.87,Text - CN,,0,0,0,,Накамари зияны
Dialogue: 7,0:14:04.99,0:14:06.87,Text - JP,,0,0,0,,О, бұл таңқаларлық.
Dialogue: 8,0:14:06.87,0:14:09.77,Text - CN,,0,0,0,,Бұл басқа адамдар үшін мәдени мереке.
Dialogue: 7,0:14:06.87,0:14:09.77,Text - JP,,0,0,0,,Бүгін мектеп мерекесі.
Dialogue: 8,0:14:09.77,0:14:13.16,Text - CN,,0,0,0,,Мен баратын жер менің әйелім.
Dialogue: 7,0:14:09.77,0:14:13.16,Text - JP,,0,0,0,,Бұл менің көрші қызым.
Dialogue: 8,0:14:13.16,0:14:15.23,Text - CN,,0,0,0,,Бұл да Танцяоның аты
Dialogue: 7,0:14:13.16,0:14:15.23,Text - JP,,0,0,0,,Бұл бала да Авашимадан.
Dialogue: 8,0:14:15.23,0:14:18.04,Text - CN,,0,0,0,,Энка отбасының негізгі себебі - бұл тамаша.
Dialogue: 7,0:14:15.23,0:14:18.04,Text - JP,,0,0,0,,Әй, ата-ана мен бала ұрпақтары тамаша.
Dialogue: 8,0:14:18.04,0:14:20.38,Text - CN,,0,0,0,,Түсіндірме қандай?
Dialogue: 7,0:14:18.04,0:14:20.38,Text - JP,,0,0,0,,Бұл дұрыс.
Dialogue: 8,0:14:20.38,0:14:22.38,Text - CN,,0,0,0,,...
Dialogue: 7,0:14:20.38,0:14:22.38,Text - JP,,0,0,0,,Маған ұнамайды, мама.
Dialogue: 8,0:14:22.38,0:14:25.35,Text - CN,,0,0,0,,Менің тамырым өлді
Dialogue: 7,0:14:22.38,0:14:25.35,Text - JP,,0,0,0,,Мен ол жақтан емеспін.
Dialogue: 8,0:14:26.06,0:14:27.85,Text - CN,,0,0,0,,Мен мектепті тастадым.
Dialogue: 7,0:14:26.06,0:14:27.85,Text - JP,,0,0,0,,Мен кеттім.
Dialogue: 8,0:14:28.46,0:14:30.02,Text - CN,,0,0,0,,Қашу
Dialogue: 7,0:14:28.46,0:14:30.02,Text - JP,,0,0,0,,Мен қашып кеттім
Dialogue: 8,0:14:34.77,0:14:36.31,Text - CN,,0,0,0,,Сумиоши Дугаку
Dialogue: 7,0:14:34.77,0:14:36.31,Text - JP,,0,0,0,,Сумиоши мырза
Dialogue: 8,0:14:37.18,0:14:40.56,Text - CN,,0,0,0,,Қазіргі уақытта қолжетімді емес
Dialogue: 7,0:14:37.18,0:14:40.56,Text - JP,,0,0,0,,Жоқ, бұл қазір Ифукубе мырза еді.
Dialogue: 8,0:14:40.56,0:14:43.78,Text - CN,,0,0,0,,...
Dialogue: 7,0:14:40.56,0:14:43.78,Text - JP,,0,0,0,,Осы жерде кездескенде мен өткенге қайта ораламын.
Dialogue: 8,0:14:46.49,0:14:47.87,Text - CN,,0,0,0,,Мен анамнан келдім.
Dialogue: 7,0:14:46.49,0:14:47.87,Text - JP,,0,0,0,,Мен анаммен келдім.
Dialogue: 8,0:14:48.16,0:14:51.00,Text - CN,,0,0,0,,...
Dialogue: 7,0:14:48.16,0:14:51.00,Text - JP,,0,0,0,,Сағыныш, сағыныш, Мектепті аралап жүрмін.
Dialogue: 8,0:14:52.93,0:14:54.59,Text - CN,,0,0,0,,Тағы бір жылау
Dialogue: 7,0:14:52.93,0:14:54.59,Text - JP,,0,0,0,,Жылама
Dialogue: 8,0:14:54.59,0:14:55.50,Text - CN,,0,0,0,,Кешір мені.
Dialogue: 7,0:14:54.59,0:14:55.50,Text - JP,,0,0,0,,Кешіріңіз
Dialogue: 8,0:14:56.36,0:14:58.51,Text - CN,,0,0,0,,Менің жоғары болуым мүмкін.
Dialogue: 7,0:14:56.36,0:14:58.51,Text - JP,,0,0,0,,Бірақ мен бақыттымын
Dialogue: 8,0:14:58.51,0:14:59.88,Text - CN,,0,0,0,,Менің шынайы құндылығым
Dialogue: 7,0:14:58.51,0:14:59.88,Text - JP,,0,0,0,,Мен бақыттымын.
Dialogue: 8,0:15:00.71,0:15:04.05,Text - CN,,0,0,0,,Жүрегіңе, жүрегіңе апаратын жолым.
Dialogue: 7,0:15:00.71,0:15:04.05,Text - JP,,0,0,0,,Мен сізде проблема бар екенін білемін
Dialogue: 8,0:15:04.05,0:15:06.26,Text - CN,,0,0,0,,Ичия Гая
Dialogue: 7,0:15:04.05,0:15:06.26,Text - JP,,0,0,0,,Менде де бар нәрсе
Dialogue: 8,0:15:07.66,0:15:10.93,Text - CN,,0,0,0,,Өз уақытыңыз туралы не ойлайсыз?
Dialogue: 7,0:15:07.66,0:15:10.93,Text - JP,,0,0,0,,Мен сенімен бірге бітіргім келді
Dialogue: 8,0:15:10.93,0:15:13.14,Text - CN,,0,0,0,,Осыған байланысты мәселенің ақиқаты
Dialogue: 7,0:15:10.93,0:15:13.14,Text - JP,,0,0,0,,Сондықтан мен бүгін бақыттымын.
Dialogue: 8,0:15:14.91,0:15:17.58,Text - CN,,0,0,0,,Мен не істеуім керек?
Dialogue: 7,0:15:14.91,0:15:17.58,Text - JP,,0,0,0,,Сағыныш сезімін сезінуге болады
Dialogue: 8,0:15:19.43,0:15:24.01,Text - CN,,0,0,0,,...
Dialogue: 7,0:15:19.43,0:15:24.01,Text - JP,,0,0,0,,Гүлдер қаласы Веронада екі беделді отбасы қатар тұрады.
Dialogue: 8,0:15:24.01,0:15:26.37,Text - CN,,0,0,0,,Ескі жапон жауы енді қайтадан жарылды
Dialogue: 7,0:15:24.01,0:15:26.37,Text - JP,,0,0,0,,Ескі өшпенділік енді қайтадан атқылайды.
Dialogue: 8,0:15:26.37,0:15:29.53,Text - CN,,0,0,0,,Sho Seiza Castle City көлемі қанға боялған жанжал
Dialogue: 7,0:15:26.37,0:15:29.53,Text - JP,,0,0,0,,Қаланы шарпыған қанды төбелес
Dialogue: 8,0:15:30.03,0:15:33.06,Text - CN,,0,0,0,,Баршаңызға, бізге қонаққа барғанда тәкаппар болыңыздар.
Dialogue: 7,0:15:30.03,0:15:33.06,Text - JP,,0,0,0,,Егер сіз мені екі сағаттай ықыласпен тыңдасаңыз.
Dialogue: 8,0:15:33.06,0:15:36.04,Text - CN,,0,0,0,,Біздің актерлар қолдарынан келгенін жасай білуі керек.
Dialogue: 7,0:15:33.06,0:15:36.04,Text - JP,,0,0,0,,Барлық актерлер өз мүмкіндіктеріне қарай өнер көрсетеді.
Dialogue: 8,0:15:39.88,0:15:41.05,Text - CN,,0,0,0,,...
Dialogue: 7,0:15:39.88,0:15:41.05,Text - JP,,0,0,0,,Сәлем Джульетта
Dialogue: 8,0:15:41.85,0:15:45.43,Text - CN,,0,0,0,,Үйленген кезде
Dialogue: 7,0:15:41.85,0:15:45.43,Text - JP,,0,0,0,,Үйлену туралы не ойлайсыз?
Dialogue: 8,0:15:45.88,0:15:49.64,Text - CN,,0,0,0,,Келіп өлгенде маған не болды?
Dialogue: 7,0:15:45.88,0:15:49.64,Text - JP,,0,0,0,,Мен үйлену туралы ешқашан ойлаған емеспін.
Dialogue: 8,0:15:49.64,0:15:51.18,Text - CN,,0,0,0,,На — Чжу Лияның айтылуы
Dialogue: 7,0:15:49.64,0:15:51.18,Text - JP,,0,0,0,,Бұл Джульеттаның желісі
Dialogue: 8,0:15:53.00,0:15:54.81,Text - CN,,0,0,0,,Елордаға саяхат туралы менің ойым
Dialogue: 7,0:15:53.00,0:15:54.81,Text - JP,,0,0,0,,Мүмкін екеуі де.
Dialogue: 8,0:15:56.02,0:15:58.56,Text - CN,,0,0,0,,Чжу Лия өзі және фююн
Dialogue: 7,0:15:56.02,0:15:58.56,Text - JP,,0,0,0,,Тіпті Джульетта да түсінбейді.
Dialogue: 8,0:15:58.56,0:16:01.67,Text - CN,,0,0,0,,Бұл 14 жыл бұрын
Dialogue: 7,0:15:58.56,0:16:01.67,Text - JP,,0,0,0,,Сіз әлі 14-ке толған жоқсыз, солай ма?
Dialogue: 8,0:16:02.24,0:16:04.57,Text - CN,,0,0,0,,Мереке қарсаңы
Dialogue: 7,0:16:02.24,0:16:04.57,Text - JP,,0,0,0,,Егін мерекесі қарсаңы
Dialogue: 8,0:16:05.07,0:16:09.70,Text - CN,,0,0,0,,31 шілдедегі түнгі ауыл
Dialogue: 7,0:16:05.07,0:16:09.70,Text - JP,,0,0,0,,31 шілдеге қараған түні мен 14-ке толдым.
Dialogue: 8,0:16:11.28,0:16:14.75,Text - CN,,0,0,0,,Жақсы ма, жаман ба, барсың, барсың, арқаң бар.
Dialogue: 7,0:16:11.28,0:16:14.75,Text - JP,,0,0,0,,Уау, мен барлық жолдарды жаттап алдым.
Dialogue: 8,0:16:17.13,0:16:19.66,Text - CN,,0,0,0,,Міне, менің қойылымымның бірінші көрінісі
Dialogue: 7,0:16:17.13,0:16:19.66,Text - JP,,0,0,0,,Әдемі спектакль қояйық.
Dialogue: 8,0:16:19.66,0:16:20.71,Text - CN,,0,0,0,,Қазірге дейін
Dialogue: 7,0:16:19.66,0:16:20.71,Text - JP,,0,0,0,,Иә
Dialogue: 8,0:16:23.35,0:16:26.22,Text - CN,,0,0,0,,Полидактилизм ханзада Такехара
Dialogue: 7,0:16:23.35,0:16:26.22,Text - JP,,0,0,0,,Танысқаныма қуаныштымын ханзада Такехара
Dialogue: 8,0:16:26.22,0:16:28.78,Text - CN,,0,0,0,,Риоко ханшайым
Dialogue: 7,0:16:26.22,0:16:28.78,Text - JP,,0,0,0,,Сәлеметсіз бе, Йошико ханшайым
Dialogue: 8,0:16:30.39,0:16:34.47,Text - CN,,0,0,0,,Еуропалық құпия студент қыз
Dialogue: 7,0:16:30.39,0:16:34.47,Text - JP,,0,0,0,,Бұл Ромео бала сүйкімді
Dialogue: 8,0:16:33.22,0:16:36.09,Text - CN - UP,,0,0,0,,Сіз Мэн Тайко отбасының мүшесісіз.
Dialogue: 7,0:16:33.22,0:16:36.09,Text - JP - UP,,0,0,0,,Сіз Ромео Монтегудікісіз
Dialogue: 8,0:16:34.47,0:16:36.85,Text - CN,,0,0,0,,Тегіңізді жазыңыз
Dialogue: 7,0:16:34.47,0:16:36.85,Text - JP,,0,0,0,,Мен сенің атыңды есте сақтауым керек.
Dialogue: 8,0:16:36.09,0:16:38.23,Text - CN - UP,,0,0,0,,Сұлу емес адам
Dialogue: 7,0:16:36.09,0:16:38.23,Text - JP - UP,,0,0,0,,Жоқ, сұлу адам.
Dialogue: 8,0:16:38.98,0:16:41.11,Text - CN - UP,,0,0,0,,Жас адамның аты-жөні
Dialogue: 7,0:16:38.98,0:16:41.11,Text - JP - UP,,0,0,0,,Егер сіз бұл есімді жек көрсеңіз
Dialogue: 8,0:16:41.31,0:16:44.86,Text - CN,,0,0,0,,Тайкорё
Dialogue: 7,0:16:41.31,0:16:44.86,Text - JP,,0,0,0,,Жақсы, жақсы, Ромеоның ариясы
Dialogue: 8,0:16:43.04,0:16:45.86,Text - CN - UP,,800,0,0,,Оны тағы көруге кім келеді?
Dialogue: 7,0:16:43.04,0:16:45.86,Text - JP - UP,,800,0,0,,Менің қылышым жетпейді, біреу тексеріп көр.
Dialogue: 8,0:16:44.32,0:16:45.86,Text - CN - UP,,0,800,0,,Менің қолдарым қайда?
Dialogue: 7,0:16:44.32,0:16:45.86,Text - JP - UP,,0,800,0,,Менің қолым әлі дірілдеп тұр.
Dialogue: 8,0:16:59.87,0:17:01.88,Text - CN,,0,0,0,,Сіз апаттық таяқшаны пайдалана аласыз
Dialogue: 7,0:16:59.87,0:17:01.88,Text - JP,,0,0,0,,Бұл өте жақсы болды.
Dialogue: 8,0:17:02.51,0:17:04.50,Text - CN,,0,0,0,,Кішігірім мәліметтер
Dialogue: 7,0:17:02.51,0:17:04.50,Text - JP,,0,0,0,,Кинуэ-чан
Dialogue: 8,0:17:04.90,0:17:06.01,Text - CN,,0,0,0,,Ене
Dialogue: 7,0:17:04.90,0:17:06.01,Text - JP,,0,0,0,,Апай
Dialogue: 8,0:17:06.01,0:17:09.98,Text - CN,,0,0,0,,Сен менің мақтанышымсың
Dialogue: 7,0:17:06.01,0:17:09.98,Text - JP,,0,0,0,,Керемет болды, мақтанышымсың.
Dialogue: 8,0:17:09.98,0:17:13.64,Text - CN,,0,0,0,,Мен ең бірінші ойлаған адам қайын енем болғандықтан, мен де бұл туралы ойлана бастадым.
Dialogue: 7,0:17:09.98,0:17:13.64,Text - JP,,0,0,0,,Мен қуанамын, өйткені алдымен апам көрсін деп едім.
Dialogue: 8,0:17:13.64,0:17:16.71,Text - CN,,0,0,0,,Қандай шындық?
Dialogue: 7,0:17:13.64,0:17:16.71,Text - JP,,0,0,0,,Бұл менің жолым.
Dialogue: 8,0:17:16.71,0:17:20.06,Text - CN,,0,0,0,,Егер сіз оны ала алмасаңыз, сіз аласыз.
Dialogue: 7,0:17:16.71,0:17:20.06,Text - JP,,0,0,0,,Өте жақсы болыңыз.
Dialogue: 8,0:17:17.89,0:17:20.06,Text - CN - UP,,0,0,0,,...
Dialogue: 7,0:17:17.89,0:17:20.06,Text - JP - UP,,0,0,0,,Мен Авашимаға кіремін
Dialogue: 8,0:17:22.58,0:17:26.78,Text - CN,,0,0,0,,Күйеу мен ене
Dialogue: 7,0:17:22.58,0:17:26.78,Text - JP,,0,0,0,,Кешіріңіз апа, мен біраз уақытқа досыма қонаққа барамын.
Dialogue: 8,0:17:34.87,0:17:36.04,Text - CN,,0,0,0,,Суық және суық
Dialogue: 7,0:17:34.87,0:17:36.04,Text - JP,,0,0,0,,Біз әдетте соншалықты алдын ала брондамаймыз, сондықтан асығыс емесбіз
Dialogue: 8,0:17:37.25,0:17:41.27,Text - CN,,0,0,0,,Мен бір нүктеде бола аламын.
Dialogue: 7,0:17:37.25,0:17:41.27,Text - JP,,0,0,0,,Әлі де толқығанымнан шығар. Мен мүлдем суық емеспін.
Dialogue: 8,0:17:41.27,0:17:42.29,Text - CN,,0,0,0,,Накафуджио
Dialogue: 7,0:17:41.27,0:17:42.29,Text - JP,,0,0,0,,Мүмкін емес
Dialogue: 8,0:17:44.03,0:17:45.32,Text - CN,,0,0,0,,Сезімталдық
Dialogue: 7,0:17:44.03,0:17:45.32,Text - JP,,0,0,0,,Мен суық тигіземін.
Dialogue: 8,0:17:47.17,0:17:49.42,Text - CN,,0,0,0,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 7,0:17:47.17,0:17:49.42,Text - JP,,0,0,0,,О, рахмет
Dialogue: 8,0:17:51.69,0:17:53.75,Text - CN,,0,0,0,,Сіз оны қысқартыңыз.
Dialogue: 7,0:17:51.69,0:17:53.75,Text - JP,,0,0,0,,Сіз шашыңызды қидырдыңыз, солай ма?
Dialogue: 8,0:17:55.90,0:17:58.14,Text - CN,,0,0,0,,Сіздің жоспарыңыз келесі кезеңге өту.
Dialogue: 7,0:17:55.90,0:17:58.14,Text - JP,,0,0,0,,Мен әлі де актриса болуды мақсат етіп жүрмін.
Dialogue: 8,0:17:59.75,0:18:01.56,Text - CN,,0,0,0,,Мен қиялшылмын.
Dialogue: 7,0:17:59.75,0:18:01.56,Text - JP,,0,0,0,,Мен болғанымды қалаймын
Dialogue: 8,0:18:04.40,0:18:08.57,Text - CN,,0,0,0,,Мүмкін оқиға Тікелей орындаған Соичи Гасо
Dialogue: 7,0:18:04.40,0:18:08.57,Text - JP,,0,0,0,,Сондықтан, мүмкін болса, мен мұны мәңгілікке жалғастырғым келеді.
Dialogue: 8,0:18:10.51,0:18:11.57,Text - CN,,0,0,0,,...
Dialogue: 7,0:18:10.51,0:18:11.57,Text - JP,,0,0,0,,Ryoko-san
Dialogue: 8,0:18:11.99,0:18:13.07,Text - CN,,0,0,0,,Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады
Dialogue: 7,0:18:11.99,0:18:13.07,Text - JP,,0,0,0,,Иә?
Dialogue: 8,0:18:13.61,0:18:17.20,Text - CN,,0,0,0,,Қолайсыздықтар үшін кешірім сұраймын.
Dialogue: 7,0:18:13.61,0:18:17.20,Text - JP,,0,0,0,,Мен мұны әлі де ысырап деп ойлаймын.
Dialogue: 8,0:18:20.53,0:18:22.48,Text - CN,,0,0,0,,Барлық құқықтар қорғалған.
Dialogue: 7,0:18:20.53,0:18:22.48,Text - JP,,0,0,0,,Авашима бәрі емес
Dialogue: 8,0:18:24.83,0:18:27.13,Text - CN,,0,0,0,,Бұл бетті оқымаңыз.
Dialogue: 7,0:18:24.83,0:18:27.13,Text - JP,,0,0,0,,Сіз айтасыз
Dialogue: 8,0:18:27.13,0:18:28.55,Text - CN,,0,0,0,,Мен мынаны айтамын...
Dialogue: 7,0:18:27.13,0:18:28.55,Text - JP,,0,0,0,,Өйткені...
Dialogue: 8,0:18:31.12,0:18:33.01,Text - CN,,0,0,0,,Мен ойлағандай емес.
Dialogue: 7,0:18:31.12,0:18:33.01,Text - JP,,0,0,0,,Бірақ мен солай ойладым.
Dialogue: 8,0:18:33.77,0:18:37.81,Text - CN,,0,0,0,,Менің тікелей ойларым – өз мағыналарым.
Dialogue: 7,0:18:33.77,0:18:37.81,Text - JP,,0,0,0,,Бұл жерде болудың мәні туралы жалғыз мен ғана ойладым.
Dialogue: 8,0:18:38.84,0:18:40.06,Text - CN,,0,0,0,,Үздіксіз тоқтата тұру
Dialogue: 7,0:18:38.84,0:18:40.06,Text - JP,,0,0,0,,(Rodanse) Тыныш болыңыздар, өтінемін. (Bluebell) Ой!
Dialogue: 8,0:18:41.41,0:18:46.33,Text - CN,,0,0,0,,Менің кітабым иықтың алдыңғы жағымен бірдей мақалада жазылған
Dialogue: 7,0:18:41.41,0:18:46.33,Text - JP,,0,0,0,,Сен екеуміз бір жолмен жүруіміз керек еді.
Dialogue: 8,0:18:46.33,0:18:48.82,Text - CN,,0,0,0,,Неше минут бар?
Dialogue: 7,0:18:46.33,0:18:48.82,Text - JP,,0,0,0,,Неліктен басқаша болды?
Dialogue: 8,0:18:50.07,0:18:52.07,Text - CN,,0,0,0,,Дегенмен, ол эго-центрлік.
Dialogue: 7,0:18:50.07,0:18:52.07,Text - JP,,0,0,0,,Бірақ бұл эго.
Dialogue: 8,0:18:52.58,0:18:56.65,Text - CN,,0,0,0,,Мен жанашыр екенімді растаймын.
Dialogue: 7,0:18:52.58,0:18:56.65,Text - JP,,0,0,0,,Мен сені аядым.
Dialogue: 8,0:18:56.65,0:19:01.06,Text - CN,,0,0,0,,Мен резидент болғандықтан, қайтып келген соң сізге қолдау көрсетуге мүмкіндігім бар.
Dialogue: 7,0:18:56.65,0:19:01.06,Text - JP,,0,0,0,,Мен қазір отбасымның қолдауының арқасында осындамын.
Dialogue: 8,0:19:01.06,0:19:03.58,Text - CN,,0,0,0,,Бұлай емес
Dialogue: 7,0:19:01.06,0:19:03.58,Text - JP,,0,0,0,,Сіз болмаған
Dialogue: 8,0:19:04.83,0:19:08.46,Text - CN,,800,0,0,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 7,0:19:04.83,0:19:08.46,Text - JP,,800,0,0,,Жалғыздық деп қателестім.
Dialogue: 8,0:19:08.46,0:19:09.96,Text - CN,,0,0,0,,Кешір
Dialogue: 7,0:19:08.46,0:19:09.96,Text - JP,,0,0,0,,Кешіріңіз
Dialogue: 8,0:19:11.46,0:19:13.42,Text - CN,,0,0,0,,Сіз...
Dialogue: 7,0:19:11.46,0:19:13.42,Text - JP,,0,0,0,,Кинюэ-сан рас...
Dialogue: 8,0:19:14.63,0:19:17.22,Text - CN,,0,0,0,,Бұл жылыжайды айналып өте алатын қарт.
Dialogue: 7,0:19:14.63,0:19:17.22,Text - JP,,0,0,0,,Ол таза мәдениетті жақсы адам.
Dialogue: 8,0:19:18.18,0:19:19.60,Text - CN,,0,0,0,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 7,0:19:18.18,0:19:19.60,Text - JP,,0,0,0,,Кітапханада жәндіктер ұяласып жатыр ма? Бұл өте қорқынышты.
Dialogue: 8,0:19:21.10,0:19:24.27,Text - CN,,0,0,0,,Менің ойлау әдісім өзгерді
Dialogue: 7,0:19:21.10,0:19:24.27,Text - JP,,0,0,0,,Менікі - шіркін сезімдер.
Dialogue: 8,0:19:24.27,0:19:25.10,Text - CN,,0,0,0,,Қайда бару керек?
Dialogue: 7,0:19:24.27,0:19:25.10,Text - JP,,0,0,0,,Солай ма?
Dialogue: 8,0:19:25.56,0:19:26.81,Text - CN,,0,0,0,,Э-э, Ллойд мырза, жатын бөлмелерге келсек…
Dialogue: 7,0:19:25.56,0:19:26.81,Text - JP,,0,0,0,,Юкине-кун, бұл адамды танисың ба?
Dialogue: 8,0:19:27.90,0:19:31.86,Text - CN,,0,0,0,,Мен Риоко Хигазенриотаро көруге келдім
Dialogue: 7,0:19:27.90,0:19:31.86,Text - JP,,0,0,0,,Мен үшін Риоко әлдеқайда жақсы адам.
Dialogue: 8,0:19:32.69,0:19:35.70,Text - CN,,0,0,0,,...
Dialogue: 7,0:19:32.69,0:19:35.70,Text - JP,,0,0,0,,Мен жүретін жол
Dialogue: 8,0:19:35.70,0:19:38.87,Text - CN,,0,0,0,,Орындалу және келу
Dialogue: 7,0:19:35.70,0:19:38.87,Text - JP,,0,0,0,,Чимми мен рю көбейген дүние.
Dialogue: 8,0:19:39.20,0:19:41.08,Text - CN,,0,0,0,,Бар болу мен жоқ болу арасындағы айырмашылық
Dialogue: 7,0:19:39.20,0:19:41.08,Text - JP,,0,0,0,,Меніңше, қазір онша ерекшеленбейді.
Dialogue: 8,0:19:43.24,0:19:48.16,Text - CN,,0,0,0,,Жастар таза, сұлу жандарды сипалап, сезінеді.
Dialogue: 7,0:19:43.24,0:19:48.16,Text - JP,,0,0,0,,Мен сондай сұлу жанды ұстағаныма сенімдімін
Dialogue: 8,0:19:48.16,0:19:50.63,Text - CN,,0,0,0,,Бекіту кездесуіне рұқсат етілмейді.
Dialogue: 7,0:19:48.16,0:19:50.63,Text - JP,,0,0,0,,Сен қайда бардың?
Dialogue: 8,0:19:50.98,0:19:52.76,Text - CN,,0,0,0,,«Өкінішке орай, сәттілік келді».
Dialogue: 7,0:19:50.98,0:19:52.76,Text - JP,,0,0,0,,«Бірақ сенің келгеніңе қуаныштымын».
Dialogue: 8,0:19:53.72,0:19:56.05,Text - CN,,0,0,0,,Менің бастапқы жоспарым жоспарды түсіндіру болатын.
Dialogue: 7,0:19:53.72,0:19:56.05,Text - JP,,0,0,0,,Бұл сөздер мен айтайын деп шештім.
Dialogue: 8,0:19:57.44,0:20:00.10,Text - CN,,0,0,0,,Мен оны алғандықтан, мен оны қалдыруды шештім.
Dialogue: 7,0:19:57.44,0:20:00.10,Text - JP,,0,0,0,,Барар алдында осыны ойлағым келді.
Dialogue: 8,0:20:01.05,0:20:04.35,Text - CN,,0,0,0,,Өйткені мен ойымды өзгерттім
Dialogue: 7,0:20:01.05,0:20:04.35,Text - JP,,0,0,0,,Себебі мен бұдан былай ұсқынсыз болғым келмеді.
Dialogue: 8,0:20:05.74,0:20:07.22,Text - CN,,0,0,0,,Аяе
Dialogue: 7,0:20:05.74,0:20:07.22,Text - JP,,0,0,0,,Кинуэ-сан
Dialogue: 8,0:20:07.22,0:20:08.27,Text - CN,,0,0,0,,Әрине, бөлек.
Dialogue: 7,0:20:07.22,0:20:08.27,Text - JP,,0,0,0,,Иә
Dialogue: 8,0:20:08.53,0:20:11.57,Text - CN,,0,0,0,,Мен бұрын нені елестеттім?
Dialogue: 7,0:20:08.53,0:20:11.57,Text - JP,,0,0,0,,Мен сен болғым келді
Dialogue: 8,0:20:13.87,0:20:15.32,Text - CN,,0,0,0,,Дайынсың ба?
Dialogue: 7,0:20:13.87,0:20:15.32,Text - JP,,0,0,0,,Мен?
Dialogue: 8,0:20:15.32,0:20:16.28,Text - CN,,0,0,0,,...
Dialogue: 7,0:20:15.32,0:20:16.28,Text - JP,,0,0,0,,Иә
Dialogue: 8,0:20:16.91,0:20:18.72,Text - CN,,0,0,0,,Бір адамның мүсіні
Dialogue: 7,0:20:16.91,0:20:18.72,Text - JP,,0,0,0,,Сіз сияқты
Dialogue: 8,0:20:18.72,0:20:22.79,Text - CN,,0,0,0,,Бұл сіз ойлағандай емес.
Dialogue: 7,0:20:18.72,0:20:22.79,Text - JP,,0,0,0,,Дұрысы, мен сен болғым келді.
Dialogue: 8,0:20:24.54,0:20:27.04,Text - CN,,0,0,0,,Мұны істеуге болады.
Dialogue: 7,0:20:24.54,0:20:27.04,Text - JP,,0,0,0,,Міне.
Dialogue: 8,0:20:29.97,0:20:31.71,Text - CN,,0,0,0,,Сәттілік енді осында.
Dialogue: 7,0:20:29.97,0:20:31.71,Text - JP,,0,0,0,,Бүгін келгеніңізге қуаныштымын.
Dialogue: 8,0:20:32.59,0:20:34.55,Text - CN,,0,0,0,,...
Dialogue: 7,0:20:32.59,0:20:34.55,Text - JP,,0,0,0,,Мен ертерек ойлағандай болдым, бірақ
Dialogue: 8,0:20:34.55,0:20:35.30,Text - CN,,0,0,0,,Бетперделеу?
Dialogue: 7,0:20:34.55,0:20:35.30,Text - JP,,0,0,0,,Өтініш?
Dialogue: 8,0:20:36.21,0:20:37.93,Text - CN,,0,0,0,,Бір сәттік сөз шын жүректен сыр шертеді
Dialogue: 7,0:20:36.21,0:20:37.93,Text - JP,,0,0,0,,Мен қазір байыптымын
Dialogue: 8,0:20:42.33,0:20:45.18,Text - CN,,0,0,0,,Жүректен алған әсерді аяқтау
Dialogue: 7,0:20:42.33,0:20:45.18,Text - JP,,0,0,0,,Кеудемдегі тарлық басылды.
Dialogue: 8,0:20:49.05,0:20:50.61,Text - CN,,0,0,0,,Жоқ немесе жоқ
Dialogue: 7,0:20:49.05,0:20:50.61,Text - JP,,0,0,0,,Сол Мидория жігіті
Dialogue: 8,0:20:51.48,0:20:53.44,Text - CN,,0,0,0,,Қарапайым түсініктеме
Dialogue: 7,0:20:51.48,0:20:53.44,Text - JP,,0,0,0,,Мүмкін бұл оңай емес шығар
Dialogue: 8,0:20:55.44,0:20:59.20,Text - CN,,0,0,0,,Бұл дұрыс емес.
Dialogue: 7,0:20:55.44,0:20:59.20,Text - JP,,0,0,0,,Бірақ бұл сәл оңайырақ екені рас.
Dialogue: 8,0:21:01.53,0:21:05.83,Text - CN,,0,0,0,,Менің қасіретімнің келе жатқан капиталы - менің өзім.
Dialogue: 7,0:21:01.53,0:21:05.83,Text - JP,,0,0,0,,Мен өзімді қинайтынмын
Dialogue: 8,0:21:07.89,0:21:11.57,Text - CN,,0,0,0,,Су құдықтың түбінде айна бір жағында.
Dialogue: 7,0:21:07.89,0:21:11.57,Text - JP,,0,0,0,,Қар үйіндісінің түбінде айна бар деп ойлаймын.
Dialogue: 8,0:21:13.00,0:21:15.46,Text - CN,,0,0,0,,Ой және тез жеңілдету
Dialogue: 7,0:21:13.00,0:21:15.46,Text - JP,,0,0,0,,Мен өзімді тез жақсы сезінгім келеді
Dialogue: 8,0:21:16.01,0:21:21.97,Text - CN,,0,0,0,,Қосылу, еру, қашу және ауырсыну
Dialogue: 7,0:21:16.01,0:21:21.97,Text - JP,,0,0,0,,Мен өзімді жайлы сезінгім келді, бірақ азап шекті.
Dialogue: 8,0:21:22.54,0:21:23.72,Text - CN,,0,0,0,,Сіз Ибукисіз
Dialogue: 7,0:21:22.54,0:21:23.72,Text - JP,,0,0,0,,Ибуки мырза
Dialogue: 8,0:21:26.51,0:21:30.98,Text - CN,,0,0,0,,Мен Сумиошимін
Dialogue: 7,0:21:26.51,0:21:30.98,Text - JP,,0,0,0,,Мен... Мен Сумиошимін.
Dialogue: 8,0:21:31.81,0:21:34.11,Text - CN,,0,0,0,,Бамбук... Манабу Такехара
Dialogue: 7,0:21:31.81,0:21:34.11,Text - JP,,0,0,0,,Та… Такехара Сенпай
Dialogue: 8,0:21:36.91,0:21:37.49,Text - CN,,0,0,0,,Дугаку Табата
Dialogue: 7,0:21:36.91,0:21:37.49,Text - JP,,0,0,0,,Табата мырза
Dialogue: 8,0:21:37.49,0:21:39.00,Text - CN,,0,0,0,,Қолымды сермеші
Dialogue: 7,0:21:37.49,0:21:39.00,Text - JP,,0,0,0,,Қол алысыңыз
Dialogue: 8,0:21:39.00,0:21:40.82,Text - CN,,0,0,0,,Шынайы мағына
Dialogue: 7,0:21:39.00,0:21:40.82,Text - JP,,0,0,0,,Сіз не айтып жатырсыз?
Dialogue: 8,0:21:40.82,0:21:42.87,Text - CN,,0,0,0,,Келесі жылы сіз сонда жете аласыз
Dialogue: 7,0:21:40.82,0:21:42.87,Text - JP,,0,0,0,,Келесі жыл ешкімнің ісі емес пе?
Dialogue: 8,0:21:43.32,0:21:46.94,Text - CN,,0,0,0,,Дегенмен, бұл ең жақсы өнімділік
Dialogue: 7,0:21:43.32,0:21:46.94,Text - JP,,0,0,0,,Бірақ бірақ бұл өте жақсы болды.
Dialogue: 8,0:21:46.94,0:21:48.00,Text - CN,,0,0,0,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 7,0:21:46.94,0:21:48.00,Text - JP,,0,0,0,,Рахмет
Dialogue: 8,0:21:48.50,0:21:51.71,Text - CN,,0,0,0,,Шолу
Dialogue: 7,0:21:48.50,0:21:51.71,Text - JP,,0,0,0,,Шынымды айтсам, біраз уайымдадым.
Dialogue: 8,0:21:52.48,0:21:55.50,Text - CN,,0,0,0,,Өзін-өзі сіңіру сезімі
Dialogue: 7,0:21:52.48,0:21:55.50,Text - JP,,0,0,0,,Мен қатты эмоцияға беріліп, жылап аламын ба деп қорқамын.
Dialogue: 8,0:21:57.03,0:22:02.26,Text - CN,,0,0,0,,Сахнаға көтерілгеннен кейін түтін жоғалады.
Dialogue: 7,0:21:57.03,0:22:02.26,Text - JP,,0,0,0,,Сахнаға шыққаннан кейін ол дүниелер ойымнан жоғалып кетті.
Dialogue: 8,0:22:05.01,0:22:07.14,Text - CN,,0,0,0,,Сахналық дүние қызметі осындай.
Dialogue: 7,0:22:05.01,0:22:07.14,Text - JP,,0,0,0,,Бұл дүние
Dialogue: 8,0:22:09.99,0:22:13.02,Text - CN,,0,0,0,,Біреу болған кезде ``бақытты еске алу'' тіркесі.
Dialogue: 7,0:22:09.99,0:22:13.02,Text - JP,,0,0,0,,Мен сенің сағыныш дауыстарыңды естимін.
Dialogue: 8,0:22:13.77,0:22:17.03,Text - CN,,0,0,0,,Алайда, басы жоғалған соң, адам жоғалады.
Dialogue: 7,0:22:13.77,0:22:17.03,Text - JP,,0,0,0,,Артыма қарасам, ешкім жоқ.
Dialogue: 8,0:22:17.83,0:22:20.78,Text - CN,,0,0,0,,Менің әңгімем Ебе сұлулығы туралы.
Dialogue: 7,0:22:17.83,0:22:20.78,Text - JP,,0,0,0,,Мен Эми Окабе туралы естідім.
Dialogue: 8,0:22:24.35,0:22:29.41,Text - CN,,0,0,0,,Сіз осындасыз және сіз кінәлісіз.
Dialogue: 7,0:22:24.35,0:22:29.41,Text - JP,,0,0,0,,Сіз кешірім үшін келдіңіз бе?
Dialogue: 8,0:22:30.41,0:22:31.66,Text - CN,,0,0,0,,Гаджичидо
Dialogue: 7,0:22:30.41,0:22:31.66,Text - JP,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 8,0:22:34.42,0:22:37.67,Text - CN,,0,0,0,,Бүкіл қалаңды құшақтап ал.
Dialogue: 7,0:22:34.42,0:22:37.67,Text - JP,,0,0,0,,Аа... Сен үшін ғана кешірім сұраймын.
Dialogue: 8,0:22:38.44,0:22:40.17,Text - CN,,0,0,0,,Бұл менің кінәм.
Dialogue: 7,0:22:38.44,0:22:40.17,Text - JP,,0,0,0,,Бұл менің кінәм
Dialogue: 8,0:22:41.32,0:22:44.42,Text - CN,,0,0,0,,Дегенмен, Кьюяның қазір өлгені маңызды.
Dialogue: 7,0:22:41.32,0:22:44.42,Text - JP,,0,0,0,,Бірақ мұндай кешірім сұраудың мәні жоқ.
Dialogue: 8,0:22:44.42,0:22:47.93,Text - CN,,0,0,0,,Жолда келген адамның жоқ болуына байланысты.
Dialogue: 7,0:22:44.42,0:22:47.93,Text - JP,,0,0,0,,Кешірім сұрайтын ешкім қалмады.
Dialogue: 8,0:22:48.54,0:22:50.14,Text - CN,,0,0,0,,Дугаку Хориучи
Dialogue: 7,0:22:48.54,0:22:50.14,Text - JP,,0,0,0,,Хориучи мырза
Dialogue: 8,0:22:51.88,0:22:55.52,Text - CN,,0,0,0,,Жағымсыз ниеттер
Dialogue: 7,0:22:51.88,0:22:55.52,Text - JP,,0,0,0,,Кешіріңіз, оны бастапқы орнына қайтарыңыз.
Dialogue: 8,0:22:56.85,0:22:58.52,Text - CN,,0,0,0,,Осы жерден тоқтауға болады.
Dialogue: 7,0:22:56.85,0:22:58.52,Text - JP,,0,0,0,,Сіз өзіңіз қалаған нәрсені жасай аласыз.
Dialogue: 8,0:22:58.52,0:23:00.94,Text - CN,,0,0,0,,Қарияның балаша ұсақтығы
Dialogue: 7,0:22:58.52,0:23:00.94,Text - JP,,0,0,0,,Бала сияқты әрекет ету
Dialogue: 8,0:23:01.85,0:23:04.95,Text - CN,,0,0,0,,Жынның жанын еске түсірудің қажеті жоқ
Dialogue: 7,0:23:01.85,0:23:04.95,Text - JP,,0,0,0,,Аруақтардың әрекетіне қарама
Dialogue: 8,0:23:05.75,0:23:08.49,Text - CN,,0,0,0,,Бұл классикалық елес оқиғасы
