Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 1,0:00:11.31,0:00:15.82,opj,NTP,0000,0000,0000,,Бұл дүниедегі кішкентай жерде
Dialogue: 1,0:00:16.55,0:00:20.67,opj,NTP,0000,0000,0000,,Сол күні мен сені таптым
Dialogue: 1,0:00:21.69,0:00:26.49,opj,NTP,0000,0000,0000,,Желмен күлдіңіз
Dialogue: 1,0:00:26.89,0:00:30.78,opj,NTP,0000,0000,0000,,Менің жүрегім боялған
Dialogue: 1,0:00:32.06,0:00:36.81,opj,NTP,0000,0000,0000,,Қаншалықты жақын болсаңыз да
Dialogue: 1,0:00:37.21,0:00:41.88,opj,NTP,0000,0000,0000,,Мен өз сезімімді жеткізе алмаймын.
Dialogue: 1,0:00:42.38,0:00:49.78,opj,NTP,0000,0000,0000,,Қанша алыс жүрсек те, мен өз ойымды өзгертпеймін
Dialogue: 1,0:00:49.99,0:00:52.30,opj,NTP,0000,0000,0000,,Тағдыр және мәңгілік
Dialogue: 1,0:00:52.44,0:00:54.60,opj,NTP,0000,0000,0000,,Сынса да, Жаныңда боламын
Dialogue: 1,0:00:54.60,0:01:00.08,opj,NTP,0000,0000,0000,,Мен сені ертеңнен гөрі қазір жақсы көремін
Dialogue: 1,0:01:00.47,0:01:05.37,opj,NTP,0000,0000,0000,,Ақыр аяғы болды, неге келмейсің?
Dialogue: 1,0:01:05.59,0:01:10.07,opj,NTP,0000,0000,0000,,Әдемі немесе әдемі болу міндетті емес.
Dialogue: 1,0:01:10.14,0:01:15.57,opj,NTP,0000,0000,0000,,Мен сені есінен танғанша жақсы көрейін
Dialogue: 1,0:01:15.92,0:01:18.20,opj,NTP,0000,0000,0000,,Сол күнгі сөздерді ұмытпаймын
Dialogue: 1,0:01:18.36,0:01:26.41,opj,NTP,0000,0000,0000,,Ұмытылмас адамға жетсе екен деймін.
Dialogue: 0,0:01:31.06,0:01:33.77,Default,,0000,0000,0000,,Менің атым Тоғаши Кузуха.
Dialogue: 0,0:01:34.92,0:01:40.20,Default,,0000,0000,0000,,Бұл менің үлкен ағам Юта Тогаши, ол әлі орта мектептің екінші курсында оқиды.
Dialogue: 0,0:01:40.41,0:01:42.38,Default,,0000,0000,0000,,Бұл біраз оғаш болған кездегі оқиға.
Dialogue: 0,0:01:43.33,0:01:45.22,Default,,0000,0000,0000,,А, мен тоқпын.
Dialogue: 0,0:01:50.17,0:01:52.48,Default,,0000,0000,0000,,Аға, тамақ суып барады.
Dialogue: 0,0:01:53.06,0:01:54.39,Default,,0000,0000,0000,,Кешіріңіз, әпке.
Dialogue: 0,0:01:55.04,0:01:56.81,Default,,0000,0000,0000,,Мен мұны жей алмаймын.
Dialogue: 0,0:01:58.40,0:02:00.46,Default,,0000,0000,0000,,Қараңғы жалынның шебері ретінде
Dialogue: 0,0:02:00.84,0:02:02.62,Default,,0000,0000,0000,,Ақыл-ой жаттығулары кезінде
Dialogue: 0,0:02:03.17,0:02:05.21,Default,,0000,0000,0000,,Зейінді қалай ұштау керек
Dialogue: 0,0:02:05.47,0:02:07.73,Default,,0000,0000,0000,,Барлық тағамнан бас тарту керек.
Dialogue: 0,0:02:11.59,0:02:12.44,Default,,0000,0000,0000,,Біраз өсіп алғанша күтсеңші.
Dialogue: 0,0:02:13.09,0:02:15.21,Default,,0000,0000,0000,,Мен енді 6 сағаттық медитацияны бастаймын.
Dialogue: 0,0:02:15.90,0:02:19.09,Default,,0000,0000,0000,,Осы уақыт ішінде ешкіммен сөйлесуге болмайды.
Dialogue: 0,0:02:21.23,0:02:22.34,Default,,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:02:23.51,0:02:25.42,Default,,0000,0000,0000,,Не? Юта?
Dialogue: 0,0:02:32.75,0:02:35.04,Default,,0000,0000,0000,,Юта, сен не істеп жатырсың?
Dialogue: 0,0:02:37.31,0:02:37.98,Default,,0000,0000,0000,,Юта?
Dialogue: 0,0:02:43.43,0:02:44.53,Default,,0000,0000,0000,,Юмеха да
Dialogue: 0,0:02:44.87,0:02:48.07,Default,,0000,0000,0000,,Е, ита тата, ауырады, ауырады
Dialogue: 0,0:02:48.36,0:02:51.67,Default,,0000,0000,0000,,О, сен не істеп жатырсың?
Dialogue: 0,0:02:52.56,0:02:54.43,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:02:54.85,0:02:58.27,Default,,0000,0000,0000,,Медитация, медитация, ойыңды жинақтау.
Dialogue: 0,0:02:59.68,0:03:02.39,Default,,0000,0000,0000,,Ия, мен қараңғылықтың қара жанын жинауым керек.
Dialogue: 0,0:03:02.55,0:03:03.73,Default,,0000,0000,0000,,Хехехехехе
Dialogue: 0,0:03:04.06,0:03:05.41,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:03:06.53,0:03:10.63,Default,,0000,0000,0000,,Ах, мектепте танымал болған Дуэль картасы.
Dialogue: 0,0:03:10.74,0:03:12.31,Default,,0000,0000,0000,,Tch, бұл дұрыс емес.
Dialogue: 0,0:03:16.73,0:03:18.73,Default,,0000,0000,0000,,Жарайды, мен жалғызбын.
Dialogue: 0,0:03:18.97,0:03:21.27,Default,,0000,0000,0000,,Жоқ, маған еріңіз.
Dialogue: 0,0:03:21.87,0:03:23.63,Default,,0000,0000,0000,,Үлкен аға, сіз әлі осындасыз ба?
Dialogue: 0,0:03:25.26,0:03:26.12,Default,,0000,0000,0000,,Сізді күтуге мәжбүр етті
Dialogue: 0,0:03:30.30,0:03:31.70,Default,,0000,0000,0000,,Ай шықты ма?
Dialogue: 0,0:03:33.06,0:03:33.43,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:33.91,0:03:36.19,Default,,0000,0000,0000,,Ай шықты ма деп сұраймын!
Dialogue: 0,0:03:36.90,0:03:38.28,Default,,0000,0000,0000,,Иә, мүмкін
Dialogue: 0,0:03:39.25,0:03:40.75,Default,,0000,0000,0000,,Міне, солай!
Dialogue: 0,0:03:55.41,0:03:56.88,Default,,0000,0000,0000,,Ауа жабысқақ
Dialogue: 0,0:03:57.27,0:03:59.77,Default,,0000,0000,0000,,Бұл жақын жерде!
Dialogue: 0,0:04:02.28,0:04:03.82,Default,,0000,0000,0000,,Хаа, Кузуха-чан
Dialogue: 0,0:04:05.27,0:04:06.83,Default,,0000,0000,0000,,Уау! Мика-чан
Dialogue: 0,0:04:07.36,0:04:08.54,Default,,0000,0000,0000,,Баратын жер
Dialogue: 0,0:04:11.60,0:04:13.86,Default,,0000,0000,0000,,Мен кеңсе тауарлары дүкеніне баруды ойладым.
Dialogue: 0,0:04:14.53,0:04:15.41,Default,,0000,0000,0000,,Бірге барайық
Dialogue: 0,0:04:17.53,0:04:18.97,Default,,0000,0000,0000,,Күте тұрыңыз, апа.
Dialogue: 0,0:04:19.75,0:04:23.84,Default,,0000,0000,0000,,Әпке? Мүмкін Кузу-чанның ағасы шығар?
Dialogue: 0,0:04:24.51,0:04:25.24,Default,,0000,0000,0000,,Шынында да
Dialogue: 0,0:04:25.85,0:04:29.27,Default,,0000,0000,0000,,Бірақ біз олардың шын бауырлар екенін білмейміз.
Dialogue: 0,0:04:30.48,0:04:33.23,Default,,0000,0000,0000,,Шекараның арғы жағында шайқас болды.
Dialogue: 0,0:04:34.27,0:04:34.99,Default,,0000,0000,0000,,Шайқас?
Dialogue: 0,0:04:35.86,0:04:38.96,Default,,0000,0000,0000,,Бауырым, сен ойнағанды ​​ұнатасың.
Dialogue: 0,0:04:39.08,0:04:40.11,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:04:40.18,0:04:40.50,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:41.00,0:04:42.06,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:04:43.91,0:04:44.40,Default,,0000,0000,0000,,Кеттік
Dialogue: 0,0:04:44.71,0:04:45.13,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:04:45.65,0:04:48.83,Default,,0000,0000,0000,,Не? Мика-чан Мика-чан~!
Dialogue: 0,0:04:49.45,0:04:53.26,Default,,0000,0000,0000,,Мүмкін менің ағам жақсы шығар?
Dialogue: 0,0:04:53.26,0:04:55.00,Default,,0000,0000,0000,,Сол кезде мен ойладым
Dialogue: 0,0:04:58.63,0:04:59.59,Default,,0000,0000,0000,,Еңбегіңіз үшін рахмет!
Dialogue: 0,0:05:02.36,0:05:04.39,Default,,0000,0000,0000,,Бірақ мен бәрібір қалыптыны ұнатамын.
Dialogue: 0,0:05:05.89,0:05:11.89,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory