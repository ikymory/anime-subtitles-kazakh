Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 1,0:00:11.31,0:00:15.82,opj,NTP,0000,0000,0000,,Бұл дүниедегі кішкентай жерде
Dialogue: 1,0:00:16.55,0:00:20.67,opj,NTP,0000,0000,0000,,Сол күні мен сені таптым
Dialogue: 1,0:00:21.69,0:00:26.49,opj,NTP,0000,0000,0000,,Желмен күлдіңіз
Dialogue: 1,0:00:26.89,0:00:30.78,opj,NTP,0000,0000,0000,,Менің жүрегім боялған
Dialogue: 1,0:00:32.06,0:00:36.81,opj,NTP,0000,0000,0000,,Қаншалықты жақын болсаңыз да
Dialogue: 1,0:00:37.21,0:00:41.88,opj,NTP,0000,0000,0000,,Мен өз сезімімді жеткізе алмаймын.
Dialogue: 1,0:00:42.38,0:00:49.78,opj,NTP,0000,0000,0000,,Қанша алыс жүрсек те, мен өз ойымды өзгертпеймін
Dialogue: 1,0:00:49.99,0:00:52.30,opj,NTP,0000,0000,0000,,Тағдыр және мәңгілік
Dialogue: 1,0:00:52.44,0:00:54.60,opj,NTP,0000,0000,0000,,Сынса да, Жаныңда боламын
Dialogue: 1,0:00:54.60,0:01:00.08,opj,NTP,0000,0000,0000,,Мен сені ертеңнен гөрі қазір жақсы көремін
Dialogue: 1,0:01:00.47,0:01:05.37,opj,NTP,0000,0000,0000,,Ақыр аяғы болды, неге келмейсің?
Dialogue: 1,0:01:05.59,0:01:10.07,opj,NTP,0000,0000,0000,,Әдемі немесе әдемі болу міндетті емес.
Dialogue: 1,0:01:10.14,0:01:15.57,opj,NTP,0000,0000,0000,,Мен сені есінен танғанша жақсы көрейін
Dialogue: 1,0:01:15.92,0:01:18.20,opj,NTP,0000,0000,0000,,Сол күнгі сөздерді ұмытпаймын
Dialogue: 1,0:01:18.36,0:01:26.41,opj,NTP,0000,0000,0000,,Ұмытылмас адамға жетсе екен деймін.
Dialogue: 0,0:01:32.00,0:01:35.24,Default,NTP,0000,0000,0000,,Мен ет пен картоп жасаймын.
Dialogue: 0,0:01:34.17,0:01:35.22,Default,NTP,0000,0000,0000,,Рикка
Dialogue: 0,0:01:36.38,0:01:40.74,Default,NTP,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:01:41.37,0:01:44.36,Default,NTP,0000,0000,0000,,Білесің бе, Юмеха, менің Риккаға өтінішім бар.
Dialogue: 0,0:01:44.88,0:01:47.11,Default,NTP,0000,0000,0000,,Егер сіз зұлым патшаның шынайы көзінің күшін пайдалансаңыз
Dialogue: 0,0:01:47.32,0:01:48.91,Default,NTP,0000,0000,0000,,Көп нәрсе орындалады
Dialogue: 0,0:01:49.42,0:01:51.59,Default,NTP,0000,0000,0000,,Юмеханың тілегі – әлемді жаулап алу
Dialogue: 0,0:01:52.00,0:01:54.24,Default,NTP,0000,0000,0000,,Әлде Токио күмбезіндегідей пудинг пе?
Dialogue: 0,0:01:54.57,0:01:59.81,Default,NTP,0000,0000,0000,,Жоқ, көрдің бе, Юмеха, мен келін болып жатқым келеді.
Dialogue: 0,0:02:00.11,0:02:01.68,Default,NTP,0000,0000,0000,,Сондықтан мен саған тамақ жасауды үйреттім.
Dialogue: 0,0:02:02.31,0:02:04.99,Default,NTP,0000,0000,0000,,Қолжетімді Джау Шинган - ең күшті
Dialogue: 0,0:02:05.19,0:02:09.38,Default,NTP,0000,0000,0000,,Егер сізде сол күш болса, сіз ең күшті тағамдарды жасай аласыз.
Dialogue: 0,0:02:09.81,0:02:13.56,Default,NTP,0000,0000,0000,,Рикка ғажап, енді айт.
Dialogue: 0,0:02:13.95,0:02:14.74,Default,NTP,0000,0000,0000,,Дәл қазір
Dialogue: 0,0:02:15.38,0:02:16.43,Default,NTP,0000,0000,0000,,Енді
Dialogue: 0,0:02:17.95,0:02:19.19,Default,NTP,0000,0000,0000,,Маған қалдырыңыз
Dialogue: 0,0:02:22.24,0:02:24.97,Default,NTP,0000,0000,0000,,Эй, Рикка, сен не істейсің?
Dialogue: 0,0:02:25.97,0:02:27.27,Default,NTP,0000,0000,0000,,Зұлым патша Шинган Цэцу!
Dialogue: 0,0:02:30.61,0:02:32.87,Default,NTP,0000,0000,0000,,Зұлым патша Шинген жинаған деректер.
Dialogue: 0,0:02:33.28,0:02:36.33,Default,NTP,0000,0000,0000,,Қалыңдықтың стандартты тағамы - ет пен картоп.
Dialogue: 0,0:02:37.87,0:02:39.10,Default,NTP,0000,0000,0000,,Біріншіден, ет бөлімі
Dialogue: 0,0:02:40.99,0:02:43.70,Default,NTP,0000,0000,0000,,Эй Рикка, Строга Нофу деген не?
Dialogue: 0,0:02:43.97,0:02:45.59,Default,NTP,0000,0000,0000,,Қару атаулары
Dialogue: 0,0:02:46.02,0:02:47.63,Default,NTP,0000,0000,0000,,Рикка білімді ~
Dialogue: 0,0:02:47.87,0:02:51.31,Default,NTP,0000,0000,0000,,Әрине, бұл ең жақсы тағам болуы мүмкін.
Dialogue: 0,0:02:51.85,0:02:53.17,Default,NTP,0000,0000,0000,,Бірақ қазір ет пен картоп.
Dialogue: 0,0:02:53.87,0:02:58.82,Default,NTP,0000,0000,0000,,Уау, олар өте көп. Никужага үшін қандай етті пайдаланасыз?
Dialogue: 0,0:02:59.07,0:02:59.68,Default,NTP,0000,0000,0000,,Уф… Таңертеңгісін-ақ шаршап біттім.
Dialogue: 0,0:02:59.62,0:03:02.39,Default,NTP,0000,0000,0000,,Geara
Dialogue: 0,0:03:00.19,0:03:02.42,Default,NTP,0000,0000,0000,,Біртүрлі есім Менің ойымша, бұл
Dialogue: 0,0:03:03.37,0:03:05.36,Default,NTP,0000,0000,0000,,Геара ханым 100 грамм
Dialogue: 0,0:03:06.87,0:03:07.52,Default,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:03:09.59,0:03:11.03,Default,NTP,0000,0000,0000,,Ең күшті ет пен картопқа арналған
Dialogue: 0,0:03:11.12,0:03:13.18,Default,NTP,0000,0000,0000,,Оны дәмдеу керек.
Dialogue: 0,0:03:13.50,0:03:15.21,Default,NTP,0000,0000,0000,,Сонымен, бұл дәмдеуіштер мейрамханасы ма?
Dialogue: 0,0:03:18.87,0:03:19.39,Default,NTP,0000,0000,0000,,осында
Dialogue: 0,0:03:23.13,0:03:25.05,Default,NTP,0000,0000,0000,,Уау, көп
Dialogue: 0,0:03:25.85,0:03:28.08,Default,NTP,0000,0000,0000,,Эй Рикка, қайсысын сатып алуым керек?
Dialogue: 0,0:03:34.39,0:03:36.73,Default,NTP,0000,0000,0000,,Калам масала Бұл керемет
Dialogue: 0,0:03:36.97,0:03:38.78,Default,NTP,0000,0000,0000,,Мен құлыптардың жертөлесіндегі құбыжықтарды көргім келеді.
Dialogue: 0,0:03:39.42,0:03:42.05,Default,NTP,0000,0000,0000,,Эй, Рикка, сен де керемет көрінесің.
Dialogue: 0,0:03:44.09,0:03:46.87,Default,NTP,0000,0000,0000,,Эстрагон, күткендей.
Dialogue: 0,0:03:47.20,0:03:50.69,Default,NTP,0000,0000,0000,,Оның зұлым патша Шинганмен келісім-шарт жасау қабілеті болуы мүмкін.
Dialogue: 0,0:03:50.89,0:03:51.83,Default,NTP,0000,0000,0000,,Хехе
Dialogue: 0,0:03:59.60,0:04:03.01,Default,NTP,0000,0000,0000,,Юмеха Бұл жер жабық кеңістікке қосылған.
Dialogue: 0,0:04:03.05,0:04:05.47,Default,NTP,0000,0000,0000,,Нөлдік нүктелердің бірі, яғни.
Dialogue: 0,0:04:05.78,0:04:08.69,Default,NTP,0000,0000,0000,,Мұнда барлығы сиқырлы зат.
Dialogue: 0,0:04:08.88,0:04:10.78,Default,NTP,0000,0000,0000,,Өте керемет
Dialogue: 0,0:04:11.66,0:04:12.87,Default,NTP,0000,0000,0000,,Барып, әр түрлі қорларды толтырайық.
Dialogue: 0,0:04:13.89,0:04:15.46,Default,NTP,0000,0000,0000,,Болашақта міндетті түрде пайдалы болады
Dialogue: 0,0:04:15.59,0:04:16.32,Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:04:17.60,0:04:18.86,Default,NTP,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:04:19.79,0:04:20.88,Default,NTP,0000,0000,0000,,Үйге қош келдіңіз
Dialogue: 0,0:04:21.78,0:04:23.63,Default,NTP,0000,0000,0000,,Химераға арналған кәдесый
Dialogue: 0,0:04:31.70,0:04:33.69,Default,NTP,0000,0000,0000,,Сіз не жасайсыз?
Dialogue: 0,0:04:36.09,0:04:36.98,Default,NTP,0000,0000,0000,,Ет және картоп
Dialogue: 0,0:04:37.32,0:04:38.84,Default,NTP,0000,0000,0000,,Неліктен сұраулы?
Dialogue: 0,0:04:40.34,0:04:46.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory