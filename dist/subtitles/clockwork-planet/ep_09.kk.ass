Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:36.05,0:01:38.05,Default,,0,0,0,,О, о...
Dialogue: 0,0:01:38.05,0:01:40.07,Default,,0,0,0,,Әке➡
Dialogue: 0,0:01:40.07,0:01:42.05,Default,,0,0,0,,Бұл қандай дүкен?
Dialogue: 0,0:01:42.05,0:01:44.09,Default,,0,0,0,,Жақсы
Dialogue: 0,0:01:44.09,0:01:47.71,Default,,0,0,0,,Ағайға әлі ерте ме?
Dialogue: 0,0:01:47.71,0:01:50.39,Default,,0,0,0,,Профессор Конрадпен кездесу орны
Dialogue: 0,0:01:50.39,0:01:52.40,Default,,0,0,0,,Ол осында болуы керек
Dialogue: 0,0:01:52.40,0:01:54.45,Default,,0,0,0,,≪О, профессор Мари
Dialogue: 0,0:01:54.45,0:01:57.05,Default,,0,0,0,,Профессор Конрад... Иә?
Dialogue: 0,0:01:57.05,0:01:59.14,Default,,0,0,0,,Амансың ба?➡
Dialogue: 0,0:01:59.14,0:02:01.74,Default,,0,0,0,,Кенет Акихабарамен байланыс үзілді.
Dialogue: 0,0:02:01.74,0:02:03.82,Default,,0,0,0,,Мен уайымдадым.
Dialogue: 0,0:02:03.82,0:02:06.73,Default,,0,0,0,,Нақты не болды?
Dialogue: 0,0:02:10.40,0:02:49.40,Default,,0,0,0,,♬～
Dialogue: 0,0:05:07.41,0:05:10.39,Default,,0,0,0,,Әке, не болды?
Dialogue: 0,0:05:10.39,0:05:13.48,Default,,0,0,0,,Балалар мұны көрмеуі керек.
Dialogue: 0,0:05:13.48,0:05:15.92,Default,,0,0,0,,Оны да көрмеу керек!
Dialogue: 0,0:05:15.92,0:05:18.79,Default,,0,0,0,,Мен де жақсы емес сияқтымын.
Dialogue: 0,0:05:18.79,0:05:22.76,Default,,0,0,0,,Бұл жақсы дүкен, солай емес пе? Мен реттеген автоматтар
Dialogue: 0,0:05:22.76,0:05:26.43,Default,,0,0,0,,Оның бұл салада біраз беделі бар.
Dialogue: 0,0:05:30.06,0:05:32.75,Default,,0,0,0,,Міне, келдік.
Dialogue: 0,0:05:32.75,0:05:35.90,Default,,0,0,0,,Мен дауыстап айта алмаймын➡
Dialogue: 0,0:05:35.90,0:05:38.91,Default,,0,0,0,,Бұл автоматтардың қара нарығы.
Dialogue: 0,0:05:38.91,0:05:42.76,Default,,0,0,0,,Олар сондай-ақ билікпен сахна артында мәмілелер жасап жатыр.
Dialogue: 0,0:05:42.76,0:05:45.41,Default,,0,0,0,,Керемет, осындай шеберхана үшін.
Dialogue: 0,0:05:45.41,0:05:49.43,Default,,0,0,0,,Тәжді ілгішке іліп, баяу суытыңыз.
Dialogue: 0,0:05:49.43,0:05:51.43,Default,,0,0,0,,О
Dialogue: 0,0:05:57.41,0:06:01.39,Default,,0,0,0,,Доктор Конрад, оны тірі қалдырыңыз.
Dialogue: 0,0:06:01.39,0:06:04.73,Default,,0,0,0,,Ол магниттелген, бірақ ішіндегі миы бүтін болса...
Dialogue: 0,0:06:04.73,0:06:07.75,Default,,0,0,0,,≪(Конрад) Бұл сізге протездік дене керек дегенді білдіре ме?
Dialogue: 0,0:06:07.75,0:06:10.42,Default,,0,0,0,,Жақсырақ 12 сағат ішінде
Dialogue: 0,0:06:10.42,0:06:13.41,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:06:13.41,0:06:16.08,Default,,0,0,0,,Мен бағымды сынап көрейін, бірақ
Dialogue: 0,0:06:16.08,0:06:18.08,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:06:18.08,0:06:20.68,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:06:22.20,0:06:26.07,Default,,0,0,0,,≪(Тобық) Әке мен әпке, сіз пайдалысыз.
Dialogue: 0,0:06:26.07,0:06:29.57,Default,,0,0,0,,Бұл Льюдің өзіне қажет нәрсені істегенінің нәтижесі болды.
Dialogue: 0,0:06:29.57,0:06:31.57,Default,,0,0,0,,Сондықтан уайымдамаңыз.
Dialogue: 0,0:06:33.43,0:06:36.08,Default,,0,0,0,,Бұл ауырады ма? Әке
Dialogue: 0,0:06:36.08,0:06:38.10,Default,,0,0,0,,Барлығы
Dialogue: 0,0:06:38.10,0:06:40.52,Default,,0,0,0,,Уайымдама, бұл ештеңе емес.
Dialogue: 0,0:06:40.52,0:06:44.10,Default,,0,0,0,,Қыңыр болма, іріңді болмай тұрып емде.
Dialogue: 0,0:06:44.10,0:06:46.10,Default,,0,0,0,,Сендерде лотерея ұтысы бар емес пе?
Dialogue: 0,0:06:47.07,0:06:49.08,Default,,0,0,0,,Ана
Dialogue: 0,0:06:49.08,0:06:51.73,Default,,0,0,0,,Мені олай атама.
Dialogue: 0,0:06:51.73,0:06:53.75,Default,,0,0,0,,Эй, мен саған тез көрсетейін.
Dialogue: 0,0:06:53.75,0:06:55.75,Default,,0,0,0,,Және қалағаныңа қол жеткізе алмасаң—
Dialogue: 0,0:06:56.75,0:07:00.40,Default,,0,0,0,,Эй Мари, мына қартты қазір оят.
Dialogue: 0,0:07:00.40,0:07:02.44,Default,,0,0,0,,Оның пайдасы бар ма?
Dialogue: 0,0:07:04.52,0:07:06.43,Default,,0,0,0,,Әй, әдемі жүз
Dialogue: 0,0:07:06.43,0:07:09.41,Default,,0,0,0,,Белмотт-самаға қарай
Dialogue: 0,0:07:09.41,0:07:11.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:11.40,0:07:13.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:13.45,0:07:15.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:15.42,0:07:17.75,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:17.75,0:07:22.73,Default,,0,0,0,,Бұл тітіркендіргіш. Олар жай ғана сіздің ми қабығыңызды автоматпен байланыстырды.
Dialogue: 0,0:07:22.73,0:07:26.75,Default,,0,0,0,,Бұл қалайша осындай эротикалық автоматқа әкелуі мүмкін?
Dialogue: 0,0:07:26.75,0:07:29.77,Default,,0,0,0,,Адамның қадір-қасиеті Сіз не ойладыңыз?
Dialogue: 0,0:07:29.77,0:07:31.85,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:07:43.08,0:07:45.58,Default,,0,0,0,,Бағынбаған дұрыс
Dialogue: 0,0:07:45.58,0:07:49.59,Default,,0,0,0,,Мен ренжідім, себебі Халтердің қарт адамы оянбайды.
Dialogue: 0,0:07:49.59,0:07:51.65,Default,,0,0,0,,Қажетсіз сөздерді айтпаңыз
Dialogue: 0,0:07:51.65,0:07:55.31,Default,,0,0,0,,Нені зерттедің, оны түкір
Dialogue: 0,0:07:55.31,0:07:58.95,Default,,0,0,0,,Бұл үлкен жігіт не істеуді жоспарлап отыр?
Dialogue: 0,0:07:58.95,0:08:02.42,Default,,0,0,0,,Сіз бұған шындап қарайсыз ба? иә?
Dialogue: 0,0:08:02.42,0:08:05.80,Default,,0,0,0,,≪Бөлімдер орнында➡
Dialogue: 0,0:08:05.80,0:08:08.40,Default,,0,0,0,,Сіз әлі байқамайсыз ба?
Dialogue: 0,0:08:09.74,0:08:12.73,Default,,0,0,0,,Ол бейбақтар ештеңе істемейді.
Dialogue: 0,0:08:12.73,0:08:14.74,Default,,0,0,0,,Дұрыс? иә?
Dialogue: 0,0:08:14.74,0:08:16.78,Default,,0,0,0,,(ысқырық)
Dialogue: 0,0:08:16.78,0:08:21.47,Default,,0,0,0,,Эй, бұл сүйкімді жүзді және қызықты идеясы бар бала қандай?
Dialogue: 0,0:08:21.47,0:08:23.42,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:08:23.42,0:08:27.41,Default,,0,0,0,,Шамасы, үкімет алдына шыға салысымен,
Dialogue: 0,0:08:27.41,0:08:29.41,Default,,0,0,0,,Шайқас аяқталды➡
Dialogue: 0,0:08:29.41,0:08:32.41,Default,,0,0,0,,Аңғал жас ханым
Dialogue: 0,0:08:33.41,0:08:38.08,Default,,0,0,0,,Биік таяқшаны ауданға/Акихабараға қарсы қолдану.
Dialogue: 0,0:08:38.08,0:08:41.09,Default,,0,0,0,,Халықаралық аймақтарды бөлу органына сұралды
Dialogue: 0,0:08:41.09,0:08:43.42,Default,,0,0,0,,Tall Wand ше?
Dialogue: 0,0:09:02.08,0:09:05.41,Default,,0,0,0,,Электромагниттік қарудың бар екені анықталса
Dialogue: 0,0:09:05.41,0:09:09.08,Default,,0,0,0,,Халықаралық қауымдастықтың сыны мен санкциялары сөзсіз
Dialogue: 0,0:09:09.08,0:09:11.08,Default,,0,0,0,,Шын пейілімізді көрсетейік
Dialogue: 0,0:09:11.08,0:09:14.74,Default,,0,0,0,,Шыншылдық дегеніміз не? Сен Шиганың қалдығысың.
Dialogue: 0,0:09:14.74,0:09:18.41,Default,,0,0,0,,Сіз тек Яцукашинмен тіл табысу жауапкершілігінен құтылғыңыз келеді!
Dialogue: 0,0:09:18.41,0:09:20.41,Default,,0,0,0,,Тіліңді ұста!
Dialogue: 0,0:09:20.41,0:09:25.08,Default,,0,0,0,,Аузыңды жап, мен бұл жағдайды қазір әскерилерге беремін.
Dialogue: 0,0:09:25.08,0:09:29.15,Default,,0,0,0,,Әскерилер ше? Қол-аяғымды жіліншігіме шығара алмасам да!
Dialogue: 0,0:09:29.15,0:09:31.07,Default,,0,0,0,,Киотодағы тазарту оқиғасымен бірдей➡
Dialogue: 0,0:09:31.07,0:09:33.42,Default,,0,0,0,,Пайдасыз алтын іздеуші!
Dialogue: 0,0:09:33.42,0:09:36.92,Default,,0,0,0,,<<(Қорғаныс министрі) Балалар, тағы айтыңдар!
Dialogue: 0,0:09:37.91,0:09:42.77,Default,,0,0,0,,Тек сонда болу арқылы үкімет пен әскер өзін-өзі жояды.
Dialogue: 0,0:09:42.77,0:09:45.42,Default,,0,0,0,,Сондықтан қозғалудың қажеті жоқ
Dialogue: 0,0:09:45.42,0:09:50.42,Default,,0,0,0,,Дұрыс, бұл жігіт жай ғана террорист емес.
Dialogue: 0,0:09:50.42,0:09:54.42,Default,,0,0,0,,Билікті басып алу үшін жасалған төңкеріс.
Dialogue: 0,0:09:55.41,0:09:57.45,Default,,0,0,0,,Және тағы бір нәрсе
Dialogue: 0,0:09:57.45,0:10:00.42,Default,,0,0,0,,Қарудың дәл қазір қозғалмауының себебі бар.
Dialogue: 0,0:10:00.42,0:10:02.42,Default,,0,0,0,,Қозғалмайсыз ба? Эй балам
Dialogue: 0,0:10:02.42,0:10:04.40,Default,,0,0,0,,Ненің негізі...
Dialogue: 0,0:10:04.40,0:10:06.76,Default,,0,0,0,,Қазір оның 1033 кітабы бар.
Dialogue: 0,0:10:06.76,0:10:11.41,Default,,0,0,0,,Мен генмигенераторды толық қуатта іске қосу арқылы өз энергиямды зарядтаймын.
Dialogue: 0,0:10:11.41,0:10:13.41,Default,,0,0,0,,Аяқтағанға дейін
Dialogue: 0,0:10:13.41,0:10:16.08,Default,,0,0,0,,66 жарым сағат.
Dialogue: 0,0:10:16.08,0:10:19.52,Default,,0,0,0,,Серіппе электромагниттік қару болуы керек.
Dialogue: 0,0:10:19.52,0:10:23.74,Default,,0,0,0,,Композиттік электромагниттік стратегиялық жылжымалы қару/Яцузукашин
Dialogue: 0,0:10:23.74,0:10:28.09,Default,,0,0,0,,Бұл сағат технологиясы мен электромагниттік технологияның қосындысы.
Dialogue: 0,0:10:28.09,0:10:30.06,Default,,0,0,0,,Сегіз байлам жіліншік
Dialogue: 0,0:10:30.06,0:10:33.07,Default,,0,0,0,,Сағат пен электромагниттік...
Dialogue: 0,0:10:33.07,0:10:35.15,Default,,0,0,0,,Сіз сызбаларды көрдіңіз бе?
Dialogue: 0,0:10:35.15,0:10:38.07,Default,,0,0,0,,Жоқ, мұның өзі түсіндірмейді.
Dialogue: 0,0:10:38.07,0:10:40.74,Default,,0,0,0,,Сен неменесің... Айтайын дегенім.
Dialogue: 0,0:10:40.74,0:10:44.34,Default,,0,0,0,,Олар әлі де бірдеңе жасауға тырысуда
Dialogue: 0,0:11:03.48,0:11:06.43,Default,,0,0,0,,Жарайды, Чан ағай шығайық.
Dialogue: 0,0:11:06.43,0:11:09.43,Default,,0,0,0,,Не? иә? Не айттың...
Dialogue: 0,0:11:11.74,0:11:14.42,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:11:14.42,0:11:17.42,Default,,0,0,0,,Қолыңнан келгенін істе
Dialogue: 0,0:11:24.08,0:11:26.75,Default,,0,0,0,,≪(Оператор) Энергияны толтыру жылдамдығы➡
Dialogue: 0,0:11:26.75,0:11:28.75,Default,,0,0,0,,12 пайыз➡
Dialogue: 0,0:11:28.75,0:11:32.43,Default,,0,0,0,,Қалғандай, жоспарланған қайта қосу уақыты асып кетеді.
Dialogue: 0,0:11:32.43,0:11:35.53,Default,,0,0,0,,Әскерилердің тағы да шабуыл жасауы екіталай.
Dialogue: 0,0:11:35.53,0:11:38.13,Default,,0,0,0,,Өртті басқару қуатын азайтыңыз
Dialogue: 0,0:11:38.13,0:11:40.18,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:11:40.18,0:11:42.08,Default,,0,0,0,,66 сағат қалды
Dialogue: 0,0:11:42.08,0:11:46.07,Default,,0,0,0,,Біздің шын ниетіміз орындалады, Мәртебелі.
Dialogue: 0,0:11:46.07,0:11:48.07,Default,,0,0,0,,О
Dialogue: 0,0:11:58.75,0:12:00.75,Default,,0,0,0,,Қане ағай
Dialogue: 0,0:12:00.75,0:12:03.75,Default,,0,0,0,,Бүгін көп көңілді болайық~
Dialogue: 0,0:12:04.74,0:12:06.74,Default,,0,0,0,,Ах
Dialogue: 0,0:12:12.42,0:12:14.40,Default,,0,0,0,,Ах
Dialogue: 0,0:12:14.40,0:12:17.42,Default,,0,0,0,,Иә, сізді қызықтыратын нәрсе таптыңыз ба?
Dialogue: 0,0:12:17.42,0:12:19.46,Default,,0,0,0,,Мен рұқсат алғым келеді
Dialogue: 0,0:12:19.46,0:12:22.09,Default,,0,0,0,,Мен сол дүкенді қарап шыға аламын ба?
Dialogue: 0,0:12:22.09,0:12:24.74,Default,,0,0,0,,Өте жақсы!
Dialogue: 0,0:12:24.74,0:12:28.41,Default,,0,0,0,,Мен айттым ғой, сен қалағаныңды істей аласың.
Dialogue: 0,0:12:28.41,0:12:30.75,Default,,0,0,0,,Бәрі жақсы ма?
Dialogue: 0,0:12:30.75,0:12:32.75,Default,,0,0,0,,Әрине!
Dialogue: 0,0:12:33.74,0:12:35.74,Default,,0,0,0,,Иә
Dialogue: 0,0:12:40.83,0:12:43.76,Default,,0,0,0,,Куха~ Менің қызым сүйкімді
Dialogue: 0,0:12:43.76,0:12:46.75,Default,,0,0,0,,Тірі болу мүлде қиын емес.
Dialogue: 0,0:12:46.75,0:12:49.09,Default,,0,0,0,,Мен оны қайтадан ести аламын ба?
Dialogue: 0,0:12:49.09,0:12:51.75,Default,,0,0,0,,Енді мұнда не істеу үшін келдің?
Dialogue: 0,0:12:51.75,0:12:54.24,Default,,0,0,0,,Қазір істеу керек нәрсені жасау
Dialogue: 0,0:12:54.24,0:12:58.78,Default,,0,0,0,,Енді Чан ағай 1000 жыл бойы жасай алмағанның бәрін жасаңыз!
Dialogue: 0,0:12:58.78,0:13:01.75,Default,,0,0,0,,Қолыммен, Мен оны орындаймын.
Dialogue: 0,0:13:01.75,0:13:04.42,Default,,0,0,0,,Сіз жай ғана көңіл көтергіңіз келеді, солай ма?
Dialogue: 0,0:13:04.42,0:13:06.42,Default,,0,0,0,,Және солай көрінеді
Dialogue: 0,0:13:06.42,0:13:09.07,Default,,0,0,0,,Өйткені, біз іздеуде жүрген қылмыскерлерміз.
Dialogue: 0,0:13:09.07,0:13:12.07,Default,,0,0,0,,Бұл жай ғана бетперде...
Dialogue: 0,0:13:12.07,0:13:15.93,Default,,0,0,0,,Мүмкін мен сүйкімді шығармын?
Dialogue: 0,0:13:15.93,0:13:17.90,Default,,0,0,0,,Өл, әке.
Dialogue: 0,0:13:17.90,0:13:20.90,Default,,0,0,0,,Келесі жолы мен сол дүкенге рұқсат алғым келеді.
Dialogue: 0,0:13:20.90,0:13:25.40,Default,,0,0,0,,Иә, иә, әке, мен бәріне рұқсат етемін.
Dialogue: 0,0:13:29.09,0:13:31.09,Default,,0,0,0,,Уа, ау?
Dialogue: 0,0:13:32.76,0:13:35.76,Default,,0,0,0,,Мама, біз де барайық.
Dialogue: 0,0:13:37.42,0:13:40.42,Default,,0,0,0,,Ендеше мені олай атауды доғар.
Dialogue: 0,0:13:52.42,0:13:54.42,Default,,0,0,0,,О~
Dialogue: 0,0:13:55.75,0:13:59.74,Default,,0,0,0,,Әке, мен мұны қалаймын деп ойлаймын ба?
Dialogue: 0,0:13:59.74,0:14:01.74,Default,,0,0,0,,Әрине!
Dialogue: 0,0:14:07.76,0:14:09.76,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:11.40,0:14:13.42,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:14:13.42,0:14:16.42,Default,,0,0,0,,Бүгін әпкеңізбен бірге дүкен аралайсыз ба?
Dialogue: 0,0:14:18.07,0:14:20.08,Default,,0,0,0,,Иә
Dialogue: 0,0:14:20.08,0:14:22.43,Default,,0,0,0,,Әй, сүйкімді тұтынушылар үшін.
Dialogue: 0,0:14:22.43,0:14:25.41,Default,,0,0,0,,Біз сізге тамаша қызмет көрсетеміз.
Dialogue: 0,0:14:25.41,0:14:29.45,Default,,0,0,0,,Ах, Чан ағайдың періштедей сүйкімділігі
Dialogue: 0,0:14:29.45,0:14:32.76,Default,,0,0,0,,Әке, мен көкке көтерілейін деп жатырмын.
Dialogue: 0,0:14:32.76,0:14:35.76,Default,,0,0,0,,≪Әкем де сүйкімді
Dialogue: 0,0:14:36.74,0:14:39.41,Default,,0,0,0,,Иә ағай
Dialogue: 0,0:14:39.41,0:14:41.41,Default,,0,0,0,,Ах
Dialogue: 0,0:14:42.40,0:14:44.48,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:44.48,0:14:46.48,Default,,0,0,0,,Әке
Dialogue: 0,0:15:57.09,0:16:01.08,Default,,0,0,0,,[ТД] Кеше түнгі террорлық қауіпке байланысты Акихабара қазір жабық.
Dialogue: 0,0:16:01.08,0:16:04.06,Default,,0,0,0,,[Теледидар] Жабылу жойылады деген болжам жоқ.
Dialogue: 0,0:16:04.06,0:16:07.40,Default,,0,0,0,,[TV] Азаматтар үкіметтен бірінен соң бірі түсініктеме сұрауда...
Dialogue: 0,0:16:07.40,0:16:09.40,Default,,0,0,0,,О… Ах…
Dialogue: 0,0:16:09.40,0:16:12.40,Default,,0,0,0,,Бұл дағдарыс сезімі жоқ алаңсыз нәрсе.
Dialogue: 0,0:16:12.40,0:16:14.40,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:16:34.39,0:16:37.40,Default,,0,0,0,,Мен бірінші рет ойын ойнадым.
Dialogue: 0,0:16:37.40,0:16:40.95,Default,,0,0,0,,Ағай, мен өзім алдым.
Dialogue: 0,0:16:40.95,0:16:44.39,Default,,0,0,0,,Анаңа солай
Dialogue: 0,0:16:44.39,0:16:47.41,Default,,0,0,0,,♬～
Dialogue: 0,0:16:47.41,0:16:49.41,Default,,0,0,0,,Дыбыс естіледі
Dialogue: 0,0:16:49.41,0:16:51.41,Default,,0,0,0,,Өте әдемі
Dialogue: 0,0:16:52.46,0:16:54.71,Default,,0,0,0,,Иә, рахмет
Dialogue: 0,0:16:54.71,0:16:57.72,Default,,0,0,0,,Қала өте қызық
Dialogue: 0,0:16:57.72,0:17:00.79,Default,,0,0,0,,Ағай, бұл менің бірінші рет...
Dialogue: 0,0:17:05.07,0:17:07.07,Default,,0,0,0,,Ақырында, бесінші рет...
Dialogue: 0,0:17:08.06,0:17:10.06,Default,,0,0,0,,Ана…
Dialogue: 0,0:17:11.06,0:17:14.40,Default,,0,0,0,,《Түсіндің бе? Чан ағай не істегісі келеді》
Dialogue: 0,0:17:14.40,0:17:17.40,Default,,0,0,0,,《Сен бәрін істей аласың》
Dialogue: 0,0:17:18.82,0:17:20.72,Default,,0,0,0,,Ана
Dialogue: 0,0:17:20.72,0:17:22.72,Default,,0,0,0,,Мен қалаймын тапсырыс
Dialogue: 0,0:17:23.73,0:17:26.71,Default,,0,0,0,,Анам жылап жатыр
Dialogue: 0,0:17:26.71,0:17:28.81,Default,,0,0,0,,Маған көмектес
Dialogue: 0,0:17:28.81,0:17:30.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:32.45,0:17:35.74,Default,,0,0,0,,Мен көмектесу үшін тапсырыс алғым келеді
Dialogue: 0,0:17:42.83,0:17:45.75,Default,,0,0,0,,Ағай көмектесе алмайды ма?
Dialogue: 0,0:17:51.05,0:17:53.06,Default,,0,0,0,,Олай болса қазір жасаңыз.
Dialogue: 0,0:17:53.06,0:17:55.06,Default,,0,0,0,,Яцуканың жіліншігін сындыру.
Dialogue: 0,0:17:55.06,0:17:58.39,Default,,0,0,0,,Қару-жарақ осылай істей алады!
Dialogue: 0,0:17:58.39,0:18:00.39,Default,,0,0,0,,Ах
Dialogue: 0,0:18:01.78,0:18:06.74,Default,,0,0,0,,Иә, ағай бұзады, жыламаңыз, мама.
Dialogue: 0,0:18:06.74,0:18:08.74,Default,,0,0,0,,Не айтып тұрсың...
Dialogue: 0,0:18:08.74,0:18:10.72,Default,,0,0,0,,(Наото құлап, еңіреді)
Dialogue: 0,0:18:10.72,0:18:12.73,Default,,0,0,0,,Эй, не болды!?
Dialogue: 0,0:18:12.73,0:18:17.41,Default,,0,0,0,,Тым ашуланбаңыз
Dialogue: 0,0:18:17.41,0:18:19.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:19.50,0:18:22.74,Default,,0,0,0,,О, құлаққапқа не болды?
Dialogue: 0,0:18:22.74,0:18:26.41,Default,,0,0,0,,Бұл зат баяғыда Акихабарада бұзылған.
Dialogue: 0,0:18:26.41,0:18:28.72,Default,,0,0,0,,Алдымен мұны істеңіз...
Dialogue: 0,0:18:28.72,0:18:30.73,Default,,0,0,0,,Іздегеніңізді тапсаңыз
Dialogue: 0,0:18:30.73,0:18:33.16,Default,,0,0,0,,Мен оны толық жылдамдықпен сатып аламын.
Dialogue: 0,0:18:33.16,0:18:35.56,Default,,0,0,0,,Не? сен не іздейсің
Dialogue: 0,0:18:35.56,0:18:38.73,Default,,0,0,0,,Жеңіске жетудің белгілі бір мүмкіндігі.
Dialogue: 0,0:18:38.73,0:18:42.40,Default,,0,0,0,,Льюзге осылай істеген адамдар.
Dialogue: 0,0:18:42.40,0:18:45.00,Default,,0,0,0,,Ұру үшін емес.
Dialogue: 0,0:18:55.38,0:18:57.74,Default,,0,0,0,,Көп бөлімді аймақ дегеніміз не?
Dialogue: 0,0:18:57.74,0:19:00.07,Default,,0,0,0,,Олар бір-біріне әсер етеді.
Dialogue: 0,0:19:00.07,0:19:04.41,Default,,0,0,0,,Иә Ұлттық бөлімшенің Орталық басқару бақылау мұнарасы
Dialogue: 0,0:19:04.41,0:19:07.06,Default,,0,0,0,,Аспан тірегі оның ортасы.
Dialogue: 0,0:19:07.06,0:19:11.38,Default,,0,0,0,,Мен Акихабараға айналма жолды таптым, енді...
Dialogue: 0,0:19:11.38,0:19:16.39,Default,,0,0,0,,Бірақ, Чан ағайдың не істегісі келетінін табуы маңызды.
Dialogue: 0,0:19:16.39,0:19:19.39,Default,,0,0,0,,Иә...
Dialogue: 0,0:19:21.39,0:19:23.73,Default,,0,0,0,,Мен оны жойғым келеді.
Dialogue: 0,0:19:23.73,0:19:27.07,Default,,0,0,0,,Сонда сіздің анаңызды құтқаруға болады.
Dialogue: 0,0:19:27.07,0:19:30.07,Default,,0,0,0,,Әй, не дедің!
Dialogue: 0,0:19:30.07,0:19:32.07,Default,,0,0,0,,Себебі мен оны жоя алсам...
Dialogue: 0,0:19:32.07,0:19:34.41,Default,,0,0,0,,Қабылданбады. Қабылданбады. Бұл мина әйел.
Dialogue: 0,0:19:34.41,0:19:37.74,Default,,0,0,0,,Қалай ойлайсыңдар Анкл-чан қандай?
Dialogue: 0,0:19:37.74,0:19:41.73,Default,,0,0,0,,Не? Бұл қыз Initial-Y сериясындағы ең күшті.
Dialogue: 0,0:19:41.73,0:19:43.73,Default,,0,0,0,,Бұл қару, солай ма?
Dialogue: 0,0:19:43.73,0:19:46.40,Default,,0,0,0,,Ақымақ болма, бұл менің қызым!
Dialogue: 0,0:19:46.40,0:19:48.89,Default,,0,0,0,,Біріншіден, ол қазір зарядталып жатыр.
Dialogue: 0,0:19:48.89,0:19:52.41,Default,,0,0,0,,Бар күшіммен бір секунд болса да күресе алмаймын.
Dialogue: 0,0:19:52.41,0:19:54.49,Default,,0,0,0,,Онсыз да
Dialogue: 0,0:19:54.49,0:19:58.15,Default,,0,0,0,,Бәрін осындай кішкентай баланың иығына салайық. Иә, шешілді.
Dialogue: 0,0:19:58.15,0:20:00.75,Default,,0,0,0,,Сізде мақтаныш жоқ па?
Dialogue: 0,0:20:04.92,0:20:07.42,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:20:24.39,0:20:26.41,Default,,0,0,0,,Кешіріңіз, бірақ мен бірінші ораламын.
Dialogue: 0,0:20:26.41,0:20:29.41,Default,,0,0,0,,Наото аға, өтінемін.
Dialogue: 0,0:20:30.45,0:20:32.40,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:20:32.40,0:20:34.42,Default,,0,0,0,,Иә➡
Dialogue: 0,0:20:34.42,0:20:37.42,Default,,0,0,0,,Командадан абсолютті
Dialogue: 0,0:20:38.39,0:20:41.44,Default,,0,0,0,,Бұл жігіт шынымен де керемет.
Dialogue: 0,0:20:41.44,0:20:44.06,Default,,0,0,0,,Өйткені ол данышпан.Данышпан ба?
Dialogue: 0,0:20:44.06,0:20:48.56,Default,,0,0,0,,Мағынасы Мен әрқашан түсінбейтін нәрселерге алаңдаймын.
Dialogue: 0,0:20:48.56,0:20:51.43,Default,,0,0,0,,Сіз бірдеңе істегенде, оны жасайсыз.
Dialogue: 0,0:20:51.43,0:20:54.03,Default,,0,0,0,,Мен сияқты емес
Dialogue: 0,0:21:15.06,0:21:18.39,Default,,0,0,0,,Ио, Боус, мен сені таңертең үйге келе жатырмын деп ойладым.
Dialogue: 0,0:21:18.39,0:21:20.73,Default,,0,0,0,,Хидео, сіз қалжыңдап тұрсыз.
Dialogue: 0,0:21:20.73,0:21:23.73,Default,,0,0,0,,Бар болғаны 4 сағаттан кейін➡
Dialogue: 0,0:21:23.73,0:21:26.73,Default,,0,0,0,,Бұл нағыз адамдардың ісі ме?
Dialogue: 0,0:21:28.39,0:21:31.84,Default,,0,0,0,,Әке, бұл данышпан ба?
Dialogue: 0,0:21:31.84,0:21:33.73,Default,,0,0,0,,О
Dialogue: 0,0:21:49.41,0:21:51.41,Default,,0,0,0,,Қазірдің өзінде!
Dialogue: 0,0:21:52.41,0:21:55.43,Default,,0,0,0,,Уф, менде қант таусылды.
Dialogue: 0,0:21:55.43,0:21:59.03,Default,,0,0,0,,Шоколад～Шоколад～
Dialogue: 0,0:22:00.12,0:22:02.72,Default,,0,0,0,,Ууууууу
Dialogue: 0,0:22:02.72,0:22:04.72,Default,,0,0,0,,Хмм, рахмет
Dialogue: 0,0:22:06.06,0:22:08.44,Default,,0,0,0,,Уау, керемет!
Dialogue: 0,0:22:08.44,0:22:11.40,Default,,0,0,0,,О, қайтып келдің бе? О
Dialogue: 0,0:22:11.40,0:22:14.38,Default,,0,0,0,,Іздегеніңізді тапқан сияқтысыз.
Dialogue: 0,0:22:14.38,0:22:16.40,Default,,0,0,0,,Егер солай болса, маған көмектесе аласыз ба?
Dialogue: 0,0:22:16.40,0:22:20.07,Default,,0,0,0,,Маған 3 резонанстық байланысқан қозғалыс керек.
Dialogue: 0,0:22:20.07,0:22:22.07,Default,,0,0,0,,Мен үлгере алмаймын.
Dialogue: 0,0:22:22.07,0:22:24.39,Default,,0,0,0,,Жақсы, схема жақсы.
Dialogue: 0,0:22:24.39,0:22:26.41,Default,,0,0,0,,Бұл да жақсы емес.
Dialogue: 0,0:22:26.41,0:22:30.05,Default,,0,0,0,,Иә? Бұл сіз орта мектепте үйренетін нәрсе, солай ма?
Dialogue: 0,0:22:30.05,0:22:33.07,Default,,0,0,0,,Тәжін қалай бекіттің?
Dialogue: 0,0:22:33.07,0:22:35.05,Default,,0,0,0,,Іштей ме?
Dialogue: 0,0:22:35.05,0:22:37.74,Default,,0,0,0,,Бұлай емес, олай емес.
Dialogue: 0,0:22:37.74,0:22:41.79,Default,,0,0,0,,Жағымды дыбыс шыққанша бәрін сынап көрдім.
Dialogue: 0,0:22:41.79,0:22:44.06,Default,,0,0,0,,Мен ояндым
Dialogue: 0,0:22:44.06,0:22:48.38,Default,,0,0,0,,Тәж сияқты ерекше нәрсе.
Dialogue: 0,0:22:48.38,0:22:52.40,Default,,0,0,0,,Ешбір теорияны оқымай-ақ, оны түзету мүмкін емес.
Dialogue: 0,0:22:52.40,0:22:55.42,Default,,0,0,0,,Жақсы, мен оны жөндедім.
Dialogue: 0,0:23:05.83,0:23:07.74,Default,,0,0,0,,Сәлем Мари
Dialogue: 0,0:23:07.74,0:23:12.72,Default,,0,0,0,,Аменомибашира Жапониядағы барлық бөлімшелердің орталығы.
Dialogue: 0,0:23:19.46,0:23:22.76,Default,,0,0,0,,Аспан тірегін мен аламын
Dialogue: 0,0:23:24.72,0:23:27.39,Default,,0,0,0,,Сен ең көңілдісің!
Dialogue: 0,0:23:27.39,0:23:29.39,Default,,0,0,0,,Мені сүй
Dialogue: 0,0:23:29.39,0:23:31.46,Default,,0,0,0,,Әке, бұл керемет!
Dialogue: 0,0:23:31.46,0:23:33.73,Default,,0,0,0,,Сен ессізсің.
Dialogue: 0,0:23:33.73,0:23:38.72,Default,,0,0,0,,Жауапкершілікті қайсысы бірінші алды? Бұл біз
Dialogue: 0,0:23:38.72,0:23:43.07,Default,,0,0,0,,Осы оқиғалар тізбегінің авторы кім? Бұл біз
Dialogue: 0,0:23:43.07,0:23:47.06,Default,,0,0,0,,Олай болса сахналап көрейік.
Dialogue: 0,0:23:47.06,0:23:49.06,Default,,0,0,0,,Төңкеріс туралы қастандық?
Dialogue: 0,0:23:49.06,0:23:51.40,Default,,0,0,0,,Ондай нәрсе болған жоқ.
Dialogue: 0,0:23:51.40,0:23:55.32,Default,,0,0,0,,Мұның бәрі біз туралы жаман қылмыскерлер.
Dialogue: 0,0:23:55.32,0:23:58.95,Default,,0,0,0,,Мен бірдеңені дұрыс емес жасадым деп шешсем не болады?
Dialogue: 0,0:23:58.95,0:24:02.09,Default,,0,0,0,,Енді оларды қазанда қайнатуға болады.
Dialogue: 0,0:24:02.09,0:24:04.18,Default,,0,0,0,,Қазан - Акихабара
Dialogue: 0,0:24:04.18,0:24:06.78,Default,,0,0,0,,Отын – аспан тірегі.
Dialogue: 0,0:24:06.78,0:24:09.75,Default,,0,0,0,,Күте тұрыңыз, қарсы жақ – елдің орталығы.
Dialogue: 0,0:24:09.75,0:24:12.40,Default,,0,0,0,,Күткендей, күшіміз жетпейді.
Dialogue: 0,0:24:12.40,0:24:16.07,Default,,0,0,0,,Егер бұл Халтердің қарттың протездік денесі болса, онда бұл жақсы идея.
Dialogue: 0,0:24:16.07,0:24:19.98,Default,,0,0,0,,Күшің болса, маған да берсін.
Dialogue: 0,0:24:19.98,0:24:22.41,Default,,0,0,0,,Бұл оқиға біз
Dialogue: 0,0:24:22.41,0:24:25.06,Default,,0,0,0,,Бұрын-соңды болмаған қылмыскер болыңыз
Dialogue: 0,0:24:25.06,0:24:28.06,Default,,0,0,0,,Бұл сізге не береді?
Dialogue: 0,0:24:31.89,0:24:34.24,Default,,0,0,0,,Хмм, қызық.
Dialogue: 0,0:24:34.24,0:24:37.24,Default,,0,0,0,,Ер адамның бұдан артық себебі бар ма?
Dialogue: 0,0:24:39.08,0:24:42.51,Default,,0,0,0,,Анашым, қорқып тұрсыз ба?
Dialogue: 0,0:24:42.51,0:24:45.81,Default,,0,0,0,,Ағай, мен сізді міндетті түрде қорғаймын.
Dialogue: 0,0:24:46.72,0:24:48.75,Default,,0,0,0,,Сәлем Мари
Dialogue: 0,0:24:48.75,0:24:53.73,Default,,0,0,0,,Жігіттер шарасыздан құм үйіп жатқанда, мен оны бүйірден теуіп жібердім.
Dialogue: 0,0:24:53.73,0:24:55.74,Default,,0,0,0,,Қызық көрінгені сонша, өліп бара жатырмын.
Dialogue: 0,0:24:55.74,0:24:57.74,Default,,0,0,0,,Мен не ойладым? Эй?
Dialogue: 0,0:24:59.73,0:25:03.33,Default,,0,0,0,,《Бұл сөзсіз жақсы сезінеді》
Dialogue: 0,0:25:14.40,0:25:16.47,Default,,0,0,0,,Иә.
Dialogue: 0,0:25:16.47,0:25:19.07,Default,,0,0,0,,Өте жақсы болатынына сенімдімін.
Dialogue: 0,0:25:27.06,0:25:30.06,Default,,0,0,0,,Бұл көмектесуге келмейтін нәрсе➡
Dialogue: 0,0:25:30.06,0:25:33.73,Default,,0,0,0,,Токионың ең терең бөлігінде орналасқан қауіпке➡
Dialogue: 0,0:25:33.73,0:25:36.74,Default,,0,0,0,,Қарсы шара табылмады
Dialogue: 0,0:25:36.74,0:25:41.74,Default,,0,0,0,,Мен де дәрменсіз әйелмін.
Dialogue: 0,0:25:44.46,0:25:46.46,Default,,0,0,0,,Мари
Dialogue: 0,0:25:47.40,0:25:50.40,Default,,0,0,0,,≪(Хоуко) Егер сіз осында болсаңыз
Dialogue: 0,0:25:51.42,0:26:19.42,Default,,0,0,0,,♬～
Dialogue: 0,0:28:53.08,0:28:55.17,Default,,0,0,0,,Тенмико бағанының кәсібі➡
Dialogue: 0,0:28:55.17,0:28:59.39,Default,,0,0,0,,Халтерді күш ретінде жандандыру қажет болды➡
Dialogue: 0,0:28:59.39,0:29:02.72,Default,,0,0,0,,Мари ұрыс даласында Халтердің миын табады➡
Dialogue: 0,0:29:02.72,0:29:06.73,Default,,0,0,0,,Автоматқа қосылу стратегиясын бастаңыз➡
Dialogue: 0,0:29:06.73,0:29:09.38,Default,,0,0,0,,Келесі жолы «Автоматтарды не байланыстырады»➡
Dialogue: 0,0:29:09.38,0:29:13.40,Default,,0,0,0,,Егер сіз Халтердің күйеуі болсаңыз, ұрыс даласының иісін көріңіз➡
Dialogue: 0,0:29:13.40,0:29:16.05,Default,,0,0,0,,Өлсем де, оянамын➡
Dialogue: 0,0:29:16.05,0:29:19.35,Default,,0,0,0,,Бұл ең нашар көңіл-күйде.
Dialogue: 0,0:29:20.85,0:29:26.85,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory