Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:36.26,0:01:38.76,Default,,0,0,0,,(Адамдардың айғайлауы)
Dialogue: 0,0:01:40.16,0:01:43.82,Default,,0,0,0,,Асығыңыз және тазалауды тоқтатыңыз.
Dialogue: 0,0:01:43.82,0:01:47.10,Default,,0,0,0,,Тезірек, ағайды қалай болса да алыңыз.
Dialogue: 0,0:01:47.10,0:01:49.10,Default,,0,0,0,,Сіз!
Dialogue: 0,0:01:50.09,0:01:52.68,Default,,0,0,0,,Эй, жақсысың ба?
Dialogue: 0,0:01:52.68,0:01:55.09,Default,,0,0,0,,Менің қазір ашуланатын уақытым да жоқ.
Dialogue: 0,0:01:55.09,0:01:57.28,Default,,0,0,0,,Эй, байқадың ба?
Dialogue: 0,0:01:57.28,0:02:00.10,Default,,0,0,0,,≪(Халтер) Мұнда ешкім болған жоқ➡
Dialogue: 0,0:02:00.10,0:02:02.79,Default,,0,0,0,,Әскери сізді алып кетті ме?
Dialogue: 0,0:02:02.79,0:02:06.11,Default,,0,0,0,,Бәрі қауіпсіз болғанша, жақсы.
Dialogue: 0,0:02:06.11,0:02:09.49,Default,,0,0,0,,А, есіктің арғы жағында біреу бар.
Dialogue: 0,0:02:09.49,0:02:11.49,Default,,0,0,0,,Ах
Dialogue: 0,0:02:18.45,0:02:20.44,Default,,0,0,0,,А... эй, эй
Dialogue: 0,0:02:20.44,0:02:22.52,Default,,0,0,0,,Ах
Dialogue: 0,0:02:22.52,0:02:24.79,Default,,0,0,0,,Балалар!
Dialogue: 0,0:02:24.79,0:02:27.78,Default,,0,0,0,,О, сенің аман болғаныңа қуаныштымын.
Dialogue: 0,0:02:27.78,0:02:30.43,Default,,0,0,0,,Неліктен эвакуацияланбадың?
Dialogue: 0,0:02:30.43,0:02:34.12,Default,,0,0,0,,Профессор Мари Жұмысын тастап, қашып кеткен жарымжан адам
Dialogue: 0,0:02:34.12,0:02:36.12,Default,,0,0,0,,Мен мұнда емеспін.
Dialogue: 0,0:02:38.15,0:02:40.44,Default,,0,0,0,,Дәл сендер балалар
Dialogue: 0,0:02:40.44,0:02:42.44,Default,,0,0,0,,(дыбыс)
Dialogue: 0,0:02:42.44,0:02:45.11,Default,,0,0,0,,Тағы бір қалыптан тыс тербеліс.
Dialogue: 0,0:02:45.11,0:02:47.11,Default,,0,0,0,,Мен не істей аламын?
Dialogue: 0,0:02:47.11,0:02:51.93,Default,,0,0,0,,Әрине, менде саған арнап дайындаған арнайы козир бар, Наото!
Dialogue: 0,0:02:51.93,0:02:54.82,Default,,0,0,0,,Әдемі!
Dialogue: 0,0:02:54.82,0:02:56.76,Default,,0,0,0,,Ой, мен шыдай алмаймын!
Dialogue: 0,0:02:56.76,0:03:00.66,Default,,0,0,0,,Керемет! Керемет! Бұны бірінші рет көруім! ≪(Конрад) Сіз кімсіз...?
Dialogue: 0,0:03:00.66,0:03:03.11,Default,,0,0,0,,Наото! Ахх
Dialogue: 0,0:03:03.11,0:03:42.61,Default,,0,0,0,,♬～
Dialogue: 0,0:05:44.77,0:05:48.09,Default,,0,0,0,,Уау, қандай әдемі
Dialogue: 0,0:05:48.09,0:05:50.75,Default,,0,0,0,,Әдемі және сиқырлы
Dialogue: 0,0:05:50.75,0:05:53.75,Default,,0,0,0,,Сізді толғандыратын мінсіз және толық мекеме.
Dialogue: 0,0:05:53.75,0:05:57.10,Default,,0,0,0,,Оны кім құрастырған?
Dialogue: 0,0:05:57.10,0:05:59.76,Default,,0,0,0,,Саған көп рахмет, әлгі ақымақ.
Dialogue: 0,0:05:59.76,0:06:03.76,Default,,0,0,0,,Құрметті Наруто, дәл қазір бұл сізді алаңдатудың қажеті жоқ деп ойлаймын.
Dialogue: 0,0:06:03.76,0:06:05.76,Default,,0,0,0,,Иә, айт!
Dialogue: 0,0:06:05.76,0:06:08.91,Default,,0,0,0,,Сондай көне, көгерген антиквариат
Dialogue: 0,0:06:08.91,0:06:12.02,Default,,0,0,0,,Өзімнен артық мақтауды тыңдамаймын.
Dialogue: 0,0:06:12.02,0:06:13.92,Default,,0,0,0,,Онда да жоқ!
Dialogue: 0,0:06:13.92,0:06:16.79,Default,,0,0,0,,Менің бүкіл денемді қараңыз.
Dialogue: 0,0:06:16.79,0:06:20.09,Default,,0,0,0,,Ол әдемі және ең жақсы екенін айтты.
Dialogue: 0,0:06:20.09,0:06:23.05,Default,,0,0,0,,Бұл сөздер өтірік пе?
Dialogue: 0,0:06:23.05,0:06:26.43,Default,,0,0,0,,Жоқ... жоқ, Лью ең жақсысы!
Dialogue: 0,0:06:26.43,0:06:29.92,Default,,0,0,0,,Бірақ мұндағы беріліс те керемет.
Dialogue: 0,0:06:29.92,0:06:32.94,Default,,0,0,0,,Мен не айтуым керек... иә?
Dialogue: 0,0:06:32.94,0:06:35.02,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:06:35.02,0:06:37.91,Default,,0,0,0,,Кез келген адам редуктор бола алады.
Dialogue: 0,0:06:37.91,0:06:41.10,Default,,0,0,0,,Сондықтан Льюестің құрал-саймандары ең жақсы болды.
Dialogue: 0,0:06:41.10,0:06:43.97,Default,,0,0,0,,Түсіндім, шешіп бер деп жатырсың.
Dialogue: 0,0:06:43.97,0:06:47.09,Default,,0,0,0,,Мен айтпадым, айтпадым! Жақсы емес, Льюс-сан
Dialogue: 0,0:06:47.09,0:06:50.42,Default,,0,0,0,,Уайымдама, ақымақ!
Dialogue: 0,0:06:50.42,0:06:52.83,Default,,0,0,0,,Не істеп жатырсың! Сіз солсыз
Dialogue: 0,0:06:52.83,0:06:55.75,Default,,0,0,0,,Осы жолға не үшін келді деп ойлайсың?
Dialogue: 0,0:07:02.84,0:07:05.25,Default,,0,0,0,,Иә, иә~
Dialogue: 0,0:07:05.25,0:07:07.42,Default,,0,0,0,,Сіздерді тағы да таныстыруға рұқсат етіңіздер.
Dialogue: 0,0:07:07.42,0:07:09.43,Default,,0,0,0,,Наото Миура.
Dialogue: 0,0:07:09.43,0:07:12.38,Default,,0,0,0,,Сіз әртүрлі нәрселер туралы ойлайтыныңызға сенімдімін.
Dialogue: 0,0:07:12.38,0:07:15.98,Default,,0,0,0,,Маған негізгі мұнараны жөндеуге оның көмегі керек.
Dialogue: 0,0:07:19.42,0:07:23.09,Default,,0,0,0,,Маған бәрі қараса ауырады.
Dialogue: 0,0:07:23.09,0:07:25.44,Default,,0,0,0,,Сіз қалай ойлайсыз, ол ақымақ.
Dialogue: 0,0:07:25.44,0:07:28.59,Default,,0,0,0,,Эй, бірақ маған дәл қазір бұл ақымақ керек.
Dialogue: 0,0:07:28.59,0:07:32.69,Default,,0,0,0,,Ол біздің жалғыз үмітіміз
Dialogue: 0,0:07:33.78,0:07:35.92,Default,,0,0,0,,Тазартуға дейін
Dialogue: 0,0:07:35.92,0:07:38.99,Default,,0,0,0,,3 сағат 57 минут қалды
Dialogue: 0,0:07:38.99,0:07:41.59,Default,,0,0,0,,Баланың шын немесе өтірік екеніне қарамастан➡
Dialogue: 0,0:07:41.59,0:07:44.78,Default,,0,0,0,,Осы жерде профессор Маридің соңынан ерейік.
Dialogue: 0,0:07:44.78,0:07:47.43,Default,,0,0,0,,Түсіндім, рахмет.
Dialogue: 0,0:07:47.43,0:07:50.73,Default,,0,0,0,,Наото мен білемін.
Dialogue: 0,0:08:14.11,0:08:16.46,Default,,0,0,0,,Мен оны саған сақтаймын.
Dialogue: 0,0:08:16.46,0:08:18.46,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:08:57.77,0:09:00.19,Default,,0,0,0,,Не істеп жатырсың...
Dialogue: 0,0:09:00.19,0:09:02.19,Default,,0,0,0,,Тыныш, аа...
Dialogue: 0,0:09:06.76,0:09:09.45,Default,,0,0,0,,Наото-сама, еңбегіңіз үшін рахмет.
Dialogue: 0,0:09:09.45,0:09:11.45,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:09:14.10,0:09:16.10,Default,,0,0,0,,Қалай болды?
Dialogue: 0,0:09:16.10,0:09:19.10,Default,,0,0,0,,18 орын. Бұл өте аз.
Dialogue: 0,0:09:19.10,0:09:23.09,Default,,0,0,0,,Қалыпты қозғалыстарды көрсететін 4047 орын бар.
Dialogue: 0,0:09:23.09,0:09:26.39,Default,,0,0,0,,Бұл гравитация аномалияларымен байланысты.
Dialogue: 0,0:09:27.75,0:09:31.18,Default,,0,0,0,,Менің ойымша, біз бұл туралы бірдеңе істей аламыз. Қай жерде екенін айт.
Dialogue: 0,0:09:31.18,0:09:33.44,Default,,0,0,0,,Мен мұны оқи алмаймын.
Dialogue: 0,0:09:33.44,0:09:37.76,Default,,0,0,0,,Жарайды, қалғанын анықтаймын.
Dialogue: 0,0:09:37.76,0:09:39.76,Default,,0,0,0,,Бастайық.
Dialogue: 0,0:09:39.76,0:09:42.19,Default,,0,0,0,,Доктор Мари, маған нұсқаулар беріңізші.
Dialogue: 0,0:09:42.19,0:09:44.93,Default,,0,0,0,,3-деңгейге дейінгі 12 ауытқулар
Dialogue: 0,0:09:44.93,0:09:48.10,Default,,0,0,0,,Профессор Конрад және барлығыңыз, өтінемін.
Dialogue: 0,0:09:48.10,0:09:52.44,Default,,0,0,0,,Менің уақытым жоқ, сондықтан оны бөлшектемей тікелей орындаңыз.
Dialogue: 0,0:09:52.44,0:09:56.04,Default,,0,0,0,,Халтер өзінің құрал-жабдығын әкеліп, соңынан келеді. ≪(Халтер) Түсінікті.
Dialogue: 0,0:10:01.10,0:10:04.77,Default,,0,0,0,,А... шынымен де бір ауытқушылық бар➡
Dialogue: 0,0:10:04.77,0:10:07.44,Default,,0,0,0,,Сызбаларды да оқи алмайтын бала➡
Dialogue: 0,0:10:07.44,0:10:10.44,Default,,0,0,0,,Оны қалай таптың?
Dialogue: 0,0:10:13.48,0:10:16.76,Default,,0,0,0,,Жарайды, біз бітірдік.
Dialogue: 0,0:10:16.76,0:10:19.62,Default,,0,0,0,,Бұл да
Dialogue: 0,0:10:19.62,0:10:22.72,Default,,0,0,0,,Бұл аяқталды. Ол да бітті.
Dialogue: 0,0:10:25.10,0:10:27.67,Default,,0,0,0,,Ммм, түсіндім.
Dialogue: 0,0:10:27.67,0:10:31.43,Default,,0,0,0,,Соңғысы адам кіре алмайтын жерде.
Dialogue: 0,0:10:31.43,0:10:33.45,Default,,0,0,0,,Льюдің өтініші
Dialogue: 0,0:10:33.45,0:10:37.77,Default,,0,0,0,,Маған бұйрық бере алатын жалғыз адам - Наото... Өтінемін, Азғын.
Dialogue: 0,0:10:37.77,0:10:40.27,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:10:41.75,0:10:45.42,Default,,0,0,0,,Ағымдағы орныңыздан 52,3 метрге секіріңіз
Dialogue: 0,0:10:45.42,0:10:48.53,Default,,0,0,0,,Көлденең көру сызығын 47,5 градусқа бұру
Dialogue: 0,0:10:48.53,0:10:51.13,Default,,0,0,0,,14,25 метрге әрі қарай секіргеннен кейін
Dialogue: 0,0:10:51.13,0:10:53.27,Default,,0,0,0,,Тік қону
Dialogue: 0,0:10:53.27,0:10:57.82,Default,,0,0,0,,Диаметрі 0,7 микрометрлік беріліс бұрмаланған.
Dialogue: 0,0:10:57.82,0:10:59.77,Default,,0,0,0,,Міне.
Dialogue: 0,0:10:59.77,0:11:03.14,Default,,0,0,0,,Айналуды тоқтатпай түзетіңіз.
Dialogue: 0,0:11:03.14,0:11:06.24,Default,,0,0,0,,Бұл көңілсіз, бірақ мұны тек сіз жасай аласыз.
Dialogue: 0,0:11:09.08,0:11:11.38,Default,,0,0,0,,Орындалды
Dialogue: 0,0:11:12.75,0:11:14.75,Default,,0,0,0,,Маған жабдық сияқты қарайды ма?
Dialogue: 0,0:11:14.75,0:11:16.77,Default,,0,0,0,,Дәл жабдық➡
Dialogue: 0,0:11:16.77,0:11:18.77,Default,,0,0,0,,Мен саған құрметпен қараймын.
Dialogue: 0,0:11:19.81,0:11:22.11,Default,,0,0,0,,О, Мари
Dialogue: 0,0:11:22.11,0:11:24.50,Default,,0,0,0,,Сол жақтағы қозғалыс.
Dialogue: 0,0:11:24.50,0:11:27.12,Default,,0,0,0,,Оң жақтан төртінші, иә
Dialogue: 0,0:11:27.12,0:11:30.72,Default,,0,0,0,,Бірақ тіректерді жасамайынша, бұған уақытымыз жоқ.
Dialogue: 0,0:11:31.80,0:11:33.76,Default,,0,0,0,,Эй, не...
Dialogue: 0,0:11:33.76,0:11:36.06,Default,,0,0,0,,≪(Халтер) Ал, қараңдар.
Dialogue: 0,0:11:37.93,0:11:39.93,Default,,0,0,0,,Ха
Dialogue: 0,0:11:44.43,0:11:46.43,Default,,0,0,0,,Күрсін
Dialogue: 0,0:11:48.77,0:11:51.07,Default,,0,0,0,,О, уау...
Dialogue: 0,0:11:56.10,0:11:58.70,Default,,0,0,0,,Енді әрі қарай жүрейік.
Dialogue: 0,0:12:00.53,0:12:04.44,Default,,0,0,0,,Бұл керемет, менің ханшайымым.
Dialogue: 0,0:12:04.44,0:12:07.42,Default,,0,0,0,,≪(Халтер) Сол кішкентай бастың ішінде➡
Dialogue: 0,0:12:07.42,0:12:11.11,Default,,0,0,0,,Бұрын орын алған барлық ақаулар мен жөндеу әдістерін қамтиды➡
Dialogue: 0,0:12:11.11,0:12:14.25,Default,,0,0,0,,Деректердің үлкен көлемімен салыстыру➡
Dialogue: 0,0:12:14.25,0:12:18.77,Default,,0,0,0,,Ең қысқа және ең жақсы әдісті бірден шығарып алыңыз➡
Dialogue: 0,0:12:18.77,0:12:21.77,Default,,0,0,0,,Бұл Мари Белле Бреге.
Dialogue: 0,0:12:23.77,0:12:27.77,Default,,0,0,0,,Сен сияқты мен де данышпанмын.
Dialogue: 0,0:12:41.27,0:12:43.57,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:12:45.78,0:12:47.78,Default,,0,0,0,,Мен шыдай алмаймын.
Dialogue: 0,0:12:48.76,0:12:51.78,Default,,0,0,0,,24 қабат Ауа қысымын реттеу блогы➡
Dialogue: 0,0:12:51.78,0:12:53.78,Default,,0,0,0,,Қоңыр тұрақты қалыпты мән
Dialogue: 0,0:12:54.85,0:12:57.76,Default,,0,0,0,,Диссонанс енді естілмейді
Dialogue: 0,0:12:57.76,0:12:59.76,Default,,0,0,0,,Бақылау тобының жетекшісі
Dialogue: 0,0:12:59.76,0:13:02.76,Default,,0,0,0,,Растау элементтері Барлығы анық
Dialogue: 0,0:13:03.76,0:13:05.76,Default,,0,0,0,,Хе-хе, хе-хе-хе…
Dialogue: 0,0:13:06.87,0:13:08.87,Default,,0,0,0,,Біздің күштеріміздің бұйрығы бойынша, сені ұрлап әкетуге келдім
Dialogue: 0,0:13:10.10,0:13:12.10,Default,,0,0,0,,Барлық жөндеу жұмыстары сәтті аяқталды!
Dialogue: 0,0:13:13.11,0:13:15.19,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:15.19,0:13:18.09,Default,,0,0,0,,Өтірік сияқты. Бұл шынымен сәтті болды.
Dialogue: 0,0:13:18.09,0:13:20.96,Default,,0,0,0,,Сіз тіпті түс көріп жатқан жоқсыз ба?
Dialogue: 0,0:13:20.96,0:13:23.76,Default,,0,0,0,,Мен жасадым! Мен оны істедім!
Dialogue: 0,0:13:24.75,0:13:26.77,Default,,0,0,0,,Сізге күмәнданғаным үшін кешіріңіз
Dialogue: 0,0:13:26.77,0:13:29.09,Default,,0,0,0,,Сізге рахмет...
Dialogue: 0,0:13:29.09,0:13:31.09,Default,,0,0,0,,Бірақ менде ештеңе жоқ
Dialogue: 0,0:13:31.09,0:13:34.09,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Мен сәтсіздіктің қайда екенін білуім керек.
Dialogue: 0,0:13:34.09,0:13:36.65,Default,,0,0,0,,Оны жөндеуге мүмкіндік жоқ.
Dialogue: 0,0:13:36.65,0:13:40.28,Default,,0,0,0,,Бірнеше күннен кейін анықтай алмаған жұмыс ➡
Dialogue: 0,0:13:40.28,0:13:43.10,Default,,0,0,0,,Сіз мұны жасадыңыз.
Dialogue: 0,0:13:43.10,0:13:45.50,Default,,0,0,0,,Мен...
Dialogue: 0,0:13:45.50,0:13:47.80,Default,,0,0,0,,Бұл пайдалы болды ма?
Dialogue: 0,0:13:48.76,0:13:52.86,Default,,0,0,0,,Сіз 20 миллион адамның өмірін сақтап қалдыңыз.
Dialogue: 0,0:13:55.83,0:13:58.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:58.43,0:14:01.43,Default,,0,0,0,,Аа, мм...
Dialogue: 0,0:14:03.12,0:14:05.12,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:11.11,0:14:13.58,Default,,0,0,0,,Не!? Не болды!?
Dialogue: 0,0:14:13.58,0:14:16.77,Default,,0,0,0,,Не болып жатыр!? Жағдай қандай?
Dialogue: 0,0:14:16.77,0:14:19.10,Default,,0,0,0,,≪Тазарту...
Dialogue: 0,0:14:19.10,0:14:21.97,Default,,0,0,0,,Тазалау басталды!
Dialogue: 0,0:14:21.97,0:14:23.97,Default,,0,0,0,,Иә!?
Dialogue: 0,0:14:26.76,0:14:30.36,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:15:38.10,0:15:40.09,Default,,0,0,0,,Ажырату білігі
Dialogue: 0,0:15:40.09,0:15:43.16,Default,,0,0,0,,№ 52939 біліктің ажыратылуын растау
Dialogue: 0,0:15:43.16,0:15:47.33,Default,,0,0,0,,Сіз нені баяулатасыз? Асығыңыз және тазалаңыз!
Dialogue: 0,0:15:47.33,0:15:50.46,Default,,0,0,0,,Мен ешқандай дәлел қалдыра алмаймын.
Dialogue: 0,0:15:50.46,0:15:53.06,Default,,0,0,0,,Асығыңыз! Tsk
Dialogue: 0,0:15:55.77,0:15:58.75,Default,,0,0,0,,Гравитацияны басқару жүйесі арқылы тазарту
Dialogue: 0,0:15:58.75,0:16:02.42,Default,,0,0,0,,Қаланың осы планетаның тереңіне түсуі
Dialogue: 0,0:16:02.42,0:16:06.09,Default,,0,0,0,,Тазартуды тоқтату үшін не істей аламын?
Dialogue: 0,0:16:06.09,0:16:08.75,Default,,0,0,0,,Жүйені тікелей үзу?
Dialogue: 0,0:16:08.75,0:16:10.77,Default,,0,0,0,,Уақыт жеткіліксіз
Dialogue: 0,0:16:10.77,0:16:13.84,Default,,0,0,0,,Әскерилердің теріс қылықтарын азаматтарға айтуымыз керек пе?
Dialogue: 0,0:16:13.84,0:16:17.09,Default,,0,0,0,,Тек жұртшылықты шатастырып алу үшін.
Dialogue: 0,0:16:21.44,0:16:24.44,Default,,0,0,0,,Бірдеңе жетіспейді ме?
Dialogue: 0,0:16:26.26,0:16:28.77,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:16:28.77,0:16:31.22,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:16:31.22,0:16:33.09,Default,,0,0,0,,Пыс, пыс… Э?
Dialogue: 0,0:16:33.09,0:16:35.09,Default,,0,0,0,,Қош бол?
Dialogue: 0,0:16:39.76,0:16:42.21,Default,,0,0,0,,1 сағат қалды
Dialogue: 0,0:16:42.21,0:16:44.82,Default,,0,0,0,,Жоқ, 30 минут жақсы.
Dialogue: 0,0:16:44.82,0:16:48.12,Default,,0,0,0,,Егер құлап жатқан қаланы тоқтата алсақ
Dialogue: 0,0:16:50.26,0:16:53.13,Default,,0,0,0,,Ойдан шығарылған құрал! Жоқ!
Dialogue: 0,0:16:53.13,0:16:55.43,Default,,0,0,0,,Наото
Dialogue: 0,0:17:07.76,0:17:10.44,Default,,0,0,0,,Қалалардың құлауын қалай тоқтатуға болады
Dialogue: 0,0:17:10.44,0:17:13.10,Default,,0,0,0,,Қарсы гравитация жасау керек
Dialogue: 0,0:17:13.10,0:17:16.10,Default,,0,0,0,,Мұны істеудің жалғыз жолы
Dialogue: 0,0:17:16.10,0:17:19.77,Default,,0,0,0,,Бұл энергия шығысын кері қайтаратын ойдан шығарылған беріліс.
Dialogue: 0,0:17:19.77,0:17:23.44,Default,,0,0,0,,Льюесті құрбан ету керек дейсіз бе? Оны уақытша жалға алыңыз!
Dialogue: 0,0:17:23.44,0:17:27.99,Default,,0,0,0,,Сіздің қауіпсіз болатыныңызға кепілдік жоқ! Маған сеніңіз, мен оны түзетемін!
Dialogue: 0,0:17:27.99,0:17:30.49,Default,,0,0,0,,Жоқ, мүлдем жоқ!
Dialogue: 0,0:17:55.75,0:17:58.21,Default,,0,0,0,,Соңына дейін тыңдаңыз!
Dialogue: 0,0:17:58.21,0:18:01.09,Default,,0,0,0,,Тәжін құрбандыққа шалудың қажеті жоқ.
Dialogue: 0,0:18:01.09,0:18:03.45,Default,,0,0,0,,Егер Наото-сама
Dialogue: 0,0:18:03.45,0:18:05.75,Default,,0,0,0,,Әрине мүмкін
Dialogue: 0,0:18:11.44,0:18:13.44,Default,,0,0,0,,Ах
Dialogue: 0,0:18:45.77,0:18:49.77,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:05.44,0:19:07.76,Default,,0,0,0,,Мари, айтшы.
Dialogue: 0,0:19:07.76,0:19:09.76,Default,,0,0,0,,Мен...
Dialogue: 0,0:19:10.76,0:19:13.26,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:19:14.42,0:19:16.87,Default,,0,0,0,,Тазалаудың соңғы реті➡
Dialogue: 0,0:19:16.87,0:19:19.47,Default,,0,0,0,,Гравитациялық энергияның генерациясын кері санау
Dialogue: 0,0:19:19.47,0:19:21.44,Default,,0,0,0,,Кері санақ басталады
Dialogue: 0,0:19:21.44,0:19:26.09,Default,,0,0,0,,≪(Ａ)５ ４ ３ ２ １➡
Dialogue: 0,0:19:26.09,0:19:28.09,Default,,0,0,0,,Тазарту Орындау!
Dialogue: 0,0:19:29.10,0:19:31.10,Default,,0,0,0,,≪(A) Тазартуды растау➡
Dialogue: 0,0:19:31.10,0:19:34.77,Default,,0,0,0,,Қалалық құлау 50 100 150…
Dialogue: 0,0:19:34.77,0:19:36.81,Default,,0,0,0,,(Ескерту)
Dialogue: 0,0:19:36.81,0:19:38.76,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:19:38.76,0:19:42.14,Default,,0,0,0,,Ауырлық күші кері
Dialogue: 0,0:19:42.14,0:19:45.74,Default,,0,0,0,,Қаланы біреу итеріп жатыр!
Dialogue: 0,0:19:46.85,0:19:49.10,Default,,0,0,0,,Неліктен!?
Dialogue: 0,0:19:49.10,0:19:52.40,Default,,0,0,0,,Тезірек, жүйені қайта реттейміз! (Барлығы) Иә!
Dialogue: 0,0:19:55.42,0:19:58.11,Default,,0,0,0,,Сіз қалай ойлайсыз? 30 минут
Dialogue: 0,0:19:58.11,0:20:01.41,Default,,0,0,0,,Қиялдан жасалған құрал бұдан артық ештеңені көтере алмайды.
Dialogue: 0,0:20:02.43,0:20:05.42,Default,,0,0,0,,Лью... Уайымдамаңыз.
Dialogue: 0,0:20:05.42,0:20:07.44,Default,,0,0,0,,30 минут жеткілікті
Dialogue: 0,0:20:07.44,0:20:09.45,Default,,0,0,0,,А... не болды?
Dialogue: 0,0:20:09.45,0:20:11.94,Default,,0,0,0,,Көптеген дыбыстар жақындап келеді
Dialogue: 0,0:20:11.94,0:20:14.44,Default,,0,0,0,,Бұл мен бұрын естіген дыбыс.
Dialogue: 0,0:20:16.09,0:20:18.11,Default,,0,0,0,,≪Өлтіру
Dialogue: 0,0:20:18.11,0:20:22.62,Default,,0,0,0,,Тазарту жолында тұрған кез келген адамды өлтіріңіз!
Dialogue: 0,0:20:22.62,0:20:24.70,Default,,0,0,0,,Осындай кездерде
Dialogue: 0,0:20:24.70,0:20:26.92,Default,,0,0,0,,Біраз уақыт сатып ал, солай ма?
Dialogue: 0,0:20:26.92,0:20:29.52,Default,,0,0,0,,Бұл мен үшін жақсы жұмыс.
Dialogue: 0,0:20:37.27,0:20:40.44,Default,,0,0,0,,≪(Конрад) Мен сенімен барсам болады ма?
Dialogue: 0,0:20:40.44,0:20:42.42,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:20:42.42,0:20:45.56,Default,,0,0,0,,Бұл қызықтырақ көрінеді.
Dialogue: 0,0:20:45.56,0:20:47.56,Default,,0,0,0,,≪(Халтер) Айырмашылығы жоқ.
Dialogue: 0,0:20:49.95,0:20:53.60,Default,,0,0,0,,≪(Халтер) Бұл жігіт жақсы, көздеудің қажеті жоқ.
Dialogue: 0,0:20:53.60,0:20:57.10,Default,,0,0,0,,Ендеше ашылу қоңырауын соқайық.
Dialogue: 0,0:21:01.17,0:21:03.09,Default,,0,0,0,,Ей, уайымдама.
Dialogue: 0,0:21:03.09,0:21:05.09,Default,,0,0,0,,Мен оны кейінірек түзетемін.
Dialogue: 0,0:21:05.09,0:21:07.09,Default,,0,0,0,,Ха, сенде ептілік бар.
Dialogue: 0,0:21:14.42,0:21:17.26,Default,,0,0,0,,Наото Наото!
Dialogue: 0,0:21:17.26,0:21:19.76,Default,,0,0,0,,Наото! Ах
Dialogue: 0,0:21:19.76,0:21:22.21,Default,,0,0,0,,Концентрат, Наото
Dialogue: 0,0:21:22.21,0:21:24.10,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:21:24.10,0:21:26.43,Default,,0,0,0,,Мен білемін, бірақ
Dialogue: 0,0:21:26.43,0:21:29.73,Default,,0,0,0,,Біз сізге барлық жағынан көмектесеміз, солай ма?
Dialogue: 0,0:21:42.76,0:21:45.43,Default,,0,0,0,,Иә
Dialogue: 0,0:21:45.43,0:21:47.44,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:21:47.44,0:21:50.11,Default,,0,0,0,,Әрі қарай не болады? бесінші цилиндр
Dialogue: 0,0:21:50.11,0:21:52.91,Default,,0,0,0,,Оңға 34 градусқа бұрыңыз
Dialogue: 0,0:21:54.51,0:21:57.43,Default,,0,0,0,,Бұл басқару жоғалып жатыр!
Dialogue: 0,0:21:57.43,0:22:00.43,Default,,0,0,0,,Ой, менің жоспарым...
Dialogue: 0,0:22:00.43,0:22:02.73,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:16.97,0:22:19.05,Default,,0,0,0,,Мари әлі!?
Dialogue: 0,0:22:19.05,0:22:21.05,Default,,0,0,0,,Тағы біраз!
Dialogue: 0,0:22:28.28,0:22:30.28,Default,,0,0,0,,Мари!
Dialogue: 0,0:22:31.76,0:22:33.76,Default,,0,0,0,,Ахх
Dialogue: 0,0:22:36.60,0:22:39.75,Default,,0,0,0,,<<мырза Мари, қосылым сәтті!
Dialogue: 0,0:22:39.75,0:22:42.35,Default,,0,0,0,,Лью!
Dialogue: 0,0:22:43.43,0:22:45.94,Default,,0,0,0,,73 адам із-түссіз жоғалып кетті
Dialogue: 0,0:22:45.94,0:22:47.94,Default,,0,0,0,,Наото!
Dialogue: 0,0:22:49.11,0:22:53.11,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:51.76,0:23:53.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:06.44,0:24:09.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:43.21,0:24:47.12,Default,,0,0,0,,Сіздің бетіңіз әлдеқашан күңгірт.
Dialogue: 0,0:24:47.12,0:24:49.77,Default,,0,0,0,,Маған қарай да алмайсың.
Dialogue: 0,0:24:49.77,0:24:52.07,Default,,0,0,0,,Құрметті Наото
Dialogue: 0,0:25:42.42,0:25:44.77,Default,,0,0,0,,Tic Tac➡
Dialogue: 0,0:25:44.77,0:25:46.93,Default,,0,0,0,,Tic Tac➡
Dialogue: 0,0:25:46.93,0:25:49.44,Default,,0,0,0,,Tic Tac➡
Dialogue: 0,0:25:49.44,0:25:52.10,Default,,0,0,0,,Tic Tac…
Dialogue: 0,0:25:52.10,0:26:23.10,Default,,0,0,0,,♬～
Dialogue: 0,0:28:53.80,0:28:57.10,Default,,0,0,0,,≪Төбешік мұнарасы жөнделді және Киото бөлігі сақталды➡
Dialogue: 0,0:28:57.10,0:29:00.77,Default,,0,0,0,,Бұл жұлдыз бір сәт тыныштық алған сияқты болды➡
Dialogue: 0,0:29:00.77,0:29:03.17,Default,,0,0,0,,Бірақ бұл да өткінші➡
Dialogue: 0,0:29:03.17,0:29:05.77,Default,,0,0,0,,Іргелес терең жер асты қабатында ➡
Dialogue: 0,0:29:05.77,0:29:07.86,Default,,0,0,0,,Тағдырдың көбірек берілістері➡
Dialogue: 0,0:29:07.86,0:29:11.11,Default,,0,0,0,,Шырылдап, қозғала бастады➡
Dialogue: 0,0:29:11.11,0:29:13.78,Default,,0,0,0,,Келесі жолы «Тришула»➡
Dialogue: 0,0:29:13.78,0:29:17.12,Default,,0,0,0,,Perpetual Gear➡ ұсынған Chronohook
Dialogue: 0,0:29:17.12,0:29:20.42,Default,,0,0,0,,Жалған шығарудың басталуы Пайда болады
Dialogue: 0,0:29:21.92,0:29:27.92,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory