Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:34.65,0:01:37.77,Default,,0,0,0,,Жарайды, мен келемін.
Dialogue: 0,0:01:37.77,0:01:42.37,Default,,0,0,0,,Ағай, міндетті түрде оралыңыз.
Dialogue: 0,0:01:47.68,0:01:51.28,Default,,0,0,0,,Анықтамалық декларация Бастапқы-Y сериялы есептегіш машина
Dialogue: 0,0:01:51.28,0:01:54.09,Default,,0,0,0,,«Жоюшы» Ағай
Dialogue: 0,0:01:54.09,0:01:56.74,Default,,0,0,0,,No13 дифференциалдық теңгерім дөңгелегі
Dialogue: 0,0:01:56.74,0:01:59.07,Default,,0,0,0,,Өзін-өзі жою қозғалысы басталады
Dialogue: 0,0:01:59.07,0:02:02.08,Default,,0,0,0,,Мәңгілік қозғалыс машинасынан Perpetual Gear
Dialogue: 0,0:02:02.08,0:02:06.50,Default,,0,0,0,,Жалған шығарудың басталуы Пайда болады
Dialogue: 0,0:02:06.50,0:02:08.42,Default,,0,0,0,,Өлім маневрі
Dialogue: 0,0:02:08.42,0:02:10.92,Default,,0,0,0,,Болаттың салмағы
Dialogue: 0,0:02:20.75,0:02:24.85,Default,,0,0,0,,Мари Турбинонды жинап, айналма жолға қосайық.
Dialogue: 0,0:02:24.85,0:02:27.45,Default,,0,0,0,,Мен 15 000 диапазонында бәрін жасаймын.
Dialogue: 0,0:02:27.45,0:02:30.75,Default,,0,0,0,,Мен 19 000 сериясын тазалаймын.
Dialogue: 0,0:02:54.96,0:02:58.25,Default,,0,0,0,,Бұл енді жөндеу емес...
Dialogue: 0,0:02:58.25,0:03:02.75,Default,,0,0,0,,Мұнда мүлде жаңа беріліс жасалуда.
Dialogue: 0,0:03:30.03,0:04:09.03,Default,,0,0,0,,♬～
Dialogue: 0,0:06:17.73,0:06:20.33,Default,,0,0,0,,Бар күшіңізбен еніңіз!
Dialogue: 0,0:06:35.18,0:06:37.28,Default,,0,0,0,,Шат!
Dialogue: 0,0:06:39.90,0:06:43.41,Default,,0,0,0,,Наото Мен сізге 20326 қабылдау білігін беремін!
Dialogue: 0,0:06:43.41,0:06:45.51,Default,,0,0,0,,Жарайды, ол торға түсті.
Dialogue: 0,0:07:04.40,0:07:07.92,Default,,0,0,0,,Ябеябеябе өледі өледі, ауыр өледі
Dialogue: 0,0:07:07.92,0:07:10.77,Default,,0,0,0,,Сөйлесуге шамаң жетсе, жарайды.
Dialogue: 0,0:07:10.77,0:07:12.92,Default,,0,0,0,,3 минуттан аз уақыт қалды.
Dialogue: 0,0:07:12.92,0:07:16.02,Default,,0,0,0,,Мен білемін, уау.
Dialogue: 0,0:07:20.41,0:07:25.73,Default,,0,0,0,,《Ол үлкен жігіт қазір 1033 генмигенераторды толық қуатта жұмыс істейді.》
Dialogue: 0,0:07:25.73,0:07:27.83,Default,,0,0,0,,《Зарядтау энергиясы》
Dialogue: 0,0:07:37.00,0:07:39.60,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:41.17,0:07:43.67,Default,,0,0,0,,Гррр...
Dialogue: 0,0:07:46.84,0:07:50.34,Default,,0,0,0,,1002 бар
Dialogue: 0,0:07:54.63,0:07:58.57,Default,,0,0,0,,Бұл жаман. Барған сайын бейтарап болып барады.
Dialogue: 0,0:07:58.57,0:08:00.57,Default,,0,0,0,,Өзіңізді мазақ етпеңіз.
Dialogue: 0,0:08:00.57,0:08:04.07,Default,,0,0,0,,Сіз бағананы түгел үрлеп тастауды жоспарлап отырсыз ба?
Dialogue: 0,0:08:04.07,0:08:06.57,Default,,0,0,0,,Эй, эй
Dialogue: 0,0:08:16.75,0:08:19.40,Default,,0,0,0,,Ой, не дейсің...
Dialogue: 0,0:08:19.40,0:08:23.42,Default,,0,0,0,,Ей, сен ханшайымдарды ұстадың ба?
Dialogue: 0,0:08:23.42,0:08:27.51,Default,,0,0,0,,Енді үміт арқаны үзілді ме?
Dialogue: 0,0:08:27.51,0:08:31.73,Default,,0,0,0,,≪(Халтер) Мен білмеймін, бұл өте қатты арқан➡
Dialogue: 0,0:08:31.73,0:08:36.23,Default,,0,0,0,,Оның үстіне, бұл екі бөлік бір-біріне сәйкес келетіндіктен.
Dialogue: 0,0:08:37.22,0:08:40.91,Default,,0,0,0,,≪(Хоко) Осымен қанша жұмыс кешіктірілді?
Dialogue: 0,0:08:40.91,0:08:46.08,Default,,0,0,0,,Бұл жай ғана кешігу емес, өлімге әкелетін зиян.
Dialogue: 0,0:08:46.08,0:08:50.38,Default,,0,0,0,,Дегенмен, бас тартуға ниетіңіз жоқ сияқты.
Dialogue: 0,0:08:51.74,0:08:54.41,Default,,0,0,0,,Бұл мүмкін емес. Мен тағы бір айналма жол саламын.
Dialogue: 0,0:08:54.41,0:08:56.41,Default,,0,0,0,,Мен мұны істеп жатырмын
Dialogue: 0,0:08:56.41,0:09:01.08,Default,,0,0,0,,[Спикер] (Шынайы) Мен жеңімпаз сияқтымын.
Dialogue: 0,0:09:01.08,0:09:03.23,Default,,0,0,0,,Хираяма Геннай
Dialogue: 0,0:09:03.23,0:09:06.65,Default,,0,0,0,,Сіз білесіз бе, У?
Dialogue: 0,0:09:06.65,0:09:11.34,Default,,0,0,0,,Сіз әлемді оңай бұрмалайтын және қайта жасайтын адамсыз➡
Dialogue: 0,0:09:11.34,0:09:13.57,Default,,0,0,0,,Қайтыс болмас үшін қайғы➡
Dialogue: 0,0:09:13.57,0:09:16.73,Default,,0,0,0,,Қолыңыздан келмейтін нәрсеге өкіну➡
Dialogue: 0,0:09:16.73,0:09:20.06,Default,,0,0,0,,Терең үмітсіздік
Dialogue: 0,0:09:20.06,0:09:24.74,Default,,0,0,0,,Адамзаттың қасіретін біл.
Dialogue: 0,0:09:24.74,0:09:26.90,Default,,0,0,0,,Тақырып үлкен.
Dialogue: 0,0:09:26.90,0:09:29.90,Default,,0,0,0,,Сіз адамзат атынан не айтқыңыз келеді?
Dialogue: 0,0:09:30.91,0:09:33.56,Default,,0,0,0,,《Тақырып өте үлкен, қария》
Dialogue: 0,0:09:33.56,0:09:37.08,Default,,0,0,0,,《Адамзаттың атынан не айтқыңыз келіп тұр!?》
Dialogue: 0,0:09:37.08,0:09:39.67,Default,,0,0,0,,《Біз бармыз》 Біз бармыз
Dialogue: 0,0:09:39.67,0:09:42.47,Default,,0,0,0,,Үміт үзбеңіз!
Dialogue: 0,0:09:43.59,0:09:46.07,Default,,0,0,0,,Мен көремін➡
Dialogue: 0,0:09:46.07,0:09:49.58,Default,,0,0,0,,Екі Y болды ма?➡
Dialogue: 0,0:09:49.58,0:09:53.75,Default,,0,0,0,,Адамды қанша жырласаң да➡
Dialogue: 0,0:09:53.75,0:09:56.58,Default,,0,0,0,,Мен мақұлдамаймын
Dialogue: 0,0:09:56.58,0:10:00.88,Default,,0,0,0,,Сіз адам емессіз.
Dialogue: 0,0:10:12.72,0:10:14.92,Default,,0,0,0,,≪Сіз нені айтасыз!?
Dialogue: 0,0:10:14.92,0:10:17.92,Default,,0,0,0,,Толтыру әлсіреген
Dialogue: 0,0:10:18.91,0:10:22.21,Default,,0,0,0,,У қуыршақ?
Dialogue: 0,0:10:27.18,0:10:30.32,Default,,0,0,0,,Ол күйіктерді суық сумен салқындатып отырған
Dialogue: 0,0:10:30.32,0:10:32.74,Default,,0,0,0,,Ахх
Dialogue: 0,0:10:32.74,0:10:35.34,Default,,0,0,0,,Кут вут
Dialogue: 0,0:10:38.58,0:10:40.58,Default,,0,0,0,,Coo
Dialogue: 0,0:10:43.23,0:10:45.23,Default,,0,0,0,,Ол күйіктерді суық сумен салқындатып отырған
Dialogue: 0,0:11:00.75,0:11:02.75,Default,,0,0,0,,Уф
Dialogue: 0,0:11:07.41,0:11:10.91,Default,,0,0,0,,Егер сіз осындай нәрсені жоя алмасаңыз
Dialogue: 0,0:11:10.91,0:11:16.21,Default,,0,0,0,,Тобықты не үшін жасадыңыз?
Dialogue: 0,0:11:19.58,0:11:21.88,Default,,0,0,0,,Ахххххх
Dialogue: 0,0:11:24.92,0:11:27.42,Default,,0,0,0,,Ой!
Dialogue: 0,0:11:31.56,0:11:34.62,Default,,0,0,0,,Жұмыстан шығарылмаған
Dialogue: 0,0:11:34.62,0:11:39.62,Default,,0,0,0,,Менің ойымша, олардың болжамдары қате болған жоқ.
Dialogue: 0,0:11:40.57,0:11:42.72,Default,,0,0,0,,Бұл ағай болуы керек
Dialogue: 0,0:11:42.72,0:11:45.82,Default,,0,0,0,,Айтпа, ары қарай жүр.
Dialogue: 0,0:11:53.57,0:11:56.37,Default,,0,0,0,,Ол күйіктерді суық сумен салқындатып отырған
Dialogue: 0,0:12:01.18,0:12:03.28,Default,,0,0,0,,Ахх...
Dialogue: 0,0:12:06.40,0:12:08.57,Default,,0,0,0,,Өміріңде —
Dialogue: 0,0:12:08.57,0:12:10.74,Default,,0,0,0,,Ууух!
Dialogue: 0,0:12:10.74,0:12:13.74,Default,,0,0,0,,Мен бәрін жоюым керек
Dialogue: 0,0:12:15.24,0:12:19.34,Default,,0,0,0,,Әке Ана...
Dialogue: 0,0:13:33.73,0:13:38.72,Default,,0,0,0,,Электромагниттік жеделдету мылтығы Ы-ның қуыршағына қарсы да тиімді сияқты.
Dialogue: 0,0:13:38.72,0:13:42.09,Default,,0,0,0,,Толтыру кешіктірілсе де, негізгі мылтық көп ұзамай ➡ болды
Dialogue: 0,0:13:42.09,0:13:45.25,Default,,0,0,0,,Автоматты түрде іске қосылады
Dialogue: 0,0:13:45.25,0:13:49.05,Default,,0,0,0,,Еңбегіңіз бекер болды.
Dialogue: 0,0:13:50.07,0:13:54.07,Default,,0,0,0,,Адамдар жеңеді.
Dialogue: 0,0:14:05.48,0:14:09.14,Default,,0,0,0,,(Музыкалық қораптың дыбыстары)
Dialogue: 0,0:14:24.40,0:14:27.09,Default,,0,0,0,,《Иә Чан ағай》
Dialogue: 0,0:14:27.09,0:14:29.97,Default,,0,0,0,,《Аа》
Dialogue: 0,0:14:29.97,0:14:31.91,Default,,0,0,0,,Музыканы енді ести алмай қалуым мүмкін.
Dialogue: 0,0:14:31.91,0:14:34.56,Default,,0,0,0,,《Әке》
Dialogue: 0,0:14:34.56,0:14:39.06,Default,,0,0,0,,《Менің анама солай》
Dialogue: 0,0:14:40.08,0:14:43.88,Default,,0,0,0,,《Ағай, бос уақытыңыз болса, көмектесе аласыз ба? 》
Dialogue: 0,0:14:44.91,0:14:46.91,Default,,0,0,0,,Жоқ, ол емес. Жасырынған орын. Жасырынған орын ба?
Dialogue: 0,0:15:03.92,0:15:05.92,Default,,0,0,0,,Не!?
Dialogue: 0,0:15:10.80,0:15:15.07,Default,,0,0,0,,Қожайынның өсиетін адал орындау қызметшінің міндеті.
Dialogue: 0,0:15:15.07,0:15:20.42,Default,,0,0,0,,Бір айтарым, сіңлісін бағып-қағу үлкен апаның міндеті.
Dialogue: 0,0:15:20.42,0:15:23.42,Default,,0,0,0,,Кут уһ
Dialogue: 0,0:15:26.23,0:15:30.40,Default,,0,0,0,,Енді мені өлтірудің қажеті жоқ.
Dialogue: 0,0:15:30.40,0:15:34.41,Default,,0,0,0,,Жақында негізгі мылтық атылады➡
Dialogue: 0,0:15:34.41,0:15:37.01,Default,,0,0,0,,Ху ха ха ха ха
Dialogue: 0,0:15:43.40,0:15:45.42,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:15:45.42,0:15:48.90,Default,,0,0,0,,Неліктен атпайды!?
Dialogue: 0,0:15:48.90,0:15:51.20,Default,,0,0,0,,Бұл оңай
Dialogue: 0,0:15:57.73,0:16:00.06,Default,,0,0,0,,Ағай ұстаған уақытта
Dialogue: 0,0:16:00.06,0:16:04.08,Default,,0,0,0,,Шеберім бар өнерін көрсетті.
Dialogue: 0,0:16:04.08,0:16:06.08,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:16:07.10,0:16:12.20,Default,,0,0,0,,Менің ойымша, бір адам тарапынан әлсіз ынтымақтастық болды.
Dialogue: 0,0:16:16.25,0:16:18.35,Default,,0,0,0,,Төрт қадам… бес қадам
Dialogue: 0,0:16:32.73,0:16:34.75,Default,,0,0,0,,Не
Dialogue: 0,0:16:34.75,0:16:36.92,Default,,0,0,0,,Қасиетті ағаш...➡
Dialogue: 0,0:16:36.92,0:16:40.02,Default,,0,0,0,,Жаңадан жөнделген
Dialogue: 0,0:16:43.24,0:16:46.68,Default,,0,0,0,,Сіз мұны уақытында жасаған сияқтысыз.
Dialogue: 0,0:16:46.68,0:16:52.25,Default,,0,0,0,,Бірақ ағама уәде берген уақыт өтті.
Dialogue: 0,0:16:52.25,0:16:56.85,Default,,0,0,0,,Жарайды, Лью ағаны міндетті түрде қайтарады.
Dialogue: 0,0:16:58.26,0:17:02.74,Default,,0,0,0,,Иә, иә, жас жігіт, қарт, басқа, төменде түсірілген➡
Dialogue: 0,0:17:02.74,0:17:07.25,Default,,0,0,0,,Демалуға уақыт жоқ, төменнен жаңадан келгендер көп.
Dialogue: 0,0:17:07.25,0:17:10.58,Default,,0,0,0,,Егер қашу жолын таппасақ, бұл жаман болады.
Dialogue: 0,0:17:10.58,0:17:14.08,Default,,0,0,0,,Сонда дәл сіздің алдыңызда.
Dialogue: 0,0:17:18.74,0:17:21.08,Default,,0,0,0,,Не айтып тұрсың!?
Dialogue: 0,0:17:21.08,0:17:24.47,Default,,0,0,0,,Бұл жерден секіру өз-өзіне қол жұмсау болар еді.
Dialogue: 0,0:17:24.47,0:17:26.40,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:17:26.40,0:17:30.40,Default,,0,0,0,,Біз мұнда ауа-райын басқара аламыз және жоғарылауды жасай аламыз, солай ма?
Dialogue: 0,0:17:30.40,0:17:32.91,Default,,0,0,0,,Сенің түйсігің жақсарды, Мари.
Dialogue: 0,0:17:32.91,0:17:36.06,Default,,0,0,0,,Олай болса, операцияны сізге тапсырамын!
Dialogue: 0,0:17:36.06,0:17:38.65,Default,,0,0,0,,Хью, шын айтасың ба?
Dialogue: 0,0:17:38.65,0:17:41.57,Default,,0,0,0,,Маған ұнады, Наото-чан.
Dialogue: 0,0:17:41.57,0:17:43.57,Default,,0,0,0,,Yahoo!
Dialogue: 0,0:17:43.57,0:17:46.90,Default,,0,0,0,,Мына алып денең болса да, сен оны жеңе аласың ба, ханшайым?
Dialogue: 0,0:17:46.90,0:17:49.06,Default,,0,0,0,,Сіз мені кім деп ойлайсыз?
Dialogue: 0,0:17:49.06,0:17:51.58,Default,,0,0,0,,Бұл жігіт кешірім сұрайды.
Dialogue: 0,0:17:51.58,0:17:55.91,Default,,0,0,0,,Мен қазір кетемін, қалғанын саған қалдырамын.
Dialogue: 0,0:17:55.91,0:18:02.21,Default,,0,0,0,,Уайымдама, мен сені үлкен күнәкарға айналдыру үшін бар күшімді саламын.
Dialogue: 0,0:18:12.91,0:18:15.47,Default,,0,0,0,,Мен жеңдім деп ойлаймын.
Dialogue: 0,0:18:15.47,0:18:17.92,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:18:17.92,0:18:19.90,Default,,0,0,0,,Басынан бастап өзіңе
Dialogue: 0,0:18:19.90,0:18:22.74,Default,,0,0,0,,Жеңіске жетпеген жеңілген
Dialogue: 0,0:18:22.74,0:18:26.64,Default,,0,0,0,,Наото-самамен соғыстым деп ойласаңыз...
Dialogue: 0,0:18:26.64,0:18:29.94,Default,,0,0,0,,Бұл өрескел түсінбеушілік.
Dialogue: 0,0:18:34.07,0:18:36.57,Default,,0,0,0,,Мен мақұлдамаймын➡
Dialogue: 0,0:18:36.57,0:18:41.91,Default,,0,0,0,,Дүниені кесіп өту жұмысын адам еңбегі деп оңай айта аламыз ба?➡
Dialogue: 0,0:18:41.91,0:18:46.73,Default,,0,0,0,,Ұсқынсыз және көріксіз, бітпейтін сәтсіздіктермен
Dialogue: 0,0:18:46.73,0:18:49.75,Default,,0,0,0,,Кішігірім жеңістерді жұту
Dialogue: 0,0:18:49.75,0:18:52.35,Default,,0,0,0,,Ол адам.
Dialogue: 0,0:19:00.91,0:19:02.90,Default,,0,0,0,,Ооо хахаха
Dialogue: 0,0:19:02.90,0:19:07.42,Default,,0,0,0,,Ей, сен бұлай жерге құламайсың, солай ма?
Dialogue: 0,0:19:07.42,0:19:10.92,Default,,0,0,0,,Жарайды, көтерілу келе жатыр.
Dialogue: 0,0:19:10.92,0:19:15.59,Default,,0,0,0,,3 2 1 Нөл!
Dialogue: 0,0:19:15.59,0:19:19.69,Default,,0,0,0,,Иә yahoo
Dialogue: 0,0:19:32.58,0:19:36.18,Default,,0,0,0,,Чан ағай Чан ағай
Dialogue: 0,0:19:38.90,0:19:43.57,Default,,0,0,0,,Жарайды, зақым жоқ.
Dialogue: 0,0:19:43.57,0:19:46.57,Default,,0,0,0,,Мари екеуміз оны түзете аламыз.
Dialogue: 0,0:19:47.91,0:19:49.91,Default,,0,0,0,,Жақсы
Dialogue: 0,0:19:55.75,0:19:58.25,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:20:00.40,0:20:03.89,Default,,0,0,0,,Бұзыңыз... Ол жерде болмады.
Dialogue: 0,0:20:03.89,0:20:09.40,Default,,0,0,0,,Ағай, менің қолымнан келгені осы
Dialogue: 0,0:20:09.40,0:20:15.40,Default,,0,0,0,,Мен әкеме қарсы шықтым.
Dialogue: 0,0:20:17.24,0:20:19.24,Default,,0,0,0,,Чан ағай
Dialogue: 0,0:20:19.24,0:20:22.73,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:22.73,0:20:27.25,Default,,0,0,0,,Ағай, не істеуім керек?
Dialogue: 0,0:20:27.25,0:20:29.42,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:20:29.42,0:20:32.72,Default,,0,0,0,,Мен тапсырыс алғым келеді
Dialogue: 0,0:20:41.25,0:20:43.73,Default,,0,0,0,,Бұл бұйрық.
Dialogue: 0,0:20:43.73,0:20:45.73,Default,,0,0,0,,Наото
Dialogue: 0,0:20:47.58,0:20:50.24,Default,,0,0,0,,Басымды көтеріп, барымды салдым.
Dialogue: 0,0:20:50.24,0:20:53.04,Default,,0,0,0,,Мақтауды қалайтыныңызды айтыңыз.
Dialogue: 0,0:20:57.81,0:21:00.95,Default,,0,0,0,,Ағай, қолыңыздан келгенін жасадыңыз ба?
Dialogue: 0,0:21:00.95,0:21:05.74,Default,,0,0,0,,Әй, Чан ағадан артық жұмыс істейтін адам жоқ.
Dialogue: 0,0:21:05.74,0:21:10.41,Default,,0,0,0,,Мақтауды қалаймын деп ойлау дұрыс па?
Dialogue: 0,0:21:10.41,0:21:12.41,Default,,0,0,0,,Әрине
Dialogue: 0,0:21:14.23,0:21:18.40,Default,,0,0,0,,Ағай, өйткені сіз көп еңбек еттіңіз
Dialogue: 0,0:21:18.40,0:21:20.75,Default,,0,0,0,,Біз оны дер кезінде жасадық.
Dialogue: 0,0:21:20.75,0:21:24.09,Default,,0,0,0,,Иггидің жаны өз еркімен қозғалып жатты
Dialogue: 0,0:21:24.09,0:21:27.39,Default,,0,0,0,,Тамаша, керемет жұмыс жасадың.
Dialogue: 0,0:21:32.58,0:21:37.58,Default,,0,0,0,,Уау...
Dialogue: 0,0:21:44.06,0:21:46.74,Default,,0,0,0,,≪(Карасава) Күткеніңізге рахмет, Мари-сенсэй➡
Dialogue: 0,0:21:46.74,0:21:49.90,Default,,0,0,0,,Сіздің тапсырысыңыз жеткізілді.
Dialogue: 0,0:21:49.90,0:21:52.23,Default,,0,0,0,,Бұл мүмкін емес деп айтқаным үшін кешіріңіз.
Dialogue: 0,0:21:52.23,0:21:56.40,Default,,0,0,0,,Бірақ сіз маған шынымен көмектестіңіз, рахмет.
Dialogue: 0,0:21:56.40,0:22:00.40,Default,,0,0,0,,Жоқ, мен сізге көмектесе алатыныма қуаныштымын.
Dialogue: 0,0:22:01.61,0:22:04.90,Default,,0,0,0,,Пачимонның иісі бар.
Dialogue: 0,0:22:04.90,0:22:08.20,Default,,0,0,0,,Менде бар болғаны осы болды
Dialogue: 0,0:22:10.73,0:22:14.12,Default,,0,0,0,,≪(Карасава) Мұнда да қуғыншылар жақындап келеді.
Dialogue: 0,0:22:14.12,0:22:18.81,Default,,0,0,0,,Ауа-райының қолайсыздығына қарамастан, менің демалуға уақытым аз.
Dialogue: 0,0:22:18.81,0:22:23.31,Default,,0,0,0,,Керісінше, ол қууды таратуға өте ыңғайлы.
Dialogue: 0,0:22:32.57,0:22:36.07,Default,,0,0,0,,Енді барамыз ба?
Dialogue: 0,0:22:43.08,0:22:46.49,Default,,0,0,0,,≪(Жаңалықтар) Токио үлкен шығынға ұшыраған көп бөлімнен тұратын аймақ➡
Dialogue: 0,0:22:46.49,0:22:49.39,Default,,0,0,0,,Ақыры қалпына келу мүмкіндігі бар➡
Dialogue: 0,0:22:49.39,0:22:52.39,Default,,0,0,0,,Ең көп зардап шеккен аймақ Акихабара ➡ болды
Dialogue: 0,0:22:52.39,0:22:56.56,Default,,0,0,0,,Кездейсоқ, бүкіл купе жылытылды➡
Dialogue: 0,0:22:56.56,0:23:00.06,Default,,0,0,0,,Түзетілмейтін жағдай болдырылды
Dialogue: 0,0:23:05.39,0:23:08.58,Default,,0,0,0,,Нағашы апа
Dialogue: 0,0:23:08.58,0:23:11.58,Default,,0,0,0,,Жөндеу жұмыстары аяқталды.
Dialogue: 0,0:23:11.58,0:23:16.27,Default,,0,0,0,,Иә! Бұл жөндеу деп те айтуға болмайтын уақытша шара.
Dialogue: 0,0:23:16.27,0:23:19.57,Default,,0,0,0,,Ағайдың сызбасын миынан естігенде.
Dialogue: 0,0:23:19.57,0:23:22.74,Default,,0,0,0,,Мен оны керемет түрде түзетемін.
Dialogue: 0,0:23:22.74,0:23:26.16,Default,,0,0,0,,Ақымақ болма, мен Чан ағаны жөндеймін!
Dialogue: 0,0:23:26.16,0:23:28.90,Default,,0,0,0,,Иә!? Ой!?
Dialogue: 0,0:23:28.90,0:23:32.93,Default,,0,0,0,,Егер мен оны Льюес екеуіңе қалдырсам, біз тағы бір бұзықпен бітеміз.
Dialogue: 0,0:23:32.93,0:23:37.59,Default,,0,0,0,,Не!? Сіз күтпеген нәрсе айтып жатырсыз.
Dialogue: 0,0:23:37.59,0:23:40.24,Default,,0,0,0,,Айтыңызшы, Льюдікі!
Dialogue: 0,0:23:40.24,0:23:44.39,Default,,0,0,0,,Бірақ мен Наото-саманың әпкемнің қолына түскенін қалаймын.
Dialogue: 0,0:23:44.39,0:23:48.58,Default,,0,0,0,,Оны Мариге қалдырған дұрыс болар.
Dialogue: 0,0:23:48.58,0:23:50.90,Default,,0,0,0,,Сіз не туралы айтып отырсыз, Льюес мырза!?
Dialogue: 0,0:23:50.90,0:23:54.91,Default,,0,0,0,,Ағай, қайсысын ұнатасыз, мені ме, әлде анау мина қызды ма?
Dialogue: 0,0:23:54.91,0:23:59.49,Default,,0,0,0,,Әлбетте, бұл азғынның үстінен мен екенмін, солай ма?
Dialogue: 0,0:23:59.49,0:24:03.15,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:24:03.15,0:24:05.07,Default,,0,0,0,,Ум
Dialogue: 0,0:24:05.07,0:24:10.37,Default,,0,0,0,,Мен анам мен әкемнің бірге болғанын жақсы көремін.
Dialogue: 0,0:24:12.42,0:24:15.58,Default,,0,0,0,,Баладан қайсысы жақсы деп сұрауға батылыңыз бар ма, әке ме?
Dialogue: 0,0:24:15.58,0:24:17.73,Default,,0,0,0,,Бұл жаман ата-ананың мысалы.
Dialogue: 0,0:24:17.73,0:24:19.75,Default,,0,0,0,,Әкесі кім? Анасы кім?
Dialogue: 0,0:24:19.75,0:24:22.68,Default,,0,0,0,,Сәлем екеуің!
Dialogue: 0,0:24:22.68,0:24:26.85,Default,,0,0,0,,Мазалағаным үшін кешіріңіз, бірақ бұл үлкен мәселе болады.
Dialogue: 0,0:24:26.85,0:24:28.72,Default,,0,0,0,,А, мен сені естіп тұрмын.
Dialogue: 0,0:24:28.72,0:24:33.23,Default,,0,0,0,,Үлкен флот бізді көздеп, бізге қарай бет алды.
Dialogue: 0,0:24:33.23,0:24:36.78,Default,,0,0,0,,Осындай нәрсені тез айтыңыз.
Dialogue: 0,0:24:36.78,0:24:39.08,Default,,0,0,0,,Мен жақсы нәрсе ойладым.
Dialogue: 0,0:24:39.08,0:24:41.94,Default,,0,0,0,,Бұл жаман нәрсе.
Dialogue: 0,0:24:41.94,0:24:45.57,Default,,0,0,0,,Неліктен флотты ұшырып, соғыс кемесін ұрламайсың?
Dialogue: 0,0:24:45.57,0:24:48.91,Default,,0,0,0,,Сіз шынымен де ақымақ емессіз.
Dialogue: 0,0:24:48.91,0:24:55.08,Default,,0,0,0,,Эй, жас ханым, сенесің бе? Тағдырдың берілістері
Dialogue: 0,0:24:55.08,0:25:00.69,Default,,0,0,0,,Өкінішке орай, оны бақылауға мүмкіндігім жоқ.
Dialogue: 0,0:25:00.69,0:25:05.39,Default,,0,0,0,,Бірақ бұл дүние тек берілістерден тұрады.
Dialogue: 0,0:25:05.39,0:25:08.50,Default,,0,0,0,,Барлығы солай болуы керек.
Dialogue: 0,0:25:08.50,0:25:12.40,Default,,0,0,0,,Автомат ретінде мен солай ойлаймын.
Dialogue: 0,0:25:12.40,0:25:15.79,Default,,0,0,0,,≪Бұл жақсы емес пе?
Dialogue: 0,0:25:15.79,0:25:19.57,Default,,0,0,0,,Жаңа ғана жалықтым.
Dialogue: 0,0:25:19.57,0:25:24.23,Default,,0,0,0,,Байқау жақсы, бірақ мұндай жерде сәтсіздікке жол берілмейді.
Dialogue: 0,0:25:24.23,0:25:29.35,Default,,0,0,0,,Біз қазірден бастап бұл планетаны күрделі жөндеуден өткіземіз.
Dialogue: 0,0:25:29.35,0:25:33.35,Default,,0,0,0,,Бірлессек, сәтсіздікке ұшырауымыз мүмкін емес.
Dialogue: 0,0:25:52.57,0:26:14.57,Default,,0,0,0,,♬～
Dialogue: 0,0:26:16.07,0:26:22.07,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory