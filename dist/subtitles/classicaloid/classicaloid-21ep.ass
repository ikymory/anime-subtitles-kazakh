Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.04,0:00:06.75,Default,,0,0,0,,Ахахахахаха
Dialogue: 0,0:00:06.83,0:00:08.45,Default,,0,0,0,,Хехе шынымен
Dialogue: 0,0:00:08.50,0:00:10.37,Default,,0,0,0,,Бұл қазірдің өзінде махаббат, болды
Dialogue: 0,0:00:13.04,0:00:14.62,Default,,0,0,0,,О, осыншама ұзақ
Dialogue: 0,0:00:14.83,0:00:15.66,Default,,0,0,0,,Мен қазір ұйықтаймын
Dialogue: 0,0:00:15.95,0:00:18.08,Default,,0,0,0,,Хаха, мен де жатуым керек сияқты.
Dialogue: 0,0:00:18.29,0:00:20.70,Default,,0,0,0,,Мен де ұйықтаймын, қалғанын саған тапсырамын.
Dialogue: 0,0:00:21.00,0:00:21.87,Default,,0,0,0,,Иә, Сенпай
Dialogue: 0,0:00:22.20,0:00:23.41,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:00:28.66,0:00:29.16,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:00:29.83,0:00:30.37,Default,,0,0,0,,Иә
Dialogue: 0,0:00:30.87,0:00:31.45,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:00:31.79,0:00:32.29,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:00:34.29,0:00:34.87,Default,,0,0,0,,Иә
Dialogue: 0,0:00:42.58,0:00:44.16,Default,,0,0,0,,гаа оооо
Dialogue: 0,0:00:44.37,0:00:45.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:46.12,0:00:46.70,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:00:50.41,0:00:50.75,Default,,0,0,0,,Әй?
Dialogue: 0,0:00:52.25,0:00:55.95,Default,,0,0,0,,Мен неге үнемі осында ұйықтаймын?
Dialogue: 0,0:02:27.58,0:02:31.08,Default,,0,0,0,,Неліктен? Неге менің бөлмем жоқ?
Dialogue: 0,0:02:31.45,0:02:33.54,Default,,0,0,0,,Қалғандарының бәрінің бөлмесі болса да
Dialogue: 0,0:02:33.75,0:02:36.37,Default,,0,0,0,,Бұл жерде жалғыз мен ұйықтап жатқаным біртүрлі емес пе?
Dialogue: 0,0:02:36.62,0:02:37.45,Default,,0,0,0,,Бөлмеңіз жоқ па?
Dialogue: 0,0:02:37.75,0:02:40.20,Default,,0,0,0,,Жоқ. Сондықтан мен осылай наразылық білдіріп жатырмын.
Dialogue: 0,0:02:40.29,0:02:42.50,Default,,0,0,0,,-Ахахахаха -Ой?
Dialogue: 0,0:02:42.58,0:02:44.33,Default,,0,0,0,,Бос орын жоқ екені қызық
Dialogue: 0,0:02:44.37,0:02:45.62,Default,,0,0,0,,Ки-сама
Dialogue: 0,0:02:45.79,0:02:48.16,Default,,0,0,0,,-Кешіріңіз, мен де байқамадым.
Dialogue: 0,0:02:48.41,0:02:49.16,Default,,0,0,0,,-Мен де -n
Dialogue: 0,0:02:49.41,0:02:51.45,Default,,0,0,0,,-Тіпті Хуссидің бөлмесі бар -Ух
Dialogue: 0,0:02:52.58,0:02:55.62,Default,,0,0,0,,Ал, оның қатысуы онша көп емес.
Dialogue: 0,0:02:55.83,0:02:56.62,Default,,0,0,0,,Тіпті қазір де жағдай осылай,
Dialogue: 0,0:02:56.87,0:02:59.66,Default,,0,0,0,,Мен мұнда тұратын сияқты емеспін.
Dialogue: 0,0:03:00.04,0:03:01.87,Default,,0,0,0,,Тұрғын емес, қызметші.
Dialogue: 0,0:03:02.20,0:03:03.08,Default,,0,0,0,,Аға
Dialogue: 0,0:03:03.37,0:03:04.62,Default,,0,0,0,,Тағдырыңды мойында
Dialogue: 0,0:03:04.70,0:03:06.04,Default,,0,0,0,,Аға
Dialogue: 0,0:03:06.16,0:03:09.70,Default,,0,0,0,,Таңертең ерте жиналу дегенді қалай түсінесіңдер?
Dialogue: 0,0:03:10.00,0:03:13.20,Default,,0,0,0,,Шындығында, Шу мырзаның бөлмесі жоқ екені анықталды.
Dialogue: 0,0:03:13.58,0:03:15.54,Default,,0,0,0,,Мен оны мүлде байқамадым да.
Dialogue: 0,0:03:15.62,0:03:17.83,Default,,0,0,0,,А, үй иесіне.
Dialogue: 0,0:03:18.12,0:03:20.70,Default,,0,0,0,,Жарайды, бөлмең жоқ болса, бер.
Dialogue: 0,0:03:20.91,0:03:21.95,Default,,0,0,0,,Тағы да бар, солай ма?
Dialogue: 0,0:03:22.20,0:03:24.58,Default,,0,0,0,,Өте үлкен, бір бөлме сияқты.
Dialogue: 0,0:03:30.25,0:03:33.45,Default,,0,0,0,,Мен барлық қол жетімді бөлмелерді қолданып қойған сияқтымын.
Dialogue: 0,0:03:33.75,0:03:35.08,Default,,0,0,0,,Тек осында
Dialogue: 0,0:03:35.62,0:03:36.50,Default,,0,0,0,,Сіз тұрып ұйықтайсыз ба?
Dialogue: 0,0:03:36.70,0:03:39.95,Default,,0,0,0,,Маған ұнамайды. Кішкентай болса да қарсы емеспін, бірақ кем дегенде
Dialogue: 0,0:03:40.16,0:03:43.08,Default,,0,0,0,,Қалыпты, таза жерде жатуға болатын кеңістік
Dialogue: 0,0:03:43.91,0:03:44.79,Default,,0,0,0,,Бұл жерде ше?
Dialogue: 0,0:03:45.04,0:03:48.37,Default,,0,0,0,,О, мен әрқашан бақшаның көрінісін аламын.
Dialogue: 0,0:03:48.41,0:03:49.50,Default,,0,0,0,,Мен қызғаншақпын
Dialogue: 0,0:03:49.87,0:03:53.45,Default,,0,0,0,,Жоқ, қыста тым суық, ал жазда жәндіктер болады.
Dialogue: 0,0:03:53.70,0:03:56.66,Default,,0,0,0,,Егер сіз әрқашан толық көріністе болсаңыз, құпиялылық жоқ деп ойлаймын.
Dialogue: 0,0:03:56.70,0:03:59.25,Default,,0,0,0,,Дұрыс, мені де ешкім мазаламайды.
Dialogue: 0,0:03:59.37,0:04:00.91,Default,,0,0,0,,Кейде жалғыз қалғым келеді
Dialogue: 0,0:04:01.04,0:04:03.25,Default,,0,0,0,,-Аа, ана жерде, солай ма? -Хмм?
Dialogue: 0,0:04:03.83,0:04:04.54,Default,,0,0,0,,Онда?
Dialogue: 0,0:04:05.87,0:04:06.58,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:04:07.04,0:04:09.83,Default,,0,0,0,,Мм, еш алаңдамай жалғыз.
Dialogue: 0,0:04:11.25,0:04:15.12,Default,,0,0,0,,Міне, ваннада, сен мені қорлайсың ба?
Dialogue: 0,0:04:15.20,0:04:16.70,Default,,0,0,0,,Бірақ бұл өте әдемі.
Dialogue: 0,0:04:16.79,0:04:19.66,Default,,0,0,0,,Себебі мен әрқашан мұқият тазалаймын.
Dialogue: 0,0:04:20.16,0:04:22.87,Default,,0,0,0,,Неліктен, неге, неге ұнайды?
Dialogue: 0,0:04:22.91,0:04:24.41,Default,,0,0,0,,Бұзық жігітке бөлме бар
Dialogue: 0,0:04:24.79,0:04:26.87,Default,,0,0,0,,Мен сияқты еңбекқор, салмақты адамдарға
Dialogue: 0,0:04:26.95,0:04:28.41,Default,,0,0,0,,Олар сізге бөлме бермейді.
Dialogue: 0,0:04:28.75,0:04:31.37,Default,,0,0,0,,- Шуберт кешігіп келді - А?
Dialogue: 0,0:04:31.41,0:04:32.87,Default,,0,0,0,,Мұнда келу реті бойынша бөлмелер
Dialogue: 0,0:04:33.16,0:04:35.79,Default,,0,0,0,,-Талантты ретімен шығар? Эххе-а? Нуууу
Dialogue: 0,0:04:36.20,0:04:37.45,Default,,0,0,0,,О, қымбаттым
Dialogue: 0,0:04:37.58,0:04:38.50,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:04:38.66,0:04:39.37,Default,,0,0,0,,Үй иесі
Dialogue: 0,0:04:39.41,0:04:40.33,Default,,0,0,0,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:04:40.66,0:04:44.41,Default,,0,0,0,,Мен бөлмені пайдалану құқығына тағы да шағымданғым келеді.
Dialogue: 0,0:04:45.41,0:04:49.70,Default,,0,0,0,,Ол осы Отоваканға үлес дәрежесіне пропорционалды болуы керек.
Dialogue: 0,0:04:50.29,0:04:51.66,Default,,0,0,0,,Жарна деңгейі?
Dialogue: 0,0:04:52.20,0:04:55.33,Default,,0,0,0,,? Сонымен, сіз қандай үлес қосасыз?
Dialogue: 0,0:04:55.91,0:05:01.41,Default,,0,0,0,,Тезек Тамақты тазалау, әжетхананы тазалау, бақшаны аралау
Dialogue: 0,0:05:01.91,0:05:03.75,Default,,0,0,0,,Мен бәрін істеп жатырмын.
Dialogue: 0,0:05:04.08,0:05:04.87,Default,,0,0,0,,-Ха-Уу
Dialogue: 0,0:05:05.04,0:05:05.75,Default,,0,0,0,,Мен мүлде не болып жатқанын түсінбеймін.
Dialogue: 0,0:05:06.33,0:05:07.20,Default,,0,0,0,,Қарапайым нәрсе
Dialogue: 0,0:05:07.33,0:05:07.75,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:05:08.08,0:05:10.70,Default,,0,0,0,,Мен пәтер ақысын төлеген жоқпын, бұл туралы.
Dialogue: 0,0:05:10.83,0:05:14.54,Default,,0,0,0,,Иә, бірақ егер жалдау ақысы төленбесе
Dialogue: 0,0:05:14.83,0:05:18.45,Default,,0,0,0,,Уф, мен бұл сарайды талай рет дағдарыстан құтқардым.
Dialogue: 0,0:05:19.70,0:05:20.29,Default,,0,0,0,,Сонымен
Dialogue: 0,0:05:20.83,0:05:23.04,Default,,0,0,0,,Мен де Утананың туған күнінде
Dialogue: 0,0:05:24.66,0:05:25.33,Default,,0,0,0,,Уф
Dialogue: 0,0:05:25.66,0:05:28.87,Default,,0,0,0,,Мен өзімді бақытты сезіндім, бірақ бұл үлес болды ма?
Dialogue: 0,0:05:29.12,0:05:31.95,Default,,0,0,0,,Не болса да, Бето-сан мен Моту-санмен салыстырсаңыз,
Dialogue: 0,0:05:32.37,0:05:35.33,Default,,0,0,0,,Шу мырзаның істеп жатқаны өте түсінікті, солай емес пе?
Dialogue: 0,0:05:35.45,0:05:37.87,Default,,0,0,0,,Иә? Егер бұл музыка болса, мен де
Dialogue: 0,0:05:39.75,0:05:43.16,Default,,0,0,0,,Шу мырзаның музыкасы әсерлі емес.
Dialogue: 0,0:05:43.41,0:05:44.83,Default,,0,0,0,,Әсер жоқ
Dialogue: 0,0:05:45.33,0:05:47.79,Default,,0,0,0,,Ах, бірақ бұл өте пайдалы.
Dialogue: 0,0:05:48.00,0:05:49.87,Default,,0,0,0,,Үй шаруасына кім көмектеседі?
Dialogue: 0,0:05:50.37,0:05:51.50,Default,,0,0,0,,алып ағаштар орманға жүгіріп кірді
Dialogue: 0,0:05:52.20,0:05:54.08,Default,,0,0,0,,Музыкалық шоу?
Dialogue: 0,0:05:54.20,0:05:56.50,Default,,0,0,0,,Иә, бөлмені ұтып алуға ставка жасаңыз.
Dialogue: 0,0:05:56.83,0:05:59.20,Default,,0,0,0,,Музыкамыздан жарысайық
Dialogue: 0,0:05:59.62,0:06:01.37,Default,,0,0,0,,Музыка бәсекеге қабілетті емес
Dialogue: 0,0:06:01.70,0:06:04.29,Default,,0,0,0,,Иә, мен мұны білемін, бірақ
Dialogue: 0,0:06:04.37,0:06:06.29,Default,,0,0,0,,Жақсы, қызық көрінеді.
Dialogue: 0,0:06:06.62,0:06:08.04,Default,,0,0,0,,Мүмкін бұл бір жағынан әділ шығар
Dialogue: 0,0:06:08.62,0:06:10.45,Default,,0,0,0,,Мен жалдау ақысын төлеп тұрсам да
Dialogue: 0,0:06:11.12,0:06:13.50,Default,,0,0,0,,Жарайды, мен үлкендерден кешірім сұраймын.
Dialogue: 0,0:06:13.79,0:06:18.20,Default,,0,0,0,,Бұл жерде көпшіліктің шешімі болғандықтан, сізді алаңдататын нәрсе бар ма?
Dialogue: 0,0:06:18.41,0:06:18.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:19.50,0:06:21.91,Default,,0,0,0,,Біз музыкамыз оны шешкенін қалаймыз.
Dialogue: 0,0:06:22.00,0:06:23.54,Default,,0,0,0,,Сізде алаңдаушылық бар ма?
Dialogue: 0,0:06:23.83,0:06:25.91,Default,,0,0,0,,Хмм, мен уайымдаймын десем де.
Dialogue: 0,0:06:26.20,0:06:28.45,Default,,0,0,0,,Әркім пәтер ақысын төлемейтіні ше?
Dialogue: 0,0:06:28.58,0:06:32.12,Default,,0,0,0,,Ендеше мына музыкамен бұл туралы сөйлесейік
Dialogue: 0,0:06:32.50,0:06:36.41,Default,,0,0,0,,Хмм, мәселе жоқ, а
Dialogue: 0,0:06:37.79,0:06:39.75,Default,,0,0,0,,Осы бөлмені қалпына келтіру керек пе?
Dialogue: 0,0:06:40.00,0:06:42.45,Default,,0,0,0,,Иә, егер сіз мұны пайдалана алсаңыз
Dialogue: 0,0:06:42.50,0:06:45.37,Default,,0,0,0,,Бізде тағы бір бөлме болады, солай ма? Егер біз оны қайтадан тазарта алсақ.
Dialogue: 0,0:06:45.45,0:06:47.50,Default,,0,0,0,,Әрине, сенің осында тұратыныңа қуаныштымын.
Dialogue: 0,0:06:47.66,0:06:49.33,Default,,0,0,0,,Сіз де абайсыздасыз.
Dialogue: 0,0:06:49.54,0:06:51.75,Default,,0,0,0,,Сізде қанша музыка болса да, мұндай нәрсені істеуге мүмкіндік жоқ.
Dialogue: 0,0:06:51.79,0:06:53.20,Default,,0,0,0,,-Жолдан кет бала -Уау иә
Dialogue: 0,0:06:54.12,0:06:56.20,Default,,0,0,0,,Қолымнан келмейді десең, ашуланасың.
Dialogue: 0,0:06:57.29,0:06:58.91,Default,,0,0,0,,Оны ер адам деп атайды.
Dialogue: 0,0:07:02.45,0:07:04.50,Default,,0,0,0,,Бетоның 18 саны шықты
Dialogue: 0,0:07:06.12,0:07:07.79,Default,,0,0,0,,Кенет ол Бето болуды шешті.
Dialogue: 0,0:07:07.87,0:07:09.04,Default,,0,0,0,,-Әлі жоқ -Уау, не?
Dialogue: 0,0:07:10.29,0:07:12.08,Default,,0,0,0,,Мен үшін де бұл туралы.
Dialogue: 0,0:07:18.79,0:07:20.08,Default,,0,0,0,,Мазалама, Қасқыр.
Dialogue: 0,0:07:20.12,0:07:22.37,Default,,0,0,0,,Бөлмені таза ұстайтын менмін
Dialogue: 0,0:07:22.50,0:07:24.58,Default,,0,0,0,,-Екеуіңе жақсылық жаса. -Не, не?
Dialogue: 0,0:07:25.00,0:07:28.12,Default,,0,0,0,,Махаббат жоқ емес пе?
Dialogue: 0,0:07:30.08,0:07:31.58,Default,,0,0,0,,О, жекпе-жек пе?
Dialogue: 0,0:07:31.75,0:07:35.00,Default,,0,0,0,,-Қараңдаршы, енді шықты, иә? -Хмм хмм
Dialogue: 0,0:07:35.29,0:07:38.91,Default,,0,0,0,,Шулы, мүмкін емес.
Dialogue: 0,0:07:39.41,0:07:40.50,Default,,0,0,0,,Қамауға болмайды
Dialogue: 0,0:07:42.20,0:07:44.00,Default,,0,0,0,,Ха, қызық болды.
Dialogue: 0,0:07:44.29,0:07:47.33,Default,,0,0,0,,Нәтижесінде ештеңе өзгерген жоқ.
Dialogue: 0,0:07:47.70,0:07:50.70,Default,,0,0,0,,Әй, сенің кезегің жеткен сияқты.
Dialogue: 0,0:07:51.83,0:07:56.12,Default,,0,0,0,,Айқай, менің сезімталдығым ұшады
Dialogue: 0,0:08:00.25,0:08:06.87,Default,,0,0,0,,Ууууууууууу менің сезімталдығым
Dialogue: 0,0:08:08.83,0:08:15.50,Default,,0,0,0,,Сквирт, поп, секіру Не болды? менің сезімталдығым
Dialogue: 0,0:08:16.20,0:08:19.54,Default,,0,0,0,,Буфу-кун, сен музыка ойнай алмайтыныңа сенімдісің бе?
Dialogue: 0,0:08:19.75,0:08:22.95,Default,,0,0,0,,Сен неге сонша ақымақсың? Ой, енді ойласам
Dialogue: 0,0:08:23.25,0:08:25.00,Default,,0,0,0,,Ол кезде де менің еркім емес еді.
Dialogue: 0,0:08:25.37,0:08:27.33,Default,,0,0,0,,Аға ағаммен кездесіп, көңілім толқымай тұра алмадым.
Dialogue: 0,0:08:28.50,0:08:31.41,Default,,0,0,0,,Басқа музыкамен де солай болды.
Dialogue: 0,0:08:31.70,0:08:35.16,Default,,0,0,0,,Менің музыкам бақылаусыз ағып жатыр ма?
Dialogue: 0,0:08:35.75,0:08:38.41,Default,,0,0,0,,Мүмкін сіз оны өз еркіңізбен қоя алмайсыз ба?
Dialogue: 0,0:08:38.45,0:08:39.00,Default,,0,0,0,,Угу
Dialogue: 0,0:08:39.08,0:08:42.04,Default,,0,0,0,,Немесе сіз тіпті көрсете алмайтын біртүрлі музыка ма?
Dialogue: 0,0:08:42.16,0:08:42.58,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:08:42.79,0:08:45.75,Default,,0,0,0,,Иә? Бірақ мен музыканы дұрыс пайдалана алмаймын деп ойлаймын.
Dialogue: 0,0:08:45.83,0:08:47.33,Default,,0,0,0,,Классикалоидтың мағынасы жоқ, солай ма?
Dialogue: 0,0:08:47.41,0:08:50.75,Default,,0,0,0,,Уф гаан
Dialogue: 0,0:08:52.95,0:08:56.70,Default,,0,0,0,,Мынау Шу-кун ба? Туфли-кун?
Dialogue: 0,0:09:02.75,0:09:05.25,Default,,0,0,0,,Қош бол, жүрегім жатқан жер
Dialogue: 0,0:09:06.00,0:09:08.08,Default,,0,0,0,,Жоқ, мен солай ойладым.
Dialogue: 0,0:09:08.41,0:09:10.62,Default,,0,0,0,,Бәлкім, бұл менің өзімшілдігім болар.
Dialogue: 0,0:09:11.33,0:09:13.29,Default,,0,0,0,,Менің бұл жерде болуыма ешқандай себеп жоқ.
Dialogue: 0,0:09:14.12,0:09:17.00,Default,,0,0,0,,Мен қандай болу керек екенімді іздеп саяхатқа шығамын.
Dialogue: 0,0:09:18.33,0:09:20.62,Default,,0,0,0,,Менің бар болуымның мәні неде?
Dialogue: 0,0:09:25.37,0:09:28.12,Default,,0,0,0,,Адамдар мені тіпті ойламайды.
Dialogue: 0,0:09:34.62,0:09:37.08,Default,,0,0,0,,-Ах! -Бұл не? Ол өте көп.
Dialogue: 0,0:09:37.62,0:09:39.83,Default,,0,0,0,,О, бұл мүмкін емес.
Dialogue: 0,0:09:40.04,0:09:43.83,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:09:49.29,0:09:51.20,Default,,0,0,0,,Мен осында болсам да
Dialogue: 0,0:09:53.79,0:09:57.58,Default,,0,0,0,,Менің бар болуымның құны қандай?
Dialogue: 0,0:09:58.83,0:10:00.62,Default,,0,0,0,,Мен туралы ешкім жоқ
Dialogue: 0,0:10:00.75,0:10:02.79,Default,,0,0,0,,-Мен мұны істегім келмейді Иә -Ха
Dialogue: 0,0:10:03.00,0:10:05.08,Default,,0,0,0,,Мен мұны істей алмайтын сияқтымын Иә
Dialogue: 0,0:10:05.37,0:10:07.25,Default,,0,0,0,,Мен мұны істей алмайтын сияқтымын Иә
Dialogue: 0,0:10:07.33,0:10:07.83,Default,,0,0,0,,Ах
Dialogue: 0,0:10:09.79,0:10:11.33,Default,,0,0,0,,Иә, міне.
Dialogue: 0,0:10:12.20,0:10:15.04,Default,,0,0,0,,Бұл менің жаңадан туған жерім.
Dialogue: 0,0:10:15.79,0:10:18.41,Default,,0,0,0,,Егер ол осында болса, онда менің бар болу себебім сөзсіз
Dialogue: 0,0:10:19.87,0:10:23.62,Default,,0,0,0,,Бетховен Моцарт Лист Шопен
Dialogue: 0,0:10:24.29,0:10:26.66,Default,,0,0,0,,Отоваканның классикалоиды сол күйінде қалады.
Dialogue: 0,0:10:27.45,0:10:27.91,Default,,0,0,0,,- Иә? -А
Dialogue: 0,0:10:28.45,0:10:29.25,Default,,0,0,0,,Дошибе
Dialogue: 0,0:10:29.91,0:10:31.95,Default,,0,0,0,,Біреу ұмытып кеткен сияқты
Dialogue: 0,0:10:32.04,0:10:33.12,Default,,0,0,0,,Ақылсыздық
Dialogue: 0,0:10:33.41,0:10:35.12,Default,,0,0,0,,Иә, бұл менің қиялым ғана.
Dialogue: 0,0:10:35.20,0:10:40.00,Default,,0,0,0,,Күте тұрыңыз, мен осында Шубертпін.
Dialogue: 0,0:10:41.20,0:10:41.83,Default,,0,0,0,,Уф
Dialogue: 0,0:10:52.20,0:10:54.83,Default,,0,0,0,,Менің болмысым қандай?
Dialogue: 0,0:10:56.33,0:10:57.33,Default,,0,0,0,,...
Dialogue: 0,0:11:03.87,0:11:05.33,Default,,0,0,0,,Иә?Иә?
Dialogue: 0,0:11:05.66,0:11:16.45,Default,,0,0,0,,Вааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:11:17.08,0:11:20.54,Default,,0,0,0,,Ааааааааааааааааааааааааааа
Dialogue: 0,0:11:23.50,0:11:27.95,Default,,0,0,0,,Әй, ой-а-а
Dialogue: 0,0:11:28.25,0:11:31.12,Default,,0,0,0,,А? Біз қайдамыз?
Dialogue: 0,0:11:43.33,0:11:43.83,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:11:46.37,0:11:47.08,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:11:47.79,0:11:48.33,Default,,0,0,0,,Уау
Dialogue: 0,0:11:49.04,0:11:50.12,Default,,0,0,0,,Маған осылай аталған «толқындарды» жібергің келе ме?
Dialogue: 0,0:11:52.95,0:11:53.29,Default,,0,0,0,,Көресіңдер әлі
Dialogue: 0,0:11:54.29,0:11:54.75,Default,,0,0,0,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:11:56.75,0:11:57.70,Default,,0,0,0,,Hiii
Dialogue: 0,0:11:58.04,0:11:58.66,Default,,0,0,0,,Уау
Dialogue: 0,0:11:59.37,0:12:00.16,Default,,0,0,0,,Иә
Dialogue: 0,0:12:01.16,0:12:02.87,Default,,0,0,0,,Елеусіз қалудың өзі ауырады, бірақ
Dialogue: 0,0:12:03.37,0:12:05.29,Default,,0,0,0,,Адамдар мені елемегенде қиын
Dialogue: 0,0:12:09.70,0:12:12.16,Default,,0,0,0,,Ах ха
Dialogue: 0,0:12:18.41,0:12:22.25,Default,,0,0,0,,Иә, мен бірдеңе жегім келеді.
Dialogue: 0,0:12:22.95,0:12:31.66,Default,,0,0,0,,Иә, жоқ, мен өз шегімдемін.
Dialogue: 0,0:12:37.83,0:12:43.08,Default,,0,0,0,,Мен осылай өлемін бе? Мен өзімнің қандай екенімді білмеймін.
Dialogue: 0,0:12:44.20,0:12:45.29,Default,,0,0,0,,Эрвин, бұның бәрі сенің операцияңның нәтижесі ме?
Dialogue: 0,0:12:45.75,0:12:48.25,Default,,0,0,0,,Уау, мұндай жерде қандай кездейсоқтық.
Dialogue: 0,0:12:48.37,0:12:48.75,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:12:51.91,0:12:52.87,Default,,0,0,0,,Сәлем
Dialogue: 0,0:12:54.83,0:12:55.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:56.50,0:13:00.41,Default,,0,0,0,,Хахахахахаха Бұл қиын болған болуы керек.
Dialogue: 0,0:13:00.87,0:13:03.79,Default,,0,0,0,,Бұл күлкі емес.
Dialogue: 0,0:13:04.00,0:13:07.83,Default,,0,0,0,,Менің ойымды ешкім түсінбейді.
Dialogue: 0,0:13:07.91,0:13:10.66,Default,,0,0,0,,-Иә, иә, өте қызықсыз. -Иә иә.
Dialogue: 0,0:13:11.04,0:13:14.00,Default,,0,0,0,,Сіз бізді жай ғана жасайсыз.
Dialogue: 0,0:13:14.04,0:13:17.58,Default,,0,0,0,,Білмейтіндей кейіп таныту Ондай нәрсе бар ма? Уфф
Dialogue: 0,0:13:17.70,0:13:20.58,Default,,0,0,0,,Жарайды, мен сендермен жүргенде олай айтпаңдар.
Dialogue: 0,0:13:20.66,0:13:23.20,Default,,0,0,0,,Арче жігіттері сізді бірден табады.
Dialogue: 0,0:13:23.75,0:13:26.79,Default,,0,0,0,,Дүниежүзін осылай аралаудың себебі осы ма?
Dialogue: 0,0:13:27.29,0:13:31.20,Default,,0,0,0,,Иә, бұл менің сүйікті жасырынатын орындарымның бірі.
Dialogue: 0,0:13:31.83,0:13:32.37,Default,,0,0,0,,Алмастар! Мұнда алмастар көмілген.
Dialogue: 0,0:13:32.75,0:13:33.12,Default,,0,0,0,,Әй?
Dialogue: 0,0:13:33.62,0:13:35.79,Default,,0,0,0,,Бұл еркін атмосфера
Dialogue: 0,0:13:36.54,0:13:40.45,Default,,0,0,0,,Біз бәріміз осы сәттен ләззат алғымыз келген нәрсені жасаймыз.
Dialogue: 0,0:13:41.54,0:13:43.16,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,0:13:44.08,0:13:46.83,Default,,0,0,0,,Маған тағы бір сусын бере аласыз ба? Және авокадо
Dialogue: 0,0:13:50.62,0:13:55.04,Default,,0,0,0,,...
Dialogue: 0,0:13:55.25,0:13:55.91,Default,,0,0,0,,Бұл сенсің ғой, иә?
Dialogue: 0,0:13:56.25,0:13:56.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:57.41,0:14:00.45,Default,,0,0,0,,Мені не үшін жараттың?
Dialogue: 0,0:14:03.83,0:14:07.29,Default,,0,0,0,,Маған жауап берші, мені неге жараттың?
Dialogue: 0,0:14:07.75,0:14:11.66,Default,,0,0,0,,Мен сонда не істедім?
Dialogue: 0,0:14:12.25,0:14:15.00,Default,,0,0,0,,Сіз мені алған жоқсыз
Dialogue: 0,0:14:16.50,0:14:18.16,Default,,0,0,0,,Неге менің аға буын өкілдеріммен?
Dialogue: 0,0:14:18.20,0:14:20.12,Default,,0,0,0,,Менімен қашып кетпедің бе?
Dialogue: 0,0:14:22.08,0:14:23.87,Default,,0,0,0,,Тіпті мені жаратқан саған да
Dialogue: 0,0:14:24.29,0:14:26.66,Default,,0,0,0,,Менің бар болуым қажет емес пе?
Dialogue: 0,0:14:28.91,0:14:31.62,Default,,0,0,0,,Жақсы, одендегі авокадо
Dialogue: 0,0:14:32.08,0:14:32.37,Default,,0,0,0,,болып табылады
Dialogue: 0,0:14:33.29,0:14:36.75,Default,,0,0,0,,Еріктің бұл түрі әлемді рахатқа бөлейді.
Dialogue: 0,0:14:37.08,0:14:39.12,Default,,0,0,0,,Дәл қазір маңызды емес. Авокадо.
Dialogue: 0,0:14:39.70,0:14:41.29,Default,,0,0,0,,Шынымды айтсам, сендер де балалар.
Dialogue: 0,0:14:41.66,0:14:44.58,Default,,0,0,0,,Мен жай ғана қалағанымды жасадым және бәрі жақсы болды.
Dialogue: 0,0:14:45.08,0:14:49.33,Default,,0,0,0,,Иә, иә, неге өз қалауыңызша істемейсіз?
Dialogue: 0,0:14:49.75,0:14:50.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:50.70,0:14:52.87,Default,,0,0,0,,Сонда сен кімсің?
Dialogue: 0,0:14:53.04,0:14:54.87,Default,,0,0,0,,Адамдар өз қалауынша шешім қабылдай алады.
Dialogue: 0,0:14:55.50,0:14:56.62,Default,,0,0,0,,Сен әлі күнге дейін қылмыскерлердің өлтіріліп жатқанын Цукиге айтпағансың ба?
Dialogue: 0,0:14:56.79,0:15:00.04,Default,,0,0,0,,Саса, бүгін кешке үлкен сусын ішейік
Dialogue: 0,0:15:00.20,0:15:02.37,Default,,0,0,0,,Не? Хахахахахаха
Dialogue: 0,0:15:05.79,0:15:07.70,Default,,0,0,0,,Эй, эй
Dialogue: 0,0:15:08.08,0:15:12.04,Default,,0,0,0,,Хмм? Ай ха
Dialogue: 0,0:15:12.58,0:15:13.62,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:15:13.79,0:15:16.12,Default,,0,0,0,,Не?
Dialogue: 0,0:15:16.91,0:15:20.08,Default,,0,0,0,,...
Dialogue: 0,0:15:24.16,0:15:24.66,Default,,0,0,0,,Га
Dialogue: 0,0:15:24.87,0:15:26.25,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:15:26.50,0:15:31.66,Default,,0,0,0,,Бұл жаман. Менде қазір ақша жоқ.
Dialogue: 0,0:15:32.20,0:15:34.41,Default,,0,0,0,,Ой ммм
Dialogue: 0,0:15:34.66,0:15:35.91,Default,,0,0,0,,Гегегеге
Dialogue: 0,0:15:37.58,0:15:39.66,Default,,0,0,0,,-Ахахахахахаха -Хмм
Dialogue: 0,0:15:40.04,0:15:40.95,Default,,0,0,0,,Ммм
Dialogue: 0,0:15:41.70,0:15:43.33,Default,,0,0,0,,-Хак -н эй
Dialogue: 0,0:15:44.83,0:15:48.54,Default,,0,0,0,,Уаааааааааааааааааааааааааааа
Dialogue: 0,0:16:03.41,0:16:04.04,Default,,0,0,0,,О
Dialogue: 0,0:16:04.54,0:16:05.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:06.00,0:16:06.79,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:16:06.87,0:16:09.41,Default,,0,0,0,,Әй, тым тозған емес пе? бұл үй
Dialogue: 0,0:16:09.62,0:16:11.16,Default,,0,0,0,,Сол себепті де күшейтілген шығар.
Dialogue: 0,0:16:11.95,0:16:14.75,Default,,0,0,0,,Неліктен тайфундар маусымнан тыс болады?
Dialogue: 0,0:16:15.29,0:16:16.33,Default,,0,0,0,,Сіз қалай ойлайсыз? Сол
Dialogue: 0,0:16:16.62,0:16:18.75,Default,,0,0,0,,Ей, осы жерден жел мінсең
Dialogue: 0,0:16:18.79,0:16:20.50,Default,,0,0,0,,Ол өте жақсы ұша алатын сияқты емес пе?
Dialogue: 0,0:16:20.58,0:16:23.45,Default,,0,0,0,,Мен мұндай жағдайда жиі ойлаймын.
Dialogue: 0,0:16:23.66,0:16:24.95,Default,,0,0,0,,Кернеу жоқ
Dialogue: 0,0:16:25.41,0:16:29.79,Default,,0,0,0,,Бұл сынақ, ашыңыз тағдырымды.
Dialogue: 0,0:16:29.87,0:16:30.29,Default,,0,0,0,,(Камо) Жылдам! Ол қалай болғанда да тез арада жазылып кетеді.
Dialogue: 0,0:16:31.04,0:16:31.66,Default,,0,0,0,,-Ааа -Уф
Dialogue: 0,0:16:32.70,0:16:33.20,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:16:33.79,0:16:34.50,Default,,0,0,0,,Не болды?
Dialogue: 0,0:16:34.83,0:16:37.08,Default,,0,0,0,,Жоқ, қазір дауылдың арғы жағында
Dialogue: 0,0:16:38.25,0:16:39.33,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:39.45,0:16:40.12,Default,,0,0,0,,Бұл құс.
Dialogue: 0,0:16:40.50,0:16:41.25,Default,,0,0,0,,Бұл ұшақ.
Dialogue: 0,0:16:41.41,0:16:43.54,Default,,0,0,0,,Жоқ, құбыжық?
Dialogue: 0,0:16:46.54,0:16:47.20,Default,,0,0,0,,Батпырауықтар?
Dialogue: 0,0:16:47.58,0:16:50.08,Default,,0,0,0,,Вааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:16:50.29,0:16:53.58,Default,,0,0,0,,Ииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииярняр.
Dialogue: 0,0:16:53.70,0:16:54.50,Default,,0,0,0,,Шу мырза?
Dialogue: 0,0:16:54.54,0:16:58.37,Default,,0,0,0,,Уау, маған көмектесіңізші.
Dialogue: 0,0:16:59.54,0:17:00.25,Default,,0,0,0,,Угу
Dialogue: 0,0:17:01.91,0:17:04.16,Default,,0,0,0,,А, рахмет, Сенпай.
Dialogue: 0,0:17:04.20,0:17:06.04,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:17:06.12,0:17:06.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:06.75,0:17:08.62,Default,,0,0,0,,Дұрыс, мен тым бос емес кезде.
Dialogue: 0,0:17:08.66,0:17:10.16,Default,,0,0,0,,Неге жалғыз ойнайсың?
Dialogue: 0,0:17:10.54,0:17:11.12,Default,,0,0,0,,Жоқ
Dialogue: 0,0:17:11.20,0:17:11.91,Default,,0,0,0,,Ақылсыздық
Dialogue: 0,0:17:12.37,0:17:12.91,Default,,0,0,0,,Ол қатты жараланған еді...
Dialogue: 0,0:17:13.08,0:17:15.16,Default,,0,0,0,,Енді бос отыруға уақыт жоқ.
Dialogue: 0,0:17:15.54,0:17:16.75,Default,,0,0,0,,Маған бірден көмектесуге рұқсат етіңіз.
Dialogue: 0,0:17:17.87,0:17:18.41,Default,,0,0,0,,Иә
Dialogue: 0,0:17:29.83,0:17:33.12,Default,,0,0,0,,Соңғы бірнеше күн бойы мұнда болмағаныма сене алмадым.
Dialogue: 0,0:17:33.37,0:17:38.33,Default,,0,0,0,,Ешкім байқамады ма? мен туралы ешкім
Dialogue: 0,0:17:39.70,0:17:45.29,Default,,0,0,0,,Менің сезімімді білмей әркім ойына келгенін істейді
Dialogue: 0,0:17:46.54,0:17:47.16,Default,,0,0,0,,Авокадо
Dialogue: 0,0:17:47.33,0:17:47.75,Default,,0,0,0,,Хмм
Dialogue: 0,0:17:48.58,0:17:52.04,Default,,0,0,0,,Еріктің мұндай түрі әлемді қызықты етеді.
Dialogue: 0,0:17:52.50,0:17:54.87,Default,,0,0,0,,Ендеше неге қалағаныңды істемейсің?
Dialogue: 0,0:18:02.66,0:18:11.12,Default,,0,0,0,,Мен мұны істеймін. Мен де. Мен де. Қалағаныңды істе.
Dialogue: 0,0:18:12.87,0:18:13.87,Default,,0,0,0,,Не?
Dialogue: 0,0:18:14.37,0:18:17.37,Default,,0,0,0,,Бұл музыка ма?
Dialogue: 0,0:18:18.54,0:18:22.04,Default,,0,0,0,,Бұл Франц Шуберт жазған «Ібіліс».
Dialogue: 0,0:18:22.41,0:18:26.12,Default,,0,0,0,,Поэзияны музыкаға баулу Бұл Шуберттің мамандығы: Лидер.
Dialogue: 0,0:18:30.08,0:18:31.50,Default,,0,0,0,,Балалар, осы уақытқа дейін қорқынышты болдыңдар.
Dialogue: 0,0:18:31.54,0:18:33.08,Default,,0,0,0,,Сен мені мазақ етіп тұрсың
Dialogue: 0,0:18:33.75,0:18:35.50,Default,,0,0,0,,Бірақ мен осы уақытқа дейін кіммін?
Dialogue: 0,0:18:35.58,0:18:37.50,Default,,0,0,0,,Бір және екі талғам әртүрлі.
Dialogue: 0,0:18:37.91,0:18:39.62,Default,,0,0,0,,Иә! Мен оны кездестіргеннен бері
Dialogue: 0,0:18:39.66,0:18:40.50,Default,,0,0,0,,Не өзгерді?
Dialogue: 0,0:18:40.79,0:18:42.62,Default,,0,0,0,,Мен тек басқалардың не ойлайтынына мән беремін.
Dialogue: 0,0:18:42.66,0:18:44.16,Default,,0,0,0,,Мен өмір сүрдім, бірақ мағынасыз.
Dialogue: 0,0:18:44.29,0:18:46.12,Default,,0,0,0,,Ақымақ болу дұрыс.
Dialogue: 0,0:18:46.20,0:18:46.58,Default,,0,0,0,,Әрқашан
Dialogue: 0,0:18:46.62,0:18:48.66,Default,,0,0,0,,Міндеттеме Түсіндім, үндеме.
Dialogue: 0,0:18:48.79,0:18:50.04,Default,,0,0,0,,Саяхаттың соңына дейін күресу
Dialogue: 0,0:18:50.16,0:18:53.16,Default,,0,0,0,,Жауап осы қалада табылды
Dialogue: 0,0:18:53.62,0:18:56.37,Default,,0,0,0,,Иә! авокадо! Өзің болу - бұл
Dialogue: 0,0:18:56.50,0:18:57.75,Default,,0,0,0,,Бұл іздейтін нәрсе емес
Dialogue: 0,0:18:57.79,0:18:59.08,Default,,0,0,0,,Маған айтты
Dialogue: 0,0:18:59.16,0:19:00.91,Default,,0,0,0,,Міне! авокадо
Dialogue: 0,0:19:01.08,0:19:03.91,Default,,0,0,0,,еркін, өзімшіл, қалағаныңызша
Dialogue: 0,0:19:04.12,0:19:05.83,Default,,0,0,0,,Бұл жақсы сезінеді!
Dialogue: 0,0:19:06.87,0:19:08.12,Default,,0,0,0,,Әрқашан балалар
Dialogue: 0,0:19:08.16,0:19:09.25,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,0:19:09.75,0:19:10.87,Default,,0,0,0,,Мен де өзіме ұнайтын іспен айналысамын.
Dialogue: 0,0:19:11.08,0:19:12.66,Default,,0,0,0,,Бір-бірлеп айтып берейін.
Dialogue: 0,0:19:13.16,0:19:13.91,Default,,0,0,0,,Бірінші, Шопен
Dialogue: 0,0:19:14.25,0:19:16.16,Default,,0,0,0,,Бұл сіздің денеңіз Тексеріңіз!
Dialogue: 0,0:19:16.41,0:19:19.62,Default,,0,0,0,,Интернетте болғаныңызда, сіз өрескелсіз. Бөлмеңізден шықпаңыз.
Dialogue: 0,0:19:20.04,0:19:21.70,Default,,0,0,0,,Бейтаныс қорқынышты
Dialogue: 0,0:19:22.04,0:19:24.37,Default,,0,0,0,,Шындық қандай?
Dialogue: 0,0:19:24.45,0:19:27.00,Default,,0,0,0,,Екі өлшемде өмір сүру, онда бұл бақытсыз
Dialogue: 0,0:19:27.12,0:19:28.37,Default,,0,0,0,,Әрқашан
Dialogue: 0,0:19:28.50,0:19:31.91,Default,,0,0,0,,Махаббат тізімін жинау Сізге арналған сұрақтар
Dialogue: 0,0:19:32.41,0:19:34.95,Default,,0,0,0,,Мен жалдау ақысын төлегенше бірдеңе бола ма?
Dialogue: 0,0:19:35.12,0:19:37.62,Default,,0,0,0,,Бұл арнада сызат жоқ.
Dialogue: 0,0:19:37.95,0:19:39.00,Default,,0,0,0,,Сәлем! Йо! Үй иесі!
Dialogue: 0,0:19:39.12,0:19:41.04,Default,,0,0,0,,ЖОҚ! Айта берейін
Dialogue: 0,0:19:41.08,0:19:42.91,Default,,0,0,0,,Бүгін сол жас ханым
Dialogue: 0,0:19:43.00,0:19:45.58,Default,,0,0,0,,Жалға алу Шулы болса да
Dialogue: 0,0:19:45.87,0:19:48.29,Default,,0,0,0,,Менің бөлмем қайда?
Dialogue: 0,0:19:48.83,0:19:50.95,Default,,0,0,0,,Бұл кім? Сен мияу
Dialogue: 0,0:19:51.00,0:19:51.58,Default,,0,0,0,,Айт...
Dialogue: 0,0:19:54.12,0:19:54.91,Default,,0,0,0,,Дарындылық...
Dialogue: 0,0:19:58.45,0:19:58.87,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:19:59.41,0:20:02.04,Default,,0,0,0,,Жер бетіндегі барлық адамдарға қарағанда еркін
Dialogue: 0,0:20:02.16,0:20:04.54,Default,,0,0,0,,Өзгенің қиындығын білмеймін.
Dialogue: 0,0:20:04.79,0:20:07.00,Default,,0,0,0,,Мен оны көшіріп жатқан жоқпын, бұл рас.
Dialogue: 0,0:20:07.29,0:20:09.91,Default,,0,0,0,,Түйсікпен өмір сүретін ана
Dialogue: 0,0:20:12.41,0:20:13.66,Default,,0,0,0,,Мен сені танығым келеді
Dialogue: 0,0:20:13.75,0:20:15.00,Default,,0,0,0,,Мен осы уақытқа дейін келдім
Dialogue: 0,0:20:15.08,0:20:16.54,Default,,0,0,0,,Мен сені құрметтеймін, Сенпай.
Dialogue: 0,0:20:16.70,0:20:17.58,Default,,0,0,0,,Сондықтан мүлдем!
Dialogue: 0,0:20:17.79,0:20:19.33,Default,,0,0,0,,Біз мұны осы жерде еңсеруіміз керек.
Dialogue: 0,0:20:19.37,0:20:20.00,Default,,0,0,0,,Биік қабырға
Dialogue: 0,0:20:20.16,0:20:21.83,Default,,0,0,0,,Менің бұған деген сезімім
Dialogue: 0,0:20:21.87,0:20:22.54,Default,,0,0,0,,Бұл безендіру емес.
Dialogue: 0,0:20:23.33,0:20:25.87,Default,,0,0,0,,Жақсы уақыт Өзін-өзі тану да жоғарылайды
Dialogue: 0,0:20:26.04,0:20:26.79,Default,,0,0,0,,Мұқият тыңдаңыз
Dialogue: 0,0:20:26.87,0:20:28.29,Default,,0,0,0,,Бұл менің рифмалауым
Dialogue: 0,0:20:28.62,0:20:30.00,Default,,0,0,0,,Басқалардың не ойлайтыны сізді қызықтырмаса да
Dialogue: 0,0:20:30.04,0:20:30.87,Default,,0,0,0,,Бұл мағынасыз болып көрінеді.
Dialogue: 0,0:20:31.12,0:20:33.70,Default,,0,0,0,,Сен жасаған жаман тұшпара сияқты
Dialogue: 0,0:20:38.58,0:20:41.16,Default,,0,0,0,,Мен ашулы Шубертпін.
Dialogue: 0,0:20:41.20,0:20:43.66,Default,,0,0,0,,Бұл дүниеде бәрі мені ашуландырады.
Dialogue: 0,0:20:43.79,0:20:46.37,Default,,0,0,0,,Мен менмін, менен кем емеспін
Dialogue: 0,0:20:46.41,0:20:49.16,Default,,0,0,0,,Мен дәл қазір дәл осы жерде тұрмын.
Dialogue: 0,0:20:49.37,0:20:51.75,Default,,0,0,0,,өзімшіл
Dialogue: 0,0:20:52.12,0:20:54.50,Default,,0,0,0,,Не, жақсы сезінеді ме?
Dialogue: 0,0:20:55.12,0:20:57.33,Default,,0,0,0,,Сіз маған не үйреттіңіз
Dialogue: 0,0:20:57.37,0:21:00.58,Default,,0,0,0,,Иә! авокадо рахмет
Dialogue: 0,0:21:00.70,0:21:02.62,Default,,0,0,0,,Рахмет сізге Авокадо
Dialogue: 0,0:21:02.75,0:21:05.33,Default,,0,0,0,,Рахмет Авокадо Рахмет
Dialogue: 0,0:21:05.58,0:21:07.91,Default,,0,0,0,,Авокадо Рахмет
Dialogue: 0,0:21:08.08,0:21:11.12,Default,,0,0,0,,Авокадо Рахмет Рахмет
Dialogue: 0,0:21:18.04,0:21:20.50,Default,,0,0,0,,А-а-а
Dialogue: 0,0:21:23.91,0:21:26.70,Default,,0,0,0,,Fufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufu
Dialogue: 0,0:21:30.37,0:21:35.04,Default,,0,0,0,,Қайырлы таң, Шу мырза?
Dialogue: 0,0:21:35.41,0:21:36.54,Default,,0,0,0,,Мен үйге келген жоқпын.
Dialogue: 0,0:21:36.79,0:21:38.45,Default,,0,0,0,,Иә? Сондай-ақ?
Dialogue: 0,0:21:38.66,0:21:40.58,Default,,0,0,0,,Мүмкін мен де бүгін таңертең үйге барармын.
Dialogue: 0,0:21:41.08,0:21:43.25,Default,,0,0,0,,Мен сол күннен бастап мүлде өзгердім.
Dialogue: 0,0:21:43.58,0:21:45.45,Default,,0,0,0,,Мен өзім қалаған нәрсені істеймін.
Dialogue: 0,0:21:45.79,0:21:48.87,Default,,0,0,0,,Саған рахмет, менің жұмысым көп, тазалау, кір жуу сияқты.
Dialogue: 0,0:21:48.91,0:21:49.79,Default,,0,0,0,,Мен сені мазалап жүрмін
Dialogue: 0,0:21:50.79,0:21:51.20,Default,,0,0,0,,-га -мм
Dialogue: 0,0:21:51.70,0:21:55.00,Default,,0,0,0,,Қош келдіңіз, Шу мырза
Dialogue: 0,0:21:55.58,0:21:58.25,Default,,0,0,0,,Негізі мен Шу мырзаның досымын.
Dialogue: 0,0:21:58.50,0:22:00.29,Default,,0,0,0,,Мен бұл керемет деп ойладым.
Dialogue: 0,0:22:00.91,0:22:03.75,Default,,0,0,0,,Маған рэп және басқа нәрселер туралы айтып бере аласыз ба?
Dialogue: 0,0:22:04.12,0:22:08.29,Default,,0,0,0,,Үміт жоқ. Мен бұл таланттан бас тартамын, жоқ жоқ.
Dialogue: 0,0:22:08.54,0:22:09.00,Default,,0,0,0,,Хмм?
Dialogue: 0,0:22:09.62,0:22:11.54,Default,,0,0,0,,Жаман аралассаң, күйіп кетесің.
Dialogue: 0,0:22:12.16,0:22:13.25,Default,,0,0,0,,Ха ха ха
Dialogue: 0,0:22:13.87,0:22:17.04,Default,,0,0,0,,А, Шу-сан, сені күттіргенім үшін кешір.
Dialogue: 0,0:22:17.58,0:22:20.29,Default,,0,0,0,,Мен тазалау үшін көп жұмыс жасадым, ақыры бір бөлме бос болды...
Dialogue: 0,0:22:20.33,0:22:23.83,Default,,0,0,0,,Мен енді боспын, бір бөлмеде байланып қалғым келмейді
Dialogue: 0,0:22:24.04,0:22:27.04,Default,,0,0,0,,Қалағаныңызша ұйықтаңыз, иә
Dialogue: 0,0:22:27.16,0:22:28.41,Default,,0,0,0,,Маған осылай аталған «толқындарды» жібергің келе ме?
Dialogue: 0,0:22:28.79,0:22:31.45,Default,,0,0,0,,Сонда сізге бөлме керек емес пе?
Dialogue: 0,0:22:31.75,0:22:33.37,Default,,0,0,0,,Ия
Dialogue: 0,0:22:33.45,0:22:34.45,Default,,0,0,0,,Ммм
Dialogue: 0,0:22:37.33,0:22:41.25,Default,,0,0,0,,Уф уф ааа ааа
Dialogue: 0,0:22:41.62,0:22:46.37,Default,,0,0,0,,Мен қатты ренжідім. Кешіріңіз.
Dialogue: 0,0:22:55.87,0:22:57.37,Default,,0,0,0,,Балалар, осы уақытқа дейін қорқынышты болдыңдар.
Dialogue: 0,0:22:57.41,0:22:58.83,Default,,0,0,0,,Сен мені мазақ қылдың
Dialogue: 0,0:22:59.41,0:23:01.25,Default,,0,0,0,,Бірақ мен осы уақытқа дейін кіммін?
Dialogue: 0,0:23:01.33,0:23:03.16,Default,,0,0,0,,Бір және екі талғам әртүрлі.
Dialogue: 0,0:23:03.62,0:23:05.45,Default,,0,0,0,,Иә! Мен оны кездестіргеннен бері
Dialogue: 0,0:23:05.54,0:23:06.25,Default,,0,0,0,,Не өзгерді?
Dialogue: 0,0:23:06.50,0:23:08.37,Default,,0,0,0,,Мен тек басқалардың не ойлайтынына мән беремін.
Dialogue: 0,0:23:08.58,0:23:09.87,Default,,0,0,0,,Мен өмір сүрдім, бірақ бұл мағынасыз
Dialogue: 0,0:23:10.12,0:23:11.87,Default,,0,0,0,,Ақымақ болу дұрыс.
Dialogue: 0,0:23:11.95,0:23:12.29,Default,,0,0,0,,Әрқашан
Dialogue: 0,0:23:12.41,0:23:14.41,Default,,0,0,0,,Міндеттеме Түсіндім, үндеме.
Dialogue: 0,0:23:14.54,0:23:15.79,Default,,0,0,0,,Саяхаттың соңына дейін күресу
Dialogue: 0,0:23:15.95,0:23:18.75,Default,,0,0,0,,Жауап осы қалада табылды
Dialogue: 0,0:23:19.37,0:23:21.87,Default,,0,0,0,,Иә! авокадо! Өзің болу - бұл
Dialogue: 0,0:23:22.12,0:23:23.50,Default,,0,0,0,,Бұл іздейтін нәрсе емес.
Dialogue: 0,0:23:23.54,0:23:24.95,Default,,0,0,0,,Маған айтты
Dialogue: 0,0:23:25.04,0:23:26.54,Default,,0,0,0,,Міне! авокадо
Dialogue: 0,0:23:26.83,0:23:29.66,Default,,0,0,0,,еркін, өзімшіл, қалағаныңызша
Dialogue: 0,0:23:29.83,0:23:31.54,Default,,0,0,0,,Бұл жақсы сезінеді!
Dialogue: 0,0:23:41.83,0:23:44.20,Default,,0,0,0,,Мен ашулы Шубертпін.
Dialogue: 0,0:23:44.29,0:23:46.79,Default,,0,0,0,,Бұл дүниеде бәрі мені ашуландырады.
Dialogue: 0,0:23:47.00,0:23:49.50,Default,,0,0,0,,Мен менмін, өзімнен кем емес
Dialogue: 0,0:23:49.58,0:23:52.25,Default,,0,0,0,,Мен дәл қазір дәл осы жерде тұрмын.
Dialogue: 0,0:23:52.37,0:23:54.83,Default,,0,0,0,,өзімшіл
Dialogue: 0,0:23:55.00,0:23:58.12,Default,,0,0,0,,Не, жақсы сезінеді ме?
Dialogue: 0,0:23:58.29,0:24:00.41,Default,,0,0,0,,Сіз маған не үйреттіңіз
Dialogue: 0,0:24:00.50,0:24:03.75,Default,,0,0,0,,Иә! авокадо рахмет
Dialogue: 0,0:24:03.83,0:24:05.66,Default,,0,0,0,,Рахмет сізге авокадо
Dialogue: 0,0:24:05.75,0:24:08.54,Default,,0,0,0,,Рахмет Авокадо Рахмет
Dialogue: 0,0:24:08.75,0:24:11.08,Default,,0,0,0,,Авокадо Рахмет
Dialogue: 0,0:24:11.16,0:24:14.87,Default,,0,0,0,,Авокадо Рахмет Рахмет
Dialogue: 0,0:24:19.62,0:24:23.33,Default,,0,0,0,,Ол данышпанның миына әсер етіп, жасап, бұзады.
Dialogue: 0,0:24:23.58,0:24:27.83,Default,,0,0,0,,Экстаз мен қараңғылықты тудыратын кәріптас кесе.
Dialogue: 0,0:24:28.04,0:24:31.79,Default,,0,0,0,,Бұл азғыруларға толы өте қауіпті кесе.
