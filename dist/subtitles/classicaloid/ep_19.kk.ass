Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.62,0:00:07.37,Default,,0,0,0,,Міне, барамыз
Dialogue: 0,0:00:07.70,0:00:09.91,Default,,0,0,0,,Көрерменнен факсты оқып көрейік.
Dialogue: 0,0:00:10.70,0:00:11.95,Default,,0,0,0,,Мен Куракураны жақсы көремін
Dialogue: 0,0:00:12.45,0:00:15.33,Default,,0,0,0,,Екеуі ажырасып кетті деген қауесет бар.
Dialogue: 0,0:00:15.83,0:00:17.45,Default,,0,0,0,,Біз шынымен жақсы доспыз, солай ма?
Dialogue: 0,0:00:17.87,0:00:20.33,Default,,0,0,0,,Сайтама префектурасындағы Куракура Шибутсудан
Dialogue: 0,0:00:20.62,0:00:23.95,Default,,0,0,0,,Сіз бұған сенбейсіз, солай ма? Сенсең, сұрақ қойма, жарай ма?
Dialogue: 0,0:00:24.25,0:00:25.41,Default,,0,0,0,,Олай болса.
Dialogue: 0,0:00:25.50,0:00:27.33,Default,,0,0,0,,Куракура әлі де жақсы қарым-қатынаста емес.
Dialogue: 0,0:00:27.54,0:00:29.91,Default,,0,0,0,,Біз шынымен жақсы доспыз.
Dialogue: 0,0:00:30.37,0:00:32.50,Default,,0,0,0,,Бүгін де көлікте тым көп сөйледім.
Dialogue: 0,0:00:32.62,0:00:33.83,Default,,0,0,0,,Менеджерім маған ұрысты...
Dialogue: 0,0:00:33.91,0:00:34.25,Default,,0,0,0,,Чайко-чан?
Dialogue: 0,0:00:34.29,0:00:34.50,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:00:34.54,0:00:35.16,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:00:35.37,0:00:38.16,Default,,0,0,0,,Жолда мен көлікте ұйықтап жатырмын.
Dialogue: 0,0:00:38.45,0:00:40.33,Default,,0,0,0,,-Мен осылай ұйықтап қалдым -Ахаха
Dialogue: 0,0:00:41.00,0:00:42.95,Default,,0,0,0,,Әңгіме бір-біріне сәйкес келмейді.
Dialogue: 0,0:00:43.41,0:00:44.70,Default,,0,0,0,,Менің аяғым ауырады
Dialogue: 0,0:00:44.79,0:00:45.12,Default,,0,0,0,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:00:46.20,0:00:49.29,Default,,0,0,0,,Сайтамалықтар, қарап тұрсың ба? Мен сене алар емеспін.
Dialogue: 0,0:00:49.41,0:00:51.12,Default,,0,0,0,,Сенемін деп айтпа
Dialogue: 0,0:00:51.33,0:00:54.25,Default,,0,0,0,,Мен және Бада-чан бір-бірімізге мүлде сенбейміз.
Dialogue: 0,0:01:01.66,0:01:03.08,Default,,0,0,0,,Хмм
Dialogue: 0,0:01:05.70,0:01:06.62,Default,,0,0,0,,Хмм
Dialogue: 0,0:01:08.50,0:01:09.62,Default,,0,0,0,,Хмм
Dialogue: 0,0:01:13.08,0:01:13.50,Default,,0,0,0,,Иә
Dialogue: 0,0:01:18.70,0:01:19.50,Default,,0,0,0,,Бұл
Dialogue: 0,0:01:19.58,0:01:20.41,Default,,0,0,0,,Еңбектеріңіз үшін рахмет
Dialogue: 0,0:01:20.54,0:01:20.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:24.20,0:01:29.20,Default,,0,0,0,,Тезолют Абсац
Dialogue: 0,0:01:33.66,0:01:34.08,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:01:34.62,0:01:37.29,Default,,0,0,0,,Сіз ертеңнен бастап кеңсеге келудің қажеті жоқ дедіңіз.
Dialogue: 0,0:01:37.50,0:01:39.87,Default,,0,0,0,,А, мойын, Чайко-чан.
Dialogue: 0,0:01:40.00,0:01:50.25,Default,,0,0,0,,Мен күте алмаймын
Dialogue: 0,0:01:57.04,0:01:57.83,Default,,0,0,0,,Уф
Dialogue: 0,0:01:58.45,0:02:00.12,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:02:00.50,0:02:01.00,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:02:02.20,0:02:03.58,Default,,0,0,0,,Гаа
Dialogue: 0,0:02:08.50,0:02:11.58,Default,,0,0,0,,AH дәл сол жерде
Dialogue: 0,0:03:43.04,0:03:49.70,Default,,0,0,0,,-АХ, мен сені сол жерден көріп тұрмын, -Тоқта, қол бұлға, о
Dialogue: 0,0:03:49.75,0:03:51.70,Default,,0,0,0,,Мен сізді неге тастап кеткенін толық түсіндім.
Dialogue: 0,0:03:51.91,0:03:53.50,Default,,0,0,0,,-Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:03:53.91,0:03:57.04,Default,,0,0,0,,- Кура Кура тарады. Осыдан кейін мен жеке дебют жасадым.
Dialogue: 0,0:03:57.20,0:03:57.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:58.00,0:03:59.54,Default,,0,0,0,,- -
Dialogue: 0,0:03:59.58,0:04:01.20,Default,,0,0,0,,-Бұл жерде және қазір жақсы -Аға
Dialogue: 0,0:04:01.41,0:04:05.08,Default,,0,0,0,,-Осы жерде шамамен Фуку -Ну Нуу
Dialogue: 0,0:04:05.12,0:04:05.62,Default,,0,0,0,,Бұл
Dialogue: 0,0:04:06.04,0:04:06.54,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:07.04,0:04:07.95,Default,,0,0,0,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:04:09.12,0:04:11.62,Default,,0,0,0,,Не? Utanae-nchi?
Dialogue: 0,0:04:11.79,0:04:14.41,Default,,0,0,0,,-Гах -Дана Отовакан залы
Dialogue: 0,0:04:14.91,0:04:17.33,Default,,0,0,0,,Әркімнің өз бөлмесі, бақшасы, т.б.
Dialogue: 0,0:04:17.70,0:04:19.29,Default,,0,0,0,,Оларды бөлу керек еді.
Dialogue: 0,0:04:19.54,0:04:20.95,Default,,0,0,0,,Гооееееееееееееееееееееееееееееее
Dialogue: 0,0:04:21.54,0:04:22.41,Default,,0,0,0,,-A -Геееееееее
Dialogue: 0,0:04:22.50,0:04:23.33,Default,,0,0,0,,-О -Гуееееееее
Dialogue: 0,0:04:23.54,0:04:24.12,Default,,0,0,0,,-Хмм? -еееееее
Dialogue: 0,0:04:24.54,0:04:25.04,Default,,0,0,0,,-Хмм? -еееееее
Dialogue: 0,0:04:26.41,0:04:30.87,Default,,0,0,0,,Үйдің адамдары, Мусиктің «Аққу көлі» әлеміне
Dialogue: 0,0:04:31.45,0:04:32.33,Default,,0,0,0,,Қан жарылысы!
Dialogue: 0,0:04:32.95,0:04:36.79,Default,,0,0,0,,«Аққу көлі» Бұл сіздің музыкаңыз ба?
Dialogue: 0,0:04:37.33,0:04:37.79,Default,,0,0,0,,Мынаны қараңыз
Dialogue: 0,0:04:37.87,0:04:38.25,Default,,0,0,0,,болып табылады
Dialogue: 0,0:04:41.37,0:04:41.95,Default,,0,0,0,,Көздер?
Dialogue: 0,0:04:42.50,0:04:45.95,Default,,0,0,0,,Мен Ротбарт шайтан құсымын
Dialogue: 0,0:04:46.16,0:04:47.25,Default,,0,0,0,,Хусси, солай ма?
Dialogue: 0,0:04:47.50,0:04:49.00,Default,,0,0,0,,Жоқ, ол тым үлкен
Dialogue: 0,0:04:49.20,0:04:52.62,Default,,0,0,0,,Мен Ротбарт шайтан құсымын
Dialogue: 0,0:04:53.04,0:04:54.20,Default,,0,0,0,,Хусси, солай ма?
Dialogue: 0,0:04:54.37,0:04:56.41,Default,,0,0,0,,Бұл Ротбарт.
Dialogue: 0,0:04:57.25,0:05:01.62,Default,,0,0,0,,Бұл сарай енді трагедия сахнасына айналады, өйткені
Dialogue: 0,0:05:02.20,0:05:03.25,Default,,0,0,0,,Себебі?
Dialogue: 0,0:05:04.37,0:05:06.37,Default,,0,0,0,,Сарайда ғашық болғандар
Dialogue: 0,0:05:06.70,0:05:08.75,Default,,0,0,0,,Қарғыс атқан қара аққудың қолына түскен
Dialogue: 0,0:05:09.37,0:05:13.04,Default,,0,0,0,,Өйткені ол аяқталуы керек.
Dialogue: 0,0:05:13.29,0:05:16.41,Default,,0,0,0,,Иә? Не, сіз біртүрлі музыка қолданасыз ба?
Dialogue: 0,0:05:16.70,0:05:18.75,Default,,0,0,0,,Бәлкім, тастап кеткен шоктан немесе бірдеңеден.
Dialogue: 0,0:05:18.79,0:05:19.70,Default,,0,0,0,,-Тоқташы -Уф
Dialogue: 0,0:05:19.83,0:05:21.08,Default,,0,0,0,,Мені араластырмаңыз
Dialogue: 0,0:05:21.12,0:05:23.91,Default,,0,0,0,,-Мен мұны істегім келмейді, бірақ мен оны тоқтата алмаймын -Ууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:05:23.95,0:05:27.20,Default,,0,0,0,,Үйдің ішінде ғашық болсаң, ойын бітеді.
Dialogue: 0,0:05:27.50,0:05:29.79,Default,,0,0,0,,Бірақ махаббат кенеттен болуы мүмкін емес.
Dialogue: 0,0:05:30.20,0:05:32.45,Default,,0,0,0,,Мүлде жоқ. Бұл жерде ондай нәрсе жоқ.
Dialogue: 0,0:05:32.66,0:05:34.25,Default,,0,0,0,,Сасық ауаның ізі жоқ.
Dialogue: 0,0:05:34.41,0:05:36.87,Default,,0,0,0,,Менің ағам осылай деді, Роттенмайер.
Dialogue: 0,0:05:37.16,0:05:40.70,Default,,0,0,0,,Бұл Ротбарт. Сарайдың ішінде не бар?
Dialogue: 0,0:05:41.12,0:05:44.12,Default,,0,0,0,,Өйткені, сіз қарапайым күнге қарағанда 70 есе ғашық боласыз.
Dialogue: 0,0:05:44.50,0:05:45.54,Default,,0,0,0,,Сақ болыңыз
Dialogue: 0,0:05:45.75,0:05:46.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:46.54,0:05:47.70,Default,,0,0,0,,Мүмкін емес ойын
Dialogue: 0,0:05:47.75,0:05:51.25,Default,,0,0,0,,Бұл қорқынышты, жүрегіңді отқа салып, махаббатқа тыйым салады.
Dialogue: 0,0:05:51.79,0:05:55.20,Default,,0,0,0,,«Жоқ» деп айтуға еліктіреді, махаббат.
Dialogue: 0,0:05:55.45,0:05:56.75,Default,,0,0,0,,Император академиясының шәкіртақымен оқитын студентіне айналдыруым керек.
Dialogue: 0,0:05:57.08,0:05:59.83,Default,,0,0,0,,-Ахаха жарайды мен ғашықпын -Біраздан бері ойланып жүрмін.
Dialogue: 0,0:05:59.87,0:06:01.25,Default,,0,0,0,,-Ол қандай адамдар? -Шынымен бе?
Dialogue: 0,0:06:01.41,0:06:03.29,Default,,0,0,0,,-Мектебімдегі Моцу фанаты -Келіңіздер
Dialogue: 0,0:06:03.41,0:06:05.54,Default,,0,0,0,,-Рұқсатсыз қонаққа келген сияқтысың -Жүр, Охо.
Dialogue: 0,0:06:05.87,0:06:08.16,Default,,0,0,0,,- Менің сарайыма шлюхтер кіргізбе - хахаха
Dialogue: 0,0:06:08.33,0:06:09.75,Default,,0,0,0,,-Ол кімдікі? -Иә, иә.
Dialogue: 0,0:06:10.04,0:06:11.29,Default,,0,0,0,,Құрметті Моту
Dialogue: 0,0:06:11.37,0:06:12.95,Default,,0,0,0,,Біз сүйеміз бе?
Dialogue: 0,0:06:13.16,0:06:14.58,Default,,0,0,0,,Қазір
Dialogue: 0,0:06:15.20,0:06:18.83,Default,,0,0,0,,Жақсы, сүйкімді, жақсы қыздар маған ұнамайды
Dialogue: 0,0:06:23.16,0:06:23.66,Default,,0,0,0,,По
Dialogue: 0,0:06:24.20,0:06:26.91,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:06:28.83,0:06:30.16,Default,,0,0,0,,-Хахаха? -Уфуфу иә?
Dialogue: 0,0:06:30.20,0:06:31.87,Default,,0,0,0,,-Гуееее -А, аа, аа
Dialogue: 0,0:06:31.91,0:06:33.16,Default,,0,0,0,,-Уаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа аааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа аааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа аааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа ол туралы
Dialogue: 0,0:06:33.37,0:06:34.33,Default,,0,0,0,,Бұл Жолиненің брошы
Dialogue: 0,0:06:34.45,0:06:38.16,Default,,0,0,0,,Кяаааааааааааааааааааа
Dialogue: 0,0:06:40.37,0:06:42.95,Default,,0,0,0,,Гах, біз жұппыз.
Dialogue: 0,0:06:43.20,0:06:45.25,Default,,0,0,0,,Өйткені ол 1-ден 3-ке дейін болды.
Dialogue: 0,0:06:45.33,0:06:46.95,Default,,0,0,0,,Махаббаттың түрі көп.
Dialogue: 0,0:06:47.62,0:06:51.75,Default,,0,0,0,,Ерлі-зайыптылар құрылса, оларды қарғыс атқан қара аққу жейді.
Dialogue: 0,0:06:52.00,0:06:52.91,Default,,0,0,0,,Бұл қара емес
Dialogue: 0,0:06:53.58,0:06:55.00,Default,,0,0,0,,Бұл қожа болды ма?
Dialogue: 0,0:06:55.20,0:06:56.29,Default,,0,0,0,,Хусси, солай ма?
Dialogue: 0,0:06:56.87,0:06:59.25,Default,,0,0,0,,Жалмауыздықтан құстарға жем болу
Dialogue: 0,0:07:00.08,0:07:01.54,Default,,0,0,0,,Бұл Қасқырдың әдеттегі аяқталуы болды.
Dialogue: 0,0:07:02.04,0:07:08.70,Default,,0,0,0,,Бұл музыканың құдіреті. Бұл сарай - махаббат пен өлімнің музыкасы.
Dialogue: 0,0:07:08.83,0:07:12.66,Default,,0,0,0,,«Аққу көлінің» қарғысы
Dialogue: 0,0:07:14.58,0:07:15.62,Default,,0,0,0,,Махаббат пен өлім?
Dialogue: 0,0:07:16.00,0:07:17.12,Default,,0,0,0,,Музыка
Dialogue: 0,0:07:17.33,0:07:18.45,Default,,0,0,0,,Осымен
Dialogue: 0,0:07:18.58,0:07:19.04,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:07:19.45,0:07:21.50,Default,,0,0,0,,Сіз осында мәңгілікке қамалып қалдыңыз ба?
Dialogue: 0,0:07:21.87,0:07:24.37,Default,,0,0,0,,Ғашық болып, тырнақтарыма жем боласың ба?
Dialogue: 0,0:07:24.66,0:07:29.70,Default,,0,0,0,,иә иә иә жоқ опциясын таңдаңыз
Dialogue: 0,0:07:30.66,0:07:33.04,Default,,0,0,0,,Қандай қорқынышты музыка!
Dialogue: 0,0:07:33.45,0:07:34.62,Default,,0,0,0,,Мен мұны өзім айтып тұрмын.
Dialogue: 0,0:07:35.04,0:07:38.20,Default,,0,0,0,,-Ка -Ко Коко Ко Осындай кездерде
Dialogue: 0,0:07:38.29,0:07:38.70,Default,,0,0,0,,Хмм?
Dialogue: 0,0:07:39.95,0:07:43.70,Default,,0,0,0,,Иә, бәрі, бұл карри.
Dialogue: 0,0:07:43.75,0:07:46.25,Default,,0,0,0,,Котенка? Сіз бұған қашан дайындалдыңыз?
Dialogue: 0,0:07:46.33,0:07:47.75,Default,,0,0,0,,Маған жақындама
Dialogue: 0,0:07:48.25,0:07:51.91,Default,,0,0,0,,хм/сағ хм/сағ иә
Dialogue: 0,0:07:52.20,0:07:53.62,Default,,0,0,0,,Бәрің жиналдың ба?
Dialogue: 0,0:07:53.87,0:07:57.16,Default,,0,0,0,,-Ха, сен не істеп жатырсың? -На
Dialogue: 0,0:07:57.75,0:07:59.62,Default,,0,0,0,,Ах, оо
Dialogue: 0,0:07:59.66,0:08:04.54,Default,,0,0,0,,Осылай жасасаң, саған бәрі ғашық болады.
Dialogue: 0,0:08:04.66,0:08:05.62,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:06.20,0:08:08.50,Default,,0,0,0,,Асхана қызметшісінің формасы
Dialogue: 0,0:08:08.66,0:08:09.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:09.16,0:08:11.95,Default,,0,0,0,,Мына күлкіге, мына реакцияға қараңыз.
Dialogue: 0,0:08:12.25,0:08:13.12,Default,,0,0,0,,Ооо
Dialogue: 0,0:08:13.20,0:08:14.33,Default,,0,0,0,,Хмм, тамақ?
Dialogue: 0,0:08:14.95,0:08:18.58,Default,,0,0,0,,Иә? Өйткені бұл әдеттегідей, солай емес пе?
Dialogue: 0,0:08:18.70,0:08:19.79,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:08:20.08,0:08:20.50,Default,,0,0,0,,Тамақтану
Dialogue: 0,0:08:20.54,0:08:20.95,Default,,0,0,0,,Га
Dialogue: 0,0:08:21.16,0:08:21.75,Default,,0,0,0,,Капыпа
Dialogue: 0,0:08:22.16,0:08:22.91,Default,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:08:23.29,0:08:26.00,Default,,0,0,0,,Оян, бұл Мусиктің қарғысы.
Dialogue: 0,0:08:26.16,0:08:27.66,Default,,0,0,0,,Махаббат пен өлімге шақыру
Dialogue: 0,0:08:27.75,0:08:29.04,Default,,0,0,0,,-Тағам жақсы -Олай асырма
Dialogue: 0,0:08:29.29,0:08:31.54,Default,,0,0,0,,- Асыра бермеңіз, сізді мінгізбеңіз - Тамақ, Тамақ, Тамақ
Dialogue: 0,0:08:31.75,0:08:34.12,Default,,0,0,0,,- Мусиктің қарғысына түспе - Тамақтану
Dialogue: 0,0:08:34.33,0:08:39.58,Default,,0,0,0,,Оған көмектесу мүмкін емес. Иә, мұнда қараңыз.
Dialogue: 0,0:08:39.79,0:08:42.04,Default,,0,0,0,,Котенкаға ғашық болғың келсе, маған ғашық бол.
Dialogue: 0,0:08:42.37,0:08:44.75,Default,,0,0,0,,Лист мырза, мені қорғауға тырысады
Dialogue: 0,0:08:45.08,0:08:47.00,Default,,0,0,0,,А, жоқ, сен маған ғашық бола алмайсың.
Dialogue: 0,0:08:47.29,0:08:48.20,Default,,0,0,0,,Жарайды
Dialogue: 0,0:08:48.95,0:08:52.66,Default,,0,0,0,,Енді маған қарашы хаха
Dialogue: 0,0:08:53.00,0:08:54.75,Default,,0,0,0,,...
Dialogue: 0,0:08:54.79,0:08:57.87,Default,,0,0,0,,-Балалар сендерге ұқсайды екен, иә? -Гггггггг ккккккккккккккккккккккккккккккккккккккккккк gggggggggggggggggggggggggggggggggggggggggggggggggggggggggggthssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssins
Dialogue: 0,0:08:59.45,0:08:59.87,Default,,0,0,0,,Ах
Dialogue: 0,0:09:00.16,0:09:03.08,Default,,0,0,0,,- -
Dialogue: 0,0:09:03.62,0:09:06.25,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:09:06.75,0:09:09.95,Default,,0,0,0,,Жарайды, эстетикаға көзің жетеді.
Dialogue: 0,0:09:10.95,0:09:11.66,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:09:14.04,0:09:14.45,Default,,0,0,0,,По
Dialogue: 0,0:09:14.58,0:09:15.16,Default,,0,0,0,,Айналыс
Dialogue: 0,0:09:15.20,0:09:19.16,Default,,0,0,0,,-Уаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:09:19.37,0:09:20.25,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:09:20.83,0:09:25.25,Default,,0,0,0,,Қарғыс атсын, сондықтан айттым, енді жұп болып кеттік.
Dialogue: 0,0:09:25.62,0:09:27.33,Default,,0,0,0,,Біз бір-бірімізге қарағандықтан ба?
Dialogue: 0,0:09:27.45,0:09:29.58,Default,,0,0,0,,Аз ғана хабардарлық
Dialogue: 0,0:09:30.16,0:09:32.50,Default,,0,0,0,,Жас либидоның көрінісі трагедияға айналады
Dialogue: 0,0:09:32.70,0:09:35.16,Default,,0,0,0,,Әй, қауіпті сезімде күнә жоқ.
Dialogue: 0,0:09:35.50,0:09:37.54,Default,,0,0,0,,Беттерім тайып кетпей қызарып кетті, бірақ
Dialogue: 0,0:09:37.83,0:09:42.12,Default,,0,0,0,,Бұл уақытша бастама ғана. Нағыз жалынды жалған ойындарда табу мүмкін емес.
Dialogue: 0,0:09:42.50,0:09:43.95,Default,,0,0,0,,Бұл Чайко-чанның кінәсі.
Dialogue: 0,0:09:44.25,0:09:45.79,Default,,0,0,0,,Жаман жұмыс істемесем де
Dialogue: 0,0:09:45.87,0:09:47.75,Default,,0,0,0,,Қажетсіз музыкамен қиындық туғызу
Dialogue: 0,0:09:47.91,0:09:48.66,Default,,0,0,0,,Құт
Dialogue: 0,0:09:49.12,0:09:52.00,Default,,0,0,0,,Сол адамның Чайко-чанның қажеті жоқ деген сезімі
Dialogue: 0,0:09:52.70,0:09:54.00,Default,,0,0,0,,Сіз жақсырақ түсінуіңіз мүмкін.
Dialogue: 0,0:09:54.50,0:09:58.00,Default,,0,0,0,,...
Dialogue: 0,0:09:58.04,0:10:02.08,Default,,0,0,0,,-Хмм, Хусси өз олжасына қанағаттануы керек.
Dialogue: 0,0:10:02.45,0:10:02.91,Default,,0,0,0,,Хмм
Dialogue: 0,0:10:03.33,0:10:05.95,Default,,0,0,0,,Ах, Чочан, мен қазір осы жерден кетсем.
Dialogue: 0,0:10:06.12,0:10:08.50,Default,,0,0,0,,Бармасаңыз, барлық заттар жоғалады.
Dialogue: 0,0:10:09.54,0:10:10.79,Default,,0,0,0,,Мүмкін ойын шығар?
Dialogue: 0,0:10:10.91,0:10:12.54,Default,,0,0,0,,Ойын өмірден маңызды ма?
Dialogue: 0,0:10:13.00,0:10:13.62,Default,,0,0,0,,Өте үлкен
Dialogue: 0,0:10:13.66,0:10:16.62,Default,,0,0,0,,- Дәліз қауіпті. Біз оны дереу қайтаруымыз керек. -Аа, не?
Dialogue: 0,0:10:16.66,0:10:20.62,Default,,0,0,0,,Уф, Чайко-чан, неге мен?
Dialogue: 0,0:10:20.95,0:10:29.08,Default,,0,0,0,,Мектеп пе? Бұл да Мусиктің күші ме?
Dialogue: 0,0:10:29.37,0:10:33.20,Default,,0,0,0,,Келесі жарыс екі адамдық штатив.
Dialogue: 0,0:10:33.50,0:10:39.08,Default,,0,0,0,,Екі адамға арналған штатив? Не? иә? неге
Dialogue: 0,0:10:39.33,0:10:41.29,Default,,0,0,0,,Бейтаныс қорқынышты
Dialogue: 0,0:10:41.45,0:10:42.66,Default,,0,0,0,,Бір нәрсе мені ашуландырады.
Dialogue: 0,0:10:43.41,0:10:46.25,Default,,0,0,0,,Орын туралы Жарайды
Dialogue: 0,0:10:46.91,0:10:47.75,Default,,0,0,0,,Пан
Dialogue: 0,0:10:47.87,0:10:48.75,Default,,0,0,0,,Queeee
Dialogue: 0,0:10:48.79,0:10:53.12,Default,,0,0,0,,-Еееееееееееееееееееееееееееееееееееееееееееееееееееееее
Dialogue: 0,0:10:53.75,0:10:54.25,Default,,0,0,0,,Уф
Dialogue: 0,0:10:54.33,0:10:55.08,Default,,0,0,0,,немесе
Dialogue: 0,0:10:55.41,0:10:55.79,Default,,0,0,0,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:10:56.20,0:10:58.58,Default,,0,0,0,,-Бұл кісі не үшін келе жатыр екен. -Уф.
Dialogue: 0,0:10:58.62,0:10:59.58,Default,,0,0,0,,Мен жай ғана құладым.
Dialogue: 0,0:10:59.70,0:11:01.33,Default,,0,0,0,,Маған қарама, мен ғашықпын
Dialogue: 0,0:11:01.45,0:11:05.00,Default,,0,0,0,,Дұрыс, мен сен туралы айтып отырмын.
Dialogue: 0,0:11:05.25,0:11:08.41,Default,,0,0,0,,- Бұл романтикалық комедия ма? Егер сіз осындай нәрсеге ғашық боламын деп ойласаңыз - Queue Queue
Dialogue: 0,0:11:08.45,0:11:12.00,Default,,0,0,0,,Бұл үлкен қателік, иә?
Dialogue: 0,0:11:12.62,0:11:13.29,Default,,0,0,0,,Күн
Dialogue: 0,0:11:13.83,0:11:17.87,Default,,0,0,0,,А-а, жаңбырда
Dialogue: 0,0:11:18.75,0:11:22.66,Default,,0,0,0,,Күшік Уау, қандай ұят
Dialogue: 0,0:11:24.62,0:11:26.33,Default,,0,0,0,,Кун Кун Кун Кун Кун
Dialogue: 0,0:11:27.00,0:11:28.20,Default,,0,0,0,,Аха хаха
Dialogue: 0,0:11:28.45,0:11:29.08,Default,,0,0,0,,Тоқта
Dialogue: 0,0:11:29.25,0:11:29.54,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:11:30.16,0:11:32.83,Default,,0,0,0,,Менің күшікті құтқарғанымды көруді доғар.
Dialogue: 0,0:11:32.95,0:11:35.91,Default,,0,0,0,,Мен саған міндетті түрде ғашық боламын. Мен саған ғашық боламын.
Dialogue: 0,0:11:36.45,0:11:37.54,Default,,0,0,0,,О, бірақ
Dialogue: 0,0:11:38.20,0:11:38.70,Default,,0,0,0,,Эй
Dialogue: 0,0:11:38.87,0:11:41.75,Default,,0,0,0,,Ах Шу
Dialogue: 0,0:11:45.66,0:11:47.91,Default,,0,0,0,,Әй, сен неге мені жалғыз қалдырасың?
Dialogue: 0,0:11:48.37,0:11:50.12,Default,,0,0,0,,Ылғалды, иә?
Dialogue: 0,0:11:50.54,0:11:53.33,Default,,0,0,0,,-Мынау жабайы түрі кішкентай жануарларға мейірімді -Байғұс, дымқыл болып кетеді.
Dialogue: 0,0:11:53.58,0:11:56.45,Default,,0,0,0,,-Гап Мое Бірақ бұл адам неге сонша толқып кетті? - Қиындыққа тап болғандарға көмектес.
Dialogue: 0,0:11:56.50,0:11:57.25,Default,,0,0,0,,Адамның ережелері
Dialogue: 0,0:11:57.45,0:11:57.75,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:11:58.16,0:11:59.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:59.41,0:12:01.12,Default,,0,0,0,,Хехе, жарайды.
Dialogue: 0,0:12:01.45,0:12:03.45,Default,,0,0,0,,Янки күлген «Хехе».
Dialogue: 0,0:12:03.54,0:12:05.79,Default,,0,0,0,,Қыздың жүрегін ұстауға келдім.
Dialogue: 0,0:12:05.87,0:12:07.91,Default,,0,0,0,,Мусик сізді тым көп басқарып жатыр.
Dialogue: 0,0:12:09.29,0:12:12.95,Default,,0,0,0,,Енді сіздің ойын бөлмеңізге жүгірейік.
Dialogue: 0,0:12:13.54,0:12:13.95,Default,,0,0,0,,Иә
Dialogue: 0,0:12:14.04,0:12:14.41,Default,,0,0,0,,О
Dialogue: 0,0:12:15.87,0:12:16.75,Default,,0,0,0,,-ға барайық
Dialogue: 0,0:12:20.04,0:12:20.54,Default,,0,0,0,,По
Dialogue: 0,0:12:21.54,0:12:24.04,Default,,0,0,0,,-Ерлі-зайыптылар орнатылды хаха -Куееее
Dialogue: 0,0:12:24.41,0:12:28.41,Default,,0,0,0,,Вааааааааааааааааааааааааа
Dialogue: 0,0:12:28.45,0:12:30.50,Default,,0,0,0,,Бұл қауіпті болды.
Dialogue: 0,0:12:30.87,0:12:31.29,Default,,0,0,0,,Цк
Dialogue: 0,0:12:35.16,0:12:39.12,Default,,0,0,0,,Жуғыш зат Жуғыш зат Сіз не істеп жатырсыз?
Dialogue: 0,0:12:39.37,0:12:43.12,Default,,0,0,0,,Тар бөлме кешкі тыныштық сияқты жанды тыныштандырады.
Dialogue: 0,0:12:43.41,0:12:46.50,Default,,0,0,0,,Тек таяз мағынаға ие болмыс пен жоқтық.
Dialogue: 0,0:12:46.66,0:12:48.95,Default,,0,0,0,,Өйткені бұл көздер мен құлақтарды тыңдаудың қажеті жоқ.
Dialogue: 0,0:12:49.20,0:12:51.54,Default,,0,0,0,,Бұл бөлме, дәлірек айтсақ, шкаф.
Dialogue: 0,0:12:51.83,0:12:52.45,Default,,0,0,0,,Аххххххххх
Dialogue: 0,0:12:52.91,0:12:53.91,Default,,0,0,0,,Сол жылумен де
Dialogue: 0,0:12:54.12,0:12:54.87,Default,,0,0,0,,Жолтайым Құдай
Dialogue: 0,0:12:58.00,0:12:58.83,Default,,0,0,0,,Бето мырза?
Dialogue: 0,0:13:06.25,0:13:07.29,Default,,0,0,0,,Ааа
Dialogue: 0,0:13:14.00,0:13:15.62,Default,,0,0,0,,Гауееееееееееееееееееееееееееееееееееееее
Dialogue: 0,0:13:15.70,0:13:19.91,Default,,0,0,0,,-Ииииииииииииииииииииииииииииииииииииииииииииииии iiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiii)
Dialogue: 0,0:13:22.66,0:13:27.62,Default,,0,0,0,,Ха, қожалар, сен мені мүлде ұмытып кеткен сияқтысың.
Dialogue: 0,0:13:28.25,0:13:30.75,Default,,0,0,0,,Менің қолымнан келмейді, барлығына Мусик кінәлі.
Dialogue: 0,0:13:31.08,0:13:32.83,Default,,0,0,0,,Иә, бұл Чайко-чанның кінәсі.
Dialogue: 0,0:13:33.04,0:13:35.58,Default,,0,0,0,,Неліктен олай істедің?
Dialogue: 0,0:13:35.62,0:13:36.62,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:13:36.87,0:13:38.75,Default,,0,0,0,,-  -
Dialogue: 0,0:13:38.87,0:13:41.83,Default,,0,0,0,,-Мусикке байланысты болса да тым өрескел деп ойлаймын. -Бұл рас.
Dialogue: 0,0:13:42.16,0:13:45.08,Default,,0,0,0,,-Жұптар тым танымал -Бұл рас.
Dialogue: 0,0:13:45.16,0:13:48.50,Default,,0,0,0,,-Бірдеңе дұрыс емес. А, түсіндім. - Бұл өте қатты.
Dialogue: 0,0:13:48.58,0:13:49.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:49.66,0:13:52.04,Default,,0,0,0,,Уақыт аяқталуға жақын, Хусси.
Dialogue: 0,0:13:52.08,0:13:54.29,Default,,0,0,0,,Мен түнде ұйықтап кететіндіктен мазасызданамын.
Dialogue: 0,0:13:54.66,0:13:57.16,Default,,0,0,0,,Күн батқанша үшеуміз бар күшімізді салсақ
Dialogue: 0,0:13:57.29,0:13:58.58,Default,,0,0,0,,Мен сенің бұл жерден кете алатыныңа сенімдімін.
Dialogue: 0,0:13:59.58,0:14:02.29,Default,,0,0,0,,Түсіндім, бізде уақыт таусылып жатыр.
Dialogue: 0,0:14:02.87,0:14:05.33,Default,,0,0,0,,Біз аман қаламыз, Чайко-чан.
Dialogue: 0,0:14:06.58,0:14:07.66,Default,,0,0,0,,Оның артында қандай себеп тұрса да,
Dialogue: 0,0:14:08.41,0:14:11.75,Default,,0,0,0,,-Уаааааааааааааааааааааааааа
Dialogue: 0,0:14:11.79,0:14:13.45,Default,,0,0,0,,Ақырғы өмір дегеніміз не?
Dialogue: 0,0:14:23.04,0:14:25.62,Default,,0,0,0,,Эй, сен балет көріп тұрсың ба?
Dialogue: 0,0:14:25.95,0:14:29.58,Default,,0,0,0,,Бұл «Аққу көлі» Ханзада көлде
Dialogue: 0,0:14:29.70,0:14:32.95,Default,,0,0,0,,Ол аққуға айналған Одетта есімді қызды кездестірді.
Dialogue: 0,0:14:33.12,0:14:36.79,Default,,0,0,0,,Мен махаббатыма ант бердім, бірақ содан кейін
Dialogue: 0,0:14:36.83,0:14:40.00,Default,,0,0,0,,Шайтан Ротбартқа алданып, жалған Одеттаға үйленді.
Dialogue: 0,0:14:40.45,0:14:42.79,Default,,0,0,0,,Бұзылған ант, Одетта ажалды таңдайды.
Dialogue: 0,0:14:43.29,0:14:47.45,Default,,0,0,0,,«Аққу көлі» осындай трагедия.
Dialogue: 0,0:14:47.66,0:14:51.45,Default,,0,0,0,,Қарғыс ханзаданың махаббатымен бұзылған бақытты аяқталатын нұсқасы да бар.
Dialogue: 0,0:14:51.75,0:14:54.87,Default,,0,0,0,,- Бұл жақсы әңгіме. «Аққу көлі» - Ууууууууууууууууууу
Dialogue: 0,0:14:55.16,0:14:56.87,Default,,0,0,0,,-Жақсы, Одетта -Уау
Dialogue: 0,0:14:57.45,0:15:00.16,Default,,0,0,0,,«Аққу көлі» бақытты аяқталса
Dialogue: 0,0:15:01.08,0:15:03.87,Default,,0,0,0,,Мүмкін бұл махаббат пен өлім емес шығар
Dialogue: 0,0:15:04.12,0:15:06.29,Default,,0,0,0,,Бұл махаббат пен қайта туылу әуені ме?
Dialogue: 0,0:15:06.58,0:15:09.00,Default,,0,0,0,,Иә, егер біреумен жұп болып кетсеңіз.
Dialogue: 0,0:15:09.29,0:15:11.04,Default,,0,0,0,,Өлу орнына көтеріліп жатқан жоқ па?
Dialogue: 0,0:15:11.20,0:15:12.66,Default,,0,0,0,,Біз тіріміз, солай емес пе?
Dialogue: 0,0:15:13.00,0:15:15.62,Default,,0,0,0,,Бұл не? Мұнда барлық заттар жоғалады.
Dialogue: 0,0:15:15.70,0:15:18.58,Default,,0,0,0,,Бір минут күте тұрыңыз, біз жұп болған соң
Dialogue: 0,0:15:18.66,0:15:20.45,Default,,0,0,0,,Шыға алсаң, бітті.
Dialogue: 0,0:15:21.25,0:15:22.75,Default,,0,0,0,,Бадакюнды кім құтқара алады?
Dialogue: 0,0:15:22.79,0:15:24.33,Default,,0,0,0,,Бұл менің жалғыз екенімді білдірмейді ме?
Dialogue: 0,0:15:24.79,0:15:26.37,Default,,0,0,0,,Жоқ, тіпті бұл флоп болмаса да.
Dialogue: 0,0:15:26.45,0:15:29.45,Default,,0,0,0,,Бадакюун кеттік
Dialogue: 0,0:15:30.08,0:15:33.00,Default,,0,0,0,,Сіз не үшін барасыз?
Dialogue: 0,0:15:33.25,0:15:36.41,Default,,0,0,0,,Егер бұл шынымен де махаббат пен қайта туылу әуені болса
Dialogue: 0,0:15:37.20,0:15:38.58,Default,,0,0,0,,Чайконың сезімі
Dialogue: 0,0:15:40.20,0:15:47.12,Default,,0,0,0,,Ха ха ха ха ха ха
Dialogue: 0,0:15:47.29,0:15:49.08,Default,,0,0,0,,Гааа
Dialogue: 0,0:15:49.29,0:15:50.16,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:15:50.45,0:15:52.08,Default,,0,0,0,,Бір ғана ән болса да жақсы
Dialogue: 0,0:15:52.16,0:15:53.54,Default,,0,0,0,,-Мен жасаған басқа да заттар -А
Dialogue: 0,0:15:53.58,0:15:54.91,Default,,0,0,0,,-Бұл дауысты ешкім білмейді.
Dialogue: 0,0:15:54.95,0:15:55.95,Default,,0,0,0,,Сіз білмейтін ештеңе жоқ
Dialogue: 0,0:15:56.00,0:15:58.62,Default,,0,0,0,,Сосуке Сіз аспалы көпір әсері туралы білесіз бе?
Dialogue: 0,0:15:58.83,0:16:00.91,Default,,0,0,0,,Мен білмеймін. Не деген кенеттен?
Dialogue: 0,0:16:01.29,0:16:04.45,Default,,0,0,0,,Екеуміз өтіп бара жатқан аспалы көпір дірілдеп, дірілдегенде.
Dialogue: 0,0:16:04.87,0:16:07.50,Default,,0,0,0,,Адамдар кейде оны махаббатпен шатастыратын сияқты.
Dialogue: 0,0:16:07.66,0:16:09.33,Default,,0,0,0,,Олардың жұп болуы мүмкін бе?
Dialogue: 0,0:16:09.45,0:16:14.79,Default,,0,0,0,,Шынайы ма? Ууууууууууууууууууууууууу
Dialogue: 0,0:16:15.37,0:16:18.04,Default,,0,0,0,,Бада-чан, Чайко-чан, тоқташы.
Dialogue: 0,0:16:18.33,0:16:19.00,Default,,0,0,0,,Чайко-чан
Dialogue: 0,0:16:19.04,0:16:21.33,Default,,0,0,0,,Сіз мені басынан-ақ жоюды мақсат еткен едіңіз.
Dialogue: 0,0:16:21.54,0:16:24.75,Default,,0,0,0,,Білесіз бе, егер сіз көздеп, Мусикті алсаңыз, сізге қиындық болмайды.
Dialogue: 0,0:16:24.95,0:16:25.79,Default,,0,0,0,,- Уф - мен ашуландым.
Dialogue: 0,0:16:26.25,0:16:27.50,Default,,0,0,0,,-Чайко-чан болса болды -Фунунну
Dialogue: 0,0:16:27.58,0:16:29.16,Default,,0,0,0,,-Funi Nii жеке альбомын шығарса да
Dialogue: 0,0:16:29.25,0:16:30.04,Default,,0,0,0,,Жалғыз болсаңыз
Dialogue: 0,0:16:30.08,0:16:32.29,Default,,0,0,0,,Бах сізді тастап кеткенін қалайсыз ба?
Dialogue: 0,0:16:32.45,0:16:33.54,Default,,0,0,0,,Гваааааа
Dialogue: 0,0:16:33.58,0:16:34.87,Default,,0,0,0,,Иә, бұл қауіпті.
Dialogue: 0,0:16:35.00,0:16:36.08,Default,,0,0,0,,Гооееееееееееееееееееееееее
Dialogue: 0,0:16:36.20,0:16:36.70,Default,,0,0,0,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:16:36.79,0:16:37.79,Default,,0,0,0,,Әлі жоқ
Dialogue: 0,0:16:37.95,0:16:39.41,Default,,0,0,0,,Әлі біткен жоқ.
Dialogue: 0,0:16:39.45,0:16:41.75,Default,,0,0,0,,Queggwaaaa
Dialogue: 0,0:16:42.37,0:16:43.70,Default,,0,0,0,,Ал, қайтадан бастайық.
Dialogue: 0,0:16:43.75,0:16:45.16,Default,,0,0,0,,Қалауыңызша.
Dialogue: 0,0:16:45.66,0:16:48.37,Default,,0,0,0,,Жақсы, ха!
Dialogue: 0,0:16:48.66,0:16:51.25,Default,,0,0,0,,Бұл өте қызықты
Dialogue: 0,0:16:51.33,0:16:52.20,Default,,0,0,0,,- Сосуке? -Хааааааааааааааааааааааааа
Dialogue: 0,0:16:52.41,0:16:56.08,Default,,0,0,0,,-Бада-чан Фу Бада-чан, мен саған көмектесуге келдім -Ууууууу
Dialogue: 0,0:16:56.20,0:16:57.33,Default,,0,0,0,,Сондықтан біз екеуміз жұппыз
Dialogue: 0,0:16:57.37,0:16:57.87,Default,,0,0,0,,-Мазасыздық -Ах
Dialogue: 0,0:16:57.95,0:17:01.70,Default,,0,0,0,,А-а-а-а-а-а-а, сәу-сәу-ух?
Dialogue: 0,0:17:01.79,0:17:03.79,Default,,0,0,0,,-Геееееееееееееееееееееееееееееееееееееееееееееее
Dialogue: 0,0:17:03.87,0:17:04.62,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:17:05.00,0:17:05.83,Default,,0,0,0,,Иә
Dialogue: 0,0:17:06.00,0:17:06.95,Default,,0,0,0,,Торияааа
Dialogue: 0,0:17:07.16,0:17:08.29,Default,,0,0,0,,Әпке
Dialogue: 0,0:17:08.41,0:17:10.00,Default,,0,0,0,,-Чочочохочочокочо -Гяааа
Dialogue: 0,0:17:10.91,0:17:14.12,Default,,0,0,0,,Хаа ха ха
Dialogue: 0,0:17:14.62,0:17:16.75,Default,,0,0,0,,Құстың шабуылына лайық па?
Dialogue: 0,0:17:17.20,0:17:20.50,Default,,0,0,0,,-Мен сені өз қолыммен алқаптың түбіне апарамын -Хаа ха ха
Dialogue: 0,0:17:20.79,0:17:22.91,Default,,0,0,0,,-Қолыңнан келсе істе -ха ха ха ха
Dialogue: 0,0:17:23.20,0:17:23.70,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:17:23.95,0:17:24.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:24.75,0:17:27.41,Default,,0,0,0,,Ерлі-зайыптылар болсақ, бұл жерден шыға аламыз.
Dialogue: 0,0:17:27.95,0:17:29.66,Default,,0,0,0,,Сонымен мен және мен
Dialogue: 0,0:17:30.20,0:17:32.95,Default,,0,0,0,,Е, жұп болып кетсең өлмес пе едің?
Dialogue: 0,0:17:33.16,0:17:35.29,Default,,0,0,0,,Жоқ, болды.
Dialogue: 0,0:17:35.79,0:17:37.95,Default,,0,0,0,,Бұл махаббат пен қайта туылу әуені
Dialogue: 0,0:17:38.62,0:17:40.62,Default,,0,0,0,,Махаббат және қайта туылу туралы?
Dialogue: 0,0:17:40.95,0:17:43.75,Default,,0,0,0,,Уф, жоқ, білмеймін.
Dialogue: 0,0:17:43.91,0:17:47.37,Default,,0,0,0,,Рас, қалғандары сыртта көңілді күтіп отыр.
Dialogue: 0,0:17:48.45,0:17:50.79,Default,,0,0,0,,Куракураны қалпына келтіру мүмкін бе?
Dialogue: 0,0:17:51.54,0:17:53.70,Default,,0,0,0,,Чайко-чан шынымен солай ойлай ма?
Dialogue: 0,0:17:54.33,0:17:57.20,Default,,0,0,0,,Бұл қатені жасамаңыз.
Dialogue: 0,0:18:00.16,0:18:03.62,Default,,0,0,0,,Олай болса, байыпты болыңыз.
Dialogue: 0,0:18:03.70,0:18:04.62,Default,,0,0,0,,Кел мені жей бер
Dialogue: 0,0:18:04.95,0:18:05.41,Default,,0,0,0,,болып табылады
Dialogue: 0,0:18:05.70,0:18:07.16,Default,,0,0,0,,Мен музыканы шығарғаннан кейін
Dialogue: 0,0:18:07.50,0:18:08.95,Default,,0,0,0,,Чайко-чан әрқашан біртүрлі
Dialogue: 0,0:18:09.50,0:18:10.12,Default,,0,0,0,,Орага?
Dialogue: 0,0:18:11.25,0:18:14.08,Default,,0,0,0,,Мен аздап дұшпан болып кеткен шығармын.
Dialogue: 0,0:18:14.75,0:18:17.54,Default,,0,0,0,,Бұл Чайко-чан сияқты.
Dialogue: 0,0:18:17.58,0:18:18.45,Default,,0,0,0,,Себебі мен бақытты болдым
Dialogue: 0,0:18:19.12,0:18:24.08,Default,,0,0,0,,Не? Менен төменмін деп ойладың ба?
Dialogue: 0,0:18:24.87,0:18:28.54,Default,,0,0,0,,Бірақ қазір бәрі басқаша. Біз бірге көтеріле аламыз.
Dialogue: 0,0:18:29.66,0:18:33.20,Default,,0,0,0,,Өйткені маған лайық жалғыз Чайко-чан.
Dialogue: 0,0:18:33.87,0:18:35.87,Default,,0,0,0,,Оның да солай ойлайтынына сенімдімін.
Dialogue: 0,0:18:36.70,0:18:39.50,Default,,0,0,0,,Бадажеффтер
Dialogue: 0,0:18:40.91,0:18:43.16,Default,,0,0,0,,Декааааааааааааааааааа
Dialogue: 0,0:18:43.91,0:18:49.58,Default,,0,0,0,,Иә хааааааааааааааааааааааааааааааа
Dialogue: 0,0:18:54.70,0:18:56.87,Default,,0,0,0,,Маған сай келетін кім?
Dialogue: 0,0:18:57.58,0:18:58.37,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:18:59.16,0:19:01.25,Default,,0,0,0,,Мені тастап кете алмайсың ба?
Dialogue: 0,0:19:02.08,0:19:04.54,Default,,0,0,0,,Егер байсалды болсаң, мені тастама.
Dialogue: 0,0:19:05.41,0:19:05.95,Default,,0,0,0,,По
Dialogue: 0,0:19:09.00,0:19:11.16,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:19:11.87,0:19:14.54,Default,,0,0,0,,Біраз күтіңіз, Бада-кюн менімен жұп.
Dialogue: 0,0:19:14.58,0:19:15.25,Default,,0,0,0,,- жүр - жүр
Dialogue: 0,0:19:15.95,0:19:21.33,Default,,0,0,0,,Ах ааа аа
Dialogue: 0,0:19:22.25,0:19:24.08,Default,,0,0,0,,Жұп орнатылды
Dialogue: 0,0:19:24.33,0:19:24.66,Default,,0,0,0,,Иә
Dialogue: 0,0:19:30.20,0:19:35.16,Default,,0,0,0,,Мен ғана қалдым.
Dialogue: 0,0:19:35.37,0:19:39.50,Default,,0,0,0,,Уаааааааааааааааааааааааа
Dialogue: 0,0:19:39.75,0:19:43.95,Default,,0,0,0,,Сіз бәс тігесіз бе?
Dialogue: 0,0:19:45.20,0:19:47.91,Default,,0,0,0,,Қарғыс атсын, бұл ұзаққа бармайды.
Dialogue: 0,0:19:48.25,0:19:51.37,Default,,0,0,0,,Иә, мен айттым.
Dialogue: 0,0:19:52.00,0:19:54.25,Default,,0,0,0,,Бұл махаббат пен қайта туылу әуені
Dialogue: 0,0:19:54.79,0:19:58.83,Default,,0,0,0,,Иә, жұп болып қалсақ, бұл жерден шыға аламыз.
Dialogue: 0,0:19:59.00,0:19:59.70,Default,,0,0,0,,Ах
Dialogue: 0,0:20:00.12,0:20:02.58,Default,,0,0,0,,Ха, не болды?
Dialogue: 0,0:20:03.87,0:20:06.04,Default,,0,0,0,,Бұл жағдай
Dialogue: 0,0:20:06.16,0:20:09.58,Default,,0,0,0,,Жоқ, бұл сіздің қалауыңыз бойынша болатын ұятсыз эмоциялар үшін жақсы емес.
Dialogue: 0,0:20:09.75,0:20:11.20,Default,,0,0,0,,Назар аударуға тұрарлық емес
Dialogue: 0,0:20:13.00,0:20:15.70,Default,,0,0,0,,Бүгінгі Бето сенімді.
Dialogue: 0,0:20:20.58,0:20:23.75,Default,,0,0,0,,Ауха ааахахахахахахахахахахахахахах
Dialogue: 0,0:20:30.29,0:20:31.25,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:20:31.33,0:20:34.45,Default,,0,0,0,,А-а, бәрі аман.
Dialogue: 0,0:20:35.45,0:20:38.08,Default,,0,0,0,,Чайко Бадамен қол ұстасып үйіне кетті.
Dialogue: 0,0:20:38.70,0:20:40.87,Default,,0,0,0,,Сонымен музыка аяқталды.
Dialogue: 0,0:20:41.20,0:20:45.16,Default,,0,0,0,,Еха вааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:20:45.20,0:20:49.20,Default,,0,0,0,,-Ер мен әйелдің арасында бейберекет құрылған қарым-қатынас ұзаққа созылатын жағдайлар аз. -Ууууууууууууууууууууу
Dialogue: 0,0:20:49.33,0:20:50.41,Default,,0,0,0,,Уф, еркек пен әйел қатынасы ма?
Dialogue: 0,0:20:50.50,0:20:52.12,Default,,0,0,0,,Ах, Утанае жақсы.
Dialogue: 0,0:20:52.50,0:20:55.16,Default,,0,0,0,,Себебі қыздың өткеніне мән бермеймін.
Dialogue: 0,0:20:55.25,0:20:56.83,Default,,0,0,0,,Өткенге ұқсайтын ештеңе жоқ.
Dialogue: 0,0:20:57.00,0:20:59.12,Default,,0,0,0,,Ол қатып қалды.
Dialogue: 0,0:21:00.04,0:21:01.12,Default,,0,0,0,,Мені жіберуіңізді өтінемін
Dialogue: 0,0:21:01.16,0:21:01.54,Default,,0,0,0,,Га
Dialogue: 0,0:21:01.66,0:21:02.75,Default,,0,0,0,,О, дірілдеп
Dialogue: 0,0:21:03.04,0:21:04.33,Default,,0,0,0,,Мен мақұлдамаймын
Dialogue: 0,0:21:04.75,0:21:07.20,Default,,0,0,0,,Ағамен жұпты оңай құру
Dialogue: 0,0:21:07.25,0:21:08.75,Default,,0,0,0,,Белгіленген жоқ
Dialogue: 0,0:21:09.25,0:21:12.41,Default,,0,0,0,,Гаку Ха туралы
Dialogue: 0,0:21:12.83,0:21:13.20,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:21:13.70,0:21:19.29,Default,,0,0,0,,Иә, мұның бәрі музыка туралы болды.
Dialogue: 0,0:21:19.41,0:21:22.83,Default,,0,0,0,,Жалқау сезімдер суретшінің шытырман оқиғасы.
Dialogue: 0,0:21:22.91,0:21:24.75,Default,,0,0,0,,-Жарайды, жарайды, жақсы. -Денеге жасалған тәжірибелер терең.
Dialogue: 0,0:21:24.87,0:21:27.54,Default,,0,0,0,,- Мағына астында орындалады, тың көрініс тудырады - Жоқ, бұл мүлдем жақсы емес, мен оны түсінбеймін.
Dialogue: 0,0:21:27.58,0:21:30.62,Default,,0,0,0,,Сезімтал көзге көрінгенмен бірге жүретін ұят
Dialogue: 0,0:21:30.87,0:21:33.83,Default,,0,0,0,,Ақыл мен жалғыздықтың қиындығы мен қиындығынан асып түсетін масқара.
Dialogue: 0,0:21:33.95,0:21:36.62,Default,,0,0,0,,Бар және
Dialogue: 0,0:21:37.41,0:21:38.37,Default,,0,0,0,,Уау
Dialogue: 0,0:21:38.45,0:21:40.91,Default,,0,0,0,,Бүгінгі күн үшін барлығыңызға рахмет.
Dialogue: 0,0:21:41.08,0:21:44.04,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:21:44.16,0:21:46.45,Default,,0,0,0,,Чайко-чан тұрған позициясы тұру қалпы
Dialogue: 0,0:21:46.75,0:21:47.50,Default,,0,0,0,,Ахаха
Dialogue: 0,0:21:47.62,0:21:51.00,Default,,0,0,0,,Хмм, тым төмен, бетім үлкен көрінеді.
Dialogue: 0,0:21:51.37,0:21:51.87,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:52.08,0:21:55.54,Default,,0,0,0,,А, бұл тым жарық. Жарығымды жауып тастағым келмейді.
Dialogue: 0,0:21:55.70,0:21:56.75,Default,,0,0,0,,Е хехе
Dialogue: 0,0:21:57.25,0:22:00.87,Default,,0,0,0,,Ха, Чайко-чан, сен үйге бара аласың.
Dialogue: 0,0:22:02.58,0:22:06.00,Default,,0,0,0,,Мен бұл көзқарастың не екенін түсінбеймін...
Dialogue: 0,0:22:06.20,0:22:08.75,Default,,0,0,0,,Әй, тарады десем, басымды білдіреді.
Dialogue: 0,0:22:09.37,0:22:12.91,Default,,0,0,0,,Кайса Кайса Мен билет қақпасын тексеремін.
Dialogue: 0,0:22:13.00,0:22:15.54,Default,,0,0,0,,Әй, билет қақпасы Билет қақпасы деген нені білдіреді?
Dialogue: 0,0:22:15.83,0:22:18.20,Default,,0,0,0,,Сіз билет алғыңыз келе ме? Сіз қайшы ұстаған жерде тұрсыз ба?
Dialogue: 0,0:22:18.25,0:22:22.16,Default,,0,0,0,,Олай болса, мен саған жасаймын, мама.
Dialogue: 0,0:22:22.33,0:22:24.45,Default,,0,0,0,,-Ахахахаха - Яй Бадакюн
Dialogue: 0,0:22:24.62,0:22:25.70,Default,,0,0,0,,Чайкодан айырылып қалмаңыз
Dialogue: 0,0:22:25.75,0:22:28.33,Default,,0,0,0,,Анашым, сіз түнде тамақ жасайсыз ба? Маған қолғап тоқып бере аласыз ба?
Dialogue: 0,0:22:28.41,0:22:30.75,Default,,0,0,0,,-Бұл үлкен хит. Мен мұны біраз уақытқа қайталап көремін. -Мен саған теңіз өнімдерін дайындаймын.
Dialogue: 0,0:22:30.83,0:22:33.83,Default,,0,0,0,,-Осы екеуі жалғасатын сияқты. Бах мырза күткендей, мен сізге уақытша лицензия беремін.
Dialogue: 0,0:22:34.20,0:22:35.95,Default,,0,0,0,,Дегенмен, патшаңыздың қазір есінен адасқаны анық.
Dialogue: 0,0:22:36.00,0:22:37.66,Default,,0,0,0,,Келесі мақсатым —
Dialogue: 0,0:22:37.75,0:22:41.41,Default,,0,0,0,,-Уау аа -ахахахахахахах
Dialogue: 0,0:22:41.45,0:22:41.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:43.75,0:22:47.54,Default,,0,0,0,,Хмм?
Dialogue: 0,0:23:09.50,0:23:17.29,Default,,0,0,0,,AH мен сені сол жерде көріп тұрмын
Dialogue: 0,0:23:17.91,0:23:26.37,Default,,0,0,0,,Мені ақырын ұстағанмен
Dialogue: 0,0:23:27.25,0:23:36.87,Default,,0,0,0,,Сенімен уақыт өткізе алмайтын қиын күндер
Dialogue: 0,0:23:37.08,0:23:47.91,Default,,0,0,0,,Мен қанаты бар, бірақ ұша алмайтын аққу сияқтымын.
Dialogue: 0,0:23:48.45,0:23:56.08,Default,,0,0,0,,AH мен сені сол жерден көріп тұрмын
Dialogue: 0,0:23:57.58,0:24:05.25,Default,,0,0,0,,AH мен сені сол жерде көріп тұрмын
Dialogue: 0,0:24:06.75,0:24:10.41,Default,,0,0,0,,AH мен оны көремін, бірақ
Dialogue: 0,0:24:19.87,0:24:22.08,Default,,0,0,0,,Бұл дүниедегі нәрселерге күлу ғана қолыңнан келеді.
Dialogue: 0,0:24:22.50,0:24:25.45,Default,,0,0,0,,Мағынасын сұрама, бәрі бар.
Dialogue: 0,0:24:25.70,0:24:28.75,Default,,0,0,0,,Батар күн сайрап, Бәрі тең.
Dialogue: 0,0:24:29.00,0:24:31.91,Default,,0,0,0,,Кеше де, бүгін де, ертең де.
Dialogue: 0,0:24:33.41,0:24:39.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory