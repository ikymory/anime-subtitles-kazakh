Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.25,0:00:11.50,Default,,0,0,0,,Ой, бұл робот шаңсорғыш.
Dialogue: 0,0:00:11.70,0:00:13.20,Default,,0,0,0,,Құлап бара жатты, солай ма?
Dialogue: 0,0:00:13.29,0:00:14.04,Default,,0,0,0,,Оны не үшін алу керек?
Dialogue: 0,0:00:14.16,0:00:15.87,Default,,0,0,0,,Бұл тазартады ма?
Dialogue: 0,0:00:16.12,0:00:16.91,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:00:17.00,0:00:18.16,Default,,0,0,0,,Қызық, ол қозғала ма?
Dialogue: 0,0:00:18.29,0:00:20.95,Default,,0,0,0,,-Жан жар бола аламын деп ойлаған жігіт -Хи хи хи
Dialogue: 0,0:00:21.04,0:00:22.83,Default,,0,0,0,,Ол жай ғана жеңілтек аға болатын.
Dialogue: 0,0:00:23.16,0:00:26.95,Default,,0,0,0,,Уа, бұл не? Ол толығымен сынған.
Dialogue: 0,0:00:27.00,0:00:30.08,Default,,0,0,0,,-Хахаха Ахахха -Жарайды мен түзетемін.
Dialogue: 0,0:00:30.16,0:00:33.20,Default,,0,0,0,,Менің ойымша, Бето қауіпті робот болар еді.
Dialogue: 0,0:00:33.62,0:00:36.33,Default,,0,0,0,,Эй, мен Чоччанның оны түзете алатынына сенімдімін.
Dialogue: 0,0:00:36.45,0:00:37.79,Default,,0,0,0,,(Каибуки) Егер Эрезерхед қарсылық білдірмесе—
Dialogue: 0,0:00:37.87,0:00:39.58,Default,,0,0,0,,Мен арқа сүйеген досым
Dialogue: 0,0:00:39.66,0:00:42.04,Default,,0,0,0,,Мен жай ғана біртүрлі адамдармен араласамын.
Dialogue: 0,0:00:43.04,0:00:44.12,Default,,0,0,0,,Бұны түзетіңіз
Dialogue: 0,0:00:44.20,0:00:45.91,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймын, бірақ мен сізбен сөйлескім келеді.
Dialogue: 0,0:00:46.00,0:00:47.16,Default,,0,0,0,,Есікті ашыңыз
Dialogue: 0,0:00:47.29,0:00:49.50,Default,,0,0,0,,Бұл жерде лом сияқты бірдеңе бар.
Dialogue: 0,0:00:49.79,0:00:50.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:50.66,0:00:53.87,Default,,0,0,0,,Үйде біртүрлі адамдар көп
Dialogue: 0,0:00:56.20,0:00:57.58,Default,,0,0,0,,Мен жақындағым келмейді
Dialogue: 0,0:00:58.33,0:01:01.79,Default,,0,0,0,,Жөндеу жөндеу жөндеу
Dialogue: 0,0:01:06.33,0:01:07.12,Default,,0,0,0,,Ол түзетілді ме?
Dialogue: 0,0:01:07.83,0:01:08.33,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:01:08.50,0:01:10.00,Default,,0,0,0,,О, күткендей.
Dialogue: 0,0:01:10.29,0:01:11.41,Default,,0,0,0,,Ал, оны жылжытайық.
Dialogue: 0,0:01:15.54,0:01:17.04,Default,,0,0,0,,Ой
Dialogue: 0,0:01:19.04,0:01:21.16,Default,,0,0,0,,Уау, ол қайтадан бұзылды.
Dialogue: 0,0:01:21.33,0:01:22.33,Default,,0,0,0,,-Не істеп жатырсың? -Ой.
Dialogue: 0,0:01:23.08,0:01:26.87,Default,,0,0,0,,Үйіңіз қоқысқа толы не істеп жатырсыз?
Dialogue: 0,0:01:27.45,0:01:30.37,Default,,0,0,0,,Кәне, бәріміз жиналайық.
Dialogue: 0,0:01:30.54,0:01:31.25,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:01:31.33,0:01:34.08,Default,,0,0,0,,Ал менің қорқынышты үй иесі бар.
Dialogue: 0,0:01:39.54,0:01:41.33,Default,,0,0,0,,Ой-ой
Dialogue: 0,0:01:41.41,0:01:44.20,Default,,0,0,0,,жолақ қақпағы қақпағы қақпақ қақпағы қақпақ қақпағы
Dialogue: 0,0:01:44.29,0:01:49.08,Default,,0,0,0,,Пами
Dialogue: 0,0:01:53.95,0:02:00.70,Default,,0,0,0,,Көрнекі дизайн Биіктігі Дене пішіні Терінің түсі
Dialogue: 0,0:02:00.91,0:02:07.79,Default,,0,0,0,,Шаш үлгісінің аты Ах Джоли
Dialogue: 0,0:03:42.04,0:03:44.75,Default,,0,0,0,,Сәлем, мен Джолимін.
Dialogue: 0,0:03:45.20,0:03:45.58,Default,,0,0,0,,Иә
Dialogue: 0,0:03:47.08,0:03:51.79,Default,,0,0,0,,Сәлем Сәлем
Dialogue: 0,0:03:54.50,0:03:56.87,Default,,0,0,0,,Сәлем, мен Джолимін.
Dialogue: 0,0:03:57.75,0:03:58.12,Default,,0,0,0,,Хмм
Dialogue: 0,0:04:00.45,0:04:03.41,Default,,0,0,0,,Сәлеметсіз бе, мен Джолимін, сіз ше?
Dialogue: 0,0:04:03.79,0:04:04.54,Default,,0,0,0,,Шопен
Dialogue: 0,0:04:05.12,0:04:06.37,Default,,0,0,0,,Қандай жақсы есім.
Dialogue: 0,0:04:07.04,0:04:11.29,Default,,0,0,0,,Ах, «Мен ән айтқанды ұнатамын».
Dialogue: 0,0:04:14.29,0:04:17.16,Default,,0,0,0,,Мен соңғы кездері Шопен мырзаны көрмей қалдым.
Dialogue: 0,0:04:17.70,0:04:19.66,Default,,0,0,0,,Дөрекі болмаңыз.
Dialogue: 0,0:04:20.08,0:04:23.33,Default,,0,0,0,,Дәл қазір Чочан тыйым салынған махаббатқа батып жатыр.
Dialogue: 0,0:04:23.58,0:04:25.12,Default,,0,0,0,,Не? Тыйым салынған махаббат?
Dialogue: 0,0:04:25.91,0:04:28.83,Default,,0,0,0,,Мен пошталық тапсырыс пакетін алдым, сондықтан оны өзіммен бірге алып кеттім.
Dialogue: 0,0:04:31.25,0:04:32.16,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:32.58,0:04:33.91,Default,,0,0,0,,Өзіңізді шаршап тұрсыз ба?
Dialogue: 0,0:04:34.29,0:04:35.91,Default,,0,0,0,,Мен көп ұйықтамадым.
Dialogue: 0,0:04:36.20,0:04:38.95,Default,,0,0,0,,Сіз не істеп жатырсыз? Сіз дұрыс тамақтанып жатырсыз ба?
Dialogue: 0,0:04:39.83,0:04:45.08,Default,,0,0,0,,-Аа мен сені жақсы көремін хехехехехехехехе -Аа, а?
Dialogue: 0,0:04:46.45,0:04:47.12,Default,,0,0,0,,Рух
Dialogue: 0,0:04:47.45,0:04:48.66,Default,,0,0,0,,Рух?
Dialogue: 0,0:04:49.04,0:04:51.66,Default,,0,0,0,,Бұл да өте зұлым рух.
Dialogue: 0,0:04:52.12,0:04:55.45,Default,,0,0,0,,Әй, кешірілмес махаббат дірілдейді.
Dialogue: 0,0:04:55.79,0:04:58.95,Default,,0,0,0,,Шынайы ма? Бұл арулар үйі ме?
Dialogue: 0,0:04:59.41,0:05:01.12,Default,,0,0,0,,Жоқ, әрине солай.
Dialogue: 0,0:05:01.20,0:05:02.08,Default,,0,0,0,,- Күтіңіз - Ой?
Dialogue: 0,0:05:02.20,0:05:03.79,Default,,0,0,0,,Біртүрлі өсек таратпа.
Dialogue: 0,0:05:04.25,0:05:06.37,Default,,0,0,0,,Біз әлі де тұрғындарды қабылдаудамыз.
Dialogue: 0,0:05:07.41,0:05:09.83,Default,,0,0,0,,Айтпақшы, сіз бұрын не көріп едіңіз?
Dialogue: 0,0:05:10.37,0:05:11.20,Default,,0,0,0,,Эротикалық бейнелер?
Dialogue: 0,0:05:11.25,0:05:12.16,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:05:12.41,0:05:15.00,Default,,0,0,0,,Arkedor деп аталатын пұт жасау қолданбасы
Dialogue: 0,0:05:15.66,0:05:16.58,Default,,0,0,0,,Алкедор
Dialogue: 0,0:05:17.16,0:05:18.66,Default,,0,0,0,,Соңғы уақытта өте танымал болды.
Dialogue: 0,0:05:18.91,0:05:20.75,Default,,0,0,0,,Барлығы үнемі бейнелер жариялайды.
Dialogue: 0,0:05:21.33,0:05:23.04,Default,,0,0,0,,Сосуке де тырысты
Dialogue: 0,0:05:23.37,0:05:26.20,Default,,0,0,0,,Өлең толық болмағандықтан көңіліңіз қалса.
Dialogue: 0,0:05:26.25,0:05:27.41,Default,,0,0,0,,Сіз оны төмен қаратып ұстағыңыз келе ме?
Dialogue: 0,0:05:27.75,0:05:29.00,Default,,0,0,0,,Қара, мен саған айтып тұрмын —
Dialogue: 0,0:05:34.83,0:05:38.16,Default,,0,0,0,,Сәлеметсіз бе, мен Джолимін, сіз ше?
Dialogue: 0,0:05:38.87,0:05:40.04,Default,,0,0,0,,Мен Шопенмін
Dialogue: 0,0:05:40.62,0:05:41.91,Default,,0,0,0,,Қандай тамаша есім.
Dialogue: 0,0:05:42.50,0:05:43.20,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:43.66,0:05:45.66,Default,,0,0,0,,Мен ән айтқанды ұнатамын
Dialogue: 0,0:05:46.20,0:05:48.25,Default,,0,0,0,,Иә, маған да ұнайды.
Dialogue: 0,0:05:48.79,0:05:51.25,Default,,0,0,0,,Онда менің әнімді тыңдайсың ба?
Dialogue: 0,0:05:51.75,0:05:53.66,Default,,0,0,0,,Ой, тыңдайыншы.
Dialogue: 0,0:05:55.12,0:05:58.04,Default,,0,0,0,,Бір ғажап толқу, ол сондай
Dialogue: 0,0:05:58.12,0:06:00.83,Default,,0,0,0,,Екі тісті доңғалақ тоғысқанда
Dialogue: 0,0:06:00.91,0:06:03.62,Default,,0,0,0,,Айналып келе жатқандықтан, мен сенімен бірге боламын
Dialogue: 0,0:06:03.70,0:06:06.50,Default,,0,0,0,,Бірақ бір күні мен қабаттасқым келеді.
Dialogue: 0,0:06:06.54,0:06:07.83,Default,,0,0,0,,Осылай армандау
Dialogue: 0,0:06:08.00,0:06:09.45,Default,,0,0,0,,Сіз және Джоригори
Dialogue: 0,0:06:09.58,0:06:10.00,Default,,0,0,0,,Иә
Dialogue: 0,0:06:15.00,0:06:17.87,Default,,0,0,0,,Сәлеметсіз бе, мен Джолимін, сіз ше?
Dialogue: 0,0:06:19.16,0:06:19.91,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:20.58,0:06:21.79,Default,,0,0,0,,Қандай жақсы есім.
Dialogue: 0,0:06:22.37,0:06:23.08,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:23.33,0:06:26.20,Default,,0,0,0,,Мен ән айтқанды ұнатамын. Сен ше?
Dialogue: 0,0:06:27.20,0:06:28.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:28.33,0:06:30.25,Default,,0,0,0,,Ендеше, менің әнімді тыңдайсың ба?
Dialogue: 0,0:06:30.29,0:06:33.16,Default,,0,0,0,,Жоқ, жоқ, жоқ, бұл басқаша.
Dialogue: 0,0:06:33.33,0:06:36.29,Default,,0,0,0,,Менің тергенімді айтып тұрған жоқ па?
Dialogue: 0,0:06:36.79,0:06:40.45,Default,,0,0,0,,Джоли шынымен күлмейді, ол ән айтпайды
Dialogue: 0,0:06:40.70,0:06:46.79,Default,,0,0,0,,Мен Джолиді қатты жақсы көремін!
Dialogue: 0,0:06:59.54,0:07:01.00,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:07:01.08,0:07:03.20,Default,,0,0,0,,Иә
Dialogue: 0,0:07:04.83,0:07:08.33,Default,,0,0,0,,Бұл қайда? Эй, сен білесің бе?
Dialogue: 0,0:07:08.62,0:07:10.66,Default,,0,0,0,,А, Джоли?
Dialogue: 0,0:07:11.00,0:07:14.50,Default,,0,0,0,,Бұл менің атым ба? Менің атым Джоли?
Dialogue: 0,0:07:14.83,0:07:16.83,Default,,0,0,0,,Иә, солай
Dialogue: 0,0:07:17.16,0:07:18.12,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:07:19.00,0:07:22.37,Default,,0,0,0,,Мен Шопенмін
Dialogue: 0,0:07:23.08,0:07:26.00,Default,,0,0,0,,Шопен Не деген қызық есім.
Dialogue: 0,0:07:26.91,0:07:33.58,Default,,0,0,0,,Біртүрлі есім? Ахахха, бұл біртүрлі есім
Dialogue: 0,0:07:34.04,0:07:37.29,Default,,0,0,0,,Хахахахахахахахаха
Dialogue: 0,0:07:38.79,0:07:41.66,Default,,0,0,0,,Сонымен, сіз маған бұл әнді бердіңіз.
Dialogue: 0,0:07:42.91,0:07:44.79,Default,,0,0,0,,Менің әнім туралы не ойлайсың?
Dialogue: 0,0:07:45.08,0:07:49.33,Default,,0,0,0,,Маған ұнайды, өте әдемі, мөлдір
Dialogue: 0,0:07:50.20,0:07:50.87,Default,,0,0,0,,Ахаха
Dialogue: 0,0:07:51.54,0:07:52.83,Default,,0,0,0,,Ән айтпайсың ба?
Dialogue: 0,0:07:53.50,0:07:59.83,Default,,0,0,0,,Мен ән айтуда жақсы емеспін, сондықтан сіздің әндеріңізді айтқым келеді.
Dialogue: 0,0:08:00.75,0:08:01.33,Default,,0,0,0,,Иә
Dialogue: 0,0:08:01.62,0:08:03.08,Default,,0,0,0,,Жақсы ойнайды
Dialogue: 0,0:08:03.20,0:08:06.08,Default,,0,0,0,,Таңғажайып толқу, ол сондай
Dialogue: 0,0:08:06.83,0:08:07.33,Default,,0,0,0,,Ах
Dialogue: 0,0:08:10.91,0:08:11.29,Default,,0,0,0,,Эй
Dialogue: 0,0:08:11.58,0:08:12.00,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:08:12.58,0:08:15.54,Default,,0,0,0,,Мен әртүрлі әндерді естимін. Бұл не?
Dialogue: 0,0:08:16.54,0:08:16.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:17.79,0:08:19.54,Default,,0,0,0,,Сіз мұны да жасадыңыз ба?
Dialogue: 0,0:08:20.25,0:08:23.79,Default,,0,0,0,,Жоқ, иә, оны басқа біреу жасап, жүктеп салды.
Dialogue: 0,0:08:24.12,0:08:25.70,Default,,0,0,0,,Мен барлығының тыңдағанын қалаймын
Dialogue: 0,0:08:26.66,0:08:30.20,Default,,0,0,0,,Мм, сіздің әніңіз ең жақсы.
Dialogue: 0,0:08:31.95,0:08:35.37,Default,,0,0,0,,Иә, мен одан сайын ән айтамын.
Dialogue: 0,0:08:36.29,0:08:38.70,Default,,0,0,0,,Әніңізді көп адам естісін
Dialogue: 0,0:08:39.41,0:08:40.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:43.00,0:08:45.58,Default,,0,0,0,,-Уау, ғажап -Махаббат деген махаббат ойыны
Dialogue: 0,0:08:45.66,0:08:48.20,Default,,0,0,0,,-Бұл бейне өте толық -Мен сізге бірден айтқым келеді
Dialogue: 0,0:08:48.79,0:08:50.70,Default,,0,0,0,,«Тамаша ұлы би»
Dialogue: 0,0:08:50.95,0:08:53.00,Default,,0,0,0,,Жазған Фредерик Франсуа Шопен
Dialogue: 0,0:08:53.04,0:08:55.75,Default,,0,0,0,,Басылған вальстардың біріншісі.
Dialogue: 0,0:08:55.91,0:08:57.25,Default,,0,0,0,,Эй, мен оны көрмеймін.
Dialogue: 0,0:08:57.58,0:09:01.00,Default,,0,0,0,,Ой, кешіріңіз, бұл дұрыс.
Dialogue: 0,0:09:01.08,0:09:03.87,Default,,0,0,0,,Менің түсініктемеімді естігеннен гөрі әнді естігенді ұнатасың.
Dialogue: 0,0:09:03.95,0:09:05.41,Default,,0,0,0,,Иә, солай деп ойлаймын.
Dialogue: 0,0:09:05.58,0:09:06.79,Default,,0,0,0,,Мазалама
Dialogue: 0,0:09:07.12,0:09:08.29,Default,,0,0,0,,Махаббат - Джори Джоли
Dialogue: 0,0:09:08.41,0:09:09.66,Default,,0,0,0,,Махаббат саудасы
Dialogue: 0,0:09:09.79,0:09:12.54,Default,,0,0,0,,Мұндай режим ойын сияқты
Dialogue: 0,0:09:12.75,0:09:15.29,Default,,0,0,0,,-Жеңіс пен жеңіліс қызық емес пе? - Осы аптаны қараңыз
Dialogue: 0,0:09:15.33,0:09:17.50,Default,,0,0,0,,- Құпия белгіні жіберіп алмаңыз - бейнені ойнату рейтингінде №1
Dialogue: 0,0:09:17.54,0:09:19.54,Default,,0,0,0,,Бейнелер туралы не деуге болады?
Dialogue: 0,0:09:20.16,0:09:21.95,Default,,0,0,0,,Иә, мен жүктеп салдым.
Dialogue: 0,0:09:22.41,0:09:23.95,Default,,0,0,0,,Қалай?
Dialogue: 0,0:09:24.25,0:09:25.83,Default,,0,0,0,,Мен көп нәрсені білдім
Dialogue: 0,0:09:26.08,0:09:28.08,Default,,0,0,0,,Бұл жер көптеген жерлермен байланысқан.
Dialogue: 0,0:09:29.08,0:09:29.45,Default,,0,0,0,,О
Dialogue: 0,0:09:30.58,0:09:33.25,Default,,0,0,0,,Барлығы мені тыңдайды, ал сен ән айтып жатырсың
Dialogue: 0,0:09:33.45,0:09:35.08,Default,,0,0,0,,Әй, сен бақытты емессің бе?
Dialogue: 0,0:09:35.70,0:09:38.62,Default,,0,0,0,,А, иә, мен бақыттымын.
Dialogue: 0,0:09:39.54,0:09:40.54,Default,,0,0,0,,Жақсы
Dialogue: 0,0:09:43.08,0:09:44.12,Default,,0,0,0,,Үлгілердің бірі
Dialogue: 0,0:09:44.33,0:09:47.25,Default,,0,0,0,,Арнайы әсерлерді көруге болатыны туралы хабарламалар болды.
Dialogue: 0,0:09:47.91,0:09:50.70,Default,,0,0,0,,Мусиктің белгісі шығар
Dialogue: 0,0:09:52.62,0:09:55.37,Default,,0,0,0,,Виртуалды классикалоид дүниеге келген сияқты
Dialogue: 0,0:10:03.37,0:10:05.37,Default,,0,0,0,,Би бейнелерін көру арқылы оқыдым.
Dialogue: 0,0:10:05.62,0:10:07.37,Default,,0,0,0,,Мен оны келесі жолы хореографияма енгізуді жоспарлап отырмын.
Dialogue: 0,0:10:07.75,0:10:09.87,Default,,0,0,0,,Иә, жақсы
Dialogue: 0,0:10:10.33,0:10:13.70,Default,,0,0,0,,Бұл рас, мен өте қуаныштымын!
Dialogue: 0,0:10:13.75,0:10:15.45,Default,,0,0,0,,Ха?
Dialogue: 0,0:10:16.00,0:10:17.58,Default,,0,0,0,,Қуанған кездегі өрнектер
Dialogue: 0,0:10:17.75,0:10:21.08,Default,,0,0,0,,Көңілің мұң болса, шымырлайды.
Dialogue: 0,0:10:21.62,0:10:22.20,Default,,0,0,0,,О
Dialogue: 0,0:10:22.58,0:10:23.70,Default,,0,0,0,,Чара, Чара
Dialogue: 0,0:10:23.87,0:10:25.58,Default,,0,0,0,,Кейіпкерлерді жасау – кумир болудың негізі.
Dialogue: 0,0:10:25.87,0:10:27.00,Default,,0,0,0,,Көбірек оқу
Dialogue: 0,0:10:27.41,0:10:28.70,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:29.29,0:10:30.83,Default,,0,0,0,,Эй, мен жаңа ән алғым келеді.
Dialogue: 0,0:10:31.29,0:10:31.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:32.29,0:10:34.04,Default,,0,0,0,,Біз апта сайын жаңа әндер шығарамыз.
Dialogue: 0,0:10:34.41,0:10:37.20,Default,,0,0,0,,Біз басқа пұттарға жеңіліп қалмас үшін көбірек жүгінуіміз керек.
Dialogue: 0,0:10:37.62,0:10:40.00,Default,,0,0,0,,Мен де тек жанкүйерлерге арналған сайт ашқым келеді.
Dialogue: 0,0:10:40.25,0:10:42.70,Default,,0,0,0,,Қатысу нөмірлері мүшелерге электрондық пошта ақпараттық бюллетень арқылы беріледі.
Dialogue: 0,0:10:42.83,0:10:44.75,Default,,0,0,0,,Бейнені шектеулі қарауға рұқсат ету
Dialogue: 0,0:10:45.04,0:10:48.29,Default,,0,0,0,,Өйткені кейде жанкүйерлерді мазақтап, аштық сезімін тудыру керек.
Dialogue: 0,0:10:48.45,0:10:48.95,Default,,0,0,0,,О
Dialogue: 0,0:10:49.33,0:10:51.75,Default,,0,0,0,,Дүниені менімен және әндерімен толтыр
Dialogue: 0,0:10:52.08,0:10:52.87,Default,,0,0,0,,Сіз бақытты емессіз бе?
Dialogue: 0,0:10:53.25,0:10:56.25,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:10:56.33,0:10:59.00,Default,,0,0,0,,Жоқ, мен өте қуаныштымын!
Dialogue: 0,0:10:59.16,0:11:02.29,Default,,0,0,0,,Jojolijoli urepickuru
Dialogue: 0,0:11:02.66,0:11:04.70,Default,,0,0,0,,Джолидің жаңа әні Rush Бұл...
Dialogue: 0,0:11:04.75,0:11:06.91,Default,,0,0,0,,Иә? Виртуалды асып кету
Dialogue: 0,0:11:07.20,0:11:09.25,Default,,0,0,0,,Lightheaded - ақырында нашарлайтын қоқыс.
Dialogue: 0,0:11:09.29,0:11:12.04,Default,,0,0,0,,-Джоли ең жақсы -Екінші отаку тітіркендіргіш.Маған Джоли керек емес.
Dialogue: 0,0:11:12.08,0:11:13.33,Default,,0,0,0,,Маған жеңілтектік керек емес.
Dialogue: 0,0:11:14.29,0:11:15.58,Default,,0,0,0,,Джоли дегеніміз не?
Dialogue: 0,0:11:16.08,0:11:16.95,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:11:17.33,0:11:19.70,Default,,0,0,0,,Балалар сендер пұттарға еліктейсіңдер.
Dialogue: 0,0:11:19.75,0:11:20.83,Default,,0,0,0,,Бұл сол адамға арналған.
Dialogue: 0,0:11:21.16,0:11:23.37,Default,,0,0,0,,Олай етсең, туыстарың сені ұстап қалады.
Dialogue: 0,0:11:23.95,0:11:25.75,Default,,0,0,0,,Бұл Бахтың нұсқаулары.
Dialogue: 0,0:11:25.95,0:11:26.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:27.50,0:11:29.66,Default,,0,0,0,,Мысалы, виртуалды кеңістікте
Dialogue: 0,0:11:29.70,0:11:32.29,Default,,0,0,0,,Егер мүлдем жаңа классикалықоид жасай алсақ
Dialogue: 0,0:11:33.00,0:11:34.66,Default,,0,0,0,,Неге әлгі беймаза адамдармен әуре болады?
Dialogue: 0,0:11:34.70,0:11:36.66,Default,,0,0,0,,Оны қайтарудың қажеті жоқ.
Dialogue: 0,0:11:37.12,0:11:37.91,Default,,0,0,0,,О
Dialogue: 0,0:11:38.66,0:11:40.16,Default,,0,0,0,,Егер жинақталып, талданса
Dialogue: 0,0:11:40.45,0:11:42.20,Default,,0,0,0,,Виртуалды классикалоидтың жаппай өндірісі
Dialogue: 0,0:11:42.33,0:11:44.16,Default,,0,0,0,,Біз жүзеге асыруға жақындап келеміз.
Dialogue: 0,0:11:44.91,0:11:48.45,Default,,0,0,0,,Олай болса, Ұлы Бах жоспарының жүзеге асуы.
Dialogue: 0,0:11:48.50,0:11:51.58,Default,,0,0,0,,Ең үлкен үлес қосқан доктор Отова емес.
Dialogue: 0,0:11:52.12,0:11:53.79,Default,,0,0,0,,Бұл үшінші жол.
Dialogue: 0,0:11:57.66,0:11:59.20,Default,,0,0,0,,Аххххх
Dialogue: 0,0:12:01.45,0:12:03.16,Default,,0,0,0,,Мен жарты құбыжық болдым.
Dialogue: 0,0:12:03.45,0:12:04.29,Default,,0,0,0,,Йокай?
Dialogue: 0,0:12:04.70,0:12:06.45,Default,,0,0,0,,Тез арада оны тоқтатпасақ, қауіпті болады.
Dialogue: 0,0:12:06.95,0:12:08.41,Default,,0,0,0,,Сонымен, жын шығару туралы не айтуға болады?
Dialogue: 0,0:12:09.95,0:12:10.54,Default,,0,0,0,,Иә.
Dialogue: 0,0:12:11.75,0:12:15.16,Default,,0,0,0,,Мен түсінбеймін. Сіз жаңа ән шығаруды жек көресіз бе?
Dialogue: 0,0:12:15.45,0:12:17.04,Default,,0,0,0,,Бұл маған ұнайды немесе ұнамайды деген сөз емес.
Dialogue: 0,0:12:17.50,0:12:20.37,Default,,0,0,0,,Бірақ мен қызық, соншалықты танымал болу керек пе?
Dialogue: 0,0:12:20.41,0:12:22.91,Default,,0,0,0,,- Қажет пе? Эй, мен түсіндім - А
Dialogue: 0,0:12:23.16,0:12:24.83,Default,,0,0,0,,Бірінші сөзді іздеу
Dialogue: 0,0:12:25.00,0:12:27.54,Default,,0,0,0,,Қол жеткізу саны да артып келеді. Болашақ маңызды.
Dialogue: 0,0:12:27.62,0:12:28.91,Default,,0,0,0,,Оны тіпті бала да түсінеді.
Dialogue: 0,0:12:29.16,0:12:30.41,Default,,0,0,0,,Иә
Dialogue: 0,0:12:30.66,0:12:32.08,Default,,0,0,0,,Сіз бақыттымын дедіңіз.
Dialogue: 0,0:12:32.33,0:12:34.25,Default,,0,0,0,,Сіздің әніңізді барлығы тыңдау үшін
Dialogue: 0,0:12:34.29,0:12:37.04,Default,,0,0,0,,-Мен көп жұмыс жасадым, сонда не керек? Көтеріліс кезеңі? -А
Dialogue: 0,0:12:37.41,0:12:41.91,Default,,0,0,0,,Жоқ, мен Джолимен осылай сөйлестім.
Dialogue: 0,0:12:42.25,0:12:45.08,Default,,0,0,0,,Джолидің әнін тыңдау мені қуантады.
Dialogue: 0,0:12:45.16,0:12:49.25,Default,,0,0,0,,Аа, мен бақыттымын, өйткені мен бақыттымын
Dialogue: 0,0:12:49.50,0:12:50.33,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба?
Dialogue: 0,0:12:50.95,0:12:53.50,Default,,0,0,0,,Кешіріңіз, яғни.
Dialogue: 0,0:12:53.95,0:12:56.12,Default,,0,0,0,,Мен екеуміз болғаныма қуаныштымын
Dialogue: 0,0:12:57.25,0:13:01.12,Default,,0,0,0,,Өйткені менде Джоли болса, маған басқа ештеңе керек емес.
Dialogue: 0,0:13:02.29,0:13:04.33,Default,,0,0,0,,Жарайды, жеткілікті.
Dialogue: 0,0:13:04.66,0:13:05.16,Default,,0,0,0,,Ха
Dialogue: 0,0:13:06.58,0:13:08.54,Default,,0,0,0,,Жын шығару дегенді қалай түсінесіңдер?
Dialogue: 0,0:13:08.79,0:13:10.70,Default,,0,0,0,,Мен сені қуып жіберемін, сондықтан қамшымен ұрамын.
Dialogue: 0,0:13:11.16,0:13:13.16,Default,,0,0,0,,Бүкіл денеге сутра жазу жақсы дейді.
Dialogue: 0,0:13:13.58,0:13:15.25,Default,,0,0,0,,Сонда отқа жану ше?
Dialogue: 0,0:13:15.45,0:13:17.00,Default,,0,0,0,,Мұнда оттық бар.
Dialogue: 0,0:13:17.16,0:13:18.75,Default,,0,0,0,,Алдымен бәрін сынап көрейік
Dialogue: 0,0:13:19.70,0:13:22.25,Default,,0,0,0,,-Еееееееееееееееееееееееееееееееееееееееееееееееееее
Dialogue: 0,0:13:22.33,0:13:23.33,Default,,0,0,0,,Не болды, Чочан?
Dialogue: 0,0:13:23.41,0:13:27.20,Default,,0,0,0,,Джоли кетті
Dialogue: 0,0:13:27.29,0:13:28.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:30.08,0:13:33.20,Default,,0,0,0,,Шынайы ма? Джолиді Шопен мырза жасаған.
Dialogue: 0,0:13:33.79,0:13:37.91,Default,,0,0,0,,Бірақ ән шығармасаң, өмірде құндылығың жоқ.
Dialogue: 0,0:13:38.54,0:13:39.37,Default,,0,0,0,,Кицу
Dialogue: 0,0:13:39.83,0:13:41.83,Default,,0,0,0,,Бұдан былай жалғыз өзім істеймін.
Dialogue: 0,0:13:42.20,0:13:45.66,Default,,0,0,0,,Жолыма бөгет болсаң, мекен-жайың мен фотоңды интернетке саламын.
Dialogue: 0,0:13:46.25,0:13:47.66,Default,,0,0,0,,Менің мінезім нашар.
Dialogue: 0,0:13:48.08,0:13:49.50,Default,,0,0,0,,Байлық немесе атақ алған кезде
Dialogue: 0,0:13:49.75,0:13:52.00,Default,,0,0,0,,Адамның болмысын түсінуге болады дейді.
Dialogue: 0,0:13:52.50,0:13:53.70,Default,,0,0,0,,Қайғыға салынба
Dialogue: 0,0:13:54.12,0:13:57.33,Default,,0,0,0,,Сіз өзіңізді осындай әйелмен бөліскеніңіз үшін бақыттымын деп санауыңыз керек.
Dialogue: 0,0:13:57.58,0:14:00.45,Default,,0,0,0,,Дұрыс, ішіп алайық, ұмытайық.
Dialogue: 0,0:14:01.50,0:14:02.08,Default,,0,0,0,,Бірақ
Dialogue: 0,0:14:02.25,0:14:02.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:03.45,0:14:04.50,Default,,0,0,0,,♪ Дан, дан-тан…
Dialogue: 0,0:14:04.62,0:14:05.12,Default,,0,0,0,,Иә
Dialogue: 0,0:14:05.41,0:14:08.12,Default,,0,0,0,,Джоли болмаса, мен жақсы емеспін
Dialogue: 0,0:14:09.12,0:14:13.08,Default,,0,0,0,,Сонымен мен Джолидің орнына барамын.
Dialogue: 0,0:14:13.58,0:14:15.54,Default,,0,0,0,,Джоли интернетте ме?
Dialogue: 0,0:14:15.83,0:14:16.62,Default,,0,0,0,,-Аа-ух
Dialogue: 0,0:14:16.87,0:14:19.79,Default,,0,0,0,,Бұл сенің махаббатың, жақсы.
Dialogue: 0,0:14:20.25,0:14:22.95,Default,,0,0,0,,Енді мәңгілік махаббатты іздеуге барыңыз
Dialogue: 0,0:14:23.54,0:14:23.87,Default,,0,0,0,,Иә
Dialogue: 0,0:14:28.08,0:14:29.95,Default,,0,0,0,,Не, Musik-те?
Dialogue: 0,0:14:32.08,0:14:32.91,Default,,0,0,0,,Жоқ… Оларды Эрен өлтірді!!
Dialogue: 0,0:14:33.25,0:14:34.54,Default,,0,0,0,,Өзіңізге қамқорлық жасаңыз
Dialogue: 0,0:14:34.66,0:14:35.41,Default,,0,0,0,,Шебер бол
Dialogue: 0,0:14:35.62,0:14:36.41,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:14:36.58,0:14:38.00,Default,,0,0,0,,Мен шынымен барамын
Dialogue: 0,0:14:38.58,0:14:40.58,Default,,0,0,0,,Бәріңе сау болыңдар
Dialogue: 0,0:14:47.70,0:14:52.00,Default,,0,0,0,,«Фантазия экспромпту» Шопен жазған импровизациялардың ішінде
Dialogue: 0,0:14:52.12,0:14:54.08,Default,,0,0,0,,Соңғы жарияланған
Dialogue: 0,0:14:55.20,0:14:56.75,Default,,0,0,0,,Теңіз астындағы шайтанның шақыруы
Dialogue: 0,0:14:56.79,0:14:58.04,Default,,0,0,0,,Қанатты періштенің шақыруы
Dialogue: 0,0:14:58.12,0:14:59.20,Default,,0,0,0,,Қолды кеудеде айқастырып тізерлеп тұру
Dialogue: 0,0:14:59.33,0:15:00.95,Default,,0,0,0,,Терең қайғыға батқанша отставкаға кету
Dialogue: 0,0:15:00.95,0:15:01.58,Default,,0,0,0,,О, бұл
Dialogue: 0,0:15:02.08,0:15:02.70,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:04.04,0:15:04.70,Default,,0,0,0,,Рақмет, Джоэстар мырза.
Dialogue: 0,0:15:05.16,0:15:08.00,Default,,0,0,0,,Иә? Біз неге мұндамыз?
Dialogue: 0,0:15:09.66,0:15:10.25,Default,,0,0,0,,Бұл
Dialogue: 0,0:15:11.50,0:15:13.08,Default,,0,0,0,,Хмм, сәтсіздік.
Dialogue: 0,0:15:13.29,0:15:14.91,Default,,0,0,0,,Сәтсіздік деген нәрсе бар ма?
Dialogue: 0,0:15:15.08,0:15:17.70,Default,,0,0,0,,Өйткені біз мұны бөлек жасауды ойладық.
Dialogue: 0,0:15:17.75,0:15:19.79,Default,,0,0,0,,Мен Musik қолданбаймын.
Dialogue: 0,0:15:20.08,0:15:22.54,Default,,0,0,0,,Сонда мен бұлай үйге бара алмайтын шығармын.
Dialogue: 0,0:15:22.91,0:15:23.66,Default,,0,0,0,,Иә, бар.
Dialogue: 0,0:15:23.91,0:15:26.66,Default,,0,0,0,,Бұл жерде не қызық көрінеді
Dialogue: 0,0:15:26.83,0:15:29.29,Default,,0,0,0,,-Қызықпа Моцарт, бұл құрметсіздік -Хахахаха Хахахаха
Dialogue: 0,0:15:29.79,0:15:31.33,Default,,0,0,0,,Үйге бара алмасаңыз, жақсы.
Dialogue: 0,0:15:31.66,0:15:33.62,Default,,0,0,0,,Мен қайда болсам, ол менің әлемім
Dialogue: 0,0:15:33.75,0:15:35.16,Default,,0,0,0,,Күткендей, сенпай.
Dialogue: 0,0:15:36.08,0:15:37.50,Default,,0,0,0,,Маған Джолиді әкел
Dialogue: 0,0:15:37.75,0:15:38.37,Default,,0,0,0,,Чокчан
Dialogue: 0,0:15:38.87,0:15:40.33,Default,,0,0,0,,Мен ол жерге бара алмадым.
Dialogue: 0,0:15:40.62,0:15:42.79,Default,,0,0,0,,Бірақ мен Джолимен қайтадан сөйлескім келеді.
Dialogue: 0,0:15:43.16,0:15:45.87,Default,,0,0,0,,Әкелші десем де, қайда екеніңді білмеймін.
Dialogue: 0,0:15:46.04,0:15:47.54,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:15:47.83,0:15:49.33,Default,,0,0,0,,Білемін, бірақ шынымен сабырымды сақтай аламын ба?
Dialogue: 0,0:15:49.87,0:15:51.87,Default,,0,0,0,,Не айтып тұрсың, Сосуке?
Dialogue: 0,0:15:52.29,0:15:54.83,Default,,0,0,0,,Біз қазір ғана бірге едік, бірақ ұмыттың ба?
Dialogue: 0,0:15:55.41,0:15:57.29,Default,,0,0,0,,Сен сондай ақымақсың ба?
Dialogue: 0,0:15:57.70,0:16:01.95,Default,,0,0,0,,Бұл саркастикалық сөйлеу тәсілі шынымен Пад-кун ма?
Dialogue: 0,0:16:02.50,0:16:03.83,Default,,0,0,0,,Бірдеңе ыңғайсыз болса да
Dialogue: 0,0:16:04.58,0:16:07.45,Default,,0,0,0,,Жоқ, бұл ыңғайсыздық дер едім.
Dialogue: 0,0:16:07.95,0:16:09.75,Default,,0,0,0,,Сонымен Джоли қайда?
Dialogue: 0,0:16:10.66,0:16:12.79,Default,,0,0,0,,Арғы жақтан келе жатқан шығар.
Dialogue: 0,0:16:13.45,0:16:14.95,Default,,0,0,0,,Джоли жанкүйерлерінің онлайн оқиғалары
Dialogue: 0,0:16:15.04,0:16:17.12,Default,,0,0,0,,Мен шақыру жібердім.
Dialogue: 0,0:16:17.62,0:16:18.58,Default,,0,0,0,,-Иә -А
Dialogue: 0,0:16:19.54,0:16:21.04,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:16:21.79,0:16:27.12,Default,,0,0,0,,Барлығымен танысқаныма өте қуаныштымын!
Dialogue: 0,0:16:28.04,0:16:30.08,Default,,0,0,0,,дегеніміз не? Барлығы осы
Dialogue: 0,0:16:30.12,0:16:31.83,Default,,0,0,0,,Уау, шикі көңілді ме?
Dialogue: 0,0:16:32.08,0:16:35.75,Default,,0,0,0,,Джоли, мен қайталап көргім келеді.
Dialogue: 0,0:16:37.20,0:16:40.50,Default,,0,0,0,,Әй, маған керегі жоқ дедім ғой.
Dialogue: 0,0:16:41.00,0:16:44.87,Default,,0,0,0,,Кішкентай қыз, саған өмір сыйлаған Шопеннің күші болса керек.
Dialogue: 0,0:16:45.66,0:16:48.41,Default,,0,0,0,,Сіз тіпті Жаратушыға деген сүйіспеншілігіңіз де жоқ дейсіз бе?
Dialogue: 0,0:16:48.83,0:16:50.25,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:16:50.62,0:16:52.45,Default,,0,0,0,,Ендеше менімен қыдырғың келе ме?
Dialogue: 0,0:16:52.54,0:16:54.33,Default,,0,0,0,,Ағаның жақсы сөздерін босқа жіберме
Dialogue: 0,0:16:55.16,0:16:58.08,Default,,0,0,0,,Мен ешкімге тиесілі емеспін
Dialogue: 0,0:16:58.79,0:17:01.20,Default,,0,0,0,,Өйткені мен кумирмін
Dialogue: 0,0:17:02.37,0:17:03.08,Default,,0,0,0,,Джоли
Dialogue: 0,0:17:03.45,0:17:04.91,Default,,0,0,0,,Махаббат - Джори Джоли
Dialogue: 0,0:17:05.04,0:17:06.25,Default,,0,0,0,,Махаббат саудасы
Dialogue: 0,0:17:06.29,0:17:09.29,Default,,0,0,0,,-Ах! - Ойынға ұқсас режим
Dialogue: 0,0:17:09.33,0:17:11.95,Default,,0,0,0,,-Жеңіс пен жеңіліс қызық емес пе? -Бұл не?
Dialogue: 0,0:17:12.12,0:17:15.20,Default,,0,0,0,,-Құпия белгіні жіберіп алмаңыз -Музыка Бұл музыка.
Dialogue: 0,0:17:15.33,0:17:17.50,Default,,0,0,0,,-Екі адамның жүрегі күдіктенеді -Ол неге
Dialogue: 0,0:17:17.75,0:17:19.37,Default,,0,0,0,,- Жүрек соғуы - Үлгі жинау
Dialogue: 0,0:17:19.45,0:17:20.95,Default,,0,0,0,,-Мұндай режим -Мәліметтерді талдау
Dialogue: 0,0:17:21.04,0:17:23.29,Default,,0,0,0,,Көзіміз түйісіп қалса, күліп аламыз
Dialogue: 0,0:17:23.45,0:17:26.20,Default,,0,0,0,,Таңғажайып толқу, ол осындай
Dialogue: 0,0:17:26.54,0:17:30.79,Default,,0,0,0,,Хе, мен оны жек көремін.
Dialogue: 0,0:17:32.66,0:17:35.00,Default,,0,0,0,,Джоли, не болды, Джоли?
Dialogue: 0,0:17:35.50,0:17:41.29,Default,,0,0,0,,Не болып жатыр? Денемді сорып жатыр.
Dialogue: 0,0:17:42.04,0:17:43.83,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:17:44.41,0:17:47.41,Default,,0,0,0,,Менің болжауымша, бірақ Джолиді біреу алып кетті.
Dialogue: 0,0:17:47.62,0:17:50.20,Default,,0,0,0,,Сіз бүкіл бағдарламаны қалпына келтіруге тырысып жатқан сияқтысыз.
Dialogue: 0,0:17:50.54,0:17:51.33,Default,,0,0,0,,Қалпына келтіру?
Dialogue: 0,0:17:51.58,0:17:58.41,Default,,0,0,0,,Уф, уф, басым бірте-бірте ағарып барады.
Dialogue: 0,0:17:59.04,0:18:01.41,Default,,0,0,0,,Джоли Джоли
Dialogue: 0,0:18:02.41,0:18:04.20,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:18:04.70,0:18:06.16,Default,,0,0,0,,Бұл да болжам.
Dialogue: 0,0:18:06.79,0:18:09.12,Default,,0,0,0,,Қазіргі Джоли Мусик деп аталады.
Dialogue: 0,0:18:09.16,0:18:11.91,Default,,0,0,0,,Сіз вирус жұқтырған сияқтысыз.
Dialogue: 0,0:18:12.50,0:18:14.75,Default,,0,0,0,,Егер сіз күшті вирустарды жоюды іске қоссаңыз
Dialogue: 0,0:18:15.04,0:18:16.83,Default,,0,0,0,,Джоли бастапқы күйіне оралады
Dialogue: 0,0:18:17.08,0:18:19.66,Default,,0,0,0,,Қайта алу пәрмендері де тоқтатылуы мүмкін
Dialogue: 0,0:18:20.12,0:18:21.50,Default,,0,0,0,,Вирустарды жою дегеніміз не?
Dialogue: 0,0:18:21.91,0:18:25.66,Default,,0,0,0,,Ха, Шопен мырза, егер бұл Мусиктің күші болса.
Dialogue: 0,0:18:25.75,0:18:26.37,Default,,0,0,0,,Жер
Dialogue: 0,0:18:26.66,0:18:27.66,Default,,0,0,0,,​​Иә, иә.
Dialogue: 0,0:18:28.33,0:18:28.95,Default,,0,0,0,,«Барлығын мен үшін» мұрагері…
Dialogue: 0,0:18:29.16,0:18:29.70,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:29.87,0:18:31.66,Default,,0,0,0,,Егер вирус жойылса
Dialogue: 0,0:18:32.54,0:18:34.45,Default,,0,0,0,,Джоли жай қолданбаға оралды
Dialogue: 0,0:18:35.12,0:18:37.75,Default,,0,0,0,,Мен қазіргі болмысымды жоғалтып аламын ба деп қорқамын.
Dialogue: 0,0:18:38.16,0:18:38.70,Default,,0,0,0,,Га
Dialogue: 0,0:18:39.41,0:18:41.29,Default,,0,0,0,,Қалай болғанда да, Джоли
Dialogue: 0,0:18:41.37,0:18:42.41,Default,,0,0,0,,Бұл көмектеспейді дегенді білдіре ме?
Dialogue: 0,0:18:43.58,0:18:44.45,Default,,0,0,0,,Солай болады.
Dialogue: 0,0:18:45.58,0:18:53.04,Default,,0,0,0,,Жоқ, мен Джолиді жоғалта алмаймын.
Dialogue: 0,0:18:54.95,0:19:03.58,Default,,0,0,0,,Кууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:19:04.04,0:19:07.70,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:19:08.95,0:19:09.70,Default,,0,0,0,,Бізге Токио ұнайды! (Фушигуро) Ә?
Dialogue: 0,0:19:09.79,0:19:10.41,Default,,0,0,0,,Шопен
Dialogue: 0,0:19:10.50,0:19:13.37,Default,,0,0,0,,Хааааааааааааааааааааааааа
Dialogue: 0,0:19:14.37,0:19:18.29,Default,,0,0,0,,Әй, қандай ұят, жоғарғы кумирге айналу.
Dialogue: 0,0:19:18.66,0:19:20.58,Default,,0,0,0,,Мен сізге түсіндіргім келді деп ойладым.
Dialogue: 0,0:19:21.58,0:19:25.20,Default,,0,0,0,,Әндерің өте керемет
Dialogue: 0,0:19:25.83,0:19:26.70,Default,,0,0,0,,О
Dialogue: 0,0:19:27.45,0:19:33.75,Default,,0,0,0,,Бұл менмін. Маған сіздің әндеріңіз ұнайды. Сіз бен біз жасаған әндер.
Dialogue: 0,0:19:34.70,0:19:37.41,Default,,0,0,0,,Ештеңені түсінбейтін адам мені тонағым келмейді.
Dialogue: 0,0:19:38.20,0:19:42.37,Default,,0,0,0,,Ендеше Шопеннің қолдарымен аяқтаңыз
Dialogue: 0,0:19:42.50,0:19:47.16,Default,,0,0,0,,Ха Джоли
Dialogue: 0,0:19:49.41,0:19:51.04,Default,,0,0,0,,Судың көтерілуі мен ағыны
Dialogue: 0,0:19:51.08,0:19:52.50,Default,,0,0,0,,Жел ентігіп, ырылдады
Dialogue: 0,0:19:52.62,0:19:54.00,Default,,0,0,0,,Мен семсерімді бар күшіммен ішке бастым, бірақ
Dialogue: 0,0:19:54.04,0:19:55.58,Default,,0,0,0,,Менің денем шыдамайтын сияқты
Dialogue: 0,0:19:55.66,0:19:57.00,Default,,0,0,0,,Теңіз астындағы шайтанның шақыруы
Dialogue: 0,0:19:57.20,0:19:58.50,Default,,0,0,0,,Қанатты періштенің шақыруы
Dialogue: 0,0:19:58.54,0:19:59.62,Default,,0,0,0,,Қолды кеудеде айқастырып тізе бүгу
Dialogue: 0,0:19:59.66,0:20:01.54,Default,,0,0,0,,Терең қайғыға батқанша отставкаға кету
Dialogue: 0,0:20:01.62,0:20:04.45,Default,,0,0,0,,өзгермейтін
Dialogue: 0,0:20:04.54,0:20:07.58,Default,,0,0,0,,Қайғысыз тағдыр
Dialogue: 0,0:20:07.62,0:20:10.41,Default,,0,0,0,,екі адамды ажырату
Dialogue: 0,0:20:10.45,0:20:13.37,Default,,0,0,0,,Соңғы намаз да
Dialogue: 0,0:20:13.50,0:20:16.54,Default,,0,0,0,,Егер ол келмесе
Dialogue: 0,0:20:16.62,0:20:19.45,Default,,0,0,0,,Бір ғана нәрсе
Dialogue: 0,0:20:19.54,0:20:20.95,Default,,0,0,0,,Теңіз астындағы шайтанның шақыруы
Dialogue: 0,0:20:21.00,0:20:22.54,Default,,0,0,0,,Қанатты періштенің шақыруы
Dialogue: 0,0:20:22.58,0:20:23.87,Default,,0,0,0,,Қолды кеудеде айқастырып тізерлеп тұру
Dialogue: 0,0:20:23.91,0:20:24.83,Default,,0,0,0,,Қайғыны жоқтаусыз қабыл алыңыз.
Dialogue: 0,0:20:38.95,0:20:39.66,Default,,0,0,0,,Таптым сені, Йошикагэ… Хм?
Dialogue: 0,0:20:45.70,0:20:47.45,Default,,0,0,0,,Рахмет Шопен
Dialogue: 0,0:20:48.87,0:20:51.91,Default,,0,0,0,,Джоли, қоштасып жатырсың ба?
Dialogue: 0,0:20:53.58,0:20:55.62,Default,,0,0,0,,Сізбен кездесу қызықты болды.
Dialogue: 0,0:20:56.62,0:20:57.25,Default,,0,0,0,,Мен де
Dialogue: 0,0:20:58.33,0:21:00.83,Default,,0,0,0,,Мен туралы ұмытпа
Dialogue: 0,0:21:02.79,0:21:03.79,Default,,0,0,0,,Амон, ол жігіт қауіпті.
Dialogue: 0,0:21:04.25,0:21:07.04,Default,,0,0,0,,Жарайды, мен әрқашан
Dialogue: 0,0:21:07.50,0:21:09.70,Default,,0,0,0,,Мен сенің ішіңде ән айта беремін
Dialogue: 0,0:21:11.50,0:21:14.70,Default,,0,0,0,,Әй, саған менің әнім ұнай ма?
Dialogue: 0,0:21:14.95,0:21:19.37,Default,,0,0,0,,Иә, маған ұнады.
Dialogue: 0,0:21:22.33,0:21:28.91,Default,,0,0,0,,Шопен құтты болсын, қош бол
Dialogue: 0,0:21:33.04,0:21:38.25,Default,,0,0,0,,Джоли, мен сенен тағы айырылдым.
Dialogue: 0,0:21:40.25,0:21:41.00,Default,,0,0,0,,Мен де, әпкем де осы жерде күтеміз.
Dialogue: 0,0:21:42.08,0:21:43.25,Default,,0,0,0,,Джордж Санд
Dialogue: 0,0:21:44.04,0:21:46.37,Default,,0,0,0,,Француз әйел жазушысы және феминисті
Dialogue: 0,0:21:47.08,0:21:48.66,Default,,0,0,0,,Ол музыкант ретінде кемелденген кезеңде болды.
Dialogue: 0,0:21:48.70,0:21:49.95,Default,,0,0,0,,Фредерик Шопен
Dialogue: 0,0:21:50.16,0:21:52.16,Default,,0,0,0,,Серік болғанын айтты
Dialogue: 0,0:21:52.50,0:21:56.75,Default,,0,0,0,,Джордж Джоли көріп тұрмын.
Dialogue: 0,0:21:58.62,0:22:00.50,Default,,0,0,0,,Мен сіздің сезіміңізді түсінемін.
Dialogue: 0,0:22:01.12,0:22:02.00,Default,,0,0,0,,Чокчан
Dialogue: 0,0:22:03.37,0:22:05.62,Default,,0,0,0,,Барлығыңызға рахмет
Dialogue: 0,0:22:09.50,0:22:13.00,Default,,0,0,0,,Джолли үлгісі талдау кезінде кенеттен жоғалып кетті
Dialogue: 0,0:22:13.37,0:22:17.41,Default,,0,0,0,,Себебі белгісіз, бірақ менің ойымша
Dialogue: 0,0:22:17.66,0:22:19.62,Default,,0,0,0,,Зерттеуді жалғастырып, келесі үлгіні қолданып көріңіз.
Dialogue: 0,0:22:19.66,0:22:20.58,Default,,0,0,0,,Жақсы
Dialogue: 0,0:22:21.20,0:22:24.95,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:22:26.29,0:22:28.12,Default,,0,0,0,,Мен Алкедорды таратуды тоқтатамын.
Dialogue: 0,0:22:31.08,0:22:35.54,Default,,0,0,0,,Сәлем, мен Jolly 2. Танысқаныма қуаныштымын.
Dialogue: 0,0:22:36.04,0:22:38.45,Default,,0,0,0,,Ха, өте сүйкімді Джоли 2
Dialogue: 0,0:22:39.50,0:22:40.66,Default,,0,0,0,,Соғу қиын.
Dialogue: 0,0:22:47.62,0:22:48.95,Default,,0,0,0,,Судың көтерілуі мен атқылауы
Dialogue: 0,0:22:49.08,0:22:50.33,Default,,0,0,0,,Жел ентігіп, күркіреді
Dialogue: 0,0:22:50.41,0:22:51.87,Default,,0,0,0,,Мен семсерімді бар күшіммен бастым, бірақ
Dialogue: 0,0:22:51.91,0:22:53.41,Default,,0,0,0,,Менің денем шыдамайтын сияқты
Dialogue: 0,0:22:53.45,0:22:54.83,Default,,0,0,0,,Теңіз астындағы шайтанның шақыруы
Dialogue: 0,0:22:54.91,0:22:56.29,Default,,0,0,0,,Қанатты періштенің шақыруы
Dialogue: 0,0:22:56.37,0:22:57.50,Default,,0,0,0,,Қолды кеудеде айқастырып тізе бүгу
Dialogue: 0,0:22:57.58,0:22:59.29,Default,,0,0,0,,Терең қайғыға батқанша отставкаға кету
Dialogue: 0,0:22:59.41,0:23:02.41,Default,,0,0,0,,өзгеріссіз
Dialogue: 0,0:23:02.58,0:23:05.41,Default,,0,0,0,,Қайғысыз тағдыр
Dialogue: 0,0:23:05.54,0:23:08.25,Default,,0,0,0,,екі адамды ажырату
Dialogue: 0,0:23:08.37,0:23:11.37,Default,,0,0,0,,Соңғы намаз да
Dialogue: 0,0:23:11.50,0:23:14.75,Default,,0,0,0,,Егер ол келмесе
Dialogue: 0,0:23:14.83,0:23:17.29,Default,,0,0,0,,Бір ғана нәрсе
Dialogue: 0,0:23:17.50,0:23:18.87,Default,,0,0,0,,Теңіз астындағы шайтанның шақыруы
Dialogue: 0,0:23:18.91,0:23:20.33,Default,,0,0,0,,Қанатты періштенің шақыруы
Dialogue: 0,0:23:20.37,0:23:21.66,Default,,0,0,0,,Қолды кеудеде айқастырып тізе бүгіңіз
Dialogue: 0,0:23:21.75,0:23:23.04,Default,,0,0,0,,Қайғыны жоқтаусыз қабыл алыңыз.
Dialogue: 0,0:23:23.16,0:23:23.95,Default,,0,0,0,,Ән айту
Dialogue: 0,0:23:24.04,0:23:24.87,Default,,0,0,0,,Ән айту кезінде жасаңыз
Dialogue: 0,0:23:24.95,0:23:26.45,Default,,0,0,0,,Жалғыз жасаушы бол
Dialogue: 0,0:23:26.54,0:23:27.62,Default,,0,0,0,,Оның дауысы Оның әні
Dialogue: 0,0:23:27.70,0:23:29.45,Default,,0,0,0,,Оның әлемі Оның өзі Оның мәні
Dialogue: 0,0:23:29.54,0:23:30.87,Default,,0,0,0,,Әлі қалған белгілердің арасында
Dialogue: 0,0:23:30.95,0:23:32.37,Default,,0,0,0,,Болмысты босату және дене температурасы
Dialogue: 0,0:23:56.45,0:23:57.83,Default,,0,0,0,,О
Dialogue: 0,0:23:57.91,0:24:07.79,Default,,0,0,0,,Дүниеде абайсызда қалқып...
Dialogue: 0,0:24:14.95,0:24:17.33,Default,,0,0,0,,Кеше бар, бүгін бар, ертең бар.
Dialogue: 0,0:24:17.91,0:24:20.54,Default,,0,0,0,,Былайша айтқанда, бұл өмір, түзу айтайық.
Dialogue: 0,0:24:20.62,0:24:23.87,Default,,0,0,0,,Маңыздысы мұндағы өрт емес, үй жұмысы.
Dialogue: 0,0:24:24.12,0:24:27.16,Default,,0,0,0,,Тамақ пісіру, кір жуу, тазалау, қоқыс шығару, мұны істей білу керек.
Dialogue: 0,0:24:27.29,0:24:30.75,Default,,0,0,0,,Генийдің, музыканың, өнердің мағынасы жоқ.
Dialogue: 0,0:24:32.25,0:24:38.25,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory