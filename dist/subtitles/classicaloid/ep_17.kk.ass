Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.58,0:00:15.66,Default,,0,0,0,,Ичи Ни Ичи Ни Ичи Ни Ичи Ни
Dialogue: 0,0:00:16.54,0:00:21.33,Default,,0,0,0,,Ичи ни Ичи ни Ичи ни Ичи ни
Dialogue: 0,0:00:21.91,0:00:23.91,Default,,0,0,0,,Жалпы - Тоқта!
Dialogue: 0,0:00:27.50,0:00:30.25,Default,,0,0,0,,Бұл маған бір нәрсені еске түсіретін сияқты.
Dialogue: 0,0:00:31.12,0:00:34.91,Default,,0,0,0,,Бірақ жалғыз жүру қызықсыз ғой.
Dialogue: 0,0:00:35.45,0:00:35.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:42.50,0:00:42.95,Default,,0,0,0,,Иә
Dialogue: 0,0:00:45.87,0:00:50.91,Default,,0,0,0,,...
Dialogue: 0,0:00:51.16,0:00:54.25,Default,,0,0,0,,Дәмді, дәмді, дәмді
Dialogue: 0,0:02:25.95,0:02:27.87,Default,,0,0,0,,Бұл грильдегі мандарин апельсиндері
Dialogue: 0,0:02:28.54,0:02:29.20,Default,,0,0,0,,...
Dialogue: 0,0:02:29.70,0:02:31.37,Default,,0,0,0,,Денсаулыққа пайдалы деп естідім.
Dialogue: 0,0:02:31.75,0:02:34.08,Default,,0,0,0,,Оның қалыпты тамақтанудан айырмашылығы неде?
Dialogue: 0,0:02:34.91,0:02:35.87,Default,,0,0,0,,Хмм
Dialogue: 0,0:02:36.08,0:02:37.54,Default,,0,0,0,,Иә, барлық тері?
Dialogue: 0,0:02:37.95,0:02:39.79,Default,,0,0,0,,Бұл тиімдірек.
Dialogue: 0,0:02:40.16,0:02:42.50,Default,,0,0,0,,Суық тиюді бір еккенде емдеуге болады.
Dialogue: 0,0:02:42.75,0:02:45.62,Default,,0,0,0,,-Хахахахаха -Грильдегі мандарин апельсиндері.
Dialogue: 0,0:02:45.95,0:02:48.62,Default,,0,0,0,,Кейбір аймақтарда оны жеудің танымал тәсілі сияқты.
Dialogue: 0,0:02:48.91,0:02:50.00,Default,,0,0,0,,Пісіру арқылы
Dialogue: 0,0:02:50.16,0:02:52.79,Default,,0,0,0,,Терінің қоректенуі күрт артады.
Dialogue: 0,0:02:53.08,0:02:56.95,Default,,0,0,0,,Нәрлендіретін тоник Денсаулықты қалпына келтіруге керемет әсер етеді дейді.
Dialogue: 0,0:02:57.41,0:03:01.33,Default,,0,0,0,,Менен сұрасаң, бұл әжемнің бір даналығы.
Dialogue: 0,0:03:01.91,0:03:05.37,Default,,0,0,0,,көремін. Бұл Шопен мырза.
Dialogue: 0,0:03:05.83,0:03:06.41,Default,,0,0,0,,Жалпы алғанда, сол хабар тарату мұнарасынан өткеннен кейін сигнал әдетте жақсы болады
Dialogue: 0,0:03:08.87,0:03:09.29,Default,,0,0,0,,Га
Dialogue: 0,0:03:09.33,0:03:10.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:10.45,0:03:12.00,Default,,0,0,0,,Utanae
Dialogue: 0,0:03:12.45,0:03:15.91,Default,,0,0,0,,Эй, жақсысың ба? Утана, мықты бол.
Dialogue: 0,0:03:16.12,0:03:18.50,Default,,0,0,0,,Сосуке
Dialogue: 0,0:03:18.79,0:03:20.12,Default,,0,0,0,,Иә, бұл менмін.
Dialogue: 0,0:03:20.62,0:03:22.95,Default,,0,0,0,,Уф Гехогехо
Dialogue: 0,0:03:23.16,0:03:25.41,Default,,0,0,0,,Өлме, Утанае, өлме!
Dialogue: 0,0:03:25.45,0:03:28.95,Default,,0,0,0,,Тыныш бол, жарай ма? котенка
Dialogue: 0,0:03:29.41,0:03:31.62,Default,,0,0,0,,Иә, Кехокехокет
Dialogue: 0,0:03:31.70,0:03:33.54,Default,,0,0,0,,Жарайды, өзіңізді қатты итермеңіз.
Dialogue: 0,0:03:33.66,0:03:37.54,Default,,0,0,0,,Аа, кешіріңіз, биылғы суық қатты болды.
Dialogue: 0,0:03:38.95,0:03:39.45,Default,,0,0,0,,Суық?
Dialogue: 0,0:03:40.04,0:03:40.79,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:03:40.95,0:03:43.41,Default,,0,0,0,,Сондықтан мен саған үндеме деп айтып отырмын.
Dialogue: 0,0:03:43.79,0:03:45.83,Default,,0,0,0,,Дұрыс, мен таң қалдым.
Dialogue: 0,0:03:46.12,0:03:48.45,Default,,0,0,0,,Шопен мырза маған «өліп жатыр» деп электрондық хат жіберді.
Dialogue: 0,0:03:48.75,0:03:50.25,Default,,0,0,0,,Өліп бара жатқан біздер
Dialogue: 0,0:03:50.54,0:03:50.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:51.29,0:03:52.33,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:03:52.50,0:03:55.70,Default,,0,0,0,,Егер Утанае құласа, бізге кім тамақ дайындайды?
Dialogue: 0,0:03:55.91,0:03:58.25,Default,,0,0,0,,Сондай-ақ кір жуу және бөлме тазалау бар.
Dialogue: 0,0:03:58.45,0:03:59.29,Default,,0,0,0,,Бәріңе сәлем
Dialogue: 0,0:03:59.66,0:04:02.41,Default,,0,0,0,,Өзіңізден гөрі котенкаңызды уайымдаңыз.
Dialogue: 0,0:04:02.70,0:04:05.91,Default,,0,0,0,,Хмм, мен не болса да тез сауығып кетуім керек.
Dialogue: 0,0:04:06.37,0:04:09.41,Default,,0,0,0,,Суық тигенді бір еккенде емдейтін дәрі болса ғой.
Dialogue: 0,0:04:09.75,0:04:11.33,Default,,0,0,0,,Мұндай ыңғайлы
Dialogue: 0,0:04:11.83,0:04:13.16,Default,,0,0,0,,-Аааа -Иә
Dialogue: 0,0:04:13.87,0:04:15.50,Default,,0,0,0,,Грильде пісірілген мандарин апельсиндері бар.
Dialogue: 0,0:04:16.00,0:04:17.25,Default,,0,0,0,,Қуырылған мандарин апельсиндері?
Dialogue: 0,0:04:17.58,0:04:21.58,Default,,0,0,0,,Сіз мұны білмейсіз бе? Бұл ауылдық жерлерде оны жеудің әйгілі тәсілі.
Dialogue: 0,0:04:21.83,0:04:24.58,Default,,0,0,0,,Пісірген кезде терісі барға айналады, мүмкін қоңыр болады.
Dialogue: 0,0:04:25.04,0:04:26.08,Default,,0,0,0,,-Бұл таңқаларлық болды -Хмм.
Dialogue: 0,0:04:26.45,0:04:28.41,Default,,0,0,0,,Суық тисе, бір оқпен ұшып кетеді дейді.
Dialogue: 0,0:04:28.50,0:04:31.58,Default,,0,0,0,,Не? Ескі даналық?
Dialogue: 0,0:04:31.91,0:04:33.66,Default,,0,0,0,,Жасырын адам үшін онша білгір емес.
Dialogue: 0,0:04:33.91,0:04:37.83,Default,,0,0,0,,Бұл менің түсіндірмесі және бұл өте орынды.
Dialogue: 0,0:04:38.08,0:04:39.04,Default,,0,0,0,,таяз
Dialogue: 0,0:04:39.41,0:04:41.41,Default,,0,0,0,,Бірақ суық тиюге қарсы тиімді болса
Dialogue: 0,0:04:41.50,0:04:42.83,Default,,0,0,0,,Байқап көруге тұрарлық па?
Dialogue: 0,0:04:43.25,0:04:45.70,Default,,0,0,0,,Мандариннің өте дәмді екенін білемін.
Dialogue: 0,0:04:46.33,0:04:47.12,Default,,0,0,0,,Мен барып аламын.
Dialogue: 0,0:04:48.58,0:04:52.12,Default,,0,0,0,,Эхо Эхо Эхо Фу
Dialogue: 0,0:04:53.54,0:04:56.66,Default,,0,0,0,,Бұл Утанаенің суық тиюін бірден емдейді.
Dialogue: 0,0:04:57.16,0:04:58.29,Default,,0,0,0,,Содан кейін...
Dialogue: 0,0:04:59.54,0:05:02.00,Default,,0,0,0,,Суық тиген мотуымның арқасында.
Dialogue: 0,0:05:02.33,0:05:04.29,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:05:04.62,0:05:07.54,Default,,0,0,0,,Фуфухи Хияху
Dialogue: 0,0:05:12.12,0:05:14.62,Default,,0,0,0,,Егер қашып кеткім келгенде—
Dialogue: 0,0:05:16.12,0:05:18.29,Default,,0,0,0,,Келіңіздер, ұялудың қажеті жоқ.
Dialogue: 0,0:05:18.50,0:05:19.12,Default,,0,0,0,,О
Dialogue: 0,0:05:19.20,0:05:21.54,Default,,0,0,0,,Бүкіл теріні мүмкіндігінше қатты жұтыңыз
Dialogue: 0,0:05:23.91,0:05:26.75,Default,,0,0,0,,О мммм
Dialogue: 0,0:05:27.37,0:05:29.62,Default,,0,0,0,,Ммм, бұл дәмді!
Dialogue: 0,0:05:29.79,0:05:30.70,Default,,0,0,0,,Иә
Dialogue: 0,0:05:31.41,0:05:32.12,Default,,0,0,0,,Оның дәмі қандай?
Dialogue: 0,0:05:32.54,0:05:35.79,Default,,0,0,0,,Бірдеңе, тәтті картоп сияқты нәзік дәмі бар.
Dialogue: 0,0:05:36.20,0:05:38.70,Default,,0,0,0,,Денемнің ішінен жылылық сезіледі.
Dialogue: 0,0:05:39.00,0:05:40.66,Default,,0,0,0,,Менің ойымша, бұл жұмыс істейді.
Dialogue: 0,0:05:42.12,0:05:43.58,Default,,0,0,0,,Мен улы адаммын ба?
Dialogue: 0,0:05:43.95,0:05:46.66,Default,,0,0,0,,Жақсы, өйткені бұл жақсы болды. Аму.
Dialogue: 0,0:05:47.33,0:05:49.95,Default,,0,0,0,,Мм, дәмді, бұл дәм
Dialogue: 0,0:05:50.41,0:05:53.08,Default,,0,0,0,,Даналықтың, тапқырлықтың және махаббаттың шынайы үндестігі
Dialogue: 0,0:05:53.33,0:05:55.16,Default,,0,0,0,,Менің ағам айтқандай.
Dialogue: 0,0:05:55.33,0:05:56.00,Default,,0,0,0,,-Ммм -Ах
Dialogue: 0,0:05:56.54,0:05:57.83,Default,,0,0,0,,Сіз ішімдік жегіңіз келмейді ме?
Dialogue: 0,0:05:58.25,0:06:01.58,Default,,0,0,0,,Иә, мен көп тамақтандым, сондықтан тойдым.
Dialogue: 0,0:06:02.12,0:06:03.70,Default,,0,0,0,,Оны басқа уақытта пісіруге болады.
Dialogue: 0,0:06:04.25,0:06:07.00,Default,,0,0,0,,Чоччан, соншалықты ұқыпты болудың қажеті жоқ.
Dialogue: 0,0:06:07.04,0:06:08.33,Default,,0,0,0,,Оны терімен жеуге болады.
Dialogue: 0,0:06:08.95,0:06:10.50,Default,,0,0,0,,Хмм.
Dialogue: 0,0:06:11.04,0:06:13.66,Default,,0,0,0,,Бұл грильдегі мандарин апельсиндерін білдірмейді.
Dialogue: 0,0:06:14.04,0:06:15.54,Default,,0,0,0,,Ахахха хахаха
Dialogue: 0,0:06:15.58,0:06:16.20,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:06:16.25,0:06:17.41,Default,,0,0,0,,-Әрине -Геез.
Dialogue: 0,0:06:17.50,0:06:18.66,Default,,0,0,0,,Олар Суттоны ертіп әкелді.
Dialogue: 0,0:06:22.04,0:06:25.75,Default,,0,0,0,,Фуфуфуфуфу
Dialogue: 0,0:06:40.08,0:06:41.41,Default,,0,0,0,,Жоқ, жоқ, бұл дұрыс болуы мүмкін емес.
Dialogue: 0,0:06:41.50,0:06:43.45,Default,,0,0,0,,-Өтінемін, тоқтатыңыз! -Хахахахаха
Dialogue: 0,0:06:56.75,0:06:59.95,Default,,0,0,0,,Хмм? Хмм
Dialogue: 0,0:07:08.45,0:07:10.29,Default,,0,0,0,,Кім?
Dialogue: 0,0:07:11.16,0:07:11.79,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:12.20,0:07:15.37,Default,,0,0,0,,-Сенпай мықты болшы.Сенпай -Уф
Dialogue: 0,0:07:15.41,0:07:16.79,Default,,0,0,0,,Ууууууууууууу
Dialogue: 0,0:07:17.08,0:07:17.87,Default,,0,0,0,,-Бето-сан? -У
Dialogue: 0,0:07:18.16,0:07:19.70,Default,,0,0,0,,Мен өтіп бара жатқанда
Dialogue: 0,0:07:19.87,0:07:21.54,Default,,0,0,0,,Ол қазірдің өзінде ауырғандықтан құлап қалды.
Dialogue: 0,0:07:22.00,0:07:23.16,Default,,0,0,0,,Ха, ыстық.
Dialogue: 0,0:07:23.62,0:07:25.50,Default,,0,0,0,,Маған салқындататын бірдеңе әкел.
Dialogue: 0,0:07:26.08,0:07:26.62,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:07:27.62,0:07:29.00,Default,,0,0,0,,Әйтеуір алып жүрейік
Dialogue: 0,0:07:29.12,0:07:31.50,Default,,0,0,0,,Иә аааааааааааааааааааааааааааа
Dialogue: 0,0:07:31.58,0:07:31.95,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:32.12,0:07:34.62,Default,,0,0,0,,-  -
Dialogue: 0,0:07:34.83,0:07:37.08,Default,,0,0,0,,Менің басым айналып кетті.
Dialogue: 0,0:07:39.00,0:07:41.04,Default,,0,0,0,,? иә?
Dialogue: 0,0:07:49.70,0:07:51.91,Default,,0,0,0,,Хмм?
Dialogue: 0,0:07:56.95,0:07:57.70,Default,,0,0,0,,Уау
Dialogue: 0,0:07:57.83,0:08:00.25,Default,,0,0,0,,-Бетховен ғана емес, Шуберт те -Ууууууу
Dialogue: 0,0:08:00.79,0:08:03.29,Default,,0,0,0,,-Ештеңеге көп еліктеу керек емес- -Ой, ой
Dialogue: 0,0:08:03.58,0:08:06.25,Default,,0,0,0,,-Екеуміз де Утанае суық тиіп қалдық па деп ойлаймын. -Ой уау.
Dialogue: 0,0:08:06.54,0:08:07.16,Default,,0,0,0,,Жоқ
Dialogue: 0,0:08:07.20,0:08:07.62,Default,,0,0,0,,-А -Иә?
Dialogue: 0,0:08:08.33,0:08:10.08,Default,,0,0,0,,-Бұл суық емес -Уф
Dialogue: 0,0:08:10.50,0:08:11.87,Default,,0,0,0,,- Иә? Сонда не? -Ууууууу
Dialogue: 0,0:08:13.16,0:08:13.87,Default,,0,0,0,,Қарғыс
Dialogue: 0,0:08:14.62,0:08:15.58,Default,,0,0,0,,Қарғыс?
Dialogue: 0,0:08:16.29,0:08:16.66,Default,,0,0,0,,Иә
Dialogue: 0,0:08:18.58,0:08:22.62,Default,,0,0,0,,Ах ха ха ха ха ха ха ха ха ха ха ха
Dialogue: 0,0:08:24.25,0:08:26.58,Default,,0,0,0,,Егер қашып кеткім келгенде—
Dialogue: 0,0:08:27.16,0:08:27.66,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:27.91,0:08:28.45,Default,,0,0,0,,Гаар
Dialogue: 0,0:08:28.50,0:08:30.00,Default,,0,0,0,,-Ауладағы мандарин ағашы -Que
Dialogue: 0,0:08:30.08,0:08:33.66,Default,,0,0,0,,-Хусси тапқан тұқымдар мұқият отырғызылып, өсірілді.
Dialogue: 0,0:08:34.12,0:08:37.16,Default,,0,0,0,,-Мандарин ағашын мен рұқсатсыз алдым деп ашуланады.
Dialogue: 0,0:08:37.66,0:08:40.16,Default,,0,0,0,,-Мынау қарғыс, мынау -Гяаа
Dialogue: 0,0:08:41.33,0:08:43.20,Default,,0,0,0,,Сен Хусси не айтып тұрғанын түсіндің бе?
Dialogue: 0,0:08:43.29,0:08:44.75,Default,,0,0,0,,Менің сенуден басқа амалым жоқ сияқты.
Dialogue: 0,0:08:44.83,0:08:45.75,Default,,0,0,0,,Бұл оңай ма?
Dialogue: 0,0:08:46.58,0:08:47.08,Default,,0,0,0,,Уваааах! Ашылмай жатыр!
Dialogue: 0,0:08:47.70,0:08:48.16,Default,,0,0,0,,- дейін? -Хмм
Dialogue: 0,0:08:48.70,0:08:49.45,Default,,0,0,0,,Gi
Dialogue: 0,0:08:51.87,0:08:53.58,Default,,0,0,0,,Гяааааахх
Dialogue: 0,0:08:54.12,0:08:55.54,Default,,0,0,0,,Бұл түс анық
Dialogue: 0,0:08:56.54,0:08:57.87,Default,,0,0,0,,Миканның қарғысы
Dialogue: 0,0:08:58.25,0:08:58.87,Default,,0,0,0,,Хмм?
Dialogue: 0,0:08:59.20,0:09:00.66,Default,,0,0,0,,Қарғыс сенің кінәң
Dialogue: 0,0:09:01.00,0:09:01.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:01.95,0:09:03.58,Default,,0,0,0,,Дәл қазір болған оқиға рас болса
Dialogue: 0,0:09:04.25,0:09:07.25,Default,,0,0,0,,Себебі, сіз мандаринді алдыңыз.
Dialogue: 0,0:09:07.54,0:09:10.37,Default,,0,0,0,,Мен Утанаенің көңілінен шығуға тырыстым.
Dialogue: 0,0:09:10.83,0:09:13.50,Default,,0,0,0,,Дұрысы, мен оны алдым деп қарғысқа ұшыраған жоқпын.
Dialogue: 0,0:09:13.66,0:09:15.00,Default,,0,0,0,,Аргументтер бір жаққа
Dialogue: 0,0:09:15.33,0:09:18.08,Default,,0,0,0,,Алдымен екеуін не істеу керектігін ойластырған дұрыс емес пе?
Dialogue: 0,0:09:18.50,0:09:19.20,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:19.50,0:09:20.70,Default,,0,0,0,,А, менде бір идея бар.
Dialogue: 0,0:09:20.83,0:09:21.20,Default,,0,0,0,,Ерте
Dialogue: 0,0:09:21.70,0:09:23.04,Default,,0,0,0,,Бұл қарғыс емес пе?
Dialogue: 0,0:09:23.29,0:09:27.83,Default,,0,0,0,,Соны түсінсең, бір ғана жол бар. Аумин.
Dialogue: 0,0:09:28.87,0:09:29.70,Default,,0,0,0,,Жын шығару?
Dialogue: 0,0:09:30.29,0:09:31.45,Default,,0,0,0,,Неге мен?
Dialogue: 0,0:09:32.54,0:09:36.37,Default,,0,0,0,,Эй, эй, сен де.
Dialogue: 0,0:09:36.79,0:09:38.45,Default,,0,0,0,,Иә
Dialogue: 0,0:09:38.62,0:09:40.12,Default,,0,0,0,,Иә
Dialogue: 0,0:09:40.25,0:09:42.50,Default,,0,0,0,,-Уаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:09:42.79,0:09:44.33,Default,,0,0,0,,-Бұл туралы не деуге болады? -Уф
Dialogue: 0,0:09:44.66,0:09:46.29,Default,,0,0,0,,- Зұлым рухтарды қуып жіберіңіз Зұлым рухтарды қуыңыз - Ууууу
Dialogue: 0,0:09:46.33,0:09:49.70,Default,,0,0,0,,-Зұлым рухтарды қуып шығу -- Мен Мотудікі түбегейлі басқаша сезінемін.
Dialogue: 0,0:09:49.83,0:09:51.79,Default,,0,0,0,,-Міне, сен де көп тырыстың -уууууууууууууу
Dialogue: 0,0:09:52.04,0:09:53.08,Default,,0,0,0,,-Неге мен? -Ууууууу
Dialogue: 0,0:09:53.37,0:09:57.41,Default,,0,0,0,,- Иә? Бұл не? -Ууууууууууууууу
Dialogue: 0,0:09:57.66,0:09:58.66,Default,,0,0,0,,-Ол қызықсыз -Ах
Dialogue: 0,0:09:59.00,0:10:00.08,Default,,0,0,0,,- Гета? -Ням ням ням ням
Dialogue: 0,0:10:00.16,0:10:03.62,Default,,0,0,0,,-Бұл көкөністер мен жемістерге жабысатын нәрсе. -Ням ням ням ням ням ням
Dialogue: 0,0:10:04.29,0:10:05.62,Default,,0,0,0,,-Мандариннің қарғысы -Ням ням ням
Dialogue: 0,0:10:05.70,0:10:07.16,Default,,0,0,0,,-Уф, бұл шын! -Нямунямням
Dialogue: 0,0:10:07.20,0:10:09.62,Default,,0,0,0,,-Жақында осы екеуі туралы бірдеңе жасайық.
Dialogue: 0,0:10:09.87,0:10:12.41,Default,,0,0,0,,-Егер -Нямнямнямнямнямнямням
Dialogue: 0,0:10:15.45,0:10:15.95,Default,,0,0,0,,Жарайды
Dialogue: 0,0:10:16.12,0:10:17.95,Default,,0,0,0,,Не? бұл граффити
Dialogue: 0,0:10:18.50,0:10:20.91,Default,,0,0,0,,Бұл граффити емес, бұл сутра.
Dialogue: 0,0:10:21.12,0:10:23.79,Default,,0,0,0,,Халық ертегілерінде сутралар бүкіл денеге жазылады.
Dialogue: 0,0:10:23.83,0:10:26.08,Default,,0,0,0,,Сондай-ақ зұлым рухтарды қуу туралы әңгімелер бар.
Dialogue: 0,0:10:26.25,0:10:27.95,Default,,0,0,0,,Байқауға тұрарлық па?
Dialogue: 0,0:10:28.12,0:10:31.25,Default,,0,0,0,,Ей, ештеңе істемегеннен жақсы шығар.
Dialogue: 0,0:10:31.45,0:10:31.95,Default,,0,0,0,,Ммм
Dialogue: 0,0:10:32.16,0:10:34.87,Default,,0,0,0,,Әйтеуір, осыған біраз уақыт көз жүгіртейік.
Dialogue: 0,0:10:35.12,0:10:37.58,Default,,0,0,0,,Уф, кенет басым айналып кетті.
Dialogue: 0,0:10:37.83,0:10:39.12,Default,,0,0,0,,Кез келген жағдайда, Лист мырза да?
Dialogue: 0,0:10:40.04,0:10:41.66,Default,,0,0,0,,Мен өз бөлмемде біраз жатайын.
Dialogue: 0,0:10:43.37,0:10:44.70,Default,,0,0,0,,Екеумізге қарашы.
Dialogue: 0,0:10:45.20,0:10:45.95,Default,,0,0,0,,Жарайды
Dialogue: 0,0:10:50.79,0:10:54.29,Default,,0,0,0,,- Қызық, мұндай граффити шынымен де жұмыс істейді ме? - Ууууууууууууууууууууууууууу
Dialogue: 0,0:10:55.16,0:10:57.25,Default,,0,0,0,,Хаха, бәрібір жазамын.
Dialogue: 0,0:10:58.33,0:11:03.25,Default,,0,0,0,,Мм, қиналып жүргенде бетім нұрланып кетеді.
Dialogue: 0,0:11:03.66,0:11:04.58,Default,,0,0,0,,Аға
Dialogue: 0,0:11:05.20,0:11:06.87,Default,,0,0,0,,Бұл тағдыр
Dialogue: 0,0:11:06.95,0:11:09.45,Default,,0,0,0,,Бухахаха, сәл күте тұрыңыз
Dialogue: 0,0:11:09.62,0:11:12.91,Default,,0,0,0,,Солай десең де, әй, солай.
Dialogue: 0,0:11:14.04,0:11:17.62,Default,,0,0,0,,Дахахаха аааааааааааааааа
Dialogue: 0,0:11:17.70,0:11:20.70,Default,,0,0,0,,Ааааааааааааааааааааааа
Dialogue: 0,0:11:21.04,0:11:22.45,Default,,0,0,0,,Күлгенім сонша, шөлдеп кеттім.
Dialogue: 0,0:11:44.33,0:11:51.41,Default,,0,0,0,,Хмммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммм
Dialogue: 0,0:11:51.70,0:11:53.37,Default,,0,0,0,,-А-а-а-Не?
Dialogue: 0,0:11:53.66,0:11:55.83,Default,,0,0,0,,Бето-сан мен Шу-сан
Dialogue: 0,0:11:56.12,0:11:56.50,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:12:02.00,0:12:02.75,Default,,0,0,0,,Пухат
Dialogue: 0,0:12:03.00,0:12:04.54,Default,,0,0,0,,Қарғыс жылдамдауда
Dialogue: 0,0:12:05.04,0:12:05.37,Default,,0,0,0,,Эй
Dialogue: 0,0:12:05.45,0:12:05.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:05.83,0:12:07.20,Default,,0,0,0,,Менің шырыным таусылды.
Dialogue: 0,0:12:08.04,0:12:09.25,Default,,0,0,0,,Оны маған біреу сатып ала ала ма?
Dialogue: 0,0:12:09.54,0:12:11.08,Default,,0,0,0,,Жоқ, қазір емес.
Dialogue: 0,0:12:11.25,0:12:13.25,Default,,0,0,0,,Уау, үлкен Микан!
Dialogue: 0,0:12:13.29,0:12:14.87,Default,,0,0,0,,Жоқ, тым жақындамаңыз.
Dialogue: 0,0:12:15.25,0:12:18.20,Default,,0,0,0,,Мен салған бет өте әдемі көрінеді.
Dialogue: 0,0:12:18.37,0:12:19.83,Default,,0,0,0,,Мұны Моту-сан жазды ма?
Dialogue: 0,0:12:20.08,0:12:20.58,Default,,0,0,0,,Өл! Мен сенің төменгі ерініңді тіліп өтемін!
Dialogue: 0,0:12:20.87,0:12:23.37,Default,,0,0,0,,Гррр, неге олай істедің?
Dialogue: 0,0:12:23.79,0:12:25.87,Default,,0,0,0,,Ей, оны аршып алайық.
Dialogue: 0,0:12:25.91,0:12:26.91,Default,,0,0,0,,-Эхехе - А?
Dialogue: 0,0:12:27.00,0:12:27.58,Default,,0,0,0,,-Жоқ, жоқ, -Уау.
Dialogue: 0,0:12:27.66,0:12:30.87,Default,,0,0,0,,-Егер жағдай бұдан да күрделірек болса, не істейсің? -Ой, неге?
Dialogue: 0,0:12:30.95,0:12:31.58,Default,,0,0,0,,Га
Dialogue: 0,0:12:37.45,0:12:37.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:38.20,0:12:42.95,Default,,0,0,0,,-Ааах -Цуцуцуцуннн
Dialogue: 0,0:12:43.83,0:12:46.20,Default,,0,0,0,,Хмм? Бұл не?
Dialogue: 0,0:12:50.62,0:12:54.83,Default,,0,0,0,,Уау? иә?
Dialogue: 0,0:12:55.75,0:12:56.62,Default,,0,0,0,,Хмм?
Dialogue: 0,0:13:01.20,0:13:07.83,Default,,0,0,0,,Ахаха сәлем тағы да сәлем
Dialogue: 0,0:13:08.45,0:13:12.04,Default,,0,0,0,,-Уау!
Dialogue: 0,0:13:12.25,0:13:12.66,Default,,0,0,0,,​​О?
Dialogue: 0,0:13:14.25,0:13:15.37,Default,,0,0,0,,Оу!
Dialogue: 0,0:13:16.29,0:13:16.62,Default,,0,0,0,,Әй
Dialogue: 0,0:13:16.70,0:13:17.12,Default,,0,0,0,,Ах
Dialogue: 0,0:13:17.16,0:13:17.45,Default,,0,0,0,,Сәлем
Dialogue: 0,0:13:17.50,0:13:18.20,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:13:18.62,0:13:21.08,Default,,0,0,0,,Қызықты нәрсе болды.
Dialogue: 0,0:13:21.20,0:13:22.37,Default,,0,0,0,,Мен оны да араластырамын.
Dialogue: 0,0:13:22.66,0:13:23.79,Default,,0,0,0,,Хахахахахахаха
Dialogue: 0,0:13:23.95,0:13:27.00,Default,,0,0,0,,Уау, уахахаха - бұл қызық болатын кез емес.
Dialogue: 0,0:13:27.29,0:13:29.58,Default,,0,0,0,,Ааа, арғ, а, а, Тізім мырза.
Dialogue: 0,0:13:30.66,0:13:35.33,Default,,0,0,0,,Бето мырза мен Шу мырза
Dialogue: 0,0:13:38.91,0:13:39.54,Default,,0,0,0,,Махаббат
Dialogue: 0,0:13:39.62,0:13:41.41,Default,,0,0,0,,Ахх
Dialogue: 0,0:13:41.66,0:13:42.83,Default,,0,0,0,,-Тағдыр- -Ааааааааааааааааааааааа
Dialogue: 0,0:13:43.00,0:13:45.00,Default,,0,0,0,,-Моцусан -сенпай
Dialogue: 0,0:13:45.12,0:13:50.20,Default,,0,0,0,,Сау болыңыз
Dialogue: 0,0:13:50.37,0:13:51.95,Default,,0,0,0,,Ооо, сен қашып барасың ба?
Dialogue: 0,0:13:52.37,0:13:54.04,Default,,0,0,0,,Жоқ, бұл тег.
Dialogue: 0,0:13:55.04,0:13:55.50,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:13:57.87,0:13:58.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:59.79,0:14:00.20,Default,,0,0,0,,Иә
Dialogue: 0,0:14:03.50,0:14:03.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:04.41,0:14:05.95,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:14:06.04,0:14:08.33,Default,,0,0,0,,Мені сонда қалдырмаңыз.
Dialogue: 0,0:14:08.75,0:14:10.83,Default,,0,0,0,,О, махаббат
Dialogue: 0,0:14:11.08,0:14:12.62,Default,,0,0,0,,Тағдыр
Dialogue: 0,0:14:13.37,0:14:14.75,Default,,0,0,0,,Сенпай
Dialogue: 0,0:14:15.04,0:14:17.79,Default,,0,0,0,,-А, а, а, о, келме -Махаббат!
Dialogue: 0,0:14:18.04,0:14:22.50,Default,,0,0,0,,-Әй, ә, ә, ә, ә, ә, ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә , ә ,liğinde
Dialogue: 0,0:14:23.37,0:14:26.04,Default,,0,0,0,,Ааа
Dialogue: 0,0:14:27.00,0:14:28.00,Default,,0,0,0,,Шопен мырза
Dialogue: 0,0:14:28.16,0:14:30.95,Default,,0,0,0,,Сіз маған көмектестіңіз, өйткені мен пайдалы боламын деп ойладыңыз.
Dialogue: 0,0:14:31.29,0:14:32.62,Default,,0,0,0,,Күткендей, көздерің керемет.
Dialogue: 0,0:14:33.20,0:14:35.00,Default,,0,0,0,,Мен адамдарға сене алмаймын
Dialogue: 0,0:14:35.25,0:14:36.41,Default,,0,0,0,,А, мұндай нәрсе.
Dialogue: 0,0:14:36.45,0:14:36.83,Default,,0,0,0,,(Бір күні сені қолға түсіреміз)
Dialogue: 0,0:14:51.87,0:14:53.33,Default,,0,0,0,,Бұл барабан?
Dialogue: 0,0:14:53.79,0:14:55.37,Default,,0,0,0,,Кут Сосуке
Dialogue: 0,0:14:56.00,0:14:58.00,Default,,0,0,0,,Сіз мені тастап кеттіңіз, солай ма?
Dialogue: 0,0:15:03.87,0:15:07.41,Default,,0,0,0,,Иә? Ол мені мүлде қумайды, Му.
Dialogue: 0,0:15:07.54,0:15:08.00,Default,,0,0,0,,Сәлем
Dialogue: 0,0:15:08.45,0:15:11.54,Default,,0,0,0,,Сіз де қалай құтылдыңыз? Ха, бұл таңқаларлық
Dialogue: 0,0:15:12.04,0:15:12.58,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:15:13.20,0:15:18.58,Default,,0,0,0,,Не?
Dialogue: 0,0:15:19.04,0:15:20.37,Default,,0,0,0,,Жауапкершілікті алу керек
Dialogue: 0,0:15:20.58,0:15:20.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:21.58,0:15:22.83,Default,,0,0,0,,Миканның қарғысы
Dialogue: 0,0:15:27.04,0:15:28.83,Default,,0,0,0,,Хмм, бір минут күте аласыз ба?
Dialogue: 0,0:15:29.04,0:15:29.62,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:15:30.45,0:15:34.16,Default,,0,0,0,,Бұл дыбыс бір нәрсені есіме түсіргендей.
Dialogue: 0,0:15:34.79,0:15:38.12,Default,,0,0,0,,Бүгін таңертең дәл солай болды, хмм.
Dialogue: 0,0:15:38.91,0:15:40.50,Default,,0,0,0,,Жоқ, бұл жағдайда қазір.
Dialogue: 0,0:15:40.58,0:15:43.45,Default,,0,0,0,,Ал, бұл туралы бірдеңе істеу керек.
Dialogue: 0,0:15:43.87,0:15:45.29,Default,,0,0,0,,Музыка де Чачат
Dialogue: 0,0:15:45.41,0:15:46.79,Default,,0,0,0,,-Қарғыс сенің кінәң -А
Dialogue: 0,0:15:47.33,0:15:50.54,Default,,0,0,0,,Ай, бұл рас болуы мүмкін, бірақ о
Dialogue: 0,0:15:50.75,0:15:52.16,Default,,0,0,0,,-Жауапкершілікті өз мойнына алу -У
Dialogue: 0,0:15:52.45,0:15:53.50,Default,,0,0,0,,Ум-мей
Dialogue: 0,0:15:53.58,0:15:54.58,Default,,0,0,0,,Сенпай
Dialogue: 0,0:15:54.66,0:15:55.54,Default,,0,0,0,,Махаббат
Dialogue: 0,0:15:56.12,0:16:02.79,Default,,0,0,0,,А, мен түсіндім. Тег ойыны аяқталды.
Dialogue: 0,0:16:03.20,0:16:03.62,Default,,0,0,0,,Ах
Dialogue: 0,0:16:03.79,0:16:04.00,Default,,0,0,0,,Әй
Dialogue: 0,0:16:04.08,0:16:04.62,Default,,0,0,0,,Уф
Dialogue: 0,0:16:07.41,0:16:07.83,Default,,0,0,0,,Не?
Dialogue: 0,0:16:08.70,0:16:11.00,Default,,0,0,0,,-я яия -уууууууууууууууу
Dialogue: 0,0:16:11.12,0:16:13.29,Default,,0,0,0,,Ууууууууууууу
Dialogue: 0,0:16:14.00,0:16:15.79,Default,,0,0,0,,-Гобуууууууууууууууууууууу? мен құстым
Dialogue: 0,0:16:15.87,0:16:21.25,Default,,0,0,0,,Ааааааааааааааааааааааааааа
Dialogue: 0,0:16:21.33,0:16:24.70,Default,,0,0,0,,Ууууууууууу тәтті
Dialogue: 0,0:16:25.08,0:16:27.45,Default,,0,0,0,,Бұл апельсин шырыны ма?
Dialogue: 0,0:16:27.75,0:16:29.87,Default,,0,0,0,,Әй, мен де.
Dialogue: 0,0:16:30.04,0:16:33.08,Default,,0,0,0,,-Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:16:33.25,0:16:37.08,Default,,0,0,0,,-Бұл дәмді. Ааа, не істеп жатырсың? -Оророророророро
Dialogue: 0,0:16:37.12,0:16:39.16,Default,,0,0,0,,- Тағы бір сусын - Жарайды.
Dialogue: 0,0:16:40.00,0:16:42.04,Default,,0,0,0,,Сіздің жауапкершілікті алуға ниетіңіз жоқ.
Dialogue: 0,0:16:42.41,0:16:42.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:42.95,0:16:44.66,Default,,0,0,0,,Қарғыс сенің кінәң шығар.
Dialogue: 0,0:16:45.79,0:16:47.62,Default,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,0:16:48.16,0:16:50.37,Default,,0,0,0,,Мен шырын көп ішкендіктен бақыттымын.
Dialogue: 0,0:16:50.79,0:16:54.75,Default,,0,0,0,,Хмм, жеткілікті, жай ғана қозғалмай, ештеңе істеме.
Dialogue: 0,0:16:56.08,0:16:56.75,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:16:56.91,0:16:57.45,Default,,0,0,0,,Ах
Dialogue: 0,0:17:09.25,0:17:09.87,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:17:10.54,0:17:11.08,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:17:11.58,0:17:12.08,Default,,0,0,0,,О
Dialogue: 0,0:17:13.08,0:17:16.33,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:17:16.79,0:17:17.20,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:17:18.04,0:17:20.95,Default,,0,0,0,,Мен қарғысты тоқтатудың жақсы жолын ойладым.
Dialogue: 0,0:17:21.70,0:17:23.91,Default,,0,0,0,,Сіз Лу мен басқаларды еліктіре аласыз ба?
Dialogue: 0,0:17:26.20,0:17:30.70,Default,,0,0,0,,Kuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuu!
Dialogue: 0,0:17:32.08,0:17:35.33,Default,,0,0,0,,Они-сан, бұл жерде қолдың дыбысы шығады.
Dialogue: 0,0:17:36.37,0:17:40.41,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:17:40.54,0:17:42.87,Default,,0,0,0,,- -
Dialogue: 0,0:17:43.08,0:17:46.20,Default,,0,0,0,,-Аа, мен тыңдамадым. Сіз тым жылдам қозғаласыз. -Сенпай.
Dialogue: 0,0:17:46.50,0:17:51.54,Default,,0,0,0,,Ой-ай, әй, әй, әй!
Dialogue: 0,0:17:52.58,0:17:55.95,Default,,0,0,0,,Жарайды, Лудың от шашушысы.
Dialogue: 0,0:17:57.37,0:17:57.83,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:58.70,0:18:02.58,Default,,0,0,0,,Егер бәрі қалыпты жағдайға оралмаса, кем дегенде грильде пісірілген мандарин апельсинін жеп қойыңыз.
Dialogue: 0,0:18:02.79,0:18:03.12,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:18:03.16,0:18:06.70,Default,,0,0,0,,Күте тұрыңыз, бәрі әлі де қалыпты жағдайға оралуы мүмкін.
Dialogue: 0,0:18:07.00,0:18:09.12,Default,,0,0,0,,Бұл қауіпті! Құтылып кету!
Dialogue: 0,0:18:12.75,0:18:13.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:16.70,0:18:18.91,Default,,0,0,0,,Gehogehogehot attsuttsu
Dialogue: 0,0:18:19.25,0:18:20.87,Default,,0,0,0,,Аа, бір жерде кептеліп қалған сияқты.
Dialogue: 0,0:18:21.50,0:18:24.62,Default,,0,0,0,,Әдеттегідей данышпандардың не істейтінін оқи алмайсың.
Dialogue: 0,0:18:25.00,0:18:25.83,Default,,0,0,0,,Сонымен қатар, Yoshida Productions Яиді Yotsuba-ның талисманы ретінде насихаттап жатыр.
Dialogue: 0,0:18:26.95,0:18:28.37,Default,,0,0,0,,Ммм
Dialogue: 0,0:18:29.16,0:18:30.66,Default,,0,0,0,,Сенпай
Dialogue: 0,0:18:31.16,0:18:32.58,Default,,0,0,0,,Иә
Dialogue: 0,0:18:32.75,0:18:38.75,Default,,0,0,0,,Жоқ, сен өте қорқынышты көрінесің. Ах, ах.
Dialogue: 0,0:18:39.91,0:18:43.66,Default,,0,0,0,,- Сенпай - Айё
Dialogue: 0,0:18:52.16,0:18:54.70,Default,,0,0,0,,Әй, есіме түсті!
Dialogue: 0,0:18:56.91,0:19:01.45,Default,,0,0,0,,Hör mal, meine Musik.
Dialogue: 0,0:19:10.08,0:19:12.91,Default,,0,0,0,,Жалпы - Жалғастырыңыз!
Dialogue: 0,0:19:16.95,0:19:20.79,Default,,0,0,0,,Белгілі бір жемісті қуырып жесеңіз
Dialogue: 0,0:19:21.00,0:19:21.87,Default,,0,0,0,,Музыка
Dialogue: 0,0:19:22.00,0:19:25.70,Default,,0,0,0,,Фортепианолық соната №11 3-бөлім «Түрік маршы»
Dialogue: 0,0:19:26.08,0:19:28.79,Default,,0,0,0,,Моцарт түрік әскери оркестрлерінен шабыт алған
Dialogue: 0,0:19:28.83,0:19:30.66,Default,,0,0,0,,Ол құрастырған дейді
Dialogue: 0,0:19:32.95,0:19:36.83,Default,,0,0,0,,Гриль немесе қуыру табасын дайындаңыз.
Dialogue: 0,0:19:37.04,0:19:39.83,Default,,0,0,0,,Оны айналдырыңыз
Dialogue: 0,0:19:39.87,0:19:44.41,Default,,0,0,0,,Әй, ернің – тыйым салынған жеміс
Dialogue: 0,0:19:45.50,0:19:48.00,Default,,0,0,0,,Дәмін тезірек көргім келеді
Dialogue: 0,0:19:49.75,0:19:55.16,Default,,0,0,0,,Саған деген сезімім күйетіндей ыстық, балқытатындай тәтті.
Dialogue: 0,0:19:56.08,0:20:00.08,Default,,0,0,0,,Иә, қуырылған мандарин апельсиндері сияқты.
Dialogue: 0,0:20:00.95,0:20:06.70,Default,,0,0,0,,Ахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахаха
Dialogue: 0,0:20:06.95,0:20:08.50,Default,,0,0,0,,Мартин тобы
Dialogue: 0,0:20:08.87,0:20:10.91,Default,,0,0,0,,Микан зомби
Dialogue: 0,0:20:11.04,0:20:12.20,Default,,0,0,0,,Наурыз!
Dialogue: 0,0:20:13.37,0:20:14.91,Default,,0,0,0,,Жарылғаннан кейін
Dialogue: 0,0:20:14.95,0:20:16.12,Default,,0,0,0,,Марш оркестрі
Dialogue: 0,0:20:17.00,0:20:18.91,Default,,0,0,0,,Толық қуырыңыз
Dialogue: 0,0:20:19.00,0:20:22.54,Default,,0,0,0,,Бүкіл теріні дәмдеңіз!
Dialogue: 0,0:20:26.62,0:20:29.70,Default,,0,0,0,,-Жоқ, тоқта! Мен Микан болғым келмейді.
Dialogue: 0,0:20:29.83,0:20:31.91,Default,,0,0,0,,-Мен машинамын, сондықтан аааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:20:31.95,0:20:33.33,Default,,0,0,0,,- Ха, қызық болды - Мм.
Dialogue: 0,0:20:33.50,0:20:35.37,Default,,0,0,0,,- Иә? Бұл бұрынғының соңы ма? - Иә
Dialogue: 0,0:20:35.75,0:20:38.37,Default,,0,0,0,,-Иә, есіңе ал, не нәрсеге алаңдадың -Сенпай
Dialogue: 0,0:20:38.41,0:20:39.33,Default,,0,0,0,,-Сергіту -Ммм.
Dialogue: 0,0:20:39.91,0:20:44.20,Default,,0,0,0,,-Сіз маңызды ештеңе шешкен жоқсыз. -Ах.
Dialogue: 0,0:20:44.50,0:20:44.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:45.00,0:20:48.87,Default,,0,0,0,,-Тоқташы, тоқташы, өте жақын, бір сәт... -Сенпай
Dialogue: 0,0:20:51.50,0:20:54.20,Default,,0,0,0,,Не, есіңде ештеңе жоқ па?
Dialogue: 0,0:20:54.62,0:20:55.20,Default,,0,0,0,,-Иә -Иә
Dialogue: 0,0:20:56.04,0:20:59.50,Default,,0,0,0,,Барлығына рахмет, біз кереметпіз. Мен қорқып кеттім.
Dialogue: 0,0:21:00.12,0:21:01.33,Default,,0,0,0,,Айтсаңыз да
Dialogue: 0,0:21:01.83,0:21:03.54,Default,,0,0,0,,Кеш есімде жоқ.
Dialogue: 0,0:21:03.91,0:21:04.50,Default,,0,0,0,,Жоқ
Dialogue: 0,0:21:04.87,0:21:07.87,Default,,0,0,0,,Ей, шабуылдан кейін менің жағдайым қандай?
Dialogue: 0,0:21:08.04,0:21:12.00,Default,,0,0,0,,О, бірдеңе жылтыр.
Dialogue: 0,0:21:12.37,0:21:14.91,Default,,0,0,0,,Дұрыс, мен оянсам
Dialogue: 0,0:21:14.95,0:21:17.37,Default,,0,0,0,,Теріңіз тегіс және толық.
Dialogue: 0,0:21:17.75,0:21:19.37,Default,,0,0,0,,Мен де өзімді тамаша сезінемін
Dialogue: 0,0:21:19.87,0:21:22.50,Default,,0,0,0,,Менің денемнің мазмұны қандай да бір жолмен ауыстырылған сияқты.
Dialogue: 0,0:21:23.25,0:21:25.70,Default,,0,0,0,,Кешегі белгілер қарғыс емес сияқты.
Dialogue: 0,0:21:26.00,0:21:28.16,Default,,0,0,0,,Бұл зат алмасудың бір түрі болған сияқты.
Dialogue: 0,0:21:28.33,0:21:28.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:29.29,0:21:33.08,Default,,0,0,0,,Бұл қуырылған мандарин апельсинінің қабығын жеген классикаоидтармен ғана болды.
Dialogue: 0,0:21:33.45,0:21:35.95,Default,,0,0,0,,Басқаша айтқанда, қуырылған апельсин қабығының ингредиенттері
Dialogue: 0,0:21:36.04,0:21:38.33,Default,,0,0,0,,Классикалоид ағзаға керемет әсер етеді
Dialogue: 0,0:21:38.66,0:21:39.83,Default,,0,0,0,,Детоксикация бөлігі ретінде
Dialogue: 0,0:21:40.00,0:21:44.00,Default,,0,0,0,,Бұл кешегідей ерекше белгілерді тудыруы мүмкін деген болжам бар.
Dialogue: 0,0:21:44.25,0:21:45.54,Default,,0,0,0,,А, мен түсінбеймін.
Dialogue: 0,0:21:45.83,0:21:48.37,Default,,0,0,0,,Қайырлы таң, кешегі күн үшін кешіріңіз.
Dialogue: 0,0:21:48.54,0:21:50.29,Default,,0,0,0,,О? Суығың бітті ме?
Dialogue: 0,0:21:50.54,0:21:53.79,Default,,0,0,0,,Иә, қуырылған мандариннің арқасында мен өзімді сергек сезінемін.
Dialogue: 0,0:21:54.16,0:21:54.37,Default,,0,0,0,,Әй?
Dialogue: 0,0:21:57.91,0:22:00.45,Default,,0,0,0,,Күте тұрыңыз, бұл не? Бето
Dialogue: 0,0:22:00.83,0:22:02.54,Default,,0,0,0,,Бұл мен емес, Қасқыр.
Dialogue: 0,0:22:02.58,0:22:03.20,Default,,0,0,0,,Ммммммм
Dialogue: 0,0:22:03.33,0:22:04.25,Default,,0,0,0,,Моту қайда?
Dialogue: 0,0:22:04.62,0:22:06.00,Default,,0,0,0,,Чоччан туралы айту
Dialogue: 0,0:22:06.33,0:22:08.62,Default,,0,0,0,,Сіз кеше көп нәрсені бұзған сияқтысыз.
Dialogue: 0,0:22:08.91,0:22:11.12,Default,,0,0,0,,Ол қайта қарап, бөлмесіне қамалып жатқан жоқ па?
Dialogue: 0,0:22:11.37,0:22:12.91,Default,,0,0,0,,Бұл тек оған қатысты.
Dialogue: 0,0:22:13.00,0:22:15.16,Default,,0,0,0,,- Yahoo барлығы - Иә? Көрдіңіз бе?
Dialogue: 0,0:22:15.79,0:22:16.75,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:18.66,0:22:20.20,Default,,0,0,0,,Иә? Барлығына не болды?
Dialogue: 0,0:22:20.83,0:22:22.66,Default,,0,0,0,,Менің бетімде бірдеңе бар ма?
Dialogue: 0,0:22:32.41,0:22:34.25,Default,,0,0,0,,Гяаааааа
Dialogue: 0,0:22:45.45,0:22:49.41,Default,,0,0,0,,Белгілі бір жемісті қуырып жесеңіз
Dialogue: 0,0:22:49.45,0:22:52.70,Default,,0,0,0,,Өліп бара жатқан адам қозғала бастайды.
Dialogue: 0,0:22:53.41,0:22:57.25,Default,,0,0,0,,Картонда ұйықтау
Dialogue: 0,0:22:57.50,0:23:01.04,Default,,0,0,0,,Сары қазына
Dialogue: 0,0:23:01.50,0:23:04.58,Default,,0,0,0,,Түркияда да өсіріледі.
Dialogue: 0,0:23:04.79,0:23:07.54,Default,,0,0,0,,Бірақ Хамамацу мамандығы
Dialogue: 0,0:23:09.45,0:23:12.50,Default,,0,0,0,,Білмей тұрып, боялған
Dialogue: 0,0:23:12.75,0:23:15.45,Default,,0,0,0,,Сары қолды байқасаңыз
Dialogue: 0,0:23:15.54,0:23:17.45,Default,,0,0,0,,Мен барабан дыбысын естимін
Dialogue: 0,0:23:17.50,0:23:18.70,Default,,0,0,0,,Марш оркестрі
Dialogue: 0,0:23:19.70,0:23:21.33,Default,,0,0,0,,Микан зомби
Dialogue: 0,0:23:21.45,0:23:22.62,Default,,0,0,0,,наурыз!
Dialogue: 0,0:23:23.87,0:23:25.45,Default,,0,0,0,,Жарылғаннан кейін
Dialogue: 0,0:23:25.50,0:23:26.79,Default,,0,0,0,,Марш оркестрі
Dialogue: 0,0:23:27.54,0:23:29.33,Default,,0,0,0,,Қуырылған
Dialogue: 0,0:23:29.54,0:23:32.83,Default,,0,0,0,,Бүкіл теріні дәмдеңіз!
Dialogue: 0,0:23:33.45,0:23:36.66,Default,,0,0,0,,Дал немесе ащы
Dialogue: 0,0:23:36.79,0:23:39.91,Default,,0,0,0,,Бұл жай ғана қиын.
Dialogue: 0,0:23:40.70,0:23:44.58,Default,,0,0,0,,Мен шындап зомбиге айналып бара жатырмын
Dialogue: 0,0:23:44.75,0:23:49.37,Default,,0,0,0,,Сіз зомбиге айналасыз! !
Dialogue: 0,0:23:49.45,0:23:50.70,Default,,0,0,0,,Марш оркестрі
Dialogue: 0,0:23:51.50,0:23:53.37,Default,,0,0,0,,Микан зомби
Dialogue: 0,0:23:53.50,0:23:54.62,Default,,0,0,0,,наурыз!
Dialogue: 0,0:23:55.45,0:23:57.41,Default,,0,0,0,,Жарылғаннан кейін
Dialogue: 0,0:23:57.50,0:23:58.75,Default,,0,0,0,,Марш оркестрі
Dialogue: 0,0:23:59.20,0:24:01.33,Default,,0,0,0,,Қуырылған
Dialogue: 0,0:24:01.54,0:24:04.87,Default,,0,0,0,,Бүкіл теріні дәмдеңіз!
Dialogue: 0,0:24:07.83,0:24:11.66,Default,,0,0,0,,Әрдайым сұрақ туындайды: Дарындылық дегеніміз не?
Dialogue: 0,0:24:11.91,0:24:16.87,Default,,0,0,0,,Бір шабыт және 99 тер Күш Күш Күш Көбірек күш
Dialogue: 0,0:24:17.12,0:24:21.16,Default,,0,0,0,,Одан да әркімге ашық нұр бар.
Dialogue: 0,0:24:21.54,0:24:23.20,Default,,0,0,0,,Ақшаны үнемдеуге көмектесуге рұқсат етіңіз.
Dialogue: 0,0:24:23.41,0:24:25.20,Default,,0,0,0,,Дарындылық – себепсіз жетістік
Dialogue: 0,0:24:25.45,0:24:29.00,Default,,0,0,0,,Айтылмаған нәтиже, құдай болсаң да, жеңгең жоқ.
Dialogue: 0,0:24:29.25,0:24:31.75,Default,,0,0,0,,Көрінбеген бұқара сахнадан кетуі керек.
Dialogue: 0,0:24:33.25,0:24:39.25,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory