Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:23.79,0:00:25.79,Default,,0,0,0,,Бұл шығады деп ойламаймын.
Dialogue: 0,0:00:26.37,0:00:29.00,Default,,0,0,0,,Жоқ, менің ағам соңғы екі аптадан бері осында болды.
Dialogue: 0,0:00:29.25,0:00:31.87,Default,,0,0,0,,Ол өз бөлмесінде тығылып, тамақ ішпейді.
Dialogue: 0,0:00:32.54,0:00:34.37,Default,,0,0,0,,Бұл менің сүйікті тағамым болса, мен сенімдімін
Dialogue: 0,0:00:34.91,0:00:36.70,Default,,0,0,0,,Мүмкін ол әлдеқашан өлген шығар
Dialogue: 0,0:00:36.83,0:00:38.29,Default,,0,0,0,,Берекелі емес нәрсені айтпа.
Dialogue: 0,0:00:39.04,0:00:42.12,Default,,0,0,0,,Бұл рас, тіпті соңғы рет көргенімде де.
Dialogue: 0,0:00:42.87,0:00:45.79,Default,,0,0,0,,Жоқ, бұл басқа, бірақ, бірақ
Dialogue: 0,0:00:47.08,0:00:47.70,Default,,0,0,0,,Әй?
Dialogue: 0,0:00:51.58,0:00:53.45,Default,,0,0,0,,Мен аздап уайымдап тұрмын.
Dialogue: 0,0:00:54.37,0:00:56.08,Default,,0,0,0,,Бұл мүмкіндік.
Dialogue: 0,0:00:56.83,0:00:59.16,Default,,0,0,0,,Менің еңбегім осында танылса
Dialogue: 0,0:00:59.25,0:01:01.16,Default,,0,0,0,,Шығармалар еліктеу тұшпара.
Dialogue: 0,0:01:01.41,0:01:04.20,Default,,0,0,0,,Еліктеу емес Ешқашан еліктеу
Dialogue: 0,0:01:04.29,0:01:05.25,Default,,0,0,0,,-У-у-у
Dialogue: 0,0:01:05.45,0:01:05.95,Default,,0,0,0,,Ах
Dialogue: 0,0:01:06.83,0:01:10.95,Default,,0,0,0,,-Уау -Бұл қуаныштың айқайы
Dialogue: 0,0:01:11.08,0:01:12.45,Default,,0,0,0,,-Ой -Сіз менің гиозамды қалайтыныңызға сенімдімін.
Dialogue: 0,0:01:12.54,0:01:14.54,Default,,0,0,0,,- Ооо - Сізге ұнағанына сенімдімін.
Dialogue: 0,0:01:14.83,0:01:18.75,Default,,0,0,0,,Гуаааааааааааааааааааааааааааааааа!
Dialogue: 0,0:01:21.29,0:01:22.08,Default,,0,0,0,,Уф
Dialogue: 0,0:01:26.75,0:01:29.12,Default,,0,0,0,,Әртүрлі
Dialogue: 0,0:02:59.50,0:03:03.41,Default,,0,0,0,,Фу Фу Фу
Dialogue: 0,0:03:03.50,0:03:05.45,Default,,0,0,0,,-Сен бір нәрсеге қатты ашуланған сияқтысың. -Уау.
Dialogue: 0,0:03:06.16,0:03:07.95,Default,,0,0,0,,Шу-кунның гиозасы ең жақсы.
Dialogue: 0,0:03:08.04,0:03:09.45,Default,,0,0,0,,Бұл сізге ұнамаған сияқты.
Dialogue: 0,0:03:09.62,0:03:14.12,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ.
Dialogue: 0,0:03:14.33,0:03:16.25,Default,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:03:16.41,0:03:18.62,Default,,0,0,0,,Мен жай ғана бөлмені бұзудан аулақ боламын.
Dialogue: 0,0:03:19.29,0:03:22.54,Default,,0,0,0,,Іші онсыз да лас.
Dialogue: 0,0:03:22.70,0:03:24.91,Default,,0,0,0,,Не істеп жүрсің, Лу?
Dialogue: 0,0:03:28.62,0:03:31.08,Default,,0,0,0,,Мүмкін сіз гитара жасап жатқан шығарсыз?
Dialogue: 0,0:03:31.79,0:03:33.33,Default,,0,0,0,,Сіз гитара жасай аласыз ба?
Dialogue: 0,0:03:33.79,0:03:36.75,Default,,0,0,0,,Барлық музыкалық аспаптар бастапқыда қолдан жасалған.
Dialogue: 0,0:03:37.54,0:03:39.33,Default,,0,0,0,,Бірақ неге Бето қайтадан?
Dialogue: 0,0:03:40.75,0:03:42.20,Default,,0,0,0,,Мен оны ойнап көргім келді.
Dialogue: 0,0:03:43.37,0:03:45.75,Default,,0,0,0,,Бұл шамамен екі апта бұрын болды.
Dialogue: 0,0:03:54.37,0:03:54.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:01.58,0:04:02.58,Default,,0,0,0,,Га
Dialogue: 0,0:04:10.62,0:04:12.75,Default,,0,0,0,,оны өзім ойнағым келді.
Dialogue: 0,0:04:14.00,0:04:16.00,Default,,0,0,0,,Сондықтан оны жасау үшін қиындыққа түсудің қажеті жоқ.
Dialogue: 0,0:04:16.08,0:04:17.25,Default,,0,0,0,,-Жоқ -Сәлем!
Dialogue: 0,0:04:17.54,0:04:19.54,Default,,0,0,0,,Мінсіз орындау үшін тамаша құрал
Dialogue: 0,0:04:20.04,0:04:21.08,Default,,0,0,0,,Мен іздеген дыбыс
Dialogue: 0,0:04:21.45,0:04:24.50,Default,,0,0,0,,Ол жерде сатылатын жартылай пісірілген өнімдердің құны жоқ.
Dialogue: 0,0:04:25.08,0:04:27.83,Default,,0,0,0,,Сондықтан да соңғы кездері қапасқа түсіп қалдың.
Dialogue: 0,0:04:28.16,0:04:30.66,Default,,0,0,0,,Бірақ бәрі ойлағандай болмайды.
Dialogue: 0,0:04:31.20,0:04:33.66,Default,,0,0,0,,Менің қалағаным менің басымда анық болса да
Dialogue: 0,0:04:33.95,0:04:36.75,Default,,0,0,0,,Ол пішін менің көз алдымда көрінбейді.
Dialogue: 0,0:04:37.04,0:04:39.75,Default,,0,0,0,,Эй, Лу, сен енді гиоза жасамайсың ба?
Dialogue: 0,0:04:40.00,0:04:41.70,Default,,0,0,0,,Гиоза? бұл не
Dialogue: 0,0:04:41.79,0:04:44.58,Default,,0,0,0,,Иә? Сіз осындай шу шығардыңыз ба?
Dialogue: 0,0:04:45.04,0:04:47.33,Default,,0,0,0,,Хехехехехехе
Dialogue: 0,0:04:47.37,0:04:49.75,Default,,0,0,0,,-Не, неге кенет күлдің? -Хехехе
Dialogue: 0,0:04:50.37,0:04:53.50,Default,,0,0,0,,Бұл бақытты қарапайым халық түсінбейді.
Dialogue: 0,0:04:53.87,0:04:57.25,Default,,0,0,0,,Мұның кереметі – менің ағамның гитарада ойнауы.
Dialogue: 0,0:04:58.04,0:05:01.33,Default,,0,0,0,,Бұл ұлы данышпан Бетховеннің қойылымын білдіреді
Dialogue: 0,0:05:01.75,0:05:04.12,Default,,0,0,0,,Бұл сіз оны тікелей эфирде ести аласыз дегенді білдіреді.
Dialogue: 0,0:05:05.29,0:05:06.41,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:09.50,0:05:12.33,Default,,0,0,0,,Хэхе, Бето-сан ойнайды.
Dialogue: 0,0:05:12.58,0:05:14.54,Default,,0,0,0,,Сіз музыка ойнайсыз, солай ма?
Dialogue: 0,0:05:14.79,0:05:18.87,Default,,0,0,0,,Егер солай болса, мен де оны пайдаланамын.
Dialogue: 0,0:05:19.08,0:05:20.04,Default,,0,0,0,,Гехо гехо
Dialogue: 0,0:05:21.33,0:05:22.75,Default,,0,0,0,,Көп рахмет Сізге көп рахмет
Dialogue: 0,0:05:26.25,0:05:26.62,Default,,0,0,0,,Сәлем
Dialogue: 0,0:05:27.29,0:05:28.83,Default,,0,0,0,,Гитара қандай жаман
Dialogue: 0,0:05:29.04,0:05:30.29,Default,,0,0,0,,Бұзық болу керек емес
Dialogue: 0,0:05:30.91,0:05:33.87,Default,,0,0,0,,Мен әлі де орташа музыкантпын, солай ма?
Dialogue: 0,0:05:34.45,0:05:35.70,Default,,0,0,0,,Айтуға болады
Dialogue: 0,0:05:36.12,0:05:39.33,Default,,0,0,0,,Ендеше, әлгі музыканттың сынығынан не пайда?
Dialogue: 0,0:05:39.66,0:05:42.45,Default,,0,0,0,,Мен Бетоға гитара жасауға көмектескім келді.
Dialogue: 0,0:05:42.75,0:05:43.79,Default,,0,0,0,,Сосуке?
Dialogue: 0,0:05:43.95,0:05:45.54,Default,,0,0,0,,Әй, бірақ
Dialogue: 0,0:05:45.75,0:05:48.75,Default,,0,0,0,,Ол маған музыка ойнауды да үйретті, мен де музыка ойнауды үйрендім.
Dialogue: 0,0:05:49.00,0:05:51.37,Default,,0,0,0,,-Кя -Мусик
Dialogue: 0,0:05:52.79,0:05:55.00,Default,,0,0,0,,Хехехехехехехе
Dialogue: 0,0:05:55.87,0:05:57.08,Default,,0,0,0,,Неге күлесің?
Dialogue: 0,0:05:57.75,0:06:00.70,Default,,0,0,0,,Мен бәрібір музыка ойнап, қыздарға мазақ болып жүрмін.
Dialogue: 0,0:06:00.75,0:06:02.37,Default,,0,0,0,,Мен өзімді елестетемін
Dialogue: 0,0:06:02.45,0:06:04.08,Default,,0,0,0,,Неге бәрін білмейсің?
Dialogue: 0,0:06:04.41,0:06:05.33,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:05.70,0:06:06.37,Default,,0,0,0,,таяз
Dialogue: 0,0:06:06.62,0:06:07.62,Default,,0,0,0,,О, Бето
Dialogue: 0,0:06:07.83,0:06:08.20,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:06:09.41,0:06:11.83,Default,,0,0,0,,Сенпайым жасауды жалғастырудан шаршады.
Dialogue: 0,0:06:12.58,0:06:14.20,Default,,0,0,0,,Басқаларды немқұрайлы шақырмау
Dialogue: 0,0:06:14.54,0:06:17.41,Default,,0,0,0,,Бірақ бұл гитара жасауға арналған анықтама.
Dialogue: 0,0:06:17.91,0:06:20.87,Default,,0,0,0,,Үлгі болса, жұмыс істеу оңайырақ болар деп ойладым.
Dialogue: 0,0:06:21.37,0:06:21.79,Default,,0,0,0,,Хун
Dialogue: 0,0:06:27.37,0:06:27.87,Default,,0,0,0,,Га
Dialogue: 0,0:06:28.95,0:06:29.33,Default,,0,0,0,,Уф
Dialogue: 0,0:06:30.20,0:06:31.91,Default,,0,0,0,,Уа, бір ән ойнағың келе ме?
Dialogue: 0,0:06:34.58,0:06:35.37,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:35.70,0:06:36.70,Default,,0,0,0,,Қалай ойнау керек
Dialogue: 0,0:06:37.12,0:06:37.70,Default,,0,0,0,,Ах
Dialogue: 0,0:06:38.37,0:06:41.08,Default,,0,0,0,,Мүмкін Бето мүлде ойнай алмайтын шығар?
Dialogue: 0,0:06:41.95,0:06:42.62,Default,,0,0,0,,Бірнеше Титанға кезігіп қалғаның өкінішті, бірақ
Dialogue: 0,0:06:42.91,0:06:44.87,Default,,0,0,0,,Олай болса, гитараға ие болудың қажеті жоқ.
Dialogue: 0,0:06:45.08,0:06:47.12,Default,,0,0,0,,Мен ойнағым келетін нәрсені ойнағым келеді.
Dialogue: 0,0:06:47.25,0:06:48.41,Default,,0,0,0,,Өйткені сен бала емессің
Dialogue: 0,0:06:48.79,0:06:49.41,Default,,0,0,0,,Алдағы Эльдиан бөлімшесі…
Dialogue: 0,0:06:50.04,0:06:51.75,Default,,0,0,0,,Сосын мына Сосуке
Dialogue: 0,0:06:52.25,0:06:55.12,Default,,0,0,0,,Гитара негіздерін жеке оқытайық.
Dialogue: 0,0:06:55.25,0:06:58.66,Default,,0,0,0,,Әй, Ома, сен ағаңа қалай қарайсың?
Dialogue: 0,0:06:58.95,0:07:00.83,Default,,0,0,0,,Кесек үлкен болып шықты.
Dialogue: 0,0:07:01.20,0:07:03.33,Default,,0,0,0,,Себебі менің жеңуім сирек
Dialogue: 0,0:07:03.37,0:07:04.79,Default,,0,0,0,,Мен қызып бара жатырмын.
Dialogue: 0,0:07:05.33,0:07:07.62,Default,,0,0,0,,Иә, иә, дала тыныш.
Dialogue: 0,0:07:08.16,0:07:11.25,Default,,0,0,0,,Ең бастысы Бетоның сезімі. Біз не істеуіміз керек?
Dialogue: 0,0:07:11.83,0:07:14.08,Default,,0,0,0,,Мен спектакль үшін бәрін жасаймын
Dialogue: 0,0:07:14.58,0:07:16.66,Default,,0,0,0,,Хмм, шынымды айтсам жарайды.
Dialogue: 0,0:07:17.16,0:07:18.04,Default,,0,0,0,,Бұл мысал
Dialogue: 0,0:07:18.45,0:07:21.70,Default,,0,0,0,,Ақымақ тәжірибесіз адамнан нұсқау сұрау дегенді білдірсе де.
Dialogue: 0,0:07:21.87,0:07:23.41,Default,,0,0,0,,Сізге бұл сөз керек емес, солай ма?
Dialogue: 0,0:07:24.33,0:07:28.54,Default,,0,0,0,,Жарайды, балам, сабақты бірден бастайық.
Dialogue: 0,0:07:28.66,0:07:31.12,Default,,0,0,0,,О, мен саған сабақ беріп жатырмын.
Dialogue: 0,0:07:51.87,0:07:53.50,Default,,0,0,0,,Жақсы Уау
Dialogue: 0,0:07:53.54,0:07:54.45,Default,,0,0,0,,Не?
Dialogue: 0,0:07:54.62,0:07:56.91,Default,,0,0,0,,Жоқ, бұл да мүлде басқа.
Dialogue: 0,0:07:56.95,0:07:58.58,Default,,0,0,0,,А, бұл менің гитарам.
Dialogue: 0,0:07:58.62,0:08:00.37,Default,,0,0,0,,Бұл тамаша дыбысты шығармайды.
Dialogue: 0,0:08:00.45,0:08:03.83,Default,,0,0,0,,Жоқ, бұл тек гитара жасауға арналған анықтама.
Dialogue: 0,0:08:04.20,0:08:06.00,Default,,0,0,0,,Идеал гитара бұл гитарадан өзгеше.
Dialogue: 0,0:08:06.12,0:08:08.41,Default,,0,0,0,,Жоқ, мен оны біраз уақытқа қарызға аламын.
Dialogue: 0,0:08:08.75,0:08:09.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:09.79,0:08:12.20,Default,,0,0,0,,Мен оны идеалды аспапқа айналдырамын
Dialogue: 0,0:08:12.62,0:08:14.91,Default,,0,0,0,,Өзіңіздің идеалды дыбысты ойнатыңыз
Dialogue: 0,0:08:15.54,0:08:17.58,Default,,0,0,0,,Эй, Бето композитор ғой, солай ма?
Dialogue: 0,0:08:18.12,0:08:20.08,Default,,0,0,0,,Неліктен сіз ойнауға соншалықты ерекшесіз?
Dialogue: 0,0:08:21.58,0:08:22.83,Default,,0,0,0,,Бір нәрсе шу шығарып жатыр
Dialogue: 0,0:08:23.29,0:08:23.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:24.33,0:08:28.33,Default,,0,0,0,,Ойнауды ойласам, жүрегімде бір нәрсе елжіреп кетеді.
Dialogue: 0,0:08:29.20,0:08:30.95,Default,,0,0,0,,Мен бұл нәрсенің не екенін анықтағым келеді.
Dialogue: 0,0:08:31.54,0:08:32.45,Default,,0,0,0,,Не?
Dialogue: 0,0:08:32.54,0:08:34.04,Default,,0,0,0,,-Оны түсінсеңіз, бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:08:34.54,0:08:35.87,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:08:36.37,0:08:36.79,Default,,0,0,0,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:08:37.58,0:08:38.08,Default,,0,0,0,,Сіз оны қалай тапқаныңызды білсем бола ма?
Dialogue: 0,0:08:38.70,0:08:40.50,Default,,0,0,0,,Егер сіз бұл туралы ойлануға тырыссаңыз
Dialogue: 0,0:08:41.25,0:08:43.62,Default,,0,0,0,,Мен өзімді біртүрлі сентиментальды сезінемін.
Dialogue: 0,0:08:44.45,0:08:44.87,Default,,0,0,0,,Ах
Dialogue: 0,0:08:46.12,0:08:48.62,Default,,0,0,0,,Бұл жігіт оны қарызға алды.
Dialogue: 0,0:08:52.75,0:08:54.62,Default,,0,0,0,,Менің ағамның тілегін орындау үшін
Dialogue: 0,0:08:55.04,0:08:57.29,Default,,0,0,0,,Соншалықты төмен нәрсенің жеткілікті болуы мүмкін емес.
Dialogue: 0,0:08:57.54,0:08:57.91,Default,,0,0,0,,Хи хи
Dialogue: 0,0:08:58.00,0:09:01.20,Default,,0,0,0,,Егде жастағы адамдарға жарамды соңғы гитара
Dialogue: 0,0:09:01.25,0:09:01.87,Default,,0,0,0,,Хи хи
Dialogue: 0,0:09:02.70,0:09:05.66,Default,,0,0,0,,Бірақ біз оны қалай аламыз?
Dialogue: 0,0:09:06.20,0:09:08.41,Default,,0,0,0,,Мен не істей аламын?
Dialogue: 0,0:09:10.95,0:09:12.91,Default,,0,0,0,,Эй, сен гитара жасамайсың ба?
Dialogue: 0,0:09:13.16,0:09:16.20,Default,,0,0,0,,Бұған дейін мен бастапқыға бір рет қайтайын деп ойладым.
Dialogue: 0,0:09:19.95,0:09:21.00,Default,,0,0,0,,Мен де сондаймын
Dialogue: 0,0:09:21.16,0:09:23.37,Default,,0,0,0,,Теледидардан көрсетілгендей.
Dialogue: 0,0:09:23.79,0:09:25.95,Default,,0,0,0,,Мен үлкен суретші болғым келеді.
Dialogue: 0,0:09:26.79,0:09:29.87,Default,,0,0,0,,Тестілеуге арналған өз кезеңім
Dialogue: 0,0:09:33.91,0:09:38.00,Default,,0,0,0,,Мен елестетіп, құшағында жүрген дүние
Dialogue: 0,0:09:38.16,0:09:41.70,Default,,0,0,0,,Қазір қозғалуды бастаңыз
Dialogue: 0,0:09:43.37,0:09:44.66,Default,,0,0,0,,Каа көшесі
Dialogue: 0,0:09:45.20,0:09:52.00,Default,,0,0,0,,-Бұл қарапайым нәрсе хобби емес, солай ма? -Түнгі аспанда ойнайтын әуенге сиқырлайық
Dialogue: 0,0:09:54.33,0:09:57.37,Default,,0,0,0,,Бето-сан, сен содан бері тағы тығылып қалған сияқтысың.
Dialogue: 0,0:09:57.87,0:09:59.41,Default,,0,0,0,,Менің ойымша, біз біраз жетістіктерге жеттік.
Dialogue: 0,0:10:01.00,0:10:02.95,Default,,0,0,0,,Чиссу істеп жатырсың ба? Не?
Dialogue: 0,0:10:03.37,0:10:04.58,Default,,0,0,0,,О, жақсы жерде
Dialogue: 0,0:10:05.00,0:10:07.75,Default,,0,0,0,,Мен сіздің гитараңызды баптауды аяқтадым.
Dialogue: 0,0:10:07.87,0:10:09.62,Default,,0,0,0,,А, бұл не?
Dialogue: 0,0:10:09.79,0:10:12.08,Default,,0,0,0,,Хе, тамаша дыбысты алу үшін.
Dialogue: 0,0:10:12.29,0:10:16.79,Default,,0,0,0,,Маған онымен аздап ойнауға рұқсат етілді. Мынаны қараңыз.
Dialogue: 0,0:10:17.83,0:10:21.29,Default,,0,0,0,,-Уау, уау!
Dialogue: 0,0:10:21.91,0:10:25.33,Default,,0,0,0,,Ах ха ха менің гитарам
Dialogue: 0,0:10:25.87,0:10:27.37,Default,,0,0,0,,Құбыжықты ата
Dialogue: 0,0:10:27.62,0:10:30.45,Default,,0,0,0,,Мен ойлаған идеалды формадан алыс болса да.
Dialogue: 0,0:10:30.70,0:10:33.50,Default,,0,0,0,,Көңіл-күйіңізді көтеру үшін жеткілікті сипаттамалар
Dialogue: 0,0:10:33.79,0:10:37.37,Default,,0,0,0,,Осы құбыжықтың көмегімен мен тамаша дыбысты ала аламын.
Dialogue: 0,0:10:37.70,0:10:40.25,Default,,0,0,0,,-Уау Уау Уау -Хахаха Хахахаха
Dialogue: 0,0:10:41.79,0:10:44.16,Default,,0,0,0,,-У-у -Бірдеңе шылым шегеді.
Dialogue: 0,0:10:55.70,0:10:58.58,Default,,0,0,0,,Әй, бұл не болды? Бұл тас қараңғы.
Dialogue: 0,0:10:58.62,0:11:02.00,Default,,0,0,0,,Не болды? Ей, қараңғы, мен көрмеймін.
Dialogue: 0,0:11:06.50,0:11:13.70,Default,,0,0,0,,Мен ештеңе естімеймін, музыкалық өмірім аяқталды
Dialogue: 0,0:11:15.58,0:11:17.45,Default,,0,0,0,,Ай! (Кугисаки) Бұл не өзі?
Dialogue: 0,0:11:18.83,0:11:21.04,Default,,0,0,0,,Сіз қайтадан бірдеңе жасадыңыз.
Dialogue: 0,0:11:21.58,0:11:22.95,Default,,0,0,0,,Мүмкін бұл.
Dialogue: 0,0:11:23.25,0:11:24.66,Default,,0,0,0,,Иә? Гитара?
Dialogue: 0,0:11:25.12,0:11:27.20,Default,,0,0,0,,Менің ойымша, бұл жігіт электр қуатын көп жейді.
Dialogue: 0,0:11:27.33,0:11:30.95,Default,,0,0,0,,Иә? Сізге рахмет, ол енді қараңғы емес.
Dialogue: 0,0:11:31.04,0:11:31.41,Default,,0,0,0,,Уф
Dialogue: 0,0:11:32.70,0:11:34.45,Default,,0,0,0,,Эй Бет, тыңдап тұрсың ба?
Dialogue: 0,0:11:34.62,0:11:35.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:35.29,0:11:37.41,Default,,0,0,0,,Бетоның кесірінен қараңғы дейді.
Dialogue: 0,0:11:37.83,0:11:39.75,Default,,0,0,0,,А, бұл туралы не деуге болады?
Dialogue: 0,0:11:40.04,0:11:41.20,Default,,0,0,0,,Уау
Dialogue: 0,0:11:41.29,0:11:44.08,Default,,0,0,0,,Мәселе бұл емес.
Dialogue: 0,0:11:44.33,0:11:46.08,Default,,0,0,0,,Үй иесі ретінде мен сізге бұйрық беремін.
Dialogue: 0,0:11:46.62,0:11:49.45,Default,,0,0,0,,Әр адамның өміріне қиындық тудыратын музыкалық аспаптарға тыйым салынады.
Dialogue: 0,0:11:50.08,0:11:52.25,Default,,0,0,0,,Алтын сақинаның жанында ойнауға тыйым салу
Dialogue: 0,0:11:52.45,0:11:55.95,Default,,0,0,0,,Уау
Dialogue: 0,0:12:05.29,0:12:06.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:06.87,0:12:09.95,Default,,0,0,0,,Мен бұл гитараға біраз уақыт қараусыз қалдым.
Dialogue: 0,0:12:12.45,0:12:15.29,Default,,0,0,0,,Бұл қорқынышты емес пе? а?
Dialogue: 0,0:12:18.37,0:12:20.29,Default,,0,0,0,,Гитара сайысы?
Dialogue: 0,0:12:21.29,0:12:24.29,Default,,0,0,0,,Croquis жеңімпазға арналған өнім ретінде?
Dialogue: 0,0:12:24.54,0:12:28.45,Default,,0,0,0,,Ах, электр гитара Croquis.
Dialogue: 0,0:12:29.20,0:12:30.37,Default,,0,0,0,,Іздеу нәтижелері
Dialogue: 0,0:12:30.87,0:12:33.12,Default,,0,0,0,,Керемет премиум гитараға ұқсайды
Dialogue: 0,0:12:33.33,0:12:35.29,Default,,0,0,0,,Сосуке тым көп пе?
Dialogue: 0,0:12:35.41,0:12:38.66,Default,,0,0,0,,Шулы. Аа, нарықтық баға.
Dialogue: 0,0:12:39.08,0:12:46.66,Default,,0,0,0,,1 10 100 Иә, иә, хихе
Dialogue: 0,0:12:53.41,0:13:00.79,Default,,0,0,0,,Мен ештеңе естімеймін. Бұл не болды?
Dialogue: 0,0:13:03.08,0:13:06.70,Default,,0,0,0,,Әй, музыкаға тыйым салынған деу артық емес пе?
Dialogue: 0,0:13:06.95,0:13:09.79,Default,,0,0,0,,Бұл жақсы. Мен бұл туралы Бетоға айтуым керек.
Dialogue: 0,0:13:10.66,0:13:11.29,Default,,0,0,0,,Бето
Dialogue: 0,0:13:11.50,0:13:13.70,Default,,0,0,0,,Жоқ, жоқ, ол әлі мұздатылған.
Dialogue: 0,0:13:13.95,0:13:17.08,Default,,0,0,0,,Иә? Эй Бето, бұл жағдайда
Dialogue: 0,0:13:17.12,0:13:18.75,Default,,0,0,0,,-Бұл не? -Ах!
Dialogue: 0,0:13:19.16,0:13:21.45,Default,,0,0,0,,Иә? Бала, саған бірдеңе керек пе?
Dialogue: 0,0:13:21.58,0:13:23.54,Default,,0,0,0,,Бұл бір нәрсе үшін емес пе?
Dialogue: 0,0:13:23.91,0:13:25.79,Default,,0,0,0,,А, эй, орнына мынаны қараңыз.
Dialogue: 0,0:13:26.12,0:13:27.41,Default,,0,0,0,,Иә? Хаха
Dialogue: 0,0:13:27.95,0:13:31.79,Default,,0,0,0,,Данышпан музыкант күткендей, ол ненің жақсы екенін біледі.
Dialogue: 0,0:13:32.29,0:13:33.75,Default,,0,0,0,,Бұл кровиз деп аталады
Dialogue: 0,0:13:34.08,0:13:36.00,Default,,0,0,0,,Өте әйгілі және сирек шедевр.
Dialogue: 0,0:13:36.12,0:13:39.70,Default,,0,0,0,,О, бұл менің идеалды гитарам болуы мүмкін.
Dialogue: 0,0:13:40.37,0:13:41.83,Default,,0,0,0,,Сіз бұл жігітті ойнағыңыз келеді.
Dialogue: 0,0:13:42.08,0:13:42.58,Default,,0,0,0,,Әрине
Dialogue: 0,0:13:43.04,0:13:46.62,Default,,0,0,0,,Мұны алудың жақсы жолы бар.
Dialogue: 0,0:13:54.16,0:13:56.66,Default,,0,0,0,,-Куккуккуккуккуку - Эй сәл.
Dialogue: 0,0:13:57.00,0:13:59.16,Default,,0,0,0,,Маған өнер көрсетуге ешкім рұқсат берген жоқ.
Dialogue: 0,0:13:59.50,0:14:00.95,Default,,0,0,0,,Қалғандар да дәл қазір барын салып еңбек етіп жатқан болар.
Dialogue: 0,0:14:01.45,0:14:05.12,Default,,0,0,0,,Ендеше, алдымен осы затты сайыста ойнауға болатындай етіп өзгертейік.
Dialogue: 0,0:14:05.45,0:14:07.33,Default,,0,0,0,,Сіз Бетоны қатысуға шындап жоспарлап отырсыз ба?
Dialogue: 0,0:14:07.70,0:14:08.50,Default,,0,0,0,,Әрине
Dialogue: 0,0:14:09.08,0:14:11.91,Default,,0,0,0,,Осылай шыққан менің гитарамның орнына
Dialogue: 0,0:14:12.04,0:14:13.70,Default,,0,0,0,,Ах, жүлделі гитара.
Dialogue: 0,0:14:14.04,0:14:16.75,Default,,0,0,0,,Қанша ойнай алсаң, қалғанын балаға беремін.
Dialogue: 0,0:14:17.25,0:14:19.58,Default,,0,0,0,,Неліктен сіз жеңесіз деп есептеледі?
Dialogue: 0,0:14:19.66,0:14:22.50,Default,,0,0,0,,-Қызықты көрінеді. Мені де қосыңызшы. -Ах!
Dialogue: 0,0:14:22.70,0:14:24.83,Default,,0,0,0,,Аа, ынтымақтастыққа қуаныштымыз.
Dialogue: 0,0:14:24.95,0:14:26.54,Default,,0,0,0,,Модификация қызықты көрінеді
Dialogue: 0,0:14:26.62,0:14:27.83,Default,,0,0,0,,Махаббат, Чо-чан
Dialogue: 0,0:14:27.95,0:14:29.75,Default,,0,0,0,,Баршаңызға рахмет
Dialogue: 0,0:14:30.75,0:14:31.41,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:14:34.79,0:14:37.04,Default,,0,0,0,,Бетховен мысалдағы гитара байқауына қатысты.
Dialogue: 0,0:14:37.08,0:14:38.37,Default,,0,0,0,,Мен енгіздім.
Dialogue: 0,0:14:39.25,0:14:41.58,Default,,0,0,0,,Біздің өткізіп жатқанымызды білгеніңіз қызық емес пе?
Dialogue: 0,0:14:41.62,0:14:43.70,Default,,0,0,0,,Мен Чайко-чанмен сөйлестім.
Dialogue: 0,0:14:44.33,0:14:45.29,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:14:48.16,0:14:52.29,Default,,0,0,0,,Гунунунуну Уау
Dialogue: 0,0:14:52.33,0:14:55.70,Default,,0,0,0,,-Не болды? Менің ойымша, бұл өте жақсы көрінеді -Нунунну
Dialogue: 0,0:14:56.00,0:14:58.29,Default,,0,0,0,,Не? Бұл не?
Dialogue: 0,0:14:58.50,0:15:02.62,Default,,0,0,0,,Ахаха Мен әркімнің пікірін көбірек енгізсем ғой.
Dialogue: 0,0:15:03.12,0:15:04.45,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:15:04.75,0:15:05.83,Default,,0,0,0,,Ал, оны ұстап тұрыңыз.
Dialogue: 0,0:15:06.08,0:15:06.83,Default,,0,0,0,,Оның серіктерінің ешқайсысы тағы бір Стэнд бар екенін байқамады
Dialogue: 0,0:15:07.54,0:15:10.75,Default,,0,0,0,,Бұл сыбдыр, кеудемді тереңдете жатқан ауруға ұқсайды
Dialogue: 0,0:15:11.04,0:15:11.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:11.75,0:15:14.50,Default,,0,0,0,,Уау, мен гитара жасауға көңіл бөле алмай уайымдап отырмын.
Dialogue: 0,0:15:14.66,0:15:17.04,Default,,0,0,0,,Иә, сіз гитара жасау туралы айтып тұрған жоқсыз ба?
Dialogue: 0,0:15:17.29,0:15:19.12,Default,,0,0,0,,Мен білмеймін, білмеймін
Dialogue: 0,0:15:19.91,0:15:22.37,Default,,0,0,0,,Мені жұтып қоятын бұл сентименталды көңіл-күй
Dialogue: 0,0:15:22.66,0:15:26.04,Default,,0,0,0,,Олар қай жақтан шабуыл жасайды?
Dialogue: 0,0:15:26.62,0:15:27.16,Default,,0,0,0,,Лу мырза?
Dialogue: 0,0:15:27.45,0:15:28.50,Default,,0,0,0,,Осы жолы сен жұмсаған күшіңе сай нәтижеге қол жеткіздің—
Dialogue: 0,0:15:28.58,0:15:29.12,Default,,0,0,0,,Ә? Әйтеуір, ол Мисаға қатты ғашық қой.
Dialogue: 0,0:15:30.75,0:15:32.54,Default,,0,0,0,,Не болды, Бето?
Dialogue: 0,0:15:37.37,0:15:40.58,Default,,0,0,0,,Мен нені іздеп жүрмін?
Dialogue: 0,0:15:42.12,0:15:46.37,Default,,0,0,0,,Ал мынау кеудемді терең қазып жатқан не?
Dialogue: 0,0:15:47.41,0:15:55.50,Default,,0,0,0,,А, мен қазір ештеңе көрмеймін.
Dialogue: 0,0:16:01.04,0:16:01.41,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:05.75,0:16:12.25,Default,,0,0,0,,Түнгі аспанда ойнаған әуенге сиқырлайық
Dialogue: 0,0:16:12.62,0:16:16.50,Default,,0,0,0,,-Ән айту мен ойнауды ешқашан керемет деп айту мүмкін емес -Тіпті жұлдыздарда да
Dialogue: 0,0:16:17.12,0:16:19.91,Default,,0,0,0,,-Бірақ бұл неліктен -сонша, мен ұтыла алмаймын
Dialogue: 0,0:16:20.54,0:16:26.54,Default,,0,0,0,,-Жарқыра алатындықтан, орындалатынына сеніңіз -Ха!
Dialogue: 0,0:16:27.29,0:16:29.37,Default,,0,0,0,,Хиро Хитоми...
Dialogue: 0,0:16:38.16,0:16:39.75,Default,,0,0,0,,Фааа
Dialogue: 0,0:16:41.33,0:16:43.16,Default,,0,0,0,,Ол келмейді, Бетховен.
Dialogue: 0,0:16:43.54,0:16:46.75,Default,,0,0,0,,Жазбаны тапсырғаныма қарамастан, мен дисквалификациялансам ше?
Dialogue: 0,0:16:46.83,0:16:48.12,Default,,0,0,0,,Менің бұрынғы жігітім де, балаларым да жоқ.
Dialogue: 0,0:16:48.37,0:16:48.75,Default,,0,0,0,,Ах
Dialogue: 0,0:16:50.00,0:16:50.66,Default,,0,0,0,,Қайтып келдіңіз бе?
Dialogue: 0,0:16:51.08,0:16:53.33,Default,,0,0,0,,Жоқ, мен кеше кеттім.
Dialogue: 0,0:16:54.25,0:16:56.58,Default,,0,0,0,,Мен сізді тікелей осы жерге барады деп ойладым.
Dialogue: 0,0:16:57.33,0:17:00.25,Default,,0,0,0,,-28 нөмір, күтіңіз. -А
Dialogue: 0,0:17:00.37,0:17:01.79,Default,,0,0,0,,Бұл Бето-сан.
Dialogue: 0,0:17:02.08,0:17:03.83,Default,,0,0,0,,Сіз жоқсыз ба? Сен жоқ болсаң
Dialogue: 0,0:17:03.87,0:17:04.87,Default,,0,0,0,,Бұл қалыс қалу болып саналады.
Dialogue: 0,0:17:04.95,0:17:06.20,Default,,0,0,0,,А, жоқ, жоқ, жоқ.
Dialogue: 0,0:17:06.45,0:17:07.62,Default,,0,0,0,,Сіз 28 нөмірсіз бе?
Dialogue: 0,0:17:07.66,0:17:10.04,Default,,0,0,0,,А, жоқ, бұл серігі.
Dialogue: 0,0:17:10.45,0:17:11.54,Default,,0,0,0,,Сонымен, қарастырылып отырған адам
Dialogue: 0,0:17:11.83,0:17:13.25,Default,,0,0,0,,бұл
Dialogue: 0,0:17:13.50,0:17:14.58,Default,,0,0,0,,Міне, мен болар едім
Dialogue: 0,0:17:14.70,0:17:15.04,Default,,0,0,0,,Ах
Dialogue: 0,0:17:16.16,0:17:17.41,Default,,0,0,0,,Бето
Dialogue: 0,0:17:17.75,0:17:20.41,Default,,0,0,0,,Егер бар болса, дереу күтіңіз.
Dialogue: 0,0:17:20.62,0:17:23.08,Default,,0,0,0,,Енді уайымдамаңыз
Dialogue: 0,0:17:25.20,0:17:25.58,Default,,0,0,0,,Иә
Dialogue: 0,0:17:26.95,0:17:29.70,Default,,0,0,0,,Зейінді, мені қалдыр
Dialogue: 0,0:17:31.00,0:17:31.83,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:17:33.16,0:17:35.58,Default,,0,0,0,,Олай болса, келесі 28 саны.
Dialogue: 0,0:17:36.25,0:17:37.00,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:17:39.29,0:17:41.29,Default,,0,0,0,,Қараңызшы, бұл таңқаларлық
Dialogue: 0,0:17:42.12,0:17:43.62,Default,,0,0,0,,Бұл қандай гитара?
Dialogue: 0,0:17:43.66,0:17:44.29,Default,,0,0,0,,...
Dialogue: 0,0:17:44.33,0:17:45.75,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:18:01.33,0:18:02.00,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:18:02.45,0:18:03.50,Default,,0,0,0,,Алайда, құстарда ауа қапшықтары деп аталатын құрылымдар да бар—
Dialogue: 0,0:18:03.79,0:18:04.45,Default,,0,0,0,,Электр қуатын өшіру?
Dialogue: 0,0:18:06.08,0:18:07.91,Default,,0,0,0,,Мұнда не болып жатыр?
Dialogue: 0,0:18:08.00,0:18:10.00,Default,,0,0,0,,Токсыз дыбыс жоқ, солай ма?
Dialogue: 0,0:18:26.37,0:18:32.00,Default,,0,0,0,,Мен ештеңе естімеймін, құлағыма ештеңе естілмейді
Dialogue: 0,0:18:33.83,0:18:40.08,Default,,0,0,0,,Бұл менің тағдырым. Болашақ қараңғылықтан тыс.
Dialogue: 0,0:18:44.70,0:18:45.41,Default,,0,0,0,,Қараңғылық
Dialogue: 0,0:18:55.37,0:19:01.66,Default,,0,0,0,,Жоқ, әлі жоқ. Орындай алмасам да, ән шығарамын.
Dialogue: 0,0:19:02.00,0:19:06.00,Default,,0,0,0,,Мен композитор ретінде әлемге бірдеңе қалдыра аламын.
Dialogue: 0,0:19:06.45,0:19:08.20,Default,,0,0,0,,Жаңа жолға шығыңыз
Dialogue: 0,0:19:09.58,0:19:11.95,Default,,0,0,0,,Орындаушы болу даңқын тәрк ету
Dialogue: 0,0:19:20.20,0:19:25.29,Default,,0,0,0,,Уф, ішімде бірдеңе кеудемде дірілдеп тұр.
Dialogue: 0,0:19:25.95,0:19:30.50,Default,,0,0,0,,Баяғыда болашақ қараңғылықтан тыс жерленген?
Dialogue: 0,0:19:31.58,0:19:39.04,Default,,0,0,0,,Музыка ойнау.
Dialogue: 0,0:19:45.00,0:19:48.12,Default,,0,0,0,,Уау
Dialogue: 0,0:19:51.25,0:19:51.83,Default,,0,0,0,,Ах
Dialogue: 0,0:19:53.08,0:19:53.83,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:19:54.08,0:19:55.95,Default,,0,0,0,,Музыка осында!
Dialogue: 0,0:19:56.33,0:20:00.95,Default,,0,0,0,,Жаңа жолды нұрландырған әуен – менің жаным.
Dialogue: 0,0:20:02.62,0:20:04.20,Default,,0,0,0,,Кел, балақай
Dialogue: 0,0:20:06.45,0:20:10.04,Default,,0,0,0,,Қараңғы түнде бір жұлдыз
Dialogue: 0,0:20:10.20,0:20:13.79,Default,,0,0,0,,Бұл өткінші жарық, бірақ
Dialogue: 0,0:20:14.12,0:20:17.83,Default,,0,0,0,,-Ертеңгі белгі -Кя
Dialogue: 0,0:20:18.87,0:20:21.33,Default,,0,0,0,,-Болашақты көрейік -Кя
Dialogue: 0,0:20:21.41,0:20:24.25,Default,,0,0,0,,- Кя - Скрипка соната №9 «Кройцер»
Dialogue: 0,0:20:24.29,0:20:24.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:25.41,0:20:27.75,Default,,0,0,0,,Музыкант Бетховен есту қабілетінен зардап шекті.
Dialogue: 0,0:20:27.79,0:20:31.58,Default,,0,0,0,,Шамамен мен орындаушылық мансабымды тастап, композиторлыққа толықтай бет бұрдым.
Dialogue: 0,0:20:31.62,0:20:33.45,Default,,0,0,0,,Бұл менің жазған әндерімнің бірі.
Dialogue: 0,0:20:33.91,0:20:34.20,Default,,0,0,0,,Ах
Dialogue: 0,0:20:34.33,0:20:36.04,Default,,0,0,0,,Алты ішекті қару
Dialogue: 0,0:20:36.33,0:20:38.16,Default,,0,0,0,,Егер сіз шуылдасаңыз
Dialogue: 0,0:20:38.33,0:20:40.50,Default,,0,0,0,,-Әлем соғысып жатыр -Бето
Dialogue: 0,0:20:40.70,0:20:44.08,Default,,0,0,0,,Мен құбыжықпын
Dialogue: 0,0:20:45.66,0:20:50.16,Default,,0,0,0,,Осы әуенмен қараңғылықты ашамын
Dialogue: 0,0:20:50.45,0:20:51.91,Default,,0,0,0,,Тыныштықты кесіп өту
Dialogue: 0,0:20:52.00,0:20:53.12,Default,,0,0,0,,Мен саған қаншама рет айттым…
Dialogue: 0,0:20:53.16,0:20:54.66,Default,,0,0,0,,Қарсы тұруға болатын қылыш
Dialogue: 0,0:20:54.83,0:20:55.45,Default,,0,0,0,,Ах
Dialogue: 0,0:20:55.66,0:20:58.50,Default,,0,0,0,,Бұл менің қолымда болды.
Dialogue: 0,0:21:04.95,0:21:06.45,Default,,0,0,0,,Мен саған қаншама рет айттым…
Dialogue: 0,0:21:07.00,0:21:10.29,Default,,0,0,0,,Жарық енді осы кеудеде
Dialogue: 0,0:21:13.87,0:21:14.87,Default,,0,0,0,,Сәлем Бето
Dialogue: 0,0:21:15.50,0:21:15.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:16.37,0:21:18.08,Default,,0,0,0,,Жоқ, қанша?
Dialogue: 0,0:21:18.58,0:21:22.00,Default,,0,0,0,,Бәріне қарамастан, мен керемет композитор болдым.
Dialogue: 0,0:21:22.20,0:21:23.08,Default,,0,0,0,,Жақсы болды ма?
Dialogue: 0,0:21:23.70,0:21:27.16,Default,,0,0,0,,Өмір жақсы аяқталса, бәрі жақсы, солай ма?
Dialogue: 0,0:21:28.16,0:21:29.83,Default,,0,0,0,,Кімнің өмірі аяқталды?
Dialogue: 0,0:21:30.20,0:21:30.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:32.16,0:21:34.54,Default,,0,0,0,,Өткен – өткен, қазір – қазір
Dialogue: 0,0:21:35.79,0:21:39.50,Default,,0,0,0,,Мен әлі жаңа туған баламын, иә?
Dialogue: 0,0:21:40.25,0:21:43.91,Default,,0,0,0,,Хахаха, енді саған бәрібір.
Dialogue: 0,0:21:45.87,0:21:48.91,Default,,0,0,0,,О, не?
Dialogue: 0,0:21:49.75,0:21:52.54,Default,,0,0,0,,Сенің бір парасаттылығыңның арқасында жарық көрдім.
Dialogue: 0,0:21:53.45,0:21:54.29,Default,,0,0,0,,Сол үшін рахмет.
Dialogue: 0,0:21:56.33,0:21:58.70,Default,,0,0,0,,А-а, мынау
Dialogue: 0,0:21:59.54,0:22:03.00,Default,,0,0,0,,Ей, сыйлық гитарасы маған беріледі.
Dialogue: 0,0:22:03.29,0:22:07.75,Default,,0,0,0,,Иә? Олар маған осы біртүрлі гитараны қайтарып берсе де
Dialogue: 0,0:22:08.16,0:22:11.58,Default,,0,0,0,,Музыка аспапты да, техниканы да қажет етпейді.
Dialogue: 0,0:22:12.91,0:22:16.33,Default,,0,0,0,,көремін. Қысқасы, бұл талант.
Dialogue: 0,0:22:16.62,0:22:19.58,Default,,0,0,0,,Wow toto achi achi
Dialogue: 0,0:22:21.54,0:22:22.16,Default,,0,0,0,,Аға
Dialogue: 0,0:22:22.62,0:22:22.95,Default,,0,0,0,,Ах
Dialogue: 0,0:22:25.75,0:22:29.00,Default,,0,0,0,,Мен идеалды гитара жоғары сапалы материалдарды қажет етеді деп есептеймін.
Dialogue: 0,0:22:29.25,0:22:31.66,Default,,0,0,0,,Бұл Шуберт Кубаға барды.
Dialogue: 0,0:22:32.00,0:22:34.95,Default,,0,0,0,,Енді сіз идеалды гитараңызды идеал гитарамен ойнай аласыз.
Dialogue: 0,0:22:35.04,0:22:36.58,Default,,0,0,0,,Спектакль аяқталды
Dialogue: 0,0:22:46.37,0:22:46.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:56.66,0:23:00.33,Default,,0,0,0,,Қараңғы түнде бір жұлдыз
Dialogue: 0,0:23:00.45,0:23:04.16,Default,,0,0,0,,Бұл өткінші жарық, бірақ
Dialogue: 0,0:23:04.33,0:23:08.04,Default,,0,0,0,,Ертеңгі жол белгісі
Dialogue: 0,0:23:11.04,0:23:13.45,Default,,0,0,0,,Енді, болашақ
Dialogue: 0,0:23:14.04,0:23:17.29,Default,,0,0,0,,Есікті ашыңыз~
Dialogue: 0,0:23:17.79,0:23:19.75,Default,,0,0,0,,Үмітсіз күй
Dialogue: 0,0:23:19.79,0:23:21.00,Default,,0,0,0,,Шығу
Dialogue: 0,0:23:22.58,0:23:24.91,Default,,0,0,0,,Мен жандандым
Dialogue: 0,0:23:26.41,0:23:28.08,Default,,0,0,0,,Алты ішекті қару
Dialogue: 0,0:23:28.41,0:23:30.37,Default,,0,0,0,,Егер сіз оны шертсеңіз
Dialogue: 0,0:23:30.54,0:23:32.50,Default,,0,0,0,,Дүниеде соғыс жүріп жатыр
Dialogue: 0,0:23:32.66,0:23:36.12,Default,,0,0,0,,Мен құбыжықпын
Dialogue: 0,0:23:37.70,0:23:41.08,Default,,0,0,0,,Мұнара қабырғасының арғы жағында
Dialogue: 0,0:23:41.54,0:23:45.00,Default,,0,0,0,,Белгісіз жол болуы керек
Dialogue: 0,0:23:45.45,0:23:47.54,Default,,0,0,0,,Онсыз да, бәрібір
Dialogue: 0,0:23:47.66,0:23:48.87,Default,,0,0,0,,Оны жойыңыз
Dialogue: 0,0:23:49.04,0:23:49.79,Default,,0,0,0,,Сыртта ма, іште ме? Жоғары ма, төмен бе?
Dialogue: 0,0:23:49.95,0:23:50.58,Default,,0,0,0,,Цвей
Dialogue: 0,0:23:50.91,0:23:51.83,Default,,0,0,0,,Құрғақ
Dialogue: 0,0:23:52.33,0:23:55.16,Default,,0,0,0,,Көтерілген соққыға
Dialogue: 0,0:23:55.33,0:23:58.29,Default,,0,0,0,,Өмірімізді қатерге тігіп, билейік
Dialogue: 0,0:24:01.00,0:24:02.83,Default,,0,0,0,,Жеңілмейтін сиқырлы күш
Dialogue: 0,0:24:02.95,0:24:04.16,Default,,0,0,0,,Сіз қалғанша
Dialogue: 0,0:24:12.54,0:24:16.00,Default,,0,0,0,,Жарық енді осы кеудеде
Dialogue: 0,0:24:19.37,0:24:21.16,Default,,0,0,0,,Шопен Чотчан Окамори-сан
Dialogue: 0,0:24:21.29,0:24:22.95,Default,,0,0,0,,Жыламау, жоқтау заң емес пе?
Dialogue: 0,0:24:23.08,0:24:26.16,Default,,0,0,0,,Өмірде тек қоштасулар бар. Қоштасу қанша болса, сонша махаббат бар.
Dialogue: 0,0:24:26.29,0:24:29.58,Default,,0,0,0,,Қоштасу қанша болса, сонша ән бар. Қоштасу әуеніне тоқталайық.
Dialogue: 0,0:24:29.79,0:24:31.62,Default,,0,0,0,,Махаббат әуені шырқала берсін
Dialogue: 0,0:24:33.12,0:24:39.12,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory