Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.12,0:00:15.70,Default,,0,0,0,,Иә, бұл өтірік.
Dialogue: 0,0:00:15.79,0:00:19.33,Default,,0,0,0,,Е, сүт, қоқыс дорбасы, әлі күріш бар.
Dialogue: 0,0:00:19.91,0:00:21.04,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:00:21.29,0:00:22.58,Default,,0,0,0,,Иә? Иә?
Dialogue: 0,0:00:28.45,0:00:28.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:29.16,0:00:32.29,Default,,0,0,0,,Еріту дегеніміз не? Мен енді жақсы емеспін
Dialogue: 0,0:00:32.45,0:00:34.95,Default,,0,0,0,,Мен енді өмірімде нені күтуім керек?
Dialogue: 0,0:00:35.04,0:00:36.33,Default,,0,0,0,,-Хаха -Иә?
Dialogue: 0,0:00:36.62,0:00:39.70,Default,,0,0,0,,Мүмкін, бұл екеуі.
Dialogue: 0,0:00:40.62,0:00:42.45,Default,,0,0,0,,Тіпті күні кешегі қыздардың түнінде де.
Dialogue: 0,0:00:42.91,0:00:45.12,Default,,0,0,0,,Біз өте қатал сөйлестік.
Dialogue: 0,0:00:46.25,0:00:47.33,Default,,0,0,0,,Саңырауқұлақ
Dialogue: 0,0:00:47.79,0:00:51.87,Default,,0,0,0,,Қолыңызда пышақ пайдаланып жатқаныңызды байқадыңыз ба?
Dialogue: 0,0:00:52.20,0:00:53.83,Default,,0,0,0,,Бәлкім, бәрі осы шығар.
Dialogue: 0,0:00:53.91,0:00:56.25,Default,,0,0,0,,Интернеттегі іздеулер саны күрт өсті
Dialogue: 0,0:00:56.29,0:00:59.12,Default,,0,0,0,,Дегенмен, әзірге ресми түсініктеме жоқ.
Dialogue: 0,0:00:59.29,0:01:00.83,Default,,0,0,0,,Сонда әлі де үміт бар.
Dialogue: 0,0:01:01.04,0:01:02.29,Default,,0,0,0,,Уақыт келді емес пе?
Dialogue: 0,0:01:02.54,0:01:04.91,Default,,0,0,0,,Жақында ресми хабарландыру шығады, солай ма?
Dialogue: 0,0:01:05.04,0:01:08.00,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:01:08.66,0:01:11.54,Default,,0,0,0,,Өмір бос емес, оны ұмыт.
Dialogue: 0,0:01:11.79,0:01:12.58,Default,,0,0,0,,Сергіту
Dialogue: 0,0:01:12.70,0:01:13.58,Default,,0,0,0,,Қазірдің өзінде?
Dialogue: 0,0:01:13.95,0:01:15.87,Default,,0,0,0,,Бірақ мұндай нәрсе
Dialogue: 0,0:01:16.37,0:01:19.08,Default,,0,0,0,,Бұл жай ғана өсек немесе өтірік емес пе?
Dialogue: 0,0:01:19.41,0:01:22.04,Default,,0,0,0,,Дұрыс. Біз тіпті таныс емеспіз, солай ма?
Dialogue: 0,0:01:22.20,0:01:25.79,Default,,0,0,0,,Бұл қайсысы?
Dialogue: 0,0:01:34.33,0:01:36.95,Default,,0,0,0,,Мазалағаныңыз бен қолайсыздықтарыңыз үшін рахмет.
Dialogue: 0,0:01:37.45,0:01:39.70,Default,,0,0,0,,Біз өте өкінеміз.
Dialogue: 0,0:01:41.12,0:01:50.37,Default,,0,0,0,,Куракура бүгін тарап кетті.
Dialogue: 0,0:03:22.00,0:03:24.83,Default,,0,0,0,,Фугаа, күткендей.
Dialogue: 0,0:03:25.29,0:03:29.37,Default,,0,0,0,,Хахахахаха мынау не деген сұмдық? Жаттығу, қайталау
Dialogue: 0,0:03:29.66,0:03:31.91,Default,,0,0,0,,Репетиция? Сонымен жаттығу?
Dialogue: 0,0:03:32.16,0:03:33.91,Default,,0,0,0,,Бірақ нақты іс жақын арада басталады.
Dialogue: 0,0:03:34.08,0:03:34.87,Default,,0,0,0,,Бұл не?\NОл
Dialogue: 0,0:03:35.45,0:03:38.54,Default,,0,0,0,,бойынша жойылады ма? Неге жоқ? Қайсы
Dialogue: 0,0:03:39.41,0:03:43.54,Default,,0,0,0,,-   -
Dialogue: 0,0:03:43.70,0:03:45.37,Default,,0,0,0,,Бұл адам қорқынышты.
Dialogue: 0,0:03:45.50,0:03:48.00,Default,,0,0,0,,Мен сені адам деп те ойламаймын.
Dialogue: 0,0:03:48.29,0:03:49.33,Default,,0,0,0,,-Ол адам кім? -Хмм
Dialogue: 0,0:03:49.58,0:03:51.08,Default,,0,0,0,,- Парик бұйралағыш-кун? -Уф
Dialogue: 0,0:03:51.16,0:03:52.41,Default,,0,0,0,,-Оның продюсері -Уф
Dialogue: 0,0:03:52.50,0:03:54.20,Default,,0,0,0,,-Мен бұл Бах туралы екеніне сенімдімін.
Dialogue: 0,0:03:54.25,0:03:55.75,Default,,0,0,0,,Сонымен, бұл туралы.
Dialogue: 0,0:03:56.04,0:03:59.41,Default,,0,0,0,,Ей, мен жақында жаңа ән шығарамын.
Dialogue: 0,0:03:59.79,0:04:03.45,Default,,0,0,0,,-Куракура демалыс күндеріне жоспарланған жаңа әннің жанды орындалуы -Ууууууууууууууууууу
Dialogue: 0,0:04:03.66,0:04:06.12,Default,,0,0,0,,Менің жеке әнім жойылды!
Dialogue: 0,0:04:06.20,0:04:08.16,Default,,0,0,0,,Иә, рахмет.
Dialogue: 0,0:04:08.41,0:04:10.33,Default,,0,0,0,,Мен көп жаттығу жасадым
Dialogue: 0,0:04:10.83,0:04:13.58,Default,,0,0,0,,Жалғыз ән айтатын жерім жоқ.
Dialogue: 0,0:04:13.79,0:04:16.29,Default,,0,0,0,,Бұл жауапсыз махаббат, солай емес пе?
Dialogue: 0,0:04:16.37,0:04:18.95,Default,,0,0,0,,-Жаман жігіт, ол бір рет ғажап болса да -А-а-а
Dialogue: 0,0:04:19.00,0:04:21.29,Default,,0,0,0,,-Сұлу болмаса, өнер жоқ, сенсіз -А, ә
Dialogue: 0,0:04:21.45,0:04:24.00,Default,,0,0,0,,-Менде мүлде жоқ болса да -Ааааааааааааааааааааа
Dialogue: 0,0:04:24.41,0:04:26.12,Default,,0,0,0,,Бада-чан бір рет соққан ғажайып па?
Dialogue: 0,0:04:26.50,0:04:28.37,Default,,0,0,0,,Иә, мен мұны бұрын айтқанмын.
Dialogue: 0,0:04:28.70,0:04:30.08,Default,,0,0,0,,Текла Бадаевска
Dialogue: 0,0:04:30.12,0:04:32.83,Default,,0,0,0,,Дүние жүзіне бір ғана хитпен танымал болды
Dialogue: 0,0:04:32.91,0:04:35.66,Default,,0,0,0,,Поляк композиторы Қазіргі уақытта
Dialogue: 0,0:04:35.79,0:04:38.45,Default,,0,0,0,,Кейде классикалық әлемнің бір соққы ғажайыптары деп аталады
Dialogue: 0,0:04:38.87,0:04:39.66,Default,,0,0,0,,Мен мұны айттым ба?
Dialogue: 0,0:04:39.95,0:04:40.79,Default,,0,0,0,,Саған қонақүй тауып беремін.
Dialogue: 0,0:04:41.50,0:04:46.33,Default,,0,0,0,,Сүйіспеншілікті сұрасаң, тек қасірет алады.
Dialogue: 0,0:04:47.08,0:04:47.95,Default,,0,0,0,,О
Dialogue: 0,0:04:48.79,0:04:51.41,Default,,0,0,0,,Бірақ бұл стратегия емес пе?
Dialogue: 0,0:04:51.75,0:04:52.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:52.62,0:04:56.00,Default,,0,0,0,,Бах мырза кейде қатал, бірақ ұзақ мерзімді перспективада
Dialogue: 0,0:04:56.20,0:04:57.66,Default,,0,0,0,,Сөз бен істің терең мағынасы
Dialogue: 0,0:04:57.70,0:05:00.41,Default,,0,0,0,,Түсіне бастаймын ба деп ойлаймын.
Dialogue: 0,0:05:00.75,0:05:01.66,Default,,0,0,0,,О
Dialogue: 0,0:05:02.29,0:05:04.87,Default,,0,0,0,,Жауапты позициядан музыка ойнауға тырысу
Dialogue: 0,0:05:05.37,0:05:07.87,Default,,0,0,0,,Бұл көп қиындық, иә?
Dialogue: 0,0:05:07.91,0:05:08.91,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:05:09.12,0:05:10.87,Default,,0,0,0,,Осылай сыртқа шыққанда,
Dialogue: 0,0:05:10.91,0:05:12.20,Default,,0,0,0,,-Сен жоғарыдан қарап тұрсың ба? -Ой
Dialogue: 0,0:05:12.33,0:05:14.41,Default,,0,0,0,,-Ол адам туралы не түсінесіз? -Ах
Dialogue: 0,0:05:14.50,0:05:16.66,Default,,0,0,0,,Мен сені күнде жұмыста көремін.
Dialogue: 0,0:05:16.83,0:05:19.29,Default,,0,0,0,,Ол өткен күні менің үйіме келді.
Dialogue: 0,0:05:19.58,0:05:20.70,Default,,0,0,0,,Сіз мұнда келдіңіз бе?
Dialogue: 0,0:05:21.08,0:05:25.41,Default,,0,0,0,,Иә, бірақ біз жай ғана шай ішіп, сөйлестік.
Dialogue: 0,0:05:26.08,0:05:26.41,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:05:26.45,0:05:28.54,Default,,0,0,0,,Аузыңызға кездейсоқ заттарды салыңыз.
Dialogue: 0,0:05:28.58,0:05:30.37,Default,,0,0,0,,Бұл әуесқой өте сүйкімді!
Dialogue: 0,0:05:30.45,0:05:31.41,Default,,0,0,0,,-Сәйкесінше -nniii
Dialogue: 0,0:05:32.04,0:05:35.54,Default,,0,0,0,,Аудармашысы болмаса, «каприччо» дейді.
Dialogue: 0,0:05:35.83,0:05:38.66,Default,,0,0,0,,«Poco a poco» немесе сол сияқты нәрсе.
Dialogue: 0,0:05:39.08,0:05:41.29,Default,,0,0,0,,Иә, тіпті бұл жігіт
Dialogue: 0,0:05:41.41,0:05:43.75,Default,,0,0,0,,Ол кісі жапон тілінде сәл сөйлейді.
Dialogue: 0,0:05:43.83,0:05:46.16,Default,,0,0,0,,Күні кеше бірінші рет естідім де, таң қалдым.
Dialogue: 0,0:05:46.29,0:05:48.20,Default,,0,0,0,,Жақсы, өте еркін.
Dialogue: 0,0:05:48.54,0:05:49.37,Default,,0,0,0,,Еркін?
Dialogue: 0,0:05:49.91,0:05:50.87,Default,,0,0,0,,20 минуттай
Dialogue: 0,0:05:51.00,0:05:51.66,Default,,0,0,0,,Уф
Dialogue: 0,0:05:52.37,0:05:55.83,Default,,0,0,0,,«Егер сізде қандай да бір қиындық туындаса, кез келген уақытта маған хабарласыңыз.»
Dialogue: 0,0:05:56.08,0:06:01.58,Default,,0,0,0,,Әй, ой, өтірік.
Dialogue: 0,0:06:01.62,0:06:02.33,Default,,0,0,0,,Ал оған он алты жасында, Римде…
Dialogue: 0,0:06:02.37,0:06:04.83,Default,,0,0,0,,Күте тұрыңыз, мен бос сөз айтып тұрған жоқпын.
Dialogue: 0,0:06:05.00,0:06:06.75,Default,,0,0,0,,-Мен ештеңе білмеймін -Ауырып тұр, ауырады
Dialogue: 0,0:06:06.83,0:06:08.95,Default,,0,0,0,,-Не болса да? -Эй, Чайко жақсы емес.
Dialogue: 0,0:06:09.16,0:06:11.75,Default,,0,0,0,,-До-до-до-до-до-до-до -Hmph, uh, humph, uh.
Dialogue: 0,0:06:11.83,0:06:15.37,Default,,0,0,0,,Эй, ол кетті! Ол адам жақсы емес.
Dialogue: 0,0:06:15.45,0:06:16.95,Default,,0,0,0,,Бұл адам...
Dialogue: 0,0:06:17.29,0:06:21.54,Default,,0,0,0,,Иә, иә, түсіндім. Барынша аударуға тырыстым.
Dialogue: 0,0:06:22.16,0:06:24.00,Default,,0,0,0,,Сізге басқа ештеңе керек емес еді.
Dialogue: 0,0:06:24.08,0:06:25.75,Default,,0,0,0,,Айтпа
Dialogue: 0,0:06:26.04,0:06:29.20,Default,,0,0,0,,Неліктен осы уақытқа дейін қалыпты сөйлеспедік?
Dialogue: 0,0:06:29.45,0:06:30.20,Default,,0,0,0,,Міне.
Dialogue: 0,0:06:32.08,0:06:36.95,Default,,0,0,0,,А, бұл мәселе. Кешкі асқа тағы бір адам.
Dialogue: 0,0:06:37.95,0:06:41.08,Default,,0,0,0,,Маған қызық, Чайко-чанды тыныштандыратын не?
Dialogue: 0,0:06:41.75,0:06:43.08,Default,,0,0,0,,Бұл орыс стилі ме?
Dialogue: 0,0:06:43.70,0:06:47.91,Default,,0,0,0,,Сиыр еті строганов Пирошки Pot-au-feu
Dialogue: 0,0:06:48.37,0:06:54.83,Default,,0,0,0,,Газпачо Горбачо Ах Ах
Dialogue: 0,0:06:57.70,0:06:59.25,Default,,0,0,0,,Егер сізде қандай да бір қиындық болса
Dialogue: 0,0:06:59.45,0:07:01.33,Default,,0,0,0,,Бізбен байланысыңыз
Dialogue: 0,0:07:02.20,0:07:02.91,Default,,0,0,0,,О
Dialogue: 0,0:07:10.95,0:07:13.37,Default,,0,0,0,,Менің ойымша, электрондық пошта тітіркендіргіш болды.
Dialogue: 0,0:07:14.04,0:07:16.08,Default,,0,0,0,,Продюсерлер бос емес пе?
Dialogue: 0,0:07:17.20,0:07:19.37,Default,,0,0,0,,Бірақ маған кенеттен келуімді өтінді.
Dialogue: 0,0:07:20.37,0:07:23.91,Default,,0,0,0,,Қызық, неге, Бада-сан?
Dialogue: 0,0:07:24.25,0:07:25.95,Default,,0,0,0,,Келгендеріңізге рахмет.
Dialogue: 0,0:07:26.50,0:07:28.66,Default,,0,0,0,,О, білесің бе, Чайко-чан дәл қазір менің үйімде.
Dialogue: 0,0:07:28.70,0:07:29.87,Default,,0,0,0,,Барымызды бірге жасайық
Dialogue: 0,0:07:30.08,0:07:30.50,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:07:31.29,0:07:33.45,Default,,0,0,0,,Чайко мені үнемі мазақ етеді.
Dialogue: 0,0:07:33.95,0:07:35.37,Default,,0,0,0,,Енді ол таза және сергітеді
Dialogue: 0,0:07:35.70,0:07:38.37,Default,,0,0,0,,Баяғы тағдырыммен әйтеуір қош айтайын.
Dialogue: 0,0:07:38.54,0:07:41.33,Default,,0,0,0,,-Екеуміздің жаңа бастамамыз--Аа.
Dialogue: 0,0:07:41.54,0:07:45.16,Default,,0,0,0,,Не?
Dialogue: 0,0:07:47.62,0:07:50.37,Default,,0,0,0,,О? Кана, бұл не, қауіпті емес пе?
Dialogue: 0,0:07:56.41,0:07:59.50,Default,,0,0,0,,Бұл өте қызықсыз. Бұл бала эмодзилер туралы білмей ме?
Dialogue: 0,0:07:59.70,0:08:00.79,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:08:01.00,0:08:02.16,Default,,0,0,0,,Менің алмастырушым
Dialogue: 0,0:08:02.29,0:08:02.70,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:03.20,0:08:04.62,Default,,0,0,0,,Маған ұсынылды.
Dialogue: 0,0:08:05.37,0:08:08.16,Default,,0,0,0,,Ауыстыру? Кенеттен бе? Сол әннің көшетіне?
Dialogue: 0,0:08:08.70,0:08:12.54,Default,,0,0,0,,Олай болса, котенка, мүмкін Бах шығар?
Dialogue: 0,0:08:13.25,0:08:17.29,Default,,0,0,0,,Бұл адамға бірден алмастырушы жалдау тән.
Dialogue: 0,0:08:18.04,0:08:20.20,Default,,0,0,0,,Күрсін, қалағаныңды істе.
Dialogue: 0,0:08:20.83,0:08:22.25,Default,,0,0,0,,Жарайды ма? шынымен
Dialogue: 0,0:08:22.50,0:08:25.83,Default,,0,0,0,,Мен жауап беруім керек. Кумир бол. Сөзсіз.
Dialogue: 0,0:08:26.29,0:08:28.83,Default,,0,0,0,,Кішкентай қыздың қарапайым өмірінде бір рет болатын өлім
Dialogue: 0,0:08:29.70,0:08:34.16,Default,,0,0,0,,Пұт болып қайта туыл Иә, жаз
Dialogue: 0,0:08:35.04,0:08:39.45,Default,,0,0,0,,Маған фотосуреттер жіберіңіз, мен қорытынды сайт жасаймын.
Dialogue: 0,0:08:39.66,0:08:40.08,Default,,0,0,0,,...
Dialogue: 0,0:08:40.50,0:08:44.54,Default,,0,0,0,,Дұрыс, Утанаэ сату қиын қыз.
Dialogue: 0,0:08:44.70,0:08:46.91,Default,,0,0,0,,Сіз Бахты ​​түсінесіз бе?
Dialogue: 0,0:08:47.33,0:08:49.58,Default,,0,0,0,,Бір жерде біреуге тым қиын
Dialogue: 0,0:08:49.62,0:08:51.16,Default,,0,0,0,,Себебі мені тастап кетті.
Dialogue: 0,0:08:51.37,0:08:51.91,Default,,0,0,0,,Ммм
Dialogue: 0,0:08:55.41,0:08:58.54,Default,,0,0,0,,Неліктен барлығы келіседі? Бірдеңе дұрыс емес
Dialogue: 0,0:08:59.08,0:09:01.70,Default,,0,0,0,,Егер сіз жеңсеңіз, бұл үлкен болады! Бұл өмірлік мүмкіндік.
Dialogue: 0,0:09:01.87,0:09:08.54,Default,,0,0,0,,Иә? Мәңгі? Жарайды, мен оны бір рет соғамын.
Dialogue: 0,0:09:09.50,0:09:13.91,Default,,0,0,0,,-Мүлдем айтпа! -Мен қатты уайымдадым.
Dialogue: 0,0:09:14.08,0:09:14.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:15.20,0:09:15.79,Default,,0,0,0,,Би
Dialogue: 0,0:09:16.00,0:09:16.58,Default,,0,0,0,,Дауыс
Dialogue: 0,0:09:16.70,0:09:17.62,Default,,0,0,0,,Жаяу жүру
Dialogue: 0,0:09:17.70,0:09:19.29,Default,,0,0,0,,Жүрек ұстайтын МК
Dialogue: 0,0:09:19.87,0:09:22.58,Default,,0,0,0,,Біз сені пұтқа айналдырамыз
Dialogue: 0,0:09:25.37,0:09:26.75,Default,,0,0,0,,Барымызды салайық
Dialogue: 0,0:09:27.29,0:09:29.54,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:09:31.87,0:09:35.41,Default,,0,0,0,,Бүгінгі дәуірде үлкен пұттарға арналған тірі орындар туралы сөз болғанда,
Dialogue: 0,0:09:36.29,0:09:39.25,Default,,0,0,0,,Фукуока стадионы Нагоя Кайкан Киото Плаза
Dialogue: 0,0:09:39.33,0:09:42.62,Default,,0,0,0,,Осака Холл Басқаша айтқанда, бұл болжанады
Dialogue: 0,0:09:43.16,0:09:45.54,Default,,0,0,0,,Ментайко Мисо Катсу Яцухаши
Dialogue: 0,0:09:45.62,0:09:47.70,Default,,0,0,0,,Осыдан кейін окономияки ағыны басталады.
Dialogue: 0,0:09:47.87,0:09:51.41,Default,,0,0,0,,Купальник емтиханы ше? Эй, не жинап жатырсың?
Dialogue: 0,0:09:51.54,0:09:52.66,Default,,0,0,0,,Сізге асығу керек!
Dialogue: 0,0:09:53.00,0:09:56.45,Default,,0,0,0,,Табиғи материалдармен
Dialogue: 0,0:09:56.54,0:09:57.12,Default,,0,0,0,,...
Dialogue: 0,0:09:57.20,0:09:57.66,Default,,0,0,0,,Осы жолмен
Dialogue: 0,0:09:57.75,0:09:58.29,Default,,0,0,0,,...
Dialogue: 0,0:09:58.37,0:09:58.83,Default,,0,0,0,,Кооооо
Dialogue: 0,0:09:58.87,0:09:59.50,Default,,0,0,0,,...
Dialogue: 0,0:10:00.04,0:10:01.66,Default,,0,0,0,,Бұл қызықсыз аяқталуды өзгертіңіз
Dialogue: 0,0:10:01.95,0:10:05.66,Default,,0,0,0,,Туған жеріңді неге насихаттамайсың? Дұрыс, жыланбалық.
Dialogue: 0,0:10:06.12,0:10:06.91,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:10:07.45,0:10:09.91,Default,,0,0,0,,Жаңа айдол дебюті
Dialogue: 0,0:10:10.95,0:10:13.29,Default,,0,0,0,,Аа, дұрыс, саладан хабары бар Чайко-чан.
Dialogue: 0,0:10:13.41,0:10:16.33,Default,,0,0,0,,Менің пікірімді сұрамасаң, қайда барар едің?
Dialogue: 0,0:10:18.87,0:10:22.08,Default,,0,0,0,,Зузузузузузузузузузузу
Dialogue: 0,0:10:22.33,0:10:26.25,Default,,0,0,0,,Пух, тыныштал, мына киім.
Dialogue: 0,0:10:26.33,0:10:28.16,Default,,0,0,0,,Біраз уақыт өтті
Dialogue: 0,0:10:28.66,0:10:29.91,Default,,0,0,0,,Оядзи Гаери
Dialogue: 0,0:10:30.75,0:10:34.16,Default,,0,0,0,,Ча Чайко-чан?
Dialogue: 0,0:10:35.04,0:10:35.54,Default,,0,0,0,,Хехе
Dialogue: 0,0:10:52.41,0:10:56.16,Default,,0,0,0,,Бұл жақсы эксперимент сияқты көрінеді хехехе
Dialogue: 0,0:10:56.25,0:11:00.66,Default,,0,0,0,,Мен түсіндім. Сол біртүрлі сарай мен Мусиктің қарым-қатынасы.
Dialogue: 0,0:11:01.37,0:11:05.95,Default,,0,0,0,,Мүмкін бұл үй иесі кілт шығар, иә?
Dialogue: 0,0:11:07.87,0:11:10.58,Default,,0,0,0,,Олай болса, маған еріп, дауыстап айт.
Dialogue: 0,0:11:11.45,0:11:15.20,Default,,0,0,0,,А-а-а-а-а-а-а
Dialogue: 0,0:11:15.50,0:11:20.62,Default,,0,0,0,,-Аа... -Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:11:22.70,0:11:25.83,Default,,0,0,0,,Ха, мен неге кумирмін?
Dialogue: 0,0:11:26.75,0:11:30.70,Default,,0,0,0,,№ Төбедегі тесіктерді толтыру Оқшаулағыш материалды қосу Дренаждық құбырларды ауыстыру
Dialogue: 0,0:11:30.79,0:11:32.29,Default,,0,0,0,,Тотқа қарсы бояу ақысы
Dialogue: 0,0:11:32.66,0:11:35.04,Default,,0,0,0,,Иә? Хм, көп нәрсе келеді.
Dialogue: 0,0:11:41.37,0:11:45.33,Default,,0,0,0,,Киііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііі
Dialogue: 0,0:11:52.41,0:11:59.16,Default,,0,0,0,,А-а-а-а, қарным ашты.
Dialogue: 0,0:11:59.91,0:12:03.70,Default,,0,0,0,,Утанаэ қашан оралады?
Dialogue: 0,0:12:03.87,0:12:09.08,Default,,0,0,0,,Күрсін, гёза немесе ештеңе жоқ па?
Dialogue: 0,0:12:10.33,0:12:14.00,Default,,0,0,0,,А, міне, солай! А? иә?
Dialogue: 0,0:12:15.37,0:12:16.75,Default,,0,0,0,,Оранда
Dialogue: 0,0:12:18.75,0:12:21.62,Default,,0,0,0,,Кәмелетке толмағандарға берілген алкоголь
Dialogue: 0,0:12:21.66,0:12:22.79,Default,,0,0,0,,Бір тамшы да емес!
Dialogue: 0,0:12:23.16,0:12:24.41,Default,,0,0,0,,Онда менмін.
Dialogue: 0,0:12:24.45,0:12:25.75,Default,,0,0,0,,-Үлкендерге де бермеймін.
Dialogue: 0,0:12:26.12,0:12:29.37,Default,,0,0,0,,-Жақсы, мен енді кумир емеспін. -Уау, эй, эй, жарайды.
Dialogue: 0,0:12:29.41,0:12:31.87,Default,,0,0,0,,-Мен ересекпін... -Мен бәрін істеймін!
Dialogue: 0,0:12:32.20,0:12:33.33,Default,,0,0,0,,-Пааааааааааааааааааааааааааааа
Dialogue: 0,0:12:34.62,0:12:38.33,Default,,0,0,0,,Арақтың ингредиенттері қара бидай, картоп, т.б.
Dialogue: 0,0:12:39.00,0:12:41.00,Default,,0,0,0,,Оны қантқа айналдырыңыз және ашытыңыз
Dialogue: 0,0:12:41.62,0:12:44.54,Default,,0,0,0,,Алкогольді кетіру үшін дистилляция
Dialogue: 0,0:12:45.41,0:12:48.87,Default,,0,0,0,,Бұл маңызды болуы мүмкін бе?
Dialogue: 0,0:12:49.50,0:12:50.04,Default,,0,0,0,,Иә
Dialogue: 0,0:13:11.95,0:13:15.75,Default,,0,0,0,,Жапонияда рұқсатсыз алкогольдік сусындарды өндіруге тыйым салынады.
Dialogue: 0,0:13:16.00,0:13:17.79,Default,,0,0,0,,Заңмен тыйым салынған
Dialogue: 0,0:13:19.20,0:13:20.66,Default,,0,0,0,,Бұл заңсыз болды
Dialogue: 0,0:13:21.58,0:13:24.50,Default,,0,0,0,,Сіз бірдеңені соған арнамайынша жасай алмайсыз.
Dialogue: 0,0:13:25.33,0:13:26.04,Default,,0,0,0,,Мен берілмеймін. Бір адамның да өлуіне жол бермеймін
Dialogue: 0,0:13:26.62,0:13:28.16,Default,,0,0,0,,Сангеннен хат
Dialogue: 0,0:13:28.54,0:13:29.33,Default,,0,0,0,,Бұл кеңседен.
Dialogue: 0,0:13:30.75,0:13:31.66,Default,,0,0,0,,Ммм
Dialogue: 0,0:13:32.29,0:13:34.04,Default,,0,0,0,,Мен мұны істей алмайтын сияқтымын Иә
Dialogue: 0,0:13:34.50,0:13:36.58,Default,,0,0,0,,-Мен мұны істегім келмейді Иә -Ой
Dialogue: 0,0:13:36.66,0:13:38.91,Default,,0,0,0,,Мен мұны істей алмайтын сияқтымын Иә
Dialogue: 0,0:13:38.95,0:13:41.33,Default,,0,0,0,,-Толық тексеру чекті тексеру -Хаа
Dialogue: 0,0:13:41.62,0:13:43.75,Default,,0,0,0,,Мүмкін емес Мүлде мүмкін емес Мүмкін емес
Dialogue: 0,0:13:43.87,0:13:46.16,Default,,0,0,0,,- мүмкін емес Мүлде мүмкін емес Мүмкін емес - Бет!
Dialogue: 0,0:13:46.62,0:13:47.62,Default,,0,0,0,,Бет
Dialogue: 0,0:13:48.08,0:13:50.04,Default,,0,0,0,,-Сіз көп жұмыс істеп жатқан сияқтысыз. -Ах.
Dialogue: 0,0:13:50.12,0:13:52.45,Default,,0,0,0,,-Бет- -Сен күшті болып кеттің, Утанае
Dialogue: 0,0:13:52.54,0:13:54.33,Default,,0,0,0,,-Не болды? -Ааааааааааааааааааааааа
Dialogue: 0,0:13:54.50,0:13:56.58,Default,,0,0,0,,- Бет - Айдолға ұқсамайсың.
Dialogue: 0,0:13:57.25,0:13:58.12,Default,,0,0,0,,- Иә?
Dialogue: 0,0:13:58.87,0:14:01.25,Default,,0,0,0,,Пұттар да тым тәтті болмауы керек.
Dialogue: 0,0:14:01.29,0:14:03.12,Default,,0,0,0,,Хм, мақала қоса берілген.
Dialogue: 0,0:14:03.58,0:14:04.08,Default,,0,0,0,,Әй?
Dialogue: 0,0:14:04.16,0:14:07.54,Default,,0,0,0,,«Ол осы жексенбіде Hamamatsu Records-те өтеді.
Dialogue: 0,0:14:07.66,0:14:11.54,Default,,0,0,0,,Чайко Кура Кураның тікелей эфирдегі жаңа әніне қатыспайды
Dialogue: 0,0:14:12.04,0:14:13.41,Default,,0,0,0,,Себебі денсаулығының нашарлығы.
Dialogue: 0,0:14:13.50,0:14:16.25,Default,,0,0,0,,Бада сахнаға болашағынан үміт күттіретін жаңадан келген адамды алып келді.
Dialogue: 0,0:14:16.29,0:14:18.79,Default,,0,0,0,,Пайда болу жоспарланған» Дон Мисуи
Dialogue: 0,0:14:19.25,0:14:20.66,Default,,0,0,0,,Келешегі зор жаңадан келген адам
Dialogue: 0,0:14:20.83,0:14:21.50,Default,,0,0,0,,Мен?
Dialogue: 0,0:14:21.79,0:14:24.66,Default,,0,0,0,,Кя, бұл сіздің дебютіңіз, котенка.
Dialogue: 0,0:14:24.75,0:14:27.00,Default,,0,0,0,,Уау! Шынайы ма?
Dialogue: 0,0:14:27.04,0:14:28.62,Default,,0,0,0,,-  -
Dialogue: 0,0:14:28.70,0:14:30.00,Default,,0,0,0,,Бәріміз бірге көрейік
Dialogue: 0,0:14:30.25,0:14:33.00,Default,,0,0,0,,-Аа ааа ааа -Бұл менмін, солай ма? Бұл менмін, солай ма?
Dialogue: 0,0:14:36.41,0:14:40.45,Default,,0,0,0,,хмф хмф хмф хмф хмф а а а а
Dialogue: 0,0:14:41.08,0:14:44.29,Default,,0,0,0,,Сау бол, шыны ертең.
Dialogue: 0,0:14:44.50,0:14:46.95,Default,,0,0,0,,Бада-чанның шалбары ұзын.
Dialogue: 0,0:14:47.04,0:14:49.62,Default,,0,0,0,,Аяқтарының ұзындығы әртүрлі болғандықтан көмектесуге болмайды.
Dialogue: 0,0:14:50.00,0:14:53.33,Default,,0,0,0,,Бұл қорқынышты. Ұйықта, қазір ұйықта.
Dialogue: 0,0:14:53.50,0:14:54.45,Default,,0,0,0,,Эхехе
Dialogue: 0,0:14:58.08,0:15:01.04,Default,,0,0,0,,Жарайды, екеуміз де жақсы болады.
Dialogue: 0,0:15:02.16,0:15:03.37,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:15:04.58,0:15:08.62,Default,,0,0,0,,Мен Чайкомен бірге болғанда, мен әрқашан ай болдым.
Dialogue: 0,0:15:09.58,0:15:13.75,Default,,0,0,0,,Чайко - күн, Жарқырап тұрған әрқашан Чайко
Dialogue: 0,0:15:15.33,0:15:19.04,Default,,0,0,0,,Бірақ, егер Утанамен болса, жылы болар еді.
Dialogue: 0,0:15:19.95,0:15:22.62,Default,,0,0,0,,Бір-біріне нәзік жарқыраған екі күн сияқты
Dialogue: 0,0:15:23.04,0:15:26.75,Default,,0,0,0,,Мен жылы бірлік жасай алатындай сезінемін.
Dialogue: 0,0:15:28.25,0:15:30.54,Default,,0,0,0,,Осылайша екі адам қайта кездеседі
Dialogue: 0,0:15:31.08,0:15:34.33,Default,,0,0,0,,Менің ойымша, бұл адам маған бәрін реттеп берді.
Dialogue: 0,0:15:36.62,0:15:37.45,Default,,0,0,0,,Сіз ұйықтадыңыз ба?
Dialogue: 0,0:15:37.75,0:15:40.45,Default,,0,0,0,,Иә, мен естідім.
Dialogue: 0,0:15:40.83,0:15:42.37,Default,,0,0,0,,Өйткені мен белгілер туралы ойламаймын.
Dialogue: 0,0:15:43.33,0:15:44.66,Default,,0,0,0,,Ұйықтама, байыпты.
Dialogue: 0,0:15:45.66,0:15:48.75,Default,,0,0,0,,Hmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmm
Dialogue: 0,0:15:49.00,0:15:51.20,Default,,0,0,0,,-Уау...жаңа жігіт! -Хехехехехехе
Dialogue: 0,0:15:51.50,0:15:53.95,Default,,0,0,0,,-Бұл гиредол ма? -Хехехехехехе
Dialogue: 0,0:15:54.08,0:15:56.75,Default,,0,0,0,,- Гиредол Гирегире мен оны ертең барамын - Хехехехехехехехехе
Dialogue: 0,0:15:57.00,0:15:58.62,Default,,0,0,0,,-Укеру Гирегире -Хехехехе
Dialogue: 0,0:15:58.70,0:16:02.83,Default,,0,0,0,,Хехе, жанармайдың түсуі аяқталды.
Dialogue: 0,0:16:09.29,0:16:13.54,Default,,0,0,0,,Оны жылытқыңыз келе ме? Әркімнің жүрегін үйге апарайық
Dialogue: 0,0:16:13.83,0:16:18.08,Default,,0,0,0,,Кішкентай күн жылы, солай емес пе?
Dialogue: 0,0:16:18.83,0:16:24.12,Default,,0,0,0,,О, десу!
Dialogue: 0,0:16:25.16,0:16:28.12,Default,,0,0,0,,А, жоқ, а.
Dialogue: 0,0:16:28.41,0:16:29.00,Default,,0,0,0,,Ехе
Dialogue: 0,0:16:29.95,0:16:30.95,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:16:31.04,0:16:33.25,Default,,0,0,0,,Мен қазір қатты толқып тұрмын.
Dialogue: 0,0:16:33.41,0:16:34.70,Default,,0,0,0,,Мен саған жақсы нәрсе айтайын
Dialogue: 0,0:16:35.04,0:16:35.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:36.25,0:16:40.37,Default,,0,0,0,,Барлық тұтынушылар мені бақылап отыр деп ойлаңыз.
Dialogue: 0,0:16:41.04,0:16:45.25,Default,,0,0,0,,Иә, түсінемін. Әдетте, мен туралы ештеңе білуге ​​мүмкіндік жоқ.
Dialogue: 0,0:16:45.83,0:16:50.54,Default,,0,0,0,,Дұрыс, жеңіл жүрсең болады.
Dialogue: 0,0:16:50.95,0:16:51.66,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:51.91,0:16:52.79,Default,,0,0,0,,Бада-чан
Dialogue: 0,0:16:52.83,0:16:53.33,Default,,0,0,0,,Хмм
Dialogue: 0,0:16:53.87,0:16:55.62,Default,,0,0,0,,Гиредолгиредол, маған гире бер
Dialogue: 0,0:16:55.66,0:16:56.83,Default,,0,0,0,,Гиледол Кой
Dialogue: 0,0:16:56.91,0:16:58.29,Default,,0,0,0,,Маған ұрыс!
Dialogue: 0,0:16:58.50,0:17:00.20,Default,,0,0,0,,Гиредуру
Dialogue: 0,0:17:00.62,0:17:02.04,Default,,0,0,0,,-Бучигире -Фу
Dialogue: 0,0:17:02.25,0:17:03.95,Default,,0,0,0,,Канана
Dialogue: 0,0:17:04.04,0:17:05.50,Default,,0,0,0,,-Маған ұрыс! -Хмм.
Dialogue: 0,0:17:05.79,0:17:08.29,Default,,0,0,0,,- Гиредру - Әңгіме Бұл басқаша, солай ма?
Dialogue: 0,0:17:08.50,0:17:12.33,Default,,0,0,0,,- Уфуфуфу Утанае туралы, Канана да - Канана маған ұрысты!
Dialogue: 0,0:17:12.45,0:17:13.16,Default,,0,0,0,,-Сүйкімді--Жиредру
Dialogue: 0,0:17:13.20,0:17:13.95,Default,,0,0,0,,Уау
Dialogue: 0,0:17:14.37,0:17:17.00,Default,,0,0,0,,Мен бөлмемді бүлдірдім.
Dialogue: 0,0:17:17.08,0:17:18.50,Default,,0,0,0,,Канана
Dialogue: 0,0:17:18.58,0:17:21.20,Default,,0,0,0,,Түсқағаз жыртылып, жағылып жатыр.
Dialogue: 0,0:17:21.45,0:17:22.79,Default,,0,0,0,,Канана
Dialogue: 0,0:17:22.83,0:17:27.79,Default,,0,0,0,,Гире Гиредол Иә Канана Ах!
Dialogue: 0,0:17:27.87,0:17:30.54,Default,,0,0,0,,Гиредор Гиредор Гиредор
Dialogue: 0,0:17:30.70,0:17:32.87,Default,,0,0,0,,-Гиредол Гиледол... -Аа, бұл махаббат!
Dialogue: 0,0:17:33.16,0:17:34.75,Default,,0,0,0,,-Неге бұлай болды? - Гиредол Гиледол
Dialogue: 0,0:17:35.20,0:17:37.50,Default,,0,0,0,,- Неліктен? Неліктен тек ән көшеттер - Гиредол Гиредол
Dialogue: 0,0:17:37.95,0:17:40.91,Default,,0,0,0,,- Чайко болмаса да, мен боламын - Гиредол Гиредол Гиредол Гиредол
Dialogue: 0,0:17:41.20,0:17:42.45,Default,,0,0,0,,- Бұл тек ай ма? - Гиредол Гиледол
Dialogue: 0,0:17:42.62,0:17:44.91,Default,,0,0,0,,-Уақыт келді, өтінемін -Гиредол Гиледол
Dialogue: 0,0:17:45.16,0:17:46.62,Default,,0,0,0,,- Уф, мүмкін емес - Гиредол Гиредол
Dialogue: 0,0:17:46.79,0:17:48.33,Default,,0,0,0,,- Ли Канае, мықты болыңыз - Гиредол Гиредол
Dialogue: 0,0:17:48.50,0:17:49.79,Default,,0,0,0,,-Жоқ, бұл қорқынышты -Гиредол Гиледол
Dialogue: 0,0:17:49.91,0:17:52.37,Default,,0,0,0,,-Сенің қолыңнан келеді! Сіз көп жаттықтыңыз. - Гиредол Гиледол Гиледол
Dialogue: 0,0:17:53.04,0:17:56.54,Default,,0,0,0,,- Уф, хехе, мен қалыпты қыз болғым келеді - Гиредол Гиредол Гиредол Гиредол
Dialogue: 0,0:17:56.91,0:18:02.04,Default,,0,0,0,,Уф, бұл қыз маған ұқсамайды.
Dialogue: 0,0:18:02.58,0:18:06.70,Default,,0,0,0,,Ешқашан бір оқ ата алмайтын бала.
Dialogue: 0,0:18:08.95,0:18:11.87,Default,,0,0,0,,Иә, бұл бір соққының кереметі дейді.
Dialogue: 0,0:18:12.20,0:18:14.58,Default,,0,0,0,,Шынымен оны бір оқпен ұратын бала бар ма?
Dialogue: 0,0:18:14.87,0:18:16.91,Default,,0,0,0,,Дүние жүзінде қанша адам бар?
Dialogue: 0,0:18:18.29,0:18:22.20,Default,,0,0,0,,Мен саған бір соққының ғажайып өмірін көрсетемін.
Dialogue: 0,0:18:25.04,0:18:26.54,Default,,0,0,0,,Рахмет сізге Утанае
Dialogue: 0,0:18:26.91,0:18:27.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:27.91,0:18:30.33,Default,,0,0,0,,Жетер, мен мұны өзім істей аламын.
Dialogue: 0,0:18:30.91,0:18:31.66,Default,,0,0,0,,Әй, Бада-сан!
Dialogue: 0,0:18:33.37,0:18:36.00,Default,,0,0,0,,Уау
Dialogue: 0,0:18:36.12,0:18:39.75,Default,,0,0,0,,Міне, солай ма? Котенка қайда?
Dialogue: 0,0:18:39.87,0:18:40.66,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:18:41.00,0:18:41.54,Default,,0,0,0,,Га
Dialogue: 0,0:18:42.41,0:18:44.41,Default,,0,0,0,,Менің ойымша, сіз қорқып шыға алмайсыз, солай ма?
Dialogue: 0,0:18:44.75,0:18:47.41,Default,,0,0,0,,Мен солай ойладым, сондықтан мен жылыну үшін сонда бардым.
Dialogue: 0,0:18:47.50,0:18:49.04,Default,,0,0,0,,Атмосфераны оқымайтын қыз.
Dialogue: 0,0:18:49.95,0:18:50.75,Default,,0,0,0,,Канана ше?
Dialogue: 0,0:18:50.79,0:18:51.58,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:18:53.29,0:18:55.20,Default,,0,0,0,,Ммммммм
Dialogue: 0,0:18:55.58,0:18:58.41,Default,,0,0,0,,Әй, Чайко!
Dialogue: 0,0:18:59.79,0:19:00.16,Default,,0,0,0,,Ах
Dialogue: 0,0:19:00.58,0:19:01.20,Default,,0,0,0,,Канана ше?
Dialogue: 0,0:19:01.25,0:19:01.83,Default,,0,0,0,,Канана
Dialogue: 0,0:19:02.45,0:19:03.50,Default,,0,0,0,,Бадазевская
Dialogue: 0,0:19:03.83,0:19:10.20,Default,,0,0,0,,А, Чайковский, жоқ, жоқ, келме.
Dialogue: 0,0:19:10.83,0:19:15.79,Default,,0,0,0,,Уақыт келді, енді мен жалғыз күнмін
Dialogue: 0,0:19:15.87,0:19:16.37,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:19:16.45,0:19:16.95,Default,,0,0,0,,Мен оны жек көремін
Dialogue: 0,0:19:17.12,0:19:17.58,Default,,0,0,0,,Га
Dialogue: 0,0:19:18.45,0:19:22.16,Default,,0,0,0,,Қазірдің өзінде кеш!
Dialogue: 0,0:19:23.91,0:19:27.66,Default,,0,0,0,,Я грамм. Жақсы.
Dialogue: 0,0:19:40.95,0:19:45.66,Default,,0,0,0,,Әй, жаңбыр жауса
Dialogue: 0,0:19:45.79,0:19:46.91,Default,,0,0,0,,Арима тағы да бірінші орын алды ма?—
Dialogue: 0,0:19:47.00,0:19:53.04,Default,,0,0,0,,-Ах Қар да жауып жатыр -Тек маған қарашы, мен келдім
Dialogue: 0,0:19:53.12,0:19:56.25,Default,,0,0,0,,-Аа, жылайтын күндерім болады.
Dialogue: 0,0:19:56.29,0:19:59.00,Default,,0,0,0,,Бұл тек Текла Бадаевскаға тиесілі
Dialogue: 0,0:19:59.04,0:20:03.12,Default,,0,0,0,,«Қыз дұғасы» хит әні
Dialogue: 0,0:20:03.79,0:20:06.33,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:20:06.41,0:20:07.00,Default,,0,0,0,,Келме
Dialogue: 0,0:20:07.91,0:20:09.41,Default,,0,0,0,,Жалғыз жарқырап тұрмын
Dialogue: 0,0:20:10.16,0:20:13.37,Default,,0,0,0,,Менің ғаламымда бір ғана күн бар
Dialogue: 0,0:20:14.08,0:20:17.66,Default,,0,0,0,,Бада бұл ғаламның түсі қандай екенін түсінбейді.
Dialogue: 0,0:20:18.37,0:20:21.66,Default,,0,0,0,,Күнді айналатын атаусыз жұлдыздар
Dialogue: 0,0:20:22.83,0:20:24.58,Default,,0,0,0,,Айдың да маңызы зор.
Dialogue: 0,0:20:24.95,0:20:28.75,Default,,0,0,0,,Иә, сіз ғалам туралы сөйлесуге жарамды деп ойлайсыз ба?
Dialogue: 0,0:20:29.50,0:20:31.12,Default,,0,0,0,,Сіз құдай болуға тырысасыз ба?
Dialogue: 0,0:20:31.33,0:20:33.95,Default,,0,0,0,,Жоқ, тағы бірге музыка ойнайық.
Dialogue: 0,0:20:34.00,0:20:34.70,Default,,0,0,0,,Міне
Dialogue: 0,0:20:35.08,0:20:36.20,Default,,0,0,0,,Музыка құдайы
Dialogue: 0,0:20:36.41,0:20:38.87,Default,,0,0,0,,Сен тастап кеткен мен болсам да.
Dialogue: 0,0:20:39.00,0:20:40.83,Default,,0,0,0,,Жоқ, мен енді түсіндім.
Dialogue: 0,0:20:41.20,0:20:44.29,Default,,0,0,0,,Екі адамның әні, екі адамның үні маңызды.
Dialogue: 0,0:20:44.45,0:20:46.75,Default,,0,0,0,,Ол кісі мен үшін жасады.
Dialogue: 0,0:20:47.08,0:20:48.08,Default,,0,0,0,,Тіпті Бада-чан
Dialogue: 0,0:20:48.33,0:20:51.33,Default,,0,0,0,,Мен жанкүйерлерімнің жүрегіне жол беруге бар күшімді салдым.
Dialogue: 0,0:20:51.41,0:20:51.79,Default,,0,0,0,,Ах
Dialogue: 0,0:20:52.54,0:20:55.79,Default,,0,0,0,,Қызық, бұл шынымен де әр адамның жүрегіне жетеді ме?
Dialogue: 0,0:20:56.75,0:21:00.20,Default,,0,0,0,,Хек!
Dialogue: 0,0:21:00.50,0:21:03.04,Default,,0,0,0,,Ол сезімді ол адам да жасай алмайды.
Dialogue: 0,0:21:03.54,0:21:05.25,Default,,0,0,0,,Бұл екеумізге ғана арналған ба?
Dialogue: 0,0:21:06.95,0:21:07.75,Default,,0,0,0,,Ах
Dialogue: 0,0:21:08.12,0:21:10.83,Default,,0,0,0,,Екі шынайы адам
Dialogue: 0,0:21:13.41,0:21:17.83,Default,,0,0,0,,Чайко-чан Бірақ менің бетімді көбік жуады
Dialogue: 0,0:21:18.62,0:21:20.58,Default,,0,0,0,,Сіз оны ұзақ уақыт бойы рұқсатсыз пайдаланып жүрсіз.
Dialogue: 0,0:21:21.20,0:21:23.62,Default,,0,0,0,,Мен білдім!
Dialogue: 0,0:21:23.70,0:21:24.83,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:21:25.00,0:21:27.12,Default,,0,0,0,,Аххххх
Dialogue: 0,0:21:27.50,0:21:32.58,Default,,0,0,0,,Уфуфу Бір рет. Егер сіз бір соққының кереметі болсаңыз, тек бір рет
Dialogue: 0,0:21:33.16,0:21:36.79,Default,,0,0,0,,Мен бір ғана күнге айналамын
Dialogue: 0,0:21:37.79,0:21:43.58,Default,,0,0,0,,О, о, рахмет рахмет
Dialogue: 0,0:21:44.12,0:21:51.20,Default,,0,0,0,,Рахмет, рахмет, рахмет
Dialogue: 0,0:21:54.91,0:21:56.04,Default,,0,0,0,,Бадаевска
Dialogue: 0,0:21:57.16,0:21:59.25,Default,,0,0,0,,Музыка менің күткенімнен асып түсті.
Dialogue: 0,0:22:00.08,0:22:02.75,Default,,0,0,0,,Қалдықтар сәттілік әкеледі ме?
Dialogue: 0,0:22:03.29,0:22:04.83,Default,,0,0,0,,Хехехехехехе
Dialogue: 0,0:22:07.91,0:22:13.62,Default,,0,0,0,,-Рахмет,рахмет -Бада-чан керемет
Dialogue: 0,0:22:13.91,0:22:15.08,Default,,0,0,0,,-Құттықтаймыз -Рахмет
Dialogue: 0,0:22:17.45,0:22:23.41,Default,,0,0,0,,-Рахмет, рахмет -Мен көрдім, Бада-сан, құдайлық орындау.
Dialogue: 0,0:22:23.50,0:22:24.95,Default,,0,0,0,,-Менің кананам ше? -Рахмет
Dialogue: 0,0:22:25.04,0:22:28.37,Default,,0,0,0,,-Данышпандық оянуда әрқашан құрбандық бар -Уууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:22:28.66,0:22:32.16,Default,,0,0,0,,- Эй, Баданың осындай музыкасы бар еді - Ууууууууу
Dialogue: 0,0:22:32.62,0:22:34.95,Default,,0,0,0,,-Сонымен не істеп жатырсың? -Ууууууууууууууууу
Dialogue: 0,0:22:36.12,0:22:41.50,Default,,0,0,0,,Ааа ах ха ха ха ха ха ха ха ха ха ха
Dialogue: 0,0:22:42.54,0:22:44.04,Default,,0,0,0,,Иә!
Dialogue: 0,0:22:45.20,0:22:47.50,Default,,0,0,0,,Рахмет
Dialogue: 0,0:23:13.00,0:23:17.83,Default,,0,0,0,,Жаңбыр жауса
Dialogue: 0,0:23:18.91,0:23:23.91,Default,,0,0,0,,Ах Қар да жауып жатыр
Dialogue: 0,0:23:25.00,0:23:29.70,Default,,0,0,0,,Әй, жылайтын күндерім болады
Dialogue: 0,0:23:29.87,0:23:35.87,Default,,0,0,0,,Кейбір күндер өте қызықты
Dialogue: 0,0:23:37.00,0:23:41.79,Default,,0,0,0,,Ах (АхА) Саяхат жалғасуда
Dialogue: 0,0:23:43.00,0:23:47.70,Default,,0,0,0,,(АнАн) Өмірлік саяхат
Dialogue: 0,0:23:49.20,0:23:59.54,Default,,0,0,0,,Жыла, күл, жыла, сен оны жеңесің.
Dialogue: 0,0:24:01.29,0:24:06.20,Default,,0,0,0,,Дүниенің суық желінде
Dialogue: 0,0:24:06.41,0:24:12.54,Default,,0,0,0,,Шашыңызды құрғатыңыз.
Dialogue: 0,0:24:19.54,0:24:22.79,Default,,0,0,0,,Байыптылық дегеніміз не? Жастық деген не? Танымал болу деген не?
Dialogue: 0,0:24:22.87,0:24:25.45,Default,,0,0,0,,Қан кету, аштық, көзімнің астындағы қара шеңберлер
Dialogue: 0,0:24:25.54,0:24:26.83,Default,,0,0,0,,Соңында мен жалғызбын
Dialogue: 0,0:24:26.91,0:24:30.16,Default,,0,0,0,,Сайып келгенде, сіз тек өзіңіз екеніңізді түсіну туралы ма?
Dialogue: 0,0:24:30.25,0:24:31.79,Default,,0,0,0,,Кагура Сосуке 16 жаста
Dialogue: 0,0:24:33.29,0:24:39.29,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory