Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:27.41,0:00:28.54,Default,,0,0,0,,Өйткені бұл маған ұнамайды.
Dialogue: 0,0:00:28.58,0:00:31.00,Default,,0,0,0,,Жұмысты қаласаңыз, сәл салмақты болыңыз
Dialogue: 0,0:00:31.08,0:00:32.91,Default,,0,0,0,,Мен мұны шындап жазып отырмын.
Dialogue: 0,0:00:33.54,0:00:35.50,Default,,0,0,0,,Франц Шуберт сияқты.
Dialogue: 0,0:00:35.87,0:00:37.79,Default,,0,0,0,,Шын есіміңізді дұрыс жазыңыз.
Dialogue: 0,0:00:37.87,0:00:39.00,Default,,0,0,0,,Шын аты
Dialogue: 0,0:00:39.12,0:00:42.45,Default,,0,0,0,,Менің де мұғалімдік тәжірибем бар.
Dialogue: 0,0:00:42.58,0:00:43.87,Default,,0,0,0,,Сізде лицензия бар ма?
Dialogue: 0,0:00:44.25,0:00:44.95,Default,,0,0,0,,Хмм, лицензия?
Dialogue: 0,0:00:45.12,0:00:47.37,Default,,0,0,0,,Сізде мұғалімдік лицензия жоқ, солай ма?
Dialogue: 0,0:00:47.79,0:00:51.00,Default,,0,0,0,,Мен жай ғана жұмыс алғым келеді.
Dialogue: 0,0:00:51.50,0:00:53.75,Default,,0,0,0,,Барлығы осылай дейді, солай ма?
Dialogue: 0,0:00:53.95,0:00:57.75,Default,,0,0,0,,Менің үй иесі шулы. Мен пәтер ақысын төлеп, жұмысқа тұруым керек.
Dialogue: 0,0:00:58.00,0:01:00.62,Default,,0,0,0,,Барлығы осылай дейді, солай ма?
Dialogue: 0,0:01:00.91,0:01:03.20,Default,,0,0,0,,Мен сүйікті ағамның қасында болғым келеді.
Dialogue: 0,0:01:03.58,0:01:05.75,Default,,0,0,0,,Мен ол жерден кеткім келмейді.
Dialogue: 0,0:01:06.08,0:01:08.41,Default,,0,0,0,,Барлығы осылай дейді, солай ма?
Dialogue: 0,0:01:08.66,0:01:11.58,Default,,0,0,0,,Біріншіден, сол азғын, қайырымсыз адам неге істеді
Dialogue: 0,0:01:11.62,0:01:12.75,Default,,0,0,0,,Онда сабырлы болыңыз
Dialogue: 0,0:01:13.08,0:01:15.58,Default,,0,0,0,,Неліктен мен көп жұмыс істеуім керек?
Dialogue: 0,0:01:15.95,0:01:17.62,Default,,0,0,0,,Ол тіпті жұмыс істемейді.
Dialogue: 0,0:01:18.04,0:01:20.29,Default,,0,0,0,,Барлығы осылай дейді, солай ма?
Dialogue: 0,0:01:20.37,0:01:23.54,Default,,0,0,0,,Дахаааааааааахх Әйтеуір үй иесі
Dialogue: 0,0:01:23.83,0:01:28.70,Default,,0,0,0,,Әй, мен суық тиіп қалған шығармын.
Dialogue: 0,0:03:00.87,0:03:03.79,Default,,0,0,0,,Егер сіз жұмыс істемейтін нәрсені айтсаңыз, онда бұл жақсы емес.
Dialogue: 0,0:03:04.00,0:03:05.50,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:03:05.66,0:03:09.04,Default,,0,0,0,,Біз тек Бахтың айтқанын орындауымыз керек.
Dialogue: 0,0:03:09.54,0:03:12.87,Default,,0,0,0,,Бірақ Чайко-чан да уайымдады, солай ма?
Dialogue: 0,0:03:13.20,0:03:15.62,Default,,0,0,0,,Бірінші кезекте сол Бетховен мен Моцарт
Dialogue: 0,0:03:15.66,0:03:18.00,Default,,0,0,0,,Бейбақтар оныкі
Dialogue: 0,0:03:20.08,0:03:21.00,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:03:22.25,0:03:23.00,Default,,0,0,0,,Иә
Dialogue: 0,0:03:23.33,0:03:26.08,Default,,0,0,0,,Сізді Арче тыңдауға шақырады ма?
Dialogue: 0,0:03:26.16,0:03:27.41,Default,,0,0,0,,Біз керемет емеспіз.
Dialogue: 0,0:03:27.54,0:03:30.87,Default,,0,0,0,,Бірақ мен оны қандай критерийлер бойынша таңдағанын түсінбеймін.
Dialogue: 0,0:03:30.95,0:03:32.08,Default,,0,0,0,,Бұл солай емес пе?
Dialogue: 0,0:03:32.20,0:03:36.16,Default,,0,0,0,,Бұл сіз данышпан продюсер Дж.С.Б.
Dialogue: 0,0:03:36.70,0:03:40.25,Default,,0,0,0,,Не? Ол неге мұнда?
Dialogue: 0,0:03:40.45,0:03:45.04,Default,,0,0,0,,Тыңдау? Аа, басқа күні.
Dialogue: 0,0:03:46.12,0:03:49.08,Default,,0,0,0,,Бірақ ол жігіттерді әзірге жайына қалдырыңыз.
Dialogue: 0,0:03:49.16,0:03:50.00,Default,,0,0,0,,Бах
Dialogue: 0,0:03:50.12,0:03:51.08,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:03:51.45,0:03:53.50,Default,,0,0,0,,Кез келген жағдайда, біз шатастырып алған шығармыз.
Dialogue: 0,0:03:53.54,0:03:55.66,Default,,0,0,0,,Олар байқап, құрмет көрсетуге келді.
Dialogue: 0,0:03:55.83,0:03:56.54,Default,,0,0,0,,Иә
Dialogue: 0,0:03:56.66,0:03:58.66,Default,,0,0,0,,Қалай болғанда да, мен оны Бах мырзаға хабарлауым керек.
Dialogue: 0,0:03:58.79,0:03:59.66,Default,,0,0,0,,Уф
Dialogue: 0,0:04:00.95,0:04:01.45,Default,,0,0,0,,Иә
Dialogue: 0,0:04:01.95,0:04:04.83,Default,,0,0,0,,Иә, неге бұл жерде?
Dialogue: 0,0:04:05.25,0:04:09.08,Default,,0,0,0,,Мен кешегі гитараны қандай да бір ұлы адам ойнады ма деп ойлаймын.
Dialogue: 0,0:04:09.12,0:04:11.75,Default,,0,0,0,,Хатта көзіңізге түскенін айттыңыз.
Dialogue: 0,0:04:12.41,0:04:17.16,Default,,0,0,0,,Эй, қарашы, мен бұл белгіні танымаймын.
Dialogue: 0,0:04:17.87,0:04:21.25,Default,,0,0,0,,Сонымен, өткен күні конкурсқа демеушілік жасаған компания.
Dialogue: 0,0:04:21.87,0:04:23.95,Default,,0,0,0,,Олай болса, Моту-сан неге менің соңымнан жүр?
Dialogue: 0,0:04:24.16,0:04:27.41,Default,,0,0,0,,Олар мені шақырды, себебі бұл қызықты көрінді.
Dialogue: 0,0:04:27.45,0:04:31.08,Default,,0,0,0,,Бұл жай ғана Лу емес пе? Неге Сосуке онымен бірге?
Dialogue: 0,0:04:31.25,0:04:33.16,Default,,0,0,0,,Жоқ, бұл.
Dialogue: 0,0:04:33.91,0:04:36.25,Default,,0,0,0,,Мен Бетоның серіктесімін.
Dialogue: 0,0:04:36.41,0:04:37.66,Default,,0,0,0,,Мен германды айтып отырмын.
Dialogue: 0,0:04:37.87,0:04:41.20,Default,,0,0,0,,Менсіз бәрібір жақсы емес, Бето-сан.
Dialogue: 0,0:04:41.50,0:04:43.87,Default,,0,0,0,,Ахаха ахахха
Dialogue: 0,0:04:44.12,0:04:46.91,Default,,0,0,0,,Мен де Бето-санға ғашық болдым.
Dialogue: 0,0:04:46.95,0:04:47.79,Default,,0,0,0,,Кәсіби дебют т.б.
Dialogue: 0,0:04:47.91,0:04:50.50,Default,,0,0,0,,Куракураның екі адамымен дос бола алсаңыз тамаша емес пе?
Dialogue: 0,0:04:50.54,0:04:51.33,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:04:53.37,0:04:56.54,Default,,0,0,0,,Әйтеуір, көзілдірік осында сыйса
Dialogue: 0,0:04:56.58,0:04:59.12,Default,,0,0,0,,Сіз кәсіби музыкантсыз
Dialogue: 0,0:04:59.29,0:05:01.08,Default,,0,0,0,,1 миллион бейне қаралымы
Dialogue: 0,0:05:01.16,0:05:04.41,Default,,0,0,0,,Қол алысу билеттерін компакт-дискілерге тіркеп, ақша табыңыз
Dialogue: 0,0:05:04.62,0:05:07.95,Default,,0,0,0,,Роялтиден түсетін ақша көбірек
Dialogue: 0,0:05:08.08,0:05:09.66,Default,,0,0,0,,Утанае де міндетті түрде бақытты болады.
Dialogue: 0,0:05:10.83,0:05:13.50,Default,,0,0,0,,Ақша Ah
Dialogue: 0,0:05:14.08,0:05:16.45,Default,,0,0,0,,Мені данышпанмын десе де
Dialogue: 0,0:05:16.87,0:05:20.12,Default,,0,0,0,,Егер сіз қарыз болып көрінсеңіз, бұл аянышты.
Dialogue: 0,0:05:20.25,0:05:23.37,Default,,0,0,0,,Егер сіз маған үнсіз бағынсаңыз, сіздің жұмыс берушіңіз.
Dialogue: 0,0:05:23.41,0:05:24.25,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:05:25.70,0:05:28.37,Default,,0,0,0,,Хмм? Қазір не болды?
Dialogue: 0,0:05:31.66,0:05:33.37,Default,,0,0,0,,Уау
Dialogue: 0,0:05:34.50,0:05:37.50,Default,,0,0,0,,Менің ойымша, бұл сату күні болғандықтан, мен тым көп сатып алдым.
Dialogue: 0,0:05:38.25,0:05:38.79,Default,,0,0,0,,Ах
Dialogue: 0,0:05:43.16,0:05:44.29,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:45.25,0:05:45.79,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:05:46.04,0:05:48.04,Default,,0,0,0,,Аа, көп рахмет.
Dialogue: 0,0:05:49.62,0:05:50.37,Default,,0,0,0,,О
Dialogue: 0,0:05:52.79,0:05:54.79,Default,,0,0,0,,Келесі адам не болды?
Dialogue: 0,0:05:55.37,0:05:58.50,Default,,0,0,0,,Бето-сан, дайындал, дайындал, бар күшіңді сал.
Dialogue: 0,0:05:59.00,0:06:01.37,Default,,0,0,0,,Ой, кешіріңіз, мен бірден бастайын.
Dialogue: 0,0:06:01.54,0:06:04.41,Default,,0,0,0,,Аа, сен сол жерде Вольфгангсың.
Dialogue: 0,0:06:04.66,0:06:05.87,Default,,0,0,0,,Не, мен?
Dialogue: 0,0:06:06.20,0:06:08.91,Default,,0,0,0,,Ол бұрынғы Людвиг болды ма?
Dialogue: 0,0:06:09.37,0:06:12.95,Default,,0,0,0,,Жарамдылықты бөлек қарастырайық, сондықтан осында өтіңіз.
Dialogue: 0,0:06:13.54,0:06:14.79,Default,,0,0,0,,Ал, сәл күте тұрыңыз.
Dialogue: 0,0:06:15.16,0:06:17.00,Default,,0,0,0,,Адамның алдыңғы сайысы қандай болды?
Dialogue: 0,0:06:17.04,0:06:18.54,Default,,0,0,0,,-Мен сенімен туыс емеспін. -Сен ше?
Dialogue: 0,0:06:19.04,0:06:20.95,Default,,0,0,0,,Тыңдау тізімінде болмаса да
Dialogue: 0,0:06:21.12,0:06:23.75,Default,,0,0,0,,Жоқ, бұл серіктес пе?
Dialogue: 0,0:06:24.33,0:06:25.45,Default,,0,0,0,,сүйемелдеу?
Dialogue: 0,0:06:25.58,0:06:28.33,Default,,0,0,0,,Менің жолсерікті осында күтіңіз. Бұл жақсы.
Dialogue: 0,0:06:29.45,0:06:30.20,Default,,0,0,0,,Иә
Dialogue: 0,0:06:32.04,0:06:34.37,Default,,0,0,0,,Оларды шақырған сен бе?
Dialogue: 0,0:06:34.79,0:06:35.33,Default,,0,0,0,,Иә
Dialogue: 0,0:06:35.70,0:06:37.04,Default,,0,0,0,,Не ойнап жүрсің?
Dialogue: 0,0:06:37.33,0:06:39.41,Default,,0,0,0,,Сіз ол адамның бұйрығына қарсы шығасыз ба?
Dialogue: 0,0:06:40.04,0:06:41.29,Default,,0,0,0,,Бұл дұрыс емес
Dialogue: 0,0:06:41.58,0:06:42.20,Default,,0,0,0,,Өзің бар
Dialogue: 0,0:06:42.29,0:06:45.25,Default,,0,0,0,,Барлық классикалоидтарды мінсіз етіп жасаңыз
Dialogue: 0,0:06:46.08,0:06:48.12,Default,,0,0,0,,Бұл Бахтың мақсаты, солай емес пе?
Dialogue: 0,0:06:48.58,0:06:49.33,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:06:49.79,0:06:51.16,Default,,0,0,0,,Бұл екі адамды кім шақырды?
Dialogue: 0,0:06:51.75,0:06:54.12,Default,,0,0,0,,Сол мақсатқа барынша жақындау
Dialogue: 0,0:06:55.08,0:06:56.87,Default,,0,0,0,,Маған қарашы!
Dialogue: 0,0:07:01.41,0:07:07.58,Default,,0,0,0,,А, тұтынушы А, неге?
Dialogue: 0,0:07:09.54,0:07:12.16,Default,,0,0,0,,Дұрыс, әкем.
Dialogue: 0,0:07:12.87,0:07:16.79,Default,,0,0,0,,Иә, әкеңе қарыздармын.
Dialogue: 0,0:07:17.54,0:07:20.41,Default,,0,0,0,,Жол бойы келгеніңіз үшін кешіріңіз.
Dialogue: 0,0:07:20.58,0:07:22.12,Default,,0,0,0,,Менің әкем жоқ
Dialogue: 0,0:07:22.62,0:07:26.12,Default,,0,0,0,,Уайымдамаңыз, мен де кенет қоңырау шалғаным үшін кешірім сұраймын.
Dialogue: 0,0:07:26.50,0:07:30.04,Default,,0,0,0,,Жоқ, бұл туралы алаңдамаңыз.
Dialogue: 0,0:07:32.45,0:07:34.16,Default,,0,0,0,,Бұл жерде сирек кездесетін нәрсе бар.
Dialogue: 0,0:07:34.50,0:07:37.37,Default,,0,0,0,,Әй, бұл менің әжемдікі.
Dialogue: 0,0:07:38.20,0:07:39.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:43.50,0:07:45.62,Default,,0,0,0,,Мен осындай сағынышты көргенде
Dialogue: 0,0:07:46.16,0:07:48.70,Default,,0,0,0,,Бұрын ойнаған нәрсені есіме түсіреді
Dialogue: 0,0:07:49.25,0:07:52.50,Default,,0,0,0,,Иә? Сіздің жұмысыңыз музыкамен байланысты ма?
Dialogue: 0,0:07:53.00,0:07:55.83,Default,,0,0,0,,Әй, бұл еліктеу ғана ғой.
Dialogue: 0,0:07:56.29,0:07:57.29,Default,,0,0,0,,Көшірме?
Dialogue: 0,0:07:58.75,0:08:00.87,Default,,0,0,0,,Нағыз музыка дегеніміз не?
Dialogue: 0,0:08:01.58,0:08:04.04,Default,,0,0,0,,Мен оны әлі ойнаған жоқпын.
Dialogue: 0,0:08:05.00,0:08:08.33,Default,,0,0,0,,Мен оны бір күні ойнағым келеді.
Dialogue: 0,0:08:08.95,0:08:09.70,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:08:20.83,0:08:24.08,Default,,0,0,0,,Өтінемін, Бето-сан, тамаша шешім қабылда.
Dialogue: 0,0:08:24.12,0:08:28.54,Default,,0,0,0,,Мен гонорар төлеп жатырмын, сонда сіз осындай уақытта кімсіз?
Dialogue: 0,0:08:29.95,0:08:33.25,Default,,0,0,0,,Шопен мырза, уақыт таяп қалды.
Dialogue: 0,0:08:34.41,0:08:36.75,Default,,0,0,0,,Идол болғың келмей ме?
Dialogue: 0,0:08:37.33,0:08:38.04,Default,,0,0,0,,Кумир?
Dialogue: 0,0:08:38.45,0:08:41.58,Default,,0,0,0,,Иә, сіздің жағдайыңызда сіздің келбетіңіз жақсы.
Dialogue: 0,0:08:41.62,0:08:46.08,Default,,0,0,0,,Бұл да сүйкімді. Жақсылап орнатсақ, сатылады.
Dialogue: 0,0:08:46.29,0:08:47.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:47.41,0:08:48.62,Default,,0,0,0,,Қыздар арасында танымал
Dialogue: 0,0:08:48.91,0:08:49.83,Default,,0,0,0,,танымал
Dialogue: 0,0:08:50.08,0:08:54.29,Default,,0,0,0,,Дұрыс, мың, он мың қыз саған ғашық болады.
Dialogue: 0,0:08:54.50,0:08:56.58,Default,,0,0,0,,Мен бар қалтамдағы ақшамды саған жұмсадым
Dialogue: 0,0:08:56.62,0:09:00.62,Default,,0,0,0,,-Сенің әрбір кездейсоқ қимылыңнан бәрі есінен танып қалады -Ааааа
Dialogue: 0,0:09:02.08,0:09:03.87,Default,,0,0,0,,Ойласам, біз ұзақ уақыт сөйлеспеген сияқтымыз
Dialogue: 0,0:09:04.25,0:09:05.66,Default,,0,0,0,,Кя
Dialogue: 0,0:09:05.91,0:09:08.75,Default,,0,0,0,,Барлығы, мен cho x cho x істеп жатырмын
Dialogue: 0,0:09:08.83,0:09:10.83,Default,,0,0,0,,Кя Чо×Чо×
Dialogue: 0,0:09:11.16,0:09:12.62,Default,,0,0,0,,Фу чо × чо ×
Dialogue: 0,0:09:12.75,0:09:14.91,Default,,0,0,0,,Кя Чо×Чо×
Dialogue: 0,0:09:15.16,0:09:19.75,Default,,0,0,0,,Және барлығы- Чо х Чо х
Dialogue: 0,0:09:19.83,0:09:21.20,Default,,0,0,0,,Чо × Чо ×
Dialogue: 0,0:09:21.62,0:09:23.45,Default,,0,0,0,,Чо×Чо× Чо×Чо×
Dialogue: 0,0:09:23.54,0:09:24.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:24.37,0:09:27.12,Default,,0,0,0,,Иә, мен істеймін Айдол
Dialogue: 0,0:09:29.29,0:09:30.75,Default,,0,0,0,,Музыка дегеніміз не?
Dialogue: 0,0:09:31.58,0:09:34.37,Default,,0,0,0,,Бұл менің жүрегімдегі құмарлықтың көрінісі.
Dialogue: 0,0:09:35.08,0:09:37.75,Default,,0,0,0,,Жоқ, оны жанның өзі деуге болады.
Dialogue: 0,0:09:39.95,0:09:40.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:44.70,0:09:46.08,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:46.66,0:09:49.70,Default,,0,0,0,,Музыка бастапқыда кез келген шектеулерден бос.
Dialogue: 0,0:09:50.54,0:09:53.41,Default,,0,0,0,,Оны еркін күйде ойнау керек.
Dialogue: 0,0:09:54.04,0:09:59.66,Default,,0,0,0,,Бұл солай болуы керек, бірақ іс жүзінде олай болмайды.
Dialogue: 0,0:10:00.25,0:10:01.91,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:10:02.41,0:10:06.20,Default,,0,0,0,,Ах, көптеген шектеулер мен шектеулер ішінде
Dialogue: 0,0:10:06.70,0:10:08.91,Default,,0,0,0,,Сіз өзіңіз қалаған нәрсені істеуіңіз керек
Dialogue: 0,0:10:09.70,0:10:11.50,Default,,0,0,0,,Нені білдіргіңіз келеді
Dialogue: 0,0:10:12.08,0:10:14.87,Default,,0,0,0,,Бұл тек ойнау туралы емес.
Dialogue: 0,0:10:16.66,0:10:17.87,Default,,0,0,0,,Естуге болатын нәрселер
Dialogue: 0,0:10:18.50,0:10:20.95,Default,,0,0,0,,Адамдар қалаған нәрсені жасамайынша, пайда жоқ
Dialogue: 0,0:10:21.95,0:10:25.16,Default,,0,0,0,,Тіпті ол сіз қалаған нәрседен басқаша болса да
Dialogue: 0,0:10:26.45,0:10:28.87,Default,,0,0,0,,Бұл толық еркіндіктен алыс
Dialogue: 0,0:10:29.79,0:10:30.41,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:10:31.37,0:10:34.62,Default,,0,0,0,,Демек, бостандық жоқтың екінші жағы
Dialogue: 0,0:10:35.41,0:10:39.58,Default,,0,0,0,,Біз толық еркіндік пен кездейсоқ шектеулер арасында тербелеміз.
Dialogue: 0,0:10:40.25,0:10:42.29,Default,,0,0,0,,Тек тұрақсыз болмыс
Dialogue: 0,0:10:46.20,0:10:47.12,Default,,0,0,0,,Жоқ, кешіріңіз.
Dialogue: 0,0:10:47.75,0:10:50.62,Default,,0,0,0,,Қызықпағандар үшін қызық оқиға болды.
Dialogue: 0,0:10:51.00,0:10:54.41,Default,,0,0,0,,Жоқ, кешіріңіз, мен шынымен түсінбеймін.
Dialogue: 0,0:10:55.62,0:10:57.29,Default,,0,0,0,,Бірақ сіз нені айтасыз?
Dialogue: 0,0:10:57.79,0:11:01.08,Default,,0,0,0,,Мен сенің қатты қиналып жатқаныңды түсінемін.
Dialogue: 0,0:11:01.12,0:11:01.50,Default,,0,0,0,,Ах
Dialogue: 0,0:11:02.62,0:11:03.08,Default,,0,0,0,,​​О?
Dialogue: 0,0:11:04.41,0:11:04.95,Default,,0,0,0,,Хмм
Dialogue: 0,0:11:06.20,0:11:10.45,Default,,0,0,0,,Жарайды, ол азапты жалғастыратын шығар.
Dialogue: 0,0:11:20.00,0:11:22.83,Default,,0,0,0,,А, мен мұнымен енді біттім.
Dialogue: 0,0:11:23.50,0:11:25.66,Default,,0,0,0,,Менің ойымша, сіз жалғыз адамсыз, иә?
Dialogue: 0,0:11:27.58,0:11:31.95,Default,,0,0,0,,Иә, ойнауды доғар, бұл Бетховен.
Dialogue: 0,0:11:32.25,0:11:34.04,Default,,0,0,0,,Хаха, бұл шедевр.
Dialogue: 0,0:11:34.41,0:11:36.66,Default,,0,0,0,,Ол сол ұлы тұлғамен бірдей.
Dialogue: 0,0:11:36.83,0:11:40.45,Default,,0,0,0,,Материалдарға қарағанда, күтпегендігімен назар аударған сияқты.
Dialogue: 0,0:11:41.29,0:11:45.04,Default,,0,0,0,,Өнерпазмын деп жарымжан адамдар бар.
Dialogue: 0,0:11:45.45,0:11:48.29,Default,,0,0,0,,Солай бола тұра мен басқалардың шығармаларына еліктеймін.
Dialogue: 0,0:11:48.58,0:11:49.79,Default,,0,0,0,,Сенде де ол ауыз бар ма?
Dialogue: 0,0:11:50.29,0:11:52.41,Default,,0,0,0,,Егер сізді дұрыс түсінбесе, қиын болар еді.
Dialogue: 0,0:11:53.33,0:11:55.62,Default,,0,0,0,,Біз сізді тыңдауға шақырдық.
Dialogue: 0,0:11:56.00,0:11:57.83,Default,,0,0,0,,Сайыс жазбаларын қарау
Dialogue: 0,0:11:58.08,0:12:00.54,Default,,0,0,0,,Өйткені ол белгілі бір деңгейден гөрі өзекті болды.
Dialogue: 0,0:12:00.91,0:12:03.54,Default,,0,0,0,,Дебют жасағыңыз келсе Сатқыңыз келсе
Dialogue: 0,0:12:03.62,0:12:06.54,Default,,0,0,0,,-Егер сіз біздің саясатымызды орындамасаңыз, біз қиындыққа тап боламыз.
Dialogue: 0,0:12:07.45,0:12:08.25,Default,,0,0,0,,Уф
Dialogue: 0,0:12:08.75,0:12:09.91,Default,,0,0,0,,Мен мұнымен біттім
Dialogue: 0,0:12:10.25,0:12:12.00,Default,,0,0,0,,Сіз тым өзімшілсіз
Dialogue: 0,0:12:12.45,0:12:13.41,Default,,0,0,0,,өзімшіл?
Dialogue: 0,0:12:13.66,0:12:16.62,Default,,0,0,0,,Қазіргі кумирлер бұлай билей алмайды.
Dialogue: 0,0:12:16.66,0:12:17.79,Default,,0,0,0,,Ұқсас болма
Dialogue: 0,0:12:17.87,0:12:19.95,Default,,0,0,0,,Маған мұндай нәрсе ұнамайды.
Dialogue: 0,0:12:20.16,0:12:23.58,Default,,0,0,0,,О, және мұндай жағымсыз мінез-құлыққа да тыйым салынады.
Dialogue: 0,0:12:23.70,0:12:26.54,Default,,0,0,0,,Қазіргі кезде абайсызда айтылған сөз отты да тудыруы мүмкін.
Dialogue: 0,0:12:26.83,0:12:27.70,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:12:27.79,0:12:31.45,Default,,0,0,0,,Сондай-ақ дөрекі пікірлер көп, бірақ бұлардың барлығына да тыйым салынған.
Dialogue: 0,0:12:31.58,0:12:32.41,Default,,0,0,0,,дөрекі?
Dialogue: 0,0:12:32.58,0:12:35.04,Default,,0,0,0,,Чо×чо×, Чо×, т.б. Чо×чо×, т.б.
Dialogue: 0,0:12:35.12,0:12:38.25,Default,,0,0,0,,Мүлдем тыйым салынады, себебі бұл хабар тарату апатына әкеледі. Ұнайды
Dialogue: 0,0:12:38.41,0:12:39.66,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:12:39.75,0:12:40.58,Default,,0,0,0,,Мүлдем тыйым салынған
Dialogue: 0,0:12:40.70,0:12:42.62,Default,,0,0,0,,Сонда мен кумир болуды қоямын.
Dialogue: 0,0:12:42.66,0:12:43.54,Default,,0,0,0,,Не?
Dialogue: 0,0:12:43.58,0:12:44.08,Default,,0,0,0,,Бех
Dialogue: 0,0:12:44.95,0:12:46.16,Default,,0,0,0,,О, бұл
Dialogue: 0,0:12:46.75,0:12:47.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:47.62,0:12:51.16,Default,,0,0,0,,Мен мұның қаншалықты қиын екенін түсінбеймін.
Dialogue: 0,0:12:52.12,0:12:55.58,Default,,0,0,0,,Көңіл көтеру жақсы емес пе? Музыка
Dialogue: 0,0:12:56.04,0:12:56.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:56.79,0:13:00.41,Default,,0,0,0,,Кешіріңіз, мен бұл туралы ештеңе білмеймін, бірақ бұл қажет емес.
Dialogue: 0,0:13:01.00,0:13:06.00,Default,,0,0,0,,Жоқ, жалғастырыңыз. Мен сізден көбірек естігім келеді.
Dialogue: 0,0:13:06.79,0:13:09.16,Default,,0,0,0,,Е, жоқ, бұл әңгіме емес.
Dialogue: 0,0:13:10.20,0:13:13.41,Default,,0,0,0,,Дегенмен, бізде музыка сияқты нәрселермен айналысатын адамдар да бар.
Dialogue: 0,0:13:13.50,0:13:17.29,Default,,0,0,0,,Адамдар көп болды, мен оларды аздап еске алдым.
Dialogue: 0,0:13:18.45,0:13:21.20,Default,,0,0,0,,Олар әрқашан қалағанын жасайды
Dialogue: 0,0:13:21.95,0:13:24.16,Default,,0,0,0,,Бірақ бұл әрқашан көңілді болып көрінеді
Dialogue: 0,0:13:26.29,0:13:26.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:26.95,0:13:31.00,Default,,0,0,0,,Кешіріңіз, олар қазірдің өзінде осында.
Dialogue: 0,0:13:31.04,0:13:33.20,Default,,0,0,0,,Әрқашан бейберекет болады
Dialogue: 0,0:13:34.25,0:13:37.20,Default,,0,0,0,,Бәріне осылай қамқор боласың.
Dialogue: 0,0:13:37.62,0:13:40.54,Default,,0,0,0,,Рас, олар музыкадан басқа ештеңеге жарамайды.
Dialogue: 0,0:13:40.70,0:13:42.87,Default,,0,0,0,,Кем дегенде бірге өмір сүру ережелері
Dialogue: 0,0:13:42.91,0:13:44.62,Default,,0,0,0,,Мен сені қорғауға тырысамын.
Dialogue: 0,0:13:45.83,0:13:47.83,Default,,0,0,0,,Бостандық бұзылмау
Dialogue: 0,0:13:48.41,0:13:51.16,Default,,0,0,0,,Бұл қалыпты ынталандыру ретіндегі шектеу ме?
Dialogue: 0,0:13:52.08,0:13:52.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:53.37,0:13:54.16,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:55.45,0:13:58.33,Default,,0,0,0,,Бұл жерде шынымен де ыңғайлы шығар.
Dialogue: 0,0:13:59.29,0:13:59.87,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:14:01.54,0:14:03.58,Default,,0,0,0,,Мен сенің құмар екеніңді білемін, бірақ
Dialogue: 0,0:14:04.00,0:14:06.25,Default,,0,0,0,,Мұндай нәрсе әлдеқашан ескірген бе?
Dialogue: 0,0:14:06.79,0:14:08.91,Default,,0,0,0,,Аа, дұрыс, саған керегі сол
Dialogue: 0,0:14:08.95,0:14:10.70,Default,,0,0,0,,Жетер, аузыңды жап.
Dialogue: 0,0:14:11.25,0:14:11.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:12.29,0:14:15.70,Default,,0,0,0,,Мен түсіндім, сендер ештеңе түсінбейсіңдер.
Dialogue: 0,0:14:16.66,0:14:20.45,Default,,0,0,0,,Бұл тәкаппар мінез. Дебют жасағыңыз келмейді ме?
Dialogue: 0,0:14:20.58,0:14:23.20,Default,,0,0,0,,Дебют жасау үшін сізге қажет нәрсе - сіз.
Dialogue: 0,0:14:23.33,0:14:27.70,Default,,0,0,0,,Мен сізге музыка екенін айтайын
Dialogue: 0,0:14:28.20,0:14:30.20,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:33.12,0:14:35.29,Default,,0,0,0,,-Біраз жүрейік, мен үйге барайын -Ууууууу
Dialogue: 0,0:14:35.33,0:14:37.91,Default,,0,0,0,,Жоқ, сіз стилистсіз немесе бишісіз.
Dialogue: 0,0:14:37.95,0:14:41.04,Default,,0,0,0,,Мен нұсқаулық алдым. Бұл тегін емес.
Dialogue: 0,0:14:41.08,0:14:42.37,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:14:42.58,0:14:45.70,Default,,0,0,0,,Егер сіз шығуды шешсеңіз, барлық жұмсалған шығындарды қайтарыңыз.
Dialogue: 0,0:14:45.79,0:14:47.08,Default,,0,0,0,,Мен оны түсінбеймін
Dialogue: 0,0:14:47.20,0:14:48.87,Default,,0,0,0,,Тек мені тыңда
Dialogue: 0,0:14:49.16,0:14:52.62,Default,,0,0,0,,Бар болғаны аузыңды жауып, біз айтқандай істе.
Dialogue: 0,0:14:52.95,0:14:53.33,Default,,0,0,0,,Га
Dialogue: 0,0:14:54.00,0:14:56.20,Default,,0,0,0,,Мені данышпанмын десе де
Dialogue: 0,0:14:56.54,0:14:59.87,Default,,0,0,0,,Сіз қарызға батып бара жатқандай көрінсеңіз, бұл аянышты.
Dialogue: 0,0:15:00.87,0:15:02.75,Default,,0,0,0,,Зальцбургке қайта келу
Dialogue: 0,0:15:02.91,0:15:04.16,Default,,0,0,0,,A Бірақ мәртебелі
Dialogue: 0,0:15:04.41,0:15:08.66,Default,,0,0,0,,Мен жауап беруге шыдамаймын. Мен сенің жұмыс берушіңмін.
Dialogue: 0,0:15:09.04,0:15:12.75,Default,,0,0,0,,Сізге бар болғаны үндемеңіз және менің шешімімді орындаңыз.
Dialogue: 0,0:15:13.70,0:15:15.41,Default,,0,0,0,,Үнсіз бағыну
Dialogue: 0,0:15:15.79,0:15:17.16,Default,,0,0,0,,Менің айтқанымды істе
Dialogue: 0,0:15:17.58,0:15:19.20,Default,,0,0,0,,Сенің әкең Эден мектебінің түлегі ғой, иә?
Dialogue: 0,0:15:20.62,0:15:24.29,Default,,0,0,0,,Маған енді ұнамайды.
Dialogue: 0,0:15:24.33,0:15:25.37,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:15:25.41,0:15:27.29,Default,,0,0,0,,Кумир болғың келмей ме?
Dialogue: 0,0:15:27.37,0:15:31.12,Default,,0,0,0,,Маған бұл маңызды емес.
Dialogue: 0,0:15:32.29,0:15:33.41,Default,,0,0,0,,Дене өздігінен қозғалады
Dialogue: 0,0:15:34.08,0:15:35.41,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:15:35.62,0:15:37.08,Default,,0,0,0,,Мадада!
Dialogue: 0,0:15:38.87,0:15:39.70,Default,,0,0,0,,Сәлем
Dialogue: 0,0:15:40.41,0:15:43.00,Default,,0,0,0,,Эй, о
Dialogue: 0,0:15:45.45,0:15:48.12,Default,,0,0,0,,Кешіріңіз, сіздің жолыңыздан шығып кеткеніңіз үшін.
Dialogue: 0,0:15:48.91,0:15:51.66,Default,,0,0,0,,Ешбір қиналсаңыз, жарайды.
Dialogue: 0,0:15:52.12,0:15:53.87,Default,,0,0,0,,Бізбен байланысыңыз
Dialogue: 0,0:15:54.12,0:15:55.95,Default,,0,0,0,,Аа, көп рахмет.
Dialogue: 0,0:15:57.08,0:15:57.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:59.45,0:16:02.58,Default,,0,0,0,,Мен сені алып кетуге келдім. Шұғыл бірдеңе болған сияқты.
Dialogue: 0,0:16:07.41,0:16:10.79,Default,,0,0,0,,Оны сол ортада қалдыру әлі де дұрыс па?
Dialogue: 0,0:16:12.87,0:16:16.54,Default,,0,0,0,,Мен оны түсінбеймін, бірақ ол жақсы адам сияқты көрінді.
Dialogue: 0,0:16:18.16,0:16:19.16,Default,,0,0,0,,Котенка-чан
Dialogue: 0,0:16:19.20,0:16:19.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:20.25,0:16:22.20,Default,,0,0,0,,Жарайды хаха
Dialogue: 0,0:16:22.25,0:16:22.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:23.00,0:16:23.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:32.62,0:16:35.95,Default,,0,0,0,,Қалай қарасаң да, Бето-сан мен Моту-сан.
Dialogue: 0,0:16:36.58,0:16:41.25,Default,,0,0,0,,Неліктен бұл болып жатыр? Әй, мен бәрібір оларды табуым керек.
Dialogue: 0,0:16:41.45,0:16:43.87,Default,,0,0,0,,Хахахахаха
Dialogue: 0,0:16:43.95,0:16:44.41,Default,,0,0,0,,Ах
Dialogue: 0,0:16:44.66,0:16:45.41,Default,,0,0,0,,Қалыңыз
Dialogue: 0,0:16:45.45,0:16:47.25,Default,,0,0,0,,-Осында кім болса да алға қара.
Dialogue: 0,0:16:47.50,0:16:48.08,Default,,0,0,0,,Ах
Dialogue: 0,0:16:48.33,0:16:50.20,Default,,0,0,0,,Чайко-чан Бадакюн
Dialogue: 0,0:16:50.29,0:16:54.33,Default,,0,0,0,,Ах, понкоцу-сан.
Dialogue: 0,0:16:54.75,0:16:58.12,Default,,0,0,0,,Жоқ, бұл атау емес, бірақ бәрібір.
Dialogue: 0,0:16:58.50,0:17:03.00,Default,,0,0,0,,Одан гөрі осындай уақытта не істеп жүрсің?
Dialogue: 0,0:17:03.58,0:17:07.95,Default,,0,0,0,,Мекенжай алмасуға бола ма?
Dialogue: 0,0:17:08.04,0:17:09.95,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:17:10.00,0:17:10.66,Default,,0,0,0,,Ә... ә... білесің бе...
Dialogue: 0,0:17:10.75,0:17:13.08,Default,,0,0,0,,Кейінірек жасаңыз Бөкенас Асқабақ
Dialogue: 0,0:17:13.12,0:17:15.62,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:17:18.75,0:17:19.12,Default,,0,0,0,,Иә
Dialogue: 0,0:17:25.62,0:17:26.66,Default,,0,0,0,,О
Dialogue: 0,0:17:26.75,0:17:27.91,Default,,0,0,0,,Чайко-чан
Dialogue: 0,0:17:28.12,0:17:32.20,Default,,0,0,0,,Уф, осы нөмірмен, тіпті өз музыкаммен
Dialogue: 0,0:17:33.08,0:17:34.50,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:17:34.87,0:17:38.79,Default,,0,0,0,,Бұл жағдай әйтеуір бір сәтті.
Dialogue: 0,0:17:41.12,0:17:43.08,Default,,0,0,0,,Уау
Dialogue: 0,0:17:43.16,0:17:44.58,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:17:54.62,0:17:59.50,Default,,0,0,0,,Füge dich zusammen, meine Melodie!
Dialogue: 0,0:18:29.33,0:18:29.91,Default,,0,0,0,,Уф
Dialogue: 0,0:18:30.04,0:18:30.54,Default,,0,0,0,,Бұл
Dialogue: 0,0:18:31.08,0:18:33.08,Default,,0,0,0,,Енді, осы жерден.
Dialogue: 0,0:18:37.16,0:18:40.37,Default,,0,0,0,,Бұл олар. Бұл дүрбелеңді тудырғандар да солар.
Dialogue: 0,0:18:40.50,0:18:42.58,Default,,0,0,0,,Эй, сен бірдеңе істедің бе?
Dialogue: 0,0:18:43.25,0:18:46.95,Default,,0,0,0,,Сен сол ақымақтардың бастығысың ба?
Dialogue: 0,0:18:52.91,0:18:53.50,Default,,0,0,0,,Не?
Dialogue: 0,0:18:53.91,0:18:55.79,Default,,0,0,0,,Мүмкін сіз де классикалоид шығарсыз
Dialogue: 0,0:18:56.62,0:18:59.29,Default,,0,0,0,,Бұл сендер ойнайтын музыка ма?
Dialogue: 0,0:19:00.33,0:19:02.91,Default,,0,0,0,,Музыканттарға қарсы қоюға болмайды.
Dialogue: 0,0:19:03.75,0:19:05.58,Default,,0,0,0,,Уф, мен қалыпты сөйледім.
Dialogue: 0,0:19:05.70,0:19:07.25,Default,,0,0,0,,Мен оны бірінші рет естідім
Dialogue: 0,0:19:07.58,0:19:11.20,Default,,0,0,0,,Музыканы қорлап, бізге бұғау салған сенсің.
Dialogue: 0,0:19:11.50,0:19:14.41,Default,,0,0,0,,Құмарлық отын сөндірмекші ақымақ.
Dialogue: 0,0:19:14.70,0:19:17.20,Default,,0,0,0,,Музыка еркін немесе қызықсыз болуы керек.
Dialogue: 0,0:19:17.66,0:19:18.12,Default,,0,0,0,,Уф
Dialogue: 0,0:19:18.66,0:19:22.20,Default,,0,0,0,,Нағыз музыка, шынайы жанның көрінісі
Dialogue: 0,0:19:22.87,0:19:25.62,Default,,0,0,0,,Бар құштарлығымды төккен музыка
Dialogue: 0,0:19:26.50,0:19:29.95,Default,,0,0,0,,Қараңызшы, бұл қаншалықты керемет
Dialogue: 0,0:19:31.12,0:19:33.16,Default,,0,0,0,,Мен де өзімді көрсетемін.
Dialogue: 0,0:19:38.87,0:19:43.62,Default,,0,0,0,,Құмарлық, еркіндік, күлуді тоқтат
Dialogue: 0,0:19:44.29,0:19:46.66,Default,,0,0,0,,Құмарлық пен жай қалау басқа.
Dialogue: 0,0:19:47.00,0:19:49.70,Default,,0,0,0,,Еркіндік пен жауапсыз еріксіздік те әртүрлі.
Dialogue: 0,0:19:50.20,0:19:54.62,Default,,0,0,0,,Айырмашылықты білмеген адам музыка ойнауға жарамайды.
Dialogue: 0,0:19:55.79,0:19:57.87,Default,,0,0,0,,-Бах мырза күткендей -О
Dialogue: 0,0:19:58.00,0:19:58.87,Default,,0,0,0,,Бах
Dialogue: 0,0:19:59.16,0:20:01.70,Default,,0,0,0,,Иә? Сонда бұл адам Бах па?
Dialogue: 0,0:20:02.16,0:20:04.25,Default,,0,0,0,,Бах Бұл жігіт
Dialogue: 0,0:20:04.91,0:20:06.62,Default,,0,0,0,,Бостандыққа ұмтылу
Dialogue: 0,0:20:06.95,0:20:09.62,Default,,0,0,0,,Ішінен тасып жатқан музыкаға құштарлық
Dialogue: 0,0:20:10.33,0:20:12.20,Default,,0,0,0,,Мұның өзі дұрыс.
Dialogue: 0,0:20:12.95,0:20:16.58,Default,,0,0,0,,Бірақ сіз жабайы болып, қалағаныңызды жасай алмайсыз.
Dialogue: 0,0:20:17.25,0:20:21.75,Default,,0,0,0,,Жануарлар сияқты музыка да айқын ниетке негізделген.
Dialogue: 0,0:20:22.12,0:20:26.91,Default,,0,0,0,,Бір ғана нүкте, межелі жерге атылған жебе сияқты
Dialogue: 0,0:20:28.87,0:20:29.62,Default,,0,0,0,,-Ух-Ах
Dialogue: 0,0:20:30.58,0:20:31.75,Default,,0,0,0,,- Куха - Ух
Dialogue: 0,0:20:34.20,0:20:38.33,Default,,0,0,0,,Сол жебені ату үшін ащы ішіп, уайымға шыда.
Dialogue: 0,0:20:38.75,0:20:42.00,Default,,0,0,0,,Сөйтсе де, жақсыны іздеуде тоқу дыбыс
Dialogue: 0,0:20:42.04,0:20:43.54,Default,,0,0,0,,Біздің Садам
Dialogue: 0,0:20:44.00,0:20:45.91,Default,,0,0,0,,Қандай түсініксіз нәрселер
Dialogue: 0,0:20:46.50,0:20:49.58,Default,,0,0,0,,Сіз әлі музыканың елшісі болуға лайықсыз.
Dialogue: 0,0:20:50.58,0:20:52.91,Default,,0,0,0,,Мен іздеген сегіз нотаға қол жеткізу
Dialogue: 0,0:20:53.29,0:20:55.12,Default,,0,0,0,,Ой, сегіз дыбыс?
Dialogue: 0,0:20:55.91,0:21:00.91,Default,,0,0,0,,Оны қазір білудің қажеті жоқ. Сіз білуіңіз керек нәрсе - өзіңіздің жетілмегендігіңіз.
Dialogue: 0,0:21:02.08,0:21:02.54,Default,,0,0,0,,Уф
Dialogue: 0,0:21:10.12,0:21:13.41,Default,,0,0,0,,Тоқта, неге бізге ұрысып жатырсың?
Dialogue: 0,0:21:13.66,0:21:15.91,Default,,0,0,0,,Ча, Чайко-чан дұрыс айтады.
Dialogue: 0,0:21:16.25,0:21:17.54,Default,,0,0,0,,Оларды кім шақырды?
Dialogue: 0,0:21:17.75,0:21:19.33,Default,,0,0,0,,Сіз сәтсіздікке ұшырадыңыз.
Dialogue: 0,0:21:19.41,0:21:21.41,Default,,0,0,0,,- Кешіріңіз - Уф
Dialogue: 0,0:21:21.58,0:21:26.37,Default,,0,0,0,,Алайда, нәтижесінде олардың өсуі туралы Бах мырзаның өзі білді.
Dialogue: 0,0:21:26.41,0:21:29.37,Default,,0,0,0,,Оны көргеніңізге қуаныштымын.
Dialogue: 0,0:21:33.29,0:21:36.37,Default,,0,0,0,,Неліктен Бах қалыпты жағдайға оралды?
Dialogue: 0,0:21:36.62,0:21:38.37,Default,,0,0,0,,Мен бұл туралы білмеймін.
Dialogue: 0,0:21:38.75,0:21:40.04,Default,,0,0,0,,Жақсы көңіл-күй
Dialogue: 0,0:21:40.50,0:21:43.37,Default,,0,0,0,,Әй, мен көп нәрсені жоғалтқаныма қатты көңілім қалды.
Dialogue: 0,0:21:43.75,0:21:47.33,Default,,0,0,0,,Айтайын дегенім, мен жеңілген жоқпын, эй.
Dialogue: 0,0:21:47.87,0:21:50.41,Default,,0,0,0,,Жоқ, бұл жолы толық жеңіліс.
Dialogue: 0,0:21:51.12,0:21:54.87,Default,,0,0,0,,Дәл осы жерде біз өз тәжірибемізді мойындап, көп жұмыс істеуіміз керек.
Dialogue: 0,0:21:55.20,0:21:57.91,Default,,0,0,0,,Ағадан күткендей, шындықты қабылдай отырып
Dialogue: 0,0:21:58.04,0:22:01.37,Default,,0,0,0,,Одан да биік белестерді бағындыру Мен басқалардан ерекшемін.
Dialogue: 0,0:22:01.41,0:22:06.54,Default,,0,0,0,,−Ух −Уау Уау Уау Уау Уау
Dialogue: 0,0:22:06.58,0:22:07.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:07.75,0:22:09.79,Default,,0,0,0,,Мен мұны мойындамадым.
Dialogue: 0,0:22:10.04,0:22:12.41,Default,,0,0,0,,Жақында тамақ ішейік.
Dialogue: 0,0:22:12.50,0:22:14.58,Default,,0,0,0,,Иә, иә, мен дайынмын.
Dialogue: 0,0:22:15.04,0:22:16.87,Default,,0,0,0,,Тек Лист мырза мен Шопен мырза
Dialogue: 0,0:22:17.00,0:22:17.79,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:22:18.04,0:22:20.66,Default,,0,0,0,,Азық-түлік жалдау ақысын төлеген адамнан келеді.
Dialogue: 0,0:22:20.79,0:22:24.70,Default,,0,0,0,,Үй иесі, мен жұмыс істеуге және жалдау ақысын төлеуге дайынмын.
Dialogue: 0,0:22:25.00,0:22:27.37,Default,,0,0,0,,- Гуфугуфуфу - Бірақ жалдау компаниясы не айтса да,
Dialogue: 0,0:22:27.62,0:22:29.12,Default,,0,0,0,,- Гуфуфу - Барлығы осылай дейді, солай ма?
Dialogue: 0,0:22:29.16,0:22:31.91,Default,,0,0,0,,- Ехехехехехехехе - Барлығы осылай дейді. Барлығы осылай дейді...
Dialogue: 0,0:22:35.87,0:22:38.50,Default,,0,0,0,,Бұл Киогоның қызы ма?
Dialogue: 0,0:22:38.70,0:22:45.33,Default,,0,0,0,,Хе хе хе хе хе хе хе хе хе хе мен суық тиіп қалған шығармын.
Dialogue: 0,0:23:02.70,0:23:04.37,Default,,0,0,0,,Мен айтқандай,
Dialogue: 0,0:23:04.91,0:23:06.62,Default,,0,0,0,,Бұл маңызды
Dialogue: 0,0:23:07.20,0:23:08.95,Default,,0,0,0,,Себебі мен оны сағындым
Dialogue: 0,0:23:09.50,0:23:11.08,Default,,0,0,0,,Мен қателік жібердім
Dialogue: 0,0:23:11.70,0:23:13.37,Default,,0,0,0,,Мен айтқандай,
Dialogue: 0,0:23:13.87,0:23:15.54,Default,,0,0,0,,Егер сіз осында тоқтасаңыз
Dialogue: 0,0:23:16.12,0:23:17.70,Default,,0,0,0,,Бұл қалай да болады
Dialogue: 0,0:23:18.41,0:23:20.20,Default,,0,0,0,,Жеңуге болады
Dialogue: 0,0:23:20.62,0:23:24.50,Default,,0,0,0,,Барлығы көңіл көтеруді қалайды
Dialogue: 0,0:23:25.12,0:23:28.83,Default,,0,0,0,,Әрбір адам жалғыз
Dialogue: 0,0:23:29.41,0:23:31.29,Default,,0,0,0,,Мен айтқандай,
Dialogue: 0,0:23:31.79,0:23:33.54,Default,,0,0,0,,Тағы да айтайын
Dialogue: 0,0:23:34.16,0:23:35.62,Default,,0,0,0,,Егер сіз осыны орындасаңыз
Dialogue: 0,0:23:36.04,0:23:38.00,Default,,0,0,0,,Сіз батырсыз
Dialogue: 0,0:23:38.29,0:23:40.58,Default,,0,0,0,,Уақытты өткізіп алсаңыз
Dialogue: 0,0:23:40.62,0:23:42.16,Default,,0,0,0,,Айту қиын
Dialogue: 0,0:23:42.33,0:23:48.33,Default,,0,0,0,,Мен өзімді есінен танып қалғандай сезінемін.
Dialogue: 0,0:23:49.83,0:23:51.87,Default,,0,0,0,,Бұл қарапайым.
Dialogue: 0,0:23:51.91,0:23:53.75,Default,,0,0,0,,Бұл қиын емес!
Dialogue: 0,0:23:54.37,0:23:57.83,Default,,0,0,0,,Тек бірнеше кеңес алыңыз
Dialogue: 0,0:23:58.75,0:24:00.66,Default,,0,0,0,,Басынан бері берілме
Dialogue: 0,0:24:00.79,0:24:02.66,Default,,0,0,0,,Мен мұны істей алмаймын.
Dialogue: 0,0:24:03.20,0:24:08.45,Default,,0,0,0,,Сәтсіздіктен қорықпай тырысыңыз
Dialogue: 0,0:24:19.95,0:24:21.95,Default,,0,0,0,,Күн әлі жоғары болған кездегі жарық күн
Dialogue: 0,0:24:22.12,0:24:23.83,Default,,0,0,0,,Өзіңізді ваннаға батырыңыз
Dialogue: 0,0:24:24.00,0:24:26.95,Default,,0,0,0,,«Гокураку Гокураку» деп ызылдайтыныңызға сенімдімін.
Dialogue: 0,0:24:27.08,0:24:28.70,Default,,0,0,0,,Алайда бұл өте қауіпті.
Dialogue: 0,0:24:28.75,0:24:31.54,Default,,0,0,0,,Кенет денемді қабыршақ басып, тау бұлағында қалдым.
Dialogue: 0,0:24:33.04,0:24:39.04,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory