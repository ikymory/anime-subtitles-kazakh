Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.29,0:00:05.87,Default,,0,0,0,,Жақсы
Dialogue: 0,0:00:05.95,0:00:06.79,Default,,0,0,0,,Андат
Dialogue: 0,0:00:07.50,0:00:08.83,Default,,0,0,0,,Бұл қалай да болады.
Dialogue: 0,0:00:09.50,0:00:11.25,Default,,0,0,0,,Мұнда Musik пайдаланушысы бар.
Dialogue: 0,0:00:11.29,0:00:12.79,Default,,0,0,0,,Мұнда 7 адам бар.
Dialogue: 0,0:00:13.54,0:00:16.25,Default,,0,0,0,,Бір адам жетіспейді, солай ма?
Dialogue: 0,0:00:16.58,0:00:17.45,Default,,0,0,0,,Әрине
Dialogue: 0,0:00:18.70,0:00:19.54,Default,,0,0,0,,Финал
Dialogue: 0,0:00:20.16,0:00:23.70,Default,,0,0,0,,Moderat Fine
Dialogue: 0,0:00:26.95,0:00:29.04,Default,,0,0,0,,О, мүмкін бұл рас шығар.
Dialogue: 0,0:00:29.66,0:00:31.16,Default,,0,0,0,,Шу-сан
Dialogue: 0,0:00:31.29,0:00:31.62,Default,,0,0,0,,Әй?
Dialogue: 0,0:00:34.54,0:00:36.50,Default,,0,0,0,,Стаккато сылдыры
Dialogue: 0,0:00:38.54,0:00:43.54,Default,,0,0,0,,Уу-а-а? аға?
Dialogue: 0,0:00:43.87,0:00:46.91,Default,,0,0,0,,Осы қарбалас уақытта не істеп жатырсың?
Dialogue: 0,0:00:47.16,0:00:49.62,Default,,0,0,0,,Тез кел, маған көмектесші, ақымақ.
Dialogue: 0,0:00:49.75,0:00:51.08,Default,,0,0,0,,Иә, кешіріңіз.
Dialogue: 0,0:00:51.62,0:00:52.95,Default,,0,0,0,,А-а-а
Dialogue: 0,0:00:54.45,0:00:55.08,Default,,0,0,0,,-n -иә
Dialogue: 0,0:00:55.79,0:00:58.25,Default,,0,0,0,,Хмм, хмм, бұл қалай болады.
Dialogue: 0,0:00:58.95,0:01:01.16,Default,,0,0,0,,Мұнда Musik пайдаланушысы бар.
Dialogue: 0,0:01:01.62,0:01:05.00,Default,,0,0,0,,Мұнда 7 адам бар.
Dialogue: 0,0:01:05.66,0:01:06.08,Default,,0,0,0,,Иә
Dialogue: 0,0:02:39.70,0:02:43.12,Default,,0,0,0,,Охохохохохо, кел, шынын айтайық.
Dialogue: 0,0:02:43.37,0:02:44.62,Default,,0,0,0,,Мен сені алдадым
Dialogue: 0,0:02:44.83,0:02:46.41,Default,,0,0,0,,Бұл шын мәнінде бір қабат.
Dialogue: 0,0:02:46.54,0:02:49.08,Default,,0,0,0,,Сатылым Барлығы ат жарысы туралы болды.
Dialogue: 0,0:02:50.25,0:02:51.41,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:02:52.41,0:02:55.12,Default,,0,0,0,,Жартылай пісірілген косплей жақсы емес.
Dialogue: 0,0:02:55.54,0:02:56.91,Default,,0,0,0,,Судың көтерілуі мен ағыны
Dialogue: 0,0:02:57.04,0:02:58.50,Default,,0,0,0,,Жел ентігіп, күркіреді
Dialogue: 0,0:02:58.70,0:02:59.41,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:02:59.79,0:03:01.62,Default,,0,0,0,,Мұнда қайда? Эй, мені шығар
Dialogue: 0,0:03:02.20,0:03:07.25,Default,,0,0,0,,-Әй, жаңбыр жауса - құлшылық қыл, бас и
Dialogue: 0,0:03:07.75,0:03:09.08,Default,,0,0,0,,О, күн
Dialogue: 0,0:03:09.54,0:03:10.41,Default,,0,0,0,,Бұл күн
Dialogue: 0,0:03:10.62,0:03:11.41,Default,,0,0,0,,Не болды, Ниа?
Dialogue: 0,0:03:11.54,0:03:14.08,Default,,0,0,0,,Хаха, Бада-сама.
Dialogue: 0,0:03:14.95,0:03:18.75,Default,,0,0,0,,Бах бір жүзбен көбейтеді, олар бірінен соң бірі келеді
Dialogue: 0,0:03:18.95,0:03:21.29,Default,,0,0,0,,Барлығын таң қалдырады.
Dialogue: 0,0:03:21.37,0:03:24.87,Default,,0,0,0,,Мұнда келме. Құнсызданған көшірмеге қанағаттанбаңыз.
Dialogue: 0,0:03:25.41,0:03:29.83,Default,,0,0,0,,Біздің махаббат пен қайта туылу әуенін жеткізіңіз
Dialogue: 0,0:03:31.16,0:03:31.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:31.66,0:03:32.04,Default,,0,0,0,,Бұл
Dialogue: 0,0:03:33.04,0:03:34.37,Default,,0,0,0,,Ол қатты жараланған еді...
Dialogue: 0,0:03:34.83,0:03:39.58,Default,,0,0,0,,Эй, күте тұр!
Dialogue: 0,0:03:40.08,0:03:42.54,Default,,0,0,0,,Сау болдың деп үміттенемін
Dialogue: 0,0:03:42.66,0:03:47.16,Default,,0,0,0,,Ақымақ, мен сені сүйемін, мен сені сүйемін!
Dialogue: 0,0:03:47.29,0:03:50.20,Default,,0,0,0,,Мен де, мен де
Dialogue: 0,0:03:51.45,0:03:53.12,Default,,0,0,0,,- Гваававававава - Уау
Dialogue: 0,0:03:54.08,0:03:58.29,Default,,0,0,0,,Уау, бұл адамдар керемет.
Dialogue: 0,0:03:59.00,0:04:00.70,Default,,0,0,0,,Бірдеңе бүлінген.
Dialogue: 0,0:04:00.87,0:04:01.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:01.33,0:04:01.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:01.83,0:04:02.83,Default,,0,0,0,,Сіз не істеп жүрсіз?
Dialogue: 0,0:04:04.91,0:04:06.20,Default,,0,0,0,,Дегенмен, патшаңыздың қазір есінен адасқаны анық.
Dialogue: 0,0:04:06.37,0:04:08.08,Default,,0,0,0,,А, мен одан шаршадым.
Dialogue: 0,0:04:08.33,0:04:10.16,Default,,0,0,0,,Бұл жалықтым деп айтатын уақыт емес.
Dialogue: 0,0:04:10.45,0:04:12.00,Default,,0,0,0,,Өйткені оның соңы жоқ.
Dialogue: 0,0:04:12.87,0:04:14.58,Default,,0,0,0,,Шынында да,
Dialogue: 0,0:04:15.04,0:04:16.00,Default,,0,0,0,,- Оған көмектесу мүмкін емес - Ха
Dialogue: 0,0:04:17.29,0:04:18.50,Default,,0,0,0,,Бұл жігіт мені бірден саған ғашық етеді.
Dialogue: 0,0:04:18.62,0:04:19.41,Default,,0,0,0,,Тоқта
Dialogue: 0,0:04:19.79,0:04:22.79,Default,,0,0,0,,Бірақ олар маған неге келе жатыр?
Dialogue: 0,0:04:23.16,0:04:25.20,Default,,0,0,0,,Бахтың жалғандығы неде?
Dialogue: 0,0:04:25.54,0:04:28.45,Default,,0,0,0,,Демек, оған Бахтың идеялары әсер етті.
Dialogue: 0,0:04:29.08,0:04:32.29,Default,,0,0,0,,Осы сарайға кіріп, Классикалоидты қайтарыңыз.
Dialogue: 0,0:04:32.62,0:04:35.08,Default,,0,0,0,,Бұл адамдардың басты мақсаты болуы керек.
Dialogue: 0,0:04:35.41,0:04:37.95,Default,,0,0,0,,Geez, содан кейін бүкіл әлемдегі Бах имитациялары.
Dialogue: 0,0:04:38.12,0:04:39.54,Default,,0,0,0,,Ол осында келе жатыр дейсің бе?
Dialogue: 0,0:04:39.79,0:04:40.58,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:04:41.08,0:04:43.83,Default,,0,0,0,,Сәлеметсіз бе? Сізде Утамае бар ма?
Dialogue: 0,0:04:44.08,0:04:45.62,Default,,0,0,0,,А, әке?
Dialogue: 0,0:04:46.25,0:04:47.45,Default,,0,0,0,,Ах Утаге
Dialogue: 0,0:04:47.95,0:04:50.75,Default,,0,0,0,,Қазір болып жатқан құбылыстың себебін естідің бе?
Dialogue: 0,0:04:51.08,0:04:53.16,Default,,0,0,0,,Не? Иә, көбінесе
Dialogue: 0,0:04:53.54,0:04:55.16,Default,,0,0,0,,Онда тез.
Dialogue: 0,0:04:55.66,0:04:59.00,Default,,0,0,0,,Қарастырылып отырған құрылғы Омори тауының шыңына жақын жерде.
Dialogue: 0,0:04:59.20,0:05:01.62,Default,,0,0,0,,Бұл Arche корпорациясының зерттеу мекемесінде.
Dialogue: 0,0:05:02.20,0:05:04.16,Default,,0,0,0,,Мен оны қашықтан тоқтатуға тырыстым.
Dialogue: 0,0:05:04.41,0:05:06.37,Default,,0,0,0,,Ток өшірілді, мен қателесіппін.
Dialogue: 0,0:05:07.16,0:05:10.04,Default,,0,0,0,,Сонымен Утанае, кешіріңіз, бірақ сайтқа өтіңіз.
Dialogue: 0,0:05:10.12,0:05:11.95,Default,,0,0,0,,Құрылғыны тікелей тоқтата аласыз ба?
Dialogue: 0,0:05:12.08,0:05:14.12,Default,,0,0,0,,Иә? Неліктен мен мұны істеймін?
Dialogue: 0,0:05:14.20,0:05:15.12,Default,,0,0,0,,-Жарайды -А
Dialogue: 0,0:05:15.75,0:05:17.33,Default,,0,0,0,,Утанае қатты.
Dialogue: 0,0:05:18.04,0:05:19.29,Default,,0,0,0,,Сәлем.
Dialogue: 0,0:05:19.50,0:05:22.66,Default,,0,0,0,,-Ой, планшеттің батареясы таусылып қалды... -Ааа
Dialogue: 0,0:05:23.79,0:05:24.54,Default,,0,0,0,,Аха
Dialogue: 0,0:05:25.08,0:05:27.54,Default,,0,0,0,,Қарғыс атсын, әке.
Dialogue: 0,0:05:27.75,0:05:31.04,Default,,0,0,0,,- Утанаэ-сан, бұдан былай күш қолданбауыңызды өтінемін. - Фунунунууууу
Dialogue: 0,0:05:31.29,0:05:33.50,Default,,0,0,0,,- Жарылып жатыр, жарылып жатыр - Фунууууу
Dialogue: 0,0:05:33.58,0:05:34.00,Default,,0,0,0,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:05:34.08,0:05:34.41,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:05:34.70,0:05:36.00,Default,,0,0,0,,Біз не істеуіміз керек, Утанае?
Dialogue: 0,0:05:36.95,0:05:37.58,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:05:38.62,0:05:42.58,Default,,0,0,0,,Утанае сен күшті, мейірімді баласың.
Dialogue: 0,0:05:45.12,0:05:48.29,Default,,0,0,0,,Құрылғыны тоқтатыңыз.
Dialogue: 0,0:05:48.58,0:05:49.29,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:05:49.70,0:05:51.91,Default,,0,0,0,,Мен бұл үйді қорғауды шештім.
Dialogue: 0,0:05:54.00,0:05:56.37,Default,,0,0,0,,Маған біреу көмектесе алады ма?
Dialogue: 0,0:05:56.79,0:05:58.62,Default,,0,0,0,,Зерттеу мекемесіне барып, құрылғыны өшіріңіз.
Dialogue: 0,0:05:59.54,0:06:01.41,Default,,0,0,0,,Бұл қауіпті болуы мүмкін
Dialogue: 0,0:06:01.45,0:06:02.08,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:06:02.29,0:06:03.54,Default,,0,0,0,,Аздап қызықты көрінеді.
Dialogue: 0,0:06:03.83,0:06:05.45,Default,,0,0,0,,Зомби қарсыластарынан жақсы
Dialogue: 0,0:06:05.58,0:06:06.79,Default,,0,0,0,,Маған қалдыр, котенка
Dialogue: 0,0:06:06.95,0:06:07.87,Default,,0,0,0,,Go be Go be
Dialogue: 0,0:06:08.00,0:06:08.41,Default,,0,0,0,,Иә
Dialogue: 0,0:06:09.62,0:06:11.45,Default,,0,0,0,,Е, сәл күте тұрыңыз.
Dialogue: 0,0:06:11.70,0:06:14.00,Default,,0,0,0,,Бәріміз барсақ, мына сарай не болмақ?
Dialogue: 0,0:06:14.25,0:06:16.08,Default,,0,0,0,,Мүмкін Сосуке бұл туралы бірдеңе жасайтын шығар?
Dialogue: 0,0:06:16.20,0:06:17.29,Default,,0,0,0,,Жоқ, бұл мүмкін емес.
Dialogue: 0,0:06:17.50,0:06:20.79,Default,,0,0,0,,Ал, 3 адам, жоқ, 2 адам жақсы.
Dialogue: 0,0:06:20.91,0:06:22.70,Default,,0,0,0,,Бар болғаны зәулім сарайды қорғап қалсаңыз болғаны.
Dialogue: 0,0:06:22.83,0:06:23.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:24.04,0:06:26.70,Default,,0,0,0,,Тұратын үйің болмайды, қиналып қаласың, солай ма?
Dialogue: 0,0:06:27.20,0:06:29.00,Default,,0,0,0,,Хмм, мен көмектесе алмаймын.
Dialogue: 0,0:06:29.41,0:06:30.79,Default,,0,0,0,,Енді тас, қағаз, қайшы
Dialogue: 0,0:06:31.79,0:06:35.25,Default,,0,0,0,,Тас, қағаз, қайшы, Айко, солай ма?
Dialogue: 0,0:06:35.83,0:06:40.41,Default,,0,0,0,,Шо Шо Шо Шо Шо Шо
Dialogue: 0,0:06:41.00,0:06:42.33,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:42.41,0:06:46.41,Default,,0,0,0,,Тағдыр мені таңдаған шығар, кеттік.
Dialogue: 0,0:06:52.12,0:06:53.41,Default,,0,0,0,,Ахахахахахаха
Dialogue: 0,0:06:53.95,0:06:55.50,Default,,0,0,0,,Сау бол, Ютаге
Dialogue: 0,0:06:55.70,0:06:58.25,Default,,0,0,0,,Иә, барлығыңыз маған сарай туралы айтып беріңізші.
Dialogue: 0,0:07:01.29,0:07:05.91,Default,,0,0,0,,- Фуфуфу Ахахахха - Уау Уау Уау
Dialogue: 0,0:07:09.66,0:07:11.08,Default,,0,0,0,,Кетіңіз
Dialogue: 0,0:07:11.54,0:07:12.58,Default,,0,0,0,,Меніңше... олар әлі өздерін жинастыра алмай, қиналып жатыр.
Dialogue: 0,0:07:13.16,0:07:14.16,Default,,0,0,0,,Бейіт
Dialogue: 0,0:07:14.45,0:07:17.08,Default,,0,0,0,,Құрылғы тоқтағанша оны қорғай аласыз ба?
Dialogue: 0,0:07:17.54,0:07:21.29,Default,,0,0,0,,Менің мұны істеуден басқа амалым жоқ. Күту - бұл махаббат.
Dialogue: 0,0:07:23.83,0:07:25.20,Default,,0,0,0,,Понкоцуды алыс ұстаңыз
Dialogue: 0,0:07:25.54,0:07:27.08,Default,,0,0,0,,Сіз Musik қолданбасын пайдалана алмайсыз, солай ма?
Dialogue: 0,0:07:27.29,0:07:29.04,Default,,0,0,0,,Бәлкім, мен тым алданып қалған шығармын.
Dialogue: 0,0:07:29.50,0:07:30.79,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:07:37.37,0:07:38.12,Default,,0,0,0,,Ммм
Dialogue: 0,0:07:48.12,0:07:48.54,Default,,0,0,0,,Хмм
Dialogue: 0,0:08:04.20,0:08:04.83,Default,,0,0,0,,Хмм
Dialogue: 0,0:08:07.08,0:08:07.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:16.66,0:08:19.25,Default,,0,0,0,,Уақыт келді!
Dialogue: 0,0:08:22.62,0:08:25.29,Default,,0,0,0,,Дүниедегі барлық адамдар Бах сияқты болады.
Dialogue: 0,0:08:25.66,0:08:30.20,Default,,0,0,0,,Мен де Бах үшін өте қуаныштымын.
Dialogue: 0,0:08:30.75,0:08:33.66,Default,,0,0,0,,Нағыз ұлы болмыс, бүгіннен бастап мен боламын
Dialogue: 0,0:08:33.95,0:08:36.79,Default,,0,0,0,,Маған да, өзіме де табынасың.
Dialogue: 0,0:08:37.54,0:08:42.70,Default,,0,0,0,,Сонда бұл босқа. Аа, дұрыс.
Dialogue: 0,0:08:42.91,0:08:46.08,Default,,0,0,0,,Парикті киер алдында онымен естелік суретке түсіріңіз.
Dialogue: 0,0:08:46.91,0:08:50.33,Default,,0,0,0,,Октова зақымдалды ма? неге музыка
Dialogue: 0,0:08:53.33,0:08:56.83,Default,,0,0,0,,Аа, тоқтамаған сияқты. Жер бетінде не болып жатыр?
Dialogue: 0,0:08:57.79,0:09:02.45,Default,,0,0,0,,Ноаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:09:02.58,0:09:05.66,Default,,0,0,0,,Ахаха ахаха
Dialogue: 0,0:09:06.45,0:09:07.54,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:08.95,0:09:12.33,Default,,0,0,0,,Мм, техникаға асығайық.
Dialogue: 0,0:09:14.25,0:09:16.91,Default,,0,0,0,,Хм, келесі жолы не істеуім керек?
Dialogue: 0,0:09:17.79,0:09:21.54,Default,,0,0,0,,Бұл балалар Мицуруроид Кай
Dialogue: 0,0:09:22.20,0:09:26.91,Default,,0,0,0,,Неліктен өз бетіңізше әрекет етесіз? Жоқ, бұл қазір ыңғайлырақ.
Dialogue: 0,0:09:28.83,0:09:30.33,Default,,0,0,0,,Әрбір Мицуруроидты айтыңыз
Dialogue: 0,0:09:30.95,0:09:33.45,Default,,0,0,0,,3 зиянкесті тауып, жою.
Dialogue: 0,0:09:37.70,0:09:39.79,Default,,0,0,0,,Уаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:09:41.45,0:09:42.45,Default,,0,0,0,,Ха ха
Dialogue: 0,0:09:42.79,0:09:43.33,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:45.50,0:09:47.20,Default,,0,0,0,,Иә, дәл солай
Dialogue: 0,0:09:47.95,0:09:51.25,Default,,0,0,0,,Бізге ұқсайтын бұл роботтар кімдер?
Dialogue: 0,0:09:52.45,0:09:54.25,Default,,0,0,0,,Одан алыстаңыз.
Dialogue: 0,0:09:56.33,0:09:57.08,Default,,0,0,0,,Музыка
Dialogue: 0,0:10:00.12,0:10:01.45,Default,,0,0,0,,Егер
Dialogue: 0,0:10:08.45,0:10:10.04,Default,,0,0,0,,Алыс кет, ұқсайсың.
Dialogue: 0,0:10:14.04,0:10:16.41,Default,,0,0,0,,Ахаха, тіпті Musik қолданбасын пайдалануға болады.
Dialogue: 0,0:10:16.83,0:10:19.70,Default,,0,0,0,,Екеуміз бірге ішімдік ішсек, қыздарға ұнайтын еді.
Dialogue: 0,0:10:20.16,0:10:21.45,Default,,0,0,0,,Елеусіз робот көзі
Dialogue: 0,0:10:22.45,0:10:25.29,Default,,0,0,0,,Маған еліктеу мәңгілік жылдам
Dialogue: 0,0:10:25.62,0:10:29.41,Default,,0,0,0,,-Менің бақытты уақытым -ну
Dialogue: 0,0:10:30.00,0:10:30.37,Default,,0,0,0,,болып табылады
Dialogue: 0,0:10:31.20,0:10:32.87,Default,,0,0,0,,Хабуа кофе-брейгі
Dialogue: 0,0:10:34.04,0:10:37.91,Default,,0,0,0,,Тәтті армандардың жемісі
Dialogue: 0,0:10:38.37,0:10:41.66,Default,,0,0,0,,-Жыртып, тұмсықтыға толтыр -А
Dialogue: 0,0:10:42.12,0:10:45.50,Default,,0,0,0,,-Көз нұрында -Ах
Dialogue: 0,0:10:45.66,0:10:49.54,Default,,0,0,0,,- Күйген ауру да - Ахх
Dialogue: 0,0:10:50.29,0:10:52.04,Default,,0,0,0,,Бұл су өткізбейтін сияқты.
Dialogue: 0,0:10:54.75,0:10:56.58,Default,,0,0,0,,Эй, бұл туралы не деуге болады?
Dialogue: 0,0:10:59.12,0:11:03.08,Default,,0,0,0,,Белгілі бір жемісті қуырып жесеңіз
Dialogue: 0,0:11:03.16,0:11:05.08,Default,,0,0,0,,Өлім алдында тұрған адам
Dialogue: 0,0:11:09.87,0:11:11.75,Default,,0,0,0,,Бұл бұзылды ма?
Dialogue: 0,0:11:12.91,0:11:16.87,Default,,0,0,0,,Неліктен олар деректерде жоқ музыка жасайды?
Dialogue: 0,0:11:18.25,0:11:20.54,Default,,0,0,0,,Бұл оның мен күткеннен де көп дамығанын білдіре ме?
Dialogue: 0,0:11:21.29,0:11:24.04,Default,,0,0,0,,Ал, алдымен Октованы жөндеп алайық.
Dialogue: 0,0:11:25.91,0:11:27.45,Default,,0,0,0,,Сіз оны жеңдіңіз бе?
Dialogue: 0,0:11:28.00,0:11:29.45,Default,,0,0,0,,Хмм, ұқсайды.
Dialogue: 0,0:11:29.79,0:11:31.91,Default,,0,0,0,,Өйткені, бұл жәй ғана қоқыс
Dialogue: 0,0:11:32.54,0:11:33.95,Default,,0,0,0,,Біздің жау емес
Dialogue: 0,0:11:34.37,0:11:34.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:39.37,0:11:42.25,Default,,0,0,0,,Ой, бірдеңе келді. Көп келді.
Dialogue: 0,0:11:42.91,0:11:44.41,Default,,0,0,0,,Хм, 5 адам?
Dialogue: 0,0:11:44.75,0:11:47.00,Default,,0,0,0,,Қасқыр, мен саған бұларды беремін.
Dialogue: 0,0:11:47.33,0:11:50.45,Default,,0,0,0,,Е, жоқ, бұл азап, Лу-кун істе.
Dialogue: 0,0:11:50.79,0:11:53.54,Default,,0,0,0,,Өзімшіл бейбақ, тағы да тас, қағаз, қайшы ойнаймыз.
Dialogue: 0,0:11:53.62,0:11:55.41,Default,,0,0,0,,Ал, енді аяқпен тас, қағаз, қайшы ойнайтын кез келді.
Dialogue: 0,0:11:55.75,0:11:56.91,Default,,0,0,0,,Тас, қағаз, аяғы бар қайшы?
Dialogue: 0,0:11:57.08,0:11:59.25,Default,,0,0,0,,Бұл абзац. Бұл қайшы.
Dialogue: 0,0:11:59.54,0:12:01.66,Default,,0,0,0,,Тоқта, бұл неліктен қайшы?
Dialogue: 0,0:12:01.87,0:12:03.12,Default,,0,0,0,,Бұл қайшы сияқты, солай ма?
Dialogue: 0,0:12:03.25,0:12:04.37,Default,,0,0,0,,Мен келіспеймін.
Dialogue: 0,0:12:04.41,0:12:05.95,Default,,0,0,0,,Бұл өзімшілдік.
Dialogue: 0,0:12:06.04,0:12:08.50,Default,,0,0,0,,Эй, бәрі күтіп тұр.
Dialogue: 0,0:12:10.12,0:12:13.58,Default,,0,0,0,,Гу бұл ха ха ха ха ха
Dialogue: 0,0:12:14.08,0:12:15.83,Default,,0,0,0,,Күшейткіштің бір бөлігі зақымдалған
Dialogue: 0,0:12:16.41,0:12:18.70,Default,,0,0,0,,Негізгі жүйе қандай да бір түрде а
Dialogue: 0,0:12:19.91,0:12:20.33,Default,,0,0,0,,Сәлем
Dialogue: 0,0:12:21.45,0:12:22.91,Default,,0,0,0,,-Қараңдар, мұқият қараңдар -Қасқыр
Dialogue: 0,0:12:23.20,0:12:24.25,Default,,0,0,0,,- Бұл қайшы. Бұл қайшы. - Өзіңізге ыңғайлы ережелерді жасаңыз.
Dialogue: 0,0:12:24.29,0:12:25.45,Default,,0,0,0,,-Мені араластырма -О, уже.
Dialogue: 0,0:12:25.83,0:12:28.04,Default,,0,0,0,,Қазір мұны жасайтын уақыт емес.
Dialogue: 0,0:12:28.16,0:12:28.45,Default,,0,0,0,,-Гу-де
Dialogue: 0,0:12:29.16,0:12:30.29,Default,,0,0,0,,Басталып жатыр!
Dialogue: 0,0:12:30.54,0:12:32.58,Default,,0,0,0,,-Арман болса -ха
Dialogue: 0,0:12:33.00,0:12:33.62,Default,,0,0,0,,- Кішкентай қыз - Ән көшеттері
Dialogue: 0,0:12:40.50,0:12:41.75,Default,,0,0,0,,Бұл музыка
Dialogue: 0,0:12:42.00,0:12:42.91,Default,,0,0,0,,Га
Dialogue: 0,0:12:49.00,0:12:50.04,Default,,0,0,0,,Бах мырза
Dialogue: 0,0:13:01.83,0:13:04.45,Default,,0,0,0,,Олар әжептәуір алысқа қашып кеткен болар...
Dialogue: 0,0:13:08.20,0:13:09.33,Default,,0,0,0,,Басталып жатыр!
Dialogue: 0,0:13:09.37,0:13:10.37,Default,,0,0,0,,Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады
Dialogue: 0,0:13:10.45,0:13:15.45,Default,,0,0,0,,-АхЕгер жаңбыр жауса -хаха
Dialogue: 0,0:13:16.16,0:13:17.66,Default,,0,0,0,,Сіз мұны істейсіз.
Dialogue: 0,0:13:17.79,0:13:18.12,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:13:18.20,0:13:20.41,Default,,0,0,0,,Оған көмектесу мүмкін емес, өйткені басқа ештеңе жоқ.
Dialogue: 0,0:13:20.50,0:13:21.04,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:13:21.16,0:13:21.83,Default,,0,0,0,,Бір соққының кереметі
Dialogue: 0,0:13:21.95,0:13:23.91,Default,,0,0,0,,Хмм, шулы
Dialogue: 0,0:13:31.91,0:13:36.12,Default,,0,0,0,,Неге, неге, Бах мырза, Бах мырза
Dialogue: 0,0:13:36.41,0:13:39.08,Default,,0,0,0,,Үздік классикалық және идеалды жүзеге асыру
Dialogue: 0,0:13:39.54,0:13:41.04,Default,,0,0,0,,Ондай адамдарға сенудің қажеті жоқ.
Dialogue: 0,0:13:41.29,0:13:44.16,Default,,0,0,0,,Бахтың ойлары мен музыкасы арқылы бүкіл адамзат біртұтас бола алса
Dialogue: 0,0:13:44.33,0:13:47.87,Default,,0,0,0,,Мен идеалды дүние жасай білуім керек, сондықтан мен
Dialogue: 0,0:13:47.91,0:13:49.66,Default,,0,0,0,,Мицуруроидты алыңыз.
Dialogue: 0,0:13:50.91,0:13:51.33,Default,,0,0,0,,Әй
Dialogue: 0,0:13:52.45,0:13:54.37,Default,,0,0,0,,Сіз ештеңе түсінбейсіз
Dialogue: 0,0:13:55.04,0:13:55.45,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:56.41,0:13:59.37,Default,,0,0,0,,Музыка тек бір түстен тұруы мүмкін емес.
Dialogue: 0,0:14:00.29,0:14:03.75,Default,,0,0,0,,Әртүрлі дыбыстар қабаттасып, резонанс тудырып, тон жасайды.
Dialogue: 0,0:14:05.29,0:14:07.00,Default,,0,0,0,,Мен таныған сегіз дыбыс
Dialogue: 0,0:14:08.04,0:14:12.08,Default,,0,0,0,,Сегіз данышпан музыкант ойнаған дыбыстар шкала жасағанда
Dialogue: 0,0:14:12.87,0:14:15.91,Default,,0,0,0,,Бұл дүниені алғаш рет үзілмеген үн толтырады.
Dialogue: 0,0:14:16.41,0:14:17.70,Default,,0,0,0,,Әлем өзгереді
Dialogue: 0,0:14:18.58,0:14:19.41,Default,,0,0,0,,Ой, иә
Dialogue: 0,0:14:19.58,0:14:23.62,Default,,0,0,0,,- Сондықтан қалған жетеуі оянғанша күттім - Уф.
Dialogue: 0,0:14:24.25,0:14:24.87,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:14:25.08,0:14:26.04,Default,,0,0,0,,Кең
Dialogue: 0,0:14:26.08,0:14:27.62,Default,,0,0,0,,Бұл бұзылды ма?
Dialogue: 0,0:14:28.29,0:14:31.20,Default,,0,0,0,,Ал енді уақыт келді
Dialogue: 0,0:14:39.75,0:14:41.29,Default,,0,0,0,,Жаңа әлем
Dialogue: 0,0:14:41.79,0:14:44.66,Default,,0,0,0,,Музыка тек музыка ретінде өмір сүре алады
Dialogue: 0,0:14:44.70,0:14:46.12,Default,,0,0,0,,Неліктен әлем жасамасқа?
Dialogue: 0,0:14:46.33,0:14:46.95,Default,,0,0,0,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:14:47.04,0:14:47.70,Default,,0,0,0,,Жоқ
Dialogue: 0,0:14:48.54,0:14:53.37,Default,,0,0,0,,Олай болса, бар күшіңмен артымнан ергеннен басқа амалым жоқ.
Dialogue: 0,0:14:53.54,0:14:54.08,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:14:57.45,0:14:58.20,Default,,0,0,0,,Жақсы
Dialogue: 0,0:14:58.41,0:14:59.75,Default,,0,0,0,,Фермата
Dialogue: 0,0:14:59.91,0:15:01.58,Default,,0,0,0,,Оның соңы жоқ.
Dialogue: 0,0:15:01.95,0:15:04.12,Default,,0,0,0,,Осы қарқынмен мен бұралып қаламын.
Dialogue: 0,0:15:08.41,0:15:09.58,Default,,0,0,0,,Уф
Dialogue: 0,0:15:11.37,0:15:14.16,Default,,0,0,0,,Егер сіз музыкант болсаңыз, оны сіз де сезетін шығарсыз.
Dialogue: 0,0:15:14.83,0:15:18.12,Default,,0,0,0,,Бұл дүниенің музыкасы қаншалықты бұрмаланған?
Dialogue: 0,0:15:18.75,0:15:22.45,Default,,0,0,0,,Ыстық судай тұтынып, лақтырылатын әндер
Dialogue: 0,0:15:23.16,0:15:27.04,Default,,0,0,0,,Адамдар музыканың өзін емес, фон ретінде тыңдайды.
Dialogue: 0,0:15:27.25,0:15:31.25,Default,,0,0,0,,Музыканы жағдай және хабар ретінде іздеу
Dialogue: 0,0:15:32.00,0:15:33.62,Default,,0,0,0,,Музыкантты халық қалай атайды?
Dialogue: 0,0:15:34.08,0:15:35.87,Default,,0,0,0,,Музыканы жасаушы емес
Dialogue: 0,0:15:36.58,0:15:40.70,Default,,0,0,0,,Дыбыстарды сұрау бойынша реттеп, құрастырушы.
Dialogue: 0,0:15:41.37,0:15:44.79,Default,,0,0,0,,Өкінішке орай, содан бері бұл өзгерген жоқ.
Dialogue: 0,0:15:46.25,0:15:50.04,Default,,0,0,0,,Сіз бұл әлемді өзгерткіңіз келмейді ме?
Dialogue: 0,0:15:51.33,0:15:52.12,Default,,0,0,0,,Мүлде жоқ
Dialogue: 0,0:15:52.41,0:15:52.95,Default,,0,0,0,,Мен олай ойламаймын
Dialogue: 0,0:15:53.33,0:15:54.00,Default,,0,0,0,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:15:54.70,0:15:56.83,Default,,0,0,0,,Оның не сұрағанын кім білген?
Dialogue: 0,0:15:57.33,0:16:00.70,Default,,0,0,0,,Мен тек әуесқойлықпен ойнаймын.
Dialogue: 0,0:16:00.91,0:16:02.20,Default,,0,0,0,,Бұл көңіл-күй, солай емес пе?
Dialogue: 0,0:16:02.50,0:16:05.70,Default,,0,0,0,,Тегіс бол, еркін бол, еркін бол.
Dialogue: 0,0:16:07.70,0:16:12.50,Default,,0,0,0,,Құштарлық пен құштарлық бір бөлек, еркіндік пен азғындық бір бөлек дедім.
Dialogue: 0,0:16:14.25,0:16:15.20,Default,,0,0,0,,Байқамайсың ба?
Dialogue: 0,0:16:15.70,0:16:18.12,Default,,0,0,0,,Сіз қазірдің өзінде өзгере бастадыңыз.
Dialogue: 0,0:16:18.29,0:16:18.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:20.50,0:16:23.25,Default,,0,0,0,,Енді сіздердің барлығыңызда бекітілген зал бар.
Dialogue: 0,0:16:24.29,0:16:26.16,Default,,0,0,0,,Менің ойнайтын достарым бар.
Dialogue: 0,0:16:26.95,0:16:29.83,Default,,0,0,0,,Жанды әдептілікті қолданатын тамаша дирижер бар.
Dialogue: 0,0:16:30.87,0:16:33.00,Default,,0,0,0,,Сол қарапайым концертті қорғау үшін
Dialogue: 0,0:16:33.37,0:16:35.70,Default,,0,0,0,,Ол күнде музыка ойнап жүрген болуы керек.
Dialogue: 0,0:16:36.75,0:16:38.58,Default,,0,0,0,,Хмм? Әдептілігіңізді шайқаңыз ба?
Dialogue: 0,0:16:38.91,0:16:40.20,Default,,0,0,0,,Жақсы дирижер?
Dialogue: 0,0:16:40.62,0:16:41.25,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:16:41.33,0:16:41.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:42.41,0:16:44.37,Default,,0,0,0,,Музыкант деген осы.
Dialogue: 0,0:16:45.16,0:16:49.29,Default,,0,0,0,,Өзіңіз сенетін бір нүктеге қатысты ең жақсы музыканы жасаңыз
Dialogue: 0,0:16:50.41,0:16:54.25,Default,,0,0,0,,Жалғыз бостандық пен бақытты бостандық арасындағы күрес
Dialogue: 0,0:16:54.66,0:16:59.87,Default,,0,0,0,,Қиындық пен қасіретімде іздегенім
Dialogue: 0,0:17:00.33,0:17:03.20,Default,,0,0,0,,Бұл азаптан құтылған дүние.
Dialogue: 0,0:17:04.58,0:17:06.75,Default,,0,0,0,,Бах мырза
Dialogue: 0,0:17:07.08,0:17:09.00,Default,,0,0,0,,Сіз қандай әлем құруды жоспарлап отырсыз?
Dialogue: 0,0:17:10.33,0:17:13.04,Default,,0,0,0,,Барлық нәрсенің негізін музыка құрайтын әлем
Dialogue: 0,0:17:13.66,0:17:16.83,Default,,0,0,0,,Онда барлық адамдар классикалоидтарға айналады.
Dialogue: 0,0:17:17.16,0:17:19.37,Default,,0,0,0,,Музыка жалпы тілге айналады
Dialogue: 0,0:17:20.12,0:17:23.79,Default,,0,0,0,,Адамдар музыка арқылы сөйлеседі, күледі және өмір сүреді.
Dialogue: 0,0:17:24.62,0:17:26.83,Default,,0,0,0,,Музыка сіздің кім екеніңізге айналады.
Dialogue: 0,0:17:27.83,0:17:29.70,Default,,0,0,0,,Музыка ерекше нәрсе емес
Dialogue: 0,0:17:30.54,0:17:32.91,Default,,0,0,0,,Дүниені ауадай толтырады
Dialogue: 0,0:17:33.79,0:17:36.04,Default,,0,0,0,,Иә, бұл ерекше нәрсе.
Dialogue: 0,0:17:36.54,0:17:39.66,Default,,0,0,0,,Осындай дүниені көргің келмей ме?
Dialogue: 0,0:17:40.37,0:17:41.41,Default,,0,0,0,,Ах ха
Dialogue: 0,0:17:41.58,0:17:42.37,Default,,0,0,0,,-Мүлдем емес -А
Dialogue: 0,0:17:42.62,0:17:43.29,Default,,0,0,0,,Мен олай ойламаймын
Dialogue: 0,0:17:43.58,0:17:44.50,Default,,0,0,0,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:17:44.75,0:17:47.37,Default,,0,0,0,,Сіз гиоза жеп көрдіңіз бе?
Dialogue: 0,0:17:48.29,0:17:48.83,Default,,0,0,0,,Не?
Dialogue: 0,0:17:49.25,0:17:52.20,Default,,0,0,0,,Мен гиоза пісіргенде музыканы ұмытып қаламын
Dialogue: 0,0:17:52.58,0:17:55.08,Default,,0,0,0,,Ет, көкөніс және терінің үйлесімді үйлесімі үшін
Dialogue: 0,0:17:55.29,0:17:57.00,Default,,0,0,0,,Өйткені мен оған жан-тәнімді салдым.
Dialogue: 0,0:17:57.45,0:18:00.25,Default,,0,0,0,,Ал мен тамаша піскен өнер туындысынан дәм татқан кезде
Dialogue: 0,0:18:00.29,0:18:03.50,Default,,0,0,0,,Ойнағыңыз келетін музыка
Dialogue: 0,0:18:03.83,0:18:04.83,Default,,0,0,0,,Неліктен бөлінбейді?
Dialogue: 0,0:18:04.91,0:18:07.25,Default,,0,0,0,,Музыканы мәжбүрлеу керек
Dialogue: 0,0:18:07.70,0:18:11.25,Default,,0,0,0,,Сүп-сүйкімді қыздармен көп күлгенім дұрыс
Dialogue: 0,0:18:11.50,0:18:13.95,Default,,0,0,0,,Сіздің миыңызда ән табиғи түрде ойнай бастайды, солай емес пе?
Dialogue: 0,0:18:14.20,0:18:16.16,Default,,0,0,0,,Не? Немесе бұл қызықты ма?
Dialogue: 0,0:18:16.25,0:18:18.83,Default,,0,0,0,,Әрқашан музыка, иә? Жоқ емес пе?
Dialogue: 0,0:18:19.37,0:18:20.45,Default,,0,0,0,,ақымақ
Dialogue: 0,0:18:20.79,0:18:23.79,Default,,0,0,0,,Кемелсіз әлемде қалуға батылы бар ма?
Dialogue: 0,0:18:24.66,0:18:28.04,Default,,0,0,0,,Музыка арқылы сөйлесе алсақ, түсінбеушілік, түсінбеушілік болмайды.
Dialogue: 0,0:18:28.50,0:18:32.29,Default,,0,0,0,,Кез келген адаммен, тек адамдармен емес, жануарлармен.
Dialogue: 0,0:18:32.91,0:18:35.29,Default,,0,0,0,,Жоқ, тіпті басқа әлемнің адамдарымен де.
Dialogue: 0,0:18:35.54,0:18:37.62,Default,,0,0,0,,Біз сөйлесе аламыз.
Dialogue: 0,0:18:37.79,0:18:41.29,Default,,0,0,0,,Аузыңды жап, саған бір ғана айтайын дегенім бар.
Dialogue: 0,0:18:42.75,0:18:45.25,Default,,0,0,0,,Бұлай бастық болмаңыз
Dialogue: 0,0:18:47.04,0:18:53.58,Default,,0,0,0,,Әй, тағы бір осар!
Dialogue: 0,0:18:57.33,0:18:59.16,Default,,0,0,0,,Артық айтпа
Dialogue: 0,0:19:07.54,0:19:10.04,Default,,0,0,0,,Бірақ бұл жалғыздық болуы мүмкін
Dialogue: 0,0:19:10.33,0:19:10.70,Default,,0,0,0,,Хмм
Dialogue: 0,0:19:11.87,0:19:14.66,Default,,0,0,0,,Бізде ескі жазбалар өте көп.
Dialogue: 0,0:19:15.20,0:19:17.29,Default,,0,0,0,,Әже пластинкаларды жақсы көреді.
Dialogue: 0,0:19:18.54,0:19:20.66,Default,,0,0,0,,Қуанышты нәрсе болған күндерде
Dialogue: 0,0:19:21.12,0:19:23.08,Default,,0,0,0,,Мені әжем үнемі шақыратын.
Dialogue: 0,0:19:23.91,0:19:29.45,Default,,0,0,0,,Маған сол сәт ұнады, қазір де сол әнді тыңдасам,
Dialogue: 0,0:19:29.83,0:19:34.58,Default,,0,0,0,,Әжемнің жүзі емес, күлкісі есімде.
Dialogue: 0,0:19:35.37,0:19:41.50,Default,,0,0,0,,Ерекше күндерде тыңдауға болатын иістер мен дауыстар, ерекше музыка
Dialogue: 0,0:19:43.37,0:19:45.45,Default,,0,0,0,,Музыка әрқашан бола бермейді
Dialogue: 0,0:19:46.00,0:19:47.95,Default,,0,0,0,,Менің ойымша, бұл ерекше.
Dialogue: 0,0:19:48.83,0:19:52.33,Default,,0,0,0,,Бұл қалыпты жағдайға айналса, сәл жалғыздық болар еді.
Dialogue: 0,0:19:54.08,0:19:57.91,Default,,0,0,0,,Менің әжем туралы басқа да естеліктерім бар.
Dialogue: 0,0:19:58.62,0:19:59.62,Default,,0,0,0,,Кез келген музыка
Dialogue: 0,0:20:00.12,0:20:03.41,Default,,0,0,0,,Өйткені әрқайсымызда маңызды естеліктер бар.
Dialogue: 0,0:20:05.08,0:20:07.50,Default,,0,0,0,,Естеліктер га
Dialogue: 0,0:20:21.91,0:20:22.87,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:20:25.20,0:20:27.25,Default,,0,0,0,,Өткізілмелі
Dialogue: 0,0:20:27.45,0:20:28.87,Default,,0,0,0,,Hör mal, meine
Dialogue: 0,0:20:29.50,0:20:31.66,Default,,0,0,0,,Музыка.
Dialogue: 0,0:20:34.62,0:20:37.00,Default,,0,0,0,,Гааааа
Dialogue: 0,0:20:41.25,0:20:42.79,Default,,0,0,0,,Гааааа
Dialogue: 0,0:20:45.54,0:20:48.25,Default,,0,0,0,,Ах ха ха ха
Dialogue: 0,0:21:10.54,0:21:11.75,Default,,0,0,0,,О?
Dialogue: 0,0:21:12.08,0:21:13.70,Default,,0,0,0,,А мен
Dialogue: 0,0:21:14.00,0:21:14.45,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:21:14.70,0:21:15.45,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан Қабырғаны бұзып өтті,
Dialogue: 0,0:21:15.83,0:21:17.91,Default,,0,0,0,,Бахтың музыкасы ойнауды тоқтатқан сияқты.
Dialogue: 0,0:21:19.04,0:21:20.08,Default,,0,0,0,,-Аа -Білмеймін.
Dialogue: 0,0:21:24.58,0:21:29.45,Default,,0,0,0,,Ой, біттің бе? Күткендей ол мақтаншақ қызы.
Dialogue: 0,0:21:34.83,0:21:37.25,Default,,0,0,0,,Эй, жақсысың ба? Осындай нәрсе жасаңыз
Dialogue: 0,0:21:37.29,0:21:40.50,Default,,0,0,0,,Бұл тым көп емес пе? Егер сізден жөндеу ақысы алынса
Dialogue: 0,0:21:41.20,0:21:43.12,Default,,0,0,0,,Хмм, бұл тым көп, Вольф.
Dialogue: 0,0:21:43.29,0:21:44.37,Default,,0,0,0,,Сіз Лусыз, солай ма?
Dialogue: 0,0:21:44.70,0:21:47.12,Default,,0,0,0,,Мен көмектесе алмаймын, кішкентай қыз маған мұны істе дейді.
Dialogue: 0,0:21:47.45,0:21:49.00,Default,,0,0,0,,Utanae Бұл аяусыз, солай емес пе?
Dialogue: 0,0:21:49.29,0:21:51.62,Default,,0,0,0,,Иә? Балалар сендер не туралы айтып тұрсыңдар?
Dialogue: 0,0:21:51.70,0:21:52.62,Default,,0,0,0,,(Ино Хацусе) Қош келдіңіздер, Элькия патшасы, Лорд Сора, Лорд Широ.
Dialogue: 0,0:21:53.00,0:21:53.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:53.70,0:21:54.41,Default,,0,0,0,,Бах
Dialogue: 0,0:21:54.66,0:21:55.66,Default,,0,0,0,,А, ол тірі еді.
Dialogue: 0,0:21:56.25,0:21:59.95,Default,,0,0,0,,Ал, бұл ешқандай төлемді білдіреді, солай емес пе?
Dialogue: 0,0:22:00.70,0:22:01.29,Default,,0,0,0,,Адам аяғы тимейтін орынды әдейі таңдаған...
Dialogue: 0,0:22:02.66,0:22:08.41,Default,,0,0,0,,Аа, мен сендермен әлі тіл табыспаймын.
Dialogue: 0,0:22:09.33,0:22:11.12,Default,,0,0,0,,Әй, бір-біріміз.
Dialogue: 0,0:22:11.50,0:22:14.29,Default,,0,0,0,,Бірақ Бах таң қаларлықтай ойнақы.
Dialogue: 0,0:22:14.45,0:22:17.45,Default,,0,0,0,,Бұрын біз басқа әлемнің тұрғындарымен тіл табыса алатынбыз.\NСіз
Dialogue: 0,0:22:17.54,0:22:18.95,Default,,0,0,0,,айтпадыңыз ба?
Dialogue: 0,0:22:19.25,0:22:22.62,Default,,0,0,0,,Енді ойлап қарасам, а, бұл не?
Dialogue: 0,0:22:22.83,0:22:24.79,Default,,0,0,0,,А, мүмкін шетелдіктер шығар?
Dialogue: 0,0:22:24.87,0:22:26.50,Default,,0,0,0,,Ахахаха?
Dialogue: 0,0:22:28.37,0:22:28.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:29.45,0:22:30.25,Default,,0,0,0,,О
Dialogue: 0,0:22:30.29,0:22:31.41,Default,,0,0,0,,Ооо
Dialogue: 0,0:22:32.04,0:22:34.29,Default,,0,0,0,,Ааааааааааааааааааааааааа
Dialogue: 0,0:22:36.00,0:22:37.87,Default,,0,0,0,,А-а-а-а
Dialogue: 0,0:22:38.62,0:22:40.00,Default,,0,0,0,,Ақыры келді ме?
Dialogue: 0,0:23:00.33,0:23:30.50,Default,,0,0,0,,Барлығы сүйіспеншіліктен, бәрі құтқарылды, бәрі қорғалады.
Dialogue: 0,0:23:35.66,0:23:40.75,Default,,0,0,0,,Әр адам махаббатпен қоршалған
Dialogue: 0,0:23:50.83,0:23:53.33,Default,,0,0,0,,Бұл дүние тым көп ағып жатыр
Dialogue: 0,0:23:53.54,0:23:59.75,Default,,0,0,0,,Дыбыспен бірге дыбысты Құдай қабылдайды
Dialogue: 0,0:23:59.95,0:24:04.54,Default,,0,0,0,,Кейде жүрегім өртеніп кетеді
Dialogue: 0,0:24:05.04,0:24:12.37,Default,,0,0,0,,Барлығы тыныштықты қалайды, бірақ
Dialogue: 0,0:24:12.54,0:24:14.50,Default,,0,0,0,,Қызғаныш
Dialogue: 0,0:24:20.00,0:24:23.83,Default,,0,0,0,,Хуухахахаха? сурет? Өтірік? Бөтен планеталық?
Dialogue: 0,0:24:24.04,0:24:26.20,Default,,0,0,0,,Музыка іздеп мына жерге? Неліктен?
Dialogue: 0,0:24:26.50,0:24:28.75,Default,,0,0,0,,Себебі белгісіз, бірақ дағдарыс.
Dialogue: 0,0:24:29.00,0:24:31.50,Default,,0,0,0,,Бұл шынымен де адамзаттың аман қалу дағдарысы.
Dialogue: 0,0:24:33.00,0:24:39.00,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory