Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.42,0:00:11.59,Default,,0,0,0,,Цк, сен табандысың.
Dialogue: 0,0:00:21.64,0:00:22.93,Default,,0,0,0,,Соңында?
Dialogue: 0,0:00:23.02,0:00:27.56,Default,,0,0,0,,Үйге барғым келеді... Ұстаз... Ұстаз...
Dialogue: 0,0:00:27.65,0:00:29.44,Default,,0,0,0,,Мен сені үйге апарамын
Dialogue: 0,0:00:30.32,0:00:31.69,Default,,0,0,0,,Ештеңе!
Dialogue: 0,0:00:32.53,0:00:33.95,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:00:34.03,0:00:39.03,Default,,0,0,0,,♪～
Dialogue: 0,0:01:58.61,0:02:03.91,Default,,0,0,0,,～♪
Dialogue: 0,0:02:03.99,0:02:05.91,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:02:06.83,0:02:08.54,Default,,0,0,0,,Белл мырза, кешіріңіз.
Dialogue: 0,0:02:08.62,0:02:11.17,Default,,0,0,0,,Балаларды маған қалдырыңыз.
Dialogue: 0,0:02:11.25,0:02:13.67,Default,,0,0,0,,Жоқ, жоқ, бұл арзан.
Dialogue: 0,0:02:13.75,0:02:15.59,Default,,0,0,0,,-Сәлем! -иә?
Dialogue: 0,0:02:15.67,0:02:17.59,Default,,0,0,0,,Дунканға қош келдіңіз
Dialogue: 0,0:02:17.67,0:02:19.43,Default,,0,0,0,,Тренинг қалай өтті?
Dialogue: 0,0:02:19.51,0:02:21.14,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:02:21.22,0:02:24.89,Default,,0,0,0,,Бұл ауылдың жастары өздерінің ақылдылығына таң қалды.
Dialogue: 0,0:02:24.97,0:02:28.27,Default,,0,0,0,,Мұғалім өте жақсы болды деп ойлаймын.
Dialogue: 0,0:02:28.35,0:02:30.44,Default,,0,0,0,,Эй, эй, өтінемін.
Dialogue: 0,0:02:30.52,0:02:32.06,Default,,0,0,0,,А, бұл Дункан!
Dialogue: 0,0:02:32.15,0:02:33.48,Default,,0,0,0,,Бұл рас!
Dialogue: 0,0:02:33.57,0:02:34.69,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:02:34.77,0:02:38.19,Default,,0,0,0,,(Балалардың толқуы)
Dialogue: 0,0:02:38.28,0:02:41.20,Default,,0,0,0,,Хахахаха, сен танымал емессің бе?
Dialogue: 0,0:02:41.28,0:02:44.95,Default,,0,0,0,,Дегенмен, мен сізге қалай жақындарымды әлі білмеймін...
Dialogue: 0,0:02:45.03,0:02:48.66,Default,,0,0,0,,Уайымдама, мен үйреніп қалдым.
Dialogue: 0,0:02:49.37,0:02:52.67,Default,,0,0,0,,Мен сені алғаш көргенде таң қалдым.
Dialogue: 0,0:02:53.50,0:02:56.05,Default,,0,0,0,,Менің атым Дункан.
Dialogue: 0,0:02:56.13,0:02:58.67,Default,,0,0,0,,Әйгілі мықтымен матч іздеу
Dialogue: 0,0:02:58.76,0:03:01.43,Default,,0,0,0,,Мен елдерді кезіп жүрген авантюристпін.
Dialogue: 0,0:03:02.34,0:03:03.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:03.76,0:03:08.68,Default,,0,0,0,,Мен Акаони-дононың қылыш шеберлігін көру үшін келдім!
Dialogue: 0,0:03:08.77,0:03:10.39,Default,,0,0,0,,Дункан келді
Dialogue: 0,0:03:10.48,0:03:12.27,Default,,0,0,0,,Бұл маған шынымен көмектесті
Dialogue: 0,0:03:12.35,0:03:16.27,Default,,0,0,0,,Соңғы уақытта сиқырлы аңдардың пайда болу жиілігі артты.
Dialogue: 0,0:03:16.36,0:03:20.24,Default,,0,0,0,,Дунканның мұнда ауыл тұрғыны болуға мүмкіндігі бар.
Dialogue: 0,0:03:20.32,0:03:24.70,Default,,0,0,0,,Хахаха Оның тамыры өскені сөзсіз.
Dialogue: 0,0:03:24.78,0:03:27.91,Default,,0,0,0,,Сіз отырып әйел іздегіңіз келе ме?
Dialogue: 0,0:03:27.99,0:03:30.25,Default,,0,0,0,,Бұл да жаман емес.
Dialogue: 0,0:03:30.33,0:03:31.54,Default,,0,0,0,,- (Күйген) Белл мырза! - (Дункан Бергрифф) Иә?
Dialogue: 0,0:03:32.33,0:03:35.04,Default,,0,0,0,,Ауылдың шетінде сиқырлы аңдар тобы пайда болды!
Dialogue: 0,0:03:35.71,0:03:37.05,Default,,0,0,0,,Хмм
Dialogue: 0,0:03:39.46,0:03:40.34,Default,,0,0,0,,Уф
Dialogue: 0,0:03:40.42,0:03:43.26,Default,,0,0,0,,Дұрыс, оларды бір-бірден түсіріп алыңыз.
Dialogue: 0,0:03:43.34,0:03:44.18,Default,,0,0,0,,Уау
Dialogue: 0,0:03:44.26,0:03:46.64,Default,,0,0,0,,Негізінен тазартылған сияқты.
Dialogue: 0,0:03:46.72,0:03:49.14,Default,,0,0,0,,Жарайсың, тамаша жұмыс
Dialogue: 0,0:03:49.22,0:03:51.10,Default,,0,0,0,,Хаха...
Dialogue: 0,0:03:51.18,0:03:54.19,Default,,0,0,0,,Қызық, мен де авантюрист бола аламын ба?
Dialogue: 0,0:03:54.27,0:03:55.73,Default,,0,0,0,,Олай болса
Dialogue: 0,0:03:55.81,0:03:59.23,Default,,0,0,0,,Бірақ ауылдан кетсең, әкең мұңаяды.
Dialogue: 0,0:03:59.32,0:04:00.15,Default,,0,0,0,,Ах
Dialogue: 0,0:04:00.24,0:04:02.40,Default,,0,0,0,,Хмм, бірақ...
Dialogue: 0,0:04:02.49,0:04:06.03,Default,,0,0,0,,Қазір Дункан екеуміз сенімен біргеміз.
Dialogue: 0,0:04:06.12,0:04:09.16,Default,,0,0,0,,Авантюрист болған кезде өмір мен өлім шындыққа айналады.
Dialogue: 0,0:04:09.83,0:04:13.92,Default,,0,0,0,,Өміріңді жоғалтпасаң да, мен сияқты аяғыңнан айырылып қалуың мүмкін.
Dialogue: 0,0:04:14.00,0:04:16.42,Default,,0,0,0,,Бұл дұрыс, бірақ...
Dialogue: 0,0:04:16.50,0:04:18.84,Default,,0,0,0,,Бүгін барлығына жарайсыңдар!
Dialogue: 0,0:04:18.92,0:04:20.51,Default,,0,0,0,,Қазір үйге қайтайық.
Dialogue: 0,0:04:20.59,0:04:21.42,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:26.76,0:04:29.81,Default,,0,0,0,,Авантюрист болуға ұмтылған жас жігіт
Dialogue: 0,0:04:29.89,0:04:32.68,Default,,0,0,0,,Ата-анада аралас сезім болуы керек.
Dialogue: 0,0:04:32.77,0:04:37.11,Default,,0,0,0,,Мен де авантюрист боламын деп ауылдан қаштым.
Dialogue: 0,0:04:37.19,0:04:38.94,Default,,0,0,0,,Мен олардың сезімдерін түсінемін.
Dialogue: 0,0:04:39.02,0:04:42.24,Default,,0,0,0,,Хахаха, бұл күрделі позиция.
Dialogue: 0,0:04:42.32,0:04:45.78,Default,,0,0,0,,Соған қарамастан, сіздің бұрын жасаған қимылыңыз керемет болды.
Dialogue: 0,0:04:45.86,0:04:49.16,Default,,0,0,0,,Сол жаста мен жаңа дағдыларды дамытуға тырыстым.
Dialogue: 0,0:04:49.24,0:04:53.96,Default,,0,0,0,,40-қа келгенде кенеттен қартайып кетесің.
Dialogue: 0,0:04:54.04,0:04:57.88,Default,,0,0,0,,Не айтайын, мен біртүрлі уайымдаймын.
Dialogue: 0,0:04:57.96,0:05:01.46,Default,,0,0,0,,Мүмкін жағдай қазіргідей болмайтын шығар.
Dialogue: 0,0:05:01.55,0:05:06.72,Default,,0,0,0,,Олай болса, мен отызға келгенде қартайдым деп ойладым.
Dialogue: 0,0:05:06.80,0:05:11.10,Default,,0,0,0,,Сәл басқаша, қартайдым.
Dialogue: 0,0:05:11.97,0:05:16.10,Default,,0,0,0,,Кенеттен сіздің денеңіз бұрынғыдай қозғалысты тоқтатады.
Dialogue: 0,0:05:16.81,0:05:19.61,Default,,0,0,0,,Менің шашым ағарған сияқты.
Dialogue: 0,0:05:20.61,0:05:25.61,Default,,0,0,0,,Бұл кішкентай ғана нәрсе, бірақ мені жалғыз сезінеді.
Dialogue: 0,0:05:25.70,0:05:27.53,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:29.20,0:05:33.12,Default,,0,0,0,,Дегенмен, кейде мен кенеттен жалғыздықты сезінемін.
Dialogue: 0,0:05:33.87,0:05:37.62,Default,,0,0,0,,Мен бірдеңе қалдырдым ба деп ойлаймын.
Dialogue: 0,0:05:38.46,0:05:41.71,Default,,0,0,0,,Мен оны қате жібердім бе? Бұл рас.
Dialogue: 0,0:05:41.79,0:05:42.63,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:42.71,0:05:46.01,Default,,0,0,0,,Мен өз өмірімді толық өмір сүріп жатырмын деп ойладым, бірақ
Dialogue: 0,0:05:46.72,0:05:49.80,Default,,0,0,0,,Өткенге қарасақ, біз не алдық?
Dialogue: 0,0:05:50.47,0:05:52.47,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:05:52.56,0:05:57.27,Default,,0,0,0,,Лорд Белл әлгі қара шашты жауынгер қызды өсірген жоқ па?
Dialogue: 0,0:05:57.85,0:06:01.06,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:06:01.15,0:06:02.57,Default,,0,0,0,,Сол бала менің қасымда болды.
Dialogue: 0,0:06:02.65,0:06:06.40,Default,,0,0,0,,Бұл мен үшін ең жақсысы болған шығар.
Dialogue: 0,0:06:06.49,0:06:08.28,Default,,0,0,0,,- (Барнс) Белл! -иә?
Dialogue: 0,0:06:08.36,0:06:10.32,Default,,0,0,0,,О, не болды? күйіп қалады
Dialogue: 0,0:06:10.41,0:06:12.12,Default,,0,0,0,,Ха, мен осында болдым.
Dialogue: 0,0:06:12.20,0:06:15.79,Default,,0,0,0,,Мені әкем шақырып жатыр. Тезірек ауыл алаңына келіңіз.
Dialogue: 0,0:06:15.87,0:06:18.83,Default,,0,0,0,,Ах... Дункан, кешіріңіз, бірақ мен барамын.
Dialogue: 0,0:06:18.92,0:06:20.29,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:06:23.71,0:06:24.80,Default,,0,0,0,,- Келли - (Келли) О
Dialogue: 0,0:06:25.51,0:06:26.67,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:06:26.76,0:06:28.97,Default,,0,0,0,,- (Келли) Иә, солай ма?
Dialogue: 0,0:06:30.30,0:06:32.22,Default,,0,0,0,,А, эльф?
Dialogue: 0,0:06:35.06,0:06:36.18,Default,,0,0,0,,(берглиф қадамдары)
Dialogue: 0,0:06:36.18,0:06:38.23,Default,,0,0,0,,(берглиф қадамдары)
Dialogue: 0,0:06:36.18,0:06:38.23,Default,,0,0,0,,Иә? Хмм...
Dialogue: 0,0:06:40.98,0:06:42.90,Default,,0,0,0,,Торнеллаға қош келдіңіз.
Dialogue: 0,0:06:42.98,0:06:43.94,Default,,0,0,0,,Эльф залы
Dialogue: 0,0:06:45.02,0:06:47.61,Default,,0,0,0,,Менің атым Бергриф.
Dialogue: 0,0:06:48.11,0:06:51.41,Default,,0,0,0,,Қарсы болмасаң, мен саған көмектесе аламын.
Dialogue: 0,0:06:51.49,0:06:53.12,Default,,0,0,0,,Мен бұған шыдай алмаймын
Dialogue: 0,0:06:53.20,0:06:56.37,Default,,0,0,0,,Мен барлығын қорқытқан сияқтымын.
Dialogue: 0,0:06:56.45,0:07:00.12,Default,,0,0,0,,Ахаха, сен бұрын ешқашан пері көрген емессің.
Dialogue: 0,0:07:00.75,0:07:02.63,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:07:02.71,0:07:06.38,Default,,0,0,0,,Мұқият болмағаным үшін кешірім сұраймын.
Dialogue: 0,0:07:06.46,0:07:09.09,Default,,0,0,0,,Қаласаңыз, менің үйіме келіңіз.
Dialogue: 0,0:07:09.97,0:07:11.09,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:15.68,0:07:18.31,Default,,0,0,0,,Менің атым Дункан.
Dialogue: 0,0:07:18.39,0:07:20.56,Default,,0,0,0,,Қазіргі уақытта қыдырушы авантюристте
Dialogue: 0,0:07:20.64,0:07:23.40,Default,,0,0,0,,Мен лорд Бергрифпен бірге отырмын.
Dialogue: 0,0:07:23.48,0:07:25.90,Default,,0,0,0,,Менің атым Грэм.
Dialogue: 0,0:07:25.98,0:07:26.94,Default,,0,0,0,,Не!?
Dialogue: 0,0:07:27.02,0:07:29.65,Default,,0,0,0,,Оның екі аты бар ма: Паладин?
Dialogue: 0,0:07:29.74,0:07:32.66,Default,,0,0,0,,Ха Оны солай деп те атайды.
Dialogue: 0,0:07:32.74,0:07:36.99,Default,,0,0,0,,Әй, жын патша мен айдаһарды жеңген батыр ше?
Dialogue: 0,0:07:37.08,0:07:38.91,Default,,0,0,0,,Бұл үлкен құрмет.
Dialogue: 0,0:07:39.00,0:07:42.67,Default,,0,0,0,,Олай болса, мистер Грэм мұнда не үшін келді?
Dialogue: 0,0:07:42.75,0:07:45.21,Default,,0,0,0,,Мен біреуді іздеп жүрмін.
Dialogue: 0,0:07:45.29,0:07:48.25,Default,,0,0,0,,Мен оның аяқталуы мүмкін жерді іздедім.
Dialogue: 0,0:07:48.34,0:07:50.67,Default,,0,0,0,,Осы жерге келді.
Dialogue: 0,0:07:50.76,0:07:54.18,Default,,0,0,0,,Ол? Іздеуші әйел ме?
Dialogue: 0,0:07:54.26,0:07:59.93,Default,,0,0,0,,Ол өз ұстанымын түсінбейтін, томпақ, мазасыз қыз.
Dialogue: 0,0:08:00.02,0:08:02.44,Default,,0,0,0,,Сіздің мәртебеңіз бар, солай ма?
Dialogue: 0,0:08:02.52,0:08:03.90,Default,,0,0,0,,О
Dialogue: 0,0:08:03.98,0:08:08.19,Default,,0,0,0,,Эльфтер аумағы - батыс орманның патшасы Оберонның жалғыз қызы.
Dialogue: 0,0:08:08.86,0:08:10.40,Default,,0,0,0,,Неліктен ханшайым?
Dialogue: 0,0:08:11.11,0:08:14.66,Default,,0,0,0,,Жақында жын патша әртүрлі жерлерде қайта тірілді.
Dialogue: 0,0:08:14.74,0:08:18.66,Default,,0,0,0,,Ол жын патшаны бір өзі бағындырады.
Dialogue: 0,0:08:18.74,0:08:23.04,Default,,0,0,0,,Бір адамның бағындырылуы қамқорлықтың орасан зор болғанын білдіреді.
Dialogue: 0,0:08:23.12,0:08:27.13,Default,,0,0,0,,Олардың бойындағы сиқырлы күштің сапасы әртүрлі.
Dialogue: 0,0:08:27.21,0:08:30.55,Default,,0,0,0,,Сондықтан сіз сиқырлы күшпен жұмыс істеуді жақсы білуіңіз керек.
Dialogue: 0,0:08:30.63,0:08:32.05,Default,,0,0,0,,Қарсылас болмаңыз
Dialogue: 0,0:08:32.13,0:08:36.80,Default,,0,0,0,,О, сонда сен сиқыршы болуың керек пе?
Dialogue: 0,0:08:36.89,0:08:38.05,Default,,0,0,0,,Сәл басқаша
Dialogue: 0,0:08:38.93,0:08:42.85,Default,,0,0,0,,Сиқырлы күш – күш бағыты.
Dialogue: 0,0:08:42.93,0:08:46.77,Default,,0,0,0,,Біздің эльфтердің ескі тілінде «ки» деп аталады.
Dialogue: 0,0:08:47.81,0:08:50.82,Default,,0,0,0,,Қаруды дененің бір бөлігі сияқты қалай ұстау керек
Dialogue: 0,0:08:50.90,0:08:55.07,Default,,0,0,0,,Сиқырлы күш арқылы сезім мүшелерін байланыстыру керек
Dialogue: 0,0:08:55.74,0:08:59.83,Default,,0,0,0,,Түсінемін, сіз мұны тағы да атап көрсеткеніңіз біртүрлі.
Dialogue: 0,0:08:59.91,0:09:06.21,Default,,0,0,0,,Эльфтер сиқыр туралы адамдарға қарағанда әлдеқайда жақсы біледі.
Dialogue: 0,0:09:06.29,0:09:09.59,Default,,0,0,0,,Ол ерекше дарынды болды.
Dialogue: 0,0:09:10.34,0:09:14.09,Default,,0,0,0,,Бірақ ол елеске айналып, орманнан қашып кетті.
Dialogue: 0,0:09:14.88,0:09:19.10,Default,,0,0,0,,Ол жын патшаны жеңдім деп ойлайды, бірақ ол адамдар өлмейді.
Dialogue: 0,0:09:19.89,0:09:22.60,Default,,0,0,0,,Лорд Грэм ханшайымның белгілерін ұстанды.
Dialogue: 0,0:09:22.68,0:09:25.56,Default,,0,0,0,,Сіздің осында болуыңыз осыны білдіреді
Dialogue: 0,0:09:25.64,0:09:28.60,Default,,0,0,0,,Торнелладағы құбыжықтардың себебі...
Dialogue: 0,0:09:29.31,0:09:34.19,Default,,0,0,0,,Сиқырлы аңдардың пайда болуы жын патшаның кесірінен болды ма, жоқ па, айту мүмкін емес.
Dialogue: 0,0:09:34.28,0:09:36.36,Default,,0,0,0,,Бірақ менің ойымша, бұл өте мүмкін.
Dialogue: 0,0:09:37.53,0:09:39.12,Default,,0,0,0,,Маған не енгізгендерін ешкім білмейді.
Dialogue: 0,0:09:39.78,0:09:42.12,Default,,0,0,0,,Тергеу қажет
Dialogue: 0,0:09:45.87,0:09:47.21,Default,,0,0,0,,Сізге бұл қалай ұнайды?
Dialogue: 0,0:09:49.17,0:09:50.96,Default,,0,0,0,,Мен біртүрлі сиқырлы күшті сезінемін
Dialogue: 0,0:09:51.88,0:09:55.46,Default,,0,0,0,,Бірақ әсер орманда қалған сияқты.
Dialogue: 0,0:09:56.22,0:09:58.97,Default,,0,0,0,,Орман зынданға айналуы мүмкін бе?
Dialogue: 0,0:09:59.68,0:10:01.97,Default,,0,0,0,,Соның әсері болса
Dialogue: 0,0:10:02.05,0:10:06.48,Default,,0,0,0,,Ағаштар біртүрлі бұралып, тіршілік күші де бұрмаланған.
Dialogue: 0,0:10:06.56,0:10:11.23,Default,,0,0,0,,Дегенмен, сиқырлы күштің қасиеті жын патшаға ұқсас екені рас.
Dialogue: 0,0:10:11.31,0:10:12.44,Default,,0,0,0,,Га
Dialogue: 0,0:10:13.23,0:10:14.28,Default,,0,0,0,,Хмм
Dialogue: 0,0:10:14.36,0:10:16.36,Default,,0,0,0,,- Уф! -Хмф!
Dialogue: 0,0:10:25.58,0:10:27.00,Default,,0,0,0,,Ой
Dialogue: 0,0:10:29.25,0:10:31.50,Default,,0,0,0,,Екеуіңіз де шебер қолданушыларсыздар.
Dialogue: 0,0:10:31.58,0:10:35.34,Default,,0,0,0,,Сіз не айтып тұрсыз? Мен сенің алдыңда сәбидеймін.
Dialogue: 0,0:10:35.42,0:10:38.51,Default,,0,0,0,,Бұл үлкен әткеншек болғанымен, оның кесетін қыры өте өткір.
Dialogue: 0,0:10:39.18,0:10:40.01,Default,,0,0,0,,Хмм
Dialogue: 0,0:10:40.84,0:10:43.39,Default,,0,0,0,,Бұл қылыш тірі.
Dialogue: 0,0:10:43.47,0:10:45.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:46.22,0:10:51.02,Default,,0,0,0,,Шығыстың қиыр шетінде болат ағаш деп аталатын жұмбақ ағаш бар.
Dialogue: 0,0:10:51.10,0:10:54.86,Default,,0,0,0,,Жемісі өте жоғары сапалы, бірақ өңдеу қиын.
Dialogue: 0,0:10:54.94,0:10:57.28,Default,,0,0,0,,Бірақ осылайша қару ретінде қолданылғанда
Dialogue: 0,0:10:57.36,0:11:01.28,Default,,0,0,0,,Керемет сезімталдық көрсетеді
Dialogue: 0,0:11:01.36,0:11:04.74,Default,,0,0,0,,Бұл тірі минерал ма? Мен таң қалдым.
Dialogue: 0,0:11:04.83,0:11:08.33,Default,,0,0,0,,Егер бұлай болса, оқиғаның шешілуіне дейін уақыт мәселесі ғана болады.
Dialogue: 0,0:11:08.41,0:11:09.96,Default,,0,0,0,,Осы мәселеге қатысты...
Dialogue: 0,0:11:10.04,0:11:10.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:10.96,0:11:12.83,Default,,0,0,0,,Ол сөзсіз
Dialogue: 0,0:11:12.92,0:11:16.25,Default,,0,0,0,,Ол осы орманның сиқырлы күшін тауып, пайда болуы керек.
Dialogue: 0,0:11:16.34,0:11:18.96,Default,,0,0,0,,Бірдеңе болып қалса, біз онымен күресуге бар күшімізді саламыз.
Dialogue: 0,0:11:19.05,0:11:21.88,Default,,0,0,0,,Сонымен, сіз оны біраз уақытқа қалдыра аласыз ба?
Dialogue: 0,0:11:21.97,0:11:23.80,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:11:23.89,0:11:27.43,Default,,0,0,0,,Сіздей дарынды адам болса, мен жеңілдеп қалар едім.
Dialogue: 0,0:11:27.52,0:11:30.94,Default,,0,0,0,,Қаласаңыз, осы уақыт ішінде менің үйімде болыңыз.
Dialogue: 0,0:11:31.02,0:11:33.31,Default,,0,0,0,,Бәрі үшін кешірім сұраймын
Dialogue: 0,0:11:33.40,0:11:35.44,Default,,0,0,0,,Егер сіз буксирлеуге ұқсас әрекет жасамасаңыз
Dialogue: 0,0:11:35.52,0:11:38.53,Default,,0,0,0,,Мен анау шұбардың құйрығынан ұстай алмаймын.
Dialogue: 0,0:11:42.61,0:11:45.74,Default,,0,0,0,,Әкенің үлесі жеткіліксіз.
Dialogue: 0,0:11:45.83,0:11:48.95,Default,,0,0,0,,Сенің әкең де жалғыз болғанына сенімдімін.
Dialogue: 0,0:11:49.04,0:11:51.29,Default,,0,0,0,,Барлығы менімен санасатын сияқты.
Dialogue: 0,0:11:51.37,0:11:53.08,Default,,0,0,0,,Сіздің жалғыздыққа уақытыңыз жоқ, солай ма?
Dialogue: 0,0:11:53.17,0:11:55.46,Default,,0,0,0,,- (Әйел) Әй, мен міндетті түрде тағы келемін - (Ер) Дұрыс.
Dialogue: 0,0:11:56.38,0:11:57.21,Default,,0,0,0,,Ах
Dialogue: 0,0:11:57.29,0:12:00.30,Default,,0,0,0,,Андждың қызы жоқ па?
Dialogue: 0,0:12:00.38,0:12:01.47,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:12:01.55,0:12:04.93,Default,,0,0,0,,Өйткені бұл жерде менің сүйіктім болса, өзімді жалғыз сезінетін едім.
Dialogue: 0,0:12:05.01,0:12:09.68,Default,,0,0,0,,Менің әкемнен қалайтыным мен ғашығымнан тілейтінім бөлек.
Dialogue: 0,0:12:09.77,0:12:11.56,Default,,0,0,0,,Милли ше?
Dialogue: 0,0:12:11.64,0:12:15.77,Default,,0,0,0,,Маған ұнамайды. Мен өз жасымдағы еркектерге сене алмаймын.
Dialogue: 0,0:12:15.86,0:12:18.19,Default,,0,0,0,,Сіз тым идеалист емессіз бе?
Dialogue: 0,0:12:18.27,0:12:20.48,Default,,0,0,0,,Аа, қазір ойлап қарасам, мистер Белл.
Dialogue: 0,0:12:20.57,0:12:22.95,Default,,0,0,0,,Әйеліңіз, сіз оны алуды жоспарлап отырған жоқсыз ба?
Dialogue: 0,0:12:23.03,0:12:25.20,Default,,0,0,0,,Не? кенеттен
Dialogue: 0,0:12:25.28,0:12:29.08,Default,,0,0,0,,Өйткені әйелің болса, Торнелла жалғыз қалмайды.
Dialogue: 0,0:12:29.16,0:12:29.99,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:30.08,0:12:32.71,Default,,0,0,0,,Андждың көзқарасы бойынша қандай адам болғанын қалар едіңіз?
Dialogue: 0,0:12:32.79,0:12:33.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:34.96,0:12:37.46,Default,,0,0,0,,Ана болу керек пе?
Dialogue: 0,0:12:37.54,0:12:38.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:38.71,0:12:40.71,Default,,0,0,0,,Аналық... Әй...
Dialogue: 0,0:12:41.67,0:12:43.92,Default,,0,0,0,,Әкеңнің әйелі болу деген нені білдіреді?
Dialogue: 0,0:12:44.01,0:12:46.55,Default,,0,0,0,,Менің анам болу
Dialogue: 0,0:12:46.64,0:12:50.10,Default,,0,0,0,,Ана... бұл керемет естіледі.
Dialogue: 0,0:12:51.56,0:12:54.31,Default,,0,0,0,,Әкеме жар табудан басқа амалым жоқ.
Dialogue: 0,0:12:54.39,0:12:56.73,Default,,0,0,0,,- Иә? -Уау, бұл қызық сияқты.
Dialogue: 0,0:12:56.81,0:12:59.02,Default,,0,0,0,,Хмм, бұл кеш қимыл.
Dialogue: 0,0:12:59.11,0:13:02.61,Default,,0,0,0,,Адамның өзіне қалдырсаң, ешқашан табылмайсың.
Dialogue: 0,0:13:02.69,0:13:06.36,Default,,0,0,0,,Сондықтан бізде кандидаттарды іздеуден басқа амал жоқ.
Dialogue: 0,0:13:06.45,0:13:09.53,Default,,0,0,0,,Соңғы шешімді, әрине, әкеңіз қабылдайды.
Dialogue: 0,0:13:09.62,0:13:12.62,Default,,0,0,0,,Хехе, қызық бола бастады.
Dialogue: 0,0:13:12.70,0:13:15.12,Default,,0,0,0,,Бірақ әйел тапсаңыз
Dialogue: 0,0:13:15.21,0:13:18.13,Default,,0,0,0,,Андж енді іздеуде болмады.
Dialogue: 0,0:13:18.21,0:13:22.00,Default,,0,0,0,,Күрсін, не істеуім керек?
Dialogue: 0,0:13:22.09,0:13:24.26,Default,,0,0,0,,О, сен бұл туралы ойламадың ба?
Dialogue: 0,0:13:24.34,0:13:27.18,Default,,0,0,0,,Жоқ, сенің әкең ондай адам емес.
Dialogue: 0,0:13:27.26,0:13:28.80,Default,,0,0,0,,Сондықтан әкеңнің жары
Dialogue: 0,0:13:28.89,0:13:31.35,Default,,0,0,0,,Мен анамды табамын!
Dialogue: 0,0:13:31.43,0:13:33.02,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:13:33.10,0:13:35.39,Default,,0,0,0,,- Иә? -Мен де?
Dialogue: 0,0:13:40.44,0:13:42.07,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:13:42.15,0:13:42.98,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:44.15,0:13:45.95,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:13:46.03,0:13:47.99,Default,,0,0,0,,Ах, Андж Чан
Dialogue: 0,0:13:48.07,0:13:49.74,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,0:13:51.24,0:13:52.54,Default,,0,0,0,,Юрий-сан
Dialogue: 0,0:13:52.62,0:13:54.37,Default,,0,0,0,,Біз жақында ғана кездестік.
Dialogue: 0,0:13:54.45,0:13:57.54,Default,,0,0,0,,Мен оның 37 жаста екеніне сене алар емеспін, терісі өте тар
Dialogue: 0,0:13:57.62,0:14:00.75,Default,,0,0,0,,Сабырлы, сонымен қатар ойнақы тамаша ханым.
Dialogue: 0,0:14:00.84,0:14:03.34,Default,,0,0,0,,Юри болса, сен менің анам бола аласың.
Dialogue: 0,0:14:03.42,0:14:04.26,Default,,0,0,0,,Хехехе
Dialogue: 0,0:14:04.34,0:14:06.51,Default,,0,0,0,,Тағы бір Қан Құбыжық Өнері ме?
Dialogue: 0,0:14:06.59,0:14:09.72,Default,,0,0,0,,Юрий-сан, сен менің әкеммен кездесуге барғың келе ме?
Dialogue: 0,0:14:09.80,0:14:11.14,Default,,0,0,0,,- (Юрий) А? - (Мириам Анесса) Иә?
Dialogue: 0,0:14:11.22,0:14:14.72,Default,,0,0,0,,Мм... Андж Чанның әкесі?
Dialogue: 0,0:14:14.81,0:14:16.64,Default,,0,0,0,,Сіз қызыл жын адамсыз ба?
Dialogue: 0,0:14:16.73,0:14:19.40,Default,,0,0,0,,Менің ойымша, бұл маған тұрарлық емес.
Dialogue: 0,0:14:19.48,0:14:21.06,Default,,0,0,0,,Ондай нәрсе жоқ
Dialogue: 0,0:14:21.15,0:14:24.44,Default,,0,0,0,,Юрий-сан да AAA (Үштік А) дәрежесіне ие болды, солай ма?
Dialogue: 0,0:14:24.53,0:14:26.99,Default,,0,0,0,,Ал... бұл менің белсенді күндерімнен.
Dialogue: 0,0:14:27.07,0:14:27.90,Default,,0,0,0,,​​О?
Dialogue: 0,0:14:27.07,0:14:27.90,Default,,0,0,0,,(перделердің ашылған дыбысы)
Dialogue: 0,0:14:27.99,0:14:31.53,Default,,0,0,0,,Юрий Бұл файл...
Dialogue: 0,0:14:31.62,0:14:33.16,Default,,0,0,0,,Ах, Андж-сан.
Dialogue: 0,0:14:33.24,0:14:35.74,Default,,0,0,0,,Гильдия шебері Ұйқының болмауы ма?
Dialogue: 0,0:14:35.83,0:14:39.96,Default,,0,0,0,,Жарайды, бұл жаста оны аяқтау қиын.
Dialogue: 0,0:14:40.04,0:14:44.00,Default,,0,0,0,,Сиқырлы аңдар жаппай тараған кезден бері осылай болды.
Dialogue: 0,0:14:44.09,0:14:46.17,Default,,0,0,0,,Рио шағымдарға толы.
Dialogue: 0,0:14:46.26,0:14:48.09,Default,,0,0,0,,Оны көп айтпа
Dialogue: 0,0:14:48.17,0:14:50.47,Default,,0,0,0,,Енді шағым айта алмасам, өлемін.
Dialogue: 0,0:14:50.55,0:14:54.60,Default,,0,0,0,,Жарайды. Мен өлемін деп айта алатын болсам, менде бәрі жақсы. Мен жақсымын.
Dialogue: 0,0:14:54.68,0:14:57.81,Default,,0,0,0,,Қараңдар, мен бұл файлды тексеремін.
Dialogue: 0,0:14:57.89,0:14:58.98,Default,,0,0,0,,Я...
Dialogue: 0,0:14:59.60,0:15:02.61,Default,,0,0,0,,Әй, бұл екеуі бұрынғы партия мүшелері.
Dialogue: 0,0:15:02.69,0:15:04.48,Default,,0,0,0,,Нағыз жақсы достар
Dialogue: 0,0:15:04.57,0:15:06.23,Default,,0,0,0,,-Эй - (Юри) А?
Dialogue: 0,0:15:06.32,0:15:07.61,Default,,0,0,0,,Не? Андж-сан
Dialogue: 0,0:15:07.69,0:15:09.40,Default,,0,0,0,,Екеуің кездесіп жүрсіңдер ме?
Dialogue: 0,0:15:09.49,0:15:11.07,Default,,0,0,0,,- (2 адам) Иә? -Неге?
Dialogue: 0,0:15:11.16,0:15:14.24,Default,,0,0,0,,Біз жақсы доспыз және бір-бірімізге сенеміз, солай ма?
Dialogue: 0,0:15:14.33,0:15:15.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:16.49,0:15:17.58,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:17.66,0:15:20.83,Default,,0,0,0,,Мен сенің арқаңды ұстайтынмын.
Dialogue: 0,0:15:20.91,0:15:23.13,Default,,0,0,0,,Бірақ тең ғашық жоқ па?
Dialogue: 0,0:15:23.21,0:15:26.84,Default,,0,0,0,,Хмм, бұл сенімге көбірек ұқсайды, дәлірек айтсақ, оны жалғыз қалдыруға болмайтын сияқты.
Dialogue: 0,0:15:26.92,0:15:27.76,Default,,0,0,0,,Э~?
Dialogue: 0,0:15:27.84,0:15:31.84,Default,,0,0,0,,Әйтеуір берік қарым-қатынас орнады.
Dialogue: 0,0:15:31.93,0:15:32.76,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:15:32.84,0:15:34.39,Default,,0,0,0,,Юрий-сан
Dialogue: 0,0:15:34.47,0:15:37.56,Default,,0,0,0,,Әкеңмен үйлен, шын ойла.
Dialogue: 0,0:15:37.64,0:15:40.52,Default,,0,0,0,,Мен гильдия шебері сияқты сенімсіз емеспін.
Dialogue: 0,0:15:40.60,0:15:42.94,Default,,0,0,0,,Фуфуфуфу, әлдеқашан кемпір
Dialogue: 0,0:15:42.94,0:15:43.77,Default,,0,0,0,,Фуфуфуфу, сен, Омасе-сан.
Dialogue: 0,0:15:42.94,0:15:43.77,Default,,0,0,0,,Хмм
Dialogue: 0,0:15:43.85,0:15:46.27,Default,,0,0,0,,Оған сенетініңізге сенімдімін.
Dialogue: 0,0:15:46.36,0:15:47.82,Default,,0,0,0,,Иә, Юрий.
Dialogue: 0,0:15:47.90,0:15:51.15,Default,,0,0,0,,Андждың әкесіне үйленіп, оны Орфенге әкеліңіз.
Dialogue: 0,0:15:51.24,0:15:53.57,Default,,0,0,0,,Хм, не?!
Dialogue: 0,0:15:53.66,0:15:54.57,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:15:55.66,0:15:58.33,Default,,0,0,0,,Керемет идея... Бірақ...
Dialogue: 0,0:15:59.29,0:16:01.71,Default,,0,0,0,,Юрий ана атанған кезде
Dialogue: 0,0:16:01.79,0:16:04.21,Default,,0,0,0,,Осылай ашулана ма деп ойлаймын.
Dialogue: 0,0:16:04.29,0:16:05.25,Default,,0,0,0,,Анж!
Dialogue: 0,0:16:05.33,0:16:07.71,Default,,0,0,0,,Осыдан кейін барғым келетін жер бар.
Dialogue: 0,0:16:07.80,0:16:09.21,Default,,0,0,0,,Е, қайда?
Dialogue: 0,0:16:09.30,0:16:11.47,Default,,0,0,0,,Біздің отбасылық үй
Dialogue: 0,0:16:11.55,0:16:12.68,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:16:12.76,0:16:14.47,Default,,0,0,0,,Мен үйдемін~
Dialogue: 0,0:16:14.55,0:16:16.72,Default,,0,0,0,,Иә? Қайтадан қош келдіңіз~
Dialogue: 0,0:16:16.80,0:16:19.06,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:16:19.14,0:16:21.02,Default,,0,0,0,,Қайтадан қош келдіңіз~
Dialogue: 0,0:16:21.10,0:16:22.73,Default,,0,0,0,,-Осында қояйын -Бәрі қалай?
Dialogue: 0,0:16:22.81,0:16:25.73,Default,,0,0,0,,Рахмет, бұл тамаша көкөністер.
Dialogue: 0,0:16:25.81,0:16:29.23,Default,,0,0,0,,Бүгін кешке мынаны қайнатып, макарон жасайық.
Dialogue: 0,0:16:32.32,0:16:34.11,Default,,0,0,0,,Мен көкөністерді турадым.
Dialogue: 0,0:16:34.20,0:16:35.32,Default,,0,0,0,,-(Бала) Мен де~ -Аа.
Dialogue: 0,0:16:35.41,0:16:36.87,Default,,0,0,0,,Осы екеуінің қайсысы екенін сұрап тұрмын. Сен бе?
Dialogue: 0,0:16:36.95,0:16:39.24,Default,,0,0,0,,Ал, келесі жолы маған тәрелкелерді реттеп беруіңді қалаймын.
Dialogue: 0,0:16:39.33,0:16:40.24,Default,,0,0,0,,Иә
Dialogue: 0,0:16:40.33,0:16:41.75,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:41.83,0:16:43.50,Default,,0,0,0,,Розетта-сан
Dialogue: 0,0:16:43.58,0:16:46.96,Default,,0,0,0,,Ол Арне мен Милли тұратын балалар үйінің әпкесі.
Dialogue: 0,0:16:47.04,0:16:48.84,Default,,0,0,0,,Жанды және балаларға танымал
Dialogue: 0,0:16:48.92,0:16:51.80,Default,,0,0,0,,Өте мейірімді және 29 жаста
Dialogue: 0,0:16:51.88,0:16:52.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:52.84,0:16:55.93,Default,,0,0,0,,Розетта-сан, сен тұрмысқа шығуды ойламайсың ба?
Dialogue: 0,0:16:56.01,0:16:58.35,Default,,0,0,0,,Не... не? кенеттен
Dialogue: 0,0:16:58.43,0:17:01.77,Default,,0,0,0,,Ол сүйкімді, еңбекқор және жақсы аспаз.
Dialogue: 0,0:17:01.85,0:17:03.89,Default,,0,0,0,,Мен одан жақсы жар болады деп ойладым
Dialogue: 0,0:17:03.98,0:17:07.40,Default,,0,0,0,,Жоқ... Мен үлкендерді мазақтамаймын.
Dialogue: 0,0:17:07.48,0:17:08.31,Default,,0,0,0,,Уау
Dialogue: 0,0:17:08.40,0:17:10.82,Default,,0,0,0,,Эй, сен менің әкеммен кездесуге барғың келе ме?
Dialogue: 0,0:17:10.90,0:17:13.74,Default,,0,0,0,,Не... не айтып тұрсың?
Dialogue: 0,0:17:13.82,0:17:14.99,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:17:15.07,0:17:17.66,Default,,0,0,0,,А... бұл мәселе емес...
Dialogue: 0,0:17:18.66,0:17:22.24,Default,,0,0,0,,Ойлан, әке, сен жақсы адамсың.
Dialogue: 0,0:17:22.33,0:17:23.41,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,0:17:23.50,0:17:25.21,Default,,0,0,0,,Ой... а
Dialogue: 0,0:17:25.21,0:17:26.17,Default,,0,0,0,,Ой... а
Dialogue: 0,0:17:25.21,0:17:26.17,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:17:26.25,0:17:29.67,Default,,0,0,0,,Иә? Розетта, сен неге қызарып тұрсың?
Dialogue: 0,0:17:29.75,0:17:31.84,Default,,0,0,0,,Жоқ... бұл ештеңе емес.
Dialogue: 0,0:17:31.92,0:17:33.17,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:17:37.13,0:17:40.72,Default,,0,0,0,,Кешіріңіз, мен қырқуды әлі аяқтаған жоқпын.
Dialogue: 0,0:17:40.80,0:17:44.06,Default,,0,0,0,,Уайымдама, бізге қалдыр.
Dialogue: 0,0:17:44.14,0:17:45.56,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:17:45.64,0:17:47.23,Default,,0,0,0,,Кеттік
Dialogue: 0,0:17:48.52,0:17:53.44,Default,,0,0,0,,(қой малау)
Dialogue: 0,0:17:55.53,0:17:58.70,Default,,0,0,0,,Аға, мен биыл бос емеспін.
Dialogue: 0,0:17:58.78,0:18:01.95,Default,,0,0,0,,Ал, жас жігіттер жұмысқа үйренгенше.
Dialogue: 0,0:18:02.03,0:18:03.54,Default,,0,0,0,,Сәлем, Белл
Dialogue: 0,0:18:03.62,0:18:06.71,Default,,0,0,0,,Грэм мырзаға бұл жер ұнай ма?
Dialogue: 0,0:18:06.79,0:18:08.71,Default,,0,0,0,,А, мен солай ойлаймын.
Dialogue: 0,0:18:08.79,0:18:12.46,Default,,0,0,0,,Періге ұнағанына қуаныштымын, досым.
Dialogue: 0,0:18:12.54,0:18:14.09,Default,,0,0,0,,Мен бұған ренжідім.
Dialogue: 0,0:18:14.17,0:18:16.97,Default,,0,0,0,,Мүмкін сіз әлі де дұрыс сөйлей алмайсыз ба?
Dialogue: 0,0:18:17.05,0:18:20.43,Default,,0,0,0,,Өйткені мен не айтарымды білмеймін.
Dialogue: 0,0:18:20.51,0:18:23.97,Default,,0,0,0,,Ахаха, кішігірім әңгімеге қарсы емеспін.
Dialogue: 0,0:18:24.06,0:18:27.35,Default,,0,0,0,,Олай болса, келесі жолы мен сені ішуге шақырамын.
Dialogue: 0,0:18:27.43,0:18:28.73,Default,,0,0,0,,Мені әкел.
Dialogue: 0,0:18:28.81,0:18:32.36,Default,,0,0,0,,Хаха түсіндім, оның да бақытты болатынына сенімдімін.
Dialogue: 0,0:18:32.44,0:18:33.98,Default,,0,0,0,,- (Барнс) Белл! -иә?
Dialogue: 0,0:18:34.07,0:18:36.74,Default,,0,0,0,,Мына жердегі өріске келе аласыз ба?
Dialogue: 0,0:18:36.82,0:18:39.11,Default,,0,0,0,,Не болды!? Бұл қайтадан құбыжық па?
Dialogue: 0,0:18:39.20,0:18:41.62,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:18:41.70,0:18:42.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:48.21,0:18:50.12,Default,,0,0,0,,Аа... Ах!
Dialogue: 0,0:18:51.42,0:18:53.59,Default,,0,0,0,,Біреудің бетіне қарап қашып кет
Dialogue: 0,0:18:53.67,0:18:55.63,Default,,0,0,0,,Адамдар өте дөрекі.
Dialogue: 0,0:18:55.71,0:18:57.71,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:57.80,0:19:01.34,Default,,0,0,0,,Мен эльфтермен таныс емеспін, сондықтан кешіріңіз.
Dialogue: 0,0:19:01.43,0:19:03.68,Default,,0,0,0,,Сонда сен кімсің?
Dialogue: 0,0:19:03.76,0:19:06.35,Default,,0,0,0,,Менің атым Бергрифф.
Dialogue: 0,0:19:06.43,0:19:09.94,Default,,0,0,0,,Сіз Батыс патшасы Оберонның қызысыз ​​ба?
Dialogue: 0,0:19:10.02,0:19:11.31,Default,,0,0,0,,-Мм -О
Dialogue: 0,0:19:13.02,0:19:13.90,Default,,0,0,0,,(Таңданған екі дауыс)
Dialogue: 0,0:19:13.98,0:19:16.40,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:19:17.03,0:19:20.07,Default,,0,0,0,,Мұны қайдан естідің? Мен айтуым керек...
Dialogue: 0,0:19:20.15,0:19:23.24,Default,,0,0,0,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,0:19:23.99,0:19:25.03,Default,,0,0,0,,Ах
Dialogue: 0,0:19:25.83,0:19:28.83,Default,,0,0,0,,Мен жақында түскі ас ішуді ойладым.
Dialogue: 0,0:19:28.91,0:19:30.21,Default,,0,0,0,,Қарсы болмасаңыз
Dialogue: 0,0:19:30.29,0:19:34.08,Default,,0,0,0,,Мен пері ханшайымымен бірге отыру құрметіне ие болғым келеді.
Dialogue: 0,0:19:34.17,0:19:38.09,Default,,0,0,0,,Хмм... Осыншама көп айтсаң, көмектесе алмаймын.
Dialogue: 0,0:19:38.17,0:19:41.09,Default,,0,0,0,,Иә, рахмет
Dialogue: 0,0:19:43.68,0:19:47.68,Default,,0,0,0,,(Маргериттің тамақ ішкен дыбысы)
Dialogue: 0,0:19:47.76,0:19:48.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:48.68,0:19:50.60,Default,,0,0,0,,Фу…
Dialogue: 0,0:19:52.69,0:19:54.44,Default,,0,0,0,,Сіздің талғамыңызға сай ма?
Dialogue: 0,0:19:54.52,0:19:57.44,Default,,0,0,0,,Иә... өте жақсы.
Dialogue: 0,0:19:57.52,0:20:01.20,Default,,0,0,0,,Қарсы болмасаңыз, атыңызды сұрасам бола ма?
Dialogue: 0,0:20:01.28,0:20:04.95,Default,,0,0,0,,Қария, оған дейін сен мені қайдан білесің?
Dialogue: 0,0:20:05.03,0:20:07.74,Default,,0,0,0,,Мен Грэм мырзадан сұрадым.
Dialogue: 0,0:20:07.83,0:20:09.70,Default,,0,0,0,,Ол кісі де қазір осы ауылда.
Dialogue: 0,0:20:09.79,0:20:10.70,Default,,0,0,0,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,0:20:11.46,0:20:14.54,Default,,0,0,0,,Әй... үлкен ағаң ба? Әзіл емес!
Dialogue: 0,0:20:14.54,0:20:14.83,Default,,0,0,0,,Әй... үлкен ағаң ба? Әзіл емес!
Dialogue: 0,0:20:14.54,0:20:14.83,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:20:14.83,0:20:14.92,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:20:14.92,0:20:15.54,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:20:14.92,0:20:15.54,Default,,0,0,0,,-Маргерит! -Уф!
Dialogue: 0,0:20:15.54,0:20:15.63,Default,,0,0,0,,-Маргерит! -Уф!
Dialogue: 0,0:20:15.63,0:20:16.46,Default,,0,0,0,,- Маргерит! -Уф!
Dialogue: 0,0:20:15.63,0:20:16.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:17.17,0:20:18.88,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:20.42,0:20:22.47,Default,,0,0,0,,Әй... ұлы аға...
Dialogue: 0,0:20:22.55,0:20:26.09,Default,,0,0,0,,Сіз нені айтасыз? Оберон да алаңдаулы.
Dialogue: 0,0:20:26.18,0:20:30.27,Default,,0,0,0,,Әй, әкем мен үшін уайымдап жатыр ма? Ха, бұл мүмкін емес!
Dialogue: 0,0:20:30.35,0:20:32.56,Default,,0,0,0,,Баласының қамын ойламайтын ата-ана жоқ.
Dialogue: 0,0:20:32.64,0:20:34.35,Default,,0,0,0,,Қалжың емес!
Dialogue: 0,0:20:34.44,0:20:37.31,Default,,0,0,0,,Мен сізді өзімнің кім екенімді мойындауға мәжбүр етемін.
Dialogue: 0,0:20:37.40,0:20:39.90,Default,,0,0,0,,Нағашы атамның атын шығарған жолы!
Dialogue: 0,0:20:39.98,0:20:41.07,Default,,0,0,0,,Хмм
Dialogue: 0,0:20:44.95,0:20:49.24,Default,,0,0,0,,Мені ренжітсем де, сапарым туралы айтпауым керек еді.
Dialogue: 0,0:20:49.33,0:20:51.58,Default,,0,0,0,,Ол туысы ма?
Dialogue: 0,0:20:51.66,0:20:55.33,Default,,0,0,0,,О, Оберон, маған келші.
Dialogue: 0,0:20:55.42,0:20:56.50,Default,,0,0,0,,Ах
Dialogue: 0,0:20:56.58,0:20:58.88,Default,,0,0,0,,Ха, мен оны қууым керек.
Dialogue: 0,0:20:58.96,0:21:00.67,Default,,0,0,0,,Егер солай болса.
Dialogue: 0,0:21:00.75,0:21:05.01,Default,,0,0,0,,Отбасымның мұңын бұдан былай көрсетуге шыдай алмаймын.
Dialogue: 0,0:21:07.34,0:21:10.18,Default,,0,0,0,,Бұл оңай емес сияқты.
Dialogue: 0,0:21:10.26,0:21:11.77,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:21:15.73,0:21:18.06,Default,,0,0,0,,Барлығы дұрыс жауап бермейді.
Dialogue: 0,0:21:18.15,0:21:20.19,Default,,0,0,0,,Әкем жақсы адам болса да
Dialogue: 0,0:21:20.27,0:21:22.94,Default,,0,0,0,,Сіз тым күштеп жатырсыз.
Dialogue: 0,0:21:23.03,0:21:26.36,Default,,0,0,0,,Иә, бұл тым жылдам.
Dialogue: 0,0:21:26.45,0:21:28.20,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:21:28.28,0:21:31.66,Default,,0,0,0,,Мистер Беллден Орфенге бір рет келуін өтінуге қалай болады?
Dialogue: 0,0:21:31.74,0:21:34.37,Default,,0,0,0,,Жеке кездессек, жақсы тіл табысуымыз мүмкін.
Dialogue: 0,0:21:34.45,0:21:37.33,Default,,0,0,0,,Жарайды, келесі жолы үйге келгенде, солай қалдырыңыз.
Dialogue: 0,0:21:37.42,0:21:39.46,Default,,0,0,0,,Әкеңді Жетімге әкел!
Dialogue: 0,0:21:39.54,0:21:42.38,Default,,0,0,0,,Сонымен, бізде кездесу кеші өтіп жатыр!
Dialogue: 0,0:21:42.96,0:21:44.92,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:21:45.01,0:21:47.38,Default,,0,0,0,,Бұл қазірдің өзінде Андж~
Dialogue: 0,0:21:49.97,0:21:52.64,Default,,0,0,0,,Хехе, кімге хабарласайын?
Dialogue: 0,0:21:52.72,0:21:53.64,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:55.23,0:21:56.89,Default,,0,0,0,,Ха, сол балалар.
Dialogue: 0,0:22:01.48,0:22:02.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:05.99,0:22:10.99,Default,,0,0,0,,♪～
Dialogue: 0,0:23:30.95,0:23:35.95,Default,,0,0,0,,～♪
Dialogue: 0,0:23:37.45,0:23:43.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory