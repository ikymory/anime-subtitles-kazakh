Dialogue: 0,0:00:02.96,0:00:06.63,Default,,0,0,0,,Ұстаз... Ауырды...
Dialogue: 0,0:00:06.71,0:00:10.34,Default,,0,0,0,,Маған көмектесші... Мен жалғызбын...
Dialogue: 0,0:00:10.42,0:00:13.30,Default,,0,0,0,,Неге... Неге...
Dialogue: 0,0:00:13.38,0:00:16.80,Default,,0,0,0,,(Шайтанның ырылдауы)
Dialogue: 0,0:00:19.64,0:00:21.14,Default,,0,0,0,,Уаааааа...
Dialogue: 0,0:00:27.98,0:00:29.15,Default,,0,0,0,,Га
Dialogue: 0,0:00:29.23,0:00:31.15,Default,,0,0,0,,(тұру дыбысы)
Dialogue: 0,0:00:35.03,0:00:40.04,Default,,0,0,0,,♪～
Dialogue: 0,0:01:59.61,0:02:04.91,Default,,0,0,0,,～♪
Dialogue: 0,0:02:06.75,0:02:07.25,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:02:07.25,0:02:07.79,Default,,0,0,0,,Уау! Уф...
Dialogue: 0,0:02:07.79,0:02:09.29,Default,,0,0,0,,Уау! Уф...
Dialogue: 0,0:02:09.96,0:02:11.33,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:02:11.42,0:02:13.04,Default,,0,0,0,,Сіз бұлай жалтарып кете алмайсыз!
Dialogue: 0,0:02:13.13,0:02:15.05,Default,,0,0,0,,Уф... қандай шулы!
Dialogue: 0,0:02:16.34,0:02:18.55,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:02:18.63,0:02:21.39,Default,,0,0,0,,Ей, бұл жын патшаның күші.
Dialogue: 0,0:02:21.47,0:02:22.76,Default,,0,0,0,,Хун
Dialogue: 0,0:02:22.85,0:02:25.01,Default,,0,0,0,,Ооо аааааааа...
Dialogue: 0,0:02:25.81,0:02:26.77,Default,,0,0,0,,Уф
Dialogue: 0,0:02:26.85,0:02:29.64,Default,,0,0,0,,Бұл күшке сенбе
Dialogue: 0,0:02:29.73,0:02:31.81,Default,,0,0,0,,Көп пайдалансаң, жұтылып кетесің.
Dialogue: 0,0:02:31.90,0:02:32.77,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:02:32.86,0:02:34.73,Default,,0,0,0,,Ммм
Dialogue: 0,0:02:36.65,0:02:38.03,Default,,0,0,0,,Иә! Уф!
Dialogue: 0,0:02:39.86,0:02:41.74,Default,,0,0,0,,Ніл бойындағы барлық базар саудагерлері
Dialogue: 0,0:02:41.82,0:02:44.70,Default,,0,0,0,,Денеңіздегі сиқырлы мүшелерден хабардар болыңыз.
Dialogue: 0,0:02:44.78,0:02:47.37,Default,,0,0,0,,Жын патшасының сиқырлы күшін өзіңіздің сиқырлы күшіңізден ажыратыңыз.
Dialogue: 0,0:02:49.00,0:02:50.04,Default,,0,0,0,,Әже
Dialogue: 0,0:02:50.12,0:02:51.67,Default,,0,0,0,,Бяку жақсысың ба?
Dialogue: 0,0:02:51.75,0:02:55.42,Default,,0,0,0,,Кемпір, тағы бір рет. Мен сезім алдым.
Dialogue: 0,0:02:55.50,0:02:56.42,Default,,0,0,0,,Хмм
Dialogue: 0,0:02:56.50,0:02:59.42,Default,,0,0,0,,Қызды кемпір деме!
Dialogue: 0,0:02:59.51,0:03:00.30,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:03:00.30,0:03:01.76,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:03:00.30,0:03:01.76,Default,,0,0,0,,Уау! Ахх...
Dialogue: 0,0:03:01.76,0:03:03.18,Default,,0,0,0,,Уау! Ахх...
Dialogue: 0,0:03:05.01,0:03:05.93,Default,,0,0,0,,Хмм
Dialogue: 0,0:03:05.01,0:03:05.93,Default,,0,0,0,,Сіз сиқырлы күштің алдында тұрсыз
Dialogue: 0,0:03:05.93,0:03:06.01,Default,,0,0,0,,Сиқырлы күштің алдында тұрсың
Dialogue: 0,0:03:06.01,0:03:07.39,Default,,0,0,0,,Сиқырлы күштің алдында тұрсың
Dialogue: 0,0:03:06.01,0:03:07.39,Default,,0,0,0,,Ұрыс... қорқынышты ма?
Dialogue: 0,0:03:07.39,0:03:07.47,Default,,0,0,0,,Ұрыс... қорқынышты ма?
Dialogue: 0,0:03:07.47,0:03:08.68,Default,,0,0,0,,Ұрыс... қорқынышты ма?
Dialogue: 0,0:03:07.47,0:03:08.68,Default,,0,0,0,,Сіз бұл дөрекі сөйлеуді түзетуіңіз керек.
Dialogue: 0,0:03:08.68,0:03:08.77,Default,,0,0,0,,Сіз дөрекі сөйлеуді түзетуіңіз керек.
Dialogue: 0,0:03:08.77,0:03:09.93,Default,,0,0,0,,Сіз дөрекі сөйлеуді түзетуіңіз керек.
Dialogue: 0,0:03:08.77,0:03:09.93,Default,,0,0,0,,Иә
Dialogue: 0,0:03:09.93,0:03:10.02,Default,,0,0,0,,Иә
Dialogue: 0,0:03:10.02,0:03:10.39,Default,,0,0,0,,Иә
Dialogue: 0,0:03:10.02,0:03:10.39,Default,,0,0,0,,Жақсы емес сияқты!
Dialogue: 0,0:03:10.39,0:03:10.48,Default,,0,0,0,,Бұл жақсы емес сияқты!
Dialogue: 0,0:03:10.48,0:03:11.35,Default,,0,0,0,,Жақсы емес сияқты!
Dialogue: 0,0:03:10.48,0:03:11.35,Default,,0,0,0,,Өйткені мен Сүлейменнің билігін қарызға алатынмын
Dialogue: 0,0:03:11.35,0:03:11.44,Default,,0,0,0,,Өйткені мен Сүлейменнің билігін қарызға алатынмын
Dialogue: 0,0:03:11.44,0:03:13.48,Default,,0,0,0,,Өйткені мен Сүлейменнің билігін бұрын алған едім.
Dialogue: 0,0:03:11.44,0:03:13.48,Default,,0,0,0,,Ооо!
Dialogue: 0,0:03:13.48,0:03:13.56,Default,,0,0,0,,Ооо!
Dialogue: 0,0:03:13.56,0:03:14.19,Default,,0,0,0,,Ооо!
Dialogue: 0,0:03:13.56,0:03:14.19,Default,,0,0,0,,Мен кез келген нәрсені істей алатынымды сезіндім
Dialogue: 0,0:03:14.19,0:03:14.27,Default,,0,0,0,,Мен кез келген нәрсені істей алатынымды сезіндім
Dialogue: 0,0:03:14.27,0:03:16.19,Default,,0,0,0,,Мен кез келген нәрсені істей алатындай сезіндім
Dialogue: 0,0:03:14.27,0:03:16.19,Default,,0,0,0,,Кел, айт.
Dialogue: 0,0:03:16.27,0:03:19.69,Default,,0,0,0,,Өйткені қазір менде ешқандай күш жоқ.
Dialogue: 0,0:03:16.27,0:03:19.69,Default,,0,0,0,,«Әпке, тағы да өтінемін»!
Dialogue: 0,0:03:19.69,0:03:20.40,Default,,0,0,0,,«Әпке, тағы да өтінемін»!
Dialogue: 0,0:03:20.49,0:03:23.45,Default,,0,0,0,,Шулы, қарғыс атқыр қарғыс ат!
Dialogue: 0,0:03:23.53,0:03:25.74,Default,,0,0,0,,-Бакамон! -Гах!
Dialogue: 0,0:03:23.53,0:03:25.74,Default,,0,0,0,,Бірақ мен не болып жатқанын білмеймін
Dialogue: 0,0:03:25.74,0:03:25.83,Default,,0,0,0,,Бірақ мен не болып жатқанын білмеймін
Dialogue: 0,0:03:25.83,0:03:26.70,Default,,0,0,0,,Бірақ мен не болып жатқанын білмеймін
Dialogue: 0,0:03:25.83,0:03:26.70,Default,,0,0,0,,Мен саған сол сиқырлы күшті пайдаланба дедім ғой!
Dialogue: 0,0:03:26.70,0:03:26.78,Default,,0,0,0,,Мен саған сол сиқырлы күшті пайдаланба дедім ғой!
Dialogue: 0,0:03:26.78,0:03:28.54,Default,,0,0,0,,Мен саған сол сиқырлы күшті пайдаланба дедім!
Dialogue: 0,0:03:26.78,0:03:28.54,Default,,0,0,0,,Шар ақыр соңында сиқырды үйренуі керек.
Dialogue: 0,0:03:28.54,0:03:28.62,Default,,0,0,0,,Шар ақыр соңында сиқырды үйренуі керек.
Dialogue: 0,0:03:28.62,0:03:29.54,Default,,0,0,0,,Шар ақыр соңында сиқырды үйренуі керек.
Dialogue: 0,0:03:28.62,0:03:29.54,Default,,0,0,0,,Сезімдерің сені алдамасын, балам.
Dialogue: 0,0:03:29.54,0:03:29.62,Default,,0,0,0,,Сезімдерің сені алдамасын, балам.
Dialogue: 0,0:03:29.62,0:03:30.79,Default,,0,0,0,,Сезімдерің алдамасын, балам.
Dialogue: 0,0:03:29.62,0:03:30.79,Default,,0,0,0,,А... Мария әжеден?
Dialogue: 0,0:03:30.79,0:03:30.87,Default,,0,0,0,,А... Мария әжеден бе?
Dialogue: 0,0:03:30.87,0:03:32.25,Default,,0,0,0,,А... Мария әжеден бе?
Dialogue: 0,0:03:30.87,0:03:32.25,Default,,0,0,0,,Уф, шіркін... шіркін!
Dialogue: 0,0:03:32.25,0:03:32.33,Default,,0,0,0,,Уф, шіркін... шіркін!
Dialogue: 0,0:03:32.33,0:03:33.88,Default,,0,0,0,,Уф, шіркін... шіркін!
Dialogue: 0,0:03:32.33,0:03:33.88,Default,,0,0,0,,А... жоқ, сәл мейірімді болыңыз.
Dialogue: 0,0:03:33.88,0:03:33.96,Default,,0,0,0,,А... жоқ, сәл мейірімді болыңыз.
Dialogue: 0,0:03:33.96,0:03:35.63,Default,,0,0,0,,А... жоқ, сәл мейірімді болыңыз.
Dialogue: 0,0:03:33.96,0:03:35.63,Default,,0,0,0,,Тәтті! Хаа!
Dialogue: 0,0:03:35.71,0:03:37.46,Default,,0,0,0,,-Сәлем -Хе...
Dialogue: 0,0:03:35.71,0:03:37.46,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:39.55,0:03:41.47,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:03:41.55,0:03:43.72,Default,,0,0,0,,Торнеллаға оралайық.
Dialogue: 0,0:03:43.80,0:03:45.47,Default,,0,0,0,,Күте тұрыңыз, Рокберри
Dialogue: 0,0:03:46.60,0:03:48.72,Default,,0,0,0,,Сен бұзық болып кеттің.
Dialogue: 0,0:03:48.81,0:03:50.77,Default,,0,0,0,,Шулы, Бяк-кун.
Dialogue: 0,0:03:50.85,0:03:54.23,Default,,0,0,0,,Мен қайтып келетін туған жерім бар деп ешқашан қуанған емеспін.
Dialogue: 0,0:03:54.31,0:03:56.81,Default,,0,0,0,,Хмф, ақымақ әйел.
Dialogue: 0,0:03:56.90,0:03:59.57,Default,,0,0,0,,Әкеңе келгенде одан бетер ақымақ боласың.
Dialogue: 0,0:03:59.65,0:04:02.86,Default,,0,0,0,,Андждың Белле мырзаға деген махаббаты сондай күшті~
Dialogue: 0,0:04:02.95,0:04:03.86,Default,,0,0,0,,Хехехе
Dialogue: 0,0:04:03.95,0:04:07.49,Default,,0,0,0,,Сенің әкең сол қызыл шашты адам, солай ма?
Dialogue: 0,0:04:07.58,0:04:08.66,Default,,0,0,0,,Қайсысы жақсы?
Dialogue: 0,0:04:08.74,0:04:09.83,Default,,0,0,0,,Ах
Dialogue: 0,0:04:09.91,0:04:10.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:10.91,0:04:12.33,Default,,0,0,0,,Бяккун
Dialogue: 0,0:04:12.96,0:04:15.79,Default,,0,0,0,,Әкеңмен кездескенде түсінесің.
Dialogue: 0,0:04:15.88,0:04:17.38,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:04:17.46,0:04:20.09,Default,,0,0,0,,Әпкең сенімен үнемі сөйлеседі, солай ма?
Dialogue: 0,0:04:20.17,0:04:23.30,Default,,0,0,0,,Хехе... Ал қолдарың сондай жылы.
Dialogue: 0,0:04:23.38,0:04:25.93,Default,,0,0,0,,Сіз бір сәтке ғана кездестіңіз, солай емес пе?
Dialogue: 0,0:04:26.01,0:04:28.55,Default,,0,0,0,,Сіз маған көмектестіңіз
Dialogue: 0,0:04:28.64,0:04:29.26,Default,,0,0,0,,Бұдан былай трюк орнатыңыз.
Dialogue: 0,0:04:29.26,0:04:30.43,Default,,0,0,0,,Бұдан былай трюк орнатыңыз.
Dialogue: 0,0:04:29.26,0:04:30.43,Default,,0,0,0,,Егер бұл Торнелла болса, бұл жерден ұрысуға мүмкіндік жоқ.
Dialogue: 0,0:04:30.43,0:04:30.52,Default,,0,0,0,,Егер бұл Торнелла болса, бұл жерден ұрысуға мүмкіндік жоқ.
Dialogue: 0,0:04:30.52,0:04:31.89,Default,,0,0,0,,Егер бұл Торнелла болса, мұндағыдан артық ұрыс мүмкіндігі жоқ.
Dialogue: 0,0:04:30.52,0:04:31.89,Default,,0,0,0,,Сіз не айттыңыз?
Dialogue: 0,0:04:31.89,0:04:31.98,Default,,0,0,0,,Егер бұл Торнелла болса, бұл жерден ұрысуға мүмкіндік жоқ.
Dialogue: 0,0:04:31.98,0:04:32.81,Default,,0,0,0,,Егер бұл Торнелла болса, мұндағыдан артық ұрыс мүмкіндігі жоқ.
Dialogue: 0,0:04:31.98,0:04:32.81,Default,,0,0,0,,Бяку!
Dialogue: 0,0:04:32.89,0:04:35.77,Default,,0,0,0,,Бяк-кун әлі өз күшін меңгерген жоқ.
Dialogue: 0,0:04:32.89,0:04:35.77,Default,,0,0,0,,Жалпы айтқанда, сіз соңғы кездері тым көп ашылдыңыз.
Dialogue: 0,0:04:35.77,0:04:35.85,Default,,0,0,0,,Жалпы айтқанда, сіз соңғы кездері тым көп ашылдыңыз.
Dialogue: 0,0:04:35.85,0:04:36.44,Default,,0,0,0,,Жалпы айтқанда, сіз соңғы кездері тым көп ашылдыңыз.
Dialogue: 0,0:04:35.85,0:04:36.44,Default,,0,0,0,,Сиқырлы күшті пайдаланудың қажеті жоқ
Dialogue: 0,0:04:36.44,0:04:36.52,Default,,0,0,0,,Сиқырлы күшті пайдаланудың қажеті жоқ
Dialogue: 0,0:04:36.52,0:04:37.86,Default,,0,0,0,,Сиқырлы күшті пайдаланудың қажеті жоқ
Dialogue: 0,0:04:36.52,0:04:37.86,Default,,0,0,0,,Уф... өйткені
Dialogue: 0,0:04:37.94,0:04:40.19,Default,,0,0,0,,Ал Шал да Орфеннен.
Dialogue: 0,0:04:37.94,0:04:40.19,Default,,0,0,0,,Жылы алақан – мейірімділіктің белгісі.
Dialogue: 0,0:04:40.19,0:04:40.27,Default,,0,0,0,,Жылы алақан - мейірімді екендігіңнің дәлелі.
Dialogue: 0,0:04:40.27,0:04:40.73,Default,,0,0,0,,Жылы алақан - мейірімді екендігіңнің дәлелі.
Dialogue: 0,0:04:40.27,0:04:40.73,Default,,0,0,0,,Торнеллада қауіпсіз болуыңыз керек.
Dialogue: 0,0:04:40.73,0:04:40.82,Default,,0,0,0,,Торнеллада қауіпсіз болуыңыз керек.
Dialogue: 0,0:04:40.82,0:04:42.99,Default,,0,0,0,,Торнеллада қауіпсіз болуыңыз керек.
Dialogue: 0,0:04:40.82,0:04:42.99,Default,,0,0,0,,Өйткені Бяку ештеңе түсінбейді.
Dialogue: 0,0:04:43.07,0:04:46.49,Default,,0,0,0,,Және де әке компонентін толықтыра аламын.
Dialogue: 0,0:04:46.57,0:04:48.37,Default,,0,0,0,,Керемет жоспар
Dialogue: 0,0:04:48.45,0:04:50.74,Default,,0,0,0,,Кукуку Мен өз талантымнан қорқамын.
Dialogue: 0,0:04:50.83,0:04:51.70,Default,,0,0,0,,Сәлем, Анесса
Dialogue: 0,0:04:51.79,0:04:53.45,Default,,0,0,0,,Иә? ше? Сандал ағашы
Dialogue: 0,0:04:53.54,0:04:56.08,Default,,0,0,0,,Сіз де осы жігіттің әкесімен танысқыңыз келе ме?
Dialogue: 0,0:04:56.17,0:04:58.08,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:04:58.17,0:05:01.96,Default,,0,0,0,,Мистер Беллмен бірге болу мені еркін сезінетін бір нәрсе бар.
Dialogue: 0,0:05:02.05,0:05:04.97,Default,,0,0,0,,Ах... ха...
Dialogue: 0,0:05:07.05,0:05:09.97,Default,,0,0,0,,Жарайды, мен оны саған бердім.
Dialogue: 0,0:05:10.05,0:05:15.48,Default,,0,0,0,,Юме Юме Мен сені алдамақшы деп ойламауыңды өтіндім.
Dialogue: 0,0:05:15.56,0:05:17.81,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:05:17.90,0:05:21.48,Default,,0,0,0,,Неліктен... неге бұл дұрыс емес уақыт?
Dialogue: 0,0:05:22.11,0:05:25.53,Default,,0,0,0,,Мен енді бейтаныс тұлғаның жанынан өте алмаймын.
Dialogue: 0,0:05:25.61,0:05:26.78,Default,,0,0,0,,Лионель
Dialogue: 0,0:05:26.86,0:05:29.95,Default,,0,0,0,,Андж-сан, сен қазір кетесің, солай ма?
Dialogue: 0,0:05:30.03,0:05:33.16,Default,,0,0,0,,Егер уақыт ертерек болса...
Dialogue: 0,0:05:40.75,0:05:44.05,Default,,0,0,0,,Солтүстікте жылдың осы мезгілінде жаңбыр сирек жауады.
Dialogue: 0,0:05:44.13,0:05:46.26,Default,,0,0,0,,Ешқандай жамандық болмайды деп үміттенемін
Dialogue: 0,0:05:46.34,0:05:48.43,Default,,0,0,0,,Сәлем Грэм
Dialogue: 0,0:05:48.51,0:05:51.43,Default,,0,0,0,,Өтінемін, тым жаман сөз айтпаңыз.
Dialogue: 0,0:05:51.51,0:05:53.89,Default,,0,0,0,,Айтқанда рас сияқты
Dialogue: 0,0:05:53.97,0:05:57.39,Default,,0,0,0,,Я, кешіріңіз Белл, бұл жаман әдет.
Dialogue: 0,0:05:58.10,0:05:59.73,Default,,0,0,0,,Ата, ашулысыз ба?
Dialogue: 0,0:05:59.81,0:06:02.11,Default,,0,0,0,,Ха ха ха мен Беллді жеңе алмаймын
Dialogue: 0,0:06:02.19,0:06:04.23,Default,,0,0,0,,- Эй, болды - Иә?
Dialogue: 0,0:06:06.32,0:06:08.36,Default,,0,0,0,,Ей, қыс келгенде
Dialogue: 0,0:06:08.45,0:06:11.16,Default,,0,0,0,,Торнелладан шығу қиынырақ, солай ма?
Dialogue: 0,0:06:11.24,0:06:14.62,Default,,0,0,0,,Иә, мен бұл Эльф территориясы сияқты жаман емес деп ойлаймын.
Dialogue: 0,0:06:14.70,0:06:17.66,Default,,0,0,0,,Мұнда да қар қалың.
Dialogue: 0,0:06:17.75,0:06:19.37,Default,,0,0,0,,Шығу қиын.
Dialogue: 0,0:06:20.63,0:06:22.13,Default,,0,0,0,,Мен...
Dialogue: 0,0:06:22.21,0:06:26.13,Default,,0,0,0,,Мен Торнелладан қыстың алдында кетуді ойлап жүрмін.
Dialogue: 0,0:06:26.21,0:06:29.88,Default,,0,0,0,,Иә? Сіз бұл жерден кеткенде қайда барасыз?
Dialogue: 0,0:06:29.97,0:06:31.39,Default,,0,0,0,,Оңтүстік
Dialogue: 0,0:06:31.47,0:06:33.35,Default,,0,0,0,,Торнелла жақсы жер.
Dialogue: 0,0:06:33.43,0:06:37.14,Default,,0,0,0,,Мен де нағашы ағам сияқты авантюрист болғым келеді.
Dialogue: 0,0:06:37.23,0:06:39.14,Default,,0,0,0,,Мен басқа көзқарасты көргім келеді
Dialogue: 0,0:06:39.23,0:06:41.52,Default,,0,0,0,,Оны тоқтатудың қажеті жоқ.
Dialogue: 0,0:06:41.60,0:06:43.44,Default,,0,0,0,,Мари, қайда бара жатырсың?
Dialogue: 0,0:06:43.52,0:06:46.53,Default,,0,0,0,,Ах, бірақ мәңгі емес.
Dialogue: 0,0:06:46.61,0:06:50.66,Default,,0,0,0,,Бірінші дәрежелі авантюрист болыңыз және міндетті түрде қайта оралыңыз.
Dialogue: 0,0:06:50.74,0:06:52.16,Default,,0,0,0,,- Негізі... - (Грэм Маргерит) А?
Dialogue: 0,0:06:52.24,0:06:56.41,Default,,0,0,0,,Сондықтан мен ауылдан кетуді ойлап отырмын.
Dialogue: 0,0:06:56.49,0:06:57.75,Default,,0,0,0,,Сіз де?
Dialogue: 0,0:06:58.41,0:07:01.79,Default,,0,0,0,,Мен әлі де танысқым келетін адамдар бар.
Dialogue: 0,0:07:01.87,0:07:03.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:03.38,0:07:05.88,Default,,0,0,0,,Сонда оған көмектесу мүмкін емес.
Dialogue: 0,0:07:05.96,0:07:08.09,Default,,0,0,0,,Бірақ Ханна жақсы ма?
Dialogue: 0,0:07:08.17,0:07:10.05,Default,,0,0,0,,Оқиға мынадай.
Dialogue: 0,0:07:10.13,0:07:12.80,Default,,0,0,0,,Егер солай болса, мен келесі сапарымды соңғы сапарға шығарамын деп ойлаймын.
Dialogue: 0,0:07:13.55,0:07:16.31,Default,,0,0,0,,Дункан да қайтып келеді, солай ма?
Dialogue: 0,0:07:16.39,0:07:18.39,Default,,0,0,0,,Мені көп күттірме
Dialogue: 0,0:07:18.47,0:07:21.52,Default,,0,0,0,,Хахаха мен барымды саламын.
Dialogue: 0,0:07:21.60,0:07:25.27,Default,,0,0,0,,Не, Дунканды да бұрышқа қоюға болмайды.
Dialogue: 0,0:07:25.36,0:07:27.53,Default,,0,0,0,,Сонымен? Сіз кететін күнді шештіңіз бе?
Dialogue: 0,0:07:27.61,0:07:30.65,Default,,0,0,0,,Иә, мен оны күз мерекесінен кейін жасаймын деп ойлаймын.
Dialogue: 0,0:07:30.74,0:07:32.86,Default,,0,0,0,,Сонда сен менің соңымнан келесің.
Dialogue: 0,0:07:32.95,0:07:36.03,Default,,0,0,0,,Мари, егер баратын болсаң, күзгі мерекеден кейін бару керек.
Dialogue: 0,0:07:36.12,0:07:38.04,Default,,0,0,0,,Иә? Неліктен?
Dialogue: 0,0:07:38.12,0:07:41.46,Default,,0,0,0,,Көптеген керуендер мен саудагерлер келеді.
Dialogue: 0,0:07:41.54,0:07:44.04,Default,,0,0,0,,Олар қайтып келгенде, сіз олармен бірге бара аласыз.
Dialogue: 0,0:07:44.13,0:07:47.00,Default,,0,0,0,,Е, жоқ, бұл жақсы емес.
Dialogue: 0,0:07:47.09,0:07:49.30,Default,,0,0,0,,Жалғыз саяхаттау оңай емес пе?
Dialogue: 0,0:07:49.38,0:07:52.76,Default,,0,0,0,,Хахаха Тағы адасып кетуді жоспарлап жүрсіз бе?
Dialogue: 0,0:07:52.84,0:07:54.76,Default,,0,0,0,,Мари-доно, авантюрист
Dialogue: 0,0:07:54.84,0:07:58.31,Default,,0,0,0,,Біз алдымен ауыртпалықтар мен тәуекелдерді азайтуды қарастыруымыз керек.
Dialogue: 0,0:07:58.39,0:08:00.31,Default,,0,0,0,,Дункан дұрыс айтады.
Dialogue: 0,0:08:00.39,0:08:03.81,Default,,0,0,0,,А... бірақ... мен қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,0:08:03.90,0:08:05.65,Default,,0,0,0,,Мари, сен қиналып жүрсің бе?
Dialogue: 0,0:08:05.73,0:08:08.32,Default,,0,0,0,,-Хахаха... -А, күлме!
Dialogue: 0,0:08:08.40,0:08:09.07,Default,,0,0,0,,Толық
Dialogue: 0,0:08:09.07,0:08:10.03,Default,,0,0,0,,Толық
Dialogue: 0,0:08:09.07,0:08:10.03,Default,,0,0,0,,Марлей әскері емес.
Dialogue: 0,0:08:10.03,0:08:10.11,Default,,0,0,0,,Марлей әскері емес.
Dialogue: 0,0:08:10.11,0:08:10.74,Default,,0,0,0,,Марлей әскері емес.
Dialogue: 0,0:08:10.11,0:08:10.74,Default,,0,0,0,,Мен бұл жанды өмірге үйрендім.
Dialogue: 0,0:08:10.74,0:08:10.82,Default,,0,0,0,,Мен бұл жанды өмірге үйрендім.
Dialogue: 0,0:08:10.82,0:08:12.40,Default,,0,0,0,,Мен бұл жанды өмірге үйрендім.
Dialogue: 0,0:08:10.82,0:08:12.40,Default,,0,0,0,,Күлме! Мен де
Dialogue: 0,0:08:12.40,0:08:12.49,Default,,0,0,0,,Мен бұл жанды өмірге үйрендім.
Dialogue: 0,0:08:12.49,0:08:13.65,Default,,0,0,0,,Мен бұл жанды өмірге үйрендім.
Dialogue: 0,0:08:12.49,0:08:13.65,Default,,0,0,0,,Мен көп нәрсені ойлап жүрмін.
Dialogue: 0,0:08:13.65,0:08:13.74,Default,,0,0,0,,Мен көп нәрсені ойлап жүрмін.
Dialogue: 0,0:08:13.74,0:08:15.07,Default,,0,0,0,,Мен көп нәрсені ойлап жүрмін.
Dialogue: 0,0:08:13.74,0:08:15.07,Default,,0,0,0,,Осы екеуі кеткенде мен өзімді жалғыз сезінемін.
Dialogue: 0,0:08:15.07,0:08:16.57,Default,,0,0,0,,Осы екеуі кеткенде мен өзімді жалғыз сезінемін.
Dialogue: 0,0:08:22.54,0:08:24.37,Default,,0,0,0,,Тағы да айтыңыз!
Dialogue: 0,0:08:24.46,0:08:26.92,Default,,0,0,0,,Сондықтан, Андж-сан.
Dialogue: 0,0:08:27.00,0:08:30.13,Default,,0,0,0,,Бұл бізден емес, Эрцгерцог Эсгардан...
Dialogue: 0,0:08:30.21,0:08:31.59,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,0:08:31.67,0:08:34.01,Default,,0,0,0,,Мен оның ұлы князь ба, әлде ұлы дворян ба, білмеймін.
Dialogue: 0,0:08:34.09,0:08:37.14,Default,,0,0,0,,Мені шығарып салуға құзырыңыз жоқ!
Dialogue: 0,0:08:37.22,0:08:39.47,Default,,0,0,0,,Анге Аздап тыныштандырады.
Dialogue: 0,0:08:39.56,0:08:40.39,Default,,0,0,0,,Хмм
Dialogue: 0,0:08:40.47,0:08:43.06,Default,,0,0,0,,Бұл Лионельдің кінәсі емес
Dialogue: 0,0:08:43.14,0:08:46.65,Default,,0,0,0,,Естгарға қазір барсаң, қыс келеді.
Dialogue: 0,0:08:46.73,0:08:49.32,Default,,0,0,0,,Сонда сіз Торнеллаға қайта алмайсыз.
Dialogue: 0,0:08:49.40,0:08:51.40,Default,,0,0,0,,Әйтеуір, мен бармаймын.
Dialogue: 0,0:08:51.48,0:08:53.74,Default,,0,0,0,,Сіз доп пен медаль туралы білесіз бе?
Dialogue: 0,0:08:53.82,0:08:55.99,Default,,0,0,0,,Өтінемін, Андж-сан.
Dialogue: 0,0:08:56.07,0:08:58.62,Default,,0,0,0,,Күткендей, егер Ұлы Герцог Эсгар маған қарап тұрса.
Dialogue: 0,0:08:58.70,0:09:00.37,Default,,0,0,0,,Ағайлар, бітті!
Dialogue: 0,0:09:00.45,0:09:01.70,Default,,0,0,0,,Бұл ғұн.
Dialogue: 0,0:09:01.79,0:09:04.62,Default,,0,0,0,,Гильдия шебері бәрібір жұмыстан шығарылады.
Dialogue: 0,0:09:04.71,0:09:07.12,Default,,0,0,0,,Сіз физикалық түрде кесілген боласыз!
Dialogue: 0,0:09:07.21,0:09:10.00,Default,,0,0,0,,Ағай, мен әлі өлгім келмейді!
Dialogue: 0,0:09:10.54,0:09:14.51,Default,,0,0,0,,Широганның ағасы мен Генерал Мускулдың пікірі бірдей ме?
Dialogue: 0,0:09:14.59,0:09:17.13,Default,,0,0,0,,Хатты гильдияға жіберу керек.
Dialogue: 0,0:09:17.22,0:09:20.22,Default,,0,0,0,,Бұл лордтың Эстгарға келуін талап етеді.
Dialogue: 0,0:09:20.30,0:09:24.52,Default,,0,0,0,,Бұл енді жалғыз сенің проблемаң емес, Андж.
Dialogue: 0,0:09:24.60,0:09:26.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:26.10,0:09:27.06,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:09:27.14,0:09:29.81,Default,,0,0,0,,Мұның бәрі сыпайы, солай емес пе?
Dialogue: 0,0:09:29.90,0:09:32.78,Default,,0,0,0,,Егер бұлай болса, ауызды жауып қояйық. Міне бітті.
Dialogue: 0,0:09:33.40,0:09:35.03,Default,,0,0,0,,Иә! Чеборг мырза?
Dialogue: 0,0:09:35.11,0:09:38.07,Default,,0,0,0,,Олар мені қудаласа ше?
Dialogue: 0,0:09:38.16,0:09:40.53,Default,,0,0,0,,Тек оны жойыңыз, солай ма?
Dialogue: 0,0:09:40.62,0:09:42.74,Default,,0,0,0,,Маған бұл ұлы князьдік пе, әлде басқа нәрсе ме, бәрібір.
Dialogue: 0,0:09:42.83,0:09:46.29,Default,,0,0,0,,Бір топ кішкентай шабақ бізді жеңе алмайды.
Dialogue: 0,0:09:46.37,0:09:49.79,Default,,0,0,0,,Шешу мүмкін емес! Эй? Дортос мырза
Dialogue: 0,0:09:49.88,0:09:53.75,Default,,0,0,0,,Жоқ, бұл туралы қалай ойлайтыныңызға байланысты, иә.
Dialogue: 0,0:09:53.84,0:09:57.30,Default,,0,0,0,,Чеборг Марияны да шығарсам.
Dialogue: 0,0:09:57.38,0:09:58.93,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:09:59.01,0:10:01.35,Default,,0,0,0,,Сіз Орфенді ұрыс алаңы ретінде пайдалануды жоспарлап отырсыз ба?
Dialogue: 0,0:10:01.43,0:10:04.18,Default,,0,0,0,,Жалпы айтқанда, Ұлы Герцогтың отбасы Чеборгтың ескі үйі!
Dialogue: 0,0:10:06.89,0:10:10.94,Default,,0,0,0,,Ха... Мен баруым керек, солай ма?
Dialogue: 0,0:10:11.02,0:10:11.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:11.98,0:10:13.44,Default,,0,0,0,,А... Андж-сан?
Dialogue: 0,0:10:14.61,0:10:17.82,Default,,0,0,0,,Ұлы Герцогтің әскерімен соғысу қызықты болар еді.
Dialogue: 0,0:10:17.90,0:10:20.57,Default,,0,0,0,,Олай істесең, әкең саған ашуланады.
Dialogue: 0,0:10:22.03,0:10:24.16,Default,,0,0,0,,О...
Dialogue: 0,0:10:24.66,0:10:28.71,Default,,0,0,0,,Эй, Эндж де ересек адамға айналды.
Dialogue: 0,0:10:28.79,0:10:33.42,Default,,0,0,0,,Мүлде жоқ. Мен бақыттымын. Мен жалғызбын.
Dialogue: 0,0:10:33.50,0:10:36.71,Default,,0,0,0,,Бірақ бұл Ұлы Герцог Эсгарға ұнамайды.
Dialogue: 0,0:10:36.80,0:10:39.13,Default,,0,0,0,,Мен мұнымен келісемін.
Dialogue: 0,0:10:39.22,0:10:44.56,Default,,0,0,0,,Менің ойымша, бұл күндері Жын патшасын жеңгені үшін марапаттау саяси астарлы сияқты.
Dialogue: 0,0:10:45.14,0:10:48.23,Default,,0,0,0,,Бірақ мен Эндж-санның тынышталғанына қуаныштымын.
Dialogue: 0,0:10:49.10,0:10:52.73,Default,,0,0,0,,Екеуіңді ертерек сайқымазақ сияқты қылғаны үшін кешірім сұраймын.
Dialogue: 0,0:10:52.81,0:10:54.82,Default,,0,0,0,,- Иә? - А? О...
Dialogue: 0,0:10:54.90,0:10:56.23,Default,,0,0,0,,(Чеборг ысқырығы)
Dialogue: 0,0:10:56.32,0:10:57.99,Default,,0,0,0,,Ум...
Dialogue: 0,0:10:58.07,0:11:02.32,Default,,0,0,0,,Мен Андж-санды сендіру үшін спектакль қойдым деп ойлаймын...
Dialogue: 0,0:11:02.41,0:11:04.74,Default,,0,0,0,,Өтінемін, үндемеңіз.
Dialogue: 0,0:11:04.83,0:11:06.83,Default,,0,0,0,,Неге көзіңді жұмып тұрсың?
Dialogue: 0,0:11:06.91,0:11:09.83,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:11:11.62,0:11:12.46,Default,,0,0,0,,Хмм…
Dialogue: 0,0:11:12.54,0:11:15.38,Default,,0,0,0,,Әй... Әпке, не болды?
Dialogue: 0,0:11:15.46,0:11:17.67,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:17.76,0:11:19.05,Default,,0,0,0,,Неге сонша ашуланасың?
Dialogue: 0,0:11:19.13,0:11:21.34,Default,,0,0,0,,Торнеллаға рейс кейінге шегерілді
Dialogue: 0,0:11:21.43,0:11:23.34,Default,,0,0,0,,А... не... неге?
Dialogue: 0,0:11:24.72,0:11:25.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:25.68,0:11:27.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:32.52,0:11:35.27,Default,,0,0,0,,көремін. Сол үшін келдің бе?
Dialogue: 0,0:11:35.36,0:11:38.36,Default,,0,0,0,,Бұл не! Бұл тек асылдың таңдауы!
Dialogue: 0,0:11:38.44,0:11:39.61,Default,,0,0,0,,Олар маған медаль береміз деді.
Dialogue: 0,0:11:39.69,0:11:43.53,Default,,0,0,0,,Андж жын патшасын жеңгеніне бір жыл болды!
Dialogue: 0,0:11:43.61,0:11:45.12,Default,,0,0,0,,Сәлем? Арне
Dialogue: 0,0:11:45.20,0:11:46.24,Default,,0,0,0,,Хмм.
Dialogue: 0,0:11:46.33,0:11:49.87,Default,,0,0,0,,Бірақ мен күткендей, герцогқа шыдай алмаймын.
Dialogue: 0,0:11:49.95,0:11:54.63,Default,,0,0,0,,Сонымен мен әкемді де, Ивакомомоны да қасымда қалдырдым.
Dialogue: 0,0:11:54.71,0:11:57.88,Default,,0,0,0,,Уф~ Белл мырзамен кездескім келді~
Dialogue: 0,0:11:58.80,0:12:01.38,Default,,0,0,0,,Сонымен? Алдағы жоспарларыңыз қандай?
Dialogue: 0,0:12:01.47,0:12:06.10,Default,,0,0,0,,Ешқандай айналма жолдарсыз жарты айға жуық ат арбасымен Эстгарға барыңыз.
Dialogue: 0,0:12:06.18,0:12:08.39,Default,,0,0,0,,Барып қайтуға бір ай керек.
Dialogue: 0,0:12:08.47,0:12:12.02,Default,,0,0,0,,Сіз жай ғана барып қайта алмайсыз, солай ма?
Dialogue: 0,0:12:12.10,0:12:14.65,Default,,0,0,0,,Мені бірнеше күн ұстайды деп ойлаймын.
Dialogue: 0,0:12:14.73,0:12:15.90,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:12:15.98,0:12:18.40,Default,,0,0,0,,Сондықтан мен сізбен Чар және басқалар туралы сөйлескім келді.
Dialogue: 0,0:12:18.98,0:12:21.15,Default,,0,0,0,,Егер Арне мен Милли менімен бірге келсе.
Dialogue: 0,0:12:21.24,0:12:24.41,Default,,0,0,0,,Мен Чару мен Бяккунды өзіммен бірге ала аламын деп ойладым.
Dialogue: 0,0:12:24.49,0:12:25.53,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:25.61,0:12:28.91,Default,,0,0,0,,Біз жеткенде, Андж да бос емес болады.
Dialogue: 0,0:12:28.99,0:12:33.46,Default,,0,0,0,,Иә, мен сені жалғыз қорғай алмаймын.
Dialogue: 0,0:12:33.54,0:12:36.67,Default,,0,0,0,,Өткен жолы мен Розеттаны ренжіттім.
Dialogue: 0,0:12:36.75,0:12:39.04,Default,,0,0,0,,Егер солай болса, екеуміз бірге жүреміз.
Dialogue: 0,0:12:39.13,0:12:42.01,Default,,0,0,0,,Осында қалғанымыз жақсы емес пе?
Dialogue: 0,0:12:42.09,0:12:45.76,Default,,0,0,0,,Хехе, егер Андж жалғыз болмаса.
Dialogue: 0,0:12:45.84,0:12:49.39,Default,,0,0,0,,Сіз жалғыз бола алмайсыз. Мені кім деп ойлайсың?
Dialogue: 0,0:12:49.47,0:12:50.93,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:12:51.02,0:12:53.39,Default,,0,0,0,,Жақсырақ, Арне мен мен, Шалл мен Бяккун.
Dialogue: 0,0:12:53.48,0:12:56.35,Default,,0,0,0,,Мені Торнеллаға апаруға қалай болады?
Dialogue: 0,0:12:56.44,0:12:59.86,Default,,0,0,0,,Дайындығым зая кетпейді, мен Белл мырзамен кездесе аламын.
Dialogue: 0,0:12:59.94,0:13:00.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:00.86,0:13:02.53,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:02.61,0:13:05.78,Default,,0,0,0,,О... мені сонда қалдырмаңыз!
Dialogue: 0,0:13:05.86,0:13:07.87,Default,,0,0,0,,-Аа -Ах...
Dialogue: 0,0:13:05.86,0:13:07.87,Default,,0,0,0,,(Анджелинаның айқайы)
Dialogue: 0,0:13:07.87,0:13:07.95,Default,,0,0,0,,(Анджелинаның айқайы)
Dialogue: 0,0:13:07.95,0:13:09.87,Default,,0,0,0,,(Анджелинаның айқайы)
Dialogue: 0,0:13:07.95,0:13:09.87,Default,,0,0,0,,Уау~ Кешіріңіз, кешіріңіз!
Dialogue: 0,0:13:09.87,0:13:09.95,Default,,0,0,0,,(Анджелинаның айқайы)
Dialogue: 0,0:13:09.95,0:13:11.33,Default,,0,0,0,,(Анджелина жылайды)
Dialogue: 0,0:13:09.95,0:13:11.33,Default,,0,0,0,,Әзіл!
Dialogue: 0,0:13:11.41,0:13:14.21,Default,,0,0,0,,Сен Анджды тастап, Торнеллаға бара алмайсың, солай ма?
Dialogue: 0,0:13:14.29,0:13:16.12,Default,,0,0,0,,Қарашы, жақсы қыз, жақсы қыз.
Dialogue: 0,0:13:16.21,0:13:18.63,Default,,0,0,0,,-Жоқ! -Әпке
Dialogue: 0,0:13:18.71,0:13:21.13,Default,,0,0,0,,Милли, сен...
Dialogue: 0,0:13:21.21,0:13:22.88,Default,,0,0,0,,Барыңыз… gomentteba
Dialogue: 0,0:13:22.96,0:13:26.22,Default,,0,0,0,,Мен сені жылайды деп ойламадым!
Dialogue: 0,0:13:29.01,0:13:33.35,Default,,0,0,0,,Жарайды, мен өзім барамын, сондықтан бәрі Орфенде үйде қалады.
Dialogue: 0,0:13:33.43,0:13:35.10,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:13:35.18,0:13:38.35,Default,,0,0,0,,Сіз жеңілсіз, сондықтан жұмысыңыз біткеннен кейін бірден қайта аласыз.
Dialogue: 0,0:13:38.44,0:13:41.61,Default,,0,0,0,,Екеуіңе рахмет.
Dialogue: 0,0:13:41.69,0:13:42.86,Default,,0,0,0,,-Ал... -Мм.
Dialogue: 0,0:13:42.94,0:13:46.61,Default,,0,0,0,,Торнеллаға асықпаңыз.
Dialogue: 0,0:13:46.70,0:13:48.11,Default,,0,0,0,,Жақсы ма? Милли
Dialogue: 0,0:13:48.20,0:13:51.87,Default,,0,0,0,,Әй, сондықтан әзіл.
Dialogue: 0,0:13:52.62,0:13:54.62,Default,,0,0,0,,Бұл Чар мен Бьякуға да жарай ма?
Dialogue: 0,0:13:54.70,0:13:56.08,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:13:56.16,0:13:59.38,Default,,0,0,0,,Жарайды, онда мен екеуіңді өз үйімде қалдырамын.
Dialogue: 0,0:13:59.46,0:14:01.09,Default,,0,0,0,,Сәтсіз болғаным үшін кешіріңіз
Dialogue: 0,0:14:01.17,0:14:04.34,Default,,0,0,0,,Эй... мен саған тазалауға көмектесемін, Арне.
Dialogue: 0,0:14:04.42,0:14:06.26,Default,,0,0,0,,Ахаха рахмет
Dialogue: 0,0:14:06.34,0:14:08.84,Default,,0,0,0,,Сонымен, Андж, сен қашан кетесің?
Dialogue: 0,0:14:08.93,0:14:10.26,Default,,0,0,0,,Ертең
Dialogue: 0,0:14:10.34,0:14:12.68,Default,,0,0,0,,Мен бәрібір сапарға дайындалдым.
Dialogue: 0,0:14:12.76,0:14:16.48,Default,,0,0,0,,Жарайды, қараңғы болды, кәдімгі дүкенге барайық.
Dialogue: 0,0:14:16.56,0:14:18.35,Default,,0,0,0,,Бүгін тамақтанайық~
Dialogue: 0,0:14:18.44,0:14:20.35,Default,,0,0,0,,О, Миллидің сыйы ма?
Dialogue: 0,0:14:20.44,0:14:23.86,Default,,0,0,0,,А... Мен... амалым жоқ.
Dialogue: 0,0:14:23.94,0:14:26.36,Default,,0,0,0,,(Ағаш қылыштардың бір-біріне тиген дыбысы)
Dialogue: 0,0:14:26.86,0:14:29.36,Default,,0,0,0,,Ой... ой... ой
Dialogue: 0,0:14:29.45,0:14:30.87,Default,,0,0,0,,Хмм…
Dialogue: 0,0:14:31.62,0:14:33.12,Default,,0,0,0,,Осы жерде қалдырайық.
Dialogue: 0,0:14:33.20,0:14:37.00,Default,,0,0,0,,О, менімен араласқаныңызға рахмет, Грэм.
Dialogue: 0,0:14:37.08,0:14:38.12,Default,,0,0,0,,Я...
Dialogue: 0,0:14:40.75,0:14:44.21,Default,,0,0,0,,Жоқ, мен шоғырлана алмаймын.
Dialogue: 0,0:14:47.30,0:14:48.05,Default,,0,0,0,,(Ағаш қылыштардың бір-біріне тиген дыбысы)
Dialogue: 0,0:14:48.05,0:14:50.97,Default,,0,0,0,,(Ағаш қылыштардың бір-біріне тиген дыбысы)
Dialogue: 0,0:14:48.05,0:14:50.97,Default,,0,0,0,,Неге қазір сол күндерді армандайсың?
Dialogue: 0,0:14:50.97,0:14:51.72,Default,,0,0,0,,(Ағаш қылыштардың бір-біріне тиген дыбысы)
Dialogue: 0,0:14:51.80,0:14:53.22,Default,,0,0,0,,-Жарайды! -Хмм
Dialogue: 0,0:14:53.30,0:14:56.68,Default,,0,0,0,,Менде біреуі бар. Сіз оны көрдіңіз бе? Керемет аға!
Dialogue: 0,0:14:56.77,0:14:58.73,Default,,0,0,0,,Ммм, жарайсың.
Dialogue: 0,0:14:58.81,0:15:00.60,Default,,0,0,0,,Міне, келдік
Dialogue: 0,0:15:00.69,0:15:03.23,Default,,0,0,0,,Сен одан да күшті болып кеттің, Мари-доно.
Dialogue: 0,0:15:03.31,0:15:04.98,Default,,0,0,0,,Иа... хех
Dialogue: 0,0:15:05.77,0:15:07.23,Default,,0,0,0,,Бұл таңқаларлық, Мари.
Dialogue: 0,0:15:07.32,0:15:10.32,Default,,0,0,0,,Осының көмегімен сіз Торнелладан кетіп қалсаңыз да өзіңізді қауіпсіз сезіне аласыз.
Dialogue: 0,0:15:11.24,0:15:12.07,Default,,0,0,0,,Фу…
Dialogue: 0,0:15:17.12,0:15:18.70,Default,,0,0,0,,(Қоңыраудың дыбысы)
Dialogue: 0,0:15:18.79,0:15:19.83,Default,,0,0,0,,Иә Жеңіс
Dialogue: 0,0:15:19.91,0:15:21.96,Default,,0,0,0,,Құттықтаймыз Эльф-сан
Dialogue: 0,0:15:22.04,0:15:24.46,Default,,0,0,0,,Маған мынаны бере аласыз ба?
Dialogue: 0,0:15:24.54,0:15:26.30,Default,,0,0,0,,Рахмет хехе
Dialogue: 0,0:15:26.38,0:15:28.80,Default,,0,0,0,,Қалай ойлайсың, Мито, бұл саған сәйкес пе?
Dialogue: 0,0:15:28.88,0:15:30.26,Default,,0,0,0,,Сізге сәйкес келе ме?
Dialogue: 0,0:15:30.34,0:15:33.51,Default,,0,0,0,,Хаха... Мен бұл етті алдым.
Dialogue: 0,0:15:33.59,0:15:35.93,Default,,0,0,0,,- Жақсы ма? -Дәмді
Dialogue: 0,0:15:36.01,0:15:37.51,Default,,0,0,0,,-Сәлем Мари -Хмм.
Dialogue: 0,0:15:40.64,0:15:43.19,Default,,0,0,0,,Бұл бұрын айтқан қылышшы.
Dialogue: 0,0:15:43.27,0:15:44.52,Default,,0,0,0,,Қолдар көтеріледі
Dialogue: 0,0:15:44.61,0:15:45.98,Default,,0,0,0,,Мари Бұл...
Dialogue: 0,0:15:46.07,0:15:47.52,Default,,0,0,0,,…
Dialogue: 0,0:15:47.61,0:15:49.53,Default,,0,0,0,,...
Dialogue: 0,0:15:49.61,0:15:50.69,Default,,0,0,0,,Мари
Dialogue: 0,0:15:50.78,0:15:54.70,Default,,0,0,0,,...
Dialogue: 0,0:15:54.78,0:15:56.95,Default,,0,0,0,,Бұл адам саудагер.
Dialogue: 0,0:15:57.03,0:15:58.99,Default,,0,0,0,,...
Dialogue: 0,0:15:59.08,0:16:01.04,Default,,0,0,0,,Іздеп көр дедім ғой, солай ма?
Dialogue: 0,0:16:01.12,0:16:03.37,Default,,0,0,0,,Мені Белл алып келді
Dialogue: 0,0:16:03.46,0:16:06.17,Default,,0,0,0,,...
Dialogue: 0,0:16:06.25,0:16:09.17,Default,,0,0,0,,Ах... иә, мм...
Dialogue: 0,0:16:09.25,0:16:14.01,Default,,0,0,0,,...
Dialogue: 0,0:16:14.09,0:16:19.18,Default,,0,0,0,,...
Dialogue: 0,0:16:19.26,0:16:22.48,Default,,0,0,0,,Көремін... Көремін.
Dialogue: 0,0:16:22.56,0:16:25.19,Default,,0,0,0,,２
Dialogue: 0,0:16:25.27,0:16:28.27,Default,,0,0,0,,О, мен жасадым! рақмет сізге!
Dialogue: 0,0:16:28.36,0:16:30.36,Default,,0,0,0,,Менің атым Маргерит.
Dialogue: 0,0:16:30.44,0:16:31.94,Default,,0,0,0,,...
Dialogue: 0,0:16:32.03,0:16:34.45,Default,,0,0,0,,Мынадай көрінсе, жарайды.
Dialogue: 0,0:16:34.53,0:16:35.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:39.62,0:16:42.33,Default,,0,0,0,,Сізде алаңдайтын нәрсе бар сияқты.
Dialogue: 0,0:16:42.41,0:16:44.62,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:16:45.33,0:16:47.75,Default,,0,0,0,,Тыңдап көрейік, досым.
Dialogue: 0,0:16:47.84,0:16:49.46,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:50.17,0:16:53.72,Default,,0,0,0,,...
Dialogue: 0,0:16:59.10,0:17:02.73,Default,,0,0,0,,...
Dialogue: 0,0:17:02.81,0:17:06.77,Default,,0,0,0,,...
Dialogue: 0,0:17:06.85,0:17:08.48,Default,,0,0,0,,Сізді не уайымдайды?
Dialogue: 0,0:17:08.56,0:17:11.73,Default,,0,0,0,,...
Dialogue: 0,0:17:11.82,0:17:16.49,Default,,0,0,0,,...
Dialogue: 0,0:17:16.57,0:17:18.78,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:17:19.53,0:17:22.24,Default,,0,0,0,,...
Dialogue: 0,0:17:22.33,0:17:24.29,Default,,0,0,0,,Мен оны көрмедім.
Dialogue: 0,0:17:24.37,0:17:27.67,Default,,0,0,0,,...
Dialogue: 0,0:17:27.75,0:17:30.00,Default,,0,0,0,,Оның үстіне маған келгенде
Dialogue: 0,0:17:30.09,0:17:32.13,Default,,0,0,0,,Сіз Торнелла үшін алаңдайсыз ба?
Dialogue: 0,0:17:32.63,0:17:36.55,Default,,0,0,0,,...
Dialogue: 0,0:17:37.63,0:17:39.55,Default,,0,0,0,,Мен қалар едім.
Dialogue: 0,0:17:39.64,0:17:42.22,Default,,0,0,0,,Не? Сіз Торнелладасыз ба?
Dialogue: 0,0:17:42.31,0:17:44.73,Default,,0,0,0,,...
Dialogue: 0,0:17:44.81,0:17:47.06,Default,,0,0,0,,Менің ойымша, сіз де сапарыңызды жалғастырасыз ...
Dialogue: 0,0:17:47.14,0:17:50.52,Default,,0,0,0,,...
Dialogue: 0,0:17:50.61,0:17:52.57,Default,,0,0,0,,Бұл қауіпті.
Dialogue: 0,0:17:52.65,0:17:56.45,Default,,0,0,0,,...
Dialogue: 0,0:17:56.53,0:17:59.57,Default,,0,0,0,,Көрдім, Мари де есейіп кетті.
Dialogue: 0,0:17:59.66,0:18:02.03,Default,,0,0,0,,Сізге рахмет, Белл.
Dialogue: 0,0:18:02.12,0:18:04.58,Default,,0,0,0,,Мен сол жақсылығымды өтегім келеді.
Dialogue: 0,0:18:04.66,0:18:08.04,Default,,0,0,0,,Рахмет, Грэм, мен оны бағалаймын.
Dialogue: 0,0:18:08.12,0:18:10.67,Default,,0,0,0,,Менің бір өтінішім бар.
Dialogue: 0,0:18:10.75,0:18:11.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:11.67,0:18:14.42,Default,,0,0,0,,Сіз сапарда жүргенде
Dialogue: 0,0:18:14.51,0:18:17.26,Default,,0,0,0,,Митоны ұстай аламын ба?
Dialogue: 0,0:18:17.34,0:18:19.09,Default,,0,0,0,,Я, сен жалғызсың ба?
Dialogue: 0,0:18:20.14,0:18:21.68,Default,,0,0,0,,Сіз жалғызсыз ба?
Dialogue: 0,0:18:30.69,0:18:32.82,Default,,0,0,0,,Гил мырза! Неліктен?
Dialogue: 0,0:18:32.90,0:18:35.32,Default,,0,0,0,,Негізі мені де шақырды.
Dialogue: 0,0:18:35.40,0:18:36.78,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:18:36.86,0:18:40.11,Default,,0,0,0,,Хехе, өтірік, сен Лионельден естіген жоқсың ба?
Dialogue: 0,0:18:40.20,0:18:42.20,Default,,0,0,0,,А... Мен мұны естімедім.
Dialogue: 0,0:18:42.28,0:18:45.99,Default,,0,0,0,,Бірақ олардың маған белсенді AAA (Үштік А) беретініне сене алмаймын.
Dialogue: 0,0:18:46.08,0:18:48.21,Default,,0,0,0,,Гильдия шебері де бұл туралы ойлаған шығар.
Dialogue: 0,0:18:49.87,0:18:50.71,Default,,0,0,0,,Әй?
Dialogue: 0,0:18:50.79,0:18:53.71,Default,,0,0,0,,Гил мырза осында болса, менің де жеңілдеп қалдым.
Dialogue: 0,0:18:53.79,0:18:56.13,Default,,0,0,0,,О, бұл құрмет.
Dialogue: 0,0:18:56.21,0:18:58.55,Default,,0,0,0,,Мен сіздің үміттеріңізді ақтаймын деп үміттенемін.
Dialogue: 0,0:18:58.63,0:19:00.97,Default,,0,0,0,,Біраз уақыт танысқаныма қуаныштымын, Андж
Dialogue: 0,0:19:02.01,0:19:02.85,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:03.60,0:19:06.14,Default,,0,0,0,,- (Шытырманшы) Еш қағыспа! - (Авантюрист) Жүр!
Dialogue: 0,0:19:03.60,0:19:06.14,Default,,0,0,0,,(Қасымның ауыр тыныс алуы)
Dialogue: 0,0:19:06.14,0:19:06.22,Default,,0,0,0,,(Қасымның ауыр тыныс алуы)
Dialogue: 0,0:19:06.22,0:19:06.52,Default,,0,0,0,,(Қасымның ауыр тыныс алуы)
Dialogue: 0,0:19:06.22,0:19:06.52,Default,,0,0,0,,- (Шытырманшы) Боқ - (Авантюрист) Арх!
Dialogue: 0,0:19:06.52,0:19:06.60,Default,,0,0,0,,- (Шытырманшы) Боқ - (Авантюрист) Арх!
Dialogue: 0,0:19:06.60,0:19:08.23,Default,,0,0,0,,- (Шытырманшы) Боқ - (Авантюрист) Арх!
Dialogue: 0,0:19:06.60,0:19:08.23,Default,,0,0,0,,Гууууууук
Dialogue: 0,0:19:08.89,0:19:11.15,Default,,0,0,0,,Мына жерде! Бүйірден келе жатыр!
Dialogue: 0,0:19:11.23,0:19:12.23,Default,,0,0,0,,Гррр…
Dialogue: 0,0:19:15.02,0:19:18.69,Default,,0,0,0,,Сіз бұл тосын шабуылды қашан байқадыңыз?
Dialogue: 0,0:19:18.78,0:19:21.86,Default,,0,0,0,,Иә, бұл таңқаларлық.
Dialogue: 0,0:19:22.53,0:19:25.03,Default,,0,0,0,,Бізге жетіспейтін нәрсе осы!
Dialogue: 0,0:19:25.62,0:19:26.45,Default,,0,0,0,,Ах
Dialogue: 0,0:19:26.54,0:19:29.71,Default,,0,0,0,,Бүгін де бос тұрдың.
Dialogue: 0,0:19:29.79,0:19:31.58,Default,,0,0,0,,Жоқ, мен соғыс жағдайын түсінуге тырыстым...
Dialogue: 0,0:19:31.67,0:19:34.50,Default,,0,0,0,,Шулы! Бізге пайдасыз адамдар керек емес.
Dialogue: 0,0:19:34.59,0:19:36.59,Default,,0,0,0,,Бүгін ғана, шығыңыз!
Dialogue: 0,0:19:40.97,0:19:43.30,Default,,0,0,0,,- (Персивал) Эй - Мен?
Dialogue: 0,0:19:43.39,0:19:45.35,Default,,0,0,0,,О, сен кереметсің
Dialogue: 0,0:19:45.43,0:19:46.51,Default,,0,0,0,,Не?
Dialogue: 0,0:19:46.60,0:19:49.47,Default,,0,0,0,,Бүйірден жасалған тосын шабуыл қандай болды?
Dialogue: 0,0:19:49.56,0:19:51.19,Default,,0,0,0,,Сіз оны жақсы байқадыңыз.
Dialogue: 0,0:19:51.27,0:19:53.06,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:19:53.15,0:19:54.94,Default,,0,0,0,,Ой… ой, жоқ
Dialogue: 0,0:19:55.02,0:19:57.44,Default,,0,0,0,,Біздің партияға қосылғыңыз келе ме?
Dialogue: 0,0:19:57.52,0:19:59.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:59.15,0:20:01.90,Default,,0,0,0,,Маған сен сияқты адам қосылса
Dialogue: 0,0:20:01.99,0:20:03.91,Default,,0,0,0,,Біз құтқарыламыз, солай ма?
Dialogue: 0,0:20:03.99,0:20:05.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:10.66,0:20:11.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:11.71,0:20:15.13,Default,,0,0,0,,Сіз қайтып келмейсіз бе? Олардың да бақытты болатынына сенімдімін.
Dialogue: 0,0:20:15.21,0:20:19.55,Default,,0,0,0,,…
Dialogue: 0,0:20:19.63,0:20:22.80,Default,,0,0,0,,...
Dialogue: 0,0:20:22.88,0:20:26.14,Default,,0,0,0,,Балалар, қазірдің өзінде В дәрежелісің, солай ма?
Dialogue: 0,0:20:26.22,0:20:28.93,Default,,0,0,0,,...
Dialogue: 0,0:20:29.01,0:20:31.81,Default,,0,0,0,,...
Dialogue: 0,0:20:31.89,0:20:34.31,Default,,0,0,0,,Бірақ... бірақ бұл...
Dialogue: 0,0:20:34.39,0:20:36.61,Default,,0,0,0,,Маған солай қарама.
Dialogue: 0,0:20:36.69,0:20:39.94,Default,,0,0,0,,...
Dialogue: 0,0:20:40.03,0:20:42.65,Default,,0,0,0,,-Бірақ мен... -Жолдамын.
Dialogue: 0,0:20:43.28,0:20:45.82,Default,,0,0,0,,Мен гильдияға Мәңгілік шөпті жеткізуім керек.
Dialogue: 0,0:20:49.41,0:20:52.00,Default,,0,0,0,,Аман бол, Қасым
Dialogue: 0,0:20:52.08,0:20:54.08,Default,,0,0,0,,Оларға да сәлем айтыңыз.
Dialogue: 0,0:20:54.16,0:20:56.50,Default,,0,0,0,,Ал... Қоңырау!
Dialogue: 0,0:21:01.88,0:21:03.59,Default,,0,0,0,,Бұл жаман түс
Dialogue: 0,0:21:04.97,0:21:11.10,Default,,0,0,0,,...
Dialogue: 0,0:21:27.49,0:21:32.16,Default,,0,0,0,,...
Dialogue: 0,0:21:33.70,0:21:35.37,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:21:35.96,0:21:39.38,Default,,0,0,0,,Сіз тағы да осындасыз ба? Егер біз сізді тапсақ, бұл үлкен мәселе болады.
Dialogue: 0,0:21:39.46,0:21:43.59,Default,,0,0,0,,...
Dialogue: 0,0:21:43.67,0:21:46.88,Default,,0,0,0,,Сарай балға дайындалуда.
Dialogue: 0,0:21:46.97,0:21:50.14,Default,,0,0,0,,...
Dialogue: 0,0:21:50.22,0:21:51.39,Default,,0,0,0,,Бұл жерде суық
Dialogue: 0,0:21:51.47,0:21:53.64,Default,,0,0,0,,Біраз уақыт болса болды.
Dialogue: 0,0:21:53.72,0:21:57.06,Default,,0,0,0,,Әй, мен саған тағы бір оқиға айтайын, Қасым.
Dialogue: 0,0:21:57.14,0:21:59.81,Default,,0,0,0,,Ха, мен көмектесе алмаймын.
Dialogue: 0,0:22:00.90,0:22:04.23,Default,,0,0,0,,１
Dialogue: 0,0:22:04.32,0:22:05.32,Default,,0,0,0,,Хмм?
Dialogue: 0,0:22:05.90,0:22:10.91,Default,,0,0,0,,♪～
Dialogue: 0,0:23:30.86,0:23:35.87,Default,,0,0,0,,～♪
Dialogue: 0,0:23:37.37,0:23:43.37,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory