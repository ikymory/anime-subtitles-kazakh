Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.76,0:00:16.59,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:00:16.68,0:00:18.35,Default,,0,0,0,,Сіздің мақсатыңыз осы ма?
Dialogue: 0,0:00:30.53,0:00:33.32,Default,,0,0,0,,Сіз мені басып оздыңыз ба?
Dialogue: 0,0:00:34.74,0:00:38.12,Default,,0,0,0,,Мен басқа әрекетті ойлауым керек.
Dialogue: 0,0:00:39.03,0:00:44.04,Default,,0,0,0,,♪～
Dialogue: 0,0:02:03.62,0:02:08.92,Default,,0,0,0,,～♪
Dialogue: 0,0:02:09.71,0:02:11.63,Default,,0,0,0,,Иә, барлығы сапқа тұрады.
Dialogue: 0,0:02:11.71,0:02:13.38,Default,,0,0,0,,Мен оны сізге ретімен беремін.
Dialogue: 0,0:02:13.38,0:02:13.92,Default,,0,0,0,,Мен оны сізге кезекпен беремін. (Балалар) Иә!
Dialogue: 0,0:02:13.92,0:02:14.00,Default,,0,0,0,,Уа!
Dialogue: 0,0:02:14.00,0:02:15.13,Default,,0,0,0,,Иә! Мынау
Dialogue: 0,0:02:15.21,0:02:17.22,Default,,0,0,0,,Орфендегі танымал глинтвинол
Dialogue: 0,0:02:17.30,0:02:19.47,Default,,0,0,0,,Осы дәмдеуіштер мен бал қосыңыз
Dialogue: 0,0:02:19.55,0:02:21.09,Default,,0,0,0,,Жылынып, ішіңіз
Dialogue: 0,0:02:21.18,0:02:22.68,Default,,0,0,0,,Осы екеуінің қайсысы екенін сұрап тұрмын. Сен бе?
Dialogue: 0,0:02:22.76,0:02:24.76,Default,,0,0,0,,Иә, а, және...
Dialogue: 0,0:02:31.23,0:02:33.52,Default,,0,0,0,,Сіз үлкейдіңіз, иә?
Dialogue: 0,0:02:33.61,0:02:36.32,Default,,0,0,0,,Иә? Бұл қайда?
Dialogue: 0,0:02:37.82,0:02:39.82,Default,,0,0,0,,S разряд тақтасы?
Dialogue: 0,0:02:39.90,0:02:44.24,Default,,0,0,0,,Е дәрежесімен бітірген адамның қызы қалайша S дәрежесіне ие болды?
Dialogue: 0,0:02:44.33,0:02:45.41,Default,,0,0,0,,Иә
Dialogue: 0,0:02:46.20,0:02:47.70,Default,,0,0,0,,-Әке? -иә?
Dialogue: 0,0:02:47.79,0:02:49.21,Default,,0,0,0,,Не болды?
Dialogue: 0,0:02:49.29,0:02:52.79,Default,,0,0,0,,Ахаха жоқ, ештеңе.
Dialogue: 0,0:02:53.54,0:02:54.71,Default,,0,0,0,,(Қарт әйел) Құдайым-ай, сіз қандай құмар әрі жігерлі талапкерсіз.
Dialogue: 0,0:02:54.79,0:02:55.71,Default,,0,0,0,,Уау
Dialogue: 0,0:02:55.80,0:02:58.05,Default,,0,0,0,,Лагер мен сабанның иісі
Dialogue: 0,0:02:58.13,0:03:00.59,Default,,0,0,0,,Әкеңнің иісі жақсы ғой.
Dialogue: 0,0:03:00.68,0:03:04.05,Default,,0,0,0,,Ахаха сен не айтып тұрсың?
Dialogue: 0,0:03:04.14,0:03:06.60,Default,,0,0,0,,Өссем де, бұзылған баламын.
Dialogue: 0,0:03:06.68,0:03:08.77,Default,,0,0,0,,Мен қанша жаста болсам да
Dialogue: 0,0:03:08.85,0:03:11.10,Default,,0,0,0,,Мен әкемнің қызымын.
Dialogue: 0,0:03:11.19,0:03:12.65,Default,,0,0,0,,Хехе
Dialogue: 0,0:03:13.86,0:03:15.11,Default,,0,0,0,,Ақыры оларға бақыт келді
Dialogue: 0,0:03:15.19,0:03:17.11,Default,,0,0,0,,Мазалағаным үшін кешіріңіз
Dialogue: 0,0:03:17.19,0:03:20.32,Default,,0,0,0,,Бізбен бірге келгендеріңізге рахмет.
Dialogue: 0,0:03:20.40,0:03:22.11,Default,,0,0,0,,Сіз шаршаған болуыңыз керек, өйткені ол алыс.
Dialogue: 0,0:03:22.20,0:03:23.32,Default,,0,0,0,,Ах, жоқ.
Dialogue: 0,0:03:23.41,0:03:26.41,Default,,0,0,0,,Мен серуендеп жүргеніме көп болды, көңілді болды.
Dialogue: 0,0:03:26.49,0:03:30.16,Default,,0,0,0,,Мен Эндждің сонша жалқау болғанын бірінші рет көруім.
Dialogue: 0,0:03:30.25,0:03:33.29,Default,,0,0,0,,Сен әкеңді шынымен жақсы көресің.
Dialogue: 0,0:03:30.25,0:03:33.29,Default,,0,0,0,,Хмм...хехе
Dialogue: 0,0:03:33.37,0:03:34.50,Default,,0,0,0,,Аха…
Dialogue: 0,0:03:34.58,0:03:37.05,Default,,0,0,0,,Өйткені 5 жыл! 5 жыл болды
Dialogue: 0,0:03:37.13,0:03:40.63,Default,,0,0,0,,Жоқ, 6 жылға жуықтап қалды. Мен тамаша жұмыс жасадым!
Dialogue: 0,0:03:40.72,0:03:42.76,Default,,0,0,0,,Ахаха мен түсіндім.
Dialogue: 0,0:03:42.84,0:03:46.76,Default,,0,0,0,,Ой, жүр, сөмкелеріңді жинап ал.
Dialogue: 0,0:03:46.85,0:03:48.35,Default,,0,0,0,,Иә
Dialogue: 0,0:03:48.43,0:03:51.77,Default,,0,0,0,,Арне Милли, жүгіңді осында қалдыр.
Dialogue: 0,0:03:51.85,0:03:54.77,Default,,0,0,0,,Андж, ақыры оралдың.
Dialogue: 0,0:03:54.85,0:03:58.78,Default,,0,0,0,,Келли мырза! Кейін өзіммен бірге кәдесый ала кетейін деп ойладым.
Dialogue: 0,0:03:58.86,0:04:01.61,Default,,0,0,0,,Әй, сен қатты өстің ғой
Dialogue: 0,0:04:01.69,0:04:04.24,Default,,0,0,0,,Сен шынымен де Андж емессің бе?
Dialogue: 0,0:04:04.32,0:04:06.91,Default,,0,0,0,,Сен менен үлкенсің.
Dialogue: 0,0:04:06.99,0:04:11.00,Default,,0,0,0,,Бернс әрқашан Чамбарада маған жеңілді.
Dialogue: 0,0:04:11.08,0:04:13.75,Default,,0,0,0,,Е, ахаха, олай айтпа.
Dialogue: 0,0:04:13.83,0:04:15.25,Default,,0,0,0,,Иә, Келли.
Dialogue: 0,0:04:15.33,0:04:17.13,Default,,0,0,0,,Егер сізде қосымша көрпе болса,
Dialogue: 0,0:04:17.21,0:04:19.05,Default,,0,0,0,,Маған аздап қарыз беруіңізді сұраймын.
Dialogue: 0,0:04:19.13,0:04:20.76,Default,,0,0,0,,О, маған бәрібір.
Dialogue: 0,0:04:20.84,0:04:22.51,Default,,0,0,0,,Андж, кел алыңыз.
Dialogue: 0,0:04:22.59,0:04:24.76,Default,,0,0,0,,Иә...
Dialogue: 0,0:04:27.85,0:04:29.47,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:04:29.56,0:04:32.02,Default,,0,0,0,,Бұл жерде өсірілетін Лент жапырағы шайы.
Dialogue: 0,0:04:32.10,0:04:34.19,Default,,0,0,0,,Сәтсіздік үшін кешіріңіз.
Dialogue: 0,0:04:34.27,0:04:37.52,Default,,0,0,0,,Жоқ, жоқ, бұл кенеттен ішке кірді.
Dialogue: 0,0:04:37.61,0:04:40.90,Default,,0,0,0,,Шынымды айтсам, біздің үйден де жинақы.
Dialogue: 0,0:04:40.98,0:04:42.90,Default,,0,0,0,,Керісінше, бұл ұят.
Dialogue: 0,0:04:42.99,0:04:46.03,Default,,0,0,0,,Арне киімін шешеді.
Dialogue: 0,0:04:46.11,0:04:47.95,Default,,0,0,0,,Эй, бұл Милли!
Dialogue: 0,0:04:48.03,0:04:51.66,Default,,0,0,0,,Жоқ, мен олай жасамас едім.
Dialogue: 0,0:04:51.74,0:04:53.66,Default,,0,0,0,,-Милли сен жасырынсың! -хехе
Dialogue: 0,0:04:53.75,0:04:55.62,Default,,0,0,0,,-Аа -Ах кешіріңіз.
Dialogue: 0,0:04:55.71,0:04:57.08,Default,,0,0,0,,Көрінбейтін жерлер
Dialogue: 0,0:04:57.17,0:04:58.17,Default,,0,0,0,,Ihihi…
Dialogue: 0,0:04:58.25,0:05:02.42,Default,,0,0,0,,Екеуің Андж айтқандай жақсы доссыңдар.
Dialogue: 0,0:05:02.51,0:05:03.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:03.55,0:05:05.63,Default,,0,0,0,,Хатта жазылған.
Dialogue: 0,0:05:05.72,0:05:08.47,Default,,0,0,0,,Арне-чан салмақты қыз, ал Милли-чан...
Dialogue: 0,0:05:08.55,0:05:09.97,Default,,0,0,0,,Эххе
Dialogue: 0,0:05:10.05,0:05:12.22,Default,,0,0,0,,Бұл біраз тақырыптан тыс және қызықты.
Dialogue: 0,0:05:12.31,0:05:12.93,Default,,0,0,0,,Е, бұл дұрыс емес.
Dialogue: 0,0:05:12.93,0:05:14.39,Default,,0,0,0,,Е, бұл дұрыс емес.
Dialogue: 0,0:05:12.93,0:05:14.39,Default,,0,0,0,,Баршаңыз да сапарыңызды жалғастырғанда абай болыңыздар
Dialogue: 0,0:05:14.39,0:05:15.18,Default,,0,0,0,,Е, бұл дұрыс емес.
Dialogue: 0,0:05:15.27,0:05:17.73,Default,,0,0,0,,Тіпті Энж өте керемет.
Dialogue: 0,0:05:17.81,0:05:20.77,Default,,0,0,0,,Ахаха, бұл рас болуы мүмкін.
Dialogue: 0,0:05:20.86,0:05:24.03,Default,,0,0,0,,Екеуіңізге де Андждың досы болғаныңыз үшін рахмет.
Dialogue: 0,0:05:24.11,0:05:25.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:25.61,0:05:26.90,Default,,0,0,0,,Сол балаға да рахмет.
Dialogue: 0,0:05:26.99,0:05:30.53,Default,,0,0,0,,Менің ойымша, Орфенде өзімді жалғыз сезінудің қажеті жоқ еді.
Dialogue: 0,0:05:30.62,0:05:32.29,Default,,0,0,0,,Мен ризамын.
Dialogue: 0,0:05:32.37,0:05:33.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:33.91,0:05:35.66,Default,,0,0,0,,Жүріңдер, күн суытпай тұрып.
Dialogue: 0,0:05:35.75,0:05:38.62,Default,,0,0,0,,-Аа -Аа мен аламын.
Dialogue: 0,0:05:38.71,0:05:41.29,Default,,0,0,0,,Аа, енді ойлап қарасам, осында келе жатқанда...
Dialogue: 0,0:05:42.17,0:05:44.80,Default,,0,0,0,,Менің атым Саша Бордо.
Dialogue: 0,0:05:44.88,0:05:48.68,Default,,0,0,0,,Серен әпкемге көмектескеніңіз үшін алғысым шексіз!
Dialogue: 0,0:05:48.76,0:05:51.68,Default,,0,0,0,,Мм, Сереннің үлкен әпкесі?
Dialogue: 0,0:05:51.76,0:05:55.31,Default,,0,0,0,,Иә, мен де өткен күні әкем лорд Бергрифпен сөйлестім...
Dialogue: 0,0:05:55.39,0:05:56.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:56.85,0:06:00.19,Default,,0,0,0,,Түсіндім, сен!
Dialogue: 0,0:06:00.27,0:06:05.44,Default,,0,0,0,,Уф... Анджелина-доно, мен қандаймын...
Dialogue: 0,0:06:05.53,0:06:08.03,Default,,0,0,0,,Берілмеңіз.
Dialogue: 0,0:06:08.11,0:06:11.49,Default,,0,0,0,,Әкемді Бордоға баруға мәжбүрлесем де.
Dialogue: 0,0:06:11.57,0:06:15.50,Default,,0,0,0,,Жоқ... жоқ, бұл мен емес, менің әпкем...
Dialogue: 0,0:06:16.87,0:06:17.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:17.79,0:06:19.75,Default,,0,0,0,,Иә, бәрі осы.
Dialogue: 0,0:06:21.08,0:06:22.21,Default,,0,0,0,,Сонымен
Dialogue: 0,0:06:22.29,0:06:24.88,Default,,0,0,0,,Белгриф-дононы қиыншылыққа ұшыратқан адам болды
Dialogue: 0,0:06:24.96,0:06:28.17,Default,,0,0,0,,Оның аты Хельветика Бордо, ол да менің үлкен әпкем.
Dialogue: 0,0:06:28.26,0:06:31.93,Default,,0,0,0,,Жоқ, жоқ, менің тентекім де кешірім сұрады.
Dialogue: 0,0:06:32.01,0:06:33.81,Default,,0,0,0,,Қарашы, Андж!
Dialogue: 0,0:06:33.89,0:06:35.26,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:35.35,0:06:38.64,Default,,0,0,0,,Жоқ, түсінбеушілік жойылғанына қуаныштымын.
Dialogue: 0,0:06:38.73,0:06:40.65,Default,,0,0,0,,Бірақ Андждың әкесіне
Dialogue: 0,0:06:40.73,0:06:42.65,Default,,0,0,0,,Мен сенің қылыш қолдануды үйренетініңді білмедім.
Dialogue: 0,0:06:42.73,0:06:45.32,Default,,0,0,0,,Иә! Анджелина-дононың әкесі ретінде
Dialogue: 0,0:06:45.40,0:06:49.36,Default,,0,0,0,,Менің ұстазым Қызыл Жын Бельгриф-дононың шеберлігі керемет!
Dialogue: 0,0:06:49.45,0:06:52.66,Default,,0,0,0,,Ал сіз тактикада да жақсысыз... иә?
Dialogue: 0,0:06:53.70,0:06:57.04,Default,,0,0,0,,Сізді түсінбегенім үшін кешіріңіз.
Dialogue: 0,0:06:57.12,0:06:59.33,Default,,0,0,0,,Сіз жолдассыз!
Dialogue: 0,0:07:00.46,0:07:03.08,Default,,0,0,0,,Сіз мұны мойындай аласыз ба?
Dialogue: 0,0:07:03.17,0:07:06.92,Default,,0,0,0,,Бұл Саша Бордо өте әсерлі!
Dialogue: 0,0:07:09.01,0:07:11.80,Default,,0,0,0,,Цукаучи де, мен де шақырылдық.
Dialogue: 0,0:07:11.88,0:07:15.39,Default,,0,0,0,,АА (Қос А) дәрежелі авантюристке жаттығуға қалай батылдық танытасыз?
Dialogue: 0,0:07:15.47,0:07:17.43,Default,,0,0,0,,Мен қорқамын
Dialogue: 0,0:07:18.27,0:07:22.06,Default,,0,0,0,,Сіздің әкеңіз де авантюрист болған, солай ма?
Dialogue: 0,0:07:22.15,0:07:24.31,Default,,0,0,0,,Иә? Жақсы
Dialogue: 0,0:07:24.40,0:07:27.19,Default,,0,0,0,,Бірақ жас кезіңізде солай болады.
Dialogue: 0,0:07:27.90,0:07:31.40,Default,,0,0,0,,Мен авантюрист болғаныма 3 жылдай уақыт болды.
Dialogue: 0,0:07:31.49,0:07:33.74,Default,,0,0,0,,Дәреже де E нүктесінде тоқтайды.
Dialogue: 0,0:07:33.82,0:07:36.53,Default,,0,0,0,,Екеуміз аға буын екенбіз.
Dialogue: 0,0:07:36.62,0:07:40.58,Default,,0,0,0,,Бірақ Эндждің әкесі шынымен мейірімді, солай емес пе?
Dialogue: 0,0:07:40.66,0:07:42.25,Default,,0,0,0,,Оны қызыл жын деп атайды.
Dialogue: 0,0:07:42.33,0:07:45.54,Default,,0,0,0,,Мен сізді шынымен қорқынышты адам деп ойладым.
Dialogue: 0,0:07:45.63,0:07:46.54,Default,,0,0,0,,Ах
Dialogue: 0,0:07:46.63,0:07:50.97,Default,,0,0,0,,Мм, қызыл жын туралы кім естіді?
Dialogue: 0,0:07:51.05,0:07:53.68,Default,,0,0,0,,Не? Андж осылай деді...
Dialogue: 0,0:07:53.76,0:07:55.55,Default,,0,0,0,,- Иә? А-а
Dialogue: 0,0:07:55.64,0:08:00.52,Default,,0,0,0,,Екеуің менің рұқсатымсыз әкелеріңмен сырласпайсыңдар.
Dialogue: 0,0:08:00.60,0:08:02.06,Default,,0,0,0,,-Андж -Хм?
Dialogue: 0,0:08:02.14,0:08:04.15,Default,,0,0,0,,Не? әке
Dialogue: 0,0:08:04.23,0:08:06.31,Default,,0,0,0,,Иә, бұл...
Dialogue: 0,0:08:06.40,0:08:07.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:07.65,0:08:09.07,Default,,0,0,0,,Иә
Dialogue: 0,0:08:09.69,0:08:12.07,Default,,0,0,0,,Акаони дегеніміз не?
Dialogue: 0,0:08:12.15,0:08:14.49,Default,,0,0,0,,А, мен бұл туралы ойладым.
Dialogue: 0,0:08:14.57,0:08:17.07,Default,,0,0,0,,Әкемнің екі есімі жақсы емес пе?
Dialogue: 0,0:08:17.16,0:08:22.58,Default,,0,0,0,,Не? Әй, бәлкім оны таратып жатқан сен шығарсың?
Dialogue: 0,0:08:22.66,0:08:26.17,Default,,0,0,0,,Уф, Андж бәріне айып тағып жатыр...
Dialogue: 0,0:08:26.25,0:08:28.46,Default,,0,0,0,,Әке, сіз білмедіңіз бе?
Dialogue: 0,0:08:28.54,0:08:32.34,Default,,0,0,0,,Орфен гильдиясында енді білмейтін ешкім жоқ.
Dialogue: 0,0:08:32.92,0:08:35.18,Default,,0,0,0,,Қара шашты жауынгер қыздың әкесі
Dialogue: 0,0:08:35.26,0:08:39.85,Default,,0,0,0,,Өте күшті бұрынғы авантюрист, қызыл жын Белгриф
Dialogue: 0,0:08:39.93,0:08:42.35,Default,,0,0,0,,Бұрынғы S дәрежесі қайтып келген адамдар
Dialogue: 0,0:08:42.43,0:08:45.60,Default,,0,0,0,,Гильдия шебері де сізге көп көңіл бөледі.
Dialogue: 0,0:08:45.69,0:08:46.85,Default,,0,0,0,,Ашу...
Dialogue: 0,0:08:46.94,0:08:48.23,Default,,0,0,0,,Уау
Dialogue: 0,0:08:48.98,0:08:52.24,Default,,0,0,0,,Ах ха, мен не істеуім керек...
Dialogue: 0,0:08:52.82,0:08:56.99,Default,,0,0,0,,Не болды? Әке, мен бірдеңе істедім бе?
Dialogue: 0,0:08:57.07,0:08:59.03,Default,,0,0,0,,Жоқ
Dialogue: 0,0:08:59.12,0:09:02.75,Default,,0,0,0,,Андж сенің әкеңді ойлап жүргенін білемін.
Dialogue: 0,0:09:02.83,0:09:06.21,Default,,0,0,0,,Әке, мұның бәрі көп мақтайтын нәрсе.
Dialogue: 0,0:09:06.29,0:09:07.83,Default,,0,0,0,,Өйткені мен ештеңе істеген жоқпын
Dialogue: 0,0:09:07.92,0:09:11.09,Default,,0,0,0,,Бұл Андж айтқандай керемет емес дегенді білдіре ме?
Dialogue: 0,0:09:11.17,0:09:12.13,Default,,0,0,0,,Шаааах!
Dialogue: 0,0:09:12.13,0:09:12.96,Default,,0,0,0,,Шаааах!
Dialogue: 0,0:09:12.13,0:09:12.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:13.05,0:09:15.09,Default,,0,0,0,,Менің әкем өте күшті.
Dialogue: 0,0:09:15.17,0:09:18.59,Default,,0,0,0,,Мен айттым ғой, солай ма? Мен ешқашан қылышпен ұрған емеспін.
Dialogue: 0,0:09:18.68,0:09:21.31,Default,,0,0,0,,Жоқ, бұл бес жыл бұрын болған.
Dialogue: 0,0:09:21.39,0:09:24.48,Default,,0,0,0,,5 жыл болды ма, 10 жыл болды ма бәрібір.
Dialogue: 0,0:09:24.56,0:09:26.89,Default,,0,0,0,,Егер қанағаттанбасаңыз, мен сізге дәлелді көрсетемін.
Dialogue: 0,0:09:26.98,0:09:27.81,Default,,0,0,0,,Әке!
Dialogue: 0,0:09:27.90,0:09:29.44,Default,,0,0,0,,... иә?
Dialogue: 0,0:09:29.52,0:09:31.36,Default,,0,0,0,,Менімен қол ұстасып
Dialogue: 0,0:09:31.44,0:09:35.36,Default,,0,0,0,,Аа, жоқ, бірақ мен сапардан оралдым.
Dialogue: 0,0:09:35.44,0:09:38.11,Default,,0,0,0,,Хехе, менде бәрі жақсы.
Dialogue: 0,0:09:38.20,0:09:42.03,Default,,0,0,0,,Уау, біз сіз айтып отырған ерліктерді көреміз.
Dialogue: 0,0:09:42.12,0:09:45.12,Default,,0,0,0,,Андж да, Саша да оны жоғары бағалайды.
Dialogue: 0,0:09:46.71,0:09:48.96,Default,,0,0,0,,Менің білімімсіз
Dialogue: 0,0:09:49.04,0:09:51.63,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:10:00.05,0:10:01.26,Default,,0,0,0,,Хмм
Dialogue: 0,0:10:04.22,0:10:05.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:06.43,0:10:08.89,Default,,0,0,0,,Әке, шындап келіңіз!
Dialogue: 0,0:10:13.36,0:10:15.07,Default,,0,0,0,,S дәрежелі белсенді қарсыласқа қарсы
Dialogue: 0,0:10:15.15,0:10:17.78,Default,,0,0,0,,Оның қаншалықты жарамды екенін білмеймін, бірақ
Dialogue: 0,0:10:17.86,0:10:18.70,Default,,0,0,0,,Хмм
Dialogue: 0,0:10:23.08,0:10:24.49,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:27.08,0:10:28.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:30.58,0:10:34.59,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:10:34.67,0:10:35.50,Default,,0,0,0,,(шу)
Dialogue: 0,0:10:35.59,0:10:37.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:37.13,0:10:38.63,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:10:38.72,0:10:40.38,Default,,0,0,0,,Болады!
Dialogue: 0,0:10:42.60,0:10:44.31,Default,,0,0,0,,Түзет деп айтқан әдетім
Dialogue: 0,0:10:44.39,0:10:46.68,Default,,0,0,0,,Бұл мүлде түзетілмеген және...
Dialogue: 0,0:10:46.77,0:10:47.93,Default,,0,0,0,,-Бөксе -Не?
Dialogue: 0,0:10:48.02,0:10:48.93,Default,,0,0,0,,Ах
Dialogue: 0,0:10:49.02,0:10:51.69,Default,,0,0,0,,Әкем мені қатты ұрды!
Dialogue: 0,0:10:51.77,0:10:55.07,Default,,0,0,0,,Жоқ, сіз мұны байыппен істеуіңіз керек.
Dialogue: 0,0:10:56.07,0:10:57.07,Default,,0,0,0,,Құшақтау
Dialogue: 0,0:10:57.65,0:11:00.36,Default,,0,0,0,,Эй, мен 17-демін.
Dialogue: 0,0:11:00.45,0:11:02.57,Default,,0,0,0,,- Құшақтас! -Аа...
Dialogue: 0,0:11:03.82,0:11:05.12,Default,,0,0,0,,Ммм
Dialogue: 0,0:11:05.20,0:11:09.00,Default,,0,0,0,,Хехехе, менің әкем шынымен мықты ғой.
Dialogue: 0,0:11:09.08,0:11:10.83,Default,,0,0,0,,Жоқ, өйткені сен
Dialogue: 0,0:11:10.92,0:11:14.59,Default,,0,0,0,,Хмм, бұлай болмауы керек еді.
Dialogue: 0,0:11:14.67,0:11:17.42,Default,,0,0,0,,Мен Андждың оңай жеңілетініне сенбеймін.
Dialogue: 0,0:11:17.51,0:11:21.09,Default,,0,0,0,,Мен бұған сенбеймін, өйткені Анжер туралы айтсам...
Dialogue: 0,0:11:26.68,0:11:29.10,Default,,0,0,0,,- Дұрыс па? -Иә иә
Dialogue: 0,0:11:29.18,0:11:32.90,Default,,0,0,0,,Қалай ойлайсың, Арне, сенің әкең шынымен күшті екен, солай ма?
Dialogue: 0,0:11:32.98,0:11:35.65,Default,,0,0,0,,Иә, мен шынымен таң қалдым.
Dialogue: 0,0:11:35.73,0:11:39.15,Default,,0,0,0,,Уфуфу, менің әкем менің әкем ғой.
Dialogue: 0,0:11:39.24,0:11:40.90,Default,,0,0,0,,-Акаони күткендей -Ух
Dialogue: 0,0:11:40.99,0:11:43.03,Default,,0,0,0,,Ах... Андж
Dialogue: 0,0:11:43.11,0:11:44.66,Default,,0,0,0,,Не? әке
Dialogue: 0,0:11:44.74,0:11:48.74,Default,,0,0,0,,Сенің әкеңді жақсы көретініңе қуаныштымын.
Dialogue: 0,0:11:48.83,0:11:51.71,Default,,0,0,0,,Адамдарға қол тигізбеуге болады ма?
Dialogue: 0,0:11:51.79,0:11:55.00,Default,,0,0,0,,Иә, бірақ сенің әкең шын мәнінде күшті.
Dialogue: 0,0:11:55.08,0:11:56.59,Default,,0,0,0,,Менен күшті
Dialogue: 0,0:11:56.67,0:11:58.46,Default,,0,0,0,,Мен бәрібір сізден сұраймын.
Dialogue: 0,0:11:58.55,0:12:01.38,Default,,0,0,0,,Олай істесең де әкең риза болмайды.
Dialogue: 0,0:12:01.47,0:12:02.55,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:02.63,0:12:03.72,Default,,0,0,0,,Бұрын… пышақ еді.
Dialogue: 0,0:12:03.80,0:12:07.01,Default,,0,0,0,,Талантты сұңқар тырнағын жасырады.
Dialogue: 0,0:12:07.10,0:12:09.64,Default,,0,0,0,,Жарайды, мен оны құпия түрде сақтаймын.
Dialogue: 0,0:12:09.72,0:12:14.73,Default,,0,0,0,,Хмм, белгісіз шебер, бұл да тамаша.
Dialogue: 0,0:12:14.81,0:12:17.19,Default,,0,0,0,,Е... хаха...
Dialogue: 0,0:12:20.86,0:12:22.65,Default,,0,0,0,,Торнеллада монша жоқ.
Dialogue: 0,0:12:22.74,0:12:25.91,Default,,0,0,0,,Сондықтан денеңізді ыстық суға малынған шүберекпен сүртіңіз.
Dialogue: 0,0:12:25.99,0:12:29.20,Default,,0,0,0,,Бұл... Мен мұның бәрін алып тастауым керек сияқты.
Dialogue: 0,0:12:29.29,0:12:31.08,Default,,0,0,0,,Уф~ Жақсы сезіледі~
Dialogue: 0,0:12:31.08,0:12:31.91,Default,,0,0,0,,Уф~ Жақсы сезіледі~
Dialogue: 0,0:12:31.08,0:12:31.91,Default,,0,0,0,,Ах
Dialogue: 0,0:12:32.00,0:12:34.92,Default,,0,0,0,,Ухуху дөңес
Dialogue: 0,0:12:35.00,0:12:39.38,Default,,0,0,0,,Қыз болсаң да, Оңай жалаңаш қалар едің...
Dialogue: 0,0:12:39.46,0:12:41.01,Default,,0,0,0,,Жарайды, киіміңді де шеш, Арне.
Dialogue: 0,0:12:41.09,0:12:41.92,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:12:42.01,0:12:44.09,Default,,0,0,0,,«Кя!» Ахах...
Dialogue: 0,0:12:44.18,0:12:45.51,Default,,0,0,0,,Арнетара Мэйден
Dialogue: 0,0:12:45.59,0:12:47.18,Default,,0,0,0,,Шулы ақымақтар!
Dialogue: 0,0:12:48.26,0:12:52.43,Default,,0,0,0,,Неге мен мүлде ет ала алмаймын...
Dialogue: 0,0:12:52.52,0:12:56.23,Default,,0,0,0,,Мен өзімді жұқа емес, сергек сезінемін.
Dialogue: 0,0:12:56.31,0:12:59.94,Default,,0,0,0,,Дұрыс, дұрыс, сымбатты, мен қызғанамын.
Dialogue: 0,0:13:00.02,0:13:02.94,Default,,0,0,0,,Уф, сен мені жек көресің бе? Конняро~
Dialogue: 0,0:13:03.03,0:13:04.36,Default,,0,0,0,,Сүт безі!
Dialogue: 0,0:13:04.45,0:13:05.95,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:13:08.03,0:13:10.08,Default,,0,0,0,,Фью~ Сергіту~
Dialogue: 0,0:13:10.16,0:13:12.95,Default,,0,0,0,,Иә, мұндай нәрсе де жаман емес.
Dialogue: 0,0:13:13.04,0:13:14.50,Default,,0,0,0,,Жақсы
Dialogue: 0,0:13:14.58,0:13:17.83,Default,,0,0,0,,Мен де өзімді Торнеллаға оралғандай сезінемін.
Dialogue: 0,0:13:17.92,0:13:18.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:20.84,0:13:22.00,Default,,0,0,0,,Иә
Dialogue: 0,0:13:30.55,0:13:31.39,Default,,0,0,0,,Ах
Dialogue: 0,0:13:32.52,0:13:33.89,Default,,0,0,0,,Әлі бітірдіңіз бе?
Dialogue: 0,0:13:36.27,0:13:37.77,Default,,0,0,0,,Қош келдіңіз әке
Dialogue: 0,0:13:37.85,0:13:39.40,Default,,0,0,0,,Ах, мен оралдым.
Dialogue: 0,0:13:40.06,0:13:42.11,Default,,0,0,0,,Жүр, кешкі ас ішейік.
Dialogue: 0,0:13:46.20,0:13:47.95,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:13:46.20,0:13:47.95,Default,,0,0,0,,Менің ойымша, бұл Орфеннің тамағы сияқты жақсы емес.
Dialogue: 0,0:13:47.95,0:13:48.91,Default,,0,0,0,,Менің ойымша, бұл Орфеннің тамағы сияқты жақсы емес.
Dialogue: 0,0:13:48.99,0:13:50.37,Default,,0,0,0,,Көп тамақтаныңыз
Dialogue: 0,0:13:50.45,0:13:52.99,Default,,0,0,0,,5 жылдан кейін менің үйімде бірінші түскі ас!
Dialogue: 0,0:13:53.08,0:13:55.37,Default,,0,0,0,,Бұл мереке! Мен сондай қуаныштымын!
Dialogue: 0,0:13:55.45,0:13:58.67,Default,,0,0,0,,Уфуфу Курё жемісінің иісі
Dialogue: 0,0:13:58.75,0:14:02.17,Default,,0,0,0,,Бұл әкеге ұнайды, маған да ұнайды.
Dialogue: 0,0:14:02.25,0:14:05.13,Default,,0,0,0,,Мүмкін Орфенде онша көп жоқ.
Dialogue: 0,0:14:05.21,0:14:06.88,Default,,0,0,0,,Бұл дәмді болады деп үміттенемін.
Dialogue: 0,0:14:06.97,0:14:10.55,Default,,0,0,0,,Иә, бұл сәл оғаш, бірақ дәмді.
Dialogue: 0,0:14:10.64,0:14:11.85,Default,,0,0,0,,Маған ұнайды.
Dialogue: 0,0:14:11.93,0:14:13.72,Default,,0,0,0,,Маған да ұнайды~
Dialogue: 0,0:14:13.81,0:14:16.06,Default,,0,0,0,,А, бұл жақсы.
Dialogue: 0,0:14:16.14,0:14:17.64,Default,,0,0,0,,Мен сізді соңғы рет көргеніме біраз уақыт болды.
Dialogue: 0,0:14:17.73,0:14:20.27,Default,,0,0,0,,Иә? Андж бұл не?
Dialogue: 0,0:14:20.35,0:14:23.15,Default,,0,0,0,,Бұл аққұйрықты құс. Бұл дәмді.
Dialogue: 0,0:14:23.23,0:14:26.65,Default,,0,0,0,,Тамшылап кетпес үшін оны қолыңызбен ұстаңыз.
Dialogue: 0,0:14:26.74,0:14:28.65,Default,,0,0,0,,Аузыңызды тәрелкеге сәл жақындатыңыз
Dialogue: 0,0:14:29.99,0:14:32.16,Default,,0,0,0,,Хмм, дәмді!
Dialogue: 0,0:14:32.24,0:14:36.41,Default,,0,0,0,,Хух~ Ауызыңды осылай ашасың...
Dialogue: 0,0:14:36.50,0:14:38.66,Default,,0,0,0,,Ах, Милли, менің қалпағымда май бар.
Dialogue: 0,0:14:38.75,0:14:42.17,Default,,0,0,0,,Иә, мен мұны істедім.
Dialogue: 0,0:14:42.25,0:14:45.92,Default,,0,0,0,,Милли-чан, дәл осылай жеу қиын болуы мүмкін.
Dialogue: 0,0:14:46.01,0:14:47.92,Default,,0,0,0,,Неге бас киіміңді шешпейсің?
Dialogue: 0,0:14:48.01,0:14:51.68,Default,,0,0,0,,А, м...
Dialogue: 0,0:14:51.76,0:14:53.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:54.72,0:14:55.56,Default,,0,0,0,,Милли
Dialogue: 0,0:14:55.64,0:14:58.06,Default,,0,0,0,,Менің әкем ондай адам емес.
Dialogue: 0,0:14:59.02,0:15:01.98,Default,,0,0,0,,Мен білемін... бірақ...
Dialogue: 0,0:15:03.06,0:15:04.36,Default,,0,0,0,,Ей, мынада бір аңшы бар.
Dialogue: 0,0:15:04.44,0:15:05.61,Default,,0,0,0,,Нағыз құлақ?
Dialogue: 0,0:15:05.69,0:15:08.07,Default,,0,0,0,,Шоу үйінде қымбатқа сатылмайды ма?
Dialogue: 0,0:15:08.15,0:15:10.11,Default,,0,0,0,,О, көрдің бе? сол баланың құлағы
Dialogue: 0,0:15:10.20,0:15:11.66,Default,,0,0,0,,Бейшара жігіт
Dialogue: 0,0:15:11.74,0:15:14.41,Default,,0,0,0,,Мен сіздердің қиын кезеңдерді бастан өткергеніңізге сенімдімін.
Dialogue: 0,0:15:15.66,0:15:19.00,Default,,0,0,0,,Кешіріңіз, терең мағынасы жоқ.
Dialogue: 0,0:15:19.08,0:15:21.58,Default,,0,0,0,,Әрине, егер қаламасаңыз, оны алудың қажеті жоқ.
Dialogue: 0,0:15:22.42,0:15:23.58,Default,,0,0,0,,Ах
Dialogue: 0,0:15:23.67,0:15:25.34,Default,,0,0,0,,Иә
Dialogue: 0,0:15:26.84,0:15:28.01,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:31.18,0:15:32.34,Default,,0,0,0,,Ах
Dialogue: 0,0:15:36.72,0:15:39.60,Default,,0,0,0,,Мен көремін. Солай ма?
Dialogue: 0,0:15:39.68,0:15:41.10,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:41.19,0:15:42.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:42.56,0:15:43.90,Default,,0,0,0,,Иә
Dialogue: 0,0:15:43.98,0:15:45.40,Default,,0,0,0,,Құлағыңыз суық болды емес пе?
Dialogue: 0,0:15:45.48,0:15:46.86,Default,,0,0,0,,О, не?
Dialogue: 0,0:15:46.94,0:15:51.07,Default,,0,0,0,,Иә, Орфенге қарағанда Торнелладағы түндер суық.
Dialogue: 0,0:15:51.15,0:15:52.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:52.20,0:15:55.49,Default,,0,0,0,,Аа, дұрыс, жүннен тоқылған қалпақ болуы керек еді.
Dialogue: 0,0:15:55.57,0:15:59.75,Default,,0,0,0,,Сонда түкірік жолға түспейді, құлағың жылы болады.
Dialogue: 0,0:15:59.83,0:16:01.62,Default,,0,0,0,,Мен оның осы жерде екеніне сенімдімін...
Dialogue: 0,0:16:01.71,0:16:04.63,Default,,0,0,0,,А, менің құлағым суық, а?
Dialogue: 0,0:16:05.42,0:16:06.38,Default,,0,0,0,,Эй?
Dialogue: 0,0:16:06.46,0:16:07.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:07.96,0:16:09.88,Default,,0,0,0,,Уууу, дұрыс.
Dialogue: 0,0:16:09.96,0:16:13.13,Default,,0,0,0,,Андждың әкесі - Андждың әкесі, солай ма?
Dialogue: 0,0:16:13.22,0:16:14.39,Default,,0,0,0,,Аха ахах...
Dialogue: 0,0:16:14.47,0:16:16.26,Default,,0,0,0,,Бұл болды.
Dialogue: 0,0:16:16.35,0:16:18.06,Default,,0,0,0,,А? Не болды?
Dialogue: 0,0:16:18.14,0:16:21.27,Default,,0,0,0,,Хехе, бұл ештеңе емес.
Dialogue: 0,0:16:21.35,0:16:23.77,Default,,0,0,0,,А-а-а...
Dialogue: 0,0:16:23.85,0:16:25.77,Default,,0,0,0,,-Аа -Хмм?
Dialogue: 0,0:16:26.36,0:16:30.11,Default,,0,0,0,,Басымды сипап жібере аласыз ба?
Dialogue: 0,0:16:30.19,0:16:31.32,Default,,0,0,0,,На
Dialogue: 0,0:16:30.19,0:16:31.32,Default,,0,0,0,,Не? А, жарайды, бірақ
Dialogue: 0,0:16:31.32,0:16:32.78,Default,,0,0,0,,Не? А, жарайды, бірақ
Dialogue: 0,0:16:35.11,0:16:38.03,Default,,0,0,0,,Уау! бұл!
Dialogue: 0,0:16:38.78,0:16:40.04,Default,,0,0,0,,Бұл жақсы болды ма?
Dialogue: 0,0:16:40.12,0:16:43.00,Default,,0,0,0,,Қылышымды қатты тартып, саңылауды пайдаланып соғамын
Dialogue: 0,0:16:43.08,0:16:45.96,Default,,0,0,0,,Хмф, бұл сенің әкең бе?
Dialogue: 0,0:16:46.04,0:16:48.21,Default,,0,0,0,,Не? әке?
Dialogue: 0,0:16:48.29,0:16:51.05,Default,,0,0,0,,Хаха, мына жігіт біртүрлі екен.
Dialogue: 0,0:16:51.13,0:16:54.26,Default,,0,0,0,,Хехе, қызғаншақсың ғой?
Dialogue: 0,0:16:54.34,0:16:56.30,Default,,0,0,0,,Себебі мен білемін.
Dialogue: 0,0:16:56.39,0:16:58.60,Default,,0,0,0,,Начи… Жоқ…
Dialogue: 0,0:16:58.68,0:17:01.81,Default,,0,0,0,,Сенің менің иығыма мінгеніңді қаламаймын.
Dialogue: 0,0:17:02.93,0:17:05.31,Default,,0,0,0,,-Хн, сендер балалар -Хх
Dialogue: 0,0:17:05.39,0:17:07.73,Default,,0,0,0,,Әкем мені иығына көтеріп алғанын қалаймын.
Dialogue: 0,0:17:07.81,0:17:10.11,Default,,0,0,0,,Алдымен мені жең!
Dialogue: 0,0:17:10.11,0:17:10.94,Default,,0,0,0,,Алдымен мені жең!
Dialogue: 0,0:17:10.11,0:17:10.94,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:11.02,0:17:13.44,Default,,0,0,0,,Ә? Ә?!
Dialogue: 0,0:17:11.02,0:17:13.44,Default,,0,0,0,,Сондықтан ол басқаша...
Dialogue: 0,0:17:13.53,0:17:16.45,Default,,0,0,0,,(Анджелина мен оның достарының дауысы)
Dialogue: 0,0:17:16.53,0:17:19.07,Default,,0,0,0,,(қылыштың соқтығысқан дыбысы)
Dialogue: 0,0:17:24.91,0:17:26.12,Default,,0,0,0,,Болады!
Dialogue: 0,0:17:26.21,0:17:28.38,Default,,0,0,0,,Қозғалмас бұрын қарамаңыз
Dialogue: 0,0:17:26.21,0:17:28.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:28.46,0:17:30.34,Default,,0,0,0,,Түсінгенше мен неше рет айтуым керек?
Dialogue: 0,0:17:30.42,0:17:33.05,Default,,0,0,0,,Мен мұны қазір жасай алатыныңызға сенімдімін.
Dialogue: 0,0:17:33.13,0:17:35.92,Default,,0,0,0,,Әкемнен басқа ешкім қашқан жоқ.
Dialogue: 0,0:17:36.01,0:17:39.22,Default,,0,0,0,,Бұл енді қайталанбайды деп нақты айта аламыз ба?
Dialogue: 0,0:17:39.30,0:17:42.06,Default,,0,0,0,,Сылтау айтсаң да, құбыжықтар күтпейді.
Dialogue: 0,0:17:42.14,0:17:43.35,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:17:43.43,0:17:46.31,Default,,0,0,0,,Бұл емес. Тәкаппар болма.
Dialogue: 0,0:17:46.39,0:17:47.77,Default,,0,0,0,,Тыңда, Андж.
Dialogue: 0,0:17:48.27,0:17:52.19,Default,,0,0,0,,Егер сіз осындай жаттығудан жеңіліп жатқандай көрінсеңіз, әкеңіз уайымдап жатыр.
Dialogue: 0,0:17:52.27,0:17:56.32,Default,,0,0,0,,Сіз жоғары дәрежелі жын аңдарымен және жын қожайындарымен жұмыс жасайсыз.
Dialogue: 0,0:17:56.40,0:17:59.95,Default,,0,0,0,,Хехехехе, жын патша менің әкемдей күшті емес еді.
Dialogue: 0,0:18:00.03,0:18:03.33,Default,,0,0,0,,Эй, эй, бұл шындық болуы мүмкін емес.
Dialogue: 0,0:18:03.41,0:18:06.83,Default,,0,0,0,,А, енді ойлап қарасам, жын патша қандай құбыжық еді?
Dialogue: 0,0:18:07.50,0:18:11.34,Default,,0,0,0,,Міне, қара көлеңке шебері қозғалып бара жатқан сияқты.
Dialogue: 0,0:18:11.42,0:18:12.75,Default,,0,0,0,,Көлеңке шебері?
Dialogue: 0,0:18:18.05,0:18:18.88,Default,,0,0,0,,Ол неге ұқсайды?
Dialogue: 0,0:18:18.97,0:18:23.39,Default,,0,0,0,,Бұл гуманоид, бірақ кішкентай және бала тәрізді болды.
Dialogue: 0,0:18:27.60,0:18:29.90,Default,,0,0,0,,Бұл басқа нәрсе болуы керек...
Dialogue: 0,0:18:29.98,0:18:33.11,Default,,0,0,0,,Егер бұл жын патша болса, біз қазір...
Dialogue: 0,0:18:33.19,0:18:34.40,Default,,0,0,0,,- Әке? -Ах
Dialogue: 0,0:18:35.23,0:18:36.40,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:36.49,0:18:38.03,Default,,0,0,0,,А, жоқ, ештеңе.
Dialogue: 0,0:18:38.11,0:18:40.41,Default,,0,0,0,,-Екеуің! -(2 адам) Ах.
Dialogue: 0,0:18:40.49,0:18:43.16,Default,,0,0,0,,Жақында түскі ас алғыңыз келе ме?
Dialogue: 0,0:18:43.24,0:18:47.50,Default,,0,0,0,,Фуфу иә күріш күріш
Dialogue: 0,0:18:47.58,0:18:48.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:49.21,0:18:51.25,Default,,0,0,0,,Көлеңкенің шебері жын патшасы…
Dialogue: 0,0:18:51.33,0:18:53.71,Default,,0,0,0,,Ол S дәрежелі болғанша, Андж мұны жалғастыра береді.
Dialogue: 0,0:18:53.79,0:18:57.42,Default,,0,0,0,,Мен бұған қарсы күресуді жалғастыруым керек ...
Dialogue: 0,0:18:58.42,0:19:00.51,Default,,0,0,0,,Бұл сіздің оң аяғыңыз болса, жақсы.
Dialogue: 0,0:19:00.59,0:19:03.93,Default,,0,0,0,,Бірақ өміріңді жоғалтсаң, бітті.
Dialogue: 0,0:19:06.81,0:19:09.18,Default,,0,0,0,,-Андж! -Ой не?
Dialogue: 0,0:19:09.98,0:19:13.69,Default,,0,0,0,,Сіз авантюрист болуды жоспарлайсыз ба?
Dialogue: 0,0:19:13.77,0:19:16.48,Default,,0,0,0,,Иә, өйткені бұл қызық.
Dialogue: 0,0:19:16.57,0:19:18.94,Default,,0,0,0,,Бұл маған ең қолайлы екеніне сенімдімін.
Dialogue: 0,0:19:21.36,0:19:22.20,Default,,0,0,0,,Хмм
Dialogue: 0,0:19:23.53,0:19:25.62,Default,,0,0,0,,А, әке?
Dialogue: 0,0:19:26.37,0:19:29.00,Default,,0,0,0,,Егер сіз авантюрист болғыңыз келсе
Dialogue: 0,0:19:29.08,0:19:31.00,Default,,0,0,0,,Әкеңді басқалардың көзінше жең.
Dialogue: 0,0:19:31.08,0:19:33.25,Default,,0,0,0,,Ха, ха, ха!
Dialogue: 0,0:19:33.92,0:19:35.67,Default,,0,0,0,,Жартылай шешіммен, шеберлікпен
Dialogue: 0,0:19:35.75,0:19:38.80,Default,,0,0,0,,Мен авантюристтердің жалғастыруына жол бере алмаймын.
Dialogue: 0,0:19:38.88,0:19:43.01,Default,,0,0,0,,Егер сіз әкеңізді жеңе алмасаңыз да, авантюрист болуды шешсеңіз.
Dialogue: 0,0:19:43.89,0:19:46.31,Default,,0,0,0,,Мен сені енді қызым деп ойламаймын!
Dialogue: 0,0:19:46.97,0:19:48.18,Default,,0,0,0,,-А-а?
Dialogue: 0,0:19:50.60,0:19:51.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:55.40,0:19:59.69,Default,,0,0,0,,Әке, бұл өтірік, солай ма?
Dialogue: 0,0:19:59.78,0:20:01.74,Default,,0,0,0,,Фу…
Dialogue: 0,0:20:01.82,0:20:03.16,Default,,0,0,0,,Дайын бол!
Dialogue: 0,0:20:03.78,0:20:05.20,Default,,0,0,0,,-Жоқ -О
Dialogue: 0,0:20:05.28,0:20:08.95,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ! Мен мұны істей алмаймын!
Dialogue: 0,0:20:09.04,0:20:11.41,Default,,0,0,0,,Құбыжық ұнатпайтынын айтып, тыңдайсың ба?
Dialogue: 0,0:20:11.50,0:20:13.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:13.08,0:20:14.37,Default,,0,0,0,,Дайын бол!
Dialogue: 0,0:20:15.13,0:20:18.67,Default,,0,0,0,,Уф... Маған бұл ұнамайды.
Dialogue: 0,0:20:19.46,0:20:22.38,Default,,0,0,0,,Сенің әкең бұлай айтуы мүмкін емес.
Dialogue: 0,0:20:22.47,0:20:24.05,Default,,0,0,0,,-Кеттік! -Ха!
Dialogue: 0,0:20:24.13,0:20:25.80,Default,,0,0,0,,-Ах! -Уф
Dialogue: 0,0:20:25.89,0:20:27.55,Default,,0,0,0,,Гууууууу...
Dialogue: 0,0:20:27.64,0:20:30.35,Default,,0,0,0,,Неліктен? Неліктен не?
Dialogue: 0,0:20:30.43,0:20:33.31,Default,,0,0,0,,Әкеңді ашуландырғаным үшін бе?
Dialogue: 0,0:20:33.39,0:20:38.19,Default,,0,0,0,,Жоқ, әкем ашулы емес.
Dialogue: 0,0:20:38.27,0:20:41.57,Default,,0,0,0,,Мен қайғылымын, өйткені мен аяныштымын
Dialogue: 0,0:20:47.99,0:20:48.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:51.41,0:20:52.70,Default,,0,0,0,,Әй!
Dialogue: 0,0:20:54.29,0:20:55.96,Default,,0,0,0,,Мен жеңілдім!
Dialogue: 0,0:20:56.04,0:20:56.96,Default,,0,0,0,,Фу…
Dialogue: 0,0:20:57.04,0:20:58.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:58.67,0:21:00.21,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:21:01.21,0:21:06.76,Default,,0,0,0,,Андж, сен керемет жұмыс жасадың. Әкеңнің қызынан күткендей.
Dialogue: 0,0:21:06.84,0:21:08.97,Default,,0,0,0,,- Кешірім сұрау - Не?
Dialogue: 0,0:21:09.05,0:21:11.47,Default,,0,0,0,,Қорқынышты бірдеңе айтқаныңыз үшін кешірім сұраңыз!
Dialogue: 0,0:21:11.56,0:21:14.02,Default,,0,0,0,,Менің қызым деп ойламаймын деп айтпа!
Dialogue: 0,0:21:14.10,0:21:15.89,Default,,0,0,0,,Мүлдем жоқ!
Dialogue: 0,0:21:15.98,0:21:19.82,Default,,0,0,0,,Қандай жағдай болмасын, мен әкемнің қызы болып қаламын!
Dialogue: 0,0:21:19.90,0:21:22.78,Default,,0,0,0,,Е... жаман болды, жаман болды
Dialogue: 0,0:21:22.86,0:21:25.07,Default,,0,0,0,,Мен сенің байыпты болғаныңды қалаймын.
Dialogue: 0,0:21:25.15,0:21:26.99,Default,,0,0,0,,Маған ұнамайды, рұқсат бермеймін!
Dialogue: 0,0:21:27.07,0:21:30.28,Default,,0,0,0,,Сені кешіргенімді қаласаң, мені құшақтап, қыс!
Dialogue: 0,0:21:30.37,0:21:33.29,Default,,0,0,0,,Ахаха мен түсіндім.
Dialogue: 0,0:21:33.87,0:21:36.71,Default,,0,0,0,,Жақсы, біраз уақыт не болады деп ойлаймын
Dialogue: 0,0:21:36.79,0:21:40.54,Default,,0,0,0,,Ей, бұл екеуі өте жақсы араласатын сияқты.
Dialogue: 0,0:21:40.63,0:21:42.30,Default,,0,0,0,,Жоқ, бірақ
Dialogue: 0,0:21:43.67,0:21:45.80,Default,,0,0,0,,Бұл қызыл жын еді ғой.
Dialogue: 0,0:21:45.88,0:21:47.05,Default,,0,0,0,,Хаха…
Dialogue: 0,0:21:47.13,0:21:48.30,Default,,0,0,0,,Иә
Dialogue: 0,0:21:48.39,0:21:51.30,Default,,0,0,0,,(Анжелинаның айқайы)
Dialogue: 0,0:21:52.35,0:21:54.81,Default,,0,0,0,,Мен бұлай қозғаламын деп ешқашан ойламадым.
Dialogue: 0,0:21:54.89,0:21:59.81,Default,,0,0,0,,Сен ақымақсың. Мен дұрыс өстім, солай емес пе?
Dialogue: 0,0:22:00.86,0:22:02.69,Default,,0,0,0,,Әкем…
Dialogue: 0,0:22:02.77,0:22:05.32,Default,,0,0,0,,(Анджелинаның айқайы)
Dialogue: 0,0:22:05.94,0:22:10.95,Default,,0,0,0,,♪～
Dialogue: 0,0:23:30.90,0:23:35.91,Default,,0,0,0,,～♪
Dialogue: 0,0:23:37.41,0:23:43.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory