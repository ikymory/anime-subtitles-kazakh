Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.29,0:00:05.38,Default,,0,0,0,,Хаа~ Балалар, әрекетке кірісіңдер.
Dialogue: 0,0:00:06.46,0:00:08.96,Default,,0,0,0,,Соңында бүгін В командасының ресми ойыны.
Dialogue: 0,0:00:09.30,0:00:10.88,Default,,0,0,0,,Бұл Токио лигасының ашылу ойыны.
Dialogue: 0,0:00:11.21,0:00:12.88,Default,,0,0,0,,Өтінемін, мүлде.
Dialogue: 0,0:00:13.34,0:00:16.18,Default,,0,0,0,,Өткен аптадағы жаттығу атмосферасы қорқынышты болды.
Dialogue: 0,0:00:16.72,0:00:19.81,Default,,0,0,0,,Шынымды айтсам, бүгінгі қарсылас онша мықты емес.
Dialogue: 0,0:00:20.64,0:00:23.77,Default,,0,0,0,,Бірақ бұл күйде мен жұлдыздарды жіберіп аламын.
Dialogue: 0,0:00:24.31,0:00:25.31,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:00:28.02,0:00:34.03,Default,,0,0,0,,♪～
Dialogue: 0,0:01:51.94,0:01:57.95,Default,,0,0,0,,～♪
Dialogue: 0,0:01:59.66,0:02:00.95,Default,,0,0,0,,Сол бір оқиғадан⸺
Dialogue: 0,0:02:01.07,0:02:02.95,Default,,0,0,0,,Төртеуміз асығамыз⸺
Dialogue: 0,0:02:03.08,0:02:05.33,Default,,0,0,0,,Сыныптастарымның кезінде тарады.
Dialogue: 0,0:02:05.87,0:02:07.71,Default,,0,0,0,,Әсіресе Асари, Асари
Dialogue: 0,0:02:08.12,0:02:10.88,Default,,0,0,0,,Сол бейбақ Ашито негізгі құрам ретінде таңдалды⸺
Dialogue: 0,0:02:10.96,0:02:12.29,Default,,0,0,0,,Шағымдар бар.
Dialogue: 0,0:02:12.79,0:02:14.46,Default,,0,0,0,,Сіз өткендіктен...
Dialogue: 0,0:02:15.46,0:02:16.67,Default,,0,0,0,,(Цезарь) Оны «Лиза Лиза» деп атайды.
Dialogue: 0,0:02:17.17,0:02:19.43,Default,,0,0,0,,Оның айтқанын кешіре алмаймын.
Dialogue: 0,0:02:20.01,0:02:21.22,Default,,0,0,0,,Мен үшін де солай
Dialogue: 0,0:02:21.89,0:02:25.35,Default,,0,0,0,,Бірақ сіз бұл жағдайда футбол ойнай аласыз ба?
Dialogue: 0,0:02:26.60,0:02:28.27,Default,,0,0,0,,Неліктен Курода мен Асари?
Dialogue: 0,0:02:28.56,0:02:30.85,Default,,0,0,0,,Мен саған ашуымды шығардым ба?
Dialogue: 0,0:02:31.77,0:02:33.31,Default,,0,0,0,,Жауабын табыңыз
Dialogue: 0,0:02:34.23,0:02:36.36,Default,,0,0,0,,Өшіре алмасаңыз⸺
Dialogue: 0,0:02:37.15,0:02:40.45,Default,,0,0,0,,Мен сізді келесі үш айда ешбір матчта қолданбаймын.
Dialogue: 0,0:02:41.82,0:02:44.41,Default,,0,0,0,,Расында ештеңе шешпейді
Dialogue: 0,0:02:45.37,0:02:48.29,Default,,0,0,0,,Бірақ қазір істеуден басқа амалым жоқ.
Dialogue: 0,0:02:48.71,0:02:50.12,Default,,0,0,0,,Сонымен~
Dialogue: 0,0:02:50.50,0:02:52.17,Default,,0,0,0,,Иә? (Фукуда) Сіз үйге бара жатқаныңызды айттыңыз.
Dialogue: 0,0:02:52.96,0:02:55.71,Default,,0,0,0,,Қашан? Егер сізде бос уақыт болса.
Dialogue: 0,0:02:55.80,0:02:58.30,Default,,0,0,0,,Сіз өте тітіркендіргішсіз ...
Dialogue: 0,0:02:58.42,0:02:59.84,Default,,0,0,0,,Анашым, сіз солай ма?
Dialogue: 0,0:02:59.92,0:03:01.26,Default,,0,0,0,,Ағай... аа... (Фукуда) А?
Dialogue: 0,0:03:01.34,0:03:02.43,Default,,0,0,0,,Директор Фукуда
Dialogue: 0,0:03:02.93,0:03:04.51,Default,,0,0,0,,Әй, бұл не, Ашито?
Dialogue: 0,0:03:04.93,0:03:06.72,Default,,0,0,0,,Бұл гүл ме?
Dialogue: 0,0:03:07.31,0:03:08.81,Default,,0,0,0,,Иә, гүл
Dialogue: 0,0:03:09.98,0:03:12.90,Default,,0,0,0,,Не? Сіз Ханамен қарым-қатынасыңызға ризасыз ба?
Dialogue: 0,0:03:13.98,0:03:16.02,Default,,0,0,0,,Ресиверді маған қарай бұра аласыз ба?
Dialogue: 0,0:03:16.32,0:03:17.61,Default,,0,0,0,,Телефон тұтқасы…
Dialogue: 0,0:03:19.07,0:03:20.03,Default,,0,0,0,,Мынау... осылай ма?
Dialogue: 0,0:03:20.36,0:03:23.57,Default,,0,0,0,,Әй, сен мәзір бойынша тамақтанып жатырсың.
Dialogue: 0,0:03:25.07,0:03:27.62,Default,,0,0,0,,Ойын басталғалы жатыр!
Dialogue: 0,0:03:27.70,0:03:30.25,Default,,0,0,0,,Кенеттен басталатын құрам! Матчтың ресми дебюті!
Dialogue: 0,0:03:30.37,0:03:33.04,Default,,0,0,0,,Күтілгендей, Ференц Пушкаштың реинкарнациясы
Dialogue: 0,0:03:33.12,0:03:36.67,Default,,0,0,0,,Ыдыс басқа екен Ахаха~! (Фукуда) А...
Dialogue: 0,0:03:37.63,0:03:40.05,Default,,0,0,0,,Сіз бізге келіп қолдау көрсете аласыз.
Dialogue: 0,0:03:40.63,0:03:41.51,Default,,0,0,0,,Міне!
Dialogue: 0,0:03:44.76,0:03:47.76,Default,,0,0,0,,Е...
Dialogue: 0,0:03:48.56,0:03:49.47,Default,,0,0,0,,Ашито
Dialogue: 0,0:03:50.85,0:03:53.10,Default,,0,0,0,,Сіз қалай ойлайсыз? Бүгін жеңемін деп ойлайсыз ба?
Dialogue: 0,0:03:55.65,0:03:58.40,Default,,0,0,0,,Осыншама көп ойлануға тура келетін ойынды бірінші рет ойнадым.
Dialogue: 0,0:03:59.44,0:04:00.49,Default,,0,0,0,,Бірақ жеңіңіз
Dialogue: 0,0:04:00.99,0:04:01.99,Default,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,0:04:03.82,0:04:05.11,Default,,0,0,0,,Мен ұпай жинаймын
Dialogue: 0,0:04:06.41,0:04:09.08,Default,,0,0,0,,Сізге бір анық нәрсені айтайын.
Dialogue: 0,0:04:10.45,0:04:12.58,Default,,0,0,0,,Жалғыз футболда ештеңе істей алмайсың.
Dialogue: 0,0:04:13.41,0:04:14.87,Default,,0,0,0,,Сіз ойлағаннан да көп
Dialogue: 0,0:04:15.29,0:04:16.13,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:17.00,0:04:18.13,Default,,0,0,0,,Сондықтан⸺
Dialogue: 0,0:04:19.17,0:04:20.59,Default,,0,0,0,,Өте қызық
Dialogue: 0,0:04:24.26,0:04:28.18,Default,,0,0,0,,Ах~ Эсперион жастары Б...
Dialogue: 0,0:04:28.72,0:04:30.06,Default,,0,0,0,,В...
Dialogue: 0,0:04:30.60,0:04:32.31,Default,,0,0,0,,Е~ 2-ші армия!?
Dialogue: 0,0:04:32.39,0:04:34.39,Default,,0,0,0,,Ах~ Не істеуім керек!
Dialogue: 0,0:04:34.64,0:04:38.15,Default,,0,0,0,,Маған Жапонияның болашақ өкілін суретке түсіру керектігін айтты.
Dialogue: 0,0:04:38.27,0:04:40.27,Default,,0,0,0,,Секия-сан маған ұрысады...
Dialogue: 0,0:04:40.44,0:04:42.65,Default,,0,0,0,,Бар, жүр, Сейкё! Біздің...
Dialogue: 0,0:04:42.94,0:04:45.57,Default,,0,0,0,,А... Мен басқа мектепке келдім.
Dialogue: 0,0:04:46.07,0:04:48.28,Default,,0,0,0,,Жарқыраған көңілді орта мектепке қарсы⸺
Dialogue: 0,0:04:48.37,0:04:51.20,Default,,0,0,0,,Сіз оңай айта аласыз, өйткені Жастықта адам жоқ.
Dialogue: 0,0:04:51.79,0:04:52.91,Default,,0,0,0,,Жастар...
Dialogue: 0,0:04:54.08,0:04:55.00,Default,,0,0,0,,Онда?
Dialogue: 0,0:04:57.29,0:05:00.34,Default,,0,0,0,,Айтпақшы, бұл оқиға рас па?
Dialogue: 0,0:05:00.55,0:05:02.71,Default,,0,0,0,,Екінші командада да жақсы ойыншылар бар.
Dialogue: 0,0:05:03.13,0:05:05.22,Default,,0,0,0,,Сіз Эсперионмен таныссыз ба?
Dialogue: 0,0:05:06.76,0:05:08.18,Default,,0,0,0,,Эй, сен бе?
Dialogue: 0,0:05:08.55,0:05:11.31,Default,,0,0,0,,Ол өте сүйкімді және мейірімді⸺
Dialogue: 0,0:05:12.35,0:05:14.31,Default,,0,0,0,,Ол керемет сұмдық емес пе?
Dialogue: 0,0:05:14.43,0:05:17.69,Default,,0,0,0,,Екінші армия болса да, жастар элиталық жиын, солай емес пе?
Dialogue: 0,0:05:17.85,0:05:19.02,Default,,0,0,0,,Tende Cholo.
Dialogue: 0,0:05:19.19,0:05:22.69,Default,,0,0,0,,Бұл таңқаларлық болды хахахаха
Dialogue: 0,0:05:24.74,0:05:25.45,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:25.82,0:05:26.45,Default,,0,0,0,,Һм? Бұл не?
Dialogue: 0,0:05:26.65,0:05:28.70,Default,,0,0,0,,Оны кеспе, Такешима.
Dialogue: 0,0:05:28.82,0:05:30.91,Default,,0,0,0,,Мен алдыңғы шепке өткім келді.
Dialogue: 0,0:05:31.45,0:05:32.20,Default,,0,0,0,,Не~!? (Официант) Бұл – «Ой-Пи», көріп тұрсыз ба.
Dialogue: 0,0:05:32.45,0:05:34.41,Default,,0,0,0,,Менің артымнан ешкім жүрмейді.
Dialogue: 0,0:05:34.83,0:05:35.96,Default,,0,0,0,,Йотаро мен оның серіктері Каирға келді
Dialogue: 0,0:05:36.58,0:05:37.83,Default,,0,0,0,,Сол мүйізтұмсық жоғалып кетті!
Dialogue: 0,0:05:40.08,0:05:40.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:41.04,0:05:41.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:42.09,0:05:42.92,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:05:44.30,0:05:46.67,Default,,0,0,0,,Не... балалар, не істеп жатырсыңдар?
Dialogue: 0,0:05:46.97,0:05:47.84,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:05:48.05,0:05:48.93,Default,,0,0,0,,Хмф!
Dialogue: 0,0:05:49.01,0:05:50.39,Default,,0,0,0,,Керемет гол!
Dialogue: 0,0:05:51.22,0:05:52.18,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:05:52.39,0:05:54.22,Default,,0,0,0,,Хаха...
Dialogue: 0,0:05:54.31,0:05:56.10,Default,,0,0,0,,Хаха...
Dialogue: 0,0:06:00.52,0:06:02.27,Default,,0,0,0,,Бірінші тайм 35 минут
Dialogue: 0,0:06:03.19,0:06:04.44,Default,,0,0,0,,0-ден 3-ке дейін
Dialogue: 0,0:06:07.28,0:06:09.36,Default,,0,0,0,,Сендер сондай ақымақсыңдар!
Dialogue: 0,0:06:09.82,0:06:10.99,Default,,0,0,0,,В тобы болса да⸺
Dialogue: 0,0:06:11.20,0:06:13.58,Default,,0,0,0,,Біз Esperion маңдайшасын алдық!
Dialogue: 0,0:06:13.83,0:06:14.74,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:14.87,0:06:16.45,Default,,0,0,0,,Біз дұрыс істеп жатырмыз.
Dialogue: 0,0:06:16.95,0:06:18.12,Default,,0,0,0,,Иә
Dialogue: 0,0:06:19.17,0:06:22.17,Default,,0,0,0,,Сондықтан «біз»⸺
Dialogue: 0,0:06:22.29,0:06:24.63,Default,,0,0,0,,Бұл қандай құрылым, Асари?
Dialogue: 0,0:06:25.92,0:06:28.09,Default,,0,0,0,,Бүгін әркім әр түрлі!
Dialogue: 0,0:06:28.22,0:06:30.18,Default,,0,0,0,,Айтар аз, біз іріктеу тобындамыз⸺
Dialogue: 0,0:06:30.26,0:06:31.76,Default,,0,0,0,,Сіз кінәні басқа жаққа аударуға тырысасыз ба?
Dialogue: 0,0:06:31.84,0:06:32.93,Default,,0,0,0,,Олай емес!
Dialogue: 0,0:06:33.01,0:06:34.26,Default,,0,0,0,,Тоқта! (Отомо және басқалар)...
Dialogue: 0,0:06:34.97,0:06:37.06,Default,,0,0,0,,Менің сендерден көңілім қалды.
Dialogue: 0,0:06:37.77,0:06:40.65,Default,,0,0,0,,Жаттығу кезінде жағымсыз атмосфераға әкелу⸺
Dialogue: 0,0:06:41.15,0:06:44.44,Default,,0,0,0,,Мен мүмкін емес қателер қатарын жасап, тез арада 3 ұпай жинадым...
Dialogue: 0,0:06:45.27,0:06:47.49,Default,,0,0,0,,Бұл футбол алдындағы мәселе, балалар.
Dialogue: 0,0:06:48.07,0:06:50.28,Default,,0,0,0,,Сіз кәсіпқой болу үшін келген жоқсыз ба?
Dialogue: 0,0:06:50.74,0:06:53.74,Default,,0,0,0,,Балалар, қазір кәсіпқойлығың да жоқ.
Dialogue: 0,0:06:55.20,0:06:58.75,Default,,0,0,0,,Тапсырма...Мен оны мүлде түсінбеймін.
Dialogue: 0,0:06:59.21,0:07:02.33,Default,,0,0,0,,Бірінші тайм мен оған көп үйренбедім. Мен де қорғаныста ойнадым.
Dialogue: 0,0:07:02.63,0:07:04.00,Default,,0,0,0,,Боқ сияқты қызық емес⸺
Dialogue: 0,0:07:04.17,0:07:06.55,Default,,0,0,0,,Дриблингтен бас тарттым және көбірек пас бердім.
Dialogue: 0,0:07:07.38,0:07:11.55,Default,,0,0,0,,Менсіз де жасауға болатын нәрселерді жасадым.
Dialogue: 0,0:07:13.01,0:07:16.01,Default,,0,0,0,,Негіздер Мен өзімнен қорқатын кез келген нәрсені істей аламын
Dialogue: 0,0:07:16.10,0:07:19.10,Default,,0,0,0,,Өйткені ол данышпан, хехехехе~
Dialogue: 0,0:07:19.89,0:07:21.35,Default,,0,0,0,,Бірақ мүмкін емес!
Dialogue: 0,0:07:22.15,0:07:25.19,Default,,0,0,0,,Асари мен Куроданың іздегені бұл емес.
Dialogue: 0,0:07:25.86,0:07:27.02,Default,,0,0,0,,Өйткені сол жігіттер⸺
Dialogue: 0,0:07:27.11,0:07:29.94,Default,,0,0,0,,Кәдімгідей маған қарап әуре болмайсың.
Dialogue: 0,0:07:30.28,0:07:32.45,Default,,0,0,0,,Осы жаққа бұрылыңыз.
Dialogue: 0,0:07:32.53,0:07:34.20,Default,,0,0,0,,Балалар, түсіндіңдер ме?
Dialogue: 0,0:07:34.32,0:07:36.58,Default,,0,0,0,,Біз кем дегенде ынтымақтасуымыз керек...
Dialogue: 0,0:07:36.78,0:07:39.45,Default,,0,0,0,,Осылай жүре берсек, жеңілеміз.
Dialogue: 0,0:07:40.50,0:07:41.62,Default,,0,0,0,,Нозоми жаттықтырушы
Dialogue: 0,0:07:41.96,0:07:44.54,Default,,0,0,0,,1 жыл емес, 2 немесе 3 жылды енгізіңіз.
Dialogue: 0,0:07:45.21,0:07:46.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:46.46,0:07:48.05,Default,,0,0,0,,Бұл сәйкес келмейді.
Dialogue: 0,0:07:48.63,0:07:51.72,Default,,0,0,0,,Әсіресе Аои Курода Асари⸺
Dialogue: 0,0:07:52.05,0:07:54.76,Default,,0,0,0,,Сол жақ жол толық жұмыс істемейді
Dialogue: 0,0:07:55.01,0:07:56.30,Default,,0,0,0,,Ах... (Ашито) Ах...
Dialogue: 0,0:07:57.05,0:07:59.52,Default,,0,0,0,,Сіздің тым көп айтып жатқаныңызды бәріміз білеміз.
Dialogue: 0,0:08:00.06,0:08:02.27,Default,,0,0,0,,Бірақ мен жеңілгім келмейді
Dialogue: 0,0:08:02.85,0:08:03.85,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:08:04.06,0:08:04.81,Default,,0,0,0,,Күте тұрыңыз…
Dialogue: 0,0:08:05.48,0:08:07.48,Default,,0,0,0,,Өшіре алмасаңыз...
Dialogue: 0,0:08:08.48,0:08:10.28,Default,,0,0,0,,Күте тұрыңыз... (Күні) Тоғаши
Dialogue: 0,0:08:10.61,0:08:13.74,Default,,0,0,0,,Екінші таймнан бастап орталық қорғаушының орнына Исшики ауыстырылды
Dialogue: 0,0:08:14.07,0:08:15.41,Default,,0,0,0,,Ах... (Ашито) Хмм...
Dialogue: 0,0:08:15.62,0:08:17.41,Default,,0,0,0,,Не... не айтып тұрсың!?
Dialogue: 0,0:08:17.78,0:08:21.00,Default,,0,0,0,,Мына Тоғашы сондай бейберекет пе?
Dialogue: 0,0:08:21.45,0:08:23.37,Default,,0,0,0,,Мен де олай ойламаймын (Тайраташы) А...
Dialogue: 0,0:08:23.71,0:08:27.38,Default,,0,0,0,,Менде жоғарылаған жігіттерден үш ұпай алуға сенімім жоқ.
Dialogue: 0,0:08:27.54,0:08:28.54,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:08:29.13,0:08:31.71,Default,,0,0,0,,Бұл жеңу немесе жеңілуден гөрі, сіздің элиталық санаңызға қатысты⸺
Dialogue: 0,0:08:31.80,0:08:35.05,Default,,0,0,0,,Олар өздерінің арзан мақтаныштарын қорғауға тырысады.
Dialogue: 0,0:08:36.01,0:08:40.10,Default,,0,0,0,,Көптен бері солай болды. Мен академияда өстім.
Dialogue: 0,0:08:40.60,0:08:42.98,Default,,0,0,0,,Сәлем! Тағы айт!
Dialogue: 0,0:08:43.10,0:08:43.98,Default,,0,0,0,,Тоғаши!
Dialogue: 0,0:08:44.35,0:08:45.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:46.35,0:08:48.15,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:08:48.52,0:08:49.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:49.61,0:08:50.57,Default,,0,0,0,,Не?
Dialogue: 0,0:08:50.94,0:08:53.03,Default,,0,0,0,,Ісіміз дұрыс емес екені рас.
Dialogue: 0,0:08:53.86,0:08:55.53,Default,,0,0,0,,Қарым-қатынас жасау мүмкін емес
Dialogue: 0,0:08:56.45,0:08:59.24,Default,,0,0,0,,Бірақ мен мұны қалай да түсінемін.
Dialogue: 0,0:09:00.33,0:09:02.04,Default,,0,0,0,,Әркім қолынан келгенін жасайды
Dialogue: 0,0:09:03.70,0:09:05.62,Default,,0,0,0,,Жеңу немесе жеңілуден маңыздырақ нәрсе бар⸺
Dialogue: 0,0:09:05.71,0:09:07.38,Default,,0,0,0,,Ешкім ақымақ емес
Dialogue: 0,0:09:07.92,0:09:10.34,Default,,0,0,0,,Біздің бәріміз бірдей болатын жалғыз нәрсе.
Dialogue: 0,0:09:11.67,0:09:12.42,Default,,0,0,0,,Неапольдың ең үздік жиһаз шебері Марионың ұлы болып дүниеге келген
Dialogue: 0,0:09:12.51,0:09:13.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:14.84,0:09:16.26,Default,,0,0,0,,Іріңді кетіріңіз.
Dialogue: 0,0:09:16.80,0:09:17.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:18.43,0:09:20.35,Default,,0,0,0,,Мен сенімен көп ойынға шықпаймын.
Dialogue: 0,0:09:20.81,0:09:22.10,Default,,0,0,0,,Осы бір ойын
Dialogue: 0,0:09:22.97,0:09:24.64,Default,,0,0,0,,Екінші таймға 45 минут қалды
Dialogue: 0,0:09:25.14,0:09:27.40,Default,,0,0,0,,Тұлғаларыңыздың қақтығысы⸺
Dialogue: 0,0:09:27.56,0:09:31.11,Default,,0,0,0,,Ол химиялық реакция тудырады ма, әлде өзін-өзі бұзады ма...
Dialogue: 0,0:09:32.02,0:09:34.28,Default,,0,0,0,,Егер солай болса, бұл оның осы уақытқа дейін болғанын білдіреді.
Dialogue: 0,0:09:35.61,0:09:37.70,Default,,0,0,0,,Жазға дейін жүгірсең де.
Dialogue: 0,0:09:38.91,0:09:39.99,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:41.70,0:09:44.45,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:09:47.67,0:09:49.17,Default,,0,0,0,,Рахмет (Ашито)...
Dialogue: 0,0:09:53.50,0:09:55.26,Default,,0,0,0,,Ма... шынымен!
Dialogue: 0,0:09:56.13,0:09:59.80,Default,,0,0,0,,Қорғаушы 4... 5... 6... Алты артқа!?
Dialogue: 0,0:10:00.47,0:10:02.81,Default,,0,0,0,,Орташа қорғаныс да негізінен қорғаныс позициясы.
Dialogue: 0,0:10:03.14,0:10:05.31,Default,,0,0,0,,Мен бұлай төмендейді деп ойламаппын...
Dialogue: 0,0:10:05.47,0:10:08.64,Default,,0,0,0,,Уф... Мен сені қорғайын деп келдім, қалай кейіп танытсам да.
Dialogue: 0,0:10:08.81,0:10:10.94,Default,,0,0,0,,Жақсы, жеңеміз!
Dialogue: 0,0:10:11.02,0:10:14.23,Default,,0,0,0,,Жарайсыңдар! Сіз жастарды жеңе аласыз!
Dialogue: 0,0:10:15.78,0:10:18.15,Default,,0,0,0,,Аои Курода Асари (Аши халқы) Ах...
Dialogue: 0,0:10:18.49,0:10:19.78,Default,,0,0,0,,Сіз түсіндіңіз деп ойлаймын.
Dialogue: 0,0:10:20.49,0:10:22.03,Default,,0,0,0,,Мүмкіндігінше тез қалпына келтіріңіз
Dialogue: 0,0:10:22.49,0:10:26.25,Default,,0,0,0,,Желіде тұрған үшеуіңіз қазір мүлдем көмектеспейсіздер.
Dialogue: 0,0:10:26.54,0:10:27.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:28.00,0:10:31.13,Default,,0,0,0,,Үшеуміздің қатарымыз?
Dialogue: 0,0:10:31.79,0:10:34.42,Default,,0,0,0,,Неге бұл екеуі ғана ашуланды?
Dialogue: 0,0:10:35.17,0:10:37.63,Default,,0,0,0,,Қазір ойлап қарасам, сол кезде...
Dialogue: 0,0:10:38.88,0:10:40.68,Default,,0,0,0,,Көптеген одақтастармен⸺
Dialogue: 0,0:10:41.51,0:10:44.72,Default,,0,0,0,,Мен, Курода және Асари ғана бөлісетін...
Dialogue: 0,0:10:45.77,0:10:46.81,Default,,0,0,0,,Жол
Dialogue: 0,0:10:48.89,0:10:51.06,Default,,0,0,0,,Бұл қандай сезім...
Dialogue: 0,0:10:52.69,0:10:54.69,Default,,0,0,0,,Бір нәрсе қосылған сияқты...
Dialogue: 0,0:10:56.03,0:10:57.11,Default,,0,0,0,,Не?
Dialogue: 0,0:11:12.12,0:11:12.75,Default,,0,0,0,,Уф
Dialogue: 0,0:11:12.83,0:11:13.50,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:13.67,0:11:15.25,Default,,0,0,0,,Ерекше қорғаныстық күшейту
Dialogue: 0,0:11:15.71,0:11:18.21,Default,,0,0,0,,Бірақ оның керемет әсері бар сияқты.
Dialogue: 0,0:11:18.71,0:11:20.80,Default,,0,0,0,,Жарып өтетін ойыншылар жоқ.
Dialogue: 0,0:11:21.09,0:11:23.51,Default,,0,0,0,,Өйткені, екінші әскер – екінші әскер.
Dialogue: 0,0:11:24.30,0:11:25.26,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:25.97,0:11:26.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:30.23,0:11:32.23,Default,,0,0,0,,Ах... Бұл не? Эй!
Dialogue: 0,0:11:32.35,0:11:34.23,Default,,0,0,0,,Бұл сізге тимейді, иә...
Dialogue: 0,0:11:34.31,0:11:36.11,Default,,0,0,0,,Дөрекі болмаңыз
Dialogue: 0,0:11:36.44,0:11:39.03,Default,,0,0,0,,Балалар, шыдамдарың таусылып, ойының өрескел болып барады.
Dialogue: 0,0:11:39.36,0:11:40.95,Default,,0,0,0,,Егер қорқынышты болып көрінсе, мен карта ойнаймын.
Dialogue: 0,0:11:41.03,0:11:41.65,Default,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:11:43.45,0:11:44.62,Default,,0,0,0,,Эй (Сейкё №6) А?
Dialogue: 0,0:11:44.99,0:11:47.20,Default,,0,0,0,,Балалар, ұялмайсыңдар ма?
Dialogue: 0,0:11:47.79,0:11:49.37,Default,,0,0,0,,Осындай ашық қорғаныс
Dialogue: 0,0:11:50.29,0:11:53.50,Default,,0,0,0,,Бұл қызық емес пе? Эй, маған шабуыл жаса.
Dialogue: 0,0:11:53.75,0:11:56.79,Default,,0,0,0,,Хмф, бұл қызық емес.
Dialogue: 0,0:11:57.21,0:11:59.00,Default,,0,0,0,,Бірақ барлығы мұны қанағаттанарлықпен орындауда.
Dialogue: 0,0:12:00.59,0:12:04.89,Default,,0,0,0,,Біз тек жастардан жеңілгіміз келмейді.
Dialogue: 0,0:12:10.60,0:12:11.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:11.85,0:12:13.23,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:15.65,0:12:16.98,Default,,0,0,0,,Бұл не? Бұл жиіркенішті.
Dialogue: 0,0:12:17.90,0:12:20.65,Default,,0,0,0,,Эй Асари, бұл сенсің⸺
Dialogue: 0,0:12:21.32,0:12:23.90,Default,,0,0,0,,Сіз қабаттасу маманысыз.
Dialogue: 0,0:12:24.45,0:12:25.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:25.36,0:12:27.41,Default,,0,0,0,,Сіз қорғаныста болғандықтан, солай ма?
Dialogue: 0,0:12:27.83,0:12:30.24,Default,,0,0,0,,Қазір де мен мақсат алдынан қайтып келемін.
Dialogue: 0,0:12:31.16,0:12:36.38,Default,,0,0,0,,Дұрыс, мен білмей тұрып, сен әрқашан артымдасың.
Dialogue: 0,0:12:36.92,0:12:38.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:38.46,0:12:40.50,Default,,0,0,0,,Ей, тез қайтыңдар, балалар!
Dialogue: 0,0:12:40.67,0:12:41.59,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:42.34,0:12:43.47,Default,,0,0,0,,Және…
Dialogue: 0,0:12:44.01,0:12:45.59,Default,,0,0,0,,Ал Курода...
Dialogue: 0,0:12:47.55,0:12:51.35,Default,,0,0,0,,Мен және Асари⸺ арасында делдал ретінде әрекет ететін лауазымда
Dialogue: 0,0:12:51.64,0:12:53.81,Default,,0,0,0,,Мен әрқашан сондамын
Dialogue: 0,0:12:54.56,0:12:58.73,Default,,0,0,0,,Сіз өзіңіздің одақтастарыңызды ұзақ уақыт бойы бақылап жүрсіз бе?
Dialogue: 0,0:12:59.11,0:13:00.52,Default,,0,0,0,,Бар болғаны 30 минут қалды.
Dialogue: 0,0:13:01.11,0:13:03.03,Default,,0,0,0,,Мен оны бірден байқадым!
Dialogue: 0,0:13:03.36,0:13:05.53,Default,,0,0,0,,Тек назар аудара отырып, мен оны түсіндім!
Dialogue: 0,0:13:05.61,0:13:06.66,Default,,0,0,0,,Олар туралы!
Dialogue: 0,0:13:07.32,0:13:10.24,Default,,0,0,0,,Ал, Асари, Курода және сен⸺
Dialogue: 0,0:13:10.37,0:13:12.79,Default,,0,0,0,,Олар бір сызықта болғандықтан анық емес пе?
Dialogue: 0,0:13:13.29,0:13:15.46,Default,,0,0,0,,Жоқ, жоқ, бұл бәрі емес!
Dialogue: 0,0:13:16.37,0:13:19.13,Default,,0,0,0,,Сонда да...
Dialogue: 0,0:13:22.80,0:13:25.05,Default,,0,0,0,,Амансың ба, Ашито?
Dialogue: 0,0:13:26.30,0:13:28.76,Default,,0,0,0,,Сәлем Отомо Тогаши
Dialogue: 0,0:13:29.09,0:13:30.01,Default,,0,0,0,,Әй?
Dialogue: 0,0:13:31.10,0:13:33.64,Default,,0,0,0,,Осы уақытқа дейін мен олармен бірге болдым⸺
Dialogue: 0,0:13:34.39,0:13:36.77,Default,,0,0,0,,Менің ойынымды неге түсіне алмайсың?
Dialogue: 0,0:13:37.14,0:13:38.44,Default,,0,0,0,,Мен әрқашан осылай ойладым
Dialogue: 0,0:13:39.44,0:13:41.98,Default,,0,0,0,,Неге маған қарай алмайсың?
Dialogue: 0,0:13:42.65,0:13:43.57,Default,,0,0,0,,Бірақ⸺
Dialogue: 0,0:13:44.28,0:13:47.32,Default,,0,0,0,,Мен мұндай қарапайым нәрсені осы уақытқа дейін байқамаппын⸺
Dialogue: 0,0:13:49.07,0:13:52.66,Default,,0,0,0,,Сіз сол жігіттерді бақылап отырсыз ба...
Dialogue: 0,0:13:53.91,0:13:55.87,Default,,0,0,0,,Орын ауыстырайық, Нозоми-сан.
Dialogue: 0,0:13:56.75,0:13:58.96,Default,,0,0,0,,Бұл болашақ моральға да қатысты.
Dialogue: 0,0:13:59.58,0:14:02.46,Default,,0,0,0,,Әсіресе Аои мен Асариді дереу түсіру керек.
Dialogue: 0,0:14:04.17,0:14:05.34,Default,,0,0,0,,тағы 5 минут...
Dialogue: 0,0:14:06.51,0:14:08.34,Default,,0,0,0,,Маған тағы бес минут қарауға рұқсат етіңіз.
Dialogue: 0,0:14:09.30,0:14:11.93,Default,,0,0,0,,Асари Орталыққа оралыңыз! Сізді қоршап алады!
Dialogue: 0,0:14:12.51,0:14:13.43,Default,,0,0,0,,Асари!
Dialogue: 0,0:14:14.60,0:14:17.39,Default,,0,0,0,,Асари, Курода және I⸺
Dialogue: 0,0:14:18.06,0:14:20.35,Default,,0,0,0,,Көптеген жағдайларда белгілі бір қашықтықта болу
Dialogue: 0,0:14:21.94,0:14:23.61,Default,,0,0,0,,Мен допты алсам да⸺
Dialogue: 0,0:14:23.86,0:14:26.11,Default,,0,0,0,,Мен шетке қарамай, тек алға қарап жүгірсем де⸺
Dialogue: 0,0:14:26.61,0:14:29.28,Default,,0,0,0,,Себебі ол мені барынша аңдып жүр.
Dialogue: 0,0:14:30.41,0:14:34.45,Default,,0,0,0,,Мен бұл нені білдіретінін әлі білмеймін.
Dialogue: 0,0:14:35.12,0:14:38.75,Default,,0,0,0,,Бірақ Курода қазір сонда⸺
Dialogue: 0,0:14:39.16,0:14:42.92,Default,,0,0,0,,Мен қазір Асари болсам, мен⸺ болар едім
Dialogue: 0,0:14:43.38,0:14:44.71,Default,,0,0,0,,Сіз қай жерде болғыңыз келеді?
Dialogue: 0,0:14:45.05,0:14:45.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:49.13,0:14:50.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:50.22,0:14:51.51,Default,,0,0,0,,бұл...
Dialogue: 0,0:14:52.64,0:14:53.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:53.89,0:14:54.81,Default,,0,0,0,,Уф
Dialogue: 0,0:14:55.68,0:14:56.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:57.10,0:14:57.64,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:14:58.18,0:15:00.44,Default,,0,0,0,,Екі... қосылған
Dialogue: 0,0:15:02.61,0:15:03.86,Default,,0,0,0,,Aoi cover!
Dialogue: 0,0:15:04.11,0:15:04.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:05.23,0:15:06.23,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:15:06.36,0:15:07.19,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:15:07.28,0:15:09.03,Default,,0,0,0,,Жарайды, қақпа соққысы!
Dialogue: 0,0:15:09.15,0:15:11.78,Default,,0,0,0,,Хахахаха Қандай ұят, Жастар!
Dialogue: 0,0:15:12.16,0:15:14.37,Default,,0,0,0,,Біз қосыла алдық, бұл сирек!
Dialogue: 0,0:15:14.45,0:15:16.49,Default,,0,0,0,,Оқиғалар болмайды!
Dialogue: 0,0:15:16.62,0:15:18.20,Default,,0,0,0,,Куу... аа...
Dialogue: 0,0:15:22.63,0:15:23.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:24.79,0:15:26.38,Default,,0,0,0,,Бұл да Аоидың қателігі болды.
Dialogue: 0,0:15:27.09,0:15:29.01,Default,,0,0,0,,Біз әдемі қосылсақ та...
Dialogue: 0,0:15:29.76,0:15:32.64,Default,,0,0,0,,Аой қозғалмай, сол жерде тұрып қалды.
Dialogue: 0,0:15:34.55,0:15:36.35,Default,,0,0,0,,Бүгінгі Аойдың жылтырлығы жоқ.
Dialogue: 0,0:15:37.06,0:15:39.52,Default,,0,0,0,,5 минут болды, Нозоми-сан, ауыстырайық.
Dialogue: 0,0:15:40.18,0:15:42.48,Default,,0,0,0,,Сіз бүгін сыпайы көрінесіз.
Dialogue: 0,0:15:42.81,0:15:43.48,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:43.56,0:15:45.81,Default,,0,0,0,,Әрқашан теорияға негізделген нәрселерге қарамаңыз⸺
Dialogue: 0,0:15:45.98,0:15:48.23,Default,,0,0,0,,Сіз маған назар аударып отырсыз, солай емес пе?
Dialogue: 0,0:15:49.03,0:15:51.11,Default,,0,0,0,,Сіз, жалынды Фукуда сенушісі⸺
Dialogue: 0,0:15:51.70,0:15:54.53,Default,,0,0,0,,Сіз бірінші 3 ұпай алғандықтан дүрбелеңдесіз бе?
Dialogue: 0,0:15:55.24,0:15:56.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:57.99,0:15:59.75,Default,,0,0,0,,Әлі 30 минут қалды.
Dialogue: 0,0:16:00.37,0:16:04.42,Default,,0,0,0,,Мен қызықты нәрсе көремін деп ойладым⸺
Dialogue: 0,0:16:04.71,0:16:06.34,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:16:11.09,0:16:14.22,Default,,0,0,0,,Бір секундқа мен саған үлкен үміт арттым.
Dialogue: 0,0:16:16.30,0:16:19.89,Default,,0,0,0,,Сіздің бұрынғы орналасуыңыз: Куродаға бір рет түрту арқылы өту⸺
Dialogue: 0,0:16:20.22,0:16:21.39,Default,,0,0,0,,Өйткені ол мінсіз болды
Dialogue: 0,0:16:21.98,0:16:25.15,Default,,0,0,0,,Бірақ жабу мүмкін емес жерлерге қарасаңыз⸺
Dialogue: 0,0:16:25.52,0:16:27.52,Default,,0,0,0,,Өйткені, сен ештеңе түсінбейсің.
Dialogue: 0,0:16:28.32,0:16:32.53,Default,,0,0,0,,Дұрыс, ештеңе түсіне алмаған адам...
Dialogue: 0,0:16:32.95,0:16:34.57,Default,,0,0,0,,Соғұрлым тез жауап бере аласыз⸺
Dialogue: 0,0:16:35.24,0:16:36.91,Default,,0,0,0,,Эсперионның футболы тәтті...
Dialogue: 0,0:16:37.70,0:16:38.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:41.66,0:16:42.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:43.75,0:16:44.62,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:16:44.92,0:16:45.87,Default,,0,0,0,,Асари!
Dialogue: 0,0:16:46.71,0:16:47.46,Default,,0,0,0,,Уф!
Dialogue: 0,0:16:48.38,0:16:49.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:50.00,0:16:51.96,Default,,0,0,0,,Әй, мына үшеуінің суретін түсір.
Dialogue: 0,0:16:52.17,0:16:53.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:53.72,0:16:55.26,Default,,0,0,0,,Сол жақта үш адам
Dialogue: 0,0:16:56.59,0:16:58.51,Default,,0,0,0,,Гу... (Асари) У...
Dialogue: 0,0:16:59.01,0:17:00.14,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:17:00.39,0:17:03.35,Default,,0,0,0,,Неге, бұл үшеуің бір-біріңе қайтасыңдар.
Dialogue: 0,0:17:03.64,0:17:07.15,Default,,0,0,0,,Сіз 3 ұпай алдыңыз. Бұл уақытты сатып алу ма?
Dialogue: 0,0:17:07.23,0:17:08.65,Default,,0,0,0,,А, не?
Dialogue: 0,0:17:09.02,0:17:11.94,Default,,0,0,0,,Кез келген жағдайда, бұл үшеуінің біреуінің жігіті бар ма?
Dialogue: 0,0:17:12.11,0:17:15.95,Default,,0,0,0,,Жарайды, әлгі сүйкімді аққұба қыз.
Dialogue: 0,0:17:16.74,0:17:18.57,Default,,0,0,0,,Жақсы айта алмаймын, бірақ...
Dialogue: 0,0:17:19.99,0:17:22.08,Default,,0,0,0,,Кенет сол үш адамға⸺
Dialogue: 0,0:17:22.33,0:17:23.70,Default,,0,0,0,,Сезім өзгерді.
Dialogue: 0,0:17:25.62,0:17:26.79,Default,,0,0,0,,Кешіріңіз Курода
Dialogue: 0,0:17:27.00,0:17:29.96,Default,,0,0,0,,Дәл қазір мен Асаридің сезімін ойлауға тырыстым⸺
Dialogue: 0,0:17:30.21,0:17:32.30,Default,,0,0,0,,Мен саған тіпті назар аудара да алмадым.
Dialogue: 0,0:17:33.46,0:17:36.80,Default,,0,0,0,,Өтіп бара жатқанда бірден қабылдағышты жабамын.
Dialogue: 0,0:17:37.01,0:17:38.09,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:17:38.47,0:17:39.34,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:39.85,0:17:40.72,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:42.93,0:17:44.89,Default,,0,0,0,,Сен оны қайтарып бересің бе?
Dialogue: 0,0:17:46.10,0:17:49.40,Default,,0,0,0,,Егер мен Куроданың орнында болсам, менің қайда болғанымды қалар едің?
Dialogue: 0,0:17:49.86,0:17:51.65,Default,,0,0,0,,Хмм... уф...
Dialogue: 0,0:17:51.94,0:17:53.73,Default,,0,0,0,,Ашито кері Сай!
Dialogue: 0,0:17:55.15,0:17:57.32,Default,,0,0,0,,Ашито, артыңда, маған бер!
Dialogue: 0,0:17:57.65,0:17:59.87,Default,,0,0,0,,Кешіріңіз, Тачибана Тогаши
Dialogue: 0,0:18:00.16,0:18:03.91,Default,,0,0,0,,Әзірше Асари мен Куроданың қимылдарына назар аударайын!
Dialogue: 0,0:18:04.41,0:18:07.75,Default,,0,0,0,,Неге екенін түсінбеймін, бірақ солай істеу керек деп ойлаймын⸺
Dialogue: 0,0:18:07.83,0:18:09.63,Default,,0,0,0,,Бұл менің басымда жаңғырық!
Dialogue: 0,0:18:09.92,0:18:11.67,Default,,0,0,0,,Бұл психологиялық шабуыл ма? Әлде қудалау ма!
Dialogue: 0,0:18:12.84,0:18:16.05,Default,,0,0,0,,А... Көрдім, үшеуі.
Dialogue: 0,0:18:16.76,0:18:18.76,Default,,0,0,0,,Енді бір-біріміздің көзімізге қарай аламыз
Dialogue: 0,0:18:19.05,0:18:19.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:20.26,0:18:23.01,Default,,0,0,0,,Дәл қазір біз тек көзімізбен сөйлесіп жатырмыз.
Dialogue: 0,0:18:25.35,0:18:26.73,Default,,0,0,0,,Соға аласың, Аой!
Dialogue: 0,0:18:27.14,0:18:28.44,Default,,0,0,0,,Енді орта...
Dialogue: 0,0:18:29.14,0:18:30.15,Default,,0,0,0,,Соқ!
Dialogue: 0,0:18:34.61,0:18:35.65,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:36.69,0:18:37.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:37.69,0:18:38.70,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:18:40.07,0:18:41.24,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:18:42.83,0:18:46.45,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:46.70,0:18:47.79,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:18:48.83,0:18:51.04,Default,,0,0,0,,Керемет үзіліс, Асари Аои!
Dialogue: 0,0:18:51.50,0:18:52.63,Default,,0,0,0,,Біріншіден, бір ұпай!
Dialogue: 0,0:18:52.96,0:18:54.67,Default,,0,0,0,,Жаса... Доңмай Дөңмай
Dialogue: 0,0:18:54.88,0:18:56.46,Default,,0,0,0,,Екі ұпайлық айырмашылық әлі бар!
Dialogue: 0,0:18:56.80,0:18:59.17,Default,,0,0,0,,Егер сіз оны 15 минут ұстасаңыз, сіз жеңе аласыз!
Dialogue: 0,0:19:00.34,0:19:02.80,Default,,0,0,0,,Дөңмай? Бұл шынымен рас па?
Dialogue: 0,0:19:03.05,0:19:05.51,Default,,0,0,0,,Мен не болғанын білмедім
Dialogue: 0,0:19:06.01,0:19:07.85,Default,,0,0,0,,Біз соншалықты тартамыз⸺
Dialogue: 0,0:19:08.02,0:19:10.94,Default,,0,0,0,,Бір сәтте толығымен жойылды
Dialogue: 0,0:19:11.44,0:19:13.02,Default,,0,0,0,,Осы үшеуі ғана...
Dialogue: 0,0:19:13.77,0:19:15.11,Default,,0,0,0,,Тез қайт! Қайтып келу!
Dialogue: 0,0:19:17.19,0:19:18.15,Default,,0,0,0,,Мен соғып алар едім...
Dialogue: 0,0:19:19.65,0:19:21.16,Default,,0,0,0,,Маған неге жолдама бердіңіз?
Dialogue: 0,0:19:22.95,0:19:24.41,Default,,0,0,0,,Мен сізді тыңдауға рұқсат етіңіз.
Dialogue: 0,0:19:25.20,0:19:26.12,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:28.20,0:19:29.16,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:32.58,0:19:34.50,Default,,0,0,0,,Иә, мен соқтым.
Dialogue: 0,0:19:35.42,0:19:36.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:37.75,0:19:41.38,Default,,0,0,0,,Мен соғып алар едім, бірақ мен оны Асариге бейсаналы түрде бердім...
Dialogue: 0,0:19:42.05,0:19:45.43,Default,,0,0,0,,Осы уақытқа дейін мен оны міндетті түрде сол жерден ұратын едім.
Dialogue: 0,0:19:46.31,0:19:50.23,Default,,0,0,0,,Бұл менің шабуылшы ретіндегі қайтпас мақтанышым.
Dialogue: 0,0:19:51.69,0:19:53.85,Default,,0,0,0,,Бірақ неге...
Dialogue: 0,0:19:54.06,0:19:54.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:01.07,0:20:02.15,Default,,0,0,0,,Енді Л тергеу мәліметтерінің маған тарағанын түсінгеннен кейін,
Dialogue: 0,0:20:03.11,0:20:05.16,Default,,0,0,0,,Маған футбол беріңіз!
Dialogue: 0,0:20:06.16,0:20:07.33,Default,,0,0,0,,Алдымен осы жігіт туралы білетіндерімізді реттеп көрейік.
Dialogue: 0,0:20:08.79,0:20:10.50,Default,,0,0,0,,Сіз өзгергіңіз келгендіктен осындасыз.
Dialogue: 0,0:20:11.04,0:20:12.21,Default,,0,0,0,,Сіз қазірсіз
Dialogue: 0,0:20:13.33,0:20:14.50,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:15.00,0:20:18.71,Default,,0,0,0,,Мен қазір футболды үйреніп жатырмын.
Dialogue: 0,0:20:19.17,0:20:20.17,Default,,0,0,0,,Ашито!
Dialogue: 0,0:20:21.01,0:20:23.59,Default,,0,0,0,,Абайлаңыз, тағы бүйірден келе жатыр!
Dialogue: 0,0:20:23.93,0:20:24.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:26.60,0:20:27.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:27.80,0:20:29.06,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:20:29.14,0:20:33.35,Default,,0,0,0,,Сіз айтқандай қызық екен. Онда және қазір.
Dialogue: 0,0:20:34.44,0:20:35.65,Default,,0,0,0,,Көзге тию…
Dialogue: 0,0:20:36.48,0:20:38.69,Default,,0,0,0,,Бір-біріңнің көздеріңе қараңдар⸺
Dialogue: 0,0:20:38.82,0:20:40.23,Default,,0,0,0,,Өсиетті жеткізу
Dialogue: 0,0:20:41.15,0:20:43.74,Default,,0,0,0,,Футбол сияқты жылдам спортта⸺
Dialogue: 0,0:20:44.11,0:20:47.12,Default,,0,0,0,,Нұсқауларды дауыстап беруге болатын жағдайлар аз.
Dialogue: 0,0:20:47.74,0:20:49.79,Default,,0,0,0,,Осы себепті ең бастысы...
Dialogue: 0,0:20:50.37,0:20:51.62,Default,,0,0,0,,Көзге тию…
Dialogue: 0,0:20:52.54,0:20:55.58,Default,,0,0,0,,Ганс Офт Жапония құрамасының менеджері болған кезде⸺
Dialogue: 0,0:20:56.00,0:20:59.80,Default,,0,0,0,,Футбол негіздері, жан-жақты түсіндірілді
Dialogue: 0,0:21:00.59,0:21:04.38,Default,,0,0,0,,Алайда мұны істей алмайтын кәсіби спортшылар әлі де көп.
Dialogue: 0,0:21:05.30,0:21:07.64,Default,,0,0,0,,Менің көзіме қарап отыра алмайсың
Dialogue: 0,0:21:07.89,0:21:08.80,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:09.14,0:21:12.14,Default,,0,0,0,,Ерік білдіру болмаса.
Dialogue: 0,0:21:12.98,0:21:17.40,Default,,0,0,0,,Осы тұрғыдан алғанда, дәл қазір бұл үш адам керемет идеал.
Dialogue: 0,0:21:18.65,0:21:19.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:22.94,0:21:25.28,Default,,0,0,0,,Асари, жүгір.
Dialogue: 0,0:21:27.78,0:21:28.70,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:21:29.49,0:21:30.62,Default,,0,0,0,,Мені жіберме!
Dialogue: 0,0:21:33.66,0:21:34.66,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:21:36.21,0:21:38.04,Default,,0,0,0,,Иә, енді түсіндім.
Dialogue: 0,0:21:38.88,0:21:39.88,Default,,0,0,0,,Үш адам…
Dialogue: 0,0:21:40.54,0:21:43.17,Default,,0,0,0,,Осы үш адамның саны маңызды болды.
Dialogue: 0,0:21:43.84,0:21:46.93,Default,,0,0,0,,Бір емес, екі емес, үш адам
Dialogue: 0,0:21:47.43,0:21:51.60,Default,,0,0,0,,Футбол – допты үш адам алып жүретін спорт түрі.
Dialogue: 0,0:21:52.31,0:21:54.52,Default,,0,0,0,,Бірақ ең қызығы⸺
Dialogue: 0,0:21:54.93,0:21:57.31,Default,,0,0,0,,Неліктен мен кенеттен мұны істей алдым?
Dialogue: 0,0:21:59.06,0:22:01.44,Default,,0,0,0,,Хехе, өте қызық!
Dialogue: 0,0:22:02.82,0:22:03.73,Default,,0,0,0,,Бұл Курода!
Dialogue: 0,0:22:04.11,0:22:05.03,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:22:06.49,0:22:08.41,Default,,0,0,0,,Қаншалықты мұқият қорғалғанына қарамастан⸺
Dialogue: 0,0:22:08.86,0:22:10.78,Default,,0,0,0,,Үш адамның еркі бір болса⸺
Dialogue: 0,0:22:11.12,0:22:13.16,Default,,0,0,0,,Онда бос орын жасаңыз!
Dialogue: 0,0:22:13.41,0:22:14.12,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:22:17.37,0:22:21.29,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:21.50,0:22:25.38,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:22:26.76,0:22:28.30,Default,,0,0,0,,Хаха! мм...
Dialogue: 0,0:22:30.68,0:22:31.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:36.02,0:22:42.02,Default,,0,0,0,,♪～
Dialogue: 0,0:23:59.89,0:24:05.90,Default,,0,0,0,,～♪
Dialogue: 0,0:24:24.33,0:24:26.21,Default,,0,0,0,,Келесі жолы «Аоаши»
Dialogue: 0,0:24:26.67,0:24:27.71,Default,,0,0,0,,«ҚАРАН КӨЗ»
Dialogue: 0,0:24:29.21,0:24:35.21,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory