Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.12,0:00:05.96,Default,,0,0,0,,Ашито Аоидың басты осал тұстарының бірі –⸺
Dialogue: 0,0:00:07.17,0:00:09.59,Default,,0,0,0,,Бұл футболдың өте тар көрінісі.
Dialogue: 0,0:00:10.59,0:00:12.55,Default,,0,0,0,,Футболды «жеке тұлғалар» тұрғысынан түсіну
Dialogue: 0,0:00:13.13,0:00:17.89,Default,,0,0,0,,Топқа жетекшілік ету Белсенді болу
Dialogue: 0,0:00:18.30,0:00:21.18,Default,,0,0,0,,Мен өзіммін...
Dialogue: 0,0:00:22.52,0:00:24.85,Default,,0,0,0,,Футбол «меннен» асып түседі
Dialogue: 0,0:00:25.40,0:00:27.48,Default,,0,0,0,,Ойланбайтын ойыншыға тән.
Dialogue: 0,0:00:27.94,0:00:28.90,Default,,0,0,0,,Бірақ⸺
Dialogue: 0,0:00:29.90,0:00:32.24,Default,,0,0,0,,Футболдың негізі үшбұрыштар
Dialogue: 0,0:00:33.15,0:00:35.70,Default,,0,0,0,,«Кемінде үш адам»
Dialogue: 0,0:00:37.03,0:00:43.04,Default,,0,0,0,,♪～
Dialogue: 0,0:02:00.91,0:02:06.91,Default,,0,0,0,,～♪
Dialogue: 0,0:02:07.04,0:02:08.62,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:08.87,0:02:09.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:09.83,0:02:12.09,Default,,0,0,0,,Ұпай алдың ғой, бейбақ.
Dialogue: 0,0:02:12.17,0:02:13.67,Default,,0,0,0,,Қайтадан уақыт ұтайық!
Dialogue: 0,0:02:14.09,0:02:15.26,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:02:15.38,0:02:17.38,Default,,0,0,0,,Сүйегіңді сындырайын ба?
Dialogue: 0,0:02:17.84,0:02:18.88,Default,,0,0,0,,Ge…
Dialogue: 0,0:02:21.22,0:02:21.89,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:24.35,0:02:25.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:26.35,0:02:30.85,Default,,0,0,0,,11 адам, 21 адам болғанда, сен бізге осыны айттың.
Dialogue: 0,0:02:31.65,0:02:33.27,Default,,0,0,0,,«Айқын нәрсені жасайық»
Dialogue: 0,0:02:35.11,0:02:37.28,Default,,0,0,0,,Иә, дедім
Dialogue: 0,0:02:38.57,0:02:42.37,Default,,0,0,0,,Бұл тәжірибеде біз тек адам санына сену арқылы шабуыл жасадық⸺
Dialogue: 0,0:02:42.70,0:02:44.66,Default,,0,0,0,,Сіздің сөздеріңіз маған қатты әсер етті.
Dialogue: 0,0:02:45.87,0:02:49.83,Default,,0,0,0,,Бұл тәжірибедегі адамдардың саны маңызды емес екені рас.
Dialogue: 0,0:02:50.58,0:02:54.25,Default,,0,0,0,,Сандық артықшылығыңыз немесе кемшілігіңіз болса да, сіз футболды дұрыс ойнай аласыз ба?
Dialogue: 0,0:02:55.30,0:02:56.80,Default,,0,0,0,,Бұл тәжірибе болды.
Dialogue: 0,0:02:57.80,0:03:00.93,Default,,0,0,0,,Ал футболдың негізі үшбұрыштар
Dialogue: 0,0:03:01.59,0:03:05.05,Default,,0,0,0,,Біз үшін бұл Джуниордан сабақ алғандай.
Dialogue: 0,0:03:06.14,0:03:08.85,Default,,0,0,0,,Түсіндім, сендер де сол кезде⸺
Dialogue: 0,0:03:08.98,0:03:12.40,Default,,0,0,0,,Үшеуміз үшбұрыш жасамақ болдық.
Dialogue: 0,0:03:12.73,0:03:14.02,Default,,0,0,0,,Бірақ... (Ашито) А...
Dialogue: 0,0:03:14.94,0:03:16.65,Default,,0,0,0,,Сіз бастаманы қолға алуыңыз керек еді⸺
Dialogue: 0,0:03:17.03,0:03:19.65,Default,,0,0,0,,Мен үшбұрыш деген ұғымды да түсінбедім.
Dialogue: 0,0:03:20.61,0:03:23.03,Default,,0,0,0,,Ол бізге қараған да жоқ.
Dialogue: 0,0:03:24.03,0:03:26.28,Default,,0,0,0,,Мұның бәрі ұпай жинау туралы.
Dialogue: 0,0:03:27.24,0:03:28.24,Default,,0,0,0,,Қайдасың?
Dialogue: 0,0:03:30.12,0:03:31.96,Default,,0,0,0,,Бұл туралы ештеңе істей алмаймыз⸺
Dialogue: 0,0:03:32.37,0:03:35.29,Default,,0,0,0,,Тым болмаса допты қарсы жаққа лақтыруды айт⸺
Dialogue: 0,0:03:36.34,0:03:38.59,Default,,0,0,0,,Сіз менің жанымнан өтіп кеттіңіз...
Dialogue: 0,0:03:39.80,0:03:42.84,Default,,0,0,0,,алынды, есептегіш анықталды
Dialogue: 0,0:03:43.93,0:03:45.14,Default,,0,0,0,,Айтсаңыз...
Dialogue: 0,0:03:45.22,0:03:46.76,Default,,0,0,0,,Мен саған (Ашито) айттым ғой...
Dialogue: 0,0:03:47.47,0:03:48.51,Default,,0,0,0,,дедім
Dialogue: 0,0:03:49.89,0:03:54.98,Default,,0,0,0,,Үшбұрыштың маңыздылығы туралы біз кезекті жаттығуымыз кезінде айттық.
Dialogue: 0,0:03:55.98,0:03:58.32,Default,,0,0,0,,Аойдың да құлағына жеткен болуы керек.
Dialogue: 0,0:03:59.19,0:04:00.40,Default,,0,0,0,,Хмм.
Dialogue: 0,0:04:00.61,0:04:04.45,Default,,0,0,0,,Қарапайым әңгімелесіп жатқанымызға ол өзін сендірді ме...
Dialogue: 0,0:04:04.74,0:04:05.87,Default,,0,0,0,,Немесе⸺
Dialogue: 0,0:04:06.74,0:04:08.58,Default,,0,0,0,,Басынан бастап қызықпадың ба?
Dialogue: 0,0:04:08.66,0:04:09.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:10.37,0:04:11.96,Default,,0,0,0,,Бұл мүлдем мүмкін емес.
Dialogue: 0,0:04:12.87,0:04:15.63,Default,,0,0,0,,Біз оны мұқият және мұқият түсіндірсек те⸺
Dialogue: 0,0:04:15.92,0:04:18.46,Default,,0,0,0,,Менің ойымша, сізде ештеңе қалмады.
Dialogue: 0,0:04:19.50,0:04:20.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:22.01,0:04:24.80,Default,,0,0,0,,Кіші саптан жоғары тұрғандар үшін⸺
Dialogue: 0,0:04:25.26,0:04:27.68,Default,,0,0,0,,Мен сені бұлай түсіне алмадым⸺
Dialogue: 0,0:04:28.05,0:04:29.39,Default,,0,0,0,,Мен тіпті қаламадым.
Dialogue: 0,0:04:30.60,0:04:31.72,Default,,0,0,0,,Өкінішті
Dialogue: 0,0:04:33.18,0:04:35.44,Default,,0,0,0,,Маған футбол беріңіз!
Dialogue: 0,0:04:35.90,0:04:37.15,Default,,0,0,0,,Алдымен осы жігіт туралы білетіндерімізді реттеп көрейік.
Dialogue: 0,0:04:38.56,0:04:41.94,Default,,0,0,0,,Мен бәрін нөлден үйренуге дайын едім, бірақ⸺
Dialogue: 0,0:04:42.40,0:04:46.78,Default,,0,0,0,,Мүмкін мен сыныптастарымнан бірдеңе үйретуді өтінуім керек⸺
Dialogue: 0,0:04:47.28,0:04:49.62,Default,,0,0,0,,Менде ондай ой да болған жоқ.
Dialogue: 0,0:04:50.37,0:04:51.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:52.29,0:04:55.62,Default,,0,0,0,,Жастық шақтың бұл мекенінде, не көрсең, соны көреді⸺
Dialogue: 0,0:04:55.71,0:04:58.04,Default,,0,0,0,,Мен өсуді жалғастыруым керек.
Dialogue: 0,0:05:01.13,0:05:03.51,Default,,0,0,0,,Асари Курода рахмет!
Dialogue: 0,0:05:04.30,0:05:07.14,Default,,0,0,0,,Маған футболды үйретті!
Dialogue: 0,0:05:07.72,0:05:08.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:09.18,0:05:10.18,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:11.39,0:05:13.68,Default,,0,0,0,,Бірақ неге? (Ашито/Курода) мм...
Dialogue: 0,0:05:14.89,0:05:16.89,Default,,0,0,0,,Мұны кенеттен жасай алу ...
Dialogue: 0,0:05:17.94,0:05:19.77,Default,,0,0,0,,Жарайды, қайтадан бастайық!
Dialogue: 0,0:05:20.27,0:05:21.32,Default,,0,0,0,,Тыңдаңдар, балалар!
Dialogue: 0,0:05:21.86,0:05:23.07,Default,,0,0,0,,Сол үш адам.
Dialogue: 0,0:05:23.28,0:05:26.65,Default,,0,0,0,,Егер біз сол үш адамды басып алсақ, бәрібір ол қайтадан жұмыс істемейді!
Dialogue: 0,0:05:27.66,0:05:30.37,Default,,0,0,0,,Әлі бір ұпай алда! Мен сені өлсем де қорғаймын!
Dialogue: 0,0:05:30.91,0:05:31.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:33.08,0:05:35.08,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:35.83,0:05:37.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:40.29,0:05:41.13,Default,,0,0,0,,Мен әрқашан⸺ болдым
Dialogue: 0,0:05:41.92,0:05:45.17,Default,,0,0,0,,Алдымдағы допты қақпаға қалай апарамын?
Dialogue: 0,0:05:45.92,0:05:48.01,Default,,0,0,0,,Мен футбол үшін бар болғаны осы деп ойладым.
Dialogue: 0,0:05:48.93,0:05:50.09,Default,,0,0,0,,Бірақ бұл дұрыс емес.
Dialogue: 0,0:05:51.51,0:05:55.06,Default,,0,0,0,,Маңайдағы екі ойыншымен үшбұрыш құрастыр
Dialogue: 0,0:05:55.81,0:05:59.23,Default,,0,0,0,,Бұл үшбұрышты қарсыластың аумағына қалай сырғытамыз?
Dialogue: 0,0:05:59.81,0:06:00.52,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:00.69,0:06:02.27,Default,,0,0,0,,Жаулар азғырылды
Dialogue: 0,0:06:02.82,0:06:06.53,Default,,0,0,0,,Әрқашан бос орын бар... кішкене сәйкессіздік орын алады.
Dialogue: 0,0:06:08.91,0:06:11.28,Default,,0,0,0,,Үшбұрыштың бір бұрышы сонда кіреді.
Dialogue: 0,0:06:11.53,0:06:13.45,Default,,0,0,0,,Оған қысым көрсету⸺
Dialogue: 0,0:06:13.79,0:06:17.66,Default,,0,0,0,,Бос орынды толтыру үшін басқа жау қақпаға жылжиды.
Dialogue: 0,0:06:19.79,0:06:22.92,Default,,0,0,0,,Одан әрі үш адам өтіп, допты араластырады.
Dialogue: 0,0:06:23.75,0:06:28.59,Default,,0,0,0,,Кішігірім ауытқулар қосылып, қарсыластың жасақталуында үлкен саңылаулар тудырады.
Dialogue: 0,0:06:28.88,0:06:29.43,Default,,0,0,0,,Әй
Dialogue: 0,0:06:29.97,0:06:30.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:30.80,0:06:31.84,Default,,0,0,0,,Уф... Қат!
Dialogue: 0,0:06:32.30,0:06:35.60,Default,,0,0,0,,Керемет... Керемет Бұл керемет
Dialogue: 0,0:06:35.77,0:06:39.52,Default,,0,0,0,,Осыны итерсек, бүгін тағы қанша ұпай ала аламыз...
Dialogue: 0,0:06:46.48,0:06:47.44,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:06:50.91,0:06:54.41,Default,,0,0,0,,Не... Бұл не?
Dialogue: 0,0:06:57.75,0:06:59.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:02.21,0:07:03.92,Default,,0,0,0,,Сол жігіт… Көзіне латкі таққан Какужа ма?
Dialogue: 0,0:07:05.84,0:07:06.63,Default,,0,0,0,,Мен саған ешқашан осы туралы сұрастырамын деп айтқан жоқпын
Dialogue: 0,0:07:06.92,0:07:08.38,Default,,0,0,0,,Белгіні алып тастамаңыз!
Dialogue: 0,0:07:10.76,0:07:11.63,Default,,0,0,0,,Асари!
Dialogue: 0,0:07:11.93,0:07:12.84,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:07:25.65,0:07:26.73,Default,,0,0,0,,Уф! Ха
Dialogue: 0,0:07:27.02,0:07:27.73,Default,,0,0,0,,Уф
Dialogue: 0,0:07:29.15,0:07:30.74,Default,,0,0,0,,Ух... (Асари) На...
Dialogue: 0,0:07:33.24,0:07:35.28,Default,,0,0,0,,А... Мен оны білдім.
Dialogue: 0,0:07:36.45,0:07:38.87,Default,,0,0,0,,Барлығы, мен ойлағандай⸺
Dialogue: 0,0:07:39.62,0:07:40.87,Default,,0,0,0,,Ол қозғалды
Dialogue: 0,0:07:43.75,0:07:44.75,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:07:45.46,0:07:46.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:46.46,0:07:47.88,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:07:48.25,0:07:49.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:51.17,0:07:52.09,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:07:53.13,0:07:54.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:55.47,0:07:56.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:02.35,0:08:05.31,Default,,0,0,0,,Үшбұрышты қайта құрастырды
Dialogue: 0,0:08:05.73,0:08:07.52,Default,,0,0,0,,Анри Юма
Dialogue: 0,0:08:08.73,0:08:10.57,Default,,0,0,0,,Үшбұрыштың бір бұрышы⸺
Dialogue: 0,0:08:10.94,0:08:14.70,Default,,0,0,0,,Куродадан Отомого көшу арқылы
Dialogue: 0,0:08:14.86,0:08:16.99,Default,,0,0,0,,А, мен жақсы нәрсе көрдім.
Dialogue: 0,0:08:19.41,0:08:21.16,Default,,0,0,0,,Ашито (Ашито)...
Dialogue: 0,0:08:24.12,0:08:26.46,Default,,0,0,0,,Біртүрлі екен, мен.
Dialogue: 0,0:08:27.46,0:08:28.79,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:08:30.13,0:08:32.67,Default,,0,0,0,,Әйтеуір, бәрі...
Dialogue: 0,0:08:33.80,0:08:35.97,Default,,0,0,0,,Барлық жаулар мен одақтастар...
Dialogue: 0,0:08:37.01,0:08:38.14,Default,,0,0,0,,Мен оны көрдім
Dialogue: 0,0:08:39.22,0:08:40.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:41.93,0:08:43.14,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:44.06,0:08:46.48,Default,,0,0,0,,Келесі... жылжу.
Dialogue: 0,0:08:49.77,0:08:52.78,Default,,0,0,0,,Сіз бұл мәселеде де жақсы жұмыс істеп жатырсыз, Ашито.
Dialogue: 0,0:08:53.95,0:08:56.53,Default,,0,0,0,,Асари мен Отомо ұпай жинады.
Dialogue: 0,0:08:57.91,0:09:02.83,Default,,0,0,0,,Аои Асариден соңғы рұқсат алғандай кейіп танытты⸺
Dialogue: 0,0:09:03.29,0:09:05.62,Default,,0,0,0,,Аудан бойынша солдан оңға қарай жүгірді
Dialogue: 0,0:09:07.54,0:09:11.88,Default,,0,0,0,,Себебі Сейкё орта мектебі сол жақтағы үш адамға барынша сақ болды⸺
Dialogue: 0,0:09:12.34,0:09:15.17,Default,,0,0,0,,Аойды жаншу үшін екі адам келді.
Dialogue: 0,0:09:16.55,0:09:18.05,Default,,0,0,0,,Бірақ бұл есеп
Dialogue: 0,0:09:18.68,0:09:20.30,Default,,0,0,0,,Екеуін жылжытыңыз⸺
Dialogue: 0,0:09:20.64,0:09:23.81,Default,,0,0,0,,Бұл Otomo үшін ату курсын тазарту болды.
Dialogue: 0,0:09:25.10,0:09:30.48,Default,,0,0,0,,Сонымен қатар, Асариге Отомоның бар екенін білу үшін⸺
Dialogue: 0,0:09:31.19,0:09:33.78,Default,,0,0,0,,Асари Отомоны көре алуы үшін⸺
Dialogue: 0,0:09:34.07,0:09:36.32,Default,,0,0,0,,Мен көзімді бағыттап жүгірдім.
Dialogue: 0,0:09:37.74,0:09:40.16,Default,,0,0,0,,Ол тіпті қолымен сәл нұсқады.
Dialogue: 0,0:09:41.20,0:09:43.04,Default,,0,0,0,,А... дұрыс.
Dialogue: 0,0:09:43.29,0:09:45.00,Default,,0,0,0,,Бәрін сол бала басқарды.
Dialogue: 0,0:09:45.08,0:09:45.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:46.54,0:09:48.12,Default,,0,0,0,,Бұл бір ғана сәйкестік⸺
Dialogue: 0,0:09:48.62,0:09:51.09,Default,,0,0,0,,Үшбұрыш түсінігін түсінуден алыс⸺
Dialogue: 0,0:09:51.29,0:09:53.17,Default,,0,0,0,,Оны дамытты.
Dialogue: 0,0:09:54.51,0:09:57.97,Default,,0,0,0,,Кенеттен осындай нәрсені істеуге бола ма?
Dialogue: 0,0:10:05.81,0:10:08.60,Default,,0,0,0,,Қосымша уақыт! Соңғы 3 минут!
Dialogue: 0,0:10:09.06,0:10:10.19,Default,,0,0,0,,Оны ашыңыз!
Dialogue: 0,0:10:10.31,0:10:12.15,Default,,0,0,0,,Тағы бір ұпай алып, жеңіңіз!
Dialogue: 0,0:10:12.57,0:10:13.65,Default,,0,0,0,,Қорғаңыз!
Dialogue: 0,0:10:13.73,0:10:16.86,Default,,0,0,0,,Дөрекі ойын жақсы! Ұтыс ойынына әкеліңіз!
Dialogue: 0,0:10:22.45,0:10:25.75,Default,,0,0,0,,Кіру салтанатында сол ұрыс басталғанда⸺
Dialogue: 0,0:10:26.62,0:10:29.58,Default,,0,0,0,,Ашито тақтаға біртүрлі нәрсе салды.
Dialogue: 0,0:10:30.67,0:10:34.34,Default,,0,0,0,,Біртүрлі екенін енді түсіндім де, сыныпта қалдым.
Dialogue: 0,0:10:35.25,0:10:37.88,Default,,0,0,0,,Эй, бұл дұрыс емес сияқты.
Dialogue: 0,0:10:39.01,0:10:39.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:39.97,0:10:42.43,Default,,0,0,0,,Айтпақшы, айналамда бәрі жақсы.
Dialogue: 0,0:10:43.51,0:10:45.31,Default,,0,0,0,,Менің айналамдағы адамдар да сәйкес келеді.
Dialogue: 0,0:10:46.02,0:10:48.93,Default,,0,0,0,,Бұл тым көп секіріс.
Dialogue: 0,0:10:49.39,0:10:53.19,Default,,0,0,0,,Ойыншылардың алаңдағы позицияларын толық есімде сақтайтыныма сене алар емеспін.
Dialogue: 0,0:10:53.69,0:10:55.90,Default,,0,0,0,,Иә, бұл күлкілі.
Dialogue: 0,0:10:56.78,0:10:58.78,Default,,0,0,0,,Бірақ мен бұл туралы біраз уақыт ойладым.
Dialogue: 0,0:10:59.24,0:11:02.41,Default,,0,0,0,,Ашитоның жақсару деңгейі керемет.
Dialogue: 0,0:11:03.37,0:11:04.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:04.78,0:11:06.49,Default,,0,0,0,,Іргетасы тозған болса да⸺
Dialogue: 0,0:11:06.66,0:11:10.12,Default,,0,0,0,,Сіз оны үйренгеннен кейін оны өзіңізге айналдырып, оны толығымен басқара аласыз.
Dialogue: 0,0:11:10.66,0:11:12.08,Default,,0,0,0,,Яғни, қолдану.
Dialogue: 0,0:11:13.00,0:11:15.63,Default,,0,0,0,,Қолданбаларды тез қолдану мүмкін емес.
Dialogue: 0,0:11:16.00,0:11:18.38,Default,,0,0,0,,Бір нәрсе...
Dialogue: 0,0:11:19.13,0:11:21.13,Default,,0,0,0,,Біртүрлі қабілеттерді сезіну
Dialogue: 0,0:11:22.26,0:11:25.35,Default,,0,0,0,,Мүмкін қазіргі ойыншы Аои⸺
Dialogue: 0,0:11:25.85,0:11:28.89,Default,,0,0,0,,Ойыншылардың болашақ қимылдарын болжай аламыз.
Dialogue: 0,0:11:29.56,0:11:30.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:30.48,0:11:32.48,Default,,0,0,0,,Сонымен қатар, масштаб ...
Dialogue: 0,0:11:32.85,0:11:35.61,Default,,0,0,0,,Поо~! Фуфуфуфу… (Мотоки және басқалар) Ах…
Dialogue: 0,0:11:36.52,0:11:39.53,Default,,0,0,0,,Ойыншылардың алаңдағы орнын толық түсіну⸺
Dialogue: 0,0:11:39.82,0:11:42.99,Default,,0,0,0,,Оның келесі қадамын қазір болжай аласыз ба?
Dialogue: 0,0:11:43.16,0:11:46.58,Default,,0,0,0,,Барлығы? Эй, сен жассың ғой, солай ма?
Dialogue: 0,0:11:46.70,0:11:48.91,Default,,0,0,0,,Қалай ойласаң да мағынасы жоқ⸺
Dialogue: 0,0:11:48.99,0:11:51.91,Default,,0,0,0,,Мұны футболға қоспаңыз.
Dialogue: 0,0:11:53.58,0:11:55.58,Default,,0,0,0,,Бұл жай ғана логика ма?
Dialogue: 0,0:11:58.00,0:12:00.72,Default,,0,0,0,,Қиын нәрселерден бөлек, мен⸺
Dialogue: 0,0:12:01.67,0:12:04.89,Default,,0,0,0,,Мен Ашитоны жастар таңдауында алғаш көргеннен бері⸺
Dialogue: 0,0:12:05.09,0:12:06.89,Default,,0,0,0,,Жүрегім дүрсілдеп кетті
Dialogue: 0,0:12:13.39,0:12:16.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:16.65,0:12:18.07,Default,,0,0,0,,Мұнда екеніңе сенбеймін
Dialogue: 0,0:12:20.48,0:12:24.20,Default,,0,0,0,,Бірақ мен үлгере алмай қинала бастадым.
Dialogue: 0,0:12:26.57,0:12:27.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:28.99,0:12:31.00,Default,,0,0,0,,Ашито лақтыру!
Dialogue: 0,0:12:31.70,0:12:32.79,Default,,0,0,0,,Асығыңыз, асығыңыз!
Dialogue: 0,0:12:33.71,0:12:34.62,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:12:35.17,0:12:37.13,Default,,0,0,0,,Мен оғаш нәрселерді көре бастадым⸺
Dialogue: 0,0:12:37.46,0:12:40.09,Default,,0,0,0,,Менің басым айналады.
Dialogue: 0,0:12:43.30,0:12:44.80,Default,,0,0,0,,Кешіріңіз, доп
Dialogue: 0,0:12:47.80,0:12:48.80,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:49.64,0:12:50.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:52.02,0:12:53.64,Default,,0,0,0,,О... а...
Dialogue: 0,0:13:05.24,0:13:06.45,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:06.95,0:13:10.03,Default,,0,0,0,,Ауыстыру ұясы! Мен көбірек уақытты босқа жібердім!
Dialogue: 0,0:13:10.24,0:13:11.91,Default,,0,0,0,,Мен тең нәтижеге жетуді мақсат етіп отырмын!
Dialogue: 0,0:13:12.24,0:13:14.87,Default,,0,0,0,,Тезірек мынаны ауыстыр... Уф~
Dialogue: 0,0:13:15.75,0:13:18.83,Default,,0,0,0,,Менің уақытым жоқ Жақсы нәрсе, бір ойын?
Dialogue: 0,0:13:20.29,0:13:21.25,Default,,0,0,0,,696-санды тұтқын – Мұнда не болып жатыр өзі?
Dialogue: 0,0:13:22.13,0:13:23.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:23.92,0:13:25.67,Default,,0,0,0,,Тек тынышталыңыз.
Dialogue: 0,0:13:26.55,0:13:27.68,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:13:29.18,0:13:30.39,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:32.56,0:13:33.60,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:36.44,0:13:37.85,Default,,0,0,0,,Хэхе (гүл) Ах...
Dialogue: 0,0:13:38.44,0:13:40.98,Default,,0,0,0,,Аха ахахха ахахха
Dialogue: 0,0:13:44.11,0:13:45.99,Default,,0,0,0,,Мен сізге ұпай жинаймын.
Dialogue: 0,0:13:47.28,0:13:48.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:49.78,0:13:53.58,Default,,0,0,0,,Аои: Мен лақтыруды қабылдаймын. Алға, алға!
Dialogue: 0,0:13:54.54,0:13:55.45,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:13:55.83,0:13:56.83,Default,,0,0,0,,Иә
Dialogue: 0,0:13:58.12,0:14:00.75,Default,,0,0,0,,Үшбұрышты көздің жанасуы
Dialogue: 0,0:14:01.88,0:14:04.80,Default,,0,0,0,,Футболдың барлық түрін үйрену - ең жақсысы
Dialogue: 0,0:14:06.30,0:14:09.64,Default,,0,0,0,,Командаңызға ұпай жинауға көмектесу үшін айналаңызды пайдаланыңыз
Dialogue: 0,0:14:10.64,0:14:12.72,Default,,0,0,0,,Бірақ солай.
Dialogue: 0,0:14:13.26,0:14:14.56,Default,,0,0,0,,Мен ұпай жинаймын
Dialogue: 0,0:14:16.14,0:14:18.69,Default,,0,0,0,,Бір қадам әрі қарай ойлау
Dialogue: 0,0:14:20.19,0:14:22.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:23.07,0:14:26.49,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:14:27.28,0:14:28.61,Default,,0,0,0,,Барлығы шабуыл жасайды
Dialogue: 0,0:14:28.90,0:14:30.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:30.87,0:14:32.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:32.87,0:14:34.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:34.41,0:14:36.45,Default,,0,0,0,,Алаңдамаңыз! Қорғаңыз!
Dialogue: 0,0:14:36.58,0:14:38.50,Default,,0,0,0,,Қорғау? қалай
Dialogue: 0,0:14:38.87,0:14:41.21,Default,,0,0,0,,Адам санын сол үшке көбейту керек пе?
Dialogue: 0,0:14:41.67,0:14:43.92,Default,,0,0,0,,Бірақ бұл енді олай емес.
Dialogue: 0,0:14:44.13,0:14:47.38,Default,,0,0,0,,Дәл қазір гол соққан жартылай қорғаушы белгіленбеген.
Dialogue: 0,0:14:47.59,0:14:51.26,Default,,0,0,0,,Бұл жігіттер енді кез келген жерде жұмыс істей алады дегенді білдіреді!
Dialogue: 0,0:14:51.84,0:14:52.80,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:14:52.89,0:14:55.47,Default,,0,0,0,,Кімді басу керек?
Dialogue: 0,0:14:56.35,0:14:57.47,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:14:59.10,0:15:00.44,Default,,0,0,0,,Түпнұсқа мынау.
Dialogue: 0,0:15:00.52,0:15:03.44,Default,,0,0,0,,Мына жігіт кенет өзгерді! Сол жерден біртүрлі болды.
Dialogue: 0,0:15:03.52,0:15:06.78,Default,,0,0,0,,Тезірек талқандасам ғой!
Dialogue: 0,0:15:07.44,0:15:08.90,Default,,0,0,0,,Асари!
Dialogue: 0,0:15:10.03,0:15:11.07,Default,,0,0,0,,Ойнаңыз!
Dialogue: 0,0:15:11.70,0:15:13.37,Default,,0,0,0,,Алданып қалмаңыз! Жабыңыз!
Dialogue: 0,0:15:14.49,0:15:16.66,Default,,0,0,0,,Бұл жігіттер балық аулаумен айналысады!
Dialogue: 0,0:15:16.83,0:15:18.33,Default,,0,0,0,,Мақсат алдындағы аумақты қатайтыңыз!
Dialogue: 0,0:15:20.83,0:15:21.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:22.04,0:15:25.88,Default,,0,0,0,,Өзіңізді алып келіңіз...
Dialogue: 0,0:15:26.21,0:15:27.09,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:27.84,0:15:31.13,Default,,0,0,0,,Өзіңізді әкеліңіз
Dialogue: 0,0:15:32.38,0:15:34.72,Default,,0,0,0,,Аа, бүгін⸺
Dialogue: 0,0:15:35.76,0:15:36.93,Default,,0,0,0,,(Кёко) Ах…
Dialogue: 0,0:15:37.22,0:15:38.64,Default,,0,0,0,,А... а...
Dialogue: 0,0:15:42.02,0:15:43.06,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:43.44,0:15:44.40,Default,,0,0,0,,Иә
Dialogue: 0,0:15:46.36,0:15:47.32,Default,,0,0,0,,Хаа…
Dialogue: 0,0:15:48.40,0:15:49.61,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:56.33,0:15:58.12,Default,,0,0,0,,Оң жағы бос.
Dialogue: 0,0:15:58.29,0:15:59.33,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:16:00.50,0:16:03.00,Default,,0,0,0,,Неге оны ешкім сыртқа шығармайды деп ойлаймын.
Dialogue: 0,0:16:03.83,0:16:07.00,Default,,0,0,0,,Оны жоғарыдан қарап білуге болады⸺
Dialogue: 0,0:16:07.59,0:16:10.38,Default,,0,0,0,,Жерден көруге болатын нәрсенің шегі бар.
Dialogue: 0,0:16:10.84,0:16:13.97,Default,,0,0,0,,Сондықтан ойыншыларға ашуланбаңыз.
Dialogue: 0,0:16:15.01,0:16:16.68,Default,,0,0,0,,Бірақ бұл арман ғой, солай ма?
Dialogue: 0,0:16:17.39,0:16:20.68,Default,,0,0,0,,Даланың үстінде айналып жүрген құс сияқты⸺
Dialogue: 0,0:16:21.18,0:16:24.65,Default,,0,0,0,,Барлық ойыншылардың қайда екенін білу...
Dialogue: 0,0:16:25.35,0:16:26.69,Default,,0,0,0,,Бұл арман емес
Dialogue: 0,0:16:27.19,0:16:28.27,Default,,0,0,0,,Әлемде⸺
Dialogue: 0,0:16:28.77,0:16:32.44,Default,,0,0,0,,Ойыншы бар, оны тек аспанда айналады.
Dialogue: 0,0:16:32.99,0:16:33.99,Default,,0,0,0,,Сирек
Dialogue: 0,0:16:36.82,0:16:37.45,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:42.45,0:16:44.58,Default,,0,0,0,,Нух... Уау!
Dialogue: 0,0:16:47.79,0:16:48.67,Default,,0,0,0,,Шаа!
Dialogue: 0,0:16:48.79,0:16:49.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:52.46,0:16:53.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:53.51,0:16:55.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:58.47,0:17:00.26,Default,,0,0,0,,Хмм… (гүл) Мм…
Dialogue: 0,0:17:04.77,0:17:06.19,Default,,0,0,0,,Фуфу
Dialogue: 0,0:17:07.27,0:17:09.82,Default,,0,0,0,,Бұл қызық, бұл сөзсіз.
Dialogue: 0,0:17:10.07,0:17:11.11,Default,,0,0,0,,Мен және ұлым
Dialogue: 0,0:17:11.90,0:17:13.90,Default,,0,0,0,,Акутсу басқа адамдар туралы айтпайды⸺
Dialogue: 0,0:17:14.19,0:17:16.57,Default,,0,0,0,,Сіз бұл туралы бұрын қысқаша айтып өттіңіз, сондықтан мен қызық болдым.
Dialogue: 0,0:17:17.87,0:17:18.91,Default,,0,0,0,,Қызықты
Dialogue: 0,0:17:20.16,0:17:21.66,Default,,0,0,0,,Ең қызығы⸺
Dialogue: 0,0:17:21.99,0:17:24.50,Default,,0,0,0,,Адамның өзі өз қабілеттерін білмейді.
Dialogue: 0,0:17:25.41,0:17:26.96,Default,,0,0,0,,Күдікті болу⸺
Dialogue: 0,0:17:27.29,0:17:29.79,Default,,0,0,0,,Орташа кадрдың кеңістігі де өзгертілмеген⸺
Dialogue: 0,0:17:30.13,0:17:32.88,Default,,0,0,0,,Сейкё артқа тартқысы келді, бірақ...
Dialogue: 0,0:17:34.13,0:17:36.76,Default,,0,0,0,,Қозғалыс тек екінші таймда соншалықты жақсарғанына сене алмаймын!
Dialogue: 0,0:17:37.05,0:17:38.14,Default,,0,0,0,,Оны ешкім оқи алмайды
Dialogue: 0,0:17:38.89,0:17:39.89,Default,,0,0,0,,Бұл үлкен мәселе.
Dialogue: 0,0:17:40.97,0:17:42.10,Default,,0,0,0,,Шындығында, 2-сыныпты үш тәжірибеші мен бір 1-сыныпты тәжірибеші қызмет барысында қаза тапты.
Dialogue: 0,0:17:43.14,0:17:45.06,Default,,0,0,0,,Біреуді мақтауға қалай дәтің бар?
Dialogue: 0,0:17:47.52,0:17:51.40,Default,,0,0,0,,Eh~ Esperion Youth B командасының мүшелері!
Dialogue: 0,0:17:51.82,0:17:53.98,Default,,0,0,0,,Кешегі Сейкё орта мектебіне қарсы ойын
Dialogue: 0,0:17:54.49,0:17:56.40,Default,,0,0,0,,Үлкен жеңісіңізбен құттықтаймыз!
Dialogue: 0,0:17:56.99,0:17:59.95,Default,,0,0,0,,А командасы да бүгін Аомориде ірі жеңіске жетті⸺
Dialogue: 0,0:18:00.03,0:18:01.74,Default,,0,0,0,,Мен қазір үйге бара жатырмын⸺
Dialogue: 0,0:18:01.91,0:18:03.29,Default,,0,0,0,,Тек B тобы үшін⸺
Dialogue: 0,0:18:03.37,0:18:06.25,Default,,0,0,0,,Еш ойланбастан көңіл көтеруіңізді қалаймыз!
Dialogue: 0,0:18:07.00,0:18:09.92,Default,,0,0,0,,Кайдо Денки осылайша жеңіс кешін өткізді!
Dialogue: 0,0:18:10.00,0:18:11.38,Default,,0,0,0,,Шааа~!
Dialogue: 0,0:18:11.67,0:18:14.88,Default,,0,0,0,,Бас демеушіге рахмет!
Dialogue: 0,0:18:15.01,0:18:17.42,Default,,0,0,0,,Жарайсыңдар, балалар, тамақ ішіңдер!
Dialogue: 0,0:18:18.13,0:18:18.80,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:21.14,0:18:23.10,Default,,0,0,0,,Ах... Аму
Dialogue: 0,0:18:24.56,0:18:26.23,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:26.31,0:18:28.89,Default,,0,0,0,,Міне, міне... Бұл~!
Dialogue: 0,0:18:29.52,0:18:31.40,Default,,0,0,0,,Қандай жұмсақ!
Dialogue: 0,0:18:31.48,0:18:33.07,Default,,0,0,0,,Тістеген сәтте еріп кетеді
Dialogue: 0,0:18:33.15,0:18:36.11,Default,,0,0,0,,Сол кезде шырынды ет шырыны бірден жарылып кетті!
Dialogue: 0,0:18:36.32,0:18:37.78,Default,,0,0,0,,Аузыңды жап, тамақ іш!
Dialogue: 0,0:18:37.86,0:18:39.28,Default,,0,0,0,,Жоқ, сен!
Dialogue: 0,0:18:39.40,0:18:40.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:40.53,0:18:42.87,Default,,0,0,0,,Сіз нені айтасыз, жоқ па? Гүл!
Dialogue: 0,0:18:43.20,0:18:45.04,Default,,0,0,0,,Етті гриль жасау тәсілі маңызды!
Dialogue: 0,0:18:45.12,0:18:47.91,Default,,0,0,0,,Майы көп қабырғалар жақсылап грильде пісіргенде дәмді болады.
Dialogue: 0,0:18:48.00,0:18:49.29,Default,,0,0,0,,Сондай-ақ асқазанға түсетін салмақты азайтады!
Dialogue: 0,0:18:49.62,0:18:51.63,Default,,0,0,0,,Не... Не?!
Dialogue: 0,0:18:51.96,0:18:54.84,Default,,0,0,0,,Бір жағында 80%, артқы жағында 20% деп аталады
Dialogue: 0,0:18:56.00,0:18:58.09,Default,,0,0,0,,Бетін қытырлақ ету арқылы...
Dialogue: 0,0:19:02.68,0:19:05.14,Default,,0,0,0,,Ах~ Ах... Ах~!
Dialogue: 0,0:19:05.64,0:19:06.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:07.39,0:19:09.43,Default,,0,0,0,,Хагого… кешіріңіз.
Dialogue: 0,0:19:09.52,0:19:11.06,Default,,0,0,0,,Ол үшін уайымдамай, жеп қойыңыз.
Dialogue: 0,0:19:11.69,0:19:13.31,Default,,0,0,0,,Сырттан келген адам
Dialogue: 0,0:19:13.52,0:19:15.90,Default,,0,0,0,,Жоқ, ол директордың әпкесі⸺
Dialogue: 0,0:19:15.98,0:19:17.23,Default,,0,0,0,,Мен бөгде адам емеспін
Dialogue: 0,0:19:18.40,0:19:20.57,Default,,0,0,0,,Сіз Хана Куроданы білесіз бе?
Dialogue: 0,0:19:20.99,0:19:22.49,Default,,0,0,0,,Кіші жастан⸺
Dialogue: 0,0:19:22.61,0:19:24.91,Default,,0,0,0,,Ол маған көмектесуге жиі келетін.
Dialogue: 0,0:19:25.37,0:19:28.29,Default,,0,0,0,,Біз сыныптаспыз және жоғарылатылған топты бәріміз білеміз.
Dialogue: 0,0:19:29.12,0:19:30.37,Default,,0,0,0,,Хмм.
Dialogue: 0,0:19:31.83,0:19:33.13,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:33.38,0:19:35.88,Default,,0,0,0,,Олай болса, сен көбірек ойын көруге кел, Хана.
Dialogue: 0,0:19:38.84,0:19:40.72,Default,,0,0,0,,Келесі жолы да жеңемін деп үміттенемін~
Dialogue: 0,0:19:41.13,0:19:42.13,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:43.76,0:19:44.93,Default,,0,0,0,,Нихи~
Dialogue: 0,0:19:46.47,0:19:47.97,Default,,0,0,0,,Ууууууу~
Dialogue: 0,0:19:48.06,0:19:49.22,Default,,0,0,0,,Сол Асариден
Dialogue: 0,0:19:49.47,0:19:51.64,Default,,0,0,0,,Аои-кун, сенің айтар сөзің бар, солай ма?
Dialogue: 0,0:19:51.73,0:19:52.73,Default,,0,0,0,,Хмм... (Тачибана) Иә?
Dialogue: 0,0:19:52.85,0:19:53.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:55.40,0:19:56.36,Default,,0,0,0,,Жаңа...
Dialogue: 0,0:19:57.19,0:19:58.15,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:59.57,0:20:04.07,Default,,0,0,0,,Кіру салтанатында... бір жағдайда... бұл... сөздер...
Dialogue: 0,0:20:05.70,0:20:06.62,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:07.87,0:20:10.91,Default,,0,0,0,,...Тым көп. Бұл жөнінде уайымдамаңыз.
Dialogue: 0,0:20:11.37,0:20:13.50,Default,,0,0,0,,Иә? Ах~
Dialogue: 0,0:20:14.08,0:20:15.25,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:16.63,0:20:18.75,Default,,0,0,0,,Мен ол жерде болмадым, бірақ⸺
Dialogue: 0,0:20:20.63,0:20:23.22,Default,,0,0,0,,Міне, біз шынайы сезімімізді білдіріп, өсеміз!
Dialogue: 0,0:20:23.43,0:20:25.68,Default,,0,0,0,,Дос деген осы емес пе?
Dialogue: 0,0:20:28.39,0:20:30.85,Default,,0,0,0,,Бүгіннен бастап, тағы да бірге еңбектенейік.
Dialogue: 0,0:20:31.14,0:20:32.48,Default,,0,0,0,,А... а...
Dialogue: 0,0:20:32.68,0:20:33.89,Default,,0,0,0,,О…
Dialogue: 0,0:20:34.14,0:20:35.60,Default,,0,0,0,,Отомо, сен де.
Dialogue: 0,0:20:37.27,0:20:39.65,Default,,0,0,0,,Футбол ойнайық!
Dialogue: 0,0:20:42.07,0:20:43.65,Default,,0,0,0,,Бірақ, Аои-кун.
Dialogue: 0,0:20:44.32,0:20:45.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:45.24,0:20:47.28,Default,,0,0,0,,Сол кіру рәсімі кезінде тәртіпсіздік⸺
Dialogue: 0,0:20:47.57,0:20:50.33,Default,,0,0,0,,Маған сенің сөздерің қатты әсер етті.
Dialogue: 0,0:20:51.25,0:20:53.00,Default,,0,0,0,,Ұпайларға әуестенуден бас тарту керек пе?
Dialogue: 0,0:20:53.37,0:20:56.38,Default,,0,0,0,,Мұндай шабуылшы сол сәттен бастап өледі!
Dialogue: 0,0:20:56.92,0:20:58.29,Default,,0,0,0,,Бұл жақсы болды.
Dialogue: 0,0:20:58.38,0:20:59.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:59.50,0:21:01.09,Default,,0,0,0,,Біз көтерілген топпыз⸺
Dialogue: 0,0:21:01.38,0:21:02.76,Default,,0,0,0,,Мүмкін теорияда⸺
Dialogue: 0,0:21:02.84,0:21:05.18,Default,,0,0,0,,Менің футбол туралы ойлайтын әдетім бар шығар
Dialogue: 0,0:21:06.05,0:21:09.89,Default,,0,0,0,,Теорияда қарастырылмаған сізден үйренетін көп нәрсе бар сияқты.
Dialogue: 0,0:21:10.89,0:21:11.85,Default,,0,0,0,,Курода...
Dialogue: 0,0:21:12.56,0:21:15.39,Default,,0,0,0,,О... О, Курибаяши! (Ашито) Иә?
Dialogue: 0,0:21:16.06,0:21:17.85,Default,,0,0,0,,Ол шығады ма? Ақырында!
Dialogue: 0,0:21:19.23,0:21:22.36,Default,,0,0,0,,Орта мектептің екінші курс студенті, небәрі 16 жаста
Dialogue: 0,0:21:22.86,0:21:26.15,Default,,0,0,0,,Эсперион жастарының қазынасы Харухиса Курибаяши
Dialogue: 0,0:21:26.36,0:21:28.62,Default,,0,0,0,,Қазір мен J1 сахнасында тұрмын
Dialogue: 0,0:21:29.95,0:21:30.78,Default,,0,0,0,,Ха...
Dialogue: 0,0:21:31.28,0:21:32.45,Default,,0,0,0,,Барлығы айтып жатыр
Dialogue: 0,0:21:32.83,0:21:35.37,Default,,0,0,0,,Қалай болғанда да, Курибаяши ерекше.
Dialogue: 0,0:21:35.58,0:21:37.12,Default,,0,0,0,,Тек Эсперион емес⸺
Dialogue: 0,0:21:37.25,0:21:40.38,Default,,0,0,0,,Жапония құрамасының болашағын тасымалдайтын кеме.
Dialogue: 0,0:21:41.00,0:21:43.71,Default,,0,0,0,,О~ Ахаха
Dialogue: 0,0:21:44.42,0:21:46.63,Default,,0,0,0,,Ал, сен сабырлысың.
Dialogue: 0,0:21:46.80,0:21:50.35,Default,,0,0,0,,Осы 20 000 жанкүйер адамдардың алдында мақтанышпен тұрып...
Dialogue: 0,0:21:50.80,0:21:52.31,Default,,0,0,0,,Аои ойыншысы (Ашито)...
Dialogue: 0,0:21:52.85,0:21:53.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:53.68,0:21:56.06,Default,,0,0,0,,Бұл сол сыныптағы Анри Кайдо.
Dialogue: 0,0:21:56.14,0:21:57.06,Default,,0,0,0,,Е...
Dialogue: 0,0:21:57.56,0:21:58.69,Default,,0,0,0,,Aoi ойнатқышы
Dialogue: 0,0:21:59.15,0:22:02.02,Default,,0,0,0,,Бейне жаттығуларын қолданып көргіңіз келе ме?
Dialogue: 0,0:22:03.73,0:22:06.99,Default,,0,0,0,,Тек Курибаяшидің қимылдарын бақылаңыз.
Dialogue: 0,0:22:07.95,0:22:09.87,Default,,0,0,0,,Сен сияқты орта мектеп оқушысы
Dialogue: 0,0:22:10.16,0:22:13.33,Default,,0,0,0,,Кәсіби ойыншылар арасында оның жағдайы қалай?
Dialogue: 0,0:22:13.95,0:22:16.12,Default,,0,0,0,,Мен сені сол жерде тұр деп ойладым⸺
Dialogue: 0,0:22:16.37,0:22:19.29,Default,,0,0,0,,Оны өз ойыңызда ойнап көріңіз
Dialogue: 0,0:22:20.21,0:22:23.55,Default,,0,0,0,,Ал егер ұнаса, сөзбен айтып бер.
Dialogue: 0,0:22:36.02,0:22:42.02,Default,,0,0,0,,♪～
Dialogue: 0,0:23:59.89,0:24:05.90,Default,,0,0,0,,～♪
Dialogue: 0,0:24:24.42,0:24:26.25,Default,,0,0,0,,Келесі жолы «Аоаши»
Dialogue: 0,0:24:26.79,0:24:27.75,Default,,0,0,0,,«Бұрылу»
Dialogue: 0,0:24:29.25,0:24:35.25,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory