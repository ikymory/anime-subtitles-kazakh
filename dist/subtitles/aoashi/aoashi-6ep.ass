Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:20.18,0:00:20.89,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:22.85,0:00:23.89,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:26.02,0:00:32.03,Default,,0,0,0,,♪～
Dialogue: 0,0:01:49.94,0:01:55.94,Default,,0,0,0,,～♪
Dialogue: 0,0:01:57.90,0:01:59.28,Default,,0,0,0,,Ум...
Dialogue: 0,0:01:59.61,0:02:02.70,Default,,0,0,0,,Кешкі сағат 18:00-де клуб үйінің алдында кездесу
Dialogue: 0,0:02:02.78,0:02:04.79,Default,,0,0,0,,Әлі көп уақыт бар.
Dialogue: 0,0:02:12.50,0:02:13.50,Default,,0,0,0,,Менен басқа⸺
Dialogue: 0,0:02:14.05,0:02:16.92,Default,,0,0,0,,Іріктеуден өткендер бар ма?
Dialogue: 0,0:02:18.09,0:02:22.26,Default,,0,0,0,,Тачибана Отомо... мені қабыл алыңыз.
Dialogue: 0,0:02:22.76,0:02:24.26,Default,,0,0,0,,Кя~! (Ашито) Уау...
Dialogue: 0,0:02:25.47,0:02:28.56,Default,,0,0,0,,Жоғарғы топ негізгі алаңға жиналды.
Dialogue: 0,0:02:30.60,0:02:31.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:34.44,0:02:37.15,Default,,0,0,0,,О... Негізгі жер...
Dialogue: 0,0:02:37.36,0:02:40.07,Default,,0,0,0,,Топтық тәжірибе…
Dialogue: 0,0:02:43.95,0:02:45.74,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:02:46.04,0:02:50.25,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааааааа...
Dialogue: 0,0:02:51.25,0:02:53.54,Default,,0,0,0,,Бұл жапон өкілі...
Dialogue: 0,0:02:54.13,0:02:56.55,Default,,0,0,0,,Мен теледидардан ғана көрген ойыншы бар...
Dialogue: 0,0:02:57.51,0:03:00.59,Default,,0,0,0,,Мен сіздің алдыңызда жаттығу жасаймын!
Dialogue: 0,0:03:01.13,0:03:03.55,Default,,0,0,0,,Хехехехехе?
Dialogue: 0,0:03:04.26,0:03:04.89,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:03:04.97,0:03:07.97,Default,,0,0,0,,Ах! Сіз Жастар таңдауының перзентісіз!
Dialogue: 0,0:03:08.06,0:03:09.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:09.56,0:03:11.85,Default,,0,0,0,,Мүмкін сол жүк жатақханаға көшетін шығар!?
Dialogue: 0,0:03:12.40,0:03:14.02,Default,,0,0,0,,Сен өттің бе? Жастар!
Dialogue: 0,0:03:14.40,0:03:16.36,Default,,0,0,0,,Е... а... жақсы...
Dialogue: 0,0:03:16.44,0:03:19.65,Default,,0,0,0,,Құттықтаймыз! Мен өтемін деп ойладым!
Dialogue: 0,0:03:19.74,0:03:21.53,Default,,0,0,0,,Өйткені сіз керемет жұмыс жасадыңыз!
Dialogue: 0,0:03:21.82,0:03:24.20,Default,,0,0,0,,Бар күшіңізді салыңыз және міндетті түрде шыңға жетіңіз!
Dialogue: 0,0:03:24.91,0:03:27.45,Default,,0,0,0,,А... а...
Dialogue: 0,0:03:28.45,0:03:30.50,Default,,0,0,0,,Аа, менің ең жақсы тәжірибем⸺
Dialogue: 0,0:03:30.58,0:03:31.87,Default,,0,0,0,,Сіз оны бірінші рет көріп тұрсыз ба?
Dialogue: 0,0:03:32.29,0:03:35.46,Default,,0,0,0,,А... иә, мен Эхимеде тұрдым.
Dialogue: 0,0:03:35.84,0:03:36.92,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:03:37.05,0:03:39.09,Default,,0,0,0,,Бірақ тез үйреніп кетесің деп ойлаймын.
Dialogue: 0,0:03:39.76,0:03:42.34,Default,,0,0,0,,Өйткені жоғарғы және жастар алаңдары бір-біріне жақын⸺
Dialogue: 0,0:03:42.59,0:03:44.51,Default,,0,0,0,,Жастар құрамында ұлттық құрама ойыншылары бар⸺
Dialogue: 0,0:03:44.59,0:03:47.60,Default,,0,0,0,,Сіз J лигасының үздік ойыншыларын жақыннан көре аласыз.
Dialogue: 0,0:03:48.31,0:03:51.35,Default,,0,0,0,,Бақытты балалар тіпті кеңес алатын сияқты.
Dialogue: 0,0:03:51.60,0:03:53.69,Default,,0,0,0,,Бұл Esperion Youth бағдарламасының артықшылығы.
Dialogue: 0,0:03:54.06,0:03:56.44,Default,,0,0,0,,Керемет! Керемет!
Dialogue: 0,0:03:56.77,0:03:59.57,Default,,0,0,0,,Хехехе, бұл керемет.
Dialogue: 0,0:03:59.78,0:04:02.86,Default,,0,0,0,,Мен мұндай ортада футбол ойнай алатыныма сене алар емеспін.
Dialogue: 0,0:04:03.61,0:04:04.45,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:04.91,0:04:06.03,Default,,0,0,0,,Отомо!
Dialogue: 0,0:04:06.62,0:04:08.16,Default,,0,0,0,,Отомо Аои!
Dialogue: 0,0:04:09.08,0:04:10.29,Default,,0,0,0,,Тачибана!
Dialogue: 0,0:04:11.12,0:04:14.75,Default,,0,0,0,,Ахаха, өттіңдер! Ахаха аха
Dialogue: 0,0:04:15.71,0:04:17.63,Default,,0,0,0,,Не, сен білмедің, Аой?
Dialogue: 0,0:04:17.92,0:04:21.97,Default,,0,0,0,,Отомо екеуміз бұл үшеуінің емтиханнан өткенін білдік.
Dialogue: 0,0:04:22.05,0:04:22.80,Default,,0,0,0,,Нуна!?
Dialogue: 0,0:04:22.88,0:04:24.43,Default,,0,0,0,,Хахахаха~
Dialogue: 0,0:04:24.68,0:04:27.64,Default,,0,0,0,,Байланыс ақпаратын алмаған жалғыз сізсіз.
Dialogue: 0,0:04:28.01,0:04:28.97,Default,,0,0,0,,Нуу…
Dialogue: 0,0:04:29.39,0:04:32.77,Default,,0,0,0,,Хахахаха Сіз артта қалғанға қалай қарайсыз?
Dialogue: 0,0:04:33.35,0:04:36.52,Default,,0,0,0,,Ендеше... онда, балалар, сендер де жатақханаға көшесіңдер ме?
Dialogue: 0,0:04:36.85,0:04:39.57,Default,,0,0,0,,Аа, мен Асакусаданмын.
Dialogue: 0,0:04:39.65,0:04:43.19,Default,,0,0,0,,Маған жол жүруге онша алыс емес, бірақ мен өзімді айғайлап жібергім келді.
Dialogue: 0,0:04:43.44,0:04:46.28,Default,,0,0,0,,Мен де, мектепке баратын уақытым болса⸺
Dialogue: 0,0:04:46.41,0:04:47.87,Default,,0,0,0,,Мен бұл қосымша уақытты тәжірибеге пайдаланғым келеді.
Dialogue: 0,0:04:48.41,0:04:51.24,Default,,0,0,0,,Оның үстіне ата-анаңның қасында болсаң, бүлініп қалар едің.
Dialogue: 0,0:04:51.58,0:04:54.66,Default,,0,0,0,,Бірақ Токиоға дейін келген Аоимен салыстырғанда...
Dialogue: 0,0:04:55.96,0:04:57.88,Default,,0,0,0,,Жарайсыңдар балалар
Dialogue: 0,0:04:58.88,0:05:00.34,Default,,0,0,0,,Сізге жақсы...
Dialogue: 0,0:05:02.21,0:05:05.22,Default,,0,0,0,,Сәлем, балалар, осында қол қоя аласыз ба?
Dialogue: 0,0:05:05.63,0:05:07.84,Default,,0,0,0,,Болашақта мен Эсперионды арқама көтеріп жүруім мүмкін⸺
Dialogue: 0,0:05:07.93,0:05:10.05,Default,,0,0,0,,Үш адамның өмірінің алғашқы қолтаңбасы!
Dialogue: 0,0:05:10.43,0:05:13.43,Default,,0,0,0,,Аха~ (Тачибана) Осыны жазып алайық. Бұл ескерткіш болады.
Dialogue: 0,0:05:14.06,0:05:16.85,Default,,0,0,0,,Біз қиын таңдауды бірге еңсердік⸺
Dialogue: 0,0:05:17.23,0:05:18.98,Default,,0,0,0,,Өйткені біз таптырмас доспыз.
Dialogue: 0,0:05:19.11,0:05:22.94,Default,,0,0,0,,Та... Тачибана, сен... ұятсыз, сен мұны жиі жасайсың...
Dialogue: 0,0:05:23.03,0:05:25.40,Default,,0,0,0,,Не? Мен біртүрлі нәрсе айттым ба?
Dialogue: 0,0:05:26.03,0:05:26.90,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:05:28.07,0:05:30.28,Default,,0,0,0,,Мен сіздің атыңызды жаза аламын ба? иә!
Dialogue: 0,0:05:30.37,0:05:33.12,Default,,0,0,0,,Үшеуіңізбен бір параққа жазыңыз.
Dialogue: 0,0:05:33.70,0:05:34.25,Default,,0,0,0,,Әй?
Dialogue: 0,0:05:37.00,0:05:38.96,Default,,0,0,0,,О, бұл калька.
Dialogue: 0,0:05:39.04,0:05:40.33,Default,,0,0,0,,Жоқ, оны шешпеңіз.
Dialogue: 0,0:05:40.42,0:05:42.00,Default,,0,0,0,,Белгі ерекше
Dialogue: 0,0:05:42.09,0:05:44.26,Default,,0,0,0,,Ол кейіннен қазынаға айналары сөзсіз.
Dialogue: 0,0:05:44.51,0:05:45.63,Default,,0,0,0,,Курибаяши?
Dialogue: 0,0:05:46.01,0:05:48.22,Default,,0,0,0,,Сен қаншалықты нашар оқыдың!
Dialogue: 0,0:05:48.30,0:05:50.51,Default,,0,0,0,,Сіз қабылданған топтың тақырыбын да білмейсіз бе?
Dialogue: 0,0:05:51.68,0:05:53.60,Default,,0,0,0,,Қараңдар! Бұл жерде!
Dialogue: 0,0:05:55.10,0:05:55.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:56.64,0:05:58.77,Default,,0,0,0,,Бұл Курибаяшидің мақаласы
Dialogue: 0,0:05:59.02,0:06:02.77,Default,,0,0,0,,Бұл таңқаларлық. Ол орта мектептің бірінші жылында үздік командада жаттығады.
Dialogue: 0,0:06:04.03,0:06:06.36,Default,,0,0,0,,Менімен сенің арасыңда бір ғана айырмашылық бар.
Dialogue: 0,0:06:07.28,0:06:10.41,Default,,0,0,0,,J Youth кәсіби әлеммен тікелей байланысты ма?
Dialogue: 0,0:06:11.12,0:06:13.41,Default,,0,0,0,,Егер сіз жастарда тамаша нәтижелерге қол жеткізсеңіз⸺
Dialogue: 0,0:06:13.66,0:06:16.29,Default,,0,0,0,,J лигасында тіпті жоғары сынып оқушылары да ойнай алады.
Dialogue: 0,0:06:16.95,0:06:20.25,Default,,0,0,0,,Оны ұзақ уақыт бойы қатты жақтаушылар да айтады.
Dialogue: 0,0:06:20.92,0:06:23.42,Default,,0,0,0,,Қалай болғанда да, Курибаяши ерекше.
Dialogue: 0,0:06:23.71,0:06:25.21,Default,,0,0,0,,Тек Эсперион емес⸺
Dialogue: 0,0:06:25.30,0:06:28.42,Default,,0,0,0,,Жапон құрамасының болашағын да тасымалдайтын кеме.
Dialogue: 0,0:06:29.72,0:06:32.47,Default,,0,0,0,,Курибаяши… Харухиса…
Dialogue: 0,0:06:42.48,0:06:43.36,Default,,0,0,0,,О~
Dialogue: 0,0:06:43.44,0:06:46.40,Default,,0,0,0,,Іріктеуден өткен үш адам – сіз...
Dialogue: 0,0:06:46.98,0:06:50.32,Default,,0,0,0,,Ах! Жастар құрамасына іріктеу арқылы қатысты...
Dialogue: 0,0:06:53.74,0:06:58.20,Default,,0,0,0,,Әй, Асари, анау үшеуі де кіріп жатыр. Сәлем.
Dialogue: 0,0:06:58.29,0:06:59.21,Default,,0,0,0,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:06:59.41,0:07:00.58,Default,,0,0,0,,Көптен бері көрмеген
Dialogue: 0,0:07:00.75,0:07:02.75,Default,,0,0,0,,Мен қорғаушы болып ойнайтынмын⸺
Dialogue: 0,0:07:02.83,0:07:05.42,Default,,0,0,0,,Бастапқыда форвард Юма Мотоки
Dialogue: 0,0:07:05.80,0:07:06.75,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:07:07.38,0:07:11.34,Default,,0,0,0,,Ол шабуылшы немесе менің алмастырушым болады. Бейшара жігіт.
Dialogue: 0,0:07:11.59,0:07:12.72,Default,,0,0,0,,Ашито Аои
Dialogue: 0,0:07:12.80,0:07:16.56,Default,,0,0,0,,Бір сөзбен айтқанда, ол мыңжылдықта бір рет келетін гений алға.
Dialogue: 0,0:07:16.72,0:07:20.23,Default,,0,0,0,,Сен... Идиот, сен менің ағамсың! Сондай ақылды адам...
Dialogue: 0,0:07:20.43,0:07:23.31,Default,,0,0,0,,Аа, сіз қате түсінген боларсыз.
Dialogue: 0,0:07:23.73,0:07:25.65,Default,,0,0,0,,Мен Асари екеуміз кіші жаспыз
Dialogue: 0,0:07:25.90,0:07:27.86,Default,,0,0,0,,Мен де сен сияқты орта мектептің үшінші курсында оқимын.
Dialogue: 0,0:07:28.19,0:07:32.66,Default,,0,0,0,,Ол кезде адам аз болғандықтан екі адам ғана қатысуға рұқсат етілген.
Dialogue: 0,0:07:33.03,0:07:33.99,Default,,0,0,0,,Е...
Dialogue: 0,0:07:34.53,0:07:37.74,Default,,0,0,0,,А, мына жігіт Асари, оның әкесі британдық...
Dialogue: 0,0:07:37.83,0:07:40.62,Default,,0,0,0,,Юма: Мен өзімді таныстырамын.
Dialogue: 0,0:07:41.79,0:07:45.21,Default,,0,0,0,,Ацуши Асари Мартис іріктеуде шабуылшы болды
Dialogue: 0,0:07:45.59,0:07:48.17,Default,,0,0,0,,Бірақ мен шын мәнінде қорғаушымын. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:07:48.63,0:07:49.46,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:07:49.59,0:07:50.76,Default,,0,0,0,,Танысқаныма қуаныштымын~
Dialogue: 0,0:07:51.47,0:07:54.93,Default,,0,0,0,,Футбол ойнайтын, жүзі жақсы жаман жігіт жоқ.
Dialogue: 0,0:07:55.05,0:07:56.47,Default,,0,0,0,,Мына жігіт жау.
Dialogue: 0,0:07:57.60,0:07:58.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:00.31,0:08:01.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:02.14,0:08:03.44,Default,,0,0,0,,Кіші жастан⸺
Dialogue: 0,0:08:03.52,0:08:05.73,Default,,0,0,0,,Жастар тәжірибесіне қатысу дегеніміз⸺
Dialogue: 0,0:08:05.86,0:08:09.23,Default,,0,0,0,,Менің ойымша, бұл екі болашағы зор адамдар. Мен оларды құрметтеймін.
Dialogue: 0,0:08:10.07,0:08:14.03,Default,,0,0,0,,Бұл Йокояма Мусашино кіші жастарынан келген Соичиро Тачибана.
Dialogue: 0,0:08:14.53,0:08:17.12,Default,,0,0,0,,Бұдан былай Esperion мүшесі ретінде⸺
Dialogue: 0,0:08:17.53,0:08:20.75,Default,,0,0,0,,Маған сізден үйренуге рұқсат етіңіз.
Dialogue: 0,0:08:21.16,0:08:22.79,Default,,0,0,0,,Ой... (Тачибана) Иә?
Dialogue: 0,0:08:22.87,0:08:25.04,Default,,0,0,0,,Кездесу уақыты әлдеқашан өтіп кетсе де⸺
Dialogue: 0,0:08:25.63,0:08:27.29,Default,,0,0,0,,Бір ғана адам келмеді.
Dialogue: 0,0:08:28.17,0:08:30.84,Default,,0,0,0,,А... Неше тұрғын бар?
Dialogue: 0,0:08:31.09,0:08:34.43,Default,,0,0,0,,Юма мен Асариден басқа 10 кіші жас бар.
Dialogue: 0,0:08:34.51,0:08:37.68,Default,,0,0,0,,Мен оларға бірдеңе беріп, алдымен жатақханаға баруын өтіндім.
Dialogue: 0,0:08:38.51,0:08:40.72,Default,,0,0,0,,Бірақ мен барлаудан алған бір адам...
Dialogue: 0,0:08:41.14,0:08:43.81,Default,,0,0,0,,Біз онымен тіпті байланыса алмағандықтан, ол қиындыққа тап болды.
Dialogue: 0,0:08:44.27,0:08:49.11,Default,,0,0,0,,Жарайды, мен қазір форма таратып, киімдерді жаттықтырамын, ендеше алдымен жатақханаға кір.
Dialogue: 0,0:08:49.27,0:08:49.82,Default,,0,0,0,,Эх!
Dialogue: 0,0:08:50.11,0:08:53.65,Default,,0,0,0,,Ю...формалар!? Оларды беру!? Мұнда және қазір!?
Dialogue: 0,0:08:53.82,0:08:54.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:55.07,0:08:57.32,Default,,0,0,0,,Жоқ, мұндай нәрсе қалыпты болады⸺
Dialogue: 0,0:08:57.41,0:08:58.91,Default,,0,0,0,,Мен бірінші рет алып отырмын...
Dialogue: 0,0:08:58.99,0:09:02.29,Default,,0,0,0,,Аа, егер солай болса, ақшаны алуым керек...
Dialogue: 0,0:09:02.87,0:09:05.96,Default,,0,0,0,,Барлығына форма және жаттығу киімдері беріледі.
Dialogue: 0,0:09:06.12,0:09:07.17,Default,,0,0,0,,Таңертең тазалау⸺
Dialogue: 0,0:09:07.25,0:09:09.84,Default,,0,0,0,,Бөлмеңіздің алдына қалдырсаңыз, жатақхана қызметкерлері мұны сізге жасайды.
Dialogue: 0,0:09:11.38,0:09:13.30,Default,,0,0,0,,Тіпті жыртылып қалса немесе өлшемі өзгерсе де⸺
Dialogue: 0,0:09:13.38,0:09:15.05,Default,,0,0,0,,Біз оны тегін ауыстырамыз.
Dialogue: 0,0:09:16.05,0:09:17.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:19.35,0:09:23.06,Default,,0,0,0,,Аои-кун әлі келген жоқ. Скаут студентімен бірге бөлмедесіз.
Dialogue: 0,0:09:23.52,0:09:25.69,Default,,0,0,0,,Оның да формасын әкеліңіз.
Dialogue: 0,0:09:26.89,0:09:27.85,Default,,0,0,0,,Сондай-ақ...
Dialogue: 0,0:09:30.94,0:09:34.86,Default,,0,0,0,,Спортшылар жатақханасын бастапқыда жоғарғы команда пайдаланған және оны басып алған⸺
Dialogue: 0,0:09:34.99,0:09:36.36,Default,,0,0,0,,J leaguer техникалық сипаттамалары
Dialogue: 0,0:09:36.86,0:09:39.28,Default,,0,0,0,,Асхана, сондай-ақ мәжіліс залы
Dialogue: 0,0:09:39.66,0:09:42.03,Default,,0,0,0,,Үлкен оқу бөлмесі де бар.
Dialogue: 0,0:09:42.49,0:09:44.87,Default,,0,0,0,,Енді жатақхана ақысы айына 5000 иен!
Dialogue: 0,0:09:45.20,0:09:46.66,Default,,0,0,0,,Мен сонда тұрғым келеді
Dialogue: 0,0:10:04.10,0:10:05.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:11.86,0:10:13.90,Default,,0,0,0,,Мен сене алар емеспін
Dialogue: 0,0:10:15.28,0:10:20.16,Default,,0,0,0,,Әзірге... Әзірге Футболға көңіл бөлуге болатын орта!
Dialogue: 0,0:10:33.13,0:10:34.46,Default,,0,0,0,,Олай болса суретке түсейік
Dialogue: 0,0:10:35.50,0:10:37.63,Default,,0,0,0,,Аты-жөніңізді және бірыңғай нөміріңізді көңілді түрде жазыңыз
Dialogue: 0,0:10:37.97,0:10:39.13,Default,,0,0,0,,Ашито Аои!
Dialogue: 0,0:10:39.43,0:10:43.14,Default,,0,0,0,,Токио қаласы Эсперион жастары! Бірыңғай №33!
Dialogue: 0,0:10:43.35,0:10:44.22,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:10:44.47,0:10:48.43,Default,,0,0,0,,Не... Неге кенет оқ жаудырдық? Мен қатты қобалжыдым.
Dialogue: 0,0:10:48.73,0:10:50.64,Default,,0,0,0,,Сіз кестені көрмедіңіз бе?
Dialogue: 0,0:10:50.73,0:10:52.65,Default,,0,0,0,,Ресми кітапқа түсіру.
Dialogue: 0,0:10:53.19,0:10:54.36,Default,,0,0,0,,Мен бұл үшінмін⸺
Dialogue: 0,0:10:54.44,0:10:57.03,Default,,0,0,0,,Бүгін таңғы 6-дан бері шашымды жинап жатырмын.
Dialogue: 0,0:10:57.74,0:10:59.74,Default,,0,0,0,,Бұл өткен жылғы, қараңыз.
Dialogue: 0,0:11:00.03,0:11:03.66,Default,,0,0,0,,Бұл J.League клубтары жанкүйерлері үшін жыл сайын шығаратын кітап.
Dialogue: 0,0:11:04.78,0:11:08.29,Default,,0,0,0,,Біздің даму жасындағы ойыншыларды фотосуреттермен бірге орналастыруға болады.
Dialogue: 0,0:11:08.58,0:11:10.12,Default,,0,0,0,,Оны анаңызға жіберіңіз.
Dialogue: 0,0:11:10.83,0:11:13.46,Default,,0,0,0,,Ойланып қарашы, сенің бірге тұратын жолдасың қандай адам?
Dialogue: 0,0:11:14.04,0:11:15.92,Default,,0,0,0,,Сіз биылғы жалғыз барлаушысыз, солай ма?
Dialogue: 0,0:11:16.71,0:11:18.92,Default,,0,0,0,,Жоқ, ол келген жоқ.
Dialogue: 0,0:11:19.09,0:11:19.97,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:11:20.05,0:11:22.55,Default,,0,0,0,,Бұл оның әлі келмегенін білдіре ме?
Dialogue: 0,0:11:23.05,0:11:24.64,Default,,0,0,0,,Оның аты Тоғашы.
Dialogue: 0,0:11:24.80,0:11:26.72,Default,,0,0,0,,Мен шынымен кешігіп қалдым, бірақ бәрі жақсы деп ойлаймын.
Dialogue: 0,0:11:27.14,0:11:28.56,Default,,0,0,0,,Отомо Аои
Dialogue: 0,0:11:29.89,0:11:32.69,Default,,0,0,0,,Менімен бір бөлмеде тұратын Куроданы таныстыру.
Dialogue: 0,0:11:33.35,0:11:34.77,Default,,0,0,0,,А, сәлем~
Dialogue: 0,0:11:34.94,0:11:38.32,Default,,0,0,0,,Бұл кіші жастан көтерілген Канпей Курода.
Dialogue: 0,0:11:38.94,0:11:41.90,Default,,0,0,0,,Биылғы іріктеуден 3 адам өте ме?
Dialogue: 0,0:11:42.41,0:11:43.86,Default,,0,0,0,,Әдеттегіден көп
Dialogue: 0,0:11:44.57,0:11:46.41,Default,,0,0,0,,Бізде тоғыз студент бар.
Dialogue: 0,0:11:46.83,0:11:49.08,Default,,0,0,0,,Әдеттегіден азырақ сияқты.
Dialogue: 0,0:11:50.08,0:11:53.00,Default,,0,0,0,,Ах... мен Ашито Аоимын. Мен Эхимеденмін.
Dialogue: 0,0:11:53.17,0:11:54.08,Default,,0,0,0,,Эхиме?
Dialogue: 0,0:11:54.75,0:11:57.25,Default,,0,0,0,,Мен жай ғана бірдеңе айтқым келеді.
Dialogue: 0,0:11:57.92,0:12:00.84,Default,,0,0,0,,Жоғары көтерілген оқушылар бір-біріне тым жақын.
Dialogue: 0,0:12:01.47,0:12:05.26,Default,,0,0,0,,Біз орта мектептен бері доспыз, сондықтан мен сіздің сезіміңізді түсінемін.
Dialogue: 0,0:12:05.34,0:12:08.06,Default,,0,0,0,,Уақытты делдал ететін кем дегенде бір адам.
Dialogue: 0,0:12:08.14,0:12:09.14,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:12:09.22,0:12:12.48,Default,,0,0,0,,Ахаха, мұндайды ұнатпайтындар көп.
Dialogue: 0,0:12:12.94,0:12:14.73,Default,,0,0,0,,Мен мұны істейтін болсам, бұл Юма болар еді.
Dialogue: 0,0:12:15.10,0:12:17.73,Default,,0,0,0,,Ол көңіл-күй жасаушы және оның шеберлігі керемет.
Dialogue: 0,0:12:18.52,0:12:22.40,Default,,0,0,0,,Такешима - Юманың ең жақын досы. Менің ойымша, ол әлі сөйлейді.
Dialogue: 0,0:12:22.90,0:12:24.91,Default,,0,0,0,,Асариге жақындау өте қиын.
Dialogue: 0,0:12:24.99,0:12:26.74,Default,,0,0,0,,Әлгі бейбақ!
Dialogue: 0,0:12:27.12,0:12:29.58,Default,,0,0,0,,Барлық жоғарылатылған студенттер тыныш.
Dialogue: 0,0:12:29.91,0:12:32.50,Default,,0,0,0,,Менің ойымша, бәрі аздап қобалжыды.
Dialogue: 0,0:12:32.58,0:12:33.25,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:34.04,0:12:34.92,Default,,0,0,0,,Жүйке?
Dialogue: 0,0:12:35.79,0:12:39.25,Default,,0,0,0,,Бүгін біздің бір арманымыз орындалады.
Dialogue: 0,0:12:40.34,0:12:41.26,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,0:12:43.84,0:12:44.76,Default,,0,0,0,,Биылғы⸺
Dialogue: 0,0:12:44.88,0:12:48.26,Default,,0,0,0,,Tokyo City Esperion Youth 13 адам қосылды
Dialogue: 0,0:12:49.18,0:12:52.02,Default,,0,0,0,,Ең алдымен, үйірмеге аман-есен қосылу мүмкіндігіңізбен құттықтаймыз.
Dialogue: 0,0:12:53.06,0:12:55.64,Default,,0,0,0,,Мен Аки Цукишима, жастар командасының жаттықтырушысымын.
Dialogue: 0,0:12:56.27,0:12:58.61,Default,,0,0,0,,Мен де Esperion Youth тобынанмын, сондықтан⸺
Dialogue: 0,0:12:58.98,0:13:01.65,Default,,0,0,0,,Егер сіз бірдеңе түсінбесеңіз, менен бірдеңе сұраңыз.
Dialogue: 0,0:13:03.15,0:13:04.70,Default,,0,0,0,,Менің арманым орындалды⸺
Dialogue: 0,0:13:04.99,0:13:08.12,Default,,0,0,0,,Жастыққа көтерілдім деген сөз ғой.
Dialogue: 0,0:13:09.37,0:13:12.58,Default,,0,0,0,,Кіші жастан жастарға дейін көтерілу де іріктеу жүйесіне негізделген.
Dialogue: 0,0:13:12.91,0:13:16.79,Default,,0,0,0,,Фукуданың ағасы да өткен жылы салмағының жартысынан көбін жоғалтқанын айтты.
Dialogue: 0,0:13:17.75,0:13:20.29,Default,,0,0,0,,Менің ойымша, сіз таңғажайып байқауда жеңіске жеттіңіз...
Dialogue: 0,0:13:21.38,0:13:23.21,Default,,0,0,0,,Біздің мақсатымыз – кәсіби маман болу.
Dialogue: 0,0:13:24.01,0:13:26.30,Default,,0,0,0,,Әлі ешбір арман орындалған жоқ.
Dialogue: 0,0:13:26.97,0:13:29.09,Default,,0,0,0,,Кіші жастан келген жігіт⸺
Dialogue: 0,0:13:29.26,0:13:30.89,Default,,0,0,0,,Сонымен не істеуіміз керек?
Dialogue: 0,0:13:32.52,0:13:34.93,Default,,0,0,0,,Қақпашылардың жаттықтырушысы Бензен Дайго
Dialogue: 0,0:13:35.18,0:13:37.44,Default,,0,0,0,,Менен позицияңызға қарамастан кез келген нәрсені сұраңыз.
Dialogue: 0,0:13:38.10,0:13:39.06,Default,,0,0,0,,Ал маман болған кезде...
Dialogue: 0,0:13:39.15,0:13:40.94,Default,,0,0,0,,Іріктеу кезінде мен де солай ойладым⸺
Dialogue: 0,0:13:41.32,0:13:42.82,Default,,0,0,0,,Бұл екеуі мейірімді көрінеді.
Dialogue: 0,0:13:43.40,0:13:44.82,Default,,0,0,0,,Сіз не туралы айтып отырсыз? (Ата-ана) Ахах
Dialogue: 0,0:13:45.78,0:13:48.16,Default,,0,0,0,,Нозоми Дате бас бапкер.
Dialogue: 0,0:13:48.70,0:13:49.82,Default,,0,0,0,,Барлығы осында⸺
Dialogue: 0,0:13:49.99,0:13:53.20,Default,,0,0,0,,Біріншіден, сізде менімен бетпе-бет кездесу мүмкіндігі көбірек болады деп ойлаймын.
Dialogue: 0,0:13:53.49,0:13:55.58,Default,,0,0,0,,Өйткені В тобы...
Dialogue: 0,0:13:56.08,0:13:59.04,Default,,0,0,0,,Өйткені мен екінші армия деп аталатын әскердің қолбасшысымын.
Dialogue: 0,0:13:59.46,0:14:02.71,Default,,0,0,0,,1-ші армия/2-ші армия жүйесі Солай ма?
Dialogue: 0,0:14:03.38,0:14:06.72,Default,,0,0,0,,Жастар - қуатты орта мектептермен салыстырғанда элитаның аз саны
Dialogue: 0,0:14:06.97,0:14:10.09,Default,,0,0,0,,Бірақ үш сыныпта да 40 оқушы бар.
Dialogue: 0,0:14:10.59,0:14:14.52,Default,,0,0,0,,Бұл бірінші армияның ресми шайқастарына аз ғана адам қатыса алады дегенді білдіре ме?
Dialogue: 0,0:14:15.06,0:14:17.02,Default,,0,0,0,,В тобында нәтижеге жеткендер ғана...
Dialogue: 0,0:14:17.10,0:14:18.56,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:14:18.73,0:14:21.23,Default,,0,0,0,,Аа, кешіріңіз, мен кешігіп қалдым.
Dialogue: 0,0:14:21.65,0:14:25.44,Default,,0,0,0,,Ол өзі тікелей басқаратын А командасына көтерілуі мүмкін.
Dialogue: 0,0:14:27.32,0:14:29.24,Default,,0,0,0,,Иә? Курода?
Dialogue: 0,0:14:32.49,0:14:33.41,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:14:38.66,0:14:41.96,Default,,0,0,0,,Жастар құрамасының жаттықтырушысы Тацуя Фукуда.
Dialogue: 0,0:14:43.21,0:14:44.34,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:14:46.92,0:14:47.63,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:48.05,0:14:51.18,Default,,0,0,0,,Дүниеге... Мен сені сонда апарамын
Dialogue: 0,0:14:53.14,0:14:53.97,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:54.72,0:14:55.56,Default,,0,0,0,,Иә
Dialogue: 0,0:14:55.81,0:14:57.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:57.31,0:14:58.68,Default,,0,0,0,,Жоқ, не?
Dialogue: 0,0:15:03.48,0:15:05.44,Default,,0,0,0,,Маған жібергеніңіз үшін рахмет!
Dialogue: 0,0:15:09.74,0:15:12.57,Default,,0,0,0,,Мен ағаларымды ешқашан ұмытпаймын!
Dialogue: 0,0:15:13.57,0:15:16.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:16.95,0:15:20.25,Default,,0,0,0,,Кейджи Тогаши! Позиция орталық қорғаушы!
Dialogue: 0,0:15:20.75,0:15:24.29,Default,,0,0,0,,О, енді мен осындамын, сен өзіңді қауіпсіз сезінесің!
Dialogue: 0,0:15:24.59,0:15:27.30,Default,,0,0,0,,Бұл команда ~!
Dialogue: 0,0:15:27.88,0:15:30.76,Default,,0,0,0,,Тоқтай тұрыңыз, бұл бала да жас студент пе?
Dialogue: 0,0:15:31.01,0:15:32.80,Default,,0,0,0,,Сіз баланы осылай іздедіңіз⸺
Dialogue: 0,0:15:32.93,0:15:34.26,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:15:34.93,0:15:37.72,Default,,0,0,0,,Тоғаши: Байкерлермен байланысты үземіз бе?
Dialogue: 0,0:15:37.81,0:15:40.77,Default,,0,0,0,,Мен сізге футболды тастаңыз немесе біреуін таңдаңыз деп айтуым керек еді.
Dialogue: 0,0:15:41.23,0:15:42.69,Default,,0,0,0,,(Мұрынды шұқылау дыбысы)
Dialogue: 0,0:15:43.52,0:15:45.06,Default,,0,0,0,,Мен оны маған жібердім.
Dialogue: 0,0:15:45.23,0:15:48.15,Default,,0,0,0,,Уау... міне, ақылсыз параметрлері бар жігіт келді!
Dialogue: 0,0:15:48.90,0:15:50.40,Default,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,0:15:51.45,0:15:54.16,Default,,0,0,0,,Бұл биылғы жалғыз скаут студенті ме?
Dialogue: 0,0:15:55.49,0:15:56.37,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:15:57.58,0:16:00.33,Default,,0,0,0,,Бұл Ашито Аои, жатақханадағы менің бірге тұратын құрбым. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:16:01.41,0:16:03.12,Default,,0,0,0,,Мен саған форма әкелдім.
Dialogue: 0,0:16:04.12,0:16:07.38,Default,,0,0,0,,Ендеше, сөз кезегі Фукуданың ағасына келді.
Dialogue: 0,0:16:07.63,0:16:09.09,Default,,0,0,0,,Себебі мен оны дұрыс естігім келеді⸺
Dialogue: 0,0:16:09.46,0:16:11.92,Default,,0,0,0,,Мынаны киіп отырасың ба?
Dialogue: 0,0:16:15.72,0:16:18.85,Default,,0,0,0,,Сіз жоғарылатылған кіші жастар студентісіз бе?
Dialogue: 0,0:16:19.35,0:16:22.77,Default,,0,0,0,,Жоқ, мен іріктеуден өттім.
Dialogue: 0,0:16:23.98,0:16:25.69,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:16:26.90,0:16:28.82,Default,,0,0,0,,Бірыңғай киім Жолыңыздан шыққаныңызға рахмет
Dialogue: 0,0:16:29.02,0:16:32.44,Default,,0,0,0,,Бұл Кейдзи Тогаши. Бөлмені менімен бөлісіңіз. Аой.
Dialogue: 0,0:16:32.65,0:16:34.45,Default,,0,0,0,,О, Ашито жақсы.
Dialogue: 0,0:16:34.95,0:16:37.91,Default,,0,0,0,,Ол аздап итермелейді, бірақ ол жақсы жігіт емес пе?
Dialogue: 0,0:16:39.33,0:16:40.16,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:40.95,0:16:42.16,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:16:43.08,0:16:46.67,Default,,0,0,0,,Ол жоғарылатылған студент болмаса, бұл жақсы сияқты болды, бірақ...
Dialogue: 0,0:16:47.25,0:16:48.42,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:16:49.21,0:16:51.96,Default,,0,0,0,,Аои-кун, онымен абай бол.
Dialogue: 0,0:16:52.13,0:16:52.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:53.38,0:16:54.47,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:55.47,0:16:58.64,Default,,0,0,0,,Қалай болғанда да, оған назар аудармаған дұрыс.
Dialogue: 0,0:16:59.81,0:17:00.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:01.22,0:17:03.23,Default,,0,0,0,,Жарай ма деп ойлаймын~
Dialogue: 0,0:17:05.48,0:17:08.73,Default,,0,0,0,,Директор Фукуда оқыту саласында⸺
Dialogue: 0,0:17:08.90,0:17:11.36,Default,,0,0,0,,Ол беделі жоғары адам.
Dialogue: 0,0:17:12.03,0:17:12.99,Default,,0,0,0,,Үміт…
Dialogue: 0,0:17:15.07,0:17:16.70,Default,,0,0,0,,Оның беделін тыңдаңыз⸺
Dialogue: 0,0:17:16.82,0:17:19.20,Default,,0,0,0,,Мен директор Фукудадан үйренгім келеді⸺
Dialogue: 0,0:17:20.08,0:17:23.08,Default,,0,0,0,,Көптеген ұлдар осылай ойлайды және Эсперионды көздейді.
Dialogue: 0,0:17:23.87,0:17:25.83,Default,,0,0,0,,Фукуда үнемі айтатындай⸺
Dialogue: 0,0:17:26.37,0:17:28.67,Default,,0,0,0,,Маған қалағанымды жасай алатын ойыншылар керек емес.
Dialogue: 0,0:17:29.33,0:17:30.50,Default,,0,0,0,,Дүниеге қалай шығуға болады⸺
Dialogue: 0,0:17:30.59,0:17:33.84,Default,,0,0,0,,Маған қиялымнан оңай асып түсетін ойыншы керек.
Dialogue: 0,0:17:34.51,0:17:36.01,Default,,0,0,0,,Сондықтан
Dialogue: 0,0:17:36.26,0:17:39.18,Default,,0,0,0,,Фукуда міндетті түрде тікелей сөйлесетін ойыншылар⸺
Dialogue: 0,0:17:39.60,0:17:42.47,Default,,0,0,0,,Оңай болмайды, бөтен адамдар көп болады
Dialogue: 0,0:17:43.39,0:17:47.52,Default,,0,0,0,,Бірақ мұндай ойыншылар жастар мен бірінші командаларда ойнайтындар⸺
Dialogue: 0,0:17:47.60,0:17:51.36,Default,,0,0,0,,Балалардың айналасындағыларды басқаратын тамаша ойыншы болып өсетініне көптеген мысалдар келтіруге болады.
Dialogue: 0,0:17:51.73,0:17:54.03,Default,,0,0,0,,Мен Фукуданың әдісін көп жылдар бойы бақылап келемін⸺
Dialogue: 0,0:17:54.15,0:17:55.90,Default,,0,0,0,,Мен сезінемін
Dialogue: 0,0:17:56.61,0:17:58.99,Default,,0,0,0,,Тәрбиелеу – парасаттылыққа байланбау.
Dialogue: 0,0:17:59.66,0:18:02.66,Default,,0,0,0,,Ал бізге өте ұзақ мерзімді перспектива қажет.
Dialogue: 0,0:18:03.91,0:18:06.16,Default,,0,0,0,,Келіңіз, директор Фукуда, өтінемін.
Dialogue: 0,0:18:06.96,0:18:08.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:09.33,0:18:10.83,Default,,0,0,0,,Е...
Dialogue: 0,0:18:11.96,0:18:14.09,Default,,0,0,0,,Жарайды, Кохаку матчын ойнайық.
Dialogue: 0,0:18:15.09,0:18:17.05,Default,,0,0,0,,Не? (Фукуда) Тек жаңа мүшелер
Dialogue: 0,0:18:25.06,0:18:27.60,Default,,0,0,0,,А? Эй, сен не істеп жатырсың?
Dialogue: 0,0:18:28.81,0:18:29.56,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:18:29.94,0:18:31.15,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:31.31,0:18:33.65,Default,,0,0,0,,Мен сені ең ынталы деп ойладым.
Dialogue: 0,0:18:33.90,0:18:36.07,Default,,0,0,0,,Жоқ, мен жай ғана назар аударғым келеді.
Dialogue: 0,0:18:36.24,0:18:37.90,Default,,0,0,0,,Мен жалғыз қаламын деп ойладым
Dialogue: 0,0:18:38.40,0:18:40.66,Default,,0,0,0,,Директор Фукуда соңында айтты.
Dialogue: 0,0:18:41.16,0:18:44.62,Default,,0,0,0,,Осы «Қызыл және ақ» матчында жақсы нәтиже көрсете алсаңыз, сіз А командасына көтерілесіз.
Dialogue: 0,0:18:45.24,0:18:47.12,Default,,0,0,0,,Мұқият қыздырыңыз
Dialogue: 0,0:18:47.58,0:18:49.96,Default,,0,0,0,,Жердегілердің бәрі дірілдеп жатыр.
Dialogue: 0,0:18:50.21,0:18:52.54,Default,,0,0,0,,Ойынға берілгендікті сезінесіз.
Dialogue: 0,0:18:54.00,0:18:54.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:55.17,0:18:58.34,Default,,0,0,0,,Сондай-ақ соңғы минутқа дейін демалудың реттеу әдісі бар.
Dialogue: 0,0:18:58.84,0:19:00.59,Default,,0,0,0,,Әйтеуір, қолымыздан келгеннің бәрін бірге жасайық.
Dialogue: 0,0:19:06.97,0:19:09.94,Default,,0,0,0,,Ағай~ мен саған бенто әкелдім~
Dialogue: 0,0:19:10.31,0:19:12.27,Default,,0,0,0,,О? Не айтқың келеді?
Dialogue: 0,0:19:12.98,0:19:15.52,Default,,0,0,0,,Ах... не...
Dialogue: 0,0:19:15.82,0:19:19.40,Default,,0,0,0,,Бауырым, мен саған бенто жасап бер дедім ғой!
Dialogue: 0,0:19:19.49,0:19:21.49,Default,,0,0,0,,О... Әй?
Dialogue: 0,0:19:22.61,0:19:23.62,Default,,0,0,0,,Мен мұны айттым ба?
Dialogue: 0,0:19:23.74,0:19:26.24,Default,,0,0,0,,Мынау таңертең жөнделді.
Dialogue: 0,0:19:26.49,0:19:29.41,Default,,0,0,0,,Мен мұны қалай ерте ояндым деп ойлаймын!
Dialogue: 0,0:19:29.83,0:19:33.17,Default,,0,0,0,,Ахаха кешірші гүл
Dialogue: 0,0:19:33.33,0:19:36.55,Default,,0,0,0,,Мен оны жаңа мүшемен асханада жедім.
Dialogue: 0,0:19:37.63,0:19:39.17,Default,,0,0,0,,Алдымен кешірім сұраңыз
Dialogue: 0,0:19:39.51,0:19:43.43,Default,,0,0,0,,Сол үшін әйел алып, осы жасқа дейін тұра алмайсың, ақымақ!
Dialogue: 0,0:19:43.84,0:19:45.64,Default,,0,0,0,,Кешіріңіз, Хана Чан
Dialogue: 0,0:19:46.01,0:19:49.47,Default,,0,0,0,,Бастапқыда мен Фукудадан сізге қоңырау шалуын өтіндім.
Dialogue: 0,0:19:50.23,0:19:53.52,Default,,0,0,0,,Кайдо Денкидің жас ханымы бүгін бізге қонаққа келеді⸺
Dialogue: 0,0:19:53.85,0:19:56.40,Default,,0,0,0,,Менімен сөйлескеніңізді қалаймын.
Dialogue: 0,0:19:56.57,0:19:59.40,Default,,0,0,0,,Иә~ ол қыз маған ұнамайды.
Dialogue: 0,0:19:59.48,0:20:02.11,Default,,0,0,0,,Өтінемін, біз құрдас емеспіз бе?
Dialogue: 0,0:20:02.49,0:20:04.70,Default,,0,0,0,,Өйткені, бұл бас компания.
Dialogue: 0,0:20:04.87,0:20:07.20,Default,,0,0,0,,Әй, болды, Хана, мені тыңда.
Dialogue: 0,0:20:07.95,0:20:11.21,Default,,0,0,0,,Нозоми бұрын индукция рәсімінде мені мақтады.
Dialogue: 0,0:20:11.87,0:20:14.04,Default,,0,0,0,,Бұл сирек болады.
Dialogue: 0,0:20:14.37,0:20:17.29,Default,,0,0,0,,Мен жай ғана ата-ана түсінсін деп түсіндірдім.
Dialogue: 0,0:20:17.88,0:20:20.13,Default,,0,0,0,,Флирт жасамау~
Dialogue: 0,0:20:20.46,0:20:24.30,Default,,0,0,0,,Мен кенеттен Коухаку матчын көріп таң қалдым.
Dialogue: 0,0:20:24.51,0:20:25.47,Default,,0,0,0,,Кохаку Сен?
Dialogue: 0,0:20:25.68,0:20:27.05,Default,,0,0,0,,Сабарудың арқасында болар.
Dialogue: 0,0:20:27.22,0:20:28.51,Default,,0,0,0,,Егер мен керемет жұмыс істей алсам⸺
Dialogue: 0,0:20:28.60,0:20:30.64,Default,,0,0,0,,А командасынан ертең қатысуын сұраңыз!
Dialogue: 0,0:20:30.72,0:20:33.56,Default,,0,0,0,,Осыны айтқанда барлығының көздерінің түсі өзгеріп кетті.
Dialogue: 0,0:20:33.94,0:20:35.35,Default,,0,0,0,,әкемнің айтатынындай.
Dialogue: 0,0:20:36.06,0:20:39.90,Default,,0,0,0,,Мен командаға да, ортаға да үйренбегенмін, кенет матч болып қалды.
Dialogue: 0,0:20:40.65,0:20:41.99,Default,,0,0,0,,Биылғы студенттер⸺
Dialogue: 0,0:20:42.40,0:20:44.74,Default,,0,0,0,,Дос болу үшін біраз уақыт қажет болуы мүмкін.
Dialogue: 0,0:20:46.45,0:20:49.12,Default,,0,0,0,,Онда біз тез футбол ойнауымыз керек.
Dialogue: 0,0:20:49.95,0:20:51.79,Default,,0,0,0,,Бұдан әрі өзін-өзі таныстыруға болмайды
Dialogue: 0,0:20:52.50,0:20:53.12,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:53.21,0:20:56.04,Default,,0,0,0,,Бұл дұрыс болуы мүмкін.
Dialogue: 0,0:20:58.71,0:20:59.38,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:59.96,0:21:01.80,Default,,0,0,0,,Мен шығамын, аға.
Dialogue: 0,0:21:02.21,0:21:04.17,Default,,0,0,0,,Оны өзің же (Фукуда) Иә?
Dialogue: 0,0:21:04.63,0:21:06.80,Default,,0,0,0,,Танысқанымызға көп уақыт болды.
Dialogue: 0,0:21:06.97,0:21:10.14,Default,,0,0,0,,Енді оны қойып, футбол туралы сөйлесейік, иә?
Dialogue: 0,0:21:10.72,0:21:13.89,Default,,0,0,0,,Әй, аға, анда-санда үйге келіп тұру керек.
Dialogue: 0,0:21:13.98,0:21:15.73,Default,,0,0,0,,Келу қиын екенін білемін.
Dialogue: 0,0:21:16.10,0:21:18.23,Default,,0,0,0,,Мен сені сағындым, ене.
Dialogue: 0,0:21:19.40,0:21:20.32,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:21:21.78,0:21:22.90,Default,,0,0,0,,Дұрыс, Фукуда.
Dialogue: 0,0:21:23.94,0:21:25.95,Default,,0,0,0,,Мен бір нәрсені растағым келеді.
Dialogue: 0,0:21:26.70,0:21:31.16,Default,,0,0,0,,Мен сіз Эхимеден әкелген Ашито Аои деген бала туралы айтып отырмын.
Dialogue: 0,0:21:31.54,0:21:32.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:33.62,0:21:37.04,Default,,0,0,0,,Сіз мұны істеуге ерекше қызығушылық танытпайсыз.
Dialogue: 0,0:21:37.50,0:21:38.88,Default,,0,0,0,,А? Амал жоқ
Dialogue: 0,0:21:39.13,0:21:42.55,Default,,0,0,0,,Менің ондай істерге қабілетсіз екенімді білесіз.
Dialogue: 0,0:21:43.05,0:21:43.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:44.88,0:21:46.59,Default,,0,0,0,,Олай болса, анық айтайын.
Dialogue: 0,0:21:47.88,0:21:50.60,Default,,0,0,0,,Мен бұған іріктеуден бері көзім жетті...
Dialogue: 0,0:21:51.64,0:21:53.93,Default,,0,0,0,,Ғажайып өсу болмаса⸺
Dialogue: 0,0:21:54.77,0:21:56.31,Default,,0,0,0,,Баланың кәсіпқой болуы мүмкін емес.
Dialogue: 0,0:21:57.10,0:21:57.77,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:58.52,0:22:02.19,Default,,0,0,0,,Менің қара көзім 3 жыл болды⸺
Dialogue: 0,0:22:03.11,0:22:05.74,Default,,0,0,0,,Сіз бір рет болса да А тобына көтеріле алмайсыз.
Dialogue: 0,0:22:07.15,0:22:10.62,Default,,0,0,0,,Бұл Фукуданың бірінші сәтсіз мысалы болуы мүмкін
Dialogue: 0,0:22:11.12,0:22:13.29,Default,,0,0,0,,О! (Фукуда) Уау, мен таң қалдым!
Dialogue: 0,0:22:15.37,0:22:16.29,Default,,0,0,0,,Бұл күтпеген жағдай.
Dialogue: 0,0:22:18.67,0:22:21.08,Default,,0,0,0,,Ааа, командаға бүгін қосылған ойыншыға⸺
Dialogue: 0,0:22:21.17,0:22:24.17,Default,,0,0,0,,Менің ойымша, мұндай сөздерді айту жақсы емес.
Dialogue: 0,0:22:26.42,0:22:30.05,Default,,0,0,0,,Сонымен қатар мен Ашито Аоидың жанкүйерімін.
Dialogue: 0,0:22:30.26,0:22:32.10,Default,,0,0,0,,Дүниедегі бірінші шығар!
Dialogue: 0,0:22:32.76,0:22:33.68,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:36.02,0:22:42.02,Default,,0,0,0,,♪～
Dialogue: 0,0:23:59.89,0:24:05.90,Default,,0,0,0,,～♪
Dialogue: 0,0:24:24.58,0:24:26.21,Default,,0,0,0,,Келесі жолы «Аоаши»
Dialogue: 0,0:24:26.38,0:24:27.54,Default,,0,0,0,,«Жастардың бірінші командасы»
Dialogue: 0,0:24:29.04,0:24:35.04,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory