Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.08,0:00:04.92,Default,,0,0,0,,Ешкім...
Dialogue: 0,0:00:07.17,0:00:08.42,Default,,0,0,0,,Маған рұқсат беріңіз⸺
Dialogue: 0,0:00:09.67,0:00:11.01,Default,,0,0,0,,Енді шығарылмайды
Dialogue: 0,0:00:12.17,0:00:15.14,Default,,0,0,0,,Сол екінші балаға жаным ашиды.
Dialogue: 0,0:00:16.05,0:00:19.56,Default,,0,0,0,,Барлығы сол баланы елемей, футбол ойнайды.
Dialogue: 0,0:00:20.31,0:00:21.77,Default,,0,0,0,,Бұл дұрыс шешім.
Dialogue: 0,0:00:22.39,0:00:23.85,Default,,0,0,0,,Аои туралы жеткілікті
Dialogue: 0,0:00:25.15,0:00:27.11,Default,,0,0,0,,Аои-кун (Ашито) Ах...
Dialogue: 0,0:00:27.69,0:00:29.19,Default,,0,0,0,,Жақсы (Ашито) Иә?
Dialogue: 0,0:00:30.03,0:00:32.24,Default,,0,0,0,,Таңдауда сізді таң қалдырған пьеса
Dialogue: 0,0:00:33.24,0:00:36.32,Default,,0,0,0,,Мен өзімді кешіре алмай, өзіме сұрақ қоя бердім.
Dialogue: 0,0:00:37.53,0:00:38.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:39.33,0:00:42.95,Default,,0,0,0,,Бірақ сіз жай ғана кездейсоқ болдыңыз. Бұл үлкен мәселе емес.
Dialogue: 0,0:00:44.33,0:00:45.83,Default,,0,0,0,,Тағы да рахмет
Dialogue: 0,0:00:46.50,0:00:48.96,Default,,0,0,0,,Атсуши Асари Мартис
Dialogue: 0,0:00:50.00,0:00:51.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:52.51,0:00:54.38,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:00:56.05,0:01:02.06,Default,,0,0,0,,♪～
Dialogue: 0,0:02:19.93,0:02:25.93,Default,,0,0,0,,～♪
Dialogue: 0,0:02:27.43,0:02:29.02,Default,,0,0,0,,Атсуши Асари Мартис
Dialogue: 0,0:02:29.85,0:02:32.48,Default,,0,0,0,,Допқа қатты үйір болғандықтан⸺
Dialogue: 0,0:02:32.73,0:02:35.65,Default,,0,0,0,,Ол өзінің жеке тактикасын жыл бойы зерттейтін адам.
Dialogue: 0,0:02:37.99,0:02:41.20,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:02:41.99,0:02:43.66,Default,,0,0,0,,Бұл психологиялық шабуыл ма? Әлде қудалау ма!
Dialogue: 0,0:02:44.08,0:02:45.12,Default,,0,0,0,,Бәрің, тұрыңдар!
Dialogue: 0,0:02:45.95,0:02:49.75,Default,,0,0,0,,Сәйкестік осы жағдайда аяқталуы мүмкін бе?
Dialogue: 0,0:02:50.04,0:02:51.21,Default,,0,0,0,,Юма Осы жолмен!
Dialogue: 0,0:02:51.50,0:02:54.71,Default,,0,0,0,,Ашито Саған, жеткілікті! Сол жерде қал!
Dialogue: 0,0:02:55.09,0:02:56.21,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:57.09,0:02:58.26,Default,,0,0,0,,Бірақ бәрібір⸺
Dialogue: 0,0:02:59.22,0:03:01.80,Default,,0,0,0,,Деңгейі ерекше жоғары бір ғана адам бар, ол да сол.
Dialogue: 0,0:03:01.93,0:03:02.47,Default,,0,0,0,,Иә
Dialogue: 0,0:03:03.47,0:03:04.43,Default,,0,0,0,,Юма...
Dialogue: 0,0:03:05.10,0:03:08.22,Default,,0,0,0,,Хахахаха... Камеяма, жүр!
Dialogue: 0,0:03:09.93,0:03:11.64,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:03:12.02,0:03:13.40,Default,,0,0,0,,Е... Юма-кун!
Dialogue: 0,0:03:13.48,0:03:15.32,Default,,0,0,0,,Бұл мақсат емес пе?
Dialogue: 0,0:03:15.44,0:03:17.78,Default,,0,0,0,,Ол ертеңгі бағытқа дриблинг жасап жатыр!
Dialogue: 0,0:03:18.36,0:03:19.28,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:19.61,0:03:21.95,Default,,0,0,0,,Жаудың қорғаушысы Такешиманы шығару
Dialogue: 0,0:03:22.82,0:03:23.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:25.87,0:03:26.58,Default,,0,0,0,,Курода!
Dialogue: 0,0:03:26.74,0:03:27.79,Default,,0,0,0,,Мені жіберіңізші!
Dialogue: 0,0:03:29.25,0:03:33.67,Default,,0,0,0,,«Тікелей Куродаға қарама-қарсы жақта» Юма!
Dialogue: 0,0:03:34.92,0:03:36.50,Default,,0,0,0,,Әй... (Тоғашы) Фуфууу...
Dialogue: 0,0:03:36.92,0:03:37.75,Default,,0,0,0,,Тоғашы…
Dialogue: 0,0:03:37.96,0:03:39.55,Default,,0,0,0,,Неліктен? Тогаши
Dialogue: 0,0:03:40.05,0:03:41.05,Default,,0,0,0,,Бәрің, тұрыңдар!
Dialogue: 0,0:03:41.22,0:03:43.34,Default,,0,0,0,,Сіз коучингті де тыңдай аласыз деп ойлаймын.
Dialogue: 0,0:03:43.68,0:03:45.97,Default,,0,0,0,,Сіз жай ғана физикалық ақымақ емессіз.
Dialogue: 0,0:03:46.43,0:03:47.26,Default,,0,0,0,,Бұл Тогаши!
Dialogue: 0,0:03:48.43,0:03:50.35,Default,,0,0,0,,Уф... Уф!
Dialogue: 0,0:03:53.06,0:03:56.40,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:56.52,0:03:58.57,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:58.65,0:03:59.61,Default,,0,0,0,,Коучинг
Dialogue: 0,0:04:01.15,0:04:06.16,Default,,0,0,0,,Бұл сіздің Ашито Аои мен Ичиджо мырза арасындағы шешуші айырмашылық.
Dialogue: 0,0:04:06.99,0:04:09.70,Default,,0,0,0,,Жеке тактиканы үйрену дегеніміз⸺
Dialogue: 0,0:04:10.29,0:04:13.54,Default,,0,0,0,,Сөзбен айтып, өз қолыңмен ұстау дегенді білдіреді.
Dialogue: 0,0:04:13.96,0:04:17.63,Default,,0,0,0,,Сонда сіз айналаңыздағыларға нақты коучинг бере аласыз.
Dialogue: 0,0:04:18.71,0:04:19.67,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:04:20.30,0:04:23.05,Default,,0,0,0,,Юма жас кезінде⸺
Dialogue: 0,0:04:23.34,0:04:24.88,Default,,0,0,0,,Көрнекті қатысу
Dialogue: 0,0:04:25.59,0:04:27.51,Default,,0,0,0,,Сондай-ақ Аоидың бұрынғы ұпайы⸺
Dialogue: 0,0:04:27.97,0:04:31.56,Default,,0,0,0,,Ешқандай нұсқау жоқ, мен Аоидың ниетін тез түсіндім⸺
Dialogue: 0,0:04:32.23,0:04:34.39,Default,,0,0,0,,Қақпа алдында допты ұстаған ол.
Dialogue: 0,0:04:35.35,0:04:38.44,Default,,0,0,0,,Сезімтал бола отырып, айналаңызды пайдаланыңыз
Dialogue: 0,0:04:39.61,0:04:43.24,Default,,0,0,0,,Бұл Эсперионның идеалды шабуылшысы.
Dialogue: 0,0:04:45.91,0:04:47.74,Default,,0,0,0,,Себебі мен осындамын⸺
Dialogue: 0,0:04:48.03,0:04:50.24,Default,,0,0,0,,Асари қамти алмады
Dialogue: 0,0:04:52.41,0:04:54.08,Default,,0,0,0,,Осы жерде тұрмын
Dialogue: 0,0:04:54.87,0:04:57.04,Default,,0,0,0,,Бұл менің рөлім болды ма?
Dialogue: 0,0:04:58.88,0:05:01.80,Default,,0,0,0,,Бұрын доп айналмайтын футбол ойындары болған.
Dialogue: 0,0:05:03.88,0:05:05.43,Default,,0,0,0,,Эхиме футбол клубы
Dialogue: 0,0:05:06.47,0:05:08.51,Default,,0,0,0,,Мен өзімшіл ойнаймын⸺
Dialogue: 0,0:05:09.39,0:05:10.76,Default,,0,0,0,,Барлығы мені жек көретін
Dialogue: 0,0:05:11.64,0:05:12.97,Default,,0,0,0,,Ашық қудалау
Dialogue: 0,0:05:13.77,0:05:15.85,Default,,0,0,0,,Маған футбол ойнауға рұқсат етілмеді.
Dialogue: 0,0:05:17.06,0:05:19.19,Default,,0,0,0,,Бірақ ол кездегіден мүлде басқаша.
Dialogue: 0,0:05:20.31,0:05:23.65,Default,,0,0,0,,Бұл жігіттер менсіз де ұпай алуы мүмкін еді, солай ма?
Dialogue: 0,0:05:24.82,0:05:26.20,Default,,0,0,0,,Ешкім қателеспейді
Dialogue: 0,0:05:27.03,0:05:28.87,Default,,0,0,0,,Сіз мені ұпай жинау үшін қалдырдыңыз.
Dialogue: 0,0:05:30.28,0:05:33.83,Default,,0,0,0,,Менің қолымнан келетіні – сені тұрған күйде қалдыру.
Dialogue: 0,0:05:34.83,0:05:37.04,Default,,0,0,0,,Ол саған керегі жоқ жігіт еді.
Dialogue: 0,0:05:46.88,0:05:50.09,Default,,0,0,0,,Қызыл және ақ шайқас аяқталды. Баршаңызға қажырлы еңбектеріңіз үшін рахмет.
Dialogue: 0,0:05:50.89,0:05:52.56,Default,,0,0,0,,А тобына кім көтеріледі?
Dialogue: 0,0:05:53.77,0:05:56.18,Default,,0,0,0,,Юма Мотоки (Мотоки) О...
Dialogue: 0,0:05:58.10,0:05:59.65,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:06:00.77,0:06:03.73,Default,,0,0,0,,Оның пайдасыз болғаны соншалық, рұқсат бұдан былай өтпей қалды.
Dialogue: 0,0:06:05.23,0:06:08.57,Default,,0,0,0,,Тіпті жинаған ұпайым да жойылды!
Dialogue: 0,0:06:09.66,0:06:12.12,Default,,0,0,0,,Бірақ не!
Dialogue: 0,0:06:13.58,0:06:15.62,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:17.37,0:06:21.58,Default,,0,0,0,,Нені түсінбейтінімді де білмеймін! Қарғыс атсын!
Dialogue: 0,0:06:21.88,0:06:23.29,Default,,0,0,0,,Аои-кун (Ашито) Ах...
Dialogue: 0,0:06:26.92,0:06:27.92,Default,,0,0,0,,H…
Dialogue: 0,0:06:30.09,0:06:32.43,Default,,0,0,0,,Жаман каштан, алдымен үйге қайт.
Dialogue: 0,0:06:35.35,0:06:39.69,Default,,0,0,0,,Бұл іріктеуден кейін бірінші рет. Аой-кун, өтуіңмен құттықтаймын.
Dialogue: 0,0:06:40.48,0:06:41.35,Default,,0,0,0,,Қоқыс
Dialogue: 0,0:06:42.23,0:06:44.57,Default,,0,0,0,,Сізде талант жоқ.
Dialogue: 0,0:06:45.11,0:06:46.65,Default,,0,0,0,,Бұл бетті жасама
Dialogue: 0,0:06:46.78,0:06:49.82,Default,,0,0,0,,Ол менің ағам, сондықтан оның болуы табиғи нәрсе.
Dialogue: 0,0:06:50.49,0:06:52.62,Default,,0,0,0,,Маған матчты көруге рұқсат берілді.
Dialogue: 0,0:06:52.99,0:06:54.70,Default,,0,0,0,,Клуб үйінің екінші қабатынан⸺
Dialogue: 0,0:06:54.99,0:06:58.96,Default,,0,0,0,,Бүгінгі Кохаку матчы Фукуда мырзамен және барлық жоғарғы сынып оқушыларымен
Dialogue: 0,0:07:00.50,0:07:01.71,Default,,0,0,0,,Сізге бірдеңе керек пе?
Dialogue: 0,0:07:02.25,0:07:05.75,Default,,0,0,0,,Таңдаудан бері ештеңені өзгерткен жоқсыз.
Dialogue: 0,0:07:06.42,0:07:07.88,Default,,0,0,0,,бұл... уф...
Dialogue: 0,0:07:08.05,0:07:11.34,Default,,0,0,0,,Неге мұндасың?
Dialogue: 0,0:07:11.72,0:07:15.97,Default,,0,0,0,,Кенеттен әріптестеріңіз сізді елемейді.
Dialogue: 0,0:07:16.39,0:07:19.23,Default,,0,0,0,,Куу... у... уф...
Dialogue: 0,0:07:19.60,0:07:21.64,Default,,0,0,0,,Қабылдамасаңыз, көмектесу мүмкін емес.
Dialogue: 0,0:07:22.19,0:07:23.90,Default,,0,0,0,,Оның жолыңызға түсуіне жол бермеңіз⸺
Dialogue: 0,0:07:24.44,0:07:28.19,Default,,0,0,0,,Допты үш жыл бұрышта теу, ақымақ.
Dialogue: 0,0:07:28.65,0:07:31.03,Default,,0,0,0,,Бұл әлі бірінші күн
Dialogue: 0,0:07:33.16,0:07:35.45,Default,,0,0,0,,Мен осы жерден жорғалап шығамын.
Dialogue: 0,0:07:36.24,0:07:37.29,Default,,0,0,0,,Таңдану
Dialogue: 0,0:07:38.20,0:07:40.12,Default,,0,0,0,,Ата-ана да ақымақ.
Dialogue: 0,0:07:40.71,0:07:43.79,Default,,0,0,0,,Дарынды балаға босқа кеткен инвестиция...
Dialogue: 0,0:07:44.17,0:07:48.13,Default,,0,0,0,,Сіз ұлыңыз туралы шындап армандайсыз ба және оның кәсіби келісім-шарт ақшасына сенесіз бе?
Dialogue: 0,0:07:48.46,0:07:52.76,Default,,0,0,0,,Жыл сайын жастарды дұрыс түсінбейтін емтихан тапсыратын аналар кездеседі.
Dialogue: 0,0:07:53.13,0:07:54.47,Default,,0,0,0,,Ата-аналар, тоқтаңдар.
Dialogue: 0,0:07:55.55,0:07:58.35,Default,,0,0,0,,Ата-аналар, тоқтаңдар, бәрібір!
Dialogue: 0,0:07:59.81,0:08:00.35,Default,,0,0,0,,Мен қай жерде жаттығып жүргенімді ойлайсың?
Dialogue: 0,0:08:01.35,0:08:04.19,Default,,0,0,0,,О? Ештене етпейді.
Dialogue: 0,0:08:04.48,0:08:06.73,Default,,0,0,0,,Менің ойымша, олар бұл үшін төледі.
Dialogue: 0,0:08:06.86,0:08:07.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:08.48,0:08:09.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:11.61,0:08:15.11,Default,,0,0,0,,Жастар келгенде бәрі жақсы болады деп ойладың.
Dialogue: 0,0:08:16.12,0:08:19.41,Default,,0,0,0,,Біреу маған қазір істей алмайтын нәрселерді үйретті⸺
Dialogue: 0,0:08:19.66,0:08:22.37,Default,,0,0,0,,Сіз мұны бір күні істей аламын деп ойладыңыз.
Dialogue: 0,0:08:23.75,0:08:27.21,Default,,0,0,0,,Мен дайындалдым деп ойладым.
Dialogue: 0,0:08:28.00,0:08:29.30,Default,,0,0,0,,Бірақ анықтау⸺
Dialogue: 0,0:08:30.00,0:08:32.26,Default,,0,0,0,,Бұл шынайы анықтау болды ма?
Dialogue: 0,0:08:32.63,0:08:36.51,Default,,0,0,0,,Теме сияқты ақкөңіл жандар жастар арасында танымал бола түсуде.
Dialogue: 0,0:08:37.93,0:08:40.47,Default,,0,0,0,,Маған бұл үрдіс мүлдем ұнамайды.
Dialogue: 0,0:08:46.73,0:08:50.61,Default,,0,0,0,,Менің ерік-жігерім жастарға сәйкес келмейді...
Dialogue: 0,0:08:51.73,0:08:53.57,Default,,0,0,0,,Мүлде жоқ⸺
Dialogue: 0,0:08:54.11,0:08:56.16,Default,,0,0,0,,Тәтті нәрсе істесем ше...
Dialogue: 0,0:09:00.99,0:09:02.12,Default,,0,0,0,,Содан кейін осы мәзірді пайдаланыңыз...
Dialogue: 0,0:09:02.20,0:09:03.58,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:09:04.16,0:09:06.79,Default,,0,0,0,,Хахахаха мен...
Dialogue: 0,0:09:07.50,0:09:09.29,Default,,0,0,0,,Неден бастау керек?
Dialogue: 0,0:09:11.38,0:09:13.55,Default,,0,0,0,,Сіз мұны білесіз!
Dialogue: 0,0:09:14.09,0:09:15.13,Default,,0,0,0,,Маған не жетіспейді...
Dialogue: 0,0:09:16.22,0:09:17.47,Default,,0,0,0,,Мен бәрін істеймін...
Dialogue: 0,0:09:18.39,0:09:19.43,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:09:19.80,0:09:22.01,Default,,0,0,0,,Маған футбол бер!
Dialogue: 0,0:09:22.97,0:09:24.23,Default,,0,0,0,,Алдымен осы жігіт туралы білетіндерімізді реттеп көрейік.
Dialogue: 0,0:09:28.27,0:09:29.27,Default,,0,0,0,,Фу
Dialogue: 0,0:09:29.44,0:09:30.65,Default,,0,0,0,,Хана-сан (гүл)...
Dialogue: 0,0:09:31.73,0:09:32.73,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:33.57,0:09:36.03,Default,,0,0,0,,Мен түсіндім деп ойлаймын.
Dialogue: 0,0:09:36.65,0:09:40.66,Default,,0,0,0,,Хана-сан Аойды неге сонша жақсы көреді?
Dialogue: 0,0:09:41.66,0:09:44.50,Default,,0,0,0,,Олар ұқсас Ойын стильдері
Dialogue: 0,0:09:45.16,0:09:46.12,Default,,0,0,0,,Сол адамға
Dialogue: 0,0:09:46.37,0:09:47.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:48.12,0:09:50.71,Default,,0,0,0,,Сондықтан мен сенің сезіміңді білмеймін...
Dialogue: 0,0:09:50.92,0:09:52.92,Default,,0,0,0,,бұл... аа...
Dialogue: 0,0:09:53.25,0:09:54.34,Default,,0,0,0,,Ахх... (гүл) Уау!
Dialogue: 0,0:09:54.42,0:09:56.38,Default,,0,0,0,,Нана нана... Нана... Не?
Dialogue: 0,0:09:56.80,0:09:58.59,Default,,0,0,0,,Сол гүл
Dialogue: 0,0:10:01.72,0:10:04.35,Default,,0,0,0,,Әй, аға!
Dialogue: 0,0:10:05.81,0:10:07.35,Default,,0,0,0,,Сіз әлі оралмадыңыз ба?
Dialogue: 0,0:10:07.81,0:10:09.77,Default,,0,0,0,,Әй, Кайдо Денки!
Dialogue: 0,0:10:10.44,0:10:13.36,Default,,0,0,0,,Түсіндім, сіз маған гүл жіберіп жатырсыз, бұл өте жақсы.
Dialogue: 0,0:10:13.44,0:10:14.44,Default,,0,0,0,,Соңғы алты күн үшін үлкен рақмет.
Dialogue: 0,0:10:14.65,0:10:16.15,Default,,0,0,0,,Әлде... (гүл) А?
Dialogue: 0,0:10:17.24,0:10:21.37,Default,,0,0,0,,Ка… Кай… Кай… Кай… Кай… Ка~кай…
Dialogue: 0,0:10:21.91,0:10:22.78,Default,,0,0,0,,Құбыжық-кун?
Dialogue: 0,0:10:22.87,0:10:24.41,Default,,0,0,0,,Бұл Анри Кайдо!
Dialogue: 0,0:10:24.87,0:10:27.91,Default,,0,0,0,,Біраз уақыт болды, директор Фукуда!
Dialogue: 0,0:10:28.16,0:10:30.25,Default,,0,0,0,,Бүгінгі басшылық та тамаша болды!
Dialogue: 0,0:10:30.33,0:10:33.21,Default,,0,0,0,,Жапондық Моуриньо дегеніміз не? Сізге арналған сөздер...
Dialogue: 0,0:10:34.05,0:10:35.34,Default,,0,0,0,,Моуриньо...
Dialogue: 0,0:10:36.34,0:10:37.09,Default,,0,0,0,,Е...
Dialogue: 0,0:10:37.80,0:10:40.72,Default,,0,0,0,,Ол ойыншы ретінде тәжірибесі жоқ жаттықтырушы.
Dialogue: 0,0:10:41.01,0:10:42.51,Default,,0,0,0,,Мен өте бақытты емеспін.
Dialogue: 0,0:10:43.30,0:10:44.35,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:10:44.60,0:10:46.47,Default,,0,0,0,,Сусусу... Кешіріңіз!
Dialogue: 0,0:10:46.60,0:10:47.35,Default,,0,0,0,,Ахаха
Dialogue: 0,0:10:47.56,0:10:49.56,Default,,0,0,0,,Әзіл, қалжың (Гүл) Уф~
Dialogue: 0,0:10:49.64,0:10:51.98,Default,,0,0,0,,Мен түсіндім деп ойлаймын.
Dialogue: 0,0:10:52.69,0:10:56.61,Default,,0,0,0,,Хана мырза Аоиды неге сонша жақсы көреді?
Dialogue: 0,0:10:58.32,0:10:59.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:00.57,0:11:01.95,Default,,0,0,0,,Олар бір-біріне ұқсайды.
Dialogue: 0,0:11:04.99,0:11:05.87,Default,,0,0,0,,Аняның үйіне қош келдіңіз
Dialogue: 0,0:11:06.16,0:11:09.12,Default,,0,0,0,,Әкем осы кісіге тұрмысқа шығуды ойлап жүр.
Dialogue: 0,0:11:09.58,0:11:11.17,Default,,0,0,0,,Қайырлы кеш, Хана Чан
Dialogue: 0,0:11:11.46,0:11:12.83,Default,,0,0,0,,Бұл Кинуо Фукуда.
Dialogue: 0,0:11:13.21,0:11:14.67,Default,,0,0,0,,Ал сіздің ұлыңыз...
Dialogue: 0,0:11:16.34,0:11:17.88,Default,,0,0,0,,Бұл Тацуя Фукуда.
Dialogue: 0,0:11:18.84,0:11:20.67,Default,,0,0,0,,Ахх~
Dialogue: 0,0:11:21.84,0:11:23.01,Default,,0,0,0,,Осылайша әлем бейбітшілік кейпін сақтайды
Dialogue: 0,0:11:23.22,0:11:25.05,Default,,0,0,0,,Менің анам да жақсы адам болған.
Dialogue: 0,0:11:26.14,0:11:29.27,Default,,0,0,0,,Енді сіз Испанияда футбол ойнай аласыз
Dialogue: 0,0:11:29.81,0:11:31.31,Default,,0,0,0,,Анаң туралы ойлайсың.
Dialogue: 0,0:11:31.69,0:11:35.02,Default,,0,0,0,,Менің футбол ойнағаным анамның арқасында.
Dialogue: 0,0:11:35.27,0:11:36.98,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:11:37.19,0:11:37.78,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:38.32,0:11:39.49,Default,,0,0,0,,Бұл ауруды аяғымызбен ұрып тастайық—
Dialogue: 0,0:11:40.19,0:11:42.03,Default,,0,0,0,,Ах... иә...
Dialogue: 0,0:11:42.11,0:11:44.12,Default,,0,0,0,,Ағамды бірінші рет жақыннан көруім
Dialogue: 0,0:11:44.66,0:11:47.70,Default,,0,0,0,,Менің есімде қалған жалғыз нәрсе - көз.
Dialogue: 0,0:11:48.33,0:11:51.50,Default,,0,0,0,,Сабырлы, бірақ сенімге толы⸺
Dialogue: 0,0:11:52.08,0:11:53.79,Default,,0,0,0,,Жарқыраған көздер⸺
Dialogue: 0,0:11:54.42,0:11:56.46,Default,,0,0,0,,Мен ешқашан ұмытпаймын
Dialogue: 0,0:12:00.55,0:12:01.88,Default,,0,0,0,,Фукуда~!
Dialogue: 0,0:12:03.38,0:12:04.39,Default,,0,0,0,,Не?
Dialogue: 0,0:12:04.55,0:12:07.76,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:12:08.68,0:12:10.73,Default,,0,0,0,,Маған да айтыңызшы.
Dialogue: 0,0:12:11.73,0:12:12.64,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:15.73,0:12:16.56,Default,,0,0,0,,Уф!
Dialogue: 0,0:12:17.86,0:12:18.94,Default,,0,0,0,,Уф…
Dialogue: 0,0:12:19.36,0:12:22.53,Default,,0,0,0,,Куу… Хахаха…
Dialogue: 0,0:12:22.82,0:12:23.95,Default,,0,0,0,,Тоқтату…
Dialogue: 0,0:12:26.28,0:12:27.28,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:12:29.49,0:12:31.33,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:12:31.95,0:12:34.75,Default,,0,0,0,,Жоқ, ол Нозомиге айтты...
Dialogue: 0,0:12:35.71,0:12:37.59,Default,,0,0,0,,«Тоқта және теп» (Ашито) бұл…
Dialogue: 0,0:12:38.09,0:12:40.21,Default,,0,0,0,,Бұл футбол негіздерінің негізі.
Dialogue: 0,0:12:40.63,0:12:43.26,Default,,0,0,0,,Сіз мұны істеген жоқсыз. Ең алдымен...
Dialogue: 0,0:12:43.55,0:12:45.59,Default,,0,0,0,,Маған қалай жаттығу керек екенін айт!
Dialogue: 0,0:12:47.43,0:12:52.02,Default,,0,0,0,,Одан кейін жатақханаға қайтып бармай, іспен айналыса бердім.
Dialogue: 0,0:12:52.77,0:12:56.10,Default,,0,0,0,,Бірақ оның жігері бар сияқты.
Dialogue: 0,0:12:56.65,0:12:57.65,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:12:58.61,0:13:01.32,Default,,0,0,0,,Ұқсас ойын мәнерлері емес.
Dialogue: 0,0:13:01.53,0:13:02.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:02.90,0:13:03.86,Default,,0,0,0,,Көздер...
Dialogue: 0,0:13:04.24,0:13:06.95,Default,,0,0,0,,Қаншалықты айдауда болса да⸺
Dialogue: 0,0:13:07.24,0:13:09.20,Default,,0,0,0,,Тек көз ешқашан өлмейді
Dialogue: 0,0:13:10.16,0:13:12.29,Default,,0,0,0,,Егер сіз бұл көзді ұстасаңыз⸺
Dialogue: 0,0:13:12.87,0:13:14.66,Default,,0,0,0,,Сіз қандай ойыншы боласыз...
Dialogue: 0,0:13:16.04,0:13:17.12,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:13:18.42,0:13:21.50,Default,,0,0,0,,Мен оны дұрыс көремін.
Dialogue: 0,0:13:32.06,0:13:35.43,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:13:35.98,0:13:37.06,Default,,0,0,0,,Ашито?
Dialogue: 0,0:13:37.98,0:13:39.86,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:13:41.69,0:13:42.73,Default,,0,0,0,,Шун ағасы
Dialogue: 0,0:13:43.32,0:13:45.11,Default,,0,0,0,,Менің сізден сұрайын дегенім бар.
Dialogue: 0,0:13:45.36,0:13:46.86,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:47.20,0:13:50.41,Default,,0,0,0,,Үш жыл бойы жастар құрамасына қосылу маған қанша тұрады?
Dialogue: 0,0:13:50.49,0:13:52.91,Default,,0,0,0,,Не... Бұл кенеттен не болды?
Dialogue: 0,0:13:53.20,0:13:55.96,Default,,0,0,0,,Қанша... ақша дейсіз бе?
Dialogue: 0,0:13:56.50,0:13:57.46,Default,,0,0,0,,Иә.
Dialogue: 0,0:13:57.75,0:14:00.33,Default,,0,0,0,,Мама, сен мені алдап, айтқан жоқсың.
Dialogue: 0,0:14:01.00,0:14:02.25,Default,,0,0,0,,Жарайды, мен қазір сенің орныңды аламын.
Dialogue: 0,0:14:02.75,0:14:04.21,Default,,0,0,0,,Анаңнан тікелей сұраған дұрыс...
Dialogue: 0,0:14:04.30,0:14:06.76,Default,,0,0,0,,Әй, жоқ, менің орныма өтіңізші!
Dialogue: 0,0:14:07.05,0:14:07.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:08.01,0:14:10.85,Default,,0,0,0,,Мұнда кел, біз әлі ештеңе істеген жоқпыз.
Dialogue: 0,0:14:11.72,0:14:13.26,Default,,0,0,0,,Мен анаммен әлі сөйлесе алмаймын.
Dialogue: 0,0:14:13.97,0:14:15.77,Default,,0,0,0,,Ата-ана да ақымақ.
Dialogue: 0,0:14:16.18,0:14:19.06,Default,,0,0,0,,Дарынды балаға босқа кеткен инвестиция...
Dialogue: 0,0:14:22.15,0:14:22.90,Default,,0,0,0,,Қуа~
Dialogue: 0,0:14:22.98,0:14:24.73,Default,,0,0,0,,Мен жай ғана білгім келеді.
Dialogue: 0,0:14:25.48,0:14:28.74,Default,,0,0,0,,Футболға көңіл бөлу маған қанша тұрады⸺
Dialogue: 0,0:14:29.32,0:14:30.49,Default,,0,0,0,,Анаңнан сұра
Dialogue: 0,0:14:30.70,0:14:31.70,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:32.20,0:14:35.24,Default,,0,0,0,,Хмм... Айтайын дегенім...
Dialogue: 0,0:14:36.58,0:14:37.45,Default,,0,0,0,,Хмм
Dialogue: 0,0:14:37.96,0:14:39.00,Default,,0,0,0,,Ооо...
Dialogue: 0,0:14:39.29,0:14:41.46,Default,,0,0,0,,Ха, жарай ма?
Dialogue: 0,0:14:41.71,0:14:42.25,Default,,0,0,0,,Иә
Dialogue: 0,0:14:42.54,0:14:45.80,Default,,0,0,0,,Ай сайынғы төлем 6000 иен Жатақхана ақысы айына 5000 иен
Dialogue: 0,0:14:46.17,0:14:48.47,Default,,0,0,0,,Түскі және кешкі ас үшін жатақханадағы тамақ тегін.
Dialogue: 0,0:14:48.72,0:14:51.39,Default,,0,0,0,,Тек таңғы ас: тамаққа 300 иен
Dialogue: 0,0:14:52.14,0:14:55.60,Default,,0,0,0,,Барлығы айына шамамен 20 000 иен
Dialogue: 0,0:14:56.27,0:14:58.10,Default,,0,0,0,,жылына 240 000 иен
Dialogue: 0,0:14:58.39,0:15:00.69,Default,,0,0,0,,Бұған қоса, жыл сайынғы экспедиция ақысы 60 000 иен.
Dialogue: 0,0:15:01.06,0:15:03.98,Default,,0,0,0,,Басқаша айтқанда, оның бәрін қоссаңыз, жылына 300 000 иен болады.
Dialogue: 0,0:15:04.44,0:15:06.19,Default,,0,0,0,,Бірақ бұл мен ойлағаннан да арзанырақ...
Dialogue: 0,0:15:06.28,0:15:07.48,Default,,0,0,0,,Қайтар (қатар) Ах...
Dialogue: 0,0:15:07.57,0:15:08.78,Default,,0,0,0,,Клуб құны да⸺
Dialogue: 0,0:15:09.11,0:15:11.61,Default,,0,0,0,,Барлық оқу ақысы, тұру шығындары және көлік шығындары.
Dialogue: 0,0:15:12.03,0:15:13.87,Default,,0,0,0,,3 жыл ішінде абсолютті қайтарым
Dialogue: 0,0:15:14.62,0:15:15.78,Default,,0,0,0,,Анама айт
Dialogue: 0,0:15:17.62,0:15:20.66,Default,,0,0,0,,«Үш жылдың ішінде» деген сөзіңіз...
Dialogue: 0,0:15:20.91,0:15:21.75,Default,,0,0,0,,Не... аа...
Dialogue: 0,0:15:22.46,0:15:24.50,Default,,0,0,0,,Көп уайымдамаңыз.
Dialogue: 0,0:15:25.54,0:15:26.59,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:28.01,0:15:29.59,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:31.84,0:15:32.89,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:36.14,0:15:36.76,Default,,0,0,0,,Nu...
Dialogue: 0,0:15:37.77,0:15:40.81,Default,,0,0,0,,Сәлем! Неліктен доп сонда қалқып тұр?
Dialogue: 0,0:15:41.23,0:15:42.65,Default,,0,0,0,,Нунунуну...
Dialogue: 0,0:15:43.06,0:15:44.81,Default,,0,0,0,,Құпия сөзбен жұмыс істеп жатқаныма қарамастан⸺
Dialogue: 0,0:15:44.90,0:15:47.11,Default,,0,0,0,,Ағын сізге тоқтайды⸺
Dialogue: 0,0:15:47.19,0:15:49.36,Default,,0,0,0,,Бұл жерде ырғақ ессіз болып барады!
Dialogue: 0,0:15:50.15,0:15:51.53,Default,,0,0,0,,Сәлем Йосе Нагано
Dialogue: 0,0:15:52.03,0:15:53.74,Default,,0,0,0,,Мына жігіт жаңа ғана кіріп келді.
Dialogue: 0,0:15:54.16,0:15:55.24,Default,,0,0,0,,Ақымақ болма.
Dialogue: 0,0:15:55.49,0:15:58.66,Default,,0,0,0,,Допты аяғыңыздың астына тоқтату - бұл негіздердің ең негізгісі!
Dialogue: 0,0:15:58.87,0:16:00.12,Default,,0,0,0,,Біз тек адамбыз; бәрі біз қалағандай бола бермейді.
Dialogue: 0,0:16:00.20,0:16:02.92,Default,,0,0,0,,Мен айтқым келеді, бұл туралы алаңдамаңыз ...
Dialogue: 0,0:16:03.62,0:16:05.08,Default,,0,0,0,,Жастық – аман қалу
Dialogue: 0,0:16:05.50,0:16:07.67,Default,,0,0,0,,Қолынан келмейтін адамдарға алаңдауға уақыт жоқ.
Dialogue: 0,0:16:08.05,0:16:10.01,Default,,0,0,0,,Эй, сен онда не істеп жүрсің? (Тайра) Ой...
Dialogue: 0,0:16:10.09,0:16:11.34,Default,,0,0,0,,Йабе (Тайра) Кеттік.
Dialogue: 0,0:16:14.51,0:16:16.60,Default,,0,0,0,,Бұлай айту тым көп. Мен сенімен бір жыл болдым.
Dialogue: 0,0:16:17.35,0:16:18.97,Default,,0,0,0,,Айтқаннан басқа амалым жоқ, Тайра.
Dialogue: 0,0:16:19.14,0:16:21.98,Default,,0,0,0,,Негіздерді білмейтін адам кәсіби маман болуды қалай мақсат етеді?
Dialogue: 0,0:16:22.56,0:16:24.14,Default,,0,0,0,,Бұл жай ғана немқұрайлылық сияқты естіледі.
Dialogue: 0,0:16:25.19,0:16:26.61,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:16:27.15,0:16:28.15,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:30.23,0:16:32.74,Default,,0,0,0,,Мен оны көрмей қалдым.
Dialogue: 0,0:16:33.28,0:16:37.37,Default,,0,0,0,,Барлығы үйге кеткеннен кейін де ол қатты жаттығады.
Dialogue: 0,0:16:37.78,0:16:39.91,Default,,0,0,0,,Жатақханада түнде де, күнде жалғызбын...
Dialogue: 0,0:16:40.74,0:16:42.37,Default,,0,0,0,,Осыған қарасаңыз...
Dialogue: 0,0:16:43.33,0:16:45.79,Default,,0,0,0,,(Доптың қабырғаға соғылған дыбысы)
Dialogue: 0,0:16:45.87,0:16:46.92,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:48.67,0:16:49.21,Default,,0,0,0,,Мен сені күттім, Батыр. ➡
Dialogue: 0,0:16:50.88,0:16:52.51,Default,,0,0,0,,Уф... Шүкір!
Dialogue: 0,0:16:53.05,0:16:54.72,Default,,0,0,0,,Қайтадан жүзу!
Dialogue: 0,0:16:55.59,0:16:58.26,Default,,0,0,0,,Неліктен мұны істей алмайсың! Қарғыс атсын!
Dialogue: 0,0:17:01.60,0:17:06.02,Default,,0,0,0,,Мен мұны өткен аптада түні бойы жаттықтым.
Dialogue: 0,0:17:06.56,0:17:08.15,Default,,0,0,0,,жақсарған жоқ
Dialogue: 0,0:17:09.23,0:17:10.73,Default,,0,0,0,,Бірақ мен жеңілмеймін
Dialogue: 0,0:17:11.23,0:17:14.36,Default,,0,0,0,,Мен мұны міндетті түрде орындаймын! дереу!
Dialogue: 0,0:17:16.24,0:17:19.53,Default,,0,0,0,,Мен мұндай жерде су басқанға шыдай алмаймын!
Dialogue: 0,0:17:20.12,0:17:21.03,Default,,0,0,0,,Эй
Dialogue: 0,0:17:23.75,0:17:24.87,Default,,0,0,0,,Бәрі сол қарттың кінәсі!
Dialogue: 0,0:17:24.96,0:17:27.08,Default,,0,0,0,,Тек сандарды орындау жеткіліксіз.
Dialogue: 0,0:17:27.88,0:17:29.96,Default,,0,0,0,,Отомо Тачибана
Dialogue: 0,0:17:30.50,0:17:34.26,Default,,0,0,0,,Мұны жалғыз істеу керек пе? Мұны бірнеше адаммен жасасаңыз, тезірек жақсарасыз.
Dialogue: 0,0:17:34.34,0:17:36.18,Default,,0,0,0,,Хи хи мен сенімен бірге шығамын.
Dialogue: 0,0:17:36.34,0:17:38.84,Default,,0,0,0,,А... сәл күте тұрыңыз.
Dialogue: 0,0:17:39.09,0:17:41.64,Default,,0,0,0,,Менімен кездесе алмайсың.
Dialogue: 0,0:17:42.01,0:17:44.31,Default,,0,0,0,,О? Мені қате түсінбеңіз.
Dialogue: 0,0:17:44.48,0:17:47.06,Default,,0,0,0,,Біз сонымен қатар негізгі жаттығуларды қарастырамыз.
Dialogue: 0,0:17:47.35,0:17:48.73,Default,,0,0,0,,Сіз жаттығуға бара жатқан сияқтысыз⸺
Dialogue: 0,0:17:48.81,0:17:52.32,Default,,0,0,0,,Сіз бен біздің арамыздағы айырмашылық кеңейіп барады.
Dialogue: 0,0:17:52.73,0:17:53.98,Default,,0,0,0,,Жүр, жасайық.
Dialogue: 0,0:17:54.19,0:17:57.07,Default,,0,0,0,,Іріктеу тобының детерминациясын көрсетейік.
Dialogue: 0,0:17:57.53,0:17:58.16,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:59.28,0:18:00.28,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:18:01.66,0:18:02.70,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:02.99,0:18:05.70,Default,,0,0,0,,Жарайды, мен бәріңді бірден өткіземін!
Dialogue: 0,0:18:05.79,0:18:06.91,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:13.13,0:18:14.13,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:18:14.92,0:18:16.47,Default,,0,0,0,,Тез шаршаңыз
Dialogue: 0,0:18:16.84,0:18:19.09,Default,,0,0,0,,Неге сонша шаршадың?
Dialogue: 0,0:18:19.68,0:18:21.18,Default,,0,0,0,,Са... Са~сен
Dialogue: 0,0:18:24.64,0:18:25.77,Default,,0,0,0,,Немесе...
Dialogue: 0,0:18:26.52,0:18:28.27,Default,,0,0,0,,Сондай-ақ көп дербес жаттығулар жасау керек.
Dialogue: 0,0:18:28.35,0:18:29.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:29.73,0:18:33.32,Default,,0,0,0,,Өз бетіңізше жаттығу жасау сіздің тұрақты жаттығуыңызға кедергі болатындай дәрежеде мүмкін емес.
Dialogue: 0,0:18:34.27,0:18:35.19,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:37.15,0:18:39.49,Default,,0,0,0,,Мұны әдеттегідей жасау жақсы емес.
Dialogue: 0,0:18:40.45,0:18:43.12,Default,,0,0,0,,Ол да сол жігіттер сияқты жаттығатын болса керек...
Dialogue: 0,0:18:43.66,0:18:46.08,Default,,0,0,0,,Ештеңені ойлама, сен екеуміз футбол ойнадық⸺
Dialogue: 0,0:18:46.33,0:18:49.04,Default,,0,0,0,,Мен олардың арасындағы уақыт айырмашылығын құра алмаймын.
Dialogue: 0,0:18:50.62,0:18:52.92,Default,,0,0,0,,Маған жатақханадан телефон соқты.
Dialogue: 0,0:18:53.50,0:18:55.42,Default,,0,0,0,,Түн ортасында бір жерге шығу⸺
Dialogue: 0,0:18:55.80,0:18:58.47,Default,,0,0,0,,Жарық сөнгеннен кейін бөлмеге оралыңыз
Dialogue: 0,0:18:58.72,0:18:59.38,Default,,0,0,0,,Сондай-ақ сиқыр сенің ерніңе де әсер етсін…
Dialogue: 0,0:18:59.47,0:19:01.18,Default,,0,0,0,,Ол осындай фигураны көріп тұрғанын айтады.
Dialogue: 0,0:19:01.68,0:19:02.80,Default,,0,0,0,,Шамамен 3 адам
Dialogue: 0,0:19:03.26,0:19:04.39,Default,,0,0,0,,Аой
Dialogue: 0,0:19:04.72,0:19:05.76,Default,,0,0,0,,Тіпті коменданттық сағат жоқ⸺
Dialogue: 0,0:19:05.85,0:19:09.02,Default,,0,0,0,,Олар жарықтың сөну уақытын елемей жаттығып жатқан сияқты емес.
Dialogue: 0,0:19:09.35,0:19:11.35,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:11.90,0:19:12.86,Default,,0,0,0,,Тоғаши!
Dialogue: 0,0:19:16.44,0:19:18.61,Default,,0,0,0,,Сен Аоимен бір бөлмеде болдың.
Dialogue: 0,0:19:18.90,0:19:21.41,Default,,0,0,0,,Аой жатақхана тәртібін бұзып тұрған жоқ па?
Dialogue: 0,0:19:23.78,0:19:24.74,Default,,0,0,0,,Бөлек
Dialogue: 0,0:19:25.37,0:19:27.12,Default,,0,0,0,,Мен ұйықтап жатырмын, сондықтан білмеймін.
Dialogue: 0,0:19:31.58,0:19:32.71,Default,,0,0,0,,Хаха...
Dialogue: 0,0:19:32.79,0:19:35.17,Default,,0,0,0,,Сіз біраз істеп жатқан сияқтысыз, Аои.
Dialogue: 0,0:19:35.46,0:19:37.13,Default,,0,0,0,,Тоқтату мен тебудің негізгі тәжірибесі
Dialogue: 0,0:19:37.92,0:19:39.38,Default,,0,0,0,,Тайра Сенпай
Dialogue: 0,0:19:40.05,0:19:42.05,Default,,0,0,0,,Сіз далада ақша үнемдей аласыз.
Dialogue: 0,0:19:42.38,0:19:43.05,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:43.14,0:19:46.10,Default,,0,0,0,,Оның үстіне сен Тоғашымен бір бөлмедесің.
Dialogue: 0,0:19:47.68,0:19:48.52,Default,,0,0,0,,Тоғашы?
Dialogue: 0,0:19:48.93,0:19:51.10,Default,,0,0,0,,Скаут емтиханын тапсырғандықтан шығар.
Dialogue: 0,0:19:51.98,0:19:55.52,Default,,0,0,0,,Біз кіші жастар сияқты қалыпқа сыймаймыз.
Dialogue: 0,0:19:56.40,0:19:57.90,Default,,0,0,0,,Ол үлкен және дөрекі⸺
Dialogue: 0,0:19:58.23,0:19:59.57,Default,,0,0,0,,Бұл мағынасы бар...
Dialogue: 0,0:20:00.24,0:20:01.99,Default,,0,0,0,,Менде сол негізгі технология бар.
Dialogue: 0,0:20:03.91,0:20:05.57,Default,,0,0,0,,Бір бөлмеде болсақ, неге сұрамайсың?
Dialogue: 0,0:20:06.70,0:20:07.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:09.70,0:20:10.54,Default,,0,0,0,,Не!?
Dialogue: 0,0:20:11.54,0:20:13.00,Default,,0,0,0,,Бүгін сізде демалыс бар ма?
Dialogue: 0,0:20:13.67,0:20:16.88,Default,,0,0,0,,А, темір маскалы жаттықтырушы да ескертті⸺
Dialogue: 0,0:20:17.17,0:20:19.59,Default,,0,0,0,,Мен біраз уақыт үнсіз қалуға тырысамын деп ойлаймын.
Dialogue: 0,0:20:20.71,0:20:23.47,Default,,0,0,0,,Балалар, біраз уақыт жақсылап демалыңдар.
Dialogue: 0,0:20:24.22,0:20:25.34,Default,,0,0,0,,О...
Dialogue: 0,0:20:25.43,0:20:27.43,Default,,0,0,0,,Олай болса (Ашито) О, тағы да
Dialogue: 0,0:20:28.72,0:20:29.68,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:30.43,0:20:31.81,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:20:35.65,0:20:39.57,Default,,0,0,0,,(Тоғашының күрсінуі)
Dialogue: 0,0:20:43.65,0:20:45.28,Default,,0,0,0,,Біз жайбарақат бола алмаймыз.
Dialogue: 0,0:20:46.03,0:20:48.62,Default,,0,0,0,,Менің қолымнан келмейді, мен саған қиындық тудырмаймын.
Dialogue: 0,0:20:51.12,0:20:53.46,Default,,0,0,0,,Сіз жалғыз барасыз ба?
Dialogue: 0,0:20:53.58,0:20:54.46,Default,,0,0,0,,Е...
Dialogue: 0,0:20:54.79,0:20:56.58,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:20:56.88,0:20:59.88,Default,,0,0,0,,Мен әр түнде үлкен бөлмені пайдалана аламын, сондықтан мен шағымданбаймын.
Dialogue: 0,0:21:00.50,0:21:03.59,Default,,0,0,0,,Қараңызшы, сіз аздап қауіпті екенсіз.
Dialogue: 0,0:21:04.09,0:21:05.51,Default,,0,0,0,,Көздер (Ашито) иә?
Dialogue: 0,0:21:05.76,0:21:07.76,Default,,0,0,0,,Бір бұранда жетіспейді ме?
Dialogue: 0,0:21:08.22,0:21:09.60,Default,,0,0,0,,Бұл шектен шыққан.
Dialogue: 0,0:21:10.22,0:21:12.56,Default,,0,0,0,,Тізгінді біреу ұстауы керек⸺
Dialogue: 0,0:21:12.77,0:21:14.77,Default,,0,0,0,,Аз уақытта мен өз-өзімнен жаншылдым⸺
Dialogue: 0,0:21:15.23,0:21:17.56,Default,,0,0,0,,Ол ойыншы ретінде мансабын аяқтайтын түрі.
Dialogue: 0,0:21:18.11,0:21:20.73,Default,,0,0,0,,Хмм... кешіріңіз, бұл мағынасыз...
Dialogue: 0,0:21:21.11,0:21:23.07,Default,,0,0,0,,Тек анда-санда үзіліс жасаңыз.
Dialogue: 0,0:21:23.28,0:21:24.53,Default,,0,0,0,,Демалмаңыз
Dialogue: 0,0:21:24.74,0:21:26.82,Default,,0,0,0,,Содан кейін ол көп ұзамай құлайды.
Dialogue: 0,0:21:27.03,0:21:28.24,Default,,0,0,0,,Құлап қалмаңыз
Dialogue: 0,0:21:28.45,0:21:30.24,Default,,0,0,0,,Тағдырымыз тоғысса екен.
Dialogue: 0,0:21:30.53,0:21:32.74,Default,,0,0,0,,Жоқ, ол қиыншылыққа толы.
Dialogue: 0,0:21:33.08,0:21:34.50,Default,,0,0,0,,Мен міндетті түрде асығыспын
Dialogue: 0,0:21:35.21,0:21:36.62,Default,,0,0,0,,Барлығының деңгейі тым жоғары⸺
Dialogue: 0,0:21:37.54,0:21:39.71,Default,,0,0,0,,Мен осылай тұра алмаймын деп күнде ойлаймын.
Dialogue: 0,0:21:40.79,0:21:41.71,Default,,0,0,0,,Бірақ.
Dialogue: 0,0:21:43.30,0:21:45.59,Default,,0,0,0,,Толық деп айту дұрыс емес.
Dialogue: 0,0:21:46.13,0:21:49.22,Default,,0,0,0,,Көңілді, қызық, енді
Dialogue: 0,0:21:49.30,0:21:50.22,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:51.85,0:21:54.60,Default,,0,0,0,,Футбол қабілеті – өлшеуіш таяқша
Dialogue: 0,0:21:55.52,0:21:58.02,Default,,0,0,0,,Егер мен барымды бермесем, мені тастап кетеді.
Dialogue: 0,0:21:59.02,0:22:02.11,Default,,0,0,0,,Бұл менің жүрегімде шығар⸺
Dialogue: 0,0:22:02.82,0:22:04.36,Default,,0,0,0,,Бұл мен әрқашан қалаған нәрсе
Dialogue: 0,0:22:04.94,0:22:08.07,Default,,0,0,0,,Бұл жас ең жақсы жер.
Dialogue: 0,0:22:08.36,0:22:10.20,Default,,0,0,0,,Хмм… Ку… Цу…
Dialogue: 0,0:22:10.78,0:22:11.58,Default,,0,0,0,,Куфуфу…
Dialogue: 0,0:22:11.91,0:22:14.20,Default,,0,0,0,,Фуфуфуфу тахахахахха!
Dialogue: 0,0:22:14.37,0:22:16.41,Default,,0,0,0,,Сондықтан ол басқаша!
Dialogue: 0,0:22:16.66,0:22:20.38,Default,,0,0,0,,Сіз шынымен қызықсыз хаха~ хаха...
Dialogue: 0,0:22:20.71,0:22:21.75,Default,,0,0,0,,Хи хи хи...
Dialogue: 0,0:22:22.17,0:22:24.50,Default,,0,0,0,,Жарайды, мен бүгін сенімен бірге барамын.
Dialogue: 0,0:22:25.01,0:22:29.01,Default,,0,0,0,,«Тоқта және теп» дегеннің шынайы мағынасы⸺
Dialogue: 0,0:22:29.51,0:22:30.84,Default,,0,0,0,,Бұл не болып жатыр?
Dialogue: 0,0:22:36.02,0:22:42.02,Default,,0,0,0,,♪～
Dialogue: 0,0:23:59.89,0:24:05.90,Default,,0,0,0,,～♪
Dialogue: 0,0:24:24.33,0:24:25.96,Default,,0,0,0,,Келесі жолы «Аоаши»
Dialogue: 0,0:24:26.21,0:24:27.67,Default,,0,0,0,,«Футболды тарату»
Dialogue: 0,0:24:29.17,0:24:35.17,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory