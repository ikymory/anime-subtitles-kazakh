Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.96,0:00:03.87,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе, Курибаяши!
Dialogue: 0,0:00:04.25,0:00:06.50,Default,,0,0,0,,Бізге де өз үлесіңізді қосыңыз!
Dialogue: 0,0:00:07.09,0:00:08.21,Default,,0,0,0,,Мен қазір⸺
Dialogue: 0,0:00:10.71,0:00:11.92,Default,,0,0,0,,Мен сонда болсам...
Dialogue: 0,0:00:14.43,0:00:16.76,Default,,0,0,0,,Бақытты болып көрінбе.
Dialogue: 0,0:00:17.26,0:00:18.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:18.60,0:00:20.39,Default,,0,0,0,,Мен өлгенше қызғанамын
Dialogue: 0,0:00:22.02,0:00:28.02,Default,,0,0,0,,♪～
Dialogue: 0,0:01:45.93,0:01:51.94,Default,,0,0,0,,～♪
Dialogue: 0,0:01:52.02,0:01:53.57,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:01:53.65,0:01:55.49,Default,,0,0,0,,Курибаяши Инасе!
Dialogue: 0,0:01:56.36,0:01:57.99,Default,,0,0,0,,Тосу басу жылдам
Dialogue: 0,0:01:58.49,0:02:00.32,Default,,0,0,0,,Қауіпті Сіз соққыға ұшырайсыз!
Dialogue: 0,0:02:00.91,0:02:01.57,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:03.20,0:02:04.12,Default,,0,0,0,,А...
Dialogue: 0,0:02:04.74,0:02:05.54,Default,,0,0,0,,Жоқ… артық әуре болма.
Dialogue: 0,0:02:06.04,0:02:06.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:07.25,0:02:09.00,Default,,0,0,0,,Уау! (Тайра) Мен оны суырып алдым!
Dialogue: 0,0:02:10.04,0:02:12.96,Default,,0,0,0,,Сіз қауіпті деп ойлаған сәтте⸺
Dialogue: 0,0:02:13.29,0:02:17.38,Default,,0,0,0,,Курибаяши қарсыласының екпінін пайдаланып, оны басып озуға дайындалды⸺
Dialogue: 0,0:02:17.72,0:02:18.88,Default,,0,0,0,,Іс жүзінде шығарылды
Dialogue: 0,0:02:19.72,0:02:21.01,Default,,0,0,0,,Сіз бір қадамға кешігіп қалдыңыз.
Dialogue: 0,0:02:21.51,0:02:24.72,Default,,0,0,0,,Те... Тек шиеленіс теледидар көруден басқаша!
Dialogue: 0,0:02:25.01,0:02:27.27,Default,,0,0,0,,Келесі жолы мен назарымды аударып, елестетемін!
Dialogue: 0,0:02:27.43,0:02:28.39,Default,,0,0,0,,Оған таңданамын!
Dialogue: 0,0:02:30.81,0:02:31.77,Default,,0,0,0,,Ол тез.
Dialogue: 0,0:02:32.52,0:02:33.82,Default,,0,0,0,,Жылдамдықпен жүру
Dialogue: 0,0:02:34.48,0:02:36.19,Default,,0,0,0,,Мен болсам, тағы бір адамнан өтер едім...
Dialogue: 0,0:02:37.24,0:02:38.99,Default,,0,0,0,,А... а... жоқ...
Dialogue: 0,0:02:39.32,0:02:40.41,Default,,0,0,0,,Бұл үшбұрыш!
Dialogue: 0,0:02:40.53,0:02:42.16,Default,,0,0,0,,Екі адам қапталуға келеді!
Dialogue: 0,0:02:42.49,0:02:44.62,Default,,0,0,0,,Белгіні алып тастау үшін бірге жұмыс жасаңыз!
Dialogue: 0,0:02:45.20,0:02:48.29,Default,,0,0,0,,Ой, Курибаяши жолды осы жерден таңдаңыз
Dialogue: 0,0:02:48.50,0:02:50.62,Default,,0,0,0,,Мен дұрыс түсіндім!
Dialogue: 0,0:02:51.21,0:02:54.04,Default,,0,0,0,,Оң жағы жауға толы, сондықтан оны көре алмайсың.
Dialogue: 0,0:02:55.17,0:02:59.59,Default,,0,0,0,,Қазір! Допты оған беріп, сол жақтан да кесіңіз!
Dialogue: 0,0:02:59.88,0:03:00.43,Default,,0,0,0,,Уау!?
Dialogue: 0,0:03:02.05,0:03:03.05,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:03:03.64,0:03:04.68,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:03:05.05,0:03:07.52,Default,,0,0,0,,Тегін шығу Керемет мүмкіндік!
Dialogue: 0,0:03:07.93,0:03:10.48,Default,,0,0,0,,Ах~ Керемет құтқару!
Dialogue: 0,0:03:10.77,0:03:14.40,Default,,0,0,0,,Қалай болғанда да, Курибаяши, бұл ғажайып өлтіруші пас!
Dialogue: 0,0:03:14.86,0:03:16.65,Default,,0,0,0,,Технология да керемет⸺
Dialogue: 0,0:03:17.07,0:03:19.82,Default,,0,0,0,,Өзін-өзі сынау керемет
Dialogue: 0,0:03:20.45,0:03:21.65,Default,,0,0,0,,Ағымдағы өлтіруші билеті
Dialogue: 0,0:03:22.03,0:03:23.91,Default,,0,0,0,,Егер ол тағы бірнеше сантиметрге өшіп қалса⸺
Dialogue: 0,0:03:24.16,0:03:27.62,Default,,0,0,0,,Қарсылас бірден қарсылық көрсеткен жағдай болды.
Dialogue: 0,0:03:28.62,0:03:30.00,Default,,0,0,0,,Бірақ сабырмен...
Dialogue: 0,0:03:31.08,0:03:34.38,Default,,0,0,0,,Мынау... осындай жігіт бар ма...?
Dialogue: 0,0:03:34.92,0:03:38.00,Default,,0,0,0,,Харухиса Курибаяши Бар болғаны 5 минут қалды!
Dialogue: 0,0:03:38.21,0:03:39.84,Default,,0,0,0,,Бірінші түртуден⸺
Dialogue: 0,0:03:39.92,0:03:42.72,Default,,0,0,0,,Мен ағынды Эсперионға әкелдім~!
Dialogue: 0,0:03:47.51,0:03:48.51,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:49.10,0:03:53.06,Default,,0,0,0,,Өйткені, мен бүгін мүмкіндігінше көзге түсетін жеке дағдыны таңдаймын.
Dialogue: 0,0:03:53.14,0:03:54.06,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:55.06,0:03:56.90,Default,,0,0,0,,Әрине жеңіске үлесімді қосамын.
Dialogue: 0,0:03:57.19,0:03:59.90,Default,,0,0,0,,Бірақ есіңізде болмаса, мағынасыз.
Dialogue: 0,0:04:00.36,0:04:02.20,Default,,0,0,0,,Бүгін мен ойында ойнауға тура келді...
Dialogue: 0,0:04:03.53,0:04:05.45,Default,,0,0,0,,Мені қайтадан орындыққа отырғызуға жол берме⸺
Dialogue: 0,0:04:06.57,0:04:09.08,Default,,0,0,0,,Мұндағы барлық көрермендер сіз тарапта.
Dialogue: 0,0:04:09.58,0:04:11.50,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:04:16.58,0:04:17.50,Default,,0,0,0,,(Изуку) Ах! (Гран Торино) Уа!
Dialogue: 0,0:04:17.67,0:04:20.00,Default,,0,0,0,,О, қандай ұят!
Dialogue: 0,0:04:20.88,0:04:23.84,Default,,0,0,0,,Мен қалай осылай бола аламын?
Dialogue: 0,0:04:24.47,0:04:27.39,Default,,0,0,0,,Бұл жігіт тым керемет
Dialogue: 0,0:04:29.06,0:04:32.06,Default,,0,0,0,,Курибаяшиге қарап не ойлайсың?
Dialogue: 0,0:04:32.85,0:04:34.60,Default,,0,0,0,,Мен қатты сұрағым келді.
Dialogue: 0,0:04:35.94,0:04:38.11,Default,,0,0,0,,Менің болашағым үшін
Dialogue: 0,0:04:39.02,0:04:39.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:40.73,0:04:42.19,Default,,0,0,0,,Курибаяши бұрын⸺
Dialogue: 0,0:04:42.49,0:04:44.40,Default,,0,0,0,,Бұл туралы ол сұхбатында айтты.
Dialogue: 0,0:04:45.32,0:04:46.86,Default,,0,0,0,,Кез келген жағдайда⸺
Dialogue: 0,0:04:47.24,0:04:50.99,Default,,0,0,0,,Бірден төрт дұрыс жауап нұсқасы болады⸺
Dialogue: 0,0:04:51.49,0:04:52.79,Default,,0,0,0,,Біреуін таңдаңыз
Dialogue: 0,0:04:53.71,0:04:54.79,Default,,0,0,0,,Төрт?
Dialogue: 0,0:04:55.29,0:04:58.04,Default,,0,0,0,,Менің таңдауым жоқ
Dialogue: 0,0:04:58.38,0:05:01.75,Default,,0,0,0,,Сол сәтте ойға келетін тамаша пьеса әрқашан...
Dialogue: 0,0:05:02.59,0:05:03.55,Default,,0,0,0,,Бір
Dialogue: 0,0:05:04.17,0:05:06.09,Default,,0,0,0,,Опцияларыңызды көбейтіңіз
Dialogue: 0,0:05:06.51,0:05:09.51,Default,,0,0,0,,Осы мақсатта Курибаяши пьесасы⸺
Dialogue: 0,0:05:09.72,0:05:12.02,Default,,0,0,0,,Бірден жасауға болатын нәрселер бар.
Dialogue: 0,0:05:13.89,0:05:16.35,Default,,0,0,0,,Мұны міндетті түрде орындау керек.
Dialogue: 0,0:05:17.02,0:05:19.73,Default,,0,0,0,,Бұл туралы мұқият ойланыңыз
Dialogue: 0,0:05:21.15,0:05:22.28,Default,,0,0,0,,Хмм... Уф.
Dialogue: 0,0:05:26.74,0:05:28.07,Default,,0,0,0,,Уф! (Тосу қақпашысы) Уау...
Dialogue: 0,0:05:28.41,0:05:30.66,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:05:30.78,0:05:34.79,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:05:38.42,0:05:40.17,Default,,0,0,0,,Бүгінгі жеңістің қозғаушы күші⸺
Dialogue: 0,0:05:40.88,0:05:43.05,Default,,0,0,0,,2 голдан шығу Тамоцу
Dialogue: 0,0:05:43.63,0:05:45.55,Default,,0,0,0,,және жеңген ассист⸺
Dialogue: 0,0:05:45.97,0:05:48.09,Default,,0,0,0,,Бұл Харухиса Курибаяши.
Dialogue: 0,0:05:48.76,0:05:50.55,Default,,0,0,0,,Ба... бұл құбыжық.
Dialogue: 0,0:05:51.55,0:05:53.56,Default,,0,0,0,,Бұл Курибаяши заты
Dialogue: 0,0:05:54.22,0:05:55.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:56.18,0:05:56.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:03.73,0:06:04.69,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:05.28,0:06:08.15,Default,,0,0,0,,Бұл жігіттер сен сияқты таң қалмайды.
Dialogue: 0,0:06:08.91,0:06:12.53,Default,,0,0,0,,Мен Курибаяшиді кіші кезінен бақылап келемін.
Dialogue: 0,0:06:14.08,0:06:17.08,Default,,0,0,0,,Академияға түсетін біз сияқты бастауыш сынып оқушылары⸺
Dialogue: 0,0:06:17.54,0:06:20.42,Default,,0,0,0,,Жалпы, мен мектепке келмей тұрып-ақ футболда жақсы болдым.
Dialogue: 0,0:06:21.25,0:06:24.05,Default,,0,0,0,,Әрине, Эсперион Джуниор да бірінші орынды алады.
Dialogue: 0,0:06:24.55,0:06:26.34,Default,,0,0,0,,Мен бұған күмәнданбадым
Dialogue: 0,0:06:26.84,0:06:27.76,Default,,0,0,0,,Бірақ⸺
Dialogue: 0,0:06:28.97,0:06:32.14,Default,,0,0,0,,Курибаяшиді бірінші күні көргенде бірден ойладым:
Dialogue: 0,0:06:32.89,0:06:36.18,Default,,0,0,0,,Аа, мен екінші орынға ұмтылуым керек.
Dialogue: 0,0:06:37.98,0:06:40.44,Default,,0,0,0,,Осы командадағы екінші үздік...
Dialogue: 0,0:06:42.36,0:06:44.07,Default,,0,0,0,,Келесі, Курибаяши
Dialogue: 0,0:06:44.27,0:06:45.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:45.69,0:06:47.11,Default,,0,0,0,,Орта мектеп оқушысының кемшілігі⸺
Dialogue: 0,0:06:47.19,0:06:49.36,Default,,0,0,0,,Бұл маған қатты әсер еткен жоқ.
Dialogue: 0,0:06:49.49,0:06:51.99,Default,,0,0,0,,Ол керемет қимылдар көрсетті.
Dialogue: 0,0:06:53.87,0:06:57.12,Default,,0,0,0,,Мен Топтың тәжірибесіне біраздан бері қатысып жүрмін.
Dialogue: 0,0:06:57.70,0:06:58.83,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:06:59.41,0:07:02.54,Default,,0,0,0,,Қозғалыстарды орындауда ешқашан қиындық көрген емеспін.
Dialogue: 0,0:07:03.25,0:07:05.96,Default,,0,0,0,,Иә, мүлде жаман болған жоқ.
Dialogue: 0,0:07:06.59,0:07:08.34,Default,,0,0,0,,Бұдан былай дене шынықтыру⸺
Dialogue: 0,0:07:08.51,0:07:11.47,Default,,0,0,0,,Менің қазіргі арық денем күшті өзекке айналса⸺
Dialogue: 0,0:07:11.55,0:07:14.05,Default,,0,0,0,,Әлсіз жақтары да жоғалады... Иә?
Dialogue: 0,0:07:20.10,0:07:21.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:23.02,0:07:24.77,Default,,0,0,0,,Сұхбат алушыны жылатпаңыз.
Dialogue: 0,0:07:25.23,0:07:26.61,Default,,0,0,0,,Бұл қызықсыз сұрақ⸺
Dialogue: 0,0:07:26.90,0:07:29.61,Default,,0,0,0,,Ниетімді көріп тұрғандайсың.
Dialogue: 0,0:07:30.57,0:07:31.99,Default,,0,0,0,,Оны орындау қиын деген атаққа ие.
Dialogue: 0,0:07:32.49,0:07:35.03,Default,,0,0,0,,Қызықсыз ба? Сіздің қазіргі сұрағыңыз қандай?
Dialogue: 0,0:07:40.58,0:07:43.71,Default,,0,0,0,,Мен үшін физикалық деген сөз⸺
Dialogue: 0,0:07:44.17,0:07:47.04,Default,,0,0,0,,Менің ойымша, бұл техникасы жоқ біреудің сылтауы.
Dialogue: 0,0:07:47.63,0:07:51.88,Default,,0,0,0,,Сізге дәл қазір не қажет екенін жақсы білесіз.
Dialogue: 0,0:07:52.43,0:07:54.26,Default,,0,0,0,,Егер сізден басқа біреу түсінсе⸺
Dialogue: 0,0:07:54.84,0:07:58.06,Default,,0,0,0,,Жастар жаттықтырушысы Фукуда... бұл туралы.
Dialogue: 0,0:07:58.47,0:08:00.14,Default,,0,0,0,,Мен... түсінемін.
Dialogue: 0,0:08:00.27,0:08:03.81,Default,,0,0,0,,Міне бүгінгі кейіпкердің сұхбаты~
Dialogue: 0,0:08:07.02,0:08:07.98,Default,,0,0,0,,Йошицуне
Dialogue: 0,0:08:08.61,0:08:11.57,Default,,0,0,0,,Ертең сізде басқа мәзір болады. Бұл жақсы.
Dialogue: 0,0:08:13.95,0:08:14.91,Default,,0,0,0,,Құдайлар
Dialogue: 0,0:08:15.62,0:08:18.33,Default,,0,0,0,,Олай болса, жатақхана студенттерінен басқасының барлығы осы жерден шығарылады.
Dialogue: 0,0:08:19.62,0:08:21.37,Default,,0,0,0,,Физикалық деген сөз⸺
Dialogue: 0,0:08:21.66,0:08:24.46,Default,,0,0,0,,Техникасы жоқ біреудің сылтауы деп ойлаймын.
Dialogue: 0,0:08:25.04,0:08:28.38,Default,,0,0,0,,Бұл сіздің дене шынықтыруды мазақ ету дегенді білдірмейді.
Dialogue: 0,0:08:28.92,0:08:33.38,Default,,0,0,0,,Техника қаншалықты маңызды, мен сізге шындап айтып отырғаным осы.
Dialogue: 0,0:08:33.93,0:08:37.85,Default,,0,0,0,,Сіздің техникаңызға мызғымас сенімділік
Dialogue: 0,0:08:38.47,0:08:42.64,Default,,0,0,0,,Керемет Харухиса Курибаяши Барлығы керемет!
Dialogue: 0,0:08:43.56,0:08:44.81,Default,,0,0,0,,Танысайық
Dialogue: 0,0:08:45.06,0:08:47.48,Default,,0,0,0,,Жоқ, бұл тек кездесу туралы емес...
Dialogue: 0,0:08:47.56,0:08:49.23,Default,,0,0,0,,Бірге ойнағың келсе⸺
Dialogue: 0,0:08:49.90,0:08:52.78,Default,,0,0,0,,А тобына мүмкіндігінше тезірек көтеріліңіз.
Dialogue: 0,0:08:52.90,0:08:53.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:53.99,0:08:57.37,Default,,0,0,0,,Курибаяши міндетті түрде А командасына оралады.
Dialogue: 0,0:08:57.87,0:09:00.74,Default,,0,0,0,,Осы уақытқа дейін сіз А тобында боласыз⸺
Dialogue: 0,0:09:01.04,0:09:03.08,Default,,0,0,0,,Маңызды күшке айналса⸺
Dialogue: 0,0:09:03.79,0:09:07.04,Default,,0,0,0,,Ойыншы ретінде мен онымен тең дәрежеде сөйлесе аламын.
Dialogue: 0,0:09:07.67,0:09:08.50,Default,,0,0,0,,Иә
Dialogue: 0,0:09:09.04,0:09:11.30,Default,,0,0,0,,Осы мақсатта мен бұрын айтқан...
Dialogue: 0,0:09:11.38,0:09:12.09,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:12.17,0:09:14.84,Default,,0,0,0,,Бұл бүгінгі күні Курибаяши пьесасына қосылатын нәрсе ме?
Dialogue: 0,0:09:15.22,0:09:16.76,Default,,0,0,0,,Сонда сіз білесіз!
Dialogue: 0,0:09:17.55,0:09:19.68,Default,,0,0,0,,Солай ма...?
Dialogue: 0,0:09:24.81,0:09:26.94,Default,,0,0,0,,А... а...
Dialogue: 0,0:09:29.27,0:09:30.23,Default,,0,0,0,,Гүлдер ше?
Dialogue: 0,0:09:32.57,0:09:35.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:37.99,0:09:38.78,Default,,0,0,0,,Не...
Dialogue: 0,0:09:38.99,0:09:40.03,Default,,0,0,0,,Барлығың тыңдаңдар!
Dialogue: 0,0:09:40.45,0:09:42.99,Default,,0,0,0,,Мен Йосицүнэ Аомори ойынында жарақат алғанын естідім.
Dialogue: 0,0:09:43.58,0:09:45.54,Default,,0,0,0,,Сонымен А командасы және В командасы⸺
Dialogue: 0,0:09:45.62,0:09:47.87,Default,,0,0,0,,Кейбір ойыншыларды алдыңғы орынға ауыстыру
Dialogue: 0,0:09:48.75,0:09:52.59,Default,,0,0,0,,Фукуда осы демалыс күнгі матчты жеке көргеннен кейін шешім қабылдайтын сияқты.
Dialogue: 0,0:09:53.05,0:09:54.76,Default,,0,0,0,,Бұл сіздің үлкен мүмкіндігіңіз!
Dialogue: 0,0:10:02.35,0:10:03.81,Default,,0,0,0,,Футбол туралы⸺
Dialogue: 0,0:10:04.93,0:10:06.18,Default,,0,0,0,,шұғыл басымдық ретінде қарастырылып, ақпарат іздестіруде
Dialogue: 0,0:10:08.94,0:10:09.98,Default,,0,0,0,,Сен таңқаларлықтай кішкентай екенсің ғой?
Dialogue: 0,0:10:11.48,0:10:13.98,Default,,0,0,0,,Мен оны қайта жасаудың қиындықтарын бастан өткерсем де.
Dialogue: 0,0:10:14.19,0:10:17.95,Default,,0,0,0,,Сіз емін-еркін тамақтанғыңыз келетінін айттыңыз, дәмдірек етейік...
Dialogue: 0,0:10:18.57,0:10:20.28,Default,,0,0,0,,Сен оны маған бере алмадың.
Dialogue: 0,0:10:23.99,0:10:27.46,Default,,0,0,0,,Жарайды, бөлек беру керек емес пе еді?
Dialogue: 0,0:10:28.29,0:10:30.96,Default,,0,0,0,,Сондай-ақ... Жетеді! Үйге ерте қайтайық!
Dialogue: 0,0:10:32.67,0:10:34.25,Default,,0,0,0,,Ашитоға сәттілік
Dialogue: 0,0:10:34.71,0:10:37.88,Default,,0,0,0,,Бұл көрсеткішпен ол А тобына кіре алуы керек еді.
Dialogue: 0,0:10:38.42,0:10:39.55,Default,,0,0,0,,Мазаламау⸺
Dialogue: 0,0:10:39.76,0:10:42.14,Default,,0,0,0,,Мен сені алыстан бақылаймын.
Dialogue: 0,0:10:45.22,0:10:46.10,Default,,0,0,0,,Фукуда
Dialogue: 0,0:10:46.52,0:10:49.27,Default,,0,0,0,,Мен Аои туралы бірдеңе айтқым келеді...
Dialogue: 0,0:10:49.89,0:10:51.69,Default,,0,0,0,,Әлі жоқ... (Фукуда) Неғұрлым ерте болса, соғұрлым жақсы.
Dialogue: 0,0:10:52.81,0:10:53.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:54.94,0:10:56.44,Default,,0,0,0,,Неғұрлым тезірек болса, соғұрлым жақсы
Dialogue: 0,0:10:57.90,0:11:00.61,Default,,0,0,0,,Егер Ашито шынымен келесіде шешілсе⸺
Dialogue: 0,0:11:00.95,0:11:02.91,Default,,0,0,0,,Бұл сіз ойлағаннан да жылдам.
Dialogue: 0,0:11:03.53,0:11:05.24,Default,,0,0,0,,Сіздің нұсқауыңыз жақсы болды.
Dialogue: 0,0:11:05.83,0:11:07.45,Default,,0,0,0,,Рахмет сізге Нозоми
Dialogue: 0,0:11:08.00,0:11:08.87,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:20.67,0:11:22.59,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:11:22.80,0:11:26.31,Default,,0,0,0,,Апта сайын ойын өткізу қандай бақытты!
Dialogue: 0,0:11:26.39,0:11:27.89,Default,,0,0,0,,Көңілді жігіт
Dialogue: 0,0:11:28.14,0:11:32.02,Default,,0,0,0,,Дұрысы, Ашито, шаршаған жоқсың ба? Бет
Dialogue: 0,0:11:32.40,0:11:33.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:34.02,0:11:37.44,Default,,0,0,0,,Өткен аптада мен түнде әдеттегіден көбірек жаттыға бастадым.
Dialogue: 0,0:11:37.82,0:11:39.53,Default,,0,0,0,,Мен сені тоқтатып, тағы да теуіп жіберуім керек пе?
Dialogue: 0,0:11:39.90,0:11:43.57,Default,,0,0,0,,Гаххаха~ Бұл да рас... Бірақ!
Dialogue: 0,0:11:44.03,0:11:45.49,Default,,0,0,0,,Ал, қараңыз!
Dialogue: 0,0:11:45.66,0:11:48.29,Default,,0,0,0,,Мен Курибаяшидің матчын көріп бірдеңе білдім!
Dialogue: 0,0:11:48.54,0:11:50.16,Default,,0,0,0,,Аои-кун (Ашито) Ах...
Dialogue: 0,0:11:50.50,0:11:51.50,Default,,0,0,0,,Бүгін де танысқаныма қуаныштымын
Dialogue: 0,0:11:52.54,0:11:53.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:57.34,0:11:58.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:13.35,0:12:15.40,Default,,0,0,0,,О? Ха
Dialogue: 0,0:12:16.48,0:12:20.03,Default,,0,0,0,,Қараңдар, мен бұл матчта А дәрежесін аламын.
Dialogue: 0,0:12:25.82,0:12:27.70,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:27.87,0:12:30.83,Default,,0,0,0,,Орындыққа отырғанда әркімнің көңіл-күйі әртүрлі.
Dialogue: 0,0:12:31.20,0:12:32.12,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:12:32.62,0:12:34.33,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:12:35.17,0:12:36.13,Default,,0,0,0,,Отомо!
Dialogue: 0,0:12:38.04,0:12:38.88,Default,,0,0,0,,Кері мүйізтұмсық!
Dialogue: 0,0:12:40.75,0:12:41.67,Default,,0,0,0,,Әй
Dialogue: 0,0:12:44.30,0:12:45.80,Default,,0,0,0,,Ku… (Асари) U…
Dialogue: 0,0:12:46.01,0:12:49.31,Default,,0,0,0,,Бір аптадан кейін ынтымақтастық бұрынғыдан да күшейе түсті.
Dialogue: 0,0:12:50.01,0:12:50.85,Default,,0,0,0,,Ішінде
Dialogue: 0,0:12:51.06,0:12:51.85,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:52.14,0:12:53.89,Default,,0,0,0,,Ортада бос орын бар!
Dialogue: 0,0:12:53.98,0:12:55.44,Default,,0,0,0,,Неліктен оны аулап жатыр еді?
Dialogue: 0,0:12:55.98,0:12:56.94,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:12:58.31,0:13:02.57,Default,,0,0,0,,Курибаяши ойынында бірден қосуға болатын нәрселер бар.
Dialogue: 0,0:13:03.49,0:13:05.99,Default,,0,0,0,,Мұны міндетті түрде орындау керек
Dialogue: 0,0:13:06.24,0:13:06.78,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:07.36,0:13:08.74,Default,,0,0,0,,«Өлтіруші асу»!
Dialogue: 0,0:13:08.87,0:13:09.87,Default,,0,0,0,,(торға сәйкес дыбыс)
Dialogue: 0,0:13:11.41,0:13:13.87,Default,,0,0,0,,О? Неліктен?
Dialogue: 0,0:13:15.79,0:13:17.50,Default,,0,0,0,,Бар, жүр!
Dialogue: 0,0:13:19.42,0:13:20.25,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:13:22.05,0:13:22.96,Default,,0,0,0,,Міне, осы жерде.
Dialogue: 0,0:13:23.51,0:13:25.34,Default,,0,0,0,,Курода асумен бір уақытта сырғып шығады
Dialogue: 0,0:13:25.59,0:13:28.80,Default,,0,0,0,,Олай болса, оны тегін алуға болатын жерді мақсат етіңіз...
Dialogue: 0,0:13:29.05,0:13:32.31,Default,,0,0,0,,Көзді ашатын электрлік өлтіруші өтеді!
Dialogue: 0,0:13:33.39,0:13:34.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:35.48,0:13:36.85,Default,,0,0,0,,Arerere?
Dialogue: 0,0:13:37.44,0:13:39.27,Default,,0,0,0,,Ахахаха, не деген!
Dialogue: 0,0:13:39.36,0:13:41.98,Default,,0,0,0,,Мақсаттың қайсысы екенін білмейсіз бе?
Dialogue: 0,0:13:42.32,0:13:45.65,Default,,0,0,0,,Әй... Барғым келген жерге жете алмай жатырмын.
Dialogue: 0,0:13:45.74,0:13:47.03,Default,,0,0,0,,О? Ах...
Dialogue: 0,0:13:48.07,0:13:49.82,Default,,0,0,0,,Ууууууууууу~
Dialogue: 0,0:13:50.03,0:13:52.33,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:13:52.41,0:13:56.25,Default,,0,0,0,,Ол сізге Якинику мейрамханасында кеңес берген сияқты, Анри.
Dialogue: 0,0:13:58.33,0:14:00.67,Default,,0,0,0,,Қанша рет тырыссаң да өтпейді.
Dialogue: 0,0:14:01.21,0:14:04.76,Default,,0,0,0,,Бірақ екеуі де түпнұсқа идеялар⸺
Dialogue: 0,0:14:04.84,0:14:06.09,Default,,0,0,0,,Өте қызықты
Dialogue: 0,0:14:08.43,0:14:10.39,Default,,0,0,0,,Екеуі де жаудың көлеңкесінде⸺
Dialogue: 0,0:14:10.59,0:14:14.18,Default,,0,0,0,,Олар бір-бірін көре алмайтын ойыншыларға лақтырып жатыр.
Dialogue: 0,0:14:16.48,0:14:18.39,Default,,0,0,0,,Мм... (Мотоки) Иә?
Dialogue: 0,0:14:18.98,0:14:21.90,Default,,0,0,0,,Менімен тым көп сөйлесе алмайсыз ба?
Dialogue: 0,0:14:24.69,0:14:25.73,Default,,0,0,0,,Хи хи
Dialogue: 0,0:14:28.45,0:14:29.36,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:34.95,0:14:37.16,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:38.08,0:14:39.87,Default,,0,0,0,,Нұсқау өз қалауынша қалады.
Dialogue: 0,0:14:40.67,0:14:43.59,Default,,0,0,0,,Осы аралықта мен бір ғана нәрсені айтамын.
Dialogue: 0,0:14:44.34,0:14:47.59,Default,,0,0,0,,Балалар, ойнап жатқанда неге орындыққа қарайсыңдар?
Dialogue: 0,0:14:47.67,0:14:48.38,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:48.72,0:14:49.88,Default,,0,0,0,,А? (Отомо және басқалар) Ах...
Dialogue: 0,0:14:50.13,0:14:50.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:51.34,0:14:53.51,Default,,0,0,0,,Менеджермен ойын ойнап жатырсыз ба?
Dialogue: 0,0:14:54.51,0:14:56.14,Default,,0,0,0,,Сіздің жауыңыз алдыңызда.
Dialogue: 0,0:14:56.52,0:14:57.47,Default,,0,0,0,,Ұмытпаңыз
Dialogue: 0,0:14:57.98,0:14:59.89,Default,,0,0,0,,Сізге берілген лауазым –⸺
Dialogue: 0,0:15:00.64,0:15:01.90,Default,,0,0,0,,Бұл тек сізге арналған.
Dialogue: 0,0:15:02.86,0:15:03.77,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:15:11.91,0:15:15.37,Default,,0,0,0,,Барлығы кенеттен сабырлы болып көрінеді.
Dialogue: 0,0:15:15.78,0:15:18.29,Default,,0,0,0,,Мен ешқандай орындықтарды көрмедім, бірақ...
Dialogue: 0,0:15:22.00,0:15:24.29,Default,,0,0,0,,Мұқият қарашы, адам.
Dialogue: 0,0:15:24.92,0:15:26.25,Default,,0,0,0,,Аои (Ашито) Иә!?
Dialogue: 0,0:15:26.63,0:15:27.71,Default,,0,0,0,,Жылдам, бізді Диоға апар.
Dialogue: 0,0:15:28.17,0:15:29.76,Default,,0,0,0,,Курибаяшиден үйренгіңіз келсе⸺
Dialogue: 0,0:15:30.17,0:15:33.22,Default,,0,0,0,,Оның әрбір жасаған қимылына мұқият қараңыз.
Dialogue: 0,0:15:34.72,0:15:37.56,Default,,0,0,0,,Бұл киллер пас немесе қысқа өту болсын⸺
Dialogue: 0,0:15:37.97,0:15:39.10,Default,,0,0,0,,Рұқсат – бұл рұқсат
Dialogue: 0,0:15:39.85,0:15:41.60,Default,,0,0,0,,Бұл мақсатқа жету процесі ғана
Dialogue: 0,0:15:41.69,0:15:42.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:43.10,0:15:44.40,Default,,0,0,0,,Бұл рұқсаттама болды ма?
Dialogue: 0,0:15:44.48,0:15:46.15,Default,,0,0,0,,Не? Бұл өту болды ма?
Dialogue: 0,0:15:46.36,0:15:47.65,Default,,0,0,0,,Бұл өту болды.
Dialogue: 0,0:15:50.32,0:15:53.36,Default,,0,0,0,,Өту - мақсатқа жету процесі...
Dialogue: 0,0:15:57.03,0:15:59.41,Default,,0,0,0,,Мен жақсы боламын
Dialogue: 0,0:16:03.00,0:16:04.88,Default,,0,0,0,,Тұтқаны сол жақта.
Dialogue: 0,0:16:05.29,0:16:06.96,Default,,0,0,0,,Егер бұл жол өтсе...
Dialogue: 0,0:16:07.88,0:16:09.71,Default,,0,0,0,,Алға!
Dialogue: 0,0:16:09.80,0:16:11.42,Default,,0,0,0,,Қырықпырлы дүрбелең шығарып жатыр.
Dialogue: 0,0:16:11.59,0:16:13.22,Default,,0,0,0,,Мен тайып кеттім!
Dialogue: 0,0:16:14.39,0:16:16.76,Default,,0,0,0,,Дүрбелең емес, атыс бағытын кесіңіз!
Dialogue: 0,0:16:19.18,0:16:21.23,Default,,0,0,0,,Мен ортаны көздеу туралы ойладым, бірақ...
Dialogue: 0,0:16:22.02,0:16:23.48,Default,,0,0,0,,Осы жерден не істейміз...
Dialogue: 0,0:16:24.14,0:16:25.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:25.48,0:16:26.19,Default,,0,0,0,,Уф!
Dialogue: 0,0:16:27.06,0:16:28.07,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:16:29.02,0:16:31.44,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:16:31.61,0:16:33.45,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:37.16,0:16:39.70,Default,,0,0,0,,Мына бейбақ мені итеріп жіберді!
Dialogue: 0,0:16:40.41,0:16:42.12,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:16:42.33,0:16:46.21,Default,,0,0,0,,Ашито Бастард, сіз тіпті осындай ұпай жинай аласыз ба?
Dialogue: 0,0:16:46.83,0:16:50.92,Default,,0,0,0,,«Әрбір өту – мақсатқа жету процесі»?
Dialogue: 0,0:16:51.46,0:16:53.34,Default,,0,0,0,,Жақсы айттыңыз, Нозоми.
Dialogue: 0,0:16:56.01,0:16:59.72,Default,,0,0,0,,Бұл өту қандай мақсатты көздейді?
Dialogue: 0,0:17:00.26,0:17:03.18,Default,,0,0,0,,Соны есептеп, бірінші өлтіруші билетін алыңыз
Dialogue: 0,0:17:03.98,0:17:05.89,Default,,0,0,0,,Солай болса да, мен қатты әсер алдым⸺
Dialogue: 0,0:17:06.23,0:17:07.56,Default,,0,0,0,,Соңғы мақсаттың суреті⸺
Dialogue: 0,0:17:07.65,0:17:10.44,Default,,0,0,0,,Мен оны өзіме ғана әкелдім.
Dialogue: 0,0:17:11.69,0:17:14.28,Default,,0,0,0,,Габриэль Батистутаның реинкарнациясы!
Dialogue: 0,0:17:14.36,0:17:15.74,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:17:15.90,0:17:18.24,Default,,0,0,0,,Батистута өлген жоқ!
Dialogue: 0,0:17:18.70,0:17:21.20,Default,,0,0,0,,Әрине, біз өту дәлдігін жақсартамыз!
Dialogue: 0,0:17:21.33,0:17:23.79,Default,,0,0,0,,Бірақ оның үстіне менің міндетім – ұпай жинау!
Dialogue: 0,0:17:23.91,0:17:25.71,Default,,0,0,0,,Форвард ретінде мақтаныш!
Dialogue: 0,0:17:26.00,0:17:27.75,Default,,0,0,0,,Бұл менің жауабым!
Dialogue: 0,0:17:29.42,0:17:32.96,Default,,0,0,0,,Нозоми, мені кейінірек клуб үйіне шақырыңыз.
Dialogue: 0,0:17:33.67,0:17:34.92,Default,,0,0,0,,Мен оны тікелей айтамын
Dialogue: 0,0:17:39.14,0:17:40.14,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:17:41.76,0:17:42.89,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:17:42.97,0:17:44.35,Default,,0,0,0,,Сиқыршы культішілер.
Dialogue: 0,0:17:47.39,0:17:48.31,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:17:50.61,0:17:51.57,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:17:54.03,0:17:56.15,Default,,0,0,0,,Команда 3-0 есебімен жеңіске жетті.
Dialogue: 0,0:17:56.57,0:17:58.61,Default,,0,0,0,,Ашито, мұның бәрі сенің арқаң.
Dialogue: 0,0:17:59.74,0:18:01.12,Default,,0,0,0,,Ағаға рахмет
Dialogue: 0,0:18:01.91,0:18:02.79,Default,,0,0,0,,Әй?
Dialogue: 0,0:18:04.79,0:18:06.79,Default,,0,0,0,,Футбол барған сайын қызық болып барады
Dialogue: 0,0:18:07.41,0:18:10.50,Default,,0,0,0,,Мен бұрын істей алмаған көп нәрсені енді істей аламын.
Dialogue: 0,0:18:10.75,0:18:13.88,Default,,0,0,0,,Бірақ әлі де үйренетін көп нәрсе бар...
Dialogue: 0,0:18:14.21,0:18:15.05,Default,,0,0,0,,Хун
Dialogue: 0,0:18:15.59,0:18:17.67,Default,,0,0,0,,Сіз мені ең жақсы жерге әкелдіңіз
Dialogue: 0,0:18:18.38,0:18:21.43,Default,,0,0,0,,Мен сені кездестіргенім үшін, рахмет!
Dialogue: 0,0:18:22.43,0:18:23.31,Default,,0,0,0,,Иә
Dialogue: 0,0:18:24.97,0:18:26.23,Default,,0,0,0,,Оны A деңгейіне дейін көтеріңіз.
Dialogue: 0,0:18:27.85,0:18:30.56,Default,,0,0,0,,Мен Йосицүнэ-санды жақын арада ауыстырамын деп ойламаңыз.
Dialogue: 0,0:18:31.19,0:18:32.98,Default,,0,0,0,,Мен әлі күнге дейін ақымақпын.
Dialogue: 0,0:18:33.52,0:18:36.53,Default,,0,0,0,,Бірақ ол міндетті түрде өседі!
Dialogue: 0,0:18:36.82,0:18:37.86,Default,,0,0,0,,Тек қарап тұр.
Dialogue: 0,0:18:41.03,0:18:45.24,Default,,0,0,0,,Ойлап қарасам, сол жағажайдан бері бірінші рет оңаша сөйлесіп тұрмыз.
Dialogue: 0,0:18:46.50,0:18:47.62,Default,,0,0,0,,Кешіріңіз, Ашито.
Dialogue: 0,0:18:48.21,0:18:49.71,Default,,0,0,0,,Әлі А деңгейіне дейін көтеру мүмкін емес
Dialogue: 0,0:18:49.79,0:18:50.75,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:51.67,0:18:53.17,Default,,0,0,0,,Неге... неге!
Dialogue: 0,0:18:53.25,0:18:54.04,Default,,0,0,0,,Ашито
Dialogue: 0,0:18:55.63,0:18:57.09,Default,,0,0,0,,Қорғаушыға айналу
Dialogue: 0,0:18:59.13,0:19:00.97,Default,,0,0,0,,Толық қорғау
Dialogue: 0,0:19:01.39,0:19:04.47,Default,,0,0,0,,Қорғаушы маман ретінде⸺
Dialogue: 0,0:19:04.64,0:19:05.81,Default,,0,0,0,,Дүниеге шығыңыз
Dialogue: 0,0:19:16.82,0:19:17.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:20.32,0:19:22.45,Default,,0,0,0,,Қорғаушыға айналу…
Dialogue: 0,0:19:23.57,0:19:26.37,Default,,0,0,0,,Не... не айтып тұрсың... жақсы...
Dialogue: 0,0:19:27.33,0:19:28.83,Default,,0,0,0,,Сіз дұрыс адамсыз.
Dialogue: 0,0:19:29.91,0:19:32.79,Default,,0,0,0,,Мен сені болашақта ешқашан шабуылшы ретінде пайдаланбаймын.
Dialogue: 0,0:19:33.79,0:19:35.21,Default,,0,0,0,,Толық түрлендіру.
Dialogue: 0,0:19:36.21,0:19:38.42,Default,,0,0,0,,О... менің...
Dialogue: 0,0:19:40.34,0:19:41.59,Default,,0,0,0,,Алға…
Dialogue: 0,0:19:42.55,0:19:43.59,Default,,0,0,0,,Ал...
Dialogue: 0,0:19:44.80,0:19:48.35,Default,,0,0,0,,Бұл менің... жұмыс істемейді дегенді білдіре ме?
Dialogue: 0,0:19:49.47,0:19:50.56,Default,,0,0,0,,Форвард ретінде…
Dialogue: 0,0:19:51.73,0:19:53.60,Default,,0,0,0,,Ол соншалықты белсенді болса да!?
Dialogue: 0,0:19:53.73,0:19:56.52,Default,,0,0,0,,О... мен, мына екі ойын...
Dialogue: 0,0:19:57.27,0:20:01.24,Default,,0,0,0,,Сіз өзіңіздің табиғи талантыңыздың арқасында жетістікке жете алдыңыз.
Dialogue: 0,0:20:01.95,0:20:03.45,Default,,0,0,0,,Көп нәрсе осыған байланысты.
Dialogue: 0,0:20:04.11,0:20:05.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:05.37,0:20:06.62,Default,,0,0,0,,Бұрын болған болуы керек⸺
Dialogue: 0,0:20:06.70,0:20:09.08,Default,,0,0,0,,Бұл 100% көрсете алмайтын талант.
Dialogue: 0,0:20:09.87,0:20:12.37,Default,,0,0,0,,Жағдайды арт жағынан қарау арқылы...
Dialogue: 0,0:20:12.46,0:20:14.04,Default,,0,0,0,,Не айтып тұрғаныңызды түсінбедім!
Dialogue: 0,0:20:14.21,0:20:15.75,Default,,0,0,0,,Маған ұнамайды! Мен оны ұнатпаймын!
Dialogue: 0,0:20:15.88,0:20:18.05,Default,,0,0,0,,Мен әлемнің үздік шабуылшысы болғым келеді⸺
Dialogue: 0,0:20:18.13,0:20:19.13,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,0:20:19.80,0:20:22.55,Default,,0,0,0,,Форвард ретінде неге тиімді емес екеніңізді айтыңыз.
Dialogue: 0,0:20:23.30,0:20:25.93,Default,,0,0,0,,Біріншіден, доп аяғыңызға сыймайды.
Dialogue: 0,0:20:27.22,0:20:28.89,Default,,0,0,0,,A бірінші орында жұмыс істемейді.
Dialogue: 0,0:20:29.35,0:20:32.27,Default,,0,0,0,,Жаттығу! Мен қазір жақсымын...
Dialogue: 0,0:20:32.35,0:20:35.81,Default,,0,0,0,,Шапшаңдық пен қысқа жүгіру қабілетінің болмауы
Dialogue: 0,0:20:36.69,0:20:38.98,Default,,0,0,0,,Алғашқы 10 метрде сызықтық қуат жоқ
Dialogue: 0,0:20:39.48,0:20:41.32,Default,,0,0,0,,Бұл өте қауіпті
Dialogue: 0,0:20:44.74,0:20:46.57,Default,,0,0,0,,Мен ұпай жинау сезімін қабылдаймын.
Dialogue: 0,0:20:46.99,0:20:49.83,Default,,0,0,0,,Бірақ мен оны жоғары көтеруге мүмкіндігім жоқ.
Dialogue: 0,0:20:53.08,0:20:57.17,Default,,0,0,0,,Бұл жастыққа ерте кірмеу сияқты экологиялық мәселе емес.
Dialogue: 0,0:20:58.00,0:20:59.34,Default,,0,0,0,,Сіз немен туыласыз?
Dialogue: 0,0:21:00.42,0:21:02.13,Default,,0,0,0,,Сіз дүниеге келген сәт⸺
Dialogue: 0,0:21:02.55,0:21:06.51,Default,,0,0,0,,Біз сенің шабуылшы емес екеніңді шештік.
Dialogue: 0,0:21:09.60,0:21:11.10,Default,,0,0,0,,Мен басынан бастап шештім
Dialogue: 0,0:21:11.35,0:21:13.89,Default,,0,0,0,,Мен сені Футамиде алғаш көргенде⸺
Dialogue: 0,0:21:14.64,0:21:16.02,Default,,0,0,0,,Менің басымда⸺
Dialogue: 0,0:21:16.27,0:21:19.31,Default,,0,0,0,,Ұзақ уақыт бос тұрған толық бос кеңістікте⸺
Dialogue: 0,0:21:20.36,0:21:22.03,Default,,0,0,0,,Шығарма сізді...
Dialogue: 0,0:21:22.53,0:21:23.86,Default,,0,0,0,,Бұл не!
Dialogue: 0,0:21:24.28,0:21:26.86,Default,,0,0,0,,Онда неге басынан айтпадың?
Dialogue: 0,0:21:27.28,0:21:28.57,Default,,0,0,0,,Неге қазір?
Dialogue: 0,0:21:28.87,0:21:30.20,Default,,0,0,0,,Айтсам келмес едің.
Dialogue: 0,0:21:30.78,0:21:31.66,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:21:32.29,0:21:33.87,Default,,0,0,0,,Бұл ең жақсы уақыт
Dialogue: 0,0:21:36.50,0:21:37.37,Default,,0,0,0,,Маған ұнамайды...
Dialogue: 0,0:21:37.58,0:21:39.71,Default,,0,0,0,,Мен қорғаушыларды жек көремін...
Dialogue: 0,0:21:40.46,0:21:42.63,Default,,0,0,0,,Өтінемін, ағай...
Dialogue: 0,0:21:43.01,0:21:44.26,Default,,0,0,0,,Ұнамаса, жасама.
Dialogue: 0,0:21:45.09,0:21:46.88,Default,,0,0,0,,Жастар футбол мектебі емес
Dialogue: 0,0:21:47.72,0:21:50.51,Default,,0,0,0,,Сізге пайдасы жоқ екенін білетін адамды қалдыра алмайсыз.
Dialogue: 0,0:21:53.97,0:21:55.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:07.57,0:22:08.61,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:22:12.45,0:22:14.16,Default,,0,0,0,,Ах... Аой ойыншысы
Dialogue: 0,0:22:16.33,0:22:17.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:17.54,0:22:18.58,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:22:26.51,0:22:27.67,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:22:29.30,0:22:30.43,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:22:36.02,0:22:42.02,Default,,0,0,0,,♪～
Dialogue: 0,0:23:59.89,0:24:05.90,Default,,0,0,0,,～♪
Dialogue: 0,0:24:24.37,0:24:25.96,Default,,0,0,0,,Келесі жолы «Аоаши»
Dialogue: 0,0:24:26.21,0:24:27.59,Default,,0,0,0,,«Тек футбол»
Dialogue: 0,0:24:29.09,0:24:35.09,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory