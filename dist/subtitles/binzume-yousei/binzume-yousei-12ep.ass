Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.40,0:00:16.10,Default,,0,0,0,,Сиқырлы елдегі қыз
Dialogue: 0,0:00:17.13,0:00:21.43,Default,,0,0,0,,Өте кішкентай ертегі
Dialogue: 0,0:00:22.36,0:00:31.23,Default,,0,0,0,,Дүниеде не істегіңіз келеді?
Dialogue: 0,0:00:31.30,0:00:36.93,Default,,0,0,0,,Сұлу қыз Буки Буки Пайо
Dialogue: 0,0:00:37.03,0:00:41.56,Default,,0,0,0,,Аа, айтыңызшы, ұстаз.
Dialogue: 0,0:00:41.93,0:00:48.00,Default,,0,0,0,,Мен бұл туралы көбірек білгім келеді.
Dialogue: 0,0:00:48.23,0:00:52.96,Default,,0,0,0,,Ах Сенсей-сан
Dialogue: 0,0:00:53.06,0:01:02.20,Default,,0,0,0,,Ғажайып сырлар, айта алмайтын нәрселердің бәрі
Dialogue: 0,0:01:10.93,0:01:13.00,Default,,0,0,0,,«Наурыз»
Dialogue: 0,0:01:15.83,0:01:20.43,Default,,0,0,0,,«Жарықтарды күңгірт қосайық.»
Dialogue: 0,0:01:20.83,0:01:25.36,Default,,0,0,0,,Маған гүлдер берейін, шабдалы гүлдері~”
Dialogue: 0,0:01:26.63,0:01:28.76,Default,,0,0,0,,Қуыршақ фестивалі осы ма?
Dialogue: 0,0:01:29.20,0:01:33.83,Default,,0,0,0,,Дұрыс. «Шабдалы фестивалі» деп те аталады, бұл қыздарға арналған фестиваль!
Dialogue: 0,0:01:34.33,0:01:37.16,Default,,0,0,0,,Yaho қыздар фестивалі~
Dialogue: 0,0:01:37.23,0:01:40.20,Default,,0,0,0,,Бұл мамырдағы Балаларды қорғау күніне қарсы.
Dialogue: 0,0:01:40.80,0:01:44.16,Default,,0,0,0,,Дұрыс, бүгін қыз басты кейіпкер!
Dialogue: 0,0:01:44.56,0:01:46.86,Default,,0,0,0,,Басты кейіпкер ~ Бас кейіпкер ~
Dialogue: 0,0:01:47.70,0:01:49.10,Default,,0,0,0,,Уа~
Dialogue: 0,0:01:50.66,0:01:51.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:53.00,0:01:54.33,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:01:54.93,0:01:57.43,Default,,0,0,0,,Ішінде хат бар сияқты...
Dialogue: 0,0:01:58.23,0:01:58.73,Default,,0,0,0,,Ура!
Dialogue: 0,0:02:00.10,0:02:00.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:00.83,0:02:01.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:01.90,0:02:03.86,Default,,0,0,0,,Бұл ертегілер әлемінен келген хат.
Dialogue: 0,0:02:04.46,0:02:05.43,Default,,0,0,0,,Бұл дұрыс~
Dialogue: 0,0:02:05.83,0:02:08.53,Default,,0,0,0,,Бұл ертегілер әлемінен келген хат екені сөзсіз.
Dialogue: 0,0:02:09.13,0:02:10.90,Default,,0,0,0,,Онда не айтылған?
Dialogue: 0,0:02:11.76,0:02:17.26,Default,,0,0,0,,«Сіздің оқу жылыңыз қалай өтті? Сіз адам бола аламын деп ойлайсыз ба?»
Dialogue: 0,0:02:17.73,0:02:18.26,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:02:19.23,0:02:21.63,Default,,0,0,0,,Түсіндім, бір жылға жуықтап қалды...
Dialogue: 0,0:02:21.93,0:02:23.73,Default,,0,0,0,,Көп нәрсе болды.
Dialogue: 0,0:02:24.03,0:02:24.60,Default,,0,0,0,,Хмм
Dialogue: 0,0:02:25.03,0:02:30.83,Default,,0,0,0,,Үйленіңіз, шытырман оқиғаға барыңыз, лайлы ағынға ағып кетіңіз, сүрініп, драмаға барыңыз ...
Dialogue: 0,0:02:31.66,0:02:34.73,Default,,0,0,0,,Жарайды, соны тыңдасаң, төбелеске толы.
Dialogue: 0,0:02:35.16,0:02:36.36,Default,,0,0,0,,Сіз қауіпсізсіз деп үміттенемін.
Dialogue: 0,0:02:36.83,0:02:37.63,Default,,0,0,0,,Мен көремін~
Dialogue: 0,0:02:37.76,0:02:42.43,Default,,0,0,0,,Бұл мектеп бітіру маусымы, сондықтан мұндай хат келетіні мағынасы бар.
Dialogue: 0,0:02:43.36,0:02:44.83,Default,,0,0,0,,Мектеп бітіру маусымы?
Dialogue: 0,0:02:45.30,0:02:45.83,Default,,0,0,0,,Иә
Dialogue: 0,0:02:46.10,0:02:49.93,Default,,0,0,0,,Бітіру маусымы... Бұрынғы күйді бітірген кез.
Dialogue: 0,0:02:50.16,0:02:53.10,Default,,0,0,0,,Жаңа сен ретінде қайта туылатын маусым!
Dialogue: 0,0:02:53.23,0:02:54.20,Default,,0,0,0,,О!
Dialogue: 0,0:02:54.53,0:02:55.63,Default,,0,0,0,,Сондықтан
Dialogue: 0,0:02:55.76,0:02:58.40,Default,,0,0,0,,Тама-чан да осы айда бірінші сыныпты бітірді.
Dialogue: 0,0:02:59.33,0:03:03.36,Default,,0,0,0,,Келесі айдан бастап мен екінші курстың жаңа студенті болып қайта туамын, Тама-чан!
Dialogue: 0,0:03:03.60,0:03:05.13,Default,,0,0,0,,Керемет таңқаларлық!
Dialogue: 0,0:03:05.30,0:03:09.56,Default,,0,0,0,,Оқу бітірген соң біз де адам болып қайта туамыз ба деп ойлаймын.
Dialogue: 0,0:03:09.76,0:03:11.06,Default,,0,0,0,,Мен сенімдімін!
Dialogue: 0,0:03:11.76,0:03:15.06,Default,,0,0,0,,Олай болса, не болса да, оқуды бітіру керек, бәрің!
Dialogue: 0,0:03:15.33,0:03:16.10,Default,,0,0,0,,О!
Dialogue: 0,0:03:16.43,0:03:20.66,Default,,0,0,0,,Бірақ, бітірудің басқа мағынасы да бар.
Dialogue: 0,0:03:21.03,0:03:22.56,Default,,0,0,0,,Басқа мағынасы?
Dialogue: 0,0:03:22.63,0:03:23.26,Default,,0,0,0,,Шабуыл
Dialogue: 0,0:03:23.70,0:03:25.76,Default,,0,0,0,,Бұл... Қош бол!
Dialogue: 0,0:03:26.63,0:03:27.43,Default,,0,0,0,,Теңіз балдыры?
Dialogue: 0,0:03:27.96,0:03:31.23,Default,,0,0,0,,Жоқ, қоштасу – қоштасу.
Dialogue: 0,0:03:31.73,0:03:37.50,Default,,0,0,0,,Тама-чан да өзінің жақсы достары Нори-чан мен Мии Чанмен қоштасып, жаңа сабақ бастауы мүмкін.
Dialogue: 0,0:03:37.90,0:03:41.66,Default,,0,0,0,,Дегенмен, сол сынақтан өткеннен кейін ғана сіз шынымен оқуды бітіре аласыз!
Dialogue: 0,0:03:41.96,0:03:42.83,Default,,0,0,0,,Гаааан!
Dialogue: 0,0:03:43.33,0:03:44.03,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:03:44.26,0:03:48.56,Default,,0,0,0,,Мүмкін бір сыныпта оқитын шығармыз, жалпы...
Dialogue: 0,0:03:49.73,0:03:52.46,Default,,0,0,0,,О? Бәрің қайда бардыңдар?
Dialogue: 0,0:03:53.16,0:03:56.73,Default,,0,0,0,,Сол... Мектеп бітіру мен қоштасу бір жиында...
Dialogue: 0,0:03:56.96,0:04:01.90,Default,,0,0,0,,Оқу бітіргенде... Басқаша айтқанда, адам болған кезде...
Dialogue: 0,0:04:02.16,0:04:05.46,Default,,0,0,0,,Бұл бәрімен қоштасуым керек дегенді білдіре ме...
Dialogue: 0,0:04:06.00,0:04:08.43,Default,,0,0,0,,Тама-чан мен Сенсей-санмен...?
Dialogue: 0,0:04:08.60,0:04:09.10,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:09.43,0:04:14.56,Default,,0,0,0,,Жоқ, жоқ, жоқ! Мен барлығымен қоштасқым келмейді!
Dialogue: 0,0:04:14.76,0:04:15.73,Default,,0,0,0,,Мен де!
Dialogue: 0,0:04:15.93,0:04:16.90,Default,,0,0,0,,Мен де
Dialogue: 0,0:04:17.10,0:04:18.26,Default,,0,0,0,,Мүлде жоқ~
Dialogue: 0,0:04:18.83,0:04:23.76,Default,,0,0,0,,Олай болса, оқу бітірмей-ақ қояйық! Осылайша біз бәріміз бірге бола аламыз!
Dialogue: 0,0:04:24.23,0:04:25.73,Default,,0,0,0,,Бұл тамаша идея!
Dialogue: 0,0:04:26.06,0:04:28.33,Default,,0,0,0,,Бәрі өз орнына келетіні рас.
Dialogue: 0,0:04:28.73,0:04:34.16,Default,,0,0,0,,А, бірақ... бұл мен адам бола алмаймын дегенді білдіре ме?
Dialogue: 0,0:04:34.43,0:04:34.93,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:35.20,0:04:37.70,Default,,0,0,0,,Бұл, әрине, солай.
Dialogue: 0,0:04:39.40,0:04:43.03,Default,,0,0,0,,Адам болу үшін қоштасу керек...
Dialogue: 0,0:04:43.36,0:04:46.30,Default,,0,0,0,,Қоштаспасам, адам бола алмаймын...
Dialogue: 0,0:04:47.23,0:04:49.20,Default,,0,0,0,,Қоштасқым келмейді...
Dialogue: 0,0:04:51.16,0:04:52.30,Default,,0,0,0,,Не?
Dialogue: 0,0:04:53.50,0:04:54.06,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:57.23,0:04:57.93,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:58.60,0:04:59.56,Default,,0,0,0,,Не? не?
Dialogue: 0,0:05:00.76,0:05:01.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:03.40,0:05:05.56,Default,,0,0,0,,«Бұл адам мырзаның жұлдызы
Dialogue: 0,0:05:06.06,0:05:10.13,Default,,0,0,0,,Егер сіз оны сиқырласаңыз, сіз Адам мырзаға айналасыз».
Dialogue: 0,0:05:11.03,0:05:12.40,Default,,0,0,0,,Адам жұлдызы?
Dialogue: 0,0:05:13.40,0:05:14.90,Default,,0,0,0,,Адам бола аласың...
Dialogue: 0,0:05:15.66,0:05:19.90,Default,,0,0,0,,Біздің жігерімізді ертегілер әлемі мойындады.
Dialogue: 0,0:05:20.43,0:05:22.60,Default,,0,0,0,,Ух мм, дұрыс...
Dialogue: 0,0:05:23.40,0:05:23.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:26.06,0:05:26.93,Default,,0,0,0,,Куруру-чан?
Dialogue: 0,0:05:27.53,0:05:31.00,Default,,0,0,0,,Мен мұны алған жоқпын. Мен оны көрмеген сияқтымын.
Dialogue: 0,0:05:31.56,0:05:33.13,Default,,0,0,0,,Ендеше оны қайтадан бөтелкеге ​​салайық.
Dialogue: 0,0:05:34.06,0:05:37.23,Default,,0,0,0,,Күте тұрыңыз, Куруру, бұл шынымен жақсы ма?
Dialogue: 0,0:05:37.76,0:05:41.63,Default,,0,0,0,,Біз мұнда Адам мырза болу үшін келдік және...
Dialogue: 0,0:05:41.70,0:05:44.43,Default,,0,0,0,,Өйткені мен қоштасуым керек.
Dialogue: 0,0:05:44.60,0:05:45.30,Default,,0,0,0,,Куруру…
Dialogue: 0,0:05:45.96,0:05:49.36,Default,,0,0,0,,Адам болған соң бәрімен қоштасу керек!
Dialogue: 0,0:05:49.76,0:05:51.00,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:51.46,0:05:53.93,Default,,0,0,0,,Ондай жағдайда адам болудың қажеті жоқ.
Dialogue: 0,0:05:54.33,0:05:55.66,Default,,0,0,0,,Ах... бірақ...
Dialogue: 0,0:05:56.43,0:05:59.03,Default,,0,0,0,,Мен адам болғым келеді...
Dialogue: 0,0:05:59.70,0:06:03.60,Default,,0,0,0,,Сенсэй-сан мен Тама-чан сияқты адамдарға...
Dialogue: 0,0:06:04.03,0:06:06.46,Default,,0,0,0,,Хороро-чан жақсы ма?
Dialogue: 0,0:06:06.76,0:06:10.30,Default,,0,0,0,,үшінмен қоштасуға тура келсе де, бәрі жақсы ма?
Dialogue: 0,0:06:10.76,0:06:11.30,Default,,0,0,0,,Хмм.
Dialogue: 0,0:06:11.83,0:06:15.30,Default,,0,0,0,,Бірақ мен бұл үшін бір жыл бойы көп жұмыс жасадым.
Dialogue: 0,0:06:16.16,0:06:17.50,Default,,0,0,0,,Эй, Чи Чан
Dialogue: 0,0:06:17.86,0:06:19.50,Default,,0,0,0,,Ух... Хороро-чан...
Dialogue: 0,0:06:20.06,0:06:20.76,Default,,0,0,0,,(Кения) Бірақ білесің бе, біз оны Саторудың аурухана шығындарын жабуға көмектеседі деп ойладық➡
Dialogue: 0,0:06:21.10,0:06:21.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:22.50,0:06:23.76,Default,,0,0,0,,Хороро дұрыс айтады.
Dialogue: 0,0:06:25.53,0:06:30.36,Default,,0,0,0,,Осы уақытқа дейін біз адам мырза болуға тырыстық...
Dialogue: 0,0:06:34.96,0:06:37.33,Default,,0,0,0,,Мен бұл күш-жігерімнің босқа кетуіне жол беруім керек пе?
Dialogue: 0,0:06:37.86,0:06:39.83,Default,,0,0,0,,Біз адам болдық
Dialogue: 0,0:06:40.10,0:06:45.70,Default,,0,0,0,,Осы уақытқа дейін қамқорлық жасап келе жатқан ұстаздар мен Тама-чанға өткен жылғы жетістіктерді көрсету керек.
Dialogue: 0,0:06:46.36,0:06:51.06,Default,,0,0,0,,Қалай ойлайсыңдар, бұл біздің перілер ретіндегі нағыз бітіруіміз емес пе?
Dialogue: 0,0:06:55.93,0:06:56.50,Default,,0,0,0,,Куруру...?
Dialogue: 0,0:06:57.80,0:07:03.23,Default,,0,0,0,,Дұрыс, адам болып, мұғалімді таң қалдыру керек.
Dialogue: 0,0:07:06.13,0:07:08.23,Default,,0,0,0,,Сіз мені таң қалдыруыңыз керек...
Dialogue: 0,0:07:11.33,0:07:11.83,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:13.66,0:07:14.96,Default,,0,0,0,,Бұл жақсы емес!
Dialogue: 0,0:07:15.53,0:07:16.23,Default,,0,0,0,,Чирири!
Dialogue: 0,0:07:16.43,0:07:18.76,Default,,0,0,0,,Адам болудың қажеті жоқ!
Dialogue: 0,0:07:19.36,0:07:23.90,Default,,0,0,0,,Сонда да бәрімен қоштасқым келмейді!
Dialogue: 0,0:07:24.30,0:07:24.96,Default,,0,0,0,,Чирин?
Dialogue: 0,0:07:26.76,0:07:31.36,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:31.63,0:07:32.36,Default,,0,0,0,,Чирин!
Dialogue: 0,0:07:32.60,0:07:34.13,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,0:07:35.10,0:07:38.53,Default,,0,0,0,,Мен оны саған бермеймін! Мен бұл жұлдызды ешқашан тастамаймын!
Dialogue: 0,0:07:39.13,0:07:39.83,Default,,0,0,0,,Чиририн…
Dialogue: 0,0:07:40.36,0:07:43.53,Default,,0,0,0,,Неліктен адам болғың келеді?
Dialogue: 0,0:07:44.90,0:07:46.93,Default,,0,0,0,,Адам болған кезде...
Dialogue: 0,0:07:53.80,0:07:55.23,Default,,0,0,0,,Маған бұл ұнамайды!
Dialogue: 0,0:07:55.30,0:07:56.03,Default,,0,0,0,,Чирири!
Dialogue: 0,0:07:56.23,0:07:56.73,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:58.03,0:07:58.96,Default,,0,0,0,,Мен де...
Dialogue: 0,0:08:02.80,0:08:05.66,Default,,0,0,0,,Тіпті мен бәрімен қоштасқым келмейді!
Dialogue: 0,0:08:06.46,0:08:07.33,Default,,0,0,0,,Сара-чан...
Dialogue: 0,0:08:08.50,0:08:09.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:10.53,0:08:13.06,Default,,0,0,0,,Бірге адам болайық Чирин
Dialogue: 0,0:08:13.76,0:08:14.60,Default,,0,0,0,,Куруру-чан...
Dialogue: 0,0:08:15.06,0:08:19.20,Default,,0,0,0,,Қоштассақ та дос боламыз.
Dialogue: 0,0:08:19.93,0:08:20.80,Default,,0,0,0,,Хороро-чан...
Dialogue: 0,0:08:22.96,0:08:23.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:26.13,0:08:26.63,Default,,0,0,0,,Хмм
Dialogue: 0,0:08:31.93,0:08:32.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:34.56,0:08:35.13,Default,,0,0,0,,Иә
Dialogue: 0,0:08:36.93,0:08:37.66,Default,,0,0,0,,Мен үйдемін~
Dialogue: 0,0:08:39.86,0:08:40.36,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:45.20,0:08:46.46,Default,,0,0,0,,Қалайсыңдар?
Dialogue: 0,0:08:47.00,0:08:50.10,Default,,0,0,0,,Куруру мен оның достары адам болуға шешім қабылдады.
Dialogue: 0,0:08:50.60,0:08:51.70,Default,,0,0,0,,Адам болу?
Dialogue: 0,0:08:52.30,0:08:52.80,Default,,0,0,0,,Иә
Dialogue: 0,0:08:52.90,0:08:55.86,Default,,0,0,0,,Оқуды бітірген соң қайта туамын.
Dialogue: 0,0:08:56.76,0:09:00.46,Default,,0,0,0,,Ол үшін мен ұстазыммен қоштасуым керек.
Dialogue: 0,0:09:01.26,0:09:02.43,Default,,0,0,0,,Бірақ бұған дейін
Dialogue: 0,0:09:02.66,0:09:07.06,Default,,0,0,0,,Бізді адам ретінде көруіңді күттім!
Dialogue: 0,0:09:08.20,0:09:13.73,Default,,0,0,0,,Қош бол...? Әй, түсіндім... менің тілегім ақыры орындалды.
Dialogue: 0,0:09:14.63,0:09:15.93,Default,,0,0,0,,Баршаңызды құттықтаймын
Dialogue: 0,0:09:17.43,0:09:21.03,Default,,0,0,0,,Өткен жылға рахмет, мұғалім.
Dialogue: 0,0:09:21.43,0:09:24.80,Default,,0,0,0,,Мен сізден көп нәрсені үйренгеніме өте қуаныштымын.
Dialogue: 0,0:09:25.30,0:09:29.03,Default,,0,0,0,,Бірге өткізген уақыт – біздің құнды жадымыз.
Dialogue: 0,0:09:29.46,0:09:34.30,Default,,0,0,0,,Мен сені ешқашан ұмытпаймын~ Мен сені ешқашан ұмытпаймын, Сенсей мырза...
Dialogue: 0,0:09:35.10,0:09:37.40,Default,,0,0,0,,Мен сізді жақсы көремін, мұғалім.
Dialogue: 0,0:09:38.73,0:09:40.46,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:09:41.73,0:09:43.56,Default,,0,0,0,,Маған рахмет.
Dialogue: 0,0:09:46.13,0:09:49.16,Default,,0,0,0,,үшінмен болған естеліктерді ешқашан ұмытпаймын
Dialogue: 0,0:09:50.46,0:09:50.96,Default,,0,0,0,,Уф
Dialogue: 0,0:09:51.26,0:09:56.33,Default,,0,0,0,,Мұғалім! Уф...
Dialogue: 0,0:09:56.40,0:10:00.13,Default,,0,0,0,,Сіз қайта туыласыз, солай ма? Көз жасыңды сүрт.
Dialogue: 0,0:10:00.66,0:10:03.06,Default,,0,0,0,,Ал... Ух...
Dialogue: 0,0:10:04.66,0:10:05.80,Default,,0,0,0,,(Жолаушы) Білемін, білемін. Сен бар күшіңді салып жатқан сияқтысың.
Dialogue: 0,0:10:06.83,0:10:09.16,Default,,0,0,0,,Олай болса бәрің, адам болыңдар!
Dialogue: 0,0:10:09.60,0:10:10.13,Default,,0,0,0,,О!
Dialogue: 0,0:10:26.30,0:10:29.06,Default,,0,0,0,,Адам бол!
Dialogue: 0,0:10:53.63,0:10:54.43,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:54.96,0:10:55.96,Default,,0,0,0,,Мен жасадым!
Dialogue: 0,0:10:56.66,0:10:57.86,Default,,0,0,0,,Адам мырзаға
Dialogue: 0,0:10:58.36,0:10:59.13,Default,,0,0,0,,Мен үйреніп қалдым!
Dialogue: 0,0:11:01.16,0:11:06.06,Default,,0,0,0,,Мен жасадым~ Жақсы адам болдым, ұстаз!
Dialogue: 0,0:11:07.36,0:11:10.03,Default,,0,0,0,,Сонымен... бір ғана адам...
Dialogue: 0,0:11:10.56,0:11:14.26,Default,,0,0,0,,Иә? иә? иә? иә? иә? Хмм?
Dialogue: 0,0:11:14.63,0:11:17.46,Default,,0,0,0,,Ой! Төртеуміз енді жалғызбыз!
Dialogue: 0,0:11:18.43,0:11:21.36,Default,,0,0,0,,Дәл бір рух~?
Dialogue: 0,0:11:28.23,0:11:40.30,Default,,0,0,0,,Қыстың барлық сезімі ақ түске боялған
Dialogue: 0,0:11:41.23,0:11:51.96,Default,,0,0,0,,Сол адамның көлеңкесін де көруді қиындату
Dialogue: 0,0:11:54.30,0:12:00.70,Default,,0,0,0,,Із, із, артта қалды
Dialogue: 0,0:12:00.76,0:12:02.16,Default,,0,0,0,,Бірақ
Dialogue: 0,0:12:03.96,0:12:11.13,Default,,0,0,0,,Әй, қар, қар, бәрін өшіреді
Dialogue: 0,0:12:11.56,0:12:17.60,Default,,0,0,0,,Жолда жазылған «Мен сені сүйемін» сөзі
Dialogue: 0,0:12:18.10,0:12:21.00,Default,,0,0,0,,Бірақ, бірақ.
Dialogue: 0,0:12:21.36,0:12:33.03,Default,,0,0,0,,Өшіре алмаған – жүрегің, Жүрегіңде жасырылған сезім
Dialogue: 0,0:12:34.53,0:12:40.53,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
