Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.40,0:00:16.10,Default,,0,0,0,,Сиқырлы елдегі қыз
Dialogue: 0,0:00:17.13,0:00:21.43,Default,,0,0,0,,Өте кішкентай ертегі
Dialogue: 0,0:00:22.36,0:00:31.23,Default,,0,0,0,,Дүниеде не істегіңіз келеді?
Dialogue: 0,0:00:31.30,0:00:36.93,Default,,0,0,0,,Керемет ханым Пуки Пуки Пайо
Dialogue: 0,0:00:37.03,0:00:41.56,Default,,0,0,0,,Аа, айтыңызшы, ұстаз.
Dialogue: 0,0:00:41.93,0:00:48.00,Default,,0,0,0,,Мен бұл туралы көбірек білгім келеді.
Dialogue: 0,0:00:48.23,0:00:52.96,Default,,0,0,0,,Ах Сенсей-сан
Dialogue: 0,0:00:53.06,0:01:02.20,Default,,0,0,0,,Ғажайып сырлар, айта алмайтын нәрселердің бәрі
Dialogue: 0,0:01:11.56,0:01:12.56,Default,,0,0,0,,«Ақпан»
Dialogue: 0,0:01:15.73,0:01:17.00,Default,,0,0,0,,Хехехе
Dialogue: 0,0:01:17.13,0:01:18.50,Default,,0,0,0,,Вахахаха
Dialogue: 0,0:01:18.66,0:01:19.83,Default,,0,0,0,,-Уау~ -Болды.
Dialogue: 0,0:01:20.36,0:01:22.73,Default,,0,0,0,,-Хаа~ -Хехехехехехехехехехехехехехэ
Dialogue: 0,0:01:23.10,0:01:24.50,Default,,0,0,0,,Тым көп ойнау!
Dialogue: 0,0:01:24.66,0:01:25.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:26.13,0:01:30.60,Default,,0,0,0,,Қазір студенттер емтихан маусымының ортасында.
Dialogue: 0,0:01:30.90,0:01:34.20,Default,,0,0,0,,Жалғыз өзіміз ғана жалығамыз ба? ?
Dialogue: 0,0:01:34.66,0:01:35.83,Default,,0,0,0,,Хооооо
Dialogue: 0,0:01:36.13,0:01:40.16,Default,,0,0,0,,Сондықтан біз де емтихан тапсырғымыз келеді.
Dialogue: 0,0:01:40.83,0:01:41.80,Default,,0,0,0,,Хмф! Ахх
Dialogue: 0,0:01:42.10,0:01:46.30,Default,,0,0,0,,Ойнап жүріп адам болмайтыны рас.
Dialogue: 0,0:01:46.53,0:01:50.33,Default,,0,0,0,,Куруру-чан, сен қандай сынақтан өтесің?
Dialogue: 0,0:01:53.43,0:01:57.36,Default,,0,0,0,,Мен бұл махаббаттан өтетініме сенімдімін!
Dialogue: 0,0:01:57.90,0:01:59.50,Default,,0,0,0,,Әулие Валентин күні
Dialogue: 0,0:01:59.63,0:02:01.33,Default,,0,0,0,,-Уаааааааааааааааааааааааааааа
Dialogue: 0,0:02:01.53,0:02:03.30,Default,,0,0,0,,Ах... бірақ...
Dialogue: 0,0:02:03.56,0:02:05.30,Default,,0,0,0,,Әулие Валентин күні дегеніміз не?
Dialogue: 0,0:02:06.40,0:02:07.93,Default,,0,0,0,,- Мен не істеуім керек? -Не істеуім керек?
Dialogue: 0,0:02:08.20,0:02:08.96,Default,,0,0,0,,Уф!
Dialogue: 0,0:02:09.43,0:02:10.80,Default,,0,0,0,,Айтпақшы, бір жедел мәселе…
Dialogue: 0,0:02:10.90,0:02:12.16,Default,,0,0,0,,-Ах... -Ууууу...
Dialogue: 0,0:02:12.23,0:02:14.23,Default,,0,0,0,,Ууууууууууу...
Dialogue: 0,0:02:18.80,0:02:19.96,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:02:20.76,0:02:22.76,Default,,0,0,0,,Бұл өте қарқынды ...
Dialogue: 0,0:02:23.46,0:02:24.53,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:02:24.66,0:02:29.16,Default,,0,0,0,,Әулие Валентин күні дегеніміз не? Мистер үшін өте маңызды шайқас.
Dialogue: 0,0:02:29.26,0:02:31.00,Default,,0,0,0,,Жоқ, бұл оқиға сияқты.
Dialogue: 0,0:02:31.40,0:02:34.36,Default,,0,0,0,,Біз мұны дұрыс жасай аламыз ба?
Dialogue: 0,0:02:34.76,0:02:37.60,Default,,0,0,0,,Қалай болғанда да, шоколад болса жақсы болар еді.
Dialogue: 0,0:03:01.46,0:03:04.43,Default,,0,0,0,,Емтиханды Валентин күніне арналған шоколадпен тапсырыңыз!
Dialogue: 0,0:03:05.70,0:03:07.50,Default,,0,0,0,,Тоқта! Тоқта!
Dialogue: 0,0:03:07.60,0:03:08.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:08.43,0:03:10.20,Default,,0,0,0,,Махоуды тоқтатыңыз!
Dialogue: 0,0:03:10.76,0:03:11.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:12.06,0:03:14.56,Default,,0,0,0,,Сол тез дайындалатын шоколадпен
Dialogue: 0,0:03:14.63,0:03:19.13,Default,,0,0,0,,Сол Әулие Валентин күніне арналған сынақтан өте аламын деп ойлайсыз ба?
Dialogue: 0,0:03:19.90,0:03:23.90,Default,,0,0,0,,Қарынға шәй қайнатуға болады! Хааааааааааааа!
Dialogue: 0,0:03:23.96,0:03:25.06,Default,,0,0,0,,Хмм?
Dialogue: 0,0:03:27.73,0:03:28.76,Default,,0,0,0,,Осы жиналыстан шығып кетпек болғандарға не болады?
Dialogue: 0,0:03:28.83,0:03:32.96,Default,,0,0,0,,Үлкен апалар қарғысқа ұқсайтын бір ойлы сезімге ие...
Dialogue: 0,0:03:35.23,0:03:38.46,Default,,0,0,0,,-Шоколадты қолмен жасаймыз -Аа...
Dialogue: 0,0:03:38.86,0:03:41.06,Default,,0,0,0,,Ойлардың керемет қақтығысы!
Dialogue: 0,0:03:41.46,0:03:45.96,Default,,0,0,0,,«Жүректен жүрекке» - Әулие Валентин күнінің ең жақсы бөлігі.
Dialogue: 0,0:03:48.60,0:03:49.83,Default,,0,0,0,,Бұл әйелдің Қанды Пері Шығармасы ма?
Dialogue: 0,0:03:49.90,0:03:51.83,Default,,0,0,0,,Мен қорқа бастадым...
Dialogue: 0,0:03:52.00,0:03:56.10,Default,,0,0,0,,Егер сіз мұны жасасаңыз, сіз қабылдау емтиханындағы қиын соғыстан аман өте алмайсыз.
Dialogue: 0,0:03:56.60,0:03:57.80,Default,,0,0,0,,Ех~
Dialogue: 0,0:03:58.10,0:04:01.40,Default,,0,0,0,,Ендеше, негізгі мәліметтерге оралайық және үйде шоколад жасайық...
Dialogue: 0,0:04:01.46,0:04:02.50,Default,,0,0,0,,Ум...
Dialogue: 0,0:04:02.56,0:04:03.13,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:03.40,0:04:05.13,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:05.73,0:04:07.83,Default,,0,0,0,,-Ах! Ахх... аа... -Ах!
Dialogue: 0,0:04:07.90,0:04:08.86,Default,,0,0,0,,Хороро-чан
Dialogue: 0,0:04:08.93,0:04:10.63,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааааааааа...
Dialogue: 0,0:04:10.70,0:04:11.66,Default,,0,0,0,,Шоколад?
Dialogue: 0,0:04:11.83,0:04:15.60,Default,,0,0,0,,Бұл міндет! Бұл міндетті шоколад!
Dialogue: 0,0:04:23.63,0:04:26.50,Default,,0,0,0,,Әу бастан осылай жасалса жақсы болар еді.
Dialogue: 0,0:04:26.73,0:04:31.20,Default,,0,0,0,,Бұл нағыз шоколад, сондықтан ол міндетті түрде өтеді.
Dialogue: 0,0:04:32.60,0:04:35.90,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:04:35.96,0:04:37.90,Default,,0,0,0,,Сонымен... Аяқтаған кезде...
Dialogue: 0,0:04:38.10,0:04:38.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:41.60,0:04:42.60,Default,,0,0,0,,Ах ха!
Dialogue: 0,0:04:43.03,0:04:43.83,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,0:04:44.33,0:04:44.96,Default,,0,0,0,,Ох…
Dialogue: 0,0:04:45.23,0:04:47.53,Default,,0,0,0,,Хехехе~
Dialogue: 0,0:04:47.66,0:04:51.90,Default,,0,0,0,,Жарайды, жарайды, мен бар күшімді саламын! О иә!
Dialogue: 0,0:04:52.40,0:04:57.56,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:05:05.16,0:05:06.23,Default,,0,0,0,,Орындалды
Dialogue: 0,0:05:06.96,0:05:08.63,Default,,0,0,0,,Керемет шықты
Dialogue: 0,0:05:09.80,0:05:12.03,Default,,0,0,0,,Тырысса қолынан іс келетін бала еді.
Dialogue: 0,0:05:12.46,0:05:13.30,Default,,0,0,0,,Ой! ?
Dialogue: 0,0:05:13.93,0:05:16.96,Default,,0,0,0,,Бірақ бұл Валентин күні өтеді.
Dialogue: 0,0:05:17.10,0:05:17.80,Default,,0,0,0,,Иә
Dialogue: 0,0:05:17.93,0:05:18.66,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:19.03,0:05:21.20,Default,,0,0,0,,Бұл бірінші кедергі ғана.
Dialogue: 0,0:05:21.43,0:05:22.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:22.40,0:05:23.80,Default,,0,0,0,,Жүректен жүрекке…
Dialogue: 0,0:05:24.63,0:05:29.76,Default,,0,0,0,,Емтиханды басқа адамға дұрыстап тапсырғанда ғана емтиханнан өттім деп айтуға болады емес пе?
Dialogue: 0,0:05:30.06,0:05:30.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:32.96,0:05:35.26,Default,,0,0,0,,Ал... қайтып келген сияқтысың.
Dialogue: 0,0:05:36.80,0:05:37.80,Default,,0,0,0,,Мен келдім!
Dialogue: 0,0:05:37.90,0:05:40.00,Default,,0,0,0,,А-а-а-ааа-а-а-а-а-а-а-а-а-а-а-а-а-а-а-а-а-а-а?
Dialogue: 0,0:05:40.06,0:05:42.93,Default,,0,0,0,,Бүгін үйде тыныш болған сияқтысың.
Dialogue: 0,0:05:43.73,0:05:45.33,Default,,0,0,0,,Кешіріңіз, кешігіп қалдым
Dialogue: 0,0:05:46.96,0:05:48.56,Default,,0,0,0,,Мен бірден кешкі ас ішемін...
Dialogue: 0,0:05:50.86,0:05:52.60,Default,,0,0,0,,Жарайды... Сара-чан
Dialogue: 0,0:05:53.73,0:05:54.60,Default,,0,0,0,,Куруру…
Dialogue: 0,0:05:55.36,0:05:56.60,Default,,0,0,0,,Хорори~н
Dialogue: 0,0:05:57.76,0:05:59.63,Default,,0,0,0,,Ku? Ку-чан
Dialogue: 0,0:05:59.96,0:06:01.63,Default,,0,0,0,,Иә! Эх! ?
Dialogue: 0,0:06:04.20,0:06:06.83,Default,,0,0,0,,Мм, мұғалім
Dialogue: 0,0:06:07.86,0:06:09.20,Default,,0,0,0,,Не? Куруру
Dialogue: 0,0:06:09.56,0:06:10.83,Default,,0,0,0,,Ааааааааааааааааааааааа
Dialogue: 0,0:06:11.16,0:06:13.10,Default,,0,0,0,,Мм... мм...
Dialogue: 0,0:06:13.76,0:06:15.30,Default,,0,0,0,,Бүгін қиын.
Dialogue: 0,0:06:15.73,0:06:17.13,Default,,0,0,0,,Күн де жақсы...
Dialogue: 0,0:06:17.20,0:06:19.56,Default,,0,0,0,,Иә? Бұлтты болды ма?
Dialogue: 0,0:06:19.63,0:06:22.03,Default,,0,0,0,,Ааааааааааааааааааааа...
Dialogue: 0,0:06:22.16,0:06:23.06,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:23.16,0:06:26.70,Default,,0,0,0,,Поо! Пуги~! Уау!
Dialogue: 0,0:06:26.96,0:06:28.43,Default,,0,0,0,,Ухиухиухифу
Dialogue: 0,0:06:29.73,0:06:31.20,Default,,0,0,0,,(Косей) Аа, дұрыс. Шыны мен ауыстыратын киім—
Dialogue: 0,0:06:31.63,0:06:35.40,Default,,0,0,0,,А... иә... иә...
Dialogue: 0,0:06:35.96,0:06:37.96,Default,,0,0,0,,Неге мен оны саған бере алмаймын?
Dialogue: 0,0:06:38.46,0:06:41.16,Default,,0,0,0,,Осы сияқты нәрселерге мұқият болу маңызды.
Dialogue: 0,0:06:41.53,0:06:42.56,Default,,0,0,0,,Кеттік
Dialogue: 0,0:06:42.93,0:06:43.60,Default,,0,0,0,,Иә
Dialogue: 0,0:06:44.50,0:06:48.03,Default,,0,0,0,,Кездейсоқ кездейсоқ кездейсоқ
Dialogue: 0,0:06:48.70,0:06:50.36,Default,,0,0,0,,Ах! Мұғалім
Dialogue: 0,0:06:50.46,0:06:53.96,Default,,0,0,0,,мырза... уф... сіз бейқам көрінесіз...
Dialogue: 0,0:06:54.50,0:06:55.93,Default,,0,0,0,,Мм... Солай емес пе...?
Dialogue: 0,0:06:56.73,0:06:59.73,Default,,0,0,0,,Ум... анау... уф
Dialogue: 0,0:06:59.93,0:07:00.86,Default,,0,0,0,,Спорттық костюмім мен кроссовкаларым мінсіз күйде, бір жыртығы да жоқ.
Dialogue: 0,0:07:01.23,0:07:02.23,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:02.83,0:07:03.86,Default,,0,0,0,,-Ах... -Ух...
Dialogue: 0,0:07:05.10,0:07:07.53,Default,,0,0,0,,-На на -Ааааааааааааааааааааа...
Dialogue: 0,0:07:07.60,0:07:08.93,Default,,0,0,0,,Бұл ештеңе емес!
Dialogue: 0,0:07:09.96,0:07:12.06,Default,,0,0,0,,Уа... у...
Dialogue: 0,0:07:12.56,0:07:15.50,Default,,0,0,0,,Күрсін... Сіз кездейсоқ оралдыңыз.
Dialogue: 0,0:07:15.60,0:07:16.36,Default,,0,0,0,,Иә...
Dialogue: 0,0:07:16.60,0:07:18.36,Default,,0,0,0,,Неліктен, неге...?
Dialogue: 0,0:07:18.46,0:07:21.50,Default,,0,0,0,,Мен оны жасау үшін көп еңбектенсем де...
Dialogue: 0,0:07:22.30,0:07:25.10,Default,,0,0,0,,Мен қарапайым нәрсені істей алмайтыныма сенбеймін ...
Dialogue: 0,0:07:26.36,0:07:27.53,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:07:29.70,0:07:32.13,Default,,0,0,0,,«Мен шоколадпын» операциясы
Dialogue: 0,0:07:33.26,0:07:34.43,Default,,0,0,0,,Уау! ?
Dialogue: 0,0:07:34.60,0:07:36.53,Default,,0,0,0,,-Бұл басқаша -Бұл басқа~
Dialogue: 0,0:07:36.60,0:07:39.76,Default,,0,0,0,,Менің тәтті сүйкімділігім сені маған ғашық етеді.
Dialogue: 0,0:07:40.13,0:07:42.20,Default,,0,0,0,,Хороро-чан, мықты бол!
Dialogue: 0,0:07:42.56,0:07:44.30,Default,,0,0,0,,-Ааааааааааааааааааааааааааааааааааа...
Dialogue: 0,0:07:44.40,0:07:45.56,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:45.90,0:07:48.23,Default,,0,0,0,,Я~
Dialogue: 0,0:07:49.50,0:07:50.03,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:50.46,0:07:51.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:52.93,0:07:53.96,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:54.66,0:07:55.56,Default,,0,0,0,,Менің кеудем...
Dialogue: 0,0:07:55.90,0:07:56.96,Default,,0,0,0,,Хороро-чан?
Dialogue: 0,0:07:57.66,0:07:59.46,Default,,0,0,0,,Менің кеудем ауырады.
Dialogue: 0,0:08:00.93,0:08:04.56,Default,,0,0,0,,Мен мұғаліміме шоколад бергім келеді...
Dialogue: 0,0:08:06.06,0:08:07.93,Default,,0,0,0,,Жүрегім лүпілдеп тұр...
Dialogue: 0,0:08:08.50,0:08:09.73,Default,,0,0,0,,Ауырды...
Dialogue: 0,0:08:11.73,0:08:12.96,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:08:13.73,0:08:14.86,Default,,0,0,0,,Хороро-чан...
Dialogue: 0,0:08:15.66,0:08:19.03,Default,,0,0,0,,Саған берейін десем де...
Dialogue: 0,0:08:19.50,0:08:21.10,Default,,0,0,0,,Мен оны саған бере алмаймын...
Dialogue: 0,0:08:21.50,0:08:23.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:23.60,0:08:26.73,Default,,0,0,0,,Уф уф уф
Dialogue: 0,0:08:26.80,0:08:28.70,Default,,0,0,0,,Жылама... Мин...
Dialogue: 0,0:08:28.76,0:08:30.80,Default,,0,0,0,,уф уф уф
Dialogue: 0,0:08:30.86,0:08:32.66,Default,,0,0,0,,Уа, уау, ау!
Dialogue: 0,0:08:32.73,0:08:35.96,Default,,0,0,0,,Уау! Апыр-ай...!
Dialogue: 0,0:08:36.03,0:08:36.70,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:37.43,0:08:38.76,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:38.83,0:08:39.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:40.96,0:08:42.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:43.93,0:08:47.43,Default,,0,0,0,,Уау, уфххххххххххххххххххххххххххх...
Dialogue: 0,0:08:47.50,0:08:48.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:50.46,0:08:52.00,Default,,0,0,0,,Мен оны саған беруім керек...
Dialogue: 0,0:08:53.63,0:08:54.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:55.53,0:08:56.90,Default,,0,0,0,,Ал...
Dialogue: 0,0:08:58.26,0:09:02.83,Default,,0,0,0,,Қыздар өздеріне ұнайтын адамның алдында қобалжиды.
Dialogue: 0,0:09:03.20,0:09:06.03,Default,,0,0,0,,Көрші жігіт те жақсы адам.
Dialogue: 0,0:09:06.20,0:09:07.26,Default,,0,0,0,,Мен мұны істеймін.
Dialogue: 0,0:09:07.60,0:09:09.96,Default,,0,0,0,,Сенсэй жаман адам емес.
Dialogue: 0,0:09:10.60,0:09:11.43,Default,,0,0,0,,Э-э-э—
Dialogue: 0,0:09:12.30,0:09:13.83,Default,,0,0,0,,Бұл аналогия.
Dialogue: 0,0:09:15.16,0:09:16.56,Default,,0,0,0,,Бұл махаббат...
Dialogue: 0,0:09:16.90,0:09:19.53,Default,,0,0,0,,Ах! Бұл Тама-чанның желісі
Dialogue: 0,0:09:20.10,0:09:21.50,Default,,0,0,0,,Махаббат деген не?
Dialogue: 0,0:09:21.86,0:09:22.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:22.86,0:09:26.00,Default,,0,0,0,,Ал... сондай ащы-тәтті сезім.
Dialogue: 0,0:09:26.06,0:09:30.06,Default,,0,0,0,,Қыздың үлпілдек, дірілдеген сезімі - махаббат...
Dialogue: 0,0:09:30.46,0:09:31.96,Default,,0,0,0,,Таптыңыз ба? Қажет еткеніңізді?
Dialogue: 0,0:09:32.46,0:09:36.36,Default,,0,0,0,,Тама-чанның түсіндірмесі соншалықты абстрактілі, мен оны түсінбеймін.
Dialogue: 0,0:09:36.63,0:09:37.50,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:38.20,0:09:38.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:39.50,0:09:41.93,Default,,0,0,0,,Оборо-чан! Мен сені іздеп келдім.
Dialogue: 0,0:09:42.83,0:09:44.96,Default,,0,0,0,,Жоқ, түн батып кетті.
Dialogue: 0,0:09:45.06,0:09:47.73,Default,,0,0,0,,Көрші ағасы да уайымдап отыр.
Dialogue: 0,0:09:47.83,0:09:48.76,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:50.23,0:09:52.73,Default,,0,0,0,,Мен үйдемін.
Dialogue: 0,0:09:53.03,0:09:54.00,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:09:55.06,0:09:57.70,Default,,0,0,0,,Мен уайымдадым, өйткені сіз осындай сағатта кететін болдыңыз.
Dialogue: 0,0:09:58.16,0:09:59.50,Default,,0,0,0,,… …
Dialogue: 0,0:09:59.73,0:10:01.43,Default,,0,0,0,,Мм... бұл...
Dialogue: 0,0:10:01.80,0:10:02.53,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:02.63,0:10:03.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:07.56,0:10:10.40,Default,,0,0,0,,Мұны барлығы жасады, солай ма?
Dialogue: 0,0:10:11.60,0:10:12.43,Default,,0,0,0,,Хмм
Dialogue: 0,0:10:14.23,0:10:15.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:10:16.16,0:10:18.83,Default,,0,0,0,,Бұл мені бақытты ететін шоколадты бірінші рет ішіп отырмын.
Dialogue: 0,0:10:19.46,0:10:21.40,Default,,0,0,0,,Кяаааааааааааааааааааааааааа
Dialogue: 0,0:10:21.46,0:10:22.00,Default,,0,0,0,,Ох…
Dialogue: 0,0:10:22.06,0:10:23.20,Default,,0,0,0,,Мен оны аша аламын ба?
Dialogue: 0,0:10:23.46,0:10:24.83,Default,,0,0,0,,-Иә иә -мммм
Dialogue: 0,0:10:27.93,0:10:29.56,Default,,0,0,0,,Ааа аааа...
Dialogue: 0,0:10:29.83,0:10:30.36,Default,,0,0,0,,О...
Dialogue: 0,0:10:30.66,0:10:31.96,Default,,0,0,0,,Ах ха ха
Dialogue: 0,0:10:32.66,0:10:34.43,Default,,0,0,0,,Маған бәрібір, маған бәрібір
Dialogue: 0,0:10:34.93,0:10:35.66,Default,,0,0,0,,Хмм.
Dialogue: 0,0:10:38.46,0:10:40.23,Default,,0,0,0,,О... дәмді екен.
Dialogue: 0,0:10:40.66,0:10:41.60,Default,,0,0,0,,Рас…
Dialogue: 0,0:10:42.46,0:10:43.40,Default,,0,0,0,,Бұл?
Dialogue: 0,0:10:43.86,0:10:45.10,Default,,0,0,0,,Иә, өттім.
Dialogue: 0,0:10:45.20,0:10:48.36,Default,,0,0,0,,Уаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:10:53.90,0:10:56.83,Default,,0,0,0,,Күрсін... Мен қатты толқып кеттім.
Dialogue: 0,0:10:56.90,0:11:00.16,Default,,0,0,0,,А, бірақ дәл қазір жүрегім дүрсілдеп тұр.
Dialogue: 0,0:11:00.30,0:11:02.70,Default,,0,0,0,,Толқудың көптеген түрлері бар.
Dialogue: 0,0:11:02.76,0:11:07.40,Default,,0,0,0,,Иә, адам болған соң жақсырақ түсінерсің.
Dialogue: 0,0:11:07.70,0:11:09.76,Default,,0,0,0,,Ах~ міне осы
Dialogue: 0,0:11:09.83,0:11:10.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:11.40,0:11:12.53,Default,,0,0,0,,Мүмкін бұл махаббат шығар...
Dialogue: 0,0:11:13.36,0:11:14.43,Default,,0,0,0,,Мүмкін махаббат
Dialogue: 0,0:11:15.50,0:11:16.53,Default,,0,0,0,,Махаббат...
Dialogue: 0,0:11:17.53,0:11:19.30,Default,,0,0,0,,Мен түсінбеймін...
Dialogue: 0,0:11:20.56,0:11:21.66,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:28.23,0:11:40.23,Default,,0,0,0,,Қыстың барлық сезімі ақ түске боялған
Dialogue: 0,0:11:41.23,0:11:51.53,Default,,0,0,0,,Тіпті сол адамның көлеңкесін де көруді қиындату
Dialogue: 0,0:11:54.30,0:12:00.73,Default,,0,0,0,,Із, із, артта қалды
Dialogue: 0,0:12:00.80,0:12:02.43,Default,,0,0,0,,Бірақ
Dialogue: 0,0:12:04.03,0:12:11.06,Default,,0,0,0,,Әй, қар, қар, бәрін өшіреді
Dialogue: 0,0:12:11.60,0:12:17.66,Default,,0,0,0,,Жолда жазылған «ұнайды» сөзі
Dialogue: 0,0:12:18.16,0:12:20.93,Default,,0,0,0,,Бірақ, бірақ.
Dialogue: 0,0:12:21.40,0:12:32.70,Default,,0,0,0,,Өшіре алмаған – жүрегің, Жүрегіңде жасырылған сезім
Dialogue: 0,0:12:34.20,0:12:40.20,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
