Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.40,0:00:16.10,Default,,0,0,0,,Сиқырлы елдегі қыз
Dialogue: 0,0:00:17.00,0:00:21.43,Default,,0,0,0,,Өте кішкентай ертегі
Dialogue: 0,0:00:22.36,0:00:31.23,Default,,0,0,0,,Дүниеде не істегіңіз келеді?
Dialogue: 0,0:00:31.40,0:00:36.93,Default,,0,0,0,,Керемет қыз Пукипукипайо
Dialogue: 0,0:00:37.03,0:00:41.56,Default,,0,0,0,,Аа, айтыңызшы, ұстаз.
Dialogue: 0,0:00:41.93,0:00:48.03,Default,,0,0,0,,Мен бұл туралы көбірек білгім келеді.
Dialogue: 0,0:00:48.23,0:00:52.96,Default,,0,0,0,,Ах Сенсей-сан
Dialogue: 0,0:00:53.10,0:01:02.20,Default,,0,0,0,,Ғажайып сырлар, айта алмайтын нәрселердің бәрі
Dialogue: 0,0:01:11.60,0:01:12.60,Default,,0,0,0,,«Желтоқсан»
Dialogue: 0,0:01:18.63,0:01:22.46,Default,,0,0,0,,Аяз ата, өзіңді күт, Тонер.
Dialogue: 0,0:01:22.73,0:01:25.03,Default,,0,0,0,,О, бұғы
Dialogue: 0,0:01:25.20,0:01:27.96,Default,,0,0,0,,Менің қарным ашты, енді тамақ жей алмаймын...
Dialogue: 0,0:01:28.26,0:01:30.83,Default,,0,0,0,,Бұлай айтпайтын тонер
Dialogue: 0,0:01:31.26,0:01:34.10,Default,,0,0,0,,Ух... Лосось Чазуке
Dialogue: 0,0:01:34.30,0:01:35.40,Default,,0,0,0,,Крокет соба
Dialogue: 0,0:01:35.90,0:01:38.33,Default,,0,0,0,,Ta Жұмыртқаға қуырылған күріш…
Dialogue: 0,0:01:38.73,0:01:39.33,Default,,0,0,0,,Гаку…
Dialogue: 0,0:01:39.56,0:01:42.76,Default,,0,0,0,,Куруру-чан Аяз ата!
Dialogue: 0,0:01:43.06,0:01:44.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:44.23,0:01:45.46,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:01:45.53,0:01:47.13,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:47.23,0:01:48.73,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:48.80,0:01:49.76,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:01:52.46,0:01:55.86,Default,,0,0,0,,Мен өзімді Рождество деп көрсетуден шаршадым.
Dialogue: 0,0:01:56.23,0:01:57.96,Default,,0,0,0,,Үлгілер таусылды
Dialogue: 0,0:01:58.30,0:02:02.20,Default,,0,0,0,,Ақырында айнала келді, бірақ Аяз атаның кезегі.
Dialogue: 0,0:02:03.03,0:02:04.50,Default,,0,0,0,,Бұл былай деді:
Dialogue: 0,0:02:06.33,0:02:07.06,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:02:07.33,0:02:08.83,Default,,0,0,0,,Жаңа жыл кеші.
Dialogue: 0,0:02:10.53,0:02:12.10,Default,,0,0,0,,және келісім-шарт аяқталады
Dialogue: 0,0:02:12.46,0:02:14.63,Default,,0,0,0,,Бүгін Жаңа жыл кеші болса да
Dialogue: 0,0:02:14.80,0:02:19.10,Default,,0,0,0,,Жаңа жылға дайындалу үшін бәріңіз ештеңе жасамадыңыздар ма?
Dialogue: 0,0:02:19.30,0:02:20.26,Default,,0,0,0,,№.
Dialogue: 0,0:02:20.56,0:02:22.10,Default,,0,0,0,,Мұны істеу мүмкін емес пе еді?
Dialogue: 0,0:02:22.43,0:02:23.40,Default,,0,0,0,,Дио…
Dialogue: 0,0:02:23.86,0:02:26.03,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:02:27.66,0:02:28.66,Default,,0,0,0,,♪ Вуф-вуф, вуф-вуф
Dialogue: 0,0:02:29.46,0:02:32.13,Default,,0,0,0,,Осечи Кохаку!
Dialogue: 0,0:02:32.73,0:02:37.96,Default,,0,0,0,,Жаңа жылды қарсы алу үшін осы үш нәрсені дұрыстап тазалау керек.
Dialogue: 0,0:02:38.90,0:02:40.53,Default,,0,0,0,,Бұл абсолютті ме?
Dialogue: 0,0:02:41.16,0:02:42.36,Default,,0,0,0,,Мүлдем!
Dialogue: 0,0:02:42.70,0:02:43.23,Default,,0,0,0,,Иә
Dialogue: 0,0:02:43.73,0:02:46.70,Default,,0,0,0,,Мен мұны істемесем не болады?
Dialogue: 0,0:02:47.06,0:02:48.20,Default,,0,0,0,,Сол кезде
Dialogue: 0,0:02:49.26,0:02:51.13,Default,,0,0,0,,Жаңа жыл мәңгілік...
Dialogue: 0,0:02:52.20,0:02:52.93,Default,,0,0,0,,Келмейді!
Dialogue: 0,0:02:53.13,0:02:54.60,Default,,0,0,0,,Гааааан!
Dialogue: 0,0:02:54.83,0:02:56.76,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:02:57.40,0:02:59.06,Default,,0,0,0,,Гааааан!
Dialogue: 0,0:03:12.93,0:03:13.63,Default,,0,0,0,,Олай болса!
Dialogue: 0,0:03:14.83,0:03:16.96,Default,,0,0,0,,Мен тазалауды бастағалы жатырмын!
Dialogue: 0,0:03:17.26,0:03:19.93,Default,,0,0,0,,Шаңды немесе кірді өткізіп алсаңыз
Dialogue: 0,0:03:20.16,0:03:22.43,Default,,0,0,0,,Жаңа жыл болмайды!
Dialogue: 0,0:03:22.63,0:03:23.16,Default,,0,0,0,,Иә
Dialogue: 0,0:03:24.00,0:03:25.03,Default,,0,0,0,,Көктемгі тазалау
Dialogue: 0,0:03:25.16,0:03:26.13,Default,,0,0,0,,Бастау!
Dialogue: 0,0:03:26.20,0:03:28.46,Default,,0,0,0,,Оу!
Dialogue: 0,0:03:30.10,0:03:30.70,Default,,0,0,0,,Хаха
Dialogue: 0,0:03:31.03,0:03:31.56,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:03:31.96,0:03:32.46,Default,,0,0,0,,Хмм.
Dialogue: 0,0:03:32.80,0:03:33.36,Default,,0,0,0,,Уф
Dialogue: 0,0:03:33.46,0:03:34.60,Default,,0,0,0,,Асығыңыз, әжей...
Dialogue: 0,0:03:34.90,0:03:36.10,Default,,0,0,0,,Тезірек, сасс...
Dialogue: 0,0:03:36.16,0:03:37.16,Default,,0,0,0,,Тезірек, сасс...
Dialogue: 0,0:03:37.23,0:03:38.60,Default,,0,0,0,,Тек...
Dialogue: 0,0:03:38.76,0:03:40.10,Default,,0,0,0,,Тек...
Dialogue: 0,0:03:40.20,0:03:41.13,Default,,0,0,0,,Тек...
Dialogue: 0,0:03:47.40,0:03:49.10,Default,,0,0,0,,Аяқталды!
Dialogue: 0,0:03:50.16,0:03:51.73,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:52.76,0:03:53.70,Default,,0,0,0,,Әдемі
Dialogue: 0,0:03:53.96,0:03:56.06,Default,,0,0,0,,Хмм, мен қате түсіндім.
Dialogue: 0,0:03:56.36,0:03:58.90,Default,,0,0,0,,Бұл көктемгі тазалау үшін өте қолайлы.
Dialogue: 0,0:03:59.10,0:03:59.93,Default,,0,0,0,,Куруру-чан
Dialogue: 0,0:04:00.16,0:04:00.76,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:01.03,0:04:01.53,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:02.76,0:04:04.86,Default,,0,0,0,,Не болды, Куруру-чан?
Dialogue: 0,0:04:05.13,0:04:05.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:05.96,0:04:06.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:07.26,0:04:07.96,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:04:12.60,0:04:15.16,Default,,0,0,0,,Мұнда кім тазалады?
Dialogue: 0,0:04:15.70,0:04:18.23,Default,,0,0,0,,А-а... бұл менмін...
Dialogue: 0,0:04:18.36,0:04:20.23,Default,,0,0,0,,Ммм!
Dialogue: 0,0:04:29.10,0:04:30.16,Default,,0,0,0,,Чирико-сан
Dialogue: 0,0:04:30.93,0:04:33.93,Default,,0,0,0,,Көктемгі тазалық туралы не ойлайсың?
Dialogue: 0,0:04:34.46,0:04:37.73,Default,,0,0,0,,Шаршы бөлмені шеңбер бойымен сыпыру дәл осыны білдіреді.
Dialogue: 0,0:04:38.03,0:04:40.73,Default,,0,0,0,,Кешіріңіз, ене...
Dialogue: 0,0:04:41.13,0:04:42.83,Default,,0,0,0,,Жарайды, жарайды, мама.
Dialogue: 0,0:04:43.20,0:04:46.53,Default,,0,0,0,,Тіпті Чирико мұны әдейі істемеді.
Dialogue: 0,0:04:46.96,0:04:48.33,Default,,0,0,0,,Саратаро-сан...
Dialogue: 0,0:04:48.50,0:04:50.23,Default,,0,0,0,,Сара-чан, үндеме!
Dialogue: 0,0:04:50.76,0:04:53.76,Default,,0,0,0,,Бұл Чирико-сан екеуміздің арамыздағы мәселе.
Dialogue: 0,0:04:54.46,0:04:55.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:55.70,0:04:56.30,Default,,0,0,0,,Иә...
Dialogue: 0,0:04:56.50,0:04:57.36,Default,,0,0,0,,О
Dialogue: 0,0:04:57.56,0:04:58.06,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:58.96,0:05:01.73,Default,,0,0,0,,Менің бұл әрекетім сізге ұнамаса
Dialogue: 0,0:05:01.90,0:05:05.53,Default,,0,0,0,,Сіз бұл үйден кез келген уақытта шыға аласыз.
Dialogue: 0,0:05:06.03,0:05:07.73,Default,,0,0,0,,Сара-чан, шай ішейік.
Dialogue: 0,0:05:08.40,0:05:10.03,Default,,0,0,0,,Майури қабірге баруды бір күн де өткізіп көрген жоқ
Dialogue: 0,0:05:11.16,0:05:11.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:20.46,0:05:21.36,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:21.53,0:05:23.46,Default,,0,0,0,,Ууууууууууууууууу...
Dialogue: 0,0:05:24.26,0:05:24.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:27.30,0:05:28.36,Default,,0,0,0,,Анам…
Dialogue: 0,0:05:28.83,0:05:33.03,Default,,0,0,0,,Мен қанша уақыт емделуім керек?
Dialogue: 0,0:05:33.40,0:05:34.20,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:34.73,0:05:36.90,Default,,0,0,0,,Маған көмектесші... Анашым
Dialogue: 0,0:05:37.36,0:05:38.40,Default,,0,0,0,,Ой...
Dialogue: 0,0:05:38.70,0:05:39.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:39.96,0:05:40.80,Default,,0,0,0,,О
Dialogue: 0,0:05:42.96,0:05:46.86,Default,,0,0,0,,Көз жасы жараспайды, жас ханым.
Dialogue: 0,0:05:47.53,0:05:50.13,Default,,0,0,0,,Хоророкава мырза, сіздің жеке адвокатыңыз!
Dialogue: 0,0:05:50.63,0:05:52.63,Default,,0,0,0,,Жоқ, мен жыламаймын.
Dialogue: 0,0:05:52.96,0:05:55.73,Default,,0,0,0,,Менің көзіме кір кірді...
Dialogue: 0,0:05:56.60,0:05:57.66,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:05:57.73,0:05:58.23,Default,,0,0,0,,бұл...
Dialogue: 0,0:05:58.30,0:06:02.76,Default,,0,0,0,,Ендеше мұны менің түсінбеуім деп атайық.
Dialogue: 0,0:06:03.86,0:06:04.66,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:06:05.00,0:06:09.23,Default,,0,0,0,,Кейде бәрін ұмытып, қолымнан келгенше жылаймын
Dialogue: 0,0:06:10.36,0:06:11.73,Default,,0,0,0,,Бұл маңызды.
Dialogue: 0,0:06:12.13,0:06:12.70,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:15.90,0:06:17.33,Default,,0,0,0,,Хоророкава мырза...
Dialogue: 0,0:06:23.96,0:06:24.86,Default,,0,0,0,,Сізде туған күніңізді растайтын құжат бар ма?
Dialogue: 0,0:06:25.16,0:06:26.50,Default,,0,0,0,,Осечи!
Dialogue: 0,0:06:27.20,0:06:28.63,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:29.06,0:06:31.30,Default,,0,0,0,,Маған Тама-чан жазып берді.
Dialogue: 0,0:06:31.76,0:06:34.00,Default,,0,0,0,,Мен осыдан ғана түсінбеймін.
Dialogue: 0,0:06:34.56,0:06:37.23,Default,,0,0,0,,Атаудың өзі жеткіліксіз.
Dialogue: 0,0:06:37.80,0:06:41.03,Default,,0,0,0,,Бірақ мен осечи жасауым керек...
Dialogue: 0,0:06:41.50,0:06:42.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:49.96,0:06:53.40,Default,,0,0,0,,«Мен бұл жаңа жылға бара алмаймын»
Dialogue: 0,0:06:54.20,0:06:54.96,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:06:55.46,0:06:57.46,Default,,0,0,0,,Осечи басталады!
Dialogue: 0,0:06:58.63,0:06:59.93,Default,,0,0,0,,Күнжіт
Dialogue: 0,0:07:00.90,0:07:02.43,Default,,0,0,0,,Датемаки
Dialogue: 0,0:07:03.00,0:07:03.66,Default,,0,0,0,,Каштан
Dialogue: 0,0:07:03.93,0:07:04.46,Default,,0,0,0,,Кин
Dialogue: 0,0:07:04.70,0:07:05.70,Default,,0,0,0,,Тон!
Dialogue: 0,0:07:06.06,0:07:09.23,Default,,0,0,0,,Ой, бәрі жақсы болды.
Dialogue: 0,0:07:09.60,0:07:10.66,Default,,0,0,0,,Енді не болады?
Dialogue: 0,0:07:13.70,0:07:14.20,Default,,0,0,0,,Хмм?
Dialogue: 0,0:07:14.80,0:07:16.00,Default,,0,0,0,,Күріш өсіру?
Dialogue: 0,0:07:20.30,0:07:20.86,Default,,0,0,0,,Ui...
Dialogue: 0,0:07:21.93,0:07:24.66,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:07:26.06,0:07:27.46,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:07:28.96,0:07:32.40,Default,,0,0,0,,Керемет күріш алқабын өсіргеніңізге қуаныштымын.
Dialogue: 0,0:07:32.73,0:07:34.60,Default,,0,0,0,,Чирико-сан
Dialogue: 0,0:07:35.33,0:07:35.93,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:37.66,0:07:39.73,Default,,0,0,0,,Бір дем алайық
Dialogue: 0,0:07:40.43,0:07:41.86,Default,,0,0,0,,Хоророкава мырза
Dialogue: 0,0:07:50.70,0:07:52.70,Default,,0,0,0,,Жақсысың ба, Чирико-сан?
Dialogue: 0,0:07:52.96,0:07:55.60,Default,,0,0,0,,Мен үйренбеген күріш егумен айналысуға тура келді.
Dialogue: 0,0:07:56.23,0:07:58.40,Default,,0,0,0,,Жарайды, Хоророкава-сан.
Dialogue: 0,0:07:59.16,0:08:04.26,Default,,0,0,0,,Сен мені Иджуиннің үйінен алып шыққаның үшін...
Dialogue: 0,0:08:04.96,0:08:06.43,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:07.23,0:08:08.46,Default,,0,0,0,,Бұл көздер.
Dialogue: 0,0:08:09.06,0:08:09.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:10.23,0:08:14.33,Default,,0,0,0,,Сол көздер мені сондай батыл етті
Dialogue: 0,0:08:14.90,0:08:19.90,Default,,0,0,0,,Әкемнің ұрпағынан мені бағып-қағып келе жатқан ұлы жарыма опасыздық жасағаным үшін...
Dialogue: 0,0:08:20.60,0:08:21.86,Default,,0,0,0,,Хоророкава мырза...
Dialogue: 0,0:08:22.43,0:08:23.93,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:08:24.00,0:08:24.50,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:24.96,0:08:26.70,Default,,0,0,0,,Әй, ене
Dialogue: 0,0:08:27.10,0:08:28.40,Default,,0,0,0,,Саратаро-сан
Dialogue: 0,0:08:28.86,0:08:31.96,Default,,0,0,0,,Чирико-сан, сен үлкен іссің.
Dialogue: 0,0:08:32.33,0:08:35.63,Default,,0,0,0,,Өйткені мен бұл маңызды Хороро өзенін азғырамын.
Dialogue: 0,0:08:36.06,0:08:37.50,Default,,0,0,0,,Мына ұры мысық!
Dialogue: 0,0:08:37.93,0:08:40.76,Default,,0,0,0,,Мені алдамақ болғаныңа сенбеймін... Болды!
Dialogue: 0,0:08:41.00,0:08:42.43,Default,,0,0,0,,Мен арбадым
Dialogue: 0,0:08:42.66,0:08:43.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:43.46,0:08:47.30,Default,,0,0,0,,Екеуі де Ижуин тегіне кір келтіретіндіктен.
Dialogue: 0,0:08:47.43,0:08:49.46,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:08:50.63,0:08:51.96,Default,,0,0,0,,Ене...
Dialogue: 0,0:08:53.63,0:08:55.03,Default,,0,0,0,,Тоқтатайық, мама.
Dialogue: 0,0:08:55.13,0:08:55.73,Default,,0,0,0,,Ах... ха!
Dialogue: 0,0:08:56.23,0:08:59.23,Default,,0,0,0,,Сара-чан, қазір не айтып тұрсың?
Dialogue: 0,0:08:59.63,0:09:01.50,Default,,0,0,0,,Мен артық айтқан жоқпын.
Dialogue: 0,0:09:01.90,0:09:04.86,Default,,0,0,0,,Чирикоға не қаласа, соны істеуге рұқсат беру керек.
Dialogue: 0,0:09:05.20,0:09:06.60,Default,,0,0,0,,Саратаро-сан!
Dialogue: 0,0:09:06.93,0:09:07.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:08.16,0:09:08.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:08.73,0:09:09.83,Default,,0,0,0,,Сіз!
Dialogue: 0,0:09:10.10,0:09:11.10,Default,,0,0,0,,Сонымен бірге ол фонды да бір уақытта салып жатыр!
Dialogue: 0,0:09:12.66,0:09:15.16,Default,,0,0,0,,Осы уақытқа дейін кешіріңіз...
Dialogue: 0,0:09:15.83,0:09:17.70,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:09:25.46,0:09:26.36,Default,,0,0,0,,Уақыты келді…
Dialogue: 0,0:09:32.06,0:09:32.93,Default,,0,0,0,,Соңында
Dialogue: 0,0:09:33.50,0:09:34.73,Default,,0,0,0,,Кохаку!
Dialogue: 0,0:09:38.10,0:09:40.30,Default,,0,0,0,,Бұл Кохаку.
Dialogue: 0,0:09:40.53,0:09:43.56,Default,,0,0,0,,Хмм, бұл міндетті түрде қызыл және ақ.
Dialogue: 0,0:09:43.80,0:09:45.96,Default,,0,0,0,,Жаңа жыл келді, солай емес пе?
Dialogue: 0,0:09:46.13,0:09:48.80,Default,,0,0,0,,Қара жеңеді Жасыл жеңеді
Dialogue: 0,0:09:49.50,0:09:52.63,Default,,0,0,0,,Айтпақшы, Тама-чан үйіне бару керек пе?
Dialogue: 0,0:09:52.83,0:09:54.16,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:09:54.56,0:09:55.13,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:09:55.20,0:09:56.16,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:09:56.63,0:10:00.10,Default,,0,0,0,,Жаңа жыл кеші болғандықтан, әжем мені кешірді.
Dialogue: 0,0:10:00.66,0:10:01.26,Default,,0,0,0,,Иә
Dialogue: 0,0:10:01.53,0:10:02.23,Default,,0,0,0,,Иә
Dialogue: 0,0:10:02.56,0:10:03.70,Default,,0,0,0,,Сәлем, мұғалім
Dialogue: 0,0:10:04.13,0:10:07.66,Default,,0,0,0,,Неліктен Кохаку бірге ән айтады?
Dialogue: 0,0:10:08.36,0:10:11.56,Default,,0,0,0,,Ал... Ән байқауы болғандықтан шығар?
Dialogue: 0,0:10:12.13,0:10:12.83,Default,,0,0,0,,Шайқас?
Dialogue: 0,0:10:12.90,0:10:13.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:13.76,0:10:15.06,Default,,0,0,0,,Ән сайысы?
Dialogue: 0,0:10:21.56,0:10:22.86,Default,,0,0,0,,Біраз уақыт өтті!
Dialogue: 0,0:10:23.30,0:10:24.36,Default,,0,0,0,,Сараринемон!
Dialogue: 0,0:10:24.96,0:10:26.36,Default,,0,0,0,,Куруру Суке жоқ па?
Dialogue: 0,0:10:28.93,0:10:30.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:30.80,0:10:32.13,Default,,0,0,0,,Тааа!
Dialogue: 0,0:10:32.20,0:10:33.13,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:33.20,0:10:34.70,Default,,0,0,0,,Тааа!
Dialogue: 0,0:10:40.66,0:10:41.30,Default,,0,0,0,,(Кёко) Ш-шын ба…? Сенің мен Шиндô-кунның араларыңда солай ма…
Dialogue: 0,0:10:41.43,0:10:43.86,Default,,0,0,0,,Бұл өте жақсы ән.
Dialogue: 0,0:10:45.06,0:10:46.26,Default,,0,0,0,,Сіз солсыз
Dialogue: 0,0:10:46.80,0:10:48.90,Default,,0,0,0,,Керемет...
Dialogue: 0,0:10:49.40,0:10:50.30,Default,,0,0,0,,Сара-чан?
Dialogue: 0,0:10:50.36,0:10:50.93,Default,,0,0,0,,Кира өзімен-өзі айналысып жүр ғой?
Dialogue: 0,0:10:51.00,0:10:51.56,Default,,0,0,0,,Ахаха
Dialogue: 0,0:10:51.63,0:10:52.13,Default,,0,0,0,,Хех, хех
Dialogue: 0,0:10:52.30,0:10:52.96,Default,,0,0,0,,Хой хо хо
Dialogue: 0,0:10:53.36,0:10:53.86,Default,,0,0,0,,Хойфу
Dialogue: 0,0:10:53.96,0:10:54.46,Default,,0,0,0,,Уф
Dialogue: 0,0:10:54.53,0:10:55.36,Default,,0,0,0,,Иә! У
Dialogue: 0,0:10:59.13,0:11:00.70,Default,,0,0,0,,Олай болса, бәріңе.
Dialogue: 0,0:11:01.10,0:11:03.23,Default,,0,0,0,,Биыл да осында!
Dialogue: 0,0:11:03.46,0:11:04.53,Default,,0,0,0,,Сонымен
Dialogue: 0,0:11:04.63,0:11:08.33,Default,,0,0,0,,Біз жаңа жылға кері санауды бастағалы жатырмыз!
Dialogue: 0,0:11:09.03,0:11:09.90,Default,,0,0,0,,10 секунд бұрын!
Dialogue: 0,0:11:10.33,0:11:10.93,Default,,0,0,0,,９！
Dialogue: 0,0:11:11.26,0:11:11.93,Default,,0,0,0,,８！
Dialogue: 0,0:11:12.26,0:11:12.96,Default,,0,0,0,,７！
Dialogue: 0,0:11:13.40,0:11:14.00,Default,,0,0,0,,６！
Dialogue: 0,0:11:14.36,0:11:14.93,Default,,0,0,0,,５！
Dialogue: 0,0:11:15.40,0:11:15.90,Default,,0,0,0,,４！
Dialogue: 0,0:11:16.26,0:11:16.86,Default,,0,0,0,,３！
Dialogue: 0,0:11:17.36,0:11:17.93,Default,,0,0,0,,２！
Dialogue: 0,0:11:22.96,0:11:24.40,Default,,0,0,0,,Ичи!
Dialogue: 0,0:11:28.30,0:11:40.20,Default,,0,0,0,,Күздің сезімі оқу, сурет салу, тыныш күндер.
Dialogue: 0,0:11:41.30,0:11:51.70,Default,,0,0,0,,Желдің үні де аспанға ериді
Dialogue: 0,0:11:54.33,0:12:00.76,Default,,0,0,0,,Байқау Байқамау
Dialogue: 0,0:12:00.83,0:12:01.86,Default,,0,0,0,,Бірақ
Dialogue: 0,0:12:04.10,0:12:11.10,Default,,0,0,0,,Әй, құлаған жапырақтар, құлаған жапырақтар, ағаштар тізілген даңғыл
Dialogue: 0,0:12:11.70,0:12:17.63,Default,,0,0,0,,Қызыл түске боясам да
Dialogue: 0,0:12:18.26,0:12:21.03,Default,,0,0,0,,Жел, жел
Dialogue: 0,0:12:21.50,0:12:31.56,Default,,0,0,0,,Сол адамға оны жақсы көретініңізді сыбырлаңыз.
Dialogue: 0,0:12:33.06,0:12:39.06,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
