Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.40,0:00:16.10,Default,,0,0,0,,Сиқырлы елдегі қыз
Dialogue: 0,0:00:17.03,0:00:21.43,Default,,0,0,0,,Өте кішкентай ертегі
Dialogue: 0,0:00:22.36,0:00:31.23,Default,,0,0,0,,Дүниеде не істегіңіз келеді?
Dialogue: 0,0:00:31.30,0:00:36.93,Default,,0,0,0,,Керемет қыз Пукипукипайо
Dialogue: 0,0:00:37.03,0:00:41.56,Default,,0,0,0,,Аа, айтыңызшы, ұстаз.
Dialogue: 0,0:00:41.93,0:00:48.00,Default,,0,0,0,,Мен бұл туралы көбірек білгім келеді.
Dialogue: 0,0:00:48.23,0:00:52.96,Default,,0,0,0,,Ах Сенсей-сан
Dialogue: 0,0:00:53.06,0:01:02.20,Default,,0,0,0,,Ғажайып сырлар, айта алмайтын нәрселердің бәрі
Dialogue: 0,0:01:11.60,0:01:12.83,Default,,0,0,0,,«Тамыз»
Dialogue: 0,0:01:25.13,0:01:26.30,Default,,0,0,0,,Жаз
Dialogue: 0,0:01:26.60,0:01:27.63,Default,,0,0,0,,Купальникте
Dialogue: 0,0:01:28.03,0:01:29.73,Default,,0,0,0,,Ләззат алыңыз!
Dialogue: 0,0:01:30.26,0:01:31.43,Default,,0,0,0,,Сонымен
Dialogue: 0,0:01:31.90,0:01:32.80,Default,,0,0,0,,өтуші!
Dialogue: 0,0:01:34.13,0:01:35.73,Default,,0,0,0,,Жаз
Dialogue: 0,0:01:37.26,0:01:38.26,Default,,0,0,0,,Купальникте
Dialogue: 0,0:01:40.26,0:01:42.26,Default,,0,0,0,,Ләззат алыңыз!
Dialogue: 0,0:01:46.10,0:01:49.26,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:50.63,0:01:53.40,Default,,0,0,0,,Олай болса жағажайда рахаттаныңыз!
Dialogue: 0,0:01:53.90,0:01:55.06,Default,,0,0,0,,Оу!
Dialogue: 0,0:01:56.66,0:01:59.03,Default,,0,0,0,,Хамф!
Dialogue: 0,0:01:59.90,0:02:00.83,Default,,0,0,0,,Иә
Dialogue: 0,0:02:01.83,0:02:02.56,Default,,0,0,0,,Хоряаа
Dialogue: 0,0:02:03.63,0:02:04.53,Default,,0,0,0,,Шабуыл!
Dialogue: 0,0:02:07.80,0:02:08.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:10.03,0:02:12.63,Default,,0,0,0,,Хмм... Допты ауыстыру!
Dialogue: 0,0:02:13.13,0:02:15.93,Default,,0,0,0,,Волейболды шын жүректен тамашалаңыз!
Dialogue: 0,0:02:16.76,0:02:21.06,Default,,0,0,0,,Иә, ә... ә, ә? Ах!
Dialogue: 0,0:02:22.33,0:02:25.70,Default,,0,0,0,,Чиририн Жоқ! Купальник кию қызық
Dialogue: 0,0:02:25.90,0:02:27.56,Default,,0,0,0,,Не? Солай ма?
Dialogue: 0,0:02:28.96,0:02:30.40,Default,,0,0,0,,Ой...
Dialogue: 0,0:02:32.20,0:02:34.20,Default,,0,0,0,,Оишо Оишо
Dialogue: 0,0:02:41.03,0:02:43.30,Default,,0,0,0,,Сарарин, міне, міне!
Dialogue: 0,0:02:43.63,0:02:46.43,Default,,0,0,0,,Мм... кеттік.
Dialogue: 0,0:02:48.20,0:02:52.43,Default,,0,0,0,,Ууууууууууууууу!
Dialogue: 0,0:02:53.23,0:02:55.20,Default,,0,0,0,,Сәттілік тілеймін Сара-чан!
Dialogue: 0,0:02:56.13,0:02:56.96,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:02:57.03,0:02:58.80,Default,,0,0,0,,Ухаау! Куку…
Dialogue: 0,0:02:59.23,0:02:59.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:00.53,0:03:01.86,Default,,0,0,0,,Сарачан!
Dialogue: 0,0:03:04.36,0:03:08.13,Default,,0,0,0,,Жаз... манки... бір...
Dialogue: 0,0:03:15.86,0:03:20.10,Default,,0,0,0,,Осы жолы бассейнде рахат алыңыз!
Dialogue: 0,0:03:20.70,0:03:25.13,Default,,0,0,0,,Дұрыс жылынайық. Жалқау болсаң батып кетесің.
Dialogue: 0,0:03:25.50,0:03:26.60,Default,,0,0,0,,Иә
Dialogue: 0,0:03:27.06,0:03:29.50,Default,,0,0,0,,...
Dialogue: 0,0:03:30.03,0:03:31.60,Default,,0,0,0,,хм/сағ
Dialogue: 0,0:03:32.23,0:03:34.40,Default,,0,0,0,,Пух... уф
Dialogue: 0,0:03:34.90,0:03:37.73,Default,,0,0,0,,Хо хо хо
Dialogue: 0,0:03:39.03,0:03:40.73,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:03:41.26,0:03:41.93,Default,,0,0,0,,Бұлхо!
Dialogue: 0,0:03:44.06,0:03:47.10,Default,,0,0,0,,Пуха! Міне, міне!
Dialogue: 0,0:03:47.66,0:03:52.53,Default,,0,0,0,,Куруру Кеттік! Ха ха ха ха ха... уф! Уф!
Dialogue: 0,0:03:53.93,0:03:57.30,Default,,0,0,0,,А... бұл өте үлкен...
Dialogue: 0,0:03:57.43,0:03:59.66,Default,,0,0,0,,Отбасыма…
Dialogue: 0,0:04:04.26,0:04:06.86,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл қызық болды, солай емес пе?
Dialogue: 0,0:04:07.36,0:04:07.86,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:08.03,0:04:11.30,Default,,0,0,0,,Бұл қорқынышты болды...
Dialogue: 0,0:04:18.40,0:04:22.60,Default,,0,0,0,,Қонақ үй бассейнінде рахаттаныңыз!
Dialogue: 0,0:04:36.30,0:04:38.63,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл шынымен үлкен бассейн, солай емес пе?
Dialogue: 0,0:04:38.96,0:04:40.96,Default,,0,0,0,,Менің ойымша, сіз осы жерден ләззат ала аласыз!
Dialogue: 0,0:04:41.30,0:04:44.13,Default,,0,0,0,,Мм, мен бүгін купальникпен рахаттанамын.
Dialogue: 0,0:04:44.80,0:04:47.60,Default,,0,0,0,,Иә, Хороро-чан, кеттік. иә?
Dialogue: 0,0:04:47.66,0:04:50.90,Default,,0,0,0,,Міне кеттік! Ах...
Dialogue: 0,0:04:50.96,0:04:54.56,Default,,0,0,0,,Ах! Хорорин өтірікші! Хмм
Dialogue: 0,0:04:54.76,0:04:56.70,Default,,0,0,0,,Хм, ахм, ах
Dialogue: 0,0:04:57.00,0:04:59.50,Default,,0,0,0,,Ммммммммм...
Dialogue: 0,0:04:59.86,0:05:02.53,Default,,0,0,0,,Ммммммм
Dialogue: 0,0:05:03.73,0:05:06.53,Default,,0,0,0,,А... дәмді болды.
Dialogue: 0,0:05:06.60,0:05:09.96,Default,,0,0,0,,-Иә, дәмді болды -Мен тойдым.
Dialogue: 0,0:05:10.66,0:05:12.96,Default,,0,0,0,,Жүр, бассейнді тамашалайық
Dialogue: 0,0:05:19.10,0:05:21.36,Default,,0,0,0,,Тағы барайық...
Dialogue: 0,0:05:29.26,0:05:32.30,Default,,0,0,0,,Мен тауға келдім!
Dialogue: 0,0:05:32.63,0:05:34.50,Default,,0,0,0,,Ауасы дәмді
Dialogue: 0,0:05:34.73,0:05:36.46,Default,,0,0,0,,Жел де жақсы сезінеді.
Dialogue: 0,0:05:37.10,0:05:39.40,Default,,0,0,0,,Ләззат алайық!
Dialogue: 0,0:05:39.63,0:05:40.53,Default,,0,0,0,,Оу!
Dialogue: 0,0:05:41.50,0:05:42.80,Default,,0,0,0,,Барбекю!
Dialogue: 0,0:05:43.30,0:05:45.96,Default,,0,0,0,,Хмм... Ләззат алыңыз!
Dialogue: 0,0:05:46.56,0:05:47.96,Default,,0,0,0,,Серуендеу!
Dialogue: 0,0:05:49.13,0:05:50.80,Default,,0,0,0,,Ләззат алыңыз!
Dialogue: 0,0:05:51.70,0:05:52.90,Default,,0,0,0,,Кемпинг!
Dialogue: 0,0:05:53.26,0:05:56.50,Default,,0,0,0,,Домалау, домалату, домалату...Ләззат алыңыз!
Dialogue: 0,0:05:57.73,0:05:59.03,Default,,0,0,0,,Ләззат алыңыз!
Dialogue: 0,0:05:59.66,0:06:00.66,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:06:01.16,0:06:03.13,Default,,0,0,0,,Керемет Керемет
Dialogue: 0,0:06:03.40,0:06:04.36,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:06:04.86,0:06:06.90,Default,,0,0,0,,Мен қазір ләззат алатын сияқтымын...
Dialogue: 0,0:06:07.30,0:06:08.30,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:06:08.70,0:06:10.36,Default,,0,0,0,,Осылай жүре берсек...
Dialogue: 0,0:06:10.70,0:06:11.80,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:06:12.26,0:06:14.90,Default,,0,0,0,,Сіз оны купальникпен тамашалай аласыз!
Dialogue: 0,0:06:17.20,0:06:17.70,Default,,0,0,0,,Жарайды…
Dialogue: 0,0:06:18.00,0:06:18.60,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:06:18.86,0:06:19.43,Default,,0,0,0,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:06:19.76,0:06:20.53,Default,,0,0,0,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,0:06:20.86,0:06:22.80,Default,,0,0,0,,Ммм... Ммм.
Dialogue: 0,0:06:22.90,0:06:25.26,Default,,0,0,0,,Мен бара аламын! Мен келесі жолы жүзе аламын!
Dialogue: 0,0:06:25.46,0:06:26.56,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:34.16,0:06:37.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:48.90,0:06:49.93,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:06:50.43,0:06:51.93,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:06:52.53,0:06:54.96,Default,,0,0,0,,Әйтеуір, мен купальник киіп ләззат алуым керек...
Dialogue: 0,0:06:56.10,0:06:59.90,Default,,0,0,0,,Жоқ! Мүмкін мен купальникімді ауыстырып көруім керек шығар...
Dialogue: 0,0:07:00.00,0:07:01.10,Default,,0,0,0,,Міне!
Dialogue: 0,0:07:04.73,0:07:05.53,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:05.83,0:07:07.10,Default,,0,0,0,,Жаңа купальник
Dialogue: 0,0:07:07.43,0:07:10.50,Default,,0,0,0,,Мен оны Хороринмен жасадым, солай ма?
Dialogue: 0,0:07:10.63,0:07:12.10,Default,,0,0,0,,Кесу жиегі
Dialogue: 0,0:07:12.53,0:07:16.23,Default,,0,0,0,,Сіз купальник жасап жатқаныңыз ғажап...
Dialogue: 0,0:07:16.46,0:07:18.30,Default,,0,0,0,,Чирири, менің көзім жүзіп тұр
Dialogue: 0,0:07:19.86,0:07:22.40,Default,,0,0,0,,Теңіз, бүгін жүзейік!
Dialogue: 0,0:07:22.50,0:07:23.43,Default,,0,0,0,,Оу!
Dialogue: 0,0:07:24.86,0:07:25.43,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:25.50,0:07:28.10,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:32.63,0:07:34.53,Default,,0,0,0,,Міне!
Dialogue: 0,0:07:35.60,0:07:36.16,Default,,0,0,0,,Теңіз
Dialogue: 0,0:07:37.86,0:07:39.10,Default,,0,0,0,,Купальникте
Dialogue: 0,0:07:40.66,0:07:42.50,Default,,0,0,0,,Ләззат алыңыз!
Dialogue: 0,0:07:44.06,0:07:44.60,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:51.33,0:07:54.80,Default,,0,0,0,,Кяаааа!
Dialogue: 0,0:08:09.76,0:08:11.93,Default,,0,0,0,,Сонымен бірге ол фонды да бір уақытта салып жатыр!
Dialogue: 0,0:08:13.93,0:08:17.46,Default,,0,0,0,,Жаз туралы айтқанда, мерекелерді ұмытпа.
Dialogue: 0,0:08:17.80,0:08:19.46,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:08:19.60,0:08:20.60,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:08:21.06,0:08:23.06,Default,,0,0,0,,Бірақ мен жүзе алмаймын...
Dialogue: 0,0:08:23.50,0:08:27.83,Default,,0,0,0,,Сіз ләззат алатын жалғыз нәрсе жүзу емес. Жүр, бірге барайық!
Dialogue: 0,0:08:33.03,0:08:34.93,Default,,0,0,0,,Бұл жазғы фестиваль
Dialogue: 0,0:08:35.40,0:08:36.63,Default,,0,0,0,,Кеттік.
Dialogue: 0,0:08:38.03,0:08:39.76,Default,,0,0,0,,Ой...
Dialogue: 0,0:08:40.63,0:08:42.30,Default,,0,0,0,,Сонымен бірге ол фонды да бір уақытта салып жатыр!
Dialogue: 0,0:08:44.56,0:08:46.30,Default,,0,0,0,,ветчина хммм...
Dialogue: 0,0:08:47.36,0:08:47.86,Default,,0,0,0,,Хмф!
Dialogue: 0,0:08:48.16,0:08:49.20,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:08:50.10,0:08:51.83,Default,,0,0,0,,Уау! Хехе
Dialogue: 0,0:08:52.33,0:08:53.13,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:08:56.33,0:08:57.46,Default,,0,0,0,,Иә...
Dialogue: 0,0:08:58.63,0:09:01.40,Default,,0,0,0,,Ха, қызық болды.
Dialogue: 0,0:09:01.80,0:09:03.50,Default,,0,0,0,,Сізге бұл қалай ұнады?
Dialogue: 0,0:09:03.73,0:09:04.90,Default,,0,0,0,,Уа!
Dialogue: 0,0:09:05.80,0:09:07.20,Default,,0,0,0,,Иә? а!
Dialogue: 0,0:09:10.83,0:09:12.20,Default,,0,0,0,,Бәрі бітті ме?
Dialogue: 0,0:09:13.56,0:09:17.13,Default,,0,0,0,,Иә, фестиваль біткен сияқты.
Dialogue: 0,0:09:18.50,0:09:20.30,Default,,0,0,0,,Бұл соңы ма...?
Dialogue: 0,0:09:20.93,0:09:21.83,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:09:22.33,0:09:23.26,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:23.96,0:09:25.23,Default,,0,0,0,,Не болды?
Dialogue: 0,0:09:25.53,0:09:26.73,Default,,0,0,0,,Бұл қызық емес пе?
Dialogue: 0,0:09:27.33,0:09:28.53,Default,,0,0,0,,…
Dialogue: 0,0:09:29.26,0:09:31.56,Default,,0,0,0,,Жазды купальникпен тамашалаңыз...
Dialogue: 0,0:09:31.96,0:09:33.83,Default,,0,0,0,,Бірақ мен мұны істей алмадым.
Dialogue: 0,0:09:34.06,0:09:36.53,Default,,0,0,0,,Мен жеткілікті жүзе алмаймын
Dialogue: 0,0:09:36.80,0:09:37.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:38.16,0:09:38.66,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:39.36,0:09:42.13,Default,,0,0,0,,Сіз купальник кимеген болсаңыз да, жаздың рахатын көре аласыз
Dialogue: 0,0:09:42.33,0:09:46.43,Default,,0,0,0,,Дұрыс, жазда неше түрлі қызықты нәрселер бар.
Dialogue: 0,0:09:54.63,0:09:57.20,Default,,0,0,0,,Ах! Ах... аа...
Dialogue: 0,0:10:01.53,0:10:04.70,Default,,0,0,0,,Міне. Бұл сүйкімді, солай емес пе?
Dialogue: 0,0:10:05.40,0:10:05.90,Default,,0,0,0,,Иә
Dialogue: 0,0:10:06.36,0:10:09.43,Default,,0,0,0,,Уау, сондай сүйкімді Чи Чан
Dialogue: 0,0:10:09.50,0:10:11.06,Default,,0,0,0,,Иә, сүйкімді
Dialogue: 0,0:10:11.53,0:10:13.76,Default,,0,0,0,,Иә, бұл жақсы.
Dialogue: 0,0:10:14.90,0:10:17.16,Default,,0,0,0,,Иә? иә!
Dialogue: 0,0:10:31.73,0:10:33.40,Default,,0,0,0,,Уау! ана!
Dialogue: 0,0:10:45.76,0:10:47.33,Default,,0,0,0,,Жаз көңілді!
Dialogue: 0,0:10:47.66,0:10:49.53,Default,,0,0,0,,Хмм, көп нәрсе болды.
Dialogue: 0,0:10:50.56,0:10:53.33,Default,,0,0,0,,Көптеген қызықты істер бар.
Dialogue: 0,0:10:53.63,0:10:55.90,Default,,0,0,0,,Маған қатты ұнады.
Dialogue: 0,0:11:00.26,0:11:00.90,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:08.90,0:11:09.96,Default,,0,0,0,,Күте алмайсыз ба?
Dialogue: 0,0:11:11.16,0:11:11.93,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:12.43,0:11:14.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:16.76,0:11:17.80,Default,,0,0,0,,Yahoo
Dialogue: 0,0:11:18.33,0:11:22.16,Default,,0,0,0,,Жазды купальникпен тамашалаңыз!
Dialogue: 0,0:11:28.26,0:11:40.56,Default,,0,0,0,,Жаздың сезімі теңіз бен тауды еске түсіреді.
Dialogue: 0,0:11:41.20,0:11:52.46,Default,,0,0,0,,Қараңдаршы, найзағай бұлттары да дауыстап жатыр.
Dialogue: 0,0:11:54.30,0:12:00.80,Default,,0,0,0,,Жүгір, жүгір, көңіл көтер
Dialogue: 0,0:12:00.86,0:12:02.10,Default,,0,0,0,,Бірақ
Dialogue: 0,0:12:04.03,0:12:11.23,Default,,0,0,0,,Ah фестиваль отшашу юката үлгісі
Dialogue: 0,0:12:11.70,0:12:17.86,Default,,0,0,0,,Қарбыз бассейніндегі купальниктің іздері
Dialogue: 0,0:12:18.20,0:12:21.10,Default,,0,0,0,,Жаз, жаз
Dialogue: 0,0:12:21.46,0:12:32.06,Default,,0,0,0,,Сағынышқа толы естеліктер жасаңыз, күннің нұры болыңыз
Dialogue: 0,0:12:33.56,0:12:39.56,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
