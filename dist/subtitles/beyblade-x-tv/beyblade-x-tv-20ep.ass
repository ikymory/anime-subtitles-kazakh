Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.10,0:00:05.50,Default,,0,0,0,,<Х... Адамдарды қызықтыратын нәрсе.
Dialogue: 0,0:00:05.50,0:00:09.14,Default,,0,0,0,,Бейблейд ойын ма? Бұл спорт па?
Dialogue: 0,0:00:09.14,0:00:12.47,Default,,0,0,0,,X➡-тің ең үлкен үдеуі
Dialogue: 0,0:00:12.47,0:00:16.45,Default,,0,0,0,,Экстремалды ойын.
Dialogue: 0,0:00:16.45,0:00:20.12,Default,,0,0,0,,X сіздің қолыңызда＞
Dialogue: 0,0:00:20.12,0:00:24.29,Default,,0,0,0,,Сәлем! Бұл Ичиго, AI тұмары!
Dialogue: 0,0:00:24.29,0:00:28.46,Default,,0,0,0,,Қолдау көрсеткеніңіз үшін рахмет!
Dialogue: 0,0:00:28.46,0:00:32.36,Default,,0,0,0,,Кенеттен жұмбақ жоғары жылдамдықты Феникс Фэр шығанағы пайда болды➡
Dialogue: 0,0:00:32.36,0:00:35.60,Default,,0,0,0,,Мен X-Ситиде дүрбелең тудырып жатырмын...
Dialogue: 0,0:00:35.60,0:00:39.77,Default,,0,0,0,,Бүгін драмалық шайқас жалғасуда.
Dialogue: 0,0:00:39.77,0:00:42.44,Default,,0,0,0,,Жаңадан келген команда осы маусымда өте белсенді болды.
Dialogue: 0,0:00:42.44,0:00:45.44,Default,,0,0,0,,Солардың ішінде ерекше атап өтетіні...
Dialogue: 0,0:00:45.44,0:00:47.61,Default,,0,0,0,,Team Persona!
Dialogue: 0,0:00:47.61,0:00:49.61,Default,,0,0,0,,Екі талантты адам бар тұлға➡
Dialogue: 0,0:00:49.61,0:00:52.51,Default,,0,0,0,,Ол дебютінен бері жеңіліс көрмеген.
Dialogue: 0,0:00:52.51,0:00:55.28,Default,,0,0,0,,Бұрын-соңды болмаған жылдамдықпен жүгіру➡
Dialogue: 0,0:00:55.28,0:00:58.12,Default,,0,0,0,,Біз қазір 50-қабаттамыз.
Dialogue: 0,0:00:58.12,0:01:02.93,Default,,0,0,0,,Бұл серпін қазіргі чемпион Pendragon командасынан бері байқалды ма?
Dialogue: 0,0:01:02.93,0:01:05.13,Default,,0,0,0,,Эйс Куросу Экс кетсе де ➡
Dialogue: 0,0:01:05.13,0:01:08.60,Default,,0,0,0,,әлі де чемпион ретінде билік етуді жалғастыруда.
Dialogue: 0,0:01:08.60,0:01:10.77,Default,,0,0,0,,Персонаға қайта оралайық.
Dialogue: 0,0:01:10.77,0:01:13.30,Default,,0,0,0,,Камен X ойыншысы ерекше таң қалдырады.
Dialogue: 0,0:01:13.30,0:01:18.44,Default,,0,0,0,,Қару ретіндегі шектен тыс соққыларымен ол тіпті ең қиын жауларды да талқандады.
Dialogue: 0,0:01:18.44,0:01:21.61,Default,,0,0,0,,Оның сүйікті Дран семсері - Рюгу Chrome ➡
Dialogue: 0,0:01:21.61,0:01:24.78,Default,,0,0,0,,Тақырып сәйкестігінде пайдаланылған шығанақпен бірдей үлгі.
Dialogue: 0,0:01:24.78,0:01:27.78,Default,,0,0,0,,Тағдырға ұқсайды.
Dialogue: 0,0:01:27.78,0:01:32.75,Default,,0,0,0,,Жеті түсті көп ойыншылар жақсы шайқастарға, жақсы көрнекіліктерге және жақсы кейіпкерлерге ие.
Dialogue: 0,0:01:32.75,0:01:35.62,Default,,0,0,0,,SNS ізбасарлары бар танымал шілтер ретінде➡
Dialogue: 0,0:01:35.62,0:01:40.03,Default,,0,0,0,,Bay Tube арнасының жазылушыларының саны күрт өсіп келеді.
Dialogue: 0,0:01:40.03,0:01:42.26,Default,,0,0,0,,Үшінші тұлға – Казами Құсы.
Dialogue: 0,0:01:42.26,0:01:45.13,Default,,0,0,0,,Алдыңғы екеуінен қабілет айырмашылығы бар болса да➡
Dialogue: 0,0:01:45.13,0:01:47.17,Default,,0,0,0,,Дәл қазір өсіп жатыр.
Dialogue: 0,0:01:47.17,0:01:50.44,Default,,0,0,0,,Өкінішке орай, мен әлі бірде-бір жеңіске жеткен жоқпын.
Dialogue: 0,0:01:50.44,0:01:53.91,Default,,0,0,0,,Әй, уақыт келді ме?
Dialogue: 0,0:01:53.91,0:01:56.45,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:01:56.45,0:01:58.45,Default,,0,0,0,,Алдымен Казами Құсы➡
Dialogue: 0,0:01:58.45,0:02:01.12,Default,,0,0,0,,Бір ұтып алуымыз үшін бізге қолдау көрсетіңіз.
Dialogue: 0,0:02:01.12,0:02:05.09,Default,,0,0,0,,Қызу шайқасты күтіңіздер!
Dialogue: 0,0:03:51.63,0:03:54.00,Default,,0,0,0,,Өзіңізді дұрыс таныстырыңыз!
Dialogue: 0,0:03:54.00,0:03:57.53,Default,,0,0,0,,Тек мен үшін Оны жарты жолда кесіп тастаудың жолы бар ма?
Dialogue: 0,0:03:57.53,0:03:59.60,Default,,0,0,0,,Мен де EX-тің қосымшасымын.
Dialogue: 0,0:03:59.60,0:04:03.61,Default,,0,0,0,,Өйткені, менің кейбір жанкүйерлерім Бей фанаттары емес.
Dialogue: 0,0:04:03.61,0:04:07.94,Default,,0,0,0,,Бұл сізді одан сайын бақытсыз етеді, сондықтан маған біртүрлі жұбаныш беруді доғарыңыз.
Dialogue: 0,0:04:07.94,0:04:10.11,Default,,0,0,0,,Мен танымалдылық сауалнамасының нәтижелерін қарап жатырмын➡
Dialogue: 0,0:04:10.11,0:04:14.62,Default,,0,0,0,,Мистер Бердтің танымалдығы дебютінен бері шамамен 100 есе өсті.
Dialogue: 0,0:04:14.62,0:04:17.99,Default,,0,0,0,,100 рет! ? Шын айтасың ба! Бұл керемет құс!
Dialogue: 0,0:04:17.99,0:04:19.92,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:19.92,0:04:23.13,Default,,0,0,0,,Бұл сіздің күш-жігеріңізге тұрарлық. Иә иә.
Dialogue: 0,0:04:23.13,0:04:25.09,Default,,0,0,0,,Уа, ау... (Мейден) Бұл ➡ дебют жасаған кезде
Dialogue: 0,0:04:25.09,0:04:27.10,Default,,0,0,0,,Ағымдағы салыстыру.
Dialogue: 0,0:04:30.43,0:04:33.44,Default,,0,0,0,,Жоқ, жоқ, жоқ. Ол мүлде өзгерген жоқ.
Dialogue: 0,0:04:33.44,0:04:35.94,Default,,0,0,0,,Мен осындай нәрсе болар деп ойладым.
Dialogue: 0,0:04:35.94,0:04:37.94,Default,,0,0,0,,Мұқият оқып шығыңыз.
Dialogue: 0,0:04:37.94,0:04:40.88,Default,,0,0,0,,Әрине 100 есе өсті.
Dialogue: 0,0:04:40.88,0:04:42.94,Default,,0,0,0,,Біріншісі өте кішкентай болды!
Dialogue: 0,0:04:42.94,0:04:44.95,Default,,0,0,0,,Мен де бар күшімді салып жатырмын!
Dialogue: 0,0:04:44.95,0:04:48.62,Default,,0,0,0,,Бірақ оның танымал бола бастағанына күмән жоқ. Көңіл көтеру.
Dialogue: 0,0:04:48.62,0:04:51.02,Default,,0,0,0,,Хина-чан да біздің бірінші фанатымыз.
Dialogue: 0,0:04:51.02,0:04:53.56,Default,,0,0,0,,Хинадан басқа ешкім жоқ!
Dialogue: 0,0:04:53.56,0:04:56.59,Default,,0,0,0,,№2 желдеткіш қайда? Жарайды, жарайды.
Dialogue: 0,0:04:56.59,0:04:58.76,Default,,0,0,0,,Бірд-саманың танымалдылығы➡
Dialogue: 0,0:04:58.76,0:05:01.93,Default,,0,0,0,,Бұл Персона үшін қиындық екенін жоққа шығаруға болмайды.
Dialogue: 0,0:05:01.93,0:05:04.13,Default,,0,0,0,,Болашақта жоғарғы қабаттарды мақсат ету үшін➡
Dialogue: 0,0:05:04.13,0:05:07.04,Default,,0,0,0,,Топ ретінде әсер етуді одан әрі арттыру➡
Dialogue: 0,0:05:07.04,0:05:10.81,Default,,0,0,0,,Басшылық танымал матчтарды ұйымдастыруы керек.
Dialogue: 0,0:05:14.94,0:05:19.95,Default,,0,0,0,,Бүгін Комаба сушиге арналған жаңа өнім кездесуі болады деп жоспарланған болатын.
Dialogue: 0,0:05:19.95,0:05:23.35,Default,,0,0,0,,президенттің денсаулығына байланысты жойылды.
Dialogue: 0,0:05:23.35,0:05:26.45,Default,,0,0,0,,Хекучинге!
Dialogue: 0,0:05:26.45,0:05:31.49,Default,,0,0,0,,Кестенің өзгеруі. Барлығы жаңа өнімдер ойлап тауып жатқанда➡
Dialogue: 0,0:05:31.49,0:05:33.53,Default,,0,0,0,,Бейбатл спаррингі➡
Dialogue: 0,0:05:33.53,0:05:37.27,Default,,0,0,0,,Көріністі Multi-sama-ның BayTube арнасына жүктеп алайық.
Dialogue: 0,0:05:37.27,0:05:41.30,Default,,0,0,0,,Суши дайындау кезінде шайқас па? (Мейден) Мульти мырза, қарсысыз ба?
Dialogue: 0,0:05:41.30,0:05:43.31,Default,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,0:05:43.31,0:05:45.27,Default,,0,0,0,,Спарринг жақсы➡
Dialogue: 0,0:05:45.27,0:05:47.61,Default,,0,0,0,,Жаңа өнім идеяларының бейнелері бар ма?
Dialogue: 0,0:05:47.61,0:05:50.48,Default,,0,0,0,,Әрине қажет.
Dialogue: 0,0:05:50.48,0:05:52.51,Default,,0,0,0,,Маман болудың сан алуан жолдары бар.
Dialogue: 0,0:05:52.51,0:05:56.28,Default,,0,0,0,,Қабілеті жағынан төменірек болса да танымал жүзшілер бар.
Dialogue: 0,0:05:56.28,0:05:59.45,Default,,0,0,0,,Өзімізді әр қырынан тани алсақ➡
Dialogue: 0,0:05:59.45,0:06:03.12,Default,,0,0,0,,Бейдің кәсіби қызметі де қолдауға ие болады.
Dialogue: 0,0:06:03.12,0:06:05.79,Default,,0,0,0,,Бұл суши болуы керек пе?
Dialogue: 0,0:06:05.79,0:06:09.66,Default,,0,0,0,,Бей демеушілері команданың түстеріне жиі әсер етеді.
Dialogue: 0,0:06:09.66,0:06:11.97,Default,,0,0,0,,Мысалы, Құс оны ойлап тапты➡
Dialogue: 0,0:06:11.97,0:06:14.94,Default,,0,0,0,,Өніміңізді түпнұсқа суши атымен шығарсаңыз➡
Dialogue: 0,0:06:14.94,0:06:16.94,Default,,0,0,0,,Сіз экспозиция жасай аласыз.
Dialogue: 0,0:06:16.94,0:06:20.28,Default,,0,0,0,,Құс Сіз суши жасай аласыз ба? Мен мұны бұрын ешқашан жасаған емеспін.
Dialogue: 0,0:06:20.28,0:06:23.28,Default,,0,0,0,,Бірақ Мейденнің солай айтқаны➡
Dialogue: 0,0:06:23.28,0:06:26.45,Default,,0,0,0,,Менің талантымды болжау. Менің ешқандай үмітім жоқ.
Dialogue: 0,0:06:26.45,0:06:29.22,Default,,0,0,0,,Мен білмедім... Мен оны білдім.
Dialogue: 0,0:06:31.95,0:06:33.92,Default,,0,0,0,,Бірден бастайық.
Dialogue: 0,0:06:33.92,0:06:38.13,Default,,0,0,0,,Бұл суши схемасы жаттығулары деп аталады.
Dialogue: 0,0:06:38.13,0:06:41.26,Default,,0,0,0,,Үш мүшенің бірі түпнұсқа суши жасайды➡
Dialogue: 0,0:06:41.26,0:06:43.27,Default,,0,0,0,,Қалған екеуінде Бейбатт бар.
Dialogue: 0,0:06:43.27,0:06:46.64,Default,,0,0,0,,Шайқаста жеңілген сушиді жеп, пікір жазады.
Dialogue: 0,0:06:46.64,0:06:49.77,Default,,0,0,0,,Бұл жазалау ойыны сияқты.
Dialogue: 0,0:06:49.77,0:06:52.21,Default,,0,0,0,,Сушимен тым оғаш ештеңе жасамайынша➡
Dialogue: 0,0:06:52.21,0:06:54.91,Default,,0,0,0,,Сіз жеуге болмайтын ештеңе жоқ. Эй Экс.
Dialogue: 0,0:06:54.91,0:06:56.95,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:06:56.95,0:07:00.62,Default,,0,0,0,,Ex - алаңдаушылықтың жалғыз себебі.
Dialogue: 0,0:07:00.62,0:07:03.69,Default,,0,0,0,,Олай болса, алдымен мен ұстаймын.
Dialogue: 0,0:07:06.62,0:07:08.79,Default,,0,0,0,,Сәлем, қош келдіңіз!
Dialogue: 0,0:07:08.79,0:07:10.76,Default,,0,0,0,,Мен әрқашан осылай ойлаймын➡
Dialogue: 0,0:07:10.76,0:07:12.96,Default,,0,0,0,,Multi параметрін кескін таңбасын➡ етіп жасаңыз
Dialogue: 0,0:07:12.96,0:07:15.80,Default,,0,0,0,,Комаба Сушидің басшылығы қауіпсіз емес пе?
Dialogue: 0,0:07:15.80,0:07:19.43,Default,,0,0,0,,Сонымен, Құс мырза зейнетке шыққысы келеді ме?
Dialogue: 0,0:07:19.43,0:07:21.97,Default,,0,0,0,,Құс Жасайық! О!
Dialogue: 0,0:07:21.97,0:07:25.94,Default,,0,0,0,,Persona Leader Мен сізге мұнда не бар екенін көрсетемін!
Dialogue: 0,0:07:29.28,0:07:32.28,Default,,0,0,0,,Міне кеттік.
Dialogue: 0,0:07:32.28,0:07:34.62,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:07:34.62,0:07:38.69,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:07:38.69,0:07:41.29,Default,,0,0,0,,Қой!
Dialogue: 0,0:07:45.43,0:07:48.10,Default,,0,0,0,,Егер бұл Х-ның стратегиясы болса, мен оны түсінемін.
Dialogue: 0,0:07:48.10,0:07:50.27,Default,,0,0,0,,Экстремалды сызықша!
Dialogue: 0,0:07:50.27,0:07:53.77,Default,,0,0,0,,Сол қауіпсіз аймақ... артта!
Dialogue: 0,0:07:53.77,0:07:55.94,Default,,0,0,0,,Артында қалсаң, соқпайсың!
Dialogue: 0,0:07:55.94,0:07:59.27,Default,,0,0,0,,және алаяқтық.
Dialogue: 0,0:07:59.27,0:08:02.44,Default,,0,0,0,,Міне!
Dialogue: 0,0:08:02.44,0:08:04.65,Default,,0,0,0,,Жоқ, ол тоқтамайды!
Dialogue: 0,0:08:07.88,0:08:10.89,Default,,0,0,0,,Бұл қауіпті. Ол мүлдем бос.
Dialogue: 0,0:08:19.26,0:08:24.47,Default,,0,0,0,,Төтенше сызықша қайтарылады!
Dialogue: 0,0:08:26.43,0:08:30.27,Default,,0,0,0,,Ах! Алақай!
Dialogue: 0,0:08:30.27,0:08:32.31,Default,,0,0,0,,Мен музыка колледжінде Саки Аримамен бір курс болғанмын, сондықтан→
Dialogue: 0,0:08:32.31,0:08:35.34,Default,,0,0,0,,Дран семсерінің жарылуы. Бұл мырзаның жеңісі.
Dialogue: 0,0:08:35.34,0:08:37.95,Default,,0,0,0,,Қорқынышты!
Dialogue: 0,0:08:37.95,0:08:39.95,Default,,0,0,0,,Икс мырзаның шайқас стилі➡
Dialogue: 0,0:08:39.95,0:08:43.28,Default,,0,0,0,,Экстремалды сызықшалардың алуан түрі бар, олар экстремалды сызықтарға қатысты болып көрінеді.
Dialogue: 0,0:08:43.28,0:08:46.96,Default,,0,0,0,,Кәсіби ойында бұл адамдарды алдау.
Dialogue: 0,0:08:46.96,0:08:51.09,Default,,0,0,0,,Осыны есте сақтаңыз. түсіндім.
Dialogue: 0,0:08:51.09,0:08:53.76,Default,,0,0,0,,Күте тұрыңыз! Бәрі бітті!
Dialogue: 0,0:08:53.76,0:08:58.93,Default,,0,0,0,,Енді мистер Құс, суши уақыты келді. Мен ұмыттым!
Dialogue: 0,0:08:58.93,0:09:02.84,Default,,0,0,0,,Хехе, мен жасаған түпнұсқа суши...
Dialogue: 0,0:09:02.84,0:09:05.61,Default,,0,0,0,,Тәтті картоп сушиі! Ләззат алыңыз!
Dialogue: 0,0:09:05.61,0:09:07.61,Default,,0,0,0,,Жарайды, мен оны жегім келмейді.
Dialogue: 0,0:09:07.61,0:09:10.28,Default,,0,0,0,,Міне, ережелер: Өтінемін, тамақтаныңыз.
Dialogue: 0,0:09:10.28,0:09:13.11,Default,,0,0,0,,Керемет~ Құс жақсы~.
Dialogue: 0,0:09:13.11,0:09:17.65,Default,,0,0,0,,Онда Х, сіз әдейі жеңіліп қалуыңыз керек еді.
Dialogue: 0,0:09:17.65,0:09:19.95,Default,,0,0,0,,Жарайды, мен жеймін.
Dialogue: 0,0:09:25.59,0:09:27.80,Default,,0,0,0,,Сіз қалай ойлайсыз? Сірке суы бар күріш жабысқақ күріш➡
Dialogue: 0,0:09:27.80,0:09:32.13,Default,,0,0,0,,Мен картоптың астына соя соусы негізіндегі тұздықты қойдым.
Dialogue: 0,0:09:32.13,0:09:35.77,Default,,0,0,0,,Хмм. Жоқ, мен оны әдеттегідей жей аламын.
Dialogue: 0,0:09:35.77,0:09:37.77,Default,,0,0,0,,Өте жақсы.
Dialogue: 0,0:09:37.77,0:09:40.78,Default,,0,0,0,,Бұл қандай нәзік реакция.
Dialogue: 0,0:09:40.78,0:09:43.11,Default,,0,0,0,,Өйткені ол охаги сияқты.
Dialogue: 0,0:09:43.11,0:09:46.11,Default,,0,0,0,,Мен мұндай үлкен реакцияға ие бола алмаймын. (2 адам) А.
Dialogue: 0,0:09:48.28,0:09:53.96,Default,,0,0,0,,Идея – ақылға қонымды, ал тағам расында дәмді.
Dialogue: 0,0:09:53.96,0:09:58.93,Default,,0,0,0,,Әсері жоқ. Бұл жаңа өнімдерді қабылдауға әкелмейді.
Dialogue: 0,0:09:58.93,0:10:02.26,Default,,0,0,0,,Гарн. Марути шошып кетеді.
Dialogue: 0,0:10:02.26,0:10:05.77,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:05.77,0:10:08.27,Default,,0,0,0,,Мен суши аспазшысы емеспін!
Dialogue: 0,0:10:08.27,0:10:10.77,Default,,0,0,0,,Бейкрафтер және Бейблэйдер!
Dialogue: 0,0:10:10.77,0:10:15.78,Default,,0,0,0,,Мен ешқашан Х жасаған сушиді жемеймін!
Dialogue: 0,0:10:15.78,0:10:17.78,Default,,0,0,0,,Аа….
Dialogue: 0,0:10:17.78,0:10:22.12,Default,,0,0,0,,《Дұрыс! Келесі: Егер сіз жоғалтсаңыз, X жасаған суши алыңыз!
Dialogue: 0,0:10:22.12,0:10:25.45,Default,,0,0,0,,Мен олардың қандай суши жасайтынын білмеймін! 》
Dialogue: 0,0:10:25.45,0:10:27.79,Default,,0,0,0,,Сәлем, қош келдіңіз!
Dialogue: 0,0:10:27.79,0:10:30.26,Default,,0,0,0,,Қош келдіңіз, қош келдіңіз, мен ұстаймын!
Dialogue: 0,0:10:30.26,0:10:32.66,Default,,0,0,0,,Менің оны жегім келмейді!
Dialogue: 0,0:10:32.66,0:10:35.93,Default,,0,0,0,,Дөрекі. Мен әлемдегі ең үлкен Комаба сушисінің жанкүйерімін.
Dialogue: 0,0:10:35.93,0:10:38.10,Default,,0,0,0,,Бұл ең жақсы.
Dialogue: 0,0:10:38.10,0:10:42.27,Default,,0,0,0,,Бастаймыз ба? Құс! Қарғыс атқыр...
Dialogue: 0,0:10:42.27,0:10:47.18,Default,,0,0,0,,Кез келген жағдайда жеңіңіз! Сіз оны қаншалықты лас пайдалансаңыз да!
Dialogue: 0,0:10:49.08,0:10:54.58,Default,,0,0,0,,Суши құдайына алғыс айту және суши жасау.
Dialogue: 0,0:10:57.09,0:10:59.12,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:10:59.12,0:11:02.92,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:11:02.92,0:11:05.23,Default,,0,0,0,,Қой!
Dialogue: 0,0:11:07.43,0:11:09.93,Default,,0,0,0,,《Түнгі қалқан – қорғаныс түрі.
Dialogue: 0,0:11:09.93,0:11:12.60,Default,,0,0,0,,Теория – орталықта қорғанысты күшейту.
Dialogue: 0,0:11:12.60,0:11:16.57,Default,,0,0,0,,Содан кейін алдымен ортаға қойыңыз》
Dialogue: 0,0:11:16.57,0:11:18.61,Default,,0,0,0,,Не!
Dialogue: 0,0:11:18.61,0:11:21.11,Default,,0,0,0,,Баяу. Түсірілім орны жақсы болмады.
Dialogue: 0,0:11:21.11,0:11:23.08,Default,,0,0,0,,Мен орталықты алдым!
Dialogue: 0,0:11:27.45,0:11:31.92,Default,,0,0,0,,келе жатыр Ол түсіп жатыр. Бұл шедевр болады деп ойлаймын!
Dialogue: 0,0:11:34.92,0:11:37.93,Default,,0,0,0,,Жоқ, ол әлі аяқталған жоқ. Жарылуды мақсат етіңіз!
Dialogue: 0,0:11:37.93,0:11:41.60,Default,,0,0,0,,《Түнгі қалқанның әлсіз жері оның жарылысқа төзімділігінің төмендігі.
Dialogue: 0,0:11:41.60,0:11:43.60,Default,,0,0,0,,Ратчетке ұмтылыңыз! 》
Dialogue: 0,0:11:48.60,0:11:52.11,Default,,0,0,0,,Бұл таяз. Мен одан бір қадам алдамын.
Dialogue: 0,0:11:52.11,0:11:54.91,Default,,0,0,0,,Әдейі еңкейту үшін шабуыл қолданылды! ?
Dialogue: 0,0:11:54.91,0:11:57.21,Default,,0,0,0,,Ратчетке шабуыл жасауға болмайды.
Dialogue: 0,0:12:00.62,0:12:02.62,Default,,0,0,0,,Мм. Бірақ➡
Dialogue: 0,0:12:02.62,0:12:05.12,Default,,0,0,0,,Айналу осі дірілдеп тұр!
Dialogue: 0,0:12:05.12,0:12:07.59,Default,,0,0,0,,Бұл ұзақ! Мені қанша уақыт күтесің?
Dialogue: 0,0:12:09.76,0:12:12.76,Default,,0,0,0,,Мен бара аламын! Мен бара аламын!
Dialogue: 0,0:12:12.76,0:12:15.76,Default,,0,0,0,,Сондықтан таяз дедім.
Dialogue: 0,0:12:15.76,0:12:19.47,Default,,0,0,0,,Қорғаныс түрлерінде Extreme Dash қолданудың қажеті жоқ деп ойладыңыз ба?
Dialogue: 0,0:12:22.94,0:12:25.44,Default,,0,0,0,,Жоқ, мен мұны басынан бастап жасадым! ?
Dialogue: 0,0:12:25.44,0:12:28.91,Default,,0,0,0,,«Түнгі қалқанға» барайық.
Dialogue: 0,0:12:28.91,0:12:32.68,Default,,0,0,0,,Төтенше сызықтық қалқанның әсері!
Dialogue: 0,0:12:40.96,0:12:43.02,Default,,0,0,0,,Түнгі қалқанның аяқталуы.
Dialogue: 0,0:12:43.02,0:12:47.76,Default,,0,0,0,,Мульти мырзаның жеңісі. Алақай!
Dialogue: 0,0:12:47.76,0:12:50.10,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:12:50.10,0:12:52.13,Default,,0,0,0,,Мен күттім!
Dialogue: 0,0:12:52.13,0:12:54.17,Default,,0,0,0,,Эй, күт!
Dialogue: 0,0:12:54.17,0:12:59.07,Default,,0,0,0,,Менің түпнұсқа сушиім шоколадпен қапталған миль-фель сушиі!
Dialogue: 0,0:12:59.07,0:13:02.08,Default,,0,0,0,,Бұл не? Шоколад емес пе?
Dialogue: 0,0:13:02.08,0:13:04.61,Default,,0,0,0,,Көрсең таң, жесең таң қал!
Dialogue: 0,0:13:04.61,0:13:07.12,Default,,0,0,0,,Сірке суы қосылған күріш пен тунецті кезектесіп салып, миль-фелье жасаңыз➡
Dialogue: 0,0:13:07.12,0:13:09.25,Default,,0,0,0,,Шоколадқа батырыңыз.
Dialogue: 0,0:13:09.25,0:13:11.25,Default,,0,0,0,,Ол қатып қалды!
Dialogue: 0,0:13:11.25,0:13:13.25,Default,,0,0,0,,Менің оны жегім келмейді!
Dialogue: 0,0:13:13.25,0:13:15.29,Default,,0,0,0,,Ережелер - бұл ережелер.
Dialogue: 0,0:13:15.29,0:13:18.43,Default,,0,0,0,,Мистер Экс - әлемдегі ең үлкен Комаба суши фанаты➡
Dialogue: 0,0:13:18.43,0:13:21.10,Default,,0,0,0,,Сіз ештеңе күте алмаймын деп айта алмайсыз ба?
Dialogue: 0,0:13:21.10,0:13:23.10,Default,,0,0,0,,Уау.
Dialogue: 0,0:13:23.10,0:13:25.10,Default,,0,0,0,,Көп болса, жеймін.
Dialogue: 0,0:13:25.10,0:13:29.50,Default,,0,0,0,,Түсіндім. Түсіндім. Мен уәдемді орындаймын.
Dialogue: 0,0:13:29.50,0:13:32.27,Default,,0,0,0,,А... иә.
Dialogue: 0,0:13:32.27,0:13:34.94,Default,,0,0,0,,Itadadakimasu.
Dialogue: 0,0:13:45.42,0:13:47.72,Default,,0,0,0,,Бұл суши!
Dialogue: 0,0:13:51.83,0:13:54.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:54.60,0:13:56.90,Default,,0,0,0,,Бұл жақсы болуы мүмкін емес! Эй!
Dialogue: 0,0:13:56.90,0:13:59.97,Default,,0,0,0,,X Сіз мені қатты қалжыңдап тұрсыз! Дұрыс істе!
Dialogue: 0,0:13:59.97,0:14:02.74,Default,,0,0,0,,Тіпті жей алмай қалғаным одан бетер қынжылтады!
Dialogue: 0,0:14:02.74,0:14:07.24,Default,,0,0,0,,Бұл қорқынышты. Мен бұл өте дәмді деп ойладым.
Dialogue: 0,0:14:07.24,0:14:10.41,Default,,0,0,0,,Жарайды. Енді менің ұрысым аяқталды➡
Dialogue: 0,0:14:10.41,0:14:12.41,Default,,0,0,0,,Енді сізге тек суши пісіру керек...
Dialogue: 0,0:14:12.41,0:14:16.08,Default,,0,0,0,,Қатты шайқас болғандықтан уақытымыз көп болды, сондықтан көп дайындалдық.
Dialogue: 0,0:14:16.08,0:14:18.42,Default,,0,0,0,,Сіз тым көп жасап жатырсыз!
Dialogue: 0,0:14:18.42,0:14:20.76,Default,,0,0,0,,Енді оны сынап көрудің қажеті жоқ, солай ма?
Dialogue: 0,0:14:20.76,0:14:23.59,Default,,0,0,0,,Жоқ, жоқ, Құс жоғалды.
Dialogue: 0,0:14:23.59,0:14:26.09,Default,,0,0,0,,Сізге тек біреуін ғана жеуге болады деп айтылмайды.
Dialogue: 0,0:14:26.09,0:14:28.76,Default,,0,0,0,,Себебі сіз тамақтанғыңыз келмейді!
Dialogue: 0,0:14:28.76,0:14:32.43,Default,,0,0,0,,Біз не істеуіміз керек? (ысқырық)
Dialogue: 0,0:14:32.43,0:14:35.27,Default,,0,0,0,,Мульти мырзаның айтқандары да орынды.
Dialogue: 0,0:14:35.27,0:14:37.27,Default,,0,0,0,,Тағы бір шайқас!
Dialogue: 0,0:14:37.27,0:14:39.31,Default,,0,0,0,,Күресіп жеңсең, жемейсің!
Dialogue: 0,0:14:39.31,0:14:41.31,Default,,0,0,0,,Мұны істейік.
Dialogue: 0,0:14:41.31,0:14:43.58,Default,,0,0,0,,Дайын болыңыз. Эх!
Dialogue: 0,0:14:43.58,0:14:46.25,Default,,0,0,0,,Бұл бейнені қызықтырақ етеді.
Dialogue: 0,0:14:46.25,0:14:50.28,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:14:50.28,0:14:55.42,Default,,0,0,0,,Multi Мен бұл шайқаста бұрынғыдан да ынталымын.
Dialogue: 0,0:14:55.42,0:14:57.43,Default,,0,0,0,,Бүгін бізде Х-ның сушиі➡
Dialogue: 0,0:14:57.43,0:15:00.60,Default,,0,0,0,,Мен сені толтырамын, Құс.
Dialogue: 0,0:15:00.60,0:15:02.76,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:15:02.76,0:15:06.27,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:15:06.27,0:15:09.24,Default,,0,0,0,,Қой!
Dialogue: 0,0:15:13.91,0:15:15.88,Default,,0,0,0,,Иә, өтінемін.
Dialogue: 0,0:15:21.58,0:15:24.59,Default,,0,0,0,,Тоқта! (Ичи) Ә? Мұнда ма?
Dialogue: 0,0:15:24.59,0:15:27.12,Default,,0,0,0,,…Күте тұр, біз шын мәнінде оларды атуымыз керек пе?!
Dialogue: 0,0:15:27.12,0:15:30.09,Default,,0,0,0,,Мен бұған жол бере алмаймын.
Dialogue: 0,0:15:30.09,0:15:32.16,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:15:35.23,0:15:38.90,Default,,0,0,0,,Марути мырза да әдеттегіден көп жұмыс істеді.
Dialogue: 0,0:15:38.90,0:15:40.90,Default,,0,0,0,,Енді оны тоқтатайық.
Dialogue: 0,0:15:40.90,0:15:44.44,Default,,0,0,0,,Олай жасасаң, бас пен тіл есінен танады.
Dialogue: 0,0:15:44.44,0:15:47.58,Default,,0,0,0,,X Суши Осорошия.
Dialogue: 0,0:15:47.58,0:15:50.95,Default,,0,0,0,,Бұрынғы қолайсыздық үшін кешірім сұраймыз! Мен байсалдымын!
Dialogue: 0,0:15:50.95,0:15:54.48,Default,,0,0,0,,Көремін, тәбетсіз суши жасау сипатымен➡
Dialogue: 0,0:15:54.48,0:15:56.75,Default,,0,0,0,,Мен бейнені жандандыруға тырысамын!
Dialogue: 0,0:15:56.75,0:15:58.92,Default,,0,0,0,,Ол мұны істеген жоқ.
Dialogue: 0,0:15:58.92,0:16:02.72,Default,,0,0,0,,Қарсы болмайсыз деп үміттенемін! Жақсы шешілді!
Dialogue: 0,0:16:06.09,0:16:08.46,Default,,0,0,0,,Мұндай сушиді кім жасады!
Dialogue: 0,0:16:08.46,0:16:10.60,Default,,0,0,0,,Бұл сенсің.
Dialogue: 0,0:16:10.60,0:16:13.40,Default,,0,0,0,,Кешіріңіз, мен әзілдегім келмеді...
Dialogue: 0,0:16:17.24,0:16:19.27,Default,,0,0,0,,Ол қалыпты тамақтанып жатыр.
Dialogue: 0,0:16:19.27,0:16:22.11,Default,,0,0,0,,Менің ойымша, Мейден-сан біртүрлі екен ғой?
Dialogue: 0,0:16:22.11,0:16:24.21,Default,,0,0,0,,Сізде шын мәнінде дәм сезімі жоқ па?
Dialogue: 0,0:16:27.18,0:16:30.45,Default,,0,0,0,,Сіз қалтырап тұрсыз ба?
Dialogue: 0,0:16:30.45,0:16:33.09,Default,,0,0,0,,Ештеңе жоқ, бірақ не?
Dialogue: 0,0:16:33.09,0:16:35.56,Default,,0,0,0,,Аа... Тимей-ақ қояйық.
Dialogue: 0,0:16:38.79,0:16:41.26,Default,,0,0,0,,Оны ұстау кезегім.
Dialogue: 0,0:16:41.26,0:16:44.27,Default,,0,0,0,,Сіз бұрын ешқашан суши дайындаған емеспін дедіңіз бе?
Dialogue: 0,0:16:44.27,0:16:46.90,Default,,0,0,0,,Жарайды, мен тамақ әзірлеуден жаман емеспін.
Dialogue: 0,0:16:46.90,0:16:51.81,Default,,0,0,0,,Жарайды, меніңше. Құс мен оны асыға күтемін.
Dialogue: 0,0:16:51.81,0:16:54.34,Default,,0,0,0,,Жеңілген адам көбірек жейді дейді.
Dialogue: 0,0:16:54.34,0:16:57.25,Default,,0,0,0,,Дұрыс. Сонда мен оны жей алмаймын.
Dialogue: 0,0:16:57.25,0:16:59.91,Default,,0,0,0,,Эй, сен маған жеңіле алмайсың ба?
Dialogue: 0,0:16:59.91,0:17:04.82,Default,,0,0,0,,А, жоқ, жоқ. Мен оны жей алмайтын шығармын.
Dialogue: 0,0:17:04.82,0:17:07.42,Default,,0,0,0,,Ұрыс қайта басталады.
Dialogue: 0,0:17:07.42,0:17:09.69,Default,,0,0,0,,Ханым…. (Суши ұстаған құстың дыбысы)
Dialogue: 0,0:17:13.93,0:17:15.93,Default,,0,0,0,,Міне, осылай.
Dialogue: 0,0:17:15.93,0:17:17.97,Default,,0,0,0,,Қазір қандай дыбыс?
Dialogue: 0,0:17:17.97,0:17:21.00,Default,,0,0,0,,Құс мырза, оны қайтадан ұстай аласыз ба?
Dialogue: 0,0:17:21.00,0:17:22.94,Default,,0,0,0,,А, иә.
Dialogue: 0,0:17:22.94,0:17:24.91,Default,,0,0,0,,Са.
Dialogue: 0,0:17:24.91,0:17:27.91,Default,,0,0,0,,Оның жүзі өзгерді! Бұл кәдімгі құс емес!
Dialogue: 0,0:17:31.31,0:17:34.22,Default,,0,0,0,,Керемет сома. Бұл дұрыс мөлшерде, сәйкес келеді.
Dialogue: 0,0:17:39.59,0:17:41.59,Default,,0,0,0,,Үш шағын қозғалыс!
Dialogue: 0,0:17:41.59,0:17:43.59,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:43.59,0:17:46.56,Default,,0,0,0,,Әртүрлі теориялар бар, бірақ суши оны жасау үшін барынша күш салуды қажет етеді.
Dialogue: 0,0:17:46.56,0:17:48.93,Default,,0,0,0,,Азды көп деп айтады.
Dialogue: 0,0:17:48.93,0:17:52.27,Default,,0,0,0,,Бұлардың ішінде үш қолмен мінсіз ұстайтын шебер сирек кездеседі.
Dialogue: 0,0:17:52.27,0:17:55.57,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:17:55.57,0:17:57.57,Default,,0,0,0,,Ренжімеңіз.
Dialogue: 0,0:17:57.57,0:18:00.07,Default,,0,0,0,,...
Dialogue: 0,0:18:00.07,0:18:02.44,Default,,0,0,0,,（）
Dialogue: 0,0:18:02.44,0:18:05.95,Default,,0,0,0,,...
Dialogue: 0,0:18:08.55,0:18:11.59,Default,,0,0,0,,Қандай әдемі суши.
Dialogue: 0,0:18:11.59,0:18:15.22,Default,,0,0,0,,Сушидің бұл жылтырлығы мен пішіні...
Dialogue: 0,0:18:15.22,0:18:18.26,Default,,0,0,0,,Суши тірі.
Dialogue: 0,0:18:18.26,0:18:22.73,Default,,0,0,0,,Құс Мен оны үнемі алып кетемін. қабырға.
Dialogue: 0,0:18:22.73,0:18:27.27,Default,,0,0,0,,Менің өмірім Бейблейд тарихымен өтті.
Dialogue: 0,0:18:27.27,0:18:30.91,Default,,0,0,0,,Бұл да суши тарихы.
Dialogue: 0,0:18:30.91,0:18:34.91,Default,,0,0,0,,Мен өмірімде мұндай суши табамын деп ойламаппын...
Dialogue: 0,0:18:39.58,0:18:44.72,Default,,0,0,0,,Шарлилахлила.
Dialogue: 0,0:18:44.72,0:18:47.15,Default,,0,0,0,,Рахмет Рахмет.
Dialogue: 0,0:18:47.15,0:18:51.76,Default,,0,0,0,,Тайшо мырза, жақсысыз ба? Мен жылап жатырмын.
Dialogue: 0,0:18:51.76,0:18:53.76,Default,,0,0,0,,Менде де болады.
Dialogue: 0,0:18:58.63,0:19:00.60,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:19:00.60,0:19:03.24,Default,,0,0,0,,Түсінікті айтайын.
Dialogue: 0,0:19:03.24,0:19:05.77,Default,,0,0,0,,Құс мырза - данышпан!
Dialogue: 0,0:19:05.77,0:19:09.64,Default,,0,0,0,,Сіз суши аспазшысы ретінде ерекше талантпен туылдыңыз.
Dialogue: 0,0:19:09.64,0:19:14.58,Default,,0,0,0,,Мені де құс ет! Менікі де! А, онда мені де ұстаңыз.
Dialogue: 0,0:19:14.58,0:19:18.45,Default,,0,0,0,,...
Dialogue: 0,0:19:18.45,0:19:21.02,Default,,0,0,0,,Құс Сізде Бей➡ таланты жоқ
Dialogue: 0,0:19:21.02,0:19:24.59,Default,,0,0,0,,Сіздің суши дайындауға қабілетіңіз болған сияқты.
Dialogue: 0,0:19:24.59,0:19:27.76,Default,,0,0,0,,Өтінемін, бұлай анық айтпаңыз.
Dialogue: 0,0:19:27.76,0:19:31.70,Default,,0,0,0,,Сіз шештіңіз! Құс - Комаба сушиінің мұрагері!
Dialogue: 0,0:19:31.70,0:19:33.57,Default,,0,0,0,,～
Dialogue: 0,0:19:33.57,0:19:37.77,Default,,0,0,0,,Бірд ақыры зейнетке шыға ма? Өте көп.
Dialogue: 0,0:19:37.77,0:19:41.94,Default,,0,0,0,,Мен сені тағы көремін. Ол кассада болуы мүмкін.
Dialogue: 0,0:19:41.94,0:19:45.45,Default,,0,0,0,,Әңгімені жалғастырмаңыз!
Dialogue: 0,0:19:45.45,0:19:49.92,Default,,0,0,0,,...
Dialogue: 0,0:19:55.12,0:19:58.53,Default,,0,0,0,,｟Бұл жаңа өнім. Күшті.
Dialogue: 0,0:19:58.53,0:20:01.93,Default,,0,0,0,,Қаламға және тағы басқаларға бекітіледі дейді. Президент осылай деді.
Dialogue: 0,0:20:01.93,0:20:06.10,Default,,0,0,0,,Кәдесый салпыншақтарын өндіруші Bay Sponsor болып табылады.
Dialogue: 0,0:20:06.10,0:20:10.27,Default,,0,0,0,,Жоқ, ең бастысы, Бладердің өзі қалай екені.
Dialogue: 0,0:20:10.27,0:20:12.24,Default,,0,0,0,,Біз шығанаққа назар аударамыз.
Dialogue: 0,0:20:12.24,0:20:15.64,Default,,0,0,0,,Chrome Неге мұны қолданбайсыз? иә?
Dialogue: 0,0:20:17.78,0:20:19.78,Default,,0,0,0,,Орындалды.
Dialogue: 0,0:20:19.78,0:20:22.15,Default,,0,0,0,,Мен осындаймын.
Dialogue: 0,0:20:26.12,0:20:30.49,Default,,0,0,0,,Эй, екі қызыл бұршақ пастасы кремді суши және жоғарғы жиынтық сізді күтуде!
Dialogue: 0,0:20:30.49,0:20:32.53,Default,,0,0,0,,Міне!
Dialogue: 0,0:20:32.53,0:20:35.53,Default,,0,0,0,,Бұл дүкен Комаба суши сатып алады, солай ма?
Dialogue: 0,0:20:39.10,0:20:42.67,Default,,0,0,0,,Хмм, мен бақыттымын!
Dialogue: 0,0:20:42.67,0:20:45.14,Default,,0,0,0,,Маған біртүрлі суши өте ұнайды.
Dialogue: 0,0:20:47.11,0:20:49.44,Default,,0,0,0,,Мен сұраудан аулақ боламын.
Dialogue: 0,0:20:49.44,0:20:52.75,Default,,0,0,0,,Бір тістеу жеткілікті! Мен мүлдем алданып қалдым.
Dialogue: 0,0:20:52.75,0:20:54.95,Default,,0,0,0,,Сіз өзіңізді алданып қалдым деп ойлайсыз.
Dialogue: 0,0:20:59.25,0:21:03.59,Default,,0,0,0,,Таңқаларлық, жаман емес.
Dialogue: 0,0:21:03.59,0:21:05.56,Default,,0,0,0,,Дұрыс? Эхехе.
Dialogue: 0,0:21:07.76,0:21:10.40,Default,,0,0,0,,...
Dialogue: 0,0:21:10.40,0:21:12.43,Default,,0,0,0,,Не?
Dialogue: 0,0:21:12.43,0:21:17.44,Default,,0,0,0,,...
Dialogue: 0,0:21:17.44,0:21:20.11,Default,,0,0,0,,Иә. Егер менде суши мен бей➡ болса
Dialogue: 0,0:21:20.11,0:21:22.48,Default,,0,0,0,,Маған басқа ештеңе керек емес.
Dialogue: 0,0:21:22.48,0:21:26.65,Default,,0,0,0,,Сізге суши мен лаврдан басқа ештеңе керек емес пе?
Dialogue: 0,0:21:28.62,0:21:32.19,Default,,0,0,0,,《 》
Dialogue: 0,0:21:35.92,0:21:38.63,Default,,0,0,0,,Не болды? Хм... ештеңе.
Dialogue: 0,0:21:43.60,0:21:46.07,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:21:46.07,0:21:48.74,Default,,0,0,0,,Дәмді.
Dialogue: 0,0:21:48.74,0:21:52.57,Default,,0,0,0,,Жақсы. Хмм, бұл суши ең жақсы.
Dialogue: 0,0:21:52.57,0:21:54.64,Default,,0,0,0,,Хехехе.
Dialogue: 0,0:21:54.64,0:21:57.14,Default,,0,0,0,,Мен алғаш рет Құсты керемет деп ойладым.
Dialogue: 0,0:21:57.14,0:21:59.41,Default,,0,0,0,,Олай айтпа.
Dialogue: 0,0:21:59.41,0:22:01.42,Default,,0,0,0,,Жарайды, келесі жолы мен де жасаймын➡
Dialogue: 0,0:22:01.42,0:22:04.92,Default,,0,0,0,,Мен құс сияқты дәмді суши жасаймын!
Dialogue: 0,0:22:04.92,0:22:07.42,Default,,0,0,0,,Енді X жоқ!
Dialogue: 0,0:22:07.42,0:22:11.93,Default,,0,0,0,,Иссо Казами Құсы Суши аспазшысы атағы бар ➡
Dialogue: 0,0:22:11.93,0:22:14.73,Default,,0,0,0,,Мистер Құстың суши шеберлігін көрсетеміз бе?
Dialogue: 0,0:22:14.73,0:22:17.77,Default,,0,0,0,,Келесі генералды анықтау рәсімін де жоспарлаймыз ба?
Dialogue: 0,0:22:17.77,0:22:22.24,Default,,0,0,0,,Менің мұрагерім жоқ екені рас. Мен бәрібір айтамын.
Dialogue: 0,0:22:22.24,0:22:25.94,Default,,0,0,0,,📺Құс Келесі - лосось. 📺Менде қызыл бұршақ пастасы бар крем суши бар.
Dialogue: 0,0:22:25.94,0:22:28.28,Default,,0,0,0,,📺Ол үшін Тайшо мырзадан сұраңыз.
Dialogue: 0,0:22:28.28,0:22:34.15,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:22:35.65,0:22:41.65,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory