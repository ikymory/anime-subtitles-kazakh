Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.10,0:00:05.47,Default,,0,0,0,,<Х... Адамдарды қызықтыратын нәрсе.
Dialogue: 0,0:00:05.47,0:00:09.10,Default,,0,0,0,,Бейблейд ойын ма? Бұл спорт па?
Dialogue: 0,0:00:09.10,0:00:12.44,Default,,0,0,0,,X➡-тің ең үлкен үдеуі
Dialogue: 0,0:00:12.44,0:00:16.51,Default,,0,0,0,,Экстремалды ойын.
Dialogue: 0,0:00:16.51,0:00:20.48,Default,,0,0,0,,X сіздің қолыңызда＞
Dialogue: 0,0:00:20.48,0:00:26.46,Default,,0,0,0,,Eh~ Shuffle Battle Fest командалық дауыс беруде 1 орын...
Dialogue: 0,0:00:26.46,0:00:29.79,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:00:29.79,0:00:31.79,Default,,0,0,0,,Менде X мені қатты тартады.
Dialogue: 0,0:00:31.79,0:00:33.80,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:00:33.80,0:00:35.80,Default,,0,0,0,,Сондай-ақ Мейден-сан мен Тайшо-санға➡
Dialogue: 0,0:00:35.80,0:00:37.80,Default,,0,0,0,,Менде көп ынтымақтастық болды.
Dialogue: 0,0:00:37.80,0:00:40.47,Default,,0,0,0,,Охохохо. (Тозақ залы) Сондай-ақ Құс ➡ үшін
Dialogue: 0,0:00:40.47,0:00:44.14,Default,,0,0,0,,Біз көп дауыс алдық.
Dialogue: 0,0:00:44.14,0:00:46.14,Default,,0,0,0,,Бұл керемет! ?
Dialogue: 0,0:00:46.14,0:00:48.51,Default,,0,0,0,,Көп болды! ? Көп болмады! ?
Dialogue: 0,0:00:48.51,0:00:51.55,Default,,0,0,0,,Тыңдама Тыңдама. Чикусо!
Dialogue: 0,0:00:51.55,0:00:54.22,Default,,0,0,0,,Бірақ мен мұны алдым.
Dialogue: 0,0:00:56.79,0:01:00.46,Default,,0,0,0,,Жеңімпаздың жүлдесі: Алтын шығанақ!
Dialogue: 0,0:01:00.46,0:01:02.82,Default,,0,0,0,,Қанша көрсем де әдемі...
Dialogue: 0,0:01:02.82,0:01:07.13,Default,,0,0,0,,Айтпақшы, ол Бэй демеушісіне берілмей ме?
Dialogue: 0,0:01:07.13,0:01:09.70,Default,,0,0,0,,Жоқ. Ха...
Dialogue: 0,0:01:11.77,0:01:13.80,Default,,0,0,0,,Тайшоу мырза. иә?
Dialogue: 0,0:01:13.80,0:01:16.14,Default,,0,0,0,,Se-no.
Dialogue: 0,0:01:16.14,0:01:18.44,Default,,0,0,0,,Жабдық!
Dialogue: 0,0:01:21.21,0:01:23.48,Default,,0,0,0,,О, ә?
Dialogue: 0,0:01:23.48,0:01:26.48,Default,,0,0,0,,Бүркітке?
Dialogue: 0,0:01:26.48,0:01:30.89,Default,,0,0,0,,Иә! эй эй эй…
Dialogue: 0,0:01:30.89,0:01:33.16,Default,,0,0,0,,Эй, эй, эй…. Қолдауыңызға рахмет!
Dialogue: 0,0:01:33.16,0:01:35.16,Default,,0,0,0,,Эй, эй, эй…. Мені қуантқаныңыз үшін рахмет➡
Dialogue: 0,0:01:35.16,0:01:37.16,Default,,0,0,0,,Жақсы, көп рахмет.
Dialogue: 0,0:01:37.16,0:01:39.13,Default,,0,0,0,,Хи хи...
Dialogue: 0,0:03:25.47,0:03:28.50,Default,,0,0,0,,Рахмет Рахмет….
Dialogue: 0,0:03:28.50,0:03:31.14,Default,,0,0,0,,Біз бүгін бірге ұйықтаймыз.
Dialogue: 0,0:03:31.14,0:03:33.14,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:03:33.14,0:03:36.51,Default,,0,0,0,,Ах~ Мен стримингке алаңдаймын.
Dialogue: 0,0:03:36.51,0:03:38.81,Default,,0,0,0,,Бірақ сен оған үйреніп бара жатырсың.
Dialogue: 0,0:03:38.81,0:03:43.19,Default,,0,0,0,,Бұдан былай келесі матчты еске түсіреміз.
Dialogue: 0,0:03:43.19,0:03:47.79,Default,,0,0,0,,Біз жұлдызды шайқасқа қатысу құқығын сәтті алдық.
Dialogue: 0,0:03:47.79,0:03:50.16,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:03:50.16,0:03:52.16,Default,,0,0,0,,Дауыстар жеткілікті болды ма?
Dialogue: 0,0:03:52.16,0:03:55.83,Default,,0,0,0,,Бұл қауіпті болды. Менің жоспарым болғанына қуаныштымын.
Dialogue: 0,0:03:55.83,0:03:58.47,Default,,0,0,0,,Екінші орын - Йггдрасил?
Dialogue: 0,0:03:58.47,0:04:02.90,Default,,0,0,0,,Өлмейтін күйік Юни Намба Некояма Зонамос –➡
Dialogue: 0,0:04:02.90,0:04:07.14,Default,,0,0,0,,Әр команда қызу тақырыпқа айналған шайқасқа қатысты.
Dialogue: 0,0:04:07.14,0:04:10.15,Default,,0,0,0,,Бірақ нәтиже 3-орын болды.
Dialogue: 0,0:04:10.15,0:04:13.55,Default,,0,0,0,,Бұл жеке дауыс берудің нәтижесі.
Dialogue: 0,0:04:13.55,0:04:15.82,Default,,0,0,0,,Ишияма: Бұл өте жоғары.
Dialogue: 0,0:04:15.82,0:04:19.49,Default,,0,0,0,,Бұл Зонамос пен Кадовер мырзамен бірдей.
Dialogue: 0,0:04:19.49,0:04:21.46,Default,,0,0,0,,Юмо жақсы жолда➡
Dialogue: 0,0:04:21.46,0:04:24.49,Default,,0,0,0,,Меніңше, Ишиямадан жеңілу ауыр тиді.
Dialogue: 0,0:04:24.49,0:04:27.13,Default,,0,0,0,,Мейден-сан... Юнидің астында! ? Керемет!
Dialogue: 0,0:04:27.13,0:04:30.50,Default,,0,0,0,,Қараңызшы, патша одан да жақсы!
Dialogue: 0,0:04:30.50,0:04:34.14,Default,,0,0,0,,Мульти мырзаның да рейтингі өте жоғары.
Dialogue: 0,0:04:34.14,0:04:36.57,Default,,0,0,0,,Сіз Бирннен жеңілдіңіз бе?
Dialogue: 0,0:04:36.57,0:04:39.14,Default,,0,0,0,,～
Dialogue: 0,0:04:39.14,0:04:41.14,Default,,0,0,0,,Менің рейтингім...
Dialogue: 0,0:04:41.14,0:04:43.81,Default,,0,0,0,,Бұл өте төмен болды.
Dialogue: 0,0:04:43.81,0:04:45.81,Default,,0,0,0,,Бүркіт астында.
Dialogue: 0,0:04:45.81,0:04:48.22,Default,,0,0,0,,Гррр! Осы позицияда➡
Dialogue: 0,0:04:48.22,0:04:50.12,Default,,0,0,0,,Дауыстар жеткілікті.
Dialogue: 0,0:04:50.12,0:04:54.12,Default,,0,0,0,,…  Ｘ…
Dialogue: 0,0:04:54.12,0:04:57.16,Default,,0,0,0,,Уау! 4-орын! ?
Dialogue: 0,0:04:57.16,0:04:59.16,Default,,0,0,0,,Мен оны бірінші нөмір деп ойладым.
Dialogue: 0,0:04:59.16,0:05:03.17,Default,,0,0,0,,...
Dialogue: 0,0:05:03.17,0:05:05.80,Default,,0,0,0,,Қабілетпен тікелей байланысты болмаса да ➡
Dialogue: 0,0:05:05.80,0:05:12.21,Default,,0,0,0,,Экс мырзадан көп дауыс алған үш адам бар екеніне назар аудара алмаймыз.
Dialogue: 0,0:05:12.21,0:05:15.81,Default,,0,0,0,,Жеке дауыс 3 орын Паккун арнасы командасы...
Dialogue: 0,0:05:15.81,0:05:18.48,Default,,0,0,0,,Паккун! Сен білесің бе?
Dialogue: 0,0:05:18.48,0:05:21.48,Default,,0,0,0,,...
Dialogue: 0,0:05:21.48,0:05:25.89,Default,,0,0,0,,２
Dialogue: 0,0:05:25.89,0:05:28.12,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:05:28.12,0:05:32.53,Default,,0,0,0,,...
Dialogue: 0,0:05:32.53,0:05:34.53,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:34.53,0:05:38.13,Default,,0,0,0,,Ал бірінші орында он мың аң Квин.
Dialogue: 0,0:05:38.13,0:05:42.80,Default,,0,0,0,,２
Dialogue: 0,0:05:42.80,0:05:44.81,Default,,0,0,0,,Келдің бе?
Dialogue: 0,0:05:44.81,0:05:46.81,Default,,0,0,0,,Ондай адам болды ма?
Dialogue: 0,0:05:46.81,0:05:50.81,Default,,0,0,0,,...
Dialogue: 0,0:05:50.81,0:05:53.82,Default,,0,0,0,,➡
Dialogue: 0,0:05:53.82,0:05:58.89,Default,,0,0,0,,...
Dialogue: 0,0:05:58.89,0:06:02.49,Default,,0,0,0,,２ ➡
Dialogue: 0,0:06:02.49,0:06:06.49,Default,,0,0,0,,Куинн бір адамдық команда ретінде ойнауды жалғастыруда.
Dialogue: 0,0:06:06.49,0:06:08.80,Default,,0,0,0,,...
Dialogue: 0,0:06:10.83,0:06:14.47,Default,,0,0,0,,３
Dialogue: 0,0:06:14.47,0:06:18.11,Default,,0,0,0,,Бұл кездесуде жеңіске жетпесек, шыңға шыға алмаймыз.
Dialogue: 0,0:06:18.11,0:06:21.11,Default,,0,0,0,,Мен жеңіске әбден құмармын!
Dialogue: 0,0:06:21.11,0:06:24.11,Default,,0,0,0,,...
Dialogue: 0,0:06:24.11,0:06:26.78,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын! Жоқ, мен жеңемін!
Dialogue: 0,0:06:26.78,0:06:30.79,Default,,0,0,0,,➡
Dialogue: 0,0:06:30.79,0:06:33.79,Default,,0,0,0,,...
Dialogue: 0,0:06:33.79,0:06:37.13,Default,,0,0,0,,Уау! Мен өзімді жанып тұрғандай сезінемін!
Dialogue: 0,0:06:37.13,0:06:39.46,Default,,0,0,0,,(Кацуми) Бұл не деген сөз өзі…? Бо-бо-бо-бо-бон!
Dialogue: 0,0:06:39.46,0:06:44.73,Default,,0,0,0,,Ойынға әлі уақыт бар. Біраз демалайық.
Dialogue: 0,0:06:48.10,0:06:50.77,Default,,0,0,0,,Күрсін.
Dialogue: 0,0:06:50.77,0:06:54.44,Default,,0,0,0,,Мен тым ұйықтап жатырмын...
Dialogue: 0,0:06:54.44,0:06:56.44,Default,,0,0,0,,Маған көмектесе алсаңыз➡
Dialogue: 0,0:06:56.44,0:06:58.45,Default,,0,0,0,,Мен айттым деп ойлаймын.
Dialogue: 0,0:06:58.45,0:07:00.45,Default,,0,0,0,,Бізде мұндай тұтынушылар жоқ деп ойлаймын...
Dialogue: 0,0:07:00.45,0:07:02.45,Default,,0,0,0,,Бұл бізге керек пе?
Dialogue: 0,0:07:02.45,0:07:04.75,Default,,0,0,0,,Мен жалғыз болсам, бос уақытым көбірек болар еді!
Dialogue: 0,0:07:04.75,0:07:06.79,Default,,0,0,0,,Сіз шынымен де осылай айтып отырсыз ба?
Dialogue: 0,0:07:06.79,0:07:11.46,Default,,0,0,0,,Марутидің сыртқа шығуға уақыты тым көп болды, ал Мейден де ол жерде болмады.
Dialogue: 0,0:07:11.46,0:07:13.43,Default,,0,0,0,,Егер бұл жігіт өлетін болғысы келмесе, денесін Сукунаға тапсырғаны дұрыс—
Dialogue: 0,0:07:13.43,0:07:15.43,Default,,0,0,0,,Ой! Сіз тұтынушысыз!
Dialogue: 0,0:07:15.43,0:07:18.10,Default,,0,0,0,,Ватата, қош келдіңіз... Ах!
Dialogue: 0,0:07:18.10,0:07:21.14,Default,,0,0,0,,📺(Құлпынай) Енді осы аптадағы Blader мүмкіндігі.
Dialogue: 0,0:07:21.14,0:07:24.64,Default,,0,0,0,,📺Үлгі ретінде де белсенді болып жүрген әлгі жүзікші. Уф, бұл өтірік болар еді...
Dialogue: 0,0:07:24.64,0:07:30.45,Default,,0,0,0,,📺(Ичиго) X Tower шыңында билік ететін Pendragon чемпион командасының бірі➡
Dialogue: 0,0:07:30.45,0:07:34.08,Default,,0,0,0,,Бұл Шигуру Нанайро!
Dialogue: 0,0:07:34.08,0:07:36.75,Default,,0,0,0,,Неге сен! ?
Dialogue: 0,0:07:36.75,0:07:38.75,Default,,0,0,0,,Мм. Ах!
Dialogue: 0,0:07:38.75,0:07:40.79,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:40.79,0:07:43.83,Default,,0,0,0,,Уф! Саған не болды? Сіз осындай жердесіз!
Dialogue: 0,0:07:43.83,0:07:46.46,Default,,0,0,0,,Мұнда лайықты суши жоқ!
Dialogue: 0,0:07:46.46,0:07:49.46,Default,,0,0,0,,Кешіріңіз! Пунска! Пунска!
Dialogue: 0,0:07:49.46,0:07:51.87,Default,,0,0,0,,Көптен бері көрмегелі.
Dialogue: 0,0:07:51.87,0:07:54.77,Default,,0,0,0,,Не? Чигурх, қалайсың?
Dialogue: 0,0:07:54.77,0:07:57.81,Default,,0,0,0,,Неге менімен қалыпты амандасып жатырсың?
Dialogue: 0,0:07:57.81,0:07:59.81,Default,,0,0,0,,Кім? Бұл адам.
Dialogue: 0,0:07:59.81,0:08:02.21,Default,,0,0,0,,Қазіргі командалас Құс!
Dialogue: 0,0:08:02.21,0:08:05.18,Default,,0,0,0,,Мен білмеймін. Мен оны ешқашан көрген емеспін.
Dialogue: 0,0:08:09.48,0:08:12.85,Default,,0,0,0,,Мен маскалы Х-тің кім екенін бірден түсіндім.
Dialogue: 0,0:08:12.85,0:08:15.46,Default,,0,0,0,,Тек Экс ғана осылай ата алады.
Dialogue: 0,0:08:15.46,0:08:17.79,Default,,0,0,0,,Ол матчты тамашалап отырды.
Dialogue: 0,0:08:17.79,0:08:21.50,Default,,0,0,0,,《Бұл екеуі бұрынғы командаластар》
Dialogue: 0,0:08:21.50,0:08:24.47,Default,,0,0,0,,Сіз бұрынғы жігітті қайтаруға келдіңіз бе?
Dialogue: 0,0:08:24.47,0:08:26.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:26.43,0:08:28.44,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:30.44,0:08:34.74,Default,,0,0,0,,《Жоғарыдағы мынау... Ұрыссыз да айтуға болады》
Dialogue: 0,0:08:37.51,0:08:39.55,Default,,0,0,0,,ол не үшін арналған?
Dialogue: 0,0:08:39.55,0:08:42.45,Default,,0,0,0,,… үшін.
Dialogue: 0,0:08:42.45,0:08:46.45,Default,,0,0,0,,Nu! Ах...
Dialogue: 0,0:08:46.45,0:08:48.86,Default,,0,0,0,,Корагуми суши, өтінемін.
Dialogue: 0,0:08:48.86,0:08:53.16,Default,,0,0,0,,Гаттеншочи! Алақай! ?
Dialogue: 0,0:08:53.16,0:08:55.80,Default,,0,0,0,,Кола Гуми суши Икчо Омачи!
Dialogue: 0,0:08:55.80,0:08:58.20,Default,,0,0,0,,Итадакимасу. (Тишо) Хм!
Dialogue: 0,0:09:00.47,0:09:02.47,Default,,0,0,0,,Дәмді.
Dialogue: 0,0:09:02.47,0:09:04.47,Default,,0,0,0,,Сіз мұнда жаңа ғана тамақ ішуге келдіңіз бе?
Dialogue: 0,0:09:04.47,0:09:06.47,Default,,0,0,0,,Келгеніңізге рахмет.
Dialogue: 0,0:09:06.47,0:09:10.48,Default,,0,0,0,,Бүгін мен жаңа кола сағыздарын сатып алдым.
Dialogue: 0,0:09:10.48,0:09:15.15,Default,,0,0,0,,Шигуру - Комаба сушидің жанкүйері. Шынайы ма?
Dialogue: 0,0:09:15.15,0:09:18.19,Default,,0,0,0,,Дүкенге бірінші рет келіп тұрсыз.
Dialogue: 0,0:09:18.19,0:09:20.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:22.46,0:09:24.46,Default,,0,0,0,,Қолтаңбаңызды ала аламын ба?
Dialogue: 0,0:09:28.83,0:09:30.87,Default,,0,0,0,,Көңілді толқып.
Dialogue: 0,0:09:30.87,0:09:35.47,Default,,0,0,0,,Иә. О, рахмет!
Dialogue: 0,0:09:35.47,0:09:39.17,Default,,0,0,0,,Бұл... ақсақ емес пе?
Dialogue: 0,0:09:42.14,0:09:44.15,Default,,0,0,0,,Мыс. иә?
Dialogue: 0,0:09:44.15,0:09:46.82,Default,,0,0,0,,Пендрагонға қайтып келу ниетіңіз бар ма?
Dialogue: 0,0:09:46.82,0:09:48.82,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:09:48.82,0:09:53.19,Default,,0,0,0,,Комаба сушиге кездейсоқ келдім, бірақ сұрағым келді.
Dialogue: 0,0:09:53.19,0:09:55.46,Default,,0,0,0,,Мен білмей тұрып, ол кетіп қалды.
Dialogue: 0,0:09:55.46,0:09:57.79,Default,,0,0,0,,Кешіріңіз, кешіріңіз Сіз ашулысыз ба?
Dialogue: 0,0:09:57.79,0:09:59.83,Default,,0,0,0,,қоспағанда.
Dialogue: 0,0:09:59.83,0:10:02.16,Default,,0,0,0,,Экс әрқашан солай болған.
Dialogue: 0,0:10:02.16,0:10:04.53,Default,,0,0,0,,Хром маған оны жалғыз қалдыруымды айтты➡
Dialogue: 0,0:10:04.53,0:10:07.14,Default,,0,0,0,,Мен қайтуым керек деп ойлаймын.
Dialogue: 0,0:10:07.14,0:10:09.80,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:10:09.80,0:10:14.78,Default,,0,0,0,,Себебі Персонаның Экс-тен басқа екі адамы әлсіз.
Dialogue: 0,0:10:14.78,0:10:17.78,Default,,0,0,0,,Ах... Не...
Dialogue: 0,0:10:17.78,0:10:21.15,Default,,0,0,0,,Экс қабілеті босқа кетеді.
Dialogue: 0,0:10:23.85,0:10:27.89,Default,,0,0,0,,Иә, мен саған кішкентай шабақ шығармын➡
Dialogue: 0,0:10:27.89,0:10:30.49,Default,,0,0,0,,Бірақ көп күшті! Мені мазақ ет...
Dialogue: 0,0:10:30.49,0:10:32.46,Default,,0,0,0,,Шигуруса➡
Dialogue: 0,0:10:32.46,0:10:35.80,Default,,0,0,0,,Менің серіктерім шынымен әлсіз екенін көргіңіз келе ме?
Dialogue: 0,0:10:35.80,0:10:37.80,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:10:42.84,0:10:44.91,Default,,0,0,0,,Аа….
Dialogue: 0,0:10:44.91,0:10:47.44,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:10:47.44,0:10:51.15,Default,,0,0,0,,Құс, бұл энергия қайда кетті?
Dialogue: 0,0:10:51.15,0:10:53.11,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:10:55.12,0:10:59.12,Default,,0,0,0,,Хе! Бұл шайқас! Сәттілік Құс.
Dialogue: 0,0:10:59.12,0:11:02.79,Default,,0,0,0,,Артық сөз айтпа, ол жоғарыдағылардың бірі!
Dialogue: 0,0:11:02.79,0:11:05.79,Default,,0,0,0,,Мен шығанағымды әкелген жоқпын.
Dialogue: 0,0:11:05.79,0:11:07.80,Default,,0,0,0,,Маған қызық сен кімсің...
Dialogue: 0,0:11:07.80,0:11:10.10,Default,,0,0,0,,Неліктен жоғарғы жағында?
Dialogue: 0,0:11:10.10,0:11:12.10,Default,,0,0,0,,Мейден-сан! ДДСҰ?
Dialogue: 0,0:11:12.10,0:11:14.14,Default,,0,0,0,,Біздің жаттықтырушы!
Dialogue: 0,0:11:14.14,0:11:16.60,Default,,0,0,0,,Сәлем.
Dialogue: 0,0:11:16.60,0:11:18.54,Default,,0,0,0,,Таңқаларлық сыпайы.
Dialogue: 0,0:11:18.54,0:11:20.44,Default,,0,0,0,,Бірақ әлсіз сияқты.
Dialogue: 0,0:11:20.44,0:11:23.44,Default,,0,0,0,,Бұл адам Экс-ның жаттықтырушысы болмайды.
Dialogue: 0,0:11:23.44,0:11:26.11,Default,,0,0,0,,Жоқ! ? Не! ? Бұл дұрыс емес.
Dialogue: 0,0:11:26.11,0:11:29.48,Default,,0,0,0,,Мен жай ғана президенттің хатшысымын.
Dialogue: 0,0:11:29.48,0:11:31.52,Default,,0,0,0,,Құс мырза➡
Dialogue: 0,0:11:31.52,0:11:35.12,Default,,0,0,0,,Орындаңыз! Тіпті Мейден!
Dialogue: 0,0:11:35.12,0:11:40.43,Default,,0,0,0,,Егер мен онымен келесі кездесетін болсам, ол титулдық матчта... жоғарғы жағында болар еді.
Dialogue: 0,0:11:40.43,0:11:43.80,Default,,0,0,0,,Қорқытуға бола ма?
Dialogue: 0,0:11:43.80,0:11:45.77,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:11:47.84,0:11:51.81,Default,,0,0,0,,Құрметті Сигур, егер қаласаңыз, менің шығанақты пайдаланыңыз.
Dialogue: 0,0:11:51.81,0:11:57.48,Default,,0,0,0,,Бұл шабуыл түрі ме? Мен тек теңдестірілген түрін пайдалана аламын.
Dialogue: 0,0:11:57.48,0:12:00.11,Default,,0,0,0,,Не? Дұрыс, сонда бұл не?
Dialogue: 0,0:12:00.11,0:12:03.42,Default,,0,0,0,,Не? О, менің тозақ өлшемім!
Dialogue: 0,0:12:05.79,0:12:07.79,Default,,0,0,0,,Иә….
Dialogue: 0,0:12:07.79,0:12:10.19,Default,,0,0,0,,Жаман емес.
Dialogue: 0,0:12:15.80,0:12:21.20,Default,,0,0,0,,Жоқ... Тозақтың балғасы маған әлі сенетінін сезбеймін.
Dialogue: 0,0:12:23.10,0:12:25.11,Default,,0,0,0,,Кеттік, жолдасым.
Dialogue: 0,0:12:25.11,0:12:29.11,Default,,0,0,0,,Марути мен Мейденді мазақ етсең, үндемей қаласың.
Dialogue: 0,0:12:34.08,0:12:36.12,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:12:36.12,0:12:39.19,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:12:39.19,0:12:42.76,Default,,0,0,0,,Қой!
Dialogue: 0,0:12:47.43,0:12:50.83,Default,,0,0,0,,Тозақ туралы сөз болғанда, мен жақсы білемін!
Dialogue: 0,0:12:50.83,0:12:54.44,Default,,0,0,0,,Тозақ өлшемі - бұл жоғарыдан бір соққы!
Dialogue: 0,0:12:54.44,0:12:58.44,Default,,0,0,0,,Бірақ егер сізде тозақ тізбегінің биіктігі болса!
Dialogue: 0,0:12:58.44,0:13:01.11,Default,,0,0,0,,Тозақтың өлшемі Салиқалы болайық!
Dialogue: 0,0:13:05.55,0:13:07.82,Default,,0,0,0,,Шынжырлы жез….
Dialogue: 0,0:13:11.45,0:13:13.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:18.43,0:13:20.90,Default,,0,0,0,,Тозақ өлшемі.
Dialogue: 0,0:13:20.90,0:13:24.77,Default,,0,0,0,,Бұл Шигуруру Нанайроның жеңісі.
Dialogue: 0,0:13:24.77,0:13:27.10,Default,,0,0,0,,Шу лезде өлім….
Dialogue: 0,0:13:27.10,0:13:29.47,Default,,0,0,0,,Тек түрту арқылы?
Dialogue: 0,0:13:29.47,0:13:33.44,Default,,0,0,0,,Менің тозақ өлшемім... мүлдем басқа...
Dialogue: 0,0:13:33.44,0:13:35.44,Default,,0,0,0,,Қараңызшы, бұл әлсіз.
Dialogue: 0,0:13:39.11,0:13:41.45,Default,,0,0,0,,Бұл қабілет айырмашылығы.
Dialogue: 0,0:13:41.45,0:13:43.75,Default,,0,0,0,,Қабілет….
Dialogue: 0,0:13:43.75,0:13:45.79,Default,,0,0,0,,Бұл дәлелденді.
Dialogue: 0,0:13:45.79,0:13:49.16,Default,,0,0,0,,Сіз бұрынғы әріптес болуға лайықсыз.
Dialogue: 0,0:13:49.16,0:13:52.79,Default,,0,0,0,,Ко... Коу!
Dialogue: 0,0:13:52.79,0:13:56.13,Default,,0,0,0,,Менің айтайын дегенім, сіз шынымен де кәсіпқойсыз ба?
Dialogue: 0,0:13:56.13,0:13:58.13,Default,,0,0,0,,О, сен!
Dialogue: 0,0:13:58.13,0:14:01.10,Default,,0,0,0,,Иә? О, мен...
Dialogue: 0,0:14:01.10,0:14:04.11,Default,,0,0,0,,Тоқта! Ах...
Dialogue: 0,0:14:04.11,0:14:06.14,Default,,0,0,0,,Тоқта, апа.
Dialogue: 0,0:14:06.14,0:14:09.48,Default,,0,0,0,,Көп!
Dialogue: 0,0:14:09.48,0:14:11.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:14.12,0:14:17.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:17.79,0:14:21.16,Default,,0,0,0,,Иә? иә? Әпке?
Dialogue: 0,0:14:21.16,0:14:25.23,Default,,0,0,0,,Нанайро Шигуру менің үлкен әпкем.
Dialogue: 0,0:14:25.23,0:14:29.43,Default,,0,0,0,,Е! ? Ойлап қарасақ, тегіміз бір екен ғой!
Dialogue: 0,0:14:29.43,0:14:33.13,Default,,0,0,0,,Сіз жаңа ғана байқадыңыз ба?
Dialogue: 0,0:14:33.13,0:14:36.80,Default,,0,0,0,,Ex! Сіз Марутиді командаңызға шақырғаныңызды білесіз бе?
Dialogue: 0,0:14:36.80,0:14:40.81,Default,,0,0,0,,Ах, а... А, енді білесің.
Dialogue: 0,0:14:40.81,0:14:44.81,Default,,0,0,0,,Алайда біз Мультиден ештеңе естіген жоқпыз.
Dialogue: 0,0:14:44.81,0:14:49.12,Default,,0,0,0,,Үлкен әпкеңізге сүйсінгендіктен кәсіпқой болғыңыз келді ме?
Dialogue: 0,0:14:49.12,0:14:51.79,Default,,0,0,0,,Керісінше.
Dialogue: 0,0:14:51.79,0:14:54.79,Default,,0,0,0,,Мен Нанайро Шигуруды жеңу үшін профессионал болдым!
Dialogue: 0,0:14:54.79,0:14:56.79,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:14:56.79,0:14:58.79,Default,,0,0,0,,Маған әлі уақыт керек еді➡
Dialogue: 0,0:14:58.79,0:15:02.16,Default,,0,0,0,,Жарайды, мен мәселені осында реттеймін!
Dialogue: 0,0:15:04.80,0:15:08.87,Default,,0,0,0,,Бұл косплей деп аталады ма?
Dialogue: 0,0:15:08.87,0:15:10.91,Default,,0,0,0,,Өте сүйкімді!
Dialogue: 0,0:15:10.91,0:15:13.14,Default,,0,0,0,,Көп ойыншы кейіпкеріңізді өзгерту арқылы ұрыс стиліңізді өзгертуге мүмкіндік береді.
Dialogue: 0,0:15:13.14,0:15:15.71,Default,,0,0,0,,Сенің әлсіз екеніңді осылай істеп жүргенің емес пе?
Dialogue: 0,0:15:17.78,0:15:20.45,Default,,0,0,0,,Қанша отбасы болса да солай айтасың...
Dialogue: 0,0:15:20.45,0:15:22.45,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:15:22.45,0:15:24.45,Default,,0,0,0,,Мен жаман адам емеспін.
Dialogue: 0,0:15:24.45,0:15:29.46,Default,,0,0,0,,Ренжімеңіз, тек өз ойымды айту.
Dialogue: 0,0:15:29.46,0:15:33.80,Default,,0,0,0,,Жеңілмейтін кәсіби рекордпен шыңға жетті➡
Dialogue: 0,0:15:33.80,0:15:37.20,Default,,0,0,0,,Барлық уақыттағы ең күшті Блейдерлердің бірі.
Dialogue: 0,0:15:37.20,0:15:43.81,Default,,0,0,0,,Менің әпкемнің көзқарасы бойынша, барлық қуықтар шын мәнінде әлсіз.
Dialogue: 0,0:15:46.41,0:15:48.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:48.41,0:15:51.08,Default,,0,0,0,,Бірақ мен де кәсіпқой болдым!
Dialogue: 0,0:15:51.08,0:15:54.68,Default,,0,0,0,,Мен жеңілістің дәмін татып, одан сайын күшейдім!
Dialogue: 0,0:15:58.05,0:16:00.09,Default,,0,0,0,,Егер сіз жеңгіңіз келсе, дәл қазір!
Dialogue: 0,0:16:00.09,0:16:02.76,Default,,0,0,0,,Кеттік Сиқыршы көрсеткі!
Dialogue: 0,0:16:02.76,0:16:06.76,Default,,0,0,0,,Жарайды, Мульти Қазір жасайық.
Dialogue: 0,0:16:11.17,0:16:13.07,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:16:13.07,0:16:15.07,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:16:15.07,0:16:18.77,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:16:18.77,0:16:22.14,Default,,0,0,0,,Қой!
Dialogue: 0,0:16:26.11,0:16:29.18,Default,,0,0,0,,Не? Бұл шығанақ.
Dialogue: 0,0:16:29.18,0:16:31.75,Default,,0,0,0,,Тозақтың өлшемі! Сіз ұмытшақсыз ба?
Dialogue: 0,0:16:31.75,0:16:35.46,Default,,0,0,0,,Тозақтың өлшемі... Соқтығыс.
Dialogue: 0,0:16:37.43,0:16:39.43,Default,,0,0,0,,Шебер көрсеткі!
Dialogue: 0,0:16:39.43,0:16:41.73,Default,,0,0,0,,Миражды қайтару!
Dialogue: 0,0:16:45.77,0:16:48.10,Default,,0,0,0,,Бұл мен пайдаланатын шығанақ емес сияқты.
Dialogue: 0,0:16:48.10,0:16:50.07,Default,,0,0,0,,Hmph….
Dialogue: 0,0:16:53.41,0:16:56.11,Default,,0,0,0,,Бірақ! Сіз зәр шығарып жатырсыз.
Dialogue: 0,0:16:56.11,0:16:58.38,Default,,0,0,0,,Түрлі түсті күріш торты!
Dialogue: 0,0:17:00.45,0:17:05.52,Default,,0,0,0,,Қуат берілмейтіндіктен, шикі шабуыл жұмыс істемейді.
Dialogue: 0,0:17:05.52,0:17:08.76,Default,,0,0,0,,Бірақ көп➡
Dialogue: 0,0:17:08.76,0:17:12.43,Default,,0,0,0,,Сіз бұл тактиканы қолданып көрдіңіз бе? иә?
Dialogue: 0,0:17:12.43,0:17:18.13,Default,,0,0,0,,Мен Марути есіне түсіреді деп ойладым, өйткені ол менен ақылдырақ, бірақ...
Dialogue: 0,0:17:20.87,0:17:23.84,Default,,0,0,0,,Басқа шешімдер болуы мүмкін, бірақ...
Dialogue: 0,0:17:26.44,0:17:30.11,Default,,0,0,0,,Өкінішке орай, мен тек біреуін білемін.
Dialogue: 0,0:17:36.08,0:17:38.39,Default,,0,0,0,,Хеллсцитті айыптаңыз.
Dialogue: 0,0:17:42.42,0:17:45.09,Default,,0,0,0,,Экстремалды сызықша.
Dialogue: 0,0:17:45.09,0:17:48.10,Default,,0,0,0,,Жарты айға қатысты үкім.
Dialogue: 0,0:17:48.10,0:17:50.36,Default,,0,0,0,,Ха...
Dialogue: 0,0:17:54.54,0:17:56.44,Default,,0,0,0,,Тозақ өлшемі.
Dialogue: 0,0:17:56.44,0:17:58.71,Default,,0,0,0,,Бұл Шигуруру Нанайроның жеңісі.
Dialogue: 0,0:18:03.44,0:18:06.75,Default,,0,0,0,,Бұрын мен үйге бара жатырмын➡
Dialogue: 0,0:18:06.75,0:18:09.75,Default,,0,0,0,,Пендрагонға кез келген уақытта оралыңыз.
Dialogue: 0,0:18:09.75,0:18:13.75,Default,,0,0,0,,Ах... Мұны Хромға айт.
Dialogue: 0,0:18:13.75,0:18:16.72,Default,,0,0,0,,Ол қазірдің өзінде жақын екенін айтты.
Dialogue: 0,0:18:25.47,0:18:29.47,Default,,0,0,0,,Баяғыдан бері талай рет шайқастық.
Dialogue: 0,0:18:29.47,0:18:34.88,Default,,0,0,0,,Мен Чигурхты жеңу үшін әртүрлі амалдарды қолдандым.
Dialogue: 0,0:18:34.88,0:18:37.85,Default,,0,0,0,,｟Кеттік! Барыңыз...｠
Dialogue: 0,0:18:39.78,0:18:43.78,Default,,0,0,0,,Нәтиже 10 000 қатарынан жоғалту болды.
Dialogue: 0,0:18:43.78,0:18:48.49,Default,,0,0,0,,Чигурхтың таланты ашылып, ол үйден кетуге шешім қабылдады.
Dialogue: 0,0:18:48.49,0:18:50.46,Default,,0,0,0,,｟Қашып кет! ?
Dialogue: 0,0:18:50.46,0:18:54.46,Default,,0,0,0,,Менімен болған шайқастан! жүгіріп кету?
Dialogue: 0,0:18:56.50,0:18:58.53,Default,,0,0,0,,Мұны істеудің мағынасы жоқ.
Dialogue: 0,0:18:58.53,0:19:02.50,Default,,0,0,0,,Себебі мен көп ойыншыны жеңе алмаймын.
Dialogue: 0,0:19:07.07,0:19:10.14,Default,,0,0,0,,Чигурх - нағыз Бейблейд генийі.
Dialogue: 0,0:19:10.14,0:19:16.75,Default,,0,0,0,,Мен Чигурхқа қарағанда бәрін жақсы істей алдым, бірақ менің сүйіктім Бей...
Dialogue: 0,0:19:16.75,0:19:20.76,Default,,0,0,0,,Көп…. жылы? Ах...
Dialogue: 0,0:19:20.76,0:19:23.16,Default,,0,0,0,,Сіздің бас тартатын ойыңыз жоқ емес пе?
Dialogue: 0,0:19:25.43,0:19:27.76,Default,,0,0,0,,Аа... Әрине!
Dialogue: 0,0:19:27.76,0:19:32.10,Default,,0,0,0,,Сізді 10 000 рет ұрып-соқтыңыз, ал қазір көңіл-күйіңіз түсіп кетті!
Dialogue: 0,0:19:32.10,0:19:34.44,Default,,0,0,0,,Хмм! Бұл рух!
Dialogue: 0,0:19:34.44,0:19:37.10,Default,,0,0,0,,Дегенмен, тырыса берсеңіз ➡
Dialogue: 0,0:19:37.10,0:19:39.81,Default,,0,0,0,,100% Кек болады.
Dialogue: 0,0:19:39.81,0:19:42.44,Default,,0,0,0,,Бұрын сенің орнында болсам.
Dialogue: 0,0:19:42.44,0:19:46.15,Default,,0,0,0,,Дұрыс, мен әлі сиқыршы таяқшасын шығарған жоқпын!
Dialogue: 0,0:19:46.15,0:19:49.12,Default,,0,0,0,,Дәл қазір шайқастан, өзімнің өмірлік өлшемдегі нұсқасы➡
Dialogue: 0,0:19:49.12,0:19:51.12,Default,,0,0,0,,Мен оны байқап көрдім.
Dialogue: 0,0:19:51.12,0:19:54.12,Default,,0,0,0,,Бұл дегеніміз... Иә.
Dialogue: 0,0:19:54.12,0:19:56.12,Default,,0,0,0,,Жеңіске жету жолын көрдім.
Dialogue: 0,0:19:56.12,0:19:58.79,Default,,0,0,0,,Мен данышпандық шыңнан асып түсемін!
Dialogue: 0,0:19:58.79,0:20:00.80,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:20:00.80,0:20:04.77,Default,,0,0,0,,Түсіндім! Бұрынғы Бірдке соғысуға рұқсат бергені➡
Dialogue: 0,0:20:04.77,0:20:07.80,Default,,0,0,0,,Бұл тәжірибе үшін ғана. Солай ма?
Dialogue: 0,0:20:07.80,0:20:11.44,Default,,0,0,0,,Не? Жоқ. Күшті адамдармен күресу қызық емес пе?
Dialogue: 0,0:20:11.44,0:20:13.47,Default,,0,0,0,,Аа, дұрыс...
Dialogue: 0,0:20:13.47,0:20:18.81,Default,,0,0,0,,Лорд Бард, сіз лорд Чигурхтың ертерек айтқан сөздерін еске түсірдіңіз.
Dialogue: 0,0:20:18.81,0:20:22.22,Default,,0,0,0,,Егер сіз биік мақсат қойсаңыз, шынайырақ болыңыз➡
Dialogue: 0,0:20:22.22,0:20:25.22,Default,,0,0,0,,Шындықпен бетпе-бет келу. иә.
Dialogue: 0,0:20:27.46,0:20:31.16,Default,,0,0,0,,Қазір маңыздысы - Жұлдыздар шайқасы.
Dialogue: 0,0:20:31.16,0:20:35.13,Default,,0,0,0,,Үш жаңа шығанақ үлгісінің қуатын әлі де шығаруға болады.
Dialogue: 0,0:20:37.13,0:20:39.13,Default,,0,0,0,,Иә.
Dialogue: 0,0:20:43.80,0:20:45.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:45.81,0:20:48.48,Default,,0,0,0,,Хе... Иә?
Dialogue: 0,0:20:48.48,0:20:51.75,Default,,0,0,0,,Ах, хехе.
Dialogue: 0,0:20:55.85,0:20:57.92,Default,,0,0,0,,Хром болуы керек….
Dialogue: 0,0:20:57.92,0:20:59.79,Default,,0,0,0,,Әпкеме...
Dialogue: 0,0:20:59.79,0:21:01.76,Default,,0,0,0,,Шыңға жетіңіз!
Dialogue: 0,0:21:04.16,0:21:07.19,Default,,0,0,0,,Жұлдызды шайқас: Сөзсіз жеңіс!
Dialogue: 0,0:21:07.19,0:21:09.20,Default,,0,0,0,,(Түсірудің аяқталу дыбысы)
Dialogue: 0,0:21:09.20,0:21:11.47,Default,,0,0,0,,Біз жақсы жарнамалық бейне түсіре алдық.
Dialogue: 0,0:21:11.47,0:21:13.83,Default,,0,0,0,,Егер сіз мұны шешсеңіз, онда арнайы жаттығулардың уақыты келді!
Dialogue: 0,0:21:13.83,0:21:16.80,Default,,0,0,0,,Шайқас? Қанекей мынаны істейік! Қанекей мынаны істейік!
Dialogue: 0,0:21:19.47,0:21:21.81,Default,,0,0,0,,Кешкі ас әзірлейміз бе?
Dialogue: 0,0:21:21.81,0:21:23.78,Default,,0,0,0,,Көп!
Dialogue: 0,0:21:32.79,0:21:34.79,Default,,0,0,0,,｟Zero Go: қазіргі X Tower чемпионы!
Dialogue: 0,0:21:34.79,0:21:38.49,Default,,0,0,0,,Тіпті сіздің жеке көшірмеңіз де сәйкес келмейді!
Dialogue: 0,0:21:40.90,0:21:46.43,Default,,0,0,0,,Ол болды... Ол сонда болды.
Dialogue: 0,0:21:46.43,0:21:50.44,Default,,0,0,0,,Бірақ мен... мұнда сезіндім｠
Dialogue: 0,0:21:53.74,0:21:58.75,Default,,0,0,0,,Экс-Хромға ештеңе айтпаңыз.
Dialogue: 0,0:21:58.75,0:22:03.75,Default,,0,0,0,,Себебі Chrom тек Ex.
Dialogue: 0,0:22:03.75,0:22:34.15,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:22:35.65,0:22:41.65,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory