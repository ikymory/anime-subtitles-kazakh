Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.10,0:00:04.93,Default,,0,0,0,,Х... Адамдарды қызықтыратын нәрсе.
Dialogue: 0,0:00:05.69,0:00:09.01,Default,,0,0,0,,Бейблейд ойын ма? Бұл спорт па?
Dialogue: 0,0:00:10.37,0:00:12.45,Default,,0,0,0,,Х-тің максималды үдеуі
Dialogue: 0,0:00:12.65,0:00:15.61,Default,,0,0,0,,Экстремалды ойын.
Dialogue: 0,0:00:16.98,0:00:19.50,Default,,0,0,0,,X сіздің қолыңызда
Dialogue: 0,0:00:28.98,0:00:32.28,Default,,0,0,0,,Сіз мұны шынымен жасайсыз ба? Мысалы.
Dialogue: 0,0:00:32.32,0:00:35.62,Default,,0,0,0,,Жоқ, Chrom. Мен бұл атаудан бас тарттым.
Dialogue: 0,0:00:36.32,0:00:39.62,Default,,0,0,0,,Kurosu Ex енді жоқ.
Dialogue: 0,0:00:39.96,0:00:46.56,Default,,0,0,0,,Менің атым Камен Х.
Dialogue: 0,0:00:49.12,0:00:53.47,Default,,0,0,0,,Кеттік. Бұл бірінші және соңғы Бейбатл!
Dialogue: 0,0:00:53.48,0:00:55.53,Default,,0,0,0,,Соңғысы?
Dialogue: 0,0:00:55.53,0:01:01.79,Default,,0,0,0,,Бұл менің жеңілгенімді білдіре ме?
Dialogue: 0,0:01:01.78,0:01:12.94,Default,,0,0,0,,Дұрыс, шығанда сөйлейтін сенсің.
Dialogue: 0,0:01:12.94,0:01:14.94,Default,,0,0,0,,〓Дайын жиынтық.
Dialogue: 0,0:01:14.95,0:01:17.97,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:01:17.97,0:01:25.96,Default,,0,0,0,,Қой!
Dialogue: 0,0:01:25.96,0:01:29.15,Default,,0,0,0,,Жүр! Доран Қылыш!
Dialogue: 0,0:01:29.14,0:01:34.28,Default,,0,0,0,,Жауап бер, Кобальт Дрейк!
Dialogue: 0,0:01:34.28,0:01:40.15,Default,,0,0,0,,Хехехе.
Dialogue: 0,0:01:40.16,0:01:44.70,Default,,0,0,0,,《Міне, басталды!》
Dialogue: 0,0:01:44.69,0:01:46.52,Default,,0,0,0,,Экстремалды сызықша!
Dialogue: 0,0:01:54.78,0:01:57.00,On Top,,0,0,0,,Бір уақытта бір қадам
Dialogue: 0,0:01:57.00,0:01:59.94,On Top,,0,0,0,,Қанша уақыт қажет болса да
Dialogue: 0,0:02:03.67,0:02:05.63,On Top,,0,0,0,,Мен көтерілуді жасаймын
Dialogue: 0,0:02:05.63,0:02:08.18,On Top,,0,0,0,,Мен жіберген қателіктерден сабақ ал
Dialogue: 0,0:02:12.26,0:02:18.18,On Top,,0,0,0,,Жүрегіңізді ашыңыз және жаңа әлем ашыңыз
Dialogue: 0,0:02:21.06,0:02:27.40,On Top,,0,0,0,,Мен сені сонда апарамын, енді тұйық жол жоқ
Dialogue: 0,0:02:29.54,0:02:32.36,On Top,,0,0,0,,Мен мұны айтамын, қолымнан ештеңе келмейді
Dialogue: 0,0:02:32.36,0:02:38.20,On Top,,0,0,0,,Жауап жоқ заманда не ойлайсың?
Dialogue: 0,0:02:38.45,0:02:40.62,On Top,,0,0,0,,Таяқтар мен тастар ешқашан болмайды
Dialogue: 0,0:02:40.62,0:02:42.58,On Top,,0,0,0,,Мына сүйектерді сындыр
Dialogue: 0,0:02:42.58,0:02:44.70,On Top,,0,0,0,,Бір уақытта бір қадам
Dialogue: 0,0:02:44.70,0:02:47.56,On Top,,0,0,0,,Қанша уақыт қажет болса да
Dialogue: 0,0:02:51.09,0:02:53.34,On Top,,0,0,0,,Мен көтерілуді жасаймын
Dialogue: 0,0:02:53.34,0:02:56.07,On Top,,0,0,0,,Мен жіберген қателіктерден сабақ ал
Dialogue: 0,0:02:58.84,0:03:03.32,On Top,,0,0,0,,Ал мен оны саған дәлелдеймін, сен оны дәлелде
Dialogue: 0,0:03:04.06,0:03:07.77,On Top,,0,0,0,,Оны сізге дәлелдеңіз, күмәнсіз дәлелдеңіз
Dialogue: 0,0:03:07.77,0:03:10.23,On Top,,0,0,0,,Маған бір мүмкіндікті бір мүмкіндік беріңіз
Dialogue: 0,0:03:10.23,0:03:13.35,On Top,,0,0,0,,Сондықтан мен сізге дәлелдей аламын
Dialogue: 0,0:03:15.61,0:03:18.62,On Top,,0,0,0,,Сондықтан мен сізге дәлелдей аламын
Dialogue: 0,0:03:30.50,0:03:34.54,Default,,0,0,0,,〓（）「  」
Dialogue: 0,0:03:34.53,0:03:38.13,Default,,0,0,0,,〓“Хунфу хунфуфун Комаба суши”
Dialogue: 0,0:03:38.14,0:03:41.13,Default,,0,0,0,,Қайырлы таң, Президент мырза.
Dialogue: 0,0:03:41.12,0:03:44.19,Default,,0,0,0,,Қайырлы таң, тозақ.
Dialogue: 0,0:03:44.19,0:03:47.11,Default,,0,0,0,,Үй жұмысын маған тапсырыңыз.
Dialogue: 0,0:03:47.11,0:03:50.11,Default,,0,0,0,,Мейден, компанияда жұмыс жасашы.
Dialogue: 0,0:03:50.12,0:03:55.63,Default,,0,0,0,,Комаба сушиін өткізетініңізге сенемін.
Dialogue: 0,0:03:55.62,0:03:57.61,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:03:57.61,0:04:01.81,Default,,0,0,0,,Ал... міне, сен оны жоққа шығарасың.
Dialogue: 0,0:04:01.81,0:04:04.80,Default,,0,0,0,,Барлығыңыз сонда болдыңыз ба?
Dialogue: 0,0:04:04.80,0:04:08.79,Default,,0,0,0,,Иә, барлығы жақсы көңіл-күймен шықты.
Dialogue: 0,0:04:08.78,0:04:12.45,Default,,0,0,0,,Солай ма? Кәсіби маман ретінде дайын болыңыз〓
Dialogue: 0,0:04:12.45,0:04:16.82,Default,,0,0,0,,Кетер алдында мен сізге тағы да біраз нұсқаулық бергім келді.
Dialogue: 0,0:04:16.83,0:04:18.88,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:04:18.88,0:04:22.12,Default,,0,0,0,,Мен де аздаған мәтін дайындадым.
Dialogue: 0,0:04:22.11,0:04:24.46,Default,,0,0,0,,Иә? Кішкене ғана?
Dialogue: 0,0:04:24.47,0:04:27.14,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:04:27.14,0:04:31.96,Default,,0,0,0,,Куу~ X мұнарасы!
Dialogue: 0,0:04:31.96,0:04:36.30,Default,,0,0,0,,Ақырында... ақырында, біз осы жерде күресе аламыз.
Dialogue: 0,0:04:36.29,0:04:38.44,Default,,0,0,0,,Біз кәсіби мамандармыз!
Dialogue: 0,0:04:38.45,0:04:41.45,Default,,0,0,0,,Күте тұрыңыз, жоғары!
Dialogue: 0,0:04:41.45,0:04:45.45,Default,,0,0,0,,Ал, ішке кірейік. Иә.
Dialogue: 0,0:04:45.45,0:04:58.13,Default,,0,0,0,,Әй, эй! Оны артта қалдырмаңыз!
Dialogue: 0,0:04:58.13,0:05:02.95,Default,,0,0,0,,X Tower-ке қош келдіңіздер, Bay жанкүйерлері!
Dialogue: 0,0:05:02.95,0:05:05.77,Default,,0,0,0,,Бұл Ичиго, AI тұмары.
Dialogue: 0,0:05:05.77,0:05:09.44,Default,,0,0,0,,Уау~ Бұл керемет!
Dialogue: 0,0:05:09.44,0:05:12.11,Default,,0,0,0,,Құлпынай-чан! сүйкімді!
Dialogue: 0,0:05:12.11,0:05:16.46,Default,,0,0,0,,Бүгін X Tower-те көптеген шайқастар бар!
Dialogue: 0,0:05:16.47,0:05:21.53,Default,,0,0,0,,Біз кәсіби шеберлер арасында қызу шайқас болады.
Dialogue: 0,0:05:21.52,0:05:25.79,Default,,0,0,0,,Керемет, Керемет, Керемет!
Dialogue: 0,0:05:25.79,0:05:29.44,Default,,0,0,0,,Бұл X мұнарасы ма? Сонымен...
Dialogue: 0,0:05:29.45,0:05:33.47,Default,,0,0,0,,Екеуіңіздің реакцияңыз әлсіз емес пе?
Dialogue: 0,0:05:33.47,0:05:37.46,Default,,0,0,0,,Жоқ, мен мұнда бірнеше рет болдым. Мен де.
Dialogue: 0,0:05:37.46,0:05:40.78,Default,,0,0,0,,Дәлірек айтсақ, неге сонша таңдандың?
Dialogue: 0,0:05:40.78,0:05:44.13,Default,,0,0,0,,Егер сіз Blader болсаңыз, сіз осында болдыңыз, солай емес пе?
Dialogue: 0,0:05:44.13,0:05:49.30,Default,,0,0,0,,Негізі мен кәсіпқой болған соң ғана осында қосылуды шештім.
Dialogue: 0,0:05:49.30,0:05:52.79,Default,,0,0,0,,Бүгін мұнда бірінші рет келіп тұрсыз.
Dialogue: 0,0:05:52.79,0:05:55.79,Default,,0,0,0,,Иә? Ол әдетте келеді.
Dialogue: 0,0:05:55.79,0:06:00.35,Default,,0,0,0,,Менің санамның жоғары немесе төмен екенін шынымен білмеймін.
Dialogue: 0,0:06:00.35,0:06:03.27,Default,,0,0,0,,Оны қосқаныңызға қуаныштымын! Оу!
Dialogue: 0,0:06:03.26,0:06:05.28,Default,,0,0,0,,Ой… Бұл сәл ағаттық болды.
Dialogue: 0,0:06:05.28,0:06:08.17,Default,,0,0,0,,Біз шыңға ұмтыламыз, солай ма?
Dialogue: 0,0:06:08.17,0:06:11.79,Default,,0,0,0,,Қонақ қабылдау бөлмесінде не істеуіміз керек? (2 адам) Ух...
Dialogue: 0,0:06:11.79,0:06:14.94,Default,,0,0,0,,Бұл жерде біздің шаруамыз жоқ.
Dialogue: 0,0:06:14.94,0:06:18.63,Default,,0,0,0,,〓Эй, бұл Персона. 〓Е! ? Сол қауесет?
Dialogue: 0,0:06:18.63,0:06:22.12,Default,,0,0,0,,Қол қойыңыз! Мен эфирді көрдім!
Dialogue: 0,0:06:22.12,0:06:28.78,Default,,0,0,0,,Мен де қолтаңба алғым келеді!
Dialogue: 0,0:06:28.77,0:06:33.12,Default,,0,0,0,,Ммммм.
Dialogue: 0,0:06:33.13,0:06:35.48,Default,,0,0,0,,Бұлай ісіп кетпеңіз.
Dialogue: 0,0:06:35.48,0:06:41.89,Default,,0,0,0,,Неге жалғыз мен...? Жақында құс келеді.
Dialogue: 0,0:06:41.89,0:06:43.93,Default,,0,0,0,,Біз келдік.
Dialogue: 0,0:06:43.92,0:07:05.18,Default,,0,0,0,,Мұнда? Бұл кәсіби сала.
Dialogue: 0,0:07:05.18,0:07:07.48,Default,,0,0,0,,О...
Dialogue: 0,0:07:07.48,0:07:11.30,Default,,0,0,0,,Уау... бұл керемет.
Dialogue: 0,0:07:11.30,0:07:14.47,Default,,0,0,0,,Иә, мен қатты қобалжыдым.
Dialogue: 0,0:07:14.47,0:07:19.64,Default,,0,0,0,,Клиенттерге лық толы басқа жақтан мүлде бөлек.
Dialogue: 0,0:07:19.64,0:07:30.97,Default,,0,0,0,,Бұл X мұнарасының шынайы көрінісі.
Dialogue: 0,0:07:30.97,0:07:35.86,Default,,0,0,0,,〓Нұсқаулық басталады. Еден картасын түртіңіз.
Dialogue: 0,0:07:35.86,0:07:37.90,Default,,0,0,0,,О!
Dialogue: 0,0:07:37.89,0:07:40.79,Default,,0,0,0,,〓Бұл артқы аула.
Dialogue: 0,0:07:40.80,0:07:44.12,Default,,0,0,0,,Әңгімелескен. Күткендей, бұл кәсіби сала.
Dialogue: 0,0:07:44.12,0:07:46.96,Default,,0,0,0,,Ондай басқа да нәрселер бар, солай ма?
Dialogue: 0,0:07:46.95,0:07:49.82,Default,,0,0,0,,〓Бұл медициналық бөлме.
Dialogue: 0,0:07:49.82,0:07:53.61,Default,,0,0,0,,〓Бұл жаттығу бөлмесі.
Dialogue: 0,0:07:53.61,0:08:06.57,Default,,0,0,0,,Ой, стадион! ?
Dialogue: 0,0:08:06.57,0:08:09.66,Default,,0,0,0,,Уау! Аа….
Dialogue: 0,0:08:09.66,0:08:16.20,Default,,0,0,0,,Бұл сіздің ату формасы мен шайқасыңызды тексеруге болатын жер.
Dialogue: 0,0:08:16.20,0:08:26.48,Default,,0,0,0,,Ах. Кәсіби жабдықтан күткендей. Ол орындалып жатыр.
Dialogue: 0,0:08:26.47,0:08:32.13,Default,,0,0,0,,Мен мұндай жерде жаттыға алатыныма сене алар емеспін...
Dialogue: 0,0:08:32.13,0:08:34.80,Default,,0,0,0,,Кәсіби тамаша!
Dialogue: 0,0:08:34.80,0:08:39.17,Default,,0,0,0,,Әй, сен мұнда болғандықтан, жаттығу жасайық!
Dialogue: 0,0:08:39.17,0:08:41.71,Default,,0,0,0,,Не? Қазір бастайсыз ба?
Dialogue: 0,0:08:41.71,0:08:45.46,Default,,0,0,0,,Әрине! иә~.
Dialogue: 0,0:08:45.46,0:08:47.48,Default,,0,0,0,,Не?
Dialogue: 0,0:08:47.48,0:08:51.48,Default,,0,0,0,,Ол әдетте бірден «Шайқас» деп келсе де.
Dialogue: 0,0:08:51.48,0:08:54.87,Default,,0,0,0,,Жоқ, міне... Жарайды, бір ғана ұрыс.
Dialogue: 0,0:08:54.87,0:08:56.96,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:08:56.95,0:08:59.14,Default,,0,0,0,,Мм.
Dialogue: 0,0:08:59.14,0:09:01.99,Default,,0,0,0,,Дұрыс, орындайық!
Dialogue: 0,0:09:01.99,0:09:08.18,Default,,0,0,0,,Дұрыс! Өйткені мен білмеймін.
Dialogue: 0,0:09:08.18,0:09:11.82,Default,,0,0,0,,〓Қыдырғышты тексеріңіз.
Dialogue: 0,0:09:11.82,0:09:19.81,Default,,0,0,0,,〓 Бей шайқасы басталады.
Dialogue: 0,0:09:19.81,0:09:22.15,Default,,0,0,0,,〓Дайын жиынтық.
Dialogue: 0,0:09:22.15,0:09:25.15,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:09:25.15,0:09:31.59,Default,,0,0,0,,Қой!
Dialogue: 0,0:09:31.59,0:09:36.48,Default,,0,0,0,,Кеттік! Тозақтың өлшемі!
Dialogue: 0,0:09:36.48,0:09:40.50,Default,,0,0,0,,Шетелге, қалағанымша кез келген жерге бара алар едім—
Dialogue: 0,0:09:40.50,0:09:52.18,Default,,0,0,0,,Уф... әлі жоқ!
Dialogue: 0,0:09:52.18,0:09:56.65,Default,,0,0,0,,Жоқ! Жүр, құс.
Dialogue: 0,0:09:56.65,0:10:10.81,Default,,0,0,0,,Келіңіз бе? Не! ?
Dialogue: 0,0:10:10.81,0:10:15.13,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:10:15.13,0:10:19.15,Default,,0,0,0,,О.
Dialogue: 0,0:10:19.15,0:10:29.79,Default,,0,0,0,,Уау! (Гүрілдеу)
Dialogue: 0,0:10:29.80,0:10:36.22,Default,,0,0,0,,Қандай бард. Бұл 4X шайқасы.
Dialogue: 0,0:10:36.22,0:10:38.47,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:38.47,0:10:43.46,Default,,0,0,0,,Соққы мен ағынмен көргеннен мүлдем басқаша! Ахаха.
Dialogue: 0,0:10:43.46,0:10:48.80,Default,,0,0,0,,Иә, бұл жақсы шайқас болды.
Dialogue: 0,0:10:48.80,0:10:52.80,Default,,0,0,0,,4X жүйесі керемет.
Dialogue: 0,0:10:52.80,0:10:56.79,Default,,0,0,0,,《Жауынгерлік бидің мінездемелері көрсетіледі〓
Dialogue: 0,0:10:56.79,0:11:00.81,Default,,0,0,0,,Сол кезде…》
Dialogue: 0,0:11:00.81,0:11:03.80,Default,,0,0,0,,《Бейнені бейнелеу арқылы шайқасты жандандыру〓
Dialogue: 0,0:11:03.80,0:11:09.87,Default,,0,0,0,,X мұнара жүйесі》
Dialogue: 0,0:11:09.87,0:11:11.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:11.94,0:11:14.79,Default,,0,0,0,,Иә! ? не! ?
Dialogue: 0,0:11:14.79,0:11:16.81,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:11:16.81,0:11:18.98,Default,,0,0,0,,Не... Бұл не! ?
Dialogue: 0,0:11:18.98,0:11:24.45,Default,,0,0,0,,А... аа....
Dialogue: 0,0:11:24.45,0:11:28.12,Default,,0,0,0,,Эй, эй! Сен не істеп жатырсың?
Dialogue: 0,0:11:28.12,0:11:30.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:30.12,0:11:32.79,Default,,0,0,0,,Уау, Ичиго-чан! ?
Dialogue: 0,0:11:32.79,0:11:36.78,Default,,0,0,0,,Иә! Ичиго - бұл AI тұмары.
Dialogue: 0,0:11:36.78,0:11:38.83,Default,,0,0,0,,Өлемін деп ойлайтын ешқандай жағдайға тап болған емеспін
Dialogue: 0,0:11:38.83,0:11:42.00,Default,,0,0,0,,Сіз мұндағы ережелерді білмейсіз бе?
Dialogue: 0,0:11:42.00,0:11:45.00,Default,,0,0,0,,Иә, бұл шын! ? Бұл шынайы!
Dialogue: 0,0:11:45.01,0:11:47.66,Default,,0,0,0,,Өте кішкентай! Ол қалқып тұр ма?
Dialogue: 0,0:11:47.66,0:11:50.53,Default,,0,0,0,,Эй, эй, не болып жатыр? Бұл да 4X па?
Dialogue: 0,0:11:50.53,0:11:54.57,Default,,0,0,0,,Эй, мен суретке түсе аламын ба? Фотосурет!
Dialogue: 0,0:11:54.57,0:11:58.17,Default,,0,0,0,,Уау~ Сіз оны экран арқылы көргенде одан да керемет!
Dialogue: 0,0:11:58.17,0:12:01.34,Default,,0,0,0,,Бұл өте керемет! Мына жаққа, мына жаққа қара!
Dialogue: 0,0:12:01.34,0:12:03.33,Default,,0,0,0,,
Dialogue: 0,0:12:03.32,0:12:05.51,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:05.51,0:12:08.50,Default,,0,0,0,,Бұл маңызды емес!
Dialogue: 0,0:12:08.50,0:12:10.50,Default,,0,0,0,,Мен мұнда тапсырыс бердім! ?
Dialogue: 0,0:12:10.50,0:12:13.49,Default,,0,0,0,,Оны пайдалану үшін алдын ала тапсырыс беру керек.
Dialogue: 0,0:12:13.48,0:12:15.98,Default,,0,0,0,,Сіз жасадыңыз ба? Сіз мұны жасадыңыз ба? ?
Dialogue: 0,0:12:15.99,0:12:18.68,Default,,0,0,0,,Йо...брондау...
Dialogue: 0,0:12:18.67,0:12:21.51,Default,,0,0,0,,Солай ма? Бұл дұрыс.
Dialogue: 0,0:12:21.51,0:12:24.03,Default,,0,0,0,,Білсеңіздер айтыңыздаршы!
Dialogue: 0,0:12:24.03,0:12:27.07,Default,,0,0,0,,Жоқ, мен олай ойламаймын.
Dialogue: 0,0:12:27.06,0:12:29.15,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:12:29.15,0:12:32.17,Default,,0,0,0,,Бронды дұрыс жасаңыз.
Dialogue: 0,0:12:32.17,0:12:34.51,Default,,0,0,0,,Мен сені келесі жолы кешірмеймін.
Dialogue: 0,0:12:34.51,0:12:37.13,Default,,0,0,0,,Кешіріңіз! Хмф!
Dialogue: 0,0:12:43.34,0:12:47.16,Default,,0,0,0,,А... Сен ашуландың.
Dialogue: 0,0:12:47.16,0:12:51.33,Default,,0,0,0,,Бұрынғыдан айырмашылығы, бұл менің мұнда бірінші рет келуім.
Dialogue: 0,0:12:51.34,0:12:53.66,Default,,0,0,0,,Сіз білуге ​​мүмкіндік жоқ.
Dialogue: 0,0:12:53.65,0:12:57.72,Default,,0,0,0,,Бірақ 4X шайқасы керемет болды, солай емес пе?
Dialogue: 0,0:12:57.73,0:12:59.77,Default,,0,0,0,,А, бұл керемет!
Dialogue: 0,0:12:59.76,0:13:03.31,Default,,0,0,0,,Айдаһар маған қарай келгенде қатты таң қалдым.
Dialogue: 0,0:13:03.31,0:13:05.35,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:13:05.35,0:13:09.50,Default,,0,0,0,,Тозақтың өлшемі осылай шыға ма деп ойлаймын. Шығу! Шығу!
Dialogue: 0,0:13:09.50,0:13:13.30,Default,,0,0,0,,Эй, мен де 4X аватарын шығарамын!
Dialogue: 0,0:13:13.31,0:13:15.66,Default,,0,0,0,,Анау үн, анау үн!
Dialogue: 0,0:13:15.66,0:13:18.66,Default,,0,0,0,,Бұл екеуінің тәубе ету ниеті жоқ.
Dialogue: 0,0:13:18.66,0:13:21.31,Default,,0,0,0,,Бұл кәсіби шайқас.
Dialogue: 0,0:13:21.32,0:13:24.01,Default,,0,0,0,,Менің де солай жасағым келеді! Мен ойнағым келеді!
Dialogue: 0,0:13:24.00,0:13:26.64,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:13:26.64,0:13:29.98,Default,,0,0,0,,Жарайды, мен қазір серіктес іздей бастаймын.
Dialogue: 0,0:13:29.97,0:13:31.99,Default,,0,0,0,,Сіз бұған шындап қарайсыз ба?
Dialogue: 0,0:13:31.99,0:13:34.79,Default,,0,0,0,,А... а.
Dialogue: 0,0:13:34.80,0:13:38.79,Default,,0,0,0,,Иә. иә? не?
Dialogue: 0,0:13:38.78,0:13:41.72,Default,,0,0,0,,Білесіз бе, біз кәсіби мамандармыз.
Dialogue: 0,0:13:41.72,0:13:44.79,Default,,0,0,0,,Сіз өзіңіз қалаған нәрсені ойнай алмайсыз.
Dialogue: 0,0:13:44.79,0:13:48.16,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:13:48.16,0:13:50.63,Default,,0,0,0,,Өйткені бізге менеджмент керек.
Dialogue: 0,0:13:50.63,0:13:55.32,Default,,0,0,0,,Басқару? Ал...
Dialogue: 0,0:13:55.32,0:13:58.32,Default,,0,0,0,,Маған не айтқыңыз келетінін айтыңызшы!
Dialogue: 0,0:13:58.32,0:14:05.79,Default,,0,0,0,,Иә, шынымды айтсам болады.
Dialogue: 0,0:14:05.79,0:14:07.96,Default,,0,0,0,,Иә, мен бұл туралы жазып аламын.
Dialogue: 0,0:14:07.96,0:14:09.96,Default,,0,0,0,,Жаднама.
Dialogue: 0,0:14:09.96,0:14:12.85,Default,,0,0,0,,Жарайсың ба? Ойлан, Құс.
Dialogue: 0,0:14:12.85,0:14:16.40,Default,,0,0,0,,Өткізілетін орынды қамтамасыз ету және матч карталарын ұйымдастыру〓
Dialogue: 0,0:14:16.40,0:14:18.99,Default,,0,0,0,,Әрбір шайқас үшін ережелер орнату〓
Dialogue: 0,0:14:18.99,0:14:22.31,Default,,0,0,0,,Матчты ойнау үшін көп дайындық қажет.
Dialogue: 0,0:14:22.31,0:14:25.13,Default,,0,0,0,,Сіздің ойыңызша, Blader мұның бәрін жасай алады ма?
Dialogue: 0,0:14:25.13,0:14:28.70,Default,,0,0,0,,Хмм... бұл мүмкін емес.
Dialogue: 0,0:14:28.70,0:14:30.82,Default,,0,0,0,,Дұрыс? Сонымен〓
Dialogue: 0,0:14:30.82,0:14:34.32,Default,,0,0,0,,Кәсіби сәйкестікті X Tower басшылығы басқарады.
Dialogue: 0,0:14:34.32,0:14:37.81,Default,,0,0,0,,Жалпы ереже бойынша матчтар бір қабаттағы командалар арасында ұйымдастырылады.
Dialogue: 0,0:14:37.81,0:14:39.85,Default,,0,0,0,,Біз бірінші қабаттамыз.
Dialogue: 0,0:14:39.84,0:14:42.14,Default,,0,0,0,,Комбинация шешілгеннен кейін〓
Dialogue: 0,0:14:42.15,0:14:45.04,Default,,0,0,0,,Басшылық Bay Sponsor-ға хабарласты〓
Dialogue: 0,0:14:45.03,0:14:49.97,Default,,0,0,0,,Демеушілер бізге айта алады.
Dialogue: 0,0:14:49.97,0:14:55.66,Default,,0,0,0,,Әй, кәсіпқойлар мен әуесқойлардың айырмашылығы көп.
Dialogue: 0,0:14:55.66,0:14:58.50,Default,,0,0,0,,(Әскерлер арасындағы сыбыр)
Dialogue: 0,0:14:58.50,0:15:02.32,Default,,0,0,0,,Бұл кәсіпқойлар мен әуесқойлар арасындағы жалғыз айырмашылық емес.
Dialogue: 0,0:15:02.32,0:15:06.32,Default,,0,0,0,,Кім? Кәсіби әлем қиын.
Dialogue: 0,0:15:06.32,0:15:09.84,Default,,0,0,0,,Егер сіз ұтылсаңыз немесе қызықсыз ойындар ойнай берсеңіз...
Dialogue: 0,0:15:09.84,0:15:11.84,Default,,0,0,0,,Демеуші кетеді.
Dialogue: 0,0:15:11.84,0:15:17.00,Default,,0,0,0,,Не? Егер мен демеушімнен айырылсам, мен осы X Tower-тен шығарыламын.
Dialogue: 0,0:15:17.00,0:15:20.89,Default,,0,0,0,,Демеуші болмау сіздің кәсіпқой емес екеніңізді білдіреді.
Dialogue: 0,0:15:20.89,0:15:22.83,Default,,0,0,0,,Е-е-е! ?
Dialogue: 0,0:15:22.82,0:15:25.67,Default,,0,0,0,,Басқаша айтқанда, сіз бәрін жоғалтасыз.
Dialogue: 0,0:15:25.67,0:15:29.32,Default,,0,0,0,,Біз осындай шиеленіс жағдайында күресуді жалғастырамыз.
Dialogue: 0,0:15:29.33,0:15:31.33,Default,,0,0,0,,Кәсіби адам деген осы.
Dialogue: 0,0:15:31.33,0:15:34.82,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:15:34.82,0:15:38.81,Default,,0,0,0,,Иә. Ха ха!
Dialogue: 0,0:15:38.80,0:15:42.35,Default,,0,0,0,,Бұл не болды? мінеки біз?
Dialogue: 0,0:15:42.36,0:15:44.91,Default,,0,0,0,,Мен көп нәрсені оқуым керек.
Dialogue: 0,0:15:44.91,0:15:47.65,Default,,0,0,0,,Уф... Мен барымды саламын.
Dialogue: 0,0:15:47.65,0:15:49.99,Default,,0,0,0,,Міне осылай...
Dialogue: 0,0:15:49.98,0:15:52.37,Default,,0,0,0,,〓Бұл Bay News уақыты.
Dialogue: 0,0:15:52.37,0:15:55.84,Default,,0,0,0,,〓Бүгінгі қонақ – X Tower шыңы〓
Dialogue: 0,0:15:55.84,0:15:59.64,Default,,0,0,0,,Бірінші чемпион командасының жетекшісі Пендрагон〓
Dialogue: 0,0:15:59.64,0:16:02.33,Default,,0,0,0,,Бұл Ryugu Chrome.
Dialogue: 0,0:16:02.33,0:16:06.68,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:16:06.68,0:16:10.48,Default,,0,0,0,,Pendragon да, Chrome да дебюттен бері жеңілмеген.
Dialogue: 0,0:16:10.48,0:16:14.63,Default,,0,0,0,,Өз күшіңіздің сырын айтыңызшы.
Dialogue: 0,0:16:14.64,0:16:18.34,Default,,0,0,0,,Құпия деген нәрсе жоқ.
Dialogue: 0,0:16:18.34,0:16:22.71,Default,,0,0,0,,Бұл жай ғана... ұтыла алмайтынымның себебі бар.
Dialogue: 0,0:16:22.71,0:16:26.81,Default,,0,0,0,,көремін. Мұның себебі неде?
Dialogue: 0,0:16:26.82,0:16:31.66,Default,,0,0,0,,Жалғыз Менің ұрысқым келетін адам бар.
Dialogue: 0,0:16:31.66,0:16:35.51,Default,,0,0,0,,Бұл көбірек ұрыс болар еді.
Dialogue: 0,0:16:35.51,0:16:40.60,Default,,0,0,0,,Оның шыңға жететініне сенімдімін.
Dialogue: 0,0:16:40.60,0:16:45.17,Default,,0,0,0,,О, мен Chrome ойнатқышын мұншалықты көп айтуға мәжбүрлейтін пышақ барына сене алар емеспін.
Dialogue: 0,0:16:45.17,0:16:47.82,Default,,0,0,0,,Мен бұл матчты асыға күтемін.
Dialogue: 0,0:16:47.82,0:16:50.32,Default,,0,0,0,,Бұл Ryugu Chrome болды.
Dialogue: 0,0:16:50.32,0:16:53.32,Default,,0,0,0,,Енді біз сіздерге бүгінгі матчты ұсынамыз.
Dialogue: 0,0:16:53.33,0:16:56.00,Default,,0,0,0,,Хэхехе…. иә? Экс не болды?
Dialogue: 0,0:16:56.00,0:17:00.39,Default,,0,0,0,,Уф! Мен матчты асыға күтемін!
Dialogue: 0,0:17:00.38,0:17:04.63,Default,,0,0,0,,Дұрыс! Түсіндім, түсінемін!
Dialogue: 0,0:17:04.64,0:17:06.98,Default,,0,0,0,,Уау! !
Dialogue: 0,0:17:06.97,0:17:10.32,Default,,0,0,0,,Иә? Кенеттен не болды?
Dialogue: 0,0:17:10.33,0:17:15.22,Default,,0,0,0,,Бұл сәйкестік! Жақында ойын ойнайық!
Dialogue: 0,0:17:15.22,0:17:18.32,Default,,0,0,0,,Да... бұл тым ақсақ.
Dialogue: 0,0:17:18.32,0:17:23.34,Default,,0,0,0,,Бұлай шырылдасаң да, жылдам ойнай алмайсың!
Dialogue: 0,0:17:23.34,0:17:25.38,Default,,0,0,0,,Аа...
Dialogue: 0,0:17:25.38,0:17:29.02,Default,,0,0,0,,Қараңызшы, бұл екеуіңізге де сәйкес келеді.
Dialogue: 0,0:17:29.01,0:17:38.09,Default,,0,0,0,,О! ойын!
Dialogue: 0,0:17:38.09,0:17:48.68,Default,,0,0,0,,Ах! не?
Dialogue: 0,0:17:48.68,0:17:51.00,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:17:51.00,0:17:55.35,Default,,0,0,0,,Ол да кәсіпқой.
Dialogue: 0,0:17:55.36,0:17:58.50,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:58.49,0:18:00.93,Default,,0,0,0,,О~ Өте жақсы!
Dialogue: 0,0:18:00.93,0:18:05.49,Default,,0,0,0,,Бұл шайқас Zero Go-ның тікелей түсіндірмесінде де қызып жатыр.
Dialogue: 0,0:18:05.48,0:18:08.02,Default,,0,0,0,,Алдын алу Алдын алу Алдын алу!
Dialogue: 0,0:18:08.02,0:18:11.34,Default,,0,0,0,,Леонклауды темірдей қорғаныспен қорғаңыз!
Dialogue: 0,0:18:11.34,0:18:15.01,Default,,0,0,0,,Бұл Такуми Ишияманың Монблан тасты.
Dialogue: 0,0:18:15.01,0:18:19.65,Default,,0,0,0,,Аңдар патшасы әбден басылған!
Dialogue: 0,0:18:19.65,0:18:23.65,Default,,0,0,0,,Мен жеңіле алмаймын.
Dialogue: 0,0:18:23.65,0:18:27.34,Default,,0,0,0,,〓(Zero Go) Ватт! ?
Dialogue: 0,0:18:27.34,0:18:30.74,Default,,0,0,0,,〓Орындар ауыстырылды ма?
Dialogue: 0,0:18:30.74,0:18:35.83,Default,,0,0,0,,〓Қызықты! Бұл мақсат па? Тас Монблан.
Dialogue: 0,0:18:35.83,0:18:39.65,Default,,0,0,0,,〓Леонклау Мені қатты соққыға жыққан.
Dialogue: 0,0:18:39.65,0:18:43.00,Default,,0,0,0,,Ол өте күшті.
Dialogue: 0,0:18:43.00,0:18:46.82,Default,,0,0,0,,Біртүрлі нәрсе емес пе? иә?
Dialogue: 0,0:18:46.82,0:18:51.83,Default,,0,0,0,,Маған сонша шабуыл жасалса да, менің айналуым мүлдем өзгермейді.
Dialogue: 0,0:18:51.83,0:18:55.67,Default,,0,0,0,,Бұл... Бұл сіздің байсалды емес екеніңізді білдіре ме?
Dialogue: 0,0:18:55.67,0:19:00.33,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:19:00.32,0:19:02.34,Default,,0,0,0,,Шетелге, қалағанымша кез келген жерге бара алар едім—
Dialogue: 0,0:19:02.34,0:19:04.51,Default,,0,0,0,,Қабілеттің осы деңгейімен〓
Dialogue: 0,0:19:04.51,0:19:08.01,Default,,0,0,0,,Менімен ойнауды шешкеніңізге сенімдімін.
Dialogue: 0,0:19:08.01,0:19:10.66,Default,,0,0,0,,Не?
Dialogue: 0,0:19:10.66,0:19:17.82,Default,,0,0,0,,Ұстаңыз! Патшаның алдында!
Dialogue: 0,0:19:17.82,0:19:19.82,Default,,0,0,0,,Келсең, кел!
Dialogue: 0,0:19:19.82,0:19:23.22,Default,,0,0,0,,Стоун Монбланның қорғанысы өтпейді!
Dialogue: 0,0:19:23.23,0:19:29.00,Default,,0,0,0,,Темірмен қапталған ба?
Dialogue: 0,0:19:29.00,0:19:40.85,Default,,0,0,0,,Тас сияқты нәрсе патшаның алға жылжуына кедергі бола ала ма?
Dialogue: 0,0:19:40.84,0:19:43.49,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:19:43.50,0:19:56.66,Default,,0,0,0,,Леонклауды тістеп ал!
Dialogue: 0,0:19:56.66,0:19:59.33,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:19:59.33,0:20:12.68,Default,,0,0,0,,Экстремалды сызықша! Жануарлардың патшасы!
Dialogue: 0,0:20:12.68,0:20:15.33,Default,,0,0,0,,〓Леон тырнағын аяқтау.
Dialogue: 0,0:20:15.33,0:20:18.33,Default,,0,0,0,,〓Он мың аң патшасы үшін 2 ұпай.
Dialogue: 0,0:20:18.33,0:20:22.97,Default,,0,0,0,,〓Zooganic командасы 3-0 есебімен жеңіске жетті.
Dialogue: 0,0:20:22.97,0:20:26.12,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:20:26.12,0:20:30.96,Default,,0,0,0,,Керемет! Соңғысы - Extreme Dash!
Dialogue: 0,0:20:30.96,0:20:39.74,Default,,0,0,0,,Аңдар патшасы гоплиттерді жарып жіберді!
Dialogue: 0,0:20:39.74,0:20:41.98,Default,,0,0,0,,〓Бұл матчта кім жеңді〓
Dialogue: 0,0:20:41.97,0:20:45.62,Default,,0,0,0,,Он мың аң патшасы басқаратын Zooganic командасы!
Dialogue: 0,0:20:45.63,0:20:51.12,Default,,0,0,0,,〓Бұл болашақты асыға күтетін жаңа команда.
Dialogue: 0,0:20:51.12,0:20:53.12,Default,,0,0,0,,Кух….
Dialogue: 0,0:20:53.12,0:20:58.63,Default,,0,0,0,,Әуесқойдан жеңілу Мұнда тағы да...
Dialogue: 0,0:20:58.62,0:21:00.81,Default,,0,0,0,,〓Кинг's Extreme Dash таңғажайып!
Dialogue: 0,0:21:00.81,0:21:03.80,Default,,0,0,0,,〓4X Lion Өте керемет! 〓Зооганикалық!
Dialogue: 0,0:21:03.79,0:21:07.29,Default,,0,0,0,,Сонымен... неге?
Dialogue: 0,0:21:07.30,0:21:10.02,Default,,0,0,0,,Неліктен Ex емес басқа біреу?
Dialogue: 0,0:21:10.02,0:21:13.67,Default,,0,0,0,,Сіз осындай күшті Extreme Dash пайдалана аласыз ба?
Dialogue: 0,0:21:13.67,0:21:19.14,Default,,0,0,0,,Иә? Бұл менің ерекше патентім емес.
Dialogue: 0,0:21:19.14,0:21:21.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:21.16,0:21:26.67,Default,,0,0,0,,Кәсіби мамандар күткендей... бұл жерде шынымен де жаман адамдар бар.
Dialogue: 0,0:21:26.67,0:21:30.71,Default,,0,0,0,,Менің келесі қарсыласым сияқты. иә?
Dialogue: 0,0:21:30.70,0:21:34.32,Default,,0,0,0,,Мейденнің хабарламасы.
Dialogue: 0,0:21:34.32,0:21:39.16,Default,,0,0,0,,Біздің қарсыласымыз зооганикалық.
Dialogue: 0,0:21:39.16,0:21:41.16,Default,,0,0,0,,Эээ!
Dialogue: 0,0:21:41.17,0:21:46.09,Default,,0,0,0,,Иә! Бұл матч! Хмм~ Яхххх~!
Dialogue: 0,0:21:46.09,0:21:49.68,Default,,0,0,0,,Егер мен осындай экстремалды сызықша алсам не болар еді?
Dialogue: 0,0:21:49.67,0:21:54.83,Default,,0,0,0,,Ах~ тез матч болғанын қалаймын!
Dialogue: 0,0:21:54.83,0:21:57.83,Default,,0,0,0,,Бұл өтірік... Бұл жынды.
Dialogue: 0,0:21:57.83,0:22:00.77,Default,,0,0,0,,Сіріңке алғыңыз келмеді ме?
Dialogue: 0,0:22:00.77,0:22:05.16,Default,,0,0,0,,Мен оны асыға күтемін, Құс.
Dialogue: 0,0:22:05.16,0:22:09.11,Default,,0,0,0,,Бұл жігіттер...
Dialogue: 0,0:22:09.11,0:22:10.62,Default,,0,0,0,,Дебюттік матчтың қарсыласы!
Dialogue: 0,0:22:31.01,0:22:33.47,On Top,,0,0,0,,Менің барудан қорықпайтынымды білесің
Dialogue: 0,0:22:33.47,0:22:35.43,On Top,,0,0,0,,Дауылға тура секіру
Dialogue: 0,0:22:35.43,0:22:39.77,On Top,,0,0,0,,Артқа отырыңыз, сапардан ләззат алыңыз (Жарайды, жарайды)
Dialogue: 0,0:22:39.77,0:22:41.48,On Top,,0,0,0,,Олардың не айтатыны маған бәрібір
Dialogue: 0,0:22:41.48,0:22:43.48,On Top,,0,0,0,,Мен мұның бәрін өзім үшін қалаймын
Dialogue: 0,0:22:43.48,0:22:44.48,On Top,,0,0,0,,Мені тоқтата алмаймын
Dialogue: 0,0:22:44.48,0:22:45.98,On Top,,0,0,0,,Мұны бәріміз білейік
Dialogue: 0,0:22:45.98,0:22:47.90,On Top,,0,0,0,,Мен оны қабылдауға дайынмын
Dialogue: 0,0:22:48.40,0:22:49.61,On Top,,0,0,0,,Біз ерекше бола аламыз
Dialogue: 0,0:22:49.61,0:22:52.28,On Top,,0,0,0,,Немесе сіз қарапайым нәрсені жақсы көресіз бе? иә?
Dialogue: 0,0:22:52.28,0:22:53.53,On Top,,0,0,0,,Бұл менің соңым болуы мүмкін
Dialogue: 0,0:22:53.53,0:22:56.08,On Top,,0,0,0,,Сондықтан Имма сені менің жауым BOOM сияқты жақындатады
Dialogue: 0,0:22:56.08,0:22:57.74,On Top,,0,0,0,,Осы әңгімені айт, иә, қалағанның бәрі
Dialogue: 0,0:22:57.74,0:22:59.91,On Top,,0,0,0,,Бірге өту
Dialogue: 0,0:22:59.91,0:23:01.21,On Top,,0,0,0,,Менің не алғанымды көрсетіңіз
Dialogue: 0,0:23:01.21,0:23:02.08,On Top,,0,0,0,,Төтенше мен
Dialogue: 0,0:23:02.08,0:23:04.71,On Top,,0,0,0,,Бұл маған ұнайтын нәрсе
Dialogue: 0,0:23:04.71,0:23:08.21,On Top,,0,0,0,,Сізбен бірге тұрыңыз, шайқасқа аттаныңыз
Dialogue: 0,0:23:08.21,0:23:12.13,On Top,,0,0,0,,Айнымас сезімдерді қорғау
Dialogue: 0,0:23:12.13,0:23:14.18,On Top,,0,0,0,,Қарамаңдар
Dialogue: 0,0:23:14.18,0:23:16.80,On Top,,0,0,0,,Келесі әлемге
Dialogue: 0,0:23:17.01,0:23:19.14,On Top,,0,0,0,,Үлкейтіңіз, үлкейтіңіз
Dialogue: 0,0:23:19.14,0:23:21.39,On Top,,0,0,0,,Масштабты үлкейту' Мен ұлғайту, масштабтау
Dialogue: 0,0:23:21.39,0:23:22.98,On Top,,0,0,0,,Мен сізді үлкейтемін
Dialogue: 0,0:23:22.98,0:23:25.19,On Top,,0,0,0,,Масштабты үлкейту' Мен ұлғайту, масштабтау
Dialogue: 0,0:23:25.19,0:23:26.73,On Top,,0,0,0,,Енді сізді үлкейтіңіз
Dialogue: 0,0:23:26.73,0:23:29.19,On Top,,0,0,0,,Масштабты үлкейту' Мен ұлғайту, масштабтау
Dialogue: 0,0:23:29.19,0:23:30.48,On Top,,0,0,0,,Мен сізді үлкейтемін
Dialogue: 0,0:23:30.48,0:23:32.53,On Top,,0,0,0,,Масштабты масштабтау Көңілді болайық
Dialogue: 0,0:23:32.53,0:23:34.45,On Top,,0,0,0,,Масштабты масштабтау Осы сәт
Dialogue: 0,0:23:34.45,0:23:37.28,On Top,,0,0,0,,Енді менің көз алдымда мен сені артта қалдыра алмаймын
Dialogue: 0,0:23:37.28,0:23:39.28,On Top,,0,0,0,,Мен мұны өз жолыммен істеп жатқанымды білесіз
Dialogue: 0,0:23:39.28,0:23:42.16,On Top,,0,0,0,,'Себебі мен масштабтаймын, масштабтаймын' Мен сізді үлкейтемін
Dialogue: 0,0:23:42.16,0:23:44.92,On Top,,0,0,0,,Енді менің көз алдымда мен сені артта қалдыра алмаймын
Dialogue: 0,0:23:44.92,0:23:47.33,On Top,,0,0,0,,Мен оны шыңға шығарамын
Dialogue: 0,0:23:47.33,0:23:50.71,On Top,,0,0,0,,'Себебі мен масштабтаймын, масштабтаймын' Мен сізді үлкейтемін
Dialogue: 0,0:23:56.22,0:23:57.43,Default,,0,0,0,,Қолымды ұсташы, өтінемін. Әрқашан істейтіндей.
Dialogue: 0,0:23:57.60,0:23:59.52,Default,,0,0,0,,Мен бүгін ессіз адамды кездестірдім.
Dialogue: 0,0:23:59.60,0:24:01.73,Default,,0,0,0,,Бұл хаха адам.
Dialogue: 0,0:24:04.15,0:24:07.52,Default,,0,0,0,,X мұнарасында ерекше адамдар бар.
Dialogue: 0,0:24:07.73,0:24:09.40,Default,,0,0,0,,X Tower күткендей
Dialogue: 0,0:24:09.78,0:24:11.82,Default,,0,0,0,,Кернеуде бірдеңе дұрыс емес.
Dialogue: 0,0:24:12.32,0:24:14.41,Default,,0,0,0,,Маиден-сан да өте кейіпкер болып табылады.
Dialogue: 0,0:24:14.61,0:24:15.32,Default,,0,0,0,,Не?
Dialogue: 0,0:24:16.41,0:24:18.12,Default,,0,0,0,,Келесі жолы Beyblade X
Dialogue: 0,0:24:18.45,0:24:19.54,Default,,0,0,0,,Арыстандар Джунгли
Dialogue: 0,0:24:20.04,0:24:22.41,Default,,0,0,0,,Кез келген жағдайда, сіз Хахадағы адамды танисыз ба?
Dialogue: 0,0:24:22.87,0:24:24.08,Default,,0,0,0,,Енді қалай ойлайсыңдар?
