Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.13,0:00:05.47,Default,,0,0,0,,<Х... Адамдарды қызықтыратын нәрсе.
Dialogue: 0,0:00:05.47,0:00:09.14,Default,,0,0,0,,Бейблейд ойын ма? Бұл спорт па?
Dialogue: 0,0:00:09.14,0:00:12.44,Default,,0,0,0,,X➡-тің ең үлкен үдеуі
Dialogue: 0,0:00:12.44,0:00:16.45,Default,,0,0,0,,Экстремалды ойын.
Dialogue: 0,0:00:16.45,0:00:19.75,Default,,0,0,0,,X сіздің қолыңызда＞
Dialogue: 0,0:00:26.79,0:00:31.46,Default,,0,0,0,,Chrom... Сіз мұны жасадыңыз.
Dialogue: 0,0:00:36.20,0:00:38.80,Default,,0,0,0,,Солға… Айналыңыз! ?
Dialogue: 0,0:00:42.10,0:00:46.48,Default,,0,0,0,,Бұл біздің шығанақ.
Dialogue: 0,0:00:46.48,0:00:54.15,Default,,0,0,0,,Маска X Енді маған керек емессің.
Dialogue: 0,0:00:58.79,0:01:01.46,Default,,0,0,0,,Себебі мен осындамын...
Dialogue: 0,0:01:01.46,0:01:05.43,Default,,0,0,0,,Мен мұны жалғыз істей алмадым.
Dialogue: 0,0:01:07.43,0:01:10.23,Default,,0,0,0,,Бірақ менде сен бар.
Dialogue: 0,0:01:12.43,0:01:15.94,Default,,0,0,0,,Бірге боламыз➡
Dialogue: 0,0:01:15.94,0:01:19.44,Default,,0,0,0,,Мен сенен асып түстім!
Dialogue: 0,0:01:19.44,0:01:24.15,Default,,0,0,0,,Маған X белгісін көрсет!
Dialogue: 0,0:01:29.48,0:01:34.12,Default,,0,0,0,,Біздің қадамдарымыз, біздің тағдырымыз➡
Dialogue: 0,0:01:34.12,0:01:38.49,Default,,0,0,0,,Маған кобальт айдаһарын көрсет!
Dialogue: 0,0:01:38.49,0:01:42.83,Default,,0,0,0,,Көре алмайтыныңды көрсетемін!
Dialogue: 0,0:01:42.83,0:01:53.84,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:01:53.84,0:01:56.85,Default,,0,0,0,,Экстремалды сызықша!
Dialogue: 0,0:02:08.52,0:02:10.53,Default,,0,0,0,,Шайқас қалай өтті?
Dialogue: 0,0:04:03.54,0:04:07.24,Default,,0,0,0,,Бір уақытта аяқталды! (қуаныш)
Dialogue: 0,0:04:09.78,0:04:11.78,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:11.78,0:04:16.79,Default,,0,0,0,,🎤 (Zero Go) О, Құдайым! Ол бұзылды!
Dialogue: 0,0:04:16.79,0:04:19.76,Default,,0,0,0,,Бетперде шешілді.
Dialogue: 0,0:04:23.13,0:04:25.79,Default,,0,0,0,,Себебі мен оны көп пайдаландым.
Dialogue: 0,0:04:25.79,0:04:28.76,Default,,0,0,0,,Cobalt Dragoon жаңа шығар...
Dialogue: 0,0:04:28.76,0:04:31.17,Default,,0,0,0,,Бұл кездейсоқ болды...
Dialogue: 0,0:04:31.17,0:04:34.20,Default,,0,0,0,,Мені кездейсоқ жұмыстан шығаруға шыдай алмаймын!
Dialogue: 0,0:04:34.20,0:04:37.11,Default,,0,0,0,,Дранбастердің реттеуі тамаша.
Dialogue: 0,0:04:37.11,0:04:40.78,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:04:40.78,0:04:42.78,Default,,0,0,0,,Бір-бірімізге дәл осылай соқтығыссақ та➡
Dialogue: 0,0:04:42.78,0:04:45.18,Default,,0,0,0,,Неліктен тек Доранбастерде жарықшақ бар? ?
Dialogue: 0,0:04:45.18,0:04:48.45,Default,,0,0,0,,Қарапайым нәрсе: қуат айырмашылығы.
Dialogue: 0,0:04:48.45,0:04:50.45,Default,,0,0,0,,Ештеңе артық, кем емес.
Dialogue: 0,0:04:50.45,0:04:54.46,Default,,0,0,0,,Маски X күшіне байланысты жоғалтты дейсіз бе? ?
Dialogue: 0,0:04:54.46,0:04:57.13,Default,,0,0,0,,Мен оны осылай түсіндіруім керек деп ойлаймын.
Dialogue: 0,0:04:57.13,0:05:00.50,Default,,0,0,0,,Extreme Line берілісін тістеу арқылы➡
Dialogue: 0,0:05:00.50,0:05:05.57,Default,,0,0,0,,Айналу күшін қозғаушы күшке түрлендіру экстремалды сызықша.
Dialogue: 0,0:05:05.57,0:05:09.47,Default,,0,0,0,,Басқаша айтқанда, шеткі сызықта өтетін шығанақ ➡ болады
Dialogue: 0,0:05:09.47,0:05:12.44,Default,,0,0,0,,Бұл жүгіруге сәйкес келеді. Бұған не болды?
Dialogue: 0,0:05:12.44,0:05:15.84,Default,,0,0,0,,Түсіндім! Бұрынғы шайқас➡
Dialogue: 0,0:05:15.84,0:05:18.45,Default,,0,0,0,,Маскаланған X-ның экстремалды сызықшасы ➡
Dialogue: 0,0:05:18.45,0:05:21.78,Default,,0,0,0,,Мен экстремалды сызықты бір рет айналып өттім.
Dialogue: 0,0:05:21.78,0:05:26.15,Default,,0,0,0,,Екінші жағынан, Ryugu Chrome-ның Extreme Dash...
Dialogue: 0,0:05:26.15,0:05:30.19,Default,,0,0,0,,Біз екінші айналымға келе жатыр едік.
Dialogue: 0,0:05:30.19,0:05:32.49,Default,,0,0,0,,Екінші тур! ?
Dialogue: 0,0:05:34.43,0:05:36.80,Default,,0,0,0,,Бұл мүмкін бе? ?
Dialogue: 0,0:05:36.80,0:05:42.10,Default,,0,0,0,,Аа, мұндай қулықты бірінші рет көріп тұрмын.
Dialogue: 0,0:05:42.10,0:05:44.44,Default,,0,0,0,,《Менің оны көруден басқа амалым жоқ.
Dialogue: 0,0:05:44.44,0:05:47.78,Default,,0,0,0,,Бұл Хром мен сол баланың оқиғасы》
Dialogue: 0,0:05:47.78,0:05:50.78,Default,,0,0,0,,Extreme Dash теориялық тұрғыдан одан жақсырақ ➡
Dialogue: 0,0:05:50.78,0:05:54.45,Default,,0,0,0,,Ату мүмкін емес. Бұл не...
Dialogue: 0,0:05:54.45,0:05:58.79,Default,,0,0,0,,Стадионды өз шегіне дейін пайдаланатын соңғы экстремалды сызықша.
Dialogue: 0,0:05:58.79,0:06:01.42,Default,,0,0,0,,Бұл Ryugu Chrome...
Dialogue: 0,0:06:01.42,0:06:04.09,Default,,0,0,0,,Бұл біздің техникамыз...
Dialogue: 0,0:06:04.09,0:06:06.80,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:06:06.80,0:06:09.46,Default,,0,0,0,,Бұл біздің...
Dialogue: 0,0:06:11.43,0:06:14.10,Default,,0,0,0,,Айдаһарлық үзіліс.
Dialogue: 0,0:06:14.10,0:06:16.77,Default,,0,0,0,,Айдаһарлық үзіліс….
Dialogue: 0,0:06:16.77,0:06:19.44,Default,,0,0,0,,Берн мырза осындай нәрсені жасай ала ма?
Dialogue: 0,0:06:19.44,0:06:22.78,Default,,0,0,0,,Теорияны түсінсең де, оған еліктей алмайсың.
Dialogue: 0,0:06:22.78,0:06:26.08,Default,,0,0,0,,Дәлдік пен түсіру қуатының бұрын-соңды болмаған деңгейлері➡
Dialogue: 0,0:06:26.08,0:06:28.45,Default,,0,0,0,,Екеуі де қажет.
Dialogue: 0,0:06:28.45,0:06:32.29,Default,,0,0,0,,Лорд Бирн бұл мүмкін емес десе, Зона.
Dialogue: 0,0:06:32.29,0:06:36.46,Default,,0,0,0,,Салқын жүзімен ғажайып кадр жасайды...
Dialogue: 0,0:06:36.46,0:06:40.46,Default,,0,0,0,,Бұл сіздің өміріңізге қымбат болса да, көп дайындықты қажет ететін шеберлік...
Dialogue: 0,0:06:40.46,0:06:42.46,Default,,0,0,0,,Бүгінгі күнге дейін➡
Dialogue: 0,0:06:42.46,0:06:46.47,Default,,0,0,0,,Оның қандай құрбандықтар жасағанын елестете де алмаймын.
Dialogue: 0,0:06:46.47,0:06:51.47,Default,,0,0,0,,Оны мұндай жағдайға не итермеледі...?
Dialogue: 0,0:06:51.47,0:06:55.74,Default,,0,0,0,,Келесі. Өзіңізді өзгертіңіз, маскалы X.
Dialogue: 0,0:06:57.78,0:07:03.42,Default,,0,0,0,,Chrome Камен Х шығанағын жоюды көздеді.
Dialogue: 0,0:07:03.42,0:07:05.79,Default,,0,0,0,,Доран Бастерді қолдануға болмайды!
Dialogue: 0,0:07:05.79,0:07:07.79,Default,,0,0,0,,Егер стратегиялар шектеулі болса➡
Dialogue: 0,0:07:07.79,0:07:11.83,Default,,0,0,0,,Ryugu Chrome-ның басымдығы бар деп айтуға болады!
Dialogue: 0,0:07:11.83,0:07:16.53,Default,,0,0,0,,Kamen X ойыншысы кәсіпқой болғаннан бергі ең үлкен дағдарыста!
Dialogue: 0,0:07:23.81,0:07:25.77,Default,,0,0,0,,《Хром: Сол күні сен кеттің...》
Dialogue: 0,0:07:29.48,0:07:33.15,Default,,0,0,0,,｟Менің атым Камен Х.
Dialogue: 0,0:07:33.15,0:07:37.72,Default,,0,0,0,,Кеттік! Бұл бірінші және соңғы Бейбатл!
Dialogue: 0,0:07:45.46,0:07:47.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:50.10,0:07:52.43,Default,,0,0,0,,Бұл менің жоғалтуым...
Dialogue: 0,0:07:52.43,0:07:55.77,Default,,0,0,0,,Бірақ мен еш өкінбеймін.
Dialogue: 0,0:07:55.77,0:08:05.78,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:08:07.78,0:08:10.12,Default,,0,0,0,,《Мен барымды бердім.
Dialogue: 0,0:08:10.12,0:08:14.79,Default,,0,0,0,,Мен өсе алдым, себебі мен Экс-мен команда құрдым.
Dialogue: 0,0:08:14.79,0:08:18.46,Default,,0,0,0,,Мен сенің жаныңда тұра алмадым, бірақ➡
Dialogue: 0,0:08:18.46,0:08:22.13,Default,,0,0,0,,Саған қарсы бар күшіммен күресе алғаныма қуаныштымын.
Dialogue: 0,0:08:22.13,0:08:24.47,Default,,0,0,0,,Бұл жолдың соңы...
Dialogue: 0,0:08:24.47,0:08:29.10,Default,,0,0,0,,Мен сенен соңғы жеңілгенім Бейблейдім болды.
Dialogue: 0,0:08:29.10,0:08:31.14,Default,,0,0,0,,Хром.
Dialogue: 0,0:08:31.14,0:08:33.71,Default,,0,0,0,,Сіз абай болғаныңыз үшін жеңілдіңіз, солай ма?
Dialogue: 0,0:08:37.45,0:08:41.12,Default,,0,0,0,,Соңғы шайқас болса да, сен тым мейірімдісің.
Dialogue: 0,0:08:41.12,0:08:43.79,Default,,0,0,0,,Ах…. Жоғарыда күресу керек болса➡
Dialogue: 0,0:08:43.79,0:08:46.12,Default,,0,0,0,,Сол кезде қолыңнан келгеннің бәрін жаса!
Dialogue: 0,0:08:46.12,0:08:48.39,Default,,0,0,0,,Жақында кездескенше.
Dialogue: 0,0:08:53.76,0:08:56.46,Default,,0,0,0,,《Мен түсінемін.
Dialogue: 0,0:08:56.46,0:09:02.87,Default,,0,0,0,,Мен сен үшін кіммін➡
Dialogue: 0,0:09:02.87,0:09:05.44,Default,,0,0,0,,Бұл туралы ма...》｠
Dialogue: 0,0:09:05.44,0:09:10.11,Default,,0,0,0,,Біз оны көрсетуіміз керек!
Dialogue: 0,0:09:10.11,0:09:12.48,Default,,0,0,0,,Сізді таң қалдырады...
Dialogue: 0,0:09:12.48,0:09:15.12,Default,,0,0,0,,Толығымен асып түсті!
Dialogue: 0,0:09:15.12,0:09:18.45,Default,,0,0,0,,Бұл жек көрушілік пе?
Dialogue: 0,0:09:18.45,0:09:21.12,Default,,0,0,0,,Бұл сезім.
Dialogue: 0,0:09:21.12,0:09:24.13,Default,,0,0,0,,Мен мұны тек құмарлық деп айта аламын...
Dialogue: 0,0:09:26.53,0:09:32.50,Default,,0,0,0,,Шығар! Барлығыңызды көрсетіңіз, барлығыңыз X!
Dialogue: 0,0:09:32.50,0:09:34.44,Default,,0,0,0,,Okay!
Dialogue: 0,0:09:34.44,0:09:36.84,Default,,0,0,0,,Доран қанжар!
Dialogue: 0,0:09:36.84,0:09:38.87,Default,,0,0,0,,Үшінші шайқас.
Dialogue: 0,0:09:38.87,0:09:41.44,Default,,0,0,0,,Кеттік! Барлығын жолға қойыңыз, X!
Dialogue: 0,0:09:41.44,0:09:43.78,Default,,0,0,0,,Біз бәрін жолға қойып жатырмыз!
Dialogue: 0,0:09:43.78,0:09:46.15,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:09:46.15,0:09:49.45,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:09:49.45,0:09:52.42,Default,,0,0,0,,Қой!
Dialogue: 0,0:09:54.42,0:09:56.86,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:09:56.86,0:10:04.77,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:10:04.77,0:10:06.77,Default,,0,0,0,,Жарайды, міне осы!
Dialogue: 0,0:10:06.77,0:10:11.14,Default,,0,0,0,,Шағын 6 жүзді қалақ соқтығыс күшін азайтады.
Dialogue: 0,0:10:11.14,0:10:13.74,Default,,0,0,0,,Бір соққымен желге ұшып кетпеу керек.
Dialogue: 0,0:10:18.81,0:10:20.78,Default,,0,0,0,,Бірақ... Ах...
Dialogue: 0,0:10:23.82,0:10:25.85,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:10:25.85,0:10:41.80,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:10:41.80,0:10:44.77,Default,,0,0,0,,Extreme Dash ∞!
Dialogue: 0,0:10:50.45,0:10:53.11,Default,,0,0,0,,Бірге көрсетейік.
Dialogue: 0,0:10:53.11,0:10:55.12,Default,,0,0,0,,Аа….
Dialogue: 0,0:10:55.12,0:10:58.12,Default,,0,0,0,,Бірге көрсетейік!
Dialogue: 0,0:10:58.12,0:11:08.76,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:11:08.76,0:11:11.17,Default,,0,0,0,,Экстремалды сызықша!
Dialogue: 0,0:11:15.17,0:11:18.81,Default,,0,0,0,,Айдаһарлық үзіліс ∞!
Dialogue: 0,0:11:18.81,0:11:49.44,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:11:49.44,0:11:53.74,Default,,0,0,0,,Бұл не...? А, бұл мүмкін емес.
Dialogue: 0,0:11:59.11,0:12:04.12,Default,,0,0,0,,🎤Соқтығыс... Х тоқтамайды!
Dialogue: 0,0:12:06.55,0:12:10.12,Default,,0,0,0,,Ахахаха Керемет тамаша Chrome!
Dialogue: 0,0:12:10.12,0:12:14.16,Default,,0,0,0,,Мен өзіммен күресіп жатқан сияқтымын!
Dialogue: 0,0:12:14.16,0:12:16.43,Default,,0,0,0,,Бұл әдейі... Иә?
Dialogue: 0,0:12:16.43,0:12:21.14,Default,,0,0,0,,Рюгу Chrome экс тактикасын әдейі ұстанады.
Dialogue: 0,0:12:21.14,0:12:23.77,Default,,0,0,0,,Дәл сол техникамен жоғары➡
Dialogue: 0,0:12:23.77,0:12:27.44,Default,,0,0,0,,Қабілеттің толық айырмашылығын көрсету...
Dialogue: 0,0:12:27.44,0:12:29.78,Default,,0,0,0,,Сал! (қуаныш)
Dialogue: 0,0:12:29.78,0:12:33.82,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:33.82,0:12:35.78,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:38.89,0:12:41.12,Default,,0,0,0,,Ах... Сенгісіз Бабо!
Dialogue: 0,0:12:41.12,0:12:44.13,Default,,0,0,0,,🎤Драндагарда да жарықшақ бар!
Dialogue: 0,0:12:46.79,0:12:49.13,Default,,0,0,0,,Ештеңе қалмады...
Dialogue: 0,0:12:49.13,0:12:51.77,Default,,0,0,0,,Бір ғана Экс қалды...
Dialogue: 0,0:12:51.77,0:12:55.47,Default,,0,0,0,,Ах... Не?
Dialogue: 0,0:12:59.11,0:13:01.71,Default,,0,0,0,,Мен жалғыз емеспін.
Dialogue: 0,0:13:03.81,0:13:07.48,Default,,0,0,0,,Біз сізден толық асып түстік.
Dialogue: 0,0:13:18.46,0:13:20.76,Default,,0,0,0,,Мен жалғыз емеспін.
Dialogue: 0,0:13:22.83,0:13:26.20,Default,,0,0,0,,Біз сізден толық асып түстік.
Dialogue: 0,0:13:31.77,0:13:33.78,Default,,0,0,0,,
Dialogue: 0,0:13:33.78,0:13:36.14,Default,,0,0,0,,Барлығыңызға сенімді болыңыз!
Dialogue: 0,0:13:36.14,0:13:39.45,Default,,0,0,0,,Жаңбыр 4X, сондықтан сіз суланбайсыз!
Dialogue: 0,0:13:39.45,0:13:45.15,Default,,0,0,0,,Sashizume Менің ойымша, бұл Chrome-ның кеудесінде.
Dialogue: 0,0:13:54.30,0:13:58.80,Default,,0,0,0,,Оны шешіңіз! Doran Sword X-пен келіңіз!
Dialogue: 0,0:13:58.80,0:14:00.80,Default,,0,0,0,,Дран қылышын сындырыңыз➡
Dialogue: 0,0:14:00.80,0:14:03.81,Default,,0,0,0,,Иллюзияңызды бұзыңыз➡
Dialogue: 0,0:14:03.81,0:14:07.11,Default,,0,0,0,,Біз сізге өзіміздің шың екенімізді көрсетеміз!
Dialogue: 0,0:14:07.11,0:14:09.11,Default,,0,0,0,,Бұл Бейблейд емес!
Dialogue: 0,0:14:09.11,0:14:13.72,Default,,0,0,0,,Бұл сенің тіршілігің мен мен үшін шайқас!
Dialogue: 0,0:14:22.46,0:14:27.80,Default,,0,0,0,,Бұл сіз бен менің соңымыз!
Dialogue: 0,0:14:27.80,0:14:30.20,Default,,0,0,0,,Маска X!
Dialogue: 0,0:14:35.77,0:14:39.14,Default,,0,0,0,,Хром.
Dialogue: 0,0:14:39.14,0:14:41.14,Default,,0,0,0,,Бұл Бейблейд.
Dialogue: 0,0:14:41.14,0:14:44.78,Default,,0,0,0,,Біздің ойнайтынымыз Бейблейд.
Dialogue: 0,0:14:44.78,0:14:49.12,Default,,0,0,0,,Рахмет. Мен қазір➡
Dialogue: 0,0:14:49.12,0:14:52.79,Default,,0,0,0,,Бұл өте қызық!
Dialogue: 0,0:14:52.79,0:14:54.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:54.79,0:14:59.16,Default,,0,0,0,,Мен әрқашан осындай шайқас болғым келді!
Dialogue: 0,0:14:59.16,0:15:03.46,Default,,0,0,0,,Ең жақсы жерде, ең жақсы адаммен...
Dialogue: 0,0:15:03.46,0:15:07.44,Default,,0,0,0,,Мен өмірдегі ең жақсы адаммын...
Dialogue: 0,0:15:07.44,0:15:13.11,Default,,0,0,0,,Мен және Хром арасындағы шайқас осылай болуы керек!
Dialogue: 0,0:15:13.11,0:15:15.11,Default,,0,0,0,,Кәне, Chrome, жасайық!
Dialogue: 0,0:15:15.11,0:15:18.78,Default,,0,0,0,,Мен енді мұндай шайқасқа шыға алмаймын!
Dialogue: 0,0:15:18.78,0:15:21.78,Default,,0,0,0,,Мен енді шыдай алмаймын!
Dialogue: 0,0:15:21.78,0:15:26.19,Default,,0,0,0,,Оны бірге кесіп өтейік. Бұл дұрыс, дұрыс.
Dialogue: 0,0:15:26.19,0:15:31.23,Default,,0,0,0,,Біз асып кетуіміз керек адам - бұл адам...
Dialogue: 0,0:15:31.23,0:15:34.46,Default,,0,0,0,,Бұл соңы.
Dialogue: 0,0:15:34.46,0:15:38.13,Default,,0,0,0,,Үш. Екі.
Dialogue: 0,0:15:38.13,0:15:42.44,Default,,0,0,0,,Ал, көзіңді жыпылықтасаң, сағынып қаласың!
Dialogue: 0,0:15:47.14,0:15:51.71,Default,,0,0,0,,Мен саған сен көрмеген нәрсені көрсетемін.
Dialogue: 0,0:16:06.13,0:16:08.73,Default,,0,0,0,,Қой!
Dialogue: 0,0:16:11.13,0:16:13.10,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:16:16.14,0:16:31.12,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:16:31.12,0:16:33.79,Default,,0,0,0,,Осы жерден.
Dialogue: 0,0:16:33.79,0:16:38.13,Default,,0,0,0,,Ол... ол....
Dialogue: 0,0:16:38.13,0:16:40.46,Default,,0,0,0,,Бала...
Dialogue: 0,0:16:40.46,0:16:42.80,Default,,0,0,0,,Мистер Экс...
Dialogue: 0,0:16:42.80,0:16:45.47,Default,,0,0,0,,Маған көрінбейтін нәрсені көрсет!
Dialogue: 0,0:16:45.47,0:16:48.14,Default,,0,0,0,,X!
Dialogue: 0,0:16:48.14,0:17:07.46,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:17:07.46,0:17:09.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:09.46,0:17:31.15,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:17:31.15,0:17:34.12,Default,,0,0,0,,Бұл біздің...
Dialogue: 0,0:17:34.12,0:17:39.12,Default,,0,0,0,,Жоқ! Мен және Chrome Бейблейді!
Dialogue: 0,0:17:41.46,0:17:43.42,Default,,0,0,0,,Экстремалды сызықша!
Dialogue: 0,0:17:45.46,0:17:48.46,Default,,0,0,0,,Айдаһарлық үзіліс X!
Dialogue: 0,0:17:48.46,0:18:22.46,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:18:38.78,0:18:41.82,Default,,0,0,0,,Доран семсері өте жақсы аяқталды!
Dialogue: 0,0:18:41.82,0:18:45.45,Default,,0,0,0,,Камен Х 4 ұпайды бірінші болып жеңіп алды!
Dialogue: 0,0:18:45.45,0:18:48.12,Default,,0,0,0,,Ия...
Dialogue: 0,0:18:48.12,0:18:52.13,Default,,0,0,0,,🎤Ерекше мәре!
Dialogue: 0,0:18:52.13,0:19:05.74,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:07.81,0:19:10.14,Default,,0,0,0,,Ақымақ….
Dialogue: 0,0:19:10.14,0:19:15.82,Default,,0,0,0,,Неліктен сіз Extreme Dash пайдаланасыз?
Dialogue: 0,0:19:15.82,0:19:20.19,Default,,0,0,0,,Айдаһарлық үзіліс Бұл таңғажайып қадам.
Dialogue: 0,0:19:20.19,0:19:22.49,Default,,0,0,0,,Сонымен➡
Dialogue: 0,0:19:22.49,0:19:27.13,Default,,0,0,0,,Мен Хромды жеңудің жалғыз жолы - дәл осындай әдісті қолдану деп ойладым.
Dialogue: 0,0:19:27.13,0:19:31.13,Default,,0,0,0,,Сіз жаңа ғана бастан өткерген Айдаһарлық үзіліс➡
Dialogue: 0,0:19:31.13,0:19:33.80,Default,,0,0,0,,Сіз оны қайта шығарылды деп айттыңыз ба?
Dialogue: 0,0:19:33.80,0:19:37.17,Default,,0,0,0,,Жоқ, бұл көшірме емес.
Dialogue: 0,0:19:37.17,0:19:39.81,Default,,0,0,0,,Менен әлдеқайда көп...
Dialogue: 0,0:19:39.81,0:19:43.21,Default,,0,0,0,,Мен оны жаңа ғана көрдім.
Dialogue: 0,0:19:46.51,0:19:51.49,Default,,0,0,0,,Бейблейд ойнау үшін туғандай көрінетін адам...
Dialogue: 0,0:19:53.92,0:19:55.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:58.79,0:20:04.50,Default,,0,0,0,,Бұл қызық болды!
Dialogue: 0,0:20:04.50,0:20:06.87,Default,,0,0,0,,Мен де сондай таңғажайып экстремалды сызықша жасадым ➡
Dialogue: 0,0:20:06.87,0:20:09.14,Default,,0,0,0,,Мен мұны істей аламын деп ешқашан ойламадым!
Dialogue: 0,0:20:09.14,0:20:11.81,Default,,0,0,0,,Хромға рахмет!
Dialogue: 0,0:20:11.81,0:20:16.21,Default,,0,0,0,,Сондықтан біз Chrom-пен ең жақсы шайқас өткіздік!
Dialogue: 0,0:20:16.21,0:20:18.48,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:20:24.42,0:20:28.49,Default,,0,0,0,,｟Менімен көбірек ойнайық! ｠
Dialogue: 0,0:20:28.49,0:20:30.89,Default,,0,0,0,,《Хром: Мен сені кездестірген күннен бері➡
Dialogue: 0,0:20:30.89,0:20:33.83,Default,,0,0,0,,Мен сенен жеңіліп қалмайын деп қатты қиналдым.
Dialogue: 0,0:20:33.83,0:20:37.16,Default,,0,0,0,,Бірақ жоқ.
Dialogue: 0,0:20:37.16,0:20:41.24,Default,,0,0,0,,Иә, шын мәнінде...
Dialogue: 0,0:20:41.24,0:20:46.81,Default,,0,0,0,,Мен әрқашан сізге қажет болғым келді.
Dialogue: 0,0:20:46.81,0:20:51.48,Default,,0,0,0,,Содан бері өзгерген жоқ...
Dialogue: 0,0:20:51.48,0:20:55.82,Default,,0,0,0,,Сол күлкі мен сол жүрек...
Dialogue: 0,0:20:55.82,0:20:58.82,Default,,0,0,0,,Айырмашылығы...》
Dialogue: 0,0:21:02.22,0:21:06.19,Default,,0,0,0,,《Хром: сенің қасыңда тұрған мен емес》
Dialogue: 0,0:21:08.13,0:21:11.43,Default,,0,0,0,,Мысалы…. Иә? Не?
Dialogue: 0,0:21:13.50,0:21:17.14,Default,,0,0,0,,Мен сені әрқашанда сақтаймын...
Dialogue: 0,0:21:17.14,0:21:45.47,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:21:45.47,0:21:48.47,Default,,0,0,0,,Хром жоғалды...
Dialogue: 0,0:21:51.14,0:21:54.14,Default,,0,0,0,,Пендрагон ұтыла алмайды.
Dialogue: 0,0:21:54.14,0:21:56.71,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:22:00.48,0:22:04.45,Default,,0,0,0,,Рюгу Chrome жібергендіктен үзілді➡
Dialogue: 0,0:22:04.45,0:22:07.45,Default,,0,0,0,,Енді дайындық жұмыстары аяқталды➡
Dialogue: 0,0:22:07.45,0:22:11.13,Default,,0,0,0,,Саммит шайқасы қайта жалғасады!
Dialogue: 0,0:22:11.13,0:22:16.53,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:22:16.53,0:22:21.14,Default,,0,0,0,,Осы уақытқа дейінгі шайқастар Персонаның 1 жеңісі және Пендрагонның 1 жеңісі болды!
Dialogue: 0,0:22:21.14,0:22:23.14,Default,,0,0,0,,Шыңдағы шайқаста не болады?➡
Dialogue: 0,0:22:23.14,0:22:28.44,Default,,0,0,0,,Құс Казами мен Камен З арасындағы шайқасқа сеніп тапсырылды!
Dialogue: 0,0:22:28.44,0:22:33.45,Default,,0,0,0,,🎤Бүкіл әлем, ең жақсы шайқасты күтіңіздер!
Dialogue: 0,0:22:34.95,0:22:40.95,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory