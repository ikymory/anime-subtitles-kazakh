Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.20,0:00:02.12,Default,,0,0,0,,X…
Dialogue: 0,0:00:02.92,0:00:04.92,Default,,0,0,0,,Адамдарды қызықтыратын нәрсе.
Dialogue: 0,0:00:05.69,0:00:09.01,Default,,0,0,0,,Бейблейд ойын ма? Бұл спорт па?
Dialogue: 0,0:00:10.37,0:00:12.45,Default,,0,0,0,,Ең жоғары үдетілген X
Dialogue: 0,0:00:12.65,0:00:15.61,Default,,0,0,0,,Экстремалды ойын.
Dialogue: 0,0:00:16.98,0:00:19.50,Default,,0,0,0,,X сіздің қолыңызда
Dialogue: 0,0:00:21.60,0:00:23.62,Default,,0,0,0,,〓(Zero Go) Керемет!
Dialogue: 0,0:00:23.62,0:00:28.93,Default,,0,0,0,,〓Yggdrasil командасы абсолютті көшбасшы Immortal Burn кезінде тамаша жеңіске жетті.
Dialogue: 0,0:00:28.93,0:00:32.13,Default,,0,0,0,,〓Жақсы ілгерілеу қаншалықты жалғасады?
Dialogue: 0,0:00:34.92,0:00:37.77,Default,,0,0,0,,Мистер Бирн.
Dialogue: 0,0:00:37.77,0:00:40.97,Default,,0,0,0,,Кешіріңіз, мен сізге көмектесе алмадым.
Dialogue: 0,0:00:41.64,0:00:44.84,Default,,0,0,0,,Мен өз командама кедергімін.
Dialogue: 0,0:00:44.94,0:00:51.44,Default,,0,0,0,,Топтың кетуіне рұқсат етіңіз.
Dialogue: 0,0:00:53.08,0:00:55.12,Default,,0,0,0,,Сіз...
Dialogue: 0,0:00:55.12,0:00:57.61,Default,,0,0,0,,Мен Бейді жақсы көремін.
Dialogue: 0,0:00:57.61,0:01:03.90,Default,,0,0,0,,Дегенмен, Йггдрасил есімін алып жүру үшін...
Dialogue: 0,0:01:03.90,0:01:06.58,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:01:06.58,0:01:10.42,Default,,0,0,0,,Мен сіздердің ойларыңызды түсіндім.
Dialogue: 0,0:01:10.42,0:01:15.26,Default,,0,0,0,,Енді өзіңізді ренжітудің қажеті жоқ.
Dialogue: 0,0:01:15.26,0:01:18.26,Default,,0,0,0,,Сіз Бейді жақсы көресіз.
Dialogue: 0,0:01:18.26,0:01:20.93,Default,,0,0,0,,Сонда біз жолдас боламыз.
Dialogue: 0,0:01:20.93,0:01:23.43,Default,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,0:01:23.43,0:01:26.58,Default,,0,0,0,,Бірақ ойларды қабылдайық.
Dialogue: 0,0:01:26.58,0:01:31.74,Default,,0,0,0,,Мистер Бирн. Мен командадан кетсем де, сен мен үшінсің
Dialogue: 0,0:01:31.74,0:01:35.73,Default,,0,0,0,,Жоқ Ол Бей үшін керек адам.
Dialogue: 0,0:01:35.73,0:01:40.11,Default,,0,0,0,,Сен маған күшіңді бере бересің бе?
Dialogue: 0,0:01:40.11,0:01:42.22,Default,,0,0,0,,Мистер Бирн.
Dialogue: 0,0:01:42.22,0:01:44.89,Default,,0,0,0,,А... иә!
Dialogue: 0,0:01:44.89,0:01:49.39,Default,,0,0,0,,《Мистер Өлмейтін күйік.
Dialogue: 0,0:01:49.39,0:01:55.56,Default,,0,0,0,,Әлемдегі жетекші фармацевтикалық компаниялардың бірі Yggdrasil Pharmaceuticals компаниясының мұрагері.
Dialogue: 0,0:01:55.56,0:01:58.05,Default,,0,0,0,,Талант күш-жігері〓
Dialogue: 0,0:01:58.05,0:02:00.95,Default,,0,0,0,,Және бұл инклюзивтілік.
Dialogue: 0,0:02:00.95,0:02:05.24,Default,,0,0,0,,Бұл адам - әлемдегі ең жақсы қуық》
Dialogue: 0,0:02:05.24,0:02:08.06,Default,,0,0,0,,Үйге қайтайық.
Dialogue: 0,0:02:08.06,0:02:10.23,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:10.23,0:02:13.65,Default,,0,0,0,,Дворян міндеттемесі.
Dialogue: 0,0:02:14.34,0:02:18.80,Default,,0,0,0,,Біз Бейблейдті биік белестерге жетелеуге міндеттіміз.
Dialogue: 0,0:02:21.76,0:02:23.98,On Top,,0,0,0,,Бір уақытта бір қадам
Dialogue: 0,0:02:23.98,0:02:26.92,On Top,,0,0,0,,Қанша уақыт қажет болса да
Dialogue: 0,0:02:30.65,0:02:32.61,On Top,,0,0,0,,Мен көтерілуді жасаймын
Dialogue: 0,0:02:32.61,0:02:35.16,On Top,,0,0,0,,Мен жіберген қателіктерден сабақ ал
Dialogue: 0,0:02:39.24,0:02:45.16,On Top,,0,0,0,,Жүрегіңізді ашыңыз және жаңа әлем ашыңыз
Dialogue: 0,0:02:48.04,0:02:54.38,On Top,,0,0,0,,Мен сені сонда апарамын, енді тұйық жол жоқ
Dialogue: 0,0:02:56.52,0:02:59.34,On Top,,0,0,0,,Мен осылай айтамын. Мен ештеңе істей алмаймын.
Dialogue: 0,0:02:59.34,0:03:05.18,On Top,,0,0,0,,Жауап жоқ заманда не ойлайсың?
Dialogue: 0,0:03:05.43,0:03:07.60,On Top,,0,0,0,,Таяқтар мен тастар ешқашан болмайды
Dialogue: 0,0:03:07.60,0:03:09.56,On Top,,0,0,0,,Мына сүйектерді сындыр
Dialogue: 0,0:03:09.56,0:03:11.68,On Top,,0,0,0,,Бір уақытта бір қадам
Dialogue: 0,0:03:11.68,0:03:14.54,On Top,,0,0,0,,Қанша уақыт қажет болса да
Dialogue: 0,0:03:18.07,0:03:20.32,On Top,,0,0,0,,Мен көтерілуді жасаймын
Dialogue: 0,0:03:20.32,0:03:23.05,On Top,,0,0,0,,Мен жіберген қателіктерден сабақ ал
Dialogue: 0,0:03:25.82,0:03:30.30,On Top,,0,0,0,,Ал мен оны саған дәлелдеймін, сен оны дәлелде
Dialogue: 0,0:03:31.04,0:03:34.75,On Top,,0,0,0,,Оны сізге дәлелдеңіз, күмәнсіз дәлелдеңіз
Dialogue: 0,0:03:34.75,0:03:37.21,On Top,,0,0,0,,Маған бір мүмкіндікті бір мүмкіндік беріңіз
Dialogue: 0,0:03:37.21,0:03:40.33,On Top,,0,0,0,,Сондықтан мен сізге дәлелдей аламын
Dialogue: 0,0:03:42.59,0:03:45.60,On Top,,0,0,0,,Сондықтан мен сізге дәлелдей аламын
Dialogue: 0,0:03:53.10,0:03:54.23,Default,,0,0,0,,Соңғы шайқас
Dialogue: 0,0:03:58.52,0:04:02.07,Default,,0,0,0,,«Хмф, хун, иә», көңіл-күйіңіз жақсы.
Dialogue: 0,0:04:02.07,0:04:05.67,Default,,0,0,0,,Әрине, сіз екінші қабатқа көтеріле аласыз, солай ма?
Dialogue: 0,0:04:05.67,0:04:08.68,Default,,0,0,0,,Осыншама тез көтерілгеніме сене алар емеспін!
Dialogue: 0,0:04:08.68,0:04:13.50,Default,,0,0,0,,Ха... Біз жоғарғы жақтағы 100-ші қабатқа ұмтыламыз, солай ма?
Dialogue: 0,0:04:13.50,0:04:17.20,Default,,0,0,0,,Жарайды. Мені бақытты ететін нәрсе мені бақытты етеді.
Dialogue: 0,0:04:17.20,0:04:22.57,Default,,0,0,0,,Алдағы жалғыз шайқас фестиваліне қатты қуану дұрыс па?
Dialogue: 0,0:04:22.57,0:04:26.49,Default,,0,0,0,,〓Ол екінші қабатта.
Dialogue: 0,0:04:26.49,0:04:28.51,Default,,0,0,0,,Бірыңғай шайқас фестивалі дегеніміз не?
Dialogue: 0,0:04:28.51,0:04:32.00,Default,,0,0,0,,Бұл ресми матч емес, бұл көрмелік матч, солай ма?
Dialogue: 0,0:04:32.00,0:04:41.01,Default,,0,0,0,,Мен...
Dialogue: 0,0:04:41.01,0:04:45.16,Default,,0,0,0,,Хмм, бәрі де мотивацияланған сияқты.
Dialogue: 0,0:04:45.16,0:04:47.33,Default,,0,0,0,,Бұл көрме болса да〓
Dialogue: 0,0:04:47.33,0:04:50.84,Default,,0,0,0,,Бұл адамдар неге сонша ашулы ...
Dialogue: 0,0:04:50.83,0:04:55.24,Default,,0,0,0,,Бұл сіздің мінезіңіз бен күшіңізді көрсететін оқиға.
Dialogue: 0,0:04:55.24,0:04:58.49,Default,,0,0,0,,Негізінен күшті командалардың барлауын қалайтын қылшықтар〓
Dialogue: 0,0:04:58.49,0:05:01.83,Default,,0,0,0,,Мен қатысамын. Солай ма?
Dialogue: 0,0:05:01.83,0:05:04.88,Default,,0,0,0,,Дұрыс! Уау, Ичиго-чан!
Dialogue: 0,0:05:04.88,0:05:08.65,Default,,0,0,0,,Иә! Ичиго - бұл AI тұмары.
Dialogue: 0,0:05:08.65,0:05:13.02,Default,,0,0,0,,Командалық шеңберден секіріп, жеке матчтарда өз күштеріңізді айтыңыз.
Dialogue: 0,0:05:13.02,0:05:16.16,Default,,0,0,0,,Бұл жалғыз шайқас фестивалінің мәні осы!
Dialogue: 0,0:05:16.16,0:05:18.50,Default,,0,0,0,,болса да, мен мұны істеймін.
Dialogue: 0,0:05:18.50,0:05:21.67,Default,,0,0,0,,Мен жаңа ғана екінші қабатқа көтерілдім, бірақ маған әлі сәйкес келген жоқ〓
Dialogue: 0,0:05:21.67,0:05:23.65,Default,,0,0,0,,Мен қатысқаныма сене алар емеспін.
Dialogue: 0,0:05:23.65,0:05:26.65,Default,,0,0,0,,Әй... Мен жай ғана жаттығатынмын.
Dialogue: 0,0:05:26.65,0:05:30.34,Default,,0,0,0,,Көрдім, көремін, ресми матчқа дейін бос уақытым бар〓
Dialogue: 0,0:05:30.34,0:05:34.49,Default,,0,0,0,,Мен екінші қабаттағы профессионалдардың жүздерін олар жаттығу жасап жатқанда көруге келдім.
Dialogue: 0,0:05:34.49,0:05:37.86,Default,,0,0,0,,Міне, мұндай үлкен мәміле жасайтын ешкім жоқ сияқты.
Бұл
Dialogue: 0,0:05:37.86,0:05:40.38,Default,,0,0,0,,ма?
Dialogue: 0,0:05:40.38,0:05:43.17,Default,,0,0,0,,Жоқ... жоқ, олай айтпа...
Dialogue: 0,0:05:43.17,0:05:45.17,Default,,0,0,0,,Ой, уақыт таяп қалды.
Dialogue: 0,0:05:45.17,0:05:54.60,Default,,0,0,0,,Енді, бәріңіз, ұрыс алаңына көшіңіздер.
Dialogue: 0,0:05:54.60,0:05:56.50,Default,,0,0,0,,Мен оны асыға күтемін, Құс.
Dialogue: 0,0:05:56.50,0:06:00.47,Default,,0,0,0,,Эй, мен енді бас тартамын... Бұлай істеуге мүмкіндік жоқ.
Dialogue: 0,0:06:00.47,0:06:02.49,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:06:02.49,0:06:04.93,Default,,0,0,0,,Екеуіңе сәттілік.
Dialogue: 0,0:06:04.93,0:06:07.18,Default,,0,0,0,,Екі адам? Мульти ше?
Dialogue: 0,0:06:07.18,0:06:09.16,Default,,0,0,0,,Мен фотографпын.
Dialogue: 0,0:06:09.16,0:06:12.67,Default,,0,0,0,,Мен бүгінгі шайқас үшін PV жасауды ойладым.
Dialogue: 0,0:06:12.67,0:06:15.84,Default,,0,0,0,,Жақсы материал Мен оны асыға күтемін.
Dialogue: 0,0:06:15.84,0:06:19.32,Default,,0,0,0,,〓Whatsapp Барлығына!
Dialogue: 0,0:06:19.32,0:06:23.08,Default,,0,0,0,,Бірыңғай шайқас фестиваліне қош келдіңіз!
Dialogue: 0,0:06:23.08,0:06:25.16,Default,,0,0,0,,〓Ресми матчтарда көрінбейді〓
Dialogue: 0,0:06:25.16,0:06:29.17,Default,,0,0,0,,Керемет синглы матчтарынан рахат алыңыз.
Dialogue: 0,0:06:29.17,0:06:32.17,Default,,0,0,0,,〓Олай болса, бірінші ойын.
Dialogue: 0,0:06:32.17,0:06:36.49,Default,,0,0,0,,〓Казами Құсы Камен Хке қарсы.
Dialogue: 0,0:06:36.49,0:06:40.18,Default,,0,0,0,,〓Бұл команда тұлғаларының арасындағы кездесу!
Dialogue: 0,0:06:40.18,0:06:46.55,Default,,0,0,0,,Құс Көңілді болайық! Мен бара аламын ба?
Dialogue: 0,0:06:46.55,0:06:49.10,Default,,0,0,0,,Жарайсыңдар! Ах!
Dialogue: 0,0:06:49.10,0:06:51.84,Default,,0,0,0,,〓Дран қанжар мәреде.
Dialogue: 0,0:06:51.84,0:06:54.17,Default,,0,0,0,,〓Баска киген Х-ның жеңісі.
Dialogue: 0,0:06:54.17,0:06:57.83,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:57.83,0:07:01.02,Default,,0,0,0,,Барлық қалған матчтарды ұтыңыз!
Dialogue: 0,0:07:01.01,0:07:07.00,Default,,0,0,0,,〓Бұл шешілді! Карло Маруко басымдықпен жеңіске жетті!
Dialogue: 0,0:07:07.00,0:07:09.17,Default,,0,0,0,,〓Тағы да екінші өлтіру!
Dialogue: 0,0:07:09.17,0:07:18.16,Default,,0,0,0,,〓Жеңіс серияңызды қаншалықты ұзартқыңыз келеді? Бетперде киген ойыншы X! ?
Dialogue: 0,0:07:18.17,0:07:20.85,Default,,0,0,0,,〓Айналдыру. Қарғыс атқыр...
Dialogue: 0,0:07:20.85,0:07:22.84,Default,,0,0,0,,〓Аяқтау. Жоқ!
Dialogue: 0,0:07:22.84,0:07:25.84,Default,,0,0,0,,〓Жарық аяқтау. Ах! ?
Dialogue: 0,0:07:25.84,0:07:30.81,Default,,0,0,0,,Аа...
Dialogue: 0,0:07:30.81,0:07:34.35,Default,,0,0,0,,Сіз мүлде жеңе алмайсыз.
Dialogue: 0,0:07:34.35,0:07:37.00,Default,,0,0,0,,Келесі шайқас...
Dialogue: 0,0:07:37.00,0:07:41.51,Default,,0,0,0,,Құс Казами Карло Марукоға қарсы!
Dialogue: 0,0:07:41.51,0:07:48.83,Default,,0,0,0,,Жарайды, келесі жолы!
Dialogue: 0,0:07:48.83,0:07:50.83,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:50.83,0:07:55.84,Default,,0,0,0,,Сәлем, Үлкен ауыз аңыз Казами құсы.
Dialogue: 0,0:07:55.84,0:07:59.32,Default,,0,0,0,,Жоқ! Менің айтқаным бұл емес.
Dialogue: 0,0:07:59.32,0:08:01.64,Default,,0,0,0,,Мен түсіндім. Мен түссіндім.
Dialogue: 0,0:08:01.64,0:08:05.66,Default,,0,0,0,,Ичиго-чанның ад-либі, солай ма? иә?
Dialogue: 0,0:08:05.66,0:08:10.33,Default,,0,0,0,,Сооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооо.
Dialogue: 0,0:08:10.33,0:08:13.67,Default,,0,0,0,,Келесі жолы абай бол, балам.
Dialogue: 0,0:08:13.67,0:08:16.01,Default,,0,0,0,,А, иә.
Dialogue: 0,0:08:16.01,0:08:18.68,Default,,0,0,0,,《Ол жақсы адам сияқты ма? 》
Dialogue: 0,0:08:18.68,0:08:22.15,Default,,0,0,0,,Олай болса, жасайық!
Dialogue: 0,0:08:22.15,0:08:26.03,Default,,0,0,0,,Ах~ Hawk-ты ұр!
Dialogue: 0,0:08:26.03,0:08:28.17,Default,,0,0,0,,О, сен білесің бе?
Dialogue: 0,0:08:28.17,0:08:30.84,Default,,0,0,0,,Сол шығанақты мен де пайдаландым.
Dialogue: 0,0:08:30.84,0:08:35.19,Default,,0,0,0,,Егер солай болса, онда сіз бұл жігітті жақсы білуіңіз керек.
Dialogue: 0,0:08:35.19,0:08:40.51,Default,,0,0,0,,Бала, сенен бір өтінішім бар.
Dialogue: 0,0:08:40.51,0:08:43.67,Default,,0,0,0,,Келіңіз және байыпты жеңіңіз.
Dialogue: 0,0:08:43.67,0:08:45.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:45.82,0:08:48.47,Default,,0,0,0,,Әрине!
Dialogue: 0,0:08:48.47,0:08:51.82,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:08:51.83,0:08:55.68,Default,,0,0,0,,〓Бір шайқас фестивалі ойыны 15.
Dialogue: 0,0:08:55.68,0:08:58.85,Default,,0,0,0,,〓Казами Құсы Карло Марукоға қарсы.
Dialogue: 0,0:08:58.85,0:09:01.00,Default,,0,0,0,,〓Дайын жиынтық!
Dialogue: 0,0:09:01.00,0:09:04.51,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:09:04.50,0:09:13.83,Default,,0,0,0,,Қой!
Dialogue: 0,0:09:13.83,0:09:17.83,Default,,0,0,0,,〓Бірінші шабуылды тозақ тізбегі қабылдамады.
Dialogue: 0,0:09:17.83,0:09:23.84,Default,,0,0,0,,〓Түртіп алудың күші осындай!
Dialogue: 0,0:09:23.84,0:09:26.99,Default,,0,0,0,,〓Тоқтамаңыз! Қарғыс атсын!
Dialogue: 0,0:09:26.99,0:09:30.00,Default,,0,0,0,,〓Хоктың үздіксіз үздіксіз шабуылдарына соққы беріңіз!
Dialogue: 0,0:09:30.00,0:09:34.52,Default,,0,0,0,,《Strike Hawk өте күшті болды! 》
Dialogue: 0,0:09:34.52,0:09:43.04,Default,,0,0,0,,Менің ойымша, сіз осыншама күшті шығара алмас едіңіз.
Dialogue: 0,0:09:43.04,0:09:50.48,Default,,0,0,0,,Әлі жоқ! ау.
Dialogue: 0,0:09:50.48,0:09:53.84,Default,,0,0,0,,Жүр!
Dialogue: 0,0:09:53.84,0:09:55.86,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:09:55.86,0:10:00.49,Default,,0,0,0,,Өз кезегінде. иә?
Dialogue: 0,0:10:00.49,0:10:11.15,Default,,0,0,0,,Strike Hawk!
Dialogue: 0,0:10:11.15,0:10:13.16,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:10:13.16,0:10:15.83,Default,,0,0,0,,Сұңқырдың сүңгуі!
Dialogue: 0,0:10:15.83,0:10:22.82,Default,,0,0,0,,Шыда!
Dialogue: 0,0:10:22.82,0:10:24.87,Default,,0,0,0,,Шыдадым.
Dialogue: 0,0:10:24.87,0:10:34.93,Default,,0,0,0,,Жоқ Сұңқарлар олжасын қашып жібермейді.
Dialogue: 0,0:10:34.93,0:10:45.84,Default,,0,0,0,,〓Strike Hawk Over Finish.
Dialogue: 0,0:10:45.84,0:10:48.83,Default,,0,0,0,,Толық жеңіліс?
Dialogue: 0,0:10:48.83,0:10:51.49,Default,,0,0,0,,БУМ‼ (Кацуми) Көрдің бе!?
Dialogue: 0,0:10:51.49,0:10:55.01,Default,,0,0,0,,Ах, Маруко...сан.
Dialogue: 0,0:10:55.02,0:11:00.17,Default,,0,0,0,,Карло жақсы.
Dialogue: 0,0:11:00.17,0:11:11.15,Default,,0,0,0,,Өзіңе ұнайтын нәрсені таңда, балам.
Dialogue: 0,0:11:11.15,0:11:14.52,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:11:14.52,0:11:17.17,Default,,0,0,0,,Жоқ, бұл керемет, сен.
Dialogue: 0,0:11:17.17,0:11:19.99,Default,,0,0,0,,Өлетін жаман уақыт.
Dialogue: 0,0:11:19.99,0:11:25.16,Default,,0,0,0,,Ха! ? Ол мені мақтап жатқанын айтты.
Dialogue: 0,0:11:25.16,0:11:29.15,Default,,0,0,0,,Дәл қазір шайқастың соңына дейін берілмеді, солай ма?
Dialogue: 0,0:11:29.15,0:11:33.50,Default,,0,0,0,,Негізі, ол маған бір оқ берді.
Dialogue: 0,0:11:33.50,0:11:36.01,Default,,0,0,0,,Жақсы жүрек.
Dialogue: 0,0:11:36.01,0:11:39.14,Default,,0,0,0,,Осылай жасай бер.
Dialogue: 0,0:11:39.14,0:11:43.66,Default,,0,0,0,,Иә. иә? ше?
Dialogue: 0,0:11:43.66,0:11:47.53,Default,,0,0,0,,Ах... у... Хаха~.
Dialogue: 0,0:11:47.53,0:11:51.59,Default,,0,0,0,,Мынау аңқау жігіт қайда?
Dialogue: 0,0:11:51.59,0:11:54.49,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:11:54.49,0:11:57.84,Default,,0,0,0,,Ешқандай себеп жоқ.
Dialogue: 0,0:11:57.84,0:12:01.15,Default,,0,0,0,,Мен соңғы рет жақсы көрінгім келді.
Dialogue: 0,0:12:01.15,0:12:05.82,Default,,0,0,0,,Соңы немен аяқталады?
Dialogue: 0,0:12:05.82,0:12:08.01,Default,,0,0,0,,Мен зейнеткерлікке шығамын.
Dialogue: 0,0:12:08.00,0:12:08.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:14.31,0:12:18.13,Default,,0,0,0,,Зейнеткерлікке шығу? неге! ? Сен сондай күштісің! ?
Dialogue: 0,0:12:18.13,0:12:20.13,Default,,0,0,0,,Бұл күшті емес.
Dialogue: 0,0:12:20.13,0:12:25.12,Default,,0,0,0,,Бұл да әлсіз емес.
Dialogue: 0,0:12:25.12,0:12:31.96,Default,,0,0,0,,Қарт солдаттың мақтанышына құлақ түресің бе? иә.
Dialogue: 0,0:12:31.96,0:12:36.33,Default,,0,0,0,,Менің командам жақсы өнер көрсетті.
Dialogue: 0,0:12:36.33,0:12:40.63,Default,,0,0,0,,Жарайды, жақсы жер болса да, 30-қабатта ғана.
Dialogue: 0,0:12:40.63,0:12:43.95,Default,,0,0,0,,30-қабат? Осы уақытқа дейін!
Dialogue: 0,0:12:43.95,0:12:46.64,Default,,0,0,0,,Уа, бұл жақсы жауап.
Dialogue: 0,0:12:46.64,0:12:49.03,Default,,0,0,0,,Ал, отырыңыз.
Dialogue: 0,0:12:49.03,0:12:53.63,Default,,0,0,0,,Бірақ мен құбыжық тәрізді адамдарды кездестірдім.
Dialogue: 0,0:12:53.63,0:12:57.45,Default,,0,0,0,,Мен қатты жеңілдім. Карло мырза?
Dialogue: 0,0:12:57.45,0:13:01.97,Default,,0,0,0,,Аа, менің Blader статусым басқа.
Dialogue: 0,0:13:01.97,0:13:07.38,Default,,0,0,0,,Осыдан кейін мен мүлде жеңе алмадым.
Dialogue: 0,0:13:07.38,0:13:09.78,Default,,0,0,0,,Сіз мұны білмей тұрып, сіз төмендетесіз.
Dialogue: 0,0:13:09.78,0:13:13.15,Default,,0,0,0,,Топ белсенді емес.
Dialogue: 0,0:13:13.15,0:13:18.81,Default,,0,0,0,,Демеушімен келісім-шарт аяқталуға жақын.
Dialogue: 0,0:13:18.81,0:13:21.49,Default,,0,0,0,,Сонымен, зейнетке шығыңыз...
Dialogue: 0,0:13:21.49,0:13:24.83,Default,,0,0,0,,Бұл жалғыз себеп емес.
Dialogue: 0,0:13:24.83,0:13:28.65,Default,,0,0,0,,Мен оны жеңілген кезде түсіндім.
Dialogue: 0,0:13:28.65,0:13:31.33,Default,,0,0,0,,Өз қабілетіңізге қарай.
Dialogue: 0,0:13:31.33,0:13:34.50,Default,,0,0,0,,Мен мұны мойындағым келмейді.
Dialogue: 0,0:13:34.50,0:13:39.01,Default,,0,0,0,,Мен кәсіпқой әлемге кіруге тырыстым.
Dialogue: 0,0:13:39.01,0:13:44.48,Default,,0,0,0,,Бірақ бұл да өз шегіне жетті.
Dialogue: 0,0:13:44.48,0:13:48.65,Default,,0,0,0,,Кешіріңіз. иә?
Dialogue: 0,0:13:48.65,0:13:52.32,Default,,0,0,0,,Менен кек ала алмайсың.
Dialogue: 0,0:13:52.32,0:13:55.01,Default,,0,0,0,,〓
Dialogue: 0,0:13:55.01,0:13:58.03,Default,,0,0,0,,Ой? Уақыт келді ме?
Dialogue: 0,0:13:58.03,0:14:04.33,Default,,0,0,0,,Осындай қызықсыз әңгіме қозғағаным үшін кешірші, балам.
Dialogue: 0,0:14:04.33,0:14:11.74,Default,,0,0,0,,Алдыда менің қызметтік міндетімнің соңғы шайқасы күтіп тұр.
Dialogue: 0,0:14:11.74,0:14:14.33,Default,,0,0,0,,Бұл! иә?
Dialogue: 0,0:14:14.33,0:14:20.50,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:14:20.50,0:14:28.32,Default,,0,0,0,,Есімі жоқ ескі солдаттың соңын мұқият қадағалаңыз.
Dialogue: 0,0:14:28.32,0:14:31.98,Default,,0,0,0,,Жақсы жұмыс~. Мен үйдемін.
Dialogue: 0,0:14:31.98,0:14:37.47,Default,,0,0,0,,Толық жеңіліс... ПВ-ға материал түсіре алмадым, солай ма?
Dialogue: 0,0:14:37.47,0:14:40.14,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:14:40.14,0:14:43.16,Default,,0,0,0,,Бірдеңе болды ма? жоқ….
Dialogue: 0,0:14:43.16,0:14:46.33,Default,,0,0,0,,
Dialogue: 0,0:14:46.33,0:14:49.31,Default,,0,0,0,,Енді соңғы шайқастың уақыты келді!
Dialogue: 0,0:14:49.31,0:14:53.00,Default,,0,0,0,,Міне, осы уақытқа дейін жеңілмеген екі жігіт!
Dialogue: 0,0:14:53.00,0:14:56.65,Default,,0,0,0,,〓Камен Х Карло Марукоға қарсы!
Dialogue: 0,0:14:56.65,0:14:58.67,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:14:58.67,0:15:02.56,Default,,0,0,0,,Карло-санның соңғы қарсыласы Экс! ?
Dialogue: 0,0:15:02.56,0:15:10.32,Default,,0,0,0,,〓Жарайды! Бүгінгі іс-шараны қызу тартыспен аяқтаңыз!
Dialogue: 0,0:15:10.32,0:15:13.82,Default,,0,0,0,,Экс Карло Марукоға қарсы... Бұл көруге болатын нәрсе.
Dialogue: 0,0:15:13.82,0:15:16.72,Default,,0,0,0,,Сен де Марути туралы білесің бе, Карло?
Dialogue: 0,0:15:16.72,0:15:19.31,Default,,0,0,0,,Ол біраз уақыт атақты болды.
Dialogue: 0,0:15:19.31,0:15:22.33,Default,,0,0,0,,Ол күшті және заттарды көтеруге шебер.
Dialogue: 0,0:15:22.33,0:15:27.35,Default,,0,0,0,,Сәлем. Пендрагон командасынан жеңілгеннен кейін...
Dialogue: 0,0:15:27.35,0:15:31.67,Default,,0,0,0,,Иә, Карло, сен Пендрагонмен соғысып көрдің бе? ?
Dialogue: 0,0:15:31.67,0:15:36.66,Default,,0,0,0,,Рюгу Chrome мен Маруко Карло арасындағы шайқас өте танымал, солай емес пе?
Dialogue: 0,0:15:36.66,0:15:42.00,Default,,0,0,0,,Екеуі де сол кездегі атақты жұлдыздар болды.
Dialogue: 0,0:15:42.00,0:15:47.99,Default,,0,0,0,,《Карлоның жеңілген қарсыласы Пендрагон болды》
Dialogue: 0,0:15:47.99,0:15:50.32,Default,,0,0,0,,Келіңіз және байыпты жеңіңіз.
Dialogue: 0,0:15:50.32,0:15:53.98,Default,,0,0,0,,Бұл шайқас менің зейнеткерлікке шығу матчым.
Dialogue: 0,0:15:53.98,0:15:56.65,Default,,0,0,0,,О, солай ма?
Dialogue: 0,0:15:56.65,0:15:59.50,Default,,0,0,0,,Жарайды, байсалды болайық!
Dialogue: 0,0:15:59.50,0:16:02.84,Default,,0,0,0,,〓Бір шайқас фестивалінің финалдық матчы.
Dialogue: 0,0:16:02.84,0:16:10.33,Default,,0,0,0,,〓Камен Х Карло Марукоға қарсы.
Dialogue: 0,0:16:10.33,0:16:13.66,Default,,0,0,0,,Сіз қарапайым адам емессіз.
Dialogue: 0,0:16:13.66,0:16:18.65,Default,,0,0,0,,Соңғы қарсыласымның қауіпті болғанына сене алар емеспін...
Dialogue: 0,0:16:18.65,0:16:20.82,Default,,0,0,0,,〓Дайын жинақ!
Dialogue: 0,0:16:20.82,0:16:23.82,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:16:23.82,0:16:26.99,Default,,0,0,0,,Қой!
Dialogue: 0,0:16:26.99,0:16:47.65,Default,,0,0,0,,〓〜
Dialogue: 0,0:16:47.65,0:16:49.67,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:16:49.67,0:16:56.72,Default,,0,0,0,,Экстремалды сызықша!
Dialogue: 0,0:16:56.72,0:16:58.66,Default,,0,0,0,,О!
Dialogue: 0,0:16:58.66,0:17:02.83,Default,,0,0,0,,〓Уау! Extreme Dash қашып құтылды!
Dialogue: 0,0:17:02.83,0:17:05.00,Default,,0,0,0,,Бұл қызық болып барады!
Dialogue: 0,0:17:05.00,0:17:13.01,Default,,0,0,0,,Керемет!
Dialogue: 0,0:17:13.01,0:17:14.98,Default,,0,0,0,,Мм.
Dialogue: 0,0:17:14.97,0:17:25.55,Default,,0,0,0,,Экстремалды сызықтан жалтару және оны шабуыл шайқасына апару.
Dialogue: 0,0:17:25.55,0:17:28.32,Default,,0,0,0,,Хмм, тамаша!
Dialogue: 0,0:17:28.32,0:17:32.98,Default,,0,0,0,,Мұндай шабуыл шайқасы да жақсы! Ха!
Dialogue: 0,0:17:32.98,0:17:36.51,Default,,0,0,0,,《Қанша шабуыл болғаны таңқаларлық〓
Dialogue: 0,0:17:36.51,0:17:42.35,Default,,0,0,0,,Айналу мүлде төмендеген жоқ》
Dialogue: 0,0:17:42.35,0:17:47.81,Default,,0,0,0,,《Мен шынымен твиттер жазып жатырмын》
Dialogue: 0,0:17:47.81,0:17:49.98,Default,,0,0,0,,《Күмән жоқ.
Dialogue: 0,0:17:49.98,0:17:56.37,Default,,0,0,0,,Бұл шайқас менің кәсіби өмірімдегі ең жақсы шайқас болады! 》
Dialogue: 0,0:17:56.37,0:18:03.31,Default,,0,0,0,,Kamase Strike Hawk!
Dialogue: 0,0:18:03.31,0:18:05.33,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:18:05.33,0:18:12.37,Default,,0,0,0,,〓Strike Hawk Осы жерде бірден шешейік! ?
Dialogue: 0,0:18:12.37,0:18:16.34,Default,,0,0,0,,Сұңқыр сүңгу!
Dialogue: 0,0:18:16.34,0:18:21.91,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:18:21.91,0:18:23.81,Default,,0,0,0,,Не! ?
Dialogue: 0,0:18:23.81,0:18:31.48,Default,,0,0,0,,〓～
Dialogue: 0,0:18:31.48,0:18:34.39,Default,,0,0,0,,〓Dran Dagger Burst Finish.
Dialogue: 0,0:18:34.39,0:18:39.41,Default,,0,0,0,,〓Беткіленген X жеңісі.
Dialogue: 0,0:18:39.41,0:18:43.50,Default,,0,0,0,,〓Браво! Оқиғаны аяқтаудың тамаша тәсілі
Dialogue: 0,0:18:43.50,0:18:46.47,Default,,0,0,0,,Бұл ең жақсы шайқас болды!
Dialogue: 0,0:18:46.47,0:18:49.14,Default,,0,0,0,,Мыс.
Dialogue: 0,0:18:49.14,0:18:51.47,Default,,0,0,0,,Иә.
Dialogue: 0,0:18:51.47,0:18:56.66,Default,,0,0,0,,Ақырында, Карло Маруко осы шайқастан кейін зейнетке шығады.
Dialogue: 0,0:18:56.66,0:18:59.65,Default,,0,0,0,,〓Көп рахмет!
Dialogue: 0,0:18:59.65,0:19:02.67,Default,,0,0,0,,〓Барлығыңыз, үлкен қошемет!
Dialogue: 0,0:19:02.67,0:19:13.33,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:19:13.33,0:19:16.65,Default,,0,0,0,,Карло!
Dialogue: 0,0:19:16.65,0:19:20.32,Default,,0,0,0,,Ха ха ха ха ха ха….
Dialogue: 0,0:19:20.32,0:19:22.99,Default,,0,0,0,,Не болды? бала.
Dialogue: 0,0:19:22.99,0:19:27.37,Default,,0,0,0,,Мм... Дәл қазір қызық болды. Қайтадан жасайық!
Dialogue: 0,0:19:27.37,0:19:30.66,Default,,0,0,0,,Сіз бүгін кәсіби жұмысты тоқтатасыз ба?
Dialogue: 0,0:19:30.66,0:19:33.83,Default,,0,0,0,,Сәлем! Тым нәзік.
Dialogue: 0,0:19:33.83,0:19:38.00,Default,,0,0,0,,Не? Тек кәсіпқой болуды тоқтату Бейді тоқтатпайды, солай ма?
Dialogue: 0,0:19:38.00,0:19:39.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:39.99,0:19:43.66,Default,,0,0,0,,Я... хахахахахахахаха!
Dialogue: 0,0:19:43.66,0:19:48.31,Default,,0,0,0,,Ах, мен сен сияқты құбыжық Блейдермен күресуге тура келді〓
Dialogue: 0,0:19:48.31,0:19:52.68,Default,,0,0,0,,Бұл өте жақсы болды. Карло мырза.
Dialogue: 0,0:19:52.68,0:19:55.99,Default,,0,0,0,,Бала, мұқият қарадың ба?
Dialogue: 0,0:19:55.99,0:20:00.66,Default,,0,0,0,,Иә. Мен түсінемін.
Dialogue: 0,0:20:00.66,0:20:03.64,Default,,0,0,0,,Қандай жүз, балам.
Dialogue: 0,0:20:03.64,0:20:07.81,Default,,0,0,0,,Мына жерде бір үлкен ауызды тістеп ал.
Dialogue: 0,0:20:07.81,0:20:10.32,Default,,0,0,0,,Иә….
Dialogue: 0,0:20:10.32,0:20:15.72,Default,,0,0,0,,Біз міндетті түрде шыңға шығамыз! Көріңіздер!
Dialogue: 0,0:20:15.72,0:20:18.99,Default,,0,0,0,,Жоғарғы? Жақсы!
Dialogue: 0,0:20:18.99,0:20:26.40,Default,,0,0,0,,Хахахахахахахаха...!
Dialogue: 0,0:20:26.40,0:20:29.49,Default,,0,0,0,,《Бала, сен әлсізсің.
Dialogue: 0,0:20:29.49,0:20:33.67,Default,,0,0,0,,Бірақ мойымай, алға ұмтылуға болады.
Dialogue: 0,0:20:33.67,0:20:42.33,Default,,0,0,0,,Бұл мақтануға тұрарлық талант.
Dialogue: 0,0:20:42.33,0:21:05.30,Default,,0,0,0,,《Ол кезде сендей күш-қуатым болса...》
Dialogue: 0,0:21:05.30,0:21:09.49,Default,,0,0,0,,Сіз өте сергітетін сияқтысыз.
Dialogue: 0,0:21:09.49,0:21:13.88,Default,,0,0,0,,Өйткені ол зейнеткерлікке шығу үшін ең жақсы матчты өткізді.
Dialogue: 0,0:21:13.88,0:21:19.65,Default,,0,0,0,,Аа...
Dialogue: 0,0:21:19.65,0:21:24.04,Default,,0,0,0,,Бұл мен кәсіпқой ретінде шайқасқан шайқастардың деректері.
Dialogue: 0,0:21:24.04,0:21:27.64,Default,,0,0,0,,Рахмет. Өз шығанағын сүю сезімі〓
Dialogue: 0,0:21:27.64,0:21:29.98,Default,,0,0,0,,Мен оны алдым.
Dialogue: 0,0:21:29.98,0:21:36.40,Default,,0,0,0,,Сіздің адалдығыңыз Бейблейдті бұдан да биік белестерге жетелейді.
Dialogue: 0,0:21:36.40,0:21:38.65,Default,,0,0,0,,Оны ақылмен қолданыңыз.
Dialogue: 0,0:21:38.65,0:21:42.06,Default,,0,0,0,,Мен бүгін соңғы шайқастым
Dialogue: 0,0:21:42.06,0:21:45.83,Default,,0,0,0,,Ол мен күрескен ең жылдам қарсылас болды.
Dialogue: 0,0:21:45.83,0:21:48.33,Default,,0,0,0,,Бұлай айтатыныңызға сене алар емеспін.
Dialogue: 0,0:21:48.33,0:21:53.22,Default,,0,0,0,,Мен оны ғана емес, басқа да қызық қыздарды кездестірдім.
Dialogue: 0,0:21:53.22,0:21:55.82,Default,,0,0,0,,Байдың болашағы жарқын.
Dialogue: 0,0:21:55.82,0:21:57.84,Default,,0,0,0,,Сізге ант етемін.
Dialogue: 0,0:21:57.84,0:22:06.43,Default,,0,0,0,,Мен барлық қалақтарды шығанақ биігіне апарамын.
Dialogue: 0,0:22:06.43,0:22:14.32,Default,,0,0,0,,Бұл...
Dialogue: 0,0:22:14.32,0:22:17.29,Default,,0,0,0,,Мен жетелейтін биіктер
Dialogue: 0,0:22:17.29,0:22:20.71,Default,,0,0,0,,Шығу уақытының ауысуы ең жылдам жылдамдықтан асып түседі.
Dialogue: 0,0:22:31.14,0:22:33.60,On Top,,0,0,0,,Менің барудан қорықпайтынымды білесіз
Dialogue: 0,0:22:33.60,0:22:35.56,On Top,,0,0,0,,Дауылға тура секіру
Dialogue: 0,0:22:35.56,0:22:39.90,On Top,,0,0,0,,Артқа отырыңыз, сапардан ләззат алыңыз (Жарайды, жарайды)
Dialogue: 0,0:22:39.90,0:22:41.61,On Top,,0,0,0,,Олардың не айтатыны маған бәрібір
Dialogue: 0,0:22:41.61,0:22:43.61,On Top,,0,0,0,,Мен мұның бәрін өзім үшін қалаймын
Dialogue: 0,0:22:43.61,0:22:44.61,On Top,,0,0,0,,Мені тоқтата алмаймын
Dialogue: 0,0:22:44.61,0:22:46.11,On Top,,0,0,0,,Мұны бәрі білсін
Dialogue: 0,0:22:46.11,0:22:48.03,On Top,,0,0,0,,Мен оны қабылдауға дайынмын
Dialogue: 0,0:22:48.53,0:22:49.74,On Top,,0,0,0,,Біз ерекше бола аламыз
Dialogue: 0,0:22:49.74,0:22:52.41,On Top,,0,0,0,,Немесе сіз қарапайым нәрселерді жақсы көресіз бе? иә?
Dialogue: 0,0:22:52.41,0:22:53.66,On Top,,0,0,0,,Бұл менің соңым болуы мүмкін
Dialogue: 0,0:22:53.66,0:22:56.21,On Top,,0,0,0,,Сондықтан Имма сені менің жауым BOOM сияқты жақындатады
Dialogue: 0,0:22:56.21,0:22:57.87,On Top,,0,0,0,,Қалағаныңызша солай сөйлесіңіз
Dialogue: 0,0:22:57.87,0:23:00.04,On Top,,0,0,0,,Бірге өту
Dialogue: 0,0:23:00.04,0:23:01.34,On Top,,0,0,0,,Менің не алғанымды көрсетіңіз
Dialogue: 0,0:23:01.34,0:23:02.21,On Top,,0,0,0,,Төтенше мен
Dialogue: 0,0:23:02.21,0:23:04.84,On Top,,0,0,0,,Бұл маған ұнайтын нәрсе
Dialogue: 0,0:23:04.84,0:23:08.34,On Top,,0,0,0,,Сізбен бірге тұрып, шайқасқа аттаныңыз
Dialogue: 0,0:23:08.34,0:23:12.26,On Top,,0,0,0,,Айнымас сезімдерді қорғау
Dialogue: 0,0:23:12.26,0:23:14.31,On Top,,0,0,0,,Қарамаңдар
Dialogue: 0,0:23:14.31,0:23:16.93,On Top,,0,0,0,,Келесі әлемге
Dialogue: 0,0:23:17.14,0:23:19.27,On Top,,0,0,0,,Үлкейтіңіз, үлкейтіңіз
Dialogue: 0,0:23:19.27,0:23:21.52,On Top,,0,0,0,,Масштабты үлкейту' Мен ұлғайту, масштабтау
Dialogue: 0,0:23:21.52,0:23:23.11,On Top,,0,0,0,,Мен сізді үлкейтемін
Dialogue: 0,0:23:23.11,0:23:25.32,On Top,,0,0,0,,Масштабты үлкейту' Мен ұлғайту, масштабтау
Dialogue: 0,0:23:25.32,0:23:26.86,On Top,,0,0,0,,Енді сізді үлкейтіңіз
Dialogue: 0,0:23:26.86,0:23:29.32,On Top,,0,0,0,,Масштабты үлкейту' Мен ұлғайтамын, ұлғайту
Dialogue: 0,0:23:29.32,0:23:30.61,On Top,,0,0,0,,Мен сізді үлкейтемін
Dialogue: 0,0:23:30.61,0:23:32.66,On Top,,0,0,0,,Масштабты масштабтау Көңілді болайық
Dialogue: 0,0:23:32.66,0:23:34.58,On Top,,0,0,0,,Масштабты масштабтау Осы сәт
Dialogue: 0,0:23:34.58,0:23:37.41,On Top,,0,0,0,,Енді менің көз алдымда мен сені артта қалдыра алмаймын
Dialogue: 0,0:23:37.41,0:23:39.41,On Top,,0,0,0,,Мен мұны өз жолыммен істеп жатқанымды білесіз
Dialogue: 0,0:23:39.41,0:23:42.29,On Top,,0,0,0,,'Себебі мен масштабтаймын, масштабтаймын' Мен сізді үлкейтемін
Dialogue: 0,0:23:42.29,0:23:45.05,On Top,,0,0,0,,Енді менің көз алдымда мен сені артта қалдыра алмаймын
Dialogue: 0,0:23:45.05,0:23:47.46,On Top,,0,0,0,,Мен оны шыңға шығарамын
Dialogue: 0,0:23:47.46,0:23:50.84,On Top,,0,0,0,,'Себебі мен масштабтаймын, масштабтаймын' Мен сізді үлкейтемін
Dialogue: 0,0:23:56.22,0:23:58.89,Default,,0,0,0,,Мен бір күні зейнетке шығамын ба?
Dialogue: 0,0:23:58.93,0:24:00.73,Default,,0,0,0,,Бард ағыны өлмес пе?
Dialogue: 0,0:24:00.81,0:24:02.31,Default,,0,0,0,,Бұл емес!
Dialogue: 0,0:24:02.44,0:24:04.10,Default,,0,0,0,,Әркім бір күні зейнетке шығады.
Dialogue: 0,0:24:04.52,0:24:06.11,Default,,0,0,0,,Әртүрлі себептер бар.
Dialogue: 0,0:24:06.48,0:24:08.73,Default,,0,0,0,,Қыз неліктен зейнетке шықты?
Dialogue: 0,0:24:08.73,0:24:10.90,Default,,0,0,0,,Бұл өте нәзік емес.
Dialogue: 0,0:24:11.82,0:24:12.40,Default,,0,0,0,,Мегуми Фушигуро.
Dialogue: 0,0:24:13.03,0:24:14.91,Default,,0,0,0,,Келесі жолы Beyblade X
Dialogue: 0,0:24:15.32,0:24:16.32,Default,,0,0,0,,Желдеткіш №1
Dialogue: 0,0:24:16.91,0:24:20.20,Default,,0,0,0,,Негізі мен өзімнің туған планетам Қызға оралуды шештім.
Dialogue: 0,0:24:20.41,0:24:21.50,Default,,0,0,0,,--Шынымен!?
Dialogue: 0,0:24:21.50,0:24:24.00,Default,,0,0,0,,Екеуің де тазасыңдар.
Dialogue: 0,0:24:25.50,0:24:31.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory