Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.13,0:00:05.53,Default,,0,0,0,,<Х... Адамдарды қызықтыратын нәрсе.
Dialogue: 0,0:00:05.53,0:00:09.17,Default,,0,0,0,,Бейблейд ойын ма? Бұл спорт па?
Dialogue: 0,0:00:09.17,0:00:12.47,Default,,0,0,0,,X➡-тің ең үлкен үдеуі
Dialogue: 0,0:00:12.47,0:00:16.48,Default,,0,0,0,,Экстремалды ойын.
Dialogue: 0,0:00:16.48,0:00:19.78,Default,,0,0,0,,X сіздің қолыңызда＞
Dialogue: 0,0:00:25.62,0:00:28.12,Default,,0,0,0,,Persona командасы керемет емес пе?
Dialogue: 0,0:00:28.12,0:00:30.79,Default,,0,0,0,,Бей күшті, жұмбақтарды шеше алады.
Dialogue: 0,0:00:30.79,0:00:33.33,Default,,0,0,0,,Сіз оны бірінші рет тазартатын адам боласыз ба?
Dialogue: 0,0:00:33.33,0:00:36.83,Default,,0,0,0,,Эй, сен қанша күтесің?
Dialogue: 0,0:00:36.83,0:00:39.80,Default,,0,0,0,,Сіздің кезегіңізге аз қалды.
Dialogue: 0,0:00:43.31,0:00:45.47,Default,,0,0,0,,Бұл өте жанды.
Dialogue: 0,0:00:45.47,0:00:48.64,Default,,0,0,0,,Мен тез шайқасқым келеді!
Dialogue: 0,0:00:48.64,0:00:53.52,Default,,0,0,0,,Жауынгерлік шайқас! Кішкене ғана. Эй.
Dialogue: 0,0:00:53.52,0:00:56.82,Default,,0,0,0,,О, мен Bay Tube-тен көрген адам!
Dialogue: 0,0:00:56.82,0:01:00.82,Default,,0,0,0,,Сізге Beyblade ұнай ма?
Dialogue: 0,0:01:00.82,0:01:04.19,Default,,0,0,0,,Иә! Мен кәсіби шебер болғым келеді.
Dialogue: 0,0:01:11.30,0:01:13.34,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:13.34,0:01:17.87,Default,,0,0,0,,Бұл Бей сіздің Бейблейдіңізді өзгертеді.
Dialogue: 0,0:01:17.87,0:01:19.91,Default,,0,0,0,,Мен оны саған беремін.
Dialogue: 0,0:01:19.91,0:01:22.61,Default,,0,0,0,,Бейблейд әлдеқайда қызықты болады.
Dialogue: 0,0:01:22.61,0:01:26.52,Default,,0,0,0,,Уау, керемет! кешіріңіз.
Dialogue: 0,0:01:26.52,0:01:28.82,Default,,0,0,0,,Иә? О сен!
Dialogue: 0,0:01:28.82,0:01:31.19,Default,,0,0,0,,Тыныш.
Dialogue: 0,0:03:18.13,0:03:23.47,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:03:23.47,0:03:25.80,Default,,0,0,0,,Ақырында, соңғы сұрақ – сопылық.
Dialogue: 0,0:03:25.80,0:03:27.84,Default,,0,0,0,,Осыны өшіре алсаңыз➡
Dialogue: 0,0:03:27.84,0:03:32.47,Default,,0,0,0,,Team Persona - Nazo&Ba, Зонарды тазартқан бірінші адам!
Dialogue: 0,0:03:32.47,0:03:34.48,Default,,0,0,0,,Жарайды, мен істеймін.
Dialogue: 0,0:03:34.48,0:03:38.28,Default,,0,0,0,,...бұл Зона ма? Сіз жаңа ғана Зона дедіңіз.
Dialogue: 0,0:03:38.28,0:03:40.28,Default,,0,0,0,,Бұл Зона болды.
Dialogue: 0,0:03:40.28,0:03:43.45,Default,,0,0,0,,Сопы фифи….
Dialogue: 0,0:03:43.45,0:03:46.79,Default,,0,0,0,,Аймақ аймағы….
Dialogue: 0,0:03:46.79,0:03:50.13,Default,,0,0,0,,Аймақ аймағы Аймақтық аймақ!
Dialogue: 0,0:03:50.13,0:03:52.46,Default,,0,0,0,,Ах! Сіз!
Dialogue: 0,0:03:52.46,0:03:55.66,Default,,0,0,0,,Nazo&Bay соңғы мәселе аймағы!
Dialogue: 0,0:04:01.64,0:04:04.47,Default,,0,0,0,,Сүйектер сияқты бір нәрсе айналып жатыр.
Dialogue: 0,0:04:04.47,0:04:07.31,Default,,0,0,0,,Бұл зат текше деп аталады.
Dialogue: 0,0:04:07.31,0:04:10.81,Default,,0,0,0,,Зона!
Dialogue: 0,0:04:10.81,0:04:16.12,Default,,0,0,0,,Стадион! ? Жаса!
Dialogue: 0,0:04:16.12,0:04:18.12,Default,,0,0,0,,Жасай бер!
Dialogue: 0,0:04:18.12,0:04:22.12,Default,,0,0,0,,Шайқас? Сіз шайқасқа барасыз ба? Эй, тыныштал.
Dialogue: 0,0:04:22.12,0:04:26.29,Default,,0,0,0,,Зонамос үйінің ең үлкен көрікті жері Назо мен шығанағы.
Dialogue: 0,0:04:26.29,0:04:28.96,Default,,0,0,0,,Тазалағанда үлкен байлыққа ие боласыз➡
Dialogue: 0,0:04:28.96,0:04:31.80,Default,,0,0,0,,Зона атаққа ие болды!
Dialogue: 0,0:04:31.80,0:04:33.80,Default,,0,0,0,,Зонаны қазір бастаңыз! (шузер)
Dialogue: 0,0:04:33.80,0:04:37.97,Default,,0,0,0,,Жарайды, мен мүлдем үлгере алмаймын!
Dialogue: 0,0:04:37.97,0:04:41.44,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:04:41.44,0:04:45.65,Default,,0,0,0,,Құс Бейбатты! Бұл Бейбатт!
Dialogue: 0,0:04:45.65,0:04:47.62,Default,,0,0,0,,Сондықтан күте тұрыңыз.
Dialogue: 0,0:04:47.62,0:04:51.52,Default,,0,0,0,,Дәлірек айтсақ, сіз өзіңіздің шынайы болмысыңызды жасыру үшін неліктен қиындыққа бардыңыз?
Dialogue: 0,0:04:51.52,0:04:54.12,Default,,0,0,0,,Zona Zona Ақымақ аймақ.
Dialogue: 0,0:04:54.12,0:04:57.79,Default,,0,0,0,,Мен мұнымен Зонаны таң қалдырғым келеді.
Dialogue: 0,0:04:57.79,0:04:59.80,Default,,0,0,0,,Міне! ?
Dialogue: 0,0:04:59.80,0:05:02.76,Default,,0,0,0,,Зона таңырқаған жүзді көргісі келді.
Dialogue: 0,0:05:02.76,0:05:04.80,Default,,0,0,0,,Әй, жақсы Зона?
Dialogue: 0,0:05:04.80,0:05:08.30,Default,,0,0,0,,Егер сіз жалқау болсаңыз, сіздің уақытыңыз аяқталады және сіз жарыстан шығарыласыз.
Dialogue: 0,0:05:08.30,0:05:10.61,Default,,0,0,0,,Уф, мен не істеуім керек!
Dialogue: 0,0:05:10.61,0:05:13.48,Default,,0,0,0,,Бізде стадион бар, сондықтан шайқасудан басқа амалымыз жоқ!
Dialogue: 0,0:05:13.48,0:05:15.78,Default,,0,0,0,,Эгоисттік ештеңе жасамаңыз!
Dialogue: 0,0:05:15.78,0:05:20.18,Default,,0,0,0,,Осы жерден қателессем, бар еңбегім бекер!
Dialogue: 0,0:05:20.18,0:05:22.98,Default,,0,0,0,,Сәлем! Маған Мультиден бірдеңе айтыңызшы!
Dialogue: 0,0:05:22.98,0:05:27.86,Default,,0,0,0,,Жібер! Мені жіберме! Ах, аа!
Dialogue: 0,0:05:27.86,0:05:31.23,Default,,0,0,0,,Еш ойланбастан ату. Түсіргенде білетін боласыз!
Dialogue: 0,0:05:33.13,0:05:35.13,Default,,0,0,0,,Аа...
Dialogue: 0,0:05:35.13,0:05:38.50,Default,,0,0,0,,Кәне, бастайық!
Dialogue: 0,0:05:38.50,0:05:42.14,Default,,0,0,0,,Бұл сфинкс қабығы менің қарсыласым Зона!
Dialogue: 0,0:05:42.14,0:05:44.14,Default,,0,0,0,,О, мына шығанақ!
Dialogue: 0,0:05:44.14,0:05:47.91,Default,,0,0,0,,Бұл біз алдыңғы есепте көрген шығанақ. Ол қорғаныс түрі.
Dialogue: 0,0:05:49.98,0:05:53.15,Default,,0,0,0,,X…. 🔊Дайын жиынтық!
Dialogue: 0,0:05:53.15,0:05:57.62,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:05:57.62,0:06:00.22,Default,,0,0,0,,Қой!
Dialogue: 0,0:06:02.62,0:06:07.30,Default,,0,0,0,,Аймақ аймағы. Камен-кун Керемет түсірілім Зона.
Dialogue: 0,0:06:07.30,0:06:09.70,Default,,0,0,0,,Дран Қылыш - шабуыл түрі.
Dialogue: 0,0:06:09.70,0:06:12.47,Default,,0,0,0,,Сфинкс қабықшасының қорғаныс түріне қарсы тиімсіз.
Dialogue: 0,0:06:15.64,0:06:18.24,Default,,0,0,0,,Бұл өте жеңіл, мен бара аламын.
Dialogue: 0,0:06:20.31,0:06:23.51,Default,,0,0,0,,Кез келген түрі келеді! Барайық!
Dialogue: 0,0:06:27.82,0:06:31.49,Default,,0,0,0,,Жарайсыңдар! Жақсы!
Dialogue: 0,0:06:37.86,0:06:40.03,Default,,0,0,0,,Әй, не?
Dialogue: 0,0:06:42.96,0:06:45.47,Default,,0,0,0,,Жарайсың Зона!
Dialogue: 0,0:06:45.47,0:06:49.14,Default,,0,0,0,,Мен оны толық түсінбедім, бірақ қазір түсінікті деп ойлаймын.
Dialogue: 0,0:06:49.14,0:06:51.31,Default,,0,0,0,,Зонамос үйін жаулап алыңыз.
Dialogue: 0,0:06:51.31,0:06:54.01,Default,,0,0,0,,Мен түсінікті деп айтқан жоқпын. иә?
Dialogue: 0,0:06:55.94,0:06:59.11,Default,,0,0,0,,Аймақты жалғастырыңыз. (шузер)
Dialogue: 0,0:06:59.11,0:07:03.12,Default,,0,0,0,,Әлі аяқталмады ма? Не айтқың келеді?
Dialogue: 0,0:07:03.12,0:07:05.15,Default,,0,0,0,,Бұл қайталап көруге болатынын білдіре ме?
Dialogue: 0,0:07:05.15,0:07:07.36,Default,,0,0,0,,Иә! Жоқ. Хоб.
Dialogue: 0,0:07:07.36,0:07:11.23,Default,,0,0,0,,Келесі кезекте құс жүреді. О, мен?
Dialogue: 0,0:07:14.46,0:07:16.43,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:07:20.64,0:07:24.14,Default,,0,0,0,,Сенің қобалжуың дұрыс па, Зона?
Dialogue: 0,0:07:24.14,0:07:28.88,Default,,0,0,0,,Әй, мен де бұрын шайқасқа қарап отырған жоқпын.
Dialogue: 0,0:07:28.88,0:07:33.45,Default,,0,0,0,,Zonamos Сіздің жұмбақ шешілді. Зона?
Dialogue: 0,0:07:33.45,0:07:35.48,Default,,0,0,0,,Оо?
Dialogue: 0,0:07:35.48,0:07:38.82,Default,,0,0,0,,X сфинкстің қабығын ұшырып жібергенде, ол өртеніп кетті.
Dialogue: 0,0:07:38.82,0:07:41.39,Default,,0,0,0,,Және төрт сөре бар.
Dialogue: 0,0:07:41.39,0:07:43.89,Default,,0,0,0,,Бұл тағы үш рет жеңіске жетуіміз керек дегенді білдіреді.
Dialogue: 0,0:07:45.79,0:07:48.33,Default,,0,0,0,,Бірақ бұл тым қарапайым.
Dialogue: 0,0:07:48.33,0:07:52.17,Default,,0,0,0,,Мүмкін мен 4 рет аяқтауым керек шығар.
Dialogue: 0,0:07:52.17,0:07:54.80,Default,,0,0,0,,Ой, бардтың атын тап.
Dialogue: 0,0:07:54.80,0:07:57.97,Default,,0,0,0,,Мен екінші отты жағамын!
Dialogue: 0,0:07:57.97,0:08:01.88,Default,,0,0,0,,Егер сіз солай ойласаңыз, көріңіз.
Dialogue: 0,0:08:01.88,0:08:04.15,Default,,0,0,0,,🔊Дайын жиынтық!
Dialogue: 0,0:08:04.15,0:08:07.62,Default,,0,0,0,,Үш екі бір.
Dialogue: 0,0:08:07.62,0:08:10.22,Default,,0,0,0,,Қой!
Dialogue: 0,0:08:13.46,0:08:16.16,Default,,0,0,0,,О, құс. Бұл жақсы кадр.
Dialogue: 0,0:08:16.16,0:08:18.23,Default,,0,0,0,,Бұл сізді таң қалдырады.
Dialogue: 0,0:08:22.33,0:08:24.30,Default,,0,0,0,,Мен бүгін шешемін!
Dialogue: 0,0:08:24.30,0:08:29.20,Default,,0,0,0,,Көру және еліктеу үшін экстремалды сызықша!
Dialogue: 0,0:08:32.64,0:08:36.64,Default,,0,0,0,,Сонда Сфинкс Каулын жеңу мүмкін емес.
Dialogue: 0,0:08:36.64,0:08:52.33,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:08:52.33,0:08:55.80,Default,,0,0,0,,Сфинкс қабығының тамаша дөңгелек пішіні ➡
Dialogue: 0,0:08:55.80,0:08:58.47,Default,,0,0,0,,Зона шабуылдарды жояды!
Dialogue: 0,0:09:03.87,0:09:05.77,Default,,0,0,0,,Уф….
Dialogue: 0,0:09:05.77,0:09:08.98,Default,,0,0,0,,Соңғы сұраққа жеткеніммен➡
Dialogue: 0,0:09:08.98,0:09:13.85,Default,,0,0,0,,Менің кесірімнен оны қайтадан тазалай алмайсыз ба?
Dialogue: 0,0:09:13.85,0:09:16.82,Default,,0,0,0,,Жарайсың Зона! Айқай?
Dialogue: 0,0:09:19.12,0:09:22.32,Default,,0,0,0,,Ой, қандай тамаша жұмбақ шешуші Зона.
Dialogue: 0,0:09:22.32,0:09:24.83,Default,,0,0,0,,Мен жеңілдім.
Dialogue: 0,0:09:24.83,0:09:27.70,Default,,0,0,0,,Олай болса, Зона, жалғастыр. (шузер)
Dialogue: 0,0:09:27.70,0:09:30.80,Default,,0,0,0,,Не? иә? Неге екенін білмеймін ➡
Dialogue: 0,0:09:30.80,0:09:34.97,Default,,0,0,0,,Жарайды. Мен түсінбедім!
Dialogue: 0,0:09:34.97,0:09:39.17,Default,,0,0,0,,Неліктен? мен жеңілдім. Мен жеңілдім, бірақ бәрі жақсы болды.
Dialogue: 0,0:09:39.17,0:09:41.14,Default,,0,0,0,,Мен жеңілдім, бірақ бұл нені білдіреді?
Dialogue: 0,0:09:45.18,0:09:47.22,Default,,0,0,0,,Мен дәл қазір жеңілдім, солай ма?
Dialogue: 0,0:09:47.22,0:09:51.25,Default,,0,0,0,,Бірақ ол өртеніп кеткендіктен, бәрі жақсы.
Dialogue: 0,0:09:51.25,0:09:53.29,Default,,0,0,0,,Мм. (шузер)
Dialogue: 0,0:09:53.29,0:09:55.92,Default,,0,0,0,,Ойлау уақыты Зона аяқталады.
Dialogue: 0,0:09:55.92,0:09:58.59,Default,,0,0,0,,Зонаны келесі кім ойнайды?
Dialogue: 0,0:09:58.59,0:10:00.63,Default,,0,0,0,,Жоқ, сондықтан мен оны түсінбеймін!
Dialogue: 0,0:10:00.63,0:10:05.30,Default,,0,0,0,,Менің не айтқым келгенін білесің бе? Иә, толығымен ➡
Dialogue: 0,0:10:05.30,0:10:08.30,Default,,0,0,0,,Барлық біріктірілген активтер мен түсінбеймін.
Dialogue: 0,0:10:08.30,0:10:11.77,Default,,0,0,0,,Мен сенен сұрағаным үшін ақымақ болдым! Көп!
Dialogue: 0,0:10:13.94,0:10:16.61,Default,,0,0,0,,Хехе.
Dialogue: 0,0:10:16.61,0:10:20.62,Default,,0,0,0,,Қайырлы таң! Мен келесіде барамын!
Dialogue: 0,0:10:20.62,0:10:23.52,Default,,0,0,0,,Күту режимі мульти! Апыр-ай!
Dialogue: 0,0:10:23.52,0:10:25.79,Default,,0,0,0,,Бұл менімен билейтін қыз.
Dialogue: 0,0:10:25.79,0:10:28.29,Default,,0,0,0,,Шебер көрсеткісі.
Dialogue: 0,0:10:28.29,0:10:32.96,Default,,0,0,0,,Эй, бұл костюмді ауыстыру ма?
Dialogue: 0,0:10:32.96,0:10:38.83,Default,,0,0,0,,Олай емес~ Сіз соншалықты ұсақ-түйек нәрсені жасай алмайсыз.
Dialogue: 0,0:10:38.83,0:10:41.24,Default,,0,0,0,,Хехе. Зона.
Dialogue: 0,0:10:45.94,0:10:47.98,Default,,0,0,0,,🔊Дайын жиынтық!
Dialogue: 0,0:10:47.98,0:10:51.61,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:10:51.61,0:10:55.62,Default,,0,0,0,,Қой! Зона!
Dialogue: 0,0:10:58.79,0:11:02.79,Default,,0,0,0,,Multi Wizard Arrow – төзімділік түрі. Жақсы үйлесімділік.
Dialogue: 0,0:11:02.79,0:11:06.46,Default,,0,0,0,,Бірақ Құс Осы уақытқа дейінгі шайқастардан➡
Dialogue: 0,0:11:06.46,0:11:09.13,Default,,0,0,0,,Бұл тек жеңу туралы емес, солай ма?
Dialogue: 0,0:11:09.13,0:11:11.97,Default,,0,0,0,,Сондықтан мен білмеймін!
Dialogue: 0,0:11:11.97,0:11:17.04,Default,,0,0,0,,《Иә, Зона. Бұл соңғы мәселенің мәні шайқас емес.》
Dialogue: 0,0:11:17.04,0:11:19.61,Default,,0,0,0,,Бірақ бұл➡ дегенді білдірмейді
Dialogue: 0,0:11:19.61,0:11:23.78,Default,,0,0,0,,Мен саған қалағаныңды істеуге рұқсат бермеймін! Зона!
Dialogue: 0,0:11:23.78,0:11:25.78,Default,,0,0,0,,Ой.
Dialogue: 0,0:11:25.78,0:11:27.78,Default,,0,0,0,,Мен одан жақсы қашып жүрмін. Бірақ Құс.
Dialogue: 0,0:11:27.78,0:11:30.29,Default,,0,0,0,,Жалтарып жатқаныңыз жауапты білетініңізді білдірмейді.
Dialogue: 0,0:11:30.29,0:11:32.45,Default,,0,0,0,,Мен мұны білемін!
Dialogue: 0,0:11:32.45,0:11:35.12,Default,,0,0,0,,Аймақ аймағы Аймақтық аймақ.
Dialogue: 0,0:11:35.12,0:11:38.79,Default,,0,0,0,,Зонамос үйінің ең үлкен құпиясын қандай пышақ шеше алады?
Dialogue: 0,0:11:38.79,0:11:40.96,Default,,0,0,0,,Аймақ жоқ.
Dialogue: 0,0:11:43.43,0:11:45.93,Default,,0,0,0,,Сіз жақсы қашып жатырсыз.
Dialogue: 0,0:11:45.93,0:11:50.87,Default,,0,0,0,,Аймақ аймағы Аймақ Бұл аймақ лабиринт болатын сияқты.
Dialogue: 0,0:11:50.87,0:11:56.78,Default,,0,0,0,,Сфинкс қақпағы! Зона сізді керемет жұмбақпен таң қалдырады!
Dialogue: 0,0:11:56.78,0:12:00.68,Default,,0,0,0,,Хехехе, кешіріңіз. Зона?
Dialogue: 0,0:12:03.79,0:12:08.96,Default,,0,0,0,,Жұмбақ шешілді! Ол қандай көрінеді➡
Dialogue: 0,0:12:08.96,0:12:11.83,Default,,0,0,0,,Детектив Зона?
Dialogue: 0,0:12:11.83,0:12:17.60,Default,,0,0,0,,Ой! Көп таңбаны өзгерту. Детектив костюмі өте керемет!
Dialogue: 0,0:12:17.60,0:12:21.77,Default,,0,0,0,,Костюміңізді ауыстырғаныңыз құпияны шеше аласыз дегенді білдірмейді!
Dialogue: 0,0:12:21.77,0:12:25.64,Default,,0,0,0,,Зона мүмкіндігінше дұрыс жауап береді.
Dialogue: 0,0:12:25.64,0:12:28.68,Default,,0,0,0,,А... жауап бергенімді қалайсыз ба?
Dialogue: 0,0:12:28.68,0:12:31.95,Default,,0,0,0,,Мұның қажеті жоқ. Зона! ?
Dialogue: 0,0:12:31.95,0:12:36.45,Default,,0,0,0,,Менің ойымша, бұл қулық. Зонамос мырза.
Dialogue: 0,0:12:36.45,0:12:39.75,Default,,0,0,0,,Айқай! ? Марути не дейді?
Dialogue: 0,0:12:39.75,0:12:43.42,Default,,0,0,0,,Мен мүлде түсінбеймін.
Dialogue: 0,0:12:43.42,0:12:48.46,Default,,0,0,0,,Бұл жұмбақ шындық!
Dialogue: 0,0:12:48.46,0:12:51.23,Default,,0,0,0,,Зона! ?
Dialogue: 0,0:12:58.47,0:13:00.74,Default,,0,0,0,,Айналдыру!
Dialogue: 0,0:13:02.78,0:13:06.25,Default,,0,0,0,,Енді үшінші отты жағыңыз.
Dialogue: 0,0:13:06.25,0:13:14.96,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:13:14.96,0:13:17.63,Default,,0,0,0,,Жарайсың Зона!
Dialogue: 0,0:13:17.63,0:13:19.59,Default,,0,0,0,,Жарайсыңдар! Алақай!
Dialogue: 0,0:13:19.59,0:13:21.63,Default,,0,0,0,,нені білдіреді?
Dialogue: 0,0:13:21.63,0:13:24.53,Default,,0,0,0,,Мен сенен естігім келеді, Зона.
Dialogue: 0,0:13:24.53,0:13:29.27,Default,,0,0,0,,Бұдан былай бұл жұмбақ шоу. Мұқият тыңдаңыз.
Dialogue: 0,0:13:29.27,0:13:31.31,Default,,0,0,0,,Біріншіден, бұл 4X.
Dialogue: 0,0:13:31.31,0:13:34.68,Default,,0,0,0,,Текше туралы осылай айттыңыз ба? Ах.
Dialogue: 0,0:13:34.68,0:13:36.68,Default,,0,0,0,,Бірақ мен Құс-күнмін➡
Dialogue: 0,0:13:36.68,0:13:39.78,Default,,0,0,0,,Мен кешірім сұрауым керек. иә?
Dialogue: 0,0:13:39.78,0:13:42.78,Default,,0,0,0,,Бұл жай текше емес.
Dialogue: 0,0:13:42.78,0:13:46.32,Default,,0,0,0,,Бұл жай ғана текше емес пе? Жақсылап қарағаныңызды қалаймын.
Dialogue: 0,0:13:46.32,0:13:50.46,Default,,0,0,0,,Ойлаудың алғашқы қадамы бақылаудан басталады.
Dialogue: 0,0:13:50.46,0:13:54.50,Default,,0,0,0,,Ммм…. Хмм, сен солай айтсаң да.
Dialogue: 0,0:13:54.50,0:13:57.53,Default,,0,0,0,,Мұнда ерекше таңғаларлық ештеңе жоқ...
Dialogue: 0,0:13:57.53,0:14:00.64,Default,,0,0,0,,Иә? алшақтық?
Dialogue: 0,0:14:00.64,0:14:05.44,Default,,0,0,0,,Басқаша айтқанда, бұл қорап. Әй, мен соны айтайын деп едім!
Dialogue: 0,0:14:05.44,0:14:08.61,Default,,0,0,0,,Дұрыс. Бұл текше емес➡
Dialogue: 0,0:14:08.61,0:14:10.95,Default,,0,0,0,,Бұл айналатын қорап.
Dialogue: 0,0:14:10.95,0:14:14.52,Default,,0,0,0,,Иә? Бірақ не болды?
Dialogue: 0,0:14:14.52,0:14:17.95,Default,,0,0,0,,Бетперде киген Х-кун. Зонамос мырза алдымен не айтты?
Dialogue: 0,0:14:17.95,0:14:21.59,Default,,0,0,0,,Осы соңғы сұрақты қашан бастағаныңызды есіңе түсіре аласың ба?
Dialogue: 0,0:14:21.59,0:14:25.46,Default,,0,0,0,,Ал, жасайық.
Dialogue: 0,0:14:25.46,0:14:28.50,Default,,0,0,0,,Сонда ше? Жаса!
Dialogue: 0,0:14:28.50,0:14:31.53,Default,,0,0,0,,Әй, мен соны айтайын деп едім!
Dialogue: 0,0:14:31.53,0:14:34.77,Default,,0,0,0,,Хахаха Екеуі де өткір емес пе?
Dialogue: 0,0:14:34.77,0:14:37.44,Default,,0,0,0,,Орындаңыз. Жаса.
Dialogue: 0,0:14:37.44,0:14:41.31,Default,,0,0,0,,Әр тілде мағынасы бірдей сөздерді әдейі айтасыз.
Dialogue: 0,0:14:41.31,0:14:45.18,Default,,0,0,0,,Басқаша айтқанда, бұл оны ағылшын тіліне өзгертуге нұсқау.
Dialogue: 0,0:14:47.28,0:14:49.28,Default,,0,0,0,,Айналмалы қораптың ағылшын тіліндегі аудармасы➡
Dialogue: 0,0:14:49.28,0:14:52.15,Default,,0,0,0,,Бұл АЙНАЛДЫРУ ЖАБЫҒЫ бола ма?
Dialogue: 0,0:14:52.15,0:14:55.22,Default,,0,0,0,,Бұл... болады ма? Солай болатын сияқты.
Dialogue: 0,0:14:55.22,0:14:57.09,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:14:57.09,0:15:00.70,Default,,0,0,0,,Егер SPIN BOX сөзін әрі қарай бөлшектесек...
Dialogue: 0,0:15:02.80,0:15:04.80,Default,,0,0,0,,Бұл сөз SPIN және ➡
Dialogue: 0,0:15:04.80,0:15:07.44,Default,,0,0,0,,Үш алфавиттен не шығаруға болады?
Dialogue: 0,0:15:07.44,0:15:11.11,Default,,0,0,0,,SPIN туралы айтқанда, сіз айналдыруды аяқтауды айтасыз ба?
Dialogue: 0,0:15:11.11,0:15:13.61,Default,,0,0,0,,Сонымен, В жарылды ма?
Dialogue: 0,0:15:13.61,0:15:16.28,Default,,0,0,0,,О аяқталды.
Dialogue: 0,0:15:16.28,0:15:19.45,Default,,0,0,0,,Төрт мәре!
Dialogue: 0,0:15:19.45,0:15:22.95,Default,,0,0,0,,Танымал жауаптар. Бұл соңғы есептің сұрағы ➡
Dialogue: 0,0:15:22.95,0:15:26.95,Default,,0,0,0,,Төрт аяқтауды орындаңыз.
Dialogue: 0,0:15:26.95,0:15:30.29,Default,,0,0,0,,Осы уақытқа дейін шайқастар қалай шешілді...
Dialogue: 0,0:15:30.29,0:15:32.93,Default,,0,0,0,,Аяқтау➡
Dialogue: 0,0:15:32.93,0:15:35.80,Default,,0,0,0,,Серпінді аяқтау➡
Dialogue: 0,0:15:35.80,0:15:38.10,Default,,0,0,0,,Айналдыру аяқталуы.
Dialogue: 0,0:15:38.10,0:15:40.77,Default,,0,0,0,,Сонымен ұтылып қалсақ та, от әлі жанып тұрады.
Dialogue: 0,0:15:40.77,0:15:43.77,Default,,0,0,0,,Керемет! Марути - данышпан.
Dialogue: 0,0:15:43.77,0:15:48.44,Default,,0,0,0,,Хахаха, өтінемін. Мен ондай емеспін.
Dialogue: 0,0:15:48.44,0:15:50.44,Default,,0,0,0,,Керемет зона.
Dialogue: 0,0:15:50.44,0:15:55.92,Default,,0,0,0,,Бұл тіпті пайымдау. Сіз детективсіз бе?
Dialogue: 0,0:15:55.92,0:15:58.92,Default,,0,0,0,,Иә.
Dialogue: 0,0:15:58.92,0:16:03.12,Default,,0,0,0,,Жеті түсті көп! Жай өрмекші.
Dialogue: 0,0:16:03.12,0:16:05.13,Default,,0,0,0,,Аймақ. Бірақ➡
Dialogue: 0,0:16:05.13,0:16:07.13,Default,,0,0,0,,Тек шындыққа жету➡
Dialogue: 0,0:16:07.13,0:16:11.27,Default,,0,0,0,,Аймақ бұл соңғы мәселені шешкеніңізді білдірмейді.
Dialogue: 0,0:16:11.27,0:16:14.90,Default,,0,0,0,,көремін. Мен төрт мәреге жетуім керек.
Dialogue: 0,0:16:14.90,0:16:17.10,Default,,0,0,0,,Қалған мәре...
Dialogue: 0,0:16:17.10,0:16:19.91,Default,,0,0,0,,X!
Dialogue: 0,0:16:19.91,0:16:22.78,Default,,0,0,0,,​​Қалғанын маған қалдыр!
Dialogue: 0,0:16:22.78,0:16:27.11,Default,,0,0,0,,Егер сіз осы уақытқа дейін жеткен болсаңыз, Зонаны міндетті түрде тазартасыз!
Dialogue: 0,0:16:27.11,0:16:29.15,Default,,0,0,0,,🔊Дайын жиынтық!
Dialogue: 0,0:16:29.15,0:16:32.75,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:16:32.75,0:16:35.96,Default,,0,0,0,,Қой!
Dialogue: 0,0:16:42.96,0:16:44.93,Default,,0,0,0,,Zonamos House құрылғаннан бері➡
Dialogue: 0,0:16:44.93,0:16:47.10,Default,,0,0,0,,Бұл басқатырғышқа қарсы шыққан жүзушілер саны ➡
Dialogue: 0,0:16:47.10,0:16:50.61,Default,,0,0,0,,Зонада 1 миллионнан астам адам бар.
Dialogue: 0,0:16:50.61,0:16:56.61,Default,,0,0,0,,Зонада барлығы шығанақтың көптеген құпиялары мен мәселелеріне батып барады.
Dialogue: 0,0:16:56.61,0:16:59.11,Default,,0,0,0,,Бірақ балалар, Persona командасы ➡
Dialogue: 0,0:16:59.11,0:17:01.62,Default,,0,0,0,,Бір-біріне көмектесу, толықтыру➡
Dialogue: 0,0:17:01.62,0:17:07.29,Default,,0,0,0,,Ал Зона жұмбақтарды зерттеуге деген тойымсыз құштарлығымен осы күнге жетті.
Dialogue: 0,0:17:07.29,0:17:10.16,Default,,0,0,0,,Зонаның жетістіктері мақтауға тұрарлық.
Dialogue: 0,0:17:12.09,0:17:16.80,Default,,0,0,0,,Мен саған сен көрмеген нәрсені көрсетемін.
Dialogue: 0,0:17:16.80,0:17:23.44,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:17:23.44,0:17:25.61,Default,,0,0,0,,Көре алмайтын нәрсе жұмбақ.
Dialogue: 0,0:17:25.61,0:17:27.61,Default,,0,0,0,,Дәл X!
Dialogue: 0,0:17:27.61,0:17:32.75,Default,,0,0,0,,Құрметті тұлғалар, Зона бұл жұмбақты жеңеді!
Dialogue: 0,0:17:32.75,0:17:35.08,Default,,0,0,0,,X ашу!
Dialogue: 0,0:17:35.08,0:17:37.15,Default,,0,0,0,,Экстремалды сызықша!
Dialogue: 0,0:17:37.15,0:17:47.30,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:17:47.30,0:17:52.50,Default,,0,0,0,,Ең жақсы зона.
Dialogue: 0,0:17:59.77,0:18:01.78,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:18:01.78,0:18:03.78,Default,,0,0,0,,Мен керемет детективпін!
Dialogue: 0,0:18:03.78,0:18:06.25,Default,,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:18:08.65,0:18:11.09,Default,,0,0,0,,Жұмбақ шешу қызықты болды.
Dialogue: 0,0:18:11.09,0:18:13.09,Default,,0,0,0,,Сіз жұмбақты шешкен жоқсыз.
Dialogue: 0,0:18:13.09,0:18:16.99,Default,,0,0,0,,Ой, бірінші тазалау Бұл SNS-те қызу тақырыпқа айналуда.
Dialogue: 0,0:18:16.99,0:18:20.60,Default,,0,0,0,,Баршаңызға еңбектеріңіз үшін рахмет, Суфи.
Dialogue: 0,0:18:20.60,0:18:22.60,Default,,0,0,0,,Зонамос мырза.
Dialogue: 0,0:18:22.60,0:18:25.10,Default,,0,0,0,,Неліктен қайтадан сопы болып бара жатырсың?
Dialogue: 0,0:18:25.10,0:18:28.60,Default,,0,0,0,,Егер солай болса, бұл Зона. (2 адам) Уау!
Dialogue: 0,0:18:28.60,0:18:32.27,Default,,0,0,0,,Иә? иә? Эх!
Dialogue: 0,0:18:32.27,0:18:34.74,Default,,0,0,0,,Аймақ аймағы Аймақтық аймақ.
Dialogue: 0,0:18:34.74,0:18:39.28,Default,,0,0,0,,Құстың таңданған жүзі қанша көрсем де шедевр.
Dialogue: 0,0:18:39.28,0:18:42.78,Default,,0,0,0,,Сонда Зонамос мырза мен Суфи екі түрлі адамдар ма?
Dialogue: 0,0:18:42.78,0:18:46.32,Default,,0,0,0,,Дұрыс. Сопы сопы сопы.
Dialogue: 0,0:18:46.32,0:18:50.42,Default,,0,0,0,,Одан да Зона шынымен таң қалдырды.
Dialogue: 0,0:18:50.42,0:18:55.10,Default,,0,0,0,,Зона менің жұмбақ шебері ретіндегі ең жақсы сәтім болды.
Dialogue: 0,0:18:55.10,0:18:57.60,Default,,0,0,0,,Жұмбақ құрастырушы?
Dialogue: 0,0:18:57.60,0:19:02.77,Default,,0,0,0,,Наубайшы сияқты, солай ма? Жұмбақтарды жасайтын адам.
Dialogue: 0,0:19:02.77,0:19:05.61,Default,,0,0,0,,Сәлем. Құс-күн.
Dialogue: 0,0:19:05.61,0:19:09.91,Default,,0,0,0,,Бұл дүниедегі ең қызықсыз жұмбақ не деп ойлайсың?
Dialogue: 0,0:19:09.91,0:19:12.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:12.25,0:19:16.42,Default,,0,0,0,,Жауабы жоқ жұмбақ па?
Dialogue: 0,0:19:16.42,0:19:20.35,Default,,0,0,0,,Ой, дұрыс айтасың, Зона.
Dialogue: 0,0:19:20.35,0:19:25.29,Default,,0,0,0,,Жауабы жоқ жұмбақ енді жұмбақ деп аталмауы керек.
Dialogue: 0,0:19:25.29,0:19:28.26,Default,,0,0,0,,Егер сіз зерттеп, ойлансаңыз және қайта-қайта көріңіз➡
Dialogue: 0,0:19:28.26,0:19:32.27,Default,,0,0,0,,Зона бір күні шындыққа жетеді деген жұмбақ.
Dialogue: 0,0:19:32.27,0:19:36.44,Default,,0,0,0,,Шешетін жұмбақтарды жасайтын зоналар.
Dialogue: 0,0:19:36.44,0:19:40.11,Default,,0,0,0,,Сондықтан жұмбақ шеберлер ең бақытты➡
Dialogue: 0,0:19:40.11,0:19:43.78,Default,,0,0,0,,Мен көп еңбектенген жұмбақ шешіледі➡
Dialogue: 0,0:19:43.78,0:19:45.95,Default,,0,0,0,,Міне, Зона.
Dialogue: 0,0:19:45.95,0:19:49.08,Default,,0,0,0,,Сәлем, Зонамос мырза. Зона?
Dialogue: 0,0:19:49.08,0:19:52.59,Default,,0,0,0,,Зонамос мырза кәсіби қуықшы ма?
Dialogue: 0,0:19:52.59,0:19:55.76,Default,,0,0,0,,Не? Аймақтық аймақ.
Dialogue: 0,0:19:55.76,0:19:59.76,Default,,0,0,0,,Бұл жай ғана жұмбақ шебері, Зона.
Dialogue: 0,0:19:59.76,0:20:02.43,Default,,0,0,0,,Олай болса, жұмбақ әлі де қалады.
Dialogue: 0,0:20:02.43,0:20:06.93,Default,,0,0,0,,Сіз дәл қазір шайқаста оқ атпадыңыз.
Dialogue: 0,0:20:06.93,0:20:10.34,Default,,0,0,0,,Мен байсалды емеспін! ? А, күткендей ме?
Dialogue: 0,0:20:10.34,0:20:13.94,Default,,0,0,0,,Пазл шешуші ретінде сіз жай ғана түсіресіз➡
Dialogue: 0,0:20:13.94,0:20:17.11,Default,,0,0,0,,Мен шайқаста жеңуге тырысқан жоқпын.
Dialogue: 0,0:20:17.11,0:20:21.98,Default,,0,0,0,,Дегенмен, оның шынайы қабілеті көптеген кәсіби деңгейдегі ойыншылардан асып түсуі керек.
Dialogue: 0,0:20:21.98,0:20:26.42,Default,,0,0,0,,Солай емес пе? Зонамос мырза. Зона.
Dialogue: 0,0:20:26.42,0:20:30.26,Default,,0,0,0,,Зона тым көп сатып алды.
Dialogue: 0,0:20:30.26,0:20:33.16,Default,,0,0,0,,Сорегараши да шығанақ туралы байыпты.
Dialogue: 0,0:20:37.60,0:20:41.10,Default,,0,0,0,,Бұл жастық шақ. Бұл қайда?
Dialogue: 0,0:20:41.10,0:20:45.24,Default,,0,0,0,,Дұрыс, тазартсаң байлық та, атақ та болады.
Dialogue: 0,0:20:45.24,0:20:47.78,Default,,0,0,0,,Мен бірдеңе аламын ба?
Dialogue: 0,0:20:47.78,0:20:49.78,Default,,0,0,0,,Кешіріңіз сопы.
Dialogue: 0,0:20:49.78,0:20:52.78,Default,,0,0,0,,Байлық – жай ғана жай, сондықтан сопы.
Dialogue: 0,0:20:52.78,0:20:56.75,Default,,0,0,0,,Не? Бірақ атаққа жетуге болады.
Dialogue: 0,0:20:56.75,0:20:59.75,Default,,0,0,0,,Дәлірек айтқанда, Зона тапсырылды.
Dialogue: 0,0:20:59.75,0:21:02.76,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:21:02.76,0:21:07.43,Default,,0,0,0,,Зона бұған қарайды.
Dialogue: 0,0:21:07.43,0:21:10.43,Default,,0,0,0,,
Dialogue: 0,0:21:10.43,0:21:12.60,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:12.60,0:21:17.10,Default,,0,0,0,,Әй, құс! Нана... Нана... Бұл не!
Dialogue: 0,0:21:17.10,0:21:19.11,Default,,0,0,0,,Өйткені бұл үш адамға мүмкін емес еді➡
Dialogue: 0,0:21:19.11,0:21:21.78,Default,,0,0,0,,Мен көсем Құс-сама үшін сопымын.
Dialogue: 0,0:21:21.78,0:21:25.11,Default,,0,0,0,,Ех! Зона зона.
Dialogue: 0,0:21:25.11,0:21:28.65,Default,,0,0,0,,Зона таң қалған жүзді көргісі келді.
Dialogue: 0,0:21:28.65,0:21:31.69,Default,,0,0,0,,Сен істедің, Құс. Мен мұны істеген жоқпын!
Dialogue: 0,0:21:31.69,0:21:34.42,Default,,0,0,0,,Құс жақсы. Кәне, орныңды алайық!
Dialogue: 0,0:21:34.42,0:21:37.93,Default,,0,0,0,,Кездейсоқ нәрселерді айтпаңыз!
Dialogue: 0,0:21:39.93,0:21:44.77,Default,,0,0,0,,Аймақ аймағы....
Dialogue: 0,0:21:44.77,0:21:49.64,Default,,0,0,0,,Зонаның тұлғалары жаңадан келгендер болса да, жақсы Блейдерлер болды.
Dialogue: 0,0:21:49.64,0:21:54.44,Default,,0,0,0,,Бұл жолы Зона қиынырақ Бей жұмбағын дайындап, күтеді.
Dialogue: 0,0:21:54.44,0:21:57.28,Default,,0,0,0,,Аймақ?
Dialogue: 0,0:21:57.28,0:22:00.48,Default,,0,0,0,,Сәлем, қайырлы кеш.
Dialogue: 0,0:22:02.85,0:22:05.92,Default,,0,0,0,,Ашылмаған жұмбақтарды қуған жүрек.
Dialogue: 0,0:22:05.92,0:22:12.59,Default,,0,0,0,,Ал шексіз мақсатқа жету күші мен оған жетудің күші.
Dialogue: 0,0:22:12.59,0:22:14.60,Default,,0,0,0,,Некоама Зонамос.
Dialogue: 0,0:22:14.60,0:22:20.60,Default,,0,0,0,,Сіз де Noblesse Oblige алып жүрсіз.
Dialogue: 0,0:22:20.60,0:22:23.64,Default,,0,0,0,,Сен кімсің, Зона?
Dialogue: 0,0:22:23.64,0:22:30.11,Default,,0,0,0,,Менің міндетім Бейблейдті келесі кезеңге өткізу.
Dialogue: 0,0:22:30.11,0:22:34.08,Default,,0,0,0,,Сен екеуміз... жолдастармыз.
Dialogue: 0,0:22:35.58,0:22:41.58,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory