Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.10,0:00:04.77,Default,,0,0,0,,<X... Бұл мен әлі көрмеген нәрсе.
Dialogue: 0,0:00:04.77,0:00:09.14,Default,,0,0,0,,Максималды жеделдету бар Бейблейд ойынды одан да экстремалды етеді.
Dialogue: 0,0:00:09.14,0:00:12.81,Default,,0,0,0,,Бұл саусақтар жарыққа немесе қараңғыға тиіп тұр ма?
Dialogue: 0,0:00:12.81,0:00:16.45,Default,,0,0,0,,Бұл қолдар жеңісті немесе үмітсіздікті ұстай ма?
Dialogue: 0,0:00:16.45,0:00:19.45,Default,,0,0,0,,X қазірдің өзінде менің алдымда＞
Dialogue: 0,0:00:22.48,0:00:24.92,Default,,0,0,0,,Бейбаттлде жеңсем➡️
Dialogue: 0,0:00:24.92,0:00:28.09,Default,,0,0,0,,Персонаны қалдырыңыз.
Dialogue: 0,0:00:35.13,0:00:38.70,Default,,0,0,0,,Экстремалды сызықша! Дисекциялық үкім!
Dialogue: 0,0:00:45.31,0:00:49.95,Default,,0,0,0,,Хахахахаха! Мен жеңемін деп ойламадым➡️
Dialogue: 0,0:00:49.95,0:00:52.65,Default,,0,0,0,,Сіз бұл туралы аздап ойладыңыз ба?
Dialogue: 0,0:00:52.65,0:00:57.92,Default,,0,0,0,,Ресми ойындарда нөлдік ұтысы бар кішкентай шабақтардан жеңіліп қалуым мүмкін емес!
Dialogue: 0,0:01:00.12,0:01:03.93,Default,,0,0,0,,Сіз Extreme Dash-ті жем ретінде қолдандыңыз ба? ?
Dialogue: 0,0:01:06.66,0:01:09.46,Default,,0,0,0,,Шынайы мақсат - оны табанды шайқасқа жеткізу➡️
Dialogue: 0,0:01:09.46,0:01:11.43,Default,,0,0,0,,Айналдыру!
Dialogue: 0,0:01:14.44,0:01:16.61,Default,,0,0,0,,Hell Reaper Spin Finish.
Dialogue: 0,0:01:16.61,0:01:19.11,Default,,0,0,0,,Құс жеңеді!
Dialogue: 0,0:01:22.28,0:01:25.95,Default,,0,0,0,,Aix... тең түсті ме?
Dialogue: 0,0:01:25.95,0:01:32.65,Default,,0,0,0,,Ол... ол маған әдейі жеңіліп қалды.
Dialogue: 0,0:01:34.59,0:01:39.60,Default,,0,0,0,,Бұл жеңіс емес!
Dialogue: 0,0:01:42.13,0:01:45.80,Default,,0,0,0,,Жылама, Көсем, шіркін.
Dialogue: 0,0:01:45.80,0:01:50.17,Default,,0,0,0,,Ланц бізге көтерілуімізді сұрап тұр.
Dialogue: 0,0:01:50.17,0:01:54.21,Default,,0,0,0,,Алайда 100 ақ жұлдыз жиналғаны рас.
Dialogue: 0,0:01:54.21,0:01:59.65,Default,,0,0,0,,Егер солай болса, сіз тек таудың басына әділ және төртбұрышты түрде жетуіңіз керек.
Dialogue: 0,0:01:59.65,0:02:01.72,Default,,0,0,0,,(Смартфонның хабарландыру дыбысы)
Dialogue: 0,0:02:06.29,0:02:10.79,Default,,0,0,0,,Бізден басқа 100 ақ жұлдыз жинаған топ бар.
Dialogue: 0,0:04:00.97,0:04:03.27,Default,,0,0,0,,Уау.
Dialogue: 0,0:04:03.27,0:04:06.84,Default,,0,0,0,,Сіз кеше кешке дейін көп жұмыс істеген сияқтысыз.
Dialogue: 0,0:04:06.84,0:04:10.95,Default,,0,0,0,,Ал, аздап. Апыр-ай.
Dialogue: 0,0:04:10.95,0:04:13.62,Default,,0,0,0,,Неліктен ұйықтап жатқан сияқтысыз?
Dialogue: 0,0:04:13.62,0:04:17.52,Default,,0,0,0,,Осыны ойлай бастағанда қатты толқып, ұйықтай алмай қалдым.
Dialogue: 0,0:04:17.52,0:04:21.06,Default,,0,0,0,,Біз персонал және команданың адасушыларымыз.
Dialogue: 0,0:04:21.06,0:04:24.59,Default,,0,0,0,,Екі команда бір уақытта 100 ақ жұлдыз жинады, солай ма?
Dialogue: 0,0:04:24.59,0:04:28.13,Default,,0,0,0,,Хмм. Демек, бұл рас, солай ма?
Dialogue: 0,0:04:28.13,0:04:30.27,Default,,0,0,0,,Тікелей қарсыласу!
Dialogue: 0,0:04:30.27,0:04:32.30,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:04:32.30,0:04:36.47,Default,,0,0,0,,Қай команда Зодиакпен күресетінін шешу үшін матч ұйымдастырылатынына сенімдімін.
Dialogue: 0,0:04:36.47,0:04:38.97,Default,,0,0,0,,Хмм…. Жұлдызды шайқастың шарықтау шегі ретінде ➡️
Dialogue: 0,0:04:38.97,0:04:41.61,Default,,0,0,0,,Бірде-бір матч картасы осы сияқты қызықты емес.
Dialogue: 0,0:04:41.61,0:04:44.45,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:04:44.45,0:04:48.55,Default,,0,0,0,,Сондай бірдеңе болса да, Құс жақсы болар еді.
Dialogue: 0,0:04:48.55,0:04:51.29,Default,,0,0,0,,Жарайды. Осындай кездері➡️
Dialogue: 0,0:04:51.29,0:04:53.49,Default,,0,0,0,,Топ болып бір-біріңді қолдаңдар!
Dialogue: 0,0:04:57.19,0:04:59.46,Default,,0,0,0,,Қой!
Dialogue: 0,0:05:03.80,0:05:06.84,Default,,0,0,0,,《Көр, ойла, әрекет.
Dialogue: 0,0:05:06.84,0:05:12.01,Default,,0,0,0,,Мейден-санмен өткізілген арнайы дайындық сөзсіз нәтиже беруі керек еді.
Dialogue: 0,0:05:16.14,0:05:19.78,Default,,0,0,0,,《Бірақ Роджи Ланц менің барлық ойларымды алдын ала біледі➡️
Dialogue: 0,0:05:19.78,0:05:22.45,Default,,0,0,0,,Енді айналдыру арқылы Hell Reaper-тен жеңіліңіз➡️
Dialogue: 0,0:05:22.45,0:05:24.45,Default,,0,0,0,,Мен Бейді атып тастадым.
Dialogue: 0,0:05:24.45,0:05:28.42,Default,,0,0,0,,Мен оны байқамай да қалдым.
Dialogue: 0,0:05:28.42,0:05:30.93,Default,,0,0,0,,Тозақ Орақшысы!
Dialogue: 0,0:05:37.13,0:05:39.80,Default,,0,0,0,,《Қазіргі тозақ орағының төзімділігі➡️
Dialogue: 0,0:05:39.80,0:05:42.80,Default,,0,0,0,,Персей Дарктың қорғаныс күшіне ену мүмкін емес.
Dialogue: 0,0:05:42.80,0:05:46.68,Default,,0,0,0,,Олай болса, оны қалай жеңесің? 》
Dialogue: 0,0:05:49.28,0:05:52.61,Default,,0,0,0,,Өте бітті ➡️
Dialogue: 0,0:05:52.61,0:05:56.12,Default,,0,0,0,,Менің көшбасшым. Технологияның сонша айырмашылығы➡️
Dialogue: 0,0:05:56.12,0:05:58.29,Default,,0,0,0,,Маған көрсетілді.
Dialogue: 0,0:05:58.29,0:06:00.69,Default,,0,0,0,,Жүрегімде тыныш отыра алмаймын➡️
Dialogue: 0,0:06:00.69,0:06:02.69,Default,,0,0,0,,Менің ойымша, оған көмектесу мүмкін емес.
Dialogue: 0,0:06:02.69,0:06:05.63,Default,,0,0,0,,Егер бұл матчта пайдалы болмаса, мен оны сол жерде қалдырамын.
Dialogue: 0,0:06:05.63,0:06:08.23,Default,,0,0,0,,Менің пікірім өзгерген жоқ.
Dialogue: 0,0:06:10.30,0:06:12.47,Default,,0,0,0,,Сәлем! Апыр-ай! О, ой, ой.
Dialogue: 0,0:06:12.47,0:06:14.84,Default,,0,0,0,,Мен бүгін таңертеңнен бастап түсіріп жатырмын.
Dialogue: 0,0:06:14.84,0:06:18.51,Default,,0,0,0,,Әй, үзіліс ал. О...
Dialogue: 0,0:06:20.78,0:06:23.14,Default,,0,0,0,,О!
Dialogue: 0,0:06:23.14,0:06:26.45,Default,,0,0,0,,Жаңа тропикалық пицца сушиі.
Dialogue: 0,0:06:26.45,0:06:30.15,Default,,0,0,0,,Уау! суши? Әлде бұл пицца ма?
Dialogue: 0,0:06:30.15,0:06:33.42,Default,,0,0,0,,Әрине, бұл суши. Мен оны аламын!
Dialogue: 0,0:06:36.52,0:06:38.96,Default,,0,0,0,,Иә, бұл тамаша!
Dialogue: 0,0:06:38.96,0:06:43.80,Default,,0,0,0,,Мульчаны да жеме! Е... маған керегі жоқ.
Dialogue: 0,0:06:43.80,0:06:46.37,Default,,0,0,0,,《Персей Қараңғының бұл қорғаныс күші...
Dialogue: 0,0:06:46.37,0:06:51.11,Default,,0,0,0,,Егер сіз оны шыдамдылықпен жеңе алмасаңыз, оны шабуыл күшімен жеңуден басқа амалыңыз жоқ.
Dialogue: 0,0:06:51.11,0:06:54.01,Default,,0,0,0,,Егжей-тегжейлі шабуылдар арқылы күшіңізді азайтыңыз➡️
Dialogue: 0,0:06:54.01,0:06:58.08,Default,,0,0,0,,Соңғы соққыны экстремалды сызықшамен беріңіз.
Dialogue: 0,0:06:58.08,0:07:01.78,Default,,0,0,0,,Егер сіз Hell Reaper➡️ максималды өнімділігін көрсете алсаңыз
Dialogue: 0,0:07:01.78,0:07:04.79,Default,,0,0,0,,Мен бара аламын... иә? 》
Dialogue: 0,0:07:08.96,0:07:11.76,Default,,0,0,0,,А... сонда!
Dialogue: 0,0:07:14.46,0:07:17.47,Default,,0,0,0,,Мен сізден бір нәрсе сұрайын деп едім.
Dialogue: 0,0:07:19.97,0:07:21.97,Default,,0,0,0,,Ашық жер шығанағына қатысты.
Dialogue: 0,0:07:21.97,0:07:24.01,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:07:24.01,0:07:26.04,Default,,0,0,0,,Бұл туралы алаңдамаңыз. иә?
Dialogue: 0,0:07:26.04,0:07:29.44,Default,,0,0,0,,Оның әлсіз жақтары туралы айтқым келеді ме?
Dialogue: 0,0:07:29.44,0:07:33.45,Default,,0,0,0,,Мен өзімді ренжіткенім үшін жаман сезінемін. Келесі жолы міндетті түрде жеңемін➡️
Dialogue: 0,0:07:33.45,0:07:35.45,Default,,0,0,0,,Сізді итеріп жібергіңіз келе ме?
Dialogue: 0,0:07:35.45,0:07:37.62,Default,,0,0,0,,Көңілсіз болмаңыз!
Dialogue: 0,0:07:37.62,0:07:40.12,Default,,0,0,0,,Жоқ... бұл дұрыс емес.
Dialogue: 0,0:07:40.12,0:07:43.49,Default,,0,0,0,,Мен стратегиямның дұрыстығына көз жеткізгім келеді...
Dialogue: 0,0:07:43.49,0:07:46.36,Default,,0,0,0,,Бұзылу деген осы!
Dialogue: 0,0:07:46.36,0:07:48.70,Default,,0,0,0,,Сондықтан сіз жеңе алмайсыз!
Dialogue: 0,0:07:48.70,0:07:52.47,Default,,0,0,0,,Кенеттен не болды? Сәлем Тенка.
Dialogue: 0,0:07:52.47,0:07:54.94,Default,,0,0,0,,Балалар сендер де.
Dialogue: 0,0:07:54.94,0:07:57.84,Default,,0,0,0,,Бұл жігіт жеңілсе де, басқалары жеңсе жақсы.
Dialogue: 0,0:07:57.84,0:08:00.64,Default,,0,0,0,,Құстар баяу өсуі керек.
Dialogue: 0,0:08:00.64,0:08:04.15,Default,,0,0,0,,Бұл ұжымның ынталылығының нәтижесі.
Dialogue: 0,0:08:06.15,0:08:08.45,Default,,0,0,0,,Сондықтан қазір өзіңізді ойлап отырсыз!
Dialogue: 0,0:08:08.45,0:08:12.45,Default,,0,0,0,,Ол келесі жолы міндетті түрде жеңгісі келеді. сондықтан….
Dialogue: 0,0:08:12.45,0:08:15.39,Default,,0,0,0,,Неліктен сұрадың?
Dialogue: 0,0:08:15.39,0:08:18.26,Default,,0,0,0,,Не? Онда неге Лантц туралы айтып отырсың?
Dialogue: 0,0:08:18.26,0:08:20.30,Default,,0,0,0,,Менен сұрадыңыз.
Dialogue: 0,0:08:20.30,0:08:23.63,Default,,0,0,0,,Өйткені сіз тек ойлану арқылы жеңіске жететініңізге сенімді болмадыңыз, солай ма?
Dialogue: 0,0:08:23.63,0:08:26.80,Default,,0,0,0,,Өзіне сенімі жоқ пышақ ешқашан жеңе алмайды!
Dialogue: 0,0:08:26.80,0:08:30.47,Default,,0,0,0,,Мен сізге қазір матчқа қатысуға рұқсат бермеймін!
Dialogue: 0,0:08:30.47,0:08:36.64,Default,,0,0,0,,Эй...серігіңнің дауысы не болды?
Dialogue: 0,0:08:42.82,0:08:46.29,Default,,0,0,0,,Мен осындай сұмдық кішкентай балықты күткенім үшін ақымақ болдым.
Dialogue: 0,0:08:50.79,0:08:53.63,Default,,0,0,0,,А, қайда бара жатырсың?
Dialogue: 0,0:08:53.63,0:08:56.10,Default,,0,0,0,,Арнайы дайындық деп шешілді.
Dialogue: 0,0:08:56.10,0:09:00.10,Default,,0,0,0,,Мен бұл затты алғанша үйге бармаймын.
Dialogue: 0,0:09:00.10,0:09:02.14,Default,,0,0,0,,Тынышталыңыз.
Dialogue: 0,0:09:02.14,0:09:05.21,Default,,0,0,0,,Тіпті Misleaders-ке қарсы матч бар.
Dialogue: 0,0:09:07.28,0:09:09.28,Default,,0,0,0,,Құс!
Dialogue: 0,0:09:15.25,0:09:17.99,Default,,0,0,0,,Біз не істеуіміз керек? бұл….
Dialogue: 0,0:09:17.99,0:09:21.26,Default,,0,0,0,,Өйткені Тенка үнемі ауыр сөздер айтады. Хмф.
Dialogue: 0,0:09:23.36,0:09:26.13,Default,,0,0,0,,Құс Жылап отырып күлдім.
Dialogue: 0,0:09:26.13,0:09:29.30,Default,,0,0,0,,Иә? Жылап жатырсыз ба? Күлкі?
Dialogue: 0,0:09:29.30,0:09:31.30,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:09:31.30,0:09:36.17,Default,,0,0,0,,Құс мырза қуанған болуы керек.
Dialogue: 0,0:09:36.17,0:09:38.21,Default,,0,0,0,,Олар қарт адамды шынымен сынап жатыр
Dialogue: 0,0:09:38.21,0:09:41.98,Default,,0,0,0,,Тенка-сама маған қатты тиді.
Dialogue: 0,0:09:41.98,0:09:45.61,Default,,0,0,0,,Менің қазіргі өзіме ең жетіспейтін нәрсе➡️
Dialogue: 0,0:09:45.61,0:09:49.78,Default,,0,0,0,,Сіз нені тікелей көрсеттіңіз.
Dialogue: 0,0:09:49.78,0:09:52.92,Default,,0,0,0,,Құсқа ең көп жетпейтін нәрсе...
Dialogue: 0,0:09:52.92,0:09:56.09,Default,,0,0,0,,Сенімділік...?
Dialogue: 0,0:09:56.09,0:09:58.76,Default,,0,0,0,,Мен оны дерлік түсіндім.
Dialogue: 0,0:09:58.76,0:10:01.43,Default,,0,0,0,,Кешегі шайқас Сол уақытқа дейін.
Dialogue: 0,0:10:01.43,0:10:06.94,Default,,0,0,0,,Ол жігіт... Ланц шынымен де мен үшін артық нәрсе жасады.
Dialogue: 0,0:10:06.94,0:10:11.37,Default,,0,0,0,,Мен түсінгендей сезінемін. Мен түсінбейтін сияқтымын...
Dialogue: 0,0:10:11.37,0:10:14.11,Default,,0,0,0,,Сонымен, сіз Құспен бірге күрескіңіз келе ме?
Dialogue: 0,0:10:14.11,0:10:17.58,Default,,0,0,0,,Адал болыңыз. Хмф.
Dialogue: 0,0:10:17.58,0:10:20.01,Default,,0,0,0,,Иә, жоқ.
Dialogue: 0,0:10:20.01,0:10:23.45,Default,,0,0,0,,Алдымызда адасушыларға қарсы күреске назар аударайық.
Dialogue: 0,0:10:23.45,0:10:26.62,Default,,0,0,0,,О! Ой-ой!
Dialogue: 0,0:10:26.62,0:10:30.79,Default,,0,0,0,,Бірақ Құсты жалғыз қалдыру шынымен дұрыс па?
Dialogue: 0,0:10:30.79,0:10:32.76,Default,,0,0,0,,№.
Dialogue: 0,0:10:34.76,0:10:36.80,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:36.80,0:10:41.60,Default,,0,0,0,,Құсқа соңғы түзетулер мен оны Мейден мырзаға қалдырамын.
Dialogue: 0,0:10:41.60,0:10:45.61,Default,,0,0,0,,Сонымен, соңғы реттеу ➡️ болады
Dialogue: 0,0:10:45.61,0:10:48.61,Default,,0,0,0,,Shipboard Beyblade.
Dialogue: 0,0:10:48.61,0:10:50.61,Default,,0,0,0,,Неге! ?
Dialogue: 0,0:10:50.61,0:10:53.75,Default,,0,0,0,,Мұндай жерде Бейбатл өткізу мүмкін емес!
Dialogue: 0,0:10:53.75,0:10:57.75,Default,,0,0,0,,Ой... менің қолымнан келгені сол жерде тұру! ?
Dialogue: 0,0:10:57.75,0:11:01.12,Default,,0,0,0,,Сондықтан бұл жақсы. Апыр-ай! ?
Dialogue: 0,0:11:01.12,0:11:04.09,Default,,0,0,0,,Тұрақсыз жағдайда да дірілмейтін орнықты аяқтар➡️
Dialogue: 0,0:11:04.09,0:11:06.76,Default,,0,0,0,,Күшті өсінділер береді.
Dialogue: 0,0:11:06.76,0:11:11.77,Default,,0,0,0,,Сонымен қатар, сіз қиын жағдайда да шайқасқа шоғырлану қабілетін дамытасыз.
Dialogue: 0,0:11:11.77,0:11:14.44,Default,,0,0,0,,Және….
Dialogue: 0,0:11:14.44,0:11:17.61,Default,,0,0,0,,Hell Reaper жауап беру қабілетін жақсарту үшін➡️
Dialogue: 0,0:11:17.61,0:11:20.98,Default,,0,0,0,,Біз әр түрлі шығанақтарды жалға алдық.
Dialogue: 0,0:11:20.98,0:11:23.65,Default,,0,0,0,,Және одан әрі…. Одан да көп! ?
Dialogue: 0,0:11:25.78,0:11:28.28,Default,,0,0,0,,Бұл не? Сол шығанақ.
Dialogue: 0,0:11:28.28,0:11:32.25,Default,,0,0,0,,Акула шкаласы. Осы соңғы реттеу үшін➡️
Dialogue: 0,0:11:32.25,0:11:35.29,Default,,0,0,0,,Бұл Мульти мырзаның маған сеніп тапсырған шығанағы.
Dialogue: 0,0:11:35.29,0:11:38.96,Default,,0,0,0,,Құстың ақыл-ойын, дағдыларын және денесін бірден жаттықтырыңыз ➡️
Dialogue: 0,0:11:38.96,0:11:43.13,Default,,0,0,0,,Одан қолайлы арнайы дайындық жоқ.
Dialogue: 0,0:11:43.13,0:11:45.47,Default,,0,0,0,,Жұлдызды шайқастар➡️
Dialogue: 0,0:11:45.47,0:11:48.60,Default,,0,0,0,,Марути мырза ұйықтап жатқанда мұны жасауға уақытын аямады.
Dialogue: 0,0:11:48.60,0:11:50.61,Default,,0,0,0,,Уау.
Dialogue: 0,0:11:50.61,0:11:53.94,Default,,0,0,0,,Осы уақытқа дейін достарымның үмітін ақтап➡️
Dialogue: 0,0:11:53.94,0:11:56.71,Default,,0,0,0,,Мен жауап бермеймін, солай ма?
Dialogue: 0,0:12:03.35,0:12:07.12,Default,,0,0,0,,《Ол Бей өте қысқа.
Dialogue: 0,0:12:07.12,0:12:10.09,Default,,0,0,0,,Ол төменнен жасырынып кіріп, жарылуы керек.
Dialogue: 0,0:12:10.09,0:12:12.49,Default,,0,0,0,,Сонда мен...》
Dialogue: 0,0:12:12.49,0:12:15.10,Default,,0,0,0,,Уа... (Мейдо) Дайын жиынтық!
Dialogue: 0,0:12:15.10,0:12:18.43,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:12:18.43,0:12:21.60,Default,,0,0,0,,Қой!
Dialogue: 0,0:12:21.60,0:12:23.61,Default,,0,0,0,,О!
Dialogue: 0,0:12:29.11,0:12:31.15,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:12:31.15,0:12:33.78,Default,,0,0,0,,《Ақыр аяғында жарылуын мақсат ет. Осы қалпыңызда қалыңыз➡️
Dialogue: 0,0:12:33.78,0:12:35.95,Default,,0,0,0,,Егер мен Рэтчетті қорғай алсам...》
Dialogue: 0,0:12:35.95,0:12:38.29,Default,,0,0,0,,Төзімділік, тозақ орағы!
Dialogue: 0,0:12:38.29,0:12:41.19,Default,,0,0,0,,Жақсы стратегия. Бірақ...
Dialogue: 0,0:12:47.13,0:12:49.13,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:12:49.13,0:12:51.63,Default,,0,0,0,,Жеңдер, Тиран Азу!
Dialogue: 0,0:13:05.15,0:13:09.45,Default,,0,0,0,,Гах... Мен сенің сонша терең сүңгіп жатқаныңа сене алар емеспін!
Dialogue: 0,0:13:09.45,0:13:12.62,Default,,0,0,0,,Біз бұл төмен деңгейге жауап беруіміз керек.
Dialogue: 0,0:13:12.62,0:13:14.96,Default,,0,0,0,,Алайда...
Dialogue: 0,0:13:14.96,0:13:17.76,Default,,0,0,0,,Келесі жолы мен басқа шығанақты пайдалануым мүмкін.
Dialogue: 0,0:13:20.03,0:13:22.00,Default,,0,0,0,,Тоқта! (Ичи) Ә? Мұнда ма?
Dialogue: 0,0:13:36.78,0:13:40.31,Default,,0,0,0,,Аяқтау Мен жеңемін.
Dialogue: 0,0:13:40.31,0:13:42.85,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:13:42.85,0:13:45.39,Default,,0,0,0,,Хахаха….
Dialogue: 0,0:13:45.39,0:13:48.29,Default,,0,0,0,,Құс мырза, демалыңыз.
Dialogue: 0,0:13:50.29,0:13:52.49,Default,,0,0,0,,Қайталап көріңіз.
Dialogue: 0,0:13:56.80,0:13:58.77,Default,,0,0,0,,(шұңқырлар соқтығысқан дыбыс)
Dialogue: 0,0:13:58.77,0:14:01.64,Default,,0,0,0,,Бар, тозақ ораушы!
Dialogue: 0,0:14:01.64,0:14:06.31,Default,,0,0,0,,《Мен адасушылармен тікелей қарсыласуды барлығына қалдырдым.
Dialogue: 0,0:14:06.31,0:14:09.44,Default,,0,0,0,,Көр, ойла, әрекет ет.
Dialogue: 0,0:14:09.44,0:14:12.15,Default,,0,0,0,,Мен оны осында жақсы аламын! 》
Dialogue: 0,0:14:14.12,0:14:17.29,Default,,0,0,0,,Beyblade жаңалықтары!
Dialogue: 0,0:14:17.29,0:14:20.29,Default,,0,0,0,,Жұлдызды шайқаста 100 ақ жұлдыз жиналды➡️
Dialogue: 0,0:14:20.29,0:14:23.29,Default,,0,0,0,,Команда тұлғасы және топтың адасушылары.
Dialogue: 0,0:14:23.29,0:14:26.63,Default,,0,0,0,,Zodiac командасына➡️ шақыру құқығы үшін
Dialogue: 0,0:14:26.63,0:14:30.00,Default,,0,0,0,,Екі жақтың тікелей қақтығысуы жоспарланған.
Dialogue: 0,0:14:30.00,0:14:34.54,Default,,0,0,0,,Атауы - Super Summit Challenger турнирі!
Dialogue: 0,0:14:34.54,0:14:37.27,Default,,0,0,0,,Бұл әлі де біртүрлі.
Dialogue: 0,0:14:37.27,0:14:41.44,Default,,0,0,0,,Бұл не, Zero Go мырза? Persona командасы.
Dialogue: 0,0:14:41.44,0:14:45.61,Default,,0,0,0,,Жаңылушылардан 10-нан астам жұлдызды жоғалтқанына қарамастан➡️
Dialogue: 0,0:14:45.61,0:14:47.78,Default,,0,0,0,,Бұл үлкен секіріс! (Құлпынай) Шынымен➡️
Dialogue: 0,0:14:47.78,0:14:50.28,Default,,0,0,0,,Тікелей эфирсіз болды➡️
Dialogue: 0,0:14:50.28,0:14:52.69,Default,,0,0,0,,Бейдің көптеген жанкүйерлері таң қалған сияқты.
Dialogue: 0,0:14:52.69,0:14:55.62,Default,,0,0,0,,Бұл сәнді тосынсый ма? ? Сондай-ақ ➡️
Dialogue: 0,0:14:55.62,0:14:58.13,Default,,0,0,0,,Бұл Зодиак шайқасы бар стратегия ма?
Dialogue: 0,0:14:58.13,0:15:00.96,Default,,0,0,0,,Ойлап қарасам, біреудің жаңа шығанағы әлі бар➡️
Dialogue: 0,0:15:00.96,0:15:03.13,Default,,0,0,0,,Ол ашылған жоқ.
Dialogue: 0,0:15:03.13,0:15:06.93,Default,,0,0,0,,Ой! Мұны болашақ қызық үшін сақтап қояйық!
Dialogue: 0,0:15:06.93,0:15:10.14,Default,,0,0,0,,Super summit challenger сайысы бір аптадан кейін өтеді.
Dialogue: 0,0:15:10.14,0:15:14.28,Default,,0,0,0,,Ол X Tower-те өтеді! (Zero Go) Қызу шайқас ➡️
Dialogue: 0,0:15:14.28,0:15:16.78,Default,,0,0,0,,Бізбен бірге болыңыз!
Dialogue: 0,0:15:16.78,0:15:19.45,Default,,0,0,0,,Ммм... Роджи Ланцпен болған оқиға➡️
Dialogue: 0,0:15:19.45,0:15:22.62,Default,,0,0,0,,Ол мұқият жасырылған сияқты.
Dialogue: 0,0:15:22.62,0:15:24.99,Default,,0,0,0,,Оның үстіне жұмбақ етіп тарату арқылы➡️
Dialogue: 0,0:15:24.99,0:15:27.29,Default,,0,0,0,,Қоғамдық күтуді өршітті.
Dialogue: 0,0:15:27.29,0:15:31.43,Default,,0,0,0,,Зодиак балалары бұл маған ұнамайды.
Dialogue: 0,0:15:31.43,0:15:35.30,Default,,0,0,0,,Мүмкін, бірақ Омеганың бұл мәселеге қатысы жоқ.
Dialogue: 0,0:15:35.30,0:15:38.63,Default,,0,0,0,,Ланц мұны өз бетімен жасады.
Dialogue: 0,0:15:38.63,0:15:40.60,Default,,0,0,0,,Анау сəйкес келетін сорғыш жігіт➡️
Dialogue: 0,0:15:40.60,0:15:43.64,Default,,0,0,0,,Ол алдын ала шайқас кезінде маған фольга кигізбек болды.
Dialogue: 0,0:15:43.64,0:15:47.44,Default,,0,0,0,,Бәсекелестік ретінде бәрі танитын команданы жеңсек➡️
Dialogue: 0,0:15:47.44,0:15:51.95,Default,,0,0,0,,Бұл әлемге Зодиак ең күшті екенін білуге мүмкіндік береді.
Dialogue: 0,0:15:51.95,0:15:54.88,Default,,0,0,0,,Super sammit қарсыластарының шайқасы...
Dialogue: 0,0:15:54.88,0:15:58.62,Default,,0,0,0,,Бұл қорқынышты сахнада қорқынышты.
Dialogue: 0,0:15:58.62,0:16:00.62,Default,,0,0,0,,Бірақ мұны істеуден басқа амалым жоқ.
Dialogue: 0,0:16:00.62,0:16:05.03,Default,,0,0,0,,Дұрыс, бізді бардшылар басқарып қалды.
Dialogue: 0,0:16:05.03,0:16:09.73,Default,,0,0,0,,Иә, Құстың кек алу кезеңі, мен міндетті түрде жеңемін!
Dialogue: 0,0:16:12.30,0:16:14.44,Default,,0,0,0,,Куинн күткендей.
Dialogue: 0,0:16:14.44,0:16:18.94,Default,,0,0,0,,Persona командасы кеңес бергендей келді.
Dialogue: 0,0:16:18.94,0:16:22.38,Default,,0,0,0,,Мені қуып жету үшін қандай тактика қолдандың?
Dialogue: 0,0:16:22.38,0:16:27.45,Default,,0,0,0,,Маған да қызық, неге эфирге бермеді. Кекеке...
Dialogue: 0,0:16:27.45,0:16:33.45,Default,,0,0,0,,Расында, бұл қандай сиқыр? Хехе...
Dialogue: 0,0:16:35.46,0:16:37.63,Default,,0,0,0,,Сені жақсы құшақтай алғаным қандай жақсы.
Dialogue: 0,0:16:37.63,0:16:39.63,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:16:39.63,0:16:42.80,Default,,0,0,0,,Бұл B4. Челленджер шешуші матч.
Dialogue: 0,0:16:42.80,0:16:45.30,Default,,0,0,0,,Сіз өте ұйымшылсыз, солай емес пе?
Dialogue: 0,0:16:45.30,0:16:48.44,Default,,0,0,0,,Ол кісілер кассада толқығанша➡️
Dialogue: 0,0:16:48.44,0:16:50.44,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:16:50.44,0:16:52.44,Default,,0,0,0,,Жас ханым табысқа жете ме?
Dialogue: 0,0:16:52.44,0:16:55.94,Default,,0,0,0,,Сіз қалай ойлайсыз? Бірақ...
Dialogue: 0,0:16:55.94,0:17:00.11,Default,,0,0,0,,Кім келсе де, олар Омега-саманың жауы емес.
Dialogue: 0,0:17:00.11,0:17:38.42,Default,,0,0,0,,🎵～
Dialogue: 0,0:17:40.79,0:17:43.09,Default,,0,0,0,,WhatsApp Барлығына!
Dialogue: 0,0:17:43.09,0:17:46.46,Default,,0,0,0,,Бұл күн де келді!
Dialogue: 0,0:17:46.46,0:17:50.80,Default,,0,0,0,,Super Summit Challenger турнирі ақыры басталды!
Dialogue: 0,0:17:50.80,0:17:53.10,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:53.10,0:17:55.97,Default,,0,0,0,,Күтпеген жерден Slash Tower Solidus Tower-ке жатады ➡️
Dialogue: 0,0:17:55.97,0:17:58.61,Default,,0,0,0,,Бұл матч командалар арасындағы тартыс болды!
Dialogue: 0,0:17:58.61,0:18:03.95,Default,,0,0,0,,Жұлдызды шайқастың соңы үшін өте қолайлы ерекше шайқас көретін сияқтымыз!
Dialogue: 0,0:18:03.95,0:18:06.78,Default,,0,0,0,,Сіз бізге қолдау көрсетуге дайынсыз ба?
Dialogue: 0,0:18:06.78,0:18:10.25,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:13.85,0:18:17.86,Default,,0,0,0,,Қош келдіңіздер.
Dialogue: 0,0:18:20.13,0:18:23.10,Default,,0,0,0,,Үш басты Ранц Миллион….
Dialogue: 0,0:18:23.10,0:18:26.10,Default,,0,0,0,,Біраз уақыт болды, Тенка-сама.
Dialogue: 0,0:18:26.10,0:18:28.60,Default,,0,0,0,,Қалайсың? Эй?
Dialogue: 0,0:18:28.60,0:18:31.44,Default,,0,0,0,,Ол кісі де бұрынғы Хакусей-рю ме?
Dialogue: 0,0:18:31.44,0:18:36.31,Default,,0,0,0,,Түпнұсқа емес. Біз Хакусей-рюмыз.
Dialogue: 0,0:18:36.31,0:18:40.88,Default,,0,0,0,,Ол жігіттер тіпті шәкірттерінің ішінде ең дарындылардың қатарында болды➡️
Dialogue: 0,0:18:40.88,0:18:44.45,Default,,0,0,0,,Ол Омегамен бірге Хакусейрюге опасыздық жасады.
Dialogue: 0,0:18:44.45,0:18:47.29,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:18:47.29,0:18:50.29,Default,,0,0,0,,Бұл сатқындық емес. Біз бастапқыда➡️
Dialogue: 0,0:18:50.29,0:18:53.76,Default,,0,0,0,,Мен Хакусей-рюге қосылдым, себебі мен Омега-самаға тәнті болдым.
Dialogue: 0,0:18:55.76,0:19:00.13,Default,,0,0,0,,Біз де бүгінгі матчты тамашалайтын боламыз.
Dialogue: 0,0:19:00.13,0:19:05.61,Default,,0,0,0,,О? Бір ойыншы жетіспейтін сияқты.
Dialogue: 0,0:19:05.61,0:19:08.71,Default,,0,0,0,,Аа, бар күшіңізді салыңыз.
Dialogue: 0,0:19:10.81,0:19:15.28,Default,,0,0,0,,Сәлеметсіз бе. (Есіктің ашылу және жабылу дыбысы)
Dialogue: 0,0:19:18.82,0:19:22.29,Default,,0,0,0,,Ал, сабыр етіңіз.
Dialogue: 0,0:19:22.29,0:19:24.33,Default,,0,0,0,,Хакубоширю туралы бәрі осылай дейді! ?
Dialogue: 0,0:19:24.33,0:19:26.83,Default,,0,0,0,,Оны жоққа шығарма, кеттік.
Dialogue: 0,0:19:26.83,0:19:29.63,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:19:29.63,0:19:34.04,Default,,0,0,0,,Жарайсыңдар, көп күткендеріңізге рахмет!
Dialogue: 0,0:19:34.04,0:19:39.14,Default,,0,0,0,,Бүгін басты кейіпкер болатын екі команда пайда болсын!
Dialogue: 0,0:19:39.14,0:19:44.98,Default,,0,0,0,,Бірінші болып Slash Tower-тен Team Persona! (қуаныш)
Dialogue: 0,0:19:44.98,0:19:48.98,Default,,0,0,0,,Бүгін бізді қандай шайқас қызықтырады? ?
Dialogue: 0,0:19:48.98,0:19:54.29,Default,,0,0,0,,Келесіде Solidus Tower командасының көшбасшылары!
Dialogue: 0,0:19:54.29,0:19:56.29,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:56.29,0:19:58.49,Default,,0,0,0,,Өзінің айнымас күшімен➡️
Dialogue: 0,0:19:58.49,0:20:02.36,Default,,0,0,0,,Таудың басына шығу құқығына ие боласыз ба? ?
Dialogue: 0,0:20:02.36,0:20:04.40,Default,,0,0,0,,Хмм?
Dialogue: 0,0:20:04.40,0:20:06.80,Default,,0,0,0,,Енді ойлап қарасам, міне Құс Казами ➡️
Dialogue: 0,0:20:06.80,0:20:09.14,Default,,0,0,0,,Жоқ, бірақ... түсінемін!
Dialogue: 0,0:20:09.14,0:20:13.17,Default,,0,0,0,,Менсіз де Персона жеңіле алмайды.
Dialogue: 0,0:20:13.17,0:20:17.24,Default,,0,0,0,,Жұмбақ көшбасшылар, бір топ адамдар сияқты әртүрлі заттардың жинағы ➡️
Dialogue: 0,0:20:17.24,0:20:22.95,Default,,0,0,0,,Сонымен! Үлкен ауыз аңызынан бері біраз уақыт өтті!
Dialogue: 0,0:20:22.95,0:20:26.12,Default,,0,0,0,,Қарасу халқы сұмдық.
Dialogue: 0,0:20:26.12,0:20:30.29,Default,,0,0,0,,Біз Зодиакпен➡️ жеңуге тырысамыз
Dialogue: 0,0:20:30.29,0:20:32.46,Default,,0,0,0,,Біз топ құрып жатырмыз.
Dialogue: 0,0:20:32.46,0:20:35.30,Default,,0,0,0,,Менің ойымша. Солай ма?
Dialogue: 0,0:20:35.30,0:20:38.40,Default,,0,0,0,,Kamen X ойыншылары үшін түсіндірейін➡️
Dialogue: 0,0:20:38.40,0:20:43.64,Default,,0,0,0,,Жұмбақ көшбасшылар Зодиактан кек алуға құмар ойыншылар тобынан құрылған➡️
Dialogue: 0,0:20:43.64,0:20:46.01,Default,,0,0,0,,Біз еріктілер командасымыз.
Dialogue: 0,0:20:46.01,0:20:49.14,Default,,0,0,0,,Дұрыс, біз ➡️
Dialogue: 0,0:20:49.14,0:20:52.95,Default,,0,0,0,,Біреуге ұқсау, ойнау немесе отбасылық ұрыс-керіс➡️
Dialogue: 0,0:20:52.95,0:20:55.48,Default,,0,0,0,,Бұл жерде тұру қорқынышты.
Dialogue: 0,0:20:55.48,0:21:00.45,Default,,0,0,0,,Толық жеңілу... Сондай қорлау ➡️
Dialogue: 0,0:21:00.45,0:21:04.83,Default,,0,0,0,,Мен бұның дәмін татып көрмеппін.
Dialogue: 0,0:21:04.83,0:21:08.00,Default,,0,0,0,,((Омега: Мен сізге күресуге мүмкіндік беремін.
Dialogue: 0,0:21:08.00,0:21:11.50,Default,,0,0,0,,Барлығымыздан Варава ең мықты➡️
Dialogue: 0,0:21:11.50,0:21:13.47,Default,,0,0,0,,Қарсылық білдірмеңіз))
Dialogue: 0,0:21:15.67,0:21:19.74,Default,,0,0,0,,Бір қадам қалғанда құлауға шыдай алмаймын.
Dialogue: 0,0:21:22.14,0:21:25.11,Default,,0,0,0,,Мен сенің жеңісіңді қалаймын.
Dialogue: 0,0:21:28.15,0:21:33.22,Default,,0,0,0,,Әй... Екеуінің арасында ұшқын ұшып бара жатқан сияқты!
Dialogue: 0,0:21:33.22,0:21:36.82,Default,,0,0,0,,Мен де міндетті түрде Бейбатл сұраймын!
Dialogue: 0,0:21:36.82,0:21:42.13,Default,,0,0,0,,Кохон! Енді ережелерді тағы да түсіндірейік.
Dialogue: 0,0:21:42.13,0:21:44.80,Default,,0,0,0,,Енді жұлдыздарға бәс тігудің қажеті жоқ➡️
Dialogue: 0,0:21:44.80,0:21:47.47,Default,,0,0,0,,Бұл өте қарапайым.
Dialogue: 0,0:21:47.47,0:21:50.87,Default,,0,0,0,,Бірінші, екінші және үшінші ретпен шайқас➡️
Dialogue: 0,0:21:50.87,0:21:55.11,Default,,0,0,0,,Екі ойында бірінші жеңіске жеткен команда жеңеді.
Dialogue: 0,0:21:55.11,0:21:57.65,Default,,0,0,0,,Бірінші пышақ Алдыңғы.
Dialogue: 0,0:21:57.65,0:21:59.98,Default,,0,0,0,,Барсам болады ма? Сіз бара аласыз! ?
Dialogue: 0,0:21:59.98,0:22:02.52,Default,,0,0,0,,А, иә, иә. Өзіңізге ұнайтын нәрсені жасаңыз.
Dialogue: 0,0:22:02.52,0:22:04.62,Default,,0,0,0,,Hyahoo!
Dialogue: 0,0:22:04.62,0:22:07.99,Default,,0,0,0,,Шайқас шайқасы!
Dialogue: 0,0:22:07.99,0:22:11.99,Default,,0,0,0,,Екінші жағы - маска киген Х-хан.
Dialogue: 0,0:22:11.99,0:22:16.26,Default,,0,0,0,,Бүгін де сізден көмек сұраймын. Кекеке….
Dialogue: 0,0:22:22.64,0:22:26.14,Default,,0,0,0,,Бетперде киген Х Бір рет Онишимен➡️
Dialogue: 0,0:22:26.14,0:22:29.94,Default,,0,0,0,,Көмек сұрауды ойладым.
Dialogue: 0,0:22:29.94,0:22:34.42,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:22:35.92,0:22:41.92,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory