Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.13,0:00:05.53,Default,,0,0,0,,<Х... Адамдарды қызықтыратын нәрсе.
Dialogue: 0,0:00:05.53,0:00:09.10,Default,,0,0,0,,Бейблейд ойын ма? Бұл спорт па?
Dialogue: 0,0:00:09.10,0:00:12.44,Default,,0,0,0,,X➡-тің ең үлкен үдеуі
Dialogue: 0,0:00:12.44,0:00:16.45,Default,,0,0,0,,Экстремалды ойын.
Dialogue: 0,0:00:16.45,0:00:20.12,Default,,0,0,0,,X сіздің қолыңызда＞
Dialogue: 0,0:00:20.12,0:00:52.95,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:00:52.95,0:00:56.99,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:00:56.99,0:01:01.76,Default,,0,0,0,,🎤 (Zero Go) экстремалды сызықша жарылысы!
Dialogue: 0,0:01:04.56,0:01:06.66,Default,,0,0,0,,🎤Ерекше мәре!
Dialogue: 0,0:01:06.66,0:01:11.73,Default,,0,0,0,,🎤Осы сәтте алғашқы X Tower чемпионы дүниеге келді!
Dialogue: 0,0:01:11.73,0:01:13.70,Default,,0,0,0,,🎤Кім барлық қуықтардың басында тұрды➡
Dialogue: 0,0:01:13.70,0:01:18.51,Default,,0,0,0,,Рюгу Хром басқаратын Pendragon командасы!
Dialogue: 0,0:01:18.51,0:01:20.48,Default,,0,0,0,,🎤Барлық шайқастар жеңіліссіз!
Dialogue: 0,0:01:20.48,0:01:22.91,Default,,0,0,0,,🎤Ол есім аңызға айналады.
Dialogue: 0,0:01:22.91,0:01:24.85,Default,,0,0,0,,🎤Бұл X Tower.
Dialogue: 0,0:01:24.85,0:01:29.22,Default,,0,0,0,,Кәсіби мамандарға толы ең жақсы Бейбатл басталғалы тұр!
Dialogue: 0,0:03:15.12,0:03:18.43,Default,,0,0,0,,Уау! О!
Dialogue: 0,0:03:18.43,0:03:23.43,Default,,0,0,0,,Міне, осында! X қаласы!
Dialogue: 0,0:03:28.94,0:03:31.44,Default,,0,0,0,,Керемет қала!
Dialogue: 0,0:03:31.44,0:03:34.78,Default,,0,0,0,,Бұл Бладерс аңсайтын қасиетті жер!
Dialogue: 0,0:03:34.78,0:03:37.28,Default,,0,0,0,,Мен міндетті түрде кәсіпқой боламын!
Dialogue: 0,0:03:37.28,0:03:41.28,Default,,0,0,0,,Биікке ұмтыл! X мұнарасын бағындырыңыз!
Dialogue: 0,0:03:41.28,0:03:43.95,Default,,0,0,0,,Құс әрқашан өзіне сенімді.
Dialogue: 0,0:03:43.95,0:03:48.12,Default,,0,0,0,,Мен оны асыға күтемін! Ол біздің көшбасшымыз!
Dialogue: 0,0:03:48.12,0:03:51.13,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:03:51.13,0:03:53.46,Default,,0,0,0,,Кәсіби іріктеу матчтарына қалай қатысуға болады➡
Dialogue: 0,0:03:53.46,0:03:56.77,Default,,0,0,0,,Алдымен мен әуесқойлар матчтарында жеңіске жетуім керек...
Dialogue: 0,0:03:56.77,0:03:59.60,Default,,0,0,0,,Енді барып, кірейік!
Dialogue: 0,0:03:59.60,0:04:04.71,Default,,0,0,0,,Өткізу орны қай жерде? X City автобусы...
Dialogue: 0,0:04:04.71,0:04:07.71,Default,,0,0,0,,Жүгірейік! (2 адам) Ех! ?
Dialogue: 0,0:04:07.71,0:04:10.95,Default,,0,0,0,,Бұл да кәсіби маман болу үшін арнайы дайындық!
Dialogue: 0,0:04:10.95,0:04:13.82,Default,,0,0,0,,Әрқашан осылай.
Dialogue: 0,0:04:13.82,0:04:18.45,Default,,0,0,0,,(Адамдар сөйлейді)
Dialogue: 0,0:04:18.45,0:04:21.46,Default,,0,0,0,,Бұл әуесқойлар сайысы өтетін орын ма?
Dialogue: 0,0:04:21.46,0:04:25.13,Default,,0,0,0,,Мен жазба жасадым. Осыдан кейін көп ұзамай!
Dialogue: 0,0:04:25.13,0:04:27.53,Default,,0,0,0,,Сіз ештеңе дайындай алмайсыз!
Dialogue: 0,0:04:27.53,0:04:29.63,Default,,0,0,0,,Мен барлық дайындықтарды жасадым!
Dialogue: 0,0:04:29.63,0:04:33.30,Default,,0,0,0,,Мен соңғы бір айда қанды арнайы жаттығулар жасадым.
Dialogue: 0,0:04:33.30,0:04:36.30,Default,,0,0,0,,Мен сізге сол күш-жігердің нәтижесін көрсетемін!
Dialogue: 0,0:04:36.30,0:04:38.81,Default,,0,0,0,,Жарайды, қарсылас әуесқой.
Dialogue: 0,0:04:38.81,0:04:41.68,Default,,0,0,0,,Құстың қабілетімен сіз оны төлей аласыз!
Dialogue: 0,0:04:43.98,0:04:48.65,Default,,0,0,0,,🎤Баршаңызға Whatsapp! Бұл әуесқойлар алаңы!
Dialogue: 0,0:04:48.65,0:04:52.15,Default,,0,0,0,,🎤Егер ұтсаңыз, кәсіби маман боласыз! Бұл шын мәнінде табысқа апаратын қақпа!
Dialogue: 0,0:04:52.15,0:04:56.46,Default,,0,0,0,,🎤Әр блокта қызу шайқас жүріп жатыр!
Dialogue: 0,0:04:56.46,0:05:00.86,Default,,0,0,0,,Қолдау дауыстары бірінен соң бірі келіп жатыр!
Dialogue: 0,0:05:00.86,0:05:04.47,Default,,0,0,0,,Көк бұрыш Альбатрос шабуылшылары.
Dialogue: 0,0:05:04.47,0:05:07.64,Default,,0,0,0,,Бірінші жүзік – Казами құсы.
Dialogue: 0,0:05:07.64,0:05:10.94,Default,,0,0,0,,Қызыл бұрыш…. Мен бұл шайқасты күттім!
Dialogue: 0,0:05:14.64,0:05:17.15,Default,,0,0,0,,Фаланкс командасы.
Dialogue: 0,0:05:17.15,0:05:20.65,Default,,0,0,0,,Бұл матч Біздің команда бір-бірімен ойнайды.
Dialogue: 0,0:05:23.45,0:05:25.95,Default,,0,0,0,,Phalanx – кәсіби команда...
Dialogue: 0,0:05:25.95,0:05:28.62,Default,,0,0,0,,Неліктен әуесқой жекпе-жек?
Dialogue: 0,0:05:28.62,0:05:31.99,Default,,0,0,0,,Соңғы уақытта Blader деңгейі төмендеп барады.
Dialogue: 0,0:05:31.99,0:05:36.06,Default,,0,0,0,,X Tower – Бейблейд шайқастарының шыңы.
Dialogue: 0,0:05:36.06,0:05:37.97,Default,,0,0,0,,Оның қадір-қасиетін сақтау➡
Dialogue: 0,0:05:37.97,0:05:42.60,Default,,0,0,0,,Біз пышақтарды таңдаймыз.
Dialogue: 0,0:05:42.60,0:05:44.81,Default,,0,0,0,,Сұрыптау...
Dialogue: 0,0:05:44.81,0:05:46.94,Default,,0,0,0,,Бұл жаңадан келген ойыншы.
Dialogue: 0,0:05:46.94,0:05:48.98,Default,,0,0,0,,Сәтсіздік, балалар.
Dialogue: 0,0:05:48.98,0:05:52.98,Default,,0,0,0,,Мен бұл жаңа ойыншыларды басу туралы ма білмеймін, бірақ жеңіп алсаң жақсы болады деп ойлаймын!
Dialogue: 0,0:05:52.98,0:05:56.45,Default,,0,0,0,,Мен де осы күнге арнайы дайындалдым!
Dialogue: 0,0:05:56.45,0:06:00.46,Default,,0,0,0,,Иә! Қандай кәсіпқой! Өз дағдыларыңызды көрсетіңіз!
Dialogue: 0,0:06:00.46,0:06:02.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:02.46,0:06:05.29,Default,,0,0,0,,Жеңіс! Жеңіп, кәсіпқой бол!
Dialogue: 0,0:06:05.29,0:06:07.46,Default,,0,0,0,,Hmph….
Dialogue: 0,0:06:07.46,0:06:10.37,Default,,0,0,0,,Олай болса, Albatros Strikers командасы➡
Dialogue: 0,0:06:10.37,0:06:12.40,Default,,0,0,0,,Kazami Bird қарсы.➡
Dialogue: 0,0:06:12.40,0:06:14.27,Default,,0,0,0,,Фаланкс командасы Такуми Ишияма!
Dialogue: 0,0:06:14.27,0:06:16.44,Default,,0,0,0,,Бірінші шайқас!
Dialogue: 0,0:06:16.44,0:06:20.31,Default,,0,0,0,,Өтінемін, досым!
Dialogue: 0,0:06:20.31,0:06:23.98,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:06:23.98,0:06:27.95,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:06:27.95,0:06:30.32,Default,,0,0,0,,Қой!
Dialogue: 0,0:06:30.32,0:06:32.32,Default,,0,0,0,,Ухммм… ммм…
Dialogue: 0,0:06:36.19,0:06:39.19,Default,,0,0,0,,Strike Hawk!
Dialogue: 0,0:06:43.80,0:06:45.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:45.83,0:06:49.14,Default,,0,0,0,,Стоун Монблан аяқталды!
Dialogue: 0,0:06:49.14,0:06:51.27,Default,,0,0,0,,Такуми Ишияма жеңді!
Dialogue: 0,0:06:51.27,0:06:53.64,Default,,0,0,0,,Лезде өлім...
Dialogue: 0,0:06:53.64,0:06:57.31,Default,,0,0,0,,Менің шабуылшым...
Dialogue: 0,0:06:57.31,0:06:59.98,Default,,0,0,0,,Бір айлық арнайы дайындық дедіңіз бе?
Dialogue: 0,0:06:59.98,0:07:05.89,Default,,0,0,0,,Күлдірме... Мен соңғы 10 жыл бойы арнайы дайындықпен айналыстым.
Dialogue: 0,0:07:05.89,0:07:07.89,Default,,0,0,0,,Аа….
Dialogue: 0,0:07:10.96,0:07:14.00,Default,,0,0,0,,Не?
Dialogue: 0,0:07:14.00,0:07:16.77,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:07:16.77,0:07:20.44,Default,,0,0,0,,Уау! !
Dialogue: 0,0:07:20.44,0:07:23.77,Default,,0,0,0,,Мамандарды сынамаңыз.
Dialogue: 0,0:07:23.77,0:07:25.81,Default,,0,0,0,,Шығу.
Dialogue: 0,0:07:25.81,0:07:29.11,Default,,0,0,0,,Бейге қайта тиісуге рұқсат етілмейді.
Dialogue: 0,0:07:29.11,0:07:31.98,Default,,0,0,0,,Albatros Strikers мерзімінен бұрын шығуға байланысты➡
Dialogue: 0,0:07:31.98,0:07:34.02,Default,,0,0,0,,Phalanx командасы жеңді!
Dialogue: 0,0:07:34.02,0:07:35.95,Default,,0,0,0,,Не істеп жатырсың! Сен не істеп жатырсың!
Dialogue: 0,0:07:35.95,0:07:39.62,Default,,0,0,0,,🎤 Көрермендердің ашулы және көңілсіз пікірлері!
Dialogue: 0,0:07:39.62,0:07:41.62,Default,,0,0,0,,🎤Мен көңілім қалды.
Dialogue: 0,0:07:41.62,0:07:46.03,Default,,0,0,0,,Не? Команда таратылды ма?
Dialogue: 0,0:07:46.03,0:07:50.60,Default,,0,0,0,,Неліктен кенеттен? Мен мұны бүгінгі жеңілістен кейін түсіндім.
Dialogue: 0,0:07:50.60,0:07:52.93,Default,,0,0,0,,Маған кәсіпқой болу мүмкін емес.
Dialogue: 0,0:07:52.93,0:07:56.60,Default,,0,0,0,,Сіз берілмейсіз бе? Сіз шыңға шығуыңыз керек емес пе?
Dialogue: 0,0:07:56.60,0:07:58.77,Default,,0,0,0,,Тіпті Құс жеңе алмайды➡
Dialogue: 0,0:07:58.77,0:08:00.78,Default,,0,0,0,,Біз өте...
Dialogue: 0,0:08:00.78,0:08:05.95,Default,,0,0,0,,Олай болса, көбірек арнайы жаттығулар жасайық! Барынша тырыссаңыз, міндетті түрде жеңе аласыз!
Dialogue: 0,0:08:05.95,0:08:09.22,Default,,0,0,0,,Арнайы дайындық – жалғыз нұсқа! Тағы да солай ма?
Dialogue: 0,0:08:11.32,0:08:13.36,Default,,0,0,0,,Кепілдік бар ма?
Dialogue: 0,0:08:13.36,0:08:15.82,Default,,0,0,0,,Тынымсыз жаттығатын болсаңыз, мықты болатыныңызға кепілдік беремін!
Dialogue: 0,0:08:17.76,0:08:21.30,Default,,0,0,0,,Жеңіске жете алмасаңыз, бұл тек уақытты босқа өткізу...
Dialogue: 0,0:08:21.30,0:08:23.97,Default,,0,0,0,,Арнайы дайындық Арнайы дайындық...
Dialogue: 0,0:08:23.97,0:08:26.63,Default,,0,0,0,,Бұл енді қызық болмады.
Dialogue: 0,0:08:26.63,0:08:29.14,Default,,0,0,0,,Мен сенімен Бей ойнасам да...
Dialogue: 0,0:08:29.14,0:08:31.51,Default,,0,0,0,,Сенде Бейдің таланты жоқ.
Dialogue: 0,0:08:31.51,0:08:40.45,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:08:40.45,0:08:46.12,Default,,0,0,0,,《Қызық екен... Ойлап қарасам, көптен бері ұмытып кетіппін.
Dialogue: 0,0:08:46.12,0:08:50.79,Default,,0,0,0,,Бірақ кәсіпқой болғың келсе, көп жұмыс істеу керек.
Dialogue: 0,0:08:50.79,0:08:53.63,Default,,0,0,0,,Бұл қызық және сол сияқты нәрселер...
Dialogue: 0,0:08:53.63,0:08:57.47,Default,,0,0,0,,Туған жерімде болған кезім жақсы болды.
Dialogue: 0,0:08:57.47,0:08:59.97,Default,,0,0,0,,Ол жеңіліссіз болды➡
Dialogue: 0,0:08:59.97,0:09:02.77,Default,,0,0,0,,Күн сайын шығанақта ойнау қызық болды》
Dialogue: 0,0:09:09.44,0:09:13.52,Default,,0,0,0,,Сәлеметсіз бе.
Dialogue: 0,0:09:13.52,0:09:15.55,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:09:15.55,0:09:18.62,Default,,0,0,0,,Уау! Не... Бұл не, сен!
Dialogue: 0,0:09:18.62,0:09:23.46,Default,,0,0,0,,Мм... Біреудің түрін көрген бойда төмен түсу дөрекі.
Dialogue: 0,0:09:23.46,0:09:25.63,Default,,0,0,0,,Мен... Мен сенің жүзіңді көрмеймін!
Dialogue: 0,0:09:25.63,0:09:29.30,Default,,0,0,0,,Сіздің атыңыз кім? иә?
Dialogue: 0,0:09:29.30,0:09:32.47,Default,,0,0,0,,Ауа-райы құс. Сізге бірдеңе керек пе?
Dialogue: 0,0:09:32.47,0:09:35.80,Default,,0,0,0,,Сіздің топтағы достарыңыз сізден ертерек қашып кетті, солай ма?
Dialogue: 0,0:09:35.80,0:09:37.84,Default,,0,0,0,,Олардың мүлде қозғалмай жатқаны оғаш екен
Dialogue: 0,0:09:37.84,0:09:41.14,Default,,0,0,0,,Бейбатт негізінен үш адамнан тұратын команда.
Dialogue: 0,0:09:41.14,0:09:43.11,Default,,0,0,0,,Адам аз болса, қолайсыз жағдайға тап боласыз.
Dialogue: 0,0:09:43.11,0:09:45.15,Default,,0,0,0,,Жақсы….
Dialogue: 0,0:09:45.15,0:09:49.12,Default,,0,0,0,,Мен сізге бірнеше әріптестер қосқыңыз келуі мүмкін деп ойладым.
Dialogue: 0,0:09:49.12,0:09:53.79,Default,,0,0,0,,Сіз және сіздің командаңыз? Сол шығанақ...
Dialogue: 0,0:09:53.79,0:09:57.79,Default,,0,0,0,,Рюгу Хромның Дран қылышы! ?
Dialogue: 0,0:09:57.79,0:09:59.96,Default,,0,0,0,,Неліктен сізде бар?
Dialogue: 0,0:09:59.96,0:10:02.60,Default,,0,0,0,,Не? Өйткені, бұл менің шығанағым.
Dialogue: 0,0:10:02.60,0:10:06.10,Default,,0,0,0,,Эй, бұл сенікі. Иә иә.
Dialogue: 0,0:10:06.10,0:10:08.10,Default,,0,0,0,,Өтірік айтпа! ! Ой….
Dialogue: 0,0:10:08.10,0:10:10.61,Default,,0,0,0,,Бұл бәрібір дизайндағы көшірме емес пе?
Dialogue: 0,0:10:10.61,0:10:13.94,Default,,0,0,0,,Нақтыдан басқа өнімділігі бар контрафактілік өнім!
Dialogue: 0,0:10:13.94,0:10:17.11,Default,,0,0,0,,Арзан болса да, ондай ештеңе жасамаңыз!
Dialogue: 0,0:10:17.11,0:10:20.12,Default,,0,0,0,,Солай ма? Бұл дұрыс!
Dialogue: 0,0:10:20.12,0:10:25.12,Default,,0,0,0,,Әй, сондықтан да өнерпаздар... Жарайды, оны бір жаққа қалдырыңыз.
Dialogue: 0,0:10:27.29,0:10:31.96,Default,,0,0,0,,Маңыздысы, менің командада болғанымды қалайсыз ба, жоқ па?
Dialogue: 0,0:10:31.96,0:10:35.63,Default,,0,0,0,,Жалғыз қалсаңыз, кәсіпқой болудың жолы ұзақ болады.
Dialogue: 0,0:10:38.47,0:10:43.10,Default,,0,0,0,,Басқа таңдау жоқ!
Dialogue: 0,0:10:43.10,0:10:45.44,Default,,0,0,0,,Сонымен... (қуаныш)
Dialogue: 0,0:10:45.44,0:10:49.61,Default,,0,0,0,,Тоқта, күт! Командалар негізінен үш адамнан құралады емес пе?
Dialogue: 0,0:10:49.61,0:10:52.71,Default,,0,0,0,,Уайымдама, уайымдама, тіпті екі адам төбелесуі мүмкін.
Dialogue: 0,0:10:55.12,0:10:58.15,Default,,0,0,0,,О, бұл өте жанды!
Dialogue: 0,0:10:58.15,0:11:02.96,Default,,0,0,0,,Бұл сенің де бірінші рет пе? Жоқ, көп уақыт өтті.
Dialogue: 0,0:11:02.96,0:11:05.63,Default,,0,0,0,,Айтпақшы, сенің атың кім?
Dialogue: 0,0:11:05.63,0:11:09.26,Default,,0,0,0,,Иә? Бұл дұрыс.
Dialogue: 0,0:11:09.26,0:11:11.27,Default,,0,0,0,,Мені Камен X деп атаңыз!
Dialogue: 0,0:11:11.27,0:11:13.47,Default,,0,0,0,,X! ?
Dialogue: 0,0:11:13.47,0:11:15.44,Default,,0,0,0,,Бұл не, X!
Dialogue: 0,0:11:15.44,0:11:19.11,Default,,0,0,0,,Әлі де құпия. Күрсіну….
Dialogue: 0,0:11:19.11,0:11:22.84,Default,,0,0,0,,Олай болса, тез арада Бейбатл өткізейік!
Dialogue: 0,0:11:22.84,0:11:27.48,Default,,0,0,0,,Негізі менде жоқ.
Dialogue: 0,0:11:27.48,0:11:30.69,Default,,0,0,0,,Иә? Неліктен? бұл….
Dialogue: 0,0:11:32.95,0:11:35.46,Default,,0,0,0,,Менің шығанағым ~!
Dialogue: 0,0:11:35.46,0:11:39.46,Default,,0,0,0,,Тым әлсіз. Менде кәсіпқой болу үшін де біліктілік жоқ.
Dialogue: 0,0:11:39.46,0:11:41.60,Default,,0,0,0,,Уау! Бұл сұмдық!
Dialogue: 0,0:11:41.60,0:11:43.80,Default,,0,0,0,,Бұл күнде де мұндай жүзгіштер бар.
Dialogue: 0,0:11:43.80,0:11:48.80,Default,,0,0,0,,X Тек онымен араласпа. Ол жігіт...
Dialogue: 0,0:11:48.80,0:11:50.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:53.21,0:11:55.44,Default,,0,0,0,,Мен сізді Бейбаттқа шақырамын!
Dialogue: 0,0:11:55.44,0:11:57.48,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:57.48,0:12:00.15,Default,,0,0,0,,
Dialogue: 0,0:12:00.15,0:12:02.12,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:12:02.12,0:12:06.62,Default,,0,0,0,,Ол шынымен жаман жігіт сияқты, сондықтан онымен күресу қызық болар еді.
Dialogue: 0,0:12:06.62,0:12:10.16,Default,,0,0,0,,Ей, ақымақ, бұл адамдармен соғыспау керек.
Dialogue: 0,0:12:10.16,0:12:12.96,Default,,0,0,0,,Өйткені бұл адамдар➡
Dialogue: 0,0:12:12.96,0:12:15.63,Default,,0,0,0,,Pro... Не?
Dialogue: 0,0:12:15.63,0:12:18.30,Default,,0,0,0,,Сен сонда!
Dialogue: 0,0:12:18.30,0:12:22.80,Default,,0,0,0,,Бейге енді ешқашан тиіспеңіз. Мен мұны айтуым керек еді.
Dialogue: 0,0:12:22.80,0:12:27.74,Default,,0,0,0,,Сіз әлсізсіз. Сондықтан сіз Бей ойнамауыңыз керек.
Dialogue: 0,0:12:27.74,0:12:31.45,Default,,0,0,0,,Қарапайым оқиғаны адамдардың түсіне алмайтыны қызық.
Dialogue: 0,0:12:31.45,0:12:34.35,Default,,0,0,0,,Әрине. Бұл күлкілі.
Dialogue: 0,0:12:34.35,0:12:38.45,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:12:38.45,0:12:42.29,Default,,0,0,0,,Ахахаха…. Неге, сен тіпті күлесің!
Dialogue: 0,0:12:42.29,0:12:45.29,Default,,0,0,0,,Жоқ, өйткені бұл адамдар➡
Dialogue: 0,0:12:45.29,0:12:47.30,Default,,0,0,0,,Мен мағынасы жоқ нәрсені айтып тұрмын.
Dialogue: 0,0:12:47.30,0:12:49.73,Default,,0,0,0,,Құс әлсіз деп есептейміз➡
Dialogue: 0,0:12:49.73,0:12:53.97,Default,,0,0,0,,Бұның ойын ойнауға қандай қатысы бар?
Dialogue: 0,0:12:53.97,0:12:56.64,Default,,0,0,0,,Әлсіз немесе талантсыз➡
Dialogue: 0,0:12:56.64,0:12:59.47,Default,,0,0,0,,Одан ләззат алған адам жеңімпаз атанады.
Dialogue: 0,0:12:59.47,0:13:03.78,Default,,0,0,0,,Боқ... Бейблейд ана ойнаудан бөлек.
Dialogue: 0,0:13:03.78,0:13:06.65,Default,,0,0,0,,Сонымен қатар, әлсіздер➡
Dialogue: 0,0:13:06.65,0:13:08.95,Default,,0,0,0,,Бэй ойнамау керек десең➡
Dialogue: 0,0:13:08.95,0:13:14.82,Default,,0,0,0,,Бұл сіз Bay-тен дәл қазір шығуыңыз керек дегенді білдіреді.
Dialogue: 0,0:13:14.82,0:13:17.59,Default,,0,0,0,,Ха! Ах!
Dialogue: 0,0:13:17.59,0:13:20.60,Default,,0,0,0,,Кукукуку... Қызық бала екен.
Dialogue: 0,0:13:20.60,0:13:24.80,Default,,0,0,0,,Жарайды, бұл Бейбатт!
Dialogue: 0,0:13:24.80,0:13:29.17,Default,,0,0,0,,Мен сізге кәсіпқой болудан қорқуды көрсетемін.
Dialogue: 0,0:13:35.11,0:13:37.18,Default,,0,0,0,,🎤WhatsApp Барлығына!
Dialogue: 0,0:13:37.18,0:13:39.51,Default,,0,0,0,,🎤Pro және әуесқойлар командасы! Бұл шайқас➡
Dialogue: 0,0:13:39.51,0:13:44.09,Default,,0,0,0,,Күтулер, маңызды пікірлер мен кеңестер қабылданады!
Dialogue: 0,0:13:44.09,0:13:47.12,Default,,0,0,0,,Олай болса, Фаланкс командасы...
Dialogue: 0,0:13:47.12,0:13:49.92,Default,,0,0,0,,Керісінше қандай?
Dialogue: 0,0:13:49.92,0:13:52.43,Default,,0,0,0,,Сіздің командаңыздың аты кім?
Dialogue: 0,0:13:52.43,0:13:54.93,Default,,0,0,0,,Иә? Команда аты?
Dialogue: 0,0:13:54.93,0:13:58.43,Default,,0,0,0,,Жақсы, Persona командасы.
Dialogue: 0,0:13:58.43,0:14:02.27,Default,,0,0,0,,Pe... Persona? Бұл маска➡ дегенді білдіреді
Dialogue: 0,0:14:02.27,0:14:05.27,Default,,0,0,0,,Керемет емес пе? аа….
Dialogue: 0,0:14:05.27,0:14:10.28,Default,,0,0,0,,🎤Жарайды! Team Phalanx және Team Persona!
Dialogue: 0,0:14:10.28,0:14:13.11,Default,,0,0,0,,Бұл матч көрмелік матч➡
Dialogue: 0,0:14:13.11,0:14:16.08,Default,,0,0,0,,Екі ойында бірінші жеңіске жеткен команда жеңеді!
Dialogue: 0,0:14:16.08,0:14:19.25,Default,,0,0,0,,Сіз нені айтасыз? иә?
Dialogue: 0,0:14:19.25,0:14:22.16,Default,,0,0,0,,Бірдеңе айтып, осының кесірінен жеңіліп қалсаңыз➡
Dialogue: 0,0:14:22.16,0:14:25.69,Default,,0,0,0,,Бұл жай ғана күлкі болады... Жарайды, солай ма?
Dialogue: 0,0:14:25.69,0:14:27.60,Default,,0,0,0,,Жеңіске жету мүмкіндігі бар ма?
Dialogue: 0,0:14:27.60,0:14:30.26,Default,,0,0,0,,Жеңіске жету мүмкіндігі? Ештене етпейді.
Dialogue: 0,0:14:30.26,0:14:33.13,Default,,0,0,0,,Beyblade - бұл жай ғана көңілді ойын!
Dialogue: 0,0:14:33.13,0:14:35.10,Default,,0,0,0,,Көңілді болайық!
Dialogue: 0,0:14:35.10,0:14:37.67,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:14:37.67,0:14:42.48,Default,,0,0,0,,🎤Бірінші Blader - Team Phalanx командасынан Дженри Хидаба!
Dialogue: 0,0:14:42.48,0:14:46.95,Default,,0,0,0,,🎤Менің қарсыласым, Team Persona - Kamen X!
Dialogue: 0,0:14:48.92,0:14:51.45,Default,,0,0,0,,Бұл Дран қылыш па?
Dialogue: 0,0:14:51.45,0:14:54.46,Default,,0,0,0,,Бұл көшірме, солай ма? Жақсы, бұл сирек.
Dialogue: 0,0:14:54.46,0:14:58.26,Default,,0,0,0,,Бұл қандай маска?
Dialogue: 0,0:14:58.26,0:15:00.26,Default,,0,0,0,,Бірінші шайқас!
Dialogue: 0,0:15:02.26,0:15:04.43,Default,,0,0,0,,Бейблейд тек көңіл көтеруге арналған...
Dialogue: 0,0:15:04.43,0:15:07.10,Default,,0,0,0,,Сонымен, сіз оны пышақ деп атай аласыз ба?
Dialogue: 0,0:15:07.10,0:15:09.44,Default,,0,0,0,,Қарсылас кәсіпқой.
Dialogue: 0,0:15:09.44,0:15:13.64,Default,,0,0,0,,Тек көңіл көтеру үшін... Әп-сәтте өлтірілді.
Dialogue: 0,0:15:13.64,0:15:18.25,Default,,0,0,0,,Құс... Х дегеніміз не? Менің естігенім сол.
Dialogue: 0,0:15:18.25,0:15:20.62,Default,,0,0,0,,Аа...
Dialogue: 0,0:15:20.62,0:15:23.65,Default,,0,0,0,,Мұқият қараңыз.
Dialogue: 0,0:15:23.65,0:15:25.75,Default,,0,0,0,,Дайын жиынтық!
Dialogue: 0,0:15:25.75,0:15:28.96,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:15:28.96,0:15:31.79,Default,,0,0,0,,Қой! Бара бер!
Dialogue: 0,0:15:31.79,0:15:39.13,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:39.13,0:15:41.80,Default,,0,0,0,,🎤Бұл бірден өлтіру!
Dialogue: 0,0:15:41.80,0:15:43.81,Default,,0,0,0,,Тыныш! (қуаныш)
Dialogue: 0,0:15:43.81,0:15:46.67,Default,,0,0,0,,Доран семсер аяқталды!
Dialogue: 0,0:15:46.67,0:15:48.71,Default,,0,0,0,,Бетперде киген X жеңісі!
Dialogue: 0,0:15:48.71,0:15:51.48,Default,,0,0,0,,🎤Бір сәтте шешілді!
Dialogue: 0,0:15:51.48,0:15:54.45,Default,,0,0,0,,🎤Team Persona Бірінші жеңіс!
Dialogue: 0,0:15:54.45,0:15:57.25,Default,,0,0,0,,Не... Қазір бұл не?
Dialogue: 0,0:16:00.79,0:16:03.69,Default,,0,0,0,,Көре алмадым... әп-сәтте➡
Dialogue: 0,0:16:03.69,0:16:06.79,Default,,0,0,0,,Ол шешілді.
Dialogue: 0,0:16:06.79,0:16:08.96,Default,,0,0,0,,Уа, құс! Ой….
Dialogue: 0,0:16:08.96,0:16:13.37,Default,,0,0,0,,Тексеріңіз, мен күзетімді түсірдім. Мен күзетімді түсірдім бе?
Dialogue: 0,0:16:13.37,0:16:16.94,Default,,0,0,0,,Маған шығанақ беріңіз. Хмм, ой...
Dialogue: 0,0:16:16.94,0:16:19.77,Default,,0,0,0,,Бірақ ол күткендей, оны айналып өтті.
Dialogue: 0,0:16:19.77,0:16:21.81,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:16:21.81,0:16:24.68,Default,,0,0,0,,Олай болса, кәсіби мансабыңызды қазір тастаңыз.
Dialogue: 0,0:16:24.68,0:16:27.45,Default,,0,0,0,,Бейблейд ойын емес.
Dialogue: 0,0:16:27.45,0:16:30.08,Default,,0,0,0,,Ахахаха... Құс қарашы!
Dialogue: 0,0:16:30.08,0:16:32.12,Default,,0,0,0,,Командалас Бей мен сені құртып жатырмын!
Dialogue: 0,0:16:32.12,0:16:34.09,Default,,0,0,0,,Эй, эй? Ахаха…. Мені араластырма.
Dialogue: 0,0:16:34.09,0:16:36.12,Default,,0,0,0,,Өтінемін... Ахахха....
Dialogue: 0,0:16:36.12,0:16:39.03,Default,,0,0,0,,🎤Ал, Persona командасы бір жеңіске жетті.
Dialogue: 0,0:16:39.03,0:16:41.50,Default,,0,0,0,,🎤Келесі жолы жеңсек, бітеді...
Dialogue: 0,0:16:44.17,0:16:46.63,Default,,0,0,0,,🎤 Persona Kamen X➡ командасына қарсы
Dialogue: 0,0:16:46.63,0:16:50.67,Default,,0,0,0,,Phalanx командасының жетекшісі - Такуми Ишияма!
Dialogue: 0,0:16:50.67,0:16:53.27,Default,,0,0,0,,Екінші шайқас!
Dialogue: 0,0:16:56.74,0:16:58.78,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:16:58.78,0:17:01.82,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:17:01.82,0:17:05.42,Default,,0,0,0,,Қой!
Dialogue: 0,0:17:05.42,0:17:09.76,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:17:09.76,0:17:11.76,Default,,0,0,0,,Асығыңыз! Осы жылдамдықпен!
Dialogue: 0,0:17:11.76,0:17:15.93,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:17:15.93,0:17:18.57,Default,,0,0,0,,🎤Мен Стоун Монблан орталығын осында алдым!
Dialogue: 0,0:17:18.57,0:17:20.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:20.60,0:17:22.60,Default,,0,0,0,,🎤Орталықты мұқият қорғаңыз!
Dialogue: 0,0:17:22.60,0:17:25.11,Default,,0,0,0,,🎤Жәй ғана хоплит фалангасы!
Dialogue: 0,0:17:25.11,0:17:29.61,Default,,0,0,0,,《Күтілгендей. Кәмен бидің жүйрік екені рас, бірақ➡
Dialogue: 0,0:17:29.61,0:17:33.75,Default,,0,0,0,,Кәсіби әлемде жылдамдықтың бұл деңгейі сирек емес.
Dialogue: 0,0:17:33.75,0:17:36.45,Default,,0,0,0,,Стоун Монблан – қорғаныс түрі.
Dialogue: 0,0:17:36.45,0:17:38.79,Default,,0,0,0,,Шабуыл түрлеріне қарсы басым.
Dialogue: 0,0:17:38.79,0:17:40.96,Default,,0,0,0,,Жоғалтатын ештеңе жоқ! 》
Dialogue: 0,0:17:42.92,0:17:47.13,Default,,0,0,0,,Темірдей қорғаныс! Доран Қылыштың шабуылы нәтиже бермейді!
Dialogue: 0,0:17:49.73,0:17:53.10,Default,,0,0,0,,Бей оны ойын деп атамады ма?
Dialogue: 0,0:17:53.10,0:17:57.44,Default,,0,0,0,,Жоқ! Арнайы дайындықты 10 жыл бойы жалғастырдым.
Dialogue: 0,0:17:57.44,0:17:59.91,Default,,0,0,0,,Бұл әрекеттің нәтижесі ➡
Dialogue: 0,0:17:59.91,0:18:02.58,Default,,0,0,0,,Кәсіби мамандардың күші!
Dialogue: 0,0:18:02.58,0:18:06.08,Default,,0,0,0,,《Дұрыс... Бір айлық арнайы дайындық деген не?
Dialogue: 0,0:18:06.08,0:18:09.08,Default,,0,0,0,,Қанды күш.
Dialogue: 0,0:18:09.08,0:18:13.09,Default,,0,0,0,,Қайғы-қасірет арқылы алынған күш - бұл кәсіби әлем.
Dialogue: 0,0:18:13.09,0:18:15.76,Default,,0,0,0,,Менің күш-жігерім...》
Dialogue: 0,0:18:15.76,0:18:18.76,Default,,0,0,0,,Күш-жігер?
Dialogue: 0,0:18:18.76,0:18:21.96,Default,,0,0,0,,Мен Бейді қатты тырысады деп ойлаған емеспін!
Dialogue: 0,0:18:24.77,0:18:28.47,Default,,0,0,0,,Пайдасыз! Сіздің шығанақ әлсірейді.
Dialogue: 0,0:18:28.47,0:18:33.41,Default,,0,0,0,,《Қашаннан бері? Бей күш салды...
Dialogue: 0,0:18:33.41,0:18:37.28,Default,,0,0,0,,Сол кезде күш салдыңыз ба?
Dialogue: 0,0:18:37.28,0:18:40.11,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:18:40.11,0:18:44.42,Default,,0,0,0,,Қалай түсіргеніңізге байланысты әртүрлі қозғалыстарды көру қызықты болды.
Dialogue: 0,0:18:44.42,0:18:49.82,Default,,0,0,0,,Жүгіріп келе жатқан бидің жылдамдығы мен оның бар күшімен соқтығысуы мені қатты толқытты.
Dialogue: 0,0:18:49.82,0:18:53.96,Default,,0,0,0,,Жеңіске жетсем қуанар едім. Егер біз жеңіліп қалсақ, бұл көңілсіз болар еді.
Dialogue: 0,0:18:53.96,0:18:57.13,Default,,0,0,0,,Қайта-қайта атып тұрды.
Dialogue: 0,0:18:57.13,0:19:00.10,Default,,0,0,0,,Бұл қызықты болды!
Dialogue: 0,0:19:00.10,0:19:05.31,Default,,0,0,0,,Bay ең жақсы ойын болды! 》
Dialogue: 0,0:19:05.31,0:19:10.21,Default,,0,0,0,,🎤Айналу әлсіреді! Осылай реттеле ме?
Dialogue: 0,0:19:10.21,0:19:12.45,Default,,0,0,0,,Оның орбитасы...
Dialogue: 0,0:19:12.45,0:19:16.62,Default,,0,0,0,,《Бұл қызық, өйткені бұл көңілді. Сіз күшті бола аласыз, өйткені сіз одан ләззат ала аласыз!
Dialogue: 0,0:19:16.62,0:19:19.12,Default,,0,0,0,,Сонымен! 》
Dialogue: 0,0:19:19.12,0:19:23.79,Default,,0,0,0,,Енді жыпылықтасаң, сағынасың!
Dialogue: 0,0:19:23.79,0:19:28.70,Default,,0,0,0,,Мен саған сен көрмеген нәрсені көрсетемін.
Dialogue: 0,0:19:35.27,0:19:37.27,Default,,0,0,0,,Ол тездеді! !
Dialogue: 0,0:19:37.27,0:19:40.14,Default,,0,0,0,,《Такуми: Ол Extreme Line берілісімен біріктірілген!
Dialogue: 0,0:19:40.14,0:19:43.81,Default,,0,0,0,,Шабуылдың пайдасыз болып көрінуінің себебі осы ма? 》
Dialogue: 0,0:19:43.81,0:19:48.28,Default,,0,0,0,,Жоқ! Жоқ, бұл тым жылдам!
Dialogue: 0,0:19:48.28,0:19:52.25,Default,,0,0,0,,Көру өте жылдам... Бұл Х!
Dialogue: 0,0:19:54.29,0:19:56.69,Default,,0,0,0,,Экстремалды сызықша!
Dialogue: 0,0:20:04.93,0:20:06.93,Default,,0,0,0,,Доран семсер аяқталды!
Dialogue: 0,0:20:06.93,0:20:09.47,Default,,0,0,0,,Бетперде киген X жеңісі!
Dialogue: 0,0:20:09.47,0:20:13.54,Default,,0,0,0,,🎤Терсона командасы көрме матчында жеңіске жетті!
Dialogue: 0,0:20:13.54,0:20:16.11,Default,,0,0,0,,Ақымақ….
Dialogue: 0,0:20:16.11,0:20:20.45,Default,,0,0,0,,🎤О, Персонаны тойлайтын белгішелердің метеорлық жаңбыры!
Dialogue: 0,0:20:20.45,0:20:23.82,Default,,0,0,0,,Ха… ха ха ха…. (қуаныш)
Dialogue: 0,0:20:23.82,0:20:27.46,Default,,0,0,0,,Мен маманды жеңдім. Рахмет Ахах...
Dialogue: 0,0:20:27.46,0:20:30.96,Default,,0,0,0,,Әлгі жігіт, мүмкін...
Dialogue: 0,0:20:30.96,0:20:32.96,Default,,0,0,0,,Хмм, хехехе...
Dialogue: 0,0:20:40.10,0:20:42.10,Default,,0,0,0,,Еңбектеріңіз үшін рахмет.
Dialogue: 0,0:20:44.31,0:20:46.31,Default,,0,0,0,,Иә, бұл дәмді!
Dialogue: 0,0:20:46.31,0:20:49.31,Default,,0,0,0,,Іске қосу суши кешімен шектеледі, солай ма?
Dialogue: 0,0:20:49.31,0:20:53.71,Default,,0,0,0,,Сізге суши ұнайды ма? Құстарды да жемеңіз.
Dialogue: 0,0:20:53.71,0:20:56.62,Default,,0,0,0,,Шектеулі шығарылым Anko крем-сушиі ұсынылады!
Dialogue: 0,0:20:56.62,0:20:58.62,Default,,0,0,0,,Қажет емес!
Dialogue: 0,0:20:58.62,0:21:02.49,Default,,0,0,0,,Толығырақ айтып беріңізші. сіздің шынайы болмысыңыз.
Dialogue: 0,0:21:02.49,0:21:05.26,Default,,0,0,0,,Сіз тым күштісіз.
Dialogue: 0,0:21:05.26,0:21:08.93,Default,,0,0,0,,Тек кәсіпқойлар ғана кәсіпқойларды жеңе алады.
Dialogue: 0,0:21:08.93,0:21:11.77,Default,,0,0,0,,Бұрынғы шығанақ ішінде.
Dialogue: 0,0:21:11.77,0:21:15.47,Default,,0,0,0,,Мен қабылдай алатын бір ғана жауап бар.
Dialogue: 0,0:21:15.47,0:21:17.61,Default,,0,0,0,,Дран қылышы түпнұсқа➡
Dialogue: 0,0:21:17.61,0:21:20.94,Default,,0,0,0,,Сіздің шынайы тұлғаңыз қандай?
Dialogue: 0,0:21:20.94,0:21:24.78,Default,,0,0,0,,Ryugu Хром!
Dialogue: 0,0:21:24.78,0:21:26.75,Default,,0,0,0,,Бұл дұрыс емес адам.
Dialogue: 0,0:21:26.75,0:21:28.78,Default,,0,0,0,,Кім! ?
Dialogue: 0,0:21:28.78,0:21:32.95,Default,,0,0,0,,О, сіз байыпты болдыңыз ба? Мен Рюгу Chromeмін бе?
Dialogue: 0,0:21:32.95,0:21:35.96,Default,,0,0,0,,Кешіріңіз, мен қате түсіндім.
Dialogue: 0,0:21:35.96,0:21:38.93,Default,,0,0,0,,Мен қабылдай алатын бір ғана жауап бар.
Dialogue: 0,0:21:38.93,0:21:41.36,Default,,0,0,0,,Тоқташы~ Бұл ұят! !
Dialogue: 0,0:21:41.36,0:21:43.93,Default,,0,0,0,,Мазалаған жүзбен қателесудің несі ұят?
Dialogue: 0,0:21:43.93,0:21:47.27,Default,,0,0,0,,Көп емес. Мен де сақ боламын.
Dialogue: 0,0:21:47.27,0:21:50.47,Default,,0,0,0,,Ендеше тоқтатыңыз!
Dialogue: 0,0:21:50.47,0:21:54.64,Default,,0,0,0,,Күте тұрыңыз... Сіз...
Dialogue: 0,0:21:54.64,0:21:56.78,Default,,0,0,0,,Kurosu Ex?
Dialogue: 0,0:21:56.78,0:22:00.65,Default,,0,0,0,,Эй, бұл егжей-тегжейлі! Не айтқың келеді?
Dialogue: 0,0:22:00.65,0:22:03.28,Default,,0,0,0,,Куросу Ex➡ десеңіз
Dialogue: 0,0:22:03.28,0:22:06.45,Default,,0,0,0,,Ол Рюгу Хром-ның әріптесі!
Dialogue: 0,0:22:06.45,0:22:10.62,Default,,0,0,0,,Содайо! X Tower чемпионы...
Dialogue: 0,0:22:10.62,0:22:14.53,Default,,0,0,0,,Неліктен бұл әуесқой матч?
Dialogue: 0,0:22:14.53,0:22:18.30,Default,,0,0,0,,Неге деп сұрасаң да... Хм...
Dialogue: 0,0:22:18.30,0:22:21.50,Default,,0,0,0,,Ойнауға себеп бар ма?
Dialogue: 0,0:22:25.07,0:22:28.08,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:22:29.58,0:22:35.58,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
