Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.08,0:00:02.91,Default,,0,0,0,,Уф!
Dialogue: 0,0:00:06.25,0:00:08.59,Default,,0,0,0,,Хмм… Уф
Dialogue: 0,0:00:10.71,0:00:13.42,Default,,0,0,0,,А... а...
Dialogue: 0,0:00:13.92,0:00:16.26,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:00:17.34,0:00:18.89,Default,,0,0,0,,Хаа... Иә?
Dialogue: 0,0:00:19.01,0:00:22.31,Default,,0,0,0,,Ганта Жақсысың ба?
Dialogue: 0,0:00:23.77,0:00:24.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:24.89,0:00:28.94,Default,,0,0,0,,Ах… Хехе…
Dialogue: 0,0:00:29.07,0:00:29.94,Default,,0,0,0,,Ганта?
Dialogue: 0,0:00:30.52,0:00:32.99,Default,,0,0,0,,Деректер... Чип...
Dialogue: 0,0:00:33.11,0:00:36.86,Default,,0,0,0,,Сіз дәл қазір не істедіңіз?
Dialogue: 0,0:00:37.11,0:00:38.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:38.24,0:00:42.37,Default,,0,0,0,,Мен Гантаға барғанымда, мен танымайтын біреу бар еді, сондықтан...
Dialogue: 0,0:00:42.50,0:00:43.83,Default,,0,0,0,,Сіз, мүмкін емес...
Dialogue: 0,0:00:43.95,0:00:46.25,Default,,0,0,0,,Сол қарғыс атқыр балалармен дос болдыңыз ба?
Dialogue: 0,0:00:46.75,0:00:47.71,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:00:48.00,0:00:51.00,Default,,0,0,0,,Не? Неге ашуланасың?
Dialogue: 0,0:00:51.13,0:00:52.76,Default,,0,0,0,,Бұл чип-
Dialogue: 0,0:00:54.05,0:00:55.84,Default,,0,0,0,,Бұл үміт еді.
Dialogue: 0,0:00:56.51,0:01:01.31,Default,,0,0,0,,Бұл біздің қолымызда...
Dialogue: 0,0:01:02.35,0:01:05.06,Default,,0,0,0,,Барлығы сол себепті...
Dialogue: 0,0:01:05.14,0:01:06.19,Default,,0,0,0,,Сондықтан-
Dialogue: 0,0:01:06.31,0:01:07.98,Default,,0,0,0,,Гантада деректер чипі болуы керек.
Dialogue: 0,0:01:08.10,0:01:09.52,Default,,0,0,0,,Бұл қауіпті болды!
Dialogue: 0,0:01:10.11,0:01:11.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:11.73,0:01:13.98,Default,,0,0,0,,...Мен мұны әу бастан білгенмін!
Dialogue: 0,0:01:14.11,0:01:15.36,Default,,0,0,0,,Сондықтан мен сенен менің артымнан жүруіңді өтіндім...
Dialogue: 0,0:01:15.82,0:01:17.40,Default,,0,0,0,,Бірақ Ганта, сен әлсізсің!
Dialogue: 0,0:01:17.61,0:01:19.41,Default,,0,0,0,,Ха... а...
Dialogue: 0,0:01:19.74,0:01:22.41,Default,,0,0,0,,Сондықтан Широ сізді қорғайды!
Dialogue: 0,0:01:23.20,0:01:25.50,Default,,0,0,0,,Ха... Ақымақ болма!
Dialogue: 0,0:01:25.62,0:01:28.87,Default,,0,0,0,,Мұның қаншалықты маңызды екенін түсінесіз бе!
Dialogue: 0,0:01:29.00,0:01:31.13,Default,,0,0,0,,Иә! Мен білмеймін.
Dialogue: 0,0:01:31.25,0:01:33.38,Default,,0,0,0,,Широ, бұл мүлдем маңызды емес!
Dialogue: 0,0:01:33.75,0:01:35.88,Default,,0,0,0,,Қарғыс атсын! Широ - Ганта!
Dialogue: 0,0:01:38.55,0:01:39.76,Default,,0,0,0,,Ха…
Dialogue: 0,0:01:41.80,0:01:43.97,Default,,0,0,0,,Ха… га…
Dialogue: 0,0:01:44.89,0:01:46.52,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:01:46.64,0:01:48.89,Default,,0,0,0,,Қиындықтарыңды қайта көрсетпе!
Dialogue: 0,0:01:49.02,0:01:49.98,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:01:50.81,0:01:54.02,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:01:54.15,0:01:59.16,Default,,0,0,0,,♪~
Dialogue: 0,0:03:19.03,0:03:24.03,Default,,0,0,0,,~♪
Dialogue: 0,0:03:27.41,0:03:28.24,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:29.54,0:03:30.50,Default,,0,0,0,,Уф (Охара, Ямазаки, Эндо) Иә?
Dialogue: 0,0:03:30.50,0:03:31.25,Default,,0,0,0,,Уф (Охара, Ямазаки, Эндо) Иә?
Dialogue: 0,0:03:30.50,0:03:31.25,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:03:31.25,0:03:31.46,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:03:31.46,0:03:32.46,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:03:31.46,0:03:32.46,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:03:32.46,0:03:34.63,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:03:34.71,0:03:36.34,Default,,0,0,0,,Әй, Қарако-сан (Эндо) Қарако!
Dialogue: 0,0:03:36.67,0:03:37.80,Default,,0,0,0,,Карако!
Dialogue: 0,0:03:38.25,0:03:39.84,Default,,0,0,0,,Дұрыс. Соның арқасында мен ұтылдым.
Dialogue: 0,0:03:42.22,0:03:46.10,Default,,0,0,0,,Қош бол, күнәнің бұтақтары шынымен де жұмыс істемейді.
Dialogue: 0,0:03:46.80,0:03:50.89,Default,,0,0,0,,Оның үстіне ол ондай емес еді...
Dialogue: 0,0:03:51.02,0:03:53.31,Default,,0,0,0,,Ол ақымақ.
Dialogue: 0,0:03:53.81,0:03:56.19,Default,,0,0,0,,Мен бала кезімнен мүлде өзгерген сияқты емеспін...
Dialogue: 0,0:03:57.44,0:04:00.28,Default,,0,0,0,,Бірақ мен оның мұндай нәрсе жасайды деп ойламаппын...
Dialogue: 0,0:04:01.65,0:04:04.15,Default,,0,0,0,,Осының бәрі қалды ма?
Dialogue: 0,0:04:04.28,0:04:06.49,Default,,0,0,0,,Жоспар керемет орындалмады.
Dialogue: 0,0:04:06.62,0:04:07.57,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:08.08,0:04:10.41,Default,,0,0,0,,Бірақ әлі уақыт бар
Dialogue: 0,0:04:10.54,0:04:12.29,Default,,0,0,0,,Тексеру тобының қайтып оралуы мүмкін емес.
Dialogue: 0,0:04:12.45,0:04:13.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:13.54,0:04:16.88,Default,,0,0,0,,Эй, Карако, сен әлі істейсің бе?
Dialogue: 0,0:04:17.00,0:04:19.71,Default,,0,0,0,,Әрине, бас тарттыңыз ба?
Dialogue: 0,0:04:19.84,0:04:22.17,Default,,0,0,0,,Олай емес...
Dialogue: 0,0:04:22.30,0:04:24.72,Default,,0,0,0,,Бірақ маңызды деректер чипі қазірдің өзінде...
Dialogue: 0,0:04:24.84,0:04:26.68,Default,,0,0,0,,Рокуро жоқ...
Dialogue: 0,0:04:26.80,0:04:29.81,Default,,0,0,0,,Шынында да, деректер чипі енді жоқ.
Dialogue: 0,0:04:29.93,0:04:32.56,Default,,0,0,0,,Егер солай болса, онда иә.
Dialogue: 0,0:04:33.10,0:04:34.73,Default,,0,0,0,,Қалай болғанда да далаға шығыңыз.
Dialogue: 0,0:04:34.85,0:04:37.81,Default,,0,0,0,,Мен бұл түрменің негізсіздігі туралы тексеру тобына шағымданамын.
Dialogue: 0,0:04:37.94,0:04:41.44,Default,,0,0,0,,Түсіндім, сыртта кем дегенде бір адам жасай алады...
Dialogue: 0,0:04:41.57,0:04:44.03,Default,,0,0,0,,Күнә тармағының күшін пайдалансаң...
Dialogue: 0,0:04:44.15,0:04:45.90,Default,,0,0,0,,Тірі дәлелге айналу
Dialogue: 0,0:04:46.16,0:04:47.82,Default,,0,0,0,,Жоспар жалғасуда
Dialogue: 0,0:04:47.95,0:04:51.62,Default,,0,0,0,,Егер сізге ұнайтын болса, сіз тіпті Necro Macro-ны Күнә тармағымен жеңе аласыз.
Dialogue: 0,0:04:52.08,0:04:54.83,Default,,0,0,0,,Мұндағылардың барлығының жетістікке жетуіне көз жеткізейік.
Dialogue: 0,0:04:54.96,0:04:57.92,Default,,0,0,0,,Сіз келесі көшбасшысыз, Карако.
Dialogue: 0,0:04:58.04,0:04:59.29,Default,,0,0,0,,Жоқ (барлығы) Иә?
Dialogue: 0,0:04:59.59,0:05:01.21,Default,,0,0,0,,Наги тірі
Dialogue: 0,0:05:01.34,0:05:04.21,Default,,0,0,0,,Сол монах міндетті түрде Нагиді өлтіреді.
Dialogue: 0,0:05:04.42,0:05:05.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:06.22,0:05:08.26,Default,,0,0,0,,Сеякара Учиха -
Dialogue: 0,0:05:08.72,0:05:11.43,Default,,0,0,0,,Өз өміріңді қанша рет қатерге тігіп алсаң да!
Dialogue: 0,0:05:11.51,0:05:16.10,Default,,0,0,0,,(гитара дыбысы)
Dialogue: 0,0:05:16.23,0:05:18.56,Default,,0,0,0,,Сенкю~!
Dialogue: 0,0:05:18.73,0:05:22.52,Default,,0,0,0,,Сәлем! Сізге қай ән көбірек ұнайды, осы немесе бұрынғы ән?
Dialogue: 0,0:05:22.73,0:05:25.82,Default,,0,0,0,,Хаа... екеуін де салыстыру қиын әрі ұнамсыз.
Dialogue: 0,0:05:26.03,0:05:28.24,Default,,0,0,0,,Ха! Сүйкімді нәрсе айтыңыз~
Dialogue: 0,0:05:28.36,0:05:32.16,Default,,0,0,0,,Уф! Менімен не істеуді жоспарлайсыз?
Dialogue: 0,0:05:32.28,0:05:33.95,Default,,0,0,0,,Және барлығы...
Dialogue: 0,0:05:34.08,0:05:37.00,Default,,0,0,0,,Құқық қорғау ұйымының жетекшісі... (Наги) Ух...
Dialogue: 0,0:05:37.12,0:05:39.79,Default,,0,0,0,,Мұндай ойын сізге сәйкес келмейді.
Dialogue: 0,0:05:40.00,0:05:43.30,Default,,0,0,0,,Жұмысыңызды Undertaker, Owl деп өзгертіңіз.
Dialogue: 0,0:05:43.50,0:05:44.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:45.13,0:05:48.09,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:05:48.59,0:05:49.97,Default,,0,0,0,,Қол жетімді
Dialogue: 0,0:05:50.09,0:05:50.97,Default,,0,0,0,,Жарайды
Dialogue: 0,0:05:51.43,0:05:54.43,Default,,0,0,0,,Тексеру тобымен талқылауды аяқтауға бір сағатыңыз бар.
Dialogue: 0,0:05:54.68,0:05:57.73,Default,,0,0,0,,Тамаки қайтып келгенше бәрін сорып аламын.
Dialogue: 0,0:05:57.85,0:06:00.69,Default,,0,0,0,,Макина-сан үнемі не жейді?
Dialogue: 0,0:06:01.06,0:06:01.98,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:02.11,0:06:04.69,Default,,0,0,0,,Негізгі тағам – саке, жеңіл тағам – шарап.
Dialogue: 0,0:06:04.82,0:06:06.61,Default,,0,0,0,,Десертке арналған стейк
Dialogue: 0,0:06:06.74,0:06:08.57,Default,,0,0,0,,Бос сөзді тыңдама
Dialogue: 0,0:06:08.82,0:06:09.86,Default,,0,0,0,,Тез құтқару
Dialogue: 0,0:06:09.99,0:06:11.20,Default,,0,0,0,,бұл... иә
Dialogue: 0,0:06:11.91,0:06:14.12,Default,,0,0,0,,Тұтқындардың тізімі?
Dialogue: 0,0:06:14.74,0:06:16.29,Default,,0,0,0,,«Үйлесімді тұлғалар тізімі»?
Dialogue: 0,0:06:16.29,0:06:16.58,Default,,0,0,0,,«Үйлесімді тұлғалар тізімі»?
Dialogue: 0,0:06:16.29,0:06:16.58,Default,,0,0,0,,(лифт дыбысы)
Dialogue: 0,0:06:16.58,0:06:16.95,Default,,0,0,0,,(лифт дыбысы)
Dialogue: 0,0:06:16.95,0:06:18.71,Default,,0,0,0,,(лифт дыбысы)
Dialogue: 0,0:06:16.95,0:06:18.71,Default,,0,0,0,,Ха...жасырын!
Dialogue: 0,0:06:18.71,0:06:18.83,Default,,0,0,0,,(лифт дыбысы)
Dialogue: 0,0:06:18.83,0:06:20.46,Default,,0,0,0,,(лифт дыбысы)
Dialogue: 0,0:06:18.83,0:06:20.46,Default,,0,0,0,,Не? Қайда... қайда?
Dialogue: 0,0:06:27.80,0:06:29.88,Default,,0,0,0,,Бұл қызық лифт.
Dialogue: 0,0:06:30.01,0:06:31.47,Default,,0,0,0,,Мұны хобби ретінде жасамаңыз.
Dialogue: 0,0:06:31.59,0:06:34.64,Default,,0,0,0,,Осы жеке бөлмеде кез келген нәрсе туралы сөйлесуге болады.
Dialogue: 0,0:06:34.97,0:06:38.93,Default,,0,0,0,,Ғайбат болсын, лас сөз болсын, тәтті-қышқыл естеліктер болсын...
Dialogue: 0,0:06:39.06,0:06:40.81,Default,,0,0,0,,Бөлме де қызық екен (Тамаки) А...
Dialogue: 0,0:06:42.52,0:06:44.11,Default,,0,0,0,,Мысал қалай жасалған?
Dialogue: 0,0:06:44.65,0:06:48.11,Default,,0,0,0,,Аты жоқ құрттардың синтезі әлі де зерттелуде...
Dialogue: 0,0:06:48.24,0:06:52.32,Default,,0,0,0,,Бар адамдарға қабілеттерді жұқтыру арқылы жаңаларын жасауға болатын сияқты.
Dialogue: 0,0:06:52.45,0:06:53.62,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:53.95,0:06:56.29,Default,,0,0,0,,Бұл Қорғаныс министрлігіндегі Циньян ба?
Dialogue: 0,0:06:56.41,0:06:58.50,Default,,0,0,0,,Өндіріс? инфекция?
Dialogue: 0,0:06:58.62,0:06:59.62,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:59.91,0:07:00.91,Default,,0,0,0,,Өмірімді қатерге тігіп, барымды салдым.
Dialogue: 0,0:07:01.04,0:07:04.00,Default,,0,0,0,,Көшірудің соңында бақыланбайтын құбыжықтар туады...
Dialogue: 0,0:07:04.13,0:07:05.50,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:07:05.59,0:07:08.05,Default,,0,0,0,,«У жесең, табақ болады».
Dialogue: 0,0:07:08.17,0:07:12.38,Default,,0,0,0,,Мен мұнда келгеннен кейін бәс тігуден бас тарта алмаймын, Миса Аойо.
Dialogue: 0,0:07:12.97,0:07:14.60,Default,,0,0,0,,Әдеттегідей бюджет
Dialogue: 0,0:07:14.72,0:07:17.01,Default,,0,0,0,,Кукуку... Мен шаршадым.
Dialogue: 0,0:07:17.14,0:07:19.10,Default,,0,0,0,,Сіз танымал бола алмайсыз
Dialogue: 0,0:07:19.22,0:07:22.14,Default,,0,0,0,,Сол тізім... Осыны айтып тұрсың ба?
Dialogue: 0,0:07:22.23,0:07:23.90,Default,,0,0,0,,(Су құбырының дыбысы)
Dialogue: 0,0:07:26.65,0:07:28.53,Default,,0,0,0,,Бірақ Ганта, сен әлсізсің!
Dialogue: 0,0:07:28.69,0:07:30.11,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:07:30.24,0:07:33.95,Default,,0,0,0,,Жоспарың бұзылып жатқанда неге бұлай айту керек болды?
Dialogue: 0,0:07:34.07,0:07:35.32,Default,,0,0,0,,Мен де...
Dialogue: 0,0:07:35.82,0:07:37.87,Default,,0,0,0,,Сіз түрмеден қашуға әрекеттенсеңіз де...
Dialogue: 0,0:07:37.99,0:07:41.50,Default,,0,0,0,,Күзетшілер де, Undertaker де ішке кірмейді.
Dialogue: 0,0:07:41.96,0:07:44.79,Default,,0,0,0,,Мүмкін оны жүзуге мәжбүр ететін шығар.
Dialogue: 0,0:07:44.92,0:07:46.50,Default,,0,0,0,,​​Не үшін?
Dialogue: 0,0:07:46.63,0:07:48.75,Default,,0,0,0,,Егер ақпарат ағып кетсе...
Dialogue: 0,0:07:48.88,0:07:52.63,Default,,0,0,0,,Операцияны орындағанға дейін басуға да болатын.
Dialogue: 0,0:07:52.76,0:07:54.68,Default,,0,0,0,,Мен мұны істеген жоқпын...
Dialogue: 0,0:07:54.93,0:07:57.64,Default,,0,0,0,,Сізге ұнайтынына сенімдісіз бе?
Dialogue: 0,0:07:57.97,0:08:01.23,Default,,0,0,0,,Қызық, мен қазірден бастап мықтыны жинай аламын ба?
Dialogue: 0,0:08:01.35,0:08:03.23,Default,,0,0,0,,Бұл жағдайда сіздің ниетіңіз маңызды емес.
Dialogue: 0,0:08:03.35,0:08:05.77,Default,,0,0,0,,Сыртқа шыққыңыз келсе де...
Dialogue: 0,0:08:05.90,0:08:09.02,Default,,0,0,0,,Көмекші болсаң, Қарға сыныбында болмасаң, мағынасы жоқ.
Dialogue: 0,0:08:09.15,0:08:10.61,Default,,0,0,0,,Колибри мырза ше?
Dialogue: 0,0:08:10.73,0:08:12.57,Default,,0,0,0,,Бұл мінезден тыс...
Dialogue: 0,0:08:13.40,0:08:14.66,Default,,0,0,0,,Альбатрос
Dialogue: 0,0:08:14.78,0:08:16.32,Default,,0,0,0,,Ол әлдеқашан қарт адам.
Dialogue: 0,0:08:16.95,0:08:18.70,Default,,0,0,0,,Кингфишер туралы не деуге болады?
Dialogue: 0,0:08:18.83,0:08:20.95,Default,,0,0,0,,Мен өткен күні жазалау ойынында өлдім.
Dialogue: 0,0:08:21.08,0:08:23.96,Default,,0,0,0,,Қарасам... жақсы жігіт еді.
Dialogue: 0,0:08:24.67,0:08:25.87,Default,,0,0,0,,Күлдіргіш!
Dialogue: 0,0:08:26.33,0:08:27.63,Default,,0,0,0,,О...
Dialogue: 0,0:08:27.96,0:08:31.55,Default,,0,0,0,,Ол мінсіз, ол тым күшті дерлік.
Dialogue: 0,0:08:31.67,0:08:35.09,Default,,0,0,0,,Бірақ мен оны соңғы уақытта көрмедім.
Dialogue: 0,0:08:35.51,0:08:36.72,Default,,0,0,0,,Ум... (барлығы) Иә?
Dialogue: 0,0:08:36.84,0:08:39.14,Default,,0,0,0,,Мен бар күшімді саламын.
Dialogue: 0,0:08:39.26,0:08:41.77,Default,,0,0,0,,Сол адамдар үшін мен...
Dialogue: 0,0:08:41.89,0:08:44.10,Default,,0,0,0,,Мен саған сенемін, бірақ...
Dialogue: 0,0:08:44.39,0:08:48.23,Default,,0,0,0,,Сіз Undertaker жігіттерімен күресе алдыңыз ба?
Dialogue: 0,0:08:48.52,0:08:49.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:50.19,0:08:54.28,Default,,0,0,0,,Кешіріңіз, бірақ маған қосымша көмек керек.
Dialogue: 0,0:08:54.44,0:08:57.36,Default,,0,0,0,,Сәтсіздік енді опция емес.
Dialogue: 0,0:08:57.57,0:08:59.95,Default,,0,0,0,,Шақырсам да шыдаймын.
Dialogue: 0,0:09:00.24,0:09:02.37,Default,,0,0,0,,Жоқ... Кешіріңіз.
Dialogue: 0,0:09:02.49,0:09:05.58,Default,,0,0,0,,Мен Қарако-саннан көмек сұрадым...
Dialogue: 0,0:09:05.71,0:09:09.96,Default,,0,0,0,,Ол... Широ деректер чипін ұрлауы керек...
Dialogue: 0,0:09:11.21,0:09:12.96,Default,,0,0,0,,Барлығы үшін...
Dialogue: 0,0:09:13.34,0:09:16.68,Default,,0,0,0,,Оның кесірінен бәрі бекер өлді...
Dialogue: 0,0:09:16.80,0:09:18.22,Default,,0,0,0,,Аузыңды жап! сурет?
Dialogue: 0,0:09:18.59,0:09:22.10,Default,,0,0,0,,Одан артық бірдеңе айтсаң, мен ырылдаймын.
Dialogue: 0,0:09:22.22,0:09:23.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:24.27,0:09:28.40,Default,,0,0,0,,Не? Мен сені сәтсіздікке ұшыратқан жоқпын!
Dialogue: 0,0:09:28.81,0:09:30.11,Default,,0,0,0,,Жаман нәрсе...
Dialogue: 0,0:09:30.44,0:09:31.27,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:32.23,0:09:33.78,Default,,0,0,0,,Рокуро!
Dialogue: 0,0:09:33.98,0:09:36.65,Default,,0,0,0,,Уа, сен тірісің! (Охара) Сіз жарақат алдыңыз ба?
Dialogue: 0,0:09:36.90,0:09:38.45,Default,,0,0,0,,Рокуро Наги бұл...
Dialogue: 0,0:09:39.62,0:09:41.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:41.58,0:09:43.12,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:09:44.79,0:09:46.46,Default,,0,0,0,,Кім... менің...
Dialogue: 0,0:09:46.91,0:09:49.12,Default,,0,0,0,,Сіз... машинаны жойдыңыз ба?
Dialogue: 0,0:09:49.42,0:09:50.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:51.25,0:09:52.25,Default,,0,0,0,,Кім айтты—
Dialogue: 0,0:09:52.38,0:09:55.21,Default,,0,0,0,,Сіз бұл деректер чипінің бомба екенін түсіндіңіз бе?
Dialogue: 0,0:09:55.80,0:09:56.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:57.09,0:09:59.55,Default,,0,0,0,,А... не дедің? Рокуро
Dialogue: 0,0:09:59.68,0:10:01.55,Default,,0,0,0,,Бұл деректер чипі сіздікі...
Dialogue: 0,0:10:01.68,0:10:04.39,Default,,0,0,0,,Иә? Сіз байқамадыңыз ба?
Dialogue: 0,0:10:04.51,0:10:06.18,Default,,0,0,0,,Өлі адам ғажайып әлемі...
Dialogue: 0,0:10:06.31,0:10:08.94,Default,,0,0,0,,Ешқандай диверсиялық деректер қосылмаған.
Dialogue: 0,0:10:09.06,0:10:10.98,Default,,0,0,0,,Бұл кішкентай ғана бомба!
Dialogue: 0,0:10:11.19,0:10:12.06,Default,,0,0,0,,Иә! Ха
Dialogue: 0,0:10:12.36,0:10:16.11,Default,,0,0,0,,Сондықтан балалар жиналып, көңілді уақыт өткізуді жоспарладыңдар.
Dialogue: 0,0:10:16.32,0:10:17.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:17.74,0:10:19.99,Default,,0,0,0,,Түсінбедім дегеніңіз не?
Dialogue: 0,0:10:20.11,0:10:22.87,Default,,0,0,0,,Мұндай ақымақ қалай аман қалды?
Dialogue: 0,0:10:23.37,0:10:26.29,Default,,0,0,0,,Сіз бомбаны кездейсоқ залалсыздандырдым дейсіз бе?
Dialogue: 0,0:10:26.41,0:10:27.25,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:31.25,0:10:33.25,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:10:33.59,0:10:34.21,Default,,0,0,0,,Мен аман қалдым
Dialogue: 0,0:10:34.21,0:10:36.05,Default,,0,0,0,,Мен аман қалдым
Dialogue: 0,0:10:34.21,0:10:36.05,Default,,0,0,0,,(мойынның сықырлаған дыбысы)
Dialogue: 0,0:10:36.05,0:10:36.17,Default,,0,0,0,,(мойынның сықырлаған дыбысы)
Dialogue: 0,0:10:36.17,0:10:36.80,Default,,0,0,0,,(мойынның сықырлаған дыбысы)
Dialogue: 0,0:10:36.17,0:10:36.80,Default,,0,0,0,,Мен сізден басқа маңызды рөлді алуыңызды сұраймын.
Dialogue: 0,0:10:36.80,0:10:39.30,Default,,0,0,0,,Мен сізден басқа маңызды рөлді алуыңызды сұраймын.
Dialogue: 0,0:10:39.42,0:10:40.43,Default,,0,0,0,,Хаа…
Dialogue: 0,0:10:40.55,0:10:43.30,Default,,0,0,0,,Сіз оны Undertaker-ге қоясыз ба?
Dialogue: 0,0:10:43.43,0:10:44.85,Default,,0,0,0,,Қалжыңдамаңыз
Dialogue: 0,0:10:45.43,0:10:47.93,Default,,0,0,0,,Екі жылдан бері мені махаббатқа шақырасың...
Dialogue: 0,0:10:48.06,0:10:49.77,Default,,0,0,0,,Мен жалықтым.
Dialogue: 0,0:10:49.89,0:10:51.69,Default,,0,0,0,,Екі жыл бұрын...
Dialogue: 0,0:10:51.77,0:10:55.77,Default,,0,0,0,,Біз бір топ санасыз адамдармыз.
Dialogue: 0,0:10:55.90,0:10:57.15,Default,,0,0,0,,Бірақ Оулу
Dialogue: 0,0:10:57.69,0:10:58.78,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:59.07,0:11:03.82,Default,,0,0,0,,Сіз мен білетін ең ақылсыз адамсыз
Dialogue: 0,0:11:03.95,0:11:06.28,Default,,0,0,0,,Сіз осы жақтансыз.
Dialogue: 0,0:11:06.95,0:11:10.50,Default,,0,0,0,,Не... айтып тұрсың!
Dialogue: 0,0:11:10.75,0:11:13.29,Default,,0,0,0,,Сіз және сіздің әйеліңізді өлтірген достарыңыз!
Dialogue: 0,0:11:13.67,0:11:16.55,Default,,0,0,0,,Достарыңыз үшін уайымдадыңыз ба?
Dialogue: 0,0:11:16.63,0:11:19.13,Default,,0,0,0,,Уф! Ой... аа...
Dialogue: 0,0:11:19.34,0:11:21.68,Default,,0,0,0,,Жақында маған ұнайды
Dialogue: 0,0:11:21.80,0:11:24.64,Default,,0,0,0,,Концерт әлі аяқталған жоқ.
Dialogue: 0,0:11:24.76,0:11:25.22,Default,,0,0,0,,(мойынның сықырлаған дыбысы)
Dialogue: 0,0:11:25.22,0:11:25.60,Default,,0,0,0,,(мойынның сықырлаған дыбысы)
Dialogue: 0,0:11:25.22,0:11:25.60,Default,,0,0,0,,Наги өз шешімін өзгертпейінше, бәрің кепілде боласыңдар.
Dialogue: 0,0:11:25.60,0:11:29.10,Default,,0,0,0,,Наги өз шешімін өзгертпейінше, бәрің кепілде боласыңдар.
Dialogue: 0,0:11:29.22,0:11:31.48,Default,,0,0,0,,Оларды бір-бірден орындаңыз.
Dialogue: 0,0:11:31.64,0:11:33.10,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:33.23,0:11:35.36,Default,,0,0,0,,Не... Рокуро сен!
Dialogue: 0,0:11:35.52,0:11:36.61,Default,,0,0,0,,Ал...
Dialogue: 0,0:11:38.11,0:11:40.36,Default,,0,0,0,,Хмм…
Dialogue: 0,0:11:41.53,0:11:42.53,Default,,0,0,0,,(мойынның сықырлаған дыбысы)
Dialogue: 0,0:11:43.41,0:11:47.12,Default,,0,0,0,,Енді мен бірінші кімді өлтіруім керек...
Dialogue: 0,0:11:51.00,0:11:51.83,Default,,0,0,0,,Уф
Dialogue: 0,0:11:52.04,0:11:54.83,Default,,0,0,0,,Маған сенің көздерің ұнамайды. Сізден бе?
Dialogue: 0,0:11:55.29,0:11:58.80,Default,,0,0,0,,Ақырында, сен маған есептеулеріме көмектесе аласың, Руки.
Dialogue: 0,0:11:58.92,0:12:01.88,Default,,0,0,0,,Хмм... у...
Dialogue: 0,0:12:08.31,0:12:11.14,Default,,0,0,0,,Біреу маған көмектесіңізші
Dialogue: 0,0:12:11.68,0:12:14.90,Default,,0,0,0,,Деректер чипі жарылуға жақын.
Dialogue: 0,0:12:15.02,0:12:17.31,Default,,0,0,0,,Деректер чиптері?
Dialogue: 0,0:12:18.11,0:12:21.11,Default,,0,0,0,,Хмф! Қолымнан келгенше тырыссам да...
Dialogue: 0,0:12:21.23,0:12:24.07,Default,,0,0,0,,Қазірдің өзінде! Мен Ганта туралы ештеңе білмеймін.
Dialogue: 0,0:12:24.20,0:12:26.57,Default,,0,0,0,,Ата! Эй!
Dialogue: 0,0:12:26.70,0:12:28.83,Default,,0,0,0,,Ол әлі ұйықтап жатыр ма деп ойлаймын...
Dialogue: 0,0:12:28.95,0:12:32.25,Default,,0,0,0,,Мен жасырын печеньелерді рұқсатсыз жеймін.
Dialogue: 0,0:12:34.79,0:12:37.17,Default,,0,0,0,,Әй, ата, мынаны жесем болады ма?
Dialogue: 0,0:12:37.42,0:12:41.55,Default,,0,0,0,,Бұл тек Широға арналған.
Dialogue: 0,0:12:41.71,0:12:44.30,Default,,0,0,0,,Ганта әлі «үй» емес пе?
Dialogue: 0,0:12:44.42,0:12:45.26,Default,,0,0,0,,Анашым...
Dialogue: 0,0:12:45.38,0:12:49.01,Default,,0,0,0,,«Тағамдар жақсы достармен бірге жесе дәмді болады».
Dialogue: 0,0:12:49.30,0:12:52.77,Default,,0,0,0,,Ганта, маған мына бадам ұнады.
Dialogue: 0,0:12:52.89,0:12:55.81,Default,,0,0,0,,Оның жартысын ысқылау қиын.
Dialogue: 0,0:12:55.94,0:12:58.52,Default,,0,0,0,,Широға бұл планетада ұнайтыны ұнайды.
Dialogue: 0,0:12:59.23,0:13:01.98,Default,,0,0,0,,Мен Широның қасындамын
Dialogue: 0,0:13:02.32,0:13:05.70,Default,,0,0,0,,Мен бірге барлық қиын нәрселерді ұмытамын.
Dialogue: 0,0:13:06.11,0:13:08.99,Default,,0,0,0,,Уақыт мәңгі бар.
Dialogue: 0,0:13:09.12,0:13:10.91,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:13:11.03,0:13:12.45,Default,,0,0,0,,Бұл дәмді ме? Широ
Dialogue: 0,0:13:12.58,0:13:13.70,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:15.37,0:13:18.21,Default,,0,0,0,,Енді оны Гантамен бөлісудің қажеті жоқ.
Dialogue: 0,0:13:18.33,0:13:22.50,Default,,0,0,0,,Хехе~ Шоколад пен бал... Хм~
Dialogue: 0,0:13:22.63,0:13:24.55,Default,,0,0,0,,Жұлдыз тәрізділерді де жеймін.
Dialogue: 0,0:13:24.67,0:13:27.18,Default,,0,0,0,,Хмм... Ммм...
Dialogue: 0,0:13:29.39,0:13:33.10,Default,,0,0,0,,Ах... Мм! дәмді
Dialogue: 0,0:13:36.43,0:13:38.31,Default,,0,0,0,,(Шырылдаған дыбыс)
Dialogue: 0,0:13:38.90,0:13:39.77,Default,,0,0,0,,(жұтыну дыбысы)
Dialogue: 0,0:13:39.90,0:13:46.86,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:13:48.28,0:13:50.28,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:13:50.41,0:13:52.70,Default,,0,0,0,,Ең жақсысы емес пе? Жеңілгендер!
Dialogue: 0,0:13:53.03,0:13:55.37,Default,,0,0,0,,Нагиді өлім жазасына кесу кешінде...
Dialogue: 0,0:13:55.50,0:13:57.96,Default,,0,0,0,,Мен Темераны басты кейіпкер етемін.
Dialogue: 0,0:13:58.33,0:13:59.62,Default,,0,0,0,,Орындалу?
Dialogue: 0,0:13:59.75,0:14:02.96,Default,,0,0,0,,Мен не істеуім керек? Бұл жігіттерге күнәнің тармағы жұмыс істемейді ...
Dialogue: 0,0:14:03.21,0:14:05.26,Default,,0,0,0,,Рокуро! Сіз басынан бері бізбен біргесіз...
Dialogue: 0,0:14:05.42,0:14:07.47,Default,,0,0,0,,Уайымдама, Қансай әйел!
Dialogue: 0,0:14:07.59,0:14:08.72,Default,,0,0,0,,Ең алдымен мына бала.
Dialogue: 0,0:14:08.72,0:14:09.55,Default,,0,0,0,,Ең алдымен мына бала.
Dialogue: 0,0:14:08.72,0:14:09.55,Default,,0,0,0,,(мойынның сықырлаған дыбысы)
Dialogue: 0,0:14:11.01,0:14:12.47,Default,,0,0,0,,Негізінен, біз қашамыз.
Dialogue: 0,0:14:12.89,0:14:14.06,Default,,0,0,0,,Белгісіз себеппен, тіпті бір-біріңіздің шынайы кім екеніңізді білмесеңіз де—
Dialogue: 0,0:14:14.39,0:14:17.60,Default,,0,0,0,,Сізді өлім жазасына кесетін жасырын бейне.
Dialogue: 0,0:14:17.73,0:14:19.27,Default,,0,0,0,,Жарайсың, солай ма?
Dialogue: 0,0:14:19.39,0:14:21.86,Default,,0,0,0,,Мұның әсері мен күткеннен де көп болды.
Dialogue: 0,0:14:21.98,0:14:22.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:24.15,0:14:25.19,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:25.53,0:14:28.32,Default,,0,0,0,,1 минуттан аз уақытқа созылған бейне...
Dialogue: 0,0:14:28.45,0:14:31.07,Default,,0,0,0,,Дүниенің осылай шу шығарып жатқанына сене алар емеспін.
Dialogue: 0,0:14:31.20,0:14:34.95,Default,,0,0,0,,Бұл жерден кетсең де, бәрібір сені біреу өлтіреді.
Dialogue: 0,0:14:35.41,0:14:37.41,Default,,0,0,0,,Ух... у... Ах!
Dialogue: 0,0:14:37.54,0:14:40.37,Default,,0,0,0,,Пухьяхахаха... Бұл қандай би? Бұл дұрыс
Dialogue: 0,0:14:40.87,0:14:42.83,Default,,0,0,0,,Айналуға әлі ерте. Ах...
Dialogue: 0,0:14:43.34,0:14:45.88,Default,,0,0,0,,Сәлем, Мозури Шинагава!
Dialogue: 0,0:14:46.30,0:14:47.71,Default,,0,0,0,,Ах... Уф.
Dialogue: 0,0:14:51.43,0:14:53.64,Default,,0,0,0,,Әйел қажетсіз балаға жүкті болды...
Dialogue: 0,0:14:53.76,0:14:56.10,Default,,0,0,0,,Тауда босандым да тастадым.
Dialogue: 0,0:14:56.72,0:14:57.72,Default,,0,0,0,,Әйелдер үшін-
Dialogue: 0,0:14:57.85,0:15:01.69,Default,,0,0,0,,Бұл оның туған қаласына қайтарған ақшасына қосылмағандықтан болды.
Dialogue: 0,0:15:03.40,0:15:08.65,Default,,0,0,0,,(нәресте жылады)
Dialogue: 0,0:15:09.19,0:15:12.32,Default,,0,0,0,,Он жылдан астам уақыттан кейін төрт аңшылық әуесқойлары
Dialogue: 0,0:15:12.45,0:15:15.58,Default,,0,0,0,,Префектура жіберген алты аңшы мен 11 ит...
Dialogue: 0,0:15:15.70,0:15:18.24,Default,,0,0,0,,хайуанға құрбандыққа шалынған
Dialogue: 0,0:15:19.16,0:15:21.75,Default,,0,0,0,,Ақыры мен ұстаған аң...
Dialogue: 0,0:15:21.87,0:15:24.75,Default,,0,0,0,,Әрең адам пішінді
Dialogue: 0,0:15:25.84,0:15:27.05,Default,,0,0,0,,(Шинагаваның күлкісі)
Dialogue: 0,0:15:27.05,0:15:30.34,Default,,0,0,0,,(Шинагаваның күлкісі)
Dialogue: 0,0:15:27.05,0:15:30.34,Default,,0,0,0,,Ашық қызыл бастары бар әйелдердің денелері көп болды.
Dialogue: 0,0:15:30.72,0:15:34.76,Default,,0,0,0,,Бұл манекенге толы қойма немесе қараусыз қалған зауыт сияқты...
Dialogue: 0,0:15:34.89,0:15:35.97,Default,,0,0,0,,Көп болды
Dialogue: 0,0:15:36.43,0:15:36.64,Default,,0,0,0,,Кінәлі ұсталғанда...
Dialogue: 0,0:15:36.64,0:15:38.43,Default,,0,0,0,,Кінәлі ұсталғанда...
Dialogue: 0,0:15:36.64,0:15:38.43,Default,,0,0,0,,(Шинагаваның қарсылық дауысы)
Dialogue: 0,0:15:38.43,0:15:38.56,Default,,0,0,0,,(Шинагаваның қарсылық дауысы)
Dialogue: 0,0:15:38.56,0:15:42.06,Default,,0,0,0,,(Шинагаваның қарсылық дауысы)
Dialogue: 0,0:15:38.56,0:15:42.06,Default,,0,0,0,,Мен шкафтан шығуға өте құлықсыз болдым.
Dialogue: 0,0:15:45.77,0:15:47.98,Default,,0,0,0,,Киімі сол жерден толып кетті...
Dialogue: 0,0:15:48.11,0:15:50.11,Default,,0,0,0,,Барлығы әйел шашымен өрілген-
Dialogue: 0,0:15:50.24,0:15:53.74,Default,,0,0,0,,Астар толығымен бет терісі болды.
Dialogue: 0,0:15:54.24,0:15:56.57,Default,,0,0,0,,Олар қазір осында.
Dialogue: 0,0:15:57.24,0:16:01.45,Default,,0,0,0,,Жетекші 2-ші Дэн Чо Мозели Гахаму
Dialogue: 0,0:16:01.58,0:16:04.25,Default,,0,0,0,,Екінші кезең командирінің орынбасары Шинагава Догуро
Dialogue: 0,0:16:04.75,0:16:07.88,Default,,0,0,0,,Бұл сіздің жазалаушының аты. Пухахаха... У... У...
Dialogue: 0,0:16:08.00,0:16:09.63,Default,,0,0,0,,Широ... (Рокуро) Пухахаха
Dialogue: 0,0:16:09.71,0:16:10.13,Default,,0,0,0,,(мойынның сықырлаған дыбысы)
Dialogue: 0,0:16:10.13,0:16:10.55,Default,,0,0,0,,(мойынның сықырлаған дыбысы)
Dialogue: 0,0:16:10.13,0:16:10.55,Default,,0,0,0,,Хаха... Ах! Ах
Dialogue: 0,0:16:10.55,0:16:11.30,Default,,0,0,0,,Хаха... Ах! Ах
Dialogue: 0,0:16:11.42,0:16:12.55,Default,,0,0,0,,Хаха хи~
Dialogue: 0,0:16:12.67,0:16:14.63,Default,,0,0,0,,Оларды тез өлтіріңіз!
Dialogue: 0,0:16:14.76,0:16:17.05,Default,,0,0,0,,1 2... Ах...
Dialogue: 0,0:16:17.51,0:16:18.89,Default,,0,0,0,,Зуппаши!
Dialogue: 0,0:16:21.98,0:16:23.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:23.44,0:16:25.02,Default,,0,0,0,,Үш!
Dialogue: 0,0:16:25.94,0:16:28.57,Default,,0,0,0,,...Таку! Сондықтан Ганта
Dialogue: 0,0:16:28.69,0:16:30.78,Default,,0,0,0,,Ойнағың келсе, мен де араластырайын!
Dialogue: 0,0:16:30.90,0:16:34.20,Default,,0,0,0,,Жетекші, солай ма? Қайсысы күшті?
Dialogue: 0,0:16:34.36,0:16:36.07,Default,,0,0,0,,Ах, аа... (барлығы) О...
Dialogue: 0,0:16:37.28,0:16:39.70,Default,,0,0,0,,Мүмкін... солай.
Dialogue: 0,0:16:39.78,0:16:40.87,Default,,0,0,0,,Уф
Dialogue: 0,0:16:42.20,0:16:45.21,Default,,0,0,0,,Се... Чижи...
Dialogue: 0,0:16:45.37,0:16:46.58,Default,,0,0,0,,Қарға... Қарға
Dialogue: 0,0:16:46.71,0:16:47.96,Default,,0,0,0,,Неліктен Қарға...
Dialogue: 0,0:16:48.08,0:16:49.71,Default,,0,0,0,,Иә! Барлығы қазір! (Солдат) Ой-оу.
Dialogue: 0,0:16:49.84,0:16:50.84,Default,,0,0,0,,Иә! (Отряд мүшесі) Жарайсың!
Dialogue: 0,0:16:51.50,0:16:52.63,Default,,0,0,0,,Иә! (Солдат) Уау!
Dialogue: 0,0:16:52.88,0:16:54.92,Default,,0,0,0,,Ммм! (Солдат) Арх!
Dialogue: 0,0:16:55.05,0:16:57.72,Default,,0,0,0,,Мен бұл туралы ештеңе істей алмаймын.
Dialogue: 0,0:16:58.14,0:17:00.06,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,0:17:02.02,0:17:02.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:03.27,0:17:05.81,Default,,0,0,0,,Қарға! Егер сіз олардың қаруына қолыңызды тигізсеңіз, сіз шығып кетесіз.
Dialogue: 0,0:17:06.14,0:17:07.27,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:07.40,0:17:09.98,Default,,0,0,0,,Пухахаха! ақымақ! (Чидзи) Хмм!
Dialogue: 0,0:17:10.61,0:17:12.40,Default,,0,0,0,,20 мегапаскаль ультра жоғары қысымда шығарылады.
Dialogue: 0,0:17:12.40,0:17:13.32,Default,,0,0,0,,20 мегапаскаль ультра жоғары қысымда шығарылады.
Dialogue: 0,0:17:12.40,0:17:13.32,Default,,0,0,0,,(мойынның сықырлаған дыбысы)
Dialogue: 0,0:17:13.32,0:17:13.44,Default,,0,0,0,,(мойынның сықырлаған дыбысы)
Dialogue: 0,0:17:13.44,0:17:13.69,Default,,0,0,0,,(мойынның сықырлаған дыбысы)
Dialogue: 0,0:17:13.44,0:17:13.69,Default,,0,0,0,,Тотықтырғыш Құрт жегіш Күнә тармағын жоққа шығарады!
Dialogue: 0,0:17:13.69,0:17:14.24,Default,,0,0,0,,Тотықтырғыш Құрт жегіш Күнә тармағын жоққа шығарады!
Dialogue: 0,0:17:14.24,0:17:15.95,Default,,0,0,0,,Тотықтырғыш Құрт жегіш Күнә тармағын жоққа шығарады!
Dialogue: 0,0:17:14.24,0:17:15.95,Default,,0,0,0,,(мойынның сықырлаған дыбысы)
Dialogue: 0,0:17:15.95,0:17:18.28,Default,,0,0,0,,Тотықтырғыш Құрт жегіш Күнә тармағын жоққа шығарады!
Dialogue: 0,0:17:18.28,0:17:18.45,Default,,0,0,0,,Тотықтырғыш Құрт жегіш Күнә тармағын жоққа шығарады!
Dialogue: 0,0:17:18.28,0:17:18.45,Default,,0,0,0,,(мойынның сықырлаған дыбысы)
Dialogue: 0,0:17:18.45,0:17:18.57,Default,,0,0,0,,(мойынның сықырлаған дыбысы)
Dialogue: 0,0:17:18.57,0:17:19.74,Default,,0,0,0,,(мойынның сықырлаған дыбысы)
Dialogue: 0,0:17:18.57,0:17:19.74,Default,,0,0,0,,Егер бұл күтпеген шабуыл болмаса, сіз жеңе аласыз ба?
Dialogue: 0,0:17:19.74,0:17:20.28,Default,,0,0,0,,Егер бұл күтпеген шабуыл болмаса, сіз жеңе аласыз ба?
Dialogue: 0,0:17:20.28,0:17:21.12,Default,,0,0,0,,Егер бұл күтпеген шабуыл болмаса, сіз жеңе аласыз ба?
Dialogue: 0,0:17:20.28,0:17:21.12,Default,,0,0,0,,(мойынның сықырлаған дыбысы)
Dialogue: 0,0:17:21.24,0:17:21.87,Default,,0,0,0,,Фихьяха! Менің есептеулерім дұрыс!
Dialogue: 0,0:17:21.87,0:17:23.41,Default,,0,0,0,,Фихьяха! Менің есептеулерім дұрыс!
Dialogue: 0,0:17:21.87,0:17:23.41,Default,,0,0,0,,(мойынның сықырлаған дыбысы)
Dialogue: 0,0:17:23.41,0:17:24.41,Default,,0,0,0,,Фихьяха! Менің есептеулерім дұрыс!
Dialogue: 0,0:17:25.29,0:17:28.67,Default,,0,0,0,,А...
Dialogue: 0,0:17:32.63,0:17:34.05,Default,,0,0,0,,Бұл жігіт ше?
Dialogue: 0,0:17:40.05,0:17:41.68,Default,,0,0,0,,А-а-а-а!
Dialogue: 0,0:17:42.35,0:17:45.89,Default,,0,0,0,,Қарға қарға... Көрінбейтін Қара
Dialogue: 0,0:17:46.35,0:17:47.69,Default,,0,0,0,,Ах… Ух…
Dialogue: 0,0:17:47.89,0:17:51.19,Default,,0,0,0,,Құрт жегіш қызықсыз.
Dialogue: 0,0:17:51.31,0:17:53.07,Default,,0,0,0,,Егер бұл дыбыстан жоғары қалақ болса...
Dialogue: 0,0:17:53.19,0:17:55.65,Default,,0,0,0,,Өте жоғары қысымды ауаның қабырғасымен үрлеңіз
Dialogue: 0,0:17:55.90,0:17:57.57,Default,,0,0,0,,О... дыбыс жылдамдығы?
Dialogue: 0,0:17:57.70,0:18:00.66,Default,,0,0,0,,Құрт жегішті дыбыстық буммен өшірдіңіз бе?
Dialogue: 0,0:18:01.03,0:18:01.99,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:18:02.12,0:18:03.45,Default,,0,0,0,,Бұл адам еңбегі ме?
Dialogue: 0,0:18:03.95,0:18:06.45,Default,,0,0,0,,Өйткені, Чиджи-сан керемет...
Dialogue: 0,0:18:07.83,0:18:09.96,Default,,0,0,0,,Менен мүлдем басқа
Dialogue: 0,0:18:13.17,0:18:14.59,Default,,0,0,0,,Ауырды...
Dialogue: 0,0:18:14.88,0:18:18.51,Default,,0,0,0,,Гантаның... ақымақ!
Dialogue: 0,0:18:18.84,0:18:19.88,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:20.47,0:18:21.72,Default,,0,0,0,,Who?
Dialogue: 0,0:18:22.39,0:18:23.68,Default,,0,0,0,,Аха!
Dialogue: 0,0:18:23.81,0:18:27.18,Default,,0,0,0,,Сіз ұмыттыңыз ба? Менің...
Dialogue: 0,0:18:27.81,0:18:29.52,Default,,0,0,0,,А... жоқ, мен туралы.
Dialogue: 0,0:18:29.69,0:18:30.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:31.69,0:18:32.69,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:32.81,0:18:34.82,Default,,0,0,0,,Тағы бір Қан Құбыжық Өнері ме?
Dialogue: 0,0:18:35.40,0:18:37.24,Default,,0,0,0,,Деректер чиптері…
Dialogue: 0,0:18:37.36,0:18:41.11,Default,,0,0,0,,Мен саған көмектессем де, Ганта мені ұрды.
Dialogue: 0,0:18:41.28,0:18:43.87,Default,,0,0,0,,(Нагидің ауыр тынысы)
Dialogue: 0,0:18:44.20,0:18:47.08,Default,,0,0,0,,...Дұрыс, бейне қосылмаған.
Dialogue: 0,0:18:47.20,0:18:50.58,Default,,0,0,0,,Мен Үкіні қуантқым келді.
Dialogue: 0,0:18:50.71,0:18:52.92,Default,,0,0,0,,... Оны жібермеңіз (аккорд бұрышы) иә?
Dialogue: 0,0:18:53.04,0:18:56.38,Default,,0,0,0,,Біз Scar Chain-де...
Dialogue: 0,0:18:57.13,0:18:59.38,Default,,0,0,0,,Өлі адам ғажайыптар әлемі...
Dialogue: 0,0:18:59.63,0:19:05.31,Default,,0,0,0,,Мынау... Мен бұл сандырақ дүниені құртамын, ха...
Dialogue: 0,0:19:05.93,0:19:09.60,Default,,0,0,0,,астында… қабылдаушыға т.б.…
Dialogue: 0,0:19:09.73,0:19:13.65,Default,,0,0,0,,Кім... заттарды жасайды?
Dialogue: 0,0:19:13.77,0:19:16.44,Default,,0,0,0,,Мен көп соққы алдым...
Dialogue: 0,0:19:16.57,0:19:20.95,Default,,0,0,0,,Сіз шынымен ұмыттыңыз ба? Бұл ыңғайлы бас
Dialogue: 0,0:19:21.07,0:19:22.36,Default,,0,0,0,,2 жыл бұрын -
Dialogue: 0,0:19:22.49,0:19:25.66,Default,,0,0,0,,Мен сіздің әйеліңізді (Наги) өлтірсем де...
Dialogue: 0,0:19:25.78,0:19:29.12,Default,,0,0,0,,Осыдан кейін сіз осында кіресіз.
Dialogue: 0,0:19:29.75,0:19:31.79,Default,,0,0,0,,Менің 22 бағыныштымның ішкі мүшелері.
Dialogue: 0,0:19:31.92,0:19:34.50,Default,,0,0,0,,Сен оны әр жерге шашып жібердің.
Dialogue: 0,0:19:34.88,0:19:36.50,Default,,0,0,0,,Не... а...
Dialogue: 0,0:19:36.79,0:19:39.84,Default,,0,0,0,,Менде мұндай әдемі естеліктер жоқ.
Dialogue: 0,0:19:40.13,0:19:42.68,Default,,0,0,0,,Бұл не...?
Dialogue: 0,0:19:43.68,0:19:44.59,Default,,0,0,0,,Хе хе хе...
Dialogue: 0,0:19:46.01,0:19:47.39,Default,,0,0,0,,Біркөз…
Dialogue: 0,0:19:47.47,0:19:49.27,Default,,0,0,0,,Мен шкафтамын
Dialogue: 0,0:19:49.39,0:19:52.39,Default,,0,0,0,,Терінің ағуы және зәр шығаруы, қалтырауы...
Dialogue: 0,0:19:52.52,0:19:54.60,Default,,0,0,0,,Мен сайладым.
Dialogue: 0,0:19:54.94,0:19:56.77,Default,,0,0,0,,(Нагидің ауыр тынысы)
Dialogue: 0,0:19:56.90,0:20:01.78,Default,,0,0,0,,Шіріген екіжүздінің ішінде ол Канноннан да сұлу еді.
Dialogue: 0,0:20:02.03,0:20:04.57,Default,,0,0,0,,Бұл сенсің, солай ма? Оулу
Dialogue: 0,0:20:04.70,0:20:06.03,Default,,0,0,0,,Мынадай нәрсе... хаха
Dialogue: 0,0:20:06.16,0:20:09.45,Default,,0,0,0,,Бұл менің жадым болуы керек... хаха
Dialogue: 0,0:20:09.74,0:20:12.21,Default,,0,0,0,,Есіңде болмаса, сен жындысың.
Dialogue: 0,0:20:12.46,0:20:16.33,Default,,0,0,0,,Кімде-кім мұндай шұңқырда есінен танып қалмаса, ол табиғат ескерткіші.
Dialogue: 0,0:20:16.67,0:20:21.55,Default,,0,0,0,,Undertaker сіздің ақылсыз екеніңізді мақұлдайды!
Dialogue: 0,0:20:28.55,0:20:29.39,Default,,0,0,0,,Ха...
Dialogue: 0,0:20:29.51,0:20:30.72,Default,,0,0,0,,Мен... (барлығы) Иә?
Dialogue: 0,0:20:30.85,0:20:32.39,Default,,0,0,0,,Неліктен бұлай?
Dialogue: 0,0:20:33.10,0:20:35.65,Default,,0,0,0,,Широ мені қорғаса да...
Dialogue: 0,0:20:36.10,0:20:39.27,Default,,0,0,0,,Жан түршігерлік сөздер айтып, мені ұру...
Dialogue: 0,0:20:39.40,0:20:40.78,Default,,0,0,0,,Ах... (Эндо/Чидзи) Хмм...
Dialogue: 0,0:20:40.90,0:20:43.32,Default,,0,0,0,,Қазірдің өзінде Чижи-сан келмегенде...
Dialogue: 0,0:20:43.95,0:20:45.70,Default,,0,0,0,,Сіз қалыпты өмір сүріп жатқанда...
Dialogue: 0,0:20:45.82,0:20:48.70,Default,,0,0,0,,Мен бұлай ойлаған емеспін...
Dialogue: 0,0:20:50.12,0:20:53.12,Default,,0,0,0,,Неге... неге мен...
Dialogue: 0,0:20:53.25,0:20:55.50,Default,,0,0,0,,Сіз соншалықты аяныштысыз ба?
Dialogue: 0,0:20:56.12,0:20:57.04,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:20:57.75,0:20:58.92,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:20:59.04,0:21:01.67,Default,,0,0,0,,Өлі адам ғажайыптар әлемі ақылсыз
Dialogue: 0,0:21:01.80,0:21:05.13,Default,,0,0,0,,Жарайды, бәрінің аузын жабудан немесе жынды болудан басқа амалы жоқ.
Dialogue: 0,0:21:06.09,0:21:09.68,Default,,0,0,0,,Сондықтан біз бұл жынды дүниені жоя алмаймыз!
Dialogue: 0,0:21:09.80,0:21:12.52,Default,,0,0,0,,Хмм... Өтінемін, Қарға.
Dialogue: 0,0:21:12.64,0:21:14.98,Default,,0,0,0,,Сіз біздің жоспарымызға қосыласыз ба?
Dialogue: 0,0:21:15.10,0:21:16.89,Default,,0,0,0,,Бізге мықты адам керек!
Dialogue: 0,0:21:17.23,0:21:19.69,Default,,0,0,0,,Иә, олармен күресуге болады.
Dialogue: 0,0:21:20.02,0:21:22.11,Default,,0,0,0,,Неге маған демалыс бермейсің, Чижи!
Dialogue: 0,0:21:22.69,0:21:25.32,Default,,0,0,0,,Дұрыс, Чижи-сан осында болғанша...
Dialogue: 0,0:21:25.45,0:21:28.28,Default,,0,0,0,,А... хахахаха!
Dialogue: 0,0:21:28.41,0:21:29.62,Default,,0,0,0,,Янакота!
Dialogue: 0,0:21:29.99,0:21:31.53,Default,,0,0,0,,Бұл ақылсыз ба?
Dialogue: 0,0:21:31.74,0:21:34.29,Default,,0,0,0,,...Ха! Сырттан ешнәрсе ерекшеленбейді
Dialogue: 0,0:21:34.70,0:21:36.12,Default,,0,0,0,,Жоқ, бұл өте жақсы.
Dialogue: 0,0:21:36.62,0:21:39.83,Default,,0,0,0,,Бірін-бірі өлтіріп, алдап, күшті аман қалады.
Dialogue: 0,0:21:39.96,0:21:42.30,Default,,0,0,0,,Мұндай қалыпты дүние жоқ!
Dialogue: 0,0:21:42.96,0:21:46.59,Default,,0,0,0,,Топсыз өмір сүре алмайсыз ба?
Dialogue: 0,0:21:46.72,0:21:47.93,Default,,0,0,0,,Менен сұрасаңыз...
Dialogue: 0,0:21:49.22,0:21:52.56,Default,,0,0,0,,«Егер сен әлсіз болсаң, азу тісіңді көрсетпе».
Dialogue: 0,0:21:52.64,0:21:53.81,Default,,0,0,0,,А... а...
Dialogue: 0,0:21:53.93,0:21:55.52,Default,,0,0,0,,Ганта Сен әлсізсің!
Dialogue: 0,0:21:55.64,0:21:58.14,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:22:08.57,0:22:09.78,Default,,0,0,0,,Хаа…
Dialogue: 0,0:22:12.45,0:22:15.20,Default,,0,0,0,,Көңіл-күйіңізді түзетіңіз.
Dialogue: 0,0:22:15.54,0:22:19.17,Default,,0,0,0,,Менің... жоқ, менің атым...
Dialogue: 0,0:22:20.21,0:22:22.29,Default,,0,0,0,,Не?
Dialogue: 0,0:22:22.42,0:22:24.09,Default,,0,0,0,,Широ Мен білмеймін.
Dialogue: 0,0:22:24.50,0:22:26.17,Default,,0,0,0,,Иә!
Dialogue: 0,0:22:26.26,0:22:29.38,Default,,0,0,0,,Сакигами Тото «Күлдіршін»
Dialogue: 0,0:22:29.51,0:22:32.64,Default,,0,0,0,,Танысқаныма қуаныштымын «Жұмыртқаны қайталаңыз»
Dialogue: 0,0:22:33.39,0:22:37.27,Default,,0,0,0,,Уайымдама, мен саған жамандық жасамаймын.
Dialogue: 0,0:22:37.39,0:22:38.73,Default,,0,0,0,,Хмм…
Dialogue: 0,0:22:38.85,0:22:40.52,Default,,0,0,0,,Сізге!
Dialogue: 0,0:22:41.23,0:22:46.23,Default,,0,0,0,,♪~
Dialogue: 0,0:24:06.02,0:24:11.03,Default,,0,0,0,,~♪
Dialogue: 0,0:24:12.32,0:24:14.11,Default,,0,0,0,,Жынды Шураның бұралған күлкісі...
Dialogue: 0,0:24:14.36,0:24:16.20,Default,,0,0,0,,Қызыл жастан аршылған
Dialogue: 0,0:24:16.57,0:24:19.45,Default,,0,0,0,,Ет пен қан жаңбыры қарауға болмайтын аспанды толтырады.
Dialogue: 0,0:24:19.95,0:24:21.62,Default,,0,0,0,,Мәйіттер тобының тіршілік ету ортасы
Dialogue: 0,0:24:22.12,0:24:25.67,Default,,0,0,0,,Бұл өлі адам ғажайыптар әлемі
Dialogue: 0,0:24:27.17,0:24:33.17,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory