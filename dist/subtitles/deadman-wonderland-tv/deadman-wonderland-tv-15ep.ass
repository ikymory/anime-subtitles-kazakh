Dialogue: 0,0:00:00.00,0:00:00.00,*Default,NTP,0000,0000,0000,,--------------------------Қызметкерлер------------------------------------
Dialogue: 0,0:24:11.00,0:24:13.00,staff,NTP,0000,0000,0000,,SGS Shukosha субтитрлер өндірісі http://blog.sgsub.com
Dialogue: 0,0:24:13.00,0:24:15.00,staff,NTP,0000,0000,0000,,Аударма: Киоку алаңы Цукиёши Изайои Хиро Хитомура
Dialogue: 0,0:24:15.00,0:24:17.00,staff,NTP,0000,0000,0000,,&：  ： ：Acid
Dialogue: 0,0:24:17.00,0:24:19.00,staff,NTP,0000,0000,0000,,BD жүйесі және дамуы: Daydream ынтымақтастық: DC
Dialogue: 0,0:00:02.77,0:00:05.31,jp_text,NTP,0000,0000,0000,,Менің ойымша, сіз «жаман дәм» сөзін білмейсіз.
Dialogue: 0,0:00:07.86,0:00:09.69,jp_text,NTP,0000,0000,0000,,Радикалды өнер дегеніміз не?
Dialogue: 0,0:00:09.90,0:00:12.20,jp_text,NTP,0000,0000,0000,,Надан бұқараға жарамсыз
Dialogue: 0,0:00:12.28,0:00:15.70,jp_text,NTP,0000,0000,0000,,Жалпы, бұл жағымсыз болып саналады.
Dialogue: 0,0:00:16.53,0:00:18.08,jp_text,NTP,0000,0000,0000,,Тым көп деп айту
Dialogue: 0,0:00:18.53,0:00:20.41,jp_text,NTP,0000,0000,0000,,Кеше сондай-ақ «иттер жарысы шоуы» болды.
Dialogue: 0,0:00:20.41,0:00:21.33,jp_text,NTP,0000,0000,0000,,Сіз қанша адамды өлтірдіңіз?
Dialogue: 0,0:00:21.45,0:00:23.21,jp_text,NTP,0000,0000,0000,,Өлім жазасына кесілмеген тұтқындар
Dialogue: 0,0:00:23.29,0:00:25.04,jp_text,NTP,0000,0000,0000,,Бұл жаппай қырғын.
Dialogue: 0,0:00:25.21,0:00:27.46,jp_text,NTP,0000,0000,0000,,Біздің қорғанысымыздың шегі бар.
Dialogue: 0,0:00:27.50,0:00:30.88,jp_text,NTP,0000,0000,0000,,Директормен келісіңіз. Мен сенімен енді сөйлесе алмаймын.
Dialogue: 0,0:00:32.17,0:00:34.22,jp_text,NTP,0000,0000,0000,,Мен жауаптымын.
Dialogue: 0,0:00:34.43,0:00:36.84,jp_text,NTP,0000,0000,0000,,Сол қария тірі өлі.
Dialogue: 0,0:00:37.85,0:00:41.43,jp_text,NTP,0000,0000,0000,,Сіз тіпті субсидияларды да алып тастай аласыз.
Dialogue: 0,0:00:43.68,0:00:46.40,jp_text,NTP,0000,0000,0000,,«Бастапқы күнә» Жұмыртқаны қалпына келтіру
Dialogue: 0,0:00:46.60,0:00:50.48,jp_text,NTP,0000,0000,0000,,Осы Өлі адам ғажайып елінде мөрленуді жалғастыру.
Dialogue: 0,0:02:23.66,0:02:26.50,jp_text,NTP,0000,0000,0000,,Дәмді Ганта ше?
Dialogue: 0,0:02:27.12,0:02:28.71,jp_text,NTP,0000,0000,0000,,Иә, жақсы болды.
Dialogue: 0,0:02:29.75,0:02:31.88,jp_text,NTP,0000,0000,0000,,Қайтадан бірге жеңіл тамақ ішейік.
Dialogue: 0,0:02:41.80,0:02:44.06,jp_text,NTP,0000,0000,0000,,Мен...
Dialogue: 0,0:02:45.26,0:02:48.52,jp_text,NTP,0000,0000,0000,,Мен бүгін өлім жазасына кесіледі деп ойлаймын.
Dialogue: 0,0:02:50.94,0:02:53.36,jp_text,NTP,0000,0000,0000,,Кешегі жарыс ессіз болды.
Dialogue: 0,0:02:53.44,0:02:55.90,jp_text,NTP,0000,0000,0000,,Мәйітті жою тобы толығымен жұмылдырылды.
Dialogue: 0,0:02:56.19,0:02:59.65,jp_text,NTP,0000,0000,0000,,Мен жарты жолда зейнеткерлікке шығуға тырыссам да, мен мұны істей алмас едім.
Dialogue: 0,0:02:59.78,0:03:03.57,jp_text,NTP,0000,0000,0000,,Осыншама жерге жеткеннен кейін неге жеңімпаз жоқ екенін түсінбеймін.
Dialogue: 0,0:03:04.12,0:03:06.12,jp_text,NTP,0000,0000,0000,,Келмегеніме қуаныштымын.
Dialogue: 0,0:03:07.25,0:03:08.33,jp_text,NTP,0000,0000,0000,,(Фушигиро) Неге мұнда жүрсің, Зэн'ин-сенпай?
Dialogue: 0,0:03:10.58,0:03:12.29,jp_text,NTP,0000,0000,0000,,Бұл жарыстың қиындық деңгейі қандай?
Dialogue: 0,0:03:12.54,0:03:14.04,jp_text,NTP,0000,0000,0000,,Ештеңе мүмкін емес
Dialogue: 0,0:03:15.00,0:03:17.26,jp_text,NTP,0000,0000,0000,,Мен де сонда болсам, сенімдімін
Dialogue: 0,0:03:20.93,0:03:23.80,jp_text,NTP,0000,0000,0000,,Бұл жаңа бала, Ганта Игараши
Dialogue: 0,0:03:24.47,0:03:26.47,jp_text,NTP,0000,0000,0000,,Оның пайда болуы үшін болды ма?
Dialogue: 0,0:03:30.43,0:03:31.98,jp_text,NTP,0000,0000,0000,,Мимидің әкесіне
Dialogue: 0,0:03:33.02,0:03:35.23,jp_text,NTP,0000,0000,0000,,Өйткені өсиет қалдыратын ешкім жоқ
Dialogue: 0,0:03:35.65,0:03:37.98,jp_text,NTP,0000,0000,0000,,Мимидің әкесіне хат жаз
Dialogue: 0,0:03:38.99,0:03:41.32,jp_text,NTP,0000,0000,0000,,Сіз маған сенбейтін шығарсыз, бірақ
Dialogue: 0,0:03:41.95,0:03:46.16,jp_text,NTP,0000,0000,0000,,Мибиді, Ямакатсуды және сыныптағылардың бәрін кім өлтірді?
Dialogue: 0,0:03:46.62,0:03:47.83,jp_text,NTP,0000,0000,0000,,Мен емес
Dialogue: 0,0:03:49.04,0:03:52.08,jp_text,NTP,0000,0000,0000,,Бүгін мен өлім жазасына кесіледі.
Dialogue: 0,0:04:02.30,0:04:04.55,jp_text,NTP,0000,0000,0000,,Ей, өлгім келмейді.
Dialogue: 0,0:04:06.01,0:04:08.47,jp_text,NTP,0000,0000,0000,,Бұл сіздің ұяңыз осында болды ма?
Dialogue: 0,0:04:10.14,0:04:12.60,jp_text,NTP,0000,0000,0000,,Бір бөлмеде болғанымыз қандай кездейсоқтық.
Dialogue: 0,0:04:13.31,0:04:14.27,jp_text,NTP,0000,0000,0000,,Қой-күн
Dialogue: 0,0:04:14.69,0:04:16.02,jp_text,NTP,0000,0000,0000,,Мен сені іздедім
Dialogue: 0,0:04:16.61,0:04:17.69,jp_text,NTP,0000,0000,0000,,Мен оны сізге бере аламын.
Dialogue: 0,0:04:20.32,0:04:21.86,jp_text,NTP,0000,0000,0000,,Бұл «кәмпит» ме?
Dialogue: 0,0:04:22.74,0:04:26.12,jp_text,NTP,0000,0000,0000,,Мен саған соқтығысып қалғаным үшін ол жоғалды.
Dialogue: 0,0:04:26.70,0:04:28.53,jp_text,NTP,0000,0000,0000,,Мен жауапкершілікті өз мойныма алуым керек деп ойлаймын
Dialogue: 0,0:04:28.66,0:04:29.99,jp_text,NTP,0000,0000,0000,,Мен оны алдым.
Dialogue: 0,0:04:30.45,0:04:31.54,jp_text,NTP,0000,0000,0000,,Оны қабылдаңыз.
Dialogue: 0,0:04:33.04,0:04:33.79,jp_text,NTP,0000,0000,0000,,Та-да!
Dialogue: 0,0:04:33.79,0:04:34.50,jp_text,NTP,0000,0000,0000,,Әрине
Dialogue: 0,0:04:38.84,0:04:40.71,jp_text,NTP,0000,0000,0000,,Енді сіз әлі де өмір сүре аласыз
Dialogue: 0,0:04:41.17,0:04:42.38,jp_text,NTP,0000,0000,0000,,Рахмет, Хицудзи-кун
Dialogue: 0,0:04:42.80,0:04:44.51,jp_text,NTP,0000,0000,0000,,Мен саған өмір бойы қарыздармын.
Dialogue: 0,0:04:46.22,0:04:47.72,jp_text,NTP,0000,0000,0000,,Олай болмаса, қиындыққа тап боласың
Dialogue: 0,0:04:48.14,0:04:50.43,jp_text,NTP,0000,0000,0000,,Ауыр жарақат алсам да алдым.
Dialogue: 0,0:04:51.31,0:04:52.81,jp_text,NTP,0000,0000,0000,,Бірақ бұл промоутер
Dialogue: 0,0:04:53.10,0:04:55.65,jp_text,NTP,0000,0000,0000,,Мына жігіт не нәрсеге сонша құмар?
Dialogue: 0,0:04:56.52,0:04:59.57,jp_text,NTP,0000,0000,0000,,Жаңадан келген баланы бақылай аласыз ба?
Dialogue: 0,0:04:59.98,0:05:01.61,jp_text,NTP,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,0:05:01.90,0:05:05.11,jp_text,NTP,0000,0000,0000,,Қозғалыс немесе өзгеріс болса, бәрі жақсы
Dialogue: 0,0:05:05.15,0:05:06.28,jp_text,NTP,0000,0000,0000,,Есеп
Dialogue: 0,0:05:07.03,0:05:08.37,jp_text,NTP,0000,0000,0000,,Түсіндіру керек пе?
Dialogue: 0,0:05:08.91,0:05:10.99,jp_text,NTP,0000,0000,0000,,Тек Cust Points бар.
Dialogue: 0,0:05:13.33,0:05:15.92,jp_text,NTP,0000,0000,0000,,Сізден артық үлгілі тұтқын жоқ.
Dialogue: 0,0:05:16.92,0:05:19.88,jp_text,NTP,0000,0000,0000,,Жарайды, оны пешка ретінде ұстағанның зияны жоқ.
Dialogue: 0,0:05:23.42,0:05:26.76,jp_text,NTP,0000,0000,0000,,Ештеңе емес, дәмі жаман деген сөз рас.
Dialogue: 0,0:05:27.51,0:05:30.47,jp_text,NTP,0000,0000,0000,,Дұрыс, таңдайымызды тазартатындай тамақ ішейік.
Dialogue: 0,0:05:34.60,0:05:36.02,jp_text,NTP,0000,0000,0000,,Иә, иә
Dialogue: 0,0:05:37.81,0:05:40.23,jp_text,NTP,0000,0000,0000,,«Аналық қаз жүйесі» тоқтады ма?
Dialogue: 0,0:05:41.02,0:05:43.19,Float,NTP,0000,0000,0000,,Қайта жұмыртқа
Dialogue: 0,0:05:41.02,0:05:43.19,jp_text,NTP,0000,0000,0000,,Бастапқы күнә құтылады ма?
Dialogue: 0,0:05:53.58,0:05:55.04,jp_text,NTP,0000,0000,0000,,Промоутер кешіріңіз
Dialogue: 0,0:05:55.33,0:05:58.00,jp_text,NTP,0000,0000,0000,,Тексеру кезінде себебі белгісіз қате орын алған сияқты.
Dialogue: 0,0:05:58.79,0:06:00.92,jp_text,NTP,0000,0000,0000,,Мүмкіндігінше тезірек, тіпті секундтың оннан бір бөлігінде де қайта жүктеңіз!
Dialogue: 0,0:06:01.21,0:06:01.71,jp_text,NTP,0000,0000,0000,,болып табылады
Dialogue: 0,0:06:03.17,0:06:05.42,Float,NTP,0000,0000,0000,,Қайта жұмыртқа
Dialogue: 0,0:06:03.17,0:06:05.42,jp_text,NTP,0000,0000,0000,,Бұрынғы күнә күлді
Dialogue: 0,0:06:18.48,0:06:19.48,jp_text,NTP,0000,0000,0000,,Мен ақша...
Dialogue: 0,0:06:19.77,0:06:22.44,jp_text,NTP,0000,0000,0000,,Келгеніңіздің белгісі ретінде мен сізге той беремін.
Dialogue: 0,0:06:23.02,0:06:24.11,jp_text,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,0:06:31.32,0:06:35.24,jp_text,NTP,0000,0000,0000,,Бұл жігіт шынымен де бүкіл сыныпты өлтірді ме?
Dialogue: 0,0:06:36.29,0:06:38.58,jp_text,NTP,0000,0000,0000,,Ал, тек осындай адамдар үшін.
Dialogue: 0,0:07:06.32,0:07:06.82,jp_text,NTP,0000,0000,0000,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:07:07.61,0:07:08.69,jp_text,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,0:07:09.36,0:07:11.74,jp_text,NTP,0000,0000,0000,,Досты еске түсіру
Dialogue: 0,0:07:13.16,0:07:17.37,jp_text,NTP,0000,0000,0000,,Бұл көңілді болды деп ойлаймын.
Dialogue: 0,0:07:30.13,0:07:32.93,jp_text,NTP,0000,0000,0000,,Ганта-кун Ганта-кун, жақсысың ба?
Dialogue: 0,0:07:38.43,0:07:40.10,jp_text,NTP,0000,0000,0000,,Сен мұнда не үшін келдің?
Dialogue: 0,0:07:45.06,0:07:46.77,jp_text,NTP,0000,0000,0000,,Қызыл…адам
Dialogue: 0,0:07:56.45,0:07:57.79,jp_text,NTP,0000,0000,0000,,Менің қолдарым! !
Dialogue: 0,0:08:06.13,0:08:08.42,jp_text,NTP,0000,0000,0000,,Торнадо? Жарылыс?
Dialogue: 0,0:08:08.96,0:08:11.26,jp_text,NTP,0000,0000,0000,,Жоқ, не болып жатыр?
Dialogue: 0,0:08:16.89,0:08:17.26,jp_text,NTP,0000,0000,0000,,Тағы да…
Dialogue: 0,0:08:21.73,0:08:24.85,jp_text,NTP,0000,0000,0000,,Менің досымды тағы да өлтіресің бе?
Dialogue: 0,0:08:33.49,0:08:34.74,jp_text,NTP,0000,0000,0000,,«Күнәнің тармағы» реакциясы
Dialogue: 0,0:08:38.03,0:08:39.04,jp_text,NTP,0000,0000,0000,,Мұны сенің мойныңа артып отырғаныма өкінемін, бірақ қорғаныс үшін саған сенемін.
Dialogue: 0,0:08:39.95,0:08:42.83,jp_text,NTP,0000,0000,0000,,Кеше… Ах…
Dialogue: 0,0:08:44.00,0:08:47.13,jp_text,NTP,0000,0000,0000,,О, құдай! !
Dialogue: 0,0:08:56.89,0:08:58.18,jp_text,NTP,0000,0000,0000,,Содан кейін кезекте тұрғандарды жақсылап ұрып, ақшаларын тартып алады
Dialogue: 0,0:08:58.68,0:09:00.14,jp_text,NTP,0000,0000,0000,,Сіз қолыңыздан не алдыңыз?
Dialogue: 0,0:09:14.61,0:09:17.41,jp_text,NTP,0000,0000,0000,,Қашпа! Күте тұрыңыз!
Dialogue: 0,0:09:24.33,0:09:26.08,jp_text,NTP,0000,0000,0000,,Ол мойнын қорғап қалды
Dialogue: 0,0:09:29.67,0:09:31.30,jp_text,NTP,0000,0000,0000,,«Аналық қаз жүйесін» қалпына келтіру
Dialogue: 0,0:09:31.84,0:09:33.71,jp_text,NTP,0000,0000,0000,,Бастапқы күнә интерференциясының толқыны расталды
Dialogue: 0,0:09:31.84,0:09:33.71,Float,NTP,0000,0000,0000,,Жұмыртқаны қайталаңыз
Dialogue: 0,0:09:34.55,0:09:36.51,jp_text,NTP,0000,0000,0000,,Түпнұсқа күнәдан құтылу командасы пайда болады
Dialogue: 0,0:09:34.55,0:09:36.51,Float,NTP,0000,0000,0000,,Жұмыртқаны қайталаңыз
Dialogue: 0,0:09:36.72,0:09:39.18,jp_text,NTP,0000,0000,0000,,Аман бол! Бұл кездейсоқтық емес
Dialogue: 0,0:09:39.85,0:09:41.93,jp_text,NTP,0000,0000,0000,,Жаңа тұрғынның дүниеге келуі
Dialogue: 0,0:09:45.14,0:09:46.23,jp_text,NTP,0000,0000,0000,,Қанның иісі
Dialogue: 0,0:09:48.10,0:09:49.40,jp_text,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:09:50.02,0:09:52.78,jp_text,NTP,0000,0000,0000,,Қалжың емес, бұл тым арзан.
Dialogue: 0,0:09:53.23,0:09:56.82,jp_text,NTP,0000,0000,0000,,Мына қызыл жігіт кім? Бұл қандай құбыжық?
Dialogue: 0,0:10:01.33,0:10:04.41,jp_text,NTP,0000,0000,0000,,Ет пен қанның би кезеңіне қош келдіңіздер
Dialogue: 0,0:10:05.25,0:10:08.29,jp_text,NTP,0000,0000,0000,,Нағыз Өлі адам ғажайыптар еліне
Dialogue: 0,0:10:12.42,0:10:13.96,jp_text,NTP,0000,0000,0000,,Уаааааааа
Dialogue: 0,0:10:16.01,0:10:17.26,jp_text,NTP,0000,0000,0000,,Кешіріңіз Ганта
Dialogue: 0,0:10:17.34,0:10:20.05,jp_text,NTP,0000,0000,0000,,Мен ұйықтап жатқандықтан, менде Гантаның тәттілері болды.
Dialogue: 0,0:10:22.72,0:10:23.51,jp_text,NTP,0000,0000,0000,,Арман?
Dialogue: 0,0:10:29.35,0:10:30.31,jp_text,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,0:10:30.73,0:10:32.77,jp_text,NTP,0000,0000,0000,,Аулада теракт болды.
Dialogue: 0,0:10:33.15,0:10:34.28,jp_text,NTP,0000,0000,0000,,Терроризм дегеніміз не?
Dialogue: 0,0:10:35.65,0:10:40.11,jp_text,NTP,0000,0000,0000,,Дұрыс, кеудем ауырып, біртүрлі күш бар...
Dialogue: 0,0:10:40.91,0:10:42.49,jp_text,NTP,0000,0000,0000,,Сол жігіт сияқты күш
Dialogue: 0,0:10:43.24,0:10:47.91,jp_text,NTP,0000,0000,0000,,Иә, қызыл адам, ол осы түрмеде болды.
Dialogue: 0,0:10:49.62,0:10:50.92,jp_text,NTP,0000,0000,0000,,Неліктен мұндай нәрсе?
Dialogue: 0,0:10:51.42,0:10:53.21,jp_text,NTP,0000,0000,0000,,Қызыл…ер адам?
Dialogue: 0,0:10:53.54,0:10:55.00,jp_text,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:10:55.38,0:10:57.47,jp_text,NTP,0000,0000,0000,,Ойланып қарасаңыз, сол кезде де
Dialogue: 0,0:10:59.63,0:11:02.01,jp_text,NTP,0000,0000,0000,,Маған не болды?
Dialogue: 0,0:11:03.10,0:11:04.31,jp_text,NTP,0000,0000,0000,,Мен де көрдім.
Dialogue: 0,0:11:05.60,0:11:07.85,jp_text,NTP,0000,0000,0000,,Қызыл Біртүрлі шектеулермен жабылған
Dialogue: 0,0:11:08.35,0:11:09.52,jp_text,NTP,0000,0000,0000,,Бұл ол болуы керек.
Dialogue: 0,0:11:09.89,0:11:12.27,jp_text,NTP,0000,0000,0000,,Мен оны бұрын көргенмін.
Dialogue: 0,0:11:12.77,0:11:17.19,jp_text,NTP,0000,0000,0000,,Бірнеше жыл бұрын мен осылай біртүрлі құйын қоздырдым.
Dialogue: 0,0:11:17.65,0:11:19.90,jp_text,NTP,0000,0000,0000,,Зауыт қабырғасын жарып жіберген жігіт болды.
Dialogue: 0,0:11:21.70,0:11:26.41,jp_text,NTP,0000,0000,0000,,Оның әлі де G ғимараты деп аталатын жерде қамауда екендігі туралы қауесет бар.
Dialogue: 0,0:11:27.20,0:11:28.83,jp_text,NTP,0000,0000,0000,,Не болды? Ганта
Dialogue: 0,0:11:29.00,0:11:29.66,jp_text,NTP,0000,0000,0000,,G ғимараты
Dialogue: 0,0:11:30.29,0:11:33.63,jp_text,NTP,0000,0000,0000,,Мына жерде қызыл адам бар.
Dialogue: 0,0:11:34.88,0:11:38.05,jp_text,NTP,0000,0000,0000,,Ол менің досымды өлтірді
Dialogue: 0,0:11:52.52,0:11:53.77,jp_text,NTP,0000,0000,0000,,«Цуппаши»
Dialogue: 0,0:12:02.57,0:12:04.07,jp_text,NTP,0000,0000,0000,,Алда әбігер болады
Dialogue: 0,0:12:04.32,0:12:08.16,jp_text,NTP,0000,0000,0000,,Жарылысты экстремистік құқық қорғау ұйымы жасағаны жарияланды.
Dialogue: 0,0:12:08.58,0:12:09.33,jp_text,NTP,0000,0000,0000,,Кінәлі
Dialogue: 0,0:12:09.83,0:12:12.21,jp_text,NTP,0000,0000,0000,,Тамаки промоутері "шешілді" дейді
Dialogue: 0,0:12:12.71,0:12:15.46,jp_text,NTP,0000,0000,0000,,Әлгі қарғыс атқыр түлкінің не ойлап жатқанын білмеймін.
Dialogue: 0,0:12:15.79,0:12:17.30,jp_text,NTP,0000,0000,0000,,Менің бір ойым бар
Dialogue: 0,0:12:18.34,0:12:20.51,jp_text,NTP,0000,0000,0000,,Бұл маңызды анықтамалық тұлға.
Dialogue: 0,0:12:22.51,0:12:24.84,jp_text,NTP,0000,0000,0000,,№ 5580 Бұл бала?
Dialogue: 0,0:12:25.09,0:12:26.76,jp_text,NTP,0000,0000,0000,,Оның біртүрлі құдіреті бар...
Dialogue: 0,0:12:27.51,0:12:31.23,jp_text,NTP,0000,0000,0000,,Мен оның қандай да бір күшті қаруы бар деп болжауға болатын бөлім бар.
Dialogue: 0,0:12:31.81,0:12:34.15,jp_text,NTP,0000,0000,0000,,Бірақ бас сақшы Макина, бұл...
Dialogue: 0,0:12:34.15,0:12:35.69,jp_text,NTP,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,0:12:38.02,0:12:41.78,jp_text,NTP,0000,0000,0000,,Қаруды ішіңізде сақтамасаңыз.
Dialogue: 0,0:12:43.49,0:12:44.78,jp_text,NTP,0000,0000,0000,,Біздің мақтанышымыз
Dialogue: 0,0:12:45.07,0:12:48.78,jp_text,NTP,0000,0000,0000,,Осы Deadman Wonderland қауіпсіздігі мен тәртібін қорғау.
Dialogue: 0,0:12:49.04,0:12:51.95,jp_text,NTP,0000,0000,0000,,Әңгіме бәрі бар деген қағиданың адасуына еру туралы емес.
Dialogue: 0,0:12:52.54,0:12:53.83,jp_text,NTP,0000,0000,0000,,коды «барлығы қызыл»
Dialogue: 0,0:12:54.12,0:12:57.25,jp_text,NTP,0000,0000,0000,,Оның қамқорлығын тез және сенімді түрде қамтамасыз етіңіз.
Dialogue: 0,0:12:57.59,0:12:58.13,jp_text,NTP,0000,0000,0000,,Ха!
Dialogue: 0,0:12:58.59,0:12:59.96,jp_text,NTP,0000,0000,0000,,Салқын
Dialogue: 0,0:13:00.17,0:13:01.38,jp_text,NTP,0000,0000,0000,,Канг бас бақылаушы
Dialogue: 0,0:13:01.59,0:13:03.47,jp_text,NTP,0000,0000,0000,,Сіз оны пайдаланасыз ба?
Dialogue: 0,0:13:04.09,0:13:06.76,jp_text,NTP,0000,0000,0000,,Төтенше бұйрықтарды кодтарға қосудың мәні неде?
Dialogue: 0,0:13:07.01,0:13:07.30,jp_text,NTP,0000,0000,0000,,Ха!
Dialogue: 0,0:13:08.01,0:13:11.81,jp_text,NTP,0000,0000,0000,,Қажетсіз түсіндірулерді жою Бұл оқиғаларды тезірек шешу үшін қажет
Dialogue: 0,0:13:12.14,0:13:13.35,jp_text,NTP,0000,0000,0000,,Өзіңіз білетіндей
Dialogue: 0,0:13:13.73,0:13:14.31,jp_text,NTP,0000,0000,0000,,Ха!
Dialogue: 0,0:13:14.94,0:13:16.77,jp_text,NTP,0000,0000,0000,,Әрбір нысанды төтенше жағдайда жабу
Dialogue: 0,0:13:18.19,0:13:19.90,jp_text,NTP,0000,0000,0000,,«Necro Macro» қауіпсіздігі
Dialogue: 0,0:13:20.32,0:13:21.78,jp_text,NTP,0000,0000,0000,,Құлыпты реттілікпен ашу
Dialogue: 0,0:13:21.98,0:13:25.36,jp_text,NTP,0000,0000,0000,,Растау коды 2DOD 7785
Dialogue: 0,0:13:31.62,0:13:34.91,jp_text,NTP,0000,0000,0000,,Төрт жыл бұрын мен оны қатыгез тұтқынға қолданғанмын.
Dialogue: 0,0:13:35.41,0:13:37.54,jp_text,NTP,0000,0000,0000,,24 адам қаза тапты
Dialogue: 0,0:13:37.79,0:13:39.71,jp_text,NTP,0000,0000,0000,,Бұл енді қолдануға болмайтын алмастырғыш.
Dialogue: 0,0:13:40.84,0:13:44.55,jp_text,NTP,0000,0000,0000,,Бала бұдан да көп зардап шегу қаупі бар дейсіз бе?
Dialogue: 0,0:13:45.38,0:13:46.47,jp_text,NTP,0000,0000,0000,,Осымен
Dialogue: 0,0:13:47.47,0:13:50.26,jp_text,NTP,0000,0000,0000,,Қазір коменданттық сағат жарияланды.
Dialogue: 0,0:13:51.26,0:13:53.43,jp_text,NTP,0000,0000,0000,,Барлық қызметкерлер мен тұтқындар
Dialogue: 0,0:13:53.68,0:13:55.81,jp_text,NTP,0000,0000,0000,,Дереу ұяшыққа оралыңыз.
Dialogue: 0,0:13:55.85,0:13:57.90,jp_text,NTP,0000,0000,0000,,Жағдай шешілгенше күтіңіз.
Dialogue: 0,0:13:58.40,0:14:01.90,jp_text,NTP,0000,0000,0000,,Тез арада №5580 хабарлаңыз.
Dialogue: 0,0:14:02.86,0:14:05.95,jp_text,NTP,0000,0000,0000,,Макина-сан тым қобалжыды.
Dialogue: 0,0:14:06.32,0:14:08.61,jp_text,NTP,0000,0000,0000,,Ганта-кун зақымданса ше?
Dialogue: 0,0:14:08.70,0:14:11.24,jp_text,NTP,0000,0000,0000,,Сіз супервайзер ретінде өз жауапкершілігіңізді қалай алғыңыз келеді?
Dialogue: 0,0:14:11.37,0:14:12.62,jp_text,NTP,0000,0000,0000,,Таками Йо-кун
Dialogue: 0,0:14:13.20,0:14:15.20,jp_text,NTP,0000,0000,0000,,Сіз құбыжық амулет жасай аласыз ба?
Dialogue: 0,0:14:15.58,0:14:17.58,jp_text,NTP,0000,0000,0000,,Олар не деген сұмдық?
Dialogue: 0,0:14:20.33,0:14:22.00,jp_text,NTP,0000,0000,0000,,Жұмыртқаны қайталаңыз
Dialogue: 0,0:14:22.42,0:14:24.88,jp_text,NTP,0000,0000,0000,,Қызыл плащ киген адам сәтті қолға түсті.
Dialogue: 0,0:14:25.38,0:14:25.99,jp_text,NTP,0000,0000,0000,,Ганта-кун
Dialogue: 0,0:14:25.99,0:14:29.43,jp_text,NTP,0000,0000,0000,,Сіз нағыз Өлі адам ғажайыптар еліне шақырылған қонақсыз.
Dialogue: 0,0:14:29.89,0:14:31.85,jp_text,NTP,0000,0000,0000,,Мен саған жақсы көңіл бөлгім келеді.
Dialogue: 0,0:14:32.89,0:14:33.89,jp_text,NTP,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:14:35.14,0:14:37.60,jp_text,NTP,0000,0000,0000,,Бұл сізге де жақсырақ.
Dialogue: 0,0:14:42.36,0:14:45.32,jp_text,NTP,0000,0000,0000,,№ 5580 дереу шығуыңызды сұраймыз
Dialogue: 0,0:14:45.78,0:14:49.82,jp_text,NTP,0000,0000,0000,,Қайталап айтамын, тез арада No5580 хабарлаңыз.
Dialogue: 0,0:14:48.91,0:14:51.62,jp_text,NTP,0000,0000,0000,,№5580 мен туралы ма?
Dialogue: 0,0:14:51.91,0:14:53.16,jp_text,NTP,0000,0000,0000,,Сіз мұны не үшін оқып отырсыз?
Dialogue: 0,0:14:53.49,0:14:55.58,jp_text,NTP,0000,0000,0000,,Эй, Ганта, не болды?
Dialogue: 0,0:14:55.66,0:14:56.70,jp_text,NTP,0000,0000,0000,,Қайда бара жатырсың?
Dialogue: 0,0:14:56.79,0:14:58.37,jp_text,NTP,0000,0000,0000,,Әзірше осы...
Dialogue: 0,0:14:58.58,0:15:00.83,jp_text,NTP,0000,0000,0000,,Жарайды, бұл жүгіру жарысы.
Dialogue: 0,0:15:09.88,0:15:11.18,jp_text,NTP,0000,0000,0000,,29-шы эпизод: Мақсат – Рим! Колизей
Dialogue: 0,0:15:11.64,0:15:14.39,jp_text,NTP,0000,0000,0000,,Қауіпсіздіктің ең жоғары деңгейі шығарылды.
Dialogue: 0,0:15:15.97,0:15:16.85,jp_text,NTP,0000,0000,0000,,Қой-күн
Dialogue: 0,0:15:16.89,0:15:19.77,jp_text,NTP,0000,0000,0000,,Ганта-кун, егер сіз пайда болу бұйрығын елемейтін болсаңыз ше?
Dialogue: 0,0:15:19.98,0:15:21.40,jp_text,NTP,0000,0000,0000,,Сен де мен сияқты былжырап кетесің
Dialogue: 0,0:15:24.36,0:15:27.07,jp_text,NTP,0000,0000,0000,,Басқа қиындық тудырмаңыз.
Dialogue: 0,0:15:27.69,0:15:30.49,jp_text,NTP,0000,0000,0000,,Хицудзи-кун, кешіріңіз, мен асығып тұрмын.
Dialogue: 0,0:15:30.99,0:15:32.57,jp_text,NTP,0000,0000,0000,,Сіз жүгіру жарысын өткізесіз бе?
Dialogue: 0,0:15:32.74,0:15:33.41,jp_text,NTP,0000,0000,0000,,Түсінікті.
Dialogue: 0,0:15:33.41,0:15:34.24,jp_text,NTP,0000,0000,0000,,Чигау!
Dialogue: 0,0:15:35.41,0:15:38.08,jp_text,NTP,0000,0000,0000,,Хицудзи-кун, мына қызыл адамды да қара.
Dialogue: 0,0:15:38.70,0:15:41.08,jp_text,NTP,0000,0000,0000,,Сол бір ғажап күшпен, досым...
Dialogue: 0,0:15:41.79,0:15:45.13,jp_text,NTP,0000,0000,0000,,Мен достарымның әрқайсысын өлтірдім.
Dialogue: 0,0:15:46.34,0:15:47.26,jp_text,NTP,0000,0000,0000,,Барлығы?
Dialogue: 0,0:15:48.21,0:15:50.63,jp_text,NTP,0000,0000,0000,,Мұндағы тұтқын қашып кетіп, кісі өлтірді ме?
Dialogue: 0,0:15:51.09,0:15:52.55,jp_text,NTP,0000,0000,0000,,Мұны қалай жасауға болады...
Dialogue: 0,0:15:52.80,0:15:55.22,jp_text,NTP,0000,0000,0000,,Мен ол адам Г корпусының артында екенін естідім.
Dialogue: 0,0:15:56.26,0:15:58.60,jp_text,NTP,0000,0000,0000,,Сондықтан мен кетуім керек
Dialogue: 0,0:15:58.93,0:16:01.27,jp_text,NTP,0000,0000,0000,,G ғимараты? Ондай нәрсе жоқ.
Dialogue: 0,0:16:02.73,0:16:07.40,jp_text,NTP,0000,0000,0000,,Қараңызшы, мұнда А корпусынан F корпусына дейін тек алты ұяшық блогы бар.
Dialogue: 0,0:16:08.19,0:16:09.53,jp_text,NTP,0000,0000,0000,,Сонымен G құрылысы дегеніміз не?
Dialogue: 0,0:16:09.90,0:16:10.90,jp_text,NTP,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:16:11.57,0:16:14.82,jp_text,NTP,0000,0000,0000,,Ганта-кун, тезірек тапсыру керек.
Dialogue: 0,0:16:14.91,0:16:15.78,jp_text,NTP,0000,0000,0000,,G ғимараты?
Dialogue: 0,0:16:17.95,0:16:21.41,jp_text,NTP,0000,0000,0000,,Мен G-ге бара аламын. Шығу жолын білемін.
Dialogue: 0,0:16:21.66,0:16:22.75,jp_text,NTP,0000,0000,0000,,Бұл рас па, Широ?
Dialogue: 0,0:16:26.21,0:16:27.71,jp_text,NTP,0000,0000,0000,,Бірақ мен сізге айтпаймын.
Dialogue: 0,0:16:27.80,0:16:31.63,jp_text,NTP,0000,0000,0000,,Иә? Неге ісіп кеттіңіз?
Dialogue: 0,0:16:31.80,0:16:33.30,jp_text,NTP,0000,0000,0000,,Білмесеңіз айтыңызшы.
Dialogue: 0,0:16:33.51,0:16:34.43,jp_text,NTP,0000,0000,0000,,Өйткені...
Dialogue: 0,0:16:36.10,0:16:36.97,jp_text,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:16:36.97,0:16:37.89,jp_text,NTP,0000,0000,0000,,Тыныш
Dialogue: 0,0:16:55.49,0:16:56.37,jp_text,NTP,0000,0000,0000,,Қ-қандай?
Dialogue: 0,0:16:58.78,0:17:00.16,jp_text,NTP,0000,0000,0000,,Бұл қауіпсіздік роботы.
Dialogue: 0,0:17:00.58,0:17:01.66,jp_text,NTP,0000,0000,0000,,Мақсат - сіз
Dialogue: 0,0:17:02.54,0:17:04.00,jp_text,NTP,0000,0000,0000,,Широ Шығу жолы қандай?
Dialogue: 0,0:17:04.42,0:17:05.29,jp_text,NTP,0000,0000,0000,,Айтпа
Dialogue: 0,0:17:05.33,0:17:07.71,jp_text,NTP,0000,0000,0000,,Мен оны енді түсінбеймін
Dialogue: 0,0:17:09.88,0:17:10.55,jp_text,NTP,0000,0000,0000,,Широ-чан
Dialogue: 0,0:17:10.96,0:17:11.96,jp_text,NTP,0000,0000,0000,,Чиро о!
Dialogue: 0,0:17:14.68,0:17:16.43,jp_text,NTP,0000,0000,0000,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:17:21.81,0:17:22.68,jp_text,NTP,0000,0000,0000,,Аздап бассаңыз
Dialogue: 0,0:17:22.81,0:17:25.14,jp_text,NTP,0000,0000,0000,,Бұл жерден көптеген жерлерге баруға болады.
Dialogue: 0,0:17:25.94,0:17:26.85,jp_text,NTP,0000,0000,0000,,Бір сәт?
Dialogue: 0,0:17:30.15,0:17:31.40,jp_text,NTP,0000,0000,0000,,Мақсат табылды
Dialogue: 0,0:17:31.90,0:17:34.65,jp_text,NTP,0000,0000,0000,,No 5580 No 9061 куәландырылған
Dialogue: 0,0:17:35.03,0:17:36.66,jp_text,NTP,0000,0000,0000,,Балшықпен де солай ма?
Dialogue: 0,0:17:37.24,0:17:37.95,jp_text,NTP,0000,0000,0000,,Оны қуып жіберіңіз
Dialogue: 0,0:17:42.87,0:17:44.16,jp_text,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:18:02.77,0:18:05.02,jp_text,NTP,0000,0000,0000,,Сіз бұл роботты өлтіргіңіз келе ме?
Dialogue: 0,0:18:05.60,0:18:08.06,jp_text,NTP,0000,0000,0000,,Күзетшілер нені білдіреді?
Dialogue: 0,0:18:16.70,0:18:17.57,jp_text,NTP,0000,0000,0000,,Мұнда
Dialogue: 0,0:18:18.70,0:18:19.91,jp_text,NTP,0000,0000,0000,,Кочи Кокчи
Dialogue: 0,0:18:34.63,0:18:36.22,jp_text,NTP,0000,0000,0000,,Тоқтады Ол тоқтады ма?
Dialogue: 0,0:18:37.80,0:18:39.30,jp_text,NTP,0000,0000,0000,,Хицудзи-кун, сен не істедің?
Dialogue: 0,0:18:39.84,0:18:42.01,jp_text,NTP,0000,0000,0000,,Жаман әдеттердің болуы пайдалы.
Dialogue: 0,0:18:42.72,0:18:43.51,jp_text,NTP,0000,0000,0000,,Әдет?
Dialogue: 0,0:18:43.76,0:18:44.68,jp_text,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,0:18:44.77,0:18:46.35,jp_text,NTP,0000,0000,0000,,тез, қазір
Dialogue: 0,0:19:01.57,0:19:03.95,jp_text,NTP,0000,0000,0000,,Неге сонша ашуланасың?
Dialogue: 0,0:19:14.88,0:19:16.84,jp_text,NTP,0000,0000,0000,,Бұл G ғимараты.
Dialogue: 0,0:19:23.64,0:19:26.14,jp_text,NTP,0000,0000,0000,,Ішінде қызыл адам бар...
Dialogue: 0,0:19:45.41,0:19:47.08,jp_text,NTP,0000,0000,0000,,Мақсатты реакция жоғалды
Dialogue: 0,0:19:47.54,0:19:49.58,jp_text,NTP,0000,0000,0000,,«Necro Macro» реакциясы да жоғалып кетті
Dialogue: 0,0:19:50.58,0:19:51.67,jp_text,NTP,0000,0000,0000,,Макина күзетшісі
Dialogue: 0,0:19:51.87,0:19:54.21,jp_text,NTP,0000,0000,0000,,Олардың бәрі кенеттен жоғалып кетуі мүмкін емес.
Dialogue: 0,0:19:55.34,0:19:57.30,jp_text,NTP,0000,0000,0000,,Егер мұндай нәрсе болса
Dialogue: 0,0:19:58.67,0:20:00.63,jp_text,NTP,0000,0000,0000,,Осы өлі адам ғажайыптар елінде
Dialogue: 0,0:20:00.63,0:20:04.05,jp_text,NTP,0000,0000,0000,,Бұдан шығатыны, менің юрисдикциямнан тыс жерлер бар.
Dialogue: 0,0:20:05.05,0:20:06.60,jp_text,NTP,0000,0000,0000,,Әлгі түлкі
Dialogue: 0,0:20:12.81,0:20:14.27,jp_text,NTP,0000,0000,0000,,Сіз осы уақытқа дейін келдіңіз
Dialogue: 0,0:20:17.11,0:20:19.74,jp_text,NTP,0000,0000,0000,,Хицудзи-кун Широ, кешіріңіз.
Dialogue: 0,0:20:20.36,0:20:22.49,jp_text,NTP,0000,0000,0000,,Олардың еш қатысы болмаса да, сіз екі адамды қатыстырдыңыз.
Dialogue: 0,0:20:23.36,0:20:24.70,jp_text,NTP,0000,0000,0000,,Кешіріңіз! !
Dialogue: 0,0:20:28.04,0:20:30.75,jp_text,NTP,0000,0000,0000,,Рас, енді кеш болды, боқта.
Dialogue: 0,0:20:39.63,0:20:41.63,jp_text,NTP,0000,0000,0000,,Идиот! !
Dialogue: 0,0:20:46.30,0:20:47.56,jp_text,NTP,0000,0000,0000,,Гантаның идиоты
Dialogue: 0,0:20:48.39,0:20:49.97,jp_text,NTP,0000,0000,0000,,Роботты теу
Dialogue: 0,0:20:50.18,0:20:51.43,jp_text,NTP,0000,0000,0000,,Қаншалықты қисынсыз...
Dialogue: 0,0:20:52.06,0:20:53.48,jp_text,NTP,0000,0000,0000,,Барка Барка
Dialogue: 0,0:20:53.64,0:20:55.15,jp_text,NTP,0000,0000,0000,,Оның маған қатысы жоқ.
Dialogue: 0,0:20:55.27,0:20:56.23,jp_text,NTP,0000,0000,0000,,Біз доспыз
Dialogue: 0,0:20:56.61,0:20:58.48,jp_text,NTP,0000,0000,0000,,Неліктен бәрі өлтірілді?
Dialogue: 0,0:20:58.98,0:21:02.20,jp_text,NTP,0000,0000,0000,,Жарайды, мен ұйықтап жатқанда тамақ жедім.
Dialogue: 0,0:21:02.86,0:21:05.11,jp_text,NTP,0000,0000,0000,,Мен де Гантаның досымын!
Dialogue: 0,0:21:06.28,0:21:08.16,jp_text,NTP,0000,0000,0000,,Бұл сізді ашуландырды ма?
Dialogue: 0,0:21:09.33,0:21:10.70,jp_text,NTP,0000,0000,0000,,Түсіндім, төменге түс.
Dialogue: 0,0:21:11.12,0:21:12.96,jp_text,NTP,0000,0000,0000,,Ондай жерде болу қауіпті.
Dialogue: 0,0:21:15.00,0:21:20.71,jp_text,NTP,0000,0000,0000,,Түсіндім, тағы да дос таптым.
Dialogue: 0,0:21:17.42,0:21:22.01,jp_text,NTP,0000,0000,0000,,Ганта Баака Баака
Dialogue: 0,0:21:22.22,0:21:23.84,jp_text,NTP,0000,0000,0000,,Кешіріңіз Широ
Dialogue: 0,0:21:33.81,0:21:35.81,jp_text,NTP,0000,0000,0000,,Қарғыс атсын, тоқтат!
Dialogue: 0,0:21:40.40,0:21:44.32,jp_text,NTP,0000,0000,0000,,Иә, сол күш, сол күш.
Dialogue: 0,0:21:48.32,0:21:50.45,jp_text,NTP,0000,0000,0000,,Шық, шық, қарғыс атсын.
Dialogue: 0,0:21:50.91,0:21:52.54,jp_text,NTP,0000,0000,0000,,Не қарғыс атсын?
Dialogue: 0,0:21:53.50,0:21:54.71,jp_text,NTP,0000,0000,0000,,Неліктен шықпайды?
Dialogue: 0,0:21:57.83,0:21:59.96,jp_text,NTP,0000,0000,0000,,(Сузуя) Ал сен неге Гульге айналдың?
Dialogue: 0,0:22:38.75,0:22:39.92,jp_text,NTP,0000,0000,0000,,«Зуппаши»
Dialogue: 0,0:24:12.39,0:24:13.39,jp_text,NTP,0000,0000,0000,,«Күнәнің тармағы»
Dialogue: 0,0:24:13.80,0:24:16.89,jp_text,NTP,0000,0000,0000,,Бұл басқа күшке ие басқа біреу бар.
Dialogue: 0,0:24:17.60,0:24:19.73,jp_text,NTP,0000,0000,0000,,Тұмсықсыз тұтқын тоқылдақ
Dialogue: 0,0:24:20.23,0:24:22.44,jp_text,NTP,0000,0000,0000,,Ол жылау тіпті сыбырлау емес
Dialogue: 0,0:24:22.69,0:24:25.02,jp_text,NTP,0000,0000,0000,,Абсурдтық тордың түбінде жоғалып
Dialogue: 0,0:01:13.59,0:01:17.84,op,NTP,0000,0000,0000,,Ақыл мен шындықты қатаң бақылау
Dialogue: 0,0:01:18.05,0:01:22.39,op,NTP,0000,0000,0000,,Өзімді кесіп, олардың ессіздігі үшін айқайлаймын
Dialogue: 0,0:01:22.39,0:01:26.77,op,NTP,0000,0000,0000,,Ешқашан бітпейтін қорқынышты түспен ояныңыз
Dialogue: 0,0:01:26.77,0:01:31.27,op,NTP,0000,0000,0000,,Бұл бұралған бас жоспардың басты тартымдылығы
Dialogue: 0,0:01:44.29,0:01:48.50,op,NTP,0000,0000,0000,,Мен сенің өлген адамың боламын
Dialogue: 0,0:01:48.62,0:01:52.92,op,NTP,0000,0000,0000,,Менің қолымдағы қаннан басқа ештеңе жоқ
Dialogue: 0,0:01:53.00,0:01:57.34,op,NTP,0000,0000,0000,,Сіздің ғажайыптар елінде қалдыңыз
Dialogue: 0,0:01:57.47,0:02:01.85,op,NTP,0000,0000,0000,,Мен де мен сияқты сені қансыратқым келеді
Dialogue: 0,0:02:01.85,0:02:06.18,op,NTP,0000,0000,0000,,Ендеше мені өлген адам ет
Dialogue: 0,0:02:06.31,0:02:10.56,op,NTP,0000,0000,0000,,Тамырымда тек умен
Dialogue: 0,0:02:10.65,0:02:14.78,op,NTP,0000,0000,0000,,Сіздің ғажайыптар елінде қалдыңыз
Dialogue: 0,0:02:14.86,0:02:17.20,op,NTP,0000,0000,0000,,Мен жасауым керек шайқаста қалдым
Dialogue: 0,0:02:17.28,0:02:20.03,op,NTP,0000,0000,0000,,Мен сені мен сияқты қансыратамын
Dialogue: 0,0:22:49.30,0:22:52.26,EDJP,NTP,0000,0000,0000,,Рюсей қара және түн
Dialogue: 0,0:22:52.26,0:22:55.64,EDJP,NTP,0000,0000,0000,,Мен мәңгілікке жылауды тоқтата алмаймын
Dialogue: 0,0:22:56.02,0:23:04.23,EDJP,NTP,0000,0000,0000,,Мен бұл сандырақ дүниені жек көрдім
Dialogue: 0,0:23:04.48,0:23:12.78,EDJP,NTP,0000,0000,0000,,Мен бұл лабиринттен шығусыз құтылғым келеді.
Dialogue: 0,0:23:12.99,0:23:16.87,EDJP,NTP,0000,0000,0000,,Мен бостандықты қаладым
Dialogue: 0,0:23:18.96,0:23:25.88,EDJP,NTP,0000,0000,0000,,Қол ұстасып, аспанға қара
Dialogue: 0,0:23:26.55,0:23:34.10,EDJP,NTP,0000,0000,0000,,Мен кешегіден ерекше болдым
Dialogue: 0,0:23:34.26,0:23:40.85,EDJP,NTP,0000,0000,0000,,Жарқыраған Жылтыр Жарқыраған жұлдыздар шексіз
Dialogue: 0,0:23:41.02,0:23:49.49,EDJP,NTP,0000,0000,0000,,Бұл дүние сондай әдемі
Dialogue: 0,0:23:49.61,0:23:56.41,EDJP,NTP,0000,0000,0000,,Жарқыраған Жарқыраған Ай сәулесі Үмітке толы
Dialogue: 0,0:23:56.45,0:24:04.25,EDJP,NTP,0000,0000,0000,,Бұл дүние өте керемет
Dialogue: 0,0:24:04.29,0:24:07.00,EDJP,NTP,0000,0000,0000,,Менің ойымша.
Dialogue: 0,0:24:26.52,0:24:32.52,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
