Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.23,0:00:12.90,jp_text,NTP,0000,0000,0000,,Бұл сіз орындайтын шоу――
Dialogue: 0,0:00:13.40,0:00:15.74,jp_text,NTP,0000,0000,0000,,Карцерал фестиваліне шолу
Dialogue: 0,0:00:13.40,0:00:15.74,Float,NTP,0000,0000,0000,,Карнавал полициясы
Dialogue: 0,0:00:15.99,0:00:17.87,jp_text,NTP,0000,0000,0000,,Егер сіз ұтып алсаңыз, «Кәмпит» және Кест
Dialogue: 0,0:00:18.20,0:00:19.54,jp_text,NTP,0000,0000,0000,,Жеңілсең өлесің.
Dialogue: 0,0:00:20.16,0:00:21.45,jp_text,NTP,0000,0000,0000,,Бұл оңай болуы керек
Dialogue: 0,0:00:23.21,0:00:26.13,jp_text,NTP,0000,0000,0000,,Сіздің қарсыласыңыз - Қарға. Сіз оны бұрыннан кездестірдіңіз.
Тіпті
Dialogue: 0,0:00:26.63,0:00:28.79,jp_text,NTP,0000,0000,0000,,Атлетикалық бұлшықетті ақымақ
Dialogue: 0,0:00:29.55,0:00:32.59,jp_text,NTP,0000,0000,0000,,бұлшық еттен жасалған деген қауесет бар.
Dialogue: 0,0:00:33.34,0:00:35.38,jp_text,NTP,0000,0000,0000,,Қорқудың қажеті жоқ
Dialogue: 0,0:00:36.09,0:00:37.76,jp_text,NTP,0000,0000,0000,,«Өлген адамдар» арасындағы шайқаста
Dialogue: 0,0:00:38.01,0:00:40.18,jp_text,NTP,0000,0000,0000,,Бұлшықет массасының оған қатысы жоқ.
Dialogue: 0,0:00:46.06,0:00:48.48,jp_text,NTP,0000,0000,0000,,Мұндай адамды қалай жеңуге болады...
Dialogue: 0,0:00:57.07,0:01:00.28,jp_text,NTP,0000,0000,0000,,Жоғалсаңыз немесе өлсеңіз де маңызды зерттеу тақырыбы
Dialogue: 0,0:01:01.66,0:01:03.20,jp_text,NTP,0000,0000,0000,,өзінің нағыз Кира екенін дәлелдеуге бағытталған алдын ала ойластырылған кісі өлтіру
Dialogue: 0,0:01:03.75,0:01:07.50,jp_text,NTP,0000,0000,0000,,Сондықтан уайымдамаңыз.
Dialogue: 0,0:01:19.80,0:01:22.31,jp_text,NTP,0000,0000,0000,,Директор қазір сізге келуден бас тартып отыр.
Dialogue: 0,0:01:23.22,0:01:26.02,jp_text,NTP,0000,0000,0000,,Келесі жолы тағы кездесеміз деп үміттенеміз.
Dialogue: 0,0:01:26.60,0:01:28.60,jp_text,NTP,0000,0000,0000,,Менің қоятын шұғыл сұрағым бар.
Dialogue: 0,0:01:29.23,0:01:30.48,jp_text,NTP,0000,0000,0000,,Кешіріңіз, бірақ мен сізге рұқсат етемін.
Dialogue: 0,0:01:34.24,0:01:35.78,jp_text,NTP,0000,0000,0000,,Келесі кездескенше
Dialogue: 0,0:03:53.25,0:03:55.92,jp_text,NTP,0000,0000,0000,,Қарғыс атсын анау шіріген күзетші.
Dialogue: 0,0:03:56.42,0:03:59.46,jp_text,NTP,0000,0000,0000,,Осы Cust картасында қанша бар деп ойлайсыз?
Dialogue: 0,0:04:16.90,0:04:20.11,jp_text,NTP,0000,0000,0000,,Ей, тезірек Гантаға көмектесуге оралайық.
Dialogue: 0,0:04:20.53,0:04:22.49,jp_text,NTP,0000,0000,0000,,Менің де барғым келеді.
Dialogue: 0,0:04:24.11,0:04:27.03,jp_text,NTP,0000,0000,0000,,Мені қуып шыққан есік қозғалмайды.
Dialogue: 0,0:04:27.99,0:04:30.79,jp_text,NTP,0000,0000,0000,,Сіз бір рет пайдаланған маршрут бұғатталуы мүмкін.
Dialogue: 0,0:04:31.50,0:04:33.29,jp_text,NTP,0000,0000,0000,,Басқа әдіс қарастырылмаса
Dialogue: 0,0:04:36.46,0:04:38.34,jp_text,NTP,0000,0000,0000,,Сіз Ганта-кун үшін алаңдайсыз ба?
Dialogue: 0,0:04:38.92,0:04:41.71,jp_text,NTP,0000,0000,0000,,Оның да сондай бір ғажап күші бар.
Dialogue: 0,0:04:42.22,0:04:44.22,jp_text,NTP,0000,0000,0000,,Бірдеңе болып қалса да, бәрібір.
Dialogue: 0,0:04:46.22,0:04:48.43,jp_text,NTP,0000,0000,0000,,Ганта әрқашан жаман бала болды.
Dialogue: 0,0:04:50.06,0:04:50.89,jp_text,NTP,0000,0000,0000,,Баяғыда?
Dialogue: 0,0:04:53.06,0:04:56.15,jp_text,NTP,0000,0000,0000,,Өйткені Ганта әлсіз.
Dialogue: 0,0:05:02.53,0:05:05.82,jp_text,NTP,0000,0000,0000,,Сәлеметсіз бе! Ханымдар мен мырзалар
Dialogue: 0,0:05:06.32,0:05:09.03,jp_text,NTP,0000,0000,0000,,Келгеніңіз үшін рахмет
Dialogue: 0,0:05:09.24,0:05:11.54,jp_text,NTP,0000,0000,0000,,Карнавал мәйіті!
Dialogue: 0,0:05:19.54,0:05:21.25,jp_text,NTP,0000,0000,0000,,«Өлілер» арасындағы қақтығыс
Dialogue: 0,0:05:21.46,0:05:22.51,jp_text,NTP,0000,0000,0000,,Өлік фестивалі
Dialogue: 0,0:05:21.46,0:05:22.51,Float,NTP,0000,0000,0000,,Карнавал полициясы
Dialogue: 0,0:05:22.88,0:05:24.13,jp_text,NTP,0000,0000,0000,,Әдеттегідей ережелер
Dialogue: 0,0:05:24.26,0:05:27.09,jp_text,NTP,0000,0000,0000,,Олардың біреуі әрекетке қабілетсіз болғанға немесе қайтыс болғанға дейін.
Dialogue: 0,0:05:28.01,0:05:28.80,jp_text,NTP,0000,0000,0000,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:05:29.55,0:05:30.97,jp_text,NTP,0000,0000,0000,,«Өлі адамның» пайда болуы
Dialogue: 0,0:05:35.39,0:05:38.77,jp_text,NTP,0000,0000,0000,,Ардагер қара тырнақ «Қарға»
Dialogue: 0,0:05:40.44,0:05:43.86,jp_text,NTP,0000,0000,0000,,14 жастағы жаңадан келген «Тоқылдақ»
Dialogue: 0,0:05:45.44,0:05:48.07,jp_text,NTP,0000,0000,0000,,Бүгінгі карталар теңгерімсіз.
Dialogue: 0,0:05:48.57,0:05:49.78,jp_text,NTP,0000,0000,0000,,Мүлдем.
Dialogue: 0,0:05:49.95,0:05:52.37,jp_text,NTP,0000,0000,0000,,Жаңадан келген адамды «Қарғаға» тағайындау нені білдіреді?
Dialogue: 0,0:05:53.79,0:05:56.75,jp_text,NTP,0000,0000,0000,,Менің ойымша, солай.
Dialogue: 0,0:06:11.47,0:06:12.05,jp_text,NTP,0000,0000,0000,,Осы жерден айналып өтейік…
Dialogue: 0,0:06:12.68,0:06:14.72,jp_text,NTP,0000,0000,0000,,Мен оны асыға күтемін «Тоқылдақ»
Dialogue: 0,0:06:15.64,0:06:18.02,jp_text,NTP,0000,0000,0000,,Көңілді отырайық
Dialogue: 0,0:06:19.73,0:06:21.56,jp_text,NTP,0000,0000,0000,,Енді сіз осындасыз
Dialogue: 0,0:06:22.36,0:06:25.32,jp_text,NTP,0000,0000,0000,,Тек кілт оны кеспейді.
Dialogue: 0,0:06:26.40,0:06:30.32,jp_text,NTP,0000,0000,0000,,Ханым... Өлі адамның шайқасы!
Dialogue: 0,0:06:35.75,0:06:38.50,jp_text,NTP,0000,0000,0000,,Ей, сен кенет жын болып қалдың ба?
Dialogue: 0,0:06:40.96,0:06:42.71,jp_text,NTP,0000,0000,0000,,«Тоқылдақ» қашып кетеді
Dialogue: 0,0:06:42.75,0:06:44.17,jp_text,NTP,0000,0000,0000,,Ойыннан айырылды ма?
Dialogue: 0,0:06:47.80,0:06:49.88,jp_text,NTP,0000,0000,0000,,Жылжыту, жылжыту
Dialogue: 0,0:06:50.93,0:06:53.39,jp_text,NTP,0000,0000,0000,,Қашықтықты сақтаудың мәні жоқ.
Dialogue: 0,0:06:56.22,0:06:58.56,jp_text,NTP,0000,0000,0000,,Тез қозғал!
Dialogue: 0,0:07:03.98,0:07:04.69,jp_text,NTP,0000,0000,0000,,Бұл не? Мен байланғанмын.
Dialogue: 0,0:07:07.36,0:07:08.07,jp_text,NTP,0000,0000,0000,,Соқ
Dialogue: 0,0:07:15.70,0:07:16.99,jp_text,NTP,0000,0000,0000,,«Зуппаши»
Dialogue: 0,0:07:17.08,0:07:17.91,jp_text,NTP,0000,0000,0000,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:07:28.34,0:07:30.55,jp_text,NTP,0000,0000,0000,,«Қарға» Мен оны оңай қайтарамын.
Dialogue: 0,0:07:30.59,0:07:32.97,jp_text,NTP,0000,0000,0000,,«Тоқылдақ» Ештеңе істеуге мүмкіндік жоқ па?
Dialogue: 0,0:07:34.35,0:07:38.18,jp_text,NTP,0000,0000,0000,,Жоқ, қаттырақ, күштірек
Dialogue: 0,0:07:40.35,0:07:42.73,jp_text,NTP,0000,0000,0000,,Бұл туралы не деуге болады?
Dialogue: 0,0:07:46.40,0:07:47.69,jp_text,NTP,0000,0000,0000,,Жақсы оқ.
Dialogue: 0,0:07:48.69,0:07:49.49,jp_text,NTP,0000,0000,0000,,Гах
Dialogue: 0,0:07:53.32,0:07:56.33,jp_text,NTP,0000,0000,0000,,Менің ойымша, сіз мұны тағы да кінәсіз деп айта аласыз.
Dialogue: 0,0:07:56.58,0:08:00.20,jp_text,NTP,0000,0000,0000,,Бұл бала әлі күнге дейін «Күнә бұтағын» қалай қолдану керектігін білмейтін сияқты.
Dialogue: 0,0:08:04.54,0:08:07.00,jp_text,NTP,0000,0000,0000,,Неліктен суық?
Dialogue: 0,0:08:07.71,0:08:10.13,jp_text,NTP,0000,0000,0000,,Баланың денесімен, уақыт келді.
Dialogue: 0,0:08:11.17,0:08:13.51,jp_text,NTP,0000,0000,0000,,«Күнәнің бұтағы» снаряд
Dialogue: 0,0:08:14.26,0:08:16.43,jp_text,NTP,0000,0000,0000,,Менің ойымша, бұл стратегия болды.
Dialogue: 0,0:08:17.72,0:08:20.64,jp_text,NTP,0000,0000,0000,,Қаныңды ату деген нені білдіреді?
Dialogue: 0,0:08:21.31,0:08:23.73,jp_text,NTP,0000,0000,0000,,Қараңызшы, бұл туралы ойлануға уақытыңыз жоқ.
Dialogue: 0,0:08:25.65,0:08:28.15,jp_text,NTP,0000,0000,0000,,Денедегі қан азайса не болады?
Dialogue: 0,0:08:29.28,0:08:30.69,jp_text,NTP,0000,0000,0000,,Кілтке қарап білуге ​​болады.
Dialogue: 0,0:08:34.91,0:08:37.49,jp_text,NTP,0000,0000,0000,,Анемия Анемия
Dialogue: 0,0:08:42.62,0:08:45.63,jp_text,NTP,0000,0000,0000,,Осы жолы Мас жұдырықтан бастауды жоспарлап отырсыз ба?
Dialogue: 0,0:08:46.08,0:08:47.63,jp_text,NTP,0000,0000,0000,,Өзін-өзі жою - бұл шоу емес.
Dialogue: 0,0:08:47.79,0:08:49.00,jp_text,NTP,0000,0000,0000,,Жеңілу керек болса, жоғалт.
Dialogue: 0,0:08:49.00,0:08:52.22,jp_text,NTP,0000,0000,0000,,Мен әйеліме Қарғаның жақсы жақтарын көбірек көрсетсем деп едім.
Dialogue: 0,0:08:53.47,0:08:55.64,jp_text,NTP,0000,0000,0000,,Ересек еркекке 2 литр
Dialogue: 0,0:08:56.05,0:08:59.06,jp_text,NTP,0000,0000,0000,,Ол бала шамамен 1,5 литр қан жоғалтқан болар еді.
Dialogue: 0,0:08:59.22,0:09:01.14,jp_text,NTP,0000,0000,0000,,Сіз шок жағдайына барасыз.
Dialogue: 0,0:09:02.10,0:09:03.18,jp_text,NTP,0000,0000,0000,,Сонда?
Dialogue: 0,0:09:06.06,0:09:07.56,jp_text,NTP,0000,0000,0000,,Әрине өлесің.
Dialogue: 0,0:09:16.03,0:09:19.16,jp_text,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:09:20.28,0:09:22.33,jp_text,NTP,0000,0000,0000,,Басыңызда жоққа шығарсаңыз да, түсіну керек.
Dialogue: 0,0:09:23.29,0:09:25.83,jp_text,NTP,0000,0000,0000,,Бұл шектеу.
Dialogue: 0,0:09:41.14,0:09:43.14,jp_text,NTP,0000,0000,0000,,«Тоқылдақ» Қашып құтылу мүмкін емес
Dialogue: 0,0:09:45.77,0:09:48.19,jp_text,NTP,0000,0000,0000,,Ол не үшін келеді?
Dialogue: 0,0:09:49.44,0:09:52.36,jp_text,NTP,0000,0000,0000,,Мен саған бала дүниесінің соңын айтайын
Dialogue: 0,0:09:54.82,0:09:57.28,jp_text,NTP,0000,0000,0000,,Қанның мөлшерін өзгертпей
Dialogue: 0,0:09:59.28,0:10:01.33,jp_text,NTP,0000,0000,0000,,Бұл Киёмаса Чиджи.
Dialogue: 0,0:10:10.96,0:10:15.26,jp_text,NTP,0000,0000,0000,,Ой «Тоқылдақ» шымшу
Dialogue: 0,0:10:18.84,0:10:20.18,jp_text,NTP,0000,0000,0000,,Тамаки промоутері
Dialogue: 0,0:10:20.93,0:10:22.89,jp_text,NTP,0000,0000,0000,,Бұл мәселе бойынша аралық есеп.
Dialogue: 0,0:10:23.89,0:10:25.10,jp_text,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:10:25.48,0:10:28.06,jp_text,NTP,0000,0000,0000,,Кеудедегі бөгде зат No5580
Dialogue: 0,0:10:28.44,0:10:29.27,jp_text,NTP,0000,0000,0000,,Ах
Dialogue: 0,0:10:29.69,0:10:34.07,jp_text,NTP,0000,0000,0000,,Тағы да бірнешеу «қызыл шұңқырға» түскен аймақта табылды.
Dialogue: 0,0:10:34.32,0:10:37.07,jp_text,NTP,0000,0000,0000,,Бұл қызыл кристалмен бірдей сияқты.
Dialogue: 0,0:10:39.03,0:10:41.03,jp_text,NTP,0000,0000,0000,,Үлгіні талдау орындалуда.
Dialogue: 0,0:10:41.45,0:10:44.37,jp_text,NTP,0000,0000,0000,,Толық ақпарат алу үшін денемді ашуым керек.
Dialogue: 0,0:10:46.62,0:10:50.00,jp_text,NTP,0000,0000,0000,,«Өлгендердің» барлығы өлім жазасына кесілгендер.
Dialogue: 0,0:10:50.58,0:10:53.29,jp_text,NTP,0000,0000,0000,,Егер ол жеңілсе, оны қалағанша сат.
Dialogue: 0,0:10:54.55,0:10:57.34,jp_text,NTP,0000,0000,0000,,Маған сынатын ойыншық керек емес.
Dialogue: 0,0:11:02.39,0:11:05.47,jp_text,NTP,0000,0000,0000,,“Crow” is overwhelming. Бұл әлдеқашан шайқас болды ма?
Dialogue: 0,0:11:09.06,0:11:10.06,jp_text,NTP,0000,0000,0000,,Әй, қойшы енді.
Dialogue: 0,0:11:10.44,0:11:13.48,jp_text,NTP,0000,0000,0000,,Кеше бұл жерге келген кездейсоқтық па?
Dialogue: 0,0:11:17.53,0:11:20.15,jp_text,NTP,0000,0000,0000,,Менің өлгім келмейді, бар болғаны.
Dialogue: 0,0:11:20.61,0:11:23.24,jp_text,NTP,0000,0000,0000,,Сіз бұл өлексе фестивалінде жеңе алмайсыз.
Dialogue: 0,0:11:20.61,0:11:23.24,Float,NTP,0000,0000,0000,,Карнавал полициясы
Dialogue: 0,0:11:25.03,0:11:28.08,jp_text,NTP,0000,0000,0000,,hurt scary
Dialogue: 0,0:11:30.16,0:11:32.17,jp_text,NTP,0000,0000,0000,,Маған енді ұнамайды
Dialogue: 0,0:11:33.13,0:11:37.67,jp_text,NTP,0000,0000,0000,,Мен мұнда не үшін келдім?
Dialogue: 0,0:11:41.43,0:11:44.22,jp_text,NTP,0000,0000,0000,,Тағы бір қосымша сабақ па, қазірден-ақ?
Dialogue: 0,0:11:45.81,0:11:48.60,jp_text,NTP,0000,0000,0000,,Ганта қазірдің өзінде әлсіз
Dialogue: 0,0:11:52.52,0:11:53.56,jp_text,NTP,0000,0000,0000,,Широ
Dialogue: 0,0:11:53.90,0:11:55.48,jp_text,NTP,0000,0000,0000,,Тым әлсіз және қызықсыз
Dialogue: 0,0:11:57.82,0:12:01.65,jp_text,NTP,0000,0000,0000,,Көмек болмас, Ганта кәдімгі бала.
Dialogue: 0,0:12:07.16,0:12:11.29,jp_text,NTP,0000,0000,0000,,Мен оңай жылаймын, көпіршікті, тырысулар бар.
Dialogue: 0,0:12:11.75,0:12:12.83,jp_text,NTP,0000,0000,0000,,Жоқ, бұл.
Dialogue: 0,0:12:13.00,0:12:15.08,jp_text,NTP,0000,0000,0000,,Широ-чан күшті деп ойлаймын.
Dialogue: 0,0:12:15.50,0:12:18.25,jp_text,NTP,0000,0000,0000,,Мен әдетте роботтарды теппеймін.
Dialogue: 0,0:12:19.51,0:12:21.63,jp_text,NTP,0000,0000,0000,,Ол бүгін дебют жасаған жаңадан келген адам болса да.
Dialogue: 0,0:12:21.63,0:12:22.97,jp_text,NTP,0000,0000,0000,,Коэффициенттерге сәйкес даму
Dialogue: 0,0:12:22.97,0:12:24.93,jp_text,NTP,0000,0000,0000,,Көңілім түспей тұра алмаймын.
Dialogue: 0,0:12:41.40,0:12:42.40,jp_text,NTP,0000,0000,0000,,Бірақ
Dialogue: 0,0:12:48.20,0:12:49.91,jp_text,NTP,0000,0000,0000,,Ганта керемет.
Dialogue: 0,0:13:01.38,0:13:03.17,jp_text,NTP,0000,0000,0000,,Қалағаныңызша көп тұрыңыз
Dialogue: 0,0:13:08.60,0:13:09.39,jp_text,NTP,0000,0000,0000,,≫ Тап-тап-тап (аяқ дыбысы) (Ол Майт) Һм?
Dialogue: 0,0:13:11.77,0:13:13.89,jp_text,NTP,0000,0000,0000,,Мен өмір сүргім келеді...
Dialogue: 0,0:13:15.65,0:13:18.73,jp_text,NTP,0000,0000,0000,,Мен қызыл адамды тапқым келді.
Dialogue: 0,0:13:19.40,0:13:20.86,jp_text,NTP,0000,0000,0000,,Барлығы осы.
Dialogue: 0,0:13:23.61,0:13:27.41,jp_text,NTP,0000,0000,0000,,Қанның құдіреті екенін түсінбеймін.
Dialogue: 0,0:13:28.78,0:13:32.54,jp_text,NTP,0000,0000,0000,,Ауырды және қорқынышты, бірақ
Dialogue: 0,0:13:34.00,0:13:38.17,jp_text,NTP,0000,0000,0000,,Таяқ жей берсем, жеңілгім келмейді
Dialogue: 0,0:13:44.17,0:13:46.55,jp_text,NTP,0000,0000,0000,,Give up Tamar!
Dialogue: 0,0:13:51.85,0:13:53.89,jp_text,NTP,0000,0000,0000,,Жүрегіммен шектен шықтым
Dialogue: 0,0:14:01.69,0:14:02.61,jp_text,NTP,0000,0000,0000,,Мен оны жеймін бе?
Dialogue: 0,0:14:08.45,0:14:09.53,jp_text,NTP,0000,0000,0000,,Бұл бала
Dialogue: 0,0:14:10.24,0:14:12.33,jp_text,NTP,0000,0000,0000,,Мен бала емеспін
Dialogue: 0,0:14:13.79,0:14:17.96,jp_text,NTP,0000,0000,0000,,Бұл Ганта Игараши!
Dialogue: 0,0:14:21.09,0:14:23.96,jp_text,NTP,0000,0000,0000,,Бұл жігіт «Зуппаши»
Dialogue: 0,0:14:25.26,0:14:27.80,jp_text,NTP,0000,0000,0000,,Ганта Игараши
Dialogue: 0,0:14:56.08,0:14:57.50,jp_text,NTP,0000,0000,0000,,Мен қайтып келдім
Dialogue: 0,0:14:57.83,0:15:00.29,jp_text,NTP,0000,0000,0000,,Эй, сен Гантаның орнына қашан барасың?
Dialogue: 0,0:15:00.54,0:15:01.58,jp_text,NTP,0000,0000,0000,,Смақ!
Dialogue: 0,0:15:02.25,0:15:03.92,jp_text,NTP,0000,0000,0000,,Иә, мен оны іздедім.
Dialogue: 0,0:15:05.51,0:15:08.09,jp_text,NTP,0000,0000,0000,,Мен сіз қалаған ақпаратты алдым.
Dialogue: 0,0:15:08.42,0:15:09.22,jp_text,NTP,0000,0000,0000,,Не!
Dialogue: 0,0:15:19.35,0:15:20.98,jp_text,NTP,0000,0000,0000,,Сіз іздеген әйел
Dialogue: 0,0:15:21.77,0:15:24.48,jp_text,NTP,0000,0000,0000,,Бұл жерде жер астында осындай тұтқын бар сияқты.
Dialogue: 0,0:15:24.90,0:15:27.36,jp_text,NTP,0000,0000,0000,,Жер асты дегенде G ғимаратын айтасыз ба?
Dialogue: 0,0:15:28.57,0:15:29.49,jp_text,NTP,0000,0000,0000,,Иә? Сен білесің бе?
Dialogue: 0,0:15:30.20,0:15:31.66,jp_text,NTP,0000,0000,0000,,Бұл шынымен болды ма?
Dialogue: 0,0:15:33.70,0:15:37.37,jp_text,NTP,0000,0000,0000,,Менің ойымша, сіз олқылықты зерттедіңіз.
Dialogue: 0,0:15:37.87,0:15:41.58,jp_text,NTP,0000,0000,0000,,Жеке ақы деген нәрсе жоқ, бірақ бұл дұрыс па?
Dialogue: 0,0:15:44.09,0:15:45.96,jp_text,NTP,0000,0000,0000,,G корпусына қайта барыңыз
Dialogue: 0,0:15:49.88,0:15:53.64,jp_text,NTP,0000,0000,0000,,Gangganggantfaight Сәттілік Ганта Хуи
Dialogue: 0,0:15:53.64,0:15:57.47,jp_text,NTP,0000,0000,0000,,Шишиширо - Джен-Ки Ах, болды.
Dialogue: 0,0:15:57.47,0:16:01.06,jp_text,NTP,0000,0000,0000,,Gangganggantfaight Сәттілік Ганта
Dialogue: 0,0:16:01.19,0:16:03.19,jp_text,NTP,0000,0000,0000,,Шишиширохаха
Dialogue: 0,0:16:07.15,0:16:08.40,jp_text,NTP,0000,0000,0000,,Сіз не айтып жатырсыз?
Dialogue: 0,0:16:08.94,0:16:10.11,jp_text,NTP,0000,0000,0000,,Гантаның қолдауы
Dialogue: 0,0:16:10.15,0:16:12.28,jp_text,NTP,0000,0000,0000,,Күзетші мені тауып алса, не істеуім керек?
Dialogue: 0,0:16:14.41,0:16:16.12,jp_text,NTP,0000,0000,0000,,Олай болса ән айтуды доғар.
Dialogue: 0,0:16:16.53,0:16:19.16,jp_text,NTP,0000,0000,0000,,Широ, мен Гантаның орнына тезірек барғым келеді.
Dialogue: 0,0:16:23.25,0:16:25.92,jp_text,NTP,0000,0000,0000,,Жарайды, менің сұрағанымды орында.
Dialogue: 0,0:16:27.25,0:16:27.75,jp_text,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:16:28.30,0:16:30.01,jp_text,NTP,0000,0000,0000,,Мен сенің күшіңе сенемін
Dialogue: 0,0:16:32.05,0:16:34.51,jp_text,NTP,0000,0000,0000,,Иә! Широ барын салады.
Dialogue: 0,0:16:35.55,0:16:38.14,jp_text,NTP,0000,0000,0000,,Келесіде Канто аймағына арналған ауа райы болжамы.
Dialogue: 0,0:16:38.85,0:16:42.94,jp_text,NTP,0000,0000,0000,,Токио күн ашық, содан кейін бұлтты Канагава күн ашық, содан кейін бұлтты
Dialogue: 0,0:16:43.31,0:16:46.44,jp_text,NTP,0000,0000,0000,,Сайтама шуақты Чиба шуақты Ибараки...
Dialogue: 0,0:16:55.20,0:16:56.45,jp_text,NTP,0000,0000,0000,,Бұл ащы!
Dialogue: 0,0:16:59.37,0:17:01.45,jp_text,NTP,0000,0000,0000,,Бірақ мен мұнымен өмір сүре аламын.
Dialogue: 0,0:17:13.34,0:17:14.93,jp_text,NTP,0000,0000,0000,,Эй, күте тұрыңыз.
Dialogue: 0,0:17:20.81,0:17:22.64,jp_text,NTP,0000,0000,0000,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:17:22.98,0:17:26.52,jp_text,NTP,0000,0000,0000,,Ганта Игараши жаттау
Dialogue: 0,0:17:32.32,0:17:33.07,jp_text,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:17:36.24,0:17:38.62,jp_text,NTP,0000,0000,0000,,Сағат сегіздегі жаңалықтардың бәрі осы.
Dialogue: 0,0:17:38.62,0:17:40.33,jp_text,NTP,0000,0000,0000,,Мен сені қорқынышты адам деп ойладым.
Dialogue: 0,0:17:42.20,0:17:45.04,jp_text,NTP,0000,0000,0000,,Мүмкін біз қандай да бір жолмен жетуіміз мүмкін.
Dialogue: 0,0:17:49.04,0:17:51.05,jp_text,NTP,0000,0000,0000,,Иә, барлығыңыз күтіңіздер.
Dialogue: 0,0:17:51.09,0:17:54.55,jp_text,NTP,0000,0000,0000,,Карцерациядан кейінгі көңілді сағат
Dialogue: 0,0:17:51.09,0:17:54.55,Float,NTP,0000,0000,0000,,Карнавал полициясы
Dialogue: 0,0:17:56.05,0:17:58.30,jp_text,NTP,0000,0000,0000,,Жеңілген шоудың уақыты келді
Dialogue: 0,0:18:02.56,0:18:03.52,jp_text,NTP,0000,0000,0000,,Чиджи-сан?
Dialogue: 0,0:18:13.03,0:18:16.15,jp_text,NTP,0000,0000,0000,,Олай болса, жазалау ойынын бастайық.
Dialogue: 0,0:18:21.53,0:18:24.04,jp_text,NTP,0000,0000,0000,,Жазалау ойыны дегеніміз не?
Dialogue: 0,0:18:31.34,0:18:32.21,jp_text,NTP,0000,0000,0000,,Тоқта
Dialogue: 0,0:18:36.13,0:18:37.26,jp_text,NTP,0000,0000,0000,,Оң көз.
Dialogue: 0,0:19:33.23,0:19:34.94,jp_text,NTP,0000,0000,0000,,Қ-қандай?
Dialogue: 0,0:19:43.87,0:19:45.03,jp_text,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:19:48.62,0:19:51.83,jp_text,NTP,0000,0000,0000,,Бұл – штаб. СР-4 бөлімшесі. Не болды?
Dialogue: 0,0:19:52.00,0:19:52.92,jp_text,NTP,0000,0000,0000,,Есеп
Dialogue: 0,0:19:53.42,0:19:55.96,jp_text,NTP,0000,0000,0000,,Тәртіпсіздік болып жатыр. Бізге дереу қолдау көрсетіңіз.
Dialogue: 0,0:19:56.50,0:19:58.67,jp_text,NTP,0000,0000,0000,,Жүйе ұрлануы мүмкін
Dialogue: 0,0:19:59.09,0:20:01.93,jp_text,NTP,0000,0000,0000,,Осы аймақтың барлық қуатын өшіріңіз.
Dialogue: 0,0:20:02.89,0:20:03.68,jp_text,NTP,0000,0000,0000,,Сенің балаң атақты Эден мектебіне қабылданғанын ойласаңшы!
Dialogue: 0,0:20:04.39,0:20:05.47,jp_text,NTP,0000,0000,0000,,Қарулы әскерлер жіберу
Dialogue: 0,0:20:05.89,0:20:08.22,jp_text,NTP,0000,0000,0000,,Сіз бүлікшілерді көрдіңіз бе? Неше?
Dialogue: 0,0:20:09.89,0:20:10.98,jp_text,NTP,0000,0000,0000,,Мен әйелмін.
Dialogue: 0,0:20:11.52,0:20:14.15,jp_text,NTP,0000,0000,0000,,Жалғыз ақ шашты әйел болды.
Dialogue: 0,0:20:38.75,0:20:40.63,jp_text,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:20:41.42,0:20:42.93,jp_text,NTP,0000,0000,0000,,Ол кенет үнсіз қалды.
Dialogue: 0,0:20:43.63,0:20:44.43,jp_text,NTP,0000,0000,0000,,Оңтүстік аймақтардың бас қолбасшысы Доти Пиксис
Dialogue: 0,0:20:46.18,0:20:49.77,jp_text,NTP,0000,0000,0000,,Бесік жыры тоқтады
Dialogue: 0,0:20:54.98,0:20:56.15,jp_text,NTP,0000,0000,0000,,Тәртіпсіздікке қатысушыларды анықтау
Dialogue: 0,0:20:56.40,0:20:57.77,jp_text,NTP,0000,0000,0000,,Мәжбүрлеп алып тастау басталады
Dialogue: 0,0:21:05.91,0:21:07.41,jp_text,NTP,0000,0000,0000,,Мен саған сендім, Широ-чан.
Dialogue: 0,0:21:07.87,0:21:10.24,jp_text,NTP,0000,0000,0000,,Маған көмектескен ақымақ қыз да
Dialogue: 0,0:21:34.94,0:21:39.82,jp_text,NTP,0000,0000,0000,,Мен ақымақпын
Dialogue: 0,0:21:57.29,0:22:02.34,jp_text,NTP,0000,0000,0000,,Мына жер осындай.
Dialogue: 0,0:22:09.10,0:22:11.97,jp_text,NTP,0000,0000,0000,,Ұмытпа
Dialogue: 0,0:22:17.35,0:22:21.02,jp_text,NTP,0000,0000,0000,,Бұл менің шындығым.
Dialogue: 0,0:22:23.82,0:22:27.36,jp_text,NTP,0000,0000,0000,,Барлығы осында
Dialogue: 0,0:22:31.41,0:22:33.06,jp_text,NTP,0000,0000,0000,,Бұл ақылсыз
Dialogue: 0,0:24:12.39,0:24:14.68,jp_text,NTP,0000,0000,0000,,Тастанды жұмыртқа күлгенде
Dialogue: 0,0:24:15.01,0:24:17.10,jp_text,NTP,0000,0000,0000,,Жалаңаш абсурд жаңбыр жауады
Dialogue: 0,0:24:17.85,0:24:20.41,jp_text,NTP,0000,0000,0000,,Әрбір «күнәнің бұтағы» тыртық
Dialogue: 0,0:24:21.07,0:24:22.01,jp_text,NTP,0000,0000,0000,,Әдемі гүлдер
Dialogue: 0,0:24:22.32,0:24:24.94,jp_text,NTP,0000,0000,0000,,Азу тістерін қағудан басқа сынбайтын әдіс жоқ.
Dialogue: 0,0:02:40.43,0:02:44.85,op,NTP,0000,0000,0000,,Ақыл мен шындықты қатаң бақылау
Dialogue: 0,0:02:44.85,0:02:49.23,op,NTP,0000,0000,0000,,Өзімді кесіп, олардың ессіздігі үшін айқайлаймын
Dialogue: 0,0:02:49.31,0:02:53.61,op,NTP,0000,0000,0000,,Ешқашан бітпейтін қорқынышты түспен ояныңыз
Dialogue: 0,0:02:53.65,0:02:58.32,op,NTP,0000,0000,0000,,Бұл бұралған бас жоспардың басты тартымдылығы
Dialogue: 0,0:03:11.00,0:03:15.42,op,NTP,0000,0000,0000,,Мен сенің өлген адамың боламын
Dialogue: 0,0:03:15.50,0:03:19.80,op,NTP,0000,0000,0000,,Менің қолымдағы қаннан басқа ештеңе жоқ
Dialogue: 0,0:03:19.88,0:03:24.14,op,NTP,0000,0000,0000,,Ғажайыптар елінде қалдым
Dialogue: 0,0:03:24.35,0:03:28.68,op,NTP,0000,0000,0000,,Мен де мен сияқты сені қансыратқым келеді
Dialogue: 0,0:03:28.72,0:03:33.15,op,NTP,0000,0000,0000,,Ендеше мені өлген адам ет
Dialogue: 0,0:03:33.27,0:03:37.48,op,NTP,0000,0000,0000,,Тамырымда тек умен
Dialogue: 0,0:03:37.57,0:03:41.61,op,NTP,0000,0000,0000,,Сіздің ғажайыптар елінде қалдыңыз
Dialogue: 0,0:03:41.86,0:03:44.07,op,NTP,0000,0000,0000,,Мен жасауым керек шайқаста қалдым
Dialogue: 0,0:03:44.12,0:03:46.70,op,NTP,0000,0000,0000,,Мен сені мен сияқты қанды етемін
Dialogue: 0,0:22:49.22,0:22:52.26,EDJP,NTP,0000,0000,0000,,Рюсей қара және түн
Dialogue: 0,0:22:52.39,0:22:55.77,EDJP,NTP,0000,0000,0000,,Мен мәңгілікке жылауды тоқтата алмаймын
Dialogue: 0,0:22:55.89,0:23:04.44,EDJP,NTP,0000,0000,0000,,Мен бұл сандырақ дүниені жек көрдім
Dialogue: 0,0:23:04.53,0:23:12.87,EDJP,NTP,0000,0000,0000,,Мен бұл лабиринттен шығусыз құтылғым келеді.
Dialogue: 0,0:23:13.03,0:23:17.00,EDJP,NTP,0000,0000,0000,,Мен бостандықты қаладым
Dialogue: 0,0:23:18.96,0:23:26.05,EDJP,NTP,0000,0000,0000,,Қол ұстасып, аспанға қара
