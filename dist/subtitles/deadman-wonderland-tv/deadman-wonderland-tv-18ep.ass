Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:18.29,0:01:22.70,op,NTP,0000,0000,0000,,Ақыл мен шындықты қатаң бақылау
Dialogue: 0,0:01:22.78,0:01:27.05,op,NTP,0000,0000,0000,,Өзімді кесіп, олардың ессіздігі үшін айқайлаймын
Dialogue: 0,0:01:27.18,0:01:31.46,op,NTP,0000,0000,0000,,Ешқашан бітпейтін қорқынышты түспен ояныңыз
Dialogue: 0,0:01:31.53,0:01:36.01,op,NTP,0000,0000,0000,,Бұл бұралған бас жоспардың басты тартымдылығы
Dialogue: 0,0:01:48.99,0:01:53.10,op,NTP,0000,0000,0000,,Мен сенің өлген адамың боламын
Dialogue: 0,0:01:53.36,0:01:57.60,op,NTP,0000,0000,0000,,Менің қолымдағы қаннан басқа ештеңе жоқ
Dialogue: 0,0:01:57.69,0:02:01.98,op,NTP,0000,0000,0000,,Сіздің ғажайыптар елінде қалдыңыз
Dialogue: 0,0:02:02.13,0:02:06.38,op,NTP,0000,0000,0000,,Мен де мен сияқты сені қансыратқым келеді
Dialogue: 0,0:02:06.45,0:02:10.90,op,NTP,0000,0000,0000,,Ендеше мені өлген адам ет
Dialogue: 0,0:02:10.94,0:02:15.17,op,NTP,0000,0000,0000,,Тамырымда тек умен
Dialogue: 0,0:02:15.24,0:02:19.55,op,NTP,0000,0000,0000,,Сіздің ғажайыптар елінде қалдыңыз
Dialogue: 0,0:02:19.64,0:02:21.86,op,NTP,0000,0000,0000,,Мен жасауым керек шайқаста қалдым
Dialogue: 0,0:02:22.02,0:02:24.51,op,NTP,0000,0000,0000,,Мен де сені мен сияқты қанды қыламын
Dialogue: 0,0:02:27.22,0:02:29.00,jp_text,NTP,0000,0000,0000,,А, мен шөлдеп тұрмын.
Dialogue: 0,0:02:29.51,0:02:32.35,jp_text,NTP,0000,0000,0000,,Карсерал фестиваліндегі қауіпсіздік туралы алаңдамаңыз.
Dialogue: 0,0:02:32.99,0:02:36.36,jp_text,NTP,0000,0000,0000,,Бірақ бұл «Тоқылдақ» жаңадан келген.
Dialogue: 0,0:02:36.50,0:02:37.89,jp_text,NTP,0000,0000,0000,,Мен жанкүйер болдым
Dialogue: 0,0:02:38.40,0:02:40.83,jp_text,NTP,0000,0000,0000,,Дұрыс, мен тапқан картаны қолданамын ба?
Dialogue: 0,0:02:41.23,0:02:44.30,jp_text,NTP,0000,0000,0000,,Көтеріп алсаң да, қырсық шығар.
Dialogue: 0,0:02:44.58,0:02:46.00,jp_text,NTP,0000,0000,0000,,Мен ол баланы жек көремін.
Dialogue: 0,0:02:46.33,0:02:48.88,jp_text,NTP,0000,0000,0000,,Менің алған ақшам бәрібір шырынға ғана болды.
Dialogue: 0,0:02:53.86,0:02:56.71,jp_text,NTP,0000,0000,0000,,110 миллион
Dialogue: 0,0:02:57.18,0:02:58.80,jp_text,NTP,0000,0000,0000,,Тоқсан миллион кастодиан
Dialogue: 0,0:02:59.75,0:03:00.77,jp_text,NTP,0000,0000,0000,,Назар аударыңыз
Dialogue: 0,0:03:00.95,0:03:03.68,jp_text,NTP,0000,0000,0000,,Бұл баланың неге сонша ақшасы бар?
Dialogue: 0,0:03:10.64,0:03:13.96,jp_text,NTP,0000,0000,0000,,Чикушо Қайсысы G ғимараты?
Dialogue: 0,0:03:15.44,0:03:16.13,jp_text,NTP,0000,0000,0000,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:03:19.37,0:03:21.08,jp_text,NTP,0000,0000,0000,,Мен ештеңе көрмедім
Dialogue: 0,0:03:21.45,0:03:22.70,jp_text,NTP,0000,0000,0000,,Бұл дәл хоум-ран болған жоқ қой, иә~!?
Dialogue: 0,0:03:23.23,0:03:26.05,jp_text,NTP,0000,0000,0000,,Менің бір ісім бар.
Dialogue: 0,0:03:29.06,0:03:29.88,jp_text,NTP,0000,0000,0000,,Минадзуки
Dialogue: 0,0:03:37.03,0:03:39.53,jp_text,NTP,0000,0000,0000,,Бұл жер қалыпты емес.
Dialogue: 0,0:03:41.59,0:03:43.21,jp_text,NTP,0000,0000,0000,,Мен білемін деп ойладым
Dialogue: 0,0:03:43.94,0:03:48.26,jp_text,NTP,0000,0000,0000,,Бірақ Широ мен Хицудзи-кун менің қасымда болды.
Dialogue: 0,0:03:48.63,0:03:49.76,jp_text,NTP,0000,0000,0000,,Мен ұмытып қалдым
Dialogue: 0,0:03:51.03,0:03:53.72,jp_text,NTP,0000,0000,0000,,Екеуміз де жақсымыз ба?
Dialogue: 0,0:03:55.18,0:03:57.00,jp_text,NTP,0000,0000,0000,,Кешіріңіз, тоқтатыңыз.
Dialogue: 0,0:03:57.50,0:03:59.35,jp_text,NTP,0000,0000,0000,,Менің ойымша, бәрі жақсы.
Dialogue: 0,0:04:00.22,0:04:02.50,jp_text,NTP,0000,0000,0000,,Жоқ, Мас мырза.
Dialogue: 0,0:04:02.57,0:04:04.89,jp_text,NTP,0000,0000,0000,,(Бұзық) Хахаха, ә? Жақсы ғой, иә?
Dialogue: 0,0:04:05.15,0:04:08.36,jp_text,NTP,0000,0000,0000,,Өтінемін, бұл гүлді жеме.
Dialogue: 0,0:04:08.79,0:04:10.13,jp_text,NTP,0000,0000,0000,,Менің қымбаттым...
Dialogue: 0,0:04:10.84,0:04:12.91,jp_text,NTP,0000,0000,0000,,Менің қарным ашты.
Dialogue: 0,0:04:13.20,0:04:16.38,jp_text,NTP,0000,0000,0000,,Мен шыдай алмаймын.
Dialogue: 0,0:04:17.52,0:04:21.69,jp_text,NTP,0000,0000,0000,,Оның орнына бұл
Dialogue: 0,0:04:22.74,0:04:24.97,jp_text,NTP,0000,0000,0000,,Жарайды ма?
Dialogue: 0,0:04:28.08,0:04:28.95,jp_text,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,0:04:29.72,0:04:30.65,jp_text,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,0:04:37.25,0:04:39.94,jp_text,NTP,0000,0000,0000,,тағы да
Dialogue: 0,0:04:51.50,0:04:53.64,jp_text,NTP,0000,0000,0000,,Асқазан
Dialogue: 0,0:04:56.53,0:04:58.64,jp_text,NTP,0000,0000,0000,,Менің қарным ашты
Dialogue: 0,0:05:03.33,0:05:05.13,jp_text,NTP,0000,0000,0000,,Мүмкін бұл сенің бөлмең шығар?
Dialogue: 0,0:05:05.32,0:05:09.76,jp_text,NTP,0000,0000,0000,,Иә, бір жерге қашып кеткенім дұрыс деп ойладым.
Dialogue: 0,0:05:10.09,0:05:11.85,jp_text,NTP,0000,0000,0000,,(Нацуки Субару) Ол қыз неге мұнда? Әлі күндізгі уақыт қой.
Dialogue: 0,0:05:12.59,0:05:14.66,jp_text,NTP,0000,0000,0000,,Сізге көп рахмет
Dialogue: 0,0:05:15.39,0:05:19.62,jp_text,NTP,0000,0000,0000,,Ал, бұл Ганта Игараши, солай ма?
Dialogue: 0,0:05:20.44,0:05:24.20,jp_text,NTP,0000,0000,0000,,Иә, мен кеше Carceral фестивалін тамашаладым.
Dialogue: 0,0:05:24.89,0:05:27.18,jp_text,NTP,0000,0000,0000,,Менің атым Минадзуки.
Dialogue: 0,0:05:28.01,0:05:30.09,jp_text,NTP,0000,0000,0000,,Қаласаңыз, сол жерге іліп қойыңыз.
Dialogue: 0,0:05:30.34,0:05:31.45,jp_text,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:05:33.06,0:05:36.12,jp_text,NTP,0000,0000,0000,,Кешіріңіз, мен үшін тамақ ішуіңіз керек еді...
Dialogue: 0,0:05:36.44,0:05:38.28,jp_text,NTP,0000,0000,0000,,Аа, жарайды.
Dialogue: 0,0:05:38.83,0:05:41.12,jp_text,NTP,0000,0000,0000,,Мен кеше түннен бері тамақ іше алмадым.
Dialogue: 0,0:05:43.79,0:05:47.11,jp_text,NTP,0000,0000,0000,,Сіз жеңілген шоуды көрдіңіз бе?
Dialogue: 0,0:05:50.25,0:05:52.06,jp_text,NTP,0000,0000,0000,,Өйткені, бұл жер біртүрлі екен.
Dialogue: 0,0:05:52.60,0:05:54.71,jp_text,NTP,0000,0000,0000,,Бұл ақылсыз
Dialogue: 0,0:05:55.47,0:05:57.84,jp_text,NTP,0000,0000,0000,,Өміріме қауіп төндірушілер болуы мүмкін.
Dialogue: 0,0:05:58.38,0:06:01.05,jp_text,NTP,0000,0000,0000,,Сізде қарапайым адамдарда жоқ өкілеттіктер болғандықтан.
Dialogue: 0,0:06:01.48,0:06:04.52,jp_text,NTP,0000,0000,0000,,Тіпті жек көрмейтін адамдармен бір-біріңді ренжіт
Dialogue: 0,0:06:06.82,0:06:08.17,jp_text,NTP,0000,0000,0000,,Мен де зардап шектім
Dialogue: 0,0:06:10.26,0:06:13.20,jp_text,NTP,0000,0000,0000,,Енді бұлай өмір сүруге болмайды
Dialogue: 0,0:06:16.20,0:06:18.24,jp_text,NTP,0000,0000,0000,,Ум, бұл
Dialogue: 0,0:06:22.05,0:06:25.50,jp_text,NTP,0000,0000,0000,,Жақсы иіс шығады.
Dialogue: 0,0:06:26.51,0:06:27.23,jp_text,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:06:29.63,0:06:32.65,jp_text,NTP,0000,0000,0000,,Жоқ, анау гүл, анау гүл.
Dialogue: 0,0:06:35.41,0:06:36.29,jp_text,NTP,0000,0000,0000,,Мен бақыттымын
Dialogue: 0,0:06:38.01,0:06:40.14,jp_text,NTP,0000,0000,0000,,Бұл гүл - примула
Dialogue: 0,0:06:40.77,0:06:43.68,jp_text,NTP,0000,0000,0000,,Бұл менің сүйікті гүлім.
Dialogue: 0,0:06:45.85,0:06:48.51,jp_text,NTP,0000,0000,0000,,Ганта мырза мейірімді адам.
Dialogue: 0,0:07:02.62,0:07:06.36,jp_text,NTP,0000,0000,0000,,Мен әкемнен тұрмыстық зорлық-зомбылық көрдім.
Dialogue: 0,0:07:07.08,0:07:10.55,jp_text,NTP,0000,0000,0000,,Мен кішкентай кезімде анам сол Қызыл шұңқырда қайтыс болды.
Dialogue: 0,0:07:11.40,0:07:14.78,jp_text,NTP,0000,0000,0000,,Біраз уақыттан кейін әкем үйде ашуланды.
Dialogue: 0,0:07:19.37,0:07:21.62,jp_text,NTP,0000,0000,0000,,Мен көптен бері шыдамдымын.
Dialogue: 0,0:07:23.35,0:07:26.26,jp_text,NTP,0000,0000,0000,,Сол күні өміріме қауіп төніп тұрғандай сезіндім.
Dialogue: 0,0:07:31.46,0:07:35.53,jp_text,NTP,0000,0000,0000,,Мен білмей тұрып, мен өзімнің қан қабілетімді пайдаландым.
Dialogue: 0,0:07:42.17,0:07:44.33,jp_text,NTP,0000,0000,0000,,Ағам бұл құдіреттен хабарсыз.
Dialogue: 0,0:07:44.71,0:07:47.55,jp_text,NTP,0000,0000,0000,,Маған жалған айып тағылды деп ойлаймын.
Dialogue: 0,0:07:50.67,0:07:52.20,jp_text,NTP,0000,0000,0000,,Жоғары сынып оқушысы
Dialogue: 0,0:07:52.43,0:07:55.94,jp_text,NTP,0000,0000,0000,,Әкеңді жалаң қолыңмен қанды қақ жарып жіберуге жол жоқ.
Dialogue: 0,0:07:57.97,0:07:59.46,jp_text,NTP,0000,0000,0000,,Мейірімді аға болды.
Dialogue: 0,0:08:00.33,0:08:03.12,jp_text,NTP,0000,0000,0000,,Мені әрқашан қорғағаны үшін
Dialogue: 0,0:08:04.43,0:08:07.05,jp_text,NTP,0000,0000,0000,,Менің кесірімнен бәрі зардап шекті.
Dialogue: 0,0:08:08.55,0:08:10.58,jp_text,NTP,0000,0000,0000,,Сіз жаман емессіз.
Dialogue: 0,0:08:11.22,0:08:14.20,jp_text,NTP,0000,0000,0000,,Мен мұндай күшті пайдаланғым келмейді.
Dialogue: 0,0:08:15.36,0:08:17.26,jp_text,NTP,0000,0000,0000,,Өгіз фестивалі Маған ұнамайды
Dialogue: 0,0:08:18.63,0:08:20.90,jp_text,NTP,0000,0000,0000,,Енді ешкімді ренжітуге болмайды...
Dialogue: 0,0:08:27.01,0:08:28.14,jp_text,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:08:34.59,0:08:35.27,jp_text,NTP,0000,0000,0000,,Қашайық
Dialogue: 0,0:08:38.12,0:08:39.34,jp_text,NTP,0000,0000,0000,,Екеуміз бірге қашайық
Dialogue: 0,0:08:40.53,0:08:41.39,jp_text,NTP,0000,0000,0000,,Ганта мырза
Dialogue: 0,0:08:41.88,0:08:45.32,jp_text,NTP,0000,0000,0000,,Уақыты келгенде күнәнің тармақтары бар.
Dialogue: 0,0:08:45.74,0:08:47.61,jp_text,NTP,0000,0000,0000,,Бірақ мен
Dialogue: 0,0:08:48.50,0:08:53.66,jp_text,NTP,0000,0000,0000,,Иә, жарайды, күш қолданудың қажеті жоқ.
Dialogue: 0,0:08:56.25,0:08:57.31,jp_text,NTP,0000,0000,0000,,Мен сені қорғаймын
Dialogue: 0,0:09:02.81,0:09:07.56,jp_text,NTP,0000,0000,0000,,Ой, ол таяқшалармен бірге келмейді. Әлгі кемпірде имбирь жоқ.
Dialogue: 0,0:09:17.31,0:09:18.02,jp_text,NTP,0000,0000,0000,,Амансың ба?
Dialogue: 0,0:09:19.22,0:09:20.92,jp_text,NTP,0000,0000,0000,,Ганта мырза, бұл мен ғой...
Dialogue: 0,0:09:32.07,0:09:35.69,jp_text,NTP,0000,0000,0000,,Кешіріңіз, Ганта мырза, кешіріңіз
Dialogue: 0,0:09:36.08,0:09:37.92,jp_text,NTP,0000,0000,0000,,Өйткені мен түтіккенмін
Dialogue: 0,0:09:38.76,0:09:40.25,jp_text,NTP,0000,0000,0000,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:09:40.84,0:09:42.07,jp_text,NTP,0000,0000,0000,,Рұқсатсыз камерадан шықпау.
Dialogue: 0,0:09:42.83,0:09:44.69,jp_text,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:09:44.88,0:09:47.25,jp_text,NTP,0000,0000,0000,,Бұл «Тоқылдақ» және «Колибри» емес пе?
Dialogue: 0,0:09:47.77,0:09:50.06,jp_text,NTP,0000,0000,0000,,Ертеңгі ойында мұны жасаңыз.
Dialogue: 0,0:09:50.81,0:09:53.89,jp_text,NTP,0000,0000,0000,,Ертең? «Колибри»?
Dialogue: 0,0:09:55.55,0:09:58.35,jp_text,NTP,0000,0000,0000,,Сіз оны әлі естіген жоқсыз ба?
Dialogue: 0,0:10:00.24,0:10:02.06,jp_text,NTP,0000,0000,0000,,Ертеңгі өлекселер фестивалі
Dialogue: 0,0:10:03.54,0:10:05.06,jp_text,NTP,0000,0000,0000,,«Колибри» менмін
Dialogue: 0,0:10:05.92,0:10:07.31,jp_text,NTP,0000,0000,0000,,Қарсылас «Тоқылдақ»
Dialogue: 0,0:10:08.70,0:10:11.27,jp_text,NTP,0000,0000,0000,,Бұл сізсіз, Ганта мырза.
Dialogue: 0,0:10:14.00,0:10:17.24,jp_text,NTP,0000,0000,0000,,Әлде өлексе фестивалі ме?
Dialogue: 0,0:10:17.97,0:10:22.76,jp_text,NTP,0000,0000,0000,,Біреу тіпті кешегі апатты дұрыс зерттей алмайды.
Dialogue: 0,0:10:23.81,0:10:26.33,jp_text,NTP,0000,0000,0000,,Бұл сіздің армандаған еліңіз емес
Dialogue: 0,0:10:27.00,0:10:30.83,jp_text,NTP,0000,0000,0000,,Бұл мен жасаған құс торы ғана.
Dialogue: 0,0:10:31.79,0:10:33.49,jp_text,NTP,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:10:33.71,0:10:36.16,jp_text,NTP,0000,0000,0000,,Сізге де оны көрген ұнады деп үміттенемін.
Dialogue: 0,0:10:38.19,0:10:40.41,jp_text,NTP,0000,0000,0000,,Шоу жалғасуы керек!
Dialogue: 0,0:10:41.36,0:10:47.68,jp_text,NTP,0000,0000,0000,,Иә, сіздің ақымақ мақсаттарыңыз үшін.
Dialogue: 0,0:10:49.32,0:10:52.30,jp_text,NTP,0000,0000,0000,,Бүгінгі матчты асыға күтемін.
Dialogue: 0,0:10:52.91,0:10:54.95,jp_text,NTP,0000,0000,0000,,Мен де Гантакунды жақсы көремін.
Dialogue: 0,0:10:56.09,0:11:00.66,jp_text,NTP,0000,0000,0000,,Маған да «Колибри» ұнайды, себебі ол осы қуыршаққа ұқсайды.
Dialogue: 0,0:11:01.30,0:11:04.69,jp_text,NTP,0000,0000,0000,,Ол сондай сүйкімді болса да, азу тістері бар.
Dialogue: 0,0:11:07.52,0:11:08.49,jp_text,NTP,0000,0000,0000,,Габри!
Dialogue: 0,0:11:09.78,0:11:11.14,jp_text,NTP,0000,0000,0000,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,0:11:12.60,0:11:14.56,jp_text,NTP,0000,0000,0000,,Біз мұны бүгін тағы да жасадық.
Dialogue: 0,0:11:14.89,0:11:17.44,jp_text,NTP,0000,0000,0000,,Деттман ғажайыптар әлемі Нағыз шедевр
Dialogue: 0,0:11:17.72,0:11:20.84,jp_text,NTP,0000,0000,0000,,Қанды «Өлес фестивалі» - Карнавал мәйіті
Dialogue: 0,0:11:21.22,0:11:22.50,jp_text,NTP,0000,0000,0000,,Бүгінгі карта
Dialogue: 0,0:11:22.50,0:11:26.11,jp_text,NTP,0000,0000,0000,,Бұл жағдайға сәйкес келмейтін екі кішкентай адамның шайқасы.
Dialogue: 0,0:11:27.44,0:11:31.01,jp_text,NTP,0000,0000,0000,,Жаңадан келген адам тамаша дебют жасайды - «Тоқылдақ»
Dialogue: 0,0:11:32.70,0:11:35.74,jp_text,NTP,0000,0000,0000,,Жылдам колибри -- «Колибри»
Dialogue: 0,0:11:36.61,0:11:39.83,jp_text,NTP,0000,0000,0000,,Осылай аяқталғанына өкінемін.
Dialogue: 0,0:11:40.82,0:11:43.82,jp_text,NTP,0000,0000,0000,,Ережелер - бүгінгі күні де уақыт шектеусіз өмір сүру үшін күрес.
Dialogue: 0,0:11:44.19,0:11:47.74,jp_text,NTP,0000,0000,0000,,Жеңімпаз тауық қай жолмен ән салады?
Dialogue: 0,0:11:48.13,0:11:50.08,jp_text,NTP,0000,0000,0000,,Бірақ мен...
Dialogue: 0,0:11:50.20,0:11:52.57,jp_text,NTP,0000,0000,0000,,Дайын... Өлі адамның жекпе-жегі!!
Dialogue: 0,0:11:53.91,0:11:55.41,jp_text,NTP,0000,0000,0000,,Мен сені ешқашан ренжітпеймін
Dialogue: 0,0:11:55.76,0:11:56.31,jp_text,NTP,0000,0000,0000,,Сонымен
Dialogue: 0,0:11:57.16,0:11:58.23,jp_text,NTP,0000,0000,0000,,Ганта мырза...
Dialogue: 0,0:12:00.20,0:12:01.36,jp_text,NTP,0000,0000,0000,,«Күнәнің тармағы»
Dialogue: 0,0:12:03.22,0:12:04.56,jp_text,NTP,0000,0000,0000,,«Қамшы қанаты»
Dialogue: 0,0:12:08.00,0:12:09.41,jp_text,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:12:13.70,0:12:18.50,jp_text,NTP,0000,0000,0000,,Тың рыцарь сияқты жиіркенішті.
Dialogue: 0,0:12:24.95,0:12:27.43,jp_text,NTP,0000,0000,0000,,Ой, бірінші қимыл – «Колибри»
Dialogue: 0,0:12:27.51,0:12:29.97,jp_text,NTP,0000,0000,0000,,Қамшы тым жүйрік еді бүгін көрінбейді.
Dialogue: 0,0:12:30.42,0:12:32.99,jp_text,NTP,0000,0000,0000,,Кеше алған жарақатыммен және қазір алған жарақатыммен
Dialogue: 0,0:12:32.99,0:12:37.70,jp_text,NTP,0000,0000,0000,,Сенджидегідей жылдам қозғала алмайсың.
Dialogue: 0,0:12:39.19,0:12:40.95,jp_text,NTP,0000,0000,0000,,Мені алдай бер...
Dialogue: 0,0:12:43.07,0:12:46.27,jp_text,NTP,0000,0000,0000,,Жақсы, бұл бет жынды болып кететін сияқты
Dialogue: 0,0:12:46.95,0:12:49.79,jp_text,NTP,0000,0000,0000,,Әй, менімен қашсаң ше?
Dialogue: 0,0:12:50.12,0:12:52.70,jp_text,NTP,0000,0000,0000,,Қандай жақсылық жасағың келді?
Dialogue: 0,0:12:53.37,0:12:55.74,jp_text,NTP,0000,0000,0000,,Мұның бәрі өтірік болды ма?
Dialogue: 0,0:12:58.00,0:13:00.17,jp_text,NTP,0000,0000,0000,,Дұрыс айтасың, Барса.
Dialogue: 0,0:13:00.50,0:13:02.82,jp_text,NTP,0000,0000,0000,,Сасық, өледі, шошқа.
Dialogue: 0,0:13:03.22,0:13:04.72,jp_text,NTP,0000,0000,0000,,кесектерге кесіңіз
Dialogue: 0,0:13:04.74,0:13:07.50,jp_text,NTP,0000,0000,0000,,Оны формалинмен сызып тастаңыз.
Dialogue: 0,0:13:09.33,0:13:10.98,jp_text,NTP,0000,0000,0000,,Сәлем!
Dialogue: 0,0:13:14.33,0:13:15.29,jp_text,NTP,0000,0000,0000,,Бұл…
Dialogue: 0,0:13:16.26,0:13:17.61,jp_text,NTP,0000,0000,0000,,Ганта
Dialogue: 0,0:13:19.84,0:13:22.33,jp_text,NTP,0000,0000,0000,,Менің әпкемді не істеп жатырсың?
Dialogue: 0,0:13:24.29,0:13:25.10,jp_text,NTP,0000,0000,0000,,Қой-күн
Dialogue: 0,0:13:25.89,0:13:26.80,jp_text,NTP,0000,0000,0000,,Үлкен аға
Dialogue: 0,0:13:28.25,0:13:32.62,jp_text,NTP,0000,0000,0000,,Ой, ойыншымен туыс болып көрінетін адам кіріп жатыр.
Dialogue: 0,0:13:33.28,0:13:36.65,jp_text,NTP,0000,0000,0000,,Хицудзи-кунның әпкесі?
Dialogue: 0,0:13:38.02,0:13:38.76,jp_text,NTP,0000,0000,0000,,Минадзуки
Dialogue: 0,0:13:39.90,0:13:43.10,jp_text,NTP,0000,0000,0000,,Сіз де «өлген адам» болдыңыз ба?
Dialogue: 0,0:13:44.28,0:13:46.50,jp_text,NTP,0000,0000,0000,,Тодороки, Эндевор қалай?
Dialogue: 0,0:13:47.62,0:13:48.68,jp_text,NTP,0000,0000,0000,,Біз ақыры кездестік
Dialogue: 0,0:13:49.42,0:13:52.07,jp_text,NTP,0000,0000,0000,,Менің ойыншыларым сіздің сөйлеміңізді сатып ала алады.
Dialogue: 0,0:13:52.54,0:13:54.53,jp_text,NTP,0000,0000,0000,,Бұл жерден кет, Минадзуки.
Dialogue: 0,0:13:58.07,0:13:59.33,jp_text,NTP,0000,0000,0000,,Мәжбүрлеп алып тастау
Dialogue: 0,0:13:59.71,0:14:02.10,jp_text,NTP,0000,0000,0000,,Жоқ, тұтынушылардың реакциясы жақсы.
Dialogue: 0,0:14:02.54,0:14:05.41,jp_text,NTP,0000,0000,0000,,Сериалды анда-санда көру жаман емес.
Dialogue: 0,0:14:05.93,0:14:06.41,jp_text,NTP,0000,0000,0000,,болып табылады
Dialogue: 0,0:14:08.63,0:14:12.97,jp_text,NTP,0000,0000,0000,,Олар қаншалықты бақытты болса, ойыншық жасауға соғұрлым көп ақша керек.
Dialogue: 0,0:14:18.28,0:14:21.63,jp_text,NTP,0000,0000,0000,,Мен үшін түрмеге түс
Dialogue: 0,0:14:22.37,0:14:24.76,jp_text,NTP,0000,0000,0000,,Сонда сіз сонша ақша таптыңыз ба?
Dialogue: 0,0:14:27.07,0:14:28.82,jp_text,NTP,0000,0000,0000,,Бұл керемет
Dialogue: 0,0:14:29.17,0:14:31.70,jp_text,NTP,0000,0000,0000,,Үлкен аға ең жақсы
Dialogue: 0,0:14:33.03,0:14:36.48,jp_text,NTP,0000,0000,0000,,Ағаң деп Хицудзи-кунды айтқың келді ме?
Dialogue: 0,0:14:36.73,0:14:37.66,jp_text,NTP,0000,0000,0000,,Сіз таныссыз ба?
Dialogue: 0,0:14:38.20,0:14:39.45,jp_text,NTP,0000,0000,0000,,Бір ұяшықта
Dialogue: 0,0:14:39.94,0:14:42.65,jp_text,NTP,0000,0000,0000,,Ол әйелге қол көтереді деп ойламаппын.
Dialogue: 0,0:14:43.71,0:14:44.82,jp_text,NTP,0000,0000,0000,,Жоқ, қой-күн.
Dialogue: 0,0:14:45.15,0:14:46.64,jp_text,NTP,0000,0000,0000,,Мына жігіт мені алдады
Dialogue: 0,0:14:48.66,0:14:52.11,jp_text,NTP,0000,0000,0000,,Ой «Тоқылдақ» табиғи емес сырғанақ
Dialogue: 0,0:14:52.92,0:14:54.72,jp_text,NTP,0000,0000,0000,,Амансыз ба, Ганта мырза?
Dialogue: 0,0:14:59.33,0:15:01.53,jp_text,NTP,0000,0000,0000,,Атмосфераны оқып, сөйле.
Dialogue: 0,0:15:01.76,0:15:03.25,jp_text,NTP,0000,0000,0000,,Шірік, сен ақымақ.
Dialogue: 0,0:15:05.68,0:15:07.98,jp_text,NTP,0000,0000,0000,,Ганта-сан жаман емес, аға.
Dialogue: 0,0:15:08.94,0:15:10.91,jp_text,NTP,0000,0000,0000,,Менің қарсыласым екенін білсем де.
Dialogue: 0,0:15:11.31,0:15:14.48,jp_text,NTP,0000,0000,0000,,Мен тұзаққа түсіп қалдым. Мен ақымақ болдым.
Dialogue: 0,0:15:15.88,0:15:18.16,jp_text,NTP,0000,0000,0000,,Мені тұзаққа түсірген сен шығарсың.
Dialogue: 0,0:15:20.11,0:15:21.71,jp_text,NTP,0000,0000,0000,,Мүлдем ұрып-соғу
Dialogue: 0,0:15:28.87,0:15:31.02,jp_text,NTP,0000,0000,0000,,Екеуі де мүлде ақымақ.
Dialogue: 0,0:15:31.62,0:15:33.78,jp_text,NTP,0000,0000,0000,,Енді сіз мұны міндетті түрде жасай аласыз.
Dialogue: 0,0:15:34.08,0:15:36.43,jp_text,NTP,0000,0000,0000,,Сүйегі шыққанша етпен ойнаймын
Dialogue: 0,0:15:37.46,0:15:39.49,jp_text,NTP,0000,0000,0000,,Әкеңді де осылай өлтірдің бе?
Dialogue: 0,0:15:48.23,0:15:50.18,jp_text,NTP,0000,0000,0000,,Мен сол кезде ренжідім.
Dialogue: 0,0:15:50.99,0:15:53.70,jp_text,NTP,0000,0000,0000,,Мен не болғанын түсінбедім.
Dialogue: 0,0:15:57.30,0:15:59.36,jp_text,NTP,0000,0000,0000,,Мен мұны істедім деп ойладым
Dialogue: 0,0:16:01.64,0:16:03.91,jp_text,NTP,0000,0000,0000,,Әкем саған ештеңе істеген жоқ.
Dialogue: 0,0:16:04.32,0:16:05.87,jp_text,NTP,0000,0000,0000,,Не айтып тұрсың, аға?
Dialogue: 0,0:16:05.87,0:16:06.97,jp_text,NTP,0000,0000,0000,,Бірақ мұндай нәрсе
Dialogue: 0,0:16:07.76,0:16:09.65,jp_text,NTP,0000,0000,0000,,Сіз ештеңе істей алмайсыз
Dialogue: 0,0:16:12.37,0:16:15.43,jp_text,NTP,0000,0000,0000,,Мен бұл дүниеде мұндай күшке ие адамдар бар екенін білгенге дейін.
Dialogue: 0,0:16:16.11,0:16:17.38,jp_text,NTP,0000,0000,0000,,Мен осылай ойладым
Dialogue: 0,0:16:19.49,0:16:21.73,jp_text,NTP,0000,0000,0000,,Енді өтірік айтудың қажеті жоқ
Dialogue: 0,0:16:23.37,0:16:26.05,jp_text,NTP,0000,0000,0000,,Мен мұны түсінбеймін.
Dialogue: 0,0:16:26.52,0:16:28.54,jp_text,NTP,0000,0000,0000,,Маған сенің кім екенің бәрібір.
Dialogue: 0,0:16:29.85,0:16:32.91,jp_text,NTP,0000,0000,0000,,Бұдан былай мен не қажет болса, соны істеймін
Dialogue: 0,0:16:33.69,0:16:35.02,jp_text,NTP,0000,0000,0000,,Мен сені қорғаймын
Dialogue: 0,0:16:39.93,0:16:41.15,jp_text,NTP,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:16:44.04,0:16:46.01,jp_text,NTP,0000,0000,0000,,Бұл Cisco жігіті
Dialogue: 0,0:16:46.40,0:16:48.88,jp_text,NTP,0000,0000,0000,,Темеенанза Дәретханада тарақандармен достасу
Dialogue: 0,0:16:49.06,0:16:50.91,jp_text,NTP,0000,0000,0000,,Жеңдер
Dialogue: 0,0:16:52.36,0:16:55.19,jp_text,NTP,0000,0000,0000,,Мұны жасамаңыз
Dialogue: 0,0:16:55.63,0:16:57.92,jp_text,NTP,0000,0000,0000,,Мен сені өз қолыммен түңілтуім керек.
Dialogue: 0,0:16:58.16,0:17:01.12,jp_text,NTP,0000,0000,0000,,Бұл мүмкін немесе болмауы мүмкін.
Dialogue: 0,0:17:02.81,0:17:06.90,jp_text,NTP,0000,0000,0000,,Мен өзімді абсолютті ең жақсы сезінемін.
Dialogue: 0,0:17:07.49,0:17:08.39,jp_text,NTP,0000,0000,0000,,Минадзуки
Dialogue: 0,0:17:09.28,0:17:10.65,jp_text,NTP,0000,0000,0000,,Шулы
Dialogue: 0,0:17:10.85,0:17:13.77,jp_text,NTP,0000,0000,0000,,Мені жібере алмасаң, түкке тұрғысызсың.
Dialogue: 0,0:17:16.13,0:17:16.97,jp_text,NTP,0000,0000,0000,,Қой-күн
Dialogue: 0,0:17:22.19,0:17:23.33,jp_text,NTP,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:17:23.47,0:17:26.56,jp_text,NTP,0000,0000,0000,,Мен бәрін жасадым, не болды?
Dialogue: 0,0:17:27.28,0:17:30.11,jp_text,NTP,0000,0000,0000,,Бәрің де өтірікшісіңдер.
Dialogue: 0,0:17:30.39,0:17:31.53,jp_text,NTP,0000,0000,0000,,Сатқындық жасамас бұрын
Dialogue: 0,0:17:31.63,0:17:34.21,jp_text,NTP,0000,0000,0000,,Осы құдіретпен барлығын жұлып аламын.
Dialogue: 0,0:17:34.63,0:17:37.09,jp_text,NTP,0000,0000,0000,,Бүкіл сұм адамдардан, маған өтірік айт.
Dialogue: 0,0:17:37.11,0:17:38.89,jp_text,NTP,0000,0000,0000,,Мен сені күліп өлтіремін
Dialogue: 0,0:17:39.18,0:17:41.97,jp_text,NTP,0000,0000,0000,,Сіз түсінгендей әрекет ету дұрыс емес деп ойлайсыз ба?
Dialogue: 0,0:17:42.12,0:17:44.17,jp_text,NTP,0000,0000,0000,,Екіжүздісің
Dialogue: 0,0:17:46.03,0:17:48.99,jp_text,NTP,0000,0000,0000,,Бұл әлгі шірікпен бірдей (жезөкше)
Dialogue: 0,0:17:49.11,0:17:50.52,jp_text,NTP,0000,0000,0000,,Жиренішті
Dialogue: 0,0:17:50.72,0:17:51.43,jp_text,NTP,0000,0000,0000,,Тоқта
Dialogue: 0,0:17:53.57,0:17:55.29,jp_text,NTP,0000,0000,0000,,Ол сенің ағаң ғой, солай ма?
Dialogue: 0,0:17:56.02,0:17:56.98,jp_text,NTP,0000,0000,0000,,Сен
Dialogue: 0,0:17:57.70,0:18:00.72,jp_text,NTP,0000,0000,0000,,Сіз бұл жігітті дос деп санайтын сияқтысыз.
Dialogue: 0,0:18:01.20,0:18:03.46,jp_text,NTP,0000,0000,0000,,Бұл сіз жасағыңыз келетін доп емес.
Dialogue: 0,0:18:03.84,0:18:05.67,jp_text,NTP,0000,0000,0000,,Ол менің үлкен ағам.
Dialogue: 0,0:18:06.02,0:18:08.38,jp_text,NTP,0000,0000,0000,,Сіз кездейсоқ кездесіп қалдыңыз ба?
Dialogue: 0,0:18:08.82,0:18:12.24,jp_text,NTP,0000,0000,0000,,Маңызды нәрсені жоғалтып алған кезіңіз болды ма?
Dialogue: 0,0:18:16.63,0:18:17.48,jp_text,NTP,0000,0000,0000,,Иә, бірақ
Dialogue: 0,0:18:18.66,0:18:20.42,jp_text,NTP,0000,0000,0000,,Бұл не болды?
Dialogue: 0,0:18:21.85,0:18:23.61,jp_text,NTP,0000,0000,0000,,Мұның бәрі сіз үшін.
Dialogue: 0,0:18:24.08,0:18:25.74,jp_text,NTP,0000,0000,0000,,Өзіңіздің кінәсіздігіңізге сеніңіз
Dialogue: 0,0:18:25.74,0:18:27.38,jp_text,NTP,0000,0000,0000,,Бұл ақша табу үшін бе?
Dialogue: 0,0:18:27.79,0:18:29.48,jp_text,NTP,0000,0000,0000,,Хицудзи-кун маған көмектесті.
Dialogue: 0,0:18:29.97,0:18:30.80,jp_text,NTP,0000,0000,0000,,Ганта
Dialogue: 0,0:18:30.80,0:18:33.46,jp_text,NTP,0000,0000,0000,,Мен де көмектесе алсам, жақсы.
Dialogue: 0,0:18:34.63,0:18:36.58,jp_text,NTP,0000,0000,0000,,Сен қатал ақымақсың.
Dialogue: 0,0:18:37.03,0:18:40.29,jp_text,NTP,0000,0000,0000,,Тіпті сіз: «Мен осы уақытқа дейін бақытты өмір сүрдім» деп айтасыз.
Dialogue: 0,0:18:40.29,0:18:41.78,jp_text,NTP,0000,0000,0000,,Сен ақымақ екіжүздісің.
Dialogue: 0,0:18:42.43,0:18:45.45,jp_text,NTP,0000,0000,0000,,Ондай адамдар уақыты келгенде қашып кетеді.
Dialogue: 0,0:18:45.54,0:18:48.25,jp_text,NTP,0000,0000,0000,,Сіз ең жаман өтірікшісіз.
Dialogue: 0,0:18:49.20,0:18:50.66,jp_text,NTP,0000,0000,0000,,Қайсысы өтірікші?
Dialogue: 0,0:18:50.83,0:18:52.10,jp_text,NTP,0000,0000,0000,,Сіз сондайсыз
Dialogue: 0,0:18:52.10,0:18:53.20,jp_text,NTP,0000,0000,0000,,Барка
Dialogue: 0,0:18:53.22,0:18:56.91,jp_text,NTP,0000,0000,0000,,Маған олай қарап, сене берсең одан да жаман.
Dialogue: 0,0:18:59.48,0:19:01.27,jp_text,NTP,0000,0000,0000,,Бұл біржақты
Dialogue: 0,0:19:01.53,0:19:03.96,jp_text,NTP,0000,0000,0000,,«Тоқылдақ» Ештеңе істей алмайсың
Dialogue: 0,0:19:04.17,0:19:05.64,jp_text,NTP,0000,0000,0000,,Сәйкестік болды ма?
Dialogue: 0,0:19:06.12,0:19:08.74,jp_text,NTP,0000,0000,0000,,Шүкір, бір ғана дерек көзі бар.
Dialogue: 0,0:19:09.07,0:19:10.69,jp_text,NTP,0000,0000,0000,,Хицудзи-кун қалқан ретінде пайдаланылды
Dialogue: 0,0:19:15.10,0:19:15.99,jp_text,NTP,0000,0000,0000,,Байқап көріңіз
Dialogue: 0,0:19:16.86,0:19:18.76,jp_text,NTP,0000,0000,0000,,Ой «Тоқылдақ»
Dialogue: 0,0:19:18.85,0:19:20.93,jp_text,NTP,0000,0000,0000,,Қарсы шабуыл ақыры басталды.
Dialogue: 0,0:19:21.34,0:19:23.49,jp_text,NTP,0000,0000,0000,,Сіз барлық достарыңызды атуға дайынсыз ба?
Dialogue: 0,0:19:23.83,0:19:25.11,jp_text,NTP,0000,0000,0000,,Бірақ ол жұмыс істемейді.
Dialogue: 0,0:19:26.17,0:19:28.25,jp_text,NTP,0000,0000,0000,,Ақымақтың шынайы болмысы шықты
Dialogue: 0,0:19:29.48,0:19:31.55,jp_text,NTP,0000,0000,0000,,«Колибри» асуы!
Dialogue: 0,0:19:32.38,0:19:35.24,jp_text,NTP,0000,0000,0000,,Боқ, мен жеуім керек еді.
Dialogue: 0,0:19:35.63,0:19:38.12,jp_text,NTP,0000,0000,0000,,Идиоттар еттен иілген шарларға айналады.
Dialogue: 0,0:19:38.56,0:19:41.31,jp_text,NTP,0000,0000,0000,,Мен сені сол шірік (жезөкше) сияқты қыламын
Dialogue: 0,0:19:41.98,0:19:43.85,jp_text,NTP,0000,0000,0000,,Минадзуки сен
Dialogue: 0,0:19:43.99,0:19:46.89,jp_text,NTP,0000,0000,0000,,Анам қайтыс болғанда не болды...
Dialogue: 0,0:19:49.70,0:19:53.33,jp_text,NTP,0000,0000,0000,,Бұл менің анам емес.
Dialogue: 0,0:20:15.36,0:20:17.62,jp_text,NTP,0000,0000,0000,,Ол әйел мені тастап кетті
Dialogue: 0,0:20:17.83,0:20:19.41,jp_text,NTP,0000,0000,0000,,Мен гүлдерді алып кеттім.
Dialogue: 0,0:20:20.41,0:20:21.99,jp_text,NTP,0000,0000,0000,,Бұл мені күлдіреді
Dialogue: 0,0:20:30.42,0:20:31.82,jp_text,NTP,0000,0000,0000,,Минадзуки
Dialogue: 0,0:20:32.10,0:20:34.06,jp_text,NTP,0000,0000,0000,,Үндемейсің бе, ақымақтар?
Dialogue: 0,0:20:34.55,0:20:37.29,jp_text,NTP,0000,0000,0000,,Үмітсіз, өлім иісі
Dialogue: 0,0:20:39.04,0:20:40.07,jp_text,NTP,0000,0000,0000,,Сонда қайда?
Dialogue: 0,0:20:42.63,0:20:45.29,jp_text,NTP,0000,0000,0000,,Ой, секіру соққысы!
Dialogue: 0,0:20:47.28,0:20:50.72,jp_text,NTP,0000,0000,0000,,Қорғауға ұшыраған адамды ішін көрмей құтқарыңыз
Dialogue: 0,0:20:52.90,0:20:54.26,jp_text,NTP,0000,0000,0000,,Бірақ «колибри»
Dialogue: 0,0:20:54.48,0:20:57.37,jp_text,NTP,0000,0000,0000,,Қалған қамшыны Тоқылдақтың қозғалуын тоқтату үшін қолданды.
Dialogue: 0,0:20:57.98,0:21:00.58,jp_text,NTP,0000,0000,0000,,Енді мен оған көмектесе алмаймын.
Dialogue: 0,0:21:00.85,0:21:02.79,jp_text,NTP,0000,0000,0000,,Мен оны осылай бұраймын.
Dialogue: 0,0:21:03.07,0:21:04.45,jp_text,NTP,0000,0000,0000,,Сен ақымақсың
Dialogue: 0,0:21:07.06,0:21:08.71,jp_text,NTP,0000,0000,0000,,Бір рет опасыздық жасағаннан кейін
Dialogue: 0,0:21:09.53,0:21:10.97,jp_text,NTP,0000,0000,0000,,Бірде үмітім үзілді
Dialogue: 0,0:21:10.97,0:21:13.65,jp_text,NTP,0000,0000,0000,,Барлығына өтірік айту және оларды ренжіту
Dialogue: 0,0:21:13.82,0:21:15.81,jp_text,NTP,0000,0000,0000,,Сонымен не білдіңіз?
Dialogue: 0,0:21:15.83,0:21:17.11,jp_text,NTP,0000,0000,0000,,Менің айтайын дегенім, маған жақындама.
Dialogue: 0,0:21:17.12,0:21:18.22,jp_text,NTP,0000,0000,0000,,Мен түсінбеймін.
Dialogue: 0,0:21:18.92,0:21:21.21,jp_text,NTP,0000,0000,0000,,Бірақ бұл дұрыс емес.
Dialogue: 0,0:21:21.63,0:21:24.13,jp_text,NTP,0000,0000,0000,,Бұл мені қиындатып жібермей ме?
Dialogue: 0,0:21:31.19,0:21:33.36,jp_text,NTP,0000,0000,0000,,Не... баспен ұру?
Dialogue: 0,0:21:35.09,0:21:37.36,jp_text,NTP,0000,0000,0000,,Бұл рас па?
Dialogue: 0,0:21:37.92,0:21:39.88,jp_text,NTP,0000,0000,0000,,Да да воун!
Dialogue: 0,0:21:40.19,0:21:41.96,jp_text,NTP,0000,0000,0000,,«Колибри» батып кетті
Dialogue: 0,0:21:42.10,0:21:44.26,Unimportant_jp,NTP,0000,0000,0000,,Әй, бұл не, баланың ұрысы?
Dialogue: 0,0:21:42.17,0:21:45.87,jp_text,NTP,0000,0000,0000,,Шешуші фактор – «Тоқылдақ» басының соққысы.
Dialogue: 0,0:21:44.81,0:21:46.59,Unimportant_jp,NTP,0000,0000,0000,,Маған қанды көрсет! Маған қанды көрсет!
Dialogue: 0,0:21:46.34,0:21:49.24,jp_text,NTP,0000,0000,0000,,Өлік фестивалінің мағынасын бұзатын соққы!!
Dialogue: 0,0:21:49.58,0:21:51.43,Unimportant_jp,NTP,0000,0000,0000,,Өлтір, тез өлтір, тез өлтір.
Dialogue: 0,0:21:52.26,0:21:54.68,jp_text,NTP,0000,0000,0000,,Бұл қаншықтар тітіркендіреді.
Dialogue: 0,0:21:55.14,0:21:57.22,jp_text,NTP,0000,0000,0000,,Бақаны кім өлтіреді?
Dialogue: 0,0:21:57.58,0:21:59.40,jp_text,NTP,0000,0000,0000,,Сіз жеңдіңіз, сондықтан шағымдана алмайсыз.
Dialogue: 0,0:21:59.64,0:22:01.69,jp_text,NTP,0000,0000,0000,,Тез бітір, қарғыс атқан стақандар.
Dialogue: 0,0:22:02.80,0:22:04.78,jp_text,NTP,0000,0000,0000,,Жоқ, кейіпкер өзгерді.
Dialogue: 0,0:22:05.11,0:22:07.80,jp_text,NTP,0000,0000,0000,,Ережеге сәйкес
Dialogue: 0,0:22:07.84,0:22:10.19,jp_text,NTP,0000,0000,0000,,«Колибри» күресуге қабілетсіз болғандықтан
Dialogue: 0,0:22:10.31,0:22:12.20,jp_text,NTP,0000,0000,0000,,Жеңімпаз «Тоқылдақ»
Dialogue: 0,0:22:15.75,0:22:18.00,jp_text,NTP,0000,0000,0000,,Қандай көңілді бала.
Dialogue: 0,0:22:18.54,0:22:20.46,jp_text,NTP,0000,0000,0000,,Бұл Игараши отбасының қаны ма?
Dialogue: 0,0:22:20.92,0:22:23.93,jp_text,NTP,0000,0000,0000,,Эй, сен ояусың, Широ.
Dialogue: 0,0:22:25.03,0:22:29.48,jp_text,NTP,0000,0000,0000,,Менің тілегімді орындайтын кез келді.
Dialogue: 0,0:22:30.34,0:22:33.47,jp_text,NTP,0000,0000,0000,,Бесік жыры тоқтады
Dialogue: 0,0:24:11.15,0:24:13.01,jp_text,NTP,0000,0000,0000,,«Төмен серпіліс жауынгері»
Dialogue: 0,0:24:13.18,0:24:16.57,jp_text,NTP,0000,0000,0000,,Бұл махаббатты, әділеттілікті және әлемдегі әділетсіздікті бейнелейтін арнайы эффектілер бағдарламасы.
Dialogue: 0,0:24:16.81,0:24:17.91,jp_text,NTP,0000,0000,0000,,Бұрынғы кішкентай қыз——
Dialogue: 0,0:24:17.98,0:24:19.85,jp_text,NTP,0000,0000,0000,,Нақты уақыттағы генерация ғана емес
Dialogue: 0,0:24:19.87,0:24:22.00,jp_text,NTP,0000,0000,0000,,Қайта трансляциялау, жалға алу бағдарламалық қамтамасыз ету және т.б.
Dialogue: 0,0:24:22.02,0:24:24.15,jp_text,NTP,0000,0000,0000,,Жанкүйерлер саны артып келеді
Dialogue: 0,0:22:48.39,0:22:51.32,EDJP,NTP,0000,0000,0000,,Рюсей қара және түн
Dialogue: 0,0:22:51.37,0:22:54.76,EDJP,NTP,0000,0000,0000,,Мен мәңгілікке жылауды тоқтата алмаймын
Dialogue: 0,0:22:55.01,0:23:03.38,EDJP,NTP,0000,0000,0000,,Мен бұл сандырақ дүниені жек көрдім
Dialogue: 0,0:23:03.45,0:23:11.79,EDJP,NTP,0000,0000,0000,,Мен бұл лабиринттен шығусыз құтылғым келеді.
Dialogue: 0,0:23:12.06,0:23:15.76,EDJP,NTP,0000,0000,0000,,Мен бостандықты қаладым
Dialogue: 0,0:23:18.04,0:23:25.01,EDJP,NTP,0000,0000,0000,,Қол ұстасып, аспанға қара
Dialogue: 0,0:23:25.68,0:23:33.03,EDJP,NTP,0000,0000,0000,,Мен кешегіден ерекше болдым
Dialogue: 0,0:23:33.47,0:23:40.04,EDJP,NTP,0000,0000,0000,,Жылтыр жылтыр Жарқыраған жұлдыздар шексіз
Dialogue: 0,0:23:40.15,0:23:48.46,EDJP,NTP,0000,0000,0000,,Бұл дүние сондай әдемі
Dialogue: 0,0:23:48.68,0:23:55.36,EDJP,NTP,0000,0000,0000,,Жарқыраған Жарқыраған Ай сәулесі Үмітке толы
Dialogue: 0,0:23:55.52,0:24:03.30,EDJP,NTP,0000,0000,0000,,Бұл дүние өте керемет
Dialogue: 0,0:24:03.39,0:24:06.06,EDJP,NTP,0000,0000,0000,,Менің ойымша.
Dialogue: 0,0:24:25.65,0:24:31.65,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
