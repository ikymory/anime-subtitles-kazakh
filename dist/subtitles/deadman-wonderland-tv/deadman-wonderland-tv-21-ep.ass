Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:02.37,0:01:06.71,op,NTP,0000,0000,0000,,Ақыл мен шындықты қатаң бақылау
Dialogue: 0,0:01:06.75,0:01:11.17,op,NTP,0000,0000,0000,,Өзімді кесіп, олардың ессіздігі үшін айқайлаймын
Dialogue: 0,0:01:11.17,0:01:15.42,op,NTP,0000,0000,0000,,Ешқашан бітпейтін қорқынышты түспен ояныңыз
Dialogue: 0,0:01:15.47,0:01:20.22,op,NTP,0000,0000,0000,,Бұл бұралған бас жоспардың басты тартымдылығы
Dialogue: 0,0:01:32.86,0:01:37.24,op,NTP,0000,0000,0000,,Мен сенің өлген адамың боламын
Dialogue: 0,0:01:37.28,0:01:41.70,op,NTP,0000,0000,0000,,Менің қолымдағы қаннан басқа ештеңе жоқ
Dialogue: 0,0:01:41.78,0:01:46.08,op,NTP,0000,0000,0000,,Сіздің ғажайыптар елінде қалдыңыз
Dialogue: 0,0:01:46.12,0:01:50.46,op,NTP,0000,0000,0000,,Мен де мен сияқты сені қансыратқым келеді
Dialogue: 0,0:01:50.46,0:01:54.88,op,NTP,0000,0000,0000,,Ендеше мені өлген адам ет
Dialogue: 0,0:01:54.92,0:01:59.30,op,NTP,0000,0000,0000,,Тамырымда тек умен
Dialogue: 0,0:01:59.34,0:02:03.60,op,NTP,0000,0000,0000,,Сіздің ғажайыптар елінде қалдыңыз
Dialogue: 0,0:02:03.64,0:02:05.93,op,NTP,0000,0000,0000,,Мен жасауым керек шайқаста қалдым
Dialogue: 0,0:02:05.98,0:02:08.77,op,NTP,0000,0000,0000,,Мен де сені мен сияқты қанды қыламын
Dialogue: 0,0:00:03.81,0:00:04.77,jp_text,NTP,0000,0000,0000,,Ганта
Dialogue: 0,0:00:13.78,0:00:14.28,jp_text,NTP,0000,0000,0000,,Карако
Dialogue: 0,0:00:14.28,0:00:14.95,jp_text,NTP,0000,0000,0000,,Қарако-сан
Dialogue: 0,0:00:14.95,0:00:16.87,jp_text,NTP,0000,0000,0000,,Барлығың жүгіріңдер, тез өтіңдер!
Dialogue: 0,0:00:16.87,0:00:17.78,jp_text,NTP,0000,0000,0000,,Не айтып тұрсың...
Dialogue: 0,0:00:17.91,0:00:20.08,jp_text,NTP,0000,0000,0000,,Күте тұрыңыз, егер бәріміз бірге жасасақ
Dialogue: 0,0:00:20.08,0:00:21.08,jp_text,NTP,0000,0000,0000,,Менің уақытым жоқ. Асықшы.
Dialogue: 0,0:00:21.08,0:00:22.54,jp_text,NTP,0000,0000,0000,,Бірақ Қарако-сан
Dialogue: 0,0:00:23.66,0:00:24.87,jp_text,NTP,0000,0000,0000,,Қарако-сан
Dialogue: 0,0:00:29.17,0:00:31.46,jp_text,NTP,0000,0000,0000,,Өтінемін, Ганта.
Dialogue: 0,0:02:11.15,0:02:14.53,jp_text,NTP,0000,0000,0000,,Әй, мынау «Ойынның фолындағы» жігіт емес пе?
Dialogue: 0,0:02:14.61,0:02:17.24,jp_text,NTP,0000,0000,0000,,Мұндай қашқын әйел басшының орынбасары.
Dialogue: 0,0:02:17.61,0:02:19.86,jp_text,NTP,0000,0000,0000,,Наги не ойлайды?
Dialogue: 0,0:02:20.16,0:02:22.33,jp_text,NTP,0000,0000,0000,,Дұрыс, бұл ойын таяқшасы.
Dialogue: 0,0:02:22.58,0:02:24.41,jp_text,NTP,0000,0000,0000,,Жай ғана жақындау сені өлтіруі мүмкін
Dialogue: 0,0:02:24.45,0:02:25.95,jp_text,NTP,0000,0000,0000,,Мен оны аздап естимін.
Dialogue: 0,0:02:32.54,0:02:34.25,jp_text,NTP,0000,0000,0000,,Бұл әдемі тон.
Dialogue: 0,0:02:37.92,0:02:39.68,jp_text,NTP,0000,0000,0000,,Бұл жай ғана қоңырау
Dialogue: 0,0:02:40.80,0:02:42.55,jp_text,NTP,0000,0000,0000,,Бұл маңызды достың дыбысы.
Dialogue: 0,0:02:44.97,0:02:47.10,jp_text,NTP,0000,0000,0000,,Қандай жағдайға тап болсаңыз да
Dialogue: 0,0:02:47.31,0:02:49.56,jp_text,NTP,0000,0000,0000,,Қоңырау соғылып жатқанда
Dialogue: 0,0:02:50.31,0:02:52.56,jp_text,NTP,0000,0000,0000,,Мен достарымның қасымда болғанын білемін.
Dialogue: 0,0:02:53.69,0:02:55.65,jp_text,NTP,0000,0000,0000,,Тіпті мына қараңғы жер астында
Dialogue: 0,0:02:56.32,0:02:58.65,jp_text,NTP,0000,0000,0000,,Күннің шуақты екенін сездіретін дыбыс.
Dialogue: 0,0:03:00.36,0:03:02.62,jp_text,NTP,0000,0000,0000,,Мен әлі дос боламыз деп айта алмаймын.
Dialogue: 0,0:03:02.78,0:03:05.37,jp_text,NTP,0000,0000,0000,,Бірақ сен мұнда осылай келдің.
Dialogue: 0,0:03:07.66,0:03:12.96,jp_text,NTP,0000,0000,0000,,Карцерал фестивалінде шайқасқаныңда оның кеудеңде тербеліп тұрғанын көргенде.
Dialogue: 0,0:03:07.66,0:03:12.96,Float_jp,NTP,0000,0000,0000,,Карнавал мәйіті
Dialogue: 0,0:03:13.67,0:03:15.54,jp_text,NTP,0000,0000,0000,,Мен бұл үнді естігенде
Dialogue: 0,0:03:16.55,0:03:20.63,jp_text,NTP,0000,0000,0000,,Мен сізді жай ғана күшті адам емес сияқты сезінемін.
Dialogue: 0,0:03:22.72,0:03:24.97,jp_text,NTP,0000,0000,0000,,Сондықтан мен сізді басшының орынбасары болуды өтіндім.
Dialogue: 0,0:03:25.55,0:03:27.47,jp_text,NTP,0000,0000,0000,,Барлығы осы
Dialogue: 0,0:03:27.97,0:03:28.85,jp_text,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:03:40.70,0:03:41.95,jp_text,NTP,0000,0000,0000,,Ақымаққа ұқсайды
Dialogue: 0,0:03:44.03,0:03:45.83,jp_text,NTP,0000,0000,0000,,Барлығы кесіп өтті ме?
Dialogue: 0,0:03:47.58,0:03:48.49,jp_text,NTP,0000,0000,0000,,Ақымақ
Dialogue: 0,0:03:50.00,0:03:54.38,jp_text,NTP,0000,0000,0000,,Маған не қалайтыныңды айта аласың ба, ақымақ?
Dialogue: 0,0:04:06.60,0:04:12.81,jp_text,NTP,0000,0000,0000,,Өкініштісі, менің «Күнәнің бұтағын» да күзетші ретінде пайдалануға болады.
Dialogue: 0,0:04:13.77,0:04:14.81,jp_text,NTP,0000,0000,0000,,Содан кейін
Dialogue: 0,0:04:17.15,0:04:21.36,jp_text,NTP,0000,0000,0000,,Оның үміті елес болса да
Dialogue: 0,0:04:21.86,0:04:23.49,jp_text,NTP,0000,0000,0000,,Бірге болыңыз
Dialogue: 0,0:04:24.03,0:04:30.04,jp_text,NTP,0000,0000,0000,,Бұл біздің Ямато Надешиконың рухы.
Dialogue: 0,0:05:08.91,0:05:11.70,jp_text,NTP,0000,0000,0000,,Жарайды, Қарако-сан.
Dialogue: 0,0:05:12.41,0:05:15.25,jp_text,NTP,0000,0000,0000,,Ол үшін алаңдаудың қажеті жоқ.
Dialogue: 0,0:05:16.42,0:05:20.25,jp_text,NTP,0000,0000,0000,,Бірақ сол жағдайдан...
Dialogue: 0,0:05:24.59,0:05:28.34,jp_text,NTP,0000,0000,0000,,Ganta, ask for that.
Dialogue: 0,0:05:31.26,0:05:32.22,jp_text,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:05:34.27,0:05:36.31,jp_text,NTP,0000,0000,0000,,Сіз оны бұрын байқадыңыз.
Dialogue: 0,0:05:36.64,0:05:38.35,jp_text,NTP,0000,0000,0000,,Сондай-ақ қабір күзетшілеріне
Dialogue: 0,0:05:36.64,0:05:38.35,Float_jp,NTP,0000,0000,0000,,Жетекші
Dialogue: 0,0:05:38.44,0:05:39.98,jp_text,NTP,0000,0000,0000,,Міндетті емес.
Dialogue: 0,0:05:40.52,0:05:43.53,jp_text,NTP,0000,0000,0000,,Байқасаңыз, бұл жер баяғыда жабылған болуы керек еді.
Dialogue: 0,0:05:43.78,0:05:47.91,jp_text,NTP,0000,0000,0000,,Вакабаяши мен Мияко да мазалайды, сондықтан олар өз бағыттарын анықтай алмайды.
Dialogue: 0,0:05:48.99,0:05:51.33,jp_text,NTP,0000,0000,0000,,Егер мен сол лифтке көтеріле алсам
Dialogue: 0,0:05:51.83,0:05:53.87,jp_text,NTP,0000,0000,0000,,Енді мен қалай болса да шыға аламын.
Dialogue: 0,0:05:54.83,0:05:56.10,jp_text,NTP,0000,0000,0000,,Лифт
Dialogue: 0,0:05:56.79,0:06:00.75,jp_text,NTP,0000,0000,0000,,Наги-сан және басқалары оны диспетчерлік бөлмеден жылжыту керек.
Dialogue: 0,0:06:00.96,0:06:01.84,jp_text,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:06:02.46,0:06:03.80,jp_text,NTP,0000,0000,0000,,Егер бұл нәрсе жұмыс істесе
Dialogue: 0,0:06:04.51,0:06:07.05,jp_text,NTP,0000,0000,0000,,Бұл Наги мен Рокуроның сәтті болғанының дәлелі.
Dialogue: 0,0:06:19.73,0:06:21.61,jp_text,NTP,0000,0000,0000,,Жақсысың ба? Рокуро
Dialogue: 0,0:06:21.90,0:06:22.82,jp_text,NTP,0000,0000,0000,,О
Dialogue: 0,0:06:23.90,0:06:26.36,jp_text,NTP,0000,0000,0000,,Материалды тиеу элеваторын іске қосыңыз
Dialogue: 0,0:06:26.61,0:06:29.95,jp_text,NTP,0000,0000,0000,,Егер бәрі ойдағыдай болса, барлығы қақпаға жеткен болады.
Dialogue: 0,0:06:43.17,0:06:47.01,jp_text,NTP,0000,0000,0000,,Сен, мұнда неге келдің?
Dialogue: 0,0:06:49.30,0:06:52.01,jp_text,NTP,0000,0000,0000,,Тағы бір рет, өтінемін!
Dialogue: 0,0:06:52.60,0:06:57.14,jp_text,NTP,0000,0000,0000,,Аа, мені дұрыс қарсы алғаныңыз өте жақсы болды.
Dialogue: 0,0:06:57.64,0:06:58.85,jp_text,NTP,0000,0000,0000,,Жасың нешеде?
Dialogue: 0,0:06:59.23,0:07:03.31,jp_text,NTP,0000,0000,0000,,Мен бастауыш мектептің екінші сыныбында оқимын, үй тапсырмасын орындадым.
Dialogue: 0,0:07:03.40,0:07:05.90,jp_text,NTP,0000,0000,0000,,Мен бүгін жұмыс істеуім керек.
Dialogue: 0,0:07:06.73,0:07:09.78,jp_text,NTP,0000,0000,0000,,Мен қиындыққа тап болдым. Мен өзімді адасып қалғандай сезінемін.
Dialogue: 0,0:07:10.03,0:07:13.95,jp_text,NTP,0000,0000,0000,,Рокуро Лифтті бәрібір іске қосыңыз.
Dialogue: 0,0:07:17.66,0:07:19.12,jp_text,NTP,0000,0000,0000,,Бұл жерде қауіпті.
Dialogue: 0,0:07:19.79,0:07:21.54,jp_text,NTP,0000,0000,0000,,Бізбен бірге кел
Dialogue: 0,0:07:27.92,0:07:30.59,jp_text,NTP,0000,0000,0000,,Рокуро тез лифтпен жүр
Dialogue: 0,0:07:31.26,0:07:33.80,jp_text,NTP,0000,0000,0000,,Лифтті іске қоспаңыз
Dialogue: 0,0:07:35.93,0:07:37.26,jp_text,NTP,0000,0000,0000,,Онда ол енді
Dialogue: 0,0:07:42.65,0:07:45.27,jp_text,NTP,0000,0000,0000,,Өйткені ол бастапқыда осылай есептелген.
Dialogue: 0,0:07:48.23,0:07:49.32,jp_text,NTP,0000,0000,0000,,Титан шабуылына ұшыраған Трост ауданында,
Dialogue: 0,0:08:03.00,0:08:08.21,jp_text,NTP,0000,0000,0000,,Қабір сақтаушының қадам басшы - қызғылт сары ұшқын
Dialogue: 0,0:08:03.00,0:08:08.21,Float_jp,NTP,0000,0000,0000,,Жетекші
Dialogue: 0,0:08:08.25,0:08:10.46,jp_text,NTP,0000,0000,0000,,I will punish the bad kids.
Dialogue: 0,0:08:11.88,0:08:13.13,jp_text,NTP,0000,0000,0000,,Түсінікті
Dialogue: 0,0:08:17.97,0:08:22.60,jp_text,NTP,0000,0000,0000,,Өкінішке орай бүгін жаңбыр жауып тұр.
Dialogue: 0,0:08:30.15,0:08:31.40,jp_text,NTP,0000,0000,0000,,The “branches of sin” are gone.
Dialogue: 0,0:08:47.04,0:08:51.51,jp_text,NTP,0000,0000,0000,,Сіздің күнәларыңыз Исголтияның 21-өлшемінде тазартылады
Dialogue: 0,0:08:52.13,0:08:54.26,jp_text,NTP,0000,0000,0000,,Қан жай қанға айналады
Dialogue: 0,0:08:54.51,0:08:59.56,jp_text,NTP,0000,0000,0000,,Сен енді «Үкі» емессің, тағы да қариясың.
Dialogue: 0,0:09:06.23,0:09:08.94,jp_text,NTP,0000,0000,0000,,Мұны Игараши-кун да айтқан.
Dialogue: 0,0:09:14.74,0:09:18.45,jp_text,NTP,0000,0000,0000,,Сонымен, сіз бейнені қайта жаздыңыз ба?
Dialogue: 0,0:09:23.41,0:09:24.83,jp_text,NTP,0000,0000,0000,,Құрт жегіш
Dialogue: 0,0:09:26.04,0:09:26.83,jp_text,NTP,0000,0000,0000,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:09:27.05,0:09:32.00,jp_text,NTP,0000,0000,0000,,«Күнә тармағының» қанындағы Аты жоқ құртты лезде тотықтырады.
Dialogue: 0,0:09:32.55,0:09:36.93,jp_text,NTP,0000,0000,0000,,Басқаша айтқанда, қабір күзетшісінің қаруына тиген «күнә бұтағы».
Dialogue: 0,0:09:32.55,0:09:36.93,Float_jp,NTP,0000,0000,0000,,Жетекші
Dialogue: 0,0:09:36.97,0:09:39.22,jp_text,NTP,0000,0000,0000,,Ол бөлшектеледі.
Dialogue: 0,0:09:39.97,0:09:41.31,jp_text,NTP,0000,0000,0000,,Түсіндің бе?
Dialogue: 0,0:09:42.68,0:09:44.14,jp_text,NTP,0000,0000,0000,,Әдепті болыңыз
Dialogue: 0,0:09:45.56,0:09:47.85,jp_text,NTP,0000,0000,0000,,Ханым ретінде істеу табиғи нәрсе.
Dialogue: 0,0:09:50.61,0:09:53.57,jp_text,NTP,0000,0000,0000,,Бұл сенің кінәң емес, қария.
Dialogue: 0,0:09:53.98,0:09:55.28,jp_text,NTP,0000,0000,0000,,Мына жігіттер сияқты
Dialogue: 0,0:09:55.28,0:09:59.99,jp_text,NTP,0000,0000,0000,,Менің миыммен араласып, денемнің шектегішін алып тастайтыным жоқ.
Dialogue: 0,0:10:00.53,0:10:02.99,jp_text,NTP,0000,0000,0000,,Мен сені үнсіз ұстауыма рұқсат етпе.
Dialogue: 0,0:10:04.58,0:10:06.58,jp_text,NTP,0000,0000,0000,,Бұл жоспар қандай болса да
Dialogue: 0,0:10:07.92,0:10:13.63,jp_text,NTP,0000,0000,0000,,Әркімнің үміті асқақтайды
Dialogue: 0,0:10:30.48,0:10:31.98,jp_text,NTP,0000,0000,0000,,Бұл пайдасыз.
Dialogue: 0,0:11:01.93,0:11:03.05,jp_text,NTP,0000,0000,0000,,Кеш болды.
Dialogue: 0,0:11:03.51,0:11:04.64,jp_text,NTP,0000,0000,0000,,Ол қозғалмайды.
Dialogue: 0,0:11:05.47,0:11:09.48,jp_text,NTP,0000,0000,0000,,Наги Рокуро, аман бол.
Dialogue: 0,0:11:13.69,0:11:14.61,jp_text,NTP,0000,0000,0000,,Наги-сан
Dialogue: 0,0:11:29.50,0:11:31.46,jp_text,NTP,0000,0000,0000,,Бұл жаман мінез.
Dialogue: 0,0:11:31.83,0:11:34.67,jp_text,NTP,0000,0000,0000,,Бөлмені ашық қызыл түске айналдырып, қашыңыз
Dialogue: 0,0:11:35.38,0:11:38.63,jp_text,NTP,0000,0000,0000,,Мұндай бала ешқашан жақсы ересек болмайды.
Dialogue: 0,0:11:42.13,0:11:43.47,jp_text,NTP,0000,0000,0000,,Қандай бала
Dialogue: 0,0:11:45.55,0:11:47.85,jp_text,NTP,0000,0000,0000,,Маған көбірек жаза керек.
Dialogue: 0,0:11:47.97,0:11:51.69,jp_text,NTP,0000,0000,0000,,Бірақ аккордтар маған оны өлтірмеу керектігін айтты.
Dialogue: 0,0:11:53.81,0:11:58.28,jp_text,NTP,0000,0000,0000,,Бұл аз, кәдімгідей өлетін сияқты.
Dialogue: 0,0:12:00.82,0:12:02.32,jp_text,NTP,0000,0000,0000,,Жақсы емес.
Dialogue: 0,0:12:03.24,0:12:06.87,jp_text,NTP,0000,0000,0000,,Сіздің жазаңыз дұрыс кешірім сұрағанша.
Dialogue: 0,0:12:07.66,0:12:09.25,jp_text,NTP,0000,0000,0000,,Даттейо Наги
Dialogue: 0,0:12:09.79,0:12:12.25,jp_text,NTP,0000,0000,0000,,Мүмкін кешікпей кешірім сұрау керек шығар.
Dialogue: 0,0:12:12.54,0:12:14.46,jp_text,NTP,0000,0000,0000,,Мұның қажеті жоқ.
Dialogue: 0,0:12:14.88,0:12:16.46,jp_text,NTP,0000,0000,0000,,Бала басқа жақтан болса да
Dialogue: 0,0:12:16.63,0:12:19.13,jp_text,NTP,0000,0000,0000,,Үлкендер қателіктерді назардан тыс қалдырмауы керек
Dialogue: 0,0:12:19.13,0:12:22.05,jp_text,NTP,0000,0000,0000,,Дұрыс, Лингті кейін жазалайық.
Dialogue: 0,0:12:22.13,0:12:25.01,jp_text,NTP,0000,0000,0000,,А? Бұл не?
Dialogue: 0,0:12:26.01,0:12:29.60,jp_text,NTP,0000,0000,0000,,Сіз білмейсіз бе? Сіз жеткілікті оқыған жоқсыз.
Dialogue: 0,0:12:31.06,0:12:34.81,jp_text,NTP,0000,0000,0000,,Линшю Қытайдағы Цин патшалығының соңына дейін жалғасты.
Dialogue: 0,0:12:34.85,0:12:36.69,jp_text,NTP,0000,0000,0000,,Көркем бөлшектеу
Dialogue: 0,0:12:37.15,0:12:40.15,jp_text,NTP,0000,0000,0000,,Денені кесу арқылы жазалау
Dialogue: 0,0:12:40.48,0:12:42.82,jp_text,NTP,0000,0000,0000,,Алдымен пышақ кеуде етін кеседі.
Dialogue: 0,0:12:43.57,0:12:49.70,jp_text,NTP,0000,0000,0000,,Ал жоғарғы қолдар, асқазан, жамбас, бөкселер...
Dialogue: 0,0:12:50.45,0:12:52.29,jp_text,NTP,0000,0000,0000,,Қанша қылыш салуым керек?
Dialogue: 0,0:13:04.43,0:13:07.97,jp_text,NTP,0000,0000,0000,,Мұқият жасасаңыз, 3000-ға жуық қылыш алуға болады.
Dialogue: 0,0:13:18.02,0:13:20.94,jp_text,NTP,0000,0000,0000,,Етті ойған кезде ғана қан шығады.
Dialogue: 0,0:13:21.82,0:13:24.28,jp_text,NTP,0000,0000,0000,,Қорыққан сайын
Dialogue: 0,0:13:24.53,0:13:27.07,jp_text,NTP,0000,0000,0000,,Қан түсе бастады.
Dialogue: 0,0:13:29.20,0:13:30.87,jp_text,NTP,0000,0000,0000,,Сондықтан мен өлемін
Dialogue: 0,0:13:30.91,0:13:32.24,jp_text,NTP,0000,0000,0000,,Жарайды
Dialogue: 0,0:13:32.87,0:13:37.12,jp_text,NTP,0000,0000,0000,,Ауырсыну керемет ақыл-ойды дамытуға көмектеседі.
Dialogue: 0,0:13:38.79,0:13:41.55,jp_text,NTP,0000,0000,0000,,Анам маған солай үйретті.
Dialogue: 0,0:13:46.18,0:13:48.80,jp_text,NTP,0000,0000,0000,,Бетіңіздегі етті қырып тастаған кезде сенімдімін.
Dialogue: 0,0:13:49.26,0:13:51.68,jp_text,NTP,0000,0000,0000,,Сіз де керемет бола аласыз.
Dialogue: 0,0:13:52.60,0:13:55.10,jp_text,NTP,0000,0000,0000,,Міне, сіз бұл туралы айттыңыз.
Dialogue: 0,0:13:55.73,0:13:58.48,jp_text,NTP,0000,0000,0000,,Балабақшада орын алған адам өлтіру
Dialogue: 0,0:13:59.06,0:14:02.48,jp_text,NTP,0000,0000,0000,,Жазалау – жақсы әйелдің міндеті.
Dialogue: 0,0:14:03.19,0:14:05.65,jp_text,NTP,0000,0000,0000,,Ханым...?
Dialogue: 0,0:14:06.49,0:14:09.16,jp_text,NTP,0000,0000,0000,,Сыйлы ханым олай жасамас еді.
Dialogue: 0,0:14:10.95,0:14:13.58,jp_text,NTP,0000,0000,0000,,Ең дұрысы, оны жас ханым деп атауға болады.
Dialogue: 0,0:14:13.95,0:14:16.75,jp_text,NTP,0000,0000,0000,,Сыйлы немесе ханым болудан алыс.
Dialogue: 0,0:14:17.46,0:14:18.62,jp_text,NTP,0000,0000,0000,,Poor guy
Dialogue: 0,0:14:19.25,0:14:24.63,jp_text,NTP,0000,0000,0000,,Іші дөрекі бұралып, шіріген аянышты қыз.
Dialogue: 0,0:14:31.60,0:14:35.35,jp_text,NTP,0000,0000,0000,,Жас ханым емес...
Dialogue: 0,0:14:36.98,0:14:39.77,jp_text,NTP,0000,0000,0000,,Spark Lady
Dialogue: 0,0:14:53.78,0:14:54.91,jp_text,NTP,0000,0000,0000,,Бұл Жолиненің брошы
Dialogue: 0,0:14:55.04,0:14:57.20,jp_text,NTP,0000,0000,0000,,Парақтар өте лас
Dialogue: 0,0:14:57.45,0:15:00.67,jp_text,NTP,0000,0000,0000,,17-ші өлшемді жазамен шайқау
Dialogue: 0,0:15:00.67,0:15:03.63,jp_text,NTP,0000,0000,0000,,Ол бастапқы орнына қайтарылуы керек.
Dialogue: 0,0:15:03.96,0:15:05.92,jp_text,NTP,0000,0000,0000,,Сиқыр формуласын ашу
Dialogue: 0,0:15:06.51,0:15:07.67,jp_text,NTP,0000,0000,0000,,Бұл Жолиненің брошы
Dialogue: 0,0:15:07.76,0:15:10.09,jp_text,NTP,0000,0000,0000,,Шитаке саңырауқұлақтарын регургитациялау
Dialogue: 0,0:15:10.47,0:15:11.58,jp_text,NTP,0000,0000,0000,,Жаза
Dialogue: 0,0:15:11.72,0:15:15.93,jp_text,NTP,0000,0000,0000,,Баттен Орроу жолындағы үш тесікті қайта толтыру керек.
Dialogue: 0,0:15:16.31,0:15:18.35,jp_text,NTP,0000,0000,0000,,Сиқыр формуласын ашу
Dialogue: 0,0:15:21.60,0:15:23.90,jp_text,NTP,0000,0000,0000,,Мен сені жаңа ғана жазаладым.
Dialogue: 0,0:15:24.19,0:15:25.32,jp_text,NTP,0000,0000,0000,,Анам да
Dialogue: 0,0:15:25.52,0:15:28.44,jp_text,NTP,0000,0000,0000,,Тіпті анам да солай айтады.
Dialogue: 0,0:15:33.24,0:15:35.03,jp_text,NTP,0000,0000,0000,,Төсекті де суламаймын
Dialogue: 0,0:15:35.16,0:15:37.16,jp_text,NTP,0000,0000,0000,,Тіпті саңырауқұлақтарды да жұтуға болады
Dialogue: 0,0:15:38.95,0:15:40.87,jp_text,NTP,0000,0000,0000,,Тіпті 100 ұпай алуға болады.
Dialogue: 0,0:15:48.88,0:15:54.60,jp_text,NTP,0000,0000,0000,,Жазалау мені күлдіреді.
Dialogue: 0,0:15:55.80,0:15:58.52,jp_text,NTP,0000,0000,0000,,Осы сияқты нәрселер рефлексияға түрткі болады.
Dialogue: 0,0:15:59.68,0:16:01.89,jp_text,NTP,0000,0000,0000,,Тек дайындығы жоқтар
Dialogue: 0,0:16:02.35,0:16:03.19,jp_text,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,0:16:11.53,0:16:13.28,jp_text,NTP,0000,0000,0000,,Мен саған бұлай істеуге рұқсат бермеймін.
Dialogue: 0,0:16:13.91,0:16:15.16,jp_text,NTP,0000,0000,0000,,Жарайды ма?
Dialogue: 0,0:16:16.28,0:16:17.83,jp_text,NTP,0000,0000,0000,,Егер сіз оны өшірмесеңіз
Dialogue: 0,0:16:21.04,0:16:25.88,jp_text,NTP,0000,0000,0000,,Қанның жаңбырынан сақ бол, қыз.
Dialogue: 0,0:16:29.51,0:16:30.38,jp_text,NTP,0000,0000,0000,,(Ойын музыкасы ұялы телефоннан ойнап тұр)
Dialogue: 0,0:16:30.46,0:16:32.80,jp_text,NTP,0000,0000,0000,,Сіз мұны жасадыңыз Наги Рокуро
Dialogue: 0,0:16:33.47,0:16:34.72,jp_text,NTP,0000,0000,0000,,Жарайды, кеттік.
Dialogue: 0,0:16:45.98,0:16:48.23,jp_text,NTP,0000,0000,0000,,Мен оларды да міндетті түрде жіберемін.
Dialogue: 0,0:16:49.94,0:16:52.36,jp_text,NTP,0000,0000,0000,,Ұстаңыз, Ганта-кун.
Dialogue: 0,0:16:52.49,0:16:53.45,jp_text,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:16:53.70,0:16:56.28,jp_text,NTP,0000,0000,0000,,Бірақ мен мұны сыртта жасай аламын ба?
Dialogue: 0,0:16:56.32,0:16:58.24,jp_text,NTP,0000,0000,0000,,Біздің фабрикаға келгіңіз келе ме?
Dialogue: 0,0:16:58.41,0:17:00.04,jp_text,NTP,0000,0000,0000,,Мүмкін маған да қатысу керек шығар.
Dialogue: 0,0:17:00.37,0:17:02.87,jp_text,NTP,0000,0000,0000,,Қожайынның қатал әйеліне де табынуға болады.
Dialogue: 0,0:17:02.87,0:17:05.25,jp_text,NTP,0000,0000,0000,,Эй, эй, маған ғашық болма, Уэдзима
Dialogue: 0,0:17:06.58,0:17:09.09,jp_text,NTP,0000,0000,0000,,Бірақ мені алдап жатсаңыз ше?
Dialogue: 0,0:17:10.84,0:17:14.47,jp_text,NTP,0000,0000,0000,,Уайымдама, мен бәріне дайынмын.
Dialogue: 0,0:17:17.22,0:17:19.93,jp_text,NTP,0000,0000,0000,,Ей, жігіттер
Dialogue: 0,0:17:19.93,0:17:22.27,jp_text,NTP,0000,0000,0000,,Менің әнімді де тыңдаңдар.
Dialogue: 0,0:17:28.77,0:17:32.07,jp_text,NTP,0000,0000,0000,,Ақ әйел жоқ.
Dialogue: 0,0:17:32.65,0:17:33.82,jp_text,NTP,0000,0000,0000,,Қабір сақтаушы
Dialogue: 0,0:17:32.65,0:17:33.82,Float_jp,NTP,0000,0000,0000,,Жетекші
Dialogue: 0,0:17:33.90,0:17:36.20,jp_text,NTP,0000,0000,0000,,Мына қарғыс атқыр бала
Dialogue: 0,0:17:36.57,0:17:39.20,jp_text,NTP,0000,0000,0000,,Өте қырылған бас
Dialogue: 0,0:17:42.41,0:17:44.45,jp_text,NTP,0000,0000,0000,,«Күнәнің бұтағы» жұмыс істемейді
Dialogue: 0,0:17:45.46,0:17:46.67,jp_text,NTP,0000,0000,0000,,Харуми!
Dialogue: 0,0:18:03.22,0:18:05.10,jp_text,NTP,0000,0000,0000,,Сіз кереметсіз.
Dialogue: 0,0:18:05.56,0:18:09.10,jp_text,NTP,0000,0000,0000,,Ұшқынды басып, лифтті іске қосу ықтималдығы қандай?
Dialogue: 0,0:18:09.10,0:18:11.15,jp_text,NTP,0000,0000,0000,,Тіпті екі минут болмауы керек еді.
Dialogue: 0,0:18:12.48,0:18:17.70,jp_text,NTP,0000,0000,0000,,Бәріне де бейіт сақшыларын жібердің бе?
Dialogue: 0,0:18:12.48,0:18:17.70,Float_jp,NTP,0000,0000,0000,,Жетекші
Dialogue: 0,0:18:17.86,0:18:19.28,jp_text,NTP,0000,0000,0000,,Бұл анық емес
Dialogue: 0,0:18:19.91,0:18:25.91,jp_text,NTP,0000,0000,0000,,Дегенмен, олар сыртқы әлемге деректер чиптерін жіберетін шығар.
Dialogue: 0,0:18:26.04,0:18:28.79,jp_text,NTP,0000,0000,0000,,Ықтималдық жүз жеті шаш
Dialogue: 0,0:18:30.38,0:18:33.92,jp_text,NTP,0000,0000,0000,,Әр адамның үміті бар
Dialogue: 0,0:18:34.71,0:18:37.13,jp_text,NTP,0000,0000,0000,,Ықтималдық қаншалықты төмен болса да
Dialogue: 0,0:18:37.84,0:18:38.93,jp_text,NTP,0000,0000,0000,,Біз...
Dialogue: 0,0:18:40.34,0:18:42.51,jp_text,NTP,0000,0000,0000,,Сен мүлдем ақымақсың.
Dialogue: 0,0:18:43.01,0:18:46.85,jp_text,NTP,0000,0000,0000,,Менің жұмысым оны нөлге дейін түсіру.
Dialogue: 0,0:18:47.48,0:18:51.98,jp_text,NTP,0000,0000,0000,,Неліктен Tamaki Promoter сіздің фарсыңызға соншалықты араласады?
Dialogue: 0,0:18:52.69,0:18:54.94,jp_text,NTP,0000,0000,0000,,Мен қажетсіз есептеулер жасамаймын.
Dialogue: 0,0:18:55.61,0:18:58.32,jp_text,NTP,0000,0000,0000,,Мұны істеудің қарапайым жолы болды.
Dialogue: 0,0:18:58.90,0:19:01.11,jp_text,NTP,0000,0000,0000,,Бұл адам жарқыраған нәрселерді ұнатады.
Dialogue: 0,0:19:01.49,0:19:05.24,jp_text,NTP,0000,0000,0000,,Бұл финал емес.
Dialogue: 0,0:19:10.12,0:19:11.25,jp_text,NTP,0000,0000,0000,,Косуги мырза
Dialogue: 0,0:19:11.33,0:19:13.63,jp_text,NTP,0000,0000,0000,,Мына жігітті қорғаңыз, Ганта.
Dialogue: 0,0:19:15.34,0:19:16.59,jp_text,NTP,0000,0000,0000,,Бұл біздің
Dialogue: 0,0:19:24.14,0:19:26.52,jp_text,NTP,0000,0000,0000,,Үміт
Dialogue: 0,0:19:28.60,0:19:31.35,jp_text,NTP,0000,0000,0000,,Мен оны саған қалдырдым...
Dialogue: 0,0:19:35.36,0:19:36.57,jp_text,NTP,0000,0000,0000,,Өтінемін
Dialogue: 0,0:19:37.32,0:19:40.36,jp_text,NTP,0000,0000,0000,,Сіз қандай еркіндікті қалайсыз?
Dialogue: 0,0:19:41.95,0:19:44.12,jp_text,NTP,0000,0000,0000,,Барлығының үміті
Dialogue: 0,0:19:45.24,0:19:46.87,jp_text,NTP,0000,0000,0000,,Менің үмітім
Dialogue: 0,0:19:50.46,0:19:51.75,jp_text,NTP,0000,0000,0000,,Дірілдесең жақсы емес.
Dialogue: 0,0:19:52.50,0:19:53.71,jp_text,NTP,0000,0000,0000,,Үмітті үз
Dialogue: 0,0:20:06.89,0:20:11.06,jp_text,NTP,0000,0000,0000,,Өтінемін, біреу мені тыңдасын.
Dialogue: 0,0:20:12.31,0:20:15.23,jp_text,NTP,0000,0000,0000,,Сол жерде болыңыз
Dialogue: 0,0:20:17.11,0:20:19.32,jp_text,NTP,0000,0000,0000,,Мен ұйықтай алмаймын, өйткені бұл өте тітіркендіреді
Dialogue: 0,0:20:19.65,0:20:21.28,jp_text,NTP,0000,0000,0000,,Менің қарным ашты
Dialogue: 0,0:20:23.95,0:20:24.99,jp_text,NTP,0000,0000,0000,,Ганта?
Dialogue: 0,0:20:26.78,0:20:27.66,jp_text,NTP,0000,0000,0000,,Қамшы?
Dialogue: 0,0:20:28.37,0:20:29.58,jp_text,NTP,0000,0000,0000,,Кім?
Dialogue: 0,0:20:48.97,0:20:52.14,jp_text,NTP,0000,0000,0000,,Бүгін Эйсман келмейді деп үміттенемін.
Dialogue: 0,0:20:52.98,0:20:54.14,jp_text,NTP,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:20:54.39,0:20:58.77,jp_text,NTP,0000,0000,0000,,Эйсманға фантомдық финалдық раунд берілді.
Dialogue: 0,0:21:00.78,0:21:05.61,jp_text,NTP,0000,0000,0000,,Зұлым ұйым Эйсманнан басқаның бәрін жою жоспарын жасады.
Dialogue: 0,0:21:05.99,0:21:09.33,jp_text,NTP,0000,0000,0000,,Бұл жігіт жақсы жұмыс істейді.
Dialogue: 0,0:21:09.33,0:21:10.41,jp_text,NTP,0000,0000,0000,,(Польнарефф) Ә? Бұл не? Бұл жабысқақ не?
Dialogue: 0,0:21:11.08,0:21:13.91,jp_text,NTP,0000,0000,0000,,Мен оны эфирге шығаруым керек еді деп ойлаймын.
Dialogue: 0,0:21:14.25,0:21:15.46,jp_text,NTP,0000,0000,0000,,Егер солай болса
Dialogue: 0,0:21:15.46,0:21:16.96,jp_text,NTP,0000,0000,0000,,Үмітті үз
Dialogue: 0,0:21:18.09,0:21:20.34,jp_text,NTP,0000,0000,0000,,Еш жерде үміт жоқ
Dialogue: 0,0:21:20.63,0:21:25.13,jp_text,NTP,0000,0000,0000,,Бұл мені кейінірек оған бәрін үйрету қиындығынан құтқарар еді.
Dialogue: 0,0:21:29.81,0:21:32.68,jp_text,NTP,0000,0000,0000,,Хорда бұрышының қадам ұзындығының уақыты
Dialogue: 0,0:21:34.06,0:21:35.48,jp_text,NTP,0000,0000,0000,,Жеті кәсіби батыр мен үш орта мектеп оқушысы—
Dialogue: 0,0:21:37.73,0:21:40.27,jp_text,NTP,0000,0000,0000,,Мен саған көңілді ән беремін
Dialogue: 0,0:21:46.91,0:21:48.20,jp_text,NTP,0000,0000,0000,,Бұл нені білдіреді?
Dialogue: 0,0:21:48.24,0:21:50.08,jp_text,NTP,0000,0000,0000,,Қалай болғанда да, қазір...
Dialogue: 0,0:21:50.33,0:21:51.28,jp_text,NTP,0000,0000,0000,,Кеттік, Ганта
Dialogue: 0,0:21:52.08,0:21:52.99,jp_text,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:21:57.46,0:21:59.67,jp_text,NTP,0000,0000,0000,,Широ, сен не істеп жатырсың?
Dialogue: 0,0:21:59.92,0:22:01.09,jp_text,NTP,0000,0000,0000,,тіпті Эден кампусында да — қайдағы қырағы көздердің қашан қарап тұрғанын білмейсің.
Dialogue: 0,0:22:01.92,0:22:03.67,jp_text,NTP,0000,0000,0000,,Күте тұрыңыз.
Dialogue: 0,0:22:03.71,0:22:06.84,jp_text,NTP,0000,0000,0000,,Ганта Деректер чипі қайда орналасқан?
Dialogue: 0,0:22:06.88,0:22:08.09,jp_text,NTP,0000,0000,0000,,Чипсы?
Dialogue: 0,0:22:10.18,0:22:11.26,jp_text,NTP,0000,0000,0000,,Неге сен?
Dialogue: 0,0:22:12.26,0:22:14.60,jp_text,NTP,0000,0000,0000,,Сәлем Широ
Dialogue: 0,0:22:36.62,0:22:39.62,jp_text,NTP,0000,0000,0000,,Ганта, сен жақсы ма?
Dialogue: 0,0:24:12.40,0:24:14.85,jp_text,NTP,0000,0000,0000,,Абсурдтың ішінде айналатын абсурд
Dialogue: 0,0:24:14.89,0:24:15.97,jp_text,NTP,0000,0000,0000,,Ешқашан аяқталмайды
Dialogue: 0,0:24:17.03,0:24:21.32,jp_text,NTP,0000,0000,0000,,Әлсіздер қанша жылап, әлсіздіктерін менсінбесе,
Dialogue: 0,0:24:21.82,0:24:24.95,jp_text,NTP,0000,0000,0000,,Қайғылы жағдайдан ешқашан құтылма
Dialogue: 0,0:22:49.26,0:22:52.39,EDJP,NTP,0000,0000,0000,,Рюсей қара және түн
Dialogue: 0,0:22:52.43,0:22:55.93,EDJP,NTP,0000,0000,0000,,Мен мәңгілікке жылауды тоқтата алмаймын
Dialogue: 0,0:22:56.02,0:23:04.48,EDJP,NTP,0000,0000,0000,,Мен бұл сандырақ дүниені жек көрдім
Dialogue: 0,0:23:04.52,0:23:12.95,EDJP,NTP,0000,0000,0000,,Мен бұл лабиринттен шығусыз құтылғым келеді.
Dialogue: 0,0:23:12.99,0:23:17.16,EDJP,NTP,0000,0000,0000,,Мен бостандықты қаладым
Dialogue: 0,0:23:19.04,0:23:26.21,EDJP,NTP,0000,0000,0000,,Қол ұстасып, аспанға қара
Dialogue: 0,0:23:26.63,0:23:34.18,EDJP,NTP,0000,0000,0000,,Мен кешегіден өзгердім
Dialogue: 0,0:23:34.51,0:23:41.14,EDJP,NTP,0000,0000,0000,,Жылтыр Жылтыр Жарқыраған жұлдыздар шексіз
Dialogue: 0,0:23:41.14,0:23:49.53,EDJP,NTP,0000,0000,0000,,Бұл дүние сондай әдемі
Dialogue: 0,0:23:49.69,0:23:56.45,EDJP,NTP,0000,0000,0000,,Жарқыраған Жарқыраған Ай сәулесі Үмітке толы
Dialogue: 0,0:23:56.45,0:24:04.38,EDJP,NTP,0000,0000,0000,,Бұл дүние өте керемет
Dialogue: 0,0:24:04.42,0:24:07.21,EDJP,NTP,0000,0000,0000,,Менің ойымша.
Dialogue: 0,0:00:00.00,0:00:00.00,*Default,NTP,0000,0000,0000,,--------------------------Қызметкерлер------------------------------------
Dialogue: 0,0:24:11.22,0:24:13.22,staff,NTP,0000,0000,0000,,SGS Shukosha субтитрлер өндірісі http://blog.sgsub.com
Dialogue: 0,0:24:13.22,0:24:15.22,staff,NTP,0000,0000,0000,,Аударма: Муюн но Цукиёши Изайой Өңдеген: Хиро Хиби Хитомура
Dialogue: 0,0:24:15.22,0:24:17.22,staff,NTP,0000,0000,0000,,Жапон тілі: Киоку алаңы Өрт уақыты: Менмендік Кеш мезгіл: Қышқыл
Dialogue: 0,0:24:17.22,0:24:19.22,staff,NTP,0000,0000,0000,,BD жүйесі және кеңеюі: Daydream ынтымақтастығы: DC
