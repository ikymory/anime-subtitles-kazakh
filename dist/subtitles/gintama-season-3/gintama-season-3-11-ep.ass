Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:05.67,Default,,0,0,0,,♪~
Dialogue: 0,0:01:25.29,0:01:30.42,Default,,0,0,0,,~♪
Dialogue: 0,0:01:41.10,0:01:42.81,Default,,0,0,0,,Мен әйел болып өмір сүруім керек пе?
Dialogue: 0,0:01:42.93,0:01:44.93,Default,,0,0,0,,Мен адам болып өмір сүруім керек пе?
Dialogue: 0,0:01:45.06,0:01:46.89,Default,,0,0,0,,Кюбэй мырза адасып қалады...
Dialogue: 0,0:01:47.02,0:01:48.65,Default,,0,0,0,,Жұмбақ көріпкел арқылы -
Dialogue: 0,0:01:48.77,0:01:51.31,Default,,0,0,0,,Менің жынысым ер адамға ауыстырылды.
Dialogue: 0,0:01:52.19,0:01:55.24,Default,,0,0,0,,Сонымен қатар, оқиға бүкіл Кабуки қаласына әсер етті...
Dialogue: 0,0:01:55.78,0:01:57.32,Default,,0,0,0,,Джин мырза осындай
Dialogue: 0,0:01:57.61,0:01:59.20,Default,,0,0,0,,Кагура-чан осындай
Dialogue: 0,0:01:59.78,0:02:02.33,Default,,0,0,0,,Мен, Шинпачи Шимура, осылай сезінемін...
Dialogue: 0,0:02:02.45,0:02:03.95,Default,,0,0,0,,...Неге?
Dialogue: 0,0:02:04.58,0:02:07.71,Default,,0,0,0,,Оны Декобокко діні деп аталатын экстремистік діни топ жүзеге асырды.
Dialogue: 0,0:02:08.16,0:02:10.63,Default,,0,0,0,,Жаңа жынысын орындамағандар...
Dialogue: 0,0:02:11.04,0:02:13.13,Default,,0,0,0,,Құдайдың жазасы сізге келетінін айтыңыз.
Dialogue: 0,0:02:13.25,0:02:16.55,Default,,0,0,0,,Өз сенімін мемлекеттік дін етемін деп қорқытты
Dialogue: 0,0:02:17.34,0:02:20.14,Default,,0,0,0,,Бірақ еш себепсіз әдемі болып кеткен Такаразука горилласының арқасында...
Dialogue: 0,0:02:20.26,0:02:23.22,Default,,0,0,0,,Бізді байқағандар қоршауда...
Dialogue: 0,0:02:23.68,0:02:26.85,Default,,0,0,0,,Содан кейін Шинсенгуми реформаланған Мансенгуми де пайда болды.
Dialogue: 0,0:02:27.35,0:02:28.31,Default,,0,0,0,,Окита мырза күткендей...
Dialogue: 0,0:02:28.43,0:02:29.48,Default,,0,0,0,,Сапа Бірақ...
Dialogue: 0,0:02:30.23,0:02:31.81,Default,,0,0,0,,Хиджиката мырза...
Dialogue: 0,0:02:46.66,0:02:49.46,Default,,0,0,0,,Не? Бұл адамдар...
Dialogue: 0,0:02:49.58,0:02:50.54,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:02:51.08,0:02:54.88,Default,,0,0,0,,Бұл қалаға үкіметтің иті жасырынып кірді ме?
Dialogue: 0,0:02:55.13,0:02:57.46,Default,,0,0,0,,Иә, Пачи, бұл ит.
Dialogue: 0,0:02:57.59,0:02:59.84,Default,,0,0,0,,Маған бірі араласқан шошқа сияқты көрінеді.
Dialogue: 0,0:02:59.97,0:03:01.59,Default,,0,0,0,,ТОКИО (Токио) Бұл X сияқты.
Dialogue: 0,0:03:01.72,0:03:04.18,Default,,0,0,0,,Уф! (Шинпачи) ТОКИО X дегеніміз не?
Dialogue: 0,0:03:04.30,0:03:05.89,Default,,0,0,0,,Токио бренді шошқа еті
Dialogue: 0,0:03:06.01,0:03:06.89,Default,,0,0,0,,Мен сенің жүктеріңді көтеремін.
Dialogue: 0,0:03:07.02,0:03:08.64,Default,,0,0,0,,Жоқ, бұл шошқа емес, жын.
Dialogue: 0,0:03:08.77,0:03:10.85,Default,,0,0,0,,Бұл Тосиро Хиджиката, жынның орынбасары.
Dialogue: 0,0:03:11.73,0:03:13.52,Default,,0,0,0,,Ал, Джусиро-сан, емес...
Dialogue: 0,0:03:13.65,0:03:15.36,Default,,0,0,0,,ТОКИО Х-широ, солай ма?
Dialogue: 0,0:03:15.48,0:03:16.90,Default,,0,0,0,,Х-широ деген кім!
Dialogue: 0,0:03:17.03,0:03:18.57,Default,,0,0,0,,Ал, сабыр ет.
Dialogue: 0,0:03:18.69,0:03:19.53,Default,,0,0,0,,Сюширо мырза
Dialogue: 0,0:03:19.65,0:03:20.90,Default,,0,0,0,,Кюширо дегеніміз не?
Dialogue: 0,0:03:21.03,0:03:22.66,Default,,0,0,0,,Неліктен тек рим цифрлары бар?
Dialogue: 0,0:03:23.11,0:03:25.20,Default,,0,0,0,,Маған демалыс беріңізші, сэр.
Dialogue: 0,0:03:25.87,0:03:28.04,Default,,0,0,0,,Сюширо мырза әйел бола салысымен...
Dialogue: 0,0:03:28.16,0:03:30.75,Default,,0,0,0,,Майонездегі осы уақытқа дейін жинақталған калориялар...
Dialogue: 0,0:03:30.87,0:03:34.08,Default,,0,0,0,,Бұл жерде бәрі ұшып кеткен сияқты.
Dialogue: 0,0:03:34.29,0:03:36.54,Default,,0,0,0,,Әйел болу – бұл пәле...
Dialogue: 0,0:03:36.67,0:03:37.96,Default,,0,0,0,,Неге жалғыз мен осындаймын...
Dialogue: 0,0:03:38.09,0:03:40.17,Default,,0,0,0,,Уайымдама, Сюко (Хиджиката) Иә?
Dialogue: 0,0:03:40.30,0:03:41.67,Default,,0,0,0,,Біз бәріміз бірдей емеспіз бе?
Dialogue: 0,0:03:41.80,0:03:45.39,Default,,0,0,0,,Мен де, осы уақытқа дейін жинаған гориллаларымның бәрі жарылып жатыр...
Dialogue: 0,0:03:45.51,0:03:47.93,Default,,0,0,0,,Мынадай көрінсе де, шашы толқынды есек.
Dialogue: 0,0:03:48.06,0:03:49.64,Default,,0,0,0,,Жинақталған Горилла дегеніміз не?
Dialogue: 0,0:03:49.77,0:03:51.68,Default,,0,0,0,,Сіз бұл көзқараспен не айтқыңыз келеді?
Dialogue: 0,0:03:51.81,0:03:52.73,Default,,0,0,0,,Ⅹ
Dialogue: 0,0:03:52.85,0:03:55.90,Default,,0,0,0,,Қыздардың бәрі сен көрінбейтін жерлерде тынымсыз еңбек етуде...
Dialogue: 0,0:03:56.36,0:03:58.19,Default,,0,0,0,,Егер сіз диета ұстасаңыз, мен сізбен бірге барамын.
Dialogue: 0,0:03:58.32,0:03:59.82,Default,,0,0,0,,Жарайды, бәріңе.
Dialogue: 0,0:03:59.94,0:04:01.78,Default,,0,0,0,,Бүгін грильде пісірілген шошқа еті.
Dialogue: 0,0:04:01.90,0:04:04.45,Default,,0,0,0,,Жинақталған S ұшып жатыр~!
Dialogue: 0,0:04:04.57,0:04:06.95,Default,,0,0,0,,Міне, мен грильде ет жегеніме біраз болды.
Dialogue: 0,0:04:07.08,0:04:08.33,Default,,0,0,0,,Мүмкін мен көп жейтін шығармын?
Dialogue: 0,0:04:08.45,0:04:10.70,Default,,0,0,0,,Бірақ ауыздан шыққан иістерден сақ болу керек.
Dialogue: 0,0:04:10.83,0:04:13.12,Default,,0,0,0,,Ой~! Не істеп жатырсың, жас әскер?
Dialogue: 0,0:04:13.25,0:04:15.08,Default,,0,0,0,,Егер сіз дәл қазір осындай нәрсені істеп жатсаңыз!
Dialogue: 0,0:04:15.75,0:04:18.88,Default,,0,0,0,,Егер сіз кедергі келтірсеңіз, сіз де ...
Dialogue: 0,0:04:19.38,0:04:21.80,Default,,0,0,0,,Мен сені кәпірлермен бірге жоямын.
Dialogue: 0,0:04:21.92,0:04:23.30,Default,,0,0,0,,Өкінішке орай
Dialogue: 0,0:04:23.42,0:04:27.30,Default,,0,0,0,,Бізге сен көбірек пұтқасың.
Dialogue: 0,0:04:27.43,0:04:31.10,Default,,0,0,0,,Мен саған енді бұл қалада қалағаныңды істеуге рұқсат бермеймін!
Dialogue: 0,0:04:34.23,0:04:35.10,Default,,0,0,0,,Бұл…
Dialogue: 0,0:04:35.23,0:04:36.56,Default,,0,0,0,,Кәпірлер!
Dialogue: 0,0:04:37.52,0:04:38.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:38.82,0:04:41.44,Default,,0,0,0,,Уайымдамаңыз, Декобокко табынушылары.
Dialogue: 0,0:04:41.57,0:04:43.86,Default,,0,0,0,,Декобокко құдайынан кек алатын пұтқа табынушылар...
Dialogue: 0,0:04:43.99,0:04:47.78,Default,,0,0,0,,Біз, Мансенгумилер, сізді түрмеге жібереміз.
Dialogue: 0,0:04:47.91,0:04:49.53,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:49.66,0:04:51.49,Default,,0,0,0,,Жоқ, балалар!
Dialogue: 0,0:04:51.79,0:04:55.12,Default,,0,0,0,,Кешіріңіз, бірақ біз осы қаланы қорғау үшін келдік...
Dialogue: 0,0:04:55.25,0:04:57.08,Default,,0,0,0,,Сендерден пұтқа табынушылар.
Dialogue: 0,0:04:57.42,0:05:01.50,Default,,0,0,0,,Ел қазірдің өзінде Декобокко дінін мемлекеттік дін ету жолында.
Dialogue: 0,0:05:01.63,0:05:03.09,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:05:03.38,0:05:06.34,Default,,0,0,0,,Мемлекеттік діннен кек аламыз, кәпірлер...
Dialogue: 0,0:05:06.47,0:05:09.30,Default,,0,0,0,,Оларды осында бізді полицияға жіберді.
Dialogue: 0,0:05:09.51,0:05:12.77,Default,,0,0,0,,Осындай тамаша ілімдерді қалай түсінбейсің?
Dialogue: 0,0:05:12.89,0:05:14.60,Default,,0,0,0,,Қайғылы адамдар.
Dialogue: 0,0:05:15.27,0:05:16.44,Default,,0,0,0,,Оқиға болғанша...
Dialogue: 0,0:05:16.56,0:05:19.73,Default,,0,0,0,,Біз, мансенгумилер, кәпірлерді басамыз.
Dialogue: 0,0:05:19.86,0:05:21.94,Default,,0,0,0,,Мұны маған қалдыра аласыз ба?
Dialogue: 0,0:05:22.78,0:05:24.19,Default,,0,0,0,,Шит… шит…
Dialogue: 0,0:05:24.32,0:05:25.74,Default,,0,0,0,,Жолдастар...
Dialogue: 0,0:05:26.53,0:05:28.07,Default,,0,0,0,,Рух-
Dialogue: 0,0:05:28.20,0:05:31.74,Default,,0,0,0,,Декобокко Құдайдың да көктен қарап тұрғанына сенімдімін...
Dialogue: 0,0:05:33.75,0:05:38.29,Default,,0,0,0,,Осы планетаның ретсіз табиғатын бірге түзетейік.
Dialogue: 0,0:05:46.84,0:05:47.88,Default,,0,0,0,,Я...
Dialogue: 0,0:06:00.10,0:06:02.15,Default,,0,0,0,,Бұзылу аяқталды
Dialogue: 0,0:06:02.52,0:06:05.32,Default,,0,0,0,,Қазір бұл жердегі бақылау камералары қауіпсіз.
Dialogue: 0,0:06:05.44,0:06:06.65,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:06.99,0:06:09.95,Default,,0,0,0,,Ой, мына жігіт ше? (Кондо) Көріп отырғаныңыздай.
Dialogue: 0,0:06:10.16,0:06:13.95,Default,,0,0,0,,Бұл қаладағы барлық бейнебақылау камераларын олар басып алған.
Dialogue: 0,0:06:14.16,0:06:16.29,Default,,0,0,0,,Бұрынғыдай оғаш әрекет жасасаңыз...
Dialogue: 0,0:06:16.41,0:06:18.46,Default,,0,0,0,,Сондықтан олар бірден жүгіріп келеді.
Dialogue: 0,0:06:19.12,0:06:21.25,Default,,0,0,0,,Мен сол жерде үлкен төбелесіп жатқанда...
Dialogue: 0,0:06:21.38,0:06:25.42,Default,,0,0,0,,Осы уақытқа дейін бүкіл жер Кабуки қаласынан кейінгі екінші орынға айналар еді...
Dialogue: 0,0:06:25.55,0:06:27.05,Default,,0,0,0,,Қысқаша бұл не?
Dialogue: 0,0:06:27.17,0:06:29.13,Default,,0,0,0,,Егер сіз тағы да ақымақтық жасасаңыз...
Dialogue: 0,0:06:29.26,0:06:31.47,Default,,0,0,0,,Жарайды, мен мұны да қамти алмаймын.
Dialogue: 0,0:06:32.01,0:06:34.56,Default,,0,0,0,,Жоқ, айтамын, солай болды...
Dialogue: 0,0:06:34.68,0:06:36.27,Default,,0,0,0,,Сен ақымақтар сөйлеп жатырсыңдар...
Dialogue: 0,0:06:36.39,0:06:37.43,Default,,0,0,0,,Бұл жабайы ақымақ емес.
Dialogue: 0,0:06:37.56,0:06:38.98,Default,,0,0,0,,Бостандық ұшып кетеді...
Dialogue: 0,0:06:39.10,0:06:40.48,Default,,0,0,0,,Бұл жабайы боқ, солай емес пе?
Dialogue: 0,0:06:40.85,0:06:42.44,Default,,0,0,0,,Мүмкін сендер...
Dialogue: 0,0:06:42.56,0:06:44.77,Default,,0,0,0,,Сіз бұл табынушылықты біраз уақыттан бері ұстандыңыз ба?
Dialogue: 0,0:06:45.44,0:06:47.57,Default,,0,0,0,,Кең аумақта іздеуде жүрген діни топ...
Dialogue: 0,0:06:47.69,0:06:51.53,Default,,0,0,0,,Біз олардың осы планетамен байланыс орнатуды жоспарлап жатқаны туралы ақпарат алдық.
Dialogue: 0,0:06:51.66,0:06:55.62,Default,,0,0,0,,Бұл қаланы қорғаным деп білгенше жақсы болды...
Dialogue: 0,0:06:55.83,0:07:00.12,Default,,0,0,0,,«Құдай» сөзін бұлай тез қолданады деп ойламаппын.
Dialogue: 0,0:07:00.25,0:07:02.50,Default,,0,0,0,,Сіздің арқаңызда біз де осындаймыз.
Dialogue: 0,0:07:02.63,0:07:03.63,Default,,0,0,0,,Құдай?
Dialogue: 0,0:07:03.88,0:07:08.13,Default,,0,0,0,,Осы жерден әлдеқайда жоғары ғарышта қалқып жүрген жасанды серік...
Dialogue: 0,0:07:08.67,0:07:12.14,Default,,0,0,0,,Міне, олар табынатын «Құдайдың» шынайы тұлғасы.
Dialogue: 0,0:07:12.76,0:07:16.10,Default,,0,0,0,,Олар өздерінің доктринасына байланысты Декобокко дінін ұстанады...
Dialogue: 0,0:07:16.22,0:07:19.64,Default,,0,0,0,,Адам ағзасының гормоналды тепе-теңдігін басқара алатын сиқырлы дәрі...
Dialogue: 0,0:07:20.10,0:07:22.90,Default,,0,0,0,,Басқаша айтқанда, ер адамдар ерке.
Dialogue: 0,0:07:23.02,0:07:26.86,Default,,0,0,0,,Әйел өзін әйелдік ететін дәріні зерттей бастады.
Dialogue: 0,0:07:26.98,0:07:30.24,Default,,0,0,0,,Алайда бұл процесте күтпеген жағдай орын алды.
Dialogue: 0,0:07:30.45,0:07:33.70,Default,,0,0,0,,Міне, біз қазір жұқтырған вирус...
Dialogue: 0,0:07:33.99,0:07:35.37,Default,,0,0,0,,Бұл шошқаға айналатын вирус болса...
Dialogue: 0,0:07:35.49,0:07:36.91,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:07:37.49,0:07:39.16,Default,,0,0,0,,Олар террористік әрекеттерге ұқсас.
Dialogue: 0,0:07:39.29,0:07:43.04,Default,,0,0,0,,Дәл сол кезде ол радикалды миссионерлік қызметпен айналыса бастады...
Dialogue: 0,0:07:43.50,0:07:47.55,Default,,0,0,0,,Иә, ол нұр Құдайдың үкімі емес...
Dialogue: 0,0:07:47.67,0:07:50.59,Default,,0,0,0,,Шабуыл спутнигінен ұшырылды -
Dialogue: 0,0:07:50.72,0:07:52.93,Default,,0,0,0,,Гормондарға кері әсер ететін вирустар
Dialogue: 0,0:07:53.72,0:07:56.05,Default,,0,0,0,,Мұның бәрі лас адамдар...
Dialogue: 0,0:07:56.18,0:07:58.06,Default,,0,0,0,,Мен не істедім?
Dialogue: 0,0:07:58.18,0:08:00.89,Default,,0,0,0,,Бірақ неге лас шошқа болу қиынға соғады ...
Dialogue: 0,0:08:01.02,0:08:02.94,Default,,0,0,0,,Лас шошқа кім!
Dialogue: 0,0:08:03.69,0:08:06.73,Default,,0,0,0,,Сегунат та бұл қаланы оқшаулауға тырысуда...
Dialogue: 0,0:08:06.86,0:08:09.90,Default,,0,0,0,,Вирустың өзі ауада ұзақ өмір сүрмейді.
Dialogue: 0,0:08:10.03,0:08:12.95,Default,,0,0,0,,Оның үстіне адамға адамнан адамға жұқтыру мүмкіндігі жоқтың қасы.
Dialogue: 0,0:08:13.15,0:08:15.57,Default,,0,0,0,,Бұл Тэ Чанның жұқтырғанын білдіреді...
Dialogue: 0,0:08:15.70,0:08:18.58,Default,,0,0,0,,Ол Тэ Шимура Х болады ма...
Dialogue: 0,0:08:18.99,0:08:20.08,Default,,0,0,0,,Жақсы
Dialogue: 0,0:08:20.20,0:08:23.46,Default,,0,0,0,,Джубей мырза, уайымдағаныңызға рахмет.
Dialogue: 0,0:08:24.79,0:08:27.21,Default,,0,0,0,,Спутникті қалай тоқтатуға болады деген сұрақ туындайды.
Dialogue: 0,0:08:27.34,0:08:30.17,Default,,0,0,0,,Сіздің денеңізді қалпына келтіретін вакцинаны алыңыз.
Dialogue: 0,0:08:30.80,0:08:34.22,Default,,0,0,0,,Бірақ спутник туралы ештеңе істеу мүмкін емес шығар.
Dialogue: 0,0:08:34.34,0:08:35.55,Default,,0,0,0,,Егер әдеттен тыс нәрсе болса...
Dialogue: 0,0:08:36.05,0:08:40.22,Default,,0,0,0,,Бұл автоматты түрде вирустарды Жерге шығаратын жүйе сияқты.
Dialogue: 0,0:08:42.39,0:08:44.69,Default,,0,0,0,,Мен көмектесе алмаймын
Dialogue: 0,0:08:45.27,0:08:50.61,Default,,0,0,0,,Басқаша айтқанда, бұл жағдайды тоқтатудың жалғыз жолы - оларға тікелей шабуыл жасау ...
Dialogue: 0,0:08:50.73,0:08:54.82,Default,,0,0,0,,Мұны бізде осындай денелері барлар ғана жасай алады.
Dialogue: 0,0:08:54.95,0:08:55.95,Default,,0,0,0,,О
Dialogue: 0,0:08:56.07,0:08:59.87,Default,,0,0,0,,Оларды бақылаудан қашып, олардың бекінісін табыңыз.
Dialogue: 0,0:08:59.99,0:09:03.83,Default,,0,0,0,,Олардың барлығын жою қосқышы басылмай тұрып өлтіріңіз...
Dialogue: 0,0:09:03.96,0:09:06.42,Default,,0,0,0,,Осылай бір қулық жасап алсам ғой.
Dialogue: 0,0:09:06.54,0:09:07.96,Default,,0,0,0,,Бұл мүмкін бе...
Dialogue: 0,0:09:08.08,0:09:09.54,Default,,0,0,0,,Сенің қолыңнан келеді... (Шинпачи) Иә!
Dialogue: 0,0:09:09.67,0:09:11.80,Default,,0,0,0,,Вей күшті қарсылас болса да...
Dialogue: 0,0:09:11.92,0:09:15.51,Default,,0,0,0,,Егер У мен Шу күш біріктірсе, біз оларды міндетті түрде жеңе аламыз.
Dialogue: 0,0:09:15.63,0:09:16.80,Default,,0,0,0,,Қызыл жартас!
Dialogue: 0,0:09:16.93,0:09:19.26,Default,,0,0,0,,Као Цаоны бірге жеңейік!
Dialogue: 0,0:09:19.39,0:09:21.22,Default,,0,0,0,,Жоқ, бұл адам немен күресіп жатыр?
Dialogue: 0,0:09:21.35,0:09:23.56,Default,,0,0,0,,Сіз Цао Цаоның лагерінен емес едіңіз!
Dialogue: 0,0:09:24.27,0:09:27.06,Default,,0,0,0,,Бастапқы денемді қайтару үшін менде амал жоқ.
Dialogue: 0,0:09:27.19,0:09:29.36,Default,,0,0,0,,Енді мен шошқаның қолын қарызға аламын.
Dialogue: 0,0:09:29.48,0:09:30.82,Default,,0,0,0,,Шошқаның табаны дегеніміз не?
Dialogue: 0,0:09:30.94,0:09:34.19,Default,,0,0,0,,Менің таңдауым жоқ. Егер сіз оны пайдалана алмасаңыз, оны артта қалдыра аласыз.
Dialogue: 0,0:09:34.32,0:09:36.36,Default,,0,0,0,,Шошқаның аяғы Аяғыңызды сүйретпеңіз!
Dialogue: 0,0:09:36.49,0:09:40.41,Default,,0,0,0,,Шошқаларға араласпай бір-бірлеріңмен сөйлесуге болмай ма? Садист дуэт!
Dialogue: 0,0:09:40.53,0:09:43.54,Default,,0,0,0,,Жарайды, бұдан былай біз одақтаспыз.
Dialogue: 0,0:09:43.66,0:09:44.95,Default,,0,0,0,,Альянсты тойлау...
Dialogue: 0,0:09:45.62,0:09:47.58,Default,,0,0,0,,Қуырылған шошқаны дайындаңыз!
Dialogue: 0,0:09:47.71,0:09:48.92,Default,,0,0,0,,Шошқа фермасының анты
Dialogue: 0,0:09:49.04,0:09:50.96,Default,,0,0,0,,Бұл тағы да?
Dialogue: 0,0:10:01.89,0:10:04.14,Default,,0,0,0,,Біріншіден, ол барлық жерде шегеленді.
Dialogue: 0,0:10:04.27,0:10:06.68,Default,,0,0,0,,Біз бақылауға қатысты бірдеңе істеуіміз керек.
Dialogue: 0,0:10:06.81,0:10:09.06,Default,,0,0,0,,Мен бұлай қозғала алмаймын...
Dialogue: 0,0:10:09.19,0:10:12.32,Default,,0,0,0,,Мен бұл жігітті әрбір бақылау камерасына орнатамын.
Dialogue: 0,0:10:12.98,0:10:15.15,Default,,0,0,0,,Камераны бұзып, содан кейін автоматты түрде-
Dialogue: 0,0:10:15.28,0:10:18.86,Default,,0,0,0,,Жазылған өткен кадрлар циклде ойнатыла береді.
Dialogue: 0,0:10:18.99,0:10:22.87,Default,,0,0,0,,Тыңдаңыз, егер олар түсінсе, бәрі әзіл.
Dialogue: 0,0:10:22.99,0:10:24.16,Default,,0,0,0,,Мүмкіндігінше табиғи түрде -
Dialogue: 0,0:10:24.29,0:10:26.83,Default,,0,0,0,,Декобокко дінінің ілімдерін бұзбай мүмкіндігінше көп нәрсені жасаңыз.
Dialogue: 0,0:10:27.12,0:10:28.33,Default,,0,0,0,,әйелдік
Dialogue: 0,0:10:33.34,0:10:34.84,Default,,0,0,0,,Барайық
Dialogue: 0,0:10:36.92,0:10:40.22,Default,,0,0,0,,Әй, Гинко Соуко~
Dialogue: 0,0:10:40.34,0:10:42.47,Default,,0,0,0,,Мен бүгін кафеге майо тостаған жеуге барамын...
Dialogue: 0,0:10:43.30,0:10:45.39,Default,,0,0,0,,Ондай әйел жоқ...
Dialogue: 0,0:10:45.93,0:10:48.27,Default,,0,0,0,,Эй, эй, сен не істеп жатырсың, Гинько?
Dialogue: 0,0:10:48.39,0:10:50.56,Default,,0,0,0,,Цуккоми тым қарқынды емес пе? Бұл қыз, солай ма?
Dialogue: 0,0:10:50.69,0:10:51.60,Default,,0,0,0,,Гомен!
Dialogue: 0,0:10:51.73,0:10:53.90,Default,,0,0,0,,Сіз диетаға отырамын дедіңіз...
Dialogue: 0,0:10:54.02,0:10:56.07,Default,,0,0,0,,Ол майо тостаған деп аталады.
Dialogue: 0,0:10:56.19,0:10:57.74,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:10:57.86,0:10:59.99,Default,,0,0,0,,Әйелдер жыл бойы диета ұстайды.
Dialogue: 0,0:11:00.11,0:11:01.57,Default,,0,0,0,,Дұрыс, босаңсыған кезде...
Dialogue: 0,0:11:01.70,0:11:04.58,Default,,0,0,0,,Сіз бірден бірнеше калория алуға тырысып жатырсыз, сондықтан сіз қазірдің өзінде...
Dialogue: 0,0:11:04.70,0:11:06.83,Default,,0,0,0,,Енді бәріміз Уджи Гинтокидон жейік...
Dialogue: 0,0:11:07.62,0:11:09.08,Default,,0,0,0,,Ондай әйел жоқ.
Dialogue: 0,0:11:09.79,0:11:11.42,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:11:11.54,0:11:13.71,Default,,0,0,0,,Қыздардың тәттіні жақсы көруі дұрыс емес пе?
Dialogue: 0,0:11:13.83,0:11:14.63,Default,,0,0,0,,Хмф!
Dialogue: 0,0:11:14.75,0:11:17.13,Default,,0,0,0,,Бұл тәтті емес, бұл тәтті құбыжық!
Dialogue: 0,0:11:17.25,0:11:18.63,Default,,0,0,0,,Бұл құбыжық калория.
Dialogue: 0,0:11:18.76,0:11:20.63,Default,,0,0,0,,Сіз калориялардың құбыжығысыз, солай ма?
Dialogue: 0,0:11:21.01,0:11:22.80,Default,,0,0,0,,Өйткені мен де сондай жақсы доспын...
Dialogue: 0,0:11:22.93,0:11:24.55,Default,,0,0,0,,Сізге диета қажет емес!
Dialogue: 0,0:11:24.68,0:11:26.72,Default,,0,0,0,,үшін? Сіз жақсы доссыз ба?
Dialogue: 0,0:11:26.85,0:11:28.64,Default,,0,0,0,,Мені күлдірме
Dialogue: 0,0:11:28.77,0:11:29.73,Default,,0,0,0,,Жақсы дос - бұл...
Dialogue: 0,0:11:29.85,0:11:32.52,Default,,0,0,0,,Толқын, сұлу денені айтып отырмын, Гинко.
Dialogue: 0,0:11:32.65,0:11:35.02,Default,,0,0,0,,Сіздің гротесктік денеңіз бар, солай ма?
Dialogue: 0,0:11:35.36,0:11:37.98,Default,,0,0,0,,Артық салмақтан арылдым деп алданып қалмаңыз.
Dialogue: 0,0:11:38.11,0:11:40.95,Default,,0,0,0,,Мен сізге айтамын, егер мен арықтасам, мен міндетті түрде сізден әдемірек боламын.
Dialogue: 0,0:11:41.07,0:11:41.99,Default,,0,0,0,,Сіз не айттыңыз?
Dialogue: 0,0:11:42.11,0:11:44.91,Default,,0,0,0,,100% My Ginko сүйкімді және кеуделері үлкенірек.
Dialogue: 0,0:11:45.03,0:11:46.87,Default,,0,0,0,,Ол сіз үшін өте жағымсыз нәрселер жасайды.
Dialogue: 0,0:11:46.99,0:11:49.04,Default,,0,0,0,,Ер болсам, сен сияқты ақымақ болар едім.
Dialogue: 0,0:11:49.16,0:11:52.29,Default,,0,0,0,,Мен бармаймын. 100% мен Ⅹшиге барамын.
Dialogue: 0,0:11:52.42,0:11:54.29,Default,,0,0,0,,Сіз жоғары деңгейлісіз, Конояро.
Dialogue: 0,0:11:54.42,0:11:56.63,Default,,0,0,0,,Олай болса, ерлерге қайсысы көбірек ұнайтынын білу үшін сайыс ұйымдастырайық!
Dialogue: 0,0:11:56.75,0:11:58.30,Default,,0,0,0,,Қалауыңызша!
Dialogue: 0,0:11:58.42,0:12:00.80,Default,,0,0,0,,Мен оны кері Нан ойынымен шешемін!
Dialogue: 0,0:12:00.92,0:12:03.76,Default,,0,0,0,,Ой! Сен не істеп жатырсың? Теме!
Dialogue: 0,0:12:03.88,0:12:05.47,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:12:05.59,0:12:07.35,Default,,0,0,0,,Мақсат өзгерген жоқ па?
Dialogue: 0,0:12:07.47,0:12:09.68,Default,,0,0,0,,Соуко-сан, бірдеңе айт!
Dialogue: 0,0:12:10.14,0:12:12.18,Default,,0,0,0,,Бұл екеуі өте әйелдік...
Dialogue: 0,0:12:12.31,0:12:13.64,Default,,0,0,0,,Мен ештеңе түсінбеймін
Dialogue: 0,0:12:13.77,0:12:15.31,Default,,0,0,0,,Қазіргі әйелдер...
Dialogue: 0,0:12:15.44,0:12:16.44,Default,,0,0,0,,Ах
Dialogue: 0,0:12:16.56,0:12:19.53,Default,,0,0,0,,Ағай~ Жоғары сыныптың қыздарымен ойнағың келе ме?
Dialogue: 0,0:12:19.65,0:12:20.53,Default,,0,0,0,,Әйелдікке дейін -
Dialogue: 0,0:12:20.65,0:12:23.15,Default,,0,0,0,,Ол қаншыққа айналған болуы керек!
Dialogue: 0,0:12:23.36,0:12:27.20,Default,,0,0,0,,Әй, ақшаң көп емес пе, аға?
Dialogue: 0,0:12:28.24,0:12:29.20,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:12:30.08,0:12:31.33,Default,,0,0,0,,Мен де ДжКмын.
Dialogue: 0,0:12:31.45,0:12:32.83,Default,,0,0,0,,Қандай ЖК?
Dialogue: 0,0:12:32.96,0:12:34.25,Default,,0,0,0,,Джирихин Каненаши
Dialogue: 0,0:12:34.37,0:12:36.21,Default,,0,0,0,,Жақсы емес!
Dialogue: 0,0:12:37.84,0:12:40.71,Default,,0,0,0,,Гинко-сан, дұрыс істеп жатырсың ба?
Dialogue: 0,0:12:40.92,0:12:44.38,Default,,0,0,0,,Шинсенгуми де бар, сондықтан менің ойымша, бұл жақсы.
Dialogue: 0,0:12:44.51,0:12:47.22,Default,,0,0,0,,Мен сол Шинсенгуми үшін уайымдап отырмын...
Dialogue: 0,0:12:47.72,0:12:51.85,Default,,0,0,0,,Бірақ сіз доктринаны ұстанатын болып көріну үшін әйелдікке ұмтыласыз...
Dialogue: 0,0:12:51.97,0:12:54.23,Default,,0,0,0,,Бұл жосықсыз, бірақ бұл нұсқаулық болуы мүмкін.
Dialogue: 0,0:12:54.56,0:12:58.15,Default,,0,0,0,,Өйткені мен бұл туралы әдетте қайта ойламаймын.
Dialogue: 0,0:12:58.48,0:13:01.48,Default,,0,0,0,,Тэ Чан, оны сол күйінде қалдыруға болады.
Dialogue: 0,0:13:02.49,0:13:06.28,Default,,0,0,0,,Сен өзің сияқты қызсың...
Dialogue: 0,0:13:06.41,0:13:08.07,Default,,0,0,0,,Өзгертудің қажеті жоқ...
Dialogue: 0,0:13:08.20,0:13:09.53,Default,,0,0,0,,Мен сенің өзгергеніңді қаламаймын
Dialogue: 0,0:13:09.66,0:13:12.12,Default,,0,0,0,,Ah... thank you...
Dialogue: 0,0:13:12.50,0:13:14.62,Default,,0,0,0,,Ах (біртүрлі) Маған енді ұнамайды...
Dialogue: 0,0:13:14.75,0:13:16.50,Default,,0,0,0,,Бірдеңе дұрыс емес.
Dialogue: 0,0:13:17.21,0:13:19.21,Default,,0,0,0,,Мен оның Ку Чан екенін білемін, бірақ-
Dialogue: 0,0:13:19.34,0:13:22.46,Default,,0,0,0,,Мен басқа еркекпен сөйлесіп тұрғандай сезінемін...
Dialogue: 0,0:13:22.59,0:13:23.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:25.22,0:13:26.80,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:13:26.93,0:13:29.01,Default,,0,0,0,,Ах! Мына жерде бейнебақылау камерасы бар...
Dialogue: 0,0:13:29.14,0:13:30.85,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:13:31.39,0:13:34.31,Default,,0,0,0,,Тэ Чан, ештеңе істеудің қажеті жоқ...
Dialogue: 0,0:13:34.43,0:13:35.18,Default,,0,0,0,,Ах
Dialogue: 0,0:13:37.39,0:13:39.27,Default,,0,0,0,,Тэ Чан, күте тұр! (Отаку) Ах!
Dialogue: 0,0:13:49.53,0:13:51.45,Default,,0,0,0,,Бардың ба... А?
Dialogue: 0,0:13:51.58,0:13:52.45,Default,,0,0,0,,Ах аа...
Dialogue: 0,0:13:52.58,0:13:54.45,Default,,0,0,0,,Тэ Чан!
Dialogue: 0,0:13:54.58,0:13:57.08,Default,,0,0,0,,Уау, кешіріңіз (Отае)... Жоқ...
Dialogue: 0,0:13:57.21,0:14:01.21,Default,,0,0,0,,Уау... Бұл мен... Гогогогого кешіріңіз.
Dialogue: 0,0:14:01.34,0:14:04.26,Default,,0,0,0,,Мен... Мен шошып кеттім де, тарс еткіздім.
Dialogue: 0,0:14:04.55,0:14:07.72,Default,,0,0,0,,А-а... ана жақта да бақылау камерасы бар...
Dialogue: 0,0:14:07.84,0:14:09.39,Default,,0,0,0,,Тэ Чан!
Dialogue: 0,0:14:11.60,0:14:14.64,Default,,0,0,0,,Эй... осылай қалдыр.
Dialogue: 0,0:14:17.56,0:14:20.81,Default,,0,0,0,,Мынау... жақсырақ... мынау... мынау...
Dialogue: 0,0:14:21.86,0:14:25.86,Default,,0,0,0,,Ғашық болып көрінген жақсы, а-а-а... өйткені күдіктенбейсің.
Dialogue: 0,0:14:28.11,0:14:30.57,Default,,0,0,0,,Мен не айтып тұрмын?
Dialogue: 0,0:14:30.70,0:14:32.83,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:14:34.16,0:14:38.54,Default,,0,0,0,,Бұл жағдай мен триггерді басқандықтан болды.
Dialogue: 0,0:14:38.66,0:14:43.63,Default,,0,0,0,,Мен бұл жағдайды бақылауға алу жауапкершілігі мен міндетім болса да...
Dialogue: 0,0:14:44.09,0:14:46.34,Default,,0,0,0,,Неліктен бұл жағдай...
Dialogue: 0,0:14:46.46,0:14:49.84,Default,,0,0,0,,Мен ер адам болғаннан аз ғана қуаныш сезінемін.
Dialogue: 0,0:14:50.38,0:14:53.10,Default,,0,0,0,,Мен білемін... жағдай олай емес...
Dialogue: 0,0:14:53.22,0:14:56.22,Default,,0,0,0,,Бірақ мен оны енді көрмеймін деп айта алмаймын.
Dialogue: 0,0:14:58.64,0:15:00.35,Default,,0,0,0,,Фуфуфуфу…
Dialogue: 0,0:15:01.73,0:15:03.36,Default,,0,0,0,,Кешірім сұрау керек адам мен болар едім. Сіз жақсысыз ба?
Dialogue: 0,0:15:03.48,0:15:06.07,Default,,0,0,0,,(Отаэ мен Джубейдің күлкісі)
Dialogue: 0,0:15:06.19,0:15:06.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:06.98,0:15:11.32,Default,,0,0,0,,Өйткені... егер сен еркек болсаң, Тэ Чанмен ашық кездесуге болады.
Dialogue: 0,0:15:15.16,0:15:17.87,Default,,0,0,0,,Ғашықтар... (Кондо) Бұл да жақсы шығар.
Dialogue: 0,0:15:18.00,0:15:19.50,Default,,0,0,0,,Ах... (Шинпачи) Бірақ-
Dialogue: 0,0:15:19.62,0:15:21.58,Default,,0,0,0,,Ағайын, ғашық болып көріну...
Dialogue: 0,0:15:21.71,0:15:24.46,Default,,0,0,0,,Біртүрлі өсектер бар ма?
Dialogue: 0,0:15:24.59,0:15:26.34,Default,,0,0,0,,Сәлем Кондо-сан
Dialogue: 0,0:15:26.46,0:15:27.63,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:15:27.76,0:15:32.05,Default,,0,0,0,,Бірақ мұндай сымбатты жігітпен бұл өсек болып кетсе, бұл жаман емес болуы мүмкін.
Dialogue: 0,0:15:32.18,0:15:34.39,Default,,0,0,0,,Мейірімді бол, қымбаттым.
Dialogue: 0,0:15:38.47,0:15:41.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:54.16,0:15:56.41,Default,,0,0,0,,Уф... Ах!
Dialogue: 0,0:15:56.91,0:15:59.41,Default,,0,0,0,,Әй, аға, менімен шай ішпейсіз бе...
Dialogue: 0,0:15:59.54,0:16:02.79,Default,,0,0,0,,Мен аға емеспін, мен ескі қаңбақпын.
Dialogue: 0,0:16:03.58,0:16:05.83,Default,,0,0,0,,Аһ... Ах!
Dialogue: 0,0:16:05.96,0:16:08.13,Default,,0,0,0,,Мына жақтағы жігіт менімен шай ішпейді...
Dialogue: 0,0:16:08.25,0:16:10.34,Default,,0,0,0,,Урса Деб
Dialogue: 0,0:16:11.88,0:16:13.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:13.97,0:16:18.31,Default,,0,0,0,,Ойланып қарасам, бұл қаладағы еркектің әйел екенін ұмытып кетіппін.
Dialogue: 0,0:16:18.43,0:16:21.27,Default,,0,0,0,,Енді ойлап қарасам, семіз екенімді ұмытып кетіппін.
Dialogue: 0,0:16:21.39,0:16:23.06,Default,,0,0,0,,Не болды?
Dialogue: 0,0:16:23.19,0:16:25.23,Default,,0,0,0,,Мен сізге Гинконы көбірек танымал екенін міндетті түрде көрсетемін.
Dialogue: 0,0:16:25.35,0:16:28.36,Default,,0,0,0,,Қозаке, сен сияқты ақымақтарды лақтырып жібереді...
Dialogue: 0,0:16:28.48,0:16:31.11,Default,,0,0,0,,Сайып келгенде, барлық адамдар мейірімділікке ұмтылады
Dialogue: 0,0:16:31.24,0:16:32.57,Default,,0,0,0,,Мен қайтып келемін!
Dialogue: 0,0:16:33.99,0:16:36.41,Default,,0,0,0,,Бауырым, менімен шай іш.
Dialogue: 0,0:16:36.62,0:16:39.24,Default,,0,0,0,,Тотаку... Тотохото, осы қаланың адамдарына...
Dialogue: 0,0:16:39.37,0:16:40.87,Default,,0,0,0,,Мен ғашық емеспін
Dialogue: 0,0:16:41.00,0:16:44.92,Default,,0,0,0,,Осы төтенше жағдайда ешқандай шара қолданбай қыздарды алып кету.
Dialogue: 0,0:16:47.17,0:16:49.25,Default,,0,0,0,,Бақылау камерасы? (Хиджиката/Гинко) Ух...
Dialogue: 0,0:16:49.38,0:16:51.84,Default,,0,0,0,,Мұны мен ер жеткенде ғана түсіндім.
Dialogue: 0,0:16:51.96,0:16:55.80,Default,,0,0,0,,Ер адамдар бұл дүниеде қандай аянышты, пайдасыз.
Dialogue: 0,0:16:57.55,0:17:00.18,Default,,0,0,0,,Кетіңдер, шошқалар.
Dialogue: 0,0:17:02.60,0:17:04.35,Default,,0,0,0,,Қалай болды, Гинко-сан?
Dialogue: 0,0:17:04.64,0:17:07.56,Default,,0,0,0,,Біз сондай-ақ 20-ға жуық камераны өңдедік...
Dialogue: 0,0:17:07.69,0:17:10.11,Default,,0,0,0,,Камералар мен күткеннен де көп болды...
Dialogue: 0,0:17:10.23,0:17:13.32,Default,,0,0,0,,Бүкіл Кабуки қаласына келетін болсақ, олардың саны өлшеусіз.
Dialogue: 0,0:17:13.74,0:17:16.41,Default,,0,0,0,,Шынымды айтсам, сіз баға бере аласыз ба...
Dialogue: 0,0:17:16.74,0:17:21.12,Default,,0,0,0,,Бақылауды бейтараптандырмасақ, біз табынушылықтың штаб-пәтерін іздеуді бастай алмаймыз.
Dialogue: 0,0:17:21.24,0:17:24.08,Default,,0,0,0,,Дәл қазір менде оны тұрақты қабылдаудан басқа амалым жоқ, қымбаттым.
Dialogue: 0,0:17:24.20,0:17:25.62,Default,,0,0,0,,Кім қымбаттым!
Dialogue: 0,0:17:25.75,0:17:29.21,Default,,0,0,0,,Екеуі бір адамды қуып келе жатқан аңдыған жұп емес пе?
Dialogue: 0,0:17:29.33,0:17:31.55,Default,,0,0,0,,Менің ойымша, біз жақсы тіл табыса аламыз.
Dialogue: 0,0:17:31.67,0:17:32.55,Default,,0,0,0,,Сіз мұны істей аласыз ба!
Dialogue: 0,0:17:32.67,0:17:35.22,Default,,0,0,0,,Тағы да түртіңіз, келесі жолы кесіп аламын!
Dialogue: 0,0:17:35.34,0:17:36.84,Default,,0,0,0,,Жетеді (Джубей/Кондо) Иә?
Dialogue: 0,0:17:37.34,0:17:39.26,Default,,0,0,0,,Бұл мәселе бітті.
Dialogue: 0,0:17:39.47,0:17:42.22,Default,,0,0,0,,Бұл не деп тұрсыз?
Dialogue: 0,0:17:42.35,0:17:43.52,Default,,0,0,0,,Ах
Dialogue: 0,0:17:44.60,0:17:46.19,Default,,0,0,0,,Мен айтқанымдай.
Dialogue: 0,0:17:46.31,0:17:50.27,Default,,0,0,0,,Бұл қалада енді бірде-бір бақылау камерасы қалмады.
Dialogue: 0,0:17:51.02,0:17:54.36,Default,,0,0,0,,Бəріңіз əйел болып, шу шығарып жатқанда...
Dialogue: 0,0:17:54.49,0:17:56.78,Default,,0,0,0,,Мен бәрін тастадым.
Dialogue: 0,0:17:57.11,0:17:58.78,Default,,0,0,0,,Біз балалар!
Dialogue: 0,0:17:59.36,0:18:00.78,Default,,0,0,0,,Немесе... бақылау камерасы!
Dialogue: 0,0:18:00.91,0:18:03.04,Default,,0,0,0,,Күте тұрыңыз...
Dialogue: 0,0:18:04.37,0:18:05.25,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:05.66,0:18:08.46,Default,,0,0,0,,Мені жейтін көзілдірікті кейіпкер кім!
Dialogue: 0,0:18:08.96,0:18:11.29,Default,,0,0,0,,Егер мен осындай бірдеңе жасасам, олар байқайды...
Dialogue: 0,0:18:11.42,0:18:12.92,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:18:13.05,0:18:13.88,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:14.00,0:18:16.88,Default,,0,0,0,,Егер сізді білгіңіз келмесе, оларға қарап қалмаңыз.
Dialogue: 0,0:18:17.01,0:18:18.72,Default,,0,0,0,,Құлақ, ауыз, қол, аяқ...
Dialogue: 0,0:18:18.84,0:18:21.39,Default,,0,0,0,,Олардың барлығын бір уақытта ұсақтаңыз.
Dialogue: 0,0:18:22.01,0:18:23.85,Default,,0,0,0,,Шұңқырға тығылған адамдар...
Dialogue: 0,0:18:23.97,0:18:27.89,Default,,0,0,0,,Сырттан ақпаратты алуға мүмкіндік жоқ.
Dialogue: 0,0:18:30.56,0:18:32.40,Default,,0,0,0,,Сосын тынысы тарылған басым...
Dialogue: 0,0:18:32.73,0:18:34.90,Default,,0,0,0,,Тек оның тесіктен көрінуін күтіңіз!
Dialogue: 0,0:18:37.53,0:18:42.53,Default,,0,0,0,,Менің ақымақ еркектермен ісім жоқ, артымнан нағыз еркектер ғана жүреді.
Dialogue: 0,0:18:50.37,0:18:53.96,Default,,0,0,0,,Не! ? Барлық бейнебақылау камералары жойылды ма?
Dialogue: 0,0:18:54.09,0:18:56.26,Default,,0,0,0,,Әй, мұның бәрі соқыр жерден соққы болды...
Dialogue: 0,0:18:56.96,0:18:59.68,Default,,0,0,0,,Қылмыстардың ешқайсысы ешбір камераға түспеген.
Dialogue: 0,0:18:59.80,0:19:04.01,Default,,0,0,0,,Сонымен бірге сыртта патрульдік қызмет атқарғандармен барлық байланыс үзілді.
Dialogue: 0,0:19:04.14,0:19:06.93,Default,,0,0,0,,Жарайды... Мен оның мұндай қулық жасай алады деп ойламаппын...
Dialogue: 0,0:19:07.06,0:19:09.39,Default,,0,0,0,,Қалай болғанда да, мен оны осылай тастап кете алмаймын.
Dialogue: 0,0:19:09.52,0:19:10.27,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:19:10.39,0:19:13.31,Default,,0,0,0,,Архиепископтың бұйрығы - қандай жағдай болмасын өз лауазымыңды ешқашан тастама.
Dialogue: 0,0:19:13.44,0:19:15.90,Default,,0,0,0,,Бұл төтенше жағдай! Егер сіз осындай нәрсені айтып жатсаңыз ...
Dialogue: 0,0:19:16.02,0:19:17.82,Default,,0,0,0,,(Мүміндердің айқайы)
Dialogue: 0,0:19:17.94,0:19:18.69,Default,,0,0,0,,Не!
Dialogue: 0,0:19:21.99,0:19:23.24,Default,,0,0,0,,Уайымдамаңыз.
Dialogue: 0,0:19:23.99,0:19:27.24,Default,,0,0,0,,Біз де сен сияқты Декобокко сенушіміз.
Dialogue: 0,0:19:27.49,0:19:30.75,Default,,0,0,0,,Еркек еркекке, әйелге әйел ұнайды
Dialogue: 0,0:19:31.37,0:19:33.96,Default,,0,0,0,,Декобокко діні Жалғыз доктринаны қорғау үшін -
Dialogue: 0,0:19:34.08,0:19:35.92,Default,,0,0,0,,Мен қамауға алындым
Dialogue: 0,0:19:37.09,0:19:41.43,Default,,0,0,0,,Бұл біздің жұлдызды адам!
Dialogue: 0,0:19:41.55,0:19:44.01,Default,,0,0,0,,Келіңдер, балалар!
Dialogue: 0,0:19:44.60,0:19:46.31,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:19:46.43,0:19:48.56,Default,,0,0,0,,Бізді ер еткен не -
Dialogue: 0,0:19:48.68,0:19:51.85,Default,,0,0,0,,Мені өкіндіріңіз!
Dialogue: 0,0:19:51.98,0:19:56.98,Default,,0,0,0,,(Мүміндердің айқайы)
Dialogue: 0,0:19:58.28,0:20:01.86,Default,,0,0,0,,Мм... мына ұлдар қандай?
Dialogue: 0,0:20:01.99,0:20:05.49,Default,,0,0,0,,Бұл әйелдер бастапқыда ерлердің бастықтары болғанымен...
Dialogue: 0,0:20:05.78,0:20:08.20,Default,,0,0,0,,(Мүміндердің айқайы)
Dialogue: 0,0:20:08.83,0:20:11.21,Default,,0,0,0,,Бұл өте жоғары сипаттама!
Dialogue: 0,0:20:13.37,0:20:17.59,Default,,0,0,0,,Ол, әрине, біз еркек болған кездегіден де ерке!
Dialogue: 0,0:20:17.92,0:20:21.59,Default,,0,0,0,,Осы уақытқа дейін қиналып келгеннің бәрі өтірік болып шығады!
Dialogue: 0,0:20:21.88,0:20:25.09,Default,,0,0,0,,Біз көрінетін перде толығымен алынып тасталды!
Dialogue: 0,0:20:25.47,0:20:28.43,Default,,0,0,0,,Сәлем! Мен қыздардан жеңіле алмаймын
Dialogue: 0,0:20:28.56,0:20:30.06,Default,,0,0,0,,Артта қалмаңыз!
Dialogue: 0,0:20:30.18,0:20:33.56,Default,,0,0,0,,Мансенгуми қозғалыста!
Dialogue: 0,0:20:36.61,0:20:39.11,Default,,0,0,0,,А... уф...
Dialogue: 0,0:20:40.03,0:20:41.28,Default,,0,0,0,,Уф
Dialogue: 0,0:20:42.90,0:20:44.86,Default,,0,0,0,,Мен бұл жерді өлгенше қорғаймын.
Dialogue: 0,0:20:44.99,0:20:46.82,Default,,0,0,0,,Қалғанын маған қалдыр да, ары қарай жүр.
Dialogue: 0,0:20:46.95,0:20:48.78,Default,,0,0,0,,Қайда?!
Dialogue: 0,0:20:48.91,0:20:51.04,Default,,0,0,0,,Не, алдамақ болдыңыз ба?
Dialogue: 0,0:20:51.16,0:20:53.37,Default,,0,0,0,,Құдықты етпен толтырыңыз. Ол жерден кет!
Dialogue: 0,0:20:53.50,0:20:55.42,Default,,0,0,0,,Ой... Менің енді қолымнан келмейді.
Dialogue: 0,0:20:55.54,0:20:58.09,Default,,0,0,0,,Сіз өз денеңізді жақсы білесіз.
Dialogue: 0,0:20:58.21,0:21:00.21,Default,,0,0,0,,Қарамастан жүріңіз! (Гинко) Сен түсінбейсің!
Dialogue: 0,0:21:00.34,0:21:01.96,Default,,0,0,0,,Түсінбегендіктен байланған болуыңыз керек!
Dialogue: 0,0:21:02.09,0:21:04.76,Default,,0,0,0,,Теме болса, ешқайда бара алмайсың дейсің бе?
Dialogue: 0,0:21:04.88,0:21:07.80,Default,,0,0,0,,Хиджиката-сан, сабыр ет, мен саған көмектесе аламын.
Dialogue: 0,0:21:07.93,0:21:09.26,Default,,0,0,0,,Хи хи хи
Dialogue: 0,0:21:09.39,0:21:11.68,Default,,0,0,0,,бірге хи хи хи
Dialogue: 0,0:21:11.81,0:21:14.35,Default,,0,0,0,,Кім жүкті? Ақымақ!
Dialogue: 0,0:21:17.44,0:21:22.48,Default,,0,0,0,,♪~
Dialogue: 0,0:22:42.48,0:22:47.49,Default,,0,0,0,,~♪
Dialogue: 0,0:22:48.40,0:22:49.53,Default,,0,0,0,,Айтыңызшы! !
Dialogue: 0,0:22:49.65,0:22:51.82,Default,,0,0,0,,Гинко Сенсей
Dialogue: 0,0:22:52.32,0:22:56.12,Default,,0,0,0,,Иә, қазір «Маған айт!! Гинко-сенсэй» уақыты.
Dialogue: 0,0:22:56.24,0:22:58.50,Default,,0,0,0,,Бұл «Майтинг» де, «Қолдамау» да емес...
Dialogue: 0,0:22:58.62,0:23:00.83,Default,,0,0,0,,Үміт үзбе.
Dialogue: 0,0:23:00.96,0:23:04.50,Default,,0,0,0,,«Тапанша қыз» атымен сұрақ
Dialogue: 0,0:23:04.63,0:23:06.46,Default,,0,0,0,,«Қазір, Джин-сан, Кюбэй және басқалар...»
Dialogue: 0,0:23:06.59,0:23:09.76,Default,,0,0,0,,«Сен еркек немесе әйел боласың, солай ма?»
Dialogue: 0,0:23:09.88,0:23:13.68,Default,,0,0,0,,«Сонымен, Хасегава мырза әйел болса, қандай болар еді?»
Dialogue: 0,0:23:13.80,0:23:17.14,Default,,0,0,0,,«Уақытыңыз жоқ деп ойлаймын, бірақ маған хабарлаңыз.»
Dialogue: 0,0:23:17.27,0:23:20.60,Default,,0,0,0,,Иә, уақытым жоқ, бірақ айтамын.
Dialogue: 0,0:23:20.73,0:23:22.60,Default,,0,0,0,,Әйелге айналған Хасегава-сан...
Dialogue: 0,0:23:24.23,0:23:27.65,Default,,0,0,0,,«Барлығы... қош бол»
Dialogue: 0,0:23:28.86,0:23:30.70,Default,,0,0,0,,Міне, осылай сезіледі
Dialogue: 0,0:23:30.90,0:23:33.74,Default,,0,0,0,,Не, оның бетін көбірек көргің келе ме?
Dialogue: 0,0:23:33.87,0:23:36.12,Default,,0,0,0,,Оған көмектесу мүмкін емес, әсіресе.
Dialogue: 0,0:23:36.95,0:23:40.91,Default,,0,0,0,,Баршаңызға сау болыңыздар!
Dialogue: 0,0:23:41.96,0:23:43.75,Default,,0,0,0,,Мынадай
Dialogue: 0,0:23:49.59,0:23:50.67,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,0:23:52.18,0:23:53.18,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,0:23:57.64,0:23:59.47,Default,,0,0,0,,“10-1=”
