Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.04,0:00:13.20,Default,,0,0,0,,Сіз қазір болашаққа барасыз
Dialogue: 0,0:00:14.04,0:00:16.16,Default,,0,0,0,,Болашақта...? Ал балапандар ше?
Dialogue: 0,0:00:16.95,0:00:20.54,Default,,0,0,0,,Дио... күтіп тұр... Аоба...
Dialogue: 0,0:00:20.66,0:00:22.79,Default,,0,0,0,,Балапандар! Хина!
Dialogue: 0,0:00:30.04,0:00:31.79,Default,,0,0,0,,Қанаттарыңды атыңдар
Dialogue: 0,0:00:31.91,0:00:36.29,Default,,0,0,0,,Көрінбейтін аспанда үйілген үміт
Dialogue: 0,0:00:36.66,0:00:39.79,Default,,0,0,0,,Мұңның салмағына берілме
Dialogue: 0,0:00:39.91,0:00:45.00,Default,,0,0,0,,Мәңгілік UNISONIA дыбысы
Dialogue: 0,0:00:50.20,0:00:53.70,Default,,0,0,0,,Сіз көріп отырған әлем
Dialogue: 0,0:00:54.75,0:01:00.04,Default,,0,0,0,,Қызық, ол қандай түсті?
Dialogue: 0,0:01:00.12,0:01:01.66,Default,,0,0,0,,＜Сезім сәйкестігін өлшеу＞
Dialogue: 0,0:01:02.33,0:01:04.45,Default,,0,0,0,,Жоғалту қандай азап
Dialogue: 0,0:01:05.33,0:01:07.54,Default,,0,0,0,,Менің үйренгім келмейді
Dialogue: 0,0:01:07.66,0:01:12.00,Default,,0,0,0,,Жұлдыздар мұндай түнде де әдемі
Dialogue: 0,0:01:13.75,0:01:16.54,Default,,0,0,0,,Алақаннан құлау
Dialogue: 0,0:01:16.70,0:01:19.50,Default,,0,0,0,,Тот басқан тиын сияқты
Dialogue: 0,0:01:19.79,0:01:22.70,Default,,0,0,0,,<Модренаи> <Каеритай>
Dialogue: 0,0:01:22.83,0:01:25.87,Default,,0,0,0,,Екі адам бір-бірінен кейін
Dialogue: 0,0:01:26.20,0:01:28.00,Default,,0,0,0,,Пирс
Dialogue: 0,0:01:28.12,0:01:32.50,Default,,0,0,0,,Өшпейтін сезімдерді байланысқа айналдыр
Dialogue: 0,0:01:32.83,0:01:36.00,Default,,0,0,0,,Түссіз дүниені қайта салғандай
Dialogue: 0,0:01:36.12,0:01:38.66,Default,,0,0,0,,Осы жанашырлықты жеткізіңіз
Dialogue: 0,0:01:38.79,0:01:40.12,Default,,0,0,0,,Қанатты өсіру
Dialogue: 0,0:01:40.25,0:01:45.08,Default,,0,0,0,,Өзіңіз қалаған болашақты жасаңыз
Dialogue: 0,0:01:45.20,0:01:48.08,Default,,0,0,0,,Тіпті тағдырды өзгертуге болады
Dialogue: 0,0:01:48.20,0:01:53.12,Default,,0,0,0,,Уақыттан тыс UNISONIA
Dialogue: 0,0:02:04.79,0:02:11.16,Default,,0,0,0,,Жаудың Зогилия армиясының 6 жауынгері, гарнизондық және шабуылдаушы дирижабль «Мизуне» тосқауыл қоюда, бірақ көптеген шығындар бар.
Dialogue: 0,0:02:14.95,0:02:15.95,Default,,0,0,0,,Жабдықтарды C дәрежесінен төменірек кейінге қалдырыңыз!
Dialogue: 0,0:02:16.04,0:02:17.25,Default,,0,0,0,,Отын оқ-дәрілері Азық-түлік - сіздің басты басымдығыңыз!
Dialogue: 0,0:02:17.33,0:02:21.04,Default,,0,0,0,,Бұл болды... Жүк тиеу кезінде жау шабуылы болды...
Dialogue: 0,0:02:21.16,0:02:22.66,Default,,0,0,0,,Қанша уақыттан кейін бастауға болады?
Dialogue: 0,0:02:22.87,0:02:24.33,Default,,0,0,0,,Жабдықта 3 калибр қалды
Dialogue: 0,0:02:24.66,0:02:27.45,Default,,0,0,0,,Бұл кеменің «Валиансер» жасағы, сұрыпталуға дайындалыңыз.
Dialogue: 0,0:02:27.75,0:02:31.95,Default,,0,0,0,,Бұл капитан Конрад, Дионың Бладионына сұрыптауға рұқсат сұрап тұр.
Dialogue: 0,0:02:32.16,0:02:32.79,Default,,0,0,0,,Капитан?
Dialogue: 0,0:02:33.20,0:02:34.33,Default,,0,0,0,,Хмм…
Dialogue: 0,0:02:35.54,0:02:38.87,Default,,0,0,0,,Люксион тіпті сұрыптауды да сұрай алмайды...
Dialogue: 0,0:02:39.29,0:02:40.75,Default,,0,0,0,,Дио, жақсысың ба?
Dialogue: 0,0:02:40.95,0:02:41.66,Default,,0,0,0,,Иә...
Dialogue: 0,0:02:42.08,0:02:45.20,Default,,0,0,0,,Бұл Маркустың жауы. Үш машинамен шыға алсақ, бәрі жақсы...
Dialogue: 0,0:02:45.33,0:02:49.45,Default,,0,0,0,,Жаудың нысанасы Дионың ұшағы шығар, солай ма? Жоғарыдағылар рұқсат бере ме?
Dialogue: 0,0:02:49.66,0:02:52.12,Default,,0,0,0,,Капитан! Брэдионға сұрыптауға рұқсат берілді.
Dialogue: 0,0:02:52.16,0:02:52.58,Default,,0,0,0,,О!
Dialogue: 0,0:02:52.66,0:02:56.08,Default,,0,0,0,,Капитан бізден жауға түсіп қалмауымызды сұрады.
Dialogue: 0,0:02:56.20,0:02:58.91,Default,,0,0,0,,Қиындықтар көбейді, Дио Вайнберг.
Dialogue: 0,0:02:59.08,0:03:00.45,Default,,0,0,0,,Бос сөз айтпа, Жарл.
Dialogue: 0,0:03:01.16,0:03:05.54,Default,,0,0,0,,Егер сіз тіке көтерілсеңіз, бұл жақсы нысана. Өлгің келмесе, артымнан ер! Барайық!
Dialogue: 0,0:03:05.66,0:03:06.33,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:03:06.45,0:03:07.66,Default,,0,0,0,,Түсінді
Dialogue: 0,0:03:13.12,0:03:17.20,Default,,0,0,0,,Сіз бұған қарсы тұруға тырысасыз ба? Мені күлдіреді, Бизон!
Dialogue: 0,0:03:17.83,0:03:24.04,Default,,0,0,0,,Талзим Біздің мақсатымыз жауды жеңу емес. Күдікті құрал-жабдық пен қаруды назардан тыс қалдырмаңыз!
Dialogue: 0,0:03:24.16,0:03:25.58,Default,,0,0,0,,Бизон Жаңа қозғалыс!
Dialogue: 0,0:03:27.75,0:03:29.62,Default,,0,0,0,,Аспанда үш ұшақ, артымнан ер!
Dialogue: 0,0:03:29.87,0:03:30.91,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:03:36.66,0:03:41.12,Default,,0,0,0,,Түтіннен шыққанда, жауды ұрып, олар кері оқ атпай тұрып кет.
Dialogue: 0,0:03:41.25,0:03:42.00,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:03:42.91,0:03:43.62,Default,,0,0,0,,Жау!
Dialogue: 0,0:03:43.70,0:03:44.33,Default,,0,0,0,,Не...!
Dialogue: 0,0:03:45.33,0:03:46.87,Default,,0,0,0,,Бизонның оқуы дұрыс.
Dialogue: 0,0:03:47.41,0:03:49.54,Default,,0,0,0,,Қолданыстағы деректер жоқ. Мүмкін жаңа үлгі.
Dialogue: 0,0:03:49.66,0:03:55.16,Default,,0,0,0,,Бұл рас па? Берилде Бенеш пен Пассо бар, ал жаңа модельде Раша мен Михайлов бар.
Dialogue: 0,0:03:55.45,0:03:57.50,Default,,0,0,0,,дирижабль Талзим екеуміздің арамызда.
Dialogue: 0,0:03:57.95,0:03:59.54,Default,,0,0,0,,Жүйкеңізді жоғалтпаңыз!
Dialogue: 0,0:03:59.95,0:04:00.95,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:04:11.62,0:04:12.95,Default,,0,0,0,,Қалай ойлайсың, Раша?
Dialogue: 0,0:04:13.25,0:04:16.20,Default,,0,0,0,,Берілге қарағанда күшті, бірақ менің ойымша, оны басқаруға болады.
Dialogue: 0,0:04:16.29,0:04:17.50,Default,,0,0,0,,Егер сіз оны түсіре алсаңыз, оны жасаңыз.
Dialogue: 0,0:04:17.66,0:04:18.37,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:04:22.33,0:04:24.16,Default,,0,0,0,,Уф... Мен оны сілкіп тастай алмаймын.
Dialogue: 0,0:04:29.12,0:04:30.08,Default,,0,0,0,,Уау
Dialogue: 0,0:04:31.79,0:04:33.37,Default,,0,0,0,,О, бұл кім?
Dialogue: 0,0:04:39.66,0:04:41.33,Default,,0,0,0,,Жақсы байланыс
Dialogue: 0,0:04:41.58,0:04:45.58,Default,,0,0,0,,Люксион Дионың Бладионымен жақсы қосылу реакциясын көрсетті!
Dialogue: 0,0:04:45.70,0:04:46.33,Default,,0,0,0,,Столкер… не болып жатыр өзі?
Dialogue: 0,0:04:46.41,0:04:47.12,Default,,0,0,0,,Хмм?
Dialogue: 0,0:04:47.20,0:04:48.04,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:04:49.91,0:04:51.70,Default,,0,0,0,,Бұл мүмкін емес...
Dialogue: 0,0:04:51.87,0:04:54.16,Default,,0,0,0,,Па... Ұшқыш Маркус бортта...?
Dialogue: 0,0:04:54.45,0:04:58.58,Default,,0,0,0,,Маркустың өмірлік маңызды функциялары соңғы 20 минутта тоқтатылды.
Dialogue: 0,0:04:58.75,0:05:02.62,Default,,0,0,0,,Люк ең алдымен қоқыспен толтырылуы керек еді. Сіз ішін көре аласыз ба?
Dialogue: 0,0:05:02.75,0:05:04.54,Default,,0,0,0,,Ішкі камера дұрыс жұмыс істемейді және кескіндерді көрсетпейді.
Dialogue: 0,0:05:04.75,0:05:05.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:06.04,0:05:09.62,Default,,0,0,0,,Бұл майор Рене Кляйнбек. Аты-жөніңізді және байланысыңызды көрсетіңіз.
Dialogue: 0,0:05:09.79,0:05:13.16,Default,,0,0,0,,Бұл кім? балапан? Дауыс қайдан шықты?
Dialogue: 0,0:05:13.70,0:05:14.62,Default,,0,0,0,,Балапандар?
Dialogue: 0,0:05:14.75,0:05:17.66,Default,,0,0,0,,Бұл балапан ба? Бұл қайда?
Dialogue: 0,0:05:17.83,0:05:19.12,Default,,0,0,0,,Аты және байланысы!
Dialogue: 0,0:05:19.33,0:05:21.58,Default,,0,0,0,,О! Балапан емес пе?
Dialogue: 0,0:05:21.95,0:05:25.50,Default,,0,0,0,,О, м... Сейо орта мектебінің бірінші курс студенті Аоба Ватасе
Dialogue: 0,0:05:25.95,0:05:27.25,Default,,0,0,0,,Aoba Watase?
Dialogue: 0,0:05:27.50,0:05:29.16,Default,,0,0,0,,Сіз зертхана қызметкерісіз бе...?
Dialogue: 0,0:05:29.54,0:05:33.33,Default,,0,0,0,,Қалай болғанда да, ол жерде қауіпті. Оны жүк лифтінің алдыңғы жағына жылжытыңыз.
Dialogue: 0,0:05:33.45,0:05:35.20,Default,,0,0,0,,Қозғал десең де...
Dialogue: 0,0:05:35.54,0:05:37.58,Default,,0,0,0,,Сізде тіпті А санаты жоқ екеніне сенімдісіз бе?
Dialogue: 0,0:05:37.91,0:05:41.62,Default,,0,0,0,,Лицензиясыз ұшу - әскери тәртіпті бұзу! Тез түсіңіз!
Dialogue: 0,0:05:42.00,0:05:43.91,Default,,0,0,0,,Маған түсейін деп айт... Не істеуім керек?
Dialogue: 0,0:05:44.29,0:05:48.75,Default,,0,0,0,,Хмм... Мен сені шайқас біткен соң жазалаймын! Оған дейін тыныш болыңыз!
Dialogue: 0,0:05:53.29,0:05:57.04,Default,,0,0,0,,№3 нектар зеңбірегі тиді, перделерді аша алатын 3 зеңбірегі ғана қалды.
Dialogue: 0,0:05:57.16,0:05:58.12,Default,,0,0,0,,Валиансер ше?
Dialogue: 0,0:05:58.20,0:06:02.37,Default,,0,0,0,,Брадионға 2 бірлік, Берил А С-ге 1 бірлік, шайқас жалғасуда
Dialogue: 0,0:06:03.54,0:06:05.62,Default,,0,0,0,,Маю-чан, сен не айттың?
Dialogue: 0,0:06:06.45,0:06:10.16,Default,,0,0,0,,Люксион Брадионмен жақсы байланыста болды...
Dialogue: 0,0:06:10.41,0:06:11.54,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:06:13.08,0:06:14.70,Default,,0,0,0,,Екі машинаны жұптастырайық
Dialogue: 0,0:06:14.79,0:06:15.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:15.83,0:06:16.66,Default,,0,0,0,,Капитан?
Dialogue: 0,0:06:16.91,0:06:22.29,Default,,0,0,0,,Соғыс жағдайы нашар. Осылай жалғаса берсе, Люксионды еш қарсылықсыз жау басып алады.
Dialogue: 0,0:06:22.95,0:06:28.16,Default,,0,0,0,,Егер сіз өзіңіздің қабілеттеріңізді Диомен бөлісе алсаңыз, лифтке бірінші рет кірсеңіз де қозғала аласыз, солай ма?
Dialogue: 0,0:06:28.37,0:06:32.04,Default,,0,0,0,,Сіз Дионы танымайтын адаммен жұптастыруды жоспарлап отырсыз ба?
Dialogue: 0,0:06:32.25,0:06:33.83,Default,,0,0,0,,Реакция жасыл, солай ма?
Dialogue: 0,0:06:33.91,0:06:36.33,Default,,0,0,0,,Ах, иә... А, бірақ!
Dialogue: 0,0:06:36.45,0:06:38.54,Default,,0,0,0,,Құпиялылыққа қатысты да мәселелер бар.
Dialogue: 0,0:06:38.75,0:06:40.62,Default,,0,0,0,,Бұл менің жауапкершілігім.
Dialogue: 0,0:06:41.20,0:06:44.79,Default,,0,0,0,,Оны жалғыз қалдырсақ, оған қауіп төніп қана қоймай, бізге де қауіп төнеді...
Dialogue: 0,0:06:45.37,0:06:50.45,Default,,0,0,0,,Ал мен ұдайы жеңілгенді ұнатпаймын... Білесіз бе, майор.
Dialogue: 0,0:06:50.75,0:06:51.33,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:52.08,0:06:52.83,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:06:55.29,0:06:56.29,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:06:57.04,0:07:00.00,Default,,0,0,0,,Luxion Bradion байланыстыру процесі басталады!
Dialogue: 0,0:07:00.12,0:07:00.95,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:07:05.12,0:07:06.79,Default,,0,0,0,,Бірақ депутат Рене!
Dialogue: 0,0:07:07.04,0:07:08.50,Default,,0,0,0,,Командирдің бұйрықтары.
Dialogue: 0,0:07:08.91,0:07:09.79,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:07:10.62,0:07:11.41,Default,,0,0,0,,Сіз мені естисіз бе?
Dialogue: 0,0:07:11.70,0:07:12.33,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:12.45,0:07:14.20,Default,,0,0,0,,Мен қазір сендермен жұптаспақпын
Dialogue: 0,0:07:14.33,0:07:16.04,Default,,0,0,0,,Не? Қосылу?
Dialogue: 0,0:07:16.45,0:07:18.91,Default,,0,0,0,,Менің айтқанымды істе! Ах...
Dialogue: 0,0:07:23.79,0:07:25.58,Default,,0,0,0,,Бұл не... Уау!
Dialogue: 0,0:07:31.29,0:07:33.50,Default,,0,0,0,,О... шын айтасың ба?
Dialogue: 0,0:07:43.00,0:07:45.29,Default,,0,0,0,,Тағы бір итеру.
Dialogue: 0,0:07:45.95,0:07:46.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:47.29,0:07:48.95,Default,,0,0,0,,Сәлем! Тағы біреуі!
Dialogue: 0,0:07:49.20,0:07:50.08,Default,,0,0,0,,Мен келемін!
Dialogue: 0,0:07:50.20,0:07:50.83,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:07:51.33,0:07:53.08,Default,,0,0,0,,Михайлов, сен кет.
Dialogue: 0,0:07:53.37,0:07:54.62,Default,,0,0,0,,Талзим, қайтып келіңізші
Dialogue: 0,0:07:54.87,0:07:55.50,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:07:57.54,0:07:59.16,Default,,0,0,0,,Бұл қызықсыз, Бизон!
Dialogue: 0,0:07:59.62,0:08:00.70,Default,,0,0,0,,Сіз білдіңіз бе?
Dialogue: 0,0:08:00.79,0:08:02.45,Default,,0,0,0,,Қап, мені жібер!
Dialogue: 0,0:08:03.66,0:08:06.58,Default,,0,0,0,,Сіз мені естисіз бе? Connective Dio-ға қоңырау шалыңыз!
Dialogue: 0,0:08:06.75,0:08:09.58,Default,,0,0,0,,Bradion Seventh Code қабылдау ауқымына кірді.
Dialogue: 0,0:08:09.70,0:08:10.41,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:08:13.66,0:08:14.83,Default,,0,0,0,,Біз қолдауға барамыз ба?
Dialogue: 0,0:08:17.00,0:08:18.95,Default,,0,0,0,,Қос...байланыс...?
Dialogue: 0,0:08:19.25,0:08:21.54,Default,,0,0,0,,Жалғау! Байланыс Дио!
Dialogue: 0,0:08:21.70,0:08:22.54,Default,,0,0,0,,Дио...?
Dialogue: 0,0:08:23.54,0:08:24.70,Default,,0,0,0,,Дио күтіп тұр
Dialogue: 0,0:08:24.87,0:08:26.50,Default,,0,0,0,,Иә! Байланыс Дио!
Dialogue: 0,0:08:26.58,0:08:27.79,Default,,0,0,0,,Сіз Диосыз ба?
Dialogue: 0,0:08:28.08,0:08:28.75,Default,,0,0,0,,Столкер… не болып жатыр өзі?
Dialogue: 0,0:08:34.41,0:08:38.45,Default,,0,0,0,,Дио! Мен Аоба Ватасемін! Хина сені күтуде!
Dialogue: 0,0:08:38.79,0:08:39.50,Default,,0,0,0,,Не? Ит пе?
Dialogue: 0,0:08:46.62,0:08:49.83,Default,,0,0,0,,Дио! не болды? Мен аймақтан кетемін
Dialogue: 0,0:08:49.87,0:08:51.33,Default,,0,0,0,,Тез ұсыныс жасаңыз!
Dialogue: 0,0:08:51.37,0:08:54.37,Default,,0,0,0,,Ватасе Аоба! Жарайды, мен айтқандай істе!
Dialogue: 0,0:08:54.70,0:08:56.66,Default,,0,0,0,,А... түсіндім.
Dialogue: 0,0:08:59.00,0:09:00.54,Default,,0,0,0,,Сіз бір жерге барасыз ба?
Dialogue: 0,0:09:01.12,0:09:03.20,Default,,0,0,0,,Михайлов, қазір сол жерден ат!
Dialogue: 0,0:09:03.37,0:09:04.04,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:09:09.66,0:09:12.70,Default,,0,0,0,,Тыңдаңыз! Байланыс Дио!
Dialogue: 0,0:09:12.95,0:09:15.16,Default,,0,0,0,,Ха! Байланыс Дио!
Dialogue: 0,0:09:17.16,0:09:18.16,Default,,0,0,0,,Қабылдау!
Dialogue: 0,0:09:18.50,0:09:19.70,Default,,0,0,0,,Байланысты бастаңыз!
Dialogue: 0,0:09:19.87,0:09:21.33,Default,,0,0,0,,Бірінші ұсыныс!
Dialogue: 0,0:09:32.12,0:09:33.33,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:09:36.12,0:09:37.87,Default,,0,0,0,,Уау... Ах...
Dialogue: 0,0:09:58.08,0:09:58.87,Default,,0,0,0,,Тиіп көр!
Dialogue: 0,0:10:02.54,0:10:03.41,Default,,0,0,0,,Не!
Dialogue: 0,0:10:10.62,0:10:11.50,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:11.75,0:10:12.75,Default,,0,0,0,,Трансформацияланды ма?
Dialogue: 0,0:10:13.41,0:10:14.08,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:10:19.83,0:10:21.16,Default,,0,0,0,,Ілініс…
Dialogue: 0,0:10:21.33,0:10:22.70,Default,,0,0,0,,Мен үлгердім...
Dialogue: 0,0:10:22.83,0:10:24.04,Default,,0,0,0,,Сәйкестік - ең жақсы!
Dialogue: 0,0:10:31.95,0:10:34.04,Default,,0,0,0,,Қый!
Dialogue: 0,0:10:35.95,0:10:36.58,Default,,0,0,0,,Келе жатыр!
Dialogue: 0,0:10:43.87,0:10:44.54,Default,,0,0,0,,Столкер… не болып жатыр өзі?
Dialogue: 0,0:10:44.62,0:10:45.41,Default,,0,0,0,,Иә, аға, сен кереметсің.
Dialogue: 0,0:10:54.29,0:10:55.95,Default,,0,0,0,,Қосылу сәтті болды ма?
Dialogue: 0,0:10:56.12,0:10:57.20,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:10:57.37,0:11:00.79,Default,,0,0,0,,Бұл таңқаларлық... сен менімен үйлесімдісің.
Dialogue: 0,0:11:03.83,0:11:06.83,Default,,0,0,0,,Мен... роботты жылжыттым ба?
Dialogue: 0,0:11:07.29,0:11:11.91,Default,,0,0,0,,Иә, муфта орнатылған кезде сіз Дионың пилоттық білімін бөлістіңіз.
Dialogue: 0,0:11:12.12,0:11:13.04,Default,,0,0,0,,Бөлісу?
Dialogue: 0,0:11:13.16,0:11:16.66,Default,,0,0,0,,Сіз Valiancer-ті қалай басқару керектігін білесіз...
Dialogue: 0,0:11:16.79,0:11:17.79,Default,,0,0,0,,Жау келе жатыр!
Dialogue: 0,0:11:17.91,0:11:18.62,Default,,0,0,0,,Жау?
Dialogue: 0,0:11:21.66,0:11:22.29,Default,,0,0,0,,Уф
Dialogue: 0,0:11:24.45,0:11:25.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:29.00,0:11:30.20,Default,,0,0,0,,Міне, алғашқы отбасыңды мүлде ұмытып қалғансың➡
Dialogue: 0,0:11:37.12,0:11:39.87,Default,,0,0,0,,Бұл не...? иә?
Dialogue: 0,0:11:41.50,0:11:43.29,Default,,0,0,0,,Біз осы уақытқа дейін жеттік!
Dialogue: 0,0:11:43.79,0:11:44.45,Default,,0,0,0,,Уф
Dialogue: 0,0:11:51.29,0:11:52.91,Default,,0,0,0,,Ой... қозғалды...!
Dialogue: 0,0:12:01.58,0:12:03.95,Default,,0,0,0,,Қарғыс атсын! Бұл!
Dialogue: 0,0:12:05.62,0:12:07.04,Default,,0,0,0,,Қандай күш!
Dialogue: 0,0:12:07.20,0:12:09.45,Default,,0,0,0,,Брадион Бұл қалыпты шығыстан екі есе көп!
Dialogue: 0,0:12:09.58,0:12:12.08,Default,,0,0,0,,Байланыс күткендей...?
Dialogue: 0,0:12:12.16,0:12:16.45,Default,,0,0,0,,Бірақ ол жүрудің орнына кенет төбелесіп жатыр.
Dialogue: 0,0:12:16.58,0:12:18.12,Default,,0,0,0,,Бұл да қосылыс па...?
Dialogue: 0,0:12:18.33,0:12:20.75,Default,,0,0,0,,Жоқ, ол қалыпты емес!
Dialogue: 0,0:12:20.87,0:12:23.79,Default,,0,0,0,,Көрсеткіш жоғары болса да, әлі де сонша!
Dialogue: 0,0:12:25.04,0:12:27.66,Default,,0,0,0,,Бұл Valiancers комбинациясы сияқты!
Dialogue: 0,0:12:30.41,0:12:31.12,Default,,0,0,0,,Аһ!
Dialogue: 0,0:12:32.83,0:12:33.54,Default,,0,0,0,,Уф
Dialogue: 0,0:12:35.04,0:12:35.66,Default,,0,0,0,,О
Dialogue: 0,0:12:37.66,0:12:39.41,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:12:45.29,0:12:47.16,Default,,0,0,0,,Ұшу? Ах
Dialogue: 0,0:12:47.79,0:12:48.95,Default,,0,0,0,,Маған қашуға рұқсат етіңіз!
Dialogue: 0,0:12:50.58,0:12:51.41,Default,,0,0,0,,Спорт күні керемет өтті, иә?
Dialogue: 0,0:12:55.25,0:12:56.25,Default,,0,0,0,,Тағы кездескенше!
Dialogue: 0,0:13:00.04,0:13:01.16,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:13:07.62,0:13:09.29,Default,,0,0,0,,Ух...ухххх!
Dialogue: 0,0:13:14.66,0:13:15.83,Default,,0,0,0,,Михайлов!
Dialogue: 0,0:13:15.95,0:13:17.04,Default,,0,0,0,,Маю-сан менің жейдемнің үстінде жатыр…
Dialogue: 0,0:13:17.16,0:13:18.50,Default,,0,0,0,,Тас Масканы ойлап тапқан —
Dialogue: 0,0:13:19.45,0:13:20.62,Default,,0,0,0,,Мені жіберіңізші!
Dialogue: 0,0:13:20.91,0:13:21.62,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:13:21.75,0:13:24.91,Default,,0,0,0,,Екінші қол ампутацияланды! Менде тек ұрыс қылыш бар
Dialogue: 0,0:13:25.29,0:13:27.79,Default,,0,0,0,,Цк... Барлық жұмыс істейтін ұшақтар шығарылды!
Dialogue: 0,0:13:28.50,0:13:31.70,Default,,0,0,0,,Жаңа үлгі ашылды; одан әрі зақымдану мағынасыз.
Dialogue: 0,0:13:32.50,0:13:33.41,Default,,0,0,0,,Түсінген…
Dialogue: 0,0:13:34.04,0:13:36.25,Default,,0,0,0,,Эй, сен байсалдысың ба, Бизон?
Dialogue: 0,0:13:42.54,0:13:44.41,Default,,0,0,0,,Сіз оны жаңа ғана тазаладыңыз ба?
Dialogue: 0,0:13:44.54,0:13:46.50,Default,,0,0,0,,Тез жүр, Талзим, мен сені артқа тастаймын!
Dialogue: 0,0:13:46.62,0:13:47.25,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:47.70,0:13:48.70,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:13:52.58,0:13:54.37,Default,,0,0,0,,Жау әскерлері шегінеді
Dialogue: 0,0:13:54.66,0:13:56.54,Default,,0,0,0,,Валиансер корпусы, қайтару.
Dialogue: 0,0:13:56.91,0:13:59.29,Default,,0,0,0,,Я...
Dialogue: 0,0:13:59.70,0:14:00.66,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:14:03.16,0:14:08.95,Default,,0,0,0,,Егер жау оңтүстік жақтан болса, тағы да шабуылдар толқыны болуы мүмкін. Бос емес болады...
Dialogue: 0,0:14:09.12,0:14:12.58,Default,,0,0,0,,Капитан, Люксион жолаушылары ше?
Dialogue: 0,0:14:12.83,0:14:17.37,Default,,0,0,0,,Меніңше, менің таңдауым көп емес, өйткені бұл құпия база аяқталды.
Dialogue: 0,0:14:17.62,0:14:18.91,Default,,0,0,0,,Маю, менің артымнан жүр
Dialogue: 0,0:14:19.00,0:14:19.70,Default,,0,0,0,,Иә
Dialogue: 0,0:14:26.91,0:14:31.04,Default,,0,0,0,,Күрсін... Күрсін... Бітті ме?
Dialogue: 0,0:14:37.62,0:14:38.79,Default,,0,0,0,,Ажырату
Dialogue: 0,0:14:45.29,0:14:46.00,Default,,0,0,0,,Жаңа велосипедтің қуанышына ештеңе жетпейді, иә?
Dialogue: 0,0:14:46.83,0:14:49.62,Default,,0,0,0,,Не? Апыр-ай!
Dialogue: 0,0:14:56.58,0:14:57.45,Default,,0,0,0,,Гаха!
Dialogue: 0,0:15:04.04,0:15:05.25,Default,,0,0,0,,Уф
Dialogue: 0,0:15:06.37,0:15:08.08,Default,,0,0,0,,Барлығың, асығыңдар, жұмыс істеңдер.
Dialogue: 0,0:15:08.45,0:15:10.29,Default,,0,0,0,,Барлық машиналарды жылытыңыз!
Dialogue: 0,0:15:16.87,0:15:18.20,Default,,0,0,0,,Ал, шықпай жатыр ма?
Dialogue: 0,0:15:18.33,0:15:20.29,Default,,0,0,0,,Сіз тіпті операция негіздерін де білмейсіз бе?
Dialogue: 0,0:15:20.41,0:15:23.16,Default,,0,0,0,,Сәлем! Не болды?
Dialogue: 0,0:15:23.62,0:15:24.25,Default,,0,0,0,,О
Dialogue: 0,0:15:24.41,0:15:25.16,Default,,0,0,0,,Дио?
Dialogue: 0,0:15:26.75,0:15:29.08,Default,,0,0,0,,Оны қалай ашамын...?
Dialogue: 0,0:15:29.79,0:15:33.54,Default,,0,0,0,,Төменде...? О?
Dialogue: 0,0:15:34.58,0:15:35.33,Default,,0,0,0,,Хмм?
Dialogue: 0,0:15:36.54,0:15:40.00,Default,,0,0,0,,О! Ашылды... Жақсы...
Dialogue: 0,0:15:40.95,0:15:41.58,Default,,0,0,0,,Уф
Dialogue: 0,0:15:43.12,0:15:44.20,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:15:45.16,0:15:49.45,Default,,0,0,0,,Оңаша эксперименттік орынды пайдалану кері нәтиже берді ме?
Dialogue: 0,0:15:49.58,0:15:52.37,Default,,0,0,0,,Оның үстіне қосқыштардың бірі қайтыс болды...
Dialogue: 0,0:15:52.79,0:15:55.45,Default,,0,0,0,,Менің ойымша, біз дереу бас тартуымыз керек.
Dialogue: 0,0:15:55.58,0:15:56.50,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:15:56.95,0:16:01.79,Default,,0,0,0,,Біз сіздің қатысуыңызды жария ете алмағандықтан, біз қосымша күштерді жариялай алмаймыз.
Dialogue: 0,0:16:02.00,0:16:04.29,Default,,0,0,0,,Дереу штабтың базасына барыңыз.
Dialogue: 0,0:16:04.75,0:16:08.00,Default,,0,0,0,,Тәжірибенің ізін қалдырмаңыз.
Dialogue: 0,0:16:08.16,0:16:11.79,Default,,0,0,0,,Иә, айтпақшы, мен жаңадан сәйкес келетінімді хабарладым...
Dialogue: 0,0:16:11.91,0:16:14.37,Default,,0,0,0,,Мен саған із қалдырма дедім.
Dialogue: 0,0:16:14.50,0:16:15.70,Default,,0,0,0,,Түсінді
Dialogue: 0,0:16:20.04,0:16:22.95,Default,,0,0,0,,2088…?
Dialogue: 0,0:16:23.12,0:16:24.04,Default,,0,0,0,,Иә.
Dialogue: 0,0:16:24.33,0:16:26.45,Default,,0,0,0,,Соғыс нені білдіреді?
Dialogue: 0,0:16:26.75,0:16:28.16,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:16:28.29,0:16:33.00,Default,,0,0,0,,А... мм... а... не сұрайын...
Dialogue: 0,0:16:33.79,0:16:34.41,Default,,0,0,0,,Әй
Dialogue: 0,0:16:35.66,0:16:41.58,Default,,0,0,0,,Қазіргі уақытта Жапония елі Еркін Келісім Федерациясының мүшесі болып табылады және бұл кеме де сол топқа жатады.
Dialogue: 0,0:16:41.70,0:16:48.20,Default,,0,0,0,,Одақ өткен жылдан бері Зогилия Республикасымен соғысуда және көріп отырғаныңыздай, соғыс жағдайы өте ауыр.
Dialogue: 0,0:16:48.50,0:16:50.37,Default,,0,0,0,,Өтінемін, түсіндіңіз бе?
Dialogue: 0,0:16:50.95,0:16:53.79,Default,,0,0,0,,Бұл шынымен болашақ па...
Dialogue: 0,0:16:53.91,0:16:54.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:54.62,0:16:59.04,Default,,0,0,0,,Командирдің орынбасары, бұл жігіт баяғыдан бері өзі туралы өткеннен келгенін айтып жүр.
Dialogue: 0,0:16:59.12,0:17:01.00,Default,,0,0,0,,Бұл рас, Дио.
Dialogue: 0,0:17:01.41,0:17:03.20,Default,,0,0,0,,Адамдарды жай ғана атымен атамаңыз
Dialogue: 0,0:17:03.29,0:17:04.45,Default,,0,0,0,,Бірақ бұл Дио, солай ма?
Dialogue: 0,0:17:04.54,0:17:06.62,Default,,0,0,0,,Мені бұлай атауға ешқандай себеп жоқ.
Dialogue: 0,0:17:06.75,0:17:10.45,Default,,0,0,0,,Уф... Айтайын дегенім Хина... Уф... Жүр, мылтықты таста!
Dialogue: 0,0:17:10.54,0:17:15.45,Default,,0,0,0,,Сен маған кім екеніңді айтпайынша. Бұл 70 жыл бұрынғы не нәрсе?
Dialogue: 0,0:17:15.54,0:17:17.29,Default,,0,0,0,,Бұл өтірік емес!
Dialogue: 0,0:17:17.54,0:17:20.66,Default,,0,0,0,,Екеуіңе де солай. Дио, мылтығыңды тарт.
Dialogue: 0,0:17:21.29,0:17:22.25,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:22.83,0:17:28.91,Default,,0,0,0,,Командир лейтенант, капитан менімен офицер Хилл және прапорщик Вайнбергпен капитанның кабинасына келуге хабарласты.
Dialogue: 0,0:17:29.04,0:17:30.62,Default,,0,0,0,,Түсіндім, рахмет
Dialogue: 0,0:17:31.12,0:17:32.33,Default,,0,0,0,,прапорщик Вайнберг
Dialogue: 0,0:17:32.41,0:17:33.16,Default,,0,0,0,,Иә
Dialogue: 0,0:17:34.04,0:17:36.25,Default,,0,0,0,,Ха, сәл күте тұрыңыз! Эй Дио...!
Dialogue: 0,0:17:36.37,0:17:42.37,Default,,0,0,0,,Қарғыс атсын... Бұл Юмихара Хина! Ол шашы ұзын қыз! Мен осылай шашқа байлайтынмын!
Dialogue: 0,0:17:45.66,0:17:47.83,Default,,0,0,0,,Ол сен туралы айтып жатыр...
Dialogue: 0,0:17:48.45,0:17:49.83,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:17:54.16,0:17:55.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:59.50,0:18:04.41,Default,,0,0,0,,Михайловтың асыл құрбандығы бізді жеңіске бір қадам жақындатты.
Dialogue: 0,0:18:04.91,0:18:10.04,Default,,0,0,0,,Еркін Келісім Федерациясы жақында операциялық мүмкіндіктерге ие болған жаңа ұшақ.
Dialogue: 0,0:18:10.29,0:18:15.87,Default,,0,0,0,,Балалар, қойылған көптеген манекендердің ішінен жақсы нәтиже шығарған сияқтысыңдар.
Dialogue: 0,0:18:16.12,0:18:20.95,Default,,0,0,0,,Сіздің еліңіздің әкімшілік бюросы сізге жаңа үлгінің үлгілерін жіберуіңізді сұрайды.
Dialogue: 0,0:18:21.45,0:18:23.29,Default,,0,0,0,,Сіз оны бірден түсіре аласыз.
Dialogue: 0,0:18:23.66,0:18:25.04,Default,,0,0,0,,Қолбасшы Альфрид
Dialogue: 0,0:18:25.79,0:18:28.33,Default,,0,0,0,,Әрине, арнайы атташе мырза.
Dialogue: 0,0:18:28.41,0:18:30.79,Default,,0,0,0,,Мен нәтижелерді күтемін.
Dialogue: 0,0:18:31.29,0:18:33.16,Default,,0,0,0,,Слава Зогирия
Dialogue: 0,0:18:34.83,0:18:36.83,Default,,0,0,0,,Сонымен? Оның мәні неде?
Dialogue: 0,0:18:37.33,0:18:40.91,Default,,0,0,0,,Менің заттарымның барлығы шамамен 70 жыл бұрынғы.
Dialogue: 0,0:18:41.16,0:18:45.95,Default,,0,0,0,,Алайда еліктейтін дүниелер көп, сондықтан ол үшін біреудің сөзіне сену қисынсыз.
Dialogue: 0,0:18:46.08,0:18:48.79,Default,,0,0,0,,Өйткені, бұл уақытқа саяхат...
Dialogue: 0,0:18:48.87,0:18:50.95,Default,,0,0,0,,Бұл қалыпты жағдай, солай емес пе?
Dialogue: 0,0:18:51.08,0:18:52.83,Default,,0,0,0,,Оны қалай жоюға болады?
Dialogue: 0,0:18:53.16,0:18:58.16,Default,,0,0,0,,Ол бізді құтқарған батыр, бірақ оның құпиясын ашса мен қарсы болмас едім.
Dialogue: 0,0:18:58.37,0:19:00.70,Default,,0,0,0,,Мен штабтың базасына келуім керек шығар.
Dialogue: 0,0:19:00.83,0:19:02.66,Default,,0,0,0,,Менің ойымша, бұл орынды шешім.
Dialogue: 0,0:19:02.79,0:19:03.95,Default,,0,0,0,,Ол қазір қайда?
Dialogue: 0,0:19:04.08,0:19:08.08,Default,,0,0,0,,Капитан Конрад маған емдеу туралы шешім қабылданғанша бөлмемде қалуымды айтты.
Dialogue: 0,0:19:08.20,0:19:10.16,Default,,0,0,0,,Тағы барсам, өзім жасаймын...!
Dialogue: 0,0:19:10.29,0:19:15.08,Default,,0,0,0,,Жоқ, сіз кемедесіз және сізде трекер бар, сондықтан сізді ұстаудың қажеті жоқ.
Dialogue: 0,0:19:15.20,0:19:15.54,Default,,0,0,0,,Ах… «C» рейтингі
Dialogue: 0,0:19:15.58,0:19:19.16,Default,,0,0,0,,Егер сіз кенеттен адамдық камераға түссеңіз, басқа адамның сезімі одан сайын нашарлайды.
Dialogue: 0,0:19:19.29,0:19:20.04,Default,,0,0,0,,Капитан...
Dialogue: 0,0:19:20.12,0:19:20.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:20.83,0:19:22.75,Default,,0,0,0,,Сіз оны қайтадан пайдалануды жоспарлап отырсыз ба?
Dialogue: 0,0:19:22.95,0:19:27.04,Default,,0,0,0,,Сізге ұнамай ма? Менің ойымша, ол сіз жұптаған досыңыз, солай ма?
Dialogue: 0,0:19:27.16,0:19:29.95,Default,,0,0,0,,Бұл төтенше эвакуация болды. Мен ол адамды енді ешқашан кездестірмеймін...
Dialogue: 0,0:19:30.08,0:19:34.29,Default,,0,0,0,,Ахахаха... Ал, енді мұндай мүмкіндік болмайды деп үміттенейік.
Dialogue: 0,0:19:35.37,0:19:39.04,Default,,0,0,0,,Дайындық аяқталғаннан кейін Cygnus Солтүстік Америка базасына аттанады.
Dialogue: 0,0:19:39.16,0:19:40.00,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:19:41.29,0:19:43.16,Default,,0,0,0,,Бұл болғаны дұрыс сияқты.
Dialogue: 0,0:19:43.45,0:19:44.58,Default,,0,0,0,,Бұл субтитрлер JOJO's Bizarre Adventure форумы, Yuhari Subtitles және Gods Subtitles Group бірлесіп дайындады
Dialogue: 0,0:19:47.25,0:19:49.83,Default,,0,0,0,,Ум... жақсысың ба?
Dialogue: 0,0:19:51.54,0:19:53.41,Default,,0,0,0,,Бұл дұрыс емес сияқты.
Dialogue: 0,0:19:54.58,0:19:55.20,Default,,0,0,0,,Мүмкін балмұздақ жегендіктен шығар. Ал сізде ше, Президент?
Dialogue: 0,0:19:55.29,0:19:56.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:56.12,0:19:57.95,Default,,0,0,0,,Аздап тамақтанып, демалыңыз.
Dialogue: 0,0:19:58.20,0:19:59.12,Default,,0,0,0,,Сәлем
Dialogue: 0,0:19:59.54,0:20:01.54,Default,,0,0,0,,Ұшуға 15 минут қалды
Dialogue: 0,0:20:01.66,0:20:03.29,Default,,0,0,0,,А, мен қайтуым керек.
Dialogue: 0,0:20:07.08,0:20:07.75,Default,,0,0,0,,Эй
Dialogue: 0,0:20:07.87,0:20:08.50,Default,,0,0,0,,Ах
Dialogue: 0,0:20:08.66,0:20:11.16,Default,,0,0,0,,Осы жерді бассаңыз, есік ашылады.
Dialogue: 0,0:20:11.87,0:20:14.50,Default,,0,0,0,,Бірақ бұл үлкен жер, сондықтан адасып қалмау үшін абай болыңыз.
Dialogue: 0,0:20:14.62,0:20:15.25,Default,,0,0,0,,Иә
Dialogue: 0,0:20:15.50,0:20:16.54,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:20:18.87,0:20:20.33,Default,,0,0,0,,Не болып жатыр...
Dialogue: 0,0:20:22.75,0:20:25.95,Default,,0,0,0,,Мен болашаққа шынымен келдім бе...?
Dialogue: 0,0:20:26.45,0:20:29.37,Default,,0,0,0,,Хина Сен айтқаның ба...?
Dialogue: 0,0:20:30.37,0:20:33.87,Default,,0,0,0,,Сіз қазір болашаққа барасыз. Дио сені күтіп отыр.
Dialogue: 0,0:20:36.70,0:20:38.66,Default,,0,0,0,,Күтудің қажеті жоқ...
Dialogue: 0,0:20:45.12,0:20:46.50,Default,,0,0,0,,Огги Бұл қалай?
Dialogue: 0,0:20:46.58,0:20:48.16,Default,,0,0,0,,Негізгі қозғалтқыш сынға жақын
Dialogue: 0,0:20:48.25,0:20:49.95,Default,,0,0,0,,Қарсыластың іздеу ауқымында барлығы жасыл
Dialogue: 0,0:20:54.58,0:20:57.79,Default,,0,0,0,,Жаңа үлгінің өнімділігі туралы көптеген белгісіздер бар. Қауіпсіздікті төмендетпеңіз.
Dialogue: 0,0:20:58.08,0:20:59.08,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:21:03.04,0:21:04.00,Default,,0,0,0,,Мекеме үшін жақсы!
Dialogue: 0,0:21:04.29,0:21:05.45,Default,,0,0,0,,Навигация қолжетімді!
Dialogue: 0,0:21:05.75,0:21:09.41,Default,,0,0,0,,Ақпаратты біріктіру аяқталды! FCS барлық көк шам!
Dialogue: 0,0:21:10.75,0:21:11.50,Default,,0,0,0,,Капитан
Dialogue: 0,0:21:11.75,0:21:12.37,Default,,0,0,0,,Иә
Dialogue: 0,0:21:14.16,0:21:15.95,Default,,0,0,0,,Cygnus Liftoff
Dialogue: 0,0:21:23.91,0:21:26.29,Default,,0,0,0,,Не...? Ол қозғалады ма...?
Dialogue: 0,0:22:10.04,0:22:13.87,Default,,0,0,0,,Мен бұл операцияның сәтті болуы үшін дұға етемін. Зогилияның жауларына өлім.
Dialogue: 0,0:22:14.25,0:22:15.83,Default,,0,0,0,,Зогилияның жауларына өлім
Dialogue: 0,0:22:16.04,0:22:17.70,Default,,0,0,0,,Зогилияның жауларына өлім
Dialogue: 0,0:22:17.87,0:22:19.54,Default,,0,0,0,,Зогилияның жауларына өлім
Dialogue: 0,0:22:20.25,0:22:22.58,Default,,0,0,0,,Зогилияның жауларына өлім
Dialogue: 0,0:22:22.91,0:22:31.04,Default,,0,0,0,,Жүрекпен шақырып, бір-біріне тартқан арғы жағы
Dialogue: 0,0:22:31.29,0:22:39.91,Default,,0,0,0,,Ауырсыну себебін қазір ғана ұмытыңыз.
Dialogue: 0,0:22:40.12,0:22:48.70,Default,,0,0,0,,Мен сені білемін, мен сені іздеймін
Dialogue: 0,0:22:49.04,0:22:57.79,Default,,0,0,0,,Тоқтату мүмкін емес жарықтың кейінгі бейнесін ақырын сүйіңіз
Dialogue: 0,0:22:57.91,0:23:06.54,Default,,0,0,0,,Сәл кідіріс үмітке сеп болса
Dialogue: 0,0:23:06.75,0:23:15.45,Default,,0,0,0,,Қанша рет қыдырдым, сыпайы таңға
Dialogue: 0,0:23:15.70,0:23:24.25,Default,,0,0,0,,Болашақта мен сол аспанға оралсам, сені құтқарғым келеді, қорғағым келеді.
Dialogue: 0,0:23:24.45,0:23:31.41,Default,,0,0,0,,Болашақта сол арманның саған жететін жерін күту
Dialogue: 0,0:23:31.54,0:23:41.00,Default,,0,0,0,,Мен сенің табатыныңа сенімдімін махаббатқа қол созғаныңды қалаймын.
Dialogue: 0,0:23:43.95,0:23:47.79,Default,,0,0,0,,Келесі жолы Buddy кешені «Reunion»
Dialogue: 0,0:23:49.29,0:23:55.29,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory