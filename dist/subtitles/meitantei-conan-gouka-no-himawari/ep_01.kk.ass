Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:18.72,0:00:19.60,Default,,0,0,0,,(балғаның соғу дыбысы)
Dialogue: 0,0:00:19.68,0:00:20.89,Default,,0,0,0,,Келесі
Dialogue: 0,0:00:20.97,0:00:23.39,Default,,0,0,0,,Бұл бүгінгі аукционның маңызды сәті.
Dialogue: 0,0:00:24.10,0:00:27.36,Default,,0,0,0,,Халықаралық шедевр және адамзаттың қазынасы
Dialogue: 0,0:00:27.44,0:00:28.98,Default,,0,0,0,,Ой жоғалды -
Dialogue: 0,0:00:29.07,0:00:31.32,Default,,0,0,0,,Винсент ван Гог
Dialogue: 0,0:00:31.40,0:00:33.07,Default,,0,0,0,,«Күнбағыс»
Dialogue: 0,0:00:35.66,0:00:36.74,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:00:36.82,0:00:39.33,Default,,0,0,0,,Не? Сол «күнбағыс»
Dialogue: 0,0:00:39.41,0:00:40.58,Default,,0,0,0,,«Күнбағыс» екеніне сенімдімін
Dialogue: 0,0:00:40.66,0:00:41.83,Default,,0,0,0,,Соғыста өртенген болуы керек...
Dialogue: 0,0:00:41.91,0:00:43.79,Default,,0,0,0,,Барлығың тыныш болыңдар.
Dialogue: 0,0:00:43.87,0:00:46.12,Default,,0,0,0,,Мен қазірден бастап егжей-тегжейлі түсіндіремін.
Dialogue: 0,0:00:48.17,0:00:49.84,Default,,0,0,0,,Ван Гог Арлесте болған кезде
Dialogue: 0,0:00:49.92,0:00:53.09,Default,,0,0,0,,Ол жеті ``күнбағыс'' суретін салған деседі.
Dialogue: 0,0:00:55.13,0:00:57.34,Default,,0,0,0,,«Күнбағыс» деп аталатын екінші фотосурет
Dialogue: 0,0:00:57.43,0:00:59.55,Default,,0,0,0,,Бұл жолы көрмеге қойылған нәрсе.
Dialogue: 0,0:00:59.64,0:01:02.43,Default,,0,0,0,,1945 ж. Ашия, Жапония
Dialogue: 0,0:01:02.52,0:01:04.73,Default,,0,0,0,,Соғыс отында қираған деседі.
Dialogue: 0,0:01:04.81,0:01:09.40,Default,,0,0,0,,Өткен жылы Арлесте дәл осындай құрамы бар жаңасы табылды.
Dialogue: 0,0:01:09.48,0:01:12.19,Default,,0,0,0,,Бұл жұмысты әртүрлі сарапшылар бағалады.
Dialogue: 0,0:01:12.28,0:01:16.82,Default,,0,0,0,,Бұл жұмысты міндетті түрде Ван Гог салғаны расталды.
Dialogue: 0,0:01:16.91,0:01:18.87,Default,,0,0,0,,Келіңіздер! Бұл «күнбағысқа»
Dialogue: 0,0:01:18.95,0:01:21.83,Default,,0,0,0,,Бізге жаңа өмір салыңыз.
Dialogue: 0,0:01:23.58,0:01:24.45,Default,,0,0,0,,Олай болса!
Dialogue: 0,0:01:24.54,0:01:27.12,Default,,0,0,0,,Винсент ван Гогтың фантастикалық шедеврі
Dialogue: 0,0:01:27.21,0:01:28.67,Default,,0,0,0,,Екінші «Күнбағыс»
Dialogue: 0,0:01:28.75,0:01:31.46,Default,,0,0,0,,Мен 10 миллион доллардан бастаймын.
Dialogue: 0,0:01:31.54,0:01:34.17,Default,,0,0,0,,Эй, эй, кенет 10 миллион доллардан басталады ма?
Dialogue: 0,0:01:34.26,0:01:36.26,Default,,0,0,0,,Және ол 100 000 долларға өседі.
Dialogue: 0,0:01:36.34,0:01:40.30,Default,,0,0,0,,Егер менде осыншама ақша болса, мен ғарышқа аттанар едім.
Dialogue: 0,0:01:42.35,0:01:46.23,Default,,0,0,0,,Қазір 20 миллион телефон арқылы 20,5 миллион онлайн
Dialogue: 0,0:01:46.31,0:01:47.85,Default,,0,0,0,,-(Бай) 50 миллион доллар -(Аукционшы) Иә?
Dialogue: 0,0:01:49.90,0:01:50.73,Default,,0,0,0,,Эй, мына жігіт
Dialogue: 0,0:01:50.81,0:01:53.19,Default,,0,0,0,,Ол әйгілі картиналарды сатып алумен танымал.
Dialogue: 0,0:01:53.27,0:01:54.78,Default,,0,0,0,,- (Джирокичи) 100 миллион доллар - (бай)
Dialogue: 0,0:01:54.86,0:01:56.40,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,0:01:58.28,0:02:00.74,Default,,0,0,0,,Мені естімедің бе? 100 миллион доллар
Dialogue: 0,0:02:00.82,0:02:02.78,Default,,0,0,0,,- (Джирокичи) 100 миллион доллар - (Соноко) Хахахаха...
Dialogue: 0,0:02:02.87,0:02:04.04,Default,,0,0,0,,110 миллион доллар
Dialogue: 0,0:02:04.12,0:02:06.16,Default,,0,0,0,,110 миллион доллары бар адам бар ма?
Dialogue: 0,0:02:06.25,0:02:09.37,Default,,0,0,0,,Ей, анау сақалды қария кім?
Dialogue: 0,0:02:09.46,0:02:10.71,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:02:10.79,0:02:13.21,Default,,0,0,0,,Ойын 200 миллионнан басталады.
Dialogue: 0,0:02:13.29,0:02:14.17,Default,,0,0,0,,Иә...
Dialogue: 0,0:02:14.25,0:02:15.76,Default,,0,0,0,,- (Джирокичи) 200 миллион доллар - (көмекші/бай) Иә?
Dialogue: 0,0:02:15.84,0:02:17.34,Default,,0,0,0,,- (Еркек) Сузуки осында - (Еркек) Шынайысың ба?
Dialogue: 0,0:02:17.34,0:02:18.22,Default,,0,0,0,,- (Еркек) Сузуки осында - (Еркек) Шынайысың ба?
Dialogue: 0,0:02:17.34,0:02:18.22,Default,,0,0,0,,Иә! 200 миллион доллар
Dialogue: 0,0:02:18.22,0:02:18.72,Default,,0,0,0,,Иә! 200 миллион доллар
Dialogue: 0,0:02:18.80,0:02:21.55,Default,,0,0,0,,Қате естімесем.
Dialogue: 0,0:02:21.64,0:02:24.51,Default,,0,0,0,,705 саны 200 миллион доллар тұрады...
Dialogue: 0,0:02:25.14,0:02:27.10,Default,,0,0,0,,Әй, ол әйгілі Сузуки мырза...
Dialogue: 0,0:02:27.10,0:02:28.98,Default,,0,0,0,,Әй, ол әйгілі Сузуки мырза...
Dialogue: 0,0:02:27.10,0:02:28.98,Default,,0,0,0,,Бұл мүлде ақау…
Dialogue: 0,0:02:28.98,0:02:29.52,Default,,0,0,0,,Әй, ол әйгілі Сузуки мырза...
Dialogue: 0,0:02:30.23,0:02:32.27,Default,,0,0,0,,О, онлайн қолдау әлі жеткен жоқ.
Dialogue: 0,0:02:32.36,0:02:35.19,Default,,0,0,0,,Әй, аға, бәрі артқа қарай тартып жатыр.
Dialogue: 0,0:02:35.28,0:02:38.19,Default,,0,0,0,,Мен сауда жасағанда уақытымды алмаймын.
Dialogue: 0,0:02:38.28,0:02:40.95,Default,,0,0,0,,C... Шоппинг... Эй...
Dialogue: 0,0:02:41.03,0:02:41.91,Default,,0,0,0,,Ах
Dialogue: 0,0:02:41.99,0:02:44.28,Default,,0,0,0,,Интернетті күтудің қажеті жоқ, т.б.
Dialogue: 0,0:02:44.37,0:02:46.41,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,0:02:47.04,0:02:48.08,Default,,0,0,0,,Иә
Dialogue: 0,0:02:49.16,0:02:50.37,Default,,0,0,0,,300 миллион доллар
Dialogue: 0,0:02:50.46,0:02:52.29,Default,,0,0,0,,Иә! Ах...
Dialogue: 0,0:02:52.38,0:02:54.54,Default,,0,0,0,,300 миллион доллар!
Dialogue: 0,0:02:55.55,0:02:57.42,Default,,0,0,0,,Ха... Балға бағасы!
Dialogue: 0,0:02:57.51,0:02:58.76,Default,,0,0,0,,Балға бағасы!
Dialogue: 0,0:02:58.84,0:02:59.72,Default,,0,0,0,,300 миллион долларға сәтті өтінім!
Dialogue: 0,0:02:59.72,0:03:01.43,Default,,0,0,0,,300 миллион долларға сәтті өтінім!
Dialogue: 0,0:02:59.72,0:03:01.43,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:03:02.64,0:03:03.60,Default,,0,0,0,,(Жаңалық аудиосы)
Dialogue: 0,0:03:03.60,0:03:05.47,Default,,0,0,0,,(Жаңалық аудиосы)
Dialogue: 0,0:03:03.60,0:03:05.47,Default,,0,0,0,,Конан-кун, басталып жатыр!
Dialogue: 0,0:03:05.56,0:03:07.47,Default,,0,0,0,,-Ах-(Аюми) Тез, тез!
Dialogue: 0,0:03:08.18,0:03:09.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:09.14,0:03:10.77,Default,,0,0,0,,Бұл жолы не істедің?
Dialogue: 0,0:03:10.85,0:03:12.85,Default,,0,0,0,,Бұл робот болуы мүмкін бе?
Dialogue: 0,0:03:12.94,0:03:14.56,Default,,0,0,0,,Тез қозғалыңыз, доктор.
Dialogue: 0,0:03:14.65,0:03:16.36,Default,,0,0,0,,Рахмет, мұғалім.
Dialogue: 0,0:03:16.44,0:03:17.53,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:03:17.61,0:03:19.99,Default,,0,0,0,,Неліктен бұл жұмыс соңғы уақытқа дейін созылды?
Dialogue: 0,0:03:20.07,0:03:22.41,Default,,0,0,0,,Күнді ешқашан көрмеді ме?
Dialogue: 0,0:03:22.49,0:03:24.12,Default,,0,0,0,,Мына сурет.
Dialogue: 0,0:03:24.20,0:03:27.29,Default,,0,0,0,,Себебі ол Екінші дүниежүзілік соғыс кезінде өрттен жойылды делінеді.
Dialogue: 0,0:03:27.37,0:03:31.66,Default,,0,0,0,,Өртеніп кетті ме? Демек, бұл жолғы жұмыс жалған...
Dialogue: 0,0:03:31.75,0:03:32.62,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:32.71,0:03:34.63,Default,,0,0,0,,Маған бұлай айта берді.
Dialogue: 0,0:03:34.71,0:03:36.46,Default,,0,0,0,,Мына жерден қараңыз
Dialogue: 0,0:03:36.54,0:03:38.17,Default,,0,0,0,,Өткен жылдың жаңалықтары
Dialogue: 0,0:03:38.25,0:03:41.42,Default,,0,0,0,,Ван Гогтың суреті деп болжанған картина Францияның Арлес қаласында табылды.
Dialogue: 0,0:03:41.51,0:03:42.84,Default,,0,0,0,,Жаңадан ашылған
Dialogue: 0,0:03:42.93,0:03:44.09,Default,,0,0,0,,(Аояма) Тағылымдамада болған екеуі…
Dialogue: 0,0:03:44.18,0:03:47.51,Default,,0,0,0,,Бұл ескі жеке үйдің шатырынан табылған кезде қызу талқыға түсті.
Dialogue: 0,0:03:47.60,0:03:48.68,Default,,0,0,0,,Иә, солай.
Dialogue: 0,0:03:48.77,0:03:50.56,Default,,0,0,0,,Бұл осы жолғы екінші сурет «Күнбағыс».
Dialogue: 0,0:03:50.64,0:03:52.02,Default,,0,0,0,,Ей, бастайық
Dialogue: 0,0:03:52.10,0:03:55.27,Default,,0,0,0,,（）
Dialogue: 0,0:03:55.36,0:03:57.44,Default,,0,0,0,,Мен ең үлкенін әкелдім.
Dialogue: 0,0:04:00.65,0:04:02.45,Default,,0,0,0,,Осыны басыңыз...
Dialogue: 0,0:04:02.53,0:04:03.70,Default,,0,0,0,,Хаха
Dialogue: 0,0:04:03.78,0:04:05.20,Default,,0,0,0,,Унаджу шыға ма?
Dialogue: 0,0:04:05.28,0:04:07.58,Default,,0,0,0,,Жоқ, әрине бұл мүмкін емес.
Dialogue: 0,0:04:07.66,0:04:08.08,Default,,0,0,0,,Хаха...
Dialogue: 0,0:04:08.08,0:04:09.20,Default,,0,0,0,,Хаха...
Dialogue: 0,0:04:08.08,0:04:09.20,Default,,0,0,0,,Бірақ оның жалған болу мүмкіндігі қандай?
Dialogue: 0,0:04:09.20,0:04:10.08,Default,,0,0,0,,Бірақ оның жалған болу мүмкіндігі қандай?
Dialogue: 0,0:04:10.08,0:04:11.08,Default,,0,0,0,,Бірақ оның жалған болу мүмкіндігі қандай?
Dialogue: 0,0:04:10.08,0:04:11.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:11.16,0:04:13.54,Default,,0,0,0,,Сарапшылар бұған да сақтықпен қарайды.
Dialogue: 0,0:04:13.62,0:04:16.46,Default,,0,0,0,,Біз затты аукционға қоймас бұрын егжей-тегжейлі бағалау жүргіздік.
Dialogue: 0,0:04:17.09,0:04:20.63,Default,,0,0,0,,Ван Гогтың Арлестегі басқа картиналарының нәтижелері
Dialogue: 0,0:04:20.71,0:04:22.47,Default,,0,0,0,,Дәл сол кенеп пайдаланылған екен.
Dialogue: 0,0:04:22.47,0:04:23.47,Default,,0,0,0,,Дәл осындай кенеп пайдаланылған болып шықты.
Dialogue: 0,0:04:22.47,0:04:23.47,Default,,0,0,0,,Қазіргі соққың мүлде уақытынан тыс, аянышты болды!
Dialogue: 0,0:04:23.55,0:04:25.26,Default,,0,0,0,,Унаджюдан артық не бар?
Dialogue: 0,0:04:25.34,0:04:26.59,Default,,0,0,0,,Сіз ерекше бөлікті айтасыз ба?
Dialogue: 0,0:04:26.68,0:04:28.76,Default,,0,0,0,,Жоқ, бұл неге?
Dialogue: 0,0:04:28.85,0:04:30.26,Default,,0,0,0,,Міне, міне!
Dialogue: 0,0:04:30.35,0:04:31.60,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:04:31.68,0:04:33.56,Default,,0,0,0,,- (Аюми) Иә? -(Мицухико) Бұл әлі қарбыз.
Dialogue: 0,0:04:33.64,0:04:35.02,Default,,0,0,0,,Не, тағы бір сәтсіздік?
Dialogue: 0,0:04:35.10,0:04:38.02,Default,,0,0,0,,Хехехе... Бұдан былай хехехе
Dialogue: 0,0:04:40.19,0:04:41.73,Default,,0,0,0,,Ах
Dialogue: 0,0:04:41.82,0:04:43.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:43.82,0:04:45.70,Default,,0,0,0,,Камен Яиба!
Dialogue: 0,0:04:45.78,0:04:47.53,Default,,0,0,0,,- (Мицухико) О! - (Гента) Уау!
Dialogue: 0,0:04:47.62,0:04:50.29,Default,,0,0,0,,- (Аюми) Бұл Камен Яйба! -(Гента) Керемет!
Dialogue: 0,0:04:50.37,0:04:51.66,Default,,0,0,0,,Сіз мұны қалай жасадыңыз? Бұл
Dialogue: 0,0:04:51.74,0:04:54.16,Default,,0,0,0,,Аа, сіз не істеп жатырсыз, дәрігер?
Dialogue: 0,0:04:54.25,0:04:55.87,Default,,0,0,0,,-де Ашияның «Күнбағыс».
Dialogue: 0,0:04:54.25,0:04:55.87,Default,,0,0,0,,Менің ойымша, тағы бір нәрсе жасау керек.
Dialogue: 0,0:04:55.87,0:04:55.96,Default,,0,0,0,,Менің ойымша, тағы бір нәрсе жасау керек.
Dialogue: 0,0:04:55.96,0:04:56.46,Default,,0,0,0,,Менің ойымша, тағы бір нәрсе жасау керек.
Dialogue: 0,0:04:55.96,0:04:56.46,Default,,0,0,0,,Бұл жалғандық болды ма?
Dialogue: 0,0:04:56.46,0:04:57.38,Default,,0,0,0,,Бұл жалғандық болды ма?
Dialogue: 0,0:04:57.46,0:05:00.46,Default,,0,0,0,,Иә, бұл мүмкін.
Dialogue: 0,0:05:01.46,0:05:04.17,Default,,0,0,0,,Сонымен қатар Ван Гог «Күнбағыс» суретін салған.
Dialogue: 0,0:05:04.26,0:05:07.01,Default,,0,0,0,,7 парақтың орнына 8 парақ болды деген теория да бар.
Dialogue: 0,0:05:07.09,0:05:08.80,Default,,0,0,0,,Жаңадан пайда болған
Dialogue: 0,0:05:08.89,0:05:12.10,Default,,0,0,0,,Осы жолы сатылған «Күнбағыс» және Ашиядағы «Күнбағыс»
Dialogue: 0,0:05:12.18,0:05:13.52,Default,,0,0,0,,Осылардың кез келгені
Dialogue: 0,0:05:13.60,0:05:17.15,Default,,0,0,0,,Бұл Ван Гогтың өзінің көшірмесі дейді.
Dialogue: 0,0:05:17.23,0:05:19.36,Default,,0,0,0,,Автордың өзі көшірме жасау мүмкін емес.
Dialogue: 0,0:05:19.44,0:05:20.48,Default,,0,0,0,,...
Dialogue: 0,0:05:20.57,0:05:23.82,Default,,0,0,0,,Иә, «Күнбағыс» жеті суреттің бірі.
Dialogue: 0,0:05:23.90,0:05:26.45,Default,,0,0,0,,Үш көшірме, барлығы
Dialogue: 0,0:05:26.53,0:05:27.32,Default,,0,0,0,,Оны Ван Гогтың өзі салған.
Dialogue: 0,0:05:27.32,0:05:29.32,Default,,0,0,0,,Оны Ван Гогтың өзі салған.
Dialogue: 0,0:05:27.32,0:05:29.32,Default,,0,0,0,,- (Хайбара) Ван Гог та жақсы, бірақ - А?
Dialogue: 0,0:05:29.41,0:05:32.74,Default,,0,0,0,,Неліктен сіз дәрігердің жұмысына қызығушылық танытпайсыз?
Dialogue: 0,0:05:32.83,0:05:34.83,Default,,0,0,0,,Өте көркем шығарма.
Dialogue: 0,0:05:32.83,0:05:34.83,Default,,0,0,0,,（３）
Dialogue: 0,0:05:34.83,0:05:34.91,Default,,0,0,0,,(3 адам күледі)
Dialogue: 0,0:05:34.91,0:05:36.79,Default,,0,0,0,,（３）
Dialogue: 0,0:05:34.91,0:05:36.79,Default,,0,0,0,,...
Dialogue: 0,0:05:36.87,0:05:37.75,Default,,0,0,0,,Ой! Ол бұрыштан айналып кетті!
Dialogue: 0,0:05:37.83,0:05:38.92,Default,,0,0,0,,Хаха...
Dialogue: 0,0:05:39.00,0:05:40.75,Default,,0,0,0,,Баспасөз конференциясы басталатын сияқты.
Dialogue: 0,0:05:41.34,0:05:42.80,Default,,0,0,0,,...
Dialogue: 0,0:05:42.88,0:05:45.05,Default,,0,0,0,,Нью-Йорктен тікелей эфирді көріңіз
Dialogue: 0,0:05:45.72,0:05:48.76,Default,,0,0,0,,Олай болса, сіз «Күнбағысқа» сәтті өтінім бердіңіз.
Dialogue: 0,0:05:48.84,0:05:53.39,Default,,0,0,0,,Мен Джирокичи Сузуки мырзадан түсініктеме сұрағым келеді.
Dialogue: 0,0:05:53.47,0:05:54.81,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:55.31,0:05:59.31,Default,,0,0,0,,Жоспарланғандай, сатып алу кескіндеме тарихындағы ең жоғары бағамен жасалды.
Dialogue: 0,0:05:59.40,0:06:01.65,Default,,0,0,0,,Мен табысқа жеткеніме қуаныштымын.
Dialogue: 0,0:06:01.73,0:06:04.28,Default,,0,0,0,,３
Dialogue: 0,0:06:04.36,0:06:06.24,Default,,0,0,0,,Бұл жоспарланғандай болды дегенді білдіре ме?
Dialogue: 0,0:06:06.32,0:06:08.24,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:06:08.32,0:06:09.99,Default,,0,0,0,,...
Dialogue: 0,0:06:10.07,0:06:12.99,Default,,0,0,0,,«Күнбағыс» көрмесін өткізу.
Dialogue: 0,0:06:13.08,0:06:14.45,Default,,0,0,0,,Көрме…
Dialogue: 0,0:06:14.54,0:06:17.79,Default,,0,0,0,,Біз, Сузуки Зайбатсу, дүние жүзіне шашырап кеттік.
Dialogue: 0,0:06:17.87,0:06:21.21,Default,,0,0,0,,Вазадағы композициядағы барлық «күнбағыстарды» жинаңыз.
Dialogue: 0,0:06:21.29,0:06:22.92,Default,,0,0,0,,...
Dialogue: 0,0:06:23.00,0:06:26.21,Default,,0,0,0,,«Жапонияны аңсаған күнбағыс көрмесін» өткізу
Dialogue: 0,0:06:26.30,0:06:27.47,Default,,0,0,0,,...
Dialogue: 0,0:06:27.55,0:06:28.97,Default,,0,0,0,,Мисс Сузуки
Dialogue: 0,0:06:29.05,0:06:32.14,Default,,0,0,0,,«Күнбағыс» дегеніміз не? Қанша күнбағыс бар?
Dialogue: 0,0:06:32.22,0:06:35.47,Default,,0,0,0,,«Күнбағысқа» сәтті өтінім сол жоспардың бір бөлігі болды деп айттыңыз ба?
Dialogue: 0,0:06:35.56,0:06:37.64,Default,,0,0,0,,...
Dialogue: 0,0:06:37.73,0:06:40.48,Default,,0,0,0,,Мен көрмені жариялауға келдім.
Dialogue: 0,0:06:40.56,0:06:42.31,Default,,0,0,0,,...
Dialogue: 0,0:06:42.40,0:06:45.32,Default,,0,0,0,,Бұл жолы мен ұтқан «Күнбағысты» қосқанда 7 зат бар.
Dialogue: 0,0:06:45.98,0:06:47.40,Default,,0,0,0,,７
Dialogue: 0,0:06:47.49,0:06:50.57,Default,,0,0,0,,Бұл тіпті жапон конгломераттары үшін де мүмкін емес пе?
Dialogue: 0,0:06:50.66,0:06:54.16,Default,,0,0,0,,Уайымдамаңыз, жоба қазірдің өзінде жүріп жатыр.
Dialogue: 0,0:06:54.87,0:06:57.50,Default,,0,0,0,,Біздің коллекциямызда біраз уақыттан бері «Күнбағыс» бар.
Dialogue: 0,0:06:57.58,0:06:59.75,Default,,0,0,0,,Дүние жүзіндегі мұражайларға және жеке тұлғаларға
Dialogue: 0,0:06:59.83,0:07:02.04,Default,,0,0,0,,Барлық «күнбағыстарды» жинайтын көрме
Dialogue: 0,0:07:02.13,0:07:04.25,Default,,0,0,0,,Ол іс-шараны өткізгісі келетінін мәлімдеді.
Dialogue: 0,0:07:04.34,0:07:05.46,Default,,0,0,0,,Ал бұл жолы
Dialogue: 0,0:07:05.55,0:07:08.88,Default,,0,0,0,,«Күнбағыс» аукционын ұтып алсаңыз,
Dialogue: 0,0:07:08.97,0:07:12.64,Default,,0,0,0,,Біз сіздің ынтымақтасатыныңызға кепілдік алдық.
Dialogue: 0,0:07:13.97,0:07:15.01,Default,,0,0,0,,Одан әрі
Dialogue: 0,0:07:15.10,0:07:17.77,Default,,0,0,0,,7 маман дайындаңыз
Dialogue: 0,0:07:17.85,0:07:21.69,Default,,0,0,0,,Уәде етілген тамаша сақтау, тасымалдау және қауіпсіздік
Dialogue: 0,0:07:21.77,0:07:23.52,Default,,0,0,0,,Жеті маман?
Dialogue: 0,0:07:24.11,0:07:24.98,Default,,0,0,0,,Иә
Dialogue: 0,0:07:25.06,0:07:28.86,Default,,0,0,0,,Осы күнге жинаған «жеті самурай».
Dialogue: 0,0:07:28.94,0:07:31.90,Default,,0,0,0,,және жеңіске жеткен оқушылар финалға шығады.
Dialogue: 0,0:07:34.07,0:07:36.91,Default,,0,0,0,,Бұл жеті самурай ма?
Dialogue: 0,0:07:36.99,0:07:40.66,Default,,0,0,0,,Қош бол, олар Ван Гогпен байланысты жерлер.
Dialogue: 0,0:07:40.75,0:07:43.62,Default,,0,0,0,,Нидерланды мен Францияда оқу тәжірибесі бар.
Dialogue: 0,0:07:43.71,0:07:44.88,Default,,0,0,0,,Тек элита
Dialogue: 0,0:07:44.96,0:07:49.21,Default,,0,0,0,,Солдан: тарихқа және картиналарды бағалауға жауапты—
Dialogue: 0,0:07:49.30,0:07:50.84,Default,,0,0,0,,Нацуми Миядай ханым
Dialogue: 0,0:07:50.92,0:07:52.68,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:07:52.76,0:07:55.14,Default,,0,0,0,,Сонымен қатар кескіндеменің білгірі.
Dialogue: 0,0:07:55.22,0:07:57.60,Default,,0,0,0,,Қалпына келтіруге, сақтауға және басқаруға жауапты —
Dialogue: 0,0:07:57.68,0:07:59.47,Default,,0,0,0,,Коджи Хигаши мырза
Dialogue: 0,0:07:59.97,0:08:03.39,Default,,0,0,0,,Келесі кезекте көрмені жоспарлауға жауапты боламын.
Dialogue: 0,0:08:03.48,0:08:05.35,Default,,0,0,0,,Кейко Андерсон ханым
Dialogue: 0,0:08:05.44,0:08:06.90,Default,,0,0,0,,Менің атым Кейко. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:08:07.57,0:08:10.61,Default,,0,0,0,,Суреттерді тасымалдау Оларды тасымалдауға нұсқау беру—
Dialogue: 0,0:08:10.69,0:08:12.20,Default,,0,0,0,,Тайзо Ишимине мырза
Dialogue: 0,0:08:12.28,0:08:13.15,Default,,0,0,0,,Бұл Ишимина.
Dialogue: 0,0:08:13.24,0:08:15.57,Default,,0,0,0,,Ал мына күнбағыс көрмесі
Dialogue: 0,0:08:15.66,0:08:18.83,Default,,0,0,0,,Көрме бағыты Кумико Киши ханым
Dialogue: 0,0:08:18.91,0:08:21.41,Default,,0,0,0,,Мен міндетті түрде көрмені сәтті өткіземін.
Dialogue: 0,0:08:22.04,0:08:24.79,Default,,0,0,0,,Соңында, қауіпсіздік қызметкері ретінде
Dialogue: 0,0:08:24.87,0:08:26.92,Default,,0,0,0,,Нью-Йорк қалалық полиция департаментінің инспекторы Чарлиге
Dialogue: 0,0:08:27.00,0:08:28.67,Default,,0,0,0,,Сізден ынтымақтастық сұраймыз.
Dialogue: 0,0:08:28.75,0:08:29.59,Default,,0,0,0,,«Күнбағыс»
Dialogue: 0,0:08:29.67,0:08:30.71,Default,,0,0,0,,Мен қорғаймын
Dialogue: 0,0:08:30.80,0:08:34.68,Default,,0,0,0,,Мм, сіз жоғарыда жеті самурай туралы айттыңыз.
Dialogue: 0,0:08:34.76,0:08:36.72,Default,,0,0,0,,Мұнда небәрі алты адам бар сияқты...
Dialogue: 0,0:08:36.80,0:08:38.85,Default,,0,0,0,,Қалған бір адам
Dialogue: 0,0:08:38.93,0:08:41.93,Default,,0,0,0,,Жапонияға келгеннен кейін қауіпсіздікті күшейтетін қызметкерлер.
Dialogue: 0,0:08:42.77,0:08:44.98,Default,,0,0,0,,Оның аты...
Dialogue: 0,0:08:45.06,0:08:46.44,Default,,0,0,0,,Бұл Когоро Моури!
Dialogue: 0,0:08:46.52,0:08:47.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:47.81,0:08:50.19,Default,,0,0,0,,Жетінші адам қария ма?
Dialogue: 0,0:08:50.27,0:08:51.78,Default,,0,0,0,,Енді, ерекшеліксіз
Dialogue: 0,0:08:51.86,0:08:54.24,Default,,0,0,0,,Кидкиллер сізбен бірге келе жатқандықтан емес пе?
Dialogue: 0,0:08:54.32,0:08:56.45,Default,,0,0,0,,- Иә? - (Хайбара) Сәттілік, Кикучио-сан.
Dialogue: 0,0:08:56.53,0:08:57.70,Default,,0,0,0,,- (Аюми) О, керемет! -(2 адам) Ах.
Dialogue: 0,0:08:57.78,0:09:00.87,Default,,0,0,0,,Соноконың әпкесі теледидарда!
Dialogue: 0,0:09:00.95,0:09:01.99,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:09:02.08,0:09:04.00,Default,,0,0,0,,Ой, көрейік, көрейік!
Dialogue: 0,0:09:04.08,0:09:05.41,Default,,0,0,0,,Хаха иә!
Dialogue: 0,0:09:05.50,0:09:08.08,Default,,0,0,0,,Барлық 7 бөлік жиналмаса да
Dialogue: 0,0:09:08.17,0:09:11.25,Default,,0,0,0,,Мен ұтып алған ``күнбағысты'' көрсете аламын ба?
Dialogue: 0,0:09:11.34,0:09:14.84,Default,,0,0,0,,Жоқ, менде 7 дана болмаса, мен мұны ешқашан жасамаймын.
Dialogue: 0,0:09:14.92,0:09:17.22,Default,,0,0,0,,- (Модератор) Бірақ содан кейін... - (Джирокичи) Уайымдама.
Dialogue: 0,0:09:17.30,0:09:20.26,Default,,0,0,0,,Күнбағыс көрмесі менің көптен бергі арманым еді.
Dialogue: 0,0:09:20.35,0:09:23.14,Default,,0,0,0,,Ал менің орындалмайтын арманым жоқ!
Dialogue: 0,0:09:23.14,0:09:24.48,Default,,0,0,0,,Ал менің орындалмайтын арманым жоқ!
Dialogue: 0,0:09:23.14,0:09:24.48,Default,,0,0,0,,Фу…
Dialogue: 0,0:09:24.56,0:09:26.39,Default,,0,0,0,,Аха-ха-ха-ха-ха!
Dialogue: 0,0:09:27.81,0:09:29.81,Default,,0,0,0,,- (Барлығы) Ах! - (Соноко) О... Мен бұған сенбеймін...
Dialogue: 0,0:09:29.90,0:09:31.32,Default,,0,0,0,,- (Джирокичи) Бала картасы - (Соноко) Ахаха
Dialogue: 0,0:09:31.40,0:09:33.03,Default,,0,0,0,,(Барлығы күңкілдейді)
Dialogue: 0,0:09:33.11,0:09:34.32,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:09:34.40,0:09:35.70,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:35.78,0:09:37.28,Default,,0,0,0,,-(Еркек) Менде мылтық бар -(Әйел) Эй!
Dialogue: 0,0:09:37.36,0:09:38.32,Default,,0,0,0,,Күзетшіні шақырыңыз!
Dialogue: 0,0:09:38.41,0:09:41.33,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:09:42.08,0:09:42.91,Default,,0,0,0,,Бұл жігітті шын мәнінде өлтіру керек.
Dialogue: 0,0:09:43.49,0:09:46.33,Default,,0,0,0,,Мені естімедің бе? Мылтықты тез тастаңыз
Dialogue: 0,0:09:46.41,0:09:47.79,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:09:52.25,0:09:54.01,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,0:09:55.92,0:09:56.30,Default,,0,0,0,,О, өтетін жерде
Dialogue: 0,0:09:56.30,0:09:56.97,Default,,0,0,0,,Ал, өтетін жерде.
Dialogue: 0,0:09:56.30,0:09:56.97,Default,,0,0,0,,-Болмайды - (балалар) А?
Dialogue: 0,0:09:56.97,0:09:57.05,Default,,0,0,0,,-Болмайды - (балалар) А?
Dialogue: 0,0:09:57.05,0:09:57.93,Default,,0,0,0,,-Болмайды - (балалар) А?
Dialogue: 0,0:09:57.05,0:09:57.93,Default,,0,0,0,,Мәселе болған сияқты.
Dialogue: 0,0:09:58.01,0:09:59.47,Default,,0,0,0,,Не, мен оны көрмеймін.
Dialogue: 0,0:09:59.55,0:10:01.10,Default,,0,0,0,,Бірдеңе болған сияқты.
Dialogue: 0,0:10:01.18,0:10:02.22,Default,,0,0,0,,- (Аюми) Иә? - Ха.
Dialogue: 0,0:10:02.31,0:10:03.81,Default,,0,0,0,,- (Чарли) - (Джирокичи) Нуо
Dialogue: 0,0:10:03.89,0:10:05.81,Default,,0,0,0,,Құрметті балақай!
Dialogue: 0,0:10:05.89,0:10:08.23,Default,,0,0,0,,Егер біз оларды тоқтатпасақ, олар сол темір кесекке сәбіз жегізуге тырысады.
Dialogue: 0,0:10:10.81,0:10:13.44,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,0:10:17.61,0:10:18.53,Default,,0,0,0,,Уау
Dialogue: 0,0:10:19.07,0:10:19.95,Default,,0,0,0,,Уф
Dialogue: 0,0:10:20.41,0:10:21.37,Default,,0,0,0,,Бала!
Dialogue: 0,0:10:22.62,0:10:24.37,Default,,0,0,0,,- (Күзетші) Нуах - (Күзетші) Уф
Dialogue: 0,0:10:24.45,0:10:25.79,Default,,0,0,0,,Тоқта! Тоқтатпасаң атып тастаймын!
Dialogue: 0,0:10:25.87,0:10:27.75,Default,,0,0,0,,- (Күзетші) Уф - (Офицер) Ах!
Dialogue: 0,0:10:30.04,0:10:30.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:32.84,0:10:33.84,Default,,0,0,0,,- (Әйел) Кя! -(Ер) Не?
Dialogue: 0,0:10:33.92,0:10:35.55,Default,,0,0,0,,- (Әйел) Кя! -(Еркек) Ой!
Dialogue: 0,0:10:37.63,0:10:39.01,Default,,0,0,0,,О? Сіздер әлдеқашан бастадыңыздар ма? Әңгіме
Dialogue: 0,0:10:39.09,0:10:40.51,Default,,0,0,0,,Қозғалсаң, атып тастаймын!
Dialogue: 0,0:10:42.09,0:10:42.80,Default,,0,0,0,,Мен… біраз ойланып алайын.
Dialogue: 0,0:10:42.80,0:10:45.47,Default,,0,0,0,,Мен… біраз ойланып алайын.
Dialogue: 0,0:10:42.80,0:10:45.47,Default,,0,0,0,,103-қабаттың шығыс дәлізіндегі бұрышты бала.
Dialogue: 0,0:10:48.93,0:10:50.39,Default,,0,0,0,,- (Чарли) Бала! -Аа...
Dialogue: 0,0:10:50.48,0:10:52.23,Default,,0,0,0,,Мылтығыңызды лақтырыңыз, тез!
Dialogue: 0,0:10:53.86,0:10:57.74,Default,,0,0,0,,Жарайды, келесіде, қолдарыңызды жайлап көтеріп, орынға тізерлеп отырыңыз.
Dialogue: 0,0:10:57.82,0:10:59.61,Default,,0,0,0,,...
Dialogue: 0,0:10:59.70,0:11:01.24,Default,,0,0,0,,Қолдарыңызды көрінетін жерге көтеріңіз.
Dialogue: 0,0:11:01.32,0:11:03.70,Default,,0,0,0,,(Джирокичидің ауыр тыныс алуы)
Dialogue: 0,0:11:03.78,0:11:06.24,Default,,0,0,0,,- (Соноко) Құрметті балақай! -(Чарли) Жарайды, солай.
Dialogue: 0,0:11:06.33,0:11:08.25,Default,,0,0,0,,Баяу және солай
Dialogue: 0,0:11:08.33,0:11:09.50,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:16.13,0:11:18.34,Default,,0,0,0,,Енді біз сіздерге ұсынатынымыз — «Батырлық романсы».
Dialogue: 0,0:11:18.42,0:11:19.84,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:11:19.92,0:11:21.47,Default,,0,0,0,,Тоқта, Чарли (әйнек сынған дыбыс)
Dialogue: 0,0:11:29.56,0:11:31.56,Default,,0,0,0,,Қарғыс атсын саған Кайто Бала.
Dialogue: 0,0:11:31.64,0:11:33.06,Default,,0,0,0,,Сіз қашып үлгерген сияқтысыз.
Dialogue: 0,0:11:33.15,0:11:34.73,Default,,0,0,0,,Оқиға орнында шу болды.
Dialogue: 0,0:11:34.81,0:11:36.57,Default,,0,0,0,,Зардап шеккендер жоқ...
Dialogue: 0,0:11:36.65,0:11:38.90,Default,,0,0,0,,Иә? Қазірдің өзінде бітті ме?
Dialogue: 0,0:11:38.98,0:11:41.49,Default,,0,0,0,,Бала «Күнбағысты» ұрлады ма?
Dialogue: 0,0:11:41.57,0:11:42.95,Default,,0,0,0,,Ол өзінің жеке заттарына және жазған жазбаларына от қойып, өзін-өзі өртеді
Dialogue: 0,0:11:43.03,0:11:46.20,Default,,0,0,0,,Бала тек зергерлік бұйымдарды көздеу керек, бірақ...
Dialogue: 0,0:11:46.95,0:11:49.12,Default,,0,0,0,,Мен оны бір сәтке ғана көре алдым
Dialogue: 0,0:11:49.62,0:11:51.91,Default,,0,0,0,,Бұл шынымен Бала болды ма?
Dialogue: 0,0:11:55.75,0:11:57.59,Default,,0,0,0,,Ах... е... Әй!
Dialogue: 0,0:11:59.51,0:12:01.26,Default,,0,0,0,,- (Шиничи) Қиындыққа тап болған сияқтысың - (Джирокичи) Иә?
Dialogue: 0,0:12:01.34,0:12:03.76,Default,,0,0,0,,Неге... неге Уну мұнда?
Dialogue: 0,0:12:03.84,0:12:06.05,Default,,0,0,0,,Бала «Күнбағысты» көздеп отыр
Dialogue: 0,0:12:06.14,0:12:07.26,Default,,0,0,0,,Себебі мен оны естідім.
Dialogue: 0,0:12:08.35,0:12:09.85,Default,,0,0,0,,(Соноконың ауыр тыныс алуы)
Dialogue: 0,0:12:10.35,0:12:13.89,Default,,0,0,0,,Қаласаңыз, маған ынтымақтасуға рұқсат етіңіз.
Dialogue: 0,0:12:14.85,0:12:19.86,Default,,0,0,0,,♪～
Dialogue: 0,0:12:36.63,0:12:39.00,Default,,0,0,0,,Мен орта мектептің детективімін, Шиничи Кудо
Dialogue: 0,0:12:39.67,0:12:41.96,Default,,0,0,0,,Бала күнгі досы және сыныптасы Ран Моримен
Dialogue: 0,0:12:42.05,0:12:43.84,Default,,0,0,0,,Ойын-сауық саябағына барыңыз
Dialogue: 0,0:12:43.92,0:12:47.14,Default,,0,0,0,,Мен қара киінген адамның қатысуымен жасалған күдікті мәміленің куәсі болдым.
Dialogue: 0,0:12:47.89,0:12:50.22,Default,,0,0,0,,Мен мәмілені қарауға берілгенмін.
Dialogue: 0,0:12:50.31,0:12:52.35,Default,,0,0,0,,Артынан келе жатқан басқа серікке.
Dialogue: 0,0:12:52.43,0:12:53.98,Default,,0,0,0,,Байқамадым
Dialogue: 0,0:12:55.02,0:12:57.65,Default,,0,0,0,,Ол кісі маған у ішті.
Dialogue: 0,0:12:58.15,0:12:59.11,Default,,0,0,0,,Мен оянғанда...
Dialogue: 0,0:12:59.94,0:13:02.15,Default,,0,0,0,,Менің денем кішірейіп кетті.
Dialogue: 0,0:13:02.74,0:13:04.99,Default,,0,0,0,,Егер олар Шиничи Кудоның тірі екенін білсе ше?
Dialogue: 0,0:13:05.07,0:13:06.82,Default,,0,0,0,,Менің өміріме жасалған тағы бір әрекет
Dialogue: 0,0:13:06.91,0:13:08.37,Default,,0,0,0,,Айналаңыздағы адамдарға да қауіп төніп тұр.
Dialogue: 0,0:13:09.49,0:13:10.58,Default,,0,0,0,,Доктор Агасаның кеңесі бойынша
Dialogue: 0,0:13:10.66,0:13:12.29,Default,,0,0,0,,Мен өзімнің шынайы тұлғамды жасыруды шештім.
Dialogue: 0,0:13:12.37,0:13:14.66,Default,,0,0,0,,Ран менің атымды сұрағанда, мен бірден
Dialogue: 0,0:13:14.75,0:13:16.04,Default,,0,0,0,,Конан Эдогава деп аталады
Dialogue: 0,0:13:16.83,0:13:18.75,Default,,0,0,0,,Өз мәліметтерін алу
Dialogue: 0,0:13:18.83,0:13:22.13,Default,,0,0,0,,Ранның үйіне көшіп келді, оның әкесі детектив болып жұмыс істейді.
Dialogue: 0,0:13:23.71,0:13:27.13,Default,,0,0,0,,Айтпақшы, менің шынайы болмысымды біреу біледі.
Dialogue: 0,0:13:27.22,0:13:28.64,Default,,0,0,0,,Дәрігерден басқалары бар.
Dialogue: 0,0:13:29.43,0:13:32.72,Default,,0,0,0,,Ай Хайбара Шын есімі Шихо Мияно
Dialogue: 0,0:13:33.22,0:13:34.39,Default,,0,0,0,,Ол бастапқыда болды
Dialogue: 0,0:13:34.48,0:13:36.81,Default,,0,0,0,,Қара киінген кісілердің досы еді.
Dialogue: 0,0:13:36.89,0:13:38.48,Default,,0,0,0,,Ұйымнан қашу кезінде
Dialogue: 0,0:13:38.56,0:13:41.27,Default,,0,0,0,,Маған тағайындалған дәріні ішіңіз.
Dialogue: 0,0:13:41.36,0:13:42.90,Default,,0,0,0,,Менің денем кішірейіп кетті.
Dialogue: 0,0:13:44.24,0:13:45.82,Default,,0,0,0,,Және одан әрі…
Dialogue: 0,0:13:47.53,0:13:49.49,Default,,0,0,0,,Кайто Кид және оның көмекшілері
Dialogue: 0,0:13:50.24,0:13:52.87,Default,,0,0,0,,Олармен әлі бітімге келген жоқ.
Dialogue: 0,0:13:52.95,0:13:54.91,Default,,0,0,0,,Детектив атынан
Dialogue: 0,0:13:55.00,0:13:57.37,Default,,0,0,0,,Мен оларды осы жолы ұстаймын.
Dialogue: 0,0:13:58.33,0:14:00.04,Default,,0,0,0,,Кішірейсек те, миымыз бірдей
Dialogue: 0,0:14:00.75,0:14:02.21,Default,,0,0,0,,Лабиринті жоқ детектив
Dialogue: 0,0:14:02.29,0:14:03.13,Default,,0,0,0,,～♪
Dialogue: 0,0:14:03.13,0:14:07.22,Default,,0,0,0,,～♪ Әрқашан бір шындық бар!
Dialogue: 0,0:14:10.47,0:14:11.93,Default,,0,0,0,,(хабарландыру дыбысы)
Dialogue: 0,0:14:12.01,0:14:16.02,Default,,0,0,0,,Бұл ұшақ жақында Ханеда әуежайына қонады.
Dialogue: 0,0:14:16.64,0:14:19.48,Default,,0,0,0,,Жүкті отырғызуға дайындық
Dialogue: 0,0:14:19.56,0:14:20.98,Default,,0,0,0,,Ұшу кезіндегідей
Dialogue: 0,0:14:21.06,0:14:24.94,Default,,0,0,0,,Оны жоғарғы сөреге немесе орындықтың астына қойыңыз.
Dialogue: 0,0:14:25.53,0:14:27.44,Default,,0,0,0,,Бұл біз тауып алған қуыршақ.
Dialogue: 0,0:14:27.53,0:14:30.99,Default,,0,0,0,,- (Джирокичи) Хахахахаха... - (Чарли) Бақытты көрінеді.
Dialogue: 0,0:14:31.07,0:14:33.12,Default,,0,0,0,,Ағайдың өзі де үнемі алданып қалады.
Dialogue: 0,0:14:33.20,0:14:34.99,Default,,0,0,0,,Мен достарым барына қуаныштымын.
Dialogue: 0,0:14:35.08,0:14:36.37,Default,,0,0,0,,Нуу…
Dialogue: 0,0:14:36.45,0:14:38.91,Default,,0,0,0,,Одан жақсы ма?
Dialogue: 0,0:14:39.62,0:14:42.92,Default,,0,0,0,,Төтенше жағдайларды қоспағанда, тіпті CA-ны шектедіңіз.
Dialogue: 0,0:14:43.00,0:14:45.63,Default,,0,0,0,,Бұл балаға келетін болсақ, бұл өте оңай...
Dialogue: 0,0:14:45.71,0:14:49.76,Default,,0,0,0,,О... Мысық Жапонияның жетекші детективтерінің бірі.
Dialogue: 0,0:14:49.84,0:14:51.68,Default,,0,0,0,,Уайымдаудың қажеті жоқ
Dialogue: 0,0:14:51.76,0:14:54.72,Default,,0,0,0,,Бірақ егер бұл балалардың маскасы болса...
Dialogue: 0,0:14:54.81,0:14:56.52,Default,,0,0,0,,Олардың дене бітімі ұқсас сияқты...
Dialogue: 0,0:14:56.60,0:14:59.18,Default,,0,0,0,,Аа, сен уайымдап тұрсың.
Dialogue: 0,0:14:59.89,0:15:01.90,Default,,0,0,0,,Мұқият қараңыз
Dialogue: 0,0:15:03.31,0:15:05.19,Default,,0,0,0,,- (Шиничи) Идедеде... - (Джирокичи) Мынау сияқты.
Dialogue: 0,0:15:05.27,0:15:07.48,Default,,0,0,0,,Не істеп жатырсың, қария?
Dialogue: 0,0:15:07.57,0:15:09.86,Default,,0,0,0,,Чарли күдіктенді.
Dialogue: 0,0:15:09.95,0:15:11.91,Default,,0,0,0,,Жалпы айтқанда, неге бұл американдық
Dialogue: 0,0:15:11.99,0:15:13.24,Default,,0,0,0,,Мен осы ұшақтамын.
Dialogue: 0,0:15:13.32,0:15:16.79,Default,,0,0,0,,Сізді және Химавариді әуежайға дейін шығарып салады, солай ма?
Dialogue: 0,0:15:16.87,0:15:18.91,Default,,0,0,0,,Жапонияға келудің қажеті жоқ.
Dialogue: 0,0:15:19.00,0:15:22.71,Default,,0,0,0,,Келісімшартта Америкада эскорт боламын деп жазылғаны рас.
Dialogue: 0,0:15:22.79,0:15:26.55,Default,,0,0,0,,Бірақ қазір біз Баланың «Күнбағысты» нысанаға алғанын білеміз.
Dialogue: 0,0:15:26.63,0:15:28.17,Default,,0,0,0,,Мен оны жалғыз қалдыра алмаймын
Dialogue: 0,0:15:28.26,0:15:31.63,Default,,0,0,0,,О, сондықтан мен таңдаған самурайсың.
Dialogue: 0,0:15:31.72,0:15:33.97,Default,,0,0,0,,«Күнбағысты» қорғауды ұмытпаңыз
Dialogue: 0,0:15:34.05,0:15:35.14,Default,,0,0,0,,Иә, оны маған қалдырыңыз.
Dialogue: 0,0:15:35.89,0:15:38.39,Default,,0,0,0,,Енді Kidkiller қосылса
Dialogue: 0,0:15:38.47,0:15:40.73,Default,,0,0,0,,Бұл шайтанның ақшасы уахахахаха
Dialogue: 0,0:15:40.81,0:15:43.27,Default,,0,0,0,,Иә? Нацуми-сан, жақсысың ба?
Dialogue: 0,0:15:43.35,0:15:46.19,Default,,0,0,0,,А... Иә, мен аздап маспын.
Dialogue: 0,0:15:46.27,0:15:48.65,Default,,0,0,0,,Онда мен сияқты ұшақты айналып өтуге болады.
Dialogue: 0,0:15:48.73,0:15:51.65,Default,,0,0,0,,Жүр, отыра берсең жақсы емес.
Dialogue: 0,0:15:51.74,0:15:53.41,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:54.20,0:15:55.53,Default,,0,0,0,,Ах, қай жолмен?
Dialogue: 0,0:15:55.62,0:15:56.91,Default,,0,0,0,,Бұл дәретхана.
Dialogue: 0,0:16:10.38,0:16:11.67,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:13.09,0:16:14.13,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:16:14.22,0:16:16.18,Default,,0,0,0,,Мен Кид мені нысанаға алуы мүмкін деп ойладым.
Dialogue: 0,0:16:16.76,0:16:19.68,Default,,0,0,0,,Оны неге сонша жарқыраған ұшақ жасадың?
Dialogue: 0,0:16:19.77,0:16:20.89,Default,,0,0,0,,Біз де полициямыз
Dialogue: 0,0:16:20.98,0:16:23.06,Default,,0,0,0,,Мен саған тым төмен болуды айттым.
Dialogue: 0,0:16:23.69,0:16:26.77,Default,,0,0,0,,Бұл жай ғана көлік емес, сонымен қатар жарнама сияқты.
Dialogue: 0,0:16:26.86,0:16:29.19,Default,,0,0,0,,Оны тоқтату сіздің міндетіңіз.
Dialogue: 0,0:16:29.27,0:16:30.36,Default,,0,0,0,,Инспектор Накамори!
Dialogue: 0,0:16:30.44,0:16:31.49,Default,,0,0,0,,Сол қария
Dialogue: 0,0:16:31.57,0:16:33.95,Default,,0,0,0,,Енді мені тыңдаймын деп ойлайсың ба?
Dialogue: 0,0:16:34.03,0:16:36.12,Default,,0,0,0,,Кешірім сұрама.
Dialogue: 0,0:16:36.20,0:16:37.37,Default,,0,0,0,,-Ух~ -(Когоро) А?
Dialogue: 0,0:16:37.45,0:16:40.04,Default,,0,0,0,,Сіз мұны үйге мініп бара жатырсыз, солай емес пе?
Dialogue: 0,0:16:40.12,0:16:42.37,Default,,0,0,0,,«Химавари» де осы жазықтықта ма?
Dialogue: 0,0:16:42.45,0:16:46.38,Default,,0,0,0,,...Неге артыма еріп жүрсің?
Dialogue: 0,0:16:46.46,0:16:47.75,Default,,0,0,0,,Ештеңе істей алмаймыз, иә?
Dialogue: 0,0:16:47.84,0:16:50.75,Default,,0,0,0,,Джирокичи-сан Конан-кун бізбен бірге келуі керек деді.
Dialogue: 0,0:16:50.84,0:16:52.76,Default,,0,0,0,,- (Жүгіріп) Эй - Уф... Иә.
Dialogue: 0,0:16:52.84,0:16:55.43,Default,,0,0,0,,Конан-кун – балаларды өлтіруші.
Dialogue: 0,0:16:55.51,0:16:58.55,Default,,0,0,0,,...Бұл өте қоқыс.
Dialogue: 0,0:16:58.64,0:16:59.76,Default,,0,0,0,,Қаңғыма!
Dialogue: 0,0:16:59.85,0:17:01.10,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:17:01.18,0:17:03.39,Default,,0,0,0,,Сіз қосымша ақшаға тұрарлықсыз.
Dialogue: 0,0:17:03.48,0:17:04.98,Default,,0,0,0,,-Иә - (Когоро) Жүгіріп кетті!
Dialogue: 0,0:17:05.06,0:17:07.27,Default,,0,0,0,,Мына баланы мұқият қадағалаңыз!
Dialogue: 0,0:17:07.35,0:17:08.98,Default,,0,0,0,,Иә, бұл әрқашан менің ниетім.
Dialogue: 0,0:17:09.06,0:17:10.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:13.61,0:17:16.03,Default,,0,0,0,,- (Жүгіріп) Бұл кім? Кешіріңіз. - (Когоро) А...
Dialogue: 0,0:17:16.66,0:17:17.99,Default,,0,0,0,,А, Соноко?
Dialogue: 0,0:17:18.07,0:17:19.66,Default,,0,0,0,,О, Ран?
Dialogue: 0,0:17:19.74,0:17:21.58,Default,,0,0,0,,Біз қонғалы жатырмыз.
Dialogue: 0,0:17:21.66,0:17:24.00,Default,,0,0,0,,Бұған дейін мен саған жақсы нәрсе айтқым келді.
Dialogue: 0,0:17:24.87,0:17:26.50,Default,,0,0,0,,Себебі мен сізді таң қалдырғым келеді.
Dialogue: 0,0:17:26.58,0:17:29.59,Default,,0,0,0,,Маған үндемеу керектігін айтты.
Dialogue: 0,0:17:29.67,0:17:31.46,Default,,0,0,0,,Иә... Иә...
Dialogue: 0,0:17:31.55,0:17:33.09,Default,,0,0,0,,Не, Шиничи сенімен бірге ме?
Dialogue: 0,0:17:35.42,0:17:39.26,Default,,0,0,0,,Бол... Тек Шиничи ұшақта болғандықтан, мен...
Dialogue: 0,0:17:39.34,0:17:40.39,Default,,0,0,0,,- (Жүгіріп) Ах - Соноко-ни-чан!
Dialogue: 0,0:17:40.47,0:17:41.93,Default,,0,0,0,,Шиничи-чан сонда ма?
Dialogue: 0,0:17:42.01,0:17:44.89,Default,,0,0,0,,А... Осы уақытқа дейін отырдым...
Dialogue: 0,0:17:55.11,0:17:55.99,Default,,0,0,0,,Иә
Dialogue: 0,0:17:56.07,0:17:57.11,Default,,0,0,0,,(жұмыс дыбысы)
Dialogue: 0,0:17:57.70,0:17:59.03,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:18:02.28,0:18:04.45,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:18:04.54,0:18:05.83,Default,,0,0,0,,(Барлығы айқайлайды)
Dialogue: 0,0:18:05.91,0:18:07.00,Default,,0,0,0,,Ахх...
Dialogue: 0,0:18:07.08,0:18:08.75,Default,,0,0,0,,- Кя! -(Ишимин) Уф
Dialogue: 0,0:18:08.83,0:18:10.46,Default,,0,0,0,,- (Чарли) Арх! -(Соноко) Кя!
Dialogue: 0,0:18:11.71,0:18:13.96,Default,,0,0,0,,Соноко, не болды? Соноко!
Dialogue: 0,0:18:14.05,0:18:15.01,Default,,0,0,0,,Не болды, Ран!
Dialogue: 0,0:18:15.09,0:18:16.01,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:18:16.09,0:18:18.26,Default,,0,0,0,,Айқай ести сала қатты шу шықты...
Dialogue: 0,0:18:18.84,0:18:19.84,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:18:19.93,0:18:20.84,Default,,0,0,0,,Инспектор Накамори, келіңіз!
Dialogue: 0,0:18:20.93,0:18:23.01,Default,,0,0,0,,Ұшақта бірдеңе болған сияқты.
Dialogue: 0,0:18:23.10,0:18:24.31,Default,,0,0,0,,Не? мұнда
Dialogue: 0,0:18:24.39,0:18:24.77,Default,,0,0,0,,Мұндай есеп келмейді.
Dialogue: 0,0:18:24.77,0:18:26.85,Default,,0,0,0,,Мұндай есеп келмейді.
Dialogue: 0,0:18:24.77,0:18:26.85,Default,,0,0,0,,Мен Баланы күтпедім...
Dialogue: 0,0:18:26.93,0:18:28.48,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:18:28.56,0:18:30.40,Default,,0,0,0,,Әлі де жақсы емес
Dialogue: 0,0:18:30.48,0:18:33.82,Default,,0,0,0,,Оң қанаттың элероны да, тақтайшасы да жауап бермейді
Dialogue: 0,0:18:33.90,0:18:36.69,Default,,0,0,0,,Бұл жеткілікті. 4-ші қозғалтқышты дереу тоқтатыңыз!
Dialogue: 0,0:18:36.78,0:18:38.36,Default,,0,0,0,,- (Капитан) Өртті сөндір! -(Вице-капитан) Иә!
Dialogue: 0,0:18:53.71,0:18:55.30,Default,,0,0,0,,Дегенмен, заттары көп екен.
Dialogue: 0,0:18:57.76,0:18:58.80,Default,,0,0,0,,Иә? Адамдар?
Dialogue: 0,0:19:04.68,0:19:07.64,Default,,0,0,0,,Бұл басқару мұнарасы, рейс 2501. Түсінікті.
Dialogue: 0,0:19:07.72,0:19:09.81,Default,,0,0,0,,Ашық ұшу-қону жолағы. Біз сонда бара аламыз ба?
Dialogue: 0,0:19:09.89,0:19:12.31,Default,,0,0,0,,2501 рейсі үшін осы жерді басыңыз Көріп көріңіз
Dialogue: 0,0:19:12.40,0:19:14.36,Default,,0,0,0,,Қауіпсіздікті сақтау үшін жақын жердегі барлық ұшақтарды алып тастаңыз!
Dialogue: 0,0:19:14.44,0:19:15.86,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:19:15.94,0:19:18.61,Default,,0,0,0,,Барлық рейстерге Жанармай тексерілгеннен кейін шұғыл кету туралы хабарлаңыз!
Dialogue: 0,0:19:18.69,0:19:19.53,Default,,0,0,0,,Иә
Dialogue: 0,0:19:19.61,0:19:22.28,Default,,0,0,0,,- (Контроллер) Тезірек, уақытымыз жоқ - (Контроллер) Иә!
Dialogue: 0,0:19:22.36,0:19:23.91,Default,,0,0,0,,- (контроллер) Барлық ұшақтарға айтыңыз... - (контроллер) Тәтті...
Dialogue: 0,0:19:24.49,0:19:26.58,Default,,0,0,0,,Әуежайға бара алсаңыз да
Dialogue: 0,0:19:26.66,0:19:29.04,Default,,0,0,0,,Қазіргі биіктікте біз ұшу-қону жолағынан өтеміз...
Dialogue: 0,0:19:29.12,0:19:31.54,Default,,0,0,0,,Жақсы істе
Dialogue: 0,0:19:35.34,0:19:38.46,Default,,0,0,0,,Құрметті жолаушылар, бұл ұшақтың қозғалтқышында ақау бар деген диагноз қойылды.
Dialogue: 0,0:19:38.55,0:19:41.47,Default,,0,0,0,,Біз енді шұғыл қонуға мүмкіндік беретін биіктікке түсеміз.
Dialogue: 0,0:19:42.05,0:19:45.97,Default,,0,0,0,,Қауіпсіздік белдігінің босамағанын тағы бір рет тексеріңіз.
Dialogue: 0,0:19:54.81,0:19:56.40,Default,,0,0,0,,Дегенмен, заттары көп екен.
Dialogue: 0,0:19:56.48,0:19:57.82,Default,,0,0,0,,Физикалық түрде ондай үстел жоқ.
Dialogue: 0,0:20:02.40,0:20:03.70,Default,,0,0,0,,15 000!
Dialogue: 0,0:20:02.40,0:20:03.70,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:20:03.70,0:20:04.20,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:20:04.20,0:20:05.74,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:20:04.20,0:20:05.74,Default,,0,0,0,,10 000 фут
Dialogue: 0,0:20:05.74,0:20:06.62,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:20:06.70,0:20:07.87,Default,,0,0,0,,Жақсы! Хмм
Dialogue: 0,0:20:12.41,0:20:14.33,Default,,0,0,0,,Дөңгелек…
Dialogue: 0,0:20:14.42,0:20:15.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:17.21,0:20:18.88,Default,,0,0,0,,Уф... уф
Dialogue: 0,0:20:20.88,0:20:22.13,Default,,0,0,0,,Уф
Dialogue: 0,0:20:27.39,0:20:30.60,Default,,0,0,0,,Иә! Ки... Бала-сама?
Dialogue: 0,0:20:32.68,0:20:33.56,Default,,0,0,0,,Иә
Dialogue: 0,0:20:33.64,0:20:35.69,Default,,0,0,0,,Нану? Бала?
Dialogue: 0,0:20:35.77,0:20:37.06,Default,,0,0,0,,Қайда! қайдасың
Dialogue: 0,0:20:37.15,0:20:38.48,Default,,0,0,0,,Бала қайда?
Dialogue: 0,0:20:38.48,0:20:39.36,Default,,0,0,0,,Бала қайда?
Dialogue: 0,0:20:38.48,0:20:39.36,Default,,0,0,0,,Бала?
Dialogue: 0,0:20:39.44,0:20:40.44,Default,,0,0,0,,Ол пайда болды ма?
Dialogue: 0,0:20:40.53,0:20:42.15,Default,,0,0,0,,Сәлеметсіз бе? сәлем?
Dialogue: 0,0:20:42.24,0:20:43.86,Default,,0,0,0,,Бұл қиын! Инспектор Накамори
Dialogue: 0,0:20:43.95,0:20:45.70,Default,,0,0,0,,Ұшақта біраз ақау болған сияқты...
Dialogue: 0,0:20:46.28,0:20:49.16,Default,,0,0,0,,Бізге А ұшу-қону жолағына шұғыл қонатындығымыз айтылды.
Dialogue: 0,0:20:49.24,0:20:50.58,Default,,0,0,0,,Төтенше қону туралы не деуге болады? Не болды?
Dialogue: 0,0:20:50.58,0:20:52.16,Default,,0,0,0,,Төтенше қону туралы не деуге болады? Не болды?
Dialogue: 0,0:20:50.58,0:20:52.16,Default,,0,0,0,,Шүкір, мен оны бұл жерден көре алмаймын!
Dialogue: 0,0:20:52.25,0:20:54.62,Default,,0,0,0,,- (Когоро) Баланың жұмысы ма? - (Жүгіріп) А, Конан-кун.
Dialogue: 0,0:20:55.96,0:20:57.63,Default,,0,0,0,,Соноко, жауап бер!
Dialogue: 0,0:20:57.71,0:20:59.67,Default,,0,0,0,,Соноко!
Dialogue: 0,0:21:00.21,0:21:01.38,Default,,0,0,0,,Ағай, тоқтатыңыз!
Dialogue: 0,0:21:01.46,0:21:03.38,Default,,0,0,0,,Күте тұрыңыз, кеңесші Сузуки!
Dialogue: 0,0:21:03.47,0:21:05.05,Default,,0,0,0,,Қазір қозғалу қауіпті.
Dialogue: 0,0:21:05.13,0:21:07.22,Default,,0,0,0,,Джага Кидтің пайда болуын білдіреді
Dialogue: 0,0:21:07.30,0:21:08.14,Default,,0,0,0,,«Күнбағыс»...
Dialogue: 0,0:21:08.22,0:21:09.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:09.39,0:21:12.06,Default,,0,0,0,,Енді ұшақ шұғыл қонады.
Dialogue: 0,0:21:12.14,0:21:14.02,Default,,0,0,0,,Өздеріңіз білетіндей, жарылыс еркін маневр жасауды мүмкін емес етеді.
Dialogue: 0,0:21:14.02,0:21:15.31,Default,,0,0,0,,Өздеріңіз білетіндей, жарылыс еркін маневр жасауды мүмкін емес етеді.
Dialogue: 0,0:21:14.02,0:21:15.31,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,0:21:15.31,0:21:15.89,Default,,0,0,0,,Өздеріңіз білетіндей, жарылыс еркін маневр жасауды мүмкін емес етеді.
Dialogue: 0,0:21:15.98,0:21:18.81,Default,,0,0,0,,Бұл қонуды өте қиындатады.
Dialogue: 0,0:21:19.61,0:21:22.69,Default,,0,0,0,,Аман-есен жетуіміз үшін дұға етіңіз.
Dialogue: 0,0:21:23.44,0:21:24.32,Default,,0,0,0,,Иә
Dialogue: 0,0:21:25.20,0:21:26.82,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:21:30.41,0:21:33.00,Default,,0,0,0,,Жарайды, келесі жолы! Асығыңыз!
Dialogue: 0,0:21:33.58,0:21:35.12,Default,,0,0,0,,Бұл жаттығу емес!
Dialogue: 0,0:21:35.21,0:21:37.33,Default,,0,0,0,,(Төтенше көлік сиренасы)
Dialogue: 0,0:21:46.47,0:21:48.01,Default,,0,0,0,,Ішек
Dialogue: 0,0:21:46.47,0:21:48.01,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:21:48.01,0:21:48.09,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:21:48.09,0:21:49.76,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:21:48.09,0:21:49.76,Default,,0,0,0,,Жоқ, ұшақ тұрақты емес.
Dialogue: 0,0:21:49.85,0:21:51.76,Default,,0,0,0,,- (Капитан) Берілмеңіз, қайталап көріңіз! -(Вице-капитан) Иә!
Dialogue: 0,0:21:51.85,0:21:53.14,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:21:53.72,0:21:56.02,Default,,0,0,0,,- (Чарли) Гуг... - (Соноко) Жүгіріп кетті! Маған көмектесіңіз...
Dialogue: 0,0:21:56.89,0:21:57.77,Default,,0,0,0,,Нуаа
Dialogue: 0,0:21:57.85,0:21:59.23,Default,,0,0,0,,Кет!
Dialogue: 0,0:21:59.31,0:22:01.73,Default,,0,0,0,,Қақпақ
Dialogue: 0,0:22:01.82,0:22:02.98,Default,,0,0,0,,А... міне, солай!
Dialogue: 0,0:22:03.48,0:22:05.03,Default,,0,0,0,,Эй, мен мұндамын!
Dialogue: 0,0:22:06.57,0:22:07.90,Default,,0,0,0,,Мен құбылмалымын.
Dialogue: 0,0:22:07.99,0:22:09.70,Default,,0,0,0,,Жоқ, бұл өте қымбат.
Dialogue: 0,0:22:10.74,0:22:12.20,Default,,0,0,0,,Бұл жаман...
Dialogue: 0,0:22:20.17,0:22:21.84,Default,,0,0,0,,Қарғыс атсын... Боқ...
Dialogue: 0,0:22:21.92,0:22:23.71,Default,,0,0,0,,Тыңдаңыз!
Dialogue: 0,0:22:31.97,0:22:34.39,Default,,0,0,0,,(барлығы ыңылдап)
Dialogue: 0,0:22:36.48,0:22:37.68,Default,,0,0,0,,Кері инъекция!
Dialogue: 0,0:22:37.77,0:22:39.39,Default,,0,0,0,,Бірақ бақылауды жоғалту қаупі бар...
Dialogue: 0,0:22:39.48,0:22:41.35,Default,,0,0,0,,Маған бәрібір! тоқтау туралы ойланыңыз
Dialogue: 0,0:22:41.44,0:22:42.90,Default,,0,0,0,,Иә! Кері инъекция!
Dialogue: 0,0:22:48.40,0:22:51.53,Default,,0,0,0,,(дөңгелектің үйкеліс шуы)
Dialogue: 0,0:22:53.62,0:22:56.37,Default,,0,0,0,,Не... не?
Dialogue: 0,0:22:58.96,0:23:00.08,Default,,0,0,0,,Халықаралық терминалда
Dialogue: 0,0:23:00.17,0:23:01.83,Default,,0,0,0,,Егер сіз тұтынушы болсаңыз...
Dialogue: 0,0:23:03.34,0:23:05.59,Default,,0,0,0,,Нашар, соқтығыстың!
Dialogue: 0,0:23:06.34,0:23:08.26,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:23:06.34,0:23:08.26,Default,,0,0,0,,Тоқта, тоқта, тоқта, тоқта!
Dialogue: 0,0:23:08.26,0:23:09.47,Default,,0,0,0,,Тоқта, тоқта, тоқта, тоқта!
Dialogue: 0,0:23:11.55,0:23:13.22,Default,,0,0,0,,Тоқтаңыз!
Dialogue: 0,0:23:21.23,0:23:22.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:23.56,0:23:24.98,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:23:25.07,0:23:26.94,Default,,0,0,0,,Шиничи! Соноко…
Dialogue: 0,0:23:28.49,0:23:31.32,Default,,0,0,0,,Бұл басқару мұнарасы, 2501-рейс, мені естисің бе?
Dialogue: 0,0:23:31.41,0:23:34.83,Default,,0,0,0,,2501 рейсі Жауап күтемін 2501 рейсі!
Dialogue: 0,0:23:35.78,0:23:37.20,Default,,0,0,0,,Мұнда 2501 рейс
Dialogue: 0,0:23:37.29,0:23:41.16,Default,,0,0,0,,Кешіріңіз, мен сіздің нұсқауларыңызды елемей, ұшу-қону жолағын рұқсатсыз өзгерттім.
Dialogue: 0,0:23:41.25,0:23:43.25,Default,,0,0,0,,Сонда сіз қауіпсізсіз бе?
Dialogue: 0,0:23:43.33,0:23:45.17,Default,,0,0,0,,Қақпамен соқтығысты болдырмау
Dialogue: 0,0:23:45.25,0:23:45.79,Default,,0,0,0,,(Барлығы қуанады)
Dialogue: 0,0:23:45.79,0:23:47.30,Default,,0,0,0,,(Барлығы қуанады)
Dialogue: 0,0:23:45.79,0:23:47.30,Default,,0,0,0,,Біз қауіпсізбіз. Жолаушылар мен экипажды дереу құтқаруды сұраңыз.
Dialogue: 0,0:23:47.30,0:23:49.46,Default,,0,0,0,,Біз қауіпсізбіз. Жолаушылар мен экипажды дереу құтқаруды сұраңыз.
Dialogue: 0,0:23:49.55,0:23:50.97,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:23:51.55,0:23:52.68,Default,,0,0,0,,Фу…
Dialogue: 0,0:23:53.26,0:23:54.64,Default,,0,0,0,,Амансың ба? бала
Dialogue: 0,0:23:54.72,0:23:56.64,Default,,0,0,0,,- Ух... иә - (Накамори) Эй, эй
Dialogue: 0,0:23:56.72,0:23:58.56,Default,,0,0,0,,Солай болса да, бұл жай ғана.
Dialogue: 0,0:23:58.64,0:24:00.98,Default,,0,0,0,,А, мен қателессем
Dialogue: 0,0:24:01.06,0:24:02.60,Default,,0,0,0,,Бұл қорқынышты болады.
Dialogue: 0,0:24:03.94,0:24:04.98,Default,,0,0,0,,Шынында да…
Dialogue: 0,0:24:05.06,0:24:07.57,Default,,0,0,0,,Бірақ Кид осындай нәрсені істейтін еді...
Dialogue: 0,0:24:07.65,0:24:10.15,Default,,0,0,0,,О, бұл не?
Dialogue: 0,0:24:11.19,0:24:12.11,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:24:14.78,0:24:15.62,Default,,0,0,0,,Бала!
Dialogue: 0,0:24:16.32,0:24:17.33,Default,,0,0,0,,Фу…
Dialogue: 0,0:24:19.91,0:24:21.37,Default,,0,0,0,,Қапы, қашып кетейін!
Dialogue: 0,0:24:21.96,0:24:23.46,Default,,0,0,0,,Әй, балақай! Қайда?
Dialogue: 0,0:24:23.54,0:24:25.25,Default,,0,0,0,,Бала «Күнбағыспен» ұшып келеді!
Dialogue: 0,0:24:25.33,0:24:26.59,Default,,0,0,0,,- (Накамори) Не? - (Когоро) Шынымен бе?
Dialogue: 0,0:24:26.67,0:24:28.59,Default,,0,0,0,,(Ранның қатты тыныс алуы)
Dialogue: 0,0:24:28.67,0:24:30.38,Default,,0,0,0,,Шиничи… Соноко…
Dialogue: 0,0:24:30.46,0:24:31.76,Default,,0,0,0,,Ах
Dialogue: 0,0:24:35.01,0:24:37.68,Default,,0,0,0,,Соноко! Сенімен бәрі жақсы ма? қазір қайдасың?
Dialogue: 0,0:24:37.76,0:24:40.85,Default,,0,0,0,,Сабыр ет, жүгір, менде бәрі жақсы болады.
Dialogue: 0,0:24:40.93,0:24:41.85,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:24:41.93,0:24:45.15,Default,,0,0,0,,Оның үстіне Кудо-куннан естідің бе?
Dialogue: 0,0:24:45.23,0:24:48.36,Default,,0,0,0,,Не? Шиничиден бе? Бірақ әлі емес...
Dialogue: 0,0:24:48.44,0:24:50.98,Default,,0,0,0,,- (Соноко) Иә... - (Жүгіріп) Шиничи не болды?
Dialogue: 0,0:24:51.07,0:24:52.36,Default,,0,0,0,,Біз бірге емеспіз бе?
Dialogue: 0,0:24:52.44,0:24:55.24,Default,,0,0,0,,Бұл... Кудо-кунды таба алмай жатырмын.
Dialogue: 0,0:24:55.32,0:24:56.32,Default,,0,0,0,,А...
Dialogue: 0,0:24:57.32,0:25:00.49,Default,,0,0,0,,Әй, балам, саған мұнда кіруге рұқсат жоқ!
Dialogue: 0,0:25:00.58,0:25:03.08,Default,,0,0,0,,Шүкір, қайда бардың?
Dialogue: 0,0:25:03.16,0:25:05.12,Default,,0,0,0,,Бала, күте тұр! Бала
Dialogue: 0,0:25:06.29,0:25:07.96,Default,,0,0,0,,Фу…
Dialogue: 0,0:25:08.04,0:25:10.21,Default,,0,0,0,,Аня жұлдыздар жинағаны үшін сый ретінде —
Dialogue: 0,0:25:10.30,0:25:12.01,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:25:12.09,0:25:14.47,Default,,0,0,0,,Мен қазір телефонға жауап бере алмаймын.
Dialogue: 0,0:25:14.55,0:25:16.09,Default,,0,0,0,,Теру дыбысынан кейін
Dialogue: 0,0:25:14.55,0:25:16.09,Default,,0,0,0,,Міне... Шиничи...
Dialogue: 0,0:25:16.09,0:25:16.18,Default,,0,0,0,,Бұл... Шиничи...
Dialogue: 0,0:25:16.18,0:25:17.72,Default,,0,0,0,,Міне... Шиничи...
Dialogue: 0,0:25:16.18,0:25:17.72,Default,,0,0,0,,Хабарлама қалдырыңыз
Dialogue: 0,0:25:17.80,0:25:19.89,Default,,0,0,0,,Шығуыңызды өтінемін!
Dialogue: 0,0:25:19.97,0:25:22.35,Default,,0,0,0,,Нашар жүгіру! Мен қазір Баланы қуып жүрмін.
Dialogue: 0,0:25:22.43,0:25:24.06,Default,,0,0,0,,Кейінірек қайта қоңырау шалыңыз!
Dialogue: 0,0:25:26.31,0:25:31.19,Default,,0,0,0,,(Ранның жылағаны)
Dialogue: 0,0:25:31.27,0:25:32.61,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:25:32.69,0:25:35.49,Default,,0,0,0,,Уф... Шиничи...
Dialogue: 0,0:25:40.78,0:25:42.87,Default,,0,0,0,,Қайда? Ол қайда...
Dialogue: 0,0:25:42.95,0:25:43.83,Default,,0,0,0,,Ha
Dialogue: 0,0:25:48.54,0:25:50.42,Default,,0,0,0,,Ха... хех хе...
Dialogue: 0,0:25:51.13,0:25:52.46,Default,,0,0,0,,Теня да батыр ма?
Dialogue: 0,0:26:00.39,0:26:02.60,Default,,0,0,0,,Ах, қандай жалықтырарлық.
Dialogue: 0,0:26:05.93,0:26:06.89,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:26:13.94,0:26:15.61,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:26:16.53,0:26:18.95,Default,,0,0,0,,Бірақ мен ғимараттан секіргенде
Dialogue: 0,0:26:19.03,0:26:21.32,Default,,0,0,0,,Балада «Күнбағыс» болмады
Dialogue: 0,0:26:22.83,0:26:24.83,Default,,0,0,0,,Мен оны жоғалтқан уақытты ескере отырып
Dialogue: 0,0:26:24.91,0:26:27.50,Default,,0,0,0,,Ол сол ғимараттың бір жерінде жасырылған болуы керек.
Dialogue: 0,0:26:29.71,0:26:31.21,Default,,0,0,0,,Күтілгендей!
Dialogue: 0,0:26:37.51,0:26:39.76,Default,,0,0,0,,Әуежайда қандай құралдар бар?
Dialogue: 0,0:26:39.84,0:26:41.26,Default,,0,0,0,,Бұл мен істей алатын ең жақсы нәрсе.
Dialogue: 0,0:26:41.34,0:26:42.26,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:26:42.35,0:26:44.76,Default,,0,0,0,,Әзірге маған сызаттардың бар-жоғын тексеру керек.
Dialogue: 0,0:26:46.43,0:26:48.31,Default,,0,0,0,,- (Шығыс) Бастайық -Иә.
Dialogue: 0,0:26:48.39,0:26:50.73,Default,,0,0,0,,Мен бұл жай ғана кір деп үміттенемін ...
Dialogue: 0,0:26:50.81,0:26:55.36,Default,,0,0,0,,Бір тырнақ болса да көрме өткізсем деген арманым орындалады.
Dialogue: 0,0:26:55.44,0:26:57.07,Default,,0,0,0,,- (Детектив) Инспектор Накамори! - (Детектив) Қараңдар!
Dialogue: 0,0:26:57.15,0:26:59.86,Default,,0,0,0,,Күтілгендей, Кид шатырдың бақылау камерасынан көрінді.
Dialogue: 0,0:27:00.66,0:27:02.03,Default,,0,0,0,,Шамамен 1 сағат 15 минут бұрын
Dialogue: 0,0:27:02.12,0:27:04.12,Default,,0,0,0,,Сіз бұл жерден өтіп кеткен сияқтысыз.
Dialogue: 0,0:27:04.20,0:27:05.16,Default,,0,0,0,,Осы кезде
Dialogue: 0,0:27:05.24,0:27:07.37,Default,,0,0,0,,Сізде әлі де «Күнбағыс» бар сияқты.
Dialogue: 0,0:27:07.45,0:27:08.46,Default,,0,0,0,,О
Dialogue: 0,0:27:08.54,0:27:11.63,Default,,0,0,0,,Бірақ неге Кид сол ғимаратта күнбағыс қалдырды?
Dialogue: 0,0:27:11.71,0:27:15.21,Default,,0,0,0,,Екінші «күнбағыс» күткеннен үлкен.
Dialogue: 0,0:27:15.30,0:27:19.13,Default,,0,0,0,,Ауа кедергісі дельтапландар арқылы құтылу үшін тым үлкен болуы керек.
Dialogue: 0,0:27:19.22,0:27:22.14,Default,,0,0,0,,Төгілген зат суыған соң келіп, жинауды жоспарлап едім.
Dialogue: 0,0:27:22.22,0:27:23.68,Default,,0,0,0,,Кішкентай болып қаралды
Dialogue: 0,0:27:23.76,0:27:26.31,Default,,0,0,0,,А... Мен мұны таппадым.
Dialogue: 0,0:27:26.39,0:27:28.31,Default,,0,0,0,,Шиничи-ни-чан Кидті қуып бара жатқанда
Dialogue: 0,0:27:28.39,0:27:29.77,Default,,0,0,0,,Мен сенің жасырып жатқаныңды көрдім.
Dialogue: 0,0:27:29.85,0:27:31.10,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:27:31.60,0:27:34.15,Default,,0,0,0,,Сол орта мектептің детективі қазір қайда?
Dialogue: 0,0:27:34.23,0:27:35.15,Default,,0,0,0,,Маған бәрібір! Ха!
Dialogue: 0,0:27:35.23,0:27:37.61,Default,,0,0,0,,Бала пайда болған кезде әрқашан жоқ.
Dialogue: 0,0:27:37.69,0:27:39.40,Default,,0,0,0,,Ол бала Кайту Кид сияқты...
Dialogue: 0,0:27:39.49,0:27:41.70,Default,,0,0,0,,Менің ойымша, бұл мүмкін емес.
Dialogue: 0,0:27:42.53,0:27:43.57,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:27:43.66,0:27:47.04,Default,,0,0,0,,Кудо-кунмен 1 сағат 15 минут бұрын қоңырау шалу тарихы бар.
Dialogue: 0,0:27:47.12,0:27:49.75,Default,,0,0,0,,Бұл алдыңғы фотосуретпен бірдей уақыт.
Dialogue: 0,0:27:49.83,0:27:50.79,Default,,0,0,0,,Ябе
Dialogue: 0,0:27:50.87,0:27:53.29,Default,,0,0,0,,Мен Америкаға бардым.
Dialogue: 0,0:27:53.38,0:27:55.38,Default,,0,0,0,,Жоқ, бұл бос сөзден де көп.
Dialogue: 0,0:27:55.46,0:27:58.88,Default,,0,0,0,,Кид неліктен осы әуежайдан өтті деген сұрақ туындайды.
Dialogue: 0,0:27:58.96,0:28:02.88,Default,,0,0,0,,Сіз жарып жіберген ұшақпен не болды деп ойлаған боларсыз.
Dialogue: 0,0:28:02.97,0:28:04.76,Default,,0,0,0,,Кісі өлтіруші кінәсіз болып көрінді.
Dialogue: 0,0:28:04.84,0:28:07.06,Default,,0,0,0,,Ол қылмыс орнына қайтып барады.
Dialogue: 0,0:28:07.14,0:28:08.10,Default,,0,0,0,,Бұл...
Dialogue: 0,0:28:08.18,0:28:09.06,Default,,0,0,0,,(Бенедикт) Бұл миссияның қаншалықты маңызды екенін көрсетеді.
Dialogue: 0,0:28:09.64,0:28:11.94,Default,,0,0,0,,Мистер Баланы қанішермен араластырмаңыз!
Dialogue: 0,0:28:13.19,0:28:14.06,Default,,0,0,0,,Оян
Dialogue: 0,0:28:14.15,0:28:15.02,Default,,0,0,0,,Ha
Dialogue: 0,0:28:15.11,0:28:17.57,Default,,0,0,0,,Ол сені де өлтіре жаздады.
Dialogue: 0,0:28:18.65,0:28:22.07,Default,,0,0,0,,Бала ұшақты құлату сияқты әрекет жасайды.
Dialogue: 0,0:28:22.65,0:28:25.20,Default,,0,0,0,,Мен мұны мойындауды жек көремін.
Dialogue: 0,0:28:25.28,0:28:26.78,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:28:27.91,0:28:30.87,Default,,0,0,0,,Мен көп түтінге ұшырап, лас болсам да.
Dialogue: 0,0:28:30.95,0:28:32.75,Default,,0,0,0,,Жөндеудің қажеті жоқ
Dialogue: 0,0:28:32.83,0:28:34.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:34.87,0:28:37.34,Default,,0,0,0,,Енді мойын терісінің бір бөлігі жалғанған.
Dialogue: 0,0:28:37.42,0:28:38.96,Default,,0,0,0,,Қожайындары да қиналған.
Dialogue: 0,0:28:39.05,0:28:41.01,Default,,0,0,0,,Қазірден бастап бос емес!
Dialogue: 0,0:28:41.72,0:28:44.76,Default,,0,0,0,,Әйтеуір, ерте тапқаныңызға қуаныштымын.
Dialogue: 0,0:28:44.84,0:28:48.81,Default,,0,0,0,,Иә, егер оны осылай ыстық күнде қалдырса.
Dialogue: 0,0:28:48.89,0:28:52.31,Default,,0,0,0,,Ультракүлгін сәулелер мен жылу жеткіліксіз болар еді.
Dialogue: 0,0:28:52.39,0:28:54.64,Default,,0,0,0,,Иә? Бұл үлкен, кішкентай ваппа
Dialogue: 0,0:28:54.73,0:28:55.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:55.69,0:28:57.44,Default,,0,0,0,,Сондықтан сіз балаларды өлтірушісіз
Dialogue: 0,0:28:57.52,0:29:01.11,Default,,0,0,0,,Жоқ, сондықтан мен бұл мен емес деп айттым.
Dialogue: 0,0:28:57.52,0:29:01.11,Default,,0,0,0,,Вахахаха...
Dialogue: 0,0:29:02.69,0:29:05.95,Default,,0,0,0,,Сузуки жанұясының қаржылық ресурстарымен жасалған үлкен қазына
Dialogue: 0,0:29:06.03,0:29:08.12,Default,,0,0,0,,Тецутануки Кай!
Dialogue: 0,0:29:08.20,0:29:10.33,Default,,0,0,0,,Осы жерге қойсаңыз, қауіпсіз.
Dialogue: 0,0:29:10.41,0:29:14.16,Default,,0,0,0,,Бірақ Тецутанукиді бұрын Кид-сама жойды...
Dialogue: 0,0:29:14.25,0:29:17.54,Default,,0,0,0,,Уайымдамаңыз, ол әлдеқашан жақсартылған.
Dialogue: 0,0:29:17.63,0:29:19.13,Default,,0,0,0,,- (Джирокичи) Ноу Люпин -Бір!
Dialogue: 0,0:29:21.71,0:29:24.80,Default,,0,0,0,,Жақсы! Барлығы шыққанын тексеріңіз.
Dialogue: 0,0:29:24.88,0:29:25.76,Default,,0,0,0,,Иә
Dialogue: 0,0:29:30.01,0:29:33.73,Default,,0,0,0,,Аа, жарайды, ішінде ешкім жоқ.
Dialogue: 0,0:29:33.81,0:29:35.10,Default,,0,0,0,,Хмм
Dialogue: 0,0:29:35.19,0:29:38.35,Default,,0,0,0,,Тецутануки Кай іске қосылды!
Dialogue: 0,0:29:49.53,0:29:52.70,Default,,0,0,0,,Елордалық полиция департаменті мен Жер, инфрақұрылым, көлік және туризм министрлігінің тергеуіне сәйкес
Dialogue: 0,0:29:52.79,0:29:55.08,Default,,0,0,0,,Ұшақтың жүк бөлігінің сыртқы қабырғасында
Dialogue: 0,0:29:55.16,0:29:57.83,Default,,0,0,0,,Себебі бомбаның іздері табылды
Dialogue: 0,0:29:57.92,0:30:00.92,Default,,0,0,0,,Жоғалған механикті табыңыз
Dialogue: 0,0:30:01.00,0:30:03.00,Default,,0,0,0,,Олар қазір іздеп жатқан сияқты.
Dialogue: 0,0:30:03.51,0:30:04.84,Default,,0,0,0,,«Химавари» иелері
Dialogue: 0,0:30:04.92,0:30:06.55,Default,,0,0,0,,Олар оны қарызға бергісі келмейтін сияқты.
Dialogue: 0,0:30:06.55,0:30:07.43,Default,,0,0,0,,Сіз оны қарызға беруге құлықсыз сияқтысыз.
Dialogue: 0,0:30:06.55,0:30:07.43,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:30:07.43,0:30:08.18,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:30:10.14,0:30:12.72,Default,,0,0,0,,Иә? Әке, мен жиналысқа баруым керек пе?
Dialogue: 0,0:30:12.81,0:30:15.89,Default,,0,0,0,,О, бүгін үлкен жарыс бар.
Dialogue: 0,0:30:15.98,0:30:16.39,Default,,0,0,0,,Ей, сіз әлсіреуді жоспарлап отырсыз ба?
Dialogue: 0,0:30:16.39,0:30:18.60,Default,,0,0,0,,Эй, эй, сен әлсіреуді жоспарлап отырсың ба?
Dialogue: 0,0:30:16.39,0:30:18.60,Default,,0,0,0,,Мен бірінші күннен бастап жоқпын.
Dialogue: 0,0:30:18.60,0:30:18.69,Default,,0,0,0,,Ей, сіз әлсіреуді жоспарлап отырсыз ба?
Dialogue: 0,0:30:18.69,0:30:19.77,Default,,0,0,0,,Ей, сіз әлсіреуді жоспарлап отырсыз ба?
Dialogue: 0,0:30:18.69,0:30:19.77,Default,,0,0,0,,Мен жұмыстан босатылсам не істеуім керек?
Dialogue: 0,0:30:19.77,0:30:19.85,Default,,0,0,0,,Мен жұмыстан босатылсам не істеуім керек?
Dialogue: 0,0:30:19.85,0:30:20.90,Default,,0,0,0,,Мен жұмыстан босатылсам не істеуім керек?
Dialogue: 0,0:30:19.85,0:30:20.90,Default,,0,0,0,,Ах
Dialogue: 0,0:30:20.98,0:30:24.15,Default,,0,0,0,,Бұл керемет детективті жұмыстан шығаруға мүмкіндік жоқ.
Dialogue: 0,0:30:24.23,0:30:26.24,Default,,0,0,0,,Иә, ол пошта арқылы келді.
Dialogue: 0,0:30:26.32,0:30:27.57,Default,,0,0,0,,Иә?Не?
Dialogue: 0,0:30:28.40,0:30:31.57,Default,,0,0,0,,Мүмкін хат немесе фанат хат.
Dialogue: 0,0:30:31.66,0:30:33.54,Default,,0,0,0,,- (Когоро) Фуфун - (Ран) Хаа
Dialogue: 0,0:30:33.62,0:30:34.95,Default,,0,0,0,,Конан-кун
Dialogue: 0,0:30:35.04,0:30:37.37,Default,,0,0,0,,Соноко мені кездесуге шақырды.
Dialogue: 0,0:30:37.46,0:30:38.96,Default,,0,0,0,,Менімен бірге барғың келе ме?
Dialogue: 0,0:30:39.04,0:30:40.58,Default,,0,0,0,,Менің барғым келеді.
Dialogue: 0,0:30:40.67,0:30:44.05,Default,,0,0,0,,Бүгін мен барлығымен бірге өнер мұражайына баруға уәде бердім.
Dialogue: 0,0:30:44.13,0:30:46.63,Default,,0,0,0,,Дұрыс, онда оған көмектесуге болмайды.
Dialogue: 0,0:30:47.26,0:30:49.97,Default,,0,0,0,,- (Жүгіріп) Әй... ал... - Иә?
Dialogue: 0,0:30:50.05,0:30:53.51,Default,,0,0,0,,Конан-кун, сен Шиничиден естідің бе?
Dialogue: 0,0:30:53.60,0:30:55.31,Default,,0,0,0,,Жоқ, ол келмеді.
Dialogue: 0,0:30:56.27,0:30:59.56,Default,,0,0,0,,Америкаға барған болсаң, маған айтар едің.
Dialogue: 0,0:30:59.64,0:31:03.11,Default,,0,0,0,,Мен Киддті қуып жүрмін, ол тіпті менімен хабарласпады.
Dialogue: 0,0:31:03.19,0:31:04.23,Default,,0,0,0,,Орхидея…
Dialogue: 0,0:31:03.19,0:31:04.23,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:31:04.32,0:31:05.19,Default,,0,0,0,,- (Гента) Конан! -Ах
Dialogue: 0,0:31:05.28,0:31:07.19,Default,,0,0,0,,Мен сені алып кетуге келдім.
Dialogue: 0,0:31:07.28,0:31:08.78,Default,,0,0,0,,Кеттік, Конан-кун.
Dialogue: 0,0:31:08.86,0:31:09.99,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:31:10.07,0:31:11.20,Default,,0,0,0,,Тез, тез
Dialogue: 0,0:31:11.28,0:31:13.45,Default,,0,0,0,,Доктор Конан осында!
Dialogue: 0,0:31:13.53,0:31:16.83,Default,,0,0,0,,Хайбара-сан, жақын арада кететін сияқтысың!
Dialogue: 0,0:31:16.91,0:31:18.33,Default,,0,0,0,,Ал, мен барамын.
Dialogue: 0,0:31:18.91,0:31:21.33,Default,,0,0,0,,Сақ болыңыз.
Dialogue: 0,0:31:22.25,0:31:23.13,Default,,0,0,0,,Иә
Dialogue: 0,0:31:24.92,0:31:26.67,Default,,0,0,0,,- (Когоро) Жүгіріп кетті! -(Жүгіріп) Уау, не?
Dialogue: 0,0:31:26.75,0:31:28.76,Default,,0,0,0,,- (Когоро) Тез арада полиция шақырыңыз! - (Жүгіріп) А?
Dialogue: 0,0:31:28.84,0:31:30.01,Default,,0,0,0,,Бұл бала.
Dialogue: 0,0:31:30.09,0:31:32.93,Default,,0,0,0,,Бұрынғы хатта балалар картасы бар еді.
Dialogue: 0,0:31:33.01,0:31:34.14,Default,,0,0,0,,Иә!
Dialogue: 0,0:31:35.01,0:31:35.89,Default,,0,0,0,,Ал Спидвагон мен басқалар
Dialogue: 0,0:31:36.56,0:31:39.39,Default,,0,0,0,,«Бүгін түнде Ла Берсеустың сол жағында»
Dialogue: 0,0:31:39.48,0:31:42.02,Default,,0,0,0,,«Мен бірінші көшірмені алуға келе жатырмын».
Dialogue: 0,0:31:42.10,0:31:43.90,Default,,0,0,0,,Қарғыс атсын... балақай.
Dialogue: 0,0:31:43.98,0:31:46.65,Default,,0,0,0,,Сіз әлі бас тартқан жоқсыз ба?
Dialogue: 0,0:31:48.03,0:31:49.15,Default,,0,0,0,,Ани туралы маңызды ақпаратқа
Dialogue: 0,0:31:49.24,0:31:51.32,Default,,0,0,0,,«Күнбағысқа» иелік ететіндер
Dialogue: 0,0:31:51.40,0:31:54.41,Default,,0,0,0,,Осы кезеңде мен несие беруге құлықсыз болдым.
Dialogue: 0,0:31:54.49,0:31:57.79,Default,,0,0,0,,Онда, жоғалған сенімді қалпына келтіру үшін.
Dialogue: 0,0:31:57.87,0:32:02.46,Default,,0,0,0,,Біз Rayrock-қа Kid-тің жеке қауіпсіздік жүйесін қосуды шештік.
Dialogue: 0,0:32:02.54,0:32:05.00,Default,,0,0,0,,Кеше түнде Нацуми ханым ұсыныс жасады.
Dialogue: 0,0:32:05.08,0:32:09.05,Default,,0,0,0,,Қауіпсіздік камераларын күнбағыспен камуфляждау стратегиясы
Dialogue: 0,0:32:09.13,0:32:10.30,Default,,0,0,0,,Қазірдің өзінде қабылданған
Dialogue: 0,0:32:10.88,0:32:14.55,Default,,0,0,0,,Басқа жақсы идеяларыңыз болса, маған хабарлаңыз.
Dialogue: 0,0:32:14.64,0:32:16.85,Default,,0,0,0,,Әрине, маған ақша маңызды емес.
Dialogue: 0,0:32:16.93,0:32:21.06,Default,,0,0,0,,Иә, көрмені сәтті өткізу – біздің міндетіміз.
Dialogue: 0,0:32:21.14,0:32:23.81,Default,,0,0,0,,Мен өз ойларымды жинақтап, дереу ұсынамын.
Dialogue: 0,0:32:23.90,0:32:25.52,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:32:25.61,0:32:28.90,Default,,0,0,0,,Чарли, сен маған көмектесесің бе?
Dialogue: 0,0:32:28.98,0:32:29.82,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:32:30.44,0:32:32.57,Default,,0,0,0,,Ол өзін фантом ұры деп атайды.
Dialogue: 0,0:32:32.65,0:32:35.78,Default,,0,0,0,,Шындығында, ол мақсатына жету үшін біреуді өлтіру үшін бәрін жасай алады...
Dialogue: 0,0:32:35.87,0:32:36.78,Default,,0,0,0,,Ах
Dialogue: 0,0:32:36.87,0:32:39.16,Default,,0,0,0,,Жоқ, олар террористер.
Dialogue: 0,0:32:39.66,0:32:42.08,Default,,0,0,0,,Сен не білесің?
Dialogue: 0,0:32:42.16,0:32:43.54,Default,,0,0,0,,Негізінен бұл ұшақ апаты.
Dialogue: 0,0:32:43.62,0:32:45.33,Default,,0,0,0,,Бұл міндетті түрде Кид мырза жасады дегенді білдірмейді!
Dialogue: 0,0:32:45.42,0:32:47.88,Default,,0,0,0,,Олай болса тыңдауға рұқсат етіңіз.
Dialogue: 0,0:32:48.54,0:32:49.88,Default,,0,0,0,,Баладан басқа кім?
Dialogue: 0,0:32:50.55,0:32:52.84,Default,,0,0,0,,Ұшақты не үшін жарып жібердің?
Dialogue: 0,0:32:52.92,0:32:54.38,Default,,0,0,0,,Қарғыс атсын... Ах (есіктің ашылған дыбысы)
Dialogue: 0,0:32:55.13,0:32:57.43,Default,,0,0,0,,Джирокичи мырза, маған біраз уақыт беріңізші?
Dialogue: 0,0:32:57.51,0:33:00.10,Default,,0,0,0,,- (Джирокичи) Не? -(Қара киім) Кешіріңіз.
Dialogue: 0,0:33:00.18,0:33:02.35,Default,,0,0,0,,Инспектор Накамори жедел түрде Джирокичи мырзаға хабарласты.
Dialogue: 0,0:33:02.43,0:33:03.94,Default,,0,0,0,,Ол менімен сөйлескісі келетінін айтты.
Dialogue: 0,0:33:04.02,0:33:06.81,Default,,0,0,0,,- (Джирокичи) Жарайды, айналдыр - (Қара киім) Иә.
Dialogue: 0,0:33:10.65,0:33:12.36,Default,,0,0,0,,Мен ауыстырылдым. Ол не үшін?
Dialogue: 0,0:33:12.44,0:33:13.61,Default,,0,0,0,,Хмм…
Dialogue: 0,0:33:14.28,0:33:16.57,Default,,0,0,0,,Хмм, түсіндім.
Dialogue: 0,0:33:16.66,0:33:19.16,Default,,0,0,0,,Темір Танукидің сынуы мүмкін емес.
Dialogue: 0,0:33:19.24,0:33:20.37,Default,,0,0,0,,Қазір тексеріңіз
Dialogue: 0,0:33:20.95,0:33:22.58,Default,,0,0,0,,Жиналыс уақытша тоқтатылды.
Dialogue: 0,0:33:22.66,0:33:24.83,Default,,0,0,0,,- (Кумико) Не ​​болды? -(Кейко) Бұл не?
Dialogue: 0,0:33:24.91,0:33:26.71,Default,,0,0,0,,- (Соноко) Бұл Кид-сама болуы мүмкін бе? -(Джирокичи) Ммм.
Dialogue: 0,0:33:26.79,0:33:30.42,Default,,0,0,0,,Детектив Моури жаңа хабарлама алды.
Dialogue: 0,0:33:30.50,0:33:31.42,Default,,0,0,0,,А...
Dialogue: 0,0:33:31.50,0:33:34.05,Default,,0,0,0,,Қарғыс атсын... Сонда хабар не дейді?
Dialogue: 0,0:33:36.26,0:33:41.26,Default,,0,0,0,,«Бүгін түнде мен бірінші көшірмені алу үшін Ла Берсеустың сол жағына келемін».
Dialogue: 0,0:33:41.35,0:33:43.93,Default,,0,0,0,,- (Джирокичи) Жай... - Әйтеуір...
Dialogue: 0,0:33:44.68,0:33:47.10,Default,,0,0,0,,Ені үш жұптың сол жағын айтасыз ба?
Dialogue: 0,0:33:47.19,0:33:48.94,Default,,0,0,0,,- (Кейко) Сонда бірінші көшірме қандай... - (Хигаши) Иә.
Dialogue: 0,0:33:49.02,0:33:51.69,Default,,0,0,0,,Барлығыңыз сәл күтіңіздер.
Dialogue: 0,0:33:51.77,0:33:52.73,Default,,0,0,0,,- (Кумико) Кеңесші! - (Джирокичи) Иә?
Dialogue: 0,0:33:52.82,0:33:55.15,Default,,0,0,0,,Хабар шын болса, Баланың мақсаты
Dialogue: 0,0:33:55.24,0:33:57.07,Default,,0,0,0,,Бұл жердегі «күнбағыс» емес.
Dialogue: 0,0:33:57.82,0:34:00.53,Default,,0,0,0,,La Berceuse сол жағы Бірінші көшірме дегеніміз не?
Dialogue: 0,0:34:00.62,0:34:03.70,Default,,0,0,0,,Бұл бесінші боялған ``күнбағыс'' дейді.
Dialogue: 0,0:34:04.29,0:34:07.12,Default,,0,0,0,,Ал ``күнбағыс'' бесінші боялған дейді.
Dialogue: 0,0:34:07.21,0:34:11.63,Default,,0,0,0,,Өздеріңіз білетіндей, ол қазір Жапонияда.
Dialogue: 0,0:34:12.21,0:34:13.25,Default,,0,0,0,,Сомпо Жапония
Dialogue: 0,0:34:13.34,0:34:15.97,Default,,0,0,0,,Ниппонкоа өнер мұражайы...
Dialogue: 0,0:34:16.47,0:34:17.72,Default,,0,0,0,,Мұражай?
Dialogue: 0,0:34:17.80,0:34:19.30,Default,,0,0,0,,Тіпті суретке қараған кезде де
Dialogue: 0,0:34:19.39,0:34:20.39,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:34:20.47,0:34:23.68,Default,,0,0,0,,Біздің қызметті үнемі пайдаланғаныңыз үшін рахмет.
Dialogue: 0,0:34:24.97,0:34:27.02,Default,,0,0,0,,Мен өнер мұражайында бірінші рет болдым!
Dialogue: 0,0:34:27.10,0:34:28.60,Default,,0,0,0,,Мен де Мен
Dialogue: 0,0:34:29.48,0:34:30.98,Default,,0,0,0,,Уау~ бұл қымбат!
Dialogue: 0,0:34:31.06,0:34:32.61,Default,,0,0,0,,оның қазір қайда екенін немесе не істеп жатқанын білуге рұқсат жоқ па? Тіпті соны да білмейміз бе?
Dialogue: 0,0:34:32.69,0:34:34.73,Default,,0,0,0,,Қараңдар, қоңырау ағашын көріп тұрсыңдар!
Dialogue: 0,0:34:34.82,0:34:36.28,Default,,0,0,0,,Бұл рас!
Dialogue: 0,0:34:36.36,0:34:38.99,Default,,0,0,0,,Әй, балалар, сендер «Күнбағысты» көруге келмедіңдер ме?
Dialogue: 0,0:34:39.07,0:34:40.53,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:34:40.62,0:34:43.24,Default,,0,0,0,,Жарайды, «Күнбағысты» көрейік.
Dialogue: 0,0:34:43.33,0:34:45.62,Default,,0,0,0,,А, жүгірмеу керек.
Dialogue: 0,0:34:45.70,0:34:47.66,Default,,0,0,0,,...Олар шынымен де.
Dialogue: 0,0:34:47.75,0:34:49.67,Default,,0,0,0,,«Күнбағыс» сізді қызықтырады ма?
Dialogue: 0,0:34:49.75,0:34:52.92,Default,,0,0,0,,Ой, оны көргісі келетін балалар емес.
Dialogue: 0,0:34:53.00,0:34:54.05,Default,,0,0,0,,Сәлем, доктор
Dialogue: 0,0:34:54.13,0:34:56.67,Default,,0,0,0,,Ах, «Жапонияны таңдандырған күнбағыс көрмесі»
Dialogue: 0,0:34:56.76,0:34:58.22,Default,,0,0,0,,Оқиға болмас бұрын
Dialogue: 0,0:34:58.30,0:35:00.13,Default,,0,0,0,,Жақсы дайындалғаныңызға көз жеткізіңіз!
Dialogue: 0,0:35:00.22,0:35:01.84,Default,,0,0,0,,Бұл Миха ма?
Dialogue: 0,0:35:01.93,0:35:03.05,Default,,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:35:03.14,0:35:05.68,Default,,0,0,0,,Мен сені бұл жолмен келеді деп ойламаппын.
Dialogue: 0,0:35:06.22,0:35:08.35,Default,,0,0,0,,Кездесуге бармағаныңызға қуаныштысыз ба?
Dialogue: 0,0:35:08.43,0:35:11.98,Default,,0,0,0,,Ол жерде алты самурай бар.
Dialogue: 0,0:35:12.90,0:35:16.61,Default,,0,0,0,,Енді бәрі Баланың не істеп жатқаны туралы.
Dialogue: 0,0:35:16.69,0:35:20.49,Default,,0,0,0,,Ол зергерлік бұйымдардан басқа нәрсеге қалай қызығады?
Dialogue: 0,0:35:20.57,0:35:21.61,Default,,0,0,0,,Әлі де біртүрлі
Dialogue: 0,0:35:22.41,0:35:25.16,Default,,0,0,0,,Сонымен Ван Гогтың «Күнбағыстары» нысанаға айналды.
Dialogue: 0,0:35:25.24,0:35:26.54,Default,,0,0,0,,Сонда сіз оны көруге келдіңіз бе?
Dialogue: 0,0:35:26.62,0:35:27.70,Default,,0,0,0,,О
Dialogue: 0,0:35:28.20,0:35:31.21,Default,,0,0,0,,Егер мен бұл жігіт туралы көбірек білсем
Dialogue: 0,0:35:31.29,0:35:33.58,Default,,0,0,0,,Баланың мотиві... және
Dialogue: 0,0:35:33.67,0:35:36.46,Default,,0,0,0,,Сіздің келесі қадамыңызды болжай алатынымды білмеймін.
Dialogue: 0,0:35:37.42,0:35:39.51,Default,,0,0,0,,Иә? Бұл жерде
Dialogue: 0,0:35:39.59,0:35:41.01,Default,,0,0,0,,«Күнбағыс» дегеніміз не?
Dialogue: 0,0:35:41.09,0:35:42.55,Default,,0,0,0,,А, мінекей.
Dialogue: 0,0:35:42.64,0:35:43.97,Default,,0,0,0,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:35:44.05,0:35:46.26,Default,,0,0,0,,Хаха Қайсысы? Қайсысы «күнбағыс»?
Dialogue: 0,0:35:46.35,0:35:48.47,Default,,0,0,0,,Міне, дәл осы жерде.
Dialogue: 0,0:35:48.56,0:35:49.52,Default,,0,0,0,,- (Гента) Уау - (Аюми) Әдемі
Dialogue: 0,0:35:49.60,0:35:51.52,Default,,0,0,0,,оның қазір қайда екенін немесе не істеп жатқанын білуге рұқсат жоқ па? Тіпті соны да білмейміз бе?
Dialogue: 0,0:35:52.19,0:35:54.73,Default,,0,0,0,,Эй, мұның несі таңқаларлық?
Dialogue: 0,0:35:54.81,0:35:56.27,Default,,0,0,0,,- (Мицухико/Аюми) Е - сендер балалар
Dialogue: 0,0:35:56.36,0:35:59.11,Default,,0,0,0,,Тыныш бол, әйтпесе сені қуып жібереді.
Dialogue: 0,0:35:59.19,0:36:00.19,Default,,0,0,0,,Иә
Dialogue: 0,0:36:00.28,0:36:01.78,Default,,0,0,0,,Кешіріңіз, бұл шулы.
Dialogue: 0,0:36:01.86,0:36:03.36,Default,,0,0,0,,Жоқ
Dialogue: 0,0:36:03.45,0:36:04.53,Default,,0,0,0,,- (Ағаса) О! -иә?
Dialogue: 0,0:36:04.62,0:36:07.95,Default,,0,0,0,,Бұл «Күнбағыс» бесінші боялған сурет пе?
Dialogue: 0,0:36:08.04,0:36:09.83,Default,,0,0,0,,Сәлем доктор.
Dialogue: 0,0:36:09.91,0:36:12.79,Default,,0,0,0,,- (Ағаса) Күткендей, ғажап - Уфуфуфуфу...
Dialogue: 0,0:36:12.87,0:36:14.79,Default,,0,0,0,,А, жоқ, жоқ, кешіріңіз.
Dialogue: 0,0:36:14.88,0:36:16.17,Default,,0,0,0,,Не болса да
Dialogue: 0,0:36:16.25,0:36:18.30,Default,,0,0,0,,Мен «Химавари» фильмін жаңа ғана көріп бітірдім.
Dialogue: 0,0:36:18.38,0:36:19.92,Default,,0,0,0,,- (Мицухико) Осы жеткілікті ме? -(Аюми) Иә.
Dialogue: 0,0:36:20.01,0:36:21.76,Default,,0,0,0,,Олай болса, кәдесыйлар сатып алайық.
Dialogue: 0,0:36:21.84,0:36:22.97,Default,,0,0,0,,А, кеттік, кеттік
Dialogue: 0,0:36:23.05,0:36:24.89,Default,,0,0,0,,Иә, барамын, доктор.
Dialogue: 0,0:36:24.97,0:36:26.43,Default,,0,0,0,,А... иә иә
Dialogue: 0,0:36:26.93,0:36:30.27,Default,,0,0,0,,...Олар мұнда не үшін келді?
Dialogue: 0,0:36:32.77,0:36:34.10,Default,,0,0,0,,Жас ханым
Dialogue: 0,0:36:34.69,0:36:38.07,Default,,0,0,0,,Сізді «күнбағыс» емес, басқа нәрсе қызықтыратын сияқты.
Dialogue: 0,0:36:38.15,0:36:39.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:39.82,0:36:40.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:36:41.90,0:36:43.74,Default,,0,0,0,,Кешіріңіз, кенеттен.
Dialogue: 0,0:36:43.82,0:36:47.41,Default,,0,0,0,,Бұрынғы келбетіме қарап, қоя алмай тұрғандай
Dialogue: 0,0:36:47.49,0:36:48.45,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:36:50.16,0:36:52.58,Default,,0,0,0,,Сенің әжең мұнда жиі келе ме?
Dialogue: 0,0:36:52.66,0:36:54.33,Default,,0,0,0,,Иә, күн сайын.
Dialogue: 0,0:36:55.96,0:36:58.50,Default,,0,0,0,,Маған Ван Гогтың «Күнбағыстары» қатты ұнайды.
Dialogue: 0,0:36:58.59,0:36:59.46,Default,,0,0,0,,Иә.
Dialogue: 0,0:37:00.38,0:37:02.42,Default,,0,0,0,,Бірақ бұл «күнбағыс» емес
Dialogue: 0,0:37:03.01,0:37:04.93,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:37:05.01,0:37:06.55,Default,,0,0,0,,Сіз әлі қауіпсіз сияқтысыз.
Dialogue: 0,0:37:06.64,0:37:07.97,Default,,0,0,0,,Ағай, не болды?
Dialogue: 0,0:37:08.05,0:37:10.93,Default,,0,0,0,,Иә? Ах! сен неге мұндасың
Dialogue: 0,0:37:11.02,0:37:12.10,Default,,0,0,0,,Нағашы сол
Dialogue: 0,0:37:12.18,0:37:13.98,Default,,0,0,0,,Жақсы уақыт, кішкентай ваппа
Dialogue: 0,0:37:14.06,0:37:15.35,Default,,0,0,0,,Сіз де маған қосылыңыз
Dialogue: 0,0:37:15.44,0:37:16.44,Default,,0,0,0,,Бұл Бала болуы мүмкін бе?
Dialogue: 0,0:37:16.52,0:37:18.56,Default,,0,0,0,,Мм, мысықтың келесі мақсаты қандай болады...
Dialogue: 0,0:37:18.65,0:37:19.73,Default,,0,0,0,,Кеңесші Сузуки
Dialogue: 0,0:37:19.82,0:37:21.65,Default,,0,0,0,,Міне, біз бұл туралы айтып отырмыз...
Dialogue: 0,0:37:21.73,0:37:23.49,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:37:23.57,0:37:24.82,Default,,0,0,0,,Сіз растағандай
Dialogue: 0,0:37:24.90,0:37:27.32,Default,,0,0,0,,Әзірге ешқандай проблема жоқ
Dialogue: 0,0:37:27.41,0:37:30.28,Default,,0,0,0,,Әрі қарай тұтынушыға қолайсыздықтар туғызады.
Dialogue: 0,0:37:30.37,0:37:33.50,Default,,0,0,0,,Толығырақ ақпарат алу үшін қабылдау бөлмесіне келіңіз.
Dialogue: 0,0:37:33.58,0:37:36.12,Default,,0,0,0,,Дұрыс, қайтайық.
Dialogue: 0,0:37:36.21,0:37:39.13,Default,,0,0,0,,Хайбар! Мен осында жігіттермен бірге боламын
Dialogue: 0,0:37:39.21,0:37:40.84,Default,,0,0,0,,Сіз бәрімен бірге үйге барасыз.
Dialogue: 0,0:37:41.63,0:37:43.13,Default,,0,0,0,,-Ал... -(Хайбара) Білемін.
Dialogue: 0,0:37:43.21,0:37:45.68,Default,,0,0,0,,Бұл туралы балаларға айтпа.
Dialogue: 0,0:37:45.76,0:37:47.18,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:37:48.39,0:37:50.47,Default,,0,0,0,,Саған сенеді, солай емес пе?
Dialogue: 0,0:37:51.60,0:37:53.06,Default,,0,0,0,,Иә, біз
Dialogue: 0,0:37:53.14,0:37:54.98,Default,,0,0,0,,Біз әжем ойлағандай жақын емеспіз...
Dialogue: 0,0:37:55.06,0:37:56.19,Default,,0,0,0,,-Жоқ - (Хайбара) А...
Dialogue: 0,0:37:56.27,0:38:00.65,Default,,0,0,0,,Сенің көзің 70 жыл бұрынғы мендей екен
Dialogue: 0,0:38:00.73,0:38:04.32,Default,,0,0,0,,Күнбағыс тілі сияқты...
Dialogue: 0,0:38:04.40,0:38:06.74,Default,,0,0,0,,«Мен саған ғана қараймын»
Dialogue: 0,0:38:06.82,0:38:11.41,Default,,0,0,0,,Бірақ маған қарап тұрсаң, бір күні өкінетініңе сенімдімін.
Dialogue: 0,0:38:11.49,0:38:13.20,Default,,0,0,0,,Мен сияқты.
Dialogue: 0,0:38:18.96,0:38:22.63,Default,,0,0,0,,Адамдар ненің маңызды екенін жоғалтқаннан кейін ғана түсінеді.
Dialogue: 0,0:38:23.63,0:38:25.88,Default,,0,0,0,,Сол «күнбағыс» сияқты
Dialogue: 0,0:38:26.38,0:38:28.38,Default,,0,0,0,,Хайбара Мен үйге бара жатырмын!
Dialogue: 0,0:38:28.47,0:38:29.84,Default,,0,0,0,,Иә? Конан ше?
Dialogue: 0,0:38:29.93,0:38:31.35,Default,,0,0,0,,- (Гента/Аюми) Ах - (Хайбара) Мен бірінші үйге бардым.
Dialogue: 0,0:38:31.43,0:38:33.31,Default,,0,0,0,,- (3 адам) Иә? -(Хайбара) Менің шұғыл жұмысым бар сияқты.
Dialogue: 0,0:38:33.39,0:38:34.93,Default,,0,0,0,,- (Аюми) Иә? -(Мицухико) Тағы?
Dialogue: 0,0:38:35.02,0:38:35.98,Default,,0,0,0,,Бір нәрсе айтыңыз
Dialogue: 0,0:38:36.06,0:38:36.60,Default,,0,0,0,,Тағы да ваннаға бару керек емес пе?
Dialogue: 0,0:38:36.60,0:38:37.85,Default,,0,0,0,,Тағы да ваннаға бару керек емес пе?
Dialogue: 0,0:38:36.60,0:38:37.85,Default,,0,0,0,,- (Хайбара) Кеңесіңізге рахмет - А...
Dialogue: 0,0:38:38.77,0:38:40.56,Default,,0,0,0,,Өкінбейтініне көз жеткіземін.
Dialogue: 0,0:38:42.69,0:38:45.36,Default,,0,0,0,,Кешіріңіз, мен оны көруге уақытыңызды ала алмадым, доктор.
Dialogue: 0,0:38:45.44,0:38:46.40,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:38:46.49,0:38:48.99,Default,,0,0,0,,Бұл «Жапония үшін күнбағыс көрмесі»
Dialogue: 0,0:38:49.07,0:38:50.70,Default,,0,0,0,,Мен қазір одан да көп күтемін деп айта аламын.
Dialogue: 0,0:38:50.78,0:38:52.07,Default,,0,0,0,,Йосуке мырза...
Dialogue: 0,0:38:53.12,0:38:56.66,Default,,0,0,0,,Неліктен бұл ескерту мұражайдың ``Күнбағыстары'' әкелді?
Dialogue: 0,0:38:56.75,0:38:59.54,Default,,0,0,0,,Бұл мені нысанаға алады дегенді білдіре ме?
Dialogue: 0,0:38:59.62,0:39:01.00,Default,,0,0,0,,La Berceuse дегеніміз не?
Dialogue: 0,0:39:01.08,0:39:04.00,Default,,0,0,0,,Ван Гог салған «Бесік тербеткен әйел».
Dialogue: 0,0:39:04.09,0:39:05.96,Default,,0,0,0,,Бұл «күнбағыс» туралы емес.
Dialogue: 0,0:39:06.05,0:39:08.76,Default,,0,0,0,,Жоқ, маңыздысы келесіде...
Dialogue: 0,0:39:08.84,0:39:10.93,Default,,0,0,0,,«Бірінші сол жақ көшірме»
Dialogue: 0,0:39:11.01,0:39:13.85,Default,,0,0,0,,Сол жақ үш ені жұбына қатысты болуы мүмкін.
Dialogue: 0,0:39:14.43,0:39:16.02,Default,,0,0,0,,Бұл үштік жұп па?
Dialogue: 0,0:39:16.10,0:39:19.77,Default,,0,0,0,,Иә, үш сурет немесе ілулі шиыршықтар жиынтығы...
Dialogue: 0,0:39:19.85,0:39:21.60,Default,,0,0,0,,Жоқ, мен мұны білемін.
Dialogue: 0,0:39:21.69,0:39:23.44,Default,,0,0,0,,- (Когоро) Не? - (Директор) Одан да көп.
Dialogue: 0,0:39:23.52,0:39:26.53,Default,,0,0,0,,Неліктен Ла Берсеузе «Күнбағыс» деп аталады?
Dialogue: 0,0:39:26.61,0:39:29.11,Default,,0,0,0,,Бұл... неге?
Dialogue: 0,0:39:29.20,0:39:30.53,Default,,0,0,0,,…сен өте әдемісің
Dialogue: 0,0:39:30.61,0:39:32.36,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:39:30.61,0:39:32.36,Default,,0,0,0,,Мықты бол, сен самурайсың!
Dialogue: 0,0:39:32.36,0:39:33.16,Default,,0,0,0,,Мықты бол, сен самурайсың!
Dialogue: 0,0:39:33.24,0:39:35.66,Default,,0,0,0,,Қосымша ақпарат алу үшін мен хабарламаның шифрын аштым.
Dialogue: 0,0:39:35.74,0:39:38.33,Default,,0,0,0,,Неліктен Кодзи Хигашиден түсіндіруді сұрамайсың?
Dialogue: 0,0:39:38.41,0:39:39.83,Default,,0,0,0,,О, дұрыс.
Dialogue: 0,0:39:39.91,0:39:41.25,Default,,0,0,0,,Хигаши Жақсы ма?
Dialogue: 0,0:39:41.33,0:39:42.75,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:39:42.83,0:39:45.09,Default,,0,0,0,,Детектив Мори бұрын бірдеңе деді...
Dialogue: 0,0:39:45.17,0:39:47.46,Default,,0,0,0,,Үш жақты жұп дұрыс деп есептей отырып.
Dialogue: 0,0:39:47.55,0:39:50.84,Default,,0,0,0,,Ла Берсеусты ортаға қойып көріңіз.
Dialogue: 0,0:39:50.93,0:39:51.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:52.47,0:39:54.76,Default,,0,0,0,,Осы уақытта қандай суреттерді сол және оң жаққа қою керек?
Dialogue: 0,0:39:54.85,0:39:56.31,Default,,0,0,0,,- (Директор) Ах... «Күнбағыс» - (Бағыныңқы) Ах.
Dialogue: 0,0:39:56.39,0:39:57.64,Default,,0,0,0,,Иә
Dialogue: 0,0:39:58.14,0:40:00.52,Default,,0,0,0,,Менің ағам Теоға жіберілген хатта
Dialogue: 0,0:40:00.60,0:40:03.73,Default,,0,0,0,,Онда тіпті иллюстрациялар бар екені даусыз.
Dialogue: 0,0:40:04.23,0:40:07.19,Default,,0,0,0,,Ал егер суретті осы суретте көрсетілгендей орналастырсаңыз,
Dialogue: 0,0:40:07.69,0:40:11.07,Default,,0,0,0,,Ла Берсеузаның сол және оң жағына қою керек күнбағыстар
Dialogue: 0,0:40:11.57,0:40:13.74,Default,,0,0,0,,Оң жақтағы 3-ші және 7-ші суреттер
Dialogue: 0,0:40:14.24,0:40:16.99,Default,,0,0,0,,4-ші, 5-ші және 6-шы суреттер сол жақта.
Dialogue: 0,0:40:17.49,0:40:19.37,Default,,0,0,0,,Осының сол жағында
Dialogue: 0,0:40:19.45,0:40:21.75,Default,,0,0,0,,Ал «Күнбағыстың» бірінші данасы
Dialogue: 0,0:40:21.83,0:40:23.87,Default,,0,0,0,,Осы мұражайда қойылған —
Dialogue: 0,0:40:23.96,0:40:26.42,Default,,0,0,0,,Бұл бесінші «күнбағыс».
Dialogue: 0,0:40:26.92,0:40:28.50,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:40:28.59,0:40:32.34,Default,,0,0,0,,Әрине, біздің мұражайдың «күнбағыстары» нысанаға алынған сияқты.
Dialogue: 0,0:40:32.42,0:40:35.85,Default,,0,0,0,,Сонымен не істеуіміз керек...
Dialogue: 0,0:40:35.93,0:40:38.35,Default,,0,0,0,,Балалар қылмысы туралы хабарлама бүгін түнде.
Dialogue: 0,0:40:38.43,0:40:41.48,Default,,0,0,0,,«Күнбағысты» дереу қауіпсіз жерге көшірмесек...
Dialogue: 0,0:40:41.56,0:40:43.56,Default,,0,0,0,,Күтілгендей, дәл қазір емес...
Dialogue: 0,0:40:43.64,0:40:44.85,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:40:44.94,0:40:48.57,Default,,0,0,0,,Біз тұтынушыға жағдайды түсіндіріп, дүкенді ертерек жабуға тырысамыз.
Dialogue: 0,0:40:48.65,0:40:50.69,Default,,0,0,0,,Ынтымақтастық үшін рахмет.
Dialogue: 0,0:41:00.24,0:41:03.16,Default,,0,0,0,,Жарайды, жарайды, ақырын, иә.
Dialogue: 0,0:41:03.25,0:41:04.04,Default,,0,0,0,,Тек түзу жүре беріңіз.
Dialogue: 0,0:41:04.04,0:41:05.33,Default,,0,0,0,,Тек түзу жүре беріңіз.
Dialogue: 0,0:41:04.04,0:41:05.33,Default,,0,0,0,,Бізге де бір нәрсе
Dialogue: 0,0:41:05.42,0:41:07.13,Default,,0,0,0,,Мен көмектесу үшін бірдеңе істей аламын ба?
Dialogue: 0,0:41:05.42,0:41:07.13,Default,,0,0,0,,Жарайды, енді мына жәшікке бар.
Dialogue: 0,0:41:07.13,0:41:07.21,Default,,0,0,0,,Жарайды, енді мына жәшікке бар.
Dialogue: 0,0:41:07.21,0:41:08.09,Default,,0,0,0,,Жарайды, енді мына жәшікке бар.
Dialogue: 0,0:41:07.21,0:41:08.09,Default,,0,0,0,,Иә.
Dialogue: 0,0:41:08.17,0:41:11.05,Default,,0,0,0,,Гепард тасымалдаушы Ишимине күткендей.
Dialogue: 0,0:41:11.13,0:41:13.30,Default,,0,0,0,,Мен 30 минутта осыншама жерге жетемін деп ойламадым...
Dialogue: 0,0:41:13.38,0:41:16.72,Default,,0,0,0,,Күн батқанша бір сағатта үлгеретін сияқтымыз.
Dialogue: 0,0:41:16.72,0:41:17.60,Default,,0,0,0,,Күн батқанша бір сағатта үлгеретін сияқтымыз.
Dialogue: 0,0:41:16.72,0:41:17.60,Default,,0,0,0,,О
Dialogue: 0,0:41:17.68,0:41:19.64,Default,,0,0,0,,Иә, баяу
Dialogue: 0,0:41:19.72,0:41:20.72,Default,,0,0,0,,Иә, солай
Dialogue: 0,0:41:20.81,0:41:23.06,Default,,0,0,0,,Біз көмектесе алатын нәрсе бар ма?
Dialogue: 0,0:41:23.14,0:41:24.56,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:41:24.64,0:41:28.44,Default,,0,0,0,,Мен оны орап жатқанда, қақпақты жақын ұстаңыз.
Dialogue: 0,0:41:28.52,0:41:29.40,Default,,0,0,0,,Оны алып кетуге келген анасымен бірге —
Dialogue: 0,0:41:29.48,0:41:31.44,Default,,0,0,0,,Нацуми Қақпақты көтеріп алайық.
Dialogue: 0,0:41:31.53,0:41:32.44,Default,,0,0,0,,Иә
Dialogue: 0,0:41:34.86,0:41:36.11,Default,,0,0,0,,А, мен саған көмектесемін.
Dialogue: 0,0:41:36.20,0:41:38.12,Default,,0,0,0,,Күте тұрыңыз, біз сізге көмектесеміз.
Dialogue: 0,0:41:38.20,0:41:42.33,Default,,0,0,0,,Топтан тыс адамдардың араласуы Ишимин мырзаға ұнамайды.
Dialogue: 0,0:41:42.41,0:41:44.58,Default,,0,0,0,,Иә, мен тек сенің сезіміңді қалаймын.
Dialogue: 0,0:41:44.66,0:41:45.71,Default,,0,0,0,,Камадо!
Dialogue: 0,0:41:45.79,0:41:48.54,Default,,0,0,0,,Жарайсың ба? Мен оны көтеремін, өйткені бәрі жақсы.
Dialogue: 0,0:41:50.79,0:41:53.05,Default,,0,0,0,,- (Жұмысшы) Орау бітті - (Ишимине) Еңбегіңізге рахмет.
Dialogue: 0,0:41:53.13,0:41:55.13,Default,,0,0,0,,- (Кумико) Қақпақты әкелдім - (Ишимине) Ой, кешір.
Dialogue: 0,0:41:55.22,0:41:56.05,Default,,0,0,0,,Енді біз...
Dialogue: 0,0:41:56.05,0:41:56.97,Default,,0,0,0,,Енді біз...
Dialogue: 0,0:41:56.05,0:41:56.97,Default,,0,0,0,,Біз дайынбыз
Dialogue: 0,0:41:57.05,0:41:59.55,Default,,0,0,0,,Сейфті тексеру керек емес пе?
Dialogue: 0,0:41:59.64,0:42:01.06,Default,,0,0,0,,Ах, дұрыс.
Dialogue: 0,0:42:01.14,0:42:03.27,Default,,0,0,0,,Директор! Бұл жақсы ма?
Dialogue: 0,0:42:03.89,0:42:05.52,Default,,0,0,0,,Чарли дұрыс айтады.
Dialogue: 0,0:42:05.60,0:42:07.94,Default,,0,0,0,,Қылмыс туралы хабарлама бүгін түнде болғандықтан.
Dialogue: 0,0:42:08.02,0:42:10.27,Default,,0,0,0,,Бала сейфтен ұрлауы керек.
Dialogue: 0,0:42:10.36,0:42:12.27,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:42:12.82,0:42:14.57,Default,,0,0,0,,Мәселе жоқ, жалғастырыңыз.
Dialogue: 0,0:42:14.65,0:42:15.53,Default,,0,0,0,,Иә
Dialogue: 0,0:42:16.11,0:42:17.45,Default,,0,0,0,,Сол жігіт осы сапарға қосыла алмайды!
Dialogue: 0,0:42:17.53,0:42:19.45,Default,,0,0,0,,Қақпақтың артқы жағында не бар?
Dialogue: 0,0:42:19.53,0:42:20.95,Default,,0,0,0,,- (Когоро) Ей, бала - Уау, а...
Dialogue: 0,0:42:21.03,0:42:23.62,Default,,0,0,0,,Уақытыңыз аз кезде шу көтермеңіз!
Dialogue: 0,0:42:23.70,0:42:25.41,Default,,0,0,0,,Бірақ балалар картасы сияқты нәрсе
Dialogue: 0,0:42:25.50,0:42:26.96,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:42:27.04,0:42:29.21,Default,,0,0,0,,- (Ишимине) Қақпақты көтеріңіз - (Жұмысшы) Иә.
Dialogue: 0,0:42:30.13,0:42:31.46,Default,,0,0,0,,-Аа - (Ишимин) Ммм...
Dialogue: 0,0:42:33.17,0:42:35.13,Default,,0,0,0,,Бұл карта. Бұл...
Dialogue: 0,0:42:35.21,0:42:36.76,Default,,0,0,0,,Нацуми-сан, мұнда кел.
Dialogue: 0,0:42:36.84,0:42:38.13,Default,,0,0,0,,А... иә
Dialogue: 0,0:42:38.76,0:42:41.14,Default,,0,0,0,,Қате болма, бұл балалар картасы.
Dialogue: 0,0:42:44.97,0:42:46.77,Default,,0,0,0,,Сіз оны алдыңыз ба?
Dialogue: 0,0:42:46.85,0:42:48.81,Default,,0,0,0,,«Күнбағыс» осында емес пе?
Dialogue: 0,0:42:48.89,0:42:49.94,Default,,0,0,0,,- Барлығы осы ма? - (Накамори) Иә?
Dialogue: 0,0:42:50.02,0:42:51.81,Default,,0,0,0,,Мұның бәрі айтылған ба?
Dialogue: 0,0:42:51.90,0:42:53.61,Default,,0,0,0,,- (Накамори) Ах - (Джирокичи) Сіз нені айтып тұрсыз?
Dialogue: 0,0:42:53.69,0:42:56.53,Default,,0,0,0,,Мұндағы «күнбағыс» әлдеқашан... дегенге сене алмадым.
Dialogue: 0,0:42:56.61,0:42:58.40,Default,,0,0,0,,Иә? Бұл жалған ба?
Dialogue: 0,0:42:58.49,0:43:00.86,Default,,0,0,0,,(Барлығы күңкілдейді)
Dialogue: 0,0:43:01.87,0:43:02.74,Default,,0,0,0,,Фу…
Dialogue: 0,0:43:06.50,0:43:07.71,Default,,0,0,0,,Хмм...
Dialogue: 0,0:43:07.79,0:43:11.00,Default,,0,0,0,,Мен Кид қылмыс уақыты туралы өтірік айтады деп ойламадым.
Dialogue: 0,0:43:11.08,0:43:14.25,Default,,0,0,0,,Аа, мен оны осы уақытқа дейін көрген Баладан елестете алмаймын.
Dialogue: 0,0:43:14.34,0:43:14.96,Default,,0,0,0,,Жоқ, жоқ... бірдеңе дұрыс емес.
Dialogue: 0,0:43:14.96,0:43:17.30,Default,,0,0,0,,Жоқ, жоқ... бірдеңе дұрыс емес.
Dialogue: 0,0:43:14.96,0:43:17.30,Default,,0,0,0,,Сіз шынымен алданып қалдыңыз ба?
Dialogue: 0,0:43:17.38,0:43:19.01,Default,,0,0,0,,Ол бәрібір ұры
Dialogue: 0,0:43:19.09,0:43:21.76,Default,,0,0,0,,Ұрлау үшін бәрін жасайды
Dialogue: 0,0:43:21.84,0:43:24.81,Default,,0,0,0,,Бұл кісі өлтіру болса да
Dialogue: 0,0:43:26.02,0:43:26.85,Default,,0,0,0,,Фу…
Dialogue: 0,0:43:26.93,0:43:28.31,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:43:29.48,0:43:32.94,Default,,0,0,0,,Егер ол жалған болса, ол өте жақсы жасалған.
Dialogue: 0,0:43:33.69,0:43:36.86,Default,,0,0,0,,Бұл жерде нақты баға беру қиын.
Dialogue: 0,0:43:36.94,0:43:38.65,Default,,0,0,0,,Демек, әркімнің қабілеттері әртүрлі болады екен ғой? Хмм…
Dialogue: 0,0:43:38.74,0:43:40.90,Default,,0,0,0,,Бізге сеніп тапсырылғаннан кейін
Dialogue: 0,0:43:40.99,0:43:42.28,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:43:42.36,0:43:46.20,Default,,0,0,0,,Біздің шеберхана бірден дәл бағалауға мүмкіндік береді.
Dialogue: 0,0:43:46.29,0:43:47.87,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:43:47.95,0:43:51.21,Default,,0,0,0,,Егер оның жалғанмен ауыстырылған болу мүмкіндігі жоғары болса
Dialogue: 0,0:43:51.29,0:43:54.08,Default,,0,0,0,,Сіз жоғарыдан рұқсат алатын шығарсыз.
Dialogue: 0,0:43:54.59,0:43:56.05,Default,,0,0,0,,Мұның қажеті жоқ.
Dialogue: 0,0:43:56.13,0:43:57.00,Default,,0,0,0,,- (Күзетші) Директор - (Бағынышты) Ах!
Dialogue: 0,0:43:57.59,0:43:59.21,Default,,0,0,0,,Не деп тұрсың, жігіт?
Dialogue: 0,0:43:59.30,0:44:00.92,Default,,0,0,0,,Сіз өте дөрекісіз!
Dialogue: 0,0:44:01.01,0:44:02.59,Default,,0,0,0,,О... бұл...
Dialogue: 0,0:44:02.68,0:44:04.09,Default,,0,0,0,,Кайто Бала!
Dialogue: 0,0:44:04.18,0:44:05.05,Default,,0,0,0,,А...
Dialogue: 0,0:44:05.14,0:44:08.18,Default,,0,0,0,,Түсінемін, бұл бағалаудың өзі Баланың тұзағы!
Dialogue: 0,0:44:08.27,0:44:10.73,Default,,0,0,0,,Сол «күнбағыс» сөзсіз шындық.
Dialogue: 0,0:44:10.81,0:44:12.39,Default,,0,0,0,,Мен кепілдік беремін...
Dialogue: 0,0:44:12.48,0:44:13.35,Default,,0,0,0,,- (Күзетші) Йотто - (Директор) Ах!
Dialogue: 0,0:44:16.07,0:44:16.94,Default,,0,0,0,,-Хехехе... -Ах
Dialogue: 0,0:44:17.02,0:44:19.99,Default,,0,0,0,,Бала! Сен мені өте жақсы алдадың.
Dialogue: 0,0:44:21.86,0:44:23.86,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:44:23.95,0:44:25.20,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:44:26.20,0:44:27.74,Default,,0,0,0,,- Кя! -(Шығыс) Уф.
Dialogue: 0,0:44:27.83,0:44:30.00,Default,,0,0,0,,Азума-сан, Миядай-сан, жақсысың ба?
Dialogue: 0,0:44:30.08,0:44:32.00,Default,,0,0,0,,Әй, айтпақшы, «Күнбағысты» алып кетті!
Dialogue: 0,0:44:32.08,0:44:33.54,Default,,0,0,0,,Баланы ұстаңыз
Dialogue: 0,0:44:33.62,0:44:35.13,Default,,0,0,0,,- (Когоро) Не! - (Накамори) «Күнбағыс»?
Dialogue: 0,0:44:35.21,0:44:37.29,Default,,0,0,0,,Иә
Dialogue: 0,0:44:37.38,0:44:41.01,Default,,0,0,0,,(Барлығы жөтеледі)
Dialogue: 0,0:44:41.09,0:44:43.05,Default,,0,0,0,,Күте тұрыңыз! бала
Dialogue: 0,0:44:43.80,0:44:45.18,Default,,0,0,0,,Бұл Накамори
Dialogue: 0,0:44:45.26,0:44:47.22,Default,,0,0,0,,Бала «Күнбағысты» ұрлап, қашып кетті!
Dialogue: 0,0:44:47.30,0:44:50.14,Default,,0,0,0,,Оның шатырда пайда болу ықтималдығы жоғары. Сақ болыңыз!
Dialogue: 0,0:44:50.22,0:44:51.35,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:44:55.98,0:44:58.40,Default,,0,0,0,,Бала табылды! Мен төбенің басындамын
Dialogue: 0,0:44:58.48,0:45:00.28,Default,,0,0,0,,(Чарлидің ауыр тыныс алуы)
Dialogue: 0,0:45:00.36,0:45:01.24,Default,,0,0,0,,Уф
Dialogue: 0,0:45:01.86,0:45:03.03,Default,,0,0,0,,Иә
Dialogue: 0,0:45:03.11,0:45:04.28,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:45:04.36,0:45:06.16,Default,,0,0,0,,Нашар, қашып кетуге болады.
Dialogue: 0,0:45:06.66,0:45:08.45,Default,,0,0,0,,Менде мылтық болғанша...
Dialogue: 0,0:45:08.53,0:45:11.45,Default,,0,0,0,,Кайто Кид сансыз ұшатын нысандарды ұшыруда.
Dialogue: 0,0:45:12.12,0:45:13.66,Default,,0,0,0,,Баланы жоғалтты
Dialogue: 0,0:45:13.75,0:45:15.21,Default,,0,0,0,,Не? Мұқият іздеңіз!
Dialogue: 0,0:45:15.29,0:45:18.21,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,0:45:23.05,0:45:24.09,Default,,0,0,0,,Міне!
Dialogue: 0,0:45:25.68,0:45:27.34,Default,,0,0,0,,Қарғыс атсын... Мен жеңілдім!
Dialogue: 0,0:45:27.43,0:45:28.35,Default,,0,0,0,,Ол қайда!
Dialogue: 0,0:45:29.10,0:45:30.60,Default,,0,0,0,,Мен енді мұны істей алмаймын.
Dialogue: 0,0:45:30.68,0:45:34.10,Default,,0,0,0,,Боқ... бұл не деген.
Dialogue: 0,0:45:34.18,0:45:37.60,Default,,0,0,0,,Болжағандай, түнде ұрлап кеткен.
Dialogue: 0,0:45:37.69,0:45:38.90,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:45:44.40,0:45:47.28,Default,,0,0,0,,Бұл менің төс қалтамдағы бала —
Dialogue: 0,0:45:47.36,0:45:49.20,Default,,0,0,0,,Бұл мен қалдырған карта.
Dialogue: 0,0:46:02.80,0:46:06.22,Default,,0,0,0,,«Егер бұл мүмкін болмаса, мен сенімен жұмыс істемеймін♪ Кайто Кид»
Dialogue: 0,0:46:06.30,0:46:08.18,Default,,0,0,0,,2 сағатта 10 млрд?
Dialogue: 0,0:46:08.26,0:46:11.97,Default,,0,0,0,,Сонымен, Кидтің мақсаты басынан бастап ақша болды ма?
Dialogue: 0,0:46:12.06,0:46:12.97,Default,,0,0,0,,Хмм.
Dialogue: 0,0:46:13.06,0:46:16.23,Default,,0,0,0,,Бірақ ол неге сонша өзгерді?
Dialogue: 0,0:46:16.85,0:46:18.77,Default,,0,0,0,,Қандай да бір себеп болуы керек
Dialogue: 0,0:46:18.85,0:46:20.69,Default,,0,0,0,,Әлде жалғанба?
Dialogue: 0,0:46:20.77,0:46:22.19,Default,,0,0,0,,Біздің мұражайда
Dialogue: 0,0:46:22.27,0:46:25.36,Default,,0,0,0,,2 сағатта 10 миллиард иен дайындалуда...
Dialogue: 0,0:46:25.44,0:46:28.07,Default,,0,0,0,,Кім мұндай бейқамдық жасай алады?
Dialogue: 0,0:46:28.16,0:46:31.07,Default,,0,0,0,,Мен Жапонияда жалғыз қаламын деп ойламаймын.
Dialogue: 0,0:46:31.16,0:46:34.20,Default,,0,0,0,,Жарайды. Мен ақшаны дайындаймын.
Dialogue: 0,0:46:34.29,0:46:37.00,Default,,0,0,0,,- (Директор) Бұл рас па? -(Джирокичи) Дегенмен, шарттары бар.
Dialogue: 0,0:46:37.08,0:46:39.83,Default,,0,0,0,,Біз «Күнбағысты» қауіпсіз қалпына келтірген кезде
Dialogue: 0,0:46:39.92,0:46:42.09,Default,,0,0,0,,Оны менің көрмесіме беруіңізді қалаймын.
Dialogue: 0,0:46:42.17,0:46:43.42,Default,,0,0,0,,Әрине!
Dialogue: 0,0:46:43.50,0:46:47.01,Default,,0,0,0,,Егер біз оны шынымен қайтара алсақ, жоғары жақтағылар қарсылық білдірмейді.
Dialogue: 0,0:46:47.09,0:46:49.89,Default,,0,0,0,,Сонымен қалған бес бөліктің иелері.
Dialogue: 0,0:46:49.97,0:46:52.51,Default,,0,0,0,,Сіз мені осы мұражайдан көндіре аласыз ба?
Dialogue: 0,0:46:52.60,0:46:55.27,Default,,0,0,0,,Түсіндім, бар күшімді саламын.
Dialogue: 0,0:46:55.35,0:46:56.27,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:46:56.35,0:46:58.19,Default,,0,0,0,,Жарайды, келіссөздер аяқталды!
Dialogue: 0,0:46:58.27,0:46:59.81,Default,,0,0,0,,Біз бірден қонақүйге барамыз!
Dialogue: 0,0:46:59.94,0:47:00.81,Default,,0,0,0,,Иә!
Dialogue: 0,0:47:00.90,0:47:03.82,Default,,0,0,0,,Директор дайын болғаннан кейін дереу кетіңіз.
Dialogue: 0,0:47:03.90,0:47:05.19,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:47:05.90,0:47:08.03,Default,,0,0,0,,Сіз де бірінші барасыз ба? Чарли
Dialogue: 0,0:47:08.11,0:47:10.95,Default,,0,0,0,,Жоқ... Мен маңызды нәрсе алуға бардым.
Dialogue: 0,0:47:11.03,0:47:12.20,Default,,0,0,0,,Маңызды нәрсе бар ма?
Dialogue: 0,0:47:12.28,0:47:15.54,Default,,0,0,0,,Иә, Кидті қамауға алу өте маңызды.
Dialogue: 0,0:47:15.62,0:47:16.91,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:47:17.00,0:47:19.25,Default,,0,0,0,,Мәміле үшін уақытында оралыңыз.
Dialogue: 0,0:47:19.33,0:47:22.79,Default,,0,0,0,,Уайымдамаңыз, міндетті түрде уақытында келіңіз.
Dialogue: 0,0:47:24.59,0:47:28.42,Default,,0,0,0,,Мм... мүмкін болса, сізден тағы бір сұрайын дегенім бар.
Dialogue: 0,0:47:28.51,0:47:30.76,Default,,0,0,0,,Иә? Не айтқың келеді? Айтыңызшы.
Dialogue: 0,0:47:30.84,0:47:35.47,Default,,0,0,0,,Мен елес күнбағыс көрмесіне шақырғым келетін біреу бар.
Dialogue: 0,0:47:35.56,0:47:36.56,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:47:36.64,0:47:39.06,Default,,0,0,0,,Біздің мұражай «Күнбағыс» көрмесінен кейін
Dialogue: 0,0:47:39.14,0:47:43.15,Default,,0,0,0,,Мен маған күнде дерлік келетін кемпірмін...
Dialogue: 0,0:47:43.23,0:47:45.73,Default,,0,0,0,,Әй, әлгі кемпір бүгін де келді, солай ма?
Dialogue: 0,0:47:46.32,0:47:47.99,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:47:48.07,0:47:52.11,Default,,0,0,0,,Сіз оған соншалықты байланып қалдыңыз ба? Басқа суреттерге де мән бермейсің...
Dialogue: 0,0:47:52.20,0:47:53.99,Default,,0,0,0,,Мұңды көзқараспен
Dialogue: 0,0:47:54.07,0:47:57.12,Default,,0,0,0,,Мен «күнбағысқа» қарап тұрмын
Dialogue: 0,0:47:57.20,0:47:58.12,Default,,0,0,0,,Түсінікті.
Dialogue: 0,0:47:58.20,0:48:00.96,Default,,0,0,0,,Аа, көп рахмет.
Dialogue: 0,0:48:01.04,0:48:05.46,Default,,0,0,0,,(телефонның қоңырау үні)
Dialogue: 0,0:48:05.54,0:48:09.21,Default,,0,0,0,,Бұл менмін. Маған әлі де сол нәрсе керек.
Dialogue: 0,0:48:09.30,0:48:10.80,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:48:10.88,0:48:14.30,Default,,0,0,0,,Бұл елде біреуді иемдену сізді қылмыскер етеді.
Dialogue: 0,0:48:14.39,0:48:15.22,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:48:16.05,0:48:19.10,Default,,0,0,0,,Біз ұшақтарды бомбалаған лаңкестерді бақылаусыз қалдыра алмаймыз.
Dialogue: 0,0:48:19.18,0:48:22.73,Default,,0,0,0,,Жарайды. Мен оны бірден дайындаймын.
Dialogue: 0,0:48:22.81,0:48:23.98,Default,,0,0,0,,Рахмет белгісі
Dialogue: 0,0:48:24.06,0:48:28.36,Default,,0,0,0,,1 сағаттан кейін Toto Plaza қонақ үйінің артындағы тұраққа тұрыңыз.
Dialogue: 0,0:48:28.44,0:48:29.99,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:48:34.07,0:48:35.82,Default,,0,0,0,,Мұнда басыңыз Кіру қабылдау бөлмесі
Dialogue: 0,0:48:35.91,0:48:36.87,Default,,0,0,0,,Аномалия жоқ
Dialogue: 0,0:48:36.95,0:48:38.99,Default,,0,0,0,,Апаттық баспалдақтар Күдікті адам табылмады
Dialogue: 0,0:48:39.08,0:48:41.37,Default,,0,0,0,,Нууу... Чикусо
Dialogue: 0,0:48:41.46,0:48:43.12,Default,,0,0,0,,Сіз бұл қарқынмен жете алмайсыз.
Dialogue: 0,0:48:43.21,0:48:45.29,Default,,0,0,0,,- (Чарли) Мен кешігіп қалдым - (Джирокичи) Хмм.
Dialogue: 0,0:48:45.38,0:48:47.29,Default,,0,0,0,,Инспектор Накамори қауіпсіздік туралы не деуге болады?
Dialogue: 0,0:48:47.38,0:48:50.21,Default,,0,0,0,,Полиция барлық кіретін және шығатын жерлерге орналастырылған
Dialogue: 0,0:48:50.30,0:48:52.88,Default,,0,0,0,,Егер сіз қонақүйде болсаңыз, онда ештеңе жоқ.
Dialogue: 0,0:48:52.97,0:48:55.34,Default,,0,0,0,,Болса да, соңғы рет қайталанбайды!
Dialogue: 0,0:48:55.43,0:48:58.14,Default,,0,0,0,,Бұл қонақүйден ешқашан қашпаңыз!
Dialogue: 0,0:48:59.22,0:49:00.68,Default,,0,0,0,,Асығыңыз, уақытымыз жоқ.
Dialogue: 0,0:49:00.77,0:49:02.23,Default,,0,0,0,,Көбірек алып жүр
Dialogue: 0,0:49:04.60,0:49:06.15,Default,,0,0,0,,- (Қара киім) Мен осында қоямын - (Қара киім) Тезірек!
Dialogue: 0,0:49:13.45,0:49:17.37,Default,,0,0,0,,Мм... осы күйде іскерлік келіссөздер жүргізе аламыз ба?
Dialogue: 0,0:49:17.45,0:49:20.12,Default,,0,0,0,,Балаларға арналған нұсқаулар. Олардың соңынан еруден басқа амал жоқ.
Dialogue: 0,0:49:20.20,0:49:23.46,Default,,0,0,0,,Бұдан былай менімен орынсыз сөйлеспеңіз.
Dialogue: 0,0:49:23.54,0:49:26.67,Default,,0,0,0,,Егер олар біз туралы білсе, бәрі бекер.
Dialogue: 0,0:49:26.75,0:49:28.38,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:49:32.01,0:49:33.38,Default,,0,0,0,,Я...
Dialogue: 0,0:49:33.47,0:49:36.05,Default,,0,0,0,,Бірақ неге мұндай жерде?
Dialogue: 0,0:49:36.13,0:49:38.60,Default,,0,0,0,,Мен барлық ақшамды жұмсауым керек пе?
Dialogue: 0,0:49:38.68,0:49:42.02,Default,,0,0,0,,Сіздің таңдауыңыз жоқ, бұл Баланың нұсқаулары.
Dialogue: 0,0:49:42.10,0:49:42.98,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:49:43.06,0:49:44.14,Default,,0,0,0,,Бала! Тыныш бол!
Dialogue: 0,0:49:44.81,0:49:45.98,Default,,0,0,0,,Біраз қорқынышты, иә?
Dialogue: 0,0:49:46.48,0:49:47.77,Default,,0,0,0,,Мониторды көргіңіз келе ме?
Dialogue: 0,0:49:47.85,0:49:50.11,Default,,0,0,0,,Е... иә...
Dialogue: 0,0:49:51.48,0:49:52.40,Default,,0,0,0,,-Ах-(Джирокичи) Иә?
Dialogue: 0,0:49:52.48,0:49:53.78,Default,,0,0,0,,Олар әдемі әйелдер.
Dialogue: 0,0:49:53.86,0:49:55.07,Default,,0,0,0,,Фу…
Dialogue: 0,0:49:55.15,0:49:56.11,Default,,0,0,0,,Жарайды
Dialogue: 0,0:49:56.20,0:49:58.16,Default,,0,0,0,,Рахмет, сіз өте мейірімдісіз.
Dialogue: 0,0:49:58.24,0:49:59.95,Default,,0,0,0,,Мен тек сенің күшіңді алғым келеді.
Dialogue: 0,0:50:00.53,0:50:03.37,Default,,0,0,0,,Сенің көрегендігің мен ептілігің маған көрінді.
Dialogue: 0,0:50:03.45,0:50:06.75,Default,,0,0,0,,Мені балалар өлтіруші деп атағаны рас.
Dialogue: 0,0:50:06.83,0:50:08.25,Default,,0,0,0,,Бұл жай ғана кездейсоқтық болды.
Dialogue: 0,0:50:08.92,0:50:11.21,Default,,0,0,0,,Ал мен әлі бастауыш сыныпта оқимын.
Dialogue: 0,0:50:11.29,0:50:12.88,Default,,0,0,0,,Менде мұндай теріс пікір жоқ.
Dialogue: 0,0:50:12.96,0:50:16.30,Default,,0,0,0,,Егер сіз бірдеңе білсеңіз, маған хабарлаңыз. Тамаша.
Dialogue: 0,0:50:16.38,0:50:17.26,Default,,0,0,0,,Иә
Dialogue: 0,0:50:19.34,0:50:21.18,Default,,0,0,0,,Егер бұл 10 млрд үлкен сома болса
Dialogue: 0,0:50:21.26,0:50:24.60,Default,,0,0,0,,Әдетте шетелдегі шотқа аударуды талап етеді
Dialogue: 0,0:50:24.68,0:50:28.52,Default,,0,0,0,,Сіз қолма-қол ақша сұрағаныңыздан бері оның мағынасы болуы керек.
Dialogue: 0,0:50:28.60,0:50:30.02,Default,,0,0,0,,Қай сату кассасынан—
Dialogue: 0,0:50:30.11,0:50:32.07,Default,,0,0,0,,БАҚ пайда болды ма?
Dialogue: 0,0:50:32.15,0:50:33.44,Default,,0,0,0,,Не айтып тұрсың!
Dialogue: 0,0:50:33.53,0:50:35.90,Default,,0,0,0,,Бұл мәміле туралы тек біз білуіміз керек!
Dialogue: 0,0:50:35.99,0:50:37.15,Default,,0,0,0,,Бұл солай болуы керек.
Dialogue: 0,0:50:37.24,0:50:39.61,Default,,0,0,0,,Барлық газеттер мен станциялар бірінен соң бірі келіп жатыр
Dialogue: 0,0:50:39.70,0:50:40.24,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,0:50:40.24,0:50:41.45,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,0:50:40.24,0:50:41.45,Default,,0,0,0,,Автотұрақ қазірдің өзінде бар
Dialogue: 0,0:50:41.45,0:50:41.53,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,0:50:41.53,0:50:43.41,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,0:50:41.53,0:50:43.41,Default,,0,0,0,,Іс бақылаудан шығып жатыр!
Dialogue: 0,0:50:44.04,0:50:47.12,Default,,0,0,0,,Қонақ үйдің сол жақ кіреберісінің алдында БАҚ хабар тарата бастады.
Dialogue: 0,0:50:47.21,0:50:49.29,Default,,0,0,0,,Бұл Toto Plaza қонақүйінің алдында.
Dialogue: 0,0:50:49.37,0:50:50.54,Default,,0,0,0,,Бала екінші
Dialogue: 0,0:50:50.63,0:50:51.71,Default,,0,0,0,,Тек 5-ші «Күнбағыс»
Dialogue: 0,0:50:51.79,0:50:53.09,Default,,0,0,0,,Сізді қызықтырмайтыны туралы мәлімдеме жасағандықтан...
Dialogue: 0,0:50:53.09,0:50:53.55,Default,,0,0,0,,Сізді қызықтырмайтыны туралы мәлімдеме жасағандықтан...
Dialogue: 0,0:50:53.09,0:50:53.55,Default,,0,0,0,,Қарғыс атсын, балақай!
Dialogue: 0,0:50:53.55,0:50:55.34,Default,,0,0,0,,Қарғыс атсын, балақай!
Dialogue: 0,0:50:55.42,0:50:57.97,Default,,0,0,0,,Шатастыру үшін ақпарат құралдарын пайдалануға тырысасыз ба?
Dialogue: 0,0:50:58.05,0:50:58.97,Default,,0,0,0,,- (Чарли) Инспектор Накамори - (Накамори) Иә?
Dialogue: 0,0:50:59.80,0:51:01.76,Default,,0,0,0,,Егер Кидд оған өзі хабарлаған болса.
Dialogue: 0,0:51:01.85,0:51:04.31,Default,,0,0,0,,Бұл толқу транзакциядан бас тартпайды.
Dialogue: 0,0:51:04.39,0:51:05.27,Default,,0,0,0,,Хмм
Dialogue: 0,0:51:05.35,0:51:06.98,Default,,0,0,0,,Енді уақыт жоқ!
Dialogue: 0,0:51:07.06,0:51:09.23,Default,,0,0,0,,Ақшаны жұмсаудан бас тартыңыз.
Dialogue: 0,0:51:09.73,0:51:11.98,Default,,0,0,0,,Амал жоқ, екі минут бұрын болды.
Dialogue: 0,0:51:12.06,0:51:13.98,Default,,0,0,0,,Тек қақпақты ашық қалдырсаңыз болғаны!
Dialogue: 0,0:51:14.07,0:51:15.94,Default,,0,0,0,,Барлығы аймақтан кетсін!
Dialogue: 0,0:51:16.03,0:51:18.28,Default,,0,0,0,,Директор! Біз көшенің арғы жағындағы бөлмеде күтеміз.
Dialogue: 0,0:51:18.36,0:51:20.07,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:51:20.16,0:51:21.66,Default,,0,0,0,,Тек сонда қал.
Dialogue: 0,0:51:21.74,0:51:24.45,Default,,0,0,0,,- (Қара киім) Ой - (Қара киім) Тезірек.
Dialogue: 0,0:51:26.16,0:51:27.95,Default,,0,0,0,,(жұмыс дыбысы)
Dialogue: 0,0:51:28.04,0:51:31.37,Default,,0,0,0,,А... бәрібір бөлме қандай ыстық.
Dialogue: 0,0:51:31.46,0:51:33.21,Default,,0,0,0,,Терезені ашу керек емес пе?
Dialogue: 0,0:51:33.29,0:51:35.09,Default,,0,0,0,,Мен есімді жоғалтып, қайта оянғаннан бері бәрі бірдей қайталанып келеді.
Dialogue: 0,0:51:35.17,0:51:37.92,Default,,0,0,0,,Бала әрқашан есіктен кіре бермейді.
Dialogue: 0,0:51:38.01,0:51:38.97,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:51:39.05,0:51:41.18,Default,,0,0,0,,Барлық бөлімдер эвакуацияланды.
Dialogue: 0,0:51:41.26,0:51:42.39,Default,,0,0,0,,Жарайды, жақсы.
Dialogue: 0,0:51:42.47,0:51:45.22,Default,,0,0,0,,Әр топ бізден нұсқау алғанша қай жерде күтеді.
Dialogue: 0,0:51:45.31,0:51:46.18,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:51:46.89,0:51:50.39,Default,,0,0,0,,Бұл Бала туралы. Ол міндетті түрде бірдеңе жасайды.
Dialogue: 0,0:51:50.48,0:51:53.27,Default,,0,0,0,,Біз сауданы бастамас бұрын білуіміз керек.
Dialogue: 0,0:51:53.36,0:51:56.53,Default,,0,0,0,,О, не? Бұл ыңғайсыздық...
Dialogue: 0,0:51:56.61,0:51:58.57,Default,,0,0,0,,Бір нәрсе бұрынғыдан өзгеше.
Dialogue: 0,0:52:02.91,0:52:03.78,Default,,0,0,0,,Яби
Dialogue: 0,0:52:03.87,0:52:05.08,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:52:05.16,0:52:06.03,Default,,0,0,0,,Хмм
Dialogue: 0,0:52:07.20,0:52:09.29,Default,,0,0,0,,Жоқ! Қарғыс атсын
Dialogue: 0,0:52:09.37,0:52:10.83,Default,,0,0,0,,Ол... басты кілт!
Dialogue: 0,0:52:12.00,0:52:12.87,Default,,0,0,0,,Әй!
Dialogue: 0,0:52:15.84,0:52:18.88,Default,,0,0,0,,Шүкір, менің уақытым жоқ! Тез кел!
Dialogue: 0,0:52:18.96,0:52:20.22,Default,,0,0,0,,-(Чарли) Кидкиллер -Ах
Dialogue: 0,0:52:20.30,0:52:21.84,Default,,0,0,0,,Не болды!
Dialogue: 0,0:52:22.47,0:52:23.84,Default,,0,0,0,,Жарайды, мін.
Dialogue: 0,0:52:25.89,0:52:27.85,Default,,0,0,0,,Түсіндіре аласыз ба?
Dialogue: 0,0:52:28.35,0:52:30.18,Default,,0,0,0,,Куратор ішкен пластик бөтелке
Dialogue: 0,0:52:30.27,0:52:31.56,Default,,0,0,0,,Су деңгейі көтерілді.
Dialogue: 0,0:52:32.27,0:52:34.56,Default,,0,0,0,,Бөлмедегі ауа қысымы жоғары болуы мүмкін.
Dialogue: 0,0:52:35.52,0:52:36.90,Default,,0,0,0,,Ол не істемекші?
Dialogue: 0,0:52:37.57,0:52:38.82,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:52:38.90,0:52:41.57,Default,,0,0,0,,Бірақ біз бөлмедегі ауа қысымын тезірек қалпына келтіруіміз керек.
Dialogue: 0,0:52:41.65,0:52:42.95,Default,,0,0,0,,Бұл баланың қалауы.
Dialogue: 0,0:52:45.24,0:52:47.87,Default,,0,0,0,,(Екі адам ауыр тыныс алуда)
Dialogue: 0,0:52:49.54,0:52:50.83,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:52:50.91,0:52:54.33,Default,,0,0,0,,Олар не істеп жатыр? Сіз оны бұзуды жоспарлап отырсыз ба?
Dialogue: 0,0:52:54.96,0:52:57.21,Default,,0,0,0,,Сауда 20 секундтан кейін басталады!
Dialogue: 0,0:53:00.46,0:53:01.84,Default,,0,0,0,,Ашылмайды!
Dialogue: 0,0:53:03.01,0:53:06.05,Default,,0,0,0,,Атмосфералық қысымның айырмашылығына байланысты есік іштен итеріліп жатыр!
Dialogue: 0,0:53:06.76,0:53:08.89,Default,,0,0,0,,Олар қалағанын жасайды!
Dialogue: 0,0:53:08.97,0:53:11.52,Default,,0,0,0,,Жарайды, 10 секундтан аз уақыт қалды.
Dialogue: 0,0:53:11.60,0:53:12.85,Default,,0,0,0,,Тек алға!
Dialogue: 0,0:53:12.93,0:53:14.73,Default,,0,0,0,,Қарғыс атсын, 5 секунд бұрын...
Dialogue: 0,0:53:14.81,0:53:17.73,Default,,0,0,0,,４… ３… ２…
Dialogue: 0,0:53:17.81,0:53:19.73,Default,,0,0,0,,1… Нөл!
Dialogue: 0,0:53:21.32,0:53:24.99,Default,,0,0,0,,Ой, не?
Dialogue: 0,0:53:25.07,0:53:28.83,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,0:53:30.37,0:53:31.66,Default,,0,0,0,,Уф
Dialogue: 0,0:53:32.16,0:53:33.21,Default,,0,0,0,,Жарайды, ашайық!
Dialogue: 0,0:53:33.29,0:53:34.54,Default,,0,0,0,,Иә
Dialogue: 0,0:53:35.75,0:53:36.79,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:53:36.88,0:53:38.29,Default,,0,0,0,,Ахх!
Dialogue: 0,0:53:41.38,0:53:43.55,Default,,0,0,0,,Аххх!
Dialogue: 0,0:53:43.63,0:53:45.68,Default,,0,0,0,,Гуаааааааааааааааааааааааааааааааааа...
Dialogue: 0,0:53:47.76,0:53:48.93,Default,,0,0,0,,Бала!
Dialogue: 0,0:53:52.81,0:53:53.68,Default,,0,0,0,,Иә
Dialogue: 0,0:53:56.14,0:53:57.65,Default,,0,0,0,,- Уф - (Чарли) Ах!
Dialogue: 0,0:53:57.73,0:54:00.44,Default,,0,0,0,,Қарғыс атсын, балақай!
Dialogue: 0,0:54:02.65,0:54:04.03,Default,,0,0,0,,О, бұл Бала!
Dialogue: 0,0:54:04.61,0:54:05.74,Default,,0,0,0,,Кидд және Сузуки Зайбатсу
Dialogue: 0,0:54:05.82,0:54:08.07,Default,,0,0,0,,Мәміле туралы ақпарат рас болды!
Dialogue: 0,0:54:08.16,0:54:09.03,Default,,0,0,0,,Ол қашып кетті!
Dialogue: 0,0:54:14.37,0:54:15.96,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:54:16.04,0:54:17.50,Default,,0,0,0,,… …
Dialogue: 0,0:54:17.58,0:54:18.58,Default,,0,0,0,,Бала «Күнбағыс» дейді
Dialogue: 0,0:54:18.67,0:54:19.92,Default,,0,0,0,,Оны әкелдің бе?
Dialogue: 0,0:54:20.00,0:54:21.71,Default,,0,0,0,,А... Мен білмеймін.
Dialogue: 0,0:54:21.80,0:54:23.51,Default,,0,0,0,,О, Чарли, бар!
Dialogue: 0,0:54:23.59,0:54:25.51,Default,,0,0,0,,Кереует үстіндегі суретке қараңдар!
Dialogue: 0,0:54:25.59,0:54:27.01,Default,,0,0,0,,Ha
Dialogue: 0,0:54:27.09,0:54:30.01,Default,,0,0,0,,Балалар! Жарайды, бүлдірдің... Арх.
Dialogue: 0,0:54:30.10,0:54:32.64,Default,,0,0,0,,Чарли мысық... Кидке не болды?
Dialogue: 0,0:54:32.72,0:54:34.43,Default,,0,0,0,,Мен оны сағындым.
Dialogue: 0,0:54:34.52,0:54:36.06,Default,,0,0,0,,Сонымен, «күнбағыс» ше?
Dialogue: 0,0:54:36.14,0:54:38.31,Default,,0,0,0,,Жарайды, «Күнбағыс» қауіпсіз.
Dialogue: 0,0:54:42.40,0:54:43.94,Default,,0,0,0,,- (Директор) А... - (Джирокичи) Ой!
Dialogue: 0,0:54:44.03,0:54:45.82,Default,,0,0,0,,Бұл «күнбағыс» емес пе?
Dialogue: 0,0:54:45.90,0:54:47.32,Default,,0,0,0,,Сіз оны қайтардыңыз!
Dialogue: 0,0:54:47.40,0:54:49.16,Default,,0,0,0,,Иә, бірақ ақша...
Dialogue: 0,0:54:49.24,0:54:52.16,Default,,0,0,0,,Маған бәрібір, бәрібір, мен жасадым!
Dialogue: 0,0:54:52.24,0:54:55.00,Default,,0,0,0,,Қазір баспасөз конференциясы!
Dialogue: 0,0:54:55.08,0:54:58.16,Default,,0,0,0,,және жеңіске жеткен оқушылар финалға шығады.
Dialogue: 0,0:54:58.25,0:54:59.75,Default,,0,0,0,,Кеңесші Сузуки!
Dialogue: 0,0:54:59.83,0:55:02.67,Default,,0,0,0,,Тағы да, менің Phantom Thief Kid-пен кездесуде жеңіске жету туралы ойым.
Dialogue: 0,0:55:02.75,0:55:03.67,Default,,0,0,0,,Айтыңызшы
Dialogue: 0,0:55:03.75,0:55:05.84,Default,,0,0,0,,Бала өте қорқынышты емес
Dialogue: 0,0:55:05.92,0:55:09.09,Default,,0,0,0,,«Күнбағысқа» иелік еткендердің де жаны тыныш.
Dialogue: 0,0:55:09.18,0:55:12.72,Default,,0,0,0,,Хахахахахаха...
Dialogue: 0,0:55:12.80,0:55:16.60,Default,,0,0,0,,Не? Бұл ең жоғары даму ...
Dialogue: 0,0:55:16.68,0:55:20.35,Default,,0,0,0,,(Жаңалықтарды ашу әні)
Dialogue: 0,0:55:20.44,0:55:23.02,Default,,0,0,0,,Сол фантом ұры баладан бері екі рет
Dialogue: 0,0:55:23.11,0:55:26.57,Default,,0,0,0,,Әлемге әйгілі «Күнбағыс» картинасын сақтау өзекті тақырыпқа айналды.
Dialogue: 0,0:55:26.65,0:55:27.86,Default,,0,0,0,,Джирокичи Сузуки жоспарлаған—
Dialogue: 0,0:55:27.86,0:55:28.78,Default,,0,0,0,,Джирокичи Сузуки жоспарлаған—
Dialogue: 0,0:55:27.86,0:55:28.78,Default,,0,0,0,,-(Әйел) Әй, мынаны қарашы -(Ер) А?
Dialogue: 0,0:55:28.78,0:55:28.86,Default,,0,0,0,,-(Әйел) Әй, мынаны қарашы -(Ер) А?
Dialogue: 0,0:55:28.86,0:55:29.53,Default,,0,0,0,,-(Әйел) Әй, мынаны қарашы -(Ер) А?
Dialogue: 0,0:55:28.86,0:55:29.53,Default,,0,0,0,,«Жапонияны аңсаған күнбағыс» көрмесін өткізу шындыққа айналды.
Dialogue: 0,0:55:29.53,0:55:29.61,Default,,0,0,0,,«Жапонияны аңсаған күнбағыс көрмесін» өткізу шындыққа айналды.
Dialogue: 0,0:55:29.61,0:55:30.95,Default,,0,0,0,,«Жапонияны аңсаған күнбағыс көрмесін» өткізу шындыққа айналды.
Dialogue: 0,0:55:29.61,0:55:30.95,Default,,0,0,0,,Қараңдаршы, көрме.
Dialogue: 0,0:55:30.95,0:55:31.03,Default,,0,0,0,,«Жапонияны аңсаған күнбағыс» көрмесін өткізу шындыққа айналды.
Dialogue: 0,0:55:31.03,0:55:32.07,Default,,0,0,0,,«Жапонияны аңсаған күнбағыс көрмесін» өткізу шындыққа айналды.
Dialogue: 0,0:55:31.03,0:55:32.07,Default,,0,0,0,,Менің барғым келеді
Dialogue: 0,0:55:32.07,0:55:32.16,Default,,0,0,0,,«Жапонияны аңсаған күнбағыс көрмесін» өткізу шындыққа айналды.
Dialogue: 0,0:55:32.16,0:55:34.08,Default,,0,0,0,,«Жапонияны аңсаған күнбағыс көрмесін» өткізу шындыққа айналды.
Dialogue: 0,0:55:32.16,0:55:34.08,Default,,0,0,0,,Әй, «Күнбағыс».
Dialogue: 0,0:55:34.16,0:55:36.37,Default,,0,0,0,,Сәйкесінше, әлемнің түкпір-түкпірінен
Dialogue: 0,0:55:36.45,0:55:40.12,Default,,0,0,0,,Ван Гогтың «Күнбағыстары» Жапонияда бірінен соң бірі жиналуда.
Dialogue: 0,0:55:40.21,0:55:42.42,Default,,0,0,0,,Бүгін арнайы қонақ ретінде
Dialogue: 0,0:55:42.50,0:55:45.21,Default,,0,0,0,,«Жапонияны аңсаған күнбағыс көрмесінің» бастамашысы
Dialogue: 0,0:55:45.30,0:55:48.42,Default,,0,0,0,,Джирокичи Сузуки мырзамен, Suzuki Zaibatsu кеңесшісі
Dialogue: 0,0:55:48.51,0:55:51.13,Default,,0,0,0,,Менің жиенім Соноко Судзуки маған қонаққа келді.
Dialogue: 0,0:55:51.22,0:55:52.09,Default,,0,0,0,,Бұл қария кім?
Dialogue: 0,0:55:51.22,0:55:52.09,Default,,0,0,0,,Енді көрмені толық түсіндіріп беріңізші.
Dialogue: 0,0:55:52.09,0:55:52.18,Default,,0,0,0,,Енді көрмені толық түсіндіріп беріңізші.
Dialogue: 0,0:55:52.18,0:55:53.01,Default,,0,0,0,,Енді көрмені толық түсіндіріп беріңізші.
Dialogue: 0,0:55:52.18,0:55:53.01,Default,,0,0,0,,Акаши Кайкё көпірі
Dialogue: 0,0:55:53.01,0:55:53.09,Default,,0,0,0,,Енді көрмені толық түсіндіріп беріңізші.
Dialogue: 0,0:55:53.09,0:55:54.89,Default,,0,0,0,,Енді көрмені толық түсіндіріп беріңізші.
Dialogue: 0,0:55:53.09,0:55:54.89,Default,,0,0,0,,дирижабль соққан адам емес пе?
Dialogue: 0,0:55:55.56,0:55:58.27,Default,,0,0,0,,Көрме орны - Лейк-Рок мұражайы.
Dialogue: 0,0:55:58.35,0:56:00.06,Default,,0,0,0,,Бұл бейтаныс есім.
Dialogue: 0,0:56:00.14,0:56:04.77,Default,,0,0,0,,Мұражай осы көрмеге арнайы салынған.
Dialogue: 0,0:56:04.86,0:56:06.90,Default,,0,0,0,,Хмм, бұл қызық.
Dialogue: 0,0:56:07.48,0:56:10.32,Default,,0,0,0,,Шедеврлерді көрсету үшін оңтайлы орта
Dialogue: 0,0:56:10.40,0:56:13.16,Default,,0,0,0,,Қылмыстың алдын алудың тамаша шараларына қалай қол жеткізуге болады
Dialogue: 0,0:56:13.24,0:56:16.37,Default,,0,0,0,,Біз дизайнды басынан бастап қайта қарауға тура келді.
Dialogue: 0,0:56:16.45,0:56:17.45,Default,,0,0,0,,Хо…
Dialogue: 0,0:56:17.54,0:56:19.54,Default,,0,0,0,,Енді кіріспе бейнероликті көру барысында
Dialogue: 0,0:56:19.62,0:56:22.79,Default,,0,0,0,,Соноко Сузуки түсіндірсін.
Dialogue: 0,0:56:22.87,0:56:24.67,Default,,0,0,0,,Бұл Лейк-рок мұражайы
Dialogue: 0,0:56:24.75,0:56:28.88,Default,,0,0,0,,Біз оны компаниямызға тиесілі әктас үңгірін жақсарту арқылы тұрғыздық.
Dialogue: 0,0:56:28.96,0:56:33.30,Default,,0,0,0,,Жер үстіндегі 8 қабатты ғимарат, әр қабатта көрме залы бар.
Dialogue: 0,0:56:33.38,0:56:36.14,Default,,0,0,0,,Әр қабатта бір-бірден жеті күнбағыс.
Dialogue: 0,0:56:36.22,0:56:38.35,Default,,0,0,0,,Уақытыңызды бөліңіз.
Dialogue: 0,0:56:38.43,0:56:43.06,Default,,0,0,0,,Тұтынушылар жертөленің төменгі қабатына жиналғанда,
Dialogue: 0,0:56:43.14,0:56:45.19,Default,,0,0,0,,Әр қабатта шашылған «Күнбағыс».
Dialogue: 0,0:56:45.27,0:56:48.19,Default,,0,0,0,,Жеке лифтпен 8-ші көрме бөлмесіне барыңыз.
Dialogue: 0,0:56:48.27,0:56:49.94,Default,,0,0,0,,Біз бәрін жылжытамыз
Dialogue: 0,0:56:58.62,0:57:01.66,Default,,0,0,0,,Лифттің шатырға шығуын күтіп тұрғанда
Dialogue: 0,0:57:01.75,0:57:04.37,Default,,0,0,0,,7 «Күнбағыстың» барлығы теңестірілген күй
Dialogue: 0,0:57:04.46,0:57:06.46,Default,,0,0,0,,Қарап шығуға болады.
Dialogue: 0,0:57:06.54,0:57:07.96,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:57:08.04,0:57:11.05,Default,,0,0,0,,Басынан бастап 7 карта бар сияқты емес.
Dialogue: 0,0:57:11.13,0:57:13.09,Default,,0,0,0,,Әрбір «күнбағыстың» кереметтері
Dialogue: 0,0:57:13.17,0:57:16.30,Default,,0,0,0,,Сіз түсінгеніңізді растағаннан кейін айтасыз.
Dialogue: 0,0:57:16.39,0:57:19.31,Default,,0,0,0,,Бұл ғана емес, қауіпсіздік те тамаша.
Dialogue: 0,0:57:19.39,0:57:22.60,Default,,0,0,0,,«Күнбағыста» ауытқу болса, әртүрлі сенсорлар іске қосылады.
Dialogue: 0,0:57:22.68,0:57:26.06,Default,,0,0,0,,Өйткені ол өртке қарсы/су өткізбейтін корпусқа бірден кіруге арналған.
Dialogue: 0,0:57:26.15,0:57:29.61,Default,,0,0,0,,Өрт немесе су тасқыны салдарынан болатын зақым туралы алаңдаудың қажеті жоқ.
Dialogue: 0,0:57:29.69,0:57:32.65,Default,,0,0,0,,Сондай-ақ, «Күнбағыс» мұражай ішінде ұрланған болса да,
Dialogue: 0,0:57:32.74,0:57:34.95,Default,,0,0,0,,Қауіпсіздік жүйесі дереу іске қосылады.
Dialogue: 0,0:57:35.03,0:57:36.66,Default,,0,0,0,,Барлық кірулер мен шығулар жабылады.
Dialogue: 0,0:57:37.32,0:57:40.62,Default,,0,0,0,,Тіпті Кайто Кид бетпердесін киіп, ішке кіріп кетсе де.
Dialogue: 0,0:57:40.70,0:57:42.79,Default,,0,0,0,,Сіз ешқашан қашып құтыла алмайсыз
Dialogue: 0,0:57:42.87,0:57:45.37,Default,,0,0,0,,Барлық қауіпсіздік шаралары орындалған.
Dialogue: 0,0:57:45.46,0:57:47.46,Default,,0,0,0,,Төбеге шығу үшін лифт
Dialogue: 0,0:57:47.54,0:57:50.38,Default,,0,0,0,,Ең аз жарықтандыру және қауіпсіздік жүйелері
Dialogue: 0,0:57:50.46,0:57:51.63,Default,,0,0,0,,ешқашан тоқтамайды
Dialogue: 0,0:57:51.71,0:57:54.38,Default,,0,0,0,,Өзіңіздің электр энергиясын өндіруге бола ма?
Dialogue: 0,0:57:54.47,0:57:56.26,Default,,0,0,0,,Иә, бұл туралы да.
Dialogue: 0,0:57:56.34,0:57:58.85,Default,,0,0,0,,Бейнежазбаны қараңыз.
Dialogue: 0,0:57:59.35,0:58:03.93,Default,,0,0,0,,Алдыңыздағы көлден суды жоғарғы қабаттағы су ыдысына айдаңыз.
Dialogue: 0,0:58:04.02,0:58:08.56,Default,,0,0,0,,Қажет болса, биіктік айырмашылығын пайдалану арқылы су электр энергиясын өндіруге болады.
Dialogue: 0,0:58:09.06,0:58:12.40,Default,,0,0,0,,Бұл сізді шатырға және бір уақытта жіберуге мүмкіндік береді
Dialogue: 0,0:58:13.03,0:58:15.32,Default,,0,0,0,,«Химавари» де арнайы рельсті пайдаланады
Dialogue: 0,0:58:15.40,0:58:19.16,Default,,0,0,0,,Жер үстіндегі апаттық эвакуация қоймасына тасымалданады
Dialogue: 0,0:58:19.99,0:58:22.41,Default,,0,0,0,,Керемет! Тек тамаша!
Dialogue: 0,0:58:22.49,0:58:25.41,Default,,0,0,0,,Күнбағысты қорғайтын алынбас қамал.
Dialogue: 0,0:58:25.50,0:58:29.46,Default,,0,0,0,,Қош бол, осы ең жақсы ортада адамзаттың қазынасы.
Dialogue: 0,0:58:29.54,0:58:32.55,Default,,0,0,0,,Бір уақытта 7 күнбағыс көруге болады...
Dialogue: 0,0:58:33.42,0:58:36.34,Default,,0,0,0,,«Жапонияны аңсаған күнбағыс көрмесі» ғана
Dialogue: 0,0:58:36.42,0:58:38.47,Default,,0,0,0,,- (Джирокичи) Хахахаха... - (Комментатор) Ахаха...
Dialogue: 0,0:58:38.55,0:58:40.22,Default,,0,0,0,,Міне, бұл көрме
Dialogue: 0,0:58:40.30,0:58:43.93,Default,,0,0,0,,Бір ай бойы күніне 100 адамға ашылады деп естідім...
Dialogue: 0,0:58:44.64,0:58:47.35,Default,,0,0,0,,Билет лотереясы қашан басталады?
Dialogue: 0,0:58:47.44,0:58:48.52,Default,,0,0,0,,Бұдан былай
Dialogue: 0,0:58:48.60,0:58:49.56,Default,,0,0,0,,- (Комментатор) А? - (Диктор) Бұл рас па?
Dialogue: 0,0:58:49.65,0:58:53.23,Default,,0,0,0,,Сіз мұны дәл қазір біздің басты бетке кіру арқылы жасай аласыз.
Dialogue: 0,0:58:53.32,0:58:57.32,Default,,0,0,0,,Ол бүкіл әлемде бір уақытта басталады, сондықтан астрономиялық көбейткіш болады.
Dialogue: 0,0:58:57.40,0:59:01.37,Default,,0,0,0,,Барлығыңыз, бұл мүмкіндікті жіберіп алмаңыздар!
Dialogue: 0,0:59:01.45,0:59:02.37,Default,,0,0,0,,А…?
Dialogue: 0,0:59:02.45,0:59:03.87,Default,,0,0,0,,Әй, шықты.
Dialogue: 0,0:59:04.62,0:59:07.62,Default,,0,0,0,,Мен дәрігердің үй желісі болса, жұмыс істейді деп ойладым...
Dialogue: 0,0:59:07.71,0:59:10.04,Default,,0,0,0,,Не, бәрі жеңілген бе?
Dialogue: 0,0:59:10.12,0:59:13.04,Default,,0,0,0,,Дәрігер: Осы экранды бассаңыз не болады?
Dialogue: 0,0:59:13.13,0:59:16.67,Default,,0,0,0,,Сіз тіркеген бірінші бет суреті ресми түрде тіркеледі.
Dialogue: 0,0:59:16.76,0:59:19.59,Default,,0,0,0,,Сіздің ID және PIN нөміріңіз көрсетіледі.
Dialogue: 0,0:59:19.68,0:59:22.30,Default,,0,0,0,,Оны қолданба экранына теріңіз
Dialogue: 0,0:59:22.39,0:59:24.60,Default,,0,0,0,,Билеттер кейінірек келеді.
Dialogue: 0,0:59:24.68,0:59:27.02,Default,,0,0,0,,Дәрігер, мен сізді жақсы білемін.
Dialogue: 0,0:59:27.10,0:59:28.64,Default,,0,0,0,,- (Хайбара) Аа - А... болмайды!
Dialogue: 0,0:59:28.73,0:59:32.15,Default,,0,0,0,,Олай болса дұрыс түсіндің Гуфуфуфуфуфу...
Dialogue: 0,0:59:32.23,0:59:34.65,Default,,0,0,0,,- (Хайбара) Бұл қорқынышты күлкі - (Агаса) Гику
Dialogue: 0,0:59:36.07,0:59:38.53,Default,,0,0,0,,Өтінемін, дәрігер! Маған беріңізші
Dialogue: 0,0:59:38.61,0:59:39.90,Default,,0,0,0,,Мен оны көргім келеді.
Dialogue: 0,0:59:39.99,0:59:41.32,Default,,0,0,0,,- (Гента) Мен де! -(Аюми) Аюми де!
Dialogue: 0,0:59:41.41,0:59:44.41,Default,,0,0,0,,Нихихихихи... Мен оны мүлдем жек көремін!
Dialogue: 0,0:59:44.49,0:59:46.33,Default,,0,0,0,,- (Хайбара) Сіз пісіп-жетілмегенсіз, доктор - (Ағаса) Әй!
Dialogue: 0,0:59:46.41,0:59:48.87,Default,,0,0,0,,- (Гента) Дұрыс, дәрігер! -(Аюми) Сен пісіп-жетілмегенсің!
Dialogue: 0,0:59:48.96,0:59:49.83,Default,,0,0,0,,Бұл жетілмеген!
Dialogue: 0,0:59:49.91,0:59:52.17,Default,,0,0,0,,Қиындыққа тап болдым... Уа?
Dialogue: 0,0:59:52.25,0:59:54.50,Default,,0,0,0,,Егер сіз соншалықты алысқа баратын болсаңыз, викторинамен жарысайық.
Dialogue: 0,0:59:54.59,0:59:55.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:56.17,0:59:57.96,Default,,0,0,0,,Небәрі 3 таңдау болғандықтан, жауап беруге мүмкіндік жоқ
Dialogue: 0,0:59:58.05,1:00:00.17,Default,,0,0,0,,Бәріміз бір рет жасасақ дұрыс емес пе?
Dialogue: 0,1:00:00.26,1:00:01.55,Default,,0,0,0,,- (Гента) О! -(Аюми) Ия!
Dialogue: 0,1:00:01.63,1:00:02.97,Default,,0,0,0,,Дәрігер күткендей!
Dialogue: 0,1:00:03.05,1:00:05.43,Default,,0,0,0,,Енді жарысатын кез келді!
Dialogue: 0,1:00:06.01,1:00:08.73,Default,,0,0,0,,Күнбағыс алқабындағы күнбағыс күнді жақсы көреді
Dialogue: 0,1:00:08.81,1:00:10.98,Default,,0,0,0,,Сізге не ұнамайды?
Dialogue: 0,1:00:11.06,1:00:12.85,Default,,0,0,0,,1 Өрмекші
Dialogue: 0,1:00:12.94,1:00:14.86,Default,,0,0,0,,2 Жылан
Dialogue: 0,1:00:14.94,1:00:16.98,Default,,0,0,0,,3 Скорпион
Dialogue: 0,1:00:17.07,1:00:20.03,Default,,0,0,0,,Қысқасы, өрмекшілер, жыландар, шаяндар.
Dialogue: 0,1:00:20.11,1:00:21.61,Default,,0,0,0,,А, сондықтан жауап ...
Dialogue: 0,1:00:21.70,1:00:24.20,Default,,0,0,0,,Ой, тыһ, шһ, балалар, жауап бермейсіңдер.
Dialogue: 0,1:00:24.28,1:00:25.16,Default,,0,0,0,,Олар үшін де тойып жеңіздер
Dialogue: 0,1:00:25.24,1:00:26.87,Default,,0,0,0,,- (Мицухико) Мен де түсіндім! -(Аюми) Аюми де!
Dialogue: 0,1:00:26.95,1:00:29.00,Default,,0,0,0,,Жауабы 3 саны, шаян, солай ма?
Dialogue: 0,1:00:29.08,1:00:30.87,Default,,0,0,0,,- (Аюми) Ух... - (Мицухико) Бұл дұрыс емес, Гента-кун!
Dialogue: 0,1:00:30.87,1:00:31.75,Default,,0,0,0,,- (Аюми) Ух... - (Мицухико) Бұл дұрыс емес, Гента-кун!
Dialogue: 0,1:00:30.87,1:00:31.75,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:31.83,1:00:34.21,Default,,0,0,0,,Шаяндар улы болғандықтан.
Dialogue: 0,1:00:31.83,1:00:34.21,Default,,0,0,0,,Хехехе... Гухехехе...
Dialogue: 0,1:00:34.21,1:00:34.29,Default,,0,0,0,,Фуфуфуфу… Гуфуфуфуфуфу…
Dialogue: 0,1:00:34.29,1:00:36.42,Default,,0,0,0,,Хехехе... Гухехехе...
Dialogue: 0,1:00:34.29,1:00:36.42,Default,,0,0,0,,Тіпті улы өрмекшілер мен улы жыландар да бар!
Dialogue: 0,1:00:36.50,1:00:37.92,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,1:00:38.00,1:00:41.38,Default,,0,0,0,,Бұл өрмекші. Дұрыс жауап - 1-ші өрмекші.
Dialogue: 0,1:00:41.47,1:00:42.63,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:00:42.72,1:00:44.59,Default,,0,0,0,,Өйткені өрмекшілер бұлт.
Dialogue: 0,1:00:44.68,1:00:46.01,Default,,0,0,0,,- (Гента) Иә? -(Аюми) Қазірдің өзінде
Dialogue: 0,1:00:46.10,1:00:48.56,Default,,0,0,0,,Өрмекші – аспанда қалқып жүрген бұлт.
Dialogue: 0,1:00:48.64,1:00:50.68,Default,,0,0,0,,Өйткені Күнбағыс күнді жақсы көреді
Dialogue: 0,1:00:50.77,1:00:53.85,Default,,0,0,0,,Мен жолға түскен бұлттарды жек көремін.
Dialogue: 0,1:00:53.94,1:00:57.07,Default,,0,0,0,,Не, удың оған қатысы жоқ па?
Dialogue: 0,1:00:57.15,1:00:58.11,Default,,0,0,0,,Сонымен...
Dialogue: 0,1:00:58.19,1:01:02.57,Default,,0,0,0,,Мен билетімді ешкімге бермеймін!
Dialogue: 0,1:01:03.74,1:01:04.61,Default,,0,0,0,,...сонымен
Dialogue: 0,1:01:04.70,1:01:07.99,Default,,0,0,0,,Күнбағысты бәрі көргісі келеді деп ойладым...
Dialogue: 0,1:01:08.08,1:01:09.12,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,1:01:09.20,1:01:10.79,Default,,0,0,0,,Әй, өтінемін.
Dialogue: 0,1:01:10.87,1:01:12.75,Default,,0,0,0,,- (Аюми) Өтінемін - (Мицухико) Өтінемін!
Dialogue: 0,1:01:12.83,1:01:14.79,Default,,0,0,0,,Хмм.
Dialogue: 0,1:01:14.87,1:01:15.75,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:01:15.83,1:01:17.63,Default,,0,0,0,,- Иә? -(3 адам) Ия!
Dialogue: 0,1:01:17.71,1:01:18.67,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,1:01:18.75,1:01:20.46,Default,,0,0,0,,Алайда, Иемізге
Dialogue: 0,1:01:20.55,1:01:23.30,Default,,0,0,0,,Мен сізден ынтымақтастық туралы көбірек сұраймын. Ухахаха...
Dialogue: 0,1:01:23.38,1:01:25.89,Default,,0,0,0,,Танысқаныма қуаныштымын, Кидкиллер-сан
Dialogue: 0,1:01:26.47,1:01:27.97,Default,,0,0,0,,- (Чарли) Кеңесші Сузуки - (Джирокичи) Иә?
Dialogue: 0,1:01:28.05,1:01:29.93,Default,,0,0,0,,Кездесуді тезірек жалғастыру керек.
Dialogue: 0,1:01:30.01,1:01:31.97,Default,,0,0,0,,Хмм, солай емес пе?
Dialogue: 0,1:01:32.06,1:01:34.35,Default,,0,0,0,,Олай болса, мен бәрін түсіремін, үйге қайтайық.
Dialogue: 0,1:01:34.44,1:01:35.31,Default,,0,0,0,,Уа!
Dialogue: 0,1:01:35.40,1:01:39.36,Default,,0,0,0,,Ағай, Ран мен Шиничидің билеттерін ұмытпа.
Dialogue: 0,1:01:39.44,1:01:40.94,Default,,0,0,0,,Уму Ишимина
Dialogue: 0,1:01:41.03,1:01:43.40,Default,,0,0,0,,Кешіріңіз, бірінші барыңыз.
Dialogue: 0,1:01:43.49,1:01:46.61,Default,,0,0,0,,Иә, әр көліктің уақыты мен бағыты анықталғаннан кейін бізге хабарласыңыз.
Dialogue: 0,1:01:46.70,1:01:47.57,Default,,0,0,0,,Хмм
Dialogue: 0,1:01:47.66,1:01:50.45,Default,,0,0,0,,Әй, оны мұражайға қалай апарамыз?
Dialogue: 0,1:01:51.04,1:01:53.20,Default,,0,0,0,,Рейроктың қауіпсіздігі мінсіз болса да
Dialogue: 0,1:01:53.29,1:01:55.50,Default,,0,0,0,,Ең қауіптісі – оны сол жерге жеткізу.
Dialogue: 0,1:01:55.58,1:01:56.67,Default,,0,0,0,,(Камо) Һм. (Фушигиро) Ұф.
Dialogue: 0,1:01:56.75,1:01:59.79,Default,,0,0,0,,Бізде қол жетімді көлік құралдарының көп саны бар.
Dialogue: 0,1:01:59.88,1:02:02.46,Default,,0,0,0,,Қай көліктің шынайы екенін мен ғана білетін адаммын.
Dialogue: 0,1:02:02.55,1:02:05.84,Default,,0,0,0,,Иә, Чарли қауіпсіз.
Dialogue: 0,1:02:05.93,1:02:09.30,Default,,0,0,0,,Бірақ егер сіз оны пайдалануды жоспарласаңыз, оны ұмытпаңыз.
Dialogue: 0,1:02:09.80,1:02:14.85,Default,,0,0,0,,Бұл дүниеде оңай алып кететін өмір жоқ.
Dialogue: 0,1:02:14.93,1:02:16.60,Default,,0,0,0,,Есте сақта
Dialogue: 0,1:02:16.69,1:02:20.48,Default,,0,0,0,,Бірақ егер сіз өз идеалыңызға ұмтылсаңыз, шындық сізді бір күні сатады.
Dialogue: 0,1:02:21.19,1:02:23.48,Default,,0,0,0,,Бұл жолы Кайту Кид сияқты.
Dialogue: 0,1:02:24.07,1:02:26.28,Default,,0,0,0,,Не істеп жатырсың, балақай? Барайық!
Dialogue: 0,1:02:27.16,1:02:28.82,Default,,0,0,0,,А, бәрі күтіп отыр.
Dialogue: 0,1:02:28.91,1:02:30.12,Default,,0,0,0,,-Иә - (Соноко) Ах.
Dialogue: 0,1:02:30.62,1:02:31.87,Default,,0,0,0,,- (Соноко) Сәлем! -(Чарли) О...
Dialogue: 0,1:02:33.41,1:02:36.16,Default,,0,0,0,,Я, сен оны жек көрдің.
Dialogue: 0,1:02:36.25,1:02:37.33,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:02:39.13,1:02:42.25,Default,,0,0,0,,Құрметті күйеу, жеткізу хабармен келді...
Dialogue: 0,1:02:42.34,1:02:44.17,Default,,0,0,0,,Хмм, сәттілік.
Dialogue: 0,1:02:44.26,1:02:47.38,Default,,0,0,0,,Бұл кім? Мен оны компанияның орнына маған жібереді деп күтпедім.
Dialogue: 0,1:02:47.47,1:02:50.05,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,1:02:50.14,1:02:52.72,Default,,0,0,0,,Тыныш! Люпин
Dialogue: 0,1:02:52.81,1:02:54.64,Default,,0,0,0,,-Бір! Ой - (Чарли) Хмм...
Dialogue: 0,1:02:54.72,1:02:57.02,Default,,0,0,0,,Сіз мүлде бұзылып қалдыңыз... Иә?
Dialogue: 0,1:02:57.60,1:02:59.65,Default,,0,0,0,,Жарайды... болмайды... Бала!
Dialogue: 0,1:02:59.73,1:03:01.86,Default,,0,0,0,,Иә?
Dialogue: 0,1:03:01.94,1:03:03.15,Default,,0,0,0,,Мен Буггарати туралы білуге тиіс барлық нәрсені білемін.
Dialogue: 0,1:03:03.23,1:03:06.61,Default,,0,0,0,,Бұл, әрине, балалар картасы. Бұл туралы ше?
Dialogue: 0,1:03:06.69,1:03:08.65,Default,,0,0,0,,Бұл сыйлыққа ұқсайды...
Dialogue: 0,1:03:08.74,1:03:10.20,Default,,0,0,0,,Иә?
Dialogue: 0,1:03:10.28,1:03:12.53,Default,,0,0,0,,Уау! Не?
Dialogue: 0,1:03:13.24,1:03:14.66,Default,,0,0,0,,Не болды, Люпин?
Dialogue: 0,1:03:14.74,1:03:16.66,Default,,0,0,0,,Кеңесші, артқа шегініңіз.
Dialogue: 0,1:03:17.16,1:03:19.50,Default,,0,0,0,,Жетер, Люпин, қайт.
Dialogue: 0,1:03:19.58,1:03:20.71,Default,,0,0,0,,Не? (Люпиннің үрейлі дауысы)
Dialogue: 0,1:03:20.79,1:03:23.34,Default,,0,0,0,,Бұл жағымсыз иіс пен тұтанғыштық... бұл фосфин бе?
Dialogue: 0,1:03:23.88,1:03:26.34,Default,,0,0,0,,Жанғыш сұйықтық. Барлығыңыз бөлмеден шығыңыздар!
Dialogue: 0,1:03:26.42,1:03:27.76,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:03:28.59,1:03:29.68,Default,,0,0,0,,Уф
Dialogue: 0,1:03:31.51,1:03:33.76,Default,,0,0,0,,Уф... Уф!
Dialogue: 0,1:03:33.85,1:03:35.64,Default,,0,0,0,,Амансың ба? Чарли
Dialogue: 0,1:03:35.72,1:03:37.35,Default,,0,0,0,,Иә, қазір бәрі жақсы.
Dialogue: 0,1:03:37.43,1:03:39.44,Default,,0,0,0,,Инспектор Накамориге дереу хабарласыңыз.
Dialogue: 0,1:03:39.52,1:03:40.39,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,1:03:40.48,1:03:44.52,Default,,0,0,0,,Сіз сенімдісіз бе? Бұл өмірге қауіп төндіретін оқиға
Dialogue: 0,1:03:44.61,1:03:47.53,Default,,0,0,0,,Полицияға хабарласаңыз, көрме кейінге шегеріледі...
Dialogue: 0,1:03:48.19,1:03:50.91,Default,,0,0,0,,Ең нашар жағдайда, ол жойылуы мүмкін.
Dialogue: 0,1:03:50.99,1:03:52.03,Default,,0,0,0,,Нугугугугу…
Dialogue: 0,1:03:52.62,1:03:55.91,Default,,0,0,0,,Мүмкін Чарли дұрыс шығар.
Dialogue: 0,1:03:55.99,1:03:57.12,Default,,0,0,0,,Түсіндім
Dialogue: 0,1:03:57.20,1:04:01.04,Default,,0,0,0,,Бұл мәселе бойынша сіздердің айтар сөздеріңіз жоқ деп үміттенемін.
Dialogue: 0,1:04:01.92,1:04:03.79,Default,,0,0,0,,- (Кейко) Ах... - (Кумико) Түсіндім.
Dialogue: 0,1:04:04.29,1:04:08.05,Default,,0,0,0,,О, тамаша, Люпин, мен мұны енді ғана түсіндім.
Dialogue: 0,1:04:08.13,1:04:09.09,Default,,0,0,0,,Чарли
Dialogue: 0,1:04:09.17,1:04:11.05,Default,,0,0,0,,Қалай болғанда да, бұл бөлмені жауып алайық.
Dialogue: 0,1:04:11.13,1:04:12.09,Default,,0,0,0,,О
Dialogue: 0,1:04:14.60,1:04:15.68,Default,,0,0,0,,Хмм…
Dialogue: 0,1:04:16.72,1:04:19.56,Default,,0,0,0,,Кайто Кид ақыры өзінің шынайы болмысын көрсетті.
Dialogue: 0,1:04:20.77,1:04:22.56,Default,,0,0,0,,Енді мейірімділік жоқ
Dialogue: 0,1:04:30.74,1:04:33.28,Default,,0,0,0,,(Көліктің кері сигналы)
Dialogue: 0,1:04:33.36,1:04:35.74,Default,,0,0,0,,Жарайды
Dialogue: 0,1:04:35.83,1:04:36.95,Default,,0,0,0,,Гү… гүг… Дұрыс.
Dialogue: 0,1:04:37.03,1:04:40.50,Default,,0,0,0,,Сіз қанша муляж дайындауды жоспарлап отырсыз?
Dialogue: 0,1:04:40.58,1:04:43.46,Default,,0,0,0,,Одан гөрі бұл мәселе туралы бұрын не ойлайсыз?
Dialogue: 0,1:04:43.54,1:04:44.42,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:04:44.50,1:04:45.88,Default,,0,0,0,,Баланың мотиві
Dialogue: 0,1:04:45.96,1:04:49.17,Default,,0,0,0,,«Жапонияны аңсаған күнбағыс көрмесі» жойылса
Dialogue: 0,1:04:49.26,1:04:50.55,Default,,0,0,0,,Лейк-рок мұражайынан
Dialogue: 0,1:04:50.63,1:04:53.51,Default,,0,0,0,,2-ші және 5-ші «Күнбағыс» шығады.
Dialogue: 0,1:04:54.39,1:04:56.55,Default,,0,0,0,,Сізде ұрлауға тағы бір мүмкіндік болады.
Dialogue: 0,1:04:56.64,1:04:57.93,Default,,0,0,0,,- (Кейко) Бәрі осы ма? -(Кумико) А?
Dialogue: 0,1:04:58.01,1:05:01.81,Default,,0,0,0,,Олай болса, бір ай күтсең, көрме бітеді.
Dialogue: 0,1:05:01.89,1:05:05.40,Default,,0,0,0,,Маған қызық, сен неге асығып тұрсың, Кайто Бала...
Dialogue: 0,1:05:36.59,1:05:38.01,Default,,0,0,0,,Ах... уф...
Dialogue: 0,1:06:01.66,1:06:03.45,Default,,0,0,0,,Бүгін барлығы
Dialogue: 0,1:06:03.54,1:06:06.46,Default,,0,0,0,,«Жапонияны таңдандырған күнбағыс көрмесіне» келгеніңіз үшін рахмет.
Dialogue: 0,1:06:06.54,1:06:08.08,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,1:06:08.17,1:06:11.09,Default,,0,0,0,,Бұл көрмені ойлап тапқан...
Dialogue: 0,1:06:11.17,1:06:15.05,Default,,0,0,0,,Джирокичи Сузукиге кіріспе мәлімдемесін айтайық.
Dialogue: 0,1:06:16.59,1:06:21.06,Default,,0,0,0,,Енді күнбағыстың хош иісіне баурап алған бәрің.
Dialogue: 0,1:06:21.14,1:06:22.47,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,1:06:22.56,1:06:26.31,Default,,0,0,0,,(Адамдар қол соғып, қол шапалақтайды)
Dialogue: 0,1:06:26.39,1:06:28.06,Default,,0,0,0,,Жарайды...
Dialogue: 0,1:06:28.15,1:06:32.86,Default,,0,0,0,,«Жапонияны аңсайтын күнбағыс көрмесі» басталды!
Dialogue: 0,1:06:34.82,1:06:37.24,Default,,0,0,0,,Қабылдау қазір басталады.
Dialogue: 0,1:06:37.32,1:06:40.41,Default,,0,0,0,,Билетіңізді алып, кезекке тұрыңыз.
Dialogue: 0,1:06:40.49,1:06:42.12,Default,,0,0,0,,Кешіріңіз, Моури Ран...
Dialogue: 0,1:06:42.20,1:06:44.50,Default,,0,0,0,,Енді билетіңізді көрсетіңізші.
Dialogue: 0,1:06:45.16,1:06:46.41,Default,,0,0,0,,6 адамға қызмет көрсетеді
Dialogue: 0,1:06:46.50,1:06:48.17,Default,,0,0,0,,Иә, расталды
Dialogue: 0,1:06:48.25,1:06:49.50,Default,,0,0,0,,Осы жерге енгізіңіз
Dialogue: 0,1:06:49.58,1:06:51.09,Default,,0,0,0,,Сіз біріншісіз!
Dialogue: 0,1:06:51.17,1:06:52.04,Default,,0,0,0,,Керемет!
Dialogue: 0,1:06:52.13,1:06:54.34,Default,,0,0,0,,Ран-онни-сан, асығыңыз!
Dialogue: 0,1:06:54.42,1:06:55.72,Default,,0,0,0,,Барлығы сенімен бірге.
Dialogue: 0,1:06:55.80,1:06:56.67,Default,,0,0,0,,Иә
Dialogue: 0,1:06:56.76,1:06:57.80,Default,,0,0,0,,Өкіл билетті билет қақпасына салуы керек.
Dialogue: 0,1:06:57.80,1:07:00.01,Default,,0,0,0,,Өкіл билетті билет қақпасына салуы керек.
Dialogue: 0,1:06:57.80,1:07:00.01,Default,,0,0,0,,Енді қабылдауды бастайық.
Dialogue: 0,1:07:00.09,1:07:01.01,Default,,0,0,0,,Билеттерді сатып алу керек
Dialogue: 0,1:07:01.10,1:07:02.76,Default,,0,0,0,,Оны қолыңызбен ұстаңыз және жалғастырыңыз.
Dialogue: 0,1:07:05.22,1:07:07.77,Default,,0,0,0,,Қабылдау бірқалыпты жүріп жатыр ма?
Dialogue: 0,1:07:07.85,1:07:10.48,Default,,0,0,0,,Иә Көрменің қоршаған ортасының қауіпсіздігі
Dialogue: 0,1:07:10.56,1:07:13.07,Default,,0,0,0,,Екі жүйе де тамаша жұмыс істейді.
Dialogue: 0,1:07:13.15,1:07:15.61,Default,,0,0,0,,Хмм, онда Готодан басқа кез келген адам.
Dialogue: 0,1:07:15.69,1:07:17.15,Default,,0,0,0,,Барлығыңыз өз посттарыңызға оралыңыздар.
Dialogue: 0,1:07:17.24,1:07:18.20,Default,,0,0,0,,Иә!
Dialogue: 0,1:07:18.70,1:07:22.03,Default,,0,0,0,,Не? аздап! Оны бір адам басқара ала ма?
Dialogue: 0,1:07:22.12,1:07:25.37,Default,,0,0,0,,Уайымдамаңыз, ол автоматтандырылған.
Dialogue: 0,1:07:25.45,1:07:27.66,Default,,0,0,0,,Сондай-ақ, бұл бөлмеге кім кіріп, шыға алады?
Dialogue: 0,1:07:27.75,1:07:30.58,Default,,0,0,0,,Минимумға дейін сақтаған дұрыс.
Dialogue: 0,1:07:30.67,1:07:33.25,Default,,0,0,0,,Бұл рас, бірақ...
Dialogue: 0,1:07:33.75,1:07:35.09,Default,,0,0,0,,- (Когоро) Ах - (Джирокичи) Эй, не болды?
Dialogue: 0,1:07:35.17,1:07:36.59,Default,,0,0,0,,… …
Dialogue: 0,1:07:36.67,1:07:38.67,Default,,0,0,0,,Ол өте шулы.
Dialogue: 0,1:07:38.76,1:07:42.47,Default,,0,0,0,,Не? Детектив бала да осында ма?
Dialogue: 0,1:07:42.55,1:07:44.05,Default,,0,0,0,,- (Когоро) Ху... - (Джирокичи) Гото
Dialogue: 0,1:07:44.14,1:07:46.31,Default,,0,0,0,,Күдікті әрекет ететін біреу бар ма?
Dialogue: 0,1:07:46.89,1:07:49.56,Default,,0,0,0,,Бірінші топ лифттен ерте түсті.
Dialogue: 0,1:07:49.64,1:07:51.98,Default,,0,0,0,,Бірінші «Күнбағыстың» көрме бөлмесіне кірдім.
Dialogue: 0,1:07:52.06,1:07:55.61,Default,,0,0,0,,Екінші «Күнбағыстың» көрме бөлмесіне бір адам ғана барды.
Dialogue: 0,1:07:55.69,1:07:57.11,Default,,0,0,0,,Монитордағы дисплей
Dialogue: 0,1:07:58.94,1:08:01.74,Default,,0,0,0,,Екінші суреттен оны көру біртүрлі.
Dialogue: 0,1:08:01.82,1:08:03.49,Default,,0,0,0,,Сіз оны сәл жақындата аласыз ба?
Dialogue: 0,1:08:05.53,1:08:07.75,Default,,0,0,0,,- (Джирокичи) Бар! -(Барып) А, иә...
Dialogue: 0,1:08:09.37,1:08:11.50,Default,,0,0,0,,Не, сен жылап тұрсың ба?
Dialogue: 0,1:08:11.58,1:08:13.21,Default,,0,0,0,,Айтпақшы, екінші «күнбағыс».
Dialogue: 0,1:08:13.29,1:08:14.25,Default,,0,0,0,,Менің ойымша, сіз оны көргіңіз келді.
Dialogue: 0,1:08:14.34,1:08:17.34,Default,,0,0,0,,Кеңесші Кидд емес екені анық
Dialogue: 0,1:08:17.92,1:08:19.63,Default,,0,0,0,,Жалпы бақылауға оралу
Dialogue: 0,1:08:19.72,1:08:22.34,Default,,0,0,0,,О, дұрыс, қайта қойыңыз.
Dialogue: 0,1:08:22.97,1:08:24.18,Default,,0,0,0,,Иә...
Dialogue: 0,1:08:32.44,1:08:33.85,Default,,0,0,0,,Уау~ Өте әдемі
Dialogue: 0,1:08:33.94,1:08:36.65,Default,,0,0,0,,Бірақ бұл жалған сияқты.
Dialogue: 0,1:08:36.73,1:08:39.07,Default,,0,0,0,,Егер ол шын болса, солып қалар еді.
Dialogue: 0,1:08:39.15,1:08:40.65,Default,,0,0,0,,Жалған болғаны маңызды емес.
Dialogue: 0,1:08:40.74,1:08:43.66,Default,,0,0,0,,Мен оның иісі жақсырақ болғанын қалаймын.
Dialogue: 0,1:08:43.74,1:08:46.66,Default,,0,0,0,,Бұл біртүрлі. Бұл Нацумидің идеясы еді.
Dialogue: 0,1:08:46.74,1:08:49.58,Default,,0,0,0,,Сіз тіпті иіс қосады деп айтқан жоқсыз...
Dialogue: 0,1:08:49.66,1:08:52.54,Default,,0,0,0,,Одан да көп! Біздің Suzuki конгломератына тиесілі —
Dialogue: 0,1:08:52.62,1:08:54.79,Default,,0,0,0,,Екінші «күнбағысты» көрейік.
Dialogue: 0,1:08:54.88,1:08:55.79,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,1:08:55.88,1:08:57.00,Default,,0,0,0,,- (Гента) Кеттік! -(Аюми) Иә!
Dialogue: 0,1:08:59.00,1:08:59.84,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,1:08:59.92,1:09:00.76,Default,,0,0,0,,Ах
Dialogue: 0,1:09:01.55,1:09:03.01,Default,,0,0,0,,Бақылау камерасы…
Dialogue: 0,1:09:03.51,1:09:06.22,Default,,0,0,0,,Сіз барлық жерде осылай орнатып жатырсыз ба?
Dialogue: 0,1:09:06.30,1:09:08.18,Default,,0,0,0,,Конан-кун, сен не істеп жатырсың? Барайық!
Dialogue: 0,1:09:08.26,1:09:09.77,Default,,0,0,0,,Иә
Dialogue: 0,1:09:16.86,1:09:18.32,Default,,0,0,0,,Қараңдар, мен көріп тұрмын.
Dialogue: 0,1:09:18.40,1:09:19.28,Default,,0,0,0,,Бұл рас!
Dialogue: 0,1:09:19.36,1:09:20.32,Default,,0,0,0,,Керемет!
Dialogue: 0,1:09:20.40,1:09:23.32,Default,,0,0,0,,Мен мұны көргім келді.
Dialogue: 0,1:09:25.03,1:09:25.91,Default,,0,0,0,,Ах
Dialogue: 0,1:09:26.95,1:09:29.79,Default,,0,0,0,,Жүгірдім! Шиничи ол жерде ерте болды.
Dialogue: 0,1:09:29.87,1:09:31.12,Default,,0,0,0,,-Е - (Жүгіріп) Бұл өтірік.
Dialogue: 0,1:09:32.66,1:09:33.71,Default,,0,0,0,,Шиничи…
Dialogue: 0,1:09:34.96,1:09:36.42,Default,,0,0,0,,Шиничи Соноко ше?
Dialogue: 0,1:09:37.00,1:09:38.71,Default,,0,0,0,,Кешіріңіз, мен оны жоғалтып алдым.
Dialogue: 0,1:09:38.79,1:09:39.92,Default,,0,0,0,,Ол шынымен де сонда болды ма?
Dialogue: 0,1:09:40.00,1:09:42.13,Default,,0,0,0,,Не? Сіз мұны айтқанда ...
Dialogue: 0,1:09:42.21,1:09:44.30,Default,,0,0,0,,Мен мұқият қараған жоқпын, бірақ...
Dialogue: 0,1:09:44.38,1:09:45.51,Default,,0,0,0,,Мен қателестім бе?
Dialogue: 0,1:09:45.59,1:09:47.18,Default,,0,0,0,,Мен солай болса екен...
Dialogue: 0,1:09:47.72,1:09:50.35,Default,,0,0,0,,Осы нысанға кіру кезінде қауіпсіздікті ескеру.
Dialogue: 0,1:09:50.43,1:09:53.14,Default,,0,0,0,,Жүкті мұқият тексеру және рентгендік тексеру арқылы
Dialogue: 0,1:09:53.23,1:09:54.60,Default,,0,0,0,,Бетпердемен кіру мүмкін емес
Dialogue: 0,1:09:55.98,1:09:58.44,Default,,0,0,0,,Егер солай болса, Баланың қалған қолы...
Dialogue: 0,1:09:58.98,1:10:01.73,Default,,0,0,0,,Неге екені белгісіз, менің бет-әлпетім осыған ұқсас.
Dialogue: 0,1:10:01.82,1:10:03.82,Default,,0,0,0,,Менің сізге ұқсаудан басқа амалым жоқ.
Dialogue: 0,1:10:05.40,1:10:06.53,Default,,0,0,0,,Фу…
Dialogue: 0,1:10:13.87,1:10:15.71,Default,,0,0,0,,Не? бұл жазба
Dialogue: 0,1:10:16.33,1:10:18.38,Default,,0,0,0,,Ah Kid картасы
Dialogue: 0,1:10:18.46,1:10:20.25,Default,,0,0,0,,Күткендей, сен мен сияқты болып тұрсың...
Dialogue: 0,1:10:20.34,1:10:21.59,Default,,0,0,0,,- (Хайбара) Жақсысың ба? -Аа...
Dialogue: 0,1:10:21.67,1:10:23.67,Default,,0,0,0,,Менің ойымша, ол да мұнда емес.
Dialogue: 0,1:10:23.76,1:10:26.38,Default,,0,0,0,,Кешіріңіз, мен қате түсіндім деп ойлаймын.
Dialogue: 0,1:10:26.47,1:10:27.80,Default,,0,0,0,,Ран-ничан Соноко-нечан!
Dialogue: 0,1:10:27.89,1:10:29.26,Default,,0,0,0,,Конан-кун, тыныш бол.
Dialogue: 0,1:10:29.35,1:10:30.64,Default,,0,0,0,,Мені күзет бөлмесіне апарыңыз!
Dialogue: 0,1:10:30.72,1:10:32.06,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:32.14,1:10:34.93,Default,,0,0,0,,Бұл балалар картасы, ол қазірдің өзінде Рэйлоктың ішінде!
Dialogue: 0,1:10:35.02,1:10:36.52,Default,,0,0,0,,- Кайто Бала! -(Ран/Соноко) Ха
Dialogue: 0,1:10:38.02,1:10:39.69,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,1:10:39.77,1:10:42.73,Default,,0,0,0,,Егер сіз оны «күнбағыспен» байланыстыруға мәжбүр болсаңыз
Dialogue: 0,1:10:42.82,1:10:46.45,Default,,0,0,0,,Ван Гогтың «Күнбағыстарында» 15 гүл бейнеленген болуы керек.
Dialogue: 0,1:10:46.53,1:10:50.91,Default,,0,0,0,,4-сурет 5-сурет 6-сурет 15 «күнбағыстың» суреттері.
Dialogue: 0,1:10:50.99,1:10:53.45,Default,,0,0,0,,Сонда 14 сурет бар ма?
Dialogue: 0,1:10:53.54,1:10:55.16,Default,,0,0,0,,Ол болмауы керек еді
Dialogue: 0,1:10:55.25,1:10:57.46,Default,,0,0,0,,№ Ван Гогтың «Күнбағыстары»
Dialogue: 0,1:10:57.54,1:11:00.29,Default,,0,0,0,,14 пен 15 бірдей деген теория бар.
Dialogue: 0,1:11:00.38,1:11:02.96,Default,,0,0,0,,Ван Гог ағасы Теоға хат жазды.
Dialogue: 0,1:11:03.05,1:11:06.30,Default,,0,0,0,,15 «Күнбағыс» суреттері 14 деп жазылған.
Dialogue: 0,1:11:06.88,1:11:10.01,Default,,0,0,0,,Сонымен, бұл күнбағыс саны болсын...
Dialogue: 0,1:11:10.09,1:11:12.97,Default,,0,0,0,,Жер бетінде осыдан кейін келетін сандар қандай?
Dialogue: 0,1:11:13.06,1:11:16.81,Default,,0,0,0,,Егер Ван Гог 14 «күнбағысты» таныса
Dialogue: 0,1:11:16.89,1:11:19.31,Default,,0,0,0,,Бұл Мәсіхтің 12 елшісі.
Dialogue: 0,1:11:19.40,1:11:22.65,Default,,0,0,0,,Тео мен Гогенді меңзеген деген теория болды.
Dialogue: 0,1:11:22.73,1:11:24.40,Default,,0,0,0,,Иә! Мен солай екеніне сенімдімін
Dialogue: 0,1:11:24.48,1:11:25.99,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:11:26.07,1:11:28.03,Default,,0,0,0,,Карточкаға қайта қараңыз
Dialogue: 0,1:11:28.61,1:11:30.74,Default,,0,0,0,,11 адам плюс 1 адам, бірақ
Dialogue: 0,1:11:30.82,1:11:32.78,Default,,0,0,0,,Мәсіхтің 12 елшісінде
Dialogue: 0,1:11:32.87,1:11:34.12,Default,,0,0,0,,Плюс 2 адам
Dialogue: 0,1:11:34.20,1:11:36.79,Default,,0,0,0,,Тео мен Гоген болуы мүмкін деген теория.
Dialogue: 0,1:11:36.87,1:11:39.92,Default,,0,0,0,,Бұл жалпы саны 14 адамға жетеді және
Dialogue: 0,1:11:40.00,1:11:42.17,Default,,0,0,0,,Егер сіз оны 15 кітап деп танысаңыз
Dialogue: 0,1:11:42.25,1:11:43.96,Default,,0,0,0,,Бір адам
Dialogue: 0,1:11:44.04,1:11:46.05,Default,,0,0,0,,Ван Гогтың өзі деген теория бар
Dialogue: 0,1:11:46.13,1:11:48.84,Default,,0,0,0,,Түсіндіру дұрыс деп есептесек...
Dialogue: 0,1:11:48.92,1:11:51.89,Default,,0,0,0,,Бұл формула нені білдіреді деген сұрақ туындайды?
Dialogue: 0,1:11:51.97,1:11:53.26,Default,,0,0,0,,Неліктен Кид-сама?
Dialogue: 0,1:11:53.35,1:11:55.47,Default,,0,0,0,,Қызық, олар мұны осындай түсініксіз хабарламаға айналдырды ма?
Dialogue: 0,1:11:55.56,1:11:56.47,Default,,0,0,0,,Бұған дейін
Dialogue: 0,1:11:56.56,1:11:59.98,Default,,0,0,0,,Менің ойымша, бұл баланың картасы шынымен ескерту ме...
Dialogue: 0,1:12:00.06,1:12:01.31,Default,,0,0,0,,Хмм...
Dialogue: 0,1:12:01.81,1:12:03.23,Default,,0,0,0,,- (Джирокичи) Жарайды, жарайды - Ах.
Dialogue: 0,1:12:03.31,1:12:05.90,Default,,0,0,0,,Бұл бала картасы нені болжайды?
Dialogue: 0,1:12:05.98,1:12:09.49,Default,,0,0,0,,Мысықты ұстап алып, одан тура сұрайық.
Dialogue: 0,1:12:10.07,1:12:11.99,Default,,0,0,0,,Рэйроктағы құлыптау бала
Dialogue: 0,1:12:12.07,1:12:13.12,Default,,0,0,0,,Ынтымақтастық жасаңыз.
Dialogue: 0,1:12:13.20,1:12:14.07,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:12:14.16,1:12:17.49,Default,,0,0,0,,Goto: Көрермендер: Барлық актерлік құрам театрдан кетсін.
Dialogue: 0,1:12:17.58,1:12:18.45,Default,,0,0,0,,Иә!
Dialogue: 0,1:12:18.54,1:12:20.62,Default,,0,0,0,,Жоқ, бірақ ашылғаннан бері—
Dialogue: 0,1:12:20.71,1:12:22.62,Default,,0,0,0,,Әлі бір сағат болған жоқ.
Dialogue: 0,1:12:22.71,1:12:25.25,Default,,0,0,0,,Егер сіз осындай әрекет жасасаңыз, тәртіпсіздік болуы мүмкін.
Dialogue: 0,1:12:25.34,1:12:26.71,Default,,0,0,0,,- (Джирокичи) Жан тыныштығы - (Когоро) Иә?
Dialogue: 0,1:12:26.80,1:12:29.42,Default,,0,0,0,,Сіз бірінші күні не болатынын ешқашан білмейсіз.
Dialogue: 0,1:12:29.51,1:12:33.22,Default,,0,0,0,,Тек компания қызметкерлері мен Соноконың таныстары шақырылады.
Dialogue: 0,1:12:33.30,1:12:34.43,Default,,0,0,0,,- (Кумико) Кеңесші! - (Джирокичи) Иә?
Dialogue: 0,1:12:34.51,1:12:37.18,Default,,0,0,0,,Жоспар бойынша дабылда боламыз.
Dialogue: 0,1:12:37.26,1:12:41.39,Default,,0,0,0,,Мм, маған қамқор болыңыз, Жеті самурай.
Dialogue: 0,1:12:41.48,1:12:43.94,Default,,0,0,0,,Түсіндім, төтенше жағдайларға қатысты ереже болған.
Dialogue: 0,1:12:44.90,1:12:46.44,Default,,0,0,0,,Жоспарланғандай
Dialogue: 0,1:12:46.52,1:12:48.61,Default,,0,0,0,,Әрбір постты жылжытқанда
Dialogue: 0,1:12:48.69,1:12:50.32,Default,,0,0,0,,Байланыста болыңыз
Dialogue: 0,1:12:51.03,1:12:52.11,Default,,0,0,0,,Түсіндім
Dialogue: 0,1:12:53.66,1:12:54.62,Default,,0,0,0,,Қалай болғанда да, әзірге сол жерден кетіңдер
Dialogue: 0,1:12:53.66,1:12:54.62,Default,,0,0,0,,Қайталаңыз
Dialogue: 0,1:12:54.62,1:12:54.70,Default,,0,0,0,,Қайталаңыз
Dialogue: 0,1:12:54.70,1:12:55.41,Default,,0,0,0,,Қайталаңыз
Dialogue: 0,1:12:54.70,1:12:55.41,Default,,0,0,0,,«Күнбағыс» көрмесінде бір ақау бар сияқты.
Dialogue: 0,1:12:55.41,1:12:55.49,Default,,0,0,0,,«Күнбағыс» көрмесінде бір ақау бар сияқты.
Dialogue: 0,1:12:55.49,1:12:56.78,Default,,0,0,0,,«Күнбағыс» көрмесінде бір ақау бар сияқты.
Dialogue: 0,1:12:55.49,1:12:56.78,Default,,0,0,0,,Апаттық дабыл жүйесі іске қосылды
Dialogue: 0,1:12:56.78,1:12:56.87,Default,,0,0,0,,Апаттық дабыл жүйесі іске қосылды
Dialogue: 0,1:12:56.87,1:12:58.08,Default,,0,0,0,,Апаттық дабыл жүйесі іске қосылды
Dialogue: 0,1:12:56.87,1:12:58.08,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:12:58.08,1:12:58.16,Default,,0,0,0,,Апаттық дабыл жүйесі іске қосылды
Dialogue: 0,1:12:58.16,1:12:58.62,Default,,0,0,0,,Апаттық дабыл жүйесі іске қосылды
Dialogue: 0,1:12:58.16,1:12:58.62,Default,,0,0,0,,Тыныштанып, лифтке қарай жүріңіз.
Dialogue: 0,1:12:58.62,1:12:58.70,Default,,0,0,0,,Тыныштанып, лифтке қарай жүріңіз.
Dialogue: 0,1:12:58.70,1:13:00.33,Default,,0,0,0,,Тыныштанып, лифтке қарай жүріңіз.
Dialogue: 0,1:12:58.70,1:13:00.33,Default,,0,0,0,,Тұтынушы – күзетші...
Dialogue: 0,1:13:00.41,1:13:02.25,Default,,0,0,0,,Мен Кидтің шыққанына сенімдімін.
Dialogue: 0,1:13:02.33,1:13:04.29,Default,,0,0,0,,Детектив жігіттердің кезегі!
Dialogue: 0,1:13:04.38,1:13:05.33,Default,,0,0,0,,- (Хайбара) Жоқ! -(3 адам) А?
Dialogue: 0,1:13:05.42,1:13:07.21,Default,,0,0,0,,Бұл бала қауіпті!
Dialogue: 0,1:13:07.29,1:13:09.30,Default,,0,0,0,,Мені ешқашан тастама.
Dialogue: 0,1:13:09.38,1:13:10.71,Default,,0,0,0,,Біраз қорқынышты, иә?
Dialogue: 0,1:13:11.59,1:13:14.18,Default,,0,0,0,,Аудиторияны өтетін орыннан шығуға қалай бағыттайды?
Dialogue: 0,1:13:14.26,1:13:16.93,Default,,0,0,0,,Жақсы жүріп жатыр. Проблема болса...
Dialogue: 0,1:13:17.01,1:13:18.76,Default,,0,0,0,,Шығуда әртүрлі тексерулер болады.
Dialogue: 0,1:13:18.85,1:13:21.43,Default,,0,0,0,,Рентгендік зерттеу қажет емес.
Dialogue: 0,1:13:21.52,1:13:23.98,Default,,0,0,0,,Жүгіңізді қайтарғаннан кейін ғимараттан кетіңіз.
Dialogue: 0,1:13:24.06,1:13:27.02,Default,,0,0,0,,Әй, егер солай істесең, Бала қашып кетеді.
Dialogue: 0,1:13:27.11,1:13:28.52,Default,,0,0,0,,(Камо) Һм. (Фушигиро) Ұф.
Dialogue: 0,1:13:28.61,1:13:31.65,Default,,0,0,0,,Жемісің алдыңда тұрғанда қашатын түрің болма.
Dialogue: 0,1:13:31.74,1:13:33.90,Default,,0,0,0,,Мұны сіз де білетініңізге сенімдімін.
Dialogue: 0,1:13:33.99,1:13:36.78,Default,,0,0,0,,Жарайды, ол ғимаратта қалатын шығар.
Dialogue: 0,1:13:36.87,1:13:38.24,Default,,0,0,0,,Онда
Dialogue: 0,1:13:38.33,1:13:41.66,Default,,0,0,0,,Кіре берістегі қақпақты жабыңыз және мысықты ұстаңыз.
Dialogue: 0,1:13:42.29,1:13:44.42,Default,,0,0,0,,Рэйрокқа кіру деген нені білдіреді?
Dialogue: 0,1:13:44.50,1:13:48.67,Default,,0,0,0,,Қазіргі Бала бетперде кимеген және сиқырлы құралдары болмауы керек.
Dialogue: 0,1:13:48.75,1:13:51.71,Default,,0,0,0,,Бұл жағдайда сіз оны міндетті түрде жеңе аласыз!
Dialogue: 0,1:13:52.30,1:13:57.76,Default,,0,0,0,,Менің де ғимаратта 12 сенімді досым қалды.
Dialogue: 0,1:13:58.26,1:14:00.56,Default,,0,0,0,,12 адам сенуге болады
Dialogue: 0,1:14:01.06,1:14:04.56,Default,,0,0,0,,Қарасам, 12 елші 12 адам деп жазылмаған.
Dialogue: 0,1:14:04.64,1:14:08.73,Default,,0,0,0,,Мүмкін мен 11 адам мен 1 жазған шығармын...
Dialogue: 0,1:14:09.31,1:14:10.32,Default,,0,0,0,,Джирокичи ағай
Dialogue: 0,1:14:11.02,1:14:12.90,Default,,0,0,0,,12 адам сенуге болады
Dialogue: 0,1:14:12.99,1:14:15.49,Default,,0,0,0,,Балалар картасына жазылған Мәсіхтің халқымен
Dialogue: 0,1:14:15.57,1:14:16.95,Default,,0,0,0,,Адам саны бірдей емес пе?
Dialogue: 0,1:14:17.03,1:14:20.12,Default,,0,0,0,,12 бала бар деп неге жазбады деп ойлаймын.
Dialogue: 0,1:14:20.20,1:14:21.66,Default,,0,0,0,,Мен бұл туралы ойладым ...
Dialogue: 0,1:14:21.74,1:14:24.16,Default,,0,0,0,,Тіпті бір адам қалды ма?
Dialogue: 0,1:14:24.25,1:14:27.42,Default,,0,0,0,,О, бұл Яһуда туралы емес пе?
Dialogue: 0,1:14:27.50,1:14:29.38,Default,,0,0,0,,А, Иуда сатқын?
Dialogue: 0,1:14:30.04,1:14:31.38,Default,,0,0,0,,Олай болса, Кид-сама.
Dialogue: 0,1:14:31.46,1:14:34.92,Default,,0,0,0,,Арамызда бір сатқын бар екенін білу үшін...
Dialogue: 0,1:14:35.01,1:14:38.55,Default,,0,0,0,,Бұл Химавариді Кидтен басқа біреу нысанаға алғанын білдіре ме?
Dialogue: 0,1:14:38.64,1:14:42.60,Default,,0,0,0,,Жеті самурайдың кеңесшісі Сузуки профилі
Dialogue: 0,1:14:42.68,1:14:44.64,Default,,0,0,0,,Мен оны қайтадан қарастыруды ойлаймын ...
Dialogue: 0,1:14:44.73,1:14:47.69,Default,,0,0,0,,Біздің сеніміміз бен қауіпсіздігімізді бұзу
Dialogue: 0,1:14:47.77,1:14:49.44,Default,,0,0,0,,Бұл сіз мақсат еткен нәрсе болуы мүмкін.
Dialogue: 0,1:14:49.52,1:14:52.69,Default,,0,0,0,,Қайта тергеу туралы оларға хабар бермеңіз.
Dialogue: 0,1:14:52.77,1:14:56.20,Default,,0,0,0,,Хм, онда оны қараудың зияны жоқ.
Dialogue: 0,1:14:56.28,1:14:58.41,Default,,0,0,0,,- (Джирокичи) Өтінемін - (Накамори) О
Dialogue: 0,1:15:00.41,1:15:02.95,Default,,0,0,0,,Көрермендер мен актерлік құрамның барлығы театрды тастап кетті.
Dialogue: 0,1:15:03.04,1:15:05.41,Default,,0,0,0,,Жарайды, қалқаны түсіріңіз.
Dialogue: 0,1:15:05.50,1:15:07.46,Default,,0,0,0,,Иә, қалқаны жабу
Dialogue: 0,1:15:14.55,1:15:17.47,Default,,0,0,0,,Жалғастырыңыз! Ілгері жүру!
Dialogue: 0,1:15:14.55,1:15:17.47,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,1:15:17.55,1:15:19.09,Default,,0,0,0,,Лейк-рок мұражайынан
Dialogue: 0,1:15:19.18,1:15:21.47,Default,,0,0,0,,Көрермендер мен қызметкерлер көбейіп келеді.
Dialogue: 0,1:15:21.55,1:15:23.47,Default,,0,0,0,,Ғимарат ішінде нақты не болды?
Dialogue: 0,1:15:23.56,1:15:26.85,Default,,0,0,0,,Келушілерге мүлде ақпарат берілмеген сияқты.
Dialogue: 0,1:15:29.48,1:15:32.27,Default,,0,0,0,,Сондай-ақ, бақылау әлсіз жерлер бар...
Dialogue: 0,1:15:32.36,1:15:35.03,Default,,0,0,0,,Тек сервер бөлмесі және электр станциясы
Dialogue: 0,1:15:35.11,1:15:38.24,Default,,0,0,0,,Бірақ ол жер бізден басқа ешкімге белгісіз.
Dialogue: 0,1:15:39.36,1:15:41.07,Default,,0,0,0,,Ол тез.
Dialogue: 0,1:15:41.70,1:15:45.04,Default,,0,0,0,,Міне, Чарли, мен барлық осал тұстарды қарап шықтым.
Dialogue: 0,1:15:45.12,1:15:47.04,Default,,0,0,0,,Ғимаратта бала жоқ.
Dialogue: 0,1:15:47.12,1:15:47.96,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:15:50.92,1:15:52.71,Default,,0,0,0,,Ғимаратта ешкім қалмады.
Dialogue: 0,1:15:52.79,1:15:54.46,Default,,0,0,0,,Барлығыңыз, өз постыңызға оралуыңызды сұраймыз.
Dialogue: 0,1:15:54.55,1:15:55.80,Default,,0,0,0,,Иә
Dialogue: 0,1:15:56.30,1:15:57.17,Default,,0,0,0,,Уақыты келді…
Dialogue: 0,1:15:57.26,1:15:58.97,Default,,0,0,0,,(Қауіпсіздікті босату дыбысы)
Dialogue: 0,1:15:59.55,1:16:00.38,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:16:00.47,1:16:01.89,Default,,0,0,0,,Жоқ... уф...
Dialogue: 0,1:16:07.02,1:16:09.14,Default,,0,0,0,,Тоқтай тұрыңыз! Бала!
Dialogue: 0,1:16:09.23,1:16:11.60,Default,,0,0,0,,(Қауіпсіздікті босату дыбысы)
Dialogue: 0,1:16:14.73,1:16:15.69,Default,,0,0,0,,Иә
Dialogue: 0,1:16:26.20,1:16:27.79,Default,,0,0,0,,Әй
Dialogue: 0,1:16:27.87,1:16:28.83,Default,,0,0,0,,Не!
Dialogue: 0,1:16:31.37,1:16:32.42,Default,,0,0,0,,- (Соноко) Кя! - (Накамори) Электр қуаты өшіп қалды ма?
Dialogue: 0,1:16:32.50,1:16:35.13,Default,,0,0,0,,Егер бәрі жақсы болса, қосымша қуат көзін дереу қосыңыз.
Dialogue: 0,1:16:35.21,1:16:36.09,Default,,0,0,0,,Иә
Dialogue: 0,1:16:36.17,1:16:37.34,Default,,0,0,0,,«Күнбағыс» мониторына басымдық беріңіз
Dialogue: 0,1:16:37.42,1:16:38.71,Default,,0,0,0,,Мен білемін
Dialogue: 0,1:16:40.55,1:16:42.38,Default,,0,0,0,,Монитор
Dialogue: 0,1:16:44.14,1:16:45.93,Default,,0,0,0,,Жарайды, «Күнбағыс» қауіпсіз!
Dialogue: 0,1:16:46.01,1:16:47.01,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:16:47.10,1:16:48.85,Default,,0,0,0,,Маған да осы мониторда көрсетіңіз.
Dialogue: 0,1:16:48.93,1:16:50.85,Default,,0,0,0,,Ақпарат Мегуреден келіп жатыр.
Dialogue: 0,1:16:50.93,1:16:51.85,Default,,0,0,0,,Иә
Dialogue: 0,1:16:52.81,1:16:53.69,Default,,0,0,0,,Түсіндім!
Dialogue: 0,1:16:53.77,1:16:56.06,Default,,0,0,0,,Goto! Жер бетінде не болады?
Dialogue: 0,1:16:57.27,1:16:59.48,Default,,0,0,0,,Электр басқару бөлмесінде ақаулық бар сияқты.
Dialogue: 0,1:16:59.57,1:17:01.49,Default,,0,0,0,,Жарықтандыру Негізгі лифт
Dialogue: 0,1:17:01.57,1:17:04.49,Default,,0,0,0,,Ал бақылау камералары істен шыққан.
Dialogue: 0,1:17:04.57,1:17:07.45,Default,,0,0,0,,Екінші және бесінші ескертулерді дереу жіберіңіз.
Dialogue: 0,1:17:08.24,1:17:11.33,Default,,0,0,0,,Бала, сен әлі ғимаратта болдың ба?
Dialogue: 0,1:17:11.41,1:17:14.75,Default,,0,0,0,,Жоқ, бұл трюк... бұл Кидд болмауы мүмкін.
Dialogue: 0,1:17:14.83,1:17:16.21,Default,,0,0,0,,Не? Не айтқың келеді?
Dialogue: 0,1:17:16.29,1:17:18.42,Default,,0,0,0,,Жеті самурайды қайта қарауда
Dialogue: 0,1:17:18.50,1:17:21.09,Default,,0,0,0,,Күдікті адам пайда болды.
Dialogue: 0,1:17:21.17,1:17:22.47,Default,,0,0,0,,- (Джирокичи) Иә? - (Жүгіріп) Болды.
Dialogue: 0,1:17:23.18,1:17:26.97,Default,,0,0,0,,Ван Гог жеті «күнбағысты» салған Францияның Арлес қаласында
Dialogue: 0,1:17:27.60,1:17:31.02,Default,,0,0,0,,Адамның егіз ағасы алты ай бұрын қайтыс болған.
Dialogue: 0,1:17:31.73,1:17:34.52,Default,,0,0,0,,Жергілікті полиция оны кеуде тұсынан оқ тиген күйде тапты —
Dialogue: 0,1:17:34.60,1:17:37.31,Default,,0,0,0,,Өйткені оң жақтан түтін реакциясы шықты.
Dialogue: 0,1:17:37.40,1:17:39.23,Default,,0,0,0,,Бұл өзін-өзі өлтіру ретінде қарастырылды.
Dialogue: 0,1:17:39.32,1:17:41.86,Default,,0,0,0,,Ал ол адам кім?
Dialogue: 0,1:17:43.57,1:17:44.95,Default,,0,0,0,,Коичи Хигаши
Dialogue: 0,1:17:45.03,1:17:46.70,Default,,0,0,0,,Шығыс Жато?
Dialogue: 0,1:17:46.78,1:17:50.33,Default,,0,0,0,,А, ол суретті қалпына келтіруге жауапты Коджи Хигашидің үлкен ағасы.
Dialogue: 0,1:17:50.41,1:17:53.25,Default,,0,0,0,,Бұл өз-өзіне қол жұмсау емес еді. Мен Коичиді өлтірдім.
Dialogue: 0,1:17:53.33,1:17:56.00,Default,,0,0,0,,Мына жерде! «Күнбағыс» мониторына қараңыз!
Dialogue: 0,1:17:56.08,1:17:57.67,Default,,0,0,0,,Екінші мониторда...
Dialogue: 0,1:17:57.75,1:18:01.21,Default,,0,0,0,,О, Шығыс! Неліктен? Біз ағайынды болсақ та
Dialogue: 0,1:18:01.30,1:18:02.76,Default,,0,0,0,,Коичи-сан
Dialogue: 0,1:18:02.84,1:18:04.84,Default,,0,0,0,,Мен іздеген Әшияның «күнбағыс».
Dialogue: 0,1:18:04.93,1:18:06.59,Default,,0,0,0,,Табылуының арқасында
Dialogue: 0,1:18:06.68,1:18:08.72,Default,,0,0,0,,Өйткені мен ойымды өзгерттім.
Dialogue: 0,1:18:08.80,1:18:10.56,Default,,0,0,0,,Ашиядан «Күнбағысты» таптың ба?
Dialogue: 0,1:18:10.64,1:18:11.77,Default,,0,0,0,,Сіз не айтып тұрсыз?
Dialogue: 0,1:18:11.85,1:18:15.14,Default,,0,0,0,,«Күнбағыс» соғыста жойылуы керек еді.
Dialogue: 0,1:18:15.23,1:18:17.23,Default,,0,0,0,,Жоқ, бұл тарихи факт емес.
Dialogue: 0,1:18:17.31,1:18:20.90,Default,,0,0,0,,Сол күні Әшияға әуе шабуылы болған күні
Dialogue: 0,1:18:20.98,1:18:24.19,Default,,0,0,0,,Қала тозақ отында өртеніп, тозақтың суреті болған сияқты.
Dialogue: 0,1:18:25.32,1:18:27.74,Default,,0,0,0,,Ашиядан «Күнбағыс» сатып алған кәсіпкерге
Dialogue: 0,1:18:27.82,1:18:30.20,Default,,0,0,0,,Менің атам ағаш ұстасы болып жұмыс істеген.
Dialogue: 0,1:18:30.28,1:18:32.79,Default,,0,0,0,,Ұрлықтың алдын алу үшін қабырғаға мықтап бекітілген.
Dialogue: 0,1:18:32.87,1:18:34.83,Default,,0,0,0,,«Күнбағысты» құтқару
Dialogue: 0,1:18:34.91,1:18:37.62,Default,,0,0,0,,Жалынға оранған сарайға бір адам секірген көрінеді.
Dialogue: 0,1:18:37.71,1:18:38.83,Default,,0,0,0,,Уф...
Dialogue: 0,1:18:39.92,1:18:41.59,Default,,0,0,0,,Уау...
Dialogue: 0,1:18:42.09,1:18:42.96,Default,,0,0,0,,Ha
Dialogue: 0,1:18:44.72,1:18:46.59,Default,,0,0,0,,Уф...
Dialogue: 0,1:18:48.55,1:18:50.35,Default,,0,0,0,,А... Хмф!
Dialogue: 0,1:18:50.93,1:18:53.47,Default,,0,0,0,,(Ясукенің күшті дауысы)
Dialogue: 0,1:18:59.98,1:19:03.07,Default,,0,0,0,,«Kaebuki Tsuyu» әріптерін сұрақ қойып шығара алмаймын
Dialogue: 0,1:19:03.57,1:19:05.78,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:19:05.86,1:19:07.24,Default,,0,0,0,,- (ханым) Азума-сан! -(Ясуке) Аа.
Dialogue: 0,1:19:08.16,1:19:09.24,Default,,0,0,0,,Мен атама тіл тигізуіңе, тіпті маған тіл тигізуіңе де жол бере алмаймын.
Dialogue: 0,1:19:09.74,1:19:11.24,Default,,0,0,0,,Азума-сан, не!
Dialogue: 0,1:19:11.32,1:19:13.16,Default,,0,0,0,,- (Ясуке) Келме! -(Оқушы) А...
Dialogue: 0,1:19:13.24,1:19:14.24,Default,,0,0,0,,Ах...
Dialogue: 0,1:19:14.83,1:19:15.75,Default,,0,0,0,,Бұл...
Dialogue: 0,1:19:16.33,1:19:18.92,Default,,0,0,0,,Гуаааааааааааааааааааааа...
Dialogue: 0,1:19:19.00,1:19:21.25,Default,,0,0,0,,Жас ханым, мен «Күнбағыс» алғым келеді!
Dialogue: 0,1:19:21.33,1:19:23.59,Default,,0,0,0,,Мен сізді жек көремін, Азума мырза!
Dialogue: 0,1:19:23.67,1:19:24.80,Default,,0,0,0,,Қауіпті!
Dialogue: 0,1:19:25.34,1:19:27.38,Default,,0,0,0,,Жас ханым, тез қашуымыз керек!
Dialogue: 0,1:19:27.47,1:19:30.43,Default,,0,0,0,,Мен сені жек көремін, Азума-сан!
Dialogue: 0,1:19:30.51,1:19:32.51,Default,,0,0,0,,Соғыста жеңілсек те... Уф
Dialogue: 0,1:19:33.01,1:19:35.72,Default,,0,0,0,,Сол «күнбағысты» алып кетуге болмайды...
Dialogue: 0,1:19:36.22,1:19:37.93,Default,,0,0,0,,Азума мырза...
Dialogue: 0,1:19:38.89,1:19:39.85,Default,,0,0,0,,Азума-сан!
Dialogue: 0,1:19:39.94,1:19:42.27,Default,,0,0,0,,Ханым, асығыңыз!
Dialogue: 0,1:19:45.36,1:19:47.65,Default,,0,0,0,,Бұл жолы Жапонияда
Dialogue: 0,1:19:48.15,1:19:52.07,Default,,0,0,0,,Мушакожи-сенсей айтқан мұражай сияқты...
Dialogue: 0,1:19:53.70,1:19:55.24,Default,,0,0,0,,Дүние жүзіндегі адамдарға...
Dialogue: 0,1:19:56.58,1:19:59.46,Default,,0,0,0,,Сол... «Күнбағыс»...
Dialogue: 0,1:20:05.75,1:20:08.97,Default,,0,0,0,,Әкемнің аузынан естігенім осы.
Dialogue: 0,1:20:10.63,1:20:14.89,Default,,0,0,0,,Әкем қайтыс болғаннан кейін де Әшиядан «Күнбағысты» іздеуді жалғастырдық.
Dialogue: 0,1:20:14.97,1:20:19.52,Default,,0,0,0,,Картинаны тек қызметшінің сөзіне сүйеніп, атамнан алдым.
Dialogue: 0,1:20:19.60,1:20:21.60,Default,,0,0,0,,Қызметшінің сөзі?
Dialogue: 0,1:20:21.69,1:20:24.02,Default,,0,0,0,,GHQ тәркілеуден құтылу
Dialogue: 0,1:20:24.11,1:20:26.19,Default,,0,0,0,,Жалғандықты жөндеу
Dialogue: 0,1:20:26.27,1:20:28.65,Default,,0,0,0,,Еуропаға қашып кетуге рұқсат бергенін айтты.
Dialogue: 0,1:20:28.74,1:20:31.91,Default,,0,0,0,,Ал... Мен ұтып алған «Күнбағысты» тендерге жібереді деп күтпедім...
Dialogue: 0,1:20:31.99,1:20:34.24,Default,,0,0,0,,А... Әшияның «Күнбағыс»!
Dialogue: 0,1:20:34.32,1:20:36.20,Default,,0,0,0,,- (Соноко) Иә? -(Жүгірді) Ол жанған жоқ...
Dialogue: 0,1:20:36.28,1:20:37.41,Default,,0,0,0,,О
Dialogue: 0,1:20:37.49,1:20:39.79,Default,,0,0,0,,Біз, ағайындар, ақыры таптық.
Dialogue: 0,1:20:40.66,1:20:42.37,Default,,0,0,0,,Арлестегі ескі үйдің шатырында
Dialogue: 0,1:20:42.46,1:20:45.96,Default,,0,0,0,,Ашиядағы «Күнбағыс» тыныш орналастырылған...
Dialogue: 0,1:20:46.80,1:20:47.67,Default,,0,0,0,,Бірақ
Dialogue: 0,1:20:47.75,1:20:51.22,Default,,0,0,0,,Көп жылдар бойы іздеген «күнбағысты» тапқан соң.
Dialogue: 0,1:20:51.72,1:20:54.22,Default,,0,0,0,,Менің ағам өз ойын өзгертті.
Dialogue: 0,1:20:55.39,1:20:56.56,Default,,0,0,0,,«Күнбағыс» бұл
Dialogue: 0,1:20:56.64,1:20:59.39,Default,,0,0,0,,Оны Ван Гог жақсы көретін Арльде сақтау керек.
Dialogue: 0,1:20:59.47,1:21:02.81,Default,,0,0,0,,Әйтпесе, мен оны мұнда-мұнда жоғалтып аламын.
Dialogue: 0,1:21:02.89,1:21:05.81,Default,,0,0,0,,Атам мен әкемнің тілегіне опасыздық жасай бастаған інім.
Dialogue: 0,1:21:05.90,1:21:07.73,Default,,0,0,0,,Мен кешіре алмадым
Dialogue: 0,1:21:07.82,1:21:09.73,Default,,0,0,0,,Олар жанжалдасып, бір-бірімен төбелесіп жатқанда,
Dialogue: 0,1:21:09.82,1:21:13.45,Default,,0,0,0,,Менің қорғаныс мылтығым сөніп қалды, мен абайсызда ағамды атып тастадым...
Dialogue: 0,1:21:13.53,1:21:17.99,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:21:19.29,1:21:23.00,Default,,0,0,0,,(Койчидің ыңырсыуы)
Dialogue: 0,1:21:26.33,1:21:28.13,Default,,0,0,0,,Бауырым... О... мен...
Dialogue: 0,1:21:28.21,1:21:29.50,Default,,0,0,0,,- (Койчи) Қаш... - (Хигаши) А?
Dialogue: 0,1:21:30.51,1:21:32.51,Default,,0,0,0,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,1:21:33.09,1:21:34.30,Default,,0,0,0,,Сен
Dialogue: 0,1:21:34.97,1:21:36.01,Default,,0,0,0,,Уф...
Dialogue: 0,1:21:36.64,1:21:38.22,Default,,0,0,0,,Хаха...
Dialogue: 0,1:21:38.31,1:21:39.81,Default,,0,0,0,,Сіз қашып кетесіз.
Dialogue: 0,1:21:39.89,1:21:41.47,Default,,0,0,0,,- (Хигаши) Бірақ... - (Койчи) Кеттік!
Dialogue: 0,1:21:41.56,1:21:45.44,Default,,0,0,0,,Уф... уф... уф...
Dialogue: 0,1:21:51.40,1:21:52.57,Default,,0,0,0,,Ах...
Dialogue: 0,1:21:52.65,1:21:56.62,Default,,0,0,0,,(Койчидің ауыр тыныс алуы)
Dialogue: 0,1:22:02.66,1:22:06.25,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:22:06.33,1:22:11.05,Default,,0,0,0,,Содан кейін мен «Жапонияны таңдандырған күнбағыс көрмесі» туралы білдім.
Dialogue: 0,1:22:11.13,1:22:12.96,Default,,0,0,0,,Куратор ретінде қатысу
Dialogue: 0,1:22:13.05,1:22:14.59,Default,,0,0,0,,Рахмет саған, Әшияның «Күнбағыс»
Dialogue: 0,1:22:14.67,1:22:17.80,Default,,0,0,0,,Мен Жапонияға оралған сәтімді көрдім.
Dialogue: 0,1:22:18.30,1:22:20.97,Default,,0,0,0,,Атам ұрпақтан қалған тілегі орындалды.
Dialogue: 0,1:22:22.35,1:22:24.89,Default,,0,0,0,,Бұл көрме аяқталғанда,
Dialogue: 0,1:22:24.98,1:22:27.56,Default,,0,0,0,,Мен сотқа келейін деп едім.
Dialogue: 0,1:22:27.65,1:22:29.61,Default,,0,0,0,,Сәл ерте, бірақ...
Dialogue: 0,1:22:29.69,1:22:31.40,Default,,0,0,0,,Түсіндім
Dialogue: 0,1:22:31.90,1:22:34.99,Default,,0,0,0,,Елордалық полиция департаментінен Мегуре осы жолмен келе жатыр.
Dialogue: 0,1:22:35.07,1:22:36.24,Default,,0,0,0,,Сіз өзіңізді тапсырасыз ба?
Dialogue: 0,1:22:36.32,1:22:38.32,Default,,0,0,0,,О, әрине.
Dialogue: 0,1:22:38.41,1:22:41.28,Default,,0,0,0,,Бірақ сіз айтып отырған күдікті адам мен емес.
Dialogue: 0,1:22:41.37,1:22:44.45,Default,,0,0,0,,-Е- (Накамори) Не...қазір не істеп жатырсың?
Dialogue: 0,1:22:44.54,1:22:46.12,Default,,0,0,0,,Әй, «Күнбағыс» жанып тұр!
Dialogue: 0,1:22:46.71,1:22:47.92,Default,,0,0,0,,Алдамаңыз!
Dialogue: 0,1:22:48.00,1:22:49.75,Default,,0,0,0,,Бұл шынымен жанып тұр
Dialogue: 0,1:22:49.83,1:22:50.88,Default,,0,0,0,,Қатты! Бұл өрт
Dialogue: 0,1:22:50.96,1:22:51.88,Default,,0,0,0,,Оны тез өшіріңіз!
Dialogue: 0,1:22:51.96,1:22:54.01,Default,,0,0,0,,Сәлем! Не болып жатыр!
Dialogue: 0,1:22:54.09,1:22:56.42,Default,,0,0,0,,«Химавари» жылу датчигі не істейді?
Dialogue: 0,1:22:56.51,1:22:58.18,Default,,0,0,0,,Қалыпты емес мәнді көрсетеді
Dialogue: 0,1:22:56.51,1:22:58.18,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,1:22:58.18,1:22:58.26,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,1:22:58.26,1:23:00.39,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,1:22:58.26,1:23:00.39,Default,,0,0,0,,Өрт шынымен болған сияқты.
Dialogue: 0,1:23:00.47,1:23:01.89,Default,,0,0,0,,Өртті сөндіру мүмкін емес пе?
Dialogue: 0,1:23:01.97,1:23:04.22,Default,,0,0,0,,Бұл мүмкін емес. Апаттың алдын алу жүйесі істен шыққан.
Dialogue: 0,1:23:04.31,1:23:05.98,Default,,0,0,0,,Бұл туралы ештеңе істей алмаймыз.
Dialogue: 0,1:23:06.06,1:23:07.64,Default,,0,0,0,,Барлығымыз қашайық!
Dialogue: 0,1:23:07.73,1:23:10.23,Default,,0,0,0,,Өту: Төбедегі қалқаны ашыңыз.
Dialogue: 0,1:23:10.31,1:23:11.19,Default,,0,0,0,,Иә
Dialogue: 0,1:23:11.27,1:23:13.53,Default,,0,0,0,,Кеттік! Барлығы менің артымнан ереді
Dialogue: 0,1:23:13.61,1:23:14.65,Default,,0,0,0,,Конан-кун, кеттік!
Dialogue: 0,1:23:14.73,1:23:15.86,Default,,0,0,0,,Ух... иә
Dialogue: 0,1:23:17.82,1:23:20.49,Default,,0,0,0,,Тездетіңіз ағай! Жалын сол жаққа жетеді
Dialogue: 0,1:23:20.57,1:23:22.16,Default,,0,0,0,,- (Барып) Білемін, жақындап қалды - А.
Dialogue: 0,1:23:23.24,1:23:25.58,Default,,0,0,0,,Жарайды, кеттік, балам, тезірек!
Dialogue: 0,1:23:28.16,1:23:29.71,Default,,0,0,0,,Барлығы осылай!
Dialogue: 0,1:23:29.79,1:23:30.79,Default,,0,0,0,,(Когороның ауыр тыныс алуы)
Dialogue: 0,1:23:30.88,1:23:32.13,Default,,0,0,0,,Жарайды, тезірек жүре бер!
Dialogue: 0,1:23:32.21,1:23:33.55,Default,,0,0,0,,Ух... иә
Dialogue: 0,1:23:34.67,1:23:36.84,Default,,0,0,0,,Тезірек, Конан!
Dialogue: 0,1:23:40.34,1:23:41.51,Default,,0,0,0,,Барлығың ауырып қалды ма?
Dialogue: 0,1:23:41.59,1:23:42.97,Default,,0,0,0,,Иә, бізде бәрі жақсы
Dialogue: 0,1:23:43.72,1:23:45.06,Default,,0,0,0,,Амансың ба, Конан?
Dialogue: 0,1:23:45.14,1:23:47.73,Default,,0,0,0,,Иә. Оның үстіне «Күнбағыс» жарайды ма?
Dialogue: 0,1:23:47.81,1:23:51.48,Default,,0,0,0,,Уайымдамаңыз, бағдарлама дұрыс жұмыс істеп тұрды.
Dialogue: 0,1:23:51.56,1:23:54.32,Default,,0,0,0,,Бірақ екінші және бесінші суреттер...
Dialogue: 0,1:23:54.40,1:23:56.23,Default,,0,0,0,,Уайымдама, балам.
Dialogue: 0,1:23:57.19,1:24:00.28,Default,,0,0,0,,Жоқ, бұл қате емес.
Dialogue: 0,1:24:00.36,1:24:02.53,Default,,0,0,0,,Шынында да екі бөлік қалды.
Dialogue: 0,1:24:03.58,1:24:05.12,Default,,0,0,0,,Бізге тез арада бірдеңе істеу керек...
Dialogue: 0,1:24:05.83,1:24:08.66,Default,,0,0,0,,Екінші және бесінші «күнбағыс» өртеніп жатыр!
Dialogue: 0,1:24:17.59,1:24:18.88,Default,,0,0,0,,Жер бетінде не?
Dialogue: 0,1:24:18.97,1:24:21.01,Default,,0,0,0,,- (Мегуре) Жарайды, түсейік. -Иә.
Dialogue: 0,1:24:21.09,1:24:25.31,Default,,0,0,0,,Инспектор Накаморидің нұсқауы - Азуманы артқы есікке апару.
Dialogue: 0,1:24:29.56,1:24:30.98,Default,,0,0,0,,Мен мұнда қаламын! Өтінемін, менімен бірге шайқасуға рұқсат ет!
Dialogue: 0,1:24:32.40,1:24:34.23,Default,,0,0,0,,(Барлығы ауыр тыныс алады)
Dialogue: 0,1:24:34.31,1:24:35.19,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,1:24:40.40,1:24:43.11,Default,,0,0,0,,Шығысты маған инспектор Чарли берді.
Dialogue: 0,1:24:43.20,1:24:45.28,Default,,0,0,0,,Бірақ бұл нақты нені білдіреді?
Dialogue: 0,1:24:45.37,1:24:46.53,Default,,0,0,0,,Өрт шықты
Dialogue: 0,1:24:46.62,1:24:48.70,Default,,0,0,0,,Кешіріңіз, жоғарыдан эвакуация бойынша нұсқаулық сұраңыз.
Dialogue: 0,1:24:48.79,1:24:50.16,Default,,0,0,0,,Түсіндім
Dialogue: 0,1:24:50.25,1:24:52.21,Default,,0,0,0,,- (Накамори) Біз де сізге жол көрсетеміз - (Когоро) О.
Dialogue: 0,1:24:56.21,1:24:58.59,Default,,0,0,0,,Иә? Конан-кун...
Dialogue: 0,1:24:59.21,1:25:00.17,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,1:25:00.26,1:25:03.68,Default,,0,0,0,,Шит ха ха ха ха...
Dialogue: 0,1:25:04.30,1:25:06.81,Default,,0,0,0,,Бұл жаман, асығуымыз керек!
Dialogue: 0,1:25:06.89,1:25:08.31,Default,,0,0,0,,«Күнбағыс» ғана емес, мен де…
Dialogue: 0,1:25:08.39,1:25:09.56,Default,,0,0,0,,- Бала! -(Шиничи) А?
Dialogue: 0,1:25:09.64,1:25:12.14,Default,,0,0,0,,Ей, қайтып келдің!
Dialogue: 0,1:25:12.23,1:25:13.73,Default,,0,0,0,,Тағы біреуі ше?
Dialogue: 0,1:25:13.81,1:25:16.23,Default,,0,0,0,,Бесінші «күнбағыс» жарайды ма?
Dialogue: 0,1:25:16.31,1:25:18.98,Default,,0,0,0,,Әй, әлгі тығын бірден шығып кетті...
Dialogue: 0,1:25:19.07,1:25:21.86,Default,,0,0,0,,Мен жат жерде тұрып қалдым...
Dialogue: 0,1:25:21.95,1:25:24.53,Default,,0,0,0,,Тез алып тастамасаң, бояу еріп кетеді.
Dialogue: 0,1:25:24.61,1:25:26.37,Default,,0,0,0,,- Жолдан кет Бала - (Шиничи) А-а-а!
Dialogue: 0,1:25:26.45,1:25:29.45,Default,,0,0,0,,Ба... ақымақ, тоқта! Бұл «Күнбағыс»!
Dialogue: 0,1:25:29.54,1:25:31.33,Default,,0,0,0,,Бұл адамзаттың қазынасы!
Dialogue: 0,1:25:31.41,1:25:32.83,Default,,0,0,0,,О, бұл…
Dialogue: 0,1:25:35.42,1:25:36.84,Default,,0,0,0,,Уау!
Dialogue: 0,1:25:37.67,1:25:39.30,Default,,0,0,0,,- (Шиничи) Уау! -Ол қалай?
Dialogue: 0,1:25:40.30,1:25:41.21,Default,,0,0,0,,Бұл...
Dialogue: 0,1:25:41.30,1:25:42.76,Default,,0,0,0,,Сіз мені көздедіңіз!
Dialogue: 0,1:25:42.84,1:25:44.68,Default,,0,0,0,,Егер сіз осындай нәрсені айтып жатсаңыз!
Dialogue: 0,1:25:45.26,1:25:47.18,Default,,0,0,0,,Жоқ, қарғыс атсын...
Dialogue: 0,1:25:47.76,1:25:49.97,Default,,0,0,0,,Анау қарт, оны қандай күшті жасады...
Dialogue: 0,1:25:50.06,1:25:51.64,Default,,0,0,0,,- (Рен) Конан-кун! -(2 адам)
Dialogue: 0,1:25:52.23,1:25:53.39,Default,,0,0,0,,Маған бәрібір! Ха!
Dialogue: 0,1:25:53.48,1:25:54.81,Default,,0,0,0,,Әй, Шиничи!
Dialogue: 0,1:25:54.89,1:25:56.81,Default,,0,0,0,,Ол келді.
Dialogue: 0,1:25:56.90,1:26:01.07,Default,,0,0,0,,Сіз жай тыңдап тұрсыз ба? Тез қашпасаң қауіпті!
Dialogue: 0,1:26:01.15,1:26:02.28,Default,,0,0,0,,-（） -
Dialogue: 0,1:26:02.36,1:26:03.70,Default,,0,0,0,,-（） -
Dialogue: 0,1:26:03.78,1:26:05.57,Default,,0,0,0,,А... не айтып тұрсың?
Dialogue: 0,1:26:05.66,1:26:07.57,Default,,0,0,0,,«Күнбағыс» ұсталды.
Dialogue: 0,1:26:07.66,1:26:10.24,Default,,0,0,0,,Бұл жігіттен құтылу үшін қабырғаны бұзу керек.
Dialogue: 0,1:26:10.33,1:26:12.16,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,1:26:13.45,1:26:15.12,Default,,0,0,0,,Қараңыз, қаншама Ято-ра бар
Dialogue: 0,1:26:15.21,1:26:16.71,Default,,0,0,0,,Иә, мен тырысамын.
Dialogue: 0,1:26:16.79,1:26:18.00,Default,,0,0,0,,Артқа қадам бас, Шиничи.
Dialogue: 0,1:26:18.08,1:26:20.00,Default,,0,0,0,,- (Рен) Конан-кун да - Иә...
Dialogue: 0,1:26:20.59,1:26:23.55,Default,,0,0,0,,Хааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,1:26:23.63,1:26:24.55,Default,,0,0,0,,Өтінемін!
Dialogue: 0,1:26:24.63,1:26:25.63,Default,,0,0,0,,Жүгірдім!
Dialogue: 0,1:26:26.30,1:26:27.89,Default,,0,0,0,,Сейя!
Dialogue: 0,1:26:32.31,1:26:33.81,Default,,0,0,0,,Хамф!
Dialogue: 0,1:26:39.69,1:26:41.07,Default,,0,0,0,,- (Шиничи) Жарайды! Ой... - (Жүгіріп) Ия!
Dialogue: 0,1:26:41.15,1:26:43.07,Default,,0,0,0,,…
Dialogue: 0,1:26:43.15,1:26:44.74,Default,,0,0,0,,…
Dialogue: 0,1:26:44.82,1:26:46.74,Default,,0,0,0,,…
Dialogue: 0,1:26:52.58,1:26:54.70,Default,,0,0,0,,Мен не істеуім керек? Өткел...
Dialogue: 0,1:26:54.79,1:26:56.46,Default,,0,0,0,,Жарайды, артта қал.
Dialogue: 0,1:26:56.54,1:26:57.75,Default,,0,0,0,,Ух... иә
Dialogue: 0,1:26:59.83,1:27:01.88,Default,,0,0,0,,Цзи-чан, сен мені естисің бе?
Dialogue: 0,1:27:03.25,1:27:05.63,Default,,0,0,0,,Сабырлы болыңыз және үрейленбеңіз
Dialogue: 0,1:27:05.72,1:27:06.76,Default,,0,0,0,,Ақырын төмен түсіңіз.
Dialogue: 0,1:27:06.76,1:27:08.18,Default,,0,0,0,,Баяу төмен түсіңіз.
Dialogue: 0,1:27:06.76,1:27:08.18,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,1:27:08.18,1:27:08.97,Default,,0,0,0,,Баяу төмен түсіңіз.
Dialogue: 0,1:27:09.05,1:27:11.18,Default,,0,0,0,,Сабырлы болыңыз және үрейленбеңіз
Dialogue: 0,1:27:18.81,1:27:19.56,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:27:19.56,1:27:20.10,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:27:19.56,1:27:20.10,Default,,0,0,0,,(Барлығының таңданған дауысы)
Dialogue: 0,1:27:20.10,1:27:21.81,Default,,0,0,0,,(Барлығының таңданған дауысы)
Dialogue: 0,1:27:23.19,1:27:24.61,Default,,0,0,0,,- (Шиничи) Жүгіріп кетті! -(Жүгіріп) А...
Dialogue: 0,1:27:24.69,1:27:27.32,Default,,0,0,0,,Ұстаңыз, жібермеңіз!
Dialogue: 0,1:27:27.40,1:27:28.91,Default,,0,0,0,,Уф... болмайды!
Dialogue: 0,1:27:31.99,1:27:33.08,Default,,0,0,0,,Хмм… Дегенмен, егер сол лас—
Dialogue: 0,1:27:40.75,1:27:42.59,Default,,0,0,0,,- (Шиничи) Не? - Уф
Dialogue: 0,1:27:50.51,1:27:52.14,Default,,0,0,0,,Не... не?
Dialogue: 0,1:27:52.22,1:27:56.56,Default,,0,0,0,,Су ыдысынан су ағып жатқан сияқты.
Dialogue: 0,1:27:56.64,1:27:59.64,Default,,0,0,0,,...Бұл өрт сөнді дегенді білдіре ме?
Dialogue: 0,1:27:59.73,1:28:02.31,Default,,0,0,0,,...
Dialogue: 0,1:28:02.40,1:28:03.86,Default,,0,0,0,,Ондай емес пе?
Dialogue: 0,1:28:03.94,1:28:05.69,Default,,0,0,0,,Сіз бірге емессіз бе?
Dialogue: 0,1:28:05.78,1:28:07.49,Default,,0,0,0,,Орхидея жоқ. Орхидея қайда?
Dialogue: 0,1:28:07.57,1:28:08.65,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,1:28:08.74,1:28:11.45,Default,,0,0,0,,Олар осы қарбалас уақытта қайда барды?
Dialogue: 0,1:28:11.53,1:28:14.70,Default,,0,0,0,,Мен сені дәл қазір артымда қалдым деп ойладым...
Dialogue: 0,1:28:14.78,1:28:15.95,Default,,0,0,0,,Ұялы телефон да жұмыс істемейді
Dialogue: 0,1:28:16.54,1:28:19.16,Default,,0,0,0,,Ағай, сіз бірінші түскен шығарсыз.
Dialogue: 0,1:28:19.25,1:28:20.92,Default,,0,0,0,,Мен сені іздеймін.
Dialogue: 0,1:28:21.00,1:28:22.50,Default,,0,0,0,,...
Dialogue: 0,1:28:22.58,1:28:23.92,Default,,0,0,0,,Біз де барайық!
Dialogue: 0,1:28:24.00,1:28:24.84,Default,,0,0,0,,- (Аюми) Иә! -(Мицухико) Иә!
Dialogue: 0,1:28:26.05,1:28:28.42,Default,,0,0,0,,Кудо-кун, мүмкін емес...
Dialogue: 0,1:28:33.34,1:28:34.22,Default,,0,0,0,,Дәл…
Dialogue: 0,1:28:35.10,1:28:36.47,Default,,0,0,0,,- Уф - (Шиничи) Жақсысың ба, детектив?
Dialogue: 0,1:28:36.56,1:28:37.52,Default,,0,0,0,,Бәрінен де бұл орхидея.
Dialogue: 0,1:28:37.60,1:28:39.56,Default,,0,0,0,,жүгірді Мықты болыңыз!
Dialogue: 0,1:28:39.64,1:28:41.60,Default,,0,0,0,,Ха ха... жарайды.
Dialogue: 0,1:28:41.69,1:28:44.31,Default,,0,0,0,,Жаңа ғана су ішіп, есінен танып қалдым.
Dialogue: 0,1:28:47.65,1:28:51.03,Default,,0,0,0,,Әй, қара! Судың күші басылады.
Dialogue: 0,1:28:51.82,1:28:54.57,Default,,0,0,0,,Су ыдысындағы барлық су ағып кетті.
Dialogue: 0,1:28:55.12,1:28:57.95,Default,,0,0,0,,Аа, мен Күнбағысқа алаңдап отырмын. Барайық!
Dialogue: 0,1:29:01.46,1:29:04.29,Default,,0,0,0,,Сіз қылмыскердің жоспары туралы білесіз бе?
Dialogue: 0,1:29:04.38,1:29:05.42,Default,,0,0,0,,О
Dialogue: 0,1:29:05.50,1:29:08.00,Default,,0,0,0,,Дәліздегі күнбағыс сақтандырғышқа айналса
Dialogue: 0,1:29:08.09,1:29:11.17,Default,,0,0,0,,Түтік жолы бас бау болуы керек.
Dialogue: 0,1:29:11.26,1:29:12.72,Default,,0,0,0,,...Бұл кінәлі дегенді білдіреді
Dialogue: 0,1:29:12.80,1:29:16.14,Default,,0,0,0,,Түтік жолына күнбағыс отырғызуды ұсынған адам.
Dialogue: 0,1:29:16.22,1:29:17.39,Default,,0,0,0,,О
Dialogue: 0,1:29:17.47,1:29:19.89,Default,,0,0,0,,Қылмыскерді ақыры тапқан сияқтымыз.
Dialogue: 0,1:29:19.97,1:29:21.98,Default,,0,0,0,,Енді құтылайық.
Dialogue: 0,1:29:22.06,1:29:24.85,Default,,0,0,0,,Әй, қалай шығасың?
Dialogue: 0,1:29:24.94,1:29:26.90,Default,,0,0,0,,Түтік жолымен жоғары қарай жүріңіз
Dialogue: 0,1:29:26.98,1:29:29.32,Default,,0,0,0,,Шығуға жақын жоғарғы қабатқа барыңыз
Dialogue: 0,1:29:29.40,1:29:32.70,Default,,0,0,0,,Сіз лифт шахтасынан көтеріле аласыз.
Dialogue: 0,1:29:32.78,1:29:35.11,Default,,0,0,0,,Сіз не істеуді жоспарладыңыз?
Dialogue: 0,1:29:35.20,1:29:36.07,Default,,0,0,0,,Иә?
Dialogue: 0,1:29:36.16,1:29:37.62,Default,,0,0,0,,- Қашу - (Шиничи) Hmph
Dialogue: 0,1:29:38.20,1:29:40.83,Default,,0,0,0,,Сіз оны есептемеуіңіз керек еді.
Dialogue: 0,1:29:40.91,1:29:44.08,Default,,0,0,0,,Әктас үңгірінің артқы жағында дайындалған шығуға ұшайық.
Dialogue: 0,1:29:44.17,1:29:46.00,Default,,0,0,0,,Мен бірден кете аламын.
Dialogue: 0,1:29:46.08,1:29:50.13,Default,,0,0,0,,Мына жас келіншек екеуіңді көтерсем, жете алмаймын.
Dialogue: 0,1:29:50.21,1:29:51.13,Default,,0,0,0,,Бала…
Dialogue: 0,1:29:51.21,1:29:52.97,Default,,0,0,0,,Айтпақшы
Dialogue: 0,1:29:53.05,1:29:56.09,Default,,0,0,0,,Қылмыскердің жоспарын білсең, неге білмедің...
Dialogue: 0,1:29:56.18,1:29:58.89,Default,,0,0,0,,Қылмыс қылмыскердің компьютерінен жоспарланған.
Dialogue: 0,1:29:58.97,1:30:00.85,Default,,0,0,0,,Мен оны ұрлап жүргендіктен білдім.
Dialogue: 0,1:30:00.93,1:30:03.81,Default,,0,0,0,,Сыбайластың болуы әлі де болды.
Dialogue: 0,1:30:03.89,1:30:05.60,Default,,0,0,0,,Электр қуатының үзілуіне кедергі жасағыңыз келсе
Dialogue: 0,1:30:05.69,1:30:09.61,Default,,0,0,0,,Детектив Чарли мені тауып алып, қуып шықты.
Dialogue: 0,1:30:09.69,1:30:13.19,Default,,0,0,0,,Бір жерде біреуге жұмбақ хабарлама жіберу.
Dialogue: 0,1:30:13.28,1:30:16.45,Default,,0,0,0,,Тезірек шешіледі деп ойладым.
Dialogue: 0,1:30:16.53,1:30:17.78,Default,,0,0,0,,Кластерлік бомбалармен кілем бомбалау шамамен іске жарар еді.
Dialogue: 0,1:30:18.45,1:30:20.70,Default,,0,0,0,,Бір минут күтіңіз, мен қашуға дайындаламын.
Dialogue: 0,1:30:24.91,1:30:27.04,Default,,0,0,0,,Мен лифт залынан келе жатырмын.
Dialogue: 0,1:30:27.13,1:30:28.79,Default,,0,0,0,,Мен сенің қашып құтыла алатыныңды тексеремін.
Dialogue: 0,1:30:28.88,1:30:32.00,Default,,0,0,0,,Әзірше, қылмыскерді ұстаңыз.
Dialogue: 0,1:30:32.09,1:30:33.59,Default,,0,0,0,,Түсіндім
Dialogue: 0,1:30:34.38,1:30:38.14,Default,,0,0,0,,Егер сіз тағы бір ебедейсіз трюк жасасаңыз, қиын болар еді.
Dialogue: 0,1:30:38.93,1:30:39.80,Default,,0,0,0,,Иә
Dialogue: 0,1:30:40.93,1:30:41.81,Default,,0,0,0,,О
Dialogue: 0,1:30:42.68,1:30:45.43,Default,,0,0,0,,Олай болса мен мұны сізге қалдырамын!
Dialogue: 0,1:30:46.27,1:30:48.02,Default,,0,0,0,,- (Ран) Шиничи... -Ах.
Dialogue: 0,1:30:48.10,1:30:50.19,Default,,0,0,0,,Күте тұр, жүгірді.
Dialogue: 0,1:30:55.57,1:30:56.45,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,1:30:57.16,1:30:59.49,Default,,0,0,0,,Өйткені өртті сөндіруге көп уақыт кетті
Dialogue: 0,1:30:59.57,1:31:01.95,Default,,0,0,0,,Үңгір ішіндегі қысым күтілгеннен де көп төмендеді.
Dialogue: 0,1:31:02.58,1:31:05.46,Default,,0,0,0,,Тез қашып құтылмасақ, ол құлайды.
Dialogue: 0,1:31:08.96,1:31:11.75,Default,,0,0,0,,Есік ашылады. Сақ болыңыз.
Dialogue: 0,1:31:11.84,1:31:14.76,Default,,0,0,0,,...
Dialogue: 0,1:31:16.76,1:31:18.76,Default,,0,0,0,,Жақсы! «Күнбағыс» қауіпсіз!
Dialogue: 0,1:31:18.84,1:31:21.97,Default,,0,0,0,,１ ２ ３ ４ ５ ６…
Dialogue: 0,1:31:22.05,1:31:24.14,Default,,0,0,0,,Бұл біртүрлі! Бар болғаны 6 дана!
Dialogue: 0,1:31:24.22,1:31:27.44,Default,,0,0,0,,-（） - １
Dialogue: 0,1:31:27.52,1:31:29.19,Default,,0,0,0,,...
Dialogue: 0,1:31:34.28,1:31:37.32,Default,,0,0,0,,２「」…
Dialogue: 0,1:31:37.40,1:31:39.78,Default,,0,0,0,,Ашияның «Күнбағыстары» келмеді!
Dialogue: 0,1:31:39.78,1:31:40.41,Default,,0,0,0,,Ашияның «Күнбағыстары» келмеді!
Dialogue: 0,1:31:39.78,1:31:40.41,Default,,0,0,0,,Бұл...
Dialogue: 0,1:31:40.41,1:31:40.49,Default,,0,0,0,,Бұл...
Dialogue: 0,1:31:40.49,1:31:40.95,Default,,0,0,0,,Бұл...
Dialogue: 0,1:31:40.49,1:31:40.95,Default,,0,0,0,,Неліктен? Неге Ашияда «Күнбағыс» ғана...
Dialogue: 0,1:31:40.95,1:31:43.91,Default,,0,0,0,,「」…
Dialogue: 0,1:31:43.99,1:31:45.33,Default,,0,0,0,,Сенімді болыңыз
Dialogue: 0,1:31:45.41,1:31:48.29,Default,,0,0,0,,Бұл Синичи Кудо дауысы ма?
Dialogue: 0,1:31:48.37,1:31:51.04,Default,,0,0,0,,「」
Dialogue: 0,1:31:51.13,1:31:53.42,Default,,0,0,0,,...
Dialogue: 0,1:31:53.50,1:31:54.88,Default,,0,0,0,,Бұл тағы да сенсің!
Dialogue: 0,1:31:54.96,1:31:56.63,Default,,0,0,0,,…
Dialogue: 0,1:31:56.71,1:31:59.47,Default,,0,0,0,,Жарайды, олай айтпа, тыңда.
Dialogue: 0,1:31:59.55,1:32:02.35,Default,,0,0,0,,—
Dialogue: 0,1:32:02.93,1:32:04.47,Default,,0,0,0,,５「」
Dialogue: 0,1:32:04.56,1:32:06.89,Default,,0,0,0,,Себебі мен Ашияның «Күнбағыстарын» қорғадым.
Dialogue: 0,1:32:06.97,1:32:09.94,Default,,0,0,0,,...
Dialogue: 0,1:32:10.02,1:32:12.90,Default,,0,0,0,,...
Dialogue: 0,1:32:12.98,1:32:15.23,Default,,0,0,0,,...
Dialogue: 0,1:32:15.32,1:32:18.24,Default,,0,0,0,,Коджи Азума әлдеқашан қорғалған.
Dialogue: 0,1:32:18.32,1:32:19.28,Default,,0,0,0,,Жоқ
Dialogue: 0,1:32:19.36,1:32:21.66,Default,,0,0,0,,...
Dialogue: 0,1:32:21.74,1:32:24.20,Default,,0,0,0,,...
Dialogue: 0,1:32:24.28,1:32:27.75,Default,,0,0,0,,Екі «күнбағысты» өртеп жіберуге еш себеп жоқ.
Dialogue: 0,1:32:27.83,1:32:31.25,Default,,0,0,0,,「」
Dialogue: 0,1:32:31.33,1:32:33.38,Default,,0,0,0,,Мен сендермен сөйлесуім керек еді.
Dialogue: 0,1:32:33.46,1:32:34.88,Default,,0,0,0,,Бұл дұрыс, бірақ...
Dialogue: 0,1:32:35.46,1:32:38.42,Default,,0,0,0,,々
Dialogue: 0,1:32:38.51,1:32:42.30,Default,,0,0,0,,А, біз бәріміз Күнбағысты қорғау үшін көп еңбек еткен достармыз.
Dialogue: 0,1:32:42.39,1:32:43.47,Default,,0,0,0,,Иә.
Dialogue: 0,1:32:43.55,1:32:46.76,Default,,0,0,0,,...
Dialogue: 0,1:32:46.85,1:32:49.10,Default,,0,0,0,,Ұрының айтқанына қалай сенесің?
Dialogue: 0,1:32:49.18,1:32:50.52,Default,,0,0,0,,...
Dialogue: 0,1:32:50.60,1:32:52.14,Default,,0,0,0,,Не болды, мырза Мокки!
Dialogue: 0,1:32:52.23,1:32:53.94,Default,,0,0,0,,「」
Dialogue: 0,1:32:54.02,1:32:55.56,Default,,0,0,0,,Менің ойымша, сен бақытты болуың керек.
Dialogue: 0,1:32:55.65,1:32:58.78,Default,,0,0,0,,...
Dialogue: 0,1:32:58.86,1:33:01.36,Default,,0,0,0,,Мен сақтандырғышты тұтатсам да...
Dialogue: 0,1:33:01.45,1:33:02.78,Default,,0,0,0,,…
Dialogue: 0,1:33:03.41,1:33:04.66,Default,,0,0,0,,...
Dialogue: 0,1:33:04.74,1:33:07.08,Default,,0,0,0,,Ашияның «Күнбағыс» және 5-ші «Күнбағыс»
Dialogue: 0,1:33:07.16,1:33:09.00,Default,,0,0,0,,Өйткені оны өртеп жіберу керек еді.
Dialogue: 0,1:33:09.08,1:33:10.87,Default,,0,0,0,,Сіз басынан бастапсыз
Dialogue: 0,1:33:10.96,1:33:14.33,Default,,0,0,0,,Мақсат осы екі «Күнбағысты» жою болды.
Dialogue: 0,1:33:14.42,1:33:15.96,Default,,0,0,0,,Ондай бос сөзді айтпа!
Dialogue: 0,1:33:16.04,1:33:18.17,Default,,0,0,0,,Неліктен мен мұны істеймін ...
Dialogue: 0,1:33:18.25,1:33:19.46,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:33:19.55,1:33:22.17,Default,,0,0,0,,Оларды бір-бірден тексерейік.
Dialogue: 0,1:33:22.76,1:33:26.10,Default,,0,0,0,,Кайто Кид аукцион өтетін жерде төбелеске шыққаннан кейін.
Dialogue: 0,1:33:26.18,1:33:28.14,Default,,0,0,0,,Қауіпсіздік жүйесі күшейтілді
Dialogue: 0,1:33:28.22,1:33:31.48,Default,,0,0,0,,Енді күнбағыстарды ұстай алмайсыз.
Dialogue: 0,1:33:31.56,1:33:34.02,Default,,0,0,0,,Осылайша біз Америкадағы жойылудан бас тарттық.
Dialogue: 0,1:33:34.10,1:33:38.40,Default,,0,0,0,,Жұмысшыларды Жапонияға әуе көлігімен тасымалдау кезінде пара беру
Dialogue: 0,1:33:38.48,1:33:42.15,Default,,0,0,0,,Ангардың жанындағы есікке бомба қойылды.
Dialogue: 0,1:33:42.24,1:33:44.53,Default,,0,0,0,,Бірақ бұған да Кид кедергі жасады.
Dialogue: 0,1:33:44.61,1:33:45.91,Default,,0,0,0,,Сіз мақсат етесіз
Dialogue: 0,1:33:45.99,1:33:48.66,Default,,0,0,0,,2-ші суретті 5-ші «күнбағысқа» өзгертуді жөн көрдім...
Dialogue: 0,1:33:48.74,1:33:49.62,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:33:50.24,1:33:52.71,Default,,0,0,0,,Мұны бірінші болып Бала түсінді.
Dialogue: 0,1:33:52.79,1:33:57.29,Default,,0,0,0,,Детектив Мориге хабарлама жіберіп, тағы да сақ болуға шақырды.
Dialogue: 0,1:33:58.00,1:34:00.63,Default,,0,0,0,,Сіз екі рет үзілді.
Dialogue: 0,1:34:00.71,1:34:02.80,Default,,0,0,0,,Бұл жолы Кидтен алда болу үшін.
Dialogue: 0,1:34:02.88,1:34:07.22,Default,,0,0,0,,Ағаш қораптың қақпағының артына жалған балалар картасын бекіту
Dialogue: 0,1:34:08.01,1:34:11.06,Default,,0,0,0,,Мен оны өз шеберханама беруге тырыстым.
Dialogue: 0,1:34:11.14,1:34:15.10,Default,,0,0,0,,Кид Күнбағысты қорғау үшін зұлым адамды жалдады ма?
Dialogue: 0,1:34:15.19,1:34:18.44,Default,,0,0,0,,Бұл өтірік! Бұл сіздің қиялыңыз ғана
Dialogue: 0,1:34:18.52,1:34:19.90,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:34:19.98,1:34:22.90,Default,,0,0,0,,Нацуми Ван Гогтың «Күнбағыстарын» бәрінен де жақсы көреді.
Dialogue: 0,1:34:22.99,1:34:24.99,Default,,0,0,0,,Бұлай істеу мүмкін емес.
Dialogue: 0,1:34:25.07,1:34:25.99,Default,,0,0,0,,Иә
Dialogue: 0,1:34:26.07,1:34:29.12,Default,,0,0,0,,Ал неге екеуін ғана жою керек?
Dialogue: 0,1:34:29.91,1:34:32.45,Default,,0,0,0,,Шынында да, дәл осы екі «күнбағыс»
Dialogue: 0,1:34:32.54,1:34:34.87,Default,,0,0,0,,Қираудың себебі әлі белгісіз.
Dialogue: 0,1:34:34.96,1:34:36.92,Default,,0,0,0,,Бұл ақылсыз жұмбақ шоу.
Dialogue: 0,1:34:37.00,1:34:40.63,Default,,0,0,0,,Ал, себебін кейін Нацумиден естимін.
Dialogue: 0,1:34:40.71,1:34:41.67,Default,,0,0,0,,Иә?
Dialogue: 0,1:34:41.75,1:34:43.42,Default,,0,0,0,,Мәселеге көшейік.
Dialogue: 0,1:34:43.51,1:34:46.01,Default,,0,0,0,,Нацуми көліндегі Рок-Түб жолындағы
Dialogue: 0,1:34:46.09,1:34:48.30,Default,,0,0,0,,Күнбағыспен безендіргім келетінін айтқан адам болды
Dialogue: 0,1:34:48.39,1:34:50.68,Default,,0,0,0,,Мен бұл сен екеніңді естідім. Бұл рас па?
Dialogue: 0,1:34:50.76,1:34:52.01,Default,,0,0,0,,Иә... иә
Dialogue: 0,1:34:52.10,1:34:55.18,Default,,0,0,0,,Сіз бағалаушы лауазымыңызды пайдаланасыз ба?
Dialogue: 0,1:34:55.27,1:34:58.10,Default,,0,0,0,,Суреттерді қалпына келтіруде жиі қолданылатын скипидар.
Dialogue: 0,1:34:58.19,1:35:02.11,Default,,0,0,0,,Жоғарғы қабаттан күнбағыспен безендірілген ойыққа құйыңыз.
Dialogue: 0,1:35:02.19,1:35:04.03,Default,,0,0,0,,Сақтандырғыш ретінде пайдаланылады
Dialogue: 0,1:35:04.11,1:35:08.86,Default,,0,0,0,,Бұл менің айтқанымды пайдаланған сатқын.
Dialogue: 0,1:35:09.41,1:35:13.54,Default,,0,0,0,,Осы сияқты түсініксіз нәрселер үшін адамдарға қылмыскер ретінде қарамаңыз!
Dialogue: 0,1:35:14.16,1:35:15.66,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:35:15.75,1:35:18.75,Default,,0,0,0,,Негізі, мен оның өзін тапсырғанын қаладым, бірақ...
Dialogue: 0,1:35:18.83,1:35:22.04,Default,,0,0,0,,Егер сізге нақтырақ дәлел қажет болса, мен оны кейінірек көрсетемін.
Dialogue: 0,1:35:22.13,1:35:23.00,Default,,0,0,0,,Ах...
Dialogue: 0,1:35:23.09,1:35:24.88,Default,,0,0,0,,Компьютер деректері
Dialogue: 0,1:35:24.96,1:35:27.59,Default,,0,0,0,,Екі Күнбағысты жою жоспары.
Dialogue: 0,1:35:27.68,1:35:28.55,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:35:30.59,1:35:34.68,Default,,0,0,0,,Аа, қазір алдаудың жолы жоқ сияқты.
Dialogue: 0,1:35:34.77,1:35:36.60,Default,,0,0,0,,Иесі 5-ші «Күнбағыс»…
Dialogue: 0,1:35:36.68,1:35:39.60,Default,,0,0,0,,Ал Ашияның «Күнбағысты» жою
Dialogue: 0,1:35:39.69,1:35:41.61,Default,,0,0,0,,Сіз менің командамдасыз, солай ма?
Dialogue: 0,1:35:41.69,1:35:43.07,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,1:35:43.15,1:35:46.24,Default,,0,0,0,,Алайда оқиға орнына Кайто Кид есімді мазасыз адам келді.
Dialogue: 0,1:35:46.32,1:35:48.32,Default,,0,0,0,,Іс мен ойлағандай болмады.
Dialogue: 0,1:35:48.90,1:35:53.70,Default,,0,0,0,,Сондықтан Кидке араласу қиын, себебі ол осы көл жартасында өрт шығарды.
Dialogue: 0,1:35:53.78,1:35:56.33,Default,,0,0,0,,Екі «күнбағысты» өртеуге тырысты
Dialogue: 0,1:35:56.41,1:35:57.66,Default,,0,0,0,,Иә
Dialogue: 0,1:35:57.75,1:36:00.83,Default,,0,0,0,,Бірақ алғашында мен мұны соншалықты үлкен мәселеге айналдырғым келмеді.
Dialogue: 0,1:36:01.71,1:36:03.13,Default,,0,0,0,,Электр қуатының үзілуін пайдалану
Dialogue: 0,1:36:03.21,1:36:06.84,Default,,0,0,0,,Ашияның «Күнбағыс» пен 5-ші «Күнбағысты» алсаң.
Dialogue: 0,1:36:06.92,1:36:08.84,Default,,0,0,0,,Бәрі аяқталуы керек еді...
Dialogue: 0,1:36:09.68,1:36:12.34,Default,,0,0,0,,Баланың соңынан тіпті қара киім де кедергі жасайды...
Dialogue: 0,1:36:12.43,1:36:15.14,Default,,0,0,0,,Бірден екінші және бесінші «Күнбағыстарды» алыңыз—
Dialogue: 0,1:36:15.22,1:36:16.89,Default,,0,0,0,,Ескерту
Dialogue: 0,1:36:16.97,1:36:19.48,Default,,0,0,0,,Ал «күнбағыс» ше?
Dialogue: 0,1:36:19.56,1:36:22.02,Default,,0,0,0,,Егер сіз оны оңай ұстасаңыз, қауіпсіздік құралы жұмыс істейді...
Dialogue: 0,1:36:22.10,1:36:23.48,Default,,0,0,0,,Бұл оңай.
Dialogue: 0,1:36:23.56,1:36:25.90,Default,,0,0,0,,Өзіңізбен бірге алып келген фосфинді жағыңыз.
Dialogue: 0,1:36:26.53,1:36:27.78,Default,,0,0,0,,Фосфин?
Dialogue: 0,1:36:27.86,1:36:31.36,Default,,0,0,0,,Бұл бөлме температурасында да өздігінен тұтануы мүмкін қауіпті химиялық зат.
Dialogue: 0,1:36:31.45,1:36:34.87,Default,,0,0,0,,Сонда мені өлтірмек болған сен бе?
Dialogue: 0,1:36:34.95,1:36:36.37,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:36:36.45,1:36:39.25,Default,,0,0,0,,Ұйымдастырушы қайтыс болса, іс-шара кейінге қалдырылады.
Dialogue: 0,1:36:39.33,1:36:42.88,Default,,0,0,0,,Көрменің өзі жоғалып кету мүмкіндігі бар.
Dialogue: 0,1:36:42.96,1:36:43.83,Default,,0,0,0,,Ой, жоқ!
Dialogue: 0,1:36:44.46,1:36:47.13,Default,,0,0,0,,Бұл өрт пен ұшақтың жарылуы...
Dialogue: 0,1:36:47.21,1:36:48.67,Default,,0,0,0,,Егер сіз бірдеңе дұрыс істесеңіз, өзіңіз.
Dialogue: 0,1:36:48.76,1:36:50.80,Default,,0,0,0,,Өлуің мүмкін еді, Нацуми!
Dialogue: 0,1:36:51.43,1:36:52.80,Default,,0,0,0,,Мен...
Dialogue: 0,1:36:53.55,1:36:56.56,Default,,0,0,0,,Мен Ван Гогтың «Күнбағыстарын» сондай жақсы көремін!
Dialogue: 0,1:36:56.64,1:36:59.10,Default,,0,0,0,,Бұл екі жалғандық Ван Гогтың «Күнбағыстары»
Dialogue: 0,1:36:59.18,1:37:02.44,Default,,0,0,0,,Қатар тұрғанша өлгенім артық!
Dialogue: 0,1:37:03.27,1:37:06.69,Default,,0,0,0,,Сіздің сөздеріңізде немесе әрекеттеріңізде шындық жоқ.
Dialogue: 0,1:37:07.27,1:37:08.61,Default,,0,0,0,,Бесінші «күнбағыс».
Dialogue: 0,1:37:08.69,1:37:11.53,Default,,0,0,0,,Чикаго өнер институтының және Ван Гог мұражайының құжаттары
Dialogue: 0,1:37:11.61,1:37:14.07,Default,,0,0,0,,Оның шынайы екені дәлелденген жоқ па?
Dialogue: 0,1:37:14.74,1:37:15.99,Default,,0,0,0,,Ван Гог және Гоген
Dialogue: 0,1:37:16.08,1:37:18.91,Default,,0,0,0,,Екі адам бір матаны бөліп, сурет салды.
Dialogue: 0,1:37:18.99,1:37:20.45,Default,,0,0,0,,Бұл ең жақсы дәлел.
Dialogue: 0,1:37:20.54,1:37:24.29,Default,,0,0,0,,Бағалаушы ретінде сіз міндетті түрде білуіңіз керек.
Dialogue: 0,1:37:24.38,1:37:25.50,Default,,0,0,0,,Бірақ... Бірақ...
Dialogue: 0,1:37:25.58,1:37:26.46,Default,,0,0,0,,Ал сіз
Dialogue: 0,1:37:26.54,1:37:29.26,Default,,0,0,0,,Өлгенім жақсы болар еді десем де
Dialogue: 0,1:37:29.34,1:37:32.30,Default,,0,0,0,,Ұшақ қонар алдында жарылған.
Dialogue: 0,1:37:32.38,1:37:33.68,Default,,0,0,0,,Бұл да өрт
Dialogue: 0,1:37:33.76,1:37:37.22,Default,,0,0,0,,Мен қашып құтылатын жер мен уақытты есептеп, өртті бастадым.
Dialogue: 0,1:37:37.30,1:37:39.06,Default,,0,0,0,,Қ-қараңыз… ол…
Dialogue: 0,1:37:39.14,1:37:41.52,Default,,0,0,0,,Егер жоспар шынымен өлімге дайындалса
Dialogue: 0,1:37:41.60,1:37:45.10,Default,,0,0,0,,Неліктен сіз Лейк-Рокта қалып, Кидтің өртті сөндіруіне жол бермедіңіз?
Dialogue: 0,1:37:45.73,1:37:48.48,Default,,0,0,0,,Өйткені, сіз өзіңізге ыңғайлы нәрсені ғана жасайсыз.
Dialogue: 0,1:37:48.57,1:37:50.73,Default,,0,0,0,,Ойлай алмайтын қылмыскер.
Dialogue: 0,1:37:51.53,1:37:53.57,Default,,0,0,0,,Мен куратор емеспін.
Dialogue: 0,1:37:54.07,1:37:55.74,Default,,0,0,0,,Мен сене алар емеспін...
Dialogue: 0,1:37:56.45,1:37:57.91,Default,,0,0,0,,Қолдарыңызды алыңыздар
Dialogue: 0,1:37:58.83,1:38:01.79,Default,,0,0,0,,Ол Ван Гогтың картиналарын тым жақсы көретін
Dialogue: 0,1:38:01.87,1:38:06.83,Default,,0,0,0,,Мен бағалаудың ақиқатына емес, өз болжамдарыма негізделген қылмыс жасадым.
Dialogue: 0,1:38:07.33,1:38:08.29,Default,,0,0,0,,Я...
Dialogue: 0,1:38:08.38,1:38:10.25,Default,,0,0,0,,Тазаланған сияқты.
Dialogue: 0,1:38:10.34,1:38:12.84,Default,,0,0,0,,О, бұл туралы ше? Сіз оған көтеріле аламын деп ойлайсыз ба?
Dialogue: 0,1:38:12.92,1:38:14.34,Default,,0,0,0,,Егер бұл тек мен болсам
Dialogue: 0,1:38:14.43,1:38:16.84,Default,,0,0,0,,Не істеу керек? Көмек шақыруым керек пе?
Dialogue: 0,1:38:16.93,1:38:18.01,Default,,0,0,0,,Оны тоқтатқан дұрыс.
Dialogue: 0,1:38:18.10,1:38:21.02,Default,,0,0,0,,Егер көмекке нашар қоңырау шалсаңыз, бұл екінші реттік апатқа әкелуі мүмкін.
Dialogue: 0,1:38:21.10,1:38:21.93,Default,,0,0,0,,О, жоқ!
Dialogue: 0,1:38:26.27,1:38:27.27,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:38:27.35,1:38:29.15,Default,,0,0,0,,Аа, ол қанша уақытқа созылады?
Dialogue: 0,1:38:29.23,1:38:31.90,Default,,0,0,0,,Әлі құламағаны ғажап.
Dialogue: 0,1:38:31.98,1:38:33.74,Default,,0,0,0,,Төбеде тіпті кішкене тесік болса
Dialogue: 0,1:38:33.82,1:38:36.24,Default,,0,0,0,,Сырттағы ауа ішке еніп, құлап кетеді!
Dialogue: 0,1:38:36.32,1:38:39.12,Default,,0,0,0,,Бала! Егер бұл жай Ран болса, біз бірге ұша аламыз ба?
Dialogue: 0,1:38:39.20,1:38:40.45,Default,,0,0,0,,Эй, бұл ақымақ...
Dialogue: 0,1:38:40.45,1:38:41.45,Default,,0,0,0,,Эй, бұл ақымақ...
Dialogue: 0,1:38:40.45,1:38:41.45,Default,,0,0,0,,Сіз ұша аласыз ба, жоқ па?
Dialogue: 0,1:38:41.45,1:38:42.16,Default,,0,0,0,,Сіз ұша аласыз ба, жоқ па?
Dialogue: 0,1:38:42.24,1:38:44.62,Default,,0,0,0,,Қайсысы? Айтыңызшы!
Dialogue: 0,1:38:44.71,1:38:47.42,Default,,0,0,0,,Әй, ұша алатын шығар.
Dialogue: 0,1:38:47.50,1:38:49.54,Default,,0,0,0,,Бірақ... Мына құлап жатқан жартастан жалтарып жүргенде
Dialogue: 0,1:38:49.63,1:38:52.55,Default,,0,0,0,,Атмосфералық қысымы төмендеген кеңістікте ұшуды жалғастыруға бола ма?
Dialogue: 0,1:38:52.63,1:38:54.38,Default,,0,0,0,,Сенімсіз
Dialogue: 0,1:38:54.47,1:38:56.43,Default,,0,0,0,,(жығылған дыбыс)
Dialogue: 0,1:39:08.02,1:39:08.90,Default,,0,0,0,,Уф
Dialogue: 0,1:39:12.65,1:39:14.03,Default,,0,0,0,,Аһ!
Dialogue: 0,1:39:15.32,1:39:16.74,Default,,0,0,0,,Жүгірдім!
Dialogue: 0,1:39:18.66,1:39:19.57,Default,,0,0,0,,Құт
Dialogue: 0,1:39:20.07,1:39:21.49,Default,,0,0,0,,Бала!
Dialogue: 0,1:39:21.58,1:39:23.29,Default,,0,0,0,,Иә!
Dialogue: 0,1:39:23.99,1:39:26.41,Default,,0,0,0,,Мен орхидея сұрадым!
Dialogue: 0,1:39:26.50,1:39:28.75,Default,,0,0,0,,Қарғыс атсын, сен салқын болуға тырысыпсың.
Dialogue: 0,1:39:28.83,1:39:29.88,Default,,0,0,0,,Уау
Dialogue: 0,1:39:35.51,1:39:36.80,Default,,0,0,0,,Уф...
Dialogue: 0,1:39:40.64,1:39:43.43,Default,,0,0,0,,Қарғыс атсын, құтылудың әлі жолы бар.
Dialogue: 0,1:39:44.14,1:39:46.43,Default,,0,0,0,,Егер бұл баланың денесі...
Dialogue: 0,1:39:52.15,1:39:54.19,Default,,0,0,0,,Шүкір, мен осы қарқынмен құлаймын!
Dialogue: 0,1:39:54.27,1:39:55.82,Default,,0,0,0,,Шығу қай жерде?
Dialogue: 0,1:39:57.82,1:39:59.24,Default,,0,0,0,,Міне!
Dialogue: 0,1:40:04.45,1:40:07.33,Default,,0,0,0,,Ах, қандай жалықтырарлық.
Dialogue: 0,1:40:08.33,1:40:09.21,Default,,0,0,0,,Егер бұл дене
Dialogue: 0,1:40:09.29,1:40:11.21,Default,,0,0,0,,Ол «Күнбағыс» қашу атқышына қосылуы керек!
Dialogue: 0,1:40:11.29,1:40:12.46,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,1:40:13.75,1:40:14.88,Default,,0,0,0,,Уф
Dialogue: 0,1:40:14.96,1:40:17.05,Default,,0,0,0,,Гррр... Қияметсіз бе!
Dialogue: 0,1:40:17.13,1:40:19.97,Default,,0,0,0,,(Conan's heavy breathing)
Dialogue: 0,1:40:20.05,1:40:21.59,Default,,0,0,0,,Иида-кун мен Яо-санды да құттықтаймыз.
Dialogue: 0,1:40:30.39,1:40:32.40,Default,,0,0,0,,Уф...
Dialogue: 0,1:40:32.48,1:40:34.90,Default,,0,0,0,,Әй, Ашиядағы «Күнбағыс»!
Dialogue: 0,1:40:34.98,1:40:36.90,Default,,0,0,0,,Өтірік... Су мұнарасы...
Dialogue: 0,1:40:36.98,1:40:38.90,Default,,0,0,0,,I need to find these two soon.
Dialogue: 0,1:40:38.99,1:40:40.36,Default,,0,0,0,,Қауіпті көрінеді...
Dialogue: 0,1:40:40.45,1:40:41.82,Default,,0,0,0,,- (Аюми) Ой, қарашы! - (Гента/Мицухико) Иә?
Dialogue: 0,1:40:41.91,1:40:47.20,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,1:40:47.91,1:40:51.42,Default,,0,0,0,,I can't believe there aren't any left...
Dialogue: 0,1:40:51.92,1:40:53.21,Default,,0,0,0,,Ах...
Dialogue: 0,1:40:56.34,1:40:57.96,Default,,0,0,0,,Қауіп...
Dialogue: 0,1:40:58.05,1:40:59.97,Default,,0,0,0,,It was a close call.
Dialogue: 0,1:41:00.05,1:41:02.72,Default,,0,0,0,,Hmm... ah... Shinichi?
Dialogue: 0,1:41:03.39,1:41:05.47,Default,,0,0,0,,Сіз маған көмектесуге келдіңіз...
Dialogue: 0,1:41:05.55,1:41:07.72,Default,,0,0,0,,А, қазір бәрі жақсы.
Dialogue: 0,1:41:08.56,1:41:09.64,Default,,0,0,0,,Иә...
Dialogue: 0,1:41:13.81,1:41:16.15,Default,,0,0,0,,Where are you going? Хайбар мырза!
Dialogue: 0,1:41:16.23,1:41:17.94,Default,,0,0,0,,Кид пен Ран-сан ұшып жатыр!
Dialogue: 0,1:41:18.03,1:41:20.53,Default,,0,0,0,,- (Мицухико) Иә? -(Гента) Шынайы ма? Барайық.
Dialogue: 0,1:41:20.61,1:41:22.03,Default,,0,0,0,,Соноко-оне-сан!
Dialogue: 0,1:41:22.11,1:41:22.99,Default,,0,0,0,,Иә?
Dialogue: 0,1:41:23.07,1:41:25.28,Default,,0,0,0,,Ran-onee-san and Kid are flying!
Dialogue: 0,1:41:25.37,1:41:26.91,Default,,0,0,0,,- (Соноко) Ран мен Кид-сама? - (Когоро) Қайда... қайда?
Dialogue: 0,1:41:26.99,1:41:29.20,Default,,0,0,0,,Бала?
Dialogue: 0,1:41:31.33,1:41:34.21,Default,,0,0,0,,Уф... Шіркін. Бұл да жаман емес пе?
Dialogue: 0,1:41:34.29,1:41:36.46,Default,,0,0,0,,There's no way out
Dialogue: 0,1:41:36.54,1:41:39.51,Default,,0,0,0,,Бұлай жалғаса берсе мен Әшияның «Күнбағыспен» өз-өзіме қол жұмсаймын.
Dialogue: 0,1:41:39.59,1:41:41.22,Default,,0,0,0,,Уф... уау уау
Dialogue: 0,1:41:45.80,1:41:47.55,Default,,0,0,0,,Уау!
Dialogue: 0,1:41:56.06,1:41:56.98,Default,,0,0,0,,Хмм...
Dialogue: 0,1:41:57.90,1:41:59.23,Default,,0,0,0,,Тағы да әуеніңді бұздың! Қанша рет айтуым керек саған түсіну үшін!—
Dialogue: 0,1:42:04.82,1:42:08.74,Default,,0,0,0,,Сіз қашып үлгердіңіз деп ойлаймын, детектив...
Dialogue: 0,1:42:12.29,1:42:14.12,Default,,0,0,0,,- (Соноко) Жүгіріп кетті! -(3 people) Ran-onee-san!
Dialogue: 0,1:42:14.21,1:42:16.67,Default,,0,0,0,,Жүгірдім! Бұл қайда! Жүгіріп кетті!
Dialogue: 0,1:42:20.50,1:42:22.84,Default,,0,0,0,,Әй, Ран! Сенімен бәрі жақсы ма?
Dialogue: 0,1:42:22.92,1:42:26.72,Default,,0,0,0,,Хмм... Әй... Әке...
Dialogue: 0,1:42:26.80,1:42:27.68,Default,,0,0,0,,Фу…
Dialogue: 0,1:42:29.10,1:42:32.77,Default,,0,0,0,,Жүгірдім! Сіз жарақат алдыңыз ба? Сенімен бәрі жақсы ма?
Dialogue: 0,1:42:32.85,1:42:35.35,Default,,0,0,0,,Yeah... Shinichi helped me...
Dialogue: 0,1:42:35.35,1:42:36.23,Default,,0,0,0,,Yeah... Shinichi helped me...
Dialogue: 0,1:42:35.35,1:42:36.23,Default,,0,0,0,,Иә?
Dialogue: 0,1:42:36.81,1:42:39.61,Default,,0,0,0,,Жоқ, Кид маған көмектесті.
Dialogue: 0,1:42:39.69,1:42:41.94,Default,,0,0,0,,Планермен өте жұмсақ!
Dialogue: 0,1:42:42.03,1:42:44.36,Default,,0,0,0,,- (Мицухико) Есіңде жоқ па? - (Жүгіріп) А?
Dialogue: 0,1:42:44.86,1:42:46.41,Default,,0,0,0,,Иә... Мен...
Dialogue: 0,1:42:46.49,1:42:49.58,Default,,0,0,0,,Then that's not Shinichi, it's Kid...
Dialogue: 0,1:42:49.66,1:42:50.53,Default,,0,0,0,,Иә?
Dialogue: 0,1:42:50.62,1:42:52.70,Default,,0,0,0,,So what happened to the priest?
Dialogue: 0,1:42:52.79,1:42:54.29,Default,,0,0,0,,- (Kogoro) Where are you? -(Жүгіріп) А?
Dialogue: 0,1:42:54.37,1:42:55.75,Default,,0,0,0,,Конан-кун, сен сонда емессің бе?
Dialogue: 0,1:42:55.83,1:42:57.88,Default,,0,0,0,,Ах, Баланың көтеріп жүргені
Dialogue: 0,1:42:57.96,1:42:59.04,Default,,0,0,0,,Жалғыз сен едің
Dialogue: 0,1:42:59.13,1:42:59.96,Default,,0,0,0,,Міне!
Dialogue: 0,1:43:01.30,1:43:04.05,Default,,0,0,0,,Сонда Конан-кун әлі...
Dialogue: 0,1:43:06.80,1:43:09.09,Default,,0,0,0,,- (Гента) Иә? Бұл өтірік, солай ма? -(Мицухико) Міне солай!
Dialogue: 0,1:43:12.64,1:43:14.85,Default,,0,0,0,,(Конанның күшті дауысы)
Dialogue: 0,1:43:14.93,1:43:17.02,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,1:43:18.35,1:43:22.11,Default,,0,0,0,,Осы қарқынмен қашуды былай қойғанда, бір минутқа жетпей суға батып кетесіз.
Dialogue: 0,1:43:22.77,1:43:26.11,Default,,0,0,0,,Мен допты атсам, бұл жігіттен құтылатын шығармын.
Dialogue: 0,1:43:26.19,1:43:28.74,Default,,0,0,0,,Суға түсуге жол бермейді
Dialogue: 0,1:43:28.82,1:43:31.12,Default,,0,0,0,,Солай ма? Ол су астында қалды ма?
Dialogue: 0,1:43:31.78,1:43:34.12,Default,,0,0,0,,Осынша су ағып жатыр
Dialogue: 0,1:43:34.20,1:43:37.62,Default,,0,0,0,,Бұл жер қазірдің өзінде көл деңгейінен төмен.
Dialogue: 0,1:43:37.71,1:43:42.25,Default,,0,0,0,,...Егер біз осы отшашу шарымен отшашудың ретін бұзсақ,
Dialogue: 0,1:43:42.34,1:43:46.59,Default,,0,0,0,,Қысым балансы бұзылып, көл кенеттен көлге айналады.
Dialogue: 0,1:43:47.59,1:43:49.80,Default,,0,0,0,,Оны сыпырып тастау керек!
Dialogue: 0,1:43:49.89,1:43:51.64,Default,,0,0,0,,Жақсы! Мен шығамын
Dialogue: 0,1:43:52.35,1:43:55.27,Default,,0,0,0,,５… ４… ３…
Dialogue: 0,1:43:55.35,1:43:58.06,Default,,0,0,0,,2… 1… Нөл!
Dialogue: 0,1:44:04.69,1:44:06.65,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,1:44:07.82,1:44:08.70,Default,,0,0,0,,Конан-кун!
Dialogue: 0,1:44:08.78,1:44:10.16,Default,,0,0,0,,- (Гента) Конан! -(Мицухико) Конан-кун!
Dialogue: 0,1:44:10.24,1:44:12.45,Default,,0,0,0,,Не істеп жатырсың, Конан?
Dialogue: 0,1:44:12.53,1:44:14.49,Default,,0,0,0,,Өтінемін, шығыңыз!
Dialogue: 0,1:44:14.58,1:44:16.62,Default,,0,0,0,,Ей, не істеп жатырсың!
Dialogue: 0,1:44:16.70,1:44:18.21,Default,,0,0,0,,Иә?
Dialogue: 0,1:44:18.29,1:44:19.58,Default,,0,0,0,,Конан!
Dialogue: 0,1:44:19.67,1:44:21.17,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:44:21.25,1:44:24.13,Default,,0,0,0,,Жарайды, Конан-кун, мен сенімдімін...
Dialogue: 0,1:44:24.21,1:44:25.09,Default,,0,0,0,,Уф...
Dialogue: 0,1:44:26.30,1:44:30.80,Default,,0,0,0,,Шығуыңызды өтінемін... Конан-кун.
Dialogue: 0,1:44:42.69,1:44:46.53,Default,,0,0,0,,Тағы да... сәл ғана
Dialogue: 0,1:44:48.24,1:44:49.15,Default,,0,0,0,,Қаха…
Dialogue: 0,1:44:49.95,1:44:52.61,Default,,0,0,0,,А, бірдеңе шықты!
Dialogue: 0,1:44:54.24,1:44:55.41,Default,,0,0,0,,«Күнбағыс»!
Dialogue: 0,1:44:55.49,1:44:57.58,Default,,0,0,0,,О, жарайсың!
Dialogue: 0,1:44:57.66,1:44:58.75,Default,,0,0,0,,Сол «күнбағыс»
Dialogue: 0,1:44:58.83,1:45:01.62,Default,,0,0,0,,Мен оны Конанның ісіне қойдым.
Dialogue: 0,1:45:01.71,1:45:03.88,Default,,0,0,0,,Сондықтан Конан-кун да жақын жерде болуы керек.
Dialogue: 0,1:45:04.46,1:45:06.50,Default,,0,0,0,,Барлығыңыз, Конанды іздеңіз!
Dialogue: 0,1:45:06.59,1:45:07.88,Default,,0,0,0,,Конан-кун!
Dialogue: 0,1:45:07.96,1:45:09.97,Default,,0,0,0,,Конан-кун, сен қайдасың?
Dialogue: 0,1:45:10.05,1:45:11.55,Default,,0,0,0,,Конан-кун
Dialogue: 0,1:45:11.63,1:45:14.85,Default,,0,0,0,,Конан-кун!
Dialogue: 0,1:45:17.97,1:45:19.89,Default,,0,0,0,,Ра… Орхидея…
Dialogue: 0,1:45:23.98,1:45:25.52,Default,,0,0,0,,Әй, ол қайтадан қалқып тұр!
Dialogue: 0,1:45:25.61,1:45:27.27,Default,,0,0,0,,Рас, бұл суреттің екінші жағында!
Dialogue: 0,1:45:27.36,1:45:28.40,Default,,0,0,0,,Е, қайда?
Dialogue: 0,1:45:28.48,1:45:29.74,Default,,0,0,0,,Иә?
Dialogue: 0,1:45:34.74,1:45:36.28,Default,,0,0,0,,Ах!
Dialogue: 0,1:45:36.37,1:45:37.70,Default,,0,0,0,,Уф...
Dialogue: 0,1:45:38.37,1:45:40.70,Default,,0,0,0,,Жарайды, күте тұрыңыз!
Dialogue: 0,1:45:40.79,1:45:42.75,Default,,0,0,0,,- (Жүгіріп) Жақсы - (Соноко) Ағай, жақсы ма?
Dialogue: 0,1:45:42.83,1:45:45.42,Default,,0,0,0,,- (Ран) Конан-кун... - (Джирокичи) Жарайсың Коваппа
Dialogue: 0,1:45:45.50,1:45:48.38,Default,,0,0,0,,Менің өлтірген балам күткендей.
Dialogue: 0,1:45:48.46,1:45:50.30,Default,,0,0,0,,Ахахахаха…
Dialogue: 0,1:45:50.38,1:45:52.80,Default,,0,0,0,,- Уф... - (Когоро) Жақсысың ба? бала
Dialogue: 0,1:45:52.88,1:45:53.80,Default,,0,0,0,,Иә...
Dialogue: 0,1:45:53.88,1:45:55.84,Default,,0,0,0,,«Күнбағысты» жақсы қорғадың.
Dialogue: 0,1:45:55.93,1:45:56.89,Default,,0,0,0,,Жақсы жұмыс
Dialogue: 0,1:45:56.97,1:45:58.26,Default,,0,0,0,,Иә
Dialogue: 0,1:45:58.35,1:46:00.64,Default,,0,0,0,,...
Dialogue: 0,1:46:00.72,1:46:01.60,Default,,0,0,0,,Иә?
Dialogue: 0,1:46:02.39,1:46:05.90,Default,,0,0,0,,Мен әлі түсінбейтін бір нәрсе бар. Түсіндіре аласыз ба?
Dialogue: 0,1:46:05.98,1:46:08.86,Default,,0,0,0,,...
Dialogue: 0,1:46:09.52,1:46:12.53,Default,,0,0,0,,Мен дауыстық хабарлама арқылы сұрау алдым.
Dialogue: 0,1:46:12.61,1:46:16.45,Default,,0,0,0,,Мен сенің екінші және бесінші «күнбағыстарды» ұрлауыңды қалаймын.
Dialogue: 0,1:46:16.53,1:46:17.87,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:46:17.95,1:46:20.37,Default,,0,0,0,,Егер бетпердеге шебер болсаңыз, дауысты тыңдаңыз
Dialogue: 0,1:46:20.45,1:46:24.21,Default,,0,0,0,,Бұл дауыстың кімдікі екенін бірден айта аласыз дегенді білдіре ме?
Dialogue: 0,1:46:25.21,1:46:28.50,Default,,0,0,0,,...
Dialogue: 0,1:46:28.59,1:46:29.88,Default,,0,0,0,,Оның сізге не пайдасы бар?
Dialogue: 0,1:46:30.59,1:46:33.63,Default,,0,0,0,,「」
Dialogue: 0,1:46:33.72,1:46:35.38,Default,,0,0,0,,Оны кімге көрсеткіңіз келеді?
Dialogue: 0,1:46:35.47,1:46:39.43,Default,,0,0,0,,Сол күні әуе шабуылының жалындаған жалындары арасында...
Dialogue: 0,1:46:39.51,1:46:43.23,Default,,0,0,0,,«Күнбағыстарды» жасырын ғашық болған ұстаға сеніп тапсырған.
Dialogue: 0,1:46:43.73,1:46:46.65,Default,,0,0,0,,...
Dialogue: 0,1:46:47.31,1:46:50.32,Default,,0,0,0,,Бұрынғы нәрселер туралы сіз қайдан білесіз?
Dialogue: 0,1:46:50.40,1:46:53.69,Default,,0,0,0,,...
Dialogue: 0,1:46:54.44,1:46:55.74,Default,,0,0,0,,Үйде
Dialogue: 0,1:46:55.82,1:46:59.12,Default,,0,0,0,,Студент болған адамнан...
Dialogue: 0,1:47:00.08,1:47:03.75,Default,,0,0,0,,Алғашқы махаббатымды от теңізінен құтқардым.
Dialogue: 0,1:47:03.83,1:47:06.00,Default,,0,0,0,,Ер адам менен сұрады
Dialogue: 0,1:47:06.92,1:47:10.04,Default,,0,0,0,,Сіз дос қызыңызға Ашиядағы ``күнбағысты'' көрсеткіңіз келеді.
Dialogue: 0,1:47:10.13,1:47:11.29,Default,,0,0,0,,Ах...
Dialogue: 0,1:47:11.80,1:47:12.80,Default,,0,0,0,,Иә
Dialogue: 0,1:47:12.88,1:47:16.30,Default,,0,0,0,,Түсіндім... енді барлық жұмбақтар шешілді.
Dialogue: 0,1:47:16.38,1:47:19.26,Default,,0,0,0,,Жарайды ма? Мен оны ұстамадым
Dialogue: 0,1:47:19.34,1:47:21.22,Default,,0,0,0,,Мен оны дәл осы жолы сағынамын
Dialogue: 0,1:47:21.30,1:47:22.39,Default,,0,0,0,,Иә
Dialogue: 0,1:47:22.47,1:47:25.77,Default,,0,0,0,,Мені ұстап алатын доптарың жоқ па?
Dialogue: 0,1:47:25.85,1:47:28.60,Default,,0,0,0,,Сол мұңды махаббатты бағала
Dialogue: 0,1:47:28.69,1:47:31.52,Default,,0,0,0,,Сізден сұраған адамға ашуланып
Dialogue: 0,1:47:31.61,1:47:34.15,Default,,0,0,0,,Оны жіберіп алған сыңай танытыңыз.
Dialogue: 0,1:47:34.65,1:47:36.86,Default,,0,0,0,,Мен сізді дұрыс түсінбедім.
Dialogue: 0,1:47:36.95,1:47:37.82,Default,,0,0,0,,инспектор Чарли
Dialogue: 0,1:47:39.16,1:47:40.28,Default,,0,0,0,,Өзара
Dialogue: 0,1:47:41.20,1:47:43.62,Default,,0,0,0,,♪～
Dialogue: 0,1:47:43.62,1:47:44.79,Default,,0,0,0,,♪～
Dialogue: 0,1:47:43.62,1:47:44.79,Default,,0,0,0,,Хмм…
Dialogue: 0,1:47:44.79,1:47:46.20,Default,,0,0,0,,♪～
Dialogue: 0,1:51:42.02,1:51:47.03,Default,,0,0,0,,～♪
Dialogue: 0,1:51:47.11,1:51:49.53,Default,,0,0,0,,Жоқ Жоқ Жоқ!
Dialogue: 0,1:51:49.61,1:51:51.78,Default,,0,0,0,,Қайда? Қайда кетті?
Dialogue: 0,1:51:52.37,1:51:54.20,Default,,0,0,0,,Бұл менің соншалықты көп ізденбегенімді білдірмейді.
Dialogue: 0,1:51:54.29,1:51:57.12,Default,,0,0,0,,Оны біреу ұрлап кеткен болуы керек!
Dialogue: 0,1:51:57.21,1:51:58.42,Default,,0,0,0,,Бұл кім?
Dialogue: 0,1:51:58.50,1:52:00.63,Default,,0,0,0,,Менің билетімді кім ұрлады?
Dialogue: 0,1:52:00.71,1:52:03.88,Default,,0,0,0,,Оның жойылғанын айта аласыз ба?
Dialogue: 0,1:52:03.96,1:52:06.34,Default,,0,0,0,,Жаңалықты көру арқылы білуге ​​болады.
Dialogue: 0,1:52:06.42,1:52:08.59,Default,,0,0,0,,Бұл не? Бұл дұрыс емес.
Dialogue: 0,1:52:08.68,1:52:11.47,Default,,0,0,0,,Саған қарасам, өкінетін сияқтымын
Dialogue: 0,1:52:11.55,1:52:13.05,Default,,0,0,0,,А? Бұл не...
Dialogue: 0,1:52:13.72,1:52:15.89,Default,,0,0,0,,Мен біреуден кеңес алдым.
Dialogue: 0,1:52:15.97,1:52:18.60,Default,,0,0,0,,Кішкене болса да бетіңді көрсетші.
Dialogue: 0,1:52:18.69,1:52:21.06,Default,,0,0,0,,...
Dialogue: 0,1:52:22.56,1:52:28.56,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory