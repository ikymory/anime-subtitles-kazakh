Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.34,0:00:09.50,Default,,0,0,0,,Баршаңызға қайырлы күн Рома!
Dialogue: 0,0:00:09.59,0:00:11.30,Default,,0,0,0,,Қайырлы күн!
Dialogue: 0,0:00:11.72,0:00:14.47,Default,,0,0,0,,Бүгін біз «GO! Princess Прекюр» фильмі туралы сөйлесеміз.
Dialogue: 0,0:00:14.55,0:00:16.01,Default,,0,0,0,,Үш бөлімнен тұратын романс!
Dialogue: 0,0:00:16.09,0:00:19.72,Default,,0,0,0,,Біріншіден, өте сүйкімді Прекюр Roma!
Dialogue: 0,0:00:19.81,0:00:22.39,Default,,0,0,0,,үшін ғажайып ханшайым Жарық
Dialogue: 0,0:00:22.48,0:00:24.39,Default,,0,0,0,,Сіз көп шайқағыңыз келетін пуф
Dialogue: 0,0:00:24.48,0:00:25.56,Default,,0,0,0,,Романы ақырын шайқау
Dialogue: 0,0:00:26.40,0:00:29.65,Default,,0,0,0,,Олай болса, басы, басы, Романс~
Dialogue: 0,0:00:35.24,0:00:41.24,Default,,0,0,0,,♪～
Dialogue: 0,0:05:38.37,0:05:44.38,Default,,0,0,0,,～♪
Dialogue: 0,0:05:45.21,0:05:47.34,Default,,0,0,0,,Сүйкімді пуф~
Dialogue: 0,0:05:47.80,0:05:49.80,Default,,0,0,0,,Келесі - Асқабақ патшалығы.
Dialogue: 0,0:05:49.89,0:05:53.14,Default,,0,0,0,,Ханшайымдар байқауына қатысу туралы әңгіме!
Dialogue: 0,0:05:53.22,0:05:54.89,Default,,0,0,0,,Романтикалық пуф~
Dialogue: 0,0:05:54.97,0:05:57.35,Default,,0,0,0,,Бірақ Ромада да жаман адамдар пайда болады
Dialogue: 0,0:05:57.98,0:06:02.27,Default,,0,0,0,,Мұндай жағдайда Прекюр-ді қолдау үшін осы шамды пайдаланыңыз!
Dialogue: 0,0:06:02.77,0:06:06.69,Default,,0,0,0,,Содан кейін Пафф шытырман оқиғалы саяхатқа шығады~
Dialogue: 0,0:06:09.95,0:06:11.62,Default,,0,0,0,,Асқабақ кафесі?
Dialogue: 0,0:06:11.95,0:06:14.91,Default,,0,0,0,,Асқабақ жеп отырып шәй ішесіз бе?
Dialogue: 0,0:06:14.99,0:06:16.25,Default,,0,0,0,,Товакчи~
Dialogue: 0,0:06:16.33,0:06:18.46,Default,,0,0,0,,Асқабақ пудингі – мамандық.
Dialogue: 0,0:06:18.54,0:06:20.33,Default,,0,0,0,,пончиктерді асыға күтеміз~
Dialogue: 0,0:06:20.83,0:06:22.50,Default,,0,0,0,,Пудинг Соккиноке Рома...
Dialogue: 0,0:06:22.59,0:06:24.96,Default,,0,0,0,,Тәттілерді бәрі жақсы көреді
Dialogue: 0,0:06:25.05,0:06:26.30,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:06:26.71,0:06:27.92,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:28.01,0:06:30.05,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:06:30.47,0:06:36.47,Default,,0,0,0,,♪～
Dialogue: 0,0:08:02.94,0:08:08.94,Default,,0,0,0,,～♪
Dialogue: 0,0:08:09.19,0:08:11.19,Default,,0,0,0,,Бірақ мектепке кешігіп қаламын, сондықтан соқпай кету дұрыс емес сияқты…
Dialogue: 0,0:08:11.28,0:08:14.49,Default,,0,0,0,,Хаа... Уау!
Dialogue: 0,0:08:14.78,0:08:16.41,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:08:16.49,0:08:18.33,Default,,0,0,0,,Күтуге тұрарлық болды.
Dialogue: 0,0:08:18.70,0:08:20.95,Default,,0,0,0,,Кешіріңіз, мен бірінші тамақтандым.
Dialogue: 0,0:08:21.62,0:08:23.96,Default,,0,0,0,,...
Dialogue: 0,0:08:24.42,0:08:26.33,Default,,0,0,0,,Бұл жерде!
Dialogue: 0,0:08:28.54,0:08:31.76,Default,,0,0,0,,Хм... Хмф хехехехе
Dialogue: 0,0:08:32.47,0:08:35.22,Default,,0,0,0,,Жоқ... бұл не? Бұл сезім
Dialogue: 0,0:08:35.55,0:08:37.26,Default,,0,0,0,,Харука-чан, не болды?
Dialogue: 0,0:08:37.35,0:08:38.80,Default,,0,0,0,,Е... иә!
Dialogue: 0,0:08:38.89,0:08:41.18,Default,,0,0,0,,Дәмді! Эй, эй
Dialogue: 0,0:08:41.56,0:08:43.52,Default,,0,0,0,,Өкінішті рома!
Dialogue: 0,0:08:43.60,0:08:46.10,Default,,0,0,0,,Ханшайым басқалардың тәттілеріне қалай қызғанады?
Dialogue: 0,0:08:46.19,0:08:47.19,Default,,0,0,0,,Бейшара рома!
Dialogue: 0,0:08:48.40,0:08:50.23,Default,,0,0,0,,Тамақ бергеніңіз үшін рахмет!
Dialogue: 0,0:08:50.36,0:08:51.19,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:08:51.65,0:08:54.49,Default,,0,0,0,,Бұл тойымсыз Рома ханшайымы!
Dialogue: 0,0:08:54.61,0:08:56.91,Default,,0,0,0,,Хехе, бұл жаңалық.
Dialogue: 0,0:08:56.99,0:08:59.28,Default,,0,0,0,,Ашкөз болғаны дұрыс!
Dialogue: 0,0:09:04.37,0:09:06.79,Default,,0,0,0,,Рома... Ханшайымдардың турнирі?
Dialogue: 0,0:09:06.87,0:09:08.17,Default,,0,0,0,,Рома бұған қатысады!
Dialogue: 0,0:09:08.58,0:09:09.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:10.46,0:09:12.05,Default,,0,0,0,,«Асқабақ патшалығында»
Dialogue: 0,0:09:12.13,0:09:16.26,Default,,0,0,0,,«Нағыз ханшайымды таңдау үшін сайыс өтеді»?
Dialogue: 0,0:09:16.43,0:09:19.72,Default,,0,0,0,,Осы уақытқа дейін өткен сабақтардың нәтижелерін тексеруге жақсы мүмкіндік
Dialogue: 0,0:09:20.14,0:09:23.27,Default,,0,0,0,,Ханшайымдардың турнирі? Көңілді сияқты!
Dialogue: 0,0:09:23.64,0:09:25.06,Default,,0,0,0,,Асқабақ...?
Dialogue: 0,0:09:25.43,0:09:27.98,Default,,0,0,0,,Мен оны Noble Хэллоуин кеші үшін пайдалана аламын ба?
Dialogue: 0,0:09:28.27,0:09:29.94,Default,,0,0,0,,Хэллоуин кеші?
Dialogue: 0,0:09:30.02,0:09:31.44,Default,,0,0,0,,Бұл мектептегі оқиға.
Dialogue: 0,0:09:31.69,0:09:32.94,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:33.03,0:09:36.74,Default,,0,0,0,,Ах... Бұл флайер қашаннан бері осында?
Dialogue: 0,0:09:40.32,0:09:42.37,Default,,0,0,0,,Харука-чан, сен шынымен де екінші көмек алдың ба?
Dialogue: 0,0:09:42.45,0:09:43.83,Default,,0,0,0,,Не? Мен оны сұраған жоқпын
Dialogue: 0,0:09:46.87,0:09:48.79,Default,,0,0,0,,Zetsuborg!
Dialogue: 0,0:09:49.21,0:09:50.04,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:09:50.42,0:09:52.13,Default,,0,0,0,,Юй-чан, барлығын өтінемін!
Dialogue: 0,0:09:52.21,0:09:53.05,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:09:53.67,0:09:55.42,Default,,0,0,0,,үшін, міне, осы.
Dialogue: 0,0:09:58.97,0:10:00.26,Default,,0,0,0,,Прекюр
Dialogue: 0,0:10:01.35,0:10:02.89,Default,,0,0,0,,Ханшайымның қатысуы!
Dialogue: 0,0:10:21.28,0:10:24.62,Default,,0,0,0,,Жайнаған гүл ханшайымы
Dialogue: 0,0:10:27.00,0:10:28.71,Default,,0,0,0,,Флораны емдеңіз!
Dialogue: 0,0:10:30.50,0:10:34.38,Default,,0,0,0,,Мөлдір теңіз ханшайымы
Dialogue: 0,0:10:37.21,0:10:38.92,Default,,0,0,0,,Су перісін емдеңіз!
Dialogue: 0,0:10:42.68,0:10:44.81,Default,,0,0,0,,Жарқыраған жұлдыз ханшайымы
Dialogue: 0,0:10:47.64,0:10:49.23,Default,,0,0,0,,Жарқылды емдеңіз!
Dialogue: 0,0:10:52.23,0:10:54.48,Default,,0,0,0,,Қып-қызыл жалын ханшайымы
Dialogue: 0,0:10:58.24,0:10:59.95,Default,,0,0,0,,Скарлетті емдеңіз!
Dialogue: 0,0:11:02.28,0:11:04.41,Default,,0,0,0,,Қатты (су перісі) ақырын
Dialogue: 0,0:11:04.49,0:11:06.87,Default,,0,0,0,,Әдемі (Скарлет) GO!
Dialogue: 0,0:11:07.58,0:11:09.37,Default,,0,0,0,,...
Dialogue: 0,0:11:12.46,0:11:13.92,Default,,0,0,0,,Zetsuborg!
Dialogue: 0,0:11:14.38,0:11:17.42,Default,,0,0,0,,Цетсу! Борг! Zetsuborg!
Dialogue: 0,0:11:18.71,0:11:22.05,Default,,0,0,0,,...
Dialogue: 0,0:11:22.13,0:11:23.14,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:23.72,0:11:25.68,Default,,0,0,0,,Жарқыра! (Су перісі) Скарлет!
Dialogue: 0,0:11:26.14,0:11:27.01,Default,,0,0,0,,Лилия
Dialogue: 0,0:11:28.27,0:11:31.06,Default,,0,0,0,,...
Dialogue: 0,0:11:33.44,0:11:35.40,Default,,0,0,0,,Цетсу! (Флора) Иә!
Dialogue: 0,0:11:35.65,0:11:36.48,Default,,0,0,0,,Көпіршік
Dialogue: 0,0:11:37.57,0:11:40.32,Default,,0,0,0,,Алдын ала жасалған көпіршік толқыны!
Dialogue: 0,0:11:42.82,0:11:44.03,Default,,0,0,0,,Zetsu!
Dialogue: 0,0:11:44.49,0:11:45.32,Default,,0,0,0,,Иә...
Dialogue: 0,0:11:46.33,0:11:47.66,Default,,0,0,0,,Ха! (Флора) Иә!
Dialogue: 0,0:11:49.83,0:11:51.33,Default,,0,0,0,,Хмм... Иә!
Dialogue: 0,0:11:54.17,0:11:55.08,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:56.42,0:11:58.71,Default,,0,0,0,,Цетсу! (2 адам) Кя~
Dialogue: 0,0:11:59.38,0:12:01.09,Default,,0,0,0,,Флора! (Қызыл) Су перісі!
Dialogue: 0,0:12:01.76,0:12:02.59,Default,,0,0,0,,Уф
Dialogue: 0,0:12:02.72,0:12:03.59,Default,,0,0,0,,Отшашу
Dialogue: 0,0:12:04.80,0:12:07.72,Default,,0,0,0,,Алдын ала тазартылған Scarlet Spark!
Dialogue: 0,0:12:08.39,0:12:10.72,Default,,0,0,0,,Цетсу! Уф?
Dialogue: 0,0:12:12.31,0:12:13.60,Default,,0,0,0,,Алмасу
Dialogue: 0,0:12:16.52,0:12:18.15,Default,,0,0,0,,Режим талғампаз!
Dialogue: 0,0:12:23.78,0:12:25.45,Default,,0,0,0,,Жарқыраған жұлдыздар
Dialogue: 0,0:12:27.03,0:12:29.66,Default,,0,0,0,,...
Dialogue: 0,0:12:29.95,0:12:30.87,Default,,0,0,0,,Гумминг!
Dialogue: 0,0:12:35.92,0:12:38.34,Default,,0,0,0,,Армандау...
Dialogue: 0,0:12:44.38,0:12:45.76,Default,,0,0,0,,Біз ең әлсіз болғандықтан, сол күшті түсінетіндер бар.
Dialogue: 0,0:12:47.85,0:12:51.47,Default,,0,0,0,,Хм... Бұл Принцесса Прекюр ме?
Dialogue: 0,0:12:53.89,0:12:54.94,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:55.06,0:12:55.90,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:58.69,0:12:59.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:59.77,0:13:01.65,Default,,0,0,0,,Хмф (барлығы) Ха... Уау!
Dialogue: 0,0:13:08.45,0:13:11.33,Default,,0,0,0,,Ой... бәрі қайда? Ах...
Dialogue: 0,0:13:12.20,0:13:13.62,Default,,0,0,0,,Жоғалу...
Dialogue: 0,0:13:14.91,0:13:16.04,Default,,0,0,0,,Хаа…
Dialogue: 0,0:13:17.00,0:13:20.54,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:13:23.59,0:13:26.05,Default,,0,0,0,,Itatata... Бұл қайда?
Dialogue: 0,0:13:26.38,0:13:27.93,Default,,0,0,0,,Асқабақ алаңы?
Dialogue: 0,0:13:36.85,0:13:37.98,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:13:38.40,0:13:40.77,Default,,0,0,0,,үшін? Апыр-ай!
Dialogue: 0,0:13:40.86,0:13:41.86,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:13:41.94,0:13:43.07,Default,,0,0,0,,Міне, алғашқы отбасыңды мүлде ұмытып қалғансың➡
Dialogue: 0,0:13:43.86,0:13:45.07,Default,,0,0,0,,Шағын асқабақ?
Dialogue: 0,0:13:45.15,0:13:47.57,Default,,0,0,0,,Бірақ ол жұмыс істейді, жақсы...
Dialogue: 0,0:13:47.66,0:13:50.16,Default,,0,0,0,,(Пан Пуу Киннің күрсінуі)
Dialogue: 0,0:13:50.53,0:13:52.41,Default,,0,0,0,,Сонымен... өте сүйкімді~
Dialogue: 0,0:13:52.49,0:13:55.50,Default,,0,0,0,,Бұл асқабақ... Фея бөртпесі
Dialogue: 0,0:13:55.58,0:13:56.46,Default,,0,0,0,,Я~
Dialogue: 0,0:13:57.33,0:13:58.17,Default,,0,0,0,,Нан!
Dialogue: 0,0:13:58.25,0:13:59.71,Default,,0,0,0,,Поо! Туысқан!
Dialogue: 0,0:14:00.21,0:14:02.04,Default,,0,0,0,,Пан Пу Кин?
Dialogue: 0,0:14:02.42,0:14:03.96,Default,,0,0,0,,Пан Пу Кин?
Dialogue: 0,0:14:04.67,0:14:06.38,Default,,0,0,0,,Мүмкін бұл...
Dialogue: 0,0:14:06.47,0:14:07.97,Default,,0,0,0,,Асқабақ патшалығы?
Dialogue: 0,0:14:10.14,0:14:11.68,Default,,0,0,0,,Керемет!
Dialogue: 0,0:14:12.35,0:14:14.97,Default,,0,0,0,,Біз келдік!
Dialogue: 0,0:14:36.12,0:14:39.67,Default,,0,0,0,,Уау, өте керемет! Тым жақсы~
Dialogue: 0,0:14:40.25,0:14:42.33,Default,,0,0,0,,Маған жол көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:14:42.63,0:14:49.63,Default,,0,0,0,,(апелляциялық шағым)
Dialogue: 0,0:14:51.43,0:14:54.43,Default,,0,0,0,,Ах~ Кешіріңіз, мен сөздерді түсінбеймін.
Dialogue: 0,0:14:54.56,0:14:56.14,Default,,0,0,0,,(Жоқтау дауысы)
Dialogue: 0,0:14:56.68,0:14:57.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:58.27,0:15:00.85,Default,,0,0,0,,Бұл бұрынғы парфейдің иісі ме?
Dialogue: 0,0:15:01.48,0:15:02.81,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:15:03.15,0:15:04.36,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:15:04.77,0:15:07.82,Default,,0,0,0,,Асқабақ патшалығына қош келдіңіздер
Dialogue: 0,0:15:08.40,0:15:11.91,Default,,0,0,0,,Мен осы елдің министрімін.
Dialogue: 0,0:15:12.07,0:15:13.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:14.33,0:15:16.70,Default,,0,0,0,,Сіз ойлағандай, ана жақтағы жас ханым.
Dialogue: 0,0:15:17.16,0:15:20.66,Default,,0,0,0,,Сол дүкендегі асқабақ пудингі елімізде танымал өнім.
Dialogue: 0,0:15:20.79,0:15:21.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:21.83,0:15:23.13,Default,,0,0,0,,Ммм... Хемф
Dialogue: 0,0:15:23.75,0:15:26.50,Default,,0,0,0,,Жоқ... бұл не? Бұл сезім
Dialogue: 0,0:15:27.09,0:15:27.92,Default,,0,0,0,,Иә...
Dialogue: 0,0:15:32.93,0:15:34.97,Default,,0,0,0,,Король патшайым
Dialogue: 0,0:15:35.55,0:15:39.68,Default,,0,0,0,,Бұл ертерек келген ханшайым үміткерлері.
Dialogue: 0,0:15:49.36,0:15:51.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:03.92,0:16:05.17,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:16:06.09,0:16:10.46,Default,,0,0,0,,Иә...? Сіздің атыңыз кім?
Dialogue: 0,0:16:10.55,0:16:12.17,Default,,0,0,0,,Уа... мен!
Dialogue: 0,0:16:12.68,0:16:15.01,Default,,0,0,0,,Харуно Харука дегоджамасу!
Dialogue: 0,0:16:15.09,0:16:16.18,Default,,0,0,0,,Хаха…
Dialogue: 0,0:16:19.97,0:16:21.31,Default,,0,0,0,,Харуно…
Dialogue: 0,0:16:21.93,0:16:23.02,Default,,0,0,0,,Көктем…
Dialogue: 0,0:16:23.56,0:16:27.61,Default,,0,0,0,,Мен бар күшімді салып, ұлы ханшайым болғым келеді.
Dialogue: 0,0:16:28.15,0:16:29.44,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:16:32.24,0:16:35.28,Default,,0,0,0,,Мен ұлы ханшайым боламын
Dialogue: 0,0:16:35.53,0:16:38.16,Default,,0,0,0,,(перілердің қуанышы)
Dialogue: 0,0:16:42.96,0:16:46.08,Default,,0,0,0,,Ханшайым... менің...
Dialogue: 0,0:16:51.13,0:16:53.51,Default,,0,0,0,,Ха... Бұл сату туралы көбірек.
Dialogue: 0,0:16:53.59,0:16:56.01,Default,,0,0,0,,Біз пудинг сатуды көбейтуіміз керек!
Dialogue: 0,0:16:56.22,0:16:58.76,Default,,0,0,0,,Барған сайын көбірек қазына жинаңыз!
Dialogue: 0,0:16:59.05,0:17:00.18,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:17:03.93,0:17:05.31,Default,,0,0,0,,О! (Ханшайым) Жарайды~!
Dialogue: 0,0:17:05.39,0:17:06.98,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:17:07.60,0:17:11.03,Default,,0,0,0,,Толығырақ! Сатуды одан да арттырыңыз ...
Dialogue: 0,0:17:11.11,0:17:13.19,Default,,0,0,0,,Қазына жина
Dialogue: 0,0:17:13.36,0:17:15.57,Default,,0,0,0,,Барған сайын көбірек сатылымдар...
Dialogue: 0,0:17:15.65,0:17:17.16,Default,,0,0,0,,Барған сайын көп қазына...
Dialogue: 0,0:17:17.53,0:17:19.41,Default,,0,0,0,,Мына министр!
Dialogue: 0,0:17:19.49,0:17:21.54,Default,,0,0,0,,Бұл елде бір ханшайым бар...
Dialogue: 0,0:17:21.62,0:17:23.62,Default,,0,0,0,,Ханшайым бар емес пе?
Dialogue: 0,0:17:24.37,0:17:27.00,Default,,0,0,0,,Өкінішке орай, жоқ.
Dialogue: 0,0:17:27.12,0:17:28.13,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:17:28.67,0:17:31.88,Default,,0,0,0,,Сондықтан ханшайымды сайыста таңдайды.
Dialogue: 0,0:17:32.34,0:17:33.46,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:17:33.96,0:17:38.14,Default,,0,0,0,,Енді алдын ала турға сайысты таңдауды сұраудан бастайық.
Dialogue: 0,0:17:38.22,0:17:39.43,Default,,0,0,0,,Алдын ала жиналыс?
Dialogue: 0,0:17:39.89,0:17:40.76,Default,,0,0,0,,Иә
Dialogue: 0,0:17:40.93,0:17:44.89,Default,,0,0,0,,Әрбір алдын ала раундта бірінші орын алғандар ғана финалдық турға өтеді...
Dialogue: 0,0:17:45.10,0:17:47.81,Default,,0,0,0,,Басқаша айтқанда, біз ханшайымдар сайысына шығамыз.
Dialogue: 0,0:17:48.35,0:17:49.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:49.98,0:17:51.61,Default,,0,0,0,,Жарыстың 4 түрі бар
Dialogue: 0,0:17:52.11,0:17:54.07,Default,,0,0,0,,Бимен серуендеу
Dialogue: 0,0:17:54.15,0:17:56.53,Default,,0,0,0,,Музыкалық аспаздық
Dialogue: 0,0:18:01.74,0:18:04.29,Default,,0,0,0,,Енді мына адамдарды дайында.
Dialogue: 0,0:18:04.95,0:18:07.50,Default,,0,0,0,,Біз сізді өтетін жерде күтеміз.
Dialogue: 0,0:18:13.34,0:18:14.21,Default,,0,0,0,,Біз ең әлсіз болғандықтан, сол күшті түсінетіндер бар.
Dialogue: 0,0:18:16.47,0:18:19.22,Default,,0,0,0,,Иә? Мен өзімді жақсы сезініп тұрған жоқпын.
Dialogue: 0,0:18:19.30,0:18:20.18,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:18:20.43,0:18:24.52,Default,,0,0,0,,Уау! Ахаха! Ухухуху
Dialogue: 0,0:18:32.90,0:18:36.36,Default,,0,0,0,,Пан Пу Кин! Нан...
Dialogue: 0,0:19:04.14,0:19:05.51,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:19:05.93,0:19:07.56,Default,,0,0,0,,(Панның дауысы)
Dialogue: 0,0:19:07.64,0:19:10.35,Default,,0,0,0,,Иә, ханшайымды таңда...
Dialogue: 0,0:19:10.48,0:19:12.19,Default,,0,0,0,,(Пудың сөйлейтін дауысы)
Dialogue: 0,0:19:12.35,0:19:15.69,Default,,0,0,0,,Сен де мені мүлде ұмыттың.
Dialogue: 0,0:19:24.58,0:19:27.74,Default,,0,0,0,,Әкесі… Анасы…
Dialogue: 0,0:19:29.12,0:19:31.12,Default,,0,0,0,,(мұңды дауыс)
Dialogue: 0,0:19:32.04,0:19:34.38,Default,,0,0,0,,Ахаха, бұл қызық!
Dialogue: 0,0:19:36.71,0:19:39.72,Default,,0,0,0,,А... сіз өлшемді өлшеп жатырсыз, солай ма?
Dialogue: 0,0:19:44.22,0:19:45.97,Default,,0,0,0,,Иә, бұл жақсы!
Dialogue: 0,0:19:48.52,0:19:52.56,Default,,0,0,0,,Күрсініп... Бұл өте маңызды.
Dialogue: 0,0:19:57.86,0:19:59.28,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:20:00.78,0:20:03.78,Default,,0,0,0,,Күткендей... бірдеңе болып жатқан сияқты.
Dialogue: 0,0:20:04.11,0:20:06.24,Default,,0,0,0,,Мен ханшайымды көрдім. Апыр-ай!
Dialogue: 0,0:20:06.95,0:20:08.58,Default,,0,0,0,,Қандай сүйкімді бөлме.
Dialogue: 0,0:20:09.24,0:20:10.08,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:20:10.41,0:20:11.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:13.21,0:20:14.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:19.67,0:20:20.92,Default,,0,0,0,,Сен дәл қазір не үшін кешірім сұрап тұрсың?
Dialogue: 0,0:20:21.47,0:20:24.34,Default,,0,0,0,,Тіпті кішкентай қыз бар ма?
Dialogue: 0,0:20:24.55,0:20:25.39,Default,,0,0,0,,(таңданған дауыс)
Dialogue: 0,0:20:26.05,0:20:28.14,Default,,0,0,0,,Рома ханшайым жоқ деді.
Dialogue: 0,0:20:28.22,0:20:31.14,Default,,0,0,0,,Бірақ мұны сіздің анаңыз қолдан жасаған болуы керек.
Dialogue: 0,0:20:31.56,0:20:32.85,Default,,0,0,0,,Пампл Лу…
Dialogue: 0,0:20:33.19,0:20:34.23,Default,,0,0,0,,Памплу?
Dialogue: 0,0:20:34.56,0:20:35.44,Default,,0,0,0,,(таңданған дауыс)
Dialogue: 0,0:20:35.98,0:20:37.69,Default,,0,0,0,,Pamplelu дегеніміз не?
Dialogue: 0,0:20:38.44,0:20:44.07,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:20:58.92,0:21:02.26,Default,,0,0,0,,Неліктен мен жалғыз осылай киінемін...
Dialogue: 0,0:21:02.88,0:21:04.97,Default,,0,0,0,,Өте сүйкімді пуф
Dialogue: 0,0:21:05.05,0:21:06.39,Default,,0,0,0,,Рахмет
Dialogue: 0,0:21:07.30,0:21:10.39,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:21:11.18,0:21:12.89,Default,,0,0,0,,Керемет!
Dialogue: 0,0:21:13.23,0:21:16.35,Default,,0,0,0,,Ханшайым үміткерлеріне толы пуф
Dialogue: 0,0:21:16.90,0:21:18.56,Default,,0,0,0,,үшінмыз мұны істейік.
Dialogue: 0,0:21:18.94,0:21:19.98,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:21:21.15,0:21:23.11,Default,,0,0,0,,Това-чан, не болды?
Dialogue: 0,0:21:23.44,0:21:25.11,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:21:26.91,0:21:29.16,Default,,0,0,0,,Барымызды салайық! (үшін) О!
Dialogue: 0,0:21:33.58,0:21:35.04,Default,,0,0,0,,Мазасыз ба?
Dialogue: 0,0:21:35.29,0:21:38.08,Default,,0,0,0,,Бірдеңе дұрыс емес, иә...
Dialogue: 0,0:21:38.54,0:21:41.04,Default,,0,0,0,,бірінші оқиға - би.
Dialogue: 0,0:21:41.17,0:21:43.46,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:44.38,0:21:48.30,Default,,0,0,0,,(Классикалық музыка)
Dialogue: 0,0:22:10.03,0:22:11.91,Default,,0,0,0,,Уау~
Dialogue: 0,0:22:28.34,0:22:30.05,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:22:30.72,0:22:33.97,Default,,0,0,0,,1-ші биде 1-орын...
Dialogue: 0,0:22:34.68,0:22:36.31,Default,,0,0,0,,Минами ханшайым!
Dialogue: 0,0:22:37.06,0:22:38.14,Default,,0,0,0,,Иә!
Dialogue: 0,0:22:38.69,0:22:41.73,Default,,0,0,0,,Минами ханшайым, күту бөлмесіне барыңыз.
Dialogue: 0,0:22:52.45,0:22:55.20,Default,,0,0,0,,Екінші оқиға – жаяу жүру.
Dialogue: 0,0:22:55.33,0:22:58.71,Default,,0,0,0,,(жоғары ырғақты музыка)
Dialogue: 0,0:23:08.30,0:23:10.34,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:23:11.01,0:23:12.97,Default,,0,0,0,,Кирара-чан өте керемет!
Dialogue: 0,0:23:17.43,0:23:19.60,Default,,0,0,0,,Иә? Не болды?
Dialogue: 0,0:23:20.10,0:23:23.06,Default,,0,0,0,,Перілерде біртүрлі нәрсе бар.
Dialogue: 0,0:23:23.61,0:23:24.82,Default,,0,0,0,,Мен қараймын.
Dialogue: 0,0:23:25.40,0:23:27.11,Default,,0,0,0,,Барма! А...?
Dialogue: 0,0:23:27.86,0:23:30.78,Default,,0,0,0,,Мен... қараңғылықтың күшін сеземін.
Dialogue: 0,0:23:31.20,0:23:33.16,Default,,0,0,0,,Иә! Қараңғылық күші?
Dialogue: 0,0:23:33.24,0:23:35.24,Default,,0,0,0,,Тыныш! Қайда... қайда?
Dialogue: 0,0:23:35.33,0:23:38.12,Default,,0,0,0,,Мен әлі нақты білмеймін...
Dialogue: 0,0:23:38.20,0:23:40.21,Default,,0,0,0,,Сосын мен одан бетер уайымдаймын.
Dialogue: 0,0:23:40.29,0:23:41.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:41.50,0:23:45.04,Default,,0,0,0,,Өйткені бұл перілер қауіпті болуы мүмкін.
Dialogue: 0,0:23:46.88,0:23:49.76,Default,,0,0,0,,Това-сама, Харука мен қорғайтын рома!
Dialogue: 0,0:23:49.84,0:23:51.34,Default,,0,0,0,,Пікір де илеу~
Dialogue: 0,0:23:56.60,0:23:57.89,Default,,0,0,0,,Абайлаңыз...
Dialogue: 0,0:23:58.89,0:24:01.64,Default,,0,0,0,,2-ші іс-шарада 1-орын – бұл...
Dialogue: 0,0:24:02.69,0:24:04.23,Default,,0,0,0,,Кирара ханшайым!
Dialogue: 0,0:24:04.65,0:24:08.23,Default,,0,0,0,,(қол шапалақтау және күлу)
Dialogue: 0,0:24:08.82,0:24:14.32,Default,,0,0,0,,Пан Пу Кин! Нан...
Dialogue: 0,0:24:15.28,0:24:16.12,Default,,0,0,0,,Пуха~
Dialogue: 0,0:24:16.20,0:24:17.99,Default,,0,0,0,,Пуф ~ Рома ~
Dialogue: 0,0:24:18.20,0:24:21.37,Default,,0,0,0,,(сөйлеу)
Dialogue: 0,0:24:22.12,0:24:23.29,Default,,0,0,0,,Нан Пу...
Dialogue: 0,0:24:23.75,0:24:26.63,Default,,0,0,0,,Қайда бара жатырсың Пафф? Рома туралы бірдеңе...
Dialogue: 0,0:24:26.71,0:24:27.59,Default,,0,0,0,,Мен сізге еремін
Dialogue: 0,0:24:27.79,0:24:28.63,Default,,0,0,0,,Хару
Dialogue: 0,0:24:28.71,0:24:29.84,Default,,0,0,0,,Паф Рома
Dialogue: 0,0:24:29.92,0:24:30.76,Default,,0,0,0,,Хару
Dialogue: 0,0:24:30.84,0:24:32.17,Default,,0,0,0,,Паф Рома
Dialogue: 0,0:24:32.34,0:24:33.18,Default,,0,0,0,,Хару
Dialogue: 0,0:24:33.26,0:24:34.51,Default,,0,0,0,,Паф Рома
Dialogue: 0,0:24:37.10,0:24:39.18,Default,,0,0,0,,Пан Пу Кин!
Dialogue: 0,0:24:39.68,0:24:41.68,Default,,0,0,0,,Саңылау арқылы кірген пуф
Dialogue: 0,0:24:41.89,0:24:43.44,Default,,0,0,0,,Мен өте алатын Рома!
Dialogue: 0,0:24:43.64,0:24:44.69,Default,,0,0,0,,Мүмкін емес Рома~!
Dialogue: 0,0:24:44.77,0:24:47.23,Default,,0,0,0,,Қайта алмайтын романс! Уау, аға!
Dialogue: 0,0:24:47.31,0:24:48.82,Default,,0,0,0,,Уф... Уау!
Dialogue: 0,0:24:50.69,0:24:53.95,Default,,0,0,0,,Уау~ Мен таң қалдым...
Dialogue: 0,0:24:55.53,0:24:58.62,Default,,0,0,0,,Онда не бар?
Dialogue: 0,0:24:59.03,0:25:01.87,Default,,0,0,0,,Ұша алатын паф, қолы бар рома
Dialogue: 0,0:25:02.37,0:25:04.37,Default,,0,0,0,,Қатпар қағып кетті~
Dialogue: 0,0:25:04.46,0:25:06.00,Default,,0,0,0,,Рома мені ұстап алды!
Dialogue: 0,0:25:06.21,0:25:08.17,Default,,0,0,0,,Ақылға қонымсыз қаңылтыр~! Мүмкін емес романтика!
Dialogue: 0,0:25:08.88,0:25:11.13,Default,,0,0,0,,Екеуміз бардық...
Dialogue: 0,0:25:11.30,0:25:12.59,Default,,0,0,0,,Мен келемін, Пафф! Мен келемін, Рома!
Dialogue: 0,0:25:13.26,0:25:14.97,Default,,0,0,0,,Паф келді! Рома келді!
Dialogue: 0,0:25:16.47,0:25:19.01,Default,,0,0,0,,Уау, сүйкімді пуф~
Dialogue: 0,0:25:19.85,0:25:23.93,Default,,0,0,0,,Рома қатты! Уау, уау...
Dialogue: 0,0:25:24.56,0:25:26.39,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:25:26.52,0:25:30.52,Default,,0,0,0,,Хо... Үміт патшалығының корольдік ертегісінің хош иісі Рома
Dialogue: 0,0:25:30.77,0:25:32.94,Default,,0,0,0,,Бұл менің әпкем Пахлома.
Dialogue: 0,0:25:33.03,0:25:34.65,Default,,0,0,0,,Қайырлы күн
Dialogue: 0,0:25:35.40,0:25:38.37,Default,,0,0,0,,Қайырлы күн, мен Памплелумын
Dialogue: 0,0:25:38.78,0:25:39.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:40.20,0:25:41.66,Default,,0,0,0,,Пампл Лу…
Dialogue: 0,0:25:42.08,0:25:43.87,Default,,0,0,0,,Пері айтқан Рома
Dialogue: 0,0:25:44.04,0:25:44.91,Default,,0,0,0,,(таңданған дауыс)
Dialogue: 0,0:25:45.46,0:25:47.54,Default,,0,0,0,,Пампл Лу қуыршақ паф?
Dialogue: 0,0:25:47.62,0:25:48.46,Default,,0,0,0,,Иә
Dialogue: 0,0:25:48.63,0:25:51.50,Default,,0,0,0,,Бұл анаң саған арнап жасаған қуыршақ.
Dialogue: 0,0:25:52.34,0:25:53.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:55.67,0:25:57.84,Default,,0,0,0,,Пан Пу Кин!
Dialogue: 0,0:25:58.13,0:25:59.39,Default,,0,0,0,,Не істеп жатырсың Рома?
Dialogue: 0,0:25:59.64,0:26:00.85,Default,,0,0,0,,(Жоқтау дауысы)
Dialogue: 0,0:26:01.43,0:26:04.47,Default,,0,0,0,,Памплелу осы елдің ханшайымы ма?
Dialogue: 0,0:26:05.18,0:26:06.02,Default,,0,0,0,,Иә
Dialogue: 0,0:26:06.73,0:26:09.27,Default,,0,0,0,,Рома? Романтика…
Dialogue: 0,0:26:09.73,0:26:11.19,Default,,0,0,0,,Рома!
Dialogue: 0,0:26:11.31,0:26:12.15,Default,,0,0,0,,Рома~!
Dialogue: 0,0:26:12.57,0:26:14.57,Default,,0,0,0,,Бір ханшайым болған!
Dialogue: 0,0:26:14.94,0:26:16.90,Default,,0,0,0,,Бірақ Рома қамауға алынды~
Dialogue: 0,0:26:16.99,0:26:19.57,Default,,0,0,0,,Иә, неге? Яғни...
Dialogue: 0,0:26:19.95,0:26:21.07,Default,,0,0,0,,Рома сұрап тұр!
Dialogue: 0,0:26:21.41,0:26:23.12,Default,,0,0,0,,О, күтіңіз, хош иіс
Dialogue: 0,0:26:23.20,0:26:25.45,Default,,0,0,0,,Мынаны ханшайымға беріңіз
Dialogue: 0,0:26:25.54,0:26:26.54,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:26:26.66,0:26:27.75,Default,,0,0,0,,Рома~!
Dialogue: 0,0:26:28.42,0:26:29.79,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:26:30.38,0:26:31.21,Default,,0,0,0,,Міне, алғашқы отбасыңды мүлде ұмытып қалғансың➡
Dialogue: 0,0:26:32.46,0:26:33.50,Default,,0,0,0,,Рахмет
Dialogue: 0,0:26:41.01,0:26:44.18,Default,,0,0,0,,Сенің анаң заттар жасауға өте шебер.
Dialogue: 0,0:26:44.97,0:26:48.52,Default,,0,0,0,,Мен барлығына сыйлық бергенді ұнататынмын.
Dialogue: 0,0:26:52.81,0:26:55.78,Default,,0,0,0,,Әкесі асқабақты зерттеп жатыр.
Dialogue: 0,0:26:56.19,0:26:58.95,Default,,0,0,0,,Мен жаңа асқабақ таптым.
Dialogue: 0,0:27:02.74,0:27:05.37,Default,,0,0,0,,Жаңа асқабақтан жасалған асқабақ пудингі
Dialogue: 0,0:27:06.24,0:27:08.12,Default,,0,0,0,,Бұл өте дәмді болды
Dialogue: 0,0:27:11.46,0:27:15.42,Default,,0,0,0,,Ал достықтың белгісі ретінде перілер
Dialogue: 0,0:27:15.67,0:27:17.84,Default,,0,0,0,,Мына кулонды мен үшін жасадыңыз.
Dialogue: 0,0:27:20.43,0:27:21.63,Default,,0,0,0,,Бірақ бір күні...
Dialogue: 0,0:27:22.22,0:27:25.64,Default,,0,0,0,,Мына балалармен асқабақ гүлін теріп жүрген кезім.
Dialogue: 0,0:27:28.14,0:27:29.23,Default,,0,0,0,,Ах...!
Dialogue: 0,0:27:32.60,0:27:35.52,Default,,0,0,0,,Содан кейін патша мен патшайым
Dialogue: 0,0:27:35.61,0:27:39.03,Default,,0,0,0,,Мен Памплуру ханшайымын мүлде ұмыттым.
Dialogue: 0,0:27:39.28,0:27:42.86,Default,,0,0,0,,Ханшайымды министр қамап қойды.
Dialogue: 0,0:27:43.32,0:27:46.28,Default,,0,0,0,,Иә, сол министр жаман жігіт пе?
Dialogue: 0,0:27:46.83,0:27:50.25,Default,,0,0,0,,Бұл Асқабақ патшалығы армандар мен үміттерге толы.
Dialogue: 0,0:27:51.00,0:27:53.21,Default,,0,0,0,,Бәрі бақытты өмір сүрген ел еді.
Dialogue: 0,0:27:54.00,0:27:56.46,Default,,0,0,0,,Неге... осылай...
Dialogue: 0,0:27:58.80,0:28:01.88,Default,,0,0,0,,Арман мен үміт бақытты бұрмалайды
Dialogue: 0,0:28:02.68,0:28:04.76,Default,,0,0,0,,Disdark-қа ұқсас
Dialogue: 0,0:28:05.05,0:28:07.68,Default,,0,0,0,,Үміт патшалығын қоршап тұрған үмітсіздік...
Dialogue: 0,0:28:08.97,0:28:11.64,Default,,0,0,0,,Хош иіс! ханшайымға айт
Dialogue: 0,0:28:11.77,0:28:13.56,Default,,0,0,0,,Мен бұл туралы міндетті түрде бірдеңе істеймін.
Dialogue: 0,0:28:13.65,0:28:14.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:28:14.90,0:28:16.77,Default,,0,0,0,,Романтика шегінде...
Dialogue: 0,0:28:16.86,0:28:18.19,Default,,0,0,0,,Уау, хош иіс керемет!
Dialogue: 0,0:28:18.57,0:28:20.69,Default,,0,0,0,,Уау, аға!
Dialogue: 0,0:28:20.90,0:28:22.53,Default,,0,0,0,,Жақсысың ба Пафф?
Dialogue: 0,0:28:23.49,0:28:25.03,Default,,0,0,0,,Рахмет хош иіс
Dialogue: 0,0:28:27.08,0:28:29.37,Default,,0,0,0,,А, балалар...
Dialogue: 0,0:28:29.83,0:28:32.16,Default,,0,0,0,,Пан Пу Кин…
Dialogue: 0,0:28:33.16,0:28:36.13,Default,,0,0,0,,Жарайды, мен сізге міндетті түрде көмектесемін.
Dialogue: 0,0:28:36.58,0:28:37.46,Default,,0,0,0,,(таңданған дауыс)
Dialogue: 0,0:28:38.13,0:28:42.97,Default,,0,0,0,,Қатты тілесең, тілегің міндетті түрде орындалады, хехе
Dialogue: 0,0:28:43.09,0:28:44.51,Default,,0,0,0,,(қуаныш дыбыстары)
Dialogue: 0,0:28:44.97,0:28:45.97,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:28:46.39,0:28:47.22,Default,,0,0,0,,Жақындама! Мен саған айттым ғой, оның ашуы тез шығатынын!
Dialogue: 0,0:28:47.43,0:28:49.18,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:28:49.72,0:28:50.64,Default,,0,0,0,,Э? Тұр... не?
Dialogue: 0,0:28:54.27,0:28:57.65,Default,,0,0,0,,(Скрипка музыкасы)
Dialogue: 0,0:29:02.53,0:29:04.40,Default,,0,0,0,,Қандай әдемі!
Dialogue: 0,0:29:04.49,0:29:06.41,Default,,0,0,0,,1-орын Това ханшайымына бұйырды
Dialogue: 0,0:29:06.53,0:29:08.03,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:29:08.24,0:29:12.00,Default,,0,0,0,,Енді күту бөлмесіне барыңыз.
Dialogue: 0,0:29:22.46,0:29:25.09,Default,,0,0,0,,Алда бір нәрсе болуы керек
Dialogue: 0,0:29:27.34,0:29:28.47,Default,,0,0,0,,(апелляциялық шағым)
Dialogue: 0,0:29:28.85,0:29:31.43,Default,,0,0,0,,Сіз оны осы жерден көре аласыз ба?
Dialogue: 0,0:29:37.19,0:29:38.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:29:46.82,0:29:47.91,Default,,0,0,0,,(ренжіген дауыс)
Dialogue: 0,0:29:56.33,0:29:57.58,Default,,0,0,0,,(ренжіген дауыс)
Dialogue: 0,0:29:59.54,0:30:01.29,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:30:06.67,0:30:09.05,Default,,0,0,0,,Қорқынышты! Ах...
Dialogue: 0,0:30:12.35,0:30:15.39,Default,,0,0,0,,Сол кезде менің сезгенім мынау мұң еді...
Dialogue: 0,0:30:18.48,0:30:22.23,Default,,0,0,0,,(мұңды дауыс)
Dialogue: 0,0:30:22.98,0:30:23.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:27.57,0:30:28.66,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:30:29.66,0:30:30.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:31.12,0:30:31.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:32.41,0:30:33.79,Default,,0,0,0,,Кирара! Минами!
Dialogue: 0,0:30:35.54,0:30:36.58,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:30:37.12,0:30:39.25,Default,,0,0,0,,Қандай тамаша көрініс.
Dialogue: 0,0:30:39.83,0:30:42.29,Default,,0,0,0,,Су перісін емдеу және Жылтырауды емдеу
Dialogue: 0,0:30:42.88,0:30:43.71,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:30:44.05,0:30:48.68,Default,,0,0,0,,Арманды бұрмалаймын, Үмітсіздіктің қараңғы жинаушысымын.
Dialogue: 0,0:30:51.59,0:30:52.64,Default,,0,0,0,,Бұрмалау
Dialogue: 0,0:30:53.01,0:30:53.85,Default,,0,0,0,,Уф...
Dialogue: 0,0:30:54.31,0:30:58.27,Default,,0,0,0,,Бұл үмітсіздіктің шағын жинағы.
Dialogue: 0,0:30:58.52,0:30:59.56,Default,,0,0,0,,Бұл...
Dialogue: 0,0:31:00.06,0:31:01.56,Default,,0,0,0,,Прекюр ханшайымы
Dialogue: 0,0:31:01.98,0:31:05.23,Default,,0,0,0,,Мен сенің арманың зор, күш-қуатың бар деп естідім.
Dialogue: 0,0:31:05.69,0:31:08.32,Default,,0,0,0,,Мен оны жаңа жинаққа айналдырғым келді.
Dialogue: 0,0:31:08.86,0:31:12.16,Default,,0,0,0,,Мен мұны да өз жинағыма қостым.
Dialogue: 0,0:31:12.28,0:31:13.12,Default,,0,0,0,,Э? Тұр... не?
Dialogue: 0,0:31:14.41,0:31:16.70,Default,,0,0,0,,Үшінші адам да ұстап алған сияқты.
Dialogue: 0,0:31:17.41,0:31:21.33,Default,,0,0,0,,Енді төртінші адаммен біраз көңіл көтерейік.
Dialogue: 0,0:31:21.88,0:31:25.55,Default,,0,0,0,,Аяқтау тым оңай болса, қызықсыз.
Dialogue: 0,0:31:25.80,0:31:29.30,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:31:32.97,0:31:34.60,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:31:34.68,0:31:36.26,Default,,0,0,0,,Хе-хе-хе
Dialogue: 0,0:31:36.60,0:31:39.02,Default,,0,0,0,,Бұл жолы мен біршама егжей-тегжейлі нәрсені қолданып көрдім.
Dialogue: 0,0:31:39.60,0:31:43.52,Default,,0,0,0,,Төреші патша мен патшайым болады.
Dialogue: 0,0:31:43.81,0:31:44.65,Default,,0,0,0,,Хмм...
Dialogue: 0,0:31:45.19,0:31:48.40,Default,,0,0,0,,Енді не істейсің?
Dialogue: 0,0:31:49.07,0:31:51.36,Default,,0,0,0,,Мен пудинг жасаймын!
Dialogue: 0,0:31:51.70,0:31:52.61,Default,,0,0,0,,Уау...
Dialogue: 0,0:31:53.07,0:31:55.99,Default,,0,0,0,,Ха ха, сәттілік.
Dialogue: 0,0:32:01.12,0:32:01.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:32:12.76,0:32:15.14,Default,,0,0,0,,Менің пудинг жасауға уақытым жоқ!
Dialogue: 0,0:32:15.22,0:32:17.22,Default,,0,0,0,,үшінның Романы ұстап алғанына сенімдімін
Dialogue: 0,0:32:17.31,0:32:19.77,Default,,0,0,0,,Перілерге де көмектеседі
Dialogue: 0,0:32:19.93,0:32:21.43,Default,,0,0,0,,Мүмкін сіз, мырза, сөгіс естігенді ұнататын сол қиын мінезді жандардың бірісіз бе?
Dialogue: 0,0:32:21.81,0:32:23.02,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,0:32:23.31,0:32:25.65,Default,,0,0,0,,Мен уайымдаймын, бірақ сенемін
Dialogue: 0,0:32:26.11,0:32:26.94,Default,,0,0,0,,А...
Dialogue: 0,0:32:27.57,0:32:30.23,Default,,0,0,0,,Мен бәріне сенемін.
Dialogue: 0,0:32:33.28,0:32:36.20,Default,,0,0,0,,Мен қазір қолымнан келгенді істеуім керек
Dialogue: 0,0:32:39.54,0:32:41.75,Default,,0,0,0,,Хмм... Уау!
Dialogue: 0,0:32:43.92,0:32:45.42,Default,,0,0,0,,Бұл дәмді.
Dialogue: 0,0:32:52.97,0:32:54.22,Default,,0,0,0,,Орындалды!
Dialogue: 0,0:32:57.76,0:32:59.76,Default,,0,0,0,,Пісіру аяқталды
Dialogue: 0,0:33:07.19,0:33:08.19,Default,,0,0,0,,Бұл...
Dialogue: 0,0:33:08.69,0:33:11.94,Default,,0,0,0,,А, у... Патша, патшайым
Dialogue: 0,0:33:12.07,0:33:15.32,Default,,0,0,0,,Бұл менің отбасымның пудингі
Dialogue: 0,0:33:16.07,0:33:17.82,Default,,0,0,0,,Отбасылық пудинг...?
Dialogue: 0,0:33:18.37,0:33:19.20,Default,,0,0,0,,Иә
Dialogue: 0,0:33:19.99,0:33:21.74,Default,,0,0,0,,Менің үйім - жапондық тәттілер дүкені
Dialogue: 0,0:33:22.33,0:33:24.71,Default,,0,0,0,,Тағамдар да күн сайын жапон тәттілері болды.
Dialogue: 0,0:33:25.42,0:33:26.67,Default,,0,0,0,,Бірақ бір күні әкем
Dialogue: 0,0:33:27.08,0:33:30.59,Default,,0,0,0,,Олар маған бірге пудинг әзірледі.
Dialogue: 0,0:33:49.44,0:33:52.23,Default,,0,0,0,,Бұл кәдімгі пудинг.
Dialogue: 0,0:33:53.53,0:33:57.11,Default,,0,0,0,,Бұл сіздің асыл отбасыңыздың дәмі.
Dialogue: 0,0:34:00.45,0:34:02.24,Default,,0,0,0,,Уау...
Dialogue: 0,0:34:06.00,0:34:09.25,Default,,0,0,0,,(Эмоция дауысы)
Dialogue: 0,0:34:09.63,0:34:12.21,Default,,0,0,0,,Отбасының талғамы? Бұл бос сөз
Dialogue: 0,0:34:12.59,0:34:14.84,Default,,0,0,0,,Бар жүрегіммен жасалған
Dialogue: 0,0:34:15.01,0:34:17.17,Default,,0,0,0,,Ләззат алыңыз!
Dialogue: 0,0:34:19.93,0:34:23.64,Default,,0,0,0,,Мен жеймін. (Патша) Мен де.
Dialogue: 0,0:34:39.53,0:34:43.08,Default,,0,0,0,,Сол бала алғаш рет есімде...
Dialogue: 0,0:34:45.20,0:34:49.17,Default,,0,0,0,,А, сен оны жасау үшін көп еңбек еттің...
Dialogue: 0,0:34:49.37,0:34:51.42,Default,,0,0,0,,Сол пудинг...
Dialogue: 0,0:34:54.34,0:34:55.30,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:34:58.88,0:35:00.22,Default,,0,0,0,,Пампл Лу…
Dialogue: 0,0:35:01.97,0:35:03.43,Default,,0,0,0,,Пампл Лу…
Dialogue: 0,0:35:05.52,0:35:06.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:35:07.27,0:35:08.98,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:35:09.89,0:35:11.52,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:35:11.60,0:35:14.94,Default,,0,0,0,,Бұл біршама қызықты аяқталатын сияқты!
Dialogue: 0,0:35:16.78,0:35:18.53,Default,,0,0,0,,Сіз өзіңізді аштыңыз!
Dialogue: 0,0:35:18.90,0:35:21.82,Default,,0,0,0,,Мен қараңғылықты жинаушымын, Варп!
Dialogue: 0,0:35:22.16,0:35:23.99,Default,,0,0,0,,Шық, Зецубург!
Dialogue: 0,0:35:24.45,0:35:26.83,Default,,0,0,0,,...
Dialogue: 0,0:35:27.29,0:35:28.54,Default,,0,0,0,,Жер бетінде не?
Dialogue: 0,0:35:28.91,0:35:30.71,Default,,0,0,0,,Патша мен патшайым, өтінемін!
Dialogue: 0,0:35:30.79,0:35:31.83,Default,,0,0,0,,Түсіндім Рома Түсіндім пафф
Dialogue: 0,0:35:32.25,0:35:33.17,Default,,0,0,0,,Хмм...
Dialogue: 0,0:35:35.59,0:35:36.59,Default,,0,0,0,,Прекюр
Dialogue: 0,0:35:37.88,0:35:39.51,Default,,0,0,0,,Ханшайымның қатысуы!
Dialogue: 0,0:36:14.25,0:36:17.59,Default,,0,0,0,,Жайнаған гүл ханшайымы
Dialogue: 0,0:36:20.09,0:36:21.92,Default,,0,0,0,,Флораны емдеңіз!
Dialogue: 0,0:36:24.72,0:36:27.68,Default,,0,0,0,,Соңғысы өте қызықты.
Dialogue: 0,0:36:28.18,0:36:30.73,Default,,0,0,0,,Алдымен орналасуды қарастырайық.
Dialogue: 0,0:36:31.14,0:36:32.14,Default,,0,0,0,,Цетсу!
Dialogue: 0,0:36:33.85,0:36:36.48,Default,,0,0,0,,Хмм... (Цетсуборг) Зецу! Борг!
Dialogue: 0,0:36:38.90,0:36:40.94,Default,,0,0,0,,Цетсу! Zetsu! Борг!
Dialogue: 0,0:36:41.03,0:36:43.45,Default,,0,0,0,,Zetsuborg! (Флора) Уф! Қарғыс атқыр...
Dialogue: 0,0:36:46.95,0:36:48.37,Default,,0,0,0,,Алмасу
Dialogue: 0,0:36:48.66,0:36:49.91,Default,,0,0,0,,Режим талғампаз!
Dialogue: 0,0:36:55.42,0:36:57.42,Default,,0,0,0,,Би, гүл!
Dialogue: 0,0:36:58.04,0:37:01.17,Default,,0,0,0,,Прекюр Гүлді...
Dialogue: 0,0:37:01.63,0:37:02.55,Default,,0,0,0,,Турбиллон!
Dialogue: 0,0:37:04.38,0:37:06.68,Default,,0,0,0,,Долли... Минг...
Dialogue: 0,0:37:07.64,0:37:09.31,Default,,0,0,0,,Ах! (Пан Пуу Киннің таңданған дауысы)
Dialogue: 0,0:37:09.68,0:37:10.51,Default,,0,0,0,,Ашық!
Dialogue: 0,0:37:11.85,0:37:13.35,Default,,0,0,0,,Арманға апаратын есік!
Dialogue: 0,0:37:17.31,0:37:19.19,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:37:19.86,0:37:21.19,Default,,0,0,0,,Мүлдем емес...
Dialogue: 0,0:37:21.32,0:37:25.24,Default,,0,0,0,,Бақытты болу тілегіңізге бірнеше өзгерістер енгізіңіз
Dialogue: 0,0:37:25.32,0:37:29.74,Default,,0,0,0,,Бұл күлкілі, өйткені ол оңай бұрмаланады хахаха...
Dialogue: 0,0:37:29.87,0:37:32.04,Default,,0,0,0,,(ашулы дауыс)
Dialogue: 0,0:37:32.83,0:37:33.66,Default,,0,0,0,,Хмм...
Dialogue: 0,0:37:33.96,0:37:38.33,Default,,0,0,0,,Жарайды, мен сені бірден жинағыма қосамын.
Dialogue: 0,0:37:38.67,0:37:40.29,Default,,0,0,0,,Осы сияқты
Dialogue: 0,0:37:44.84,0:37:45.97,Default,,0,0,0,,Ах...!
Dialogue: 0,0:37:48.68,0:37:50.60,Default,,0,0,0,,Борг!
Dialogue: 0,0:37:52.22,0:37:53.22,Default,,0,0,0,,Уау!
Dialogue: 0,0:37:55.10,0:37:57.35,Default,,0,0,0,,Уау~ (Цетсуборг) Зецуборг!
Dialogue: 0,0:37:58.90,0:37:59.77,Default,,0,0,0,,Флора!
Dialogue: 0,0:38:00.23,0:38:02.86,Default,,0,0,0,,Минами-сан Кирара-чан...
Dialogue: 0,0:38:03.78,0:38:05.11,Default,,0,0,0,,Това-чан жоқ!
Dialogue: 0,0:38:05.36,0:38:06.20,Default,,0,0,0,,Жоқ...?
Dialogue: 0,0:38:06.65,0:38:08.57,Default,,0,0,0,,Сіз мені іздеп жүрсіз бе?
Dialogue: 0,0:38:09.20,0:38:11.66,Default,,0,0,0,,Мен қараңғылықтың күшін көрдім.
Dialogue: 0,0:38:13.12,0:38:13.95,Default,,0,0,0,,Уф...
Dialogue: 0,0:38:15.54,0:38:16.75,Default,,0,0,0,,Бұл өкінішті.
Dialogue: 0,0:38:17.25,0:38:18.17,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:38:18.58,0:38:20.50,Default,,0,0,0,,Түсінемін, бұл қызық.
Dialogue: 0,0:38:23.34,0:38:24.34,Default,,0,0,0,,Прекюр
Dialogue: 0,0:38:25.80,0:38:27.51,Default,,0,0,0,,Ханшайымның қатысуы!
Dialogue: 0,0:39:01.42,0:39:03.42,Default,,0,0,0,,Қып-қызыл жалын ханшайымы
Dialogue: 0,0:39:07.38,0:39:09.01,Default,,0,0,0,,Скарлетті емдеңіз!
Dialogue: 0,0:39:12.35,0:39:13.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:39:13.80,0:39:15.64,Default,,0,0,0,,Флора! (Флора) Скарлет!
Dialogue: 0,0:39:15.97,0:39:18.68,Default,,0,0,0,,Өкінішке орай, бәрі әдеттегідей болмайды.
Dialogue: 0,0:39:18.77,0:39:20.14,Default,,0,0,0,,Бұл жолы емес...
Dialogue: 0,0:39:20.73,0:39:23.52,Default,,0,0,0,,Орнату әдемі болмады.
Dialogue: 0,0:39:23.61,0:39:27.40,Default,,0,0,0,,Прекюр жинағы енді аяқталды.
Dialogue: 0,0:39:29.20,0:39:30.32,Default,,0,0,0,,Бүгін түстен кейін мектеп әлеуметтік жиналысқа жабық болады.
Dialogue: 0,0:39:32.78,0:39:35.62,Default,,0,0,0,,Алдын ала тазартылған қызыл жалын!
Dialogue: 0,0:39:37.75,0:39:38.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:38.95,0:39:40.54,Default,,0,0,0,,Оны бұзуға болмайды
Dialogue: 0,0:39:40.62,0:39:44.00,Default,,0,0,0,,Үмітсіздікке толы.
Dialogue: 0,0:39:44.29,0:39:45.34,Default,,0,0,0,,Алдын ала!
Dialogue: 0,0:39:45.88,0:39:48.71,Default,,0,0,0,,Бұл өте жақсы әңгіме болды.
Dialogue: 0,0:39:48.80,0:39:52.97,Default,,0,0,0,,Мен сені қолға түсіру үшін осы елді таңдауда дұрыс таңдау жасадым.
Dialogue: 0,0:39:53.18,0:39:54.01,Default,,0,0,0,,Кира өте икемсіз ғой, иә?
Dialogue: 0,0:39:54.43,0:39:59.52,Default,,0,0,0,,Патша мен патшайымның армандары бұрмаланып, көп үмітсіздік жиналды.
Dialogue: 0,0:39:59.77,0:40:00.94,Default,,0,0,0,,(ашулы дауыс)
Dialogue: 0,0:40:01.35,0:40:05.61,Default,,0,0,0,,Бұл елдің адамдары бізді алу үшін ме?
Dialogue: 0,0:40:06.02,0:40:10.32,Default,,0,0,0,,Тәтті, тәтті ел еді, сондықтан мен сені оңай алдадым.
Dialogue: 0,0:40:10.49,0:40:11.95,Default,,0,0,0,,(ашулы дауыс)
Dialogue: 0,0:40:12.20,0:40:13.49,Default,,0,0,0,,Хмм...
Dialogue: 0,0:40:14.28,0:40:17.70,Default,,0,0,0,,Отбасылық пудинг? күлкілі
Dialogue: 0,0:40:19.12,0:40:19.95,Default,,0,0,0,,(таңданған дауыс)
Dialogue: 0,0:40:20.20,0:40:21.08,Default,,0,0,0,,Поо!
Dialogue: 0,0:40:21.79,0:40:22.75,Default,,0,0,0,,Ертегі!
Dialogue: 0,0:40:22.83,0:40:24.00,Default,,0,0,0,,Поо!
Dialogue: 0,0:40:25.50,0:40:28.92,Default,,0,0,0,,Поо! Пууу! Пууу!
Dialogue: 0,0:40:29.17,0:40:32.51,Default,,0,0,0,,Хахаха, олар әлі ақымақ.
Dialogue: 0,0:40:36.76,0:40:38.01,Default,,0,0,0,,үшінна!
Dialogue: 0,0:40:39.10,0:40:42.06,Default,,0,0,0,,Үмітсіздік дәміне ештеңе тең келе алмайды!
Dialogue: 0,0:40:43.31,0:40:45.73,Default,,0,0,0,,Бұл дұрыс емес... Е!
Dialogue: 0,0:40:46.36,0:40:47.19,Default,,0,0,0,,Фалько…
Dialogue: 0,0:40:47.57,0:40:49.65,Default,,0,0,0,,Бақыттың дәмі жақсырақ...
Dialogue: 0,0:40:49.94,0:40:54.07,Default,,0,0,0,,Бұл әрқашан, әрқашан, дәмді!
Dialogue: 0,0:40:54.74,0:40:55.57,Default,,0,0,0,,Ха...
Dialogue: 0,0:40:55.78,0:40:58.28,Default,,0,0,0,,Мен пудинг жеймін!
Dialogue: 0,0:40:59.08,0:41:00.08,Default,,0,0,0,,Ертегі
Dialogue: 0,0:41:00.49,0:41:02.54,Default,,0,0,0,,Король патшайым
Dialogue: 0,0:41:03.04,0:41:04.37,Default,,0,0,0,,Памплуру ханшайымы
Dialogue: 0,0:41:05.21,0:41:08.71,Default,,0,0,0,,үшінна бақытқа толы асқабақ пудингі
Dialogue: 0,0:41:08.88,0:41:12.34,Default,,0,0,0,,Мен көп жеймін!
Dialogue: 0,0:41:15.47,0:41:16.30,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:41:16.51,0:41:19.64,Default,,0,0,0,,(Дарио) «Ах! Бұл жігіт мені өз құтқарушысы деп ойлайды ғой. ➡
Dialogue: 0,0:41:19.85,0:41:20.72,Default,,0,0,0,,Хаа!
Dialogue: 0,0:41:24.52,0:41:25.90,Default,,0,0,0,,О, құдайым...
Dialogue: 0,0:41:26.15,0:41:27.52,Default,,0,0,0,,Хмф! Хмф!
Dialogue: 0,0:41:32.99,0:41:33.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:34.61,0:41:35.78,Default,,0,0,0,,Рахмет
Dialogue: 0,0:41:37.07,0:41:39.16,Default,,0,0,0,,Менің коллекциям...
Dialogue: 0,0:41:43.25,0:41:44.50,Default,,0,0,0,,Алдын алу
Dialogue: 0,0:41:45.62,0:41:47.17,Default,,0,0,0,,Ханшайымның қатысуы!
Dialogue: 0,0:42:15.65,0:42:19.45,Default,,0,0,0,,Мөлдір теңіз ханшайымы
Dialogue: 0,0:42:22.33,0:42:23.99,Default,,0,0,0,,Су перісін емдеңіз!
Dialogue: 0,0:42:27.29,0:42:29.29,Default,,0,0,0,,Жарқыраған жұлдыз ханшайымы
Dialogue: 0,0:42:32.34,0:42:34.00,Default,,0,0,0,,Жарқылды емдеңіз!
Dialogue: 0,0:42:36.47,0:42:39.84,Default,,0,0,0,,Қандай әдемі... Қандай тамаша көрініс
Dialogue: 0,0:42:40.22,0:42:42.81,Default,,0,0,0,,Олай болса, біз оны реттей аламыз деп үміттенемін. Ха!
Dialogue: 0,0:42:43.72,0:42:45.27,Default,,0,0,0,,Хмф! Гррр...
Dialogue: 0,0:42:49.90,0:42:50.73,Default,,0,0,0,,Kya...
Dialogue: 0,0:42:50.81,0:42:51.69,Default,,0,0,0,,Таа!
Dialogue: 0,0:42:55.36,0:42:57.74,Default,,0,0,0,,Zetsu! Борг...!
Dialogue: 0,0:43:03.12,0:43:04.12,Default,,0,0,0,,Таа!
Dialogue: 0,0:43:07.45,0:43:09.21,Default,,0,0,0,,Иә! Хааа!
Dialogue: 0,0:43:10.00,0:43:11.17,Default,,0,0,0,,Бұл – Демоноруқтар корпусы! Мұнда ойланбастан кіруге болмайды!
Dialogue: 0,0:43:14.92,0:43:16.84,Default,,0,0,0,,Шыу!
Dialogue: 0,0:43:17.09,0:43:19.30,Default,,0,0,0,,Цетсу! Борг...!
Dialogue: 0,0:43:21.43,0:43:22.97,Default,,0,0,0,,Сақпаңыз...
Dialogue: 0,0:43:23.60,0:43:25.72,Default,,0,0,0,,Хамф!
Dialogue: 0,0:43:25.97,0:43:27.73,Default,,0,0,0,,Уау!
Dialogue: 0,0:43:31.98,0:43:34.48,Default,,0,0,0,,Уау!
Dialogue: 0,0:43:36.73,0:43:38.15,Default,,0,0,0,,Хмф! (Қызыл) Әй!
Dialogue: 0,0:43:47.70,0:43:49.66,Default,,0,0,0,,Прекюр~!
Dialogue: 0,0:43:50.71,0:43:52.17,Default,,0,0,0,,Алмасу
Dialogue: 0,0:43:54.21,0:43:55.92,Default,,0,0,0,,Режим талғампаз!
Dialogue: 0,0:43:56.17,0:43:57.80,Default,,0,0,0,,Лилия (су перісі) көпіршігі
Dialogue: 0,0:43:57.96,0:43:59.05,Default,,0,0,0,,Атқан жұлдыз
Dialogue: 0,0:43:59.17,0:43:59.92,Default,,0,0,0,,Феникс
Dialogue: 0,0:44:04.26,0:44:07.01,Default,,0,0,0,,Жалынның қанаттары!
Dialogue: 0,0:44:08.93,0:44:12.19,Default,,0,0,0,,...
Dialogue: 0,0:44:13.90,0:44:16.40,Default,,0,0,0,,Жарқырай бер, үш құдірет!
Dialogue: 0,0:44:16.82,0:44:20.61,Default,,0,0,0,,...
Dialogue: 0,0:44:21.49,0:44:23.28,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:44:25.95,0:44:27.79,Default,,0,0,0,,Уау...
Dialogue: 0,0:44:27.99,0:44:30.33,Default,,0,0,0,,А... Хахахаха!
Dialogue: 0,0:44:30.45,0:44:31.29,Default,,0,0,0,,Иә!
Dialogue: 0,0:44:31.79,0:44:35.79,Default,,0,0,0,,Сіз мені осындай күшпен жеңе аласыз деп ойлайсыз ба?
Dialogue: 0,0:44:36.92,0:44:39.25,Default,,0,0,0,,Уау!
Dialogue: 0,0:44:46.22,0:44:47.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:54.44,0:44:55.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:59.94,0:45:00.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:45:05.20,0:45:06.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:45:13.12,0:45:14.33,Default,,0,0,0,,Уф...
Dialogue: 0,0:45:17.13,0:45:18.84,Default,,0,0,0,,Уау! (Ханшайым) Кя!
Dialogue: 0,0:45:26.18,0:45:28.55,Default,,0,0,0,,(Уорптың соғыс айқайы)
Dialogue: 0,0:45:37.86,0:45:38.69,Default,,0,0,0,,Ах...!
Dialogue: 0,0:45:39.48,0:45:41.82,Default,,0,0,0,,Қайғыр!
Dialogue: 0,0:45:47.82,0:45:50.03,Default,,0,0,0,,Азап!
Dialogue: 0,0:45:57.67,0:46:00.42,Default,,0,0,0,,Өте өкінішті!
Dialogue: 0,0:46:07.59,0:46:09.55,Default,,0,0,0,,Күте тұрыңыз! Жоқ!
Dialogue: 0,0:46:09.64,0:46:10.76,Default,,0,0,0,,Барма!
Dialogue: 0,0:46:11.26,0:46:13.68,Default,,0,0,0,,Үмітсіздік!
Dialogue: 0,0:46:18.10,0:46:18.94,Default,,0,0,0,,Ах...!
Dialogue: 0,0:46:34.24,0:46:36.04,Default,,0,0,0,,Ух... ха...
Dialogue: 0,0:46:36.58,0:46:38.33,Default,,0,0,0,,Дөңгелек…
Dialogue: 0,0:46:39.17,0:46:40.83,Default,,0,0,0,,Уф...
Dialogue: 0,0:46:41.75,0:46:43.88,Default,,0,0,0,,Осындай күшті жаумен...
Dialogue: 0,0:46:44.38,0:46:46.76,Default,,0,0,0,,Мен қалай күресуім керек?
Dialogue: 0,0:46:50.34,0:46:52.18,Default,,0,0,0,,Берілме!
Dialogue: 0,0:46:59.60,0:47:01.27,Default,,0,0,0,,Памплуру ханшайымы...
Dialogue: 0,0:47:05.90,0:47:07.28,Default,,0,0,0,,Отбасымнан алыста~!
Dialogue: 0,0:47:07.86,0:47:10.45,Default,,0,0,0,,үшінмыз күш біріктірейік!
Dialogue: 0,0:47:10.53,0:47:11.49,Default,,0,0,0,,Өл! Мен сенің төменгі ерініңді тіліп өтемін!
Dialogue: 0,0:47:12.37,0:47:13.41,Default,,0,0,0,,Бұрыс!
Dialogue: 0,0:47:13.70,0:47:16.54,Default,,0,0,0,,Менің қымбат Асқабақ патшалығым...
Dialogue: 0,0:47:16.91,0:47:18.25,Default,,0,0,0,,Достар...
Dialogue: 0,0:47:18.58,0:47:20.71,Default,,0,0,0,,Мен отбасымды қайтарғым келеді!
Dialogue: 0,0:47:21.38,0:47:25.17,Default,,0,0,0,,Үмітсіздікке жұт!
Dialogue: 0,0:47:25.96,0:47:28.84,Default,,0,0,0,,үшін, үміттенуді ұмытпаңыз!
Dialogue: 0,0:47:34.60,0:47:35.43,Default,,0,0,0,,(таңданған дауыс)
Dialogue: 0,0:47:36.14,0:47:37.68,Default,,0,0,0,,Армандарыңыздан бас тартпаңыз!
Dialogue: 0,0:47:45.94,0:47:48.65,Default,,0,0,0,,Бақыттан бас тартпа!
Dialogue: 0,0:47:56.33,0:48:00.12,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,0:48:03.63,0:48:05.04,Default,,0,0,0,,Біз де...
Dialogue: 0,0:48:05.63,0:48:07.25,Default,,0,0,0,,(Рейха) Деку… (Иида) Не болып жатыр өзі? Бұл маңызды алғашқы жекпе-жек қой—көрермендерді қызықтыр!
Dialogue: 0,0:48:07.92,0:48:09.63,Default,,0,0,0,,Жалпы білім беру бөлімінің оқушысы Шинсо Хитоси—
Dialogue: 0,0:48:10.22,0:48:12.22,Default,,0,0,0,,Әр адамның күші...
Dialogue: 0,0:48:13.18,0:48:14.93,Default,,0,0,0,,Күштеріңізді біріктіріңіз!
Dialogue: 0,0:48:18.85,0:48:19.68,Default,,0,0,0,,Э? Тұр... не?
Dialogue: 0,0:48:26.52,0:48:28.32,Default,,0,0,0,,Уау...!
Dialogue: 0,0:48:40.33,0:48:43.42,Default,,0,0,0,,Бұл... Керемет ханшайым Жарық Рома!
Dialogue: 0,0:48:44.04,0:48:47.46,Default,,0,0,0,,үшін~ Шамды жағыңыз!
Dialogue: 0,0:48:52.22,0:48:54.51,Default,,0,0,0,,Жарықты шайқаңыз және үрлеңіз!
Dialogue: 0,0:48:54.80,0:48:58.31,Default,,0,0,0,,Рома Прекюр~-ге қуат жібереді
Dialogue: 0,0:48:58.76,0:49:02.68,Default,,0,0,0,,Прекюр~ Сәттілік~!
Dialogue: 0,0:49:02.77,0:49:07.23,Default,,0,0,0,,Прекюр~ Сәттілік~!
Dialogue: 0,0:49:07.31,0:49:11.86,Default,,0,0,0,,Прекюр~ Сәттілік~!
Dialogue: 0,0:49:11.94,0:49:16.45,Default,,0,0,0,,Прекюр~ Сәттілік~!
Dialogue: 0,0:49:16.53,0:49:20.41,Default,,0,0,0,,Прекюр~ Сәттілік~!
Dialogue: 0,0:49:30.25,0:49:31.30,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:49:31.59,0:49:33.51,Default,,0,0,0,,Жаңа Кирома!
Dialogue: 0,0:49:34.26,0:49:37.84,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:49:37.97,0:49:38.80,Default,,0,0,0,,Хмм...
Dialogue: 0,0:49:43.31,0:49:45.19,Default,,0,0,0,,Режим талғампаз!
Dialogue: 0,0:49:48.86,0:49:50.07,Default,,0,0,0,,Хэллоуин!
Dialogue: 0,0:50:22.64,0:50:23.89,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:50:24.98,0:50:26.44,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:50:28.69,0:50:29.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:30.36,0:50:32.48,Default,,0,0,0,,Прекюр~
Dialogue: 0,0:50:36.53,0:50:40.95,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:50:41.95,0:50:42.87,Default,,0,0,0,,Хмм...
Dialogue: 0,0:50:47.96,0:50:50.79,Default,,0,0,0,,Барлық күш-қуатты естіңіз!
Dialogue: 0,0:50:51.42,0:50:55.88,Default,,0,0,0,,Прекюр Хэллоуин...
Dialogue: 0,0:50:55.96,0:50:57.80,Default,,0,0,0,,Эклер!
Dialogue: 0,0:51:00.34,0:51:03.01,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:51:03.93,0:51:07.06,Default,,0,0,0,,Осы Warp-sama үшін...
Dialogue: 0,0:51:07.27,0:51:12.90,Default,,0,0,0,,Хаа~!
Dialogue: 0,0:51:13.19,0:51:17.90,Default,,0,0,0,,Үнсіз үміт үзіп, жинаққа айнал!
Dialogue: 0,0:51:19.24,0:51:23.83,Default,,0,0,0,,Ешқайсымыз сізге бас имейміз!
Dialogue: 0,0:51:26.16,0:51:31.88,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:51:54.44,0:51:55.73,Default,,0,0,0,,Біз ең әлсіз болғандықтан, сол күшті түсінетіндер бар.
Dialogue: 0,0:52:15.34,0:52:18.34,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:52:29.93,0:52:33.02,Default,,0,0,0,,Ха... Әке, ана!
Dialogue: 0,0:52:34.69,0:52:35.52,Default,,0,0,0,,Ах...!
Dialogue: 0,0:52:40.40,0:52:43.03,Default,,0,0,0,,Ха... Пампл!
Dialogue: 0,0:52:44.70,0:52:47.70,Default,,0,0,0,,Әке, ана!
Dialogue: 0,0:52:47.87,0:52:49.12,Default,,0,0,0,,Пампл Лу!
Dialogue: 0,0:52:49.37,0:52:50.66,Default,,0,0,0,,Пампл Лу!
Dialogue: 0,0:52:57.00,0:52:58.96,Default,,0,0,0,,Иә, осындай нәрсе!
Dialogue: 0,0:52:59.46,0:53:02.42,Default,,0,0,0,,Мынадай нәрсе... мынандай нәрсе!
Dialogue: 0,0:53:04.26,0:53:06.89,Default,,0,0,0,,Бұл мүлде қазына емес!
Dialogue: 0,0:53:07.18,0:53:10.81,Default,,0,0,0,,Біздің нағыз қазынамыз...
Dialogue: 0,0:53:14.44,0:53:16.40,Default,,0,0,0,,Пампл Лу!
Dialogue: 0,0:53:18.82,0:53:22.49,Default,,0,0,0,,Біздің… қазынамыз…
Dialogue: 0,0:53:23.45,0:53:28.12,Default,,0,0,0,,Сізді қорғай алмағанымыз үшін кешіріңіз.
Dialogue: 0,0:53:29.49,0:53:30.87,Default,,0,0,0,,Жетеді
Dialogue: 0,0:53:31.79,0:53:34.62,Default,,0,0,0,,Әке, ана…
Dialogue: 0,0:53:35.25,0:53:39.17,Default,,0,0,0,,Қайтып келгеніңіз үшін рахмет...
Dialogue: 0,0:53:47.64,0:53:49.01,Default,,0,0,0,,үшінңызға рахмет
Dialogue: 0,0:53:49.10,0:53:51.72,Default,,0,0,0,,Асқабақ патшалығын қайта бастауға болады
Dialogue: 0,0:53:52.27,0:53:54.10,Default,,0,0,0,,(Виолет) Мен теремін. (Роданс) Жарай бер.
Dialogue: 0,0:53:54.48,0:53:56.85,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:53:57.56,0:53:59.36,Default,,0,0,0,,Алғысымды қалай айтамын?
Dialogue: 0,0:53:59.44,0:54:01.90,Default,,0,0,0,,Балға қатысқыңыз келе ме?
Dialogue: 0,0:54:01.98,0:54:03.11,Default,,0,0,0,,Иә!
Dialogue: 0,0:54:03.49,0:54:05.11,Default,,0,0,0,,Әй, көйлек...
Dialogue: 0,0:54:05.28,0:54:06.57,Default,,0,0,0,,Мұндай жағдайда...
Dialogue: 0,0:54:08.49,0:54:10.58,Default,,0,0,0,,Сәлем~Баршаңызға!
Dialogue: 0,0:54:10.66,0:54:12.70,Default,,0,0,0,,Шамур ханым.
Dialogue: 0,0:54:13.79,0:54:16.41,Default,,0,0,0,,Көйлекті маған қалдырыңыз~
Dialogue: 0,0:54:16.79,0:54:18.17,Default,,0,0,0,,Уау~
Dialogue: 0,0:54:18.38,0:54:20.67,Default,,0,0,0,,Міне, осында!
Dialogue: 0,0:54:20.75,0:54:22.88,Default,,0,0,0,,үшінңызға күткеніңізге рахмет!
Dialogue: 0,0:54:22.96,0:54:26.09,Default,,0,0,0,,Мен тамаша үйлестіру жасаймын~
Dialogue: 0,0:54:26.17,0:54:32.18,Default,,0,0,0,,♪～
Dialogue: 0,0:56:01.44,0:56:07.44,Default,,0,0,0,,～♪
Dialogue: 0,0:56:10.07,0:56:12.36,Default,,0,0,0,,үшінна дем алу ұнады ма?
Dialogue: 0,0:56:12.74,0:56:15.45,Default,,0,0,0,,Келесіде Памплуру ханшайымы маған сыйға тартқан қуыршақ.
Dialogue: 0,0:56:15.53,0:56:17.74,Default,,0,0,0,,Романың Рефимен бірге тамаша шытырман оқиғасы!
Dialogue: 0,0:56:17.83,0:56:20.33,Default,,0,0,0,,Шамдармен дем алу~
Dialogue: 0,0:56:23.71,0:56:25.46,Default,,0,0,0,,Дәл қазір!
Dialogue: 0,0:56:25.54,0:56:28.67,Default,,0,0,0,,...Юй-чан әлі қайтып келген жоқ.
Dialogue: 0,0:56:31.47,0:56:33.26,Default,,0,0,0,,Харука иә?
Dialogue: 0,0:56:34.01,0:56:36.68,Default,,0,0,0,,Иә...? Міне, міне!
Dialogue: 0,0:56:36.93,0:56:40.43,Default,,0,0,0,,А... А? Ол үстелдің үстінде.
Dialogue: 0,0:56:41.81,0:56:42.64,Default,,0,0,0,,А...
Dialogue: 0,0:56:42.98,0:56:47.02,Default,,0,0,0,,Иә! Қуыршақ сөйледі ме?
Dialogue: 0,0:56:49.15,0:56:50.28,Default,,0,0,0,,Хмм...
Dialogue: 0,0:56:50.69,0:56:51.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:56:52.36,0:56:54.99,Default,,0,0,0,,Не болды?
Dialogue: 0,0:56:56.24,0:56:58.74,Default,,0,0,0,,Бұл қайда...?
Dialogue: 0,0:57:03.04,0:57:05.71,Default,,0,0,0,,Уау, сен өзгердің!
Dialogue: 0,0:57:07.54,0:57:08.75,Default,,0,0,0,,Уау! не?
Dialogue: 0,0:57:08.84,0:57:09.71,Default,,0,0,0,,Zetsuborg!
Dialogue: 0,0:57:10.05,0:57:12.22,Default,,0,0,0,,Иә? Zetsuborg? (Цетсуборг) Зетсу!
Dialogue: 0,0:57:13.72,0:57:16.22,Default,,0,0,0,,Ұш! (Флора) Е, сәл күте тұрыңыз...
Dialogue: 0,0:57:21.47,0:57:22.52,Default,,0,0,0,,Zetsu…
Dialogue: 0,0:57:24.98,0:57:26.81,Default,,0,0,0,,Хмм...
Dialogue: 0,0:57:27.15,0:57:30.15,Default,,0,0,0,,Неліктен Zetsuborg? Ал бұл не деген жер?
Dialogue: 0,0:57:30.23,0:57:32.36,Default,,0,0,0,,Сіз кімсіз? Сені неге қуып жүр?
Dialogue: 0,0:57:32.44,0:57:33.70,Default,,0,0,0,,Бір ғана сұрақ қойыңыз
Dialogue: 0,0:57:33.82,0:57:36.20,Default,,0,0,0,,Сонда сен кімсің?
Dialogue: 0,0:57:36.74,0:57:38.74,Default,,0,0,0,,Zetsuborg! (2 адам) Уау...!
Dialogue: 0,0:57:40.45,0:57:42.54,Default,,0,0,0,,Уау! Уау
Dialogue: 0,0:57:50.25,0:57:53.47,Default,,0,0,0,,...
Dialogue: 0,0:57:55.55,0:57:58.43,Default,,0,0,0,,Хаа~ Сен мені түсінбейсің бе?
Dialogue: 0,0:57:59.14,0:58:00.93,Default,,0,0,0,,Сіз барлық уақытта үстеліңізде отырдыңыз.
Dialogue: 0,0:58:01.22,0:58:03.39,Default,,0,0,0,,А... үстел?
Dialogue: 0,0:58:04.31,0:58:07.19,Default,,0,0,0,,Иә! Әйтеуір, әлгі бала?
Dialogue: 0,0:58:07.48,0:58:09.23,Default,,0,0,0,,Бірақ ол бала қуыршақ...
Dialogue: 0,0:58:09.48,0:58:12.03,Default,,0,0,0,,Мен қуыршақ емеспін, мен Рефимін.
Dialogue: 0,0:58:12.65,0:58:14.86,Default,,0,0,0,,Анықтама...? Иә?
Dialogue: 0,0:58:15.99,0:58:17.36,Default,,0,0,0,,Цетсуборг
Dialogue: 0,0:58:18.45,0:58:22.58,Default,,0,0,0,,Уау! (Zetsuborg) Zetsuborg!
Dialogue: 0,0:58:25.83,0:58:27.33,Default,,0,0,0,,(Цетсубург айқайы)
Dialogue: 0,0:58:29.83,0:58:30.67,Default,,0,0,0,,үшінна!
Dialogue: 0,0:58:31.92,0:58:33.88,Default,,0,0,0,,Эй, бұл не?
Dialogue: 0,0:58:33.96,0:58:36.26,Default,,0,0,0,,Біз осында екенімізді білгенде...
Dialogue: 0,0:58:36.34,0:58:37.93,Default,,0,0,0,,Түсіндіре аласыз ба?
Dialogue: 0,0:58:42.10,0:58:43.97,Default,,0,0,0,,Мен сонда түсіндіремін.
Dialogue: 0,0:58:51.40,0:58:53.15,Default,,0,0,0,,Уау~
Dialogue: 0,0:59:04.41,0:59:05.50,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:59:07.21,0:59:08.67,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:59:11.08,0:59:14.13,Default,,0,0,0,,Енді осы жағдайды түсіндіре аласыз ба?
Dialogue: 0,0:59:14.84,0:59:16.01,Default,,0,0,0,,Мен рефимін
Dialogue: 0,0:59:16.46,0:59:19.13,Default,,0,0,0,,Бұл ел бұрын өте жарық болатын.
Dialogue: 0,0:59:19.55,0:59:22.18,Default,,0,0,0,,Бірақ ол келгеннен кейін бәрі өзгерді.
Dialogue: 0,0:59:22.64,0:59:23.68,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:59:24.35,0:59:25.64,Default,,0,0,0,,Түнгі асқабақ
Dialogue: 0,0:59:26.02,0:59:27.64,Default,,0,0,0,,Түнгі асқабақ?
Dialogue: 0,0:59:28.10,0:59:29.56,Default,,0,0,0,,Кенеттен пайда болу
Dialogue: 0,0:59:29.64,0:59:32.73,Default,,0,0,0,,Көзді ашып-жұмғанша бұл елден күннің нұрын алып кетті.
Dialogue: 0,0:59:33.02,0:59:35.11,Default,,0,0,0,,Күндізгі жарықты алып тастау керек пе?
Dialogue: 0,0:59:42.82,0:59:43.91,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:59:44.20,0:59:45.91,Default,,0,0,0,,Ғажайып ханшайымның жарығы
Dialogue: 0,0:59:46.37,0:59:48.83,Default,,0,0,0,,Егер сіз оны ол орналасқан сарайдың төбесіне қойсаңыз.
Dialogue: 0,0:59:48.91,0:59:50.62,Default,,0,0,0,,үшінн қалпына келтіруге болады
Dialogue: 0,0:59:51.04,0:59:52.67,Default,,0,0,0,,Күндізгі жарықты қайтара аламыз ба?
Dialogue: 0,0:59:53.25,0:59:55.13,Default,,0,0,0,,Себебі бұл сізде болды
Dialogue: 0,0:59:55.21,0:59:57.42,Default,,0,0,0,,Цетсуборгтар бізді қуып бара жатты, солай емес пе?
Dialogue: 0,0:59:57.80,1:00:00.05,Default,,0,0,0,,Мен оларды жалғыз жеңе алмаймын.
Dialogue: 0,1:00:00.13,1:00:01.51,Default,,0,0,0,,Мен де барлығына телефон соқтым.
Dialogue: 0,1:00:03.34,1:00:05.89,Default,,0,0,0,,Өтінемін... күшіңді берші!
Dialogue: 0,1:00:07.72,1:00:08.89,Default,,0,0,0,,Хехе…
Dialogue: 0,1:00:09.31,1:00:12.40,Default,,0,0,0,,Жасайық! үшінмыз қаланы қайтарайық!
Dialogue: 0,1:00:12.73,1:00:14.06,Default,,0,0,0,,Мен сен осылай айтасың деп ойладым.
Dialogue: 0,1:00:14.40,1:00:17.07,Default,,0,0,0,,Қараңғылыққа толы қала мұңды.
Dialogue: 0,1:00:17.53,1:00:18.82,Default,,0,0,0,,үшін келіседі.
Dialogue: 0,1:00:19.24,1:00:21.32,Default,,0,0,0,,Шынымен бе? үшінңызға рахмет!
Dialogue: 0,1:00:21.90,1:00:23.82,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,1:00:24.12,1:00:27.49,Default,,0,0,0,,Қамалда қатаң қауіпсіздік бар, сондықтан сіз алдыңғы жақтан кіре алмайсыз.
Dialogue: 0,1:00:27.58,1:00:30.16,Default,,0,0,0,,Сеетборг! (үшін) Ха...!
Dialogue: 0,1:00:30.54,1:00:32.83,Default,,0,0,0,,...
Dialogue: 0,1:00:33.29,1:00:35.34,Default,,0,0,0,,Қатты! Бұрынғы жігіттер ғой.
Dialogue: 0,1:00:35.59,1:00:38.00,Default,,0,0,0,,Мен олардың назарын аударып жатқанда
Dialogue: 0,1:00:38.09,1:00:39.46,Default,,0,0,0,,Артқы есік арқылы қашыңыз
Dialogue: 0,1:00:39.59,1:00:40.59,Default,,0,0,0,,Мен жақында жетемін.
Dialogue: 0,1:00:40.84,1:00:43.09,Default,,0,0,0,,Бұл ақылсыз! Бірге қашайық
Dialogue: 0,1:00:43.38,1:00:45.26,Default,,0,0,0,,Жарайды, маған қалдырыңыз!
Dialogue: 0,1:00:47.68,1:00:48.51,Default,,0,0,0,,Өл! Мен сенің төменгі ерініңді тіліп өтемін!
Dialogue: 0,1:00:54.15,1:00:56.31,Default,,0,0,0,,үшінна! Көңіліңіз толқып тұр ма?
Dialogue: 0,1:00:56.44,1:00:59.32,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:00:59.53,1:01:01.32,Default,,0,0,0,,...
Dialogue: 0,1:01:01.61,1:01:03.32,Default,,0,0,0,,Күрсін...
Dialogue: 0,1:01:03.91,1:01:05.66,Default,,0,0,0,,А... ә?
Dialogue: 0,1:01:06.28,1:01:09.12,Default,,0,0,0,,Келіңіздер, бәріңіз! Кеттік~
Dialogue: 0,1:01:09.20,1:01:11.33,Default,,0,0,0,,(жоғары ырғақты музыка)
Dialogue: 0,1:01:12.12,1:01:13.83,Default,,0,0,0,,Цетсу! Борг…
Dialogue: 0,1:01:17.75,1:01:18.75,Default,,0,0,0,,Анықтама…
Dialogue: 0,1:01:19.05,1:01:20.67,Default,,0,0,0,,Флора! (Флора) Ух... иә
Dialogue: 0,1:01:27.60,1:01:29.06,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:01:29.14,1:01:29.97,Default,,0,0,0,,Ах...
Dialogue: 0,1:01:31.31,1:01:32.89,Default,,0,0,0,,Ум...
Dialogue: 0,1:01:33.14,1:01:35.10,Default,,0,0,0,,Уау, олай емес!
Dialogue: 0,1:01:35.48,1:01:37.02,Default,,0,0,0,,Мен не істеуім керек? (Zetsuborg) Zetsuborg!
Dialogue: 0,1:01:39.07,1:01:40.23,Default,,0,0,0,,Біз осы нүктеге жеттік...
Dialogue: 0,1:01:40.32,1:01:41.94,Default,,0,0,0,,Енді ше?
Dialogue: 0,1:01:43.53,1:01:44.78,Default,,0,0,0,,Цетсу!
Dialogue: 0,1:01:45.32,1:01:46.49,Default,,0,0,0,,Қоршалған?
Dialogue: 0,1:01:47.03,1:01:48.99,Default,,0,0,0,,Мен не істеуім керек? Ешқандай құтылу жоқ.
Dialogue: 0,1:01:49.08,1:01:50.91,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:50.99,1:01:52.58,Default,,0,0,0,,үшін, міне, сенің мүмкіндігің!
Dialogue: 0,1:01:53.00,1:01:54.96,Default,,0,0,0,,Хаа~ Хмф!
Dialogue: 0,1:01:59.17,1:02:00.92,Default,,0,0,0,,Енді менің кезегім!
Dialogue: 0,1:02:02.88,1:02:04.80,Default,,0,0,0,,Сәлем! иә? (Қызыл) Флора!
Dialogue: 0,1:02:05.01,1:02:06.51,Default,,0,0,0,,Ұшайық! (Флора) Иә!
Dialogue: 0,1:02:10.43,1:02:13.10,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:02:14.89,1:02:16.10,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:02:16.23,1:02:18.10,Default,,0,0,0,,Zetsu!
Dialogue: 0,1:02:20.98,1:02:22.44,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:02:23.11,1:02:24.19,Default,,0,0,0,,Уау...!
Dialogue: 0,1:02:25.45,1:02:26.78,Default,,0,0,0,,Мұз? (Zetsuborg) Zetsuborg!
Dialogue: 0,1:02:35.62,1:02:38.08,Default,,0,0,0,,Ха! (Zetsuborg) Zetsuborg...
Dialogue: 0,1:02:44.21,1:02:46.80,Default,,0,0,0,,Ха! (Цетсуборг) Зетсу!
Dialogue: 0,1:02:50.97,1:02:51.80,Default,,0,0,0,,Өл! Мен сенің төменгі ерініңді тіліп өтемін!
Dialogue: 0,1:02:54.10,1:02:54.97,Default,,0,0,0,,Өл! Мен сенің төменгі ерініңді тіліп өтемін!
Dialogue: 0,1:02:57.35,1:02:58.90,Default,,0,0,0,,Ха!
Dialogue: 0,1:02:58.98,1:03:00.44,Default,,0,0,0,,Zetsuborg...
Dialogue: 0,1:03:00.56,1:03:03.11,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:03:12.45,1:03:15.04,Default,,0,0,0,,Zetsuborg!
Dialogue: 0,1:03:16.33,1:03:17.46,Default,,0,0,0,,...
Dialogue: 0,1:03:20.29,1:03:22.59,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:03:27.97,1:03:30.09,Default,,0,0,0,,...
Dialogue: 0,1:03:30.51,1:03:32.39,Default,,0,0,0,,Сізде әлі рефи бар ма?
Dialogue: 0,1:03:32.93,1:03:33.85,Default,,0,0,0,,Ең алдымен,
Dialogue: 0,1:03:33.93,1:03:36.10,Default,,0,0,0,,Әлгі қызда ханшайымның жарығы бар, солай ма?
Dialogue: 0,1:03:37.73,1:03:39.44,Default,,0,0,0,,Мен қараймын.
Dialogue: 0,1:03:40.73,1:03:44.40,Default,,0,0,0,,Мен бірден қайтамын! Refi~-мен бірге
Dialogue: 0,1:03:45.15,1:03:46.36,Default,,0,0,0,,Жоқ, тіпті қазір де, егер рұқсат етсеңіз…
Dialogue: 0,1:03:47.03,1:03:49.70,Default,,0,0,0,,...
Dialogue: 0,1:03:50.20,1:03:53.37,Default,,0,0,0,,Ах... Флора
Dialogue: 0,1:03:54.03,1:03:57.04,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:03:58.25,1:04:01.25,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:04:07.42,1:04:08.42,Default,,0,0,0,,Ах...
Dialogue: 0,1:04:16.72,1:04:17.64,Default,,0,0,0,,(күрсіну)
Dialogue: 0,1:04:20.69,1:04:22.40,Default,,0,0,0,,Рефиге қараңыз.
Dialogue: 0,1:04:22.69,1:04:25.02,Default,,0,0,0,,Күн сәулесі түсетін заттар
Dialogue: 0,1:04:25.15,1:04:27.32,Default,,0,0,0,,Әр нәрсенің аты бар
Dialogue: 0,1:04:27.86,1:04:28.86,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,1:04:29.03,1:04:33.24,Default,,0,0,0,,...
Dialogue: 0,1:04:33.32,1:04:34.49,Default,,0,0,0,,О, менің әкем ғой.
Dialogue: 0,1:04:35.28,1:04:36.49,Default,,0,0,0,,Және фитнес тестінде де мен нашар өттім…
Dialogue: 0,1:04:36.58,1:04:38.62,Default,,0,0,0,,Күн қай жерде...
Dialogue: 0,1:04:39.45,1:04:41.04,Default,,0,0,0,,Міне болды!
Dialogue: 0,1:04:41.12,1:04:43.96,Default,,0,0,0,,...
Dialogue: 0,1:04:45.46,1:04:47.55,Default,,0,0,0,,Қайта, не болды?
Dialogue: 0,1:04:49.05,1:04:53.18,Default,,0,0,0,,...
Dialogue: 0,1:04:54.30,1:04:57.51,Default,,0,0,0,,Бұл өте әдемі және әдемі қала болды.
Dialogue: 0,1:05:00.02,1:05:02.27,Default,,0,0,0,,Әке мен ана
Dialogue: 0,1:05:02.85,1:05:05.40,Default,,0,0,0,,...
Dialogue: 0,1:05:05.98,1:05:09.61,Default,,0,0,0,,Орман аты, тау аты, өзен аты...
Dialogue: 0,1:05:09.94,1:05:10.82,Default,,0,0,0,,Анықтама…
Dialogue: 0,1:05:11.07,1:05:13.20,Default,,0,0,0,,Бірақ қазір екеуі де ұсталды.
Dialogue: 0,1:05:13.28,1:05:14.66,Default,,0,0,0,,Тіпті кездесе алмаймын
Dialogue: 0,1:05:15.95,1:05:16.78,Default,,0,0,0,,Мен...
Dialogue: 0,1:05:17.53,1:05:20.12,Default,,0,0,0,,Мен екеуіңмен осы жерде тағы сөйлескім келеді.
Dialogue: 0,1:05:20.70,1:05:24.37,Default,,0,0,0,,Мен таулар, өзендер, ормандар туралы бәрін жаттап алдым!
Dialogue: 0,1:05:26.96,1:05:29.75,Default,,0,0,0,,Жарайды! Мен сенімен міндетті түрде кездесемін
Dialogue: 0,1:05:31.09,1:05:32.21,Default,,0,0,0,,Флора…
Dialogue: 0,1:05:33.38,1:05:36.01,Default,,0,0,0,,Ешқашан үмітіңді үзбе
Dialogue: 0,1:05:36.34,1:05:38.76,Default,,0,0,0,,Мен үшін маңызды адамнан не үйрендім
Dialogue: 0,1:05:39.56,1:05:41.72,Default,,0,0,0,,Сондықтан Refy...
Dialogue: 0,1:05:41.81,1:05:43.35,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:43.56,1:05:46.81,Default,,0,0,0,,Сен осы елдің ханшайымы едің ғой?
Dialogue: 0,1:05:47.15,1:05:50.57,Default,,0,0,0,,Мен бірдеңе қалыпты емес деп ойладым.
Dialogue: 0,1:05:50.73,1:05:52.86,Default,,0,0,0,,Сіз Рефи ханшайымын айтып тұрсыз, солай ма?
Dialogue: 0,1:05:53.19,1:05:57.41,Default,,0,0,0,,Бұл ел сізге міндетті түрде қайтарылады.
Dialogue: 0,1:05:57.57,1:06:00.20,Default,,0,0,0,,Рефи ханшайым, уайымдамаңыз.
Dialogue: 0,1:06:00.74,1:06:02.37,Default,,0,0,0,,Уау
Dialogue: 0,1:06:03.12,1:06:04.04,Default,,0,0,0,,…қашып кету…
Dialogue: 0,1:06:04.71,1:06:05.83,Default,,0,0,0,,Рахмет!
Dialogue: 0,1:06:06.46,1:06:09.34,Default,,0,0,0,,Жарайды, бәріміз кеттік!
Dialogue: 0,1:06:16.05,1:06:17.34,Default,,0,0,0,,Ах ха...!
Dialogue: 0,1:06:20.68,1:06:25.35,Default,,0,0,0,,Олар соншалықты тәкаппар, соншалықты алысқа келді.
Dialogue: 0,1:06:25.64,1:06:27.35,Default,,0,0,0,,Сіз түнгі асқабақсыз!
Dialogue: 0,1:06:27.77,1:06:30.36,Default,,0,0,0,,...
Dialogue: 0,1:06:31.11,1:06:34.36,Default,,0,0,0,,Иә, секіретін ханшайым?
Dialogue: 0,1:06:35.19,1:06:39.24,Default,,0,0,0,,Сіз не істей аласыз?
Dialogue: 0,1:06:42.33,1:06:43.58,Default,,0,0,0,,Ха!
Dialogue: 0,1:06:44.70,1:06:45.87,Default,,0,0,0,,Уау!
Dialogue: 0,1:06:46.91,1:06:48.00,Default,,0,0,0,,Мен мұны істеймін.
Dialogue: 0,1:06:48.12,1:06:50.88,Default,,0,0,0,,Бұл әлі алыс! Эй!
Dialogue: 0,1:06:52.92,1:06:54.46,Default,,0,0,0,,Хамф!
Dialogue: 0,1:06:55.34,1:06:56.17,Default,,0,0,0,,73 адам із-түссіз жоғалып кетті
Dialogue: 0,1:06:56.76,1:06:57.59,Default,,0,0,0,,Хааа
Dialogue: 0,1:06:58.84,1:06:59.68,Default,,0,0,0,,Ах...
Dialogue: 0,1:07:01.05,1:07:02.26,Default,,0,0,0,,Таа~!
Dialogue: 0,1:07:03.39,1:07:04.27,Default,,0,0,0,,Таа!
Dialogue: 0,1:07:08.73,1:07:10.40,Default,,0,0,0,,Флора ше?
Dialogue: 0,1:07:11.73,1:07:14.11,Default,,0,0,0,,Енді ойлап қарасам, мен оны біраз уақыттан бері көрдім...
Dialogue: 0,1:07:17.49,1:07:20.07,Default,,0,0,0,,Баршаңызға~!
Dialogue: 0,1:07:21.24,1:07:23.08,Default,,0,0,0,,Біреу байқады...
Dialogue: 0,1:07:24.87,1:07:26.70,Default,,0,0,0,,Не? иә!
Dialogue: 0,1:07:26.87,1:07:30.12,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,1:07:32.29,1:07:33.75,Default,,0,0,0,,Гууах...! Уф...
Dialogue: 0,1:07:34.17,1:07:36.34,Default,,0,0,0,,...
Dialogue: 0,1:07:37.38,1:07:39.34,Default,,0,0,0,,...
Dialogue: 0,1:07:39.63,1:07:42.60,Default,,0,0,0,,Эхехехе мен абдырап қалдым.
Dialogue: 0,1:07:42.72,1:07:46.10,Default,,0,0,0,,Рефий, сіз Princess Light-ты шатырға тез жеткізе аласыз!
Dialogue: 0,1:07:46.22,1:07:47.64,Default,,0,0,0,,Ух... иә!
Dialogue: 0,1:07:48.89,1:07:50.81,Default,,0,0,0,,Мені жіберіңізші!
Dialogue: 0,1:07:51.23,1:07:53.69,Default,,0,0,0,,Флора! Мен рефи алғым келеді, өтінемін.
Dialogue: 0,1:07:53.77,1:07:55.11,Default,,0,0,0,,...
Dialogue: 0,1:07:55.48,1:07:56.36,Default,,0,0,0,,Иә!
Dialogue: 0,1:07:56.82,1:07:58.61,Default,,0,0,0,,Мен сені бұл жерден жібермеймін.
Dialogue: 0,1:07:58.86,1:08:01.78,Default,,0,0,0,,...
Dialogue: 0,1:08:02.36,1:08:05.62,Default,,0,0,0,,...
Dialogue: 0,1:08:06.58,1:08:07.83,Default,,0,0,0,,Есіңізде болсын!
Dialogue: 0,1:08:16.80,1:08:17.76,Default,,0,0,0,,Ах!
Dialogue: 0,1:08:19.13,1:08:20.88,Default,,0,0,0,,Zetsuborg!
Dialogue: 0,1:08:21.47,1:08:23.39,Default,,0,0,0,,Ха!
Dialogue: 0,1:08:23.68,1:08:25.76,Default,,0,0,0,,（）
Dialogue: 0,1:08:28.10,1:08:29.39,Default,,0,0,0,,...
Dialogue: 0,1:08:29.85,1:08:30.68,Default,,0,0,0,,Хаа!
Dialogue: 0,1:08:40.28,1:08:41.40,Default,,0,0,0,,...
Dialogue: 0,1:08:41.90,1:08:44.41,Default,,0,0,0,,Сіз жақындап қалдыңыз, сондықтан бар күшіңізді салыңыз!
Dialogue: 0,1:08:44.49,1:08:45.41,Default,,0,0,0,,（）
Dialogue: 0,1:08:45.95,1:08:47.58,Default,,0,0,0,,Му!
Dialogue: 0,1:08:47.66,1:08:49.83,Default,,0,0,0,,Кет!
Dialogue: 0,1:08:50.75,1:08:54.88,Default,,0,0,0,,（）
Dialogue: 0,1:09:02.88,1:09:04.39,Default,,0,0,0,,...
Dialogue: 0,1:09:11.60,1:09:12.60,Default,,0,0,0,,♪~
Dialogue: 0,1:09:13.89,1:09:14.85,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,1:09:15.44,1:09:17.61,Default,,0,0,0,,...
Dialogue: 0,1:09:25.20,1:09:27.62,Default,,0,0,0,,～ （２）
Dialogue: 0,1:09:30.08,1:09:31.75,Default,,0,0,0,,үшінна не болды?
Dialogue: 0,1:09:32.29,1:09:34.46,Default,,0,0,0,,Мына балалар ше?
Dialogue: 0,1:09:36.58,1:09:37.63,Default,,0,0,0,,...
Dialogue: 0,1:09:38.04,1:09:38.88,Default,,0,0,0,,Жарқыра!
Dialogue: 0,1:09:39.46,1:09:40.63,Default,,0,0,0,,Скарлет!
Dialogue: 0,1:09:41.63,1:09:45.34,Default,,0,0,0,,...
Dialogue: 0,1:09:45.72,1:09:46.55,Default,,0,0,0,,(Польнарефф) Ә? Бұл не? Бұл жабысқақ не?
Dialogue: 0,1:09:46.64,1:09:47.72,Default,,0,0,0,,Мен сені кешірмеймін!
Dialogue: 0,1:09:50.10,1:09:53.27,Default,,0,0,0,,...
Dialogue: 0,1:09:53.89,1:09:56.31,Default,,0,0,0,,...
Dialogue: 0,1:09:57.48,1:10:00.11,Default,,0,0,0,,...
Dialogue: 0,1:10:00.44,1:10:02.11,Default,,0,0,0,,Бұл менікі
Dialogue: 0,1:10:02.65,1:10:05.53,Default,,0,0,0,,Жоқ! Бұл Рефидікі
Dialogue: 0,1:10:05.65,1:10:09.12,Default,,0,0,0,,...
Dialogue: 0,1:10:09.58,1:10:12.33,Default,,0,0,0,,Хмф! Хозаке~!
Dialogue: 0,1:10:15.00,1:10:15.87,Default,,0,0,0,,Ах...
Dialogue: 0,1:10:16.37,1:10:17.54,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,1:10:20.54,1:10:21.96,Default,,0,0,0,,Ах... ой...
Dialogue: 0,1:10:26.30,1:10:27.30,Default,,0,0,0,,Уф...
Dialogue: 0,1:10:32.43,1:10:33.27,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,1:10:39.73,1:10:43.65,Default,,0,0,0,,Иә, сен солай айттың ғой? Бұл босқа
Dialogue: 0,1:10:48.16,1:10:50.32,Default,,0,0,0,,Артық емес... жоқ...
Dialogue: 0,1:10:54.58,1:10:56.12,Default,,0,0,0,,Уф...
Dialogue: 0,1:10:57.33,1:10:59.12,Default,,0,0,0,,Дөңгелек…
Dialogue: 0,1:11:00.00,1:11:03.00,Default,,0,0,0,,Сонда да... Мен берілмеймін
Dialogue: 0,1:11:03.21,1:11:05.84,Default,,0,0,0,,Себебі мен Рефиге уәде бердім!
Dialogue: 0,1:11:06.13,1:11:08.34,Default,,0,0,0,,Қаланы бастапқы қалпына келтіру
Dialogue: 0,1:11:08.84,1:11:10.26,Default,,0,0,0,,Флора…
Dialogue: 0,1:11:10.84,1:11:14.60,Default,,0,0,0,,Мен қамал террассасынан қаланың қалпына келтірілгенін көргім келеді.
Dialogue: 0,1:11:15.06,1:11:18.56,Default,,0,0,0,,Рефи, король және патшайыммен!
Dialogue: 0,1:11:22.82,1:11:23.69,Default,,0,0,0,,Анықтама…
Dialogue: 0,1:11:24.23,1:11:25.15,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:11:28.07,1:11:28.90,Default,,0,0,0,,Иә!
Dialogue: 0,1:11:32.57,1:11:33.95,Default,,0,0,0,,Ха!
Dialogue: 0,1:11:39.58,1:11:41.33,Default,,0,0,0,,Хмф! Лефи!
Dialogue: 0,1:11:42.67,1:11:44.55,Default,,0,0,0,,Иә!
Dialogue: 0,1:11:44.80,1:11:47.51,Default,,0,0,0,,Ооо, итата... жібер!
Dialogue: 0,1:11:48.63,1:11:50.80,Default,,0,0,0,,Қақпақ~! О, кетті!
Dialogue: 0,1:11:51.30,1:11:53.30,Default,,0,0,0,,Енді, Рефи! бару
Dialogue: 0,1:11:55.43,1:11:56.43,Default,,0,0,0,,Рахмет!
Dialogue: 0,1:11:57.52,1:12:00.52,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:12:01.56,1:12:03.56,Default,,0,0,0,,Маған рұқсат етіңіз!
Dialogue: 0,1:12:04.15,1:12:05.15,Default,,0,0,0,,Біз туралы
Dialogue: 0,1:12:05.69,1:12:07.07,Default,,0,0,0,,Сіз ұмытып кеткен сияқтысыз.
Dialogue: 0,1:12:07.48,1:12:09.07,Default,,0,0,0,,Бұл дөрекі емес пе?
Dialogue: 0,1:12:09.45,1:12:11.41,Default,,0,0,0,,Еске сала кетейін!
Dialogue: 0,1:12:11.57,1:12:12.41,Default,,0,0,0,,үшінна!
Dialogue: 0,1:12:15.78,1:12:17.91,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,1:12:19.20,1:12:23.38,Default,,0,0,0,,Мен қорқып, жалғыз қалдым, уайымдадым және дәрменсіз болдым.
Dialogue: 0,1:12:24.00,1:12:26.05,Default,,0,0,0,,Бірақ Флора бәрі жақсы дейді.
Dialogue: 0,1:12:26.21,1:12:28.09,Default,,0,0,0,,Үмітіңді үзбе деді
Dialogue: 0,1:12:29.42,1:12:32.05,Default,,0,0,0,,Сондықтан мен берілмеймін!
Dialogue: 0,1:12:33.34,1:12:38.64,Default,,0,0,0,,Мен ешқашан берілмеймін!
Dialogue: 0,1:12:39.48,1:12:42.06,Default,,0,0,0,,Балалар, сендер неге тұра аласыңдар?
Dialogue: 0,1:12:42.39,1:12:45.06,Default,,0,0,0,,Мен саған Рефи ханшайымның арманын бұзуға жол бермеймін!
Dialogue: 0,1:12:46.27,1:12:50.15,Default,,0,0,0,,Рефи ханшайым, бар күшіңізді салыңыз! Сәттілік Прекюр!
Dialogue: 0,1:12:50.74,1:12:52.86,Default,,0,0,0,,Балалар! Кяах!
Dialogue: 0,1:12:52.95,1:12:55.37,Default,,0,0,0,,Уау!
Dialogue: 0,1:12:56.99,1:12:58.41,Default,,0,0,0,,Үйісшо...
Dialogue: 0,1:13:00.95,1:13:03.42,Default,,0,0,0,,Ха!
Dialogue: 0,1:13:07.54,1:13:11.01,Default,,0,0,0,,Шыу!
Dialogue: 0,1:13:12.97,1:13:17.85,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:13:18.06,1:13:22.06,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:13:35.03,1:13:38.87,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:13:39.24,1:13:40.95,Default,,0,0,0,,Хехехе
Dialogue: 0,1:13:44.50,1:13:46.38,Default,,0,0,0,,Жарайсың Рефи!
Dialogue: 0,1:13:47.58,1:13:48.42,Default,,0,0,0,,Иә!
Dialogue: 0,1:13:50.13,1:13:51.17,Default,,0,0,0,,Рахмет
