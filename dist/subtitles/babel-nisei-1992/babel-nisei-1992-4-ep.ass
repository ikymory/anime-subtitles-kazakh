Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.04,0:00:03.37,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:03.62,0:00:05.00,Default,,0,0,0,,Иә! мұнара!
Dialogue: 0,0:00:05.13,0:00:08.96,Default,,0,0,0,,(Психисттердің ыңырсыуы)
Dialogue: 0,0:00:09.34,0:00:11.72,Default,,0,0,0,,Уф... аааа...
Dialogue: 0,0:00:11.84,0:00:12.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:13.13,0:00:15.14,Default,,0,0,0,,Сізді көргеніме қуаныштымын, Бабыр II.
Dialogue: 0,0:00:15.72,0:00:16.85,Default,,0,0,0,,Сіз Никола дедіңіз.
Dialogue: 0,0:00:17.22,0:00:21.06,Default,,0,0,0,,Хехехе, сенімен тағы кездескенім мақтаныш.
Dialogue: 0,0:00:21.18,0:00:24.35,Default,,0,0,0,,Таудың тереңіндегі мұнара сенікі ме?
Dialogue: 0,0:00:24.48,0:00:25.56,Default,,0,0,0,,Ал егер?
Dialogue: 0,0:00:26.15,0:00:28.52,Default,,0,0,0,,Мен мұны сенің соңғы қорғаныңа айналдырамын!
Dialogue: 0,0:00:29.94,0:00:31.28,Default,,0,0,0,,Хехехе
Dialogue: 0,0:00:35.16,0:00:36.20,Default,,0,0,0,,Таа!
Dialogue: 0,0:00:36.61,0:00:37.66,Default,,0,0,0,,Нвааах!
Dialogue: 0,0:00:38.24,0:00:40.12,Default,,0,0,0,,Йоми сонда ма?
Dialogue: 0,0:00:40.79,0:00:44.08,Default,,0,0,0,,Неге оны өзіңіз көрмейсіз?
Dialogue: 0,0:01:25.50,0:01:27.00,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:01:29.63,0:01:31.63,Default,,0,0,0,,Бұл мені шаршату стратегиясы ма?
Dialogue: 0,0:01:32.00,0:01:34.17,Default,,0,0,0,,Әй, қалағаныңды ал.
Dialogue: 0,0:01:36.17,0:01:37.47,Default,,0,0,0,,(Ичи) Вице-канцлермен кездесуге әлі біраз уақыт бар, бірақ—
Dialogue: 0,0:01:39.76,0:01:40.60,Default,,0,0,0,,Әй
Dialogue: 0,0:01:41.18,0:01:42.81,Default,,0,0,0,,Та!
Dialogue: 0,0:01:43.10,0:01:44.22,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:01:45.02,0:01:46.31,Default,,0,0,0,,Бұл Бабыр II.
Dialogue: 0,0:01:46.60,0:01:48.52,Default,,0,0,0,,Ол келді.
Dialogue: 0,0:01:48.65,0:01:52.11,Default,,0,0,0,,Иә, олар мұнараға бет алған болуы керек.
Dialogue: 0,0:01:52.23,0:01:54.03,Default,,0,0,0,,Мен оны қолдауым керек.
Dialogue: 0,0:01:54.15,0:01:55.11,Default,,0,0,0,,Тезірек барайық
Dialogue: 0,0:01:59.36,0:02:00.41,Default,,0,0,0,,(Бакуго) Сол жексұрын данышпан... Маған түк те керек емес!
Dialogue: 0,0:02:02.33,0:02:03.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:05.70,0:02:07.58,Default,,0,0,0,,Хехе...
Dialogue: 0,0:02:07.75,0:02:08.71,Default,,0,0,0,,Ах
Dialogue: 0,0:02:08.83,0:02:10.21,Default,,0,0,0,,Менің мұны істегенімді қалайсың ба?
Dialogue: 0,0:02:14.38,0:02:15.92,Default,,0,0,0,,Уау...
Dialogue: 0,0:02:19.01,0:02:19.84,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:21.43,0:02:22.97,Default,,0,0,0,,Асығыңыз (Еркек) Асығыңыз
Dialogue: 0,0:02:23.10,0:02:24.10,Default,,0,0,0,,Асығыңыз (Еркек) Асығыңыз!
Dialogue: 0,0:02:24.47,0:02:25.56,Default,,0,0,0,,Кел, Никола!
Dialogue: 0,0:02:30.40,0:02:31.23,Default,,0,0,0,,Шешуші соққы беру — әрқашан «Зе Ворлд»-тің шынайы күші.
Dialogue: 0,0:02:31.48,0:02:32.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:37.94,0:02:40.20,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:02:43.62,0:02:45.24,Default,,0,0,0,,Хехе...
Dialogue: 0,0:02:47.20,0:02:48.79,Default,,0,0,0,,Әй, а... (Еркек) Қарғыс атсын...
Dialogue: 0,0:02:49.08,0:02:51.50,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:02:51.92,0:02:52.92,Default,,0,0,0,,Не болды?
Dialogue: 0,0:02:53.67,0:02:57.30,Default,,0,0,0,,Бір-екі ауыл жойылды дегеніңіз не?
Dialogue: 0,0:02:57.42,0:03:01.05,Default,,0,0,0,,Бір күні бұл дүниенің бәрі Йоми-самаға тиесілі болады.
Dialogue: 0,0:03:01.55,0:03:03.89,Default,,0,0,0,,Мұны істеу мүмкін бе?
Dialogue: 0,0:03:04.22,0:03:06.06,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:03:07.35,0:03:09.56,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:19.24,0:03:20.07,Default,,0,0,0,,Ой
Dialogue: 0,0:03:21.91,0:03:23.57,Default,,0,0,0,,Уау
Dialogue: 0,0:03:34.25,0:03:35.88,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,0:03:36.00,0:03:38.17,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:03:42.88,0:03:43.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:44.01,0:03:45.22,Default,,0,0,0,,Уау
Dialogue: 0,0:03:52.69,0:03:55.31,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:04:00.03,0:04:01.40,Default,,0,0,0,,О, о...
Dialogue: 0,0:04:11.29,0:04:13.67,Default,,0,0,0,,Хаха...
Dialogue: 0,0:04:14.92,0:04:15.92,Default,,0,0,0,,Пами
Dialogue: 0,0:04:16.33,0:04:17.50,Default,,0,0,0,,Ах
Dialogue: 0,0:04:21.09,0:04:23.01,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:04:23.84,0:04:25.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:25.80,0:04:27.22,Default,,0,0,0,,Иә! Хахаха
Dialogue: 0,0:04:27.35,0:04:28.85,Default,,0,0,0,,Ахаха
Dialogue: 0,0:04:29.39,0:04:31.18,Default,,0,0,0,,Ха, жақсысың ба?
Dialogue: 0,0:04:31.31,0:04:35.81,Default,,0,0,0,,Ах, директор Ямадзаки, Озенджи мырза, мұнда неге келдің?
Dialogue: 0,0:04:36.27,0:04:38.15,Default,,0,0,0,,Менің мақсатым сіз сияқты.
Dialogue: 0,0:04:40.98,0:04:44.24,Default,,0,0,0,,Міне, біз келдік, сіз оларсыз.
Dialogue: 0,0:04:44.36,0:04:45.45,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:04:51.74,0:04:52.58,Default,,0,0,0,,Родем
Dialogue: 0,0:04:52.70,0:04:54.58,Default,,0,0,0,,Сіз Лопрос Посейдонмен біргесіз-
Dialogue: 0,0:04:54.71,0:04:56.04,Default,,0,0,0,,Менің нұсқауларымды күтіңіз.
Dialogue: 0,0:04:56.17,0:04:58.00,Default,,0,0,0,,(Родемнің айқайы)
Dialogue: 0,0:05:01.09,0:05:03.88,Default,,0,0,0,,(нәресте жылады)
Dialogue: 0,0:05:09.26,0:05:10.56,Default,,0,0,0,,Мықты болыңыз
Dialogue: 0,0:05:10.85,0:05:11.72,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:05:11.85,0:05:14.27,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:05:16.64,0:05:17.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:21.73,0:05:24.19,Default,,0,0,0,,Сонымен, сіз шабуылдың нәтижесін көріп тұрсыз ба?
Dialogue: 0,0:05:24.32,0:05:25.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:25.28,0:05:28.41,Default,,0,0,0,,Сендер экстрасенстер осылай істейсіңдер ме?
Dialogue: 0,0:05:30.62,0:05:31.95,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:32.54,0:05:34.37,Default,,0,0,0,,Мен... Бұл мен емес.
Dialogue: 0,0:05:34.91,0:05:36.08,Default,,0,0,0,,Жалтару
Dialogue: 0,0:05:37.62,0:05:40.33,Default,,0,0,0,,Мен...
Dialogue: 0,0:05:50.22,0:05:51.64,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:05:51.76,0:05:54.35,Default,,0,0,0,,Мен олардың достарының бірімін.
Dialogue: 0,0:05:54.47,0:05:56.68,Default,,0,0,0,,Бірақ бірдеңе дұрыс емес сияқты...
Dialogue: 0,0:05:57.02,0:05:58.14,Default,,0,0,0,,Уау, аа...
Dialogue: 0,0:05:58.56,0:05:59.56,Default,,0,0,0,,Хехехе
Dialogue: 0,0:06:00.06,0:06:00.90,Default,,0,0,0,,Хехехе
Dialogue: 0,0:06:01.73,0:06:03.48,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:06:04.32,0:06:05.15,Default,,0,0,0,,Әй
Dialogue: 0,0:06:05.28,0:06:06.44,Default,,0,0,0,,Фуук
Dialogue: 0,0:06:06.74,0:06:08.03,Default,,0,0,0,,Хехехе
Dialogue: 0,0:06:08.15,0:06:10.41,Default,,0,0,0,,Екеуміз бірміз
Dialogue: 0,0:06:10.95,0:06:14.37,Default,,0,0,0,,Жарық пен көлеңке денеңді кесіп өтеді
Dialogue: 0,0:06:16.08,0:06:17.46,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:06:17.66,0:06:19.42,Default,,0,0,0,,Тоу ха!
Dialogue: 0,0:06:22.34,0:06:23.21,Default,,0,0,0,,Уф
Dialogue: 0,0:06:23.50,0:06:25.05,Default,,0,0,0,,(Бакуго) Сол жексұрын данышпан... Маған түк те керек емес!
Dialogue: 0,0:06:25.17,0:06:26.26,Default,,0,0,0,,Уау
Dialogue: 0,0:06:32.14,0:06:33.64,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:06:34.56,0:06:35.77,Default,,0,0,0,,(Бакуго) Сол жексұрын данышпан... Маған түк те керек емес!
Dialogue: 0,0:06:36.35,0:06:37.56,Default,,0,0,0,,Хехе...
Dialogue: 0,0:06:37.68,0:06:39.56,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:06:40.73,0:06:41.94,Default,,0,0,0,,Бұл менің төзімділігім жақсарғандықтан, және
Dialogue: 0,0:06:43.61,0:06:44.32,Default,,0,0,0,,Уф
Dialogue: 0,0:06:45.02,0:06:46.23,Default,,0,0,0,,(Бакуго) Сол жексұрын данышпан... Маған түк те керек емес!
Dialogue: 0,0:06:46.36,0:06:47.24,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:47.36,0:06:48.19,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:06:48.57,0:06:53.12,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:06:53.32,0:06:55.58,Default,,0,0,0,,Уау, аа, а...
Dialogue: 0,0:06:56.41,0:06:57.41,Default,,0,0,0,,Хехехе
Dialogue: 0,0:06:57.54,0:07:01.04,Default,,0,0,0,,Егер мен сені жеңе алсам, әлем Йоми-самаға тиесілі болады.
Dialogue: 0,0:07:01.17,0:07:03.29,Default,,0,0,0,,Азап шегу, азап шегу
Dialogue: 0,0:07:03.46,0:07:05.34,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:05.84,0:07:09.76,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:07:10.05,0:07:11.09,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,0:07:11.22,0:07:15.18,Default,,0,0,0,,Мен өзімді осында өлтіруге жол бере алмаймын...
Dialogue: 0,0:07:15.47,0:07:16.64,Default,,0,0,0,,Таа!
Dialogue: 0,0:07:17.27,0:07:18.98,Default,,0,0,0,,Кя! Апыр-ай!
Dialogue: 0,0:07:19.31,0:07:21.44,Default,,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,0:07:22.19,0:07:23.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:24.48,0:07:26.86,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:07:27.02,0:07:28.11,Default,,0,0,0,,(Найзағайдың гүрсілі)
Dialogue: 0,0:07:28.23,0:07:30.32,Default,,0,0,0,,Кел, Бабыр II.
Dialogue: 0,0:07:30.49,0:07:31.74,Default,,0,0,0,,Күте тұрыңыз, Никола!
Dialogue: 0,0:07:31.86,0:07:33.57,Default,,0,0,0,,Хехе...
Dialogue: 0,0:07:36.12,0:07:36.95,Default,,0,0,0,,Уф
Dialogue: 0,0:07:41.21,0:07:45.88,Default,,0,0,0,,Бұл адамдар Йоми-сама үшін өз өмірін құрбан етуге дайын.
Dialogue: 0,0:07:46.54,0:07:49.96,Default,,0,0,0,,Әсіресе бұл сіздің энергияңыздың орнына болса.
Dialogue: 0,0:07:50.47,0:07:53.76,Default,,0,0,0,,Қанша уақыт күресуге болады? Бабыл II
Dialogue: 0,0:07:54.22,0:07:55.55,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:08:06.98,0:08:08.15,Default,,0,0,0,,Ах
Dialogue: 0,0:08:10.44,0:08:12.70,Default,,0,0,0,,Рэйчел Рэйчель Мықты болыңыз!
Dialogue: 0,0:08:13.45,0:08:16.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:16.28,0:08:17.24,Default,,0,0,0,,Ha
Dialogue: 0,0:08:17.41,0:08:18.95,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:19.58,0:08:21.12,Default,,0,0,0,,Сіз не істейсіз? Рэйчел
Dialogue: 0,0:08:21.25,0:08:22.62,Default,,0,0,0,,Ах
Dialogue: 0,0:08:22.87,0:08:25.08,Default,,0,0,0,,Ух... сатқын
Dialogue: 0,0:08:25.58,0:08:28.00,Default,,0,0,0,,Йоми-саманың... жауы
Dialogue: 0,0:08:28.13,0:08:29.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:37.35,0:08:39.68,Default,,0,0,0,,Спидвагон керемет шығып кетті.
Dialogue: 0,0:08:41.56,0:08:43.43,Default,,0,0,0,,(2-қыз) О, өтінемін, өзіңізді міндетті сезінбеңіз, ханым
Dialogue: 0,0:08:44.35,0:08:47.48,Default,,0,0,0,,Эй... Әпке
Dialogue: 0,0:08:49.36,0:08:51.98,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:09:00.41,0:09:03.41,Default,,0,0,0,,Рэйчел Ли
Dialogue: 0,0:09:05.00,0:09:06.79,Default,,0,0,0,,Сізге
Dialogue: 0,0:09:09.17,0:09:10.67,Default,,0,0,0,,Мен...
Dialogue: 0,0:09:18.05,0:09:19.43,Default,,0,0,0,,Тория! Апыр-ай!
Dialogue: 0,0:09:19.55,0:09:20.89,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:09:41.62,0:09:42.45,Default,,0,0,0,,Хабарлама!
Dialogue: 0,0:09:42.58,0:09:43.37,Default,,0,0,0,,Бұл менің төзімділігім жақсарғандықтан, және
Dialogue: 0,0:09:43.49,0:09:45.20,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:09:45.33,0:09:47.54,Default,,0,0,0,,Хаха...
Dialogue: 0,0:09:48.17,0:09:50.08,Default,,0,0,0,,Бұл мұнарада Йоми бар!
Dialogue: 0,0:09:50.21,0:09:52.55,Default,,0,0,0,,Хехехе иә.
Dialogue: 0,0:09:52.67,0:09:56.13,Default,,0,0,0,,Бірақ II Бабил әбден тозған сияқты, солай емес пе?
Dialogue: 0,0:09:56.51,0:09:58.55,Default,,0,0,0,,Мен Йоми-самамен кездесу үшін өмір сүремін бе?
Dialogue: 0,0:09:58.68,0:09:59.84,Default,,0,0,0,,Тория!
Dialogue: 0,0:10:00.14,0:10:02.26,Default,,0,0,0,,Мен сенің серігің боламын!
Dialogue: 0,0:10:02.39,0:10:03.47,Default,,0,0,0,,Таа! Уау
Dialogue: 0,0:10:03.60,0:10:04.43,Default,,0,0,0,,Таа! Апыр-ай!
Dialogue: 0,0:10:04.56,0:10:05.43,Default,,0,0,0,,Теря! Гува…
Dialogue: 0,0:10:08.19,0:10:10.56,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:10:11.11,0:10:12.40,Default,,0,0,0,,Хехехе
Dialogue: 0,0:10:14.78,0:10:16.94,Default,,0,0,0,,О, аа...
Dialogue: 0,0:10:28.33,0:10:29.46,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:10:35.05,0:10:38.01,Default,,0,0,0,,Олардың аурасы ұқсас қой, иә? Олар әпкелер ме?
Dialogue: 0,0:10:44.06,0:10:46.85,Default,,0,0,0,,Та!
Dialogue: 0,0:10:50.10,0:10:52.65,Default,,0,0,0,,Ал енді—
Dialogue: 0,0:10:59.32,0:11:00.32,Default,,0,0,0,,Казума
Dialogue: 0,0:11:00.45,0:11:02.03,Default,,0,0,0,,Йоми Йоми-сама
Dialogue: 0,0:11:03.70,0:11:04.78,Default,,0,0,0,,Ах
Dialogue: 0,0:11:08.04,0:11:09.66,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:11:20.84,0:11:22.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:24.26,0:11:25.35,Default,,0,0,0,,(Көрермен) Мен оны мінген күйдегі шайқасқа дейін қызықты жігіт деп ойладым…
Dialogue: 0,0:11:25.72,0:11:28.18,Default,,0,0,0,,Ах... уау!
Dialogue: 0,0:11:29.18,0:11:30.39,Default,,0,0,0,,Ах
Dialogue: 0,0:11:49.12,0:11:49.95,Default,,0,0,0,,Ha
Dialogue: 0,0:11:51.91,0:11:55.63,Default,,0,0,0,,Мен сені күттім, Бабыр II.
Dialogue: 0,0:11:56.67,0:11:57.50,Default,,0,0,0,,Оқу
Dialogue: 0,0:12:01.72,0:12:04.55,Default,,0,0,0,,Маған осылай тура қарап
Dialogue: 0,0:12:04.68,0:12:06.35,Default,,0,0,0,,Тек сен
Dialogue: 0,0:12:06.47,0:12:07.43,Default,,0,0,0,,Бұл оның әдеті.
Dialogue: 0,0:12:07.81,0:12:12.35,Default,,0,0,0,,Егер сіз әлемді билеуге деген амбицияңыздан бас тартпасаңыз
Dialogue: 0,0:12:12.48,0:12:13.85,Default,,0,0,0,,Сен жаусың!
Dialogue: 0,0:12:13.98,0:12:16.98,Default,,0,0,0,,Хэхехе... Мен де.
Dialogue: 0,0:12:17.11,0:12:19.69,Default,,0,0,0,,Тілектерімді орындау үшін
Dialogue: 0,0:12:19.82,0:12:22.61,Default,,0,0,0,,Сіз міндетті түрде жолға түсесіз.
Dialogue: 0,0:12:26.37,0:12:30.29,Default,,0,0,0,,Бұл мұнара сенің қабіріңнің белгісі болады.
Dialogue: 0,0:12:39.50,0:12:40.59,Default,,0,0,0,,На
Dialogue: 0,0:12:44.30,0:12:48.18,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:13:01.36,0:13:02.19,Default,,0,0,0,,Жылау
Dialogue: 0,0:13:02.82,0:13:03.90,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:06.99,0:13:12.29,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:13:12.62,0:13:13.91,Default,,0,0,0,,Ой
Dialogue: 0,0:13:14.37,0:13:16.50,Default,,0,0,0,,Тіркелмеген Арнайы Сынып па?
Dialogue: 0,0:13:16.92,0:13:18.58,Default,,0,0,0,,Ой-а-а…
Dialogue: 0,0:13:18.83,0:13:21.25,Default,,0,0,0,,Жәй ғана кішкентай сызат жеткілікті.
Dialogue: 0,0:13:21.38,0:13:22.63,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:22.76,0:13:25.47,Default,,0,0,0,,Гррр...
Dialogue: 0,0:13:25.59,0:13:28.26,Default,,0,0,0,,Бұл шағын тергеу. Бабыр II
Dialogue: 0,0:13:29.80,0:13:31.76,Default,,0,0,0,,Мен бұл туралы ойладым.
Dialogue: 0,0:13:31.89,0:13:33.85,Default,,0,0,0,,Біз Бабыл мұнарасында кездескен кезде
Dialogue: 0,0:13:33.97,0:13:38.73,Default,,0,0,0,,Менің күш-қуатымды сіңіріп, оны өз күшіңізге айналдырдыңыз.
Dialogue: 0,0:13:39.31,0:13:43.73,Default,,0,0,0,,Бірақ егер мен сізге сіз сіңіре алмайтын энергияны жіберсем,
Dialogue: 0,0:13:43.86,0:13:45.15,Default,,0,0,0,,Не болады?
Dialogue: 0,0:13:45.36,0:13:46.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:46.86,0:13:52.33,Default,,0,0,0,,Сіздің шаршаған денеңіз қанша уақытқа созылады?
Dialogue: 0,0:13:52.79,0:13:54.62,Default,,0,0,0,,Кү…
Dialogue: 0,0:13:55.08,0:13:56.58,Default,,0,0,0,,Йоми-самадан күткендей
Dialogue: 0,0:13:56.71,0:14:01.46,Default,,0,0,0,,Бабил II, мен сенің соңғы сәттеріңді баяу бақылай аламын.
Dialogue: 0,0:14:03.17,0:14:04.63,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:14:05.21,0:14:08.68,Default,,0,0,0,,Бар күшіңді, Бабылға құй!
Dialogue: 0,0:14:08.80,0:14:11.68,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:14:13.26,0:14:14.14,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:14:14.27,0:14:15.10,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:15.39,0:14:17.52,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:14:17.64,0:14:20.35,Default,,0,0,0,,Мен... Йоми-сама үшін.
Dialogue: 0,0:14:20.48,0:14:21.31,Default,,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,0:14:21.65,0:14:28.20,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:14:28.32,0:14:31.16,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:14:31.28,0:14:33.99,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:34.91,0:14:37.45,Default,,0,0,0,,Ах! Ааа...
Dialogue: 0,0:14:37.75,0:14:38.96,Default,,0,0,0,,Эй!
Dialogue: 0,0:14:39.08,0:14:40.92,Default,,0,0,0,,Зенitsu, енді қоя салшы!
Dialogue: 0,0:14:41.17,0:14:42.63,Default,,0,0,0,,Енді жоқ!
Dialogue: 0,0:14:44.88,0:14:46.55,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:47.13,0:14:49.01,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:14:49.13,0:14:50.59,Default,,0,0,0,,Нуа уау
Dialogue: 0,0:14:50.72,0:14:53.80,Default,,0,0,0,,Арх!
Dialogue: 0,0:14:54.51,0:14:57.64,Default,,0,0,0,,А, уф...
Dialogue: 0,0:14:57.77,0:15:00.77,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:15:01.65,0:15:06.65,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:15:07.65,0:15:09.70,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:15:13.95,0:15:15.41,Default,,0,0,0,,Спидвагон керемет шығып кетті.
Dialogue: 0,0:15:15.53,0:15:17.91,Default,,0,0,0,,Уф, уф...
Dialogue: 0,0:15:18.62,0:15:20.29,Default,,0,0,0,,Хехехе
Dialogue: 0,0:15:20.41,0:15:21.62,Default,,0,0,0,,Бекер күресу
Dialogue: 0,0:15:22.12,0:15:26.34,Default,,0,0,0,,Оқу: Жұтатын энергия жоқ...
Dialogue: 0,0:15:26.88,0:15:29.30,Default,,0,0,0,,Менде көп қор бар.
Dialogue: 0,0:15:29.42,0:15:33.14,Default,,0,0,0,,Денең жарылғанша
Dialogue: 0,0:15:33.26,0:15:35.80,Default,,0,0,0,,Соған энергияны құйып алайық.
Dialogue: 0,0:15:39.89,0:15:40.73,Default,,0,0,0,,Толық кауль!
Dialogue: 0,0:15:41.69,0:15:43.85,Default,,0,0,0,,Тоқтаңыз!
Dialogue: 0,0:15:48.32,0:15:49.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:52.15,0:15:53.36,Default,,0,0,0,,Джужу
Dialogue: 0,0:15:53.49,0:15:57.95,Default,,0,0,0,,Менің алдымда тағы да көрінгеніңіз өте жақсы.
Dialogue: 0,0:16:00.16,0:16:01.21,Default,,0,0,0,,Мен...
Dialogue: 0,0:16:01.33,0:16:05.25,Default,,0,0,0,,Мен Йоми-самамын, бізге экстрасенстерге жетекшілік етеді.
Dialogue: 0,0:16:05.38,0:16:09.51,Default,,0,0,0,,Оның шынайы тыныштық әкелетініне сендім.
Dialogue: 0,0:16:09.84,0:16:10.67,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:16:10.80,0:16:13.84,Default,,0,0,0,,Сіз маған пікір айтқыңыз келе ме?
Dialogue: 0,0:16:15.39,0:16:16.80,Default,,0,0,0,,Мен енді түсінбеймін
Dialogue: 0,0:16:18.68,0:16:21.89,Default,,0,0,0,,Осы уақытқа дейін не үшін күресіп келдіңіз?
Dialogue: 0,0:16:22.02,0:16:23.81,Default,,0,0,0,,Сіз не іздедіңіз?
Dialogue: 0,0:16:24.14,0:16:25.56,Default,,0,0,0,,Уф... Джужу
Dialogue: 0,0:16:26.19,0:16:28.52,Default,,0,0,0,,Тоқта... жужу
Dialogue: 0,0:16:28.90,0:16:30.73,Default,,0,0,0,,Оны тоқтатыңыз.
Dialogue: 0,0:16:31.40,0:16:33.65,Default,,0,0,0,,Аузыңды жап! Кя!
Dialogue: 0,0:16:33.78,0:16:35.16,Default,,0,0,0,,Қанша рет айтсаң да түсінбейтін ақымақтар әрқашан болады.
Dialogue: 0,0:16:35.61,0:16:37.74,Default,,0,0,0,,дұрыс
Dialogue: 0,0:16:37.87,0:16:41.62,Default,,0,0,0,,Маған энергияңызды беріңіз
Dialogue: 0,0:16:43.33,0:16:45.29,Default,,0,0,0,,Әй, ә!
Dialogue: 0,0:16:45.92,0:16:46.75,Default,,0,0,0,,Джужу!
Dialogue: 0,0:16:46.96,0:16:52.97,Default,,0,0,0,,Шыу!
Dialogue: 0,0:17:00.72,0:17:01.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:01.81,0:17:02.89,Default,,0,0,0,,Оқу
Dialogue: 0,0:17:03.18,0:17:06.48,Default,,0,0,0,,Адамдарды өз амбицияларыңызға тарту
Dialogue: 0,0:17:06.60,0:17:08.98,Default,,0,0,0,,Өз бағыныштыларыңызды да құрбан етіңіз
Dialogue: 0,0:17:09.11,0:17:10.40,Default,,0,0,0,,Гррр…
Dialogue: 0,0:17:11.36,0:17:16.11,Default,,0,0,0,,Мен сені ешқашан кешіре алмаймын!
Dialogue: 0,0:17:20.95,0:17:24.12,Default,,0,0,0,,Жүр, Йоми, менімен жарыс!
Dialogue: 0,0:17:27.58,0:17:30.92,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:17:31.05,0:17:32.25,Default,,0,0,0,,Спидвагон керемет шығып кетті.
Dialogue: 0,0:17:32.38,0:17:35.76,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:17:36.22,0:17:38.14,Default,,0,0,0,,Бұл жарыс па?
Dialogue: 0,0:17:38.26,0:17:39.97,Default,,0,0,0,,Дұрыс. Соның арқасында мен ұтылдым.
Dialogue: 0,0:17:40.10,0:17:43.10,Default,,0,0,0,,Сізде ғана болатын энергияны сіңіру қабілеті
Dialogue: 0,0:17:43.68,0:17:47.64,Default,,0,0,0,,Мен оны осы мұнараның күші арқылы алдым.
Dialogue: 0,0:17:48.31,0:17:51.69,Default,,0,0,0,,Ойын енді желіде.
Dialogue: 0,0:17:51.86,0:17:54.03,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:17:55.69,0:17:57.11,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:18:03.62,0:18:08.46,Default,,0,0,0,,(Бабил ІІ-нің ыңырануы)
Dialogue: 0,0:18:12.96,0:18:14.38,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:15.84,0:18:18.80,Default,,0,0,0,,Менде қалған соңғы күш...
Dialogue: 0,0:18:18.93,0:18:21.30,Default,,0,0,0,,Гваа...
Dialogue: 0,0:18:22.10,0:18:24.35,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:18:24.47,0:18:28.02,Default,,0,0,0,,Қинал, көп қина, Бабыл II
Dialogue: 0,0:18:28.14,0:18:30.81,Default,,0,0,0,,(Бабил ІІ-нің ыңырануы)
Dialogue: 0,0:18:31.23,0:18:35.82,Default,,0,0,0,,Менің алдымда шіріген, аянышты қабығыңды көрсет!
Dialogue: 0,0:18:35.94,0:18:37.95,Default,,0,0,0,,Аға…
Dialogue: 0,0:18:55.42,0:18:56.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:56.88,0:18:57.71,Default,,0,0,0,,Джужу
Dialogue: 0,0:18:57.84,0:18:58.84,Default,,0,0,0,,Хмм
Dialogue: 0,0:19:00.68,0:19:01.80,Default,,0,0,0,,Ой
Dialogue: 0,0:19:02.26,0:19:05.01,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:19:06.97,0:19:08.48,Default,,0,0,0,,Енді...
Dialogue: 0,0:19:13.52,0:19:16.02,Default,,0,0,0,,Таа!
Dialogue: 0,0:19:21.82,0:19:22.82,Default,,0,0,0,,Ой
Dialogue: 0,0:19:31.83,0:19:34.96,Default,,0,0,0,,(Иомидің күлуі)
Dialogue: 0,0:19:35.17,0:19:36.59,Default,,0,0,0,,Хаха...
Dialogue: 0,0:19:36.71,0:19:37.80,Default,,0,0,0,,Уф
Dialogue: 0,0:19:38.34,0:19:39.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:40.22,0:19:41.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:42.05,0:19:46.01,Default,,0,0,0,,Соңғы күшіңізді таусылған сияқтысыз.
Dialogue: 0,0:19:46.43,0:19:49.93,Default,,0,0,0,,Енді дүние менікі
Dialogue: 0,0:19:50.06,0:19:55.06,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:19:58.15,0:19:59.69,Default,,0,0,0,,Ал енді—
Dialogue: 0,0:20:04.07,0:20:09.83,Default,,0,0,0,,(Иомидің ыңырсыуы)
Dialogue: 0,0:20:37.81,0:20:38.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:47.37,0:20:48.20,Default,,0,0,0,,Уф
Dialogue: 0,0:20:50.08,0:20:51.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:51.41,0:20:52.50,Default,,0,0,0,,Ei
Dialogue: 0,0:20:53.21,0:20:54.79,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:20:55.54,0:20:56.38,Default,,0,0,0,,Ha
Dialogue: 0,0:20:56.67,0:20:58.54,Default,,0,0,0,,Джужу... Джужу
Dialogue: 0,0:20:58.67,0:21:01.21,Default,,0,0,0,,Тек қашуға болады
Dialogue: 0,0:21:01.59,0:21:03.51,Default,,0,0,0,,Жоқ! Оны сонда қалдырмаңыз
Dialogue: 0,0:21:03.63,0:21:05.13,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:21:21.86,0:21:22.69,Default,,0,0,0,,Не!
Dialogue: 0,0:21:23.03,0:21:23.99,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:25.40,0:21:26.74,Default,,0,0,0,,(жарылғыш)
Dialogue: 0,0:21:50.80,0:21:52.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:52.03,0:22:53.91,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:54.24,0:22:56.62,Default,,0,0,0,,Уф...
Dialogue: 0,0:22:57.75,0:22:58.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:02.92,0:23:04.17,Default,,0,0,0,,Джужу
Dialogue: 0,0:24:07.07,0:24:08.73,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:25:17.80,0:25:19.05,Default,,0,0,0,,Сен жақсысың деп үміттенемін.
Dialogue: 0,0:25:19.18,0:25:21.97,Default,,0,0,0,,Және бәрі біткен сияқты.
Dialogue: 0,0:25:22.52,0:25:25.31,Default,,0,0,0,,Қызық, енді бір-бірімізді көрмейміз бе?
Dialogue: 0,0:25:25.85,0:25:28.69,Default,,0,0,0,,Жоқ, мен бір күні тағы кездесетінімізге сенімдімін.
