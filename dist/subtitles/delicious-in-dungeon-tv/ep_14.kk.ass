Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:30.02,0:01:33.86,Default,,0000,0000,0000,,<Жерге оралу жарияланған
Dialogue: 0,0:01:30.02,0:01:33.86,Default,,0000,0000,0000,,Лайос>
Dialogue: 0,0:01:33.86,0:01:37.53,Default,,0000,0000,0000,,Мен сендерді жоғалтқым келмейді.
Dialogue: 0,0:01:33.86,0:01:37.53,Default,,0000,0000,0000,,Барлығы….
Dialogue: 0,0:01:37.53,0:01:40.87,Default,,0000,0000,0000,,<Олар байланыс құрады.
Dialogue: 0,0:01:37.53,0:01:40.87,Default,,0000,0000,0000,,Бірін-бірі растағаннан кейін.
Dialogue: 0,0:01:40.87,0:01:43.37,Default,,0000,0000,0000,,Уақыт сәл артқа кетеді...＞
Dialogue: 0,0:01:45.37,0:01:47.37,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:01:45.37,0:01:47.37,Default,,0000,0000,0000,,Сіздің санаңыз таза ма?
Dialogue: 0,0:01:47.37,0:01:52.55,Default,,0000,0000,0000,,Денеңізде қандай да бір жайсыздықты сезінесіз бе?
Dialogue: 0,0:01:47.37,0:01:52.55,Default,,0000,0000,0000,,Ешқандай проблема жоқ сияқты.
Dialogue: 0,0:01:52.55,0:01:56.88,Default,,0000,0000,0000,,Қан жеткіліксіз болғандықтан
Dialogue: 0,0:01:52.55,0:01:56.88,Default,,0000,0000,0000,,Мен ешкінің қанын қолдандым, бірақ ол мінсіз емес.
Dialogue: 0,0:01:56.88,0:02:00.15,Default,,0000,0000,0000,,Қалаға қайтатын кез келді.
Dialogue: 0,0:02:00.15,0:02:03.49,Default,,0000,0000,0000,,Егер мен суда өлсем ше?
Dialogue: 0,0:02:00.15,0:02:03.49,Default,,0000,0000,0000,,Балық тағамының уақыты келді.
Dialogue: 0,0:02:03.49,0:02:06.99,Default,,0000,0000,0000,,Мені көтерген адамға
Dialogue: 0,0:02:03.49,0:02:06.99,Default,,0000,0000,0000,,Алғыс айту.
Dialogue: 0,0:02:06.99,0:02:10.00,Default,,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:02:06.99,0:02:10.00,Default,,0000,0000,0000,,Куро!
Dialogue: 0,0:02:13.00,0:02:20.84,Default,,0000,0000,0000,,Читтеру иісі…
Dialogue: 0,0:02:13.00,0:02:20.84,Default,,0000,0000,0000,,Элф Таллман Жартылай ергежейлі.
Dialogue: 0,0:02:20.84,0:02:24.54,Default,,0000,0000,0000,,Қазына ұры!
Dialogue: 0,0:02:20.84,0:02:24.54,Default,,0000,0000,0000,,Бұл бәрібір!
Dialogue: 0,0:02:26.51,0:02:30.35,Default,,0000,0000,0000,,А...?
Dialogue: 0,0:02:26.51,0:02:30.35,Default,,0000,0000,0000,,Реанимация үшін ақы алынады.
Dialogue: 0,0:02:30.35,0:02:33.19,Default,,0000,0000,0000,,Мен сені ешкі ақысын кешіремін.
Dialogue: 0,0:02:33.19,0:02:38.86,Default,,0000,0000,0000,,Иә, мен сенімдімін...
Dialogue: 0,0:02:33.19,0:02:38.86,Default,,0000,0000,0000,,Балықшылардың шабуылына...
Dialogue: 0,0:02:38.86,0:02:45.20,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:45.20,0:02:48.03,Default,,0000,0000,0000,,Қайтадан өлген сияқты.
Dialogue: 0,0:02:48.03,0:02:50.04,Default,,0000,0000,0000,,Иә, әрине.
Dialogue: 0,0:02:50.04,0:02:52.54,Default,,0000,0000,0000,,《Шытырман оқиғалы? 》
Dialogue: 0,0:02:55.04,0:02:58.55,Default,,0000,0000,0000,,Сіз...
Dialogue: 0,0:02:55.04,0:02:58.55,Default,,0000,0000,0000,,А? Бұл не?
Dialogue: 0,0:02:58.55,0:03:00.81,Default,,0000,0000,0000,,А... О, жоқ.
Dialogue: 0,0:03:00.81,0:03:04.02,Default,,0000,0000,0000,,Жүр, Намари.
Dialogue: 0,0:03:00.81,0:03:04.02,Default,,0000,0000,0000,,Бұл мен науқас болғанымнан ба!? Мен ондай емеспін! Мен қозғалған жоқпын!
Dialogue: 0,0:03:07.15,0:03:09.82,Default,,0000,0000,0000,,Гномдар да қорғаныс аймағына кіреді ме?
Dialogue: 0,0:03:07.15,0:03:09.82,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:09.82,0:03:13.83,Default,,0000,0000,0000,,Сізде тәртіп жоқ.
Dialogue: 0,0:03:09.82,0:03:13.83,Default,,0000,0000,0000,,Бойыңызға байланысты кіммен араласуға болады➡
Dialogue: 0,0:03:13.83,0:03:16.33,Default,,0000,0000,0000,,Мен ешқашан таңдамаған нәрсемен.
Dialogue: 0,0:03:13.83,0:03:16.33,Default,,0000,0000,0000,,Міне, кеттіңіз.
Dialogue: 0,0:03:16.33,0:03:18.33,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:03:16.33,0:03:18.33,Default,,0000,0000,0000,,​​О?
Dialogue: 0,0:03:18.33,0:03:22.00,Default,,0000,0000,0000,,Тамақ жоқ!
Dialogue: 0,0:03:18.33,0:03:22.00,Default,,0000,0000,0000,,Олар оны тағы ұрлап кетті!
Dialogue: 0,0:03:22.00,0:03:24.17,Default,,0000,0000,0000,,Меши….
Dialogue: 0,0:03:22.00,0:03:24.17,Default,,0000,0000,0000,,Әзіл!
Dialogue: 0,0:03:24.17,0:03:28.51,Default,,0000,0000,0000,,Тағы да...
Dialogue: 0,0:03:24.17,0:03:28.51,Default,,0000,0000,0000,,Ақшаға қол тигізбей тек тамақ?
Dialogue: 0,0:03:28.51,0:03:30.84,Default,,0000,0000,0000,,Мен сенің ақшаң таусылғанын естідім.
Dialogue: 0,0:03:30.84,0:03:34.85,Default,,0000,0000,0000,,Мен ренжідім...
Dialogue: 0,0:03:30.84,0:03:34.85,Default,,0000,0000,0000,,Тоқтау керек.
Dialogue: 0,0:03:34.85,0:03:36.85,Default,,0000,0000,0000,,Не істеуім керек, Кабру?
Dialogue: 0,0:03:36.85,0:03:40.69,Default,,0000,0000,0000,,Хмм... Басқа амалым жоқ. Қалаға қайтайық.
Dialogue: 0,0:03:40.69,0:03:44.19,Default,,0000,0000,0000,,Жоқ! ? Шын айтасың ба?
Dialogue: 0,0:03:40.69,0:03:44.19,Default,,0000,0000,0000,,Қылмыскер бостандықта қалды ма?
Dialogue: 0,0:03:44.19,0:03:47.86,Default,,0000,0000,0000,,Бірақ тамақ жоқ
Dialogue: 0,0:03:44.19,0:03:47.86,Default,,0000,0000,0000,,Ары қарай жүре алмайсың.
Dialogue: 0,0:03:47.86,0:03:52.53,Default,,0000,0000,0000,,Менің күшім жетпегенін мойындаймын.
Dialogue: 0,0:03:47.86,0:03:52.53,Default,,0000,0000,0000,,Сол адамдар айтқандай➡
Dialogue: 0,0:03:52.53,0:03:55.54,Default,,0000,0000,0000,,Тек өмір бар
Dialogue: 0,0:03:52.53,0:03:55.54,Default,,0000,0000,0000,,Мен алғыс айтуым керек.
Dialogue: 0,0:03:57.54,0:04:01.64,Default,,0000,0000,0000,,Егер Кабру солай шешсе, мен оған еремін.
Dialogue: 0,0:03:57.54,0:04:01.64,Default,,0000,0000,0000,,Мен де.
Dialogue: 0,0:04:01.64,0:04:04.98,Default,,0000,0000,0000,,Мен қылмыскерді табудан бас тартуым керек.
Dialogue: 0,0:04:01.64,0:04:04.98,Default,,0000,0000,0000,,Егер уәде берсеңіз➡
Dialogue: 0,0:04:04.98,0:04:08.82,Default,,0000,0000,0000,,Бұл маған да жақсы.
Dialogue: 0,0:04:04.98,0:04:08.82,Default,,0000,0000,0000,,Уәде беремін, Рин.
Dialogue: 0,0:04:08.82,0:04:14.15,Default,,0000,0000,0000,,Куроха Микбеллдің ізбасары.
Dialogue: 0,0:04:08.82,0:04:14.15,Default,,0000,0000,0000,,Гунуну... Ха.
Dialogue: 0,0:04:14.15,0:04:17.86,Default,,0000,0000,0000,,Бұл іздеу қызыл түсте.
Dialogue: 0,0:04:25.67,0:04:28.17,Default,,0000,0000,0000,,Тұман шықты.
Dialogue: 0,0:04:28.17,0:04:30.67,Default,,0000,0000,0000,,Барлығыңыз сақ болыңыздар...
Dialogue: 0,0:04:34.34,0:04:37.18,Default,,0000,0000,0000,,《Бұл кенеттен тұман емес!
Dialogue: 0,0:04:37.18,0:04:40.18,Default,,0000,0000,0000,,Бұл жындардың ісі ме? 》
Dialogue: 0,0:04:40.18,0:04:42.35,Default,,0000,0000,0000,,⚟Ааа...
Dialogue: 0,0:04:42.35,0:04:46.35,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:04:46.35,0:04:49.36,Default,,0000,0000,0000,,《Балықшы?
Dialogue: 0,0:04:49.36,0:04:52.69,Default,,0000,0000,0000,,Мен мұны білмей тұрып, өте көп болды ...
Dialogue: 0,0:04:52.69,0:04:54.69,Default,,0000,0000,0000,,Боқ, мен мұны істеуім керек...》
Dialogue: 0,0:04:54.69,0:04:56.86,Default,,0000,0000,0000,,О!
Dialogue: 0,0:04:54.69,0:04:56.86,Default,,0000,0000,0000,,《Келемін! 》
Dialogue: 0,0:04:56.86,0:04:59.37,Default,,0000,0000,0000,,О!
Dialogue: 0,0:04:56.86,0:04:59.37,Default,,0000,0000,0000,,Кух….
Dialogue: 0,0:04:59.37,0:05:01.30,Default,,0000,0000,0000,,Пя.
Dialogue: 0,0:04:59.37,0:05:01.30,Default,,0000,0000,0000,,《О? 》
Dialogue: 0,0:05:01.30,0:05:03.30,Default,,0000,0000,0000,,О!
Dialogue: 0,0:05:03.30,0:05:06.81,Default,,0000,0000,0000,,《Бұл сыпырып кетеді
Dialogue: 0,0:05:03.30,0:05:06.81,Default,,0000,0000,0000,,Балта қалай қолданылады!
Dialogue: 0,0:05:06.81,0:05:10.64,Default,,0000,0000,0000,,Бұл шайқау тәсілі
Dialogue: 0,0:05:06.81,0:05:10.64,Default,,0000,0000,0000,,Мен өте жақсы білемін.
Dialogue: 0,0:05:10.64,0:05:14.65,Default,,0000,0000,0000,,Иә, бұл...! 》
Dialogue: 0,0:05:14.65,0:05:18.32,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:05:18.32,0:05:21.32,Default,,0000,0000,0000,,Гах! Гах!
Dialogue: 0,0:05:18.32,0:05:21.32,Default,,0000,0000,0000,,Тынш, жарайды.
Dialogue: 0,0:05:21.32,0:05:24.82,Default,,0000,0000,0000,,Сабыр ет, Диа, менмін.
Dialogue: 0,0:05:27.99,0:05:30.50,Default,,0000,0000,0000,,《Бұл тұман – иллюзия сиқыры.
Dialogue: 0,0:05:30.50,0:05:33.83,Default,,0000,0000,0000,,Тартылған қарумен
Dialogue: 0,0:05:30.50,0:05:33.83,Default,,0000,0000,0000,,Куро – абдырап қалған адам.
Dialogue: 0,0:05:33.83,0:05:36.50,Default,,0000,0000,0000,,Мына Холм сол жерде аң-таң болып тұрғаны ма?
Dialogue: 0,0:05:36.50,0:05:40.01,Default,,0000,0000,0000,,Бір уақытта көп нәрсе болған кезде
Dialogue: 0,0:05:36.50,0:05:40.01,Default,,0000,0000,0000,,Қатаюға бейімділігі бар.
Dialogue: 0,0:05:40.01,0:05:42.84,Default,,0000,0000,0000,,Мик ертерек қашып кеткен болуы керек.
Dialogue: 0,0:05:42.84,0:05:46.68,Default,,0000,0000,0000,,Қазірге дейін мен—
Dialogue: 0,0:05:42.84,0:05:46.68,Default,,0000,0000,0000,,Дәл қазір ең қауіптісі...
Dialogue: 0,0:05:46.68,0:05:48.68,Default,,0000,0000,0000,,Рин!
Dialogue: 0,0:05:48.68,0:05:50.85,Default,,0000,0000,0000,,Қараңызшы, ән айтып жатыр.
Dialogue: 0,0:05:50.85,0:05:54.85,Default,,0000,0000,0000,,Мұнда оның барлығы бар
Dialogue: 0,0:05:50.85,0:05:54.85,Default,,0000,0000,0000,,Үймелі түрде көмір жасауға болады.
Dialogue: 0,0:05:54.85,0:05:58.56,Default,,0000,0000,0000,,Сиқыршының әні
Dialogue: 0,0:05:54.85,0:05:58.56,Default,,0000,0000,0000,,Оны бейбіт жолмен тоқтату үшін…》
Dialogue: 0,0:06:01.96,0:06:05.47,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:06:01.96,0:06:05.47,Default,,0000,0000,0000,,Линша.
Dialogue: 0,0:06:05.47,0:06:09.30,Default,,0000,0000,0000,,Көрдіңіз бе, бұл галлюцинация.
Dialogue: 0,0:06:09.30,0:06:13.47,Default,,0000,0000,0000,,《Құбыжық сияқты көрінетіні ұят.
Dialogue: 0,0:06:09.30,0:06:13.47,Default,,0000,0000,0000,,Қазір….
Dialogue: 0,0:06:13.47,0:06:16.48,Default,,0000,0000,0000,,Бұл сиқырлы тұманды тоқтату үшін...》
Dialogue: 0,0:06:16.48,0:06:19.48,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:06:16.48,0:06:19.48,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:06:19.48,0:06:21.65,Default,,0000,0000,0000,,Мм... Ааа.
Dialogue: 0,0:06:21.65,0:06:23.65,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:06:23.65,0:06:26.82,Default,,0000,0000,0000,,Гуаааааа!
Dialogue: 0,0:06:26.82,0:06:28.99,Default,,0000,0000,0000,,《Бұл жігіт басқаша.
Dialogue: 0,0:06:28.99,0:06:32.49,Default,,0000,0000,0000,,Сізге қарумен кім келеді?
Dialogue: 0,0:06:28.99,0:06:32.49,Default,,0000,0000,0000,,Кастер емес.
Dialogue: 0,0:06:32.49,0:06:36.00,Default,,0000,0000,0000,,Артқа қадамнан
Dialogue: 0,0:06:32.49,0:06:36.00,Default,,0000,0000,0000,,Саған қарап.
Dialogue: 0,0:06:36.00,0:06:38.10,Default,,0000,0000,0000,,Ол! 》
Dialogue: 0,0:06:36.00,0:06:38.10,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:06:40.17,0:06:43.17,Default,,0000,0000,0000,,Уау! Уау! Уау!
Dialogue: 0,0:06:50.18,0:06:56.52,Default,,0000,0000,0000,,Бәрі бітті, берілемін.
Dialogue: 0,0:06:50.18,0:06:56.52,Default,,0000,0000,0000,,Мені жіберуіңізді өтінемін.
Dialogue: 0,0:06:56.52,0:06:58.52,Default,,0000,0000,0000,,Бұл жігіттер...
Dialogue: 0,0:06:58.52,0:07:01.29,Default,,0000,0000,0000,,Біз жоғарыда кездескен мәйітті жинаушы!
Dialogue: 0,0:07:01.29,0:07:04.46,Default,,0000,0000,0000,,Бұл кездесу кездейсоқ емес сияқты.
Dialogue: 0,0:07:04.46,0:07:07.79,Default,,0000,0000,0000,,Менің артымнан ердің деп ойлаймын.
Dialogue: 0,0:07:04.46,0:07:07.79,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:07:07.79,0:07:11.13,Default,,0000,0000,0000,,Мәйіттерді тереңірек қабаттап алған дұрыс.
Dialogue: 0,0:07:07.79,0:07:11.13,Default,,0000,0000,0000,,Бұл тиімді.
Dialogue: 0,0:07:11.13,0:07:13.97,Default,,0000,0000,0000,,Арал гранттарымен.
Dialogue: 0,0:07:13.97,0:07:17.64,Default,,0000,0000,0000,,Ұрланған олжаны аламыз
Dialogue: 0,0:07:13.97,0:07:17.64,Default,,0000,0000,0000,,Оны қайтаруға тырысу➡
Dialogue: 0,0:07:17.64,0:07:20.81,Default,,0000,0000,0000,,Сіз өзіңізге сәйкес келмейтін деңгейге өттіңіз.
Dialogue: 0,0:07:20.81,0:07:22.81,Default,,0000,0000,0000,,Бар болғаны баяу орындаңыз➡
Dialogue: 0,0:07:22.81,0:07:26.81,Default,,0000,0000,0000,,Пайдалы мәйіт.
Dialogue: 0,0:07:22.81,0:07:26.81,Default,,0000,0000,0000,,Хаха….
Dialogue: 0,0:07:26.81,0:07:30.32,Default,,0000,0000,0000,,Мен ренжідім...
Dialogue: 0,0:07:26.81,0:07:30.32,Default,,0000,0000,0000,,Бұл сәл баяу болды.
Dialogue: 0,0:07:30.32,0:07:32.99,Default,,0000,0000,0000,,Мен оны тапқанша
Dialogue: 0,0:07:30.32,0:07:32.99,Default,,0000,0000,0000,,Біз жандандық➡
Dialogue: 0,0:07:32.99,0:07:35.66,Default,,0000,0000,0000,,Ол жерге қайтатын болды.
Dialogue: 0,0:07:35.66,0:07:38.66,Default,,0000,0000,0000,,Шыдамсыз адамдар
Dialogue: 0,0:07:35.66,0:07:38.66,Default,,0000,0000,0000,,Мәжбүрлеу шаралары қолданылды.
Dialogue: 0,0:07:38.66,0:07:42.66,Default,,0000,0000,0000,,Иллюзия сиқырымен бір-бірін өлтіру...
Dialogue: 0,0:07:38.66,0:07:42.66,Default,,0000,0000,0000,,Бұл сәл басқаша.
Dialogue: 0,0:07:42.66,0:07:45.67,Default,,0000,0000,0000,,Шындығында, балалар
Dialogue: 0,0:07:42.66,0:07:45.67,Default,,0000,0000,0000,,Ұрыны қуып жету➡
Dialogue: 0,0:07:45.67,0:07:50.34,Default,,0000,0000,0000,,Бір-бірімізді өлтірсек
Dialogue: 0,0:07:45.67,0:07:50.34,Default,,0000,0000,0000,,Бұл ең жақсы болды. Әттең.
Dialogue: 0,0:07:50.34,0:07:54.34,Default,,0000,0000,0000,,Бұлай тез болады деп күтпедім.
Dialogue: 0,0:07:50.34,0:07:54.34,Default,,0000,0000,0000,,Құбыжықтың шабуылынан өлгім келмейді.
Dialogue: 0,0:07:54.34,0:07:56.51,Default,,0000,0000,0000,,Бұл жігіт!
Dialogue: 0,0:07:54.34,0:07:56.51,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,0:07:56.51,0:08:02.45,Default,,0000,0000,0000,,Ұрлық пен авантюристер арасындағы төбелес ауыр қылмыс болып табылады.
Dialogue: 0,0:07:56.51,0:08:02.45,Default,,0000,0000,0000,,Мен арал иесіне есеп беремін.
Dialogue: 0,0:08:02.45,0:08:06.12,Default,,0000,0000,0000,,Аа... Келісім жасаймыз ба?
Dialogue: 0,0:08:06.12,0:08:09.29,Default,,0000,0000,0000,,Үйге осылай қайт.
Dialogue: 0,0:08:06.12,0:08:09.29,Default,,0000,0000,0000,,Балалар сендер де ұтылып қалдыңдар.
Dialogue: 0,0:08:09.29,0:08:12.96,Default,,0000,0000,0000,,Біздің достарымыз сияқты
Dialogue: 0,0:08:09.29,0:08:12.96,Default,,0000,0000,0000,,Онда екі адам өсіп жатыр.
Dialogue: 0,0:08:12.96,0:08:18.63,Default,,0000,0000,0000,,Оларды реанимация станциясына апарыңыз.
Dialogue: 0,0:08:12.96,0:08:18.63,Default,,0000,0000,0000,,Сіз лайықты ақша алуыңыз керек.
Dialogue: 0,0:08:18.63,0:08:20.83,Default,,0000,0000,0000,,Олар ес-түссіз.
Dialogue: 0,0:08:23.14,0:08:25.97,Default,,0000,0000,0000,,Сізге балықшы шабуыл жасағаны туралы куәлік беріңіз.
Dialogue: 0,0:08:25.97,0:08:32.65,Default,,0000,0000,0000,,Біздің үлесіміз...
Dialogue: 0,0:08:25.97,0:08:32.65,Default,,0000,0000,0000,,Дұрыс... 4 Жоқ, 30% жақсы.
Dialogue: 0,0:08:32.65,0:08:36.05,Default,,0000,0000,0000,,Сіз қалай ойлайсыз? Бұлай айтудың еш зияны жоқ.
Dialogue: 0,0:08:37.98,0:08:41.99,Default,,0000,0000,0000,,Жарайды, жақсы.
Dialogue: 0,0:08:41.99,0:08:43.99,Default,,0000,0000,0000,,Кабру….
Dialogue: 0,0:08:50.66,0:08:52.67,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:08:54.67,0:08:56.67,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:08:54.67,0:08:56.67,Default,,0000,0000,0000,,Не... Теми.
Dialogue: 0,0:08:56.67,0:09:00.07,Default,,0000,0000,0000,,Мен солай деп ойлаймын.
Dialogue: 0,0:08:56.67,0:09:00.07,Default,,0000,0000,0000,,Бұл болуы керек!
Dialogue: 0,0:09:02.44,0:09:04.44,Default,,0000,0000,0000,,Незуко! Мен төмен түсемін
Dialogue: 0,0:09:02.44,0:09:04.44,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:09:08.95,0:09:10.95,Default,,0000,0000,0000,,Хе хи!
Dialogue: 0,0:09:10.95,0:09:14.29,Default,,0000,0000,0000,,Фу Адамның оңай болғаны жақсы.
Dialogue: 0,0:09:14.29,0:09:18.96,Default,,0000,0000,0000,,Ұзын адамдар, гномдар және гномдар
Dialogue: 0,0:09:14.29,0:09:18.96,Default,,0000,0000,0000,,Барлығының негізгі ойлары бірдей➡
Dialogue: 0,0:09:18.96,0:09:21.46,Default,,0000,0000,0000,,Денеңізді қозғалту тәсілі бірдей.
Dialogue: 0,0:09:21.46,0:09:24.46,Default,,0000,0000,0000,,Егер құбыжықтар осындай болса, оңайырақ болар еді.
Dialogue: 0,0:09:21.46,0:09:24.46,Default,,0000,0000,0000,,Hiii….
Dialogue: 0,0:09:24.46,0:09:27.47,Default,,0000,0000,0000,,Хромикалық
Dialogue: 0,0:09:24.46,0:09:27.47,Default,,0000,0000,0000,,Сіз мені таба аласыз ба?
Dialogue: 0,0:09:27.47,0:09:29.80,Default,,0000,0000,0000,,Қосулы!
Dialogue: 0,0:09:27.47,0:09:29.80,Default,,0000,0000,0000,,Кабру.
Dialogue: 0,0:09:27.47,0:09:29.80,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:09:29.80,0:09:31.80,Default,,0000,0000,0000,,Бұл жігітпен не істеуіміз керек?
Dialogue: 0,0:09:31.80,0:09:35.47,Default,,0000,0000,0000,,Өтінемін! Оны жіберіп алмаңыз!
Dialogue: 0,0:09:31.80,0:09:35.47,Default,,0000,0000,0000,,Мен ештеңе білмедім!
Dialogue: 0,0:09:35.47,0:09:41.81,Default,,0000,0000,0000,,Фу... Мен де лабиринттің қарғысын бұзуды жоспарлап отырмын.
Dialogue: 0,0:09:35.47,0:09:41.81,Default,,0000,0000,0000,,Құбыжықтарды жоюға ерік-жігер жоқ.
Dialogue: 0,0:09:41.81,0:09:46.49,Default,,0000,0000,0000,,Басқа адамнан алу арқылы
Dialogue: 0,0:09:41.81,0:09:46.49,Default,,0000,0000,0000,,Күнкөріспен айналысатындар көбейіп келеді.
Dialogue: 0,0:09:46.49,0:09:51.82,Default,,0000,0000,0000,,Бұл қарқынмен ешбір есі дұрыс адам жасай алмайды
Dialogue: 0,0:09:46.49,0:09:51.82,Default,,0000,0000,0000,,Аралдан шығады.
Dialogue: 0,0:09:51.82,0:09:55.66,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:09:51.82,0:09:55.66,Default,,0000,0000,0000,,Мен сен сияқты адамдарды кешіре алмаймын.
Dialogue: 0,0:09:55.66,0:09:57.66,Default,,0000,0000,0000,,Please stop...
Dialogue: 0,0:09:57.66,0:09:59.67,Default,,0000,0000,0000,,А... аа....
Dialogue: 0,0:09:59.67,0:10:02.17,Default,,0000,0000,0000,,Құдай-ай!
Dialogue: 0,0:10:09.84,0:10:11.84,Default,,0000,0000,0000,,(Көлге құлау дыбысы)
Dialogue: 0,0:10:15.35,0:10:17.35,Default,,0000,0000,0000,,Кабру.
Dialogue: 0,0:10:15.35,0:10:17.35,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:17.35,0:10:19.85,Default,,0000,0000,0000,,Аа, бұрын болғаны үшін кешіріңіз.
Dialogue: 0,0:10:19.85,0:10:22.05,Default,,0000,0000,0000,,Бірден
Dialogue: 0,0:10:19.85,0:10:22.05,Default,,0000,0000,0000,,Менің қолымнан келетіні осы.
Dialogue: 0,0:10:24.02,0:10:28.19,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз? ? мен білмеймін!
Dialogue: 0,0:10:24.02,0:10:28.19,Default,,0000,0000,0000,,Қызық емес!
Dialogue: 0,0:10:24.02,0:10:28.19,Default,,0000,0000,0000,,жақсы болар еді.
Dialogue: 0,0:10:28.19,0:10:32.87,Default,,0000,0000,0000,,Мен тым қобалжыдым
Dialogue: 0,0:10:28.19,0:10:32.87,Default,,0000,0000,0000,,Мен алға жылжи алмайтын сияқтымын.
Dialogue: 0,0:10:32.87,0:10:37.87,Default,,0000,0000,0000,,Иә, бұл менің асығыстықтың жемісі.
Dialogue: 0,0:10:32.87,0:10:37.87,Default,,0000,0000,0000,,Ең нашар.
Dialogue: 0,0:10:37.87,0:10:40.37,Default,,0000,0000,0000,,Кейде
Dialogue: 0,0:10:37.87,0:10:40.37,Default,,0000,0000,0000,,Көтерілген жақсы емес пе?
Dialogue: 0,0:10:40.37,0:10:44.88,Default,,0000,0000,0000,,Алдау туралы ештеңе істей алмайсыз, солай ма?
Dialogue: 0,0:10:40.37,0:10:44.88,Default,,0000,0000,0000,,Бұл біздің қазіргі қолымыз.
Dialogue: 0,0:10:44.88,0:10:47.71,Default,,0000,0000,0000,,Хаха... Арал иесі лабиринтте➡
Dialogue: 0,0:10:47.71,0:10:50.22,Default,,0000,0000,0000,,Тек «пайдалы тесік»
Dialogue: 0,0:10:47.71,0:10:50.22,Default,,0000,0000,0000,,Мен бұл туралы ойламаймын.
Dialogue: 0,0:10:50.22,0:10:55.39,Default,,0000,0000,0000,,Алтын-күміс бітсе де, Құбыжық терісі мен сүйегі бар
Dialogue: 0,0:10:50.22,0:10:55.39,Default,,0000,0000,0000,,Мен күнкөрісімді өтей аламын деп ойлаймын.
Dialogue: 0,0:10:55.39,0:10:59.56,Default,,0000,0000,0000,,Бірақ іс жүзінде ол толығымен зерттелді.
Dialogue: 0,0:10:55.39,0:10:59.56,Default,,0000,0000,0000,,Лабиринтке ешкім сүңгімейді.
Dialogue: 0,0:10:59.56,0:11:02.16,Default,,0000,0000,0000,,Мүмкін тез байып кетемін деген арманым болмағандықтан болар➡
Dialogue: 0,0:11:02.16,0:11:05.33,Default,,0000,0000,0000,,Шытырман оқиға рухы
Dialogue: 0,0:11:02.16,0:11:05.33,Default,,0000,0000,0000,,Менің қытықтай алмағанымнан шығар...
Dialogue: 0,0:11:05.33,0:11:08.67,Default,,0000,0000,0000,,Адам саны азаяды, адам саны одан әрі азаяды.
Dialogue: 0,0:11:08.67,0:11:12.34,Default,,0000,0000,0000,,Лабиринттен құбыжықтар толып жатыр
Dialogue: 0,0:11:08.67,0:11:12.34,Default,,0000,0000,0000,,Тұрғындарды азапқа салу.
Dialogue: 0,0:11:12.34,0:11:17.01,Default,,0000,0000,0000,,Осылайша көптеген ауылдар
Dialogue: 0,0:11:12.34,0:11:17.01,Default,,0000,0000,0000,,Ол қирап қалды.
Dialogue: 0,0:11:17.01,0:11:19.85,Default,,0000,0000,0000,,Лабиринттің қарғысы тезірек жойылуы керек.
Dialogue: 0,0:11:19.85,0:11:23.65,Default,,0000,0000,0000,,Бұл дүниеде құбыжықтар мен лабиринттердің қажеті жоқ.
Dialogue: 0,0:11:19.85,0:11:23.65,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:11:26.19,0:11:30.36,Default,,0000,0000,0000,,Менің қарным ашты...
Dialogue: 0,0:11:26.19,0:11:30.36,Default,,0000,0000,0000,,Жанданған соң бірден аштық сезінесіз.
Dialogue: 0,0:11:30.36,0:11:32.53,Default,,0000,0000,0000,,Кабру! Каблу!
Dialogue: 0,0:11:30.36,0:11:32.53,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:11:32.53,0:11:35.53,Default,,0000,0000,0000,,Мына балалар жақсы.
Dialogue: 0,0:11:32.53,0:11:35.53,Default,,0000,0000,0000,,Менде құнды нәрсе бар!
Dialogue: 0,0:11:35.53,0:11:38.36,Default,,0000,0000,0000,,Жарайды, маған тамақ беріңіз➡
Dialogue: 0,0:11:38.36,0:11:41.53,Default,,0000,0000,0000,,Қалғандарын суға батырыңыз.
Dialogue: 0,0:11:38.36,0:11:41.53,Default,,0000,0000,0000,,Ха! ? Батып кетсін! ?
Dialogue: 0,0:11:41.53,0:11:46.87,Default,,0000,0000,0000,,А... соны бастайық.
Dialogue: 0,0:11:41.53,0:11:46.87,Default,,0000,0000,0000,,Біз де солар сияқтымыз.
Dialogue: 0,0:11:46.87,0:11:50.04,Default,,0000,0000,0000,,Бұл орындалғаннан кейін
Dialogue: 0,0:11:46.87,0:11:50.04,Default,,0000,0000,0000,,Жеңіл тамақ ішеміз бе?
Dialogue: 0,0:11:50.04,0:11:52.04,Default,,0000,0000,0000,,Қалай болғанда да, бұл қаһармандарды өлтіру миссиясын соңына дейін жеткізетін мен боламын.
Dialogue: 0,0:11:56.05,0:11:58.05,Default,,0000,0000,0000,,Мен оны аламын.
Dialogue: 0,0:11:58.05,0:11:59.99,Default,,0000,0000,0000,,Хмм... Дәмді!
Dialogue: 0,0:11:59.99,0:12:03.82,Default,,0000,0000,0000,,Сіз жақсы тамақ жеп жатырсыз.
Dialogue: 0,0:11:59.99,0:12:03.82,Default,,0000,0000,0000,,Мәйіттерді алып кету тиімді.
Dialogue: 0,0:12:03.82,0:12:07.16,Default,,0000,0000,0000,,Мәйітті өзіңіз жасаңыз
Dialogue: 0,0:12:03.82,0:12:07.16,Default,,0000,0000,0000,,Мен оны өзіммен бірге үйге апарамын...
Dialogue: 0,0:12:07.16,0:12:09.66,Default,,0000,0000,0000,,Тіпті аралдың иесі де байқамайды.
Dialogue: 0,0:12:09.66,0:12:13.17,Default,,0000,0000,0000,,Әзірше аралдың сыйлығы
Dialogue: 0,0:12:09.66,0:12:13.17,Default,,0000,0000,0000,,Емтихан болатын сияқты➡
Dialogue: 0,0:12:13.17,0:12:16.37,Default,,0000,0000,0000,,Олар
Dialogue: 0,0:12:13.17,0:12:16.37,Default,,0000,0000,0000,,Сіз өте жақсы орындаған сияқтысыз.
Dialogue: 0,0:12:18.50,0:12:22.84,Default,,0000,0000,0000,,немесе кооперативтік қатынаста
Dialogue: 0,0:12:18.50,0:12:22.84,Default,,0000,0000,0000,,Басқа партиялардың күтпеген көп саны бар ма?
Dialogue: 0,0:12:22.84,0:12:27.18,Default,,0000,0000,0000,,Ол шірік.
Dialogue: 0,0:12:22.84,0:12:27.18,Default,,0000,0000,0000,,Сіз тек өзіңізді тұншықтырып жатырсыз.
Dialogue: 0,0:12:27.18,0:12:29.18,Default,,0000,0000,0000,,Арал иесіне есеп беру керек пе?
Dialogue: 0,0:12:29.18,0:12:32.85,Default,,0000,0000,0000,,Бұл арал иесінің жақсы шешімі бар.
Dialogue: 0,0:12:29.18,0:12:32.85,Default,,0000,0000,0000,,Шығады деп ойламаймын.
Dialogue: 0,0:12:32.85,0:12:36.02,Default,,0000,0000,0000,,Бұл жай ғана Дони сияқты жаңадан келген ойыншы.
Dialogue: 0,0:12:36.02,0:12:39.86,Default,,0000,0000,0000,,Әлгі ақымақ арал иесі
Dialogue: 0,0:12:36.02,0:12:39.86,Default,,0000,0000,0000,,Салмақ қосып, жарылып кете беремін бе деп ойлаймын.
Dialogue: 0,0:12:39.86,0:12:42.70,Default,,0000,0000,0000,,Сонда пері сізге ұшып келеді.
Dialogue: 0,0:12:42.70,0:12:46.37,Default,,0000,0000,0000,,Әлі де толқын суы ретінде пайдаланылады
Dialogue: 0,0:12:42.70,0:12:46.37,Default,,0000,0000,0000,,Ұстау керек.
Dialogue: 0,0:12:46.37,0:12:52.37,Default,,0000,0000,0000,,Сонда да Таллман мен Гном
Dialogue: 0,0:12:46.37,0:12:52.37,Default,,0000,0000,0000,,Жартылай және пері...?
Dialogue: 0,0:12:52.37,0:12:54.54,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:12:52.37,0:12:54.54,Default,,0000,0000,0000,,Бізге➡
Dialogue: 0,0:12:54.54,0:12:57.04,Default,,0000,0000,0000,,Жын шығару өнері
Dialogue: 0,0:12:54.54,0:12:57.04,Default,,0000,0000,0000,,Оны маған берген партия.
Dialogue: 0,0:12:57.04,0:13:01.15,Default,,0000,0000,0000,,Әй, зергер ұры.
Dialogue: 0,0:12:57.04,0:13:01.15,Default,,0000,0000,0000,,Меширобу.
Dialogue: 0,0:13:01.15,0:13:03.82,Default,,0000,0000,0000,,Пері бар партия дегеніміз не?
Dialogue: 0,0:13:01.15,0:13:03.82,Default,,0000,0000,0000,,Көп емес.
Dialogue: 0,0:13:03.82,0:13:06.15,Default,,0000,0000,0000,,Егер сіз оны аздап қысқартсаңыз, оны анықтай аласыз.
Dialogue: 0,0:13:06.15,0:13:08.65,Default,,0000,0000,0000,,Мен бұл Дони мен Фионнир болады деп күтпедім! ?
Dialogue: 0,0:13:08.65,0:13:12.66,Default,,0000,0000,0000,,Дони және басқалары үшінші жертөле қабатына
Dialogue: 0,0:13:08.65,0:13:12.66,Default,,0000,0000,0000,,Оның келгенін елестету қиын шығар.
Dialogue: 0,0:13:12.66,0:13:15.33,Default,,0000,0000,0000,,Төрт адамнан тұратын топ деп те аталады.
Dialogue: 0,0:13:12.66,0:13:15.33,Default,,0000,0000,0000,,Ол ұсталады.
Dialogue: 0,0:13:15.33,0:13:17.66,Default,,0000,0000,0000,,Бұл сүңгудің ақылсыз әдісі.
Dialogue: 0,0:13:17.66,0:13:22.00,Default,,0000,0000,0000,,Лин Холм Бұл жын шығару техникасын қараңыз.
Dialogue: 0,0:13:17.66,0:13:22.00,Default,,0000,0000,0000,,Не байқадың?
Dialogue: 0,0:13:22.00,0:13:25.84,Default,,0000,0000,0000,,Сіз оны әлі киіп жүрсіз бе? ?
Dialogue: 0,0:13:22.00,0:13:25.84,Default,,0000,0000,0000,,Бұл жай ғана дәлел.
Dialogue: 0,0:13:25.84,0:13:28.34,Default,,0000,0000,0000,,Мен мұндай техниканы түсінбеймін.
Dialogue: 0,0:13:28.34,0:13:30.84,Default,,0000,0000,0000,,Маған көрсет.
Dialogue: 0,0:13:34.68,0:13:38.52,Default,,0000,0000,0000,,Үздік студент.
Dialogue: 0,0:13:34.68,0:13:38.52,Default,,0000,0000,0000,,Оқулықтағы сипаттама сияқты сезіледі.
Dialogue: 0,0:13:38.52,0:13:41.19,Default,,0000,0000,0000,,Сондай-ақ, мен үйренбеген шығармын.
Dialogue: 0,0:13:41.19,0:13:43.69,Default,,0000,0000,0000,,Негізі ол сиқырлы мектептен шыққан болуы мүмкін.
Dialogue: 0,0:13:43.69,0:13:47.36,Default,,0000,0000,0000,,Мына балалар
Dialogue: 0,0:13:43.69,0:13:47.36,Default,,0000,0000,0000,,Барлығы ұқсас өрнектер жазады.
Dialogue: 0,0:13:47.36,0:13:50.36,Default,,0000,0000,0000,,Бұл эльфтер жазған әдіс екені сөзсіз.
Dialogue: 0,0:13:50.36,0:13:52.87,Default,,0000,0000,0000,,Сиқырлы мектеп….
Dialogue: 0,0:13:52.87,0:13:58.87,Default,,0000,0000,0000,,Ей, сиқырлы мектеп... Түсіндім.
Dialogue: 0,0:13:52.87,0:13:58.87,Default,,0000,0000,0000,,Не? Бұл не?
Dialogue: 0,0:13:58.87,0:14:01.64,Default,,0000,0000,0000,,Жоқ...
Dialogue: 0,0:13:58.87,0:14:01.64,Default,,0000,0000,0000,,Менде аздап түсінік бар.
Dialogue: 0,0:14:01.64,0:14:04.64,Default,,0000,0000,0000,,Бұл жай ғана болжам.
Dialogue: 0,0:14:04.64,0:14:07.15,Default,,0000,0000,0000,,Мен мұны дұрыс түсінсем, қуанар едім.
Dialogue: 0,0:14:07.15,0:14:11.15,Default,,0000,0000,0000,,Бұл не? Бұл тым үлкен.
Dialogue: 0,0:14:07.15,0:14:11.15,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:14:11.15,0:14:13.82,Default,,0000,0000,0000,,Бұл Торден ағасы мен әпкесінің кеші.
Dialogue: 0,0:14:13.82,0:14:15.99,Default,,0000,0000,0000,,Торден ше?
Dialogue: 0,0:14:15.99,0:14:19.83,Default,,0000,0000,0000,,Қылмыс жасау
Dialogue: 0,0:14:15.99,0:14:19.83,Default,,0000,0000,0000,,Олай емес сияқты, бірақ оның негізі неде?
Dialogue: 0,0:14:19.83,0:14:24.83,Default,,0000,0000,0000,,Біріншіден, Төденнің сіңлісі
Dialogue: 0,0:14:19.83,0:14:24.83,Default,,0000,0000,0000,,Ол сиқырлы мектептен шыққан болуы керек!
Dialogue: 0,0:14:24.83,0:14:29.67,Default,,0000,0000,0000,,Саған тұмар құйған адам пері болды, солай ма?
Dialogue: 0,0:14:24.83,0:14:29.67,Default,,0000,0000,0000,,Бұл ағалар Таллмен емес.
Dialogue: 0,0:14:29.67,0:14:32.34,Default,,0000,0000,0000,,Жақсы, жақсы
Dialogue: 0,0:14:29.67,0:14:32.34,Default,,0000,0000,0000,,Соңына дейін тыңдаңыз.
Dialogue: 0,0:14:32.34,0:14:36.34,Default,,0000,0000,0000,,Кештегі пері
Dialogue: 0,0:14:32.34,0:14:36.34,Default,,0000,0000,0000,,Сіз әпкеңізбен өте жақынсыз.
Dialogue: 0,0:14:36.34,0:14:39.85,Default,,0000,0000,0000,,Міне
Dialogue: 0,0:14:36.34,0:14:39.85,Default,,0000,0000,0000,,Ескі балалық достар сияқты.
Dialogue: 0,0:14:39.85,0:14:43.85,Default,,0000,0000,0000,,Сол сиқырлы мектепте
Dialogue: 0,0:14:39.85,0:14:43.85,Default,,0000,0000,0000,,Мен онымен өскен шығармын.
Dialogue: 0,0:14:43.85,0:14:47.02,Default,,0000,0000,0000,,Сиқырлы мектепті кім бітірді?
Dialogue: 0,0:14:43.85,0:14:47.02,Default,,0000,0000,0000,,Мұнда алаңдамаңыз.
Dialogue: 0,0:14:47.02,0:14:49.36,Default,,0000,0000,0000,,Перілерді былай қойғанда.
Dialogue: 0,0:14:49.36,0:14:53.86,Default,,0000,0000,0000,,Ешқайсысы жоқ екеніне сенімдімін.
Dialogue: 0,0:14:49.36,0:14:53.86,Default,,0000,0000,0000,,Күтілгендей, бәрі осы.
Dialogue: 0,0:14:53.86,0:14:57.03,Default,,0000,0000,0000,,Біріншіден, Таллманның иісі
Dialogue: 0,0:14:53.86,0:14:57.03,Default,,0000,0000,0000,,Бұл бір адамға арналған, солай ма?
Dialogue: 0,0:14:57.03,0:14:59.87,Default,,0000,0000,0000,,Егер олар ағайынды болса
Dialogue: 0,0:14:57.03,0:14:59.87,Default,,0000,0000,0000,,Екі адамға жетпесе... А.
Dialogue: 0,0:14:59.87,0:15:03.47,Default,,0000,0000,0000,,Мен топтың соншалықты шағын болады деп ойламадым.
Dialogue: 0,0:14:59.87,0:15:03.47,Default,,0000,0000,0000,,Ақылсыз түрде сүңгудің себебі! ?
Dialogue: 0,0:15:03.47,0:15:06.31,Default,,0000,0000,0000,,Иә! Не ағасынан, не қарындасынан айырылу➡
Dialogue: 0,0:15:06.31,0:15:09.64,Default,,0000,0000,0000,,Оны құтқару керек пе, жоқ па
Dialogue: 0,0:15:06.31,0:15:09.64,Default,,0000,0000,0000,,Досыммен жанжал болды.
Dialogue: 0,0:15:09.64,0:15:13.65,Default,,0000,0000,0000,,Мен бұрын солай ойладым.
Dialogue: 0,0:15:09.64,0:15:13.65,Default,,0000,0000,0000,,Солардың бірінің қасынан өттің ғой, солай ма?
Dialogue: 0,0:15:13.65,0:15:15.65,Default,,0000,0000,0000,,Олар бұрыннан бар➡
Dialogue: 0,0:15:15.65,0:15:17.98,Default,,0000,0000,0000,,Мақсат пен табысқа қатысты
Dialogue: 0,0:15:15.65,0:15:17.98,Default,,0000,0000,0000,,Олар қиындыққа тап болған сияқты➡
Dialogue: 0,0:15:17.98,0:15:21.32,Default,,0000,0000,0000,,Осы оқиғадан кейін
Dialogue: 0,0:15:17.98,0:15:21.32,Default,,0000,0000,0000,,Кейбір адамдар партиядан шығып кеткен шығар.
Dialogue: 0,0:15:21.32,0:15:24.49,Default,,0000,0000,0000,,Ал кедейлікте оларда асыл заттар да, тамақ та болған жоқ...
Dialogue: 0,0:15:24.49,0:15:27.49,Default,,0000,0000,0000,,Мүмкін бұл аздап нанымдырақ шығар.
Dialogue: 0,0:15:24.49,0:15:27.49,Default,,0000,0000,0000,,Дұрыс?
Dialogue: 0,0:15:27.49,0:15:31.66,Default,,0000,0000,0000,,Иә? Бірақ одан да ергежейлі иіс шықты.
Dialogue: 0,0:15:27.49,0:15:31.66,Default,,0000,0000,0000,,Куро осылай деді.
Dialogue: 0,0:15:31.66,0:15:34.00,Default,,0000,0000,0000,,Сита. Тамаша боқ.
Dialogue: 0,0:15:34.00,0:15:37.17,Default,,0000,0000,0000,,Бұл біртүрлі емес пе?
Dialogue: 0,0:15:34.00,0:15:37.17,Default,,0000,0000,0000,,Гномдар әлі де бар.
Dialogue: 0,0:15:37.17,0:15:39.67,Default,,0000,0000,0000,,Ол жаңадан жұмысқа қабылданған болуы мүмкін.
Dialogue: 0,0:15:39.67,0:15:42.34,Default,,0000,0000,0000,,Бұл партия?
Dialogue: 0,0:15:39.67,0:15:42.34,Default,,0000,0000,0000,,Тағы қандай жігіттер бар?
Dialogue: 0,0:15:42.34,0:15:44.34,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:15:44.34,0:15:48.51,Default,,0000,0000,0000,,Таллман - Лайос пен Фарин.
Dialogue: 0,0:15:44.34,0:15:48.51,Default,,0000,0000,0000,,Содан кейін, мүмкін Шро, шығыстық.
Dialogue: 0,0:15:48.51,0:15:52.35,Default,,0000,0000,0000,,Мен сені жаңа ғана кездестірдім
Dialogue: 0,0:15:48.51,0:15:52.35,Default,,0000,0000,0000,,Гном Намари мен пері Марцилге.
Dialogue: 0,0:15:52.35,0:15:56.19,Default,,0000,0000,0000,,Жартылай Чилчак деді ме?
Dialogue: 0,0:15:56.19,0:16:01.96,Default,,0000,0000,0000,,Тоденнің ағасы мен әпкесінің кеші болса керек.
Dialogue: 0,0:15:56.19,0:16:01.96,Default,,0000,0000,0000,,Ағайындылардың бірі мен Шуро Намари жоқ➡
Dialogue: 0,0:16:01.96,0:16:05.30,Default,,0000,0000,0000,,Бір жаңа гном қосылуы керек еді.
Dialogue: 0,0:16:05.30,0:16:08.63,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:16:05.30,0:16:08.63,Default,,0000,0000,0000,,Бұрынғы әйел Намари болатын.
Dialogue: 0,0:16:08.63,0:16:11.97,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:16:08.63,0:16:11.97,Default,,0000,0000,0000,,Сіз бірдеңе білесіз бе? Диа.
Dialogue: 0,0:16:11.97,0:16:14.31,Default,,0000,0000,0000,,Аты кім? Өйткені ол әйгілі.
Dialogue: 0,0:16:14.31,0:16:18.31,Default,,0000,0000,0000,,«Қару дүкені» деп аталады.
Dialogue: 0,0:16:14.31,0:16:18.31,Default,,0000,0000,0000,,Ер адамның жалғыз қызы.
Dialogue: 0,0:16:14.31,0:16:18.31,Default,,0000,0000,0000,,Қару қоймасы.
Dialogue: 0,0:16:18.31,0:16:22.15,Default,,0000,0000,0000,,Бұрын осы аралда
Dialogue: 0,0:16:18.31,0:16:22.15,Default,,0000,0000,0000,,Қару-жарақ таратуды басқарған адам.
Dialogue: 0,0:16:22.15,0:16:25.99,Default,,0000,0000,0000,,Бірақ бір күні
Dialogue: 0,0:16:22.15,0:16:25.99,Default,,0000,0000,0000,,Аса ірі көлемде ақша жымқырғаны анықталғаннан кейін із-түссіз жоғалған.
Dialogue: 0,0:16:25.99,0:16:30.32,Default,,0000,0000,0000,,Арал иесіне гномдар туралы жаман әсер қалдырды.
Dialogue: 0,0:16:25.99,0:16:30.32,Default,,0000,0000,0000,,Ол фактор деп айтылады.
Dialogue: 0,0:16:30.32,0:16:33.66,Default,,0000,0000,0000,,Бұл мені қинады.
Dialogue: 0,0:16:30.32,0:16:33.66,Default,,0000,0000,0000,,Гномдар көп болғандықтан...
Dialogue: 0,0:16:33.66,0:16:35.66,Default,,0000,0000,0000,,Мен де.
Dialogue: 0,0:16:35.66,0:16:39.67,Default,,0000,0000,0000,,Әдепті ергежейлі
Dialogue: 0,0:16:35.66,0:16:39.67,Default,,0000,0000,0000,,Мен мұнымен отырмаймын деп ойлаймын.
Dialogue: 0,0:16:39.67,0:16:44.84,Default,,0000,0000,0000,,Сіз кәдімгі ергежейлі емессіз ғой, солай ма?
Dialogue: 0,0:16:39.67,0:16:44.84,Default,,0000,0000,0000,,Шындығында, бұл қауіпті.
Dialogue: 0,0:16:44.84,0:16:47.84,Default,,0000,0000,0000,,Мен де Шылшаққа келгенде.
Dialogue: 0,0:16:44.84,0:16:47.84,Default,,0000,0000,0000,,Мен білемін.
Dialogue: 0,0:16:47.84,0:16:49.84,Default,,0000,0000,0000,,Ол жақсы қария➡
Dialogue: 0,0:16:49.84,0:16:53.01,Default,,0000,0000,0000,,Аралдағы жарты фут
Dialogue: 0,0:16:49.84,0:16:53.01,Default,,0000,0000,0000,,Сіз өкіл сияқтысыз.
Dialogue: 0,0:16:53.01,0:16:57.02,Default,,0000,0000,0000,,«Біреумен шарт жасасқанда
Dialogue: 0,0:16:53.01,0:16:57.02,Default,,0000,0000,0000,,Одақ арқылы~”➡
Dialogue: 0,0:16:57.02,0:17:00.12,Default,,0000,0000,0000,,Содан кейін, «Брокерлік комиссияны төлеңіз».
Dialogue: 0,0:16:57.02,0:17:00.12,Default,,0000,0000,0000,,Ол қатал!
Dialogue: 0,0:17:00.12,0:17:03.12,Default,,0000,0000,0000,,Мен бұған кіре алмаймын.
Dialogue: 0,0:17:00.12,0:17:03.12,Default,,0000,0000,0000,,Ол қашып барады.
Dialogue: 0,0:17:03.12,0:17:05.46,Default,,0000,0000,0000,,Өйткені олар коболдтарды жалдап жатыр.
Dialogue: 0,0:17:03.12,0:17:05.46,Default,,0000,0000,0000,,Егер ол белгілі болса➡
Dialogue: 0,0:17:05.46,0:17:07.63,Default,,0000,0000,0000,,Мүлдем.
Dialogue: 0,0:17:07.63,0:17:11.30,Default,,0000,0000,0000,,Бұл дұрыс емес, солай емес пе?
Dialogue: 0,0:17:07.63,0:17:11.30,Default,,0000,0000,0000,,Куро, сен маған жұмысқа алғың келеді, солай ма?
Dialogue: 0,0:17:11.30,0:17:15.47,Default,,0000,0000,0000,,Мик Месихлер. Жақсы жұмыс беруші.
Dialogue: 0,0:17:11.30,0:17:15.47,Default,,0000,0000,0000,,Хе.
Dialogue: 0,0:17:15.47,0:17:18.97,Default,,0000,0000,0000,,Мүлдем төмен жалақымен
Dialogue: 0,0:17:15.47,0:17:18.97,Default,,0000,0000,0000,,Менің ойымша, олар Кокиді пайдаланып жатыр.
Dialogue: 0,0:17:18.97,0:17:21.97,Default,,0000,0000,0000,,Холм, сіз мұны болжамға сүйене отырып жасадыңыз.
Dialogue: 0,0:17:18.97,0:17:21.97,Default,,0000,0000,0000,,Менің айтып тұрғаным бұл емес.
Dialogue: 0,0:17:21.97,0:17:25.64,Default,,0000,0000,0000,,-да Шығыстың Толлманы болып табылады
Dialogue: 0,0:17:21.97,0:17:25.64,Default,,0000,0000,0000,,Ол Риннің туған жерінен, солай ма?
Dialogue: 0,0:17:25.64,0:17:28.31,Default,,0000,0000,0000,,Бір-біріңді танисыңдар ма?
Dialogue: 0,0:17:25.64,0:17:28.31,Default,,0000,0000,0000,,Эй...
Dialogue: 0,0:17:28.31,0:17:30.98,Default,,0000,0000,0000,,«Шығыс» деп бәрімізді біріктірме.
Dialogue: 0,0:17:30.98,0:17:33.49,Default,,0000,0000,0000,,Орынына байланысты
Dialogue: 0,0:17:30.98,0:17:33.49,Default,,0000,0000,0000,,Біз тіпті сөйлесе алмаймыз.
Dialogue: 0,0:17:33.49,0:17:36.99,Default,,0000,0000,0000,,Шро есімі кім?
Dialogue: 0,0:17:33.49,0:17:36.99,Default,,0000,0000,0000,,Бұл менің аралыма жатпайды.
Dialogue: 0,0:17:36.99,0:17:39.49,Default,,0000,0000,0000,,Мүмкін мен бұл туралы көбірек білетін шығармын.
Dialogue: 0,0:17:39.49,0:17:42.49,Default,,0000,0000,0000,,Ол кішкентай
Dialogue: 0,0:17:39.49,0:17:42.49,Default,,0000,0000,0000,,Ол сол жерде де қалқып тұратын болды.
Dialogue: 0,0:17:42.49,0:17:47.67,Default,,0000,0000,0000,,Мен бір туған қаладағы достарыммен аралға бардым.
Dialogue: 0,0:17:42.49,0:17:47.67,Default,,0000,0000,0000,,Торденнің партиясына жалғыз қосылды.
Dialogue: 0,0:17:47.67,0:17:50.17,Default,,0000,0000,0000,,Катагиге ұқсамайды➡
Dialogue: 0,0:17:50.17,0:17:53.17,Default,,0000,0000,0000,,Лабиринтті шақыру
Dialogue: 0,0:17:50.17,0:17:53.17,Default,,0000,0000,0000,,Бұл жай ғана шеберлікті сынау болды.
Dialogue: 0,0:17:53.17,0:17:56.01,Default,,0000,0000,0000,,Ол партиядан шықты ма?
Dialogue: 0,0:17:56.01,0:17:59.51,Default,,0000,0000,0000,,Сыйақылар мен тәуекелдерді есте сақтау
Dialogue: 0,0:17:56.01,0:17:59.51,Default,,0000,0000,0000,,Мен оны көре алмадым.
Dialogue: 0,0:17:59.51,0:18:04.78,Default,,0000,0000,0000,,Ағамның да, әпкемнің де кеткеніне сене алмадым.
Dialogue: 0,0:17:59.51,0:18:04.78,Default,,0000,0000,0000,,Ол қалды... Солай емес пе?
Dialogue: 0,0:18:04.78,0:18:08.29,Default,,0000,0000,0000,,Каблу өте қорқынышты
Dialogue: 0,0:18:04.78,0:18:08.29,Default,,0000,0000,0000,,Сіз адамдарды еске түсіресіз.
Dialogue: 0,0:18:08.29,0:18:10.29,Default,,0000,0000,0000,,Неліктен бұл көңілді болып көрінеді?
Dialogue: 0,0:18:10.29,0:18:12.62,Default,,0000,0000,0000,,Бұл қызық! Бұл өте қызық!
Dialogue: 0,0:18:12.62,0:18:17.46,Default,,0000,0000,0000,,Бұл аралда көптеген адамдар бар.
Dialogue: 0,0:18:12.62,0:18:17.46,Default,,0000,0000,0000,,Олардың әрқайсысы әртүрлі ниетпен әрекет етеді.
Dialogue: 0,0:18:17.46,0:18:20.47,Default,,0000,0000,0000,,Бірақ олардың әрекеттері соншалықты үйлеспейді.
Dialogue: 0,0:18:17.46,0:18:20.47,Default,,0000,0000,0000,,Олар бір-біріне сәйкес келгенде ➡
Dialogue: 0,0:18:20.47,0:18:23.97,Default,,0000,0000,0000,,Көптеген адамдарды қатыстырды
Dialogue: 0,0:18:20.47,0:18:23.97,Default,,0000,0000,0000,,Тарихи оқиғаға айналады.
Dialogue: 0,0:18:23.97,0:18:26.31,Default,,0000,0000,0000,,Бұл қызық ұрлық оқиғасы ма?
Dialogue: 0,0:18:23.97,0:18:26.31,Default,,0000,0000,0000,,Мен солай ойладым➡
Dialogue: 0,0:18:26.31,0:18:28.97,Default,,0000,0000,0000,,Қызықты оқиғалар орын алады
Dialogue: 0,0:18:26.31,0:18:28.97,Default,,0000,0000,0000,,Менің бір болжамым бар.
Dialogue: 0,0:18:28.97,0:18:31.81,Default,,0000,0000,0000,,Тоден аға мен әпкенің кеші деп үміттенемін.
Dialogue: 0,0:18:31.81,0:18:34.65,Default,,0000,0000,0000,,Себебі... Мен мұнда көптен бері жүрмін➡
Dialogue: 0,0:18:34.65,0:18:37.98,Default,,0000,0000,0000,,Олардың бетперделері шешіледі.
Dialogue: 0,0:18:34.65,0:18:37.98,Default,,0000,0000,0000,,Мен осы сәтті күттім.
Dialogue: 0,0:18:37.98,0:18:39.99,Default,,0000,0000,0000,,Тағдырдың бір түрі бар ма?
Dialogue: 0,0:18:39.99,0:18:42.15,Default,,0000,0000,0000,,Маған бірдеңе жасалған сияқты емес.
Dialogue: 0,0:18:39.99,0:18:42.15,Default,,0000,0000,0000,,Жоқ, бірақ➡
Dialogue: 0,0:18:42.15,0:18:45.66,Default,,0000,0000,0000,,Ол бұрын алтын сыпырушылар тобының құрамында болған.
Dialogue: 0,0:18:42.15,0:18:45.66,Default,,0000,0000,0000,,Ол пайда тапқан сияқты.
Dialogue: 0,0:18:45.66,0:18:49.16,Default,,0000,0000,0000,,Бірақ ауру немесе жарақат салдарынан
Dialogue: 0,0:18:45.66,0:18:49.16,Default,,0000,0000,0000,,Лабиринтке енді түсе алмайтын достар үшін➡
Dialogue: 0,0:18:49.16,0:18:51.16,Default,,0000,0000,0000,,Мен табысымның көп бөлігін бердім.
Dialogue: 0,0:18:51.16,0:18:53.17,Default,,0000,0000,0000,,Эй.
Dialogue: 0,0:18:51.16,0:18:53.17,Default,,0000,0000,0000,,Бұл жақсы әңгіме.
Dialogue: 0,0:18:53.17,0:18:57.17,Default,,0000,0000,0000,,Иә, әдемі әңгіме екен.
Dialogue: 0,0:18:53.17,0:18:57.17,Default,,0000,0000,0000,,Бірақ бұл әңгімеде тағы да көп нәрсе бар.
Dialogue: 0,0:18:57.17,0:19:01.11,Default,,0000,0000,0000,,Олар әлдеқашан айыққан болатын.
Dialogue: 0,0:18:57.17,0:19:01.11,Default,,0000,0000,0000,,Мен ақша алып жатыр едім.
Dialogue: 0,0:19:01.11,0:19:04.28,Default,,0000,0000,0000,,Соңында олар
Dialogue: 0,0:19:01.11,0:19:04.28,Default,,0000,0000,0000,,Ешқашан авантюрист болмадым➡
Dialogue: 0,0:19:04.28,0:19:06.95,Default,,0000,0000,0000,,Қазір аралда
Dialogue: 0,0:19:04.28,0:19:06.95,Default,,0000,0000,0000,,Өткізілген тауарларды сату.
Dialogue: 0,0:19:06.95,0:19:10.62,Default,,0000,0000,0000,,«Лабиринт шеберін жеңген адамға
Dialogue: 0,0:19:06.95,0:19:10.62,Default,,0000,0000,0000,,Барлығын бер».
Dialogue: 0,0:19:10.62,0:19:14.12,Default,,0000,0000,0000,,Осы елдің патшасы болып көрінетін адам
Dialogue: 0,0:19:10.62,0:19:14.12,Default,,0000,0000,0000,,Артында қалдырған сөздері осы болса керек➡
Dialogue: 0,0:19:14.12,0:19:17.62,Default,,0000,0000,0000,,Шынында да бәрі
Dialogue: 0,0:19:14.12,0:19:17.62,Default,,0000,0000,0000,,Сіз ала аласыз ба, жоқ па➡
Dialogue: 0,0:19:17.62,0:19:21.29,Default,,0000,0000,0000,,Бұл лабиринттің өзі
Dialogue: 0,0:19:17.62,0:19:21.29,Default,,0000,0000,0000,,Ежелгі эльфтерден қалған жәдігер.
Dialogue: 0,0:19:21.29,0:19:25.63,Default,,0000,0000,0000,,Кімнің ықпалы зор?
Dialogue: 0,0:19:21.29,0:19:25.63,Default,,0000,0000,0000,,Сөз жоқ. Сонымен➡
Dialogue: 0,0:19:25.63,0:19:29.13,Default,,0000,0000,0000,,Мен үшін бұл аға мен әпке.
Dialogue: 0,0:19:25.63,0:19:29.13,Default,,0000,0000,0000,,Менің ойымша, олай болуы керек емес.
Dialogue: 0,0:19:29.13,0:19:33.64,Default,,0000,0000,0000,,Олар жақсы адамдар емес.
Dialogue: 0,0:19:29.13,0:19:33.64,Default,,0000,0000,0000,,Оларды адамдар қызықтырмайды.
Dialogue: 0,0:19:33.64,0:19:36.14,Default,,0000,0000,0000,,Арал иесімен бірдей.
Dialogue: 0,0:19:36.14,0:19:40.65,Default,,0000,0000,0000,,Мен білемін, Кабру.
Dialogue: 0,0:19:36.14,0:19:40.65,Default,,0000,0000,0000,,Барлық оқтарыңды жауға беріңдер!!
Dialogue: 0,0:19:36.14,0:19:40.65,Default,,0000,0000,0000,,Менің ойымша, сен жалғызсың.
Dialogue: 0,0:19:40.65,0:19:43.15,Default,,0000,0000,0000,,Сол ақымақ арал иесін қуып шығу сияқты.
Dialogue: 0,0:19:43.15,0:19:46.32,Default,,0000,0000,0000,,Осы жердегі құбыжықтарға
Dialogue: 0,0:19:43.15,0:19:46.32,Default,,0000,0000,0000,,Сізге қиын болатын сияқты➡
Dialogue: 0,0:19:46.32,0:19:48.49,Default,,0000,0000,0000,,Бізде әлі көп жол бар.
Dialogue: 0,0:19:48.49,0:19:52.32,Default,,0000,0000,0000,,Дұрыс...
Dialogue: 0,0:19:48.49,0:19:52.32,Default,,0000,0000,0000,,Олай болса, қазір кетейік.
Dialogue: 0,0:19:52.32,0:19:55.03,Default,,0000,0000,0000,,Оқиғасыз үйге ораларсың деп үміттенемін.
Dialogue: 0,0:20:00.50,0:20:02.83,Default,,0000,0000,0000,,Уау! Қауіп!
Dialogue: 0,0:20:00.50,0:20:02.83,Default,,0000,0000,0000,,Бұл жүзді балық!
Dialogue: 0,0:20:02.83,0:20:07.54,Default,,0000,0000,0000,,Әй, балыққа алаңдама!
Dialogue: 0,0:20:02.83,0:20:07.54,Default,,0000,0000,0000,,Әркім өз қадамын бақылайды... Ха.
Dialogue: 0,0:20:11.01,0:20:13.85,Default,,0000,0000,0000,,Кракен... Жоқ, Шисерпент!
Dialogue: 0,0:20:13.85,0:20:15.85,Default,,0000,0000,0000,,Рин! Алыста...!
Dialogue: 0,0:20:13.85,0:20:15.85,Default,,0000,0000,0000,,Өлең….
Dialogue: 0,0:20:17.85,0:20:20.69,Default,,0000,0000,0000,,Холм!
Dialogue: 0,0:20:17.85,0:20:20.69,Default,,0000,0000,0000,,Бұл жағдайда
Dialogue: 0,0:20:17.85,0:20:20.69,Default,,0000,0000,0000,,«Қызды» шығару мүмкін емес!
Dialogue: 0,0:20:20.69,0:20:23.69,Default,,0000,0000,0000,,Біртүрлі нәрселер араласып кетеді!
Dialogue: 0,0:20:20.69,0:20:23.69,Default,,0000,0000,0000,,Кух….
Dialogue: 0,0:20:26.69,0:20:30.53,Default,,0000,0000,0000,,《Үрейленбе
Dialogue: 0,0:20:26.69,0:20:30.53,Default,,0000,0000,0000,,Сен бұл туралы бірдеңе істейсің, Кабру.
Dialogue: 0,0:20:30.53,0:20:33.03,Default,,0000,0000,0000,,Бұл қимылдары күрделі тіршілік иесі емес.
Dialogue: 0,0:20:33.03,0:20:36.70,Default,,0000,0000,0000,,Қарсыласыңыздың қимылын бағалаңыз
Dialogue: 0,0:20:33.03,0:20:36.70,Default,,0000,0000,0000,,Каротид артериясы немесе басқасы...
Dialogue: 0,0:20:36.70,0:20:39.20,Default,,0000,0000,0000,,Жоқ, ұйқы артериясы қайда орналасқан? 》
Dialogue: 0,0:20:39.20,0:20:42.04,Default,,0000,0000,0000,,Бір сәт кешіріңіз... хмм.
Dialogue: 0,0:20:42.04,0:20:44.04,Default,,0000,0000,0000,,Таде!
Dialogue: 0,0:20:42.04,0:20:44.04,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:20:44.04,0:20:46.04,Default,,0000,0000,0000,,Ай-ай!
Dialogue: 0,0:20:49.05,0:20:51.35,Default,,0000,0000,0000,,Бала! Өтінемін!
Dialogue: 0,0:20:56.72,0:20:59.56,Default,,0000,0000,0000,,Бала!
Dialogue: 0,0:20:56.72,0:20:59.56,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:20:59.56,0:21:02.49,Default,,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,0:21:02.49,0:21:04.83,Default,,0000,0000,0000,,Киіміңіз лас па?
Dialogue: 0,0:21:02.49,0:21:04.83,Default,,0000,0000,0000,,№.
Dialogue: 0,0:21:04.83,0:21:06.83,Default,,0000,0000,0000,,Сіз шаршаған болуыңыз керек.
Dialogue: 0,0:21:06.83,0:21:10.34,Default,,0000,0000,0000,,Неге мұнда тамақ ішпейсің?
Dialogue: 0,0:21:06.83,0:21:10.34,Default,,0000,0000,0000,,Жақсы асығыңыз.
Dialogue: 0,0:21:10.34,0:21:13.34,Default,,0000,0000,0000,,Мен де қиналдым.
Dialogue: 0,0:21:13.34,0:21:16.51,Default,,0000,0000,0000,,Сол солтүстік әйелге қатты ұнайды.
Dialogue: 0,0:21:13.34,0:21:16.51,Default,,0000,0000,0000,,Ол оған ғашық сияқты.
Dialogue: 0,0:21:16.51,0:21:19.51,Default,,0000,0000,0000,,Тэде аш болды.
Dialogue: 0,0:21:16.51,0:21:19.51,Default,,0000,0000,0000,,(асқазанның айқайлауы)
Dialogue: 0,0:21:19.51,0:21:23.85,Default,,0000,0000,0000,,Кабру Сіз ауырып қалдыңыз ба?
Dialogue: 0,0:21:19.51,0:21:23.85,Default,,0000,0000,0000,,Жоспарларды өзгерту.
Dialogue: 0,0:21:19.51,0:21:23.85,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:23.85,0:21:27.19,Default,,0000,0000,0000,,А-а, шалғаммен қайнатса дәмді болмай ма?
Dialogue: 0,0:21:23.85,0:21:27.19,Default,,0000,0000,0000,,Сен ақымақсың ба?
Dialogue: 0,0:21:27.19,0:21:29.19,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:21:29.19,0:21:31.86,Default,,0000,0000,0000,,Маған қауіпті жерде көмектескеніңіз үшін рахмет.
Dialogue: 0,0:21:29.19,0:21:31.86,Default,,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,0:21:31.86,0:21:35.03,Default,,0000,0000,0000,,Мен Кабрумын. Атыңызды сұрасам бола ма?
Dialogue: 0,0:21:35.03,0:21:38.36,Default,,0000,0000,0000,,Уайымдамаңыз.
Dialogue: 0,0:21:35.03,0:21:38.36,Default,,0000,0000,0000,,Мен жаңа ғана өтіп бара жатқанмын.
Dialogue: 0,0:21:38.36,0:21:40.87,Default,,0000,0000,0000,,Қателеспесем➡
Dialogue: 0,0:21:40.87,0:21:43.37,Default,,0000,0000,0000,,Ол басқа суреттерде де бар емес пе?
Dialogue: 0,0:21:40.87,0:21:43.37,Default,,0000,0000,0000,,Сіз әйел іздеп жүрсіз бе?
Dialogue: 0,0:21:43.37,0:21:46.54,Default,,0000,0000,0000,,Ха! Сіз бірдеңе білесіз бе?
Dialogue: 0,0:21:46.54,0:21:50.21,Default,,0000,0000,0000,,Ах, күткендей. Жүрегім сен үшін.
Dialogue: 0,0:21:50.21,0:21:53.71,Default,,0000,0000,0000,,Мүмкін
Dialogue: 0,0:21:50.21,0:21:53.71,Default,,0000,0000,0000,,Біз көмектесе аламыз➡
Dialogue: 0,0:21:53.71,0:21:56.88,Default,,0000,0000,0000,,Фарин Торденді іздеуге қатысты.
Dialogue: 0,0:21:56.88,0:21:58.88,Default,,0000,0000,0000,,Гуруруру….
Dialogue: 0,0:21:56.88,0:21:58.88,Default,,0000,0000,0000,,Сәлем Куро!
Dialogue: 0,0:21:58.88,0:22:01.99,Default,,0000,0000,0000,,Бұл өрнек
Dialogue: 0,0:21:58.88,0:22:01.99,Default,,0000,0000,0000,,Мен саған бұлай істеме дедім, себебі бұл қорқынышты.
Dialogue: 0,0:22:01.99,0:22:04.32,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:22:04.32,0:22:08.83,Default,,0000,0000,0000,,＜ Осылайша Кабрус
Dialogue: 0,0:22:04.32,0:22:08.83,Default,,0000,0000,0000,,Мен тағы да зынданға сүңгіуді жөн көрдім.
Dialogue: 0,0:22:08.83,0:22:12.50,Default,,0000,0000,0000,,Уақыт кері кетеді, Лайос және басқалар.
Dialogue: 0,0:22:12.50,0:22:15.33,Default,,0000,0000,0000,,Қайтару туралы декларациядан кейін толық екі күн>
Dialogue: 0,0:22:15.33,0:22:17.34,Default,,0000,0000,0000,,Бұл тұйыққа тіреледі.
Dialogue: 0,0:22:17.34,0:22:19.54,Default,,0000,0000,0000,,Тағы бір тұйық.
Dialogue: 0,0:22:21.51,0:22:24.01,Default,,0000,0000,0000,,Менің қарным ашты.
Dialogue: 0,0:22:21.51,0:22:24.01,Default,,0000,0000,0000,,Менің ұйқым келіп тұр...
Dialogue: 0,0:22:24.01,0:22:26.01,Default,,0000,0000,0000,,Мен шөлдедім...
Dialogue: 0,0:22:26.01,0:22:29.01,Default,,0000,0000,0000,,<Мен адасып, өлейін деп қалдым>
Dialogue: 0,0:22:30.51,0:22:36.51,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory