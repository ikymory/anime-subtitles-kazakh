Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:30.02,0:01:33.86,Default,,0000,0000,0000,,｟Гирин: күткендей.
Dialogue: 0,0:01:30.02,0:01:33.86,Default,,0000,0000,0000,,Бұл жай ғана дәстүр емес еді.
Dialogue: 0,0:01:33.86,0:01:37.36,Default,,0000,0000,0000,,Құлаған ежелгі патшалық
Dialogue: 0,0:01:33.86,0:01:37.36,Default,,0000,0000,0000,,Ол болды!
Dialogue: 0,0:01:39.37,0:01:43.04,Default,,0000,0000,0000,,Бұл таза алтын.
Dialogue: 0,0:01:39.37,0:01:43.04,Default,,0000,0000,0000,,Бұл өте ұят.
Dialogue: 0,0:01:43.04,0:01:45.04,Default,,0000,0000,0000,,Сәлем...
Dialogue: 0,0:01:45.04,0:01:47.71,Default,,0000,0000,0000,,Жерге қайта оралуымыз керек емес пе?
Dialogue: 0,0:01:47.71,0:01:50.54,Default,,0000,0000,0000,,Егер сіз зерттегіңіз келсе
Dialogue: 0,0:01:47.71,0:01:50.54,Default,,0000,0000,0000,,Нақтырақ дайындалу...
Dialogue: 0,0:01:50.54,0:01:53.21,Default,,0000,0000,0000,,Неге жартылай ұйықтап қалдың?
Dialogue: 0,0:01:50.54,0:01:53.21,Default,,0000,0000,0000,,Айтыңыз.
Dialogue: 0,0:01:53.21,0:01:57.38,Default,,0000,0000,0000,,Сенші, денеңде
Dialogue: 0,0:01:53.21,0:01:57.38,Default,,0000,0000,0000,,Темір шынымен ағып жатыр ма?
Dialogue: 0,0:01:57.38,0:02:00.49,Default,,0000,0000,0000,,Оны асыра алмаңыз
Dialogue: 0,0:01:57.38,0:02:00.49,Default,,0000,0000,0000,,Сіз осында күтіңіз.
Dialogue: 0,0:02:00.49,0:02:03.99,Default,,0000,0000,0000,,Кин
Dialogue: 0,0:02:00.49,0:02:03.99,Default,,0000,0000,0000,,Хмм... Мен де ақша алғым келеді! ｠
Dialogue: 0,0:02:03.99,0:02:07.99,Default,,0000,0000,0000,,《Сенші: Жалғыз қалудан қорқамын.
Dialogue: 0,0:02:03.99,0:02:07.99,Default,,0000,0000,0000,,Мен өтірік айттым.
Dialogue: 0,0:02:07.99,0:02:11.00,Default,,0000,0000,0000,,Сәлеметсіз бе, бұл жер
Dialogue: 0,0:02:07.99,0:02:11.00,Default,,0000,0000,0000,,Мен саған ғашық бола алмадым➡
Dialogue: 0,0:02:11.00,0:02:14.50,Default,,0000,0000,0000,,Көптеген өршіл адамдар
Dialogue: 0,0:02:11.00,0:02:14.50,Default,,0000,0000,0000,,Дос болса да➡
Dialogue: 0,0:02:14.50,0:02:17.00,Default,,0000,0000,0000,,Ол кездегі жағдай қалыптан тыс еді.
Dialogue: 0,0:02:17.00,0:02:20.17,Default,,0000,0000,0000,,Қараңғыда екі көзі жарқырайды➡
Dialogue: 0,0:02:20.17,0:02:24.34,Default,,0000,0000,0000,,Тартқандай
Dialogue: 0,0:02:20.17,0:02:24.34,Default,,0000,0000,0000,,Барған сайын тереңде.
Dialogue: 0,0:02:24.34,0:02:28.35,Default,,0000,0000,0000,,Және... кенеттен басталды》
Dialogue: 0,0:02:28.35,0:02:30.52,Default,,0000,0000,0000,,｟3 адам: Ах! ?
Dialogue: 0,0:02:28.35,0:02:30.52,Default,,0000,0000,0000,,Шыу!
Dialogue: 0,0:02:30.52,0:02:32.52,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:02:30.52,0:02:32.52,Default,,0000,0000,0000,,Не болды! ?
Dialogue: 0,0:02:32.52,0:02:36.02,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:02:32.52,0:02:36.02,Default,,0000,0000,0000,,Ал... бұл құбыжық!
Dialogue: 0,0:02:36.02,0:02:39.03,Default,,0000,0000,0000,,Үлкен құбыжық құс
Dialogue: 0,0:02:36.02,0:02:39.03,Default,,0000,0000,0000,,Кенеттен пайда болды...
Dialogue: 0,0:02:39.03,0:02:41.19,Default,,0000,0000,0000,,Тотан өлтірілді!
Dialogue: 0,0:02:41.19,0:02:43.20,Default,,0000,0000,0000,,Бұл жай қираған жер емес.
Dialogue: 0,0:02:43.20,0:02:45.87,Default,,0000,0000,0000,,Ол лабиринтке айналып барады!
Dialogue: 0,0:02:43.20,0:02:45.87,Default,,0000,0000,0000,,Ха…｠
Dialogue: 0,0:02:45.87,0:02:49.87,Default,,0000,0000,0000,,《Сенші: Барлығы қорқады
Dialogue: 0,0:02:45.87,0:02:49.87,Default,,0000,0000,0000,,Ақыры өз-өзіме келдім➡
Dialogue: 0,0:02:49.87,0:02:53.21,Default,,0000,0000,0000,,Мен үйге қалай барарымды білмедім》
Dialogue: 0,0:02:53.21,0:02:56.88,Default,,0000,0000,0000,,｟Нұр: Біз
Dialogue: 0,0:02:53.21,0:02:56.88,Default,,0000,0000,0000,,Сіз тұзаққа түстіңіз...
Dialogue: 0,0:02:56.88,0:03:00.81,Default,,0000,0000,0000,,Басқа адамның дүкенінің алдында дау шығармаңдар!
Dialogue: 0,0:02:56.88,0:03:00.81,Default,,0000,0000,0000,,Лабиринт дегеніміз не?
Dialogue: 0,0:02:56.88,0:03:00.81,Default,,0000,0000,0000,,Әрқашан жерге қосылған.
Dialogue: 0,0:03:00.81,0:03:03.98,Default,,0000,0000,0000,,Тыныштанып, шығу жолын іздеңіз｠
Dialogue: 0,0:03:03.98,0:03:08.49,Default,,0000,0000,0000,,《Сенси: құбыжықтардан аулақ болу
Dialogue: 0,0:03:03.98,0:03:08.49,Default,,0000,0000,0000,,Мен жай ғана лабиринтті аралап шықтым.
Dialogue: 0,0:03:08.49,0:03:10.49,Default,,0000,0000,0000,,Біртүрлі➡
Dialogue: 0,0:03:10.49,0:03:12.49,Default,,0000,0000,0000,,Шөлдесең, бұлақ бар.
Dialogue: 0,0:03:12.49,0:03:16.50,Default,,0000,0000,0000,,Шаршасаңыз
Dialogue: 0,0:03:12.49,0:03:16.50,Default,,0000,0000,0000,,Бейбіт бөлме пайда болады.
Dialogue: 0,0:03:16.50,0:03:22.50,Default,,0000,0000,0000,,Көлеңкеде теңдесі жоқ сұлуға айналу
Dialogue: 0,0:03:16.50,0:03:22.50,Default,,0000,0000,0000,,Кейбіреулер тіпті азғырылғанын айтты.
Dialogue: 0,0:03:22.50,0:03:25.84,Default,,0000,0000,0000,,Ақырында тамақ таусылды》
Dialogue: 0,0:03:25.84,0:03:28.34,Default,,0000,0000,0000,,｟Бұлай жалғаса берсе мен аштан өлемін.
Dialogue: 0,0:03:28.34,0:03:32.35,Default,,0000,0000,0000,,Төбелес болса да жейтін бірдеңе табуым керек.
Dialogue: 0,0:03:28.34,0:03:32.35,Default,,0000,0000,0000,,Жеуге болатын нәрсе бар ма?
Dialogue: 0,0:03:32.35,0:03:35.68,Default,,0000,0000,0000,,Тіпті құбыжықтар
Dialogue: 0,0:03:32.35,0:03:35.68,Default,,0000,0000,0000,,Олар бірдеңе жеу арқылы өмір сүрсе керек.
Dialogue: 0,0:03:35.68,0:03:40.35,Default,,0000,0000,0000,,Инвер Бриган
Dialogue: 0,0:03:35.68,0:03:40.35,Default,,0000,0000,0000,,Қалқаныңызбен айналаңызды қорғаңыз.
Dialogue: 0,0:03:40.35,0:03:43.52,Default,,0000,0000,0000,,Нұр екеуміз құбыжықтарға қарумен тойтарыс береміз.
Dialogue: 0,0:03:43.52,0:03:45.53,Default,,0000,0000,0000,,Сенши….
Dialogue: 0,0:03:43.52,0:03:45.53,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:03:45.53,0:03:49.03,Default,,0000,0000,0000,,Осы жерде болыңыз
Dialogue: 0,0:03:45.53,0:03:49.03,Default,,0000,0000,0000,,Осы ауданның картасын құрастыр.
Dialogue: 0,0:03:49.03,0:03:51.03,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,0:03:49.03,0:03:51.03,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:03:53.03,0:03:55.03,Default,,0000,0000,0000,,(Есік жабылған дыбысы)
Dialogue: 0,0:03:57.04,0:03:59.87,Default,,0000,0000,0000,,Құс құбыжық қайтадан пайда болды!
Dialogue: 0,0:03:57.04,0:03:59.87,Default,,0000,0000,0000,,Сол екеу ме?
Dialogue: 0,0:03:59.87,0:04:04.31,Default,,0000,0000,0000,,Мен бұған жол бермеймін. Мен бұған жол бермеймін!
Dialogue: 0,0:03:59.87,0:04:04.31,Default,,0000,0000,0000,,Ол бірден ауаға ұшып кетеді.
Dialogue: 0,0:04:04.31,0:04:09.48,Default,,0000,0000,0000,,Мен тамақ іздеймін!
Dialogue: 0,0:04:04.31,0:04:09.48,Default,,0000,0000,0000,,Маған керек емес. Бұл жай ғана кедергі болады.
Dialogue: 0,0:04:09.48,0:04:14.15,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:04:09.48,0:04:14.15,Default,,0000,0000,0000,,Тамақ тапты.
Dialogue: 0,0:04:09.48,0:04:14.15,Default,,0000,0000,0000,,Мұны жеу керек.
Dialogue: 0,0:04:14.15,0:04:19.83,Default,,0000,0000,0000,,《Сенси: Мен ештеңе істемесем де, қарным ашады.
Dialogue: 0,0:04:14.15,0:04:19.83,Default,,0000,0000,0000,,Мен өзімді аядым.
Dialogue: 0,0:04:19.83,0:04:24.16,Default,,0000,0000,0000,,Шығудан, сол күні не жеу керек
Dialogue: 0,0:04:19.83,0:04:24.16,Default,,0000,0000,0000,,Іздеу мені шарасыздандырды.
Dialogue: 0,0:04:24.16,0:04:28.00,Default,,0000,0000,0000,,Артымыздан құстар келеді
Dialogue: 0,0:04:24.16,0:04:28.00,Default,,0000,0000,0000,,Тынымсыз ұмтылыңыз.
Dialogue: 0,0:04:28.00,0:04:32.01,Default,,0000,0000,0000,,Ұрысқан сайын достар азаяды...
Dialogue: 0,0:04:28.00,0:04:32.01,Default,,0000,0000,0000,,Тамақтануда қиындықтар бар➡
Dialogue: 0,0:04:32.01,0:04:34.51,Default,,0000,0000,0000,,Жылқы ақыры өлді》
Dialogue: 0,0:04:34.51,0:04:38.51,Default,,0000,0000,0000,,｟Гирин: Төрт аяқты бүркіт... бұған күмәнім жоқ.
Dialogue: 0,0:04:38.51,0:04:43.35,Default,,0000,0000,0000,,Иә, грифондар – құбыжықтар.
Dialogue: 0,0:04:38.51,0:04:43.35,Default,,0000,0000,0000,,Неге бізді жау қылып жатырсың?
Dialogue: 0,0:04:43.35,0:04:46.02,Default,,0000,0000,0000,,Менің қарным ашқан сияқты емес
Dialogue: 0,0:04:43.35,0:04:46.02,Default,,0000,0000,0000,,Бұл екіталай болып көрінгенімен.
Dialogue: 0,0:04:46.02,0:04:49.19,Default,,0000,0000,0000,,Қанды қырғыннан ләззат алыңыз.
Dialogue: 0,0:04:49.19,0:04:52.69,Default,,0000,0000,0000,,Құбыжық дегеніміз не?
Dialogue: 0,0:04:49.19,0:04:52.69,Default,,0000,0000,0000,,Оның табиғаты осындай.
Dialogue: 0,0:04:54.69,0:04:58.87,Default,,0000,0000,0000,,Уайымдамаңыз. Келесі жолы мен келемін
Dialogue: 0,0:04:54.69,0:04:58.87,Default,,0000,0000,0000,,Оны қуырып жеп ал.
Dialogue: 0,0:04:58.87,0:05:02.57,Default,,0000,0000,0000,,Қараңдар, рахмет Анна.
Dialogue: 0,0:04:58.87,0:05:02.57,Default,,0000,0000,0000,,Көп тамақтаныңыз.
Dialogue: 0,0:05:06.31,0:05:08.31,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:05:08.31,0:05:11.48,Default,,0000,0000,0000,,Пайдасыз бәйбішеге
Dialogue: 0,0:05:08.31,0:05:11.48,Default,,0000,0000,0000,,Алдымен мені тамақтандырыңыз.
Dialogue: 0,0:05:11.48,0:05:14.81,Default,,0000,0000,0000,,Ол небәрі 36 жаста және өсіп келеді.
Dialogue: 0,0:05:14.81,0:05:19.32,Default,,0000,0000,0000,,Біз, үлкендер, сендерге қамқор боламыз.
Dialogue: 0,0:05:14.81,0:05:19.32,Default,,0000,0000,0000,,Жауапты.
Dialogue: 0,0:05:14.81,0:05:19.32,Default,,0000,0000,0000,,Біз мұны көтере алмаймыз!
Dialogue: 0,0:05:19.32,0:05:22.16,Default,,0000,0000,0000,,Келесі ұрпақ
Dialogue: 0,0:05:19.32,0:05:22.16,Default,,0000,0000,0000,,Егер сіз енді өзіңізге қамқорлық жасай алмасаңыз➡
Dialogue: 0,0:05:22.16,0:05:25.16,Default,,0000,0000,0000,,Бітті!
Dialogue: 0,0:05:22.16,0:05:25.16,Default,,0000,0000,0000,,Тс!
Dialogue: 0,0:05:25.16,0:05:34.33,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:05:34.33,0:05:36.34,Default,,0000,0000,0000,,《Менің қарным ашты...
Dialogue: 0,0:05:36.34,0:05:40.34,Default,,0000,0000,0000,,Денеде
Dialogue: 0,0:05:36.34,0:05:40.34,Default,,0000,0000,0000,,Темір аққанша➡
Dialogue: 0,0:05:40.34,0:05:43.18,Default,,0000,0000,0000,,Тас сияқты жеуге болмайтын нәрсе бар емес пе...?
Dialogue: 0,0:05:40.34,0:05:43.18,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:05:43.18,0:05:45.18,Default,,0000,0000,0000,,Сізде тамақ жасырылған! ?
Dialogue: 0,0:05:43.18,0:05:45.18,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:05:45.18,0:05:47.85,Default,,0000,0000,0000,,Тоқта! Сен не істеп жатырсың!
Dialogue: 0,0:05:47.85,0:05:51.52,Default,,0000,0000,0000,,Бұл бала...!
Dialogue: 0,0:05:47.85,0:05:51.52,Default,,0000,0000,0000,,Сыртқа шығып сөйлесейік.
Dialogue: 0,0:05:51.52,0:05:53.85,Default,,0000,0000,0000,,Сенши қорқады｠
Dialogue: 0,0:05:53.85,0:05:56.36,Default,,0000,0000,0000,,(Гирин мен Бриганның айқайы)
Dialogue: 0,0:05:56.36,0:05:59.03,Default,,0000,0000,0000,,《Сенші: Бір-біріне айқайлаған дауыстар
Dialogue: 0,0:05:56.36,0:05:59.03,Default,,0000,0000,0000,,Біртіндеп күшейе түседі➡
Dialogue: 0,0:05:59.03,0:06:03.13,Default,,0000,0000,0000,,Қатты ұрыс дыбыстары мен айқайлар
Dialogue: 0,0:05:59.03,0:06:03.13,Default,,0000,0000,0000,,Мен мұны бірнеше рет естідім...》
Dialogue: 0,0:06:03.13,0:06:06.03,Default,,0000,0000,0000,,(Айқай)
Dialogue: 0,0:06:10.30,0:06:13.31,Default,,0000,0000,0000,,《Sensi: Қорқынышты
Dialogue: 0,0:06:10.30,0:06:13.31,Default,,0000,0000,0000,,Тыныш болды》
Dialogue: 0,0:06:13.31,0:06:15.31,Default,,0000,0000,0000,,｟Га.
Dialogue: 0,0:06:13.31,0:06:15.31,Default,,0000,0000,0000,,Сол екеу ме?
Dialogue: 0,0:06:15.31,0:06:17.48,Default,,0000,0000,0000,,Жерде не бар? Бриган ше?
Dialogue: 0,0:06:17.48,0:06:22.15,Default,,0000,0000,0000,,Тыныш қалмаңыз!
Dialogue: 0,0:06:17.48,0:06:22.15,Default,,0000,0000,0000,,Сыртқа қарамаған дұрыс.
Dialogue: 0,0:06:22.15,0:06:24.98,Default,,0000,0000,0000,,Маған грифон шабуыл жасады.
Dialogue: 0,0:06:24.98,0:06:28.99,Default,,0000,0000,0000,,Мен грифонды өлтірдім.
Dialogue: 0,0:06:24.98,0:06:28.99,Default,,0000,0000,0000,,Бриган да бірден қайтыс болды.
Dialogue: 0,0:06:28.99,0:06:31.66,Default,,0000,0000,0000,,Ха…｠
Dialogue: 0,0:06:28.99,0:06:31.66,Default,,0000,0000,0000,,《Сенси: Гириннің басына қарасам➡
Dialogue: 0,0:06:31.66,0:06:36.00,Default,,0000,0000,0000,,Доғал қарудың қандай да бір түрімен ұрылған сияқты.
Dialogue: 0,0:06:31.66,0:06:36.00,Default,,0000,0000,0000,,Шұңқыр болды》
Dialogue: 0,0:06:36.00,0:06:38.33,Default,,0000,0000,0000,,｟Грифинді жейік.
Dialogue: 0,0:06:38.33,0:06:41.33,Default,,0000,0000,0000,,Оны кесіп, сорпа жасасаңыз...
Dialogue: 0,0:06:41.33,0:06:43.84,Default,,0000,0000,0000,,Сіз бірнеше күн өмір сүре аласыз｠
Dialogue: 0,0:06:55.35,0:06:58.68,Default,,0000,0000,0000,,《Сенси: жаңа ғана суға қайнатылған
Dialogue: 0,0:06:55.35,0:06:58.68,Default,,0000,0000,0000,,Грифин сорпасы➡
Dialogue: 0,0:06:58.68,0:07:02.79,Default,,0000,0000,0000,,Аңның иісімен, етінің қаттылығымен
Dialogue: 0,0:06:58.68,0:07:02.79,Default,,0000,0000,0000,,Дәмі қорқынышты болды...》
Dialogue: 0,0:07:02.79,0:07:05.29,Default,,0000,0000,0000,,｟мм... иә...｠
Dialogue: 0,0:07:05.29,0:07:07.63,Default,,0000,0000,0000,,《Sensi: Аңырап шайнау➡
Dialogue: 0,0:07:07.63,0:07:11.80,Default,,0000,0000,0000,,баяу
Dialogue: 0,0:07:07.63,0:07:11.80,Default,,0000,0000,0000,,Мен ұзақ уақыт жұтып қойдым.
Dialogue: 0,0:07:11.80,0:07:19.64,Default,,0000,0000,0000,,Маған зәр шығаратыныңды айт.
Dialogue: 0,0:07:11.80,0:07:19.64,Default,,0000,0000,0000,,Ол далаға шықты...
Dialogue: 0,0:07:19.64,0:07:22.14,Default,,0000,0000,0000,,Ешқашан қайтарылмады.
Dialogue: 0,0:07:22.14,0:07:25.65,Default,,0000,0000,0000,,Мен жалғыз қалдым.
Dialogue: 0,0:07:25.65,0:07:28.98,Default,,0000,0000,0000,,Менің есіктің арғы жағындағы көріністі көруге батылым жетпейді➡
Dialogue: 0,0:07:28.98,0:07:33.15,Default,,0000,0000,0000,,Мен бөлменің ішінен қозғала алмадым, бірақ...
Dialogue: 0,0:07:33.15,0:07:35.66,Default,,0000,0000,0000,,Қалған етпен тірі жүргенде➡
Dialogue: 0,0:07:35.66,0:07:38.66,Default,,0000,0000,0000,,Осы уақытқа дейін салған карталарыма қарадым.
Dialogue: 0,0:07:38.66,0:07:42.33,Default,,0000,0000,0000,,Қабырғадағы кодқа
Dialogue: 0,0:07:38.66,0:07:42.33,Default,,0000,0000,0000,,Заңдылықты табыңыз➡
Dialogue: 0,0:07:42.33,0:07:46.33,Default,,0000,0000,0000,,өз шешіміңді қабылда
Dialogue: 0,0:07:42.33,0:07:46.33,Default,,0000,0000,0000,,Мен бөлмеден шыққанда...》
Dialogue: 0,0:07:48.33,0:07:50.34,Default,,0000,0000,0000,,｟А...｠
Dialogue: 0,0:07:50.34,0:07:52.34,Default,,0000,0000,0000,,《Сенси: Ешқандай дене болған жоқ.
Dialogue: 0,0:07:52.34,0:07:56.84,Default,,0000,0000,0000,,Әртүрлі тіршілік иелері таза
Dialogue: 0,0:07:52.34,0:07:56.84,Default,,0000,0000,0000,,Оны жеп қойған болуы керек.
Dialogue: 0,0:07:56.84,0:07:59.68,Default,,0000,0000,0000,,Кейін орктар басып алды➡
Dialogue: 0,0:07:59.68,0:08:03.45,Default,,0000,0000,0000,,Ауылда біраз уақыт
Dialogue: 0,0:07:59.68,0:08:03.45,Default,,0000,0000,0000,,Әскери тұтқын ретінде ұсталды.
Dialogue: 0,0:08:03.45,0:08:06.95,Default,,0000,0000,0000,,Біз сөйлескен кезде
Dialogue: 0,0:08:03.45,0:08:06.95,Default,,0000,0000,0000,,Таңқаларлық жақсы адамдар➡
Dialogue: 0,0:08:06.95,0:08:09.62,Default,,0000,0000,0000,,Ежелгі ергежейлі тілін оқытудың орнына ➡
Dialogue: 0,0:08:09.62,0:08:13.13,Default,,0000,0000,0000,,Жеуге болатын және жеуге жарамсыз саңырауқұлақтар
Dialogue: 0,0:08:09.62,0:08:13.13,Default,,0000,0000,0000,,қалай ажыратуға болады және ➡
Dialogue: 0,0:08:13.13,0:08:15.80,Default,,0000,0000,0000,,Құбыжықтармен күресуді үйрендім.
Dialogue: 0,0:08:15.80,0:08:18.97,Default,,0000,0000,0000,,Осылайша мен...》
Dialogue: 0,0:08:18.97,0:08:21.77,Default,,0000,0000,0000,,｟Аа... ИА...｠
Dialogue: 0,0:08:24.30,0:08:27.97,Default,,0000,0000,0000,,《Сенші: Жерге
Dialogue: 0,0:08:24.30,0:08:27.97,Default,,0000,0000,0000,,Мен шыға алдым.
Dialogue: 0,0:08:27.97,0:08:32.14,Default,,0000,0000,0000,,Бірақ мен
Dialogue: 0,0:08:27.97,0:08:32.14,Default,,0000,0000,0000,,Не болғанын қарастыру➡
Dialogue: 0,0:08:32.14,0:08:34.81,Default,,0000,0000,0000,,Туған жеріме қайтып барғым келмейді➡
Dialogue: 0,0:08:34.81,0:08:38.99,Default,,0000,0000,0000,,Олар лабиринттердің жанында және таяз жерлерде өмір сүрген.
Dialogue: 0,0:08:38.99,0:08:42.32,Default,,0000,0000,0000,,Сайып келгенде, жердегі қала мен лабиринт қосылады➡
Dialogue: 0,0:08:42.32,0:08:45.66,Default,,0000,0000,0000,,Көптеген авантюристер
Dialogue: 0,0:08:42.32,0:08:45.66,Default,,0000,0000,0000,,Ол келе бастады.
Dialogue: 0,0:08:45.66,0:08:47.66,Default,,0000,0000,0000,,Мені уайымдағаны➡ болды
Dialogue: 0,0:08:47.66,0:08:51.83,Default,,0000,0000,0000,,Бұл шынымен Гриффиндікі
Dialogue: 0,0:08:47.66,0:08:51.83,Default,,0000,0000,0000,,Бұл ет болды ма?
Dialogue: 0,0:08:51.83,0:08:55.84,Default,,0000,0000,0000,,Мен бірдеңе жеген сайын
Dialogue: 0,0:08:51.83,0:08:55.84,Default,,0000,0000,0000,,Сорпаның дәмі есімде.
Dialogue: 0,0:08:55.84,0:09:00.77,Default,,0000,0000,0000,,Кез келген құбыжықтың еті
Dialogue: 0,0:08:55.84,0:09:00.77,Default,,0000,0000,0000,,Бұл дәмнен алыс болды》
Dialogue: 0,0:09:00.77,0:09:05.28,Default,,0000,0000,0000,,Бл…ээ…!!
Dialogue: 0,0:09:00.77,0:09:05.28,Default,,0000,0000,0000,,Сондықтан мен Гриффиннен қаштым.
Dialogue: 0,0:09:05.28,0:09:12.45,Default,,0000,0000,0000,,Мен шындықты білуден қорқамын.
Dialogue: 0,0:09:05.28,0:09:12.45,Default,,0000,0000,0000,,Міне солай болды...
Dialogue: 0,0:09:12.45,0:09:15.45,Default,,0000,0000,0000,,Сенси….
Dialogue: 0,0:09:15.45,0:09:17.79,Default,,0000,0000,0000,,Ал, мына грифонды сынап көрейік.
Dialogue: 0,0:09:17.79,0:09:19.79,Default,,0000,0000,0000,,Ха! ?
Dialogue: 0,0:09:17.79,0:09:19.79,Default,,0000,0000,0000,,О, жоқ...
Dialogue: 0,0:09:19.79,0:09:21.96,Default,,0000,0000,0000,,Алда ұзақ өмір, әрбір ас➡
Dialogue: 0,0:09:21.96,0:09:24.80,Default,,0000,0000,0000,,Сол нәрсе менің басымнан өтіп жатыр.
Dialogue: 0,0:09:21.96,0:09:24.80,Default,,0000,0000,0000,,Бұл шығын болар еді.
Dialogue: 0,0:09:24.80,0:09:28.97,Default,,0000,0000,0000,,Дәмі бірдей болса, сенімді бола аласыз.
Dialogue: 0,0:09:24.80,0:09:28.97,Default,,0000,0000,0000,,Дәмі ұқсас, бірақ ұқсас болмаса...
Dialogue: 0,0:09:28.97,0:09:32.31,Default,,0000,0000,0000,,Кешіріңіз, бірақ мен жүрегімдегі ауырсынудан құтыла аламын.
Dialogue: 0,0:09:32.31,0:09:36.14,Default,,0000,0000,0000,,Жоқ, бұл пайдалырақ болады.
Dialogue: 0,0:09:32.31,0:09:36.14,Default,,0000,0000,0000,,Ол кім?
Dialogue: 0,0:09:36.14,0:09:39.35,Default,,0000,0000,0000,,Сенші, сен қалай ойлайсың?
Dialogue: 0,0:09:36.14,0:09:39.35,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:09:41.31,0:09:44.15,Default,,0000,0000,0000,,Иә, оны жеу керек.
Dialogue: 0,0:09:44.15,0:09:46.49,Default,,0000,0000,0000,,Сенси….
Dialogue: 0,0:09:46.49,0:09:48.49,Default,,0000,0000,0000,,Жарайды! Олай болса➡
Dialogue: 0,0:09:48.49,0:09:51.16,Default,,0000,0000,0000,,Мүмкіндігінше
Dialogue: 0,0:09:48.49,0:09:51.16,Default,,0000,0000,0000,,Сол күндердің тағамдарын қайталап көрейік.
Dialogue: 0,0:09:51.16,0:09:53.49,Default,,0000,0000,0000,,Етті көп өңдемей кесіңіз.
Dialogue: 0,0:09:53.49,0:09:57.00,Default,,0000,0000,0000,,Дененің үстіңгі және астыңғы бөлігінде дәм мүлдем жоқ.
Dialogue: 0,0:09:53.49,0:09:57.00,Default,,0000,0000,0000,,Басқаша болуы мүмкін➡
Dialogue: 0,0:09:57.00,0:10:00.30,Default,,0000,0000,0000,,Екеуінен де алыңыз.
Dialogue: 0,0:09:57.00,0:10:00.30,Default,,0000,0000,0000,,Сіз жай ғана тамақтанғыңыз келеді.
Dialogue: 0,0:10:04.17,0:10:08.01,Default,,0000,0000,0000,,Бұл керемет бұлшықеттер. Етқоректіден күткендей.
Dialogue: 0,0:10:08.01,0:10:11.84,Default,,0000,0000,0000,,Неліктен грифондар сенсиді өлтірді?
Dialogue: 0,0:10:08.01,0:10:11.84,Default,,0000,0000,0000,,Менің ойымша, олар оны аяусыз қуды.
Dialogue: 0,0:10:11.84,0:10:15.35,Default,,0000,0000,0000,,Біреуді өлтірсең де
Dialogue: 0,0:10:11.84,0:10:15.35,Default,,0000,0000,0000,,Сіз оны жеген жоқсыз, солай ма?
Dialogue: 0,0:10:15.35,0:10:18.02,Default,,0000,0000,0000,,А, сен өзіңмен бірге жылқы әкелдім дедің бе?
Dialogue: 0,0:10:18.02,0:10:21.02,Default,,0000,0000,0000,,Гриффин жылқыларды жақсы көретіндіктен деп ойлаймын.
Dialogue: 0,0:10:21.02,0:10:25.19,Default,,0000,0000,0000,,Ендеше, бірінші кезекте неліктен?
Dialogue: 0,0:10:21.02,0:10:25.19,Default,,0000,0000,0000,,Сіз атқа шабуыл жасаған жоқсыз ба?
Dialogue: 0,0:10:21.02,0:10:25.19,Default,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,0:10:25.19,0:10:27.69,Default,,0000,0000,0000,,Суды қайнатайық.
Dialogue: 0,0:10:29.70,0:10:32.37,Default,,0000,0000,0000,,《Грифиннің қаруы
Dialogue: 0,0:10:29.70,0:10:32.37,Default,,0000,0000,0000,,Алдыңғы тырнақтар мен тұмсық.
Dialogue: 0,0:10:32.37,0:10:36.37,Default,,0000,0000,0000,,Саған шабуыл жасалса да, доғал қарумен.
Dialogue: 0,0:10:32.37,0:10:36.37,Default,,0000,0000,0000,,Сізді жұдырықпен ұрғандай белгілер болмайды.
Dialogue: 0,0:10:36.37,0:10:40.37,Default,,0000,0000,0000,,Сонымен Бриганды кім өлтірді?
Dialogue: 0,0:10:36.37,0:10:40.37,Default,,0000,0000,0000,,Гриффин емес шығар.
Dialogue: 0,0:10:40.37,0:10:43.38,Default,,0000,0000,0000,,Сонда қалған үшеуі ше?
Dialogue: 0,0:10:43.38,0:10:46.88,Default,,0000,0000,0000,,Біз Фарин мен Гриффинміз.
Dialogue: 0,0:10:43.38,0:10:46.88,Default,,0000,0000,0000,,Мен қате түсінгендей➡
Dialogue: 0,0:10:46.88,0:10:49.05,Default,,0000,0000,0000,,Бұл басқа құбыжық болуы мүмкін бе?
Dialogue: 0,0:10:49.05,0:10:52.22,Default,,0000,0000,0000,,Егер бұл қанаты бар үлкен құбыжық болса.
Dialogue: 0,0:10:49.05,0:10:52.22,Default,,0000,0000,0000,,Түрлері көп.
Dialogue: 0,0:10:52.22,0:10:55.89,Default,,0000,0000,0000,,Кокатрис, Базилиск, Гарпи, Сирена.
Dialogue: 0,0:10:55.89,0:10:58.89,Default,,0000,0000,0000,,Pegasus Simurg жартас құсы….
Dialogue: 0,0:10:58.89,0:11:02.33,Default,,0000,0000,0000,,Ішінде доғал қару сияқты нәрсе бар.
Dialogue: 0,0:10:58.89,0:11:02.33,Default,,0000,0000,0000,,Қарулары бар құбыжықтар...》
Dialogue: 0,0:11:02.33,0:11:05.33,Default,,0000,0000,0000,,Су қайнап тұрды.
Dialogue: 0,0:11:05.33,0:11:07.50,Default,,0000,0000,0000,,Мен оны осылай қайнатуым керек пе?
Dialogue: 0,0:11:07.50,0:11:10.50,Default,,0000,0000,0000,,Басқа ингредиенттер...
Dialogue: 0,0:11:07.50,0:11:10.50,Default,,0000,0000,0000,,Осымен.
Dialogue: 0,0:11:10.50,0:11:13.51,Default,,0000,0000,0000,,《Сорпаны жұмсақ етпеңіз.
Dialogue: 0,0:11:13.51,0:11:15.84,Default,,0000,0000,0000,,Ең болмаса гарнир ретінде...》
Dialogue: 0,0:11:15.84,0:11:17.84,Default,,0000,0000,0000,,Бұл туралы айтатын болсақ➡
Dialogue: 0,0:11:17.84,0:11:20.85,Default,,0000,0000,0000,,Саңырауқұлақтарды еменнен қалай ажыратуға болады
Dialogue: 0,0:11:17.84,0:11:20.85,Default,,0000,0000,0000,,Сіз оны үйрендім дедіңіз➡
Dialogue: 0,0:11:20.85,0:11:24.85,Default,,0000,0000,0000,,Бұл саңырауқұлақты бірінші рет көрдіңіз бе?
Dialogue: 0,0:11:20.85,0:11:24.85,Default,,0000,0000,0000,,Аа, мен оны бірінші рет көрдім.
Dialogue: 0,0:11:26.85,0:11:30.52,Default,,0000,0000,0000,,Марсиль Қалғанын саған қалдырамын.
Dialogue: 0,0:11:26.85,0:11:30.52,Default,,0000,0000,0000,,Иә! ? аздап!
Dialogue: 0,0:11:30.52,0:11:34.03,Default,,0000,0000,0000,,Осыншама жерге барып, оны лақтырып жібересің бе?
Dialogue: 0,0:11:30.52,0:11:34.03,Default,,0000,0000,0000,,Бостандық!
Dialogue: 0,0:11:34.03,0:11:36.03,Default,,0000,0000,0000,,Жетер, бітті.
Dialogue: 0,0:11:36.03,0:11:38.86,Default,,0000,0000,0000,,Сенши осылай жасады...
Dialogue: 0,0:11:36.03,0:11:38.86,Default,,0000,0000,0000,,Жоқ….
Dialogue: 0,0:11:38.86,0:11:41.37,Default,,0000,0000,0000,,Осы жерге жеткенде, тамақ ішейін.
Dialogue: 0,0:11:41.37,0:11:44.37,Default,,0000,0000,0000,,Салдары қандай болса да
Dialogue: 0,0:11:41.37,0:11:44.37,Default,,0000,0000,0000,,Мен оны қабылдаймын.
Dialogue: 0,0:11:44.37,0:11:50.54,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:11:50.54,0:11:53.55,Default,,0000,0000,0000,,Ол аяқталды.
Dialogue: 0,0:11:59.72,0:12:01.65,Default,,0000,0000,0000,,Бұл...!
Dialogue: 0,0:12:01.65,0:12:06.66,Default,,0000,0000,0000,,Сонда ненің дәмін таттың?
Dialogue: 0,0:12:01.65,0:12:06.66,Default,,0000,0000,0000,,Ұқсас болса да, ұқсамайды...
Dialogue: 0,0:12:06.66,0:12:10.66,Default,,0000,0000,0000,,Өйткені, сол кезде
Dialogue: 0,0:12:06.66,0:12:10.66,Default,,0000,0000,0000,,Бүркіттің айтқаны...
Dialogue: 0,0:12:10.66,0:12:15.17,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:12:10.66,0:12:15.17,Default,,0000,0000,0000,,Жарайды. Менің иығымнан жүк көтерілді.
Dialogue: 0,0:12:15.17,0:12:19.17,Default,,0000,0000,0000,,Не істесеңіз де
Dialogue: 0,0:12:15.17,0:12:19.17,Default,,0000,0000,0000,,Оның аман қалғанын қаласа керек.
Dialogue: 0,0:12:19.17,0:12:22.34,Default,,0000,0000,0000,,Сол сезім
Dialogue: 0,0:12:19.17,0:12:22.34,Default,,0000,0000,0000,,Оны арқамызға көтеріп алайық.
Dialogue: 0,0:12:22.34,0:12:25.51,Default,,0000,0000,0000,,Лайостың ақымақ!
Dialogue: 0,0:12:22.34,0:12:25.51,Default,,0000,0000,0000,,Сіз не істедіңіз?
Dialogue: 0,0:12:25.51,0:12:28.35,Default,,0000,0000,0000,,Ммм... ммм...
Dialogue: 0,0:12:28.35,0:12:32.35,Default,,0000,0000,0000,,Гриффин еті…
Dialogue: 0,0:12:28.35,0:12:32.35,Default,,0000,0000,0000,,Жануарлардың иісі күшті және қатты.
Dialogue: 0,0:12:32.35,0:12:34.85,Default,,0000,0000,0000,,Ең бастысы, кейінгі дәм ең нашар.
Dialogue: 0,0:12:34.85,0:12:36.86,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:12:36.86,0:12:38.86,Default,,0000,0000,0000,,Сенші сол кезде не жеді➡
Dialogue: 0,0:12:38.86,0:12:41.36,Default,,0000,0000,0000,,Гриффин емес.
Dialogue: 0,0:12:38.86,0:12:41.36,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:12:41.36,0:12:44.03,Default,,0000,0000,0000,,Бұл тіпті адам еті де емес.
Dialogue: 0,0:12:44.03,0:12:49.20,Default,,0000,0000,0000,,Оларға кім шабуыл жасады
Dialogue: 0,0:12:44.03,0:12:49.20,Default,,0000,0000,0000,,Бұл грифон емес, гиппогриф.
Dialogue: 0,0:12:44.03,0:12:49.20,Default,,0000,0000,0000,,Гиппогриф?
Dialogue: 0,0:12:49.20,0:12:53.71,Default,,0000,0000,0000,,Гриффиннің төменгі денесі арыстандікі.
Dialogue: 0,0:12:49.20,0:12:53.71,Default,,0000,0000,0000,,Гиппогрифтер жылқылармен тығыз байланысты.
Dialogue: 0,0:12:53.71,0:12:56.71,Default,,0000,0000,0000,,Мені тынымсыз қуған
Dialogue: 0,0:12:53.71,0:12:56.71,Default,,0000,0000,0000,,Қасында ат болғандықтан болар.
Dialogue: 0,0:12:56.71,0:12:59.71,Default,,0000,0000,0000,,Қызығушылығы?
Dialogue: 0,0:12:56.71,0:12:59.71,Default,,0000,0000,0000,,Ыстықта болған шығар.
Dialogue: 0,0:12:59.71,0:13:02.98,Default,,0000,0000,0000,,Ал гиппогриф
Dialogue: 0,0:12:59.71,0:13:02.98,Default,,0000,0000,0000,,Грифондарда жоқ қарулары бар.
Dialogue: 0,0:13:02.98,0:13:07.15,Default,,0000,0000,0000,,Бұл тұяқтары бар артқы аяқ.
Dialogue: 0,0:13:02.98,0:13:07.15,Default,,0000,0000,0000,,Егер бұл жігіт сені тепсе➡
Dialogue: 0,0:13:07.15,0:13:10.49,Default,,0000,0000,0000,,Металл болса да
Dialogue: 0,0:13:07.15,0:13:10.49,Default,,0000,0000,0000,,Үлкен тесік болуы керек.
Dialogue: 0,0:13:10.49,0:13:13.49,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:13:10.49,0:13:13.49,Default,,0000,0000,0000,,Ант етемін, Сенші!
Dialogue: 0,0:13:13.49,0:13:16.33,Default,,0000,0000,0000,,Сол кезде Сенші не жеді
Dialogue: 0,0:13:13.49,0:13:16.33,Default,,0000,0000,0000,,Егер бұл гиппогриф➡ болса
Dialogue: 0,0:13:16.33,0:13:19.33,Default,,0000,0000,0000,,Дәмі бұл сорпадан өзгеше болуы ғажап емес!
Dialogue: 0,0:13:21.33,0:13:27.67,Default,,0000,0000,0000,,Хаха Рахмет, Райос.
Dialogue: 0,0:13:21.33,0:13:27.67,Default,,0000,0000,0000,,Соны естігенде біраз жеңілдеп қалдым.
Dialogue: 0,0:13:27.67,0:13:31.68,Default,,0000,0000,0000,,Гиппогрифтің дәмі
Dialogue: 0,0:13:27.67,0:13:31.68,Default,,0000,0000,0000,,Сенімді болудың жолы жоқ.
Dialogue: 0,0:13:33.68,0:13:37.02,Default,,0000,0000,0000,,Олай болса, тексеріп көрейік.
Dialogue: 0,0:13:33.68,0:13:37.02,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:37.02,0:13:39.69,Default,,0000,0000,0000,,Іс жүзінде гиппогрифтің еті және
Dialogue: 0,0:13:37.02,0:13:39.69,Default,,0000,0000,0000,,Тамақ ішіп, салыстыр.
Dialogue: 0,0:13:39.69,0:13:41.69,Default,,0000,0000,0000,,Онда ➡
Dialogue: 0,0:13:41.69,0:13:44.19,Default,,0000,0000,0000,,«Шындық белгісіз, бірақ
Dialogue: 0,0:13:41.69,0:13:44.19,Default,,0000,0000,0000,,«Ичирудың үміті келді» ➡
Dialogue: 0,0:13:44.19,0:13:48.86,Default,,0000,0000,0000,,Ағын ақырын аяқталады! ?
Dialogue: 0,0:13:44.19,0:13:48.86,Default,,0000,0000,0000,,Айтайын дегенім, гиппогриф қайда?
Dialogue: 0,0:13:48.86,0:13:52.87,Default,,0000,0000,0000,,Жоқ, иппогриф дәл осы жерде!
Dialogue: 0,0:13:52.87,0:13:56.20,Default,,0000,0000,0000,,Бұл лабиринтте
Dialogue: 0,0:13:52.87,0:13:56.20,Default,,0000,0000,0000,,Бұрын хабарланған жағдайлар болған болуы керек.
Dialogue: 0,0:13:56.20,0:13:59.04,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:13:56.20,0:13:59.04,Default,,0000,0000,0000,,Мұны неге байқамадың?
Dialogue: 0,0:13:59.04,0:14:02.31,Default,,0000,0000,0000,,«Бұл лабиринтте ешкім болмауы керек.
Dialogue: 0,0:13:59.04,0:14:02.31,Default,,0000,0000,0000,,Өйткені мен грифонмен шайқастым».
Dialogue: 0,0:14:02.31,0:14:04.31,Default,,0000,0000,0000,,Неге! ?
Dialogue: 0,0:14:04.31,0:14:07.15,Default,,0000,0000,0000,,Бұл жағдайды күрделендірді.
Dialogue: 0,0:14:04.31,0:14:07.15,Default,,0000,0000,0000,,«Сыбайластың» жұмысы.
Dialogue: 0,0:14:07.15,0:14:09.98,Default,,0000,0000,0000,,Сыбайлас?
Dialogue: 0,0:14:09.98,0:14:12.15,Default,,0000,0000,0000,,Бұл өзгертуші.
Dialogue: 0,0:14:12.15,0:14:14.15,Default,,0000,0000,0000,,Ах...!
Dialogue: 0,0:14:12.15,0:14:14.15,Default,,0000,0000,0000,,Бұл туралы айтатын болсақ➡
Dialogue: 0,0:14:14.15,0:14:16.82,Default,,0000,0000,0000,,Чилчактың туған жерінің төңірегі
Dialogue: 0,0:14:14.15,0:14:16.82,Default,,0000,0000,0000,,Бұл дәстүр болды ма?
Dialogue: 0,0:14:16.82,0:14:19.66,Default,,0000,0000,0000,,«Өзгерту» дегеніміз не?
Dialogue: 0,0:14:16.82,0:14:19.66,Default,,0000,0000,0000,,Сіз бұл туралы ешқашан естімегенсіз бе?
Dialogue: 0,0:14:19.66,0:14:22.33,Default,,0000,0000,0000,,Балалар мен құбыжықтар
Dialogue: 0,0:14:19.66,0:14:22.33,Default,,0000,0000,0000,,Бұл ауысу құбылысы.
Dialogue: 0,0:14:22.33,0:14:24.50,Default,,0000,0000,0000,,Бала ойнауға орманға барды➡
Dialogue: 0,0:14:24.50,0:14:27.83,Default,,0000,0000,0000,,Екі бірдей фигура
Dialogue: 0,0:14:24.50,0:14:27.83,Default,,0000,0000,0000,,Тролль ретінде қайтады.
Dialogue: 0,0:14:27.83,0:14:30.67,Default,,0000,0000,0000,,Ол бұрыннан сиқырдың бір түрі болып саналған.
Dialogue: 0,0:14:27.83,0:14:30.67,Default,,0000,0000,0000,,Ойланды➡
Dialogue: 0,0:14:30.67,0:14:35.17,Default,,0000,0000,0000,,Соңғы жылдары бұл саңырауқұлақ тәрізді
Dialogue: 0,0:14:30.67,0:14:35.17,Default,,0000,0000,0000,,Бұл жынның ісі болып шықты.
Dialogue: 0,0:14:35.17,0:14:37.84,Default,,0000,0000,0000,,Бұл саңырауқұлақ сақинасында
Dialogue: 0,0:14:35.17,0:14:37.84,Default,,0000,0000,0000,,Мен қадам басқан жаратылыс➡
Dialogue: 0,0:14:37.84,0:14:39.85,Default,,0000,0000,0000,,Ол сәл ғана «өзгереді».
Dialogue: 0,0:14:39.85,0:14:42.68,Default,,0000,0000,0000,,Себеп белгілі болғаннан кейін
Dialogue: 0,0:14:39.85,0:14:42.68,Default,,0000,0000,0000,,Жою жүріп жатыр➡
Dialogue: 0,0:14:42.68,0:14:46.35,Default,,0000,0000,0000,,Мен оны енді көп көрмеймін
Dialogue: 0,0:14:42.68,0:14:46.35,Default,,0000,0000,0000,,Бұндай жерде өседі деп ойламаппын.
Dialogue: 0,0:14:46.35,0:14:49.36,Default,,0000,0000,0000,,Сеншіні алып қашсаң да
Dialogue: 0,0:14:46.35,0:14:49.36,Default,,0000,0000,0000,,Тамақ ішпеу.
Dialogue: 0,0:14:49.36,0:14:52.52,Default,,0000,0000,0000,,Шақырылған аңды өлтірген сол өткір соққы.
Dialogue: 0,0:14:52.52,0:14:56.53,Default,,0000,0000,0000,,Мүмкін
Dialogue: 0,0:14:52.52,0:14:56.53,Default,,0000,0000,0000,,Бұл грифонмен біз шайқасқанбыз...
Dialogue: 0,0:14:56.53,0:14:58.70,Default,,0000,0000,0000,,Тексерейік.
Dialogue: 0,0:14:58.70,0:15:03.20,Default,,0000,0000,0000,,грифон еті
Dialogue: 0,0:14:58.70,0:15:03.20,Default,,0000,0000,0000,,айырбастаушының ертегі сақинасына...
Dialogue: 0,0:15:05.47,0:15:09.98,Default,,0000,0000,0000,,Еттің түрі өзгерді!
Dialogue: 0,0:15:05.47,0:15:09.98,Default,,0000,0000,0000,,Сашими қосылғанда дәмді көрінеді.
Dialogue: 0,0:15:09.98,0:15:12.48,Default,,0000,0000,0000,,Жарайды, соны сорпа жасайық.
Dialogue: 0,0:15:31.00,0:15:36.17,Default,,0000,0000,0000,,Уф... Уф!
Dialogue: 0,0:15:31.00,0:15:36.17,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:15:36.17,0:15:38.84,Default,,0000,0000,0000,,Сенси! ?
Dialogue: 0,0:15:36.17,0:15:38.84,Default,,0000,0000,0000,,Ма Маа➡
Dialogue: 0,0:15:38.84,0:15:42.84,Default,,0000,0000,0000,,Дәмі жағдай мен ортаға байланысты
Dialogue: 0,0:15:38.84,0:15:42.84,Default,,0000,0000,0000,,Бұл туралы алаңдамаңыз, ол біршама өзгереді.
Dialogue: 0,0:15:42.84,0:15:47.35,Default,,0000,0000,0000,,Жоқ... олай емес...
Dialogue: 0,0:15:47.35,0:15:53.35,Default,,0000,0000,0000,,Мәңгі... мәңгілік осы сорпа
Dialogue: 0,0:15:47.35,0:15:53.35,Default,,0000,0000,0000,,Мен оны тағы да ішкім келді...
Dialogue: 0,0:15:56.36,0:16:00.63,Default,,0000,0000,0000,,Рахмет... барлығыңызға.
Dialogue: 0,0:16:00.63,0:16:04.13,Default,,0000,0000,0000,,Рахмет….
Dialogue: 0,0:16:04.13,0:16:09.30,Default,,0000,0000,0000,,Лабиринтте ұзақ өмір сүру
Dialogue: 0,0:16:04.13,0:16:09.30,Default,,0000,0000,0000,,Мен бір нәрсені байқадым.
Dialogue: 0,0:16:09.30,0:16:13.64,Default,,0000,0000,0000,,Бұл лабиринт
Dialogue: 0,0:16:09.30,0:16:13.64,Default,,0000,0000,0000,,Адамдардың қалауына қатты әсер етеді.
Dialogue: 0,0:16:13.64,0:16:17.48,Default,,0000,0000,0000,,Байлық Білім Даңқы.
Dialogue: 0,0:16:17.48,0:16:19.48,Default,,0000,0000,0000,,Орктар сияқты➡
Dialogue: 0,0:16:19.48,0:16:22.98,Default,,0000,0000,0000,,Лабиринтке, «Іздемейтіндерге»
Dialogue: 0,0:16:19.48,0:16:22.98,Default,,0000,0000,0000,,Мен бұған төзімдімін, бірақ ➡
Dialogue: 0,0:16:22.98,0:16:26.32,Default,,0000,0000,0000,,Бірдеңені сұрай салысымен азу тістерін ақтарады.
Dialogue: 0,0:16:26.32,0:16:28.49,Default,,0000,0000,0000,,Бұдан былай, балалар➡
Dialogue: 0,0:16:28.49,0:16:31.82,Default,,0000,0000,0000,,Фаринді қайтару үшін
Dialogue: 0,0:16:28.49,0:16:31.82,Default,,0000,0000,0000,,Мақсатқа қосымша➡
Dialogue: 0,0:16:31.82,0:16:37.00,Default,,0000,0000,0000,,Ақылсыз сиқыршы
Dialogue: 0,0:16:31.82,0:16:37.00,Default,,0000,0000,0000,,Қанатты арыстанды іздейсің.
Dialogue: 0,0:16:37.00,0:16:41.00,Default,,0000,0000,0000,,Лабиринттің реакциясы
Dialogue: 0,0:16:37.00,0:16:41.00,Default,,0000,0000,0000,,Ол одан да ауыр болады.
Dialogue: 0,0:16:41.00,0:16:43.00,Default,,0000,0000,0000,,Әлі де...
Dialogue: 0,0:16:43.00,0:16:47.01,Default,,0000,0000,0000,,Мен саған
Dialogue: 0,0:16:43.00,0:16:47.01,Default,,0000,0000,0000,,Саған үйреткім келетін нәрселер көп.
Dialogue: 0,0:16:47.01,0:16:49.34,Default,,0000,0000,0000,,Сіз мені өзіңізбен бірге ала аласыз ба?
Dialogue: 0,0:16:49.34,0:16:51.64,Default,,0000,0000,0000,,Хэхе….
Dialogue: 0,0:16:49.34,0:16:51.64,Default,,0000,0000,0000,,А, әрине!
Dialogue: 0,0:16:55.68,0:16:57.85,Default,,0000,0000,0000,,Жарайсыңдар бәріңе!
Dialogue: 0,0:16:57.85,0:17:00.15,Default,,0000,0000,0000,,Әрі қарай жүрейік!
Dialogue: 0,0:17:06.46,0:17:10.30,Default,,0000,0000,0000,,Барлығы... Көңіл күйлеріңіз қалай?
Dialogue: 0,0:17:06.46,0:17:10.30,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:17:10.30,0:17:12.30,Default,,0000,0000,0000,,Суық...
Dialogue: 0,0:17:10.30,0:17:12.30,Default,,0000,0000,0000,,Мүмкін емес...
Dialogue: 0,0:17:12.30,0:17:15.63,Default,,0000,0000,0000,,《Қалай қарасаң да, тамақтан улану.''
Dialogue: 0,0:17:15.63,0:17:19.30,Default,,0000,0000,0000,,Көптеген әртүрлі заттар
Dialogue: 0,0:17:15.63,0:17:19.30,Default,,0000,0000,0000,,Өйткені мен мұны айтып жүрмін.
Dialogue: 0,0:17:19.30,0:17:22.64,Default,,0000,0000,0000,,Бірақ мұндай жерде
Dialogue: 0,0:17:19.30,0:17:22.64,Default,,0000,0000,0000,,Бұл аяқталмайды ...
Dialogue: 0,0:17:22.64,0:17:25.98,Default,,0000,0000,0000,,Фарин…》
Dialogue: 0,0:17:25.98,0:17:27.98,Default,,0000,0000,0000,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:17:27.98,0:17:30.82,Default,,0000,0000,0000,,《Қанша ұйықтадың?
Dialogue: 0,0:17:27.98,0:17:30.82,Default,,0000,0000,0000,,Жеңіл дене.
Dialogue: 0,0:17:30.82,0:17:33.15,Default,,0000,0000,0000,,Азық-түлік мәселесі басылды ма?
Dialogue: 0,0:17:33.15,0:17:36.16,Default,,0000,0000,0000,,Жақсы, не болады екен...》
Dialogue: 0,0:17:36.16,0:17:38.49,Default,,0000,0000,0000,,О? иә?
Dialogue: 0,0:17:38.49,0:17:40.99,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:17:40.99,0:17:43.16,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:17:40.99,0:17:43.16,Default,,0000,0000,0000,,Ах, Марсиль.
Dialogue: 0,0:17:43.16,0:17:46.33,Default,,0000,0000,0000,,Мынаны қара!
Dialogue: 0,0:17:43.16,0:17:46.33,Default,,0000,0000,0000,,Менің денемде ақау бар... а?
Dialogue: 0,0:17:46.33,0:17:49.50,Default,,0000,0000,0000,,Мм.
Dialogue: 0,0:17:49.50,0:17:52.67,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:17:49.50,0:17:52.67,Default,,0000,0000,0000,,Уау! Марсиль де кішірейіп барады! ?
Dialogue: 0,0:17:52.67,0:17:55.01,Default,,0000,0000,0000,,Сенши Бұл қиын! Оян!
Dialogue: 0,0:17:55.01,0:17:57.34,Default,,0000,0000,0000,,Сен….
Dialogue: 0,0:17:57.34,0:17:59.34,Default,,0000,0000,0000,,Сіз кімсіз! ?
Dialogue: 0,0:17:59.34,0:18:02.95,Default,,0000,0000,0000,,Біраздан бері шуылдап жүрсің.
Dialogue: 0,0:18:02.95,0:18:06.62,Default,,0000,0000,0000,,Чил... Чилчак мырза?
Dialogue: 0,0:18:06.62,0:18:09.12,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:18:06.62,0:18:09.12,Default,,0000,0000,0000,,Гяа!
Dialogue: 0,0:18:06.62,0:18:09.12,Default,,0000,0000,0000,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:18:09.12,0:18:11.62,Default,,0000,0000,0000,,Менің ойымша...
Dialogue: 0,0:18:11.62,0:18:15.29,Default,,0000,0000,0000,,Шамасы, біз
Dialogue: 0,0:18:11.62,0:18:15.29,Default,,0000,0000,0000,,Сіз айырбастаушыны басқан сияқтысыз.
Dialogue: 0,0:18:15.29,0:18:20.30,Default,,0000,0000,0000,,Айтайын дегенім...
Dialogue: 0,0:18:15.29,0:18:20.30,Default,,0000,0000,0000,,Гриффинді гиппогрифке айналдыратыны сонша.
Dialogue: 0,0:18:20.30,0:18:22.80,Default,,0000,0000,0000,,Адамдардың бұлай болуы таңқаларлық емес.
Dialogue: 0,0:18:22.80,0:18:26.31,Default,,0000,0000,0000,,Мен ергежейлімін. Сенши - пері.
Dialogue: 0,0:18:26.31,0:18:28.64,Default,,0000,0000,0000,,Марсиль жартылай аяқты ма?
Dialogue: 0,0:18:28.64,0:18:30.64,Default,,0000,0000,0000,,Чилчак – Таллман.
Dialogue: 0,0:18:30.64,0:18:33.98,Default,,0000,0000,0000,,Изуцуми - бұл... ит.
Dialogue: 0,0:18:33.98,0:18:38.65,Default,,0000,0000,0000,,Жоқ, бұл коболд шығар.
Dialogue: 0,0:18:33.98,0:18:38.65,Default,,0000,0000,0000,,Бұл мысық құлақты қобдиша.
Dialogue: 0,0:18:38.65,0:18:42.65,Default,,0000,0000,0000,,Енді. Бастапқы денеме қалай ораламын?
Dialogue: 0,0:18:42.65,0:18:45.49,Default,,0000,0000,0000,,Келген жолымнан қайтудан басқа амалым жоқ.
Dialogue: 0,0:18:42.65,0:18:45.49,Default,,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:18:45.49,0:18:48.16,Default,,0000,0000,0000,,Сондай-ақ, саңырауқұлақ сақинасын бассаңыз
Dialogue: 0,0:18:45.49,0:18:48.16,Default,,0000,0000,0000,,Сіз қайтуға болады, солай ма?
Dialogue: 0,0:18:48.16,0:18:51.66,Default,,0000,0000,0000,,Менің ойымша... сыртқа қара.
Dialogue: 0,0:18:51.66,0:18:54.00,Default,,0000,0000,0000,,Ах! Жол өзгеріп жатыр.
Dialogue: 0,0:18:54.00,0:18:57.50,Default,,0000,0000,0000,,Ұйықтап жатқанда
Dialogue: 0,0:18:54.00,0:18:57.50,Default,,0000,0000,0000,,Мен дірілдеп тұра алмадым➡
Dialogue: 0,0:18:57.50,0:19:00.61,Default,,0000,0000,0000,,Дене емес
Dialogue: 0,0:18:57.50,0:19:00.61,Default,,0000,0000,0000,,Сонда лабиринт дірілдеп тұрды ма?
Dialogue: 0,0:19:00.61,0:19:04.31,Default,,0000,0000,0000,,Мен артқа бұрылатынымды білмеймін...
Dialogue: 0,0:19:00.61,0:19:04.31,Default,,0000,0000,0000,,Су қоймасына оралайық.
Dialogue: 0,0:19:07.78,0:19:11.12,Default,,0000,0000,0000,,《Ой, менің жүгім өте жеңіл》
Dialogue: 0,0:19:11.12,0:19:13.12,Default,,0000,0000,0000,,Ммммм.
Dialogue: 0,0:19:11.12,0:19:13.12,Default,,0000,0000,0000,,Марсиль.
Dialogue: 0,0:19:13.12,0:19:15.79,Default,,0000,0000,0000,,Жүк Мен багажды алып кетемін.
Dialogue: 0,0:19:13.12,0:19:15.79,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:19:15.79,0:19:20.13,Default,,0000,0000,0000,,《Бұл дене әдемі.
Dialogue: 0,0:19:15.79,0:19:20.13,Default,,0000,0000,0000,,Қараңғыда да анық көруге болады.
Dialogue: 0,0:19:20.13,0:19:22.79,Default,,0000,0000,0000,,Намари қазір
Dialogue: 0,0:19:20.13,0:19:22.79,Default,,0000,0000,0000,,Мүмкін сіз армрестлингте жеңе аласыз》
Dialogue: 0,0:19:22.79,0:19:26.63,Default,,0000,0000,0000,,Чилчак ше? Ал бұл дене ше?
Dialogue: 0,0:19:22.79,0:19:26.63,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:19:26.63,0:19:30.64,Default,,0000,0000,0000,,ауыр және мөлдір
Dialogue: 0,0:19:26.63,0:19:30.64,Default,,0000,0000,0000,,Қалың қабықшаға оранғандай...
Dialogue: 0,0:19:30.64,0:19:34.47,Default,,0000,0000,0000,,Бұл сіздің сезіміңіз түтіккен дегенді білдіре ме?
Dialogue: 0,0:19:30.64,0:19:34.47,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:19:34.47,0:19:37.48,Default,,0000,0000,0000,,Дегенмен, ол сондай-ақ біртүрлі тыныштандыратын сезінеді.
Dialogue: 0,0:19:37.48,0:19:42.65,Default,,0000,0000,0000,,Күте тұрыңыз, мен сендерге менсінбей қарай аламын.
Dialogue: 0,0:19:37.48,0:19:42.65,Default,,0000,0000,0000,,Мен өзімді жақсы сезінемін.
Dialogue: 0,0:19:42.65,0:20:02.37,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:20:05.34,0:20:07.64,Default,,0000,0000,0000,,Иә? Сол есік...
Dialogue: 0,0:20:11.68,0:20:16.35,Default,,0000,0000,0000,,Уау! Бұл бірінші баратын жер!
Dialogue: 0,0:20:11.68,0:20:16.35,Default,,0000,0000,0000,,Бұл мысалдың «ішкі» бөлігі ме?
Dialogue: 0,0:20:16.35,0:20:19.85,Default,,0000,0000,0000,,Мен кері қайтуға ниеттімін
Dialogue: 0,0:20:16.35,0:20:19.85,Default,,0000,0000,0000,,Сіз күткендей қозғалдыңыз ба?
Dialogue: 0,0:20:19.85,0:20:22.69,Default,,0000,0000,0000,,Лагердің іздері бар.
Dialogue: 0,0:20:22.69,0:20:25.19,Default,,0000,0000,0000,,Тағы бір авантюрист келген сияқты.
Dialogue: 0,0:20:25.19,0:20:29.19,Default,,0000,0000,0000,,Сол адамдар Бұны қалай емдеуге болады?
Dialogue: 0,0:20:25.19,0:20:29.19,Default,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,0:20:29.19,0:20:31.20,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:20:31.20,0:20:33.87,Default,,0000,0000,0000,,Менің ойымша, ол есіктен ары кеткен жоқ.
Dialogue: 0,0:20:33.87,0:20:36.20,Default,,0000,0000,0000,,Мүмкін телепортация әдістерін пайдаланып жерге оралғаннан кейін.
Dialogue: 0,0:20:36.20,0:20:38.87,Default,,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:20:38.87,0:20:40.87,Default,,0000,0000,0000,,Мен бұл туралы ойладым ...
Dialogue: 0,0:20:40.87,0:20:43.54,Default,,0000,0000,0000,,Қанатты арыстанды іздеуді жалғастыру
Dialogue: 0,0:20:40.87,0:20:43.54,Default,,0000,0000,0000,,Жалғастырамыз ба?
Dialogue: 0,0:20:43.54,0:20:45.88,Default,,0000,0000,0000,,Ха! ?
Dialogue: 0,0:20:43.54,0:20:45.88,Default,,0000,0000,0000,,Сәлем, лабиринт➡
Dialogue: 0,0:20:45.88,0:20:48.55,Default,,0000,0000,0000,,біз
Dialogue: 0,0:20:45.88,0:20:48.55,Default,,0000,0000,0000,,Оның сенің қашып кетуіңе жол бергісі жоқ сияқты.
Dialogue: 0,0:20:48.55,0:20:53.05,Default,,0000,0000,0000,,Күресуге уақыт жоғалтқаннан гөрі
Dialogue: 0,0:20:48.55,0:20:53.05,Default,,0000,0000,0000,,Әрі қарай жылжу жылдамырақ сияқты.
Dialogue: 0,0:20:53.05,0:20:56.89,Default,,0000,0000,0000,,Жоқ, әрине, біз жерге оралған соң
Dialogue: 0,0:20:53.05,0:20:56.89,Default,,0000,0000,0000,,Көптеген шешімдер болуы керек.
Dialogue: 0,0:20:56.89,0:20:59.06,Default,,0000,0000,0000,,Өмір бойы осылай қалудың қажеті жоқ.
Dialogue: 0,0:20:59.06,0:21:02.83,Default,,0000,0000,0000,,Сен ақымақсың ба?
Dialogue: 0,0:20:59.06,0:21:02.83,Default,,0000,0000,0000,,Теме – ұзақ өмір сүретін түрдің денесі
Dialogue: 0,0:20:59.06,0:21:02.83,Default,,0000,0000,0000,,Бұл тең ойын болғандықтан!
Dialogue: 0,0:21:02.83,0:21:04.83,Default,,0000,0000,0000,,Шынында да….
Dialogue: 0,0:21:02.83,0:21:04.83,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:21:04.83,0:21:07.50,Default,,0000,0000,0000,,Бір қызығы, бұл соншалықты ыңғайсыздық емес еді.
Dialogue: 0,0:21:07.50,0:21:10.50,Default,,0000,0000,0000,,Құлақ көлемінің айырмашылығы
Dialogue: 0,0:21:07.50,0:21:10.50,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:21:12.84,0:21:17.34,Default,,0000,0000,0000,,Ал, ары қарай жалғастырайық.
Dialogue: 0,0:21:12.84,0:21:17.34,Default,,0000,0000,0000,,Сен сол есікті не істейсің?
Dialogue: 0,0:21:17.34,0:21:19.85,Default,,0000,0000,0000,,Бұл ашылмайды.
Dialogue: 0,0:21:17.34,0:21:19.85,Default,,0000,0000,0000,,Барлығы шу шығарып жатыр, солай ма?
Dialogue: 0,0:21:19.85,0:21:22.51,Default,,0000,0000,0000,,Чилчак Сіз құлыпты аша аласыз деп ойлайсыз ба?
Dialogue: 0,0:21:22.51,0:21:28.02,Default,,0000,0000,0000,,Құлыпты ашатын құлып немесе ештеңе жоқ.
Dialogue: 0,0:21:22.51,0:21:28.02,Default,,0000,0000,0000,,Бұл сиқырлы қулық емес пе?
Dialogue: 0,0:21:28.02,0:21:34.03,Default,,0000,0000,0000,,Мен бір сиқыр болып жатқандай сезінемін.
Dialogue: 0,0:21:28.02,0:21:34.03,Default,,0000,0000,0000,,Дешифрлеу уақытты, құрал-жабдықты және ақшаны қажет етеді.
Dialogue: 0,0:21:36.03,0:21:39.03,Default,,0000,0000,0000,,Яад! Мұнымен не істейсің?
Dialogue: 0,0:21:39.03,0:21:42.03,Default,,0000,0000,0000,,Маған көмектесші~ Қанатты арыстан~!
Dialogue: 0,0:21:42.03,0:21:44.54,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:21:42.03,0:21:44.54,Default,,0000,0000,0000,,Иә! Эй! Эй, эй!
Dialogue: 0,0:21:44.54,0:21:47.04,Default,,0000,0000,0000,,Райос Бірдеңе келе жатыр!
Dialogue: 0,0:21:47.04,0:21:49.04,Default,,0000,0000,0000,,Уау! Кенсуке! ?
Dialogue: 0,0:21:49.04,0:21:51.54,Default,,0000,0000,0000,,Мен мүлде өспеймін! ?
Dialogue: 0,0:21:51.54,0:21:55.35,Default,,0000,0000,0000,,Мына қақаған суықтан өліп қала жаздадым...
Dialogue: 0,0:22:00.65,0:22:02.65,Default,,0000,0000,0000,,Есік...
Dialogue: 0,0:22:02.65,0:22:06.16,Default,,0000,0000,0000,,Бұл қанатты арыстан
Dialogue: 0,0:22:02.65,0:22:06.16,Default,,0000,0000,0000,,Сен маған күшіңді бересің бе?
Dialogue: 0,0:22:06.16,0:22:10.50,Default,,0000,0000,0000,,Немесе Яадтың арқасында болуы мүмкін.
Dialogue: 0,0:22:06.16,0:22:10.50,Default,,0000,0000,0000,,Ең алдымен рахметімді айтайын!
Dialogue: 0,0:22:10.50,0:22:14.00,Default,,0000,0000,0000,,Рахмет!
Dialogue: 0,0:22:10.50,0:22:14.00,Default,,0000,0000,0000,,Арыстан немесе Яад!
Dialogue: 0,0:22:14.00,0:22:17.17,Default,,0000,0000,0000,,А...? Ана жерде!
Dialogue: 0,0:22:14.00,0:22:17.17,Default,,0000,0000,0000,,(жапырақ дыбысы)
Dialogue: 0,0:22:17.17,0:22:19.67,Default,,0000,0000,0000,,Бірдеңе қозғалды ма?
Dialogue: 0,0:22:17.17,0:22:19.67,Default,,0000,0000,0000,,​​О?
Dialogue: 0,0:22:25.68,0:22:29.18,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:22:25.68,0:22:29.18,Default,,0000,0000,0000,,Уау! Бұл гаргойл!
Dialogue: 0,0:22:29.18,0:22:31.18,Default,,0000,0000,0000,,Келе жатыр, бәріңіз!
Dialogue: 0,0:22:31.18,0:22:33.19,Default,,0000,0000,0000,,Көріп отырғаныңыздай, гаргойлдар тас мүсіндерді жылжытуда.
Dialogue: 0,0:22:33.19,0:22:36.52,Default,,0000,0000,0000,,Мені ұрсаң, мынау.
Dialogue: 0,0:22:33.19,0:22:36.52,Default,,0000,0000,0000,,Абайлаңыз, ауырады!
Dialogue: 0,0:22:36.52,0:22:41.33,Default,,0000,0000,0000,,Менің пайда болуым мүмкін емес.
Dialogue: 0,0:22:36.52,0:22:41.33,Default,,0000,0000,0000,,Біз жолдан шығамыз ба?
Dialogue: 0,0:22:43.86,0:22:46.37,Default,,0000,0000,0000,,Жоқ! ? Неге мені аңдып жүрсің? ?
Dialogue: 0,0:22:46.37,0:22:51.04,Default,,0000,0000,0000,,Өйткені бұл ең көзге түсетіні!
Dialogue: 0,0:22:46.37,0:22:51.04,Default,,0000,0000,0000,,Сізде Tappa бар, сондықтан да күресіңіз!
Dialogue: 0,0:22:51.04,0:22:53.04,Default,,0000,0000,0000,,Дөрекі болма! Болды...
Dialogue: 0,0:22:53.04,0:22:55.87,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:22:55.87,0:22:58.54,Default,,0000,0000,0000,,Чилчак!
Dialogue: 0,0:22:55.87,0:22:58.54,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:22:58.54,0:23:03.32,Default,,0000,0000,0000,,Бұл маған тура тиді... Уф... Ах...
Dialogue: 0,0:22:58.54,0:23:03.32,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:23:03.32,0:23:07.99,Default,,0000,0000,0000,,Марсиль~! ?
Dialogue: 0,0:23:03.32,0:23:07.99,Default,,0000,0000,0000,,Айнала кемпірқосақ түсті.
Dialogue: 0,0:23:07.99,0:23:11.82,Default,,0000,0000,0000,,Сиқырлы ауру? Сол бір оқпен бе?
Dialogue: 0,0:23:07.99,0:23:11.82,Default,,0000,0000,0000,,Бұл жаман...
Dialogue: 0,0:23:11.82,0:23:14.49,Default,,0000,0000,0000,,Изуцуми Чилчакты қолдайды...
Dialogue: 0,0:23:11.82,0:23:14.49,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:23:14.49,0:23:18.33,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:23:14.49,0:23:18.33,Default,,0000,0000,0000,,Ах! Күте тұрыңыз! Жоқ, Изцуми.
Dialogue: 0,0:23:18.33,0:23:20.67,Default,,0000,0000,0000,,Мен саған белгі бергенше қозғалма!
Dialogue: 0,0:23:20.67,0:23:23.50,Default,,0000,0000,0000,,《Қатты шумен және қан иісімен
Dialogue: 0,0:23:20.67,0:23:23.50,Default,,0000,0000,0000,,Мен қатты толқып тұрмын.
Dialogue: 0,0:23:23.50,0:23:26.34,Default,,0000,0000,0000,,Шайқас басталған кезде
Dialogue: 0,0:23:23.50,0:23:26.34,Default,,0000,0000,0000,,Мен өлгенше тоқтамаймын》
Dialogue: 0,0:23:26.34,0:23:29.01,Default,,0000,0000,0000,,Сенші! Ыдыс...
Dialogue: 0,0:23:29.01,0:23:32.01,Default,,0000,0000,0000,,Сенши? Неге қолың бос?
Dialogue: 0,0:23:32.01,0:23:34.01,Default,,0000,0000,0000,,Ауыр болғандықтан ба?
Dialogue: 0,0:23:36.01,0:23:38.02,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:23:38.02,0:23:40.69,Default,,0000,0000,0000,,《Жарайды! қылыш пен қазан
Dialogue: 0,0:23:38.02,0:23:40.69,Default,,0000,0000,0000,,Әдеттегіден әлдеқайда жеңіл!
Dialogue: 0,0:23:40.69,0:23:43.19,Default,,0000,0000,0000,,Мен мұны өзім жеңе аламын!
Dialogue: 0,0:23:43.19,0:23:48.53,Default,,0000,0000,0000,,Бірақ! Не айтайын, бұл дене...
Dialogue: 0,0:23:48.53,0:23:53.03,Default,,0000,0000,0000,,Мен қатты шаршадым!
Dialogue: 0,0:23:48.53,0:23:53.03,Default,,0000,0000,0000,,Нашар Мен әдетте жеңілемін! 》
Dialogue: 0,0:23:53.03,0:23:55.03,Default,,0000,0000,0000,,Бәрің, осы жерден қашыңдар!
Dialogue: 0,0:23:55.03,0:23:57.70,Default,,0000,0000,0000,,Сенши Марсильді көтеріп есіктен кіреді.
Dialogue: 0,0:23:57.70,0:24:00.64,Default,,0000,0000,0000,,Изуцуми... Бұл қоңырау...
Dialogue: 0,0:23:57.70,0:24:00.64,Default,,0000,0000,0000,,(қоңырау дыбысы)
Dialogue: 0,0:24:00.64,0:24:02.81,Default,,0000,0000,0000,,Мені қу!
Dialogue: 0,0:24:00.64,0:24:02.81,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:24:02.81,0:24:05.81,Default,,0000,0000,0000,,Чилчак: Мына қазанды жауып таста!
Dialogue: 0,0:24:05.81,0:24:07.81,Default,,0000,0000,0000,,Жүгірейік!
Dialogue: 0,0:24:07.81,0:24:10.32,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:24:10.32,0:24:12.48,Default,,0000,0000,0000,,Ммм… Ммм….
Dialogue: 0,0:24:12.48,0:24:14.49,Default,,0000,0000,0000,,Ммм~!
Dialogue: 0,0:24:18.66,0:24:22.16,Default,,0000,0000,0000,,Уф... Не істеуім керек?
Dialogue: 0,0:24:22.16,0:24:25.33,Default,,0000,0000,0000,,Бұл дене өте ыңғайсыз.
Dialogue: 0,0:24:25.33,0:24:29.50,Default,,0000,0000,0000,,Қайтымсыз.
Dialogue: 0,0:24:25.33,0:24:29.50,Default,,0000,0000,0000,,Сіздің таңдауыңыз жоқ.
Dialogue: 0,0:24:29.50,0:24:33.10,Default,,0000,0000,0000,,Алда, мына саңырауқұлақ
Dialogue: 0,0:24:29.50,0:24:33.10,Default,,0000,0000,0000,,Мен тек өседі деп үміттенемін.
Dialogue: 0,0:24:38.01,0:24:41.01,Default,,0000,0000,0000,,Бұл нағыз ергежейлі жәдігер.
Dialogue: 0,0:24:41.01,0:24:46.32,Default,,0000,0000,0000,,А, анау саңырауқұлақтар да осындай жерлерде.
Dialogue: 0,0:24:41.01,0:24:46.32,Default,,0000,0000,0000,,Ол өседі ме? Шынымен де ыстық.
Dialogue: 0,0:24:48.35,0:24:50.36,Default,,0000,0000,0000,,Күріш пісірейін бе?
Dialogue: 0,0:24:50.36,0:24:53.86,Default,,0000,0000,0000,,Неліктен Сенші әрқашан сонда?
Dialogue: 0,0:24:50.36,0:24:53.86,Default,,0000,0000,0000,,Сіз кенеттен тамақ дайындай бастайсыз ба?
Dialogue: 0,0:24:53.86,0:24:55.86,Default,,0000,0000,0000,,Енді түсіндім.
Dialogue: 0,0:24:55.86,0:24:59.97,Default,,0000,0000,0000,,Бұл дене аш болады.
Dialogue: 0,0:24:55.86,0:24:59.97,Default,,0000,0000,0000,,Көп.
Dialogue: 0,0:24:55.86,0:24:59.97,Default,,0000,0000,0000,,(асқазанның айқайлауы)
Dialogue: 0,0:24:59.97,0:25:04.14,Default,,0000,0000,0000,,Неліктен Намари кенеттен тамақ дайындай бастады?
Dialogue: 0,0:24:59.97,0:25:04.14,Default,,0000,0000,0000,,Мен оны ешқашан көрген емеспін.
Dialogue: 0,0:25:04.14,0:25:08.81,Default,,0000,0000,0000,,А... Мен өзіме қараймын.
Dialogue: 0,0:25:04.14,0:25:08.81,Default,,0000,0000,0000,,Пісіру керемет.
Dialogue: 0,0:25:08.81,0:25:12.81,Default,,0000,0000,0000,,《Бидай ұны, су, тұз және жұмыртқа жақсы араласады➡
Dialogue: 0,0:25:12.81,0:25:15.48,Default,,0000,0000,0000,,Ұйықтасын. Әзірше➡
Dialogue: 0,0:25:15.48,0:25:19.15,Default,,0000,0000,0000,,Тартылған ет, туралған пияз, т.б.
Dialogue: 0,0:25:15.48,0:25:19.15,Default,,0000,0000,0000,,Көкөністерді қосыңыз➡
Dialogue: 0,0:25:19.15,0:25:21.15,Default,,0000,0000,0000,,Жақсылап жаттығу.
Dialogue: 0,0:25:21.15,0:25:23.32,Default,,0000,0000,0000,,Қалған қамырды таяқша➡ жасаймыз
Dialogue: 0,0:25:23.32,0:25:28.16,Default,,0000,0000,0000,,Бірдей етіп кесіп, жұқа етіп жаямыз.
Dialogue: 0,0:25:28.16,0:25:30.50,Default,,0000,0000,0000,,Пломбаны созылған теріге салып, орау.
Dialogue: 0,0:25:30.50,0:25:33.83,Default,,0000,0000,0000,,Куруму…》
Dialogue: 0,0:25:33.83,0:25:42.51,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:25:42.51,0:25:44.51,Default,,0000,0000,0000,,Бұл біртүрлі...
Dialogue: 0,0:25:44.51,0:25:47.68,Default,,0000,0000,0000,,Үнсіз жұмыс істегенде
Dialogue: 0,0:25:44.51,0:25:47.68,Default,,0000,0000,0000,,Мен өзімді тыныш сезінемін.
Dialogue: 0,0:25:47.68,0:25:50.02,Default,,0000,0000,0000,,Бұл тым көп емес пе?
Dialogue: 0,0:25:50.02,0:25:52.02,Default,,0000,0000,0000,,Жарайсыңдар.
Dialogue: 0,0:25:55.02,0:25:57.32,Default,,0000,0000,0000,,Ол аяқталды.
Dialogue: 0,0:25:59.36,0:26:04.30,Default,,0000,0000,0000,,Таныс болып көрінсе де
Dialogue: 0,0:25:59.36,0:26:04.30,Default,,0000,0000,0000,,Біртүрлі иіс мүлде басқа.
Dialogue: 0,0:26:04.30,0:26:06.46,Default,,0000,0000,0000,,Оған картоп пен ірімшік салуға болмайды.
Dialogue: 0,0:26:06.46,0:26:08.97,Default,,0000,0000,0000,,Менің туған жерімде олар қуырылады.
Dialogue: 0,0:26:08.97,0:26:11.27,Default,,0000,0000,0000,,Itadadakimasu.
Dialogue: 0,0:26:13.31,0:26:15.31,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:26:13.31,0:26:15.31,Default,,0000,0000,0000,,Абайлаңыз.
Dialogue: 0,0:26:15.31,0:26:18.14,Default,,0000,0000,0000,,Күйіп қалудан сақтаныңыз.
Dialogue: 0,0:26:15.31,0:26:18.14,Default,,0000,0000,0000,,Келіңіздер!
Dialogue: 0,0:26:18.14,0:26:21.98,Default,,0000,0000,0000,,Қалай болғанда да...
Dialogue: 0,0:26:18.14,0:26:21.98,Default,,0000,0000,0000,,Дәмі біртүрлі дәмді емес пе?
Dialogue: 0,0:26:21.98,0:26:24.65,Default,,0000,0000,0000,,Нәсілдік айырмашылықтар
Dialogue: 0,0:26:21.98,0:26:24.65,Default,,0000,0000,0000,,Бұл сіздің дәм сезуіңізге де әсер ете ме?
Dialogue: 0,0:26:24.65,0:26:28.32,Default,,0000,0000,0000,,Жоқ, бұл
Dialogue: 0,0:26:24.65,0:26:28.32,Default,,0000,0000,0000,,Кім жесе де дәмді.
Dialogue: 0,0:26:28.32,0:26:30.32,Default,,0000,0000,0000,,Бұл біртүрлі.
Dialogue: 0,0:26:30.32,0:26:33.33,Default,,0000,0000,0000,,Тұшпара жер немесе нәсілге негізделген.
Dialogue: 0,0:26:30.32,0:26:33.33,Default,,0000,0000,0000,,Пісіру әдісі мүлдем басқаша болса да➡
Dialogue: 0,0:26:33.33,0:26:36.16,Default,,0000,0000,0000,,Олардың бәрі жақсы.
Dialogue: 0,0:26:36.16,0:26:38.33,Default,,0000,0000,0000,,Иә... Дұрыс!
Dialogue: 0,0:26:38.33,0:26:41.17,Default,,0000,0000,0000,,Дәл қазір біз сияқты емес пе?
Dialogue: 0,0:26:41.17,0:26:44.67,Default,,0000,0000,0000,,Бірдеңе аздап өзгерсе де
Dialogue: 0,0:26:41.17,0:26:44.67,Default,,0000,0000,0000,,Өйткені, біз өзіміз.
Dialogue: 0,0:26:44.67,0:26:46.67,Default,,0000,0000,0000,,Сіз мұны істей аласыз!
Dialogue: 0,0:26:46.67,0:26:51.51,Default,,0000,0000,0000,,Бұл әңгімені жақсы аяқтайды.
Dialogue: 0,0:26:46.67,0:26:51.51,Default,,0000,0000,0000,,Бұл менің қиялым ғана.
Dialogue: 0,0:26:51.51,0:26:55.85,Default,,0000,0000,0000,,Бірақ бұл жер басқаша.
Dialogue: 0,0:26:51.51,0:26:55.85,Default,,0000,0000,0000,,Бұл қандай жер?
Dialogue: 0,0:26:55.85,0:26:59.52,Default,,0000,0000,0000,,Гномдар салған
Dialogue: 0,0:26:55.85,0:26:59.52,Default,,0000,0000,0000,,Бұл қорғаныс нүктесінің бір түрі, солай ма?
Dialogue: 0,0:26:59.52,0:27:03.96,Default,,0000,0000,0000,,Қорғаныс….
Dialogue: 0,0:26:59.52,0:27:03.96,Default,,0000,0000,0000,,Эльфтер мен гномдар соғысқан кезде.
Dialogue: 0,0:27:03.96,0:27:06.29,Default,,0000,0000,0000,,Сен оны мектепте үйренбедің бе?
Dialogue: 0,0:27:06.29,0:27:09.79,Default,,0000,0000,0000,,Екі тарап жарысады
Dialogue: 0,0:27:06.29,0:27:09.79,Default,,0000,0000,0000,,Қайрау технологиясының нәтижесінде➡
Dialogue: 0,0:27:09.79,0:27:12.30,Default,,0000,0000,0000,,Мен үлкен апатқа шақырдым.
Dialogue: 0,0:27:12.30,0:27:16.97,Default,,0000,0000,0000,,Сонымен эльфтер мен гномдар
Dialogue: 0,0:27:12.30,0:27:16.97,Default,,0000,0000,0000,,Дәл осындай қателік жасаудан қорқу үшін➡
Dialogue: 0,0:27:16.97,0:27:19.97,Default,,0000,0000,0000,,Мен лабиринт ішіндегі технологияға алаңдаймын.
Dialogue: 0,0:27:19.97,0:27:23.98,Default,,0000,0000,0000,,Бұл лабиринт әртүрлі мәдениеттер үшін ерекше қызықты.
Dialogue: 0,0:27:19.97,0:27:23.98,Default,,0000,0000,0000,,Өйткені бұл соқтығыс нүктесі➡
Dialogue: 0,0:27:23.98,0:27:27.31,Default,,0000,0000,0000,,Интервенция болған жағдайда
Dialogue: 0,0:27:23.98,0:27:27.31,Default,,0000,0000,0000,,Бұл көп қиындық туғызады.
Dialogue: 0,0:27:27.31,0:27:29.48,Default,,0000,0000,0000,,Бұл туралы.
Dialogue: 0,0:27:29.48,0:27:33.49,Default,,0000,0000,0000,,Егер сіз періге қосылсаңыз
Dialogue: 0,0:27:29.48,0:27:33.49,Default,,0000,0000,0000,,Сіз бұл туралы бірдеңе істей аласыз, солай ма?
Dialogue: 0,0:27:33.49,0:27:35.49,Default,,0000,0000,0000,,Неге мен?
Dialogue: 0,0:27:35.49,0:27:38.49,Default,,0000,0000,0000,,Сенің анаң
Dialogue: 0,0:27:35.49,0:27:38.49,Default,,0000,0000,0000,,Сіз сарайда жұмыс істегеніңізді айттыңыз!
Dialogue: 0,0:27:38.49,0:27:41.49,Default,,0000,0000,0000,,Сізде ешқандай байланыс жоқ па?
Dialogue: 0,0:27:38.49,0:27:41.49,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:27:41.49,0:27:45.16,Default,,0000,0000,0000,,Қалай болғанда да.
Dialogue: 0,0:27:41.49,0:27:45.16,Default,,0000,0000,0000,,Ол қазір жарты аяқты.
Dialogue: 0,0:27:45.16,0:27:47.87,Default,,0000,0000,0000,,Элфтермен келіссөз жүргізгіңіз келсе, Сеншиді пайдаланыңыз.
Dialogue: 0,0:27:49.83,0:27:52.50,Default,,0000,0000,0000,,Жақсылық жаса.
Dialogue: 0,0:27:52.50,0:27:57.01,Default,,0000,0000,0000,,Мүмкіндігінше бастапқы күйге қалай оралуға болады
Dialogue: 0,0:27:52.50,0:27:57.01,Default,,0000,0000,0000,,Іздеуді жалғастырайық.
Dialogue: 0,0:27:57.01,0:27:59.01,Default,,0000,0000,0000,,Қарсылық жоқ.
Dialogue: 0,0:28:00.51,0:28:06.51,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory