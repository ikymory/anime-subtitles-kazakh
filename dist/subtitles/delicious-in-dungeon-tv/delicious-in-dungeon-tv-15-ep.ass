Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:30.02,0:01:32.03,Default,,0000,0000,0000,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:01:32.03,0:01:35.53,Default,,0000,0000,0000,,Бұл не? Осындай қабырға
Dialogue: 0,0:01:32.03,0:01:35.53,Default,,0000,0000,0000,,Мен келгенде ол жоқ еді!
Dialogue: 0,0:01:35.53,0:01:38.20,Default,,0000,0000,0000,,Уау! ?
Dialogue: 0,0:01:35.53,0:01:38.20,Default,,0000,0000,0000,,Тағы жер сілкінісі?
Dialogue: 0,0:01:38.20,0:01:42.87,Default,,0000,0000,0000,,Бұл жер сілкінісі емес...
Dialogue: 0,0:01:38.20,0:01:42.87,Default,,0000,0000,0000,,Лабиринт қозғалып, пішінін өзгертеді.
Dialogue: 0,0:01:42.87,0:01:45.54,Default,,0000,0000,0000,,Сол сиқыршының ісі шығар.
Dialogue: 0,0:01:45.54,0:01:48.37,Default,,0000,0000,0000,,Мүмкін олар бізден қорқатын шығар.
Dialogue: 0,0:01:48.37,0:01:52.88,Default,,0000,0000,0000,,Біз бір жерде мәңгі қаламыз
Dialogue: 0,0:01:48.37,0:01:52.88,Default,,0000,0000,0000,,Бұл сізді жүруге мәжбүрлейді дегенді білдіре ме?
Dialogue: 0,0:01:52.88,0:01:55.38,Default,,0000,0000,0000,,Мен аздап алшақтап көрейін бе?
Dialogue: 0,0:01:55.38,0:01:57.38,Default,,0000,0000,0000,,Бір минут күтіңіз.
Dialogue: 0,0:01:59.99,0:02:01.99,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:02:05.33,0:02:07.99,Default,,0000,0000,0000,,Ол кеткен сияқты.
Dialogue: 0,0:02:07.99,0:02:11.66,Default,,0000,0000,0000,,Қабырғаның үстінде
Dialogue: 0,0:02:07.99,0:02:11.66,Default,,0000,0000,0000,,Бұл дана таңдау емес.
Dialogue: 0,0:02:11.66,0:02:14.67,Default,,0000,0000,0000,,Сіз тұрақты жол іздеп жүрсіз бе?
Dialogue: 0,0:02:16.67,0:02:20.17,Default,,0000,0000,0000,,Қалай болса да...
Dialogue: 0,0:02:20.17,0:02:22.84,Default,,0000,0000,0000,,Ол жандана бастаған сияқты.
Dialogue: 0,0:02:22.84,0:02:27.01,Default,,0000,0000,0000,,Қызыл айдаһар өліп, дыбыс үнсіз қалды.
Dialogue: 0,0:02:22.84,0:02:27.01,Default,,0000,0000,0000,,Құбыжық пайда болды.
Dialogue: 0,0:02:27.01,0:02:30.02,Default,,0000,0000,0000,,Бастапқыда осы иерархияда
Dialogue: 0,0:02:27.01,0:02:30.02,Default,,0000,0000,0000,,Құбыжықтар көп.
Dialogue: 0,0:02:30.02,0:02:33.19,Default,,0000,0000,0000,,Менің осы уақытқа дейін кездеспегенім
Dialogue: 0,0:02:30.02,0:02:33.19,Default,,0000,0000,0000,,Сәттілік... Уф! ?
Dialogue: 0,0:02:33.19,0:02:35.52,Default,,0000,0000,0000,,Ух... у...
Dialogue: 0,0:02:33.19,0:02:35.52,Default,,0000,0000,0000,,Не... Уф.
Dialogue: 0,0:02:35.52,0:02:37.52,Default,,0000,0000,0000,,Сәлем! Сенімен бәрі жақсы ма?
Dialogue: 0,0:02:37.52,0:02:40.36,Default,,0000,0000,0000,,《Уау, бұл денсаулыққа зиян.
Dialogue: 0,0:02:40.36,0:02:44.70,Default,,0000,0000,0000,,Айдаһарды жегеннен бері мен жүрдім.
Dialogue: 0,0:02:40.36,0:02:44.70,Default,,0000,0000,0000,,Дұрыс тамақтанбау.
Dialogue: 0,0:02:44.70,0:02:47.53,Default,,0000,0000,0000,,Лайостың жасы...
Dialogue: 0,0:02:47.53,0:02:50.87,Default,,0000,0000,0000,,Жас болған жақсы.
Dialogue: 0,0:02:47.53,0:02:50.87,Default,,0000,0000,0000,,Мен түсінбеймін...
Dialogue: 0,0:02:50.87,0:02:52.87,Default,,0000,0000,0000,,Чилчак пен Марсиль ➡
Dialogue: 0,0:02:52.87,0:02:55.38,Default,,0000,0000,0000,,Толық өсуде болуы мүмкін》
Dialogue: 0,0:02:52.87,0:02:55.38,Default,,0000,0000,0000,,Қараңыз...
Dialogue: 0,0:02:55.38,0:02:58.88,Default,,0000,0000,0000,,《Осындай уақытта қанағаттанарлық тамақ ішіңіз.
Dialogue: 0,0:02:55.38,0:02:58.88,Default,,0000,0000,0000,,Берілмеген➡
Dialogue: 0,0:02:58.88,0:03:00.81,Default,,0000,0000,0000,,Занки
Dialogue: 0,0:02:58.88,0:03:00.81,Default,,0000,0000,0000,,Ұятқа шыдай алмаймын!
Dialogue: 0,0:03:00.81,0:03:05.82,Default,,0000,0000,0000,,Жастарды тамақтандырмасаң...
Dialogue: 0,0:03:00.81,0:03:05.82,Default,,0000,0000,0000,,Мен сені тамақтандыруым керек! 》
Dialogue: 0,0:03:05.82,0:03:10.99,Default,,0000,0000,0000,,Иә? Оның иісі тәтті.
Dialogue: 0,0:03:05.82,0:03:10.99,Default,,0000,0000,0000,,Тамақтың иісі бар ма?
Dialogue: 0,0:03:10.99,0:03:14.16,Default,,0000,0000,0000,,Жоқ... Гүлдің иісі сияқты.
Dialogue: 0,0:03:10.99,0:03:14.16,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:03:14.16,0:03:17.66,Default,,0000,0000,0000,,Гүлдер гүлдеген жерде
Dialogue: 0,0:03:14.16,0:03:17.66,Default,,0000,0000,0000,,Жақын жерде су тесігі бар!
Dialogue: 0,0:03:17.66,0:03:20.57,Default,,0000,0000,0000,,Мені тап, Салқын!
Dialogue: 0,0:03:17.66,0:03:20.57,Default,,0000,0000,0000,,Польнарефф?
Dialogue: 0,0:03:24.00,0:03:28.51,Default,,0000,0000,0000,,Бұл... зират па, әлде бір нәрсе ме?
Dialogue: 0,0:03:28.51,0:03:32.01,Default,,0000,0000,0000,,Ах. Күте тұрыңыз... біреу бар.
Dialogue: 0,0:03:32.01,0:03:38.18,Default,,0000,0000,0000,,(жасырын күлкі)
Dialogue: 0,0:03:38.18,0:03:40.19,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:03:38.18,0:03:40.19,Default,,0000,0000,0000,,Ха! ?
Dialogue: 0,0:03:42.36,0:03:45.66,Default,,0000,0000,0000,,Бұл құрметсіздік.
Dialogue: 0,0:03:42.36,0:03:45.66,Default,,0000,0000,0000,,Ей, Сенші, жібер!
Dialogue: 0,0:03:47.69,0:03:49.70,Default,,0000,0000,0000,,О!
Dialogue: 0,0:03:47.69,0:03:49.70,Default,,0000,0000,0000,,Артқа тұр, Сенші!
Dialogue: 0,0:03:49.70,0:03:51.70,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:03:51.70,0:03:53.70,Default,,0000,0000,0000,,Каа!
Dialogue: 0,0:03:51.70,0:03:53.70,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:03:53.70,0:03:57.04,Default,,0000,0000,0000,,Гехогехо….
Dialogue: 0,0:03:53.70,0:03:57.04,Default,,0000,0000,0000,,Не! ?
Dialogue: 0,0:03:53.70,0:03:57.04,Default,,0000,0000,0000,,Қаруларыңызды алыңыз!
Dialogue: 0,0:03:57.04,0:04:01.47,Default,,0000,0000,0000,,Бұл жігіттер адам емес.
Dialogue: 0,0:03:57.04,0:04:01.47,Default,,0000,0000,0000,,Драйадтың...гүлі!
Dialogue: 0,0:04:01.47,0:04:05.81,Default,,0000,0000,0000,,Сонымен, бұл дене сұйықтығы?
Dialogue: 0,0:04:01.47,0:04:05.81,Default,,0000,0000,0000,,<Сұйық емес.
Dialogue: 0,0:04:05.81,0:04:09.32,Default,,0000,0000,0000,,Бұл ұсақ бөлшек
Dialogue: 0,0:04:05.81,0:04:09.32,Default,,0000,0000,0000,,Тыныс алу жүйесі арқылы енсе➡
Dialogue: 0,0:04:09.32,0:04:11.32,Default,,0000,0000,0000,,Шырышты қабаттарға жабысады.
Dialogue: 0,0:04:11.32,0:04:15.66,Default,,0000,0000,0000,,Дене осы таныс бөлшекті пайдаланады
Dialogue: 0,0:04:11.32,0:04:15.66,Default,,0000,0000,0000,,Улы болып анықталды➡
Dialogue: 0,0:04:15.66,0:04:20.66,Default,,0000,0000,0000,,Иммунитетті жұмылдыру
Dialogue: 0,0:04:15.66,0:04:20.66,Default,,0000,0000,0000,,Эвакуация дереу басталды.
Dialogue: 0,0:04:20.66,0:04:22.66,Default,,0000,0000,0000,,...＞ деп аталады
Dialogue: 0,0:04:22.66,0:04:24.66,Default,,0000,0000,0000,,Ха… ха….
Dialogue: 0,0:04:24.66,0:04:26.67,Default,,0000,0000,0000,,Харкция!
Dialogue: 0,0:04:24.66,0:04:26.67,Default,,0000,0000,0000,,<Менде шөп безгегі бар>
Dialogue: 0,0:04:26.67,0:04:30.00,Default,,0000,0000,0000,,Уау... қандай лас!
Dialogue: 0,0:04:26.67,0:04:30.00,Default,,0000,0000,0000,,Ау, ауырып тұр.
Dialogue: 0,0:04:26.67,0:04:30.00,Default,,0000,0000,0000,,
Dialogue: 0,0:04:30.00,0:04:33.17,Default,,0000,0000,0000,,Әй, құрғақ тозаң!
Dialogue: 0,0:04:33.17,0:04:36.68,Default,,0000,0000,0000,,Бұл қауіпті, тозаңмен дем алмаңыз...
Dialogue: 0,0:04:36.68,0:04:40.01,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:04:40.01,0:04:42.82,Default,,0000,0000,0000,,Бұл жаман!
Dialogue: 0,0:04:40.01,0:04:42.82,Default,,0000,0000,0000,,Мен жылауымды тоқтата алмаймын.
Dialogue: 0,0:04:45.02,0:04:47.02,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:04:47.02,0:04:50.86,Default,,0000,0000,0000,,Тұр! Мықты бол, Сенші!
Dialogue: 0,0:04:47.02,0:04:50.86,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:04:50.86,0:04:54.36,Default,,0000,0000,0000,,Лайос!
Dialogue: 0,0:04:50.86,0:04:54.36,Default,,0000,0000,0000,,Кенсуке Кенсуке.
Dialogue: 0,0:04:50.86,0:04:54.36,Default,,0000,0000,0000,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:04:54.36,0:04:56.36,Default,,0000,0000,0000,,Мен де... көзім...
Dialogue: 0,0:04:56.36,0:04:58.36,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:04:58.36,0:05:00.30,Default,,0000,0000,0000,,Сенши Қолыңды соз.
Dialogue: 0,0:05:00.30,0:05:03.97,Default,,0000,0000,0000,,Менің сигналым бойынша
Dialogue: 0,0:05:00.30,0:05:03.97,Default,,0000,0000,0000,,Оны қайтар!
Dialogue: 0,0:05:03.97,0:05:07.47,Default,,0000,0000,0000,,1… 2….
Dialogue: 0,0:05:07.47,0:05:10.14,Default,,0000,0000,0000,,Үш!
Dialogue: 0,0:05:07.47,0:05:10.14,Default,,0000,0000,0000,,Уваах! Көзім…
Dialogue: 0,0:05:10.14,0:05:12.98,Default,,0000,0000,0000,,Муф!
Dialogue: 0,0:05:12.98,0:05:14.98,Default,,0000,0000,0000,,
Dialogue: 0,0:05:14.98,0:05:17.82,Default,,0000,0000,0000,,Ябе Менің де көзім қыши бастады.
Dialogue: 0,0:05:17.82,0:05:21.82,Default,,0000,0000,0000,,Көріну...
Dialogue: 0,0:05:21.82,0:05:23.82,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:05:23.82,0:05:26.66,Default,,0000,0000,0000,,Уваах! Көзім…
Dialogue: 0,0:05:23.82,0:05:26.66,Default,,0000,0000,0000,,Хе...
Dialogue: 0,0:05:26.66,0:05:29.66,Default,,0000,0000,0000,,Қаш, Сенші!
Dialogue: 0,0:05:26.66,0:05:29.66,Default,,0000,0000,0000,,Ойға сыймайды!
Dialogue: 0,0:05:29.66,0:05:33.17,Default,,0000,0000,0000,,Бүркіт балапандарды алып кетеді
Dialogue: 0,0:05:29.66,0:05:33.17,Default,,0000,0000,0000,,Қорғау керек!
Dialogue: 0,0:05:33.17,0:05:35.17,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:05:33.17,0:05:35.17,Default,,0000,0000,0000,,Чилчак!
Dialogue: 0,0:05:35.17,0:05:39.17,Default,,0000,0000,0000,,Қыранның көзі бол!
Dialogue: 0,0:05:35.17,0:05:39.17,Default,,0000,0000,0000,,Жоқ! Мен ештеңе көре алмаймын!
Dialogue: 0,0:05:39.17,0:05:43.34,Default,,0000,0000,0000,,Сізде керемет сезім бар!
Dialogue: 0,0:05:39.17,0:05:43.34,Default,,0000,0000,0000,,Кух….
Dialogue: 0,0:05:43.34,0:05:48.18,Default,,0000,0000,0000,,《Иіс... Жоқ.
Dialogue: 0,0:05:43.34,0:05:48.18,Default,,0000,0000,0000,,Тозаңның иісі тым күшті.
Dialogue: 0,0:05:48.18,0:05:50.68,Default,,0000,0000,0000,,Дыбыс…》
Dialogue: 0,0:05:48.18,0:05:50.68,Default,,0000,0000,0000,,Харктион!
Dialogue: 0,0:05:50.68,0:05:52.85,Default,,0000,0000,0000,,《Сенсидің түшкіргені өте шулы!
Dialogue: 0,0:05:52.85,0:05:56.02,Default,,0000,0000,0000,,Сіз көру, иіс немесе есту қабілетіне сене алмайсыз...
Dialogue: 0,0:05:56.02,0:05:58.69,Default,,0000,0000,0000,,Ах! жел! 》
Dialogue: 0,0:05:58.69,0:06:00.63,Default,,0000,0000,0000,,
Dialogue: 0,0:06:00.63,0:06:03.13,Default,,0000,0000,0000,,Түшкіруден аулақ болыңыз
Dialogue: 0,0:06:00.63,0:06:03.13,Default,,0000,0000,0000,,Ол диагональ бойынша оңға қарай жүгірді!
Dialogue: 0,0:06:03.13,0:06:05.30,Default,,0000,0000,0000,,Тек тербеле бер! Сенши!
Dialogue: 0,0:06:05.30,0:06:08.00,Default,,0000,0000,0000,,Хмм... Мм!
Dialogue: 0,0:06:11.64,0:06:14.81,Default,,0000,0000,0000,,Хакушон!
Dialogue: 0,0:06:11.64,0:06:14.81,Default,,0000,0000,0000,,Кенсуке~.
Dialogue: 0,0:06:14.81,0:06:16.81,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:06:16.81,0:06:19.15,Default,,0000,0000,0000,,《Тамаша жарылу.
Dialogue: 0,0:06:19.15,0:06:22.98,Default,,0000,0000,0000,,Оны тез жөндеп, сиқырлы күш беруім керек.
Dialogue: 0,0:06:19.15,0:06:22.98,Default,,0000,0000,0000,,Қызметкерлер өледі.
Dialogue: 0,0:06:22.98,0:06:26.32,Default,,0000,0000,0000,,Жылдар бойы
Dialogue: 0,0:06:22.98,0:06:26.32,Default,,0000,0000,0000,,Мен осы уақытқа дейін өссем де》
Dialogue: 0,0:06:26.32,0:06:28.32,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:26.32,0:06:28.32,Default,,0000,0000,0000,,(жапырақ дыбысы)
Dialogue: 0,0:06:28.32,0:06:30.32,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:06:28.32,0:06:30.32,Default,,0000,0000,0000,,Э? Естімеймін.
Dialogue: 0,0:06:30.32,0:06:34.33,Default,,0000,0000,0000,,Бұл жерде қауіпсіз.
Dialogue: 0,0:06:30.32,0:06:34.33,Default,,0000,0000,0000,,Өтірік!
Dialogue: 0,0:06:34.33,0:06:37.50,Default,,0000,0000,0000,,Сіз Құрғақ гүлмен күрестіңіз бе?
Dialogue: 0,0:06:37.50,0:06:41.50,Default,,0000,0000,0000,,Бұл қиын болды.
Dialogue: 0,0:06:37.50,0:06:41.50,Default,,0000,0000,0000,,Бірақ гүл құбыжығы дегеніміз не?
Dialogue: 0,0:06:41.50,0:06:45.00,Default,,0000,0000,0000,,Толық
Dialogue: 0,0:06:41.50,0:06:45.00,Default,,0000,0000,0000,,Мен оны еркек пен әйел деп ойладым.
Dialogue: 0,0:06:45.00,0:06:49.01,Default,,0000,0000,0000,,Өйткені драйадтар дара жынысты гүлдер.
Dialogue: 0,0:06:45.00,0:06:49.01,Default,,0000,0000,0000,,Ер мен әйелдің айырмашылығы жоқ.
Dialogue: 0,0:06:49.01,0:06:51.18,Default,,0000,0000,0000,,А, мүмкін...
Dialogue: 0,0:06:51.18,0:06:53.18,Default,,0000,0000,0000,,Не істеу керек? Бұл.
Dialogue: 0,0:06:53.18,0:06:55.18,Default,,0000,0000,0000,,Соғу арқылы тоқтатқан дұрыс
Dialogue: 0,0:06:53.18,0:06:55.18,Default,,0000,0000,0000,,Бұл жақсы емес пе?
Dialogue: 0,0:06:55.18,0:06:58.85,Default,,0000,0000,0000,,Бірақ біз
Dialogue: 0,0:06:55.18,0:06:58.85,Default,,0000,0000,0000,,Сән-салтанат туралы айтатын кез келді➡
Dialogue: 0,0:06:58.85,0:07:03.62,Default,,0000,0000,0000,,Өйткені гүлдердің пішіні адамдарға ұқсайды
Dialogue: 0,0:06:58.85,0:07:03.62,Default,,0000,0000,0000,,Бұл қазір не? Бұл сияқты...
Dialogue: 0,0:07:03.62,0:07:05.79,Default,,0000,0000,0000,,Марси….
Dialogue: 0,0:07:03.62,0:07:05.79,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:07:05.79,0:07:08.46,Default,,0000,0000,0000,,Міне болды!
Dialogue: 0,0:07:08.46,0:07:11.80,Default,,0000,0000,0000,,Құрғақ жеміс!
Dialogue: 0,0:07:11.80,0:07:14.63,Default,,0000,0000,0000,,«Уақытқа оралу...»
Dialogue: 0,0:07:11.80,0:07:14.63,Default,,0000,0000,0000,,Тоқта!
Dialogue: 0,0:07:14.63,0:07:16.80,Default,,0000,0000,0000,,Саратто
Dialogue: 0,0:07:14.63,0:07:16.80,Default,,0000,0000,0000,,Қауіпті сиқырды іздеймін!
Dialogue: 0,0:07:16.80,0:07:20.97,Default,,0000,0000,0000,,Сіздің қара сиқырлы әзіліңіз қандай?
Dialogue: 0,0:07:16.80,0:07:20.97,Default,,0000,0000,0000,,Мен күле алмаймын!
Dialogue: 0,0:07:16.80,0:07:20.97,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:20.97,0:07:25.31,Default,,0000,0000,0000,,Соңғы драйад кесіндісінен
Dialogue: 0,0:07:20.97,0:07:25.31,Default,,0000,0000,0000,,Тозаң болған жоқ.
Dialogue: 0,0:07:25.31,0:07:27.31,Default,,0000,0000,0000,,Бұл аналық гүл болса керек.
Dialogue: 0,0:07:27.31,0:07:32.65,Default,,0000,0000,0000,,Тозаңдану алдында гүл жемістерге қамқорлық жасайды.
Dialogue: 0,0:07:27.31,0:07:32.65,Default,,0000,0000,0000,,Қорғау.
Dialogue: 0,0:07:32.65,0:07:35.15,Default,,0000,0000,0000,,Мұнда да
Dialogue: 0,0:07:32.65,0:07:35.15,Default,,0000,0000,0000,,Ол жеміске ұқсайды.
Dialogue: 0,0:07:35.15,0:07:37.49,Default,,0000,0000,0000,,А, бұл бүршік.
Dialogue: 0,0:07:37.49,0:07:40.16,Default,,0000,0000,0000,,Құрғақ гүлге айналады.
Dialogue: 0,0:07:40.16,0:07:44.16,Default,,0000,0000,0000,,Бұл бұрынғы жемістен жақсы.
Dialogue: 0,0:07:40.16,0:07:44.16,Default,,0000,0000,0000,,Жеуге оңай сияқты.
Dialogue: 0,0:07:44.16,0:07:49.17,Default,,0000,0000,0000,,Бұл әбден мүмкін.
Dialogue: 0,0:07:44.16,0:07:49.17,Default,,0000,0000,0000,,Егін орайық.
Dialogue: 0,0:07:49.17,0:07:53.67,Default,,0000,0000,0000,,Тым көп алмаңыз.
Dialogue: 0,0:07:53.67,0:07:55.68,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:07:55.68,0:07:58.34,Default,,0000,0000,0000,,Уа, мандрака өсіп жатыр!
Dialogue: 0,0:07:58.34,0:08:01.78,Default,,0000,0000,0000,,Менің ит дайындауға уақытым жоқ.
Dialogue: 0,0:07:58.34,0:08:01.78,Default,,0000,0000,0000,,Басыңды кесіп тастауға болмайды.
Dialogue: 0,0:08:01.78,0:08:05.45,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:08:01.78,0:08:05.45,Default,,0000,0000,0000,,Бұл өте шулы. Қашанға дейін шығарасың?
Dialogue: 0,0:08:05.45,0:08:10.46,Default,,0000,0000,0000,,Хмм... Бұл өте жақсы өнім.
Dialogue: 0,0:08:10.46,0:08:14.63,Default,,0000,0000,0000,,Орктардан балта алыңыз
Dialogue: 0,0:08:10.46,0:08:14.63,Default,,0000,0000,0000,,Дұрыс айттыңыз!
Dialogue: 0,0:08:10.46,0:08:14.63,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:08:14.63,0:08:19.63,Default,,0000,0000,0000,,《Су қосылған ұсақталған материал
Dialogue: 0,0:08:14.63,0:08:19.63,Default,,0000,0000,0000,,Оны қазанға салып, қайнатыңыз.
Dialogue: 0,0:08:19.63,0:08:25.14,Default,,0000,0000,0000,,Материал жұмсақ болған кезде
Dialogue: 0,0:08:19.63,0:08:25.14,Default,,0000,0000,0000,,Отты сөндіріп, қазанға езіңіз.
Dialogue: 0,0:08:25.14,0:08:30.14,Default,,0000,0000,0000,,Ол пастаға айналғанда
Dialogue: 0,0:08:25.14,0:08:30.14,Default,,0000,0000,0000,,Суды қайта қосып, дәмдеңіз.
Dialogue: 0,0:08:36.15,0:08:39.32,Default,,0000,0000,0000,,Жақсы иіс шығады. Бұл...
Dialogue: 0,0:08:39.32,0:08:43.82,Default,,0000,0000,0000,,《Сары маймен ақырын қуырылған
Dialogue: 0,0:08:39.32,0:08:43.82,Default,,0000,0000,0000,,Саңырауқұлақтарды қосыңыз.
Dialogue: 0,0:08:43.82,0:08:47.33,Default,,0000,0000,0000,,Үстіне еріген ірімшік сеуіп алсаңыз...
Dialogue: 0,0:08:47.33,0:08:49.53,Default,,0000,0000,0000,,Бұл аяқталды! 》
Dialogue: 0,0:08:51.50,0:08:53.50,Default,,0000,0000,0000,,Оны неге қойдыңыз?
Dialogue: 0,0:08:53.50,0:08:56.84,Default,,0000,0000,0000,,Қосымша сиқырлы қуат көзі үшін
Dialogue: 0,0:08:53.50,0:08:56.84,Default,,0000,0000,0000,,Аз да болса болады деп үміттенемін.
Dialogue: 0,0:08:56.84,0:09:00.11,Default,,0000,0000,0000,,Ізгі ниетпен тіреледі
Dialogue: 0,0:08:56.84,0:09:00.11,Default,,0000,0000,0000,,Менің ойымша, бұл рұқсат етілмейді!
Dialogue: 0,0:09:00.11,0:09:03.11,Default,,0000,0000,0000,,Мен оны жеймін.
Dialogue: 0,0:09:03.11,0:09:06.28,Default,,0000,0000,0000,,《Тәтті!
Dialogue: 0,0:09:03.11,0:09:06.28,Default,,0000,0000,0000,,Гүлдің иісі шығады➡
Dialogue: 0,0:09:06.28,0:09:08.95,Default,,0000,0000,0000,,Қалың, аузыңда ериді.
Dialogue: 0,0:09:08.95,0:09:13.05,Default,,0000,0000,0000,,Маған бұл ұнайды...》
Dialogue: 0,0:09:08.95,0:09:13.05,Default,,0000,0000,0000,,Суреттің беті ең нашар.
Dialogue: 0,0:09:17.62,0:09:20.13,Default,,0000,0000,0000,,Сырдың қышқылдығы онымен жақсы үйлеседі.
Dialogue: 0,0:09:20.13,0:09:23.46,Default,,0000,0000,0000,,Оның дәмі аздап ащы.
Dialogue: 0,0:09:20.13,0:09:23.46,Default,,0000,0000,0000,,Маған ұнады.
Dialogue: 0,0:09:23.46,0:09:27.13,Default,,0000,0000,0000,,Тіпті егер
Dialogue: 0,0:09:23.46,0:09:27.13,Default,,0000,0000,0000,,Қалай қашып құтылдың?
Dialogue: 0,0:09:27.13,0:09:29.64,Default,,0000,0000,0000,,Мәңгі осылай қал
Dialogue: 0,0:09:27.13,0:09:29.64,Default,,0000,0000,0000,,Мен шыға алмадым.
Dialogue: 0,0:09:29.64,0:09:32.81,Default,,0000,0000,0000,,Жерге өту
Dialogue: 0,0:09:29.64,0:09:32.81,Default,,0000,0000,0000,,Оны толығымен блоктау үшін➡
Dialogue: 0,0:09:32.81,0:09:36.48,Default,,0000,0000,0000,,Өйткені ол сиқырлы күштің ағынын кесіп тастайды.
Dialogue: 0,0:09:32.81,0:09:36.48,Default,,0000,0000,0000,,Мен олай ойламаймын.
Dialogue: 0,0:09:36.48,0:09:39.65,Default,,0000,0000,0000,,Бір жерде саңылау болуы керек.
Dialogue: 0,0:09:39.65,0:09:41.65,Default,,0000,0000,0000,,Лабиринттегі өзгерістер➡
Dialogue: 0,0:09:41.65,0:09:44.15,Default,,0000,0000,0000,,Ешқандай ереже жоқ деп ойлаймын.
Dialogue: 0,0:09:41.65,0:09:44.15,Default,,0000,0000,0000,,Ия, солай!
Dialogue: 0,0:09:44.15,0:09:46.65,Default,,0000,0000,0000,,Жер сілкінісінің аралығы және картасы
Dialogue: 0,0:09:44.15,0:09:46.65,Default,,0000,0000,0000,,Жазып алайық.
Dialogue: 0,0:09:46.65,0:09:48.82,Default,,0000,0000,0000,,Мен жағдайдың қалай болғанда да дұрыс болатынын сезе бастадым.
Dialogue: 0,0:09:48.82,0:09:52.99,Default,,0000,0000,0000,,Қарын тоқ болғанда
Dialogue: 0,0:09:48.82,0:09:52.99,Default,,0000,0000,0000,,Бұл мені біршама оптимистік етеді.
Dialogue: 0,0:09:52.99,0:09:56.00,Default,,0000,0000,0000,,Ммм... Мм... Фааа.
Dialogue: 0,0:09:56.00,0:10:01.00,Default,,0000,0000,0000,,Денем қызып тұр.
Dialogue: 0,0:09:56.00,0:10:01.00,Default,,0000,0000,0000,,Мүмкін сіздің сиқырлы күшіңіздің біразы қайта оралған шығар.
Dialogue: 0,0:10:01.00,0:10:04.34,Default,,0000,0000,0000,,Райос пен Сеншидің жарақаттары
Dialogue: 0,0:10:01.00,0:10:04.34,Default,,0000,0000,0000,,Маған ем керек.
Dialogue: 0,0:10:04.34,0:10:07.84,Default,,0000,0000,0000,,Әзірге өзіңізді қатты итермеңіз.
Dialogue: 0,0:10:04.34,0:10:07.84,Default,,0000,0000,0000,,Оны асыра алмаңыз.
Dialogue: 0,0:10:07.84,0:10:11.68,Default,,0000,0000,0000,,Лайос! Сіз қолыңыздан келгеннің бәрін жасайсыз!
Dialogue: 0,0:10:11.68,0:10:14.18,Default,,0000,0000,0000,,Мен сендерге сиқырды үйретемін.
Dialogue: 0,0:10:14.18,0:10:18.52,Default,,0000,0000,0000,,Мен жынды сиқыршыдан жалғызбын
Dialogue: 0,0:10:14.18,0:10:18.52,Default,,0000,0000,0000,,Мен барлығын қорғай алмаймын.
Dialogue: 0,0:10:18.52,0:10:23.02,Default,,0000,0000,0000,,Егер сіз емдік немесе қорғаныс сиқырын қолдансаңыз
Dialogue: 0,0:10:18.52,0:10:23.02,Default,,0000,0000,0000,,Егер сіз оны пайдалана алсаңыз, бұл әлдеқайда жеңіл болады.
Dialogue: 0,0:10:23.02,0:10:26.86,Default,,0000,0000,0000,,Фариннен түрту
Dialogue: 0,0:10:23.02,0:10:26.86,Default,,0000,0000,0000,,Сізді оқытып жатыр ма?
Dialogue: 0,0:10:23.02,0:10:26.86,Default,,0000,0000,0000,,Тек жағдайда...
Dialogue: 0,0:10:26.86,0:10:29.53,Default,,0000,0000,0000,,Бұл баланың мамандығы - гномдық сиқырлы жүйе➡
Dialogue: 0,0:10:29.53,0:10:32.87,Default,,0000,0000,0000,,Мен қолданатын сиқырлы жүйе қандай?
Dialogue: 0,0:10:29.53,0:10:32.87,Default,,0000,0000,0000,,Бұл сәл басқаша.
Dialogue: 0,0:10:32.87,0:10:35.87,Default,,0000,0000,0000,,Түбір
Dialogue: 0,0:10:32.87,0:10:35.87,Default,,0000,0000,0000,,Жарайды, өйткені бұл бірдей нәрсе.
Dialogue: 0,0:10:35.87,0:10:38.67,Default,,0000,0000,0000,,Мен сені бірден ұрамын.
Dialogue: 0,0:10:40.71,0:10:46.21,Default,,0000,0000,0000,,Біз күштірек болуымыз керек.
Dialogue: 0,0:10:40.71,0:10:46.21,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:10:46.21,0:10:48.88,Default,,0000,0000,0000,,Ол жігіттер тым алға ұмтылады.
Dialogue: 0,0:10:48.88,0:10:53.39,Default,,0000,0000,0000,,Жастар үшін бұл жеткілікті.
Dialogue: 0,0:10:48.88,0:10:53.39,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:10:53.39,0:10:56.06,Default,,0000,0000,0000,,Маған баладай қара
Dialogue: 0,0:10:53.39,0:10:56.06,Default,,0000,0000,0000,,Тоқта! ?
Dialogue: 0,0:10:56.06,0:10:58.06,Default,,0000,0000,0000,,Мен шыдай алмаймын!
Dialogue: 0,0:10:58.06,0:11:00.66,Default,,0000,0000,0000,,Жалпы айтқанда, неге құбыжықтар алдында?
Dialogue: 0,0:10:58.06,0:11:00.66,Default,,0000,0000,0000,,Сен менің көзімді жаптың!
Dialogue: 0,0:11:00.66,0:11:03.33,Default,,0000,0000,0000,,Мен ақырында құтқарылдым!
Dialogue: 0,0:11:03.33,0:11:06.00,Default,,0000,0000,0000,,Түсіндім, Чилчак.
Dialogue: 0,0:11:06.00,0:11:09.50,Default,,0000,0000,0000,,Егер сіз бұрын әкеңізден айырылған болсаңыз
Dialogue: 0,0:11:06.00,0:11:09.50,Default,,0000,0000,0000,,Сіз осылай айттыңыз.
Dialogue: 0,0:11:09.50,0:11:13.17,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:11:09.50,0:11:13.17,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:11:13.17,0:11:17.34,Default,,0000,0000,0000,,Бұл жақсы мүмкіндік
Dialogue: 0,0:11:13.17,0:11:17.34,Default,,0000,0000,0000,,Мен де бір нәрсе айтайын.
Dialogue: 0,0:11:17.34,0:11:20.68,Default,,0000,0000,0000,,Онда отырыңыз.
Dialogue: 0,0:11:17.34,0:11:20.68,Default,,0000,0000,0000,,А...?
Dialogue: 0,0:11:20.68,0:11:23.68,Default,,0000,0000,0000,,Сіз де қызықтыратын жаста шығарсыз➡
Dialogue: 0,0:11:23.68,0:11:29.02,Default,,0000,0000,0000,,Дұрыс білім алу керек
Dialogue: 0,0:11:23.68,0:11:29.02,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:11:23.68,0:11:29.02,Default,,0000,0000,0000,,Басқаша айтқанда?
Dialogue: 0,0:11:29.02,0:11:34.19,Default,,0000,0000,0000,,Адамдарда аталық және аналық аталық бездері де болады.
Dialogue: 0,0:11:29.02,0:11:34.19,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:11:34.19,0:11:37.70,Default,,0000,0000,0000,,Жоқ! Тағы да!
Dialogue: 0,0:11:34.19,0:11:37.70,Default,,0000,0000,0000,,Мұқият тыңдаңыз!
Dialogue: 0,0:11:37.70,0:11:42.40,Default,,0000,0000,0000,,<Осылайша олардың түні болды
Dialogue: 0,0:11:37.70,0:11:42.40,Default,,0000,0000,0000,,Кеш батты>
Dialogue: 0,0:11:44.37,0:11:48.87,Default,,0000,0000,0000,,Жүр, асығыңыз.
Dialogue: 0,0:11:44.37,0:11:48.87,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:11:52.71,0:11:54.71,Default,,0000,0000,0000,,Дөрекі!
Dialogue: 0,0:11:52.71,0:11:54.71,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:11:54.71,0:11:57.55,Default,,0000,0000,0000,,Біртүрлі тиіп кетсең
Dialogue: 0,0:11:54.71,0:11:57.55,Default,,0000,0000,0000,,Менің ойымша, бұл жақсы емес.
Dialogue: 0,0:11:57.55,0:12:01.35,Default,,0000,0000,0000,,Бұлай шалынып қалма!
Dialogue: 0,0:11:57.55,0:12:01.35,Default,,0000,0000,0000,,Сол қолыңызды шығарыңыз!
Dialogue: 0,0:12:03.32,0:12:07.49,Default,,0000,0000,0000,,Қараңызшы, бұл өте жақсы.
Dialogue: 0,0:12:03.32,0:12:07.49,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:12:07.49,0:12:11.83,Default,,0000,0000,0000,,Ұялып қалсаң да, сиқырдан таймайсың.
Dialogue: 0,0:12:07.49,0:12:11.83,Default,,0000,0000,0000,,Қараңдар, шоғырланыңдар!
Dialogue: 0,0:12:11.83,0:12:16.17,Default,,0000,0000,0000,,Дененің іші
Dialogue: 0,0:12:11.83,0:12:16.17,Default,,0000,0000,0000,,Сиқырлы күштің айналатынын біліңіз.
Dialogue: 0,0:12:16.17,0:12:18.17,Default,,0000,0000,0000,,Қан тамыр тәрізді кескін.
Dialogue: 0,0:12:18.17,0:12:20.67,Default,,0000,0000,0000,,Ағынды алақаннан қосыңыз➡
Dialogue: 0,0:12:20.67,0:12:25.01,Default,,0000,0000,0000,,Басыңыздың жоғарғы жағынан
Dialogue: 0,0:12:20.67,0:12:25.01,Default,,0000,0000,0000,,Аяғымның саусақтарына дейін.
Dialogue: 0,0:12:25.01,0:12:28.85,Default,,0000,0000,0000,,Тыныс алуды, дене температурасын және тамыр соғу жиілігін сәйкестендіріңіз...
Dialogue: 0,0:12:28.85,0:12:32.52,Default,,0000,0000,0000,,Сіз үйреніп қалдым деп ойлаған кезде
Dialogue: 0,0:12:28.85,0:12:32.52,Default,,0000,0000,0000,,Менен кейін қайталаңыз.
Dialogue: 0,0:12:32.52,0:12:34.52,Default,,0000,0000,0000,,Спела.
Dialogue: 0,0:12:32.52,0:12:34.52,Default,,0000,0000,0000,,Спела.
Dialogue: 0,0:12:34.52,0:12:36.52,Default,,0000,0000,0000,,Yeptum.
Dialogue: 0,0:12:34.52,0:12:36.52,Default,,0000,0000,0000,,Yeptum.
Dialogue: 0,0:12:36.52,0:12:38.52,Default,,0000,0000,0000,,Руферм.
Dialogue: 0,0:12:36.52,0:12:38.52,Default,,0000,0000,0000,,Руферм.
Dialogue: 0,0:12:38.52,0:12:40.53,Default,,0000,0000,0000,,Вильяр.
Dialogue: 0,0:12:38.52,0:12:40.53,Default,,0000,0000,0000,,Вильяр.
Dialogue: 0,0:12:40.53,0:12:42.53,Default,,0000,0000,0000,,Эвркант.
Dialogue: 0,0:12:40.53,0:12:42.53,Default,,0000,0000,0000,,Эвреканто.
Dialogue: 0,0:12:42.53,0:12:44.53,Default,,0000,0000,0000,,Жаралар.
Dialogue: 0,0:12:42.53,0:12:44.53,Default,,0000,0000,0000,,Жаралар.
Dialogue: 0,0:12:44.53,0:12:46.53,Default,,0000,0000,0000,,Уф! Қышыма!
Dialogue: 0,0:12:44.53,0:12:46.53,Default,,0000,0000,0000,,Ой! Незуко қайда?
Dialogue: 0,0:12:46.53,0:12:50.70,Default,,0000,0000,0000,,Уф, қышиды.
Dialogue: 0,0:12:46.53,0:12:50.70,Default,,0000,0000,0000,,Амансың ба?
Dialogue: 0,0:12:50.70,0:12:54.04,Default,,0000,0000,0000,,А... қотыры түсіп қалды.
Dialogue: 0,0:12:50.70,0:12:54.04,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:54.04,0:12:58.38,Default,,0000,0000,0000,,Сәттілік! Жарайсың, Райос!
Dialogue: 0,0:12:54.04,0:12:58.38,Default,,0000,0000,0000,,Маған күшіңді бересің бе?
Dialogue: 0,0:12:58.38,0:13:00.31,Default,,0000,0000,0000,,Қан ағып жатыр.
Dialogue: 0,0:13:00.31,0:13:04.32,Default,,0000,0000,0000,,Басында осылай болды!
Dialogue: 0,0:13:00.31,0:13:04.32,Default,,0000,0000,0000,,Бірақ оны жұту оңай.
Dialogue: 0,0:13:04.32,0:13:07.49,Default,,0000,0000,0000,,Бәлкім, таланты бар қандастар шығар!
Dialogue: 0,0:13:04.32,0:13:07.49,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:13:07.49,0:13:10.66,Default,,0000,0000,0000,,Марсильдің де оқыту әдісі
Dialogue: 0,0:13:07.49,0:13:10.66,Default,,0000,0000,0000,,Түсінуге оңай болғанына қуаныштымын.
Dialogue: 0,0:13:10.66,0:13:12.66,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:13:12.66,0:13:16.00,Default,,0000,0000,0000,,Сосын сол сезімді ұмытпай тұрып➡
Dialogue: 0,0:13:16.00,0:13:18.33,Default,,0000,0000,0000,,Сеншімен байқап көрейік.
Dialogue: 0,0:13:16.00,0:13:18.33,Default,,0000,0000,0000,,Уф! ?
Dialogue: 0,0:13:18.33,0:13:21.53,Default,,0000,0000,0000,,Өйткені мен қарап отырмын
Dialogue: 0,0:13:18.33,0:13:21.53,Default,,0000,0000,0000,,Дәл сол әрекетті орындаңыз.
Dialogue: 0,0:13:23.50,0:13:27.67,Default,,0000,0000,0000,,《Жарайды, бұл жай ғана дайын нәрсе.
Dialogue: 0,0:13:23.50,0:13:27.67,Default,,0000,0000,0000,,Драйад бұтақтарымен жөнделген.
Dialogue: 0,0:13:27.67,0:13:29.68,Default,,0000,0000,0000,,Сәйкес келе ме деп ойлаймын...》
Dialogue: 0,0:13:31.68,0:13:33.68,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:13:33.68,0:13:35.68,Default,,0000,0000,0000,,Қалай түрту керек….
Dialogue: 0,0:13:33.68,0:13:35.68,Default,,0000,0000,0000,,Кешіріңіз….
Dialogue: 0,0:13:35.68,0:13:37.68,Default,,0000,0000,0000,,Ендеше олай сүрінбе!
Dialogue: 0,0:13:37.68,0:13:42.02,Default,,0000,0000,0000,,Қараңдар, ұялмаңдар!
Dialogue: 0,0:13:37.68,0:13:42.02,Default,,0000,0000,0000,,Өйткені ұялшақтық – жақсартудың ең үлкен жауы!
Dialogue: 0,0:13:42.02,0:13:45.86,Default,,0000,0000,0000,,Бұл таңқаларлық.
Dialogue: 0,0:13:42.02,0:13:45.86,Default,,0000,0000,0000,,Сізді бағаламауға болмайды.
Dialogue: 0,0:13:42.02,0:13:45.86,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:45.86,0:13:49.86,Default,,0000,0000,0000,,Терапевт басқа адамдармен байланысын арттырды
Dialogue: 0,0:13:45.86,0:13:49.86,Default,,0000,0000,0000,,Ақаулық туғызу.
Dialogue: 0,0:13:49.86,0:13:54.03,Default,,0000,0000,0000,,Партияның таратылу себебі неде?
Dialogue: 0,0:13:49.86,0:13:54.03,Default,,0000,0000,0000,,Көбінесе адамның қарым-қатынасы туралы.
Dialogue: 0,0:13:54.03,0:13:56.87,Default,,0000,0000,0000,,Махаббатта ісінген Қызғаныш пен қызғаныш.
Dialogue: 0,0:13:56.87,0:13:59.97,Default,,0000,0000,0000,,Кектіктен жирену. Бұл тітіркендіргіш.
Dialogue: 0,0:13:59.97,0:14:01.97,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:13:59.97,0:14:01.97,Default,,0000,0000,0000,,​​О?
Dialogue: 0,0:14:01.97,0:14:05.31,Default,,0000,0000,0000,,Фарин мен Шроу туралы айтып тұрсың ба?
Dialogue: 0,0:14:01.97,0:14:05.31,Default,,0000,0000,0000,,Менің тәжірибем.
Dialogue: 0,0:14:05.31,0:14:10.48,Default,,0000,0000,0000,,Көшбасшының шайқаста шеберлігі жоғары
Dialogue: 0,0:14:05.31,0:14:10.48,Default,,0000,0000,0000,,Адамдарды байланыстыра білу керек.
Dialogue: 0,0:14:10.48,0:14:12.82,Default,,0000,0000,0000,,Шынымды айтсам, Райос сиқырдан жақсы ➡
Dialogue: 0,0:14:12.82,0:14:16.82,Default,,0000,0000,0000,,Әлеуметтік дағдылар және адамдарға қалай қарау керек
Dialogue: 0,0:14:12.82,0:14:16.82,Default,,0000,0000,0000,,Мені тамақтандырғаныңды қалаймын.
Dialogue: 0,0:14:16.82,0:14:22.16,Default,,0000,0000,0000,,Егер сіз мұны істесеңіз, оның қара магия екенін түсінесіз.
Dialogue: 0,0:14:16.82,0:14:22.16,Default,,0000,0000,0000,,Оны бір таяқ алып жүруге де мәжбүрлеген жоқ.
Dialogue: 0,0:14:22.16,0:14:26.00,Default,,0000,0000,0000,,Чилчак бір рет
Dialogue: 0,0:14:22.16,0:14:26.00,Default,,0000,0000,0000,,Неліктен сиқырды оқымайсың?
Dialogue: 0,0:14:26.00,0:14:29.84,Default,,0000,0000,0000,,Тек суреттен қорықпайсыз ба?
Dialogue: 0,0:14:26.00,0:14:29.84,Default,,0000,0000,0000,,О, бұл жаман болды!
Dialogue: 0,0:14:29.84,0:14:33.67,Default,,0000,0000,0000,,Қара магияға қатысты заттар үшін
Dialogue: 0,0:14:29.84,0:14:33.67,Default,,0000,0000,0000,,Тек араласу арқылы мені эльфтер ұрлап кетті➡
Dialogue: 0,0:14:33.67,0:14:36.84,Default,,0000,0000,0000,,Мен қайтып оралмадым
Dialogue: 0,0:14:33.67,0:14:36.84,Default,,0000,0000,0000,,Бір отбасының көптеген мүшелері бар➡
Dialogue: 0,0:14:36.84,0:14:39.35,Default,,0000,0000,0000,,Қосымша білім алу мүмкіндігі
Dialogue: 0,0:14:36.84,0:14:39.35,Default,,0000,0000,0000,,Менің жолым болмады.
Dialogue: 0,0:14:39.35,0:14:41.35,Default,,0000,0000,0000,,Жоқ, білмегенім үшін кешірім сұраймын.
Dialogue: 0,0:14:41.35,0:14:44.85,Default,,0000,0000,0000,,Мен зерттеп жүрген ежелгі сиқыр
Дөрекі сөзбен айтқанда,
Dialogue: 0,0:14:41.35,0:14:44.85,Default,,0000,0000,0000,,➡ дегенді білдіреді
Dialogue: 0,0:14:44.85,0:14:49.19,Default,,0000,0000,0000,,Шексіздік бар басқа өлшемнен
Dialogue: 0,0:14:44.85,0:14:49.19,Default,,0000,0000,0000,,Қуат әкелетін сиқыр.
Dialogue: 0,0:14:49.19,0:14:52.52,Default,,0000,0000,0000,,Бір стақан су
Dialogue: 0,0:14:49.19,0:14:52.52,Default,,0000,0000,0000,,Оны газға қалай айналдырады?
Dialogue: 0,0:14:52.52,0:14:54.86,Default,,0000,0000,0000,,Қайнатыңыз, солай ма?
Dialogue: 0,0:14:54.86,0:14:59.03,Default,,0000,0000,0000,,Сосын көлден біраз су.
Dialogue: 0,0:14:54.86,0:14:59.03,Default,,0000,0000,0000,,Бүкіл затты газға қалай айналдырады?
Dialogue: 0,0:14:59.03,0:15:02.97,Default,,0000,0000,0000,,Мұнда да теория бірдей.
Dialogue: 0,0:14:59.03,0:15:02.97,Default,,0000,0000,0000,,Оны жүзеге асыру біршама қиын.
Dialogue: 0,0:15:02.97,0:15:07.47,Default,,0000,0000,0000,,Орасан зор күш пен уақытты қажет етеді
Dialogue: 0,0:15:02.97,0:15:07.47,Default,,0000,0000,0000,,Сиқырға көмектесу➡
Dialogue: 0,0:15:07.47,0:15:09.48,Default,,0000,0000,0000,,Міне, «координаталар» сиқыры.
Dialogue: 0,0:15:09.48,0:15:13.15,Default,,0000,0000,0000,,Бұл лабиринт
Dialogue: 0,0:15:09.48,0:15:13.15,Default,,0000,0000,0000,,Барлық жерде әртүрлі өлшемдерге қосылған➡
Dialogue: 0,0:15:13.15,0:15:17.98,Default,,0000,0000,0000,,Бұл қуатты құбыжықтарды шақыру үшін пайдаланыңыз
Dialogue: 0,0:15:13.15,0:15:17.98,Default,,0000,0000,0000,,Олар лабиринттерді осылай жасайды.
Dialogue: 0,0:15:17.98,0:15:23.16,Default,,0000,0000,0000,,Ол кезде Фарин өздігінен емдейтін.
Dialogue: 0,0:15:17.98,0:15:23.16,Default,,0000,0000,0000,,Менің күшім қалмады.
Dialogue: 0,0:15:23.16,0:15:26.66,Default,,0000,0000,0000,,Сонымен, I
Dialogue: 0,0:15:23.16,0:15:26.66,Default,,0000,0000,0000,,Лабиринттің бөлігін қайта жаз➡
Dialogue: 0,0:15:26.66,0:15:30.16,Default,,0000,0000,0000,,«Бұл дене лабиринттің бөлігі»
Dialogue: 0,0:15:26.66,0:15:30.16,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:30.16,0:15:33.17,Default,,0000,0000,0000,,Тек бір сәтке, әрине.
Dialogue: 0,0:15:33.17,0:15:35.17,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:15:35.17,0:15:38.17,Default,,0000,0000,0000,,Жер қайтадан шуылдады.
Dialogue: 0,0:15:35.17,0:15:38.17,Default,,0000,0000,0000,,Жақын.
Dialogue: 0,0:15:38.17,0:15:40.17,Default,,0000,0000,0000,,Мына жаққа қара!
Dialogue: 0,0:15:40.17,0:15:42.34,Default,,0000,0000,0000,,Қабырғалар қозғалады.
Dialogue: 0,0:15:42.34,0:15:44.34,Default,,0000,0000,0000,,​​Қайда бара жатырсың?
Dialogue: 0,0:15:44.34,0:15:47.35,Default,,0000,0000,0000,,Неге жақын жерде жүрмеске?
Dialogue: 0,0:15:44.34,0:15:47.35,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:15:47.35,0:15:50.35,Default,,0000,0000,0000,,22 мамыр: Біз Аоямада бір-бірімізге дәптерлерімізді көрсетеміз.
Dialogue: 0,0:15:50.35,0:15:53.69,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:15:50.35,0:15:53.69,Default,,0000,0000,0000,,Кю кенеттен басым айналып кетті...
Dialogue: 0,0:15:53.69,0:15:57.02,Default,,0000,0000,0000,,А, мүмкін
Dialogue: 0,0:15:53.69,0:15:57.02,Default,,0000,0000,0000,,Өйткені мен сиқырды алғаш рет қолдандым➡
Dialogue: 0,0:15:57.02,0:15:59.36,Default,,0000,0000,0000,,Сиқырлы мас болу
Dialogue: 0,0:15:57.02,0:15:59.36,Default,,0000,0000,0000,,Мүмкін мен сені оятып жатқан шығармын.
Dialogue: 0,0:15:59.36,0:16:01.96,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:15:59.36,0:16:01.96,Default,,0000,0000,0000,,Жақында орнығады деп ойлаймын.
Dialogue: 0,0:16:01.96,0:16:05.13,Default,,0000,0000,0000,,Мен оны қалдырамын.
Dialogue: 0,0:16:01.96,0:16:05.13,Default,,0000,0000,0000,,Жақсы демалыңыз.
Dialogue: 0,0:16:05.13,0:16:09.13,Default,,0000,0000,0000,,《Көзімді жұмсам да, ашсам да,
Dialogue: 0,0:16:05.13,0:16:09.13,Default,,0000,0000,0000,,Барлығы қанық түсті》
Dialogue: 0,0:16:09.13,0:16:14.97,Default,,0000,0000,0000,,Маған көмектес.
Dialogue: 0,0:16:09.13,0:16:14.97,Default,,0000,0000,0000,,Маған өлуге рұқсат етіңіз.
Dialogue: 0,0:16:09.13,0:16:14.97,Default,,0000,0000,0000,,Сиқыршы...
Dialogue: 0,0:16:14.97,0:16:17.98,Default,,0000,0000,0000,,《Бұл галлюцинация ма? Есту галлюцинациясы? 》
Dialogue: 0,0:16:17.98,0:16:21.48,Default,,0000,0000,0000,,Өтінемін... жай ғана... өлуге рұқсат етіңіз...
Dialogue: 0,0:16:21.48,0:16:24.78,Default,,0000,0000,0000,,《Сиқырлы ауру... бұл ең жаманы...》
Dialogue: 0,0:16:27.99,0:16:31.16,Default,,0000,0000,0000,,Ол жақта жол өзгерді.
Dialogue: 0,0:16:27.99,0:16:31.16,Default,,0000,0000,0000,,Мм.
Dialogue: 0,0:16:31.16,0:16:35.66,Default,,0000,0000,0000,,Мен заңдылықты түсінемін деп ойлаймын.
Dialogue: 0,0:16:31.16,0:16:35.66,Default,,0000,0000,0000,,Мен олай ойламаймын.
Dialogue: 0,0:16:35.66,0:16:38.66,Default,,0000,0000,0000,,Маған көбірек бақылау керек.
Dialogue: 0,0:16:38.66,0:16:41.67,Default,,0000,0000,0000,,Мен әрең қозғаламын.
Dialogue: 0,0:16:38.66,0:16:41.67,Default,,0000,0000,0000,,Менің қолымнан келмейтіні ауырады.
Dialogue: 0,0:16:41.67,0:16:43.67,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:43.67,0:16:47.01,Default,,0000,0000,0000,,Менің аяғым көтеріліп жатыр!
Dialogue: 0,0:16:43.67,0:16:47.01,Default,,0000,0000,0000,,Түсіңіз! Түсу!
Dialogue: 0,0:16:47.01,0:16:50.01,Default,,0000,0000,0000,,Ой... бұл... қауіпті, қауіпті.
Dialogue: 0,0:16:50.01,0:16:52.51,Default,,0000,0000,0000,,Мен қайтып келмейтін жерде болдым.
Dialogue: 0,0:16:52.51,0:16:54.61,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,0:17:01.62,0:17:04.29,Default,,0000,0000,0000,,Құдай-ай!
Dialogue: 0,0:17:04.29,0:17:08.29,Default,,0000,0000,0000,,Бұл насыбайгүлге ұқсайды!
Dialogue: 0,0:17:04.29,0:17:08.29,Default,,0000,0000,0000,,Кокатрица одан да қауіпті!
Dialogue: 0,0:17:08.29,0:17:11.13,Default,,0000,0000,0000,,Ешқашан тістеп алмаңыз!
Dialogue: 0,0:17:08.29,0:17:11.13,Default,,0000,0000,0000,,Тас мүсінге айнал!
Dialogue: 0,0:17:11.13,0:17:14.80,Default,,0000,0000,0000,,Ах! Сол жақтағы есік!
Dialogue: 0,0:17:11.13,0:17:14.80,Default,,0000,0000,0000,,Сол жаққа жүгір!
Dialogue: 0,0:17:14.80,0:17:16.80,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:17:14.80,0:17:16.80,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:17:16.80,0:17:26.98,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:17:26.98,0:17:30.15,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:17:26.98,0:17:30.15,Default,,0000,0000,0000,,Бұл ұзаққа созылмайды.
Dialogue: 0,0:17:30.15,0:17:32.48,Default,,0000,0000,0000,,Артқы жақтан қашып құтыла аламын ба деп ойлаймын.
Dialogue: 0,0:17:32.48,0:17:35.99,Default,,0000,0000,0000,,Насыбайгүлге ұқсас қасиеттер
Dialogue: 0,0:17:32.48,0:17:35.99,Default,,0000,0000,0000,,Егер сізде бар болса, мүмкін➡
Dialogue: 0,0:17:35.99,0:17:38.99,Default,,0000,0000,0000,,Ол бізді дене температурасы арқылы таниды.
Dialogue: 0,0:17:38.99,0:17:42.16,Default,,0000,0000,0000,,Жасырын қашу қиын.
Dialogue: 0,0:17:42.16,0:17:45.33,Default,,0000,0000,0000,,Бірақ бұл жылан басының қабілеті➡
Dialogue: 0,0:17:45.33,0:17:48.17,Default,,0000,0000,0000,,Құс басына келетін болсақ
Dialogue: 0,0:17:45.33,0:17:48.17,Default,,0000,0000,0000,,Көру қабілетіне сену керек.
Dialogue: 0,0:17:48.17,0:17:52.17,Default,,0000,0000,0000,,Лайосқа дейінгі Марсил
Dialogue: 0,0:17:48.17,0:17:52.17,Default,,0000,0000,0000,,Базилискті қалай жеңдіңіз➡
Dialogue: 0,0:17:52.17,0:17:54.84,Default,,0000,0000,0000,,Менің есімде.
Dialogue: 0,0:17:52.17,0:17:54.84,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:17:54.84,0:17:57.01,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:17:57.01,0:17:59.51,Default,,0000,0000,0000,,Ешқашан қорықпа!
Dialogue: 0,0:17:59.51,0:18:02.61,Default,,0000,0000,0000,,Бар жан-тәніммен
Dialogue: 0,0:17:59.51,0:18:02.61,Default,,0000,0000,0000,,Қарсыласыңызды қорқытыңыз!
Dialogue: 0,0:18:02.61,0:18:05.62,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:18:02.61,0:18:05.62,Default,,0000,0000,0000,,《Осылай дедің...》
Dialogue: 0,0:18:05.62,0:18:10.12,Default,,0000,0000,0000,,Тек денеңізді үлкен етіп көрсетіңіз
Dialogue: 0,0:18:05.62,0:18:10.12,Default,,0000,0000,0000,,Барынша қатты сөйлеңіз!
Dialogue: 0,0:18:10.12,0:18:13.46,Default,,0000,0000,0000,,《Ал, бұл жерде
Dialogue: 0,0:18:10.12,0:18:13.46,Default,,0000,0000,0000,,Мен ең ұзын болсам да➡
Dialogue: 0,0:18:13.46,0:18:16.30,Default,,0000,0000,0000,,Қарсылас соңғы кездегіден екі есе үлкен➡
Dialogue: 0,0:18:16.30,0:18:20.30,Default,,0000,0000,0000,,Даусымды көтеруге шебер емеспін...
Dialogue: 0,0:18:16.30,0:18:20.30,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:20.30,0:18:22.80,Default,,0000,0000,0000,,Лайос Сіз не деп айқайладыңыз?
Dialogue: 0,0:18:22.80,0:18:27.31,Default,,0000,0000,0000,,«Уау» дұрыс па?
Dialogue: 0,0:18:22.80,0:18:27.31,Default,,0000,0000,0000,,Бұл «Гаох» болды ма? 》
Dialogue: 0,0:18:27.31,0:18:29.31,Default,,0000,0000,0000,,｟Кей! ｠
Dialogue: 0,0:18:29.31,0:18:31.31,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:18:31.31,0:18:33.31,Default,,0000,0000,0000,,《Жоқ, бәрібір
Dialogue: 0,0:18:31.31,0:18:33.31,Default,,0000,0000,0000,,Қарсыластың селт еткізетін болса➡
Dialogue: 0,0:18:33.31,0:18:36.15,Default,,0000,0000,0000,,Жақсы! 》
Dialogue: 0,0:18:36.15,0:18:39.35,Default,,0000,0000,0000,,｟Уау! ｠
Dialogue: 0,0:18:41.32,0:18:44.66,Default,,0000,0000,0000,,《Жоқ~ бұл
Dialogue: 0,0:18:41.32,0:18:44.66,Default,,0000,0000,0000,,Мүлдем, мүлде, сіз сәтсіздікке ұшырайсыз!
Dialogue: 0,0:18:44.66,0:18:49.33,Default,,0000,0000,0000,,Сіз Лайосқа еліктей алмайсыз!
Dialogue: 0,0:18:44.66,0:18:49.33,Default,,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:18:49.33,0:18:52.66,Default,,0000,0000,0000,,Мен… менің….
Dialogue: 0,0:18:52.66,0:18:55.17,Default,,0000,0000,0000,,Өз жолыңызда! 》
Dialogue: 0,0:19:05.28,0:19:08.78,Default,,0000,0000,0000,,Бұл қандай жарылыс дыбысы?
Dialogue: 0,0:19:05.28,0:19:08.78,Default,,0000,0000,0000,,Бұл Марсиль! Барайық!
Dialogue: 0,0:19:11.95,0:19:14.45,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:19:14.45,0:19:16.62,Default,,0000,0000,0000,,Хмм... таяз!
Dialogue: 0,0:19:16.62,0:19:18.62,Default,,0000,0000,0000,,Иә? иә?
Dialogue: 0,0:19:18.62,0:19:20.63,Default,,0000,0000,0000,,《Бұл өте көзге көрінетін болды!
Dialogue: 0,0:19:20.63,0:19:22.96,Default,,0000,0000,0000,,Екеуі де менен сақтанып жүр! ?
Dialogue: 0,0:19:22.96,0:19:26.30,Default,,0000,0000,0000,,Ән... Уақытында жете алмайсың! 》
Dialogue: 0,0:19:26.30,0:19:29.13,Default,,0000,0000,0000,,Куу….
Dialogue: 0,0:19:29.13,0:19:31.14,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:19:31.14,0:19:33.14,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:19:35.81,0:19:38.14,Default,,0000,0000,0000,,Марсиль! Сізді тістеп алдыңыз ба?
Dialogue: 0,0:19:38.14,0:19:41.65,Default,,0000,0000,0000,,Жарайды...
Dialogue: 0,0:19:41.65,0:19:45.82,Default,,0000,0000,0000,,Сені тістеп алған болуы керек, ақымақ!
Dialogue: 0,0:19:41.65,0:19:45.82,Default,,0000,0000,0000,,А, қазірдің өзінде!
Dialogue: 0,0:19:45.82,0:19:48.15,Default,,0000,0000,0000,,Иә, мені кокатрица тістеп алды! ?
Dialogue: 0,0:19:48.15,0:19:51.99,Default,,0000,0000,0000,,Бұл қиын! Кокатрица шағып алған кезде
Dialogue: 0,0:19:48.15,0:19:51.99,Default,,0000,0000,0000,,Онымен қалай күресуге болатынын білесіз бе?
Dialogue: 0,0:19:51.99,0:19:53.99,Default,,0000,0000,0000,,Ондай нәрсе бар ма?
Dialogue: 0,0:19:53.99,0:19:57.50,Default,,0000,0000,0000,,Алдымен іш киіміңді шеш!
Dialogue: 0,0:19:57.50,0:20:01.17,Default,,0000,0000,0000,,Теріге қарай отырыңыз!
Dialogue: 0,0:20:01.17,0:20:04.17,Default,,0000,0000,0000,,Қолдарыңызды қатайтып, құлақтарыңызды саусақтарыңызбен жабыңыз!
Dialogue: 0,0:20:04.17,0:20:06.67,Default,,0000,0000,0000,,Аузыңды жаб!
Dialogue: 0,0:20:06.67,0:20:09.68,Default,,0000,0000,0000,,Иә... Иә, жарайды.
Dialogue: 0,0:20:09.68,0:20:11.84,Default,,0000,0000,0000,,Енді сіз кез келген уақытта тастай аласыз.
Dialogue: 0,0:20:11.84,0:20:16.01,Default,,0000,0000,0000,,Тасқа айналмау үшін
Dialogue: 0,0:20:11.84,0:20:16.01,Default,,0000,0000,0000,,Бұл уақытша шешім емес пе?
Dialogue: 0,0:20:16.01,0:20:20.02,Default,,0000,0000,0000,,А, а.
Dialogue: 0,0:20:20.02,0:20:23.02,Default,,0000,0000,0000,,Өте қауіпті жағдайда
Dialogue: 0,0:20:20.02,0:20:23.02,Default,,0000,0000,0000,,Ол қатып қалды.
Dialogue: 0,0:20:23.02,0:20:27.53,Default,,0000,0000,0000,,Ол бұзылатын сияқты.
Dialogue: 0,0:20:23.02,0:20:27.53,Default,,0000,0000,0000,,Манга салмас бұрын жаттығулар
Dialogue: 0,0:20:23.02,0:20:27.53,Default,,0000,0000,0000,,Менің ауырлық центрі қисайған, мен құлап кетейін деп тұрғандай сезінемін.
Dialogue: 0,0:20:27.53,0:20:29.70,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:20:29.70,0:20:34.03,Default,,0000,0000,0000,,Адамдар мұндай болғысы келмейді.
Dialogue: 0,0:20:29.70,0:20:34.03,Default,,0000,0000,0000,,Мұнымен не істеуім керек?
Dialogue: 0,0:20:34.03,0:20:38.54,Default,,0000,0000,0000,,Тастауды қалай жоюға болады?
Dialogue: 0,0:20:34.03,0:20:38.54,Default,,0000,0000,0000,,Хм, әртүрлі нәрселер бар...
Dialogue: 0,0:20:38.54,0:20:40.71,Default,,0000,0000,0000,,Алдымен сауығуды күтіңіз.
Dialogue: 0,0:20:40.71,0:20:44.54,Default,,0000,0000,0000,,Таттану удан да артық.
Dialogue: 0,0:20:40.71,0:20:44.54,Default,,0000,0000,0000,,Қарғыстың бір түрі сияқты➡
Dialogue: 0,0:20:44.54,0:20:49.72,Default,,0000,0000,0000,,Егер сіз сиқырлы қарсылығы күшті эльф болсаңыз
Dialogue: 0,0:20:44.54,0:20:49.72,Default,,0000,0000,0000,,Қалпына келтіру басқа жарыстарға қарағанда жылдамырақ болады.
Dialogue: 0,0:20:49.72,0:20:53.22,Default,,0000,0000,0000,,Екіншісі – тасты емдейтін дәрілік шөп.
Dialogue: 0,0:20:49.72,0:20:53.22,Default,,0000,0000,0000,,Немесе ➡
Dialogue: 0,0:20:53.22,0:20:56.72,Default,,0000,0000,0000,,Қалпына келтіру құралдарының болуы
Dialogue: 0,0:20:53.22,0:20:56.72,Default,,0000,0000,0000,,Басқа авантюристерді іздеңіз.
Dialogue: 0,0:20:56.72,0:21:01.16,Default,,0000,0000,0000,,Соңында...
Dialogue: 0,0:20:56.72,0:21:01.16,Default,,0000,0000,0000,,Емдік сиқыр жасауға бар күшімді саламын.
Dialogue: 0,0:21:01.16,0:21:03.16,Default,,0000,0000,0000,,Сіз?
Dialogue: 0,0:21:03.16,0:21:05.66,Default,,0000,0000,0000,,Марсильден
Dialogue: 0,0:21:03.16,0:21:05.66,Default,,0000,0000,0000,,Маған сиқырлы кітаптарды оқуды үйретті.
Dialogue: 0,0:21:05.66,0:21:08.50,Default,,0000,0000,0000,,Сондай-ақ тасты кетіру үшін заклинание болуы керек.
Dialogue: 0,0:21:08.50,0:21:10.50,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:21:10.50,0:21:15.84,Default,,0000,0000,0000,,Мен емдік шөптерді немесе авантюристерді іздеп жүрмін.
Dialogue: 0,0:21:10.50,0:21:15.84,Default,,0000,0000,0000,,Қалған екі нұсқаны да күтейік.
Dialogue: 0,0:21:15.84,0:21:18.34,Default,,0000,0000,0000,,Емдеу дегеніміз не?
Dialogue: 0,0:21:15.84,0:21:18.34,Default,,0000,0000,0000,,Оған қанша уақыт кетеді?
Dialogue: 0,0:21:18.34,0:21:21.68,Default,,0000,0000,0000,,Таллман үшін алты айдан он жылға дейін.
Dialogue: 0,0:21:21.68,0:21:24.38,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:21.68,0:21:24.38,Default,,0000,0000,0000,,Кокатристі әкеліңіз.
Dialogue: 0,0:21:27.02,0:21:29.69,Default,,0000,0000,0000,,《Бір түнде
Dialogue: 0,0:21:27.02,0:21:29.69,Default,,0000,0000,0000,,Түсі біршама өзгерді.
Dialogue: 0,0:21:29.69,0:21:31.69,Default,,0000,0000,0000,,Оны тез шешу керек》
Dialogue: 0,0:21:31.69,0:21:34.36,Default,,0000,0000,0000,,Ол еңкейтілген және қауіпті.
Dialogue: 0,0:21:34.36,0:21:37.53,Default,,0000,0000,0000,,Бөксеге бірдеңе тістеп алсаңыз жақсы болар еді.
Dialogue: 0,0:21:34.36,0:21:37.53,Default,,0000,0000,0000,,Жақсы емес пе?
Dialogue: 0,0:21:37.53,0:21:40.87,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:21:37.53,0:21:40.87,Default,,0000,0000,0000,,Менде жақсы идея бар!
Dialogue: 0,0:21:40.87,0:21:46.20,Default,,0000,0000,0000,,《Кәстрөлдің түбіне ұсақталған бүршіктерді және
Dialogue: 0,0:21:40.87,0:21:46.20,Default,,0000,0000,0000,,Дәмдеуіш қоспасын жайыңыз➡
Dialogue: 0,0:21:46.20,0:21:48.71,Default,,0000,0000,0000,,Марсилды үстіне қойыңыз》
Dialogue: 0,0:21:48.71,0:21:50.71,Default,,0000,0000,0000,,Аа... кірпігім сынды.
Dialogue: 0,0:21:50.71,0:21:56.05,Default,,0000,0000,0000,,《Тұзды суға қоқан етін салғанда
Dialogue: 0,0:21:50.71,0:21:56.05,Default,,0000,0000,0000,,Марсильдің тізесіне қойылған➡
Dialogue: 0,0:21:56.05,0:21:59.55,Default,,0000,0000,0000,,Қорғау》
Dialogue: 0,0:21:59.55,0:22:01.99,Default,,0000,0000,0000,,Ал, сіз тұрақтылық сезімін сезіндіңіз бе?
Dialogue: 0,0:22:01.99,0:22:07.33,Default,,0000,0000,0000,,Осылай жасасаң, құламайсың.
Dialogue: 0,0:22:01.99,0:22:07.33,Default,,0000,0000,0000,,Ол культтің пұтына ұқсайды.
Dialogue: 0,0:22:07.33,0:22:11.00,Default,,0000,0000,0000,,＜ Содан кейін Лайос және басқалары
Dialogue: 0,0:22:07.33,0:22:11.00,Default,,0000,0000,0000,,Мен қатты тырыстым.
Dialogue: 0,0:22:11.00,0:22:14.83,Default,,0000,0000,0000,,Қайталанатын сынақ және қате...
Dialogue: 0,0:22:14.83,0:22:17.00,Default,,0000,0000,0000,,4-ші күн＞
Dialogue: 0,0:22:17.00,0:22:20.01,Default,,0000,0000,0000,,Міне болды!
Dialogue: 0,0:22:17.00,0:22:20.01,Default,,0000,0000,0000,,Ол қалай қолданылады?
Dialogue: 0,0:22:20.01,0:22:23.51,Default,,0000,0000,0000,,А... әзірге➡
Dialogue: 0,0:22:23.51,0:22:25.51,Default,,0000,0000,0000,,Оны қою керек пе?
Dialogue: 0,0:22:25.51,0:22:29.85,Default,,0000,0000,0000,,《Дене температурасы бар тас тері
Dialogue: 0,0:22:25.51,0:22:29.85,Default,,0000,0000,0000,,Күн жылынып барады. Ән...》
Dialogue: 0,0:22:29.85,0:22:34.85,Default,,0000,0000,0000,,Spelae yeptum rufermus virar.
Dialogue: 0,0:22:34.85,0:22:39.02,Default,,0000,0000,0000,,《Айтылуы дұрыс па? Бұл》
Dialogue: 0,0:22:39.02,0:22:41.03,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:22:41.03,0:22:43.13,Default,,0000,0000,0000,,Қауіпті….
Dialogue: 0,0:22:46.20,0:22:48.53,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:22:48.53,0:22:50.87,Default,,0000,0000,0000,,Марсиль!
Dialogue: 0,0:22:48.53,0:22:50.87,Default,,0000,0000,0000,,Жұмсақ.
Dialogue: 0,0:22:50.87,0:22:52.87,Default,,0000,0000,0000,,Сәттілік!
Dialogue: 0,0:22:50.87,0:22:52.87,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:22:50.87,0:22:52.87,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:22:52.87,0:22:55.04,Default,,0000,0000,0000,,Иә? иә? Не?
Dialogue: 0,0:22:55.04,0:22:58.38,Default,,0000,0000,0000,,Неліктен көкөністер туралған?
Dialogue: 0,0:22:55.04,0:22:58.38,Default,,0000,0000,0000,,Неліктен кастрюль?
Dialogue: 0,0:22:58.38,0:23:00.98,Default,,0000,0000,0000,,Қайсысы...
Dialogue: 0,0:23:00.98,0:23:04.15,Default,,0000,0000,0000,,Бұл да сәтті болды.
Dialogue: 0,0:23:00.98,0:23:04.15,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:23:00.98,0:23:04.15,Default,,0000,0000,0000,,Кім шалбарын шылаған, сен, қанды шошқа!
Dialogue: 0,0:23:04.15,0:23:08.65,Default,,0000,0000,0000,,《Қайнатылған тұздалған ет
Dialogue: 0,0:23:04.15,0:23:08.65,Default,,0000,0000,0000,,Жұқа тілімдерге кесіңіз.
Dialogue: 0,0:23:08.65,0:23:11.82,Default,,0000,0000,0000,,Ашыған бүршіктерді алсаң➡
Dialogue: 0,0:23:11.82,0:23:14.83,Default,,0000,0000,0000,,Бұл аяқталды! 》
Dialogue: 0,0:23:14.83,0:23:17.66,Default,,0000,0000,0000,,Иә? Осыншама ұзақ болды ма?
Dialogue: 0,0:23:17.66,0:23:22.83,Default,,0000,0000,0000,,Соңында не істеді?
Dialogue: 0,0:23:17.66,0:23:22.83,Default,,0000,0000,0000,,Мен тым көп нәрсені сынап көрдім, бірақ түсінбеймін.
Dialogue: 0,0:23:22.83,0:23:25.17,Default,,0000,0000,0000,,Бұл менің сиқырым болса екен.
Dialogue: 0,0:23:25.17,0:23:28.67,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:23:25.17,0:23:28.67,Default,,0000,0000,0000,,Дәрілік шөптердің жаңа піскенін көремін.
Dialogue: 0,0:23:28.67,0:23:33.51,Default,,0000,0000,0000,,Пісірілген кокатрица еті
Dialogue: 0,0:23:28.67,0:23:33.51,Default,,0000,0000,0000,,Қарғысты бейтараптандырмады ма?
Dialogue: 0,0:23:33.51,0:23:37.02,Default,,0000,0000,0000,,《Біз тезірек жерге оралуымыз керек.
Dialogue: 0,0:23:33.51,0:23:37.02,Default,,0000,0000,0000,,Бұл мүмкін болмаған кезде➡
Dialogue: 0,0:23:37.02,0:23:40.35,Default,,0000,0000,0000,,Сіз маған қамқор болдыңыз》
Dialogue: 0,0:23:37.02,0:23:40.35,Default,,0000,0000,0000,,Барлығыңызды кешіріңіз...
Dialogue: 0,0:23:40.35,0:23:43.52,Default,,0000,0000,0000,,《Жоқ, бұл дұрыс емес.
Dialogue: 0,0:23:43.52,0:23:47.03,Default,,0000,0000,0000,,Мұндай жағдайларда
Dialogue: 0,0:23:43.52,0:23:47.03,Default,,0000,0000,0000,,Менің тағы айтарым бар.
Dialogue: 0,0:23:47.03,0:23:50.03,Default,,0000,0000,0000,,Иә, ең алдымен...》
Dialogue: 0,0:23:50.03,0:23:53.70,Default,,0000,0000,0000,,Адамдарды маринадталған тас ретінде пайдаланбаңыз.
Dialogue: 0,0:23:53.70,0:23:59.10,Default,,0000,0000,0000,,<Әйтеуір, зындандағы тағам
Dialogue: 0,0:23:53.70,0:23:59.10,Default,,0000,0000,0000,,А, зындандағы тағам＞
Dialogue: 0,0:24:00.60,0:24:06.60,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory