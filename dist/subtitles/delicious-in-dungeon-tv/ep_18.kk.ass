Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:32.53,0:01:36.36,Default,,0000,0000,0000,,Жоғарғы қабатқа шығатын баспалдақтар
Dialogue: 0,0:01:32.53,0:01:36.36,Default,,0000,0000,0000,,Менің таба алмағаным ➡ болды
Dialogue: 0,0:01:36.36,0:01:41.20,Default,,0000,0000,0000,,Жалғастыруды шешкен бойда, міне, солай.
Dialogue: 0,0:01:36.36,0:01:41.20,Default,,0000,0000,0000,,Бұл жиіркенішті сезінеді.
Dialogue: 0,0:01:41.20,0:01:43.20,Default,,0000,0000,0000,,Әлі кепкен жоқ.
Dialogue: 0,0:01:43.20,0:01:46.87,Default,,0000,0000,0000,,Фарин жаңа ғана осы жерден өтті.
Dialogue: 0,0:01:43.20,0:01:46.87,Default,,0000,0000,0000,,Олар төменгі қабатқа бет алған сияқты.
Dialogue: 0,0:01:46.87,0:01:50.38,Default,,0000,0000,0000,,Ол кішкентай болуы керек.
Dialogue: 0,0:01:50.38,0:01:53.88,Default,,0000,0000,0000,,<6 қабат.
Dialogue: 0,0:01:50.38,0:01:53.88,Default,,0000,0000,0000,,Ежелгі гномдар жасаған➡
Dialogue: 0,0:01:53.88,0:01:56.38,Default,,0000,0000,0000,,Туннельді пайдаланатын жерасты су жолы ➡
Dialogue: 0,0:01:56.38,0:01:58.89,Default,,0000,0000,0000,,Мүмкіндігінше кең және ұзын➡
Dialogue: 0,0:01:58.89,0:02:02.32,Default,,0000,0000,0000,,Қан тамырдай қала астында
Dialogue: 0,0:01:58.89,0:02:02.32,Default,,0000,0000,0000,,Ол кесілген.
Dialogue: 0,0:02:02.32,0:02:06.49,Default,,0000,0000,0000,,Бұрын мұнда көп нәрсе болатын.
Dialogue: 0,0:02:02.32,0:02:06.49,Default,,0000,0000,0000,,Ағып кеткен болуы керек.
Dialogue: 0,0:02:06.49,0:02:08.50,Default,,0000,0000,0000,,Әрине су➡
Dialogue: 0,0:02:08.50,0:02:15.00,Default,,0000,0000,0000,,Адамдар мен жануарлардың қастандық, өтірік және қауесет
Dialogue: 0,0:02:08.50,0:02:15.00,Default,,0000,0000,0000,,Алтын, күміс және қан＞
Dialogue: 0,0:02:15.00,0:02:17.00,Default,,0000,0000,0000,,Суық.
Dialogue: 0,0:02:17.00,0:02:19.84,Default,,0000,0000,0000,,6 қабат көбірек
Dialogue: 0,0:02:17.00,0:02:19.84,Default,,0000,0000,0000,,Ол ыстық және ылғалды болуы керек.
Dialogue: 0,0:02:19.84,0:02:22.51,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:02:19.84,0:02:22.51,Default,,0000,0000,0000,,Сіз басқа жерде көрінбедіңіз бе?
Dialogue: 0,0:02:22.51,0:02:25.18,Default,,0000,0000,0000,,Жоқ, бұл жол таныс сияқты.
Dialogue: 0,0:02:25.18,0:02:28.85,Default,,0000,0000,0000,,《Біз сөзсіз
Dialogue: 0,0:02:25.18,0:02:28.85,Default,,0000,0000,0000,,Осы қабатта қызыл айдаһар шабуыл жасады➡
Dialogue: 0,0:02:28.85,0:02:30.85,Default,,0000,0000,0000,,Жойылуға жақын》
Dialogue: 0,0:02:30.85,0:02:33.69,Default,,0000,0000,0000,,Бұл қабырғалары мен жолдары қозғалатын лабиринт.
Dialogue: 0,0:02:33.69,0:02:36.19,Default,,0000,0000,0000,,Температураның өзгеруі таңқаларлық емес.
Dialogue: 0,0:02:36.19,0:02:39.03,Default,,0000,0000,0000,,Ыстықтан салқын болған жақсы➡
Dialogue: 0,0:02:39.03,0:02:42.70,Default,,0000,0000,0000,,Қар мен судағы қан іздері
Dialogue: 0,0:02:39.03,0:02:42.70,Default,,0000,0000,0000,,Жоғалып кеткені ұят.
Dialogue: 0,0:02:42.70,0:02:46.20,Default,,0000,0000,0000,,Әйтеуір, өткен жолы біз құрып кете жаздадық.
Dialogue: 0,0:02:42.70,0:02:46.20,Default,,0000,0000,0000,,Мен жерге баруым керек пе?
Dialogue: 0,0:02:46.20,0:02:50.70,Default,,0000,0000,0000,,Тазартқыштар жеуі керек
Dialogue: 0,0:02:46.20,0:02:50.70,Default,,0000,0000,0000,,Артында қалдырған жүгіңізді қайтарып алуыңыз мүмкін.
Dialogue: 0,0:02:50.70,0:02:52.87,Default,,0000,0000,0000,,Фарин жақсы ма?
Dialogue: 0,0:02:52.87,0:02:56.04,Default,,0000,0000,0000,,Қызыл Айдаһарға
Dialogue: 0,0:02:52.87,0:02:56.04,Default,,0000,0000,0000,,Бұл суық қатты болуы керек.
Dialogue: 0,0:02:56.04,0:02:58.04,Default,,0000,0000,0000,,А, қауырсындар ма?
Dialogue: 0,0:02:58.04,0:02:59.98,Default,,0000,0000,0000,,Сонымен? Шлоуға➡
Dialogue: 0,0:02:59.98,0:03:02.98,Default,,0000,0000,0000,,«Ессіз сиқыршыны жеңу»
Dialogue: 0,0:02:59.98,0:03:02.98,Default,,0000,0000,0000,,Әзірше осымен бітті➡
Dialogue: 0,0:03:02.98,0:03:05.65,Default,,0000,0000,0000,,Менің ойымша, олардың ойларында қандай да бір жоспар бар.
Dialogue: 0,0:03:05.65,0:03:07.65,Default,,0000,0000,0000,,Міне...
Dialogue: 0,0:03:07.65,0:03:10.99,Default,,0000,0000,0000,,Фарин Делгал есімді адамды кездестірді.
Dialogue: 0,0:03:07.65,0:03:10.99,Default,,0000,0000,0000,,Мен оны іздедім.
Dialogue: 0,0:03:10.99,0:03:15.33,Default,,0000,0000,0000,,Себебі қызыл айдаһар ашулы сиқыршыдан.
Dialogue: 0,0:03:10.99,0:03:15.33,Default,,0000,0000,0000,,Бұл маған бұйырылған нәрсе болды.
Dialogue: 0,0:03:15.33,0:03:18.00,Default,,0000,0000,0000,,Қызыл айдаһар ұйықтамайды➡
Dialogue: 0,0:03:18.00,0:03:21.67,Default,,0000,0000,0000,,Иерархия әдеттегіден өзгеше
Dialogue: 0,0:03:18.00,0:03:21.67,Default,,0000,0000,0000,,Сол себепті мен қыдырдым.
Dialogue: 0,0:03:21.67,0:03:25.67,Default,,0000,0000,0000,,Делгал?
Dialogue: 0,0:03:21.67,0:03:25.67,Default,,0000,0000,0000,,Бұл кім? Таныс естіледі.
Dialogue: 0,0:03:25.67,0:03:28.01,Default,,0000,0000,0000,,Ол патша.
Dialogue: 0,0:03:25.67,0:03:28.01,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:28.01,0:03:33.51,Default,,0000,0000,0000,,1000 жыл бұрын жойылған алтын қала
Dialogue: 0,0:03:28.01,0:03:33.51,Default,,0000,0000,0000,,Соңғы патша Делгар.
Dialogue: 0,0:03:33.51,0:03:37.85,Default,,0000,0000,0000,,Бұл лабиринтте көптеген орындар бар.
Dialogue: 0,0:03:33.51,0:03:37.85,Default,,0000,0000,0000,,Оның құрметіне жазылған сөздер бар.
Dialogue: 0,0:03:37.85,0:03:41.19,Default,,0000,0000,0000,,Міне! Міне бітті!
Dialogue: 0,0:03:37.85,0:03:41.19,Default,,0000,0000,0000,,Қазылған заттарға да есімдер жазылған.
Dialogue: 0,0:03:41.19,0:03:45.02,Default,,0000,0000,0000,,Күте тұрыңыз, бірақ бұл Делгар?
Dialogue: 0,0:03:41.19,0:03:45.02,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:03:45.02,0:03:47.03,Default,,0000,0000,0000,,Бұл лабиринт қашан ашылды➡
Dialogue: 0,0:03:47.03,0:03:51.03,Default,,0000,0000,0000,,Жерде пайда болып, шаңға айналады
Dialogue: 0,0:03:47.03,0:03:51.03,Default,,0000,0000,0000,,Ол жоғалып кетті.
Dialogue: 0,0:03:51.03,0:03:55.37,Default,,0000,0000,0000,,Басқаша айтқанда, құтырған сиқыршы
Dialogue: 0,0:03:51.03,0:03:55.37,Default,,0000,0000,0000,,Жоғалған патшаны іздеу➡
Dialogue: 0,0:03:55.37,0:03:59.04,Default,,0000,0000,0000,,Қызыл Айдаһарды қорлау
Dialogue: 0,0:03:55.37,0:03:59.04,Default,,0000,0000,0000,,Сіз лабиринтті жаңартып жатырсыз ба? ?
Dialogue: 0,0:03:59.04,0:04:02.81,Default,,0000,0000,0000,,Жынды сиқыршы өткенде
Dialogue: 0,0:03:59.04,0:04:02.81,Default,,0000,0000,0000,,Алдыңғы патша менің көз алдымда өлтірілгеннен бері➡
Dialogue: 0,0:04:02.81,0:04:06.15,Default,,0000,0000,0000,,Менің ұлым Делғал
Dialogue: 0,0:04:02.81,0:04:06.15,Default,,0000,0000,0000,,Мен бірдей нәрсеге тап болудан қорқамын.
Dialogue: 0,0:04:06.15,0:04:08.98,Default,,0000,0000,0000,,Сонымен, біз
Dialogue: 0,0:04:06.15,0:04:08.98,Default,,0000,0000,0000,,өлтіруші деген күдік бар➡
Dialogue: 0,0:04:08.98,0:04:10.98,Default,,0000,0000,0000,,Шабуылға ұшырады.
Dialogue: 0,0:04:08.98,0:04:10.98,Default,,0000,0000,0000,,Хакушон!
Dialogue: 0,0:04:10.98,0:04:13.99,Default,,0000,0000,0000,,Бұны неден және кімнен естідің?
Dialogue: 0,0:04:10.98,0:04:13.99,Default,,0000,0000,0000,,адасу?
Dialogue: 0,0:04:13.99,0:04:16.32,Default,,0000,0000,0000,,Жоқ, мен бұрыннан білетінмін➡
Dialogue: 0,0:04:16.32,0:04:19.66,Default,,0000,0000,0000,,Тірі суретте ессіз сиқыршы бол
Dialogue: 0,0:04:16.32,0:04:19.66,Default,,0000,0000,0000,,Мен сені кездестірдім➡
Dialogue: 0,0:04:19.66,0:04:21.66,Default,,0000,0000,0000,,Сол кезде мен үйрендім.
Dialogue: 0,0:04:21.66,0:04:26.50,Default,,0000,0000,0000,,Қараңдар, мен суреттегі тағамды жеуге тырысамын.
Dialogue: 0,0:04:21.66,0:04:26.50,Default,,0000,0000,0000,,Сіз ашуланғаныңызды айттыңыз.
Dialogue: 0,0:04:26.50,0:04:28.67,Default,,0000,0000,0000,,Ха! ?
Dialogue: 0,0:04:26.50,0:04:28.67,Default,,0000,0000,0000,,Тез айт!
Dialogue: 0,0:04:28.67,0:04:31.17,Default,,0000,0000,0000,,Сол кезде
Dialogue: 0,0:04:28.67,0:04:31.17,Default,,0000,0000,0000,,Мен байқамадым!
Dialogue: 0,0:04:31.17,0:04:35.34,Default,,0000,0000,0000,,Мен... оқиғаны қайталауды көремін.
Dialogue: 0,0:04:35.34,0:04:39.01,Default,,0000,0000,0000,,Тек растау үшін.
Dialogue: 0,0:04:35.34,0:04:39.01,Default,,0000,0000,0000,,Ашуланған сиқыршы пері болды, солай ма?
Dialogue: 0,0:04:39.01,0:04:41.51,Default,,0000,0000,0000,,Эльфтер мың жыл өмір сүре ме?
Dialogue: 0,0:04:41.51,0:04:44.35,Default,,0000,0000,0000,,Ежелгі дәуірде
Dialogue: 0,0:04:41.51,0:04:44.35,Default,,0000,0000,0000,,Ондай жазбалар да болған сияқты➡
Dialogue: 0,0:04:44.35,0:04:48.86,Default,,0000,0000,0000,,Қазіргі уақытта шектеу ең көбі 500 жыл болуы мүмкін.
Dialogue: 0,0:04:44.35,0:04:48.86,Default,,0000,0000,0000,,«Ең көп дегенде»...
Dialogue: 0,0:04:48.86,0:04:51.36,Default,,0000,0000,0000,,Басқа адамдардың өмірі сенің қолыңда.
Dialogue: 0,0:04:51.36,0:04:55.03,Default,,0000,0000,0000,,Өмір сүру ұзақтығын қалай ұзартуға болады
Dialogue: 0,0:04:51.36,0:04:55.03,Default,,0000,0000,0000,,Бұл жай ғана торт шығар.
Dialogue: 0,0:04:55.03,0:04:58.87,Default,,0000,0000,0000,,Жоқ! өз сиқырыммен
Dialogue: 0,0:04:55.03,0:04:58.87,Default,,0000,0000,0000,,Өміріңізді ұзағырақ ету➡
Dialogue: 0,0:04:58.87,0:05:02.14,Default,,0000,0000,0000,,Өз етіңді жеу
Dialogue: 0,0:04:58.87,0:05:02.14,Default,,0000,0000,0000,,Сіз ұзақ өмір сүре аласыз ба...
Dialogue: 0,0:05:02.14,0:05:04.14,Default,,0000,0000,0000,,Қалай болғанда да мен сені патшаның жауы деп ойладым➡
Dialogue: 0,0:05:04.14,0:05:06.14,Default,,0000,0000,0000,,Бізге
Dialogue: 0,0:05:04.14,0:05:06.14,Default,,0000,0000,0000,,Егер олар сізге шабуыл жасаса➡
Dialogue: 0,0:05:06.14,0:05:09.64,Default,,0000,0000,0000,,Түсінбеушіліктерді диалог арқылы шешуге болады.
Dialogue: 0,0:05:06.14,0:05:09.64,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:05:14.31,0:05:17.82,Default,,0000,0000,0000,,Жел күшейеді.
Dialogue: 0,0:05:14.31,0:05:17.82,Default,,0000,0000,0000,,Суық көрінеді.
Dialogue: 0,0:05:17.82,0:05:21.99,Default,,0000,0000,0000,,Менің алдымда көрінбейді... Сіз мені естисіз бе?
Dialogue: 0,0:05:17.82,0:05:21.99,Default,,0000,0000,0000,,Сіз мені дұрыс орындайсыз ба?
Dialogue: 0,0:05:21.99,0:05:25.16,Default,,0000,0000,0000,,Бұл қайда~ Лайос~!
Dialogue: 0,0:05:21.99,0:05:25.16,Default,,0000,0000,0000,,Мен ештеңе көрмеймін!
Dialogue: 0,0:05:25.16,0:05:27.49,Default,,0000,0000,0000,,Осындай жерде ажырассақ, сұмдық болар еді!
Dialogue: 0,0:05:27.49,0:05:29.50,Default,,0000,0000,0000,,Барлығы қол ұстасып!
Dialogue: 0,0:05:39.51,0:05:42.34,Default,,0000,0000,0000,,Осылай жалғаса берсе жаман...
Dialogue: 0,0:05:42.34,0:05:44.34,Default,,0000,0000,0000,,Бұл бүйірлік тесік!
Dialogue: 0,0:05:44.34,0:05:46.35,Default,,0000,0000,0000,,Қазір көшейік!
Dialogue: 0,0:05:49.52,0:05:54.19,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:05:54.19,0:05:57.19,Default,,0000,0000,0000,,Барлығы сонда ма? Салқындатыңыз ба?
Dialogue: 0,0:05:57.19,0:05:59.19,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:05:57.19,0:05:59.19,Default,,0000,0000,0000,,Мәселе жоқ.
Dialogue: 0,0:05:59.19,0:06:01.13,Default,,0000,0000,0000,,Марсиль?
Dialogue: 0,0:06:01.13,0:06:03.13,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:06:01.13,0:06:03.13,Default,,0000,0000,0000,,Мен осында барар едім.
Dialogue: 0,0:06:03.13,0:06:05.47,Default,,0000,0000,0000,,Сенси.
Dialogue: 0,0:06:03.13,0:06:05.47,Default,,0000,0000,0000,,О.
Dialogue: 0,0:06:03.13,0:06:05.47,Default,,0000,0000,0000,,Бұл қауіпсіз.
Dialogue: 0,0:06:05.47,0:06:09.64,Default,,0000,0000,0000,,Га, жақсы.
Dialogue: 0,0:06:05.47,0:06:09.64,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:05.47,0:06:09.64,Default,,0000,0000,0000,,Дәл қазір...
Dialogue: 0,0:06:09.64,0:06:11.64,Default,,0000,0000,0000,,Марсиль Шамды қоса аласыз ба?
Dialogue: 0,0:06:13.64,0:06:17.31,Default,,0000,0000,0000,,Хмм... Ах.
Dialogue: 0,0:06:17.31,0:06:21.48,Default,,0000,0000,0000,,Бұл жер... түрменің қалдықтары сияқты.
Dialogue: 0,0:06:21.48,0:06:25.99,Default,,0000,0000,0000,,Бірақ мен не болар екен деп ойлаймын...
Dialogue: 0,0:06:25.99,0:06:28.65,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:25.99,0:06:28.65,Default,,0000,0000,0000,,Өтірік! ?
Dialogue: 0,0:06:28.65,0:06:31.49,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:06:28.65,0:06:31.49,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:06:31.49,0:06:34.49,Default,,0000,0000,0000,,《Өсуде! 》
Dialogue: 0,0:06:34.49,0:06:38.33,Default,,0000,0000,0000,,Тәтті, нені айтып тұрсың?
Dialogue: 0,0:06:34.49,0:06:38.33,Default,,0000,0000,0000,,Иллюзия сиқыры?
Dialogue: 0,0:06:38.33,0:06:41.83,Default,,0000,0000,0000,,Жоқ... Мм...
Dialogue: 0,0:06:41.83,0:06:45.34,Default,,0000,0000,0000,,Мүмкін бұл
Dialogue: 0,0:06:41.83,0:06:45.34,Default,,0000,0000,0000,,Бұл пішінді өзгертуші емес пе?
Dialogue: 0,0:06:45.34,0:06:47.34,Default,,0000,0000,0000,,Пішін...?
Dialogue: 0,0:06:45.34,0:06:47.34,Default,,0000,0000,0000,,Білмейсіз бе?
Dialogue: 0,0:06:47.34,0:06:50.68,Default,,0000,0000,0000,,Менің туған жерімде
Dialogue: 0,0:06:47.34,0:06:50.68,Default,,0000,0000,0000,,Бұл анда-санда пайда болатын құбыжық.
Dialogue: 0,0:06:50.68,0:06:53.85,Default,,0000,0000,0000,,Қалың тұман немесе қалың қарлы боран болатын күндер➡
Dialogue: 0,0:06:53.85,0:06:57.68,Default,,0000,0000,0000,,Мен далада, тауда жүргенде жолдастар мен отбасы мүшелерін көремін.
Dialogue: 0,0:06:53.85,0:06:57.68,Default,,0000,0000,0000,,Ол кенет өсті.
Dialogue: 0,0:06:57.68,0:07:01.95,Default,,0000,0000,0000,,Бұл имитациялайтын пішін ауыстырғыш
Dialogue: 0,0:06:57.68,0:07:01.95,Default,,0000,0000,0000,,Ол араласады.
Dialogue: 0,0:07:01.95,0:07:04.46,Default,,0000,0000,0000,,Сіздің туған қалаңыз алаңдатады.
Dialogue: 0,0:07:04.46,0:07:07.79,Default,,0000,0000,0000,,Сен ертегідейсің бе?
Dialogue: 0,0:07:04.46,0:07:07.79,Default,,0000,0000,0000,,Сіз бірдеңе дұрыс емес істеп жатырсыз ба?
Dialogue: 0,0:07:07.79,0:07:10.30,Default,,0000,0000,0000,,Егер сіз хабарсыз қалсаңыз
Dialogue: 0,0:07:07.79,0:07:10.30,Default,,0000,0000,0000,,Нағыз нәрсені жеу➡
Dialogue: 0,0:07:10.30,0:07:12.30,Default,,0000,0000,0000,,Олар ауыстырылатын сияқты.
Dialogue: 0,0:07:10.30,0:07:12.30,Default,,0000,0000,0000,,Ей!
Dialogue: 0,0:07:12.30,0:07:14.80,Default,,0000,0000,0000,,Құдай-ай!
Dialogue: 0,0:07:12.30,0:07:14.80,Default,,0000,0000,0000,,Жалған затты тез табыңыз!
Dialogue: 0,0:07:12.30,0:07:14.80,Default,,0000,0000,0000,,​​О?
Dialogue: 0,0:07:14.80,0:07:19.47,Default,,0000,0000,0000,,Авава….
Dialogue: 0,0:07:14.80,0:07:19.47,Default,,0000,0000,0000,,Мен тамақ ішуім керек.
Dialogue: 0,0:07:14.80,0:07:19.47,Default,,0000,0000,0000,,Мен қиындыққа тап болдым.
Dialogue: 0,0:07:19.47,0:07:24.48,Default,,0000,0000,0000,,Эй, Лайос және т.б.
Dialogue: 0,0:07:19.47,0:07:24.48,Default,,0000,0000,0000,,Менің ойымша, бұл жалған деп айтуға болады.
Dialogue: 0,0:07:24.48,0:07:28.98,Default,,0000,0000,0000,,Бұл да дұрыс.
Dialogue: 0,0:07:24.48,0:07:28.98,Default,,0000,0000,0000,,Сіз құбыжықтар туралы көп білмейсіз.
Dialogue: 0,0:07:28.98,0:07:31.65,Default,,0000,0000,0000,,Пішін ауыстырғыш – бұл
Dialogue: 0,0:07:28.98,0:07:31.65,Default,,0000,0000,0000,,Тірі заттардың ойларын оқу➡
Dialogue: 0,0:07:31.65,0:07:34.49,Default,,0000,0000,0000,,Жақын адамның сырт келбетіне еліктейді дейді.
Dialogue: 0,0:07:34.49,0:07:36.49,Default,,0000,0000,0000,,Мен үшеумін➡
Dialogue: 0,0:07:36.49,0:07:40.33,Default,,0000,0000,0000,,Марсиль мен Чилчак Сенси
Dialogue: 0,0:07:36.49,0:07:40.33,Default,,0000,0000,0000,,Бұл менің жадымда болуы керек.
Dialogue: 0,0:07:40.33,0:07:43.33,Default,,0000,0000,0000,,Шынымен... мұқият қарасаңыз➡
Dialogue: 0,0:07:43.33,0:07:46.83,Default,,0000,0000,0000,,Барлығы бірте-бірте
Dialogue: 0,0:07:43.33,0:07:46.83,Default,,0000,0000,0000,,Басқаша көрінеді...
Dialogue: 0,0:07:46.83,0:07:49.34,Default,,0000,0000,0000,,Жарайды, бірден.
Dialogue: 0,0:07:46.83,0:07:49.34,Default,,0000,0000,0000,,Сіз бұл балаға бірдеңе істей аласыз ба?
Dialogue: 0,0:07:49.34,0:07:52.67,Default,,0000,0000,0000,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,0:07:49.34,0:07:52.67,Default,,0000,0000,0000,,Бұл жалған екені анық.
Dialogue: 0,0:07:52.67,0:07:55.01,Default,,0000,0000,0000,,Шынында да.
Dialogue: 0,0:07:52.67,0:07:55.01,Default,,0000,0000,0000,,Бұл шындық болуы мүмкін емес!
Dialogue: 0,0:07:55.01,0:07:57.51,Default,,0000,0000,0000,,Мұқият қараңыз!
Dialogue: 0,0:07:55.01,0:07:57.51,Default,,0000,0000,0000,,Мен сиқырды қолданамын!
Dialogue: 0,0:07:57.51,0:07:59.95,Default,,0000,0000,0000,,Қара магия!
Dialogue: 0,0:07:57.51,0:07:59.95,Default,,0000,0000,0000,,тітіркендіргіш.
Dialogue: 0,0:07:57.51,0:07:59.95,Default,,0000,0000,0000,,Олар кімнің естеліктері?
Dialogue: 0,0:07:59.95,0:08:02.62,Default,,0000,0000,0000,,Мына жігіт пен мына жігіттің де жалған екені анық.
Dialogue: 0,0:08:02.62,0:08:04.78,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:08:02.62,0:08:04.78,Default,,0000,0000,0000,,Қай жағынан?
Dialogue: 0,0:08:04.78,0:08:06.79,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:04.78,0:08:06.79,Default,,0000,0000,0000,,Мұқият қараңыз!
Dialogue: 0,0:08:06.79,0:08:11.12,Default,,0000,0000,0000,,Менің мойын орамалым глушитель емес.
Dialogue: 0,0:08:06.79,0:08:11.12,Default,,0000,0000,0000,,Сеншінің дулығасында тесігі жоқ.
Dialogue: 0,0:08:11.12,0:08:14.63,Default,,0000,0000,0000,,Хмм...менен сұрасаңыз.
Dialogue: 0,0:08:14.63,0:08:18.30,Default,,0000,0000,0000,,Бұл мүлдем
Dialogue: 0,0:08:14.63,0:08:18.30,Default,,0000,0000,0000,,Лайостың естеліктеріндегі бұл біз.
Dialogue: 0,0:08:18.30,0:08:20.30,Default,,0000,0000,0000,,Менің естеліктерім тым анық емес.
Dialogue: 0,0:08:22.97,0:08:24.97,Default,,0000,0000,0000,,Мен оны сол күйінде қалдыра аламын ба?
Dialogue: 0,0:08:24.97,0:08:27.97,Default,,0000,0000,0000,,Олар адамдар сияқты
Dialogue: 0,0:08:24.97,0:08:27.97,Default,,0000,0000,0000,,Оның ақыл-ойы жоқ.
Dialogue: 0,0:08:27.97,0:08:31.14,Default,,0000,0000,0000,,Бірақ егер ол ауырса,
Dialogue: 0,0:08:27.97,0:08:31.14,Default,,0000,0000,0000,,Олар қарсы шығады.
Dialogue: 0,0:08:31.14,0:08:35.65,Default,,0000,0000,0000,,енді осы жағдайда
Dialogue: 0,0:08:31.14,0:08:35.65,Default,,0000,0000,0000,,Мен белгісіз құбыжықтармен соғысудан аулақ болғым келеді.
Dialogue: 0,0:08:35.65,0:08:39.05,Default,,0000,0000,0000,,Сабырлы түрде жалған заттарды әшкерелеу
Dialogue: 0,0:08:35.65,0:08:39.05,Default,,0000,0000,0000,,Бірге мәміле жасаңыз!
Dialogue: 0,0:08:41.49,0:08:45.83,Default,,0000,0000,0000,,Импульс жақсы.
Dialogue: 0,0:08:41.49,0:08:45.83,Default,,0000,0000,0000,,Жалған мен шынайының айырмашылығын біледі➡
Dialogue: 0,0:08:45.83,0:08:48.49,Default,,0000,0000,0000,,Келе ме, келмей ме.
Dialogue: 0,0:08:45.83,0:08:48.49,Default,,0000,0000,0000,,Мен бұған күмәнданамын.
Dialogue: 0,0:08:48.49,0:08:52.00,Default,,0000,0000,0000,,Қалған жалғандар саны... 6 адам.
Dialogue: 0,0:08:52.00,0:08:54.83,Default,,0000,0000,0000,,Сапқа тұрғанда
Dialogue: 0,0:08:52.00,0:08:54.83,Default,,0000,0000,0000,,Біраз айырмашылықтар бар➡
Dialogue: 0,0:08:54.83,0:08:58.84,Default,,0000,0000,0000,,Мен мұны істеп жатқанда, ештеңе есімде жоқ.
Dialogue: 0,0:08:54.83,0:08:58.84,Default,,0000,0000,0000,,қайта қаралады.
Dialogue: 0,0:08:58.84,0:09:01.94,Default,,0000,0000,0000,,Осыны тез шешпесек жаман болар еді.
Dialogue: 0,0:09:01.94,0:09:06.45,Default,,0000,0000,0000,,Марсильдің шаш үлгісі басқаша.
Dialogue: 0,0:09:01.94,0:09:06.45,Default,,0000,0000,0000,,Соңғы рет көру➡
Dialogue: 0,0:09:06.45,0:09:09.28,Default,,0000,0000,0000,,Оның қандай шаш үлгісі болғаны есімде жоқ.
Dialogue: 0,0:09:06.45,0:09:09.28,Default,,0000,0000,0000,,Өтірік! ?
Dialogue: 0,0:09:09.28,0:09:12.95,Default,,0000,0000,0000,,Бұл шаш үлгісі сирек кездеседі
Dialogue: 0,0:09:09.28,0:09:12.95,Default,,0000,0000,0000,,Есіңізде ме? Қараңдар, қараңдар.
Dialogue: 0,0:09:12.95,0:09:15.45,Default,,0000,0000,0000,,Қарлы боранда
Dialogue: 0,0:09:12.95,0:09:15.45,Default,,0000,0000,0000,,Суық болғандықтан түсіріп алдым.
Dialogue: 0,0:09:15.45,0:09:20.63,Default,,0000,0000,0000,,Біріншіден, олардың шаш түрлері мүлдем басқаша.
Dialogue: 0,0:09:15.45,0:09:20.63,Default,,0000,0000,0000,,Шаш - сиқыршының өмірі.
Dialogue: 0,0:09:20.63,0:09:23.13,Default,,0000,0000,0000,,Барлығы осылай дейді.
Dialogue: 0,0:09:23.13,0:09:26.47,Default,,0000,0000,0000,,Жақсы, біздің басымызда
Dialogue: 0,0:09:23.13,0:09:26.47,Default,,0000,0000,0000,,Өйткені бұл Марсиль.
Dialogue: 0,0:09:26.47,0:09:29.14,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:09:29.14,0:09:31.14,Default,,0000,0000,0000,,А, түсіндім.
Dialogue: 0,0:09:31.14,0:09:34.31,Default,,0000,0000,0000,,Сонда бұл тек мен білетін ақпарат.
Dialogue: 0,0:09:31.14,0:09:34.31,Default,,0000,0000,0000,,Тек шешіңіз!
Dialogue: 0,0:09:34.31,0:09:39.15,Default,,0000,0000,0000,,Менен анаңның қыз атын табуды сұрама.
Dialogue: 0,0:09:34.31,0:09:39.15,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:09:39.15,0:09:42.48,Default,,0000,0000,0000,,Бұл сиқырлы кітап!
Dialogue: 0,0:09:42.48,0:09:44.82,Default,,0000,0000,0000,,Уф.
Dialogue: 0,0:09:42.48,0:09:44.82,Default,,0000,0000,0000,,Қараңыз.
Dialogue: 0,0:09:42.48,0:09:44.82,Default,,0000,0000,0000,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:09:44.82,0:09:47.82,Default,,0000,0000,0000,,Бірінші кітаптың жалған екені анық.
Dialogue: 0,0:09:47.82,0:09:50.82,Default,,0000,0000,0000,,Бірақ қалған екі кітап
Dialogue: 0,0:09:47.82,0:09:50.82,Default,,0000,0000,0000,,Екеуі де солай көрінеді.
Dialogue: 0,0:09:50.82,0:09:54.16,Default,,0000,0000,0000,,Иә? Жоқ, жоқ
Dialogue: 0,0:09:50.82,0:09:54.16,Default,,0000,0000,0000,,Әннің синтаксисі бұзылған!
Dialogue: 0,0:09:54.16,0:09:56.83,Default,,0000,0000,0000,,Бұл жол!
Dialogue: 0,0:09:54.16,0:09:56.83,Default,,0000,0000,0000,,Ммм….
Dialogue: 0,0:09:56.83,0:10:00.00,Default,,0000,0000,0000,,Белгілі бір дәрежеде иеліктер
Dialogue: 0,0:09:56.83,0:10:00.00,Default,,0000,0000,0000,,Бұл сізге қымбатқа түсетін сияқты.
Dialogue: 0,0:10:00.00,0:10:02.30,Default,,0000,0000,0000,,Сенши түгендеу Оны жайып жібер.
Dialogue: 0,0:10:00.00,0:10:02.30,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:10:06.67,0:10:09.84,Default,,0000,0000,0000,,Үш адамға сауда жасаңыз!
Dialogue: 0,0:10:09.84,0:10:12.18,Default,,0000,0000,0000,,Уф.
Dialogue: 0,0:10:12.18,0:10:16.18,Default,,0000,0000,0000,,《Мен оны екі адамға дейін қысқарта алдым, бірақ...
Dialogue: 0,0:10:16.18,0:10:21.89,Default,,0000,0000,0000,,Мен кептеліп қалдым...
Dialogue: 0,0:10:16.18,0:10:21.89,Default,,0000,0000,0000,,Қалған фейктер саны: 3 адам
Dialogue: 0,0:10:24.02,0:10:26.53,Default,,0000,0000,0000,,Жарайды, тамақ ішейік.
Dialogue: 0,0:10:26.53,0:10:28.53,Default,,0000,0000,0000,,Бұл жағдайда! ?
Dialogue: 0,0:10:28.53,0:10:30.86,Default,,0000,0000,0000,,Көрнекі кемсітушілік енді мүмкін емес.
Dialogue: 0,0:10:30.86,0:10:34.03,Default,,0000,0000,0000,,Өзіңіздің әдеттегі мінез-құлқыңызға қараңыз
Dialogue: 0,0:10:30.86,0:10:34.03,Default,,0000,0000,0000,,Бізде үкім шығарудан басқа амал жоқ.
Dialogue: 0,0:10:34.03,0:10:37.87,Default,,0000,0000,0000,,Барлығы сізге тамақ дайындасын
Dialogue: 0,0:10:34.03,0:10:37.87,Default,,0000,0000,0000,,Мен жағдайды байқадым.
Dialogue: 0,0:10:37.87,0:10:40.17,Default,,0000,0000,0000,,Жалған және шынайы заттарды ажырату.
Dialogue: 0,0:10:42.71,0:10:45.21,Default,,0000,0000,0000,,《Ашуланған сиқыршыға
Dialogue: 0,0:10:42.71,0:10:45.21,Default,,0000,0000,0000,,Мен де кездестім➡
Dialogue: 0,0:10:45.21,0:10:47.21,Default,,0000,0000,0000,,Шлоудың сезіміне келсек...》
Dialogue: 0,0:10:47.21,0:10:51.05,Default,,0000,0000,0000,,《Мен Қабуру деген жігітпен сөйлесетінмін.
Dialogue: 0,0:10:47.21,0:10:51.05,Default,,0000,0000,0000,,Мен қай жерде кездескенімізді де байқамаймын》
Dialogue: 0,0:10:51.05,0:10:54.15,Default,,0000,0000,0000,,《Лайостың бақылаушы көзіне сүйене отырып...? 》
Dialogue: 0,0:10:56.72,0:10:58.89,Default,,0000,0000,0000,,《Үш адам: Мазасыз! 》
Dialogue: 0,0:10:58.89,0:11:02.66,Default,,0000,0000,0000,,《Құбыжық өзгерді
Dialogue: 0,0:10:58.89,0:11:02.66,Default,,0000,0000,0000,,Достарыңыздың арасында фейктерді анықтаңыз.
Dialogue: 0,0:11:02.66,0:11:05.33,Default,,0000,0000,0000,,Бұл жоғалған сенімді қалпына келтіру мүмкіндігі.
Dialogue: 0,0:11:05.33,0:11:07.50,Default,,0000,0000,0000,,Енді бәрі емес
Dialogue: 0,0:11:05.33,0:11:07.50,Default,,0000,0000,0000,,Мен сенің көңіліңді қалдырғым келмейді.
Dialogue: 0,0:11:07.50,0:11:11.00,Default,,0000,0000,0000,,Не болса да
Dialogue: 0,0:11:07.50,0:11:11.00,Default,,0000,0000,0000,,Кішігірім айырмашылықтарды байқауыңыз керек! 》
Dialogue: 0,0:11:11.00,0:11:13.17,Default,,0000,0000,0000,,Бұл ол туралы.
Dialogue: 0,0:11:13.17,0:11:17.84,Default,,0000,0000,0000,,Құбыжық деген жалған нәрсе
Dialogue: 0,0:11:13.17,0:11:17.84,Default,,0000,0000,0000,,Сізге тартымды болуы мүмкін.
Dialogue: 0,0:11:17.84,0:11:19.85,Default,,0000,0000,0000,,Мүмкін.
Dialogue: 0,0:11:19.85,0:11:22.52,Default,,0000,0000,0000,,《Әркім: өзі
Dialogue: 0,0:11:19.85,0:11:22.52,Default,,0000,0000,0000,,Бірдеңе істеу керек》
Dialogue: 0,0:11:22.52,0:11:24.52,Default,,0000,0000,0000,,Мен осында қарап отырмын.
Dialogue: 0,0:11:24.52,0:11:28.52,Default,,0000,0000,0000,,Әркім қолынан келгенін жасайды деп үміттенемін.
Dialogue: 0,0:11:24.52,0:11:28.52,Default,,0000,0000,0000,,Бұл тітіркендіргіш.
Dialogue: 0,0:11:24.52,0:11:28.52,Default,,0000,0000,0000,,Не істеу керек?
Dialogue: 0,0:11:28.52,0:11:35.03,Default,,0000,0000,0000,,《Ол мен 5-ші қабаттан тапқан зат
Dialogue: 0,0:11:28.52,0:11:35.03,Default,,0000,0000,0000,,Майзуру-донодан алынған тағам.
Dialogue: 0,0:11:35.03,0:11:39.37,Default,,0000,0000,0000,,Тек дұрыс ингредиенттер
Dialogue: 0,0:11:35.03,0:11:39.37,Default,,0000,0000,0000,,Жаңа ғана түсіндім. Міне...》
Dialogue: 0,0:11:39.37,0:11:41.37,Default,,0000,0000,0000,,Тағы бір нәрсе.
Dialogue: 0,0:11:41.37,0:11:44.87,Default,,0000,0000,0000,,Бір адам
Dialogue: 0,0:11:41.37,0:11:44.87,Default,,0000,0000,0000,,Мен сендерге жұп болып тамақ пісірулеріңді қалаймын.
Dialogue: 0,0:11:44.87,0:11:46.87,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:11:46.87,0:11:50.21,Default,,0000,0000,0000,,Бірлесіп жұмыс жасау арқылы
Dialogue: 0,0:11:46.87,0:11:50.21,Default,,0000,0000,0000,,Сөз бен іс-әрекеттің айырмашылығын байқағым келеді.
Dialogue: 0,0:11:50.21,0:11:53.05,Default,,0000,0000,0000,,Рецептті Сеншиден үйренуге болады.
Dialogue: 0,0:11:53.05,0:11:56.38,Default,,0000,0000,0000,,Сонымен, бәрің дайынсыңдар ма?
Dialogue: 0,0:11:56.38,0:11:58.38,Default,,0000,0000,0000,,Пісіруді бастаңыз!
Dialogue: 0,0:12:00.32,0:12:02.32,Default,,0000,0000,0000,,《Ең алдымен Чилчак командасы.
Dialogue: 0,0:12:02.32,0:12:06.16,Default,,0000,0000,0000,,Етті кесіңіз.
Dialogue: 0,0:12:02.32,0:12:06.16,Default,,0000,0000,0000,,Жұмыртқа мен дәмдеуіштерді араластырыңыз.
Dialogue: 0,0:12:06.16,0:12:08.49,Default,,0000,0000,0000,,Чилчак А дәліздің ортасында.
Dialogue: 0,0:12:08.49,0:12:12.33,Default,,0000,0000,0000,,Чилчак Б ағаш жәшікке отырады.
Dialogue: 0,0:12:08.49,0:12:12.33,Default,,0000,0000,0000,,Жұмыстың басталуы》
Dialogue: 0,0:12:12.33,0:12:15.17,Default,,0000,0000,0000,,Қандай ескерту!
Dialogue: 0,0:12:12.33,0:12:15.17,Default,,0000,0000,0000,,Мұны істеу қиын!
Dialogue: 0,0:12:15.17,0:12:17.17,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:12:17.17,0:12:19.84,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:12:19.84,0:12:22.68,Default,,0000,0000,0000,,Сіз оны аша аласыз ба? Риосты ашыңыз.
Dialogue: 0,0:12:19.84,0:12:22.68,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:22.68,0:12:24.68,Default,,0000,0000,0000,,Шүберек шықты!
Dialogue: 0,0:12:24.68,0:12:28.18,Default,,0000,0000,0000,,Көрдіңіз бе? B жалған!
Dialogue: 0,0:12:24.68,0:12:28.18,Default,,0000,0000,0000,,Иә, мәселе неде?
Dialogue: 0,0:12:28.18,0:12:30.18,Default,,0000,0000,0000,,Жоқ, сіз не білесіз?
Dialogue: 0,0:12:30.18,0:12:32.85,Default,,0000,0000,0000,,Менің де сенімім бар
Dialogue: 0,0:12:30.18,0:12:32.85,Default,,0000,0000,0000,,Тәкаппарлық деген бар.
Dialogue: 0,0:12:32.85,0:12:35.86,Default,,0000,0000,0000,,Адамдар бір-біріне көмектеседі, Чилчак.
Dialogue: 0,0:12:35.86,0:12:38.02,Default,,0000,0000,0000,,Бұл тым бұзық емес пе?
Dialogue: 0,0:12:38.02,0:12:42.36,Default,,0000,0000,0000,,Мұқият қарасаң, А-ның көзі нашар көрінеді.
Dialogue: 0,0:12:38.02,0:12:42.36,Default,,0000,0000,0000,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:12:42.36,0:12:45.53,Default,,0000,0000,0000,,Менің Чилчакым сүйкімді.
Dialogue: 0,0:12:42.36,0:12:45.53,Default,,0000,0000,0000,,Тоқта!
Dialogue: 0,0:12:45.53,0:12:48.87,Default,,0000,0000,0000,,Ла Риос Сіз түсінесіз.
Dialogue: 0,0:12:48.87,0:12:51.04,Default,,0000,0000,0000,,《Чилчак А.
Dialogue: 0,0:12:51.04,0:12:54.04,Default,,0000,0000,0000,,Әрине, бірдеңе
Dialogue: 0,0:12:51.04,0:12:54.04,Default,,0000,0000,0000,,Оның мұңды жүзі бар.
Dialogue: 0,0:12:54.04,0:12:56.04,Default,,0000,0000,0000,,Бұл жалған болуы мүмкін》
Dialogue: 0,0:12:56.04,0:12:59.55,Default,,0000,0000,0000,,Назар аударыңыз! Пісіруді жалғастырыңыз.
Dialogue: 0,0:12:59.55,0:13:01.48,Default,,0000,0000,0000,,Бұлыңғыр!
Dialogue: 0,0:13:01.48,0:13:04.15,Default,,0000,0000,0000,,Мені жалпы тілде балағаттау...
Dialogue: 0,0:13:04.15,0:13:06.82,Default,,0000,0000,0000,,《Марсиль командасының соңынан 》
Dialogue: 0,0:13:06.82,0:13:09.66,Default,,0000,0000,0000,,Қазір тым кеш
Dialogue: 0,0:13:06.82,0:13:09.66,Default,,0000,0000,0000,,Бұл қандай жұмыртқа?
Dialogue: 0,0:13:09.66,0:13:12.32,Default,,0000,0000,0000,,Гарпи.
Dialogue: 0,0:13:12.32,0:13:16.66,Default,,0000,0000,0000,,Мен басында көп айттым!
Dialogue: 0,0:13:12.32,0:13:16.66,Default,,0000,0000,0000,,Гуманоидты құбыжықтар мүлдем жоқ.
Dialogue: 0,0:13:16.66,0:13:19.83,Default,,0000,0000,0000,,Өйткені соңғы кездері мен аздап күйзеліп жүрмін.
Dialogue: 0,0:13:16.66,0:13:19.83,Default,,0000,0000,0000,,Өсіп жатқан жоқ па?
Dialogue: 0,0:13:19.83,0:13:25.17,Default,,0000,0000,0000,,《Марсиль Б әдеттегідей.
Dialogue: 0,0:13:19.83,0:13:25.17,Default,,0000,0000,0000,,Шамадан тыс. Екінші жағынан...
Dialogue: 0,0:13:25.17,0:13:27.84,Default,,0000,0000,0000,,Кесілген дәретхананы қайнату》
Dialogue: 0,0:13:27.84,0:13:32.01,Default,,0000,0000,0000,,Марсиль А не ойлайды?
Dialogue: 0,0:13:27.84,0:13:32.01,Default,,0000,0000,0000,,Мен бақытты емеспін➡
Dialogue: 0,0:13:32.01,0:13:35.01,Default,,0000,0000,0000,,Мен тіпті балықшылардың жұмыртқалары мен драйадтарды жедім.
Dialogue: 0,0:13:35.01,0:13:37.35,Default,,0000,0000,0000,,Енді мұндай шу шығарудың қажеті жоқ.
Dialogue: 0,0:13:37.35,0:13:40.69,Default,,0000,0000,0000,,Мен болсам, Фаринді құтқару үшін мұны істейтін едім.
Dialogue: 0,0:13:37.35,0:13:40.69,Default,,0000,0000,0000,,Қалағаныңды істе.
Dialogue: 0,0:13:40.69,0:13:42.86,Default,,0000,0000,0000,,О...
Dialogue: 0,0:13:40.69,0:13:42.86,Default,,0000,0000,0000,,Сәлем...!
Dialogue: 0,0:13:42.86,0:13:46.03,Default,,0000,0000,0000,,Мен де, Фарин үшін.
Dialogue: 0,0:13:42.86,0:13:46.03,Default,,0000,0000,0000,,Мен не қажет болса да істеймін! ?
Dialogue: 0,0:13:46.03,0:13:48.53,Default,,0000,0000,0000,,В онша айқын емес сияқты.
Dialogue: 0,0:13:48.53,0:13:51.20,Default,,0000,0000,0000,,Өйткені арфаны же.
Dialogue: 0,0:13:48.53,0:13:51.20,Default,,0000,0000,0000,,Жағдай жақсара ма?
Dialogue: 0,0:13:51.20,0:13:55.20,Default,,0000,0000,0000,,《Таяқшалармен өтетіндей жұмсақ болған кезде
Dialogue: 0,0:13:51.20,0:13:55.20,Default,,0000,0000,0000,,Ыстық судан алыңыз➡
Dialogue: 0,0:13:55.20,0:13:58.20,Default,,0000,0000,0000,,Дәмдеуіштермен араластырыңыз және езіңіз.
Dialogue: 0,0:13:58.20,0:14:02.81,Default,,0000,0000,0000,,Иә? Бұл қиын.
Dialogue: 0,0:13:58.20,0:14:02.81,Default,,0000,0000,0000,,Екі мәлімдеме де дұрыс сияқты.
Dialogue: 0,0:14:02.81,0:14:04.81,Default,,0000,0000,0000,,Sensi Team》
Dialogue: 0,0:14:04.81,0:14:07.65,Default,,0000,0000,0000,,Мынау арпа жұмыртқалары
Dialogue: 0,0:14:04.81,0:14:07.65,Default,,0000,0000,0000,,Оны қайдан алдың?
Dialogue: 0,0:14:07.65,0:14:10.98,Default,,0000,0000,0000,,Құлаған үйдің ішінде ұя бар.
Dialogue: 0,0:14:10.98,0:14:13.49,Default,,0000,0000,0000,,Мен онда не бар екенін жинадым.
Dialogue: 0,0:14:13.49,0:14:16.49,Default,,0000,0000,0000,,《салманы 1см шаршыларға кесіңіз》
Dialogue: 0,0:14:16.49,0:14:18.49,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:14:18.49,0:14:22.33,Default,,0000,0000,0000,,Жұмыртқа тамаша….
Dialogue: 0,0:14:18.49,0:14:22.33,Default,,0000,0000,0000,,Тағамдық тағам.
Dialogue: 0,0:14:18.49,0:14:22.33,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:14:22.33,0:14:25.83,Default,,0000,0000,0000,,《Ингредиенттерді және күрішті баяу отта қуырыңыз.
Dialogue: 0,0:14:22.33,0:14:25.83,Default,,0000,0000,0000,,Дәмдеуіш қосу》
Dialogue: 0,0:14:25.83,0:14:29.17,Default,,0000,0000,0000,,Күріш Шлоудың сүйікті тағамы болды.
Dialogue: 0,0:14:29.17,0:14:33.34,Default,,0000,0000,0000,,Авантюристер үшін маңызды қоректік заттар
Dialogue: 0,0:14:29.17,0:14:33.34,Default,,0000,0000,0000,,Ол өте көп.
Dialogue: 0,0:14:33.34,0:14:35.84,Default,,0000,0000,0000,,Оны алу керемет болды.
Dialogue: 0,0:14:35.84,0:14:39.18,Default,,0000,0000,0000,,《Мен жай ғана құбыжықтар жегім келеді.
Dialogue: 0,0:14:35.84,0:14:39.18,Default,,0000,0000,0000,,Маған ұқсамайды➡
Dialogue: 0,0:14:39.18,0:14:42.01,Default,,0000,0000,0000,,Сенші бір қадам тереңдейді
Dialogue: 0,0:14:39.18,0:14:42.01,Default,,0000,0000,0000,,Алға қарау.
Dialogue: 0,0:14:42.01,0:14:45.52,Default,,0000,0000,0000,,Маған дәм мен тамақтану маңызды емес.
Dialogue: 0,0:14:45.52,0:14:50.02,Default,,0000,0000,0000,,Барлық тағамдар дәмді көрінеді.
Dialogue: 0,0:14:45.52,0:14:50.02,Default,,0000,0000,0000,,Тек шеберлікке қарап айта алмайсың.
Dialogue: 0,0:14:50.02,0:14:55.53,Default,,0000,0000,0000,,Мм... бұл туралы ешкім айтпайды.
Dialogue: 0,0:14:50.02,0:14:55.53,Default,,0000,0000,0000,,Мен тексеремін➡
Dialogue: 0,0:14:55.53,0:15:00.13,Default,,0000,0000,0000,,В сезімталдығы
Dialogue: 0,0:14:55.53,0:15:00.13,Default,,0000,0000,0000,,Сәл салқын емес пе?
Dialogue: 0,0:15:00.13,0:15:02.13,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:15:04.64,0:15:06.64,Default,,0000,0000,0000,,Менің ойымша, бұл осындай нәрсе.
Dialogue: 0,0:15:06.64,0:15:09.14,Default,,0000,0000,0000,,Сенші әрқашан салқын.
Dialogue: 0,0:15:06.64,0:15:09.14,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:15:09.14,0:15:14.31,Default,,0000,0000,0000,,Гномдарға қарсы көзқарас қандай?
Dialogue: 0,0:15:09.14,0:15:14.31,Default,,0000,0000,0000,,Сенші бұл ақымақ емес.
Dialogue: 0,0:15:14.31,0:15:17.12,Default,,0000,0000,0000,,《Сенси керемет...》
Dialogue: 0,0:15:20.99,0:15:25.16,Default,,0000,0000,0000,,Пісіру аяқталуға жақын.
Dialogue: 0,0:15:20.99,0:15:25.16,Default,,0000,0000,0000,,Сіз қорытындыға келдіңіз бе?
Dialogue: 0,0:15:25.16,0:15:28.49,Default,,0000,0000,0000,,《Шынымды айтсам... Менде ештеңе жоқ.
Dialogue: 0,0:15:28.49,0:15:32.00,Default,,0000,0000,0000,,Барлығы шынайы сияқты
Dialogue: 0,0:15:28.49,0:15:32.00,Default,,0000,0000,0000,,Бұл да жалғанға ұқсайды.
Dialogue: 0,0:15:32.00,0:15:35.33,Default,,0000,0000,0000,,Көбінесе өз басымыздан
Dialogue: 0,0:15:32.00,0:15:35.33,Default,,0000,0000,0000,,Туған иллюзияны ажыратыңыз➡
Dialogue: 0,0:15:35.33,0:15:37.50,Default,,0000,0000,0000,,Бұл өте әділетсіз шайқас емес пе?
Dialogue: 0,0:15:37.50,0:15:41.17,Default,,0000,0000,0000,,Адамға айналған құбыжықты табыңыз.
Dialogue: 0,0:15:37.50,0:15:41.17,Default,,0000,0000,0000,,Қызықты көрінеді➡
Dialogue: 0,0:15:41.17,0:15:45.34,Default,,0000,0000,0000,,Егер бұл фантомдық қарсылас болса, бұл жақсы...
Dialogue: 0,0:15:45.34,0:15:49.65,Default,,0000,0000,0000,,Құбыжықтарды іздеу...》
Dialogue: 0,0:15:45.34,0:15:49.65,Default,,0000,0000,0000,,Ол аяқталды!
Dialogue: 0,0:15:52.85,0:15:55.69,Default,,0000,0000,0000,,Олай болса барлығына
Dialogue: 0,0:15:52.85,0:15:55.69,Default,,0000,0000,0000,,Тамақтану кезінде тыңдаңыз.
Dialogue: 0,0:15:55.69,0:15:59.02,Default,,0000,0000,0000,,Мен шын деп ойлаған нәрсе➡
Dialogue: 0,0:15:59.02,0:16:03.13,Default,,0000,0000,0000,,Чилчак А
Dialogue: 0,0:15:59.02,0:16:03.13,Default,,0000,0000,0000,,Бұл өте ұқыпсыз және таяз!
Dialogue: 0,0:16:03.13,0:16:08.30,Default,,0000,0000,0000,,Марсиль Б! Тіпті Фарин үшін
Dialogue: 0,0:16:03.13,0:16:08.30,Default,,0000,0000,0000,,Мен гарпи жұмыртқасын жегім келмейді!
Dialogue: 0,0:16:08.30,0:16:11.30,Default,,0000,0000,0000,,Сенши А! Ақымақ!
Dialogue: 0,0:16:11.30,0:16:13.81,Default,,0000,0000,0000,,Сонымен, бәрің де жалған адамдар➡
Dialogue: 0,0:16:13.81,0:16:16.98,Default,,0000,0000,0000,,Бірден торға кіріңіз.
Dialogue: 0,0:16:13.81,0:16:16.98,Default,,0000,0000,0000,,Бір минут күте тұрыңыз!
Dialogue: 0,0:16:16.98,0:16:19.65,Default,,0000,0000,0000,,Бұны шын деп қалай бағалайсыз?
Dialogue: 0,0:16:19.65,0:16:21.98,Default,,0000,0000,0000,,Қалай қарасаң да, бұл жалған!
Dialogue: 0,0:16:21.98,0:16:23.98,Default,,0000,0000,0000,,Неліктен олай ойладың? ?
Dialogue: 0,0:16:23.98,0:16:26.49,Default,,0000,0000,0000,,Хмм, қалай болғанда да.
Dialogue: 0,0:16:26.49,0:16:31.16,Default,,0000,0000,0000,,Ал, мен мұны кейін түсіндіремін.
Dialogue: 0,0:16:26.49,0:16:31.16,Default,,0000,0000,0000,,Алдымен жалған заттармен айналысайық.
Dialogue: 0,0:16:31.16,0:16:34.33,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:16:31.16,0:16:34.33,Default,,0000,0000,0000,,Қалай болғанда да?
Dialogue: 0,0:16:34.33,0:16:38.00,Default,,0000,0000,0000,,Өңдеу….
Dialogue: 0,0:16:34.33,0:16:38.00,Default,,0000,0000,0000,,Өйткені, бұл жігіт жақсы емес.
Dialogue: 0,0:16:38.00,0:16:42.50,Default,,0000,0000,0000,,Өзім туралы.
Dialogue: 0,0:16:38.00,0:16:42.50,Default,,0000,0000,0000,,Оны өзім қорғаудан басқа амалым жоқ сияқты.
Dialogue: 0,0:16:42.50,0:16:44.67,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:16:42.50,0:16:44.67,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:16:44.67,0:16:48.84,Default,,0000,0000,0000,,《Кімді таңдасаң да, ақырында солай болады.
Dialogue: 0,0:16:48.84,0:16:52.34,Default,,0000,0000,0000,,Пішін ауыстырғыш
Dialogue: 0,0:16:48.84,0:16:52.34,Default,,0000,0000,0000,,Сыртқы түріне еліктейтін құбыжықтарға арналған жалпы термин.
Dialogue: 0,0:16:52.34,0:16:55.18,Default,,0000,0000,0000,,Дауыстарға еліктейтіндер, оларға иелер.
Dialogue: 0,0:16:55.18,0:16:57.68,Default,,0000,0000,0000,,Пішінін өзгертетін нәрсе.
Dialogue: 0,0:16:57.68,0:17:00.45,Default,,0000,0000,0000,,Мыналардың қайсысы бұл жігіттің шынайы тұлғасы?
Dialogue: 0,0:17:00.45,0:17:03.96,Default,,0000,0000,0000,,Кез келген сома
Dialogue: 0,0:17:00.45,0:17:03.96,Default,,0000,0000,0000,,Құбыжықтар ас әзірлеуге мүмкіндік жоқ.
Dialogue: 0,0:17:03.96,0:17:06.96,Default,,0000,0000,0000,,Марсиль айтқандай
Dialogue: 0,0:17:03.96,0:17:06.96,Default,,0000,0000,0000,,Галлюцинацияларды манипуляциялауы мүмкін.
Dialogue: 0,0:17:06.96,0:17:11.13,Default,,0000,0000,0000,,Адамдарды немесе жануарларды нысанаға алудан
Dialogue: 0,0:17:06.96,0:17:11.13,Default,,0000,0000,0000,,Етқоректілер немесе барлық қоректілер.
Dialogue: 0,0:17:11.13,0:17:14.97,Default,,0000,0000,0000,,Жыртқышқа бетпе-бет шабуыл жасау жеткілікті.
Dialogue: 0,0:17:11.13,0:17:14.97,Default,,0000,0000,0000,,Күшсіз және қорқақ.
Dialogue: 0,0:17:14.97,0:17:18.14,Default,,0000,0000,0000,,Бұл жерде күн суық және қараңғы, көру қабілеті нашар.
Dialogue: 0,0:17:18.14,0:17:22.14,Default,,0000,0000,0000,,Суыққа төзімді
Dialogue: 0,0:17:18.14,0:17:22.14,Default,,0000,0000,0000,,Бұл иіс пен естуге сүйенетін аң.
Dialogue: 0,0:17:24.98,0:17:26.98,Default,,0000,0000,0000,,《Еңбек жағы – сол жағы.
Dialogue: 0,0:17:26.98,0:17:30.65,Default,,0000,0000,0000,,Біз жаумыз
Dialogue: 0,0:17:26.98,0:17:30.65,Default,,0000,0000,0000,,Шаршауды күту.
Dialogue: 0,0:17:30.65,0:17:33.99,Default,,0000,0000,0000,,Қылышыңды ойланбай сермесең де
Dialogue: 0,0:17:30.65,0:17:33.99,Default,,0000,0000,0000,,Мен оны ұрамын деп ойламаймын...
Dialogue: 0,0:17:33.99,0:17:36.32,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:17:36.32,0:17:41.49,Default,,0000,0000,0000,,Кенсуке де тыныш.
Dialogue: 0,0:17:36.32,0:17:41.49,Default,,0000,0000,0000,,Суықтан өліп қалуыңыз мүмкін.
Dialogue: 0,0:17:41.49,0:17:44.16,Default,,0000,0000,0000,,Аңның өз жолы бар➡
Dialogue: 0,0:17:44.16,0:17:48.33,Default,,0000,0000,0000,,Аңшыдан аңшыға дейін
Dialogue: 0,0:17:44.16,0:17:48.33,Default,,0000,0000,0000,,Тек оны кері айналдырыңыз.
Dialogue: 0,0:17:48.33,0:17:51.50,Default,,0000,0000,0000,,Бұл біраз уақыттан кейін бірінші рет болып жатыр ма?
Dialogue: 0,0:17:51.50,0:17:58.01,Default,,0000,0000,0000,,(Қақтығыс дауыстары)
Dialogue: 0,0:18:04.62,0:18:06.62,Default,,0000,0000,0000,,(Иттің үргеніне еліктеу)
Dialogue: 0,0:18:06.62,0:18:08.62,Default,,0000,0000,0000,,А...?
Dialogue: 0,0:18:08.62,0:18:13.13,Default,,0000,0000,0000,,(қабығы)
Dialogue: 0,0:18:13.13,0:18:15.13,Default,,0000,0000,0000,,Бұл ит пе?
Dialogue: 0,0:18:13.13,0:18:15.13,Default,,0000,0000,0000,,Дәмді!
Dialogue: 0,0:18:13.13,0:18:15.13,Default,,0000,0000,0000,,(қабығы)
Dialogue: 0,0:18:15.13,0:18:17.30,Default,,0000,0000,0000,,Жоқ, бұл ит! ?
Dialogue: 0,0:18:15.13,0:18:17.30,Default,,0000,0000,0000,,(қабығы)
Dialogue: 0,0:18:17.30,0:18:20.80,Default,,0000,0000,0000,,《Есімде қалғандықтан
Dialogue: 0,0:18:17.30,0:18:20.80,Default,,0000,0000,0000,,Иттер әрқашан жанымда➡
Dialogue: 0,0:18:20.80,0:18:22.80,Default,,0000,0000,0000,,Мен көп нәрсені білдім.
Dialogue: 0,0:18:22.80,0:18:27.64,Default,,0000,0000,0000,,Қалай аң аулау керек! өзімізге қарағанда
Dialogue: 0,0:18:22.80,0:18:27.64,Default,,0000,0000,0000,,Күштілерге қалай қарсы шығу керек!
Dialogue: 0,0:18:27.64,0:18:30.81,Default,,0000,0000,0000,,Мен саған үйретемін! 》
Dialogue: 0,0:18:30.81,0:18:34.65,Default,,0000,0000,0000,,Тамаша!
Dialogue: 0,0:18:30.81,0:18:34.65,Default,,0000,0000,0000,,Бұл өте жақсы!
Dialogue: 0,0:18:30.81,0:18:34.65,Default,,0000,0000,0000,,Бұл ит!
Dialogue: 0,0:18:34.65,0:18:39.15,Default,,0000,0000,0000,,《Сен аңшы емессің.
Dialogue: 0,0:18:34.65,0:18:39.15,Default,,0000,0000,0000,,Мен аңшылық жағындамын! 》
Dialogue: 0,0:18:39.15,0:18:41.15,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:18:41.15,0:18:43.82,Default,,0000,0000,0000,,Барлығына! Қараңдар! Иллюзия!
Dialogue: 0,0:18:43.82,0:18:45.99,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:18:43.82,0:18:45.99,Default,,0000,0000,0000,,Уа.
Dialogue: 0,0:18:45.99,0:18:56.34,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:18:56.34,0:18:59.17,Default,,0000,0000,0000,,《Құйрығыңды көрсеттің.
Dialogue: 0,0:18:59.17,0:19:01.61,Default,,0000,0000,0000,,Сен де хайуан болсаң
Dialogue: 0,0:18:59.17,0:19:01.61,Default,,0000,0000,0000,,Сіз жақсырақ білесіз.
Dialogue: 0,0:19:01.61,0:19:04.94,Default,,0000,0000,0000,,Бұл шайқас!
Dialogue: 0,0:19:04.94,0:19:09.95,Default,,0000,0000,0000,,Қорыққан дұрыс
Dialogue: 0,0:19:04.94,0:19:09.95,Default,,0000,0000,0000,,Егер ұтылып қалсаңыз! 》
Dialogue: 0,0:19:09.95,0:19:13.62,Default,,0000,0000,0000,,Риосу!
Dialogue: 0,0:19:13.62,0:19:20.13,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:19:20.13,0:19:22.63,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:19:22.63,0:19:24.63,Default,,0000,0000,0000,,Сиыр!
Dialogue: 0,0:19:32.30,0:19:35.31,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:19:35.31,0:19:41.31,Default,,0000,0000,0000,,Сен тірісің бе, Райос? Немесе есі дұрыс па?
Dialogue: 0,0:19:35.31,0:19:41.31,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:19:41.31,0:19:45.15,Default,,0000,0000,0000,,Айтайын дегенім көп.
Dialogue: 0,0:19:41.31,0:19:45.15,Default,,0000,0000,0000,,Неге қаруыңды тартпадың?
Dialogue: 0,0:19:45.15,0:19:47.65,Default,,0000,0000,0000,,Аздап пайдалы
Dialogue: 0,0:19:45.15,0:19:47.65,Default,,0000,0000,0000,,Ол тым араласып кетті...
Dialogue: 0,0:19:47.65,0:19:49.66,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:19:47.65,0:19:49.66,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:51.66,0:19:53.83,Default,,0000,0000,0000,,Барлық тағамдар аяқталмаған.
Dialogue: 0,0:19:53.83,0:19:58.50,Default,,0000,0000,0000,,Бұл галлюцинациямен жасалған тағам болды.
Dialogue: 0,0:19:53.83,0:19:58.50,Default,,0000,0000,0000,,Оны қайта жасайық.
Dialogue: 0,0:19:58.50,0:20:03.34,Default,,0000,0000,0000,,Бірақ... сайып келгенде, Лайостың эстетикалық сезімі
Dialogue: 0,0:19:58.50,0:20:03.34,Default,,0000,0000,0000,,Бұл дұрыс жауап болды.
Dialogue: 0,0:20:03.34,0:20:05.50,Default,,0000,0000,0000,,Шешім қабылдау үшін қайда қарау керек?
Dialogue: 0,0:20:05.50,0:20:10.01,Default,,0000,0000,0000,,Бәлкім, бұл құбыжықтардан қашық болу сезімі шығар...
Dialogue: 0,0:20:05.50,0:20:10.01,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:10.01,0:20:13.18,Default,,0000,0000,0000,,Алдымен Чилчак ағаш жәшікке отырды.
Dialogue: 0,0:20:13.18,0:20:16.85,Default,,0000,0000,0000,,Осындай орын Мимикалар мен Тәндіктерге толы.
Dialogue: 0,0:20:13.18,0:20:16.85,Default,,0000,0000,0000,,Бұл тамаша жасырыну.
Dialogue: 0,0:20:16.85,0:20:20.35,Default,,0000,0000,0000,,оған мүлдем мән бермейді
Dialogue: 0,0:20:16.85,0:20:20.35,Default,,0000,0000,0000,,Мен оның жұмысы жақсы емес сияқты екеніне таң қалдым.
Dialogue: 0,0:20:20.35,0:20:23.52,Default,,0000,0000,0000,,｟Құлаған жеке үй
Dialogue: 0,0:20:20.35,0:20:23.52,Default,,0000,0000,0000,,Ішінде ұя бар.
Dialogue: 0,0:20:23.52,0:20:26.02,Default,,0000,0000,0000,,Мен онда бар нәрсені жинадым｠
Dialogue: 0,0:20:26.02,0:20:29.03,Default,,0000,0000,0000,,Экожүйе балансы
Dialogue: 0,0:20:26.02,0:20:29.03,Default,,0000,0000,0000,,Оны бағалайтын адамға➡
Dialogue: 0,0:20:29.03,0:20:31.03,Default,,0000,0000,0000,,Біршама елеусіз.
Dialogue: 0,0:20:31.03,0:20:34.03,Default,,0000,0000,0000,,｟Себебі арфаны же
Dialogue: 0,0:20:31.03,0:20:34.03,Default,,0000,0000,0000,,Жағдай жақсара ма? ｠
Dialogue: 0,0:20:34.03,0:20:37.20,Default,,0000,0000,0000,,Ақыры Марсиль қайнаған суды лақтырып жіберді.
Dialogue: 0,0:20:37.20,0:20:41.21,Default,,0000,0000,0000,,Егер сіз Undine-дан сақ болсаңыз
Dialogue: 0,0:20:37.20,0:20:41.21,Default,,0000,0000,0000,,Бұл әрекет абайсызда болды➡
Dialogue: 0,0:20:41.21,0:20:43.88,Default,,0000,0000,0000,,Бұған мүлдем мән бермейтін сияқты
Dialogue: 0,0:20:41.21,0:20:43.88,Default,,0000,0000,0000,,Оның болмауы ұсталды.
Dialogue: 0,0:20:43.88,0:20:47.88,Default,,0000,0000,0000,,Хмм... мм?
Dialogue: 0,0:20:47.88,0:20:51.55,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:20:47.88,0:20:51.55,Default,,0000,0000,0000,,Бұл жағдайда абайсыздық➡
Dialogue: 0,0:20:51.55,0:20:55.39,Default,,0000,0000,0000,,Керісінше, мен бұл шынайы көрінеді деп ойладым.
Dialogue: 0,0:20:51.55,0:20:55.39,Default,,0000,0000,0000,,Эй.
Dialogue: 0,0:20:55.39,0:20:59.22,Default,,0000,0000,0000,,Мен мұны қайталаймын, Райос.
Dialogue: 0,0:20:59.22,0:21:02.33,Default,,0000,0000,0000,,Қандай көзқарас?
Dialogue: 0,0:20:59.22,0:21:02.33,Default,,0000,0000,0000,,Бұл аз.
Dialogue: 0,0:21:02.33,0:21:06.50,Default,,0000,0000,0000,,Жоқ, бірақ мен иллюзия арқылы көре алатыныма сенбеймін.
Dialogue: 0,0:21:02.33,0:21:06.50,Default,,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,0:21:06.50,0:21:09.84,Default,,0000,0000,0000,,Сол жерде де
Dialogue: 0,0:21:06.50,0:21:09.84,Default,,0000,0000,0000,,Мен осы бір бөтелкені ғана жеп жатырмын.
Dialogue: 0,0:21:09.84,0:21:11.84,Default,,0000,0000,0000,,Мен сенімдімін...
Dialogue: 0,0:21:11.84,0:21:15.17,Default,,0000,0000,0000,,｟Мен тіпті балықшылардың жұмыртқалары мен драйадтарын жедім｠
Мен сіз
Dialogue: 0,0:21:15.17,0:21:18.34,Default,,0000,0000,0000,,сөздерімен
Dialogue: 0,0:21:15.17,0:21:18.34,Default,,0000,0000,0000,,Сіз байқадыңыз деп ойладым.
Dialogue: 0,0:21:18.34,0:21:23.52,Default,,0000,0000,0000,,Өйткені, біз балықшының жұмыртқамыз.
Dialogue: 0,0:21:18.34,0:21:23.52,Default,,0000,0000,0000,,Мен оны ешқашан жеген емеспін. Дұрыс па?
Dialogue: 0,0:21:23.52,0:21:26.35,Default,,0000,0000,0000,,｟Уфуфу…｠
Dialogue: 0,0:21:26.35,0:21:30.36,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:21:26.35,0:21:30.36,Default,,0000,0000,0000,,《Ол кездегі күріш ботқасы шығар》
Dialogue: 0,0:21:32.69,0:21:36.03,Default,,0000,0000,0000,,Тәтті де күйіп кетті.
Dialogue: 0,0:21:32.69,0:21:36.03,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:21:36.03,0:21:40.03,Default,,0000,0000,0000,,Тәттілер Дәмді бірдеңенің дәмін татқаныма көп болды.
Dialogue: 0,0:21:36.03,0:21:40.03,Default,,0000,0000,0000,,Шай ішуге бола ма?
Dialogue: 0,0:21:40.03,0:21:43.37,Default,,0000,0000,0000,,Мен алған ингредиенттерде екеніне сенімдімін.
Dialogue: 0,0:21:40.03,0:21:43.37,Default,,0000,0000,0000,,Шай жапырақтары...
Dialogue: 0,0:21:43.37,0:21:45.37,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:45.37,0:21:49.37,Default,,0000,0000,0000,,Бұл түсінбеушілік емес пе?
Dialogue: 0,0:21:45.37,0:21:49.37,Default,,0000,0000,0000,,Жоқ, мен оны міндетті түрде осында қойдым.
Dialogue: 0,0:21:49.37,0:21:51.38,Default,,0000,0000,0000,,А...?
Dialogue: 0,0:21:53.38,0:21:55.38,Default,,0000,0000,0000,,《Күріш...》
Dialogue: 0,0:21:57.38,0:21:59.38,Default,,0000,0000,0000,,​​О?
Dialogue: 0,0:21:59.38,0:22:08.16,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:22:08.16,0:22:10.16,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:22:10.16,0:22:12.16,Default,,0000,0000,0000,,Жоқ….
Dialogue: 0,0:22:14.17,0:22:16.17,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:22:14.17,0:22:16.17,Default,,0000,0000,0000,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:22:16.17,0:22:19.50,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:22:16.17,0:22:19.50,Default,,0000,0000,0000,,Марсиль! ?
Dialogue: 0,0:22:19.50,0:22:25.01,Default,,0000,0000,0000,,Қаруыңызды тастаңыз және қозғалмаңыз.
Dialogue: 0,0:22:19.50,0:22:25.01,Default,,0000,0000,0000,,Бейбіт сөйлесейік.
Dialogue: 0,0:22:26.51,0:22:32.51,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory