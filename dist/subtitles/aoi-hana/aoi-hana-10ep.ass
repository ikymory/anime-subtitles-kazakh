Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.46,0:00:05.46,Rubi,,0000,0000,0000,,Ясуко
Dialogue: 0,0:00:01.46,0:00:05.46,Default,,0000,0000,0000,,≪(Ана) Кьюки
Dialogue: 0,0:00:01.46,0:00:05.46,Default,,0000,0000,0000,,Аналар, кеттік
Dialogue: 0,0:00:05.46,0:00:08.47,Default,,0000,0000,0000,,Дайындықтан кейін
Dialogue: 0,0:00:05.46,0:00:08.47,Default,,0000,0000,0000,,Барлығымен бірге көлікпен келіңіз.
Dialogue: 0,0:00:08.47,0:00:12.47,Rubi,,0000,0000,0000,,Казуза
Dialogue: 0,0:00:08.47,0:00:12.47,Default,,0000,0000,0000,,≪(Кёми) Васа-чан ше?
Dialogue: 0,0:00:08.47,0:00:12.47,Default,,0000,0000,0000,,Ол әлдеқашан шықты
Dialogue: 0,0:00:16.48,0:00:19.48,Default,,0000,0000,0000,,Не керек, Крюгер мырза?
Dialogue: 0,0:00:16.48,0:00:19.48,Default,,0000,0000,0000,,Жалдамалы көлік келетін уақыт таяп қалды.
Dialogue: 0,0:00:19.48,0:00:23.48,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:00:19.48,0:00:23.48,Default,,0000,0000,0000,,Не? Әлі де артта қалды ма?
Dialogue: 0,0:00:29.49,0:00:31.49,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:00:36.50,0:00:41.50,Default,,0000,0000,0000,,Бүгін күн ашық.
Dialogue: 0,0:00:41.50,0:00:46.51,Rubi,,0000,0000,0000,,Көк
Dialogue: 0,0:00:41.50,0:00:46.51,Rubi,,0000,0000,0000,,3D маневрлік жабдықтың табиғи жауы.
Dialogue: 0,0:00:41.50,0:00:46.51,Default,,0000,0000,0000,,♬『Көк гүл』
Dialogue: 0,0:00:46.51,0:01:06.46,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:01:06.46,0:01:15.47,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:01:15.47,0:01:35.49,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:01:35.49,0:01:55.52,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:01:55.52,0:02:09.52,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:02:22.47,0:02:24.47,Rubi,,0000,0000,0000,,Йоши
Dialogue: 0,0:02:22.47,0:02:24.47,Default,,0000,0000,0000,,Жақсысың➡
Dialogue: 0,0:02:24.47,0:02:27.47,Default,,0000,0000,0000,,Жексенбі туралы айту
Dialogue: 0,0:02:24.47,0:02:27.47,Default,,0000,0000,0000,,Таңертеңнен бері жатырмын.
Dialogue: 0,0:02:27.47,0:02:30.48,Default,,0000,0000,0000,,Жазғы демалыс
Dialogue: 0,0:02:27.47,0:02:30.48,Default,,0000,0000,0000,,Баяғыда өтті.➡
Dialogue: 0,0:02:30.48,0:02:35.48,Rubi,,0000,0000,0000,,Мацуока
Dialogue: 0,0:02:30.48,0:02:35.48,Default,,0000,0000,0000,,Мацуокаға түссем де, бағаларым
Dialogue: 0,0:02:30.48,0:02:35.48,Default,,0000,0000,0000,,Мен оның құлағанын қаламаймын.➡
Dialogue: 0,0:02:35.48,0:02:38.48,Default,,0000,0000,0000,,Қараңызшы, әкем де оянды.
Dialogue: 0,0:02:35.48,0:02:38.48,Default,,0000,0000,0000,,Тағам дайын.
Dialogue: 0,0:02:38.48,0:02:42.48,Rubi,,0000,0000,0000,,Акио
Dialogue: 0,0:02:38.48,0:02:42.48,Default,,0000,0000,0000,,Иә... бұл жақсы.
Dialogue: 0,0:02:50.50,0:02:53.50,Default,,0000,0000,0000,,Қараңдар, Фумимо күріш.
Dialogue: 0,0:02:53.50,0:02:55.50,Default,,0000,0000,0000,,(Фумино күрсініп)
Dialogue: 0,0:02:55.50,0:02:57.50,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:02:59.51,0:03:02.51,Rubi,,0000,0000,0000,,Иә, сол – қамыр жағылған.
Dialogue: 0,0:02:59.51,0:03:02.51,Default,,0000,0000,0000,,Сіз бірдеңені ұмыттыңыз ба?
Dialogue: 0,0:02:59.51,0:03:02.51,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:03:02.51,0:03:05.51,Default,,0000,0000,0000,,Сіз сыйлық әкелдіңіз бе?
Dialogue: 0,0:03:02.51,0:03:05.51,Default,,0000,0000,0000,,Менде бар
Dialogue: 0,0:03:05.51,0:03:08.51,Default,,0000,0000,0000,,Ұялы телефондар туралы не деуге болады? Рәсім кезінде қуат көзін қосыңыз...
Dialogue: 0,0:03:05.51,0:03:08.51,Default,,0000,0000,0000,,Бұл өте шулы!
Dialogue: 0,0:03:08.51,0:03:12.51,Default,,0000,0000,0000,,Мен бастауыш сынып оқушысы емеспін. Хмм.
Dialogue: 0,0:03:14.45,0:03:16.46,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:14.45,0:03:16.46,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:03:16.46,0:03:19.46,Default,,0000,0000,0000,,Ах... мектеп...
Dialogue: 0,0:03:19.46,0:03:23.46,Default,,0000,0000,0000,,Әй, олар оны қайта құрғалы жатыр.
Dialogue: 0,0:03:19.46,0:03:23.46,Default,,0000,0000,0000,,Қайта құру?
Dialogue: 0,0:03:23.46,0:03:27.47,Default,,0000,0000,0000,,Мектеп ғимараты ескі.
Dialogue: 0,0:03:23.46,0:03:27.47,Default,,0000,0000,0000,,Мен жаңасын саламын.
Dialogue: 0,0:03:27.47,0:03:41.48,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:03:41.48,0:03:45.48,Default,,0000,0000,0000,,Жылама, Якчан
Dialogue: 0,0:03:41.48,0:03:45.48,Default,,0000,0000,0000,,Мен жыламаймын
Dialogue: 0,0:03:45.48,0:03:48.49,Default,,0000,0000,0000,,Мен жылаймын
Dialogue: 0,0:03:45.48,0:03:48.49,Default,,0000,0000,0000,,Сенің жылайтыныңа сенімдімін
Dialogue: 0,0:03:48.49,0:03:51.49,Default,,0000,0000,0000,,Не? Бұл сенімділік
Dialogue: 0,0:03:51.49,0:03:55.49,Default,,0000,0000,0000,,Датте Якчан
Dialogue: 0,0:03:51.49,0:03:55.49,Default,,0000,0000,0000,,Өйткені ол өте нәзік
Dialogue: 0,0:03:58.50,0:04:00.50,Default,,0000,0000,0000,,Ятчан шынымен➡
Dialogue: 0,0:04:00.50,0:04:04.50,Default,,0000,0000,0000,,Мұндай көрініс
Dialogue: 0,0:04:00.50,0:04:04.50,Default,,0000,0000,0000,,Бұл сізге жақсы көрінеді.➡
Dialogue: 0,0:04:04.50,0:04:10.51,Rubi,,0000,0000,0000,,Каштан
Dialogue: 0,0:04:04.50,0:04:10.51,Default,,0000,0000,0000,,Сіз және аксиома ханзада типісіз.
Dialogue: 0,0:04:04.50,0:04:10.51,Default,,0000,0000,0000,,Ол танымал болғандықтан қиын.
Dialogue: 0,0:04:10.51,0:04:14.45,Default,,0000,0000,0000,,Сонымен барлығы
Dialogue: 0,0:04:10.51,0:04:14.45,Default,,0000,0000,0000,,Сіз қате түсіндіңіз.
Dialogue: 0,0:04:14.45,0:04:17.45,Default,,0000,0000,0000,,Ей, тыныштал, тойла.
Dialogue: 0,0:04:17.45,0:04:21.45,Default,,0000,0000,0000,,Бір рет кері қайтарудың құпиясы
Dialogue: 0,0:04:17.45,0:04:21.45,Default,,0000,0000,0000,,Мен саған айтамын.➡
Dialogue: 0,0:04:21.45,0:04:24.46,Default,,0000,0000,0000,,Ятчанды құттықтаймыз
Dialogue: 0,0:04:21.45,0:04:24.46,Default,,0000,0000,0000,,Маған айту керек➡
Dialogue: 0,0:04:24.46,0:04:26.46,Default,,0000,0000,0000,,Мен дұрыс үйлене алмаймын.
Dialogue: 0,0:04:30.46,0:04:34.47,Rubi,,0000,0000,0000,,Киоко
Dialogue: 0,0:04:30.46,0:04:34.47,Default,,0000,0000,0000,,Маған жібергеніңіз үшін рахмет.
Dialogue: 0,0:04:30.46,0:04:34.47,Rubi,,0000,0000,0000,,Мынау да.
Dialogue: 0,0:04:30.46,0:04:34.47,Default,,0000,0000,0000,,Жұмысты аяқтаған кезде маған хабарлаңыз
Dialogue: 0,0:04:34.47,0:04:39.47,Default,,0000,0000,0000,,Күтудің қажеті жоқ.
Dialogue: 0,0:04:34.47,0:04:39.47,Default,,0000,0000,0000,,Қашан бітетінін білмеймін.
Dialogue: 0,0:04:39.47,0:04:42.47,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:04:39.47,0:04:42.47,Default,,0000,0000,0000,,Мен жай ғана уақытты өлтіріп жатырмын.
Dialogue: 0,0:04:45.48,0:04:48.48,Rubi,,0000,0000,0000,,Икуми
Dialogue: 0,0:04:45.48,0:04:48.48,Default,,0000,0000,0000,,Игуми мырза!
Dialogue: 0,0:04:48.48,0:04:51.48,Rubi,,0000,0000,0000,,Окудаира
Dialogue: 0,0:04:48.48,0:04:51.48,Default,,0000,0000,0000,,Окудаира мырза. А, сәлем.
Dialogue: 0,0:04:51.48,0:04:55.49,Default,,0000,0000,0000,,А? Ах!
Dialogue: 0,0:04:55.49,0:04:57.49,Default,,0000,0000,0000,,Сіз қатысасыз ба?
Dialogue: 0,0:04:57.49,0:04:59.49,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:04:57.49,0:04:59.49,Default,,0000,0000,0000,,«Иә» емес!
Dialogue: 0,0:04:59.49,0:05:02.49,Default,,0000,0000,0000,,Мұнда неге жүрсің?
Dialogue: 0,0:04:59.49,0:05:02.49,Default,,0000,0000,0000,,Оған сенің ағаңның еш қатысы жоқ, солай ма?
Dialogue: 0,0:05:02.49,0:05:06.50,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:05:02.49,0:05:06.50,Default,,0000,0000,0000,,Мен сенің қамқоршыңмын.
Dialogue: 0,0:05:06.50,0:05:10.50,Rubi,,0000,0000,0000,,Саваной
Dialogue: 0,0:05:06.50,0:05:10.50,Default,,0000,0000,0000,,Саваной-сан да шығады, солай ма?
Dialogue: 0,0:05:06.50,0:05:10.50,Default,,0000,0000,0000,,А... жоқ, мен...
Dialogue: 0,0:05:10.50,0:05:12.44,Default,,0000,0000,0000,,Қазірдің өзінде! Тез үйге бар
Dialogue: 0,0:05:12.44,0:05:17.44,Default,,0000,0000,0000,,Сен де бүгін жақсы жүрсің, Аа-чан.
Dialogue: 0,0:05:12.44,0:05:17.44,Default,,0000,0000,0000,,А... Сенпай
Dialogue: 0,0:05:19.44,0:05:24.45,Default,,0000,0000,0000,,Хмм... Бүгін күн жақсы.
Dialogue: 0,0:05:19.44,0:05:24.45,Default,,0000,0000,0000,,Бүгінгі жақсы күнді қарсы алу...➡
Dialogue: 0,0:05:24.45,0:05:27.45,Default,,0000,0000,0000,,Шынымен...
Dialogue: 0,0:05:24.45,0:05:27.45,Default,,0000,0000,0000,,Құттықтаймыз!
Dialogue: 0,0:05:27.45,0:05:31.46,Default,,0000,0000,0000,,Хаха... Рахмет.➡
Dialogue: 0,0:05:31.46,0:05:35.46,Default,,0000,0000,0000,,Сіз ше?
Dialogue: 0,0:05:31.46,0:05:35.46,Default,,0000,0000,0000,,Ол Акира Окудайраның ағасы.
Dialogue: 0,0:05:35.46,0:05:37.46,Default,,0000,0000,0000,,Ясуши Саванои
Dialogue: 0,0:05:37.46,0:05:39.46,Default,,0000,0000,0000,,Киоконың жігіті?
Dialogue: 0,0:05:39.46,0:05:41.47,Default,,0000,0000,0000,,Бұл жай ғана атау.
Dialogue: 0,0:05:41.47,0:05:43.47,Rubi,,0000,0000,0000,,Сугимото
Dialogue: 0,0:05:41.47,0:05:43.47,Default,,0000,0000,0000,,Менің атым Ясуми Сугимото.
Dialogue: 0,0:05:43.47,0:05:46.47,Default,,0000,0000,0000,,Мм, қарсы болмасаңыз.
Dialogue: 0,0:05:43.47,0:05:46.47,Default,,0000,0000,0000,,Сіз қатысқыңыз келе ме?
Dialogue: 0,0:05:46.47,0:05:48.47,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:46.47,0:05:48.47,Default,,0000,0000,0000,,сонымен қатар кейбір қосымша пайда да бар. Олар қандай?
Dialogue: 0,0:05:48.47,0:05:51.48,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:05:48.47,0:05:51.48,Default,,0000,0000,0000,,Сізге көп рахмет
Dialogue: 0,0:05:51.48,0:05:53.48,Default,,0000,0000,0000,,Міне…｡ Сенпай
Dialogue: 0,0:05:53.48,0:05:56.48,Default,,0000,0000,0000,,Құттықтайтын адам көп
Dialogue: 0,0:05:53.48,0:05:56.48,Default,,0000,0000,0000,,Мен бақытты емеспін.
Dialogue: 0,0:05:56.48,0:06:00.48,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:05:56.48,0:06:00.48,Default,,0000,0000,0000,,Мен сіздің сөздеріңізді бағалаймын.
Dialogue: 0,0:06:02.49,0:06:05.49,Default,,0000,0000,0000,,Міне, міне.
Dialogue: 0,0:06:02.49,0:06:05.49,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:06:09.49,0:06:13.43,Default,,0000,0000,0000,,Уф. Жұмыс біткен бойда үйге кел.
Dialogue: 0,0:06:13.43,0:06:16.43,Default,,0000,0000,0000,,Сіз қаншалықты өзімшілсіз?
Dialogue: 0,0:06:18.44,0:06:21.44,Default,,0000,0000,0000,,Не? Денің сау ма? (Миямура) Иә.
Dialogue: 0,0:06:21.44,0:06:25.44,Default,,0000,0000,0000,,Иә? Бұл сурет пе?
Dialogue: 0,0:06:25.44,0:06:27.45,Default,,0000,0000,0000,,Себебі мен ұстазымнан үйрендім
Dialogue: 0,0:06:27.45,0:06:29.45,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:06:29.45,0:06:33.45,Default,,0000,0000,0000,,Киоко үшін
Dialogue: 0,0:06:29.45,0:06:33.45,Default,,0000,0000,0000,,Екеуі де менің тәлімгерім.
Dialogue: 0,0:06:35.45,0:06:40.45,Default,,0000,0000,0000,,Әдеттегідей, аға
Dialogue: 0,0:06:35.45,0:06:40.45,Default,,0000,0000,0000,,Сіз осындай киіммен жақсы көрінесіз.
Dialogue: 0,0:06:42.46,0:06:45.46,Default,,0000,0000,0000,,Сондай-ақ Васа-чанға
Dialogue: 0,0:06:42.46,0:06:45.46,Default,,0000,0000,0000,,Дәл осылай айтылды
Dialogue: 0,0:06:48.47,0:06:50.47,Default,,0000,0000,0000,,Сіз шығасыз ба?
Dialogue: 0,0:06:50.47,0:06:53.47,Default,,0000,0000,0000,,Иә. Жай серуендеу.
Dialogue: 0,0:06:57.48,0:07:09.49,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:07:09.49,0:07:12.49,Default,,0000,0000,0000,,Сіз әлі ұйықтап жатырсыз ба?
Dialogue: 0,0:07:15.43,0:07:18.43,Rubi,,0000,0000,0000,,Шинако
Dialogue: 0,0:07:15.43,0:07:18.43,Default,,0000,0000,0000,,Ятчантара
Dialogue: 0,0:07:15.43,0:07:18.43,Default,,0000,0000,0000,,Қандай құрметсіздік.➡
Dialogue: 0,0:07:18.43,0:07:24.44,Default,,0000,0000,0000,,Бүгін шыға аласыз ба?
Dialogue: 0,0:07:18.43,0:07:24.44,Default,,0000,0000,0000,,Мен уайымдасам да, сен көңілді жүрдің.
Dialogue: 0,0:07:24.44,0:07:27.44,Default,,0000,0000,0000,,Әйтпесе
Dialogue: 0,0:07:24.44,0:07:27.44,Default,,0000,0000,0000,,Көзімнен жас ағып жатыр.
Dialogue: 0,0:07:27.44,0:07:29.44,Default,,0000,0000,0000,,Тағы да осындай жаман сөзді айтыңыз
Dialogue: 0,0:07:29.44,0:07:33.45,Default,,0000,0000,0000,,Өйткені бұл шындық.
Dialogue: 0,0:07:33.45,0:07:37.45,Default,,0000,0000,0000,,Еңбегіңіз үшін рахмет. Біраз демалыңыз.
Dialogue: 0,0:07:33.45,0:07:37.45,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:07:37.45,0:07:41.45,Default,,0000,0000,0000,,Сәлемдесу аяқталды ма?
Dialogue: 0,0:07:37.45,0:07:41.45,Default,,0000,0000,0000,,Менің ағама
Dialogue: 0,0:07:41.45,0:07:46.46,Default,,0000,0000,0000,,Мен кетейін деп жатырмын
Dialogue: 0,0:07:41.45,0:07:46.46,Default,,0000,0000,0000,,Одан гөрі оны аяқтаған сен бе?
Dialogue: 0,0:07:46.46,0:07:49.46,Default,,0000,0000,0000,,Бірден
Dialogue: 0,0:07:46.46,0:07:49.46,Default,,0000,0000,0000,,Рәсім кезінде жыламаңыз.
Dialogue: 0,0:07:49.46,0:07:51.46,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:51.46,0:07:53.46,Default,,0000,0000,0000,,Мен сені сүйсем де
Dialogue: 0,0:07:57.47,0:07:59.47,Default,,0000,0000,0000,,Wasa!
Dialogue: 0,0:07:59.47,0:08:03.48,Default,,0000,0000,0000,,Бұл менмін
Dialogue: 0,0:07:59.47,0:08:03.48,Default,,0000,0000,0000,,Мен сәлем беруге келе жатырмын.
Dialogue: 0,0:08:03.48,0:08:07.48,Default,,0000,0000,0000,,Үш адам, бір адам
Dialogue: 0,0:08:03.48,0:08:07.48,Default,,0000,0000,0000,,Сонда сіз ұрыстыңыз ба? ➡
Dialogue: 0,0:08:07.48,0:08:10.48,Default,,0000,0000,0000,,Апалы-сіңлілер қалай себептік байланыста?
Dialogue: 0,0:08:10.48,0:08:13.42,Rubi,,0000,0000,0000,,Босдық
Dialogue: 0,0:08:10.48,0:08:13.42,Default,,0000,0000,0000,,Аксиома мырзаның хаты?
Dialogue: 0,0:08:13.42,0:08:16.42,Default,,0000,0000,0000,,Мен оны алған жоқпын.
Dialogue: 0,0:08:16.42,0:08:20.43,Default,,0000,0000,0000,,Мен көремін. Маған бере алмадың ба?
Dialogue: 0,0:08:20.43,0:08:22.43,Default,,0000,0000,0000,,Бірдеңе дұрыс болмады.
Dialogue: 0,0:08:22.43,0:08:25.43,Default,,0000,0000,0000,,Сұлу әпкелерімнің арасында танымал болу мен үшін мақтаныш.
Dialogue: 0,0:08:25.43,0:08:28.43,Default,,0000,0000,0000,,Қараңызшы, ойы қарттың ойы.
Dialogue: 0,0:08:28.43,0:08:30.44,Default,,0000,0000,0000,,Жан түршігерлік нәрселерді айтпа
Dialogue: 0,0:08:30.44,0:08:32.44,Default,,0000,0000,0000,,(Кёки)
Dialogue: 0,0:08:30.44,0:08:32.44,Default,,0000,0000,0000,,Өйткені, ұстаз, сіз мені тіпті мазаламайсыз.
Dialogue: 0,0:08:32.44,0:08:34.44,Default,,0000,0000,0000,,Бұл сенсің
Dialogue: 0,0:08:34.44,0:08:38.44,Default,,0000,0000,0000,,Бұл оның қаны әлсіз екенін білдіре ме?
Dialogue: 0,0:08:38.44,0:08:42.45,Default,,0000,0000,0000,,Өкініштісі, оның соншалықты ақымақ адам.➡
Dialogue: 0,0:08:42.45,0:08:45.45,Default,,0000,0000,0000,,Сіз осылай көрінесіз бе?
Dialogue: 0,0:08:45.45,0:08:47.45,Default,,0000,0000,0000,,Біртүрлі?
Dialogue: 0,0:08:47.45,0:08:51.46,Default,,0000,0000,0000,,Жоқ, бұл сізге керемет көрінеді.
Dialogue: 0,0:08:51.46,0:08:54.46,Default,,0000,0000,0000,,Сіз кереметсіз, бірақ сіз➡
Dialogue: 0,0:08:54.46,0:08:57.46,Default,,0000,0000,0000,,Өте сүйкімді көрінеді
Dialogue: 0,0:08:54.46,0:08:57.46,Default,,0000,0000,0000,,Бұл сізге сәйкес келсе де
Dialogue: 0,0:08:57.46,0:08:59.46,Default,,0000,0000,0000,,(Кёки)
Dialogue: 0,0:08:57.46,0:08:59.46,Default,,0000,0000,0000,,Өйткені, бұл бір қарияның ойы еді.
Dialogue: 0,0:08:59.46,0:09:02.46,Default,,0000,0000,0000,,(Істер)
Dialogue: 0,0:08:59.46,0:09:02.46,Default,,0000,0000,0000,,Кешіріңіз. Бұл рас болуы мүмкін.
Dialogue: 0,0:09:04.47,0:09:06.47,Default,,0000,0000,0000,,《Әлі айтасың ба?》
Dialogue: 0,0:09:15.41,0:09:17.42,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:09:15.41,0:09:17.42,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:09:17.42,0:09:19.42,Default,,0000,0000,0000,,Фуми-чаннан
Dialogue: 0,0:09:17.42,0:09:19.42,Default,,0000,0000,0000,,Телефон қоңырауы болған сияқты.
Dialogue: 0,0:09:19.42,0:09:22.42,Default,,0000,0000,0000,,Сен маған бүгін туралы айтпадың ба?
Dialogue: 0,0:09:22.42,0:09:27.43,Default,,0000,0000,0000,,Иә. Айтуға сәл қиын.
Dialogue: 0,0:09:22.42,0:09:27.43,Default,,0000,0000,0000,,♬(Ағзаның өнімділігі)
Dialogue: 0,0:09:27.43,0:09:32.43,Default,,0000,0000,0000,,Мен хат жібергім келеді…
Dialogue: 0,0:09:32.43,0:09:52.45,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:09:52.45,0:10:12.40,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:10:12.40,0:10:14.41,Default,,0000,0000,0000,,Жылама
Dialogue: 0,0:10:14.41,0:10:17.41,Default,,0000,0000,0000,,Иә? мен?
Dialogue: 0,0:10:14.41,0:10:17.41,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:10:17.41,0:10:22.41,Default,,0000,0000,0000,,Ескі махаббат хаты сияқты.
Dialogue: 0,0:10:17.41,0:10:22.41,Default,,0000,0000,0000,,Менің әлсіздігімді пайдаланып жатқандай сезінбе.
Dialogue: 0,0:10:22.41,0:10:26.42,Default,,0000,0000,0000,,Бұл жай ғана жастық ұшқырлық емес пе?
Dialogue: 0,0:10:26.42,0:10:28.42,Default,,0000,0000,0000,,Менде бәрі жақсы
Dialogue: 0,0:10:26.42,0:10:28.42,Default,,0000,0000,0000,,Адамның өзіне айту
Dialogue: 0,0:10:28.42,0:10:32.42,Default,,0000,0000,0000,,Хат бере алмаған адамнан
Dialogue: 0,0:10:28.42,0:10:32.42,Default,,0000,0000,0000,,Мен жақсырақ
Dialogue: 0,0:10:32.42,0:10:35.43,Default,,0000,0000,0000,,Қайсысы жақсы?
Dialogue: 0,0:10:32.42,0:10:35.43,Default,,0000,0000,0000,,Бұл проблема емес.
Dialogue: 0,0:10:35.43,0:10:38.43,Default,,0000,0000,0000,,Екеуі де керемет естеліктер.
Dialogue: 0,0:10:35.43,0:10:38.43,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:10:38.43,0:10:42.43,Default,,0000,0000,0000,,Бұл лақтырылатын нәрсе.
Dialogue: 0,0:10:38.43,0:10:42.43,Default,,0000,0000,0000,,Өйткені бұл басқа біреудің ісі.
Dialogue: 0,0:10:42.43,0:10:45.44,Default,,0000,0000,0000,,Менің ойымша, Сугако-чанның мінезі нашар.
Dialogue: 0,0:10:45.44,0:10:47.44,Default,,0000,0000,0000,,(Сугако)
Dialogue: 0,0:10:45.44,0:10:47.44,Default,,0000,0000,0000,,Бұл шок терапиясы сияқты.
Dialogue: 0,0:10:47.44,0:10:49.44,Default,,0000,0000,0000,,≪(есіктің ашылу дыбысы)
Dialogue: 0,0:10:49.44,0:10:54.44,Default,,0000,0000,0000,,Қараңдаршы, екеуінен де айласын асырған аңшы әйел.
Dialogue: 0,0:10:49.44,0:10:54.44,Default,,0000,0000,0000,,Пайда!
Dialogue: 0,0:11:01.45,0:11:05.46,Default,,0000,0000,0000,,Васа-чан, сен әдемісің.
Dialogue: 0,0:11:05.46,0:11:25.41,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:11:25.41,0:11:35.42,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:11:35.42,0:11:37.42,Default,,0000,0000,0000,,Тодороки мен Бакуго!
Dialogue: 0,0:11:48.45,0:11:51.46,Rubi,,0000,0000,0000,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:11:48.45,0:11:51.46,Rubi,,0000,0000,0000,,Шима
Dialogue: 0,0:11:48.45,0:11:51.46,Default,,0000,0000,0000,,Эносима!?
Dialogue: 0,0:11:51.46,0:11:54.46,Default,,0000,0000,0000,,Жарайды, мен қазір барамын.➡
Dialogue: 0,0:11:54.46,0:11:57.46,Default,,0000,0000,0000,,Мен ағаммен келе жатырмын.
Dialogue: 0,0:11:54.46,0:11:57.46,Default,,0000,0000,0000,,Мен сені көлікпен апарып тастаймын.
Dialogue: 0,0:11:57.46,0:12:00.47,Default,,0000,0000,0000,,Не? Сол сияқты...
Dialogue: 0,0:11:57.46,0:12:00.47,Default,,0000,0000,0000,,Тыныш тыныш
Dialogue: 0,0:12:00.47,0:12:05.47,Default,,0000,0000,0000,,Олай болса, кездесу орны қайда? Иә.
Dialogue: 0,0:12:00.47,0:12:05.47,Default,,0000,0000,0000,,Иә?Ах...
Dialogue: 0,0:12:05.47,0:12:07.47,Default,,0000,0000,0000,,Иә, дұрыс.
Dialogue: 0,0:12:07.47,0:12:10.48,Rubi,,0000,0000,0000,,Бентенбаши
Dialogue: 0,0:12:07.47,0:12:10.48,Default,,0000,0000,0000,,Содан кейін, Бентенбашы кіре берісінде.
Dialogue: 0,0:12:07.47,0:12:10.48,Default,,0000,0000,0000,,Мен күтемін.
Dialogue: 0,0:12:10.48,0:12:14.48,Default,,0000,0000,0000,,[℡]О, мм... сәл күте тұрыңыз.
Dialogue: 0,0:12:10.48,0:12:14.48,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:26.49,0:12:46.44,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:12:46.44,0:12:54.45,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:12:54.45,0:12:57.45,Default,,0000,0000,0000,,≪(Кёки) Фуми
Dialogue: 0,0:12:54.45,0:12:57.45,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:12:59.46,0:13:02.46,Default,,0000,0000,0000,,Кешіріңіз. Мен сенің соңынан ердім.
Dialogue: 0,0:13:02.46,0:13:04.46,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:13:06.46,0:13:09.46,Default,,0000,0000,0000,,Көптен бері көрмеген
Dialogue: 0,0:13:06.46,0:13:09.46,Default,,0000,0000,0000,,А... иә
Dialogue: 0,0:13:11.47,0:13:14.47,Default,,0000,0000,0000,,Ум...
Dialogue: 0,0:13:11.47,0:13:14.47,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:14.47,0:13:18.48,Default,,0000,0000,0000,,Бүгін болды, солай ма?
Dialogue: 0,0:13:14.47,0:13:18.48,Default,,0000,0000,0000,,Әпкесінің үйлену тойы
Dialogue: 0,0:13:18.48,0:13:21.48,Default,,0000,0000,0000,,Неге… неге мен
Dialogue: 0,0:13:21.48,0:13:23.48,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:13:27.49,0:13:29.49,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:13:40.52,0:13:44.44,Default,,0000,0000,0000,,Онда не жеуіміз керек?
Dialogue: 0,0:13:40.52,0:13:44.44,Default,,0000,0000,0000,,А-чан
Dialogue: 0,0:13:44.44,0:13:46.44,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:13:48.44,0:13:52.44,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:13:48.44,0:13:52.44,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:13:52.44,0:13:56.45,Default,,0000,0000,0000,,Тіпті сенің ағаң да
Dialogue: 0,0:13:52.44,0:13:56.45,Default,,0000,0000,0000,,Мен саған жабысып қалдым
Dialogue: 0,0:13:56.45,0:14:00.45,Default,,0000,0000,0000,,Біреу тек жүргізуші болсын
Dialogue: 0,0:13:56.45,0:14:00.45,Default,,0000,0000,0000,,Сен маған үйге барайын деп тұрсың ба?
Dialogue: 0,0:14:02.45,0:14:07.46,Default,,0000,0000,0000,,Мен Фуми-чанмен бірге серуендеймін
Dialogue: 0,0:14:02.45,0:14:07.46,Default,,0000,0000,0000,,Мұны еркін сезініңіз.
Dialogue: 0,0:14:07.46,0:14:10.46,Default,,0000,0000,0000,,А-чан, сен энергияға толысың.
Dialogue: 0,0:14:10.46,0:14:15.47,Default,,0000,0000,0000,,Күш-қуатқа толы және сыпайы.
Dialogue: 0,0:14:10.46,0:14:15.47,Default,,0000,0000,0000,,Бірақ ол жақсы қыз.
Dialogue: 0,0:14:15.47,0:14:20.47,Default,,0000,0000,0000,,Ал, жай ғана тұлға.
Dialogue: 0,0:14:15.47,0:14:20.47,Default,,0000,0000,0000,,Мен көмектесе алмаймын.
Dialogue: 0,0:14:20.47,0:14:23.47,Default,,0000,0000,0000,,Мен кішкентай кезімде
Dialogue: 0,0:14:20.47,0:14:23.47,Default,,0000,0000,0000,,Ол қандай бала болды?
Dialogue: 0,0:14:23.47,0:14:29.48,Default,,0000,0000,0000,,Дұрыс. Өткенде балапан сияқты
Dialogue: 0,0:14:23.47,0:14:29.48,Default,,0000,0000,0000,,Әрқашан менің артымнан жүр.➡
Dialogue: 0,0:14:29.48,0:14:32.48,Default,,0000,0000,0000,,Мен бастауыш мектепке бардым
Dialogue: 0,0:14:29.48,0:14:32.48,Default,,0000,0000,0000,,Мен жаңа келген кезде➡
Dialogue: 0,0:14:32.48,0:14:35.49,Default,,0000,0000,0000,,Күнде таңертең жыла
Dialogue: 0,0:14:32.48,0:14:35.49,Default,,0000,0000,0000,,«Үлкен аға, мен барғым келмейді».
Dialogue: 0,0:14:35.49,0:14:37.49,Default,,0000,0000,0000,,Ол – Лорд Широ.
Dialogue: 0,0:14:42.43,0:14:46.43,Default,,0000,0000,0000,,Олай болса, апаң да бізге қосылсын.
Dialogue: 0,0:14:42.43,0:14:46.43,Default,,0000,0000,0000,,Содан кейін тоқтаңыз
Dialogue: 0,0:14:46.43,0:14:48.43,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:14:48.43,0:14:51.44,Default,,0000,0000,0000,,Әрине, мүмкін емес—қандай жағдай болса да, осындай зұлым тұзақ...
Dialogue: 0,0:14:48.43,0:14:51.44,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:14:51.44,0:14:54.44,Default,,0000,0000,0000,,I
Dialogue: 0,0:14:51.44,0:14:54.44,Default,,0000,0000,0000,,Мен ағаммен бірге жүргім келмейді.
Dialogue: 0,0:14:54.44,0:14:57.44,Default,,0000,0000,0000,,А-чан
Dialogue: 0,0:14:54.44,0:14:57.44,Default,,0000,0000,0000,,Мені ұятқа қалдырмаңыз
Dialogue: 0,0:14:57.44,0:15:00.45,Default,,0000,0000,0000,,Иә... Кешіріңіз.
Dialogue: 0,0:15:00.45,0:15:12.46,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:15:12.46,0:15:17.46,Default,,0000,0000,0000,,Фуми-чан
Dialogue: 0,0:15:12.46,0:15:17.46,Default,,0000,0000,0000,,Сен қатты ашуландың.
Dialogue: 0,0:15:17.46,0:15:21.47,Default,,0000,0000,0000,,Жарайды, ашуланатын шығарсың.
Dialogue: 0,0:15:21.47,0:15:24.47,Default,,0000,0000,0000,,Сізді ашуландыратын нәрсені жасаңыз
Dialogue: 0,0:15:21.47,0:15:24.47,Default,,0000,0000,0000,,Мен мұны істедім.
Dialogue: 0,0:15:24.47,0:15:27.47,Default,,0000,0000,0000,,А, солай ма?
Dialogue: 0,0:15:30.48,0:15:34.48,Default,,0000,0000,0000,,Мен және Фуми бұрыннан
Dialogue: 0,0:15:30.48,0:15:34.48,Default,,0000,0000,0000,,Біз кездесіп жүрдік.
Dialogue: 0,0:15:34.48,0:15:37.48,Default,,0000,0000,0000,,А... А?
Dialogue: 0,0:15:37.48,0:15:42.42,Default,,0000,0000,0000,,Мен қорқыныштымын.
Dialogue: 0,0:15:37.48,0:15:42.42,Default,,0000,0000,0000,,Менің айтайын дегенім, мен қалай тербелдім...
Dialogue: 0,0:15:42.42,0:15:45.42,Default,,0000,0000,0000,,Сіз бәрібір таң қаласыз.
Dialogue: 0,0:15:45.42,0:15:47.43,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:15:47.43,0:15:51.43,Default,,0000,0000,0000,,Менің ойымша, бұл қалыпты жағдай.
Dialogue: 0,0:15:51.43,0:15:56.43,Default,,0000,0000,0000,,Мен де, егер бұл біреудің әңгімесі болса.
Dialogue: 0,0:15:51.43,0:15:56.43,Default,,0000,0000,0000,,Менің ойымша, сіз таң қалдыңыз.
Dialogue: 0,0:16:03.44,0:16:05.44,Default,,0000,0000,0000,,(Васа)
Dialogue: 0,0:16:03.44,0:16:05.44,Default,,0000,0000,0000,,《Якчан шынымен де➡
Dialogue: 0,0:16:05.44,0:16:09.45,Default,,0000,0000,0000,,Мұндай көрініс
Dialogue: 0,0:16:05.44,0:16:09.45,Default,,0000,0000,0000,,Бұл сізге жақсы көрінеді》
Dialogue: 0,0:16:09.45,0:16:14.45,Default,,0000,0000,0000,,<Біз алғаш кездескен кезде
Dialogue: 0,0:16:09.45,0:16:14.45,Default,,0000,0000,0000,,Ол кісі әпкемнің сүйіктісі болған>
Dialogue: 0,0:16:18.46,0:16:22.46,Default,,0000,0000,0000,,<Сен не ойладың?
Dialogue: 0,0:16:18.46,0:16:22.46,Default,,0000,0000,0000,,Мен шашымды тез қиып алдым＞
Dialogue: 0,0:16:25.46,0:16:30.47,Default,,0000,0000,0000,,<Менің әпкем сыртқы түріне қарама-қайшы.
Dialogue: 0,0:16:25.46,0:16:30.47,Default,,0000,0000,0000,,Мінезі дөрекі болғандықтан➡
Dialogue: 0,0:16:30.47,0:16:34.47,Default,,0000,0000,0000,,Кем дегенде I
Dialogue: 0,0:16:30.47,0:16:34.47,Default,,0000,0000,0000,,Мен саған сырт келбетімен ғана жақын болғым келді>
Dialogue: 0,0:16:38.48,0:16:42.41,Default,,0000,0000,0000,,<Менің әдемі бейнесім
Dialogue: 0,0:16:38.48,0:16:42.41,Default,,0000,0000,0000,,Тез енеді➡
Dialogue: 0,0:16:42.41,0:16:44.41,Default,,0000,0000,0000,,Ол танымал болды.＞
Dialogue: 0,0:16:48.42,0:16:51.42,Default,,0000,0000,0000,,《Қыздар оңай》
Dialogue: 0,0:16:51.42,0:16:53.42,Default,,0000,0000,0000,,<Мен қазірдің өзінде бармын➡
Dialogue: 0,0:16:53.42,0:16:57.43,Default,,0000,0000,0000,,Не болатынын білетіндер үшін
Dialogue: 0,0:16:53.42,0:16:57.43,Default,,0000,0000,0000,,Мен кез келген нәрсені істей алатындай сезіндім➡
Dialogue: 0,0:16:57.43,0:17:00.43,Default,,0000,0000,0000,,Менің оған мұрным көп емес.
Dialogue: 0,0:16:57.43,0:17:00.43,Default,,0000,0000,0000,,Менің ойымша, бұл жігіт болды.➡
Dialogue: 0,0:17:00.43,0:17:05.43,Default,,0000,0000,0000,,Әрине, оны жасырудың жолы жоқ.
Dialogue: 0,0:17:00.43,0:17:05.43,Default,,0000,0000,0000,,Мен оны киіп жүрдім...>
Dialogue: 0,0:17:08.44,0:17:10.44,Default,,0000,0000,0000,,(Киоко)
Dialogue: 0,0:17:08.44,0:17:10.44,Default,,0000,0000,0000,,《Сіз драма үйірмесіне қосылдыңыз ба? 》
Dialogue: 0,0:17:10.44,0:17:14.45,Default,,0000,0000,0000,,《Иә
Dialogue: 0,0:17:10.44,0:17:14.45,Default,,0000,0000,0000,,Маған ойнауға кеңес берген біреу болды.
Dialogue: 0,0:17:14.45,0:17:17.45,Default,,0000,0000,0000,,《Сосын мен де
Dialogue: 0,0:17:14.45,0:17:17.45,Default,,0000,0000,0000,,Драма үйірмесіне қосылыңыз》
Dialogue: 0,0:17:17.45,0:17:19.45,Default,,0000,0000,0000,,《Суретпен не істеуім керек? 》
Dialogue: 0,0:17:19.45,0:17:23.45,Default,,0000,0000,0000,,(Киоко)
Dialogue: 0,0:17:19.45,0:17:23.45,Default,,0000,0000,0000,,《Тіпті бір адам сурет сала алады》
Dialogue: 0,0:17:23.45,0:17:26.46,Default,,0000,0000,0000,,(Кёки)
Dialogue: 0,0:17:23.45,0:17:26.46,Default,,0000,0000,0000,,<Киоко да мен сияқты.➡
Dialogue: 0,0:17:26.46,0:17:32.46,Default,,0000,0000,0000,,Шашымды қиғанда, өзімді де қидым.
Dialogue: 0,0:17:26.46,0:17:32.46,Default,,0000,0000,0000,,Барлығын бақылайды.➡
Dialogue: 0,0:17:32.46,0:17:36.47,Default,,0000,0000,0000,,Сүйкімді, бірақ... тітіркендіргіш.➡
Dialogue: 0,0:17:36.47,0:17:39.47,Default,,0000,0000,0000,,Міне солай
Dialogue: 0,0:17:36.47,0:17:39.47,Default,,0000,0000,0000,,Маған да қатысты ма?➡
Dialogue: 0,0:17:39.47,0:17:42.47,Default,,0000,0000,0000,,Мен ойламаған сияқтымын>
Dialogue: 0,0:17:44.41,0:17:47.41,Default,,0000,0000,0000,,《Ағымдағысы
Dialogue: 0,0:17:44.41,0:17:47.41,Default,,0000,0000,0000,,Сұрамағандай болып көрейік.
Dialogue: 0,0:17:50.41,0:17:55.42,Default,,0000,0000,0000,,<Жаралы жүрекке үндеу
Dialogue: 0,0:17:50.41,0:17:55.42,Default,,0000,0000,0000,,Мен тіпті мектепті тастадым.➡
Dialogue: 0,0:17:55.42,0:17:57.42,Default,,0000,0000,0000,,Қандай жағдай болмасын, менің ойым➡
Dialogue: 0,0:17:57.42,0:18:00.42,Default,,0000,0000,0000,,Отбасына
Dialogue: 0,0:17:57.42,0:18:00.42,Default,,0000,0000,0000,,Ол белгілі болады➡
Dialogue: 0,0:18:00.42,0:18:06.43,Default,,0000,0000,0000,,Бұл тек сізге және маған арналған.
Dialogue: 0,0:18:00.42,0:18:06.43,Default,,0000,0000,0000,,Құпия болғандықтан, мен қыңыр болдым.➡
Dialogue: 0,0:18:06.43,0:18:10.43,Default,,0000,0000,0000,,Шынымен бақылаудан тыс
Dialogue: 0,0:18:06.43,0:18:10.43,Default,,0000,0000,0000,,Бұл бала болды>
Dialogue: 0,0:18:20.44,0:18:23.45,Default,,0000,0000,0000,,≪Фуми-чан. Келесіде осында барғыңыз келе ме?
Dialogue: 0,0:18:23.45,0:18:25.45,Rubi,,0000,0000,0000,,Ивая
Dialogue: 0,0:18:23.45,0:18:25.45,Default,,0000,0000,0000,,Иваака
Dialogue: 0,0:18:25.45,0:18:27.45,Default,,0000,0000,0000,,Осы жерден
Dialogue: 0,0:18:25.45,0:18:27.45,Default,,0000,0000,0000,,Біраз жүруім керек сияқты...
Dialogue: 0,0:18:27.45,0:18:30.45,Default,,0000,0000,0000,,Қызықты көрінеді. Ол жерге бірінші рет баруым.
Dialogue: 0,0:18:30.45,0:18:33.46,Default,,0000,0000,0000,,Мен де!
Dialogue: 0,0:18:30.45,0:18:33.46,Default,,0000,0000,0000,,Ол қандай жер?
Dialogue: 0,0:18:33.46,0:18:36.46,Default,,0000,0000,0000,,Айвая туралы айтатын болсақ...
Dialogue: 0,0:18:36.46,0:18:39.46,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:18:36.46,0:18:39.46,Default,,0000,0000,0000,,Құдай тасқа тығылды ➡
Dialogue: 0,0:18:39.46,0:18:43.40,Default,,0000,0000,0000,,Дүние қара түнекке айналды
Dialogue: 0,0:18:39.46,0:18:43.40,Default,,0000,0000,0000,,Бұл қиын.
Dialogue: 0,0:18:43.40,0:18:46.40,Rubi,,0000,0000,0000,,Тәтті
Dialogue: 0,0:18:43.40,0:18:46.40,Rubi,,0000,0000,0000,,Ивато
Dialogue: 0,0:18:43.40,0:18:46.40,Default,,0000,0000,0000,,Ама но Ивато оқиғасы?
Dialogue: 0,0:18:46.40,0:18:49.41,Default,,0000,0000,0000,,Иватоның сыртынан
Dialogue: 0,0:18:46.40,0:18:49.41,Default,,0000,0000,0000,,Мен қуанышты дауысты естідім➡
Dialogue: 0,0:18:49.41,0:18:53.41,Rubi,,0000,0000,0000,,Аматерасу
Dialogue: 0,0:18:49.41,0:18:53.41,Default,,0000,0000,0000,,Аматерасу деген не деп ойлаймын.
Dialogue: 0,0:18:49.41,0:18:53.41,Default,,0000,0000,0000,,Сіз кететін бөлік➡
Dialogue: 0,0:18:53.41,0:18:56.41,Default,,0000,0000,0000,,Сіз балаға ұқсайсыз, солай емес пе?
Dialogue: 0,0:18:53.41,0:18:56.41,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:18:56.41,0:18:59.42,Default,,0000,0000,0000,,Жұмыс уақыты 17:00-ге дейін
Dialogue: 0,0:18:59.42,0:19:03.42,Default,,0000,0000,0000,,Қазір барсаң, уақытында келесің.
Dialogue: 0,0:18:59.42,0:19:03.42,Default,,0000,0000,0000,,Тиби, үлкен апаңа сеніп, соның соңынан ер!
Dialogue: 0,0:19:03.42,0:19:06.42,Default,,0000,0000,0000,,Онда мен бармаймын.
Dialogue: 0,0:19:03.42,0:19:06.42,Default,,0000,0000,0000,,Барғыңыз келеді, солай ма?
Dialogue: 0,0:19:11.43,0:19:13.43,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:19:25.44,0:19:31.45,Default,,0000,0000,0000,,Иә, бәрі. Бірінен соң бірі.
Dialogue: 0,0:19:25.44,0:19:31.45,Default,,0000,0000,0000,,Оны алып, жалғастырыңыз.➡
Dialogue: 0,0:19:31.45,0:19:35.45,Default,,0000,0000,0000,,Жолда төбе төмендеп барады.
Dialogue: 0,0:19:31.45,0:19:35.45,Default,,0000,0000,0000,,Ал енді, Арнайы сынып… жарайды—
Dialogue: 0,0:19:38.46,0:19:42.39,Default,,0000,0000,0000,,Бұл өте қараңғы.
Dialogue: 0,0:19:38.46,0:19:42.39,Default,,0000,0000,0000,,Бауырым, менің алдымда жүр.
Dialogue: 0,0:19:42.39,0:19:45.39,Default,,0000,0000,0000,,Сіз келгіңіз келетінін айттыңыз.
Dialogue: 0,0:19:42.39,0:19:45.39,Default,,0000,0000,0000,,Өйткені
Dialogue: 0,0:19:51.40,0:19:54.40,Default,,0000,0000,0000,,Бүгін не үшін келдің?
Dialogue: 0,0:19:59.41,0:20:02.41,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:19:59.41,0:20:02.41,Default,,0000,0000,0000,,Жүр, кеттік.
Dialogue: 0,0:20:04.42,0:20:07.42,Default,,0000,0000,0000,,Өйткені мен Фумимен кездескім келді
Dialogue: 0,0:20:07.42,0:20:10.42,Default,,0000,0000,0000,,Мен сенімен кездескім келмеді.
Dialogue: 0,0:20:10.42,0:20:12.42,Default,,0000,0000,0000,,Қарт адамдар тегін
Dialogue: 0,0:20:12.42,0:20:17.43,Default,,0000,0000,0000,,Сізге ұнайтын адам болса
Dialogue: 0,0:20:12.42,0:20:17.43,Default,,0000,0000,0000,,Тек адамға назар аударыңыз
Dialogue: 0,0:20:17.43,0:20:20.43,Default,,0000,0000,0000,,Сізге ұнайтын адамға
Dialogue: 0,0:20:17.43,0:20:20.43,Default,,0000,0000,0000,,Олар жауап бермесе ше?
Dialogue: 0,0:20:20.43,0:20:23.43,Default,,0000,0000,0000,,Пожалуйста, бас тартыңыз.
Dialogue: 0,0:20:26.44,0:20:31.44,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:20:26.44,0:20:31.44,Default,,0000,0000,0000,,Мен дұрыстап тастадым.
Dialogue: 0,0:20:36.45,0:20:39.45,Default,,0000,0000,0000,,Бас тарту
Dialogue: 0,0:20:39.45,0:20:42.45,Default,,0000,0000,0000,,Ересек болыңыз.
Dialogue: 0,0:20:44.39,0:20:46.39,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:20:51.40,0:20:53.40,Default,,0000,0000,0000,,Фуми…｡➡
Dialogue: 0,0:20:53.40,0:20:55.40,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:21:01.41,0:21:03.41,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:21:07.41,0:21:10.41,Default,,0000,0000,0000,,Эренді тоқтату үшін. Көпшілік кісі өлтіру – қате.
Dialogue: 0,0:21:10.41,0:21:15.42,Default,,0000,0000,0000,,♬『ｾﾝﾃｨﾌｫﾘｱ』
Dialogue: 0,0:21:15.42,0:21:35.44,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:21:35.44,0:21:53.46,Default,,0000,0000,0000,,♬～
