Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.37,0:00:04.37,Default,,0,0,0,,Уау не! Бұл
Dialogue: 0,0:00:04.37,0:00:07.37,Default,,0,0,0,,Каори
Dialogue: 0,0:00:04.37,0:00:07.37,Default,,0,0,0,,Театр клубының плакаттары
Dialogue: 0,0:00:04.37,0:00:07.37,Default,,0,0,0,,Сол сәтте, контекстке қарамастан, мен бұл тіркесті «дәптерді лақтыру» деген мағынада қолданамын.
Dialogue: 0,0:00:07.37,0:00:10.38,Default,,0,0,0,,(мүше)
Dialogue: 0,0:00:07.37,0:00:10.38,Default,,0,0,0,,Иә, бұл тым көп күш...
Dialogue: 0,0:00:10.38,0:00:12.38,Default,,0,0,0,,(мүше)
Dialogue: 0,0:00:10.38,0:00:12.38,Default,,0,0,0,,Жақсы! Бұл тамаша
Dialogue: 0,0:00:12.38,0:00:15.38,Default,,0,0,0,,Біртүрлі, ол...
Dialogue: 0,0:00:12.38,0:00:15.38,Default,,0,0,0,,Кэтрин Сенпай
Dialogue: 0,0:00:15.38,0:00:20.39,Default,,0,0,0,,Кавасаки
Dialogue: 0,0:00:15.38,0:00:20.39,Default,,0,0,0,,Сугимото
Dialogue: 0,0:00:15.38,0:00:20.39,Default,,0,0,0,,Сугимото шетке, тіпті мен де.
Dialogue: 0,0:00:15.38,0:00:20.39,Default,,0,0,0,,Сондай әдемі әйел ретінде қарау...
Dialogue: 0,0:00:20.39,0:00:23.39,Default,,0,0,0,,Атақты актрисадан толығырақ
Dialogue: 0,0:00:20.39,0:00:23.39,Default,,0,0,0,,Бұл түсініктеме болды
Dialogue: 0,0:00:23.39,0:00:28.39,Default,,0,0,0,,Кавасаки-сенпай әдемі.
Dialogue: 0,0:00:23.39,0:00:28.39,Default,,0,0,0,,Оны қазірдің өзінде тоқтатыңыз.
Dialogue: 0,0:00:32.40,0:00:36.40,Default,,0,0,0,,Мен оны кейінірек аламын ба?
Dialogue: 0,0:00:32.40,0:00:36.40,Default,,0,0,0,,Мен оны өз бөлмемде көрсеткім келеді
Dialogue: 0,0:00:41.41,0:00:44.41,Default,,0,0,0,,Орналасқан жері сәл төмен емес пе?
Dialogue: 0,0:00:44.41,0:00:46.41,Default,,0,0,0,,Киоко
Dialogue: 0,0:00:44.41,0:00:46.41,Default,,0,0,0,,Осы мақсатқа жету үшін бәрін қолданамыз — Титан күшін де, сенің қаруларыңды да. ➡
Dialogue: 0,0:00:44.41,0:00:46.41,Default,,0,0,0,,Таспа
Dialogue: 0,0:00:48.41,0:00:51.42,Default,,0,0,0,,Боу?
Dialogue: 0,0:00:51.42,0:00:56.42,Default,,0,0,0,,Аа, репетиция басталғалы жатыр.
Dialogue: 0,0:00:51.42,0:00:56.42,Default,,0,0,0,,Оны тез орындаңыз
Dialogue: 0,0:01:06.37,0:01:11.37,Default,,0,0,0,,Көк
Dialogue: 0,0:01:06.37,0:01:11.37,Default,,0,0,0,,3D маневрлік жабдықтың табиғи жауы.
Dialogue: 0,0:01:06.37,0:01:11.37,Default,,0,0,0,,♬『Көк гүл』
Dialogue: 0,0:01:11.37,0:01:21.38,Default,,0,0,0,,♬～
Dialogue: 0,0:01:21.38,0:01:30.39,Default,,0,0,0,,♬～
Dialogue: 0,0:01:30.39,0:01:50.41,Default,,0,0,0,,♬～
Dialogue: 0,0:01:50.41,0:02:10.36,Default,,0,0,0,,♬～
Dialogue: 0,0:02:10.36,0:02:24.36,Default,,0,0,0,,♬～
Dialogue: 0,0:02:28.38,0:02:31.38,Default,,0,0,0,,Ясуко
Dialogue: 0,0:02:28.38,0:02:31.38,Default,,0,0,0,,Көрдіңіз бе? жаман желім плакат
Dialogue: 0,0:02:31.38,0:02:35.39,Default,,0,0,0,,Иә, керемет болды.
Dialogue: 0,0:02:31.38,0:02:35.39,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:02:35.39,0:02:37.39,Default,,0,0,0,,Сугимото-сенпай! ➡
Dialogue: 0,0:02:37.39,0:02:39.39,Default,,0,0,0,,Осы постер туралы не ойладың?
Dialogue: 0,0:02:39.39,0:02:44.40,Default,,0,0,0,,А, мені осылай суреттегеніңе рахмет.
Dialogue: 0,0:02:39.39,0:02:44.40,Default,,0,0,0,,Мен қорқамын.
Dialogue: 0,0:02:44.40,0:02:47.40,Default,,0,0,0,,Жоқ. Менің нағыз ағам көбірек...
Dialogue: 0,0:02:47.40,0:02:49.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:49.40,0:02:55.41,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:02:49.40,0:02:55.41,Default,,0,0,0,,кезең Сәттілік
Dialogue: 0,0:02:55.41,0:02:57.41,Default,,0,0,0,,Рахмет
Dialogue: 0,0:02:59.41,0:03:03.41,Default,,0,0,0,,Мен сөйлестім
Dialogue: 0,0:02:59.41,0:03:03.41,Default,,0,0,0,,(көңілді дауыс)
Dialogue: 0,0:03:08.42,0:03:10.42,Default,,0,0,0,,(Өнер үйірмесінің мүшесі)
Dialogue: 0,0:03:08.42,0:03:10.42,Default,,0,0,0,,Сонымен не дедіңіз?
Dialogue: 0,0:03:10.42,0:03:13.42,Default,,0,0,0,,Құпия құпия
Dialogue: 0,0:03:10.42,0:03:13.42,Default,,0,0,0,,Бұл қулық емес пе?
Dialogue: 0,0:03:15.43,0:03:19.43,Default,,0,0,0,,Менің ағам...
Dialogue: 0,0:03:15.43,0:03:19.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:19.43,0:03:23.44,Default,,0,0,0,,Үлкендер
Dialogue: 0,0:03:19.43,0:03:23.44,Default,,0,0,0,,Сіз бәріне ұнайсыз, солай ма?
Dialogue: 0,0:03:23.44,0:03:26.46,Default,,0,0,0,,Жабу
Dialogue: 0,0:03:23.44,0:03:26.46,Default,,0,0,0,,Қандай қызғаныш?
Dialogue: 0,0:03:26.46,0:03:30.46,Default,,0,0,0,,Зұлымдар Альянсының көлеңкесі – біздің ең үлкен алаңдаушылығымыз
Dialogue: 0,0:03:26.46,0:03:30.46,Default,,0,0,0,,Фуми?
Dialogue: 0,0:03:40.39,0:03:42.39,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:03:42.39,0:03:44.39,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:03:44.39,0:03:46.39,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:03:46.39,0:03:48.39,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:03:48.39,0:03:50.40,Default,,0,0,0,,А, жоқ...
Dialogue: 0,0:03:50.40,0:03:53.40,Default,,0,0,0,,Маған жақындау керек.
Dialogue: 0,0:03:50.40,0:03:53.40,Default,,0,0,0,,Бұл мүмкін емес
Dialogue: 0,0:03:56.40,0:03:58.40,Default,,0,0,0,,Сіз ағаңызға күмәнданасыз ба?
Dialogue: 0,0:03:58.40,0:04:00.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:03.41,0:04:08.41,Default,,0,0,0,,Маған ұнайтын адам
Dialogue: 0,0:04:03.41,0:04:08.41,Default,,0,0,0,,Тағы біреуі бар ма деп ойлаймын.
Dialogue: 0,0:04:08.41,0:04:11.42,Default,,0,0,0,,Егер сіз бірдеңе ойлап тапсаңыз
Dialogue: 0,0:04:08.41,0:04:11.42,Default,,0,0,0,,Мен тоқтай алмаймын...
Dialogue: 0,0:04:11.42,0:04:15.42,Default,,0,0,0,,Әңгіме ағынын бірден тоқтатады.
Dialogue: 0,0:04:15.42,0:04:21.43,Default,,0,0,0,,Міне, мен сондаймын.
Dialogue: 0,0:04:15.42,0:04:21.43,Default,,0,0,0,,Мен шынымен түсінбеймін...
Dialogue: 0,0:04:21.43,0:04:24.43,Default,,0,0,0,,Ғашық болған кезде
Dialogue: 0,0:04:21.43,0:04:24.43,Default,,0,0,0,,Бұл оларды алаңдатады дейді...
Dialogue: 0,0:04:24.43,0:04:27.37,Default,,0,0,0,,Бұл солай емес пе?
Dialogue: 0,0:04:27.37,0:04:31.37,Default,,0,0,0,,А... Мен солай ойлаймын...
Dialogue: 0,0:04:31.37,0:04:33.37,Default,,0,0,0,,Окудаира
Dialogue: 0,0:04:31.37,0:04:33.37,Default,,0,0,0,,≪(Киоко) Окухира-сан!
Dialogue: 0,0:04:31.37,0:04:33.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:33.37,0:04:35.37,Default,,0,0,0,,Икуми
Dialogue: 0,0:04:33.37,0:04:35.37,Default,,0,0,0,,О, Игуми мырза
Dialogue: 0,0:04:35.37,0:04:38.38,Default,,0,0,0,,Сізге қандай шырын ұнайды?
Dialogue: 0,0:04:35.37,0:04:38.38,Default,,0,0,0,,Шырын?
Dialogue: 0,0:04:38.38,0:04:41.38,Default,,0,0,0,,Сіз бәрінен сұрайсыз ба?
Dialogue: 0,0:04:38.38,0:04:41.38,Default,,0,0,0,,Менеджер бірдеңе сатып алуымды өтінді.
Dialogue: 0,0:04:41.38,0:04:43.38,Default,,0,0,0,,Мен де барамын
Dialogue: 0,0:04:43.38,0:04:46.39,Default,,0,0,0,,Міне, сіз. Окухира-сан!
Dialogue: 0,0:04:46.39,0:04:49.39,Default,,0,0,0,,Хитклиффтің таяғы.
Dialogue: 0,0:04:49.39,0:04:52.39,Default,,0,0,0,,Ол бұзылды ма?
Dialogue: 0,0:04:52.39,0:04:54.39,Default,,0,0,0,,Түсіндім! Мен бірден барамын
Dialogue: 0,0:04:56.40,0:04:59.40,Default,,0,0,0,,≪Кешіріңіз, Игуми мырза.
Dialogue: 0,0:04:56.40,0:04:59.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:59.40,0:05:02.40,Default,,0,0,0,,Бұл жақсы. Сонымен, сіз не істемексіз?
Dialogue: 0,0:05:02.40,0:05:05.40,Default,,0,0,0,,Содан кейін қызғылт сары.
Dialogue: 0,0:05:02.40,0:05:05.40,Default,,0,0,0,,Фуми-чан, кездескенше.
Dialogue: 0,0:05:05.40,0:05:07.40,Default,,0,0,0,,Иә. Іске сәт.
Dialogue: 0,0:05:15.41,0:05:17.42,Default,,0,0,0,,Манджуме
Dialogue: 0,0:05:15.41,0:05:17.42,Default,,0,0,0,,≪(Киоко) Манжоме...?
Dialogue: 0,0:05:17.42,0:05:21.42,Default,,0,0,0,,А... иә
Dialogue: 0,0:05:17.42,0:05:21.42,Default,,0,0,0,,Сіз де бірдеңе ішкіңіз келе ме?
Dialogue: 0,0:05:21.42,0:05:23.42,Default,,0,0,0,,Ал...
Dialogue: 0,0:05:28.36,0:05:31.36,Default,,0,0,0,,Жоқ—сол қолымды пайдаланбай-ақ ең үздікке айналу арқылы—
Dialogue: 0,0:05:28.36,0:05:31.36,Default,,0,0,0,,Көмек сұрау
Dialogue: 0,0:05:31.36,0:05:33.36,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:05:39.37,0:05:42.37,Default,,0,0,0,,(Киоко)
Dialogue: 0,0:05:39.37,0:05:42.37,Default,,0,0,0,,Сізге ұнайтын адам Сугимото-сенпай ма?
Dialogue: 0,0:05:42.37,0:05:44.37,Default,,0,0,0,,Иә!?
Dialogue: 0,0:05:49.38,0:05:52.38,Default,,0,0,0,,Сіз де солайсыз.➡
Dialogue: 0,0:05:52.38,0:05:56.39,Default,,0,0,0,,Сугимото-сенпай керемет, солай емес пе?➡
Dialogue: 0,0:05:56.39,0:05:59.39,Default,,0,0,0,,Маған ұнайтын қыз
Dialogue: 0,0:05:56.39,0:05:59.39,Default,,0,0,0,,Көп.
Dialogue: 0,0:05:59.39,0:06:02.39,Default,,0,0,0,,Иә... солай сияқты
Dialogue: 0,0:06:08.40,0:06:11.40,Default,,0,0,0,,(Каори)
Dialogue: 0,0:06:08.40,0:06:11.40,Default,,0,0,0,,Иә Жарайды. Баршаңызға қажырлы еңбектеріңіз үшін рахмет.
Dialogue: 0,0:06:11.40,0:06:14.40,Default,,0,0,0,,Бұл аяқталды. Жақсы жұмыс.
Dialogue: 0,0:06:21.41,0:06:24.42,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:06:24.42,0:06:26.44,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,0:06:26.44,0:06:28.35,Default,,0,0,0,,Кеш жарық.
Dialogue: 0,0:06:28.35,0:06:31.36,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,0:06:28.35,0:06:31.36,Default,,0,0,0,,Керемет болды
Dialogue: 0,0:06:31.36,0:06:33.36,Default,,0,0,0,,(Кёки)
Dialogue: 0,0:06:31.36,0:06:33.36,Default,,0,0,0,,Рахмет. Үйге қайтқанда абай болыңыз.
Dialogue: 0,0:06:33.36,0:06:36.36,Default,,0,0,0,,(мүшелер)
Dialogue: 0,0:06:33.36,0:06:36.36,Default,,0,0,0,,Уау! Сіз естідіңіз бе? Жасырын
Dialogue: 0,0:06:36.36,0:06:40.36,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:06:36.36,0:06:40.36,Default,,0,0,0,,О, Киоко, сен сондай қамқорсың.
Dialogue: 0,0:06:42.37,0:06:44.37,Default,,0,0,0,,Ум...
Dialogue: 0,0:06:42.37,0:06:44.37,Default,,0,0,0,,Фуми!
Dialogue: 0,0:06:44.37,0:06:47.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:47.37,0:06:49.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:49.37,0:06:53.38,Default,,0,0,0,,3 курс студенттері
Dialogue: 0,0:06:49.37,0:06:53.38,Default,,0,0,0,,Кездесуге жиналыңыз.➡
Dialogue: 0,0:06:53.38,0:06:56.38,Default,,0,0,0,,1 және 2 сынып оқушыларына, тазалық жұмыстарынан кейін
Dialogue: 0,0:06:53.38,0:06:56.38,Default,,0,0,0,,Үйге бара аласыз.
Dialogue: 0,0:06:56.38,0:06:58.38,Default,,0,0,0,,Иә
Dialogue: 0,0:06:58.38,0:07:01.39,Default,,0,0,0,,Өйткені кеш болады
Dialogue: 0,0:06:58.38,0:07:01.39,Default,,0,0,0,,Сен бірінші үйге бара аласың, Фуми.
Dialogue: 0,0:07:01.39,0:07:04.39,Default,,0,0,0,,Иә
Dialogue: 0,0:07:01.39,0:07:04.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:04.39,0:07:06.39,Default,,0,0,0,,Сугимотоны бастайық
Dialogue: 0,0:07:06.39,0:07:08.39,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:12.40,0:07:14.40,Default,,0,0,0,,≪(Кёки) Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:07:14.40,0:07:17.40,Default,,0,0,0,,≪(Каори)
Dialogue: 0,0:07:14.40,0:07:17.40,Default,,0,0,0,,Сонымен, 75-беттегі диалогтан...
Dialogue: 0,0:07:17.40,0:07:20.40,Default,,0,0,0,,Фумичан!
Dialogue: 0,0:07:22.41,0:07:25.41,Default,,0,0,0,,А-чан
Dialogue: 0,0:07:22.41,0:07:25.41,Default,,0,0,0,,Мен бүгін ағаммен үйге бармаймын.
Dialogue: 0,0:07:25.41,0:07:28.35,Default,,0,0,0,,Иә. Олар кеш болады деді...
Dialogue: 0,0:07:28.35,0:07:32.35,Default,,0,0,0,,Әй, шәй ішкің келе ме?
Dialogue: 0,0:07:28.35,0:07:32.35,Default,,0,0,0,,Игуми мырза да менімен бірге.
Dialogue: 0,0:07:32.35,0:07:34.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:36.36,0:07:41.36,Default,,0,0,0,,Екі адам жақсы болса
Dialogue: 0,0:07:36.36,0:07:41.36,Default,,0,0,0,,Игуми мырза, Фуми-чан да жақсы ма?
Dialogue: 0,0:07:41.36,0:07:43.36,Default,,0,0,0,,Иә, әрине.
Dialogue: 0,0:07:43.36,0:07:59.38,Default,,0,0,0,,♬～
Dialogue: 0,0:07:59.38,0:08:01.38,Default,,0,0,0,,(Кёки)
Dialogue: 0,0:07:59.38,0:08:01.38,Default,,0,0,0,,《Бұл менің сүйіктім.➡
Dialogue: 0,0:08:01.38,0:08:05.38,Default,,0,0,0,,Мен сені кез келген жерге апарамын》
Dialogue: 0,0:08:05.38,0:08:07.38,Default,,0,0,0,,《Фуми! 》
Dialogue: 0,0:08:10.39,0:08:24.40,Default,,0,0,0,,♬～
Dialogue: 0,0:08:24.40,0:08:28.34,Default,,0,0,0,,О, ана?
Dialogue: 0,0:08:24.40,0:08:28.34,Default,,0,0,0,,Камакура
Dialogue: 0,0:08:24.40,0:08:28.34,Default,,0,0,0,,Қазір Камакура станциясының жанында
Dialogue: 0,0:08:28.34,0:08:31.34,Default,,0,0,0,,Иә. А-чанмен және басқалармен.
Dialogue: 0,0:08:31.34,0:08:34.35,Default,,0,0,0,,Менің үйіме қоңырау шалу қиын.
Dialogue: 0,0:08:34.35,0:08:38.35,Default,,0,0,0,,Бірақ Фуми-чан, сен жақсы қызсың ғой, солай ма?
Dialogue: 0,0:08:38.35,0:08:41.35,Default,,0,0,0,,Шынымен...｡➡
Dialogue: 0,0:08:41.35,0:08:45.36,Default,,0,0,0,,Сенпай... саған ол қыз ұнайды, солай ма?
Dialogue: 0,0:08:45.36,0:08:47.36,Default,,0,0,0,,Иә!?
Dialogue: 0,0:08:50.36,0:08:55.37,Default,,0,0,0,,Мен мұны көптен бері түсінбей жүрмін...
Dialogue: 0,0:08:55.37,0:09:00.37,Default,,0,0,0,,Игуми мырза? не болды? Эй!
Dialogue: 0,0:09:00.37,0:09:20.39,Default,,0,0,0,,♬～
Dialogue: 0,0:09:20.39,0:09:37.39,Default,,0,0,0,,♬～
Dialogue: 0,0:09:40.35,0:09:42.35,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:44.35,0:09:46.35,Default,,0,0,0,,[℡]
Dialogue: 0,0:09:44.35,0:09:46.35,Default,,0,0,0,,Ах
Dialogue: 0,0:09:48.35,0:09:51.36,Default,,0,0,0,,Сіз ұйықтадыңыз ба?
Dialogue: 0,0:09:48.35,0:09:51.36,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:09:51.36,0:09:56.36,Default,,0,0,0,,Бұл ештеңе емес, бірақ...
Dialogue: 0,0:09:51.36,0:09:56.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:56.36,0:10:00.37,Default,,0,0,0,,«Мен күтемін» нені білдіреді?
Dialogue: 0,0:09:56.36,0:10:00.37,Default,,0,0,0,,Сіз маған айтпадыңыз деп ойладым.
Dialogue: 0,0:10:00.37,0:10:02.37,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:10:05.37,0:10:09.37,Default,,0,0,0,,Айтар сөзің болса
Dialogue: 0,0:10:05.37,0:10:09.37,Default,,0,0,0,,Дұрыс айтыңыз
Dialogue: 0,0:10:11.38,0:10:15.38,Default,,0,0,0,,Айтшы, Фуми.
Dialogue: 0,0:10:11.38,0:10:15.38,Default,,0,0,0,,Мен уайымдап, ұйықтай алмаймын
Dialogue: 0,0:10:15.38,0:10:18.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:18.38,0:10:23.39,Default,,0,0,0,,Мен Киоко Игумимен сөйлестім
Dialogue: 0,0:10:23.39,0:10:27.33,Default,,0,0,0,,Ол сенпайын ұнататынын айтады.
Dialogue: 0,0:10:23.39,0:10:27.33,Default,,0,0,0,,Мен жыладым
Dialogue: 0,0:10:27.33,0:10:29.33,Default,,0,0,0,,[℡](Кёки) Иә...
Dialogue: 0,0:10:33.33,0:10:36.33,Default,,0,0,0,,[℡]Сәлем Фуми
Dialogue: 0,0:10:33.33,0:10:36.33,Default,,0,0,0,,Иә
Dialogue: 0,0:10:36.33,0:10:40.34,Default,,0,0,0,,[℡]Алғашқы махаббатыңыз есіңізде ме?
Dialogue: 0,0:10:36.33,0:10:40.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:40.34,0:10:43.34,Default,,0,0,0,,(Кёки)
Dialogue: 0,0:10:40.34,0:10:43.34,Default,,0,0,0,,Ең бірінші ғашық болған адам➡
Dialogue: 0,0:10:43.34,0:10:45.34,Default,,0,0,0,,Фуми есіңізде ме?
Dialogue: 0,0:10:48.35,0:10:51.35,Default,,0,0,0,,Фумичан! Қайырлы таң
Dialogue: 0,0:10:51.35,0:10:53.35,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:10:57.36,0:10:59.36,Default,,0,0,0,,Жақсы нәрсе болды, солай ма?
Dialogue: 0,0:10:59.36,0:11:02.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:02.36,0:11:06.36,Default,,0,0,0,,Білесің бе, кеше маған ағам телефон соқты.
Dialogue: 0,0:11:06.36,0:11:08.37,Default,,0,0,0,,О, сізге жақсы.
Dialogue: 0,0:11:08.37,0:11:10.37,Default,,0,0,0,,Иә
Dialogue: 0,0:11:13.37,0:11:15.37,Default,,0,0,0,,《Алғашқы махаббатыңыз есіңізде ме? 》
Dialogue: 0,0:11:17.38,0:11:20.38,Default,,0,0,0,,《Менің... алғашқы махаббатым》
Dialogue: 0,0:11:28.37,0:11:32.38,Default,,0,0,0,,[Майк] (Хабарландыру) Театр фестивалінің әртістері
Dialogue: 0,0:11:28.37,0:11:32.38,Default,,0,0,0,,және қызметкерлерден басқа студенттер ➡
Dialogue: 0,0:11:32.38,0:11:35.38,Default,,0,0,0,,Мектептен шығатын уақыт
Dialogue: 0,0:11:32.38,0:11:35.38,Default,,0,0,0,,Қайталаңыз
Dialogue: 0,0:11:35.38,0:11:38.38,Default,,0,0,0,,Бірдеңе жетіспейді ме?
Dialogue: 0,0:11:38.38,0:11:40.39,Default,,0,0,0,,Тағы біраз
Dialogue: 0,0:11:38.38,0:11:40.39,Default,,0,0,0,,Гүл әшекейлері көбейіп келеді
Dialogue: 0,0:11:40.39,0:11:43.39,Default,,0,0,0,,Хмм.
Dialogue: 0,0:11:40.39,0:11:43.39,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:11:50.40,0:11:52.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:50.40,0:11:52.40,Default,,0,0,0,,Уваааах! Ашылмай жатыр!
Dialogue: 0,0:11:52.40,0:11:54.40,Default,,0,0,0,,(студент)
Dialogue: 0,0:11:52.40,0:11:54.40,Default,,0,0,0,,Элементар программа дегеніміз не?
Dialogue: 0,0:11:54.40,0:11:58.40,Default,,0,0,0,,Хоши
Dialogue: 0,0:11:54.40,0:11:58.40,Default,,0,0,0,,Оудзи
Dialogue: 0,0:11:54.40,0:11:58.40,Default,,0,0,0,,«Кішкентай ханзада», солай ма?
Dialogue: 0,0:11:54.40,0:11:58.40,Default,,0,0,0,,Бұл бала Кішкентай ханзада ма?
Dialogue: 0,0:11:58.40,0:12:01.41,Default,,0,0,0,,Иә
Dialogue: 0,0:11:58.40,0:12:01.41,Default,,0,0,0,,Өзімшіл гүлдің рөлі туралы не айтасыз?
Dialogue: 0,0:12:01.41,0:12:06.41,Default,,0,0,0,,А, бұл қыз емес пе?
Dialogue: 0,0:12:01.41,0:12:06.41,Default,,0,0,0,,Кавайи
Dialogue: 0,0:12:06.41,0:12:09.41,Default,,0,0,0,,Онда, қадамдарға абай болыңыз.
Dialogue: 0,0:12:06.41,0:12:09.41,Default,,0,0,0,,Иә
Dialogue: 0,0:12:09.41,0:12:14.42,Default,,0,0,0,,Соқпа, ол нәзік.
Dialogue: 0,0:12:09.41,0:12:14.42,Default,,0,0,0,,Иә
Dialogue: 0,0:12:14.42,0:12:16.42,Default,,0,0,0,,Уау
Dialogue: 0,0:12:22.43,0:12:24.45,Default,,0,0,0,,Біз жаттығу жасап жатырмыз.
Dialogue: 0,0:12:24.45,0:12:27.37,Default,,0,0,0,,Әй, Сугимото-сенпай
Dialogue: 0,0:12:24.45,0:12:27.37,Default,,0,0,0,,Менің қайда екенімді білесің бе?
Dialogue: 0,0:12:27.37,0:12:32.37,Default,,0,0,0,,Егер сіз жоғары курста болсаңыз, сіз әлі келген жоқсыз.
Dialogue: 0,0:12:27.37,0:12:32.37,Default,,0,0,0,,Қашан келіп көрсем болады?
Dialogue: 0,0:12:32.37,0:12:35.37,Default,,0,0,0,,Иә, репетиция
Dialogue: 0,0:12:32.37,0:12:35.37,Default,,0,0,0,,Бастауыш мектептен кейін...
Dialogue: 0,0:12:35.37,0:12:39.37,Default,,0,0,0,,Әйтеуір, мен қазір жоқпын.
Dialogue: 0,0:12:35.37,0:12:39.37,Default,,0,0,0,,Кейін кездескенше
Dialogue: 0,0:12:43.38,0:12:47.39,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:12:43.38,0:12:47.39,Default,,0,0,0,,Бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:12:47.39,0:12:49.39,Default,,0,0,0,,≪(Ханзада) Қош бол
Dialogue: 0,0:12:53.39,0:12:57.40,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:12:53.39,0:12:57.40,Default,,0,0,0,,Иә, қош бол
Dialogue: 0,0:12:57.40,0:13:00.40,Default,,0,0,0,,Маған бәрібір, Окудайра мырза.
Dialogue: 0,0:13:00.40,0:13:06.40,Default,,0,0,0,,≪(Гүл) Аң келсе де қорықпаймын
Dialogue: 0,0:13:00.40,0:13:06.40,Default,,0,0,0,,Менде тікен бар.➡
Dialogue: 0,0:13:06.40,0:13:10.41,Default,,0,0,0,,Тез жүріңіз
Dialogue: 0,0:13:06.40,0:13:10.41,Default,,0,0,0,,Сіз баруды шешіп қойғансыз, солай ма?
Dialogue: 0,0:13:10.41,0:13:13.41,Default,,0,0,0,,《Екі адам бір-бірін сүйеді➡
Dialogue: 0,0:13:13.41,0:13:20.42,Default,,0,0,0,,Сондықтан кейбір адамдар мұңаяды
Dialogue: 0,0:13:13.41,0:13:20.42,Default,,0,0,0,,Мен оның бар екенін білмедім.
Dialogue: 0,0:13:20.42,0:13:35.37,Default,,0,0,0,,♬～
Dialogue: 0,0:13:35.37,0:13:39.37,Default,,0,0,0,,Мен ақымақ болдым
Dialogue: 0,0:13:39.37,0:13:44.38,Default,,0,0,0,,Мен қашып кеттім
Dialogue: 0,0:13:39.37,0:13:44.38,Default,,0,0,0,,Бұл қате болды
Dialogue: 0,0:13:44.38,0:13:49.38,Default,,0,0,0,,Мен сені сүйдім
Dialogue: 0,0:13:49.38,0:13:53.38,Default,,0,0,0,,(ханзада)
Dialogue: 0,0:13:49.38,0:13:53.38,Default,,0,0,0,,Бұл оның мейірімділігі еді.
Dialogue: 0,0:13:57.39,0:13:59.39,Default,,0,0,0,,Барғыңыз келмей ме?
Dialogue: 0,0:14:01.39,0:14:03.39,Default,,0,0,0,,Иә
Dialogue: 0,0:14:06.40,0:14:09.40,Default,,0,0,0,,Фуми бармайды.
Dialogue: 0,0:14:06.40,0:14:09.40,Default,,0,0,0,,Менің де барғым келмейді.
Dialogue: 0,0:14:09.40,0:14:13.40,Default,,0,0,0,,Сенің ағаң басты кейіпкер емес пе?
Dialogue: 0,0:14:09.40,0:14:13.40,Default,,0,0,0,,Хмм.
Dialogue: 0,0:14:16.41,0:14:19.41,Default,,0,0,0,,Киокомен кездесу ыңғайсыз ба?
Dialogue: 0,0:14:19.41,0:14:23.41,Default,,0,0,0,,Бұл ыңғайсыз... иә?
Dialogue: 0,0:14:23.41,0:14:26.35,Default,,0,0,0,,Мен жиі
Dialogue: 0,0:14:23.41,0:14:26.35,Default,,0,0,0,,Біз бір-бірімізді көріп тұрмыз.
Dialogue: 0,0:14:26.35,0:14:29.35,Default,,0,0,0,,Үлкендер
Dialogue: 0,0:14:26.35,0:14:29.35,Default,,0,0,0,,Мені шақырады.
Dialogue: 0,0:14:29.35,0:14:32.36,Default,,0,0,0,,Мен де
Dialogue: 0,0:14:29.35,0:14:32.36,Default,,0,0,0,,Мен Фумиге қоңырау шалғым келеді
Dialogue: 0,0:14:32.36,0:14:35.36,Default,,0,0,0,,Сондай дауыспен айтсаң да
Dialogue: 0,0:14:35.36,0:14:39.36,Default,,0,0,0,,Фуми мені аяйды.
Dialogue: 0,0:14:44.37,0:14:48.37,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:14:44.37,0:14:48.37,Default,,0,0,0,,Бүгін жалғыз барайық
Dialogue: 0,0:14:54.38,0:14:58.38,Default,,0,0,0,,О, керемет
Dialogue: 0,0:14:54.38,0:14:58.38,Default,,0,0,0,,Бұны Киоко тікті ме?
Dialogue: 0,0:14:58.38,0:15:02.39,Default,,0,0,0,,Мен мұны жалғыз істей алмаймын.
Dialogue: 0,0:14:58.38,0:15:02.39,Default,,0,0,0,,Мұнда барлығымен.
Dialogue: 0,0:15:02.39,0:15:04.39,Default,,0,0,0,,Ах
Dialogue: 0,0:15:04.39,0:15:06.39,Default,,0,0,0,,үшін керемет. Ерен еңбегіңіз үшін рахмет.
Dialogue: 0,0:15:06.39,0:15:10.40,Default,,0,0,0,,№.
Dialogue: 0,0:15:06.39,0:15:10.40,Default,,0,0,0,,Бұл біздің жұмысымыз
Dialogue: 0,0:15:10.40,0:15:13.40,Default,,0,0,0,,≪(мүше) Ah!
Dialogue: 0,0:15:10.40,0:15:13.40,Default,,0,0,0,,≪(мүше) Идиот! Сен не істеп жатырсың?
Dialogue: 0,0:15:13.40,0:15:16.40,Default,,0,0,0,,≪(мүше) Ах, кешіріңіз.
Dialogue: 0,0:15:13.40,0:15:16.40,Default,,0,0,0,,≪(Студенттер) Жоғары сыныптар
Dialogue: 0,0:15:16.40,0:15:20.41,Default,,0,0,0,,Тәттілерді жақсы көресің бе?
Dialogue: 0,0:15:16.40,0:15:20.41,Default,,0,0,0,,Бұл торт.
Dialogue: 0,0:15:20.41,0:15:24.43,Default,,0,0,0,,Қарсы болмасаңыз...
Dialogue: 0,0:15:20.41,0:15:24.43,Default,,0,0,0,,Уау. Рахмет.➡
Dialogue: 0,0:15:24.43,0:15:26.34,Default,,0,0,0,,Өйткені бұл үлкен мәселе
Dialogue: 0,0:15:24.43,0:15:26.34,Default,,0,0,0,,Бәріміз бірге тамақтанайық.
Dialogue: 0,0:15:26.34,0:15:29.35,Default,,0,0,0,,А... мен мұны айтқым келді...
Dialogue: 0,0:15:26.34,0:15:29.35,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:15:29.35,0:15:31.35,Default,,0,0,0,,《Бұл танымал.➡
Dialogue: 0,0:15:31.35,0:15:34.35,Default,,0,0,0,,Сонымен Фуми-чан да
Dialogue: 0,0:15:31.35,0:15:34.35,Default,,0,0,0,,Келгіңіз келмейтініне сенімдімін.
Dialogue: 0,0:15:34.35,0:15:36.35,Default,,0,0,0,,≪(Студент)
Dialogue: 0,0:15:34.35,0:15:36.35,Default,,0,0,0,,Мм, онда біз➡
Dialogue: 0,0:15:36.35,0:15:39.36,Default,,0,0,0,,Мен тарелка мен шанышқыны қарызға аламын.
Dialogue: 0,0:15:36.35,0:15:39.36,Default,,0,0,0,,Иә, өтінемін.
Dialogue: 0,0:15:39.36,0:15:41.36,Default,,0,0,0,,《Мистер Игуми...》
Dialogue: 0,0:15:41.36,0:15:44.36,Default,,0,0,0,,Ой! Бұл керемет, Киоко. Ол қолдан жасалған.
Dialogue: 0,0:15:44.36,0:15:47.37,Default,,0,0,0,,Аға
Dialogue: 0,0:15:44.36,0:15:47.37,Default,,0,0,0,,Бір сәтке тұра аласыз ба?
Dialogue: 0,0:15:47.37,0:15:49.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:55.37,0:15:57.38,Default,,0,0,0,,Ах
Dialogue: 0,0:15:57.38,0:16:00.38,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:57.38,0:16:00.38,Default,,0,0,0,,Әйелдер бұл рөлге жарамайды; ол спикер ретіндегі рөлін түсінуде жеткіліксіз санаға ие болған деген қорытындыға келуге тура келеді
Dialogue: 0,0:16:00.38,0:16:02.38,Default,,0,0,0,,О
Dialogue: 0,0:16:07.39,0:16:11.39,Default,,0,0,0,,Иә? А-чан
Dialogue: 0,0:16:07.39,0:16:11.39,Default,,0,0,0,,Сіз де торт жегіңіз келе ме?
Dialogue: 0,0:16:11.39,0:16:13.39,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:16:13.39,0:16:15.39,Default,,0,0,0,,Тірекпен бекітіңіз
Dialogue: 0,0:16:15.39,0:16:18.40,Default,,0,0,0,,Қозғалу қиын жер болса
Dialogue: 0,0:16:15.39,0:16:18.40,Default,,0,0,0,,Айтыңызшы
Dialogue: 0,0:16:18.40,0:16:20.40,Default,,0,0,0,,Мен шай дайындап берейін.
Dialogue: 0,0:16:20.40,0:16:24.40,Default,,0,0,0,,Бұл жаман. Егер Фуми сонда болса.
Dialogue: 0,0:16:20.40,0:16:24.40,Default,,0,0,0,,Мен Фумиден жақсылық сұраймын.
Dialogue: 0,0:16:29.34,0:16:34.35,Default,,0,0,0,,Ух... Біз де барайық, Игуми мырза.
Dialogue: 0,0:16:34.35,0:16:36.35,Default,,0,0,0,,Иә? Күте тұрыңыз... бір сәт
Dialogue: 0,0:16:36.35,0:16:39.35,Default,,0,0,0,,≪(Есіктің ашылу/жабылу дыбысы)
Dialogue: 0,0:16:39.35,0:16:42.35,Default,,0,0,0,,А-чан, сен жақсысың.
Dialogue: 0,0:16:44.36,0:16:46.36,Default,,0,0,0,,≪(Студент)
Dialogue: 0,0:16:44.36,0:16:46.36,Default,,0,0,0,,Қара, қара. Бұл керемет.➡
Dialogue: 0,0:16:46.36,0:16:48.36,Default,,0,0,0,,Мына нәрсені беліңізге қойыңыз.
Dialogue: 0,0:16:48.36,0:16:52.36,Default,,0,0,0,,Қолдар тентек.
Dialogue: 0,0:16:48.36,0:16:52.36,Default,,0,0,0,,Бұл керемет емес пе?
Dialogue: 0,0:16:52.36,0:16:54.37,Default,,0,0,0,,Қызық, өмірде сүйісеміз бе?
Dialogue: 0,0:16:54.37,0:16:56.37,Default,,0,0,0,,≪Кешіріңіз.
Dialogue: 0,0:16:54.37,0:16:56.37,Default,,0,0,0,,Ойласам, біз ұзақ уақыт сөйлеспеген сияқтымыз
Dialogue: 0,0:16:56.37,0:16:59.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:59.37,0:17:01.37,Default,,0,0,0,,​​О?
Dialogue: 0,0:17:01.37,0:17:05.37,Default,,0,0,0,,Қазір бұл не? Мм, қара шай, қара шай.
Dialogue: 0,0:17:07.38,0:17:23.39,Default,,0,0,0,,♬～
Dialogue: 0,0:17:23.39,0:17:26.33,Default,,0,0,0,,《үшін
Dialogue: 0,0:17:23.39,0:17:26.33,Default,,0,0,0,,Себебі мен сені шын сүймеймін➡
Dialogue: 0,0:17:26.33,0:17:29.33,Default,,0,0,0,,Мұндай шу шығаруға болады.➡
Dialogue: 0,0:17:29.33,0:17:32.33,Default,,0,0,0,,Мен басқа болсам да》
Dialogue: 0,0:17:40.35,0:17:42.35,Default,,0,0,0,,《Не?》
Dialogue: 0,0:17:40.35,0:17:42.35,Default,,0,0,0,,《Кешіріңіз.➡
Dialogue: 0,0:17:42.35,0:17:45.35,Default,,0,0,0,,Кенже
Dialogue: 0,0:17:42.35,0:17:45.35,Default,,0,0,0,,Әлі істеу керек нәрсе бар》
Dialogue: 0,0:17:45.35,0:17:49.35,Default,,0,0,0,,《Күтеміз бе? 》
Dialogue: 0,0:17:45.35,0:17:49.35,Default,,0,0,0,,Музыканы енді ести алмай қалуым мүмкін.
Dialogue: 0,0:17:49.35,0:18:03.37,Default,,0,0,0,,♬～
Dialogue: 0,0:18:03.37,0:18:07.37,Default,,0,0,0,,Тек бір желдеткіш
Dialogue: 0,0:18:03.37,0:18:07.37,Default,,0,0,0,,Жоқ.➡
Dialogue: 0,0:18:07.37,0:18:11.38,Default,,0,0,0,,Мен де сол балалар сияқтымын...
Dialogue: 0,0:18:11.38,0:18:14.38,Default,,0,0,0,,Сіз маған жаңа ғана айттыңыз ба?
Dialogue: 0,0:18:14.38,0:18:17.38,Default,,0,0,0,,Мұнда
Dialogue: 0,0:18:14.38,0:18:17.38,Default,,0,0,0,,Онда тек ағам екеуміз ғана бармыз.
Dialogue: 0,0:18:17.38,0:18:21.39,Default,,0,0,0,,Бұны кеше Киоко айтты.
Dialogue: 0,0:18:17.38,0:18:21.39,Default,,0,0,0,,Маған бұрынғыдай қарым-қатынас жасауыңызды өтінемін.
Dialogue: 0,0:18:21.39,0:18:24.41,Default,,0,0,0,,Номиналды құны бойынша
Dialogue: 0,0:18:21.39,0:18:24.41,Default,,0,0,0,,Қабылдамау
Dialogue: 0,0:18:24.41,0:18:26.41,Default,,0,0,0,,Мен күштімін.
Dialogue: 0,0:18:30.33,0:18:34.33,Default,,0,0,0,,оны сол күйінде қалдырыңыз
Dialogue: 0,0:18:30.33,0:18:34.33,Default,,0,0,0,,Оны Киоко айтады.
Dialogue: 0,0:18:34.33,0:18:37.34,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:18:34.33,0:18:37.34,Default,,0,0,0,,Менің әпкем сияқты...?
Dialogue: 0,0:18:37.34,0:18:39.34,Default,,0,0,0,,Ол мәңгілікке жалғасады
Dialogue: 0,0:18:39.34,0:18:43.34,Default,,0,0,0,,Өйткені Киоко жақсы қыз
Dialogue: 0,0:18:39.34,0:18:43.34,Default,,0,0,0,,Жыламаңыз
Dialogue: 0,0:18:43.34,0:18:45.34,Default,,0,0,0,,өшпенділік
Dialogue: 0,0:18:50.35,0:18:53.35,Default,,0,0,0,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 0,0:18:57.36,0:18:59.36,Default,,0,0,0,,Йоши
Dialogue: 0,0:18:57.36,0:18:59.36,Default,,0,0,0,,≪(Ёши) Фумичан
Dialogue: 0,0:18:59.36,0:19:02.36,Default,,0,0,0,,Не? Ана. Ах!
Dialogue: 0,0:19:02.36,0:19:06.36,Default,,0,0,0,,Фуми
Dialogue: 0,0:19:02.36,0:19:06.36,Default,,0,0,0,,Уау, уау, Сенпай
Dialogue: 0,0:19:06.36,0:19:08.37,Default,,0,0,0,,Не?
Dialogue: 0,0:19:06.36,0:19:08.37,Default,,0,0,0,,Кешіріңіз.➡
Dialogue: 0,0:19:08.37,0:19:11.37,Default,,0,0,0,,Мен Фумидің түрін көргім келеді
Dialogue: 0,0:19:13.37,0:19:15.37,Default,,0,0,0,,Қабылдау?
Dialogue: 0,0:19:15.37,0:19:20.38,Default,,0,0,0,,Иә. Театр фестивалі өтетін жерде.
Dialogue: 0,0:19:15.37,0:19:20.38,Default,,0,0,0,,Мен менеджермен сөйлесіп қойғанмын.
Dialogue: 0,0:19:20.38,0:19:22.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:22.38,0:19:25.32,Default,,0,0,0,,Әйтпесе
Dialogue: 0,0:19:22.38,0:19:25.32,Default,,0,0,0,,Фуми, сен келмейсің.
Dialogue: 0,0:19:25.32,0:19:27.32,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,0:19:30.32,0:19:34.33,Default,,0,0,0,,Ондай нәрсе жоқ...
Dialogue: 0,0:19:34.33,0:19:38.33,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:19:34.33,0:19:38.33,Default,,0,0,0,,Мен қоңырау шалсам келесің бе?
Dialogue: 0,0:19:38.33,0:19:41.33,Default,,0,0,0,,Иә
Dialogue: 0,0:19:38.33,0:19:41.33,Default,,0,0,0,,Иә
Dialogue: 0,0:19:43.33,0:19:47.34,Default,,0,0,0,,Бұл
Dialogue: 0,0:19:43.33,0:19:47.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:47.34,0:19:52.34,Default,,0,0,0,,Мұнда Он екі Құбыжық Айдың тек Төменгі Айлары ғана жиналған
Dialogue: 0,0:19:47.34,0:19:52.34,Default,,0,0,0,,Хахаха...｡ Фумимон
Dialogue: 0,0:19:54.35,0:19:57.35,Default,,0,0,0,,Суық емес пе?
Dialogue: 0,0:19:54.35,0:19:57.35,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:19:57.35,0:20:01.35,Default,,0,0,0,,Бұл жаңа көзқарас.
Dialogue: 0,0:19:57.35,0:20:01.35,Default,,0,0,0,,Ах аа
Dialogue: 0,0:20:01.35,0:20:07.36,Default,,0,0,0,,Хахаха. Сондай сүйкімді
Dialogue: 0,0:20:01.35,0:20:07.36,Default,,0,0,0,,Мазаламау
Dialogue: 0,0:20:07.36,0:20:11.36,Default,,0,0,0,,[℡]Му Фуми-чан
Dialogue: 0,0:20:07.36,0:20:11.36,Default,,0,0,0,,Айтсам ғой.
Dialogue: 0,0:20:11.36,0:20:15.37,Default,,0,0,0,,Айтуды ұмытып кетіппін.
Dialogue: 0,0:20:11.36,0:20:15.37,Default,,0,0,0,,Жай ғана грильде пісірілген мочи сорпасы
Dialogue: 0,0:20:15.37,0:20:17.37,Default,,0,0,0,,[℡] Бұл жақсы.
Dialogue: 0,0:20:15.37,0:20:17.37,Default,,0,0,0,,Қыз
Dialogue: 0,0:20:17.37,0:20:22.37,Default,,0,0,0,,Қалай болғанда да, сол адамдар үшін
Dialogue: 0,0:20:17.37,0:20:22.37,Default,,0,0,0,,Мен оны қатты және анық айтуым керек
Dialogue: 0,0:20:22.37,0:20:25.31,Default,,0,0,0,,Кез келген жерде
Dialogue: 0,0:20:22.37,0:20:25.31,Default,,0,0,0,,Танымал болмаңыз
Dialogue: 0,0:20:25.31,0:20:27.31,Default,,0,0,0,,[℡] Иә?
Dialogue: 0,0:20:27.31,0:20:30.31,Default,,0,0,0,,Бұл біртүрлі емес пе?
Dialogue: 0,0:20:27.31,0:20:30.31,Default,,0,0,0,,[℡]Солай ма?
Dialogue: 0,0:20:30.31,0:20:33.32,Default,,0,0,0,,Бірақ. Мен де, Фуми-чан.
Dialogue: 0,0:20:30.31,0:20:33.32,Default,,0,0,0,,Ол келмейді деп қорқамын➡
Dialogue: 0,0:20:33.32,0:20:35.32,Default,,0,0,0,,Мен қуаныштымын, өйткені мен уайымдадым.
Dialogue: 0,0:20:35.32,0:20:38.32,Default,,0,0,0,,Мен де, шынымен.
Dialogue: 0,0:20:35.32,0:20:38.32,Default,,0,0,0,,Мен өте қуаныштымын.
Dialogue: 0,0:20:38.32,0:20:41.33,Default,,0,0,0,,Ертеңгі театр фестивалінде бар күшімізді салайық
Dialogue: 0,0:20:41.33,0:20:45.33,Default,,0,0,0,,Иә. Бұл сәтті болады деп үміттенемін.
Dialogue: 0,0:20:41.33,0:20:45.33,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:20:47.33,0:20:49.33,Default,,0,0,0,,(құлыпты ашу дыбысы)
Dialogue: 0,0:20:56.34,0:20:58.34,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:21:10.35,0:21:15.36,Default,,0,0,0,,♬『ｾﾝﾃｨﾌｫﾘｱ』
Dialogue: 0,0:21:15.36,0:21:35.38,Default,,0,0,0,,♬～
