Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.47,0:00:18.48,Default,,0000,0000,0000,,≪(Фумидің жылауы)
Dialogue: 0,0:00:18.48,0:00:29.49,Default,,0000,0000,0000,,(Фуми жылайды)
Dialogue: 0,0:00:29.49,0:00:35.50,Default,,0000,0000,0000,,(Фуми жылайды)
Dialogue: 0,0:00:35.50,0:00:39.50,Default,,0000,0000,0000,,《Фуми-чан бұл
Dialogue: 0,0:00:35.50,0:00:39.50,Default,,0000,0000,0000,,Себебі сен оңай жылайсың》
Dialogue: 0,0:00:45.51,0:00:48.51,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:00:48.51,0:01:00.51,Default,,0000,0000,0000,,(Сағат дабылының дыбысы)
Dialogue: 0,0:01:07.46,0:01:12.47,Rubi,,0000,0000,0000,,Көк
Dialogue: 0,0:01:07.46,0:01:12.47,Rubi,,0000,0000,0000,,3D маневрлік жабдықтың табиғи жауы.
Dialogue: 0,0:01:07.46,0:01:12.47,Default,,0000,0000,0000,,♬『Көк гүл』
Dialogue: 0,0:01:12.47,0:01:22.48,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:01:22.48,0:01:33.49,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:01:33.49,0:01:42.50,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:01:42.50,0:02:02.45,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:02:02.45,0:02:22.47,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:02:22.47,0:02:35.47,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:02:43.46,0:02:46.46,Rubi,,0000,0000,0000,,Акио
Dialogue: 0,0:02:43.46,0:02:46.46,Default,,0000,0000,0000,,(Акио)
Dialogue: 0,0:02:43.46,0:02:46.46,Default,,0000,0000,0000,,Бүгін кешігіп келемін, сондықтан кешкі ас ішкім келеді.
Dialogue: 0,0:02:46.46,0:02:49.46,Rubi,,0000,0000,0000,,Йоши
Dialogue: 0,0:02:46.46,0:02:49.46,Default,,0000,0000,0000,,О. Трансферден кейін көп ұзамай?
Dialogue: 0,0:02:49.46,0:02:54.47,Default,,0000,0000,0000,,Жоқ, негізгі дүкенге оралу арқылы
Dialogue: 0,0:02:49.46,0:02:54.47,Default,,0000,0000,0000,,Олар сізге орын дайындаймыз дейді.
Dialogue: 0,0:02:54.47,0:02:57.47,Default,,0000,0000,0000,,Уау. Барлығы сондай мейірімді.
Dialogue: 0,0:02:57.47,0:03:00.47,Default,,0000,0000,0000,,Сіз тек ішуге себеп тапқыңыз келеді.
Dialogue: 0,0:03:00.47,0:03:02.48,Default,,0000,0000,0000,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:03:00.47,0:03:02.48,Default,,0000,0000,0000,,Біраз уақыт шығамыз ба?
Dialogue: 0,0:03:02.48,0:03:06.48,Default,,0000,0000,0000,,Сіз шығасыз ба?
Dialogue: 0,0:03:02.48,0:03:06.48,Default,,0000,0000,0000,,Иә. Ескі таныс.
Dialogue: 0,0:03:06.48,0:03:09.48,Rubi,,0000,0000,0000,,Чизу
Dialogue: 0,0:03:06.48,0:03:09.48,Default,,0000,0000,0000,,Чизу-чан ше?
Dialogue: 0,0:03:06.48,0:03:09.48,Default,,0000,0000,0000,,Маған үйде қалуға рұқсат бересіз бе?
Dialogue: 0,0:03:09.48,0:03:13.49,Default,,0000,0000,0000,,Мен кешкі асқа уақытында ораламын.
Dialogue: 0,0:03:09.48,0:03:13.49,Default,,0000,0000,0000,,Фумиді өзіңізбен бірге алыңыз
Dialogue: 0,0:03:13.49,0:03:17.49,Default,,0000,0000,0000,,Фумимо?
Dialogue: 0,0:03:13.49,0:03:17.49,Default,,0000,0000,0000,,Бүгін мектептегі алғашқы күн болды.
Dialogue: 0,0:03:17.49,0:03:19.49,Default,,0000,0000,0000,,Мен сенің соңынан ергенім дұрыс па?
Dialogue: 0,0:03:19.49,0:03:23.50,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:03:19.49,0:03:23.50,Default,,0000,0000,0000,,Фумиге ұнамайтынына сенімдімін.
Dialogue: 0,0:03:23.50,0:03:25.50,Default,,0000,0000,0000,,Чизу-чан
Dialogue: 0,0:03:23.50,0:03:25.50,Default,,0000,0000,0000,,Менімен бірге барғыңыз келсе➡
Dialogue: 0,0:03:25.50,0:03:27.50,Default,,0000,0000,0000,,Бұл басқаша болуы мүмкін.
Dialogue: 0,0:03:29.50,0:03:34.51,Default,,0000,0000,0000,,Жәндіктерге қарсы құрал. Ілгіште.
Dialogue: 0,0:03:29.50,0:03:34.51,Default,,0000,0000,0000,,Сіз оны іліп қоюды ұмыттыңыз ба?
Dialogue: 0,0:03:34.51,0:03:37.51,Default,,0000,0000,0000,,Юбе Байқадым да іліп қойдым.
Dialogue: 0,0:03:37.51,0:03:42.51,Default,,0000,0000,0000,,Аз ғана болса жақсы.
Dialogue: 0,0:03:37.51,0:03:42.51,Default,,0000,0000,0000,,Ешкім байқамайды
Dialogue: 0,0:03:45.45,0:03:49.46,Default,,0000,0000,0000,,Сіз шынымен ертең қайтасыз ба?
Dialogue: 0,0:03:49.46,0:03:51.46,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:03:51.46,0:03:57.46,Default,,0000,0000,0000,,Сіз демалысыңызды кейінге қалдыра алмайсыз ба?
Dialogue: 0,0:03:51.46,0:03:57.46,Default,,0000,0000,0000,,Осы аптада... бір күн болса да.
Dialogue: 0,0:04:00.47,0:04:02.47,Default,,0000,0000,0000,,Кешіріңіз.➡
Dialogue: 0,0:04:02.47,0:04:05.47,Default,,0000,0000,0000,,Егер мен де кейінге қалдырсам
Dialogue: 0,0:04:02.47,0:04:05.47,Default,,0000,0000,0000,,Мен оны кейінге қалдырғым келеді.
Dialogue: 0,0:04:07.47,0:04:10.48,Default,,0000,0000,0000,,Қайтып келмегенімді қалаймын.
Dialogue: 0,0:04:07.47,0:04:10.48,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:04:10.48,0:04:14.48,Rubi,,0000,0000,0000,,Камакура
Dialogue: 0,0:04:10.48,0:04:14.48,Default,,0000,0000,0000,,Камакураның бір жері
Dialogue: 0,0:04:10.48,0:04:14.48,Default,,0000,0000,0000,,Қайтып келмегенімді қалаймын.
Dialogue: 0,0:04:14.48,0:04:18.48,Default,,0000,0000,0000,,Мен Чизу-чаннан айырылғым келмеді.
Dialogue: 0,0:04:22.49,0:04:26.49,Rubi,,0000,0000,0000,,Иә, сол – қамыр жағылған.
Dialogue: 0,0:04:22.49,0:04:26.49,Default,,0000,0000,0000,,♬(Шинобуның гуілдеуі)
Dialogue: 0,0:04:28.50,0:04:33.50,Default,,0000,0000,0000,,Хаха…｡ Сәлем!
Dialogue: 0,0:04:28.50,0:04:33.50,Rubi,,0000,0000,0000,,Сакико
Dialogue: 0,0:04:28.50,0:04:33.50,Default,,0000,0000,0000,,А-чан түскі ас қорабы
Dialogue: 0,0:04:33.50,0:04:36.50,Default,,0000,0000,0000,,Кешіріңізші!
Dialogue: 0,0:04:33.50,0:04:36.50,Default,,0000,0000,0000,,А, асығудың қажеті жоқ.
Dialogue: 0,0:04:36.50,0:04:40.44,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:36.50,0:04:40.44,Default,,0000,0000,0000,,Шинобу мені айдап береді.
Dialogue: 0,0:04:40.44,0:04:43.44,Default,,0000,0000,0000,,А, сенің ағаң!?
Dialogue: 0,0:04:46.45,0:04:49.45,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:04:46.45,0:04:49.45,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:05:02.46,0:05:05.47,Default,,0000,0000,0000,,Теңізші костюмі сізге өте жарасады
Dialogue: 0,0:05:05.47,0:05:08.47,Default,,0000,0000,0000,,Иә, жаман емес
Dialogue: 0,0:05:05.47,0:05:08.47,Default,,0000,0000,0000,,Бұл өте маңызды нәрсе.
Dialogue: 0,0:05:08.47,0:05:11.47,Default,,0000,0000,0000,,Жағымпаздық жақсы.
Dialogue: 0,0:05:08.47,0:05:11.47,Default,,0000,0000,0000,,Камакура станциясында түсіңіз
Dialogue: 0,0:05:11.47,0:05:15.48,Default,,0000,0000,0000,,Неліктен? Мен сені мектепке апарамын
Dialogue: 0,0:05:11.47,0:05:15.48,Default,,0000,0000,0000,,Тек станцияға барыңыз.
Dialogue: 0,0:05:15.48,0:05:18.48,Default,,0000,0000,0000,,Бұл үлкен мәселе емес. Мектепке бару...
Dialogue: 0,0:05:18.48,0:05:20.48,Default,,0000,0000,0000,,Бұл ұят!
Dialogue: 0,0:05:20.48,0:05:24.48,Default,,0000,0000,0000,,Сен сүйкімдісің
Dialogue: 0,0:05:20.48,0:05:24.48,Default,,0000,0000,0000,,Мен ұйықтап жатқанда ғана
Dialogue: 0,0:05:32.49,0:05:35.50,Default,,0000,0000,0000,,Зорлықшылардан сақ болыңыз
Dialogue: 0,0:05:32.49,0:05:35.50,Default,,0000,0000,0000,,Шулы!
Dialogue: 0,0:05:35.50,0:05:37.50,Default,,0000,0000,0000,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:05:46.44,0:05:48.44,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:05:54.45,0:05:56.45,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:05:56.45,0:05:59.45,Default,,0000,0000,0000,,Ой, кешіріңіз. Сенімен бәрі жақсы ма?
Dialogue: 0,0:05:59.45,0:06:02.46,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:05:59.45,0:06:02.46,Default,,0000,0000,0000,,Уф! Босат! Мені босат!
Dialogue: 0,0:06:02.46,0:06:04.46,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:06:11.47,0:06:13.47,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:06:37.49,0:06:39.51,Default,,0000,0000,0000,,Уау
Dialogue: 0,0:06:39.51,0:06:42.51,Default,,0000,0000,0000,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:06:39.51,0:06:42.51,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:06:45.43,0:06:48.43,Default,,0000,0000,0000,,А... Иә?
Dialogue: 0,0:06:51.44,0:06:54.44,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:06:54.44,0:06:56.44,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:06:54.44,0:06:56.44,Rubi,,0000,0000,0000,,Райнер, кейін кездескенше.
Dialogue: 0,0:06:54.44,0:06:56.44,Default,,0000,0000,0000,,Ауырды!
Dialogue: 0,0:06:56.44,0:06:58.44,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:01.45,0:07:06.45,Default,,0000,0000,0000,,Бұл апат болды.
Dialogue: 0,0:07:01.45,0:07:06.45,Default,,0000,0000,0000,,Көмегің үшін көп рахмет.
Dialogue: 0,0:07:06.45,0:07:09.46,Default,,0000,0000,0000,,Егер сіз қорлаушының аяғын бассаңыз,
Dialogue: 0,0:07:06.45,0:07:09.46,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:07:09.46,0:07:11.46,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:07:09.46,0:07:11.46,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:07:18.47,0:07:21.47,Default,,0000,0000,0000,,Мен осындамын
Dialogue: 0,0:07:18.47,0:07:21.47,Default,,0000,0000,0000,,Ұлы соғыс аяқталғаннан бері—
Dialogue: 0,0:07:21.47,0:07:25.47,Default,,0000,0000,0000,,Он соққылы қарғыс техникасы: Тайл құлау, Тайл құлау!
Dialogue: 0,0:07:21.47,0:07:25.47,Default,,0000,0000,0000,,Сізге көп рахмет
Dialogue: 0,0:07:25.47,0:07:28.48,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:07:28.48,0:07:32.48,Default,,0000,0000,0000,,《Ол соншалықты үлкен болса да
Dialogue: 0,0:07:28.48,0:07:32.48,Default,,0000,0000,0000,,Сіз жылап жатырсыз ба?
Dialogue: 0,0:07:32.48,0:07:35.48,Default,,0000,0000,0000,,《Сүйкімді нәрсе》
Dialogue: 0,0:07:41.42,0:07:45.43,Default,,0000,0000,0000,,Қайырлы таң, апалар.
Dialogue: 0,0:07:45.43,0:07:49.43,Default,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:07:45.43,0:07:49.43,Default,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:07:49.43,0:07:51.43,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:07:51.43,0:07:53.43,Default,,0000,0000,0000,,(Бастауыш балалар)
Dialogue: 0,0:07:51.43,0:07:53.43,Default,,0000,0000,0000,,Қайырлы таң апа
Dialogue: 0,0:07:53.43,0:07:57.44,Default,,0000,0000,0000,,Иә, қайырлы таң.
Dialogue: 0,0:07:53.43,0:07:57.44,Default,,0000,0000,0000,,Қайырлы таң!
Dialogue: 0,0:07:57.44,0:08:01.44,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:57.44,0:08:01.44,Default,,0000,0000,0000,,Иә, қайырлы таң.
Dialogue: 0,0:08:03.44,0:08:06.44,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:08:08.45,0:08:13.45,Default,,0000,0000,0000,,<Ұзын еңістің басында
Dialogue: 0,0:08:08.45,0:08:13.45,Default,,0000,0000,0000,,Яғни>
Dialogue: 0,0:08:15.46,0:08:18.46,Default,,0000,0000,0000,,<Бүгіннен бастап мен жоғары сынып оқушысымын>
Dialogue: 0,0:08:18.46,0:08:24.46,Default,,0000,0000,0000,,＜Бүгіннен бастап мен
Dialogue: 0,0:08:18.46,0:08:24.46,Rubi,,0000,0000,0000,,Фудзигая
Dialogue: 0,0:08:18.46,0:08:24.46,Default,,0000,0000,0000,,Фудзигая ханымы>
Dialogue: 0,0:08:31.47,0:08:35.48,Default,,0000,0000,0000,,Алдын ала рахмет
Dialogue: 0,0:08:31.47,0:08:35.48,Default,,0000,0000,0000,,Иә, рахмет.➡
Dialogue: 0,0:08:35.48,0:08:38.48,Default,,0000,0000,0000,,Содан кейін келесі адам｡➡
Dialogue: 0,0:08:38.48,0:08:44.42,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:08:38.48,0:08:44.42,Default,,0000,0000,0000,,Мм, Банджоме мырза?
Dialogue: 0,0:08:44.42,0:08:46.42,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:46.42,0:08:49.42,Rubi,,0000,0000,0000,,Йоко
Dialogue: 0,0:08:46.42,0:08:49.42,Default,,0000,0000,0000,,Сіз емессіз бе?
Dialogue: 0,0:08:46.42,0:08:49.42,Default,,0000,0000,0000,,Иә? Ах!
Dialogue: 0,0:08:49.42,0:08:53.43,Default,,0000,0000,0000,,Кешіріңіз. Мен алаңдадым.
Dialogue: 0,0:08:53.43,0:08:56.43,Rubi,,0000,0000,0000,,Микаса
Dialogue: 0,0:08:53.43,0:08:56.43,Default,,0000,0000,0000,,Мен Микаса орта мектебінен келдім
Dialogue: 0,0:08:53.43,0:08:56.43,Rubi,,0000,0000,0000,,Манжоме
Dialogue: 0,0:08:53.43,0:08:56.43,Default,,0000,0000,0000,,Бұл Фуми Манжоме.
Dialogue: 0,0:08:56.43,0:09:00.43,Default,,0000,0000,0000,,Мен Камакураға өткен айда көшіп келдім.
Dialogue: 0,0:08:56.43,0:09:00.43,Default,,0000,0000,0000,,Алдын ала рахмет
Dialogue: 0,0:09:00.43,0:09:04.44,Default,,0000,0000,0000,,(Мұғалім)
Dialogue: 0,0:09:00.43,0:09:04.44,Default,,0000,0000,0000,,Иә, танысқаныма қуаныштымын. Келесі адам.
Dialogue: 0,0:09:04.44,0:09:08.44,Default,,0000,0000,0000,,Фу…
Dialogue: 0,0:09:04.44,0:09:08.44,Rubi,,0000,0000,0000,,Хонацуги
Dialogue: 0,0:09:04.44,0:09:08.44,Default,,0000,0000,0000,,I, Йоко Хонацуги
Dialogue: 0,0:09:08.44,0:09:12.44,Default,,0000,0000,0000,,Танысқаныма қуаныштымын. Хехе
Dialogue: 0,0:09:08.44,0:09:12.44,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:09:14.45,0:09:17.45,Default,,0000,0000,0000,,ше? Онда кім болды?
Dialogue: 0,0:09:17.45,0:09:20.45,Rubi,,0000,0000,0000,,Мива
Dialogue: 0,0:09:17.45,0:09:20.45,Default,,0000,0000,0000,,Мүлдем емес
Dialogue: 0,0:09:17.45,0:09:20.45,Rubi,,0000,0000,0000,,Мисако
Dialogue: 0,0:09:17.45,0:09:20.45,Default,,0000,0000,0000,,Сол жақтағымен бірдей
Dialogue: 0,0:09:20.45,0:09:22.46,Default,,0000,0000,0000,,Менің ойымша, бұл жақсы емес ...
Dialogue: 0,0:09:22.46,0:09:27.46,Default,,0000,0000,0000,,Драма үйірмесіне енді кім қосылғысы келеді?
Dialogue: 0,0:09:22.46,0:09:27.46,Default,,0000,0000,0000,,Тіпті бір адам да жоқ.
Dialogue: 0,0:09:27.46,0:09:30.46,Default,,0000,0000,0000,,(Мива)
Dialogue: 0,0:09:27.46,0:09:30.46,Default,,0000,0000,0000,,Міне, осы үшеуі қайта бару керек.
Dialogue: 0,0:09:30.46,0:09:34.47,Default,,0000,0000,0000,,Манжоме мырзаның атмосферасы керемет.
Dialogue: 0,0:09:34.47,0:09:37.47,Default,,0000,0000,0000,,Білемін, бірақ шынымен сабырымды сақтай аламын ба?
Dialogue: 0,0:09:34.47,0:09:37.47,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:37.47,0:09:42.41,Default,,0000,0000,0000,,Ах, Манжоме-сан.
Dialogue: 0,0:09:37.47,0:09:42.41,Default,,0000,0000,0000,,Бойы Ол шынымен де ұзын.
Dialogue: 0,0:09:42.41,0:09:45.41,Default,,0000,0000,0000,,Қыздар мектебіне ылғал қосатын түрі?
Dialogue: 0,0:09:45.41,0:09:48.42,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:09:48.42,0:09:50.42,Default,,0000,0000,0000,,Манжоме-сан
Dialogue: 0,0:09:48.42,0:09:50.42,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:50.42,0:09:53.42,Default,,0000,0000,0000,,Менің есімім есіңізде ме?
Dialogue: 0,0:09:53.42,0:09:56.42,Default,,0000,0000,0000,,Йоко Хонацуги...
Dialogue: 0,0:09:56.42,0:09:59.43,Default,,0000,0000,0000,,Жолдарды жақсы жаттаңыз!
Dialogue: 0,0:09:56.42,0:09:59.43,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:59.43,0:10:02.43,Default,,0000,0000,0000,,Әдеттегідей
Dialogue: 0,0:09:59.43,0:10:02.43,Default,,0000,0000,0000,,Ол тыныш жігіт.
Dialogue: 0,0:10:02.43,0:10:06.43,Default,,0000,0000,0000,,Бірақ сонда
Dialogue: 0,0:10:02.43,0:10:06.43,Default,,0000,0000,0000,,Пон-чанның несі жақсы?
Dialogue: 0,0:10:06.43,0:10:08.44,Default,,0000,0000,0000,,Клуб іс-шаралары Сіз қайда қосылуды шештіңіз бе?
Dialogue: 0,0:10:08.44,0:10:11.44,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:10:08.44,0:10:11.44,Default,,0000,0000,0000,,Мен клубқа қосылғым келмейді.
Dialogue: 0,0:10:11.44,0:10:16.44,Default,,0000,0000,0000,,Боу! Біз бір клубтамыз
Dialogue: 0,0:10:11.44,0:10:16.44,Default,,0000,0000,0000,,Сіз тиесілі болуыңыз керек.
Dialogue: 0,0:10:18.45,0:10:21.45,Default,,0000,0000,0000,,Әй, қорқынышты бет
Dialogue: 0,0:10:18.45,0:10:21.45,Default,,0000,0000,0000,,Кешіріңіз, ашуланбаңыз.
Dialogue: 0,0:10:21.45,0:10:23.45,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:10:23.45,0:10:26.45,Default,,0000,0000,0000,,Сол екеуі
Dialogue: 0,0:10:23.45,0:10:26.45,Default,,0000,0000,0000,,Екеуміз бір орта мектептен бері доспыз➡
Dialogue: 0,0:10:26.45,0:10:29.46,Default,,0000,0000,0000,,Менің шашым сондай үлпілдек.
Dialogue: 0,0:10:26.45,0:10:29.46,Rubi,,0000,0000,0000,,Мотеги
Dialogue: 0,0:10:26.45,0:10:29.46,Default,,0000,0000,0000,,Мива Моги｡➡
Dialogue: 0,0:10:29.46,0:10:32.46,Default,,0000,0000,0000,,Көлденең жарлық болып табылады
Dialogue: 0,0:10:29.46,0:10:32.46,Rubi,,0000,0000,0000,,Ясуда
Dialogue: 0,0:10:29.46,0:10:32.46,Default,,0000,0000,0000,,Мисако Ясуда
Dialogue: 0,0:10:32.46,0:10:37.46,Default,,0000,0000,0000,,Біз драма үйірмесіне қосыламыз.
Dialogue: 0,0:10:32.46,0:10:37.46,Default,,0000,0000,0000,,Сіз де Манджоме-санға қосылғыңыз келе ме?
Dialogue: 0,0:10:37.46,0:10:40.40,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:10:37.46,0:10:40.40,Default,,0000,0000,0000,,Біз сөзге келе жатқан сияқтымыз.
Dialogue: 0,0:10:40.40,0:10:42.40,Default,,0000,0000,0000,,Енді не болады?
Dialogue: 0,0:10:42.40,0:10:46.41,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:10:42.40,0:10:46.41,Default,,0000,0000,0000,,Иә, бұл сәтсіздік.
Dialogue: 0,0:10:46.41,0:10:49.41,Default,,0000,0000,0000,,А, дым, қош бол
Dialogue: 0,0:10:49.41,0:10:54.41,Default,,0000,0000,0000,,О, таяқ, таяқ
Dialogue: 0,0:10:49.41,0:10:54.41,Default,,0000,0000,0000,,Бар, Пон-чан.➡
Dialogue: 0,0:10:54.41,0:10:57.42,Default,,0000,0000,0000,,О, мүмкін емес...
Dialogue: 0,0:10:57.42,0:11:00.42,Default,,0000,0000,0000,,Қосылу дұрыс па?
Dialogue: 0,0:10:57.42,0:11:00.42,Default,,0000,0000,0000,,Бұл жақсы болмады.
Dialogue: 0,0:11:00.42,0:11:03.42,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:11:00.42,0:11:03.42,Default,,0000,0000,0000,,Сонымен, сіз не туралы айттыңыз?
Dialogue: 0,0:11:03.42,0:11:07.43,Default,,0000,0000,0000,,Үйге қайтып келе жатқанда шайға шақырсам, жарайды деді.
Dialogue: 0,0:11:03.42,0:11:07.43,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:11:07.43,0:11:10.43,Default,,0000,0000,0000,,Сөйлесу кезіндегі ойлар
Dialogue: 0,0:11:07.43,0:11:10.43,Default,,0000,0000,0000,,Бір нәрсені өзгертуге болатын кездер болады.
Dialogue: 0,0:11:10.43,0:11:14.43,Default,,0000,0000,0000,,Осы түрлер үшін
Dialogue: 0,0:11:10.43,0:11:14.43,Default,,0000,0000,0000,,Мен оны көре алмаймын.
Dialogue: 0,0:11:16.44,0:11:19.44,Default,,0000,0000,0000,,《Мен мұны қайталадым》
Dialogue: 0,0:11:19.44,0:11:23.44,Default,,0000,0000,0000,,《Неліктен «ұнамайды» сөзі?
Dialogue: 0,0:11:19.44,0:11:23.44,Default,,0000,0000,0000,,Сіз айта алмайсыз деп ойлаймын.
Dialogue: 0,0:11:23.44,0:11:25.45,Default,,0000,0000,0000,,《Фуми-чан бұл
Dialogue: 0,0:11:23.44,0:11:25.45,Default,,0000,0000,0000,,Себебі сен оңай жылайсың》
Dialogue: 0,0:11:25.45,0:11:27.45,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:11:33.45,0:11:38.46,Default,,0000,0000,0000,,☎
Dialogue: 0,0:11:38.46,0:11:41.39,Rubi,,0000,0000,0000,,Окудаира
Dialogue: 0,0:11:38.46,0:11:41.39,Default,,0000,0000,0000,,Иә, бұл Окудайра.
Dialogue: 0,0:11:41.39,0:11:44.40,Default,,0000,0000,0000,,Не? Эх!
Dialogue: 0,0:11:44.40,0:11:47.40,Default,,0000,0000,0000,,Яда көптен бері көрмегелі!
Dialogue: 0,0:11:47.40,0:11:49.40,Default,,0000,0000,0000,,Шынымен бе? қашан?
Dialogue: 0,0:11:59.41,0:12:01.41,Rubi,,0000,0000,0000,,Казу
Dialogue: 0,0:11:59.41,0:12:01.41,Default,,0000,0000,0000,,Кадзу-чан
Dialogue: 0,0:11:59.41,0:12:01.41,Default,,0000,0000,0000,,Қайтару «Эспоирге» барайық
Dialogue: 0,0:12:01.41,0:12:03.42,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:12:01.41,0:12:03.42,Default,,0000,0000,0000,,Не? Бірдеңе дұрыс емес пе?
Dialogue: 0,0:12:03.42,0:12:05.42,Default,,0000,0000,0000,,≪(Кудо) Иә.
Dialogue: 0,0:12:03.42,0:12:05.42,Default,,0000,0000,0000,,Мен бір нәрсе туралы айтқым келеді.
Dialogue: 0,0:12:05.42,0:12:08.42,Default,,0000,0000,0000,,≪(Ямабуки) Эхе
Dialogue: 0,0:12:05.42,0:12:08.42,Default,,0000,0000,0000,,≪(Кудо) Тез барайық.
Dialogue: 0,0:12:10.42,0:12:13.43,Rubi,,0000,0000,0000,,Киоко
Dialogue: 0,0:12:10.42,0:12:13.43,Default,,0000,0000,0000,,≪(Киоко) Окухира-сан
Dialogue: 0,0:12:10.42,0:12:13.43,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:12:13.43,0:12:16.43,Default,,0000,0000,0000,,Акира Окудайра
Dialogue: 0,0:12:13.43,0:12:16.43,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:12:16.43,0:12:20.43,Default,,0000,0000,0000,,Бұл жақсы есім.
Dialogue: 0,0:12:16.43,0:12:20.43,Default,,0000,0000,0000,,Кете барсам, қоштасу сүйісін бересің бе?
Dialogue: 0,0:12:20.43,0:12:23.44,Rubi,,0000,0000,0000,,Икуми
Dialogue: 0,0:12:20.43,0:12:23.44,Default,,0000,0000,0000,,I, Киоко Игуми
Dialogue: 0,0:12:23.44,0:12:25.44,Default,,0000,0000,0000,,Танысқаныма қуаныштымын.
Dialogue: 0,0:12:25.44,0:12:30.44,Default,,0000,0000,0000,,Қыздар мектебіне ұқсайды!
Dialogue: 0,0:12:25.44,0:12:30.44,Default,,0000,0000,0000,,Бұл бала бастауыш мектептен бастап Фудзигая болды ма?
Dialogue: 0,0:12:30.44,0:12:36.45,Default,,0000,0000,0000,,Иә. Менің ойымша, бұл біраз сексуалды.
Dialogue: 0,0:12:30.44,0:12:36.45,Default,,0000,0000,0000,,Ханшайымға ұқсайтын адам
Dialogue: 0,0:12:36.45,0:12:40.45,Default,,0000,0000,0000,,Игуми: Киоко-чан ба?
Dialogue: 0,0:12:36.45,0:12:40.45,Default,,0000,0000,0000,,Егер жарасымды болсаң, мені де ала кел.
Dialogue: 0,0:12:40.45,0:12:44.46,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:12:40.45,0:12:44.46,Default,,0000,0000,0000,,«Бұл жақсы есім»...
Dialogue: 0,0:12:44.46,0:12:47.46,Default,,0000,0000,0000,,Қайтып келгенде
Dialogue: 0,0:12:44.46,0:12:47.46,Default,,0000,0000,0000,,«Жақсы көңіл-күй» демейсің бе?
Dialogue: 0,0:12:47.46,0:12:49.46,Default,,0000,0000,0000,,«Гокиё» болған жоқ➡
Dialogue: 0,0:12:49.46,0:12:52.47,Default,,0000,0000,0000,,Кіші
Dialogue: 0,0:12:49.46,0:12:52.47,Default,,0000,0000,0000,,Сіз мені «әпке» деп атадыңыз.
Dialogue: 0,0:12:52.47,0:12:56.47,Default,,0000,0000,0000,,О! Таңғажайып Фудзигая
Dialogue: 0,0:12:52.47,0:12:56.47,Default,,0000,0000,0000,,Сіз жүзіп жатқан жоқсыз ба?
Dialogue: 0,0:12:56.47,0:13:00.47,Default,,0000,0000,0000,,Ух... бұл қалқып тұрған жоқ! Мүмкін...
Dialogue: 0,0:12:56.47,0:13:00.47,Default,,0000,0000,0000,,Мүмкін
Dialogue: 0,0:13:00.47,0:13:04.48,Rubi,,0000,0000,0000,,Йошимичи
Dialogue: 0,0:13:00.47,0:13:04.48,Default,,0000,0000,0000,,Бұл орта мектептен.
Dialogue: 0,0:13:00.47,0:13:04.48,Default,,0000,0000,0000,,Себебі кіретін студенттер аз.➡
Dialogue: 0,0:13:04.48,0:13:09.48,Default,,0000,0000,0000,,Бұл кішкене жалғыздық болуы мүмкін, бірақ
Dialogue: 0,0:13:04.48,0:13:09.48,Default,,0000,0000,0000,,Достар тапқанша сабырлы бол.
Dialogue: 0,0:13:09.48,0:13:11.48,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:13:09.48,0:13:11.48,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:11.48,0:13:16.48,Default,,0000,0000,0000,,《Дос...
Dialogue: 0,0:13:11.48,0:13:16.48,Default,,0000,0000,0000,,Енді ойлап қарасам, Кесадағы бала...》
Dialogue: 0,0:13:18.49,0:13:21.49,Default,,0000,0000,0000,,《Тағы кездесеміз бе...》
Dialogue: 0,0:13:21.49,0:13:23.50,Default,,0000,0000,0000,,≪
Dialogue: 0,0:13:21.49,0:13:23.50,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:13:23.50,0:13:26.50,Default,,0000,0000,0000,,Ей, келдің.
Dialogue: 0,0:13:23.50,0:13:26.50,Default,,0000,0000,0000,,Менің қонағым?
Dialogue: 0,0:13:26.50,0:13:30.50,Default,,0000,0000,0000,,≪(Сакико) Иә, а, мен көптен күттім!
Dialogue: 0,0:13:26.50,0:13:30.50,Default,,0000,0000,0000,,Жоқ, ол ашық...
Dialogue: 0,0:13:30.50,0:13:32.51,Default,,0000,0000,0000,,Бұл емес.
Dialogue: 0,0:13:32.51,0:13:35.51,Default,,0000,0000,0000,,Мен?
Dialogue: 0,0:13:32.51,0:13:35.51,Default,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:13:35.51,0:13:38.51,Default,,0000,0000,0000,,Мен және А Чан
Dialogue: 0,0:13:35.51,0:13:38.51,Default,,0000,0000,0000,,Құрметті тұтынушылар
Dialogue: 0,0:13:38.51,0:13:40.45,Default,,0000,0000,0000,,Иә? Мен де?
Dialogue: 0,0:13:40.45,0:13:45.45,Default,,0000,0000,0000,,Ах! Көптен бері көрмеген
Dialogue: 0,0:13:40.45,0:13:45.45,Default,,0000,0000,0000,,Рас! Біраз уақыт өтті
Dialogue: 0,0:13:45.45,0:13:48.45,Default,,0000,0000,0000,,Қалай болдыңыз?
Dialogue: 0,0:13:45.45,0:13:48.45,Default,,0000,0000,0000,,Генки Генки!
Dialogue: 0,0:13:50.46,0:13:52.46,Default,,0000,0000,0000,,А-чан?
Dialogue: 0,0:13:50.46,0:13:52.46,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:58.45,0:14:01.45,Default,,0000,0000,0000,,《Иә? Бұл біртүрлі...》
Dialogue: 0,0:14:01.45,0:14:04.46,Default,,0000,0000,0000,,《Не болды? 》
Dialogue: 0,0:14:01.45,0:14:04.46,Default,,0000,0000,0000,,《Қарандаш жоқ》
Dialogue: 0,0:14:04.46,0:14:07.46,Default,,0000,0000,0000,,《Не, ұмытып қалдың ба?
Dialogue: 0,0:14:04.46,0:14:07.46,Default,,0000,0000,0000,,Мұғалім сені ұрсады》
Dialogue: 0,0:14:07.46,0:14:12.47,Default,,0000,0000,0000,,《Жоқ, жоқ, ұмытпа
Dialogue: 0,0:14:07.46,0:14:12.47,Default,,0000,0000,0000,,Мен оны кеше мектепте қалдырдым》
Dialogue: 0,0:14:12.47,0:14:15.47,Default,,0000,0000,0000,,《Оны артта қалдыруға болмайды.
Dialogue: 0,0:14:12.47,0:14:15.47,Default,,0000,0000,0000,,Мұғалім айтты》
Dialogue: 0,0:14:15.47,0:14:17.47,Default,,0000,0000,0000,,《О, шынымен бе? 》
Dialogue: 0,0:14:17.47,0:14:19.47,Default,,0000,0000,0000,,(Балалар)
Dialogue: 0,0:14:17.47,0:14:19.47,Default,,0000,0000,0000,,《Сонымен оны қайда қойдыңыз? 》
Dialogue: 0,0:14:19.47,0:14:21.47,Default,,0000,0000,0000,,《Сіз мұны түсінбейсіз.》
Dialogue: 0,0:14:21.47,0:14:24.48,Default,,0000,0000,0000,,《Аа-чан, бұл қиын!
Dialogue: 0,0:14:21.47,0:14:24.48,Default,,0000,0000,0000,,Фуми-чан! 》
Dialogue: 0,0:14:24.48,0:14:26.48,Default,,0000,0000,0000,,《Аа》
Dialogue: 0,0:14:26.48,0:14:28.48,Default,,0000,0000,0000,,《Қайда? 》
Dialogue: 0,0:14:26.48,0:14:28.48,Default,,0000,0000,0000,,《Дәліз》
Dialogue: 0,0:14:28.48,0:14:30.48,Default,,0000,0000,0000,,《А-чан, мынау! 》
Dialogue: 0,0:14:32.49,0:14:38.49,Default,,0000,0000,0000,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:14:38.49,0:14:40.49,Default,,0000,0000,0000,,《А-чан! 》
Dialogue: 0,0:14:40.49,0:14:43.50,Default,,0000,0000,0000,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:14:43.50,0:14:46.50,Default,,0000,0000,0000,,《А...》
Dialogue: 0,0:14:43.50,0:14:46.50,Default,,0000,0000,0000,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:14:46.50,0:14:48.50,Default,,0000,0000,0000,,《Фуми-чан》
Dialogue: 0,0:14:50.50,0:14:54.51,Default,,0000,0000,0000,,《Мен үйге жеткенше
Dialogue: 0,0:14:50.50,0:14:54.51,Default,,0000,0000,0000,,Құрғақ, кейінірек оралыңыз.
Dialogue: 0,0:14:54.51,0:14:57.44,Default,,0000,0000,0000,,《Иә
Dialogue: 0,0:14:54.51,0:14:57.44,Default,,0000,0000,0000,,Рахмет》
Dialogue: 0,0:14:57.44,0:14:59.44,Default,,0000,0000,0000,,《Рахмет...》
Dialogue: 0,0:15:09.46,0:15:13.46,Default,,0000,0000,0000,,Ауылдың қарапайым адамдары көбейіп кеткен сияқты.
Dialogue: 0,0:15:09.46,0:15:13.46,Default,,0000,0000,0000,,《А-чан, ашуландың ба? 》
Dialogue: 0,0:15:13.46,0:15:15.46,Default,,0000,0000,0000,,《Мен ашуланбаймын》
Dialogue: 0,0:15:15.46,0:15:22.47,Default,,0000,0000,0000,,《Тағы кездескенше. Фуми-чан бұл
Dialogue: 0,0:15:15.46,0:15:22.47,Default,,0000,0000,0000,,Жақында жылайсың. Жүр, кеттік.
Dialogue: 0,0:15:22.47,0:15:24.47,Default,,0000,0000,0000,,Жоқ, ол емес. Жасырынған орын. Жасырынған орын ба?
Dialogue: 0,0:15:24.47,0:15:27.47,Default,,0000,0000,0000,,＜Менің үйім жақын жерде болды.
Dialogue: 0,0:15:24.47,0:15:27.47,Default,,0000,0000,0000,,Мен және Фуми-чан➡
Dialogue: 0,0:15:27.47,0:15:30.48,Default,,0000,0000,0000,,Біз әрқашан бірге болдық＞
Dialogue: 0,0:15:30.48,0:15:34.48,Default,,0000,0000,0000,,<Сол бастауыш мектепке түсіп, бұдан былай жалғастыру
Dialogue: 0,0:15:30.48,0:15:34.48,Default,,0000,0000,0000,,Біз мәңгі бірге болдық➡
Dialogue: 0,0:15:34.48,0:15:36.48,Default,,0000,0000,0000,,Мен солай ойладым＞
Dialogue: 0,0:15:39.49,0:15:41.49,Default,,0000,0000,0000,,《Мен жалғыз қаламын.➡
Dialogue: 0,0:15:41.49,0:15:45.49,Default,,0000,0000,0000,,Екінші курс студенттері бір сыныпта оқиды.
Dialogue: 0,0:15:41.49,0:15:45.49,Default,,0000,0000,0000,,Мен мұны істей аламын деп ойладым》
Dialogue: 0,0:15:45.49,0:15:49.50,Default,,0000,0000,0000,,《Иә.
Dialogue: 0,0:15:45.49,0:15:49.50,Default,,0000,0000,0000,,Бірақ бұл дұрыс болды.➡
Dialogue: 0,0:15:49.50,0:15:52.50,Default,,0000,0000,0000,,Бұл үй де
Dialogue: 0,0:15:49.50,0:15:52.50,Default,,0000,0000,0000,,Өйткені біз қайта құруға тура келді》
Dialogue: 0,0:15:52.50,0:15:54.50,Default,,0000,0000,0000,,《О, шынымен бе? 》
Dialogue: 0,0:15:54.50,0:15:56.52,Default,,0000,0000,0000,,《Әжемен
Dialogue: 0,0:15:54.50,0:15:56.52,Default,,0000,0000,0000,,Біз бір жастамыз》
Dialogue: 0,0:15:56.52,0:15:59.44,Default,,0000,0000,0000,,《Әлі жоқ
Dialogue: 0,0:15:56.52,0:15:59.44,Default,,0000,0000,0000,,Қайта құрудың қажеті жоқ.
Dialogue: 0,0:15:59.44,0:16:01.44,Default,,0000,0000,0000,,《Hehehe》
Dialogue: 0,0:15:59.44,0:16:01.44,Default,,0000,0000,0000,,《Айтпақшы, Фуми ше? 》
Dialogue: 0,0:16:01.44,0:16:03.44,Default,,0000,0000,0000,,《Аа-чан және саябақ.➡
Dialogue: 0,0:16:03.44,0:16:07.45,Default,,0000,0000,0000,,Шынымен, Фуми А-чанға қатысты.
Dialogue: 0,0:16:03.44,0:16:07.45,Default,,0000,0000,0000,,Олар бір-біріне жабысады...》
Dialogue: 0,0:16:07.45,0:16:11.45,Default,,0000,0000,0000,,《Ал, бүгін.
Dialogue: 0,0:16:07.45,0:16:11.45,Default,,0000,0000,0000,,Бұл жақсы емес пе? Бұл соңғы рет.
Dialogue: 0,0:16:11.45,0:16:13.45,Default,,0000,0000,0000,,《А...》
Dialogue: 0,0:16:13.45,0:16:18.46,Default,,0000,0000,0000,,《Мен саған хат жазамын... Сөзсіз...》
Dialogue: 0,0:16:18.46,0:16:22.46,Default,,0000,0000,0000,,Жоқ, ол емес. Жасырынған орын. Жасырынған орын ба?
Dialogue: 0,0:16:18.46,0:16:22.46,Default,,0000,0000,0000,,《А-чан туралы да жазыңыз》
Dialogue: 0,0:16:22.46,0:16:26.47,Default,,0000,0000,0000,,《Иә, мен жазамын.
Dialogue: 0,0:16:22.46,0:16:26.47,Default,,0000,0000,0000,,Ендеше қазір жылауды доғар.
Dialogue: 0,0:16:26.47,0:16:28.47,Default,,0000,0000,0000,,《Мен үлгі тұтқан Косэй Арима》
Dialogue: 0,0:16:28.47,0:16:33.47,Default,,0000,0000,0000,,《Шынымен, Фуми-чан?
Dialogue: 0,0:16:28.47,0:16:33.47,Default,,0000,0000,0000,,Себебі сен оңай жылайсың》
Dialogue: 0,0:16:33.47,0:16:36.48,Default,,0000,0000,0000,,<Мен ешқашан хат жазған емеспін>
Dialogue: 0,0:16:36.48,0:16:39.48,Default,,0000,0000,0000,,<Фуми-чаннан
Dialogue: 0,0:16:36.48,0:16:39.48,Default,,0000,0000,0000,,Сіз...＞ ала аласыз
Dialogue: 0,0:16:46.49,0:16:49.49,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:49.49,0:16:51.49,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:16:51.49,0:16:54.49,Default,,0000,0000,0000,,Жоқ, бұл Фуми-чан емес деп ойлаймын.\NМен
Dialogue: 0,0:16:51.49,0:16:54.49,Default,,0000,0000,0000,,деп ойладым
Dialogue: 0,0:16:54.49,0:16:57.43,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:54.49,0:16:57.43,Default,,0000,0000,0000,,Өйткені
Dialogue: 0,0:16:57.43,0:16:59.43,Default,,0000,0000,0000,,Міне, биіктік айырмашылығы!
Dialogue: 0,0:16:59.43,0:17:03.44,Default,,0000,0000,0000,,Өткенде
Dialogue: 0,0:16:59.43,0:17:03.44,Default,,0000,0000,0000,,Мен үлкенірек болсам да.
Dialogue: 0,0:17:03.44,0:17:05.44,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:17:03.44,0:17:05.44,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:17:05.44,0:17:07.44,Default,,0000,0000,0000,,Сіздің кеудеңіз көп емес.
Dialogue: 0,0:17:07.44,0:17:10.44,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:17:07.44,0:17:10.44,Default,,0000,0000,0000,,Әй, қорқынышты бет
Dialogue: 0,0:17:10.44,0:17:14.44,Default,,0000,0000,0000,,Менде жоқ.
Dialogue: 0,0:17:10.44,0:17:14.44,Default,,0000,0000,0000,,Жоқ, айттыңыз. Сіз қорқынышты көріндіңіз.
Dialogue: 0,0:17:19.45,0:17:22.46,Default,,0000,0000,0000,,(Ёши)
Dialogue: 0,0:17:19.45,0:17:22.46,Default,,0000,0000,0000,,Иә, мен ақыры тынышталдым.➡
Dialogue: 0,0:17:22.46,0:17:25.46,Default,,0000,0000,0000,,Танысыма
Dialogue: 0,0:17:22.46,0:17:25.46,Default,,0000,0000,0000,,Мен сәлемімді айттым.
Dialogue: 0,0:17:25.46,0:17:29.46,Default,,0000,0000,0000,,Чизу-чан?
Dialogue: 0,0:17:25.46,0:17:29.46,Default,,0000,0000,0000,,Мен Фумимен екінші қабатта сөйлесіп жатырмын.➡
Dialogue: 0,0:17:29.46,0:17:33.47,Default,,0000,0000,0000,,Әпке, сіз мені ауыстырасыз ба? Жарайды ма?
Dialogue: 0,0:17:33.47,0:17:38.47,Default,,0000,0000,0000,,Сәлем. Сіз кездестірдіңіз бе?
Dialogue: 0,0:17:33.47,0:17:38.47,Default,,0000,0000,0000,,Кейде сирек кездеседі.
Dialogue: 0,0:17:38.47,0:17:41.47,Default,,0000,0000,0000,,Мен оны мүлде байқамадым
Dialogue: 0,0:17:38.47,0:17:41.47,Default,,0000,0000,0000,,Әрине
Dialogue: 0,0:17:41.47,0:17:44.48,Default,,0000,0000,0000,,О, біз жақсы дос едік, солай ма?
Dialogue: 0,0:17:44.48,0:17:46.48,Default,,0000,0000,0000,,Бұл менің кішкентай кезімдегі оқиға.
Dialogue: 0,0:17:46.48,0:17:49.48,Default,,0000,0000,0000,,Тіпті сол жерде
Dialogue: 0,0:17:46.48,0:17:49.48,Default,,0000,0000,0000,,Себебі мен байқамадым.
Dialogue: 0,0:17:49.48,0:17:56.51,Default,,0000,0000,0000,,Міне, көп жыл болды.
Dialogue: 0,0:17:49.48,0:17:56.51,Default,,0000,0000,0000,,Қазір екеуміз де ересекпіз.
Dialogue: 0,0:17:56.51,0:17:58.42,Default,,0000,0000,0000,,«Менде кеуде жоқ»
Dialogue: 0,0:17:56.51,0:17:58.42,Default,,0000,0000,0000,,Маған айтты
Dialogue: 0,0:17:58.42,0:18:03.43,Default,,0000,0000,0000,,Уфуфу…｡ Фуми-чанның
Dialogue: 0,0:17:58.42,0:18:03.43,Default,,0000,0000,0000,,Ол кішкентай, бірақ пішіні жақсы.
Dialogue: 0,0:18:03.43,0:18:06.43,Default,,0000,0000,0000,,Қазірдің өзінде! Мұны бірден жасаңыз ...
Dialogue: 0,0:18:03.43,0:18:06.43,Default,,0000,0000,0000,,Хехе...
Dialogue: 0,0:18:13.44,0:18:15.44,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:18:21.45,0:18:23.45,Default,,0000,0000,0000,,≪(Ёши) Чизу-чан
Dialogue: 0,0:18:23.45,0:18:27.45,Default,,0000,0000,0000,,Қарсы боласыз ба?
Dialogue: 0,0:18:23.45,0:18:27.45,Default,,0000,0000,0000,,Фуми-чан да келіңізші.
Dialogue: 0,0:18:27.45,0:18:31.46,Default,,0000,0000,0000,,Біз оқиға орнына бірінші жетеміз.
Dialogue: 0,0:18:27.45,0:18:31.46,Default,,0000,0000,0000,,Сіз осындай нәрсе дайындадыңыз ба?
Dialogue: 0,0:18:31.46,0:18:33.46,Default,,0000,0000,0000,,Келесі жолы мен келемін
Dialogue: 0,0:18:31.46,0:18:33.46,Default,,0000,0000,0000,,Күйеуім де қасымда.
Dialogue: 0,0:18:33.46,0:18:35.46,Default,,0000,0000,0000,,Иә! рахмет
Dialogue: 0,0:18:35.46,0:18:38.46,Default,,0000,0000,0000,,Жүр, Фуми-чан, сен де келіп тамақтан.
Dialogue: 0,0:18:44.47,0:18:46.47,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:18:48.47,0:18:50.48,Default,,0000,0000,0000,,Ах... Юрико... Мұнда мен үшін орын жоқ па?
Dialogue: 0,0:18:50.48,0:18:53.48,Default,,0000,0000,0000,,Бүгін де
Dialogue: 0,0:18:50.48,0:18:53.48,Default,,0000,0000,0000,,Мен оны сізге жібермек болдым...
Dialogue: 0,0:18:53.48,0:18:55.48,Default,,0000,0000,0000,,Сіздің университетіңіз туралы не айтасыз?
Dialogue: 0,0:18:53.48,0:18:55.48,Default,,0000,0000,0000,,Демалыс
Dialogue: 0,0:18:55.48,0:19:00.42,Default,,0000,0000,0000,,Жұмыс іздеу мүлдем жоқ.
Dialogue: 0,0:18:55.48,0:19:00.42,Default,,0000,0000,0000,,Ол басталғаннан кейін бос емес болады.
Dialogue: 0,0:19:00.42,0:19:02.42,Default,,0000,0000,0000,,Алда не күтіп тұр...
Dialogue: 0,0:19:02.42,0:19:05.42,Default,,0000,0000,0000,,Сіз алаңсыз позицияны ұстанған кезде
Dialogue: 0,0:19:02.42,0:19:05.42,Default,,0000,0000,0000,,Бұл өте тез өтеді.➡
Dialogue: 0,0:19:05.42,0:19:09.43,Default,,0000,0000,0000,,Әпкеңе қамқорлық жасауға мән берме.
Dialogue: 0,0:19:05.42,0:19:09.43,Default,,0000,0000,0000,,Мұқият ойлан
Dialogue: 0,0:19:09.43,0:19:12.43,Default,,0000,0000,0000,,Үлкен аға сіңлісін уайымдайды.
Dialogue: 0,0:19:09.43,0:19:12.43,Default,,0000,0000,0000,,Әрине!
Dialogue: 0,0:19:12.43,0:19:14.43,Default,,0000,0000,0000,,италиялықтарға тән —
Dialogue: 0,0:19:14.43,0:19:17.44,Default,,0000,0000,0000,,Мен сені жақсы көремін.
Dialogue: 0,0:19:14.43,0:19:17.44,Default,,0000,0000,0000,,Мен қатты уайымдап тұрмын.
Dialogue: 0,0:19:17.44,0:19:37.46,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:19:37.46,0:19:43.46,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:19:43.46,0:19:46.47,Default,,0000,0000,0000,,(Порнарефф) Не дедің!? Жынды! Аузыңды жап!
Dialogue: 0,0:19:43.46,0:19:46.47,Default,,0000,0000,0000,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:19:46.47,0:19:48.47,Default,,0000,0000,0000,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:19:51.47,0:19:55.47,Default,,0000,0000,0000,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:19:55.47,0:19:58.41,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:19:58.41,0:20:00.41,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:20:00.41,0:20:02.41,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:20:06.42,0:20:09.42,Default,,0000,0000,0000,,Ах, Фуми-чан
Dialogue: 0,0:20:16.43,0:20:18.43,Default,,0000,0000,0000,,《Иә... дұрыс》
Dialogue: 0,0:20:20.43,0:20:23.44,Default,,0000,0000,0000,,《Менің немере ағам...》
Dialogue: 0,0:20:23.44,0:20:26.44,Default,,0000,0000,0000,,《Әйел ретінде...》
Dialogue: 0,0:20:26.44,0:20:30.44,Default,,0000,0000,0000,,《Бұл анық...》
Dialogue: 0,0:20:30.44,0:20:33.44,Default,,0000,0000,0000,,Фуми-чан! Ах...
Dialogue: 0,0:20:35.45,0:20:38.45,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:20:38.45,0:20:40.45,Default,,0000,0000,0000,,(Порнарефф) Не дедің!? Жынды! Аузыңды жап!
Dialogue: 0,0:20:46.46,0:20:48.46,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:20:50.46,0:20:52.47,Default,,0000,0000,0000,,Фуми-чан оңай жылайды
Dialogue: 0,0:20:52.47,0:20:54.47,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:00.41,0:21:06.41,Default,,0000,0000,0000,,<Бұл сөз
Dialogue: 0,0:21:00.41,0:21:06.41,Default,,0000,0000,0000,,10 жыл оңай зымырап өтті >
Dialogue: 0,0:21:11.42,0:21:16.42,Default,,0000,0000,0000,,♬『Centifolia』
