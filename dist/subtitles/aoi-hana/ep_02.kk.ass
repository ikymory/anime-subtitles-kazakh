Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.37,0:00:04.37,Default,,0,0,0,,《Фуми-чан! Ах...》
Dialogue: 0,0:00:07.37,0:00:09.37,Default,,0,0,0,,《А...》
Dialogue: 0,0:00:09.37,0:00:12.38,Default,,0,0,0,,《Фуми-чан бұл
Dialogue: 0,0:00:09.37,0:00:12.38,Default,,0,0,0,,Себебі сен оңай жылайсың》
Dialogue: 0,0:00:12.38,0:00:17.38,Default,,0,0,0,,Көк
Dialogue: 0,0:00:12.38,0:00:17.38,Default,,0,0,0,,3D маневрлік жабдықтың табиғи жауы.
Dialogue: 0,0:00:12.38,0:00:17.38,Default,,0,0,0,,♬『Көк гүл』
Dialogue: 0,0:00:17.38,0:00:37.40,Default,,0,0,0,,♬～
Dialogue: 0,0:00:37.40,0:00:46.41,Default,,0,0,0,,♬～
Dialogue: 0,0:00:46.41,0:01:06.36,Default,,0,0,0,,♬～
Dialogue: 0,0:01:06.36,0:01:26.38,Default,,0,0,0,,♬～
Dialogue: 0,0:01:26.38,0:01:40.38,Default,,0,0,0,,♬～
Dialogue: 0,0:01:49.37,0:01:51.37,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:01:49.37,0:01:51.37,Default,,0,0,0,,Асығыңыз! мен мінемін
Dialogue: 0,0:01:51.37,0:01:53.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:53.38,0:01:55.38,Default,,0,0,0,,≪
Dialogue: 0,0:02:08.39,0:02:10.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:14.40,0:02:18.40,Default,,0,0,0,,Қараңыз. Ол ұйықтап жатыр.
Dialogue: 0,0:02:14.40,0:02:18.40,Default,,0,0,0,,Эй, сен сүйкімдісің.
Dialogue: 0,0:02:18.40,0:02:21.40,Default,,0,0,0,,《Фуми-чан, қара! 》
Dialogue: 0,0:02:27.41,0:02:29.41,Default,,0,0,0,,Ах
Dialogue: 0,0:02:32.42,0:02:34.42,Default,,0,0,0,,Ах
Dialogue: 0,0:02:34.42,0:02:48.37,Default,,0,0,0,,♬～
Dialogue: 0,0:02:48.37,0:02:51.37,Default,,0,0,0,,Жолда да, қайтарда да кездескенімізге сене алар емеспін.
Dialogue: 0,0:02:48.37,0:02:51.37,Default,,0,0,0,,Қандай кездейсоқтық!
Dialogue: 0,0:02:51.37,0:02:53.37,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:02:53.37,0:02:57.37,Default,,0,0,0,,Мектепке баратын жол дерлік бірдей.
Dialogue: 0,0:02:53.37,0:02:57.37,Default,,0,0,0,,Бұл анық па?
Dialogue: 0,0:02:59.38,0:03:02.38,Default,,0,0,0,,Фудзи
Dialogue: 0,0:02:59.38,0:03:02.38,Default,,0,0,0,,Мен бас тартқан адамдардың бәрі бірден жойылды
Dialogue: 0,0:02:59.38,0:03:02.38,Default,,0,0,0,,Эй, Фудзигая қандай жер?
Dialogue: 0,0:02:59.38,0:03:02.38,Default,,0,0,0,,Не?
Dialogue: 0,0:03:02.38,0:03:05.38,Default,,0,0,0,,... мектеп ғимараты т.б.
Dialogue: 0,0:03:02.38,0:03:05.38,Default,,0,0,0,,О
Dialogue: 0,0:03:05.38,0:03:10.39,Default,,0,0,0,,Мектеп ғимараты ескі, ағаштан жасалған.
Dialogue: 0,0:03:05.38,0:03:10.39,Default,,0,0,0,,Бұл керемет атмосфера
Dialogue: 0,0:03:10.39,0:03:14.39,Default,,0,0,0,,Сондай-ақ часовня бар.
Dialogue: 0,0:03:10.39,0:03:14.39,Default,,0,0,0,,Кітапханада ағаштан жасалған кітап сөрелері бар.
Dialogue: 0,0:03:14.39,0:03:16.39,Default,,0,0,0,,Әй, әдемі көрінеді.
Dialogue: 0,0:03:16.39,0:03:19.40,Default,,0,0,0,,Мацуока
Dialogue: 0,0:03:16.39,0:03:19.40,Default,,0,0,0,,Мацуока ше?
Dialogue: 0,0:03:16.39,0:03:19.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:19.40,0:03:23.40,Default,,0,0,0,,Мм... кәдімгі мектеп... Менің ойымша.
Dialogue: 0,0:03:23.40,0:03:25.40,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:03:25.40,0:03:27.40,Default,,0,0,0,,Уау, олар керемет көрінеді!
Dialogue: 0,0:03:34.41,0:03:37.41,Default,,0,0,0,,Сәлем. Ертең бірге барамыз ба?
Dialogue: 0,0:03:37.41,0:03:40.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:37.41,0:03:40.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:40.42,0:03:42.42,Default,,0,0,0,,Иә
Dialogue: 0,0:03:44.35,0:03:46.36,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:03:46.36,0:03:48.36,Default,,0,0,0,,Йоши
Dialogue: 0,0:03:46.36,0:03:48.36,Default,,0,0,0,,≪(Ёши) Қайтадан қош келдіңіз.➡
Dialogue: 0,0:03:48.36,0:03:52.36,Default,,0,0,0,,Ах Фуми. Ах-чан Охаги
Dialogue: 0,0:03:48.36,0:03:52.36,Default,,0,0,0,,Сізге ұнады деп ойлаймын➡
Dialogue: 0,0:03:52.36,0:03:55.37,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:03:55.37,0:03:59.37,Default,,0,0,0,,Шынында да солай емес пе?
Dialogue: 0,0:03:55.37,0:03:59.37,Default,,0,0,0,,Неліктен бұлай сұрайсыз?
Dialogue: 0,0:03:59.37,0:04:02.37,Default,,0,0,0,,Басқа күннің орнына
Dialogue: 0,0:03:59.37,0:04:02.37,Default,,0,0,0,,Сакико
Dialogue: 0,0:03:59.37,0:04:02.37,Default,,0,0,0,,Мен Сакико мен А-чанға қоңырау шалдым.➡
Dialogue: 0,0:04:02.37,0:04:05.38,Default,,0,0,0,,Мен сені сүйгеніме сенімдімін
Dialogue: 0,0:04:02.37,0:04:05.38,Default,,0,0,0,,Менің ойымша...｡➡
Dialogue: 0,0:04:05.38,0:04:08.38,Default,,0,0,0,,Сәлем саған
Dialogue: 0,0:04:05.38,0:04:08.38,Default,,0,0,0,,Есіңізде жоқ екеніне сенімдісіз бе?
Dialogue: 0,0:04:12.38,0:04:17.39,Default,,0,0,0,,《А-чанға не ұнайды
Dialogue: 0,0:04:12.38,0:04:17.39,Default,,0,0,0,,Не? 》
Dialogue: 0,0:04:17.39,0:04:19.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:24.39,0:04:28.39,Default,,0,0,0,,Чизу
Dialogue: 0,0:04:24.39,0:04:28.39,Default,,0,0,0,,Мен Чизу-чанмен тәттілерді жиі дайындайтынмын.
Dialogue: 0,0:04:30.40,0:04:35.40,Default,,0,0,0,,Ах, а... тағы да. Ах...
Dialogue: 0,0:04:37.41,0:04:39.41,Default,,0,0,0,,《О, орамал》
Dialogue: 0,0:04:42.43,0:04:46.35,Default,,0,0,0,,Ех! Неге мазалау керек?
Dialogue: 0,0:04:42.43,0:04:46.35,Default,,0,0,0,,Мен оны жуудың қажеті жоқ еді.
Dialogue: 0,0:04:46.35,0:04:49.35,Default,,0,0,0,,Сен өте жақсысың, Фуми-чан
Dialogue: 0,0:04:49.35,0:04:53.36,Default,,0,0,0,,Эй, А-чан, сен охагимен жақсысың ба?
Dialogue: 0,0:04:53.36,0:04:56.36,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:04:53.36,0:04:56.36,Default,,0,0,0,,Йоши апай жасаған Охаги➡
Dialogue: 0,0:04:56.36,0:04:59.36,Default,,0,0,0,,Маған ұнады
Dialogue: 0,0:04:59.36,0:05:01.36,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:05:01.36,0:05:05.37,Default,,0,0,0,,Ана керемет
Dialogue: 0,0:05:01.36,0:05:05.37,Default,,0,0,0,,Мүлдем есімде жоқ
Dialogue: 0,0:05:05.37,0:05:08.37,Default,,0,0,0,,Қорқынышты
Dialogue: 0,0:05:05.37,0:05:08.37,Default,,0,0,0,,Фуми-чан, себебі мен Анконы жек көремін➡
Dialogue: 0,0:05:08.37,0:05:12.38,Default,,0,0,0,,Фуми-чанға арналған
Dialogue: 0,0:05:08.37,0:05:12.38,Default,,0,0,0,,Мен оны жедім.
Dialogue: 0,0:05:12.38,0:05:15.38,Default,,0,0,0,,Бұл болды ма?
Dialogue: 0,0:05:12.38,0:05:15.38,Default,,0,0,0,,Мм. Бұл дұрыс.
Dialogue: 0,0:05:15.38,0:05:18.38,Default,,0,0,0,,Фуми-чанның әжесі
Dialogue: 0,0:05:15.38,0:05:18.38,Default,,0,0,0,,Өте қорқынышты➡
Dialogue: 0,0:05:18.38,0:05:22.39,Default,,0,0,0,,Мен оны тастап кетсем, мені ашуландыратын нәрсе.
Dialogue: 0,0:05:18.38,0:05:22.39,Default,,0,0,0,,Ах
Dialogue: 0,0:05:22.39,0:05:25.39,Default,,0,0,0,,《Ғажайып…》
Dialogue: 0,0:05:25.39,0:05:29.39,Default,,0,0,0,,《Мен оны ішуім керек.
Dialogue: 0,0:05:25.39,0:05:29.39,Default,,0,0,0,,Менің ішуім керек емес》
Dialogue: 0,0:05:29.39,0:05:33.40,Default,,0,0,0,,《Қойсаң... ұрысасың》
Dialogue: 0,0:05:33.40,0:05:38.40,Default,,0,0,0,,《Ол керексіз бала. Оны маған қарызға бер 》
Dialogue: 0,0:05:33.40,0:05:38.40,Default,,0,0,0,,Ауылдың қарапайым адамдары көбейіп кеткен сияқты.
Dialogue: 0,0:05:41.40,0:05:43.34,Default,,0,0,0,,《А-чан! Сенімен бәрі жақсы ма? 》
Dialogue: 0,0:05:43.34,0:05:46.34,Default,,0,0,0,,Уау
Dialogue: 0,0:05:46.34,0:05:50.35,Default,,0,0,0,,Ах! Бірдеңе есіме түсіп, күлемін
Dialogue: 0,0:05:46.34,0:05:50.35,Default,,0,0,0,,Не ол?
Dialogue: 0,0:05:50.35,0:05:52.35,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:05:55.35,0:05:57.35,Default,,0,0,0,,≪(Оқушы) Рахмет.
Dialogue: 0,0:05:57.35,0:06:00.35,Default,,0,0,0,,≪(Оқушылар) Рахмет.
Dialogue: 0,0:06:12.37,0:06:16.37,Default,,0,0,0,,Құрметпен айтсам, Басшының орынбасары,
Dialogue: 0,0:06:12.37,0:06:16.37,Default,,0,0,0,,Икуми
Dialogue: 0,0:06:12.37,0:06:16.37,Default,,0,0,0,,Игуми мырза, сіз не істеу керектігін шештіңіз бе?
Dialogue: 0,0:06:16.37,0:06:20.38,Default,,0,0,0,,Киоко
Dialogue: 0,0:06:16.37,0:06:20.38,Default,,0,0,0,,(Киоко)
Dialogue: 0,0:06:16.37,0:06:20.38,Default,,0,0,0,,Окудаира
Dialogue: 0,0:06:16.37,0:06:20.38,Default,,0,0,0,,Мен әлі жоқпын. Окудаира мырза ше?
Dialogue: 0,0:06:20.38,0:06:25.38,Default,,0,0,0,,Бірдеңе... жас ханым.
Dialogue: 0,0:06:20.38,0:06:25.38,Default,,0,0,0,,Мен клубқа қосылғым келеді.
Dialogue: 0,0:06:25.38,0:06:30.39,Default,,0,0,0,,Шай ішу үйірмесі мен гүл қою үйірмесі де жақсы.
Dialogue: 0,0:06:25.38,0:06:30.39,Default,,0,0,0,,Драма үйірмесі де жақсы.
Dialogue: 0,0:06:30.39,0:06:33.39,Default,,0,0,0,,Такаразука
Dialogue: 0,0:06:30.39,0:06:33.39,Default,,0,0,0,,Менің ойымша, бұл Такаразука сияқты...
Dialogue: 0,0:06:33.39,0:06:36.39,Default,,0,0,0,,Окудаира мырза сондай сүйкімді.
Dialogue: 0,0:06:36.39,0:06:39.39,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:36.39,0:06:39.39,Default,,0,0,0,,Адамдар мені «сүйкімді» деп атайтын!
Dialogue: 0,0:06:42.42,0:06:46.34,Default,,0,0,0,,Драма үйірмесі... Қызық көрінеді.
Dialogue: 0,0:06:46.34,0:06:49.34,Default,,0,0,0,,Йоко
Dialogue: 0,0:06:46.34,0:06:49.34,Default,,0,0,0,,Әрине қызықты! ➡
Dialogue: 0,0:06:49.34,0:06:53.34,Default,,0,0,0,,Мен бәрібір шешуім керек.
Dialogue: 0,0:06:49.34,0:06:53.34,Default,,0,0,0,,Ондай нәрсе жоқ. Сонымен... Ах!
Dialogue: 0,0:06:53.34,0:06:55.35,Default,,0,0,0,,Эй... Бір сәт ваннаға баруым керек...
Dialogue: 0,0:06:55.35,0:06:59.35,Default,,0,0,0,,(Йоко)
Dialogue: 0,0:06:55.35,0:06:59.35,Default,,0,0,0,,Манжоме
Dialogue: 0,0:06:55.35,0:06:59.35,Default,,0,0,0,,Не? Ах... Манжоме-сан! ➡
Dialogue: 0,0:06:59.35,0:07:01.35,Default,,0,0,0,,Иә...
Dialogue: 0,0:07:03.35,0:07:09.36,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:03.35,0:07:09.36,Default,,0,0,0,,Әйтеуір, мені осылай итеріп жіберетін сияқтымын.
Dialogue: 0,0:07:09.36,0:07:11.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:11.36,0:07:16.36,Default,,0,0,0,,Иә. Бірдеңе болса,
Dialogue: 0,0:07:11.36,0:07:16.36,Default,,0,0,0,,Мен мұны жақсы көремін...
Dialogue: 0,0:07:18.37,0:07:20.37,Default,,0,0,0,,Ясуко
Dialogue: 0,0:07:18.37,0:07:20.37,Default,,0,0,0,,Ах
Dialogue: 0,0:07:20.37,0:07:22.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:22.37,0:07:24.37,Default,,0,0,0,,Бірінші курс студенті?
Dialogue: 0,0:07:22.37,0:07:24.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:24.37,0:07:27.38,Default,,0,0,0,,Иә
Dialogue: 0,0:07:27.38,0:07:32.38,Default,,0,0,0,,Сіз ұзынсыз.
Dialogue: 0,0:07:27.38,0:07:32.38,Default,,0,0,0,,Иә. Рахмет сізге.
Dialogue: 0,0:07:32.38,0:07:34.38,Default,,0,0,0,,Мм!?➡
Dialogue: 0,0:07:34.38,0:07:36.38,Default,,0,0,0,,Ууу…
Dialogue: 0,0:07:38.39,0:07:40.39,Default,,0,0,0,,Сіз әлі клуб туралы шешім қабылдадыңыз ба?
Dialogue: 0,0:07:40.39,0:07:43.33,Default,,0,0,0,,Жоқ, мен әлі шешкен жоқпын.
Dialogue: 0,0:07:43.33,0:07:46.33,Default,,0,0,0,,Мерзім жақындап қалды
Dialogue: 0,0:07:43.33,0:07:46.33,Default,,0,0,0,,Сіз қобалжыдыңыз ба?
Dialogue: 0,0:07:46.33,0:07:48.33,Default,,0,0,0,,А... иә
Dialogue: 0,0:07:48.33,0:07:52.34,Default,,0,0,0,,Хехе
Dialogue: 0,0:07:48.33,0:07:52.34,Default,,0,0,0,,Қарсы болмасаң, менің үйіме келгің келе ме?
Dialogue: 0,0:07:52.34,0:07:54.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:58.34,0:08:00.34,Default,,0,0,0,,Әдебиет үйірмесі!?
Dialogue: 0,0:08:00.34,0:08:04.35,Default,,0,0,0,,Не, сен сол жерде шештің!
Dialogue: 0,0:08:00.34,0:08:04.35,Default,,0,0,0,,Сатқын
Dialogue: 0,0:08:04.35,0:08:06.35,Default,,0,0,0,,Кешіріңіз. Мен жай ғана...
Dialogue: 0,0:08:06.35,0:08:10.35,Default,,0,0,0,,Драма үйірмесін жеңгем деп алдым.
Dialogue: 0,0:08:06.35,0:08:10.35,Default,,0,0,0,,Аа, кешіріңіз, кешіріңіз.
Dialogue: 0,0:08:10.35,0:08:14.35,Default,,0,0,0,,Мива
Dialogue: 0,0:08:10.35,0:08:14.35,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:08:10.35,0:08:14.35,Default,,0,0,0,,Мисако
Dialogue: 0,0:08:10.35,0:08:14.35,Default,,0,0,0,,Тағдыр солай болды ма?
Dialogue: 0,0:08:16.36,0:08:21.36,Default,,0,0,0,,Әдебиет клубы?
Dialogue: 0,0:08:16.36,0:08:21.36,Default,,0,0,0,,Бұл Фуми-чанға жарамды болуы мүмкін.
Dialogue: 0,0:08:21.36,0:08:23.37,Default,,0,0,0,,Бұл аға қандай адам?
Dialogue: 0,0:08:23.37,0:08:27.37,Default,,0,0,0,,Адам кім болса да...
Dialogue: 0,0:08:30.37,0:08:33.38,Default,,0,0,0,,Өйткені біз тек бір рет кездестік
Dialogue: 0,0:08:30.37,0:08:33.38,Default,,0,0,0,,Хмм.
Dialogue: 0,0:08:33.38,0:08:35.38,Default,,0,0,0,,[Ұялы телефон] (пошта қоңырау үні)
Dialogue: 0,0:08:33.38,0:08:35.38,Default,,0,0,0,,Ах
Dialogue: 0,0:08:35.38,0:08:39.38,Default,,0,0,0,,А-чан, менде ұялы телефон бар.
Dialogue: 0,0:08:35.38,0:08:39.38,Default,,0,0,0,,Иә, мен оны кеше саған сатып алдым.
Dialogue: 0,0:08:39.38,0:08:42.40,Default,,0,0,0,,Иә
Dialogue: 0,0:08:39.38,0:08:42.40,Default,,0,0,0,,Мен қазір кетуім керек. Күте тұр!
Dialogue: 0,0:08:42.40,0:08:46.32,Default,,0,0,0,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:08:42.40,0:08:46.32,Default,,0,0,0,,Мен кенеттен бірдеңе жасайтын сияқтымын.
Dialogue: 0,0:08:46.32,0:08:51.33,Default,,0,0,0,,Мен көремін. Бірақ мұндай уақытта
Dialogue: 0,0:08:46.32,0:08:51.33,Default,,0,0,0,,Ұялы телефондар ыңғайлы.
Dialogue: 0,0:08:51.33,0:08:55.33,Default,,0,0,0,,Фуми-чан, оны да сатып алыңыз.
Dialogue: 0,0:08:51.33,0:08:55.33,Default,,0,0,0,,Электрондық пошта Жасайық
Dialogue: 0,0:08:55.33,0:08:57.33,Default,,0,0,0,,Дұрыс. Бұл сәл жақсы болуы мүмкін.
Dialogue: 0,0:08:57.33,0:09:00.34,Default,,0,0,0,,≪
Dialogue: 0,0:08:57.33,0:09:00.34,Default,,0,0,0,,≪(Ёши) Иә.➡
Dialogue: 0,0:09:00.34,0:09:03.34,Default,,0,0,0,,О, мен көптен күттім.
Dialogue: 0,0:09:00.34,0:09:03.34,Default,,0,0,0,,≪(Чизу) Кешіріңіз, кенеттен...
Dialogue: 0,0:09:03.34,0:09:05.34,Default,,0,0,0,,Кім?
Dialogue: 0,0:09:03.34,0:09:05.34,Default,,0,0,0,,≪(Ёши) Жоқ, бәрі жақсы.➡
Dialogue: 0,0:09:05.34,0:09:08.34,Default,,0,0,0,,Бұл әке?
Dialogue: 0,0:09:05.34,0:09:08.34,Default,,0,0,0,,≪(Күйеу) О, танысқаныма қуаныштымын.
Dialogue: 0,0:09:08.34,0:09:11.35,Default,,0,0,0,,≪(Ёши) Жарайды, ол жақсы адам емес.
Dialogue: 0,0:09:08.34,0:09:11.35,Default,,0,0,0,,Әзірше жоғары көтеріліңіз.
Dialogue: 0,0:09:11.35,0:09:13.35,Default,,0,0,0,,≪(Чизу/келіншек)
Dialogue: 0,0:09:11.35,0:09:13.35,Default,,0,0,0,,Иә. Сізді мазалағаным үшін кешіріңіз.
Dialogue: 0,0:09:13.35,0:09:17.35,Default,,0,0,0,,Фуми-чан! Чизу-чанмен
Dialogue: 0,0:09:13.35,0:09:17.35,Default,,0,0,0,,Әке, сіз маған керексіз➡
Dialogue: 0,0:09:17.35,0:09:19.36,Default,,0,0,0,,Келіңіздер, сәлемдесіңіздер.➡
Dialogue: 0,0:09:19.36,0:09:23.36,Default,,0,0,0,,А-чан. Футон - бұл
Dialogue: 0,0:09:19.36,0:09:23.36,Default,,0,0,0,,Мен оны ваннадан кейін дайындаймын.
Dialogue: 0,0:09:23.36,0:09:25.36,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:09:27.36,0:09:31.36,Default,,0,0,0,,А... Иә? Ах
Dialogue: 0,0:09:33.37,0:09:37.37,Default,,0,0,0,,Чизу-чан қорқынышты
Dialogue: 0,0:09:39.38,0:09:41.38,Default,,0,0,0,,Қорқынышты...
Dialogue: 0,0:09:39.38,0:09:41.38,Default,,0,0,0,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:09:41.38,0:09:43.31,Default,,0,0,0,,Ах аа
Dialogue: 0,0:09:43.31,0:09:46.32,Default,,0,0,0,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:09:46.32,0:09:51.32,Default,,0,0,0,,Фуми-чан. Не болды?
Dialogue: 0,0:09:46.32,0:09:51.32,Default,,0,0,0,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:09:51.32,0:09:54.32,Default,,0,0,0,,О, жарайды...
Dialogue: 0,0:09:54.32,0:10:01.33,Default,,0,0,0,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:10:01.33,0:10:03.33,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:10:11.34,0:10:14.34,Default,,0,0,0,,А-чан
Dialogue: 0,0:10:11.34,0:10:14.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:14.34,0:10:18.35,Default,,0,0,0,,Аа-чан, мұнда да ұйықта.
Dialogue: 0,0:10:18.35,0:10:21.35,Default,,0,0,0,,Жарайды, бірақ
Dialogue: 0,0:10:21.35,0:10:25.35,Default,,0,0,0,,Қанша үлкен
Dialogue: 0,0:10:21.35,0:10:25.35,Default,,0,0,0,,Сенің бұзылған бәйбіше екеніңді
Dialogue: 0,0:10:31.36,0:10:36.37,Default,,0,0,0,,(Чизу)
Dialogue: 0,0:10:31.36,0:10:36.37,Default,,0,0,0,,《Фуми-чан. Мені қаламайсың ба? ➡
Dialogue: 0,0:10:36.37,0:10:38.37,Default,,0,0,0,,Қорқынышты ма? 》
Dialogue: 0,0:10:40.37,0:10:42.39,Default,,0,0,0,,《Түсінбедім》
Dialogue: 0,0:10:42.39,0:10:44.39,Default,,0,0,0,,《Фуми-чан сүйкімді》
Dialogue: 0,0:10:46.31,0:10:52.32,Default,,0,0,0,,《Мен түсінбейтін ештеңе жоқ.
Dialogue: 0,0:10:46.31,0:10:52.32,Default,,0,0,0,,Бұл аздап қорқынышты болды》
Dialogue: 0,0:10:52.32,0:10:54.32,Default,,0,0,0,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:10:54.32,0:10:56.32,Default,,0,0,0,,Жылауды доғар!
Dialogue: 0,0:10:59.32,0:11:02.33,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:11:02.33,0:11:07.33,Default,,0,0,0,,Өткенде де, Жылағанда
Dialogue: 0,0:11:02.33,0:11:07.33,Default,,0,0,0,,Сіз жиі қол ұстасып тұрдыңыз.
Dialogue: 0,0:11:07.33,0:11:11.33,Default,,0,0,0,,Ерте ұйықтаңыз. Түнде ұйықтаңыз.
Dialogue: 0,0:11:11.33,0:11:13.33,Default,,0,0,0,,Иә
Dialogue: 0,0:11:16.34,0:11:20.34,Default,,0,0,0,,《Менің нағашымның әпкесі
Dialogue: 0,0:11:16.34,0:11:20.34,Default,,0,0,0,,Тұрмысқа шыққаныңыз үшін➡
Dialogue: 0,0:11:20.34,0:11:23.35,Default,,0,0,0,,Әлгі абдырап қалған жігіт.➡
Dialogue: 0,0:11:23.35,0:11:28.35,Default,,0,0,0,,Фуми-чан әпкесі туралы ойлап отыр.
Dialogue: 0,0:11:23.35,0:11:28.35,Default,,0,0,0,,Сізге соншалықты ұнады ма? 》
Dialogue: 0,0:11:30.35,0:11:32.35,Default,,0,0,0,,《Сонша...》
Dialogue: 0,0:11:38.35,0:11:42.35,Default,,0,0,0,,Хмм. Ондай адам.
Dialogue: 0,0:11:38.35,0:11:42.35,Default,,0,0,0,,Сіз менің клубымда болдыңыз ба?
Dialogue: 0,0:11:42.35,0:11:45.35,Default,,0,0,0,,Жақсы
Dialogue: 0,0:11:42.35,0:11:45.35,Default,,0,0,0,,Бойы биік болу және төте жолдарды алу
Dialogue: 0,0:11:45.35,0:11:49.36,Default,,0,0,0,,Ал, әзірге.
Dialogue: 0,0:11:45.35,0:11:49.36,Default,,0,0,0,,Мұнда сынып пен атын жазыңыз
Dialogue: 0,0:11:49.36,0:11:51.36,Default,,0,0,0,,Иә
Dialogue: 0,0:11:51.36,0:11:54.36,Default,,0,0,0,,Хмм. Бірақ сен ұзынсың.
Dialogue: 0,0:11:51.36,0:11:54.36,Default,,0,0,0,,Таңбашалар...
Dialogue: 0,0:11:54.36,0:11:56.37,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:11:56.37,0:11:59.37,Default,,0,0,0,,Иә? Сәлем
Dialogue: 0,0:11:59.37,0:12:02.37,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:11:59.37,0:12:02.37,Default,,0,0,0,,Мүмкін➡
Dialogue: 0,0:12:02.37,0:12:05.37,Default,,0,0,0,,Сіз бұл жігіт туралы айтып отырсыз ба?
Dialogue: 0,0:12:02.37,0:12:05.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:05.37,0:12:08.38,Default,,0,0,0,,Бұл жігіт баскетбол командасында.
Dialogue: 0,0:12:05.37,0:12:08.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:08.38,0:12:11.38,Default,,0,0,0,,Менің досым
Dialogue: 0,0:12:08.38,0:12:11.38,Default,,0,0,0,,Баскетбол?
Dialogue: 0,0:12:13.38,0:12:15.38,Default,,0,0,0,,Фуми Манжоме?
Dialogue: 0,0:12:17.39,0:12:23.39,Default,,0,0,0,,Сугимото
Dialogue: 0,0:12:17.39,0:12:23.39,Default,,0,0,0,,Бұл Ясуми Сугимото, үшінші курс студенті.
Dialogue: 0,0:12:17.39,0:12:23.39,Default,,0,0,0,,Тағы да рахмет.
Dialogue: 0,0:12:23.39,0:12:28.40,Default,,0,0,0,,Баскетбол!?
Dialogue: 0,0:12:23.39,0:12:28.40,Default,,0,0,0,,Неліктен кенеттен мұндай жерге тап болдыңыз?
Dialogue: 0,0:12:28.40,0:12:31.40,Default,,0,0,0,,Қабылдау туралы өтініш... болып табылады
Dialogue: 0,0:12:28.40,0:12:31.40,Default,,0,0,0,,Әрбір клуб бірдей...
Dialogue: 0,0:12:31.40,0:12:34.40,Default,,0,0,0,,Мәселе бұл емес!
Dialogue: 0,0:12:34.40,0:12:37.40,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:12:34.40,0:12:37.40,Default,,0,0,0,,Енді?
Dialogue: 0,0:12:39.34,0:12:43.35,Default,,0,0,0,,Театрда тәжірибеңіз болмаса
Dialogue: 0,0:12:39.34,0:12:43.35,Default,,0,0,0,,Алғашында мұны сахна артындағылар ғана жасай алады.➡
Dialogue: 0,0:12:43.35,0:12:49.35,Default,,0,0,0,,Костюмдер мен фон жасау
Dialogue: 0,0:12:43.35,0:12:49.35,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:12:49.35,0:12:53.36,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:12:49.35,0:12:53.36,Default,,0,0,0,,Мәселе жоқ
Dialogue: 0,0:12:53.36,0:12:58.36,Default,,0,0,0,,Жақында театр фестивалі болады.
Dialogue: 0,0:12:53.36,0:12:58.36,Default,,0,0,0,,Жаңадан келген студенттерді құптайды.
Dialogue: 0,0:12:58.36,0:13:02.37,Default,,0,0,0,,Біз адамдармен дөрекі боламыз.
Dialogue: 0,0:12:58.36,0:13:02.37,Default,,0,0,0,,Дайын болыңыз
Dialogue: 0,0:13:02.37,0:13:04.37,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:09.37,0:13:12.38,Default,,0,0,0,,(Ёши)
Dialogue: 0,0:13:09.37,0:13:12.38,Default,,0,0,0,,Ол оны түнде бірнеше рет алып келгенін айтты.
Dialogue: 0,0:13:12.38,0:13:15.38,Default,,0,0,0,,Акио
Dialogue: 0,0:13:12.38,0:13:15.38,Default,,0,0,0,,Менің артымнан ерме
Dialogue: 0,0:13:12.38,0:13:15.38,Default,,0,0,0,,Бұл – шындық.
Dialogue: 0,0:13:15.38,0:13:18.38,Default,,0,0,0,,Жалғыз болған дұрыс
Dialogue: 0,0:13:15.38,0:13:18.38,Default,,0,0,0,,Барыңыз.
Dialogue: 0,0:13:18.38,0:13:20.38,Default,,0,0,0,,А, қараңдаршы
Dialogue: 0,0:13:20.38,0:13:25.38,Default,,0,0,0,,≪(Ёши) Той күні ештеңе жоқ
Dialogue: 0,0:13:20.38,0:13:25.38,Default,,0,0,0,,Сізге суық тиюдің қажеті жоқ.
Dialogue: 0,0:13:29.39,0:13:32.40,Default,,0,0,0,,《Әке Ана
Dialogue: 0,0:13:29.39,0:13:32.40,Default,,0,0,0,,Кешіріңіз.➡
Dialogue: 0,0:13:32.40,0:13:36.42,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:13:32.40,0:13:36.42,Default,,0,0,0,,Түнде көп құсқан жоқпын.➡
Dialogue: 0,0:13:36.42,0:13:39.34,Default,,0,0,0,,Мен де суық тиген жоқпын.➡
Dialogue: 0,0:13:39.34,0:13:41.34,Default,,0,0,0,,I…｡➡
Dialogue: 0,0:13:41.34,0:13:43.34,Default,,0,0,0,,Менің барғым келмеді》
Dialogue: 0,0:13:48.34,0:13:58.35,Default,,0,0,0,,≪☎
Dialogue: 0,0:13:58.35,0:14:04.36,Default,,0,0,0,,☎
Dialogue: 0,0:14:04.36,0:14:07.36,Default,,0,0,0,,Иә. Мен Манджоммын.
Dialogue: 0,0:14:07.36,0:14:12.36,Default,,0,0,0,,Ах, Ах-чан? иә?
Dialogue: 0,0:14:14.37,0:14:18.37,Default,,0,0,0,,Иә, бос уақытым бар... Бос уақытым бар, бос уақытым бар. Менің бос уақытым көп.
Dialogue: 0,0:14:18.37,0:14:23.37,Default,,0,0,0,,☎Хахаха... Мен қатты скучно.
Dialogue: 0,0:14:18.37,0:14:23.37,Default,,0,0,0,,Олай болса бір жерге барайық.
Dialogue: 0,0:14:27.38,0:14:29.38,Default,,0,0,0,,Ах
Dialogue: 0,0:14:34.39,0:14:37.33,Default,,0,0,0,,≪Ахаха...
Dialogue: 0,0:14:37.33,0:14:43.33,Default,,0,0,0,,Әдебиет үйірмесі баскетбол үйірмесі сияқты.
Dialogue: 0,0:14:37.33,0:14:43.33,Default,,0,0,0,,Қандай қателік. Хехе...
Dialogue: 0,0:14:43.33,0:14:47.34,Default,,0,0,0,,Иә. Ал, бірақ
Dialogue: 0,0:14:43.33,0:14:47.34,Default,,0,0,0,,Егер сіз жай ғана кірсеңіз ➡
Dialogue: 0,0:14:47.34,0:14:49.34,Default,,0,0,0,,Бұл сөзсіз Фуми-чан, солай емес пе?
Dialogue: 0,0:14:49.34,0:14:54.34,Default,,0,0,0,,күрсіну. Драма үйірмесіне түскені дұрыс болар еді.
Dialogue: 0,0:14:49.34,0:14:54.34,Default,,0,0,0,,Бұл жақсырақ болар еді
Dialogue: 0,0:14:54.34,0:14:58.35,Default,,0,0,0,,Аа, мен драма үйірмесіне түстім.
Dialogue: 0,0:14:54.34,0:14:58.35,Default,,0,0,0,,Иә, керемет
Dialogue: 0,0:14:58.35,0:15:02.35,Default,,0,0,0,,Бір сыныптағы Игуми мырза есімді қызбен.
Dialogue: 0,0:14:58.35,0:15:02.35,Default,,0,0,0,,Үйірмеге бірге қосылдық.
Dialogue: 0,0:15:02.35,0:15:04.35,Default,,0,0,0,,Мынаны қараңыз
Dialogue: 0,0:15:02.35,0:15:04.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:06.36,0:15:12.36,Default,,0,0,0,,Хоши
Dialogue: 0,0:15:06.36,0:15:12.36,Default,,0,0,0,,Оудзи
Dialogue: 0,0:15:06.36,0:15:12.36,Default,,0,0,0,,Вакакуса оқиғасы
Dialogue: 0,0:15:06.36,0:15:12.36,Default,,0,0,0,,«Кішкентай ханзада» «Кішкентай әйелдер»
Dialogue: 0,0:15:06.36,0:15:12.36,Default,,0,0,0,,Дауыл
Dialogue: 0,0:15:06.36,0:15:12.36,Default,,0,0,0,,Жарайды
Dialogue: 0,0:15:06.36,0:15:12.36,Default,,0,0,0,,«Шыңғырған биіктер»…
Dialogue: 0,0:15:12.36,0:15:15.36,Default,,0,0,0,,Керемет! А-чан, шығасың ба?
Dialogue: 0,0:15:15.36,0:15:20.37,Default,,0,0,0,,Менің мұны істеуім мүмкін емес. Мен жақсы адаммын.
Dialogue: 0,0:15:15.36,0:15:20.37,Default,,0,0,0,,Өйткені олар өте көп.
Dialogue: 0,0:15:20.37,0:15:24.37,Default,,0,0,0,,Бірақ сахна артында немесе бәрібір.
Dialogue: 0,0:15:20.37,0:15:24.37,Default,,0,0,0,,Бұл жағдайда мен сізге қалай көмектесе аламын?
Dialogue: 0,0:15:24.37,0:15:27.38,Default,,0,0,0,,Мен бірдеңе жақсы деп ойладым...
Dialogue: 0,0:15:27.38,0:15:32.38,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:15:27.38,0:15:32.38,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:15:41.32,0:15:44.33,Default,,0,0,0,,《А-чан бұл
Dialogue: 0,0:15:41.32,0:15:44.33,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені табыңыз➡
Dialogue: 0,0:15:44.33,0:15:48.33,Default,,0,0,0,,Мен өзімді толық сезінемін... Бұл тамаша》
Dialogue: 0,0:15:48.33,0:15:51.33,Default,,0,0,0,,《Мен де баскетбол үйірмесіне қосылдым.
Dialogue: 0,0:15:48.33,0:15:51.33,Default,,0,0,0,,«Мен кіре алмаймын»➡
Dialogue: 0,0:15:51.33,0:15:53.34,Default,,0,0,0,,Мен оны дұрыс айтуым керек》
Dialogue: 0,0:15:53.34,0:15:55.34,Default,,0,0,0,,≪(есіктің ашылу дыбысы)
Dialogue: 0,0:15:53.34,0:15:55.34,Default,,0,0,0,,Ах
Dialogue: 0,0:15:55.34,0:15:57.34,Default,,0,0,0,,≪(Ёши) Ах, мен шаршадым, мен шаршадым
Dialogue: 0,0:15:57.34,0:16:00.34,Default,,0,0,0,,Ах, бұл жаман.
Dialogue: 0,0:16:00.34,0:16:04.34,Default,,0,0,0,,≪(Ёши) Фуми?
Dialogue: 0,0:16:00.34,0:16:04.34,Default,,0,0,0,,Сіз ояусыз ба? Фуми? Фуми?
Dialogue: 0,0:16:12.35,0:16:16.36,Default,,0,0,0,,Манжоме мырзадан
Dialogue: 0,0:16:12.35,0:16:16.36,Default,,0,0,0,,Келгеніңізге қуаныштымын.
Dialogue: 0,0:16:16.36,0:16:20.36,Default,,0,0,0,,Жоқ, солай…
Dialogue: 0,0:16:16.36,0:16:20.36,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:16:20.36,0:16:25.37,Default,,0,0,0,,Ах, жоқ, яғни…
Dialogue: 0,0:16:20.36,0:16:25.37,Default,,0,0,0,,Мен сізбен бір нәрсе туралы сөйлескім келеді.
Dialogue: 0,0:16:25.37,0:16:29.37,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:16:25.37,0:16:29.37,Default,,0,0,0,,Манжоме-сан, сен актерлік өнерге қызығасың ба?
Dialogue: 0,0:16:29.37,0:16:34.38,Default,,0,0,0,,Пьеса...?
Dialogue: 0,0:16:29.37,0:16:34.38,Default,,0,0,0,,Маған ұнамайды...
Dialogue: 0,0:16:34.38,0:16:40.32,Default,,0,0,0,,Жақсы. Сіз бұған қарай аласыз ба?
Dialogue: 0,0:16:34.38,0:16:40.32,Default,,0,0,0,,Не? Бұл Фудзигая...
Dialogue: 0,0:16:40.32,0:16:44.32,Default,,0,0,0,,Иә, Фудзигая Джогакуин драма клубы.
Dialogue: 0,0:16:40.32,0:16:44.32,Default,,0,0,0,,Брошюра
Dialogue: 0,0:16:44.32,0:16:46.32,Default,,0,0,0,,Ах... мм...
Dialogue: 0,0:16:48.32,0:16:52.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:48.32,0:16:52.33,Default,,0,0,0,,Не болды? Ах
Dialogue: 0,0:16:52.33,0:16:56.33,Default,,0,0,0,,Хат... махаббат хаты шығар?
Dialogue: 0,0:16:52.33,0:16:56.33,Default,,0,0,0,,Бұл іске араласпа.
Dialogue: 0,0:16:56.33,0:17:00.34,Default,,0,0,0,,Керемет
Dialogue: 0,0:16:56.33,0:17:00.34,Default,,0,0,0,,Бұл шынымен бар ма?
Dialogue: 0,0:17:00.34,0:17:03.34,Default,,0,0,0,,Орта мектеп оқушысы.
Dialogue: 0,0:17:00.34,0:17:03.34,Default,,0,0,0,,Сіз кездесіп жатырсыз ба?
Dialogue: 0,0:17:03.34,0:17:07.34,Default,,0,0,0,,Тіпті орта мектеп ғимаратында
Dialogue: 0,0:17:03.34,0:17:07.34,Default,,0,0,0,,Мен сіздің батылдығыңызды бағалаймын➡
Dialogue: 0,0:17:07.34,0:17:10.34,Default,,0,0,0,,Маған
Dialogue: 0,0:17:07.34,0:17:10.34,Default,,0,0,0,,Өйткені маған ұнайтын адам бар
Dialogue: 0,0:17:12.35,0:17:17.35,Default,,0,0,0,,Ха! Мүмкін мен шығармын?
Dialogue: 0,0:17:12.35,0:17:17.35,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:17:17.35,0:17:22.36,Default,,0,0,0,,Сәнбика
Dialogue: 0,0:17:17.35,0:17:22.36,Default,,0,0,0,,♬«Көк гүл әнұраны»
Dialogue: 0,0:17:22.36,0:17:27.36,Default,,0,0,0,,♬«Таза жүрек үшін»
Dialogue: 0,0:17:27.36,0:17:29.37,Default,,0,0,0,,《Неге?➡
Dialogue: 0,0:17:29.37,0:17:34.37,Default,,0,0,0,,Игуми мырзаға кім ұнайды?
Dialogue: 0,0:17:29.37,0:17:34.37,Default,,0,0,0,,Мен оны әйел деп ойладым》
Dialogue: 0,0:17:36.39,0:17:40.31,Default,,0,0,0,,《Әйтеуір...➡
Dialogue: 0,0:17:40.31,0:17:42.31,Default,,0,0,0,,Мен солай сезіндім》
Dialogue: 0,0:17:46.32,0:17:50.32,Default,,0,0,0,,Жоқ, тек кедергі келтіресің.
Dialogue: 0,0:17:46.32,0:17:50.32,Default,,0,0,0,,Фудзигая
Dialogue: 0,0:17:50.32,0:17:52.32,Default,,0,0,0,,Ханым
Dialogue: 0,0:17:52.32,0:17:56.33,Default,,0,0,0,,Бұл артқы қақпа.
Dialogue: 0,0:17:52.32,0:17:56.33,Default,,0,0,0,,Негізгі қақпа сәл артта.
Dialogue: 0,0:17:56.33,0:17:59.33,Default,,0,0,0,,≪(Йоко/Мива) Ех!
Dialogue: 0,0:17:56.33,0:17:59.33,Default,,0,0,0,,≪(Мисако) Бұл қандай мектеп?
Dialogue: 0,0:17:59.33,0:18:03.33,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:17:59.33,0:18:03.33,Default,,0,0,0,,Мен Фудзигаяны бір рет көргім келеді...
Dialogue: 0,0:18:03.33,0:18:07.34,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:18:03.33,0:18:07.34,Default,,0,0,0,,Мен Фудзигая тұрғындарынан рұқсат алдым.➡
Dialogue: 0,0:18:07.34,0:18:10.34,Default,,0,0,0,,Жалғыз жүргеннен оңай.
Dialogue: 0,0:18:14.34,0:18:16.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:18.35,0:18:22.35,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:18:18.35,0:18:22.35,Default,,0,0,0,,Біраз уақыт өтті. Бұл тез болды.
Dialogue: 0,0:18:22.35,0:18:25.35,Default,,0,0,0,,Бұл экскурсиядағы балалар?
Dialogue: 0,0:18:22.35,0:18:25.35,Default,,0,0,0,,О
Dialogue: 0,0:18:25.35,0:18:29.36,Default,,0,0,0,,Фуми-чан! Неліктен?
Dialogue: 0,0:18:25.35,0:18:29.36,Default,,0,0,0,,Мен де қобалжып барамын.
Dialogue: 0,0:18:29.36,0:18:33.36,Default,,0,0,0,,Кешір… (Иура) Қайдағы жоқ.
Dialogue: 0,0:18:29.36,0:18:33.36,Default,,0,0,0,,Ах, Акира Окудайра
Dialogue: 0,0:18:33.36,0:18:37.30,Default,,0,0,0,,Біз бастауыш сыныптан бері доспыз.
Dialogue: 0,0:18:33.36,0:18:37.30,Default,,0,0,0,,Ал мынау...
Dialogue: 0,0:18:37.30,0:18:40.30,Default,,0,0,0,,Хонацуги
Dialogue: 0,0:18:37.30,0:18:40.30,Default,,0,0,0,,Йоко Хонацуги
Dialogue: 0,0:18:37.30,0:18:40.30,Default,,0,0,0,,Мотеги
Dialogue: 0,0:18:37.30,0:18:40.30,Default,,0,0,0,,Мива Моги
Dialogue: 0,0:18:40.30,0:18:44.31,Default,,0,0,0,,Ясуда
Dialogue: 0,0:18:40.30,0:18:44.31,Default,,0,0,0,,Бұл Мисако Ясуда.
Dialogue: 0,0:18:40.30,0:18:44.31,Default,,0,0,0,,Олар да драма үйірмесіне қатысады.
Dialogue: 0,0:18:44.31,0:18:48.31,Default,,0,0,0,,Біз ол жақта да доспыз.
Dialogue: 0,0:18:44.31,0:18:48.31,Default,,0,0,0,,ұқсайды
Dialogue: 0,0:18:48.31,0:18:51.31,Default,,0,0,0,,-де? Кіші қызыңды неге әкелдің?
Dialogue: 0,0:18:51.31,0:18:55.32,Default,,0,0,0,,Өйткені мына тыққышты қараңыз.
Dialogue: 0,0:18:51.31,0:18:55.32,Default,,0,0,0,,Бұл қымбат
Dialogue: 0,0:18:55.32,0:18:58.32,Default,,0,0,0,,Сізден көп айырмашылығы жоқ.
Dialogue: 0,0:18:55.32,0:18:58.32,Default,,0,0,0,,Дұрыс? Сонымен...
Dialogue: 0,0:18:58.32,0:19:04.33,Default,,0,0,0,,Бірақ Хитклифф
Dialogue: 0,0:18:58.32,0:19:04.33,Default,,0,0,0,,Мен сенен басқа ешкімді ойламаймын.
Dialogue: 0,0:19:04.33,0:19:08.33,Default,,0,0,0,,күрсіну. Қандай өзімшіл жігіт. Ах.
Dialogue: 0,0:19:16.34,0:19:20.34,Default,,0,0,0,,Мен драма үйірмесіне қосылдым.
Dialogue: 0,0:19:16.34,0:19:20.34,Default,,0,0,0,,Сіз қалай ойлайсыз? қызық?
Dialogue: 0,0:19:20.34,0:19:26.35,Default,,0,0,0,,Бұл қызық. Мен әлі сахнаның артында ғана жүрмін.
Dialogue: 0,0:19:20.34,0:19:26.35,Default,,0,0,0,,Маған мұны істеуге рұқсат жоқ, бірақ...
Dialogue: 0,0:19:26.35,0:19:30.35,Default,,0,0,0,,Киоко ханшайым болады.
Dialogue: 0,0:19:26.35,0:19:30.35,Default,,0,0,0,,Бұл сізге жақсы көрінеді.
Dialogue: 0,0:19:30.35,0:19:35.36,Default,,0,0,0,,Екатерина рөлін ала алсаңыз
Dialogue: 0,0:19:30.35,0:19:35.36,Default,,0,0,0,,Мен оның кандидат болғанына сенімдімін.
Dialogue: 0,0:19:35.36,0:19:39.36,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:19:35.36,0:19:39.36,Default,,0,0,0,,Себебі мен Хитклиффті ойнаймын ба?
Dialogue: 0,0:19:42.30,0:19:48.30,Default,,0,0,0,,Бұл жолы, менің ағам, Хитклифф,
Dialogue: 0,0:19:42.30,0:19:48.30,Default,,0,0,0,,Оны көре білу жеткілікті
Dialogue: 0,0:19:48.30,0:19:51.31,Default,,0,0,0,,Киоко｡➡
Dialogue: 0,0:19:51.31,0:19:54.31,Default,,0,0,0,,Қарап қана көңіліңіз толды ма?
Dialogue: 0,0:19:56.31,0:19:58.31,Default,,0,0,0,,«Ой, жүрегімнің ғашығы.➡
Dialogue: 0,0:19:58.31,0:20:02.32,Default,,0,0,0,,Бұл жолы мені тыңда.
Dialogue: 0,0:19:58.31,0:20:02.32,Default,,0,0,0,,Кэтрин! ”➡
Dialogue: 0,0:20:02.32,0:20:06.32,Default,,0,0,0,,Бұл сізге мұны істегіңіз келетін терезе.
Dialogue: 0,0:20:02.32,0:20:06.32,Default,,0,0,0,,Жаса!
Dialogue: 0,0:20:06.32,0:20:09.32,Default,,0,0,0,,Хехе...
Dialogue: 0,0:20:06.32,0:20:09.32,Default,,0,0,0,,Бірақ бұл өте керемет
Dialogue: 0,0:20:09.32,0:20:12.33,Default,,0,0,0,,Эй, капелла, оны көргің келе ме?
Dialogue: 0,0:20:09.32,0:20:12.33,Default,,0,0,0,,Қуа келе жатқандар кетті.
Dialogue: 0,0:20:12.33,0:20:15.33,Default,,0,0,0,,Ондай нәрсе бар ма?
Dialogue: 0,0:20:12.33,0:20:15.33,Default,,0,0,0,,Иә. Барамыз ба?
Dialogue: 0,0:20:15.33,0:20:18.33,Default,,0,0,0,,Уау, мен оны көргім келеді!
Dialogue: 0,0:20:15.33,0:20:18.33,Default,,0,0,0,,Мен де Мен де
Dialogue: 0,0:20:18.33,0:20:20.34,Default,,0,0,0,,Мұнда
Dialogue: 0,0:20:18.33,0:20:20.34,Default,,0,0,0,,О, сәл күте тұрыңыз.
Dialogue: 0,0:20:20.34,0:20:23.34,Default,,0,0,0,,《Бір сәтте
Dialogue: 0,0:20:20.34,0:20:23.34,Default,,0,0,0,,Біз жақсы дос болдық.
Dialogue: 0,0:20:25.34,0:20:28.34,Default,,0,0,0,,《Әрине керемет жер》
Dialogue: 0,0:20:30.35,0:20:35.35,Default,,0,0,0,,《Жатақханадағы шай ішу
Dialogue: 0,0:20:30.35,0:20:35.35,Default,,0,0,0,,Раушан кеші➡
Dialogue: 0,0:20:35.35,0:20:41.35,Default,,0,0,0,,Сеанстың құпия жиналысы
Dialogue: 0,0:20:35.35,0:20:41.35,Default,,0,0,0,,Кітапхана шығанағындағы терезе...》
Dialogue: 0,0:20:44.29,0:20:47.30,Default,,0,0,0,,《Мен не істеуім керек? Мен сені жақсы көремін.»
Dialogue: 0,0:20:47.30,0:20:50.30,Default,,0,0,0,,≪(есіктің ашылу дыбысы)
Dialogue: 0,0:20:47.30,0:20:50.30,Default,,0,0,0,,Ах
Dialogue: 0,0:20:50.30,0:21:06.30,Default,,0,0,0,,♬～
Dialogue: 0,0:21:10.32,0:21:15.32,Default,,0,0,0,,♬『ｾﾝﾃｨﾌｫﾘｱ』
Dialogue: 0,0:21:15.32,0:21:35.34,Default,,0,0,0,,♬～
