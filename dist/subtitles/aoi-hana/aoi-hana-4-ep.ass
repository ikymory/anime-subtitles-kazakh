Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.47,0:00:05.47,Rubi,,0000,0000,0000,,Ясуко
Dialogue: 0,0:00:01.47,0:00:05.47,Rubi,,0000,0000,0000,,Фудзи
Dialogue: 0,0:00:01.47,0:00:05.47,Rubi,,0000,0000,0000,,Мен бас тартқан адамдардың бәрі бірден жойылды
Dialogue: 0,0:00:01.47,0:00:05.47,Default,,0000,0000,0000,,Фудзигаяда
Dialogue: 0,0:00:01.47,0:00:05.47,Default,,0000,0000,0000,,«Кітапхана-но-кун» деген адам бар.
Dialogue: 0,0:00:05.47,0:00:09.47,Default,,0000,0000,0000,,«Кітапхана ханзадасы»?
Dialogue: 0,0:00:09.47,0:00:13.48,Default,,0000,0000,0000,,Мұғалім қалжыңдады
Dialogue: 0,0:00:09.47,0:00:13.48,Default,,0000,0000,0000,,Кітапты жақсы көретін студентті осылай атасаңыз➡
Dialogue: 0,0:00:13.48,0:00:17.48,Default,,0000,0000,0000,,Бұл лақап ат бүкіл мектепке тарады.
Dialogue: 0,0:00:17.48,0:00:20.49,Default,,0000,0000,0000,,Керемет... солай емес пе?
Dialogue: 0,0:00:20.49,0:00:22.49,Default,,0000,0000,0000,,Сен не үшін жылайсың?
Dialogue: 0,0:00:22.49,0:00:27.49,Default,,0000,0000,0000,,Мен психикалық тұрғыдан дайын болмасам да, кенеттен
Dialogue: 0,0:00:22.49,0:00:27.49,Default,,0000,0000,0000,,Тым жақындамаңыз
Dialogue: 0,0:00:29.49,0:00:34.50,Default,,0000,0000,0000,,Олай болса ойыңды дайында.
Dialogue: 0,0:00:29.49,0:00:34.50,Default,,0000,0000,0000,,А...
Dialogue: 0,0:00:34.50,0:00:36.50,Default,,0000,0000,0000,,Терең тыныс алыңыз
Dialogue: 0,0:00:36.50,0:00:49.51,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:00:49.51,0:00:53.52,Default,,0000,0000,0000,,Хахаха... Сіз қобалжыдыңыз ба?
Dialogue: 0,0:00:49.51,0:00:53.52,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:00:53.52,0:00:55.54,Default,,0000,0000,0000,,Мен де қатты толқыдым.
Dialogue: 0,0:00:55.54,0:00:58.46,Default,,0000,0000,0000,,Иә? Сенпай?
Dialogue: 0,0:00:58.46,0:01:01.46,Default,,0000,0000,0000,,Мен аламын
Dialogue: 0,0:00:58.46,0:01:01.46,Default,,0000,0000,0000,,Мені кім деп ойлайсың?
Dialogue: 0,0:01:01.46,0:01:04.46,Default,,0000,0000,0000,,А... жоқ
Dialogue: 0,0:01:01.46,0:01:04.46,Default,,0000,0000,0000,,Менің жүрегім неден соғады?➡
Dialogue: 0,0:01:04.46,0:01:08.47,Default,,0000,0000,0000,,Бұл әрқашан мен
Dialogue: 0,0:01:04.46,0:01:08.47,Default,,0000,0000,0000,,Себебі мен ойладым
Dialogue: 0,0:01:08.47,0:01:10.47,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:01:13.47,0:01:16.47,Default,,0000,0000,0000,,«Әрқашан» дегенді қалай түсінесіңдер?
Dialogue: 0,0:01:13.47,0:01:16.47,Default,,0000,0000,0000,,Жоқ...
Dialogue: 0,0:01:16.47,0:01:20.48,Default,,0000,0000,0000,,Басқаша айтқанда, қалықтаған нәрсе
Dialogue: 0,0:01:16.47,0:01:20.48,Default,,0000,0000,0000,,Мен ғана➡
Dialogue: 0,0:01:20.48,0:01:24.48,Default,,0000,0000,0000,,Әрқашан менің
Dialogue: 0,0:01:20.48,0:01:24.48,Default,,0000,0000,0000,,Менің ойымша, бұл жауапсыз махаббат
Dialogue: 0,0:01:24.48,0:01:27.49,Default,,0000,0000,0000,,Фуми сүйкімді
Dialogue: 0,0:01:27.49,0:01:32.49,Default,,0000,0000,0000,,Енді кездесейік.
Dialogue: 0,0:01:27.49,0:01:32.49,Default,,0000,0000,0000,,Мектепке бірге барамыз ба?
Dialogue: 0,0:01:32.49,0:01:37.50,Rubi,,0000,0000,0000,,Көк
Dialogue: 0,0:01:32.49,0:01:37.50,Rubi,,0000,0000,0000,,3D маневрлік жабдықтың табиғи жауы.
Dialogue: 0,0:01:32.49,0:01:37.50,Default,,0000,0000,0000,,♬『Көк гүл』
Dialogue: 0,0:01:37.50,0:01:51.51,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:01:51.51,0:02:00.45,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:02:00.45,0:02:20.47,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:02:20.47,0:02:40.49,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:02:40.49,0:02:54.49,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:02:58.48,0:03:09.49,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:03:09.49,0:03:14.49,Default,,0000,0000,0000,,күрсіну. Бұл біртүрлі емес пе?
Dialogue: 0,0:03:09.49,0:03:14.49,Default,,0000,0000,0000,,Бұл балалық деп ойламайсың ба?
Dialogue: 0,0:03:17.50,0:03:19.50,Default,,0000,0000,0000,,《Фуми сүйкімді》
Dialogue: 0,0:03:19.50,0:03:21.50,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:03:21.50,0:03:23.50,Default,,0000,0000,0000,,Ас үшін рахмет
Dialogue: 0,0:03:25.50,0:03:27.51,Default,,0000,0000,0000,,Кеттік
Dialogue: 0,0:03:27.51,0:03:31.51,Rubi,,0000,0000,0000,,Йоши
Dialogue: 0,0:03:27.51,0:03:31.51,Default,,0000,0000,0000,,(Ёши)
Dialogue: 0,0:03:27.51,0:03:31.51,Default,,0000,0000,0000,,Мектепте электр қуатын өшіруді ұмытпаңыз.
Dialogue: 0,0:03:31.51,0:03:34.51,Default,,0000,0000,0000,,Қуатты қалай өшіруге болады?
Dialogue: 0,0:03:34.51,0:03:37.52,Default,,0000,0000,0000,,Қызыл түймені ұзақ басыңыз.➡
Dialogue: 0,0:03:37.52,0:03:39.52,Default,,0000,0000,0000,,Жігіттен
Dialogue: 0,0:03:37.52,0:03:39.52,Default,,0000,0000,0000,,Электрондық поштаны алған кезде➡
Dialogue: 0,0:03:39.52,0:03:42.52,Default,,0000,0000,0000,,Кем дегенде мазмұны қандай.
Dialogue: 0,0:03:39.52,0:03:42.52,Default,,0000,0000,0000,,Айтыңызшы
Dialogue: 0,0:03:42.52,0:03:44.52,Default,,0000,0000,0000,,Ондай нәрсе жоқ.
Dialogue: 0,0:03:44.52,0:03:47.52,Default,,0000,0000,0000,,Ақырында
Dialogue: 0,0:03:44.52,0:03:47.52,Default,,0000,0000,0000,,Мүмкін сіз мұны істей аласыз.
Dialogue: 0,0:03:52.53,0:03:54.53,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:03:54.53,0:03:56.55,Default,,0000,0000,0000,,Фуми
Dialogue: 0,0:03:54.53,0:03:56.55,Default,,0000,0000,0000,,Фуми-чан
Dialogue: 0,0:03:56.55,0:03:58.55,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:04:00.47,0:04:02.47,Default,,0000,0000,0000,,Ах-чан...
Dialogue: 0,0:04:04.48,0:04:08.48,Default,,0000,0000,0000,,Аа, бастапқыда
Dialogue: 0,0:04:04.48,0:04:08.48,Default,,0000,0000,0000,,Фудзигаданиде болдыңыз ба?
Dialogue: 0,0:04:08.48,0:04:10.48,Default,,0000,0000,0000,,Иә, бұл драма үйірмесі болатын.➡
Dialogue: 0,0:04:10.48,0:04:13.48,Default,,0000,0000,0000,,Тағы да
Dialogue: 0,0:04:10.48,0:04:13.48,Default,,0000,0000,0000,,Сондықтан оны шақырды.
Dialogue: 0,0:04:13.48,0:04:15.49,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:04:15.49,0:04:17.49,Default,,0000,0000,0000,,《Ертең бірге барамыз ба?》
Dialogue: 0,0:04:19.49,0:04:21.49,Default,,0000,0000,0000,,Фумичан
Dialogue: 0,0:04:19.49,0:04:21.49,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:21.49,0:04:25.49,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:04:21.49,0:04:25.49,Default,,0000,0000,0000,,Сіз бүгін өте тынышсыз.
Dialogue: 0,0:04:30.50,0:04:32.50,Default,,0000,0000,0000,,Олай болса
Dialogue: 0,0:04:30.50,0:04:32.50,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:04:32.50,0:04:34.50,Default,,0000,0000,0000,,Көріскенше, Фуми-чан
Dialogue: 0,0:04:36.51,0:04:39.51,Default,,0000,0000,0000,,Ол көңілді бала.
Dialogue: 0,0:04:36.51,0:04:39.51,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:04:43.51,0:04:45.52,Default,,0000,0000,0000,,Ол ешқашан да болмайды!
Dialogue: 0,0:04:43.51,0:04:45.52,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:45.52,0:04:49.52,Default,,0000,0000,0000,,Кенже
Dialogue: 0,0:04:45.52,0:04:49.52,Default,,0000,0000,0000,,Мен үлкендермен мектепке баруды доғарамын.
Dialogue: 0,0:04:49.52,0:04:53.52,Default,,0000,0000,0000,,Иә? Ах
Dialogue: 0,0:04:49.52,0:04:53.52,Default,,0000,0000,0000,,Бұл бұрынғы А-чан ба?
Dialogue: 0,0:04:53.52,0:04:57.46,Default,,0000,0000,0000,,Менімен бірге келемін деп уәде бер.
Dialogue: 0,0:04:53.52,0:04:57.46,Default,,0000,0000,0000,,Сонымен біз бір-бірімізге соқтығыстық.
Dialogue: 0,0:04:57.46,0:05:01.47,Default,,0000,0000,0000,,Бастауыш мектепте оқығандай.
Dialogue: 0,0:05:01.47,0:05:05.47,Default,,0000,0000,0000,,Менімен бірге
Dialogue: 0,0:05:01.47,0:05:05.47,Default,,0000,0000,0000,,А-чан ішін бүгеді ме?
Dialogue: 0,0:05:05.47,0:05:09.47,Default,,0000,0000,0000,,А-чан
Dialogue: 0,0:05:05.47,0:05:09.47,Default,,0000,0000,0000,,Мен ондай бала емеспін.
Dialogue: 0,0:05:09.47,0:05:13.48,Default,,0000,0000,0000,,Жақын топтан
Dialogue: 0,0:05:09.47,0:05:13.48,Default,,0000,0000,0000,,Сағынып қалсаң, бәлеге қаласың.
Dialogue: 0,0:05:13.48,0:05:16.48,Default,,0000,0000,0000,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,0:05:13.48,0:05:16.48,Default,,0000,0000,0000,,Саяхатымызды А-чанға қалдырайық.
Dialogue: 0,0:05:16.48,0:05:19.48,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:16.48,0:05:19.48,Default,,0000,0000,0000,,Мен үшін қайтар жолды сақта
Dialogue: 0,0:05:19.48,0:05:23.48,Default,,0000,0000,0000,,Ертең бәрі жақсы.
Dialogue: 0,0:05:19.48,0:05:23.48,Default,,0000,0000,0000,,Ол ешқашан да болмайды!
Dialogue: 0,0:05:25.49,0:05:27.49,Default,,0000,0000,0000,,Қыздар қиындық тудырады
Dialogue: 0,0:05:27.49,0:05:31.50,Default,,0000,0000,0000,,Қайырлы таң, апалар.
Dialogue: 0,0:05:31.50,0:05:34.50,Default,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:05:31.50,0:05:34.50,Default,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:05:34.50,0:05:36.50,Rubi,,0000,0000,0000,,Киоко
Dialogue: 0,0:05:34.50,0:05:36.50,Rubi,,0000,0000,0000,,Окудаира
Dialogue: 0,0:05:34.50,0:05:36.50,Default,,0000,0000,0000,,Окухира мырза
Dialogue: 0,0:05:34.50,0:05:36.50,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:36.50,0:05:39.50,Rubi,,0000,0000,0000,,Мынау да.
Dialogue: 0,0:05:36.50,0:05:39.50,Default,,0000,0000,0000,,Ясу-чан.
Dialogue: 0,0:05:36.50,0:05:39.50,Default,,0000,0000,0000,,Мырылдағанын ести алмайсың ғой, иә? Өліп қалған
Dialogue: 0,0:05:39.50,0:05:43.51,Default,,0000,0000,0000,,(Киоко)
Dialogue: 0,0:05:39.50,0:05:43.51,Rubi,,0000,0000,0000,,Саваной
Dialogue: 0,0:05:39.50,0:05:43.51,Default,,0000,0000,0000,,Мен кеше таныстырған Ясуши Саваной мырза
Dialogue: 0,0:05:43.51,0:05:45.51,Default,,0000,0000,0000,,О
Dialogue: 0,0:05:43.51,0:05:45.51,Default,,0000,0000,0000,,Сол адам➡
Dialogue: 0,0:05:45.51,0:05:48.51,Default,,0000,0000,0000,,Окухира мырза туралы
Dialogue: 0,0:05:45.51,0:05:48.51,Default,,0000,0000,0000,,Сізге ұнайтын сияқты.➡
Dialogue: 0,0:05:48.51,0:05:51.52,Default,,0000,0000,0000,,Мен сені қайта көргім келеді
Dialogue: 0,0:05:48.51,0:05:51.52,Default,,0000,0000,0000,,Ах...｡ Бұл үшін рахмет.
Dialogue: 0,0:05:51.52,0:05:55.52,Default,,0000,0000,0000,,О, саған ұнамады ма?
Dialogue: 0,0:05:51.52,0:05:55.52,Default,,0000,0000,0000,,Бұл маған ұнамайды➡
Dialogue: 0,0:05:55.52,0:05:58.46,Default,,0000,0000,0000,,Осындай нәрсе
Dialogue: 0,0:05:55.52,0:05:58.46,Default,,0000,0000,0000,,Мен әлі де жақсы жүрмін
Dialogue: 0,0:05:58.46,0:06:03.46,Default,,0000,0000,0000,,Шынымды айтсам, ересек адаммен кездесу...
Dialogue: 0,0:05:58.46,0:06:03.46,Default,,0000,0000,0000,,Ол мүлдем қосылмады.
Dialogue: 0,0:06:03.46,0:06:05.46,Default,,0000,0000,0000,,Ересек?
Dialogue: 0,0:06:05.46,0:06:11.47,Default,,0000,0000,0000,,Я, мен ересек адам емеспін.
Dialogue: 0,0:06:05.46,0:06:11.47,Default,,0000,0000,0000,,Сол адам｡➡
Dialogue: 0,0:06:11.47,0:06:15.47,Default,,0000,0000,0000,,Ойыңды өзгертсең, кездесуге рұқсат ет.
Dialogue: 0,0:06:11.47,0:06:15.47,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:06:15.47,0:06:17.47,Default,,0000,0000,0000,,(Порнарефф) Не дедің!? Жынды! Аузыңды жап!
Dialogue: 0,0:06:24.48,0:06:27.49,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:06:27.49,0:06:30.49,Default,,0000,0000,0000,,Сол таңғы сұр кесте жіппен➡
Dialogue: 0,0:06:30.49,0:06:33.49,Default,,0000,0000,0000,,Сәл бағындырылған түс
Dialogue: 0,0:06:30.49,0:06:33.49,Default,,0000,0000,0000,,Біреу бар ма?
Dialogue: 0,0:06:38.50,0:06:41.50,Default,,0000,0000,0000,,Әлде бұл жыныстық сипаттағы қорлау үшін сылтау ма?
Dialogue: 0,0:06:41.50,0:06:44.50,Rubi,,0000,0000,0000,,Босдық
Dialogue: 0,0:06:41.50,0:06:44.50,Default,,0000,0000,0000,,Ах, Кагами-сенсей.
Dialogue: 0,0:06:41.50,0:06:44.50,Default,,0000,0000,0000,,Ерекше
Dialogue: 0,0:06:44.50,0:06:46.50,Rubi,,0000,0000,0000,,Кавасаки
Dialogue: 0,0:06:44.50,0:06:46.50,Rubi,,0000,0000,0000,,Миура
Dialogue: 0,0:06:44.50,0:06:46.50,Default,,0000,0000,0000,,Кавасаки. Ал Миура ше?
Dialogue: 0,0:06:46.50,0:06:49.51,Rubi,,0000,0000,0000,,Каори
Dialogue: 0,0:06:46.50,0:06:49.51,Default,,0000,0000,0000,,Каори
Dialogue: 0,0:06:46.50,0:06:49.51,Default,,0000,0000,0000,,Бүгін менің алқа отырысым бар, сондықтан кешігіп қаламын.
Dialogue: 0,0:06:49.51,0:06:51.51,Default,,0000,0000,0000,,Мен…｡➡ көремін
Dialogue: 0,0:06:51.51,0:06:54.51,Default,,0000,0000,0000,,Чип… Чип, чип!
Dialogue: 0,0:06:51.51,0:06:54.51,Default,,0000,0000,0000,,Сіздің тәжірибеңіз алға жылжып жатыр ма?
Dialogue: 0,0:06:54.51,0:06:57.45,Default,,0000,0000,0000,,Біз әлі онша жеткен жоқпыз.
Dialogue: 0,0:06:54.51,0:06:57.45,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:57.45,0:07:01.45,Default,,0000,0000,0000,,Кітапты оқуды бастаңыз
Dialogue: 0,0:06:57.45,0:07:01.45,Default,,0000,0000,0000,,Бұл ертең.
Dialogue: 0,0:07:01.45,0:07:03.45,Default,,0000,0000,0000,,Аа, дұрыс.
Dialogue: 0,0:07:03.45,0:07:06.46,Default,,0000,0000,0000,,Мұғалім, жиі келіп тұрыңыз.➡
Dialogue: 0,0:07:06.46,0:07:10.46,Default,,0000,0000,0000,,Үйірме мұғалімінің арқасында
Dialogue: 0,0:07:06.46,0:07:10.46,Default,,0000,0000,0000,,Бұл елес клуб мүшелерінен әлдеқайда нашар.
Dialogue: 0,0:07:10.46,0:07:13.46,Default,,0000,0000,0000,,Иә, мен саған жақсы қараймын.
Dialogue: 0,0:07:13.46,0:07:15.47,Default,,0000,0000,0000,,(Кавасаки)
Dialogue: 0,0:07:13.46,0:07:15.47,Default,,0000,0000,0000,,Жолдарда эмоция жоқ.
Dialogue: 0,0:07:15.47,0:07:19.47,Default,,0000,0000,0000,,Хаха...
Dialogue: 0,0:07:15.47,0:07:19.47,Rubi,,0000,0000,0000,,Сугимото
Dialogue: 0,0:07:15.47,0:07:19.47,Default,,0000,0000,0000,,Айтпақшы, Сугимото, сен мені шақырып тұрсың ба?
Dialogue: 0,0:07:19.47,0:07:23.47,Default,,0000,0000,0000,,Иә. Мен бұған аса ынталы емеспін.
Dialogue: 0,0:07:19.47,0:07:23.47,Default,,0000,0000,0000,,➡ болмаған сияқты
Dialogue: 0,0:07:23.47,0:07:25.48,Default,,0000,0000,0000,,Каори мәжбүр болды
Dialogue: 0,0:07:23.47,0:07:25.48,Default,,0000,0000,0000,,Мен оны бұздым.
Dialogue: 0,0:07:25.48,0:07:27.48,Default,,0000,0000,0000,,Сонымен...
Dialogue: 0,0:07:30.48,0:07:33.48,Default,,0000,0000,0000,,Кагами-сенсей! ➡
Dialogue: 0,0:07:33.48,0:07:37.49,Rubi,,0000,0000,0000,,Икуми
Dialogue: 0,0:07:33.48,0:07:37.49,Default,,0000,0000,0000,,Менің атым Киоко Игуми.
Dialogue: 0,0:07:33.48,0:07:37.49,Default,,0000,0000,0000,,Бұл менің драма үйірмесіндегі бірінші жылым.
Dialogue: 0,0:07:37.49,0:07:41.49,Default,,0000,0000,0000,,Ах. Сізге көп рахмет.
Dialogue: 0,0:07:41.49,0:07:45.50,Default,,0000,0000,0000,,Мен мұғалімге
Dialogue: 0,0:07:41.49,0:07:45.50,Default,,0000,0000,0000,,Менің сізден сұрайын дегенім бар.
Dialogue: 0,0:07:45.50,0:07:47.50,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:45.50,0:07:47.50,Default,,0000,0000,0000,,Мұғалім бұл➡
Dialogue: 0,0:07:47.50,0:07:52.50,Default,,0000,0000,0000,,Сугимото Сенпай туралы
Dialogue: 0,0:07:47.50,0:07:52.50,Default,,0000,0000,0000,,Сіз көп нәрсені білмейсіз бе?
Dialogue: 0,0:07:52.50,0:07:55.51,Default,,0000,0000,0000,,Неліктен олай ойлайсың?
Dialogue: 0,0:07:55.51,0:07:57.51,Default,,0000,0000,0000,,Әйтеуір...
Dialogue: 0,0:08:02.45,0:08:04.45,Default,,0000,0000,0000,,Мен де білмеймін
Dialogue: 0,0:08:06.45,0:08:08.45,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:08:12.46,0:08:14.46,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:08:25.47,0:08:27.47,Default,,0000,0000,0000,,Ах, Игуми мырза
Dialogue: 0,0:08:27.47,0:08:31.47,Default,,0000,0000,0000,,Мен оны сатып алдым, бірақ
Dialogue: 0,0:08:27.47,0:08:31.47,Default,,0000,0000,0000,,Ха-ха…
Dialogue: 0,0:08:33.48,0:08:36.48,Default,,0000,0000,0000,,Боу?
Dialogue: 0,0:08:36.48,0:08:39.48,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:08:36.48,0:08:39.48,Default,,0000,0000,0000,,Міне, бүгінгі күннің бәрі.
Dialogue: 0,0:08:39.48,0:08:42.49,Default,,0000,0000,0000,,Ха... Уф...
Dialogue: 0,0:08:39.48,0:08:42.49,Default,,0000,0000,0000,,Үйге қайтып бара жатқанда шай алғыңыз келе ме?
Dialogue: 0,0:08:42.49,0:08:45.49,Default,,0000,0000,0000,,Мені біреу күтіп тұр ма деп ойлаймын
Dialogue: 0,0:08:42.49,0:08:45.49,Default,,0000,0000,0000,,Бұл батыл.
Dialogue: 0,0:08:49.49,0:08:52.50,Default,,0000,0000,0000,,Уау
Dialogue: 0,0:08:52.50,0:08:54.50,Default,,0000,0000,0000,,Не болды? Фуми-чан
Dialogue: 0,0:08:54.50,0:08:57.44,Default,,0000,0000,0000,,Мен А-чанды күттім.
Dialogue: 0,0:08:54.50,0:08:57.44,Default,,0000,0000,0000,,Не?!
Dialogue: 0,0:08:57.44,0:09:01.44,Default,,0000,0000,0000,,Окудаира мырза
Dialogue: 0,0:08:57.44,0:09:01.44,Default,,0000,0000,0000,,Мен алдымен үйге барамын.
Dialogue: 0,0:09:01.44,0:09:05.44,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:09:01.44,0:09:05.44,Default,,0000,0000,0000,,Жарайды. Ертең кездескенше.
Dialogue: 0,0:09:05.44,0:09:10.45,Default,,0000,0000,0000,,Сіз кездейсоқ Сугимото-сенпай туралы айтып отырсыз ба?
Dialogue: 0,0:09:10.45,0:09:14.45,Default,,0000,0000,0000,,Аа, дұрыс.
Dialogue: 0,0:09:10.45,0:09:14.45,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:09:19.46,0:09:23.46,Default,,0000,0000,0000,,《Сугимото Сенпай Фудзигаяға барды
Dialogue: 0,0:09:19.46,0:09:23.46,Default,,0000,0000,0000,,Шығу себебін білсеңіз➡
Dialogue: 0,0:09:23.46,0:09:25.46,Default,,0000,0000,0000,,Маған айтып бере аласыз ба? 》
Dialogue: 0,0:09:25.46,0:09:30.47,Default,,0000,0000,0000,,《Аға, маған
Dialogue: 0,0:09:25.46,0:09:30.47,Default,,0000,0000,0000,,Олар маған ештеңе айтпайды》
Dialogue: 0,0:09:30.47,0:09:33.47,Default,,0000,0000,0000,,《Мен де білмеймін.➡
Dialogue: 0,0:09:33.47,0:09:35.47,Default,,0000,0000,0000,,Кешіріңіз》
Dialogue: 0,0:09:45.48,0:09:49.49,Default,,0000,0000,0000,,Фуми-чан
Dialogue: 0,0:09:45.48,0:09:49.49,Default,,0000,0000,0000,,Сіз Кеса үшін алаңдайсыз, солай ма?
Dialogue: 0,0:09:49.49,0:09:51.49,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:09:51.49,0:09:55.49,Default,,0000,0000,0000,,Жақсы. Анық.
Dialogue: 0,0:09:51.49,0:09:55.49,Default,,0000,0000,0000,,Мен ештеңе уәде еткен жоқпын.
Dialogue: 0,0:09:58.43,0:10:02.43,Default,,0000,0000,0000,,Мен А-чанмен бірге барамын.
Dialogue: 0,0:09:58.43,0:10:02.43,Default,,0000,0000,0000,,Мен енді Сугимото-сенпайды көрмеймін.
Dialogue: 0,0:10:02.43,0:10:04.44,Default,,0000,0000,0000,,Фуми-чан қазірдің өзінде
Dialogue: 0,0:10:04.44,0:10:07.44,Default,,0000,0000,0000,,Бала шағымданады
Dialogue: 0,0:10:04.44,0:10:07.44,Default,,0000,0000,0000,,Себебі бір➡ жоқ
Dialogue: 0,0:10:07.44,0:10:11.44,Default,,0000,0000,0000,,Кіммен жүргенің маңызды емес.
Dialogue: 0,0:10:07.44,0:10:11.44,Default,,0000,0000,0000,,Мен Ах Чанмен барамын
Dialogue: 0,0:10:11.44,0:10:14.45,Default,,0000,0000,0000,,Олай болса, үшеуміз бірге барайық.
Dialogue: 0,0:10:14.45,0:10:17.45,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:10:17.45,0:10:19.45,Default,,0000,0000,0000,,Мен А-чанмен барамын.
Dialogue: 0,0:10:19.45,0:10:21.45,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:10:21.45,0:10:25.46,Default,,0000,0000,0000,,Күткеніңізге рахмет
Dialogue: 0,0:10:21.45,0:10:25.46,Default,,0000,0000,0000,,Екі кесе лимон шайы.
Dialogue: 0,0:10:25.46,0:10:27.46,Default,,0000,0000,0000,,А, иә. Рақмет сізге.
Dialogue: 0,0:10:32.46,0:10:35.47,Default,,0000,0000,0000,,Ах-чанмен жүру қызық.
Dialogue: 0,0:10:35.47,0:10:39.47,Default,,0000,0000,0000,,Бірақ бүгін мен ұмытып кеттім
Dialogue: 0,0:10:41.47,0:10:45.48,Default,,0000,0000,0000,,Фуми-чан шошқалары
Dialogue: 0,0:10:41.47,0:10:45.48,Default,,0000,0000,0000,,Бұл сізге сәйкес келеді. Бұл сүйкімді.
Dialogue: 0,0:10:45.48,0:10:48.48,Default,,0000,0000,0000,,Маған Сугимото-сенпай ұнайды.
Dialogue: 0,0:10:51.48,0:10:53.48,Default,,0000,0000,0000,,Сіз кездесіп жүрсіз бе?
Dialogue: 0,0:10:55.49,0:10:57.49,Default,,0000,0000,0000,,А-чанның мені жек көргенін қаламаймын.
Dialogue: 0,0:10:59.42,0:11:01.42,Default,,0000,0000,0000,,Бұл жиіркенішті деп ойламаңыз
Dialogue: 0,0:11:15.46,0:11:19.46,Default,,0000,0000,0000,,《Әйтеуір, мен солай мойындадым.
Dialogue: 0,0:11:15.46,0:11:19.46,Default,,0000,0000,0000,,Мүмкін бұл кейінірек болғандықтан ыңғайсыз шығар.》
Dialogue: 0,0:11:19.46,0:11:22.47,Default,,0000,0000,0000,,《Маған Сугимото-сенпай ұнайды》
Dialogue: 0,0:11:22.47,0:11:24.47,Default,,0000,0000,0000,,《Сіз кездесіп жүрсіз бе?》
Dialogue: 0,0:11:24.47,0:11:29.47,Default,,0000,0000,0000,,《Әйелді ұнатсам да
Dialogue: 0,0:11:24.47,0:11:29.47,Default,,0000,0000,0000,,Бұл жақсы емес пе? 》
Dialogue: 0,0:11:29.47,0:11:33.47,Default,,0000,0000,0000,,《Менің басым
Dialogue: 0,0:11:29.47,0:11:33.47,Default,,0000,0000,0000,,Тым қарапайым ма? 》
Dialogue: 0,0:11:36.48,0:11:38.48,Default,,0000,0000,0000,,《Бірақ...》
Dialogue: 0,0:11:38.48,0:11:41.48,Default,,0000,0000,0000,,《Мұны жиіркенішті деп ойлама》
Dialogue: 0,0:11:43.49,0:11:47.49,Default,,0000,0000,0000,,《Бұл жиіркенішті.
Dialogue: 0,0:11:43.49,0:11:47.49,Default,,0000,0000,0000,,Мен олай ойламадым》
Dialogue: 0,0:11:49.49,0:11:54.50,Rubi,,0000,0000,0000,,Шинотамаку
Dialogue: 0,0:11:49.49,0:11:54.50,Default,,0000,0000,0000,,«Балаларды қорғау күні
Dialogue: 0,0:11:49.49,0:11:54.50,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:11:49.49,0:11:54.50,Rubi,,0000,0000,0000,,Джин
Dialogue: 0,0:11:49.49,0:11:54.50,Default,,0000,0000,0000,,Әдепті сөздер мен өсиеттер
Dialogue: 0,0:11:54.50,0:11:57.50,Default,,0000,0000,0000,,Ақылды сөз – ақылды...
Dialogue: 0,0:11:57.50,0:12:02.50,Default,,0000,0000,0000,,Ха ха…｡ Кешіріңіз.
Dialogue: 0,0:11:57.50,0:12:02.50,Default,,0000,0000,0000,,Мен ұйықтап қалдым.
Dialogue: 0,0:12:05.53,0:12:07.44,Rubi,,0000,0000,0000,,Йоко
Dialogue: 0,0:12:05.53,0:12:07.44,Default,,0000,0000,0000,,Мен шошқа киюді қойдым.
Dialogue: 0,0:12:05.53,0:12:07.44,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:07.44,0:12:10.44,Default,,0000,0000,0000,,(Йоко)
Dialogue: 0,0:12:07.44,0:12:10.44,Rubi,,0000,0000,0000,,Манджуме
Dialogue: 0,0:12:07.44,0:12:10.44,Default,,0000,0000,0000,,Саған жараса да, Манджоме-сан.
Dialogue: 0,0:12:12.45,0:12:16.45,Rubi,,0000,0000,0000,,Хонацуги
Dialogue: 0,0:12:12.45,0:12:16.45,Default,,0000,0000,0000,,Келесі, Хонацуги мырза
Dialogue: 0,0:12:12.45,0:12:16.45,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:12:20.46,0:12:24.46,Default,,0000,0000,0000,,Келіңіз, Игуми мырза
Dialogue: 0,0:12:20.46,0:12:24.46,Default,,0000,0000,0000,,Хмм?
Dialogue: 0,0:12:24.46,0:12:28.47,Default,,0000,0000,0000,,Маған ұнайтын адам болса
Dialogue: 0,0:12:24.46,0:12:28.47,Default,,0000,0000,0000,,Қыз болса не істер едің?
Dialogue: 0,0:12:28.47,0:12:31.47,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:12:28.47,0:12:31.47,Default,,0000,0000,0000,,Сонымен Ясу-чан, бұл жақсы емес пе?
Dialogue: 0,0:12:31.47,0:12:34.47,Default,,0000,0000,0000,,Жоқ, жоқ. Ал егер?
Dialogue: 0,0:12:34.47,0:12:37.47,Default,,0000,0000,0000,,Ал егер... Эй?
Dialogue: 0,0:12:39.48,0:12:42.48,Default,,0000,0000,0000,,Маған ұнайтын адам болса
Dialogue: 0,0:12:39.48,0:12:42.48,Default,,0000,0000,0000,,Егер бұл қыз болса➡
Dialogue: 0,0:12:42.48,0:12:44.48,Default,,0000,0000,0000,,Окудайра мырза, не істеуіміз керек?
Dialogue: 0,0:12:44.48,0:12:46.48,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:12:48.49,0:12:50.49,Default,,0000,0000,0000,,Маған қолдау көрсеткіңіз келе ме?
Dialogue: 0,0:12:50.49,0:12:54.49,Default,,0000,0000,0000,,Хэхе...｡ Содан кейін
Dialogue: 0,0:12:50.49,0:12:54.49,Default,,0000,0000,0000,,Бұл ең жақсы нәрсе емес пе?
Dialogue: 0,0:12:54.49,0:12:57.49,Default,,0000,0000,0000,,Уау. Хмм.
Dialogue: 0,0:12:57.49,0:12:59.50,Default,,0000,0000,0000,,≪(Студенттер) Жекпе-жек...
Dialogue: 0,0:12:59.50,0:13:01.50,Default,,0000,0000,0000,,Сіз Фудзигаданидесіз бе?
Dialogue: 0,0:13:01.50,0:13:04.50,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:13:01.50,0:13:04.50,Default,,0000,0000,0000,,Сол көңілді жас ханымдар.➡
Dialogue: 0,0:13:04.50,0:13:07.44,Default,,0000,0000,0000,,Пон-чан және т.б
Dialogue: 0,0:13:04.50,0:13:07.44,Default,,0000,0000,0000,,Біз сені өзімізбен бірге алып кетейік.
Dialogue: 0,0:13:07.44,0:13:09.44,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:13:09.44,0:13:12.44,Default,,0000,0000,0000,,Не болды? Барғың келмей ме?
Dialogue: 0,0:13:12.44,0:13:18.45,Default,,0000,0000,0000,,Мен А-чанның аға курсында оқимын.
Dialogue: 0,0:13:12.44,0:13:18.45,Default,,0000,0000,0000,,Мен саған бәрін айттым.
Dialogue: 0,0:13:18.45,0:13:22.45,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:13:18.45,0:13:22.45,Default,,0000,0000,0000,,Сізбен кездескенде қандай тұлға болуым керек...
Dialogue: 0,0:13:22.45,0:13:26.46,Default,,0000,0000,0000,,Фуми таңғажайып
Dialogue: 0,0:13:22.45,0:13:26.46,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:26.46,0:13:30.46,Default,,0000,0000,0000,,Бұл таңқаларлық
Dialogue: 0,0:13:26.46,0:13:30.46,Default,,0000,0000,0000,,Сіз шықтыңыз ба?
Dialogue: 0,0:13:30.46,0:13:32.46,Default,,0000,0000,0000,,Иә... жақсы
Dialogue: 0,0:13:32.46,0:13:37.47,Default,,0000,0000,0000,,Фуми керемет. Ол күшті қыз.
Dialogue: 0,0:13:37.47,0:13:40.47,Default,,0000,0000,0000,,Бұл енді тікенді жол.
Dialogue: 0,0:13:40.47,0:13:44.47,Default,,0000,0000,0000,,Тек A-chan үшін
Dialogue: 0,0:13:40.47,0:13:44.47,Default,,0000,0000,0000,,Мен сенің шындықты білгеніңді қалаймын
Dialogue: 0,0:13:44.47,0:13:48.48,Default,,0000,0000,0000,,Фуми үшін
Dialogue: 0,0:13:44.47,0:13:48.48,Default,,0000,0000,0000,,А-чан ерекше.➡
Dialogue: 0,0:13:48.48,0:13:51.48,Default,,0000,0000,0000,,Сонда бәрі жақсы.
Dialogue: 0,0:13:51.48,0:13:53.48,Default,,0000,0000,0000,,Фудзигаяға барайық
Dialogue: 0,0:13:51.48,0:13:53.48,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:53.48,0:13:56.49,Default,,0000,0000,0000,,Жүр, кеттік.
Dialogue: 0,0:13:56.49,0:13:58.49,Default,,0000,0000,0000,,Могги, бұл өтірік.
Dialogue: 0,0:13:58.49,0:14:00.49,Default,,0000,0000,0000,,Уссу
Dialogue: 0,0:14:00.49,0:14:03.49,Default,,0000,0000,0000,,тағы біраз
Dialogue: 0,0:14:00.49,0:14:03.49,Default,,0000,0000,0000,,Өзіңізбен бірге серігіңізді алып келдіңіз.
Dialogue: 0,0:14:03.49,0:14:05.51,Default,,0000,0000,0000,,(Кёки)
Dialogue: 0,0:14:03.49,0:14:05.51,Default,,0000,0000,0000,,Бұл менің сүйіктім.➡
Dialogue: 0,0:14:05.51,0:14:09.43,Default,,0000,0000,0000,,Мен сені кез келген жерге апарамын
Dialogue: 0,0:14:05.51,0:14:09.43,Default,,0000,0000,0000,,Сіз ханзадасыз ба?
Dialogue: 0,0:14:09.43,0:14:12.44,Default,,0000,0000,0000,,Кагами-сенсей келе ме?
Dialogue: 0,0:14:09.43,0:14:12.44,Default,,0000,0000,0000,,Бұл қызметкерлер бөлмесі емес пе?
Dialogue: 0,0:14:12.44,0:14:14.44,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:14:14.44,0:14:18.44,Default,,0000,0000,0000,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:14:14.44,0:14:18.44,Default,,0000,0000,0000,,Жай ғана сәлем айтыңыз.
Dialogue: 0,0:14:18.44,0:14:20.44,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:14:18.44,0:14:20.44,Default,,0000,0000,0000,,А-чан
Dialogue: 0,0:14:20.44,0:14:23.45,Default,,0000,0000,0000,,Фудзигая шай бөлмесі дегеніміз не?
Dialogue: 0,0:14:20.44,0:14:23.45,Default,,0000,0000,0000,,Біз де бара аламыз ба?
Dialogue: 0,0:14:23.45,0:14:26.45,Default,,0000,0000,0000,,Жоқ... бәрі жақсы.
Dialogue: 0,0:14:23.45,0:14:26.45,Default,,0000,0000,0000,,Тағдырымыз тоғысса екен.
Dialogue: 0,0:14:26.45,0:14:28.45,Default,,0000,0000,0000,,А-чан да барады, солай ма?
Dialogue: 0,0:14:28.45,0:14:30.45,Default,,0000,0000,0000,,Ух... иә
Dialogue: 0,0:14:28.45,0:14:30.45,Default,,0000,0000,0000,,Жарайды, шештім!
Dialogue: 0,0:14:30.45,0:14:32.46,Rubi,,0000,0000,0000,,Мива
Dialogue: 0,0:14:30.45,0:14:32.46,Default,,0000,0000,0000,,Манжоме мырза да
Dialogue: 0,0:14:30.45,0:14:32.46,Default,,0000,0000,0000,,Бар, бар, бар.
Dialogue: 0,0:14:32.46,0:14:35.46,Default,,0000,0000,0000,,Эй... сәл күте тұрыңыз.
Dialogue: 0,0:14:32.46,0:14:35.46,Default,,0000,0000,0000,,Мен барамын, мені қатты итермеңіз.
Dialogue: 0,0:14:39.46,0:14:41.46,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:14:44.47,0:14:47.47,Default,,0000,0000,0000,,Usu! жаттығу?
Dialogue: 0,0:14:44.47,0:14:47.47,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:14:47.47,0:14:51.47,Default,,0000,0000,0000,,Мен бүгін кітап оқимын, сондықтан мұғалімге айтамын
Dialogue: 0,0:14:47.47,0:14:51.47,Default,,0000,0000,0000,,Сәлем берейін деп ойладым.
Dialogue: 0,0:14:53.48,0:14:55.48,Default,,0000,0000,0000,,Қараңдар, қараңдар!
Dialogue: 0,0:14:55.48,0:14:57.48,Default,,0000,0000,0000,,Қоқоншы
Dialogue: 0,0:14:55.48,0:14:57.48,Default,,0000,0000,0000,,Тіпті торт жинағы да бар.
Dialogue: 0,0:14:57.48,0:15:00.48,Default,,0000,0000,0000,,(Мива)
Dialogue: 0,0:14:57.48,0:15:00.48,Default,,0000,0000,0000,,Торт! Мен оны мектепте жей аламын ба?
Dialogue: 0,0:15:00.48,0:15:04.49,Rubi,,0000,0000,0000,,Мисако
Dialogue: 0,0:15:00.48,0:15:04.49,Default,,0000,0000,0000,,Шай да керемет.
Dialogue: 0,0:15:00.48,0:15:04.49,Default,,0000,0000,0000,,ｸｲｰﾝﾏﾘｰ ﾀﾞｰｼﾞﾘﾝ ｵﾚﾝｼﾞﾍﾟｺ｡
Dialogue: 0,0:15:04.49,0:15:06.42,Default,,0000,0000,0000,,Уау
Dialogue: 0,0:15:04.49,0:15:06.42,Default,,0000,0000,0000,,Фуми-чан
Dialogue: 0,0:15:06.42,0:15:08.43,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:15:06.42,0:15:08.43,Default,,0000,0000,0000,,Бүгін➡
Dialogue: 0,0:15:08.43,0:15:12.43,Default,,0000,0000,0000,,Сен мені ұмыттың.
Dialogue: 0,0:15:08.43,0:15:12.43,Default,,0000,0000,0000,,А, бұл...
Dialogue: 0,0:15:14.43,0:15:17.43,Default,,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:15:14.43,0:15:17.43,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:17.43,0:15:21.44,Default,,0000,0000,0000,,Мен, Фуми-чан
Dialogue: 0,0:15:17.43,0:15:21.44,Default,,0000,0000,0000,,Мен сізді қолдағым келеді➡
Dialogue: 0,0:15:21.44,0:15:24.44,Default,,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:15:24.44,0:15:29.45,Default,,0000,0000,0000,,Не? Ал...
Dialogue: 0,0:15:29.45,0:15:31.45,Default,,0000,0000,0000,,Сол сияқты
Dialogue: 0,0:15:29.45,0:15:31.45,Default,,0000,0000,0000,,Иә!?
Dialogue: 0,0:15:33.45,0:15:36.45,Default,,0000,0000,0000,,Ах... Дәл солай. Мен түсінемін.
Dialogue: 0,0:15:36.45,0:15:41.46,Default,,0000,0000,0000,,Мен көремін... көремін. Дәл солай.
Dialogue: 0,0:15:36.45,0:15:41.46,Default,,0000,0000,0000,,Мен мұны байқамадым.
Dialogue: 0,0:15:41.46,0:15:44.46,Default,,0000,0000,0000,,Хехе...
Dialogue: 0,0:15:41.46,0:15:44.46,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:15:44.46,0:15:46.46,Default,,0000,0000,0000,,Хехе...
Dialogue: 0,0:15:46.46,0:15:48.47,Default,,0000,0000,0000,,Эхехе…
Dialogue: 0,0:15:48.47,0:15:50.47,Default,,0000,0000,0000,,(Акира мен Фумидің күлкісі)
Dialogue: 0,0:15:48.47,0:15:50.47,Default,,0000,0000,0000,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:15:50.47,0:15:53.47,Default,,0000,0000,0000,,(Акира мен Фумидің күлкісі)
Dialogue: 0,0:15:50.47,0:15:53.47,Default,,0000,0000,0000,,Ах-чан Манжоме-сан｡➡
Dialogue: 0,0:15:53.47,0:15:55.47,Default,,0000,0000,0000,,Бұйрық шешілді ме?
Dialogue: 0,0:15:55.47,0:15:59.48,Default,,0000,0000,0000,,Мен құлпынай мильфельмін
Dialogue: 0,0:15:55.47,0:15:59.48,Default,,0000,0000,0000,,Мен Гато Шоколатпын
Dialogue: 0,0:15:59.48,0:16:02.48,Default,,0000,0000,0000,,Хехе...
Dialogue: 0,0:15:59.48,0:16:02.48,Default,,0000,0000,0000,,Хехе...
Dialogue: 0,0:16:02.48,0:16:05.48,Default,,0000,0000,0000,,Олай болса, кешіріңіз.
Dialogue: 0,0:16:02.48,0:16:05.48,Default,,0000,0000,0000,,О
Dialogue: 0,0:16:07.42,0:16:09.42,Default,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:16:07.42,0:16:09.42,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:09.42,0:16:12.42,Default,,0000,0000,0000,,Дұрыс
Dialogue: 0,0:16:09.42,0:16:12.42,Default,,0000,0000,0000,,Сахналық қойылымды тамашалауға келіңіздер.➡
Dialogue: 0,0:16:12.42,0:16:14.42,Default,,0000,0000,0000,,Кенже
Dialogue: 0,0:16:12.42,0:16:14.42,Default,,0000,0000,0000,,Хитклифф Мен мұны істеймін.
Dialogue: 0,0:16:14.42,0:16:17.42,Default,,0000,0000,0000,,Әрине. Мен кеңесшімін.
Dialogue: 0,0:16:25.44,0:16:27.44,Default,,0000,0000,0000,,《Себебі мен кеңесшімін》
Dialogue: 0,0:16:32.44,0:16:36.45,Default,,0000,0000,0000,,《Менің бетім
Dialogue: 0,0:16:32.44,0:16:36.45,Default,,0000,0000,0000,,Сіз тербелдіңіз бе? 》
Dialogue: 0,0:16:36.45,0:16:39.45,Default,,0000,0000,0000,,(Васа)
Dialogue: 0,0:16:36.45,0:16:39.45,Default,,0000,0000,0000,,《Сол қолды сәл алға жылжытыңыз》➡
Dialogue: 0,0:16:39.45,0:16:44.45,Default,,0000,0000,0000,,Сонымен, бет бағыты сәл солға қарай.
Dialogue: 0,0:16:39.45,0:16:44.45,Default,,0000,0000,0000,,Иә Жарайды》
Dialogue: 0,0:16:44.45,0:16:57.47,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:16:57.47,0:17:00.47,Default,,0000,0000,0000,,《Кёки-чан
Dialogue: 0,0:16:57.47,0:17:00.47,Default,,0000,0000,0000,,Сюжет өте жақсы》
Dialogue: 0,0:17:00.47,0:17:02.47,Default,,0000,0000,0000,,《Олай емес пе?➡
Dialogue: 0,0:17:02.47,0:17:05.49,Default,,0000,0000,0000,,Орта мектепте оқысаңыз да
Dialogue: 0,0:17:02.47,0:17:05.49,Default,,0000,0000,0000,,Өнер үйірмесіне қатысуыңызды өтінуім керек пе?
Dialogue: 0,0:17:05.49,0:17:07.41,Default,,0000,0000,0000,,《Өнер де жақсы➡
Dialogue: 0,0:17:07.41,0:17:10.41,Default,,0000,0000,0000,,Драма үйірмесіне келсеңіз
Dialogue: 0,0:17:07.41,0:17:10.41,Default,,0000,0000,0000,,Мен бақыттырақ болар едім.》
Dialogue: 0,0:17:10.41,0:17:13.42,Default,,0000,0000,0000,,《О
Dialogue: 0,0:17:10.41,0:17:13.42,Default,,0000,0000,0000,,Өзіңізге барлаушы? 》
Dialogue: 0,0:17:13.42,0:17:16.42,Default,,0000,0000,0000,,《Ахаха…》
Dialogue: 0,0:17:23.43,0:17:26.43,Default,,0000,0000,0000,,(Істер)
Dialogue: 0,0:17:23.43,0:17:26.43,Default,,0000,0000,0000,,《Бұл Сугимотоның арнайы орны》
Dialogue: 0,0:17:28.43,0:17:32.43,Default,,0000,0000,0000,,《Желді желден
Dialogue: 0,0:17:28.43,0:17:32.43,Default,,0000,0000,0000,,Мен оны әрқашан көре аламын》
Dialogue: 0,0:17:34.44,0:17:36.44,Default,,0000,0000,0000,,《Әрқашан...》
Dialogue: 0,0:17:36.44,0:17:52.46,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:17:52.46,0:17:55.46,Default,,0000,0000,0000,,《Ағымдағысы
Dialogue: 0,0:17:52.46,0:17:55.46,Default,,0000,0000,0000,,Сұрамағандай болып көрейік.
Dialogue: 0,0:17:57.46,0:17:59.46,Default,,0000,0000,0000,,《Кешіріңіз》
Dialogue: 0,0:17:59.46,0:18:03.46,Default,,0000,0000,0000,,(Порнарефф) Не дедің!? Жынды! Аузыңды жап!
Dialogue: 0,0:18:07.40,0:18:10.41,Default,,0000,0000,0000,,«Мен ешқашан қол алыспаймын.➡
Dialogue: 0,0:18:10.41,0:18:12.41,Default,,0000,0000,0000,,Сенің де лас болғың келмейді, солай ма? »
Dialogue: 0,0:18:12.41,0:18:16.41,Default,,0000,0000,0000,,«Бетін жуып, шашыңды тарасаң,
Dialogue: 0,0:18:12.41,0:18:16.41,Default,,0000,0000,0000,,Бұл жақсы».
Dialogue: 0,0:18:16.41,0:18:19.41,Default,,0000,0000,0000,,«Маған тиісудің қажеті жоқ.
Dialogue: 0,0:18:16.41,0:18:19.41,Default,,0000,0000,0000,,Мен...» Ах...
Dialogue: 0,0:18:21.42,0:18:25.42,Default,,0000,0000,0000,,Ах... Кешіріңіз.
Dialogue: 0,0:18:21.42,0:18:25.42,Default,,0000,0000,0000,,Жарайды. Содан кейін 5 минуттық үзіліс жасаңыз.
Dialogue: 0,0:18:30.43,0:18:35.43,Default,,0000,0000,0000,,Әй, бұл өнер үйірмесі ме?
Dialogue: 0,0:18:30.43,0:18:35.43,Default,,0000,0000,0000,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:18:35.43,0:18:38.44,Rubi,,0000,0000,0000,,Дауыл
Dialogue: 0,0:18:35.43,0:18:38.44,Rubi,,0000,0000,0000,,Жарайды
Dialogue: 0,0:18:35.43,0:18:38.44,Default,,0000,0000,0000,,Иә. Мен «Шыңғырған биіктердің» постеріне жауапты болдым.➡
Dialogue: 0,0:18:38.44,0:18:41.44,Default,,0000,0000,0000,,Нақты нәрсеге қараңыз
Dialogue: 0,0:18:38.44,0:18:41.44,Default,,0000,0000,0000,,Сіз оны салғыңыз келе ме?
Dialogue: 0,0:18:44.44,0:18:47.44,Default,,0000,0000,0000,,《Тамаша жер》
Dialogue: 0,0:18:52.45,0:18:56.45,Default,,0000,0000,0000,,《Аға
Dialogue: 0,0:18:52.45,0:18:56.45,Default,,0000,0000,0000,,Неге тоқтадың? 》
Dialogue: 0,0:18:58.46,0:19:01.46,Default,,0000,0000,0000,,《Фудзигаданиде
Dialogue: 0,0:18:58.46,0:19:01.46,Default,,0000,0000,0000,,``Library-no-Kimi'' деген адам бар》
Dialogue: 0,0:19:01.46,0:19:03.46,Default,,0000,0000,0000,,《Не?》
Dialogue: 0,0:19:03.46,0:19:09.40,Default,,0000,0000,0000,,《Мұғалім әзілдеді
Dialogue: 0,0:19:03.46,0:19:09.40,Default,,0000,0000,0000,,Кітапты жақсы көретін студентті осылай атасаңыз➡
Dialogue: 0,0:19:09.40,0:19:12.40,Default,,0000,0000,0000,,Бұл лақап ат бүкіл мектепке тарады》
Dialogue: 0,0:19:18.41,0:19:22.41,Default,,0000,0000,0000,,Сіз кітапханадасыз ба?
Dialogue: 0,0:19:18.41,0:19:22.41,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:19:22.41,0:19:26.42,Default,,0000,0000,0000,,Мен бұл туралы ешқашан естіген емеспін.
Dialogue: 0,0:19:22.41,0:19:26.42,Default,,0000,0000,0000,,Сонымен...
Dialogue: 0,0:19:26.42,0:19:28.42,Default,,0000,0000,0000,,Игуми мырза, сіз білесіз бе?
Dialogue: 0,0:19:26.42,0:19:28.42,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:19:28.42,0:19:31.42,Rubi,,0000,0000,0000,,Ивакума
Dialogue: 0,0:19:28.42,0:19:31.42,Default,,0000,0000,0000,,(Ивакума)
Dialogue: 0,0:19:28.42,0:19:31.42,Default,,0000,0000,0000,,Бұл біздің жағдайда мүмкін болуы мүмкін.
Dialogue: 0,0:19:31.42,0:19:34.42,Default,,0000,0000,0000,,Ивакума біледі ме?
Dialogue: 0,0:19:31.42,0:19:34.42,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:19:34.42,0:19:37.43,Default,,0000,0000,0000,,Кітапханадағы мұғалім мен сіздің араңыз
Dialogue: 0,0:19:34.42,0:19:37.43,Default,,0000,0000,0000,,Тыйым салынған махаббат т.б.
Dialogue: 0,0:19:37.43,0:19:41.43,Default,,0000,0000,0000,,Уау, қандай тыйым салынған махаббат?
Dialogue: 0,0:19:37.43,0:19:41.43,Default,,0000,0000,0000,,ұятсыз нәрсе
Dialogue: 0,0:19:41.43,0:19:43.43,Default,,0000,0000,0000,,Сіз нені елестетесіз?
Dialogue: 0,0:19:46.44,0:19:48.44,Default,,0000,0000,0000,,Боу?
Dialogue: 0,0:19:48.44,0:19:53.44,Default,,0000,0000,0000,,Жарайды. Ендеше, бүгінгі күннің бәрі осы.
Dialogue: 0,0:19:48.44,0:19:53.44,Default,,0000,0000,0000,,Еңбегіңіз үшін рахмет!
Dialogue: 0,0:19:53.44,0:19:58.44,Default,,0000,0000,0000,,Боу?
Dialogue: 0,0:20:07.39,0:20:09.39,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:20:07.39,0:20:09.39,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:09.39,0:20:14.39,Default,,0000,0000,0000,,Мм... кітапханада...
Dialogue: 0,0:20:09.39,0:20:14.39,Default,,0000,0000,0000,,Кітапханада не болды?
Dialogue: 0,0:20:18.40,0:20:23.41,Default,,0000,0000,0000,,Ал... мен оқығым келген кітап бар еді.
Dialogue: 0,0:20:18.40,0:20:23.41,Default,,0000,0000,0000,,Қарызға аламын ба деп ойладым.
Dialogue: 0,0:20:23.41,0:20:25.41,Default,,0000,0000,0000,,А-чаннан оны қарызға алуын сұрай аламын ба? ➡
Dialogue: 0,0:20:25.41,0:20:29.41,Default,,0000,0000,0000,,Мен оны сізге тағы да қарызға беремін.
Dialogue: 0,0:20:25.41,0:20:29.41,Default,,0000,0000,0000,,Білмесеңіз жақсы.
Dialogue: 0,0:20:29.41,0:20:31.41,Default,,0000,0000,0000,,көремін. Бұл дұрыс.
Dialogue: 0,0:20:34.42,0:20:39.42,Default,,0000,0000,0000,,《Мен сұрағанымды қалаймын...
Dialogue: 0,0:20:34.42,0:20:39.42,Default,,0000,0000,0000,,Мен неге сұрай алмаймын? 》
Dialogue: 0,0:20:41.42,0:20:48.42,Default,,0000,0000,0000,,《Аға. Сіз кітапханадасыз.
Dialogue: 0,0:20:41.42,0:20:48.42,Default,,0000,0000,0000,,Сіз кім туралы айтып отырсыз? 》
Dialogue: 0,0:20:50.43,0:20:54.44,Default,,0000,0000,0000,,《Маған лақап ат қойған мұғаліммен
Dialogue: 0,0:20:50.43,0:20:54.44,Default,,0000,0000,0000,,Оқушыларға лақап аттар берілген➡
Dialogue: 0,0:20:54.44,0:20:56.44,Default,,0000,0000,0000,,Сіз кімсіз? 》
Dialogue: 0,0:21:01.44,0:21:06.44,Default,,0000,0000,0000,,《Сашизуме
Dialogue: 0,0:21:01.44,0:21:06.44,Default,,0000,0000,0000,,Кітапханада сіз туралы бір жерде》
Dialogue: 0,0:21:10.45,0:21:15.46,Default,,0000,0000,0000,,♬『ｾﾝﾃｨﾌｫﾘｱ』
Dialogue: 0,0:21:15.46,0:21:35.48,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:21:35.48,0:21:53.50,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:21:53.50,0:21:58.50,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:21:58.50,0:22:18.46,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:22:18.46,0:22:28.46,Default,,0000,0000,0000,,♬～
