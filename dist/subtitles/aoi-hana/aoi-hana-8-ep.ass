Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.91,0:00:05.37,Default,,0,0,0,,Бұл қорқынышты болды. Кешіріңіз.
Dialogue: 0,0:00:06.47,0:00:09.47,Default,,0,0,0,,менің сезімдерім
Dialogue: 0,0:00:06.47,0:00:09.47,Default,,0,0,0,,Ұйымдастырылмаған болу➡
Dialogue: 0,0:00:09.47,0:00:11.47,Default,,0,0,0,,Мен бұған Фумиді кінәладым.
Dialogue: 0,0:00:18.48,0:00:21.48,Default,,0,0,0,,(Кёки)
Dialogue: 0,0:00:18.48,0:00:21.48,Default,,0,0,0,,Біз қазіргідей кездесе алмаймыз.
Dialogue: 0,0:00:21.48,0:00:26.49,Default,,0,0,0,,Көк
Dialogue: 0,0:00:21.48,0:00:26.49,Default,,0,0,0,,3D маневрлік жабдықтың табиғи жауы.
Dialogue: 0,0:00:21.48,0:00:26.49,Default,,0,0,0,,♬『Көк гүл』
Dialogue: 0,0:00:26.49,0:00:46.51,Default,,0,0,0,,♬～
Dialogue: 0,0:00:46.51,0:00:55.53,Default,,0,0,0,,♬～
Dialogue: 0,0:00:55.53,0:01:15.47,Default,,0,0,0,,♬～
Dialogue: 0,0:01:15.47,0:01:35.49,Default,,0,0,0,,♬～
Dialogue: 0,0:01:35.49,0:01:49.49,Default,,0,0,0,,♬～
Dialogue: 0,0:01:53.44,0:01:55.44,Default,,0,0,0,,Шинако
Dialogue: 0,0:01:53.44,0:01:55.44,Default,,0,0,0,,Үйге барасыз ба? Бұл жаңбырда?
Dialogue: 0,0:01:55.44,0:01:59.45,Default,,0,0,0,,Не болды? кенеттен
Dialogue: 0,0:01:55.44,0:01:59.45,Default,,0,0,0,,Мен суық тигіземін.
Dialogue: 0,0:01:59.45,0:02:02.45,Default,,0,0,0,,Жарайды
Dialogue: 0,0:01:59.45,0:02:02.45,Default,,0,0,0,,Ал, мен көлікті шығарып салайын.
Dialogue: 0,0:02:02.45,0:02:05.45,Default,,0,0,0,,А... жоқ...
Dialogue: 0,0:02:05.45,0:02:07.45,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:02:09.46,0:02:13.46,Default,,0,0,0,,Казуза
Dialogue: 0,0:02:09.46,0:02:13.46,Default,,0,0,0,,Огино
Dialogue: 0,0:02:09.46,0:02:13.46,Default,,0,0,0,,Васа. Огино мырза, маған қоңырау шалыңыз.
Dialogue: 0,0:02:09.46,0:02:13.46,Default,,0,0,0,,Иә
Dialogue: 0,0:02:16.46,0:02:20.46,Default,,0,0,0,,Сәлем, Ятчан
Dialogue: 0,0:02:16.46,0:02:20.46,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:02:23.47,0:02:28.47,Default,,0,0,0,,А-а... Шынымен де...
Dialogue: 0,0:02:35.48,0:02:37.48,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:02:39.49,0:02:42.49,Default,,0,0,0,,Ум...
Dialogue: 0,0:02:42.49,0:02:44.49,Default,,0,0,0,,Каштан
Dialogue: 0,0:02:42.49,0:02:44.49,Default,,0,0,0,,Мен оны сізге жіберемін.
Dialogue: 0,0:02:52.43,0:02:55.43,Default,,0,0,0,,Кёкимен ұрысып қалдыңыз ба?
Dialogue: 0,0:02:55.43,0:02:59.43,Default,,0,0,0,,Бұл бала бәрібір
Dialogue: 0,0:02:55.43,0:02:59.43,Default,,0,0,0,,Менің ойымша, сіз оны бір жақты ренжіткен шығарсыз.
Dialogue: 0,0:03:05.44,0:03:09.45,Default,,0,0,0,,Сіз драма үйірмесінің кеңесшісісіз бе?
Dialogue: 0,0:03:09.45,0:03:12.45,Default,,0,0,0,,Менің ағама ұнаған адам
Dialogue: 0,0:03:12.45,0:03:18.46,Default,,0,0,0,,Мен көремін. Театр фестивалінде.
Dialogue: 0,0:03:12.45,0:03:18.46,Default,,0,0,0,,Фудзи
Dialogue: 0,0:03:12.45,0:03:18.46,Default,,0,0,0,,Мен бас тартқан адамдардың бәрі бірден жойылды
Dialogue: 0,0:03:12.45,0:03:18.46,Default,,0,0,0,,Фудзи аңғарға келді.➡
Dialogue: 0,0:03:18.46,0:03:22.46,Default,,0,0,0,,Босдық
Dialogue: 0,0:03:18.46,0:03:22.46,Default,,0,0,0,,Кагами-сенсей, мен Васаға үйленемін.
Dialogue: 0,0:03:18.46,0:03:22.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:22.46,0:03:26.47,Default,,0,0,0,,Васа мырза... Сіз апаңызбен біргесіз бе?
Dialogue: 0,0:03:26.47,0:03:28.47,Default,,0,0,0,,Қыркүйек айында
Dialogue: 0,0:03:31.47,0:03:34.47,Default,,0,0,0,,келесі сигнал қайсы?
Dialogue: 0,0:03:43.48,0:03:46.48,Default,,0,0,0,,Қайырлы таң, Фуми-чан!
Dialogue: 0,0:03:50.49,0:03:53.43,Default,,0,0,0,,Әй, қалай болды? Үлкендерімнің арасында
Dialogue: 0,0:03:53.43,0:03:55.43,Default,,0,0,0,,Иә...
Dialogue: 0,0:03:55.43,0:03:58.43,Default,,0,0,0,,Сугимото
Dialogue: 0,0:03:55.43,0:03:58.43,Default,,0,0,0,,Сіз апалы-сіңлілі төрт Сугимотомен кездестіңіз бе?
Dialogue: 0,0:03:58.43,0:04:00.43,Default,,0,0,0,,Иә...
Dialogue: 0,0:04:00.43,0:04:03.43,Default,,0,0,0,,Менің мұғалімім кім болды?
Dialogue: 0,0:04:09.44,0:04:12.45,Default,,0,0,0,,Сәлем А-чан
Dialogue: 0,0:04:09.44,0:04:12.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:12.45,0:04:15.45,Default,,0,0,0,,Бүгін менімен барғың келе ме?
Dialogue: 0,0:04:12.45,0:04:15.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:19.45,0:04:21.45,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:04:21.45,0:04:25.46,Default,,0,0,0,,Окудаира
Dialogue: 0,0:04:21.45,0:04:25.46,Default,,0,0,0,,Аа, Окудайра мырза.
Dialogue: 0,0:04:21.45,0:04:25.46,Default,,0,0,0,,Қара, қара, үлкен жаңалық
Dialogue: 0,0:04:25.46,0:04:27.46,Default,,0,0,0,,Не?
Dialogue: 0,0:04:25.46,0:04:27.46,Default,,0,0,0,,Оны көргенде таң қаласың
Dialogue: 0,0:04:27.46,0:04:30.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:27.46,0:04:30.46,Default,,0,0,0,,Даусыңды естігім келді. Сені көргім келді.
Dialogue: 0,0:04:33.47,0:04:36.47,Default,,0,0,0,,Жақсы істе...
Dialogue: 0,0:04:33.47,0:04:36.47,Default,,0,0,0,,Иә? ➡
Dialogue: 0,0:04:36.47,0:04:39.47,Default,,0,0,0,,«Кагами Сенсейдің үйленуі»➡
Dialogue: 0,0:04:39.47,0:04:42.48,Default,,0,0,0,,О!
Dialogue: 0,0:04:39.47,0:04:42.48,Default,,0,0,0,,Сізді ұрып-соқты.
Dialogue: 0,0:04:42.48,0:04:45.48,Default,,0,0,0,,Жас шамасындағы қыздар➡
Dialogue: 0,0:04:45.48,0:04:48.48,Default,,0,0,0,,Мұндай әңгіме
Dialogue: 0,0:04:45.48,0:04:48.48,Default,,0,0,0,,Ол тез таралады
Dialogue: 0,0:04:48.48,0:04:50.48,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:04:59.43,0:05:09.44,Default,,0,0,0,,♬～
Dialogue: 0,0:05:09.44,0:05:20.45,Default,,0,0,0,,♬～
Dialogue: 0,0:05:20.45,0:05:22.45,Default,,0,0,0,,Киоко
Dialogue: 0,0:05:20.45,0:05:22.45,Default,,0,0,0,,Жыл бойы шорт киетін ұрғашы горилла ма!?
Dialogue: 0,0:05:27.45,0:05:29.46,Default,,0,0,0,,Сугимото Сенпай➡ туралы
Dialogue: 0,0:05:29.46,0:05:32.46,Default,,0,0,0,,Ештеңені білмеймін
Dialogue: 0,0:05:29.46,0:05:32.46,Default,,0,0,0,,Мен саған айттым.
Dialogue: 0,0:05:32.46,0:05:35.46,Default,,0,0,0,,Сіз...
Dialogue: 0,0:05:32.46,0:05:35.46,Default,,0,0,0,,Сугимото неге сонша...
Dialogue: 0,0:05:35.46,0:05:37.46,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,0:05:37.46,0:05:40.46,Default,,0,0,0,,Мен ағамды жақсы көремін.
Dialogue: 0,0:05:37.46,0:05:40.46,Default,,0,0,0,,Біртүрлі ме?
Dialogue: 0,0:05:42.47,0:05:46.47,Default,,0,0,0,,Менің ағам ұстазым туралы.
Dialogue: 0,0:05:42.47,0:05:46.47,Default,,0,0,0,,Сізге ұнады, солай емес пе?
Dialogue: 0,0:05:46.47,0:05:48.47,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:05:48.47,0:05:52.41,Default,,0,0,0,,(Киоко)
Dialogue: 0,0:05:48.47,0:05:52.41,Default,,0,0,0,,Өйткені менің ағам жылап жатыр...｡➡
Dialogue: 0,0:05:52.41,0:05:56.41,Default,,0,0,0,,Өйткені... менің ағам...
Dialogue: 0,0:06:06.43,0:06:08.43,Default,,0,0,0,,《Дұрыс...》
Dialogue: 0,0:06:10.43,0:06:13.43,Default,,0,0,0,,《Мен сені қатты жақсы көрдім...》
Dialogue: 0,0:06:16.44,0:06:18.44,Default,,0,0,0,,《Әпкенің сүйіктісі》
Dialogue: 0,0:06:29.45,0:06:34.45,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:06:29.45,0:06:34.45,Default,,0,0,0,,Фуми-чан, бұл біртүрлі.
Dialogue: 0,0:06:34.45,0:06:37.45,Default,,0,0,0,,Сен ағаңмен тағы ұрысып қалдың ба?
Dialogue: 0,0:06:39.46,0:06:41.46,Default,,0,0,0,,Мені тастап кетті.
Dialogue: 0,0:06:39.46,0:06:41.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:41.46,0:06:43.46,Default,,0,0,0,,Иә...
Dialogue: 0,0:06:49.47,0:06:51.47,Default,,0,0,0,,Уф
Dialogue: 0,0:06:53.41,0:06:56.41,Default,,0,0,0,,Қайырлы таң, А-чан.➡
Dialogue: 0,0:06:56.41,0:06:58.41,Default,,0,0,0,,Фуми бар ма?
Dialogue: 0,0:06:58.41,0:07:02.41,Default,,0,0,0,,Фуми-чан, мен бүгін өзімді жақсы сезінбеймін.
Dialogue: 0,0:06:58.41,0:07:02.41,Default,,0,0,0,,Ол үзіліс жасайтын сияқты.
Dialogue: 0,0:07:06.42,0:07:08.42,Default,,0,0,0,,Сіз ашулысыз ба?
Dialogue: 0,0:07:08.42,0:07:11.42,Default,,0,0,0,,Мен ашуланбаймын
Dialogue: 0,0:07:11.42,0:07:14.43,Default,,0,0,0,,Бұлай ашуланба
Dialogue: 0,0:07:14.43,0:07:17.43,Default,,0,0,0,,(Тежегіш дыбысы)
Dialogue: 0,0:07:21.43,0:07:24.44,Default,,0,0,0,,Вадазука
Dialogue: 0,0:07:21.43,0:07:24.44,Default,,0,0,0,,[Майк] (Хабарландыру) Вадазука. Вадазука
Dialogue: 0,0:07:24.44,0:07:27.44,Default,,0,0,0,,Түсейік
Dialogue: 0,0:07:24.44,0:07:27.44,Default,,0,0,0,,Эй... сәл күте тұрыңыз.
Dialogue: 0,0:07:29.44,0:07:34.44,Default,,0,0,0,,Мен барғым келетін дүкен бар.
Dialogue: 0,0:07:29.44,0:07:34.44,Default,,0,0,0,,Не? Ааа...
Dialogue: 0,0:07:49.46,0:07:54.40,Default,,0,0,0,,Анмитсу кремі
Dialogue: 0,0:07:49.46,0:07:54.40,Default,,0,0,0,,Ұзақ күткеніңізге рахмет.
Dialogue: 0,0:07:54.40,0:07:57.40,Default,,0,0,0,,(Кёки)
Dialogue: 0,0:07:54.40,0:07:57.40,Default,,0,0,0,,Фуми қызыл бұршақ пастасын ұнатпайды, солай ма?
Dialogue: 0,0:07:57.40,0:08:01.41,Default,,0,0,0,,Фуми-чанның охаги
Dialogue: 0,0:07:57.40,0:08:01.41,Default,,0,0,0,,Мен оны үнемі жейтінмін.
Dialogue: 0,0:08:01.41,0:08:03.41,Default,,0,0,0,,Сіз осылай айттыңыз.
Dialogue: 0,0:08:03.41,0:08:06.41,Default,,0,0,0,,Фуми әрқашан
Dialogue: 0,0:08:03.41,0:08:06.41,Default,,0,0,0,,Өйткені мен А-чан туралы айттым.
Dialogue: 0,0:08:06.41,0:08:09.42,Default,,0,0,0,,Шектенбеңіз!
Dialogue: 0,0:08:06.41,0:08:09.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:09.42,0:08:13.42,Default,,0,0,0,,Неліктен Фуми-чан?
Dialogue: 0,0:08:09.42,0:08:13.42,Default,,0,0,0,,Сіз оны шайқадыңыз ба?
Dialogue: 0,0:08:13.42,0:08:16.42,Default,,0,0,0,,Цубаки суық тигізіп алды ма!?
Dialogue: 0,0:08:16.42,0:08:18.42,Default,,0,0,0,,Бұл қорқынышты...
Dialogue: 0,0:08:21.43,0:08:24.43,Default,,0,0,0,,Сізге Кагами-сенсей ұнай ма?
Dialogue: 0,0:08:24.43,0:08:28.43,Default,,0,0,0,,Маған ұнады
Dialogue: 0,0:08:24.43,0:08:28.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:28.43,0:08:31.44,Default,,0,0,0,,Сізге әлі де ұнайды ма?
Dialogue: 0,0:08:31.44,0:08:34.44,Default,,0,0,0,,үшін бір нәрсені сұрайды.
Dialogue: 0,0:08:38.44,0:08:40.45,Default,,0,0,0,,Мұғалім апамның сүйіктісі➡
Dialogue: 0,0:08:40.45,0:08:44.45,Default,,0,0,0,,Мен
Dialogue: 0,0:08:40.45,0:08:44.45,Default,,0,0,0,,Мен әрқашан Йококойды жақсы көретінмін.➡
Dialogue: 0,0:08:44.45,0:08:47.45,Default,,0,0,0,,Құттықтаймыз, біз үйленеміз деп шештік...
Dialogue: 0,0:08:44.45,0:08:47.45,Default,,0,0,0,,Ах
Dialogue: 0,0:08:50.46,0:08:53.46,Default,,0,0,0,,Мен қатты таң қалдым.
Dialogue: 0,0:08:50.46,0:08:53.46,Default,,0,0,0,,Мен олай ойламадым.
Dialogue: 0,0:08:55.39,0:09:15.41,Default,,0,0,0,,♬～
Dialogue: 0,0:09:15.41,0:09:24.42,Default,,0,0,0,,♬～
Dialogue: 0,0:09:24.42,0:09:27.43,Default,,0,0,0,,Йоши
Dialogue: 0,0:09:24.42,0:09:27.43,Default,,0,0,0,,Иә.➡
Dialogue: 0,0:09:27.43,0:09:31.43,Default,,0,0,0,,О? не болды? А-чан
Dialogue: 0,0:09:27.43,0:09:31.43,Default,,0,0,0,,(Цубаки) Шынын айтсам, мен оның бармағанын қалаймын.
Dialogue: 0,0:09:31.43,0:09:35.43,Default,,0,0,0,,Бүгін...
Dialogue: 0,0:09:31.43,0:09:35.43,Default,,0,0,0,,Сабақ тек таңғы уақытта жүргізіледі➡
Dialogue: 0,0:09:35.43,0:09:38.44,Default,,0,0,0,,Фуми-чанға бару
Dialogue: 0,0:09:35.43,0:09:38.44,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:09:38.44,0:09:42.44,Default,,0,0,0,,≪(Ёши) А-чанды шақырамыз.
Dialogue: 0,0:09:38.44,0:09:42.44,Default,,0,0,0,,≪Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:09:44.44,0:09:48.45,Default,,0,0,0,,≪
Dialogue: 0,0:09:48.45,0:09:50.45,Default,,0,0,0,,Иә
Dialogue: 0,0:09:50.45,0:09:55.39,Default,,0,0,0,,Ах, өзін-өзі жек көру.
Dialogue: 0,0:09:50.45,0:09:55.39,Default,,0,0,0,,Ах... Ах-чан?
Dialogue: 0,0:09:55.39,0:09:58.39,Default,,0,0,0,,Фуми-чан
Dialogue: 0,0:09:55.39,0:09:58.39,Default,,0,0,0,,Сіз бүгін сабақты жібердіңіз.
Dialogue: 0,0:09:58.39,0:10:01.39,Default,,0,0,0,,Не? Ал...
Dialogue: 0,0:10:01.39,0:10:05.39,Default,,0,0,0,,Мен де әлсіреп қалдым.
Dialogue: 0,0:10:01.39,0:10:05.39,Default,,0,0,0,,Не? не болды?
Dialogue: 0,0:10:07.40,0:10:11.40,Default,,0,0,0,,Сіз ашуланбайсыз ба?
Dialogue: 0,0:10:07.40,0:10:11.40,Default,,0,0,0,,Мен? Неліктен?
Dialogue: 0,0:10:11.40,0:10:15.41,Default,,0,0,0,,Мен ағамды сұрадым.
Dialogue: 0,0:10:11.40,0:10:15.41,Default,,0,0,0,,Иә!?
Dialogue: 0,0:10:15.41,0:10:21.41,Default,,0,0,0,,Өйткені бұл қорқынышты және ерікті...
Dialogue: 0,0:10:15.41,0:10:21.41,Default,,0,0,0,,Мен оны кешіре алмадым
Dialogue: 0,0:10:25.42,0:10:31.42,Default,,0,0,0,,Аа, бұл екі адамның арасындағы мәселе.
Dialogue: 0,0:10:25.42,0:10:31.42,Default,,0,0,0,,Маған неге араласып тұрсың?
Dialogue: 0,0:10:35.43,0:10:38.43,Default,,0,0,0,,А-чан деген кім?
Dialogue: 0,0:10:35.43,0:10:38.43,Default,,0,0,0,,Өте жақсы адам
Dialogue: 0,0:10:38.43,0:10:43.44,Default,,0,0,0,,Менің өлгім келеді...
Dialogue: 0,0:10:38.43,0:10:43.44,Default,,0,0,0,,Енді бұл туралы алаңдамау керек болса
Dialogue: 0,0:10:43.44,0:10:45.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:51.46,0:10:53.46,Default,,0,0,0,,《Рахмет А-чан》
Dialogue: 0,0:11:02.44,0:11:05.44,Default,,0,0,0,,≪(Студенттік қолдау)
Dialogue: 0,0:11:02.44,0:11:05.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:05.44,0:11:07.44,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:11:16.46,0:11:19.46,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:11:23.46,0:11:43.48,Default,,0,0,0,,♬～
Dialogue: 0,0:11:43.48,0:12:03.44,Default,,0,0,0,,♬～
Dialogue: 0,0:12:03.44,0:12:23.46,Default,,0,0,0,,♬～
Dialogue: 0,0:12:23.46,0:12:27.46,Default,,0,0,0,,♬～
Dialogue: 0,0:12:30.46,0:12:33.47,Default,,0,0,0,,Мисако
Dialogue: 0,0:12:30.46,0:12:33.47,Default,,0,0,0,,Жазғы демалыс!
Dialogue: 0,0:12:30.46,0:12:33.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:33.47,0:12:38.47,Default,,0,0,0,,Йоко
Dialogue: 0,0:12:33.47,0:12:38.47,Default,,0,0,0,,Қараңызшы, мен тыңдамадым.
Dialogue: 0,0:12:33.47,0:12:38.47,Default,,0,0,0,,Қазірдің өзінде жазғы демалыс!
Dialogue: 0,0:12:38.47,0:12:41.47,Default,,0,0,0,,Мива
Dialogue: 0,0:12:38.47,0:12:41.47,Default,,0,0,0,,(Мива)
Dialogue: 0,0:12:38.47,0:12:41.47,Default,,0,0,0,,Бәріміз бір жерге барайық
Dialogue: 0,0:12:41.47,0:12:43.48,Default,,0,0,0,,А... дұрыс.
Dialogue: 0,0:12:43.48,0:12:46.48,Default,,0,0,0,,Құрметпен айтсам, Басшының орынбасары,
Dialogue: 0,0:12:43.48,0:12:46.48,Default,,0,0,0,,А-чанды шақырсам, ол келе ме?
Dialogue: 0,0:12:46.48,0:12:48.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:48.48,0:12:52.48,Default,,0,0,0,,Вилла!? Уау, бұл керемет!
Dialogue: 0,0:12:52.48,0:12:56.49,Default,,0,0,0,,Мынау да.
Dialogue: 0,0:12:52.48,0:12:56.49,Default,,0,0,0,,Жыл сайын Ясу-чанның үйімен
Dialogue: 0,0:12:52.48,0:12:56.49,Default,,0,0,0,,Мен сенімен баруым керек.
Dialogue: 0,0:12:56.49,0:13:00.43,Default,,0,0,0,,Олай болса, Окудайра мырза да бізбен бірге болса.
Dialogue: 0,0:12:56.49,0:13:00.43,Default,,0,0,0,,Мен бұл қызықты болады деп ойладым
Dialogue: 0,0:13:00.43,0:13:03.43,Default,,0,0,0,,Иә, мен де? Бірақ...
Dialogue: 0,0:13:03.43,0:13:07.43,Default,,0,0,0,,Жалғыз болсаңыз және өзіңізді жалғыз сезінсеңіз
Dialogue: 0,0:13:03.43,0:13:07.43,Default,,0,0,0,,Сол адамдарды да шақыр...｡➡
Dialogue: 0,0:13:07.43,0:13:12.44,Default,,0,0,0,,Мацуока
Dialogue: 0,0:13:07.43,0:13:12.44,Default,,0,0,0,,Мына жігерлі Мацуоканы қарашы...
Dialogue: 0,0:13:07.43,0:13:12.44,Default,,0,0,0,,А, Пон-чан және басқалары?
Dialogue: 0,0:13:12.44,0:13:18.44,Default,,0,0,0,,Иә. Ал...
Dialogue: 0,0:13:12.44,0:13:18.44,Default,,0,0,0,,Манджоме
Dialogue: 0,0:13:12.44,0:13:18.44,Default,,0,0,0,,Манжоме-сан да, егер қаласаңыз.
Dialogue: 0,0:13:18.44,0:13:23.45,Default,,0,0,0,,Мен оны артық деп айтпаймын, бірақ...
Dialogue: 0,0:13:18.44,0:13:23.45,Default,,0,0,0,,Үлкен топта қызық емес пе?
Dialogue: 0,0:13:23.45,0:13:25.45,Default,,0,0,0,,Уау, тамаша! Бұл жақсы!
Dialogue: 0,0:13:25.45,0:13:28.45,Default,,0,0,0,,Фуми-чан да бұзылды
Dialogue: 0,0:13:25.45,0:13:28.45,Default,,0,0,0,,Өзіңізді жақсы сезінуіңіз мүмкін! Ах...
Dialogue: 0,0:13:28.45,0:13:32.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:28.45,0:13:32.46,Default,,0,0,0,,А... жоқ, бұл...
Dialogue: 0,0:13:32.46,0:13:36.46,Default,,0,0,0,,А, бұл менмін.
Dialogue: 0,0:13:32.46,0:13:36.46,Default,,0,0,0,,Неліктен әрқашан осылай болады?
Dialogue: 0,0:13:36.46,0:13:40.47,Default,,0,0,0,,Манджоме-сан, не болды?
Dialogue: 0,0:13:40.47,0:13:44.47,Default,,0,0,0,,Егер айту қиын болса
Dialogue: 0,0:13:40.47,0:13:44.47,Default,,0,0,0,,Мұны айтудың қажеті жоқ.
Dialogue: 0,0:13:44.47,0:13:49.47,Default,,0,0,0,,Білесің бе, Фуми-чан?
Dialogue: 0,0:13:44.47,0:13:49.47,Default,,0,0,0,,Мен ағаммен ажырастым.
Dialogue: 0,0:13:52.48,0:13:55.48,Default,,0,0,0,,Мен бұлай айтпауым керек еді.
Dialogue: 0,0:13:52.48,0:13:55.48,Default,,0,0,0,,Хе-хе-хе-хе. Міне, 1-курстың үшеуіміз ақыры бірге жиналдық
Dialogue: 0,0:13:55.48,0:13:59.42,Default,,0,0,0,,Сосын орнына
Dialogue: 0,0:13:55.48,0:13:59.42,Default,,0,0,0,,Менімен кездесуге ыңғайсыз ба?
Dialogue: 0,0:13:59.42,0:14:02.42,Default,,0,0,0,,Ал, мен жай ғана сұрайын.
Dialogue: 0,0:14:08.43,0:14:12.43,Default,,0,0,0,,Сіз клуб іс-шараларындасыз
Dialogue: 0,0:14:08.43,0:14:12.43,Default,,0,0,0,,Сен зейініңді жинақтауың керек емес пе? ➡
Dialogue: 0,0:14:12.43,0:14:15.43,Default,,0,0,0,,Қолың бос болса, маған шай дайында.
Dialogue: 0,0:14:12.43,0:14:15.43,Default,,0,0,0,,Менің уақытым жоқ
Dialogue: 0,0:14:15.43,0:14:19.43,Default,,0,0,0,,Содан кейін үйірме жұмыстарына барыңыз.
Dialogue: 0,0:14:15.43,0:14:19.43,Default,,0,0,0,,Үйірме жұмыстарына қатысу
Dialogue: 0,0:14:27.45,0:14:30.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:27.45,0:14:30.45,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:14:30.45,0:14:34.45,Default,,0,0,0,,≪(Каори) Манжоме-сан, маған шай құйып берші.
Dialogue: 0,0:14:30.45,0:14:34.45,Default,,0,0,0,,Ашық көк аю
Dialogue: 0,0:14:34.45,0:14:39.46,Default,,0,0,0,,≪Аа, иә. Содан кейін мен
Dialogue: 0,0:14:34.45,0:14:39.46,Default,,0,0,0,,Апельсин мысық Итадакимасу
Dialogue: 0,0:14:39.46,0:14:41.46,Default,,0,0,0,,Иә
Dialogue: 0,0:14:57.49,0:15:01.41,Default,,0,0,0,,Көптен бері көрмеген
Dialogue: 0,0:14:57.49,0:15:01.41,Default,,0,0,0,,Иә
Dialogue: 0,0:15:01.41,0:15:04.42,Default,,0,0,0,,Не?
Dialogue: 0,0:15:01.41,0:15:04.42,Default,,0,0,0,,Иә.➡
Dialogue: 0,0:15:04.42,0:15:09.42,Default,,0,0,0,,Бұл
Dialogue: 0,0:15:04.42,0:15:09.42,Default,,0,0,0,,Мен Манджоме екеуміздің ажырасқанымызды естідім...
Dialogue: 0,0:15:09.42,0:15:13.43,Default,,0,0,0,,Сіз кімнен сұрадыңыз?
Dialogue: 0,0:15:09.42,0:15:13.43,Default,,0,0,0,,Бұл А-чан ба?
Dialogue: 0,0:15:13.43,0:15:15.43,Default,,0,0,0,,Ол сөйлейтін кішкентай бала.
Dialogue: 0,0:15:15.43,0:15:18.43,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:15:15.43,0:15:18.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:18.43,0:15:21.43,Default,,0,0,0,,Сіз келесіде боламын деп ойладыңыз ба?
Dialogue: 0,0:15:18.43,0:15:21.43,Default,,0,0,0,,Уф, суық қой!
Dialogue: 0,0:15:27.44,0:15:31.44,Default,,0,0,0,,Өтірік. Кешіріңіз, қазір ештеңе жоқ.
Dialogue: 0,0:15:27.44,0:15:31.44,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:15:33.45,0:15:35.45,Default,,0,0,0,,Менің ойымша, бұл дұрыс.
Dialogue: 0,0:15:37.45,0:15:39.45,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:15:39.45,0:15:42.45,Default,,0,0,0,,Маған үзіліс беріңіз.
Dialogue: 0,0:15:42.45,0:15:45.46,Default,,0,0,0,,Ах
Dialogue: 0,0:15:45.46,0:15:48.46,Default,,0,0,0,,Сенпай. Жазғы демалыс.
Dialogue: 0,0:15:45.46,0:15:48.46,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:15:48.46,0:15:52.46,Default,,0,0,0,,Сондай-ақ сурет
Dialogue: 0,0:15:48.46,0:15:52.46,Default,,0,0,0,,Мен келіп, үйрене аламын ба?
Dialogue: 0,0:15:52.46,0:15:55.47,Default,,0,0,0,,Келу сіздің таңдауыңыз.
Dialogue: 0,0:15:52.46,0:15:55.47,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:15:55.47,0:15:58.40,Default,,0,0,0,,(Киоко)
Dialogue: 0,0:15:55.47,0:15:58.40,Default,,0,0,0,,Сізге Кагами-сенсей ұнай ма?
Dialogue: 0,0:15:58.40,0:16:02.41,Default,,0,0,0,,(Кёки)
Dialogue: 0,0:15:58.40,0:16:02.41,Default,,0,0,0,,Әңгіменің жылдам ілгерілеуіне ілесе алмаймын.
Dialogue: 0,0:16:02.41,0:16:06.41,Default,,0,0,0,,(Киоко)
Dialogue: 0,0:16:02.41,0:16:06.41,Default,,0,0,0,,Менің ағамды намыссыз адам деп ойлаймын.
Dialogue: 0,0:16:06.41,0:16:08.41,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:16:08.41,0:16:11.42,Default,,0,0,0,,Бірақ мен
Dialogue: 0,0:16:08.41,0:16:11.42,Default,,0,0,0,,Мен ағамды жақсы көремін.
Dialogue: 0,0:16:11.42,0:16:15.42,Default,,0,0,0,,Табанды әйелді жек көреді
Dialogue: 0,0:16:11.42,0:16:15.42,Default,,0,0,0,,Сенпай да.
Dialogue: 0,0:16:18.42,0:16:22.43,Default,,0,0,0,,Сен мені ұрдың.
Dialogue: 0,0:16:18.42,0:16:22.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:22.43,0:16:25.43,Default,,0,0,0,,Сіздің хоббиіңіз - жауапсыз махаббат.
Dialogue: 0,0:16:22.43,0:16:25.43,Default,,0,0,0,,Мен...
Dialogue: 0,0:16:25.43,0:16:28.43,Default,,0,0,0,,Менің ондай хоббиім жоқ.
Dialogue: 0,0:16:28.43,0:16:32.44,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:16:28.43,0:16:32.44,Default,,0,0,0,,Біртүрлі күту тітіркендіргіш.
Dialogue: 0,0:16:32.44,0:16:36.44,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:32.44,0:16:36.44,Default,,0,0,0,,Мен артық айтпаймын
Dialogue: 0,0:16:38.44,0:16:43.45,Default,,0,0,0,,Әзірге
Dialogue: 0,0:16:38.44,0:16:43.45,Default,,0,0,0,,Картинаны апама айтамын.
Dialogue: 0,0:16:43.45,0:16:45.45,Default,,0,0,0,,Мен бұл жолы дұрыс қатысамын.
Dialogue: 0,0:16:47.45,0:16:51.46,Default,,0,0,0,,Киоко-чан...
Dialogue: 0,0:16:47.45,0:16:51.46,Default,,0,0,0,,Киоко-чан｡➡
Dialogue: 0,0:16:51.46,0:16:55.46,Default,,0,0,0,,А, міне, сіз болдыңыз.
Dialogue: 0,0:16:51.46,0:16:55.46,Default,,0,0,0,,Не, Киоко-чан?
Dialogue: 0,0:16:55.46,0:16:58.40,Default,,0,0,0,,Икуми
Dialogue: 0,0:16:55.46,0:16:58.40,Default,,0,0,0,,Игуми
Dialogue: 0,0:16:55.46,0:16:58.40,Default,,0,0,0,,Бұл дұрыс, дұрыс.
Dialogue: 0,0:16:58.40,0:17:01.40,Default,,0,0,0,,Тек бірінші рет
Dialogue: 0,0:16:58.40,0:17:01.40,Default,,0,0,0,,Одан кейін ол келмеді.
Dialogue: 0,0:17:01.40,0:17:04.40,Default,,0,0,0,,Оқыту әдісі нашар болған шығар.
Dialogue: 0,0:17:04.40,0:17:07.41,Default,,0,0,0,,Киоко мені көргісі келеді
Dialogue: 0,0:17:04.40,0:17:07.41,Default,,0,0,0,,Мен жаңа ғана келдім.
Dialogue: 0,0:17:07.41,0:17:10.41,Default,,0,0,0,,Е. Сонымен, Якчан туралы.
Dialogue: 0,0:17:07.41,0:17:10.41,Default,,0,0,0,,Себебі мен оны жек көре бастадым➡
Dialogue: 0,0:17:10.41,0:17:12.41,Default,,0,0,0,,Сіз келуді тоқтаттыңыз ба?
Dialogue: 0,0:17:12.41,0:17:17.41,Default,,0,0,0,,Себебі мен оны шайқадым.
Dialogue: 0,0:17:12.41,0:17:17.41,Default,,0,0,0,,Әй, бейшара.
Dialogue: 0,0:17:25.42,0:17:31.43,Default,,0,0,0,,Васа-чан Теса сурет салғанда
Dialogue: 0,0:17:25.42,0:17:31.43,Default,,0,0,0,,Сіз ер адамға ұқсайсыз. Сондай-ақ, сіздің киіміңіз.
Dialogue: 0,0:17:31.43,0:17:35.43,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:17:31.43,0:17:35.43,Default,,0,0,0,,Сіздің аяқтарыңыз алшақ болады.
Dialogue: 0,0:17:35.43,0:17:38.44,Default,,0,0,0,,Бұл тамаша
Dialogue: 0,0:17:38.44,0:17:40.44,Default,,0,0,0,,Вилла…
Dialogue: 0,0:17:40.44,0:17:43.44,Default,,0,0,0,,Сәлем. Игуми мырза, бұл керемет.
Dialogue: 0,0:17:43.44,0:17:45.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:45.44,0:17:48.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:48.45,0:17:51.45,Default,,0,0,0,,Ұнамаса бас тартуға болады.
Dialogue: 0,0:17:48.45,0:17:51.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:51.45,0:17:53.45,Default,,0,0,0,,Бірақ
Dialogue: 0,0:17:51.45,0:17:53.45,Default,,0,0,0,,А-чан, сенің барғың келеді, солай ма?
Dialogue: 0,0:17:53.45,0:17:57.47,Default,,0,0,0,,Жарайды, Фуми-чан бармаса да.
Dialogue: 0,0:17:53.45,0:17:57.47,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:17:57.47,0:18:01.39,Default,,0,0,0,,Сондықтан бұл туралы алаңдамаңыз.
Dialogue: 0,0:17:57.47,0:18:01.39,Default,,0,0,0,,Салқын.
Dialogue: 0,0:18:01.39,0:18:03.40,Default,,0,0,0,,Хмм
Dialogue: 0,0:18:03.40,0:18:06.40,Default,,0,0,0,,Сіз мұны жасадыңыз. Эй!
Dialogue: 0,0:18:03.40,0:18:06.40,Default,,0,0,0,,Аха…
Dialogue: 0,0:18:06.40,0:18:08.40,Default,,0,0,0,,Мен де барамын
Dialogue: 0,0:18:08.40,0:18:12.40,Default,,0,0,0,,және мен қашып жүрген адамға айналып, сатқын ретінде қуғынға ұшырадым.
Dialogue: 0,0:18:08.40,0:18:12.40,Default,,0,0,0,,Менде жоқ.
Dialogue: 0,0:18:12.40,0:18:15.41,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:18:12.40,0:18:15.41,Default,,0,0,0,,Алдымен саусақтарыңды найза пішініне келтір.
Dialogue: 0,0:18:15.41,0:18:20.41,Default,,0,0,0,,Игуми мырза және «Сугимото Сенпайдың жауапсыз махаббат альянсы»
Dialogue: 0,0:18:15.41,0:18:20.41,Default,,0,0,0,,Ештеңе жасамаңыз.
Dialogue: 0,0:18:20.41,0:18:23.42,Default,,0,0,0,,Мен бұдан былай үлгермеймін.
Dialogue: 0,0:18:23.42,0:18:28.42,Default,,0,0,0,,Бұл сіздің үлкендеріңіз туралы рас.
Dialogue: 0,0:18:23.42,0:18:28.42,Default,,0,0,0,,Мен сені енді онша ұнатпаймын
Dialogue: 0,0:18:30.42,0:18:32.42,Default,,0,0,0,,Күшті болу
Dialogue: 0,0:18:36.43,0:18:39.43,Default,,0,0,0,,《Мен батыл емеспін》
Dialogue: 0,0:18:39.43,0:18:42.43,Default,,0,0,0,,《Мені жақсы сезінген нәрсе➡
Dialogue: 0,0:18:42.43,0:18:46.43,Default,,0,0,0,,Сау болайық
Dialogue: 0,0:18:42.43,0:18:46.43,Default,,0,0,0,,Менің ойлағаным...》
Dialogue: 0,0:18:48.44,0:18:51.44,Default,,0,0,0,,《А-чанға рахмет》
Dialogue: 0,0:18:58.38,0:19:01.39,Default,,0,0,0,,Хонацуги
Dialogue: 0,0:18:58.38,0:19:01.39,Default,,0,0,0,,Хонацуги мырза және т.б
Dialogue: 0,0:18:58.38,0:19:01.39,Default,,0,0,0,,Мен өте қуаныштымын➡
Dialogue: 0,0:19:01.39,0:19:03.39,Default,,0,0,0,,Бұдан былай
Dialogue: 0,0:19:01.39,0:19:03.39,Default,,0,0,0,,Мен баруға өте қуаныштымын.
Dialogue: 0,0:19:03.39,0:19:07.39,Default,,0,0,0,,Иә, бұл жақсы болды.
Dialogue: 0,0:19:03.39,0:19:07.39,Default,,0,0,0,,Мм... вилла ше?
Dialogue: 0,0:19:07.39,0:19:11.40,Default,,0,0,0,,Тазалық
Dialogue: 0,0:19:07.39,0:19:11.40,Default,,0,0,0,,Киёсато
Dialogue: 0,0:19:07.39,0:19:11.40,Default,,0,0,0,,Киёсато... Яманаши?
Dialogue: 0,0:19:11.40,0:19:14.40,Default,,0,0,0,,Яманаши дегенде көз алдыңызға жүзім мен шабдалы келеді.
Dialogue: 0,0:19:11.40,0:19:14.40,Default,,0,0,0,,Шие және ➡
Dialogue: 0,0:19:14.40,0:19:17.40,Default,,0,0,0,,Бірақ бұл ыстық, солай емес пе?
Dialogue: 0,0:19:17.40,0:19:21.41,Default,,0,0,0,,Енді Окудайра мырза
Dialogue: 0,0:19:17.40,0:19:21.41,Default,,0,0,0,,Мен тек тамақ ішемін
Dialogue: 0,0:19:21.41,0:19:24.41,Default,,0,0,0,,Рас
Dialogue: 0,0:19:21.41,0:19:24.41,Default,,0,0,0,,Хехе...
Dialogue: 0,0:19:24.41,0:19:26.41,Default,,0,0,0,,А-чан деген кім?
Dialogue: 0,0:19:24.41,0:19:26.41,Default,,0,0,0,,Көптен бері солай.
Dialogue: 0,0:19:26.41,0:19:30.42,Default,,0,0,0,,Түс кезінде мен кенеттен жігерлі сезінемін.
Dialogue: 0,0:19:26.41,0:19:30.42,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:19:30.42,0:19:34.42,Default,,0,0,0,,Ал, онда мен...
Dialogue: 0,0:19:30.42,0:19:34.42,Default,,0,0,0,,Гүл терейік...
Dialogue: 0,0:19:38.42,0:19:41.43,Default,,0,0,0,,Окудаира мырза аңқау.
Dialogue: 0,0:19:38.42,0:19:41.43,Default,,0,0,0,,Мұнда басшының жеке гвардиясы орналасқан
Dialogue: 0,0:19:41.43,0:19:44.43,Default,,0,0,0,,Хехе...
Dialogue: 0,0:19:41.43,0:19:44.43,Default,,0,0,0,,Хехе...
Dialogue: 0,0:19:54.44,0:19:56.44,Default,,0,0,0,,Сіз ағаңызды әлі де жақсы көресіз бе?
Dialogue: 0,0:19:56.44,0:19:59.38,Default,,0,0,0,,Не! Ах...
Dialogue: 0,0:19:59.38,0:20:02.38,Default,,0,0,0,,Мен...
Dialogue: 0,0:20:02.38,0:20:06.38,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:02.38,0:20:06.38,Default,,0,0,0,,Мені ренжіту үшін тыңдаңыз.
Dialogue: 0,0:20:06.38,0:20:10.39,Default,,0,0,0,,Жоқ Мен... Мен қазірдің өзінде
Dialogue: 0,0:20:10.39,0:20:15.39,Default,,0,0,0,,Мен тасталды және
Dialogue: 0,0:20:10.39,0:20:15.39,Default,,0,0,0,,Қазір мені мүлдем жек көреді...➡
Dialogue: 0,0:20:15.39,0:20:18.40,Default,,0,0,0,,Сонда да мен сені әлі де жақсы көремін
Dialogue: 0,0:20:15.39,0:20:18.40,Default,,0,0,0,,Сіз өте ақымақсыз.
Dialogue: 0,0:20:18.40,0:20:20.40,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:22.40,0:20:24.40,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,0:20:29.41,0:20:33.41,Default,,0,0,0,,Шынында да
Dialogue: 0,0:20:29.41,0:20:33.41,Default,,0,0,0,,Мүмкін жауапсыз махаббат хобби шығар...
Dialogue: 0,0:20:33.41,0:20:36.41,Default,,0,0,0,,Ондай нәрсе жоқ
Dialogue: 0,0:20:33.41,0:20:36.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:36.41,0:20:39.41,Default,,0,0,0,,Манжоме-сан?
Dialogue: 0,0:20:36.41,0:20:39.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:42.42,0:20:46.42,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:20:42.42,0:20:46.42,Default,,0,0,0,,Жоқ. Кешіріңіз.
Dialogue: 0,0:20:46.42,0:21:01.44,Default,,0,0,0,,♬～
Dialogue: 0,0:21:01.44,0:21:03.44,Default,,0,0,0,,Артық емес
Dialogue: 0,0:21:10.45,0:21:15.45,Default,,0,0,0,,♬『ｾﾝﾃｨﾌｫﾘｱ』
Dialogue: 0,0:21:15.45,0:21:35.47,Default,,0,0,0,,♬～
Dialogue: 0,0:21:35.47,0:21:53.49,Default,,0,0,0,,♬～
