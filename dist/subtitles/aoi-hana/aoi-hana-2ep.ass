Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.37,0:00:04.37,Default,,0000,0000,0000,,《Фуми-чан! Ах...》
Dialogue: 0,0:00:07.37,0:00:09.37,Default,,0000,0000,0000,,《А...》
Dialogue: 0,0:00:09.37,0:00:12.38,Default,,0000,0000,0000,,《Фуми-чан бұл
Dialogue: 0,0:00:09.37,0:00:12.38,Default,,0000,0000,0000,,Себебі сен оңай жылайсың》
Dialogue: 0,0:00:12.38,0:00:17.38,Rubi,,0000,0000,0000,,Көк
Dialogue: 0,0:00:12.38,0:00:17.38,Rubi,,0000,0000,0000,,3D маневрлік жабдықтың табиғи жауы.
Dialogue: 0,0:00:12.38,0:00:17.38,Default,,0000,0000,0000,,♬『Көк гүл』
Dialogue: 0,0:00:17.38,0:00:37.40,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:00:37.40,0:00:46.41,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:00:46.41,0:01:06.36,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:01:06.36,0:01:26.38,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:01:26.38,0:01:40.38,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:01:49.37,0:01:51.37,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:01:49.37,0:01:51.37,Default,,0000,0000,0000,,Асығыңыз! мен мінемін
Dialogue: 0,0:01:51.37,0:01:53.38,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:01:53.38,0:01:55.38,Default,,0000,0000,0000,,≪
Dialogue: 0,0:02:08.39,0:02:10.39,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:02:14.40,0:02:18.40,Default,,0000,0000,0000,,Қараңыз. Ол ұйықтап жатыр.
Dialogue: 0,0:02:14.40,0:02:18.40,Default,,0000,0000,0000,,Эй, сен сүйкімдісің.
Dialogue: 0,0:02:18.40,0:02:21.40,Default,,0000,0000,0000,,《Фуми-чан, қара! 》
Dialogue: 0,0:02:27.41,0:02:29.41,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:02:32.42,0:02:34.42,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:02:34.42,0:02:48.37,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:02:48.37,0:02:51.37,Default,,0000,0000,0000,,Жолда да, қайтарда да кездескенімізге сене алар емеспін.
Dialogue: 0,0:02:48.37,0:02:51.37,Default,,0000,0000,0000,,Қандай кездейсоқтық!
Dialogue: 0,0:02:51.37,0:02:53.37,Default,,0000,0000,0000,,Ух... иә
Dialogue: 0,0:02:53.37,0:02:57.37,Default,,0000,0000,0000,,Мектепке баратын жол дерлік бірдей.
Dialogue: 0,0:02:53.37,0:02:57.37,Default,,0000,0000,0000,,Бұл анық па?
Dialogue: 0,0:02:59.38,0:03:02.38,Rubi,,0000,0000,0000,,Фудзи
Dialogue: 0,0:02:59.38,0:03:02.38,Rubi,,0000,0000,0000,,Мен бас тартқан адамдардың бәрі бірден жойылды
Dialogue: 0,0:02:59.38,0:03:02.38,Default,,0000,0000,0000,,Эй, Фудзигая қандай жер?
Dialogue: 0,0:02:59.38,0:03:02.38,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:03:02.38,0:03:05.38,Default,,0000,0000,0000,,... мектеп ғимараты т.б.
Dialogue: 0,0:03:02.38,0:03:05.38,Default,,0000,0000,0000,,О
Dialogue: 0,0:03:05.38,0:03:10.39,Default,,0000,0000,0000,,Мектеп ғимараты ескі, ағаштан жасалған.
Dialogue: 0,0:03:05.38,0:03:10.39,Default,,0000,0000,0000,,Бұл керемет атмосфера
Dialogue: 0,0:03:10.39,0:03:14.39,Default,,0000,0000,0000,,Сондай-ақ часовня бар.
Dialogue: 0,0:03:10.39,0:03:14.39,Default,,0000,0000,0000,,Кітапханада ағаштан жасалған кітап сөрелері бар.
Dialogue: 0,0:03:14.39,0:03:16.39,Default,,0000,0000,0000,,Әй, әдемі көрінеді.
Dialogue: 0,0:03:16.39,0:03:19.40,Rubi,,0000,0000,0000,,Мацуока
Dialogue: 0,0:03:16.39,0:03:19.40,Default,,0000,0000,0000,,Мацуока ше?
Dialogue: 0,0:03:16.39,0:03:19.40,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:19.40,0:03:23.40,Default,,0000,0000,0000,,Мм... кәдімгі мектеп... Менің ойымша.
Dialogue: 0,0:03:23.40,0:03:25.40,Default,,0000,0000,0000,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:03:25.40,0:03:27.40,Default,,0000,0000,0000,,Уау, олар керемет көрінеді!
Dialogue: 0,0:03:34.41,0:03:37.41,Default,,0000,0000,0000,,Сәлем. Ертең бірге барамыз ба?
Dialogue: 0,0:03:37.41,0:03:40.42,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:37.41,0:03:40.42,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:40.42,0:03:42.42,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:03:44.35,0:03:46.36,Default,,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:03:46.36,0:03:48.36,Rubi,,0000,0000,0000,,Йоши
Dialogue: 0,0:03:46.36,0:03:48.36,Default,,0000,0000,0000,,≪(Ёши) Қайтадан қош келдіңіз.➡
Dialogue: 0,0:03:48.36,0:03:52.36,Default,,0000,0000,0000,,Ах Фуми. Ах-чан Охаги
Dialogue: 0,0:03:48.36,0:03:52.36,Default,,0000,0000,0000,,Сізге ұнады деп ойлаймын➡
Dialogue: 0,0:03:52.36,0:03:55.37,Default,,0000,0000,0000,,Есіңде ме?
Dialogue: 0,0:03:55.37,0:03:59.37,Default,,0000,0000,0000,,Шынында да солай емес пе?
Dialogue: 0,0:03:55.37,0:03:59.37,Default,,0000,0000,0000,,Неліктен бұлай сұрайсыз?
Dialogue: 0,0:03:59.37,0:04:02.37,Default,,0000,0000,0000,,Басқа күннің орнына
Dialogue: 0,0:03:59.37,0:04:02.37,Rubi,,0000,0000,0000,,Сакико
Dialogue: 0,0:03:59.37,0:04:02.37,Default,,0000,0000,0000,,Мен Сакико мен А-чанға қоңырау шалдым.➡
Dialogue: 0,0:04:02.37,0:04:05.38,Default,,0000,0000,0000,,Мен сені сүйгеніме сенімдімін
Dialogue: 0,0:04:02.37,0:04:05.38,Default,,0000,0000,0000,,Менің ойымша...｡➡
Dialogue: 0,0:04:05.38,0:04:08.38,Default,,0000,0000,0000,,Сәлем саған
Dialogue: 0,0:04:05.38,0:04:08.38,Default,,0000,0000,0000,,Есіңізде жоқ екеніне сенімдісіз бе?
Dialogue: 0,0:04:12.38,0:04:17.39,Default,,0000,0000,0000,,《А-чанға не ұнайды
Dialogue: 0,0:04:12.38,0:04:17.39,Default,,0000,0000,0000,,Не? 》
Dialogue: 0,0:04:17.39,0:04:19.39,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:04:24.39,0:04:28.39,Rubi,,0000,0000,0000,,Чизу
Dialogue: 0,0:04:24.39,0:04:28.39,Default,,0000,0000,0000,,Мен Чизу-чанмен тәттілерді жиі дайындайтынмын.
Dialogue: 0,0:04:30.40,0:04:35.40,Default,,0000,0000,0000,,Ах, а... тағы да. Ах...
Dialogue: 0,0:04:37.41,0:04:39.41,Default,,0000,0000,0000,,《О, орамал》
Dialogue: 0,0:04:42.43,0:04:46.35,Default,,0000,0000,0000,,Ех! Неге мазалау керек?
Dialogue: 0,0:04:42.43,0:04:46.35,Default,,0000,0000,0000,,Мен оны жуудың қажеті жоқ еді.
Dialogue: 0,0:04:46.35,0:04:49.35,Default,,0000,0000,0000,,Сен өте жақсысың, Фуми-чан
Dialogue: 0,0:04:49.35,0:04:53.36,Default,,0000,0000,0000,,Эй, А-чан, сен охагимен жақсысың ба?
Dialogue: 0,0:04:53.36,0:04:56.36,Default,,0000,0000,0000,,Мен сені жақсы көремін
Dialogue: 0,0:04:53.36,0:04:56.36,Default,,0000,0000,0000,,Йоши апай жасаған Охаги➡
Dialogue: 0,0:04:56.36,0:04:59.36,Default,,0000,0000,0000,,Маған ұнады
Dialogue: 0,0:04:59.36,0:05:01.36,Default,,0000,0000,0000,,Дұрыс...
Dialogue: 0,0:05:01.36,0:05:05.37,Default,,0000,0000,0000,,Ана керемет
Dialogue: 0,0:05:01.36,0:05:05.37,Default,,0000,0000,0000,,Мүлдем есімде жоқ
Dialogue: 0,0:05:05.37,0:05:08.37,Default,,0000,0000,0000,,Қорқынышты
Dialogue: 0,0:05:05.37,0:05:08.37,Default,,0000,0000,0000,,Фуми-чан, себебі мен Анконы жек көремін➡
Dialogue: 0,0:05:08.37,0:05:12.38,Default,,0000,0000,0000,,Фуми-чанға арналған
Dialogue: 0,0:05:08.37,0:05:12.38,Default,,0000,0000,0000,,Мен оны жедім.
Dialogue: 0,0:05:12.38,0:05:15.38,Default,,0000,0000,0000,,Бұл болды ма?
Dialogue: 0,0:05:12.38,0:05:15.38,Default,,0000,0000,0000,,Мм. Бұл дұрыс.
Dialogue: 0,0:05:15.38,0:05:18.38,Default,,0000,0000,0000,,Фуми-чанның әжесі
Dialogue: 0,0:05:15.38,0:05:18.38,Default,,0000,0000,0000,,Өте қорқынышты➡
Dialogue: 0,0:05:18.38,0:05:22.39,Default,,0000,0000,0000,,Мен оны тастап кетсем, мені ашуландыратын нәрсе.
Dialogue: 0,0:05:18.38,0:05:22.39,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:05:22.39,0:05:25.39,Default,,0000,0000,0000,,《Ғажайып…》
Dialogue: 0,0:05:25.39,0:05:29.39,Default,,0000,0000,0000,,《Мен оны ішуім керек.
Dialogue: 0,0:05:25.39,0:05:29.39,Default,,0000,0000,0000,,Менің ішуім керек емес》
Dialogue: 0,0:05:29.39,0:05:33.40,Default,,0000,0000,0000,,《Қойсаң... ұрысасың》
Dialogue: 0,0:05:33.40,0:05:38.40,Default,,0000,0000,0000,,《Ол керексіз бала. Оны маған қарызға бер 》
Dialogue: 0,0:05:33.40,0:05:38.40,Default,,0000,0000,0000,,Ауылдың қарапайым адамдары көбейіп кеткен сияқты.
Dialogue: 0,0:05:41.40,0:05:43.34,Default,,0000,0000,0000,,《А-чан! Сенімен бәрі жақсы ма? 》
Dialogue: 0,0:05:43.34,0:05:46.34,Default,,0000,0000,0000,,Уау
Dialogue: 0,0:05:46.34,0:05:50.35,Default,,0000,0000,0000,,Ах! Бірдеңе есіме түсіп, күлемін
Dialogue: 0,0:05:46.34,0:05:50.35,Default,,0000,0000,0000,,Не ол?
Dialogue: 0,0:05:50.35,0:05:52.35,Default,,0000,0000,0000,,Эй, эй!
Dialogue: 0,0:05:55.35,0:05:57.35,Default,,0000,0000,0000,,≪(Оқушы) Рахмет.
Dialogue: 0,0:05:57.35,0:06:00.35,Default,,0000,0000,0000,,≪(Оқушылар) Рахмет.
Dialogue: 0,0:06:12.37,0:06:16.37,Default,,0000,0000,0000,,Құрметпен айтсам, Басшының орынбасары,
Dialogue: 0,0:06:12.37,0:06:16.37,Rubi,,0000,0000,0000,,Икуми
Dialogue: 0,0:06:12.37,0:06:16.37,Default,,0000,0000,0000,,Игуми мырза, сіз не істеу керектігін шештіңіз бе?
Dialogue: 0,0:06:16.37,0:06:20.38,Rubi,,0000,0000,0000,,Киоко
Dialogue: 0,0:06:16.37,0:06:20.38,Default,,0000,0000,0000,,(Киоко)
Dialogue: 0,0:06:16.37,0:06:20.38,Rubi,,0000,0000,0000,,Окудаира
Dialogue: 0,0:06:16.37,0:06:20.38,Default,,0000,0000,0000,,Мен әлі жоқпын. Окудаира мырза ше?
Dialogue: 0,0:06:20.38,0:06:25.38,Default,,0000,0000,0000,,Бірдеңе... жас ханым.
Dialogue: 0,0:06:20.38,0:06:25.38,Default,,0000,0000,0000,,Мен клубқа қосылғым келеді.
Dialogue: 0,0:06:25.38,0:06:30.39,Default,,0000,0000,0000,,Шай ішу үйірмесі мен гүл қою үйірмесі де жақсы.
Dialogue: 0,0:06:25.38,0:06:30.39,Default,,0000,0000,0000,,Драма үйірмесі де жақсы.
Dialogue: 0,0:06:30.39,0:06:33.39,Rubi,,0000,0000,0000,,Такаразука
Dialogue: 0,0:06:30.39,0:06:33.39,Default,,0000,0000,0000,,Менің ойымша, бұл Такаразука сияқты...
Dialogue: 0,0:06:33.39,0:06:36.39,Default,,0000,0000,0000,,Окудаира мырза сондай сүйкімді.
Dialogue: 0,0:06:36.39,0:06:39.39,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:06:36.39,0:06:39.39,Default,,0000,0000,0000,,Адамдар мені «сүйкімді» деп атайтын!
Dialogue: 0,0:06:42.42,0:06:46.34,Default,,0000,0000,0000,,Драма үйірмесі... Қызық көрінеді.
Dialogue: 0,0:06:46.34,0:06:49.34,Rubi,,0000,0000,0000,,Йоко
Dialogue: 0,0:06:46.34,0:06:49.34,Default,,0000,0000,0000,,Әрине қызықты! ➡
Dialogue: 0,0:06:49.34,0:06:53.34,Default,,0000,0000,0000,,Мен бәрібір шешуім керек.
Dialogue: 0,0:06:49.34,0:06:53.34,Default,,0000,0000,0000,,Ондай нәрсе жоқ. Сонымен... Ах!
Dialogue: 0,0:06:53.34,0:06:55.35,Default,,0000,0000,0000,,Эй... Бір сәт ваннаға баруым керек...
Dialogue: 0,0:06:55.35,0:06:59.35,Default,,0000,0000,0000,,(Йоко)
Dialogue: 0,0:06:55.35,0:06:59.35,Rubi,,0000,0000,0000,,Манжоме
Dialogue: 0,0:06:55.35,0:06:59.35,Default,,0000,0000,0000,,Не? Ах... Манжоме-сан! ➡
Dialogue: 0,0:06:59.35,0:07:01.35,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:07:03.35,0:07:09.36,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:07:03.35,0:07:09.36,Default,,0000,0000,0000,,Әйтеуір, мені осылай итеріп жіберетін сияқтымын.
Dialogue: 0,0:07:09.36,0:07:11.36,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:11.36,0:07:16.36,Default,,0000,0000,0000,,Иә. Бірдеңе болса,
Dialogue: 0,0:07:11.36,0:07:16.36,Default,,0000,0000,0000,,Мен мұны жақсы көремін...
Dialogue: 0,0:07:18.37,0:07:20.37,Rubi,,0000,0000,0000,,Ясуко
Dialogue: 0,0:07:18.37,0:07:20.37,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:07:20.37,0:07:22.37,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:07:22.37,0:07:24.37,Default,,0000,0000,0000,,Бірінші курс студенті?
Dialogue: 0,0:07:22.37,0:07:24.37,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:24.37,0:07:27.38,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:07:27.38,0:07:32.38,Default,,0000,0000,0000,,Сіз ұзынсыз.
Dialogue: 0,0:07:27.38,0:07:32.38,Default,,0000,0000,0000,,Иә. Рақмет сізге.
Dialogue: 0,0:07:32.38,0:07:34.38,Default,,0000,0000,0000,,Мм!?➡
Dialogue: 0,0:07:34.38,0:07:36.38,Default,,0000,0000,0000,,Уууууу…
Dialogue: 0,0:07:38.39,0:07:40.39,Default,,0000,0000,0000,,Сіз әлі клуб туралы шешім қабылдадыңыз ба?
Dialogue: 0,0:07:40.39,0:07:43.33,Default,,0000,0000,0000,,Жоқ, мен әлі шешкен жоқпын.
Dialogue: 0,0:07:43.33,0:07:46.33,Default,,0000,0000,0000,,Мерзім жақындап қалды
Dialogue: 0,0:07:43.33,0:07:46.33,Default,,0000,0000,0000,,Сіз қобалжыдыңыз ба?
Dialogue: 0,0:07:46.33,0:07:48.33,Default,,0000,0000,0000,,А... иә
Dialogue: 0,0:07:48.33,0:07:52.34,Default,,0000,0000,0000,,Хехе
Dialogue: 0,0:07:48.33,0:07:52.34,Default,,0000,0000,0000,,Қарсы болмасаң, менің үйіме келгің келе ме?
Dialogue: 0,0:07:52.34,0:07:54.34,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:58.34,0:08:00.34,Default,,0000,0000,0000,,Әдебиет үйірмесі!?
Dialogue: 0,0:08:00.34,0:08:04.35,Default,,0000,0000,0000,,Не, сен сол жерде шештің!
Dialogue: 0,0:08:00.34,0:08:04.35,Default,,0000,0000,0000,,Сатқын
Dialogue: 0,0:08:04.35,0:08:06.35,Default,,0000,0000,0000,,Кешіріңіз. Мен жай ғана...
Dialogue: 0,0:08:06.35,0:08:10.35,Default,,0000,0000,0000,,Драма үйірмесін жеңгем деп алдым.
Dialogue: 0,0:08:06.35,0:08:10.35,Default,,0000,0000,0000,,Аа, кешіріңіз, кешіріңіз.
Dialogue: 0,0:08:10.35,0:08:14.35,Rubi,,0000,0000,0000,,Мива
Dialogue: 0,0:08:10.35,0:08:14.35,Default,,0000,0000,0000,,Күтілгендей
Dialogue: 0,0:08:10.35,0:08:14.35,Rubi,,0000,0000,0000,,Мисако
Dialogue: 0,0:08:10.35,0:08:14.35,Default,,0000,0000,0000,,Тағдыр солай болды ма?
Dialogue: 0,0:08:16.36,0:08:21.36,Default,,0000,0000,0000,,Әдебиет клубы?
Dialogue: 0,0:08:16.36,0:08:21.36,Default,,0000,0000,0000,,Бұл Фуми-чанға жарамды болуы мүмкін.
Dialogue: 0,0:08:21.36,0:08:23.37,Default,,0000,0000,0000,,Бұл аға қандай адам?
Dialogue: 0,0:08:23.37,0:08:27.37,Default,,0000,0000,0000,,Адам кім болса да...
Dialogue: 0,0:08:30.37,0:08:33.38,Default,,0000,0000,0000,,Өйткені біз тек бір рет кездестік
Dialogue: 0,0:08:30.37,0:08:33.38,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:08:33.38,0:08:35.38,Default,,0000,0000,0000,,[Ұялы телефон] (пошта қоңырау үні)
Dialogue: 0,0:08:33.38,0:08:35.38,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:08:35.38,0:08:39.38,Default,,0000,0000,0000,,А-чан, менде ұялы телефон бар.
Dialogue: 0,0:08:35.38,0:08:39.38,Default,,0000,0000,0000,,Иә, мен оны кеше саған сатып алдым.
Dialogue: 0,0:08:39.38,0:08:42.40,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:08:39.38,0:08:42.40,Default,,0000,0000,0000,,Мен қазір кетуім керек. Күте тұр!
Dialogue: 0,0:08:42.40,0:08:46.32,Default,,0000,0000,0000,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:08:42.40,0:08:46.32,Default,,0000,0000,0000,,Мен кенеттен бірдеңе жасайтын сияқтымын.
Dialogue: 0,0:08:46.32,0:08:51.33,Default,,0000,0000,0000,,Мен көремін. Бірақ мұндай уақытта
Dialogue: 0,0:08:46.32,0:08:51.33,Default,,0000,0000,0000,,Ұялы телефондар ыңғайлы.
Dialogue: 0,0:08:51.33,0:08:55.33,Default,,0000,0000,0000,,Фуми-чан, оны да сатып алыңыз.
Dialogue: 0,0:08:51.33,0:08:55.33,Default,,0000,0000,0000,,Электрондық пошта Жасайық
Dialogue: 0,0:08:55.33,0:08:57.33,Default,,0000,0000,0000,,Дұрыс. Бұл сәл жақсы болуы мүмкін.
Dialogue: 0,0:08:57.33,0:09:00.34,Default,,0000,0000,0000,,≪
Dialogue: 0,0:08:57.33,0:09:00.34,Default,,0000,0000,0000,,≪(Ёши) Иә.➡
Dialogue: 0,0:09:00.34,0:09:03.34,Default,,0000,0000,0000,,О, мен көптен күттім.
Dialogue: 0,0:09:00.34,0:09:03.34,Default,,0000,0000,0000,,≪(Чизу) Кешіріңіз, кенеттен...
Dialogue: 0,0:09:03.34,0:09:05.34,Default,,0000,0000,0000,,Кім?
Dialogue: 0,0:09:03.34,0:09:05.34,Default,,0000,0000,0000,,≪(Ёши) Жоқ, бәрі жақсы.➡
Dialogue: 0,0:09:05.34,0:09:08.34,Default,,0000,0000,0000,,Бұл әке?
Dialogue: 0,0:09:05.34,0:09:08.34,Default,,0000,0000,0000,,≪(Күйеу) О, танысқаныма қуаныштымын.
Dialogue: 0,0:09:08.34,0:09:11.35,Default,,0000,0000,0000,,≪(Ёши) Жарайды, ол жақсы адам емес.
Dialogue: 0,0:09:08.34,0:09:11.35,Default,,0000,0000,0000,,Әзірше жоғары көтеріліңіз.
Dialogue: 0,0:09:11.35,0:09:13.35,Default,,0000,0000,0000,,≪(Чизу/келіншек)
Dialogue: 0,0:09:11.35,0:09:13.35,Default,,0000,0000,0000,,Иә. Сізді мазалағаным үшін кешіріңіз.
Dialogue: 0,0:09:13.35,0:09:17.35,Default,,0000,0000,0000,,Фуми-чан! Чизу-чанмен
Dialogue: 0,0:09:13.35,0:09:17.35,Default,,0000,0000,0000,,Әке, сіз маған керексіз➡
Dialogue: 0,0:09:17.35,0:09:19.36,Default,,0000,0000,0000,,Келіңіздер, сәлемдесіңіздер.➡
Dialogue: 0,0:09:19.36,0:09:23.36,Default,,0000,0000,0000,,А-чан. Футон - бұл
Dialogue: 0,0:09:19.36,0:09:23.36,Default,,0000,0000,0000,,Мен оны ваннадан кейін дайындаймын.
Dialogue: 0,0:09:23.36,0:09:25.36,Default,,0000,0000,0000,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:09:27.36,0:09:31.36,Default,,0000,0000,0000,,А... Иә? Ах
Dialogue: 0,0:09:33.37,0:09:37.37,Default,,0000,0000,0000,,Чизу-чан қорқынышты
Dialogue: 0,0:09:39.38,0:09:41.38,Default,,0000,0000,0000,,Қорқынышты...
Dialogue: 0,0:09:39.38,0:09:41.38,Default,,0000,0000,0000,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:09:41.38,0:09:43.31,Default,,0000,0000,0000,,Ах аа
Dialogue: 0,0:09:43.31,0:09:46.32,Default,,0000,0000,0000,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:09:46.32,0:09:51.32,Default,,0000,0000,0000,,Фуми-чан. Не болды?
Dialogue: 0,0:09:46.32,0:09:51.32,Default,,0000,0000,0000,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:09:51.32,0:09:54.32,Default,,0000,0000,0000,,О, жарайды...
Dialogue: 0,0:09:54.32,0:10:01.33,Default,,0000,0000,0000,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:10:01.33,0:10:03.33,Default,,0000,0000,0000,,Жарайды, жарайды
Dialogue: 0,0:10:11.34,0:10:14.34,Default,,0000,0000,0000,,А-чан
Dialogue: 0,0:10:11.34,0:10:14.34,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:14.34,0:10:18.35,Default,,0000,0000,0000,,Аа-чан, мұнда да ұйықта.
Dialogue: 0,0:10:18.35,0:10:21.35,Default,,0000,0000,0000,,Жарайды, бірақ
Dialogue: 0,0:10:21.35,0:10:25.35,Default,,0000,0000,0000,,Қанша үлкен
Dialogue: 0,0:10:21.35,0:10:25.35,Default,,0000,0000,0000,,Сенің бұзылған бәйбіше екеніңді
Dialogue: 0,0:10:31.36,0:10:36.37,Default,,0000,0000,0000,,(Чизу)
Dialogue: 0,0:10:31.36,0:10:36.37,Default,,0000,0000,0000,,《Фуми-чан. Мені қаламайсың ба? ➡
Dialogue: 0,0:10:36.37,0:10:38.37,Default,,0000,0000,0000,,Қорқынышты ма? 》
Dialogue: 0,0:10:40.37,0:10:42.39,Default,,0000,0000,0000,,《Түсінбедім》
Dialogue: 0,0:10:42.39,0:10:44.39,Default,,0000,0000,0000,,《Фуми-чан сүйкімді》
Dialogue: 0,0:10:46.31,0:10:52.32,Default,,0000,0000,0000,,《Мен түсінбейтін ештеңе жоқ.
Dialogue: 0,0:10:46.31,0:10:52.32,Default,,0000,0000,0000,,Бұл аздап қорқынышты болды》
Dialogue: 0,0:10:52.32,0:10:54.32,Default,,0000,0000,0000,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:10:54.32,0:10:56.32,Default,,0000,0000,0000,,Жылауды доғар!
Dialogue: 0,0:10:59.32,0:11:02.33,Default,,0000,0000,0000,,Қараңыз
Dialogue: 0,0:11:02.33,0:11:07.33,Default,,0000,0000,0000,,Өткенде де, Жылағанда
Dialogue: 0,0:11:02.33,0:11:07.33,Default,,0000,0000,0000,,Сіз жиі қол ұстасып тұрдыңыз.
Dialogue: 0,0:11:07.33,0:11:11.33,Default,,0000,0000,0000,,Ерте ұйықтаңыз. Түнде ұйықтаңыз.
Dialogue: 0,0:11:11.33,0:11:13.33,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:11:16.34,0:11:20.34,Default,,0000,0000,0000,,《Менің нағашымның әпкесі
Dialogue: 0,0:11:16.34,0:11:20.34,Default,,0000,0000,0000,,Тұрмысқа шыққаныңыз үшін➡
Dialogue: 0,0:11:20.34,0:11:23.35,Default,,0000,0000,0000,,Әлгі абдырап қалған жігіт.➡
Dialogue: 0,0:11:23.35,0:11:28.35,Default,,0000,0000,0000,,Фуми-чан әпкесі туралы ойлап отыр.
Dialogue: 0,0:11:23.35,0:11:28.35,Default,,0000,0000,0000,,Сізге соншалықты ұнады ма? 》
Dialogue: 0,0:11:30.35,0:11:32.35,Default,,0000,0000,0000,,《Сонша...》
Dialogue: 0,0:11:38.35,0:11:42.35,Default,,0000,0000,0000,,Хмм. Ондай адам.
Dialogue: 0,0:11:38.35,0:11:42.35,Default,,0000,0000,0000,,Сіз менің клубымда болдыңыз ба?
Dialogue: 0,0:11:42.35,0:11:45.35,Default,,0000,0000,0000,,Жақсы
Dialogue: 0,0:11:42.35,0:11:45.35,Default,,0000,0000,0000,,Бойы биік болу және төте жолдарды алу
Dialogue: 0,0:11:45.35,0:11:49.36,Default,,0000,0000,0000,,Ал, әзірге.
Dialogue: 0,0:11:45.35,0:11:49.36,Default,,0000,0000,0000,,Мұнда сынып пен атын жазыңыз
Dialogue: 0,0:11:49.36,0:11:51.36,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:11:51.36,0:11:54.36,Default,,0000,0000,0000,,Хмм. Бірақ сен ұзынсың.
Dialogue: 0,0:11:51.36,0:11:54.36,Default,,0000,0000,0000,,Таңбашалар...
Dialogue: 0,0:11:54.36,0:11:56.37,Default,,0000,0000,0000,,(есіктің ашылған дыбысы)
Dialogue: 0,0:11:56.37,0:11:59.37,Default,,0000,0000,0000,,Иә? Сәлем
Dialogue: 0,0:11:59.37,0:12:02.37,Default,,0000,0000,0000,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:11:59.37,0:12:02.37,Default,,0000,0000,0000,,Мүмкін➡
Dialogue: 0,0:12:02.37,0:12:05.37,Default,,0000,0000,0000,,Сіз бұл жігіт туралы айтып отырсыз ба?
Dialogue: 0,0:12:02.37,0:12:05.37,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:05.37,0:12:08.38,Default,,0000,0000,0000,,Бұл жігіт баскетбол командасында.
Dialogue: 0,0:12:05.37,0:12:08.38,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:08.38,0:12:11.38,Default,,0000,0000,0000,,Менің досым
Dialogue: 0,0:12:08.38,0:12:11.38,Default,,0000,0000,0000,,Баскетбол?
Dialogue: 0,0:12:13.38,0:12:15.38,Default,,0000,0000,0000,,Фуми Манжоме?
Dialogue: 0,0:12:17.39,0:12:23.39,Rubi,,0000,0000,0000,,Сугимото
Dialogue: 0,0:12:17.39,0:12:23.39,Default,,0000,0000,0000,,Бұл Ясуми Сугимото, үшінші курс студенті.
Dialogue: 0,0:12:17.39,0:12:23.39,Default,,0000,0000,0000,,Тағы да рахмет.
Dialogue: 0,0:12:23.39,0:12:28.40,Default,,0000,0000,0000,,Баскетбол!?
Dialogue: 0,0:12:23.39,0:12:28.40,Default,,0000,0000,0000,,Неліктен кенеттен мұндай жерге тап болдыңыз?
Dialogue: 0,0:12:28.40,0:12:31.40,Default,,0000,0000,0000,,Қабылдау туралы өтініш... болып табылады
Dialogue: 0,0:12:28.40,0:12:31.40,Default,,0000,0000,0000,,Әрбір клуб бірдей...
Dialogue: 0,0:12:31.40,0:12:34.40,Default,,0000,0000,0000,,Мәселе бұл емес!
Dialogue: 0,0:12:34.40,0:12:37.40,Default,,0000,0000,0000,,Не болып жатыр?
Dialogue: 0,0:12:34.40,0:12:37.40,Default,,0000,0000,0000,,Енді?
Dialogue: 0,0:12:39.34,0:12:43.35,Default,,0000,0000,0000,,Театрда тәжірибеңіз болмаса
Dialogue: 0,0:12:39.34,0:12:43.35,Default,,0000,0000,0000,,Алғашында мұны сахна артындағылар ғана жасай алады.➡
Dialogue: 0,0:12:43.35,0:12:49.35,Default,,0000,0000,0000,,Костюмдер мен фон жасау
Dialogue: 0,0:12:43.35,0:12:49.35,Default,,0000,0000,0000,,Жақсы ма?
Dialogue: 0,0:12:49.35,0:12:53.36,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:12:49.35,0:12:53.36,Default,,0000,0000,0000,,Мәселе жоқ
Dialogue: 0,0:12:53.36,0:12:58.36,Default,,0000,0000,0000,,Жақында театр фестивалі болады.
Dialogue: 0,0:12:53.36,0:12:58.36,Default,,0000,0000,0000,,Жаңадан келген студенттерді құптайды.
Dialogue: 0,0:12:58.36,0:13:02.37,Default,,0000,0000,0000,,Біз адамдармен дөрекі боламыз.
Dialogue: 0,0:12:58.36,0:13:02.37,Default,,0000,0000,0000,,Дайын болыңыз
Dialogue: 0,0:13:02.37,0:13:04.37,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:13:09.37,0:13:12.38,Default,,0000,0000,0000,,(Ёши)
Dialogue: 0,0:13:09.37,0:13:12.38,Default,,0000,0000,0000,,Ол оны түнде бірнеше рет алып келгенін айтты.
Dialogue: 0,0:13:12.38,0:13:15.38,Rubi,,0000,0000,0000,,Акио
Dialogue: 0,0:13:12.38,0:13:15.38,Default,,0000,0000,0000,,Менің артымнан ерме
Dialogue: 0,0:13:12.38,0:13:15.38,Default,,0000,0000,0000,,Бұл – шындық.
Dialogue: 0,0:13:15.38,0:13:18.38,Default,,0000,0000,0000,,Жалғыз болған дұрыс
Dialogue: 0,0:13:15.38,0:13:18.38,Default,,0000,0000,0000,,Барыңыз.
Dialogue: 0,0:13:18.38,0:13:20.38,Default,,0000,0000,0000,,А, қараңдаршы
Dialogue: 0,0:13:20.38,0:13:25.38,Default,,0000,0000,0000,,≪(Ёши) Той күні ештеңе жоқ
Dialogue: 0,0:13:20.38,0:13:25.38,Default,,0000,0000,0000,,Сізге суық тиюдің қажеті жоқ.
Dialogue: 0,0:13:29.39,0:13:32.40,Default,,0000,0000,0000,,《Әке Ана
Dialogue: 0,0:13:29.39,0:13:32.40,Default,,0000,0000,0000,,Кешіріңіз.➡
Dialogue: 0,0:13:32.40,0:13:36.42,Default,,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:13:32.40,0:13:36.42,Default,,0000,0000,0000,,Түнде көп құсқан жоқпын.➡
Dialogue: 0,0:13:36.42,0:13:39.34,Default,,0000,0000,0000,,Мен де суық тиген жоқпын.➡
Dialogue: 0,0:13:39.34,0:13:41.34,Default,,0000,0000,0000,,I…｡➡
Dialogue: 0,0:13:41.34,0:13:43.34,Default,,0000,0000,0000,,Менің барғым келмеді》
Dialogue: 0,0:13:48.34,0:13:58.35,Default,,0000,0000,0000,,≪☎
Dialogue: 0,0:13:58.35,0:14:04.36,Default,,0000,0000,0000,,☎
Dialogue: 0,0:14:04.36,0:14:07.36,Default,,0000,0000,0000,,Иә. Мен Манджоммын.
Dialogue: 0,0:14:07.36,0:14:12.36,Default,,0000,0000,0000,,Ах, Ах-чан? иә?
Dialogue: 0,0:14:14.37,0:14:18.37,Default,,0000,0000,0000,,Иә, бос уақытым бар... Бос уақытым бар, бос уақытым бар. Менің бос уақытым көп.
Dialogue: 0,0:14:18.37,0:14:23.37,Default,,0000,0000,0000,,☎Хахаха... Мен қатты скучно.
Dialogue: 0,0:14:18.37,0:14:23.37,Default,,0000,0000,0000,,Олай болса бір жерге барайық.
Dialogue: 0,0:14:27.38,0:14:29.38,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:14:34.39,0:14:37.33,Default,,0000,0000,0000,,≪Ахаха...
Dialogue: 0,0:14:37.33,0:14:43.33,Default,,0000,0000,0000,,Әдебиет үйірмесі баскетбол үйірмесі сияқты.
Dialogue: 0,0:14:37.33,0:14:43.33,Default,,0000,0000,0000,,Қандай қателік. Хехе...
Dialogue: 0,0:14:43.33,0:14:47.34,Default,,0000,0000,0000,,Иә. Ал, бірақ
Dialogue: 0,0:14:43.33,0:14:47.34,Default,,0000,0000,0000,,Егер сіз жай ғана кірсеңіз ➡
Dialogue: 0,0:14:47.34,0:14:49.34,Default,,0000,0000,0000,,Бұл сөзсіз Фуми-чан, солай емес пе?
Dialogue: 0,0:14:49.34,0:14:54.34,Default,,0000,0000,0000,,күрсіну. Драма үйірмесіне түскені дұрыс болар еді.
Dialogue: 0,0:14:49.34,0:14:54.34,Default,,0000,0000,0000,,Бұл жақсырақ болар еді
Dialogue: 0,0:14:54.34,0:14:58.35,Default,,0000,0000,0000,,Аа, мен драма үйірмесіне түстім.
Dialogue: 0,0:14:54.34,0:14:58.35,Default,,0000,0000,0000,,Иә, керемет
Dialogue: 0,0:14:58.35,0:15:02.35,Default,,0000,0000,0000,,Бір сыныптағы Игуми мырза есімді қызбен.
Dialogue: 0,0:14:58.35,0:15:02.35,Default,,0000,0000,0000,,Үйірмеге бірге қосылдық.
Dialogue: 0,0:15:02.35,0:15:04.35,Default,,0000,0000,0000,,Мынаны қараңыз
Dialogue: 0,0:15:02.35,0:15:04.35,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:06.36,0:15:12.36,Rubi,,0000,0000,0000,,Хоши
Dialogue: 0,0:15:06.36,0:15:12.36,Rubi,,0000,0000,0000,,Оудзи
Dialogue: 0,0:15:06.36,0:15:12.36,Rubi,,0000,0000,0000,,Вакакуса оқиғасы
Dialogue: 0,0:15:06.36,0:15:12.36,Default,,0000,0000,0000,,«Кішкентай ханзада» «Кішкентай әйелдер»
Dialogue: 0,0:15:06.36,0:15:12.36,Rubi,,0000,0000,0000,,Дауыл
Dialogue: 0,0:15:06.36,0:15:12.36,Rubi,,0000,0000,0000,,Жарайды
Dialogue: 0,0:15:06.36,0:15:12.36,Default,,0000,0000,0000,,«Шыңғырған биіктер»…
Dialogue: 0,0:15:12.36,0:15:15.36,Default,,0000,0000,0000,,Керемет! А-чан, шығасың ба?
Dialogue: 0,0:15:15.36,0:15:20.37,Default,,0000,0000,0000,,Менің мұны істеуім мүмкін емес. Мен жақсы адаммын.
Dialogue: 0,0:15:15.36,0:15:20.37,Default,,0000,0000,0000,,Өйткені олар өте көп.
Dialogue: 0,0:15:20.37,0:15:24.37,Default,,0000,0000,0000,,Бірақ сахна артында немесе бәрібір.
Dialogue: 0,0:15:20.37,0:15:24.37,Default,,0000,0000,0000,,Бұл жағдайда мен сізге қалай көмектесе аламын?
Dialogue: 0,0:15:24.37,0:15:27.38,Default,,0000,0000,0000,,Мен бірдеңе жақсы деп ойладым...
Dialogue: 0,0:15:27.38,0:15:32.38,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:15:27.38,0:15:32.38,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:15:41.32,0:15:44.33,Default,,0000,0000,0000,,《А-чан бұл
Dialogue: 0,0:15:41.32,0:15:44.33,Default,,0000,0000,0000,,Өзіңізге ұнайтын нәрсені табыңыз➡
Dialogue: 0,0:15:44.33,0:15:48.33,Default,,0000,0000,0000,,Мен өзімді толық сезінемін... Бұл тамаша》
Dialogue: 0,0:15:48.33,0:15:51.33,Default,,0000,0000,0000,,《Мен де баскетбол үйірмесіне қосылдым.
Dialogue: 0,0:15:48.33,0:15:51.33,Default,,0000,0000,0000,,«Мен кіре алмаймын»➡
Dialogue: 0,0:15:51.33,0:15:53.34,Default,,0000,0000,0000,,Мен оны дұрыс айтуым керек》
Dialogue: 0,0:15:53.34,0:15:55.34,Default,,0000,0000,0000,,≪(есіктің ашылу дыбысы)
Dialogue: 0,0:15:53.34,0:15:55.34,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:15:55.34,0:15:57.34,Default,,0000,0000,0000,,≪(Ёши) Ах, мен шаршадым, мен шаршадым
Dialogue: 0,0:15:57.34,0:16:00.34,Default,,0000,0000,0000,,Ах, бұл жаман.
Dialogue: 0,0:16:00.34,0:16:04.34,Default,,0000,0000,0000,,≪(Ёши) Фуми?
Dialogue: 0,0:16:00.34,0:16:04.34,Default,,0000,0000,0000,,Сіз ояусыз ба? Фуми? Фуми?
Dialogue: 0,0:16:12.35,0:16:16.36,Default,,0000,0000,0000,,Манжоме мырзадан
Dialogue: 0,0:16:12.35,0:16:16.36,Default,,0000,0000,0000,,Келгеніңізге қуаныштымын.
Dialogue: 0,0:16:16.36,0:16:20.36,Default,,0000,0000,0000,,Жоқ, солай…
Dialogue: 0,0:16:16.36,0:16:20.36,Default,,0000,0000,0000,,Сонымен не?
Dialogue: 0,0:16:20.36,0:16:25.37,Default,,0000,0000,0000,,Ах, жоқ, яғни…
Dialogue: 0,0:16:20.36,0:16:25.37,Default,,0000,0000,0000,,Мен сізбен бір нәрсе туралы сөйлескім келеді.
Dialogue: 0,0:16:25.37,0:16:29.37,Default,,0000,0000,0000,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:16:25.37,0:16:29.37,Default,,0000,0000,0000,,Манжоме-сан, сен актерлік өнерге қызығасың ба?
Dialogue: 0,0:16:29.37,0:16:34.38,Default,,0000,0000,0000,,Пьеса...?
Dialogue: 0,0:16:29.37,0:16:34.38,Default,,0000,0000,0000,,Маған ұнамайды...
Dialogue: 0,0:16:34.38,0:16:40.32,Default,,0000,0000,0000,,Жақсы. Сіз бұған қарай аласыз ба?
Dialogue: 0,0:16:34.38,0:16:40.32,Default,,0000,0000,0000,,Не? Бұл Фудзигая...
Dialogue: 0,0:16:40.32,0:16:44.32,Default,,0000,0000,0000,,Иә, Фудзигая Джогакуин драма клубы.
Dialogue: 0,0:16:40.32,0:16:44.32,Default,,0000,0000,0000,,Брошюра
Dialogue: 0,0:16:44.32,0:16:46.32,Default,,0000,0000,0000,,Ах... мм...
Dialogue: 0,0:16:48.32,0:16:52.33,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:48.32,0:16:52.33,Default,,0000,0000,0000,,Не болды? Ах
Dialogue: 0,0:16:52.33,0:16:56.33,Default,,0000,0000,0000,,Хат... махаббат хаты шығар?
Dialogue: 0,0:16:52.33,0:16:56.33,Default,,0000,0000,0000,,Бұл іске араласпа.
Dialogue: 0,0:16:56.33,0:17:00.34,Default,,0000,0000,0000,,Керемет
Dialogue: 0,0:16:56.33,0:17:00.34,Default,,0000,0000,0000,,Бұл шынымен бар ма?
Dialogue: 0,0:17:00.34,0:17:03.34,Default,,0000,0000,0000,,Орта мектеп оқушысы.
Dialogue: 0,0:17:00.34,0:17:03.34,Default,,0000,0000,0000,,Сіз кездесіп жатырсыз ба?
Dialogue: 0,0:17:03.34,0:17:07.34,Default,,0000,0000,0000,,Тіпті орта мектеп ғимаратында
Dialogue: 0,0:17:03.34,0:17:07.34,Default,,0000,0000,0000,,Мен сіздің батылдығыңызды бағалаймын➡
Dialogue: 0,0:17:07.34,0:17:10.34,Default,,0000,0000,0000,,Маған
Dialogue: 0,0:17:07.34,0:17:10.34,Default,,0000,0000,0000,,Өйткені маған ұнайтын адам бар
Dialogue: 0,0:17:12.35,0:17:17.35,Default,,0000,0000,0000,,Ха! Мүмкін мен шығармын?
Dialogue: 0,0:17:12.35,0:17:17.35,Default,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:17:17.35,0:17:22.36,Rubi,,0000,0000,0000,,Сәнбика
Dialogue: 0,0:17:17.35,0:17:22.36,Default,,0000,0000,0000,,♬«Көк гүл әнұраны»
Dialogue: 0,0:17:22.36,0:17:27.36,Default,,0000,0000,0000,,♬«Таза жүрек үшін»
Dialogue: 0,0:17:27.36,0:17:29.37,Default,,0000,0000,0000,,《Неге?➡
Dialogue: 0,0:17:29.37,0:17:34.37,Default,,0000,0000,0000,,Игуми мырзаға кім ұнайды?
Dialogue: 0,0:17:29.37,0:17:34.37,Default,,0000,0000,0000,,Мен оны әйел деп ойладым》
Dialogue: 0,0:17:36.39,0:17:40.31,Default,,0000,0000,0000,,《Әйтеуір...➡
Dialogue: 0,0:17:40.31,0:17:42.31,Default,,0000,0000,0000,,Мен солай сезіндім》
Dialogue: 0,0:17:46.32,0:17:50.32,Default,,0000,0000,0000,,Жоқ, тек кедергі келтіресің.
Dialogue: 0,0:17:46.32,0:17:50.32,Default,,0000,0000,0000,,Фудзигая
Dialogue: 0,0:17:50.32,0:17:52.32,Default,,0000,0000,0000,,Ханым
Dialogue: 0,0:17:52.32,0:17:56.33,Default,,0000,0000,0000,,Бұл артқы қақпа.
Dialogue: 0,0:17:52.32,0:17:56.33,Default,,0000,0000,0000,,Негізгі қақпа сәл артта.
Dialogue: 0,0:17:56.33,0:17:59.33,Default,,0000,0000,0000,,≪(Йоко/Мива) Ех!
Dialogue: 0,0:17:56.33,0:17:59.33,Default,,0000,0000,0000,,≪(Мисако) Бұл қандай мектеп?
Dialogue: 0,0:17:59.33,0:18:03.33,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:17:59.33,0:18:03.33,Default,,0000,0000,0000,,Мен Фудзигаяны бір рет көргім келеді...
Dialogue: 0,0:18:03.33,0:18:07.34,Default,,0000,0000,0000,,Ал Кира
Dialogue: 0,0:18:03.33,0:18:07.34,Default,,0000,0000,0000,,Мен Фудзигая тұрғындарынан рұқсат алдым.➡
Dialogue: 0,0:18:07.34,0:18:10.34,Default,,0000,0000,0000,,Жалғыз жүргеннен оңай.
Dialogue: 0,0:18:14.34,0:18:16.34,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:18:18.35,0:18:22.35,Default,,0000,0000,0000,,Күткеніңізге рахмет
Dialogue: 0,0:18:18.35,0:18:22.35,Default,,0000,0000,0000,,Біраз уақыт өтті. Бұл тез болды.
Dialogue: 0,0:18:22.35,0:18:25.35,Default,,0000,0000,0000,,Бұл экскурсиядағы балалар?
Dialogue: 0,0:18:22.35,0:18:25.35,Default,,0000,0000,0000,,О
Dialogue: 0,0:18:25.35,0:18:29.36,Default,,0000,0000,0000,,Фуми-чан! Неліктен?
Dialogue: 0,0:18:25.35,0:18:29.36,Default,,0000,0000,0000,,Мен де қобалжып барамын.
Dialogue: 0,0:18:29.36,0:18:33.36,Default,,0000,0000,0000,,Кешір… (Иура) Қайдағы жоқ.
Dialogue: 0,0:18:29.36,0:18:33.36,Default,,0000,0000,0000,,Ах, Акира Окудайра
Dialogue: 0,0:18:33.36,0:18:37.30,Default,,0000,0000,0000,,Біз бастауыш сыныптан бері доспыз.
Dialogue: 0,0:18:33.36,0:18:37.30,Default,,0000,0000,0000,,Ал мынау...
Dialogue: 0,0:18:37.30,0:18:40.30,Rubi,,0000,0000,0000,,Хонацуги
Dialogue: 0,0:18:37.30,0:18:40.30,Default,,0000,0000,0000,,Йоко Хонацуги
Dialogue: 0,0:18:37.30,0:18:40.30,Rubi,,0000,0000,0000,,Мотеги
Dialogue: 0,0:18:37.30,0:18:40.30,Default,,0000,0000,0000,,Мива Моги
Dialogue: 0,0:18:40.30,0:18:44.31,Rubi,,0000,0000,0000,,Ясуда
Dialogue: 0,0:18:40.30,0:18:44.31,Default,,0000,0000,0000,,Бұл Мисако Ясуда.
Dialogue: 0,0:18:40.30,0:18:44.31,Default,,0000,0000,0000,,Олар да драма үйірмесіне қатысады.
Dialogue: 0,0:18:44.31,0:18:48.31,Default,,0000,0000,0000,,Біз ол жақта да доспыз.
Dialogue: 0,0:18:44.31,0:18:48.31,Default,,0000,0000,0000,,ұқсайды
Dialogue: 0,0:18:48.31,0:18:51.31,Default,,0000,0000,0000,,-де? Кіші қызыңды неге әкелдің?
Dialogue: 0,0:18:51.31,0:18:55.32,Default,,0000,0000,0000,,Өйткені мына тыққышты қараңыз.
Dialogue: 0,0:18:51.31,0:18:55.32,Default,,0000,0000,0000,,Бұл қымбат
Dialogue: 0,0:18:55.32,0:18:58.32,Default,,0000,0000,0000,,Сізден көп айырмашылығы жоқ.
Dialogue: 0,0:18:55.32,0:18:58.32,Default,,0000,0000,0000,,Дұрыс? Сонымен...
Dialogue: 0,0:18:58.32,0:19:04.33,Default,,0000,0000,0000,,Бірақ Хитклифф
Dialogue: 0,0:18:58.32,0:19:04.33,Default,,0000,0000,0000,,Мен сенен басқа ешкімді ойламаймын.
Dialogue: 0,0:19:04.33,0:19:08.33,Default,,0000,0000,0000,,күрсіну. Қандай өзімшіл жігіт. Ах.
Dialogue: 0,0:19:16.34,0:19:20.34,Default,,0000,0000,0000,,Мен драма үйірмесіне қосылдым.
Dialogue: 0,0:19:16.34,0:19:20.34,Default,,0000,0000,0000,,Сіз қалай ойлайсыз? қызық?
Dialogue: 0,0:19:20.34,0:19:26.35,Default,,0000,0000,0000,,Бұл қызық. Мен әлі сахнаның артында ғана жүрмін.
Dialogue: 0,0:19:20.34,0:19:26.35,Default,,0000,0000,0000,,Маған мұны істеуге рұқсат жоқ, бірақ...
Dialogue: 0,0:19:26.35,0:19:30.35,Default,,0000,0000,0000,,Киоко ханшайым болады.
Dialogue: 0,0:19:26.35,0:19:30.35,Default,,0000,0000,0000,,Бұл сізге жақсы көрінеді.
Dialogue: 0,0:19:30.35,0:19:35.36,Default,,0000,0000,0000,,Екатерина рөлін ала алсаңыз
Dialogue: 0,0:19:30.35,0:19:35.36,Default,,0000,0000,0000,,Мен оның кандидат болғанына сенімдімін.
Dialogue: 0,0:19:35.36,0:19:39.36,Default,,0000,0000,0000,,Бұл менмін
Dialogue: 0,0:19:35.36,0:19:39.36,Default,,0000,0000,0000,,Себебі мен Хитклиффті ойнаймын ба?
Dialogue: 0,0:19:42.30,0:19:48.30,Default,,0000,0000,0000,,Бұл жолы, менің ағам, Хитклифф,
Dialogue: 0,0:19:42.30,0:19:48.30,Default,,0000,0000,0000,,Оны көре білу жеткілікті
Dialogue: 0,0:19:48.30,0:19:51.31,Default,,0000,0000,0000,,Киоко｡➡
Dialogue: 0,0:19:51.31,0:19:54.31,Default,,0000,0000,0000,,Қарап қана көңіліңіз толды ма?
Dialogue: 0,0:19:56.31,0:19:58.31,Default,,0000,0000,0000,,«Ой, жүрегімнің ғашығы.➡
Dialogue: 0,0:19:58.31,0:20:02.32,Default,,0000,0000,0000,,Бұл жолы мені тыңда.
Dialogue: 0,0:19:58.31,0:20:02.32,Default,,0000,0000,0000,,Кэтрин! ”➡
Dialogue: 0,0:20:02.32,0:20:06.32,Default,,0000,0000,0000,,Бұл сізге мұны істегіңіз келетін терезе.
Dialogue: 0,0:20:02.32,0:20:06.32,Default,,0000,0000,0000,,Жаса!
Dialogue: 0,0:20:06.32,0:20:09.32,Default,,0000,0000,0000,,Хехе...
Dialogue: 0,0:20:06.32,0:20:09.32,Default,,0000,0000,0000,,Бірақ бұл өте керемет
Dialogue: 0,0:20:09.32,0:20:12.33,Default,,0000,0000,0000,,Эй, капелла, оны көргің келе ме?
Dialogue: 0,0:20:09.32,0:20:12.33,Default,,0000,0000,0000,,Қуа келе жатқандар кетті.
Dialogue: 0,0:20:12.33,0:20:15.33,Default,,0000,0000,0000,,Ондай нәрсе бар ма?
Dialogue: 0,0:20:12.33,0:20:15.33,Default,,0000,0000,0000,,Иә. Барамыз ба?
Dialogue: 0,0:20:15.33,0:20:18.33,Default,,0000,0000,0000,,Уау, мен оны көргім келеді!
Dialogue: 0,0:20:15.33,0:20:18.33,Default,,0000,0000,0000,,Мен де Мен де
Dialogue: 0,0:20:18.33,0:20:20.34,Default,,0000,0000,0000,,Мұнда
Dialogue: 0,0:20:18.33,0:20:20.34,Default,,0000,0000,0000,,О, сәл күте тұрыңыз.
Dialogue: 0,0:20:20.34,0:20:23.34,Default,,0000,0000,0000,,《Бір сәтте
Dialogue: 0,0:20:20.34,0:20:23.34,Default,,0000,0000,0000,,Біз жақсы дос болдық.
Dialogue: 0,0:20:25.34,0:20:28.34,Default,,0000,0000,0000,,《Әрине керемет жер》
Dialogue: 0,0:20:30.35,0:20:35.35,Default,,0000,0000,0000,,《Жатақханадағы шай ішу
Dialogue: 0,0:20:30.35,0:20:35.35,Default,,0000,0000,0000,,Раушан кеші➡
Dialogue: 0,0:20:35.35,0:20:41.35,Default,,0000,0000,0000,,Сеанстың құпия жиналысы
Dialogue: 0,0:20:35.35,0:20:41.35,Default,,0000,0000,0000,,Кітапхана шығанағындағы терезе...》
Dialogue: 0,0:20:44.29,0:20:47.30,Default,,0000,0000,0000,,《Мен не істеуім керек? Мен сені жақсы көремін.»
Dialogue: 0,0:20:47.30,0:20:50.30,Default,,0000,0000,0000,,≪(есіктің ашылу дыбысы)
Dialogue: 0,0:20:47.30,0:20:50.30,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:20:50.30,0:21:06.30,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:21:10.32,0:21:15.32,Default,,0000,0000,0000,,♬『ｾﾝﾃｨﾌｫﾘｱ』
Dialogue: 0,0:21:15.32,0:21:35.34,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:21:35.34,0:21:53.36,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:21:53.36,0:21:58.37,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:21:58.37,0:22:18.39,Default,,0000,0000,0000,,♬～
