Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:04:49.60,0:04:53.99,Default,,0,0,0,,Бұл субтитр тұтынушы алмасу сынағы мен мониторингі үшін өндірісте пайдалануға арналған. Оны коммерциялық мақсатта пайдаланыңыз. Аударма және уақыт: Ронни Кейінгі кезең: MIR Даму: Юзукико
Dialogue: 0,0:04:45.06,0:04:49.06,Title,,0,0,0,,Ұсталған жел
Dialogue: 1,0:05:03.01,0:05:08.40,Dial-CH2,,0,0,0,,：《》，， 「」
Dialogue: 0,0:05:17.71,0:05:25.51,Scr,,0,0,0,,Вампирлер клубы
Dialogue: 0,0:05:42.74,0:05:45.20,Scr,,0,0,0,,Сыбырлау кезінде кіруге тыйым салынады
Dialogue: 0,0:13:09.23,0:13:12.19,Scr,,0,0,0,,Аспаздың шынайы қатысуы! Біз қашып кеткен мысыққа, Аби Ниши Амая мысыққа, ұрғашы балаға, кімнің өзі болып табылатын адамға жеттік.
Dialogue: 0,0:22:18.02,0:22:25.91,Scr,,0,0,0,,Желдің желі
Dialogue: 0,0:00:14.25,0:00:15.31,Dial-JP,,0,0,0,,Шарлар
Dialogue: 0,0:00:21.23,0:00:23.00,Dial-JP,,0,0,0,,Ол қайдан шықты?
Dialogue: 0,0:00:23.85,0:00:25.08,Dial-JP,,0,0,0,,Шар?
Dialogue: 0,0:00:25.60,0:00:27.41,Dial-JP,,0,0,0,,Ойлап қарасам, бала кезім
Dialogue: 0,0:00:27.41,0:00:30.80,Dial-JP,,0,0,0,,Әжеммен далаға шыққан сайын ол маған шар ұстауға рұқсат берді.
Dialogue: 0,0:00:33.95,0:00:34.76,Dial-JP,,0,0,0,,Біраз
Dialogue: 0,0:00:35.72,0:00:36.61,Dial-JP,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:00:46.89,0:00:49.15,Dial-JP,,0,0,0,,Қандай қызыл шар?
Dialogue: 0,0:00:49.75,0:00:50.85,Dial-JP,,0,0,0,,Мен оны ала аламын ба?
Dialogue: 0,0:00:54.41,0:00:55.27,Dial-JP,,0,0,0,,Түсіндім
Dialogue: 0,0:00:58.12,0:01:01.35,Dial-JP,,0,0,0,,Бала кезімде менде осындай нәрсе болса ғой.
Dialogue: 0,0:01:01.60,0:01:03.29,Dial-JP,,0,0,0,,Эй, ана жақтағы адам.
Dialogue: 0,0:01:03.89,0:01:05.17,Dial-JP,,0,0,0,,Махоро ше?
Dialogue: 0,0:01:06.19,0:01:07.01,Dial-JP,,0,0,0,,Махоро?
Dialogue: 0,0:01:07.67,0:01:10.97,Dial-JP,,0,0,0,,Мен сол шарды жарып жібердім.
Dialogue: 0,0:01:10.97,0:01:13.05,Dial-JP,,0,0,0,,Оны қазір сол жерден алуға болады.
Dialogue: 0,0:01:13.61,0:01:16.31,Dial-JP,,0,0,0,,Жарайды, Махоро оны саған алып береді.
Dialogue: 0,0:01:16.91,0:01:17.49,Dial-JP,,0,0,0,,Иә
Dialogue: 0,0:01:17.84,0:01:19.88,Dial-JP,,0,0,0,,Оны қабылдағаныңызға рахмет.
Dialogue: 0,0:01:20.29,0:01:21.48,Dial-JP,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:01:21.89,0:01:22.94,Dial-JP,,0,0,0,,Бір сәт кешіріңіз
Dialogue: 0,0:01:23.08,0:01:24.28,Dial-JP,,0,0,0,,Жол бер
Dialogue: 0,0:01:27.12,0:01:28.11,Dial-JP,,0,0,0,,(Жаңа атқарушы)
Dialogue: 0,0:01:28.49,0:01:29.48,Dial-JP,,0,0,0,,Рико
Dialogue: 0,0:01:29.48,0:01:32.05,Dial-JP,,0,0,0,,Кешіріңіз, мен толық емес жұмыс уақытыма кешігіп қаламын деп ойлаймын.
Dialogue: 0,0:01:34.92,0:01:35.74,Dial-JP,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:01:36.65,0:01:37.43,Dial-JP,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:01:37.43,0:01:39.45,Dial-JP,,0,0,0,,Мына шарға не болды?
Dialogue: 0,0:01:47.20,0:01:51.30,Dial-JP,,0,0,0,,Баяғыда мен әкеммен және әпкеммен шарларды қуғанбыз.
Dialogue: 0,0:01:55.48,0:01:57.08,Dial-JP,,0,0,0,,Менің қарсылығым жоқ.
Dialogue: 0,0:01:57.51,0:01:58.51,Dial-JP,,0,0,0,,Мен де
Dialogue: 0,0:01:58.96,0:02:00.29,Dial-JP,,0,0,0,,Олай болса...
Dialogue: 0,0:02:00.64,0:02:01.23,Dial-JP,,0,0,0,,О.
Dialogue: 0,0:02:02.96,0:02:04.43,Dial-JP,,0,0,0,,Қызыл шар?
Dialogue: 0,0:02:06.36,0:02:07.71,Dial-JP,,0,0,0,,Мына жерге қара
Dialogue: 0,0:02:08.01,0:02:09.23,Dial-JP,,0,0,0,,Бұл сабақ бөлмесі.
Dialogue: 0,0:02:09.79,0:02:11.88,Dial-JP,,0,0,0,,Лаки ішке кірді.
Dialogue: 0,0:02:21.59,0:02:22.35,Dial-JP,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:02:23.12,0:02:24.01,Dial-JP,,0,0,0,,Шар?
Dialogue: 0,0:02:25.91,0:02:27.91,Dial-JP,,0,0,0,,Қашан кірді деп ойлаймын.
Dialogue: 0,0:02:30.36,0:02:31.13,Dial-JP,,0,0,0,,Уф… Таңертеңгісін-ақ шаршап біттім.
Dialogue: 0,0:02:32.56,0:02:34.51,Dial-JP,,0,0,0,,Қалайсыңдар?
Dialogue: 0,0:02:34.81,0:02:36.19,Dial-JP,,0,0,0,,Не болса да...
Dialogue: 0,0:02:38.05,0:02:40.47,Dial-JP,,0,0,0,,Қызық, бізге не болды?
Dialogue: 0,0:02:41.64,0:02:42.68,Dial-JP,,0,0,0,,Қызық екен
Dialogue: 0,0:02:42.68,0:02:45.45,Dial-JP,,0,0,0,,Бірақ мен сенің соңынан қумасқа амалым жоқ.
Dialogue: 0,0:02:46.57,0:02:48.29,Dial-JP,,0,0,0,,Бұл жұмбақ шар.
Dialogue: 0,0:02:50.73,0:02:51.79,Dial-JP,,0,0,0,,Сендер
Dialogue: 0,0:02:53.48,0:02:55.11,Dial-JP,,0,0,0,,Неге мұндасың?
Dialogue: 0,0:02:55.36,0:02:56.84,Dial-JP,,0,0,0,,Неліктен?
Dialogue: 0,0:02:56.84,0:03:00.69,Dial-JP,,0,0,0,,Неге екенін білмеймін, бірақ мен мына шарды қуып шығуды шештім.
Dialogue: 0,0:03:00.69,0:03:03.01,Dial-JP,,0,0,0,,Соңында осы бөлмеге кіріңіз
Dialogue: 0,0:03:04.17,0:03:06.25,Dial-JP,,0,0,0,,Енді менікі
Dialogue: 0,0:03:07.25,0:03:08.99,Dial-JP,,0,0,0,,Масаки-сан, бұл...
Dialogue: 0,0:03:09.35,0:03:10.25,Dial-JP,,0,0,0,,Иә.
Dialogue: 0,0:03:10.41,0:03:12.76,Dial-JP,,0,0,0,,Бәрі сөзсіз бе деп ойлаймын.
Dialogue: 0,0:04:56.76,0:04:58.08,Dial-JP,,0,0,0,,Орындалды!
Dialogue: 0,0:04:59.47,0:05:01.60,Dial-JP,,0,0,0,,Бұл жұмбақ шар еді.
Dialogue: 0,0:05:03.01,0:05:05.95,Dial-JP,,0,0,0,,Якуши Татхагата да сені көрсін.
Dialogue: 0,0:05:06.41,0:05:08.40,Dial-JP,,0,0,0,,Уиро қарсы емес пе?
Dialogue: 0,0:05:12.05,0:05:12.68,Dial-JP,,0,0,0,,Жарайды
Dialogue: 0,0:05:13.15,0:05:14.69,Dial-JP,,0,0,0,,Ал...
Dialogue: 0,0:05:18.91,0:05:20.28,Dial-JP,,0,0,0,,Мұны істейік
Dialogue: 0,0:05:27.23,0:05:28.47,Dial-JP,,0,0,0,,Сіз қалай дыбыстайсыз?
Dialogue: 0,0:05:28.93,0:05:29.85,Dial-JP,,0,0,0,,«Мен… мен адаммын.»
Dialogue: 0,0:05:31.77,0:05:32.69,Dial-JP,,0,0,0,,Ол ашық.
Dialogue: 0,0:05:34.95,0:05:36.80,Dial-JP,,0,0,0,,Мен қиындыққа тап болдым
Dialogue: 0,0:05:37.60,0:05:38.78,Dial-JP,,0,0,0,,Дайын
Dialogue: 0,0:05:39.40,0:05:40.23,Dial-JP,,0,0,0,,Орындалды
Dialogue: 0,0:05:40.23,0:05:41.17,Dial-JP,,0,0,0,,Рахмет
Dialogue: 0,0:06:01.69,0:06:04.76,Dial-JP,,0,0,0,,Қайырлы таң баршаңызға Сәлем Қайырлы кеш
Dialogue: 0,0:06:05.01,0:06:07.97,Dial-JP,,0,0,0,,Құлағыңызға қуаныш сыйлайтын радио
Dialogue: 0,0:06:08.35,0:06:11.10,Dial-JP,,0,0,0,,Дауыстық актер болғысы келетін төртеумізден
Dialogue: 0,0:06:11.47,0:06:13.79,Dial-JP,,0,0,0,,Мен мұны сізге шын жүректен жіберемін.
Dialogue: 0,0:06:20.80,0:06:22.43,Dial-JP,,0,0,0,,Біріншіден, өзін-өзі таныстыру
Dialogue: 0,0:06:22.60,0:06:27.67,Dial-JP,,0,0,0,,Біз «AiRBLUE» деп аталатын агенттікке жататын үміткер дауыс актерлеріміз.
Dialogue: 0,0:06:28.03,0:06:29.80,Dial-JP,,0,0,0,,Мен Михару Йоминмін
Dialogue: 0,0:06:30.33,0:06:31.45,Dial-JP,,0,0,0,,Менің атым Махоро Мияджи.
Dialogue: 0,0:06:31.85,0:06:32.87,Dial-JP,,0,0,0,,Бұл Айя Камуро.
Dialogue: 0,0:06:33.49,0:06:35.85,Dial-JP,,0,0,0,,Ал мен соңғымын
Dialogue: 0,0:06:35.85,0:06:37.67,Dial-JP,,0,0,0,,Менің атым Рико Хинакура.
Dialogue: 0,0:06:37.96,0:06:39.85,Dial-JP,,0,0,0,,Бүгін мен бірінші рет, сондықтан
Dialogue: 0,0:06:39.85,0:06:43.35,Dial-JP,,0,0,0,,Біз туралы көбірек білгіңіз келеді.
Dialogue: 0,0:06:43.56,0:06:45.37,Dial-JP,,0,0,0,,Айтпақшы, бұл жолғы радио
Dialogue: 0,0:06:45.37,0:06:47.29,Dial-JP,,0,0,0,,Риконың бөлмесінен жіберілді
Dialogue: 0,0:06:47.51,0:06:51.00,Dial-JP,,0,0,0,,Бұдан былай әркімнің бөлмесіне кезек-кезек кіреміз.
Dialogue: 0,0:06:51.20,0:06:54.37,Dial-JP,,0,0,0,,Барлығымыз бір жатақханада тұрамыз.
Dialogue: 0,0:06:54.75,0:06:56.77,Dial-JP,,0,0,0,,Кенет, біз
Dialogue: 0,0:06:57.11,0:06:58.37,Dial-JP,,0,0,0,,Бұл команда.
Dialogue: 0,0:06:59.43,0:07:02.88,Dial-JP,,0,0,0,,Енді үшінші қабат жеті адам тұратын бөлме.
Dialogue: 0,0:07:04.71,0:07:07.03,Dial-JP,,0,0,0,,Біздің бөлмелер қатар орналасқан.
Dialogue: 0,0:07:07.37,0:07:08.75,Dial-JP,,0,0,0,,Дұрыс.
Dialogue: 0,0:07:08.75,0:07:11.29,Dial-JP,,0,0,0,,Енді төртеуің команда болдыңдар.
Dialogue: 0,0:07:12.04,0:07:12.91,Dial-JP,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:12.91,0:07:14.33,Dial-JP,,0,0,0,,Дұрыс.
Dialogue: 0,0:07:14.61,0:07:16.88,Dial-JP,,0,0,0,,Махоро мұны құптамайды.
Dialogue: 0,0:07:16.88,0:07:18.60,Dial-JP,,0,0,0,,Махоро-чан
Dialogue: 0,0:07:18.60,0:07:22.03,Dial-JP,,0,0,0,,Әр команданың не істеп, өскенін қалайсыз?
Dialogue: 0,0:07:22.03,0:07:24.30,Dial-JP,,0,0,0,,Бұл президент Масакидің жоспары.
Dialogue: 0,0:07:24.97,0:07:27.13,Dial-JP,,0,0,0,,Мен мұны білемін, бірақ
Dialogue: 0,0:07:27.53,0:07:29.99,Dial-JP,,0,0,0,,Ей, бұл үлкен мәселе.
Dialogue: 0,0:07:29.99,0:07:32.47,Dial-JP,,0,0,0,,Мен бізбен бірдеңе жасап көргім келеді.
Dialogue: 0,0:07:32.76,0:07:33.93,Dial-JP,,0,0,0,,Не?
Dialogue: 0,0:07:33.93,0:07:35.00,Dial-JP,,0,0,0,,Төрт адам?
Dialogue: 0,0:07:35.00,0:07:38.31,Dial-JP,,0,0,0,,Егер сіз жұмысқа тұрсаңыз, бұл ең жақсы нәрсе.
Dialogue: 0,0:07:38.67,0:07:41.69,Dial-JP,,0,0,0,,Біз әлі ол сатыда емеспіз.
Dialogue: 0,0:07:42.01,0:07:44.71,Dial-JP,,0,0,0,,Төрт адам бірге жасай алатын нәрсе ме?
Dialogue: 0,0:07:45.37,0:07:49.79,Dial-JP,,0,0,0,,Сондықтан Махоро басқалардан көбірек танылған жалғыз дауыс актері.
Dialogue: 0,0:07:51.76,0:07:54.89,Dial-JP,,0,0,0,,Эй, Махоро жатақханада тұра бастады.
Dialogue: 0,0:07:54.89,0:07:56.96,Dial-JP,,0,0,0,,Қазіргіге қарағанда тікендірек болды, солай емес пе?
Dialogue: 0,0:07:57.79,0:07:58.88,Dial-JP,,0,0,0,,Бұл болды
Dialogue: 0,0:07:59.27,0:08:01.20,Dial-JP,,0,0,0,,Иә, қышыды.
Dialogue: 0,0:08:01.48,0:08:05.72,Dial-JP,,0,0,0,,Дәлірек айтсақ, Махоро топта өмір сүретін тип болмауы мүмкін.
Dialogue: 0,0:08:07.24,0:08:11.27,Dial-JP,,0,0,0,,Махоро бастапқыда жатақханада тұрғысы келмеді.
Dialogue: 0,0:08:11.57,0:08:14.12,Dial-JP,,0,0,0,,Жуынуға уақыт бөлуде келіспеушілік.
Dialogue: 0,0:08:14.12,0:08:15.52,Dial-JP,,0,0,0,,...
Dialogue: 0,0:08:15.91,0:08:16.95,Dial-JP,,0,0,0,,Бұл...
Dialogue: 0,0:08:17.93,0:08:19.73,Dial-JP,,0,0,0,,Біреумен ұрысып қалдыңыз ба?
Dialogue: 0,0:08:19.95,0:08:21.87,Dial-JP,,0,0,0,,Сіз ұрысып қалдыңыз, солай ма?
Dialogue: 0,0:08:21.87,0:08:24.03,Dial-JP,,0,0,0,,О, солай деп ойлаймын.
Dialogue: 0,0:08:24.03,0:08:25.37,Dial-JP,,0,0,0,,есімде жоқ
Dialogue: 0,0:08:25.68,0:08:29.76,Dial-JP,,0,0,0,,Осыған байланысты мен Михарумен сөйлескенде мен жынды болып кетемін.
Dialogue: 0,0:08:31.16,0:08:33.83,Dial-JP,,0,0,0,,Бірақ Михарудың қарқынының арқасында
Dialogue: 0,0:08:33.83,0:08:36.85,Dial-JP,,0,0,0,,Мен төртеуміз бір топ болып жиналғандай сезінемін.
Dialogue: 0,0:08:38.29,0:08:39.48,Dial-JP,,0,0,0,,Секір!!
Dialogue: 0,0:08:39.48,0:08:43.38,Dial-JP,,0,0,0,,Мен ұсынған алкоголь бұрышын бастаймыз ба?
Dialogue: 0,0:08:43.67,0:08:45.48,Dial-JP,,0,0,0,,Айтайын дегенім, мен оны өзіммен бірге алып келдім.
Dialogue: 0,0:08:45.48,0:08:47.65,Dial-JP,,0,0,0,,Басынан мотивацияға толы
Dialogue: 0,0:08:47.65,0:08:50.35,Dial-JP,,0,0,0,,Мен әлі ішімдік іше алмаймын.
Dialogue: 0,0:08:50.71,0:08:52.17,Dial-JP,,0,0,0,,(Тик-так, сағаттың көрсеткіштері тик-так)
Dialogue: 0,0:08:52.17,0:08:53.35,Dial-JP,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:08:53.61,0:08:56.48,Dial-JP,,0,0,0,,Бірақ төртеуміз жиналмай тұрып
Dialogue: 0,0:08:56.48,0:08:59.44,Dial-JP,,0,0,0,,Негізі тағы бір оқиға болды, солай ма?
Dialogue: 0,0:08:59.68,0:09:02.56,Dial-JP,,0,0,0,,Оқиға деп айтсақ, артық айтқандық.
Dialogue: 0,0:09:02.83,0:09:05.69,Dial-JP,,0,0,0,,Жоқ, бұл оқиға болды, Ая.
Dialogue: 0,0:09:05.69,0:09:08.12,Dial-JP,,0,0,0,,Дұрыс, оқиға болған оқиға.
Dialogue: 0,0:09:09.55,0:09:11.13,Dial-JP,,0,0,0,,Даусыңды естігім келді. Сені көргім келді.
Dialogue: 0,0:09:11.13,0:09:12.75,Dial-JP,,0,0,0,,Нян
Dialogue: 0,0:09:13.00,0:09:14.62,Dial-JP,,0,0,0,,Нян... Нян
Dialogue: 0,0:09:17.83,0:09:19.79,Dial-JP,,0,0,0,,Сүйкімді мысық
Dialogue: 0,0:09:20.17,0:09:22.33,Dial-JP,,0,0,0,,Жатақханадағы мысықтар қауіпті емес
Dialogue: 0,0:09:22.33,0:09:24.75,Dial-JP,,0,0,0,,Ая, мына қызды мен көтердім.
Dialogue: 0,0:09:26.27,0:09:27.69,Dial-JP,,0,0,0,,3 күн бұрын түн
Dialogue: 0,0:09:28.75,0:09:31.08,Dial-JP,,0,0,0,,Жатақханаға қайтар жолда жол жиегінде
Dialogue: 0,0:09:31.08,0:09:32.93,Dial-JP,,0,0,0,,Мына бала еңкейіп отыр.
Dialogue: 0,0:09:33.19,0:09:36.12,Dial-JP,,0,0,0,,Мен сені құтқара алмайтын шығармын деп ойладым.
Dialogue: 0,0:09:36.12,0:09:37.56,Dial-JP,,0,0,0,,Мен оны елемеу мүмкін емес
Dialogue: 0,0:09:37.97,0:09:41.64,Dial-JP,,0,0,0,,Мен оны үйіне апардым, жылы ваннаға жібердім, тамақ бердім.
Dialogue: 0,0:09:42.28,0:09:44.36,Dial-JP,,0,0,0,,Мен тез жақсарып келемін
Dialogue: 0,0:09:44.87,0:09:46.80,Dial-JP,,0,0,0,,Оны мына жатақханада ұстай алмайсың.
Dialogue: 0,0:09:46.80,0:09:48.94,Dial-JP,,0,0,0,,Ереже - үй жануарларына болмайды.
Dialogue: 0,0:09:49.29,0:09:50.40,Dial-JP,,0,0,0,,Мен білемін
Dialogue: 0,0:09:50.69,0:09:53.91,Dial-JP,,0,0,0,,Бірақ мен сені жақсы сезінесің деп қуып жібере алмаймын...
Dialogue: 0,0:09:54.13,0:09:56.20,Dial-JP,,0,0,0,,Жоқ, оны жеңіл қабылдамаңыз.
Dialogue: 0,0:09:56.53,0:09:57.93,Dial-JP,,0,0,0,,Мен саған жақсы қарай аламын.
Dialogue: 0,0:09:57.93,0:09:59.62,Dial-JP,,0,0,0,,Ауырып қалсаңыз не істеу керек
Dialogue: 0,0:09:59.92,0:10:01.49,Dial-JP,,0,0,0,,Сонымен... міне, солай.
Dialogue: 0,0:10:02.56,0:10:06.37,Dial-JP,,0,0,0,,Бірақ мен бұл баланы тастап кете алмаймын.
Dialogue: 0,0:10:07.23,0:10:08.23,Dial-JP,,0,0,0,,Сонымен...
Dialogue: 0,0:10:08.76,0:10:10.51,Dial-JP,,0,0,0,,Сүйкімді
Dialogue: 0,0:10:11.12,0:10:13.47,Dial-JP,,0,0,0,,Шынымды айтсам, мысықтар қу.
Dialogue: 0,0:10:13.47,0:10:15.01,Dial-JP,,0,0,0,,Қарсы тұру мүмкін емес.
Dialogue: 0,0:10:15.32,0:10:18.79,Dial-JP,,0,0,0,,Әй, бұл балада аздап Абиссиндік бар.
Dialogue: 0,0:10:18.79,0:10:20.73,Dial-JP,,0,0,0,,Не, мынаны жеуге болмай ма?
Dialogue: 0,0:10:21.24,0:10:23.57,Dial-JP,,0,0,0,,Бұл мысық тұқымы, Юки-чан.
Dialogue: 0,0:10:23.57,0:10:25.94,Dial-JP,,0,0,0,,Надандығыңның шегі бар.
Dialogue: 0,0:10:26.19,0:10:27.20,Dial-JP,,0,0,0,,Неге осы дене функциялары әлі де болады?
Dialogue: 0,0:10:27.20,0:10:29.19,Dial-JP,,0,0,0,,Ешқандай байыптылық жоқ.
Dialogue: 0,0:10:29.41,0:10:31.61,Dial-JP,,0,0,0,,Мен сені одан сайын ашуландырады деп ойладым.
Dialogue: 0,0:10:31.80,0:10:33.15,Dial-JP,,0,0,0,,О, құдай!
Dialogue: 0,0:10:33.15,0:10:35.03,Dial-JP,,0,0,0,,Міне...
Dialogue: 0,0:10:36.15,0:10:38.11,Dial-JP,,0,0,0,,Себебі бар
Dialogue: 0,0:10:41.07,0:10:43.76,Dial-JP,,0,0,0,,Яғни, жатақханаға кіргенше.
Dialogue: 0,0:10:43.76,0:10:48.04,Dial-JP,,0,0,0,,Алғашқы сегіз адамның арасында тасбақаны ұстауға келісім болды.
Dialogue: 0,0:10:48.04,0:10:50.24,Dial-JP,,0,0,0,,Бұл Каме емес, Камей-сан.
Dialogue: 0,0:10:50.24,0:10:51.80,Dial-JP,,0,0,0,,Ұқсас
Dialogue: 0,0:10:52.21,0:10:56.37,Dial-JP,,0,0,0,,Бірақ Махоро бұл өте қиын екенін түсінді.
Dialogue: 0,0:10:58.75,0:11:01.52,Dial-JP,,0,0,0,,Бұл соншалықты маңызды емес.
Dialogue: 0,0:11:02.83,0:11:04.07,Dial-JP,,0,0,0,,Сізге жақсы.
Dialogue: 0,0:11:04.07,0:11:05.56,Dial-JP,,0,0,0,,Мен осында қала аламын.
Dialogue: 0,0:11:05.93,0:11:07.05,Dial-JP,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:11:07.49,0:11:09.07,Dial-JP,,0,0,0,,Бұл котенка менің мысық.
Dialogue: 0,0:11:09.07,0:11:10.39,Dial-JP,,0,0,0,,Қаңғыбас мысық емес
Dialogue: 0,0:11:10.59,0:11:11.87,Dial-JP,,0,0,0,,Сіз қайдан білесіз?
Dialogue: 0,0:11:12.15,0:11:14.27,Dial-JP,,0,0,0,,Мен пальто жақсы деп ойладым.
Dialogue: 0,0:11:14.27,0:11:15.39,Dial-JP,,0,0,0,,Мен енді ғана түсіндім
Dialogue: 0,0:11:15.69,0:11:18.08,Dial-JP,,0,0,0,,Бұл бала жақында ауруханаға түсті.
Dialogue: 0,0:11:18.08,0:11:19.55,Dial-JP,,0,0,0,,Аурухана...
Dialogue: 0,0:11:20.29,0:11:21.28,Dial-JP,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:11:21.28,0:11:22.87,Dial-JP,,0,0,0,,Сонда мына бала...
Dialogue: 0,0:11:23.07,0:11:26.83,Dial-JP,,0,0,0,,Операциядан кейін көп ұзамай мысықты тастап кету екіталай.
Dialogue: 0,0:11:27.09,0:11:30.04,Dial-JP,,0,0,0,,Иесі болса басқа әңгіме.
Dialogue: 0,0:11:30.36,0:11:31.13,Dial-JP,,0,0,0,,Иә.
Dialogue: 0,0:11:31.53,0:11:34.26,Dial-JP,,0,0,0,,Ең болмағанда, иесінің тілегі тыңдалуы керек.
Dialogue: 0,0:11:34.26,0:11:37.27,Dial-JP,,0,0,0,,Бірақ, бірақ мен бұл баланы көтеріп алдым.
Dialogue: 0,0:11:37.27,0:11:39.27,Dial-JP,,0,0,0,,Мен шаршадым, сондықтан мені жылытыңызшы.
Dialogue: 0,0:11:39.27,0:11:41.64,Dial-JP,,0,0,0,,Ая, бөлмеде біраз тынышталайық.
Dialogue: 0,0:11:42.01,0:11:46.60,Dial-JP,,0,0,0,,Ей, бізбен бірге нағыз иесін іздейік.
Dialogue: 0,0:11:46.84,0:11:48.76,Dial-JP,,0,0,0,,Менің ойымша, бұл да жақсырақ.
Dialogue: 0,0:11:49.92,0:11:52.65,Dial-JP,,0,0,0,,Сенің сезіміңді білмеймін.
Dialogue: 0,0:11:53.36,0:11:56.21,Dial-JP,,0,0,0,,Айя Осы бала туралы ойланайық.
Dialogue: 0,0:11:56.21,0:11:58.05,Dial-JP,,0,0,0,,Сізді не бақытты етеді?
Dialogue: 0,0:11:58.05,0:11:59.55,Dial-JP,,0,0,0,,Яғни, егер сен осындай әдепсіз сөздерді айтып отырсаң,
Dialogue: 0,0:11:59.55,0:12:00.32,Dial-JP,,0,0,0,,Ая
Dialogue: 0,0:12:07.25,0:12:08.13,Dial-JP,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:08.59,0:12:10.79,Dial-JP,,0,0,0,,Иесін тауып көрейік
Dialogue: 0,0:12:11.05,0:12:11.91,Dial-JP,,0,0,0,,Жарайды
Dialogue: 0,0:12:12.16,0:12:16.01,Dial-JP,,0,0,0,,Жоғалған мысық иесін іздеу операциясын жасаймыз ба?
Dialogue: 0,0:12:16.37,0:12:17.47,Dial-JP,,0,0,0,,Иә
Dialogue: 0,0:12:21.49,0:12:23.89,Dial-JP,,0,0,0,,Бұл қазірдің өзінде тітіркендіргіш
Dialogue: 0,0:12:24.31,0:12:25.69,Dial-JP,,0,0,0,,Махоро да көмектеседі
Dialogue: 0,0:12:28.16,0:12:31.15,Dial-JP,,0,0,0,,Осылайша иесін іздеу басталды.
Dialogue: 0,0:12:31.15,0:12:33.61,Dial-JP,,0,0,0,,Нәтиже қандай болды?
Dialogue: 0,0:12:33.61,0:12:35.77,Dial-JP,,0,0,0,,Бұған дейін аздап үзіліс
Dialogue: 0,0:12:36.23,0:12:37.40,Dial-JP,,0,0,0,,Мұнда?
Dialogue: 0,0:12:38.35,0:12:40.79,Dial-JP,,0,0,0,,Қарсы желді ұстаңыз
Dialogue: 0,0:12:45.19,0:12:48.59,Dial-JP,,0,0,0,,Ей, мен саған бұл оқиғаны айтып берейін.
Dialogue: 0,0:12:48.59,0:12:50.25,Dial-JP,,0,0,0,,Қазір не істеп жатырсың?
Dialogue: 0,0:12:50.25,0:12:52.84,Dial-JP,,0,0,0,,Осылайша төртеуміз жиналдық.
Dialogue: 0,0:12:54.03,0:12:57.97,Dial-JP,,0,0,0,,Оның орнына мен бірнеше ұсынылған мангамен таныстырғым келеді.
Dialogue: 0,0:12:58.21,0:13:00.60,Dial-JP,,0,0,0,,Оны келесі жолы сақтайық.
Dialogue: 0,0:13:00.60,0:13:02.80,Dial-JP,,0,0,0,,Ая басты кейіпкер, солай ма?
Dialogue: 0,0:13:05.12,0:13:06.00,Dial-JP,,0,0,0,,Иә
Dialogue: 0,0:13:07.71,0:13:09.23,Dial-JP,,0,0,0,,Мен үйдемін
Dialogue: 0,0:13:09.60,0:13:12.19,Dial-JP,,0,0,0,,Мен көптеген парақшаларды жапсырдым.
Dialogue: 0,0:13:12.47,0:13:14.15,Dial-JP,,0,0,0,,Интернет туралы не деуге болады?
Dialogue: 0,0:13:14.49,0:13:17.36,Dial-JP,,0,0,0,,Біз мүмкіндігінше ақпаратты таратып жатырмыз.
Dialogue: 0,0:13:18.75,0:13:20.08,Dial-JP,,0,0,0,,(Ходжинс) Бүгіннен бастап мен Автоматты жазу қуыршағының шәкірті болып жұмыс істеймін.
Dialogue: 0,0:13:20.51,0:13:23.05,Dial-JP,,0,0,0,,28 000 жазылушы?
Dialogue: 0,0:13:23.05,0:13:24.04,Dial-JP,,0,0,0,,…бізге қатты қажетті жігерлі сөздер айтады
Dialogue: 0,0:13:24.04,0:13:27.77,Dial-JP,,0,0,0,,Өзін-өзі өндіру де қазіргі уақытта дауыс берушілер үшін маңызды.
Dialogue: 0,0:13:28.11,0:13:30.60,Dial-JP,,0,0,0,,Бірақ иесі көршіде болса керек.
Dialogue: 0,0:13:30.60,0:13:33.13,Dial-JP,,0,0,0,,SNS әсерлері жақсы күтілмейді.
Dialogue: 0,0:13:33.28,0:13:34.95,Dial-JP,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:13:34.95,0:13:38.34,Dial-JP,,0,0,0,,Жоғалған мысықтар кейде күтпеген жерден ажырасып қалады.
Dialogue: 0,0:13:38.89,0:13:40.32,Dial-JP,,0,0,0,,Айтпақшы, Айя ше?
Dialogue: 0,0:13:40.85,0:13:42.91,Dial-JP,,0,0,0,,Ол бөлмеде Ми Чанмен бірге екенін айтты.
Dialogue: 0,0:13:43.21,0:13:44.30,Dial-JP,,0,0,0,,Ми Чан деген кім?
Dialogue: 0,0:13:44.89,0:13:46.76,Dial-JP,,0,0,0,,Сәлем Ми Чан
Dialogue: 0,0:13:47.55,0:13:50.23,Dial-JP,,0,0,0,,Мен мәңгі бірге өмір сүргім келеді.
Dialogue: 0,0:13:50.69,0:13:55.19,Dial-JP,,0,0,0,,Мен саған ат қоймауым керек дедім, себебі бұл менің сезіміме әсер етеді.
Dialogue: 0,0:13:55.64,0:13:57.41,Dial-JP,,0,0,0,,Тез иесін тауып алайық
Dialogue: 0,0:13:57.41,0:13:58.94,Dial-JP,,0,0,0,,Тым кеш болмай тұрып
Dialogue: 0,0:14:01.36,0:14:04.83,Dial-JP,,0,0,0,,Ая: Ол бала ғой.
Dialogue: 0,0:14:04.83,0:14:06.66,Dial-JP,,0,0,0,,Сәлем Махоро
Dialogue: 0,0:14:10.88,0:14:13.23,Dial-JP,,0,0,0,,Сіз шыншыл емессіз, Махороха.
Dialogue: 0,0:14:13.23,0:14:15.79,Dial-JP,,0,0,0,,Бұл не?
Dialogue: 0,0:14:16.35,0:14:17.67,Dial-JP,,0,0,0,,Мейірімді болсаң да
Dialogue: 0,0:14:17.67,0:14:19.38,Dial-JP,,0,0,0,,Махородан басқа
Dialogue: 0,0:14:20.56,0:14:21.96,Dial-JP,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:14:22.23,0:14:23.76,Dial-JP,,0,0,0,,Махоро шыншыл емес
Dialogue: 0,0:14:24.05,0:14:26.72,Dial-JP,,0,0,0,,Айямен тоқтаңыз.
Dialogue: 0,0:14:27.15,0:14:30.68,Dial-JP,,0,0,0,,Өйткені, білесің бе, Ми Чанның иесі келгенде.
Dialogue: 0,0:14:34.49,0:14:35.59,Dial-JP,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:14:35.59,0:14:37.01,Dial-JP,,0,0,0,,Бұл шынымен де келді
Dialogue: 0,0:14:37.01,0:14:39.99,Dial-JP,,0,0,0,,Сондықтан біз көп еңбектендік.
Dialogue: 0,0:14:40.33,0:14:41.24,Dial-JP,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:14:41.83,0:14:45.01,Dial-JP,,0,0,0,,Мен бұл баламен әлі дұрыс қоштаспадым.
Dialogue: 0,0:14:45.20,0:14:48.47,Dial-JP,,0,0,0,,Дұрыс, жатақханада бірге тұра алмасаңдар, осы жерден кетіңдер...
Dialogue: 0,0:14:48.47,0:14:49.13,Dial-JP,,0,0,0,,Ая
Dialogue: 0,0:14:49.75,0:14:53.28,Dial-JP,,0,0,0,,Сіз мұнда актер болғыңыз келгендіктен келмедіңіз.
Dialogue: 0,0:14:53.28,0:14:54.87,Dial-JP,,0,0,0,,Бірақ Ми Чан...
Dialogue: 0,0:14:54.87,0:14:57.88,Dial-JP,,0,0,0,,Сол себепті армандарыңызды тастау оңай
Dialogue: 0,0:14:58.24,0:15:01.20,Dial-JP,,0,0,0,,Мен сізді кәсіпқойлығы бар тип деп ойладым.
Dialogue: 0,0:15:01.20,0:15:02.56,Dial-JP,,0,0,0,,Мүлде жоқ
Dialogue: 0,0:15:02.92,0:15:05.09,Dial-JP,,0,0,0,,Шынымды айтсам, таңырқап, ештеңе айта алмаймын.
Dialogue: 0,0:15:05.32,0:15:06.49,Dial-JP,,0,0,0,,Махоро
Dialogue: 0,0:15:06.49,0:15:07.80,Dial-JP,,0,0,0,,Енді, енді.
Dialogue: 0,0:15:07.80,0:15:10.44,Dial-JP,,0,0,0,,Махоро, оны әзірше қалдырайық.
Dialogue: 0,0:15:10.89,0:15:13.18,Dial-JP,,0,0,0,,Сабыр сақта, Ая.
Dialogue: 0,0:15:16.84,0:15:21.11,Dial-JP,,0,0,0,,Мм, сенің осы кеңседе мысық ұстайтыныңды естідім.
Dialogue: 0,0:15:21.40,0:15:24.49,Dial-JP,,0,0,0,,Менің Миком шығар деп ойладым.
Dialogue: 0,0:15:25.88,0:15:26.63,Dial-JP,,0,0,0,,Ая
Dialogue: 0,0:15:34.89,0:15:36.51,Dial-JP,,0,0,0,,Сол Ми Чан...
Dialogue: 0,0:15:38.96,0:15:39.59,Dial-JP,,0,0,0,,Мико
Dialogue: 0,0:15:41.47,0:15:42.25,Dial-JP,,0,0,0,,Ум...
Dialogue: 0,0:15:48.19,0:15:49.22,Dial-JP,,0,0,0,,Мико
Dialogue: 0,0:15:50.41,0:15:52.73,Dial-JP,,0,0,0,,Мико, мен сені іздедім.
Dialogue: 0,0:15:53.36,0:15:55.47,Dial-JP,,0,0,0,,Жақсы, Мико
Dialogue: 0,0:15:56.52,0:15:58.55,Dial-JP,,0,0,0,,Мен қатты уайымдадым.
Dialogue: 0,0:15:58.72,0:16:01.12,Dial-JP,,0,0,0,,Бірақ мен оны тапқаныма қуаныштымын.
Dialogue: 0,0:16:01.37,0:16:02.15,Dial-JP,,0,0,0,,Мико
Dialogue: 0,0:16:02.15,0:16:03.12,Dial-JP,,0,0,0,,Ми-чан
Dialogue: 0,0:16:09.40,0:16:11.89,Dial-JP,,0,0,0,,Үйге қайтайық, Мико.
Dialogue: 0,0:16:11.89,0:16:13.77,Dial-JP,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:16:13.77,0:16:15.41,Dial-JP,,0,0,0,,Менің атым Махоро Мияджи.
Dialogue: 0,0:16:15.88,0:16:18.53,Dial-JP,,0,0,0,,Сіз жоғалған мысықтың иесісіз, солай ма?
Dialogue: 0,0:16:18.95,0:16:19.77,Dial-JP,,0,0,0,,Иә
Dialogue: 0,0:16:21.17,0:16:23.88,Dial-JP,,0,0,0,,Бұл бала менің Миком екені сөзсіз.
Dialogue: 0,0:16:24.15,0:16:28.09,Dial-JP,,0,0,0,,Бала өткен күні жаңбырлы күні жол жиегінде еңкейіп қалды.
Dialogue: 0,0:16:28.09,0:16:30.35,Dial-JP,,0,0,0,,Ол әбден әлсіреп қалған сияқты.
Dialogue: 0,0:16:32.03,0:16:32.97,Dial-JP,,0,0,0,,Мико
Dialogue: 0,0:16:34.91,0:16:37.77,Dial-JP,,0,0,0,,Камуро мырза тапты.
Dialogue: 0,0:16:38.25,0:16:40.88,Dial-JP,,0,0,0,,Сондықтан ол оған қамқор болды.
Dialogue: 0,0:16:42.35,0:16:46.44,Dial-JP,,0,0,0,,Үй жануарларына рұқсат етілмеген жатақханада бірге тұрамыз.
Dialogue: 0,0:16:47.00,0:16:51.11,Dial-JP,,0,0,0,,Бірақ ол әлсіз Мико Чанды тастап кете алмады.
Dialogue: 0,0:16:51.37,0:16:53.31,Dial-JP,,0,0,0,,Сенсізде мен саған қамқор болдым.
Dialogue: 0,0:16:53.81,0:16:57.59,Dial-JP,,0,0,0,,Ешкімге айтпай өз бетімше еңбек еттім.
Dialogue: 0,0:17:00.99,0:17:02.63,Dial-JP,,0,0,0,,Дегенмен, 11 жасыңдағы кезіңмен салыстырғанда бетің біраз өзгерген болар
Dialogue: 0,0:17:05.99,0:17:08.30,Dial-JP,,0,0,0,,Ендеше алдымен ол туралы сөйлесейік...
Dialogue: 0,0:17:09.12,0:17:13.08,Dial-JP,,0,0,0,,Камуро мырзаға рахмет айта аласыз ба?
Dialogue: 0,0:17:16.56,0:17:18.17,Dial-JP,,0,0,0,,Уақыты келді…
Dialogue: 0,0:17:18.17,0:17:20.91,Dial-JP,,0,0,0,,Өзіңіз айтқандай, алдымен рахмет.
Dialogue: 0,0:17:21.35,0:17:22.48,Dial-JP,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:22.48,0:17:25.09,Dial-JP,,0,0,0,,Ертерек толқығаным сонша, секірдім.
Dialogue: 0,0:17:27.00,0:17:28.28,Dial-JP,,0,0,0,,Махоро
Dialogue: 0,0:17:30.17,0:17:32.32,Dial-JP,,0,0,0,,Жоқ, бұл негізсіз емес.
Dialogue: 0,0:17:32.65,0:17:34.96,Dial-JP,,0,0,0,,Сіздің сүйікті мысық жоғалған кезде
Dialogue: 0,0:17:34.96,0:17:37.36,Dial-JP,,0,0,0,,Мен қатты уайымдап тұрмын
Dialogue: 0,0:17:37.65,0:17:41.48,Dial-JP,,0,0,0,,Түнде ұйықтай алмай мазасызданатыныңызды түсінемін.
Dialogue: 0,0:17:42.32,0:17:43.96,Dial-JP,,0,0,0,,Мико-чан да сондықтан
Dialogue: 0,0:17:43.96,0:17:46.35,Dial-JP,,0,0,0,,Мен иесінің табылғанына қуаныштымын.
Dialogue: 0,0:17:47.04,0:17:48.31,Dial-JP,,0,0,0,,Сәлем Ая
Dialogue: 0,0:18:00.36,0:18:02.40,Dial-JP,,0,0,0,,Сіз маған қамқор болдыңыз, солай емес пе?
Dialogue: 0,0:18:02.88,0:18:05.61,Dial-JP,,0,0,0,,Сен кеткеннен де сұлусың.
Dialogue: 0,0:18:07.20,0:18:09.88,Dial-JP,,0,0,0,,Ми-чан… Мико-чан…
Dialogue: 0,0:18:10.81,0:18:12.31,Dial-JP,,0,0,0,,Ол өте жақсы бала еді.
Dialogue: 0,0:18:12.88,0:18:14.64,Dial-JP,,0,0,0,,Камуро мырза
Dialogue: 0,0:18:15.72,0:18:19.85,Dial-JP,,0,0,0,,Миконың өмірін сақтап қалғаныңыз үшін рахмет.
Dialogue: 0,0:18:31.56,0:18:32.96,Dial-JP,,0,0,0,,Ол жоғалды.
Dialogue: 0,0:18:34.08,0:18:35.83,Dial-JP,,0,0,0,,Жоқ, бәрібір
Dialogue: 0,0:18:36.37,0:18:37.41,Dial-JP,,0,0,0,,Не?
Dialogue: 0,0:18:37.41,0:18:39.00,Dial-JP,,0,0,0,,Махоро керемет
Dialogue: 0,0:18:39.00,0:18:40.31,Dial-JP,,0,0,0,,Маған қатты әсер етті.
Dialogue: 0,0:18:41.61,0:18:43.23,Dial-JP,,0,0,0,,Бұл басқаша.
Dialogue: 0,0:18:43.53,0:18:45.69,Dial-JP,,0,0,0,,Жарайсың, бұрынғы актер бала
Dialogue: 0,0:18:47.48,0:18:49.56,Dial-JP,,0,0,0,,Жоқ, солай.
Dialogue: 0,0:18:49.81,0:18:52.27,Dial-JP,,0,0,0,,Мен мұны кездейсоқ жасадым.
Dialogue: 0,0:18:52.92,0:18:56.84,Dial-JP,,0,0,0,,Дауыстық актер ретінде әлі бастапқы сызыққа жеткен жоқпын.
Dialogue: 0,0:19:01.51,0:19:05.35,Dial-JP,,0,0,0,,Жоқ, бұл керемет болды. Махороның сол күнгі өнері керемет болды.
Dialogue: 0,0:19:05.35,0:19:08.49,Dial-JP,,0,0,0,,Сіз осылай жалғыз қалғаныңыз жақсы дедіңіз.
Dialogue: 0,0:19:09.07,0:19:10.25,Dial-JP,,0,0,0,,Ой...
Dialogue: 0,0:19:10.25,0:19:13.16,Dial-JP,,0,0,0,,Мен жалғызбын деп отырғаным жоқ.
Dialogue: 0,0:19:13.16,0:19:15.01,Dial-JP,,0,0,0,,Міне, сондықтан
Dialogue: 0,0:19:15.39,0:19:18.25,Dial-JP,,0,0,0,,Ая да бір сынақтан өтті.
Dialogue: 0,0:19:19.65,0:19:20.75,Dial-JP,,0,0,0,,Ми-чан
Dialogue: 0,0:19:20.97,0:19:23.65,Dial-JP,,0,0,0,,Мен әлі қалпына келген жоқпын.
Dialogue: 0,0:19:23.81,0:19:24.69,Dial-JP,,0,0,0,,Ая
Dialogue: 0,0:19:25.24,0:19:29.43,Dial-JP,,0,0,0,,Мен мысықты мақтанышпен иелене алатын дауыс актері болуды мақсат еткім келеді.
Dialogue: 0,0:19:30.91,0:19:32.40,Dial-JP,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:19:32.83,0:19:35.60,Dial-JP,,0,0,0,,Ол бала бақытты болса, жақсы.
Dialogue: 0,0:19:35.85,0:19:36.87,Dial-JP,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:37.87,0:19:39.13,Dial-JP,,0,0,0,,Мен бұған да сенімдімін
Dialogue: 0,0:19:39.13,0:19:41.93,Dial-JP,,0,0,0,,Бұл бізге қажет болды.
Dialogue: 0,0:19:42.13,0:19:43.07,Dial-JP,,0,0,0,,Оны өз бетінше қалдыр
Dialogue: 0,0:19:45.16,0:19:46.29,Dial-JP,,0,0,0,,Оны өз бетінше қалдыр
Dialogue: 0,0:19:46.53,0:19:50.03,Dial-JP,,0,0,0,,Сіз дәл қазір қолыңыздан келгеннің бәрін сынап көргіңіз келеді, солай ма?
Dialogue: 0,0:19:50.32,0:19:51.25,Dial-JP,,0,0,0,,4 адам
Dialogue: 0,0:19:51.67,0:19:53.01,Dial-JP,,0,0,0,,Айтпақшы, Михару
Dialogue: 0,0:19:53.01,0:19:55.85,Dial-JP,,0,0,0,,Төртеуің бірігіп бірдеңе жасағыларың келетінін жоғарыда айттыңдар.
Dialogue: 0,0:19:56.16,0:19:58.39,Dial-JP,,0,0,0,,Төртеуміз
Dialogue: 0,0:19:59.01,0:20:01.16,Dial-JP,,0,0,0,,Өйткені Махоро мұны жалғыз жасағысы келеді
Dialogue: 0,0:20:01.53,0:20:04.09,Dial-JP,,0,0,0,,Жоқ, бірге жасайық, Махоро.
Dialogue: 0,0:20:04.09,0:20:04.85,Dial-JP,,0,0,0,,Ая
Dialogue: 0,0:20:05.25,0:20:08.06,Dial-JP,,0,0,0,,Төртеуміз бірдеңе істей алатынымызға сенімдімін.
Dialogue: 0,0:20:09.51,0:20:10.23,Dial-JP,,0,0,0,,Ая
Dialogue: 0,0:20:10.85,0:20:12.85,Dial-JP,,0,0,0,,Мен радиомен айналысқым келеді
Dialogue: 0,0:20:13.56,0:20:14.52,Dial-JP,,0,0,0,,Радио?
Dialogue: 0,0:20:15.91,0:20:19.53,Dial-JP,,0,0,0,,Толық емес жұмыс уақытында радионы жиі тыңдаймын.
Dialogue: 0,0:20:19.93,0:20:23.63,Dial-JP,,0,0,0,,Маған әсіресе дауыс берушілер ойнайтын радио ұнады.
Dialogue: 0,0:20:23.95,0:20:25.61,Dial-JP,,0,0,0,,Бірақ мұндай нәрсе
Dialogue: 0,0:20:25.61,0:20:28.43,Dial-JP,,0,0,0,,Бұл радиостанция сізден сұрайтын нәрсе.
Dialogue: 0,0:20:28.43,0:20:30.49,Dial-JP,,0,0,0,,Бұл күндердің бәрі емес
Dialogue: 0,0:20:30.81,0:20:34.76,Dial-JP,,0,0,0,,Радиоға келетін болсақ, веб-радио сияқты тәуелсіз тарату қызметтері де бар.
Dialogue: 0,0:20:34.95,0:20:37.97,Dial-JP,,0,0,0,,Сонымен, біз мұны өз бетімізше жасай аламыз.
Dialogue: 0,0:20:38.27,0:20:42.06,Dial-JP,,0,0,0,,Олай болса, Ми Чан мен иесіне жетеді ме екен?
Dialogue: 0,0:20:44.81,0:20:45.87,Dial-JP,,0,0,0,,Жақсы.
Dialogue: 0,0:20:46.41,0:20:47.55,Dial-JP,,0,0,0,,Көріп көрейік
Dialogue: 0,0:20:50.65,0:20:52.29,Dial-JP,,0,0,0,,Осылайша біз
Dialogue: 0,0:20:52.57,0:20:54.73,Dial-JP,,0,0,0,,Кеңсеге жоспарлау арқылы
Dialogue: 0,0:20:54.73,0:20:56.72,Dial-JP,,0,0,0,,Веб-радио түрінде
Dialogue: 0,0:20:56.72,0:20:59.67,Dial-JP,,0,0,0,,Мен кішкене қадам жасауды шештім.
Dialogue: 0,0:21:00.01,0:21:03.33,Dial-JP,,0,0,0,,Сондықтан түсіністігіңізді бағалаймын.
Dialogue: 0,0:21:04.64,0:21:06.88,Dial-JP,,0,0,0,,Махоро сен
Dialogue: 0,0:21:06.88,0:21:09.83,Dial-JP,,0,0,0,,Рико-чан, сен неге күлесің?
Dialogue: 0,0:21:10.29,0:21:14.27,Dial-JP,,0,0,0,,Тыңдаушылар, SNS желісіндегі Mahoro-ға жазылыңыз.
Dialogue: 0,0:21:14.48,0:21:15.71,Dial-JP,,0,0,0,,Тек мен бе?
Dialogue: 0,0:21:15.93,0:21:17.08,Dial-JP,,0,0,0,,Ми-чан…
Dialogue: 0,0:21:17.29,0:21:19.45,Dial-JP,,0,0,0,,Мен әлі қалпына келген жоқпын.
Dialogue: 0,0:21:19.45,0:21:20.49,Dial-JP,,0,0,0,,Әзіл
Dialogue: 0,0:21:21.72,0:21:22.84,Dial-JP,,0,0,0,,Мұнда
Dialogue: 0,0:21:22.84,0:21:24.04,Dial-JP,,0,0,0,,Мұны істеуді доғарыңыз.
Dialogue: 0,0:21:24.04,0:21:26.47,Dial-JP,,0,0,0,,бізді мазақ етті
Dialogue: 0,0:21:26.47,0:21:27.28,Dial-JP,,0,0,0,,Кейде
Dialogue: 0,0:21:27.28,0:21:28.81,Dial-JP,,0,0,0,,Мен уайымдадым.
Dialogue: 0,0:21:28.81,0:21:30.56,Dial-JP,,0,0,0,,Ая қалжыңдап тұр.
Dialogue: 0,0:21:33.27,0:21:35.07,Dial-JP,,0,0,0,,Бұл қызықты уақыт болды.
Dialogue: 0,0:21:35.07,0:21:37.88,Dial-JP,,0,0,0,,Соңы тез келді
Dialogue: 0,0:21:38.13,0:21:42.45,Dial-JP,,0,0,0,,Тыңдағандардың бәрі де көңілді болды деп үміттенемін.
Dialogue: 0,0:21:42.77,0:21:47.41,Dial-JP,,0,0,0,,Келесі радиохабарымызды да тыңдасаңыз, қуанар едім.
Dialogue: 0,0:21:47.76,0:21:51.96,Dial-JP,,0,0,0,,Аспанда билеген шар біреуден біреуге өтеді.
Dialogue: 0,0:21:52.48,0:21:56.42,Dial-JP,,0,0,0,,Бір-бірінің естеліктері мен жүректерін байланыстыратын байланысқа айналсын.
Dialogue: 0,0:21:56.56,0:22:01.13,Dial-JP,,0,0,0,,Бұл радио сіз бен біздің арамыздағы байланысқа айналсын.
Dialogue: 0,0:22:01.45,0:22:02.59,Dial-JP,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:22:02.59,0:22:03.83,Dial-JP,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:22:03.83,0:22:04.93,Dial-JP,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,0:22:05.73,0:22:07.73,Dial-JP,,0,0,0,,Қайта кездескенше
Dialogue: 0,0:23:57.21,0:23:59.73,Dial-JP,,0,0,0,,Келесі жолы «Ай мен Күн»
Dialogue: 0,0:03:27.27,0:03:33.03,OP-JP,,0,0,0,,Қатты жылауымның себебі күштірек болғым келді.
Dialogue: 0,0:03:33.03,0:03:38.41,OP-JP,,0,0,0,,Мен кенеттен естіген дауыс сондай нәзік болды.
Dialogue: 0,0:03:38.41,0:03:43.70,OP-JP,,0,0,0,,Жел қанша қатты соқса да, Мен шайқалмаймын, жеңілмеймін.
Dialogue: 0,0:03:43.70,0:03:49.50,OP-JP,,0,0,0,,Сенуге күш берген сенің дауысың еді.
Dialogue: 0,0:03:49.50,0:03:54.76,OP-JP,,0,0,0,,Мен қараған түн өте әдемі болды
Dialogue: 0,0:03:54.76,0:04:00.05,OP-JP,,0,0,0,,Маған жалғыз емес екенімді айтты
Dialogue: 0,0:04:00.35,0:04:05.43,OP-JP,,0,0,0,,Өйткені биік тұрған ай мейірімді
Dialogue: 0,0:04:05.43,0:04:07.94,OP-JP,,0,0,0,,Мен қаншалықты алыс болса да сенімдімін
Dialogue: 0,0:04:07.94,0:04:10.77,OP-JP,,0,0,0,,Қол созсаң мәңгілік
Dialogue: 0,0:04:10.77,0:04:17.03,OP-JP,,0,0,0,,Сіз кез келген жерге ұша аласыз
Dialogue: 0,0:04:17.78,0:04:23.12,OP-JP,,0,0,0,,Қазір басталады, бұл бастапқы жол
Dialogue: 0,0:04:23.12,0:04:28.12,OP-JP,,0,0,0,,Мұнда өзіңізге сеніңіз
Dialogue: 0,0:04:28.12,0:04:34.55,OP-JP,,0,0,0,,Шын жүректі ести аласыз
Dialogue: 0,0:04:34.55,0:04:37.26,OP-JP,,0,0,0,,Мен саған әрқашан сенемін
Dialogue: 0,0:04:37.26,0:04:39.93,OP-JP,,0,0,0,,Ол дауыс әрқашан бар
Dialogue: 0,0:04:39.93,0:04:44.22,OP-JP,,0,0,0,,Мен сенің арқаңды аламын
Dialogue: 1,0:22:31.58,0:22:35.04,ED2-JP,,0,0,0,,Мен әрқашан ертеңге сенемін
Dialogue: 1,0:22:42.59,0:22:45.97,ED2-JP,,0,0,0,,Көзіңнің түбінде бейнеленген арман
Dialogue: 1,0:22:45.97,0:22:49.35,ED2-JP,,0,0,0,,Маған алға жылжуыма себеп болды
Dialogue: 1,0:22:49.35,0:22:54.65,ED2-JP,,0,0,0,,Бұл қолдың көптеген мағынасы бар
Dialogue: 1,0:22:55.10,0:22:58.65,ED2-JP,,0,0,0,,Ұмытып кете жаздадым, Байқамадым байлауды
Dialogue: 1,0:22:58.65,0:23:02.15,ED2-JP,,0,0,0,,Мен жүрген көрініс бұлыңғыр болып, жоғалып кетеді.
Dialogue: 1,0:23:02.15,0:23:04.11,ED2-JP,,0,0,0,,Сіз оны көрмейінше
Dialogue: 1,0:23:04.11,0:23:08.37,ED2-JP,,0,0,0,,Қанша лас болса да
Dialogue: 1,0:23:08.37,0:23:14.12,ED2-JP,,0,0,0,,Түсімде мен бәрін ойыншық қорапшаға салып қойдым
Dialogue: 1,0:23:14.12,0:23:17.13,ED2-JP,,0,0,0,,Сөзде емес, формада емес
Dialogue: 1,0:23:17.13,0:23:20.88,ED2-JP,,0,0,0,,Өйткені сен тек осындасың
Dialogue: 1,0:23:20.88,0:23:25.89,ED2-JP,,0,0,0,,Бастапқы қоңыраудың дыбысы
Dialogue: 1,0:23:25.89,0:23:30.01,ED2-JP,,0,0,0,,Жаңғырған аспан, бұлттарды итеріп, қарашы
Dialogue: 1,0:23:30.01,0:23:33.56,ED2-JP,,0,0,0,,Дүниені қоршау
Dialogue: 1,0:23:33.56,0:23:38.82,ED2-JP,,0,0,0,,Алға қадам жасау үшін батылдықты қабылдаңыз
Dialogue: 1,0:23:38.82,0:23:41.19,ED2-JP,,0,0,0,,Ол қазір келді
Dialogue: 1,0:23:41.19,0:23:46.07,ED2-JP,,0,0,0,,Бұл ғажайып сенің көзіңе көрінді
Dialogue: 1,0:23:46.07,0:23:51.08,ED2-JP,,0,0,0,,Түстің басталуының белгісі естіледі
