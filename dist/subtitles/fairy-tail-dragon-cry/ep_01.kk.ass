Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:40.95,0:00:45.96,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:00:52.01,0:00:56.13,Default,,0,0,0,,(Игнилдің тынысы)
Dialogue: 0,0:01:01.18,0:01:02.14,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:01:02.35,0:01:03.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:06.39,0:01:08.90,Default,,0,0,0,,Хмм... Хахахахаха...
Dialogue: 0,0:01:10.23,0:01:12.15,Default,,0,0,0,,Ннн…
Dialogue: 0,0:01:12.32,0:01:15.61,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:01:15.74,0:01:18.28,Default,,0,0,0,,(түртіп алған дыбыс)
Dialogue: 0,0:01:20.41,0:01:21.95,Default,,0,0,0,,Хмм... Иә?
Dialogue: 0,0:01:22.08,0:01:25.87,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:01:28.83,0:01:30.29,Default,,0,0,0,,Ха…
Dialogue: 0,0:01:30.42,0:01:32.67,Default,,0,0,0,,Уау! Хаха...
Dialogue: 0,0:01:34.46,0:01:38.18,Default,,0,0,0,,Ннн… фуфуфуфу…
Dialogue: 0,0:01:38.43,0:01:39.93,Default,,0,0,0,,Ах! Хмм...
Dialogue: 0,0:01:40.10,0:01:41.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:50.36,0:01:56.69,Default,,0,0,0,,Мен саған да беремін, Тору.
Dialogue: 0,0:02:21.43,0:02:23.14,Default,,0,0,0,,Не? Ооо...
Dialogue: 0,0:02:23.26,0:02:25.27,Default,,0,0,0,,Ннн… ааа…
Dialogue: 0,0:02:25.77,0:02:28.10,Default,,0,0,0,,Қайда? Мұнда!
Dialogue: 0,0:02:28.27,0:02:30.15,Default,,0,0,0,,А... Иә?
Dialogue: 0,0:02:30.27,0:02:32.11,Default,,0,0,0,,Ннн... Ааа!
Dialogue: 0,0:02:32.27,0:02:35.40,Default,,0,0,0,,Ух... аааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:02:35.53,0:02:36.53,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:02:37.07,0:02:38.99,Default,,0,0,0,,Иә? Апыр-ай!
Dialogue: 0,0:02:40.28,0:02:41.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:42.12,0:02:45.41,Default,,0,0,0,,Не болып жатыр? Міне осы!
Dialogue: 0,0:02:49.21,0:02:50.83,Default,,0,0,0,,(айқай)
Dialogue: 0,0:02:51.88,0:02:53.42,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:54.50,0:02:57.51,Default,,0,0,0,,Ах! Апыр-ай!
Dialogue: 0,0:02:57.63,0:03:00.43,Default,,0,0,0,,Қат! Мен ешқандай күш ала алмаймын!
Dialogue: 0,0:03:02.80,0:03:03.55,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:03.72,0:03:05.43,Default,,0,0,0,,Міне! Ннн...
Dialogue: 0,0:03:05.89,0:03:08.43,Default,,0,0,0,,Хмм... Аххх...
Dialogue: 0,0:03:08.77,0:03:09.93,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:10.10,0:03:11.35,Default,,0,0,0,,(айқай)
Dialogue: 0,0:03:13.10,0:03:14.44,Default,,0,0,0,,Ннн…
Dialogue: 0,0:03:18.61,0:03:19.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:21.61,0:03:22.45,Default,,0,0,0,,Ннн!
Dialogue: 0,0:03:28.45,0:03:30.08,Default,,0,0,0,,Құс!
Dialogue: 0,0:03:30.21,0:03:32.21,Default,,0,0,0,,(айқай)
Dialogue: 0,0:03:34.13,0:03:35.71,Default,,0,0,0,,(айқай)
Dialogue: 0,0:03:37.59,0:03:38.59,Default,,0,0,0,,(айқай)
Dialogue: 0,0:03:38.71,0:03:39.71,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:03:45.55,0:03:49.72,Default,,0,0,0,,Сен... кіммен төбелесіп жатқаныңды білесің бе?
Dialogue: 0,0:03:49.89,0:03:51.23,Default,,0,0,0,,(айқай)
Dialogue: 0,0:03:51.52,0:03:52.98,Default,,0,0,0,,Мен... (сықырлап)
Dialogue: 0,0:03:53.65,0:03:55.65,Default,,0,0,0,,Ертегі...
Dialogue: 0,0:03:55.77,0:03:58.27,Default,,0,0,0,,Бұл сиқыршы! (соққы дыбысы)
Dialogue: 0,0:04:26.05,0:04:28.55,Default,,0,0,0,,А... сен кімсің! ?
Dialogue: 0,0:04:28.68,0:04:31.52,Default,,0,0,0,,Бұл Фиор патшалығы басқаратын ғибадатхана.
Dialogue: 0,0:04:31.98,0:04:33.39,Default,,0,0,0,,Ешқандай жақындамаңыз!
Dialogue: 0,0:04:33.52,0:04:35.02,Default,,0,0,0,,Тыңдап тұрсың ба? Сіз жігіттер!
Dialogue: 0,0:04:36.02,0:04:39.02,Default,,0,0,0,,Елдің құпиясын қорғайсың ба?
Dialogue: 0,0:04:39.15,0:04:42.28,Default,,0,0,0,,Маған қарашы, сен кішкентай шабақ бола алмайсың, солай ма?
Dialogue: 0,0:04:42.44,0:04:43.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:46.49,0:04:51.95,Default,,0,0,0,,Хм... Фиоренің мақтан тұтатын арнайы күштері Бякко күткендей.
Dialogue: 0,0:04:52.08,0:04:55.92,Default,,0,0,0,,...Ал бұлардың ішінде кім мықты?
Dialogue: 0,0:05:03.46,0:05:04.92,Default,,0,0,0,,Сіз бе?
Dialogue: 0,0:05:05.38,0:05:08.43,Default,,0,0,0,,Сіз Фиорды сатқан Зашсыз ба?
Dialogue: 0,0:05:08.93,0:05:12.77,Default,,0,0,0,,Мен сол ескі әңгімені ұмытып кетіппін.
Dialogue: 0,0:05:12.89,0:05:16.48,Default,,0,0,0,,Бірақ әскердің ішінде сен ең жақсының ең жақсысысың.
Dialogue: 0,0:05:16.60,0:05:21.32,Default,,0,0,0,,Мұндай шалғай жерде жұмыс істеу жақсы емес.
Dialogue: 0,0:05:22.86,0:05:26.40,Default,,0,0,0,,Бірақ одан да қызық емес...
Dialogue: 0,0:05:27.49,0:05:28.20,Default,,0,0,0,,(сигардың тарқаған дыбысы)
Dialogue: 0,0:05:28.78,0:05:29.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:32.20,0:05:36.21,Default,,0,0,0,,Бұл сіздің алдыңызда тұрғанымды білдіреді.
Dialogue: 0,0:05:39.04,0:05:40.21,Default,,0,0,0,,Ха…
Dialogue: 0,0:05:42.71,0:05:44.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:44.13,0:05:44.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:45.17,0:05:46.59,Default,,0,0,0,,Ннн…
Dialogue: 0,0:05:47.26,0:05:48.51,Default,,0,0,0,,Капитан! Не...
Dialogue: 0,0:05:48.63,0:05:49.97,Default,,0,0,0,,Иә! (Эскадрон) Ах!
Dialogue: 0,0:05:51.47,0:05:52.56,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:54.81,0:05:55.98,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:56.14,0:05:57.48,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:05:58.06,0:05:58.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:58.94,0:05:59.94,Default,,0,0,0,,Ннн…
Dialogue: 0,0:06:00.06,0:06:00.73,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:01.06,0:06:02.23,Default,,0,0,0,,Ннн!
Dialogue: 0,0:06:02.82,0:06:03.48,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:03.61,0:06:04.48,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:06.19,0:06:08.99,Default,,0,0,0,,Неге... достар арасында...
Dialogue: 0,0:06:09.20,0:06:10.49,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:15.58,0:06:16.66,Default,,0,0,0,,Мм! (тарсылдаған дыбыс)
Dialogue: 0,0:06:17.87,0:06:19.17,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:19.67,0:06:22.50,Default,,0,0,0,,(шу)
Dialogue: 0,0:06:25.30,0:06:27.01,Default,,0,0,0,,Уф! Уф!
Dialogue: 0,0:06:27.17,0:06:28.51,Default,,0,0,0,,Аа... нх...
Dialogue: 0,0:06:29.26,0:06:30.34,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:30.55,0:06:32.76,Default,,0,0,0,,Ах…
Dialogue: 0,0:06:34.39,0:06:36.35,Default,,0,0,0,,Егер сіз адамдарды манипуляциялай алсаңыз...
Dialogue: 0,0:06:36.47,0:06:39.27,Default,,0,0,0,,Олардың бір-бірін өлтіруіне жол бермесек жақсы болар еді.
Dialogue: 0,0:06:39.39,0:06:41.02,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:06:41.48,0:06:45.32,Default,,0,0,0,,Достар бір-бірімен жақсы араласатын адамдар.
Dialogue: 0,0:06:46.19,0:06:51.03,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:06:51.57,0:06:52.99,Default,,0,0,0,,Құрметті Соня
Dialogue: 0,0:06:53.12,0:06:56.08,Default,,0,0,0,,Таяқшаның орнын тауып бере аласыз ба?
Dialogue: 0,0:06:57.91,0:07:01.92,Default,,0,0,0,,Жаныңыздың айқайын Заш мырза естімей ме?
Dialogue: 0,0:07:02.46,0:07:06.30,Default,,0,0,0,,Ондай нәрсе ішіңді ісінбейді.
Dialogue: 0,0:07:08.76,0:07:13.93,Default,,0,0,0,,(Боранның дыбысы)
Dialogue: 0,0:07:20.73,0:07:25.48,Default,,0,0,0,,Нацу! маған көмектесші!
Dialogue: 0,0:07:26.57,0:07:27.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:27.65,0:07:28.65,Default,,0,0,0,,Уф уф! бір!
Dialogue: 0,0:07:28.78,0:07:31.03,Default,,0,0,0,,Ит... Бұл ит, Нацу.
Dialogue: 0,0:07:31.15,0:07:33.36,Default,,0,0,0,,Мен саған қарап тұрмын...
Dialogue: 0,0:07:34.66,0:07:36.49,Default,,0,0,0,,Кун... Кун...
Dialogue: 0,0:07:38.54,0:07:39.75,Default,,0,0,0,,Кун...
Dialogue: 0,0:07:42.46,0:07:43.12,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:43.29,0:07:45.04,Default,,0,0,0,,Оның күші одан сайын артып барады.
Dialogue: 0,0:07:45.17,0:07:47.88,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:48.25,0:07:50.84,Default,,0,0,0,,Хаха... Рахмет саған Нацу
Dialogue: 0,0:07:50.97,0:07:53.09,Default,,0,0,0,,Бұл маңызды емес. (Қол ұстасып жатқан дыбыс)
Dialogue: 0,0:07:53.22,0:07:55.09,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:07:55.22,0:07:56.47,Default,,0,0,0,,Ой, жоқ!
Dialogue: 0,0:07:56.60,0:07:59.81,Default,,0,0,0,,Мен сенбеймін! Мына сүйкімді күшікті мазақ етіңіз
Dialogue: 0,0:07:59.97,0:08:03.19,Default,,0,0,0,,Мен сені қорлаған жоқпын, мен саған қарап тұрдым.
Dialogue: 0,0:08:03.31,0:08:04.73,Default,,0,0,0,,күрсіну...
Dialogue: 0,0:08:05.19,0:08:07.57,Default,,0,0,0,,Хаппи иттерді жек көрді ме?
Dialogue: 0,0:08:07.98,0:08:10.32,Default,,0,0,0,,Өйткені, Прю де ит.
Dialogue: 0,0:08:10.86,0:08:12.24,Default,,0,0,0,,Пунпун
Dialogue: 0,0:08:12.36,0:08:15.07,Default,,0,0,0,,Өйткені, қарашы, итке ұқсамайды.
Dialogue: 0,0:08:15.24,0:08:17.83,Default,,0,0,0,,Маған бұл не деген қызық. Бұл жәндіктер тұқымдасының мүшесі ме?
Dialogue: 0,0:08:17.95,0:08:19.04,Default,,0,0,0,,Пун
Dialogue: 0,0:08:19.16,0:08:22.33,Default,,0,0,0,,Балық болса, дәмді... сүйкімді, солай емес пе?
Dialogue: 0,0:08:22.46,0:08:23.83,Default,,0,0,0,,Пру — аспан рухы!
Dialogue: 0,0:08:24.37,0:08:27.75,Default,,0,0,0,,...Қалай қарасаң да ит емес.
Dialogue: 0,0:08:27.88,0:08:29.09,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:08:30.92,0:08:31.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:33.34,0:08:35.09,Default,,0,0,0,,Не?
Dialogue: 0,0:08:37.35,0:08:39.60,Default,,0,0,0,,Күте тұрыңыз... жақын.
Dialogue: 0,0:08:40.22,0:08:42.27,Default,,0,0,0,,Мен неге ұқсаймын?
Dialogue: 0,0:08:42.39,0:08:45.10,Default,,0,0,0,,Хмм... Бұл Нацу болуы керек.
Dialogue: 0,0:08:46.52,0:08:50.27,Default,,0,0,0,,Ах... Нацу-сан! Люси...
Dialogue: 0,0:08:51.73,0:08:53.44,Default,,0,0,0,,О... Менің ойымша, бұл ыңғайсыздық болды.
Dialogue: 0,0:08:53.57,0:08:55.74,Default,,0,0,0,,Жоқ... жоқ, Венди!
Dialogue: 0,0:08:55.95,0:08:59.20,Default,,0,0,0,,Тыңдашы, Чарльз, бұрын қорқынышты ит болған...
Dialogue: 0,0:08:59.33,0:09:00.24,Default,,0,0,0,,Ахсо
Dialogue: 0,0:09:01.20,0:09:03.75,Default,,0,0,0,,Мұздағы макияж...
Dialogue: 0,0:09:04.87,0:09:05.96,Default,,0,0,0,,Дөңгелектер
Dialogue: 0,0:09:07.79,0:09:10.00,Default,,0,0,0,,Ол патша астанасына дейін жетеді.
Dialogue: 0,0:09:10.46,0:09:14.76,Default,,0,0,0,,Бұл жеткілікті. Мұз сиқыршысы күткендей, Грей.
Dialogue: 0,0:09:15.34,0:09:16.26,Default,,0,0,0,,Фу…
Dialogue: 0,0:09:18.68,0:09:23.06,Default,,0,0,0,,Корольдік капитал, бұл көп уақыт болды, иә?
Dialogue: 0,0:09:23.68,0:09:28.52,Default,,0,0,0,,Ух... мен...
Dialogue: 0,0:09:28.94,0:09:33.57,Default,,0,0,0,,Бос уақытың болса оқы. Болашақта ғылым маңызды болады.
Dialogue: 0,0:09:33.69,0:09:36.15,Default,,0,0,0,,Не? Гаджил-кун, сен оқисың ба?
Dialogue: 0,0:09:36.65,0:09:38.95,Default,,0,0,0,,Мысық энциклопедиясын қарап отырып не айтып тұрсың?
Dialogue: 0,0:09:39.07,0:09:41.16,Default,,0,0,0,,Бұл да жақсы зерттеу.
Dialogue: 0,0:09:41.62,0:09:43.04,Default,,0,0,0,,Ннн…
Dialogue: 0,0:09:43.16,0:09:46.16,Default,,0,0,0,,А-а... Қазір Грей-сама...
Dialogue: 0,0:09:47.25,0:09:49.17,Default,,0,0,0,,Иә хмм... мммм...
Dialogue: 0,0:09:49.29,0:09:51.75,Default,,0,0,0,,Бұл дәмді Люси...
Dialogue: 0,0:09:51.88,0:09:53.75,Default,,0,0,0,,Менің арқамды жууға бола ма?
Dialogue: 0,0:09:53.88,0:09:56.34,Default,,0,0,0,,Сондай-ақ бұрын? Уууу...
Dialogue: 0,0:09:56.47,0:09:57.13,Default,,0,0,0,,Оның күші одан сайын артып барады.
Dialogue: 0,0:09:57.26,0:09:59.18,Default,,0,0,0,,Бесік жырын айтыңызшы
Dialogue: 0,0:09:59.30,0:10:01.30,Default,,0,0,0,,Бұзылған брат, ааа!
Dialogue: 0,0:10:01.60,0:10:03.06,Default,,0,0,0,,Шулы! Уф!
Dialogue: 0,0:10:04.06,0:10:05.93,Default,,0,0,0,,Сәлем Гаджил, иә?
Dialogue: 0,0:10:06.52,0:10:10.94,Default,,0,0,0,,Жұмысқа барғыңыз келе ме? Бұл біраз алыс, бірақ сыйлығы жақсы.
Dialogue: 0,0:10:11.23,0:10:13.11,Default,,0,0,0,,Хан! Мен де баруым керек!
Dialogue: 0,0:10:13.23,0:10:15.07,Default,,0,0,0,,Бүгін қойманы жинаңыз.
Dialogue: 0,0:10:15.19,0:10:16.44,Default,,0,0,0,,Кәдесый үшін рахмет!
Dialogue: 0,0:10:16.90,0:10:18.20,Default,,0,0,0,,Ювия да барады!
Dialogue: 0,0:10:19.20,0:10:21.41,Default,,0,0,0,,Егер бұл орын алса, мен Грей-самаға бар күшімді саламын...
Dialogue: 0,0:10:21.53,0:10:23.91,Default,,0,0,0,,Ашуыңа жол беремін.
Dialogue: 0,0:10:24.62,0:10:29.96,Default,,0,0,0,,Гаджил-кун, сенің салқын және қатты кеудең керемет!
Dialogue: 0,0:10:30.08,0:10:32.08,Default,,0,0,0,,Ал, бұл темір.
Dialogue: 0,0:10:32.92,0:10:35.96,Default,,0,0,0,,Лилия тұлыпқа ұқсайды!
Dialogue: 0,0:10:36.09,0:10:38.76,Default,,0,0,0,,Жүр... күйіп кетесің.
Dialogue: 0,0:10:39.51,0:10:43.26,Default,,0,0,0,,Леви-сан кішкентай және сүйкімді
Dialogue: 0,0:10:43.39,0:10:45.51,Default,,0,0,0,,Жоқ, Ювия...
Dialogue: 0,0:10:46.77,0:10:49.64,Default,,0,0,0,,Ух... Мен алмаймын...
Dialogue: 0,0:10:49.77,0:10:51.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:56.73,0:10:58.24,Default,,0,0,0,,Айдаһардың моласы
Dialogue: 0,0:10:59.24,0:11:03.03,Default,,0,0,0,,Менің ойымша, кейбір адамдар оны Ұлы сиқырлы шайқас демонстрациясында көрді...
Dialogue: 0,0:11:03.16,0:11:08.00,Default,,0,0,0,,Аренаның астында көне кильдер жатқан жер бар.
Dialogue: 0,0:11:08.58,0:11:12.50,Default,,0,0,0,,Бір кездері қара айдаһар Акнологияға қарсы соғысқан.
Dialogue: 0,0:11:12.63,0:11:16.30,Default,,0,0,0,,Жеңілген айдаһарлардың соңғы демалатын орны
Dialogue: 0,0:11:16.84,0:11:20.01,Default,,0,0,0,,Менің ата-бабаларым көптеген зерттеулер жүргізген...
Dialogue: 0,0:11:20.13,0:11:24.01,Default,,0,0,0,,Ақырында жандардың тыныштығы үшін арена салынды.
Dialogue: 0,0:11:24.60,0:11:29.77,Default,,0,0,0,,Осыдан 100 жылдай бұрын айдаһар қабірінен таяқ табылған.
Dialogue: 0,0:11:30.14,0:11:31.06,Default,,0,0,0,,Таяқ?
Dialogue: 0,0:11:31.19,0:11:32.52,Default,,0,0,0,,Атамның айдаһары...
Dialogue: 0,0:11:32.65,0:11:34.27,Default,,0,0,0,,Сіз оны қолдандыңыз ба?
Dialogue: 0,0:11:34.56,0:11:37.23,Default,,0,0,0,,Жоқ, бұл адам.
Dialogue: 0,0:11:38.07,0:11:39.40,Default,,0,0,0,,Бұл таяқ -
Dialogue: 0,0:11:39.53,0:11:44.45,Default,,0,0,0,,Айдаһарлардың ашуы мен мұңын бойына сіңіру арқылы жинақталған қуатпен...
Dialogue: 0,0:11:44.57,0:11:48.20,Default,,0,0,0,,Оның күшті болғаны сонша, оның бастапқы пішіні бұзылған.
Dialogue: 0,0:11:48.66,0:11:52.46,Default,,0,0,0,,Бұл таяқтың аты «Айдаһардың көз жасы»
Dialogue: 0,0:11:52.58,0:11:56.46,Default,,0,0,0,,Елді жоюға күші жететін таяқ.
Dialogue: 0,0:11:57.17,0:12:01.92,Default,,0,0,0,,Бірнеше күн бұрын бұл қызметкер Фиор патшалығының бұрынғы вице-министрі болған.
Dialogue: 0,0:12:02.05,0:12:04.68,Default,,0,0,0,,Заш Кейн ұрлаған
Dialogue: 0,0:12:05.01,0:12:08.18,Default,,0,0,0,,Заш қара магияға сенеді.
Dialogue: 0,0:12:08.31,0:12:11.48,Default,,0,0,0,,Корольдік отбасын жасырын басып алуға тырысты, бірақ сәтсіздікке ұшырады
Dialogue: 0,0:12:11.60,0:12:17.15,Default,,0,0,0,,Әскерилердің қолына түсер алдында қарамағындағылардың көмегімен елден қашып кеткен.
Dialogue: 0,0:12:17.48,0:12:21.74,Default,,0,0,0,,Алайда, Стелла патшалығынан баспана берілгенде...
Dialogue: 0,0:12:21.86,0:12:23.82,Default,,0,0,0,,Стеллаға сыйлық...
Dialogue: 0,0:12:25.03,0:12:28.83,Default,,0,0,0,,Қол астындағылардың барлығын қырды.
Dialogue: 0,0:12:28.95,0:12:33.04,Default,,0,0,0,,Не? Сен досыңды өлтірдің бе?
Dialogue: 0,0:12:33.16,0:12:36.21,Default,,0,0,0,,Қателескеннен кейін, өзінің күшті шеберлігімен және ақылымен...
Dialogue: 0,0:12:36.33,0:12:39.55,Default,,0,0,0,,Ол Стелланың мемлекеттік министрі болды.
Dialogue: 0,0:12:39.67,0:12:41.21,Default,,0,0,0,,Қандай керемет адам.
Dialogue: 0,0:12:41.59,0:12:47.22,Default,,0,0,0,,Хм... Осындай қауіпті адамның қолына қауіпті таяқ түсіпті.
Dialogue: 0,0:12:47.89,0:12:51.27,Default,,0,0,0,,Мен оны дұрыс пайдаланбай тұрып қайтарғым келеді.
Dialogue: 0,0:12:51.39,0:12:52.48,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:12:52.68,0:12:55.52,Default,,0,0,0,,Эй, Стелла патшалығы қайда?
Dialogue: 0,0:12:55.64,0:12:57.98,Default,,0,0,0,,Шынайы Ишғардың оңтүстік-шығысында
Dialogue: 0,0:12:58.11,0:13:02.99,Default,,0,0,0,,Бұл сыртқы әлемнен мүлдем оқшауланған, тік жартастармен қоршалған арал...
Dialogue: 0,0:13:03.11,0:13:04.45,Default,,0,0,0,,Ши... аралы?
Dialogue: 0,0:13:04.57,0:13:06.99,Default,,0,0,0,,Хехе... Қайықпен барасыз ба?
Dialogue: 0,0:13:11.29,0:13:13.12,Default,,0,0,0,,(айқай)
Dialogue: 0,0:13:16.83,0:13:17.75,Default,,0,0,0,,(айқай)
Dialogue: 0,0:13:26.34,0:13:30.93,Default,,0,0,0,,Стелланы қолдайтын нәрсе алмаздан да қатты минерал.
Dialogue: 0,0:13:31.06,0:13:32.47,Default,,0,0,0,,Стелланиум
Dialogue: 0,0:13:33.14,0:13:37.69,Default,,0,0,0,,Жұлдыздардың жарығын жұту арқылы жарықтығы артады дейді.
Dialogue: 0,0:13:37.81,0:13:40.52,Default,,0,0,0,,Ху (Люси) Бұл романтикалық.
Dialogue: 0,0:13:41.65,0:13:43.69,Default,,0,0,0,,Стелла континенттегі ең жақсысы.
Dialogue: 0,0:13:43.82,0:13:46.03,Default,,0,0,0,,Жұлдызды аспан әдемі көрінеді.
Dialogue: 0,0:13:46.15,0:13:48.53,Default,,0,0,0,,Теңіз де өте әдемі көрінеді.
Dialogue: 0,0:13:48.99,0:13:51.95,Default,,0,0,0,,Дәмді балықтар көп пе?
Dialogue: 0,0:13:52.08,0:13:54.91,Default,,0,0,0,,А... біз әлі келген жоқпыз ба?
Dialogue: 0,0:13:55.08,0:13:56.04,Default,,0,0,0,,♪ (бар музыкасы)
Dialogue: 0,0:13:56.21,0:13:58.79,Default,,0,0,0,,(Қонақтар қолдайды)
Dialogue: 0,0:14:02.17,0:14:03.80,Default,,0,0,0,,Хехе... (қол шапалақтау және қошемет көрсету)
Dialogue: 0,0:14:03.96,0:14:06.38,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:14:06.51,0:14:08.80,Default,,0,0,0,,Мен мұны не үшін істеп жатырмын?
Dialogue: 0,0:14:09.51,0:14:11.85,Default,,0,0,0,,Шағымдама, ол саған жарасады.
Dialogue: 0,0:14:11.97,0:14:13.81,Default,,0,0,0,,Ах... Ннн...
Dialogue: 0,0:14:14.22,0:14:18.81,Default,,0,0,0,,Заш қамал мұнарасында әртүрлі ұрланған заттарды сақтайды.
Dialogue: 0,0:14:19.19,0:14:22.27,Default,,0,0,0,,Сол қойманың кілті - оның сақинасы.
Dialogue: 0,0:14:22.40,0:14:25.57,Default,,0,0,0,,Қанша жаман болса да, бір елдің министрі.
Dialogue: 0,0:14:26.07,0:14:29.32,Default,,0,0,0,,Оны күшпен алу халықаралық проблемаға әкелуі мүмкін
Dialogue: 0,0:14:30.32,0:14:34.58,Default,,0,0,0,,Сондықтан мен ол жиі баратын бардан сақина ұрлап аламын.
Dialogue: 0,0:14:34.95,0:14:36.70,Default,,0,0,0,,Байқамай
Dialogue: 0,0:14:36.91,0:14:39.21,Default,,0,0,0,,Люси, назарымды аударыңыз.
Dialogue: 0,0:14:39.67,0:14:40.33,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:14:41.08,0:14:42.96,Default,,0,0,0,,Operation begins
Dialogue: 0,0:14:43.63,0:14:46.09,Default,,0,0,0,,♪ (music)
Dialogue: 0,0:14:46.26,0:14:48.59,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:14:50.76,0:14:57.60,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:15:01.77,0:15:02.86,Default,,0,0,0,,Хахаха…
Dialogue: 0,0:15:11.20,0:15:12.20,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:15:12.78,0:15:13.62,Default,,0,0,0,,Gemini
Dialogue: 0,0:15:14.41,0:15:15.12,Default,,0,0,0,,О!
Dialogue: 0,0:15:17.91,0:15:20.92,Default,,0,0,0,,Nnnn... oh!
Dialogue: 0,0:15:23.17,0:15:24.59,Default,,0,0,0,,О...
Dialogue: 0,0:15:26.96,0:15:27.96,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:15:29.05,0:15:31.13,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:15:37.51,0:15:39.64,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:15:46.86,0:15:50.65,Default,,0,0,0,,Көшірме сұрауға 1 секунд жеткілікті
Dialogue: 0,0:15:55.70,0:15:57.41,Default,,0,0,0,,Huh... yeah
Dialogue: 0,0:15:58.08,0:15:59.33,Default,,0,0,0,,Қайтару
Dialogue: 0,0:16:01.58,0:16:02.54,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:16:02.67,0:16:04.04,Default,,0,0,0,,Happy Charles
Dialogue: 0,0:16:05.08,0:16:07.67,Default,,0,0,0,,Сіз мұны Нацу мен Вэндиге жеткізесіз бе?
Dialogue: 0,0:16:07.80,0:16:09.17,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:16:09.63,0:16:12.68,Default,,0,0,0,,Кеттік! Мен оны сұрадым
Dialogue: 0,0:16:14.05,0:16:15.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:18.85,0:16:20.39,Default,,0,0,0,,Не болды? лалагүл
Dialogue: 0,0:16:20.52,0:16:23.60,Default,,0,0,0,,Дәл қазір, бір сәт сол жерде Хаппи мен Чарльз болған сияқты...
Dialogue: 0,0:16:23.73,0:16:25.69,Default,,0,0,0,,Осынша алыс аралда ма?
Dialogue: 0,0:16:31.32,0:16:33.95,Default,,0,0,0,,Нацу, сен не істеп жатырсың? Nin!
Dialogue: 0,0:16:35.57,0:16:38.33,Default,,0,0,0,,Мм... Қайдан білдің?
Dialogue: 0,0:16:38.45,0:16:40.45,Default,,0,0,0,,Венди де ашылды.
Dialogue: 0,0:16:41.08,0:16:42.62,Default,,0,0,0,,Эхехе...
Dialogue: 0,0:16:42.75,0:16:45.04,Default,,0,0,0,,Сол үшін айттым, Нацу-сан.
Dialogue: 0,0:16:45.17,0:16:45.96,Default,,0,0,0,,Ннн…
Dialogue: 0,0:16:46.25,0:16:49.96,Default,,0,0,0,,Мен мұнараға дейін барамын. (Бақытты) Көзге түспеңіз.
Dialogue: 0,0:16:50.34,0:16:52.38,Default,,0,0,0,,(Soldier's Yawn)
Dialogue: 0,0:16:53.34,0:16:56.22,Default,,0,0,0,,Күзетші бар, оны маған қалдырыңыз.
Dialogue: 0,0:16:56.97,0:16:57.72,Default,,0,0,0,,Иә! (Soldiers) Ugh!
Dialogue: 0,0:16:58.43,0:17:00.22,Default,,0,0,0,,Асығыңыз! кешіріңіз
Dialogue: 0,0:17:03.02,0:17:03.93,Default,,0,0,0,,(Музика) Ал бұл кім? (Эмма) Кэрол. Оған небәрі бір жаста ғана.
Dialogue: 0,0:17:05.39,0:17:06.52,Default,,0,0,0,,Қостаушылардың көбі Босс жағында—
Dialogue: 0,0:17:07.73,0:17:09.86,Default,,0,0,0,,Тездетіп ізде, иә.
Dialogue: 0,0:17:11.57,0:17:12.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:13.36,0:17:14.36,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:15.86,0:17:16.86,Default,,0,0,0,,Natsu-san?
Dialogue: 0,0:17:16.99,0:17:19.74,Default,,0,0,0,,Мен осы жағынан таңғажайып сиқырлы күшті сезінемін.
Dialogue: 0,0:17:22.54,0:17:23.25,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:58.16,0:17:59.36,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:00.87,0:18:02.53,Default,,0,0,0,,Dragon's Tears
Dialogue: 0,0:18:08.58,0:18:09.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:09.58,0:18:10.58,Default,,0,0,0,,(ұшқын дыбысы)
Dialogue: 0,0:18:12.38,0:18:14.09,Default,,0,0,0,,(ұшқын дыбысы)
Dialogue: 0,0:18:16.92,0:18:18.05,Default,,0,0,0,,Я...
Dialogue: 0,0:18:18.26,0:18:21.18,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:18:21.35,0:18:22.89,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:18:23.01,0:18:24.89,Default,,0,0,0,,Не? Nah... Natsu-san?
Dialogue: 0,0:18:25.02,0:18:25.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:25.85,0:18:28.69,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:18:28.85,0:18:30.81,Default,,0,0,0,,Не? Is this a trap?
Dialogue: 0,0:18:30.94,0:18:33.57,Default,,0,0,0,,Бұл қызметкерлерді алып кеткенде іске қосылатын сиқырлы шеңбер!
Dialogue: 0,0:18:33.77,0:18:36.40,Default,,0,0,0,,Қат! Қанекей жүгірейік! иә!
Dialogue: 0,0:18:38.24,0:18:42.62,Default,,0,0,0,,Enemy found! (Б солдат) Қамалдың қазына бөлмесіне ұрылар басып кірді!
Dialogue: 0,0:18:42.74,0:18:44.58,Default,,0,0,0,,Барлық жеке құрам ұрысқа дайын!
Dialogue: 0,0:18:44.95,0:18:47.79,Default,,0,0,0,,Сиқырлы пулемет дайын!
Dialogue: 0,0:18:48.37,0:18:49.54,Default,,0,0,0,,Shoot! (ату дыбысы)
Dialogue: 0,0:18:49.67,0:18:50.96,Default,,0,0,0,,Ах! Хмм...
Dialogue: 0,0:18:51.17,0:18:52.38,Default,,0,0,0,,Дайындықты жалғастырыңыз!
Dialogue: 0,0:18:52.50,0:18:55.46,Default,,0,0,0,,Ату! (ату дыбысы)
Dialogue: 0,0:18:55.63,0:18:58.47,Default,,0,0,0,,Уау! Аспан жоқ! Жерде!
Dialogue: 0,0:18:59.22,0:19:01.59,Default,,0,0,0,,Ах... мм... тұтынушы...
Dialogue: 0,0:19:01.72,0:19:03.64,Default,,0,0,0,,Ол жақсы әйел емес пе?
Dialogue: 0,0:19:03.76,0:19:05.72,Default,,0,0,0,,Мен... қиналып жатырмын...
Dialogue: 0,0:19:05.85,0:19:08.23,Default,,0,0,0,,Мәселе неде? Иә?
Dialogue: 0,0:19:08.35,0:19:09.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:09.14,0:19:11.48,Default,,0,0,0,,Сенің менің әйелім болғаныңды қалаймын.
Dialogue: 0,0:19:11.98,0:19:13.48,Default,,0,0,0,,Сәлем? (Люси) Эй...
Dialogue: 0,0:19:13.61,0:19:15.48,Default,,0,0,0,,Тұтынушы Иә?
Dialogue: 0,0:19:16.07,0:19:20.07,Default,,0,0,0,,Біздің бишілерге қол тигізбеуге болады ма?
Dialogue: 0,0:19:20.20,0:19:20.86,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:21.03,0:19:24.12,Default,,0,0,0,,Ха... Заш мырза, таяқ...
Dialogue: 0,0:19:24.58,0:19:26.37,Default,,0,0,0,,Менің таяқшамды ұрлап кетті!
Dialogue: 0,0:19:26.62,0:19:28.12,Default,,0,0,0,,Ммм... Жөтел...
Dialogue: 0,0:19:28.58,0:19:32.50,Default,,0,0,0,,Хм... Нацудың бейбақ, білуге ​​әлі ерте!
Dialogue: 0,0:19:32.67,0:19:34.00,Default,,0,0,0,,Ммм… Ммм…
Dialogue: 0,0:19:35.63,0:19:37.75,Default,,0,0,0,,Сіз кімсіз? Теми
Dialogue: 0,0:19:38.17,0:19:39.01,Default,,0,0,0,,Фу…
Dialogue: 0,0:19:39.17,0:19:41.01,Default,,0,0,0,,(қатты дыбыс)
Dialogue: 0,0:19:43.01,0:19:45.51,Default,,0,0,0,,Біздің киім ауыстыратын бөлмемізде темекі шегуге болмайды.
Dialogue: 0,0:19:46.01,0:19:47.43,Default,,0,0,0,,Сәлем! (Soldier B) Woohoo!
Dialogue: 0,0:19:50.43,0:19:52.52,Default,,0,0,0,,Осылай қашайық.
Dialogue: 0,0:19:52.81,0:19:54.81,Default,,0,0,0,,Эльза! Ха...
Dialogue: 0,0:19:58.90,0:20:00.90,Default,,0,0,0,,(жаншылған дыбыс)
Dialogue: 0,0:20:03.61,0:20:05.66,Default,,0,0,0,,Fiore guys?
Dialogue: 0,0:20:05.82,0:20:06.91,Default,,0,0,0,,Күте тұрыңыз! Ннн...
Dialogue: 0,0:20:07.28,0:20:09.95,Default,,0,0,0,,Мазалама! Мен барлығын ұшырып жіберемін!
Dialogue: 0,0:20:10.08,0:20:13.67,Default,,0,0,0,,Жоқ, солдаттар жаман адамдар емес.
Dialogue: 0,0:20:13.83,0:20:15.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:15.50,0:20:16.42,Default,,0,0,0,,Венди!
Dialogue: 0,0:20:17.34,0:20:21.42,Default,,0,0,0,,Досты ренжіткен адам – дұшпан!
Dialogue: 0,0:20:23.38,0:20:25.93,Default,,0,0,0,,Вэнди таяқ сұрайды... Иә.
Dialogue: 0,0:20:26.09,0:20:28.93,Default,,0,0,0,,Міне, әмияның. Қуып жет!
Dialogue: 0,0:20:29.10,0:20:30.93,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:31.43,0:20:33.27,Default,,0,0,0,,Вэнди, жақсысың ба?
Dialogue: 0,0:20:33.39,0:20:35.19,Default,,0,0,0,,Иә, ештеңе жоқ.
Dialogue: 0,0:20:35.48,0:20:36.65,Default,,0,0,0,,Керісінше, бұл таяқ...
Dialogue: 0,0:20:36.77,0:20:37.94,Default,,0,0,0,,Жоғары! Иә?
Dialogue: 0,0:20:38.11,0:20:39.69,Default,,0,0,0,,Уау! Ах!
Dialogue: 0,0:20:40.15,0:20:40.94,Default,,0,0,0,,A cane!
Dialogue: 0,0:20:41.11,0:20:42.57,Default,,0,0,0,,Happy! (Бақыттымын) Сәлем!
Dialogue: 0,0:20:43.07,0:20:44.57,Default,,0,0,0,,Nnn… nn…
Dialogue: 0,0:20:53.91,0:20:54.58,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:57.67,0:21:00.84,Default,,0,0,0,,Венди осылай! өтінемін!
Dialogue: 0,0:21:00.96,0:21:01.84,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:02.63,0:21:05.51,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:21:05.63,0:21:06.47,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:07.64,0:21:08.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:10.31,0:21:11.72,Default,,0,0,0,,Хмм! (Soldiers) Ah!
Dialogue: 0,0:21:14.06,0:21:15.69,Default,,0,0,0,,Сұр! Оу!
Dialogue: 0,0:21:21.48,0:21:22.23,Default,,0,0,0,,Оны сыныптар бойынша айналмалы турнир деп атайды.
Dialogue: 0,0:21:23.32,0:21:26.15,Default,,0,0,0,,Oh... Aah...
Dialogue: 0,0:21:27.49,0:21:28.66,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:29.87,0:21:31.16,Default,,0,0,0,,(жебе ату дыбысы)
Dialogue: 0,0:21:31.58,0:21:32.91,Default,,0,0,0,,(Біреуді тесіп өткендей дыбыс)
Dialogue: 0,0:21:35.04,0:21:35.91,Default,,0,0,0,,Хмм... (Жебенің ату дыбысы)
Dialogue: 0,0:21:37.08,0:21:38.42,Default,,0,0,0,,Хмм... (жебенің ату дыбысы)
Dialogue: 0,0:21:38.63,0:21:39.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:40.09,0:21:42.42,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:42.59,0:21:44.17,Default,,0,0,0,,Hmm... Lucy!
Dialogue: 0,0:21:45.38,0:21:47.55,Default,,0,0,0,,Ннн… Ннн…
Dialogue: 0,0:21:48.93,0:21:53.02,Default,,0,0,0,,Open! Тенсай сарайының есігі! Scorpion!
Dialogue: 0,0:21:53.14,0:21:54.06,Default,,0,0,0,,Біз!
Dialogue: 0,0:21:54.60,0:21:56.81,Default,,0,0,0,,Құмбаустер!
Dialogue: 0,0:21:57.48,0:21:59.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:59.65,0:22:00.65,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:22:04.32,0:22:05.32,Default,,0,0,0,,Люси! (мылтық)
Dialogue: 0,0:22:05.65,0:22:06.57,Default,,0,0,0,,Бұл оңай-ақ болар, иә? Хех, хе-хех, хе
Dialogue: 0,0:22:06.74,0:22:09.07,Default,,0,0,0,,Ах! (Lucy) Scorpion!
Dialogue: 0,0:22:10.32,0:22:11.45,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:12.03,0:22:15.87,Default,,0,0,0,,Сен қазына бөлмесіне қалай кірдің? Иә?
Dialogue: 0,0:22:17.54,0:22:22.21,Default,,0,0,0,,Бұл есік менің сақинам болмаса, ашылмайды.
Dialogue: 0,0:22:22.42,0:22:23.46,Default,,0,0,0,,Ннн…
Dialogue: 0,0:22:24.00,0:22:27.22,Default,,0,0,0,,Тоқта, сен мені жеңе алмайсың.
Dialogue: 0,0:22:28.05,0:22:32.72,Default,,0,0,0,,Мен бұл елдің қорғанысына неліктен жауапты екенімді білесіз бе?
Dialogue: 0,0:22:32.89,0:22:33.81,Default,,0,0,0,,(Мылтық атылған дыбыс)
Dialogue: 0,0:22:35.22,0:22:40.35,Default,,0,0,0,,Өйткені мен бұл елдегі ең мықты адаммын!
Dialogue: 0,0:22:41.52,0:22:42.69,Default,,0,0,0,,Уф!
Dialogue: 0,0:22:43.11,0:22:44.19,Default,,0,0,0,,Нацу!
Dialogue: 0,0:22:46.36,0:22:47.69,Default,,0,0,0,,Ха... Нһ!
Dialogue: 0,0:22:47.86,0:22:48.95,Default,,0,0,0,,Уау! (People) Ah...
Dialogue: 0,0:22:49.36,0:22:50.41,Default,,0,0,0,,Иә!
Dialogue: 0,0:22:50.53,0:22:51.95,Default,,0,0,0,,Иә! (sound of fighting)
Dialogue: 0,0:22:52.49,0:22:53.70,Default,,0,0,0,,О! Апыр-ай!
Dialogue: 0,0:22:53.87,0:22:54.70,Default,,0,0,0,,(тесетін дыбыс)
Dialogue: 0,0:22:54.87,0:22:56.16,Default,,0,0,0,,
Dialogue: 0,0:22:56.29,0:22:58.71,Default,,0,0,0,,Мм... (Люси) Нацу!
Dialogue: 0,0:22:59.79,0:23:00.92,Default,,0,0,0,,Ннн…
Dialogue: 0,0:23:02.29,0:23:03.21,Default,,0,0,0,,Иә!
Dialogue: 0,0:23:04.25,0:23:05.21,Default,,0,0,0,,Ха…
Dialogue: 0,0:23:05.38,0:23:07.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:08.30,0:23:09.93,Default,,0,0,0,,Не?Бұл жігіттер
Dialogue: 0,0:23:10.05,0:23:11.97,Default,,0,0,0,,Барлығы бірге... (Люси) Жоқ!
Dialogue: 0,0:23:12.09,0:23:14.97,Default,,0,0,0,,Бұл адамдар қала тұрғындары, олар әскерилер емес.
Dialogue: 0,0:23:15.10,0:23:17.18,Default,,0,0,0,,Иә? (Lucy) Being manipulated
Dialogue: 0,0:23:17.31,0:23:18.48,Default,,0,0,0,,Don't be dirty!
Dialogue: 0,0:23:18.85,0:23:22.73,Default,,0,0,0,,Таяқшаңызды ақырын беріңіз. It's not yours.
Dialogue: 0,0:23:22.94,0:23:27.23,Default,,0,0,0,,Фиоре бұл қызметкерлердің шынайы күшін ешқашан білмейді.
Dialogue: 0,0:23:29.90,0:23:30.95,Default,,0,0,0,,Хмм... (Люси) А...
Dialogue: 0,0:23:31.07,0:23:31.99,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:23:32.49,0:23:33.99,Default,,0,0,0,,See you then! (Lucy) What?
Dialogue: 0,0:23:37.41,0:23:41.83,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:23:46.96,0:23:52.59,Default,,0,0,0,,Сіз твиттер жазбайсыз, мені жау етіп жатырсыз ба?
Dialogue: 0,0:23:53.34,0:23:55.01,Default,,0,0,0,,Мен саған да беремін, Тору.
Dialogue: 0,0:23:55.14,0:23:58.18,Default,,0,0,0,,Заш, бұл үлкен қателік.
Dialogue: 0,0:23:58.52,0:24:00.77,Default,,0,0,0,,Жатқан жеріңіз жайлы болсын Мәртебелі
Dialogue: 0,0:24:00.89,0:24:03.69,Default,,0,0,0,,Соня-саманың күшін пайдалансаңыз, жаудың тұрған жерін біле аласыз...
Dialogue: 0,0:24:03.85,0:24:05.69,Default,,0,0,0,,Uh... Uuuuu!
Dialogue: 0,0:24:06.27,0:24:08.57,Default,,0,0,0,,Sonya is mine
Dialogue: 0,0:24:08.86,0:24:13.32,Default,,0,0,0,,Сен сияқты қабілетсіз адамның кесірінен мен саған қауіп төндіре алмаймын.
Dialogue: 0,0:24:13.45,0:24:15.70,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:15.82,0:24:16.70,Default,,0,0,0,,Я...
Dialogue: 0,0:24:17.33,0:24:21.00,Default,,0,0,0,,Бірақ аз ғана уақыт қалды.
Dialogue: 0,0:24:21.12,0:24:24.46,Default,,0,0,0,,Соняның күшін пайдалану мүмкін емес пе?
Dialogue: 0,0:24:25.54,0:24:27.84,Default,,0,0,0,,Үш жұлдызды өзіңізбен бірге алыңыз.
Dialogue: 0,0:24:27.96,0:24:29.80,Default,,0,0,0,,Ха! Жақсы?
Dialogue: 0,0:24:29.92,0:24:34.72,Default,,0,0,0,,Соняның күшін пайдаланатын болсаңыз, сізге тамаша оққағар керек.
Dialogue: 0,0:24:35.22,0:24:38.10,Default,,0,0,0,,Never hurt Sonya.
Dialogue: 0,0:24:38.22,0:24:39.47,Default,,0,0,0,,Ннн…
Dialogue: 0,0:24:46.65,0:24:50.03,Default,,0,0,0,,Соня (Соня) Шляпа... Мәртебелі Анимус
Dialogue: 0,0:24:50.15,0:24:53.49,Default,,0,0,0,,Тағы да есіктің дыбысын шығармай, бөлмеме кірдім...
Dialogue: 0,0:24:54.53,0:24:56.49,Default,,0,0,0,,Өйткені мен сиқыршымын
Dialogue: 0,0:24:58.83,0:25:00.99,Default,,0,0,0,,Бұл елде уақыт таусылып барады
Dialogue: 0,0:25:05.92,0:25:09.34,Default,,0,0,0,,Айдаһардың көз жасы әрқашан менің қолымда болады
Dialogue: 0,0:25:12.34,0:25:15.01,Default,,0,0,0,,Хмм... (Бақытты) Хахаха...
Dialogue: 0,0:25:15.76,0:25:17.76,Default,,0,0,0,,Таяқ алынды
Dialogue: 0,0:25:18.26,0:25:21.97,Default,,0,0,0,,Мәселе - Фиорға қалай оралу.
Dialogue: 0,0:25:22.10,0:25:25.69,Default,,0,0,0,,Нацудың арқасында олар байқады.
Dialogue: 0,0:25:25.81,0:25:29.15,Default,,0,0,0,,Бұл менің кінәм емес, бұл қақпан болса керек...
Dialogue: 0,0:25:29.90,0:25:33.15,Default,,0,0,0,,Байқамағаным үшін кінәлімін. Кешіріңіз.
Dialogue: 0,0:25:33.61,0:25:34.90,Default,,0,0,0,,Мен оны міндетті түрде құтқарамын.
Dialogue: 0,0:25:35.15,0:25:38.20,Default,,0,0,0,,Мұндай таяқ таңғажайып сиқырлы күшті жасырады дегенге сену қиын.
Dialogue: 0,0:25:38.32,0:25:41.03,Default,,0,0,0,,Көрсет, көрсет! Хмм...
Dialogue: 0,0:25:41.41,0:25:44.70,Default,,0,0,0,,Хмм... Мен ешқандай сиқырлы күшті сезбеймін.
Dialogue: 0,0:25:44.83,0:25:46.04,Default,,0,0,0,,Ойнамаңыз
Dialogue: 0,0:25:47.79,0:25:49.79,Default,,0,0,0,,Бірақ ертерек Нацу-сан...
Dialogue: 0,0:25:50.04,0:25:52.05,Default,,0,0,0,,Иә? Ах...
Dialogue: 0,0:25:52.42,0:25:54.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:55.80,0:25:58.68,Default,,0,0,0,,Ах! Жоқ, түсінбеймін.
Dialogue: 0,0:25:59.43,0:26:03.68,Default,,0,0,0,,Қалай десек те, елді құртуға болатын таяқ – алаңдатарлық оқиға.
Dialogue: 0,0:26:04.14,0:26:07.48,Default,,0,0,0,,Сақтықпен қарау керек. (Бақыттымын) Хмм! Иә?
Dialogue: 0,0:26:10.36,0:26:13.94,Default,,0,0,0,,Әй, әпкелер, басқа жақтан келдің бе?
Dialogue: 0,0:26:14.40,0:26:15.90,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:26:16.03,0:26:18.15,Default,,0,0,0,,Сонда әлгі аға туралы не деуге болады?
Dialogue: 0,0:26:18.28,0:26:18.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:19.11,0:26:20.57,Default,,0,0,0,,♪ (гитара орындауы)
Dialogue: 0,0:26:20.70,0:26:23.08,Default,,0,0,0,,♪Сәби бала
Dialogue: 0,0:26:23.20,0:26:24.95,Default,,0,0,0,,Тұтынушы Маған қиындық туды!
Dialogue: 0,0:26:25.54,0:26:26.83,Default,,0,0,0,,Ммммммм...
Dialogue: 0,0:26:26.96,0:26:28.96,Default,,0,0,0,,Не болды? Ювия!
Dialogue: 0,0:26:29.83,0:26:30.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:31.59,0:26:36.21,Default,,0,0,0,,Күтілгендей, Грей-сама сенсоры осы қалашыққа жауап беруде.
Dialogue: 0,0:26:36.55,0:26:37.97,Default,,0,0,0,,Уууу…
Dialogue: 0,0:26:38.30,0:26:40.68,Default,,0,0,0,,Не болды? Мистер Грей
Dialogue: 0,0:26:40.80,0:26:43.43,Default,,0,0,0,,Ал... Мен аздап салқындап кеттім...
Dialogue: 0,0:26:43.56,0:26:45.47,Default,,0,0,0,,Мұз сиқыршысы болғанына қарамастан
Dialogue: 0,0:26:46.81,0:26:49.98,Default,,0,0,0,,Мен киім кимейтіндіктен! Мен білмей тұрып!
Dialogue: 0,0:26:50.35,0:26:53.61,Default,,0,0,0,,Бұл жер Фиордан биік.
Dialogue: 0,0:26:53.73,0:26:55.61,Default,,0,0,0,,Температура да аздап төмен болуы мүмкін.
Dialogue: 0,0:26:55.94,0:26:56.78,Default,,0,0,0,,Я...
Dialogue: 0,0:26:56.90,0:26:58.90,Default,,0,0,0,,Ойланып қарасам, ауасы да дәмді.
Dialogue: 0,0:26:59.03,0:27:01.03,Default,,0,0,0,,Кешіріңіз, мен ертерек иіскедім.
Dialogue: 0,0:27:01.16,0:27:02.20,Default,,0,0,0,,Ннн…
Dialogue: 0,0:27:02.32,0:27:05.29,Default,,0,0,0,,Стелла патшалығын жұлдыздар елі дейді.
Dialogue: 0,0:27:05.41,0:27:07.50,Default,,0,0,0,,Жұлдыздар сұлулығымен әйгілі емес пе?
Dialogue: 0,0:27:07.95,0:27:10.46,Default,,0,0,0,,А...
Dialogue: 0,0:27:11.67,0:27:12.50,Default,,0,0,0,,Өтірікші
Dialogue: 0,0:27:12.83,0:27:15.63,Default,,0,0,0,,Бұлтты болса көмектесу мүмкін емес.
Dialogue: 0,0:27:15.75,0:27:17.80,Default,,0,0,0,,Хе... Аспан рухының сиқыршысы ретінде...
Dialogue: 0,0:27:17.92,0:27:21.51,Default,,0,0,0,,Мен Стелланың жарқыраған жұлдызды аспанды бір рет болса да көргім келді.
Dialogue: 0,0:27:23.43,0:27:25.56,Default,,0,0,0,,Тынш! біреу келе жатыр
Dialogue: 0,0:27:25.68,0:27:28.27,Default,,0,0,0,,Қуғыншы? Мұнда қалай жетуге болады?
Dialogue: 0,0:27:28.89,0:27:30.77,Default,,0,0,0,,Барлығы шайқасқа дайын
Dialogue: 0,0:27:30.94,0:27:31.77,Default,,0,0,0,,Ннн…
Dialogue: 0,0:27:33.23,0:27:37.03,Default,,0,0,0,,Жоғарыда? Менің әдемі аяқтарымнан рахат алыңыз
Dialogue: 0,0:27:37.19,0:27:38.03,Default,,0,0,0,,Хмм...
Dialogue: 0,0:27:38.61,0:27:39.53,Default,,0,0,0,,Ннн!
Dialogue: 0,0:27:40.95,0:27:41.70,Default,,0,0,0,,Иә!
Dialogue: 0,0:27:41.86,0:27:44.45,Default,,0,0,0,,Бұл әдемі соққы!
Dialogue: 0,0:27:44.74,0:27:47.20,Default,,0,0,0,,А... Стелланиум?
Dialogue: 0,0:27:50.16,0:27:53.79,Default,,0,0,0,,Енді жұмысқа кірісейік, Франсуа Кателин.
Dialogue: 0,0:27:56.38,0:27:57.46,Default,,0,0,0,,Ыстық!
Dialogue: 0,0:27:57.92,0:28:00.47,Default,,0,0,0,,Жақсы, Франсуа Кателин.
Dialogue: 0,0:28:00.84,0:28:02.30,Default,,0,0,0,,Ах! Апыр-ай!
Dialogue: 0,0:28:02.47,0:28:03.68,Default,,0,0,0,,...Сен бейбақ!
Dialogue: 0,0:28:05.22,0:28:06.93,Default,,0,0,0,,Хи хи хи...ха...
Dialogue: 0,0:28:09.60,0:28:10.52,Default,,0,0,0,,Ха…
Dialogue: 0,0:28:10.73,0:28:13.14,Default,,0,0,0,,Уау! О, солай!
Dialogue: 0,0:28:13.81,0:28:14.65,Default,,0,0,0,,Ннн…
Dialogue: 0,0:28:15.73,0:28:16.90,Default,,0,0,0,,Иә? Уф!
Dialogue: 0,0:28:17.19,0:28:18.90,Default,,0,0,0,,Асығыс!
Dialogue: 0,0:28:19.07,0:28:20.61,Default,,0,0,0,,Хаа!
Dialogue: 0,0:28:20.74,0:28:21.90,Default,,0,0,0,,Франсуа Жақсы!
Dialogue: 0,0:28:24.16,0:28:26.78,Default,,0,0,0,,Ха... (Қуыршақ) Кателин де тамаша.
Dialogue: 0,0:28:29.16,0:28:30.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:28:30.20,0:28:31.79,Default,,0,0,0,,Мына әдемі аяқтар туралы не ойлайсың? Хмм...
Dialogue: 0,0:28:31.96,0:28:35.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:28:35.21,0:28:36.04,Default,,0,0,0,,Кух... иә...
Dialogue: 0,0:28:36.54,0:28:38.04,Default,,0,0,0,,Мен таяқты алдым.
Dialogue: 0,0:28:38.21,0:28:41.05,Default,,0,0,0,,Ууууууууууууууууууууууууууууу!
Dialogue: 0,0:28:46.34,0:28:47.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:28:49.97,0:28:51.98,Default,,0,0,0,,Хмм... аа...
Dialogue: 0,0:28:54.35,0:28:55.98,Default,,0,0,0,,Ннн! (Люси) Нацу?
Dialogue: 0,0:28:56.15,0:28:56.98,Default,,0,0,0,,Ннн!
Dialogue: 0,0:28:57.48,0:28:59.48,Default,,0,0,0,,Сәлем Нацу! не болды?
Dialogue: 0,0:29:00.53,0:29:01.48,Default,,0,0,0,,Нацу?
Dialogue: 0,0:29:01.65,0:29:02.74,Default,,0,0,0,,Ннн!
Dialogue: 0,0:29:04.82,0:29:05.99,Default,,0,0,0,,Не болды? Нацу
Dialogue: 0,0:29:06.16,0:29:08.49,Default,,0,0,0,,Фуфу…
Dialogue: 0,0:29:08.74,0:29:10.24,Default,,0,0,0,,Ннн!
Dialogue: 0,0:29:11.24,0:29:12.25,Default,,0,0,0,,Ха... жоқ...
Dialogue: 0,0:29:14.62,0:29:16.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:29:19.79,0:29:21.59,Default,,0,0,0,,Сондықтан да сен тынышсыз
Dialogue: 0,0:29:21.71,0:29:22.38,Default,,0,0,0,,Ха…
Dialogue: 0,0:29:22.80,0:29:24.51,Default,,0,0,0,,Хехе... Ах!
Dialogue: 0,0:29:25.47,0:29:26.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:29:27.55,0:29:29.89,Default,,0,0,0,,Уа! Ааа!
Dialogue: 0,0:29:35.27,0:29:36.64,Default,,0,0,0,,А... хех хе...
Dialogue: 0,0:29:41.40,0:29:45.15,Default,,0,0,0,,Үш жұлдыз күткендей, оларды орындаңыз.
Dialogue: 0,0:29:45.36,0:29:47.41,Default,,0,0,0,,(Пак) Небәрі бірнеше онжылдық қана өмір сүрген адам—
Dialogue: 0,0:29:47.53,0:29:50.91,Default,,0,0,0,,Менде штат бар. Мен сені өлтіре алмаймын...
Dialogue: 0,0:29:51.20,0:29:55.91,Default,,0,0,0,,Бірақ Соня, бұл адамдар біздің елге сатқындар.
Dialogue: 0,0:29:56.25,0:30:00.34,Default,,0,0,0,,Оларға тиісті жазасын бермесек, халыққа ештеңе көрсете алмаймыз.
Dialogue: 0,0:30:01.00,0:30:05.30,Default,,0,0,0,,Мен енді жанымның айқайын естігім келмейді.
Dialogue: 0,0:30:05.76,0:30:07.30,Default,,0,0,0,,Ннн…
Dialogue: 0,0:30:07.80,0:30:12.06,Default,,0,0,0,,Егер сіз Соня ханымның көңілін қалдырсаңыз, Мәртебелі ашуланады.
Dialogue: 0,0:30:12.18,0:30:13.39,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:30:13.52,0:30:17.31,Default,,0,0,0,,Франсуа Кателин Жұмыс аяқталды.
Dialogue: 0,0:30:17.89,0:30:21.65,Default,,0,0,0,,Мм... Онда құстың ұясына қамалып ал.
Dialogue: 0,0:30:21.77,0:30:22.44,Default,,0,0,0,,Ха!
Dialogue: 0,0:30:25.44,0:30:28.20,Default,,0,0,0,,Хи хи...
Dialogue: 0,0:30:29.41,0:30:31.66,Default,,0,0,0,,Мен тек осы әйелді аламын.
Dialogue: 0,0:30:44.05,0:30:47.84,Default,,0,0,0,,Хаха... есіме түсті.
Dialogue: 0,0:30:52.35,0:30:53.26,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:30:54.56,0:30:56.98,Default,,0,0,0,,Хмм... Бұл менің кінәм.
Dialogue: 0,0:30:57.73,0:30:59.14,Default,,0,0,0,,Біз барлығына көмектесуіміз керек
Dialogue: 0,0:30:59.69,0:31:02.44,Default,,0,0,0,,Қат! Кешіріңіз!
Dialogue: 0,0:31:02.81,0:31:05.15,Default,,0,0,0,,(Сынған дыбыс)
Dialogue: 0,0:31:05.36,0:31:07.15,Default,,0,0,0,,Хмм... иә...
Dialogue: 0,0:31:07.44,0:31:10.28,Default,,0,0,0,,Люси мұнда жоқ. Ол да мұнда емес.
Dialogue: 0,0:31:10.45,0:31:12.53,Default,,0,0,0,,Неліктен Люси жалғыз емес?
Dialogue: 0,0:31:13.32,0:31:15.79,Default,,0,0,0,,Міне... Люси...
Dialogue: 0,0:31:16.95,0:31:18.91,Default,,0,0,0,,Нацу мен білемін.
Dialogue: 0,0:31:19.04,0:31:20.29,Default,,0,0,0,,Оны міндетті түрде табыңыз
Dialogue: 0,0:31:21.04,0:31:23.54,Default,,0,0,0,,Күте тұрыңыз, Люси.
Dialogue: 0,0:31:30.97,0:31:34.72,Default,,0,0,0,,Соня (Соня) Ха... Мәртебелі Анимус
Dialogue: 0,0:31:34.85,0:31:38.31,Default,,0,0,0,,Таяқпен не болды? (Соня) Заш-сама...
Dialogue: 0,0:31:38.43,0:31:41.56,Default,,0,0,0,,Оны ертеңгі рәсімге дейін сақтауға жауапты боламын.
Dialogue: 0,0:31:41.73,0:31:44.69,Default,,0,0,0,,Оны неге маған әкелмейсің? Жақсы...
Dialogue: 0,0:31:45.36,0:31:46.44,Default,,0,0,0,,Мәртебелі…
Dialogue: 0,0:31:47.48,0:31:49.03,Default,,0,0,0,,Мұнда екеніңе сенбеймін
Dialogue: 0,0:31:49.15,0:31:53.45,Default,,0,0,0,,Маған айдаһардың көз жасын әкел.
Dialogue: 0,0:32:03.17,0:32:04.96,Default,,0,0,0,,Ннн…
Dialogue: 0,0:32:07.05,0:32:08.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:09.46,0:32:10.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:11.13,0:32:14.55,Default,,0,0,0,,Хмм... ол қайда? мұнда
Dialogue: 0,0:32:15.39,0:32:17.85,Default,,0,0,0,,А... адамдар?
Dialogue: 0,0:32:18.43,0:32:21.85,Default,,0,0,0,,Кедей (Әйел Б) Жаңа бала?
Dialogue: 0,0:32:23.06,0:32:24.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:32:26.23,0:32:27.36,Default,,0,0,0,,Қан жарылысы!
Dialogue: 0,0:32:28.69,0:32:30.86,Default,,0,0,0,,Жердегі тозаққа
Dialogue: 0,0:32:31.19,0:32:33.36,Default,,0,0,0,,Иә? не? сол жарақат
Dialogue: 0,0:32:38.53,0:32:40.37,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:32:40.54,0:32:41.62,Default,,0,0,0,,Ннн…
Dialogue: 0,0:32:41.79,0:32:42.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:32:43.04,0:32:45.38,Default,,0,0,0,,(әйелдердің қорқынышты дауыстары)
Dialogue: 0,0:32:45.67,0:32:47.38,Default,,0,0,0,,Сен, бұл не...
Dialogue: 0,0:32:49.96,0:32:51.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:32:54.72,0:32:57.85,Default,,0,0,0,,Менің артымнан жүр (Люси) Иә.
Dialogue: 0,0:33:03.94,0:33:06.77,Default,,0,0,0,,Сол жерде тұр (Люси) Иә.
Dialogue: 0,0:33:08.52,0:33:11.36,Default,,0,0,0,,Қолдарыңызды көтеріңіз (Люси) Иә.
Dialogue: 0,0:33:12.07,0:33:13.90,Default,,0,0,0,,Сәлем, сәлем, танысқаныма қуаныштымын
Dialogue: 0,0:33:15.66,0:33:19.91,Default,,0,0,0,,Сіз не істейтініңізді білесіз бе?
Dialogue: 0,0:33:20.08,0:33:21.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:22.66,0:33:27.92,Default,,0,0,0,,Күн сайын қан алыңыз. Шрамы қалады, бірақ бәрібір. Мен сені өлтірмеймін.
Dialogue: 0,0:33:28.58,0:33:32.92,Default,,0,0,0,,Қара магия көп мөлшерде таза қанды қажет етеді.
Dialogue: 0,0:33:33.67,0:33:36.01,Default,,0,0,0,,Жақсы дауыспен жылаңыз
Dialogue: 0,0:33:36.13,0:33:38.05,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:33:38.39,0:33:40.47,Default,,0,0,0,,А... иә
Dialogue: 0,0:33:43.56,0:33:46.31,Default,,0,0,0,,Ах... хехехехе...
Dialogue: 0,0:33:51.69,0:33:52.82,Default,,0,0,0,,Ннн…
Dialogue: 0,0:33:53.36,0:33:55.19,Default,,0,0,0,,Мистер Заш...
Dialogue: 0,0:33:55.53,0:33:58.45,Default,,0,0,0,,Люсиді қайтарыңыз! (Люси) Нацу!
Dialogue: 0,0:33:59.99,0:34:02.20,Default,,0,0,0,,Айдаһар өлтіруші ме?
Dialogue: 0,0:34:02.41,0:34:04.04,Default,,0,0,0,,Уау!
Dialogue: 0,0:34:04.16,0:34:05.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:34:08.29,0:34:11.09,Default,,0,0,0,,Амансың ба? (Люси) Хехе... Иә.
Dialogue: 0,0:34:12.88,0:34:14.09,Default,,0,0,0,,Нацу! Асығыңыз!
Dialogue: 0,0:34:14.38,0:34:16.42,Default,,0,0,0,,Сарбаздар саны көбейді
Dialogue: 0,0:34:16.55,0:34:18.47,Default,,0,0,0,,Тым жылтыр болды ма?
Dialogue: 0,0:34:19.01,0:34:22.43,Default,,0,0,0,,Сонымен балалар құстың ұясынан құтылдыңдар ма?
Dialogue: 0,0:34:22.56,0:34:24.10,Default,,0,0,0,,Біз мұнда қалай келдік?
Dialogue: 0,0:34:24.22,0:34:28.52,Default,,0,0,0,,Мұрын жақсы болса, достарыңның иісі ерекше.
Dialogue: 0,0:34:28.64,0:34:30.73,Default,,0,0,0,,Эй... тоқташы, Нацу.
Dialogue: 0,0:34:31.11,0:34:32.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:34:32.65,0:34:34.78,Default,,0,0,0,,Бар!
Dialogue: 0,0:34:34.90,0:34:36.49,Default,,0,0,0,,Ннн!
Dialogue: 0,0:34:37.40,0:34:39.61,Default,,0,0,0,,Заш мырза, тоқтатыңызшы! Яғни...
Dialogue: 0,0:34:40.16,0:34:43.62,Default,,0,0,0,,Маған қарсы шыққандардың бәрі жойылсын!
Dialogue: 0,0:34:44.24,0:34:45.87,Default,,0,0,0,,Барлығына қорғаныс сиқырын қолданыңыз!
Dialogue: 0,0:34:46.29,0:34:48.87,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:34:51.79,0:34:53.00,Default,,0,0,0,,Барлығы жақсы ма?
Dialogue: 0,0:34:53.34,0:34:55.59,Default,,0,0,0,,Ах (Люси) әйтеуір...
Dialogue: 0,0:34:55.71,0:34:58.22,Default,,0,0,0,,Маған көмекке келгендеріңізге рахмет.
Dialogue: 0,0:34:58.34,0:35:00.80,Default,,0,0,0,,Бастапқыда бұл Нацудың кінәсі еді.
Dialogue: 0,0:35:00.93,0:35:01.64,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:35:02.01,0:35:03.64,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:35:03.89,0:35:05.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:35:05.56,0:35:08.52,Default,,0,0,0,,Уау! Ойлап қарасам... (Люси) Кім?
Dialogue: 0,0:35:09.23,0:35:10.52,Default,,0,0,0,,Мен... мен...
Dialogue: 0,0:35:10.65,0:35:11.98,Default,,0,0,0,,Қайда бардың! (Соня) Ха...
Dialogue: 0,0:35:12.11,0:35:14.11,Default,,0,0,0,,Ұрылар! (Чарльз Венди) Бақыт...
Dialogue: 0,0:35:15.44,0:35:18.78,Default,,0,0,0,,Хмм... Шығудың жолы бар. Маған жазыл.
Dialogue: 0,0:35:18.95,0:35:20.74,Default,,0,0,0,,Мен таяғымды қайтаруым керек.
Dialogue: 0,0:35:20.86,0:35:22.62,Default,,0,0,0,,Біз осы жерден жабуымыз керек. Ах...
Dialogue: 0,0:35:22.74,0:35:26.24,Default,,0,0,0,,Оның сиқырынан әлсіздік таппасаң, онымен күрессең де жеңе алмайсың.
Dialogue: 0,0:35:26.37,0:35:27.41,Default,,0,0,0,,Чи…
Dialogue: 0,0:35:27.58,0:35:30.41,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:35:32.42,0:35:33.42,Default,,0,0,0,,Ха…
Dialogue: 0,0:35:34.09,0:35:36.42,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:35:37.09,0:35:39.51,Default,,0,0,0,,Аа... мінекей.
Dialogue: 0,0:35:40.47,0:35:42.80,Default,,0,0,0,,А... Сіз адамдардың қайда екенін білесіз бе?
Dialogue: 0,0:35:43.01,0:35:44.93,Default,,0,0,0,,Бұл менің сиқырым
Dialogue: 0,0:35:45.35,0:35:48.18,Default,,0,0,0,,Біздің орналасқан жеріміз сол себепті анықталды ма?
Dialogue: 0,0:35:54.98,0:35:57.15,Default,,0,0,0,,Осы уақытқа дейін келсең, амансың.
Dialogue: 0,0:35:57.28,0:36:00.32,Default,,0,0,0,,Рахмет. Сен кімсің?
Dialogue: 0,0:36:00.70,0:36:04.91,Default,,0,0,0,,Мен король Соня Анимустың жақын кеңесшісімін.
Dialogue: 0,0:36:05.03,0:36:07.99,Default,,0,0,0,,...Ал сен неге бізге қашып кетуге рұқсат бересің?
Dialogue: 0,0:36:08.12,0:36:11.58,Default,,0,0,0,,А... бір түсініктеме бар сияқты.
Dialogue: 0,0:36:13.62,0:36:18.92,Default,,0,0,0,,Мен енді адамдарды бақытсыз еткім келмейді...
Dialogue: 0,0:36:19.71,0:36:21.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:22.72,0:36:27.85,Default,,0,0,0,,Мен Аним патшаны есімде қалғаннан бері білемін.
Dialogue: 0,0:36:28.10,0:36:30.43,Default,,0,0,0,,Мен мейірімді едім.
Dialogue: 0,0:36:30.81,0:36:34.94,Default,,0,0,0,,Бірақ мен айдаһардың көз жасын Заш-самадан естідім...
Dialogue: 0,0:36:35.65,0:36:38.23,Default,,0,0,0,,Таяқпен әуестену басталды.
Dialogue: 0,0:36:39.28,0:36:43.86,Default,,0,0,0,,Мен де елім үшін қарақшылық операцияға қосылдым.
Dialogue: 0,0:36:44.41,0:36:45.87,Default,,0,0,0,,Ел үшін?
Dialogue: 0,0:36:47.20,0:36:49.37,Default,,0,0,0,,Стелланийді білесіз бе?
Dialogue: 0,0:36:49.83,0:36:51.87,Default,,0,0,0,,Бұл елдің ерекшелігі, солай ма?
Dialogue: 0,0:36:53.00,0:36:54.33,Default,,0,0,0,,Стелланиум -
Dialogue: 0,0:36:54.46,0:37:00.88,Default,,0,0,0,,Жұлдыз жарығын неғұрлым көп сіңірсе, соғұрлым ол жарқырап, қымбаттайды.
Dialogue: 0,0:37:01.55,0:37:06.09,Default,,0,0,0,,Дегенмен, соңғы жылдары стелланиум қатты айғайлайды.
Dialogue: 0,0:37:06.22,0:37:06.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:07.43,0:37:11.14,Default,,0,0,0,,Стелланиум жұлдыз жарығын тым көп сіңіреді...
Dialogue: 0,0:37:11.27,0:37:15.48,Default,,0,0,0,,Енді сол жарықты бірден шығару мүмкіндігі бар.
Dialogue: 0,0:37:15.94,0:37:18.15,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:37:18.73,0:37:22.36,Default,,0,0,0,,Стелланиум жұлдыз сәулесінің белгілі бір мөлшерін жұтады...
Dialogue: 0,0:37:22.49,0:37:24.24,Default,,0,0,0,,Сиқырлы күшке ие
Dialogue: 0,0:37:24.70,0:37:27.62,Default,,0,0,0,,Егер сол сиқырлы күш бірден босатылса...
Dialogue: 0,0:37:27.74,0:37:28.87,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:37:28.99,0:37:32.41,Default,,0,0,0,,Бұл ел із-түзсіз жоғалады.
Dialogue: 0,0:37:33.04,0:37:38.17,Default,,0,0,0,,Бұл ашудың алдын алу үшін бізге айдаһардың көз жасының күші керек.
Dialogue: 0,0:37:38.29,0:37:39.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:37:40.17,0:37:44.67,Default,,0,0,0,,Айдаһардың барлық жылтырды өшіретін көз жасының күшін пайдаланып...
Dialogue: 0,0:37:45.26,0:37:46.97,Default,,0,0,0,,Ертеңгі кеш
Dialogue: 0,0:37:47.09,0:37:51.31,Default,,0,0,0,,Қаланың солтүстік-батысындағы ғибадатханада жарықты сөндіру рәсімін орындаңыз.
Dialogue: 0,0:37:52.06,0:37:54.06,Default,,0,0,0,,Солай етсек, бұл ел...
Dialogue: 0,0:37:54.68,0:37:57.73,Default,,0,0,0,,Стеллания жоғалып кетсе де...
Dialogue: 0,0:37:57.85,0:38:01.19,Default,,0,0,0,,Елді сақтап қалудың жалғыз жолы осы...
Dialogue: 0,0:38:02.02,0:38:05.70,Default,,0,0,0,,Сондықтан мен саған ол таяқты қайтара алмаймын.
Dialogue: 0,0:38:05.90,0:38:09.32,Default,,0,0,0,,Бірақ сол таяқ бастапқыда біздің елдікі еді.
Dialogue: 0,0:38:09.95,0:38:12.58,Default,,0,0,0,,Тіпті...
Dialogue: 0,0:38:12.70,0:38:16.46,Default,,0,0,0,,Осы елді құтқара алатын қызметкерлердің күшіне сенуден басқа амалым жоқ...
Dialogue: 0,0:38:16.62,0:38:19.08,Default,,0,0,0,,Анау таяқ ондай емес. (Соня) Ха...
Dialogue: 0,0:38:20.29,0:38:21.92,Default,,0,0,0,,Мен оны ұстаған кезде...
Dialogue: 0,0:38:22.04,0:38:26.55,Default,,0,0,0,,Мен айдаһардың ашуын, азабын, мұңын сезіндім.
Dialogue: 0,0:38:27.05,0:38:30.47,Default,,0,0,0,,Сол таяқтың сиқырлы күшін босатпау керек.
Dialogue: 0,0:38:30.59,0:38:33.10,Default,,0,0,0,,Бұл елдің құрып кетуі дұрыс дейсіз бе?
Dialogue: 0,0:38:33.35,0:38:36.10,Default,,0,0,0,,Мен сені құртамын! (Соня) Ха...
Dialogue: 0,0:38:36.43,0:38:40.31,Default,,0,0,0,,Мен бұл елдегі барлық стелланияларды жоямын.
Dialogue: 0,0:38:40.44,0:38:41.98,Default,,0,0,0,,Ендеше маған таяқты қайтарып бер.
Dialogue: 0,0:38:42.52,0:38:46.11,Default,,0,0,0,,Мұны қалай жасауға болады...
Dialogue: 0,0:38:50.99,0:38:52.74,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:38:53.24,0:38:56.75,Default,,0,0,0,,Соняға мұндай қауіп төндірме дедім...
Dialogue: 0,0:38:57.54,0:39:01.71,Default,,0,0,0,,Мен өзімнің таяғымның күшін пайдаланып, олармен бірге жауды үрлеймін деп ойламаппын.
Dialogue: 0,0:39:01.83,0:39:06.67,Default,,0,0,0,,Кешіріңіз, мен ренжідім...
Dialogue: 0,0:39:07.51,0:39:08.67,Default,,0,0,0,,Я...
Dialogue: 0,0:39:08.80,0:39:13.55,Default,,0,0,0,,Ертең маңызды рәсім. Олар міндетті түрде келеді.
Dialogue: 0,0:39:13.68,0:39:18.39,Default,,0,0,0,,Оны сол жерде өлтіріңіз хаха!
Dialogue: 0,0:39:23.56,0:39:28.19,Default,,0,0,0,,Мен сені... сосын сені де өлтіремін.
Dialogue: 0,0:39:30.11,0:39:32.41,Default,,0,0,0,,Керемет жер екен.
Dialogue: 0,0:39:32.66,0:39:35.03,Default,,0,0,0,,Мынау ағаш пішіндес нәрсе қандай?
Dialogue: 0,0:39:35.16,0:39:36.41,Default,,0,0,0,,Оны жемеңіз
Dialogue: 0,0:39:36.99,0:39:38.91,Default,,0,0,0,,Бүгін осында лагерь жасайық.
Dialogue: 0,0:39:39.08,0:39:41.42,Default,,0,0,0,,Маған тағы да шабуыл жасалмайды деп үміттенемін.
Dialogue: 0,0:39:41.54,0:39:43.08,Default,,0,0,0,,Кезек-кезек қадағалап отырайық.
Dialogue: 0,0:39:43.21,0:39:44.92,Default,,0,0,0,,О! Бұл жақсы идея.
Dialogue: 0,0:39:45.04,0:39:47.80,Default,,0,0,0,,Менен бастайық. Мен төсекке баруым керек пе?
Dialogue: 0,0:39:47.96,0:39:49.92,Default,,0,0,0,,(Нацудың қорылдауы)
Dialogue: 0,0:39:50.05,0:39:55.18,Default,,0,0,0,,Барлық стелланиялардың жарқылын өшіру үшін айдаһардың көз жасын пайдаланыңыз.
Dialogue: 0,0:39:55.60,0:39:58.27,Default,,0,0,0,,Бұл шынымен мүмкін бе?
Dialogue: 0,0:39:58.39,0:40:02.65,Default,,0,0,0,,Мүмкін болса да, бұл елдің экономикасы күйреді.
Dialogue: 0,0:40:02.77,0:40:07.07,Default,,0,0,0,,Қалай болғанда да, мен сізге бұл қызметкерлердің сиқырлы күшін пайдалануға рұқсат ете алмаймын.
Dialogue: 0,0:40:07.48,0:40:08.44,Default,,0,0,0,,О
Dialogue: 0,0:40:08.57,0:40:11.32,Default,,0,0,0,,Сіз ертең салтанатты рәсім жасаймын дедіңіз.
Dialogue: 0,0:40:12.11,0:40:14.20,Default,,0,0,0,,Мен оны оған дейін қайтаруым керек.
Dialogue: 0,0:40:14.45,0:40:16.24,Default,,0,0,0,,Мен де бар күшімді саламын
Dialogue: 0,0:40:16.37,0:40:18.45,Default,,0,0,0,,Эй, сен! Сіз не жеп жатырсыз?
Dialogue: 0,0:40:30.63,0:40:33.47,Default,,0,0,0,,Не болды? Люси, ұйықтай алмайсың ба?
Dialogue: 0,0:40:33.59,0:40:36.64,Default,,0,0,0,,Білесіз бе... Меніңше, олар кезек-кезек күзетеді.
Dialogue: 0,0:40:37.14,0:40:39.68,Default,,0,0,0,,Оның орнына мен аңырап қалатын едім.
Dialogue: 0,0:40:39.81,0:40:40.89,Default,,0,0,0,,Хмм...
Dialogue: 0,0:40:42.60,0:40:44.19,Default,,0,0,0,,Осындай нәрсе.
Dialogue: 0,0:40:44.31,0:40:47.90,Default,,0,0,0,,Менің жұмысым - таяқшаны қайтару, бірақ содан кейін...
Dialogue: 0,0:40:48.02,0:40:50.53,Default,,0,0,0,,Бұл ел жойылып кетуі мүмкін.
Dialogue: 0,0:40:53.61,0:40:54.86,Default,,0,0,0,,Осы жерге кел.
Dialogue: 0,0:40:54.99,0:40:56.95,Default,,0,0,0,,Жоқ, бұл юбка.
Dialogue: 0,0:40:57.07,0:40:58.78,Default,,0,0,0,,Жақсы, келіңіз.
Dialogue: 0,0:40:58.95,0:41:01.29,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:41:03.79,0:41:06.04,Default,,0,0,0,,Эй, сен қаншаға барғың келеді?
Dialogue: 0,0:41:07.42,0:41:08.54,Default,,0,0,0,,Хмм...
Dialogue: 0,0:41:09.04,0:41:12.30,Default,,0,0,0,,Эй, мен саған қолымды созамын (Люси)...
Dialogue: 0,0:41:13.51,0:41:15.72,Default,,0,0,0,,Ах... Ха...
Dialogue: 0,0:41:21.60,0:41:25.31,Default,,0,0,0,,Уау! Стелланың жұлдызды аспаны!
Dialogue: 0,0:41:26.60,0:41:28.31,Default,,0,0,0,,Әдемі!
Dialogue: 0,0:41:29.61,0:41:31.57,Default,,0,0,0,,Сіз оны көргіңіз келетінін айттыңыз.
Dialogue: 0,0:41:32.78,0:41:33.69,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:41:34.36,0:41:39.16,Default,,0,0,0,,Әй... Онда бұл басыңды төмен түсіретін уақыт емес.
Dialogue: 0,0:41:39.28,0:41:40.20,Default,,0,0,0,,Ах... Хэхе...
Dialogue: 0,0:41:41.37,0:41:42.29,Default,,0,0,0,,Иә
Dialogue: 0,0:41:54.13,0:41:57.13,Default,,0,0,0,,Не? Бүгінде сарбаздар өте көп.
Dialogue: 0,0:41:57.26,0:41:59.85,Default,,0,0,0,,Хмм... Бірдеңе болып жатыр ма?
Dialogue: 0,0:41:59.97,0:42:02.72,Default,,0,0,0,,Бәрі Грей-самаға ұқсай бастады.
Dialogue: 0,0:42:02.89,0:42:04.60,Default,,0,0,0,,Ей, бұл эмблема!
Dialogue: 0,0:42:05.10,0:42:08.23,Default,,0,0,0,,Міне болды! Бұл Fairy Tail! (Лили) А?
Dialogue: 0,0:42:08.35,0:42:11.36,Default,,0,0,0,,Не? Не? Біз не істедік?
Dialogue: 0,0:42:11.77,0:42:14.49,Default,,0,0,0,,Сіз нені айтасыз? Бұл біраз қиындық тудырды ...
Dialogue: 0,0:42:14.65,0:42:17.49,Default,,0,0,0,,Бірақ... (Солдат) Жүр!
Dialogue: 0,0:42:17.70,0:42:20.07,Default,,0,0,0,,Мен сатылған жекпе-жекті сатып аламын!
Dialogue: 0,0:42:20.20,0:42:21.99,Default,,0,0,0,,Әрине, ол заңды бұзып жатыр ғой.
Dialogue: 0,0:42:22.54,0:42:24.50,Default,,0,0,0,,Ювия барлауға барады.
Dialogue: 0,0:42:24.79,0:42:26.50,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:42:27.41,0:42:29.54,Default,,0,0,0,,Ол жақта шулырақ.
Dialogue: 0,0:42:29.67,0:42:32.50,Default,,0,0,0,,Мен оны қадағалаймын. Сақ болыңыз.
Dialogue: 0,0:42:32.92,0:42:36.26,Default,,0,0,0,,Жақында кездесеміз. (Люси) Ннн...
Dialogue: 0,0:42:38.93,0:42:40.89,Default,,0,0,0,,Мм! (Сарбаздар) Ах!
Dialogue: 0,0:42:41.01,0:42:43.18,Default,,0,0,0,,Мұны маған қалдырыңыз! Ғибадатханаға барыңыз!
Dialogue: 0,0:42:43.51,0:42:44.35,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:42:44.47,0:42:46.60,Default,,0,0,0,,Кеттік! (Бақыттымын) Сәлем!
Dialogue: 0,0:42:46.73,0:42:48.94,Default,,0,0,0,,Бақытты! Не? сол түс
Dialogue: 0,0:42:49.31,0:42:53.90,Default,,0,0,0,,Иә? О! Бәлкім, кеше жеген жаңғақтан шығар?
Dialogue: 0,0:42:54.28,0:42:55.65,Default,,0,0,0,,Хаа!
Dialogue: 0,0:42:55.82,0:42:57.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:42:57.57,0:42:58.40,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:42:58.57,0:43:00.41,Default,,0,0,0,,(сыртқы дыбыс)
Dialogue: 0,0:43:00.57,0:43:01.45,Default,,0,0,0,,Уф!
Dialogue: 0,0:43:01.57,0:43:02.87,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:43:03.66,0:43:04.99,Default,,0,0,0,,Хмм...
Dialogue: 0,0:43:05.74,0:43:08.50,Default,,0,0,0,,Мен сені күттім, қызыл семсер.
Dialogue: 0,0:43:08.62,0:43:09.79,Default,,0,0,0,,Ха... аяғыңды пайдалан!
Dialogue: 0,0:43:10.25,0:43:14.00,Default,,0,0,0,,Жоқ! Ол әдемі аяқтарды пайдаланады!
Dialogue: 0,0:43:16.67,0:43:17.67,Default,,0,0,0,,Ура! Хмм...
Dialogue: 0,0:43:29.18,0:43:30.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:31.81,0:43:34.90,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:43:35.02,0:43:36.15,Default,,0,0,0,,Грей-сама!
Dialogue: 0,0:43:36.61,0:43:39.15,Default,,0,0,0,,Ювия? Неге мұндасың...
Dialogue: 0,0:43:39.32,0:43:42.03,Default,,0,0,0,,Хэхе... Ювияның Грей-сама сенсоры бұл...
Dialogue: 0,0:43:42.16,0:43:44.16,Default,,0,0,0,,Сіз қателескен жоқсыз!
Dialogue: 0,0:43:44.58,0:43:47.75,Default,,0,0,0,,Мүмкін Грей-сама да Juvia Sensor-ға ілесуі мүмкін...
Dialogue: 0,0:43:47.87,0:43:48.66,Default,,0,0,0,,біз қайта орала аламыз.
Dialogue: 0,0:43:48.83,0:43:49.66,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:43:51.29,0:43:52.37,Default,,0,0,0,,Хмм...
Dialogue: 0,0:43:53.46,0:43:54.50,Default,,0,0,0,,Ннн…
Dialogue: 0,0:43:55.63,0:43:58.42,Default,,0,0,0,,Ннн... Франсуа Кейтлин
Dialogue: 0,0:44:00.13,0:44:01.43,Default,,0,0,0,,Жұмыс
Dialogue: 0,0:44:01.93,0:44:04.30,Default,,0,0,0,,Мұның бәрі не туралы?
Dialogue: 0,0:44:04.64,0:44:06.68,Default,,0,0,0,,Көп нәрсе болды.
Dialogue: 0,0:44:06.81,0:44:09.31,Default,,0,0,0,,Әйтеуір, маған қол ұшын беріңіз, иә!
Dialogue: 0,0:44:19.11,0:44:20.15,Default,,0,0,0,,Хмм...
Dialogue: 0,0:44:23.16,0:44:25.70,Default,,0,0,0,,Ой! Хмм...
Dialogue: 0,0:44:27.16,0:44:29.83,Default,,0,0,0,,Мен сені тоқтатамын, жүре бер.
Dialogue: 0,0:44:30.08,0:44:31.62,Default,,0,0,0,,Чарльз да?
Dialogue: 0,0:44:51.64,0:44:52.64,Default,,0,0,0,,Хмм...
Dialogue: 0,0:44:53.81,0:44:55.35,Default,,0,0,0,,Мен сенен күштімін
Dialogue: 0,0:44:55.52,0:44:56.86,Default,,0,0,0,,Гаан!
Dialogue: 0,0:44:57.23,0:44:59.61,Default,,0,0,0,,Мен мұны сізге қалдырамын, Венди Чарльз.
Dialogue: 0,0:44:59.78,0:45:02.11,Default,,0,0,0,,Уф... Иә...
Dialogue: 0,0:45:02.49,0:45:04.11,Default,,0,0,0,,Мені жіберіңізші!
Dialogue: 0,0:45:04.28,0:45:05.36,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:45:06.74,0:45:07.74,Default,,0,0,0,,Хмм...
Dialogue: 0,0:45:09.03,0:45:11.37,Default,,0,0,0,,Grrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrr!
Dialogue: 0,0:45:14.29,0:45:15.12,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:45:15.29,0:45:16.50,Default,,0,0,0,,Ха! Хмм!
Dialogue: 0,0:45:20.55,0:45:22.26,Default,,0,0,0,,Қауіп
Dialogue: 0,0:45:22.84,0:45:24.05,Default,,0,0,0,,Мен, дәл қазір...
Dialogue: 0,0:45:24.17,0:45:26.51,Default,,0,0,0,,Мен сарайдың жертөлесіндегі қыздарға көмектесемін.
Dialogue: 0,0:45:27.01,0:45:28.26,Default,,0,0,0,,Жалғыз болған дұрыс па?
Dialogue: 0,0:45:28.60,0:45:30.26,Default,,0,0,0,,Хмм... Мен жалғыз емеспін.
Dialogue: 0,0:45:31.77,0:45:33.77,Default,,0,0,0,,Өйткені біз аспан рухтарымен біргеміз.
Dialogue: 0,0:45:33.93,0:45:35.35,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:45:35.98,0:45:38.77,Default,,0,0,0,,Бақытты Біз салтты тоқтатамыз!
Dialogue: 0,0:45:39.27,0:45:40.52,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:45:47.70,0:45:49.03,Default,,0,0,0,,Мен оны ұстаған кезде...
Dialogue: 0,0:45:49.53,0:45:53.58,Default,,0,0,0,,Мен айдаһардың ашуын, қайғысын, мұңын сезіндім.
Dialogue: 0,0:45:54.25,0:45:57.21,Default,,0,0,0,,Сол таяқтың сиқырлы күшін босатпау керек.
Dialogue: 0,0:45:57.88,0:45:59.46,Default,,0,0,0,,Ннн…
Dialogue: 0,0:46:03.76,0:46:04.88,Default,,0,0,0,,Ха…
Dialogue: 0,0:46:08.55,0:46:09.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:10.64,0:46:12.64,Default,,0,0,0,,Соня (Соня) қалпақ…
Dialogue: 0,0:46:14.89,0:46:16.64,Default,,0,0,0,,Мәртебелі Анимус...
Dialogue: 0,0:46:17.14,0:46:20.36,Default,,0,0,0,,Жүр, маған айдаһардың көз жасын берші.
Dialogue: 0,0:46:21.44,0:46:23.98,Default,,0,0,0,,Адамдарды бақытсыз ететін күш осы
Dialogue: 0,0:46:24.32,0:46:24.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:25.61,0:46:27.49,Default,,0,0,0,,Жеткізу мүмкін емес
Dialogue: 0,0:46:27.99,0:46:28.99,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:46:29.62,0:46:32.99,Default,,0,0,0,,Қазір қашыңыз! Ол келгенше асығыңыз!
Dialogue: 0,0:46:33.49,0:46:36.25,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:46:36.37,0:46:37.50,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:46:37.92,0:46:39.37,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:46:39.50,0:46:41.50,Default,,0,0,0,,Тезірек, таяқ қайда?
Dialogue: 0,0:46:41.79,0:46:44.38,Default,,0,0,0,,Заш-сама қайтып келді!
Dialogue: 0,0:46:44.51,0:46:45.59,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:46:45.71,0:46:47.88,Default,,0,0,0,,Балалар сендер не істеп жатырсыңдар?
Dialogue: 0,0:46:48.18,0:46:51.68,Default,,0,0,0,,Барлығыңыз, кетіңіздер! Мен мұны істеген жоқпын...
Dialogue: 0,0:46:52.30,0:46:55.02,Default,,0,0,0,,Ашық! Маген сарайының есігі!
Dialogue: 0,0:47:01.06,0:47:02.40,Default,,0,0,0,,Козерог!
Dialogue: 0,0:47:03.19,0:47:04.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:47:04.19,0:47:07.95,Default,,0,0,0,,Ешкілер ше? Ақымақ болма!
Dialogue: 0,0:47:08.65,0:47:09.53,Default,,0,0,0,,Фу…
Dialogue: 0,0:47:33.97,0:47:34.81,Default,,0,0,0,,Иә!
Dialogue: 0,0:47:35.22,0:47:39.31,Default,,0,0,0,,Көзіңді жауып алсаң, сиқырың жұмыс істемейтін сияқты.
Dialogue: 0,0:47:39.60,0:47:44.31,Default,,0,0,0,,Люси-сама күткендей, маған қатты әсер етті.
Dialogue: 0,0:47:44.48,0:47:46.15,Default,,0,0,0,,Жоқ! Уау!
Dialogue: 0,0:47:48.65,0:47:50.28,Default,,0,0,0,,Қазір! Шығуға тез жет!
Dialogue: 0,0:47:54.41,0:47:57.04,Default,,0,0,0,,Мен саған қашуға көмектесемін.
Dialogue: 0,0:47:58.20,0:48:02.29,Default,,0,0,0,,Ммм... Жарайды! Бұлай жасайтын уақыт емес!
Dialogue: 0,0:48:02.71,0:48:04.21,Default,,0,0,0,,Қызыл пышақ! Барайық!
Dialogue: 0,0:48:04.33,0:48:05.29,Default,,0,0,0,,(Қызыл пышақтың дауысы)
Dialogue: 0,0:48:10.67,0:48:13.76,Default,,0,0,0,,Хмм... твиттер жазбаңыз.
Dialogue: 0,0:48:15.30,0:48:17.81,Default,,0,0,0,,Ол қайда барады... Қуып алайық.
Dialogue: 0,0:48:28.15,0:48:29.82,Default,,0,0,0,,Иә! Хмм!
Dialogue: 0,0:48:30.07,0:48:31.07,Default,,0,0,0,,Иә!
Dialogue: 0,0:48:31.24,0:48:33.45,Default,,0,0,0,,Ха! Хааа! Хмм! Хмм!
Dialogue: 0,0:48:34.66,0:48:35.57,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:48:40.41,0:48:42.54,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:48:42.66,0:48:44.08,Default,,0,0,0,,Ха! Хмм!
Dialogue: 0,0:48:45.04,0:48:45.71,Default,,0,0,0,,Ха…
Dialogue: 0,0:48:48.05,0:48:50.80,Default,,0,0,0,,Нһ... нһ! Хмм!
Dialogue: 0,0:48:51.30,0:48:53.34,Default,,0,0,0,,Ура! Жеңілдік! Жеңілдік!
Dialogue: 0,0:48:53.51,0:48:55.51,Default,,0,0,0,,Ура! Жеңілдік! Уа!
Dialogue: 0,0:49:07.69,0:49:09.90,Default,,0,0,0,,Хэхе... Нһ...
Dialogue: 0,0:49:18.66,0:49:19.49,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:49:19.66,0:49:20.62,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:49:20.79,0:49:22.12,Default,,0,0,0,,Хмм... Ха!
Dialogue: 0,0:49:23.04,0:49:23.87,Default,,0,0,0,,Ах!
Dialogue: 0,0:49:24.16,0:49:25.29,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:49:26.29,0:49:27.79,Default,,0,0,0,,Уау!
Dialogue: 0,0:49:28.38,0:49:31.30,Default,,0,0,0,,Франсуа... Кателин
Dialogue: 0,0:49:33.13,0:49:35.47,Default,,0,0,0,,Хмм! Ааа!
Dialogue: 0,0:49:36.18,0:49:37.80,Default,,0,0,0,,Ннн!
Dialogue: 0,0:49:40.01,0:49:42.60,Default,,0,0,0,,Мұз маған әсер етпейді!
Dialogue: 0,0:49:42.72,0:49:43.81,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:49:44.14,0:49:46.31,Default,,0,0,0,,Бұл жігіттің өз қаласы бар...
Dialogue: 0,0:49:46.48,0:49:48.31,Default,,0,0,0,,Ха... бұл қауіпті!
Dialogue: 0,0:49:48.48,0:49:49.52,Default,,0,0,0,,(қыз жылап жатыр)
Dialogue: 0,0:49:49.65,0:49:51.07,Default,,0,0,0,,Ах!
Dialogue: 0,0:49:51.65,0:49:52.32,Default,,0,0,0,,Ювия!
Dialogue: 0,0:50:00.28,0:50:02.33,Default,,0,0,0,,Ха... Они-чан!
Dialogue: 0,0:50:05.50,0:50:08.83,Default,,0,0,0,,Жақсы жұмыс, Кателин.
Dialogue: 0,0:50:12.59,0:50:14.59,Default,,0,0,0,,Ннн…
Dialogue: 0,0:50:15.05,0:50:18.84,Default,,0,0,0,,Хехехе... хехехе...
Dialogue: 0,0:50:19.30,0:50:20.35,Default,,0,0,0,,Хмм...
Dialogue: 0,0:50:21.68,0:50:23.22,Default,,0,0,0,,Иә! (Венди Чарльз) Хмм...
Dialogue: 0,0:50:23.35,0:50:24.43,Default,,0,0,0,,Уау!
Dialogue: 0,0:50:24.56,0:50:26.35,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:50:27.35,0:50:29.10,Default,,0,0,0,,Керемет кадр
Dialogue: 0,0:50:29.65,0:50:32.90,Default,,0,0,0,,Мен жылдамдықты сиқырлы болсам да...
Dialogue: 0,0:50:33.03,0:50:34.61,Default,,0,0,0,,Тым жылдам...
Dialogue: 0,0:50:35.24,0:50:36.36,Default,,0,0,0,,Иә!
Dialogue: 0,0:50:36.53,0:50:38.16,Default,,0,0,0,,(сорғыш дыбыс)
Dialogue: 0,0:50:41.28,0:50:43.91,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:50:45.20,0:50:46.25,Default,,0,0,0,,Ха... Ах!
Dialogue: 0,0:50:47.50,0:50:48.96,Default,,0,0,0,,Ннн…
Dialogue: 0,0:50:51.04,0:50:53.63,Default,,0,0,0,,Қараңдаршы, мен оны көріп тұрмын.
Dialogue: 0,0:50:58.09,0:51:00.34,Default,,0,0,0,,Венди, менде бір ой бар.
Dialogue: 0,0:51:00.47,0:51:01.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:03.64,0:51:06.14,Default,,0,0,0,,Өмір аяқталды
Dialogue: 0,0:51:10.77,0:51:13.15,Default,,0,0,0,,Чарльз, біз сені қуып жетеміз.
Dialogue: 0,0:51:13.61,0:51:15.65,Default,,0,0,0,,Венди бірге дем ал
Dialogue: 0,0:51:16.15,0:51:17.15,Default,,0,0,0,,Иә
Dialogue: 0,0:51:18.11,0:51:19.65,Default,,0,0,0,,1… 2…
Dialogue: 0,0:51:20.16,0:51:21.16,Default,,0,0,0,,Міне, әмияның. Қуып жет!
Dialogue: 0,0:51:21.57,0:51:22.53,Default,,0,0,0,,Үш!
Dialogue: 0,0:51:26.04,0:51:27.66,Default,,0,0,0,,Иә! (тепкі дыбыс)
Dialogue: 0,0:51:28.71,0:51:29.50,Default,,0,0,0,,Уф!
Dialogue: 0,0:51:29.62,0:51:31.04,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:51:32.54,0:51:33.88,Default,,0,0,0,,Оның күші одан сайын артып барады.
Dialogue: 0,0:51:34.80,0:51:35.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:35.88,0:51:36.88,Default,,0,0,0,,Алу…
Dialogue: 0,0:51:37.34,0:51:39.51,Default,,0,0,0,,Уфуфу... Жоқ... Не? Күте тұрыңыз...
Dialogue: 0,0:51:39.63,0:51:40.80,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:51:41.18,0:51:42.47,Default,,0,0,0,,Иә! (Қуыршақ) Уф!
Dialogue: 0,0:51:45.51,0:51:47.97,Default,,0,0,0,,Хмм... ақымақ...
Dialogue: 0,0:51:48.73,0:51:53.98,Default,,0,0,0,,Тіпті Франсуа мен Кателиннің қызуы мұзды еріте алмайды ма?
Dialogue: 0,0:51:54.77,0:51:57.19,Default,,0,0,0,,Жын шығаруға арналған мұз
Dialogue: 0,0:51:57.86,0:52:03.24,Default,,0,0,0,,Жақсы, қуыршақ қарғыс атқан сияқты.
Dialogue: 0,0:52:03.41,0:52:04.24,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:52:05.16,0:52:08.25,Default,,0,0,0,,Менің қыздарымды мазақ қылғың келе ме?
Dialogue: 0,0:52:09.08,0:52:10.16,Default,,0,0,0,,Франсуа!
Dialogue: 0,0:52:10.29,0:52:11.50,Default,,0,0,0,,Кателин! Хмм...
Dialogue: 0,0:52:16.13,0:52:17.50,Default,,0,0,0,,Хмм... иә?
Dialogue: 0,0:52:17.67,0:52:18.88,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:52:20.34,0:52:21.55,Default,,0,0,0,,Уау!
Dialogue: 0,0:52:22.13,0:52:22.80,Default,,0,0,0,,Уау!
Dialogue: 0,0:52:22.93,0:52:24.01,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:52:25.01,0:52:28.01,Default,,0,0,0,,Ах... ннн...
Dialogue: 0,0:52:33.48,0:52:35.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:38.69,0:52:41.03,Default,,0,0,0,,Гу... Грей-сама?
Dialogue: 0,0:52:41.19,0:52:44.28,Default,,0,0,0,,Ухухуху...
Dialogue: 0,0:52:44.53,0:52:47.28,Default,,0,0,0,,Аха! Ууууууу…
Dialogue: 0,0:52:48.45,0:52:52.04,Default,,0,0,0,,Жауды жақсы көр!
Dialogue: 0,0:52:52.21,0:52:53.17,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:52:53.29,0:52:55.67,Default,,0,0,0,,Жеткізу! Махаббат қанаты!
Dialogue: 0,0:52:55.83,0:52:58.30,Default,,0,0,0,,Грей-сама Макс махаббат!
Dialogue: 0,0:52:59.13,0:52:59.80,Default,,0,0,0,,Ии!
Dialogue: 0,0:53:01.26,0:53:03.09,Default,,0,0,0,,Бірақ ол күткендей, оны айналып өтті.
Dialogue: 0,0:53:07.22,0:53:09.81,Default,,0,0,0,,Хмм... жақсы!
Dialogue: 0,0:53:12.35,0:53:14.81,Default,,0,0,0,,Франсуа Кейтлин... Ха...
Dialogue: 0,0:53:14.98,0:53:17.61,Default,,0,0,0,,Уау! (кесілген дыбыс)
Dialogue: 0,0:53:26.78,0:53:29.95,Default,,0,0,0,,(қатты дыбыс)
Dialogue: 0,0:53:37.08,0:53:40.96,Default,,0,0,0,,Ювия, жақсысың ба? Иә, Грей...
Dialogue: 0,0:53:44.13,0:53:45.26,Default,,0,0,0,,Са...
Dialogue: 0,0:53:46.43,0:53:47.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:53:48.39,0:53:52.22,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:53:52.39,0:53:54.23,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:53:54.35,0:53:55.23,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:53:56.02,0:53:57.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:04.11,0:54:05.11,Default,,0,0,0,,Фу…
Dialogue: 0,0:54:10.74,0:54:11.74,Default,,0,0,0,,Хмм...
Dialogue: 0,0:54:20.75,0:54:21.75,Default,,0,0,0,,Ннн!
Dialogue: 0,0:54:25.88,0:54:26.72,Default,,0,0,0,,Ннн…
Dialogue: 0,0:54:28.05,0:54:29.18,Default,,0,0,0,,Иә!
Dialogue: 0,0:54:29.93,0:54:30.97,Default,,0,0,0,,Ннн…
Dialogue: 0,0:54:34.43,0:54:35.48,Default,,0,0,0,,Грандфет!
Dialogue: 0,0:54:36.69,0:54:38.23,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:54:41.77,0:54:42.98,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:54:50.03,0:54:53.24,Default,,0,0,0,,Ммм... Нмммм... Иа...
Dialogue: 0,0:54:54.33,0:54:55.54,Default,,0,0,0,,Хмм…
Dialogue: 0,0:54:56.37,0:54:57.25,Default,,0,0,0,,Ха…
Dialogue: 0,0:55:00.71,0:55:02.75,Default,,0,0,0,,Ақымақ... Мен білмей тұрып...
Dialogue: 0,0:55:03.38,0:55:08.26,Default,,0,0,0,,Сіздің епті аяқтарыңызды көргенде, мен де мұны істей алатындай сезіндім.
Dialogue: 0,0:55:08.43,0:55:11.85,Default,,0,0,0,,Бұл! Бұл мүмкін емес!
Dialogue: 0,0:55:12.89,0:55:15.27,Default,,0,0,0,,Ха... әдемі
Dialogue: 0,0:55:15.52,0:55:19.73,Default,,0,0,0,,Бірақ менің соққыларым барлық адамдарды баурап алады!
Dialogue: 0,0:55:20.02,0:55:23.27,Default,,0,0,0,,Әр еркекті баурап алудың қажеті жоқ!
Dialogue: 0,0:55:24.40,0:55:27.78,Default,,0,0,0,,Жеті жұлдызға қарап баға бер! Ах...
Dialogue: 0,0:55:28.40,0:55:29.78,Default,,0,0,0,,Жеті жұлдызды семсер Үлкен арба!
Dialogue: 0,0:55:48.72,0:55:52.80,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:55:52.97,0:55:57.81,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:56:00.69,0:56:01.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:06.07,0:56:07.19,Default,,0,0,0,,Хмм...
Dialogue: 0,0:56:11.91,0:56:14.20,Default,,0,0,0,,Қандай ақша? Соня
Dialogue: 0,0:56:15.24,0:56:18.04,Default,,0,0,0,,Айдаһардың көз жасын тез берші
Dialogue: 0,0:56:18.62,0:56:19.58,Default,,0,0,0,,Мен...
Dialogue: 0,0:56:20.33,0:56:22.71,Default,,0,0,0,,Маған таяқшамды қайтар! (Бақытты) Қайтарыңыз!
Dialogue: 0,0:56:22.87,0:56:23.71,Default,,0,0,0,,Ха…
Dialogue: 0,0:56:24.25,0:56:27.17,Default,,0,0,0,,Иә? (Бақытты) Соня?
Dialogue: 0,0:56:27.88,0:56:31.47,Default,,0,0,0,,Не? иә? Мәртебелі туралы ше?
Dialogue: 0,0:56:32.01,0:56:34.43,Default,,0,0,0,,Соняда неліктен таяқ бар?
Dialogue: 0,0:56:34.55,0:56:35.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:37.35,0:56:39.97,Default,,0,0,0,,Мәртебелі дәл қазір осында болды...
Dialogue: 0,0:56:40.10,0:56:41.48,Default,,0,0,0,,Маған таяқты беріңіз.
Dialogue: 0,0:56:41.77,0:56:44.52,Default,,0,0,0,,Жоқ, бұл... бұл...
Dialogue: 0,0:56:44.65,0:56:46.98,Default,,0,0,0,,Маған таяқты берме (Соня) Ха...
Dialogue: 0,0:56:49.07,0:56:49.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:50.86,0:56:51.99,Default,,0,0,0,,Соня
Dialogue: 0,0:56:52.15,0:56:54.07,Default,,0,0,0,,Бұл елде уақыт таусылып барады
Dialogue: 0,0:56:54.24,0:56:56.28,Default,,0,0,0,,Маған айдаһардың көз жасын әкел.
Dialogue: 0,0:56:56.45,0:56:59.87,Default,,0,0,0,,Оны неге маған әкелмейсің? Жақсы...
Dialogue: 0,0:57:00.04,0:57:01.83,Default,,0,0,0,,Олар міндетті түрде келеді
Dialogue: 0,0:57:07.34,0:57:11.59,Default,,0,0,0,,Оны сол жерде өлтіріңіз, сенімді болыңыз.
Dialogue: 0,0:57:12.13,0:57:15.34,Default,,0,0,0,,Ах... Мәртебелі...
Dialogue: 0,0:57:15.97,0:57:17.35,Default,,0,0,0,,Мен?
Dialogue: 0,0:57:17.72,0:57:20.10,Default,,0,0,0,,Сен мұны енді ғана түсіндің бе, Соня?
Dialogue: 0,0:57:20.64,0:57:21.35,Default,,0,0,0,,Мәртебелі…
Dialogue: 0,0:57:21.81,0:57:23.89,Default,,0,0,0,,Мен және сен...
Dialogue: 0,0:57:24.19,0:57:26.35,Default,,0,0,0,,Бір адам
Dialogue: 0,0:57:26.77,0:57:29.11,Default,,0,0,0,,Аа... аа!
Dialogue: 0,0:57:29.27,0:57:30.11,Default,,0,0,0,,Соня!
Dialogue: 0,0:57:32.28,0:57:33.49,Default,,0,0,0,,Бұл тегін кофе купондары қанша уақытқа дейін жарамды?
Dialogue: 0,0:57:37.12,0:57:39.62,Default,,0,0,0,,Аа... (Нацу Бақытты) Ах!
Dialogue: 0,0:57:40.08,0:57:41.16,Default,,0,0,0,,Уф…
Dialogue: 0,0:57:41.79,0:57:44.33,Default,,0,0,0,,Ммм... Жөтел...
Dialogue: 0,0:57:44.46,0:57:47.13,Default,,0,0,0,,Бұл кім? Сіз
Dialogue: 0,0:57:47.54,0:57:51.80,Default,,0,0,0,,Хэхехехе... Мен Анимуспын
Dialogue: 0,0:57:52.76,0:57:55.09,Default,,0,0,0,,Соняның ішінде...
Dialogue: 0,0:57:56.51,0:57:58.39,Default,,0,0,0,,Бұл айдаһар
Dialogue: 0,0:57:59.18,0:58:00.14,Default,,0,0,0,,Айдаһар?
Dialogue: 0,0:58:00.43,0:58:03.64,Default,,0,0,0,,(Дарио) Хе-хе-хе-хе. Эй, қарашы — бұл апат!
Dialogue: 0,0:58:04.06,0:58:07.90,Default,,0,0,0,,Сіздің мақсатыңыз қандай? (Бақытты) Сол таяқпен...
Dialogue: 0,0:58:08.02,0:58:11.65,Default,,0,0,0,,Сіз Стелланиумның шабуылын тоқтатуыңыз керек емес пе еді?
Dialogue: 0,0:58:11.94,0:58:17.66,Default,,0,0,0,,Хехе... Соня, мұндай қауесеттерге қалай сенесің...
Dialogue: 0,0:58:18.03,0:58:20.16,Default,,0,0,0,,Мойынсұнғыш қыз (Нацу Бақытты) Иә?
Dialogue: 0,0:58:20.95,0:58:26.92,Default,,0,0,0,,Менің мақсатым – мына қарғыс атқан адам денесінен құтылу.
Dialogue: 0,0:58:27.46,0:58:30.17,Default,,0,0,0,,Игниль өз бетімен шыға алды.
Dialogue: 0,0:58:30.54,0:58:33.67,Default,,0,0,0,,Сіз Игнильді білесіз бе?
Dialogue: 0,0:58:34.96,0:58:39.34,Default,,0,0,0,,Игниль Айдаһар өлтірушіге кірді
Dialogue: 0,0:58:39.64,0:58:43.43,Default,,0,0,0,,Мен ең үйлесімді адамдардың қатарында болдым.
Dialogue: 0,0:58:43.89,0:58:47.69,Default,,0,0,0,,Бірақ таңдауға уақытым болмады.
Dialogue: 0,0:58:48.10,0:58:51.86,Default,,0,0,0,,Жақын жерде болған өліп жатқан Соняға кіріңіз.
Dialogue: 0,0:58:51.98,0:58:54.15,Default,,0,0,0,,Осы жасқа келді.
Dialogue: 0,0:58:54.28,0:58:58.95,Default,,0,0,0,,Осыған байланысты мен өз еркіммен кете алмадым.
Dialogue: 0,0:58:59.20,0:59:02.58,Default,,0,0,0,,Мен бұл айдаһардың көз жасын алғанша
Dialogue: 0,0:59:04.41,0:59:06.70,Default,,0,0,0,,және оларды туған жерім Италияның асханасына енгіздім.
Dialogue: 0,0:59:06.96,0:59:10.79,Default,,0,0,0,,Бұл таяқ айдаһардың күшін арттырады.
Dialogue: 0,0:59:11.08,0:59:12.59,Default,,0,0,0,,Мен босмын!
Dialogue: 0,0:59:12.92,0:59:15.09,Default,,0,0,0,,Маған рұқсат етіңіз!
Dialogue: 0,0:59:17.97,0:59:21.09,Default,,0,0,0,,Сен... Мен сені Игниль таңдайды деп күтпедім...
Dialogue: 0,0:59:21.34,0:59:23.60,Default,,0,0,0,,Ух... аааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:59:24.35,0:59:26.10,Default,,0,0,0,,Нацу-сан... таяқ...
Dialogue: 0,0:59:26.27,0:59:28.56,Default,,0,0,0,,Соня? (Соня) Қазір...
Dialogue: 0,0:59:28.69,0:59:30.31,Default,,0,0,0,,Келіңіздер! Соня!
Dialogue: 0,0:59:30.90,0:59:33.11,Default,,0,0,0,,Ха... (Бақытты) Нацу!
Dialogue: 0,0:59:33.40,0:59:34.52,Default,,0,0,0,,Уау!
Dialogue: 0,0:59:37.65,0:59:40.11,Default,,0,0,0,,Мен айдаһардың көз жасын аламын!
Dialogue: 0,0:59:40.36,0:59:42.12,Default,,0,0,0,,Мен... ит!
Dialogue: 0,0:59:43.62,0:59:45.03,Default,,0,0,0,,Мистер Заш...
Dialogue: 0,0:59:45.16,0:59:49.58,Default,,0,0,0,,Анимус... Жоқ, қазір Соня шығар?
Dialogue: 0,0:59:50.08,0:59:55.71,Default,,0,0,0,,Ол маған патша ретінде бұйрық берді, Соня ретінде ол маған бағынышты болды.
Dialogue: 0,0:59:56.38,1:00:00.59,Default,,0,0,0,,Мүлдем... Мен сенің бір адамдық шоуыңнан шаршадым.
Dialogue: 0,1:00:00.72,1:00:04.89,Default,,0,0,0,,Таяқпен не істеуді жоспарлап отырсыз?
Dialogue: 0,1:00:05.47,1:00:08.14,Default,,0,0,0,,Оны Фиордан кек алу үшін пайдаланыңыз.
Dialogue: 0,1:00:08.31,1:00:09.14,Default,,0,0,0,,Ах... (Соня) Иә?
Dialogue: 0,1:00:10.89,1:00:15.02,Default,,0,0,0,,Айдаһардың көз жасы - жоғары концентрациялы эфирлік наноконденсаттар.
Dialogue: 0,1:00:15.15,1:00:16.69,Default,,0,0,0,,Осыны шығару арқылы-
Dialogue: 0,1:00:16.82,1:00:21.15,Default,,0,0,0,,Ол Этерионға қарағанда ондаған есе көп сиқырлы күш шығара алады.
Dialogue: 0,1:00:21.40,1:00:23.95,Default,,0,0,0,,Сен менің сиқырымды қара сиқыр деп менсінбейсің.
Dialogue: 0,1:00:24.07,1:00:26.66,Default,,0,0,0,,Мен жер аударылған Фиор патшалығын жоямын!
Dialogue: 0,1:00:27.37,1:00:28.66,Default,,0,0,0,,Бұлай емес!
Dialogue: 0,1:00:29.37,1:00:33.50,Default,,0,0,0,,Қызыл пышақ Мен сендерге мына балаларды тамақтандырамын.
Dialogue: 0,1:00:33.63,1:00:34.67,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,1:00:34.79,1:00:37.80,Default,,0,0,0,,Фуфуфу... хахахаха...
Dialogue: 0,1:00:37.92,1:00:39.13,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:00:39.26,1:00:39.92,Default,,0,0,0,,Уау!
Dialogue: 0,1:00:40.09,1:00:42.93,Default,,0,0,0,,(Қызыл пышақтың дауысы)
Dialogue: 0,1:00:43.47,1:00:46.55,Default,,0,0,0,,Мен Нацу мен басқалардың жем болуына жол бермеймін.
Dialogue: 0,1:00:46.85,1:00:49.18,Default,,0,0,0,,Мен қызыл бақыттымын
Dialogue: 0,1:00:49.31,1:00:51.43,Default,,0,0,0,,Сен қорқыныштысың...
Dialogue: 0,1:00:52.81,1:00:55.94,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:00:56.06,1:00:59.44,Default,,0,0,0,,… …
Dialogue: 0,1:00:59.73,1:01:01.28,Default,,0,0,0,,Ннн…
Dialogue: 0,1:01:01.65,1:01:04.28,Default,,0,0,0,,Мияу!
Dialogue: 0,1:01:06.24,1:01:08.08,Default,,0,0,0,,(айқай)
Dialogue: 0,1:01:09.95,1:01:12.41,Default,,0,0,0,,А... Бұл таңқаларлық емес пе? Бақытты
Dialogue: 0,1:01:12.54,1:01:15.25,Default,,0,0,0,,Ах... (Бақытты) Ах, Люси...
Dialogue: 0,1:01:15.38,1:01:16.71,Default,,0,0,0,,Ах... (Люси) Бақытты!
Dialogue: 0,1:01:17.21,1:01:21.46,Default,,0,0,0,,Сәлем Заш! (Люси) Ах, Соня...
Dialogue: 0,1:01:21.84,1:01:23.22,Default,,0,0,0,,...кім емес?
Dialogue: 0,1:01:23.38,1:01:25.47,Default,,0,0,0,,Ннн! (Люси Хаппи) Уау!
Dialogue: 0,1:01:27.43,1:01:31.27,Default,,0,0,0,,(тесетін дыбыс)
Dialogue: 0,1:01:39.48,1:01:41.57,Default,,0,0,0,,Ннн…
Dialogue: 0,1:01:42.57,1:01:44.24,Default,,0,0,0,,Мені кешіріңіз!
Dialogue: 0,1:01:44.61,1:01:46.24,Default,,0,0,0,,Ха... Айдаһар!
Dialogue: 0,1:01:46.41,1:01:49.24,Default,,0,0,0,,Нннннн… Ннннннн…
Dialogue: 0,1:01:50.12,1:01:51.45,Default,,0,0,0,,Ах...
Dialogue: 0,1:01:53.79,1:01:54.83,Default,,0,0,0,,Ах...
Dialogue: 0,1:01:56.33,1:01:58.75,Default,,0,0,0,,Бақыт пен Соняны сұраңыз
Dialogue: 0,1:01:59.13,1:02:00.21,Default,,0,0,0,,Я...
Dialogue: 0,1:02:01.09,1:02:02.09,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:02.84,1:02:04.17,Default,,0,0,0,,О!
Dialogue: 0,1:02:07.39,1:02:09.39,Default,,0,0,0,,Бұл – Мәртебелі
Dialogue: 0,1:02:09.68,1:02:13.52,Default,,0,0,0,,Еліміздің тарихи ғимараттарына қамқорлық жасаңыз.
Dialogue: 0,1:02:13.98,1:02:16.44,Default,,0,0,0,,Маған таяқшаңызды беріңіз, Заш!
Dialogue: 0,1:02:16.56,1:02:19.61,Default,,0,0,0,,Сен солай болғың келген жоқ па?
Dialogue: 0,1:02:19.73,1:02:22.19,Default,,0,0,0,,Мақсат орындалған жоқ па?
Dialogue: 0,1:02:22.32,1:02:27.66,Default,,0,0,0,,Бұл мен іздеген еркіндік емес, толық емес сурет!
Dialogue: 0,1:02:27.78,1:02:29.03,Default,,0,0,0,,(Сыну дыбысы)
Dialogue: 0,1:02:29.95,1:02:32.54,Default,,0,0,0,,Онда мен саған еркіндік беремін.
Dialogue: 0,1:02:32.70,1:02:34.66,Default,,0,0,0,,Мәртебелі Твиттерде.
Dialogue: 0,1:02:34.83,1:02:37.67,Default,,0,0,0,,Нмм... Ннн... Ууууууу!
Dialogue: 0,1:02:38.00,1:02:41.17,Default,,0,0,0,,Уау! Ааа!
Dialogue: 0,1:02:41.34,1:02:43.92,Default,,0,0,0,,Оның күші одан сайын артып барады.
Dialogue: 0,1:02:45.09,1:02:49.72,Default,,0,0,0,,Қалағаныңызша зорлықшыл болыңыз, еркін болыңыз.
Dialogue: 0,1:02:50.14,1:02:53.35,Default,,0,0,0,,Уау!
Dialogue: 0,1:02:53.47,1:02:54.52,Default,,0,0,0,,Мен оны сеземін.
Dialogue: 0,1:03:01.61,1:03:03.44,Default,,0,0,0,,Уау!
Dialogue: 0,1:03:03.61,1:03:06.19,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:03:06.99,1:03:10.20,Default,,0,0,0,,Перілер әлі кезіп жүрген сияқты.
Dialogue: 0,1:03:11.28,1:03:16.70,Default,,0,0,0,,Осындай жағдай орын алса, Мәртебелі жасырын жасап жатқан нәрсені қолданамыз ба?
Dialogue: 0,1:03:17.58,1:03:19.71,Default,,0,0,0,,Шық! Квалт сарбаздары!
Dialogue: 0,1:03:26.96,1:03:28.17,Default,,0,0,0,,Ннн…
Dialogue: 0,1:03:28.84,1:03:29.93,Default,,0,0,0,,Ха…
Dialogue: 0,1:03:31.51,1:03:32.47,Default,,0,0,0,,(тесетін дыбыс)
Dialogue: 0,1:03:33.89,1:03:35.06,Default,,0,0,0,,Иә?
Dialogue: 0,1:03:39.52,1:03:42.61,Default,,0,0,0,,Бұл не? Бұл солдаттар ма?
Dialogue: 0,1:03:42.77,1:03:46.61,Default,,0,0,0,,Сонша... өте көп (Вэнди Чарльз) Нмм...
Dialogue: 0,1:03:48.28,1:03:49.82,Default,,0,0,0,,Венди! Хмм!
Dialogue: 0,1:03:50.36,1:03:51.16,Default,,0,0,0,,Ах!
Dialogue: 0,1:03:51.78,1:03:53.12,Default,,0,0,0,,Ннн…
Dialogue: 0,1:03:53.24,1:03:54.62,Default,,0,0,0,,Қандай күш...
Dialogue: 0,1:03:56.66,1:03:57.58,Default,,0,0,0,,Хмм...
Dialogue: 0,1:03:58.20,1:03:59.12,Default,,0,0,0,,Ннн!
Dialogue: 0,1:03:59.29,1:04:03.46,Default,,0,0,0,,Квалт сарбаздары, ертегілерді тоқтаңдар!
Dialogue: 0,1:04:03.58,1:04:05.13,Default,,0,0,0,,Хахахаха!
Dialogue: 0,1:04:11.26,1:04:12.13,Default,,0,0,0,,Бұл...
Dialogue: 0,1:04:12.51,1:04:16.81,Default,,0,0,0,,Квалт сарбазы... 4-ші буын Айдаһар өлтіруші
Dialogue: 0,1:04:16.93,1:04:18.22,Default,,0,0,0,,Төртінші ұрпақ?
Dialogue: 0,1:04:18.35,1:04:22.40,Default,,0,0,0,,Айдаһар өлтірушінің сиқырлы кристалынан жасалған жасанды сарбаз.
Dialogue: 0,1:04:27.48,1:04:29.99,Default,,0,0,0,,Ашық! Джинба сарайының есігі!
Dialogue: 0,1:04:30.86,1:04:33.53,Default,,0,0,0,,Стрелец! сәлем!
Dialogue: 0,1:04:33.66,1:04:35.58,Default,,0,0,0,,Мен олардың әрқайсысын нысанаға аламын!
Dialogue: 0,1:04:35.70,1:04:37.29,Default,,0,0,0,,Түсіндім!
Dialogue: 0,1:04:37.41,1:04:39.16,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:04:39.75,1:04:41.16,Default,,0,0,0,,Иә!
Dialogue: 0,1:04:41.33,1:04:42.37,Default,,0,0,0,,Хаа!
Dialogue: 0,1:04:42.50,1:04:43.17,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:04:44.29,1:04:46.09,Default,,0,0,0,,Иә! Тат!
Dialogue: 0,1:04:46.21,1:04:48.13,Default,,0,0,0,,Оля!
Dialogue: 0,1:04:48.25,1:04:49.17,Default,,0,0,0,,(Нәрсені қатты жерге ұрған дыбыс)
Dialogue: 0,1:04:49.42,1:04:51.92,Default,,0,0,0,,Иә! Хааа! (кесілген дыбыс)
Dialogue: 0,1:04:52.68,1:04:54.30,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,1:04:55.60,1:04:56.93,Default,,0,0,0,,Аа... Ннн...
Dialogue: 0,1:04:59.97,1:05:01.14,Default,,0,0,0,,Фу…
Dialogue: 0,1:05:03.48,1:05:05.31,Default,,0,0,0,,Таяқ үстінде ме?
Dialogue: 0,1:05:05.86,1:05:07.65,Default,,0,0,0,,Ал...
Dialogue: 0,1:05:07.77,1:05:08.44,Default,,0,0,0,,(үру)
Dialogue: 0,1:05:10.94,1:05:15.78,Default,,0,0,0,,Айдаһардың көз жасы! Нағыз күшіңізді көрсетіңіз!
Dialogue: 0,1:05:24.58,1:05:29.00,Default,,0,0,0,,Әке, бұлар... (Патша) Айдаһардың көз жасы...
Dialogue: 0,1:05:29.30,1:05:32.88,Default,,0,0,0,,Нефрит Король астанасындағы барлық адамдарды эвакуациялаңыз.
Dialogue: 0,1:05:33.01,1:05:35.51,Default,,0,0,0,,Не? (Патша) Бізге асығу керек...
Dialogue: 0,1:05:35.64,1:05:40.72,Default,,0,0,0,,Айдаһардың ашуы мен өшпенділігі сиқырлы күш ретінде жауады.
Dialogue: 0,1:05:40.93,1:05:42.22,Default,,0,0,0,,Не болып жатыр!
Dialogue: 0,1:05:42.64,1:05:44.73,Default,,0,0,0,,Ха…
Dialogue: 0,1:05:44.98,1:05:47.36,Default,,0,0,0,,Ха... Бұл ақылсыз!
Dialogue: 0,1:05:47.69,1:05:49.15,Default,,0,0,0,,Уақыт толы
Dialogue: 0,1:05:49.27,1:05:51.53,Default,,0,0,0,,Өлі айдаһарлар
Dialogue: 0,1:05:51.65,1:05:56.41,Default,,0,0,0,,Бұл ашуды балғаға айналдырып, оны төмен түсір!
Dialogue: 0,1:05:58.53,1:06:00.87,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:06:01.16,1:06:02.37,Default,,0,0,0,,...Сен бейбақ!
Dialogue: 0,1:06:02.50,1:06:05.50,Default,,0,0,0,,Гррр! (жарылыс дыбысы)
Dialogue: 0,1:06:06.67,1:06:08.67,Default,,0,0,0,,Уау!
Dialogue: 0,1:06:08.79,1:06:11.00,Default,,0,0,0,,Мм... Бақытты
Dialogue: 0,1:06:11.13,1:06:13.26,Default,,0,0,0,,Мен мұнараның басына шығамын, өтінемін!
Dialogue: 0,1:06:13.63,1:06:15.47,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,1:06:19.43,1:06:22.01,Default,,0,0,0,,Фуфуфу… фухахаха…
Dialogue: 0,1:06:22.60,1:06:27.02,Default,,0,0,0,,Мен оны сезінемін! Сиқырлы шеңбер бүкіл құрлықты қамтыды!
Dialogue: 0,1:06:27.56,1:06:29.56,Default,,0,0,0,,Жоғал! Fio…
Dialogue: 0,1:06:29.69,1:06:30.52,Default,,0,0,0,,Ах...
Dialogue: 0,1:06:30.98,1:06:34.28,Default,,0,0,0,,А... мынау... мынау...
Dialogue: 0,1:06:34.57,1:06:37.24,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,1:06:37.36,1:06:38.78,Default,,0,0,0,,Уау!
Dialogue: 0,1:06:41.70,1:06:43.33,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,1:06:43.45,1:06:45.04,Default,,0,0,0,,Аа... ннн...
Dialogue: 0,1:06:47.00,1:06:48.12,Default,,0,0,0,,Ннн…
Dialogue: 0,1:06:48.25,1:06:53.05,Default,,0,0,0,,(ұшқын дыбысы)
Dialogue: 0,1:06:53.63,1:06:54.92,Default,,0,0,0,,Йокогама Токионың бір бөлігі ғой!
Dialogue: 0,1:06:55.05,1:06:58.72,Default,,0,0,0,,Бұл айдаһардың көз жасы. Нацу жабайы жүгіріп жүрген болуы керек.
Dialogue: 0,1:06:58.84,1:07:00.18,Default,,0,0,0,,Біз мұны тоқтатуымыз керек!
Dialogue: 0,1:07:00.76,1:07:01.68,Default,,0,0,0,,Хмм...
Dialogue: 0,1:07:01.97,1:07:03.97,Default,,0,0,0,,Уау!
Dialogue: 0,1:07:04.56,1:07:07.69,Default,,0,0,0,,Мына таяқ менікі! Маған берші!
Dialogue: 0,1:07:07.85,1:07:09.40,Default,,0,0,0,,Оны маған беріңіз!
Dialogue: 0,1:07:10.35,1:07:13.11,Default,,0,0,0,,Гррр! (құлап түскен дыбыс)
Dialogue: 0,1:07:13.73,1:07:16.19,Default,,0,0,0,,Ооо... (Бақытты) Ооо!
Dialogue: 0,1:07:16.36,1:07:18.20,Default,,0,0,0,,Бақытты болыңыз! Ха…
Dialogue: 0,1:07:19.36,1:07:20.70,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:07:20.82,1:07:22.70,Default,,0,0,0,,(Жыйрау дыбысы)
Dialogue: 0,1:07:29.12,1:07:33.96,Default,,0,0,0,,Уау!
Dialogue: 0,1:07:34.13,1:07:37.47,Default,,0,0,0,,Сіз айдаһар өлтірушісіз!
Dialogue: 0,1:07:37.59,1:07:38.88,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,1:07:39.01,1:07:43.60,Default,,0,0,0,,Айдаһарлар сен сияқты адамдардың кесірінен азайып кетті.
Dialogue: 0,1:07:43.72,1:07:49.39,Default,,0,0,0,,Біздің бостандығымызды тартып алған сен! Бұл жолы мен сен адам боламын...
Dialogue: 0,1:07:49.52,1:07:52.86,Default,,0,0,0,,Айдаһардың қаһарынан дәм татайын!
Dialogue: 0,1:07:53.02,1:07:57.36,Default,,0,0,0,,Уау!
Dialogue: 0,1:07:59.03,1:08:00.86,Default,,0,0,0,,Уау!
Dialogue: 0,1:08:01.03,1:08:04.12,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:08:04.28,1:08:09.12,Default,,0,0,0,,(Жыйрау дыбысы)
Dialogue: 0,1:08:09.29,1:08:13.63,Default,,0,0,0,,(Жыйрау дыбысы)
Dialogue: 0,1:08:13.79,1:08:17.13,Default,,0,0,0,,(Жыйрау дыбысы)
Dialogue: 0,1:08:19.51,1:08:22.26,Default,,0,0,0,,Ннн…
Dialogue: 0,1:08:23.18,1:08:24.43,Default,,0,0,0,,Ах...
Dialogue: 0,1:08:25.60,1:08:26.39,Default,,0,0,0,,Ха…
Dialogue: 0,1:08:27.10,1:08:30.31,Default,,0,0,0,,Кук… nnnn…
Dialogue: 0,1:08:30.89,1:08:31.85,Default,,0,0,0,,Ах... Ха...
Dialogue: 0,1:08:33.02,1:08:36.07,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:08:36.19,1:08:39.40,Default,,0,0,0,,Жоқ... Нацу!
Dialogue: 0,1:08:42.49,1:08:43.41,Default,,0,0,0,,Гаха…
Dialogue: 0,1:08:46.20,1:08:47.41,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,1:08:51.21,1:08:52.46,Default,,0,0,0,,Ннн... (жұтыну дыбысы)
Dialogue: 0,1:08:52.58,1:08:58.42,Default,,0,0,0,,Айдаһардың көз жасы, маған қазір толық қуат бер!
Dialogue: 0,1:09:02.88,1:09:03.97,Default,,0,0,0,,(ұшқын дыбысы)
Dialogue: 0,1:09:04.43,1:09:09.27,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:09:09.97,1:09:13.02,Default,,0,0,0,,Айдаһар мен айдаһар өлтіруші арасындағы шайқас...
Dialogue: 0,1:09:13.14,1:09:15.81,Default,,0,0,0,,Осы жерде аяқталды.
Dialogue: 0,1:09:15.94,1:09:19.53,Default,,0,0,0,,Бұдан былай Айдаһарлар дәуірі басталады.
Dialogue: 0,1:09:19.98,1:09:23.03,Default,,0,0,0,,Фухаха... хахахаха!
Dialogue: 0,1:09:23.49,1:09:25.49,Default,,0,0,0,,Мұны тоқтатыңыз, Мәртебелі!
Dialogue: 0,1:09:25.61,1:09:28.78,Default,,0,0,0,,Жолдан кет (Соня) Жоқ, мен жолдан шықпаймын.
Dialogue: 0,1:09:28.91,1:09:31.79,Default,,0,0,0,,Бұл адамдардың бұдан былай зардап шегуіне жол бермеңіз!
Dialogue: 0,1:09:32.50,1:09:33.21,Default,,0,0,0,,Ннн…
Dialogue: 0,1:09:33.33,1:09:37.21,Default,,0,0,0,,Олардың жан дүниесі бір-бірімен тығыз байланысты...
Dialogue: 0,1:09:37.33,1:09:41.26,Default,,0,0,0,,Бұл елді нұрландырған жұлдыздардай жарқырайды
Dialogue: 0,1:09:42.01,1:09:45.34,Default,,0,0,0,,Бірақ ұлы мәртебелі рухы...
Dialogue: 0,1:09:46.89,1:09:50.72,Default,,0,0,0,,Жарқырауын жоғалтып, қараңғылыққа кірді...
Dialogue: 0,1:09:52.85,1:09:57.15,Default,,0,0,0,,Сіз қайырымды адам едіңіз...
Dialogue: 0,1:09:58.98,1:10:01.57,Default,,0,0,0,,Нацу! (Бақытты) Уу... Нацу!
Dialogue: 0,1:10:01.69,1:10:04.57,Default,,0,0,0,,Нацу! Оян!
Dialogue: 0,1:10:04.74,1:10:06.57,Default,,0,0,0,,Нацу~! (жылау)
Dialogue: 0,1:10:07.16,1:10:11.54,Default,,0,0,0,,Оян, Нацу... Нацу! (жылау)
Dialogue: 0,1:10:11.66,1:10:12.58,Default,,0,0,0,,Нацу...
Dialogue: 0,1:10:57.21,1:10:59.96,Default,,0,0,0,,Ннн… ааа…
Dialogue: 0,1:11:00.25,1:11:02.09,Default,,0,0,0,,Нацу! (Бақытты) Нацу!
Dialogue: 0,1:11:02.21,1:11:03.96,Default,,0,0,0,,Хахаха... (Бақытты) Ух...
Dialogue: 0,1:11:05.21,1:11:07.97,Default,,0,0,0,,Ннн… Ннн…
Dialogue: 0,1:11:08.22,1:11:13.68,Default,,0,0,0,,Ол әлі тірі ме? Ол айдаһарды жеңу үшін ғана бар!
Dialogue: 0,1:11:13.81,1:11:15.22,Default,,0,0,0,,Ах!
Dialogue: 0,1:11:18.39,1:11:20.90,Default,,0,0,0,,Уау!
Dialogue: 0,1:11:21.02,1:11:27.36,Default,,0,0,0,,Мен айдаһарды жеңу үшін күресіп жатқан жоқпын.
Dialogue: 0,1:11:28.95,1:11:31.95,Default,,0,0,0,,Достарыңызды қорғаңыз
Dialogue: 0,1:11:33.28,1:11:35.12,Default,,0,0,0,,Дәл сол себепті...
Dialogue: 0,1:11:35.95,1:11:37.66,Default,,0,0,0,,Енді мен...
Dialogue: 0,1:11:37.79,1:11:41.00,Default,,0,0,0,,Біз ұрысып жатырмыз!
Dialogue: 0,1:11:41.17,1:11:44.50,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,1:11:44.63,1:11:46.01,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:11:46.17,1:11:48.01,Default,,0,0,0,,(Айқай)
Dialogue: 0,1:11:48.17,1:11:51.18,Default,,0,0,0,,Уау!
Dialogue: 0,1:11:51.30,1:11:53.01,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,1:11:53.60,1:11:56.43,Default,,0,0,0,,Мен бірде ескі жазбаларда осындай зерттеулерді кездестіргенмін.
Dialogue: 0,1:11:57.56,1:11:58.48,Default,,0,0,0,,Уф!
Dialogue: 0,1:11:59.31,1:12:00.77,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:12:02.48,1:12:06.28,Default,,0,0,0,,(шығарылатын дыбыс)
Dialogue: 0,1:12:07.94,1:12:11.78,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:12:15.78,1:12:18.45,Default,,0,0,0,,Қарғыс атқыр адамдар.
Dialogue: 0,1:12:18.95,1:12:24.79,Default,,0,0,0,,Бұл — «mercy rule» (рақымшылдық ережесі) бойынша ойын сол сәтте тоқтатылатынын ұмытпа
Dialogue: 0,1:12:25.21,1:12:26.30,Default,,0,0,0,,Иә?
Dialogue: 0,1:12:31.38,1:12:32.38,Default,,0,0,0,,Ха…
Dialogue: 0,1:12:37.77,1:12:38.89,Default,,0,0,0,,Ннн…
Dialogue: 0,1:12:39.98,1:12:42.31,Default,,0,0,0,,Сіз де айдаһарсыз ба?
Dialogue: 0,1:12:43.31,1:12:47.27,Default,,0,0,0,,Уау!
Dialogue: 0,1:12:47.40,1:12:48.07,Default,,0,0,0,,Ха…
Dialogue: 0,1:12:48.23,1:12:50.57,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:12:55.78,1:12:57.03,Default,,0,0,0,,Гуаааа!
Dialogue: 0,1:12:57.41,1:12:58.70,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,1:12:58.83,1:13:01.79,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,1:13:02.08,1:13:05.92,Default,,0,0,0,,Мен сіздің шынайы болмысыңызды түсінемін!
Dialogue: 0,1:13:06.34,1:13:11.30,Default,,0,0,0,,Сіз адам емессіз! Бәрін бұзатын EN...
Dialogue: 0,1:13:11.47,1:13:12.67,Default,,0,0,0,,Э-э… Зеницу-сан
Dialogue: 0,1:13:13.76,1:13:16.10,Default,,0,0,0,,Маған сенің кім екенің бәрібір!
Dialogue: 0,1:13:16.89,1:13:20.93,Default,,0,0,0,,Мен бар өмірімді достарыма арнаймын!
Dialogue: 0,1:13:21.10,1:13:24.44,Default,,0,0,0,,Ннн!
Dialogue: 0,1:13:25.15,1:13:28.69,Default,,0,0,0,,Уау!
Dialogue: 0,1:13:29.86,1:13:36.20,Default,,0,0,0,,Қан, ет және сүйек бәрі қажет емес!
Dialogue: 0,1:13:36.37,1:13:37.70,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,1:13:38.37,1:13:41.20,Default,,0,0,0,,Ммм! Апыр-ай!
Dialogue: 0,1:13:41.37,1:13:44.21,Default,,0,0,0,,Уау!
Dialogue: 0,1:13:44.37,1:13:46.96,Default,,0,0,0,,(жаншылған дыбыс)
Dialogue: 0,1:13:47.13,1:13:50.34,Default,,0,0,0,,және оларды туған жерім Италияның асханасына енгіздім.
Dialogue: 0,1:13:51.38,1:13:53.72,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:13:57.14,1:14:01.72,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:14:11.19,1:14:12.11,Default,,0,0,0,,(Біреуді тесіп өткендей дыбыс)
Dialogue: 0,1:14:18.20,1:14:19.24,Default,,0,0,0,,(таяқтың суырылып шыққан дыбысы)
Dialogue: 0,1:14:30.59,1:14:32.25,Default,,0,0,0,,(жаншылған дыбыс)
Dialogue: 0,1:14:39.47,1:14:40.47,Default,,0,0,0,,Ха…
Dialogue: 0,1:14:41.35,1:14:42.76,Default,,0,0,0,,Ах...
Dialogue: 0,1:14:43.10,1:14:44.77,Default,,0,0,0,,Ах...
Dialogue: 0,1:14:45.48,1:14:46.77,Default,,0,0,0,,Ах...
Dialogue: 0,1:14:49.06,1:14:50.27,Default,,0,0,0,,Нацу...
Dialogue: 0,1:14:50.86,1:14:52.77,Default,,0,0,0,,Аспан қалпына келді...
Dialogue: 0,1:14:53.73,1:14:58.28,Default,,0,0,0,,Сіз мұны жасадыңыз ба Fairy Tail?
Dialogue: 0,1:15:04.75,1:15:06.16,Default,,0,0,0,,Ах...
Dialogue: 0,1:15:08.79,1:15:12.29,Default,,0,0,0,,Мм... (Люси) Нацу! Хаха...
Dialogue: 0,1:15:12.75,1:15:14.92,Default,,0,0,0,,Ннн…
Dialogue: 0,1:15:15.05,1:15:19.34,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,1:15:19.47,1:15:21.55,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,1:15:21.72,1:15:23.97,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,1:15:24.10,1:15:28.06,Default,,0,0,0,,Нацу? Хмм... Люси
Dialogue: 0,1:15:28.94,1:15:31.06,Default,,0,0,0,,Ннн… фуфу…
Dialogue: 0,1:15:32.94,1:15:36.69,Default,,0,0,0,,Мен неге ұқсаймын?
Dialogue: 0,1:15:40.66,1:15:42.70,Default,,0,0,0,,Бұл Нацу болуы керек.
Dialogue: 0,1:15:42.87,1:15:46.08,Default,,0,0,0,,А... Аа...
Dialogue: 0,1:15:53.42,1:15:55.34,Default,,0,0,0,,Жоғалу...
Dialogue: 0,1:15:56.30,1:15:59.72,Default,,0,0,0,,Менің денем...
Dialogue: 0,1:16:00.09,1:16:01.22,Default,,0,0,0,,Мәртебелі
Dialogue: 0,1:16:05.26,1:16:08.60,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,1:16:09.64,1:16:11.48,Default,,0,0,0,,Мені өсіргені үшін
Dialogue: 0,1:16:12.06,1:16:13.15,Default,,0,0,0,,Ха…
Dialogue: 0,1:16:15.11,1:16:19.19,Default,,0,0,0,,Соня... Мен сені бірінші рет көріп тұрмын.
Dialogue: 0,1:16:19.82,1:16:21.32,Default,,0,0,0,,Сіздің...
Dialogue: 0,1:16:22.20,1:16:23.49,Default,,0,0,0,,Күлімсіреу
Dialogue: 0,1:16:25.99,1:16:28.66,Default,,0,0,0,,Мен де бірінші рет көрдім
Dialogue: 0,1:16:30.50,1:16:33.92,Default,,0,0,0,,Айдаһардың көз жасы
Dialogue: 0,1:16:36.59,1:16:39.76,Default,,0,0,0,,Уау! Қараңдар! Айдаһардың көз жасы!
Dialogue: 0,1:16:48.10,1:16:49.35,Default,,0,0,0,,Таспа?
Dialogue: 0,1:16:49.47,1:16:52.85,Default,,0,0,0,,Бұл оның бастапқы түрі болды ма?
Dialogue: 0,1:16:52.98,1:16:54.56,Default,,0,0,0,,Бір жерге кетіп қалды.
Dialogue: 0,1:16:54.69,1:16:56.40,Default,,0,0,0,,Ах...
Dialogue: 0,1:16:58.07,1:17:00.36,Default,,0,0,0,,Люси-сан (Люси Хаппи) Иә?
Dialogue: 0,1:17:05.32,1:17:06.83,Default,,0,0,0,,Мәртебелі...
Dialogue: 0,1:17:07.91,1:17:13.67,Default,,0,0,0,,Халық... мені алда, өзіңді алда...
Dialogue: 0,1:17:13.79,1:17:18.09,Default,,0,0,0,,Бұл жағдайды ол өз қалауын қанағаттандыру үшін жасады.
Dialogue: 0,1:17:18.21,1:17:20.30,Default,,0,0,0,,Мен директормын.
Dialogue: 0,1:17:22.17,1:17:24.47,Default,,0,0,0,,Көп адамды ренжітті...
Dialogue: 0,1:17:24.59,1:17:26.55,Default,,0,0,0,,Ннн…
Dialogue: 0,1:17:26.72,1:17:29.97,Default,,0,0,0,,Менің ойымша, ол қорқынышты, бірақ...
Dialogue: 0,1:17:30.60,1:17:34.27,Default,,0,0,0,,Олар мен үшін отбасы сияқты болды.
Dialogue: 0,1:17:36.15,1:17:42.90,Default,,0,0,0,,Мені пайдаланса да, мен сенімен бірге болғаныма қуандым.
Dialogue: 0,1:17:44.86,1:17:47.99,Default,,0,0,0,,Мүмкін болса, басқа жолмен -
Dialogue: 0,1:17:48.58,1:17:54.58,Default,,0,0,0,,Мен бір-бірімізді шын мәнінде қолдайтын қарым-қатынаста күш-қуат көзі болғым келді.
Dialogue: 0,1:17:58.59,1:18:00.59,Default,,0,0,0,,Балалар сендер сияқты
Dialogue: 0,1:18:00.88,1:18:02.71,Default,,0,0,0,,Ақыл-ой сынақтарының атымен—
Dialogue: 0,1:18:02.84,1:18:04.72,Default,,0,0,0,,Мм... (Люси) Уау!
Dialogue: 0,1:18:04.84,1:18:07.72,Default,,0,0,0,,Гильдия да отбасы!
Dialogue: 0,1:18:07.97,1:18:09.47,Default,,0,0,0,,Хехе... Ай!
Dialogue: 0,1:18:09.76,1:18:12.35,Default,,0,0,0,,Хехе... Дұрыс.
Dialogue: 0,1:18:12.77,1:18:15.77,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:18:37.79,1:18:43.80,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,1:22:28.61,1:22:34.61,Default,,0,0,0,,~♪
Dialogue: 0,1:23:02.10,1:23:04.64,Default,,0,0,0,,Көмектесіңіз! маған көмектесші!
Dialogue: 0,1:23:05.10,1:23:06.35,Default,,0,0,0,,Ах!
Dialogue: 0,1:23:08.31,1:23:09.65,Default,,0,0,0,,Бұл сәл ақымақтық емес пе?
Dialogue: 0,1:23:09.77,1:23:13.65,Default,,0,0,0,,Мен мұндай қызға тоймай қала жаздадым.
Dialogue: 0,1:23:16.32,1:23:20.20,Default,,0,0,0,,Мен Айдаһар өлтіруші Акнологиямын
Dialogue: 0,1:23:20.32,1:23:23.41,Default,,0,0,0,,Енді мен сендерді айдаһарларды құртамын!
Dialogue: 0,1:23:23.58,1:23:26.41,Default,,0,0,0,,Гуаааа!
Dialogue: 0,1:23:40.55,1:23:43.39,Default,,0,0,0,,Мен сені қорғай алмағаным үшін кешір.
Dialogue: 0,1:23:45.10,1:23:48.81,Default,,0,0,0,,Айдаһар менің барлығымды жояды.
Dialogue: 0,1:23:50.77,1:23:54.94,Default,,0,0,0,,Акнология... Ннн...
Dialogue: 0,1:23:55.53,1:23:59.53,Default,,0,0,0,,Менің әлі өлгім келмейді...
Dialogue: 0,1:23:59.65,1:24:01.45,Default,,0,0,0,,Жарайды, операцияны басынан бастауға тура келеді.
Dialogue: 0,1:24:01.78,1:24:06.79,Default,,0,0,0,,Хмм... бұл кішкентай қыз әлі тірі...
Dialogue: 0,1:24:09.16,1:24:12.46,Default,,0,0,0,,Кішкентай қыз... атыңды айтшы
Dialogue: 0,1:24:12.58,1:24:16.71,Default,,0,0,0,,Олай болса, сен де, мен де аман қалуымыз мүмкін.
Dialogue: 0,1:24:17.42,1:24:20.43,Default,,0,0,0,,Ах... Соня
Dialogue: 0,1:24:26.56,1:24:28.14,Default,,0,0,0,,Ақымақ
Dialogue: 0,1:24:33.73,1:24:35.86,Default,,0,0,0,,Бұл Акнология
Dialogue: 0,1:24:35.98,1:24:37.98,Default,,0,0,0,,Біздің жаулар
Dialogue: 0,1:24:40.99,1:24:44.82,Default,,0,0,0,,Нацумен шайқас басталады
Dialogue: 0,1:24:46.32,1:24:52.32,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory