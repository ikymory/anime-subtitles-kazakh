Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.50,0:00:05.83,Default,,0,0,0,,Түсіндім, бұл аңыз
Dialogue: 0,0:00:06.84,0:00:08.88,Default,,0,0,0,,Бұл біз туралы болды.
Dialogue: 0,0:00:13.34,0:00:15.26,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:00:16.34,0:00:20.39,Default,,0,0,0,,Суханың бізбен байланысы көп болды ма?
Dialogue: 0,0:00:21.18,0:00:21.89,Default,,0,0,0,,О
Dialogue: 0,0:00:21.98,0:00:24.56,Default,,0,0,0,,Сонымен, біз алғаш кездескен кезден бастап
Dialogue: 0,0:00:24.64,0:00:26.06,Default,,0,0,0,,Менің ойымша, бұл мені қызықтырды.
Dialogue: 0,0:00:26.15,0:00:28.61,Default,,0,0,0,,Дарданның қолынан маржа
Dialogue: 0,0:00:28.69,0:00:30.82,Default,,0,0,0,,Ол бізді қорғады.
Dialogue: 0,0:00:30.90,0:00:34.11,Default,,0,0,0,,Сіз Джака Суханың энергиясын сезіне аласыз ба?
Dialogue: 0,0:00:34.61,0:00:36.95,Default,,0,0,0,,Бұл емес...
Dialogue: 0,0:00:37.03,0:00:37.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:38.62,0:00:41.70,Default,,0,0,0,,Энергияның соншалықты әлсіреуінің екі ғана себебі бар.
Dialogue: 0,0:00:42.20,0:00:45.17,Default,,0,0,0,,Сіз есін жоғалттыңыз ба?
Dialogue: 0,0:00:46.04,0:00:47.25,Default,,0,0,0,,Тірі емес пе?
Dialogue: 0,0:00:48.13,0:00:50.21,Default,,0,0,0,,Мен не істеп жүр едім?
Dialogue: 0,0:00:50.71,0:00:53.47,Default,,0,0,0,,Мен Суханы қалай болса да қорғауым керек болды.
Dialogue: 0,0:00:53.55,0:00:55.84,Default,,0,0,0,,Ванфилд үйіне барайық
Dialogue: 0,0:00:55.93,0:00:57.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:58.93,0:01:02.85,Default,,0,0,0,,Дардан ана жақтағы нәрседен кейін келуі мүмкін.
Dialogue: 0,0:01:03.43,0:01:04.23,Default,,0,0,0,,Қый!
Dialogue: 0,0:01:04.98,0:01:07.52,Default,,0,0,0,,Ежелгі Балг патшалығы туралы шиыршықтар
Dialogue: 0,0:01:07.60,0:01:08.56,Default,,0,0,0,,Вионис.
Dialogue: 0,0:01:09.61,0:01:10.73,Default,,0,0,0,,Вионис…
Dialogue: 0,0:01:11.23,0:01:13.57,Default,,0,0,0,,Патшалық әлдеқашан жойылды.
Dialogue: 0,0:01:13.65,0:01:16.99,Default,,0,0,0,,Құпияны санаулылар ғана білді
Dialogue: 0,0:01:17.07,0:01:19.53,Default,,0,0,0,,Дарданның билікке жетуі үшін
Dialogue: 0,0:01:19.62,0:01:22.49,Default,,0,0,0,,Мен бұл құпияны алуым керек.
Dialogue: 0,0:01:32.84,0:01:36.01,Default,,0,0,0,,Мен сендермен қайта осылай кездесемін деп ойламаппын.
Dialogue: 0,0:01:36.93,0:01:39.59,Default,,0,0,0,,Мен оларды ханшайымның жинағанына сенімдімін.
Dialogue: 0,0:01:40.80,0:01:42.76,Default,,0,0,0,,Суханың тірі екені сөзсіз
Dialogue: 0,0:01:42.85,0:01:45.43,Default,,0,0,0,,Қандай жағдай болмасын бізді тауып, құтқар
Dialogue: 0,0:01:45.52,0:01:46.77,Default,,0,0,0,,Иә
Dialogue: 0,0:01:48.81,0:01:50.81,Default,,0,0,0,,♪～
Dialogue: 0,0:03:15.48,0:03:17.48,Default,,0,0,0,,～♪
Dialogue: 0,0:03:31.62,0:03:35.50,Default,,0,0,0,,Қайтадан келгеніңіз қызық.
Dialogue: 0,0:03:35.59,0:03:38.38,Default,,0,0,0,,А, бұл да бізден.
Dialogue: 0,0:03:46.76,0:03:47.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:53.65,0:03:55.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:57.65,0:03:59.44,Default,,0,0,0,,Вионис жоғалып кетті!
Dialogue: 0,0:03:59.53,0:04:01.19,Default,,0,0,0,,Бұл қандай ойын-сауық?
Dialogue: 0,0:04:01.28,0:04:04.45,Default,,0,0,0,,Жоқ, ол әлі сарайда болуы мүмкін.
Dialogue: 0,0:04:04.53,0:04:06.12,Default,,0,0,0,,Қолды бөлейік
Dialogue: 0,0:04:06.20,0:04:07.78,Default,,0,0,0,,Мен жатын бөлмедемін
Dialogue: 0,0:04:07.87,0:04:09.24,Default,,0,0,0,,Үшінші қабатқа қараңыз
Dialogue: 0,0:04:11.75,0:04:13.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:16.79,0:04:17.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:25.51,0:04:27.60,Default,,0,0,0,,Барлығыңыз ортақ бөлмеге келіңіздер!
Dialogue: 0,0:04:28.68,0:04:31.60,Default,,0,0,0,,Укк... охх...
Dialogue: 0,0:04:31.68,0:04:33.77,Default,,0,0,0,,- Жака! -Аа...
Dialogue: 0,0:04:33.85,0:04:35.52,Default,,0,0,0,,Бұл жалғыз қалды.
Dialogue: 0,0:04:35.60,0:04:37.27,Default,,0,0,0,,Ян мені ұстап алды... Ха!
Dialogue: 0,0:04:37.90,0:04:38.40,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:39.40,0:04:42.57,Default,,0,0,0,,Сарайдың ішінде Мардждың белгісі жоқ.
Dialogue: 0,0:04:42.65,0:04:44.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:48.83,0:04:49.95,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:04:50.03,0:04:51.74,Default,,0,0,0,,Маржды қайдан алдың?
Dialogue: 0,0:04:51.83,0:04:52.87,Default,,0,0,0,,Сен бұны істей аласың ба?
Dialogue: 0,0:04:52.95,0:04:54.58,Default,,0,0,0,,Дарданның аманаты?
Dialogue: 0,0:04:54.66,0:04:56.25,Default,,0,0,0,,Менің достарым қайда кетті?
Dialogue: 0,0:04:56.33,0:04:57.75,Default,,0,0,0,,Гуах! Уф...
Dialogue: 0,0:04:57.83,0:04:59.13,Default,,0,0,0,,Мен сұраймын
Dialogue: 0,0:05:00.71,0:05:04.47,Default,,0,0,0,,Балалар Суха мен Марджды қайда апардыңдар?
Dialogue: 0,0:05:05.97,0:05:07.89,Default,,0,0,0,,U… Uu…
Dialogue: 0,0:05:07.97,0:05:09.05,Default,,0,0,0,,Чи…
Dialogue: 0,0:05:09.14,0:05:11.64,Default,,0,0,0,,Ұрланған Вионисті қайда апардың?
Dialogue: 0,0:05:11.72,0:05:13.14,Default,,0,0,0,,Гуа~!
Dialogue: 0,0:05:13.22,0:05:14.73,Default,,0,0,0,,Жауап!
Dialogue: 0,0:05:15.23,0:05:16.89,Default,,0,0,0,,Ааа!
Dialogue: 0,0:05:17.48,0:05:19.15,Default,,0,0,0,,Принтер қажет емес…
Dialogue: 0,0:05:19.73,0:05:21.07,Default,,0,0,0,,Принтер қажет пе?
Dialogue: 0,0:05:21.15,0:05:23.32,Default,,0,0,0,,Бұл жерден өте алыс.
Dialogue: 0,0:05:23.40,0:05:25.86,Default,,0,0,0,,Printer Neer бағдарламасында не бар?
Dialogue: 0,0:05:25.95,0:05:28.03,Default,,0,0,0,,Дардан да сонда ма?
Dialogue: 0,0:05:28.91,0:05:32.04,Default,,0,0,0,,Бұл батпақта ауа өте аз.
Dialogue: 0,0:05:34.41,0:05:35.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:38.67,0:05:40.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:42.75,0:05:43.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:50.93,0:05:52.89,Default,,0,0,0,,Цк... ақымақ.
Dialogue: 0,0:05:52.97,0:05:55.56,Default,,0,0,0,,Сіз мені бірден өлтіруіңіз керек еді.
Dialogue: 0,0:05:56.06,0:05:58.77,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:06:01.36,0:06:05.03,Default,,0,0,0,,Бұл жолы біз бір бола аламыз.
Dialogue: 0,0:06:07.32,0:06:08.57,Default,,0,0,0,,«Бұл патшалық»
Dialogue: 0,0:06:08.65,0:06:12.53,Default,,0,0,0,,«Шаман қанын мұра еткендер ұрпақтар бойы патша болды».
Dialogue: 0,0:06:12.62,0:06:15.62,Default,,0,0,0,,«Патша тағынан кеткенде»
Dialogue: 0,0:06:15.70,0:06:19.50,Default,,0,0,0,,«Айдың құрбандық үстелінде барлық күш-қуатыңызды бекітіңіз»
Dialogue: 0,0:06:19.58,0:06:24.55,Default,,0,0,0,,«Ол толған ай түніндегі рәсім арқылы келесі патшаға берілді».
Dialogue: 0,0:06:27.22,0:06:29.09,Default,,0,0,0,,Толық ай түні
Dialogue: 0,0:06:29.59,0:06:32.55,Default,,0,0,0,,Сізге рахмет, құрбандық үстеліндегі мөрді бұзуға болады.
Dialogue: 0,0:06:33.18,0:06:36.31,Default,,0,0,0,,Сонда мен сол билікті мұраға аламын.
Dialogue: 0,0:06:36.39,0:06:38.81,Default,,0,0,0,,Жаңа патша болыңыз
Dialogue: 0,0:06:40.35,0:06:44.40,Default,,0,0,0,,Баргтың қанын алсаңыз болғаны...
Dialogue: 0,0:06:46.15,0:06:50.66,Default,,0,0,0,,Бұл жолы менде барлығы бар екенін көрсетемін
Dialogue: 0,0:06:51.66,0:06:54.62,Default,,0,0,0,,(Найзағай дыбысы)
Dialogue: 0,0:06:57.70,0:07:00.54,Default,,0,0,0,,Құлаған отбасына қарамастан
Dialogue: 0,0:07:00.62,0:07:03.63,Default,,0,0,0,,Мен осы елдің премьер-министрі лауазымына көтерілдім.
Dialogue: 0,0:07:06.25,0:07:09.80,Default,,0,0,0,,Сонда да жер бетінде не жетіспейді!
Dialogue: 0,0:07:15.93,0:07:17.64,Default,,0,0,0,,Әдемі селен
Dialogue: 0,0:07:17.72,0:07:20.31,Default,,0,0,0,,Мен сені міндетті түрде аламын!
Dialogue: 0,0:07:20.39,0:07:21.48,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:07:22.40,0:07:22.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:23.06,0:07:25.48,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:07:31.07,0:07:32.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:39.08,0:07:41.16,Default,,0,0,0,,Балгтың қаны!
Dialogue: 0,0:07:43.29,0:07:46.38,Default,,0,0,0,,Дардан! Онда не істеп жүрсің?
Dialogue: 0,0:07:46.88,0:07:47.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:47.92,0:07:49.59,Default,,0,0,0,,Вионистен аулақ болыңыз!
Dialogue: 0,0:07:51.55,0:07:52.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:52.97,0:07:56.39,Default,,0,0,0,,Бұл тек патша отбасы мүшелерінің оқуына рұқсат етілмеген нәрсе!
Dialogue: 0,0:07:56.47,0:07:59.10,Default,,0,0,0,,Күй күйі...
Dialogue: 0,0:07:59.18,0:08:00.73,Default,,0,0,0,,Бұл тағы да солай ма?
Dialogue: 0,0:08:01.23,0:08:02.56,Default,,0,0,0,,Мен одан шаршадым!
Dialogue: 0,0:08:02.64,0:08:05.27,Default,,0,0,0,,Сіз не жоспарлап отырсыз?
Dialogue: 0,0:08:05.35,0:08:08.32,Default,,0,0,0,,Мен тек билік алғым келеді
Dialogue: 0,0:08:08.40,0:08:10.44,Default,,0,0,0,,Сол себепті тыйым салынған кітаптар...
Dialogue: 0,0:08:10.94,0:08:12.86,Default,,0,0,0,,Бұл қабылданбайды!
Dialogue: 0,0:08:12.95,0:08:14.28,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:08:14.36,0:08:15.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:18.12,0:08:19.45,Default,,0,0,0,,Тыйым салынған кітап дегеніміз не?
Dialogue: 0,0:08:19.54,0:08:22.91,Default,,0,0,0,,Корольдік әулет билікті монополиялау үшін мұны істеген болуы керек!
Dialogue: 0,0:08:24.08,0:08:26.04,Default,,0,0,0,,Енді бәрі жақсы!
Dialogue: 0,0:08:26.13,0:08:27.75,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:31.71,0:08:33.55,Default,,0,0,0,,Балгтың қаны...
Dialogue: 0,0:08:35.76,0:08:38.51,Default,,0,0,0,,Селен! Сіз байқадыңыз ба?
Dialogue: 0,0:08:38.60,0:08:41.97,Default,,0,0,0,,Ой, жақсы... қазір бәрі жақсы.
Dialogue: 0,0:08:42.06,0:08:43.48,Default,,0,0,0,,Ана…
Dialogue: 0,0:08:44.06,0:08:46.56,Default,,0,0,0,,Мен Балг құдайымен таныстым
Dialogue: 0,0:08:46.65,0:08:50.94,Default,,0,0,0,,А... Құдай Балг, көп рахмет.
Dialogue: 0,0:08:52.53,0:08:55.32,Default,,0,0,0,,Ха... неге?
Dialogue: 0,0:08:55.40,0:08:58.07,Default,,0,0,0,,Қанша сорсам да, Шөлдеймін.
Dialogue: 0,0:08:58.16,0:09:01.70,Default,,0,0,0,,Біраз ғана күн сәулесі...
Dialogue: 0,0:09:01.79,0:09:04.96,Default,,0,0,0,,Ханшайыммен бірдей Баргтың қанын ішсем де!
Dialogue: 0,0:09:05.04,0:09:06.50,Default,,0,0,0,,Саны жеткіліксіз болды ма?
Dialogue: 0,0:09:06.58,0:09:09.25,Default,,0,0,0,,Әлде бақсының күші жоқ па?
Dialogue: 0,0:09:09.34,0:09:13.46,Default,,0,0,0,,Сол кезде мен Вионистің барлығын оқыған болсам...
Dialogue: 0,0:09:13.55,0:09:15.72,Default,,0,0,0,,Неліктен мен
Dialogue: 0,0:09:15.80,0:09:18.80,Default,,0,0,0,,Сіз мінсіз вампир бола алмайсыз!
Dialogue: 0,0:09:21.22,0:09:24.81,Default,,0,0,0,,(Куроива) Баршаңызға (тергеушілерге) Ах…
Dialogue: 0,0:09:34.90,0:09:38.41,Default,,0,0,0,,Неліктен мен мұны барлығына жасауым керек?
Dialogue: 0,0:09:38.49,0:09:40.20,Default,,0,0,0,,Себебі тас-қағаз-қайшы әлсіз.
Dialogue: 0,0:09:40.28,0:09:41.53,Default,,0,0,0,,Гррр…
Dialogue: 0,0:09:42.79,0:09:43.79,Default,,0,0,0,,Эй
Dialogue: 0,0:09:44.91,0:09:46.37,Default,,0,0,0,,О... не?
Dialogue: 0,0:09:46.46,0:09:47.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:50.46,0:09:51.63,Default,,0,0,0,,Махан!
Dialogue: 0,0:09:55.34,0:09:58.30,Default,,0,0,0,,Не болды? Ал Камил мен Руслан ше?
Dialogue: 0,0:09:58.80,0:09:59.76,Default,,0,0,0,,Ұсталды
Dialogue: 0,0:09:59.84,0:10:01.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:02.18,0:10:03.68,Default,,0,0,0,,Принтер Neer
Dialogue: 0,0:10:03.76,0:10:05.77,Default,,0,0,0,,«Рейлгун» деп аталатын бар болды.
Dialogue: 0,0:10:06.27,0:10:09.40,Default,,0,0,0,,Вампирлер келіп-кетіп жатыр дегенді естіп, жасырын жүрдім.
Dialogue: 0,0:10:10.10,0:10:13.27,Default,,0,0,0,,Бірақ бұл вампирлер үйі болды.
Dialogue: 0,0:10:14.28,0:10:16.78,Default,,0,0,0,,Сіз оны жеңдім деп ойласаңыз
Dialogue: 0,0:10:16.86,0:10:19.45,Default,,0,0,0,,Ол келді.
Dialogue: 0,0:10:25.08,0:10:28.54,Default,,0,0,0,,Оянсам, бір жерде қоймада екенмін.
Dialogue: 0,0:10:29.46,0:10:32.00,Default,,0,0,0,,Танжиро~!
Dialogue: 0,0:10:32.50,0:10:34.30,Default,,0,0,0,,Камил! Руслан!
Dialogue: 0,0:10:34.38,0:10:36.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:39.13,0:10:43.26,Default,,0,0,0,,Онда көптеген қасқырлар қамалған.
Dialogue: 0,0:10:44.14,0:10:45.72,Default,,0,0,0,,Не үшін?
Dialogue: 0,0:10:45.81,0:10:48.52,Default,,0,0,0,,Нақты мақсат жоқ
Dialogue: 0,0:10:49.02,0:10:53.90,Default,,0,0,0,,Мен қашып құтылдым, бірақ Камил мен Русланнан көз алдымнан кетті...
Dialogue: 0,0:10:54.69,0:10:56.19,Default,,0,0,0,,Бұл сенің кінәң емес
Dialogue: 0,0:10:56.69,0:10:58.03,Default,,0,0,0,,Сізді қайта көргеніме қуаныштымын
Dialogue: 0,0:10:58.11,0:11:01.53,Default,,0,0,0,,Махан: Мен сені сол қоймаға апарсам болады ма?
Dialogue: 0,0:11:02.11,0:11:03.03,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:11:03.12,0:11:04.53,Default,,0,0,0,,Қазір кетейік
Dialogue: 0,0:11:05.03,0:11:07.08,Default,,0,0,0,,Мен Камил мен Русланға көмектесемін.
Dialogue: 0,0:11:12.58,0:11:14.50,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:17.59,0:11:18.51,Default,,0,0,0,,Суха!
Dialogue: 0,0:11:19.34,0:11:20.09,Default,,0,0,0,,Тікұшақ
Dialogue: 0,0:11:20.17,0:11:21.01,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:22.34,0:11:23.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:27.60,0:11:29.64,Default,,0,0,0,,Суха! Уф...
Dialogue: 0,0:11:30.14,0:11:30.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:30.85,0:11:33.27,Default,,0,0,0,,Суха! Сенімен бәрі жақсы ма?
Dialogue: 0,0:11:34.90,0:11:37.53,Default,,0,0,0,,Ай... алтарь
Dialogue: 0,0:11:37.61,0:11:38.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:40.57,0:11:43.99,Default,,0,0,0,,Сол қылыш... айдың құрбандық үстелінде
Dialogue: 0,0:11:44.49,0:11:45.87,Default,,0,0,0,,Қылыш?
Dialogue: 0,0:11:47.99,0:11:48.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:48.87,0:11:52.29,Default,,0,0,0,,Суха~!
Dialogue: 0,0:11:52.37,0:11:53.54,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:55.00,0:11:57.29,Default,,0,0,0,,Енді түсімде Суха...
Dialogue: 0,0:11:57.80,0:11:59.17,Default,,0,0,0,,Хэм (Субару) Ааах!
Dialogue: 0,0:11:59.26,0:12:00.30,Default,,0,0,0,,Мен де көрдім!
Dialogue: 0,0:12:00.88,0:12:02.93,Default,,0,0,0,,Мен бейтаныс жерде болдым.
Dialogue: 0,0:12:03.01,0:12:06.01,Default,,0,0,0,,Қараңғы үңгір тәрізді жерде
Dialogue: 0,0:12:06.10,0:12:08.51,Default,,0,0,0,,жатып қалды
Dialogue: 0,0:12:10.02,0:12:13.02,Default,,0,0,0,,Суха, сен «сол қылыш» дедің.
Dialogue: 0,0:12:14.02,0:12:17.48,Default,,0,0,0,,Сол қылыш... айдың құрбандық үстелінде
Dialogue: 0,0:12:39.21,0:12:40.30,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:12:40.88,0:12:43.09,Default,,0,0,0,,Джака Суханың энергиясы қандай?
Dialogue: 0,0:12:43.59,0:12:46.22,Default,,0,0,0,,Оны Мардж да, Дардан да сезбейді.
Dialogue: 0,0:12:46.80,0:12:49.72,Default,,0,0,0,,Осындай жерде шынымен вион бар ма?
Dialogue: 0,0:12:49.81,0:12:53.02,Default,,0,0,0,,Бірақ оның сәйкестігі болды
Dialogue: 0,0:12:53.10,0:12:54.31,Default,,0,0,0,,Бұл бір нәрсені білдіреді.
Dialogue: 0,0:12:54.39,0:12:58.11,Default,,0,0,0,,Барлығы сақ болыңдар, бұл жерде бір нәрсе бар.
Dialogue: 0,0:12:58.77,0:13:02.15,Default,,0,0,0,,Мен ол жерден орасан зор энергияның келетінін сеземін.
Dialogue: 0,0:13:02.65,0:13:05.24,Default,,0,0,0,,Бұл менің бұрын көргенімнен мүлдем басқаша.
Dialogue: 0,0:13:11.66,0:13:13.25,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:13:13.83,0:13:16.04,Default,,0,0,0,,Не, мұнда ешкім жоқ па?
Dialogue: 0,0:13:16.54,0:13:18.25,Default,,0,0,0,,Ашық емес пе?
Dialogue: 0,0:13:18.83,0:13:20.71,Default,,0,0,0,,Бірақ есік ашық болды.
Dialogue: 0,0:13:20.79,0:13:21.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:22.46,0:13:23.17,Default,,0,0,0,,Сол жерде
Dialogue: 0,0:13:24.17,0:13:26.30,Default,,0,0,0,,Оның энергиясы сол жерден келеді.
Dialogue: 0,0:13:37.65,0:13:39.27,Default,,0,0,0,,Қойма?
Dialogue: 0,0:13:44.53,0:13:46.65,Default,,0,0,0,,Алдымнан мүлде көрінбейді.
Dialogue: 0,0:13:46.74,0:13:49.57,Default,,0,0,0,,Тұман жиналып тұрғандай.
Dialogue: 0,0:13:49.66,0:13:51.28,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:13:51.37,0:13:52.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:55.08,0:13:56.16,Default,,0,0,0,,Тұтқынға түсті!
Dialogue: 0,0:13:56.25,0:13:56.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:56.83,0:13:58.50,Default,,0,0,0,,Мен жасап көремін
Dialogue: 0,0:13:59.08,0:14:00.04,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:00.84,0:14:03.25,Default,,0,0,0,,Егер ол ашылмаса, есікті ашыңыз...
Dialogue: 0,0:14:05.13,0:14:06.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:07.13,0:14:09.30,Default,,0,0,0,,…
Dialogue: 0,0:14:09.39,0:14:11.80,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:14:11.89,0:14:13.22,Default,,0,0,0,,Күлкілі
Dialogue: 0,0:14:13.72,0:14:14.81,Default,,0,0,0,,Қараңғы түсуге аз қалды.
Dialogue: 0,0:14:14.89,0:14:19.81,Default,,0,0,0,,(Барлығы ауыр тыныс алады)
Dialogue: 0,0:14:21.31,0:14:22.65,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:14:22.73,0:14:23.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:24.48,0:14:27.82,Default,,0,0,0,,Мен сендерді осында міндетті түрде келеді деп ойладым.
Dialogue: 0,0:14:27.90,0:14:30.82,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:14:30.91,0:14:32.45,Default,,0,0,0,,Бұл тұман
Dialogue: 0,0:14:32.53,0:14:35.45,Default,,0,0,0,,Бұл сізді ұйықтату туралы ғана емес.
Dialogue: 0,0:14:35.95,0:14:38.96,Default,,0,0,0,,Ол бүкіл денеңіздің қуатын бірден сіңіреді.
Dialogue: 0,0:14:39.04,0:14:40.71,Default,,0,0,0,,Барлығы сыртқа шығыңыз!
Dialogue: 0,0:14:40.79,0:14:42.21,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:42.29,0:14:43.92,Default,,0,0,0,,Уф... ашық!
Dialogue: 0,0:14:44.59,0:14:45.63,Default,,0,0,0,,Хаа…
Dialogue: 0,0:14:45.71,0:14:46.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:46.51,0:14:49.43,Default,,0,0,0,,(Вампирлердің ырылдауы)
Dialogue: 0,0:14:49.51,0:14:50.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:50.76,0:14:53.18,Default,,0,0,0,,Гаааааах
Dialogue: 0,0:15:02.52,0:15:04.32,Default,,0,0,0,,Ай толған кезде
Dialogue: 0,0:15:04.40,0:15:08.24,Default,,0,0,0,,Сіз осы құрбандық үстелінде барлық күшке ие боласыз.
Dialogue: 0,0:15:09.65,0:15:13.20,Default,,0,0,0,,Бірақ бәрі менікі болады.
Dialogue: 0,0:15:16.83,0:15:21.92,Default,,0,0,0,,Ол кезде сенде билік, менде махаббат бар еді.
Dialogue: 0,0:15:22.42,0:15:23.96,Default,,0,0,0,,Бұл өмірде керісінше.
Dialogue: 0,0:15:24.59,0:15:28.34,Default,,0,0,0,,Менде билік болса, сенде махаббат болса екен.
Dialogue: 0,0:15:31.43,0:15:32.59,Default,,0,0,0,,Толық шоғырлану: Суда демалу!
Dialogue: 0,0:15:32.68,0:15:34.60,Default,,0,0,0,,Сіз дәл қазіргі дыбысты естідіңіз ғой, иә?
Dialogue: 0,0:15:35.18,0:15:36.06,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:36.14,0:15:37.89,Default,,0,0,0,,Ян, тез қаш!
Dialogue: 0,0:15:37.97,0:15:39.52,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:40.27,0:15:42.19,Default,,0,0,0,,- (Вампир) Гуаа! -Уф...
Dialogue: 0,0:15:42.27,0:15:43.69,Default,,0,0,0,,Қуат...
Dialogue: 0,0:15:43.77,0:15:45.40,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,0:15:47.82,0:15:48.48,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:49.36,0:15:50.99,Default,,0,0,0,,Дөңгелек…
Dialogue: 0,0:15:51.07,0:15:53.66,Default,,0,0,0,,Тәтті, мен өзгергім келсе де...
Dialogue: 0,0:15:54.53,0:15:57.33,Default,,0,0,0,,Мен тұманды басқаратын жігітті жеңуім керек.
Dialogue: 0,0:15:57.41,0:15:58.99,Default,,0,0,0,,Джака Оның орналасқан жері!
Dialogue: 0,0:16:00.00,0:16:00.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:02.58,0:16:03.37,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,0:16:03.46,0:16:04.58,Default,,0,0,0,,Аһ!
Dialogue: 0,0:16:05.96,0:16:07.92,Default,,0,0,0,,Сендер тым талапшылсыңдар — менің кимоном мүлдем кір емес.
Dialogue: 0,0:16:08.00,0:16:10.97,Default,,0,0,0,,Балалар, енді сендерде күш болмайды.
Dialogue: 0,0:16:11.05,0:16:12.97,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:16:13.05,0:16:16.97,Default,,0,0,0,,(Барлығы ауыр тыныс алады)
Dialogue: 0,0:16:18.10,0:16:19.47,Default,,0,0,0,,- (Суханың дауысы) Хери - Ах...
Dialogue: 0,0:16:20.06,0:16:21.98,Default,,0,0,0,,- (Суханың дауысы) Солон - А...
Dialogue: 0,0:16:22.06,0:16:24.40,Default,,0,0,0,,- (Суханың дауысы) Шион - Ах...
Dialogue: 0,0:16:24.48,0:16:26.73,Default,,0,0,0,,- (Суханың дауысы) Джино - А...
Dialogue: 0,0:16:26.81,0:16:28.90,Default,,0,0,0,,- (Суханың дауысы) Ян - А...
Dialogue: 0,0:16:28.98,0:16:30.86,Default,,0,0,0,,- (Суханың дауысы) Жака - А...
Dialogue: 0,0:16:30.94,0:16:33.15,Default,,0,0,0,,- (Суханың дауысы) Нұх - А...
Dialogue: 0,0:16:35.45,0:16:36.82,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:16:41.50,0:16:44.79,Default,,0,0,0,,Енді сіз вампир лордтарысыз.
Dialogue: 0,0:17:02.06,0:17:03.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:05.06,0:17:06.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:07.06,0:17:08.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:09.06,0:17:10.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:11.07,0:17:12.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:13.07,0:17:14.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:15.07,0:17:16.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:17.07,0:17:18.99,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:19.91,0:17:20.99,Default,,0,0,0,,Уф! Ха!
Dialogue: 0,0:17:22.08,0:17:23.41,Default,,0,0,0,,Сонымен бірге ол фонды да бір уақытта салып жатыр!
Dialogue: 0,0:17:24.41,0:17:24.96,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:26.79,0:17:27.75,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:28.33,0:17:29.59,Default,,0,0,0,,- (Вампир) Гааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:17:31.38,0:17:35.38,Default,,0,0,0,,Неліктен? Неліктен бұл жігіттер өз күштерін қалпына келтірді?
Dialogue: 0,0:17:35.47,0:17:37.59,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:17:37.68,0:17:38.84,Default,,0,0,0,,Хааах!
Dialogue: 0,0:17:40.14,0:17:42.18,Default,,0,0,0,,Ха... тұман қалыңдап кетті!
Dialogue: 0,0:17:42.26,0:17:44.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:44.27,0:17:47.06,Default,,0,0,0,,Сіз қалай ойлайсыз? Мен қазір қозғала алмаймын.
Dialogue: 0,0:17:48.65,0:17:50.44,Default,,0,0,0,,-(Тұман жау) бұл... -Ұстадым!
Dialogue: 0,0:17:50.52,0:17:53.19,Default,,0,0,0,,-Осылай! Уф... - (тұман жау) Уф...
Dialogue: 0,0:17:53.28,0:17:54.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:55.61,0:17:57.65,Default,,0,0,0,,Танжиро! Сақ бол!
Dialogue: 0,0:17:58.99,0:18:00.03,Default,,0,0,0,,Аһ!
Dialogue: 0,0:18:01.03,0:18:03.12,Default,,0,0,0,,Зеницу, мені ойлама.
Dialogue: 0,0:18:05.12,0:18:07.54,Default,,0,0,0,,Гяаах!
Dialogue: 0,0:18:13.63,0:18:15.63,Default,,0,0,0,,Тұман басылады
Dialogue: 0,0:18:18.72,0:18:21.30,Default,,0,0,0,,Не? Бірден құладым
Dialogue: 0,0:18:21.39,0:18:23.31,Default,,0,0,0,,Сіз оны өлтіргеніңіз үшін бе?
Dialogue: 0,0:18:24.01,0:18:26.48,Default,,0,0,0,,Өйткені ол өзі тістеген және жасаған вампир.
Dialogue: 0,0:18:26.56,0:18:28.31,Default,,0,0,0,,Өлім де байланысты болуы керек.
Dialogue: 0,0:18:28.39,0:18:29.94,Default,,0,0,0,,Барлығы жақсы ма?
Dialogue: 0,0:18:30.02,0:18:30.81,Default,,0,0,0,,О
Dialogue: 0,0:18:31.65,0:18:35.57,Default,,0,0,0,,Бұл менің қолымда пайда болды деп ойлағанымда, мен есімді жидым.
Dialogue: 0,0:18:35.65,0:18:39.45,Default,,0,0,0,,Негізі мен бұрынғыдан жеңілірек болдым.
Dialogue: 0,0:18:39.53,0:18:42.32,Default,,0,0,0,,Менің де күш-қуатым күшейген сияқты.
Dialogue: 0,0:18:42.41,0:18:46.08,Default,,0,0,0,,Осы ойға келген сәтте қасқырға айналдым.
Dialogue: 0,0:18:46.16,0:18:50.46,Default,,0,0,0,,Мен Суха... бізге көмектесіп тұрғандай сезінемін.
Dialogue: 0,0:18:50.54,0:18:51.71,Default,,0,0,0,,Иә
Dialogue: 0,0:18:51.79,0:18:52.88,Default,,0,0,0,,(шу)
Dialogue: 0,0:18:53.38,0:18:53.96,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:18:55.46,0:18:56.92,Default,,0,0,0,,Жылдамдықтан гөрі сабыр сақтауды басты ұстаным ет.
Dialogue: 0,0:18:57.01,0:18:59.13,Default,,0,0,0,,Достарың қайда кетті?
Dialogue: 0,0:18:59.22,0:19:01.64,Default,,0,0,0,,Ааааа…
Dialogue: 0,0:19:01.72,0:19:04.39,Default,,0,0,0,,Король… Сарай…
Dialogue: 0,0:19:04.47,0:19:05.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:10.85,0:19:12.86,Default,,0,0,0,,Сіз бұрынғы патша сарайын айтасыз ба?
Dialogue: 0,0:19:13.36,0:19:15.44,Default,,0,0,0,,Мың жыл бұрын болса да.
Dialogue: 0,0:19:15.94,0:19:20.20,Default,,0,0,0,,Патша сарайы қазір осы жерде болса керек.
Dialogue: 0,0:19:22.03,0:19:23.95,Default,,0,0,0,,Автоматты?
Dialogue: 0,0:19:24.62,0:19:27.37,Default,,0,0,0,,Патша сарайының қирандылары қазір қалалық әкімдік болып табылады.
Dialogue: 0,0:19:34.63,0:19:35.67,Default,,0,0,0,,Қылыш…
Dialogue: 0,0:19:35.75,0:19:37.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:37.25,0:19:42.09,Default,,0,0,0,,Мен соңғы рет патша сарайында Дарданмен соғысқанда қылыш ұстадым.
Dialogue: 0,0:19:43.43,0:19:44.97,Default,,0,0,0,,Мүмкін...
Dialogue: 0,0:19:49.10,0:19:50.06,Default,,0,0,0,,(қосқышты басқан дыбыс)
Dialogue: 0,0:19:51.77,0:19:54.65,Default,,0,0,0,,Менің достарым осында қамалған.
Dialogue: 0,0:19:55.36,0:19:56.65,Default,,0,0,0,,Сол екеу ме?
Dialogue: 0,0:19:56.73,0:19:58.65,Default,,0,0,0,,Сол Дар деген жігіт… егер ол құпия ақпаратты сыртқы адамдарға жария етсе…
Dialogue: 0,0:19:59.78,0:20:02.65,Default,,0,0,0,,Барлығын алып кетті.
Dialogue: 0,0:20:02.74,0:20:03.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:06.58,0:20:08.54,Default,,0,0,0,,Мұнда вампирлер бар.
Dialogue: 0,0:20:08.62,0:20:11.87,Default,,0,0,0,,Бұл жай ғана бізді құлыптауға арналған мекеме.
Dialogue: 0,0:20:11.96,0:20:14.83,Default,,0,0,0,,Соңында барлығын кемеге отырғызды.
Dialogue: 0,0:20:14.92,0:20:17.59,Default,,0,0,0,,Олар оны Автонал деген қалаға жібереміз дейді.
Dialogue: 0,0:20:18.25,0:20:19.09,Default,,0,0,0,,Мен тастап кеткен құралдар—
Dialogue: 0,0:20:19.17,0:20:20.96,Default,,0,0,0,,Артында қалды
Dialogue: 0,0:20:21.05,0:20:23.13,Default,,0,0,0,,Қарттардың пайдасы жоқ сияқты.
Dialogue: 0,0:20:24.97,0:20:27.89,Default,,0,0,0,,Жіберілген достар не болады?
Dialogue: 0,0:20:27.97,0:20:29.64,Default,,0,0,0,,Ә? Әйтеуір, ол Мисаға қатты ғашық қой.
Dialogue: 0,0:20:29.72,0:20:31.39,Default,,0,0,0,,Менің білетінім
Dialogue: 0,0:20:31.48,0:20:35.52,Default,,0,0,0,,Олар ерекше қасқырды іздеп жатыр.
Dialogue: 0,0:20:36.23,0:20:37.86,Default,,0,0,0,,Ерекше қасқыр?
Dialogue: 0,0:20:38.36,0:20:39.61,Default,,0,0,0,,Хмм
Dialogue: 0,0:20:40.86,0:20:42.99,Default,,0,0,0,,Дардан, вампирлердің негізін салушы
Dialogue: 0,0:20:43.07,0:20:47.07,Default,,0,0,0,,Мен өз нәсілімнің күшін алғым келеді.
Dialogue: 0,0:20:47.16,0:20:49.28,Default,,0,0,0,,Бізді басқару үшін
Dialogue: 0,0:20:49.37,0:20:53.04,Default,,0,0,0,,Бізге сол қасқырдың күші өте қажет.
Dialogue: 0,0:20:53.12,0:20:54.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:57.08,0:21:00.05,Default,,0,0,0,,Цк... бірінен соң бірі
Dialogue: 0,0:21:01.13,0:21:04.26,Default,,0,0,0,,Бұл жігіт жай вампир емес.
Dialogue: 0,0:21:04.34,0:21:06.22,Default,,0,0,0,,Балалар, сен барыңды бересің!
Dialogue: 0,0:21:06.80,0:21:07.89,Default,,0,0,0,,Гуо!
Dialogue: 0,0:21:08.39,0:21:09.81,Default,,0,0,0,,Шекара Regalia-ның қалқаны әрі жалғыз қаруы болып табылады.
Dialogue: 0,0:21:10.39,0:21:11.81,Default,,0,0,0,,Сол жігітке...
Dialogue: 0,0:21:13.39,0:21:14.69,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:21:16.02,0:21:16.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:17.19,0:21:20.90,Default,,0,0,0,,Сен... ол алқаны қайдан алдың?
Dialogue: 0,0:21:20.98,0:21:21.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:22.11,0:21:24.53,Default,,0,0,0,,Бұл ұрпақтан-ұрпаққа жалғасып келе жатқан нәрсе.
Dialogue: 0,0:21:25.61,0:21:29.70,Default,,0,0,0,,Бұл сөзсіз ликантроптың белгісі.
Dialogue: 0,0:21:30.28,0:21:32.45,Default,,0,0,0,,Lycan… Көлбеу ме?
Dialogue: 0,0:21:33.16,0:21:34.04,Default,,0,0,0,,Хмм
Dialogue: 0,0:21:34.54,0:21:36.62,Default,,0,0,0,,А, мүмкін...
Dialogue: 0,0:21:37.21,0:21:38.46,Default,,0,0,0,,Қайта оралдын.
Dialogue: 0,0:21:38.96,0:21:40.38,Default,,0,0,0,,Жер бетінде бұл не...
Dialogue: 0,0:21:40.96,0:21:43.01,Default,,0,0,0,,Ликантроп дегеніміз не?
Dialogue: 0,0:21:43.09,0:21:48.47,Default,,0,0,0,,Ежелгі Балг патшалығының қасқыр құдайы Балгтың қанын иеленген адам.
Dialogue: 0,0:21:48.97,0:21:52.39,Default,,0,0,0,,Сен Құдай таңдаған қасқырсың.
Dialogue: 0,0:21:52.47,0:21:53.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:55.98,0:21:57.98,Default,,0,0,0,,♪～
Dialogue: 0,0:23:21.40,0:23:23.40,Default,,0,0,0,,～♪
Dialogue: 0,0:23:34.07,0:23:35.91,Default,,0,0,0,,Келесі 10 эпизод
Dialogue: 0,0:23:37.24,0:23:40.91,Default,,0,0,0,,«Өсіп бара жатқан Ай -Автонарудың өлім шайқасы-»
Dialogue: 0,0:23:42.41,0:23:48.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory