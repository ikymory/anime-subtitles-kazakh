Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.87,0:00:03.96,Default,,0,0,0,,Мені Суха дұрыс түсінбей қалды.
Dialogue: 0,0:00:05.25,0:00:07.04,Default,,0,0,0,,Сол үшін мені жек көргім келмейді.
Dialogue: 0,0:00:07.13,0:00:08.96,Default,,0,0,0,,"Дегенмен ол жүгірді."
Dialogue: 0,0:00:09.05,0:00:10.59,Default,,0,0,0,,Мен Суханың мені жек көргенін қаламаймын.
Dialogue: 0,0:00:10.67,0:00:13.68,Default,,0,0,0,,Олай болса, балалар, сәлемдесу керек.
Dialogue: 0,0:00:13.76,0:00:15.26,Default,,0,0,0,,Көп сөйлеме
Dialogue: 0,0:00:15.34,0:00:16.68,Default,,0,0,0,,Тым таныс болмаңыз!
Dialogue: 0,0:00:19.01,0:00:21.02,Default,,0,0,0,,Солон дұрыс айтады.
Dialogue: 0,0:00:21.10,0:00:21.93,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:00:22.02,0:00:25.23,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:00:29.32,0:00:31.15,Default,,0,0,0,,-Суха~ -Аа...
Dialogue: 0,0:00:32.15,0:00:35.32,Default,,0,0,0,,Осы демалыс күндері менімен бірге қыдырғың келе ме?
Dialogue: 0,0:00:35.41,0:00:36.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:36.66,0:00:39.87,Default,,0,0,0,,Е... шіркін... демалыс? Қайда?
Dialogue: 0,0:00:39.95,0:00:41.20,Default,,0,0,0,,Ал...
Dialogue: 0,0:00:41.29,0:00:42.33,Default,,0,0,0,,-Сәлем! -Апыр-ай!
Dialogue: 0,0:00:42.41,0:00:44.87,Default,,0,0,0,,Алаңға бірге барайық.
Dialogue: 0,0:00:44.96,0:00:47.29,Default,,0,0,0,,Балмұздақ жеп, серуендеп алайық.
Dialogue: 0,0:00:47.38,0:00:48.50,Default,,0,0,0,,Тыңдап тұрсың ба?
Dialogue: 0,0:00:49.75,0:00:52.80,Default,,0,0,0,,Мен бақыттымын, бірақ... жақсы ма?
Dialogue: 0,0:00:52.88,0:00:54.05,Default,,0,0,0,,Сонымен қатар теңізге барайық.
Dialogue: 0,0:00:54.13,0:00:56.01,Default,,0,0,0,,Бірақ екеуміз ғана ма?
Dialogue: 0,0:00:56.09,0:00:57.76,Default,,0,0,0,,Иә, екеуміз ғана.
Dialogue: 0,0:00:57.84,0:00:59.30,Default,,0,0,0,,Жоқ, мен де барамын.
Dialogue: 0,0:00:59.39,0:00:59.89,Default,,0,0,0,,А...
Dialogue: 0,0:00:59.97,0:01:02.43,Default,,0,0,0,,Әй, кенет үзбе.
Dialogue: 0,0:01:02.52,0:01:05.10,Default,,0,0,0,,Сіз біртүрлі нәрсе айтасыз, солай емес пе?
Dialogue: 0,0:01:05.19,0:01:07.48,Default,,0,0,0,,Иә? Мені қандай деп ойлайсың...
Dialogue: 0,0:01:07.56,0:01:09.61,Default,,0,0,0,,Мені жалғыз қалдырмаңыз
Dialogue: 0,0:01:09.69,0:01:12.78,Default,,0,0,0,,А... бұл екеуіне не болды?
Dialogue: 0,0:01:12.86,0:01:15.20,Default,,0,0,0,,Кеше мен жақындамаймын дедім.
Dialogue: 0,0:01:15.28,0:01:16.15,Default,,0,0,0,,Сіз шештіңіз.
Dialogue: 0,0:01:16.74,0:01:19.45,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:01:19.95,0:01:22.74,Default,,0,0,0,,Иә, бірақ сонда да менің жүрегімде
Dialogue: 0,0:01:22.83,0:01:24.79,Default,,0,0,0,,«Усопён» деп күбірледіңіз бе?
Dialogue: 0,0:01:24.87,0:01:26.29,Default,,0,0,0,,Солонның ақымақ
Dialogue: 0,0:01:26.37,0:01:27.58,Default,,0,0,0,,Гунуну…
Dialogue: 0,0:01:28.37,0:01:30.96,Default,,0,0,0,,Тікұшақ! Джино! Ян! Жака! Нұх!
Dialogue: 0,0:01:31.04,0:01:31.92,Default,,0,0,0,,-Мм? -не?
Dialogue: 0,0:01:32.00,0:01:33.09,Default,,0,0,0,,- Солон? -қалай?
Dialogue: 0,0:01:33.17,0:01:33.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:33.88,0:01:34.96,Default,,0,0,0,,Сион демалыс күндері
Dialogue: 0,0:01:35.05,0:01:37.09,Default,,0,0,0,,Мен Сухамен бірге алаңға барамын.
Dialogue: 0,0:01:37.18,0:01:38.01,Default,,0,0,0,,- Иә? - Шынайы ма?
Dialogue: 0,0:01:38.09,0:01:39.30,Default,,0,0,0,,- Иә? -Шынымен бе?
Dialogue: 0,0:01:39.39,0:01:40.01,Default,,0,0,0,,Е...
Dialogue: 0,0:01:40.09,0:01:42.10,Default,,0,0,0,,Сәлем! Неге бұзып жатырсың?
Dialogue: 0,0:01:42.18,0:01:44.14,Default,,0,0,0,,Уәдеңді бұзуға сен кінәлісің.
Dialogue: 0,0:01:44.22,0:01:46.77,Default,,0,0,0,,Демалыс күні Сухамен алаңға барасың ба?
Dialogue: 0,0:01:46.85,0:01:49.48,Default,,0,0,0,,Ой, балалар, бірдеңе айту керек...
Dialogue: 0,0:01:49.56,0:01:51.11,Default,,0,0,0,,-Мен де барамын! - А?
Dialogue: 0,0:01:51.19,0:01:52.82,Default,,0,0,0,,-Мен де~ -Эй!
Dialogue: 0,0:01:52.90,0:01:54.73,Default,,0,0,0,,-Онда мен де! -Жака...
Dialogue: 0,0:01:54.82,0:01:56.44,Default,,0,0,0,,-Көңілді көрінеді -Нұх
Dialogue: 0,0:01:56.53,0:01:57.95,Default,,0,0,0,,Тіпті сендер де балалар!
Dialogue: 0,0:01:58.03,0:02:00.99,Default,,0,0,0,,Сенің арқаңнан адам көбейді.
Dialogue: 0,0:02:01.62,0:02:04.49,Default,,0,0,0,,Сіз не ойладыңыз?
Dialogue: 0,0:02:04.58,0:02:05.66,Default,,0,0,0,,Суха
Dialogue: 0,0:02:06.16,0:02:06.87,Default,,0,0,0,,Тікұшақ?
Dialogue: 0,0:02:06.96,0:02:08.96,Default,,0,0,0,,Демалыс күндері далаға шығасыз ба?
Dialogue: 0,0:02:09.04,0:02:10.71,Default,,0,0,0,,Иә? А... иә
Dialogue: 0,0:02:10.79,0:02:12.63,Default,,0,0,0,,Мен де бара аламын ба?
Dialogue: 0,0:02:12.71,0:02:14.09,Default,,0,0,0,,Иә, жарайды.
Dialogue: 0,0:02:14.17,0:02:15.30,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:02:15.88,0:02:16.92,Default,,0,0,0,,Демалыс күні
Dialogue: 0,0:02:17.01,0:02:18.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:19.76,0:02:21.76,Default,,0,0,0,,♪～
Dialogue: 0,0:03:46.22,0:03:48.22,Default,,0,0,0,,～♪
Dialogue: 0,0:03:55.10,0:03:58.36,Default,,0,0,0,,Бұл тым ынталы сияқты.
Dialogue: 0,0:03:58.44,0:04:00.78,Default,,0,0,0,,Бұл жүру аздап қиын.
Dialogue: 0,0:04:00.86,0:04:02.45,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:04:03.03,0:04:06.62,Default,,0,0,0,,Бірақ мен достарыммен қыдырамын...
Dialogue: 0,0:04:19.80,0:04:20.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:20.80,0:04:24.34,Default,,0,0,0,,Сіз Сухасыз ба? Мен Крис
Dialogue: 0,0:04:27.43,0:04:30.68,Default,,0,0,0,,Барлығы сені вампир деп айтады
Dialogue: 0,0:04:30.77,0:04:31.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:32.18,0:04:34.10,Default,,0,0,0,,Сіз шынымен вампирсіз бе?
Dialogue: 0,0:04:38.02,0:04:40.86,Default,,0,0,0,,Егер ол басқаша болса, оның әр түрлі екенін айтыңыз.
Dialogue: 0,0:04:42.49,0:04:43.49,Default,,0,0,0,,Бұл ысырап
Dialogue: 0,0:04:43.99,0:04:47.37,Default,,0,0,0,,Менің айтқаныма ешкім сенбейді
Dialogue: 0,0:04:48.74,0:04:49.87,Default,,0,0,0,,Хмм.
Dialogue: 0,0:04:49.95,0:04:52.79,Default,,0,0,0,,Бірақ сіз вампир емессіз.
Dialogue: 0,0:04:52.87,0:04:53.58,Default,,0,0,0,,Е...
Dialogue: 0,0:04:54.08,0:04:55.00,Default,,0,0,0,,Уваааах! Ашылмай жатыр!
Dialogue: 0,0:04:56.50,0:04:59.50,Default,,0,0,0,,Менің аяғым туылғаннан бері осылай болды.
Dialogue: 0,0:05:00.25,0:05:03.34,Default,,0,0,0,,Әркім осыған қарап ойына келгенін айтады.
Dialogue: 0,0:05:03.42,0:05:05.34,Default,,0,0,0,,Менен ерекшеленетіндіктен
Dialogue: 0,0:05:05.43,0:05:08.39,Default,,0,0,0,,Мұның бәрі ақымақтық пен өтірік.
Dialogue: 0,0:05:09.18,0:05:12.85,Default,,0,0,0,,Олай болса, сіздің айтып отырғаныңыз бос сөз шығар.
Dialogue: 0,0:05:21.61,0:05:24.65,Default,,0,0,0,,Суха, дос болайық.
Dialogue: 0,0:05:25.24,0:05:26.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:29.32,0:05:31.33,Default,,0,0,0,,Мен де жалғызбын
Dialogue: 0,0:05:31.83,0:05:32.41,Default,,0,0,0,,Хехе
Dialogue: 0,0:05:32.49,0:05:33.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:38.42,0:05:39.92,Default,,0,0,0,,Иә, жарайды.
Dialogue: 0,0:05:40.71,0:05:42.00,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:05:50.72,0:05:52.64,Default,,0,0,0,,Мен де достар таптым.
Dialogue: 0,0:05:55.56,0:05:58.06,Default,,0,0,0,,Әр күн өте қызықты
Dialogue: 0,0:05:59.81,0:06:03.86,Default,,0,0,0,,Біреуге сырымды айтқым келді.
Dialogue: 0,0:06:05.11,0:06:06.94,Default,,0,0,0,,Бұл менің өмірімде бірінші рет болды
Dialogue: 0,0:06:10.32,0:06:12.74,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:06:15.83,0:06:18.08,Default,,0,0,0,,Керемет!
Dialogue: 0,0:06:18.16,0:06:19.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:21.67,0:06:23.59,Default,,0,0,0,,Бұл біртүрлі күш деп ойламайсың ба?
Dialogue: 0,0:06:23.67,0:06:25.92,Default,,0,0,0,,Жоқ, бұл ерекше күш.
Dialogue: 0,0:06:27.13,0:06:30.47,Default,,0,0,0,,Шынымен бе? Сіз вампир болуыңыз мүмкін деп қорықпайсыз ба?
Dialogue: 0,0:06:30.55,0:06:34.14,Default,,0,0,0,,Мүлдем! Өйткені мен сен туралы білемін.
Dialogue: 0,0:06:35.47,0:06:40.10,Default,,0,0,0,,Бірақ... Мен әлі күнге дейін өзіме сене алар емеспін
Dialogue: 0,0:06:40.94,0:06:43.69,Default,,0,0,0,,Суха, мойынымды тістегің келе ме?
Dialogue: 0,0:06:43.77,0:06:44.65,Default,,0,0,0,,Мүлдем жоқ!
Dialogue: 0,0:06:44.73,0:06:47.15,Default,,0,0,0,,Егер сізге осындай нәрсе болса
Dialogue: 0,0:06:47.24,0:06:48.74,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:06:49.24,0:06:50.03,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:06:50.11,0:06:51.16,Default,,0,0,0,,Хехе
Dialogue: 0,0:07:05.55,0:07:06.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:09.80,0:07:10.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:11.51,0:07:12.97,Default,,0,0,0,,Эй, мен саған айттым ғой, солай ма?
Dialogue: 0,0:07:13.05,0:07:15.35,Default,,0,0,0,,Сіздің вампир болуыңыз мүмкін емес!
Dialogue: 0,0:07:18.60,0:07:20.18,Default,,0,0,0,,Крис…
Dialogue: 0,0:07:20.27,0:07:21.60,Default,,0,0,0,,Жарайды
Dialogue: 0,0:07:21.69,0:07:24.86,Default,,0,0,0,,Жұрт не десе де, мен саған сенемін.
Dialogue: 0,0:07:57.85,0:08:00.77,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:08:08.82,0:08:10.23,Default,,0,0,0,,Суха~!
Dialogue: 0,0:08:10.74,0:08:12.49,Default,,0,0,0,,Бұл жылдам.
Dialogue: 0,0:08:12.57,0:08:14.66,Default,,0,0,0,,Мен бірінші келуді жоспарладым.
Dialogue: 0,0:08:14.74,0:08:15.87,Default,,0,0,0,,Сион
Dialogue: 0,0:08:15.95,0:08:18.08,Default,,0,0,0,,Бүгінгі киім өте сүйкімді көрінеді
Dialogue: 0,0:08:18.16,0:08:19.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:19.16,0:08:21.29,Default,,0,0,0,,Мен жеңдім.
Dialogue: 0,0:08:21.37,0:08:22.96,Default,,0,0,0,,Иә? Барлығы...
Dialogue: 0,0:08:23.04,0:08:26.46,Default,,0,0,0,,Ой, мен сені шынымен бос емес деп естідім.
Dialogue: 0,0:08:26.54,0:08:30.34,Default,,0,0,0,,Олар уәдесінде тұрмайтын қорқынышты адамдар.
Dialogue: 0,0:08:30.42,0:08:31.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:32.34,0:08:33.34,Default,,0,0,0,,Иә
Dialogue: 0,0:08:33.42,0:08:36.51,Default,,0,0,0,,Амал жоқ, ендеше бірге көңіл көтерейік!
Dialogue: 0,0:08:37.09,0:08:38.05,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:08:38.55,0:08:39.64,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:08:40.39,0:08:43.27,Default,,0,0,0,,Мен бүгін Суханы ертіп барамын.
Dialogue: 0,0:08:43.35,0:08:44.77,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:08:45.52,0:08:47.44,Default,,0,0,0,,Тікұшақ та бос емес.
Dialogue: 0,0:08:47.94,0:08:51.32,Default,,0,0,0,,Бұл қандай кәсіп? Сізге хабарласуым керек пе?
Dialogue: 0,0:08:51.40,0:08:53.86,Default,,0,0,0,,Жоқ, жоқ! Сіз мені ашулы деп ойлайтын шығарсыз
Dialogue: 0,0:08:53.95,0:08:56.61,Default,,0,0,0,,Сіз бос емессіз, ол үшін уайымдамаңыз!
Dialogue: 0,0:08:57.16,0:08:58.16,Default,,0,0,0,,Сәлем Суха
Dialogue: 0,0:08:58.24,0:09:00.24,Default,,0,0,0,,Бүгін күн ашық болғанына қуаныштымын.
Dialogue: 0,0:09:00.33,0:09:01.74,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:09:02.50,0:09:05.75,Default,,0,0,0,,Бірақ маған алдын ала айтқаныңызды қалаймын.
Dialogue: 0,0:09:06.25,0:09:10.21,Default,,0,0,0,,Ойланып көрейікші, телепатия тікұшақтың алдымен сізбен сөйлесуін талап етеді.
Dialogue: 0,0:09:10.29,0:09:13.01,Default,,0,0,0,,Мен бұл туралы ештеңе істей алмаймын.
Dialogue: 0,0:09:14.88,0:09:18.43,Default,,0,0,0,,Бұл алаң демалыс күндері өте жанды.
Dialogue: 0,0:09:19.05,0:09:22.06,Default,,0,0,0,,Бұл айналмалы доңғалақтың ұзын сызығы бар.
Dialogue: 0,0:09:22.14,0:09:24.10,Default,,0,0,0,,Ол әрқашан отбасыларға толы.
Dialogue: 0,0:09:24.18,0:09:26.56,Default,,0,0,0,,Ол жақта көптеген дүкендер бар.
Dialogue: 0,0:09:26.64,0:09:27.90,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:09:28.73,0:09:31.19,Default,,0,0,0,,Күн батқанда, батып бара жатқан күн теңізге шағылысады.
Dialogue: 0,0:09:31.27,0:09:33.15,Default,,0,0,0,,Өте әдемі, солай емес пе?
Dialogue: 0,0:09:33.73,0:09:36.65,Default,,0,0,0,,Мен мұны Сухаға көрсеткім келеді.
Dialogue: 0,0:09:36.74,0:09:38.61,Default,,0,0,0,,Сен өте мейірімдісің, Шион.
Dialogue: 0,0:09:38.70,0:09:41.70,Default,,0,0,0,,Жоқ, бұл әдетте менмін.
Dialogue: 0,0:09:41.78,0:09:44.25,Default,,0,0,0,,Бұл тек бүгін ғана емес.
Dialogue: 0,0:09:44.33,0:09:46.91,Default,,0,0,0,,Ах... Мұнда баспалдақтар бар, абай болыңыз.
Dialogue: 0,0:09:48.25,0:09:49.17,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:09:49.25,0:09:51.13,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:09:51.21,0:09:52.96,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:09:58.09,0:10:00.05,Default,,0,0,0,,Әй, өте сүйкімді!
Dialogue: 0,0:10:00.14,0:10:01.64,Default,,0,0,0,,Мен осы өңірде жоғары рейтингке ие университетте оқыдым—
Dialogue: 0,0:10:01.72,0:10:03.06,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:10:22.74,0:10:24.99,Default,,0,0,0,,Суха, балмұздақ жегің келмей ме?
Dialogue: 0,0:10:25.08,0:10:27.46,Default,,0,0,0,,Ондағы балмұздақ шынымен дәмді.
Dialogue: 0,0:10:27.54,0:10:28.16,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:28.25,0:10:31.29,Default,,0,0,0,,Мен барып сатып алайын. Суха алаңда күтеді.
Dialogue: 0,0:10:31.38,0:10:33.79,Default,,0,0,0,,Е, а... рахмет
Dialogue: 0,0:10:38.34,0:10:39.26,Default,,0,0,0,,Біз барамыз ба?
Dialogue: 0,0:10:39.34,0:10:40.84,Default,,0,0,0,,Сухаға біреу хабарлассын ба?
Dialogue: 0,0:10:41.43,0:10:42.76,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:10:42.85,0:10:43.76,Default,,0,0,0,,Жоспар
Dialogue: 0,0:10:44.26,0:10:45.68,Default,,0,0,0,,Мен де барамын
Dialogue: 0,0:10:45.77,0:10:48.35,Default,,0,0,0,,Ал, бәріміз бірге барайық.
Dialogue: 0,0:10:51.69,0:10:52.56,Default,,0,0,0,,Әй...
Dialogue: 0,0:10:54.32,0:10:55.57,Default,,0,0,0,,Сион ше?
Dialogue: 0,0:10:57.53,0:10:58.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:58.94,0:11:01.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:03.66,0:11:04.83,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:11:04.91,0:11:06.41,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:11:06.99,0:11:08.75,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:11:09.50,0:11:12.58,Default,,0,0,0,,Мен шоколадты жалбызды жақсы көремін.
Dialogue: 0,0:11:12.67,0:11:15.59,Default,,0,0,0,,Екеуің қонаққа келгендеріңе қуаныштымын.
Dialogue: 0,0:11:15.67,0:11:16.42,Default,,0,0,0,,Эй?
Dialogue: 0,0:11:16.50,0:11:17.55,Default,,0,0,0,,Иә
Dialogue: 0,0:11:17.63,0:11:18.63,Default,,0,0,0,,Хехе
Dialogue: 0,0:11:18.71,0:11:20.09,Default,,0,0,0,,Сәлем, Шион!
Dialogue: 0,0:11:20.17,0:11:21.72,Default,,0,0,0,,Қазір қайдасың?
Dialogue: 0,0:11:21.80,0:11:24.18,Default,,0,0,0,,Кездесу сағат 5-те. Сен неге мұнда емессің?
Dialogue: 0,0:11:24.26,0:11:25.68,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:11:25.76,0:11:27.97,Default,,0,0,0,,Мен сағат 4 болды дедім ғой, солай ма?
Dialogue: 0,0:11:28.06,0:11:28.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:28.72,0:11:30.81,Default,,0,0,0,,Біз бәріміз бірге уәдемізден қалай шыға аламыз?
Dialogue: 0,0:11:30.89,0:11:31.98,Default,,0,0,0,,Менің көңілім қалды.
Dialogue: 0,0:11:32.06,0:11:32.98,Default,,0,0,0,,Сион!
Dialogue: 0,0:11:33.06,0:11:35.61,Default,,0,0,0,,Мен сені ешқашан кешірмеймін, сондықтан дайын бол.
Dialogue: 0,0:11:35.69,0:11:37.98,Default,,0,0,0,,Хмф! Қолыңнан келсе, жаса
Dialogue: 0,0:11:38.07,0:11:43.28,Default,,0,0,0,,Біз қайықтамыз, сондықтан мұхиттың ортасынан іздеп келіңдер.
Dialogue: 0,0:11:43.95,0:11:45.12,Default,,0,0,0,,Эй!
Dialogue: 0,0:11:45.20,0:11:46.16,Default,,0,0,0,,Хехе
Dialogue: 0,0:11:47.28,0:11:48.29,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:48.37,0:11:49.54,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:11:49.62,0:11:51.29,Default,,0,0,0,,Балмұздақ дәмді.
Dialogue: 0,0:11:51.37,0:11:53.62,Default,,0,0,0,,Әлгі бейбақ мені алдады!
Dialogue: 0,0:11:53.71,0:11:55.29,Default,,0,0,0,,Менің айтқаным осы ғана
Dialogue: 0,0:11:55.38,0:11:57.42,Default,,0,0,0,,Оған мүлдем көмектесу мүмкін емес.
Dialogue: 0,0:11:57.50,0:12:00.09,Default,,0,0,0,,Суха мені кешігіп қалдым деп ойлайды.
Dialogue: 0,0:12:00.17,0:12:01.09,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:12:01.17,0:12:02.13,Default,,0,0,0,,Хаха...
Dialogue: 0,0:12:04.05,0:12:05.68,Default,,0,0,0,,Мм... Шион
Dialogue: 0,0:12:05.76,0:12:06.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:06.64,0:12:08.01,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:08.10,0:12:09.93,Default,,0,0,0,,Барлығы бос емес
Dialogue: 0,0:12:10.02,0:12:13.81,Default,,0,0,0,,Сізде бірдеңе істеу керек еді, бірақ сіз соңына дейін келдіңіз, солай ма?
Dialogue: 0,0:12:14.40,0:12:15.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:16.40,0:12:18.07,Default,,0,0,0,,Мен сондай бақытты болдым.
Dialogue: 0,0:12:18.15,0:12:20.86,Default,,0,0,0,,А... Иә, жақсы.
Dialogue: 0,0:12:21.36,0:12:24.11,Default,,0,0,0,,Өйткені мен адамдарға көп көңіл бөлетін адаммын.
Dialogue: 0,0:12:24.20,0:12:28.12,Default,,0,0,0,,Негізі алаңға бірінші рет келуім.
Dialogue: 0,0:12:28.20,0:12:30.08,Default,,0,0,0,,(Джозеф Джоэстар) Бақытына орай, Авдолдың мойнындағы жара маңызды нүктеден тыс қалған, сондықтан—
Dialogue: 0,0:12:30.16,0:12:31.79,Default,,0,0,0,,5 йен
Dialogue: 0,0:12:31.87,0:12:34.71,Default,,0,0,0,,Мен адам көп болғанда қорқамын, сондықтан...
Dialogue: 0,0:12:35.71,0:12:38.04,Default,,0,0,0,,Олай болса, қайықпен серуендейміз бе?
Dialogue: 0,0:12:38.13,0:12:39.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:39.13,0:12:41.51,Default,,0,0,0,,Көп адамның ортасында болғанды ​​ұнатпайсыз, солай ма?
Dialogue: 0,0:12:41.59,0:12:43.38,Default,,0,0,0,,Қараңғы түскенше барайық.
Dialogue: 0,0:12:43.47,0:12:46.51,Default,,0,0,0,,Мен сізге бірден билет сатып аламын, осында күтіңіз.
Dialogue: 0,0:12:47.01,0:12:47.89,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:12:55.31,0:12:56.02,Default,,0,0,0,,Суха
Dialogue: 0,0:12:56.10,0:12:57.10,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:57.61,0:12:59.52,Default,,0,0,0,,А... тікұшақ?
Dialogue: 0,0:12:59.61,0:13:00.90,Default,,0,0,0,,Сіз қазір алаңдасыз ба?
Dialogue: 0,0:13:00.98,0:13:02.86,Default,,0,0,0,,Иә... иә
Dialogue: 0,0:13:03.36,0:13:05.65,Default,,0,0,0,,Мм, сен бүгін бос емессің...
Dialogue: 0,0:13:05.74,0:13:07.03,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:13:07.11,0:13:09.66,Default,,0,0,0,,Бірақ менде маңыздырақ жұмыс бар.
Dialogue: 0,0:13:09.74,0:13:11.16,Default,,0,0,0,,Бұл маңызды ма?
Dialogue: 0,0:13:11.24,0:13:12.83,Default,,0,0,0,,Сізбен кездесу үшін
Dialogue: 0,0:13:12.91,0:13:13.62,Default,,0,0,0,,Не!
Dialogue: 0,0:13:14.71,0:13:16.71,Default,,0,0,0,,Мен... Мен таң қалдым!
Dialogue: 0,0:13:16.79,0:13:19.59,Default,,0,0,0,,Менің ойымша, сіз бұлай қалжыңдамайтын типсіз...
Dialogue: 0,0:13:19.67,0:13:20.67,Default,,0,0,0,,(Фушигиро) Неге мұнда жүрсің, Зэн'ин-сенпай?
Dialogue: 0,0:13:20.75,0:13:22.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:22.21,0:13:24.51,Default,,0,0,0,,Осы маңызды кездесуге кешіккенім үшін кешірім сұраймыз.
Dialogue: 0,0:13:24.59,0:13:26.01,Default,,0,0,0,,Мен жақында боламын, күте тұрыңыз.
Dialogue: 0,0:13:26.09,0:13:27.89,Default,,0,0,0,,А... иә
Dialogue: 0,0:13:31.35,0:13:33.77,Default,,0,0,0,,А, мен Шионға айтуым керек.
Dialogue: 0,0:13:36.85,0:13:39.69,Default,,0,0,0,,Иә? Менің ойымша, бұл дұрыс па?
Dialogue: 0,0:13:41.82,0:13:42.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:47.78,0:13:50.24,Default,,0,0,0,,Мүмкін алаңда күткен дұрыс болар еді.
Dialogue: 0,0:13:50.99,0:13:52.37,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:05.97,0:14:09.89,Default,,0,0,0,,Ммм... Мм! Хмм!
Dialogue: 0,0:14:09.97,0:14:12.39,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:14:12.47,0:14:13.64,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:13.72,0:14:15.77,Default,,0,0,0,,А... иә...
Dialogue: 0,0:14:15.85,0:14:16.89,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:17.60,0:14:19.40,Default,,0,0,0,,Бұл адам кім...
Dialogue: 0,0:14:19.48,0:14:20.81,Default,,0,0,0,,Мен қашуым керек
Dialogue: 0,0:14:20.90,0:14:21.40,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:21.48,0:14:24.40,Default,,0,0,0,,Хмм! Хмм...
Dialogue: 0,0:14:24.98,0:14:25.90,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:25.99,0:14:27.40,Default,,0,0,0,,-Уф! -(Вампир) Ахх...
Dialogue: 0,0:14:28.82,0:14:31.53,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:14:31.62,0:14:34.41,Default,,0,0,0,,Гохо...хаа...
Dialogue: 0,0:14:39.29,0:14:41.04,Default,,0,0,0,,Біртүрлі нәрсе
Dialogue: 0,0:14:43.50,0:14:44.38,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:45.21,0:14:48.67,Default,,0,0,0,,Ааааа...
Dialogue: 0,0:14:53.89,0:14:55.31,Default,,0,0,0,,- (Вампир) Гуаааа! -Ха...
Dialogue: 0,0:14:55.39,0:14:57.98,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:14:58.06,0:15:01.48,Default,,0,0,0,,О... шынымен...
Dialogue: 0,0:15:02.15,0:15:03.81,Default,,0,0,0,,Сіз вампирсіз бе?
Dialogue: 0,0:15:07.94,0:15:08.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:09.53,0:15:10.20,Default,,0,0,0,,Өтінемін, осы екеуін қорға
Dialogue: 0,0:15:10.78,0:15:12.16,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:15:14.03,0:15:16.33,Default,,0,0,0,,Ха...
Dialogue: 0,0:15:16.91,0:15:18.45,Default,,0,0,0,,Шион... Шион!
Dialogue: 0,0:15:18.54,0:15:20.33,Default,,0,0,0,,Суха жақсысың ба!
Dialogue: 0,0:15:20.41,0:15:22.25,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:15:22.33,0:15:25.00,Default,,0,0,0,,Адам сені іздеп келгенде, кенет...
Dialogue: 0,0:15:25.09,0:15:26.71,Default,,0,0,0,,Осы жерден тез кетейік.
Dialogue: 0,0:15:26.80,0:15:27.46,Default,,0,0,0,,Сион!
Dialogue: 0,0:15:27.55,0:15:28.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:28.55,0:15:30.13,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:15:30.22,0:15:30.88,Default,,0,0,0,,Сион!
Dialogue: 0,0:15:30.97,0:15:32.13,Default,,0,0,0,,-(Вампир) Гуаааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:15:32.93,0:15:33.64,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:38.64,0:15:40.27,Default,,0,0,0,,- (Вампир) Куаа! -Ха...
Dialogue: 0,0:15:42.39,0:15:44.52,Default,,0,0,0,,Хмм... Былай деуге болады
Dialogue: 0,0:15:46.15,0:15:47.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:48.19,0:15:49.19,Default,,0,0,0,,Жака?
Dialogue: 0,0:15:49.28,0:15:52.20,Default,,0,0,0,,Кешіріңіз... кешіріңіз! Өйткені бұл төтенше жағдай болды
Dialogue: 0,0:15:53.66,0:15:54.99,Default,,0,0,0,,Олар бізді шайтан деп атады➡
Dialogue: 0,0:15:58.29,0:15:59.91,Default,,0,0,0,,Әй, Ян!
Dialogue: 0,0:16:00.41,0:16:01.71,Default,,0,0,0,,Суха! Сенімен бәрі жақсы ма?
Dialogue: 0,0:16:01.79,0:16:04.12,Default,,0,0,0,,Иә, Джакаға рахмет
Dialogue: 0,0:16:04.71,0:16:05.58,Default,,0,0,0,,Ян!
Dialogue: 0,0:16:06.09,0:16:06.96,Default,,0,0,0,,Бұл қауіпті болды.
Dialogue: 0,0:16:07.67,0:16:11.01,Default,,0,0,0,,Хаа...аааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:16:11.80,0:16:14.47,Default,,0,0,0,,Уф... мына жігіт қызықсыз.
Dialogue: 0,0:16:15.30,0:16:20.10,Default,,0,0,0,,Маған сол қызды қазір беріңіз...
Dialogue: 0,0:16:20.18,0:16:21.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:21.23,0:16:22.56,Default,,0,0,0,,А...
Dialogue: 0,0:16:23.48,0:16:24.90,Default,,0,0,0,,Не?
Dialogue: 0,0:16:25.40,0:16:26.73,Default,,0,0,0,,Суха?
Dialogue: 0,0:16:27.23,0:16:29.65,Default,,0,0,0,,Ааааа…
Dialogue: 0,0:16:30.28,0:16:31.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:32.24,0:16:34.03,Default,,0,0,0,,Мына жігіт Суханы нысанаға алып отыр ма?
Dialogue: 0,0:16:34.11,0:16:36.37,Default,,0,0,0,,А... бірақ неге?
Dialogue: 0,0:16:37.95,0:16:38.83,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:39.33,0:16:42.00,Default,,0,0,0,,(Вампирлердің ырылдауы)
Dialogue: 0,0:16:45.08,0:16:46.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:47.08,0:16:49.17,Default,,0,0,0,,Жака! Суханы алып қашып кет!
Dialogue: 0,0:16:49.25,0:16:50.59,Default,,0,0,0,,- Иә? - Түсіндім!
Dialogue: 0,0:16:51.09,0:16:51.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:52.21,0:16:53.63,Default,,0,0,0,,Ах! Апыр-ай!
Dialogue: 0,0:16:54.34,0:16:56.64,Default,,0,0,0,,Уау... аа... уф...
Dialogue: 0,0:16:57.26,0:16:58.14,Default,,0,0,0,,Кяа~!
Dialogue: 0,0:16:59.05,0:17:00.76,Default,,0,0,0,,Бұл не! Жылдам!
Dialogue: 0,0:17:00.85,0:17:03.64,Default,,0,0,0,,Жарайды... күте тұр, Жака.
Dialogue: 0,0:17:03.73,0:17:04.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:04.94,0:17:06.27,Default,,0,0,0,,-Құсығым келіп тұр -Уау!
Dialogue: 0,0:17:09.86,0:17:12.03,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:17:12.11,0:17:15.40,Default,,0,0,0,,Мына жігіттер... неге мұнда?
Dialogue: 0,0:17:15.49,0:17:18.03,Default,,0,0,0,,Суха мен Шион жақсы деп үміттенемін!
Dialogue: 0,0:17:19.03,0:17:20.03,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:20.12,0:17:22.16,Default,,0,0,0,,Соңы жоқ!
Dialogue: 0,0:17:22.24,0:17:24.50,Default,,0,0,0,,- (Вампирлер) Гуаа... - Уф! Ха!
Dialogue: 0,0:17:24.58,0:17:26.62,Default,,0,0,0,,Гваааах!
Dialogue: 0,0:17:27.42,0:17:30.04,Default,,0,0,0,,Бұл кімнің ақшасы? Тезірек түкіріп тастаңыз!
Dialogue: 0,0:17:30.13,0:17:32.34,Default,,0,0,0,,Сіздің мақсатыңыз қандай?
Dialogue: 0,0:17:32.84,0:17:35.97,Default,,0,0,0,,Отбасымнан алыста~!
Dialogue: 0,0:17:36.05,0:17:37.26,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:38.26,0:17:39.80,Default,,0,0,0,,Бұл да жақсы емес пе?
Dialogue: 0,0:17:42.01,0:17:44.89,Default,,0,0,0,,Әркім өз ақылын жоғалтты.
Dialogue: 0,0:17:44.98,0:17:46.98,Default,,0,0,0,,Жай ғана төмен дәрежелі вампир
Dialogue: 0,0:17:47.06,0:17:49.65,Default,,0,0,0,,Сіз дұрыс сөйлесе алатын адам емес.
Dialogue: 0,0:17:50.15,0:17:51.19,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:17:52.48,0:17:54.03,Default,,0,0,0,,Сухаға не болды?
Dialogue: 0,0:17:54.11,0:17:56.24,Default,,0,0,0,,Жака мені әйгілі алаңға апарды!
Dialogue: 0,0:17:56.32,0:17:57.74,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:58.36,0:17:59.57,Default,,0,0,0,,Эй Шион
Dialogue: 0,0:17:59.66,0:18:02.99,Default,,0,0,0,,Сіз бірге болсаңыз да, неге бұлай болды?
Dialogue: 0,0:18:03.08,0:18:05.37,Default,,0,0,0,,Ах, бұл менмін...
Dialogue: 0,0:18:05.87,0:18:08.42,Default,,0,0,0,,Мен өзім билет алуға бардым.
Dialogue: 0,0:18:08.50,0:18:10.83,Default,,0,0,0,,Мен қайтып келсем, Суха жоқ екен...
Dialogue: 0,0:18:10.92,0:18:12.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:12.13,0:18:14.59,Default,,0,0,0,,Аймақты білмейтін адамды жалғыз қалдырмаңыз!
Dialogue: 0,0:18:14.67,0:18:16.30,Default,,0,0,0,,Қош бол, Солон.
Dialogue: 0,0:18:16.80,0:18:20.30,Default,,0,0,0,,Ешкім мені мұндай жерге келеді деп күткен жоқ.
Dialogue: 0,0:18:20.80,0:18:22.01,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:23.26,0:18:25.72,Default,,0,0,0,,Не? Сіз шынымен солай айттыңыз ба?
Dialogue: 0,0:18:25.81,0:18:27.31,Default,,0,0,0,,-Аа -Иә
Dialogue: 0,0:18:27.81,0:18:30.52,Default,,0,0,0,,Не болып жатыр? Жалпы...
Dialogue: 0,0:18:30.60,0:18:33.15,Default,,0,0,0,,Бұл жігіттер күннің астында қалса, өледі дейді.
Dialogue: 0,0:18:33.23,0:18:34.78,Default,,0,0,0,,Мен білуім керек еді
Dialogue: 0,0:18:34.86,0:18:36.28,Default,,0,0,0,,Әрине
Dialogue: 0,0:18:36.36,0:18:37.90,Default,,0,0,0,,Бізге ұқсамайды
Dialogue: 0,0:18:37.99,0:18:41.53,Default,,0,0,0,,Толық түн болғанша қозғала алмайсыз.
Dialogue: 0,0:18:41.62,0:18:43.41,Default,,0,0,0,,Неге сонша үмітсізсің...
Dialogue: 0,0:18:43.49,0:18:44.70,Default,,0,0,0,,Осы балаға не болған екен…
Dialogue: 0,0:18:44.79,0:18:46.16,Default,,0,0,0,,Угага…
Dialogue: 0,0:18:46.25,0:18:50.83,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:18:53.50,0:18:55.63,Default,,0,0,0,,Жай ғана кездейсоқтық емес
Dialogue: 0,0:18:56.76,0:18:59.17,Default,,0,0,0,,Суханы мақсат еттіңіз бе?
Dialogue: 0,0:19:02.39,0:19:03.80,Default,,0,0,0,,Ал...
Dialogue: 0,0:19:03.89,0:19:06.18,Default,,0,0,0,,Білмеймін, бірақ оның жағдайы өте ауыр сияқты
Dialogue: 0,0:19:06.27,0:19:07.77,Default,,0,0,0,,Кешіріңіз?
Dialogue: 0,0:19:07.85,0:19:09.98,Default,,0,0,0,,Қазір бәрі жақсы
Dialogue: 0,0:19:10.06,0:19:13.31,Default,,0,0,0,,Бұл менің алғашқы тәжірибем және менің басым айналады...
Dialogue: 0,0:19:13.40,0:19:17.44,Default,,0,0,0,,Өте жаман болды, мен Сухаға көмектесуім керек деп ойладым.
Dialogue: 0,0:19:17.94,0:19:19.32,Default,,0,0,0,,Саған серуен берейін бе?
Dialogue: 0,0:19:19.82,0:19:23.78,Default,,0,0,0,,Жарайды, сәл демалсаң басылады.
Dialogue: 0,0:19:23.87,0:19:25.33,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:25.41,0:19:26.95,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:19:28.75,0:19:29.83,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:29.91,0:19:30.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:32.17,0:19:34.42,Default,,0,0,0,,Ол кезде де солай болды.
Dialogue: 0,0:19:34.92,0:19:36.84,Default,,0,0,0,,Маған әрқашан көмекке келгені үшін.
Dialogue: 0,0:19:36.92,0:19:39.01,Default,,0,0,0,,Ах... ой
Dialogue: 0,0:19:39.51,0:19:42.09,Default,,0,0,0,,Қалай болғанда да, мен оны уақытында орындағаныма қуаныштымын.
Dialogue: 0,0:19:42.18,0:19:44.93,Default,,0,0,0,,Әйтеуір, бүгін қалай білдің?
Dialogue: 0,0:19:45.01,0:19:45.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:45.80,0:19:48.22,Default,,0,0,0,,Себебі сен мен тұрған жерге келдің...
Dialogue: 0,0:19:48.31,0:19:49.10,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:49.18,0:19:51.19,Default,,0,0,0,,Неге ол бізді өзінен алыстатқысы келеді?
Dialogue: 0,0:19:51.27,0:19:52.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:52.19,0:19:54.90,Default,,0,0,0,,Әңгімені қайдан бастау керек...
Dialogue: 0,0:19:57.73,0:19:59.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:08.29,0:20:09.20,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:20:10.95,0:20:12.12,Default,,0,0,0,,Крис?
Dialogue: 0,0:20:13.92,0:20:14.96,Default,,0,0,0,,Жарайды
Dialogue: 0,0:20:15.04,0:20:18.46,Default,,0,0,0,,Жұрт не десе де мен саған сенемін.
Dialogue: 0,0:20:18.96,0:20:22.26,Default,,0,0,0,,Мен мәңгі бірге боламыз деп ойладым
Dialogue: 0,0:20:22.76,0:20:23.68,Default,,0,0,0,,Сонда да...
Dialogue: 0,0:20:23.76,0:20:29.68,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:20:29.77,0:20:34.94,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:20:35.02,0:20:38.44,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:20:42.28,0:20:44.66,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:20:44.74,0:20:51.70,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:21:03.72,0:21:07.72,Default,,0,0,0,,Кристі менің қолымнан вампир тартып алды.
Dialogue: 0,0:21:18.06,0:21:19.15,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:19.23,0:21:22.40,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:22.90,0:21:26.78,Default,,0,0,0,,(жылаған дауыс)
Dialogue: 0,0:21:32.62,0:21:33.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:35.12,0:21:36.12,Default,,0,0,0,,Суха
Dialogue: 0,0:21:37.37,0:21:39.04,Default,,0,0,0,,Суха сен мені естисің бе?
Dialogue: 0,0:21:39.13,0:21:40.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:42.05,0:21:42.80,Default,,0,0,0,,Суха
Dialogue: 0,0:21:42.88,0:21:44.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:55.98,0:21:57.98,Default,,0,0,0,,♪～
Dialogue: 0,0:23:22.19,0:23:24.19,Default,,0,0,0,,～♪
Dialogue: 0,0:23:34.78,0:23:37.58,Default,,0,0,0,,Келесі 4 эпизод
Dialogue: 0,0:23:37.66,0:23:40.91,Default,,0,0,0,,«Қанды ай - Айдың толық тұтылу түні-»
