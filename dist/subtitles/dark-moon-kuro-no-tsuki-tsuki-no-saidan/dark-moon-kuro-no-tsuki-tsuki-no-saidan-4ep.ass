Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.62,0:00:02.58,Default,,0,0,0,,Суха
Dialogue: 0,0:00:03.87,0:00:05.54,Default,,0,0,0,,Суха сен мені естисің бе?
Dialogue: 0,0:00:05.63,0:00:06.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:06.79,0:00:07.88,Default,,0,0,0,,Суха
Dialogue: 0,0:00:07.96,0:00:09.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:10.76,0:00:13.13,Default,,0,0,0,,Суха жақсысың ба? Сіз жарақат алдыңыз ба?
Dialogue: 0,0:00:13.22,0:00:14.05,Default,,0,0,0,,Тікұшақ?
Dialogue: 0,0:00:14.13,0:00:16.43,Default,,0,0,0,,Қазір қайдасың? Мен сені алып кетейін
Dialogue: 0,0:00:16.51,0:00:19.18,Default,,0,0,0,,Аа, сәл...
Dialogue: 0,0:00:19.26,0:00:20.81,Default,,0,0,0,,Иә? Суха
Dialogue: 0,0:00:20.89,0:00:22.39,Default,,0,0,0,,Хан!
Dialogue: 0,0:00:22.48,0:00:23.52,Default,,0,0,0,,Қайта танысқаныма қуаныштымын
Dialogue: 0,0:00:23.60,0:00:25.90,Default,,0,0,0,,Ах... Мм...
Dialogue: 0,0:00:26.40,0:00:28.15,Default,,0,0,0,,Мұнда емес.
Dialogue: 0,0:00:29.44,0:00:30.94,Default,,0,0,0,,Айтуынша, сол шайқас нағыз қанды қырғын болған екен.
Dialogue: 0,0:00:31.82,0:00:33.82,Default,,0,0,0,,♪～
Dialogue: 0,0:01:58.28,0:02:00.28,Default,,0,0,0,,～♪
Dialogue: 0,0:02:06.04,0:02:08.83,Default,,0,0,0,,Жалғыз ба? Әлде біреумен жүрсің бе?
Dialogue: 0,0:02:08.92,0:02:09.71,Default,,0,0,0,,Ой...
Dialogue: 0,0:02:09.79,0:02:12.75,Default,,0,0,0,,Менімен бірге келдің, шағымың бар ма?
Dialogue: 0,0:02:12.84,0:02:13.42,Default,,0,0,0,,Жака
Dialogue: 0,0:02:14.05,0:02:15.13,Default,,0,0,0,,Тек екеуміз бе?
Dialogue: 0,0:02:15.21,0:02:17.01,Default,,0,0,0,,Жоқ, басқалары да...
Dialogue: 0,0:02:17.09,0:02:18.68,Default,,0,0,0,,Бұл сіздің шаруаңыз емес.
Dialogue: 0,0:02:19.80,0:02:21.34,Default,,0,0,0,,- Хан аға! - (Хан) А?
Dialogue: 0,0:02:21.43,0:02:23.26,Default,,0,0,0,,Қайықтармен жарысайық
Dialogue: 0,0:02:23.35,0:02:25.10,Default,,0,0,0,,Иә? Суха!
Dialogue: 0,0:02:25.18,0:02:26.43,Default,,0,0,0,,Тағы кездескенше...
Dialogue: 0,0:02:27.18,0:02:28.94,Default,,0,0,0,,-Суха! Жака! -Аа...
Dialogue: 0,0:02:29.02,0:02:29.89,Default,,0,0,0,,Сион!
Dialogue: 0,0:02:29.98,0:02:30.90,Default,,0,0,0,,Екеуің де жақсысыңдар...
Dialogue: 0,0:02:30.98,0:02:31.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:32.98,0:02:33.82,Default,,0,0,0,,Суха
Dialogue: 0,0:02:33.90,0:02:34.77,Default,,0,0,0,,Тікұшақ
Dialogue: 0,0:02:34.86,0:02:36.15,Default,,0,0,0,,Бір жеріңіз ауырды ма?
Dialogue: 0,0:02:36.23,0:02:37.65,Default,,0,0,0,,Иә, бәрібір
Dialogue: 0,0:02:37.74,0:02:39.65,Default,,0,0,0,,Маған барлығы көмектесті
Dialogue: 0,0:02:47.75,0:02:49.83,Default,,0,0,0,,Қандай да бір жарақат болды ма?
Dialogue: 0,0:02:49.91,0:02:53.63,Default,,0,0,0,,Әй, дәл қазір кенеттен вампир пайда болды.
Dialogue: 0,0:02:53.71,0:02:54.75,Default,,0,0,0,,Не?
Dialogue: 0,0:02:54.84,0:02:57.46,Default,,0,0,0,,Осындай уақытта...және бұл алаңқайда.
Dialogue: 0,0:02:57.55,0:02:59.30,Default,,0,0,0,,Олар қазір қайда?
Dialogue: 0,0:02:59.38,0:03:01.63,Default,,0,0,0,,Біз оған қамқорлық жасадық
Dialogue: 0,0:03:01.72,0:03:03.80,Default,,0,0,0,,Сізге алаңдаудың қажеті жоқ.
Dialogue: 0,0:03:03.89,0:03:05.10,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,0:03:05.18,0:03:06.60,Default,,0,0,0,,Біріншіден, егер біз
Dialogue: 0,0:03:06.68,0:03:09.18,Default,,0,0,0,,Мен Суханға қауіп төндірмес едім.
Dialogue: 0,0:03:09.27,0:03:10.60,Default,,0,0,0,,Не?
Dialogue: 0,0:03:10.69,0:03:11.48,Default,,0,0,0,,Ян
Dialogue: 0,0:03:11.56,0:03:15.15,Default,,0,0,0,,Суха, бұл жігіттермен көп араласпа.
Dialogue: 0,0:03:15.23,0:03:16.82,Default,,0,0,0,,Бұл сізге жақсырақ.
Dialogue: 0,0:03:16.90,0:03:17.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:17.48,0:03:18.82,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:03:18.90,0:03:21.15,Default,,0,0,0,,Осы демалыс күндері бізбен бірге болыңыз.
Dialogue: 0,0:03:21.24,0:03:21.99,Default,,0,0,0,,Хмф!
Dialogue: 0,0:03:22.07,0:03:25.12,Default,,0,0,0,,Суха бізге келесі аптада да уәде берді.
Dialogue: 0,0:03:25.20,0:03:26.53,Default,,0,0,0,,Не? Солай ма?
Dialogue: 0,0:03:26.62,0:03:28.12,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:28.20,0:03:30.29,Default,,0,0,0,,Ал, келесі аптада кездесейік.
Dialogue: 0,0:03:30.37,0:03:30.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:30.96,0:03:35.21,Default,,0,0,0,,Мен сізге әрқашан келесі аптада және келесі аптада уәде бердім.
Dialogue: 0,0:03:35.29,0:03:39.13,Default,,0,0,0,,Мәңгі аяқталады!
Dialogue: 0,0:03:39.21,0:03:41.72,Default,,0,0,0,,Конняро! Ақымақ болма, брат!
Dialogue: 0,0:03:41.80,0:03:42.97,Default,,0,0,0,,Қандай ақымақ!
Dialogue: 0,0:03:43.05,0:03:46.55,Default,,0,0,0,,Шулы! Оны ақымақ деу – ақымақтық!
Dialogue: 0,0:03:46.64,0:03:49.72,Default,,0,0,0,,-Няаааа! -Грррррр...
Dialogue: 0,0:03:50.43,0:03:51.52,Default,,0,0,0,,Бірақ Суха
Dialogue: 0,0:03:51.60,0:03:54.77,Default,,0,0,0,,Үш аптадан кейін біз шынымен де туған күн кешін өткіземіз.
Dialogue: 0,0:03:54.85,0:03:55.77,Default,,0,0,0,,Сіз келесіз, солай ма?
Dialogue: 0,0:03:55.86,0:03:59.15,Default,,0,0,0,,Не? Мен... Туған күнім болса міндетті түрде барамын.
Dialogue: 0,0:03:59.23,0:04:01.03,Default,,0,0,0,,Сәлем! Боқтық айтпа!
Dialogue: 0,0:04:01.11,0:04:02.61,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:04:02.70,0:04:05.07,Default,,0,0,0,,Маған сенбесең, сен де неге келмейсің?
Dialogue: 0,0:04:05.16,0:04:06.37,Default,,0,0,0,,Кім барады!
Dialogue: 0,0:04:06.45,0:04:08.37,Default,,0,0,0,,Мұны тойлауға ешқандай себеп жоқ.
Dialogue: 0,0:04:08.45,0:04:10.12,Default,,0,0,0,,Бұл жай ғана әзіл.
Dialogue: 0,0:04:10.20,0:04:11.87,Default,,0,0,0,,Мен сізді шақыра алмаймын.
Dialogue: 0,0:04:11.96,0:04:13.25,Default,,0,0,0,,Өйткені бұл үлкен мәселе
Dialogue: 0,0:04:13.33,0:04:15.58,Default,,0,0,0,,Бәріміз бірге тойласақ жақсы емес пе?
Dialogue: 0,0:04:15.67,0:04:17.67,Default,,0,0,0,,Суха айтса, мен міндетті түрде барамын.
Dialogue: 0,0:04:17.75,0:04:19.09,Default,,0,0,0,,Мен де барамын
Dialogue: 0,0:04:19.17,0:04:20.46,Default,,0,0,0,,Маған шақыру жіберіңіз.
Dialogue: 0,0:04:20.55,0:04:21.92,Default,,0,0,0,,- (Еңгі) Менің де барғым келеді - (Хан) А...
Dialogue: 0,0:04:22.01,0:04:22.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:22.72,0:04:24.59,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба?
Dialogue: 0,0:04:24.68,0:04:26.68,Default,,0,0,0,,Балалар, сендер маған ештеңе дей алмайсыңдар.
Dialogue: 0,0:04:26.76,0:04:27.72,Default,,0,0,0,,Не!
Dialogue: 0,0:04:27.80,0:04:29.56,Default,,0,0,0,,Ащы кешіңізге
Dialogue: 0,0:04:29.64,0:04:31.22,Default,,0,0,0,,Сіз мұны істеу үшін бар күшіңізді саламын деп жатырсыз, солай ма?
Dialogue: 0,0:04:31.31,0:04:32.56,Default,,0,0,0,,Қойыңдар, балалар.
Dialogue: 0,0:04:32.64,0:04:33.94,Default,,0,0,0,,Шаңды балалар
Dialogue: 0,0:04:34.02,0:04:35.35,Default,,0,0,0,,Мен сені шақырмаймын.
Dialogue: 0,0:04:35.44,0:04:37.19,Default,,0,0,0,,Тоқтаңдар, балалар.
Dialogue: 0,0:04:39.94,0:04:43.65,Default,,0,0,0,,Суха, сен саған вампир шабуыл жасады деп айттың ғой, солай ма?
Dialogue: 0,0:04:43.74,0:04:47.07,Default,,0,0,0,,Олар Суханға қауіп төндірді.
Dialogue: 0,0:04:47.16,0:04:48.32,Default,,0,0,0,,О
Dialogue: 0,0:04:48.83,0:04:51.66,Default,,0,0,0,,Екеуің де Суха үшін көп уайымдама.
Dialogue: 0,0:04:51.74,0:04:53.96,Default,,0,0,0,,Иә? А... иә
Dialogue: 0,0:04:54.04,0:04:55.12,Default,,0,0,0,,...
Dialogue: 0,0:04:55.79,0:04:58.88,Default,,0,0,0,,Мен Сухада тылсым күш бар сияқты сезінемін.
Dialogue: 0,0:05:00.00,0:05:01.67,Default,,0,0,0,,Шынымды айтсам, мен де емеспін.
Dialogue: 0,0:05:01.75,0:05:02.63,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:05:04.34,0:05:07.76,Default,,0,0,0,,Сол кезде Суханың сөздерінен қозғала алмай қалдым.
Dialogue: 0,0:05:07.84,0:05:10.89,Default,,0,0,0,,Бұл балада бірдеңе дұрыс емес.
Dialogue: 0,0:05:10.97,0:05:14.56,Default,,0,0,0,,Мен бүгін вампирдің шабуылына байланысты екенін естідім.
Dialogue: 0,0:05:14.64,0:05:17.10,Default,,0,0,0,,О, бұл бәрі емес.
Dialogue: 0,0:05:17.19,0:05:19.81,Default,,0,0,0,,Суханы қорғау үшін болса да.
Dialogue: 0,0:05:19.90,0:05:23.74,Default,,0,0,0,,Маған да қызық, олардың өз түрлерінің арасында соғысқан.
Dialogue: 0,0:05:30.24,0:05:32.54,Default,,0,0,0,,Мен бүгін алаңда көрген адам
Dialogue: 0,0:05:32.62,0:05:35.25,Default,,0,0,0,,Егер Крис өмір сүріп, есейсе
Dialogue: 0,0:05:35.33,0:05:37.50,Default,,0,0,0,,Мен міндетті түрде солай деп ойлаймын.
Dialogue: 0,0:05:41.67,0:05:46.13,Default,,0,0,0,,Бірақ Крис өлді... иә?
Dialogue: 0,0:05:48.38,0:05:49.55,Default,,0,0,0,,Суха
Dialogue: 0,0:05:49.64,0:05:53.14,Default,,0,0,0,,Ол кезде сіз міндетті түрде менің атымды атайтынсыз.
Dialogue: 0,0:05:53.77,0:05:56.31,Default,,0,0,0,,Крис әлі тірі ме?
Dialogue: 0,0:05:56.81,0:05:59.15,Default,,0,0,0,,Бірақ жер бетінде қалай...
Dialogue: 0,0:05:59.23,0:06:02.73,Default,,0,0,0,,Олай болса, неге маған бұрын келмедің?
Dialogue: 0,0:06:03.23,0:06:05.99,Default,,0,0,0,,Және тез жоғалып кету ...
Dialogue: 0,0:06:06.49,0:06:09.16,Default,,0,0,0,,Жоқ, маңызды емес!
Dialogue: 0,0:06:09.91,0:06:12.20,Default,,0,0,0,,Сен тірі болғанша!
Dialogue: 0,0:06:26.80,0:06:28.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:32.26,0:06:34.26,Default,,0,0,0,,Ах... Крис!
Dialogue: 0,0:06:38.85,0:06:39.73,Default,,0,0,0,,Крис
Dialogue: 0,0:06:40.44,0:06:41.60,Default,,0,0,0,,Крис!
Dialogue: 0,0:06:42.11,0:06:42.90,Default,,0,0,0,,Крис!
Dialogue: 0,0:06:42.98,0:06:45.82,Default,,0,0,0,,Суха мен сені сағындым.
Dialogue: 0,0:06:45.90,0:06:47.40,Default,,0,0,0,,Ол тірі болды ма?
Dialogue: 0,0:06:47.49,0:06:49.03,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:06:49.53,0:06:51.99,Default,,0,0,0,,Бұл шынымен Крис пе?
Dialogue: 0,0:06:52.07,0:06:54.83,Default,,0,0,0,,Иә, бұл ностальгиялық.
Dialogue: 0,0:06:54.91,0:06:58.25,Default,,0,0,0,,Сонда да сен мүлде өзгерген жоқсың.
Dialogue: 0,0:06:59.96,0:07:01.21,Default,,0,0,0,,Крис…
Dialogue: 0,0:07:03.17,0:07:05.25,Default,,0,0,0,,Бұл Крис!
Dialogue: 0,0:07:08.30,0:07:10.84,Default,,0,0,0,,Суха сені тағы көргеніме қуаныштымын
Dialogue: 0,0:07:14.85,0:07:15.97,Default,,0,0,0,,Крис…
Dialogue: 0,0:07:16.47,0:07:18.60,Default,,0,0,0,,Бірақ неге?
Dialogue: 0,0:07:19.85,0:07:20.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:20.60,0:07:21.64,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:26.73,0:07:28.03,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,0:07:28.53,0:07:31.24,Default,,0,0,0,,Бұл сөзсіз арман
Dialogue: 0,0:07:32.03,0:07:34.45,Default,,0,0,0,,(Суханың ауыр тыныс алуы)
Dialogue: 0,0:07:35.03,0:07:36.41,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:07:37.62,0:07:39.95,Default,,0,0,0,,Крис ол жерде бола алмайды.
Dialogue: 0,0:07:40.04,0:07:42.96,Default,,0,0,0,,Мұның бәрі арман!
Dialogue: 0,0:07:45.04,0:07:50.47,Default,,0,0,0,,(Суханың ауыр тыныс алуы)
Dialogue: 0,0:07:54.47,0:07:58.01,Default,,0,0,0,,Күтілгендей... жоқ.
Dialogue: 0,0:08:00.68,0:08:03.10,Default,,0,0,0,,Неліктен қараңғы?
Dialogue: 0,0:08:03.19,0:08:05.23,Default,,0,0,0,,Бүгін түнде толық ай болды
Dialogue: 0,0:08:09.32,0:08:11.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:13.03,0:08:19.74,Default,,0,0,0,,(Қасқырлар айқайлайды)
Dialogue: 0,0:08:19.83,0:08:26.67,Default,,0,0,0,,(Қасқырлар айқайлайды)
Dialogue: 0,0:08:27.17,0:08:31.13,Default,,0,0,0,,Өйткені бүгін өзгермеген мен ғана болдым.
Dialogue: 0,0:08:31.63,0:08:35.80,Default,,0,0,0,,Неліктен мен ғана өзгермеймін?
Dialogue: 0,0:08:42.81,0:08:44.64,Default,,0,0,0,,Толық ай күні барлығы
Dialogue: 0,0:08:44.73,0:08:48.06,Default,,0,0,0,,Ай сәулесіне шомылсаң, табиғи түрде қасқырға айналасың.
Dialogue: 0,0:08:48.90,0:08:51.15,Default,,0,0,0,,Неге жалғыз мен...
Dialogue: 0,0:08:52.32,0:08:55.86,Default,,0,0,0,,Мен әлі сәтсіздікке ұшырадым ба?
Dialogue: 0,0:09:05.37,0:09:06.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:10.67,0:09:13.01,Default,,0,0,0,,Иә? Суха?
Dialogue: 0,0:09:13.88,0:09:15.01,Default,,0,0,0,,Хан?
Dialogue: 0,0:09:19.35,0:09:20.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:37.70,0:09:38.70,Default,,0,0,0,,Хан
Dialogue: 0,0:09:43.95,0:09:44.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:45.62,0:09:47.75,Default,,0,0,0,,Осы сағатта неге келдің?
Dialogue: 0,0:09:47.83,0:09:49.17,Default,,0,0,0,,Пижама?
Dialogue: 0,0:09:49.25,0:09:51.17,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:09:51.75,0:09:54.92,Default,,0,0,0,,Атмосфера әдеттегіден өзгеше ме?
Dialogue: 0,0:09:55.01,0:09:58.22,Default,,0,0,0,,Ах... уау! Мен асығып жатырмын және мен осылай көрінемін!
Dialogue: 0,0:09:58.30,0:10:02.14,Default,,0,0,0,,Бұл туралы алаңдамаңыз. Кейде асығыс кезде осындай жағдайлар болады.
Dialogue: 0,0:10:02.22,0:10:03.72,Default,,0,0,0,,Мен мұны үнемі жасаймын.
Dialogue: 0,0:10:03.81,0:10:05.64,Default,,0,0,0,,Не? Жиі?
Dialogue: 0,0:10:05.73,0:10:07.23,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:10:07.31,0:10:10.06,Default,,0,0,0,,Ал... Сен мұнда тағы не істеп жүрсің?
Dialogue: 0,0:10:10.15,0:10:12.15,Default,,0,0,0,,Не? Ах... мм
Dialogue: 0,0:10:12.23,0:10:14.90,Default,,0,0,0,,Эй... Мен түнде теңізді көргім келеді.
Dialogue: 0,0:10:14.98,0:10:16.24,Default,,0,0,0,,Жалғыз ба?
Dialogue: 0,0:10:16.32,0:10:17.36,Default,,0,0,0,,Иә
Dialogue: 0,0:10:17.45,0:10:20.16,Default,,0,0,0,,Мен бүгін толық ай деп ойладым...
Dialogue: 0,0:10:22.24,0:10:23.62,Default,,0,0,0,,Айдың толық тұтылуы
Dialogue: 0,0:10:24.12,0:10:27.79,Default,,0,0,0,,Күн, Жер және Ай түзу сызықта
Dialogue: 0,0:10:28.41,0:10:31.25,Default,,0,0,0,,Ай Жердің көлеңкесінде толығымен жасырылған
Dialogue: 0,0:10:31.75,0:10:33.38,Default,,0,0,0,,Бұл өте ерекше күн.
Dialogue: 0,0:10:33.88,0:10:36.80,Default,,0,0,0,,Иә, мен оны үйрендім.
Dialogue: 0,0:10:37.38,0:10:39.63,Default,,0,0,0,,Оны бірінші рет көруім
Dialogue: 0,0:10:40.59,0:10:42.43,Default,,0,0,0,,-Аа... Айтпақшы - (Хан) А?
Dialogue: 0,0:10:42.51,0:10:45.43,Default,,0,0,0,,Хан бұл сағатта не істеп жатыр?
Dialogue: 0,0:10:45.51,0:10:48.35,Default,,0,0,0,,Мен... Айдың толық тұтылуын көруге бардым.
Dialogue: 0,0:10:48.85,0:10:50.10,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:10:50.19,0:10:52.44,Default,,0,0,0,,Жалғыз ба? Ал қалғандары ше?
Dialogue: 0,0:10:52.52,0:10:54.52,Default,,0,0,0,,А... Мен жалғызбын.
Dialogue: 0,0:10:54.61,0:10:55.44,Default,,0,0,0,,Олар қазір...
Dialogue: 0,0:10:55.52,0:10:57.11,Default,,0,0,0,,(Қасқырдың ұлыуы)
Dialogue: 0,0:10:57.19,0:10:57.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:58.44,0:10:59.70,Default,,0,0,0,,(Үш мүйізді) Құрлықтағыдай еркін қозғала алмайсың. Көресің әлі!
Dialogue: 0,0:10:59.78,0:11:00.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:00.86,0:11:02.45,Default,,0,0,0,,Бұл Суха
Dialogue: 0,0:11:02.53,0:11:04.99,Default,,0,0,0,,Қарсы болмасаң, мен сені үйіңе апара аламын ба?
Dialogue: 0,0:11:05.08,0:11:05.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:05.66,0:11:07.95,Default,,0,0,0,,Бүгін вампирлер де шықты, солай ма?
Dialogue: 0,0:11:08.45,0:11:09.41,Default,,0,0,0,,Себебі мен уайымдап тұрмын
Dialogue: 0,0:11:09.50,0:11:12.00,Default,,0,0,0,,Жарайды ма? рахмет
Dialogue: 0,0:11:12.08,0:11:14.84,Default,,0,0,0,,Негізі мен аздап қорықтым.
Dialogue: 0,0:11:14.92,0:11:17.92,Default,,0,0,0,,Вампирлер де, бірақ қаңғыбас иттер бар сияқты.
Dialogue: 0,0:11:18.01,0:11:19.13,Default,,0,0,0,,Қаңғыбас ит?
Dialogue: 0,0:11:19.22,0:11:22.80,Default,,0,0,0,,Иә, сіз мұны бұрын естіген жоқсыз ба? Айқай
Dialogue: 0,0:11:22.89,0:11:24.60,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:11:24.68,0:11:26.72,Default,,0,0,0,,Біреуге шабуыл жасамайсың ба?
Dialogue: 0,0:11:26.81,0:11:29.52,Default,,0,0,0,,Олай етпе! Әсіресе қасқыр
Dialogue: 0,0:11:29.60,0:11:31.31,Default,,0,0,0,,- Иә? -(Хан) О, жоқ...
Dialogue: 0,0:11:31.39,0:11:32.94,Default,,0,0,0,,Бұл дегеніміз...
Dialogue: 0,0:11:33.44,0:11:35.31,Default,,0,0,0,,Олар таңқаларлық мейірімді жануарлар.
Dialogue: 0,0:11:35.94,0:11:36.77,Default,,0,0,0,,Әрине
Dialogue: 0,0:11:37.27,0:11:39.11,Default,,0,0,0,,Бұл керемет Қасқыр
Dialogue: 0,0:11:39.19,0:11:41.53,Default,,0,0,0,,Не? Сіз шынымен солай ойлайсыз ба?
Dialogue: 0,0:11:41.61,0:11:43.45,Default,,0,0,0,,Суха да қасқырларды ұната ма?
Dialogue: 0,0:11:43.53,0:11:46.12,Default,,0,0,0,,Иә! Мен оны теледидардан немесе басқалардан көрмеймін.
Dialogue: 0,0:11:46.74,0:11:49.95,Default,,0,0,0,,Ақыр аяғында, шынды кездестіру қорқынышты болар еді.
Dialogue: 0,0:11:50.54,0:11:51.54,Default,,0,0,0,,Мен...
Dialogue: 0,0:11:52.83,0:11:54.88,Default,,0,0,0,,Онда мен оны сізге жіберемін.
Dialogue: 0,0:11:54.96,0:11:56.92,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:12:04.34,0:12:09.39,Default,,0,0,0,,(Қасқырдың ұлыуы)
Dialogue: 0,0:12:17.19,0:12:19.48,Default,,0,0,0,,Джино, бүгін бірдеңе болды ма?
Dialogue: 0,0:12:19.57,0:12:21.82,Default,,0,0,0,,Иә? Жоқ, шынымен емес
Dialogue: 0,0:12:23.03,0:12:24.28,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:12:24.36,0:12:26.41,Default,,0,0,0,,Иә? әдетте?
Dialogue: 0,0:12:30.83,0:12:32.62,Default,,0,0,0,,J-
Dialogue: 0,0:12:32.71,0:12:34.83,Default,,0,0,0,,Атыс жаттығуы Біз кездесіп жатырмыз, солай ма?
Dialogue: 0,0:12:34.92,0:12:36.08,Default,,0,0,0,,Қалғандар да дәл қазір барын салып еңбек етіп жатқан болар.
Dialogue: 0,0:12:36.17,0:12:37.25,Default,,0,0,0,,Ааа~
Dialogue: 0,0:12:37.33,0:12:38.67,Default,,0,0,0,,Хаа…
Dialogue: 0,0:12:39.17,0:12:41.88,Default,,0,0,0,,Нұх: Ол мәңгілікке лақтыра берді.
Dialogue: 0,0:12:41.96,0:12:42.76,Default,,0,0,0,,Йо
Dialogue: 0,0:12:43.26,0:12:45.59,Default,,0,0,0,,Иә? Сіз бірге болмадыңыз ба?
Dialogue: 0,0:12:45.68,0:12:46.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:46.68,0:12:48.51,Default,,0,0,0,,Жоқ, Шион...
Dialogue: 0,0:12:48.60,0:12:50.76,Default,,0,0,0,,Ах Шион
Dialogue: 0,0:12:52.10,0:12:53.60,Default,,0,0,0,,Өлім тіпті жаза да емес.
Dialogue: 0,0:12:53.68,0:12:54.56,Default,,0,0,0,,(Миямура) Ә? Онда, бәлкім, бұл Иура-кунге қайтаруды ұмытып қалған дискім шығар…
Dialogue: 0,0:12:54.64,0:12:57.02,Default,,0,0,0,,Мен Сухамен кездесе алмадым.
Dialogue: 0,0:12:57.10,0:12:59.32,Default,,0,0,0,,Аа, туған күн кеші.
Dialogue: 0,0:12:59.40,0:13:02.82,Default,,0,0,0,,Біз тым асықпасақ та, жақын арада көрісеміз.
Dialogue: 0,0:13:02.90,0:13:05.57,Default,,0,0,0,,Саған тез бергім келді~
Dialogue: 0,0:13:05.65,0:13:07.74,Default,,0,0,0,,Мен әр жерге барудан шаршадым.
Dialogue: 0,0:13:07.82,0:13:10.62,Default,,0,0,0,,Иә, иә, қиын болды.
Dialogue: 0,0:13:10.70,0:13:12.41,Default,,0,0,0,,Шаршасаңыз
Dialogue: 0,0:13:12.50,0:13:14.71,Default,,0,0,0,,Мен мұны Сухаға беремін.
Dialogue: 0,0:13:14.79,0:13:15.46,Default,,0,0,0,,Бұл не өзі?
Dialogue: 0,0:13:15.54,0:13:17.33,Default,,0,0,0,,Ян, жүр.
Dialogue: 0,0:13:17.83,0:13:19.21,Default,,0,0,0,,Онда мен саған беремін.
Dialogue: 0,0:13:19.29,0:13:19.79,Default,,0,0,0,,Джино?
Dialogue: 0,0:13:19.88,0:13:21.59,Default,,0,0,0,,Мен төбелескенді жөн көремін
Dialogue: 0,0:13:21.67,0:13:22.34,Default,,0,0,0,,Нұх?
Dialogue: 0,0:13:23.67,0:13:26.43,Default,,0,0,0,,Саған дұрыстап бере аламын ба деп уайымдай бастадым.
Dialogue: 0,0:13:26.51,0:13:28.01,Default,,0,0,0,,Мен оны саған бергенім жөн...
Dialogue: 0,0:13:28.09,0:13:29.80,Default,,0,0,0,,Жакаға дейін!
Dialogue: 0,0:13:29.89,0:13:30.93,Default,,0,0,0,,Иә
Dialogue: 0,0:13:31.01,0:13:33.14,Default,,0,0,0,,Барлығы орындады.
Dialogue: 0,0:13:33.22,0:13:34.81,Default,,0,0,0,,-Кешіріңіз -Жаман Жаман
Dialogue: 0,0:13:34.89,0:13:37.52,Default,,0,0,0,,Бұл біртүрлі нәрсе, солай емес пе?
Dialogue: 0,0:13:37.60,0:13:38.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:40.48,0:13:43.32,Default,,0,0,0,,Мен Сухамен кездескенге дейін, қашан және қайда болсам да
Dialogue: 0,0:13:43.40,0:13:46.45,Default,,0,0,0,,Мен өзімді «жалғыз біз» деп сезінсем де
Dialogue: 0,0:13:46.53,0:13:48.16,Default,,0,0,0,,Әрине
Dialogue: 0,0:13:48.24,0:13:50.83,Default,,0,0,0,,Мен біреуге қоңырау шалу туралы ешқашан ойлаған емеспін.
Dialogue: 0,0:13:50.91,0:13:52.66,Default,,0,0,0,,Мен кешті асыға күтемін.
Dialogue: 0,0:13:52.74,0:13:56.62,Default,,0,0,0,,Онда мен шақыруды дұрыс беруім керек.
Dialogue: 0,0:13:56.71,0:13:58.29,Default,,0,0,0,,Қалғандар да дәл қазір барын салып еңбек етіп жатқан болар.
Dialogue: 0,0:13:59.83,0:14:03.09,Default,,0,0,0,,Суха сол жерде шығар.
Dialogue: 0,0:14:08.09,0:14:09.68,Default,,0,0,0,,-Суха -Хмм?
Dialogue: 0,0:14:11.60,0:14:12.51,Default,,0,0,0,,Тікұшақ
Dialogue: 0,0:14:12.60,0:14:13.85,Default,,0,0,0,,Сіз кітап алуға келдіңіз бе?
Dialogue: 0,0:14:13.93,0:14:15.47,Default,,0,0,0,,Иә, тікұшақ ше?
Dialogue: 0,0:14:15.56,0:14:16.68,Default,,0,0,0,,Бүгін оралу
Dialogue: 0,0:14:16.77,0:14:19.31,Default,,0,0,0,,Ах... бұл алдыңғы кітап.
Dialogue: 0,0:14:19.40,0:14:21.77,Default,,0,0,0,,Иә, мен бәрін оқыдым.
Dialogue: 0,0:14:21.86,0:14:22.82,Default,,0,0,0,,Бұл қызықты болды ма?
Dialogue: 0,0:14:22.90,0:14:23.73,Default,,0,0,0,,Иә
Dialogue: 0,0:14:24.23,0:14:27.32,Default,,0,0,0,,Бұл ежелгі патшалықтың аңыздары туралы кітап.
Dialogue: 0,0:14:27.82,0:14:30.03,Default,,0,0,0,,Вампирлер мен қасқырлар да пайда болады
Dialogue: 0,0:14:30.11,0:14:32.45,Default,,0,0,0,,Вампирлер мен қасқырлар...
Dialogue: 0,0:14:32.53,0:14:37.75,Default,,0,0,0,,Олар ұзақ уақыт бойы атақты жау болды және олар жиі бірге пайда болады.
Dialogue: 0,0:14:38.25,0:14:40.25,Default,,0,0,0,,Иә~ Дұрыс.
Dialogue: 0,0:14:40.75,0:14:44.42,Default,,0,0,0,,Толық ай күндері қасқырлар қасқырға айналады, солай ма?
Dialogue: 0,0:14:44.50,0:14:45.80,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:14:45.88,0:14:49.59,Default,,0,0,0,,Айтпақшы, кеше Айдың толық тұтылуы болды, солай ма?
Dialogue: 0,0:14:49.68,0:14:50.34,Default,,0,0,0,,Иә
Dialogue: 0,0:14:50.43,0:14:53.26,Default,,0,0,0,,Өйткені, Айдың толық тұтылуы кезінде
Dialogue: 0,0:14:53.35,0:14:56.85,Default,,0,0,0,,Ай толса да, Ай көлеңкеде болады, сондықтан өзгере алмаймын ба?
Dialogue: 0,0:14:56.93,0:14:59.31,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:14:59.81,0:15:02.73,Default,,0,0,0,,Бірақ қасқыр ай толық тұтылған күні болды.
Dialogue: 0,0:15:02.81,0:15:05.48,Default,,0,0,0,,Сен бірінші көрген әйелге ғашық боласың дейді.
Dialogue: 0,0:15:06.07,0:15:09.07,Default,,0,0,0,,Мәңгі, менің өмірімде бір ғана адам
Dialogue: 0,0:15:09.15,0:15:11.36,Default,,0,0,0,,Эй, бұл жақсы.
Dialogue: 0,0:15:11.45,0:15:14.58,Default,,0,0,0,,Айдың тұтылуы сирек кездеседі.
Dialogue: 0,0:15:14.66,0:15:17.91,Default,,0,0,0,,Бұлай ғашық болу екіталай.
Dialogue: 0,0:15:18.00,0:15:19.16,Default,,0,0,0,,Әрине
Dialogue: 0,0:15:19.25,0:15:21.00,Default,,0,0,0,,Тікұшақ Айдың тұтылуын көрді ме?
Dialogue: 0,0:15:21.08,0:15:23.71,Default,,0,0,0,,Мен оны көрмедім. Мен ұйықтап қалдым.
Dialogue: 0,0:15:23.79,0:15:24.88,Default,,0,0,0,,Суханы көрдің бе?
Dialogue: 0,0:15:24.96,0:15:27.21,Default,,0,0,0,,Иә, мен оны бухтада көрдім...
Dialogue: 0,0:15:27.30,0:15:30.13,Default,,0,0,0,,Не? Одан кейін бухтаға бардың ба?
Dialogue: 0,0:15:30.63,0:15:31.18,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:15:31.26,0:15:34.80,Default,,0,0,0,,А... Мен түнде теңізді көргім келеді.
Dialogue: 0,0:15:35.55,0:15:39.85,Default,,0,0,0,,Мен кеше толық ай деп ойладым, бірақ мен оның өте қараңғы екенін түсіндім.
Dialogue: 0,0:15:39.93,0:15:42.73,Default,,0,0,0,,Хан маған Айдың толық тұтылу болғанын айтты.
Dialogue: 0,0:15:42.81,0:15:43.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:44.77,0:15:46.52,Default,,0,0,0,,Біз теңізде кездейсоқ кездестік.
Dialogue: 0,0:15:46.61,0:15:50.28,Default,,0,0,0,,Ай толық тұтылған түнде...ханмен бірге?
Dialogue: 0,0:15:50.36,0:15:53.78,Default,,0,0,0,,А... Иә, бұл не болды?
Dialogue: 0,0:15:53.86,0:15:56.08,Default,,0,0,0,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:15:56.16,0:15:57.79,Default,,0,0,0,,Келесі жолы мені де шақыр.
Dialogue: 0,0:15:57.87,0:15:58.91,Default,,0,0,0,,Иә
Dialogue: 0,0:15:59.41,0:16:01.75,Default,,0,0,0,,Ол бір сәт мұңайып көрінді.
Dialogue: 0,0:16:01.83,0:16:04.88,Default,,0,0,0,,Менің ханмен кездескенім ұнамай ма?
Dialogue: 0,0:16:05.46,0:16:07.92,Default,,0,0,0,,Маған да түнде теңіз қарау ұнайды.
Dialogue: 0,0:16:08.00,0:16:09.88,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:16:09.96,0:16:13.76,Default,,0,0,0,,Енді ойлап қарасам, неге тіл табыспай жатырмыз?
Dialogue: 0,0:16:13.84,0:16:15.64,Default,,0,0,0,,Мектептер бәсекелес болғандықтан ба?
Dialogue: 0,0:16:16.97,0:16:21.39,Default,,0,0,0,,Ол жыл сайын түнгі балда біріншілік үшін жарысатынын айтты.
Dialogue: 0,0:16:22.69,0:16:26.11,Default,,0,0,0,,Жақында матч болады, сондықтан мен қобалжыған сияқтымын.
Dialogue: 0,0:16:26.19,0:16:27.86,Default,,0,0,0,,Егер солай болса, онда оған көмектесу мүмкін емес.
Dialogue: 0,0:16:27.94,0:16:30.53,Default,,0,0,0,,Одан да кешегі күн ауыр болды.
Dialogue: 0,0:16:30.61,0:16:33.03,Default,,0,0,0,,Иә? Иә
Dialogue: 0,0:16:33.11,0:16:37.32,Default,,0,0,0,,Егер сіз әдеттен тыс бірдеңе байқасаңыз, маған бірден айтыңыз.
Dialogue: 0,0:16:39.95,0:16:41.91,Default,,0,0,0,,Жай ғана кездейсоқтық емес
Dialogue: 0,0:16:42.00,0:16:44.37,Default,,0,0,0,,Суханы мақсат еттіңіз бе?
Dialogue: 0,0:16:46.88,0:16:49.80,Default,,0,0,0,,А... иә, бәрібір.
Dialogue: 0,0:16:50.38,0:16:52.84,Default,,0,0,0,,Айтпақшы, мектеп өміріне үйреніп қалдыңыз ба?
Dialogue: 0,0:16:52.92,0:16:53.84,Default,,0,0,0,,Иә
Dialogue: 0,0:16:53.92,0:16:57.18,Default,,0,0,0,,Енді мен өмірімде бірінші рет мектептен ләззат алуым мүмкін.
Dialogue: 0,0:16:57.26,0:16:59.43,Default,,0,0,0,,А... түсіндім.
Dialogue: 0,0:17:00.01,0:17:02.68,Default,,0,0,0,,Мұның бәрі тікұшақтың арқасында. Рақмет сізге.
Dialogue: 0,0:17:02.77,0:17:04.27,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:04.77,0:17:07.19,Default,,0,0,0,,Суха көңілді болса жақсы болар еді
Dialogue: 0,0:17:07.27,0:17:10.40,Default,,0,0,0,,Өйткені тікұшақтың арқасында бәрімен дос бола алдым...
Dialogue: 0,0:17:10.48,0:17:11.78,Default,,0,0,0,,-Суха~ -Хмм?
Dialogue: 0,0:17:11.86,0:17:12.90,Default,,0,0,0,,Джино!
Dialogue: 0,0:17:13.40,0:17:15.40,Default,,0,0,0,,Мен кітапханада болдым.
Dialogue: 0,0:17:15.49,0:17:16.99,Default,,0,0,0,,Екеуің де кітап алғыларың келе ме?
Dialogue: 0,0:17:17.07,0:17:19.62,Default,,0,0,0,,Иә, бірақ тікұшақ қайтарылды.
Dialogue: 0,0:17:19.70,0:17:21.20,Default,,0,0,0,,Көремін, көремін.
Dialogue: 0,0:17:21.29,0:17:22.87,Default,,0,0,0,,Әркім де кітап алуы керек пе?
Dialogue: 0,0:17:22.95,0:17:26.71,Default,,0,0,0,,Көрініп тұр, менің хоббиім кітап оқу.
Dialogue: 0,0:17:26.79,0:17:30.50,Default,,0,0,0,,Мен кванттық механика оқулығын алдым.
Dialogue: 0,0:17:30.59,0:17:32.30,Default,,0,0,0,,Соңғы кездері мені қызықтырды.
Dialogue: 0,0:17:32.38,0:17:34.21,Default,,0,0,0,,Екеуің де өтірік айтпайсыңдар.
Dialogue: 0,0:17:34.30,0:17:36.63,Default,,0,0,0,,Нұх, сенде кітап төңкеріліп тұр.
Dialogue: 0,0:17:36.72,0:17:37.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:40.30,0:17:42.35,Default,,0,0,0,,Суха бар ма екен деп ойлап қалдым.
Dialogue: 0,0:17:42.93,0:17:46.02,Default,,0,0,0,,Шынымды айтсам, тікұшақтарды қоспағанда, мен онша оқырман емеспін.
Dialogue: 0,0:17:46.10,0:17:46.77,Default,,0,0,0,,Аха…
Dialogue: 0,0:17:46.85,0:17:48.69,Default,,0,0,0,,Оны бөліп алмаңыз
Dialogue: 0,0:17:49.19,0:17:51.02,Default,,0,0,0,,-3 жолды оқыдым -О...
Dialogue: 0,0:17:51.11,0:17:53.73,Default,,0,0,0,,Айтпақшы, сіз не туралы айттыңыз?
Dialogue: 0,0:17:53.82,0:17:54.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:54.82,0:17:57.24,Default,,0,0,0,,Мен Хериден қандай кітап оқитынын сұрадым.
Dialogue: 0,0:17:57.32,0:18:00.37,Default,,0,0,0,,Бұл ежелгі патшалық туралы әңгіме.
Dialogue: 0,0:18:00.45,0:18:02.95,Default,,0,0,0,,Қасқырлар мен вампирлер де пайда болады
Dialogue: 0,0:18:03.04,0:18:03.95,Default,,0,0,0,,Қасқыр?
Dialogue: 0,0:18:04.45,0:18:05.20,Default,,0,0,0,,Иә
Dialogue: 0,0:18:05.29,0:18:07.33,Default,,0,0,0,,Хели романтикалық қасқырдың оқиғасын баяндайды
Dialogue: 0,0:18:07.41,0:18:08.83,Default,,0,0,0,,Ол маған айтты.
Dialogue: 0,0:18:08.92,0:18:09.54,Default,,0,0,0,,Не?
Dialogue: 0,0:18:09.63,0:18:12.04,Default,,0,0,0,,Айдың толық тұтылуы кезіндегі қасқырлар
Dialogue: 0,0:18:12.13,0:18:14.96,Default,,0,0,0,,Сен бірінші көрген әйелге ғашық боласың дейді.
Dialogue: 0,0:18:15.05,0:18:17.05,Default,,0,0,0,,Тек сол адам мәңгілік
Dialogue: 0,0:18:17.13,0:18:20.09,Default,,0,0,0,,Бұл өте романтикалық, солай емес пе?
Dialogue: 0,0:18:22.30,0:18:23.43,Default,,0,0,0,,О, Құдай-ай…
Dialogue: 0,0:18:23.51,0:18:27.68,Default,,0,0,0,,Солай болса да қасқыр ит сияқты, солай ма?
Dialogue: 0,0:18:27.77,0:18:31.06,Default,,0,0,0,,Дұрыс, егер сіз жақын жерде болсаңыз, шашыңыздың түсуі қиын болады.
Dialogue: 0,0:18:31.15,0:18:32.73,Default,,0,0,0,,Сіз түшкіруді тоқтата алмайсыз.
Dialogue: 0,0:18:33.36,0:18:35.44,Default,,0,0,0,,Оны қасқыр деп атайды.
Dialogue: 0,0:18:35.53,0:18:38.49,Default,,0,0,0,,Оның 10%-дан азы адам екені айтылады.
Dialogue: 0,0:18:38.57,0:18:39.53,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:18:41.99,0:18:44.45,Default,,0,0,0,,О, Солон сонда болды ма?
Dialogue: 0,0:18:44.95,0:18:46.87,Default,,0,0,0,,Бұл...бұл...
Dialogue: 0,0:18:46.95,0:18:51.96,Default,,0,0,0,,Жартылай қаңғыбас иттер болған адамдар жай ғана жабайы, ақымақ және арсыз.
Dialogue: 0,0:18:52.04,0:18:55.42,Default,,0,0,0,,Маған бұлай көп айтудың қажеті жоқ.
Dialogue: 0,0:18:55.50,0:18:58.17,Default,,0,0,0,,Суха қасқырлар туралы аңыздардың романтикалық екенін айтады...
Dialogue: 0,0:18:58.26,0:19:02.51,Default,,0,0,0,,Айдың толық тұтылуы кезінде алғаш рет көрген адамға ғашық боласыз ба?
Dialogue: 0,0:19:02.59,0:19:04.68,Default,,0,0,0,,Бұл жай ғана ақымақтық.
Dialogue: 0,0:19:04.76,0:19:07.81,Default,,0,0,0,,Вампирлер сөзсіз... жақсырақ.
Dialogue: 0,0:19:07.89,0:19:08.98,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:19:09.06,0:19:10.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:10.14,0:19:13.98,Default,,0,0,0,,Вампирлерде махаббат мүлде болмайды.
Dialogue: 0,0:19:14.06,0:19:15.19,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:15.27,0:19:18.07,Default,,0,0,0,,Адамның мейірімді жүрегі мүлдем жоқ!
Dialogue: 0,0:19:18.65,0:19:19.90,Default,,0,0,0,,Негізі кеше
Dialogue: 0,0:19:19.99,0:19:22.78,Default,,0,0,0,,Кенет маған шабуыл жасады
Dialogue: 0,0:19:22.87,0:19:25.20,Default,,0,0,0,,Және...
Dialogue: 0,0:19:25.28,0:19:29.45,Default,,0,0,0,,Жазықсыз адамдарды өлтіріп, оларды вампирге айналдыру!
Dialogue: 0,0:19:29.96,0:19:33.04,Default,,0,0,0,,Сондықтан да сен махаббаттың не екенін білмейсің.
Dialogue: 0,0:19:33.13,0:19:36.63,Default,,0,0,0,,Вампирлер жай ғана суық, қатыгез құбыжықтар!
Dialogue: 0,0:19:36.71,0:19:39.17,Default,,0,0,0,,Қасқырлар әлдеқайда жақсы!
Dialogue: 0,0:19:39.26,0:19:41.88,Default,,0,0,0,,Жоқ, салыстырудың қажеті жоқ.
Dialogue: 0,0:19:41.97,0:19:44.55,Default,,0,0,0,,Вампирлер - ең нашар!
Dialogue: 0,0:19:47.85,0:19:50.06,Default,,0,0,0,,Ах... Уау, мен...
Dialogue: 0,0:19:50.14,0:19:52.98,Default,,0,0,0,,Кешіріңіз... Кешіріңіз, кенет ашуланып кеттім.
Dialogue: 0,0:19:53.06,0:19:55.02,Default,,0,0,0,,Бол... Жарайды.
Dialogue: 0,0:19:55.11,0:19:57.98,Default,,0,0,0,,Біз алдымен қажетсіз нәрсені айттық.
Dialogue: 0,0:19:58.48,0:20:00.03,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:20:00.11,0:20:02.49,Default,,0,0,0,,Суханың кешірім сұрауы емес.
Dialogue: 0,0:20:02.57,0:20:03.53,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:20:03.61,0:20:05.66,Default,,0,0,0,,Әр адам үшін әр түрлі.
Dialogue: 0,0:20:05.74,0:20:06.74,Default,,0,0,0,,Иә
Dialogue: 0,0:20:06.83,0:20:11.41,Default,,0,0,0,,Мен... вампирлерді қатты жек көремін.
Dialogue: 0,0:20:11.50,0:20:12.37,Default,,0,0,0,,Иә
Dialogue: 0,0:20:12.87,0:20:14.58,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:20:15.17,0:20:17.79,Default,,0,0,0,,Вампирлерді барлығы жек көреді.
Dialogue: 0,0:20:24.89,0:20:28.43,Default,,0,0,0,,Түсіндім, мен досымды вампирге айналдырдым...
Dialogue: 0,0:20:28.51,0:20:30.93,Default,,0,0,0,,А, солай...
Dialogue: 0,0:20:31.02,0:20:32.85,Default,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:20:33.35,0:20:35.73,Default,,0,0,0,,Суханың күші зор, солай ма?
Dialogue: 0,0:20:35.81,0:20:37.19,Default,,0,0,0,,Адамнан тыс күш туралы не деуге болады?
Dialogue: 0,0:20:37.69,0:20:40.73,Default,,0,0,0,,Сол себепті мен вампир деп қателестім.
Dialogue: 0,0:20:40.82,0:20:43.90,Default,,0,0,0,,Менің ойымша, сіз осы уақытқа дейін көп қиыншылықтарды бастан өткердіңіз.
Dialogue: 0,0:20:45.03,0:20:47.41,Default,,0,0,0,,Сонымен не істеуіміз керек?
Dialogue: 0,0:20:49.16,0:20:51.58,Default,,0,0,0,,Мен мұны бере алмадым.
Dialogue: 0,0:20:52.16,0:20:54.37,Default,,0,0,0,,Шион үшін де мүмкін емес пе еді?
Dialogue: 0,0:20:54.46,0:20:55.42,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:55.50,0:20:57.79,Default,,0,0,0,,Мен атмосфераны шынымен оқыдым!
Dialogue: 0,0:20:57.88,0:21:01.55,Default,,0,0,0,,Мен сізді туған күн кешіңізге шақыра алмауым мүмкін.
Dialogue: 0,0:21:09.47,0:21:10.31,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:28.03,0:21:30.28,Default,,0,0,0,,Мен кеше толық ай деп ойладым
Dialogue: 0,0:21:30.37,0:21:32.33,Default,,0,0,0,,Егер сіз тым қараңғы деп ойласаңыз
Dialogue: 0,0:21:32.41,0:21:35.71,Default,,0,0,0,,Хан маған Айдың толық тұтылу болғанын айтты.
Dialogue: 0,0:21:52.72,0:21:55.31,Default,,0,0,0,,Ақыры... таптым.
Dialogue: 0,0:21:56.06,0:21:58.06,Default,,0,0,0,,♪～
Dialogue: 0,0:23:21.40,0:23:23.40,Default,,0,0,0,,～♪
Dialogue: 0,0:23:34.91,0:23:37.16,Default,,0,0,0,,Келесі 5 эпизод
Dialogue: 0,0:23:37.66,0:23:40.58,Default,,0,0,0,,«Өсіп бара жатқан ай - Мойнымды тістеп ал-»
Dialogue: 0,0:23:42.08,0:23:48.08,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory