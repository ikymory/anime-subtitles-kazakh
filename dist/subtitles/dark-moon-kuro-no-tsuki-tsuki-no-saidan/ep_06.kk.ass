Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.79,0:00:03.79,Default,,0,0,0,,♪～
Dialogue: 0,0:01:28.42,0:01:30.42,Default,,0,0,0,,～♪
Dialogue: 0,0:01:38.55,0:01:39.68,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:39.76,0:01:43.10,Default,,0,0,0,,Сәлем, Суха!
Dialogue: 0,0:01:43.18,0:01:44.18,Default,,0,0,0,,(Кашиваги) Олай деу дұрыс па?
Dialogue: 0,0:01:44.27,0:01:45.93,Default,,0,0,0,,Мен көптен күттім!
Dialogue: 0,0:01:47.69,0:01:49.31,Default,,0,0,0,,Бұл керемет жер.
Dialogue: 0,0:01:49.40,0:01:51.27,Default,,0,0,0,,Не? Денің сау ма? (Миямура) Иә.
Dialogue: 0,0:01:51.36,0:01:54.23,Default,,0,0,0,,Бұл орманның ортасында, сондықтан келу қиын болған шығар.
Dialogue: 0,0:01:54.32,0:01:57.57,Default,,0,0,0,,Сиондық жігіт «Мен оны салдым» деген сияқты сөздерді айтады.
Dialogue: 0,0:01:57.65,0:01:59.91,Default,,0,0,0,,Жарайды, өтірік айтпайсың ғой?
Dialogue: 0,0:01:59.99,0:02:00.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:00.57,0:02:05.37,Default,,0,0,0,,Бұл біз ұзақ уақыт бойы тапқан ақшаға алған нәрсеміз.
Dialogue: 0,0:02:05.45,0:02:06.87,Default,,0,0,0,,"Дегенмен ол жүгірді."
Dialogue: 0,0:02:06.96,0:02:08.29,Default,,0,0,0,,- (Хан) Суха! -иә?
Dialogue: 0,0:02:08.37,0:02:09.87,Default,,0,0,0,,Бұл солтүстік-батырдағы қала ма?
Dialogue: 0,0:02:10.38,0:02:11.84,Default,,0,0,0,,Хан!
Dialogue: 0,0:02:11.92,0:02:13.29,Default,,0,0,0,,Йо...й
Dialogue: 0,0:02:13.96,0:02:15.34,Default,,0,0,0,,Біз тағы кездестік.
Dialogue: 0,0:02:15.42,0:02:17.34,Default,,0,0,0,,Не? Денің сау ма? (Миямура) Иә.
Dialogue: 0,0:02:17.42,0:02:19.09,Default,,0,0,0,,Барлығы да бақытты болатынына сенімдімін.
Dialogue: 0,0:02:19.18,0:02:21.09,Default,,0,0,0,,Дұрыс емес.
Dialogue: 0,0:02:21.72,0:02:24.64,Default,,0,0,0,,Бұл жай ғана әлеуметтік сәлемдесу болды, бірақ мен мұнда шынымен келдім.
Dialogue: 0,0:02:24.72,0:02:26.60,Default,,0,0,0,,Ауаны оқымаңыз
Dialogue: 0,0:02:26.68,0:02:28.56,Default,,0,0,0,,Балалар сендерге ұқсайды.
Dialogue: 0,0:02:28.64,0:02:32.31,Default,,0,0,0,,Әй, келмесеңдер қуанасыңдар.
Dialogue: 0,0:02:32.40,0:02:33.82,Default,,0,0,0,,Бұл әдейі.
Dialogue: 0,0:02:33.90,0:02:34.40,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:02:36.19,0:02:38.19,Default,,0,0,0,,А... Әй, эй.
Dialogue: 0,0:02:38.28,0:02:39.65,Default,,0,0,0,,Әзірге ішке кіріңіз.
Dialogue: 0,0:02:42.07,0:02:42.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:47.54,0:02:51.00,Default,,0,0,0,,Уау, бұл керемет!
Dialogue: 0,0:02:51.62,0:02:56.46,Default,,0,0,0,,Мені туған күн кешіне бірінші рет шақырып отыр.
Dialogue: 0,0:02:56.55,0:02:58.17,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:02:58.26,0:02:59.05,Default,,0,0,0,,Дәлірек айтқанда
Dialogue: 0,0:02:59.13,0:03:01.97,Default,,0,0,0,,Мен ешқашан достарымды туған күніме шақырған емеспін.
Dialogue: 0,0:03:02.59,0:03:04.80,Default,,0,0,0,,Сондықтан бізде осындай адамдар көп жиналды
Dialogue: 0,0:03:04.89,0:03:06.39,Default,,0,0,0,,Мен оны асыға күттім.
Dialogue: 0,0:03:06.47,0:03:09.89,Default,,0,0,0,,Біз де ойындар дайындадық, ендеше қызық болайық!
Dialogue: 0,0:03:09.98,0:03:11.23,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:11.31,0:03:12.52,Default,,0,0,0,,Уау...
Dialogue: 0,0:03:13.65,0:03:17.44,Default,,0,0,0,,Тыңдаңдар, мен сендерге сенгендей емеспін.
Dialogue: 0,0:03:17.53,0:03:19.69,Default,,0,0,0,,Бұл жерде де солай.
Dialogue: 0,0:03:20.95,0:03:22.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:22.57,0:03:24.12,Default,,0,0,0,,- Дұрыс па? -Хаха солай ма?
Dialogue: 0,0:03:24.20,0:03:26.91,Default,,0,0,0,,Дегенмен, мен әлі күн бойы Толық шоғырланған тыныс алуды ұстап тұра алмаймын.
Dialogue: 0,0:03:31.83,0:03:34.96,Default,,0,0,0,,Баршаңызды туған күніңізбен құттықтаймын!
Dialogue: 0,0:03:35.04,0:03:36.38,Default,,0,0,0,,Рахмет
Dialogue: 0,0:03:37.92,0:03:39.13,Default,,0,0,0,,Рахмет
Dialogue: 0,0:03:40.51,0:03:41.67,Default,,0,0,0,,Рахмет
Dialogue: 0,0:03:41.76,0:03:45.09,Default,,0,0,0,,Туған күнің құтты болсын
Dialogue: 0,0:03:45.18,0:03:47.81,Default,,0,0,0,,Сізге де рахмет
Dialogue: 0,0:03:47.89,0:03:50.22,Default,,0,0,0,,А, бүгін көңілді болайық.
Dialogue: 0,0:03:50.31,0:03:51.68,Default,,0,0,0,,Батылдық
Dialogue: 0,0:03:58.07,0:03:59.40,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:03:59.48,0:04:00.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:00.32,0:04:01.90,Default,,0,0,0,,Алдыңғы электрондық пошта...
Dialogue: 0,0:04:01.99,0:04:04.70,Default,,0,0,0,,Иә, рахмет
Dialogue: 0,0:04:04.78,0:04:07.70,Default,,0,0,0,,Иә? Сухаға хат жаздыңыз ба?
Dialogue: 0,0:04:07.78,0:04:08.28,Default,,0,0,0,,Ой…
Dialogue: 0,0:04:08.99,0:04:11.08,Default,,0,0,0,,Неліктен рұқсатсыз сөйлесіп жатырсыз?
Dialogue: 0,0:04:11.58,0:04:13.12,Default,,0,0,0,,-де не айттыңыз?
Dialogue: 0,0:04:13.21,0:04:14.12,Default,,0,0,0,,Эмилияның фракциясы мен Куруштың фракциясы арасындағы тең шарттардағы одақ.
Dialogue: 0,0:04:14.62,0:04:15.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:16.46,0:04:19.21,Default,,0,0,0,,Бала қасқыр?
Dialogue: 0,0:04:20.84,0:04:23.17,Default,,0,0,0,,Мен сізге фото жіберіп жатыр едім.
Dialogue: 0,0:04:23.26,0:04:25.22,Default,,0,0,0,,Мен сүйкімді деп ойлаған фотосурет
Dialogue: 0,0:04:25.30,0:04:26.55,Default,,0,0,0,,Назар аударуға тырысу
Dialogue: 0,0:04:27.05,0:04:28.60,Default,,0,0,0,,Елеусіз жігіт
Dialogue: 0,0:04:29.10,0:04:31.02,Default,,0,0,0,,Дұрыс па? Сүйкімді емес пе?
Dialogue: 0,0:04:31.60,0:04:32.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:33.35,0:04:35.85,Default,,0,0,0,,Бұл рас! Сондай сүйкімді!
Dialogue: 0,0:04:35.94,0:04:37.06,Default,,0,0,0,,Маған да жібер
Dialogue: 0,0:04:37.15,0:04:38.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:38.56,0:04:41.61,Default,,0,0,0,,Хан жануарларды жақсы көреді.
Dialogue: 0,0:04:41.69,0:04:44.03,Default,,0,0,0,,Сондай-ақ осы және осы сияқты басқа да нәрселер бар ...
Dialogue: 0,0:04:44.11,0:04:45.45,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ
Dialogue: 0,0:04:45.53,0:04:47.57,Default,,0,0,0,,Бұл жігіт жануарларды ұнатпайды.
Dialogue: 0,0:04:47.66,0:04:49.33,Default,,0,0,0,,-Уау! -Мен көшіп жатырмын...
Dialogue: 0,0:04:49.83,0:04:52.41,Default,,0,0,0,,Көбінесе қасқырдың суреттері.
Dialogue: 0,0:04:52.50,0:04:53.00,Default,,0,0,0,,Хехе
Dialogue: 0,0:04:54.08,0:04:57.25,Default,,0,0,0,,Иә, өйткені мен қасқырларды жақсы көремін.
Dialogue: 0,0:04:57.33,0:04:59.92,Default,,0,0,0,,Бірақ, шынымен, мен мысықтарды жақсы көремін.
Dialogue: 0,0:05:00.00,0:05:01.67,Default,,0,0,0,,Уф... Буух
Dialogue: 0,0:05:02.17,0:05:03.26,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:05:03.34,0:05:04.84,Default,,0,0,0,,Upupupu…
Dialogue: 0,0:05:04.92,0:05:06.76,Default,,0,0,0,,Хан? Не болды?
Dialogue: 0,0:05:07.68,0:05:09.60,Default,,0,0,0,,Жоқ... бұл ештеңе емес.
Dialogue: 0,0:05:10.39,0:05:12.56,Default,,0,0,0,,Тағы, тағы!
Dialogue: 0,0:05:12.64,0:05:13.60,Default,,0,0,0,,Хехе
Dialogue: 0,0:05:19.15,0:05:19.98,Default,,0,0,0,,Иә
Dialogue: 0,0:05:20.65,0:05:22.44,Default,,0,0,0,,Мен оларды соншалықты ұнатпаймын...
Dialogue: 0,0:05:22.53,0:05:24.24,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:25.40,0:05:26.28,Default,,0,0,0,,Мен оны аша аламын ба?
Dialogue: 0,0:05:27.70,0:05:28.91,Default,,0,0,0,,Әрине!
Dialogue: 0,0:05:35.08,0:05:37.29,Default,,0,0,0,,Вампирге қарсы заттар.
Dialogue: 0,0:05:37.37,0:05:40.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:41.38,0:05:43.71,Default,,0,0,0,,Соңғы кездері қиыншылық көп емес пе?
Dialogue: 0,0:05:43.80,0:05:45.55,Default,,0,0,0,,Мен де барлығына сақ болғанын қалаймын.
Dialogue: 0,0:05:45.63,0:05:46.67,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:46.76,0:05:47.84,Default,,0,0,0,,Хо…
Dialogue: 0,0:05:48.34,0:05:51.43,Default,,0,0,0,,Аа... Рахмет, қадірлеймін.
Dialogue: 0,0:05:51.51,0:05:54.10,Default,,0,0,0,,(Хандардың күлкісі)
Dialogue: 0,0:05:54.18,0:05:56.98,Default,,0,0,0,,Уау, өте жақсы дәм
Dialogue: 0,0:05:57.06,0:06:00.19,Default,,0,0,0,,Сонда оларға вампирлер шабуыл жасамайды ма?
Dialogue: 0,0:06:00.27,0:06:02.23,Default,,0,0,0,,Суха шынымен мейірімді.
Dialogue: 0,0:06:02.94,0:06:06.15,Default,,0,0,0,,Балалар, сендер де осындай бірдеңені әкелдіңдер ме?
Dialogue: 0,0:06:06.24,0:06:07.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:07.78,0:06:09.91,Default,,0,0,0,,Әрине, мен әкелдім.
Dialogue: 0,0:06:09.99,0:06:11.20,Default,,0,0,0,,- Хи хи - Ах
Dialogue: 0,0:06:11.28,0:06:11.95,Default,,0,0,0,,Хехе
Dialogue: 0,0:06:12.03,0:06:15.16,Default,,0,0,0,,Туған күнің құтты болсын
Dialogue: 0,0:06:17.25,0:06:18.58,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:19.62,0:06:20.92,Default,,0,0,0,,Ах! ол
Dialogue: 0,0:06:21.00,0:06:23.59,Default,,0,0,0,,Біздің де талғамымыз керемет, солай ма?
Dialogue: 0,0:06:23.67,0:06:27.13,Default,,0,0,0,,Бұл сәл асып кетті, бірақ сізде қанша болғаны маңызды емес, солай ма?
Dialogue: 0,0:06:27.22,0:06:28.47,Default,,0,0,0,,Вампирге қарсы заттар
Dialogue: 0,0:06:29.55,0:06:32.01,Default,,0,0,0,,Бұл қымбат, күміс шар еді.
Dialogue: 0,0:06:32.10,0:06:33.10,Default,,0,0,0,,Міне, алыңыз.
Dialogue: 0,0:06:33.18,0:06:34.68,Default,,0,0,0,,-Уау -Уау...
Dialogue: 0,0:06:35.89,0:06:37.60,Default,,0,0,0,,Рахмет
Dialogue: 0,0:06:37.68,0:06:39.48,Default,,0,0,0,,Мен оны бағалаймын
Dialogue: 0,0:06:39.56,0:06:41.35,Default,,0,0,0,,Уф, тым қызықсыз екен.
Dialogue: 0,0:06:41.44,0:06:44.32,Default,,0,0,0,,Егер сізде осы репеллент заттарының барлығы болса, өзіңізді қауіпсіз сезінесіз.
Dialogue: 0,0:06:44.40,0:06:47.28,Default,,0,0,0,,Мм... иә, көп рахмет.
Dialogue: 0,0:06:47.36,0:06:50.41,Default,,0,0,0,,Эй, сенің реакцияларың соншалықты тітіркендіргіш пе?
Dialogue: 0,0:06:50.49,0:06:52.12,Default,,0,0,0,,Бақытты болыңыз.
Dialogue: 0,0:06:52.20,0:06:53.49,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:06:53.57,0:06:56.45,Default,,0,0,0,,Иә? Мүмкін сізге ұнамаған шығар?
Dialogue: 0,0:06:56.95,0:06:58.50,Default,,0,0,0,,Мен өте қуаныштымын
Dialogue: 0,0:06:58.58,0:07:00.83,Default,,0,0,0,,Мен қалаған нәрсе
Dialogue: 0,0:07:00.92,0:07:02.71,Default,,0,0,0,,Мен осы Тахерді таңдағаныма қуаныштымын
Dialogue: 0,0:07:02.79,0:07:03.79,Default,,0,0,0,,Міне!
Dialogue: 0,0:07:03.88,0:07:06.21,Default,,0,0,0,,Эй, сен оны таңдадың.
Dialogue: 0,0:07:06.71,0:07:07.96,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:07:08.05,0:07:08.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:09.59,0:07:10.26,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:07:11.30,0:07:13.51,Default,,0,0,0,,Маған? рахмет
Dialogue: 0,0:07:14.26,0:07:15.64,Default,,0,0,0,,Бірақ неге?
Dialogue: 0,0:07:15.72,0:07:18.81,Default,,0,0,0,,Ал... әйтеуір
Dialogue: 0,0:07:18.89,0:07:20.02,Default,,0,0,0,,Оны тез ашыңыз
Dialogue: 0,0:07:20.81,0:07:21.77,Default,,0,0,0,,Хехе
Dialogue: 0,0:07:22.35,0:07:23.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:24.19,0:07:25.61,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:07:25.69,0:07:28.40,Default,,0,0,0,,Бұл қандай сүйкімді?!
Dialogue: 0,0:07:28.48,0:07:30.74,Default,,0,0,0,,Бұл қасқырдың баласы.
Dialogue: 0,0:07:30.82,0:07:31.65,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:31.74,0:07:34.78,Default,,0,0,0,,Бұл мен көрген ең сүйкімді фото!
Dialogue: 0,0:07:35.45,0:07:36.66,Default,,0,0,0,,Дегенмен, мен әлі күн бойы Толық шоғырланған тыныс алуды ұстап тұра алмаймын.
Dialogue: 0,0:07:37.24,0:07:39.16,Default,,0,0,0,,Сізге ұнағанына қуаныштымын.
Dialogue: 0,0:07:41.12,0:07:43.42,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:07:49.13,0:07:50.55,Default,,0,0,0,,Сіз көңіл көтересіз бе?
Dialogue: 0,0:07:51.05,0:07:52.30,Default,,0,0,0,,Рей-чан бүгін жақсы бала болғаны үшін 60 ұпай алады!
Dialogue: 0,0:07:52.80,0:07:56.30,Default,,0,0,0,,Бұл ерекше сәлемдесу.
Dialogue: 0,0:07:58.14,0:07:59.89,Default,,0,0,0,,Сіздің көшбасшыңыз
Dialogue: 0,0:08:00.39,0:08:03.60,Default,,0,0,0,,Сухамен Ай толық тұтылған түнде кездескеніңізді естідім.
Dialogue: 0,0:08:04.27,0:08:05.02,Default,,0,0,0,,О
Dialogue: 0,0:08:05.52,0:08:06.56,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:08:06.65,0:08:09.40,Default,,0,0,0,,Адам қызға қасқыр ғашық болса да
Dialogue: 0,0:08:09.48,0:08:11.19,Default,,0,0,0,,Сіз осылай айтасыз ба?
Dialogue: 0,0:08:12.49,0:08:14.78,Default,,0,0,0,,Осы тұста анық айтайын.
Dialogue: 0,0:08:14.86,0:08:16.45,Default,,0,0,0,,Мен сендерден ерекшемін
Dialogue: 0,0:08:17.91,0:08:18.78,Default,,0,0,0,,Фу…
Dialogue: 0,0:08:18.87,0:08:19.91,Default,,0,0,0,,Хмм…
Dialogue: 0,0:08:20.41,0:08:22.54,Default,,0,0,0,,Мен мұны ирониялық деп ойладым.
Dialogue: 0,0:08:23.04,0:08:24.96,Default,,0,0,0,,Сіз сол түнде болдыңыз...
Dialogue: 0,0:08:28.79,0:08:31.51,Default,,0,0,0,,Біздікіндей болды.
Dialogue: 0,0:08:32.17,0:08:33.80,Default,,0,0,0,,Солай болса екен
Dialogue: 0,0:08:33.88,0:08:36.18,Default,,0,0,0,,Көне алмай қиналып жүргендер бар.
Dialogue: 0,0:08:38.43,0:08:39.35,Default,,0,0,0,,Сол бет – белгі, көріп тұрсың ба.
Dialogue: 0,0:08:39.43,0:08:42.85,Default,,0,0,0,,Олай болса, ойындардың уақыты келді.
Dialogue: 0,0:08:47.94,0:08:49.36,Default,,0,0,0,,Қолымды жазып бергенімдегі жақсылығымды ұмытып қалдың ба…
Dialogue: 0,0:08:49.86,0:08:51.61,Default,,0,0,0,,«Қасқыр» ойыны!
Dialogue: 0,0:08:52.61,0:08:54.11,Default,,0,0,0,,Қасқыр ойыны дегеніміз не?
Dialogue: 0,0:08:54.20,0:08:56.11,Default,,0,0,0,,-Аа? -Эх~
Dialogue: 0,0:08:56.20,0:08:59.53,Default,,0,0,0,,Бұл кім өтірік айтып тұрғанын анықтау ойыны.
Dialogue: 0,0:09:00.03,0:09:01.87,Default,,0,0,0,,Әй, бұл қызық көрінеді!
Dialogue: 0,0:09:01.95,0:09:04.83,Default,,0,0,0,,Бұл кешке өте ыңғайлы, солай ма?
Dialogue: 0,0:09:06.54,0:09:07.63,Default,,0,0,0,,Тез орындайық
Dialogue: 0,0:09:08.38,0:09:11.13,Default,,0,0,0,,Онда мен ойын шебері боламын.
Dialogue: 0,0:09:13.09,0:09:17.34,Default,,0,0,0,,Баршаңызға, бұл ауыл адамдары бақытты өмір сүретін ауыл.
Dialogue: 0,0:09:18.05,0:09:21.60,Default,,0,0,0,,Бірақ бір қасқыр ауылға келіп, адамға айналады.
Dialogue: 0,0:09:22.22,0:09:24.89,Default,,0,0,0,,Күн сайын түнде ауыл тұрғындарына шабуыл жасай бастады
Dialogue: 0,0:09:25.48,0:09:30.61,Default,,0,0,0,,Енді ауыл тұрғындарын алдап жүрген зұлым қасқырды табыңыз.
Dialogue: 0,0:09:31.11,0:09:32.94,Default,,0,0,0,,Көзіңізді жұмыңыз
Dialogue: 0,0:09:34.24,0:09:36.61,Default,,0,0,0,,Енді жай қасқыр, көзіңді ашшы.
Dialogue: 0,0:09:41.20,0:09:42.66,Default,,0,0,0,,Ғажап...
Dialogue: 0,0:09:43.29,0:09:44.91,Default,,0,0,0,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:09:45.00,0:09:46.08,Default,,0,0,0,,Олар табады.
Dialogue: 0,0:09:47.62,0:09:50.00,Default,,0,0,0,,Міне, таң атты.
Dialogue: 0,0:09:50.08,0:09:52.71,Default,,0,0,0,,Бәрің көзіңді ашыңдар.
Dialogue: 0,0:10:04.81,0:10:07.27,Default,,0,0,0,,Олай болса, көп ұзамай,
Dialogue: 0,0:10:07.35,0:10:10.73,Default,,0,0,0,,Қасқыр кім екенін талқылаңыз.
Dialogue: 0,0:10:10.81,0:10:13.98,Default,,0,0,0,,Қалай қарасаң да, сендердің біреулерің шығар.
Dialogue: 0,0:10:14.07,0:10:15.15,Default,,0,0,0,,- Иә? -а?
Dialogue: 0,0:10:15.23,0:10:16.99,Default,,0,0,0,,-Дұрыс -Иә, Иә
Dialogue: 0,0:10:17.57,0:10:20.24,Default,,0,0,0,,Жоқ, бұл шешім қабылдауға әлі ерте.
Dialogue: 0,0:10:20.32,0:10:22.70,Default,,0,0,0,,Суханың ойынша қасқыр кім?
Dialogue: 0,0:10:22.78,0:10:24.83,Default,,0,0,0,,Мен? Ал...
Dialogue: 0,0:10:24.91,0:10:27.37,Default,,0,0,0,,Мүмкін түнде кім екенін тауып алармын.
Dialogue: 0,0:10:27.46,0:10:29.75,Default,,0,0,0,,Суха – көріпкел.
Dialogue: 0,0:10:29.83,0:10:30.37,Default,,0,0,0,,Иә
Dialogue: 0,0:10:30.46,0:10:32.59,Default,,0,0,0,,О, айтпақшы, мен рыцарьмын.
Dialogue: 0,0:10:32.67,0:10:34.38,Default,,0,0,0,,Жоқ, сен!
Dialogue: 0,0:10:34.46,0:10:35.96,Default,,0,0,0,,- Сен ақымақсың ба? - А?
Dialogue: 0,0:10:36.05,0:10:37.30,Default,,0,0,0,,Хаа…
Dialogue: 0,0:10:37.38,0:10:38.01,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:38.09,0:10:41.47,Default,,0,0,0,,Ах, а... А, шынымен.
Dialogue: 0,0:10:41.55,0:10:44.18,Default,,0,0,0,,О, мен... мен рыцарьмын.
Dialogue: 0,0:10:44.26,0:10:45.72,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:10:46.39,0:10:49.39,Default,,0,0,0,,Эй... онда мені қорғашы.
Dialogue: 0,0:10:49.48,0:10:51.23,Default,,0,0,0,,Сондай-ақ... Әрине!
Dialogue: 0,0:10:51.31,0:10:54.57,Default,,0,0,0,,Кукукуку Мен түнді асыға күтемін.
Dialogue: 0,0:10:54.65,0:10:56.40,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:10:57.57,0:10:59.99,Default,,0,0,0,,Міне, уақыт та қалды.
Dialogue: 0,0:11:00.07,0:11:03.24,Default,,0,0,0,,Қасқыр кім деп ойлайсың?
Dialogue: 0,0:11:03.78,0:11:05.45,Default,,0,0,0,,Көрсетіңіз
Dialogue: 0,0:11:05.95,0:11:07.62,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:11:11.42,0:11:12.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:12.83,0:11:13.96,Default,,0,0,0,,Сіз қайдан білдіңіз!
Dialogue: 0,0:11:14.04,0:11:16.55,Default,,0,0,0,,Білмесең қызық.
Dialogue: 0,0:11:16.63,0:11:19.47,Default,,0,0,0,,Сіз үнемі жүзесіз.
Dialogue: 0,0:11:19.55,0:11:21.55,Default,,0,0,0,,Мен үнемі абдырап жүремін
Dialogue: 0,0:11:21.63,0:11:23.01,Default,,0,0,0,,Гррр…
Dialogue: 0,0:11:23.09,0:11:25.22,Default,,0,0,0,,Неге тіпті менің ағаларым!
Dialogue: 0,0:11:25.30,0:11:27.60,Default,,0,0,0,,Сенің кесіріңнен бізге де қауіп төніп тұр.
Dialogue: 0,0:11:27.68,0:11:29.18,Default,,0,0,0,,Сатқын!
Dialogue: 0,0:11:29.27,0:11:30.85,Default,,0,0,0,,А, бұл менмін.
Dialogue: 0,0:11:30.94,0:11:32.06,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:11:32.85,0:11:34.69,Default,,0,0,0,,Ба-ка
Dialogue: 0,0:11:34.77,0:11:36.44,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:11:37.90,0:11:40.44,Default,,0,0,0,,Жарайды! Торт жейміз
Dialogue: 0,0:12:16.98,0:12:18.98,Default,,0,0,0,,Сізге кеш ұнады ма?
Dialogue: 0,0:12:19.07,0:12:22.15,Default,,0,0,0,,Иә! Мені шақырғаныңызға қуаныштымын.
Dialogue: 0,0:12:23.07,0:12:25.49,Default,,0,0,0,,Мен бірінші рет осыншама көңіл көтеруім.
Dialogue: 0,0:12:25.99,0:12:27.95,Default,,0,0,0,,Аа... Жақсы.
Dialogue: 0,0:12:28.03,0:12:31.00,Default,,0,0,0,,Енді мен Суханың туған күнін тойлауым керек.
Dialogue: 0,0:12:31.08,0:12:33.50,Default,,0,0,0,,Шынымен бе? Мен сондай бақыттымын
Dialogue: 0,0:12:33.58,0:12:34.92,Default,,0,0,0,,А, бірақ
Dialogue: 0,0:12:35.00,0:12:38.38,Default,,0,0,0,,Келесі жолы мен той жасап, тікұшақты шақырамын.
Dialogue: 0,0:12:38.46,0:12:38.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:39.63,0:12:41.88,Default,,0,0,0,,Мен мұны ешқашан істеген емеспін.
Dialogue: 0,0:12:41.96,0:12:43.26,Default,,0,0,0,,Тарап
Dialogue: 0,0:12:43.76,0:12:46.09,Default,,0,0,0,,Жарайды, мен оны асыға күтемін.
Dialogue: 0,0:12:46.18,0:12:47.68,Default,,0,0,0,,А... иә!
Dialogue: 0,0:12:47.76,0:12:49.05,Default,,0,0,0,,Хехе
Dialogue: 0,0:12:52.35,0:12:53.77,Default,,0,0,0,,Бүгінгі күн үшін рахмет
Dialogue: 0,0:12:53.85,0:12:55.77,Default,,0,0,0,,Иә, абай болыңыз
Dialogue: 0,0:12:55.85,0:12:57.69,Default,,0,0,0,,Тікұшақтар әлі үйде емес пе?
Dialogue: 0,0:12:57.77,0:12:58.56,Default,,0,0,0,,О
Dialogue: 0,0:12:59.06,0:13:02.74,Default,,0,0,0,,Бізде тазалау керек, сондықтан біз бүгін осында боламыз.
Dialogue: 0,0:13:02.82,0:13:03.90,Default,,0,0,0,,Саған көмектесейін бе?
Dialogue: 0,0:13:03.99,0:13:07.03,Default,,0,0,0,,Жарайды. Сау болыңыз және үйге барыңыз.
Dialogue: 0,0:13:07.11,0:13:08.49,Default,,0,0,0,,Суха~!
Dialogue: 0,0:13:09.58,0:13:11.45,Default,,0,0,0,,Үйге бірге барайық!
Dialogue: 0,0:13:13.25,0:13:15.16,Default,,0,0,0,,Мектепте кездескенше.
Dialogue: 0,0:13:16.21,0:13:17.50,Default,,0,0,0,,Мүмкін… Сондықтан сендер
Dialogue: 0,0:13:23.38,0:13:25.30,Default,,0,0,0,,Жоқ, бірақ бұл өте жақсы болды.
Dialogue: 0,0:13:25.38,0:13:27.18,Default,,0,0,0,,Бұл көңілді болды.
Dialogue: 0,0:13:27.26,0:13:28.14,Default,,0,0,0,,Иә
Dialogue: 0,0:13:28.76,0:13:30.35,Default,,0,0,0,,Сізге басқа электрондық поштаны жібере аламын ба?
Dialogue: 0,0:13:30.43,0:13:33.81,Default,,0,0,0,,Әрине! Мен де іздеп көрейін.
Dialogue: 0,0:13:35.60,0:13:36.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:36.60,0:13:37.98,Default,,0,0,0,,Ханға берілген сыйлық
Dialogue: 0,0:13:38.06,0:13:39.06,Default,,0,0,0,,Мен ұмытып қалдым
Dialogue: 0,0:13:40.02,0:13:42.48,Default,,0,0,0,,Кешіріңіз! Мен бір нәрсені ұмыттым.
Dialogue: 0,0:13:42.57,0:13:43.44,Default,,0,0,0,,Ендеше, бірге жиналайық.
Dialogue: 0,0:13:43.53,0:13:45.07,Default,,0,0,0,,Егер ол оны өзінің Қабілетімен көтерсе, бастаманы өз қолына алады
Dialogue: 0,0:13:45.82,0:13:47.07,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:13:47.66,0:13:48.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:49.57,0:13:51.83,Default,,0,0,0,,Күн батып бара жатса да
Dialogue: 0,0:13:51.91,0:13:54.95,Default,,0,0,0,,Қазірдің өзінде ~ Ханның маған берген сыйлығы
Dialogue: 0,0:13:55.04,0:13:56.25,Default,,0,0,0,,Қалай ұмытуға болады?
Dialogue: 0,0:13:56.33,0:13:58.46,Default,,0,0,0,,Асықпасақ, қараңғы түседі.
Dialogue: 0,0:14:01.84,0:14:02.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:06.97,0:14:08.84,Default,,0,0,0,,Оны қайда қойдыңыз?
Dialogue: 0,0:14:10.68,0:14:11.64,Default,,0,0,0,,Міне, болды.
Dialogue: 0,0:14:13.31,0:14:15.56,Default,,0,0,0,,Мен сізге көмектесуім керек деп ойлаймын.
Dialogue: 0,0:14:16.06,0:14:18.39,Default,,0,0,0,,Бірақ бәрі қайда?
Dialogue: 0,0:14:22.44,0:14:23.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:27.49,0:14:28.65,Default,,0,0,0,,Мұндағылардың бәрі...
Dialogue: 0,0:14:28.74,0:14:29.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:56.56,0:14:57.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:59.06,0:14:59.85,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:02.27,0:15:02.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:02.98,0:15:04.23,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:06.11,0:15:06.73,Default,,0,0,0,,Суха!
Dialogue: 0,0:15:08.36,0:15:09.49,Default,,0,0,0,,Суха!
Dialogue: 0,0:15:11.57,0:15:13.99,Default,,0,0,0,,(Суханың ауыр тыныс алуы)
Dialogue: 0,0:15:14.07,0:15:16.58,Default,,0,0,0,,Менің түсіндіруімді тыңдаңыз!
Dialogue: 0,0:15:16.66,0:15:19.41,Default,,0,0,0,,Менімен сөйлеспе! ауырып тұрмын!
Dialogue: 0,0:15:21.58,0:15:22.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:26.09,0:15:27.13,Default,,0,0,0,,Тікұшақ
Dialogue: 0,0:15:27.21,0:15:30.09,Default,,0,0,0,,Ой... Мен кішкентай ғана Сухамын
Dialogue: 0,0:15:30.17,0:15:32.05,Default,,0,0,0,,Мен сенен кейін не істеуім керек?
Dialogue: 0,0:15:32.59,0:15:34.47,Default,,0,0,0,,Сіз не айтқыңыз келеді?
Dialogue: 0,0:15:34.97,0:15:36.97,Default,,0,0,0,,Енді бірдеңе деп айту бекер.
Dialogue: 0,0:15:37.47,0:15:39.64,Default,,0,0,0,,Мен сені осылай көрдім.
Dialogue: 0,0:15:39.73,0:15:40.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:46.90,0:15:48.53,Default,,0,0,0,,Бірақ тікұшақ
Dialogue: 0,0:15:49.15,0:15:50.78,Default,,0,0,0,,Енді мен не істеуім керек?
Dialogue: 0,0:15:51.28,0:15:53.36,Default,,0,0,0,,Бұл олай емес.
Dialogue: 0,0:15:53.45,0:15:56.08,Default,,0,0,0,,Енді бұл өсек бүкіл мектепке тарайды.
Dialogue: 0,0:15:56.58,0:15:59.12,Default,,0,0,0,,Сонда бір жаққа қашудан басқа амалың жоқ.
Dialogue: 0,0:16:00.50,0:16:01.62,Default,,0,0,0,,Суха...
Dialogue: 0,0:16:02.29,0:16:04.71,Default,,0,0,0,,Суха ақтауға тырыса ма?
Dialogue: 0,0:16:04.79,0:16:07.96,Default,,0,0,0,,Сіз бұл дүниеде ең көп вампирлерді жек көресіз, солай ма?
Dialogue: 0,0:16:08.05,0:16:10.92,Default,,0,0,0,,Егер солай болса, олар бізді жалғыз қалдырмайды.
Dialogue: 0,0:16:11.01,0:16:13.22,Default,,0,0,0,,Әзірше кездесіп сөйлесейік.
Dialogue: 0,0:16:13.30,0:16:16.30,Default,,0,0,0,,Дұрыс, Хери, біріншіден, телепатиялық.
Dialogue: 0,0:16:17.14,0:16:20.31,Default,,0,0,0,,Мен оны бұрын жібергенімде, ол қабылданбады.
Dialogue: 0,0:16:20.81,0:16:22.31,Default,,0,0,0,,«Жеркенішті»
Dialogue: 0,0:16:22.39,0:16:23.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:24.02,0:16:25.48,Default,,0,0,0,,Джаканы іздеймін!
Dialogue: 0,0:16:25.56,0:16:26.69,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:16:26.77,0:16:29.86,Default,,0,0,0,,Суханың энергиясы күшті, сондықтан тез...
Dialogue: 0,0:16:30.36,0:16:30.86,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:31.99,0:16:33.36,Default,,0,0,0,,Вампирлер көп...
Dialogue: 0,0:16:33.45,0:16:34.61,Default,,0,0,0,,Ха…
Dialogue: 0,0:16:34.70,0:16:37.03,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:16:37.12,0:16:38.87,Default,,0,0,0,,Не... не?
Dialogue: 0,0:16:38.95,0:16:43.25,Default,,0,0,0,,Хели шынымен вампир болды ма?
Dialogue: 0,0:16:44.08,0:16:47.17,Default,,0,0,0,,Тек тікұшақтар емес, барлығы...
Dialogue: 0,0:16:51.00,0:16:52.92,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:16:55.13,0:16:58.14,Default,,0,0,0,,Сонда сізде мұндай қабілет болды ма?
Dialogue: 0,0:17:00.22,0:17:02.77,Default,,0,0,0,,Мен өз мектебімдегі жігітті өлтірдім.
Dialogue: 0,0:17:03.27,0:17:04.60,Default,,0,0,0,,Бұл сендерсіңдер, балалар.
Dialogue: 0,0:17:04.69,0:17:05.31,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:17:05.98,0:17:09.61,Default,,0,0,0,,Тікұшақ менің мойнымды да тістей алады ма?
Dialogue: 0,0:17:10.44,0:17:12.61,Default,,0,0,0,,О, мм...
Dialogue: 0,0:17:12.69,0:17:13.49,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:17:13.57,0:17:17.11,Default,,0,0,0,,Мен вампир емеспін
Dialogue: 0,0:17:17.20,0:17:18.16,Default,,0,0,0,,Ол тез.
Dialogue: 0,0:17:19.45,0:17:20.41,Default,,0,0,0,,Мен сенемін
Dialogue: 0,0:17:20.49,0:17:23.58,Default,,0,0,0,,Сонда сен маған сенетініңді айттың ба?
Dialogue: 0,0:17:23.66,0:17:24.79,Default,,0,0,0,,Міне!
Dialogue: 0,0:17:25.37,0:17:26.92,Default,,0,0,0,,Кристен айырылғаннан кейін
Dialogue: 0,0:17:27.54,0:17:31.55,Default,,0,0,0,,Алғаш рет маған сенетін дос таптым деп ойладым.
Dialogue: 0,0:17:32.25,0:17:35.59,Default,,0,0,0,,Осыған ұқсас сыры бар досыңызбен танысыңыз
Dialogue: 0,0:17:35.67,0:17:38.68,Default,,0,0,0,,Алғаш рет мектеп қызық деп ойладым.
Dialogue: 0,0:17:39.68,0:17:41.85,Default,,0,0,0,,Мұның бәрі өтірік болды!
Dialogue: 0,0:17:42.68,0:17:44.68,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:44.77,0:17:46.39,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:46.89,0:17:49.19,Default,,0,0,0,,Тікұшақ? Сіз мені аңдыдыңыз ба?
Dialogue: 0,0:17:49.98,0:17:51.73,Default,,0,0,0,,Келме!
Dialogue: 0,0:17:51.82,0:17:53.61,Default,,0,0,0,,Мен бұл дүниеде вампирмін...
Dialogue: 0,0:17:53.69,0:17:54.90,Default,,0,0,0,,Ууууу...
Dialogue: 0,0:17:54.99,0:17:56.45,Default,,0,0,0,,Гваааах!
Dialogue: 0,0:17:57.86,0:17:59.87,Default,,0,0,0,,А... ә...
Dialogue: 0,0:18:02.87,0:18:04.91,Default,,0,0,0,,Ааааааааааааааааааааааааа!
Dialogue: 0,0:18:06.29,0:18:07.25,Default,,0,0,0,,(ДжоДжо) Бұл таңқаларлық! Мен сен...
Dialogue: 0,0:18:08.29,0:18:10.00,Default,,0,0,0,,Сіз дәл қазіргі дыбысты естідіңіз ғой, иә?
Dialogue: 0,0:18:10.83,0:18:12.92,Default,,0,0,0,,Біреу...
Dialogue: 0,0:18:13.59,0:18:15.26,Default,,0,0,0,,Гууууу...
Dialogue: 0,0:18:16.42,0:18:19.22,Default,,0,0,0,,Маған көмектесіңізші... Хан
Dialogue: 0,0:18:21.01,0:18:22.76,Default,,0,0,0,,Иә? Суха?
Dialogue: 0,0:18:23.56,0:18:25.52,Default,,0,0,0,,Қаха…
Dialogue: 0,0:18:27.02,0:18:27.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:28.60,0:18:29.77,Default,,0,0,0,,Егер ұйықтап жатқанда Толық шоғырлану тынысын тоқтатсам,
Dialogue: 0,0:18:29.85,0:18:31.27,Default,,0,0,0,,- (Вампир) Гуаа... - Уф!
Dialogue: 0,0:18:32.27,0:18:32.77,Default,,0,0,0,,Әй!
Dialogue: 0,0:18:34.44,0:18:35.78,Default,,0,0,0,,Суха, жақсысың ба?
Dialogue: 0,0:18:35.86,0:18:37.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:37.32,0:18:38.78,Default,,0,0,0,,Мен сізді таң қалдырғаныңызды түсіндім.
Dialogue: 0,0:18:38.86,0:18:41.78,Default,,0,0,0,,Бірақ біз сен жек көретін адамдар емеспіз.
Dialogue: 0,0:18:42.78,0:18:44.79,Default,,0,0,0,,Мені тыңдаңыз.
Dialogue: 0,0:18:44.87,0:18:46.87,Default,,0,0,0,,Сонда сіз...
Dialogue: 0,0:18:47.37,0:18:50.29,Default,,0,0,0,,Сонда сіз вампир емессіз бе?
Dialogue: 0,0:18:51.33,0:18:52.67,Default,,0,0,0,,Барлығына да?
Dialogue: 0,0:18:54.34,0:18:57.26,Default,,0,0,0,,Жоқ деп айтыңыз.
Dialogue: 0,0:18:57.76,0:18:59.30,Default,,0,0,0,,Мұның бәрі түсінбеушілік
Dialogue: 0,0:19:01.93,0:19:03.60,Default,,0,0,0,,Біз алғаш кездескен кезде
Dialogue: 0,0:19:03.68,0:19:06.22,Default,,0,0,0,,Мен вампир емеспін деп сеніңіз
Dialogue: 0,0:19:06.31,0:19:09.31,Default,,0,0,0,,Өйткені біз бұл өзіміздікі емес екенін білдік.
Dialogue: 0,0:19:09.39,0:19:10.77,Default,,0,0,0,,Осылайша сіз мұны айта аласыз!
Dialogue: 0,0:19:10.85,0:19:12.90,Default,,0,0,0,,Жоқ! Бұл сол емес.
Dialogue: 0,0:19:12.98,0:19:17.40,Default,,0,0,0,,Онда неге маған оңай сендіңіз?
Dialogue: 0,0:19:19.82,0:19:21.24,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:19:21.32,0:19:22.07,Default,,0,0,0,,Хан?
Dialogue: 0,0:19:23.74,0:19:24.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:25.83,0:19:27.58,Default,,0,0,0,,К...Крис
Dialogue: 0,0:19:29.75,0:19:31.58,Default,,0,0,0,,Сіз жылап жатырсыз ба? Суха
Dialogue: 0,0:19:32.17,0:19:34.54,Default,,0,0,0,,Е... а...
Dialogue: 0,0:19:37.55,0:19:38.38,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:19:40.55,0:19:43.72,Default,,0,0,0,,Мен не болғанын білмеймін, бірақ уайымдама.
Dialogue: 0,0:19:44.22,0:19:45.39,Default,,0,0,0,,Мен сенімен біргемін
Dialogue: 0,0:19:46.56,0:19:47.72,Default,,0,0,0,,Крис…
Dialogue: 0,0:19:48.22,0:19:52.14,Default,,0,0,0,,Өйткені Суха менің сүйікті досым.
Dialogue: 0,0:19:52.23,0:19:53.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:54.44,0:19:57.44,Default,,0,0,0,,Суха, дос болайық.
Dialogue: 0,0:19:58.03,0:19:59.07,Default,,0,0,0,,Хехе
Dialogue: 0,0:20:02.03,0:20:03.20,Default,,0,0,0,,Иә
Dialogue: 0,0:20:06.28,0:20:08.49,Default,,0,0,0,,Кешіріңіз, мен сізді тезірек көре алмадым.
Dialogue: 0,0:20:08.99,0:20:10.70,Default,,0,0,0,,Мен өмірге оралғаныма сене алар емеспін
Dialogue: 0,0:20:10.79,0:20:13.96,Default,,0,0,0,,Маған сенбейсің бе деп қорқамын
Dialogue: 0,0:20:14.04,0:20:16.96,Default,,0,0,0,,Бұл мүмкін емес, солай ма?
Dialogue: 0,0:20:17.67,0:20:20.71,Default,,0,0,0,,Суха, тек сенгеніңді қалаймын.
Dialogue: 0,0:20:21.84,0:20:23.84,Default,,0,0,0,,Мен де сенемін
Dialogue: 0,0:20:23.93,0:20:28.06,Default,,0,0,0,,Маған сенгеніңіздей
Dialogue: 0,0:20:30.27,0:20:31.98,Default,,0,0,0,,- (Телепатия: Жака) Хели! -Аа...
Dialogue: 0,0:20:32.06,0:20:33.98,Default,,0,0,0,,Сіз қазір Сухамен біргесіз бе?
Dialogue: 0,0:20:34.06,0:20:35.48,Default,,0,0,0,,Жака Не болды?
Dialogue: 0,0:20:35.56,0:20:36.40,Default,,0,0,0,,Міне...
Dialogue: 0,0:20:36.48,0:20:37.73,Default,,0,0,0,,Ггаааах!
Dialogue: 0,0:20:38.23,0:20:38.73,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:38.82,0:20:40.73,Default,,0,0,0,,Міне, келдім~!
Dialogue: 0,0:20:40.82,0:20:43.24,Default,,0,0,0,,-Қарғыс атсын... -(Вампирлер) Уф...
Dialogue: 0,0:20:43.32,0:20:45.57,Default,,0,0,0,,Һм! Ұф!
Dialogue: 0,0:20:47.87,0:20:49.87,Default,,0,0,0,,Қарғыс атсын, не болып жатыр?
Dialogue: 0,0:20:49.95,0:20:51.41,Default,,0,0,0,,Неліктен вампирлер көп?
Dialogue: 0,0:20:52.12,0:20:54.16,Default,,0,0,0,,Хели Суханың қасында
Dialogue: 0,0:20:54.25,0:20:56.92,Default,,0,0,0,,Мен де ол сияқты күшті энергияны сезінемін.
Dialogue: 0,0:20:57.00,0:20:57.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:57.92,0:20:59.92,Default,,0,0,0,,Мен сені қатты сағындым
Dialogue: 0,0:21:00.00,0:21:04.17,Default,,0,0,0,,Мен сені қанша жыл іздедім?
Dialogue: 0,0:21:06.89,0:21:07.84,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:15.81,0:21:17.40,Default,,0,0,0,,Не? Бұл
Dialogue: 0,0:21:19.27,0:21:19.90,Default,,0,0,0,,Суха
Dialogue: 0,0:21:20.73,0:21:23.53,Default,,0,0,0,,Мәңгі менің ханшайымым боласың
Dialogue: 0,0:21:24.57,0:21:25.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:28.82,0:21:29.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:29.49,0:21:30.66,Default,,0,0,0,,Фу…
Dialogue: 0,0:21:30.74,0:21:31.28,Default,,0,0,0,,Уф!
Dialogue: 0,0:21:31.37,0:21:33.87,Default,,0,0,0,,Қазір Сухадан кет.
Dialogue: 0,0:21:34.91,0:21:35.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:35.50,0:21:36.58,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:39.54,0:21:42.80,Default,,0,0,0,,Сізге артта қалғаныңыз жақсы.
Dialogue: 0,0:21:43.42,0:21:44.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:44.34,0:21:45.72,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:21:47.18,0:21:48.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:50.30,0:21:51.68,Default,,0,0,0,,Тікұшақ…
Dialogue: 0,0:21:54.22,0:21:55.48,Default,,0,0,0,,Крис…
Dialogue: 0,0:21:55.98,0:21:57.98,Default,,0,0,0,,♪～
Dialogue: 0,0:23:22.19,0:23:24.19,Default,,0,0,0,,～♪
Dialogue: 0,0:23:35.24,0:23:37.62,Default,,0,0,0,,Келесі 7 эпизод
Dialogue: 0,0:23:38.12,0:23:40.91,Default,,0,0,0,,«Көк ай - Бұл тағдыр-»
Dialogue: 0,0:23:42.41,0:23:48.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory