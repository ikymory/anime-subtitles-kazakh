Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,♪~
Dialogue: 0,0:00:11.72,0:00:13.97,Default,,0,0,0,,♪ Жастардың бітпейтін жарысы
Dialogue: 0,0:00:14.05,0:00:16.85,Default,,0,0,0,,♪ Барайық Бағаларыңызды алыңыз
Dialogue: 0,0:00:16.93,0:00:18.39,Default,,0,0,0,,♪ Келесі бастапқы блок
Dialogue: 0,0:00:18.47,0:00:21.22,Default,,0,0,0,,♪ Бізді күтеміз.
Dialogue: 0,0:00:21.31,0:00:24.48,Default,,0,0,0,,♪ (Қорықпаңыз, міндетті түрде жеңіңіз ИӘ!!)
Dialogue: 0,0:00:24.56,0:00:26.81,Default,,0,0,0,,♪ Шиеленіс шарықтау шегінде
Dialogue: 0,0:00:26.90,0:00:29.02,Default,,0,0,0,,♪ Арманыңызды дәл қазір орындаңыз.
Dialogue: 0,0:00:29.11,0:00:29.94,Default,,0,0,0,,♪ (Арманыңызды орындаңыз)
Dialogue: 0,0:00:30.03,0:00:31.23,Default,,0,0,0,,♪ Мен көңіл көтергім келеді
Dialogue: 0,0:00:31.32,0:00:33.95,Default,,0,0,0,,♪ Болашаққа спортшы ант берейік
Dialogue: 0,0:00:34.03,0:00:37.24,Default,,0,0,0,,♪ (әділ және нақты кіргім келеді)
Dialogue: 0,0:00:37.32,0:00:39.28,Default,,0,0,0,,♪ (Барлығы қатысуы керек)
Dialogue: 0,0:00:39.37,0:00:41.16,Default,,0,0,0,,♪ Кездесу – жалғыз нәрсе
Dialogue: 0,0:00:41.24,0:00:43.04,Default,,0,0,0,,♪ Тағдырдың бұрылысы
Dialogue: 0,0:00:43.12,0:00:46.83,Default,,0,0,0,,♪ Сіз оны шынымен сезіне аласыз.
Dialogue: 0,0:00:46.92,0:00:49.75,Default,,0,0,0,,♪ Біздің бірегей байланыс формасы
Dialogue: 0,0:00:49.84,0:00:52.46,Default,,0,0,0,,♪ Жүрегімде өшпейді
Dialogue: 0,0:00:52.55,0:00:55.05,Default,,0,0,0,,♪ Қосылған релелер
Dialogue: 0,0:00:55.13,0:00:57.26,Default,,0,0,0,,♪ Кеттік! Дайын
Dialogue: 0,0:00:57.34,0:00:59.22,Default,,0,0,0,,♪ Фристайл рухы
Dialogue: 0,0:00:59.30,0:01:02.02,Default,,0,0,0,,♪ Бұл күн шуақты сахнаға қолайлы.
Dialogue: 0,0:01:02.10,0:01:04.18,Default,,0,0,0,,♪ Алда көп міндеттер тұр
Dialogue: 0,0:01:04.27,0:01:05.10,Default,,0,0,0,,♪ Қандай жағдай болса да қабылдаймын
Dialogue: 0,0:01:05.19,0:01:08.35,Default,,0,0,0,,♪ Әр күн – шайқас
Dialogue: 0,0:01:08.44,0:01:10.48,Default,,0,0,0,,♪ Ұнады! көңілді әңгіме
Dialogue: 0,0:01:10.57,0:01:11.82,Default,,0,0,0,,♪ Толық дене стилі
Dialogue: 0,0:01:11.90,0:01:14.28,Default,,0,0,0,,♪ Менің қобалжығанымды дәлелдеу үшін бар күшімді сал
Dialogue: 0,0:01:14.36,0:01:16.86,Default,,0,0,0,,♪ Қолыңыздан келгеннің бәрін жасаңыз (sei! sei!)
Dialogue: 0,0:01:16.95,0:01:18.49,Default,,0,0,0,,♪ Осы уақытта (sei! sei!)
Dialogue: 0,0:01:18.57,0:01:24.45,Default,,0,0,0,,♪ Біз «еркінміз»
Dialogue: 0,0:01:24.54,0:01:28.04,Default,,0,0,0,,♪ О, иә
Dialogue: 0,0:02:00.57,0:02:02.08,Default,,0,0,0,,Үлкен аға (Рин Мацуока) Иә?
Dialogue: 0,0:02:02.16,0:02:03.99,Default,,0,0,0,,Мен сізге қорапты ашуға көмектесе аламын ба?
Dialogue: 0,0:02:04.08,0:02:05.50,Default,,0,0,0,,Жоқ, бәрі жақсы.
Dialogue: 0,0:02:05.58,0:02:07.71,Default,,0,0,0,,Тек Австралияға апару ғана қалды.
Dialogue: 0,0:02:07.79,0:02:08.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:11.08,0:02:12.54,Default,,0,0,0,,Стив
Dialogue: 0,0:02:12.63,0:02:14.88,Default,,0,0,0,,Сіз тағы да үлкен болып кеттіңіз, иә?
Dialogue: 0,0:02:17.92,0:02:19.76,Default,,0,0,0,,Мен әлі күнге дейін сағыныш сезінемін
Dialogue: 0,0:02:19.84,0:02:22.60,Default,,0,0,0,,Ринко мен шай қойдым.
Dialogue: 0,0:02:30.35,0:02:33.31,Default,,0,0,0,,Шай жапон шайы ма? Торт үшін?
Dialogue: 0,0:02:33.40,0:02:36.53,Default,,0,0,0,,Ходжича тортпен керемет үйлеседі.
Dialogue: 0,0:02:36.61,0:02:39.15,Default,,0,0,0,,Дұрыс, Мацуока отбасындағы соңғы трендтер
Dialogue: 0,0:02:39.24,0:02:40.99,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:02:43.20,0:02:44.37,Default,,0,0,0,,Дәмді
Dialogue: 0,0:02:44.45,0:02:46.49,Default,,0,0,0,,Эй, тағы біреуін ала аламын ба? (Токио) Иә?
Dialogue: 0,0:02:46.58,0:02:49.00,Default,,0,0,0,,Мен Стив сияқты болсам да, білмеймін.
Dialogue: 0,0:02:49.08,0:02:50.50,Default,,0,0,0,,Қазірдің өзінде! Бұл болмайды~
Dialogue: 0,0:02:50.58,0:02:52.79,Default,,0,0,0,,Фуфуфу (Рин) Фуфуфу
Dialogue: 0,0:02:52.88,0:02:53.88,Default,,0,0,0,,Ақыр соңында тағы біреуін жейміз.
Dialogue: 0,0:02:53.96,0:02:55.38,Default,,0,0,0,,Иә? Шынымен бе?
Dialogue: 0,0:02:55.46,0:02:56.88,Default,,0,0,0,,Егер сіз Стив сияқты болсаңыз... (цзян)...
Dialogue: 0,0:03:04.51,0:03:06.51,Default,,0,0,0,,Міне, бүгінгі тәжірибе үшін осының бәрі.
Dialogue: 0,0:03:06.60,0:03:07.60,Default,,0,0,0,,Usu!
Dialogue: 0,0:03:07.68,0:03:09.52,Default,,0,0,0,,Ертең таңғы 7-ден бастап таңғы жаттығу
Dialogue: 0,0:03:09.60,0:03:13.02,Default,,0,0,0,,Тәжірибе мәзірін тексеруді ұмытпаңыз.
Dialogue: 0,0:03:13.10,0:03:14.77,Default,,0,0,0,,Еріту
Dialogue: 0,0:03:14.86,0:03:16.27,Default,,0,0,0,,Еңбегіңіз үшін рахмет~
Dialogue: 0,0:03:20.32,0:03:21.15,Default,,0,0,0,,Ай-сенпай
Dialogue: 0,0:03:21.24,0:03:24.12,Default,,0,0,0,,Сіз менеджерге ұқсай бастадыңыз.
Dialogue: 0,0:03:24.20,0:03:26.12,Default,,0,0,0,,Өте керемет болды
Dialogue: 0,0:03:26.20,0:03:31.04,Default,,0,0,0,,Хаха...Мен әлі де менеджердің міндетін атқарушымын.
Dialogue: 0,0:03:31.12,0:03:32.67,Default,,0,0,0,,Ондай нәрсе жоқ.
Dialogue: 0,0:03:32.75,0:03:35.08,Default,,0,0,0,,Келесі менеджер тек Ай-сенпай болады.
Dialogue: 0,0:03:35.17,0:03:37.05,Default,,0,0,0,,Рахмет саған Момо-кун
Dialogue: 0,0:03:37.13,0:03:38.50,Default,,0,0,0,,Бірақ одан да көп...
Dialogue: 0,0:03:38.59,0:03:39.96,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:03:40.05,0:03:43.26,Default,,0,0,0,,Мектеп бітіріп жатқан Рин-сенпай мен Сосуке-сенпайға
Dialogue: 0,0:03:43.34,0:03:45.47,Default,,0,0,0,,Сіз маған бірдеңе бергіңіз келеді, солай ма?
Dialogue: 0,0:03:45.55,0:03:48.47,Default,,0,0,0,,Эстафетаны топ болып бірге жүздік.
Dialogue: 0,0:03:48.56,0:03:51.39,Default,,0,0,0,,Түсіндім, бұл сыйлық.
Dialogue: 0,0:03:51.48,0:03:54.10,Default,,0,0,0,,Ең соңғы керемет купальник, көзілдірік және т.б.
Dialogue: 0,0:03:54.19,0:03:55.86,Default,,0,0,0,,Хмм, бұл да жақсы.
Dialogue: 0,0:03:55.94,0:03:59.44,Default,,0,0,0,,Тағы бір нәрсе, таңқаларлық сезім бар.
Dialogue: 0,0:03:59.53,0:04:01.19,Default,,0,0,0,,Сонда бұл туралы не деуге болады?
Dialogue: 0,0:04:01.28,0:04:03.45,Default,,0,0,0,,Бұғы қоңызының дернәсілдерін өсіруге арналған жиынтық!
Dialogue: 0,0:04:03.53,0:04:04.82,Default,,0,0,0,,Жоқ, Момо-кун
Dialogue: 0,0:04:04.91,0:04:06.78,Default,,0,0,0,,Менің қалағаным емес, Рин-сенпай...
Dialogue: 0,0:04:06.87,0:04:09.70,Default,,0,0,0,,Хяха! Хи хи хи (ұқсас құс) Ах~ Эй Момо-кун
Dialogue: 0,0:04:09.79,0:04:13.96,Default,,0,0,0,,Иә, қош келдіңіз. Сіз бір рет 5 сәтті билет ала аласыз.
Dialogue: 0,0:04:14.04,0:04:15.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:15.08,0:04:17.54,Default,,0,0,0,,Ай-сенпай, жолың жоқ па?
Dialogue: 0,0:04:17.63,0:04:22.09,Default,,0,0,0,,Не? О, мен оны ертерек дүкенге барғанымда алдым.
Dialogue: 0,0:04:22.17,0:04:23.55,Default,,0,0,0,,Бірақ маған бұғы қоңызы керек емес...
Dialogue: 0,0:04:23.63,0:04:24.68,Default,,0,0,0,,Жарайды
Dialogue: 0,0:04:25.34,0:04:27.51,Default,,0,0,0,,Мен бүгін өте бақыттымын.
Dialogue: 0,0:04:27.60,0:04:30.72,Default,,0,0,0,,Мен бүгін қайтарған викторина 7 ұпай болды.
Dialogue: 0,0:04:30.81,0:04:31.81,Default,,0,0,0,,Бақытты жеті!
Dialogue: 0,0:04:31.89,0:04:33.81,Default,,0,0,0,,Бұл үшін ең жақсы ұпай қандай болды?
Dialogue: 0,0:04:33.89,0:04:34.98,Default,,0,0,0,,100 ұпай
Dialogue: 0,0:04:35.06,0:04:35.90,Default,,0,0,0,,Ағай мынау
Dialogue: 0,0:04:35.98,0:04:37.31,Default,,0,0,0,,Иә, бір рет.
Dialogue: 0,0:04:41.19,0:04:46.11,Default,,0,0,0,,Даааах~ Буғы қоңызының дернәсілдерін өсіруге арналған жиынтық~!
Dialogue: 0,0:04:46.20,0:04:48.78,Default,,0,0,0,,Уау, мен оны жоғалтып алдым!
Dialogue: 0,0:04:48.87,0:04:50.03,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:04:50.12,0:04:50.95,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:04:51.04,0:04:54.83,Default,,0,0,0,,1-ші жүлде Ыстық көктем жұбының тұру билеті Джекпоты~
Dialogue: 0,0:04:54.91,0:04:57.96,Default,,0,0,0,,Ыстық бұлақтар... міне осы! Момо-кун
Dialogue: 0,0:04:58.04,0:04:59.21,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:05:01.92,0:05:04.05,Default,,0,0,0,,Ей, ақ күнде не істейміз?
Dialogue: 0,0:05:04.13,0:05:05.51,Default,,0,0,0,,Ештеңе жоқ
Dialogue: 0,0:05:05.59,0:05:08.39,Default,,0,0,0,,Біріншіден, Валентин күні үшін маған ештеңе бермеңіз.
Dialogue: 0,0:05:16.48,0:05:18.65,Default,,0,0,0,,Мен де тез арада заттарымды ретке келтіруім керек.
Dialogue: 0,0:05:19.69,0:05:20.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:27.61,0:05:29.82,Default,,0,0,0,,Сондықтан~ Сіз оны алмасаңыз да
Dialogue: 0,0:05:29.91,0:05:32.33,Default,,0,0,0,,Қыздар орта мектебіне сыйлықпен бару
Dialogue: 0,0:05:32.41,0:05:34.87,Default,,0,0,0,,Барлық ер балаларға арналған мектептер мүмкіндігі шектеулі жандарға арналған.
Dialogue: 0,0:05:34.95,0:05:37.37,Default,,0,0,0,,Кем дегенде, бұл революция, солай ма?
Dialogue: 0,0:05:37.46,0:05:38.79,Default,,0,0,0,,Эй
Dialogue: 0,0:05:38.88,0:05:41.42,Default,,0,0,0,,Ямадзаки Сенпай Чивасу (Уозуми/Минами) Чивасу!
Dialogue: 0,0:05:41.50,0:05:44.88,Default,,0,0,0,,Мұны біреу қателесіп менің бөлмеме тастап кетті ме?
Dialogue: 0,0:05:45.38,0:05:47.93,Default,,0,0,0,,Бұл печенье емес пе? Ол кімнен?
Dialogue: 0,0:05:48.01,0:05:50.26,Default,,0,0,0,,Мен білмеймін, сондықтан сұраймын.
Dialogue: 0,0:05:50.35,0:05:53.43,Default,,0,0,0,,Иә? Маған аздап көрсетіңізші
Dialogue: 0,0:05:54.10,0:05:55.85,Default,,0,0,0,,Онда бірдеңе жазылған.
Dialogue: 0,0:05:55.93,0:05:56.93,Default,,0,0,0,,Ха
Dialogue: 0,0:05:57.02,0:05:59.52,Default,,0,0,0,,Оларды бір қатарға қойсаң, хабарға айналады, солай ма?
Dialogue: 0,0:05:59.60,0:06:00.56,Default,,0,0,0,,Міне, солай!
Dialogue: 0,0:06:00.65,0:06:03.02,Default,,0,0,0,,Тосын жағдай жақсы болатын сияқты.
Dialogue: 0,0:06:03.11,0:06:08.45,Default,,0,0,0,,Фуфуфуфу Жұмбақты шешкеннен кейін, сізді күтпеген ыстық көктем саяхаты күтіп тұр!
Dialogue: 0,0:06:08.53,0:06:09.61,Default,,0,0,0,,Мехайкура! (Нитори)?
Dialogue: 0,0:06:09.70,0:06:15.37,Default,,0,0,0,,Мекайкураха Асано Канитачинонака…
Dialogue: 0,0:06:15.45,0:06:16.95,Default,,0,0,0,,Таңертеңгі шаяндар?
Dialogue: 0,0:06:17.04,0:06:19.37,Default,,0,0,0,,Жоқ, бұл механикалықрақ.
Dialogue: 0,0:06:19.46,0:06:21.21,Default,,0,0,0,,Ондай лосось етігін жеуге болмайды.
Dialogue: 0,0:06:21.29,0:06:24.42,Default,,0,0,0,,Сіз не туралы айтып тұрсыз? Бұл механикалық клуб! Механикалық қолөнер
Dialogue: 0,0:06:24.50,0:06:26.84,Default,,0,0,0,,Тамақ іше аласың ба, жоқ па бәрібір.
Dialogue: 0,0:06:26.92,0:06:30.34,Default,,0,0,0,,Мехайкура! Бұл не? Өте керемет~
Dialogue: 0,0:06:30.43,0:06:33.22,Default,,0,0,0,,Жоқ, Момо-кун, бұл таңданатын кез емес.
Dialogue: 0,0:06:33.30,0:06:37.68,Default,,0,0,0,,Бұл жаман идея емес, жай ғана олардың орналасу ретін түсінгеніңізге көз жеткізіңіз.
Dialogue: 0,0:06:39.02,0:06:40.35,Default,,0,0,0,,Сусуке-сенпай!
Dialogue: 0,0:06:40.44,0:06:44.61,Default,,0,0,0,,Мен бәрін естідім. Маған қалдырыңыз!
Dialogue: 0,0:06:46.57,0:06:47.94,Default,,0,0,0,,Мен оның осылай екеніне сенімдімін!
Dialogue: 0,0:06:48.03,0:06:52.07,Default,,0,0,0,,Такараха Акайсамено Кучинонакани
Dialogue: 0,0:06:52.70,0:06:55.28,Default,,0,0,0,,Қазына қызыл акуланың аузында ма?
Dialogue: 0,0:06:55.37,0:06:58.58,Default,,0,0,0,,Бұл қазынаның орны жазылған кодталған cookie файлы.
Dialogue: 0,0:06:58.66,0:07:00.79,Default,,0,0,0,,Иә, иә! (Минами) Бірақ қызыл акула ше?
Dialogue: 0,0:07:00.87,0:07:03.67,Default,,0,0,0,,Ойлап қарасам, дзюдо үйірмесінде Ақай деген жігіт бар еді.
Dialogue: 0,0:07:03.75,0:07:04.92,Default,,0,0,0,,Мені дереу әкеліңіз
Dialogue: 0,0:07:05.00,0:07:05.92,Default,,0,0,0,,Қателіктеріңе көп тоқталудың орнына,
Dialogue: 0,0:07:06.00,0:07:08.30,Default,,0,0,0,,Ақайдың аузындағы қазына қандай?
Dialogue: 0,0:07:08.38,0:07:10.09,Default,,0,0,0,,Бұл шынымен механикалық клуб па?
Dialogue: 0,0:07:12.01,0:07:14.26,Default,,0,0,0,,Ах! Мүмкін акула шығар
Dialogue: 0,0:07:14.35,0:07:16.43,Default,,0,0,0,,Ауладағы акула мүсіні ше?
Dialogue: 0,0:07:16.51,0:07:17.35,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:07:17.43,0:07:18.72,Default,,0,0,0,,Бұл болды.
Dialogue: 0,0:07:18.81,0:07:20.39,Default,,0,0,0,,Иә, иә (Минами), бірақ бұл қызыл емес.
Dialogue: 0,0:07:20.48,0:07:23.31,Default,,0,0,0,,Жоқ, жоқ, бәрібір барайық.
Dialogue: 0,0:07:24.73,0:07:27.40,Default,,0,0,0,,Ах! Қарап көріңізші.
Dialogue: 0,0:07:27.48,0:07:29.90,Default,,0,0,0,,Акула мүсіні күн батқаннан қызыл түске боялған.
Dialogue: 0,0:07:29.99,0:07:32.82,Default,,0,0,0,,Қазына мына акуланың аузында!
Dialogue: 0,0:07:32.91,0:07:34.16,Default,,0,0,0,,Ештеңе жоқ.
Dialogue: 0,0:07:39.08,0:07:39.91,Default,,0,0,0,,Бұл емес пе?
Dialogue: 0,0:07:41.83,0:07:44.92,Default,,0,0,0,,Көремін, бұл көлеңке (Минами) Ямадзаки-сенпай күткендей.
Dialogue: 0,0:07:51.67,0:07:52.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:54.55,0:07:56.47,Default,,0,0,0,,Ыстық бұлақ жұбының тұру билеті?
Dialogue: 0,0:07:56.55,0:07:58.01,Default,,0,0,0,,(крекер дыбысы)
Dialogue: 0,0:07:58.10,0:07:59.89,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:08:01.31,0:08:02.14,Default,,0,0,0,,Не болды? Бұл
Dialogue: 0,0:08:03.27,0:08:07.65,Default,,0,0,0,,Хехехе, Айсенпай үшеуміз сауда ауданындағы лотереядан ұттық.
Dialogue: 0,0:08:07.73,0:08:09.53,Default,,0,0,0,,Қаласаңыз, орындаңыз!
Dialogue: 0,0:08:10.53,0:08:12.28,Default,,0,0,0,,Хахаха (Сусуке) О
Dialogue: 0,0:08:12.86,0:08:15.41,Default,,0,0,0,,Сонымен не істеуіміз керек? Рин
Dialogue: 0,0:08:15.49,0:08:19.87,Default,,0,0,0,,Анаго Онсен? Бұл керемет мүмкіндік болғандықтан, мен сені жіберемін.
Dialogue: 0,0:08:20.66,0:08:24.67,Default,,0,0,0,,Бірақ мен бұл тек біз болғанына өкінемін.
Dialogue: 0,0:08:24.75,0:08:27.75,Default,,0,0,0,,Бізде Анаго Онсенге тұру билеттері де бар.
Dialogue: 0,0:08:27.84,0:08:30.88,Default,,0,0,0,,Күні кеше газетші маған берді.
Dialogue: 0,0:08:30.96,0:08:35.26,Default,,0,0,0,,Әй, сендердің кішілерің неге бізбен бірге келмейді?
Dialogue: 0,0:08:46.77,0:08:52.44,Default,,0,0,0,,Бұл ыстық бұлақ ~фу~ Татами фу~ Ыстық бұлақ фу~
Dialogue: 0,0:08:52.53,0:08:54.45,Default,,0,0,0,,Ху~ (Рин) Сабыр ет, Момо.
Dialogue: 0,0:08:54.53,0:08:58.45,Default,,0,0,0,,Бұл демалатын уақыт емес. Жүгімізді тастап, көрікті жерлерге барайық.
Dialogue: 0,0:08:58.53,0:08:59.41,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:59.49,0:09:01.66,Default,,0,0,0,,Капибара бар ма? капибара
Dialogue: 0,0:09:01.74,0:09:05.21,Default,,0,0,0,,Капибарамен суретке түсіп, ағаңа көрсет!
Dialogue: 0,0:09:06.37,0:09:07.71,Default,,0,0,0,,Хехехе
Dialogue: 0,0:09:07.79,0:09:08.96,Default,,0,0,0,,Онда барамыз ба?
Dialogue: 0,0:09:09.04,0:09:12.34,Default,,0,0,0,,Момо: Егер капибара көрсең, мен сені суретке түсіремін.
Dialogue: 0,0:09:12.42,0:09:13.59,Default,,0,0,0,,Яхх~!
Dialogue: 0,0:09:30.69,0:09:33.48,Default,,0,0,0,,Ыстық бұлақ Манжу Супер Уме~
Dialogue: 0,0:09:33.57,0:09:35.95,Default,,0,0,0,,Біраз уақыттан бері қанша тамақ жедіңіз?
Dialogue: 0,0:09:36.03,0:09:37.78,Default,,0,0,0,,Момо, бұл капибара.
Dialogue: 0,0:09:37.86,0:09:40.16,Default,,0,0,0,,Сіз байсалдысыз ба? О, бұл ауыр
Dialogue: 0,0:09:41.58,0:09:43.66,Default,,0,0,0,,Рин-сенпай, суретке түс.
Dialogue: 0,0:09:44.54,0:09:46.16,Default,,0,0,0,,Қарашы, Ай-сенпай, тезірек!
Dialogue: 0,0:09:46.25,0:09:47.25,Default,,0,0,0,,Иә, мен де?
Dialogue: 0,0:09:48.00,0:09:51.13,Default,,0,0,0,,Кеттік~ Сыр айт
Dialogue: 0,0:09:51.88,0:09:54.67,Default,,0,0,0,,Келесі, Рин-сенпай мен Сосуке-сенпай, өтінемін.
Dialogue: 0,0:09:54.76,0:09:57.51,Default,,0,0,0,,Жүр, тезірек (Сусуке) Әй... Эй, Момо
Dialogue: 0,0:09:58.22,0:10:01.35,Default,,0,0,0,,Бұл үлкен мәселе болғандықтан суретке түсірейін бе? (Сусуке) О...
Dialogue: 0,0:10:03.22,0:10:07.27,Default,,0,0,0,,Сосуке-сенпай қатты Күлімсіреу
Dialogue: 0,0:10:07.35,0:10:08.81,Default,,0,0,0,,Кеттік~
Dialogue: 0,0:10:09.35,0:10:10.61,Default,,0,0,0,,Мен оны енді ғана жинадым—
Dialogue: 0,0:10:10.69,0:10:12.06,Default,,0,0,0,,Әй...
Dialogue: 0,0:10:12.15,0:10:13.77,Default,,0,0,0,,Сайчиз (Сусуке) Тоқта, Рин!
Dialogue: 0,0:10:13.86,0:10:16.61,Default,,0,0,0,,Иә, жақсы. (Сусуке) Эй, эй... Келші.
Dialogue: 0,0:10:16.69,0:10:17.78,Default,,0,0,0,,Бұл
Dialogue: 0,0:10:41.72,0:10:45.39,Default,,0,0,0,,Уау! Бұл ағаш қылыш өте керемет!
Dialogue: 0,0:10:45.47,0:10:47.52,Default,,0,0,0,,Эй, Момо-кун, мен сенің және сенің қарттарыңның саяхатыңнан ләззат алатынына сенімдімін.
Dialogue: 0,0:10:47.52,0:10:49.85,Default,,0,0,0,,Ей, Момо-кун, мен сенің және сенің үлкендеріңнің саяхатыңнан ләззат алатынына сенімдімін. Рин Кәдесыйлар ше?
Dialogue: 0,0:10:49.94,0:10:51.81,Default,,0,0,0,,Осы дүкенді көргіңіз келе ме? Біз де бірге көңіл көтеріп жүрміз ғой.
Dialogue: 0,0:10:51.81,0:10:54.11,Default,,0,0,0,,Біз де бірге көңіл көтеріп жүрміз ғой. Жарайды, мен оны сатып алуға асықпаймын.
Dialogue: 0,0:10:52.48,0:10:55.52,Default,,0,0,0,,Екі адамға бір нәрсе сыйлауға бола ма?
Dialogue: 0,0:10:54.19,0:10:55.52,Default,,0,0,0,,Қарап көргіңіз келе ме?
Dialogue: 0,0:10:55.61,0:10:58.69,Default,,0,0,0,,Сонымен, Рин-сенпай, мына ағаш қылыш туралы не ойлайсың?
Dialogue: 0,0:10:58.78,0:11:01.11,Default,,0,0,0,,Жоқ, Рин-сенпай, бұл біраз
Dialogue: 0,0:11:01.20,0:11:04.28,Default,,0,0,0,,Жарайды, мен Австралиядан сувенир алдым.
Dialogue: 0,0:11:04.37,0:11:06.37,Default,,0,0,0,,Мен бумеранг алдым~
Dialogue: 0,0:11:06.45,0:11:09.12,Default,,0,0,0,,Керісінше мен саған ағаш қылыш беремін.
Dialogue: 0,0:11:09.21,0:11:11.29,Default,,0,0,0,,Менің ойымша, бұл ереже емес.
Dialogue: 0,0:11:11.37,0:11:13.54,Default,,0,0,0,,Сонда ағаш қылыш Го мырзаға кәдесый болады.
Dialogue: 0,0:11:13.63,0:11:16.21,Default,,0,0,0,,Жоқ, мен де Цзян мырзадан сұрағым келеді.
Dialogue: 0,0:11:16.30,0:11:18.80,Default,,0,0,0,,Ха! А... ана жерде.
Dialogue: 0,0:11:18.88,0:11:21.05,Default,,0,0,0,,Бұл капибара емес пе?
Dialogue: 0,0:11:19.72,0:11:21.05,Default,,0,0,0,,Бұл Капибара-кун.
Dialogue: 0,0:11:21.13,0:11:23.68,Default,,0,0,0,,Рин-сенпай, уәде еткендей суретке түс!
Dialogue: 0,0:11:23.76,0:11:26.47,Default,,0,0,0,,Иә!? Эй, күте тұрыңыз, Момо.
Dialogue: 0,0:11:27.52,0:11:29.93,Default,,0,0,0,,Момо жігіті өте көңілді көрінеді
Dialogue: 0,0:11:32.60,0:11:33.44,Default,,0,0,0,,Иә
Dialogue: 0,0:11:38.19,0:11:40.90,Default,,0,0,0,,Капибара өте сүйкімді болды~
Dialogue: 0,0:11:39.28,0:11:41.99,Default,,0,0,0,,(сөйлеу)
Dialogue: 0,0:11:40.99,0:11:41.99,Default,,0,0,0,,Хахаха
Dialogue: 0,0:11:41.99,0:11:43.07,Default,,0,0,0,,(сөйлеу)
Dialogue: 0,0:11:43.70,0:11:47.16,Default,,0,0,0,,Бұл... (Рин) Бұл таныс жүз.
Dialogue: 0,0:11:48.95,0:11:51.37,Default,,0,0,0,,Минатофукан орта мектебінің жүзу үйірмесі.
Dialogue: 0,0:11:52.00,0:11:54.92,Default,,0,0,0,,Республикалық турнирлерге ұдайы қатысып жүрген күш иесі емес пе?
Dialogue: 0,0:11:55.00,0:11:56.59,Default,,0,0,0,,Бұл оқу-жаттығу жиыны ма?
Dialogue: 0,0:11:56.67,0:11:58.13,Default,,0,0,0,,Мен мұқият қараймын.
Dialogue: 0,0:11:58.21,0:12:00.13,Default,,0,0,0,,Тоқтайтын кез келді, Момо-кун.
Dialogue: 0,0:12:05.51,0:12:08.06,Default,,0,0,0,,Қиындыққа түсу жақсы емес, сондықтан ағаш қылышты тез таста.
Dialogue: 0,0:12:08.14,0:12:09.31,Default,,0,0,0,,Эй
Dialogue: 0,0:12:09.39,0:12:12.85,Default,,0,0,0,,Қоңырауды аяқтағандардың ретімен вестибюльге өтіңіз.
Dialogue: 0,0:12:13.60,0:12:15.44,Default,,0,0,0,,Егер сіз осында қалсаңыз, сізге кедергі болады (Минатофукан жүзу клубының мүшелері)
Dialogue: 0,0:12:26.49,0:12:28.70,Default,,0,0,0,,Бағаңызды алыңыз
Dialogue: 0,0:12:38.42,0:12:39.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:40.55,0:12:41.76,Default,,0,0,0,,Ха... Уф...
Dialogue: 0,0:12:41.84,0:12:45.30,Default,,0,0,0,,Түсірілімге дайындықтарыңыз қалай? Біз көмектесе алатын бірдеңе бар ма?
Dialogue: 0,0:12:45.38,0:12:48.30,Default,,0,0,0,,Ах~ Хару-чан Мако-чан
Dialogue: 0,0:12:48.39,0:12:49.85,Default,,0,0,0,,әкелді
Dialogue: 0,0:12:49.93,0:12:51.60,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:51.68,0:12:53.93,Default,,0,0,0,,Эй, Рин келмей ме?
Dialogue: 0,0:12:54.02,0:12:57.65,Default,,0,0,0,,Бүгін мен Соуске ағам және оның достарымен ыстық бұлаққа барамын.
Dialogue: 0,0:12:57.73,0:12:59.98,Default,,0,0,0,,Ыстық бұлақ? неге тағы
Dialogue: 0,0:13:00.07,0:13:01.53,Default,,0,0,0,,Мектеп бітірушілер мерекесі
Dialogue: 0,0:13:01.61,0:13:04.95,Default,,0,0,0,,Мен Нитори-кун мен оның достарының маған тосын сый жасағанын естідім.
Dialogue: 0,0:13:05.03,0:13:08.07,Default,,0,0,0,,Иә!? Ай Чан, бұл керемет!
Dialogue: 0,0:13:08.16,0:13:09.12,Default,,0,0,0,,Нагиса-кун
Dialogue: 0,0:13:09.20,0:13:13.45,Default,,0,0,0,,Қарттарымызға да тосын сый жасайық!
Dialogue: 0,0:13:13.54,0:13:16.21,Default,,0,0,0,,Адамның алдында осылай айту дұрыс емес пе?
Dialogue: 0,0:13:16.29,0:13:18.29,Default,,0,0,0,,Жоқ! (Нағиса) Ахаха
Dialogue: 0,0:13:18.38,0:13:20.92,Default,,0,0,0,,Хахаха рахмет
Dialogue: 0,0:13:21.00,0:13:24.42,Default,,0,0,0,,Бірақ Рин Австралияға кеткенге дейін біз де
Dialogue: 0,0:13:24.51,0:13:26.01,Default,,0,0,0,,Сіз бірдеңе жасағыңыз келеді, солай ма?
Dialogue: 0,0:13:28.05,0:13:28.89,Default,,0,0,0,,Тосын
Dialogue: 0,0:13:28.97,0:13:31.56,Default,,0,0,0,,О, мен қатты таң қалдым!
Dialogue: 0,0:13:31.64,0:13:34.52,Default,,0,0,0,,Тек шектеулі уақытқа ғана, Sabamiso Cream!
Dialogue: 0,0:13:34.60,0:13:36.35,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:36.44,0:13:38.60,Default,,0,0,0,,Олай болса, үзіліс жасайық.
Dialogue: 0,0:13:38.69,0:13:41.52,Default,,0,0,0,,Мен, құлпынай сүті (Рей) Онда мен арпа шайын ішемін.
Dialogue: 0,0:13:43.61,0:13:47.07,Default,,0,0,0,,Я~ Өте дәмді көрінеді!
Dialogue: 0,0:13:47.15,0:13:49.41,Default,,0,0,0,,Олай болса, алайын ба? (Сусуке) Ах.
Dialogue: 0,0:13:49.49,0:13:51.37,Default,,0,0,0,,Кешіріңіз, бірақ бұған дейін.
Dialogue: 0,0:13:51.45,0:13:53.74,Default,,0,0,0,,Менен сәлем.
Dialogue: 0,0:13:56.54,0:13:58.00,Default,,0,0,0,,Бұл жолы біз
Dialogue: 0,0:13:58.08,0:14:01.59,Default,,0,0,0,,Мен Рин-сенпай мен Сосуке-сенпайға алғыс айтуды жоспарлап едім.
Dialogue: 0,0:14:01.67,0:14:05.17,Default,,0,0,0,,Екінші жағынан, мені шақырғаныңызға көп рахмет.
Dialogue: 0,0:14:05.92,0:14:09.39,Default,,0,0,0,,Бірақ соңында команданың төрт мүшесі осылай
Dialogue: 0,0:14:09.47,0:14:12.56,Default,,0,0,0,,Осы сапарға келгеніме өте қуаныштымын.
Dialogue: 0,0:14:12.64,0:14:14.56,Default,,0,0,0,,Бұл ең жақсы жады болады
Dialogue: 0,0:14:14.64,0:14:16.73,Default,,0,0,0,,Хух (Хякутаро) хи хи хи
Dialogue: 0,0:14:16.81,0:14:19.98,Default,,0,0,0,,Тым қиын, Ай-сенпай.
Dialogue: 0,0:14:20.06,0:14:22.27,Default,,0,0,0,,Ал, меннен де бір.
Dialogue: 0,0:14:22.36,0:14:23.57,Default,,0,0,0,,Ай (ұқсас құс) бұл... иә
Dialogue: 0,0:14:24.15,0:14:28.70,Default,,0,0,0,,Қазіргі уақытта мен менеджердің міндетін атқарушымын, бірақ сәуір айынан бастап ресми түрде менеджер боламын.
Dialogue: 0,0:14:28.78,0:14:30.49,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:14:30.57,0:14:32.62,Default,,0,0,0,,Иә, рақмет.
Dialogue: 0,0:14:32.70,0:14:36.41,Default,,0,0,0,,Рин-сенпайдың жолын қуып, бар күшімді салғым келеді.
Dialogue: 0,0:14:36.50,0:14:39.71,Default,,0,0,0,,Ай-сенпай, әлі қиын, шертіп тұр.
Dialogue: 0,0:14:39.79,0:14:42.79,Default,,0,0,0,,Олай болса, маңызды нәрселерге көшейік.
Dialogue: 0,0:14:42.88,0:14:45.67,Default,,0,0,0,,А, бұған дейін тост айтайық.
Dialogue: 0,0:14:46.67,0:14:50.84,Default,,0,0,0,,Рин-сенпай мен Сосуке-сенпай, еңбектеріңізге көп рахмет.
Dialogue: 0,0:14:51.68,0:14:52.85,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:15:06.44,0:15:08.24,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:08.86,0:15:09.86,Default,,0,0,0,,Момоға не болды?
Dialogue: 0,0:15:09.95,0:15:12.57,Default,,0,0,0,,Мен тым көп жеп кеткен сияқтымын.
Dialogue: 0,0:15:10.65,0:15:12.57,Default,,0,0,0,,У-у~
Dialogue: 0,0:15:12.57,0:15:14.62,Default,,0,0,0,,Ой-оу Мм... Мм... Ол кірер алдында қысқа үзіліс жасайды.
Dialogue: 0,0:15:20.21,0:15:21.62,Default,,0,0,0,,Ал...
Dialogue: 0,0:15:23.08,0:15:24.54,Default,,0,0,0,,Рин-сенпай ше?
Dialogue: 0,0:15:25.75,0:15:27.50,Default,,0,0,0,,Қызып кетсем де, бірінші көтерілдім.
Dialogue: 0,0:15:28.42,0:15:30.63,Default,,0,0,0,,Рин де сәл толқыған сияқты.
Dialogue: 0,0:15:32.55,0:15:36.01,Default,,0,0,0,,Соуске-сенпайдың да рахаттанып жатқанына қуанамын.
Dialogue: 0,0:15:38.06,0:15:41.02,Default,,0,0,0,,Мен барлық уақытта жүзу туралы ойладым.
Dialogue: 0,0:15:42.06,0:15:44.98,Default,,0,0,0,,Достармен осылай уақыт өткізу жақсы.
Dialogue: 0,0:15:45.65,0:15:47.82,Default,,0,0,0,,Рин-сенпайға, әрине.
Dialogue: 0,0:15:47.90,0:15:52.70,Default,,0,0,0,,Осы сапарда мен Сосуке-сенпайға деген үлкен ризашылық сезімін сезіндім.
Dialogue: 0,0:15:52.78,0:15:54.78,Default,,0,0,0,,Мұны естігеніме қуаныштымын.
Dialogue: 0,0:15:54.87,0:15:56.95,Default,,0,0,0,,Не өзгерді?
Dialogue: 0,0:15:57.03,0:15:59.70,Default,,0,0,0,,«Егер сіз қатты тырыссаңыз, сіз бір жерде қайтадан жүзе аласыз».
Dialogue: 0,0:15:59.79,0:16:01.54,Default,,0,0,0,,«Әлеуетіңізді сындырмаңыз»
Dialogue: 0,0:16:01.62,0:16:06.29,Default,,0,0,0,,Менің осы уақытқа дейін келген себебім Соуске-сенпайдың сөзінен.
Dialogue: 0,0:16:08.63,0:16:12.68,Default,,0,0,0,,Мен де қазірден бастап барлығымен көп нәрсені бөліскім келеді.
Dialogue: 0,0:16:12.76,0:16:14.76,Default,,0,0,0,,Сондықтан да Сосуке-сенпай
Dialogue: 0,0:16:14.84,0:16:17.68,Default,,0,0,0,,Оқуды бітірсеңіз де, Самегараға келіңіз.
Dialogue: 0,0:16:17.76,0:16:20.93,Default,,0,0,0,,Олай болса, бізге қайтадан жол көрсетіңіз.
Dialogue: 0,0:16:22.31,0:16:23.94,Default,,0,0,0,,Ах, дұрыс.
Dialogue: 0,0:16:26.11,0:16:29.15,Default,,0,0,0,,Ай-сенпай, сені тастап кету сұмдық~
Dialogue: 0,0:16:29.23,0:16:31.32,Default,,0,0,0,,Уф... кешіріңіз
Dialogue: 0,0:16:31.40,0:16:34.07,Default,,0,0,0,,Иә! (Усами Аонами) О, сен сенімдісің.
Dialogue: 0,0:16:34.15,0:16:35.45,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:35.53,0:16:39.66,Default,,0,0,0,,Samegara Academy жүзу клубы 1 курс Мокошиба Момотаро!
Dialogue: 0,0:16:39.74,0:16:42.45,Default,,0,0,0,,«Жапон теңізінің теңіз құмырасы» менмін!
Dialogue: 0,0:16:42.54,0:16:47.75,Default,,0,0,0,,Hmph, Минатофукан орта мектебінің 1 курс жүзу клубы Усами Аонами!
Dialogue: 0,0:16:47.84,0:16:50.84,Default,,0,0,0,,«Капибара өзені» мен!
Dialogue: 0,0:16:50.92,0:16:53.13,Default,,0,0,0,,Капибара!? (Усами) Жарайды ма?
Dialogue: 0,0:16:53.22,0:16:55.93,Default,,0,0,0,,Бұрын сізде болған толтырылған капибара
Dialogue: 0,0:16:56.01,0:16:57.22,Default,,0,0,0,,Мен де соны мақсат еттім.
Dialogue: 0,0:16:57.30,0:17:00.76,Default,,0,0,0,,Өте өкінішті~ Бұл соңғысы болды.
Dialogue: 0,0:17:00.85,0:17:02.43,Default,,0,0,0,,Олай болса маған бер.
Dialogue: 0,0:17:02.52,0:17:04.69,Default,,0,0,0,,Бірінші келгенге бірінші қызмет көрсетіледі деп шешілді.
Dialogue: 0,0:17:04.77,0:17:05.98,Default,,0,0,0,,Не!?
Dialogue: 0,0:17:06.06,0:17:09.23,Default,,0,0,0,,Ха, ыстық су жақсы болды... Иә!?
Dialogue: 0,0:17:09.31,0:17:12.03,Default,,0,0,0,,Эй, сен не істеп жатырсың? Момо-кун
Dialogue: 0,0:17:12.11,0:17:13.86,Default,,0,0,0,,Ай-сенпай, дәл орнында
Dialogue: 0,0:17:13.94,0:17:16.11,Default,,0,0,0,,Бұдан былай осы капибара ағынымен
Dialogue: 0,0:17:16.20,0:17:18.24,Default,,0,0,0,,Капибара үшін жарысайық!
Dialogue: 0,0:17:18.32,0:17:19.62,Default,,0,0,0,,Момо-кун~
Dialogue: 0,0:17:19.70,0:17:22.91,Default,,0,0,0,,Ах~
Dialogue: 0,0:17:23.00,0:17:24.46,Default,,0,0,0,,Сүйегім сынды!
Dialogue: 0,0:17:24.54,0:17:27.08,Default,,0,0,0,,Мен Усами акула суреті бар жігітпен жарыспақ деп естідім.
Dialogue: 0,0:17:27.17,0:17:28.38,Default,,0,0,0,,Ә… Мен келдім бе…
Dialogue: 0,0:17:29.42,0:17:31.59,Default,,0,0,0,,Жарыс? Амал жоқ
Dialogue: 0,0:17:32.67,0:17:35.67,Default,,0,0,0,,Боқ~ Мен сенің соңынан еріп жүргенімде!
Dialogue: 0,0:17:38.51,0:17:40.93,Default,,0,0,0,,Даа~ Айт! (Момотаро) Жоқ, айт!
Dialogue: 0,0:17:41.97,0:17:42.97,Default,,0,0,0,,Мүмкіндік! (Нитори) Әй!
Dialogue: 0,0:17:43.06,0:17:44.22,Default,,0,0,0,,Ах
Dialogue: 0,0:17:44.31,0:17:46.73,Default,,0,0,0,,(Минатофукан клубының мүшелерінің қошеметі)
Dialogue: 0,0:17:46.81,0:17:49.31,Default,,0,0,0,,Ай-сенпай фу~
Dialogue: 0,0:17:49.40,0:17:52.07,Default,,0,0,0,,Тәтті~ Тағы бір рет! тағы бір рет
Dialogue: 0,0:17:52.15,0:17:54.94,Default,,0,0,0,,Хехе~ Қанша тырыссам да, бәрібір~
Dialogue: 0,0:17:54.11,0:17:54.94,Default,,0,0,0,,Сіз мені қатты алаңдатты.
Dialogue: 0,0:17:54.94,0:17:57.07,Default,,0,0,0,,Сен мені қатты уайымдадың.
Dialogue: 0,0:18:01.70,0:18:02.95,Default,,0,0,0,,Сіз де жүзесіз, солай ма?
Dialogue: 0,0:18:03.04,0:18:03.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:08.33,0:18:12.17,Default,,0,0,0,,Бұл акулалық жүзу клубы. Мен Минатофуканның түлегімін.
Dialogue: 0,0:18:12.92,0:18:15.84,Default,,0,0,0,,Біздің клуб мүшелері қиындық тудырып жатқан сияқты.
Dialogue: 0,0:18:22.89,0:18:24.97,Default,,0,0,0,,Сіз иығыңызды ауыртып жатырсыз ба?
Dialogue: 0,0:18:27.14,0:18:30.31,Default,,0,0,0,,А, мен тым көп жаттығатынмын.
Dialogue: 0,0:18:30.40,0:18:32.56,Default,,0,0,0,,Сондықтан жүзу «істеп жатқан» емес.
Dialogue: 0,0:18:32.65,0:18:34.32,Default,,0,0,0,,«Мен жасадым»
Dialogue: 0,0:18:35.44,0:18:40.32,Default,,0,0,0,,Менің досым да көзінің зақымдануынан біраз уақытқа жарысты жүзуді тоқтатуға мәжбүр болды.
Dialogue: 0,0:18:40.41,0:18:44.08,Default,,0,0,0,,Қазіргі уақытта университетте спорттық медицина мамандығы бойынша білім алуда.
Dialogue: 0,0:18:44.16,0:18:48.21,Default,,0,0,0,,Оның көзқарасы бойынша, оның жүзумен айналысуы
Dialogue: 0,0:18:48.29,0:18:50.58,Default,,0,0,0,,Менің ойымша, бұл тек жарыстар туралы емес.
Dialogue: 0,0:18:52.13,0:18:53.09,Default,,0,0,0,,Оларға қашып кетуге жол бермеңдер
Dialogue: 0,0:18:54.00,0:18:56.59,Default,,0,0,0,,Мен онымен қайтадан жүзгім келеді.
Dialogue: 0,0:19:00.34,0:19:03.60,Default,,0,0,0,,Кешіріңіз, оның сізге ешқандай қатысы жоқ.
Dialogue: 0,0:19:06.39,0:19:07.52,Default,,0,0,0,,Ал, қолыңнан келгеннің бәрін жаса.
Dialogue: 0,0:19:24.41,0:19:25.87,Default,,0,0,0,,Ұйықтау мүмкін емес пе?
Dialogue: 0,0:19:25.95,0:19:27.87,Default,,0,0,0,,О, сен де?
Dialogue: 0,0:19:27.95,0:19:33.04,Default,,0,0,0,,Муня... Ай-сенпай, анау капибара менікі...
Dialogue: 0,0:19:34.17,0:19:35.84,Default,,0,0,0,,Сізге капибара қаншалықты ұнайды?
Dialogue: 0,0:19:35.92,0:19:38.88,Default,,0,0,0,,Әй, көңілді жүргеніме біраз болды
Dialogue: 0,0:19:38.96,0:19:40.63,Default,,0,0,0,,Кейде осындай нәрсені жасау жақсы
Dialogue: 0,0:19:42.76,0:19:43.72,Default,,0,0,0,,Жақсы
Dialogue: 0,0:19:43.80,0:19:46.51,Default,,0,0,0,,Австралияға кетер алдында менде керемет естеліктер болды.
Dialogue: 0,0:19:47.26,0:19:49.02,Default,,0,0,0,,Мен Ай мен Момоға алғыс айтуым керек.
Dialogue: 0,0:19:51.77,0:19:52.64,Default,,0,0,0,,Сәлем, Сусуке
Dialogue: 0,0:19:52.73,0:19:53.94,Default,,0,0,0,,Не?
Dialogue: 0,0:19:55.98,0:19:57.48,Default,,0,0,0,,Сіз...
Dialogue: 0,0:19:57.57,0:19:58.90,Default,,0,0,0,,Хунгья~
Dialogue: 0,0:19:58.98,0:20:00.78,Default,,0,0,0,,Бұл капибара емес, альпака!
Dialogue: 0,0:20:00.86,0:20:02.40,Default,,0,0,0,,Сіз не туралы армандайсыз?
Dialogue: 0,0:20:02.49,0:20:05.91,Default,,0,0,0,,Хехе, сен не айтып тұрсың?
Dialogue: 0,0:20:07.28,0:20:11.54,Default,,0,0,0,,Жоқ, бұл ештеңе емес. Ертең ерте тұрып ыстық суға шомылайық.
Dialogue: 0,0:20:11.62,0:20:13.46,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:20:13.54,0:20:15.79,Default,,0,0,0,,Қалай болғанда да, мен жақында 15-ке толамын.
Dialogue: 0,0:20:29.68,0:20:32.31,Default,,0,0,0,,Көңілді болды~ Басқа жерге барайық
Dialogue: 0,0:20:32.39,0:20:34.69,Default,,0,0,0,,Енді альпакалар бар
Dialogue: 0,0:20:34.77,0:20:36.81,Default,,0,0,0,,Хайуанаттар бағы жақсырақ емес пе?
Dialogue: 0,0:20:36.90,0:20:41.82,Default,,0,0,0,,Ха, есіме түсті! Мен кеше түсімде альпаканы көрдім
Dialogue: 0,0:20:42.99,0:20:46.03,Default,,0,0,0,,О~ Мен ғибадатханаға немесе бір нәрсеге тоқтағым келеді.
Dialogue: 0,0:20:46.11,0:20:46.95,Default,,0,0,0,,Иә
Dialogue: 0,0:20:47.82,0:20:51.45,Default,,0,0,0,,Ах! Тұмар сатамын. Тұмар~
Dialogue: 0,0:20:52.04,0:20:53.96,Default,,0,0,0,,Бірдеңе сатып алайық.
Dialogue: 0,0:20:54.04,0:20:56.88,Default,,0,0,0,,Уау, неше түрлі түрлері бар.
Dialogue: 0,0:21:00.92,0:21:03.47,Default,,0,0,0,,Сусуке-сенпай сатып ала ма?
Dialogue: 0,0:21:03.55,0:21:04.80,Default,,0,0,0,,Жоқ
Dialogue: 0,0:21:06.89,0:21:09.14,Default,,0,0,0,,Дұрыс, ей, Ай-сенпай.
Dialogue: 0,0:21:09.22,0:21:11.68,Default,,0,0,0,,Бұл бізден келген сыйлық. Оны бойтұмар ретінде қолданайық.
Dialogue: 0,0:21:11.77,0:21:13.56,Default,,0,0,0,,Аа~ Керемет, Момо-кун.
Dialogue: 0,0:21:13.64,0:21:15.35,Default,,0,0,0,,Хехехехе сосын Ай-сенпай.
Dialogue: 0,0:21:15.44,0:21:16.94,Default,,0,0,0,,Рин-сенпайды таңдаңыз.
Dialogue: 0,0:21:17.02,0:21:18.77,Default,,0,0,0,,Мен Сосуке-сенпайдікімін
Dialogue: 0,0:21:18.86,0:21:19.94,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:21:21.78,0:21:24.95,Default,,0,0,0,,Рин-сенпай, өтінемін (Рин), о... о.
Dialogue: 0,0:21:31.20,0:21:33.08,Default,,0,0,0,,Рахмет Ай
Dialogue: 0,0:21:33.16,0:21:35.04,Default,,0,0,0,,Бұл Сусуке-сенпайға арналған.
Dialogue: 0,0:21:35.12,0:21:35.96,Default,,0,0,0,,Рахмет
Dialogue: 0,0:21:39.88,0:21:40.71,Default,,0,0,0,,Ах
Dialogue: 0,0:21:48.93,0:21:49.93,Default,,0,0,0,,Иә
Dialogue: 0,0:22:04.36,0:22:08.78,Default,,0,0,0,,Уф... оның біткенінің белгісі жоқ.
Dialogue: 0,0:22:08.86,0:22:11.41,Default,,0,0,0,,Мен Рин Чанның да осыны кигенін қалаймын~
Dialogue: 0,0:22:11.49,0:22:14.16,Default,,0,0,0,,Рин бос емес.
Dialogue: 0,0:22:14.24,0:22:17.75,Default,,0,0,0,,Иә, аға, мен бүгін Самегараға барамын.
Dialogue: 0,0:22:17.83,0:22:18.67,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:22:18.75,0:22:21.13,Default,,0,0,0,,Жатақханадан бас тартпадың ба?
Dialogue: 0,0:22:21.21,0:22:24.00,Default,,0,0,0,,Ол Сусуке-кунның қозғалуына көмектеспекші.
Dialogue: 0,0:22:27.47,0:22:30.18,Default,,0,0,0,,Хехехехе~ Мен көп нәрсе алдым деп ойлаймын.
Dialogue: 0,0:22:30.26,0:22:31.09,Default,,0,0,0,,О
Dialogue: 0,0:22:31.18,0:22:32.30,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:22:33.10,0:22:34.93,Default,,0,0,0,,Бұл Уозуми маған берген механизм.
Dialogue: 0,0:22:35.02,0:22:36.31,Default,,0,0,0,,Бұл жара мен қазып алынған топырақ неден?
Dialogue: 0,0:22:38.35,0:22:39.56,Default,,0,0,0,,Албырт балыққа айналады
Dialogue: 0,0:22:39.64,0:22:41.44,Default,,0,0,0,,өтіңіз
Dialogue: 0,0:22:54.37,0:22:56.79,Default,,0,0,0,,Иә? Не болды, Сосуке?
Dialogue: 0,0:22:56.87,0:22:58.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:23:01.58,0:23:03.38,Default,,0,0,0,,Мен жеңуім керек.
Dialogue: 0,0:23:08.63,0:23:09.97,Default,,0,0,0,,♪~
Dialogue: 0,0:23:10.05,0:23:13.43,Default,,0,0,0,,♪ ВОЙ ВО ВО ВО ВАУ
Dialogue: 0,0:23:13.51,0:23:15.56,Default,,0,0,0,,♪ ИӘ
Dialogue: 0,0:23:17.35,0:23:20.27,Default,,0,0,0,,♪ Бүгін не болды?
Dialogue: 0,0:23:20.35,0:23:23.40,Default,,0,0,0,,♪ «Олар да бүгін қатты қуанды».
Dialogue: 0,0:23:23.48,0:23:24.82,Default,,0,0,0,,♪ «Мен жеңіле алмаймын.»
Dialogue: 0,0:23:24.90,0:23:27.82,Default,,0,0,0,,♪ Не болды?
Dialogue: 0,0:23:27.90,0:23:30.11,Default,,0,0,0,,♪ «Қалай болса да ашуланасың».
Dialogue: 0,0:23:30.20,0:23:31.49,Default,,0,0,0,,♪ «Ұрыс»
Dialogue: 0,0:23:32.32,0:23:34.62,Default,,0,0,0,,♪ Тіпті шуақты күнде
Dialogue: 0,0:23:34.70,0:23:37.54,Default,,0,0,0,,♪ «Мен де бүгін бар күшімді саламын».
Dialogue: 0,0:23:39.75,0:23:42.67,Default,,0,0,0,,♪ Жаңбыр жауатын күндердің өзінде
Dialogue: 0,0:23:43.42,0:23:45.25,Default,,0,0,0,,♪ "Сенпай! Мен қалай болдым?"
Dialogue: 0,0:23:45.34,0:23:47.13,Default,,0,0,0,,♪ «Бұл тамаша болды ма?»
Dialogue: 0,0:23:47.21,0:23:50.76,Default,,0,0,0,,♪ Біз қатты күлдік
Dialogue: 0,0:23:50.84,0:23:53.93,Default,,0,0,0,,♪ Тағы да күлімсіреп
Dialogue: 0,0:23:54.68,0:23:58.27,Default,,0,0,0,,♪ Жаңа сәт
Dialogue: 0,0:23:58.35,0:24:04.44,Default,,0,0,0,,♪ Барлығымыз оларды жинап жатырмыз (бірге)
Dialogue: 0,0:24:05.15,0:24:08.82,Default,,0,0,0,,♪ Күн сайын
Dialogue: 0,0:24:08.90,0:24:13.20,Default,,0,0,0,,♪ Әр күн керемет
Dialogue: 0,0:24:13.28,0:24:16.70,Default,,0,0,0,,♪ қарапайым және жағымды
Dialogue: 0,0:24:16.78,0:24:20.00,Default,,0,0,0,,♪ Мен біздің байланысымызға қуаныштымын.
Dialogue: 0,0:24:20.08,0:24:23.71,Default,,0,0,0,,♪ Күн сайын Бүгінгі күнді еске алу
Dialogue: 0,0:24:23.79,0:24:28.13,Default,,0,0,0,,♪ Әр күн Бүгінмен өмір сүрейік
Dialogue: 0,0:24:28.21,0:24:34.38,Default,,0,0,0,,♪ Осы досыммен бірге көргім келетін пейзаж
Dialogue: 0,0:24:34.47,0:24:37.51,Default,,0,0,0,,♪ Қуып жету
