Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.96,0:00:09.88,Default,,0,0,0,,Жарайды, кемеде жазу қиын.
Dialogue: 0,0:00:09.96,0:00:11.21,Default,,0,0,0,,Бұл жақсы тәжірибе болды.
Dialogue: 0,0:00:12.38,0:00:16.68,Default,,0,0,0,,Сондай-ақ ақ қағазды бояуды ойлау оңай екенін білдім.
Dialogue: 0,0:00:17.80,0:00:20.14,Default,,0,0,0,,Осының арқасында менің қылқалам штрихтарым жеңіл.
Dialogue: 0,0:00:20.22,0:00:23.60,Default,,0,0,0,,Мейкайн кітап көрмесіне бір ай қалды
Dialogue: 0,0:00:23.69,0:00:25.56,Default,,0,0,0,,Бір айдың ішінде, бұл жолы...
Dialogue: 0,0:00:27.52,0:00:28.73,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:30.78,0:00:31.78,Default,,0,0,0,,Тасбақа қара
Dialogue: 0,0:00:32.74,0:00:33.99,Default,,0,0,0,,Бұл не? Бұл
Dialogue: 0,0:00:34.07,0:00:35.49,Default,,0,0,0,,Кономон
Dialogue: 0,0:00:35.57,0:00:36.87,Default,,0,0,0,,Бұл нәрсе?
Dialogue: 0,0:00:37.49,0:00:38.74,Default,,0,0,0,,Соншама?
Dialogue: 0,0:00:38.83,0:00:40.79,Default,,0,0,0,,Не дедің!
Dialogue: 0,0:00:40.87,0:00:43.37,Default,,0,0,0,,Егер ол ырылдаса, оны қайтадан алыңыз.
Dialogue: 0,0:00:46.42,0:00:49.29,Default,,0,0,0,,Арт жақтан шығасың ба?
Dialogue: 0,0:00:49.96,0:00:51.25,Default,,0,0,0,,Я...
Dialogue: 0,0:00:51.34,0:00:54.63,Default,,0,0,0,,Менің бұлай жеуге мүмкіндігім жоқ.
Dialogue: 0,0:00:56.51,0:00:57.34,Default,,0,0,0,,Ха…
Dialogue: 0,0:00:58.64,0:00:59.80,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:01:01.31,0:01:03.10,Default,,0,0,0,,Бірақ дәл қазір мен каллиграфияға назар аударып жатырмын.
Dialogue: 0,0:01:03.18,0:01:06.60,Default,,0,0,0,,Бұл көркем әрі жаңашыл әріп...
Dialogue: 0,0:01:06.81,0:01:07.73,Default,,0,0,0,,Бұлай емес!
Dialogue: 0,0:01:07.94,0:01:10.36,Default,,0,0,0,,Мен жазамын, бұл туралы жазамын ...
Dialogue: 0,0:01:10.57,0:01:12.11,Default,,0,0,0,,Бұлай емес!
Dialogue: 0,0:01:12.32,0:01:14.61,Default,,0,0,0,,Конмонин Шотен келесі айда өтеді...
Dialogue: 0,0:01:14.82,0:01:16.61,Default,,0,0,0,,Бұл Монин Шотен емес!
Dialogue: 0,0:01:16.82,0:01:18.36,Default,,0,0,0,,Кономон Кономон
Dialogue: 0,0:01:18.57,0:01:20.03,Default,,0,0,0,,Бұл нәрсе!
Dialogue: 0,0:01:21.12,0:01:23.91,Default,,0,0,0,,Кономон!
Dialogue: 0,0:01:24.00,0:01:28.71,Default,,0,0,0,,♪~
Dialogue: 0,0:02:50.33,0:02:53.96,Default,,0,0,0,,~♪
Dialogue: 0,0:02:59.05,0:03:03.43,Default,,0,0,0,,Кономон Кономон Кономон Кономон
Dialogue: 0,0:03:03.51,0:03:04.51,Default,,0,0,0,,Кономон Кономон…
Dialogue: 0,0:03:04.51,0:03:05.68,Default,,0,0,0,,Кономон Кономон…
Dialogue: 0,0:03:04.51,0:03:05.68,Default,,0,0,0,,
Dialogue: 0,0:03:05.76,0:03:06.60,Default,,0,0,0,,Бұл нәрсе?
Dialogue: 0,0:03:07.43,0:03:10.18,Default,,0,0,0,,Егер ол ырылдаса, оны қайтадан ал.
Dialogue: 0,0:03:11.60,0:03:13.48,Default,,0,0,0,,Ха, бұл өте керемет!
Dialogue: 0,0:03:13.56,0:03:15.94,Default,,0,0,0,,Каллиграфияны айт
Dialogue: 0,0:03:16.02,0:03:17.90,Default,,0,0,0,,Хмм... сендер балаларсыңдар ма (Тама/Мива)?
Dialogue: 0,0:03:18.74,0:03:20.86,Default,,0,0,0,,Балалар сендер дөрекіліксіңдер ме?
Dialogue: 0,0:03:20.95,0:03:22.95,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:23.03,0:03:23.87,Default,,0,0,0,,Иә (Ханда) Ах.
Dialogue: 0,0:03:23.95,0:03:26.78,Default,,0,0,0,,Көп болса да проблема емес.
Dialogue: 0,0:03:26.87,0:03:28.58,Default,,0,0,0,,Оны өзіңізбен бірге алыңыз, ата.
Dialogue: 0,0:03:29.50,0:03:31.25,Default,,0,0,0,,Рахмет
Dialogue: 0,0:03:32.46,0:03:34.88,Default,,0,0,0,,Мұғалім, тапсырманы орындауға көмектесіңізші.
Dialogue: 0,0:03:35.92,0:03:38.05,Default,,0,0,0,,Алдымен щетканы оң қолыңызбен ұстаңыз.
Dialogue: 0,0:03:38.13,0:03:40.09,Default,,0,0,0,,Оң қол осында (Ханда) Дұрыс.
Dialogue: 0,0:03:40.17,0:03:42.88,Default,,0,0,0,,Каллиграфия Сізге оң қол болуы керек пе?
Dialogue: 0,0:03:42.97,0:03:46.39,Default,,0,0,0,,Жаман емес, бірақ тамшының орнын жазу қиын.
Dialogue: 0,0:03:46.47,0:03:48.26,Default,,0,0,0,,тапсырма үшін қандай сөз?
Dialogue: 0,0:03:48.35,0:03:50.85,Default,,0,0,0,,Міне... міне.
Dialogue: 0,0:03:50.93,0:03:54.23,Default,,0,0,0,,Ал, мен үлгі жазамын, мұқият қараңдар.
Dialogue: 0,0:03:55.02,0:03:56.31,Default,,0,0,0,,Кедергі
Dialogue: 0,0:04:00.44,0:04:03.99,Default,,0,0,0,,А, мен әдеттегідей Басаркчи деп жазу керек пе?
Dialogue: 0,0:04:04.07,0:04:06.07,Default,,0,0,0,,Басар...
Dialogue: 0,0:04:06.16,0:04:07.95,Default,,0,0,0,,Барлығы негізгі білімді меңгеруге байланысты.
Dialogue: 0,0:04:08.03,0:04:11.04,Default,,0,0,0,,А, мен де солай жаздым ба?
Dialogue: 0,0:04:11.12,0:04:11.96,Default,,0,0,0,,Иә? (Мива) Жарқыраған алақан
Dialogue: 0,0:04:12.87,0:04:15.21,Default,,0,0,0,,Ах, мен оны әлі зерттеп жатырмын.
Dialogue: 0,0:04:15.29,0:04:18.50,Default,,0,0,0,,Ол аяқталып, бекітілгеннен кейін мен оны сізге үйретемін.
Dialogue: 0,0:04:18.59,0:04:20.67,Default,,0,0,0,,Сізді кім мойындайды?
Dialogue: 0,0:04:22.09,0:04:25.76,Default,,0,0,0,,Келесі айдағы Мейкаин көрмесінде каллиграф сыйлығын жеңіп алғанша
Dialogue: 0,0:04:25.84,0:04:27.35,Default,,0,0,0,,Хмм.
Dialogue: 0,0:04:27.43,0:04:30.97,Default,,0,0,0,,Ешбір марапатқа ие болмасаңыз да, жақсы болыңыз.
Dialogue: 0,0:04:31.06,0:04:33.94,Default,,0,0,0,,Ештеңеге алаңдамай жазу маған ұнады ма?
Dialogue: 0,0:04:34.02,0:04:36.23,Default,,0,0,0,,Бұл қызық па...
Dialogue: 0,0:04:36.73,0:04:39.15,Default,,0,0,0,,Балалар сендер шынымен балаларсыңдар (Мива/Тама) Уф.
Dialogue: 0,0:04:39.23,0:04:41.82,Default,,0,0,0,,Қара, Наруха, мынаны жаз.
Dialogue: 0,0:04:42.53,0:04:44.11,Default,,0,0,0,,Әй мысық!
Dialogue: 0,0:04:44.20,0:04:45.57,Default,,0,0,0,,Жақсы! (3 адам) Иә?
Dialogue: 0,0:04:46.20,0:04:49.83,Default,,0,0,0,,Саған үйретсем, міндетті түрде жеңуіңе жол беремін.
Dialogue: 0,0:04:50.45,0:04:51.74,Default,,0,0,0,,Нәтижелер қолжетімді болған кезде
Dialogue: 0,0:04:51.83,0:04:55.79,Default,,0,0,0,,Менің марапаттарға неге ерекше көңіл бөлетінімді өзіңіз білесіз.
Dialogue: 0,0:04:56.42,0:04:59.00,Default,,0,0,0,,Енді бір сағат бойы ойланбастан жаза бер!
Dialogue: 0,0:04:59.09,0:05:01.00,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:05:03.01,0:05:05.26,Default,,0,0,0,,Ах (Ханда) концентраты.
Dialogue: 0,0:05:05.34,0:05:07.84,Default,,0,0,0,,Аа, сияны екі рет жақсаңыз жақсы емес.
Dialogue: 0,0:05:09.76,0:05:11.47,Default,,0,0,0,,Уф... (Дәнекер) Мұндағы сызық ондай емес.
Dialogue: 0,0:05:11.56,0:05:12.60,Default,,0,0,0,,Бір рет тоқтатыңыз.
Dialogue: 0,0:05:15.23,0:05:16.19,Default,,0,0,0,,Ұйықтама
Dialogue: 0,0:05:18.86,0:05:20.44,Default,,0,0,0,,Куу…
Dialogue: 0,0:05:20.52,0:05:22.78,Default,,0,0,0,,Енді жоқ
Dialogue: 0,0:05:22.86,0:05:24.78,Default,,0,0,0,,Ей, балалар, жалқау болмаңдар!
Dialogue: 0,0:05:25.57,0:05:27.57,Default,,0,0,0,,Тапсырма: Көмек сұраған сенсің.
Dialogue: 0,0:05:27.66,0:05:30.03,Default,,0,0,0,,Бас жүлдеден басқа ештеңе ұтып алуыңа жол бермеймін.
Dialogue: 0,0:05:30.12,0:05:33.62,Default,,0,0,0,,Қарсы болсаң да, мен сені бір сөзді бірнеше рет жазуға мәжбүр етемін.
Dialogue: 0,0:05:33.70,0:05:35.29,Default,,0,0,0,,Жақсы жазуға арналған кеңестер бар ма?
Dialogue: 0,0:05:35.37,0:05:37.87,Default,,0,0,0,,Балалар сендер өте тәттісіңдер! Кәсіби каллиграф⸺
Dialogue: 0,0:05:37.96,0:05:40.33,Default,,0,0,0,,Сіздің қолжазбаңыз қарапайым және әдемі деп ойлайсыз ба?
Dialogue: 0,0:05:40.92,0:05:44.30,Default,,0,0,0,,Бір кітаптағы құмарлық сезімдерін түсіріңіз.
Dialogue: 0,0:05:44.38,0:05:49.22,Default,,0,0,0,,Мыңдаған, он мыңдаған бабалар триллиондаған квинтилиллион ойларды қағаз бетіне түсірген.
Dialogue: 0,0:05:49.30,0:05:51.01,Default,,0,0,0,,Кім? Келіңіздер
Dialogue: 0,0:05:51.10,0:05:55.39,Default,,0,0,0,,Физикалық шаршау, ақыл-ойдың әлсіздігі, жалғыздықпен бетпе-бет келу
Dialogue: 0,0:05:55.48,0:05:58.64,Default,,0,0,0,,Иә, шекті қараңыз.
Dialogue: 0,0:05:58.73,0:06:00.31,Default,,0,0,0,,Шектеу…
Dialogue: 0,0:06:01.77,0:06:05.94,Default,,0,0,0,,Тағы бір қадам, аяқтауға тағы бір қадам
Dialogue: 0,0:06:06.03,0:06:09.49,Default,,0,0,0,,Дегенмен алда әлі мәңгілік шөл бар.
Dialogue: 0,0:06:09.57,0:06:12.20,Default,,0,0,0,,Мен енді жүре алмаймын. Мен жазудан шаршадым.
Dialogue: 0,0:06:12.28,0:06:15.16,Default,,0,0,0,,Мен осылай ойлаған сәтте мен оны көре аламын.
Dialogue: 0,0:06:16.04,0:06:17.91,Default,,0,0,0,,Кітаптардың Құдайы
Dialogue: 0,0:06:19.25,0:06:22.88,Default,,0,0,0,,Бірақ әлгі құдай да айдаладағы сағым!
Dialogue: 0,0:06:22.96,0:06:26.13,Default,,0,0,0,,Каллиграфиялық галлюцинациялар Бірінші рет көрінді
Dialogue: 0,0:06:26.21,0:06:30.97,Default,,0,0,0,,Екінші жағынан, егер сіз орта мектептегі тапсырмамен соншалықты алысқа барғыңыз келмесе,
Dialogue: 0,0:06:31.05,0:06:32.64,Default,,0,0,0,,Жарайды, маған шырын сатып ал.
Dialogue: 0,0:06:33.81,0:06:35.81,Default,,0,0,0,,Ақыр соңында, балалар, сендердің мотивацияларың жоқ.
Dialogue: 0,0:06:35.89,0:06:40.10,Default,,0,0,0,,Ару Ару Арукен сәл демалуға рұқсат етіңізші.
Dialogue: 0,0:06:40.19,0:06:43.44,Default,,0,0,0,,Мен қайтып келгенше жазып ал.
Dialogue: 0,0:06:43.52,0:06:45.98,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:06:46.07,0:06:47.44,Default,,0,0,0,,Я...
Dialogue: 0,0:06:47.53,0:06:50.49,Default,,0,0,0,,Ұстаз, сіз нағыз каллиграфиялық ақымақсыз!
Dialogue: 0,0:06:51.28,0:06:53.70,Default,,0,0,0,,Егер солай болса, Рокусуппо да қызға ие бола алмайды.
Dialogue: 0,0:06:53.78,0:06:58.16,Default,,0,0,0,,Алыстан кездесіп жүрген адам бар ма деп ойлаймын.
Dialogue: 0,0:06:58.25,0:06:59.08,Default,,0,0,0,,Ол?
Dialogue: 0,0:06:59.16,0:07:02.08,Default,,0,0,0,,Мүмкін мен бөлмені жасырын қарауым керек.
Dialogue: 0,0:07:02.17,0:07:04.29,Default,,0,0,0,,Тоқта, оның дәмі нашар.
Dialogue: 0,0:07:06.17,0:07:07.05,Default,,0,0,0,,О (Нару/Тама) Иә?
Dialogue: 0,0:07:08.21,0:07:10.80,Default,,0,0,0,,Кавафуджи мырза? Ол ол болуы мүмкін
Dialogue: 0,0:07:10.88,0:07:13.01,Default,,0,0,0,,Әй... Мива-чан, қалағаныңды істе.
Dialogue: 0,0:07:13.09,0:07:15.14,Default,,0,0,0,,А, бұл адам еді. Қайсысы?
Dialogue: 0,0:07:15.22,0:07:17.01,Default,,0,0,0,,Не? Оның шағуы
Dialogue: 0,0:07:17.68,0:07:18.98,Default,,0,0,0,,Естелік сурет?
Dialogue: 0,0:07:19.06,0:07:21.39,Default,,0,0,0,,Ішінде біреумен араласу
Dialogue: 0,0:07:21.48,0:07:23.02,Default,,0,0,0,,Мына қыз ше?
Dialogue: 0,0:07:23.10,0:07:25.90,Default,,0,0,0,,Ол әдемі, бірақ менің ойымша, бұл оның орналасқан жеріне байланысты.
Dialogue: 0,0:07:25.98,0:07:27.07,Default,,0,0,0,,(Зенitsu) Өтінемін! (Күсари-карасу) Кә~!
Dialogue: 0,0:07:27.15,0:07:30.11,Default,,0,0,0,,Мен мұғалімнің ғашығына жарамаймын деп ойлаймын.
Dialogue: 0,0:07:30.19,0:07:32.82,Default,,0,0,0,,Бет маңызды емес, солай ма? Авава...
Dialogue: 0,0:07:32.91,0:07:35.95,Default,,0,0,0,,Каллиграфия туралы айтсаң жеткілікті, аға.
Dialogue: 0,0:07:36.03,0:07:38.95,Default,,0,0,0,,Сіздің қиялыңызды тыңдайтын әйел бар деп ойлайсыз ба?
Dialogue: 0,0:07:39.04,0:07:39.87,Default,,0,0,0,,Хата!
Dialogue: 0,0:07:39.95,0:07:42.12,Default,,0,0,0,,Тыңдасаң, маймыл да істей алады.
Dialogue: 0,0:07:42.21,0:07:43.17,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:07:43.25,0:07:44.67,Default,,0,0,0,,Доганшита? Болу
Dialogue: 0,0:07:44.75,0:07:48.13,Default,,0,0,0,,Бұл ұстаздың асыл қазынасы.
Dialogue: 0,0:07:48.21,0:07:49.38,Default,,0,0,0,,Не? Бұл
Dialogue: 0,0:07:49.46,0:07:50.76,Default,,0,0,0,,Фото жиектеме?
Dialogue: 0,0:07:50.84,0:07:53.30,Default,,0,0,0,,Сіздің сүйікті фотосуретіңіз қосылған сияқты.
Dialogue: 0,0:07:53.38,0:07:55.39,Default,,0,0,0,,Хи хи уау...
Dialogue: 0,0:07:56.01,0:07:56.85,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:56.93,0:07:59.68,Default,,0,0,0,,Себебі мұғалім тұрмыстағы әйел.
Dialogue: 0,0:07:59.77,0:08:02.35,Default,,0,0,0,,Нару Тұрмысқа шыққан әйелдің қолдануы басқаша.
Dialogue: 0,0:08:02.44,0:08:04.65,Default,,0,0,0,,Наруха сізді жақсы көреді, ұстаз.
Dialogue: 0,0:08:04.73,0:08:06.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:06.94,0:08:08.27,Default,,0,0,0,,Жарайды
Dialogue: 0,0:08:08.36,0:08:10.44,Default,,0,0,0,,Бір жаста болсаң, ешқашан әйелмен кездеспесең жақсы болар еді.
Dialogue: 0,0:08:10.53,0:08:11.69,Default,,0,0,0,,Жынды әзіл
Dialogue: 0,0:08:11.78,0:08:14.95,Default,,0,0,0,,Тағы 10 жылдан кейін Нару одан да әдемі болады.
Dialogue: 0,0:08:15.03,0:08:17.16,Default,,0,0,0,,Оны ұрламаңыз.
Dialogue: 0,0:08:17.24,0:08:18.66,Default,,0,0,0,,Тонау?
Dialogue: 0,0:08:18.74,0:08:20.50,Default,,0,0,0,,Көрейік, көрейік
Dialogue: 0,0:08:20.58,0:08:22.08,Default,,0,0,0,,Мұғалімнің қызы~
Dialogue: 0,0:08:24.54,0:08:25.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:25.83,0:08:26.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:25.83,0:08:26.92,Default,,0,0,0,,(Есіктің ашылу дыбысы)
Dialogue: 0,0:08:27.00,0:08:28.71,Default,,0,0,0,,Мен шырын сатып алдым.
Dialogue: 0,0:08:28.79,0:08:30.67,Default,,0,0,0,,Балалар сендер не істеп жатырсыңдар?
Dialogue: 0,0:08:30.76,0:08:34.05,Default,,0,0,0,,Егер сіз мұны жақсы орындамасаңыз, жүлдені алу былай тұрсын, бас жүлдені де ұтып алмайсыз.
Dialogue: 0,0:08:34.13,0:08:35.43,Default,,0,0,0,,Иә! (Ханда) Иә?
Dialogue: 0,0:08:35.51,0:08:39.35,Default,,0,0,0,,Сіздің мұғаліміңіз қазірдің өзінде 23-те, солай емес пе? Каллиграфиядан басқа нәрселерді қараңыз!
Dialogue: 0,0:08:39.43,0:08:42.14,Default,,0,0,0,,Тарихи тұлғалар сізді қызықтырады ма?
Dialogue: 0,0:08:42.23,0:08:44.31,Default,,0,0,0,,Шындыққа оралыңыз (Ханда) Иә?
Dialogue: 0,0:08:44.39,0:08:46.69,Default,,0,0,0,,Сенсей, мен сенімен бірге шығамын.
Dialogue: 0,0:08:46.77,0:08:48.31,Default,,0,0,0,,Ха! Уф...
Dialogue: 0,0:08:48.40,0:08:50.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:50.11,0:08:52.28,Default,,0,0,0,,Нару нару! Талан! (Ханда) Тонау?
Dialogue: 0,0:08:52.36,0:08:53.99,Default,,0,0,0,,Ой, тоқтат...
Dialogue: 0,0:08:54.07,0:08:55.28,Default,,0,0,0,,Ахххх
Dialogue: 0,0:08:55.36,0:08:57.57,Default,,0,0,0,,Осылай жалғаса берсе, мен жалғыз өлемін.
Dialogue: 0,0:08:57.66,0:08:58.91,Default,,0,0,0,,What are you talking about?
Dialogue: 0,0:08:58.99,0:08:59.99,Default,,0,0,0,,Тонау~!
Dialogue: 0,0:09:00.08,0:09:01.41,Default,,0,0,0,,Сіз де не айттыңыз!
Dialogue: 0,0:09:06.08,0:09:07.63,Default,,0,0,0,,Теңізде жүзу?
Dialogue: 0,0:09:07.71,0:09:09.59,Default,,0,0,0,,Бұл балалар жағажайға барады.
Dialogue: 0,0:09:09.67,0:09:12.00,Default,,0,0,0,,Сізден бақылаушы қызметін атқаруыңызды өтінемін.
Dialogue: 0,0:09:12.51,0:09:15.13,Default,,0,0,0,,Мен директордың орынбасарынан сұрадым, бірақ...
Dialogue: 0,0:09:15.22,0:09:17.34,Default,,0,0,0,,Ой, балық аулауға барайық.
Dialogue: 0,0:09:17.43,0:09:18.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:19.76,0:09:22.06,Default,,0,0,0,,Барлығы жүзе алады, солай ма?
Dialogue: 0,0:09:22.14,0:09:23.85,Default,,0,0,0,,Тек қарау жеткілікті
Dialogue: 0,0:09:23.93,0:09:27.90,Default,,0,0,0,,Мива мен Тама бірге бара жатқан сияқты.
Dialogue: 0,0:09:27.98,0:09:30.40,Default,,0,0,0,,Қауіпті ештеңе жасамас үшін қараңыз.
Dialogue: 0,0:09:30.48,0:09:33.03,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:09:33.11,0:09:36.11,Default,,0,0,0,,Мен өзімнің Хирошиімді сізге еріп жүруге рұқсат етемін.
Dialogue: 0,0:09:36.20,0:09:38.32,Default,,0,0,0,,Бұл қиындық тудыратын сияқты.
Dialogue: 0,0:09:39.70,0:09:41.24,Default,,0,0,0,,Мұғалім, кеттік.
Dialogue: 0,0:09:41.33,0:09:42.95,Default,,0,0,0,,О, қараңдаршы!
Dialogue: 0,0:09:43.04,0:09:44.12,Default,,0,0,0,,О, сәл күте тұрыңыз.
Dialogue: 0,0:09:44.20,0:09:45.96,Default,,0,0,0,,Мұғалім: Иә, иә... (Ханда) Түсіндім, түсіндім.
Dialogue: 0,0:09:46.04,0:09:46.91,Default,,0,0,0,,Дайын бол
Dialogue: 0,0:09:47.00,0:09:48.67,Default,,0,0,0,,Клизма! (Ханда) Тоқта!
Dialogue: 0,0:09:48.75,0:09:51.17,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:09:51.25,0:09:52.63,Default,,0,0,0,,Бұл жерде ойнамаңыз.
Dialogue: 0,0:09:52.71,0:09:54.38,Default,,0,0,0,,Ах Мивани мен Тама
Dialogue: 0,0:09:54.46,0:09:55.84,Default,,0,0,0,,Оссу Нару
Dialogue: 0,0:09:55.92,0:09:57.30,Default,,0,0,0,,Тым кеш, сэр.
Dialogue: 0,0:09:57.38,0:09:58.34,Default,,0,0,0,,Бүгін танысқаныма қуаныштымын
Dialogue: 0,0:09:58.43,0:10:02.05,Default,,0,0,0,,Иә? Не, балалар, сендер спорт залына ұқсас киім киіп жүрсіңдер ме?
Dialogue: 0,0:10:02.14,0:10:04.52,Default,,0,0,0,,Гимнастикалық киім сияқты емес
Dialogue: 0,0:10:04.60,0:10:06.18,Default,,0,0,0,,Бұл жүзудің және шаңғы тебудің ең жақсы тәсілі
Dialogue: 0,0:10:06.27,0:10:08.56,Default,,0,0,0,,О, сонда сіз жүзесіз бе?
Dialogue: 0,0:10:08.64,0:10:10.15,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:10:10.23,0:10:12.69,Default,,0,0,0,,Киіммен жүзу қиын.
Dialogue: 0,0:10:12.77,0:10:15.53,Default,,0,0,0,,Иә? Мұғалім киімін шешуі керек.
Dialogue: 0,0:10:15.61,0:10:18.36,Default,,0,0,0,,Жоқ, мен купальник киген жоқпын, хехе
Dialogue: 0,0:10:18.45,0:10:20.32,Default,,0,0,0,,Қош бол
Dialogue: 0,0:10:20.41,0:10:23.33,Default,,0,0,0,,Эй, күте тұр, Хиро мұнда әлі жоқ...
Dialogue: 0,0:10:25.20,0:10:26.83,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:10:27.75,0:10:30.37,Default,,0,0,0,,Жүріңдер, балалар, Хиро-нидің соңынан еріңдер!
Dialogue: 0,0:10:30.46,0:10:32.63,Default,,0,0,0,,Yes
Dialogue: 0,0:10:32.71,0:10:35.88,Default,,0,0,0,,Ол соншалықты көңіл көтеруге құштар емес пе?
Dialogue: 0,0:10:41.64,0:10:44.64,Default,,0,0,0,,Барлығымыз кеттік. Бүгін арқамен жүзіп жүрсеңіз, шебер атанасыз.
Dialogue: 0,0:10:44.72,0:10:46.22,Default,,0,0,0,,Иә! (Ханда) Эй
Dialogue: 0,0:10:46.31,0:10:47.39,Default,,0,0,0,,Тым қобалжымаңыз
Dialogue: 0,0:10:47.48,0:10:51.06,Default,,0,0,0,,Уайымдама, теңіз жыл сайын келеді.
Dialogue: 0,0:10:51.15,0:10:53.15,Default,,0,0,0,,Бұл теңіз бе, әлде тас па?
Dialogue: 0,0:10:53.23,0:10:55.11,Default,,0,0,0,,Қауіпсіз жағажайларда ойнайық.
Dialogue: 0,0:10:55.19,0:10:58.03,Default,,0,0,0,,Құмды жағажай – балалар ойнайтын орын.
Dialogue: 0,0:10:58.11,0:10:59.53,Default,,0,0,0,,Сондықтан!
Dialogue: 0,0:10:59.61,0:11:02.37,Default,,0,0,0,,Мұндай нашар аяқ ...
Dialogue: 0,0:11:03.70,0:11:04.53,Default,,0,0,0,,Уау
Dialogue: 0,0:11:04.62,0:11:05.45,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:11:05.53,0:11:06.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:07.41,0:11:09.41,Default,,0,0,0,,Мұғалім, сіз не істеп жатырсыз?
Dialogue: 0,0:11:09.50,0:11:12.88,Default,,0,0,0,,А, бұл ақылсыз.
Dialogue: 0,0:11:12.96,0:11:15.42,Default,,0,0,0,,Мұғалім, амансың ба?
Dialogue: 0,0:11:15.50,0:11:18.84,Default,,0,0,0,,Жарайды, бұл әркім жүретін жол
Dialogue: 0,0:11:18.92,0:11:21.01,Default,,0,0,0,,Жарайды, секір!
Dialogue: 0,0:11:21.09,0:11:23.39,Default,,0,0,0,,Оу!
Dialogue: 0,0:11:25.05,0:11:26.14,Default,,0,0,0,,Иә? Пухаа!
Dialogue: 0,0:11:26.22,0:11:27.64,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:11:27.72,0:11:29.10,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:11:29.18,0:11:31.06,Default,,0,0,0,,Бэ~ Қалың (Кента) Ахаха
Dialogue: 0,0:11:31.14,0:11:33.90,Default,,0,0,0,,Теңіз кірпі~ Теңіз кірпі~
Dialogue: 0,0:11:33.98,0:11:36.23,Default,,0,0,0,,Міне! (Мива) Тоқта.
Dialogue: 0,0:11:36.32,0:11:38.36,Default,,0,0,0,,Кя! Мұнда
Dialogue: 0,0:11:41.95,0:11:43.45,Default,,0,0,0,,Пухахахаха...
Dialogue: 0,0:11:43.53,0:11:45.24,Default,,0,0,0,,Хина Йокао балығы?
Dialogue: 0,0:11:45.32,0:11:48.49,Default,,0,0,0,,Мен сонда болдым, бірақ көзілдірігім тұман болды, мен жақсы көрмедім.
Dialogue: 0,0:11:49.08,0:11:51.83,Default,,0,0,0,,Жалықтырған кезде кружкамен сүртуге болады.
Dialogue: 0,0:11:52.71,0:11:55.08,Default,,0,0,0,,Ішіне қарақұйрық жапырақтарын қосыңыз.
Dialogue: 0,0:11:55.17,0:11:57.96,Default,,0,0,0,,Кружка сығындысы бұлтты ауа-райының алдын алады.
Dialogue: 0,0:11:58.05,0:12:02.93,Default,,0,0,0,,Әжеңдей білімді екенсің.
Dialogue: 0,0:12:03.47,0:12:04.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:04.97,0:12:07.43,Default,,0,0,0,,Нанкачи әжесі...
Dialogue: 0,0:12:07.51,0:12:09.31,Default,,0,0,0,,А, кешіріңіз, сізге ұнамады ма?
Dialogue: 0,0:12:09.39,0:12:13.10,Default,,0,0,0,,Мен оны ұнатпаймын деп шештім. Кочитора 7 жаста!
Dialogue: 0,0:12:13.19,0:12:15.06,Default,,0,0,0,,Угья! Кешіріңіз!
Dialogue: 0,0:12:16.77,0:12:19.44,Default,,0,0,0,,Сондықтан балалар
Dialogue: 0,0:12:20.11,0:12:23.24,Default,,0,0,0,,Теңізден қалай ләззат алуды білмеймін.
Dialogue: 0,0:12:25.66,0:12:29.62,Default,,0,0,0,,Мен оны көріп тұрмын! Хироши сыншысы!
Dialogue: 0,0:12:30.12,0:12:31.54,Default,,0,0,0,,Фу…
Dialogue: 0,0:12:31.62,0:12:33.50,Default,,0,0,0,,Ой! Бұл сегізаяқ!
Dialogue: 0,0:12:33.58,0:12:35.29,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:12:35.37,0:12:38.79,Default,,0,0,0,,Хиро-нии керемет!
Dialogue: 0,0:12:41.38,0:12:42.51,Default,,0,0,0,,Ах
Dialogue: 0,0:12:43.26,0:12:44.18,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:44.26,0:12:46.22,Default,,0,0,0,,Хиро-ни көңілсіз бе?
Dialogue: 0,0:12:46.30,0:12:48.18,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:48.26,0:12:52.14,Default,,0,0,0,,Ер адамдар теңізде ойнауды білмейді.
Dialogue: 0,0:12:56.73,0:13:00.07,Default,,0,0,0,,Кешіріңіз Мива Чан, мен біраз шаршадым.
Dialogue: 0,0:13:00.15,0:13:02.69,Default,,0,0,0,,Амансың ба? Өзіңді мәжбүрлеме, бубубубу...
Dialogue: 0,0:13:02.78,0:13:05.86,Default,,0,0,0,,Мен мұғалімнің орнында демаламын.
Dialogue: 0,0:13:05.95,0:13:07.36,Default,,0,0,0,,О
Dialogue: 0,0:13:08.87,0:13:09.70,Default,,0,0,0,,Ha
Dialogue: 0,0:13:10.66,0:13:12.54,Default,,0,0,0,,Уау... (Ханда) Уау!
Dialogue: 0,0:13:12.62,0:13:16.50,Default,,0,0,0,,Эй... Эй, жақсысың ба? Таманың беті қызыл.
Dialogue: 0,0:13:16.58,0:13:19.92,Default,,0,0,0,,Кешіріңіз, мен жабық адаммын.
Dialogue: 0,0:13:20.00,0:13:22.59,Default,,0,0,0,,Егер сіз жабық адам болсаңыз, тыныш болыңыз.
Dialogue: 0,0:13:22.67,0:13:25.47,Default,,0,0,0,,Әзірге су. Мен су іше аламын ба?
Dialogue: 0,0:13:25.55,0:13:26.88,Default,,0,0,0,,Иә
Dialogue: 0,0:13:26.97,0:13:29.14,Default,,0,0,0,,Ахахаха... (Мива) Анау, анау
Dialogue: 0,0:13:29.22,0:13:31.97,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:13:32.89,0:13:35.77,Default,,0,0,0,,Мен оның не екенін білмеймін, мені көп бақылап жатқандай сезінемін.
Dialogue: 0,0:13:35.85,0:13:37.44,Default,,0,0,0,,Мұғалім... (Ханда) А?
Dialogue: 0,0:13:37.52,0:13:41.94,Default,,0,0,0,,Түнде ұйықтай алмайтындай уайымдаған кезіңіз болды ма?
Dialogue: 0,0:13:42.94,0:13:46.11,Default,,0,0,0,,Не болды? Бұл да проблема ма?
Dialogue: 0,0:13:46.20,0:13:49.03,Default,,0,0,0,,Жоқ, мен бұл алаңдаушылық дер едім...
Dialogue: 0,0:13:50.20,0:13:53.99,Default,,0,0,0,,Шынымды айтсам, Хиро-ни туралы не ойлайсыз?
Dialogue: 0,0:13:54.50,0:13:56.87,Default,,0,0,0,,Хиро? Не, кенеттен?
Dialogue: 0,0:13:57.54,0:13:59.17,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:13:57.54,0:13:59.17,Default,,0,0,0,,Менің ойымды сұрасаң да
Dialogue: 0,0:13:59.17,0:13:59.25,Default,,0,0,0,,Менің ойымды сұрасаң да
Dialogue: 0,0:13:59.25,0:13:59.63,Default,,0,0,0,,Менің ойымды сұрасаң да
Dialogue: 0,0:13:59.25,0:13:59.63,Default,,0,0,0,,Сора!
Dialogue: 0,0:13:59.63,0:13:59.71,Default,,0,0,0,,Сора!
Dialogue: 0,0:13:59.71,0:14:00.75,Default,,0,0,0,,Сора!
Dialogue: 0,0:13:59.71,0:14:00.75,Default,,0,0,0,,Жасымыз жақын және сөйлесуге оңай болғандықтан, сіз інідейсіз бе?
Dialogue: 0,0:14:00.75,0:14:00.84,Default,,0,0,0,,Жасымыз жақын және сөйлесуге оңай болғандықтан, сіз інідейсіз бе?
Dialogue: 0,0:14:00.84,0:14:02.46,Default,,0,0,0,,Жасымыз жақын және сөйлесуге оңай болғандықтан, сіз інідейсіз бе?
Dialogue: 0,0:14:00.84,0:14:02.46,Default,,0,0,0,,Не дедің, жауыз бала! (Киришима & Серо) Қайтып келдік.
Dialogue: 0,0:14:02.46,0:14:03.34,Default,,0,0,0,,Жасымыз жақын және сөйлесуге оңай болғандықтан, сіз інідейсіз бе?
Dialogue: 0,0:14:04.00,0:14:07.01,Default,,0,0,0,,А, жоқ, біз онша жақын емеспіз.
Dialogue: 0,0:14:07.09,0:14:10.05,Default,,0,0,0,,Маған тамақ әкелетін жалғыз адам...
Dialogue: 0,0:14:10.14,0:14:14.01,Default,,0,0,0,,Дәлірек айтсақ, бұл көзілдірік киген қыз неліктен меннен мұны сұрайды?
Dialogue: 0,0:14:15.06,0:14:19.60,Default,,0,0,0,,Ха! Қарасам, бұл жігіт Хироға ұнайды.
Dialogue: 0,0:14:20.19,0:14:23.69,Default,,0,0,0,,Мен көремін. Сол себепті соңғы кездері біртүрлі әрекет жасап жүрсіз бе?
Dialogue: 0,0:14:24.28,0:14:25.53,Default,,0,0,0,,Тіпті иілулерде
Dialogue: 0,0:14:25.61,0:14:28.99,Default,,0,0,0,,Сонда сен мені ақсақал деп ойлап, менімен сөйлесуге келдің бе?
Dialogue: 0,0:14:29.66,0:14:31.82,Default,,0,0,0,,Онда сүйкімді нәрсе бар емес пе?
Dialogue: 0,0:14:31.91,0:14:32.87,Default,,0,0,0,,Мұғалім?
Dialogue: 0,0:14:33.58,0:14:36.25,Default,,0,0,0,,Иә, мен сені қолымнан келгенше қолдаймын.
Dialogue: 0,0:14:37.25,0:14:38.87,Default,,0,0,0,,Хиро жақсы жігіт...
Dialogue: 0,0:14:38.96,0:14:41.63,Default,,0,0,0,,Ол зейінді және тамақ жасай алады.
Dialogue: 0,0:14:41.71,0:14:43.63,Default,,0,0,0,,Менің ойымша, ол сирек кездесетін жақсы жігіт.
Dialogue: 0,0:14:44.71,0:14:46.46,Default,,0,0,0,,Егер мен сондай біреумен кездессем...
Dialogue: 0,0:14:46.55,0:14:47.92,Default,,0,0,0,,Жетеді! (Ханда) Иә?
Dialogue: 0,0:14:48.97,0:14:52.43,Default,,0,0,0,,Менің ұйқысыз күндерімнің себебі кім екенін білесің бе?
Dialogue: 0,0:14:52.51,0:14:53.35,Default,,0,0,0,,Иә!?
Dialogue: 0,0:14:53.43,0:14:56.47,Default,,0,0,0,,Уау! Мен фуджоши емеспін
Dialogue: 0,0:14:56.56,0:14:58.81,Default,,0,0,0,,Иә? Фуджоши? Сіз не айттыңыз?
Dialogue: 0,0:14:58.89,0:15:00.35,Default,,0,0,0,,Сонша жүгіру қауіпті...
Dialogue: 0,0:15:00.44,0:15:02.27,Default,,0,0,0,,Иносукэ… Иносукэ, өзіңді жина! Иносукэ!
Dialogue: 0,0:15:02.35,0:15:04.98,Default,,0,0,0,,Сен… Sei?
Dialogue: 0,0:15:06.03,0:15:07.94,Default,,0,0,0,,Бұл өтірік емес пе?
Dialogue: 0,0:15:08.03,0:15:09.36,Default,,0,0,0,,Джан!
Dialogue: 0,0:15:09.45,0:15:11.86,Default,,0,0,0,,Қараңдаршы, бұл қара қоңыз.
Dialogue: 0,0:15:12.66,0:15:15.12,Default,,0,0,0,,Уау, оны ұстай алмайсың.
Dialogue: 0,0:15:15.20,0:15:18.91,Default,,0,0,0,,Оны өзіңізбен бірге алыңыз, Нарумо. Егер сіз мұны көтере алсаңыз, сіз ересексіз.
Dialogue: 0,0:15:19.00,0:15:19.83,Default,,0,0,0,,Эй!
Dialogue: 0,0:15:20.41,0:15:21.87,Default,,0,0,0,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,0:15:21.96,0:15:23.79,Default,,0,0,0,,О… ересектер…
Dialogue: 0,0:15:23.88,0:15:24.96,Default,,0,0,0,,Уау! (Хина/Нару) Гах!
Dialogue: 0,0:15:25.04,0:15:28.42,Default,,0,0,0,,Уау, Мива, айтасың ба!
Dialogue: 0,0:15:28.51,0:15:30.55,Default,,0,0,0,,Цураппоненникка!
Dialogue: 0,0:15:30.63,0:15:32.84,Default,,0,0,0,,Ахаха кешіріңіз кешіріңіз
Dialogue: 0,0:15:32.93,0:15:36.10,Default,,0,0,0,,Жаман сезінеді, бірақ үйреніп алсаң, жақсы.
Dialogue: 0,0:15:36.64,0:15:39.22,Default,,0,0,0,,Бунибунишичору
Dialogue: 0,0:15:45.36,0:15:46.44,Default,,0,0,0,,үйренген
Dialogue: 0,0:15:46.52,0:15:48.23,Default,,0,0,0,,Иә, егер солай болса, сіз ересек адамсыз.
Dialogue: 0,0:15:48.82,0:15:50.69,Default,,0,0,0,,Хиро-нии, мұғаліміңіз ше?
Dialogue: 0,0:15:50.78,0:15:51.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:51.74,0:15:52.95,Default,,0,0,0,,Сіз қаншалықты нашарсыз?
Dialogue: 0,0:15:52.95,0:15:54.74,Default,,0,0,0,,Сіз қаншалықты нашарсыз?
Dialogue: 0,0:15:52.95,0:15:54.74,Default,,0,0,0,,Мен әлі ес-түссіз жатырмын.
Dialogue: 0,0:15:54.82,0:15:56.62,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:15:57.70,0:15:58.54,Default,,0,0,0,,Бұл болады!
Dialogue: 0,0:15:58.62,0:15:59.45,Default,,0,0,0,,Иә? Сәлем
Dialogue: 0,0:15:59.54,0:16:01.87,Default,,0,0,0,,Қызықтырақ жерге барайық.
Dialogue: 0,0:16:01.96,0:16:04.46,Default,,0,0,0,,Бұл қызықты ма? (Мива) Хехехе, иә.
Dialogue: 0,0:16:04.54,0:16:06.96,Default,,0,0,0,,Тек ересектер баратын орындар
Dialogue: 0,0:16:10.21,0:16:12.59,Default,,0,0,0,,Ха... Ябе
Dialogue: 0,0:16:14.13,0:16:16.47,Default,,0,0,0,,Мен қайтадан есінен танып қалдым.
Dialogue: 0,0:16:17.35,0:16:20.68,Default,,0,0,0,,Хмм... үйге кететін уақыт келді деп ойлаймын.
Dialogue: 0,0:16:21.35,0:16:22.98,Default,,0,0,0,,Мен түскі асты да жеген жоқпын.
Dialogue: 0,0:16:23.06,0:16:24.60,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:16:24.69,0:16:27.48,Default,,0,0,0,,Ей, балалар, көтерілу уақыты келді.
Dialogue: 0,0:16:27.56,0:16:29.94,Default,,0,0,0,,Е~ Бұл уақыт әлдеқашан ба?
Dialogue: 0,0:16:30.03,0:16:31.65,Default,,0,0,0,,Өйткені, бұл өтірік.
Dialogue: 0,0:16:31.74,0:16:34.57,Default,,0,0,0,,А... Эй, Наруха?
Dialogue: 0,0:16:34.66,0:16:37.62,Default,,0,0,0,,Мен осы уақытқа дейін Мива Чанмен бірге болдым, бірақ...
Dialogue: 0,0:16:37.70,0:16:39.37,Default,,0,0,0,,Мына жерде?
Dialogue: 0,0:16:45.54,0:16:46.63,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:46.71,0:16:48.59,Default,,0,0,0,,Келіңіздер! (Ханда) Иә?
Dialogue: 0,0:16:49.55,0:16:51.00,Default,,0,0,0,,Ха... Мива?
Dialogue: 0,0:16:53.17,0:16:55.05,Default,,0,0,0,,Бұл қауіпті, тоқтат!
Dialogue: 0,0:16:56.01,0:16:58.22,Default,,0,0,0,,Пухар, көңілді
Dialogue: 0,0:16:58.30,0:17:01.77,Default,,0,0,0,,Эй, Мива, мұғалім бірдеңе айту керек.
Dialogue: 0,0:17:01.85,0:17:05.39,Default,,0,0,0,,Иә? Шынымен бе? Мен қазірдің өзінде үйге баруым керек пе?
Dialogue: 0,0:17:05.48,0:17:07.86,Default,,0,0,0,,Тағы бір секіру аяқталды.
Dialogue: 0,0:17:07.94,0:17:09.86,Default,,0,0,0,,Иә, бұған дейін...
Dialogue: 0,0:17:09.94,0:17:13.65,Default,,0,0,0,,Сәлем, Нару! кел!
Dialogue: 0,0:17:15.07,0:17:17.20,Default,,0,0,0,,Ха... иә?
Dialogue: 0,0:17:17.28,0:17:21.20,Default,,0,0,0,,Міне! Күтіңіз, күтіңіз, күтіңіз, күтіңіз!
Dialogue: 0,0:17:21.87,0:17:22.91,Default,,0,0,0,,Неге сен?
Dialogue: 0,0:17:23.54,0:17:24.54,Default,,0,0,0,,Тоқта
Dialogue: 0,0:17:25.41,0:17:27.29,Default,,0,0,0,,Бұл болады!
Dialogue: 0,0:17:27.37,0:17:29.25,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:17:37.30,0:17:40.51,Default,,0,0,0,,Пухар Бұл көңілді болды.
Dialogue: 0,0:17:41.01,0:17:44.89,Default,,0,0,0,,Ахаха, жақсы жұмыс істедің. Сондықтан сен менің кішкентай әпкемсің.
Dialogue: 0,0:17:44.98,0:17:47.60,Default,,0,0,0,,Мен секіргенде, мұғалімнің қуанғанын естідім.
Dialogue: 0,0:17:47.69,0:17:49.19,Default,,0,0,0,,«Нару!» cchi
Dialogue: 0,0:17:49.27,0:17:52.07,Default,,0,0,0,,Джекен мүлдем қорқынышты емес еді
Dialogue: 0,0:17:52.15,0:17:53.32,Default,,0,0,0,,Қолдау?
Dialogue: 0,0:17:53.40,0:17:55.57,Default,,0,0,0,,Әй, енді ойлап қарасам, бірдеңе дедім.
Dialogue: 0,0:17:56.61,0:17:57.53,Default,,0,0,0,,Мұғалім?
Dialogue: 0,0:17:57.61,0:18:00.45,Default,,0,0,0,,Әй... Мұғалім!
Dialogue: 0,0:18:03.49,0:18:06.08,Default,,0,0,0,,Қауіпті нәрселер өте көп!
Dialogue: 0,0:18:06.75,0:18:08.71,Default,,0,0,0,,Кешіріңіз, сэр.
Dialogue: 0,0:18:08.79,0:18:12.21,Default,,0,0,0,,Уайымдамаңыз, көңіл-күйіңізді қалпына келтіріңіз.
Dialogue: 0,0:18:12.29,0:18:13.80,Default,,0,0,0,,Нечибаа
Dialogue: 0,0:18:13.88,0:18:15.05,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:18:19.59,0:18:20.80,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:22.55,0:18:23.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:25.10,0:18:26.39,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:28.19,0:18:30.15,Default,,0,0,0,,Мен мұндай нәрсені бірінші рет жасап тұрмын
Dialogue: 0,0:18:30.23,0:18:31.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:32.11,0:18:33.44,Default,,0,0,0,,Мен осы аралға келгенше
Dialogue: 0,0:18:33.52,0:18:37.11,Default,,0,0,0,,Өзімді ғана ойласам жақсы болар еді.
Dialogue: 0,0:18:37.78,0:18:40.61,Default,,0,0,0,,Мен біреу үшін бірінші рет қатты уайымдап отырмын.
Dialogue: 0,0:18:40.70,0:18:41.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:42.20,0:18:44.70,Default,,0,0,0,,Шүкір, мен қазір үйге бара жатырмын.
Dialogue: 0,0:18:47.62,0:18:48.50,Default,,0,0,0,,Мұғалім! (Ханда) Уау!
Dialogue: 0,0:18:48.58,0:18:50.29,Default,,0,0,0,,қатты алданып қалады
Dialogue: 0,0:18:50.37,0:18:53.04,Default,,0,0,0,,Мұғалім, мен де уайымдамаймын.
Dialogue: 0,0:18:53.13,0:18:54.29,Default,,0,0,0,,Онмо
Dialogue: 0,0:18:54.38,0:18:56.26,Default,,0,0,0,,Онмо Онмо
Dialogue: 0,0:18:56.34,0:18:57.34,Default,,0,0,0,,Оны еш күш жұмсамай шашыраңқы етіп көрсету үшін
Dialogue: 0,0:18:57.34,0:18:58.38,Default,,0,0,0,,Оны еш күш жұмсамай шашыраңқы етіп көрсету үшін
Dialogue: 0,0:18:57.34,0:18:58.38,Default,,0,0,0,,（）
Dialogue: 0,0:18:58.38,0:18:58.47,Default,,0,0,0,,（）
Dialogue: 0,0:18:58.47,0:18:59.30,Default,,0,0,0,,（）
Dialogue: 0,0:18:58.47,0:18:59.30,Default,,0,0,0,,Ах
Dialogue: 0,0:18:59.38,0:19:01.80,Default,,0,0,0,,Мұғалім, бұл енді қауіпті емес.
Dialogue: 0,0:19:01.89,0:19:03.14,Default,,0,0,0,,Мен де мұны ешқашан жасамас едім.
Dialogue: 0,0:19:03.22,0:19:07.14,Default,,0,0,0,,Мұғалім Мұғалім Мұғалім...
Dialogue: 0,0:19:07.98,0:19:11.10,Default,,0,0,0,,Бейтаныс адам маған толықтай таныс болды.
Dialogue: 0,0:19:11.19,0:19:14.15,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:19:14.23,0:19:15.40,Default,,0,0,0,,...
Dialogue: 0,0:19:15.48,0:19:17.40,Default,,0,0,0,,Менен мұны талап етпе.
Dialogue: 0,0:19:17.48,0:19:19.07,Default,,0,0,0,,Ха~ Көңіліңіз қалмаңыз!
Dialogue: 0,0:19:36.50,0:19:40.55,Default,,0,0,0,,(Ұялы телефон діріл дыбысы)
Dialogue: 0,0:19:42.59,0:19:45.47,Default,,0,0,0,,Жоқ, телефоным жауап бермейді.
Dialogue: 0,0:19:45.55,0:19:48.31,Default,,0,0,0,,А, мен тағы да шеңберден шықтым.
Dialogue: 0,0:19:48.89,0:19:49.98,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:19:50.77,0:19:52.94,Default,,0,0,0,,Бұл шынымен қолайсыз жер.
Dialogue: 0,0:19:53.02,0:19:54.81,Default,,0,0,0,,Маған ұнады.
Dialogue: 0,0:19:55.44,0:19:58.65,Default,,0,0,0,,Олардың барлығы миниатюраға ұқсайды, кішкентай, кішкентай.
Dialogue: 0,0:19:58.73,0:20:01.36,Default,,0,0,0,,Кусуке, сен мені мазақ етіп тұрсың.
Dialogue: 0,0:20:01.45,0:20:05.99,Default,,0,0,0,,Хехе, бәрі жақсы, кез келген жерде.
Dialogue: 0,0:20:06.07,0:20:08.29,Default,,0,0,0,,Ханда мырзаны кездестірсем
Dialogue: 0,0:20:08.37,0:20:10.20,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:10.29,0:20:13.71,Default,,0,0,0,,(Бәрі бірге ұйықтайды)
Dialogue: 0,0:20:16.00,0:20:20.34,Default,,0,0,0,,♪~
Dialogue: 0,0:21:41.63,0:21:44.92,Default,,0,0,0,,~♪
Dialogue: 0,0:21:46.26,0:21:47.72,Default,,0,0,0,,Мива-чан Мива-чан
Dialogue: 0,0:21:47.80,0:21:48.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:49.05,0:21:51.30,Default,,0,0,0,,Шаш Бұл керемет болады
Dialogue: 0,0:21:51.39,0:21:53.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:53.18,0:21:55.98,Default,,0,0,0,,Бұл жерде ылғалды.
Dialogue: 0,0:21:56.06,0:21:58.35,Default,,0,0,0,,Бұл шаш үйреншікті болғандықтан.
Dialogue: 0,0:22:01.02,0:22:02.69,Default,,0,0,0,,Мен сияқты біреу бар!
Dialogue: 0,0:22:02.77,0:22:05.82,Default,,0,0,0,,А, балалар сендер де балық аулауға келдіңдер ме?
Dialogue: 0,0:22:05.90,0:22:08.32,Default,,0,0,0,,Ұстаз, сізде тамаша бас бар.
Dialogue: 0,0:22:08.41,0:22:11.91,Default,,0,0,0,,Шынымен бе? Өзіңізді жақсы сезінгенде осылай болады.
Dialogue: 0,0:22:11.99,0:22:13.74,Default,,0,0,0,,Жоқ, ол ылғалды.
Dialogue: 0,0:22:13.83,0:22:16.33,Default,,0,0,0,,Екеуінің де шаш түрлері ұқсас.
Dialogue: 0,0:22:16.41,0:22:18.00,Default,,0,0,0,,Шаш үлгісі бірдей
Dialogue: 0,0:22:18.08,0:22:20.08,Default,,0,0,0,,Ұстаз, маған еліктемеңіз.
Dialogue: 0,0:22:20.17,0:22:21.29,Default,,0,0,0,,Ақша...
Dialogue: 0,0:22:21.38,0:22:23.30,Default,,0,0,0,,Шашыңызды қысқартқыңыз келе ме?
Dialogue: 0,0:22:23.38,0:22:25.55,Default,,0,0,0,,Жоқ, бұл сізге сәйкес келеді деп ойлаймын.
Dialogue: 0,0:22:26.34,0:22:28.80,Default,,0,0,0,,О, бүгін көп болды ғой, иә?
Dialogue: 0,0:22:28.88,0:22:31.30,Default,,0,0,0,,Оны директордың орынбасарымен де араластырмаңыз.
Dialogue: 0,0:22:32.76,0:22:35.27,Default,,0,0,0,,Жарайды, бұл мені мазалаған сияқты.
Dialogue: 0,0:22:35.35,0:22:36.73,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:36.81,0:22:37.98,Default,,0,0,0,,Директордың орынбасары сияқты
Dialogue: 0,0:22:38.06,0:22:39.69,Default,,0,0,0,,Менің шашым тік болғаны жақсы.
Dialogue: 0,0:22:39.77,0:22:42.15,Default,,0,0,0,,Қысқа шашқа міндетті түрде рұқсат етілмейді.
Dialogue: 0,0:22:43.07,0:22:43.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:44.61,0:22:46.61,Default,,0,0,0,,Тенгус басы!
Dialogue: 0,0:22:46.69,0:22:47.86,Default,,0,0,0,,Әй?
