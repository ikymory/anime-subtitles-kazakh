Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Адам саудасы
Dialogue: 0,0:00:08.15,0:00:10.25,Default,,0,0,0,,Негізінен әйелдер мен балалар.
Dialogue: 0,0:00:10.53,0:00:13.61,Default,,0,0,0,,Бұл елде тіпті құлдыққа да тыйым салынған.
Dialogue: 0,0:00:14.01,0:00:16.65,Default,,0,0,0,,Бұл олардың жалғыз мақсаты емес.
Dialogue: 0,0:00:16.65,0:00:18.43,Default,,0,0,0,,Жиналған күштермен
Dialogue: 0,0:00:18.43,0:00:23.69,Default,,0,0,0,,Біз көптеген жылдар бойы қарақшылармен бетпе-бет келдік, біз оларды міндетті түрде басып алғымыз келеді.
Dialogue: 0,0:00:23.69,0:00:26.03,Default,,0,0,0,,Оны осы жерден реттейік.
Dialogue: 0,0:00:26.03,0:00:27.65,Default,,0,0,0,,Асықпаңыз
Dialogue: 0,0:00:27.65,0:00:31.99,Default,,0,0,0,,Ава портында Донпачи жасасаңыз, айналадағы тұрғындар да зардап шегеді.
Dialogue: 0,0:00:32.70,0:00:35.27,Default,,0,0,0,,Демек, Кумжидің кемесіне шабуыл жасау
Dialogue: 0,0:00:35.27,0:00:40.49,Default,,0,0,0,,Бұл Кай Тейкоку мен Аваның ортасында сауда орын алатын аймақ
Dialogue: 0,0:00:41.03,0:00:45.07,Default,,0,0,0,,Шешім қашан және қашан қабылданады деген сұрақ туындайды.
Dialogue: 0,0:00:45.07,0:00:49.07,Default,,0,0,0,,Жиналған қыздар қай кемеде?
Dialogue: 0,0:00:49.07,0:00:50.17,Default,,0,0,0,,Иә
Dialogue: 0,0:00:50.17,0:00:55.67,Default,,0,0,0,,Өйткені Кумуджи сатып алу-сату үшін пайдаланатын адамдарды кепілге алады.
Dialogue: 0,0:00:55.67,0:00:57.63,Default,,0,0,0,,Мен бұл туралы ештеңе істей алмаймын
Dialogue: 0,0:00:58.21,0:01:02.39,Default,,0,0,0,,Әйелдердің қауіпсіздігін қамтамасыз етудің қандай да бір жолы бар ма?
Dialogue: 0,0:01:02.79,0:01:05.57,Default,,0,0,0,,Бірақ бұл маңызды транзакция.
Dialogue: 0,0:01:05.57,0:01:08.87,Default,,0,0,0,,Оқиға орнына Кумжидің де келу мүмкіндігі жоғары екенін білдіреді.
Dialogue: 0,0:01:08.87,0:01:12.33,Default,,0,0,0,,Басын тауып, сынап көрсек, тезірек болмай ма?
Dialogue: 0,0:01:12.33,0:01:17.47,Default,,0,0,0,,Әй, бұл жолы мықты одақтасымыз бар ғой.
Dialogue: 0,0:01:20.19,0:01:23.95,Default,,0,0,0,,Маған қосымша ақпарат керек.
Dialogue: 0,0:01:23.95,0:01:27.01,Default,,0,0,0,,Бұл бізге байланысты үзу мүмкіндігі.
Dialogue: 0,0:01:27.51,0:01:30.71,Default,,0,0,0,,Он жылдан астам Ауаның халқына қысым жасадым.
Dialogue: 0,0:01:30.71,0:01:34.65,Default,,0,0,0,,Янкумджи мен қаланы шіріп кеткен шенеуніктерді жеңу үшін қолдан келгеннің бәрін жасаңыз.
Dialogue: 0,0:01:34.65,0:01:36.93,Default,,0,0,0,,Бұл қалаға еркіндік қайтарыңыз
Dialogue: 0,0:01:38.17,0:01:40.71,Default,,0,0,0,,Енді мен де қылышты аламын.
Dialogue: 0,0:01:40.71,0:01:43.77,Default,,0,0,0,,Мені аяғына дейін ілестір, кішкентай бәйбіше.
Dialogue: 0,0:01:46.63,0:01:50.73,Default,,0,0,0,,Капитан Джиган ешкімнің төбелескенін қаламайды.
Dialogue: 0,0:01:51.07,0:01:53.79,Default,,0,0,0,,Мұндай капитанды бәрі түсінеді.
Dialogue: 0,0:01:53.79,0:01:56.31,Default,,0,0,0,,Батылдықпен өмір сүру
Dialogue: 0,0:01:57.15,0:02:00.15,Default,,0,0,0,,Мен бұл адамдар үшін бірдеңе жасағым келеді.
Dialogue: 0,0:02:01.25,0:02:05.73,Default,,0,0,0,,Мен де жігерлі бола түскен нағыз Ава қаласын көргім келеді.
Dialogue: 0,0:03:38.57,0:03:40.92,Default,,0,0,0,,Әй, тезірек!
Dialogue: 0,0:03:41.42,0:03:43.24,Default,,0,0,0,,Алға мұқият қараңыз
Dialogue: 0,0:03:45.29,0:03:47.65,Default,,0,0,0,,Йона-чан, жарайды, жарайды.
Dialogue: 0,0:03:47.65,0:03:50.94,Default,,0,0,0,,Иә, бұл жұмыс маған арналған.
Dialogue: 0,0:03:52.55,0:03:54.57,Default,,0,0,0,,Үлкен аға керемет
Dialogue: 0,0:03:54.57,0:03:56.01,Default,,0,0,0,,Бұл үлкен мәселе емес
Dialogue: 0,0:03:57.77,0:03:59.49,Default,,0,0,0,,Ха Хаку
Dialogue: 0,0:03:59.49,0:04:03.39,Default,,0,0,0,,Ұстаз, маған соғыс өнерін үйретіңізші.
Dialogue: 0,0:04:03.39,0:04:05.01,Default,,0,0,0,,Мен де Мен де
Dialogue: 0,0:04:05.01,0:04:06.78,Default,,0,0,0,,Оқу ақысы 10 000 күміс
Dialogue: 0,0:04:11.13,0:04:12.05,Default,,0,0,0,,Юн
Dialogue: 0,0:04:12.05,0:04:14.49,Default,,0,0,0,,Әй, бұл өлім – шығын.
Dialogue: 0,0:04:14.49,0:04:17.93,Default,,0,0,0,,Неге үндемейсің? Мен сені өлтіремін.
Dialogue: 0,0:04:29.75,0:04:30.81,Default,,0,0,0,,Йона Чан
Dialogue: 0,0:04:32.39,0:04:36.03,Default,,0,0,0,,Мен қаланы барлауға барамын, бірақ мен сенімен бірге келемін.
Dialogue: 0,0:04:45.43,0:04:49.15,Default,,0,0,0,,Керемет, Жасыл Айдаһар ұша алады.
Dialogue: 0,0:04:49.15,0:04:52.31,Default,,0,0,0,,Ұшу, дәлірек айтқанда, секіру?
Dialogue: 0,0:04:52.31,0:04:53.81,Default,,0,0,0,,Қымбат болғаны дұрыс
Dialogue: 0,0:04:54.95,0:04:58.51,Default,,0,0,0,,Мен Кумогакур мүйісінен қатты қорықтым.
Dialogue: 0,0:05:00.75,0:05:01.91,Default,,0,0,0,,Менің жинақтағы ақшамнан тек 285 йен ғана қалды!
Dialogue: 0,0:05:01.91,0:05:05.29,Default,,0,0,0,,Мен Джэ Хаға бұрынғыдан да жақын сезінемін.
Dialogue: 0,0:05:05.87,0:05:07.85,Default,,0,0,0,,Джэ Ханың жағы жеңілдеп қалды.
Dialogue: 0,0:05:09.49,0:05:13.27,Default,,0,0,0,,Бұл өте жиіркенішті, айдаһар қаны.
Dialogue: 0,0:05:24.43,0:05:25.53,Default,,0,0,0,,Жасырын
Dialogue: 0,0:05:27.43,0:05:28.43,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:05:28.43,0:05:30.21,Default,,0,0,0,,Бұл Янкумджи.
Dialogue: 0,0:05:34.09,0:05:35.31,Default,,0,0,0,,Таңертең ерте тұрып-ақ қазірден-ақ қажырлы еңбек етіп жатырсың ғой.
Dialogue: 0,0:05:35.31,0:05:39.87,Default,,0,0,0,,Жоғарыдан қарасаңыз, бұл қаланың бұрмалаушылықтары көзге түседі.
Dialogue: 0,0:05:44.59,0:05:45.99,Default,,0,0,0,,Әйелдер мен балалар
Dialogue: 0,0:05:45.99,0:05:49.71,Default,,0,0,0,,Гюмджи келгенде, ол мені байқамауы үшін мен үйдің ішіне тығыладым.
Dialogue: 0,0:05:59.15,0:06:00.51,Default,,0,0,0,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:06:01.25,0:06:02.89,Default,,0,0,0,,Мен өзімді жақсы сезінбеймін.
Dialogue: 0,0:06:03.67,0:06:05.59,Default,,0,0,0,,бөлек
Dialogue: 0,0:06:08.99,0:06:10.33,Default,,0,0,0,,Сен
Dialogue: 0,0:06:16.29,0:06:18.17,Default,,0,0,0,,Босатыңыз
Dialogue: 0,0:06:24.25,0:06:26.57,Default,,0,0,0,,Мен оны тастадым, жас ханым.
Dialogue: 0,0:06:29.07,0:06:32.27,Default,,0,0,0,,Сіз қайдан білдіңіз?
Dialogue: 0,0:06:32.75,0:06:34.63,Default,,0,0,0,,Айтуға тура келсе, бұл иіс.
Dialogue: 0,0:06:34.63,0:06:36.31,Default,,0,0,0,,Бұзушылық жоқ
Dialogue: 0,0:06:36.99,0:06:39.49,Default,,0,0,0,,Мен түсіндім, бұл бұрмалау.
Dialogue: 0,0:06:40.99,0:06:43.63,Default,,0,0,0,,Шенеуніктерден қашу үшін еркекше киінген
Dialogue: 0,0:06:44.55,0:06:45.75,Default,,0,0,0,,Иә
Dialogue: 0,0:06:45.75,0:06:50.05,Default,,0,0,0,,Сонда да сенің дәл қазір қорқып тұрғаның ерекше болды.
Dialogue: 0,0:06:50.05,0:06:51.21,Default,,0,0,0,,Не болды
Dialogue: 0,0:06:53.27,0:06:56.94,Default,,0,0,0,,Шенеунік, жоқ, Гюмджи маған бірдеңе жасады.
Dialogue: 0,0:06:57.53,0:07:00.20,Default,,0,0,0,,Мен білмеймін. Мен білмеймін.
Dialogue: 0,0:07:01.33,0:07:06.04,Default,,0,0,0,,Бірнеше күн бұрын мен жақсы жұмыс бар деген қауесетті естідім.
Dialogue: 0,0:07:07.55,0:07:11.02,Default,,0,0,0,,Досым екеуміз дүкенге кірдік.
Dialogue: 0,0:07:12.60,0:07:15.27,Default,,0,0,0,,Менің досым өте әдемі қыз еді.
Dialogue: 0,0:07:16.15,0:07:19.40,Default,,0,0,0,,Досым екеумізді ішке кіргізді.
Dialogue: 0,0:07:19.40,0:07:24.22,Default,,0,0,0,,Соңында артқы бөлмеге менің достарым ғана шақырылды.
Dialogue: 0,0:07:25.20,0:07:28.40,Default,,0,0,0,,Маған үйге бара алатынымды айтты.
Dialogue: 0,0:07:29.09,0:07:34.84,Default,,0,0,0,,Мен бір нәрсеге қызығып, ол отырған шағын бөлмеге қарадым.
Dialogue: 0,0:07:39.33,0:07:41.09,Default,,0,0,0,,Бұл бір сәт болды.
Dialogue: 0,0:07:42.24,0:07:45.24,Default,,0,0,0,,Ол бала одан кейін қайтып келмейді.
Dialogue: 0,0:07:45.98,0:07:50.20,Default,,0,0,0,,Мен бұл дүкен Янкумджи мырзаныкі екенін кейін білдім.
Dialogue: 0,0:07:50.20,0:07:53.95,Default,,0,0,0,,Осыдан кейін шенеуніктерден қорықтым.
Dialogue: 0,0:07:53.95,0:07:59.35,Default,,0,0,0,,Бұл адам саудасымен айналысатын лагерьдің кіреберісі екеніне сенімдімін.
Dialogue: 0,0:07:59.35,0:08:01.20,Default,,0,0,0,,Олардың бірнешеуі бар.
Dialogue: 0,0:08:02.13,0:08:03.24,Default,,0,0,0,,Адам...
Dialogue: 0,0:08:03.24,0:08:05.07,Default,,0,0,0,,Жарайды, мен қазір кетейін
Dialogue: 0,0:08:05.07,0:08:10.07,Default,,0,0,0,,Жарайды, досың аман, қайтып келеді.
Dialogue: 0,0:08:10.07,0:08:13.15,Default,,0,0,0,,Жарайды, жарайды, бейшара қатты қорқып кеткен болуы керек.
Dialogue: 0,0:08:13.15,0:08:15.67,Default,,0,0,0,,Көз жасыңды сүрт, мен бірдеңе істеймін.
Dialogue: 0,0:08:15.67,0:08:18.06,Default,,0,0,0,,Оған дейін оны жасырып, үйде бол.
Dialogue: 0,0:08:18.06,0:08:20.69,Default,,0,0,0,,Жоқ, жоқ, шын мәнінде еркекше киіну босқа кетеді.
Dialogue: 0,0:08:20.69,0:08:22.78,Default,,0,0,0,,Ақымақтарды алдаудың жалғыз жолы осы
Dialogue: 0,0:08:22.78,0:08:26.24,Default,,0,0,0,,Ал егер сен маған аман-есен көмектесе алсаң, мені достарыңмен таныстыра аласың ба?
Dialogue: 0,0:08:26.24,0:08:27.53,Default,,0,0,0,,Егер сіз онымен жақсы болсаңыз, келесі жолы ...
Dialogue: 0,0:08:27.52,0:08:30.15,Default,,0,0,0,,Уме, ең жақсысы
Dialogue: 0,0:08:29.98,0:08:31.13,Default,,0,0,0,,1-деңгей—тіпті танк те толықтай қауіпсіз сезілмейді.
Dialogue: 0,0:08:31.13,0:08:34.18,Default,,0,0,0,,Теңіз өнімдеріне толы арнайы қарақшылар шырыны
Dialogue: 0,0:08:34.18,0:08:37.84,Default,,0,0,0,,Мен көптеген ингредиенттерді қолдандым, сондықтан оның дәмді болмауы мүмкін емес.
Dialogue: 0,0:08:37.84,0:08:39.89,Default,,0,0,0,,Бұл дәмді.
Dialogue: 0,0:08:39.89,0:08:42.60,Default,,0,0,0,,Міне, міне, бұл қандай жәндік?
Dialogue: 0,0:08:42.60,0:08:43.88,Default,,0,0,0,,Бұл шаян
Dialogue: 0,0:08:43.88,0:08:45.89,Default,,0,0,0,,Шин-ахтың шәкірті кез келген нәрсені жей алады
Dialogue: 0,0:08:49.82,0:08:52.24,Default,,0,0,0,,Бұл өте дәмді, балам.
Dialogue: 0,0:08:52.24,0:08:53.38,Default,,0,0,0,,Менің әйеліме кел
Dialogue: 0,0:08:54.29,0:08:57.71,Default,,0,0,0,,Амал жоқ, кәдімгі жұмысы жоқ тозған адамсың.
Dialogue: 0,0:08:58.80,0:09:00.53,Default,,0,0,0,,Райджу, тамақ ішетін уақыт келді.
Dialogue: 0,0:09:01.35,0:09:03.42,Default,,0,0,0,,Аспанға не ұшып бара жатырсың?
Dialogue: 0,0:09:05.27,0:09:07.95,Default,,0,0,0,,Айтпақшы, сен менің балымды білмейсің.
Dialogue: 0,0:09:07.95,0:09:12.33,Default,,0,0,0,,Жоқ, бұл жылы, қарақшылық шырын, Юн-кун, сен данышпансың.
Dialogue: 0,0:09:13.27,0:09:14.87,Default,,0,0,0,,Мүмкін Пуккюу
Dialogue: 0,0:09:18.02,0:09:19.15,Default,,0,0,0,,Жүніс
Dialogue: 0,0:09:22.95,0:09:27.07,Default,,0,0,0,,Капитан: Өлім күні ертеңгі түн шығар.
Dialogue: 0,0:09:27.07,0:09:28.24,Default,,0,0,0,,Ертеңгі күн
Dialogue: 0,0:09:29.73,0:09:31.13,Default,,0,0,0,,Негізі
Dialogue: 0,0:09:31.13,0:09:34.95,Default,,0,0,0,,Мен сатып алатын және сататын адамдарды жинайтын дүкен таптым.
Dialogue: 0,0:09:34.95,0:09:39.53,Default,,0,0,0,,Бұл әйелдерге жақсы жұмыс ұсынады.
Dialogue: 0,0:09:39.53,0:09:44.31,Default,,0,0,0,,Әйтсе де, шын мәнінде, қымбатқа сатуы ықтимал әйелдерді бір жерге апаратын жер.
Dialogue: 0,0:09:44.31,0:09:47.82,Default,,0,0,0,,Мен Джинден жұмысқа қанша уақытқа дейін жалдайтындарын сұрадым.
Dialogue: 0,0:09:47.82,0:09:51.33,Default,,0,0,0,,Дүкенші ертеңгі күні түске дейін жұмыс істейтінін айтты.
Dialogue: 0,0:09:52.51,0:09:54.40,Default,,0,0,0,,Кумжи сараң
Dialogue: 0,0:09:54.40,0:09:57.77,Default,,0,0,0,,Жақсы өнім болса, соңғы минутқа дейін күтемін.
Dialogue: 0,0:09:57.77,0:10:00.98,Default,,0,0,0,,Яғни, осы күні мәміле жасалады.
Dialogue: 0,0:10:00.98,0:10:04.27,Default,,0,0,0,,Егер сіз кемені жылжытқыңыз келсе, оны түнде күн батқан кезде жасау керек.
Dialogue: 0,0:10:04.55,0:10:09.75,Default,,0,0,0,,Бірақ әйелдердің қай кемеге мінетінін білмеймін.
Dialogue: 0,0:10:10.89,0:10:12.44,Default,,0,0,0,,Ішінен
Dialogue: 0,0:10:13.95,0:10:18.95,Default,,0,0,0,,Егер сіз отшашу сияқты нәрсені кеменің ішінен ұшырсаңыз, әйелдер мінген.
Dialogue: 0,0:10:18.95,0:10:21.82,Default,,0,0,0,,Мен оны тезірек құтқара аламыз ба деп ойлаймын.
Dialogue: 0,0:10:21.82,0:10:25.95,Default,,0,0,0,,Бұл рас, бірақ оны кім іске қосады?
Dialogue: 0,0:10:27.58,0:10:28.62,Default,,0,0,0,,I
Dialogue: 0,0:10:30.60,0:10:34.78,Default,,0,0,0,,Мен жасырын жүріп, кемеден отшашуды аттаймын.
Dialogue: 0,0:10:37.09,0:10:40.98,Default,,0,0,0,,Мен жасырын жүріп, кемеден отшашуды аттаймын.
Dialogue: 0,0:10:40.98,0:10:42.15,Default,,0,0,0,,Йона Чан
Dialogue: 0,0:10:43.75,0:10:46.89,Default,,0,0,0,,Бұл жолғы мақсат Геумджиді жеңу емес.
Dialogue: 0,0:10:46.89,0:10:50.22,Default,,0,0,0,,Бұл адам саудасының құрбаны болған әйелдерді аман алып қалады.
Dialogue: 0,0:10:50.22,0:10:52.62,Default,,0,0,0,,Өзіңіз отырған кемені жылдам табыңыз
Dialogue: 0,0:10:52.62,0:10:54.93,Default,,0,0,0,,Қауіпсіз жерге эвакуациялаңыз
Dialogue: 0,0:10:54.93,0:10:58.99,Default,,0,0,0,,Сондықтан мен ішке кіріп, кеменің қайда екенін айтайын.
Dialogue: 0,0:10:58.99,0:11:00.18,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:11:00.18,0:11:02.58,Default,,0,0,0,,Мен мұны ұсынбаймын.
Dialogue: 0,0:11:02.58,0:11:04.80,Default,,0,0,0,,Иә, бұл өте қауіпті.
Dialogue: 0,0:11:04.80,0:11:07.89,Default,,0,0,0,,Кумжи мен шенеуніктердің штаб-пәтеріне кіруге қалай батылы барады?
Dialogue: 0,0:11:07.89,0:11:09.29,Default,,0,0,0,,Мен де келіспеймін.
Dialogue: 0,0:11:09.29,0:11:10.53,Default,,0,0,0,,Юн
Dialogue: 0,0:11:10.53,0:11:12.53,Default,,0,0,0,,Отшашуды ату деген нені білдіреді?
Dialogue: 0,0:11:12.53,0:11:18.44,Default,,0,0,0,,Бұл тұтқынға алынған кеменің палубасына мылтық әкелу кезінде сақтықпен жасырын шығуды білдіреді.
Dialogue: 0,0:11:18.44,0:11:21.55,Default,,0,0,0,,Егер табылса, өлтіріледі. Мүлдем мүмкін емес.
Dialogue: 0,0:11:21.55,0:11:24.78,Default,,0,0,0,,Тасымалдауға болатын мылтық ұнтағының шамалы мөлшері
Dialogue: 0,0:11:24.78,0:11:27.00,Default,,0,0,0,,Одақтастарыңызды байқату мүмкін емес.
Dialogue: 0,0:11:27.00,0:11:29.67,Default,,0,0,0,,Біз де шайқаста жүрген шығармыз.
Dialogue: 0,0:11:29.67,0:11:34.91,Default,,0,0,0,,Шин-ах болсаң, алыста болса да менің сигналымды байқайсың.
Dialogue: 0,0:11:36.78,0:11:38.31,Default,,0,0,0,,Сол себепті
Dialogue: 0,0:11:38.31,0:11:42.29,Default,,0,0,0,,Менің әр кеменің ішін қарауға уақытым жоқ.
Dialogue: 0,0:11:42.29,0:11:47.00,Default,,0,0,0,,Әйелдер соғысып жатқанда Кай империясына өтсе, кеш болады.
Dialogue: 0,0:11:47.00,0:11:48.75,Default,,0,0,0,,Бұған жол бермеңіз
Dialogue: 0,0:11:48.75,0:11:54.75,Default,,0,0,0,,Мен әйелдердің ішіне кіріп, олардың қауіпсіздігін қамтамасыз ете аламын деп ойлаймын.
Dialogue: 0,0:11:56.93,0:11:58.11,Default,,0,0,0,,Капитан Джиган
Dialogue: 0,0:11:58.71,0:12:01.40,Default,,0,0,0,,Маған да ұрысуға рұқсат етіңіз.
Dialogue: 0,0:12:03.02,0:12:04.72,Default,,0,0,0,,Мына қыз
Dialogue: 0,0:12:05.42,0:12:09.20,Default,,0,0,0,,Дүниенің шурасын білмей өскен сияқтымын.
Dialogue: 0,0:12:09.20,0:12:12.82,Default,,0,0,0,,Кейде мен майдан даласында жүгірген жауынгерге ұқсаймын.
Dialogue: 0,0:12:13.95,0:12:16.55,Default,,0,0,0,,Ешқашан басымды иемін деп ойламаппын.
Dialogue: 0,0:12:18.60,0:12:23.18,Default,,0,0,0,,Әрине, егер табысқа жетсек, әйелдерге міндетті түрде көмектесе аламыз.
Dialogue: 0,0:12:23.18,0:12:24.64,Default,,0,0,0,,Жарақаттары салыстырмалы түрде жеңіл болған Тодороки…
Dialogue: 0,0:12:24.64,0:12:28.40,Default,,0,0,0,,Дұрыс Жалғыз істеу – абайсыздық.
Dialogue: 0,0:12:28.40,0:12:32.82,Default,,0,0,0,,Операция сәтті болуы үшін кем дегенде тағы бір адамға ену керек.
Dialogue: 0,0:12:32.82,0:12:33.87,Default,,0,0,0,,Мен
Dialogue: 0,0:12:33.87,0:12:35.01,Default,,0,0,0,,I
Dialogue: 0,0:12:35.01,0:12:38.44,Default,,0,0,0,,Айтайын, ол әйел киінгенде де жақсы көрінеді.
Dialogue: 0,0:12:38.44,0:12:39.76,Default,,0,0,0,,Қалай
Dialogue: 0,0:12:40.31,0:12:43.71,Default,,0,0,0,,Өйткені, бұл Кумжи мақтан тұтатын өнім.
Dialogue: 0,0:12:43.71,0:12:48.24,Default,,0,0,0,,Егер сіз басқа әйелдер сияқты әдемі болмасаңыз, сізден бас тартуы мүмкін.
Dialogue: 0,0:12:48.24,0:12:49.31,Default,,0,0,0,,Мен
Dialogue: 0,0:12:49.31,0:12:51.73,Default,,0,0,0,,I
Dialogue: 0,0:12:52.35,0:12:56.42,Default,,0,0,0,,Басқалардың айтқанын тыңдамайсыз ба? Өзіңе сенімді болғандықтан ба?
Dialogue: 0,0:12:56.58,0:12:59.35,Default,,0,0,0,,Тағы бір дөрекі адам бар.
Dialogue: 0,0:12:59.82,0:13:04.60,Default,,0,0,0,,Міне, сол ұсқынсыз еркектердің ішінде мүмкін болатын жалғыз нәрсе...
Dialogue: 0,0:13:06.73,0:13:10.24,Default,,0,0,0,,Сіз ұшқырсыз және мылтықты ұстай аласыз.
Dialogue: 0,0:13:10.24,0:13:12.40,Default,,0,0,0,,Эй, сәл күте тұрыңыз.
Dialogue: 0,0:13:12.40,0:13:15.58,Default,,0,0,0,,Әйел болып киінсең, ол қыздардан жеңілмейтінің рас.
Dialogue: 0,0:13:15.58,0:13:17.33,Default,,0,0,0,,Өйткені ол әдемі бала
Dialogue: 0,0:13:17.33,0:13:19.55,Default,,0,0,0,,Бірақ қарсы жақ – жосықсыз мырза
Dialogue: 0,0:13:19.55,0:13:22.24,Default,,0,0,0,,Мен әлі де Жүністің баруына қарсымын.
Dialogue: 0,0:13:22.24,0:13:25.04,Default,,0,0,0,,Мен қосылсам да сәтті бола ма?
Dialogue: 0,0:13:29.53,0:13:33.51,Default,,0,0,0,,Жарайды, егер сен мылтықпен айналысатын болсаң, менің барудан басқа амалым жоқ.
Dialogue: 0,0:13:33.51,0:13:34.58,Default,,0,0,0,,Юн
Dialogue: 0,0:13:34.58,0:13:38.28,Default,,0,0,0,,Бұл өте қиын. Мен оны ертеңге дейін дайындауым керек.
Dialogue: 0,0:13:40.58,0:13:43.18,Default,,0,0,0,,Жүніс, уайымдама.
Dialogue: 0,0:13:43.18,0:13:46.80,Default,,0,0,0,,Өйткені менде жеңілетін шайқастарға бармау саясаты бар.
Dialogue: 0,0:13:49.02,0:13:50.73,Default,,0,0,0,,Мәмілелер ертеңгі күні орындалады
Dialogue: 0,0:13:50.73,0:13:53.64,Default,,0,0,0,,Инфильтрация операциясы ертең болады.
Dialogue: 0,0:13:53.64,0:13:55.89,Default,,0,0,0,,Балалар, стратегия құрастырайық.
Dialogue: 0,0:14:17.49,0:14:18.64,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:21.18,0:14:22.31,Default,,0,0,0,,Не
Dialogue: 0,0:14:23.00,0:14:25.67,Default,,0,0,0,,Менің тілегімді тыңдағаны үшін
Dialogue: 0,0:14:26.44,0:14:30.53,Default,,0,0,0,,Мен бұл операция үшін қажет деп ойладым.
Dialogue: 0,0:14:30.53,0:14:35.24,Default,,0,0,0,,Тұтқындағы әйелдер қорқыныштан үмітін үзген болуы керек.
Dialogue: 0,0:14:35.24,0:14:37.40,Default,,0,0,0,,Сіз оны қорғайсыз.
Dialogue: 0,0:14:37.64,0:14:38.75,Default,,0,0,0,,Иә
Dialogue: 0,0:14:42.02,0:14:45.67,Default,,0,0,0,,Біз бұл шайқастан жалғыз құтыла алмаймыз.
Dialogue: 0,0:14:45.93,0:14:49.89,Default,,0,0,0,,Мен оларға үнемі дөрекілік танытамын.
Dialogue: 0,0:14:50.24,0:14:55.04,Default,,0,0,0,,Біреуді өлтірмей жазалау оңай емес.
Dialogue: 0,0:14:55.04,0:14:58.11,Default,,0,0,0,,Жарайды, Хаку және басқалары осында.
Dialogue: 0,0:14:59.47,0:15:04.07,Default,,0,0,0,,Сіз де өміріңізді ешқашан босқа өткізбеуіңіз керек.
Dialogue: 0,0:15:09.67,0:15:15.15,Default,,0,0,0,,Мен сені кемеге отырғызсам, менің қызым сияқтысың.
Dialogue: 0,0:15:16.78,0:15:19.27,Default,,0,0,0,,Мен сенің өз бетінше өлуге жол бермеймін.
Dialogue: 0,0:15:25.29,0:15:26.42,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:27.31,0:15:31.98,Default,,0,0,0,,Менің анам туралы онша есімде жоқ.
Dialogue: 0,0:15:35.02,0:15:40.33,Default,,0,0,0,,Бірақ мен сені көргенде, сөздеріңді естігенде,
Dialogue: 0,0:15:40.33,0:15:44.67,Default,,0,0,0,,Сол қаталдық пен мейірімділік көзіме жас келеді.
Dialogue: 0,0:15:46.55,0:15:51.44,Default,,0,0,0,,Ана болу деген осындай ма деп ойлаймын.
Dialogue: 0,0:15:53.02,0:15:58.18,Default,,0,0,0,,Мен сондай сағыныш сезініп, жүрегім қатты ауырады
Dialogue: 0,0:16:30.75,0:16:33.71,Default,,0,0,0,,Оны қалай тоқтатуға болады?
Dialogue: 0,0:16:34.51,0:16:35.62,Default,,0,0,0,,Хаку
Dialogue: 0,0:16:36.84,0:16:41.44,Default,,0,0,0,,Кумжиге бару қаншалықты қауіпті екенін түсінесіз бе?
Dialogue: 0,0:16:43.98,0:16:48.69,Default,,0,0,0,,Неліктен сіз үнемі осындай абайсыз әрекеттер жасайсыз?
Dialogue: 0,0:16:48.69,0:16:50.69,Default,,0,0,0,,Бұл ханшайым
Dialogue: 0,0:16:53.35,0:16:57.80,Default,,0,0,0,,Кейде байланып қалғым келеді
Dialogue: 0,0:16:58.82,0:17:01.87,Default,,0,0,0,,Қайт, Хаку.
Dialogue: 0,0:17:04.27,0:17:05.84,Default,,0,0,0,,Хаку
Dialogue: 0,0:17:05.84,0:17:07.20,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:17:08.00,0:17:12.42,Default,,0,0,0,,Мен Коуканы бейбіт, берекелі ел деп ойладым.
Dialogue: 0,0:17:13.95,0:17:15.73,Default,,0,0,0,,Әкемнің қалауы бойынша
Dialogue: 0,0:17:15.73,0:17:19.78,Default,,0,0,0,,Дау-дамайсыз, күлген ел.
Dialogue: 0,0:17:21.33,0:17:22.71,Default,,0,0,0,,Бірақ
Dialogue: 0,0:17:22.71,0:17:25.91,Default,,0,0,0,,От тайпасының жерлері және Ава порты
Dialogue: 0,0:17:25.91,0:17:28.40,Default,,0,0,0,,Әкемнің тұсынан бері өзгермеген.
Dialogue: 0,0:17:30.04,0:17:32.64,Default,,0,0,0,,Әкем қателесті ме, жоқ па маған бәрібір.
Dialogue: 0,0:17:32.64,0:17:34.93,Default,,0,0,0,,Мен әлі білмеймін
Dialogue: 0,0:17:35.38,0:17:36.58,Default,,0,0,0,,Бірақ
Dialogue: 0,0:17:36.58,0:17:41.42,Default,,0,0,0,,Мен Өрт тайпасының жерін және осы қаланы сол күйге айналдыруға жауаптымын.
Dialogue: 0,0:17:41.42,0:17:43.00,Default,,0,0,0,,Менде де бар
Dialogue: 0,0:17:45.84,0:17:47.78,Default,,0,0,0,,Сіз білмейсіз
Dialogue: 0,0:17:47.78,0:17:50.52,Default,,0,0,0,,Мен сарайда болсам да, білмеймін
Dialogue: 0,0:17:51.09,0:17:55.20,Default,,0,0,0,,Білгім келмеді, білгім келмеді.
Dialogue: 0,0:17:55.20,0:17:57.02,Default,,0,0,0,,Менің жауапкершілігім
Dialogue: 0,0:17:59.04,0:18:01.04,Default,,0,0,0,,Сондықтан мен ұрысамын
Dialogue: 0,0:18:01.67,0:18:03.60,Default,,0,0,0,,Мені жіберіңізші Хаку
Dialogue: 0,0:18:22.09,0:18:23.73,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:24.78,0:18:27.60,Default,,0,0,0,,Мен сенің барғаныңды қаламаймын.
Dialogue: 0,0:18:31.78,0:18:33.24,Default,,0,0,0,,Муша дірілдей ме?
Dialogue: 0,0:18:34.89,0:18:38.04,Default,,0,0,0,,Мен Йона ханшайымды ондай танымаймын.
Dialogue: 0,0:18:39.22,0:18:40.73,Default,,0,0,0,,Мен көбірек білгім келеді
Dialogue: 0,0:18:41.07,0:18:42.44,Default,,0,0,0,,Қосымша
Dialogue: 0,0:18:44.51,0:18:48.60,Default,,0,0,0,,Мен Химе-санның жетістікке жеткенін көргім келеді.
Dialogue: 0,0:18:56.04,0:18:59.67,Default,,0,0,0,,Йона-чан сүйкімді, бірінші әрекеттен өтті
Dialogue: 0,0:18:59.67,0:19:00.71,Default,,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,0:19:00.71,0:19:04.00,Default,,0,0,0,,Тек Гюмджидің ханымы бол.
Dialogue: 0,0:19:04.00,0:19:07.02,Default,,0,0,0,,Әрине, мен заңды әйелімді жеңемін.
Dialogue: 0,0:19:07.02,0:19:08.91,Default,,0,0,0,,Юн Мылтық
Dialogue: 0,0:19:08.91,0:19:10.82,Default,,0,0,0,,Ол obi ішінде сақталады.
Dialogue: 0,0:19:11.29,0:19:13.87,Default,,0,0,0,,Мылтық сымның ұшына байланған.
Dialogue: 0,0:19:13.87,0:19:16.49,Default,,0,0,0,,Кішкентай, бірақ биікте ұшатын арнайы отшашулар
Dialogue: 0,0:19:17.51,0:19:19.78,Default,,0,0,0,,Сонда қалғаны жоспарланғандай.
Dialogue: 0,0:19:19.78,0:19:21.80,Default,,0,0,0,,Иә, кеттік...
Dialogue: 0,0:19:21.80,0:19:24.17,Default,,0,0,0,,Жеңі ұзын киімдер бар ма?
Dialogue: 0,0:19:24.17,0:19:26.88,Default,,0,0,0,,Қолыңды жасыру мүмкін емес, ағайын.
Dialogue: 0,0:19:29.40,0:19:31.82,Default,,0,0,0,,Жоқ, Кижа, бұл қызық.
Dialogue: 0,0:19:31.82,0:19:34.98,Default,,0,0,0,,Бұл қол сәл кішірек болса
Dialogue: 0,0:19:34.98,0:19:36.95,Default,,0,0,0,,Мәселе бұл емес.
Dialogue: 0,0:19:37.98,0:19:38.98,Default,,0,0,0,,Юн
Dialogue: 0,0:19:38.98,0:19:42.73,Default,,0,0,0,,Раджу, мен саған белгі берген бойда маған көмекке келші.
Dialogue: 0,0:19:43.31,0:19:44.38,Default,,0,0,0,,Сендердің міндетің не, көпшілік?
Dialogue: 0,0:19:44.38,0:19:45.60,Default,,0,0,0,,бірдеңе
Dialogue: 0,0:19:48.95,0:19:50.98,Default,,0,0,0,,Мен өзімді аянышты сезінемін.
Dialogue: 0,0:19:50.98,0:19:54.95,Default,,0,0,0,,Жүніс сондай күшті, бірақ мен қалтырап тұрмын.
Dialogue: 0,0:19:56.44,0:19:59.93,Default,,0,0,0,,Бірақ мен жақсымын
Dialogue: 0,0:20:00.42,0:20:05.09,Default,,0,0,0,,Өзгелерден гөрі абайлап өмір сүрген, Басқалардан көріксіз өмір сүрген.
Dialogue: 0,0:20:06.13,0:20:07.87,Default,,0,0,0,,Мен оны мақтан тұтамын.
Dialogue: 0,0:20:09.02,0:20:11.18,Default,,0,0,0,,Найзағай Жарайды.
Dialogue: 0,0:20:11.71,0:20:15.60,Default,,0,0,0,,Барсам, Жүністің өлуіне жол бермеймін.
Dialogue: 0,0:20:18.13,0:20:19.29,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:20:21.55,0:20:23.69,Default,,0,0,0,,Мен осында жұмыс істегім келеді
Dialogue: 0,0:20:23.69,0:20:27.98,Default,,0,0,0,,Дұрыс. Оларға өте жақсы қарайды деп естідім.
Dialogue: 0,0:20:33.80,0:20:36.31,Default,,0,0,0,,Жарайды, қош келдіңіз.
Dialogue: 0,0:20:36.82,0:20:39.82,Default,,0,0,0,,Мен қуаныштымын, көп рахмет.
Dialogue: 0,0:20:39.82,0:20:41.40,Default,,0,0,0,,Артқы жағына өтіңіз.
Dialogue: 0,0:20:44.00,0:20:46.29,Default,,0,0,0,,Бұл жоғары баға.
Dialogue: 0,0:20:47.64,0:20:49.73,Default,,0,0,0,,Осы жерде күтіңіз
Dialogue: 0,0:20:49.73,0:20:52.59,Default,,0,0,0,,Мен дүкеншіні қазір әкелемін.
Dialogue: 0,0:20:54.00,0:20:55.55,Default,,0,0,0,,Міне, осында
Dialogue: 0,0:20:56.09,0:20:57.78,Default,,0,0,0,,Егер сіз мұны ашсаңыз
Dialogue: 0,0:21:09.49,0:21:12.15,Default,,0,0,0,,Біраз күтіңіз.
Dialogue: 0,0:21:17.71,0:21:20.35,Default,,0,0,0,,Менің аяғым дірілдеп тұр
Dialogue: 0,0:21:20.80,0:21:22.15,Default,,0,0,0,,«Кугисаки, одан да жылдам жүгіресің бе?»
Dialogue: 0,0:21:23.58,0:21:24.75,Default,,0,0,0,,Жүніс
Dialogue: 0,0:21:46.27,0:21:49.18,Default,,0,0,0,,Шешуші шайқасқа бір күн қалды
Dialogue: 0,0:21:49.73,0:21:52.91,Default,,0,0,0,,Бұл ұзақ, қараңғы түннің басы еді.
Dialogue: 0,0:23:27.33,0:23:30.84,Default,,0,0,0,,Расында да, менің күшім жоқ.
Dialogue: 0,0:23:30.84,0:23:33.73,Default,,0,0,0,,Бірақ, өтінемін, күресуге рұқсат етіңіз.
Dialogue: 0,0:23:33.73,0:23:35.84,Default,,0,0,0,,Адам ретінде
Dialogue: 0,0:23:36.42,0:23:39.84,Default,,0,0,0,,Келесі жолы «Таңдағы Йона» 21-бөлім
Dialogue: 0,0:23:39.84,0:23:41.15,Default,,0,0,0,,Ұшқындар
Dialogue: 0,0:23:42.65,0:23:47.65,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
