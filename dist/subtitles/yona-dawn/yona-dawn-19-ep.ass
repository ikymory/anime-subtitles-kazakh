Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Бұл Кумогакур мүйісі
Dialogue: 0,0:00:06.86,0:00:08.12,Default,,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,0:00:08.12,0:00:10.60,Default,,0,0,0,,Шығу керек болса, қазір.
Dialogue: 0,0:01:44.98,0:01:46.92,Default,,0,0,0,,Өмірге қауіпті жұмыс
Dialogue: 0,0:01:46.92,0:01:51.08,Default,,0,0,0,,Сен енді пайдасыз жүксің.
Dialogue: 0,0:01:51.08,0:01:54.98,Default,,0,0,0,,Егер сіз әлі де бізбен Кумжимен күрескіңіз келсе?
Dialogue: 0,0:01:54.98,0:01:57.80,Default,,0,0,0,,Мен сізге тиісті шешімді көрсетуіңізді сұраймын.
Dialogue: 0,0:01:57.80,0:01:59.00,Default,,0,0,0,,Дайындық
Dialogue: 0,0:01:59.66,0:02:02.20,Default,,0,0,0,,Жарайды, мен не істеуім керек?
Dialogue: 0,0:02:02.92,0:02:05.42,Default,,0,0,0,,Чижугусаны әкелгенімді қалайсың ба?
Dialogue: 0,0:02:07.76,0:02:09.47,Default,,0,0,0,,Капитан Бұл...
Dialogue: 0,0:02:09.47,0:02:11.36,Default,,0,0,0,,Тіліңізді ұстамаңыз
Dialogue: 0,0:02:11.36,0:02:12.79,Default,,0,0,0,,Сіз мұны істей алмайсыз.
Dialogue: 0,0:02:13.44,0:02:14.90,Default,,0,0,0,,Чижугуса дегеніміз не?
Dialogue: 0,0:02:14.90,0:02:19.08,Default,,0,0,0,,Бұл тек Кумогакуре мүйісінде өсетін бағалы дәрілік шөп.
Dialogue: 0,0:02:19.08,0:02:23.28,Default,,0,0,0,,Аурулар мен жаралардың жазылуын күрт тездететін панацея.
Dialogue: 0,0:02:23.28,0:02:24.52,Default,,0,0,0,,Панацея
Dialogue: 0,0:02:24.52,0:02:29.14,Default,,0,0,0,,Егер сізде Чиджугуса болса, қазір жарақат алған одақтастарыңыз тез қалпына келеді.
Dialogue: 0,0:02:29.14,0:02:32.44,Default,,0,0,0,,Алдағы шайқас үшін өте қажет.
Dialogue: 0,0:02:32.72,0:02:36.26,Default,,0,0,0,,Мен үнемі алып кетуге баратын жігіт жарақат алды.
Dialogue: 0,0:02:36.26,0:02:40.44,Default,,0,0,0,,Оның орнын баса алсаң, мен сені мойындаймын.
Dialogue: 0,0:02:40.98,0:02:41.96,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:02:43.60,0:02:45.60,Default,,0,0,0,,Мен бұл туралы айтуды ұмытып кетіппін
Dialogue: 0,0:02:46.36,0:02:50.08,Default,,0,0,0,,Чижугуса жартастың ортасында өседі.
Dialogue: 0,0:02:50.08,0:02:52.86,Default,,0,0,0,,Мен ешкімнің көмегінсіз жалғыз барамын.
Dialogue: 0,0:02:53.94,0:02:55.42,Default,,0,0,0,,Әу бастан осындай ниет болды.
Dialogue: 0,0:02:55.42,0:02:56.88,Default,,0,0,0,,Жүніс, бұл ақылға қонымсыз.
Dialogue: 0,0:02:56.88,0:02:58.67,Default,,0,0,0,,Юн өтінемін
Dialogue: 0,0:02:59.80,0:03:02.68,Default,,0,0,0,,Өйткені бұл менің жұмысым
Dialogue: 0,0:03:04.36,0:03:06.18,Default,,0,0,0,,Бұл жақсы идея.
Dialogue: 0,0:03:06.40,0:03:08.88,Default,,0,0,0,,Джеха, маған көрсет.
Dialogue: 0,0:03:08.88,0:03:10.68,Default,,0,0,0,,Иә Иә
Dialogue: 0,0:03:10.68,0:03:12.56,Default,,0,0,0,,Ал, мен біраз уақытқа барайын.
Dialogue: 0,0:03:12.84,0:03:14.72,Default,,0,0,0,,Мен бірден қайтамын.
Dialogue: 0,0:03:15.74,0:03:18.58,Default,,0,0,0,,Ол жерде кішкентай тіреуіш болады.
Dialogue: 0,0:03:18.58,0:03:23.22,Default,,0,0,0,,Егер сіз ол жерден төмен түссеңіз, онда сіз сыйып кететіндей үлкен қуыс бар.
Dialogue: 0,0:03:23.90,0:03:26.68,Default,,0,0,0,,Чижугусаны сол жерден алыңыз.
Dialogue: 0,0:03:26.68,0:03:27.87,Default,,0,0,0,,Осымен
Dialogue: 0,0:03:27.87,0:03:29.28,Default,,0,0,0,,Бұл оңай болуы керек
Dialogue: 0,0:03:31.28,0:03:32.96,Default,,0,0,0,,Оңай
Dialogue: 0,0:03:32.96,0:03:35.16,Default,,0,0,0,,Мен жаман болып жатырмын.
Dialogue: 0,0:03:35.86,0:03:39.18,Default,,0,0,0,,Бұл жағдайдан ешкім төтеп бере алмайды.
Dialogue: 0,0:03:39.18,0:03:43.37,Default,,0,0,0,,Бұл жай ғана сынақ болса да, капитан Джиган қорқынышты нәрсе жасады.
Dialogue: 0,0:03:46.06,0:03:47.20,Default,,0,0,0,,Жарайды
Dialogue: 0,0:03:55.04,0:03:56.46,Default,,0,0,0,,Жарайды
Dialogue: 0,0:03:56.78,0:04:01.74,Default,,0,0,0,,Капитан Джиган маған кішкентай өлшеміме сай жұмыс берді.
Dialogue: 0,0:04:08.36,0:04:11.10,Default,,0,0,0,,Мен қызым Аняны
Dialogue: 0,0:04:11.10,0:04:13.72,Default,,0,0,0,,Маған ұнамайды. Мен мұнда болғым келмейді.
Dialogue: 0,0:04:13.72,0:04:14.70,Default,,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,0:04:14.70,0:04:16.30,Default,,0,0,0,,Қарғыс атқан ұрық метаморфозға ұшыраған жағдайда—
Dialogue: 0,0:04:17.82,0:04:19.20,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:04:19.20,0:04:20.88,Default,,0,0,0,,Бұл жел көп емес.
Dialogue: 0,0:04:24.52,0:04:26.44,Default,,0,0,0,,деді менің предшественник
Dialogue: 0,0:04:26.80,0:04:31.62,Default,,0,0,0,,Төрт айдаһар үшін Хирюу - олардың қанында жазылған абсолютті монарх.
Dialogue: 0,0:04:32.44,0:04:35.24,Default,,0,0,0,,Қандай адам келеді екен деп ойладым.
Dialogue: 0,0:04:35.24,0:04:40.40,Default,,0,0,0,,Ол төрт айдаһарды үлкен күшпен басқаратын тәкаппар бейбақ болса керек.
Dialogue: 0,0:04:41.69,0:04:43.12,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:04:43.12,0:04:49.46,Default,,0,0,0,,Мұндағы адам ерекше күші жоқ әлсіз қыз.
Dialogue: 0,0:04:50.74,0:04:55.96,Default,,0,0,0,,Сол кезде қаным мені төрт айдаһар билеуші ​​деп таныды.
Dialogue: 0,0:04:55.96,0:04:57.40,Default,,0,0,0,,Бірақ
Dialogue: 0,0:04:57.42,0:05:01.46,Default,,0,0,0,,Алдымдағы әлсіз, қалтырап тұрған қыз
Dialogue: 0,0:05:01.46,0:05:03.26,Default,,0,0,0,,Бұл адам ба?
Dialogue: 0,0:05:03.78,0:05:07.50,Default,,0,0,0,,Ол шынымен төрт айдаһардың иесі ме?
Dialogue: 0,0:05:08.38,0:05:11.44,Default,,0,0,0,,Йона-чан, шектен шықпа.
Dialogue: 0,0:05:11.44,0:05:13.60,Default,,0,0,0,,Қорықсаң, қайт.
Dialogue: 0,0:05:13.60,0:05:16.36,Default,,0,0,0,,Капитан берген тапсырма мүмкін емес.
Dialogue: 0,0:05:16.36,0:05:21.22,Default,,0,0,0,,Сондықтан сіз бізбен Кумжимен күресе алмайсыз.
Dialogue: 0,0:05:21.98,0:05:25.02,Default,,0,0,0,,Себебі сені ешкім бұған мәжбүрлемейді.
Dialogue: 0,0:05:25.02,0:05:28.22,Default,,0,0,0,,Қауіпке өзіңіз секірудің қажеті жоқ.
Dialogue: 0,0:05:28.22,0:05:30.72,Default,,0,0,0,,Иә, кері қайтыңыз.
Dialogue: 0,0:05:30.72,0:05:33.14,Default,,0,0,0,,Өйткені сен қызсың
Dialogue: 0,0:05:33.14,0:05:34.56,Default,,0,0,0,,Артыңа шегін!
Dialogue: 0,0:05:40.59,0:05:41.76,Default,,0,0,0,,Жүніс
Dialogue: 0,0:05:42.18,0:05:44.20,Default,,0,0,0,,Қайту мүмкін емес...
Dialogue: 0,0:05:44.96,0:05:45.93,Default,,0,0,0,,Жарайды
Dialogue: 0,0:05:45.93,0:05:47.64,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:47.64,0:05:49.83,Default,,0,0,0,,Осындай қарапайым жұмыс
Dialogue: 0,0:05:49.83,0:05:51.24,Default,,0,0,0,,Не оңай?
Dialogue: 0,0:05:51.24,0:05:55.16,Default,,0,0,0,,Әрине, капитан Джиган мұны істей алуы керек.
Dialogue: 0,0:05:55.16,0:05:59.19,Default,,0,0,0,,Тіпті Хаку мен басқаларының да сәйкес келетін беттері жоқ.
Dialogue: 0,0:06:03.12,0:06:05.22,Default,,0,0,0,,Рахмет сізге Ао
Dialogue: 0,0:06:06.14,0:06:07.16,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе
Dialogue: 0,0:06:08.90,0:06:13.86,Default,,0,0,0,,Мен қалтырап тұрмын, бірақ бұл жылауымды тоқтаттым немесе көз жасым тоқтады дегенді білдірмейді.
Dialogue: 0,0:06:13.86,0:06:15.84,Default,,0,0,0,,Қалай жалғастыру керек
Dialogue: 0,0:06:16.16,0:06:19.32,Default,,0,0,0,,Сендей қауқарсыз қыз
Dialogue: 0,0:06:24.40,0:06:25.46,Default,,0,0,0,,Йона Чан
Dialogue: 0,0:06:26.18,0:06:29.34,Default,,0,0,0,,Медициналық мақсатта жақсы.
Dialogue: 0,0:06:29.34,0:06:30.64,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:06:31.42,0:06:32.56,Default,,0,0,0,,(Балалардың шуы)
Dialogue: 0,0:06:33.02,0:06:38.98,Default,,0,0,0,,Енді Хаку, Юн, Киджа және Шин-ах ауыр жарақат алды делік.
Dialogue: 0,0:06:39.22,0:06:42.28,Default,,0,0,0,,Чижугусаның емделуі мүмкін болса.
Dialogue: 0,0:06:42.28,0:06:44.82,Default,,0,0,0,,Ештеңеге қарамай барып аламын.
Dialogue: 0,0:06:46.10,0:06:50.54,Default,,0,0,0,,Жебелер түсіп жатқан ұрыс даласының ортасында өссе де, мен оны аламын.
Dialogue: 0,0:06:52.34,0:06:55.36,Default,,0,0,0,,Егер сіз солай ойласаңыз, кез келген жерге бара аласыз
Dialogue: 0,0:06:58.32,0:06:59.90,Default,,0,0,0,,Менің аяғым дірілдеп тұр
Dialogue: 0,0:07:02.08,0:07:04.44,Default,,0,0,0,,Кімді жоғалтып алудан қорқасың?
Dialogue: 0,0:07:05.36,0:07:06.42,Default,,0,0,0,,Қорқынышты
Dialogue: 0,0:07:07.25,0:07:09.00,Default,,0,0,0,,Бұл ең қорқыныштысы
Dialogue: 0,0:07:09.94,0:07:12.42,Default,,0,0,0,,Біреуден айырылып жылап жатқанын көру
Dialogue: 0,0:07:14.32,0:07:17.34,Default,,0,0,0,,Біреуді жоғалтқысы келмеу сезімі
Dialogue: 0,0:07:17.34,0:07:20.50,Default,,0,0,0,,Аяқ дірілдеп алға жылжисыз ба?
Dialogue: 0,0:07:20.94,0:07:24.54,Default,,0,0,0,,Енді Кумуджиден қорқатын Ава халқы үшін.
Dialogue: 0,0:07:26.10,0:07:28.66,Default,,0,0,0,,Басқа ақымақ сияқты
Dialogue: 0,0:07:29.00,0:07:33.82,Default,,0,0,0,,Жоқ, ақымақ болғаны жақсы, бір күш болса болды.
Dialogue: 0,0:07:35.34,0:07:36.64,Default,,0,0,0,,Мен оны көрмеймін
Dialogue: 0,0:07:41.12,0:07:42.42,Default,,0,0,0,,Иеха
Dialogue: 0,0:07:42.88,0:07:44.30,Default,,0,0,0,,Менің артымнан келесің бе?
Dialogue: 0,0:07:46.56,0:07:50.28,Default,,0,0,0,,Жарайды, мен жарты жолға дейін күзетемін.
Dialogue: 0,0:07:51.04,0:07:52.12,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:54.20,0:07:57.16,Default,,0,0,0,,Мен саған айтамын, мен саған көмектеспеймін.
Dialogue: 0,0:07:58.06,0:08:02.70,Default,,0,0,0,,Иә, бірақ сіздің дауысыңыз жақын болғанда мен өзімді қауіпсіз сезінемін.
Dialogue: 0,0:08:02.70,0:08:04.70,Default,,0,0,0,,Тек сонда болу арқылы
Dialogue: 0,0:08:05.50,0:08:06.76,Default,,0,0,0,,Неге деп ойлаймын
Dialogue: 0,0:08:08.18,0:08:09.60,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:08:10.16,0:08:11.98,Default,,0,0,0,,Мен мұны естігім келеді
Dialogue: 0,0:08:12.88,0:08:23.52,Default,,0,0,0,,Мен сені алғаш көргендегіден гөрі сенің дауысыңды естіп, фигураңды сезінсем ғой.
Dialogue: 0,0:08:23.54,0:08:28.30,Default,,0,0,0,,Төрт айдаһардың қаны менің денеммен ағып жатқандықтан болса керек.
Dialogue: 0,0:08:28.30,0:08:30.22,Default,,0,0,0,,Солай болуы керек.
Dialogue: 0,0:08:30.74,0:08:33.16,Default,,0,0,0,,Тағы не бар?
Dialogue: 0,0:08:36.54,0:08:39.84,Default,,0,0,0,,Төрт айдаһардың қаны қаншалықты қиын?
Dialogue: 0,0:08:42.74,0:08:45.38,Default,,0,0,0,,Міне, мен үшін бәрі осы.
Dialogue: 0,0:08:45.86,0:08:48.30,Default,,0,0,0,,Алдағы жол мен үшін өте тар.
Dialogue: 0,0:08:48.30,0:08:49.96,Default,,0,0,0,,Сіз жалғыз барасыз
Dialogue: 0,0:08:56.96,0:09:00.06,Default,,0,0,0,,Мен әрқашан күшті болғым келді
Dialogue: 0,0:09:00.96,0:09:03.10,Default,,0,0,0,,Алдымен өзіңді қорға
Dialogue: 0,0:09:03.60,0:09:07.81,Default,,0,0,0,,Келесі қадам мен үшін бәрін тастаған Хакуды қорғау.
Dialogue: 0,0:09:08.94,0:09:14.34,Default,,0,0,0,,Және мені тірі қалдырған достарымды марапаттау үшін.
Dialogue: 0,0:09:20.58,0:09:23.56,Default,,0,0,0,,Аяқ, қозғал!
Dialogue: 0,0:09:24.14,0:09:27.29,Default,,0,0,0,,Бірте-бірте, бірте-бірте
Dialogue: 0,0:09:28.14,0:09:30.06,Default,,0,0,0,,Осы қорқынышты жеңсеңіз
Dialogue: 0,0:09:30.06,0:09:31.42,Default,,0,0,0,,Қалтамды ұстап көруге қалай батылың жетті—
Dialogue: 0,0:09:31.90,0:09:35.60,Default,,0,0,0,,Өйткені мен өзім қалаған күшке жақындай алатынымды сезінемін
Dialogue: 0,0:09:44.64,0:09:46.94,Default,,0,0,0,,Бұл Чижугуса
Dialogue: 0,0:09:54.74,0:09:56.06,Default,,0,0,0,,Жақсы
Dialogue: 0,0:09:57.48,0:10:00.28,Default,,0,0,0,,Оған да қолым жетті.
Dialogue: 0,0:10:03.86,0:10:05.82,Default,,0,0,0,,Не болды, капитан?
Dialogue: 0,0:10:05.82,0:10:07.60,Default,,0,0,0,,Қиын болып барады.
Dialogue: 0,0:10:07.60,0:10:09.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:09.62,0:10:13.46,Default,,0,0,0,,Осы қарқынмен, асықпасақ, әлгі қызға бәле түседі.
Dialogue: 0,0:10:15.34,0:10:16.44,Default,,0,0,0,,Раиджу
Dialogue: 0,0:10:16.84,0:10:17.88,Default,,0,0,0,,Не
Dialogue: 0,0:10:19.38,0:10:20.57,Default,,0,0,0,,Маған жол көрсетіңізші.
Dialogue: 0,0:10:22.60,0:10:24.68,Default,,0,0,0,,Йона Чан, бәрібір.
Dialogue: 0,0:10:26.78,0:10:27.64,Default,,0,0,0,,Жүніс
Dialogue: 0,0:10:27.64,0:10:28.56,Default,,0,0,0,,Артыңа шегін!
Dialogue: 0,0:10:36.04,0:10:37.24,Default,,0,0,0,,Йона Чан
Dialogue: 0,0:10:40.66,0:10:41.72,Default,,0,0,0,,Жүніс
Dialogue: 0,0:10:46.34,0:10:47.32,Default,,0,0,0,,Жүніс
Dialogue: 0,0:10:50.36,0:10:54.70,Default,,0,0,0,,Мен қалай жақын болып, көмектесе алмаймын?
Dialogue: 0,0:10:55.36,0:10:58.96,Default,,0,0,0,,Сондай әлсіз қыз
Dialogue: 0,0:11:01.62,0:11:02.74,Default,,0,0,0,,Иеха
Dialogue: 0,0:11:04.74,0:11:05.90,Default,,0,0,0,,Йона Чан
Dialogue: 0,0:11:08.12,0:11:10.46,Default,,0,0,0,,Амансың ба? Мен саған қазір көмектесемін.
Dialogue: 0,0:11:10.47,0:11:11.30,Default,,0,0,0,,No
Dialogue: 0,0:11:11.92,0:11:14.02,Default,,0,0,0,,Осы жерде қол ұшын созсам
Dialogue: 0,0:11:14.50,0:11:18.22,Default,,0,0,0,,Капитан Джиганмен уәде
Dialogue: 0,0:11:18.22,0:11:20.34,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:11:35.08,0:11:36.10,Default,,0,0,0,,Иеха
Dialogue: 0,0:11:36.76,0:11:40.36,Default,,0,0,0,,Сіз керемет баласыз.
Dialogue: 0,0:11:40.94,0:11:44.22,Default,,0,0,0,,Сіз мені қатты қобалжытып отырсыз.
Dialogue: 0,0:11:44.52,0:11:47.94,Default,,0,0,0,,Соңында мен құтқарылдым.
Dialogue: 0,0:11:48.26,0:11:50.48,Default,,0,0,0,,Сіз оны назардан тыс қалдырмайсыз деп үміттенемін.
Dialogue: 0,0:11:51.06,0:11:57.58,Default,,0,0,0,,Бастапқыда мен әйелдерге мақтаға оранғандай қарау керек деген пікірде болдым.
Dialogue: 0,0:12:01.44,0:12:04.80,Default,,0,0,0,,Неге күлесің? Ауа райы жоқ
Dialogue: 0,0:12:04.80,0:12:08.40,Default,,0,0,0,,Сен мені құтқарамын деп тіпті мына теңізге секірдің.
Dialogue: 0,0:12:08.40,0:12:09.56,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:11.24,0:12:13.00,Default,,0,0,0,,Капитанға айтпа
Dialogue: 0,0:12:13.78,0:12:14.78,Default,,0,0,0,,Бірақ
Dialogue: 0,0:12:14.78,0:12:15.70,Default,,0,0,0,,Уф… Таңертеңгісін-ақ шаршап біттім.
Dialogue: 0,0:12:16.84,0:12:21.30,Default,,0,0,0,,Сіз бұл Чижугусаны өз күш-жігеріңізбен алып, қорғадыңыз.
Dialogue: 0,0:12:21.68,0:12:24.84,Default,,0,0,0,,Сонымен капитанға берген уәде орындалды.
Dialogue: 0,0:12:25.84,0:12:28.48,Default,,0,0,0,,Менің жаңа істегенім бонус болды
Dialogue: 0,0:12:28.48,0:12:30.84,Default,,0,0,0,,Капитанға айтудың қажеті жоқ
Dialogue: 0,0:12:33.62,0:12:36.10,Default,,0,0,0,,Мен әлі ештеңеге қол жеткізген жоқпын.
Dialogue: 0,0:12:36.96,0:12:40.44,Default,,0,0,0,,Мен мұны өзіммен бірге алып, бәріне оралуым керек.
Dialogue: 0,0:12:45.36,0:12:49.52,Default,,0,0,0,,Ей, Чиджугуса осындай жерде өседі.
Dialogue: 0,0:12:49.55,0:12:52.08,Default,,0,0,0,,Мен саған бұл жартас екенін айттым.
Dialogue: 0,0:12:52.09,0:12:53.52,Default,,0,0,0,,Тым тік, солай емес пе?
Dialogue: 0,0:12:53.52,0:12:54.64,Default,,0,0,0,,Бұл ақылға қонымсыз.
Dialogue: 0,0:12:54.64,0:12:55.80,Default,,0,0,0,,Теңіз толқынды
Dialogue: 0,0:12:55.80,0:12:58.18,Default,,0,0,0,,Жүністі жел ұшырып жібереді.
Dialogue: 0,0:12:58.18,0:13:00.10,Default,,0,0,0,,Мен түсіп, саған көмектесемін.
Dialogue: 0,0:13:00.10,0:13:01.26,Default,,0,0,0,,Күтіңіз
Dialogue: 0,0:13:02.10,0:13:07.10,Default,,0,0,0,,Әлгі қыз менің сенімімді алу үшін бұл жұмысқа орналасты.
Dialogue: 0,0:13:07.32,0:13:10.42,Default,,0,0,0,,Балалар, осы шешімді таптағыларың келе ме?
Dialogue: 0,0:13:10.42,0:13:12.46,Default,,0,0,0,,Бірақ ше
Dialogue: 0,0:13:12.46,0:13:14.72,Default,,0,0,0,,Жүніс қыз.
Dialogue: 0,0:13:14.72,0:13:18.30,Default,,0,0,0,,Тіпті әйелдерге де кейде төбелесуге тура келеді.
Dialogue: 0,0:13:18.54,0:13:19.88,Default,,0,0,0,,Мені жалама
Dialogue: 0,0:13:21.12,0:13:23.78,Default,,0,0,0,,Хаку, жақсысың ба?
Dialogue: 0,0:13:23.88,0:13:25.10,Default,,0,0,0,,Хаку
Dialogue: 0,0:13:26.68,0:13:27.84,Default,,0,0,0,,Жүніс
Dialogue: 0,0:13:39.28,0:13:41.16,Default,,0,0,0,,Жүніс
Dialogue: 0,0:13:42.46,0:13:44.56,Default,,0,0,0,,Қазірдің өзінде ақымақ ақымақ
Dialogue: 0,0:13:44.56,0:13:46.00,Default,,0,0,0,,Бос сөзге толы
Dialogue: 0,0:13:46.00,0:13:47.42,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:47.62,0:13:49.10,Default,,0,0,0,,Чижугуса
Dialogue: 0,0:13:50.38,0:13:51.38,Default,,0,0,0,,Мұнда
Dialogue: 0,0:13:54.00,0:13:55.10,Default,,0,0,0,,Әрине
Dialogue: 0,0:13:55.58,0:13:57.79,Default,,0,0,0,,Жарайды, мен сені уәде еткендей аламын.
Dialogue: 0,0:13:57.79,0:13:58.72,Default,,0,0,0,,Жоқ
Dialogue: 0,0:13:59.56,0:14:02.83,Default,,0,0,0,,Мен Джехадан көмек алдым.
Dialogue: 0,0:14:04.10,0:14:09.36,Default,,0,0,0,,Мені кенеттен шыққан үлкен толқын теңізге лақтырып жібере жаздады, бірақ мені біреу құтқарды.
Dialogue: 0,0:14:10.16,0:14:12.97,Default,,0,0,0,,Мен мұны өз бетімше жасай алмадым.
Dialogue: 0,0:14:13.52,0:14:16.28,Default,,0,0,0,,Содан кейін бас тартыңыз.
Dialogue: 0,0:14:16.80,0:14:17.76,Default,,0,0,0,,Жоқ
Dialogue: 0,0:14:18.80,0:14:21.60,Default,,0,0,0,,Мен қайтадан өзім барып аламын.
Dialogue: 0,0:14:29.22,0:14:33.20,Default,,0,0,0,,Теңізге лақтырылып өлген әйелге еліктесем ше?
Dialogue: 0,0:14:33.21,0:14:36.44,Default,,0,0,0,,Джеханы теңізге құлатқан мен едім.
Dialogue: 0,0:14:39.06,0:14:40.70,Default,,0,0,0,,Көздерің ашық қызыл.
Dialogue: 0,0:14:40.70,0:14:42.46,Default,,0,0,0,,Сіз көп жыласаңыз керек
Dialogue: 0,0:14:42.46,0:14:44.64,Default,,0,0,0,,Менің көзіме тұзды су келді.
Dialogue: 0,0:14:46.26,0:14:47.88,Default,,0,0,0,,Қолдар тыртықтармен жабылған
Dialogue: 0,0:14:47.88,0:14:49.59,Default,,0,0,0,,Аяқтар дірілдейді
Dialogue: 0,0:14:50.24,0:14:52.36,Default,,0,0,0,,Сізде батыл бар, солай емес пе?
Dialogue: 0,0:14:52.62,0:14:57.93,Default,,0,0,0,,Сіз көргіңіз келетін адам қиын жағдайда болса да достарына ешқашан опасыздық жасамайды.
Dialogue: 0,0:14:59.12,0:15:01.54,Default,,0,0,0,,Мен ондай ақымақтарды жек көрмеймін.
Dialogue: 0,0:15:02.06,0:15:03.52,Default,,0,0,0,,Қайыққа мініңіз
Dialogue: 0,0:15:05.18,0:15:07.90,Default,,0,0,0,,Емтиханнан өттің, Йона Чан.
Dialogue: 0,0:15:10.82,0:15:13.33,Default,,0,0,0,,жасадыңыз
Dialogue: 0,0:15:13.33,0:15:15.00,Default,,0,0,0,,Саған жақсы, Йона-чан
Dialogue: 0,0:15:14.54,0:15:15.70,Default,,0,0,0,,Мен барынша тырыстым
Dialogue: 0,0:15:15.40,0:15:18.57,Default,,0,0,0,,Неше Йона Чан? Қараңдар, оған кір қолдарыңды тигізбеңдер.
Dialogue: 0,0:15:21.46,0:15:25.64,Default,,0,0,0,,Сол қыз араласқанда сенің түрің осындай.
Dialogue: 0,0:15:25.64,0:15:29.80,Default,,0,0,0,,Сіз шамамен он жас үлкен сияқтысыз.
Dialogue: 0,0:15:30.60,0:15:33.04,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:15:33.82,0:15:39.60,Default,,0,0,0,,Мен өмірімді қысқартады деп ойладым, өйткені ол қатты үмітсіз болды, ол айтқанынан қайтпады.
Dialogue: 0,0:15:39.84,0:15:41.86,Default,,0,0,0,,Мен оған көп күш салдым.
Dialogue: 0,0:15:41.86,0:15:45.40,Default,,0,0,0,,Мен әрқашан қыздармен араласамын
Dialogue: 0,0:15:46.10,0:15:49.28,Default,,0,0,0,,Бірақ мен мұндай баланы бұрын-соңды көрген емеспін.
Dialogue: 0,0:15:49.86,0:15:54.10,Default,,0,0,0,,Таза және қыңыр, бірақ аяғында тұрақсыз
Dialogue: 0,0:15:54.10,0:15:57.40,Default,,0,0,0,,Бұл мен үшін өте қиын және қиын.
Dialogue: 0,0:15:58.86,0:16:01.40,Default,,0,0,0,,Мен сенің кімді алып бара жатқаныңды білмеймін.
Dialogue: 0,0:16:02.90,0:16:04.12,Default,,0,0,0,,Иә, бір жағынан солай.
Dialogue: 0,0:16:04.36,0:16:06.76,Default,,0,0,0,,Бұл өте маңызды.
Dialogue: 0,0:16:06.76,0:16:08.88,Default,,0,0,0,,Біз бала кезден доспыз.
Dialogue: 0,0:16:09.02,0:16:10.30,Default,,0,0,0,,Ғашық
Dialogue: 0,0:16:10.30,0:16:11.46,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:16:12.20,0:16:15.66,Default,,0,0,0,,Бұл маңызды нәрсені сақтау керек
Dialogue: 0,0:16:15.88,0:16:17.76,Default,,0,0,0,,Бұл сақтау керек нәрсе.
Dialogue: 0,0:16:17.76,0:16:18.92,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:18.92,0:16:24.98,Default,,0,0,0,,Әйтеуір, сіз екеуің жақын сияқтысыңдар, бірақ мен онымен араларыңда алшақтық бар сияқты сезінемін.
Dialogue: 0,0:16:26.22,0:16:31.20,Default,,0,0,0,,Бұл оны шынымен қаламайтыныңызды білдіре ме?
Dialogue: 0,0:16:32.02,0:16:34.04,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:16:34.04,0:16:35.76,Default,,0,0,0,,Неліктен бұлай?
Dialogue: 0,0:16:35.76,0:16:37.82,Default,,0,0,0,,Неге деп ойлаймын
Dialogue: 0,0:16:38.52,0:16:41.06,Default,,0,0,0,,Мүмкін мен оған қызығатындықтан шығар.
Dialogue: 0,0:16:42.78,0:16:44.21,Default,,0,0,0,,Ах.
Dialogue: 0,0:16:46.14,0:16:48.82,Default,,0,0,0,,Хакудың қазір жүзі қызық болды
Dialogue: 0,0:16:48.82,0:16:50.92,Default,,0,0,0,,Мен аздап шаршадым.
Dialogue: 0,0:16:59.84,0:17:03.40,Default,,0,0,0,,Мүмкін қызды қаламағанымнан шығар.
Dialogue: 0,0:17:04.22,0:17:06.34,Default,,0,0,0,,Сіз мұны білесіз бе?
Dialogue: 0,0:17:08.02,0:17:12.74,Default,,0,0,0,,Әрқашан, әрқашан жанымда, Көргім келеді аға-әпке.
Dialogue: 0,0:17:12.94,0:17:16.06,Default,,0,0,0,,Өзі мен ханшайым басқарған елді қорғауға тырысу.
Dialogue: 0,0:17:17.14,0:17:19.84,Default,,0,0,0,,Мен күн сайын дәл осылай істеуге ант етіп өмір сүрдім.
Dialogue: 0,0:17:21.54,0:17:25.56,Default,,0,0,0,,Енді қалай болса да аман қалуға тырысып жатқан ханшайымға.
Dialogue: 0,0:17:26.00,0:17:30.06,Default,,0,0,0,,Мәртебелі Ирудың маңызды аманаты ханшайымға.
Dialogue: 0,0:17:31.12,0:17:33.70,Default,,0,0,0,,Тағы не қалайсыз?
Dialogue: 0,0:17:36.02,0:17:37.64,Default,,0,0,0,,Неге жылайсың?
Dialogue: 0,0:17:37.64,0:17:39.74,Default,,0,0,0,,Бұл ештеңе емес.
Dialogue: 0,0:17:43.24,0:17:45.70,Default,,0,0,0,,Ауырады, ауырады, ауырады
Dialogue: 0,0:17:45.70,0:17:47.32,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:47.32,0:17:51.76,Default,,0,0,0,,Чиджу Арамшөптерге барғанда, мен көп ағаш тікенектеріне жабысып қалдым.
Dialogue: 0,0:17:51.76,0:17:54.28,Default,,0,0,0,,Оны инемен алуға болады деп естідім.
Dialogue: 0,0:17:54.28,0:17:57.07,Default,,0,0,0,,Сонда сен оны инемен ойып жібердің бе?
Dialogue: 0,0:17:57.07,0:18:00.32,Default,,0,0,0,,Қатты ауырады, бірақ мен оны түсіре алмаймын.
Dialogue: 0,0:18:00.32,0:18:02.30,Default,,0,0,0,,Ине қуырылған ба?
Dialogue: 0,0:18:03.20,0:18:04.36,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:04.36,0:18:05.72,Default,,0,0,0,,Өте үлкен
Dialogue: 0,0:18:05.72,0:18:08.92,Default,,0,0,0,,Жара іріңді, ертең қолың шіріп, құлап қалады.
Dialogue: 0,0:18:11.36,0:18:12.69,Default,,0,0,0,,Ол шағып кетеді.
Dialogue: 0,0:18:14.06,0:18:16.74,Default,,0,0,0,,Әзірге жараны жуыңыз.
Dialogue: 0,0:18:19.52,0:18:22.90,Default,,0,0,0,,Юнның жүгін рұқсатсыз басып алсаңыз, ол ашуланады.
Dialogue: 0,0:18:22.90,0:18:25.64,Default,,0,0,0,,Бұл төтенше жағдай. Еш нәрсе істей алмайсың.
Dialogue: 0,0:18:26.44,0:18:27.38,Default,,0,0,0,,болды
Dialogue: 0,0:18:27.38,0:18:29.00,Default,,0,0,0,,Бұл бал
Dialogue: 0,0:18:30.12,0:18:31.70,Default,,0,0,0,,Сіз не істейсіз?
Dialogue: 0,0:18:31.70,0:18:36.80,Default,,0,0,0,,Бұны зардап шеккен аймаққа жағып, біраз уақытқа қалдырыңыз, сынықтар табиғи түрде шығады.
Dialogue: 0,0:18:36.80,0:18:38.15,Default,,0,0,0,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:18:39.04,0:18:42.04,Default,,0,0,0,,Ертеде қария мені инемен ойып алатын.
Dialogue: 0,0:18:42.04,0:18:45.92,Default,,0,0,0,,Мен осындай оңай әдіс бар екенін білгенде, мен өлтіру ниетін сезіндім.
Dialogue: 0,0:18:45.92,0:18:47.84,Default,,0,0,0,,Мундокуға ұқсайды.
Dialogue: 0,0:18:49.20,0:18:50.36,Default,,0,0,0,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:18:51.16,0:18:54.82,Default,,0,0,0,,Не істеп жатырсың, ханшайым?
Dialogue: 0,0:18:56.72,0:19:00.10,Default,,0,0,0,,Мен аздап күшейдім бе?
Dialogue: 0,0:19:00.70,0:19:03.50,Default,,0,0,0,,Менің ойымша, мен Хакуге аздап жақындадым.
Dialogue: 0,0:19:04.90,0:19:08.18,Default,,0,0,0,,Сіз және ол жақын сияқтысыз, бірақ сіз бен оның арасында алшақтық бар.
Dialogue: 0,0:19:08.68,0:19:11.56,Default,,0,0,0,,Мүмкін бұл мен оны қаламағандықтан шығар.
Dialogue: 0,0:19:12.62,0:19:15.06,Default,,0,0,0,,Шулы салбыраған көздер
Dialogue: 0,0:19:15.86,0:19:18.36,Default,,0,0,0,,Мүмкін солай шығар.
Dialogue: 0,0:19:19.06,0:19:23.15,Default,,0,0,0,,Мен ол кісіні бұрын талай рет басып тастағанмын.
Dialogue: 0,0:19:23.78,0:19:24.80,Default,,0,0,0,,Хаку
Dialogue: 0,0:19:24.80,0:19:26.68,Default,,0,0,0,,Бал тамшылары
Dialogue: 0,0:19:33.16,0:19:36.74,Default,,0,0,0,,Ано Ха Хаку
Dialogue: 0,0:19:39.06,0:19:40.00,Default,,0,0,0,,Хаку
Dialogue: 0,0:19:44.08,0:19:47.00,Default,,0,0,0,,Жетеді...жеткілікті
Dialogue: 0,0:19:51.06,0:19:53.88,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:19:55.62,0:19:57.86,Default,,0,0,0,,Ханшайым еркін өмір сүреді
Dialogue: 0,0:19:58.58,0:20:01.84,Default,,0,0,0,,Соған қанағат ет, ақымақ.
Dialogue: 0,0:20:02.68,0:20:06.30,Default,,0,0,0,,Енді сараңдығыңды көрсетпе.
Dialogue: 0,0:20:10.48,0:20:15.88,Default,,0,0,0,,Сіз әкелген Чиджукусаның арқасында серігімнің жағдайы жақсарып жатқан сияқты.
Dialogue: 0,0:20:16.68,0:20:18.96,Default,,0,0,0,,Барлығы сізге риза.
Dialogue: 0,0:20:19.76,0:20:20.88,Default,,0,0,0,,Жақсы
Dialogue: 0,0:20:23.08,0:20:25.76,Default,,0,0,0,,Мен бұдан былай құрбандық жасағым келмейді.
Dialogue: 0,0:20:25.76,0:20:27.84,Default,,0,0,0,,Өлген адам бар ма?
Dialogue: 0,0:20:27.84,0:20:31.82,Default,,0,0,0,,Дұрыс, мен қарақшымын.
Dialogue: 0,0:20:31.82,0:20:34.35,Default,,0,0,0,,Сіз зиянсыз кете алмайсыз.
Dialogue: 0,0:20:35.06,0:20:39.62,Default,,0,0,0,,Бұл шайқас аяқталғаннан кейін қарақшыларды таратыңыз.
Dialogue: 0,0:20:39.88,0:20:43.44,Default,,0,0,0,,Мен олардың қалыпты өмірлеріне оралғанын қалаймын.
Dialogue: 0,0:20:43.44,0:20:45.76,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:20:45.76,0:20:49.24,Default,,0,0,0,,Қиын адам бар.
Dialogue: 0,0:20:49.24,0:20:50.80,Default,,0,0,0,,Қиын
Dialogue: 0,0:20:50.80,0:20:52.02,Default,,0,0,0,,Бұл Джеха.
Dialogue: 0,0:20:53.78,0:20:56.64,Default,,0,0,0,,Бұл кеме оның үйі.
Dialogue: 0,0:20:56.76,0:21:00.92,Default,,0,0,0,,Біртүрлі формалардың болуына байланысты мен өзімді осында өте ыңғайлы сезінемін.
Dialogue: 0,0:21:00.92,0:21:05.62,Default,,0,0,0,,Ал егер қарақшыларды таратсақ, Дже-ха жалғыз қалады.
Dialogue: 0,0:21:05.62,0:21:09.46,Default,,0,0,0,,Сіз мені ала аласыз ба?
Dialogue: 0,0:21:10.78,0:21:14.48,Default,,0,0,0,,Ол мұны істегісі келеді, бірақ менімен барғысы келмейді.
Dialogue: 0,0:21:15.96,0:21:18.86,Default,,0,0,0,,Ол әлі де ата-анасын тастап кете алмай жүр ме?
Dialogue: 0,0:21:18.86,0:21:21.11,Default,,0,0,0,,Бұл күтпеген жағдай, капитан.
Dialogue: 0,0:21:22.24,0:21:25.12,Default,,0,0,0,,Мен жалғыз болғанды ​​ұнатамын.
Dialogue: 0,0:21:25.12,0:21:28.78,Default,,0,0,0,,Қарақшылар кетіп қалса да, біз қалағанымызды жасаймыз.
Dialogue: 0,0:21:28.78,0:21:32.80,Default,,0,0,0,,Біртүрлі айдаһарлармен қыдырудың не керегі бар?
Dialogue: 0,0:21:32.80,0:21:35.94,Default,,0,0,0,,Мен Йонамен бірге саяхаттасам, оны қарастырар едім.
Dialogue: 0,0:21:36.68,0:21:39.68,Default,,0,0,0,,Бірақ бала күту қиын.
Dialogue: 0,0:21:39.68,0:21:42.56,Default,,0,0,0,,Мен аздап ересек әйелге айналғанда.
Dialogue: 0,0:21:42.88,0:21:44.39,Default,,0,0,0,,Джэ-ха дөрекі
Dialogue: 0,0:21:44.39,0:21:45.67,Default,,0,0,0,,Хакуға ұқсайды
Dialogue: 0,0:21:46.94,0:21:48.26,Default,,0,0,0,,Бұл қызық
Dialogue: 0,0:21:48.76,0:21:50.48,Default,,0,0,0,,Бұл сирек.
Dialogue: 0,0:21:50.48,0:21:54.28,Default,,0,0,0,,Мен оны әйел ретінде көрсем, ол тек мені құм түкіртетін жолдарды айтады.
Dialogue: 0,0:21:56.92,0:21:59.34,Default,,0,0,0,,Сен сол қыз үшін алаңдайсың ба?
Dialogue: 0,0:22:01.84,0:22:03.11,Default,,0,0,0,,Әзіл
Dialogue: 0,0:22:07.38,0:22:09.70,Default,,0,0,0,,Шин-ах, не болды?
Dialogue: 0,0:22:11.28,0:22:16.82,Default,,0,0,0,,Портқа кемелер жиналуда.
Dialogue: 0,0:22:19.88,0:22:21.02,Default,,0,0,0,,Қанша кеме?
Dialogue: 0,0:22:21.40,0:22:22.44,Default,,0,0,0,,7
Dialogue: 0,0:22:22.44,0:22:23.62,Default,,0,0,0,,Жеті кеме
Dialogue: 0,0:22:24.66,0:22:29.64,Default,,0,0,0,,Бортта қаруы бар адам бар.
Dialogue: 0,0:22:29.64,0:22:33.64,Default,,0,0,0,,Кумуджи, сен бізді қорқытпақшысың ба?
Dialogue: 0,0:22:33.64,0:22:35.36,Default,,0,0,0,,Қызық емес пе?
Dialogue: 0,0:22:35.36,0:22:37.64,Default,,0,0,0,,Заттар көп қозғала бастаған сияқты.
Dialogue: 0,0:22:38.08,0:22:39.82,Default,,0,0,0,,Жерде не бар?
Dialogue: 0,0:22:39.82,0:22:42.54,Default,,0,0,0,,Соңында шайқас басталды
Dialogue: 0,0:22:42.82,0:22:44.54,Default,,0,0,0,,Барлық кішкентай ұлдарды жинаңыз.
Dialogue: 0,0:22:51.82,0:22:55.20,Default,,0,0,0,,Кумжи әскери күшін бірте-бірте арттырып келеді.
Dialogue: 0,0:22:55.20,0:23:01.70,Default,,0,0,0,,Бұл Кумжи үшін ең маңызды транзакция жақында болатындықтан шығар.
Dialogue: 0,0:23:03.16,0:23:05.28,Default,,0,0,0,,Кай империясы арасындағы.
Dialogue: 0,0:23:05.28,0:23:06.84,Default,,0,0,0,,Кай империясы
Dialogue: 0,0:23:06.84,0:23:10.32,Default,,0,0,0,,Кейбір адамдар Аваның қасында болса да
Dialogue: 0,0:23:10.32,0:23:13.34,Default,,0,0,0,,Ол Кумжидің тұрақты тұтынушысы дейді.
Dialogue: 0,0:23:13.56,0:23:15.98,Default,,0,0,0,,Ең маңызды мәміле болып табылады
Dialogue: 0,0:23:18.28,0:23:20.10,Default,,0,0,0,,Адам саудасы
Dialogue: 0,0:23:27.62,0:23:28.92,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:23:29.36,0:23:33.26,Default,,0,0,0,,Барсам, Жүністің өлуіне жол бермеймін.
Dialogue: 0,0:23:33.98,0:23:37.60,Default,,0,0,0,,Келесі жолы Йона таңғы 20-бөлім
Dialogue: 0,0:23:37.60,0:23:39.44,Default,,0,0,0,,Батылдық тізбегі
Dialogue: 0,0:23:40.94,0:23:45.94,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
