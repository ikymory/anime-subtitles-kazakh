Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.80,0:00:11.91,Default,,0,0,0,,Екеуіңізге бір өтінішім бар.
Dialogue: 0,0:00:12.93,0:00:15.90,Default,,0,0,0,,Мен Юнның мені де сапарға шығарып салғанын қалаймын.
Dialogue: 0,0:01:59.13,0:02:01.31,Default,,0,0,0,,Бұл көйлекті Юн тіккен.
Dialogue: 0,0:02:01.50,0:02:04.19,Default,,0,0,0,,Себебі менде қосымша мата болды.
Dialogue: 0,0:02:04.82,0:02:07.51,Default,,0,0,0,,Ханшайым қуанбайтын шығар, өйткені ол жібек емес.
Dialogue: 0,0:02:07.51,0:02:09.46,Default,,0,0,0,,Бұрынғы шүберектен де көп шығар
Dialogue: 0,0:02:09.46,0:02:11.99,Default,,0,0,0,,Қызықты киімдер Маған ұнады
Dialogue: 0,0:02:11.99,0:02:13.97,Default,,0,0,0,,Қызықты киімдер
Dialogue: 0,0:02:14.16,0:02:16.58,Default,,0,0,0,,Эй, сен маған кескіш құралдарды бере аласың ба?
Dialogue: 0,0:02:18.99,0:02:20.31,Default,,0,0,0,,Шашты реттеңіз
Dialogue: 0,0:02:20.33,0:02:21.68,Default,,0,0,0,,Сонымен
Dialogue: 0,0:02:22.46,0:02:24.59,Default,,0,0,0,,Бұл өте қиын.
Dialogue: 0,0:02:24.59,0:02:26.44,Default,,0,0,0,,Сондықтан ханшайым...
Dialogue: 0,0:02:26.44,0:02:28.62,Default,,0,0,0,,Юнның қолынан бәрі келеді.
Dialogue: 0,0:02:28.62,0:02:31.31,Default,,0,0,0,,Көп жұмысты қажет ететін діни қызметкерлер бар.
Dialogue: 0,0:02:31.31,0:02:34.24,Default,,0,0,0,,Менің жігітім үнемі жарақат алады, сондықтан мен медициналық әдістерді үйрендім.
Dialogue: 0,0:02:34.24,0:02:35.82,Default,,0,0,0,,Тағам да тамаша.
Dialogue: 0,0:02:35.82,0:02:38.77,Default,,0,0,0,,Жалғыз кемшілігі - ол тым әдемі.
Dialogue: 0,0:02:38.77,0:02:40.24,Default,,0,0,0,,Мен мұны естімедім.
Dialogue: 0,0:02:41.33,0:02:43.08,Default,,0,0,0,,Бірақ сен мейірімдісің.
Dialogue: 0,0:02:44.17,0:02:46.13,Default,,0,0,0,,Сондай-ақ Ix туралы
Dialogue: 0,0:02:46.13,0:02:50.40,Default,,0,0,0,,Мен роялтиді ұнатпаймын десем де, ол менің шашымды қырқып қояды.
Dialogue: 0,0:02:51.02,0:02:53.15,Default,,0,0,0,,Ақылы бар, айтып тұрмын.
Dialogue: 0,0:02:53.15,0:02:55.95,Default,,0,0,0,,Емдеу шығындары, киім-кешек құны, шаш қию және т.б.
Dialogue: 0,0:02:55.95,0:02:57.88,Default,,0,0,0,,Жақсы
Dialogue: 0,0:02:57.88,0:03:00.59,Default,,0,0,0,,Оны Мундокуға бекітіңіз
Dialogue: 0,0:03:00.59,0:03:03.66,Default,,0,0,0,,Мундоку Жел тайпасының батыры
Dialogue: 0,0:03:03.66,0:03:05.62,Default,,0,0,0,,Мундоку батыр ма?
Dialogue: 0,0:03:05.62,0:03:08.19,Default,,0,0,0,,Ақымақ Мундоку десең
Dialogue: 0,0:03:08.19,0:03:11.97,Default,,0,0,0,,Ол Юхонмен салыстыруға болатын ең күшті әскери қолбасшы болды.
Dialogue: 0,0:03:11.97,0:03:17.74,Default,,0,0,0,,Дұрыс, мен білетін Мұңдық – балаларының қамын жейтін қария.
Dialogue: 0,0:03:17.74,0:03:19.14,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:03:20.33,0:03:21.66,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:03:22.02,0:03:23.15,Default,,0,0,0,,Рахмет
Dialogue: 0,0:03:23.46,0:03:25.59,Default,,0,0,0,,Юн бәрін біледі, солай ма?
Dialogue: 0,0:03:25.59,0:03:27.71,Default,,0,0,0,,Оған көмектесу мүмкін емес, өйткені ол данышпан.
Dialogue: 0,0:03:28.02,0:03:30.51,Default,,0,0,0,,Кітапты бір рет оқу арқылы жаттауға болады.
Dialogue: 0,0:03:30.51,0:03:31.50,Default,,0,0,0,,Жарайды, енді іске кірісейік.
Dialogue: 0,0:03:31.68,0:03:35.53,Default,,0,0,0,,Бірақ мен кейбір кітаптарды ғана оқимын
Dialogue: 0,0:03:35.93,0:03:38.95,Default,,0,0,0,,Дүниеде мен білмейтін кітаптар көп.
Dialogue: 0,0:03:38.95,0:03:40.26,Default,,0,0,0,,жиіркенішті
Dialogue: 0,0:03:41.04,0:03:42.68,Default,,0,0,0,,Мен оны оқығым келеді
Dialogue: 0,0:03:42.68,0:03:43.83,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:03:45.66,0:03:47.30,Default,,0,0,0,,Білесің бе, Юн.
Dialogue: 0,0:03:47.30,0:03:49.62,Default,,0,0,0,,дейін проблема жоқ
Dialogue: 0,0:03:49.62,0:03:52.06,Default,,0,0,0,,Кітаптарды бірте-бірте жинаймын.
Dialogue: 0,0:03:52.06,0:03:55.53,Default,,0,0,0,,Мен бұл лас кітаппен әзірге жақсымын.
Dialogue: 0,0:03:55.93,0:03:57.19,Default,,0,0,0,,Кітап
Dialogue: 0,0:03:57.19,0:04:00.97,Default,,0,0,0,,Икстен келген бір ақымақ мені қоқыстан сыпырды.
Dialogue: 0,0:04:01.41,0:04:04.13,Default,,0,0,0,,Ортада бір нәрсені құлап, сындыру
Dialogue: 0,0:04:06.26,0:04:08.15,Default,,0,0,0,,Сіз өте ебедейсіз
Dialogue: 0,0:04:08.53,0:04:09.93,Default,,0,0,0,,Сен ақымақсың.
Dialogue: 0,0:04:10.24,0:04:12.77,Default,,0,0,0,,Бұл Құдай, бірақ бұл күмәнді.
Dialogue: 0,0:04:12.77,0:04:18.15,Default,,0,0,0,,Мен оның өтірік айтпайтынын жақсы білемін...
Dialogue: 0,0:04:18.79,0:04:23.20,Default,,0,0,0,,Әйтеуір, сапарға шықсаңыз, тез жүріңіз.
Dialogue: 0,0:04:23.20,0:04:26.31,Default,,0,0,0,,Саған қарайтын уақытым жоқ.
Dialogue: 0,0:04:36.22,0:04:37.26,Default,,0,0,0,,Ix
Dialogue: 0,0:04:37.88,0:04:39.02,Default,,0,0,0,,Махаббат та, махаббатсыз неке де
Dialogue: 0,0:04:39.39,0:04:41.10,Default,,0,0,0,,Мына көйлек әдемі екен.
Dialogue: 0,0:04:41.35,0:04:43.17,Default,,0,0,0,,Бұл сізге өте жарасады.
Dialogue: 0,0:04:44.77,0:04:46.11,Default,,0,0,0,,Бұл Юнкун.
Dialogue: 0,0:04:46.48,0:04:48.59,Default,,0,0,0,,Бұл бала өте керемет
Dialogue: 0,0:04:52.11,0:04:54.64,Default,,0,0,0,,Қалай болды, Юн?
Dialogue: 0,0:04:55.24,0:04:59.13,Default,,0,0,0,,Ix менің әкеме ұқсайды.
Dialogue: 0,0:04:59.13,0:05:01.48,Default,,0,0,0,,А, мәртебелі Иль?
Dialogue: 0,0:05:01.95,0:05:04.42,Default,,0,0,0,,Бұл өте қорқынышты
Dialogue: 0,0:05:04.42,0:05:08.31,Default,,0,0,0,,Сенімсіз, жылауық, басында Ханасаки бар
Dialogue: 0,0:05:09.84,0:05:12.44,Default,,0,0,0,,Бірақ сүйкімді адам
Dialogue: 0,0:05:14.84,0:05:16.37,Default,,0,0,0,,Сәлем Ix
Dialogue: 0,0:05:16.37,0:05:17.55,Default,,0,0,0,,Иә
Dialogue: 0,0:05:17.84,0:05:22.31,Default,,0,0,0,,Юнның аузы жаман, бірақ ол сені жақсы көреді.
Dialogue: 0,0:05:22.31,0:05:25.41,Default,,0,0,0,,Мен отбасымды бөлгім келмейді
Dialogue: 0,0:05:25.95,0:05:28.55,Default,,0,0,0,,Мен Юнды сапарға апара алмаймын.
Dialogue: 0,0:05:29.68,0:05:33.26,Default,,0,0,0,,Сондықтан мен Икстің өтінішін тыңдай алмаймын.
Dialogue: 0,0:05:33.93,0:05:35.59,Default,,0,0,0,,Ix өтініші
Dialogue: 0,0:05:36.28,0:05:41.46,Default,,0,0,0,,Иксу маған Юнды алып кет деді, бірақ бәрібір мен болдым.
Dialogue: 0,0:05:42.44,0:05:45.79,Default,,0,0,0,,Юн барамын демейінше мен сені ала алмаймын.
Dialogue: 0,0:05:47.31,0:05:48.66,Default,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,0:05:48.97,0:05:52.24,Default,,0,0,0,,Кешіріңіз, айтуым керек еді.
Dialogue: 0,0:06:06.15,0:06:07.57,Default,,0,0,0,,Юн мырза
Dialogue: 0,0:06:07.91,0:06:09.94,Default,,0,0,0,,Дәл қазір...
Dialogue: 0,0:06:11.84,0:06:15.26,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Қайда баруымды сұрап тұрсың?
Dialogue: 0,0:06:16.53,0:06:18.64,Default,,0,0,0,,Олармен бірге жүріңіз.
Dialogue: 0,0:06:20.22,0:06:27.22,Default,,0,0,0,,Юн мырза, сіз осы жерден кетіп, ханшайымдарға көмектесуіңіз керек.
Dialogue: 0,0:06:28.71,0:06:31.88,Default,,0,0,0,,Мен неге қалжыңдаймын?
Dialogue: 0,0:06:32.35,0:06:35.46,Default,,0,0,0,,Сіз мұндай жерге жатпайсыз.
Dialogue: 0,0:06:36.37,0:06:38.37,Default,,0,0,0,,Дүниеге қарап, оны артта қалдыр
Dialogue: 0,0:06:39.71,0:06:41.08,Default,,0,0,0,,Ix
Dialogue: 0,0:06:44.64,0:06:47.57,Default,,0,0,0,,Мен болсам, сенсіз жақсы болар едім.
Dialogue: 0,0:06:57.19,0:06:58.59,Default,,0,0,0,,Мен бұған жол бермеймін. Мен бұған жол бермеймін!
Dialogue: 0,0:06:58.59,0:07:00.53,Default,,0,0,0,,Қалағаныңызды айтыңыз
Dialogue: 0,0:07:04.22,0:07:07.59,Default,,0,0,0,,Юн-кун, мына медициналық кітапты қара.
Dialogue: 0,0:07:08.31,0:07:10.06,Default,,0,0,0,,Дүниеге қараңыз
Dialogue: 0,0:07:19.79,0:07:21.48,Default,,0,0,0,,Маған балықты гриль жасауға рұқсат етіңіз.
Dialogue: 0,0:07:27.73,0:07:30.31,Default,,0,0,0,,Мен қазір қатты қозғала аламын.
Dialogue: 0,0:07:30.31,0:07:33.26,Default,,0,0,0,,Мен өлмейтінмін, өле алмаймын
Dialogue: 0,0:07:33.95,0:07:36.62,Default,,0,0,0,,Бір ханшайым бар, оған қамқорлық жасауға болады.
Dialogue: 0,0:07:36.62,0:07:37.82,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:07:37.82,0:07:43.51,Default,,0,0,0,,Сіз ханшайымды қорғау үшін өз өміріңізді қатерге тіккен ақымақсыз ба?
Dialogue: 0,0:07:44.44,0:07:47.44,Default,,0,0,0,,Сіз қорғағыңыз келетіндерді қорғаған кезде
Dialogue: 0,0:07:47.44,0:07:50.54,Default,,0,0,0,,Өміріңізді бір-біріңізбен өлшеп жатырсыз ба?
Dialogue: 0,0:08:01.33,0:08:03.55,Default,,0,0,0,,Балық жейді
Dialogue: 0,0:08:03.97,0:08:05.24,Default,,0,0,0,,Қажет емес
Dialogue: 0,0:08:24.57,0:08:25.93,Default,,0,0,0,,Абай бол, Твайлайт.
Dialogue: 0,0:08:46.81,0:08:50.74,Default,,0,0,0,,Кеше жегенім ағаштың тамыры еді
Dialogue: 0,0:08:51.68,0:08:55.96,Default,,0,0,0,,Егінде егін, тіпті жәндіктер де жоқ.
Dialogue: 0,0:08:57.15,0:09:00.38,Default,,0,0,0,,Бүгін тамақ ұрлап алайық.
Dialogue: 0,0:09:02.31,0:09:05.53,Default,,0,0,0,,Соңғы рет мұны істегенімде, өліп қала жаздадым.
Dialogue: 0,0:09:06.55,0:09:10.17,Default,,0,0,0,,Осы жолы жақсырақ жасайық, бір соққы.
Dialogue: 0,0:09:10.77,0:09:12.53,Default,,0,0,0,,Өлсе де болады
Dialogue: 0,0:09:22.39,0:09:23.46,Default,,0,0,0,,Жарайды
Dialogue: 0,0:09:25.06,0:09:28.11,Default,,0,0,0,,Ақша ақшасы
Dialogue: 0,0:09:30.39,0:09:34.04,Default,,0,0,0,,Кешіріңіз... ештеңе...
Dialogue: 0,0:09:46.75,0:09:48.56,Default,,0,0,0,,Қозғалмаңыз.
Dialogue: 0,0:09:49.51,0:09:52.11,Default,,0,0,0,,Сіз...
Dialogue: 0,0:09:52.51,0:09:54.37,Default,,0,0,0,,Ауылда өсек-аяң бар.
Dialogue: 0,0:09:54.37,0:09:58.19,Default,,0,0,0,,Соңғы кездері алтын бөлшектері бар бейтаныс адамдар кезіп жүр дейді.
Dialogue: 0,0:09:58.19,0:10:00.04,Default,,0,0,0,,Бұл сенсің, шығар.
Dialogue: 0,0:10:03.75,0:10:05.52,Default,,0,0,0,,Жылағаннан пайда жоқ
Dialogue: 0,0:10:06.15,0:10:07.62,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:07.97,0:10:12.08,Default,,0,0,0,,Алтын дәндерді мен ертерек басқа балаға бердім.
Dialogue: 0,0:10:12.08,0:10:14.06,Default,,0,0,0,,Бұл соңғы рет болды.
Dialogue: 0,0:10:15.73,0:10:20.73,Default,,0,0,0,,Бірақ келесі жолы бірдеңе тапсам, міндетті түрде саған әкелемін.
Dialogue: 0,0:10:21.68,0:10:22.87,Default,,0,0,0,,Бұл
Dialogue: 0,0:10:23.84,0:10:26.03,Default,,0,0,0,,Бұл сіздің кінәлі, себебі сіз қайықпен жүзіп жүрсіз.
Dialogue: 0,0:10:26.03,0:10:28.51,Default,,0,0,0,,Бұл жерде жеу немесе жеу.
Dialogue: 0,0:10:28.51,0:10:30.41,Default,,0,0,0,,Жарайды, ауырмайды.
Dialogue: 0,0:10:30.41,0:10:31.91,Default,,0,0,0,,Қарсымын!
Dialogue: 0,0:10:31.91,0:10:34.28,Default,,0,0,0,,Уайымдауға негіз жоқ.
Dialogue: 0,0:10:34.28,0:10:36.81,Default,,0,0,0,,Дәл қазір мен сені өлтірейін деп тұрсың.
Dialogue: 0,0:10:37.97,0:10:40.24,Default,,0,0,0,,Олай болса, мазалағаным үшін кешіріңіз.
Dialogue: 0,0:10:40.66,0:10:42.59,Default,,0,0,0,,Әңгімені тыңдау
Dialogue: 0,0:10:47.61,0:10:50.99,Default,,0,0,0,,Ей, алтын дәндер туралы әңгіме әлі біткен жоқ.
Dialogue: 0,0:10:50.99,0:10:52.77,Default,,0,0,0,,Мен сені бүгін менің үйімде қалдырамын.
Dialogue: 0,0:10:53.59,0:10:57.35,Default,,0,0,0,,Мен қуаныштымын. Негізі мен лагерьге шығуды жоспарлап едім.
Dialogue: 0,0:10:57.35,0:10:59.66,Default,,0,0,0,,Менің атым Ix.
Dialogue: 0,0:11:10.04,0:11:12.37,Default,,0,0,0,,Жылы және тірі
Dialogue: 0,0:11:12.99,0:11:14.91,Default,,0,0,0,,Егер сіз мұны қолдансаңыз
Dialogue: 0,0:11:27.06,0:11:30.31,Default,,0,0,0,,Мен тоңып, қарным ашты
Dialogue: 0,0:11:30.68,0:11:33.14,Default,,0,0,0,,Мен осында өлемін бе?
Dialogue: 0,0:11:35.53,0:11:36.71,Default,,0,0,0,,Бұл картоп
Dialogue: 0,0:11:37.19,0:11:38.44,Default,,0,0,0,,(Роко) Һм? (Масато) Хехехе
Dialogue: 0,0:11:38.99,0:11:41.44,Default,,0,0,0,,Бұған не болды? Сен оны ұрладың.
Dialogue: 0,0:11:41.44,0:11:42.66,Default,,0,0,0,,Алынған
Dialogue: 0,0:11:43.08,0:11:45.33,Default,,0,0,0,,Менің картоп жемегеніме көп болды
Dialogue: 0,0:11:45.91,0:11:47.66,Default,,0,0,0,,Саған не болды?
Dialogue: 0,0:11:48.77,0:11:49.95,Default,,0,0,0,,Аяқ киім
Dialogue: 0,0:11:51.13,0:11:53.66,Default,,0,0,0,,Мен оны картопқа айырбастап алдым.
Dialogue: 0,0:11:53.91,0:11:55.99,Default,,0,0,0,,Олар оны маған айырбастады.
Dialogue: 0,0:11:56.37,0:11:58.71,Default,,0,0,0,,Мына суықта не істеп жүрсің?
Dialogue: 0,0:11:59.02,0:12:01.04,Default,,0,0,0,,Мен сияқты біреуге солай істе
Dialogue: 0,0:12:01.79,0:12:03.64,Default,,0,0,0,,Мұның артында бірдеңе болуы керек.
Dialogue: 0,0:12:04.88,0:12:06.15,Default,,0,0,0,,Өйткені
Dialogue: 0,0:12:07.08,0:12:09.62,Default,,0,0,0,,Менің басыма дәрі жаққаныңыз үшін рахмет
Dialogue: 0,0:12:09.62,0:12:11.26,Default,,0,0,0,,Сіз ояу болдыңыз ба?
Dialogue: 0,0:12:11.26,0:12:13.48,Default,,0,0,0,,Иә, мен оны жиі тыңдаймын.
Dialogue: 0,0:12:13.97,0:12:16.32,Default,,0,0,0,,Менің жүрегім сондай ыстық
Dialogue: 0,0:12:16.71,0:12:20.61,Default,,0,0,0,,Мен көзімнің шетіне дейін қызып тұрмын...
Dialogue: 0,0:12:20.61,0:12:22.12,Default,,0,0,0,,Неге жылайсың?
Dialogue: 0,0:12:22.62,0:12:24.13,Default,,0,0,0,,Біртүрлі жігіт
Dialogue: 0,0:12:24.13,0:12:26.96,Default,,0,0,0,,Сырттан келгендердің бәрі солай ма?
Dialogue: 0,0:12:27.68,0:12:30.24,Default,,0,0,0,,Сыртта әртүрлі адамдар отыр.
Dialogue: 0,0:12:30.24,0:12:33.09,Default,,0,0,0,,Мен астанаға көп бармаймын.
Dialogue: 0,0:12:33.09,0:12:34.35,Default,,0,0,0,,Достардан ғашықтарға, тіпті отбасы мүшелерінен де
Dialogue: 0,0:12:34.84,0:12:36.26,Default,,0,0,0,,Мен астанаға барғым келеді
Dialogue: 0,0:12:37.42,0:12:41.39,Default,,0,0,0,,Мен бұл жерден тез кетіп, астанаға немесе басқа жерлерге кеткім келеді.
Dialogue: 0,0:12:41.39,0:12:47.10,Default,,0,0,0,,Мен өскенде кітапты көп оқып, еркін оқитын жерге барғым келеді.
Dialogue: 0,0:12:47.10,0:12:49.44,Default,,0,0,0,,Мен кітап оқи аламын.
Dialogue: 0,0:12:49.44,0:12:50.57,Default,,0,0,0,,1-деңгей—тіпті танк те толықтай қауіпсіз сезілмейді.
Dialogue: 0,0:12:50.57,0:12:52.11,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:12:52.11,0:12:54.13,Default,,0,0,0,,Егер бұл қарапайым кітап болса
Dialogue: 0,0:12:54.77,0:12:57.33,Default,,0,0,0,,Қиын кітап болса да, сағат нешеде?
Dialogue: 0,0:12:57.84,0:13:00.99,Default,,0,0,0,,Жарайды, мен келесі жолы кітап іздеймін.
Dialogue: 0,0:13:00.99,0:13:03.37,Default,,0,0,0,,Өйткені мен көп қозғалдым.
Dialogue: 0,0:13:03.37,0:13:06.06,Default,,0,0,0,,Не істеп жатырсың?
Dialogue: 0,0:13:07.26,0:13:09.06,Default,,0,0,0,,Құдайға жалбарынатын адам
Dialogue: 0,0:13:09.06,0:13:10.23,Default,,0,0,0,,Жақсы қыз бол және барынша тырыс, жарай ма?
Dialogue: 0,0:13:11.57,0:13:15.76,Default,,0,0,0,,Құдайдың даусына сүйеніп, көңілі түскен адамға барыңыз
Dialogue: 0,0:13:15.76,0:13:19.72,Default,,0,0,0,,Адамның өмір сүруге батылдық табуға көмектесу
Dialogue: 0,0:13:20.33,0:13:23.53,Default,,0,0,0,,Құдайдың бар болуы мүмкін емес.
Dialogue: 0,0:13:25.53,0:13:29.37,Default,,0,0,0,,Мен баруға мүмкіндік болмаса да, мен өтірікшіге ұқсамаймын.
Dialogue: 0,0:13:30.71,0:13:34.35,Default,,0,0,0,,Қазір қайда бара жатырсың? Жалаң аяқ жүруге болмайды.
Dialogue: 0,0:13:34.84,0:13:36.99,Default,,0,0,0,,Уайымдама, мен сабаннан сандал жасаймын.
Dialogue: 0,0:13:36.99,0:13:37.95,Default,,0,0,0,,Шөптен жасалған сандалдар?
Dialogue: 0,0:13:37.95,0:13:39.99,Default,,0,0,0,,Мұны маған баяғыда үйреткен.
Dialogue: 0,0:13:40.37,0:13:41.95,Default,,0,0,0,,Маған да айтыңызшы
Dialogue: 0,0:13:42.93,0:13:44.77,Default,,0,0,0,,Юн-кун керемет
Dialogue: 0,0:13:44.77,0:13:47.84,Default,,0,0,0,,Бірінші рет болса да, сатылымдағы сабан сандалдарды көргім келеді.
Dialogue: 0,0:13:48.71,0:13:52.42,Default,,0,0,0,,Сенің жамандығың сонша, Кусасагодан кешірім сұрауың керек.
Dialogue: 0,0:13:54.04,0:13:55.75,Default,,0,0,0,,Менің есіме бір нәрсе түсті.
Dialogue: 0,0:13:56.91,0:13:58.04,Default,,0,0,0,,Мен саған мынаны беремін
Dialogue: 0,0:13:58.04,0:14:01.22,Default,,0,0,0,,Қандай әдемі сандал
Dialogue: 0,0:14:01.55,0:14:04.85,Default,,0,0,0,,Оның орнына маған басқа нәрсе айтыңыз.
Dialogue: 0,0:14:19.26,0:14:21.06,Default,,0,0,0,,Не істеп жатырсың, Миста?
Dialogue: 0,0:14:21.44,0:14:22.68,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:14:23.91,0:14:28.10,Default,,0,0,0,,Бұл көңілді болды. Мен көбірек сөйлескім келді.
Dialogue: 0,0:14:28.62,0:14:30.84,Default,,0,0,0,,Мен сізден бір нәрсе сұрайын деп едім.
Dialogue: 0,0:14:32.48,0:14:36.40,Default,,0,0,0,,Мен сенің бармауыңды қатты қаладым, бірақ айта алмадым.
Dialogue: 0,0:14:37.39,0:14:41.93,Default,,0,0,0,,Келесі жолы келсем, келесі жолы көрсем айтамын.
Dialogue: 0,0:14:42.86,0:14:44.44,Default,,0,0,0,,Осы жерде болыңыз
Dialogue: 0,0:14:45.37,0:14:47.39,Default,,0,0,0,,Қалай ойлайсыз, бұл қиындық тудырды ма?
Dialogue: 0,0:14:48.14,0:14:51.22,Default,,0,0,0,,Жарайды, тез кел.
Dialogue: 0,0:15:13.55,0:15:15.08,Default,,0,0,0,,Сіз не істейсіз?
Dialogue: 0,0:15:16.04,0:15:18.39,Default,,0,0,0,,Мен әрқашан жалғыз болдым
Dialogue: 0,0:15:19.04,0:15:23.33,Default,,0,0,0,,Сені көргеннен кейін өзімді жалғыз сезінбесе амалым жоқ.
Dialogue: 0,0:15:33.48,0:15:36.62,Default,,0,0,0,,Ix, жарақатыңа не болды?
Dialogue: 0,0:15:36.62,0:15:38.97,Default,,0,0,0,,Ал мына жеңіл киім
Dialogue: 0,0:15:39.66,0:15:42.95,Default,,0,0,0,,Кеш келгенім үшін кешіріңіз.
Dialogue: 0,0:15:42.95,0:15:44.46,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:15:44.46,0:15:48.31,Default,,0,0,0,,Мен көп нәрсені сыйлағым келді, сондықтан мен оларды жинадым.
Dialogue: 0,0:15:48.31,0:15:51.84,Default,,0,0,0,,Менің заттарымды алтын дәннің артынан жүрген адамдар алып кетті.
Dialogue: 0,0:15:52.55,0:15:54.42,Default,,0,0,0,,Кітап та жоғалып кетті.
Dialogue: 0,0:15:55.46,0:16:00.79,Default,,0,0,0,,Бірде-бір алтын қалмады.
Dialogue: 0,0:16:02.62,0:16:06.64,Default,,0,0,0,,Юн-кун мен алысқа кетемін.
Dialogue: 0,0:16:08.15,0:16:10.79,Default,,0,0,0,,Мен адамдармен бірге болғым келеді, бірақ
Dialogue: 0,0:16:10.79,0:16:16.73,Default,,0,0,0,,Бір түйір алтын болған мен адамға жарамсыз нәрселерді тартамын.
Dialogue: 0,0:16:18.33,0:16:20.51,Default,,0,0,0,,Соңында сенің жүзіңді көргім келді.
Dialogue: 0,0:16:21.52,0:16:25.19,Default,,0,0,0,,Мен сендермен сабаннан сандал жасап өте қызық болдым.
Dialogue: 0,0:16:27.06,0:16:28.59,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:16:37.28,0:16:38.59,Default,,0,0,0,,Таңертең ерте тұрып-ақ қазірден-ақ қажырлы еңбек етіп жатырсың ғой.
Dialogue: 0,0:16:38.93,0:16:40.04,Default,,0,0,0,,Мен де барамын
Dialogue: 0,0:16:41.39,0:16:45.33,Default,,0,0,0,,Бірақ мен көп көрінбеймін.
Dialogue: 0,0:16:46.17,0:16:49.09,Default,,0,0,0,,Мен астанаға бара алмаймын, тіпті кітаптар да...
Dialogue: 0,0:16:49.09,0:16:51.82,Default,,0,0,0,,Жақсы, астанаға барудың қажеті жоқ.
Dialogue: 0,0:16:51.82,0:16:53.59,Default,,0,0,0,,Кітап қажет емес
Dialogue: 0,0:16:53.59,0:16:55.66,Default,,0,0,0,,Ix айтыңызшы
Dialogue: 0,0:16:55.66,0:16:59.08,Default,,0,0,0,,Сізге қауіп төніп тұрған шығар.
Dialogue: 0,0:16:59.08,0:17:03.49,Default,,0,0,0,,Саған дәрі беретін жалғыз мен шығармын.
Dialogue: 0,0:17:07.84,0:17:10.06,Default,,0,0,0,,Сыртқы дүние...?
Dialogue: 0,0:17:11.33,0:17:14.65,Default,,0,0,0,,На Икс, өткен батырлардың әңгімелерін айтып бер.
Dialogue: 0,0:17:14.65,0:17:17.42,Default,,0,0,0,,Бұл тітіркендіргіш. Қайтадан жарақат алдыңыз ба?
Dialogue: 0,0:17:17.42,0:17:19.55,Default,,0,0,0,,Біраз күтіңіз, шөптер.
Dialogue: 0,0:17:20.39,0:17:22.22,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:17:22.22,0:17:25.46,Default,,0,0,0,,Мен білемін, бірақ сен қауіптісің.
Dialogue: 0,0:17:28.84,0:17:30.08,Default,,0,0,0,,Юн мырза
Dialogue: 0,0:17:31.66,0:17:32.99,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:17:33.75,0:17:36.50,Default,,0,0,0,,Сіздің қазіргі сабан сандалыңыз тозған шығар.
Dialogue: 0,0:17:39.82,0:17:42.27,Default,,0,0,0,,Бұрынғыдай нашар.
Dialogue: 0,0:17:42.27,0:17:46.33,Default,,0,0,0,,мен тоқуды жақсы меңгере бастадым.
Dialogue: 0,0:17:46.53,0:17:47.86,Default,,0,0,0,,Ix
Dialogue: 0,0:17:48.68,0:17:51.22,Default,,0,0,0,,Тіпті Ix-тің де тозығы жеткен.
Dialogue: 0,0:17:52.57,0:17:55.80,Default,,0,0,0,,Мен көмектесе алмаймын, сәл күте тұрыңыз.
Dialogue: 0,0:17:57.88,0:18:00.53,Default,,0,0,0,,Бұл керемет, Юн.
Dialogue: 0,0:18:00.88,0:18:02.66,Default,,0,0,0,,Керемет
Dialogue: 0,0:18:04.11,0:18:05.17,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:18:07.28,0:18:08.66,Default,,0,0,0,,Рахмет
Dialogue: 0,0:18:12.13,0:18:13.62,Default,,0,0,0,,Ыңғайлы
Dialogue: 0,0:18:13.86,0:18:15.52,Default,,0,0,0,,Эй, қарашы.
Dialogue: 0,0:18:24.71,0:18:26.33,Default,,0,0,0,,Құлаған жоқ
Dialogue: 0,0:18:28.99,0:18:30.59,Default,,0,0,0,,Мен құлаған жоқпын.
Dialogue: 0,0:18:35.04,0:18:36.79,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:18:38.55,0:18:39.75,Default,,0,0,0,,Ix
Dialogue: 0,0:18:39.75,0:18:44.84,Default,,0,0,0,,Мен ол ханшайымға оның аңғал екенін айттым.
Dialogue: 0,0:18:45.04,0:18:49.95,Default,,0,0,0,,Негізі мен шындық туралы ештеңе білмеймін...мүмкін бұл жай ғана білім шығар.
Dialogue: 0,0:18:52.04,0:18:54.42,Default,,0,0,0,,Бұл тамаша емес.
Dialogue: 0,0:18:55.71,0:18:57.22,Default,,0,0,0,,Юн мырза
Dialogue: 0,0:18:59.04,0:19:01.88,Default,,0,0,0,,Na Ix, сен білмейсің.
Dialogue: 0,0:19:01.88,0:19:05.64,Default,,0,0,0,,Мен үшін сіздің сөздеріңіз абсолютті.
Dialogue: 0,0:19:05.95,0:19:11.04,Default,,0,0,0,,Ендеше, ақырында, барам десең, барамын.
Dialogue: 0,0:19:11.66,0:19:15.60,Default,,0,0,0,,Менің тағдырым солай болса керек.
Dialogue: 0,0:19:17.84,0:19:22.82,Default,,0,0,0,,Менің ойымша, сен енді менсіз жақсы болғың келеді.
Dialogue: 0,0:19:24.02,0:19:27.68,Default,,0,0,0,,Сөздердің күші бар
Dialogue: 0,0:19:29.39,0:19:32.62,Default,,0,0,0,,Кейде ол сөйлеу рухына айналады.
Dialogue: 0,0:19:33.02,0:19:38.45,Default,,0,0,0,,Сондықтан мен жақсымын десем, Макото жақсы болады деп ойлаймын.
Dialogue: 0,0:19:39.99,0:19:43.48,Default,,0,0,0,,Бірақ...жоқ, ол жұмыс істемейді.
Dialogue: 0,0:19:45.15,0:19:49.53,Default,,0,0,0,,Мен жалғызбын... Мен жалғызбын...
Dialogue: 0,0:19:52.97,0:19:56.64,Default,,0,0,0,,Бұл қиыншылық. Бұл өмірмен қоштасу емес.
Dialogue: 0,0:20:09.88,0:20:11.88,Default,,0,0,0,,Сіз шешім қабылдадыңыз ба?
Dialogue: 0,0:20:13.17,0:20:15.62,Default,,0,0,0,,Хаку менімен келіседі.
Dialogue: 0,0:20:15.62,0:20:19.08,Default,,0,0,0,,Бұл басқа біреу сияқты ауыртпалық болмайтын сияқты.
Dialogue: 0,0:20:19.08,0:20:20.79,Default,,0,0,0,,Біреу кім?
Dialogue: 0,0:20:21.33,0:20:22.37,Default,,0,0,0,,Мен ойлағандай
Dialogue: 0,0:20:25.86,0:20:28.33,Default,,0,0,0,,Юн-кун, жарайды.
Dialogue: 0,0:20:29.39,0:20:31.67,Default,,0,0,0,,Менің естігім келетіні осы.
Dialogue: 0,0:20:31.67,0:20:34.53,Default,,0,0,0,,Юн, сенде неге сонша көп?
Dialogue: 0,0:20:34.53,0:20:36.93,Default,,0,0,0,,Кітап болса, қоя сал, көлемді.
Dialogue: 0,0:20:36.93,0:20:38.22,Default,,0,0,0,,Бұл кітап емес.
Dialogue: 0,0:20:38.22,0:20:40.70,Default,,0,0,0,,Олай болса, көрсетейін.
Dialogue: 0,0:20:43.68,0:20:48.40,Default,,0,0,0,,Бұл ханшайымның күзетілетін қалаға кіруіне арналған сөмке.
Dialogue: 0,0:20:48.40,0:20:50.11,Default,,0,0,0,,Маған кіруге рұқсат етіңіз
Dialogue: 0,0:20:55.33,0:20:58.36,Default,,0,0,0,,Бізде басқа да әртүрлі заттар бар, бірақ қараңыз
Dialogue: 0,0:20:58.36,0:21:00.19,Default,,0,0,0,,Жетер, кеттік.
Dialogue: 0,0:21:00.19,0:21:01.46,Default,,0,0,0,,Күн батып барады
Dialogue: 0,0:21:02.64,0:21:04.08,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:21:04.08,0:21:06.33,Default,,0,0,0,,Ix Мен барамын
Dialogue: 0,0:21:06.33,0:21:08.77,Default,,0,0,0,,Мен сенің қауіпсіздігің үшін дұға етемін.
Dialogue: 0,0:21:09.88,0:21:14.04,Default,,0,0,0,,Неге, маған көрсетейін десең де.
Dialogue: 0,0:21:16.68,0:21:18.28,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:21:26.78,0:21:31.39,Default,,0,0,0,,Асығыңыздар, күн шыққанша үш таудан өтуіміз керек.
Dialogue: 0,0:21:32.53,0:21:34.35,Default,,0,0,0,,Сіз кенеттен жұмысты тоқтатқыңыз келе ме?
Dialogue: 0,0:21:34.35,0:21:37.48,Default,,0,0,0,,Ол әдемі данышпан бала болғандықтан табиғи нәрсе.
Dialogue: 0,0:21:37.48,0:21:39.22,Default,,0,0,0,,Менің артымнан үнсіз жүр
Dialogue: 0,0:23:28.08,0:23:33.73,Default,,0,0,0,,Әке, сіз алып кетпесеңіз, мен қазір өмір сүре алмаймын.
Dialogue: 0,0:23:34.48,0:23:38.42,Default,,0,0,0,,Келесі жолы «Таң таңындағы Йона» 9-бөлім
Dialogue: 0,0:23:38.90,0:23:40.28,Default,,0,0,0,,Қалтыраған шешім
Dialogue: 0,0:23:41.78,0:23:46.78,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
