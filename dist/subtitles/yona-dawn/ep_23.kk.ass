Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Сувон
Dialogue: 0,0:00:05.76,0:00:07.10,Default,,0,0,0,,Жүніс
Dialogue: 0,0:00:07.44,0:00:10.02,Default,,0,0,0,,Мәртебелі Науқас енді көзін ашпайды.
Dialogue: 0,0:00:10.26,0:00:12.64,Default,,0,0,0,,Мен өлтірдім
Dialogue: 0,0:00:13.54,0:00:15.94,Default,,0,0,0,,Бұл иллюзия ма?
Dialogue: 0,0:00:16.74,0:00:17.90,Default,,0,0,0,,Сіз...
Dialogue: 0,0:00:18.52,0:00:21.92,Default,,0,0,0,,Йона ханшайым жоғалып кетті
Dialogue: 0,0:00:24.54,0:00:29.08,Default,,0,0,0,,Мен сені Китаяманың жартастарында өлді деп естідім.
Dialogue: 0,0:00:32.32,0:00:37.08,Default,,0,0,0,,Бұл шынымен де Йона ханшайым, солай емес пе?
Dialogue: 0,0:00:40.28,0:00:44.74,Default,,0,0,0,,Мен сенің қолыңды сен ұйықтап қалғанша ұстаймын, дәл осылай патшайым солай істеді.
Dialogue: 0,0:00:44.88,0:00:49.50,Default,,0,0,0,,Жүністің көз жасы түсіп кетсе, мен оны ешкім көрмес үшін сүртемін.
Dialogue: 0,0:00:50.06,0:00:52.36,Default,,0,0,0,,Ендеше ертең күліңіз
Dialogue: 0,0:02:27.70,0:02:29.44,Default,,0,0,0,,Неге мұнда?
Dialogue: 0,0:02:31.00,0:02:32.82,Default,,0,0,0,,Хакуға не болды?
Dialogue: 0,0:02:34.04,0:02:36.18,Default,,0,0,0,,Жоқ, бұл ақымақ сұрақ болды.
Dialogue: 0,0:02:36.80,0:02:38.66,Default,,0,0,0,,Сіз қауіпсізсіз.
Dialogue: 0,0:02:38.66,0:02:44.62,Default,,0,0,0,,Ол сені әлі де өмірімен қорғап жүргендіктен шығар.
Dialogue: 0,0:02:46.42,0:02:49.18,Default,,0,0,0,,Янкумджи, Ава мырзасы,
Dialogue: 0,0:02:49.18,0:02:52.18,Default,,0,0,0,,Сіздің басқа елмен заңсыз сауда жасап жатқаныңызды естідім.
Dialogue: 0,0:02:52.18,0:02:54.54,Default,,0,0,0,,Мен барлау үшін келдім.
Dialogue: 0,0:02:56.74,0:02:57.94,Default,,0,0,0,,Құрметті Сувон
Dialogue: 0,0:03:09.32,0:03:10.52,Default,,0,0,0,,Жібер
Dialogue: 0,0:03:10.52,0:03:13.42,Default,,0,0,0,,Тыныш және тыныш болыңыз
Dialogue: 0,0:03:13.42,0:03:14.66,Default,,0,0,0,,Құрметті Сувон
Dialogue: 0,0:03:15.24,0:03:17.50,Default,,0,0,0,,Жалғыз жүрсең қиын.
Dialogue: 0,0:03:17.86,0:03:20.42,Default,,0,0,0,,Генерал Дзюдо, кешіріңіз.
Dialogue: 0,0:03:20.42,0:03:23.40,Default,,0,0,0,,Мен жаңа қалашыққа толқудан бас тарта алмаймын.
Dialogue: 0,0:03:23.40,0:03:25.90,Default,,0,0,0,,Мен қатты толқып тұрмын
Dialogue: 0,0:03:25.90,0:03:29.00,Default,,0,0,0,,Бұл әйел ме?
Dialogue: 0,0:03:31.18,0:03:33.62,Default,,0,0,0,,Жоқ, генерал дзюдо.
Dialogue: 0,0:03:33.62,0:03:35.64,Default,,0,0,0,,Бұл таңқаларлық әдепсіз.
Dialogue: 0,0:03:35.64,0:03:38.86,Default,,0,0,0,,Қай әйелмен ойнау сізге байланысты.
Dialogue: 0,0:03:38.86,0:03:41.84,Default,,0,0,0,,Бірақ инкогнито режимінде барлау кезінде не істейсіз?
Dialogue: 0,0:03:42.08,0:03:43.90,Default,,0,0,0,,Үйге қайт, үйге бар.
Dialogue: 0,0:03:43.90,0:03:46.04,Default,,0,0,0,,Генерал, сіздің дауысыңыз қатты.
Dialogue: 0,0:03:46.04,0:03:47.30,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:03:47.30,0:03:49.78,Default,,0,0,0,,Түсіндім, түсінемін.
Dialogue: 0,0:03:49.78,0:03:52.60,Default,,0,0,0,,Мен бұл кісімен дұрыстап қоштасамын.
Dialogue: 0,0:03:53.04,0:03:55.42,Default,,0,0,0,,Айтпақшы, Янкумджи
Dialogue: 0,0:03:55.42,0:03:57.04,Default,,0,0,0,,Қай жерде екені белгісіз
Dialogue: 0,0:03:58.16,0:04:02.40,Default,,0,0,0,,Кеше түнде адам саудасы үшін Кай империясына бара жатқан едім.
Dialogue: 0,0:04:02.40,0:04:04.62,Default,,0,0,0,,Қарақшылар шабуыл жасады деген болжам бар
Dialogue: 0,0:04:05.14,0:04:08.58,Default,,0,0,0,,Осылайша Кумжи сатпақ болған адамдар
Dialogue: 0,0:04:08.96,0:04:11.44,Default,,0,0,0,,Барлығы қауіпсіз сияқты.
Dialogue: 0,0:04:13.94,0:04:15.12,Default,,0,0,0,,Жақсы
Dialogue: 0,0:04:16.12,0:04:18.76,Default,,0,0,0,,Адамдарға зияны жоқ.
Dialogue: 0,0:04:19.88,0:04:22.92,Default,,0,0,0,,Мен адам саудасы туралы қауесетті естідім.
Dialogue: 0,0:04:22.92,0:04:25.76,Default,,0,0,0,,Дәлелдерді табу қиын болды.
Dialogue: 0,0:04:26.48,0:04:28.78,Default,,0,0,0,,Мен барлық қарақшыларға алғыс айтуым керек.
Dialogue: 0,0:04:29.12,0:04:30.16,Default,,0,0,0,,Алғыс айту
Dialogue: 0,0:04:30.56,0:04:33.08,Default,,0,0,0,,Бұл мәселені жауапсыз қалдырайық.
Dialogue: 0,0:04:35.16,0:04:37.84,Default,,0,0,0,,Янкумджидің орнына кім келеді?
Dialogue: 0,0:04:37.84,0:04:40.98,Default,,0,0,0,,Бұл кейінірек, астанаға оралғаннан кейін талқыланады.
Dialogue: 0,0:04:40.98,0:04:43.31,Default,,0,0,0,,Жетер ме, генерал дзюдо?
Dialogue: 0,0:04:44.12,0:04:45.26,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,0:04:45.92,0:04:47.94,Default,,0,0,0,,Сіз ашулысыз.
Dialogue: 0,0:04:58.64,0:05:01.82,Default,,0,0,0,,Мені өлтіргің келе ме?
Dialogue: 0,0:05:04.88,0:05:06.38,Default,,0,0,0,,Әрине.
Dialogue: 0,0:05:06.82,0:05:10.90,Default,,0,0,0,,Бірақ мен қазір өле алмаймын.
Dialogue: 0,0:05:12.94,0:05:16.88,Default,,0,0,0,,Өйткені менің бір ісім бар
Dialogue: 0,0:05:26.52,0:05:29.12,Default,,0,0,0,,Қош бол Жүніс
Dialogue: 0,0:06:21.98,0:06:23.06,Default,,0,0,0,,Ханшайым
Dialogue: 0,0:06:23.06,0:06:25.64,Default,,0,0,0,,Эй, не болды?
Dialogue: 0,0:06:39.74,0:06:41.58,Default,,0,0,0,,Бұл таңқаларлық жылдам болды.
Dialogue: 0,0:06:43.74,0:06:46.86,Default,,0,0,0,,Үйге түн батқанша жете алмаймын деп ойладым.
Dialogue: 0,0:06:46.86,0:06:50.34,Default,,0,0,0,,Жоқ, ренжімеңіз.
Dialogue: 0,0:06:50.34,0:06:54.24,Default,,0,0,0,,Сізде ойнауға уақыт жоқ шығар.
Dialogue: 0,0:06:54.24,0:06:57.14,Default,,0,0,0,,Таққа неге асыққаныңды ұмыттың ба?
Dialogue: 0,0:06:57.70,0:07:00.62,Default,,0,0,0,,Жоқ. Мен бір нәрсені ұмытып қалдым.
Dialogue: 0,0:07:00.96,0:07:05.00,Default,,0,0,0,,Алайда ұлы мәртебелілердің әйелдермен ойнауы сирек.
Dialogue: 0,0:07:05.00,0:07:09.04,Default,,0,0,0,,Қамалдағы әйелдерге ешкім назар аудармаса да.
Dialogue: 0,0:07:09.04,0:07:11.78,Default,,0,0,0,,Ол шынымен де жақсы болды ма?
Dialogue: 0,0:07:12.54,0:07:14.04,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:07:14.48,0:07:17.84,Default,,0,0,0,,Өте ұмытылмас адам.
Dialogue: 0,0:07:20.06,0:07:22.46,Default,,0,0,0,,Оның орнына асығыңыз.
Dialogue: 0,0:07:22.46,0:07:24.34,Default,,0,0,0,,Келесі қайда?
Dialogue: 0,0:07:24.34,0:07:26.46,Default,,0,0,0,,Жерді тегістеу аяқталды
Dialogue: 0,0:07:26.54,0:07:27.48,Default,,0,0,0,,Қайтару
Dialogue: 0,0:07:28.48,0:07:29.72,Default,,0,0,0,,Хирю қамалына
Dialogue: 0,0:07:34.12,0:07:36.31,Default,,0,0,0,,Қия, оян, оян.
Dialogue: 0,0:07:36.31,0:07:38.02,Default,,0,0,0,,Сіз қанша уақыт ұйықтайсыз?
Dialogue: 0,0:07:38.02,0:07:40.58,Default,,0,0,0,,Иә, мен бар күшімді саламын.
Dialogue: 0,0:07:42.16,0:07:44.04,Default,,0,0,0,,Біртүрлі бет
Dialogue: 0,0:07:45.14,0:07:47.64,Default,,0,0,0,,Ханшайым, қалыңыз қалай?
Dialogue: 0,0:07:48.46,0:07:51.12,Default,,0,0,0,,Әрине, мен жақсымын
Dialogue: 0,0:07:54.96,0:07:56.54,Default,,0,0,0,,Генки Генки
Dialogue: 0,0:07:57.62,0:07:58.56,Default,,0,0,0,,Юн
Dialogue: 0,0:07:58.56,0:08:00.04,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:08:00.04,0:08:01.42,Default,,0,0,0,,Абалон ботқасы
Dialogue: 0,0:08:01.42,0:08:04.16,Default,,0,0,0,,Алкогольді көп ішу - асқазанға ауыртпалық түсіреді.
Dialogue: 0,0:08:04.16,0:08:06.22,Default,,0,0,0,,Мен мұны арасына қояйын деп ойладым.
Dialogue: 0,0:08:07.50,0:08:08.92,Default,,0,0,0,,Дәмді көрінеді
Dialogue: 0,0:08:08.92,0:08:09.96,Default,,0,0,0,,Жақсы көрінеді.
Dialogue: 0,0:08:12.42,0:08:14.12,Default,,0,0,0,,Йона бәрібір
Dialogue: 0,0:08:14.86,0:08:16.50,Default,,0,0,0,,сабырлы және сабырлы
Dialogue: 0,0:08:16.64,0:08:18.72,Default,,0,0,0,,Бәріміз тамақтанайық
Dialogue: 0,0:08:19.04,0:08:21.04,Default,,0,0,0,,Тамақ? Бұл жолмен, бұл жолмен
Dialogue: 0,0:08:22.06,0:08:23.58,Default,,0,0,0,,Дәмді
Dialogue: 0,0:08:23.58,0:08:25.51,Default,,0,0,0,,Юн күткендей, сен данышпансың.
Dialogue: 0,0:08:25.51,0:08:28.25,Default,,0,0,0,,Йо, Йона Чан, төгіліп жатыр.
Dialogue: 0,0:08:28.25,0:08:30.68,Default,,0,0,0,,Не істеп жатырсың, қыз?
Dialogue: 0,0:08:30.68,0:08:31.82,Default,,0,0,0,,Осымен сүртіңіз
Dialogue: 0,0:08:33.62,0:08:36.04,Default,,0,0,0,,Йона Чан
Dialogue: 0,0:08:37.92,0:08:41.48,Default,,0,0,0,,Егер сіз киім ауыстырғыңыз келсе, капитан бөлмесін жалға алыңыз.
Dialogue: 0,0:08:42.88,0:08:43.86,Default,,0,0,0,,Хаку
Dialogue: 0,0:08:48.36,0:08:50.50,Default,,0,0,0,,Иә Қабылдау ақысы Сенгин
Dialogue: 0,0:08:51.12,0:08:53.18,Default,,0,0,0,,Қазіргі жағдай форс-мажорлық жағдай болып табылады.
Dialogue: 0,0:08:53.18,0:08:55.92,Default,,0,0,0,,Дәлірек айтсақ, жақсы жер еді.
Dialogue: 0,0:08:55.92,0:08:57.02,Default,,0,0,0,,Неге тоқтау керек...
Dialogue: 0,0:08:58.04,0:08:59.86,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:08:59.86,0:09:01.02,Default,,0,0,0,,Бөлек
Dialogue: 0,0:09:03.96,0:09:05.66,Default,,0,0,0,,Бұл тамаша қылыш.
Dialogue: 0,0:09:06.10,0:09:09.70,Default,,0,0,0,,Егер сіз осындай нәрсені алып жүрсеңіз, қала тұрғындары таң қалады.
Dialogue: 0,0:09:11.03,0:09:13.86,Default,,0,0,0,,Мен оны осы уақытқа дейін қалада алып жүрмеуге тырыстым.
Dialogue: 0,0:09:15.42,0:09:17.92,Default,,0,0,0,,Соңғы кездері мен тыныштық туралы аздап шатасып кеттім.
Dialogue: 0,0:09:18.18,0:09:19.54,Default,,0,0,0,,Өсиет
Dialogue: 0,0:09:20.62,0:09:22.02,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:09:22.02,0:09:25.96,Default,,0,0,0,,Осы таңға дейін ұрыс даласында жүрсеңіз де, өзіңізді тыныштықта сезіндіңіз бе?
Dialogue: 0,0:09:26.38,0:09:30.52,Default,,0,0,0,,Мен сол көзқарастың артындағы адамға қызығамын.
Dialogue: 0,0:09:32.30,0:09:33.80,Default,,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:09:34.70,0:09:36.68,Default,,0,0,0,,Адам өлтіру ниеті қандай өкінішті.
Dialogue: 0,0:09:46.44,0:09:47.36,Default,,0,0,0,,Көк
Dialogue: 0,0:10:03.30,0:10:06.12,Default,,0,0,0,,Маған Жүністің шашы ұнайды.
Dialogue: 0,0:10:06.60,0:10:10.36,Default,,0,0,0,,Әдемі қызыл, таң атқан аспанның түсі
Dialogue: 0,0:10:26.16,0:10:29.70,Default,,0,0,0,,Мен далаға шыққанда көп нәрсе болды.
Dialogue: 0,0:10:30.06,0:10:31.40,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:10:33.18,0:10:34.64,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:10:34.98,0:10:37.12,Default,,0,0,0,,Олар барлық жерде, солай емес пе?
Dialogue: 0,0:10:37.12,0:10:39.32,Default,,0,0,0,,Сіздің орныңызда
Dialogue: 0,0:10:39.76,0:10:42.94,Default,,0,0,0,,Бүгін таңертең мен сенен көзімді байқамай алып қалдым.
Dialogue: 0,0:10:43.26,0:10:48.12,Default,,0,0,0,,Ол менің ерекше күзетшім, сондықтан мен оның қасындамын.
Dialogue: 0,0:10:48.28,0:10:50.48,Default,,0,0,0,,Егер сізге бірдеңе керек болса, маған қоңырау шалыңыз.
Dialogue: 0,0:10:56.24,0:11:00.38,Default,,0,0,0,,Хаку, мен осы жерден кетемін.
Dialogue: 0,0:11:05.26,0:11:06.56,Default,,0,0,0,,Менімен бірге жүр
Dialogue: 0,0:11:08.64,0:11:09.80,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:16.62,0:11:18.44,Default,,0,0,0,,Барлығы не істеп жатыр?
Dialogue: 0,0:11:18.44,0:11:20.24,Default,,0,0,0,,Мен...
Dialogue: 0,0:11:20.24,0:11:24.02,Default,,0,0,0,,Әй, бұл туралы да айтып берші.
Dialogue: 0,0:11:24.55,0:11:25.84,Default,,0,0,0,,емес
Dialogue: 0,0:11:25.84,0:11:27.22,Default,,0,0,0,,Кету тарихы
Dialogue: 0,0:11:27.22,0:11:30.96,Default,,0,0,0,,Барлығы отырғанда олай айтпасаң, бітпейді.
Dialogue: 0,0:11:30.96,0:11:32.60,Default,,0,0,0,,Иә, ханшайым.
Dialogue: 0,0:11:32.60,0:11:37.10,Default,,0,0,0,,Біз, Төрт айдаһар, сенің бұйрығыңмен жердің шетіне келеміз.
Dialogue: 0,0:11:37.66,0:11:38.98,Default,,0,0,0,,Қазір үйге бара аласыз.
Dialogue: 0,0:11:38.98,0:11:40.10,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:11:40.10,0:11:43.12,Default,,0,0,0,,Біріншіден, біз тек екеуміз, Төрт айдаһар.
Dialogue: 0,0:11:43.12,0:11:44.16,Default,,0,0,0,,Шулы
Dialogue: 0,0:11:47.92,0:11:48.84,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:11:50.28,0:11:52.24,Default,,0,0,0,,Ертең Авадан шығу
Dialogue: 0,0:11:53.72,0:11:55.44,Default,,0,0,0,,Менімен бірге жүр
Dialogue: 0,0:11:57.82,0:11:58.98,Default,,0,0,0,,Мен сенімен бірге боламын
Dialogue: 0,0:12:00.70,0:12:01.76,Default,,0,0,0,,Бондман, мұндай қалай болды?
Dialogue: 0,0:12:15.54,0:12:18.41,Default,,0,0,0,,Ағаң сүйкімді екен, үйлен.
Dialogue: 0,0:12:18.41,0:12:21.08,Default,,0,0,0,,Баба үйлену тойы қазірдің өзінде...
Dialogue: 0,0:12:21.08,0:12:23.70,Default,,0,0,0,,Сүйкімді және бұлыңғыр
Dialogue: 0,0:12:39.44,0:12:40.94,Default,,0,0,0,,Жақсы үн
Dialogue: 0,0:12:42.42,0:12:43.54,Default,,0,0,0,,Тартып көріңіз
Dialogue: 0,0:12:49.92,0:12:52.52,Default,,0,0,0,,Қарақшылар жақсырақ болған сияқты.
Dialogue: 0,0:12:52.52,0:12:55.20,Default,,0,0,0,,Мен Кото мен Майды аздап істей аламын.
Dialogue: 0,0:12:55.20,0:12:57.00,Default,,0,0,0,,Котомен билеу
Dialogue: 0,0:12:57.80,0:12:59.66,Default,,0,0,0,,Джеха әлі күледі
Dialogue: 0,0:12:59.66,0:13:03.54,Default,,0,0,0,,Жоқ, сен қызсың деп ойлаймын.
Dialogue: 0,0:13:04.36,0:13:09.96,Default,,0,0,0,,Сен өте кішкентайсың, соншалықты қауіптісің, соншалықты күшсіз, сондай қиынсың.
Dialogue: 0,0:13:09.99,0:13:11.42,Default,,0,0,0,,Тіл нашар ма?
Dialogue: 0,0:13:11.42,0:13:14.92,Default,,0,0,0,,Одан да мені іздеп осы жерге кел.
Dialogue: 0,0:13:14.92,0:13:16.75,Default,,0,0,0,,Өте тітіркендіргіш
Dialogue: 0,0:13:17.38,0:13:18.98,Default,,0,0,0,,Қорықпа.
Dialogue: 0,0:13:18.98,0:13:22.46,Default,,0,0,0,,Мен Джэ Ханы енді күшпен алмаймын.
Dialogue: 0,0:13:22.46,0:13:23.58,Default,,0,0,0,,Олай болса
Dialogue: 0,0:13:28.54,0:13:30.70,Default,,0,0,0,,Мен Джэ Ханы түсінбеймін.
Dialogue: 0,0:13:30.70,0:13:33.68,Default,,0,0,0,,Мен өте адал адаммын.
Dialogue: 0,0:13:34.38,0:13:37.96,Default,,0,0,0,,Өйткені кеште сүйкімді қызбен бірге болғым келеді.
Dialogue: 0,0:13:46.54,0:13:48.41,Default,,0,0,0,,Тоқта, тоқта, Джэ-ха
Dialogue: 0,0:13:48.41,0:13:50.36,Default,,0,0,0,,Сол ән ұйқымды жібереді
Dialogue: 0,0:13:50.36,0:13:51.63,Default,,0,0,0,,Олай болса, ұйықтаңыз
Dialogue: 0,0:13:52.04,0:13:54.50,Default,,0,0,0,,Қала тұрғындарының көпшілігі ұйықтап жатыр.
Dialogue: 0,0:13:54.48,0:13:57.67,Default,,0,0,0,,Ұйқыға кетсем де ішіп-жемеймін.
Dialogue: 0,0:13:58.10,0:13:59.27,Default,,0,0,0,,Ха-ха-ха-ха! Бұл дәл сен сияқты, Лабраба.
Dialogue: 0,0:13:59.27,0:14:00.48,Default,,0,0,0,,Бесік жыры
Dialogue: 0,0:14:02.32,0:14:04.81,Default,,0,0,0,,Тоқта, ақымақ, ұйықтап қаласың.
Dialogue: 0,0:14:04.81,0:14:06.18,Default,,0,0,0,,Егер сіз ұйықтасаңыз
Dialogue: 0,0:14:06.18,0:14:08.22,Default,,0,0,0,,Мен ұйықтамаймын.
Dialogue: 0,0:14:08.22,0:14:11.50,Default,,0,0,0,,Сіз ұйықтай аласыз ба?
Dialogue: 0,0:14:11.50,0:14:14.74,Default,,0,0,0,,Мая, мас адамдарға қарамаймын.
Dialogue: 0,0:14:15.02,0:14:18.30,Default,,0,0,0,,Ұйықтасам түстен оянамын
Dialogue: 0,0:14:18.30,0:14:19.44,Default,,0,0,0,,Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады
Dialogue: 0,0:14:19.44,0:14:21.26,Default,,0,0,0,,Қарақшылар
Dialogue: 0,0:14:21.26,0:14:24.96,Default,,0,0,0,,Бүгінгі түн біздің қарақшылар ретіндегі соңғы түніміз.
Dialogue: 0,0:14:25.46,0:14:26.52,Default,,0,0,0,,Сонымен
Dialogue: 0,0:14:26.52,0:14:28.14,Default,,0,0,0,,Бұл ақымақтық
Dialogue: 0,0:14:28.14,0:14:32.46,Default,,0,0,0,,Олар енді қарақшылар болмаса да, Авада балықшы болады.
Dialogue: 0,0:14:32.46,0:14:35.07,Default,,0,0,0,,Сонда бұрынғыдан ештеңе өзгермейді...
Dialogue: 0,0:14:35.07,0:14:36.74,Default,,0,0,0,,Сіз жоқ боласыз
Dialogue: 0,0:14:36.74,0:14:40.32,Default,,0,0,0,,Менің ойымша, ол Аваны қыздармен қалдырады.
Dialogue: 0,0:14:43.04,0:14:44.62,Default,,0,0,0,,Бесік жыры
Dialogue: 0,0:14:46.30,0:14:49.98,Default,,0,0,0,,Джеха мен сені өлтіргім келеді
Dialogue: 0,0:14:51.50,0:14:53.04,Default,,0,0,0,,Бұл тітіркендіргіш.
Dialogue: 0,0:14:53.04,0:14:58.78,Default,,0,0,0,,Мен сені жақсы көремін...
Dialogue: 0,0:15:07.16,0:15:09.76,Default,,0,0,0,,Бірге болатын әдемі адам
Dialogue: 0,0:15:09.76,0:15:12.28,Default,,0,0,0,,Шаршаған, жүйрік бала
Dialogue: 0,0:15:12.28,0:15:16.41,Default,,0,0,0,,Қашан естісем де, жансызданамын. Капитанның улы тілі
Dialogue: 0,0:15:17.32,0:15:20.26,Default,,0,0,0,,Капитан – менің идеал әйелім.
Dialogue: 0,0:15:20.26,0:15:23.24,Default,,0,0,0,,Егер мен елу жыл бұрын туылған болсам...
Dialogue: 0,0:15:23.24,0:15:25.58,Default,,0,0,0,,Кумжиден келген жебе қай жерде?
Dialogue: 0,0:15:25.58,0:15:27.88,Default,,0,0,0,,Мені елу жыл мазалады.
Dialogue: 0,0:15:30.00,0:15:33.34,Default,,0,0,0,,Мен мұны басқа жерде әйелге барғалы жатқанда жиі айтамын.
Dialogue: 0,0:15:33.34,0:15:35.86,Default,,0,0,0,,Эй, мен саған пісіріп берейін.
Dialogue: 0,0:15:36.62,0:15:39.66,Default,,0,0,0,,Сіз бұл қыздың кім екенін білесіз бе?
Dialogue: 0,0:15:39.66,0:15:42.52,Default,,0,0,0,,Әйтеуір.
Dialogue: 0,0:15:42.52,0:15:46.06,Default,,0,0,0,,Ол қыздың артынан жүру қиын.
Dialogue: 0,0:15:46.06,0:15:48.34,Default,,0,0,0,,Бұл Айдаһар жарлығы ма?
Dialogue: 0,0:15:48.34,0:15:49.90,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:15:49.90,0:15:55.86,Default,,0,0,0,,Алайда, сен көз алдында тұрмасаң, мен тыныштала алмаймын.
Dialogue: 0,0:15:55.86,0:15:59.92,Default,,0,0,0,,Иә, күшім жоқ болса да
Dialogue: 0,0:15:59.92,0:16:03.18,Default,,0,0,0,,Жылап алға жылжып, арқама сүйенбеймін.
Dialogue: 0,0:16:03.74,0:16:07.58,Default,,0,0,0,,Әйтсе де, мен сол жарқырауға жұтылып кететін сияқтымын.
Dialogue: 0,0:16:08.64,0:16:12.02,Default,,0,0,0,,Оның әлгі жебені атып жатқанын көргенде қызық болды.
Dialogue: 0,0:16:12.48,0:16:15.28,Default,,0,0,0,,Оққа ұшқан Кумжиді аздап қызғандым.
Dialogue: 0,0:16:15.28,0:16:17.82,Default,,0,0,0,,Екеуміз жақсы аралассақ жақсы болар еді.
Dialogue: 0,0:16:18.36,0:16:21.68,Default,,0,0,0,,Сен сияқты азғындар жай ғана кетсін.
Dialogue: 0,0:16:21.68,0:16:24.18,Default,,0,0,0,,Ешқашан қайтып келме
Dialogue: 0,0:16:24.18,0:16:26.06,Default,,0,0,0,,Мен жалықтым.
Dialogue: 0,0:16:26.06,0:16:30.90,Default,,0,0,0,,Үйің әрқашан осында болады деп айтпайсың ба?
Dialogue: 0,0:16:31.66,0:16:33.58,Default,,0,0,0,,Айтқым келсе
Dialogue: 0,0:16:33.58,0:16:39.20,Default,,0,0,0,,Мені құлататын тым болмаса біреуін алып кетші, Ханатаре баласы.
Dialogue: 0,0:16:40.72,0:16:43.66,Default,,0,0,0,,Сен неге аспаннан құлап жатырсың?
Dialogue: 0,0:16:44.28,0:16:47.04,Default,,0,0,0,,Мен сен үшін бәрін істеймін, мені жайына қалдыр.
Dialogue: 0,0:16:47.04,0:16:49.32,Default,,0,0,0,,Бұл ақымақ Ханатаре.
Dialogue: 0,0:16:49.32,0:16:52.04,Default,,0,0,0,,Әйелді қалай баурап алуды білмейсің бе?
Dialogue: 0,0:17:04.24,0:17:07.04,Default,,0,0,0,,Сен кеттің бе, Йона-чан?
Dialogue: 0,0:17:07.04,0:17:08.54,Default,,0,0,0,,Монах, тағы кел.
Dialogue: 0,0:17:08.54,0:17:11.02,Default,,0,0,0,,Міндетті түрде кел, өлсең де кел
Dialogue: 0,0:17:11.02,0:17:12.38,Default,,0,0,0,,Ауырды
Dialogue: 0,0:17:15.10,0:17:16.42,Default,,0,0,0,,Не болды?
Dialogue: 0,0:17:16.42,0:17:18.26,Default,,0,0,0,,Джэ-ха жоғалып кетті.
Dialogue: 0,0:17:18.26,0:17:21.08,Default,,0,0,0,,Рахмет сияқты айтқым келген нәрселер көп болды.
Dialogue: 0,0:17:21.08,0:17:23.34,Default,,0,0,0,,Ештеңе етпейді, сол салбыраған көздері.
Dialogue: 0,0:17:23.34,0:17:24.54,Default,,0,0,0,,Жақсы емес
Dialogue: 0,0:17:24.54,0:17:26.64,Default,,0,0,0,,Мен бұлай қоштаса алмаймын
Dialogue: 0,0:17:26.64,0:17:28.18,Default,,0,0,0,,Джехане
Dialogue: 0,0:17:28.30,0:17:31.32,Default,,0,0,0,,Бір күні осында тағы келсем, сені тағы көремін.
Dialogue: 0,0:17:31.32,0:17:32.74,Default,,0,0,0,,Иә
Dialogue: 0,0:17:32.74,0:17:35.14,Default,,0,0,0,,Сізде кеме болған кезде айтыңыз.
Dialogue: 0,0:17:35.14,0:17:37.02,Default,,0,0,0,,Мен кез келген уақытта дайын боламын.
Dialogue: 0,0:17:37.02,0:17:38.72,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:39.32,0:17:42.14,Default,,0,0,0,,Бетіңіздегі ісік әлі басылған жоқ.
Dialogue: 0,0:17:42.14,0:17:43.30,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:17:43.82,0:17:46.82,Default,,0,0,0,,Арық қыз қайратты болып кетті ғой?
Dialogue: 0,0:17:46.82,0:17:48.60,Default,,0,0,0,,пысық қыз
Dialogue: 0,0:17:48.60,0:17:53.06,Default,,0,0,0,,Ешбір тазалауды, жууды немесе дұрыс тамақ пісіруді орындай алмасам да.
Dialogue: 0,0:17:53.06,0:17:54.94,Default,,0,0,0,,Бұл әйелдің талғамы.
Dialogue: 0,0:17:54.94,0:17:56.62,Default,,0,0,0,,Тез үйреніңіз
Dialogue: 0,0:17:59.00,0:18:03.60,Default,,0,0,0,,Сенің қолыңнан келмейтін нәрсе – немқұрайлылық.
Dialogue: 0,0:18:03.60,0:18:05.66,Default,,0,0,0,,Қосымша күтім
Dialogue: 0,0:18:05.66,0:18:07.36,Default,,0,0,0,,Мәселе жоқ.
Dialogue: 0,0:18:07.36,0:18:12.12,Default,,0,0,0,,Таудағы шөп шабып жүргенімде маған кір жуатын күйеу табылса.
Dialogue: 0,0:18:12.12,0:18:13.86,Default,,0,0,0,,Хаку, үндеме
Dialogue: 0,0:18:13.86,0:18:18.26,Default,,0,0,0,,Мисс, Ава асханасы балық піскенше жақсы.
Dialogue: 0,0:18:18.26,0:18:19.76,Default,,0,0,0,,Және сашими
Dialogue: 0,0:18:19.76,0:18:22.76,Default,,0,0,0,,Әй, маған үйленбейтін болсаң, менімен жүр.
Dialogue: 0,0:18:22.76,0:18:23.98,Default,,0,0,0,,Мен бармаймын.
Dialogue: 0,0:18:25.32,0:18:27.32,Default,,0,0,0,,Қазір бәрі дөрекі.
Dialogue: 0,0:18:27.32,0:18:28.54,Default,,0,0,0,,Кету
Dialogue: 0,0:18:28.54,0:18:30.00,Default,,0,0,0,,Күтіңіз
Dialogue: 0,0:18:31.38,0:18:32.56,Default,,0,0,0,,Оны өзіңізбен бірге алыңыз.
Dialogue: 0,0:18:33.30,0:18:36.06,Default,,0,0,0,,О, Чиджукуса, бұл пайдалы.
Dialogue: 0,0:18:36.06,0:18:37.62,Default,,0,0,0,,Көп
Dialogue: 0,0:18:40.28,0:18:42.36,Default,,0,0,0,,Суық тигізбе
Dialogue: 0,0:18:45.18,0:18:48.62,Default,,0,0,0,,Капитанның анасына ұқсайды
Dialogue: 0,0:18:49.14,0:18:51.88,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:18:55.38,0:18:56.92,Default,,0,0,0,,Сау болыңыз.
Dialogue: 0,0:18:56.92,0:18:58.38,Default,,0,0,0,,Бізге әлі келіңіз.
Dialogue: 0,0:18:58.38,0:18:59.97,Default,,0,0,0,,Мен сені күтемін, балам.
Dialogue: 0,0:18:59.97,0:19:01.24,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:19:08.32,0:19:09.20,Default,,0,0,0,,Жүніс
Dialogue: 0,0:19:27.66,0:19:29.28,Default,,0,0,0,,(Полиция қызметкері) Бізді сатқанымен, олар біздің одақтастарымызға айналды деген сөз емес
Dialogue: 0,0:19:29.72,0:19:32.26,Default,,0,0,0,,Енді бұл балықшының жұмысы.
Dialogue: 0,0:19:32.48,0:19:36.18,Default,,0,0,0,,Бұл қыз қарақшылар тобының мүшесі емес пе еді?
Dialogue: 0,0:19:36.18,0:19:38.74,Default,,0,0,0,,Қарақшыға айналу сүйкімді.
Dialogue: 0,0:19:38.74,0:19:43.74,Default,,0,0,0,,О, ол сүйкімді көрінеді, бірақ ол қарапайым жауынгерден күшті.
Dialogue: 0,0:19:43.74,0:19:46.30,Default,,0,0,0,,Сен сол Кумуджиді өлтірдің ғой.
Dialogue: 0,0:19:47.58,0:19:49.74,Default,,0,0,0,,Сол қыз маған Кумжиді берді.
Dialogue: 0,0:19:49.74,0:19:51.82,Default,,0,0,0,,Бұл өте керемет болды.
Dialogue: 0,0:19:52.62,0:19:54.14,Default,,0,0,0,,Сол бала.
Dialogue: 0,0:19:54.14,0:19:55.88,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:20:00.98,0:20:03.37,Default,,0,0,0,,Жүніс, енді жылауыңды доғар.
Dialogue: 0,0:20:04.02,0:20:06.00,Default,,0,0,0,,Сен де жылап тұрсың, Юн.
Dialogue: 0,0:20:06.94,0:20:09.86,Default,,0,0,0,,Ең көп жылайтын – Хатемеда Ақ жылан.
Dialogue: 0,0:20:11.06,0:20:14.82,Default,,0,0,0,,Соңында мен Джэ-хамен қоштаса алмадым.
Dialogue: 0,0:20:14.82,0:20:18.96,Default,,0,0,0,,Jeha Isn't he a friend?
Dialogue: 0,0:20:26.88,0:20:27.92,Default,,0,0,0,,Иеха
Dialogue: 0,0:20:28.88,0:20:29.92,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:20:29.92,0:20:33.14,Default,,0,0,0,,Green Dragon was always nearby
Dialogue: 0,0:20:33.14,0:20:36.10,Default,,0,0,0,,Жоқ, менің бос уақытым бар.
Dialogue: 0,0:20:36.10,0:20:40.28,Default,,0,0,0,,Мен Йонамен саяхаттау жаман идея емес деп ойладым.
Dialogue: 0,0:20:41.16,0:20:46.06,Default,,0,0,0,,Мен сені іздеп, жылай жаздадым.
Dialogue: 0,0:20:46.06,0:20:49.66,Default,,0,0,0,,Жаңа ғана толқығаным сонша, шыдай алмадым.
Dialogue: 0,0:20:49.66,0:20:52.66,Default,,0,0,0,,Мен сізге қоңырау шалу мүмкіндігін жіберіп алдым.
Dialogue: 0,0:20:52.66,0:20:54.54,Default,,0,0,0,,You're still a pervert.
Dialogue: 0,0:20:54.54,0:20:57.17,Default,,0,0,0,,Мен найзағайдың иісін сеземін
Dialogue: 0,0:20:57.74,0:21:02.58,Default,,0,0,0,,Бірақ мен төрт айдаһардың ережелеріне байланғанды ұнатпаймын.
Dialogue: 0,0:21:02.58,0:21:05.30,Default,,0,0,0,,Төрт айдаһардың бұған қатысы жоқ.
Dialogue: 0,0:21:05.30,0:21:07.18,Default,,0,0,0,,Now and in the future
Dialogue: 0,0:21:07.18,0:21:10.34,Default,,0,0,0,,Just follow the path you choose
Dialogue: 0,0:21:10.34,0:21:13.16,Default,,0,0,0,,Менің эстетикама ешнәрсе қарсы келмейді.
Dialogue: 0,0:21:13.78,0:21:17.50,Default,,0,0,0,,Мен сені дәл қазір жалғыз қалдыра алмаймын.
Dialogue: 0,0:21:22.88,0:21:24.86,Default,,0,0,0,,Мені ал, Жүніс.
Dialogue: 0,0:21:28.20,0:21:30.82,Default,,0,0,0,,Өзіңізді жақсы істеп жатырмын деп көрсетпеңіз.
Dialogue: 0,0:21:30.82,0:21:31.88,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:21:31.88,0:21:34.12,Default,,0,0,0,,It's not just a trip with Jonah.
Dialogue: 0,0:21:34.12,0:21:36.48,Default,,0,0,0,,You have to greet us too.
Dialogue: 0,0:21:36.96,0:21:38.30,Default,,0,0,0,,бұл дұрыс
Dialogue: 0,0:21:38.30,0:21:40.96,Default,,0,0,0,,Біз мәдениетті бағалаймыз
Dialogue: 0,0:21:41.10,0:21:42.54,Default,,0,0,0,,Жасыл айдаһар
Dialogue: 0,0:21:42.54,0:21:44.22,Default,,0,0,0,,Бұл дөрекі
Dialogue: 0,0:21:44.22,0:21:46.26,Default,,0,0,0,,Тағы да
Dialogue: 0,0:21:47.22,0:21:48.82,Default,,0,0,0,,Менің атым Джеха
Dialogue: 0,0:21:49.24,0:21:52.76,Default,,0,0,0,,Бұл оң аяғында айдаһар бар әдемі құбыжық.
Dialogue: 0,0:21:53.32,0:21:54.82,Default,,0,0,0,,Ізгі ниетпен
Dialogue: 0,0:23:27.32,0:23:29.00,Default,,0,0,0,,Кешіріңіз Хаку
Dialogue: 0,0:23:29.58,0:23:33.74,Default,,0,0,0,,Жаңбыр басылғанда, қылышымды қайта аламын.
Dialogue: 0,0:23:34.46,0:23:38.40,Default,,0,0,0,,Келесі жолы «Таң таңындағы Йона» 24-бөлім
Dialogue: 0,0:23:38.40,0:23:39.84,Default,,0,0,0,,Бұдан былай
Dialogue: 0,0:23:41.34,0:23:46.34,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
