Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:19.73,0:00:21.46,Default,,0,0,0,,Сіз үзіліс жасағыңыз келе ме?
Dialogue: 0,0:00:43.04,0:00:44.68,Default,,0,0,0,,Мен оны көптен бері көрдім
Dialogue: 0,0:00:45.91,0:00:49.36,Default,,0,0,0,,Ол кірді де, ауруды да білмейтін ханшайым еді.
Dialogue: 0,0:02:21.62,0:02:23.12,Default,,0,0,0,,Кішкентай бала
Dialogue: 0,0:02:23.49,0:02:27.33,Default,,0,0,0,,Бүгінгі бес рудың жиыны, мен саған да кел дедім.
Dialogue: 0,0:02:27.66,0:02:31.39,Default,,0,0,0,,Жиналыс болса, тек Мундоку-сама ғана қатысса жақсы болар еді.
Dialogue: 0,0:02:31.87,0:02:35.06,Default,,0,0,0,,Ал мен ұлы мәртебелі Ильдің әңгімесін айта аламын, ол толық ...
Dialogue: 0,0:02:35.08,0:02:36.09,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:02:36.57,0:02:39.05,Default,,0,0,0,,Мені Мундоку-сама емес, ата деп атаңыз.
Dialogue: 0,0:02:39.05,0:02:40.34,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:02:40.34,0:02:42.42,Default,,0,0,0,,Сіз екеуміз қандас емеспіз ғой?
Dialogue: 0,0:02:42.42,0:02:46.10,Default,,0,0,0,,Қанда не болды? Ол махаббат алдында дәрменсіз.
Dialogue: 0,0:02:46.10,0:02:47.43,Default,,0,0,0,,Мұнда
Dialogue: 0,0:02:47.90,0:02:52.48,Default,,0,0,0,,Егер генерал Мундоку мен Хаку шабуылға шықса, Хирю сарайы ұшып кетеді.
Dialogue: 0,0:02:53.20,0:02:54.55,Default,,0,0,0,,Бұл Мәртебелі Иль.
Dialogue: 0,0:02:55.24,0:02:56.48,Default,,0,0,0,,(Косей) Сен балалармен тез тіл табысасың ғой, иә?
Dialogue: 0,0:02:56.56,0:02:58.90,Default,,0,0,0,,Жоқ, мен «Пён» деген сияқты бірдеңе дедім.
Dialogue: 0,0:02:59.83,0:03:01.72,Default,,0,0,0,,Біраз уақыт болды, Хаку.
Dialogue: 0,0:03:02.01,0:03:05.18,Default,,0,0,0,,Мен көрген ойындарға келмей жүргеніңді сағындым.
Dialogue: 0,0:03:05.36,0:03:08.41,Default,,0,0,0,,Жоқ, мен сияқты қарапайым адам оңай алады
Dialogue: 0,0:03:08.64,0:03:10.39,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:03:10.81,0:03:13.22,Default,,0,0,0,,Йона да Хаксыз өзін жалғыз сезінеді.
Dialogue: 0,0:03:14.65,0:03:16.04,Default,,0,0,0,,Мына Поён өтірікші
Dialogue: 0,0:03:16.65,0:03:17.67,Default,,0,0,0,,Поён?
Dialogue: 0,0:03:19.08,0:03:21.13,Default,,0,0,0,,Поён дегеніміз не?
Dialogue: 0,0:03:21.24,0:03:23.70,Default,,0,0,0,,Зорлық-зомбылық жоқ, Мундоку
Dialogue: 0,0:03:25.44,0:03:29.60,Default,,0,0,0,,Маған Хакудың шынайылығы ұнайды.
Dialogue: 0,0:03:30.02,0:03:31.65,Default,,0,0,0,,Мен саған буға пісірілген тоқаш беремін.
Dialogue: 0,0:03:33.21,0:03:37.76,Default,,0,0,0,,Сонымен, Хаку, сен Йонаның күзетшісі ретінде сарайда қала ма?
Dialogue: 0,0:03:38.39,0:03:39.21,Default,,0,0,0,,Мәртебелі
Dialogue: 0,0:03:40.26,0:03:43.26,Default,,0,0,0,,Асыл болудың қиын екенін білмеймін.
Dialogue: 0,0:03:43.92,0:03:46.35,Default,,0,0,0,,Егер сіз сарайға кірсеңіз немесе генерал болсаңыз
Dialogue: 0,0:03:46.50,0:03:48.61,Default,,0,0,0,,Мен үйде тыныш ұйықтай алмаймын.
Dialogue: 0,0:03:48.74,0:03:49.44,Default,,0,0,0,,Хаку
Dialogue: 0,0:03:49.90,0:03:52.06,Default,,0,0,0,,Мәртебелі қаруды ұнатпайтын шығар.
Dialogue: 0,0:03:52.62,0:03:58.39,Default,,0,0,0,,Олай болса, қарусыз адамдарды қорғайтын құнды адамды тауып беріңізші.
Dialogue: 0,0:03:59.31,0:04:00.22,Default,,0,0,0,,Хаку
Dialogue: 0,0:04:02.31,0:04:06.30,Default,,0,0,0,,Шынымды айтсам, мен патша әулетімен де, ақсүйектермен де араласқым келмейді.
Dialogue: 0,0:04:06.30,0:04:09.71,Default,,0,0,0,,Бірінің ішін ақтарып, бірінің аяғын сүйреу – бос сөз.
Dialogue: 0,0:04:10.37,0:04:12.75,Default,,0,0,0,,Патша - патша және дағдарыс сезімі жоқ.
Dialogue: 0,0:04:13.28,0:04:17.03,Default,,0,0,0,,Менің бұл сарайға келгім келмейтін тағы бір себеп
Dialogue: 0,0:04:17.16,0:04:17.83,Default,,0,0,0,,Хаку
Dialogue: 0,0:04:20.24,0:04:21.16,Default,,0,0,0,,Жасырын
Dialogue: 0,0:04:22.91,0:04:27.33,Default,,0,0,0,,Осы ханшайымның қасында жүргенде, мен жынды болмаймын.
Dialogue: 0,0:04:28.65,0:04:32.14,Default,,0,0,0,,Йона ханшайым қайда?
Dialogue: 0,0:04:32.34,0:04:33.48,Default,,0,0,0,,Йона ханшайым
Dialogue: 0,0:04:34.16,0:04:35.83,Default,,0,0,0,,Жоқ, Йона ханшайым.
Dialogue: 0,0:04:36.40,0:04:38.29,Default,,0,0,0,,Еркелік ашылмауы керек.
Dialogue: 0,0:04:38.44,0:04:39.42,Default,,0,0,0,,Қандай қатыгез қимыл…
Dialogue: 0,0:04:41.63,0:04:42.70,Default,,0,0,0,,Әдептілік
Dialogue: 0,0:04:47.03,0:04:48.41,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:04:48.98,0:04:50.92,Default,,0,0,0,,Сол адам Кан Тэ Джун деп атады
Dialogue: 0,0:04:51.10,0:04:55.50,Default,,0,0,0,,Ол сарайға жиі келіп, маған сыйлықтар беріп, ойнауға шақырады.
Dialogue: 0,0:04:52.39,0:04:55.50,Default,,0,0,0,,Ханшайым, ойнайық
Dialogue: 0,0:04:57.24,0:04:59.17,Default,,0,0,0,,От руының ұлы.
Dialogue: 0,0:04:59.68,0:05:01.24,Default,,0,0,0,,Ол шынымен де табанды.
Dialogue: 0,0:05:01.93,0:05:04.13,Default,,0,0,0,,Жай ғана айтқан дұрыс емес пе?
Dialogue: 0,0:05:04.13,0:05:07.88,Default,,0,0,0,,Менің жүрегімде Су Вон есімді адам бар.
Dialogue: 0,0:05:10.24,0:05:12.83,Default,,0,0,0,,Өйткені бұл жауапсыз махаббат
Dialogue: 0,0:05:13.04,0:05:16.26,Default,,0,0,0,,Соны айтсаң Сувон да естиді.
Dialogue: 0,0:05:17.07,0:05:18.67,Default,,0,0,0,,Бұл мен білетін нәрсе емес.
Dialogue: 0,0:05:18.88,0:05:20.86,Default,,0,0,0,,Ауырсыну сияқты дыбыс шығармаңыз
Dialogue: 0,0:05:22.55,0:05:24.57,Default,,0,0,0,,Сондықтан мен сарайға келгенді ұнатпаймын.
Dialogue: 0,0:05:25.37,0:05:28.93,Default,,0,0,0,,Сонымен, сіз Кан Тэ Джун мырзамен жақсы араласасыз.
Dialogue: 0,0:05:30.37,0:05:32.03,Default,,0,0,0,,Хаку суық
Dialogue: 0,0:05:32.86,0:05:35.22,Default,,0,0,0,,Су Вон мұндайды ешқашан айтпайды.
Dialogue: 0,0:05:36.21,0:05:40.36,Default,,0,0,0,,Егер солай болса, мені қорғау үшін Су Вон-Самаға жылап жібере аламын деп ойлаймын.
Dialogue: 0,0:05:48.15,0:05:51.92,Default,,0,0,0,,Тезірек тайпаның сарайына оралайық, генерал Мундоку.
Dialogue: 0,0:05:52.10,0:05:54.19,Default,,0,0,0,,Сіз не нәрсеге ренжідіңіз?
Dialogue: 0,0:05:54.23,0:05:56.48,Default,,0,0,0,,Ал мені ата деп атаңыз
Dialogue: 0,0:05:57.05,0:05:58.98,Default,,0,0,0,,Ашуланбаңыз.
Dialogue: 0,0:05:59.54,0:06:01.36,Default,,0,0,0,,Бұл тітіркендіргіш.
Dialogue: 0,0:06:06.05,0:06:07.11,Default,,0,0,0,,Йона ханшайым
Dialogue: 0,0:06:07.54,0:06:08.49,Default,,0,0,0,,Неліктен мұнда?
Dialogue: 0,0:06:11.75,0:06:13.32,Default,,0,0,0,,Күндізгі уақыт үшін кешіріңіз
Dialogue: 0,0:06:13.93,0:06:16.38,Default,,0,0,0,,Менің түкке тұрғысыз болғаным үшін ашуландыңыз деп ойлаймын.
Dialogue: 0,0:06:18.38,0:06:21.38,Default,,0,0,0,,Мен Қоқанның мақтаншақ ханшайымымын.
Dialogue: 0,0:06:21.54,0:06:24.30,Default,,0,0,0,,Шағымдамаңыз, өзіңіз бірдеңе жасауға тырысыңыз
Dialogue: 0,0:06:24.97,0:06:25.75,Default,,0,0,0,,Джейн
Dialogue: 0,0:06:28.34,0:06:29.35,Default,,0,0,0,,Мен оны саған беремін
Dialogue: 0,0:06:29.72,0:06:31.52,Default,,0,0,0,,Өтеу үшін пара.
Dialogue: 0,0:06:37.06,0:06:40.91,Default,,0,0,0,,Сондықтан мен ханшайыммен ештеңе істегім келмейді.
Dialogue: 0,0:06:43.59,0:06:48.94,Default,,0,0,0,,Іс осылай жалғаса берсе, рулардың күші артып, патшаның күші төмендейді.
Dialogue: 0,0:06:49.32,0:06:52.91,Default,,0,0,0,,Бұл елді осындай қорқақ патшаға тапсыруға бола ма?
Dialogue: 0,0:06:53.05,0:06:54.75,Default,,0,0,0,,Айтылып жатыр Айтылып жатыр
Dialogue: 0,0:06:55.35,0:06:58.13,Default,,0,0,0,,Таңқаларлық емес, бұл патша.
Dialogue: 0,0:06:59.24,0:07:04.63,Default,,0,0,0,,Егер мен атамның орнын басып, генерал болсам, патша иті боламын...
Dialogue: 0,0:07:05.06,0:07:09.32,Default,,0,0,0,,Хаку, сен Йонаның күзетшісі ретінде сарайда қала ма?
Dialogue: 0,0:07:10.27,0:07:13.60,Default,,0,0,0,,Тоқтағаныңыз жөн болар, Мәртебелі. мен...
Dialogue: 0,0:07:13.65,0:07:14.56,Default,,0,0,0,,(Мектеп оқушысы) Ой, Хори ханым саған бұны өзі жасап берді ме? Өте сүйкімді екен~
Dialogue: 0,0:07:15.77,0:07:18.33,Default,,0,0,0,,Мен сенімен виллаға бармаймын.
Dialogue: 0,0:07:18.47,0:07:20.38,Default,,0,0,0,,Қызықсыз нәрселерді айтпаңыз
Dialogue: 0,0:07:20.55,0:07:22.08,Default,,0,0,0,,Мен сізге жол көрсетейін бе?
Dialogue: 0,0:07:22.62,0:07:23.46,Default,,0,0,0,,Сен сияқты біреуге уақытымды босқа жұмсауға уақытым жоқ.
Dialogue: 0,0:07:23.91,0:07:25.08,Default,,0,0,0,,Уау
Dialogue: 0,0:07:25.45,0:07:27.11,Default,,0,0,0,,Мен Су Вонның осында болғанын қалаймын
Dialogue: 0,0:07:27.57,0:07:28.84,Default,,0,0,0,,Біреу тоқтатсын!
Dialogue: 0,0:07:28.95,0:07:31.44,Default,,0,0,0,,Бірақ ол генерал Кангтың ұлы.
Dialogue: 0,0:07:31.44,0:07:32.78,Default,,0,0,0,,Егер сіз бірдеңе дұрыс емес жасасаңыз...
Dialogue: 0,0:07:32.96,0:07:34.85,Default,,0,0,0,,Содан кейін ұлы мәртебеліге қоңырау шалыңыз.
Dialogue: 0,0:07:35.39,0:07:38.74,Default,,0,0,0,,Дворяндар – нағыз қиыншылық туғызатын тіршілік иелері.
Dialogue: 0,0:07:39.32,0:07:41.34,Default,,0,0,0,,Қатыспа, мені қалдыр
Dialogue: 0,0:07:41.75,0:07:44.42,Default,,0,0,0,,Әйтпесе, мен мәңгілік боламын...
Dialogue: 0,0:07:45.57,0:07:46.58,Default,,0,0,0,,Сен сияқты біреуге уақытымды босқа жұмсауға уақытым жоқ.
Dialogue: 0,0:07:46.93,0:07:48.62,Default,,0,0,0,,Қазір кетейін.
Dialogue: 0,0:07:47.10,0:07:49.08,Default,,0,0,0,,Бұл өте сүйкімді көрінеді.
Dialogue: 0,0:07:49.60,0:07:55.22,Default,,0,0,0,,Котенканың күшімен қарсылық танытсам, саған одан бетер қол тигізгім келеді.
Dialogue: 0,0:07:55.82,0:07:56.95,Default,,0,0,0,,Уайымдама...
Dialogue: 0,0:07:57.10,0:08:00.20,Default,,0,0,0,,Жалқау болма, Кан Тэ Джун.
Dialogue: 0,0:07:59.58,0:08:00.85,Default,,0,0,0,,Итататата
Dialogue: 0,0:08:01.52,0:08:02.26,Default,,0,0,0,,Хаку
Dialogue: 0,0:08:04.39,0:08:05.38,Default,,0,0,0,,Дөрекі адам
Dialogue: 0,0:08:05.63,0:08:07.28,Default,,0,0,0,,Ханшайымды абайсызда ұстау, т.б.
Dialogue: 0,0:08:07.40,0:08:11.74,Default,,0,0,0,,Менің ханшайымыма тиісуге кімнің рұқсаты бар?
Dialogue: 0,0:08:12.26,0:08:12.78,Default,,0,0,0,,Менікі ме?
Dialogue: 0,0:08:13.38,0:08:14.06,Default,,0,0,0,,Кімнің?
Dialogue: 0,0:08:14.41,0:08:16.53,Default,,0,0,0,,Балалар сендерге қалдырсын.
Dialogue: 0,0:08:16.53,0:08:18.19,Default,,0,0,0,,Өтірік емес
Dialogue: 0,0:08:18.19,0:08:22.09,Default,,0,0,0,,Ханшайым екеуміз бала кезімізден доспыз, болашағымызға бірге кепілдік береміз.
Dialogue: 0,0:08:22.22,0:08:23.68,Default,,0,0,0,,Сәлем ханшайым
Dialogue: 0,0:08:23.98,0:08:26.37,Default,,0,0,0,,Ханшайым, бұлай ұялшақ болудың қажеті жоқ.
Dialogue: 0,0:08:26.65,0:08:29.01,Default,,0,0,0,,Хо хо хо Маған көпшілік алдында ұнамайды.
Dialogue: 0,0:08:29.49,0:08:33.40,Default,,0,0,0,,Ханшайым оны шынымен ұната ма?
Dialogue: 0,0:08:36.65,0:08:38.34,Default,,0,0,0,,Мен оны жақсы көретін сияқтымын
Dialogue: 0,0:08:40.12,0:08:41.37,Default,,0,0,0,,Қабылдамау...
Dialogue: 0,0:08:41.80,0:08:44.69,Default,,0,0,0,,Сен сияқты біреу ханшайымға болашағыңды кепілге береді.
Dialogue: 0,0:08:44.88,0:08:49.18,Default,,0,0,0,,Мен От тайпасының басшысы Кан Тэ Джун генерал Канның екінші ұлы боламын.
Dialogue: 0,0:08:49.35,0:08:51.30,Default,,0,0,0,,Сіз қайда және кімсіз?
Dialogue: 0,0:08:52.02,0:08:55.38,Default,,0,0,0,,Мен жел тайпасының келесі генералы Сонхакпын.
Dialogue: 0,0:08:55.94,0:09:00.20,Default,,0,0,0,,Мәртебелі Йона ханшайымның эксклюзивті сүйемелдеушісі болуды жеке өзі бұйырған адам.
Dialogue: 0,0:09:01.26,0:09:02.29,Default,,0,0,0,,Қарсылық бар ма?
Dialogue: 0,0:09:03.52,0:09:06.09,Default,,0,0,0,,Олай болса, қабілеттеріңді көрсетіңдер.
Dialogue: 0,0:09:07.81,0:09:08.59,Default,,0,0,0,,Мәртебелі
Dialogue: 0,0:09:09.34,0:09:10.55,Default,,0,0,0,,Сіз алмайсыз.
Dialogue: 0,0:09:11.56,0:09:12.30,Default,,0,0,0,,Мені кешіре гөр
Dialogue: 0,0:09:13.21,0:09:14.47,Default,,0,0,0,,(Косей) Сен балалармен тез тіл табысасың ғой, иә?
Dialogue: 0,0:09:16.33,0:09:19.10,Default,,0,0,0,,Мен сендерді бұлай жақын екендеріңді білмедім.
Dialogue: 0,0:09:20.15,0:09:22.16,Default,,0,0,0,,Әке, бұл түсінбеушілік.
Dialogue: 0,0:09:22.24,0:09:24.77,Default,,0,0,0,,Жарайды, олай десең, енді келмейтін шығар.
Dialogue: 0,0:09:25.64,0:09:29.93,Default,,0,0,0,,Хаку: Ақыры Йонаны қорғауды шештің.
Dialogue: 0,0:09:30.34,0:09:32.73,Default,,0,0,0,,Мен мұны сізге қалдырамын деп ойладым.
Dialogue: 0,0:09:35.22,0:09:37.10,Default,,0,0,0,,Бұл мен үшін қымбат.
Dialogue: 0,0:09:38.48,0:09:41.39,Default,,0,0,0,,Жүністен сұраңыз.
Dialogue: 0,0:09:45.03,0:09:45.80,Default,,0,0,0,,Бакуго жеңіске жетті!
Dialogue: 0,0:09:48.24,0:09:49.26,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:09:49.03,0:09:52.51,Default,,0,0,0,,Сіз қазір шынымен табандысыз. Мен оны ұнатпаймын.
Dialogue: 0,0:09:49.90,0:09:52.52,Default,,0,0,0,,Мен бұл ата-ана мен баланы жалғыз қалдыра алмаймын.
Dialogue: 0,0:09:54.11,0:09:57.58,Default,,0,0,0,,Ал бұл патша қорқақ емес.
Dialogue: 0,0:10:01.59,0:10:05.67,Default,,0,0,0,,Мәртебелі, сіз бізді әлі де бір жерде көре аласыз ба?
Dialogue: 0,0:10:09.94,0:10:13.58,Default,,0,0,0,,Мен сенің өкінішіңді қорғаймын
Dialogue: 0,0:10:20.99,0:10:22.86,Default,,0,0,0,,Жылама, әке.
Dialogue: 0,0:10:23.41,0:10:27.05,Default,,0,0,0,,Анам кетсе де Жүніс осында.
Dialogue: 0,0:10:27.16,0:10:29.22,Default,,0,0,0,,Әке, сіз жалғыз емессіз.
Dialogue: 0,0:10:29.78,0:10:33.71,Default,,0,0,0,,Сіз білесіз бе, Йона онымен Су Вон бар.
Dialogue: 0,0:10:35.14,0:10:35.89,Default,,0,0,0,,Жүніс
Dialogue: 0,0:10:36.71,0:10:38.85,Default,,0,0,0,,Қараңдаршы, қар жауып жатыр.
Dialogue: 0,0:10:44.14,0:10:45.62,Default,,0,0,0,,Тоқаш дайын
Dialogue: 0,0:10:47.75,0:10:50.05,Default,,0,0,0,,Біртүрлі нәрсе жасалды.
Dialogue: 0,0:10:52.12,0:10:53.03,Default,,0,0,0,,Жүніс
Dialogue: 0,0:10:54.67,0:10:55.61,Default,,0,0,0,,періштеге ұқсайтын екі қызметші қыз.
Dialogue: 0,0:10:55.87,0:10:59.65,Default,,0,0,0,,Әкесі жыламас үшін Йона сау болады.
Dialogue: 0,0:11:02.61,0:11:03.46,Default,,0,0,0,,Хе-хе, рақмет
Dialogue: 0,0:11:03.88,0:11:04.59,Default,,0,0,0,,Хаку
Dialogue: 0,0:11:04.62,0:11:06.22,Default,,0,0,0,,Бұл Хаку.
Dialogue: 0,0:11:06.33,0:11:08.62,Default,,0,0,0,,Ханшайым, қадамыңды бақылаңыз.
Dialogue: 0,0:11:09.09,0:11:11.11,Default,,0,0,0,,Мен өзімді жақсы сезінсем де
Dialogue: 0,0:11:11.35,0:11:13.45,Default,,0,0,0,,Онда неге ұйықтап жатырсың?
Dialogue: 0,0:11:13.62,0:11:16.76,Default,,0,0,0,,Мен бұл жердегі өмірімнің дәлелін ойып жаздым.
Dialogue: 0,0:11:18.00,0:11:19.98,Default,,0,0,0,,Түскен аппақ қар болса
Dialogue: 0,0:11:20.14,0:11:24.42,Default,,0,0,0,,Ең алдымен, адам бойында жатқысы келіп, ұйықтағысы келеді.
Dialogue: 0,0:11:25.18,0:11:27.41,Default,,0,0,0,,Қарлы тұшпара үшін тамаша нысана.
Dialogue: 0,0:11:33.00,0:11:36.28,Default,,0,0,0,,Күтілгендей, Хаку Йона өзін жақсы сезінеді.
Dialogue: 0,0:11:41.23,0:11:43.56,Default,,0,0,0,,Жүністің энергиясы таусылды.
Dialogue: 0,0:11:44.05,0:11:47.50,Default,,0,0,0,,Ханшайымға қарда ойнау қиын болды ма?
Dialogue: 0,0:11:48.19,0:11:49.52,Default,,0,0,0,,Кешіріңіз Йона
Dialogue: 0,0:11:49.86,0:11:53.30,Default,,0,0,0,,Дәрі-дәрмегін ішіп, демалсаң, сауығып кетесің.
Dialogue: 0,0:11:53.75,0:11:55.69,Default,,0,0,0,,Иә, әке.
Dialogue: 0,0:11:56.11,0:11:58.01,Default,,0,0,0,,Мәртебелі қазір бос емес.
Dialogue: 0,0:11:58.98,0:12:01.12,Default,,0,0,0,,Бірақ сіз оны тікелей көресіз.
Dialogue: 0,0:12:01.34,0:12:03.10,Default,,0,0,0,,Жарайды, Жүніс.
Dialogue: 0,0:12:03.93,0:12:07.78,Default,,0,0,0,,Егер патша немесе ханшайым ауырып қалса, ол сізге ұшып келеді.
Dialogue: 0,0:12:07.94,0:12:10.76,Default,,0,0,0,,Екеуің қазір үйге бара беріңдер.
Dialogue: 0,0:12:10.91,0:12:12.49,Default,,0,0,0,,Жүніске жақындағанда...
Dialogue: 0,0:12:12.61,0:12:15.12,Default,,0,0,0,,Жарайды, менде бәрі жақсы.
Dialogue: 0,0:12:15.26,0:12:17.20,Default,,0,0,0,,Менің денем қазір жылы
Dialogue: 0,0:12:17.33,0:12:21.24,Default,,0,0,0,,Менің көп ойнағаным сонша, әлі күнге дейін қарлы шарлар көрінеді.
Dialogue: 0,0:12:25.19,0:12:27.87,Default,,0,0,0,,Медицина қызметкері науқас адам
Dialogue: 0,0:12:28.70,0:12:32.25,Default,,0,0,0,,Мен қисынды түрде айналамда қарлы шарлар ұшып жүр деп ойладым.
Dialogue: 0,0:12:32.89,0:12:36.21,Default,,0,0,0,,Екеуің де үйге барудың қажеті жоқ.
Dialogue: 0,0:12:36.36,0:12:40.80,Default,,0,0,0,,Ауру тарамас үшін осы жерде емдеген дұрыс сияқты.
Dialogue: 0,0:12:40.96,0:12:45.97,Default,,0,0,0,,Бірақ соңғы кездері мен Йонамен қол ұстасып ұйықтайтын болдым, әдеттегідей.
Dialogue: 0,0:12:46.54,0:12:48.80,Default,,0,0,0,,Сіз мұны істеп жатырсыз ба?
Dialogue: 0,0:12:49.15,0:12:50.33,Default,,0,0,0,,Мен үйге бара жатырмын.
Dialogue: 0,0:12:51.16,0:12:53.24,Default,,0,0,0,,Үшеуі қол ұстасып алайық
Dialogue: 0,0:12:53.41,0:12:54.24,Default,,0,0,0,,Әзіл
Dialogue: 0,0:12:54.58,0:12:55.48,Default,,0,0,0,,Ата
Dialogue: 0,0:12:55.97,0:13:01.04,Default,,0,0,0,,Бала ханшайымға қар лақтырып, оны ауыртып жіберген көрінеді.
Dialogue: 0,0:13:01.21,0:13:04.16,Default,,0,0,0,,Ол жерде қар болса, оны лақтыру әдептілік.
Dialogue: 0,0:13:04.72,0:13:06.01,Default,,0,0,0,,Бөксесін көрсет
Dialogue: 0,0:13:06.56,0:13:07.83,Default,,0,0,0,,Қамшылау
Dialogue: 0,0:13:08.15,0:13:10.12,Default,,0,0,0,,Жалпы, тоқтаңыз.
Dialogue: 0,0:13:10.46,0:13:11.49,Default,,0,0,0,,Ол ауырып жатыр.
Dialogue: 0,0:13:14.18,0:13:15.79,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:13:16.10,0:13:17.37,Default,,0,0,0,,Қайтып келсең, өлтіресің.
Dialogue: 0,0:13:17.86,0:13:21.80,Default,,0,0,0,,Бұл жел тайпасының басшысы генерал Мундоку.
Dialogue: 0,0:13:22.02,0:13:22.80,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:13:23.20,0:13:26.38,Default,,0,0,0,,Генерал Мундук Мен оған тәнтімін.
Dialogue: 0,0:13:26.89,0:13:28.77,Default,,0,0,0,,Бұл Хакудың атасы болды ма?
Dialogue: 0,0:13:29.59,0:13:30.76,Default,,0,0,0,,Мен жетіммін
Dialogue: 0,0:13:31.38,0:13:33.48,Default,,0,0,0,,Мен атамен қандас емеспін.
Dialogue: 0,0:13:34.07,0:13:35.49,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:13:35.89,0:13:37.98,Default,,0,0,0,,Мені енді ғана асырап алған бала ретінде күтіп отыр.
Dialogue: 0,0:13:39.50,0:13:41.95,Default,,0,0,0,,Бірақ Мундоку келді.
Dialogue: 0,0:13:43.72,0:13:45.43,Default,,0,0,0,,Сізге Хаку ұнайды, солай ма?
Dialogue: 0,0:13:46.69,0:13:47.86,Default,,0,0,0,,Бұл шынымен де…
Dialogue: 0,0:13:49.02,0:13:50.27,Default,,0,0,0,,Тағы біреу келді
Dialogue: 0,0:13:53.40,0:13:56.08,Default,,0,0,0,,Әке, мұнда неге келдің?
Dialogue: 0,0:13:56.60,0:13:59.71,Default,,0,0,0,,Науқас баламды көру дұрыс емес пе?
Dialogue: 0,0:13:59.98,0:14:02.89,Default,,0,0,0,,Ауру сіздің әкеңізге жұққан.
Dialogue: 0,0:14:03.39,0:14:05.93,Default,,0,0,0,,Сенің ауруыңнан жеңіліп қалсам ше?
Dialogue: 0,0:14:06.00,0:14:09.69,Default,,0,0,0,,Жоқ, бірақ қазір бос емес уақыт.
Dialogue: 0,0:14:10.42,0:14:13.67,Default,,0,0,0,,Юхон ағай, күшті және қатал.
Dialogue: 0,0:14:13.81,0:14:15.72,Default,,0,0,0,,Сувоннан мүлдем басқаша
Dialogue: 0,0:14:16.53,0:14:18.88,Default,,0,0,0,,Ауруды дереу өлтіріңіз.
Dialogue: 0,0:14:19.00,0:14:19.52,Default,,0,0,0,,Иә
Dialogue: 0,0:14:21.46,0:14:22.86,Default,,0,0,0,,Күтілгендей әсерлі
Dialogue: 0,0:14:23.18,0:14:25.20,Default,,0,0,0,,Менің қызуым кенет түсіп кеткендей болды.
Dialogue: 0,0:14:25.84,0:14:27.33,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:14:28.89,0:14:31.23,Default,,0,0,0,,Бүгін қандай қуанышты күн!
Dialogue: 0,0:14:31.58,0:14:34.25,Default,,0,0,0,,Жарайды, мен ауруды жоюға бар күшімді саламын.
Dialogue: 0,0:14:34.66,0:14:35.86,Default,,0,0,0,,Ұйықта, ақымақ
Dialogue: 0,0:14:37.27,0:14:38.45,Default,,0,0,0,,Әке
Dialogue: 0,0:14:41.67,0:14:42.79,Default,,0,0,0,,Бұл ауырады
Dialogue: 0,0:14:43.90,0:14:46.02,Default,,0,0,0,,Неге келмейсің?
Dialogue: 0,0:14:46.41,0:14:48.15,Default,,0,0,0,,Мені жалғыз қалдырмаңыз
Dialogue: 0,0:14:52.70,0:14:55.22,Default,,0,0,0,,Ханшайым, тістеп алшы.
Dialogue: 0,0:14:55.73,0:14:56.72,Default,,0,0,0,,Мен мұны қаламаймын
Dialogue: 0,0:14:59.59,0:15:01.90,Default,,0,0,0,,Жүніс, мен тамақ жеуім керек.
Dialogue: 0,0:15:01.94,0:15:04.12,Default,,0,0,0,,Барған сайын ұсқынсызданып барады.
Dialogue: 0,0:15:05.49,0:15:07.28,Default,,0,0,0,,Мәртебелі көрінбейді ме?
Dialogue: 0,0:15:08.06,0:15:11.62,Default,,0,0,0,,Иә, мен ханшайым туралы айттым.
Dialogue: 0,0:15:11.75,0:15:13.17,Default,,0,0,0,,Бұл сол адам туралы.
Dialogue: 0,0:15:13.60,0:15:17.14,Default,,0,0,0,,Мен ауырып қаламын ба деп қызыма жақындай да алмаймын.
Dialogue: 0,0:15:17.37,0:15:18.22,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:15:19.45,0:15:20.96,Default,,0,0,0,,Өйткені патша – патша
Dialogue: 0,0:15:21.57,0:15:23.71,Default,,0,0,0,,Мен осындай уақытта өз жұмысымды дұрыс атқарамын.
Dialogue: 0,0:15:24.05,0:15:26.51,Default,,0,0,0,,Мен сол қарияны қайта қарап жатырмын.
Dialogue: 0,0:15:30.17,0:15:30.88,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:31.61,0:15:34.14,Default,,0,0,0,,Кешіріңіз, мен сізді жалғыз қалдым деп ойладым.
Dialogue: 0,0:15:41.59,0:15:43.15,Default,,0,0,0,,Бұл өте үлкен.
Dialogue: 0,0:15:43.25,0:15:43.94,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:15:44.10,0:15:46.14,Default,,0,0,0,,Йона менің қарным ашты.
Dialogue: 0,0:15:46.54,0:15:48.14,Default,,0,0,0,,Маған бірдеңе әкелейін.
Dialogue: 0,0:15:49.67,0:15:51.13,Default,,0,0,0,,Тауық ботқасы
Dialogue: 0,0:15:55.58,0:15:57.54,Default,,0,0,0,,Таң қаларлық дәмсіз
Dialogue: 0,0:15:58.47,0:16:00.88,Default,,0,0,0,,Солай ма? Дәмі нашар ма?
Dialogue: 0,0:16:00.93,0:16:01.92,Default,,0,0,0,,Әке
Dialogue: 0,0:16:02.65,0:16:04.99,Default,,0,0,0,,Мен мұны жасадым.
Dialogue: 0,0:16:05.82,0:16:10.73,Default,,0,0,0,,Сізбен кездесуге келе алмағаным үшін кешірім сұрау үшін мен Йонаның сүйікті асын жасап көрейін деп ойладым.
Dialogue: 0,0:16:11.07,0:16:14.04,Default,,0,0,0,,Пісіру күнделігі бойынша жасадым.
Dialogue: 0,0:16:18.38,0:16:20.66,Default,,0,0,0,,Дәмі жаман емес пе?
Dialogue: 0,0:16:21.97,0:16:23.37,Default,,0,0,0,,Өте нашар дәм
Dialogue: 0,0:16:30.17,0:16:32.13,Default,,0,0,0,,О, сауығып кетті.
Dialogue: 0,0:16:32.44,0:16:34.52,Default,,0,0,0,,Бұл өкінішті сияқты, Химе-сан.
Dialogue: 0,0:16:34.59,0:16:35.31,Default,,0,0,0,,Бөлек
Dialogue: 0,0:16:35.68,0:16:37.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:37.52,0:16:39.92,Default,,0,0,0,,Мен ханшайымның қасында ұйықтай алмайтындықтан ба?
Dialogue: 0,0:16:40.15,0:16:42.69,Default,,0,0,0,,Сіз кез келген уақытта Йонаның қасында ұйықтай аласыз.
Dialogue: 0,0:16:43.79,0:16:49.78,Default,,0,0,0,,Мен әрқашан осылай ұйықтағым келді, тек үшеуміз, жел соғып.
Dialogue: 0,0:16:50.27,0:16:53.34,Default,,0,0,0,,Жел болмаса да оңай.
Dialogue: 0,0:16:53.71,0:16:55.20,Default,,0,0,0,,Тек бірге болу
Dialogue: 0,0:16:55.75,0:16:56.67,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:16:57.65,0:17:01.15,Default,,0,0,0,,Сувон Хак, ертең бізге де кел.
Dialogue: 0,0:17:02.53,0:17:04.93,Default,,0,0,0,,Келіңіз және бізге мәңгілік қонаққа келіңіз.
Dialogue: 0,0:17:10.69,0:17:11.42,Default,,0,0,0,,Бұл
Dialogue: 0,0:17:12.51,0:17:13.78,Default,,0,0,0,,Онда ешкім жоқ
Dialogue: 0,0:17:15.70,0:17:16.58,Default,,0,0,0,,Әке
Dialogue: 0,0:17:17.31,0:17:18.28,Default,,0,0,0,,Әке
Dialogue: 0,0:17:23.47,0:17:25.54,Default,,0,0,0,,Су Су Вон
Dialogue: 0,0:17:34.94,0:17:35.78,Default,,0,0,0,,Хаку
Dialogue: 0,0:17:35.94,0:17:38.85,Default,,0,0,0,,Кешіріңіз, мен ауыз су алуға бардым.
Dialogue: 0,0:17:44.90,0:17:49.80,Default,,0,0,0,,Біз бірге қараған аспан енді жоқ.
Dialogue: 0,0:17:58.52,0:18:00.72,Default,,0,0,0,,Аз болса да жеген дұрыс.
Dialogue: 0,0:18:01.64,0:18:05.00,Default,,0,0,0,,Мен бұл жерден тамақты қамтамасыз ете аламын ба, білмеймін.
Dialogue: 0,0:18:06.64,0:18:08.08,Default,,0,0,0,,Барған сайын әлсірейді
Dialogue: 0,0:18:08.89,0:18:10.17,Default,,0,0,0,,Тек физикалық күш емес
Dialogue: 0,0:18:10.74,0:18:13.76,Default,,0,0,0,,Қанша уақыт өтсе де, мен әлі күнге дейін шындықпен бетпе-бет келе алмаймын
Dialogue: 0,0:18:22.35,0:18:24.22,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:25.39,0:18:26.10,Default,,0,0,0,,Бұл сүлгі.
Dialogue: 0,0:18:26.63,0:18:27.36,Default,,0,0,0,,Тыныш отырыңыз
Dialogue: 0,0:18:28.23,0:18:31.19,Default,,0,0,0,,Бұл жігіт тоғандар мен батпақтарда тұрады, қан сорады.
Dialogue: 0,0:18:31.59,0:18:32.12,Default,,0,0,0,,Қан...
Dialogue: 0,0:18:33.16,0:18:35.33,Default,,0,0,0,,Бұл маңызды ештеңе емес.
Dialogue: 0,0:18:37.60,0:18:39.63,Default,,0,0,0,,Киім Мен оны осында қалдырамын.
Dialogue: 0,0:18:39.99,0:18:41.66,Default,,0,0,0,,Мен сөмкелерімді жинаған соң кетемін.
Dialogue: 0,0:18:43.35,0:18:46.85,Default,,0,0,0,,Ханшайым сол күйінде мәңгі қала ма?
Dialogue: 0,0:18:47.80,0:18:51.50,Default,,0,0,0,,Ол тамақ ішпейді, менің қолымнан жетелеп жүреді.
Dialogue: 0,0:18:51.96,0:18:53.16,Default,,0,0,0,,Қуыршақ сияқты
Dialogue: 0,0:18:54.47,0:18:56.15,Default,,0,0,0,,Қанағаттандың ба, Су Вон?
Dialogue: 0,0:18:57.11,0:19:01.47,Default,,0,0,0,,Бірге өткізген күндеріміз де, қадірлеген ханшайымымыз да құрдымға кетті.
Dialogue: 0,0:19:02.38,0:19:04.25,Default,,0,0,0,,Осыған көңіліңіз тола ма?
Dialogue: 0,0:19:08.39,0:19:09.05,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:19:11.67,0:19:13.29,Default,,0,0,0,,Тағы да осындай нәрсені ұстау
Dialogue: 0,0:19:16.91,0:19:18.48,Default,,0,0,0,,Бүгін осында демалайық.
Dialogue: 0,0:19:25.76,0:19:28.34,Default,,0,0,0,,Сіз не істедіңіз? Сіз бірдеңе жоғалттыңыз ба?
Dialogue: 0,0:19:34.28,0:19:36.34,Default,,0,0,0,,Маған ондай нәрсе керек емес
Dialogue: 0,0:19:37.59,0:19:38.89,Default,,0,0,0,,Мүлдем қажет емес
Dialogue: 0,0:19:40.17,0:19:42.59,Default,,0,0,0,,Маған Жүністің шашы ұнайды.
Dialogue: 0,0:19:43.50,0:19:45.06,Default,,0,0,0,,Бұл таң атқан аспанның түсі.
Dialogue: 0,0:19:49.25,0:19:49.90,Default,,0,0,0,,Мінез-құлқы: Талғампаз
Dialogue: 0,0:19:50.43,0:19:52.68,Default,,0,0,0,,Бір минут күтіңіз
Dialogue: 0,0:19:53.12,0:19:54.40,Default,,0,0,0,,Мен бірден қайтамын.
Dialogue: 0,0:20:12.59,0:20:17.17,Default,,0,0,0,,Сіз білетін Сувон басынан бері болмаған.
Dialogue: 0,0:20:17.78,0:20:20.91,Default,,0,0,0,,Менің жолымда бірдеңе болса, мен оны қиып аламын.
Dialogue: 0,0:20:24.50,0:20:25.24,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:20:26.67,0:20:29.50,Default,,0,0,0,,Неліктен мұндай жерде өлгің келеді?
Dialogue: 0,0:20:30.55,0:20:32.30,Default,,0,0,0,,Шүкір, бұл үйшік.
Dialogue: 0,0:20:38.80,0:20:40.68,Default,,0,0,0,,Tsk, дәл солай.
Dialogue: 0,0:20:40.74,0:20:41.30,Default,,0,0,0,,Хаку
Dialogue: 0,0:20:41.82,0:20:44.16,Default,,0,0,0,,Тыныш және ұстаңыз, ханшайым.
Dialogue: 0,0:20:44.80,0:20:46.47,Default,,0,0,0,,Мені тек құрал деп есептеңіз
Dialogue: 0,0:20:46.68,0:20:49.09,Default,,0,0,0,,Өмір сүру үшін мені пайдаланыңыз
Dialogue: 0,0:20:49.49,0:20:51.80,Default,,0,0,0,,Сондықтан мен мұндамын
Dialogue: 0,0:20:56.44,0:20:57.91,Default,,0,0,0,,Хаку Кешіріңіз
Dialogue: 0,0:20:57.94,0:20:59.69,Default,,0,0,0,,Бұл сіз іздеп жүрген нәрсе ме?
Dialogue: 0,0:21:07.55,0:21:09.27,Default,,0,0,0,,Мен Сувонды кешірмеймін
Dialogue: 0,0:21:10.07,0:21:13.29,Default,,0,0,0,,Бірақ одан да көп сенің өмір сүргеніңді қалаймын.
Dialogue: 0,0:21:15.20,0:21:20.53,Default,,0,0,0,,Бұл тауға кіргелі бері бірінші рет іздеп көшіп келдің.
Dialogue: 0,0:21:21.28,0:21:24.88,Default,,0,0,0,,Бәрі жақсы, мен сені қазір бірге ұстай аламын.
Dialogue: 0,0:21:26.83,0:21:30.17,Default,,0,0,0,,Мен әлі күнге дейін жібере алмайтын сезім болса да
Dialogue: 0,0:21:35.79,0:21:38.92,Default,,0,0,0,,Шынымен бе? Сіз оларды таба алмайсыз ба?
Dialogue: 0,0:21:39.55,0:21:40.79,Default,,0,0,0,,Сіз қуғыншылардың санын көбейткіңіз келе ме?
Dialogue: 0,0:21:41.51,0:21:43.27,Default,,0,0,0,,Жоқ, оны жайына қалдырайық.
Dialogue: 0,0:21:43.99,0:21:45.20,Default,,0,0,0,,Сіз оны тірі қалдырасыз ба?
Dialogue: 0,0:21:46.13,0:21:48.57,Default,,0,0,0,,Олар қамалдан шыққаннан кейін ештеңе істей алмайды.
Dialogue: 0,0:21:49.12,0:21:53.75,Default,,0,0,0,,Бұдан басқа бізде шұғыл жұмыс бар.
Dialogue: 0,0:23:27.49,0:23:30.70,Default,,0,0,0,,Біз қуғыншылардан қашқан соң қайда жеттік
Dialogue: 0,0:23:31.02,0:23:34.04,Default,,0,0,0,,Жылы күлкіге толы болды.
Dialogue: 0,0:23:34.87,0:23:38.27,Default,,0,0,0,,Келесі жолы «Таң таңындағы Йона» 4-бөлім
Dialogue: 0,0:23:38.58,0:23:40.75,Default,,0,0,0,,Жел тайпасы
Dialogue: 0,0:23:42.25,0:23:47.25,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
