Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:23.81,0:00:25.65,Default,,0,0,0,,Ол менің ұлым
Dialogue: 0,0:00:26.15,0:00:31.11,Default,,0,0,0,,Өз-өзіне қол жұмсағалы тұрған әке меннен басқа ешкім емес.
Dialogue: 0,0:00:32.74,0:00:35.32,Default,,0,0,0,,Ол қоғамдық телехабар таратуға жарамайды.
Dialogue: 0,0:00:35.41,0:00:36.45,Default,,0,0,0,,Мен түсіндім
Dialogue: 0,0:00:36.53,0:00:39.20,Default,,0,0,0,,Бірақ мені кешіріңіз.
Dialogue: 0,0:00:39.28,0:00:41.87,Default,,0,0,0,,Әрине, қазір жалғыз уақыт.
Dialogue: 0,0:00:41.95,0:00:45.50,Default,,0,0,0,,Бұл баламен дұрыс сөйлесуге мүмкіндік бар ма?
Dialogue: 0,0:00:46.50,0:00:47.79,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:00:48.67,0:00:51.80,Default,,0,0,0,,Күн Ешқашан кешірім сұрама
Dialogue: 0,0:00:52.30,0:00:55.01,Default,,0,0,0,,Бірақ... өйткені...
Dialogue: 0,0:00:56.01,0:00:59.26,Default,,0,0,0,,Мен кешірім сұрауым керек.
Dialogue: 0,0:01:00.56,0:01:04.14,Default,,0,0,0,,Мен сіз әлі де фактілерді қабылдай алмайсыз деп ойладым.
Dialogue: 0,0:01:05.10,0:01:09.02,Default,,0,0,0,,Кешіріңіз, мен сізге бала сияқты қарадым.
Dialogue: 0,0:01:09.11,0:01:12.03,Default,,0,0,0,,Неге... неге өлесің?
Dialogue: 0,0:01:12.11,0:01:16.20,Default,,0,0,0,,Әрине, бір нәрсе сенің жүрегің.
Dialogue: 0,0:01:16.70,0:01:19.16,Default,,0,0,0,,Жүрегің көп жылдарға шыдамайды.
Dialogue: 0,0:01:19.66,0:01:24.12,Default,,0,0,0,,Бірақ әкеңнің жүрегі болса, одан әрі өмір сүре аласың.
Dialogue: 0,0:01:25.04,0:01:26.62,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,0:01:30.34,0:01:31.13,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:01:31.88,0:01:34.55,Default,,0,0,0,,Жүрек заты тек бастапқы нүкте.
Dialogue: 0,0:01:35.05,0:01:39.34,Default,,0,0,0,,Айтайын, менің өз-өзіме қол жұмсауымның сізге еш қатысы жоқ.
Dialogue: 0,0:01:40.93,0:01:45.35,Default,,0,0,0,,Алғашында жүрегімді саған беремін деп ойладым.
Dialogue: 0,0:01:45.43,0:01:46.85,Default,,0,0,0,,Бірақ қазіргі әлемде
Dialogue: 0,0:01:46.94,0:01:51.61,Default,,0,0,0,,Өз-өзіне қол жұмсаған соң жүрегімді саған беруге тыйым салынады.
Dialogue: 0,0:01:52.73,0:01:56.11,Default,,0,0,0,,Бұл Жапонияда да, дүние жүзіндегі басқа елдерде де жақсы емес.
Dialogue: 0,0:01:56.82,0:02:00.87,Default,,0,0,0,,Бірақ мен осылай істегенім дұрыс деп ойладым.
Dialogue: 0,0:02:03.16,0:02:07.46,Default,,0,0,0,,Менің жаңағы айтқанымды теледидар мен бұқаралық ақпарат құралдары көрсететініне сенімдімін.
Dialogue: 0,0:02:07.54,0:02:09.12,Default,,0,0,0,,Үлкен тақырып болады
Dialogue: 0,0:02:09.62,0:02:12.63,Default,,0,0,0,,Сонда көптеген адамдар сізге көмектесе алады.
Dialogue: 0,0:02:12.71,0:02:14.59,Default,,0,0,0,,Сіз елестете аласыз ба?
Dialogue: 0,0:02:14.67,0:02:18.63,Default,,0,0,0,,Жүрегіңізді емдеуге көмектесетін адамдар көп.
Dialogue: 0,0:02:19.55,0:02:22.64,Default,,0,0,0,,Біреу маған хат жіберді немесе қайырымдылық жасады.
Dialogue: 0,0:02:24.22,0:02:26.72,Default,,0,0,0,,Бірақ бұл жақсы емес.
Dialogue: 0,0:02:27.35,0:02:29.85,Default,,0,0,0,,Мен саған жүрегімді бере аламын
Dialogue: 0,0:02:29.94,0:02:32.61,Default,,0,0,0,,Бір жақсы әңгімемен тоқтап қалмаңыз
Dialogue: 0,0:02:33.19,0:02:36.23,Default,,0,0,0,,Бұдан былай бұл қалыпты жағдайға айналуы керек.
Dialogue: 0,0:02:36.99,0:02:38.74,Default,,0,0,0,,Тек органдарды трансплантациялау емес
Dialogue: 0,0:02:38.82,0:02:43.58,Default,,0,0,0,,Өлім не шеше алады Өлім көмектесетін сансыз нәрселер бар.
Dialogue: 0,0:02:44.08,0:02:48.91,Default,,0,0,0,,Менің ойымша, адамдар өліммен жақсырақ күресе алады.
Dialogue: 0,0:02:49.75,0:02:52.75,Default,,0,0,0,,Күн Біреумен дос болғың келгенде
Dialogue: 0,0:02:53.33,0:02:56.63,Default,,0,0,0,,Сіз ол адам туралы жаман сөз айтасыз ба немесе оны жек көресіз бе?
Dialogue: 0,0:02:56.71,0:02:57.76,Default,,0,0,0,,Жоқ
Dialogue: 0,0:02:58.34,0:03:01.43,Default,,0,0,0,,Мен өліммен достасуға тырысамын.
Dialogue: 0,0:03:02.01,0:03:07.31,Default,,0,0,0,,Мен бәрінің жақсырақ араласқанын қалаймын.
Dialogue: 0,0:03:07.39,0:03:11.31,Default,,0,0,0,,Ол үшін мен оны өзім көрсетуім керек.
Dialogue: 0,0:03:11.39,0:03:13.31,Default,,0,0,0,,Өлім жаман емес
Dialogue: 0,0:03:13.81,0:03:17.36,Default,,0,0,0,,Мен оны дәлелдеу үшін өлемін
Dialogue: 0,0:03:18.40,0:03:21.28,Default,,0,0,0,,Сол кезде менде артық жүрек болады.
Dialogue: 0,0:03:21.36,0:03:24.20,Default,,0,0,0,,Күн онымен не істеу керектігін шешеді.
Dialogue: 0,0:03:24.28,0:03:29.33,Default,,0,0,0,,Қолданбасаң да, менің өлгеніме оның еш қатысы жоқ.
Dialogue: 0,0:03:29.91,0:03:31.00,Default,,0,0,0,,Бірақ бұл жақсы нәрсе.
Dialogue: 0,0:03:31.50,0:03:35.08,Default,,0,0,0,,Бұл ысырап, қолдан келгенше пайдалан, күн.
Dialogue: 0,0:03:35.67,0:03:37.17,Default,,0,0,0,,А... иә
Dialogue: 0,0:03:37.67,0:03:41.13,Default,,0,0,0,,Біз қазір көптеген электрондық хаттар мен факстарды алып жатырмыз.
Dialogue: 0,0:03:41.22,0:03:43.26,Default,,0,0,0,,Және олардың арасында...
Dialogue: 0,0:03:43.76,0:03:47.18,Default,,0,0,0,,Өз жүрегімді пайдалануымды өтінген хат та болды.
Dialogue: 0,0:03:47.26,0:03:49.10,Default,,0,0,0,,Маған бірнеше хат келген сияқты.
Dialogue: 0,0:03:49.18,0:03:50.89,Default,,0,0,0,,Пайдаланылмайды
Dialogue: 0,0:03:51.43,0:03:54.81,Default,,0,0,0,,Біреудің жүрегі күннің өмірін сақтап қалды.
Dialogue: 0,0:03:54.90,0:03:58.11,Default,,0,0,0,,Ұлым екеуміз бірге тұрамыз.
Dialogue: 0,0:03:58.69,0:04:00.57,Default,,0,0,0,,Мұндай болашақ болуы мүмкін.
Dialogue: 0,0:04:01.53,0:04:03.57,Default,,0,0,0,,Мен оны таңдамаймын
Dialogue: 0,0:04:03.66,0:04:07.08,Default,,0,0,0,,Мен біреудің өлімін емес, өз өлімімді таңдар едім.
Dialogue: 0,0:04:07.74,0:04:10.08,Default,,0,0,0,,Сол таңдауды жасай білу
Dialogue: 0,0:04:10.16,0:04:13.33,Default,,0,0,0,,Әркім өлімді таңдауға ерікті
Dialogue: 0,0:04:13.41,0:04:17.09,Default,,0,0,0,,Өз-өзіне қол жұмсау туралы заңдардың бәрі осы.
Dialogue: 0,0:04:17.17,0:04:20.84,Default,,0,0,0,,Жүрегіңді мүлде бейтаныс адам сыйлайды деп айтуға болады.
Dialogue: 0,0:04:21.46,0:04:24.09,Default,,0,0,0,,Өз-өзіне қол жұмсаудан бас тартуға және таңдауға болады.
Dialogue: 0,0:04:24.68,0:04:27.35,Default,,0,0,0,,Сіз жаңа ғана куә болған нәрсе
Dialogue: 0,0:04:27.43,0:04:31.85,Default,,0,0,0,,Келешек күннің көрінісі, жаңа дәуір құндылықтары
Dialogue: 0,0:04:32.64,0:04:35.98,Default,,0,0,0,,Менің жүрегіммен күн тұратын дүние
Dialogue: 0,0:04:36.48,0:04:41.48,Default,,0,0,0,,Бұл суицид туралы заңдардан тыс әлем.
Dialogue: 0,0:04:42.99,0:04:44.99,Default,,0,0,0,,♪～
Dialogue: 0,0:05:10.89,0:05:12.89,Default,,0,0,0,,～♪
Dialogue: 0,0:05:15.48,0:05:17.52,Default,,0,0,0,,Сіздің мақсатыңыз осы болды ма?
Dialogue: 0,0:05:17.60,0:05:20.23,Default,,0,0,0,,Қарсылар мұқият дайындаған стратегия
Dialogue: 0,0:05:20.31,0:05:22.03,Default,,0,0,0,,Толығымен кері
Dialogue: 0,0:05:22.53,0:05:25.24,Default,,0,0,0,,Осыған байланысты растаулардың саны айтарлықтай көбеюі мүмкін.
Dialogue: 0,0:05:25.32,0:05:29.95,Default,,0,0,0,,Нәтижеге қарамастан, біз өз миссиямызды жоспарлағандай орындаймыз.
Dialogue: 0,0:05:30.45,0:05:32.33,Default,,0,0,0,,Тікелей эфир жақын арада аяқталады
Dialogue: 0,0:05:32.91,0:05:35.62,Default,,0,0,0,,Сайдың әйелі мен балаларын студияда не істеуіміз керек?
Dialogue: 0,0:05:35.71,0:05:38.37,Default,,0,0,0,,Отбасының үш мүшесі де бірге үйге қайту мүмкіндігі бар...
Dialogue: 0,0:05:38.46,0:05:39.21,Default,,0,0,0,,Егер олар тым жылдам қозғалса (оу, вей, оу)
Dialogue: 0,0:05:40.25,0:05:44.51,Default,,0,0,0,,Жолсерік тобы: Жеке қорғанысыңыздан екі адамды алып, әйеліңіз бен балаңызға барыңыз.
Dialogue: 0,0:05:44.59,0:05:49.01,Default,,0,0,0,,Олар оған қауіпсіздік мақсатында екенін айтып, Сайдан бөлек үйге баруын өтінді.
Dialogue: 0,0:05:49.72,0:05:51.85,Default,,0,0,0,,Екеуі жаңа әйел мен бала командасы болады.
Dialogue: 0,0:05:51.93,0:05:54.85,Default,,0,0,0,,Маған лейтенант Куджиин және тағы бір адам керек.
Dialogue: 0,0:05:54.93,0:05:55.93,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:06:01.69,0:06:04.11,Default,,0,0,0,,Барлық командалар әрекетті бастайды
Dialogue: 0,0:06:06.94,0:06:11.12,Default,,0,0,0,,Бұл маршрут қауіпсіздігі 1. Жолсерік тобы өтті. Өтінемін
Dialogue: 0,0:06:11.20,0:06:12.70,Default,,0,0,0,,Командалық көлік Түсінікті
Dialogue: 0,0:06:15.70,0:06:20.25,Default,,0,0,0,,Бұл маршрут қауіпсіздігі 2. Жолсерік тобы өтті. Өтінемін
Dialogue: 0,0:06:20.83,0:06:22.00,Default,,0,0,0,,Командалық көлік Түсінікті
Dialogue: 0,0:06:24.55,0:06:27.34,Default,,0,0,0,,Бұл эскорт тобы, растаңыз.
Dialogue: 0,0:06:27.42,0:06:31.01,Default,,0,0,0,,Жоспарланған маршруттың сыртында біраз әбігер бар. өтінемін
Dialogue: 0,0:06:31.09,0:06:33.60,Default,,0,0,0,,Маған толық мәлімет беріңізші
Dialogue: 0,0:06:34.14,0:06:37.48,Default,,0,0,0,,Ғимараттың солтүстік жағында, шағын студияға қарай дәліздің жанында.
Dialogue: 0,0:06:37.56,0:06:40.60,Default,,0,0,0,,Мен жарылғыш немесе мылтық дыбысына ұқсас дыбысты естідім.
Dialogue: 0,0:06:40.69,0:06:42.40,Default,,0,0,0,,Мен егжей-тегжейлі білмеймін
Dialogue: 0,0:06:42.48,0:06:44.90,Default,,0,0,0,,Мазасыздықты растаған кезде біз сізге хабарласамыз.
Dialogue: 0,0:06:44.98,0:06:46.90,Default,,0,0,0,,бұрынғыдай жалғастырыңыз.
Dialogue: 0,0:06:46.98,0:06:48.74,Default,,0,0,0,,Эскорт тобы түсінеді
Dialogue: 0,0:06:50.03,0:06:52.74,Default,,0,0,0,,Сізді күткеніміз үшін кешіріңіз, біз көшуді жалғастырамыз.
Dialogue: 0,0:06:55.28,0:06:58.54,Default,,0,0,0,,Бұл 5-маршрут қауіпсіздігі, эскорт тобы, өтті. өтінемін
Dialogue: 0,0:06:58.62,0:06:59.79,Default,,0,0,0,,Командалық көлік Түсінікті
Dialogue: 0,0:07:03.13,0:07:06.09,Default,,0,0,0,,Шағын студия жағындағы дүрбелеңге не болды?
Dialogue: 0,0:07:06.59,0:07:11.43,Default,,0,0,0,,Командалық көліктен 1-маршрут қауіпсіздігінің растауын хабарлаңыз. Өтінемін
Dialogue: 0,0:07:15.01,0:07:16.89,Default,,0,0,0,,Бағыт қауіпсіздігі 1 Өтінемін
Dialogue: 0,0:07:19.02,0:07:21.39,Default,,0,0,0,,Командалық көліктен бағыт қауіпсіздігі 2 Өтінемін
Dialogue: 0,0:07:22.94,0:07:24.77,Default,,0,0,0,,Бағыт қауіпсіздігі 3 Өтінемін
Dialogue: 0,0:07:25.27,0:07:26.90,Default,,0,0,0,,Бұл байланыс мәселесі ме?
Dialogue: 0,0:07:27.48,0:07:29.57,Default,,0,0,0,,Бағыт қауіпсіздігі 4 Өтінемін
Dialogue: 0,0:07:30.24,0:07:32.24,Default,,0,0,0,,Бағыт қауіпсіздігі 5 Өтінемін
Dialogue: 0,0:07:32.74,0:07:34.41,Default,,0,0,0,,Бағыт қауіпсіздігі 6 Өтінемін
Dialogue: 0,0:07:35.32,0:07:37.16,Default,,0,0,0,,Бұл 6-бағыт қауіпсіздігі.
Dialogue: 0,0:07:38.62,0:07:42.00,Default,,0,0,0,,Бұл командалық көлік. Жағдайды хабарлаңыз. өтінемін
Dialogue: 0,0:07:42.08,0:07:45.33,Default,,0,0,0,,Жолсерік тобы әлі өткен жоқ. өтінемін
Dialogue: 0,0:07:45.84,0:07:46.88,Default,,0,0,0,,Командалық көлік Түсінікті
Dialogue: 0,0:07:47.96,0:07:50.05,Default,,0,0,0,,Командалық көліктен алып жүру тобына дейін өтінемін.
Dialogue: 0,0:07:50.80,0:07:52.01,Default,,0,0,0,,Бұл эскорт командасы.
Dialogue: 0,0:07:52.09,0:07:54.64,Default,,0,0,0,,Маршрут қауіпсіздігіне өту 6. Өтінемін.
Dialogue: 0,0:07:54.72,0:07:58.76,Default,,0,0,0,,Нұсқау алғанша, сол жерде болыңыз.
Dialogue: 0,0:07:59.43,0:08:01.60,Default,,0,0,0,,Эскорт командасы түсінеді, біз күтеміз.
Dialogue: 0,0:08:02.10,0:08:06.11,Default,,0,0,0,,Ескорт тобы өткеннен кейін байланыс үзілді...
Dialogue: 0,0:08:06.61,0:08:07.52,Default,,0,0,0,,Ха…
Dialogue: 0,0:08:08.15,0:08:10.36,Default,,0,0,0,,Командалық көліктегі әйелі мен балалары, өтінемін.
Dialogue: 0,0:08:13.86,0:08:15.07,Default,,0,0,0,,Бірдеңе болып жатыр
Dialogue: 0,0:08:15.57,0:08:16.28,Default,,0,0,0,,Прокурор Масазаки
Dialogue: 0,0:08:17.49,0:08:19.37,Default,,0,0,0,,Мен барып тексеремін.
Dialogue: 0,0:08:21.33,0:08:22.08,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:08:23.04,0:08:25.04,Default,,0,0,0,,Бағыт қауіпсіздігіне басымдық беріледі
Dialogue: 0,0:08:25.12,0:08:26.83,Default,,0,0,0,,Әйел мен бала тобы туралы не деуге болады? (Масазаки) Жарайды.
Dialogue: 0,0:08:27.42,0:08:29.34,Default,,0,0,0,,Куцзин әйел мен бала тобына қосылған.
Dialogue: 0,0:08:29.92,0:08:31.05,Default,,0,0,0,,Қосымша күштер! Біз тез арада қорғаныс жасауымыз керек, әйтпесе қайтадан қоршауға алынамыз.
Dialogue: 0,0:08:34.38,0:08:36.09,Default,,0,0,0,,Сегуродан келген командалық көлік, өтінемін.
Dialogue: 0,0:08:36.18,0:08:38.10,Default,,0,0,0,,Бұл командалық көлік, өтінемін.
Dialogue: 0,0:08:38.18,0:08:41.64,Default,,0,0,0,,6-маршрут нүктесі алдында эскорт тобымен кездесу
Dialogue: 0,0:08:41.72,0:08:44.98,Default,,0,0,0,,Директор Торао және тағы 5 адам және Кайхуа Сай мырза расталды.
Dialogue: 0,0:08:45.77,0:08:49.52,Default,,0,0,0,,Автотұрақтан осы жерге дейінгі жолда қалыптыдан тыс ештеңе болған жоқ. Өтінемін, алға.
Dialogue: 0,0:08:50.02,0:08:51.28,Default,,0,0,0,,Командалық көлік Түсінікті
Dialogue: 0,0:08:51.36,0:08:55.82,Default,,0,0,0,,Маршрут қауіпсіздігін 5-тен 1-ге дейін тексеруді жалғастырыңыз.
Dialogue: 0,0:08:56.32,0:08:57.66,Default,,0,0,0,,Сегуро түсінді
Dialogue: 0,0:09:00.53,0:09:01.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:02.75,0:09:03.66,Default,,0,0,0,,(аяқ киімнің соғылған дыбысы)
Dialogue: 0,0:09:05.08,0:09:07.96,Default,,0,0,0,,Эй... Масазаки-сан!
Dialogue: 0,0:09:08.46,0:09:09.96,Default,,0,0,0,,(көлік есігінің ашылған дыбысы)
Dialogue: 0,0:09:10.04,0:09:10.84,Default,,0,0,0,,Кудзиин?
Dialogue: 0,0:09:12.09,0:09:14.26,Default,,0,0,0,,Куцзин! ше?
Dialogue: 0,0:09:14.84,0:09:17.34,Default,,0,0,0,,Не болды? Ол атылды ма?
Dialogue: 0,0:09:17.84,0:09:18.89,Default,,0,0,0,,Қияметсіз...
Dialogue: 0,0:09:20.72,0:09:22.35,Default,,0,0,0,,Масазаки мырза...
Dialogue: 0,0:09:22.43,0:09:23.77,Default,,0,0,0,,Көмек шақырмасаңыз
Dialogue: 0,0:09:26.60,0:09:28.15,Default,,0,0,0,,Бұл бірінші келеді...
Dialogue: 0,0:09:28.23,0:09:32.57,Default,,0,0,0,,Масазаки мырза... Мен бұл аяқты өзім атып тастадым.
Dialogue: 0,0:09:32.65,0:09:33.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:34.57,0:09:37.45,Default,,0,0,0,,Әйтеуір дұрыс шешім.
Dialogue: 0,0:09:37.95,0:09:41.20,Default,,0,0,0,,Мен мұны істемесем, осы уақытқа дейін келе алмас едім.
Dialogue: 0,0:09:42.33,0:09:45.33,Default,,0,0,0,,Жоқ, жоқ... бұл мүмкін емес.
Dialogue: 0,0:09:45.83,0:09:48.75,Default,,0,0,0,,Бұл өте жақсы емес, бірақ бұл қалыпты емес.
Dialogue: 0,0:09:51.34,0:09:52.42,Default,,0,0,0,,Ән әлемі…
Dialogue: 0,0:09:52.92,0:09:54.21,Default,,0,0,0,,Ән әлемі ме?
Dialogue: 0,0:09:54.71,0:09:58.18,Default,,0,0,0,,Мүмкін... бұл жалғыз нұсқа.
Dialogue: 0,0:09:58.26,0:10:01.18,Default,,0,0,0,,Кудзиин Кокуйо не істеді?
Dialogue: 0,0:10:02.14,0:10:03.10,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:10:04.14,0:10:08.48,Default,,0,0,0,,Құлағыңызға ақырын сөйлеңіз.
Dialogue: 0,0:10:09.85,0:10:14.11,Default,,0,0,0,,Ол әлдеқашан қираған сияқты.
Dialogue: 0,0:10:16.57,0:10:18.74,Default,,0,0,0,,Масазаки мырза... Аргх...
Dialogue: 0,0:10:18.82,0:10:20.53,Default,,0,0,0,,Оянба, Куджиин!
Dialogue: 0,0:10:20.62,0:10:21.99,Default,,0,0,0,,Мен оянамын...
Dialogue: 0,0:10:22.49,0:10:25.37,Default,,0,0,0,,Мен мұнда бизнес үшін келдім.
Dialogue: 0,0:10:26.12,0:10:30.88,Default,,0,0,0,,Радио да алынды... Мен Масазаки-санға әйтеуір айтуым керек еді.
Dialogue: 0,0:10:30.96,0:10:34.88,Default,,0,0,0,,Мен мұнда шарасыздан келдім, тіпті аяғымды атып тастадым.
Dialogue: 0,0:10:34.96,0:10:37.09,Default,,0,0,0,,Өйткені, Масазаки мырза
Dialogue: 0,0:10:37.17,0:10:41.39,Default,,0,0,0,,Сен менің санаулы достарымның бірісің.
Dialogue: 0,0:10:47.43,0:10:48.81,Default,,0,0,0,,Мен қашып бара жатырмын.
Dialogue: 0,0:10:49.56,0:10:50.44,Default,,0,0,0,,Не?
Dialogue: 0,0:10:50.52,0:10:52.27,Default,,0,0,0,,Барлығын тоқтатыңыз
Dialogue: 0,0:10:52.36,0:10:55.27,Default,,0,0,0,,Бұл жерден мүмкіндігінше тезірек қашыңыз.
Dialogue: 0,0:10:55.78,0:10:57.82,Default,,0,0,0,,Мені ұстауға тырыспа
Dialogue: 0,0:10:58.32,0:11:00.45,Default,,0,0,0,,Енді менімен енді араласпа.
Dialogue: 0,0:11:01.07,0:11:04.78,Default,,0,0,0,,Бұл адамдар сізге қарсы жасай алатын нәрсе емес.
Dialogue: 0,0:11:06.04,0:11:08.08,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Сіз
Dialogue: 0,0:11:08.16,0:11:11.04,Default,,0,0,0,,Түсініңізші, Масазаки-сан.
Dialogue: 0,0:11:11.58,0:11:13.71,Default,,0,0,0,,Менің ойымша, бұл сіз бен менің арамызда.
Dialogue: 0,0:11:15.09,0:11:18.88,Default,,0,0,0,,Мен ол жерде Масазаки-санмен кездескім келмейді.
Dialogue: 0,0:11:18.96,0:11:20.76,Default,,0,0,0,,Ақымақ...
Dialogue: 0,0:11:20.84,0:11:24.30,Default,,0,0,0,,Қан көп емес. Аяққа бір оқ тиіп өлтіруі мүмкін.
Dialogue: 0,0:11:25.14,0:11:26.43,Default,,0,0,0,,Директор Тораоға есеп беру...
Dialogue: 0,0:11:28.47,0:11:30.64,Default,,0,0,0,,Масазаки-сан түсінді, солай ма?
Dialogue: 0,0:11:31.23,0:11:32.40,Default,,0,0,0,,Егер сіз ер адам болсаңыз
Dialogue: 0,0:11:32.48,0:11:33.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:33.52,0:11:35.56,Default,,0,0,0,,Дәл солай.
Dialogue: 0,0:11:35.65,0:11:37.78,Default,,0,0,0,,Жыныстық сезім
Dialogue: 0,0:11:38.40,0:11:39.61,Default,,0,0,0,,Не айтып тұрсың...
Dialogue: 0,0:11:39.69,0:11:44.16,Default,,0,0,0,,Мен шыдамдылық танытып, көбірек жалғастыруым керек деп ойлай отырып.
Dialogue: 0,0:11:44.24,0:11:48.99,Default,,0,0,0,,Керісінше тезірек шығарғым келеді.
Dialogue: 0,0:11:49.08,0:11:51.50,Default,,0,0,0,,Дәл солай сезіледі.
Dialogue: 0,0:11:52.00,0:11:54.58,Default,,0,0,0,,Бұл жақсы сезінеді, солай емес пе?
Dialogue: 0,0:11:55.58,0:11:58.55,Default,,0,0,0,,Бұдан басқа мысал желісі бар.
Dialogue: 0,0:11:59.05,0:12:01.63,Default,,0,0,0,,Одан асып кетсең толып кетеді.
Dialogue: 0,0:12:01.72,0:12:03.76,Default,,0,0,0,,Бұл соңғы толқын суы.
Dialogue: 0,0:12:03.84,0:12:06.60,Default,,0,0,0,,Бірақ оны кесіп өтсеңіз, бәрі түсінеді, солай ма?
Dialogue: 0,0:12:07.10,0:12:08.85,Default,,0,0,0,,Әлі толып кетпесе де
Dialogue: 0,0:12:08.93,0:12:11.64,Default,,0,0,0,,Аа, мен енді мұны істей алмаймын. Бұл жігіт қазір кетуі керек.
Dialogue: 0,0:12:11.73,0:12:12.89,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:12:13.39,0:12:16.48,Default,,0,0,0,,Сіз мұның біткенін анық көресіз, солай ма?
Dialogue: 0,0:12:16.98,0:12:19.86,Default,,0,0,0,,Шынымен де... солай.
Dialogue: 0,0:12:21.07,0:12:21.99,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:26.16,0:12:26.78,Default,,0,0,0,,Эй...
Dialogue: 0,0:12:27.87,0:12:28.95,Default,,0,0,0,,Куцзин…
Dialogue: 0,0:12:29.45,0:12:33.79,Default,,0,0,0,,Масазаки мырза, мен сізге айттым.
Dialogue: 0,0:12:38.84,0:12:39.80,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:12:44.09,0:12:45.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:46.84,0:12:51.68,Default,,0,0,0,,Ахх!
Dialogue: 0,0:12:58.56,0:12:59.98,Default,,0,0,0,,Эскорт командасын өтінемін!
Dialogue: 0,0:13:00.07,0:13:01.98,Default,,0,0,0,,Маршрут қауіпсіздігі Оны кез келген адам ала ала ма?
Dialogue: 0,0:13:02.07,0:13:03.49,Default,,0,0,0,,Сегуро!
Dialogue: 0,0:13:06.61,0:13:07.66,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:13:11.41,0:13:16.08,Default,,0,0,0,,Құлағыңызға ақырын сөйлеңіз...
Dialogue: 0,0:13:17.67,0:13:21.09,Default,,0,0,0,,Кездейсоқ кездесіп қалған қасынан өтіп бара жатқан адамдарға
Dialogue: 0,0:13:21.17,0:13:23.34,Default,,0,0,0,,Ол сізді өз-өзіне қол жұмсауға итермеледі ме?
Dialogue: 0,0:13:24.51,0:13:26.55,Default,,0,0,0,,Барлығы осы!
Dialogue: 0,0:13:28.80,0:13:29.64,Default,,0,0,0,,Аһ!
Dialogue: 0,0:13:29.72,0:13:33.14,Default,,0,0,0,,Ха ха ха... ол қайда?
Dialogue: 0,0:13:35.39,0:13:36.98,Default,,0,0,0,,Сегуроның командалық көлігі
Dialogue: 0,0:13:37.56,0:13:39.15,Default,,0,0,0,,Сегуро! сен қайдасың?
Dialogue: 0,0:13:39.73,0:13:42.36,Default,,0,0,0,,NHC үлкен залы сахна сыртында
Dialogue: 0,0:13:42.44,0:13:44.90,Default,,0,0,0,,Мен сонда 3 минуттан кейін боламын. Жағдайды хабарлау.
Dialogue: 0,0:13:45.49,0:13:50.32,Default,,0,0,0,,Маршрут тобының жоқтығын растағаннан кейін мен директор Тораоға оралдым.
Dialogue: 0,0:13:50.41,0:13:52.58,Default,,0,0,0,,Неге екені белгісіз, Сай ханым қасымда болды.
Dialogue: 0,0:13:53.29,0:13:57.21,Default,,0,0,0,,Іс дұрыс болмады, сондықтан мен бір нәрсенің артына тығылып отырмын.
Dialogue: 0,0:13:57.29,0:13:59.58,Default,,0,0,0,,Әлгі әйел ақымақ. Сақ болыңыз!
Dialogue: 0,0:13:59.67,0:14:01.25,Default,,0,0,0,,Куцзиин храмы жойылды
Dialogue: 0,0:14:01.75,0:14:03.09,Default,,0,0,0,,Эскорт тобымен кездесуге бола ма?
Dialogue: 0,0:14:03.17,0:14:04.88,Default,,0,0,0,,Бұл мүмкін емес...
Dialogue: 0,0:14:05.38,0:14:09.72,Default,,0,0,0,,Мен неге әкімшілер қалыпты сөйлесе алатынын түсінбеймін.
Dialogue: 0,0:14:10.64,0:14:12.60,Default,,0,0,0,,Бұл... Бұл...
Dialogue: 0,0:14:13.18,0:14:14.56,Default,,0,0,0,,Зорлық-зомбылық...
Dialogue: 0,0:14:16.43,0:14:19.85,Default,,0,0,0,,Мен кеткенше жасырын бол, Сегуро!
Dialogue: 0,0:14:19.94,0:14:21.90,Default,,0,0,0,,Жоқ... Мен байқадым.
Dialogue: 0,0:14:21.98,0:14:24.15,Default,,0,0,0,,Олай болса, қаш! Қазір!
Dialogue: 0,0:14:24.23,0:14:27.57,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:14:28.90,0:14:32.16,Default,,0,0,0,,Ай Куйоны ұстау үшін әкімшілермен жұмыс жасаңыз.
Dialogue: 0,0:14:32.24,0:14:34.16,Default,,0,0,0,,Тоқта! Бұл тапсырыс!
Dialogue: 0,0:14:36.00,0:14:36.54,Default,,0,0,0,,Кесу
Dialogue: 0,0:14:36.62,0:14:38.83,Default,,0,0,0,,Сегуро... Сегуро!
Dialogue: 0,0:14:38.91,0:14:39.42,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:40.54,0:14:41.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:42.42,0:14:45.09,Default,,0,0,0,,Сегуро! Директор!
Dialogue: 0,0:14:45.17,0:14:46.59,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:14:49.68,0:14:52.60,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:14:56.43,0:14:59.31,Default,,0,0,0,,Эй... эй, эй
Dialogue: 0,0:15:03.48,0:15:04.86,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба?
Dialogue: 0,0:15:08.49,0:15:09.65,Default,,0,0,0,,Контроллер…
Dialogue: 0,0:15:10.15,0:15:11.61,Default,,0,0,0,,Торао мырза!
Dialogue: 0,0:15:22.58,0:15:23.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:29.84,0:15:30.88,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:30.97,0:15:32.89,Default,,0,0,0,,Ааааааа!
Dialogue: 0,0:15:34.68,0:15:37.51,Default,,0,0,0,,Сегуро... Сегуро қайда?
Dialogue: 0,0:15:43.90,0:15:46.15,Default,,0,0,0,,Сегуро!
Dialogue: 0,0:16:05.25,0:16:10.05,Default,,0,0,0,,Оқиға орнында төбелес белгілері байқалмады, денеден түтінге реакция пайда болды.
Dialogue: 0,0:16:10.13,0:16:14.93,Default,,0,0,0,,Бағалау нәтижесінде өсиеттегі қолжазбалардың барлығы жеке тұлғалардың қолжазбаларымен сәйкес келді.
Dialogue: 0,0:16:15.01,0:16:15.84,Default,,0,0,0,,Уф!
Dialogue: 0,0:16:15.93,0:16:18.85,Default,,0,0,0,,Бұл... бұл жаппай суицид емес еді.
Dialogue: 0,0:16:18.93,0:16:22.35,Default,,0,0,0,,Куйо: Ай есімді әйел бәрін өлтірді.
Dialogue: 0,0:16:22.43,0:16:26.98,Default,,0,0,0,,Содан кейін ол әкімшілік қызметкер Йома Сегуроны ұрлап кетіп, жоғалып кетті!
Dialogue: 0,0:16:27.61,0:16:28.73,Default,,0,0,0,,Прокурор Масазаки...
Dialogue: 0,0:16:29.82,0:16:31.57,Default,,0,0,0,,Өзіңді қолыңа ал.
Dialogue: 0,0:16:31.65,0:16:33.82,Default,,0,0,0,,Мен бұл шок екенін білемін.
Dialogue: 0,0:16:33.90,0:16:36.66,Default,,0,0,0,,Ол инспектор Куцзиннің өз-өзіне қол жұмсағанын көз алдында көргені айтылады.
Dialogue: 0,0:16:36.74,0:16:38.41,Default,,0,0,0,,Сіздің айғақтарыңыздың негізінде...
Dialogue: 0,0:16:40.54,0:16:41.75,Default,,0,0,0,,(перделердің ашылған дыбысы)
Dialogue: 0,0:16:47.33,0:16:49.34,Default,,0,0,0,,Анашым, дайындалыңыз.
Dialogue: 0,0:16:49.42,0:16:50.80,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:16:58.39,0:16:59.81,Default,,0,0,0,,(Заттарды сыпыру дыбысы)
Dialogue: 0,0:17:03.77,0:17:04.81,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:08.23,0:17:10.65,Default,,0,0,0,,Әлі жоқ... Әлі біткен жоқ.
Dialogue: 0,0:17:10.73,0:17:14.53,Default,,0,0,0,,Егер олар оны өлтірмек болса, оны сол жерде өзін-өзі өлтіруге мәжбүрлеу керек еді.
Dialogue: 0,0:17:15.90,0:17:18.49,Default,,0,0,0,,Сегуро әлі тірі
Dialogue: 0,0:17:22.49,0:17:24.20,Default,,0,0,0,,(Смартфонның діріл дыбысы)
Dialogue: 0,0:17:26.92,0:17:27.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:39.30,0:17:40.30,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:42.22,0:17:43.47,Default,,0,0,0,,Мағынасыздық
Dialogue: 0,0:17:45.02,0:17:46.27,Default,,0,0,0,,Қарау...
Dialogue: 0,0:17:46.77,0:17:48.15,Default,,0,0,0,,Масазаки-сан
Dialogue: 0,0:17:48.98,0:17:50.77,Default,,0,0,0,,Ән әлемі!
Dialogue: 0,0:17:51.90,0:17:53.53,Default,,0,0,0,,Масазаки мырза, сіз мені тыңдай аласыз ба?
Dialogue: 0,0:17:54.03,0:17:57.78,Default,,0,0,0,,Әй, батырдың оқиғасы есіңде ме?
Dialogue: 0,0:17:57.86,0:18:02.87,Default,,0,0,0,,Елге ешкім көмектеспесе де, Түсінбесе де
Dialogue: 0,0:18:02.95,0:18:06.62,Default,,0,0,0,,Дүниені өзі құтқаратын батыр туралы
Dialogue: 0,0:18:09.37,0:18:10.54,Default,,0,0,0,,Сегуро?
Dialogue: 0,0:18:10.63,0:18:12.54,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу...
Dialogue: 0,0:18:12.63,0:18:15.05,Default,,0,0,0,,Одан да керемет нәрсе бар.
Dialogue: 0,0:18:16.26,0:18:18.05,Default,,0,0,0,,Сіз бұл не екенін білесіз бе?
Dialogue: 0,0:18:18.88,0:18:23.81,Default,,0,0,0,,Батырлардың арманы мен сезімін халық түсінуі үшін.
Dialogue: 0,0:18:24.47,0:18:28.10,Default,,0,0,0,,Барлығы түсінеді, барлығы көмектеседі
Dialogue: 0,0:18:28.60,0:18:30.69,Default,,0,0,0,,Бәріміз бірге әлемді құтқарайық
Dialogue: 0,0:18:31.52,0:18:34.69,Default,,0,0,0,,Ең кереметі осы емес пе?
Dialogue: 0,0:18:35.28,0:18:36.69,Default,,0,0,0,,Не істеп жатырсың...
Dialogue: 0,0:18:36.78,0:18:40.70,Default,,0,0,0,,Мен Масазаки мырзаның түсінгенін қалаймын.
Dialogue: 0,0:18:41.49,0:18:46.33,Default,,0,0,0,,Эй, Масазаки-сан, біз ондай емеспіз.
Dialogue: 0,0:18:46.91,0:18:51.33,Default,,0,0,0,,Менің қазір істейтін ісім өте нашар.
Dialogue: 0,0:18:51.92,0:18:56.26,Default,,0,0,0,,Сондықтан Масазаки-сан саған тоқта деп айтатын шығар.
Dialogue: 0,0:18:57.88,0:18:59.63,Default,,0,0,0,,Өйткені бұл жаман.
Dialogue: 0,0:19:00.43,0:19:01.30,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:19:02.80,0:19:04.72,Default,,0,0,0,,Бұл детектив Цуцуйдің қалтасында.
Dialogue: 0,0:19:04.81,0:19:05.72,Default,,0,0,0,,Ха…
Dialogue: 0,0:19:08.31,0:19:10.14,Default,,0,0,0,,Масазаки мырза жақсы адам болса
Dialogue: 0,0:19:10.23,0:19:12.81,Default,,0,0,0,,Ол маған дұрыс емес нәрселерді жасауды доғаруды айтады.
Dialogue: 0,0:19:13.40,0:19:15.82,Default,,0,0,0,,Эй... Куйо, тоқта...
Dialogue: 0,0:19:16.53,0:19:20.57,Default,,0,0,0,,Бірақ мен оның дұрыс емес екенін де білемін.
Dialogue: 0,0:19:20.65,0:19:21.99,Default,,0,0,0,,Уф... (Куйо) Дұрыс па?
Dialogue: 0,0:19:22.07,0:19:24.62,Default,,0,0,0,,Біз де дәл осылай ойлаймыз
Dialogue: 0,0:19:24.70,0:19:26.03,Default,,0,0,0,,Тоқташы... Эй!
Dialogue: 0,0:19:26.12,0:19:28.25,Default,,0,0,0,,Бұл дұрыс емес
Dialogue: 0,0:19:28.33,0:19:30.16,Default,,0,0,0,,Бұл өте жақсы емес.
Dialogue: 0,0:19:30.25,0:19:31.79,Default,,0,0,0,,Өте өте...
Dialogue: 0,0:19:32.42,0:19:33.83,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:19:34.33,0:19:39.13,Default,,0,0,0,,Сондықтан мен Масазаки мырзамен бір ғана айырмашылық бар.
Dialogue: 0,0:19:40.97,0:19:43.18,Default,,0,0,0,,Ән әлемі!
Dialogue: 0,0:19:43.76,0:19:46.05,Default,,0,0,0,,Мен жаман адаммын
Dialogue: 0,0:19:47.76,0:19:48.72,Default,,0,0,0,,Ааааааа!
Dialogue: 0,0:19:48.81,0:19:50.27,Default,,0,0,0,,Оны қолданып көргіңіз келе ме? (Асума) Иә
Dialogue: 0,0:19:51.39,0:19:55.19,Default,,0,0,0,,Менің ойымша, бұл шын мәнінде біздің арамыздағы жалғыз айырмашылық.
Dialogue: 0,0:19:55.98,0:19:57.02,Default,,0,0,0,,Эй, Масазаки-сан
Dialogue: 0,0:19:57.52,0:20:00.74,Default,,0,0,0,,Иттерді жақсы көретіндер мен мысықтарды жақсы көретіндер
Dialogue: 0,0:20:00.82,0:20:02.74,Default,,0,0,0,,Олар мүлдем үйлеспейді ме?
Dialogue: 0,0:20:02.82,0:20:04.70,Default,,0,0,0,,Ән әлемі! Тоқта!
Dialogue: 0,0:20:04.78,0:20:05.66,Default,,0,0,0,,(Сегуроның айқайы)
Dialogue: 0,0:20:05.74,0:20:07.83,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:20:07.91,0:20:10.00,Default,,0,0,0,,Бір-бірімізді түсінсек
Dialogue: 0,0:20:10.08,0:20:12.50,Default,,0,0,0,,Шарм сізге жеткізілетініне сенімдімін.
Dialogue: 0,0:20:12.58,0:20:14.12,Default,,0,0,0,,Бізде де солай.
Dialogue: 0,0:20:15.25,0:20:17.75,Default,,0,0,0,,Жақсыны ұнататындар мен жаманды ұнататындар
Dialogue: 0,0:20:18.42,0:20:21.22,Default,,0,0,0,,Бұл жалғыз айырмашылық
Dialogue: 0,0:20:22.09,0:20:23.51,Default,,0,0,0,,Сонымен Масазаки-сан...
Dialogue: 0,0:20:23.59,0:20:25.30,Default,,0,0,0,,Ән әлемі... Ән әлемі!
Dialogue: 0,0:20:26.01,0:20:27.10,Default,,0,0,0,,Ойлау
Dialogue: 0,0:20:27.18,0:20:28.10,Default,,0,0,0,,(Сегуроның айқайы)
Dialogue: 0,0:20:28.18,0:20:30.10,Default,,0,0,0,,Бұл болмас еді...
Dialogue: 0,0:20:31.43,0:20:33.94,Default,,0,0,0,,Мен мұны не үшін істеп жатырмын?
Dialogue: 0,0:20:34.44,0:20:36.81,Default,,0,0,0,,Мен Масазаки мырзаның бұл туралы ойлағанын қалаймын.
Dialogue: 0,0:20:36.90,0:20:38.27,Default,,0,0,0,,Мен түсінгеніңізді қалаймын.
Dialogue: 0,0:20:38.36,0:20:40.23,Default,,0,0,0,,Ән әлемі...
Dialogue: 0,0:20:41.03,0:20:43.28,Default,,0,0,0,,Мұны істеудің қажеті жоқ, өйткені бұл жаман адамдар жасайтын нәрсе.
Dialogue: 0,0:20:43.36,0:20:45.07,Default,,0,0,0,,Мен сенің бұлай ойлағаныңды қаламаймын.
Dialogue: 0,0:20:45.57,0:20:47.95,Default,,0,0,0,,Есі дұрыс адам түсіне алмайды
Dialogue: 0,0:20:48.03,0:20:49.83,Default,,0,0,0,,Мен сенің бұлай ойлағаныңды қаламаймын.
Dialogue: 0,0:20:50.58,0:20:52.96,Default,,0,0,0,,Жамандықтың мағынасы бар.
Dialogue: 0,0:20:53.58,0:20:54.75,Default,,0,0,0,,Тоқтатыңыз...
Dialogue: 0,0:20:54.83,0:20:57.54,Default,,0,0,0,,Бірақ мен сенің мұны бірден түсінгеніңді қаламаймын.
Dialogue: 0,0:20:57.63,0:21:00.38,Default,,0,0,0,,Мен мұны өзімшіл деп білемін.
Dialogue: 0,0:21:00.88,0:21:05.84,Default,,0,0,0,,Өйткені Масазаки мырза осы жақсы қоғамда жақсы нәрселердің ортасында өсті⸺
Dialogue: 0,0:21:05.93,0:21:08.14,Default,,0,0,0,,Мен жақсы адаммын.
Dialogue: 0,0:21:08.64,0:21:11.72,Default,,0,0,0,,Сіз ешқашан жаман нәрсе туралы ойлаған емессіз, солай ма?
Dialogue: 0,0:21:12.22,0:21:15.48,Default,,0,0,0,,Сіз зұлымдықтың не екенін білмейсіз бе?
Dialogue: 0,0:21:15.56,0:21:16.23,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:21:16.31,0:21:18.94,Default,,0,0,0,,Ендеше бүгіннен бастап ойланыңыз.
Dialogue: 0,0:21:19.44,0:21:23.40,Default,,0,0,0,,Өміріңізде бірінші рет зұлымдыққа шындап қарсы тұруға тырысыңыз.
Dialogue: 0,0:21:23.90,0:21:26.74,Default,,0,0,0,,Мен саған қолымнан келгенше көмектесемін.
Dialogue: 0,0:21:27.53,0:21:29.16,Default,,0,0,0,,Қарашы, Масазаки-сан, сен маған қарап тұрсың ба?
Dialogue: 0,0:21:29.24,0:21:29.74,Default,,0,0,0,,Ән әлемі…
Dialogue: 0,0:21:29.83,0:21:32.37,Default,,0,0,0,,Міне. Бұл жаман.
Dialogue: 0,0:21:39.21,0:21:42.09,Default,,0,0,0,,Неліктен біреуді өлтіру дұрыс емес?
Dialogue: 0,0:21:42.59,0:21:45.47,Default,,0,0,0,,Адамдарды тірі қалдыру неліктен жақсы?
Dialogue: 0,0:21:46.05,0:21:48.55,Default,,0,0,0,,Неліктен? неге?
Dialogue: 0,0:21:49.22,0:21:51.26,Default,,0,0,0,,Енді, Масазаки мырза, ойланыңыз.
Dialogue: 0,0:21:51.85,0:21:52.85,Default,,0,0,0,,Жаман деген не?
Dialogue: 0,0:21:52.93,0:21:54.27,Default,,0,0,0,,Тоқтатыңыз...
Dialogue: 0,0:21:54.85,0:21:56.23,Default,,0,0,0,,Жамандық деген не?
Dialogue: 0,0:21:59.35,0:22:02.65,Default,,0,0,0,,Мен мұны істеймін... Себебі мен бұл туралы ойлаймын...
Dialogue: 0,0:22:05.74,0:22:08.95,Default,,0,0,0,,Енді жоқ... тоқтат!
Dialogue: 0,0:22:09.45,0:22:12.12,Default,,0,0,0,,Ах... ахх! (Куйо) Жарайды, түсінетініне сенімдімін.
Dialogue: 0,0:22:12.20,0:22:15.04,Default,,0,0,0,,Түсінбейтін ештеңе жоқ.
Dialogue: 0,0:22:15.54,0:22:18.58,Default,,0,0,0,,Өйткені бәріміз бір адамбыз.
Dialogue: 0,0:22:19.46,0:22:22.79,Default,,0,0,0,,Масазаки мырза, сіз де түсінесіз.
Dialogue: 0,0:22:23.50,0:22:26.17,Default,,0,0,0,,сөзсіз
Dialogue: 0,0:22:26.26,0:22:27.34,Default,,0,0,0,,Себебі мен түсінемін!
Dialogue: 0,0:22:27.84,0:22:30.55,Default,,0,0,0,,(Хитоми мен Асуманың күлкісі)
Dialogue: 0,0:22:31.05,0:22:33.06,Default,,0,0,0,,♪～
Dialogue: 0,0:23:57.64,0:23:59.64,Default,,0,0,0,,～♪
