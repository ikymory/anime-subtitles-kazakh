Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:17.72,0:00:20.39,Default,,0,0,0,,Метрополитендегі шартты желілердің жұмыс жағдайы
Dialogue: 0,0:00:20.47,0:00:23.48,Default,,0,0,0,,Адам өліміне әкелген апаттарға байланысты көптеген желілер тоқтатылды.
Dialogue: 0,0:00:23.56,0:00:25.44,Default,,0,0,0,,Көптеген бөлімдер жабық
Dialogue: 0,0:00:26.19,0:00:27.61,Default,,0,0,0,,Сонымен қатар, жұмысты қалпына келтіруге қатысты
Dialogue: 0,0:00:27.69,0:00:29.07,Default,,0,0,0,,Болашағы белгісіз аймақтарда...
Dialogue: 0,0:00:29.15,0:00:30.40,Default,,0,0,0,,Ағарту туралы декларациядан
Dialogue: 0,0:00:30.48,0:00:32.15,Default,,0,0,0,,24 сағат өтті
Dialogue: 0,0:00:32.24,0:00:35.36,Default,,0,0,0,,Жапонияда осы уақытқа дейін хабарланған суицидтердің саны
Dialogue: 0,0:00:35.45,0:00:39.87,Default,,0,0,0,,Адамдардың саны 237-ге дейін өсті, бұл қалыпты саннан төрт есе.
Dialogue: 0,0:00:39.95,0:00:42.20,Default,,0,0,0,,Ал ол адам кім?
Dialogue: 0,0:00:42.79,0:00:45.42,Default,,0,0,0,,Кай Кайхуа мен оның әріптестеріне не болды?
Dialogue: 0,0:00:45.50,0:00:46.75,Default,,0,0,0,,Мен оны әлі түсінген жоқпын.
Dialogue: 0,0:00:47.33,0:00:52.13,Default,,0,0,0,,Сайдың видеосы интернет арқылы таратылды және ол жаңа аймақтағы үкімет ғимаратында болмаған.
Dialogue: 0,0:00:52.21,0:00:54.51,Default,,0,0,0,,Оқиға орнында болды деп есептелетін әріптестер
Dialogue: 0,0:00:54.59,0:00:56.76,Default,,0,0,0,,Абыр-сабыр басылғанша ол жоғалып кетті.
Dialogue: 0,0:00:57.47,0:00:59.14,Default,,0,0,0,,Ол фанат сияқты.
Dialogue: 0,0:00:59.22,0:01:01.47,Default,,0,0,0,,Шын мәнінде, осындай нәрсе
Dialogue: 0,0:01:01.56,0:01:06.39,Default,,0,0,0,,Секіргендердің барлығы да Сай айдап салған дінге сенушілер.
Dialogue: 0,0:01:06.90,0:01:09.52,Default,,0,0,0,,Оны фанатизм деп тану дұрыс па?
Dialogue: 0,0:01:09.61,0:01:12.11,Default,,0,0,0,,Бұл нені білдіреді? Сегуро-кун
Dialogue: 0,0:01:12.19,0:01:14.57,Default,,0,0,0,,Бұрын хабарланғандай
Dialogue: 0,0:01:14.65,0:01:17.11,Default,,0,0,0,,Жапония суицид деңгейі жоғары ел.
Dialogue: 0,0:01:17.86,0:01:19.74,Default,,0,0,0,,Суицидтік ойларды алып тастасақ
Dialogue: 0,0:01:19.82,0:01:22.62,Default,,0,0,0,,Күтпеген жағдайлар туындауы мүмкін.
Dialogue: 0,0:01:22.70,0:01:24.12,Default,,0,0,0,,(үстелді түрту дыбысы)
Dialogue: 0,0:01:26.33,0:01:29.67,Default,,0,0,0,,Мәселе Сайдың мәлімдемесінің мазмұны емес.
Dialogue: 0,0:01:29.75,0:01:31.67,Default,,0,0,0,,Ең маңыздысы
Dialogue: 0,0:01:32.25,0:01:34.05,Default,,0,0,0,,Мәлімдеме жасаған адам
Dialogue: 0,0:01:34.13,0:01:37.68,Default,,0,0,0,,Бұл біздің бақылауымыздан тыс.
Dialogue: 0,0:01:38.34,0:01:39.18,Default,,0,0,0,,Моринага-кун
Dialogue: 0,0:01:39.80,0:01:41.93,Default,,0,0,0,,Сайды ұстай аласың ба?
Dialogue: 0,0:01:42.01,0:01:46.94,Default,,0,0,0,,Бұл қарсыластың мінез-құлқына байланысты, бірақ мұны істеуден басқа амалыңыз жоқ деп ойлаймын.
Dialogue: 0,0:01:51.02,0:01:53.02,Default,,0,0,0,,♪～
Dialogue: 0,0:02:18.88,0:02:20.89,Default,,0,0,0,,～♪
Dialogue: 0,0:02:24.51,0:02:27.73,Default,,0,0,0,,Бірақ Номару мырза да оңай айтады.
Dialogue: 0,0:02:27.81,0:02:29.85,Default,,0,0,0,,Сіз полициямен қателесесіз бе?
Dialogue: 0,0:02:29.94,0:02:32.11,Default,,0,0,0,,Командалық және тергеу құқықтарына ие болғанға дейін
Dialogue: 0,0:02:32.19,0:02:33.19,Default,,0,0,0,,Бұны дұрыс емес деп айта алмаймын
Dialogue: 0,0:02:33.77,0:02:36.44,Default,,0,0,0,,Егер оны ашық түрде қолдануға болатын болса, бұл проблема болмас еді.
Dialogue: 0,0:02:37.40,0:02:40.24,Default,,0,0,0,,Ха... Жағдайды реттейік.
Dialogue: 0,0:02:41.66,0:02:45.49,Default,,0,0,0,,Өздеріңіз білетіндей, жаңа аймақ тұжырымдамасы үлкен жоспар.
Dialogue: 0,0:02:45.99,0:02:49.46,Default,,0,0,0,,2 миллион тұрғын және 600 шаршы шақырым жер
Dialogue: 0,0:02:49.54,0:02:53.75,Default,,0,0,0,,Ол барлық салалардағы даму жоспарларын қамтиды.
Dialogue: 0,0:02:54.25,0:02:58.01,Default,,0,0,0,,Бірақ бірінші кезекте жаңа аймақ мүлде басқа мақсатты көздейді.
Dialogue: 0,0:02:58.09,0:03:00.01,Default,,0,0,0,,Ұлттық зертхана
Dialogue: 0,0:03:00.09,0:03:01.01,Default,,0,0,0,,Хмм
Dialogue: 0,0:03:01.51,0:03:04.93,Default,,0,0,0,,Жаңа аумақта негізгі мақсат жаңа заңды жүзеге асыру болып табылады.
Dialogue: 0,0:03:05.01,0:03:07.89,Default,,0,0,0,,Осы мақсатта барынша күш жұмсалуда.
Dialogue: 0,0:03:08.47,0:03:12.98,Default,,0,0,0,,Басқаша айтқанда, жаңа аймақтағы ең берік және ең күшті қару
Dialogue: 0,0:03:13.06,0:03:14.90,Default,,0,0,0,,Заң және жүйе
Dialogue: 0,0:03:15.73,0:03:19.90,Default,,0,0,0,,Бұл жай полицияның Сайды тұтқындауы сияқты оңай емес және бәрі аяқталды.
Dialogue: 0,0:03:19.99,0:03:23.91,Default,,0,0,0,,Сайдың заңсыздығына күмән келтірудің өзі қиын
Dialogue: 0,0:03:23.99,0:03:25.70,Default,,0,0,0,,Бұл адамдардың ризашылық сезімі жоқ; тек әртүрлі талап қояды
Dialogue: 0,0:03:25.78,0:03:27.41,Default,,0,0,0,,Қазіргі жапон заңы бойынша
Dialogue: 0,0:03:27.99,0:03:31.41,Default,,0,0,0,,«Өзін-өзі өлтіруді мойындау» қылмыс ретінде айыпталмайды
Dialogue: 0,0:03:32.00,0:03:33.75,Default,,0,0,0,,Топтық секіру
Dialogue: 0,0:03:33.83,0:03:35.88,Default,,0,0,0,,202-бап қолдануға болады ма?
Dialogue: 0,0:03:36.38,0:03:39.42,Default,,0,0,0,,Тапсырыспен өлтіру және келісім бойынша кісі өлтіру мүмкін емес еді.
Dialogue: 0,0:03:40.01,0:03:40.88,Default,,0,0,0,,Секіру кезінде
Dialogue: 0,0:03:40.97,0:03:43.64,Default,,0,0,0,,Мені біреу итеріп жібергендей емес.
Dialogue: 0,0:03:43.72,0:03:46.35,Default,,0,0,0,,Жағдайға тікелей әсер еткен адам жоқ.
Dialogue: 0,0:03:46.93,0:03:50.10,Default,,0,0,0,,Мүмкіндік болса, ол көмектесу немесе қолдау көрсету.
Dialogue: 0,0:03:50.18,0:03:52.77,Default,,0,0,0,,Өз-өзіне қол жұмсауды дәлелдеу де қиын болар еді.
Dialogue: 0,0:03:52.85,0:03:55.02,Default,,0,0,0,,Өлгенге ауыз жоқ па?
Dialogue: 0,0:03:55.10,0:03:58.27,Default,,0,0,0,,Өйткені, арандатушылықты дәлелдеуден басқа амалымыз жоқ.
Dialogue: 0,0:03:58.36,0:03:59.03,Default,,0,0,0,,Иә
Dialogue: 0,0:03:59.61,0:04:02.65,Default,,0,0,0,,Электрондық хаттар, құжаттар және т.б. табылса, іс қозғауға болады.
Dialogue: 0,0:04:03.15,0:04:08.28,Default,,0,0,0,,Сайдың өз-өзіне қол жұмсаған 64 адамға көмек көрсетуі - Олардың іздерін табыңыз
Dialogue: 0,0:04:08.37,0:04:12.62,Default,,0,0,0,,Егер айыптар расталса, мен жария түрде келісім жасай аламын ба?
Dialogue: 0,0:04:13.54,0:04:14.62,Default,,0,0,0,,Сіз оны таба аласыз ба?
Dialogue: 0,0:04:14.71,0:04:16.54,Default,,0,0,0,,Жұмыс күші қажет
Dialogue: 0,0:04:16.63,0:04:19.30,Default,,0,0,0,,Мүмкіндігінше толық уақытты тергеушілер
Dialogue: 0,0:04:19.38,0:04:22.01,Default,,0,0,0,,Арнайы тергеу аясында? Полиция?
Dialogue: 0,0:04:22.09,0:04:23.51,Default,,0,0,0,,Екеуінен де жақсырақ
Dialogue: 0,0:04:23.59,0:04:26.68,Default,,0,0,0,,2-3 күн ішінде белгілі бір дәрежеде дайын болуы керек.
Dialogue: 0,0:04:26.76,0:04:28.81,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:04:28.89,0:04:32.43,Default,,0,0,0,,Бұл шынымен де біртүрлі оқиға.
Dialogue: 0,0:04:32.52,0:04:35.35,Default,,0,0,0,,64 адамды өз-өзіне қол жұмсауға итермеледі
Dialogue: 0,0:04:35.44,0:04:39.82,Default,,0,0,0,,200-ден астам адамның өз-өзіне қол жұмсауына себепкер болған адам болса да.
Dialogue: 0,0:04:39.90,0:04:44.20,Default,,0,0,0,,Барлық аспектілерді қарастыратын болсақ, оны басқаратын заңдар жоқтың қасы.
Dialogue: 0,0:04:44.70,0:04:48.45,Default,,0,0,0,,Бұл заңның кемшілігі ме, әлде...
Dialogue: 0,0:04:50.12,0:04:51.91,Default,,0,0,0,,Эй, Масазаки-кун
Dialogue: 0,0:04:52.50,0:04:57.79,Default,,0,0,0,,Өз-өзіне қол жұмсау шынымен жаман нәрсе ме?
Dialogue: 0,0:05:02.26,0:05:03.72,Default,,0,0,0,,Қоғамның реакциясы қандай?
Dialogue: 0,0:05:03.80,0:05:05.97,Default,,0,0,0,,Көпшілік қарсы болғанымен...
Dialogue: 0,0:05:09.68,0:05:10.97,Default,,0,0,0,,90 000 адам
Dialogue: 0,0:05:11.06,0:05:13.35,Default,,0,0,0,,Менің ойымша, сіз эвтаназия туралы ойлайсыз.
Dialogue: 0,0:05:13.93,0:05:17.69,Default,,0,0,0,,Эвтаназия пассивті эвтаназия және белсенді эвтаназия болып екіге бөлінеді.
Dialogue: 0,0:05:17.77,0:05:19.61,Default,,0,0,0,,Кеңінен екі түрге бөлінеді
Dialogue: 0,0:05:19.69,0:05:24.28,Default,,0,0,0,,Екеуі де суицид болып табылады, өйткені олар науқастың өз еркімен жүзеге асырылады.
Dialogue: 0,0:05:24.36,0:05:25.86,Default,,0,0,0,,Пассивті эвтаназия
Dialogue: 0,0:05:25.95,0:05:30.28,Default,,0,0,0,,Дүние жүзінің көптеген елдерінде өмірінің соңына қарай күтім жасау түрі ретінде қазірдің өзінде қолданылған.
Dialogue: 0,0:05:30.37,0:05:32.49,Default,,0,0,0,,Көптеген елдер заң шығарды
Dialogue: 0,0:05:32.58,0:05:36.21,Default,,0,0,0,,Керісінше, белсенді эвтаназияны ресми түрде мойындайтын елдер
Dialogue: 0,0:05:36.29,0:05:37.67,Default,,0,0,0,,Әлі де көп емес
Dialogue: 0,0:05:37.75,0:05:38.96,Default,,0,0,0,,Соңғы жылдары...
Dialogue: 0,0:05:39.04,0:05:41.00,Default,,0,0,0,,Ақпараттандырылған келісімнің нысаны ретінде
Dialogue: 0,0:05:41.09,0:05:43.17,Default,,0,0,0,,Ол да талқылау тақырыбына айналып отыр.
Dialogue: 0,0:05:43.25,0:05:45.17,Default,,0,0,0,,Менің айтқым келгені
Dialogue: 0,0:05:45.80,0:05:49.59,Default,,0,0,0,,Егер Жапония әлемдегі жалғыз суицид заңы болса, мен екіленер едім.
Dialogue: 0,0:05:49.68,0:05:52.64,Default,,0,0,0,,Кейбір елдер мұны істеп жатыр.
Dialogue: 0,0:05:52.72,0:05:55.10,Default,,0,0,0,,Психикалық кедергілер кенет төмендейді
Dialogue: 0,0:05:55.18,0:05:59.48,Default,,0,0,0,,Дегенмен, суицид туралы жаңа заңдар бұл деңгейден асып түсетіні анық.
Dialogue: 0,0:06:00.23,0:06:03.73,Default,,0,0,0,,Сондықтан қолдау 3% деңгейінде қалады...
Dialogue: 0,0:06:03.82,0:06:05.74,Default,,0,0,0,,Бұл жерден жоғары көтеріле ме?
Dialogue: 0,0:06:06.32,0:06:08.24,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:06:08.82,0:06:10.87,Default,,0,0,0,,Сайдың келесі қимылы
Dialogue: 0,0:06:11.37,0:06:15.12,Default,,0,0,0,,Келесі... Қызық, олар оны қалай орнатады?
Dialogue: 0,0:06:15.20,0:06:18.12,Default,,0,0,0,,Бастапқы жоспар келесі кезектегі парламенттік сайлау болатын.
Dialogue: 0,0:06:18.21,0:06:20.75,Default,,0,0,0,,Жаңа аймақтық парламент сайлауы өтуі тиіс болды
Dialogue: 0,0:06:21.42,0:06:24.34,Default,,0,0,0,,Жаңа аумақта әлі парламент жоқ.
Dialogue: 0,0:06:27.59,0:06:29.26,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:06:30.13,0:06:31.43,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:33.85,0:06:35.14,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:06:36.64,0:06:37.52,Default,,0,0,0,,Иә
Dialogue: 0,0:06:37.60,0:06:40.31,Default,,0,0,0,,Масазаки Мен оны сізге кеңсе қызметкерінен беремін.
Dialogue: 0,0:06:40.39,0:06:43.56,Default,,0,0,0,,Менің жасым небәрі 23-те, бірақ бұрынғы жұмысым мемлекеттік қызметте болды.
Dialogue: 0,0:06:44.48,0:06:46.78,Default,,0,0,0,,Құқық саласында ерекше күшті
Dialogue: 0,0:06:46.86,0:06:48.32,Default,,0,0,0,,Жаңа аймақ тұжырымдамасы туралы не деуге болады?
Dialogue: 0,0:06:48.95,0:06:51.32,Default,,0,0,0,,өтті және оны еш қиындықсыз пайдалануға болады
Dialogue: 0,0:06:52.53,0:06:53.57,Default,,0,0,0,,Рахмет
Dialogue: 0,0:06:55.41,0:06:56.49,Default,,0,0,0,,Кешіріңіз (Масаки) Ах...
Dialogue: 0,0:07:04.67,0:07:06.88,Default,,0,0,0,,Бұл Йома Сегуро, прокуратура қызметкері.
Dialogue: 0,0:07:07.38,0:07:08.34,Default,,0,0,0,,Бүгіннен бастап
Dialogue: 0,0:07:08.42,0:07:11.34,Default,,0,0,0,,Мен Масазаки прокурорының куәгері боламын.
Dialogue: 0,0:07:11.97,0:07:13.22,Default,,0,0,0,,Сегуро…
Dialogue: 0,0:07:13.85,0:07:15.47,Default,,0,0,0,,Сіз Әділет министрінің орынбасарысыз...
Dialogue: 0,0:07:15.56,0:07:18.10,Default,,0,0,0,,Йосифуми Сегуро – менің ағам.
Dialogue: 0,0:07:18.85,0:07:19.81,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:20.60,0:07:21.60,Default,,0,0,0,,«Хиаса» қандай кейіпкер?
Dialogue: 0,0:07:22.31,0:07:24.69,Default,,0,0,0,,Күннің «янында» ол өсімдіктердің «қарасорасы».
Dialogue: 0,0:07:29.24,0:07:33.36,Default,,0,0,0,,Маған немесе жаңа аймақ концепциясына жеккөрінішті болсаңыз, бұл жақсы.
Dialogue: 0,0:07:33.45,0:07:37.03,Default,,0,0,0,,Мен куәгер ретінде өз жұмысымды орындасам екен.
Dialogue: 0,0:07:37.83,0:07:39.33,Default,,0,0,0,,Егер мұны істей алмасаңыз, мені ауыстырыңыз.
Dialogue: 0,0:07:40.25,0:07:42.17,Default,,0,0,0,,Жоқ, мүмкін емес
Dialogue: 0,0:07:43.00,0:07:43.92,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:07:44.75,0:07:46.67,Default,,0,0,0,,(Ағын су дыбысы)
Dialogue: 0,0:07:46.75,0:07:49.55,Default,,0,0,0,,Асума әлі ұйықтап жатыр ма?
Dialogue: 0,0:07:51.01,0:07:52.30,Default,,0,0,0,,Мен әрқашан кешірім сұраймын
Dialogue: 0,0:07:53.22,0:07:55.64,Default,,0,0,0,,Аа, мен сізге қайта қоңырау шаламын.
Dialogue: 0,0:07:59.10,0:08:00.73,Default,,0,0,0,,Сегуро Бұл не?
Dialogue: 0,0:08:00.81,0:08:03.02,Default,,0,0,0,,Заң бойынша прецеденттердің жинағы
Dialogue: 0,0:08:03.10,0:08:05.98,Default,,0,0,0,,Айыптау фактілерін және тағылған айыптардың негізділігін растау
Dialogue: 0,0:08:06.06,0:08:08.86,Default,,0,0,0,,Аумақтық заңнаманың орындалуы Қандай да бір проблемалар табылды ма?
Dialogue: 0,0:08:08.94,0:08:09.69,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:08:09.78,0:08:10.86,Default,,0,0,0,,Жаңа аймақта
Dialogue: 0,0:08:10.94,0:08:14.45,Default,,0,0,0,,Жұмыс ауқымы жергілікті өзін-өзі басқару қаулыларының ережелерінен тыс берілген.
Dialogue: 0,0:08:15.03,0:08:16.87,Default,,0,0,0,,Бұл кезеңде ешқандай кемшіліктер табылмады
Dialogue: 0,0:08:17.37,0:08:19.58,Default,,0,0,0,,Ол мұқият дайындалған болуы керек.
Dialogue: 0,0:08:19.66,0:08:21.20,Default,,0,0,0,,Аймақтық сайлау туралы не деуге болады?
Dialogue: 0,0:08:21.79,0:08:23.71,Default,,0,0,0,,Конгресс заңы маңызды, бірақ...
Dialogue: 0,0:08:23.79,0:08:27.21,Default,,0,0,0,,Сайлау дұрыс өткізілсе де, Сайдың жеңіске жету мүмкіндігі жоқ.
Dialogue: 0,0:08:27.29,0:08:30.96,Default,,0,0,0,,Бәлкім, жасырын түрде жариялануы керек және хабарландырулар барынша аз болуы керек.
Dialogue: 0,0:08:31.05,0:08:32.09,Default,,0,0,0,,(Шұғыл жаңалықтар туралы хабарландыру дыбысы)
Dialogue: 0,0:08:33.17,0:08:34.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:34.84,0:08:36.55,Default,,0,0,0,,Біз соңғы жаңалықтарды алдық.
Dialogue: 0,0:08:36.64,0:08:38.47,Default,,0,0,0,,Жаңа аймаққа қатысты ақпарат
Dialogue: 0,0:08:38.55,0:08:40.47,Default,,0,0,0,,Біраз бұрын, таңғы сағат 7 шамасында.
Dialogue: 0,0:08:40.56,0:08:44.14,Default,,0,0,0,,Кайхуа Жаңа Аймақ директоры Сай интернеттегі бейне сайтында...
Dialogue: 0,0:08:44.23,0:08:45.52,Default,,0,0,0,,Бейне табылды
Dialogue: 0,0:08:45.60,0:08:48.65,Default,,0,0,0,,Бұл Кайхуа Сай, аймақтың жаңа директоры.
Dialogue: 0,0:08:49.15,0:08:50.98,Default,,0,0,0,,Құрметті жаңа ауданның тұрғындары
Dialogue: 0,0:08:51.07,0:08:53.90,Default,,0,0,0,,Жапонияда тұратын барлық адамдарға
Dialogue: 0,0:08:53.99,0:08:56.49,Default,,0,0,0,,Тағы да сәлем
Dialogue: 0,0:08:57.28,0:08:58.87,Default,,0,0,0,,Суицид заңы
Dialogue: 0,0:08:58.95,0:09:03.45,Default,,0,0,0,,Өткен күні жаңа аумақта жаңа аумақтық заңдар жүзеге асырылды.
Dialogue: 0,0:09:03.54,0:09:07.38,Default,,0,0,0,,Өлім құқығын мойындайтын жаңа заң, суицид заңы деп аталады
Dialogue: 0,0:09:07.46,0:09:10.54,Default,,0,0,0,,Қалайша көзге түсетіндей мәлімдеме жасай алдың...
Dialogue: 0,0:09:11.30,0:09:12.26,Default,,0,0,0,,Түсініксіз
Dialogue: 0,0:09:12.34,0:09:14.05,Default,,0,0,0,,Көптеген суицидтер орын алды.
Dialogue: 0,0:09:14.13,0:09:17.47,Default,,0,0,0,,Өз-өзіне қол жұмсау туралы заңдар туралы пікірталас неден туындады?
Dialogue: 0,0:09:17.55,0:09:19.76,Default,,0,0,0,,Сіз білетіндей.
Dialogue: 0,0:09:20.39,0:09:22.39,Default,,0,0,0,,Мен көп адамдарға сенемін
Dialogue: 0,0:09:22.47,0:09:26.35,Default,,0,0,0,,Өз-өзіне қол жұмсау туралы заңға қарсы екенімді білемін.
Dialogue: 0,0:09:27.14,0:09:30.61,Default,,0,0,0,,Құқық – адамның бақытты болуына ықпал ететін нәрсе.
Dialogue: 0,0:09:30.69,0:09:33.48,Default,,0,0,0,,Адамдар қаламайтын заң болуы мүмкін емес.
Dialogue: 0,0:09:34.11,0:09:36.20,Default,,0,0,0,,Көп адамдар қарсы болса
Dialogue: 0,0:09:36.28,0:09:38.45,Default,,0,0,0,,Заңның күші жойылсын
Dialogue: 0,0:09:38.95,0:09:39.95,Default,,0,0,0,,сонда
Dialogue: 0,0:09:40.03,0:09:42.08,Default,,0,0,0,,Мен қалай бағалауым керек?
Dialogue: 0,0:09:42.58,0:09:45.75,Default,,0,0,0,,Біздің еліміздің саяси жүйесі – демократиялық мемлекет.
Dialogue: 0,0:09:45.83,0:09:49.42,Default,,0,0,0,,Бұл өте қарапайым, тек санаңыз.
Dialogue: 0,0:09:49.50,0:09:51.75,Default,,0,0,0,,Біз ойымызды өзгертуіміз керек (Сай) Өз-өзіне қол жұмсау туралы заңды мақұлдау керек пе, жоқ па?
Dialogue: 0,0:09:51.84,0:09:53.88,Default,,0,0,0,,Демократиялық принциптерге сәйкес...
Dialogue: 0,0:09:53.96,0:09:55.01,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:09:55.09,0:09:57.26,Default,,0,0,0,,Біз халықтың еркін сайлау арқылы сұрай аламыз.
Dialogue: 0,0:09:57.84,0:09:59.26,Default,,0,0,0,,бүгіннен бастап 12 күн
Dialogue: 0,0:09:59.34,0:10:03.43,Default,,0,0,0,,Біз аймақтық ассамблеяның жаңа мүшелерін сайлау үшін аймақтық сайлау өткіземіз.
Dialogue: 0,0:10:03.51,0:10:05.89,Default,,0,0,0,,Бұл бір ғана мүмкіндік
Dialogue: 0,0:10:06.39,0:10:07.48,Default,,0,0,0,,Сай Кайхуа
Dialogue: 0,0:10:07.56,0:10:12.73,Default,,0,0,0,,Мүмкін ол өзін-өзі өлтіру туралы заңдарды әлем қабылдайды деп шындап ойлайтын шығар.
Dialogue: 0,0:10:19.16,0:10:22.66,Default,,0,0,0,,Сәлеметсіз бе, бұл Коичи Шимбунның әлеуметтік мәселелер бөлімінің қызметкері Ханда.
Dialogue: 0,0:10:23.91,0:10:25.16,Default,,0,0,0,,Прокурор Масазаки
Dialogue: 0,0:10:25.66,0:10:28.66,Default,,0,0,0,,Арнайы тергеу департаментінің прокурорлары мен тілшілері арасындағы байланысқа тыйым салынады.
Dialogue: 0,0:10:28.75,0:10:29.92,Default,,0,0,0,,Қазіргі уақытта концерттік турда
Dialogue: 0,0:10:31.75,0:10:32.79,Default,,0,0,0,,Жаман болды ма?
Dialogue: 0,0:10:32.88,0:10:35.13,Default,,0,0,0,,Жоқ, бұл туралы алаңдамаңыз.
Dialogue: 0,0:10:35.63,0:10:37.38,Default,,0,0,0,,Ал, бастайық.
Dialogue: 0,0:10:38.26,0:10:40.76,Default,,0,0,0,,Қалай болғанда да, бұл қорқынышты сайлау жүйесі.
Dialogue: 0,0:10:41.43,0:10:42.93,Default,,0,0,0,,Жоғарыдан бастайық
Dialogue: 0,0:10:43.01,0:10:47.06,Default,,0,0,0,,1-тармақ Біріншіден, бұл кенеттен қауіпті.
Dialogue: 0,0:10:47.14,0:10:48.52,Default,,0,0,0,,Екі нүкте
Dialogue: 0,0:10:48.60,0:10:53.36,Default,,0,0,0,,Жергілікті тұрғындар әдеттегі сайлаудағыдай дауыс береді.
Dialogue: 0,0:10:53.44,0:10:57.65,Default,,0,0,0,,Алайда тұру мерзімін белгілеу жоқ, әдетте солай болуы керек.
Dialogue: 0,0:10:57.74,0:10:58.86,Default,,0,0,0,,Оны міндетті түрде дәл тиетініңе толық сенімді болмасаң, оқ атпа.
Dialogue: 0,0:10:58.94,0:11:01.66,Default,,0,0,0,,Кез келген адам дауыс беру құқығын сол күні ала алады
Dialogue: 0,0:11:02.20,0:11:04.33,Default,,0,0,0,,Бірақ бұл өте оңай
Dialogue: 0,0:11:04.41,0:11:06.08,Default,,0,0,0,,Сегуро мырза айтқандай.
Dialogue: 0,0:11:06.66,0:11:11.12,Default,,0,0,0,,Бұл сөйлемде әрқашан мақалада болуы керек тағы бір нәрсе жетіспейді.
Dialogue: 0,0:11:11.71,0:11:12.79,Default,,0,0,0,,Жас шегі
Dialogue: 0,0:11:12.88,0:11:13.75,Default,,0,0,0,,Иә
Dialogue: 0,0:11:13.83,0:11:17.25,Default,,0,0,0,,Жаңа аймақтық сайлауда сәбилер де дауыс бере алады.
Dialogue: 0,0:11:17.34,0:11:21.26,Default,,0,0,0,,Егер сіз онлайн дауыс беруді қолдансаңыз, ата-анаңыздың екі дауысы болса да, бәрі бірдей.
Dialogue: 0,0:11:21.84,0:11:24.93,Default,,0,0,0,,Іс жүзінде баланың дауыс беруі заңсыз
Dialogue: 0,0:11:25.43,0:11:26.93,Default,,0,0,0,,Содан кейін екінші абзац бар.
Dialogue: 0,0:11:27.52,0:11:32.73,Default,,0,0,0,,Дауыс беруге құқығы бар кез келген адам... Басқаша айтқанда, тіпті балалар да сайлауға түсе алады.
Dialogue: 0,0:11:32.81,0:11:35.27,Default,,0,0,0,,Менің ойымша, олардың басынан бастап оны басқару ниеті болмады.
Dialogue: 0,0:11:35.36,0:11:36.40,Default,,0,0,0,,Фу…
Dialogue: 0,0:11:36.98,0:11:38.94,Default,,0,0,0,,Ал үшінші және соңғы
Dialogue: 0,0:11:39.03,0:11:42.28,Default,,0,0,0,,Шынымды айтсам, бұл ең қорқыныштысы.
Dialogue: 0,0:11:43.28,0:11:45.49,Default,,0,0,0,,Ниет бір деп ойлаймын.
Dialogue: 0,0:11:45.99,0:11:49.95,Default,,0,0,0,,Барлық кандидаттар өз-өзіне қол жұмсау туралы заңдарға қатысты өз ұстанымдарын түсіндіруі керек.
Dialogue: 0,0:11:50.04,0:11:52.87,Default,,0,0,0,,Сайлауға қатысты сұрақтарды анықтайық.
Dialogue: 0,0:11:53.37,0:11:56.46,Default,,0,0,0,,Қолдаушылар бар болғаны 3% болса да
Dialogue: 0,0:11:56.54,0:12:00.09,Default,,0,0,0,,Менің ойымша, егер біз осындай пікірталас тудыратын болсақ, нәтижені көре аламыз.
Dialogue: 0,0:12:00.17,0:12:02.17,Default,,0,0,0,,Мақсат кандидатты қолдау болса керек.
Dialogue: 0,0:12:02.68,0:12:03.93,Default,,0,0,0,,Уг!?
Dialogue: 0,0:12:04.01,0:12:05.93,Default,,0,0,0,,Сайдың саяси партиясы жоқ
Dialogue: 0,0:12:06.01,0:12:08.51,Default,,0,0,0,,Бірақ осы сайлау заңына сәйкес
Dialogue: 0,0:12:08.60,0:12:12.02,Default,,0,0,0,,Әр адам өзіне-өзі қол жұмсау туралы заңдарға қарсы немесе қолдаушы болып бөлінеді.
Dialogue: 0,0:12:12.10,0:12:16.02,Default,,0,0,0,,Басқаша айтқанда, про фракциясы Сай фракциясының синонимі болып табылады.
Dialogue: 0,0:12:16.65,0:12:17.77,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:12:17.86,0:12:22.82,Default,,0,0,0,,Кандидат ұсына алсаңыз да, сайлауда жеңе алмасаңыз, оның мәні жоқ.
Dialogue: 0,0:12:27.87,0:12:30.62,Default,,0,0,0,,Бұл Торао, бірінші тергеу бөлімінің директоры.
Dialogue: 0,0:12:31.12,0:12:34.00,Default,,0,0,0,,Мен Масазаки, Токио аудандық прокуратурасының арнайы тергеу департаментінің прокурорымын.
Dialogue: 0,0:12:34.08,0:12:36.04,Default,,0,0,0,,Оқиға қанша уақытқа созылады?
Dialogue: 0,0:12:36.13,0:12:40.17,Default,,0,0,0,,Жаңа аймақтағы бірқатар оқиғалар үшін арнайы тергеу тобын құру.
Dialogue: 0,0:12:40.25,0:12:42.51,Default,,0,0,0,,Әсіресе жаңа аймақ басшысы
Dialogue: 0,0:12:42.59,0:12:45.51,Default,,0,0,0,,Біз Кайхуаға бағытталған тергеу тобы боламыз.
Dialogue: 0,0:12:45.59,0:12:47.76,Default,,0,0,0,,Жаңа аймақ тұжырымдамасына қатысты...
Dialogue: 0,0:12:47.85,0:12:49.35,Default,,0,0,0,,Жаңа аймақ түсінігі?
Dialogue: 0,0:12:50.85,0:12:53.27,Default,,0,0,0,,Ақпарат алмасудан бастайық
Dialogue: 0,0:12:55.19,0:12:59.90,Default,,0,0,0,,Басқаша айтқанда, бұл тергеу тобы да сахнаның артында болады.
Dialogue: 0,0:13:00.69,0:13:01.69,Default,,0,0,0,,Хаа…
Dialogue: 0,0:13:02.28,0:13:05.45,Default,,0,0,0,,Екеуміз де қиналып жатқан сияқтымыз.
Dialogue: 0,0:13:05.53,0:13:07.20,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:13:08.24,0:13:12.04,Default,,0,0,0,,Бірақ егер солай болса, оны қалай ұйымдастыруымыз керек?
Dialogue: 0,0:13:12.12,0:13:15.21,Default,,0,0,0,,Сайтта жұмыс істей алатын адамдарды таңдаңыз.
Dialogue: 0,0:13:15.29,0:13:18.21,Default,,0,0,0,,Сонымен қатар, мен бас кеңседен тыс қоңырау шала аламын ба?
Dialogue: 0,0:13:18.29,0:13:19.42,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:13:19.50,0:13:22.55,Default,,0,0,0,,Бір адам, ал қалғандары...
Dialogue: 0,0:13:23.26,0:13:25.51,Default,,0,0,0,,Алтыншыдан бір адам, өтінемін.
Dialogue: 0,0:13:25.59,0:13:27.59,Default,,0,0,0,,Алты…?
Dialogue: 0,0:13:28.22,0:13:29.35,Default,,0,0,0,,Иә
Dialogue: 0,0:13:34.85,0:13:36.27,Default,,0,0,0,,Хома қалай?
Dialogue: 0,0:13:36.35,0:13:38.06,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:13:38.65,0:13:41.90,Default,,0,0,0,,Мен бірге жұмыс істеген кез келген кеңсе қызметкерінен жақсы.
Dialogue: 0,0:13:41.98,0:13:43.36,Default,,0,0,0,,Өкінішке орай,
Dialogue: 0,0:13:43.44,0:13:45.74,Default,,0,0,0,,Мен өзімді жек көргендей болдым.
Dialogue: 0,0:13:45.82,0:13:47.61,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:13:47.70,0:13:50.20,Default,,0,0,0,,Ол әрқашан таза ақымақ болды.
Dialogue: 0,0:13:50.28,0:13:52.58,Default,,0,0,0,,Бұл оның кінәсі емес
Dialogue: 0,0:13:52.66,0:13:54.12,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:13:54.20,0:13:56.87,Default,,0,0,0,,Бұл тым көп және лас.
Dialogue: 0,0:13:58.46,0:14:02.50,Default,,0,0,0,,Сай ше? Ұстау қиын ба?
Dialogue: 0,0:14:02.59,0:14:03.46,Default,,0,0,0,,Иә
Dialogue: 0,0:14:03.55,0:14:07.63,Default,,0,0,0,,Кай Кайхуа осы уақытқа дейін дұрыс әрекет етті және дұрыс процедураларды орындады.
Dialogue: 0,0:14:07.72,0:14:12.01,Default,,0,0,0,,Біз қамауға алу мен айыптауды бірден шешуге болмайтын нәзік сызықты мақсат етіп отырмыз.
Dialogue: 0,0:14:12.10,0:14:13.39,Default,,0,0,0,,Адам қайда?
Dialogue: 0,0:14:13.47,0:14:15.81,Default,,0,0,0,,Мен оны да әлі түсіне алмаймын.
Dialogue: 0,0:14:15.89,0:14:19.40,Default,,0,0,0,,Тергеуге айыптау қорытындысы бойынша фактілердің дәлелденбегендігі кедергі келтіреді.
Dialogue: 0,0:14:19.98,0:14:22.23,Default,,0,0,0,,Мен қисық сызықтың артында тұрғаныма сенімдімін.
Dialogue: 0,0:14:22.31,0:14:24.48,Default,,0,0,0,,Кешегі сайлау туралы заң декларациясына дейін
Dialogue: 0,0:14:24.57,0:14:27.44,Default,,0,0,0,,Менің ойымша, олар оны өздері қалағандай алып жүрді.
Dialogue: 0,0:14:27.53,0:14:28.53,Default,,0,0,0,,(ішу дыбысы)
Dialogue: 0,0:14:29.66,0:14:34.54,Default,,0,0,0,,Бірақ бұл сайлау туралы заң оның ең нашар тактикасы.
Dialogue: 0,0:14:35.12,0:14:39.79,Default,,0,0,0,,Әлгі жігіт менімен саясат ойнағысы келетін сияқты.
Dialogue: 0,0:14:39.87,0:14:42.84,Default,,0,0,0,,Басқа адам сіз жасаған саясаткер болуы мүмкін.
Dialogue: 0,0:14:42.92,0:14:44.04,Default,,0,0,0,,Бұл күшті жау ма?
Dialogue: 0,0:14:44.13,0:14:49.26,Default,,0,0,0,,Сайдың халықты тартуға құмар болғаны рас.
Dialogue: 0,0:14:49.34,0:14:52.76,Default,,0,0,0,,Бірақ өз-өзіне қол жұмсау туралы заңдар тым шектен шыққаны анық.
Dialogue: 0,0:14:52.85,0:14:56.27,Default,,0,0,0,,Бүкіл аймақ басшысы сайлауы кезінде күшейе түскен ынта
Dialogue: 0,0:14:56.35,0:14:59.52,Default,,0,0,0,,Сол бір оқиға мені бірден төңкеріп жіберді.
Dialogue: 0,0:15:00.52,0:15:04.19,Default,,0,0,0,,Ұлттық сезім дегеніміз не?
Dialogue: 0,0:15:04.27,0:15:06.44,Default,,0,0,0,,Жас Сай түсінбейді.
Dialogue: 0,0:15:07.44,0:15:12.20,Default,,0,0,0,,Ертең мен облыстық сайлауға өз кандидатурамды жариялаймын.
Dialogue: 0,0:15:13.07,0:15:15.20,Default,,0,0,0,,Сайлауда Сайдан құтылсақ ше?
Dialogue: 0,0:15:15.28,0:15:18.25,Default,,0,0,0,,Сайлау – біздің домен.
Dialogue: 0,0:15:18.33,0:15:21.08,Default,,0,0,0,,Сайдың жеңіске жету мүмкіндігі жоқ.
Dialogue: 0,0:15:21.17,0:15:25.29,Default,,0,0,0,,Жаңа аймақтың рулі осында қайта оралады.
Dialogue: 0,0:15:25.79,0:15:28.46,Default,,0,0,0,,Әрине, мен Сайға қатысты тергеудің жалғасқанын қалаймын.
Dialogue: 0,0:15:28.55,0:15:33.34,Default,,0,0,0,,Саясат және құқық: Егер сіз біреуді екі жақтан бұғаттасаңыз, қашып құтыла алмайсыз.
Dialogue: 0,0:15:33.43,0:15:36.64,Default,,0,0,0,,Мен саясатты түсінбеймін, мұны сізге қалдырамын.
Dialogue: 0,0:15:36.72,0:15:39.93,Default,,0,0,0,,Бұл қиын емес, прокурор Масазаки.
Dialogue: 0,0:15:40.52,0:15:41.44,Default,,0,0,0,,Саясат дегеніміз не?
Dialogue: 0,0:15:42.19,0:15:46.02,Default,,0,0,0,,Бұл адамдардың еркін біріктіру.
Dialogue: 0,0:15:56.95,0:15:57.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:57.79,0:15:58.95,Default,,0,0,0,,Не?
Dialogue: 0,0:15:59.04,0:16:00.16,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:16:00.25,0:16:04.00,Default,,0,0,0,,Тұрақты хатшымен атыңыз бір болғандықтан, сізге қоңырау шалғанымда біртүрлі естідім деп ойладым.
Dialogue: 0,0:16:04.08,0:16:05.46,Default,,0,0,0,,Оған үйреніңіз
Dialogue: 0,0:16:10.38,0:16:11.26,Default,,0,0,0,,Прокурор Масазаки
Dialogue: 0,0:16:11.88,0:16:12.97,Default,,0,0,0,,Не болды?
Dialogue: 0,0:16:13.05,0:16:15.39,Default,,0,0,0,,Бұл аймақтық сайлауға қатысты жарияланған бейне.
Dialogue: 0,0:16:15.89,0:16:18.01,Default,,0,0,0,,Ол қарапайым бала сияқты.
Dialogue: 0,0:16:18.10,0:16:21.52,Default,,0,0,0,,Ол таң қалдыратын мазмұнның арқасында интернетте қызу тақырыпқа айналды.
Dialogue: 0,0:16:28.19,0:16:30.65,Default,,0,0,0,,Менің атым Тайоу.
Dialogue: 0,0:16:31.15,0:16:36.12,Default,,0,0,0,,Әкем жаңа аймақта жарияланған суицид заңын ұстанды.
Dialogue: 0,0:16:36.20,0:16:38.12,Default,,0,0,0,,Өз-өзіне қол жұмсауға әрекеттену
Dialogue: 0,0:16:39.70,0:16:43.79,Default,,0,0,0,,Мен әкемнен тоқтауды өтіндім, бірақ...
Dialogue: 0,0:16:45.54,0:16:47.42,Default,,0,0,0,,Өз-өзіне қол жұмсауды талап ету
Dialogue: 0,0:16:47.92,0:16:51.55,Default,,0,0,0,,Сіз мені тыңдамайсыз...
Dialogue: 0,0:16:52.05,0:16:53.05,Default,,0,0,0,,(Шырылдаған дыбыс)
Dialogue: 0,0:16:53.13,0:16:54.55,Default,,0,0,0,,үшінңызды өтінемін...
Dialogue: 0,0:16:55.55,0:16:58.05,Default,,0,0,0,,Әкеме көмектесіңізші
Dialogue: 0,0:17:01.68,0:17:02.52,Default,,0,0,0,,(Қаламның сынған дыбысы)
Dialogue: 0,0:17:08.15,0:17:09.44,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:17:12.82,0:17:13.82,Default,,0,0,0,,Сәлем
Dialogue: 0,0:17:14.32,0:17:15.36,Default,,0,0,0,,Хаа, міне
Dialogue: 0,0:17:15.45,0:17:17.61,Default,,0,0,0,,Маған үзіліс беріңізші.
Dialogue: 0,0:17:17.70,0:17:21.24,Default,,0,0,0,,Егер сізді бас кеңсеге немесе басқа нәрсеге шақырса, қашып құтыла алмайсыз.
Dialogue: 0,0:17:21.83,0:17:25.54,Default,,0,0,0,,Жоқ деп жауап беруге болады. Сіз менің қоңырау шалғанымды білдіңіз.
Dialogue: 0,0:17:25.62,0:17:28.08,Default,,0,0,0,,Бас тарту сізге кейін әсер етпейді.
Dialogue: 0,0:17:28.17,0:17:30.96,Default,,0,0,0,,Менің ойымша, сіз сол себепті келдіңіз.
Dialogue: 0,0:17:31.04,0:17:33.30,Default,,0,0,0,,Масазаки-сан, сенің достарың көп емес шығар.
Dialogue: 0,0:17:33.80,0:17:34.76,Default,,0,0,0,,Ойын ішінде болсақ, қауіпсізбіз!
Dialogue: 0,0:17:34.84,0:17:36.97,Default,,0,0,0,,Мүмкін бұл қажетсіз қарастыру болды.
Dialogue: 0,0:17:37.05,0:17:39.05,Default,,0,0,0,,Ұлы мырзаны алып келіңіз.
Dialogue: 0,0:17:39.55,0:17:41.22,Default,,0,0,0,,Бұл Сегуро, прокуратураның қызметкері.
Dialogue: 0,0:17:41.31,0:17:43.31,Default,,0,0,0,,Буншоға қарағанда 5 есе қолайлы
Dialogue: 0,0:17:43.39,0:17:44.77,Default,,0,0,0,,Жоқ, 10 есе көп?
Dialogue: 0,0:17:44.85,0:17:48.23,Default,,0,0,0,,Бұл Фумио-санды қанша адам санайтынына байланысты.
Dialogue: 0,0:17:48.31,0:17:49.73,Default,,0,0,0,,(Масазаки мен Кудзииннің күлкілері)
Dialogue: 0,0:17:51.32,0:17:52.57,Default,,0,0,0,,үшінна қандай оқиға бар?
Dialogue: 0,0:17:53.07,0:17:54.74,Default,,0,0,0,,Торао мырза түсіндірді.
Dialogue: 0,0:17:58.45,0:18:00.70,Default,,0,0,0,,Арнайы тергеу тобының мақсаты
Dialogue: 0,0:18:00.78,0:18:03.62,Default,,0,0,0,,Жаңа аймақ басшысы Сай Кайхуа қамауға алынды.
Dialogue: 0,0:18:03.70,0:18:06.00,Default,,0,0,0,,Бұл мақсат үшін екі маңызды нәрсе бар.
Dialogue: 0,0:18:06.58,0:18:10.00,Default,,0,0,0,,Бірі – жоғалып кеткен Сайдың орнын анықтау.
Dialogue: 0,0:18:10.08,0:18:14.13,Default,,0,0,0,,Басқа нәрсе - Сайдың нақты айыптарын нақтылау.
Dialogue: 0,0:18:14.21,0:18:18.43,Default,,0,0,0,,Жеке құрам екі топқа бөлінеді, олардың әрқайсысында тергеу тобы мен қылмыс тобы бар.
Dialogue: 0,0:18:18.51,0:18:21.26,Default,,0,0,0,,Арнайы тергеушінің ынтымақтастығын алу деген нені білдіреді?
Dialogue: 0,0:18:21.35,0:18:23.64,Default,,0,0,0,,Кедір-бұдыр жақын арада пайда бола ма?
Dialogue: 0,0:18:23.72,0:18:25.39,Default,,0,0,0,,Дайын
Dialogue: 0,0:18:26.02,0:18:27.73,Default,,0,0,0,,Жоқ, рахмет...
Dialogue: 0,0:18:28.31,0:18:29.48,Default,,0,0,0,,Сайдың қылмысы
Dialogue: 0,0:18:30.06,0:18:33.02,Default,,0,0,0,,Ең ықтимал жағдай - суицидке бару.
Dialogue: 0,0:18:33.11,0:18:35.73,Default,,0,0,0,,Жаңа аудандағы үкімет ғимаратынан секіріп кеткен 64 адамға қатысты
Dialogue: 0,0:18:35.82,0:18:37.82,Default,,0,0,0,,Сайды өз-өзіне қол жұмсауға итермелегенінің дәлелі
Dialogue: 0,0:18:37.90,0:18:41.07,Default,,0,0,0,,Немесе мен сізге бұйырған дәлелді алуыңызды қалаймын.
Dialogue: 0,0:18:41.91,0:18:46.45,Default,,0,0,0,,Бізде адам жетіспейді және бізде уақыт жоқ, бірақ қазіргі максималды күшіңізбен шабуыл жасаңыз.
Dialogue: 0,0:18:46.54,0:18:47.54,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:49.54,0:18:53.17,Default,,0,0,0,,Мен 6-бөлімнің инспекторы Цуцуйдің осы әйелді жууын қалаймын.
Dialogue: 0,0:18:56.21,0:18:58.26,Default,,0,0,0,,Егер бұл сол әйел болса...
Dialogue: 0,0:18:59.09,0:19:02.39,Default,,0,0,0,,Жаңа айтқаным рас болса, ол қауіпті әйел.
Dialogue: 0,0:19:02.89,0:19:04.26,Default,,0,0,0,,Аты...
Dialogue: 0,0:19:04.85,0:19:06.31,Default,,0,0,0,,Ән әлемі махаббат
Dialogue: 0,0:19:07.64,0:19:09.69,Default,,0,0,0,,Сайды іздеу жағдайына қатысты.
Dialogue: 0,0:19:09.77,0:19:11.98,Default,,0,0,0,,Жаңа аймақтарға бағытталған сұраулар және
Dialogue: 0,0:19:12.06,0:19:14.61,Default,,0,0,0,,Мен орнатылған қауіпсіздік камераларын жуып жатырмын.
Dialogue: 0,0:19:14.69,0:19:17.32,Default,,0,0,0,,Мұндай адам әлі табылған жоқ.
Dialogue: 0,0:19:17.82,0:19:19.49,Default,,0,0,0,,Ассортиментті одан әрі кеңейтіп, жуып көрейік.
Dialogue: 0,0:19:20.07,0:19:21.24,Default,,0,0,0,,Келесі қылмыс тобы
Dialogue: 0,0:19:21.99,0:19:24.12,Default,,0,0,0,,Үкімет үйінен секіріп кеткен 64 адам
Dialogue: 0,0:19:24.20,0:19:27.24,Default,,0,0,0,,Мен сіздің байланыс тарихыңызды және әрекеттеріңізді мұқият тексеремін.
Dialogue: 0,0:19:27.33,0:19:31.25,Default,,0,0,0,,Сай жағымен байланысым туралы әлі де ойым жоқ.
Dialogue: 0,0:19:32.08,0:19:33.21,Default,,0,0,0,,Тергеу сатысында
Dialogue: 0,0:19:33.29,0:19:36.25,Default,,0,0,0,,Біз суицидтердің 80%-дан астамында ортақ нәрсені таптық
Dialogue: 0,0:19:38.21,0:19:40.01,Default,,0,0,0,,Қызыл нүкте - суицид құрбанының мекен-жайы
Dialogue: 0,0:19:40.63,0:19:44.09,Default,,0,0,0,,64 адамның 80%-ы жаңа ауданның тұрғындары болды.
Dialogue: 0,0:19:44.60,0:19:48.77,Default,,0,0,0,,Мекенжай үкімет ғимаратының айналасындағы 20 км радиуста.
Dialogue: 0,0:19:48.85,0:19:51.69,Default,,0,0,0,,Егер келіспеген жағдайда
Dialogue: 0,0:19:51.77,0:19:56.52,Default,,0,0,0,,Менің туған жерімде өз-өзіне қол жұмсағысы келетін 60 адамды табу мүмкін емес.
Dialogue: 0,0:19:57.27,0:20:00.19,Default,,0,0,0,,Менің ойымша, құмарлықтың болғанына еш күмән жоқ.
Dialogue: 0,0:20:00.28,0:20:02.03,Default,,0,0,0,,Алайда ешқандай дәлел жоқ.
Dialogue: 0,0:20:03.20,0:20:06.33,Default,,0,0,0,,Біз 64 адамның өз-өзіне қол жұмсағанға дейінгі қимылдарын бақылай аламыз ба?
Dialogue: 0,0:20:06.99,0:20:09.62,Default,,0,0,0,,Бізде бірнеше адам туралы түсінік бар, бірақ
Dialogue: 0,0:20:10.12,0:20:10.91,Default,,0,0,0,,үшін?
Dialogue: 0,0:20:11.00,0:20:12.66,Default,,0,0,0,,Мүмкіндігінше
Dialogue: 0,0:20:13.17,0:20:14.71,Default,,0,0,0,,6 қазан күні
Dialogue: 0,0:20:14.79,0:20:18.38,Default,,0,0,0,,Жаңа аудандағы үкімет ғимаратының төбесінде сағат 14:30 шамасында пайда болды.
Dialogue: 0,0:20:18.46,0:20:21.88,Default,,0,0,0,,Мен қабылданған қадамдар туралы егжей-тегжейлі зерттеуді қалаймын.
Dialogue: 0,0:20:21.97,0:20:23.09,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:23.18,0:20:27.18,Default,,0,0,0,,64 адам өз-өзіне қол жұмсамас бұрын бір жерге жиналған болуы мүмкін.
Dialogue: 0,0:20:27.26,0:20:29.93,Default,,0,0,0,,Сайдың тарапынан қандай да бір байланыс дәлелі болса...
Dialogue: 0,0:20:30.02,0:20:31.06,Default,,0,0,0,,Иә
Dialogue: 0,0:20:31.56,0:20:33.02,Default,,0,0,0,,Саясат өзгеріссіз қалады
Dialogue: 0,0:20:33.10,0:20:34.94,Default,,0,0,0,,Тергеу жалғасады деп үміттенемін.
Dialogue: 0,0:20:35.02,0:20:39.69,Default,,0,0,0,,үшінңыз, қалған уақытыңызды тиімді пайдаланыңыздар.
Dialogue: 0,0:20:40.28,0:20:42.49,Default,,0,0,0,,Олай болса тараңдар (Тергеушілер) Иә!
Dialogue: 0,0:20:43.24,0:20:45.78,Default,,0,0,0,,(Смартфонның діріл дыбысы)
Dialogue: 0,0:20:47.57,0:20:48.53,Default,,0,0,0,,Бұл Цуцуй.
Dialogue: 0,0:20:49.03,0:20:50.45,Default,,0,0,0,,Сіз бірдеңе білдіңіз бе?
Dialogue: 0,0:20:50.54,0:20:51.91,Default,,0,0,0,,Иә, кейбіреулері
Dialogue: 0,0:20:52.50,0:20:54.16,Default,,0,0,0,,Біріншіден, отбасы туралы.
Dialogue: 0,0:20:54.25,0:20:58.50,Default,,0,0,0,,Точигидегі ата-анамның үйінде менімен бірге тұрған адамдардың барлығы дүниеден өтті.
Dialogue: 0,0:20:59.00,0:21:01.84,Default,,0,0,0,,Ата-әже, ата-әже қалмады.
Dialogue: 0,0:21:02.34,0:21:04.68,Default,,0,0,0,,Мен бұл туралы жергілікті мектепте естідім.
Dialogue: 0,0:21:04.76,0:21:08.05,Default,,0,0,0,,Кіші сынып оқушысы кезімде бір оқиға болған сияқты.
Dialogue: 0,0:21:08.55,0:21:09.60,Default,,0,0,0,,Оқиға?
Dialogue: 0,0:21:09.68,0:21:12.14,Default,,0,0,0,,Сыныптасыңмен қиналдың ба?
Dialogue: 0,0:21:12.22,0:21:15.44,Default,,0,0,0,,Осыдан кейін ол біраз уақыт ауруханаға барды.
Dialogue: 0,0:21:15.94,0:21:18.90,Default,,0,0,0,,Біз не істеуіміз керек? Мұны жуғыңыз келе ме?
Dialogue: 0,0:21:20.07,0:21:21.94,Default,,0,0,0,,Осы жерде қалдырайық.
Dialogue: 0,0:21:22.03,0:21:24.70,Default,,0,0,0,,Цуцуи ағымдағы қадамдарыңызды жуыңыз.
Dialogue: 0,0:21:24.78,0:21:25.95,Default,,0,0,0,,Қосымша күштер! Біз тез арада қорғаныс жасауымыз керек, әйтпесе қайтадан қоршауға алынамыз.
Dialogue: 0,0:21:29.28,0:21:30.20,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:21:31.74,0:21:34.33,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:21:45.72,0:21:48.18,Default,,0,0,0,,Прокурор Масазаки Бұл не?
Dialogue: 0,0:21:51.14,0:21:52.97,Default,,0,0,0,,Нашар деректер.
Dialogue: 0,0:21:56.06,0:21:58.06,Default,,0,0,0,,♪～
Dialogue: 0,0:23:22.73,0:23:24.73,Default,,0,0,0,,～♪
