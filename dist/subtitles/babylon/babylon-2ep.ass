Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:21.27,0:00:25.65,Default,,0,0,0,,Прокурордың жұмысы сізге нені білдіреді, Масазаки?
Dialogue: 0,0:00:27.06,0:00:29.27,Default,,0,0,0,,Не? кенеттен
Dialogue: 0,0:00:29.36,0:00:30.98,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:00:31.82,0:00:34.45,Default,,0,0,0,,Оның ерекше мағынасы жоқ.
Dialogue: 0,0:00:34.53,0:00:37.16,Default,,0,0,0,,Мен оны бір рет болса да дұрыс тыңдағым келеді.
Dialogue: 0,0:00:38.24,0:00:40.24,Default,,0,0,0,,Прокурор болғың келе ме?
Dialogue: 0,0:00:40.33,0:00:42.29,Default,,0,0,0,,IBN 5100 — ол
Dialogue: 0,0:00:43.12,0:00:44.91,Default,,0,0,0,,Ум, бұл...
Dialogue: 0,0:00:45.00,0:00:46.29,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:00:46.79,0:00:50.88,Default,,0,0,0,,Олай болса, ойланбастан өзіңіз қалаған прокурор болуды мақсат етіңіз.
Dialogue: 0,0:00:53.97,0:00:54.84,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:58.64,0:00:59.89,Default,,0,0,0,,Ах! Сонымен...
Dialogue: 0,0:00:59.97,0:01:03.22,Default,,0,0,0,,Масазаки мырзаның жауабы қандай?
Dialogue: 0,0:01:04.43,0:01:05.73,Default,,0,0,0,,Айтудың қажеті жоқ
Dialogue: 0,0:01:08.02,0:01:09.15,Default,,0,0,0,,Әділет және
Dialogue: 0,0:01:09.23,0:01:11.40,Default,,0,0,0,,Адамдарды қорғау
Dialogue: 0,0:01:11.48,0:01:14.65,Default,,0,0,0,,Мен саған да беремін, Тору.
Dialogue: 0,0:01:28.08,0:01:29.63,Default,,0,0,0,,Сот үкімі қандай нәтиже береді?
Dialogue: 0,0:01:29.71,0:01:33.25,Default,,0,0,0,,Жағдайларды ескере отырып, бұл өзін-өзі өлтіру болып саналады.
Dialogue: 0,0:01:33.34,0:01:34.38,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:35.38,0:01:38.30,Default,,0,0,0,,Фумио Масазаки өз-өзіне қол жұмсады ма?
Dialogue: 0,0:01:38.97,0:01:39.89,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:01:40.85,0:01:42.43,Default,,0,0,0,,Мотив мүлде жоқ
Dialogue: 0,0:01:43.43,0:01:46.43,Default,,0,0,0,,Фумио... өлтірілді.
Dialogue: 0,0:01:47.39,0:01:50.40,Default,,0,0,0,,Мұның Шин Инабаның өз-өзіне қол жұмсауына қатысы бар ма?
Dialogue: 0,0:01:50.48,0:01:51.44,Default,,0,0,0,,Сөзсіз
Dialogue: 0,0:01:53.07,0:01:56.57,Default,,0,0,0,,Масазаки, шындықты анықтаңыз.
Dialogue: 0,0:01:57.07,0:01:59.82,Default,,0,0,0,,Бірақ бұрынғыдан да мұқият қозғалыңыз.
Dialogue: 0,0:02:00.82,0:02:03.24,Default,,0,0,0,,Өз бетіңізше ештеңе жасамаңыз.
Dialogue: 0,0:02:04.45,0:02:05.37,Default,,0,0,0,,Моринага мырза
Dialogue: 0,0:02:06.37,0:02:09.67,Default,,0,0,0,,Бұны Бунодан алуға бола ма?
Dialogue: 0,0:02:12.75,0:02:13.75,Default,,0,0,0,,Оны жоғалтпаңыз
Dialogue: 0,0:02:15.63,0:02:16.38,Default,,0,0,0,,Иә
Dialogue: 0,0:02:17.01,0:02:19.01,Default,,0,0,0,,♪～
Dialogue: 0,0:02:44.91,0:02:46.91,Default,,0,0,0,,～♪
Dialogue: 0,0:02:51.21,0:02:53.00,Default,,0,0,0,,Эмико Хирамацу
Dialogue: 0,0:02:53.71,0:02:56.30,Default,,0,0,0,,Мен сендерге сұрақтар қояйын.
Dialogue: 0,0:02:56.38,0:02:59.01,Default,,0,0,0,,Мазмұны қабаттасуы мүмкін
Dialogue: 0,0:02:59.09,0:03:03.64,Default,,0,0,0,,Олай болса, сол сұраққа тағы да дәл жауап беріңіз.
Dialogue: 0,0:03:03.72,0:03:04.68,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:03:08.43,0:03:09.56,Default,,0,0,0,,бастайық
Dialogue: 0,0:03:10.06,0:03:12.48,Default,,0,0,0,,Эмико Хирамацу Бұл сіздің шын есіміңіз бе?
Dialogue: 0,0:03:12.56,0:03:15.11,Default,,0,0,0,,Йоши Масазаки
Dialogue: 0,0:03:15.69,0:03:16.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:17.15,0:03:19.61,Default,,0,0,0,,Дұрыс және жақсы.
Dialogue: 0,0:03:21.53,0:03:23.03,Default,,0,0,0,,Менің атым кім?
Dialogue: 0,0:03:23.11,0:03:25.33,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:25.83,0:03:28.24,Default,,0,0,0,,Ата-анаң қалай қарайды?
Dialogue: 0,0:03:28.33,0:03:30.87,Default,,0,0,0,,Қызық, саған бұл есім берілді ме?
Dialogue: 0,0:03:32.29,0:03:33.96,Default,,0,0,0,,Мұны да «ерлік» деп атайсыз ба, Матсуда мырза?
Dialogue: 0,0:03:34.67,0:03:37.46,Default,,0,0,0,,Эмико Хирамацу оның шын есімі ме?
Dialogue: 0,0:03:40.26,0:03:41.13,Default,,0,0,0,,Иә
Dialogue: 0,0:03:46.47,0:03:49.06,Default,,0,0,0,,Негізінен өсиет сияқты көрінеді.
Dialogue: 0,0:03:49.14,0:03:52.06,Default,,0,0,0,,Бөлме ішінде бұзақылық белгілері байқалмады.
Dialogue: 0,0:03:52.14,0:03:54.98,Default,,0,0,0,,Құжаттан басқа адамның саусақ іздері жоқ.
Dialogue: 0,0:03:55.06,0:03:57.57,Default,,0,0,0,,Сол түні сонда жалғыз Фумио болғанына еш күмән жоқ.
Dialogue: 0,0:03:59.36,0:04:03.11,Default,,0,0,0,,Әлгі ақымақ... аздап тергейтін жағдайға өзіңді қойып көр.
Dialogue: 0,0:04:03.20,0:04:05.78,Default,,0,0,0,,Фумио-сан үшін бұл өте қиын.
Dialogue: 0,0:04:07.08,0:04:10.16,Default,,0,0,0,,Ал, бұл бала өздігінен өлетін адам емес пе?
Dialogue: 0,0:04:12.41,0:04:15.67,Default,,0,0,0,,Қылмыскерді ұстайық.
Dialogue: 0,0:04:16.71,0:04:17.38,Default,,0,0,0,,О
Dialogue: 0,0:04:18.38,0:04:19.17,Default,,0,0,0,,Қазір...
Dialogue: 0,0:04:19.75,0:04:23.93,Default,,0,0,0,,Бірден Фумио-санның кәдесыйы қосылды.
Dialogue: 0,0:04:24.68,0:04:26.30,Default,,0,0,0,,Мен қуған әйелдің пәтері
Dialogue: 0,0:04:26.80,0:04:30.93,Default,,0,0,0,,Мен мүлікті басқаратын жылжымайтын мүлік агентімен байланысып, барлық ықтимал сатып алушыларды таптым.
Dialogue: 0,0:04:31.68,0:04:34.85,Default,,0,0,0,,Бірақ бұл да таңқаларлық...
Dialogue: 0,0:04:34.94,0:04:35.52,Default,,0,0,0,,Не?
Dialogue: 0,0:04:35.60,0:04:38.65,Default,,0,0,0,,Бөлменің иесі - Йосиюки Фукуяма.
Dialogue: 0,0:04:39.15,0:04:42.40,Default,,0,0,0,,Оның саяси қолдау тобының мүшесі екені анықталды.
Dialogue: 0,0:04:42.49,0:04:46.99,Default,,0,0,0,,Басқаша айтқанда, Номару лагері жақтаушылар бірлестігінің атынан дайындалған пәтерде тұрады.
Dialogue: 0,0:04:47.07,0:04:49.37,Default,,0,0,0,,Онда бір әйел тұрды
Dialogue: 0,0:04:49.45,0:04:51.29,Default,,0,0,0,,Бұл айырмашылық.
Dialogue: 0,0:04:51.37,0:04:51.91,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:04:54.62,0:04:58.50,Default,,0,0,0,,Бұл адам Ағартушылықты қолдаушылар қауымдастығынан болатын.
Dialogue: 0,0:04:59.25,0:05:00.42,Default,,0,0,0,,Қайта оралдын.
Dialogue: 0,0:05:00.50,0:05:04.26,Default,,0,0,0,,Сай - Номарудың аймақ басшысы сайлауындағы қарсыласы.
Dialogue: 0,0:05:04.34,0:05:08.14,Default,,0,0,0,,Сонымен, Сайдың лагері жалдаған пәтерде бір әйел бар.
Dialogue: 0,0:05:08.22,0:05:11.56,Default,,0,0,0,,Бұл оны Номару лагерінен Анно алып кетті дегенді білдіре ме?
Dialogue: 0,0:05:12.14,0:05:13.93,Default,,0,0,0,,Мен солай деп үміттенемін.
Dialogue: 0,0:05:14.81,0:05:16.69,Default,,0,0,0,,Бұл жай ғана сайлау маневрі емес.
Dialogue: 0,0:05:16.77,0:05:20.44,Default,,0,0,0,,Сексуалдық ойын-сауық арқылы дауыстарды сатып алу Екі күдікті өлім
Dialogue: 0,0:05:21.40,0:05:24.44,Default,,0,0,0,,Сахна артында үміткерлер арасында байланыс бар.
Dialogue: 0,0:05:24.53,0:05:28.70,Default,,0,0,0,,Бұл толыққанды арнайы тергеу ісі.
Dialogue: 0,0:05:28.78,0:05:29.45,Default,,0,0,0,,О
Dialogue: 0,0:05:29.53,0:05:32.08,Default,,0,0,0,,Бірақ енді бұл әйелді қуу мүмкін емес.
Dialogue: 0,0:05:32.66,0:05:35.54,Default,,0,0,0,,Фумио кәдеге жаратылса ше?
Dialogue: 0,0:05:35.62,0:05:37.46,Default,,0,0,0,,Ең сорақысы, біздің тіршілігіміз де белгілі.
Dialogue: 0,0:05:37.54,0:05:39.13,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:05:40.84,0:05:42.46,Default,,0,0,0,,Жалғыз емес екеніңізге сенімдімін.
Dialogue: 0,0:05:42.55,0:05:45.97,Default,,0,0,0,,Анно әйелдерді билік басындағыларға сый ретінде берсе ше?
Dialogue: 0,0:05:46.05,0:05:48.09,Default,,0,0,0,,Менің ойымша, бұл бір адам ғана қажет емес.
Dialogue: 0,0:05:48.59,0:05:52.22,Default,,0,0,0,,Негізі университетке барғанда қасында басқа әйел болған.
Dialogue: 0,0:05:52.31,0:05:55.73,Default,,0,0,0,,Мен айналада басқа әйелдердің бар екеніне сенімдімін.
Dialogue: 0,0:05:56.52,0:05:57.60,Default,,0,0,0,,Осы жерден шабуыл жасайық
Dialogue: 0,0:05:58.19,0:05:58.98,Default,,0,0,0,,Иә
Dialogue: 0,0:06:00.36,0:06:02.61,Default,,0,0,0,,Аа, дұрыс, Масазаки-сан.
Dialogue: 0,0:06:02.69,0:06:06.78,Default,,0,0,0,,Университет доцент Инабаның компьютерін тартып алды.
Dialogue: 0,0:06:10.82,0:06:14.74,Default,,0,0,0,,Чиказу Анномен қарым-қатынасыңыз туралы айтып беріңізші.
Dialogue: 0,0:06:15.33,0:06:17.29,Default,,0,0,0,,Қарым-қатынас? (Масазаки) Иә.
Dialogue: 0,0:06:17.79,0:06:20.08,Default,,0,0,0,,Қарым-қатынас... у...
Dialogue: 0,0:06:20.58,0:06:22.38,Default,,0,0,0,,Мен әжемнің танысымын.
Dialogue: 0,0:06:22.88,0:06:24.63,Default,,0,0,0,,Сіз ұзақ мерзімді қарым-қатынаста болдыңыз ба?
Dialogue: 0,0:06:24.71,0:06:26.42,Default,,0,0,0,,Жоқ, онша емес.
Dialogue: 0,0:06:26.51,0:06:30.34,Default,,0,0,0,,Бірінші рет Токиоға келгенімде кездестік.
Dialogue: 0,0:06:30.43,0:06:31.97,Default,,0,0,0,,Шамамен екі жыл бұрын
Dialogue: 0,0:06:32.05,0:06:34.47,Default,,0,0,0,,Ал сіз үнемі кездесесіз бе?
Dialogue: 0,0:06:36.72,0:06:39.69,Default,,0,0,0,,Алдымен мені бөлмемен таныстырды.
Dialogue: 0,0:06:39.77,0:06:43.15,Default,,0,0,0,,Кейде ол мені тамақ ішуге шығарып салады.
Dialogue: 0,0:06:43.23,0:06:44.98,Default,,0,0,0,,Киімді алу...
Dialogue: 0,0:06:45.07,0:06:48.24,Default,,0,0,0,,Қызық, қымбат заттардың бәрі жақсы ма?
Dialogue: 0,0:06:48.32,0:06:52.49,Default,,0,0,0,,Анно-сан саған неге сонша мейірімді болды?
Dialogue: 0,0:06:52.57,0:06:53.37,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:06:54.62,0:06:56.12,Default,,0,0,0,,Неліктен? (Масазаки) Иә.
Dialogue: 0,0:06:57.54,0:06:58.37,Default,,0,0,0,,Неге...
Dialogue: 0,0:07:08.30,0:07:11.80,Default,,0,0,0,,Досының немересі болғандықтан... мүмкін?
Dialogue: 0,0:07:12.97,0:07:14.30,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:07:15.05,0:07:19.14,Default,,0,0,0,,Сіз мені таныстырған мүлік қазіргі уақытта тұратын жеріңіз бе?
Dialogue: 0,0:07:19.64,0:07:20.64,Default,,0,0,0,,Иә
Dialogue: 0,0:07:20.73,0:07:25.02,Default,,0,0,0,,Анно-сан бөлменің иесі және жалдау ақысын төлеудің қажеті жоқ.
Dialogue: 0,0:07:25.11,0:07:28.53,Default,,0,0,0,,Неліктен олар сен үшін мұны істейді?
Dialogue: 0,0:07:29.78,0:07:33.49,Default,,0,0,0,,Иә, шынымен, шынымен...
Dialogue: 0,0:07:34.53,0:07:36.20,Default,,0,0,0,,Мейірімді бол
Dialogue: 0,0:07:36.70,0:07:38.37,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:07:41.21,0:07:47.00,Default,,0,0,0,,23 қыркүйекте қайда болдыңыз және не істедіңіз?
Dialogue: 0,0:07:49.05,0:07:53.30,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:07:53.80,0:07:55.05,Default,,0,0,0,,Ах, Мито-сан.
Dialogue: 0,0:07:55.55,0:07:57.43,Default,,0,0,0,,Мен дәлелдемелерді ДФ-ға жібердім.
Dialogue: 0,0:07:57.51,0:07:58.47,Default,,0,0,0,,Талдау өтінемін
Dialogue: 0,0:07:58.56,0:08:00.06,Default,,0,0,0,,Ол әлдеқашан ашық
Dialogue: 0,0:08:00.14,0:08:01.56,Default,,0,0,0,,Әрқашан пайдалы
Dialogue: 0,0:08:01.64,0:08:03.81,Default,,0,0,0,,Бұл дәрігердің компьютері.
Dialogue: 0,0:08:03.90,0:08:05.73,Default,,0,0,0,,Тәжірибелер мен клиникалық сынақтар деректері
Dialogue: 0,0:08:05.81,0:08:06.94,Default,,0,0,0,,Толық.
Dialogue: 0,0:08:07.52,0:08:11.11,Default,,0,0,0,,Біртүрлі қатты шифрланған деректер бөлігі бар.
Dialogue: 0,0:08:11.19,0:08:13.36,Default,,0,0,0,,Не? (Митого) Мен білмеймін.
Dialogue: 0,0:08:13.45,0:08:16.28,Default,,0,0,0,,Бірақ бұл сіздің орташа мұғаліміңіздің қауіпсіздігі емес.
Dialogue: 0,0:08:16.37,0:08:17.99,Default,,0,0,0,,Сіз оны аша аласыз ба?
Dialogue: 0,0:08:18.08,0:08:20.70,Default,,0,0,0,,Уақыт қажет, екі апта.
Dialogue: 0,0:08:21.20,0:08:21.87,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:08:21.95,0:08:23.37,Default,,0,0,0,,Сайлау күніне дейін
Dialogue: 0,0:08:23.46,0:08:26.67,Default,,0,0,0,,Жаңа аймақ басшысы сайлауына бір апта қалды
Dialogue: 0,0:08:27.25,0:08:29.25,Default,,0,0,0,,Кандидаттардың көшедегі сөздері
Dialogue: 0,0:08:29.34,0:08:31.34,Default,,0,0,0,,Одан да қызып барады.
Dialogue: 0,0:08:41.31,0:08:43.94,Default,,0,0,0,,Жаңа аймақ екенін біліңіз.
Dialogue: 0,0:08:44.02,0:08:48.19,Default,,0,0,0,,Бізде Токиодан асып түсетін қала жоспары болуы керек.
Dialogue: 0,0:08:49.11,0:08:49.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:49.94,0:08:51.86,Default,,0,0,0,,Осы уақытта Хашимото станциясында...
Dialogue: 0,0:08:56.74,0:08:59.12,Default,,0,0,0,,Болашақта өмір сүру деген нені білдіреді
Dialogue: 0,0:08:59.20,0:09:00.45,Default,,0,0,0,,Жапонияның болашағын көтеру...
Dialogue: 0,0:09:00.53,0:09:01.29,Default,,0,0,0,,Не болды?
Dialogue: 0,0:09:01.37,0:09:03.70,Default,,0,0,0,,Жақсы мен ертең көшемін
Dialogue: 0,0:09:04.21,0:09:07.12,Default,,0,0,0,,Саяси партиялар емес, мұндағылардың бәрі...
Dialogue: 0,0:09:10.71,0:09:14.92,Default,,0,0,0,,Анно мырза кеше мені ыстық бұлаққа апарды.
Dialogue: 0,0:09:15.01,0:09:17.39,Default,,0,0,0,,Бірақ Анно-сан бірінші болып үйіне кетті.
Dialogue: 0,0:09:17.97,0:09:19.55,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:09:19.64,0:09:22.47,Default,,0,0,0,,Маған шұғыл жұмысқа байланысты Токиоға қайту керек екенін айтты.
Dialogue: 0,0:09:22.56,0:09:23.60,Default,,0,0,0,,Осыдан кейін
Dialogue: 0,0:09:23.68,0:09:26.02,Default,,0,0,0,,Сіз барлық уақытта жалғыз қалдыңыз ба?
Dialogue: 0,0:09:26.10,0:09:28.94,Default,,0,0,0,,Жоқ? Біз бір қонақ үйде болдық.
Dialogue: 0,0:09:29.02,0:09:31.77,Default,,0,0,0,,Мен Анна мырзаның таныстарымен бірге болдым.
Dialogue: 0,0:09:31.86,0:09:32.90,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:33.48,0:09:34.15,Default,,0,0,0,,Иә
Dialogue: 0,0:09:34.74,0:09:37.20,Default,,0,0,0,,Қанша адам? Сенің атың кім?
Dialogue: 0,0:09:37.70,0:09:38.91,Default,,0,0,0,,(кондиционердің тоқтаған дыбысы)
Dialogue: 0,0:09:41.78,0:09:43.66,Default,,0,0,0,,Хмм... пфффф
Dialogue: 0,0:09:49.71,0:09:50.25,Default,,0,0,0,,Қазір...
Dialogue: 0,0:09:51.79,0:09:53.42,Default,,0,0,0,,Сіз теріп жатқан жоқсыз ба?
Dialogue: 0,0:09:56.67,0:09:58.09,Default,,0,0,0,,Қанша адам?
Dialogue: 0,0:09:58.18,0:10:02.18,Default,,0,0,0,,Иә, үш ата.
Dialogue: 0,0:10:02.26,0:10:05.56,Default,,0,0,0,,Ым, Ота мырза? Және...
Dialogue: 0,0:10:05.64,0:10:08.27,Default,,0,0,0,,Бұл Кимура-сан болды ма?
Dialogue: 0,0:10:13.73,0:10:16.32,Default,,0,0,0,,Бүгін Хаконеде өтеді⸺
Dialogue: 0,0:10:16.40,0:10:18.20,Default,,0,0,0,,Гольф жарысы мүшелерінің тізімі
Dialogue: 0,0:10:18.28,0:10:20.82,Default,,0,0,0,,Менде мұндай нәрсе жиі кездеседі.
Dialogue: 0,0:10:20.91,0:10:22.99,Default,,0,0,0,,Құрылыс индустриясы федерациясының ісінен
Dialogue: 0,0:10:23.08,0:10:25.49,Default,,0,0,0,,Барлық басқа көмекші органдар да ұрланған.
Dialogue: 0,0:10:26.00,0:10:27.33,Default,,0,0,0,,Мүшелер, қараңдаршы.
Dialogue: 0,0:10:27.91,0:10:30.75,Default,,0,0,0,,Зенирен және Токио Еңбек Федерациясы…
Dialogue: 0,0:10:30.83,0:10:32.21,Default,,0,0,0,,Біртүрлі емес пе?
Dialogue: 0,0:10:32.29,0:10:35.67,Default,,0,0,0,,Зен-Ирен адамдардың әл-ауқатын қолдау ұйымы екені өзінен-өзі түсінікті.
Dialogue: 0,0:10:35.76,0:10:38.17,Default,,0,0,0,,Жылдың осы уақытында біз гольф ойнаймыз.
Dialogue: 0,0:10:38.92,0:10:41.01,Default,,0,0,0,,Бірақ орын – бұл орын.
Dialogue: 0,0:10:41.51,0:10:43.93,Default,,0,0,0,,Гольф алаңында оған жақындай алмайсыз.
Dialogue: 0,0:10:44.01,0:10:46.60,Default,,0,0,0,,Иә, сондықтан сүйіктісі осы.
Dialogue: 0,0:10:47.98,0:10:49.64,Default,,0,0,0,,Бұл жігіттер тұратын қонақ үй.
Dialogue: 0,0:10:50.64,0:10:53.23,Default,,0,0,0,,Сіз ешқандай ақпарат таратқан жоқсыз, солай ма?
Dialogue: 0,0:10:53.31,0:10:55.90,Default,,0,0,0,,Егер сіз мұны істей алсаңыз, қаншалықты оңай болар еді
Dialogue: 0,0:10:55.98,0:11:00.57,Default,,0,0,0,,Мен компания ішінде ақпарат жинау үшін қаншалықты бас идім деп ойлайсыз?
Dialogue: 0,0:11:04.83,0:11:06.87,Default,,0,0,0,,Мен оны әлі түсінбеймін.
Dialogue: 0,0:11:07.62,0:11:08.66,Default,,0,0,0,,Фумио-кун?
Dialogue: 0,0:11:09.25,0:11:10.96,Default,,0,0,0,,Мені неге өлтірдің?
Dialogue: 0,0:11:11.46,0:11:13.67,Default,,0,0,0,,Меніңше, үндемеңіз.
Dialogue: 0,0:11:13.75,0:11:15.17,Default,,0,0,0,,Сіздің көзқарасыңыз ойсыз.
Dialogue: 0,0:11:15.75,0:11:19.42,Default,,0,0,0,,Туыстарымыздың бірі өлтірілсе, біз де үндемейміз.
Dialogue: 0,0:11:19.51,0:11:22.55,Default,,0,0,0,,Иә, ешқандай пайда жоқ.
Dialogue: 0,0:11:23.14,0:11:25.89,Default,,0,0,0,,(Смартфонның діріл дыбысы)
Dialogue: 0,0:11:26.43,0:11:27.18,Default,,0,0,0,,Иә
Dialogue: 0,0:11:28.35,0:11:31.69,Default,,0,0,0,,Түсіндім... баратын жері де сол шығар.
Dialogue: 0,0:11:32.19,0:11:33.40,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:11:33.90,0:11:34.52,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:35.82,0:11:37.61,Default,,0,0,0,,Қосылған сызықтар
Dialogue: 0,0:11:43.78,0:11:47.66,Default,,0,0,0,,Мен көліктен түсіп, серігіммен бірге кіреберіске қарай бет алдым.
Dialogue: 0,0:11:48.16,0:11:50.58,Default,,0,0,0,,Мен біраз уақыт осылай күтемін.
Dialogue: 0,0:11:51.16,0:11:53.00,Default,,0,0,0,,Түсіндім, бұл көмектеседі.
Dialogue: 0,0:11:58.71,0:12:00.92,Default,,0,0,0,,Бұл Фумио қуып келе жатқан әйел ме?
Dialogue: 0,0:12:01.42,0:12:03.22,Default,,0,0,0,,Өйткені мен тірі жеп қойылудан шын мәнінде қорқамын
Dialogue: 0,0:12:07.64,0:12:08.43,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:12:11.48,0:12:14.85,Default,,0,0,0,,Оның арғы жағында гольф ойыншылары тұратын жалғыз бөлме.
Dialogue: 0,0:12:15.35,0:12:18.23,Default,,0,0,0,,Анномен байланыс енді расталды.
Dialogue: 0,0:12:21.69,0:12:24.91,Default,,0,0,0,,Анно: Үйге жалғыз бара жатқан сияқтысың.
Dialogue: 0,0:12:24.99,0:12:26.20,Default,,0,0,0,,Қуу?
Dialogue: 0,0:12:26.28,0:12:29.24,Default,,0,0,0,,Жоқ, жарайды, осы жерден қозғалыңыз.
Dialogue: 0,0:12:30.29,0:12:32.54,Default,,0,0,0,,Ол бөлек шықты (Масазаки)?
Dialogue: 0,0:12:33.12,0:12:34.92,Default,,0,0,0,,Куцзиннің айналасында не бар?
Dialogue: 0,0:12:35.00,0:12:36.33,Default,,0,0,0,,Бұл әдемі.
Dialogue: 0,0:12:36.42,0:12:38.42,Default,,0,0,0,,Жақында әйел де шығады.
Dialogue: 0,0:12:38.50,0:12:40.63,Default,,0,0,0,,Жақсы Бұл жерден не істеуді жоспарлайсыз?
Dialogue: 0,0:12:50.72,0:12:52.81,Default,,0,0,0,,Жоқ, бұл жерде аяқталады.
Dialogue: 0,0:12:53.93,0:12:54.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:55.14,0:12:56.94,Default,,0,0,0,,Сәлем, Зен!
Dialogue: 0,0:13:00.98,0:13:02.07,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:04.03,0:13:08.66,Default,,0,0,0,,Мен сізбен сөйлескім келеді. Менімен бірге прокуратураға бара аласыз ба?
Dialogue: 0,0:13:11.29,0:13:13.50,Default,,0,0,0,,Токио аудандық прокуратурасының арнайы тергеу бөлімі
Dialogue: 0,0:13:21.80,0:13:24.92,Default,,0,0,0,,Үшінші адамның есімі есіңізде жоқ па?
Dialogue: 0,0:13:25.01,0:13:28.68,Default,,0,0,0,,Иә, менде алкоголь бар еді.
Dialogue: 0,0:13:29.80,0:13:32.47,Default,,0,0,0,,Енді бөлмеде не болып жатқанын айтыңызшы.
Dialogue: 0,0:13:33.10,0:13:36.77,Default,,0,0,0,,Тамақты жеп отырып, ертегіні тыңдадым.
Dialogue: 0,0:13:36.85,0:13:40.48,Default,,0,0,0,,Үшеуміз дос секілді, әңгіме-дүкен құрдық.
Dialogue: 0,0:13:41.44,0:13:44.19,Default,,0,0,0,,Арасында мен саған сусын ұсынамын.
Dialogue: 0,0:13:44.28,0:13:47.40,Default,,0,0,0,,Ол сондай бақытты және сүйкімді көрінеді.
Dialogue: 0,0:13:48.11,0:13:50.41,Default,,0,0,0,,Кешіріңіз, бірақ уф.
Dialogue: 0,0:13:52.12,0:13:52.95,Default,,0,0,0,,Хирамацу мырза
Dialogue: 0,0:13:53.04,0:13:53.95,Default,,0,0,0,,Иә
Dialogue: 0,0:13:54.04,0:13:55.70,Default,,0,0,0,,Сен және үшеуі
Dialogue: 0,0:13:56.29,0:13:58.21,Default,,0,0,0,,Сіз жыныстық қатынаста болдыңыз ба?
Dialogue: 0,0:13:58.29,0:14:00.33,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:14:00.42,0:14:02.21,Default,,0,0,0,,Не болды?
Dialogue: 0,0:14:02.92,0:14:07.22,Default,,0,0,0,,Жоқ...прокурор өте байыппен тыңдайды.
Dialogue: 0,0:14:08.55,0:14:11.39,Default,,0,0,0,,Бірақ иә.
Dialogue: 0,0:14:11.89,0:14:15.06,Default,,0,0,0,,Ал егер... Бұл не болатын оқиға.
Dialogue: 0,0:14:15.14,0:14:20.31,Default,,0,0,0,,Егер мен сол адамдармен осындай қарым-қатынаста болсам...
Dialogue: 0,0:14:21.23,0:14:23.90,Default,,0,0,0,,Мен... сүйем бе?
Dialogue: 0,0:14:25.28,0:14:25.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:26.36,0:14:27.24,Default,,0,0,0,,Бұл махаббат
Dialogue: 0,0:14:27.99,0:14:31.49,Default,,0,0,0,,Иә, романтикалық сезімдер болса.
Dialogue: 0,0:14:31.57,0:14:33.78,Default,,0,0,0,,Егер сіз мұны істесеңіз
Dialogue: 0,0:14:34.37,0:14:36.95,Default,,0,0,0,,Бұл жаман нәрсе ме?
Dialogue: 0,0:14:37.71,0:14:38.96,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:14:39.04,0:14:41.96,Default,,0,0,0,,Өйткені, бұл бір көргеннен махаббат.
Dialogue: 0,0:14:42.04,0:14:44.67,Default,,0,0,0,,Екіншісі – 40 жаста қалған қария.
Dialogue: 0,0:14:44.75,0:14:46.63,Default,,0,0,0,,Жоқ, бұған дейін
Dialogue: 0,0:14:46.71,0:14:48.51,Default,,0,0,0,,Үш қарсылас бар.
Dialogue: 0,0:14:49.26,0:14:52.34,Default,,0,0,0,,А, үш адам... Түсінемін.
Dialogue: 0,0:14:53.39,0:14:56.56,Default,,0,0,0,,Бұл адамдардың есімдері кім еді?
Dialogue: 0,0:14:56.64,0:14:57.89,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,0:15:00.69,0:15:01.77,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:15:03.19,0:15:06.94,Default,,0,0,0,,Аты-жөнін де білмейтін үш қарияға ғашық болып, жатып қалдым.
Dialogue: 0,0:15:07.03,0:15:08.61,Default,,0,0,0,,Кім сенеді деп ойлайсың?
Dialogue: 0,0:15:09.19,0:15:12.53,Default,,0,0,0,,Кейде атын да танымайтын адамға ғашық болып қаламын.
Dialogue: 0,0:15:14.78,0:15:16.16,Default,,0,0,0,,А, бірақ...
Dialogue: 0,0:15:16.66,0:15:19.29,Default,,0,0,0,,Мен прокурордың аты-жөнін білемін.
Dialogue: 0,0:15:19.37,0:15:21.62,Default,,0,0,0,,Мен оны дәлелдей алмаймын, бірақ
Dialogue: 0,0:15:25.92,0:15:28.80,Default,,0,0,0,,Әйелді тартып алсаң, не істейсің?
Dialogue: 0,0:15:29.30,0:15:30.76,Default,,0,0,0,,Бұл мағынасы бар ма?
Dialogue: 0,0:15:31.47,0:15:33.26,Default,,0,0,0,,Барлығы әлі қосылмаған
Dialogue: 0,0:15:33.93,0:15:37.81,Default,,0,0,0,,Доктор Инаба мен Фумионың жұмбақ өлімі: Тараптар арасындағы байланыс
Dialogue: 0,0:15:37.89,0:15:39.89,Default,,0,0,0,,Олар әлі қараңғыда
Dialogue: 0,0:15:41.85,0:15:45.02,Default,,0,0,0,,Сондықтан бізге әйелдің куәлігі қажет.
Dialogue: 0,0:15:45.11,0:15:47.65,Default,,0,0,0,,Егер біз оны сайлауды манипуляциялауға қатысы бар деп айтуға мәжбүрлей алсақ.
Dialogue: 0,0:15:48.23,0:15:49.99,Default,,0,0,0,,Оны сол жерден бөлшектеуге болады.
Dialogue: 0,0:15:51.82,0:15:52.99,Default,,0,0,0,,Моринага-сан!
Dialogue: 0,0:15:53.78,0:15:56.03,Default,,0,0,0,,Император кеңесін шақыруға рұқсат етіңіз.
Dialogue: 0,0:15:56.12,0:16:00.25,Default,,0,0,0,,Бұдан басқа, біз Арнайы тергеу департаментінің барлық күшін пайдалануымыз керек!
Dialogue: 0,0:16:02.00,0:16:04.12,Default,,0,0,0,,Әйел әлі де анықтамалық тұлға болып табылады.
Dialogue: 0,0:16:04.63,0:16:08.88,Default,,0,0,0,,Мен сені ұзақ ұстай алмаймын. Үйге келсем, тергеу ісі белгілі болады.
Dialogue: 0,0:16:09.46,0:16:10.63,Default,,0,0,0,,Бөлінуі керек
Dialogue: 0,0:16:14.05,0:16:16.64,Default,,0,0,0,,Жиналыс ертең сағат 13:00-де басталады.
Dialogue: 0,0:16:17.51,0:16:19.14,Default,,0,0,0,,Окуданы куәгер ретінде тағайындаңыз.
Dialogue: 0,0:16:19.93,0:16:21.48,Default,,0,0,0,,Әрқашан айғақ алыңыз
Dialogue: 0,0:16:21.98,0:16:22.73,Default,,0,0,0,,Иә
Dialogue: 0,0:16:30.19,0:16:32.15,Default,,0,0,0,,Басқаша айтқанда, прокурор
Dialogue: 0,0:16:32.24,0:16:37.20,Default,,0,0,0,,Анно мырза сол адамдармен жатуымды өтінді.
Dialogue: 0,0:16:37.28,0:16:38.66,Default,,0,0,0,,Соны айтқым келеді.
Dialogue: 0,0:16:40.74,0:16:41.66,Default,,0,0,0,,Аа...
Dialogue: 0,0:16:44.79,0:16:47.46,Default,,0,0,0,,Қол қояйын ба?
Dialogue: 0,0:16:49.25,0:16:52.26,Default,,0,0,0,,Жазба деп аталса да, қол қою керек, солай емес пе?
Dialogue: 0,0:16:52.34,0:16:55.72,Default,,0,0,0,,Бұл мен куәлік бердім дегенді білдіре ме?
Dialogue: 0,0:16:56.59,0:16:59.18,Default,,0,0,0,,Иә, бірақ неге кенеттен?
Dialogue: 0,0:16:59.76,0:17:03.31,Default,,0,0,0,,Прокурорды аяймын.
Dialogue: 0,0:17:03.98,0:17:05.06,Default,,0,0,0,,Кедей ме?
Dialogue: 0,0:17:05.77,0:17:06.52,Default,,0,0,0,,Иә
Dialogue: 0,0:17:06.60,0:17:07.56,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:07.65,0:17:08.56,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:17:09.19,0:17:12.94,Default,,0,0,0,,Оның орнына прокурордың әңгімесін айтып беріңізші.
Dialogue: 0,0:17:13.03,0:17:13.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:14.03,0:17:17.61,Default,,0,0,0,,Мен прокурор туралы сұрағым келеді.
Dialogue: 0,0:17:17.70,0:17:22.37,Default,,0,0,0,,Иә, балалық шағыңыз, отбасыңыз туралы әңгімелер, т.б.
Dialogue: 0,0:17:22.45,0:17:24.41,Default,,0,0,0,,Ерекше атаулар туралы
Dialogue: 0,0:17:25.41,0:17:26.62,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:17:26.71,0:17:28.00,Default,,0,0,0,,Маған тыңдауға рұқсат етсеңіз
Dialogue: 0,0:17:29.29,0:17:31.42,Default,,0,0,0,,Мен қол қоямын.
Dialogue: 0,0:17:33.92,0:17:35.97,Default,,0,0,0,,Сіздің әйеліңіз бар ма?
Dialogue: 0,0:17:36.05,0:17:36.84,Default,,0,0,0,,О
Dialogue: 0,0:17:37.34,0:17:38.51,Default,,0,0,0,,Сіздің балаларыңыз бар ма?
Dialogue: 0,0:17:39.01,0:17:39.89,Default,,0,0,0,,Апаки, Жорунo, сақ болыңыздар.
Dialogue: 0,0:17:39.97,0:17:42.31,Default,,0,0,0,,Бала? қыз?
Dialogue: 0,0:17:42.39,0:17:43.06,Default,,0,0,0,,Менің ұлым.
Dialogue: 0,0:17:43.89,0:17:45.52,Default,,0,0,0,,Сіздің хоббиіңіз бар ма?
Dialogue: 0,0:17:46.02,0:17:47.98,Default,,0,0,0,,Қазбалар мен пайдалы қазбаларды жинау
Dialogue: 0,0:17:48.73,0:17:50.44,Default,,0,0,0,,Бала кезіңіздегі арманыңыз қандай еді?
Dialogue: 0,0:17:50.52,0:17:51.61,Default,,0,0,0,,Прокурор
Dialogue: 0,0:17:51.69,0:17:53.32,Default,,0,0,0,,Бала кезінен?
Dialogue: 0,0:17:54.15,0:17:55.44,Default,,0,0,0,,(Норияки) Ах!
Dialogue: 0,0:17:57.36,0:17:58.91,Default,,0,0,0,,Жыныстық қатынаста
Dialogue: 0,0:17:59.62,0:18:03.08,Default,,0,0,0,,Иә, мен сенен секс туралы сұрайын.
Dialogue: 0,0:18:03.95,0:18:06.08,Default,,0,0,0,,Контрацепция туралы не ойлайсыз?
Dialogue: 0,0:18:06.75,0:18:07.58,Default,,0,0,0,,істеу дегеніміз не?
Dialogue: 0,0:18:08.42,0:18:09.58,Default,,0,0,0,,Жаман ба?
Dialogue: 0,0:18:09.67,0:18:11.67,Default,,0,0,0,,Жаман емес шығар
Dialogue: 0,0:18:11.75,0:18:13.75,Default,,0,0,0,,Соқыр балаларыңыз болса да
Dialogue: 0,0:18:13.84,0:18:17.09,Default,,0,0,0,,Өсіру экономикалық және экологиялық жағынан қиын болуы мүмкін
Dialogue: 0,0:18:18.22,0:18:20.34,Default,,0,0,0,,Балалы болған жақсы ма?
Dialogue: 0,0:18:20.93,0:18:21.60,Default,,0,0,0,,О
Dialogue: 0,0:18:22.10,0:18:25.43,Default,,0,0,0,,Бала туып, өсіргенін тойлау керек.
Dialogue: 0,0:18:25.52,0:18:27.06,Default,,0,0,0,,Сонымен, босану жаман емес пе?
Dialogue: 0,0:18:27.14,0:18:29.14,Default,,0,0,0,,FB үшін…
Dialogue: 0,0:18:29.23,0:18:33.15,Default,,0,0,0,,Біз әртүрлі өмір салты мен құндылықтарды құрметтейтін дәуірде өмір сүріп жатырмыз.
Dialogue: 0,0:18:33.77,0:18:36.32,Default,,0,0,0,,Құндылық айырмашылығын қабылдауымыз керек пе?
Dialogue: 0,0:18:36.40,0:18:37.65,Default,,0,0,0,,Бірнеше Титанға кезігіп қалғаның өкінішті, бірақ
Dialogue: 0,0:18:37.74,0:18:39.78,Default,,0,0,0,,Тіпті үйлеспейтін мәндер ме?
Dialogue: 0,0:18:39.86,0:18:43.87,Default,,0,0,0,,Біз бір-біріміздің құндылықтарымызды біліп, бірге өмір сүруіміз керек.
Dialogue: 0,0:18:44.37,0:18:46.79,Default,,0,0,0,,Бір-бірімізді қабылдамасақ, ақыры соғыс болады.
Dialogue: 0,0:18:47.79,0:18:49.46,Default,,0,0,0,,Соғыс жаман ба?
Dialogue: 0,0:18:49.54,0:18:51.17,Default,,0,0,0,,Л-Ллойд, қарашы…
Dialogue: 0,0:18:52.25,0:18:56.34,Default,,0,0,0,,Соғыс жаман дейтіндер мен соғысты жақсы көретіндер болса ше?
Dialogue: 0,0:18:57.09,0:19:00.09,Default,,0,0,0,,Бір-біріміздің құндылықтарымызды тану арқылы бірге өмір сүруіміз керек пе?
Dialogue: 0,0:19:02.18,0:19:03.14,Default,,0,0,0,,Бұл...
Dialogue: 0,0:19:03.93,0:19:06.14,Default,,0,0,0,,Балалы болған жақсы
Dialogue: 0,0:19:06.22,0:19:09.31,Default,,0,0,0,,Босанбау жаман емес дедіңіз ғой, солай ма?
Dialogue: 0,0:19:09.39,0:19:10.31,Default,,0,0,0,,О
Dialogue: 0,0:19:10.89,0:19:12.73,Default,,0,0,0,,Сонымен балаларды өлтіру туралы не айтасыз?
Dialogue: 0,0:19:12.81,0:19:13.73,Default,,0,0,0,,Гррр…
Dialogue: 0,0:19:14.44,0:19:15.90,Default,,0,0,0,,Нашар болуы керек
Dialogue: 0,0:19:16.40,0:19:18.03,Default,,0,0,0,,Сіз қандайсыз?
Dialogue: 0,0:19:18.11,0:19:19.95,Default,,0,0,0,,Сіз адам өлтіру жаман емес дейсіз бе?
Dialogue: 0,0:19:20.03,0:19:21.11,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:19:21.20,0:19:23.24,Default,,0,0,0,,Адам өлтіру өте жаман нәрсе.
Dialogue: 0,0:19:23.32,0:19:26.37,Default,,0,0,0,,Ең нашар, иә, ең нашар.
Dialogue: 0,0:19:33.63,0:19:36.88,Default,,0,0,0,,Әділдіктің «құқы» игі істердің «Жақсылығы».
Dialogue: 0,0:19:38.30,0:19:42.72,Default,,0,0,0,,Прокурордың аты жаман нәрселерге жол бермейді.
Dialogue: 0,0:19:44.05,0:19:45.51,Default,,0,0,0,,Эй, Масазаки-сан
Dialogue: 0,0:19:49.18,0:19:52.35,Default,,0,0,0,,Әділеттілік дегеніміз не?
Dialogue: 0,0:19:59.65,0:20:00.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:05.28,0:20:07.53,Default,,0,0,0,,Эй, Хирамацуға не болды?
Dialogue: 0,0:20:07.62,0:20:09.70,Default,,0,0,0,,Сәлем! Окуда!
Dialogue: 0,0:20:10.20,0:20:11.66,Default,,0,0,0,,А... ха...
Dialogue: 0,0:20:13.29,0:20:15.21,Default,,0,0,0,,Мен үйге бардым...
Dialogue: 0,0:20:18.21,0:20:20.13,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:20:26.22,0:20:28.64,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:20:33.06,0:20:33.64,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:34.23,0:20:38.27,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:20:46.66,0:20:47.62,Default,,0,0,0,,Окуда ше?
Dialogue: 0,0:20:48.37,0:20:51.37,Default,,0,0,0,,Мен тыныштала алмай, бір рет үйге қайттым.
Dialogue: 0,0:20:51.95,0:20:52.87,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:53.71,0:20:54.83,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:20:55.67,0:20:56.96,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:58.38,0:20:59.38,Default,,0,0,0,,Масазаки.
Dialogue: 0,0:21:01.46,0:21:03.13,Default,,0,0,0,,Көп ойланбаңыз
Dialogue: 0,0:21:03.63,0:21:05.88,Default,,0,0,0,,Сіз оны сол күйінде хабарлай аласыз.
Dialogue: 0,0:21:06.68,0:21:10.26,Default,,0,0,0,,Қалғаны мені қосу арқылы шешіледі.
Dialogue: 0,0:21:10.35,0:21:11.14,Default,,0,0,0,,Гррр…
Dialogue: 0,0:21:12.35,0:21:12.89,Default,,0,0,0,,Иә
Dialogue: 0,0:21:27.53,0:21:30.33,Default,,0,0,0,,Уақытыңызды бөлгеніңізге рахмет.
Dialogue: 0,0:21:30.41,0:21:32.54,Default,,0,0,0,,Бүгін облыс әкімі сайлауы туралы...
Dialogue: 0,0:21:37.37,0:21:38.46,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:49.43,0:21:52.64,Default,,0,0,0,,Енді хабарлаңыз.
Dialogue: 0,0:21:53.68,0:21:55.39,Default,,0,0,0,,Прокурор Масазаки
Dialogue: 0,0:21:56.02,0:21:58.02,Default,,0,0,0,,♪～
Dialogue: 0,0:23:23.48,0:23:25.48,Default,,0,0,0,,～♪
