Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:35.01,0:01:37.88,Default,,0,0,0,,Тағдырдың опасыздығына қарамастан,
Dialogue: 0,0:01:38.18,0:01:41.89,Default,,0,0,0,,Өз жолын табуды жалғастыратын адам туралы әңгіме
Dialogue: 0,0:01:42.43,0:01:46.89,Default,,0,0,0,,Спиральдық тайпа мен антиспиральдық тайпа арасындағы шайқас
Dialogue: 0,0:01:46.98,0:01:49.44,Default,,0,0,0,,Мұның бәрі осының арқасында болды.
Dialogue: 0,0:01:50.06,0:01:53.07,Default,,0,0,0,,Спиральдың жасырын күшімен адамзатты жою
Dialogue: 0,0:01:53.15,0:01:55.28,Default,,0,0,0,,Ай жерге түседі
Dialogue: 0,0:01:55.36,0:01:58.95,Default,,0,0,0,,Саймон мен Ұлы Гленн тобы триггерді тартты.
Dialogue: 0,0:01:59.78,0:02:03.03,Default,,0,0,0,,Бостандық үшін күрес жойылуға әкеле ме?
Dialogue: 0,0:02:03.12,0:02:06.91,Default,,0,0,0,,Ниадан айырылғаннан кейін Саймонның қолы үмітсіздіктен кісенделген.
Dialogue: 0,0:02:19.63,0:02:22.55,Default,,0,0,0,,- Симонды шығар! -Мен жауапкершілікті аламын!
Dialogue: 0,0:02:24.35,0:02:26.22,Default,,0,0,0,,Ол батыр емес еді.
Dialogue: 0,0:02:26.56,0:02:29.14,Default,,0,0,0,,Саймон барлығына кінәлі!
Dialogue: 0,0:02:29.44,0:02:32.86,Default,,0,0,0,,Айдың түсуіне оның кінәсі!
Dialogue: 0,0:02:43.87,0:02:46.29,Default,,0,0,0,,Россиу, неге?
Dialogue: 0,0:02:47.50,0:02:51.96,Default,,0,0,0,,Парламент мұнарасын сынауға келген азаматтар бүлік шығарды.
Dialogue: 0,0:02:52.63,0:02:56.34,Default,,0,0,0,,Лордгеномды жеңуіміз бәріне себеп.
Dialogue: 0,0:02:56.46,0:02:59.34,Default,,0,0,0,,Айдың түсуінің себебі Дайгурен командасы.
Dialogue: 0,0:02:59.63,0:03:02.43,Default,,0,0,0,,Олар жаңа үкіметке ашуларын шығарып жатыр.
Dialogue: 0,0:03:03.51,0:03:07.31,Default,,0,0,0,,Анато мен Нианың әңгімесі теледидар арқылы бүкіл қалаға таратылды.
Dialogue: 0,0:03:07.39,0:03:12.27,Default,,0,0,0,,Қазір барлық азаматтар айдың үш аптадан кейін түсетінін біледі.
Dialogue: 0,0:03:12.60,0:03:16.98,Default,,0,0,0,,Бұрынғы барлық абайсыз ұрыстарыңыз да көрінді.
Dialogue: 0,0:03:17.32,0:03:18.90,Default,,0,0,0,,Мен сені енді қорғай алмаймын
Dialogue: 0,0:03:18.98,0:03:20.11,Default,,0,0,0,,Мені қорғайсыз ба?
Dialogue: 0,0:03:22.99,0:03:24.99,Default,,0,0,0,,Міне! Бұл жігіт кінәлі!
Dialogue: 0,0:03:25.07,0:03:26.78,Default,,0,0,0,,'Егер мен Польнареффтің мұрнына саусағымды тығып қойсам ➡
Dialogue: 0,0:03:35.67,0:03:40.34,Default,,0,0,0,,Олар үшін сіз ескі Лордгеном сияқтысыз.
Dialogue: 0,0:03:40.46,0:03:43.22,Default,,0,0,0,,Сонда бізде де дәл осылай үкім шығарудан басқа амал жоқ.
Dialogue: 0,0:03:43.30,0:03:47.35,Default,,0,0,0,,Бұрынғыдай, егер біз осылай жасамайынша, жағдай тоқтамас еді.
Dialogue: 0,0:03:53.39,0:03:55.86,Default,,0,0,0,,Осы жерде сотқа дейін күтіңіз.
Dialogue: 0,0:03:55.94,0:03:57.06,Default,,0,0,0,,Сынақ?
Dialogue: 0,0:03:57.15,0:03:59.44,Default,,0,0,0,,Бұл ел қазір заңмен басқарылатын ел.
Dialogue: 0,0:03:59.57,0:04:02.15,Default,,0,0,0,,Соғыс жауапкершілігі де сотта анықталады.
Dialogue: 0,0:04:02.57,0:04:05.03,Default,,0,0,0,,Құдайдың өсиеті енді заң ма?
Dialogue: 0,0:04:05.20,0:04:07.91,Default,,0,0,0,,Ол байланғанды ​​жақсы көретін адам.
Dialogue: 0,0:04:08.58,0:04:12.50,Default,,0,0,0,,Біз әрқашан біреудің есебінен алға жылжыдық.
Dialogue: 0,0:04:12.62,0:04:15.25,Default,,0,0,0,,Анам мен Камина да
Dialogue: 0,0:04:15.71,0:04:17.00,Default,,0,0,0,,Не?
Dialogue: 0,0:04:17.42,0:04:20.38,Default,,0,0,0,,Камина-сан өлді, біз күшейе түстік.
Dialogue: 0,0:04:20.46,0:04:23.97,Default,,0,0,0,,Біз бұл шайқаста Камина-санның өліміне байланысты жеңе алдық.
Dialogue: 0,0:04:24.05,0:04:25.43,Default,,0,0,0,,Бір минут күте тұрыңыз, Россиу!
Dialogue: 0,0:04:25.51,0:04:28.51,Default,,0,0,0,,Демек, сіз Аники өлгеніне қуанышты екеніңізді айтқыңыз келе ме?
Dialogue: 0,0:04:30.77,0:04:33.43,Default,,0,0,0,,Нәтижелерге қарағанда, бұл
Dialogue: 0,0:04:34.23,0:04:37.98,Default,,0,0,0,,Өзіңізді алдамаңыз! Айтатын жақсы да, жаман да бар!
Dialogue: 0,0:04:38.19,0:04:42.19,Default,,0,0,0,,Эй! Қат! Сіз шынымен солай ойлайсыз ба? ?
Dialogue: 0,0:04:44.74,0:04:47.11,Default,,0,0,0,,Сен баяғы Камина-сансың.
Dialogue: 0,0:04:47.20,0:04:51.58,Default,,0,0,0,,Біз оның өлімінен ештеңе үйренбедік пе? Ешқандай өсім болған жоқ.
Dialogue: 0,0:04:54.54,0:04:56.17,Default,,0,0,0,,Негізгі бұрғыларды сақтауға болады.
Dialogue: 0,0:04:56.29,0:05:02.09,Default,,0,0,0,,Бұл ирониялық. Сенің күш-қуатыңның қайнар көзі адам баласының бақытсыздығы еді.
Dialogue: 0,0:05:02.84,0:05:06.38,Default,,0,0,0,,Росиу... Сіз қазір Аникидің сезімін білмейсіз.
Dialogue: 0,0:05:06.72,0:05:10.22,Default,,0,0,0,,​​Оның өлімі бізге не берді деп ойлаймын.
Dialogue: 0,0:05:12.81,0:05:18.19,Default,,0,0,0,,Сенің көздерің сол кездегі Аддай ауылының діни қызметкерімен бірдей.
Dialogue: 0,0:05:20.82,0:05:23.86,Default,,0,0,0,,Сен ештеңе білмейтінсің
Dialogue: 0,0:05:23.98,0:05:27.28,Default,,0,0,0,,Жеті жыл бойы ештеңе өзгертуге тырыспады.
Dialogue: 0,0:05:27.82,0:05:29.95,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,0:05:33.33,0:05:36.54,Default,,0,0,0,,Сонымен, Саймонның тұтқындалғаны рас па?
Dialogue: 0,0:05:36.83,0:05:37.46,Default,,0,0,0,,О
Dialogue: 0,0:05:37.54,0:05:40.46,Default,,0,0,0,,Неге Саймон! Бұл біртүрлі.
Dialogue: 0,0:05:40.54,0:05:42.88,Default,,0,0,0,,Россиу сияқты ештеңе жасама.
Dialogue: 0,0:05:42.96,0:05:45.51,Default,,0,0,0,,- Ауруханада айқайлама - Ой
Dialogue: 0,0:05:45.92,0:05:47.97,Default,,0,0,0,,Россиудың ұпайы бар.
Dialogue: 0,0:05:48.05,0:05:51.26,Default,,0,0,0,,Саймонның ісі уақытша шара шығар.
Dialogue: 0,0:05:52.22,0:05:56.73,Default,,0,0,0,,Россиу қисынды болуы мүмкін, бірақ ол тым суық, мен оны ұнатпаймын!
Dialogue: 0,0:05:57.02,0:05:59.23,Default,,0,0,0,,Kinon да не болды?
Dialogue: 0,0:05:59.35,0:06:00.27,Default,,0,0,0,,Қял
Dialogue: 0,0:06:00.35,0:06:05.48,Default,,0,0,0,,Бос емес пе, білмеймін, бірақ апамды көруге де келмейді.
Dialogue: 0,0:06:05.69,0:06:07.70,Default,,0,0,0,,Хинон да толығымен өзгерді.
Dialogue: 0,0:06:07.78,0:06:08.99,Default,,0,0,0,,Қиял!
Dialogue: 0,0:06:09.28,0:06:13.45,Default,,0,0,0,,Бұл жерде бәрі жақсы, бірақ сыртта тым көп айтпа.
Dialogue: 0,0:06:13.91,0:06:17.41,Default,,0,0,0,,Біз не болатынын білмейтін заманда өмір сүріп жатырмыз.
Dialogue: 0,0:06:21.08,0:06:24.17,Default,,0,0,0,,Симонды алып кел! Жауаптыларды айыптаңыз!
Dialogue: 0,0:06:24.34,0:06:26.59,Default,,0,0,0,,Айдың түсуіне жол бермеу үшін қандай шаралар бар? ?
Dialogue: 0,0:06:26.71,0:06:28.34,Default,,0,0,0,,Үкімет не істеп жатыр! ?
Dialogue: 0,0:06:28.59,0:06:30.84,Default,,0,0,0,,Маған үйімді қайтар! Түзетіңіз!
Dialogue: 0,0:06:30.93,0:06:33.30,Default,,0,0,0,,Бейбіт өмірге қайта орал!
Dialogue: 0,0:06:34.31,0:06:36.22,Default,,0,0,0,,Мұғанның энергетикалық кедергісі
Dialogue: 0,0:06:36.35,0:06:39.35,Default,,0,0,0,,Giga Drill көмегімен сәулені серпіп өту арқылы өтуге болады.
Dialogue: 0,0:06:39.89,0:06:43.23,Default,,0,0,0,,Мәселе Мұғанның жарылуын қалай тоқтатуда.
Dialogue: 0,0:06:44.19,0:06:45.73,Default,,0,0,0,,Қиындық туғызатын жау.
Dialogue: 0,0:06:45.82,0:06:49.70,Default,,0,0,0,,Жалпы айтқанда, Грапал Гуррен Лаганнан жақсырақ ұшақ болуы керек, солай ма?
Dialogue: 0,0:06:50.24,0:06:53.16,Default,,0,0,0,,Прототип күштірек деп айту дұрыс емес.
Dialogue: 0,0:06:53.24,0:06:55.28,Default,,0,0,0,,О, сен маған ештеңе айтпайсың ғой, солай ма?
Dialogue: 0,0:06:55.37,0:06:59.00,Default,,0,0,0,,Қызық, мен бұл ауызды қалай жаба аламын?
Dialogue: 0,0:07:00.50,0:07:03.50,Default,,0,0,0,,Кішкентай кезімнен бері бұл маған ұнамайтын жалғыз адам.
Dialogue: 0,0:07:03.79,0:07:06.17,Default,,0,0,0,,Бірақ Саймон мырза, не болады?
Dialogue: 0,0:07:06.42,0:07:07.46,Default,,0,0,0,,Тұтқындау туралы не деуге болады?
Dialogue: 0,0:07:07.55,0:07:09.55,Default,,0,0,0,,Қамауға алу ма? Өлім жазасы!
Dialogue: 0,0:07:09.67,0:07:11.84,Default,,0,0,0,,Аттенборо мырза, сіз тым асығыссыз!
Dialogue: 0,0:07:11.97,0:07:15.10,Default,,0,0,0,,Менің ойымша, Россиудың да кейбір идеялары болды.
Dialogue: 0,0:07:15.39,0:07:21.06,Default,,0,0,0,,Енді бізге жаңа жауларға қарсы тиімді қару жасау керек.
Dialogue: 0,0:07:21.19,0:07:23.90,Default,,0,0,0,,Мен мұны істей алмайынша ұйықтауға уақытым жоқ.
Dialogue: 0,0:07:24.44,0:07:27.44,Default,,0,0,0,,Аттенборо, бұл есепті Россиуға беріңіз.
Dialogue: 0,0:07:27.52,0:07:28.82,Default,,0,0,0,,Бұл сәйкестік!
Dialogue: 0,0:07:30.11,0:07:33.41,Default,,0,0,0,,Не деген сұмдық!
Dialogue: 0,0:07:34.28,0:07:38.04,Default,,0,0,0,,Мені айналдыруды саған кім айтты?
Dialogue: 0,0:07:38.91,0:07:41.37,Default,,0,0,0,,Бұрылыс? Мүмкін...
Dialogue: 0,0:07:41.50,0:07:43.62,Default,,0,0,0,,Сол бейнені маған қайта көрсет.
Dialogue: 0,0:07:43.71,0:07:44.83,Default,,0,0,0,,Бұл матч!
Dialogue: 0,0:07:44.96,0:07:49.71,Default,,0,0,0,,Сондықтан мен емес деп отырсың! !
Dialogue: 0,0:07:53.22,0:07:55.93,Default,,0,0,0,,Қалған жерасты қалаларын іздеу аяқталды
Dialogue: 0,0:07:59.06,0:08:02.86,Default,,0,0,0,,Ол жер астында 1000 метрден астам айдың соқтығысуына төтеп бере алады деп айтылады.
Dialogue: 0,0:08:02.86,0:08:07.36,Default,,0,0,0,,​​Дүние жүзінде күтілетін құрылымы бар 36 жер асты қаласы бар.
Dialogue: 0,0:08:07.56,0:08:10.82,Default,,0,0,0,,Ол шамамен 640 000 адамды қабылдай алады.
Dialogue: 0,0:08:11.24,0:08:14.15,Default,,0,0,0,,Жақсы, бұл мен күткеннен де көп.
Dialogue: 0,0:08:14.24,0:08:17.32,Default,,0,0,0,,Бұрын адамдар осындай өркениет құрған.
Dialogue: 0,0:08:17.62,0:08:19.28,Default,,0,0,0,,Мен риза болуым керек.
Dialogue: 0,0:08:19.37,0:08:24.25,Default,,0,0,0,,Дегенмен, тіпті жергілікті адамдар антиспиральға тең келе алмады.
Dialogue: 0,0:08:25.50,0:08:29.80,Default,,0,0,0,,Біз бәрібір, қандай жолмен болса да аман қаламыз
Dialogue: 0,0:08:30.84,0:08:33.13,Default,,0,0,0,,Тағы 360 000 адам...
Dialogue: 0,0:08:33.38,0:08:37.14,Default,,0,0,0,,Атап айтқанда, Камина қаласының тұрғындарымен не істеуіміз керек?
Dialogue: 0,0:08:37.22,0:08:41.77,Default,,0,0,0,,Көмекші Россиу биологиялық компьютердің терең дерекқорында осындай ақпаратқа ие.
Dialogue: 0,0:08:41.85,0:08:44.48,Default,,0,0,0,,Бұл не? Жердің қай жерінде?
Dialogue: 0,0:08:44.69,0:08:47.15,Default,,0,0,0,,Ол тікелей Камина қалалық Конгресс мұнарасының астында жер астында орналасқан.
Dialogue: 0,0:08:56.82,0:08:57.82,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:08:58.32,0:09:02.91,Default,,0,0,0,,Спираль патшасы күткендей, мен оның мұндай картаны жасырып жатқанын білмедім.
Dialogue: 0,0:09:20.35,0:09:22.01,Default,,0,0,0,,Үкімді айтыңыз
Dialogue: 0,0:09:22.10,0:09:25.35,Default,,0,0,0,,Айыпталушы Саймон өлім жазасына кесілді!
Dialogue: 0,0:09:26.44,0:09:28.27,Default,,0,0,0,,Эй! күте тұрыңыз!
Dialogue: 0,0:09:28.35,0:09:29.40,Default,,0,0,0,,Әзіл!
Dialogue: 0,0:09:29.48,0:09:30.73,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:30.86,0:09:32.32,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:09:34.40,0:09:38.78,Default,,0,0,0,,Бұл туралы! Баринбоның заңгер болуы абсурд болар еді!
Dialogue: 0,0:09:39.20,0:09:42.66,Default,,0,0,0,,Ал прокурор – Гимбри, демек ол – судья!
Dialogue: 0,0:09:42.83,0:09:46.12,Default,,0,0,0,,Менің ойымша, олардың дұрыс сот отырысын өткізуге ниеті жоқ!
Dialogue: 0,0:09:47.75,0:09:50.83,Default,,0,0,0,,Тыныш, Китан заңгерлік бас директоры
Dialogue: 0,0:09:50.92,0:09:54.84,Default,,0,0,0,,Біреу жауапкершілікті өз мойнына алмаса, жұртшылық ешқашан риза болмайды.
Dialogue: 0,0:09:55.34,0:09:59.30,Default,,0,0,0,,Бұл жауапкершілікті Бас қолбасшы Саймоннан басқа кім өз мойнына ала алады?
Dialogue: 0,0:09:59.68,0:10:02.43,Default,,0,0,0,,Бұл өлім жазасына қажеттілік бар дегенді білдіре ме? ?
Dialogue: 0,0:10:02.55,0:10:06.48,Default,,0,0,0,,Қазіргі аласапыранның бітетіні рас, бірақ одан кейін не болады?
Dialogue: 0,0:10:06.77,0:10:09.06,Default,,0,0,0,,Құлаған ай туралы не істейсіз?
Dialogue: 0,0:10:09.14,0:10:11.94,Default,,0,0,0,,Біз қазір осы мақсат үшін эвакуациялау жоспарымен жұмыс істеп жатырмыз.
Dialogue: 0,0:10:12.40,0:10:16.36,Default,,0,0,0,,Адамзат аман қалуы үшін сол ақымақ толқуды қазір тоқтатыңыз.
Dialogue: 0,0:10:16.44,0:10:19.45,Default,,0,0,0,,Сабырлы және жылдам әрекетті ынталандыру керек.
Dialogue: 0,0:10:19.86,0:10:24.87,Default,,0,0,0,,Россиудың көмекшісі, жоқ, жаңа бас қолбасшыға қатысты.
Dialogue: 0,0:10:25.39,0:10:26.79,Default,,0,0,0,,- Бас қолбасшы? - Бас қолбасшы?
Dialogue: 0,0:10:26.79,0:10:30.92,Default,,0,0,0,,Жаңа бас қолбасшы? Бұл мемлекеттік төңкеріс, Россиу!
Dialogue: 0,0:10:31.00,0:10:32.75,Default,,0,0,0,,Бұл мемлекеттік төңкеріс емес.
Dialogue: 0,0:10:32.84,0:10:37.42,Default,,0,0,0,,Қолбасшы Саймон кінәлі деп танылған соң...
Dialogue: 0,0:10:38.26,0:10:42.85,Default,,0,0,0,,Аники, мұндай жағдайда не істер едің?
Dialogue: 0,0:10:46.85,0:10:48.23,Default,,0,0,0,,Жақын!
Dialogue: 0,0:10:51.81,0:10:53.19,Default,,0,0,0,,Эй, бұл Ниа!
Dialogue: 0,0:10:53.31,0:10:54.52,Default,,0,0,0,,Бұл рас па!
Dialogue: 0,0:10:54.61,0:10:56.28,Default,,0,0,0,,Қайдан келдің? ?
Dialogue: 0,0:10:57.57,0:11:01.86,Default,,0,0,0,,Анти-Спираль абсолютті үмітсіздікті қалайды.
Dialogue: 0,0:11:02.16,0:11:04.41,Default,,0,0,0,,Спиральды өмір сүруге үміт жоқ
Dialogue: 0,0:11:04.70,0:11:06.41,Default,,0,0,0,,Не туралы айтып тұрсың, Ниа!
Dialogue: 0,0:11:06.49,0:11:10.62,Default,,0,0,0,,Абсолютті үмітсіздік дегеніміз не? Неліктен мұндай нәрсені жасайсыз? ?
Dialogue: 0,0:11:14.08,0:11:17.50,Default,,0,0,0,,Екі аптадан кейін менде өмірге деген сүйіспеншілік пайда болды.
Dialogue: 0,0:11:17.80,0:11:21.01,Default,,0,0,0,,Соңғы сәттерді ауыртпалықпен қарсы алыңыз
Dialogue: 0,0:11:24.55,0:11:26.76,Default,,0,0,0,,Жақын! Барма!
Dialogue: 0,0:11:31.48,0:11:33.19,Default,,0,0,0,,Сибелла, не болды?
Dialogue: 0,0:11:33.56,0:11:36.52,Default,,0,0,0,,Мұғанның Литтнерге жоспарланған баспана құрылысы алаңындағы реакциясы
Dialogue: 0,0:11:36.65,0:11:38.65,Default,,0,0,0,,Ол алдыңғысынан әлдеқайда үлкен.
Dialogue: 0,0:11:51.79,0:11:56.59,Default,,0,0,0,,​​Эй, бұл Литтнер ауданы. Мұғанның үлкен кесегі осы жолмен келе жатыр!
Dialogue: 0,0:12:00.17,0:12:01.59,Default,,0,0,0,,Олар шабуыл жасады!
Dialogue: 0,0:12:02.67,0:12:05.68,Default,,0,0,0,,Ақылға қонымсыз шабуыл Ешбір баспана мұндай нәрсені көтере алмайды!
Dialogue: 0,0:12:06.64,0:12:09.81,Default,,0,0,0,,Алғашқы көмек! маған көмектесші! Өтінемін көмектесіңізші!
Dialogue: 0,0:12:11.52,0:12:15.77,Default,,0,0,0,,Мұған Камина қаласына қарай жылжи бастаған сияқты.
Dialogue: 0,0:12:18.23,0:12:19.69,Default,,0,0,0,,Риттнер…
Dialogue: 0,0:12:21.11,0:12:23.95,Default,,0,0,0,,Риттнерге не болды?
Dialogue: 0,0:12:25.57,0:12:27.62,Default,,0,0,0,,Операция бөлмесіне оралайық.
Dialogue: 0,0:12:27.99,0:12:29.62,Default,,0,0,0,,Күте тұрыңыз, Россиу
Dialogue: 0,0:12:31.04,0:12:34.29,Default,,0,0,0,,Мені Гуррен Лаганнға қойыңыз
Dialogue: 0,0:12:34.67,0:12:36.08,Default,,0,0,0,,Түсінемін
Dialogue: 0,0:12:36.17,0:12:40.00,Default,,0,0,0,,Гуррен Лаган - олармен күресудің жалғыз жолы!
Dialogue: 0,0:12:40.38,0:12:43.42,Default,,0,0,0,,Бұл оның ерлігінің арқасында атын қайтарып алады дегенді білдіре ме?
Dialogue: 0,0:12:43.55,0:12:46.64,Default,,0,0,0,,Бұл емес! Мен тек осы қаланы қорғағым келеді!
Dialogue: 0,0:12:46.76,0:12:48.55,Default,,0,0,0,,Бірақ сен өлім жазасына кесілгенсің.
Dialogue: 0,0:12:48.64,0:12:52.22,Default,,0,0,0,,Сіз қашып кетуі мүмкін тұтқынға Гуррен Лаганнды сеніп тапсыруды айтасыз ба? ?
Dialogue: 0,0:12:53.27,0:12:54.69,Default,,0,0,0,,Россиу, төме!
Dialogue: 0,0:12:54.81,0:12:59.86,Default,,0,0,0,,Сосын бортқа бомба немесе басқасын сал! Мен қашып кетсем, оны жарып жібере аласыз!
Dialogue: 0,0:13:11.95,0:13:13.08,Default,,0,0,0,,Гимбли
Dialogue: 0,0:13:13.29,0:13:14.25,Default,,0,0,0,,Иә
Dialogue: 0,0:13:14.33,0:13:17.04,Default,,0,0,0,,Негізгі бұрғы қоймасының құлпын ашыңыз.
Dialogue: 0,0:13:17.46,0:13:20.96,Default,,0,0,0,,Гленге бомба қоюды ұмытпаңыз. Асығыңыз!
Dialogue: 0,0:13:24.63,0:13:26.72,Default,,0,0,0,,Гуррен Лаганн келе жатыр!
Dialogue: 0,0:13:26.93,0:13:29.43,Default,,0,0,0,,Түсінікті! Бұл да күту режимінде жақсы
Dialogue: 0,0:13:29.51,0:13:32.35,Default,,0,0,0,,Хинон! Неліктен Кинон Гленнді мініп жүр?
Dialogue: 0,0:13:32.39,0:13:35.68,Default,,0,0,0,,Мен белдігіме бомба жарғышын орнаттым.
Dialogue: 0,0:13:35.81,0:13:36.56,Default,,0,0,0,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:13:36.64,0:13:42.11,Default,,0,0,0,,Саймон мырза, егер сіз аздап күдікті әрекет етсеңіз, мен детонатор қосқышын басамын.
Dialogue: 0,0:13:42.19,0:13:44.28,Default,,0,0,0,,Идиот! Не айтқың келеді?
Dialogue: 0,0:13:45.03,0:13:47.15,Default,,0,0,0,,Неліктен мен Кинонға баруым керек?
Dialogue: 0,0:13:47.24,0:13:50.74,Default,,0,0,0,,Егер ол бортта болса, сіз оны міндетті түрде тірі қалдыруыңыз керек.
Dialogue: 0,0:13:50.87,0:13:55.83,Default,,0,0,0,,Егер сіз жалғыз болсаңыз, ұрыс кезіндегі арнайы шабуыл сияқты жалған қаһармандық әрекет жасауыңыз мүмкін.
Dialogue: 0,0:13:56.25,0:13:59.29,Default,,0,0,0,,Сондықтан хинонды мұндай қауіпке ұшыратудың қажеті жоқ.
Dialogue: 0,0:13:59.42,0:14:01.17,Default,,0,0,0,,Мен ерікті болдым.
Dialogue: 0,0:14:01.25,0:14:02.29,Default,,0,0,0,,Хинон…
Dialogue: 0,0:14:02.59,0:14:06.13,Default,,0,0,0,,Жақсы, үйге аман-есен жеткенше, ешқандай проблема жоқ.
Dialogue: 0,0:14:07.09,0:14:10.18,Default,,0,0,0,,Бұл оның үйіне тірі оралатынын және өлім жазасын алатынын білдіре ме?
Dialogue: 0,0:14:11.35,0:14:13.89,Default,,0,0,0,,- Кеттік! - А, иә!
Dialogue: 0,0:14:18.98,0:14:22.15,Default,,0,0,0,,Россиу командирі, хабар таратуға дайындық аяқталды.
Dialogue: 0,0:14:25.65,0:14:28.45,Default,,0,0,0,,Эй, бұл Гуррен Лаганн емес пе?
Dialogue: 0,0:14:28.53,0:14:32.07,Default,,0,0,0,,Бірақ Симон тұтқындалды, не болды?
Dialogue: 0,0:14:34.28,0:14:36.54,Default,,0,0,0,,Үкіметтен маңызды хабарландыру
Dialogue: 0,0:14:36.66,0:14:39.71,Default,,0,0,0,,Қайталап айтамын, бұл үкіметтің маңызды мәлімдемесі.
Dialogue: 0,0:14:40.17,0:14:41.42,Default,,0,0,0,,Құрметті азаматтар
Dialogue: 0,0:14:41.50,0:14:45.25,Default,,0,0,0,,Өзін Анти-Спираль деп атайтын жұмбақ жаудың айдың шабуылына байланысты.
Dialogue: 0,0:14:45.55,0:14:48.30,Default,,0,0,0,,Жер қатты соққыға ұшырайды.
Dialogue: 0,0:14:48.67,0:14:53.85,Default,,0,0,0,,Жаңа үкімет бұл жағдай үшін бұрынғы бас қолбасшы Саймонды жауапты деп санауға тырысты.
Dialogue: 0,0:14:53.93,0:14:57.18,Default,,0,0,0,,Бүгінгі сот отырысында біз өлім жазасын тағайындау туралы шешім қабылдадық.
Dialogue: 0,0:14:58.14,0:14:59.35,Default,,0,0,0,,Біз көмектескіміз келеді, білесің бе.
Dialogue: 0,0:15:01.23,0:15:03.86,Default,,0,0,0,,Мен оларды Камина Ситиге жібере алмаймын.
Dialogue: 0,0:15:06.23,0:15:09.28,Default,,0,0,0,,Қандай жағдай болмасын, мен оны осы жерден тоқтатамын.
Dialogue: 0,0:15:09.78,0:15:13.41,Default,,0,0,0,,Қазіргі уақытта Камина қаласының шетінде пайда болған Мұғанды ​​ұстап алу үшін.
Dialogue: 0,0:15:13.91,0:15:17.62,Default,,0,0,0,,Мен бұрынғы бас қолбасшы Саймон басқаратын Гуррен Лаганнды жібердім.
Dialogue: 0,0:15:18.20,0:15:20.75,Default,,0,0,0,,Бұл толығымен жаңа үкіметтің бақылауында.
Dialogue: 0,0:15:20.87,0:15:24.92,Default,,0,0,0,,​​Қандай да бір күдікті мінез-құлық болса, ол осы жерде жарылуы мүмкін етіп орнатылады.
Dialogue: 0,0:15:25.34,0:15:27.38,Default,,0,0,0,,Қарғыс атсын! Россиу жасайық!
Dialogue: 0,0:15:27.84,0:15:29.92,Default,,0,0,0,,Адамдарды Айдың соқтығысудан қорғау үшін
Dialogue: 0,0:15:30.01,0:15:32.88,Default,,0,0,0,,Үкімет ауқымды бұзу бағдарламасын жүзеге асырады
Dialogue: 0,0:15:33.30,0:15:37.64,Default,,0,0,0,,Азаматтар әлемнің 36 жеріндегі үлкен жер асты баспаналарына эвакуацияланады.
Dialogue: 0,0:15:37.76,0:15:40.52,Default,,0,0,0,,Камина қаласының маңындағы баспанасыз тұрғындар
Dialogue: 0,0:15:40.60,0:15:45.86,Default,,0,0,0,,Өте қорқынышты алып ғарыштық Дайгун көмегімен стратосфераның сыртында уақытша эвакуациялаңыз
Dialogue: 0,0:15:46.06,0:15:49.65,Default,,0,0,0,,Бұл ғарыштық Дайгун, Аркглен!
Dialogue: 0,0:15:59.45,0:16:02.75,Default,,0,0,0,,Жаңа үкіметке сенулеріңізді қалаймын! Мен Анти-Спиральдан жеңілмеймін!
Dialogue: 0,0:16:02.83,0:16:05.46,Default,,0,0,0,,Біз міндетті түрде аман қаламыз! !
Dialogue: 0,0:16:08.55,0:16:11.76,Default,,0,0,0,,Ро-ши-у!
Dialogue: 0,0:16:12.17,0:16:13.76,Default,,0,0,0,,Ро-ши-у!
Dialogue: 0,0:16:13.97,0:16:15.84,Default,,0,0,0,,Сіз мұнымен өмір сүре аласыз!
Dialogue: 0,0:16:15.93,0:16:17.72,Default,,0,0,0,,Ро-ши-у!
Dialogue: 0,0:16:27.02,0:16:30.57,Default,,0,0,0,,Саймон мырза, Мұған бұрылып сізге қарай келеді.
Dialogue: 0,0:16:31.57,0:16:34.70,Default,,0,0,0,,Жақсы, мен сені Камина Ситиден алыстатамын.
Dialogue: 0,0:16:37.16,0:16:40.16,Default,,0,0,0,,Қарсылас баяу, сондықтан алысқа жібермеуге тырысыңыз.
Dialogue: 0,0:16:40.33,0:16:41.37,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:42.00,0:16:43.25,Default,,0,0,0,,Сәуле тоқтады ма?
Dialogue: 0,0:16:50.50,0:16:52.59,Default,,0,0,0,,Ол шынымен де қорқытады.
Dialogue: 0,0:17:00.76,0:17:04.23,Default,,0,0,0,,О, жоқ! Ақыр соңында, мен тағы да Камина Ситиге бет алдым!
Dialogue: 0,0:17:04.35,0:17:08.06,Default,,0,0,0,,Симон! Бұрынғыдан үлкен Мұған ғана алыстап кеткен!
Dialogue: 0,0:17:08.36,0:17:10.48,Default,,0,0,0,,Мүмкін бұл басқару мұнарасы.
Dialogue: 0,0:17:10.82,0:17:13.19,Default,,0,0,0,,Түсінемін, мен оны сынап көруім керек!
Dialogue: 0,0:17:33.42,0:17:34.46,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,0:17:37.76,0:17:40.26,Default,,0,0,0,,- Жақын! - Қош бол, Саймон!
Dialogue: 0,0:17:46.94,0:17:48.23,Default,,0,0,0,,Қоршалған!
Dialogue: 0,0:17:49.27,0:17:52.69,Default,,0,0,0,,Егер мені бірден бірнеше рет нысанаға алса, мен оларды бір Гига Дриллмен тойтармаймын!
Dialogue: 0,0:17:52.94,0:17:55.44,Default,,0,0,0,,Біреуі болмаса, қайтара аламын!
Dialogue: 0,0:17:56.49,0:18:03.16,Default,,0,0,0,,Giga Drill, Максимум! !
Dialogue: 0,0:18:43.45,0:18:45.62,Default,,0,0,0,,Кинон, жақсысың ба?
Dialogue: 0,0:18:45.87,0:18:46.95,Default,,0,0,0,,Хинон!
Dialogue: 0,0:18:49.62,0:18:53.63,Default,,0,0,0,,Саймон мырза, иә, бәрібір.
Dialogue: 0,0:18:53.84,0:18:56.38,Default,,0,0,0,,Жиренішті нәрсе қалды!
Dialogue: 0,0:18:57.13,0:18:59.05,Default,,0,0,0,,Жоқ, қозғалмаңыз.
Dialogue: 0,0:18:59.92,0:19:01.72,Default,,0,0,0,,Соңғы сәлем—әділетті қоғам үшін құрбандық.
Dialogue: 0,0:19:04.55,0:19:06.43,Default,,0,0,0,,Уау! Әрең қауіпсіз!
Dialogue: 0,0:19:06.51,0:19:07.81,Default,,0,0,0,,Беремін бе?
Dialogue: 0,0:19:08.31,0:19:11.81,Default,,0,0,0,,Күткеніңізге рахмет! Мен саған Глапарттың күшін көрсетемін
Dialogue: 0,0:19:12.15,0:19:14.94,Default,,0,0,0,,Кеттік! Торнадо қалыптасуы!
Dialogue: 0,0:19:18.32,0:19:20.65,Default,,0,0,0,,Спиральды бомбалаушы атылды!
Dialogue: 0,0:19:20.90,0:19:22.95,Default,,0,0,0,,Торнадо қалқаны орналастырылды!
Dialogue: 0,0:19:36.21,0:19:38.00,Default,,0,0,0,,Сәттілік! Рон мырза!
Dialogue: 0,0:19:38.21,0:19:41.17,Default,,0,0,0,,Ересек болу - бұл уақыт табу.
Dialogue: 0,0:19:42.72,0:19:46.22,Default,,0,0,0,,Кинон, кешіріңіз.
Dialogue: 0,0:19:51.39,0:19:56.15,Default,,0,0,0,,Бұл мен білетін Ниа емес.
Dialogue: 0,0:20:06.66,0:20:08.41,Default,,0,0,0,,Негізгі бұрғы
Dialogue: 0,0:20:19.17,0:20:21.30,Default,,0,0,0,,Гуррен Лаганн жойылады
Dialogue: 0,0:20:21.51,0:20:23.84,Default,,0,0,0,,Мен енді саған сенбеймін
Dialogue: 0,0:20:25.30,0:20:27.22,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:20:32.02,0:20:33.48,Default,,0,0,0,,Саймон!
Dialogue: 0,0:20:39.52,0:20:41.19,Default,,0,0,0,,Саймон!
Dialogue: 0,0:20:41.36,0:20:44.20,Default,,0,0,0,,Саймон! ! !
Dialogue: 0,0:21:09.47,0:21:11.26,Default,,0,0,0,,Россиу!
Dialogue: 0,0:21:13.73,0:21:18.06,Default,,0,0,0,,Әй, әпкемді не қылдың!
Dialogue: 0,0:21:18.56,0:21:22.07,Default,,0,0,0,,Бомба дегенде хинонды айтасыз! Бұл Теменің айласы! ?
Dialogue: 0,0:21:25.90,0:21:28.03,Default,,0,0,0,,Мен сені кешірмеймін
Dialogue: 0,0:21:28.20,0:21:31.33,Default,,0,0,0,,Мен сені кешірмеймін! !
Dialogue: 0,0:21:35.83,0:21:37.79,Default,,0,0,0,,Мені қате түсінбе, ағайын!
Dialogue: 0,0:21:37.87,0:21:41.34,Default,,0,0,0,,Мен ерікті болдым! Мен адам бомбасына айналамын дедіңіз!
Dialogue: 0,0:21:41.63,0:21:44.01,Default,,0,0,0,,Мен Россиуға көмектескім келді!
Dialogue: 0,0:21:44.30,0:21:45.76,Default,,0,0,0,,Хинон!
Dialogue: 0,0:21:46.05,0:21:50.26,Default,,0,0,0,,Үлкен аға Россиу туралы ештеңе білмейді.
Dialogue: 0,0:22:21.25,0:22:24.63,Default,,0,0,0,,Уау, міне бір қызық адам келеді.
Dialogue: 0,0:22:26.63,0:22:31.01,Default,,0,0,0,,Түрмеге қош келдіңіз, командир Саймон!
Dialogue: 0,0:24:06.56,0:24:08.98,Default,,0,0,0,,Үміт әп-сәтте үмітсіздікке айналады
Dialogue: 0,0:24:09.07,0:24:11.28,Default,,0,0,0,,Ең жақсы таңдау және ең нашар таңдау
Dialogue: 0,0:24:11.74,0:24:14.61,Default,,0,0,0,,Сонда да мен шешем, олар
Dialogue: 0,0:24:15.16,0:24:17.95,Default,,0,0,0,,Келесі Тенген Топпа Гуррен Лаганн
Dialogue: 0,0:24:17.95,0:24:20.58,Default,,0,0,0,,Құдай бізді қаншалықты сынайды?
Dialogue: 0,0:24:22.08,0:24:27.08,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
