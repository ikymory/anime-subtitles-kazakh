Dialogue: 0,0:00:37.87,0:00:41.27,Default,,0,0,0,,((Бірақ маған мұнда қытырлақ гриль лосось ұнайды!))
Dialogue: 0,0:00:41.27,0:00:43.41,Default,,0,0,0,,Рю-чан)) (Ямагучи)((Маған тамогояки дәмі ұнайды))
Dialogue: 0,0:00:43.41,0:00:47.04,Default,,0,0,0,,((Күрішті тегін толтыру...)) (Кано Ута) ()
Dialogue: 0,0:00:47.04,0:00:50.95,Default,,0,0,0,,((Оп...)) ((Карасуно, жеңгеніңді естідім))
