Dialogue: 0,0:01:06.63,0:01:08.63,Default,,0,0,0,,((Оның тамыр соғысы бар)) (Танака) ((Оп...))
Dialogue: 0,0:01:10.17,0:01:29.62,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:01:29.62,0:01:33.66,Default,,0,0,0,,♬ Қазір тоқтама Тоқтатпа Тоқтатпа
Dialogue: 0,0:01:33.66,0:01:38.66,Default,,0,0,0,,♬ Мен ең төменгі талаптарды білемін.
Dialogue: 0,0:01:38.66,0:01:43.17,Default,,0,0,0,,♬ Қазір тоқтама Тоқтатпа Тоқтатпа
Dialogue: 0,0:01:43.17,0:01:49.50,Default,,0,0,0,,♬ Тоқтасаң, орындалмайды.
Dialogue: 0,0:01:49.50,0:01:53.94,Default,,0,0,0,,♬ Егер сіз тырыспасаңыз, сіз одан ләззат ала алмайсыз.
Dialogue: 0,0:01:53.94,0:01:58.51,Default,,0,0,0,,♬ Ең қызық нәрсе
Dialogue: 0,0:01:58.51,0:02:03.19,Default,,0,0,0,,♬ жеткіліксіз артық емес
Dialogue: 0,0:02:03.19,0:02:07.29,Default,,0,0,0,,♬ Ей, сен аштан өліп жатырсың ғой?
Dialogue: 0,0:02:09.73,0:02:12.23,Default,,0,0,0,,♬ Әділ және әділ
Dialogue: 0,0:02:12.23,0:02:15.00,Default,,0,0,0,,♬ Қазір «қазір» алдында
Dialogue: 0,0:02:15.00,0:02:19.13,Default,,0,0,0,,♬ Ащы да, тәтті де шындықтан ләззат алыңыз.
Dialogue: 0,0:02:19.13,0:02:21.37,Default,,0,0,0,,♬ ұлы мәртебелі
Dialogue: 0,0:02:21.37,0:02:23.97,Default,,0,0,0,,♬ Мен фронтальды серпіліс жасағым келеді.
Dialogue: 0,0:02:23.97,0:02:29.85,Default,,0,0,0,,♬ Қызықты көрінеді. Сізге ұнайтын сияқты.
Dialogue: 0,0:02:29.85,0:02:35.25,Default,,0,0,0,,♬ Енді тоқтап қалмаңыз, одан толық рахат алыңыз және күліңіз
Dialogue: 0,0:02:35.25,0:02:39.05,Default,,0,0,0,,♬ Күлейік
Dialogue: 0,0:02:40.39,0:02:44.83,Default,,0,0,0,,((Бұл жақсы~. Танаканың сүйкімді қызы бар))
Dialogue: 0,0:02:44.83,0:02:51.83,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:02:51.83,0:02:55.00,Default,,0,0,0,,((Иә?)) (Энношита) ((Сіз жеңе алмайтын қарсылас➡)
Dialogue: 0,0:02:55.00,0:02:57.87,Default,,0,0,0,,Шимизу-сенпай ше? )) (Танака)((Сонымен... бірінші орында➡
Dialogue: 0,0:02:57.87,0:03:00.91,Default,,0,0,0,,Ол жерге тамыр соғысы бар деп бара жатырсың ба? ))
Dialogue: 0,0:03:00.91,0:03:03.41,Default,,0,0,0,,((Түсіндім! Түсіндім.➡
Dialogue: 0,0:03:03.41,0:03:06.42,Default,,0,0,0,,Бір сұлу келіншек: ``Бірге жағажай волейболын ойнайық.➡
Dialogue: 0,0:03:06.42,0:03:08.42,Default,,0,0,0,,Біреу «ұшатын құймақ» десе➡
Dialogue: 0,0:03:08.42,0:03:10.59,Default,,0,0,0,,Иә, өтінемін! ➡
Dialogue: 0,0:03:10.59,0:03:14.42,Default,,0,0,0,,Әрине, менің сұлу сыныптастарым мені қуантқанын қалаймын! ))
Dialogue: 0,0:03:14.42,0:03:19.43,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:03:19.43,0:03:24.23,Default,,0,0,0,,((білемін... Сіз сондай жігітсіз➡
Dialogue: 0,0:03:24.23,0:03:27.10,Default,,0,0,0,,Мен сені алғаш қосылған күннен білемін))
Dialogue: 0,0:03:29.84,0:03:31.84,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:03:35.44,0:03:39.45,Default,,0,0,0,,≪Уау... Өйткені, ол да волейбол үйірмесіне қатысады. ➡
Dialogue: 0,0:03:39.45,0:03:41.55,Default,,0,0,0,,Көзге тиюден аулақ болыңыз≫
Dialogue: 0,0:03:47.49,0:03:49.49,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:03:54.23,0:03:56.20,Default,,0,0,0,,()
Dialogue: 0,0:04:04.31,0:04:06.34,Default,,0,0,0,,((ке…)) (Шимизу)((иә?))
Dialogue: 0,0:04:06.34,0:04:08.94,Default,,0,0,0,,≪“ke”? ≫ ((Маған тұрмысқа шықшы!➡
Dialogue: 0,0:04:08.94,0:04:10.98,Default,,0,0,0,,Тұрмысқа шық! Өтінемін, маған тұрмысқа шықшы! ➡
Dialogue: 0,0:04:10.98,0:04:14.35,Default,,0,0,0,,Тұрмысқа шық! Маған тұрмысқа шықшы...))
Dialogue: 0,0:04:14.35,0:04:16.35,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:04:16.35,0:04:18.35,Default,,0,0,0,,)) ((⚞(ер студент) Эй!))
Dialogue: 0,0:04:22.46,0:04:25.93,Default,,0,0,0,,() ((Ға!➡
Dialogue: 0,0:04:25.93,0:04:29.50,Default,,0,0,0,,Ахх... ахх! ))
Dialogue: 0,0:04:30.93,0:04:34.27,Default,,0,0,0,,((Шабуылға ұшыраған бірінші кездесу ұсынысының оқиғасы))
Dialogue: 0,0:04:34.27,0:04:36.27,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:04:36.27,0:04:38.31,Default,,0,0,0,,()
Dialogue: 0,0:04:38.31,0:04:40.68,Default,,0,0,0,,((Гвааа~…)) (Танака)((Ааа~➡)
Dialogue: 0,0:04:40.68,0:04:43.51,Default,,0,0,0,,Ертеңгі күнді ойлап тыныштала алмаймын. ➡
Dialogue: 0,0:04:43.51,0:04:46.62,Default,,0,0,0,,Серуенге келу))
Dialogue: 0,0:04:46.62,0:04:49.45,Default,,0,0,0,,((Жақсысың ба? Ол жігіт тым бірбеткей➡
Dialogue: 0,0:04:49.45,0:04:52.89,Default,,0,0,0,,Аңдаушы сияқты нәрсе бар ма? )) (Энношита)((Бұл дұрыс емес.➡
Dialogue: 0,0:04:52.89,0:04:55.86,Default,,0,0,0,,Шимизу-сенпай адамдардың эмоциясына өте сезімтал➡
Dialogue: 0,0:04:55.86,0:04:58.86,Default,,0,0,0,,Мен оған шындап тоқта деп айтсам, тоқтайтын сияқтымын. ➡
Dialogue: 0,0:04:58.86,0:05:01.70,Default,,0,0,0,,Сосын мен саяхатқа шығамын)) (Киношита)()
Dialogue: 0,0:05:01.70,0:05:06.47,Default,,0,0,0,,((Мен бұл әрқашан ақымақ деп ойлаймын, бірақ бұл керемет.➡
Dialogue: 0,0:05:06.47,0:05:09.07,Default,,0,0,0,,Қарапайым және бір ойлы➡
Dialogue: 0,0:05:10.54,0:05:13.51,Default,,0,0,0,,Бұл шынымен қиын шығар))
Dialogue: 0,0:05:21.02,0:05:22.98,Default,,0,0,0,,Қара!
Dialogue: 0,0:05:32.36,0:05:34.36,Default,,0,0,0,,Дыбыстық сигнал!
Dialogue: 0,0:05:34.36,0:05:38.20,Default,,0,0,0,,Сәлем! (Диктор) Қызметші! ➡
Dialogue: 0,0:05:38.20,0:05:42.20,Default,,0,0,0,,Рельеф сервері Тадаши Ямагучи Оның жұмысы өз атауына сай!
Dialogue: 0,0:05:42.20,0:05:44.21,Default,,0,0,0,,Уау, сен істедің! (Гиндзима) Жүр! ➡
Dialogue: 0,0:05:44.21,0:05:46.27,Default,,0,0,0,,Бұл тітіркендіргіш, Юу! (Юу) Иә?
Dialogue: 0,0:05:47.78,0:05:50.51,Default,,0,0,0,,Кешіріңіз! (Гиндзима) Қараңдар, қараңдар.
Dialogue: 0,0:05:50.51,0:05:52.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:52.48,0:05:55.12,Default,,0,0,0,,Қара!
Dialogue: 0,0:05:55.12,0:05:57.42,Default,,0,0,0,,Тағы біреуі!
Dialogue: 0,0:06:00.09,0:06:03.09,Default,,0,0,0,,Керемет қабыл алыңыздар!
Dialogue: 0,0:06:03.09,0:06:05.09,Default,,0,0,0,,Қарғыс атсын! Хахаха….
Dialogue: 0,0:06:05.09,0:06:09.06,Default,,0,0,0,,Иә! О, ауырады! (тау сөресі) Уф!
Dialogue: 0,0:06:09.06,0:06:12.07,Default,,0,0,0,,Сіз оны жарты жолда ала алмайсыз деп ойламайсыз ба?
Dialogue: 0,0:06:12.07,0:06:16.61,Default,,0,0,0,,Келсе де, қайтара алмайсың. (Жалпы) Менің басымда не бар➡
Dialogue: 0,0:06:16.61,0:06:20.44,Default,,0,0,0,,Менің ойымша, бұл доп әлі құлап кетпегенін білдіреді.
Dialogue: 0,0:06:20.44,0:06:23.45,Default,,0,0,0,,Менің ойымша, сіз мұны бас тарту мүмкіндігі деп атай аласыз➡
Dialogue: 0,0:06:23.45,0:06:27.32,Default,,0,0,0,,Қолжетімділік? Бірақ... жоқ шығар.
Dialogue: 0,0:06:27.32,0:06:29.95,Default,,0,0,0,,Өзім….
Dialogue: 0,0:06:29.95,0:06:32.02,Default,,0,0,0,,Қара!
Dialogue: 0,0:06:32.02,0:06:34.12,Default,,0,0,0,,Уф….
Dialogue: 0,0:06:39.79,0:06:41.80,Default,,0,0,0,,≪ Қарғыс атсын! ≫ (Диктор) Бұл өте күшті! ➡
Dialogue: 0,0:06:41.80,0:06:43.93,Default,,0,0,0,,Доп Инаризаки алаңына барады.
Dialogue: 0,0:06:43.93,0:06:47.14,Default,,0,0,0,,Мүмкіндік бар. ➡
Dialogue: 0,0:06:47.14,0:06:49.97,Default,,0,0,0,,Оны жіберіп алмаңыз!
Dialogue: 0,0:06:49.97,0:06:52.97,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:06:52.97,0:06:56.58,Default,,0,0,0,,Соңғы~!
Dialogue: 0,0:06:56.58,0:06:58.58,Default,,0,0,0,,Аура... Ха!
Dialogue: 0,0:06:58.58,0:07:02.65,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:07:02.65,0:07:06.32,Default,,0,0,0,,Дыбыстық сигнал! (Диктор) Блоктау!
Dialogue: 0,0:07:06.32,0:07:09.26,Default,,0,0,0,,Рахмет сізге Кагеяма! (Кагеяма Тобио) Усу.
Dialogue: 0,0:07:09.26,0:07:12.33,Default,,0,0,0,,Асахи-сан, Эйске қара! (Томина) Ахх!
Dialogue: 0,0:07:12.33,0:07:14.33,Default,,0,0,0,,Жоқ, бұл Эйс.
Dialogue: 0,0:07:16.03,0:07:19.87,Default,,0,0,0,,≪Бәрі тамаша мінеді≫
Dialogue: 0,0:07:19.87,0:07:22.87,Default,,0,0,0,,Қазіргі уақытта интернет арқылы жүруге бола ма?
Dialogue: 0,0:07:22.87,0:07:27.21,Default,,0,0,0,,Доп та, ойыншылар да Инаризаки кортында емес, сондықтан иә.
Dialogue: 0,0:07:27.21,0:07:29.21,Default,,0,0,0,,Хааааааааа.... (Такинуэ) А, сен➡
Dialogue: 0,0:07:29.21,0:07:32.55,Default,,0,0,0,,Сіз қайда болдыңыз? Мен Тадашидің өнерін сағындым.
Dialogue: 0,0:07:32.55,0:07:35.45,Default,,0,0,0,,Бұл тезек! Ол шәкіртін құтқарып қалды!
Dialogue: 0,0:07:35.45,0:07:38.19,Default,,0,0,0,,Баспалдақ қатты... Әй?
Dialogue: 0,0:07:38.19,0:07:40.32,Default,,0,0,0,,Бірінші адам да соқты. ➡
Dialogue: 0,0:07:40.32,0:07:44.53,Default,,0,0,0,,Маған монахтың No 5-ін мақсат етемін дегенімен. (Үлкен құлақ) Уайымдама.
Dialogue: 0,0:07:44.53,0:07:48.53,Default,,0,0,0,,Карасуно орта мектебі белгіленген нүктені бірінші болып жеңіп алды.
Dialogue: 0,0:07:48.53,0:07:52.63,Default,,0,0,0,,Егер сіз мұны өткізіп алсаңыз, келесі қызмет Мия Ю болады. ➡
Dialogue: 0,0:07:52.63,0:07:56.60,Default,,0,0,0,,Карасуно қандай жағдай болмасын осы бір мәселеге тоқталғысы келеді.
Dialogue: 0,0:07:56.60,0:07:59.11,Default,,0,0,0,,Бас! (Қызмет көрсету дыбысы) Тон (қабылдау дыбысы)
Dialogue: 0,0:08:01.54,0:08:03.55,Default,,0,0,0,,Хмм!
Dialogue: 0,0:08:03.55,0:08:05.91,Default,,0,0,0,,≪Мүмкіндік бар. ➡
Dialogue: 0,0:08:05.91,0:08:08.62,Default,,0,0,0,,Мен осындамын! ≫
Dialogue: 0,0:08:10.92,0:08:13.36,Default,,0,0,0,,басыңыз! Бип!
Dialogue: 0,0:08:13.36,0:08:16.32,Default,,0,0,0,,Өшір! ➡
Dialogue: 0,0:08:16.32,0:08:19.33,Default,,0,0,0,,Оны тоқтатқан ортаңғы блокатор Ринтаро Кадона болды!
Dialogue: 0,0:08:19.33,0:08:22.86,Default,,0,0,0,,Керемет Ринтаро!
Dialogue: 0,0:08:22.86,0:08:25.37,Default,,0,0,0,,Кешіріңіз, өте қысқа болды.
Dialogue: 0,0:08:25.37,0:08:28.30,Default,,0,0,0,,Жоқ, мен бұл жұмыс істейді деп ойладым.
Dialogue: 0,0:08:28.30,0:08:33.41,Default,,0,0,0,,♬～ (Жел диапазонының өнімділігі)
Dialogue: 0,0:08:33.41,0:08:35.98,Default,,0,0,0,,Мен болсам, қазір тітіркеніп кетер едім➡
Dialogue: 0,0:08:35.98,0:08:38.35,Default,,0,0,0,,Мен мұны онлайн және сыртта жасаймын!
Dialogue: 0,0:08:38.35,0:08:40.35,Default,,0,0,0,,≪Сіз білесіз бе?≫
Dialogue: 0,0:08:40.35,0:08:42.35,Default,,0,0,0,,Нан! Қарғыс атсын!
Dialogue: 0,0:08:43.79,0:08:46.52,Default,,0,0,0,,Уф.
Dialogue: 0,0:08:46.52,0:08:48.56,Default,,0,0,0,,≪Мұнда...➡
Dialogue: 0,0:08:48.56,0:08:50.53,Default,,0,0,0,,Осы жерден кесіңіз≫
Dialogue: 0,0:08:52.19,0:08:55.20,Default,,0,0,0,,((5 санына қызмет көрсету үшін мақсат қойыңыз. 5 саны бүгін➡
Dialogue: 0,0:08:55.20,0:08:57.37,Default,,0,0,0,,Жағымды қойылған көріністер көп емес. ➡
Dialogue: 0,0:08:57.37,0:08:59.77,Default,,0,0,0,,Мені төмен сүйреп кетсеңіз...➡
Dialogue: 0,0:08:59.77,0:09:01.77,Default,,0,0,0,,5-санынан))
