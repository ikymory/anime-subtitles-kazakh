Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:40.30,0:00:42.47,Default,,0,0,0,,Қара!
Dialogue: 0,0:00:42.47,0:00:44.47,Default,,0,0,0,,Инаризаки - капитанның ➡
Dialogue: 0,0:00:44.47,0:00:48.48,Default,,0,0,0,,Синсуке Китамен таныстыру. Бұл қорғанысты күшейту үшін ме?
Dialogue: 0,0:00:48.48,0:00:51.31,Default,,0,0,0,,Иә. Ол кірген кезде➡
Dialogue: 0,0:00:51.31,0:00:54.82,Default,,0,0,0,,Қорғаныс жағынан да, психикалық жағынан да тұрақты көрінеді➡
Dialogue: 0,0:00:54.82,0:00:56.79,Default,,0,0,0,,Инаризаки.
Dialogue: 0,0:00:58.82,0:01:01.49,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:01:01.49,0:01:04.33,Default,,0,0,0,,((Ах?)) (Кита)((Мені бұл жерге қосуға болмайды➡
Dialogue: 0,0:01:04.33,0:01:07.80,Default,,0,0,0,,Бұл пассивті қорғаныс емес пе? )) (Куросу)((Хмм? Аа?➡
Dialogue: 0,0:01:07.80,0:01:10.70,Default,,0,0,0,,Бұл менің ең үлкен шабуылым. ➡
Dialogue: 0,0:01:10.70,0:01:13.67,Default,,0,0,0,,Миянзу бүгін сондай өткір➡
Dialogue: 0,0:01:13.67,0:01:17.77,Default,,0,0,0,,Егер солтүстікті салсаңыз, тежегішті баса алмайсыз))
Dialogue: 0,0:01:17.77,0:01:19.74,Default,,0,0,0,,()
Dialogue: 0,0:01:21.31,0:01:25.31,Default,,0,0,0,,≪Шынымды айтсам, бұл сөз маған ұнамайды≫
Dialogue: 0,0:01:25.31,0:01:28.05,Default,,0,0,0,,≪Жол тек алда емес➡
Dialogue: 0,0:01:28.05,0:01:30.95,Default,,0,0,0,,Қиындық пен абайсыздық екі түрлі нәрсе. ➡
Dialogue: 0,0:01:30.95,0:01:35.96,Default,,0,0,0,,Мен ондай адамдарды түсінбеймін. Бірақ➡
Dialogue: 0,0:01:35.96,0:01:40.06,Default,,0,0,0,,Қарасам, жүрегімді жылытатыны анық≫
Dialogue: 0,0:01:40.06,0:01:44.03,Default,,0,0,0,,≪Мен ағымды өзгерте алатын ойыншы емеспін➡
Dialogue: 0,0:01:44.03,0:01:46.87,Default,,0,0,0,,Алға асықпа, мына жігіттердің арқасы➡
Dialogue: 0,0:01:46.87,0:01:48.90,Default,,0,0,0,,Аз болса да қорғай алсам екен≫
Dialogue: 0,0:01:48.90,0:01:51.51,Default,,0,0,0,,О? Мен мұны қазір істей аламын деп ойлаймын.
Dialogue: 0,0:01:53.04,0:01:57.15,Default,,0,0,0,,≪Мүмкін сен де шығарсың≫
Dialogue: 0,0:02:00.68,0:02:19.90,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:19.90,0:02:24.34,Default,,0,0,0,,♬ Қазір тоқтама Тоқтатпа Тоқтатпа
Dialogue: 0,0:02:24.34,0:02:29.34,Default,,0,0,0,,♬ Мен ең төменгі талаптарды білемін.
Dialogue: 0,0:02:29.34,0:02:33.45,Default,,0,0,0,,♬ Қазір тоқтама Тоқтатпа Тоқтатпа
Dialogue: 0,0:02:33.45,0:02:39.96,Default,,0,0,0,,♬ Тоқтасаң, орындалмайды.
Dialogue: 0,0:02:39.96,0:02:44.39,Default,,0,0,0,,♬ Тырыспасаң, рахат ала алмайсың.
Dialogue: 0,0:02:44.39,0:02:49.10,Default,,0,0,0,,♬ Ең қызық нәрсе
Dialogue: 0,0:02:49.10,0:02:53.70,Default,,0,0,0,,♬ жеткіліксіз артық емес
Dialogue: 0,0:02:53.70,0:02:57.67,Default,,0,0,0,,♬ Ей, аштан өліп жатырсың ғой?
Dialogue: 0,0:03:00.28,0:03:02.78,Default,,0,0,0,,♬ Әділ және әділ
Dialogue: 0,0:03:02.78,0:03:05.45,Default,,0,0,0,,♬ Қазір «қазір» алдында
Dialogue: 0,0:03:05.45,0:03:09.79,Default,,0,0,0,,♬ Ащы да, тәтті де шындықтан ләззат алыңыз.
Dialogue: 0,0:03:09.79,0:03:11.79,Default,,0,0,0,,♬ ұлы мәртебелі
Dialogue: 0,0:03:11.79,0:03:14.49,Default,,0,0,0,,♬ Мен фронтальды серпіліс жасағым келеді.
Dialogue: 0,0:03:14.49,0:03:20.30,Default,,0,0,0,,♬ Қызықты көрінеді. Сізге ұнайтын сияқты.
Dialogue: 0,0:03:20.30,0:03:25.90,Default,,0,0,0,,♬ Енді тоқтап қалмай, рахаттанып, күліңіз
Dialogue: 0,0:03:25.90,0:03:29.27,Default,,0,0,0,,♬ Күлейік
Dialogue: 0,0:03:30.74,0:03:34.31,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:03:34.31,0:03:36.98,Default,,0,0,0,,Жарайсыңдар! (Гиндзима) Тағы бір рет Тағы бір рет!
Dialogue: 0,0:03:36.98,0:03:40.45,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:03:40.45,0:03:44.29,Default,,0,0,0,,Дыбыстық сигнал! (Ер) Керемет Ринтаро!
Dialogue: 0,0:03:44.29,0:03:46.96,Default,,0,0,0,,Керемет Ринтаро! (Цукисима) Күрсін... Күрсін...
Dialogue: 0,0:03:46.96,0:03:50.43,Default,,0,0,0,,Төзімділік жетіспейді ме? (Цукисима) Фу….
Dialogue: 0,0:03:52.69,0:03:54.70,Default,,0,0,0,,Ммм, дәмді екен.
Dialogue: 0,0:03:54.70,0:04:01.77,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:04:01.77,0:04:03.77,Default,,0,0,0,,Қайтып келеді! (Танака) Кездейсоқ доп!
Dialogue: 0,0:04:03.77,0:04:05.81,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:04:05.81,0:04:07.81,Default,,0,0,0,,≪Синхрондалған шабуыл! ≫
Dialogue: 0,0:04:10.71,0:04:12.71,Default,,0,0,0,,Қарғыс атсын! (Кадеяма Тобио) Ах...
Dialogue: 0,0:04:12.71,0:04:14.72,Default,,0,0,0,,≪Сәйкес келмейді≫
Dialogue: 0,0:04:16.28,0:04:18.29,Default,,0,0,0,,Дыбыстық сигнал! (2 адам) А...
Dialogue: 0,0:04:18.29,0:04:22.96,Default,,0,0,0,,Асығыстық жарамайды! Карасуно: Бұл жерде қорқынышты қателік!
Dialogue: 0,0:04:22.96,0:04:25.36,Default,,0,0,0,,≪Бәрекелді, қымбат болды≫
Dialogue: 0,0:04:25.36,0:04:27.33,Default,,0,0,0,,Жаман болды... (Цукисима) Кешірім сұрамайсыз ба?
Dialogue: 0,0:04:28.73,0:04:33.24,Default,,0,0,0,,Менің бойым жетпеді. (2 адам) Иә?
Dialogue: 0,0:04:33.24,0:04:36.37,Default,,0,0,0,,≪Әрқашан шабуыл жасау ниетімен секіру. ➡
Dialogue: 0,0:04:36.37,0:04:40.04,Default,,0,0,0,,Жүгіру қашықтығын қамтамасыз етуді жалғастырыңыз≫
Dialogue: 0,0:04:40.04,0:04:42.04,Default,,0,0,0,,≪Хината әрқашан осылай істейді...➡
Dialogue: 0,0:04:42.04,0:04:45.18,Default,,0,0,0,,Сіз бұдан артық істеп жатырсыз ба≫
Dialogue: 0,0:04:45.18,0:04:49.89,Default,,0,0,0,,Шулы! Мен қате түсіндім. Бұл менің қателігім болды.
Dialogue: 0,0:04:49.89,0:04:52.89,Default,,0,0,0,,Бір қызығы, сіз бұлай айтпайтын сияқтысыз.
Dialogue: 0,0:04:54.56,0:04:58.39,Default,,0,0,0,,-мен жүре аламын ба? Әрине, солай ма?
Dialogue: 0,0:04:58.39,0:05:00.73,Default,,0,0,0,,Пан Pan! (Савамура) Мен келесіні шешемін!
Dialogue: 0,0:05:00.73,0:05:03.73,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:05:03.73,0:05:06.74,Default,,0,0,0,,≪Мен бұл бақыланатын доп сияқты сезінемін≫
Dialogue: 0,0:05:06.74,0:05:08.74,Default,,0,0,0,,Мен біреуін аламын!
Dialogue: 0,0:05:10.37,0:05:12.37,Default,,0,0,0,,Дыбыстық сигнал! (Көрермендер) Уау!
Dialogue: 0,0:05:12.37,0:05:16.44,Default,,0,0,0,,Карасуно Асахи Томинеге қызмет етеді. Бұл да үлкен сервер➡
Dialogue: 0,0:05:16.44,0:05:20.02,Default,,0,0,0,,Бүгінгі табыстылық көрсеткіші шамамен 50-50. ➡
Dialogue: 0,0:05:20.02,0:05:22.68,Default,,0,0,0,,Әлі де біраз тұрақсыздық бар.
Dialogue: 0,0:05:22.68,0:05:26.76,Default,,0,0,0,,Соңғы сеттің соңында қарсыласым алда болды. ➡
Dialogue: 0,0:05:26.76,0:05:29.76,Default,,0,0,0,,Менің ойымша, қысым бұрын ештеңемен тең емес.
Dialogue: 0,0:05:29.76,0:05:35.60,Default,,0,0,0,,Қараңдар! (Тохо) ≪100%≫
Dialogue: 0,0:05:35.60,0:05:37.57,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:05:41.60,0:05:43.57,Default,,0,0,0,,Мм! Бас!
Dialogue: 0,0:05:45.94,0:05:48.61,Default,,0,0,0,,Ха... (2 адам) Ах.
Dialogue: 0,0:05:48.61,0:05:51.31,Default,,0,0,0,,Дыбыстық сигнал! Апыр-ай!
Dialogue: 0,0:05:51.31,0:05:55.38,Default,,0,0,0,,Эйстің шешімі осында шешілді, Асахи Томине! ➡
Dialogue: 0,0:05:55.38,0:05:57.42,Default,,0,0,0,,Сенсорлық эйс жоқ!
Dialogue: 0,0:05:57.42,0:06:01.76,Default,,0,0,0,,Жақсы, жақсы, Асахи! Итер, итер, Асахи! Тағы біреуі!
Dialogue: 0,0:06:01.76,0:06:05.89,Default,,0,0,0,,Самурай Ни-чан Иә! (Ер) Қызмет көрсетіңіз!
Dialogue: 0,0:06:05.89,0:06:08.63,Default,,0,0,0,,Ах~ Анау ескі жігіттер...
Dialogue: 0,0:06:08.63,0:06:13.13,Default,,0,0,0,,≪Karasuno Samurai 80% қуатпен басталған болуы мүмкін➡
Dialogue: 0,0:06:13.13,0:06:16.50,Default,,0,0,0,,Соңғы кезеңге дейін қуатты біртіндеп арттырыңыз ➡
Dialogue: 0,0:06:16.50,0:06:20.11,Default,,0,0,0,,Бар күшіңді салып келдің бе≫
Dialogue: 0,0:06:20.11,0:06:23.98,Default,,0,0,0,,Менің қарным ашты, Сэм! (Емдеу) Көрейік, Цум!
Dialogue: 0,0:06:23.98,0:06:25.98,Default,,0,0,0,,Тағы бір~!
Dialogue: 0,0:06:25.98,0:06:28.48,Default,,0,0,0,,Синсуке! ➡
Dialogue: 0,0:06:28.48,0:06:30.49,Default,,0,0,0,,Керемет қабыл алыңыздар!
Dialogue: 0,0:06:30.49,0:06:33.99,Default,,0,0,0,,Капитан Кита күшті қызмет көрсетті!
Dialogue: 0,0:06:33.99,0:06:36.36,Default,,0,0,0,,≪Мен алғанымды білмеймін, боқ≫
Dialogue: 0,0:06:36.36,0:06:38.56,Default,,0,0,0,,Мия Ю кімді пайдаланады?
Dialogue: 0,0:06:40.70,0:06:43.40,Default,,0,0,0,,≪Сұраңыз, жинаңыз. 2 берік қабырға! ≫
Dialogue: 0,0:06:45.27,0:06:47.27,Default,,0,0,0,,Жарайды! жабу!
Dialogue: 0,0:06:47.27,0:06:50.27,Default,,0,0,0,,Эй!
Dialogue: 0,0:06:50.27,0:06:52.27,Default,,0,0,0,,Керемет қабыл алыңыздар!
Dialogue: 0,0:06:52.27,0:06:56.44,Default,,0,0,0,,≪Ах~ Не деген. Бұл өте жақсы сезінеді! ≫
Dialogue: 0,0:06:56.44,0:07:00.02,Default,,0,0,0,,≪Ах... Сен қазір тылдасың ғой, солай ма? ≫
Dialogue: 0,0:07:00.02,0:07:02.72,Default,,0,0,0,,≪Қазір. Әрқашан➡
Dialogue: 0,0:07:02.72,0:07:05.12,Default,,0,0,0,,Қазір ең жақсы мүмкіндік! ≫
Dialogue: 0,0:07:07.49,0:07:10.83,Default,,0,0,0,,≪Егіз жылдам шабуыл...≫ ≪Минус қарқын...≫
Dialogue: 0,0:07:10.83,0:07:13.70,Default,,0,0,0,,≪Артқа! ≫
Dialogue: 0,0:07:13.70,0:07:15.66,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:20.70,0:07:23.81,Default,,0,0,0,,Ах! (Барлығы Инаризаки) Жақсы жалғау!
Dialogue: 0,0:07:26.57,0:07:29.58,Default,,0,0,0,,≪Мен жоғалтқым келмейді≫ ≪Жеңілуге шыдай аласыз ба?≫
Dialogue: 0,0:07:29.58,0:07:31.58,Default,,0,0,0,,≪Бітіргіңіз келе ме?≫
Dialogue: 0,0:07:31.58,0:07:36.72,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:07:38.25,0:07:41.92,Default,,0,0,0,,≪«Мен жеңілгім келмейді» «Мен жеңуім керек»➡
Dialogue: 0,0:07:41.92,0:07:44.93,Default,,0,0,0,,Сіз қандай үлпілдек нәрселер туралы ойладыңыз?
Dialogue: 0,0:07:44.93,0:07:49.50,Default,,0,0,0,,≪Жеңіс пе, әлде жеңіліс пе? Бұл нәтиже мәселесі.≫
Dialogue: 0,0:07:49.50,0:07:51.60,Default,,0,0,0,,≪Ұғым өзгеріссіз қалады≫
Dialogue: 0,0:07:51.60,0:07:53.67,Default,,0,0,0,,≪Енді мынау≫
Dialogue: 0,0:07:53.67,0:07:55.64,Default,,0,0,0,,≪Жұдырықтасуды басқару≫
Dialogue: 0,0:07:57.94,0:08:00.94,Default,,0,0,0,,≪Синхрондалған шабуыл! ≫
Dialogue: 0,0:08:00.94,0:08:04.95,Default,,0,0,0,,≪Шираторизаваға қарсы матчта ешқашан кері шабуыл болған жоқ. ➡
Dialogue: 0,0:08:04.95,0:08:09.92,Default,,0,0,0,,Бүгін де Юудың қызмет көрсету бөлігіне бір ғана снаряд тиді. ➡
Dialogue: 0,0:08:09.92,0:08:13.59,Default,,0,0,0,,Одақтастардың ізбасарларынан бас тартуды қамтитын шабуылға қатысу➡
Dialogue: 0,0:08:13.59,0:08:16.36,Default,,0,0,0,,Оның мағынасы бар ма? ≫
Dialogue: 0,0:08:16.36,0:08:19.96,Default,,0,0,0,,≪Мен мұнда достарымды қорғау үшін келген жоқпын. ➡
Dialogue: 0,0:08:19.96,0:08:23.16,Default,,0,0,0,,Біз бәріміз гол соғу үшін келдік! ≫
Dialogue: 0,0:08:25.97,0:08:28.60,Default,,0,0,0,,Әй!
Dialogue: 0,0:08:28.60,0:08:31.11,Default,,0,0,0,,Ах! Бассейн!
Dialogue: 0,0:08:31.11,0:08:33.11,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:08:33.11,0:08:36.61,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:08:36.61,0:08:39.05,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:39.05,0:08:41.85,Default,,0,0,0,,Иә. Бип!
Dialogue: 0,0:08:41.85,0:08:43.85,Default,,0,0,0,,Уау! (Диктор) Карасуно➡
Dialogue: 0,0:08:43.85,0:08:47.62,Default,,0,0,0,,Мен Инаризаки шегініп бара жатқанда оның арқасынан ұстадым!
Dialogue: 0,0:08:47.62,0:08:49.62,Default,,0,0,0,,Қара!
Dialogue: 0,0:08:49.62,0:08:53.56,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:08:53.56,0:08:55.53,Default,,0,0,0,,О... Әттең!
Dialogue: 0,0:08:58.33,0:09:00.34,Default,,0,0,0,,Бип!
Dialogue: 0,0:09:00.34,0:09:02.97,Default,,0,0,0,,Уау! (Диктор) Жеңіс құдайы➡
Dialogue: 0,0:09:02.97,0:09:06.98,Default,,0,0,0,,Карасуноға бұрылыңыз! Карасуно кері қайтарылды!
Dialogue: 0,0:09:06.98,0:09:10.31,Default,,0,0,0,,≪Хината қабылдауынан үзіліс өткізіп алған кезде➡
Dialogue: 0,0:09:10.31,0:09:14.98,Default,,0,0,0,,Атмосфера өте ауыр болып көрінді, бірақ тайм-ауттан кейін ➡
Dialogue: 0,0:09:14.98,0:09:18.62,Default,,0,0,0,,Карасуно≫ бірдеңе дұрыс емес сияқты
Dialogue: 0,0:09:18.62,0:09:20.62,Default,,0,0,0,,Дыбыстық сигнал! ≪Жарайды≫
Dialogue: 0,0:09:20.62,0:09:23.19,Default,,0,0,0,,Инаризаки орта мектебі.
Dialogue: 0,0:09:23.19,0:09:25.19,Default,,0,0,0,,Қара!
Dialogue: 0,0:09:26.63,0:09:31.33,Default,,0,0,0,,≪Егер сіз мұны тамақтан кейін жасасаңыз, сізге осы 8 секунд ұнайды≫
Dialogue: 0,0:09:31.33,0:09:34.67,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:09:34.67,0:09:36.67,Default,,0,0,0,,Қарғыс атсын... (Савамура) Қап!
Dialogue: 0,0:09:36.67,0:09:38.67,Default,,0,0,0,,Кагеяма Соңғы!
Dialogue: 0,0:09:40.14,0:09:42.51,Default,,0,0,0,,Сіз орнатушыны көздедіңіз. (Оджиро) Осаму!
Dialogue: 0,0:09:42.51,0:09:44.51,Default,,0,0,0,,Әй, бұл тағы да.
Dialogue: 0,0:09:44.51,0:09:47.68,Default,,0,0,0,,≪Жоқ, мұндай тұрақсыз асығыстық➡
Dialogue: 0,0:09:47.68,0:09:51.22,Default,,0,0,0,,Мен оны бұл жерде қайта қолданамын деп ойламаймын≫
Dialogue: 0,0:09:51.22,0:09:54.36,Default,,0,0,0,,≪Мына жігіттер жасайды≫
Dialogue: 0,0:09:54.36,0:09:57.39,Default,,0,0,0,,≪Сендер де солай ойлайсыңдар, солай ма? ≫
Dialogue: 0,0:09:57.39,0:09:59.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:01.23,0:10:04.40,Default,,0,0,0,,≪1,5 блок≫
Dialogue: 0,0:10:04.40,0:10:07.24,Default,,0,0,0,,Дыбыстық сигнал! Ха.
Dialogue: 0,0:10:07.24,0:10:10.37,Default,,0,0,0,,Инаризаки орта мектебі көзді ашып-жұмғанша көшбасшылыққа ие болды!
Dialogue: 0,0:10:10.37,0:10:12.84,Default,,0,0,0,,Уау! (Үлкен құлақ) Тағы біреуі!
Dialogue: 0,0:10:12.84,0:10:14.91,Default,,0,0,0,,Найский. Жаса, Сэм!
Dialogue: 0,0:10:14.91,0:10:16.95,Default,,0,0,0,,Жасайық? Алақай!
Dialogue: 0,0:10:16.95,0:10:19.25,Default,,0,0,0,,Карасуно блогы - Жарықтың Ю-кун➡
Dialogue: 0,0:10:19.25,0:10:21.98,Default,,0,0,0,,Бір сәт көңілің ауып кетті. Мен түсінемін.
Dialogue: 0,0:10:21.98,0:10:25.79,Default,,0,0,0,,Сіздің денеңіз ғана емес, миыңыз да шаршаған болуы керек.
Dialogue: 0,0:10:27.06,0:10:29.76,Default,,0,0,0,,≪Ах~ Мен қант≫ алғым келеді
Dialogue: 0,0:10:29.76,0:10:31.76,Default,,0,0,0,,Қара!
Dialogue: 0,0:10:36.76,0:10:38.77,Default,,0,0,0,,Танака мырза! (Савамура) 3 блок!
Dialogue: 0,0:10:40.67,0:10:43.74,Default,,0,0,0,,Дыбыстық сигнал! Жақсы кілт.
Dialogue: 0,0:10:43.74,0:10:46.57,Default,,0,0,0,,Жақсы, жақсы, жақсы! Мен оны жақсы ұрдым!
Dialogue: 0,0:10:46.57,0:10:49.21,Default,,0,0,0,,Керемет кілт!
Dialogue: 0,0:10:49.21,0:10:51.21,Default,,0,0,0,,О! (Нишитани) Эй!
Dialogue: 0,0:10:51.21,0:10:54.72,Default,,0,0,0,,≪Себебі Цукишима мен Хинатаның әлі де әлсіз сервистері бар➡
Dialogue: 0,0:10:54.72,0:10:58.19,Default,,0,0,0,,Бұл ұпай жоғалтуға көмектесетін жатқа ойын. ➡
Dialogue: 0,0:10:58.19,0:11:00.79,Default,,0,0,0,,Бірақ мен осы жерден шығып кетсем екен...≫
Dialogue: 0,0:11:00.79,0:11:03.19,Default,,0,0,0,,Қара!
Dialogue: 0,0:11:03.19,0:11:05.16,Default,,0,0,0,,Алан! (Оджиро) Жарайды!
Dialogue: 0,0:11:07.20,0:11:11.10,Default,,0,0,0,,≪Түрту... Түрту Touch Touch Touch Touch Touch≫
Dialogue: 0,0:11:11.10,0:11:13.10,Default,,0,0,0,,Ах. (Хината/Кагеяма) Жақсы...
Dialogue: 0,0:11:13.10,0:11:15.10,Default,,0,0,0,,Дыбыстық сигнал! (Диктор) Мұнда➡
Dialogue: 0,0:11:15.10,0:11:17.47,Default,,0,0,0,,Дыбыс үнсіз болды!
Dialogue: 0,0:11:17.47,0:11:19.61,Default,,0,0,0,,Жарайсыңдар! Нан Нан!
Dialogue: 0,0:11:19.61,0:11:22.44,Default,,0,0,0,,Иә, ауыстырыңыз! Қайғыға салыну уақытты босқа өткізу.
Dialogue: 0,0:11:22.44,0:11:24.45,Default,,0,0,0,,Жоқ... Қараңдар!
Dialogue: 0,0:11:24.45,0:11:27.42,Default,,0,0,0,,Кита Инаризаки авангардқа ауысқанда➡
Dialogue: 0,0:11:27.42,0:11:29.72,Default,,0,0,0,,Гиндзиманы сотқа қайтарыңыз. (Солтүстік) Нейссер.
Dialogue: 0,0:11:29.72,0:11:33.05,Default,,0,0,0,,Қап! Қара!
Dialogue: 0,0:11:33.05,0:11:43.13,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:11:43.13,0:11:45.13,Default,,0,0,0,,Дыбыстық сигнал! Эй!
Dialogue: 0,0:11:45.13,0:11:49.60,Default,,0,0,0,,Тікелей қатыгез қызмет көрсетуден! ➡
Dialogue: 0,0:11:49.60,0:11:52.61,Default,,0,0,0,,Инаризаки орта мектебі жеңіске жетті!
Dialogue: 0,0:11:52.61,0:11:55.51,Default,,0,0,0,,Керемет қорытынды!
Dialogue: 0,0:11:55.51,0:12:00.48,Default,,0,0,0,,Керемет қорытынды! Секір, секір, Юи! Тағы біреуі!
Dialogue: 0,0:12:02.82,0:12:04.82,Default,,0,0,0,,Мен тынышталамын. (Танака) Мынау!
Dialogue: 0,0:12:04.82,0:12:07.29,Default,,0,0,0,,Концентрация концентрациясы!
Dialogue: 0,0:12:07.29,0:12:09.36,Default,,0,0,0,,Ақымақ болма. жалғастыра бер! ➡
Dialogue: 0,0:12:09.36,0:12:12.46,Default,,0,0,0,,Шаршағаныңыз маңызды емес. ➡
Dialogue: 0,0:12:12.46,0:12:15.30,Default,,0,0,0,,Қарсыластың күші де маңызды емес. ➡
Dialogue: 0,0:12:15.30,0:12:19.67,Default,,0,0,0,,Мен сіздің қатты жұмыс істеп жатқаныңызды білмедім. ➡
Dialogue: 0,0:12:19.67,0:12:21.67,Default,,0,0,0,,Көбірек тырысыңыз!
Dialogue: 0,0:12:21.67,0:12:31.51,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:12:31.51,0:12:33.51,Default,,0,0,0,,≪Бұл...➡
Dialogue: 0,0:12:33.51,0:12:37.02,Default,,0,0,0,,Ол жаман адам. Біртүрлі сезіледі. ➡
Dialogue: 0,0:12:37.02,0:12:39.69,Default,,0,0,0,,Мен қазір өзімді жақсы сезінетін шығармын. ➡
Dialogue: 0,0:12:39.69,0:12:42.62,Default,,0,0,0,,Мен блоктарды әдеттегіден көбірек көретін сияқтымын. ➡
Dialogue: 0,0:12:42.62,0:12:44.63,Default,,0,0,0,,Сондықтан...➡
Dialogue: 0,0:12:44.63,0:12:48.10,Default,,0,0,0,,Менің интуициям бұдан да күштірек болмау керектігін айтады≫
Dialogue: 0,0:12:50.70,0:13:00.91,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:13:00.91,0:13:10.12,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:13:11.65,0:13:13.66,Default,,0,0,0,,()
Dialogue: 0,0:13:13.66,0:13:15.66,Default,,0,0,0,,Қара!
Dialogue: 0,0:13:19.06,0:13:22.06,Default,,0,0,0,,Мұқаба! Танака-сан!
Dialogue: 0,0:13:22.06,0:13:25.67,Default,,0,0,0,,Қарғыс атсын! Алақай! (Үлкен құлақ) Хмм!
Dialogue: 0,0:13:25.67,0:13:27.64,Default,,0,0,0,,<Алғыс білдіретін Батыр болу үшін ➡
Dialogue: 0,0:13:32.71,0:13:35.68,Default,,0,0,0,,Қарғыс атсын! Ах...
Dialogue: 0,0:13:35.68,0:13:37.68,Default,,0,0,0,,Кагеяма!
Dialogue: 0,0:13:37.68,0:13:42.08,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:13:42.08,0:13:44.09,Default,,0,0,0,,Сол жерден, асығыңыз, Карасуно! ➡
Dialogue: 0,0:13:44.09,0:13:47.59,Default,,0,0,0,,Бірақ Одзиро көтерілді. Ол қосыла ма?
Dialogue: 0,0:13:47.59,0:13:49.96,Default,,0,0,0,,>
Dialogue: 0,0:13:52.06,0:13:54.23,Default,,0,0,0,,Қорқынышты! (Такинуэ/Шимада) Ах!
Dialogue: 0,0:13:56.60,0:13:58.77,Default,,0,0,0,,Екі мектептен де жоғары деңгейлі орта мектеп оқушылары➡
Dialogue: 0,0:13:58.77,0:14:01.14,Default,,0,0,0,,Екі ойыншы да жоғары деңгейлі алаңдарды жеткізеді!
Dialogue: 0,0:14:03.37,0:14:05.34,Default,,0,0,0,,() ((Е...))
Dialogue: 0,0:14:07.08,0:14:09.24,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:14:11.91,0:14:15.95,Default,,0,0,0,,>
Dialogue: 0,0:14:15.95,0:14:17.95,Default,,0,0,0,,Кагеяма!
Dialogue: 0,0:14:17.95,0:14:21.82,Default,,0,0,0,,((Басқалардың сезімін түсінбеу қалыпты жағдай.➡
Dialogue: 0,0:14:21.82,0:14:26.93,Default,,0,0,0,,Матчтың жағдайын және ойыншылардың жағдайын түсіну))
Dialogue: 0,0:14:26.93,0:14:29.80,Default,,0,0,0,,≪Бірінші жиын аяқталғаннан кейін Танака мырзаның жағдайы қалай➡
Dialogue: 0,0:14:29.80,0:14:32.60,Default,,0,0,0,,Әрине жаман емес. Осы уақытқа дейін➡
Dialogue: 0,0:14:32.60,0:14:35.47,Default,,0,0,0,,Ол заттарды күшпен лақтырғалы жатқанда да сабырлы➡
Dialogue: 0,0:14:35.47,0:14:37.47,Default,,0,0,0,,Супер крест керемет≫
Dialogue: 0,0:14:38.87,0:14:41.41,Default,,0,0,0,,≪Бірақ Танака мырзаның ең үлкен қаруы➡
Dialogue: 0,0:14:41.41,0:14:43.44,Default,,0,0,0,,Шынымен солай ма? ≫
Dialogue: 0,0:14:43.44,0:14:47.32,Default,,0,0,0,,((Менің жігіттерім бәрі күшті))
Dialogue: 0,0:14:47.32,0:14:51.92,Default,,0,0,0,,≪Жоқ, бұл менің шешімім емес≫
Dialogue: 0,0:14:53.79,0:14:56.79,Default,,0,0,0,,≪Үздіксіз жалғаулық шабуылдар➡
Dialogue: 0,0:14:56.79,0:14:59.96,Default,,0,0,0,,Ойыннан кейінгі ұзақ ралли➡
Dialogue: 0,0:14:59.96,0:15:02.33,Default,,0,0,0,,Тәртіпсіз қабылдауға байланысты ➡
Dialogue: 0,0:15:02.33,0:15:06.13,Default,,0,0,0,,Қысқа да, ұзын да, жақын да, алыс те емес➡
Dialogue: 0,0:15:06.13,0:15:09.27,Default,,0,0,0,,Антеннаға дейін созылатын әдемі лақтыру≫
Dialogue: 0,0:15:09.27,0:15:12.87,Default,,0,0,0,,≪Әреңірек, кеңірек➡
Dialogue: 0,0:15:12.87,0:15:15.78,Default,,0,0,0,,Спайкерлерге арналған таңдаулар≫
Dialogue: 0,0:15:17.35,0:15:20.18,Default,,0,0,0,,≪Супер ішкі➡ көрсетілгеннен кейін
Dialogue: 0,0:15:20.18,0:15:23.95,Default,,0,0,0,,Бірақ блок міндетті түрде крестпен тартылды≫
Dialogue: 0,0:15:25.52,0:15:29.56,Default,,0,0,0,,≪Танака ашқан тағы бір жол≫
Dialogue: 0,0:15:29.56,0:15:32.69,Default,,0,0,0,,≪Бұл ынталандыру емес. ➡
Dialogue: 0,0:15:32.69,0:15:37.53,Default,,0,0,0,,Осы «қауіпке» жауап беріңіз! ≫
Dialogue: 0,0:15:37.53,0:15:40.64,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:40.64,0:15:42.67,Default,,0,0,0,,Бассейн! О, жоқ!
Dialogue: 0,0:15:42.67,0:15:46.17,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:46.17,0:15:48.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:48.18,0:15:50.68,Default,,0,0,0,,≪Тамаша сызықтық түсірілім≫
Dialogue: 0,0:15:50.68,0:15:55.85,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:55.85,0:15:58.22,Default,,0,0,0,,Дабыл! (Барлығы) Уау!
Dialogue: 0,0:15:58.22,0:16:00.89,Default,,0,0,0,,Міне, тым қауіпті тікелей ату!
Dialogue: 0,0:16:00.89,0:16:02.89,Default,,0,0,0,,Дараша~! (Барлығы) Уау!
Dialogue: 0,0:16:02.89,0:16:06.26,Default,,0,0,0,,Рюносуке Танака тамаша шешім қабылдады!
Dialogue: 0,0:16:06.26,0:16:09.00,Default,,0,0,0,,Бұл өте тура! ➡
Dialogue: 0,0:16:09.00,0:16:11.90,Default,,0,0,0,,Дененің бағытына байланысты тағы да крест деп ойладым.
Dialogue: 0,0:16:11.90,0:16:14.54,Default,,0,0,0,,Керемет Танака! (Нишитани) Керемет Рю! ➡
Dialogue: 0,0:16:14.54,0:16:17.04,Default,,0,0,0,,Жаса, Рю! Танака-сан!
Dialogue: 0,0:16:17.04,0:16:26.38,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:16:26.38,0:16:29.88,Default,,0,0,0,,Наистос. Жақсы кілт.
Dialogue: 0,0:16:29.88,0:16:32.05,Default,,0,0,0,,≪Бұл жігіт...➡
Dialogue: 0,0:16:32.05,0:16:35.72,Default,,0,0,0,,Мына жігіттің «Орико-саны» қайда кетті? ≫
Dialogue: 0,0:16:35.72,0:16:39.19,Default,,0,0,0,,<<Осы қысқа уақыт ішінде не болды? ≫
Dialogue: 0,0:16:39.19,0:16:42.26,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:42.26,0:16:45.20,Default,,0,0,0,,Карасуно орта мектебі Рюносуке Танака➡
Dialogue: 0,0:16:45.20,0:16:48.60,Default,,0,0,0,,Бұл Инаризаки Йоши атмосферасын кесіп тастайды!
Dialogue: 0,0:16:48.60,0:16:50.61,Default,,0,0,0,,Уақыты келді…
Dialogue: 0,0:16:50.61,0:16:54.61,Default,,0,0,0,,Уау!! (Ма-кун) А?
Dialogue: 0,0:16:54.61,0:16:57.98,Default,,0,0,0,,♬ Хехехехехехехехехехехехехехехэ
Dialogue: 0,0:16:57.98,0:17:01.05,Default,,0,0,0,,Біртүрлі адам. Ма-кун!
Dialogue: 0,0:17:01.05,0:17:03.12,Default,,0,0,0,,Ммм!
Dialogue: 0,0:17:04.65,0:17:09.66,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:19:13.28,0:19:16.88,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:19:19.02,0:19:21.02,Default,,0,0,0,,Карасуно жылдамдығын төмендетпейді➡
Dialogue: 0,0:19:21.02,0:19:24.03,Default,,0,0,0,,Still Inarizaki сәйкестік нүктесі. ➡
Dialogue: 0,0:19:24.03,0:19:27.56,Default,,0,0,0,,Мен мұнда қателессем де, тәтті доп лақтырсам да➡
Dialogue: 0,0:19:27.56,0:19:30.43,Default,,0,0,0,,Бізді жеңіліс күтіп тұр.
Dialogue: 0,0:19:30.43,0:19:32.90,Default,,0,0,0,,Қара!
Dialogue: 0,0:19:32.90,0:19:35.77,Default,,0,0,0,,≪Мен қорғаудың қажеті жоқ екенін білемін≫
Dialogue: 0,0:19:35.77,0:19:38.77,Default,,0,0,0,,≪Бірақ мен қорғағым келетін басымның артқы жағы≫
Dialogue: 0,0:19:38.77,0:19:46.81,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:19:46.81,0:19:49.28,Default,,0,0,0,,Мынау не деген жігіт!
Dialogue: 0,0:19:49.28,0:19:51.95,Default,,0,0,0,,Ах! Бип!
Dialogue: 0,0:19:51.95,0:19:55.79,Default,,0,0,0,,Қандай күшті жүрек! Қандай шоғырлану! ➡
Dialogue: 0,0:19:55.79,0:19:59.43,Default,,0,0,0,,Есепті теңестіретін толыққанды қызмет көрсетуші➡
Dialogue: 0,0:19:59.43,0:20:03.96,Default,,0,0,0,,Тобио Кагеяма! Шаа.
Dialogue: 0,0:20:03.96,0:20:06.87,Default,,0,0,0,,Мен ғажаптан асып, ашуландым.
Dialogue: 0,0:20:06.87,0:20:08.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:08.87,0:20:12.91,Default,,0,0,0,,Қараңдар! (3 адам) Келіңіздер!
Dialogue: 0,0:20:12.91,0:20:17.24,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:20:17.24,0:20:19.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:19.25,0:20:22.25,Default,,0,0,0,,≪Бұл жігіт шынымен де бүгін! ≫
Dialogue: 0,0:20:22.25,0:20:25.32,Default,,0,0,0,,Бұрын! (Диктор) Соңғы минут, соңғы минут ➡
Dialogue: 0,0:20:25.32,0:20:27.99,Default,,0,0,0,,Өзін-өзі дайындап жатқан қабылдаушының ойын оқығандай➡
Dialogue: 0,0:20:27.99,0:20:29.99,Default,,0,0,0,,Кагеяма алға қарай құлады!
Dialogue: 0,0:20:29.99,0:20:32.03,Default,,0,0,0,,Мүмкіндік добы!
Dialogue: 0,0:20:32.03,0:20:35.80,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:20:35.80,0:20:38.13,Default,,0,0,0,,Дыбыстық сигнал! (Диктор) Ммм~ Ортадан➡
Dialogue: 0,0:20:38.13,0:20:42.00,Default,,0,0,0,,Негізгі отбасы найзағай жылдамдығымен шешілді! Шаа~!
Dialogue: 0,0:20:42.00,0:20:44.77,Default,,0,0,0,,Қарсыласыңыздың бір сәттік серпілісін жіберіп алмаңыз➡
Dialogue: 0,0:20:44.77,0:20:46.77,Default,,0,0,0,,Бұл ортадағы ең жылдам.
Dialogue: 0,0:20:46.77,0:20:49.14,Default,,0,0,0,,Карасуно бұл жолы бақылауда!
Dialogue: 0,0:20:52.18,0:20:54.18,Default,,0,0,0,,Қара!
Dialogue: 0,0:20:54.18,0:21:01.99,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:21:01.99,0:21:03.99,Default,,0,0,0,,Керемет қабыл алыңыздар!
Dialogue: 0,0:21:03.99,0:21:06.53,Default,,0,0,0,,≪Сен шабуыл жасап, қорғай алсаң ғана эйс бола аласың≫
Dialogue: 0,0:21:06.53,0:21:12.37,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:21:12.37,0:21:17.04,Default,,0,0,0,,Дыбыстық сигнал! Еш ойланбастан шешкенім сол жақтан Гинжима!
Dialogue: 0,0:21:17.04,0:21:19.94,Default,,0,0,0,,Меніңше, сіздің әбден шаршайтын кез келді.➡
Dialogue: 0,0:21:19.94,0:21:21.94,Default,,0,0,0,,Блоктың ештеңе оқуына жол бермеңіз➡
Dialogue: 0,0:21:21.94,0:21:25.81,Default,,0,0,0,,Бұл керемет әдемі жағдай болды.
Dialogue: 0,0:21:25.81,0:21:28.82,Default,,0,0,0,,Осы соңғы кезең келсе де, хаос ➡ болмайды
Dialogue: 0,0:21:28.82,0:21:31.82,Default,,0,0,0,,Сіз басқа адамның не ойлайтынын білетін сияқтысыз➡
Dialogue: 0,0:21:31.82,0:21:33.82,Default,,0,0,0,,Ю жинағы.
Dialogue: 0,0:21:33.82,0:21:37.73,Default,,0,0,0,,Данышпан. Дәл сол позиция қатал.
Dialogue: 0,0:21:37.73,0:21:40.49,Default,,0,0,0,,Кагеяманың қызметі де қорқынышты. ➡
Dialogue: 0,0:21:40.49,0:21:43.10,Default,,0,0,0,,Маған да талант керек.
Dialogue: 0,0:21:43.10,0:21:45.57,Default,,0,0,0,,Бірде мен оны қашан жасадым деп сұрады.
Dialogue: 0,0:21:45.57,0:21:49.40,Default,,0,0,0,,Қараңдар! (Кита) «Мен қарапайым емеспін➡
Dialogue: 0,0:21:49.40,0:21:51.41,Default,,0,0,0,,Менің кішілерімнің арасында бір данышпан бар➡
Dialogue: 0,0:21:51.41,0:21:54.88,Default,,0,0,0,,Сізге қиын болған кез болды ма? »
Dialogue: 0,0:21:54.88,0:21:57.65,Default,,0,0,0,,Мен бірінші кезекте данышпандық анықтамасын білмеймін➡
Dialogue: 0,0:21:57.65,0:22:00.75,Default,,0,0,0,,Мен сұрақтың мағынасын түсіндім. ➡
Dialogue: 0,0:22:00.75,0:22:03.55,Default,,0,0,0,,Юу сияқты жігіттер туралы➡
Dialogue: 0,0:22:03.55,0:22:06.69,Default,,0,0,0,,Еш себепсіз өзін басынан тамашамын деп есептейтін адамдар бар➡
Dialogue: 0,0:22:06.69,0:22:09.29,Default,,0,0,0,,Кейде. Бірақ...
Dialogue: 0,0:22:11.43,0:22:14.53,Default,,0,0,0,,Күн сайын 1-ден 10-ға дейін жасаймын➡
Dialogue: 0,0:22:14.53,0:22:18.60,Default,,0,0,0,,Юу сияқты адамдар 1-ден 20-ға дейін. ➡
Dialogue: 0,0:22:18.60,0:22:23.27,Default,,0,0,0,,Немесе тиімдірек 10 тығызырақ 10.
Dialogue: 0,0:22:23.27,0:22:26.94,Default,,0,0,0,,Кейде «1-ден 10-ға дейін»➡ деймін
Dialogue: 0,0:22:26.94,0:22:29.98,Default,,0,0,0,,А-дан Я-ға дейін тырыссаңыз, қандай болар едіңіз? ➡
Dialogue: 0,0:22:29.98,0:22:33.48,Default,,0,0,0,,Қызықты ма? Міне, осындай адамдар ойлайды, ➡
Dialogue: 0,0:22:34.95,0:22:39.95,Default,,0,0,0,,Мен сәтсіздікке ұшырасам да, басқалар мені жек көрсе де, менден аулақ болса да➡
Dialogue: 0,0:22:39.95,0:22:43.96,Default,,0,0,0,,Маңызды нәрсені істесек те елемей қалсақ та➡
Dialogue: 0,0:22:43.96,0:22:46.56,Default,,0,0,0,,Балалар, сендер көмектесе алмайсыңдар. ➡
Dialogue: 0,0:22:46.56,0:22:50.33,Default,,0,0,0,,Тамағынан қан кетсе де жүгіргісі келетін жігіт.
Dialogue: 0,0:22:50.33,0:22:53.33,Default,,0,0,0,,Қарғыс атсын! Onech!
Dialogue: 0,0:22:53.33,0:22:55.97,Default,,0,0,0,,Дүниені түкке тұрғысыз деп санайтын адамдар➡
Dialogue: 0,0:22:55.97,0:22:58.77,Default,,0,0,0,,Көбіне ұнайды➡
Dialogue: 0,0:22:58.77,0:23:02.14,Default,,0,0,0,,Менің ойымша, бұл таңқаларлық деп ойлаймын. ➡
Dialogue: 0,0:23:02.14,0:23:05.48,Default,,0,0,0,,Алға қарай жүгіре білу – талант деп ойлаймын➡
Dialogue: 0,0:23:05.48,0:23:09.25,Default,,0,0,0,,Оларды қалай атағаныңыз маңызды емес. ➡
Dialogue: 0,0:23:09.25,0:23:12.12,Default,,0,0,0,,«Данышпан» деген жаман сөз емес. ➡
Dialogue: 0,0:23:12.12,0:23:14.96,Default,,0,0,0,,Бірақ олар туралы➡
Dialogue: 0,0:23:14.96,0:23:17.66,Default,,0,0,0,,Сізді әу бастан-ақ керемет деп ойлауға не себеп болды➡
Dialogue: 0,0:23:17.66,0:23:20.10,Default,,0,0,0,,Жарыстың қажеті жоқ, мен жеңілемін!➡
Dialogue: 0,0:23:20.10,0:23:23.13,Default,,0,0,0,,Менің ойымша, бұл дөрекі.
Dialogue: 0,0:23:23.13,0:23:26.00,Default,,0,0,0,,Кешіріңіз, ұзақ болды! (Диктор) Мынаны да алыңыз Карасуно! ➡
Dialogue: 0,0:23:26.00,0:23:28.54,Default,,0,0,0,,Ұзын митинг, қыңыр митинг!
Dialogue: 0,0:23:28.54,0:23:33.71,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:23:33.71,0:23:38.18,Default,,0,0,0,,≪Бәрекелді... Небәрі 5 сантиметрдей жоғары≫
Dialogue: 0,0:23:38.18,0:23:41.02,Default,,0,0,0,,≪Көбірек секіру. Жеткізу! ≫
Dialogue: 0,0:23:41.02,0:23:44.62,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:23:44.62,0:23:46.62,Default,,0,0,0,,≪ Қарғыс атсын! ≫
Dialogue: 0,0:23:46.62,0:23:52.63,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:23:52.63,0:23:55.16,Default,,0,0,0,,Дыбыстық сигнал! (Диктор) Аяқтар! ➡
Dialogue: 0,0:23:55.16,0:23:58.53,Default,,0,0,0,,Шойо Хината Керемет тепе-теңдік пен сезім! ➡
Dialogue: 0,0:23:58.53,0:24:02.54,Default,,0,0,0,,Карасуно Инаризакидің тоқтау нүктесін әрең болдырды!
Dialogue: 0,0:24:02.54,0:24:07.01,Default,,0,0,0,,Жоқ, Хината-кун, сен әдетте доппен ойнайсың деп ойлаймын.
Dialogue: 0,0:24:07.01,0:24:09.78,Default,,0,0,0,,≪Бәрекелді, шаршамаңыз≫
Dialogue: 0,0:24:11.15,0:24:15.85,Default,,0,0,0,,Мен түсінбеймін, егер сіз зиянсыз деп отырсыз. Кешіріңіз, мен қатты ашуландым.
Dialogue: 0,0:24:15.85,0:24:21.89,Default,,0,0,0,,Жоқ, бұл жағдайда ештеңені білдірмейтін адам - жаман адам...
Dialogue: 0,0:24:21.89,0:24:24.49,Default,,0,0,0,,≪Бүгін менің психикалық бұлшықетім ауырады...≫
Dialogue: 0,0:24:26.73,0:24:29.20,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:24:29.20,0:24:32.93,Default,,0,0,0,,Шағымдану. Шағымдану? неге?
Dialogue: 0,0:24:32.93,0:24:35.54,Default,,0,0,0,,Хехе. Маған келесісін беріңіз!
Dialogue: 0,0:24:38.57,0:24:43.28,Default,,0,0,0,,>
Dialogue: 0,0:24:43.28,0:24:47.61,Default,,0,0,0,,≪Бірақ өзін шектен шығаратын адам➡
Dialogue: 0,0:24:47.61,0:24:49.62,Default,,0,0,0,,Тек жаулар емес≫
Dialogue: 0,0:24:49.62,0:24:53.52,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:24:53.52,0:24:57.59,Default,,0,0,0,,≪Мен таң қалдым, Шойо≫
Dialogue: 0,0:24:59.13,0:25:02.10,Default,,0,0,0,,♬ Белгілі нәрсе бір күні болады
Dialogue: 0,0:25:02.10,0:25:05.10,Default,,0,0,0,,♬ Түсінетін уақыт келеді
Dialogue: 0,0:25:05.10,0:25:07.10,Default,,0,0,0,,♬ Қателескен дұрыс
Dialogue: 0,0:25:07.10,0:25:12.04,Default,,0,0,0,,♬ Енді ойлануды тоқтатпа
Dialogue: 0,0:25:12.04,0:25:22.58,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:25:22.58,0:25:27.55,Default,,0,0,0,,♬ Мен шындықты ұшыратын арманды қаладым
Dialogue: 0,0:25:28.99,0:25:31.83,Default,,0,0,0,,♬ Тек мағынасы бар
Dialogue: 0,0:25:31.83,0:25:35.00,Default,,0,0,0,,♬ Күндер жайбарақат
Dialogue: 0,0:25:35.00,0:25:38.27,Default,,0,0,0,,♬ Қорқатын ештеңе жоқ
Dialogue: 0,0:25:38.27,0:25:40.80,Default,,0,0,0,,♬ Жаңа ғана мықты болып келе жатқан бала
Dialogue: 0,0:25:40.80,0:25:44.97,Default,,0,0,0,,♬ Менің арқам әлі тершіл
Dialogue: 0,0:25:44.97,0:25:47.27,Default,,0,0,0,,♬ Себебі мен саған қарап тұрмын
Dialogue: 0,0:25:47.27,0:25:51.41,Default,,0,0,0,,♬ Енді маған ғажайыптардың керегі жоқ
Dialogue: 0,0:25:51.41,0:25:55.65,Default,,0,0,0,,♬ Біз кез келген жерге бара аламыз
Dialogue: 0,0:25:55.65,0:25:58.35,Default,,0,0,0,,♬ Бір күні армандар орындалады
Dialogue: 0,0:25:58.35,0:26:01.46,Default,,0,0,0,,♬ Біз осы уақытқа дейін не істедік
Dialogue: 0,0:26:01.46,0:26:05.09,Default,,0,0,0,,♬ Бұл кездейсоқтық емес
Dialogue: 0,0:26:05.09,0:26:07.59,Default,,0,0,0,,♬ сахнаға шығу
Dialogue: 0,0:26:07.59,0:26:10.16,Default,,0,0,0,,♬ Тұрғым келген кезде
Dialogue: 0,0:26:10.16,0:26:13.30,Default,,0,0,0,,♬ Мен қатты тілек тілеп жүрдім
Dialogue: 0,0:26:13.30,0:26:17.00,Default,,0,0,0,,♬ Себебі сіз сонда болдыңыз
Dialogue: 0,0:26:17.00,0:26:26.01,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:26:27.51,0:26:32.51,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
