Dialogue: 0,0:09:49.36,0:09:50.16,Default,,0,0,0,,Иә
Dialogue: 0,0:09:50.53,0:09:51.76,Default,,0,0,0,,Үздіксіз қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:09:53.93,0:09:54.73,Default,,0,0,0,,Қажет емес
Dialogue: 0,0:09:55.10,0:09:56.36,Default,,0,0,0,,Мен жаңа ғана сіріңке сатып алдым.
Dialogue: 0,0:09:56.50,0:09:57.66,Default,,0,0,0,,Олардың саны мыңдаған.
Dialogue: 0,0:10:35.53,0:10:36.36,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:36.53,0:10:38.36,Default,,0,0,0,,Бүгін менің басым айналады.
Dialogue: 0,0:10:38.50,0:10:39.96,Default,,0,0,0,,Мен оны келесі жолы қайтадан сатып аламын.
Dialogue: 0,0:10:52.23,0:10:53.16,Default,,0,0,0,,Кешкі астан кейін
Dialogue: 0,0:10:53.16,0:10:54.59,Default,,0,0,0,,Бүгін қайырлы түн
Dialogue: 0,0:10:55.13,0:10:56.29,Default,,0,0,0,,Сіз суық тиіп қаласыз.
Dialogue: 0,0:10:56.96,0:10:58.86,Default,,0,0,0,,Ертең Жаңа жыл күні.
