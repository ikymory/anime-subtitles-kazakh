Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.63,0:00:16.64,Default,,0,0,0,,♪~
Dialogue: 0,0:01:34.55,0:01:39.55,Default,,0,0,0,,~♪
Dialogue: 0,0:01:43.81,0:01:47.02,Default,,0,0,0,,Мен жоғары көтерілгім келеді! Бұл дүниеде!
Dialogue: 0,0:01:55.36,0:01:56.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:56.36,0:01:58.28,Default,,0,0,0,,Бұл болмас еді...
Dialogue: 0,0:01:58.36,0:02:00.28,Default,,0,0,0,,(ішу дыбысы)
Dialogue: 0,0:02:00.37,0:02:01.99,Default,,0,0,0,,Хмм
Dialogue: 0,0:02:05.45,0:02:07.00,Default,,0,0,0,,Қалай
Dialogue: 0,0:02:07.08,0:02:09.04,Default,,0,0,0,,Не, не
Dialogue: 0,0:02:09.12,0:02:12.54,Default,,0,0,0,,Қандай күшті дене!
Dialogue: 0,0:02:12.63,0:02:15.30,Default,,0,0,0,,Нақты жауап емес
Dialogue: 0,0:02:16.46,0:02:19.55,Default,,0,0,0,,Құрыш сияқты.
Dialogue: 0,0:02:20.51,0:02:22.30,Default,,0,0,0,,Жүзі өтпейді
Dialogue: 0,0:02:22.39,0:02:25.81,Default,,0,0,0,,Мен оларды халатымда талай рет сойдым,
Dialogue: 0,0:02:26.39,0:02:30.31,Default,,0,0,0,,Алғаш рет балтыр сүйекті кеспедім.
Dialogue: 0,0:02:30.40,0:02:32.06,Default,,0,0,0,,(ішу дыбысы)
Dialogue: 0,0:02:32.98,0:02:35.07,Default,,0,0,0,,Қызықты және қызық
Dialogue: 0,0:02:37.90,0:02:40.66,Default,,0,0,0,,Оны нақты жоймай-ақ
Dialogue: 0,0:02:40.74,0:02:43.91,Default,,0,0,0,,Кеспейді, өтпейді, қимайды.
Dialogue: 0,0:02:44.95,0:02:47.58,Default,,0,0,0,,Қылыш сөз ойыны ма?
Dialogue: 0,0:02:48.91,0:02:50.08,Default,,0,0,0,,(әйнек сынған дыбыс)
Dialogue: 0,0:02:53.17,0:02:54.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:58.80,0:03:00.09,Default,,0,0,0,,Сен қол белгілері арқылы байланысасың.
Dialogue: 0,0:03:00.68,0:03:03.60,Default,,0,0,0,,Оны маған әкеліңіз. Мен қылыш алғым келеді.
Dialogue: 0,0:03:07.18,0:03:10.60,Default,,0,0,0,,Ммм, сен сондай мейірімді, күшті адамсың.
Dialogue: 0,0:03:13.19,0:03:15.27,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:03:18.11,0:03:20.74,Default,,0,0,0,,Ұзақ уақыттан кейін үлкен және кіші
Dialogue: 0,0:03:21.32,0:03:23.32,Default,,0,0,0,,Жақсы сәйкес келеді
Dialogue: 0,0:03:23.82,0:03:25.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:32.50,0:03:33.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:36.09,0:03:37.75,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:03:37.84,0:03:39.26,Default,,0,0,0,,Керемет!
Dialogue: 0,0:03:39.34,0:03:41.01,Default,,0,0,0,,(Мицунаридің күшті тынысы)
Dialogue: 0,0:03:43.89,0:03:44.76,Default,,0,0,0,,Миямото
Dialogue: 0,0:03:46.26,0:03:47.51,Default,,0,0,0,,Диаграмманы орындамаңыз
Dialogue: 0,0:03:55.36,0:03:56.77,Default,,0,0,0,,О!
Dialogue: 0,0:04:09.12,0:04:10.16,Default,,0,0,0,,Сквирт!
Dialogue: 0,0:04:18.63,0:04:20.30,Default,,0,0,0,,Ах~
Dialogue: 0,0:04:20.38,0:04:22.22,Default,,0,0,0,,Не...
Dialogue: 0,0:04:22.30,0:04:26.30,Default,,0,0,0,,Соққысы есімде қалмастан арғы бетке кетіп бара жаттым.
Dialogue: 0,0:04:27.22,0:04:31.31,Default,,0,0,0,,Мұны қазіргі ұлы боксшылар үйреткен.
Dialogue: 0,0:04:32.27,0:04:36.31,Default,,0,0,0,,Өйткені қылыш жоқта өмір сүреміз, жеткен күйіміз
Dialogue: 0,0:04:37.15,0:04:39.82,Default,,0,0,0,,Жұдырық қылышқа жетеді
Dialogue: 0,0:04:40.61,0:04:41.57,Default,,0,0,0,,Ең үздік батыр болу үшін
Dialogue: 0,0:04:43.15,0:04:44.07,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,0:04:44.74,0:04:47.82,Default,,0,0,0,,Бұл Мұсашидің қылышы емес.
Dialogue: 0,0:04:48.41,0:04:49.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:49.66,0:04:51.91,Default,,0,0,0,,Мықты адамды жіберме
Dialogue: 0,0:04:53.91,0:04:54.91,Default,,0,0,0,,Хамф!
Dialogue: 0,0:04:58.79,0:05:00.00,Default,,0,0,0,,Жарайды, кел.
Dialogue: 0,0:05:00.09,0:05:01.84,Default,,0,0,0,,Пышақты ұстаңыз
Dialogue: 0,0:05:02.51,0:05:03.92,Default,,0,0,0,,Пайда болыңыз!
Dialogue: 0,0:05:04.01,0:05:09.60,Default,,0,0,0,,Оның түбінде... Оның түбірін ұстайтын адам – Миямото Мусаши!
Dialogue: 0,0:05:10.31,0:05:11.35,Default,,0,0,0,,О!
Dialogue: 0,0:05:11.43,0:05:13.10,Default,,0,0,0,,Сені махаббат сиқырымен баурап алатын боламын.
Dialogue: 0,0:05:16.19,0:05:17.10,Default,,0,0,0,,Қазір мен тұйықталдым!
Dialogue: 0,0:05:24.19,0:05:25.86,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:05:26.57,0:05:28.61,Default,,0,0,0,,(Күлкі)
Dialogue: 0,0:05:29.41,0:05:32.12,Default,,0,0,0,,Жомарт болудан бас тарту сезімі
Dialogue: 0,0:05:32.20,0:05:34.87,Default,,0,0,0,,Қазірдің өзінде Niten шыңы!
Dialogue: 0,0:05:35.46,0:05:36.62,Default,,0,0,0,,Джатаро өтірік айтпайды
Dialogue: 0,0:05:37.21,0:05:39.38,Default,,0,0,0,,Мұндай адамдар да бар.
Dialogue: 0,0:05:40.13,0:05:42.38,Default,,0,0,0,,Бұл ысырапшылдықтың уақыты емес.
Dialogue: 0,0:05:47.47,0:05:51.14,Default,,0,0,0,,Хмм... бұл бақыт...
Dialogue: 0,0:05:54.47,0:05:55.64,Default,,0,0,0,,Мен енді шыдай алмаймын!
Dialogue: 0,0:05:58.73,0:06:00.90,Default,,0,0,0,,Шабуылдар басталды
Dialogue: 0,0:06:01.48,0:06:03.15,Default,,0,0,0,,Алдыңғы бөлігін кесіп, оны ұсақтаңыз
Dialogue: 0,0:06:05.23,0:06:07.15,Default,,0,0,0,,«Жер бетіндегі ең күшті тіршілік иесі»
Dialogue: 0,0:06:07.24,0:06:09.24,Default,,0,0,0,,Тақырып …
Dialogue: 0,0:06:09.74,0:06:10.24,Default,,0,0,0,,... деп аталатын тәж.
Dialogue: 0,0:06:10.24,0:06:11.66,Default,,0,0,0,,... деп аталатын тәж.
Dialogue: 0,0:06:10.24,0:06:11.66,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:06:12.33,0:06:15.16,Default,,0,0,0,,Соңғы рет қашаннан бері жалтардыңыз?
Dialogue: 0,0:06:17.79,0:06:19.17,Default,,0,0,0,,Бұл тығыздық!
Dialogue: 0,0:06:19.79,0:06:22.67,Default,,0,0,0,,Осы тығыз Циді немен салыстыруға болады?
Dialogue: 0,0:06:22.75,0:06:23.46,Default,,0,0,0,,(үру)
Dialogue: 0,0:06:23.46,0:06:25.00,Default,,0,0,0,,(үру)
Dialogue: 0,0:06:23.46,0:06:25.00,Default,,0,0,0,,Бір-біріне қарама-қарсы аңдардың екі патшасы?
Dialogue: 0,0:06:25.00,0:06:26.17,Default,,0,0,0,,Бір-біріне қарама-қарсы тұрған аңдардың екі патшасы?
Dialogue: 0,0:06:26.26,0:06:26.80,Default,,0,0,0,,(Айдаһар мен жолбарыстың айқайы)
Dialogue: 0,0:06:26.80,0:06:28.93,Default,,0,0,0,,(Айдаһар мен жолбарыстың айқайы)
Dialogue: 0,0:06:26.80,0:06:28.93,Default,,0,0,0,,Рюко Аймаэру?
Dialogue: 0,0:06:29.01,0:06:31.43,Default,,0,0,0,,Жоқ, жоқ, жоқ!
Dialogue: 0,0:06:32.01,0:06:33.93,Default,,0,0,0,,Бұл аз болғандай!
Dialogue: 0,0:06:34.51,0:06:37.93,Default,,0,0,0,,Оларды басқа нәрсемен салыстырсаңыз да, бұл екі адам
Dialogue: 0,0:06:38.68,0:06:43.94,Default,,0,0,0,,Бұл дүниеде бір нәрсемен салыстыруға болатын ештеңе жоқ: күш.
Dialogue: 0,0:06:44.57,0:06:46.19,Default,,0,0,0,,Сіз ант бере аласыз
Dialogue: 0,0:06:46.28,0:06:49.70,Default,,0,0,0,,Арыстандар, айдаһарлар, жолбарыстар
Dialogue: 0,0:06:49.78,0:06:53.83,Default,,0,0,0,,Сіз бұл екі батырды ешқашан жеңе алмайсыз!
Dialogue: 0,0:06:53.91,0:06:56.83,Default,,0,0,0,,Әлсіздіктен дененің құлауы
Dialogue: 0,0:06:56.91,0:06:58.58,Default,,0,0,0,,Оның үдеуі
Dialogue: 0,0:06:59.46,0:07:01.58,Default,,0,0,0,,Өкшеден келетін күшпен
Dialogue: 0,0:07:02.29,0:07:04.71,Default,,0,0,0,,Жауға қарсы әрекет ету
Dialogue: 0,0:07:05.50,0:07:07.21,Default,,0,0,0,,Қашықтық жойылды
Dialogue: 0,0:07:07.96,0:07:11.09,Default,,0,0,0,,Қылыш жүзінің ұзындығын толық пайдалану
Dialogue: 0,0:07:12.34,0:07:14.22,Default,,0,0,0,,Оны маңызды нүктелеріңізге енгізіңіз...
Dialogue: 0,0:07:14.93,0:07:17.22,Default,,0,0,0,,Білу процесі...
Dialogue: 0,0:07:17.31,0:07:18.14,Default,,0,0,0,,(Қолды ұстау дыбысы)
Dialogue: 0,0:07:18.22,0:07:22.23,Default,,0,0,0,,Уақыт бойынша үтір 000… секунд
Dialogue: 0,0:07:22.31,0:07:24.23,Default,,0,0,0,,(Қатты қысу дыбысы)
Dialogue: 0,0:07:24.31,0:07:27.32,Default,,0,0,0,,Жақсы, жақсы дайындалған білек.
Dialogue: 0,0:07:28.57,0:07:29.99,Default,,0,0,0,,Арқаңа көтер мені
Dialogue: 0,0:07:33.70,0:07:35.58,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:07:36.45,0:07:37.95,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:07:45.33,0:07:46.13,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:07:46.13,0:07:48.34,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:07:46.13,0:07:48.34,Default,,0,0,0,,Есімнен танып қалғанымнан кейін де қылышты қолымнан шығармадым.
Dialogue: 0,0:07:48.34,0:07:50.01,Default,,0,0,0,,Есімнен танып қалған соң да қылышты қолымнан шығармадым.
Dialogue: 0,0:07:52.22,0:07:54.01,Default,,0,0,0,,Тіпті менен алыс
Dialogue: 0,0:07:52.22,0:07:54.01,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:07:55.05,0:07:57.01,Default,,0,0,0,,Байқалмаған ауырсыну
Dialogue: 0,0:07:57.89,0:08:00.02,Default,,0,0,0,,Тіпті ұрыс даласында да емес
Dialogue: 0,0:08:00.10,0:08:02.44,Default,,0,0,0,,(Мицунаридің дірілдеген тынысы)
Dialogue: 0,0:08:02.52,0:08:03.77,Default,,0,0,0,,Есеп айырысу!
Dialogue: 0,0:08:05.10,0:08:06.52,Default,,0,0,0,,Қарапайым айтқанда—
Dialogue: 0,0:08:08.11,0:08:08.65,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:08:08.65,0:08:10.53,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:08:08.65,0:08:10.53,Default,,0,0,0,,Азапта
Dialogue: 0,0:08:11.57,0:08:15.03,Default,,0,0,0,,Мұсашидің бойына өскен сезім
Dialogue: 0,0:08:15.11,0:08:16.53,Default,,0,0,0,,Әлі емес пе?
Dialogue: 0,0:08:17.20,0:08:18.53,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:08:19.29,0:08:23.54,Default,,0,0,0,,Хиго елінде аяқталуға жақын болған сол жұмбақ
Dialogue: 0,0:08:24.83,0:08:26.04,Default,,0,0,0,,Сен зорлыққа жанын сатқан адамсың деп сену қиын.
Dialogue: 0,0:08:26.67,0:08:28.34,Default,,0,0,0,,Мықты адам
Dialogue: 0,0:08:29.38,0:08:31.38,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:08:31.46,0:08:34.76,Default,,0,0,0,,Бұл адамды сен сынамасаң, кім көреді?
Dialogue: 0,0:08:36.05,0:08:39.60,Default,,0,0,0,,Кайшо гиосхоға көтеріледі
Dialogue: 0,0:08:40.10,0:08:41.93,Default,,0,0,0,,Соңында курсивті жазу
Dialogue: 0,0:08:42.64,0:08:46.44,Default,,0,0,0,,Олай болса қылышта курсив деген не?
Dialogue: 0,0:08:47.48,0:08:51.11,Default,,0,0,0,,Ал әрі қарай не болады?
Dialogue: 0,0:08:52.28,0:08:55.20,Default,,0,0,0,,(дірілдеп тыныс алу)
Dialogue: 0,0:08:57.28,0:08:59.20,Default,,0,0,0,,(Қатты қысу дыбысы)
Dialogue: 0,0:08:59.28,0:09:00.49,Default,,0,0,0,,Қарапайым айтқанда—
Dialogue: 0,0:09:00.99,0:09:02.70,Default,,0,0,0,,Жасы 58 жаста
Dialogue: 0,0:09:02.79,0:09:06.71,Default,,0,0,0,,Кәрілікке жетсе де, керемет көрінеді!
Dialogue: 0,0:09:07.42,0:09:11.21,Default,,0,0,0,,Өлшемдерді екі қол ұстағандай...
Dialogue: 0,0:09:12.42,0:09:14.97,Default,,0,0,0,,Мені кесіп тастайтын сияқты емес.
Dialogue: 0,0:09:15.63,0:09:17.72,Default,,0,0,0,,Сіз неден қорқасыз?
Dialogue: 0,0:09:17.80,0:09:19.22,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:19.80,0:09:20.72,Default,,0,0,0,,(Рам) Балс. (Субару) Ах…
Dialogue: 0,0:09:22.06,0:09:23.98,Default,,0,0,0,,Бізге тез сүңгуді үйретіңізші.
Dialogue: 0,0:09:24.06,0:09:25.48,Default,,0,0,0,,О!
Dialogue: 0,0:09:26.56,0:09:27.73,Default,,0,0,0,,- (Мұсаши) Заку - (А шәкірт) Ух...
Dialogue: 0,0:09:27.81,0:09:29.48,Default,,0,0,0,,- (Мусаши) Заку Заку - (А шәкірт) Уф...
Dialogue: 0,0:09:29.56,0:09:32.73,Default,,0,0,0,,- (Мусаши) Заку Зәку Зәку Заку - (А шәкірті) Уһ уһ уһ...
Dialogue: 0,0:09:33.36,0:09:34.49,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:35.32,0:09:36.24,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:38.57,0:09:39.82,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:41.45,0:09:42.49,Default,,0,0,0,,Бөлшектерге кесіңіз
Dialogue: 0,0:09:42.58,0:09:44.50,Default,,0,0,0,,Ух... ха... иә.
Dialogue: 0,0:09:44.58,0:09:47.25,Default,,0,0,0,,Жалғастыру
Dialogue: 0,0:09:47.33,0:09:49.75,Default,,0,0,0,,
Dialogue: 0,0:09:50.50,0:09:51.88,Default,,0,0,0,,Жабу
Dialogue: 0,0:09:53.71,0:09:55.63,Default,,0,0,0,,А... «жақын» ма?
Dialogue: 0,0:09:56.22,0:09:57.68,Default,,0,0,0,,Жұмбақ
Dialogue: 0,0:09:57.76,0:10:01.64,Default,,0,0,0,,Сенсэйдің қолында қылыш жыл сайын азайып барады.
Dialogue: 0,0:10:01.72,0:10:03.39,Default,,0,0,0,,Биылғы жылдың соңы
Dialogue: 0,0:10:03.47,0:10:06.64,Default,,0,0,0,,Бірақ мен биыл әлі алған жоқпын.
Dialogue: 0,0:10:09.85,0:10:13.65,Default,,0,0,0,,Курсивтен тыс
Dialogue: 0,0:10:14.69,0:10:17.03,Default,,0,0,0,,Қағазға үздіксіз жазу күндері
Dialogue: 0,0:10:17.99,0:10:20.03,Default,,0,0,0,,Жазу күндері
Dialogue: 0,0:10:20.62,0:10:24.04,Default,,0,0,0,,Ақырында сіз өз басыңызда жаза бастайсыз.
Dialogue: 0,0:10:24.91,0:10:27.04,Default,,0,0,0,,Оны өз ойларыңызға жазыңыз
Dialogue: 0,0:10:28.12,0:10:30.54,Default,,0,0,0,,Егер сіз қабырғаны ақырында көрсеңіз
Dialogue: 0,0:10:31.42,0:10:33.29,Default,,0,0,0,,Қабырғадағы жазуды ойлау
Dialogue: 0,0:10:34.25,0:10:35.80,Default,,0,0,0,,Егер сіз сарқырама көрсеңіз
Dialogue: 0,0:10:36.55,0:10:38.55,Default,,0,0,0,,Сарқырамадағы каллиграфияны ойлау
Dialogue: 0,0:10:38.63,0:10:41.55,Default,,0,0,0,,(Қатты желдің дыбысы)
Dialogue: 0,0:10:42.43,0:10:44.06,Default,,0,0,0,,Тіпті аспанға қарап
Dialogue: 0,0:10:44.85,0:10:47.18,Default,,0,0,0,,Қылқаламды аспанға апар
Dialogue: 0,0:10:48.48,0:10:50.81,Default,,0,0,0,,Осы күйге жетсеңіз
Dialogue: 0,0:10:51.73,0:10:54.32,Default,,0,0,0,,Қылқалам енді пайдалы емес
Dialogue: 0,0:10:55.11,0:10:56.32,Default,,0,0,0,,Дәл солай
Dialogue: 0,0:10:58.65,0:11:00.07,Default,,0,0,0,,Қылыш да
Dialogue: 0,0:11:02.95,0:11:05.12,Default,,0,0,0,,Ешбір қылышқа қол жеткізбеу!
Dialogue: 0,0:11:08.95,0:11:10.50,Default,,0,0,0,,Фамилиясы - Ханма
Dialogue: 0,0:11:11.21,0:11:13.00,Default,,0,0,0,,Аты - Юдзиро
Dialogue: 0,0:11:13.08,0:11:16.34,Default,,0,0,0,,«Жер бетіндегі ең күшті тіршілік иесі» деп аталады
Dialogue: 0,0:11:16.42,0:11:18.26,Default,,0,0,0,,Иә, солай сияқты.
Dialogue: 0,0:11:18.34,0:11:20.01,Default,,0,0,0,,(Мусашидің күшті дауысы)
Dialogue: 0,0:11:20.76,0:11:23.51,Default,,0,0,0,,Өте күшті, Юдзиро Ханма
Dialogue: 0,0:11:24.26,0:11:25.76,Default,,0,0,0,,Эй, маған қарашы.
Dialogue: 0,0:11:28.27,0:11:31.77,Default,,0,0,0,,Жамбасымды жоғары теуіп жіберген жара
Dialogue: 0,0:11:31.85,0:11:35.19,Default,,0,0,0,,Өсек айтқандай сен де мықты бол.
Dialogue: 0,0:11:35.27,0:11:37.53,Default,,0,0,0,,Жоқ, одан да көп.
Dialogue: 0,0:11:38.57,0:11:40.11,Default,,0,0,0,,Сыбыс?
Dialogue: 0,0:11:40.19,0:11:43.03,Default,,0,0,0,,400 жылдан бері айтылып келеді.
Dialogue: 0,0:11:43.70,0:11:45.78,Default,,0,0,0,,Маған мұндай нәрсе ұнайды.
Dialogue: 0,0:11:46.78,0:11:47.79,Default,,0,0,0,,Хиёри, бұл шынымен де түсініспеушілік
Dialogue: 0,0:11:48.37,0:11:50.79,Default,,0,0,0,,Бұл адам ең жоғарғы.
Dialogue: 0,0:11:50.87,0:11:53.12,Default,,0,0,0,,Дұрыс, Токугава.
Dialogue: 0,0:11:53.92,0:11:56.79,Default,,0,0,0,,Сіз айтқандай, Миямото-доно.
Dialogue: 0,0:11:57.42,0:12:03.30,Default,,0,0,0,,Менің алдымдағы адам – бұл дүниедегі күш-қуаттың шыңы.
Dialogue: 0,0:12:11.14,0:12:13.06,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:12:14.65,0:12:16.40,Default,,0,0,0,,Бір нәрсені қайтарыңыз
Dialogue: 0,0:12:17.94,0:12:19.57,Default,,0,0,0,,О... Мм...
Dialogue: 0,0:12:21.65,0:12:23.40,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:12:23.49,0:12:26.66,Default,,0,0,0,,Сіздің мансабыңыз туралы кеңестер басқа жақтан келеді.
Dialogue: 0,0:12:27.91,0:12:30.58,Default,,0,0,0,,Тышқан қалады, бірақ мен күресе аламын.
Dialogue: 0,0:12:34.00,0:12:34.83,Default,,0,0,0,,Қазір
Dialogue: 0,0:12:36.92,0:12:40.09,Default,,0,0,0,,Қылыш қолымды босатқанда рухым көтерілді.
Dialogue: 0,0:12:40.88,0:12:43.59,Default,,0,0,0,,Жоқ, мен сені жібермеймін
Dialogue: 0,0:12:46.68,0:12:48.85,Default,,0,0,0,,Үлкен де емес, кіші де емес
Dialogue: 0,0:12:48.93,0:12:51.85,Default,,0,0,0,,Менің Нитен-Ичи сыныбым ұстанған жол
Dialogue: 0,0:12:56.44,0:12:57.86,Default,,0,0,0,,ал үшінші және төртінші метакарпальды сүйектері мен саусақ сақина мен ортаңғы саусағымның проксимальды фалангаларында
Dialogue: 0,0:12:57.94,0:13:00.36,Default,,0,0,0,,Хмм... Мен бәрібір аламын!
Dialogue: 0,0:13:00.44,0:13:02.11,Default,,0,0,0,,Жақсы жұмыс
Dialogue: 0,0:13:02.69,0:13:04.86,Default,,0,0,0,,Жақсы қайнатылған
Dialogue: 0,0:13:05.49,0:13:08.62,Default,,0,0,0,,Нитен Ичирю аяқталғанға дейін түн!
Dialogue: 0,0:13:09.20,0:13:11.12,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:11.20,0:13:13.95,Default,,0,0,0,,Ақыры қылышсыз күйге жетесің.
Dialogue: 0,0:13:14.04,0:13:15.37,Default,,0,0,0,,Сонымен екі қылыш?
Dialogue: 0,0:13:16.46,0:13:17.88,Default,,0,0,0,,Хехе
Dialogue: 0,0:13:20.46,0:13:21.88,Default,,0,0,0,,Ой
Dialogue: 0,0:13:22.71,0:13:23.88,Default,,0,0,0,,Штаб!
Dialogue: 0,0:13:23.96,0:13:25.63,Default,,0,0,0,,- (Мицунари) Ах! - (Мұсаши) Сен кімсің?
Dialogue: 0,0:13:29.09,0:13:30.14,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,0:13:31.72,0:13:33.39,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:13:33.47,0:13:34.89,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:36.48,0:13:39.90,Default,,0,0,0,,Сіз бұл Ханманы қорғадыңыз!
Dialogue: 0,0:13:41.48,0:13:42.40,Default,,0,0,0,,Маюри үшін сол сәт келгенде қасында болғым келеді… яғни…
Dialogue: 0,0:13:42.48,0:13:45.15,Default,,0,0,0,,Бар болғаны, Ханма мырза.
Dialogue: 0,0:13:45.24,0:13:47.91,Default,,0,0,0,,Сіз менің жолыма кедергі келтіргіңіз келе ме?
Dialogue: 0,0:13:47.99,0:13:49.66,Default,,0,0,0,,Эй... эй, эй!
Dialogue: 0,0:13:49.74,0:13:52.16,Default,,0,0,0,,Сабыр ет, Юдзиро!
Dialogue: 0,0:13:52.24,0:13:54.41,Default,,0,0,0,,Кедергі болған – штаб!
Dialogue: 0,0:13:55.20,0:13:57.41,Default,,0,0,0,,Оның штаб-пәтері мынандай
Dialogue: 0,0:13:58.25,0:14:01.17,Default,,0,0,0,,Өкінішке орай, бұл...
Dialogue: 0,0:14:01.75,0:14:04.30,Default,,0,0,0,,Жарыс жоқ
Dialogue: 0,0:14:11.68,0:14:16.31,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:14:17.39,0:14:19.31,Default,,0,0,0,,Хмм... аа...
Dialogue: 0,0:14:23.90,0:14:24.82,Default,,0,0,0,,Эй
Dialogue: 0,0:14:24.90,0:14:26.15,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:27.40,0:14:29.82,Default,,0,0,0,,Осындай керемет іс жасағаныңыз үшін рахмет.
Dialogue: 0,0:14:29.91,0:14:31.45,Default,,0,0,0,,Екеуің ше?
Dialogue: 0,0:14:31.53,0:14:34.33,Default,,0,0,0,,Білмеймін, бір жерге кетіп қалды.
Dialogue: 0,0:14:36.29,0:14:37.87,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:38.37,0:14:40.83,Default,,0,0,0,,Ол бір қорқынышты нәрсе жасаған болуы керек.
Dialogue: 0,0:14:40.92,0:14:42.42,Default,,0,0,0,,Бірақ қарт
Dialogue: 0,0:14:42.50,0:14:45.09,Default,,0,0,0,,Егер мен ол жерде кедергі жасамасам
Dialogue: 0,0:14:45.17,0:14:47.72,Default,,0,0,0,,Ограны кесіп тастады.
Dialogue: 0,0:14:47.80,0:14:48.63,Default,,0,0,0,,Хмм
Dialogue: 0,0:14:48.72,0:14:50.22,Default,,0,0,0,,Өкінішке орай
Dialogue: 0,0:14:50.30,0:14:53.97,Default,,0,0,0,,Барлығыңыз, сіздің жекпе-жек туралы түсінігіңіз тым таяз.
Dialogue: 0,0:14:54.05,0:14:56.72,Default,,0,0,0,,Хм... Сонымен?
Dialogue: 0,0:14:57.47,0:15:00.48,Default,,0,0,0,,Сондықтан бұл менің штабым.
Dialogue: 0,0:15:00.56,0:15:02.23,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:15:03.11,0:15:05.23,Default,,0,0,0,,Мен шынымен түсінбеймін.
Dialogue: 0,0:15:05.32,0:15:06.48,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:15:07.32,0:15:08.74,Default,,0,0,0,,Уф… Мұнда не болып жатыр өзі?
Dialogue: 0,0:15:09.32,0:15:13.49,Default,,0,0,0,,Келесі матч Бұл штаб Мусашиді өлтіреді
Dialogue: 0,0:15:14.70,0:15:18.45,Default,,0,0,0,,Әсіресе көздің жауын алар емес
Dialogue: 0,0:15:19.08,0:15:23.75,Default,,0,0,0,,(Ауыр аяқ дыбысы)
Dialogue: 0,0:15:19.08,0:15:23.75,Default,,0,0,0,,Дегенмен, тұлғаның даралығы күшті болады.
Dialogue: 0,0:15:23.83,0:15:26.50,Default,,0,0,0,,Айналадан ерекшеленетіні анық
Dialogue: 0,0:15:26.59,0:15:29.21,Default,,0,0,0,,Сондықтан ол назар аударады
Dialogue: 0,0:15:29.30,0:15:31.59,Default,,0,0,0,,Сол екі адам бірге
Dialogue: 0,0:15:32.72,0:15:35.76,Default,,0,0,0,,Ханма мырза, сіз атақтысыз ба?
Dialogue: 0,0:15:36.51,0:15:38.52,Default,,0,0,0,,Барлығы қызықтырады
Dialogue: 0,0:15:39.22,0:15:41.81,Default,,0,0,0,,Алдынан келгендер бір қарады.
Dialogue: 0,0:15:41.89,0:15:44.27,Default,,0,0,0,,Бірінен-бірі өткен адамдар артына қарайды
Dialogue: 0,0:15:44.36,0:15:45.44,Default,,0,0,0,,Хун
Dialogue: 0,0:15:45.94,0:15:47.36,Default,,0,0,0,,Сіз де
Dialogue: 0,0:15:48.53,0:15:50.69,Default,,0,0,0,,Тым таңқаларлық
Dialogue: 0,0:15:52.82,0:15:54.28,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:54.91,0:15:57.58,Default,,0,0,0,,Корюю жауынгерлік өнері Мотобу Изо
Dialogue: 0,0:15:57.66,0:16:00.54,Default,,0,0,0,,«Мен Миямото Мусашимен кездескім келеді»
Dialogue: 0,0:16:00.62,0:16:04.04,Default,,0,0,0,,Аматсусае, мен әлгі шебер қылышшыны «кесемін».
Dialogue: 0,0:16:04.63,0:16:06.13,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:16:06.21,0:16:08.17,Default,,0,0,0,,Миямото Мусаши VS (Қарсы) Мотобу Изо
Dialogue: 0,0:16:08.17,0:16:09.55,Default,,0,0,0,,Миямото Мусаши VS (Қарсы) Мотобу Изо
Dialogue: 0,0:16:08.17,0:16:09.55,Default,,0,0,0,,(Сіріңкенің соғу дыбысы)
Dialogue: 0,0:16:10.17,0:16:12.30,Default,,0,0,0,,солай емес пе?
Dialogue: 0,0:16:12.38,0:16:15.30,Default,,0,0,0,,Жақсы пропорционалды
Dialogue: 0,0:16:15.39,0:16:16.60,Default,,0,0,0,,Хмм
Dialogue: 0,0:16:16.68,0:16:17.93,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:16:20.18,0:16:21.81,Default,,0,0,0,,Маған бәрібір...
Dialogue: 0,0:16:21.89,0:16:23.81,Default,,0,0,0,,- (Штаб) Өтірік айтасың! -(Мицунари) А?
Dialogue: 0,0:16:23.89,0:16:26.73,Default,,0,0,0,,«Штаб не дейді?»
Dialogue: 0,0:16:26.81,0:16:28.61,Default,,0,0,0,,«Өз бойыңды біл»
Dialogue: 0,0:16:29.27,0:16:31.49,Default,,0,0,0,,Менің айтқым келгені осы.
Dialogue: 0,0:16:31.57,0:16:33.95,Default,,0,0,0,,Жоқ, жақсы...
Dialogue: 0,0:16:34.03,0:16:36.07,Default,,0,0,0,,Кездескен дұрыс
Dialogue: 0,0:16:36.16,0:16:38.95,Default,,0,0,0,,Қарсылығы бар адаммен бірге көріңіз.
Dialogue: 0,0:16:39.03,0:16:42.00,Default,,0,0,0,,Бұл штабқа күш жетпейді десең,
Dialogue: 0,0:16:42.08,0:16:44.71,Default,,0,0,0,,Ол адам менімен бірге болуы керек.
Dialogue: 0,0:16:44.79,0:16:45.75,Default,,0,0,0,,Хмм?
Dialogue: 0,0:16:45.83,0:16:50.21,Default,,0,0,0,,Дегенмен, қару қолданудан басқаның барлығына рұқсат етілген.
Dialogue: 0,0:16:50.30,0:16:53.22,Default,,0,0,0,,Бұл оңай ереже емес.
Dialogue: 0,0:16:53.80,0:16:55.01,Default,,0,0,0,,Барлығын пайдаланыңыз
Dialogue: 0,0:16:55.09,0:16:58.72,Default,,0,0,0,,Алған білім, дағды және құралдар
Dialogue: 0,0:16:59.43,0:17:01.14,Default,,0,0,0,,Әрине қару техникасы
Dialogue: 0,0:17:01.22,0:17:03.73,Default,,0,0,0,,Снарядтардан жарылғыш заттарға дейін
Dialogue: 0,0:17:04.39,0:17:07.48,Default,,0,0,0,,Барлығын қолданғанда абай болыңыз!
Dialogue: 0,0:17:07.56,0:17:09.73,Default,,0,0,0,,«Ол осы уақытта болды»
Dialogue: 0,0:17:09.82,0:17:13.28,Default,,0,0,0,,''Ол осы уақытта болды'', кейінірек Мицунари мойындады.
Dialogue: 0,0:17:13.82,0:17:15.99,Default,,0,0,0,,Motobu Izo жақсы!
Dialogue: 0,0:17:16.07,0:17:18.49,Default,,0,0,0,,«Бар суы»
Dialogue: 0,0:17:19.95,0:17:20.99,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:21.08,0:17:23.62,Default,,0,0,0,,(аузында алкогольдің ағу дыбысы)
Dialogue: 0,0:17:23.70,0:17:25.50,Default,,0,0,0,,(Үру)
Dialogue: 0,0:17:25.58,0:17:27.00,Default,,0,0,0,,Бұл бүкіл оқиға әуесқойларға да тамаша әңгіме болады.
Dialogue: 0,0:17:27.08,0:17:28.92,Default,,0,0,0,,Виски
Dialogue: 0,0:17:30.50,0:17:32.76,Default,,0,0,0,,Хмм... Жоқ, ол сол жігіт.
Dialogue: 0,0:17:35.42,0:17:36.63,Default,,0,0,0,,Ол нағыз күрескер.
Dialogue: 0,0:17:37.26,0:17:39.85,Default,,0,0,0,,Хмм, солай.
Dialogue: 0,0:17:39.93,0:17:41.89,Default,,0,0,0,,Бұл дәмді.
Dialogue: 0,0:17:42.60,0:17:44.27,Default,,0,0,0,,Уа... ой
Dialogue: 0,0:17:44.85,0:17:47.02,Default,,0,0,0,,Гето туралы аңыз өтірік пе?
Dialogue: 0,0:17:47.10,0:17:48.27,Default,,0,0,0,,«Дема»?
Dialogue: 0,0:17:49.02,0:17:51.02,Default,,0,0,0,,Ол өте жақсы ішеді.
Dialogue: 0,0:17:51.11,0:17:54.53,Default,,0,0,0,,Егер біз басқа құралдарды таңдамасақ, онда сол штаб.
Dialogue: 0,0:17:56.57,0:17:59.87,Default,,0,0,0,,Тіпті мен осында кездескен кейбір адамдармен салыстырғанда.
Dialogue: 0,0:18:00.87,0:18:03.79,Default,,0,0,0,,Мм, менде көп нәрсе бар.
Dialogue: 0,0:18:08.71,0:18:10.04,Default,,0,0,0,,Мынау және анау
Dialogue: 0,0:18:10.88,0:18:12.80,Default,,0,0,0,,Шын мәнінде, біраз уақыт бұрын
Dialogue: 0,0:18:13.92,0:18:17.30,Default,,0,0,0,,Бір қысқа қылыш және бірнеше басқа түрлері
Dialogue: 0,0:18:17.93,0:18:21.80,Default,,0,0,0,,Бұл жасырын қару. Оны өз қолында қауіпсіз алып жүрді.
Dialogue: 0,0:18:23.64,0:18:25.06,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:25.72,0:18:27.18,Default,,0,0,0,,Марапатталады
Dialogue: 0,0:18:27.27,0:18:28.31,Default,,0,0,0,,күннен-күнге талғампаздықты меңгерген сайын,
Dialogue: 0,0:18:29.31,0:18:31.56,Default,,0,0,0,,Біртүрлі сюжеттік бұралу
Dialogue: 0,0:18:32.23,0:18:36.86,Default,,0,0,0,,Өзі игерген көптеген техника мен қару-жарақ.
Dialogue: 0,0:18:36.94,0:18:38.82,Default,,0,0,0,,Трагедиядан басқа ештеңе жоқ.
Dialogue: 0,0:18:39.40,0:18:44.20,Default,,0,0,0,,Қылыш пен найза мәдени құндылық ретінде танылғанымен,
Dialogue: 0,0:18:44.28,0:18:48.21,Default,,0,0,0,,Түтін бомбасы? ілмек арқан ілмек тізбегі
Dialogue: 0,0:18:48.91,0:18:52.13,Default,,0,0,0,,Шиноби техникасы құралдары мен қарулары
Dialogue: 0,0:18:52.21,0:18:54.21,Default,,0,0,0,,Сіз оны қай жерде қолданар едіңіз?
Dialogue: 0,0:18:55.09,0:18:58.13,Default,,0,0,0,,Сол дәуірдің өзінде оны пайдалану мүмкіндігі сирек.
Dialogue: 0,0:18:58.22,0:19:01.09,Default,,0,0,0,,Көрінбейтін технология туралы білім
Dialogue: 0,0:19:01.18,0:19:04.47,Default,,0,0,0,,Маған бәрін лақтыратын адам бар.
Dialogue: 0,0:19:04.56,0:19:06.60,Default,,0,0,0,,Менің алдымда қонды
Dialogue: 0,0:19:07.18,0:19:09.85,Default,,0,0,0,,Жасырылуы тиіс технология
Dialogue: 0,0:19:09.94,0:19:11.35,Default,,0,0,0,,Күннің жарығын қараңыз
Dialogue: 0,0:19:12.15,0:19:13.69,Default,,0,0,0,,Сізге рахмет
Dialogue: 0,0:19:15.48,0:19:16.61,Default,,0,0,0,,Хмм
Dialogue: 0,0:19:18.03,0:19:20.61,Default,,0,0,0,,Сіз өте мейірімдісіз.
Dialogue: 0,0:19:24.58,0:19:25.62,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:25.70,0:19:28.37,Default,,0,0,0,,Көптен бері көрмегелі, сэр.
Dialogue: 0,0:19:28.95,0:19:31.12,Default,,0,0,0,,Жылы сөздеріңізге рахмет.
Dialogue: 0,0:19:31.21,0:19:33.17,Default,,0,0,0,,Сіз мұны естідіңіз бе?
Dialogue: 0,0:19:33.25,0:19:36.13,Default,,0,0,0,,Иә, шатырда
Dialogue: 0,0:19:36.21,0:19:39.38,Default,,0,0,0,,Бұл сен бе, Гайя-кун?
Dialogue: 0,0:19:44.47,0:19:48.39,Default,,0,0,0,,Мен бұл дохжоға талай рет барсам да, мұнда келгенде...
Dialogue: 0,0:19:48.47,0:19:52.14,Default,,0,0,0,,Жүрегім баладай лүпілдейді.
Dialogue: 0,0:19:53.56,0:19:55.15,Default,,0,0,0,,Сізге қару ұнайды ма?
Dialogue: 0,0:19:55.23,0:19:57.82,Default,,0,0,0,,Олардың бәрі керемет.
Dialogue: 0,0:19:57.90,0:20:00.24,Default,,0,0,0,,Хаха «керемет»?
Dialogue: 0,0:20:00.32,0:20:01.65,Default,,0,0,0,,Қолдар керемет
Dialogue: 0,0:20:02.45,0:20:05.99,Default,,0,0,0,,Мақсатына қарай қалдықтар толығымен жойылады.
Dialogue: 0,0:20:06.07,0:20:08.66,Default,,0,0,0,,Қалған пішін қажеттіліктің өзі
Dialogue: 0,0:20:09.24,0:20:12.16,Default,,0,0,0,,Сұраныстың өзіне форма беретін нәрсе
Dialogue: 0,0:20:12.25,0:20:15.50,Default,,0,0,0,,Функцияның өзі форма
Dialogue: 0,0:20:15.58,0:20:17.42,Default,,0,0,0,,Сондықтан бұл өте жақсы
Dialogue: 0,0:20:17.50,0:20:21.17,Default,,0,0,0,,Мен бұл жерде қызықты екеніне сенімдімін.
Dialogue: 0,0:20:21.26,0:20:22.51,Default,,0,0,0,,Қарапайым айтқанда—
Dialogue: 0,0:20:22.59,0:20:24.68,Default,,0,0,0,,Бұл керемет, мұғалім.
Dialogue: 0,0:20:24.76,0:20:28.01,Default,,0,0,0,,Мен күнде баратын дохжоға қатты қуанамын.
Dialogue: 0,0:20:28.10,0:20:30.18,Default,,0,0,0,,Ондай адам жоқ.
Dialogue: 0,0:20:30.93,0:20:32.52,Default,,0,0,0,,Бұл данышпандық қасиеті.
Dialogue: 0,0:20:33.85,0:20:36.31,Default,,0,0,0,,Бұл ойыншық қорапшасы.
Dialogue: 0,0:20:37.06,0:20:39.69,Default,,0,0,0,,Сонымен қатар, Додзо қауіпсіз.
Dialogue: 0,0:20:39.78,0:20:41.74,Default,,0,0,0,,Додзо қауіпсіз ме?
Dialogue: 0,0:20:41.82,0:20:44.99,Default,,0,0,0,,Ережесі бар, пәні бар.
Dialogue: 0,0:20:45.07,0:20:46.57,Default,,0,0,0,,Жалпы мағына
Dialogue: 0,0:20:47.16,0:20:49.66,Default,,0,0,0,,Сырттағыдан әлдеқайда қауіпсіз.
Dialogue: 0,0:20:50.16,0:20:52.58,Default,,0,0,0,,Айтпақшы, Гайя-кун.
Dialogue: 0,0:20:53.16,0:20:56.08,Default,,0,0,0,,Біраз уақыт өтті. кездесейік.
Dialogue: 0,0:20:56.17,0:20:58.09,Default,,0,0,0,,Хмм... аа...
Dialogue: 0,0:20:59.29,0:21:00.75,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:21:01.34,0:21:04.59,Default,,0,0,0,,Доджо әлі де қауіпті орын.
Dialogue: 0,0:21:05.72,0:21:10.72,Default,,0,0,0,,♪~
Dialogue: 0,0:22:29.05,0:22:34.06,Default,,0,0,0,,~♪
Dialogue: 0,0:22:35.56,0:22:41.56,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory