Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.59,0:00:16.76,Default,,0,0,0,,♪~
Dialogue: 0,0:01:34.59,0:01:39.59,Default,,0,0,0,,~♪
Dialogue: 0,0:01:51.86,0:01:53.27,Default,,0,0,0,,Қалай
Dialogue: 0,0:01:55.78,0:01:57.28,Default,,0,0,0,,Қалай
Dialogue: 0,0:02:00.28,0:02:02.28,Default,,0,0,0,,Қандай ыңғайлы нәрсе!
Dialogue: 0,0:02:06.20,0:02:07.54,Default,,0,0,0,,Енді
Dialogue: 0,0:02:11.63,0:02:16.30,Default,,0,0,0,,Жылқы майына сабан көмір илеу...
Dialogue: 0,0:02:21.55,0:02:24.39,Default,,0,0,0,,Хмм, емделді.
Dialogue: 0,0:02:21.55,0:02:24.39,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:02:24.39,0:02:25.31,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:02:28.73,0:02:30.06,Default,,0,0,0,,Мұсашиден
Dialogue: 0,0:02:31.06,0:02:32.81,Default,,0,0,0,,Уақытыңыз бар ма?
Dialogue: 0,0:02:32.90,0:02:34.23,Default,,0,0,0,,Хаха
Dialogue: 0,0:02:34.73,0:02:36.82,Default,,0,0,0,,Алдымен айтып беріңізші.
Dialogue: 0,0:02:39.70,0:02:41.32,Default,,0,0,0,,Орналасқан жері осында
Dialogue: 0,0:02:41.41,0:02:44.08,Default,,0,0,0,,Уақыт 3 күннен кейін түнде
Dialogue: 0,0:02:44.99,0:02:47.16,Default,,0,0,0,,Қарсылас осында тұр —
Dialogue: 0,0:02:49.37,0:02:53.00,Default,,0,0,0,,Мин әулетінің өкілі Рецукай патша
Dialogue: 0,0:02:53.92,0:02:57.84,Default,,0,0,0,,Tokyo Dome жерасты аренасы алғаш рет ережелер!
Dialogue: 0,0:02:58.55,0:03:00.59,Default,,0,0,0,,Қаруға рұқсат етілген!
Dialogue: 0,0:03:02.09,0:03:03.09,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:03:03.97,0:03:08.35,Default,,0,0,0,,Мына Мұсашыға қару шығарғысы келген сен бе?
Dialogue: 0,0:03:08.43,0:03:09.85,Default,,0,0,0,,Материк халқы
Dialogue: 0,0:03:09.93,0:03:13.48,Default,,0,0,0,,Менің қалағаным – толық есеп айырысу.
Dialogue: 0,0:03:14.06,0:03:17.98,Default,,0,0,0,,Мен сенің жаныңда болғанды ​​жөн көремін.
Dialogue: 0,0:03:19.32,0:03:23.03,Default,,0,0,0,,Әрине, қолында қылыш болмаса да.
Dialogue: 0,0:03:23.11,0:03:25.62,Default,,0,0,0,,Миямото Мусашидің әлсіз болуы мүмкін емес.
Dialogue: 0,0:03:25.70,0:03:26.87,Default,,0,0,0,,Хмм
Dialogue: 0,0:03:27.45,0:03:31.75,Default,,0,0,0,,Бірақ, бірақ сен теңдесі жоқ қылышшысың.
Dialogue: 0,0:03:31.83,0:03:33.88,Default,,0,0,0,,Кенпо дәрігері ретінде И
Dialogue: 0,0:03:33.96,0:03:37.25,Default,,0,0,0,,Жалаң қолмен жеңсем де, түкке тұрғысыз.
Dialogue: 0,0:03:38.17,0:03:40.26,Default,,0,0,0,,Accha~
Dialogue: 0,0:03:41.26,0:03:44.76,Default,,0,0,0,,Қалай ойлайсың, Мұсашыны жалаң қолмен жеңе аласың ба?
Dialogue: 0,0:03:47.14,0:03:49.22,Default,,0,0,0,,Мүмкін біз жеңетін шығармыз
Dialogue: 0,0:03:49.31,0:03:52.02,Default,,0,0,0,,Немесе сіз жеңе алмайсыз.
Dialogue: 0,0:03:52.64,0:03:55.77,Default,,0,0,0,,Алайда «бауыр» жоқ.
Dialogue: 0,0:03:56.77,0:03:59.03,Default,,0,0,0,,«Миямото Мусашиді жеңу» нені білдіреді?
Dialogue: 0,0:04:00.07,0:04:03.03,Default,,0,0,0,,Қолыма қылыш ұстап саған қарсы күресуім керек!
Dialogue: 0,0:04:03.66,0:04:05.66,Default,,0,0,0,,Басқа амал жоқ
Dialogue: 0,0:04:11.62,0:04:12.79,Default,,0,0,0,,Қарапайым айтқанда—
Dialogue: 0,0:04:15.96,0:04:17.79,Default,,0,0,0,,Материктен келген адамдар
Dialogue: 0,0:04:18.38,0:04:20.26,Default,,0,0,0,,Иә, жақсы!
Dialogue: 0,0:04:21.63,0:04:22.55,Default,,0,0,0,,Үзіліс!
Dialogue: 0,0:04:22.63,0:04:24.18,Default,,0,0,0,,- (Мусаши) Мм! -(Ретсу) Ух...
Dialogue: 0,0:04:26.01,0:04:27.18,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:27.26,0:04:28.43,Default,,0,0,0,,(Мұсашидің ыңырануы)
Dialogue: 0,0:04:37.02,0:04:38.02,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:04:39.19,0:04:41.44,Default,,0,0,0,,Не істеп жатырсың, Рецу?
Dialogue: 0,0:04:41.53,0:04:45.24,Default,,0,0,0,,Әлі ұстамаған адамға!
Dialogue: 0,0:04:45.74,0:04:47.95,Default,,0,0,0,,Мен көптен бері жекпе-жекпен айналысамын, бірақ
Dialogue: 0,0:04:48.57,0:04:51.70,Default,,0,0,0,,Мұндай шайтандық жауынгерлік рух сирек кездеседі.
Dialogue: 0,0:04:51.79,0:04:53.71,Default,,0,0,0,,Орнатылған мен болдым.
Dialogue: 0,0:04:54.71,0:04:57.54,Default,,0,0,0,,Мен мұны маған айтуыңызды қалаймын.
Dialogue: 0,0:04:58.75,0:05:02.26,Default,,0,0,0,,«Менде күні үзілмейтін протездік аяғым болады».
Dialogue: 0,0:05:02.34,0:05:04.51,Default,,0,0,0,,Мен келесі үш күнді асыға күтемін.
Dialogue: 0,0:05:05.80,0:05:07.89,Default,,0,0,0,,Қандай ұят
Dialogue: 0,0:05:08.39,0:05:10.97,Default,,0,0,0,,Мен сені жақсы көремін, құрлықтың халқы.
Dialogue: 0,0:05:13.06,0:05:16.02,Default,,0,0,0,,Түсіндіру жақсы.
Dialogue: 0,0:05:16.81,0:05:21.40,Default,,0,0,0,,Бейнебаяннан оның шынайы екені көрініп тұр.
Dialogue: 0,0:05:21.48,0:05:24.11,Default,,0,0,0,,Бұл маған жетеді.
Dialogue: 0,0:05:27.53,0:05:28.36,Default,,0,0,0,,Ахсо
Dialogue: 0,0:05:29.12,0:05:30.53,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:05:31.24,0:05:32.62,Default,,0,0,0,,Кейде кәрі ханзада
Dialogue: 0,0:05:33.29,0:05:35.87,Default,,0,0,0,,Миямото Мусаши және Реккаио
Dialogue: 0,0:05:35.96,0:05:40.13,Default,,0,0,0,,Жер асты аренасында қару алғаш рет көтеріледі деген қауесеттер бар.
Dialogue: 0,0:05:40.71,0:05:43.55,Default,,0,0,0,,Бұл Рецудың өзі қалаған ережелер.
Dialogue: 0,0:05:43.63,0:05:45.88,Default,,0,0,0,,Мұсашидің қарсылық білдіруі мүмкін емес.
Dialogue: 0,0:05:45.97,0:05:48.30,Default,,0,0,0,,Жаман сөз айтпа
Dialogue: 0,0:05:48.80,0:05:51.51,Default,,0,0,0,,Рецу мырзаға пулемет дайындаңыз.
Dialogue: 0,0:05:51.60,0:05:52.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:53.43,0:05:56.10,Default,,0,0,0,,Миямото Мусашиге қаруды босату
Dialogue: 0,0:05:56.18,0:06:00.19,Default,,0,0,0,,Жекпе-жек өнері Қарт ханзада жекпе-жек өнеріне қарап тұрды.
Dialogue: 0,0:06:00.27,0:06:03.52,Default,,0,0,0,,Мен сіздің түсінігіңізді құрметтеймін.
Dialogue: 0,0:06:03.61,0:06:04.78,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:06:05.65,0:06:09.66,Default,,0,0,0,,Артқы тіске бірдеңе кептеліп қалған сияқты...
Dialogue: 0,0:06:10.49,0:06:14.91,Default,,0,0,0,,Бірақ өкінішке орай, практикалық еместің шегі
Dialogue: 0,0:06:14.99,0:06:17.66,Default,,0,0,0,,Мұндай шектен шыққан мінез-құлық жасалады.
Dialogue: 0,0:06:19.29,0:06:21.25,Default,,0,0,0,,Маған айтасыз ба?
Dialogue: 0,0:06:21.33,0:06:23.42,Default,,0,0,0,,Айтуы қиын нәрселерді айту
Dialogue: 0,0:06:23.50,0:06:26.92,Default,,0,0,0,,Қарт күтпеген жерден,
Dialogue: 0,0:06:27.01,0:06:32.68,Default,,0,0,0,,Сіз өзіңізді әуесқой ретінде таныттыңыз.
Dialogue: 0,0:06:33.64,0:06:35.64,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:06:36.77,0:06:40.73,Default,,0,0,0,,Миямото Мусаши деп аталатын құбыжық
Dialogue: 0,0:06:40.81,0:06:43.82,Default,,0,0,0,,Сіз жай ғана түсінбейсіз.
Dialogue: 0,0:06:43.90,0:06:46.36,Default,,0,0,0,,Менің көзім түйіншек болды.
Dialogue: 0,0:06:46.44,0:06:48.07,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:06:48.65,0:06:52.95,Default,,0,0,0,,Рецукайу алға шығып, қаруға тыйым салудың жойылғанын көргісі келді.
Dialogue: 0,0:06:53.03,0:06:55.58,Default,,0,0,0,,Сіз оған әуесқой ретінде қарайсыз ба?
Dialogue: 0,0:06:56.70,0:06:59.58,Default,,0,0,0,,Ұмыттың ба, қария?
Dialogue: 0,0:06:59.66,0:07:01.54,Default,,0,0,0,,Бұл сәйкестік
Dialogue: 0,0:07:01.62,0:07:05.09,Default,,0,0,0,,Рецуды білетін кез келген адам түсінетін мазмұн
Dialogue: 0,0:07:05.59,0:07:09.67,Default,,0,0,0,,Біріншіден, Рецукай патша осындай адам болса керек.
Dialogue: 0,0:07:09.76,0:07:13.14,Default,,0,0,0,,Өмірімнен айрылдым ба, аяғымнан айырылдым ба
Dialogue: 0,0:07:13.22,0:07:17.10,Default,,0,0,0,,Біреуді мықты деп танысаң, оны іздеп, күресу – «әділдік».
Dialogue: 0,0:07:18.06,0:07:20.10,Default,,0,0,0,,Бұл Реккайо
Dialogue: 0,0:07:20.18,0:07:22.48,Default,,0,0,0,,Мұны бәрі біледі емес пе?
Dialogue: 0,0:07:23.06,0:07:24.15,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:26.19,0:07:27.73,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:27.82,0:07:33.49,Default,,0,0,0,,Сонымен қатар, қарсыласты тек нағыз Миямото Мусаши деп сипаттауға болады.
Dialogue: 0,0:07:33.57,0:07:35.49,Default,,0,0,0,,Түс болса, оянба
Dialogue: 0,0:07:36.08,0:07:39.16,Default,,0,0,0,,Сіз де солай істегіңіз келе ме? Мотобу Изо
Dialogue: 0,0:07:39.25,0:07:40.66,Default,,0,0,0,,Ммм
Dialogue: 0,0:07:40.75,0:07:41.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:42.37,0:07:43.83,Default,,0,0,0,,Мен...
Dialogue: 0,0:07:43.92,0:07:45.38,Default,,0,0,0,,Менің жағдайда –
Dialogue: 0,0:07:45.46,0:07:51.09,Default,,0,0,0,,Мен мұны істегім келгеннің орнына «Мен оны қорғағым келеді» дер едім.
Dialogue: 0,0:07:51.17,0:07:52.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:52.68,0:07:54.89,Default,,0,0,0,,Дада Дада… Кім?
Dialogue: 0,0:07:55.51,0:07:58.93,Default,,0,0,0,,Миямото Мусаши ұлы семсерші ретінде бағаланады.
Dialogue: 0,0:07:59.02,0:08:01.48,Default,,0,0,0,,Қылыштарды ғана қолдануға болмайды
Dialogue: 0,0:08:01.56,0:08:06.15,Default,,0,0,0,,Ол дәуірдегі самурайлар мұндай тәтті шарлар емес еді.
Dialogue: 0,0:08:06.73,0:08:09.40,Default,,0,0,0,,Қылыш найза садақ таяқшасы
Dialogue: 0,0:08:09.48,0:08:11.36,Default,,0,0,0,,Нагината Шурикен
Dialogue: 0,0:08:11.44,0:08:13.15,Default,,0,0,0,,Арқан ат
Dialogue: 0,0:08:13.24,0:08:16.99,Default,,0,0,0,,Жекпе-жек: Қолыңнан келмейтін нәрсе жоқ
Dialogue: 0,0:08:17.07,0:08:17.91,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:08:17.99,0:08:20.91,Default,,0,0,0,,Осы штабта
Dialogue: 0,0:08:21.00,0:08:23.66,Default,,0,0,0,,Осы жекпе-жек өнерінің барлығын үйреніңіз
Dialogue: 0,0:08:23.75,0:08:25.08,Default,,0,0,0,,Хо…
Dialogue: 0,0:08:25.17,0:08:28.34,Default,,0,0,0,,Бұл тіпті Юдзиро Ханманың қолынан келмейтін нәрсе.
Dialogue: 0,0:08:28.42,0:08:29.42,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:08:29.50,0:08:32.76,Default,,0,0,0,,Менен басқа ешкім жоқ.
Dialogue: 0,0:08:32.84,0:08:35.80,Default,,0,0,0,,Достарын Мусашиден кім қорғай алады?
Dialogue: 0,0:08:36.51,0:08:38.43,Default,,0,0,0,,(қашықтықтағы көліктің дыбысы)
Dialogue: 0,0:08:50.78,0:08:51.94,Default,,0,0,0,,Хамф!
Dialogue: 0,0:08:54.78,0:08:56.45,Default,,0,0,0,,Дегенмен, менің ойымша, бұл жақсы жоспар.
Dialogue: 0,0:08:59.28,0:09:00.28,Default,,0,0,0,,(Жарық дыбысы)
Dialogue: 0,0:09:05.79,0:09:07.58,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:09:07.67,0:09:11.34,Default,,0,0,0,,Қару техникасы сәл әлсіз болуы мүмкін, бірақ керісінше
Dialogue: 0,0:09:11.42,0:09:15.34,Default,,0,0,0,,Қарқын алған жоқ па? Рецу!
Dialogue: 0,0:09:16.01,0:09:17.09,Default,,0,0,0,,Мастер Роши
Dialogue: 0,0:09:17.18,0:09:19.60,Default,,0,0,0,,(Барлығы дірілдейді)
Dialogue: 0,0:09:22.68,0:09:24.23,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:09:26.94,0:09:28.10,Default,,0,0,0,,Хмм!
Dialogue: 0,0:09:28.19,0:09:30.23,Default,,0,0,0,,Арх! Ха!
Dialogue: 0,0:09:30.31,0:09:32.07,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:33.69,0:09:36.36,Default,,0,0,0,,(Тераданың ауыр тыныс алуы)
Dialogue: 0,0:09:37.45,0:09:38.61,Default,,0,0,0,,Сіз оны таптың!
Dialogue: 0,0:09:38.70,0:09:41.24,Default,,0,0,0,,Маған тиді, бірақ сынбайды!
Dialogue: 0,0:09:41.83,0:09:44.41,Default,,0,0,0,,Ол соншалықты қатты болса да
Dialogue: 0,0:09:44.50,0:09:46.75,Default,,0,0,0,,Қауырсын сияқты
Dialogue: 0,0:09:46.83,0:09:48.75,Default,,0,0,0,,- (Терада) Әй! -(Ретсу) Хмф!
Dialogue: 0,0:09:48.83,0:09:50.00,Default,,0,0,0,,Арх!
Dialogue: 0,0:09:50.08,0:09:51.38,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:51.46,0:09:52.75,Default,,0,0,0,,Қандай жағымсыз иіс! Тамағымның арты ұстап, ауырып барады.
Dialogue: 0,0:09:52.84,0:09:55.51,Default,,0,0,0,,
Dialogue: 0,0:09:56.67,0:09:58.38,Default,,0,0,0,,«Сяоли» деп оқылады
Dialogue: 0,0:09:58.47,0:10:01.51,Default,,0,0,0,,Сүйектерді қағу Етті қағу
Dialogue: 0,0:10:01.60,0:10:03.51,Default,,0,0,0,,Теріні нығайту
Dialogue: 0,0:10:03.60,0:10:07.18,Default,,0,0,0,,Бес денені қалың қабырғаға айналдыра алады.
Dialogue: 0,0:10:07.27,0:10:10.52,Default,,0,0,0,,Баяу соққылар тойтарыс береді.
Dialogue: 0,0:10:10.61,0:10:14.40,Default,,0,0,0,,Осы уақытқа дейін бәріңіз білетіндей.
Dialogue: 0,0:10:14.48,0:10:17.99,Default,,0,0,0,,Бірақ бұл технология емес
Dialogue: 0,0:10:18.07,0:10:22.62,Default,,0,0,0,,Бұл жоғары дәрежелі техника деп аталатын техникадан мүлде басқаша.
Dialogue: 0,0:10:22.70,0:10:24.04,Default,,0,0,0,,Олай болса, не істейсің?
Dialogue: 0,0:10:24.70,0:10:26.16,Default,,0,0,0,,Бұл солай болуы керек.
Dialogue: 0,0:10:27.16,0:10:28.16,Default,,0,0,0,,Қауырсын
Dialogue: 0,0:10:28.25,0:10:29.29,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:29.37,0:10:30.67,Default,,0,0,0,,Сізден бір нәрсе сұрасам…
Dialogue: 0,0:10:31.33,0:10:34.59,Default,,0,0,0,,Бес денені жайлаған бейсаналық шиеленіс
Dialogue: 0,0:10:34.67,0:10:36.76,Default,,0,0,0,,Бұлшық еттерге, сүйектерге, сіңірлерге
Dialogue: 0,0:10:36.84,0:10:40.38,Default,,0,0,0,,Еттің тереңінде орналасқан қаттылық
Dialogue: 0,0:10:40.47,0:10:42.93,Default,,0,0,0,,Оны толығымен алып тастаңыз
Dialogue: 0,0:10:43.51,0:10:44.81,Default,,0,0,0,,Шығу кезінде
Dialogue: 0,0:10:44.89,0:10:50.06,Default,,0,0,0,,Қатты ет қабырғалары мұз қаптамасының икемділігін қабылдай бастайды.
Dialogue: 0,0:10:50.14,0:10:52.65,Default,,0,0,0,,Ханшидің сенімсіздігіне жақындау
Dialogue: 0,0:10:52.73,0:10:54.07,Default,,0,0,0,,Ақырында ол қауырсынға айналады...
Dialogue: 0,0:10:54.82,0:10:58.57,Default,,0,0,0,,Қанатқа дейін барсаң, енді қабырғалар жоқ.
Dialogue: 0,0:10:58.65,0:11:02.32,Default,,0,0,0,,Жел, оқ және зымырандар
Dialogue: 0,0:11:02.41,0:11:05.08,Default,,0,0,0,,Мағынасыз өтіп бара жатыр
Dialogue: 0,0:11:06.70,0:11:07.70,Default,,0,0,0,,Сен дұрыс айтасың — сені өліміңе мен себеп болдым.
Dialogue: 0,0:11:08.45,0:11:12.96,Default,,0,0,0,,Толық жойылу (Сяоли) Егер нағыз қауырсынның өзгеруіне қол жеткізілсе...
Dialogue: 0,0:11:14.29,0:11:15.84,Default,,0,0,0,,(рух дауысы)
Dialogue: 0,0:11:15.92,0:11:17.84,Default,,0,0,0,,
Dialogue: 0,0:11:21.34,0:11:23.84,Default,,0,0,0,,Оған тіпті пышақтар да өте алмайды
Dialogue: 0,0:11:24.72,0:11:25.72,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:28.14,0:11:31.60,Default,,0,0,0,,Екі жақты қолдану тек Мусашиге ғана тән емес
Dialogue: 0,0:11:35.69,0:11:37.90,Default,,0,0,0,,(Кацуми Гучидің дірілдеген тынысы)
Dialogue: 0,0:11:37.98,0:11:41.61,Default,,0,0,0,,Бір қылыш техникасы болса да, қандай айырмашылық!
Dialogue: 0,0:11:41.70,0:11:43.66,Default,,0,0,0,,Қарапайым және түксіз
Dialogue: 0,0:11:43.74,0:11:46.58,Default,,0,0,0,,Қылышқа көп ой салатын жапондық қылыш тәсілдері
Dialogue: 0,0:11:46.66,0:11:48.70,Default,,0,0,0,,«Тыныштық» әсеріне қатысты
Dialogue: 0,0:11:48.79,0:11:51.04,Default,,0,0,0,,Спорттық динамизм
Dialogue: 0,0:11:51.12,0:11:54.29,Default,,0,0,0,,Қытай қылыштарының әдістерінен алған әсері шынымен «динамикалық»!
Dialogue: 0,0:11:57.29,0:12:00.34,Default,,0,0,0,,«Шабуылда өткір, шабуылда сымбатты бол»
Dialogue: 0,0:12:00.42,0:12:03.80,Default,,0,0,0,,Егер сіз каратэмен айналысатын болсаңыз, бұл сөзді кем дегенде бір рет естіген боларсыз.
Dialogue: 0,0:12:03.88,0:12:07.39,Default,,0,0,0,,Ежелгі Қытай жауынгерлік өнерінің мәні
Dialogue: 0,0:12:07.47,0:12:08.14,Default,,0,0,0,,(Тырнаның айқайы)
Dialogue: 0,0:12:08.14,0:12:10.35,Default,,0,0,0,,(Тырнаның айқайы)
Dialogue: 0,0:12:08.14,0:12:10.35,Default,,0,0,0,,Тырна жыланды өлтірмекші
Dialogue: 0,0:12:10.43,0:12:13.89,Default,,0,0,0,,Бұл сөз сол күрес әдісінен туындаған деседі.
Dialogue: 0,0:12:13.98,0:12:16.90,Default,,0,0,0,,Жылан тұмсығымен шабуылдауда қиналады.
Dialogue: 0,0:12:17.61,0:12:19.40,Default,,0,0,0,,Ашуланып, айла орнатсаң да
Dialogue: 0,0:12:19.98,0:12:22.45,Default,,0,0,0,,Қанатын қаққан билеп тұрған тырналарға
Dialogue: 0,0:12:22.53,0:12:23.90,Default,,0,0,0,,Барлығы жарамсыз
Dialogue: 0,0:12:24.91,0:12:28.16,Default,,0,0,0,,Ақырында ол өлтірілді.
Dialogue: 0,0:12:28.24,0:12:29.91,Default,,0,0,0,,Бұл жақсы емес
Dialogue: 0,0:12:31.50,0:12:36.21,Default,,0,0,0,,«Рақымды түрде уке» Бұл екі қолға да, қолға да қатысты.
Dialogue: 0,0:12:36.29,0:12:39.17,Default,,0,0,0,,Әсем биді де қылыш тоқтатады.
Dialogue: 0,0:12:40.00,0:12:42.17,Default,,0,0,0,,Рецу, тұр.
Dialogue: 0,0:12:43.76,0:12:46.80,Default,,0,0,0,,«Жылдам» болыңыз және мұқият тербеліңіз.
Dialogue: 0,0:12:51.81,0:12:53.81,Default,,0,0,0,,Қауырсынға айнал
Dialogue: 0,0:12:53.89,0:12:56.81,Default,,0,0,0,,Қылышым толық ұшса
Dialogue: 0,0:12:56.90,0:12:58.69,Default,,0,0,0,,Мусаши өлтірілмейді
Dialogue: 0,0:13:00.78,0:13:02.40,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:13:02.90,0:13:03.90,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:13:03.99,0:13:05.03,Default,,0,0,0,,Кез келген уақытта!
Dialogue: 0,0:13:11.99,0:13:14.29,Default,,0,0,0,,Керемет сурет
Dialogue: 0,0:13:16.67,0:13:18.46,Default,,0,0,0,,Қандай жаттығу түрі?
Dialogue: 0,0:13:18.54,0:13:21.96,Default,,0,0,0,,（）
Dialogue: 0,0:13:29.51,0:13:30.47,Default,,0,0,0,,(Желді жарып өту дыбысы)
Dialogue: 0,0:13:30.55,0:13:31.72,Default,,0,0,0,,Хамф!
Dialogue: 0,0:13:35.81,0:13:37.73,Default,,0,0,0,,О...
Dialogue: 0,0:13:38.56,0:13:39.56,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:45.19,0:13:48.20,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:13:49.37,0:13:50.87,Default,,0,0,0,,«Қауырсын бол»
Dialogue: 0,0:13:51.45,0:13:53.37,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:13:53.45,0:13:54.20,Default,,0,0,0,,(Рецудың ауыр тыныс алуы)
Dialogue: 0,0:13:54.20,0:13:55.62,Default,,0,0,0,,(Рецудың ауыр тыныс алуы)
Dialogue: 0,0:13:54.20,0:13:55.62,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:13:55.62,0:13:56.91,Default,,0,0,0,,(Ретсудың ауыр тыныс алуы)
Dialogue: 0,0:13:57.00,0:13:58.96,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:14:02.50,0:14:06.38,Default,,0,0,0,,Гений Реккайо осында
Dialogue: 0,0:14:08.97,0:14:10.64,Default,,0,0,0,,(Гуоның жанды дауысы)
Dialogue: 0,0:14:16.35,0:14:17.48,Default,,0,0,0,,Кесу...
Dialogue: 0,0:14:22.44,0:14:23.32,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:26.24,0:14:29.15,Default,,0,0,0,,Кесілген жоқ! Бірінші рет...
Dialogue: 0,0:14:30.03,0:14:32.16,Default,,0,0,0,,Бірінші ретке қарағанда екінші рет
Dialogue: 0,0:14:32.24,0:14:34.91,Default,,0,0,0,,Екінші ретке қарағанда үшінші рет
Dialogue: 0,0:14:34.99,0:14:37.29,Default,,0,0,0,,Гений Реккайо
Dialogue: 0,0:14:37.37,0:14:40.92,Default,,0,0,0,,Төртінші рет қана қауырсынға айналды
Dialogue: 0,0:14:41.50,0:14:43.17,Default,,0,0,0,,Керемет жұмыс!
Dialogue: 0,0:14:44.50,0:14:45.71,Default,,0,0,0,,Иә
Dialogue: 0,0:14:47.09,0:14:48.47,Default,,0,0,0,,Хаа…
Dialogue: 0,0:14:49.26,0:14:52.64,Default,,0,0,0,,Ақылмен анықта Көзбен анықта
Dialogue: 0,0:14:52.72,0:14:54.56,Default,,0,0,0,,Қылыш сызығына қарсы шықпа
Dialogue: 0,0:14:55.31,0:14:58.81,Default,,0,0,0,,Бес дене ұшқан қауырсынға айналады.
Dialogue: 0,0:14:58.89,0:15:01.48,Default,,0,0,0,,Аяқ – жел, қол – жел
Dialogue: 0,0:15:01.56,0:15:04.06,Default,,0,0,0,,Бес дене, барлығы жел
Dialogue: 0,0:15:08.15,0:15:11.32,Default,,0,0,0,,Бұл қалың денеге сәттілік.
Dialogue: 0,0:15:12.16,0:15:13.16,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:14.20,0:15:16.91,Default,,0,0,0,,Сяоли аяқталды.
Dialogue: 0,0:15:19.29,0:15:20.33,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:15:20.41,0:15:21.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:22.67,0:15:24.21,Default,,0,0,0,,Сол акробатикада...
Dialogue: 0,0:15:24.29,0:15:25.34,Default,,0,0,0,,О!
Dialogue: 0,0:15:27.88,0:15:30.59,Default,,0,0,0,,Мұсашидің жүзіне қарсы тұру
Dialogue: 0,0:15:30.67,0:15:32.18,Default,,0,0,0,,Мотобу мырза
Dialogue: 0,0:15:33.22,0:15:35.10,Default,,0,0,0,,Қытай 4000 жыл
Dialogue: 0,0:15:35.18,0:15:36.60,Default,,0,0,0,,Алайда, біз оның қозғалысын тоқтата аламыз.
Dialogue: 0,0:15:37.10,0:15:39.14,Default,,0,0,0,,Бір жақтағы ауырсыну
Dialogue: 0,0:15:40.18,0:15:41.60,Default,,0,0,0,,(дірілдеген тыныс)
Dialogue: 0,0:15:41.69,0:15:44.10,Default,,0,0,0,,(Желді жарып өту дыбысы)
Dialogue: 0,0:15:48.86,0:15:49.86,Default,,0,0,0,,(айқай)
Dialogue: 0,0:15:49.94,0:15:52.86,Default,,0,0,0,,(қанаттардың қағу дыбысы)
Dialogue: 0,0:15:52.95,0:15:54.20,Default,,0,0,0,,(Желді жарып өту дыбысы)
Dialogue: 0,0:15:54.95,0:15:57.87,Default,,0,0,0,,Уау
Dialogue: 0,0:16:04.21,0:16:07.50,Default,,0,0,0,,Бұл... ұзын әрі ауыр пышақ.
Dialogue: 0,0:16:08.75,0:16:11.51,Default,,0,0,0,,Бірдеңе жиі шығып тұратын сияқты.
Dialogue: 0,0:16:13.05,0:16:16.26,Default,,0,0,0,,Және көрінбейтін жоғары жылдамдықта
Dialogue: 0,0:16:16.93,0:16:18.18,Default,,0,0,0,,Ноу
Dialogue: 0,0:16:18.68,0:16:22.14,Default,,0,0,0,,Хехехе, қолмен жұлып алсам да шықпайды.
Dialogue: 0,0:16:22.73,0:16:23.89,Default,,0,0,0,,Бел.
Dialogue: 0,0:16:24.73,0:16:27.15,Default,,0,0,0,,Белде кесу Белде кесу!
Dialogue: 0,0:16:28.02,0:16:29.15,Default,,0,0,0,,Бір кейіпкер!
Dialogue: 0,0:16:29.73,0:16:34.15,Default,,0,0,0,,Олай етпесеңіз, уақытында үлгере алмайсыз. Олай етпесең, болашақ жоқ!
Dialogue: 0,0:16:35.66,0:16:36.82,Default,,0,0,0,,Рецу-сан
Dialogue: 0,0:16:36.91,0:16:40.20,Default,,0,0,0,,Сіз сол акробатикалық акробатика жасадыңыз.
Dialogue: 0,0:16:40.29,0:16:43.66,Default,,0,0,0,,Сіз сол ұлы қылышшының семсеріне тосқауыл қоюды жоспарлап отырсыз ба?
Dialogue: 0,0:16:43.75,0:16:45.17,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:47.04,0:16:49.92,Default,,0,0,0,,Хохохохо... мынау
Dialogue: 0,0:16:50.00,0:16:54.68,Default,,0,0,0,,Ескі жапон стилін құрметтейтін жекпе-жек шебері.
Dialogue: 0,0:16:54.76,0:16:56.05,Default,,0,0,0,,Қарапайым айтқанда—
Dialogue: 0,0:16:56.14,0:16:58.68,Default,,0,0,0,,Мотобу мырзаның стилі бір қарағанда...
Dialogue: 0,0:16:58.76,0:17:02.98,Default,,0,0,0,,Менің «Сяолиді аяқтау» сертификатым
Dialogue: 0,0:17:03.06,0:17:05.44,Default,,0,0,0,,Қарсылық білдіргіңіз келе ме?
Dialogue: 0,0:17:06.15,0:17:07.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:09.61,0:17:11.69,Default,,0,0,0,,Таңқаларлық емес.
Dialogue: 0,0:17:12.19,0:17:13.94,Default,,0,0,0,,Бұл Қытай.
Dialogue: 0,0:17:14.90,0:17:17.70,Default,,0,0,0,,Сенгоку жекпе-жек өнерін түсінбейсің.
Dialogue: 0,0:17:19.24,0:17:20.70,Default,,0,0,0,,Қарсыласу
Dialogue: 0,0:17:21.66,0:17:24.12,Default,,0,0,0,,, яғни біреуінің өлімі
Dialogue: 0,0:17:25.54,0:17:28.33,Default,,0,0,0,,Сабаққа қатысу деңгейі қаншалықты төмен болса да
Dialogue: 0,0:17:28.42,0:17:31.46,Default,,0,0,0,,Сол қатыгездіктің анық болған кезі болды.
Dialogue: 0,0:17:31.55,0:17:35.42,Default,,0,0,0,,Қайта-қайта жеңіске жетуге және жеңілуге ​​мүмкіндік беретін қазіргі заманғы жекпе-жек өнері дегеніміз не?
Dialogue: 0,0:17:35.51,0:17:37.43,Default,,0,0,0,,Бұл басқа өлшем сияқты
Dialogue: 0,0:17:37.51,0:17:41.60,Default,,0,0,0,,Бүгінгі күнге дейін жетіспейтін дәстүрлі жекпе-жек түрлері
Dialogue: 0,0:17:41.68,0:17:44.73,Default,,0,0,0,,Жетілмеген немесе жеткіліксіз
Dialogue: 0,0:17:45.31,0:17:47.85,Default,,0,0,0,,Бізде мұны ескі әдіспен жасаудан басқа амал жоқ!
Dialogue: 0,0:17:47.94,0:17:49.73,Default,,0,0,0,,(Жалпы тыныс алу дыбысы)
Dialogue: 0,0:17:51.69,0:17:52.73,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:17:53.73,0:17:56.99,Default,,0,0,0,,Сонымен не істеуім керек?
Dialogue: 0,0:17:57.70,0:17:58.61,Default,,0,0,0,,(Джан) Құдай-ай, енді ғана сиырдың шоғырына батып қалдым.
Dialogue: 0,0:17:58.70,0:17:59.78,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:00.41,0:18:03.37,Default,,0,0,0,,Жалаң қолдың төбелесінің өзі күдік туғызады.
Dialogue: 0,0:18:03.99,0:18:07.04,Default,,0,0,0,,Әсіресе қылыш ұстаған Миямото Мусаши
Dialogue: 0,0:18:07.12,0:18:09.88,Default,,0,0,0,,Автоматты алсаңыз да жеңу мүмкіндігі жоқ.
Dialogue: 0,0:18:11.09,0:18:13.13,Default,,0,0,0,,Қорлауға жол берілмейді.
Dialogue: 0,0:18:13.21,0:18:14.63,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:18:16.01,0:18:19.26,Default,,0,0,0,,Рецутан, ол кесіп алады.
Dialogue: 0,0:18:20.14,0:18:22.51,Default,,0,0,0,,Темір мен қауырсын да.
Dialogue: 0,0:18:23.39,0:18:25.77,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:18:27.85,0:18:31.15,Default,,0,0,0,,Сіз бұл штабтан ары кете алмайсыз.
Dialogue: 0,0:18:31.23,0:18:32.52,Default,,0,0,0,,(Жалпы тыныс алу дыбысы)
Dialogue: 0,0:18:38.65,0:18:39.78,Default,,0,0,0,,Ертең түн
Dialogue: 0,0:18:40.36,0:18:42.78,Default,,0,0,0,,Бұл арена қатты дауысқа толы...
Dialogue: 0,0:18:43.53,0:18:47.12,Default,,0,0,0,,Оның орнына сіз үнсіздікке толы боласыз.
Dialogue: 0,0:18:47.20,0:18:48.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:51.13,0:18:53.29,Default,,0,0,0,,Ууууах!
Dialogue: 0,0:18:53.38,0:18:56.55,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:18:58.26,0:19:00.80,Default,,0,0,0,,Тыйым салуды бұзу, шайқас алдындағы түн
Dialogue: 0,0:19:00.88,0:19:03.05,Default,,0,0,0,,Хмм?
Dialogue: 0,0:19:04.72,0:19:06.31,Default,,0,0,0,,Ертең...
Dialogue: 0,0:19:07.68,0:19:09.10,Default,,0,0,0,,«Артқа өту»
Dialogue: 0,0:19:09.18,0:19:11.69,Default,,0,0,0,,Мен бұл нені білдіретінін ойладым.
Dialogue: 0,0:19:12.35,0:19:16.28,Default,,0,0,0,,Мен сізбен кездесіп, жеңуім керек.
Dialogue: 0,0:19:16.36,0:19:17.94,Default,,0,0,0,,Мен сізге әрі қарай жүруге рұқсат беруім керек.
Dialogue: 0,0:19:18.03,0:19:21.11,Default,,0,0,0,,Оны тек осы мағынада ғана түсіндіруге болады.
Dialogue: 0,0:19:21.61,0:19:24.95,Default,,0,0,0,,Мотобу мырза, мен қателесемін деп үміттенемін.
Dialogue: 0,0:19:28.58,0:19:29.71,Default,,0,0,0,,Рецутан
Dialogue: 0,0:19:31.00,0:19:32.96,Default,,0,0,0,,Мені қате түсінбеңіз.
Dialogue: 0,0:19:34.79,0:19:36.96,Default,,0,0,0,,- (Штаб) Мм! -(Ретсу) Ах...
Dialogue: 0,0:19:37.05,0:19:38.05,Default,,0,0,0,,Гррр…
Dialogue: 0,0:19:43.47,0:19:44.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:45.18,0:19:46.47,Default,,0,0,0,,(Рецудың күшті дауысы)
Dialogue: 0,0:19:47.56,0:19:49.73,Default,,0,0,0,,Хмм... жарайды...
Dialogue: 0,0:19:51.06,0:19:53.23,Default,,0,0,0,,Қарғыс атсын... бұл керемет
Dialogue: 0,0:19:53.31,0:19:55.86,Default,,0,0,0,,Шынтағымды сындырып ала жаздады
Dialogue: 0,0:19:55.94,0:19:58.48,Default,,0,0,0,,Қарсылас – Кено Реккайо
Dialogue: 0,0:19:58.57,0:20:00.53,Default,,0,0,0,,Бұрыштарды кесуге шамамыз келмейді.
Dialogue: 0,0:20:00.61,0:20:02.86,Default,,0,0,0,,Кесілгеннен жақсы.
Dialogue: 0,0:20:04.16,0:20:05.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:05.95,0:20:07.37,Default,,0,0,0,,Хамф!
Dialogue: 0,0:20:09.08,0:20:11.00,Default,,0,0,0,,- (Ретсу) Хмф! - (Штаб) Арх!
Dialogue: 0,0:20:11.75,0:20:12.75,Default,,0,0,0,,ал үшінші және төртінші метакарпальды сүйектері мен саусақ сақина мен ортаңғы саусағымның проксимальды фалангаларында
Dialogue: 0,0:20:12.83,0:20:14.00,Default,,0,0,0,,Хамф!
Dialogue: 0,0:20:15.58,0:20:17.00,Default,,0,0,0,,(Retsu no Kiai)
Dialogue: 0,0:20:21.34,0:20:22.17,Default,,0,0,0,,Ол ісініп, қан ағып тұр
Dialogue: 0,0:20:23.09,0:20:24.59,Default,,0,0,0,,Күшті!
Dialogue: 0,0:20:24.68,0:20:27.01,Default,,0,0,0,,Рецудың күшті екені айтпаса да түсінікті.
Dialogue: 0,0:20:27.10,0:20:30.27,Default,,0,0,0,,Мотобу Изо кім болды? Ол осы деңгейде болды ма?
Dialogue: 0,0:20:31.98,0:20:34.02,Default,,0,0,0,,Реккаио күткендей
Dialogue: 0,0:20:35.06,0:20:37.90,Default,,0,0,0,,Менен жақсырақ шығар
Dialogue: 0,0:20:37.98,0:20:39.02,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:20:39.11,0:20:40.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:44.61,0:20:46.78,Default,,0,0,0,,Мусашиден артық емес
Dialogue: 0,0:20:47.37,0:20:48.45,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:49.37,0:20:51.25,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:53.58,0:20:56.79,Default,,0,0,0,,Ойынның алдындағы түнде не істеп жүрсің?
Dialogue: 0,0:20:56.88,0:20:57.79,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:20:57.88,0:21:00.46,Default,,0,0,0,,Бұл бір қолыңмен күресетін адам ма?
Dialogue: 0,0:21:00.55,0:21:01.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:01.55,0:21:04.22,Default,,0,0,0,,Осылай жалғастырсаңыз
Dialogue: 0,0:21:04.30,0:21:07.34,Default,,0,0,0,,Рецуя, сен аман-есен құтылмадың.
Dialogue: 0,0:21:08.68,0:21:09.93,Default,,0,0,0,,Мен...
Dialogue: 0,0:21:10.43,0:21:12.85,Default,,0,0,0,,«Маған бәрібір!» емес
Dialogue: 0,0:21:12.93,0:21:14.27,Default,,0,0,0,,Әй!
Dialogue: 0,0:21:15.44,0:21:17.40,Default,,0,0,0,,Хибудың орнында еш зиянсыз тұру
Dialogue: 0,0:21:17.48,0:21:19.36,Default,,0,0,0,,Бұл табиғи сыпайылық.
Dialogue: 0,0:21:20.19,0:21:21.48,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:21:23.19,0:21:25.36,Default,,0,0,0,,Қазір біраз демалыңыз.
Dialogue: 0,0:21:25.95,0:21:27.24,Default,,0,0,0,,(Рецу тынысының дыбысы)
Dialogue: 0,0:21:35.96,0:21:36.46,Default,,0,0,0,,
Dialogue: 0,0:21:36.46,0:21:37.87,Default,,0,0,0,,
Dialogue: 0,0:21:36.46,0:21:37.87,Default,,0,0,0,,Күні
Dialogue: 0,0:21:38.75,0:21:43.13,Default,,0,0,0,,Tokyo Dome жер асты аренасы оғаш дыбыстарға толы болды.
Dialogue: 0,0:21:43.92,0:21:45.26,Default,,0,0,0,,Себебі
Dialogue: 0,0:21:45.34,0:21:49.26,Default,,0,0,0,,Аренадағы көрініс әдеттегіден ерекше болды.
Dialogue: 0,0:21:50.47,0:21:51.64,Default,,0,0,0,,Қаржы
Dialogue: 0,0:21:51.72,0:21:52.89,Default,,0,0,0,,Көзді соғу
Dialogue: 0,0:21:52.97,0:21:54.14,Default,,0,0,0,,Тістеу
Dialogue: 0,0:21:54.73,0:21:56.14,Default,,0,0,0,,Барлығы мүмкін
Dialogue: 0,0:21:56.94,0:21:58.65,Default,,0,0,0,,Бұл жеткілікті.
Dialogue: 0,0:21:58.73,0:22:02.40,Default,,0,0,0,,Бірақ сіз әрі қарай... әрі қарай ұмтылғыңыз келе ме?
Dialogue: 0,0:22:03.03,0:22:06.70,Default,,0,0,0,,Бұл күні аудиториядағылардың бәрі бетпе-бет келді.
Dialogue: 0,0:22:06.78,0:22:10.07,Default,,0,0,0,,Сіз көргіңіз келетін «аттачиай» ма?
Dialogue: 0,0:22:10.16,0:22:11.66,Default,,0,0,0,,«Бірін-бірі өлтіру»?
Dialogue: 0,0:22:12.37,0:22:15.66,Default,,0,0,0,,Технологияны немесе кісі өлтіруді көргіңіз келе ме?
Dialogue: 0,0:22:21.88,0:22:26.88,Default,,0,0,0,,♪~
Dialogue: 0,0:23:45.25,0:23:50.26,Default,,0,0,0,,~♪
Dialogue: 0,0:23:51.76,0:23:57.76,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory