Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.59,0:00:16.59,Default,,0,0,0,,♪~
Dialogue: 0,0:01:34.59,0:01:39.59,Default,,0,0,0,,~♪
Dialogue: 0,0:01:51.36,0:01:52.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:53.07,0:01:55.03,Default,,0,0,0,,Жоқ, мен жауап бере алмаймын.
Dialogue: 0,0:01:56.86,0:01:58.28,Default,,0,0,0,,(Екі адамның тыныс алуы)
Dialogue: 0,0:02:01.62,0:02:02.83,Default,,0,0,0,,- (1-аудитория мүшесі) Иә? - (2-аудитория) Не?
Dialogue: 0,0:02:02.91,0:02:04.12,Default,,0,0,0,,Ә… Мен келдім бе…
Dialogue: 0,0:02:08.12,0:02:09.79,Default,,0,0,0,,
Dialogue: 0,0:02:11.38,0:02:12.54,Default,,0,0,0,,Қарапайым айтқанда—
Dialogue: 0,0:02:16.13,0:02:18.05,Default,,0,0,0,,Хм... Сонымен!
Dialogue: 0,0:02:20.30,0:02:21.55,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:02:21.64,0:02:23.81,Default,,0,0,0,,- (4-ші аудитория) О! - (5-ші аудитория) Мен ояндым!
Dialogue: 0,0:02:23.89,0:02:26.31,Default,,0,0,0,,(Рецудың ауыр тыныс алуы)
Dialogue: 0,0:02:26.98,0:02:27.93,Default,,0,0,0,,Хамф!
Dialogue: 0,0:02:28.02,0:02:29.31,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:29.39,0:02:30.31,Default,,0,0,0,,ал үшінші және төртінші метакарпальды сүйектері мен саусақ сақина мен ортаңғы саусағымның проксимальды фалангаларында
Dialogue: 0,0:02:32.90,0:02:35.57,Default,,0,0,0,,Екі жұдырықтың бастапқы қимылы басылды!
Dialogue: 0,0:02:35.65,0:02:37.57,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:02:39.65,0:02:40.66,Default,,0,0,0,,Қарапайым айтқанда—
Dialogue: 0,0:02:41.16,0:02:42.32,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:43.45,0:02:45.58,Default,,0,0,0,,(Ретсудың ыңырануы)
Dialogue: 0,0:02:49.91,0:02:51.83,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:02:51.92,0:02:53.92,Default,,0,0,0,,Мен шынтағымнан айырылдым!
Dialogue: 0,0:02:55.13,0:02:56.84,Default,,0,0,0,,Қайта оралыңыз
Dialogue: 0,0:02:57.71,0:02:58.59,Default,,0,0,0,,Тағы бір соққы немесе...
Dialogue: 0,0:02:58.59,0:03:00.34,Default,,0,0,0,,Тағы бір соққы немесе...
Dialogue: 0,0:02:58.59,0:03:00.34,Default,,0,0,0,,(Миямото Мусашидің ізі)
Dialogue: 0,0:03:00.34,0:03:00.43,Default,,0,0,0,,(Миямото Мусашидің ізі)
Dialogue: 0,0:03:00.43,0:03:01.34,Default,,0,0,0,,(Миямото Мусашидің ізі)
Dialogue: 0,0:03:00.43,0:03:01.34,Default,,0,0,0,,Ha
Dialogue: 0,0:03:01.43,0:03:02.51,Default,,0,0,0,,Уф!
Dialogue: 0,0:03:05.97,0:03:07.60,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,0:03:07.68,0:03:10.60,Default,,0,0,0,,Мұсаши Көк Айдаһар қылышын алды
Dialogue: 0,0:03:11.48,0:03:13.61,Default,,0,0,0,,Ойыншықтар да ойыншық
Dialogue: 0,0:03:13.69,0:03:15.11,Default,,0,0,0,,Мамма миа, мен бара жатырмын
Dialogue: 0,0:03:15.86,0:03:18.86,Default,,0,0,0,,Оны шынымен қару деп атауға болмайды.
Dialogue: 0,0:03:21.95,0:03:23.87,Default,,0,0,0,,Болат қорқынышты
Dialogue: 0,0:03:24.70,0:03:27.37,Default,,0,0,0,,Жан кіре алмайды.
Dialogue: 0,0:03:27.95,0:03:28.95,Default,,0,0,0,,(металл діріл дыбысы)
Dialogue: 0,0:03:28.95,0:03:30.96,Default,,0,0,0,,(металл діріл дыбысы)
Dialogue: 0,0:03:28.95,0:03:30.96,Default,,0,0,0,,Бұл асхана пышағын әрең алмастыра ма?
Dialogue: 0,0:03:30.96,0:03:31.87,Default,,0,0,0,,Бұл асхана пышағын әрең алмастыра ма?
Dialogue: 0,0:03:35.21,0:03:37.13,Default,,0,0,0,,(мәжбүрлі тыныс алу)
Dialogue: 0,0:03:44.84,0:03:46.30,Default,,0,0,0,,(Тыныс алу)
Dialogue: 0,0:03:47.22,0:03:49.14,Default,,0,0,0,,О... менің ұстанымым?
Dialogue: 0,0:03:49.22,0:03:50.39,Default,,0,0,0,,Бұл ұстаным!
Dialogue: 0,0:03:50.48,0:03:51.52,Default,,0,0,0,,О!
Dialogue: 0,0:03:51.60,0:03:52.77,Default,,0,0,0,,Мұнда келіңіз...
Dialogue: 0,0:03:52.85,0:03:54.77,Default,,0,0,0,,Бұл... бұл?
Dialogue: 0,0:03:54.85,0:03:56.06,Default,,0,0,0,,
Dialogue: 0,0:03:54.85,0:03:56.06,Default,,0,0,0,,Бұл Баки.
Dialogue: 0,0:03:56.06,0:03:56.15,Default,,0,0,0,,
Dialogue: 0,0:03:56.15,0:03:58.27,Default,,0,0,0,,
Dialogue: 0,0:03:56.15,0:03:58.27,Default,,0,0,0,,Баки Ханманың жауынгерлік позасы.
Dialogue: 0,0:03:58.36,0:04:00.36,Default,,0,0,0,,Чемпионның ұстанымы
Dialogue: 0,0:04:01.53,0:04:03.91,Default,,0,0,0,,Ауырлық центрін саусақтарыңызға қойыңыз
Dialogue: 0,0:04:03.99,0:04:06.37,Default,,0,0,0,,Аяқ алдыңғы және артқы жағынан табиғи
Dialogue: 0,0:04:07.20,0:04:09.12,Default,,0,0,0,,Дене – сөзсіз жарты дене
Dialogue: 0,0:04:09.62,0:04:12.21,Default,,0,0,0,,Басқа адам көрген аумақ кішірейеді
Dialogue: 0,0:04:13.08,0:04:15.54,Default,,0,0,0,,Алдыңғы иық иекті жауып тұрады
Dialogue: 0,0:04:15.63,0:04:18.04,Default,,0,0,0,,Екінші тарапқа кедергі болу
Dialogue: 0,0:04:19.13,0:04:21.13,Default,,0,0,0,,Доминант қол да иек жанында
Dialogue: 0,0:04:21.21,0:04:24.01,Default,,0,0,0,,Атуға дайындық кезінде қолыңызды бос ұстаңыз
Dialogue: 0,0:04:24.09,0:04:26.34,Default,,0,0,0,,Алдыңғы қозғалыс шабуылда да, қорғаныста да болады.
Dialogue: 0,0:04:26.43,0:04:28.93,Default,,0,0,0,,Пішін жағдайға байланысты
Dialogue: 0,0:04:29.89,0:04:32.52,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:04:34.64,0:04:36.15,Default,,0,0,0,,Қашан басталғанын білгім келеді
Dialogue: 0,0:04:36.23,0:04:37.86,Default,,0,0,0,,Оны ойлап тапқаннан гөрі
Dialogue: 0,0:04:37.94,0:04:40.28,Default,,0,0,0,,Мен оны түсінген кезде алған қалпым
Dialogue: 0,0:04:41.07,0:04:43.03,Default,,0,0,0,,Мен цукейакибладе жасайтын адам емеспін.
Dialogue: 0,0:04:43.99,0:04:45.53,Default,,0,0,0,,Сіз нені мақсат етесіз?
Dialogue: 0,0:04:47.37,0:04:49.74,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:04:47.37,0:04:49.74,Default,,0,0,0,,Иә, жақсы!
Dialogue: 0,0:04:49.74,0:04:49.83,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:04:49.83,0:04:50.37,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:04:49.83,0:04:50.37,Default,,0,0,0,,Дененің әр бұрышына жететін қытайлық жекпе-жек
Dialogue: 0,0:04:50.37,0:04:52.79,Default,,0,0,0,,Дененің әр бұрышына жететін қытайлық жекпе-жек
Dialogue: 0,0:04:53.54,0:04:55.54,Default,,0,0,0,,Оны лақтыратын ойым жоқ, бірақ
Dialogue: 0,0:04:56.42,0:04:57.79,Default,,0,0,0,,Мүгедектігі бар оң аяқ
Dialogue: 0,0:04:58.50,0:05:00.30,Default,,0,0,0,,Сол жақ шынтағы зақымдалған
Dialogue: 0,0:05:01.42,0:05:03.05,Default,,0,0,0,,Бұл қазір жақсы
Dialogue: 0,0:05:03.13,0:05:05.80,Default,,0,0,0,,Жақсы! қозғала алады
Dialogue: 0,0:05:06.76,0:05:07.89,Default,,0,0,0,,Сіз қозғала аласыз!
Dialogue: 0,0:05:13.43,0:05:16.06,Default,,0,0,0,,Оны өлтіруді ұйғарған Мусашидің алдында Нао...
Dialogue: 0,0:05:16.98,0:05:19.56,Default,,0,0,0,,Қозғалсам деген сезімді сейілте алмаймын!
Dialogue: 0,0:05:19.65,0:05:21.32,Default,,0,0,0,,Міне кеттік!
Dialogue: 0,0:05:23.19,0:05:24.32,Default,,0,0,0,,Екіге бөл!
Dialogue: 0,0:05:24.90,0:05:27.91,Default,,0,0,0,,Мұсашыны кесіп таста!
Dialogue: 0,0:05:30.03,0:05:31.08,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:31.78,0:05:33.20,Default,,0,0,0,,О!
Dialogue: 0,0:05:33.29,0:05:34.70,Default,,0,0,0,,
Dialogue: 0,0:05:38.04,0:05:38.96,Default,,0,0,0,,Құрметті сізге...
Dialogue: 0,0:05:39.04,0:05:40.04,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:40.79,0:05:42.30,Default,,0,0,0,,Неге тартпасқа!
Dialogue: 0,0:05:42.80,0:05:44.71,Default,,0,0,0,,Неге Хикикиран емес!
Dialogue: 0,0:05:44.80,0:05:48.72,Default,,0,0,0,,Сен Рецуды қорламақшысың ба?!
Dialogue: 0,0:05:49.43,0:05:50.47,Default,,0,0,0,,Хехе
Dialogue: 0,0:05:51.43,0:05:52.97,Default,,0,0,0,,Заттың заты
Dialogue: 0,0:05:53.81,0:05:55.22,Default,,0,0,0,,Мамма миа, мен бара жатырмын
Dialogue: 0,0:05:56.18,0:05:58.23,Default,,0,0,0,,Әй, Бақи-сан.
Dialogue: 0,0:05:58.31,0:05:59.23,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:59.31,0:06:00.73,Default,,0,0,0,,Рахмет
Dialogue: 0,0:06:01.44,0:06:02.48,Default,,0,0,0,,ал Ол Майтпен шайқасу – қауіпті ғана емес,
Dialogue: 0,0:06:02.57,0:06:05.99,Default,,0,0,0,,
Dialogue: 0,0:06:06.07,0:06:07.24,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:08.82,0:06:10.53,Default,,0,0,0,,Шаа!
Dialogue: 0,0:06:10.62,0:06:13.74,Default,,0,0,0,,Рецу-сан, сен данышпансың!
Dialogue: 0,0:06:13.83,0:06:17.08,Default,,0,0,0,,Ғажайып, қауырсын тепті.
Dialogue: 0,0:06:17.58,0:06:18.58,Default,,0,0,0,,О...
Dialogue: 0,0:06:18.66,0:06:21.50,Default,,0,0,0,,Уау, мен мұны шынымен жасадым.
Dialogue: 0,0:06:22.29,0:06:23.29,Default,,0,0,0,,Баки-сан
Dialogue: 0,0:06:24.71,0:06:26.01,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:06:27.30,0:06:31.51,Default,,0,0,0,,Сіздің денеңізде ойып жазылған және ойлап тапқан ұстаным
Dialogue: 0,0:06:33.60,0:06:35.01,Default,,0,0,0,,Аһ!
Dialogue: 0,0:06:35.77,0:06:36.77,Default,,0,0,0,,Қауырсындарға—
Dialogue: 0,0:06:36.85,0:06:41.98,Default,,0,0,0,,Салмақ пен өткірліктің қайшылығын қамтамасыз етті.
Dialogue: 0,0:06:42.69,0:06:45.61,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:06:48.19,0:06:50.11,Default,,0,0,0,,Ол жұмыс істейді!
Dialogue: 0,0:06:50.20,0:06:52.62,Default,,0,0,0,,Бұл зат тұрмайды!
Dialogue: 0,0:06:54.70,0:06:56.87,Default,,0,0,0,,Аяқтаңыз!
Dialogue: 0,0:06:56.95,0:06:58.87,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:06:59.62,0:07:00.87,Default,,0,0,0,,Пышақ
Dialogue: 0,0:07:01.79,0:07:03.63,Default,,0,0,0,,Оған пышақ салудың қажеті жоқ.
Dialogue: 0,0:07:04.84,0:07:06.13,Default,,0,0,0,,Мен саған пышақ сұғуға батылым бармын!
Dialogue: 0,0:07:06.21,0:07:08.63,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:07:08.71,0:07:10.22,Default,,0,0,0,,О...
Dialogue: 0,0:07:10.72,0:07:12.39,Default,,0,0,0,,(дірілдеп тыныс алу)
Dialogue: 0,0:07:13.39,0:07:14.39,Default,,0,0,0,,Бұл —
Dialogue: 0,0:07:15.30,0:07:17.39,Default,,0,0,0,,Сіздің жолыңызға да сай болуы керек!
Dialogue: 0,0:07:17.47,0:07:18.85,Default,,0,0,0,,(мәжбүрлі тыныс алу)
Dialogue: 0,0:07:20.73,0:07:22.40,Default,,0,0,0,,(Ретсудың ыңырсыуы)
Dialogue: 0,0:07:23.06,0:07:24.06,Default,,0,0,0,,Мимикрия!
Dialogue: 0,0:07:24.15,0:07:25.90,Default,,0,0,0,,Ол өзін өлді деп көрсетті.
Dialogue: 0,0:07:25.98,0:07:27.90,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:07:29.49,0:07:30.90,Default,,0,0,0,,(Мусашидің күшті дауысы)
Dialogue: 0,0:07:30.99,0:07:33.91,Default,,0,0,0,,Не… бұл қандай мимика?
Dialogue: 0,0:07:33.99,0:07:35.41,Default,,0,0,0,,Белдік жіп...
Dialogue: 0,0:07:36.03,0:07:37.91,Default,,0,0,0,,Жауынгерлік өнер
Dialogue: 0,0:07:37.99,0:07:40.16,Default,,0,0,0,,Міндетті заң
Dialogue: 0,0:07:40.75,0:07:43.17,Default,,0,0,0,,Бұл айлалы шабуыл болды!
Dialogue: 0,0:07:43.25,0:07:45.67,Default,,0,0,0,,Әп-сәтте байланып қалғаным ғажап болды!
Dialogue: 0,0:07:45.75,0:07:46.63,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:07:46.71,0:07:49.17,Default,,0,0,0,,Арқан техникасы деп те аталады
Dialogue: 0,0:07:49.84,0:07:51.67,Default,,0,0,0,,Маңызды емес
Dialogue: 0,0:07:52.63,0:07:55.76,Default,,0,0,0,,Бұл сізді байлап, қозғала алмайтын әдіс.
Dialogue: 0,0:07:56.26,0:08:00.35,Default,,0,0,0,,Не... ол маған тосыннан шабуыл жасады.
Dialogue: 0,0:08:00.43,0:08:01.52,Default,,0,0,0,,Жекпе-жек...
Dialogue: 0,0:08:01.60,0:08:04.19,Default,,0,0,0,,Жекпе-жек өнерінің деңгейі тым бөлек.
Dialogue: 0,0:08:06.27,0:08:10.28,Default,,0,0,0,,Іске қосу сигналы берілді және мәселені шешу мүмкін емес.
Dialogue: 0,0:08:10.36,0:08:12.11,Default,,0,0,0,,Тосын шабуыл жұмыс істемейді
Dialogue: 0,0:08:12.20,0:08:13.40,Default,,0,0,0,,Бұл ештеңе емес.
Dialogue: 0,0:08:13.49,0:08:14.45,Default,,0,0,0,,Бұл нәтиже –
Dialogue: 0,0:08:15.20,0:08:19.95,Default,,0,0,0,,Рецудың абайсыздығын пайдаланып, Мусашидің заңды қарсы шабуылы.
Dialogue: 0,0:08:20.04,0:08:22.46,Default,,0,0,0,,Менің кінәм жоқ!
Dialogue: 0,0:08:25.96,0:08:26.96,Default,,0,0,0,,Бітті
Dialogue: 0,0:08:27.54,0:08:30.71,Default,,0,0,0,,Жеңілмеді, қимайды
Dialogue: 0,0:08:30.80,0:08:33.88,Default,,0,0,0,,Қозғалыс әлі қозғала алмай тұрғанда бұғатталған.
Dialogue: 0,0:08:33.97,0:08:36.22,Default,,0,0,0,,Қозғалыстан айырылу
Dialogue: 0,0:08:36.30,0:08:38.39,Default,,0,0,0,,Егер сіз жекпе-жек өнерімен өмір сүрсеңіз
Dialogue: 0,0:08:38.47,0:08:41.22,Default,,0,0,0,,Ешқашан болмауы керек аяқталу
Dialogue: 0,0:08:41.31,0:08:42.18,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:08:42.27,0:08:43.98,Default,,0,0,0,,Жиренішті де жиіркенішті
Dialogue: 0,0:08:44.77,0:08:47.06,Default,,0,0,0,,Жеңіліс жеңілуден де жаман
Dialogue: 0,0:08:47.56,0:08:48.73,Default,,0,0,0,,Кесу...
Dialogue: 0,0:08:48.81,0:08:49.82,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:50.32,0:08:53.49,Default,,0,0,0,,Мұсашиді кесіңіз!
Dialogue: 0,0:08:53.57,0:08:54.99,Default,,0,0,0,,Үрмеңіз
Dialogue: 0,0:08:55.07,0:08:56.11,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:56.20,0:08:58.57,Default,,0,0,0,,Мақтанба, Рецукай патша
Dialogue: 0,0:08:58.66,0:09:01.99,Default,,0,0,0,,Сізде енді қысқартуға да еркіндік жоқ.
Dialogue: 0,0:09:02.08,0:09:05.08,Default,,0,0,0,,(Рецудың ауыр тыныс алуы)
Dialogue: 0,0:09:05.16,0:09:07.25,Default,,0,0,0,,(тұншығу дыбысы)
Dialogue: 0,0:09:07.92,0:09:11.13,Default,,0,0,0,,Сізге неше рет соққы болды?
Dialogue: 0,0:09:11.21,0:09:14.63,Default,,0,0,0,,Сегіз қол және сегіз аяқ
Dialogue: 0,0:09:14.72,0:09:15.59,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:16.22,0:09:18.39,Default,,0,0,0,,(Тыныс алу)
Dialogue: 0,0:09:18.97,0:09:21.26,Default,,0,0,0,,Мұрынның өзегі сынып қалды
Dialogue: 0,0:09:21.35,0:09:23.27,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:09:26.73,0:09:29.02,Default,,0,0,0,,Соғу, соғу
Dialogue: 0,0:09:30.15,0:09:32.02,Default,,0,0,0,,Жалтарып, тепті
Dialogue: 0,0:09:32.86,0:09:35.78,Default,,0,0,0,,Алдамшы Йошими байланған
Dialogue: 0,0:09:37.86,0:09:38.86,Default,,0,0,0,,Әй!
Dialogue: 0,0:09:40.12,0:09:41.41,Default,,0,0,0,,(рух)
Dialogue: 0,0:09:48.87,0:09:50.42,Default,,0,0,0,,Оны кесіп алайық
Dialogue: 0,0:09:50.50,0:09:52.21,Default,,0,0,0,,(13 және 14-көрермендердің күрсінуі)
Dialogue: 0,0:09:52.30,0:09:53.17,Default,,0,0,0,,Кесу...
Dialogue: 0,0:09:53.25,0:09:54.96,Default,,0,0,0,,Тоқта, Мусаши-сан!
Dialogue: 0,0:09:55.05,0:09:56.17,Default,,0,0,0,,Эй!
Dialogue: 0,0:09:57.05,0:09:58.18,Default,,0,0,0,,Мен байсалдымын.
Dialogue: 0,0:09:58.76,0:09:59.76,Default,,0,0,0,,Кесу
Dialogue: 0,0:10:01.01,0:10:02.68,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:10:02.76,0:10:03.72,Default,,0,0,0,,Хамф!
Dialogue: 0,0:10:06.02,0:10:07.44,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:08.02,0:10:08.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:10.06,0:10:10.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:12.19,0:10:13.19,Default,,0,0,0,,Рецу
Dialogue: 0,0:10:19.53,0:10:20.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:21.53,0:10:23.45,Default,,0,0,0,,Негізгі қылышқа
Dialogue: 0,0:10:24.04,0:10:26.20,Default,,0,0,0,,Айналыңыз!
Dialogue: 0,0:10:26.29,0:10:27.66,Default,,0,0,0,,Мамма миа, мен бара жатырмын
Dialogue: 0,0:10:27.75,0:10:28.71,Default,,0,0,0,,Ол күтпеген жерден сол жақ қорғаныстан тік соққымен жауап қайтарды
Dialogue: 0,0:10:28.79,0:10:30.71,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:31.50,0:10:33.21,Default,,0,0,0,,Сяоли өнері!
Dialogue: 0,0:10:34.05,0:10:35.25,Default,,0,0,0,,(Рецудың күшті дауысы)
Dialogue: 0,0:10:40.30,0:10:42.22,Default,,0,0,0,,Менің аяғымды кесіп тастадым!
Dialogue: 0,0:10:42.30,0:10:44.14,Default,,0,0,0,,Жылдам және көрінбейтін!
Dialogue: 0,0:10:44.22,0:10:45.22,Default,,0,0,0,,Құдайдың ісі...
Dialogue: 0,0:10:45.31,0:10:46.22,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:51.60,0:10:52.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:53.86,0:10:54.98,Default,,0,0,0,,Мұсаши мырза
Dialogue: 0,0:10:57.07,0:11:00.07,Default,,0,0,0,,Бұл керемет...
Dialogue: 0,0:11:00.15,0:11:00.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:01.07,0:11:03.95,Default,,0,0,0,,Сяоли жеңілді!
Dialogue: 0,0:11:06.62,0:11:08.79,Default,,0,0,0,,Уәде... аа...
Dialogue: 0,0:11:10.08,0:11:11.75,Default,,0,0,0,,
Dialogue: 0,0:11:13.83,0:11:14.88,Default,,0,0,0,,(Әйелдің айғайы)
Dialogue: 0,0:11:14.96,0:11:18.76,Default,,0,0,0,,Мен оны кесіп тастай алмадым... Протез аяқты қолдануға тура келді... Бұл...
Dialogue: 0,0:11:18.84,0:11:20.34,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:11:20.84,0:11:21.76,Default,,0,0,0,,Осы балаға не болған екен…
Dialogue: 0,0:11:21.84,0:11:23.26,Default,,0,0,0,,Иә
Dialogue: 0,0:11:24.26,0:11:27.26,Default,,0,0,0,,Қытай бамбукын жарып бітірдім деп ойладым...
Dialogue: 0,0:11:27.35,0:11:30.06,Default,,0,0,0,,Мен күткендей Асат!
Dialogue: 0,0:11:30.69,0:11:32.27,Default,,0,0,0,,Сяоли Сәттілік!
Dialogue: 0,0:11:35.86,0:11:38.40,Default,,0,0,0,,Тағы бір рет!
Dialogue: 0,0:11:38.98,0:11:42.15,Default,,0,0,0,,Хмм, тағы бір рет.
Dialogue: 0,0:11:43.24,0:11:44.74,Default,,0,0,0,,Қолдар жерде
Dialogue: 0,0:11:45.74,0:11:47.66,Default,,0,0,0,,Денеңізді бүгіңіз
Dialogue: 0,0:11:48.33,0:11:50.16,Default,,0,0,0,,Аяқтарды қамтамасыз етіңіз
Dialogue: 0,0:11:50.25,0:11:55.17,Default,,0,0,0,,Мақсат сыртқы көріністе айқын көрінеді.
Dialogue: 0,0:11:55.25,0:11:56.67,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:11:57.63,0:12:00.42,Default,,0,0,0,,Кестеде келесі әрекеттер көрсетіледі:
Dialogue: 0,0:12:00.51,0:12:01.01,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:12:01.01,0:12:03.01,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:12:01.01,0:12:03.01,Default,,0,0,0,,Жасырын ниет жоқ
Dialogue: 0,0:12:03.01,0:12:03.43,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:12:04.09,0:12:06.43,Default,,0,0,0,,Енді ұстаным жоқ
Dialogue: 0,0:12:07.30,0:12:08.93,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:09.01,0:12:10.18,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:10.27,0:12:12.23,Default,,0,0,0,,Өкінішке орай, Реккайо.
Dialogue: 0,0:12:12.31,0:12:14.44,Default,,0,0,0,,Сіз оны дұрыс емес бағытта пышақтай алмайсыз!
Dialogue: 0,0:12:16.02,0:12:17.44,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:20.65,0:12:21.82,Default,,0,0,0,,Тоқтату…
Dialogue: 0,0:12:21.90,0:12:22.74,Default,,0,0,0,,Уф!
Dialogue: 0,0:12:22.82,0:12:23.90,Default,,0,0,0,,Денеде? Теккен!
Dialogue: 0,0:12:23.99,0:12:25.03,Default,,0,0,0,,Тығыздығы таңқаларлық!
Dialogue: 0,0:12:25.11,0:12:26.12,Default,,0,0,0,,Қорқынышты! Қатты!
Dialogue: 0,0:12:26.20,0:12:27.16,Default,,0,0,0,,Forge! ұстау!
Dialogue: 0,0:12:27.24,0:12:28.33,Default,,0,0,0,,Қиын! тамаша!
Dialogue: 0,0:12:28.41,0:12:29.49,Default,,0,0,0,,Тоқтады!
Dialogue: 0,0:12:29.58,0:12:30.58,Default,,0,0,0,,Қылыш тоқтады!
Dialogue: 0,0:12:30.66,0:12:31.66,Default,,0,0,0,,Жұдырық!
Dialogue: 0,0:12:31.75,0:12:33.33,Default,,0,0,0,,- (Аудитория мүшесі 7) Тоқтады! - (21-аудитория) Мен оны қия алмаймын!
Dialogue: 0,0:12:34.25,0:12:35.83,Default,,0,0,0,,Жұдырықтай
Dialogue: 0,0:12:36.42,0:12:38.42,Default,,0,0,0,,Өте жоғары!
Dialogue: 0,0:12:38.92,0:12:39.92,Default,,0,0,0,,Иә
Dialogue: 0,0:12:40.42,0:12:43.84,Default,,0,0,0,,Мен түсіндім! Мусаши!
Dialogue: 0,0:12:43.92,0:12:45.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:45.43,0:12:48.10,Default,,0,0,0,,Дұрыс, Реккайо.
Dialogue: 0,0:12:48.18,0:12:50.06,Default,,0,0,0,,Балалар сендер ұстап жатырсыңдар
Dialogue: 0,0:12:50.14,0:12:51.64,Default,,0,0,0,,Қазіргі уақытта пышақ жоқ
Dialogue: 0,0:12:51.72,0:12:53.52,Default,,0,0,0,,Жұдырық – қылыш!
Dialogue: 0,0:13:00.82,0:13:03.86,Default,,0,0,0,,Apparenari Rekkaio!
Dialogue: 0,0:13:03.94,0:13:05.03,Default,,0,0,0,,- (А аудитория) Қиылған - (В аудитория) Қиылған
Dialogue: 0,0:13:05.11,0:13:06.61,Default,,0,0,0,,- (18-аудитория) Мен кесіп тастадым! - (22-аудитория) Қатты кесіп тастадым.
Dialogue: 0,0:13:11.70,0:13:13.70,Default,,0,0,0,,Абдул сен үшін өлді.
Dialogue: 0,0:13:16.71,0:13:18.17,Default,,0,0,0,,Мен білгім келеді
Dialogue: 0,0:13:18.25,0:13:19.21,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:20.59,0:13:24.51,Default,,0,0,0,,Мен қиылып кетсем, мұның соңы бола ма?
Dialogue: 0,0:13:25.47,0:13:27.43,Default,,0,0,0,,Бұл аяқталады ма...
Dialogue: 0,0:13:28.09,0:13:30.47,Default,,0,0,0,,Сен өлесің, солай ма?
Dialogue: 0,0:13:32.10,0:13:34.35,Default,,0,0,0,,Кесетін болсаң, ақыры өлесің.
Dialogue: 0,0:13:34.93,0:13:36.27,Default,,0,0,0,,Мен мұны түсінемін.
Dialogue: 0,0:13:37.39,0:13:40.27,Default,,0,0,0,,Бірақ мынау жұқа темір парақ
Dialogue: 0,0:13:40.36,0:13:43.36,Default,,0,0,0,,Ол шын мәнінде денеге еніп кетті делік.
Dialogue: 0,0:13:43.86,0:13:47.49,Default,,0,0,0,,Дәл солай болғаны сонша, мен тіпті қарсы тұра алмаймын.
Dialogue: 0,0:13:47.57,0:13:50.78,Default,,0,0,0,,Бұл зиян келтіреді және ауыртады ма?
Dialogue: 0,0:13:53.41,0:13:56.29,Default,,0,0,0,,Қалай ойлайсың, Рецу?
Dialogue: 0,0:13:57.12,0:13:58.79,Default,,0,0,0,,Қылыш найзасы
Dialogue: 0,0:14:00.00,0:14:04.30,Default,,0,0,0,,Пышақтардан соқыр қорқыныш жекпе-жек өнері әлемінде ежелгі дәуірден бері орын алған.
Dialogue: 0,0:14:05.34,0:14:07.05,Default,,0,0,0,,Мен жек көремін
Dialogue: 0,0:14:09.64,0:14:15.06,Default,,0,0,0,,Басыңызды кесіп алмасаңыз, қарсы шабуылға шығып, жағдайды кері қайтаруға болады!
Dialogue: 0,0:14:16.89,0:14:20.81,Default,,0,0,0,,Жоқ, мен міндетті түрде күресемін!
Dialogue: 0,0:14:23.98,0:14:25.32,Default,,0,0,0,,Ол тез.
Dialogue: 0,0:14:25.40,0:14:27.86,Default,,0,0,0,,Мәселе жоқ!
Dialogue: 0,0:14:28.40,0:14:30.41,Default,,0,0,0,,Хаха
Dialogue: 0,0:14:30.91,0:14:34.62,Default,,0,0,0,,Оны сол уақытқа дейін сақтаңыз.
Dialogue: 0,0:14:36.29,0:14:38.29,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:14:40.75,0:14:41.58,Default,,0,0,0,,Ол ұзақ фильм сияқты көрінді, сондықтан мен оны көруге үлгермедім.
Dialogue: 0,0:14:43.54,0:14:45.59,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:14:45.67,0:14:46.67,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:14:49.55,0:14:50.89,Default,,0,0,0,,Абдул сен үшін өлді.
Dialogue: 0,0:14:50.97,0:14:53.10,Default,,0,0,0,,Өлтіру деген осы
Dialogue: 0,0:14:54.56,0:14:57.22,Default,,0,0,0,,Сіз қысқартуды айтып тұрсыз!
Dialogue: 0,0:14:58.06,0:14:59.35,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:00.81,0:15:01.81,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:02.69,0:15:04.52,Default,,0,0,0,,Жүрек сонда болды.
Dialogue: 0,0:15:06.82,0:15:08.69,Default,,0,0,0,,лақтыру сәті
Dialogue: 0,0:15:10.03,0:15:12.20,Default,,0,0,0,,Шынында да, жүзі ұсталды
Dialogue: 0,0:15:13.03,0:15:16.83,Default,,0,0,0,,Қолым бір сәт босап, босадым.
Dialogue: 0,0:15:18.08,0:15:21.17,Default,,0,0,0,,Сяоли мен айналайын деп ойлаймын.
Dialogue: 0,0:15:23.58,0:15:26.21,Default,,0,0,0,,Сізді осы жерден кесіп тастайды!
Dialogue: 0,0:15:27.92,0:15:29.88,Default,,0,0,0,,Торсықта мен алдын ала көрген сызық
Dialogue: 0,0:15:30.63,0:15:33.09,Default,,0,0,0,,Қалқыма жүргізгендей сырғыған ақ жүз
Dialogue: 0,0:15:34.72,0:15:36.56,Default,,0,0,0,,Ішкі мүшелер үзілген
Dialogue: 0,0:15:38.06,0:15:39.98,Default,,0,0,0,,Омыртқа бөлінген
Dialogue: 0,0:15:40.48,0:15:42.77,Default,,0,0,0,,Мен мұның бәрін анық сезіндім.
Dialogue: 0,0:15:42.85,0:15:45.77,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:15:45.86,0:15:47.15,Default,,0,0,0,,(Эзуку дыбысы)
Dialogue: 0,0:15:47.23,0:15:48.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:48.61,0:15:50.53,Default,,0,0,0,,
Dialogue: 0,0:15:51.32,0:15:53.11,Default,,0,0,0,,Қарсыласудан алыс
Dialogue: 0,0:15:53.61,0:15:54.45,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:15:54.45,0:15:55.62,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:15:54.45,0:15:55.62,Default,,0,0,0,,Тіпті тұрудың өзі алыс
Dialogue: 0,0:15:55.62,0:15:58.04,Default,,0,0,0,,Тіпті тұрудың өзі алыс
Dialogue: 0,0:15:59.41,0:16:01.54,Default,,0,0,0,,Үлкен егін!
Dialogue: 0,0:16:02.50,0:16:05.08,Default,,0,0,0,,Келесі жолы...
Dialogue: 0,0:16:11.13,0:16:13.05,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:16:13.63,0:16:14.80,Default,,0,0,0,,Хмм…
Dialogue: 0,0:16:15.89,0:16:19.31,Default,,0,0,0,,ал үшінші және төртінші метакарпальды сүйектері мен саусақ сақина мен ортаңғы саусағымның проксимальды фалангаларында
Dialogue: 0,0:16:20.22,0:16:22.31,Default,,0,0,0,,Ойын бар!
Dialogue: 0,0:16:23.64,0:16:24.81,Default,,0,0,0,,Изуку Мидория…
Dialogue: 0,0:16:27.44,0:16:29.82,Default,,0,0,0,,Тіпті сілекей жұтқан дыбыс
Dialogue: 0,0:16:30.40,0:16:32.32,Default,,0,0,0,,...
Dialogue: 0,0:16:32.40,0:16:35.28,Default,,0,0,0,,Қатты үнсіздік орнады.
Dialogue: 0,0:16:37.12,0:16:38.66,Default,,0,0,0,,Мен ұялдым.
Dialogue: 0,0:16:40.33,0:16:43.33,Default,,0,0,0,,Өмір алмасу орнында болған кезде
Dialogue: 0,0:16:43.41,0:16:47.84,Default,,0,0,0,,Маңызды еместікті қамтамасыз ете алатын осындай өзіндік
Dialogue: 0,0:16:48.59,0:16:49.84,Default,,0,0,0,,(дыбыс жоқ)
Dialogue: 0,0:16:52.80,0:16:54.34,Default,,0,0,0,,Жеңімпаз кім?
Dialogue: 0,0:16:54.43,0:16:55.18,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:55.18,0:16:57.59,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:55.18,0:16:57.59,Default,,0,0,0,,Мақтап, ынталы
Dialogue: 0,0:16:58.18,0:17:03.35,Default,,0,0,0,,Адамдар ағылып, кетуден бас тартатын нәрсе.
Dialogue: 0,0:17:04.85,0:17:06.60,Default,,0,0,0,,Бірақ не?
Dialogue: 0,0:17:07.52,0:17:10.36,Default,,0,0,0,,Еш ойланбаңыз
Dialogue: 0,0:17:11.15,0:17:13.36,Default,,0,0,0,,Және қолдау жоқ
Dialogue: 0,0:17:14.19,0:17:16.11,Default,,0,0,0,,Әлі де
Dialogue: 0,0:17:16.86,0:17:21.33,Default,,0,0,0,,Теңдесі жоқ Миямото Мусаши
Dialogue: 0,0:17:48.10,0:17:49.77,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:17:50.90,0:17:53.78,Default,,0,0,0,,Керемет аяқтар!
Dialogue: 0,0:17:54.78,0:17:58.45,Default,,0,0,0,,Бұл төменгі дене мені қолдады
Dialogue: 0,0:17:59.16,0:18:02.99,Default,,0,0,0,,Сол ғажайып техникалар
Dialogue: 0,0:18:04.37,0:18:07.04,Default,,0,0,0,,Мен барлығынан сұрағым келеді
Dialogue: 0,0:18:12.84,0:18:16.05,Default,,0,0,0,,Мен қателестім бе?
Dialogue: 0,0:18:19.93,0:18:21.30,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:18:21.97,0:18:24.47,Default,,0,0,0,,Хибу қаруын қолдану
Dialogue: 0,0:18:24.56,0:18:27.31,Default,,0,0,0,,Екеуі де Рецудың өзі қалаған нәрсе еді.
Dialogue: 0,0:18:28.77,0:18:29.81,Default,,0,0,0,,Токугава мырза
Dialogue: 0,0:18:29.90,0:18:34.82,Default,,0,0,0,,Егер мен: «Сен қателестің» десем.
Dialogue: 0,0:18:38.53,0:18:43.03,Default,,0,0,0,,Ол секіреді де, мені тістейді.
Dialogue: 0,0:18:44.16,0:18:46.50,Default,,0,0,0,,(жылайды)
Dialogue: 0,0:18:47.37,0:18:50.21,Default,,0,0,0,,Олай болса, айтыңызшы.
Dialogue: 0,0:18:50.71,0:18:53.84,Default,,0,0,0,,Токугава қателескен
Dialogue: 0,0:18:53.92,0:18:56.92,Default,,0,0,0,,(Мицунаридің жылауы жалғасуда)
Dialogue: 0,0:19:16.15,0:19:18.90,Default,,0,0,0,,Айтыңызшы!
Dialogue: 0,0:19:31.50,0:19:34.21,Default,,0,0,0,,(қуат қосқышының дыбысы өшірулі)
Dialogue: 0,0:19:50.64,0:19:55.65,Default,,0,0,0,,♪~
Dialogue: 0,0:21:14.06,0:21:19.06,Default,,0,0,0,,~♪
