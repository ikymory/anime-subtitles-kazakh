Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:41.29,0:00:43.66,Default,,0,0,0,,(Үкідің ұлуы)
Dialogue: 0,0:00:46.67,0:00:48.33,Default,,0,0,0,,(еңот иттің айқайы)
Dialogue: 0,0:01:03.10,0:01:08.61,Default,,0,0,0,,(Жүйе қатесі дыбысы)
Dialogue: 0,0:01:29.33,0:01:32.30,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:01:33.00,0:01:35.38,Default,,0,0,0,,Уау... (Нобита) Осылай...
Dialogue: 0,0:01:35.51,0:01:37.05,Default,,0,0,0,,Егер сіз мұны істесеңіз...
Dialogue: 0,0:01:37.47,0:01:40.35,Default,,0,0,0,,Иә, бұл Фудзи тауы!
Dialogue: 0,0:01:40.47,0:01:43.01,Default,,0,0,0,,Көбелек! (Балалар) Уау!
Dialogue: 0,0:01:43.14,0:01:45.68,Default,,0,0,0,,Жұлдыз! (Балалар) Уау!
Dialogue: 0,0:01:45.81,0:01:48.56,Default,,0,0,0,,Керемет! (Бала) Маған көбірек көрсет.
Dialogue: 0,0:01:48.65,0:01:51.19,Default,,0,0,0,,Хэхе~ Жарайды.
Dialogue: 0,0:01:51.65,0:01:53.23,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:01:53.36,0:01:56.19,Default,,0,0,0,,Уф... мм?
Dialogue: 0,0:01:57.07,0:01:59.82,Default,,0,0,0,,Хмм, 6 баспалдақ!
Dialogue: 0,0:01:59.95,0:02:01.95,Default,,0,0,0,,О, менің...
Dialogue: 0,0:02:02.08,0:02:04.58,Default,,0,0,0,,Ноби-чан Көңілді сияқты (балалар) Иә?
Dialogue: 0,0:02:05.20,0:02:06.70,Default,,0,0,0,,Джан Сунео
Dialogue: 0,0:02:06.83,0:02:10.25,Default,,0,0,0,,Баламен ойнау Нобитаға тән.
Dialogue: 0,0:02:10.38,0:02:11.58,Default,,0,0,0,,Хехехе!
Dialogue: 0,0:02:11.92,0:02:14.84,Default,,0,0,0,,Не! Бұл жерде ештеңе жоқ! иә?
Dialogue: 0,0:02:15.21,0:02:16.51,Default,,0,0,0,,Сізде не бар?
Dialogue: 0,0:02:16.63,0:02:18.93,Default,,0,0,0,,Ах! Ой!
Dialogue: 0,0:02:19.05,0:02:21.09,Default,,0,0,0,,Оның Нобитаға қатысы жоқ.
Dialogue: 0,0:02:21.22,0:02:23.60,Default,,0,0,0,,Нобитаға уайымдама, тез кетейік.
Dialogue: 0,0:02:23.72,0:02:24.85,Default,,0,0,0,,Ой, дұрыс айтасың.
Dialogue: 0,0:02:25.43,0:02:28.48,Default,,0,0,0,,Шынымен, Ноби-чан, бесігіңе сәттілік~
Dialogue: 0,0:02:28.60,0:02:31.77,Default,,0,0,0,,Ахахаха (Нобита) Эй, бұл не?
Dialogue: 0,0:02:31.90,0:02:34.15,Default,,0,0,0,,Кәне, бәріміз, жалғастырайық.
Dialogue: 0,0:02:34.27,0:02:35.28,Default,,0,0,0,,Ах! (Нобита) Уф
Dialogue: 0,0:02:35.40,0:02:37.65,Default,,0,0,0,,Мен ұмытып қалдым! Мен үйге ерте баруым керек
Dialogue: 0,0:02:37.78,0:02:40.95,Default,,0,0,0,,Иә! «Галактика қорғаныс күштерінің» басталатын уақыты келді!
Dialogue: 0,0:02:41.20,0:02:43.20,Default,,0,0,0,,«Галактиканың қорғаныс күштері»! ?
Dialogue: 0,0:02:43.53,0:02:46.41,Default,,0,0,0,,Асығыңыз! (Бала) Күте тұрыңыз!
Dialogue: 0,0:02:46.66,0:02:49.46,Default,,0,0,0,,Ааа... Мен де үйге баруым керек!
Dialogue: 0,0:02:49.83,0:02:51.33,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:02:52.04,0:02:55.09,Default,,0,0,0,,Үлкен аға! Маған тағы да бесік туралы айтып беріңізші!
Dialogue: 0,0:02:56.30,0:02:59.67,Default,,0,0,0,,Иә! Қайта кездескенше! Ааа
Dialogue: 0,0:02:59.80,0:03:02.22,Default,,0,0,0,,Қош бол!
Dialogue: 0,0:03:04.01,0:03:05.22,Default,,0,0,0,,Хехехе
Dialogue: 0,0:03:05.81,0:03:08.02,Default,,0,0,0,,Issoge~!
Dialogue: 0,0:03:08.31,0:03:14.31,Default,,0,0,0,,♪〜
Dialogue: 0,0:04:12.25,0:04:18.25,Default,,0,0,0,,〜♪
Dialogue: 0,0:04:26.64,0:04:30.64,Default,,0,0,0,,(теледидар бағдарламасының дыбысы)
Dialogue: 0,0:04:38.61,0:04:40.65,Default,,0,0,0,,Ой... жоқ!
Dialogue: 0,0:04:40.78,0:04:42.61,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:04:42.74,0:04:45.32,Default,,0,0,0,,(Демекиннің айқайы)
Dialogue: 0,0:04:46.57,0:04:47.95,Default,,0,0,0,,Демекин Осымен!
Dialogue: 0,0:04:48.53,0:04:50.29,Default,,0,0,0,,(Демекин ырылдап)
Dialogue: 0,0:04:51.79,0:04:52.70,Default,,0,0,0,,Таң қалдырыңыз!
Dialogue: 0,0:04:53.71,0:04:54.71,Default,,0,0,0,,Еркелік!
Dialogue: 0,0:04:55.42,0:04:56.71,Default,,0,0,0,,Керемет!
Dialogue: 0,0:04:57.04,0:04:58.96,Default,,0,0,0,,Біз үш батырмыз
Dialogue: 0,0:04:59.59,0:05:01.71,Default,,0,0,0,,Ғажайып Галактика қорғаныс күштері!
Dialogue: 0,0:05:02.05,0:05:03.46,Default,,0,0,0,,Мен көптен күттім!
Dialogue: 0,0:05:06.13,0:05:07.22,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:05:07.39,0:05:08.97,Default,,0,0,0,,(Демекиннің ырылдауы)
Dialogue: 0,0:05:11.06,0:05:11.93,Default,,0,0,0,,Эй!
Dialogue: 0,0:05:12.06,0:05:14.98,Default,,0,0,0,,(Демекиннің ыңырануы)
Dialogue: 0,0:05:15.64,0:05:19.94,Default,,0,0,0,,Хмф! Апыр-ай! Рааа!
Dialogue: 0,0:05:22.78,0:05:25.24,Default,,0,0,0,,Иә! Хехе
Dialogue: 0,0:05:25.45,0:05:26.36,Default,,0,0,0,,Осы аптада да -
Dialogue: 0,0:05:26.36,0:05:26.78,Default,,0,0,0,,Осы аптада да -
Dialogue: 0,0:05:26.36,0:05:26.78,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:05:26.78,0:05:26.90,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:05:26.90,0:05:28.78,Default,,0,0,0,,Бұл тамаша
Dialogue: 0,0:05:26.90,0:05:28.78,Default,,0,0,0,,Галактикадағы тыныштық қамтамасыз етілді
Dialogue: 0,0:05:28.91,0:05:32.12,Default,,0,0,0,,Рахмет сізге Miracle Галактика Defence Force
Dialogue: 0,0:05:28.91,0:05:32.12,Default,,0,0,0,,Мен де осылай батыр болсам ғой~
Dialogue: 0,0:05:32.12,0:05:32.45,Default,,0,0,0,,Мен де осылай батыр болсам ғой~
Dialogue: 0,0:05:34.79,0:05:36.79,Default,,0,0,0,,Иә! Батыр Нови!
Dialogue: 0,0:05:38.04,0:05:38.96,Default,,0,0,0,,Міне, келдік!
Dialogue: 0,0:05:39.08,0:05:41.75,Default,,0,0,0,,Ах! (Батыр Нови) Ммм
Dialogue: 0,0:05:42.55,0:05:47.13,Default,,0,0,0,,(Джионның күлкісі)
Dialogue: 0,0:05:47.26,0:05:51.26,Default,,0,0,0,,Бұл планета Ұлы Ғарыштық Демон Король Гионға берілді!
Dialogue: 0,0:05:51.55,0:05:54.22,Default,,0,0,0,,Ха, бұл Шизука ханшайым!
Dialogue: 0,0:05:54.35,0:05:56.23,Default,,0,0,0,,Өзіңді қолыңа ал.
Dialogue: 0,0:05:58.02,0:05:59.27,Default,,0,0,0,,Және...
Dialogue: 0,0:05:59.40,0:06:01.27,Default,,0,0,0,,Дорасия ханшайымы...
Dialogue: 0,0:06:01.69,0:06:03.19,Default,,0,0,0,,Ухх...
Dialogue: 0,0:06:03.32,0:06:04.78,Default,,0,0,0,,Шизука ханшайымын жіберіңіз!
Dialogue: 0,0:06:04.90,0:06:06.65,Default,,0,0,0,,Мм (ханшайым Шизука) Батыр Нови!
Dialogue: 0,0:06:07.07,0:06:09.91,Default,,0,0,0,,Мен Нобита болсам да... Жылан!
Dialogue: 0,0:06:10.53,0:06:12.95,Default,,0,0,0,,Омакасе Нюро~
Dialogue: 0,0:06:13.08,0:06:14.91,Default,,0,0,0,,Қабыл ал! (Жылан) Ой~!
Dialogue: 0,0:06:15.12,0:06:17.75,Default,,0,0,0,,Не! Уф... (Батыр Ноби) Уф!
Dialogue: 0,0:06:17.87,0:06:20.00,Default,,0,0,0,,Уау...
Dialogue: 0,0:06:20.12,0:06:23.25,Default,,0,0,0,,Hero Novi үшін сәйкестік жоқ...
Dialogue: 0,0:06:23.38,0:06:24.63,Default,,0,0,0,,Аһ!
Dialogue: 0,0:06:26.46,0:06:28.30,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:06:28.42,0:06:31.14,Default,,0,0,0,,Керемет батыр Нови! Чутт
Dialogue: 0,0:06:31.26,0:06:34.51,Default,,0,0,0,,Эхехе дехехе... Жоқ, жақсы.
Dialogue: 0,0:06:34.64,0:06:36.02,Default,,0,0,0,,Чу~ (Нови қаһарман) Өйткені—
Dialogue: 0,0:06:36.14,0:06:38.27,Default,,0,0,0,,Батырлар керемет, хехехе...
Dialogue: 0,0:06:38.39,0:06:39.52,Default,,0,0,0,,Ноби-чан
Dialogue: 0,0:06:39.64,0:06:41.48,Default,,0,0,0,,Ноби-чан!
Dialogue: 0,0:06:41.60,0:06:42.56,Default,,0,0,0,,Нобита! (Нобита) Иә?
Dialogue: 0,0:06:43.27,0:06:44.82,Default,,0,0,0,,Кетіңіз.
Dialogue: 0,0:06:44.94,0:06:46.40,Default,,0,0,0,,Көргіңіз келетін фильм басталады.
Dialogue: 0,0:06:46.53,0:06:48.03,Default,,0,0,0,,Иә
Dialogue: 0,0:06:48.49,0:06:50.49,Default,,0,0,0,,Фильмдер.
Dialogue: 0,0:06:51.66,0:06:52.99,Default,,0,0,0,,«Мерекелік фильм» уақыты
Dialogue: 0,0:06:53.12,0:06:55.49,Default,,0,0,0,,Фильм? иә?
Dialogue: 0,0:06:57.08,0:06:58.58,Default,,0,0,0,,Фильмдер!
Dialogue: 0,0:06:59.58,0:07:01.58,Default,,0,0,0,,Бұл фильм! Боу!
Dialogue: 0,0:07:01.83,0:07:03.08,Default,,0,0,0,,Иә
Dialogue: 0,0:07:03.21,0:07:04.59,Default,,0,0,0,,Мен мұны білемін!
Dialogue: 0,0:07:06.05,0:07:08.09,Default,,0,0,0,,Мен біраз уақытқа шығамын!
Dialogue: 0,0:07:10.05,0:07:11.93,Default,,0,0,0,,Сіз не үшін барасыз?
Dialogue: 0,0:07:12.05,0:07:13.43,Default,,0,0,0,,Батыр бол!
Dialogue: 0,0:07:13.55,0:07:15.10,Default,,0,0,0,,Көліктерге сақ болыңыз
Dialogue: 0,0:07:15.22,0:07:16.68,Default,,0,0,0,,Олар үшін де тойып жеңіздер
Dialogue: 0,0:07:18.85,0:07:19.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:21.52,0:07:22.73,Default,,0,0,0,,Батыр?
Dialogue: 0,0:07:24.31,0:07:27.40,Default,,0,0,0,,үшінмыз кейіпкерлер фильмін түсіруіміз керек!
Dialogue: 0,0:07:27.98,0:07:30.78,Default,,0,0,0,,Алдымен Шизука-чанмен сөйлесейік!
Dialogue: 0,0:07:32.95,0:07:34.62,Default,,0,0,0,,Джианның ішінде ме?
Dialogue: 0,0:07:36.03,0:07:38.37,Default,,0,0,0,,Е, екеуің Сунеоның үйіндесіңдер ме?
Dialogue: 0,0:07:39.87,0:07:41.37,Default,,0,0,0,,Артқы тауға үшеуміз барамыз! ?
Dialogue: 0,0:07:54.97,0:07:57.97,Default,,0,0,0,,үшін осындай жерде не істеп жүр?
Dialogue: 0,0:07:59.22,0:08:01.85,Default,,0,0,0,,Ғарыш монстры Міне! (Нобита) Иә?
Dialogue: 0,0:08:03.85,0:08:05.86,Default,,0,0,0,,Хмм... Иә?
Dialogue: 0,0:08:09.28,0:08:11.11,Default,,0,0,0,,Мен саған қалағаныңды істеуге рұқсат бермеймін!
Dialogue: 0,0:08:11.65,0:08:14.66,Default,,0,0,0,,Хмф! Әлемнің тыныштығын қорғау үшін
Dialogue: 0,0:08:14.78,0:08:17.24,Default,,0,0,0,,Жаман жігіттер мета-мета!
Dialogue: 0,0:08:17.37,0:08:19.37,Default,,0,0,0,,Біз үш батырмыз!
Dialogue: 0,0:08:19.49,0:08:21.79,Default,,0,0,0,,Ғажайып Галактика қорғаныс күштері! (Нобита) Ғажайып Галактика қорғаныс күштері!
Dialogue: 0,0:08:21.91,0:08:23.16,Default,,0,0,0,,О? (Нобита) Няха~!
Dialogue: 0,0:08:23.29,0:08:25.33,Default,,0,0,0,,Ах... (Джан Сунео) Нобита!
Dialogue: 0,0:08:25.46,0:08:27.08,Default,,0,0,0,,...
Dialogue: 0,0:08:27.21,0:08:30.63,Default,,0,0,0,,Әй, өте жақсы жер еді...
Dialogue: 0,0:08:30.92,0:08:33.38,Default,,0,0,0,,Эй, эй, сен не істеп жатырсың?
Dialogue: 0,0:08:33.51,0:08:35.76,Default,,0,0,0,,Хмм, оны көргенде түсінесің!
Dialogue: 0,0:08:36.01,0:08:38.01,Default,,0,0,0,,Кейіпкер фильмін түсіру!
Dialogue: 0,0:08:38.51,0:08:41.68,Default,,0,0,0,,Иә? Батыр фильмі? Иә...
Dialogue: 0,0:08:41.81,0:08:44.85,Default,,0,0,0,,Әкем маған кәсіби фотоаппарат сатып берді, сондықтан...
Dialogue: 0,0:08:44.98,0:08:49.02,Default,,0,0,0,,Мен ең керемет кейіпкер туралы фильм түсіргім келді.
Dialogue: 0,0:08:49.48,0:08:52.24,Default,,0,0,0,,Бұл қорқынышты! Маған айтпай-ақ жасадың!
Dialogue: 0,0:08:52.36,0:08:54.90,Default,,0,0,0,,Эй, Нобита-сан, бізге де қосыл.
Dialogue: 0,0:08:55.03,0:08:58.62,Default,,0,0,0,,Хмм, өйткені Нобита батырға ұқсамайды.
Dialogue: 0,0:08:58.74,0:09:01.79,Default,,0,0,0,,Нобита келгенде фильм арзанға түседі.
Dialogue: 0,0:09:01.99,0:09:04.41,Default,,0,0,0,,Олай айтпа...
Dialogue: 0,0:09:04.54,0:09:06.75,Default,,0,0,0,,Иә! Бәріміз бірге жасайық
Dialogue: 0,0:09:06.87,0:09:08.50,Default,,0,0,0,,Хмм (Сунео) Ммм.
Dialogue: 0,0:09:08.63,0:09:10.80,Default,,0,0,0,,Біз не істейміз? Сунео
Dialogue: 0,0:09:11.09,0:09:12.30,Default,,0,0,0,,Аа, дұрыс!
Dialogue: 0,0:09:13.09,0:09:14.97,Default,,0,0,0,,Нобита тамаша рөлге ие.
Dialogue: 0,0:09:15.09,0:09:16.93,Default,,0,0,0,,Шынымен бе? (Сунео) Хехе...
Dialogue: 0,0:09:18.05,0:09:19.68,Default,,0,0,0,,Гяо!
Dialogue: 0,0:09:20.01,0:09:22.93,Default,,0,0,0,,Гяо! Джао!
Dialogue: 0,0:09:23.43,0:09:25.52,Default,,0,0,0,,Ғарыш құбыжығы Нобигон!
Dialogue: 0,0:09:25.64,0:09:27.44,Default,,0,0,0,,Нии, дайындал!
Dialogue: 0,0:09:27.73,0:09:29.23,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:09:29.36,0:09:30.69,Default,,0,0,0,,Арнайы алып -
Dialogue: 0,0:09:30.82,0:09:32.28,Default,,0,0,0,,Жақсы лақтыру! (Нобита) Уау!
Dialogue: 0,0:09:32.40,0:09:33.78,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:33.90,0:09:35.65,Default,,0,0,0,,Баршаңыз да сапарыңызды жалғастырғанда абай болыңыздар
Dialogue: 0,0:09:36.78,0:09:40.20,Default,,0,0,0,,Нухахаха... Ухаха!
Dialogue: 0,0:09:40.32,0:09:42.45,Default,,0,0,0,,Сіз білесіз бе? Новигон
Dialogue: 0,0:09:42.66,0:09:45.58,Default,,0,0,0,,Ой... Жаса...
Dialogue: 0,0:09:46.08,0:09:50.21,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:09:52.63,0:09:55.55,Default,,0,0,0,,Ммм, кеттік! Тоттотто...
Dialogue: 0,0:09:55.67,0:09:58.05,Default,,0,0,0,,Уф, Дораемон! Гайя!
Dialogue: 0,0:09:58.18,0:10:00.14,Default,,0,0,0,,Гах... Не? Не?
Dialogue: 0,0:10:00.26,0:10:02.43,Default,,0,0,0,,Нобигон!
Dialogue: 0,0:10:02.56,0:10:04.68,Default,,0,0,0,,Уау! Жоқ...
Dialogue: 0,0:10:04.81,0:10:06.98,Default,,0,0,0,,Хмм, сәттілік...
Dialogue: 0,0:10:07.10,0:10:10.35,Default,,0,0,0,,Мен де батыр болғым келеді!
Dialogue: 0,0:10:10.48,0:10:11.31,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:10:12.06,0:10:14.32,Default,,0,0,0,,Не! «Галактика қорғаныс күштері» фильмі—
Dialogue: 0,0:10:14.44,0:10:15.86,Default,,0,0,0,,Сунео және басқалар! ?
Dialogue: 0,0:10:15.99,0:10:19.11,Default,,0,0,0,,Кеттік! Қазір барайық! Мен де пайда боламын
Dialogue: 0,0:10:19.24,0:10:22.03,Default,,0,0,0,,Мен «Miracle Галактика Defence Force» жанкүйерімін!
Dialogue: 0,0:10:22.16,0:10:26.00,Default,,0,0,0,,Күте тұрыңыз! Өте ыстық!
Dialogue: 0,0:10:26.25,0:10:29.12,Default,,0,0,0,,Біз өзіміз ғана тамаша кейіпкер фильмін түсірдік.
Dialogue: 0,0:10:29.25,0:10:31.75,Default,,0,0,0,,"Гахун" деп айтқым келеді
Dialogue: 0,0:10:31.92,0:10:35.00,Default,,0,0,0,,Мұндай бас мынадай болуы мүмкін!
Dialogue: 0,0:10:35.42,0:10:38.30,Default,,0,0,0,,Аа, бірақ бәріміз бірге жасасақ жақсы.
Dialogue: 0,0:10:38.42,0:10:40.97,Default,,0,0,0,,Менің ойымша, біз тамаша фильм түсіре аламыз.
Dialogue: 0,0:10:41.09,0:10:43.01,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:10:43.14,0:10:45.01,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:10:45.31,0:10:46.60,Default,,0,0,0,,Жүр, асығайық!
Dialogue: 0,0:10:46.72,0:10:49.69,Default,,0,0,0,,О, күте тұрыңыз!
Dialogue: 0,0:10:56.53,0:11:01.49,Default,,0,0,0,,Джан Мегатонк!
Dialogue: 0,0:11:02.62,0:11:05.24,Default,,0,0,0,,Сіз білесіз бе? Ғарыш құбыжығы!
Dialogue: 0,0:11:05.37,0:11:08.95,Default,,0,0,0,,Джан-самаға қарсы шығуға әлі 100 миллион жыл ерте!
Dialogue: 0,0:11:09.08,0:11:11.79,Default,,0,0,0,,Бухахаха!
Dialogue: 0,0:11:11.92,0:11:14.50,Default,,0,0,0,,Ааа
Dialogue: 0,0:11:14.63,0:11:17.63,Default,,0,0,0,,Еңбегіңіз үшін рахмет. Ерен еңбегіңіз үшін рахмет. (Сунео) Иә?
Dialogue: 0,0:11:18.30,0:11:20.38,Default,,0,0,0,,Фотосурет жақсы жүріп жатқан сияқты.
Dialogue: 0,0:11:20.51,0:11:22.39,Default,,0,0,0,,Дораэмон жасаңыз!
Dialogue: 0,0:11:22.64,0:11:26.47,Default,,0,0,0,,Дегенмен, бұл соншалықты әсерлі емес сияқты.
Dialogue: 0,0:11:26.60,0:11:28.39,Default,,0,0,0,,Иә, иә, не!
Dialogue: 0,0:11:28.97,0:11:29.81,Default,,0,0,0,,Нобита!
Dialogue: 0,0:11:29.93,0:11:32.06,Default,,0,0,0,,Сен мені Дораемонмен мазалауға келдің бе?
Dialogue: 0,0:11:32.19,0:11:34.02,Default,,0,0,0,,Бұл емес!
Dialogue: 0,0:11:34.15,0:11:38.90,Default,,0,0,0,,Егер сіз бәрібір түсіретін болсаңыз, бұл одан да жақсы фильм болады деп үміттенемін.
Dialogue: 0,0:11:39.03,0:11:41.40,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:11:42.45,0:11:45.28,Default,,0,0,0,,Жарықты бағалаңыз!
Dialogue: 0,0:11:45.66,0:11:47.16,Default,,0,0,0,,Иә? (Нобита) Жаңарту керек пе?
Dialogue: 0,0:11:47.28,0:11:51.29,Default,,0,0,0,,Осы нұрға бөленетін кез келген нәрсе шындыққа айналады.
Dialogue: 0,0:11:51.79,0:11:55.63,Default,,0,0,0,,Мысалы, егер сіз Шидзука-чан киген батыр костюмін ұрсаңыз...
Dialogue: 0,0:11:55.71,0:11:56.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:57.21,0:11:58.21,Default,,0,0,0,,Хой
Dialogue: 0,0:12:01.88,0:12:03.59,Default,,0,0,0,,Охх...
Dialogue: 0,0:12:12.06,0:12:13.56,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:12:19.94,0:12:22.74,Default,,0,0,0,,Иә? Бірдеңе өзгерді ме?
Dialogue: 0,0:12:22.86,0:12:24.28,Default,,0,0,0,,Аздап секіруге тырысыңыз.
Dialogue: 0,0:12:25.24,0:12:26.49,Default,,0,0,0,,Секіру?
Dialogue: 0,0:12:29.49,0:12:31.75,Default,,0,0,0,,Денем әйтеуір жеңілдеп қалды.
Dialogue: 0,0:12:31.87,0:12:33.79,Default,,0,0,0,,Осы жолы барынша тырысыңыз
Dialogue: 0,0:12:34.17,0:12:36.00,Default,,0,0,0,,Иә? Ммм!
Dialogue: 0,0:12:36.13,0:12:37.46,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:12:38.09,0:12:39.30,Default,,0,0,0,,Уау...
Dialogue: 0,0:12:40.38,0:12:41.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:41.96,0:12:43.42,Default,,0,0,0,,Ол ұшып бара жатты
Dialogue: 0,0:12:44.38,0:12:45.63,Default,,0,0,0,,Уау! Жақсы-
Dialogue: 0,0:12:45.76,0:12:48.55,Default,,0,0,0,,Аспанда еркін ұша алмасам да
Dialogue: 0,0:12:52.39,0:12:54.14,Default,,0,0,0,,А, мен таң қалдым!
Dialogue: 0,0:12:54.27,0:12:55.73,Default,,0,0,0,,Бұл керемет, Шизука-чан
Dialogue: 0,0:12:55.85,0:12:57.35,Default,,0,0,0,,Не болып жатыр? Мынау
Dialogue: 0,0:12:57.48,0:12:59.65,Default,,0,0,0,,Маған жақсылап көрсет! Эххехе...
Dialogue: 0,0:12:59.77,0:13:00.73,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:01.53,0:13:03.11,Default,,0,0,0,,Шизука-чан, ана жақтағы жартас...
Dialogue: 0,0:13:03.24,0:13:05.45,Default,,0,0,0,,Оны көтеріңіз, жарай ма?
Dialogue: 0,0:13:07.91,0:13:09.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:09.95,0:13:12.50,Default,,0,0,0,,Осындай үлкен жартас па?
Dialogue: 0,0:13:12.79,0:13:14.91,Default,,0,0,0,,Мен қызбын
Dialogue: 0,0:13:15.04,0:13:16.92,Default,,0,0,0,,Хмм... (Сунео және т.б.) Уау!
Dialogue: 0,0:13:17.04,0:13:20.25,Default,,0,0,0,,Эх (Нобита) Шизука-чан өте күшті!
Dialogue: 0,0:13:20.38,0:13:23.30,Default,,0,0,0,,Жоқ, бұл дұрыс емес! Бұл құралдың кінәсі!
Dialogue: 0,0:13:23.42,0:13:27.43,Default,,0,0,0,,Я, мен қазір қарапайым адамнан 50 есе көп қуат өндіре аламын.
Dialogue: 0,0:13:27.55,0:13:30.26,Default,,0,0,0,,Қазірдің өзінде! Апыр-ай!
Dialogue: 0,0:13:30.39,0:13:31.22,Default,,0,0,0,,Хмф!
Dialogue: 0,0:13:31.51,0:13:34.73,Default,,0,0,0,,Ой... Ой.
Dialogue: 0,0:13:35.06,0:13:36.48,Default,,0,0,0,,Иә және...
Dialogue: 0,0:13:40.81,0:13:42.73,Default,,0,0,0,,О, бірдеңе дәмді көрінеді!
Dialogue: 0,0:13:43.23,0:13:45.74,Default,,0,0,0,,Ой... а, оны жеме.
Dialogue: 0,0:13:45.86,0:13:49.11,Default,,0,0,0,,А? (Директор Бергер) Упип
Dialogue: 0,0:13:49.37,0:13:50.37,Default,,0,0,0,,<Қабылдау хатын алғаннан кейінгі кеш>
Dialogue: 0,0:13:51.62,0:13:54.37,Default,,0,0,0,,Режиссер Рободан режиссер Бургер.
Dialogue: 0,0:13:54.50,0:13:56.50,Default,,0,0,0,,Өйткені, бұл дәмді атау.
Dialogue: 0,0:13:56.62,0:13:57.83,Default,,0,0,0,,Upip
Dialogue: 0,0:13:57.96,0:13:59.83,Default,,0,0,0,,Упип (Нобита) Айта...
Dialogue: 0,0:14:00.92,0:14:03.05,Default,,0,0,0,,Ухи... (Бургер директоры) Упип.
Dialogue: 0,0:14:04.84,0:14:08.34,Default,,0,0,0,,Режиссер қиын, сондықтан ашуланбаңыз.
Dialogue: 0,0:14:08.47,0:14:09.80,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:14:15.18,0:14:19.40,Default,,0,0,0,,Осы режиссер Бергерге түсіргіңіз келетін фильмнің атауын айтқанда, ол...
Dialogue: 0,0:14:19.52,0:14:23.82,Default,,0,0,0,,Олар қажетті топтамалар мен кейіпкерлерді дайындайды.
Dialogue: 0,0:14:23.94,0:14:27.24,Default,,0,0,0,,үшінның соған сәйкес әрекет етуі ғана қалды...
Dialogue: 0,0:14:27.36,0:14:30.32,Default,,0,0,0,,Режиссер оны фильмге түсіреді.
Dialogue: 0,0:14:30.74,0:14:32.83,Default,,0,0,0,,Хмм, камера ше?
Dialogue: 0,0:14:33.20,0:14:34.74,Default,,0,0,0,,Директор
Dialogue: 0,0:14:36.79,0:14:37.75,Default,,0,0,0,,Дыбыстық сигнал
Dialogue: 0,0:14:41.17,0:14:43.59,Default,,0,0,0,,А? Ааа...
Dialogue: 0,0:14:44.09,0:14:46.42,Default,,0,0,0,,Иә? (Нобита) А?
Dialogue: 0,0:14:47.76,0:14:48.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:53.68,0:14:55.81,Default,,0,0,0,,Ультра ықшам камера
Dialogue: 0,0:14:55.93,0:14:58.64,Default,,0,0,0,,Бұл әрқашан суретке түсіру.
Dialogue: 0,0:14:59.10,0:15:00.39,Default,,0,0,0,,Күрсін... Сонымен...
Dialogue: 0,0:15:00.52,0:15:03.36,Default,,0,0,0,,Керемет фильм түсіре алмайтыныңызға сенімдісіз бе?
Dialogue: 0,0:15:03.90,0:15:07.11,Default,,0,0,0,,Ал, жасап көрейік...
Dialogue: 0,0:15:07.40,0:15:08.69,Default,,0,0,0,,Тақырып...
Dialogue: 0,0:15:08.82,0:15:11.11,Default,,0,0,0,,Новигон Джанға қарсы! Аа, әрине!
Dialogue: 0,0:15:13.28,0:15:15.12,Default,,0,0,0,,Сәлем! Не?
Dialogue: 0,0:15:17.49,0:15:20.62,Default,,0,0,0,,Иә? Ах (директор Бергер) Упи!
Dialogue: 0,0:15:21.87,0:15:24.13,Default,,0,0,0,,Пипипипипи (Нобита және оның достары) Ах!
Dialogue: 0,0:15:29.09,0:15:31.76,Default,,0,0,0,,Бұл виртуалды бейне кеңістігі.
Dialogue: 0,0:15:32.09,0:15:34.64,Default,,0,0,0,,Дыбыстық сигнал
Dialogue: 0,0:15:38.35,0:15:40.77,Default,,0,0,0,,Түсірілім басталады! (Директор Бергер) Упип
Dialogue: 0,0:15:41.19,0:15:44.27,Default,,0,0,0,,Бұл басталды ма? Гуаааа!
Dialogue: 0,0:15:44.52,0:15:46.23,Default,,0,0,0,,Иә? О!
Dialogue: 0,0:15:46.36,0:15:47.61,Default,,0,0,0,,О!
Dialogue: 0,0:15:48.03,0:15:49.07,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:52.28,0:15:55.62,Default,,0,0,0,,(Нобитаның үрейленген дауысы)
Dialogue: 0,0:15:55.95,0:15:57.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:57.79,0:15:59.58,Default,,0,0,0,,Гах! О...
Dialogue: 0,0:16:00.37,0:16:01.50,Default,,0,0,0,,Ең алдымен, сен—
Dialogue: 0,0:16:01.62,0:16:03.08,Default,,0,0,0,,Өздігінен шықты!
Dialogue: 0,0:16:03.21,0:16:05.00,Default,,0,0,0,,Уау! (Нобита) Гао!
Dialogue: 0,0:16:05.25,0:16:07.04,Default,,0,0,0,,Уау! Нобита, тоқта!
Dialogue: 0,0:16:07.17,0:16:09.55,Default,,0,0,0,,Бұл тоқтамайды! Соқса да -
Dialogue: 0,0:16:09.67,0:16:12.34,Default,,0,0,0,,Жарайды, себебі сізге зиян тигізбейді.
Dialogue: 0,0:16:12.47,0:16:14.89,Default,,0,0,0,,Тоқта! Уау...
Dialogue: 0,0:16:17.05,0:16:19.18,Default,,0,0,0,,Джан! Такеши мырза!
Dialogue: 0,0:16:20.14,0:16:22.73,Default,,0,0,0,,Гяох фухахаха гяо гяо
Dialogue: 0,0:16:22.85,0:16:25.31,Default,,0,0,0,,Бұл ештеңе емес, бұл өтірік оты.
Dialogue: 0,0:16:25.65,0:16:28.82,Default,,0,0,0,,Түсіндім...
Dialogue: 0,0:16:29.07,0:16:30.94,Default,,0,0,0,,Нобита~! (Нобита) Гах!
Dialogue: 0,0:16:31.07,0:16:33.32,Default,,0,0,0,,Дайын болыңыз!
Dialogue: 0,0:16:33.82,0:16:35.78,Default,,0,0,0,,Ұлы гигант арнайы -
Dialogue: 0,0:16:35.91,0:16:38.83,Default,,0,0,0,,Жақсы лақтыру! (Нобита) Гяаааа
Dialogue: 0,0:16:38.95,0:16:40.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:40.24,0:16:41.58,Default,,0,0,0,,Гахун…
Dialogue: 0,0:16:42.91,0:16:45.58,Default,,0,0,0,,Хмф, әділдік жеңеді!
Dialogue: 0,0:16:46.54,0:16:48.71,Default,,0,0,0,,Иә кесілді! (Директор Бергер) Упип
Dialogue: 0,0:16:48.84,0:16:51.51,Default,,0,0,0,,Ваа Дораемон!
Dialogue: 0,0:16:51.63,0:16:54.26,Default,,0,0,0,,Бірге кино түсірейік!
Dialogue: 0,0:16:54.93,0:16:57.85,Default,,0,0,0,,Біз ынтымақтастыққа қуаныштымыз
Dialogue: 0,0:16:58.43,0:17:01.43,Default,,0,0,0,,О! Сіз маған дос ретінде қосыла аласыз.
Dialogue: 0,0:17:01.56,0:17:05.69,Default,,0,0,0,,Дегенмен, егер сіз Нобита-кун екеумізді кейіпкер ретінде ойнасаңыз...
Dialogue: 0,0:17:05.81,0:17:07.06,Default,,0,0,0,,Ынтымақтастық жасайық
Dialogue: 0,0:17:07.19,0:17:09.61,Default,,0,0,0,,Иә! Мен құбыжық ойнамаймын.
Dialogue: 0,0:17:09.73,0:17:11.11,Default,,0,0,0,,Мока Нобита
Dialogue: 0,0:17:11.73,0:17:14.99,Default,,0,0,0,,Бұл жағдайда бізде басқа амал жоқ.
Dialogue: 0,0:17:15.24,0:17:17.82,Default,,0,0,0,,Иә! Сіз батыр бола аласыз!
Dialogue: 0,0:17:17.95,0:17:19.53,Default,,0,0,0,,Саған жақсы, Нобита-сан.
Dialogue: 0,0:17:19.66,0:17:20.62,Default,,0,0,0,,Мурата мырза!
Dialogue: 0,0:17:20.74,0:17:22.87,Default,,0,0,0,,Не? Ол әлі де бар!
Dialogue: 0,0:17:23.83,0:17:28.04,Default,,0,0,0,,Мен Галактикалық қорғаныс күштерінің жетекшісі боламын.
Dialogue: 0,0:17:28.17,0:17:30.54,Default,,0,0,0,,Бұл мен мүлдем ымыраға келмейтін нәрсе!
Dialogue: 0,0:17:30.67,0:17:33.88,Default,,0,0,0,,Не! Мен көшбасшымын деп ойлаймын!
Dialogue: 0,0:17:34.01,0:17:36.22,Default,,0,0,0,,Егер солай болса, мен сізге құралдарды бермеймін!
Dialogue: 0,0:17:36.34,0:17:40.14,Default,,0,0,0,,(Екі адам еңіреп)
Dialogue: 0,0:17:40.26,0:17:42.97,Default,,0,0,0,,Джан мен көмектесе алмаймын.
Dialogue: 0,0:17:43.35,0:17:45.35,Default,,0,0,0,,Нюрон
Dialogue: 0,0:17:45.60,0:17:48.60,Default,,0,0,0,,Директордан Джанды көшбасшы етуді сұраңыз.
Dialogue: 0,0:17:48.73,0:17:50.86,Default,,0,0,0,,Оны кейінірек өңдеуге болады.
Dialogue: 0,0:17:50.98,0:17:53.40,Default,,0,0,0,,Ах! (Сунео) Гуфуфуфу
Dialogue: 0,0:17:53.53,0:17:55.36,Default,,0,0,0,,Нихи хи
Dialogue: 0,0:17:56.07,0:18:00.12,Default,,0,0,0,,Менде көшбасшы рөлін Дораэмонға тапсырудан басқа амалым жоқ.
Dialogue: 0,0:18:00.24,0:18:01.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:01.66,0:18:03.20,Default,,0,0,0,,Иә! Хехе
Dialogue: 0,0:18:03.33,0:18:05.62,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:18:05.75,0:18:07.04,Default,,0,0,0,,Нобита-кун!
Dialogue: 0,0:18:07.16,0:18:12.04,Default,,0,0,0,,Сізге жақсы, Дораемон. Жарайды, керемет кейіпкердің рөлін ойнаңыз ...
Dialogue: 0,0:18:12.17,0:18:13.92,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:18:14.05,0:18:17.30,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе, Нобита!
Dialogue: 0,0:18:17.42,0:18:19.38,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:18:20.26,0:18:23.35,Default,,0,0,0,,Қалай болғанда да, оны ең жақсы кейіпкер фильміне айналдырайық!
Dialogue: 0,0:18:23.47,0:18:26.39,Default,,0,0,0,,О! (Директор Бергер) Юпи
Dialogue: 0,0:18:26.73,0:18:29.52,Default,,0,0,0,,Енді дайындалайық!
Dialogue: 0,0:18:29.65,0:18:31.15,Default,,0,0,0,,Оу!
Dialogue: 0,0:18:31.27,0:18:35.40,Default,,0,0,0,,(үшінның сөйлейтін дыбысы)
Dialogue: 0,0:19:12.77,0:19:14.27,Default,,0,0,0,,Мен суретке түсемін
Dialogue: 0,0:19:16.02,0:19:18.03,Default,,0,0,0,,Хмф!
Dialogue: 0,0:19:19.99,0:19:20.99,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:19:21.28,0:19:23.95,Default,,0,0,0,,Иә! сәуле!
Dialogue: 0,0:19:28.20,0:19:31.46,Default,,0,0,0,,О! Ахаха
Dialogue: 0,0:19:35.09,0:19:37.21,Default,,0,0,0,,Тақырып шешілді!
Dialogue: 0,0:19:38.01,0:19:40.72,Default,,0,0,0,,«Ғажайып қаһарман Галактикалық қорғаныс күштері»
Dialogue: 0,0:19:43.51,0:19:44.72,Default,,0,0,0,,Уппи (Сунео)...
Dialogue: 0,0:19:45.05,0:19:46.39,Default,,0,0,0,,Иә? не болды?
Dialogue: 0,0:19:46.51,0:19:48.35,Default,,0,0,0,,...
Dialogue: 0,0:19:48.47,0:19:53.31,Default,,0,0,0,,Мен мұндай ақымақ фильмнен гөрі көркем әрі әсерлі фильм түсіргенді ұнатамын.
Dialogue: 0,0:19:53.44,0:19:55.23,Default,,0,0,0,,Е! (Бургер директоры) Уппи Уппи
Dialogue: 0,0:19:55.61,0:19:57.48,Default,,0,0,0,,Сіз қазір не туралы айтып отырсыз?
Dialogue: 0,0:19:57.94,0:20:00.24,Default,,0,0,0,,Дораемон әдетте мынаны шығарады...
Dialogue: 0,0:20:00.36,0:20:03.70,Default,,0,0,0,,Төтенше жағдайда жарамсыз болып қалған ақаулы өнімдерге толы!
Dialogue: 0,0:20:03.82,0:20:05.95,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:06.28,0:20:07.66,Default,,0,0,0,,Упип (Сунео) Ах!
Dialogue: 0,0:20:07.78,0:20:09.20,Default,,0,0,0,,Упит
Dialogue: 0,0:20:09.33,0:20:11.21,Default,,0,0,0,,Ах... Жақсы!
Dialogue: 0,0:20:11.79,0:20:13.67,Default,,0,0,0,,Келіңіздер (Нобита) Келіңіздер...
Dialogue: 0,0:20:13.79,0:20:15.13,Default,,0,0,0,,Ара!
Dialogue: 0,0:20:15.25,0:20:18.30,Default,,0,0,0,,Неге мен де? (Режиссер Бергер) Пи? Пипи~
Dialogue: 0,0:20:18.42,0:20:19.88,Default,,0,0,0,,Бургер-чан беріңізші
Dialogue: 0,0:20:20.01,0:20:23.55,Default,,0,0,0,,Екеуміз бірге кейіпкер фильмін түсіреміз бе? Эй
Dialogue: 0,0:20:23.97,0:20:26.22,Default,,0,0,0,,Пипи~
Dialogue: 0,0:20:26.35,0:20:27.35,Default,,0,0,0,,А...
Dialogue: 0,0:20:28.93,0:20:31.31,Default,,0,0,0,,Қыздың айтқанын тыңда, солай ма?
Dialogue: 0,0:20:31.43,0:20:33.14,Default,,0,0,0,,Мен кенет толқыдым.
Dialogue: 0,0:20:33.27,0:20:35.02,Default,,0,0,0,,Гамбургерге ұқсаса да
Dialogue: 0,0:20:35.15,0:20:38.02,Default,,0,0,0,,Тыныш! Өйткені мен мұны істеуге шынымен мотивация алдым.
Dialogue: 0,0:20:38.15,0:20:39.11,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:41.90,0:20:42.95,Default,,0,0,0,,Дыбыстық сигнал!
Dialogue: 0,0:20:46.49,0:20:47.62,Default,,0,0,0,,Уупипипипи!
Dialogue: 0,0:20:56.50,0:20:58.63,Default,,0,0,0,,Иә? Апыр-ай!
Dialogue: 0,0:20:58.75,0:21:00.09,Default,,0,0,0,,Міне! Міне осы!
Dialogue: 0,0:21:00.21,0:21:01.30,Default,,0,0,0,,Мен мұны күттім.
Dialogue: 0,0:21:01.63,0:21:05.34,Default,,0,0,0,,Бірақ мен оның түсіріліп жатқанын білсем де, қорқынышты.
Dialogue: 0,0:21:05.47,0:21:07.72,Default,,0,0,0,,Қазірдің өзінде! Сіз батыр боласыз, солай ма?
Dialogue: 0,0:21:07.84,0:21:09.30,Default,,0,0,0,,Әрине!
Dialogue: 0,0:21:09.43,0:21:11.85,Default,,0,0,0,,Мен саған өзімнің салқын қырымды көрсетемін.
Dialogue: 0,0:21:11.97,0:21:13.81,Default,,0,0,0,,Мен де! Мен де!
Dialogue: 0,0:21:14.14,0:21:16.69,Default,,0,0,0,,Дыбыстық сигнал! Upip
Dialogue: 0,0:21:21.48,0:21:22.73,Default,,0,0,0,,Upip
Dialogue: 0,0:21:28.20,0:21:34.20,Default,,0,0,0,,(Ғарыш құбыжықтың гүрілдеген дауысы)
Dialogue: 0,0:21:34.58,0:21:35.62,Default,,0,0,0,,Тыңдаңдар, балалар!
Dialogue: 0,0:21:36.00,0:21:39.63,Default,,0,0,0,,Жау – жауыз ғарыштық құбыжық. Ешқашан сақтығыңызды төмендетпеңіз!
Dialogue: 0,0:21:39.96,0:21:44.67,Default,,0,0,0,,Галактикадағы тыныштықты біздің жылдам және сабырлы әрекеттеріміз сақтауға болады.
Dialogue: 0,0:21:44.80,0:21:46.30,Default,,0,0,0,,Ал болашаққа...
Dialogue: 0,0:21:46.43,0:21:48.51,Default,,0,0,0,,Жарайды, тез ұрысайық!
Dialogue: 0,0:21:48.64,0:21:51.14,Default,,0,0,0,,Уау, бұл жақсы жол!
Dialogue: 0,0:21:51.47,0:21:53.10,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:21:53.52,0:21:54.81,Default,,0,0,0,,Енді күтпеңіз!
Dialogue: 0,0:21:54.93,0:21:57.31,Default,,0,0,0,,Шабуыл! (Сунео) О!
Dialogue: 0,0:21:57.44,0:22:00.11,Default,,0,0,0,,Ах, мен көшбасшымын!
Dialogue: 0,0:22:05.36,0:22:06.32,Default,,0,0,0,,Уау (Сунео) Иә?
Dialogue: 0,0:22:06.65,0:22:08.74,Default,,0,0,0,,Қауіпті! Жүгіріп кету!
Dialogue: 0,0:22:08.86,0:22:10.28,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:10.41,0:22:15.08,Default,,0,0,0,,Мұнда кел! Ууу!
Dialogue: 0,0:22:16.71,0:22:20.04,Default,,0,0,0,,Уф... Сондықтан сақтықты түсірмеу керек...
Dialogue: 0,0:22:20.17,0:22:22.75,Default,,0,0,0,,Иә, рахмет, хмм.
Dialogue: 0,0:22:23.30,0:22:25.26,Default,,0,0,0,,үшінна! Мұқият тыңдаңыз!
Dialogue: 0,0:22:25.59,0:22:27.88,Default,,0,0,0,,Әр адамның батырлық костюмі - сыныптың шамы -
Dialogue: 0,0:22:28.01,0:22:30.34,Default,,0,0,0,,Әр адамның ерекше дағдылары да жетілдірілді!
Dialogue: 0,0:22:30.47,0:22:32.64,Default,,0,0,0,,Мұны өз пайдаңызға пайдаланыңыз!
Dialogue: 0,0:22:32.76,0:22:35.31,Default,,0,0,0,,Жарайды! Хе
Dialogue: 0,0:22:35.43,0:22:37.77,Default,,0,0,0,,Менің сүйікті сумо техникасымен...
Dialogue: 0,0:22:38.60,0:22:41.81,Default,,0,0,0,,Урья, не деген сұмдық!
Dialogue: 0,0:22:46.32,0:22:49.74,Default,,0,0,0,,Маған модельдер мен механизмдермен айналысқан ұнайды...
Dialogue: 0,0:22:50.57,0:22:53.49,Default,,0,0,0,,Уау! Ақымақ, мен оны білдім!
Dialogue: 0,0:22:55.58,0:22:57.91,Default,,0,0,0,,Бұрғылау шабуылы!
Dialogue: 0,0:22:58.58,0:23:00.83,Default,,0,0,0,,О, және...
Dialogue: 0,0:23:02.25,0:23:03.92,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:23:05.71,0:23:07.88,Default,,0,0,0,,Кочо Кочо Кочо Кочо…
Dialogue: 0,0:23:08.01,0:23:10.43,Default,,0,0,0,,(Ғарыш құбыжықтың ыңылауы)
Dialogue: 0,0:23:10.84,0:23:12.97,Default,,0,0,0,,Мүмкін мен...
Dialogue: 0,0:23:13.30,0:23:15.68,Default,,0,0,0,,Мен солай екеніне сенімдімін!
Dialogue: 0,0:23:21.69,0:23:23.52,Default,,0,0,0,,Әй!
Dialogue: 0,0:23:23.86,0:23:25.44,Default,,0,0,0,,Мен ойлағандай!
Dialogue: 0,0:23:25.57,0:23:28.78,Default,,0,0,0,,Бірақ ваннаны ұнату ерекше шеберлік пе?
Dialogue: 0,0:23:29.15,0:23:31.49,Default,,0,0,0,,Уау бәрі керемет~
Dialogue: 0,0:23:31.61,0:23:34.37,Default,,0,0,0,,Қараңызшы, сіз де әсерлі емессіз.
Dialogue: 0,0:23:34.49,0:23:37.99,Default,,0,0,0,,Жарайды, не жақсы екенін көрейік!
Dialogue: 0,0:23:38.12,0:23:39.79,Default,,0,0,0,,Жүр! Нобита-кун!
Dialogue: 0,0:23:41.00,0:23:44.33,Default,,0,0,0,,Ғарыш құбыжығы! Бұл жолы мен
Dialogue: 0,0:23:44.88,0:23:47.88,Default,,0,0,0,,Менің ерекше шеберлігім...
Dialogue: 0,0:23:48.00,0:23:49.84,Default,,0,0,0,,Менің ойымша, бұл түсіріп жатыр.
Dialogue: 0,0:23:49.97,0:23:51.09,Default,,0,0,0,,Ұйқы, солай ма?
Dialogue: 0,0:23:51.22,0:23:54.43,Default,,0,0,0,,Тест бойынша 0 ұпай, әлемде бірінші орында!
Dialogue: 0,0:23:54.55,0:23:55.97,Default,,0,0,0,,Қазірдің өзінде!
Dialogue: 0,0:23:56.26,0:23:58.35,Default,,0,0,0,,Кез келген нәрсені байқап көріңіз!
Dialogue: 0,0:23:58.68,0:24:01.81,Default,,0,0,0,,Жарайды! Ахо! Хочо!
Dialogue: 0,0:24:01.94,0:24:03.52,Default,,0,0,0,,Чои!
Dialogue: 0,0:24:07.07,0:24:09.28,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:24:10.07,0:24:12.40,Default,,0,0,0,,Не? сурет? Тааа!
Dialogue: 0,0:24:13.11,0:24:15.66,Default,,0,0,0,,А, бесік пе?
Dialogue: 0,0:24:15.78,0:24:18.99,Default,,0,0,0,,Дааа (Директор Бергер) Упип.
Dialogue: 0,0:24:19.20,0:24:20.79,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:23.71,0:24:26.50,Default,,0,0,0,,Ой... ой...
Dialogue: 0,0:24:27.38,0:24:29.46,Default,,0,0,0,,Сіз немен ойнайсыз?
Dialogue: 0,0:24:29.59,0:24:30.80,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:24:30.92,0:24:34.05,Default,,0,0,0,,Эй, мен тұрып, мына тамаша жерді суретке түсіруім керек!
Dialogue: 0,0:24:34.18,0:24:36.60,Default,,0,0,0,,Иә, бұл жолы! Хухуу
Dialogue: 0,0:24:36.72,0:24:40.31,Default,,0,0,0,,Жүр, мен де! Уф, солай!
Dialogue: 0,0:24:52.28,0:24:56.28,Default,,0,0,0,,(Дораэмонның айқайы)
Dialogue: 0,0:24:56.74,0:25:00.16,Default,,0,0,0,,(Дораэмонның айқайы)
Dialogue: 0,0:25:29.81,0:25:30.69,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:25:30.82,0:25:35.65,Default,,0,0,0,,Керемет супер Дракик! О...
Dialogue: 0,0:25:35.95,0:25:38.20,Default,,0,0,0,,(Дораэмонның үрейлі дауысы)
Dialogue: 0,0:25:38.32,0:25:39.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:25:42.37,0:25:44.37,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:25:46.67,0:25:47.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:48.83,0:25:51.34,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:25:51.46,0:25:52.67,Default,,0,0,0,,Көшбасшы күткендей
Dialogue: 0,0:25:52.80,0:25:54.09,Default,,0,0,0,,Керемет соққы!
Dialogue: 0,0:25:54.21,0:25:56.09,Default,,0,0,0,,Ал...
Dialogue: 0,0:25:56.34,0:25:59.01,Default,,0,0,0,,Бұл шын мәнінде соққы болды, бірақ...
Dialogue: 0,0:26:03.39,0:26:05.23,Default,,0,0,0,,Әлемнің тыныштығын қорғау
Dialogue: 0,0:26:05.68,0:26:08.23,Default,,0,0,0,,Жаман жігіттер, тозақтың ісі!
Dialogue: 0,0:26:08.52,0:26:10.23,Default,,0,0,0,,Біз бес батырмыз!
Dialogue: 0,0:26:10.56,0:26:12.23,Default,,0,0,0,,Галактикалық қорғаныс күштері!
Dialogue: 0,0:26:12.73,0:26:14.82,Default,,0,0,0,,Ғажайып Галактика қорғаныс күштері!
Dialogue: 0,0:26:14.94,0:26:16.24,Default,,0,0,0,,Менің сызықтарым қандай?
Dialogue: 0,0:26:16.57,0:26:18.91,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:26:19.03,0:26:21.28,Default,,0,0,0,,Жақсы! Өте жақсы!
Dialogue: 0,0:26:21.41,0:26:25.00,Default,,0,0,0,,Ол мен ойлағандай керемет режиссер!
Dialogue: 0,0:26:25.12,0:26:28.00,Default,,0,0,0,,Осы уақытқа дейін менің күмәнім болғанымен!
Dialogue: 0,0:26:28.96,0:26:34.21,Default,,0,0,0,,Мен бүкіл актерлік мансабымды режиссер болуға арнаймын!
Dialogue: 0,0:26:34.34,0:26:37.51,Default,,0,0,0,,Ах... Хехе, бұл жақсы, Бургер-чан.
Dialogue: 0,0:26:37.63,0:26:38.51,Default,,0,0,0,,Дыбыстық сигнал
Dialogue: 0,0:26:39.05,0:26:41.93,Default,,0,0,0,,Нобита-кунның да батыр болғанына қуаныштымын.
Dialogue: 0,0:26:42.05,0:26:43.93,Default,,0,0,0,,Иә, бірақ—
Dialogue: 0,0:26:44.06,0:26:45.77,Default,,0,0,0,,Неліктен мен ғана трюк ойнаймын?
Dialogue: 0,0:26:45.85,0:26:47.06,Default,,0,0,0,,А… арыстан!
Dialogue: 0,0:26:47.43,0:26:49.52,Default,,0,0,0,,Пфф, аа... (Нобита) Ммм, хмф!
Dialogue: 0,0:26:49.77,0:26:52.52,Default,,0,0,0,,Мұнымен қалай күресеміз?
Dialogue: 0,0:26:53.48,0:26:56.65,Default,,0,0,0,,Иә? Мына жақтан біреу келе жатыр!
Dialogue: 0,0:26:56.78,0:26:57.78,Default,,0,0,0,,Хмм? (Сунео/Шидзука) Иә?
Dialogue: 0,0:26:59.82,0:27:03.28,Default,,0,0,0,,(үшін дүрбелең)
Dialogue: 0,0:27:03.41,0:27:06.41,Default,,0,0,0,,(бір нәрсеге шағымданған дауыс)
Dialogue: 0,0:27:06.70,0:27:08.12,Default,,0,0,0,,Уа, бұл не?
Dialogue: 0,0:27:08.25,0:27:10.04,Default,,0,0,0,,Эй, бұл адам жейтін бөтен планета болуы мүмкін.
Dialogue: 0,0:27:10.25,0:27:12.04,Default,,0,0,0,,(бір нәрсеге шағымданған дауыс)
Dialogue: 0,0:27:12.17,0:27:15.42,Default,,0,0,0,,Түсіндім! Бұл да режиссердің ойыны.
Dialogue: 0,0:27:15.55,0:27:17.92,Default,,0,0,0,,Дыбыстық сигнал? Режиссер күткендей!
Dialogue: 0,0:27:18.05,0:27:20.05,Default,,0,0,0,,Бірден жаңа даму!
Dialogue: 0,0:27:20.43,0:27:22.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:22.18,0:27:24.05,Default,,0,0,0,,Сіз бірдеңе айтып тұрған сияқтысыз...
Dialogue: 0,0:27:24.64,0:27:27.43,Default,,0,0,0,,Ах, кешіріңіз, мм, мм...
Dialogue: 0,0:27:32.77,0:27:34.48,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:27:34.61,0:27:38.74,Default,,0,0,0,,Біз Галактикалық қорғаныс күштері, әділет батырларымыз!
Dialogue: 0,0:27:38.86,0:27:40.82,Default,,0,0,0,,Құрметті Галактикалық қорғаныс күштері! (үшін) О!
Dialogue: 0,0:27:41.15,0:27:43.82,Default,,0,0,0,,Поккуру планетасын құтқару үшін
Dialogue: 0,0:27:44.03,0:27:45.99,Default,,0,0,0,,Маған күшіңізді беріңізші!
Dialogue: 0,0:27:46.12,0:27:47.08,Default,,0,0,0,,Не?!
Dialogue: 0,0:27:47.33,0:27:50.87,Default,,0,0,0,,Бұл ақыры кейіпкерлер фильміне ұқсай бастады!
Dialogue: 0,0:27:51.00,0:27:54.33,Default,,0,0,0,,үшінңыз, дұрыс сөйлесіп, дұрыс әрекет етіңіздер.
Dialogue: 0,0:27:56.67,0:28:00.84,Default,,0,0,0,,Кімде-кім көмек сұраса, мен галактиканың шетіне асығамын.
Dialogue: 0,0:28:00.97,0:28:04.84,Default,,0,0,0,,Бұл біздің Галактикалық қорғаныс күштерінің миссиясы!
Dialogue: 0,0:28:05.18,0:28:08.06,Default,,0,0,0,,Әрине, біз ынтымақтасамыз!
Dialogue: 0,0:28:08.18,0:28:10.43,Default,,0,0,0,,Ах, рахмет!
Dialogue: 0,0:28:10.56,0:28:13.35,Default,,0,0,0,,Енді Поккуру планетасына барайық!
Dialogue: 0,0:28:13.98,0:28:15.98,Default,,0,0,0,,Қорғаныс күштері!
Dialogue: 0,0:28:16.36,0:28:18.65,Default,,0,0,0,,Жаңа миссияға жіберіңіз!
Dialogue: 0,0:28:18.78,0:28:19.86,Default,,0,0,0,,Оу!
Dialogue: 0,0:28:20.61,0:28:24.49,Default,,0,0,0,,Мен бұл жолы бар күшімді саламын~ Хмф!
Dialogue: 0,0:28:24.61,0:28:25.87,Default,,0,0,0,,(Қарт әйел) Құдайым-ай, сіз қандай құмар әрі жігерлі талапкерсіз.
Dialogue: 0,0:28:26.78,0:28:27.62,Default,,0,0,0,,Дыбыстық сигнал
Dialogue: 0,0:28:29.99,0:28:34.62,Default,,0,0,0,,Дыбыстық сигнал...
Dialogue: 0,0:28:38.55,0:28:40.05,Default,,0,0,0,,Ақыры оларға бақыт келді
Dialogue: 0,0:28:40.84,0:28:43.63,Default,,0,0,0,,Хмм, рахмет
Dialogue: 0,0:28:43.84,0:28:45.09,Default,,0,0,0,,Міне.
Dialogue: 0,0:28:45.43,0:28:46.72,Default,,0,0,0,,Хото
Dialogue: 0,0:28:46.85,0:28:48.72,Default,,0,0,0,,Алыңыз!
Dialogue: 0,0:28:48.85,0:28:51.43,Default,,0,0,0,,Торияаа
Dialogue: 0,0:28:52.14,0:28:53.52,Default,,0,0,0,,Қандай бақыттысыңдар, барлық қызықты өзіңе алдыңдар.
Dialogue: 0,0:28:57.69,0:29:00.02,Default,,0,0,0,,О? Апыр-ай!
Dialogue: 0,0:29:01.11,0:29:02.78,Default,,0,0,0,,үшінңыз отырыңыздар.
Dialogue: 0,0:29:02.90,0:29:04.03,Default,,0,0,0,,Біз бірден кетеміз!
Dialogue: 0,0:29:08.58,0:29:11.16,Default,,0,0,0,,Осы арқылы Поккуру планетасын сақтауға болады.
Dialogue: 0,0:29:11.29,0:29:12.58,Default,,0,0,0,,Мен тез оралуым керек.
Dialogue: 0,0:29:37.10,0:29:39.27,Default,,0,0,0,,Иә? (Нобита) Не?
Dialogue: 0,0:29:39.40,0:29:41.11,Default,,0,0,0,,Сіз ұша аласыз ба?
Dialogue: 0,0:29:42.07,0:29:44.94,Default,,0,0,0,,Жоқ, мен ғарышқа ұштым!
Dialogue: 0,0:29:50.99,0:29:53.62,Default,,0,0,0,,Виртуалды кеңістік болса да...
Dialogue: 0,0:29:57.00,0:30:01.17,Default,,0,0,0,,Осыны ішіңіз, сонда сіз ғаламның кез келген жерінде өзіңізді жайлы сезінесіз.
Dialogue: 0,0:30:10.80,0:30:11.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:13.01,0:30:15.93,Default,,0,0,0,,Баршаңызға, сәлемдесуге кешігіп қалдым.
Dialogue: 0,0:30:16.06,0:30:18.65,Default,,0,0,0,,Менің атым Поккуру планетасынан Арон.
Dialogue: 0,0:30:19.31,0:30:22.40,Default,,0,0,0,,Мен қорғаныс күштерінің көмегін ала алдым.
Dialogue: 0,0:30:22.52,0:30:24.65,Default,,0,0,0,,Ғаламшарды құтқарамын деген үміт артты
Dialogue: 0,0:30:25.15,0:30:27.90,Default,,0,0,0,,Поккуру планетасында не болып жатыр?
Dialogue: 0,0:30:30.91,0:30:35.16,Default,,0,0,0,,Бізді қорқынышты ғарыш қарақшылары басып алды!
Dialogue: 0,0:30:35.45,0:30:37.41,Default,,0,0,0,,Ғарыш қарақшысы! ?
Dialogue: 0,0:30:38.08,0:30:41.92,Default,,0,0,0,,Бұл қиын. Біз бірдеңе істеуіміз керек!
Dialogue: 0,0:30:42.04,0:30:44.05,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:30:44.92,0:30:48.30,Default,,0,0,0,,Жоқ, сіз табиғирақ әрекет етуіңіз керек.
Dialogue: 0,0:30:48.42,0:30:51.59,Default,,0,0,0,,Кенет актерлердің таланты асқақтай түседі...
Dialogue: 0,0:30:51.72,0:30:52.55,Default,,0,0,0,,Хаа…
Dialogue: 0,0:30:53.97,0:30:56.60,Default,,0,0,0,,А, уайымдама, жалғастырайық.
Dialogue: 0,0:30:56.72,0:30:58.06,Default,,0,0,0,,Камадо!
Dialogue: 0,0:31:01.56,0:31:03.73,Default,,0,0,0,,Біз тұратын Поккуру планетасы—
Dialogue: 0,0:31:03.86,0:31:08.15,Default,,0,0,0,,Осы Құс жолы галактикасын қоршап тұрған жұлдыздар құйынынан тыс —
Dialogue: 0,0:31:08.28,0:31:09.53,Default,,0,0,0,,Онда орналасқан
Dialogue: 0,0:31:09.65,0:31:12.82,Default,,0,0,0,,Бұл өте кішкентай, шалғай планета.
Dialogue: 0,0:31:13.87,0:31:16.33,Default,,0,0,0,,Басқа планеталардан адамдар сирек келеді...
Dialogue: 0,0:31:16.41,0:31:17.04,Default,,0,0,0,,Міне осылай. (Балалар) Күте тұрыңыз.
Dialogue: 0,0:31:17.04,0:31:19.37,Default,,0,0,0,,Міне осылай. (Балалар) Күте тұрыңыз.
Dialogue: 0,0:31:17.04,0:31:19.37,Default,,0,0,0,,Бұл тыныш және бейбіт планета болды...
Dialogue: 0,0:31:19.37,0:31:19.83,Default,,0,0,0,,Бұл тыныш және бейбіт планета болды...
Dialogue: 0,0:31:22.00,0:31:23.46,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:31:23.59,0:31:26.42,Default,,0,0,0,,Арон Арон!
Dialogue: 0,0:31:26.55,0:31:28.67,Default,,0,0,0,,Жалғыз! иә?
Dialogue: 0,0:31:29.09,0:31:31.26,Default,,0,0,0,,Ха ха ха шаршадым
Dialogue: 0,0:31:31.38,0:31:32.51,Default,,0,0,0,,Профессор, шай ішесіз бе?
Dialogue: 0,0:31:33.76,0:31:35.72,Default,,0,0,0,,Шерифке сәлем!
Dialogue: 0,0:31:36.39,0:31:37.68,Default,,0,0,0,,Иә! Ерен еңбегіңіз үшін рахмет
Dialogue: 0,0:31:38.60,0:31:40.27,Default,,0,0,0,,Біз бәріміз шериф ойнаймыз ба?
Dialogue: 0,0:31:40.39,0:31:42.94,Default,,0,0,0,,үшінмыз Ааронға көмектесейік.
Dialogue: 0,0:31:43.02,0:31:44.73,Default,,0,0,0,,Мен қуаныштымын
Dialogue: 0,0:31:44.86,0:31:47.48,Default,,0,0,0,,Фофо, сондай бейбіт планета...
Dialogue: 0,0:31:47.61,0:31:49.24,Default,,0,0,0,,Сіз маған көмектесе алмайсыз.
Dialogue: 0,0:31:49.36,0:31:50.45,Default,,0,0,0,,Мен...
Dialogue: 0,0:31:51.15,0:31:53.95,Default,,0,0,0,,Кешіріңіз, бәріңіз, жоқ.
Dialogue: 0,0:31:54.07,0:31:56.16,Default,,0,0,0,,Мен көмектескім келеді
Dialogue: 0,0:31:56.28,0:31:58.75,Default,,0,0,0,,Иә, мен сені бір күні кездестіремін деп үміттенемін.
Dialogue: 0,0:31:58.87,0:32:02.21,Default,,0,0,0,,Ха ха ха ха... ха ха ха ха...
Dialogue: 0,0:32:02.71,0:32:04.25,Default,,0,0,0,,Сол бір күні
Dialogue: 0,0:32:04.50,0:32:07.63,Default,,0,0,0,,Өздерін Space Partner Inc деп атайтын адамдар келді...
Dialogue: 0,0:32:13.38,0:32:15.76,Default,,0,0,0,,(Тұрғындар күңкілдейді)
Dialogue: 0,0:32:15.89,0:32:17.31,Default,,0,0,0,,Сол жігіт Юхамонды пайдаланып, қасақана ұрлықтар жасап жүрген
Dialogue: 0,0:32:17.64,0:32:20.10,Default,,0,0,0,,Менің басқа планетадан келгеніме көп уақыт болды.
Dialogue: 0,0:32:20.18,0:32:20.81,Default,,0,0,0,,Бұрын менің жинақтағы ақшам 20 000 йен болатын! Ах, ах…
Dialogue: 0,0:32:26.40,0:32:27.23,Default,,0,0,0,,Ihi
Dialogue: 0,0:32:27.73,0:32:31.99,Default,,0,0,0,,Бүгін мен сендерге тамаша сыйлық әкелдім.
Dialogue: 0,0:32:32.36,0:32:35.99,Default,,0,0,0,,Поккуруланд~!
Dialogue: 0,0:32:37.20,0:32:38.70,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:32:39.08,0:32:41.16,Default,,0,0,0,,Уау! (Бала) Керемет!
Dialogue: 0,0:32:41.29,0:32:45.38,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:32:45.50,0:32:47.92,Default,,0,0,0,,Жұлдызды адамдардың жүрегін әп-сәтте жаулап алды.
Dialogue: 0,0:32:48.04,0:32:49.21,Default,,0,0,0,,...
Dialogue: 0,0:32:50.00,0:32:53.22,Default,,0,0,0,,Ыстық бұлақ қаласы ойын-сауық саябағы —
Dialogue: 0,0:32:53.84,0:32:57.80,Default,,0,0,0,,Алып ғарыш мұнарасының құрылысымен алға ұмтылды.
Dialogue: 0,0:32:58.30,0:33:02.73,Default,,0,0,0,,Біздің бірінші басымдылығымыз – Поккуру планетасын дамыту.
Dialogue: 0,0:33:02.85,0:33:06.56,Default,,0,0,0,,Иә, біз сіздің серіктестеріміз!
Dialogue: 0,0:33:07.23,0:33:09.32,Default,,0,0,0,,Бірге гүлденейік!
Dialogue: 0,0:33:09.44,0:33:10.48,Default,,0,0,0,,Wahoo
Dialogue: 0,0:33:10.69,0:33:11.57,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:33:12.07,0:33:15.74,Default,,0,0,0,,Бұл Поккуру планетасы үшін жақсы оқиға сияқты.
Dialogue: 0,0:33:15.86,0:33:19.66,Default,,0,0,0,,Иә, әрине.
Dialogue: 0,0:33:20.37,0:33:23.91,Default,,0,0,0,,Алғашында мен де қуаныштан айқайладым, бірақ...
Dialogue: 0,0:33:25.33,0:33:28.17,Default,,0,0,0,,Покелланд аяқталуға жақын қалғанда—
Dialogue: 0,0:33:28.29,0:33:30.17,Default,,0,0,0,,Жұлдыздарда біртүрлі нәрсе көріне бастады.
Dialogue: 0,0:33:31.75,0:33:34.17,Default,,0,0,0,,Орман тез қурай бастайды...
Dialogue: 0,0:33:41.10,0:33:44.73,Default,,0,0,0,,Бұрын бұл жерде де жап-жасыл болатын...
Dialogue: 0,0:33:45.02,0:33:46.06,Default,,0,0,0,,Ха... аа
Dialogue: 0,0:33:50.82,0:33:51.73,Default,,0,0,0,,Хмм
Dialogue: 0,0:33:54.74,0:33:55.99,Default,,0,0,0,,...
Dialogue: 0,0:33:56.11,0:34:00.49,Default,,0,0,0,,Тергеуді жалғастыра отырып, мен жасырын ниет болуы мүмкін деп ойладым.
Dialogue: 0,0:34:00.62,0:34:04.45,Default,,0,0,0,,Бұл үшеуі - бұл ғаламда сахнаның артында жұмыс істейтін ғарыштық қарақшылардың жетекшілері.
Dialogue: 0,0:34:04.58,0:34:07.87,Default,,0,0,0,,Бұл Хайд Моеба Оргоне болып шықты.
Dialogue: 0,0:34:08.00,0:34:10.08,Default,,0,0,0,,Хм
Dialogue: 0,0:34:11.38,0:34:14.13,Default,,0,0,0,,және банды біріктіру -
Dialogue: 0,0:34:14.26,0:34:16.17,Default,,0,0,0,,Бас Икар
Dialogue: 0,0:34:16.30,0:34:20.39,Default,,0,0,0,,Яхахаха...
Dialogue: 0,0:34:20.72,0:34:24.60,Default,,0,0,0,,Адамдардың жүрегіне тәтті сөздермен, өтірік күлкілермен ену.
Dialogue: 0,0:34:24.72,0:34:26.98,Default,,0,0,0,,Осы мақсатқа қажетті кез келген құралдар
Dialogue: 0,0:34:27.48,0:34:29.65,Default,,0,0,0,,Олар менің көзіме түсті, бірақ соңында —
Dialogue: 0,0:34:29.77,0:34:33.02,Default,,0,0,0,,Ол жұлдыз міндетті түрде жойылу жолына апарады.
Dialogue: 0,0:34:33.15,0:34:34.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:34:34.82,0:34:36.11,Default,,0,0,0,,Жұлдыздардың адамдары ше?
Dialogue: 0,0:34:36.78,0:34:39.45,Default,,0,0,0,,Әрине, мен дағдарысқа шақырдым, бірақ—
Dialogue: 0,0:34:39.82,0:34:42.62,Default,,0,0,0,,Мен оларға толық сендім...
Dialogue: 0,0:34:42.99,0:34:44.62,Default,,0,0,0,,Басқа планеталардың көмегі туралы не деуге болады?
Dialogue: 0,0:34:45.29,0:34:49.75,Default,,0,0,0,,Соңғы уақытта Жұлдызаралық федерацияның құрылу қарқыны артып келеді.
Dialogue: 0,0:34:49.87,0:34:53.13,Default,,0,0,0,,Мен әлі көмек сұрайтындай күйде емеспін...
Dialogue: 0,0:34:53.59,0:34:57.88,Default,,0,0,0,,Тіпті Поккуру планетасында мен жалғыз шерифмін.
Dialogue: 0,0:34:58.26,0:35:03.01,Default,,0,0,0,,Сонда да мен олардың шынайы мақсатын білу үшін зерттеуді жалғастырамын...
Dialogue: 0,0:35:03.39,0:35:04.97,Default,,0,0,0,,(Күзетшінің есінеу)
Dialogue: 0,0:35:12.77,0:35:15.23,Default,,0,0,0,,Ха, кетті! (Күзетші) Не істеп жатырсың!
Dialogue: 0,0:35:15.36,0:35:16.69,Default,,0,0,0,,А, тоқта! Иә!
Dialogue: 0,0:35:16.82,0:35:18.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:35:18.74,0:35:19.78,Default,,0,0,0,,Зиянкес!
Dialogue: 0,0:35:21.45,0:35:22.78,Default,,0,0,0,,О? Сіздер әлдеқашан бастадыңыздар ма? Әңгіме
Dialogue: 0,0:35:25.91,0:35:27.20,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:35:27.58,0:35:29.16,Default,,0,0,0,,Енді қашайық
Dialogue: 0,0:35:34.67,0:35:36.25,Default,,0,0,0,,Күте тұрыңыз! Апыр-ай!
Dialogue: 0,0:35:45.01,0:35:47.85,Default,,0,0,0,,Ақырында, мен астероидтар белдеуінің қабырғасына қысылдым ...
Dialogue: 0,0:35:48.81,0:35:51.14,Default,,0,0,0,,Нашар! Апыр-ай!
Dialogue: 0,0:36:00.61,0:36:03.41,Default,,0,0,0,,Мен бұрылыс арқылы тез құтылдым, бірақ...
Dialogue: 0,0:36:03.53,0:36:05.95,Default,,0,0,0,,Бұрмалау құрылғысының шабуылына байланысты —
Dialogue: 0,0:36:06.08,0:36:08.83,Default,,0,0,0,,Ішкі кеңістікте қайта-қайта өтуді жалғастыру -
Dialogue: 0,0:36:08.95,0:36:10.75,Default,,0,0,0,,Мен кездейсоқ қонған жұлдызда —
Dialogue: 0,0:36:11.66,0:36:14.04,Default,,0,0,0,,Әркімнің жетістігіне қарап...
Dialogue: 0,0:36:16.59,0:36:18.25,Default,,0,0,0,,Сондықтан қазір осында.
Dialogue: 0,0:36:20.67,0:36:22.97,Default,,0,0,0,,Бұл өте қызықты оқиға сияқты.
Dialogue: 0,0:36:23.09,0:36:25.68,Default,,0,0,0,,Пи! Бұл Джан-сама...
Dialogue: 0,0:36:25.80,0:36:29.39,Default,,0,0,0,,Сол ғарыштық қарақшыларды жеңейік!
Dialogue: 0,0:36:29.52,0:36:32.35,Default,,0,0,0,,Хмм... аа
Dialogue: 0,0:36:32.48,0:36:35.56,Default,,0,0,0,,Мен, Сунео, мен Шизукамын.
Dialogue: 0,0:36:35.69,0:36:36.90,Default,,0,0,0,,I Дораемон
Dialogue: 0,0:36:37.40,0:36:39.19,Default,,0,0,0,,Ал Галактикалық қорғаныс күштері...
Dialogue: 0,0:36:39.32,0:36:41.24,Default,,0,0,0,,Сіз көшбасшысыз!
Dialogue: 0,0:36:41.36,0:36:43.28,Default,,0,0,0,,Иә! иә! ?
Dialogue: 0,0:36:43.70,0:36:44.66,Default,,0,0,0,,Ұрыста
Dialogue: 0,0:36:45.03,0:36:48.08,Default,,0,0,0,,Ортадан бұйрық беріп тұрғанын көргенде түсінемін.
Dialogue: 0,0:36:49.04,0:36:50.12,Default,,0,0,0,,Дыбыстық сигнал
Dialogue: 0,0:36:50.41,0:36:52.91,Default,,0,0,0,,Ынтымақтастық үшін рахмет!
Dialogue: 0,0:36:53.00,0:36:55.54,Default,,0,0,0,,Nihii Мұндағы ағынмен жүріңіз
Dialogue: 0,0:36:55.67,0:36:57.92,Default,,0,0,0,,На Дораемон-кун
Dialogue: 0,0:36:58.34,0:36:59.50,Default,,0,0,0,,Мен Нобитамын
Dialogue: 0,0:36:59.63,0:37:02.67,Default,,0,0,0,,Мен Поккуру планетасын да, сізді де қорғаймын.
Dialogue: 0,0:37:02.80,0:37:04.68,Default,,0,0,0,,Рахмет (Нобита) Иә.
Dialogue: 0,0:37:05.13,0:37:08.68,Default,,0,0,0,,Бәріңе, қалай рахмет айтамын...
Dialogue: 0,0:37:09.10,0:37:10.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:37:11.47,0:37:14.89,Default,,0,0,0,,Кешіріңіз, мен жай ғана...
Dialogue: 0,0:37:21.53,0:37:23.19,Default,,0,0,0,,Бұрыннан бері бұл кеме —
Dialogue: 0,0:37:23.32,0:37:26.49,Default,,0,0,0,,Келген кезде алған деректерге сүйене отырып, біз Поккуру планетасына бара жатырмыз.
Dialogue: 0,0:37:26.61,0:37:28.78,Default,,0,0,0,,Біз жақындап қалдық
Dialogue: 0,0:37:29.99,0:37:32.62,Default,,0,0,0,,Қарақшылардың радарына түсіп қалу қаупі бар ма?
Dialogue: 0,0:37:33.00,0:37:35.96,Default,,0,0,0,,Иә, сондықтан қарақшылардың көрегендігі қысқа.
Dialogue: 0,0:37:36.08,0:37:39.71,Default,,0,0,0,,Мен жұлдыздың артындағы шөл далаға қонуды жоспарлап отырмын.
Dialogue: 0,0:37:53.72,0:37:55.31,Default,,0,0,0,,Уау!
Dialogue: 0,0:37:55.43,0:37:56.60,Default,,0,0,0,,Уау!
Dialogue: 0,0:37:58.69,0:38:00.31,Default,,0,0,0,,Итатата...
Dialogue: 0,0:38:00.44,0:38:02.65,Default,,0,0,0,,Не? Бұл қарақшылардың шабуылы болды ма?
Dialogue: 0,0:38:02.78,0:38:04.65,Default,,0,0,0,,Иә? Мен аспанды көре аламын
Dialogue: 0,0:38:04.78,0:38:06.15,Default,,0,0,0,,Иә? Шамасы -
Dialogue: 0,0:38:06.28,0:38:07.74,Default,,0,0,0,,Біз келген сияқтымыз.
Dialogue: 0,0:38:11.20,0:38:12.70,Default,,0,0,0,,Бұл не деген жер екен...
Dialogue: 0,0:38:12.83,0:38:14.75,Default,,0,0,0,,Бұл бос жер емес...
Dialogue: 0,0:38:15.20,0:38:17.46,Default,,0,0,0,,Қараңызшы?
Dialogue: 0,0:38:19.25,0:38:21.79,Default,,0,0,0,,Әдемі... сондай жарқыраған
Dialogue: 0,0:38:21.92,0:38:23.71,Default,,0,0,0,,Бұл ғарыш мұнарасы ма?
Dialogue: 0,0:38:23.84,0:38:25.26,Default,,0,0,0,,Уау...
Dialogue: 0,0:38:25.38,0:38:28.01,Default,,0,0,0,,Иә? Сунео ше? (Нобита) Ойланып көрші...
Dialogue: 0,0:38:28.47,0:38:31.22,Default,,0,0,0,,Сәлем, Сунео! Сунео мырза!
Dialogue: 0,0:38:31.35,0:38:33.14,Default,,0,0,0,,Сунео!
Dialogue: 0,0:38:34.06,0:38:36.43,Default,,0,0,0,,Жарайды, түсіндім.
Dialogue: 0,0:38:36.85,0:38:38.64,Default,,0,0,0,,аздап
Dialogue: 0,0:38:38.98,0:38:40.65,Default,,0,0,0,,Сунео!
Dialogue: 0,0:38:41.06,0:38:42.65,Default,,0,0,0,,Уау...
Dialogue: 0,0:38:51.62,0:38:53.08,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:38:53.20,0:38:54.99,Default,,0,0,0,,Сәлем бәріңе!
Dialogue: 0,0:38:55.12,0:38:57.33,Default,,0,0,0,,Сунео! Сен қайда болдың?
Dialogue: 0,0:38:57.75,0:39:00.88,Default,,0,0,0,,Одан гөрі бұл жер ойын-сауық саябағы сияқты.
Dialogue: 0,0:39:01.00,0:39:01.83,Default,,0,0,0,,Дегенмен, мен әлі күн бойы Толық шоғырланған тыныс алуды ұстап тұра алмаймын.
Dialogue: 0,0:39:02.29,0:39:04.92,Default,,0,0,0,,Сәлем! Мұны істеудің тамаша мүмкіндігі.
Dialogue: 0,0:39:05.05,0:39:06.80,Default,,0,0,0,,Көңілді болайық!
Dialogue: 0,0:39:06.92,0:39:07.76,Default,,0,0,0,,О! Ах
Dialogue: 0,0:39:07.88,0:39:09.30,Default,,0,0,0,,Мен де! А, қазірдің өзінде!
Dialogue: 0,0:39:09.43,0:39:13.22,Default,,0,0,0,,Суретке түсіру туралы не айтуға болады? Бұл шынымен өзімшілдік
Dialogue: 0,0:39:13.35,0:39:14.64,Default,,0,0,0,,Ум...
Dialogue: 0,0:39:14.76,0:39:18.77,Default,,0,0,0,,Мен де бір рет бос ойын-сауық саябағында ойнағым келді!
Dialogue: 0,0:39:18.89,0:39:21.77,Default,,0,0,0,,О, тіпті Шизука-чан!
Dialogue: 0,0:39:22.48,0:39:24.94,Default,,0,0,0,,Pi?
Dialogue: 0,0:39:25.07,0:39:26.44,Default,,0,0,0,,Не? (Директор Бергер) Упи?
Dialogue: 0,0:39:26.57,0:39:28.86,Default,,0,0,0,,Өйткені, мен көшбасшымын!
Dialogue: 0,0:39:28.99,0:39:30.86,Default,,0,0,0,,Бұршақ Дораемон
Dialogue: 0,0:39:31.32,0:39:32.66,Default,,0,0,0,,Ах, Арон-кун.
Dialogue: 0,0:39:32.78,0:39:33.87,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:39:34.37,0:39:37.62,Default,,0,0,0,,Бұрмалау құрылғысы толығымен бекітілмеген сияқты.
Dialogue: 0,0:39:37.75,0:39:39.87,Default,,0,0,0,,үшінңыз ше? мм...
Dialogue: 0,0:39:41.37,0:39:42.38,Default,,0,0,0,,Хмм... иә?
Dialogue: 0,0:39:46.55,0:39:49.97,Default,,0,0,0,,Айтуынша, кеше ол мөлдір сәбиді немесе сондай бір нәрсені тапқан екен—
Dialogue: 0,0:39:50.84,0:39:52.22,Default,,0,0,0,,Уау!
Dialogue: 0,0:39:53.80,0:39:55.26,Default,,0,0,0,,Керемет!
Dialogue: 0,0:39:56.64,0:40:00.89,Default,,0,0,0,,Уфуфуфуфуфуфуфу... Мен түсімде жүргендеймін.
Dialogue: 0,0:40:01.39,0:40:03.98,Default,,0,0,0,,үшін, жоқ, қарақшылар сені табады!
Dialogue: 0,0:40:04.11,0:40:04.94,Default,,0,0,0,,Жарайды
Dialogue: 0,0:40:05.06,0:40:06.90,Default,,0,0,0,,Келесі жерде (Сунео/Нобита) О!
Dialogue: 0,0:40:07.23,0:40:11.07,Default,,0,0,0,,Ах~ Мен осылайша жауларды қуып, оларды жеңуге тырысамын...
Dialogue: 0,0:40:11.20,0:40:12.66,Default,,0,0,0,,Сәлем? Көшбасшы (директор Бергер) Пи! ?
Dialogue: 0,0:40:12.78,0:40:15.91,Default,,0,0,0,,Солай ма? Қорғаныс күштері күткендей, олар сенімді.
Dialogue: 0,0:40:15.99,0:40:17.91,Default,,0,0,0,,Ахаха хехехехе?
Dialogue: 0,0:40:15.99,0:40:17.91,Default,,0,0,0,,(Ұшу дыбысы)
Dialogue: 0,0:40:18.54,0:40:19.66,Default,,0,0,0,,Бірдеңе?
Dialogue: 0,0:40:22.21,0:40:23.54,Default,,0,0,0,,Міне!
Dialogue: 0,0:40:32.80,0:40:35.18,Default,,0,0,0,,Не болды? (Сунео) Не? сол адамдар
Dialogue: 0,0:40:35.64,0:40:39.43,Default,,0,0,0,,Нуууу... Бұл ғарыштық серіктестің күзетшісі.
Dialogue: 0,0:40:39.77,0:40:40.60,Default,,0,0,0,,Не—
Dialogue: 0,0:40:40.72,0:40:42.69,Default,,0,0,0,,Қауіпсіздік қызметкерлері? Ах!
Dialogue: 0,0:40:42.77,0:40:45.65,Default,,0,0,0,,Иә! Кешіріңіз, кешіріңіз, мен рұқсатсыз ойнадым.
Dialogue: 0,0:40:46.02,0:40:49.15,Default,,0,0,0,,Джиан мырза! Бұл балалар ғарыштық қарақшылар!
Dialogue: 0,0:40:49.28,0:40:50.53,Default,,0,0,0,,Бұл адамдар?
Dialogue: 0,0:40:50.78,0:40:53.53,Default,,0,0,0,,О! Ойлап қарасам, солай болды.
Dialogue: 0,0:40:54.03,0:40:56.70,Default,,0,0,0,,Екеуміз жақсы өнер көрсетейік.
Dialogue: 0,0:40:56.82,0:40:59.03,Default,,0,0,0,,Бұл жігіт не туралы айтып тұр? (Күзетші) Қане?
Dialogue: 0,0:40:59.74,0:41:02.04,Default,,0,0,0,,Эй, ол (күзетші)?
Dialogue: 0,0:41:03.62,0:41:05.79,Default,,0,0,0,,Уф... (Күзетші) Әй, анау жігіт!
Dialogue: 0,0:41:06.21,0:41:07.79,Default,,0,0,0,,үшінн ұстаңыз!
Dialogue: 0,0:41:08.17,0:41:11.84,Default,,0,0,0,,Уау! Сіз кенеттен қайтадан түсіруді бастайсыз ба?
Dialogue: 0,0:41:11.96,0:41:13.80,Default,,0,0,0,,Джан-сан, қаш!
Dialogue: 0,0:41:15.68,0:41:17.26,Default,,0,0,0,,Уф
Dialogue: 0,0:41:18.10,0:41:22.39,Default,,0,0,0,,(үшін дүрбелең)
Dialogue: 0,0:41:22.89,0:41:24.39,Default,,0,0,0,,Жасырудың қажеті жоқ!
Dialogue: 0,0:41:24.60,0:41:26.23,Default,,0,0,0,,Тыныш шығыңыз!
Dialogue: 0,0:41:26.35,0:41:28.86,Default,,0,0,0,,Қарсылас та өте қызу ойын көрсетті.
Dialogue: 0,0:41:28.98,0:41:31.90,Default,,0,0,0,,Сәлем, директор! Бұл шынымен де әсерлі!
Dialogue: 0,0:41:32.36,0:41:34.28,Default,,0,0,0,,Оның шынайы көрінгеніне таң қалдым.
Dialogue: 0,0:41:34.40,0:41:35.91,Default,,0,0,0,,Рас! Келіңіздер -
Dialogue: 0,0:41:36.28,0:41:37.62,Default,,0,0,0,,Біз де қолымыздан келгеннің бәрін жасаймыз.
Dialogue: 0,0:41:37.74,0:41:39.41,Default,,0,0,0,,Мен әрекет етуім керек! (Нобита және басқалар) Иә!
Dialogue: 0,0:41:39.83,0:41:42.16,Default,,0,0,0,,Оны ұстап алсаң, сауап аласың.
Dialogue: 0,0:41:42.29,0:41:43.45,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:41:43.58,0:41:44.71,Default,,0,0,0,,Уф...
Dialogue: 0,0:41:45.37,0:41:47.88,Default,,0,0,0,,Күте тұрыңыз, ғарыш қарақшылары! (үшін) иә?
Dialogue: 0,0:41:50.38,0:41:51.30,Default,,0,0,0,,Ах!
Dialogue: 0,0:41:51.55,0:41:53.17,Default,,0,0,0,,Әлемнің тыныштығын қорғау
Dialogue: 0,0:41:53.55,0:41:55.30,Default,,0,0,0,,Жаман жігіттерді жарып жібер
Dialogue: 0,0:41:55.93,0:41:56.80,Default,,0,0,0,,Уау аа
Dialogue: 0,0:41:59.72,0:42:01.81,Default,,0,0,0,,Мен таң қалдым (Сунео) Ах~
Dialogue: 0,0:42:01.97,0:42:03.81,Default,,0,0,0,,Ауырды, ауырады, ауырады...
Dialogue: 0,0:42:03.93,0:42:05.52,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:42:06.19,0:42:07.69,Default,,0,0,0,,Әй, эй, ә!
Dialogue: 0,0:42:08.35,0:42:09.48,Default,,0,0,0,,Мен қиындыққа тап болдым!
Dialogue: 0,0:42:09.61,0:42:12.11,Default,,0,0,0,,Маған шешуші жол аяқталғанша күту керек!
Dialogue: 0,0:42:12.69,0:42:13.78,Default,,0,0,0,,Сәлем! Ах!
Dialogue: 0,0:42:13.90,0:42:15.69,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:42:16.11,0:42:17.45,Default,,0,0,0,,Дораэмон тез!
Dialogue: 0,0:42:17.57,0:42:18.74,Default,,0,0,0,,Не болса да, енді ешкімді ешқашан тастап кетпеймін.
Dialogue: 0,0:42:19.53,0:42:22.24,Default,,0,0,0,,Жарайды… Атчи Атчи Атчи…
Dialogue: 0,0:42:22.87,0:42:23.74,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:42:25.70,0:42:26.75,Default,,0,0,0,,Хаа~
Dialogue: 0,0:42:26.87,0:42:29.46,Default,,0,0,0,,Директор: Бұл жау аздап артық емес пе?
Dialogue: 0,0:42:29.58,0:42:31.84,Default,,0,0,0,,Иә, бірдеңе дұрыс емес.
Dialogue: 0,0:42:31.96,0:42:34.05,Default,,0,0,0,,Дыбыстық сигнал дыбыстық сигнал сигналы сигналдық сигнал
Dialogue: 0,0:42:34.17,0:42:35.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:36.34,0:42:37.30,Default,,0,0,0,,А, м...
Dialogue: 0,0:42:37.42,0:42:39.26,Default,,0,0,0,,...
Dialogue: 0,0:42:39.39,0:42:41.10,Default,,0,0,0,,«Мен бұл туралы білмеймін»?
Dialogue: 0,0:42:41.22,0:42:43.35,Default,,0,0,0,,Упипи Упи Упи
Dialogue: 0,0:42:43.47,0:42:46.64,Default,,0,0,0,,«Өмірді бағалаңыз және сәттілік үшін дұға етіңіз»
Dialogue: 0,0:42:47.43,0:42:48.60,Default,,0,0,0,,Яғни...
Dialogue: 0,0:42:49.06,0:42:49.90,Default,,0,0,0,,Бұл...
Dialogue: 0,0:42:50.23,0:42:52.48,Default,,0,0,0,,Ал... (Нобита) Күтпеген жерден...
Dialogue: 0,0:42:52.77,0:42:54.69,Default,,0,0,0,,Шынайы! ?
Dialogue: 0,0:42:54.82,0:42:56.49,Default,,0,0,0,,Солай сияқты...
Dialogue: 0,0:42:56.94,0:43:00.57,Default,,0,0,0,,Шындық шындықты білдіреді, солай ма?
Dialogue: 0,0:43:00.70,0:43:01.62,Default,,0,0,0,,Ха!
Dialogue: 0,0:43:04.24,0:43:07.66,Default,,0,0,0,,Кешіріңіз, мен жай ғана...
Dialogue: 0,0:43:08.54,0:43:11.38,Default,,0,0,0,,Ах... Арон...
Dialogue: 0,0:43:13.42,0:43:15.59,Default,,0,0,0,,үшінна! Оны барынша пайдаланайық!
Dialogue: 0,0:43:15.71,0:43:16.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:18.09,0:43:21.30,Default,,0,0,0,,Түсіндім! Біздің костюмдер шынайы
Dialogue: 0,0:43:21.43,0:43:23.47,Default,,0,0,0,,Иә! Мен Ааронға көмектесуім керек.
Dialogue: 0,0:43:23.60,0:43:25.81,Default,,0,0,0,,О, жасайық!
Dialogue: 0,0:43:25.93,0:43:26.77,Default,,0,0,0,,Иә!
Dialogue: 0,0:43:27.14,0:43:29.89,Default,,0,0,0,,Балалар! біз Харонды тұтқынға аламыз
Dialogue: 0,0:43:32.56,0:43:34.82,Default,,0,0,0,,Мені бұл жерде ұстау мүмкін емес...
Dialogue: 0,0:43:35.48,0:43:37.61,Default,,0,0,0,,Осылай, қарақшылар, иә?
Dialogue: 0,0:43:37.74,0:43:39.15,Default,,0,0,0,,Дұрыс, болды!
Dialogue: 0,0:43:42.03,0:43:43.87,Default,,0,0,0,,үшінна! (Күзетші) Әй
Dialogue: 0,0:43:43.99,0:43:46.66,Default,,0,0,0,,Өкінбей істе... Жасай бер!
Dialogue: 0,0:43:48.95,0:43:52.33,Default,,0,0,0,,Хирари плащы!
Dialogue: 0,0:43:52.88,0:43:53.75,Default,,0,0,0,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:43:53.88,0:43:55.59,Default,,0,0,0,,Ооо (күзетші) О!
Dialogue: 0,0:43:58.17,0:44:00.05,Default,,0,0,0,,Ғажайып динамиттер -
Dialogue: 0,0:44:00.17,0:44:02.22,Default,,0,0,0,,Жақсы лақтыру! (Күзетшілер) Уау!
Dialogue: 0,0:44:02.34,0:44:04.22,Default,,0,0,0,,...
Dialogue: 0,0:44:04.51,0:44:06.76,Default,,0,0,0,,Уау!
Dialogue: 0,0:44:08.97,0:44:11.39,Default,,0,0,0,,Бұрғылау шабуылы!
Dialogue: 0,0:44:15.11,0:44:16.61,Default,,0,0,0,,Көмектесіңіз!
Dialogue: 0,0:44:16.73,0:44:18.44,Default,,0,0,0,,Мен сенің қашып кетуіңе жол бермеймін! (Күзетші) Эй!
Dialogue: 0,0:44:18.57,0:44:22.45,Default,,0,0,0,,Супер Нобита... (Күзетші) Ах...
Dialogue: 0,0:44:22.57,0:44:23.20,Default,,0,0,0,,Сыпырғыш
Dialogue: 0,0:44:24.24,0:44:26.20,Default,,0,0,0,,Ууу...
Dialogue: 0,0:44:27.37,0:44:29.08,Default,,0,0,0,,Не? Тецу
Dialogue: 0,0:44:29.20,0:44:31.37,Default,,0,0,0,,Сіз тағы да бесік ойнайсыз ба?
Dialogue: 0,0:44:31.50,0:44:34.17,Default,,0,0,0,,Жоқ, барлығына!
Dialogue: 0,0:44:34.88,0:44:36.92,Default,,0,0,0,,Аарон! ха ха ха ха
Dialogue: 0,0:44:37.04,0:44:38.71,Default,,0,0,0,,Галактикалық қорғаныс күштері күткендей!
Dialogue: 0,0:44:38.84,0:44:40.71,Default,,0,0,0,,Мен сені тез жеңгеніме сене алар емеспін.
Dialogue: 0,0:44:40.84,0:44:43.72,Default,,0,0,0,,Сіз өте әлсізсіз (Сунео)
Dialogue: 0,0:44:43.84,0:44:44.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:46.80,0:44:48.18,Default,,0,0,0,,Әлі де қарақшылар тобы
Dialogue: 0,0:44:48.43,0:44:49.68,Default,,0,0,0,,Иә, көріскенше...
Dialogue: 0,0:44:49.81,0:44:52.68,Default,,0,0,0,,Менің достарым келе жатыр, тезірек осы жерден кетейік.
Dialogue: 0,0:44:53.27,0:44:56.11,Default,,0,0,0,,Жасыратын жер бар.
Dialogue: 0,0:44:58.15,0:45:01.44,Default,,0,0,0,,Уау, бұл өте ұзын туннель.
Dialogue: 0,0:45:01.57,0:45:03.20,Default,,0,0,0,,Бұл ескі жер асты су жолы.
Dialogue: 0,0:45:03.78,0:45:07.49,Default,,0,0,0,,Мұның сыртында мен ғана білетін бір құпия бар.
Dialogue: 0,0:45:07.62,0:45:08.83,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:45:09.87,0:45:11.83,Default,,0,0,0,,Өтірікші! Директор Хебо!
Dialogue: 0,0:45:12.16,0:45:13.33,Default,,0,0,0,,Pi~
Dialogue: 0,0:45:13.79,0:45:15.83,Default,,0,0,0,,Мен оны басқарып тұрғандай кейіп таныттым.
Dialogue: 0,0:45:16.08,0:45:18.34,Default,,0,0,0,,Мен саған о бастан сенбедім.
Dialogue: 0,0:45:18.63,0:45:20.84,Default,,0,0,0,,Жалған Бургер Даме Бургер
Dialogue: 0,0:45:21.09,0:45:23.01,Default,,0,0,0,,Мен сені қатты кінәлағаным үшін ренжідім.
Dialogue: 0,0:45:23.13,0:45:24.55,Default,,0,0,0,,Пипи~!
Dialogue: 0,0:45:24.68,0:45:26.05,Default,,0,0,0,,Дыбыстық сигнал сигналы!
Dialogue: 0,0:45:26.18,0:45:28.05,Default,,0,0,0,,Эй, тәтті бургер
Dialogue: 0,0:45:28.18,0:45:29.81,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:45:29.93,0:45:30.76,Default,,0,0,0,,Не!
Dialogue: 0,0:45:30.89,0:45:32.93,Default,,0,0,0,,Міне, міне... мынау!
Dialogue: 0,0:45:33.06,0:45:34.85,Default,,0,0,0,,үшінмыз, біз келдік.
Dialogue: 0,0:45:46.57,0:45:48.87,Default,,0,0,0,,Уау... О, міне!
Dialogue: 0,0:45:49.41,0:45:53.75,Default,,0,0,0,,Мен мұнда жиі ойланып жалғыз келемін.
Dialogue: 0,0:45:53.87,0:45:56.17,Default,,0,0,0,,Әй, арқа тауымдай.
Dialogue: 0,0:45:56.29,0:45:57.12,Default,,0,0,0,,Хехехе
Dialogue: 0,0:45:58.17,0:45:59.50,Default,,0,0,0,,Осы жерден—
Dialogue: 0,0:45:59.63,0:46:03.01,Default,,0,0,0,,Сіз бүкіл қаланы және Поккурулендті көре аласыз.
Dialogue: 0,0:46:04.05,0:46:06.01,Default,,0,0,0,,Қарақшылар мені таба ма?
Dialogue: 0,0:46:06.76,0:46:10.22,Default,,0,0,0,,Меніңше, ішін сыртынан көру қиын...
Dialogue: 0,0:46:10.35,0:46:13.02,Default,,0,0,0,,Қауіпсіз баспана тұрғызайық
Dialogue: 0,0:46:16.52,0:46:19.69,Default,,0,0,0,,Бұл жасырын ба? Ал, қараңызшы
Dialogue: 0,0:46:20.48,0:46:23.15,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:46:29.49,0:46:30.53,Default,,0,0,0,,Иә
Dialogue: 0,0:46:31.37,0:46:34.91,Default,,0,0,0,,Ал су...
Dialogue: 0,0:46:36.87,0:46:39.21,Default,,0,0,0,,Ой! о!
Dialogue: 0,0:46:39.83,0:46:42.59,Default,,0,0,0,,Енді сізде жер астында құпия база бар.
Dialogue: 0,0:46:43.17,0:46:46.47,Default,,0,0,0,,Бұл аймақ шлагбауммен қорғалған, сондықтан уайымдаудың қажеті жоқ.
Dialogue: 0,0:46:46.88,0:46:49.43,Default,,0,0,0,,Қане, бәріміз, менің артымнан еріңдер!
Dialogue: 0,0:46:49.55,0:46:51.80,Default,,0,0,0,,Хехехе!
Dialogue: 0,0:46:51.93,0:46:54.43,Default,,0,0,0,,Сәлем! Болды
Dialogue: 0,0:46:55.14,0:46:57.35,Default,,0,0,0,,Эй (Нобита) Дұрыс.
Dialogue: 0,0:46:57.52,0:47:00.40,Default,,0,0,0,,Міне! Yahoo!
Dialogue: 0,0:47:00.52,0:47:03.57,Default,,0,0,0,,Жақсы, yahoo! Уау хехе
Dialogue: 0,0:47:03.69,0:47:05.48,Default,,0,0,0,,Уау! Хахаха
Dialogue: 0,0:47:05.61,0:47:10.70,Default,,0,0,0,,(Нобитаның толқыған дауысы)
Dialogue: 0,0:47:12.07,0:47:15.41,Default,,0,0,0,,Уау! Бару...
Dialogue: 0,0:47:15.54,0:47:16.87,Default,,0,0,0,,Нобита-сан
Dialogue: 0,0:47:17.00,0:47:20.25,Default,,0,0,0,,Рахмет, иә?
Dialogue: 0,0:47:20.92,0:47:24.25,Default,,0,0,0,,Қанша адам болса, сонша бөлме бар, ұнағанын пайдаланыңыз.
Dialogue: 0,0:47:25.09,0:47:27.71,Default,,0,0,0,,Қорғаныс күштерінің жұмбақ құралдары бар, солай емес пе?
Dialogue: 0,0:47:27.84,0:47:30.51,Default,,0,0,0,,Иә? Хмм...
Dialogue: 0,0:47:30.76,0:47:32.64,Default,,0,0,0,,Сондай-ақ, бір сәтке тоқтаңыз.
Dialogue: 0,0:47:32.76,0:47:35.01,Default,,0,0,0,,Жоқ! Менің ішім шіріп кетті!
Dialogue: 0,0:47:35.56,0:47:38.10,Default,,0,0,0,,Қазір ойлап қарасам, қарным ашты.
Dialogue: 0,0:47:38.23,0:47:41.90,Default,,0,0,0,,Олай болса, жоғарғы шаршыдағы ағаш дәмді жеміс береді.
Dialogue: 0,0:47:42.02,0:47:43.27,Default,,0,0,0,,О, шынымен!
Dialogue: 0,0:47:43.90,0:47:45.82,Default,,0,0,0,,Сәл күте тұрыңыз.
Dialogue: 0,0:47:46.19,0:47:49.70,Default,,0,0,0,,Тамақтанып болған соң кеш болды, жатайық.
Dialogue: 0,0:47:50.78,0:47:52.95,Default,,0,0,0,,Бейджді алып тастаған кезде костюм жоғалады.
Dialogue: 0,0:47:54.70,0:47:56.33,Default,,0,0,0,,Ах...фуу
Dialogue: 0,0:47:57.33,0:47:59.96,Default,,0,0,0,,Айтпақшы, барлығыңыз не істеуді жоспарлап отырсыздар?
Dialogue: 0,0:48:00.66,0:48:02.71,Default,,0,0,0,,Сіз не істемексіз? (Сунео) Қазірдің өзінде!
Dialogue: 0,0:48:02.92,0:48:06.42,Default,,0,0,0,,Бұл фотосессия емес, шынайы.
Dialogue: 0,0:48:06.55,0:48:07.46,Default,,0,0,0,,Upip
Dialogue: 0,0:48:07.71,0:48:09.05,Default,,0,0,0,,О, дұрыс.
Dialogue: 0,0:48:09.17,0:48:12.47,Default,,0,0,0,,Мен бұл планетада қалып, ауыр жарақат алсам ше?
Dialogue: 0,0:48:12.80,0:48:15.47,Default,,0,0,0,,Мен Ааронға көмектесуді жөн көрдім!
Dialogue: 0,0:48:15.76,0:48:17.18,Default,,0,0,0,,Иә, бірақ—
Dialogue: 0,0:48:17.31,0:48:19.98,Default,,0,0,0,,Ғарыш қарақшыларын шынымен жеңе аламыз ба деп ойлаймын...
Dialogue: 0,0:48:20.39,0:48:22.89,Default,,0,0,0,,Бұрынғы жігіттер сондай әлсіз.
Dialogue: 0,0:48:23.02,0:48:25.48,Default,,0,0,0,,Бастық үшін бұл үлкен мәселе емес пе?
Dialogue: 0,0:48:25.73,0:48:26.77,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:48:26.90,0:48:29.82,Default,,0,0,0,,Бізде тіпті кейіпкерлердің костюмдері мен Дораэмон құралдары бар!
Dialogue: 0,0:48:29.94,0:48:32.99,Default,,0,0,0,,Ең бастысы, мен Поккуру планетасын артта қалдырсам, үйге бара алмаймын.
Dialogue: 0,0:48:33.32,0:48:35.24,Default,,0,0,0,,Жасайық, Сунео
Dialogue: 0,0:48:35.49,0:48:37.16,Default,,0,0,0,,Хмм.
Dialogue: 0,0:48:37.62,0:48:39.75,Default,,0,0,0,,үшін осылай десе...
Dialogue: 0,0:48:40.08,0:48:41.33,Default,,0,0,0,,Содан кейін тағы да—
Dialogue: 0,0:48:41.75,0:48:44.67,Default,,0,0,0,,Біз, Галактикалық қорғаныс күштері, Поккуру планетасы үшін —
Dialogue: 0,0:48:44.79,0:48:47.00,Default,,0,0,0,,Ғарыш қарақшыларын жеңіңіз!
Dialogue: 0,0:48:47.13,0:48:48.09,Default,,0,0,0,,«Меро-Меро Ганнан» атылатын нәрсе – «махаббат күші»
Dialogue: 0,0:48:48.46,0:48:51.26,Default,,0,0,0,,Бұл үлкен мәселе болғандықтан, дұрыс суретке түсейік.
Dialogue: 0,0:48:51.38,0:48:52.76,Default,,0,0,0,,Упи хи хи
Dialogue: 0,0:48:52.88,0:48:54.84,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз (3 адам).
Dialogue: 0,0:48:56.26,0:48:57.60,Default,,0,0,0,,Папоротник талдың жемісі
Dialogue: 0,0:48:57.89,0:49:00.02,Default,,0,0,0,,Бұл өте тәтті және дәмді.
Dialogue: 0,0:49:00.14,0:49:02.18,Default,,0,0,0,,Уау, бұл дәмді көрінеді!
Dialogue: 0,0:49:02.31,0:49:05.15,Default,,0,0,0,,Менің қарным ашты (Сунео) Бұл менмін!
Dialogue: 0,0:49:05.27,0:49:06.61,Default,,0,0,0,,Тіпті оның есту қабілетінен айырылғаны туралы қауесет те бар
Dialogue: 0,0:49:07.06,0:49:09.82,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:49:09.94,0:49:11.23,Default,,0,0,0,,Өте тәтті!
Dialogue: 0,0:49:11.36,0:49:13.74,Default,,0,0,0,,Мм! Бұл дәмді!
Dialogue: 0,0:49:21.75,0:49:24.33,Default,,0,0,0,,Ей, жан досы!
Dialogue: 0,0:49:28.75,0:49:30.09,Default,,0,0,0,,Уф...
Dialogue: 0,0:49:31.21,0:49:32.80,Default,,0,0,0,,Аня, көпшіліктен қорықпайсың ба?
Dialogue: 0,0:49:38.93,0:49:41.10,Default,,0,0,0,,Әдемі костюм
Dialogue: 0,0:49:41.47,0:49:43.60,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:49:44.02,0:49:45.73,Default,,0,0,0,,(Дораэмонның ұйқы туралы әңгімесі)
Dialogue: 0,0:49:50.69,0:49:52.07,Default,,0,0,0,,Хото
Dialogue: 0,0:49:52.69,0:49:53.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:54.70,0:49:55.61,Default,,0,0,0,,Аарон
Dialogue: 0,0:49:59.70,0:50:00.87,Default,,0,0,0,,Нобита-сан
Dialogue: 0,0:50:03.70,0:50:05.79,Default,,0,0,0,,Мен қандай да бір себептермен ұйықтай алмаймын
Dialogue: 0,0:50:06.00,0:50:07.62,Default,,0,0,0,,Иә, мен де.
Dialogue: 0,0:50:08.71,0:50:10.21,Default,,0,0,0,,Рахмет
Dialogue: 0,0:50:10.34,0:50:13.00,Default,,0,0,0,,Осындай алыс жұлдызға келгеніңіз үшін рахмет.
Dialogue: 0,0:50:13.26,0:50:15.51,Default,,0,0,0,,Міне! ол туралы уайымдама
Dialogue: 0,0:50:15.92,0:50:18.01,Default,,0,0,0,,Фуфу (Нобита) Иә?
Dialogue: 0,0:50:19.26,0:50:20.60,Default,,0,0,0,,Мен әрқашан болдым
Dialogue: 0,0:50:20.72,0:50:24.52,Default,,0,0,0,,Мен тамаша істер жасаған әділдік батырларына тәнті болдым.
Dialogue: 0,0:50:25.02,0:50:28.31,Default,,0,0,0,,Осыны ескере отырып, мен ақыры шериф болдым...
Dialogue: 0,0:50:28.44,0:50:29.52,Default,,0,0,0,,Хехехе
Dialogue: 0,0:50:30.19,0:50:34.53,Default,,0,0,0,,Мен жаңадан бастаған кезімде мен әлі де керемет нәрсе жасауды армандайтынмын ...
Dialogue: 0,0:50:34.82,0:50:35.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:36.70,0:50:39.53,Default,,0,0,0,,Хехе... Бірақ мен мұны түсіндім.
Dialogue: 0,0:50:39.95,0:50:41.58,Default,,0,0,0,,Мұндай орындаудан да көп —
Dialogue: 0,0:50:41.70,0:50:44.95,Default,,0,0,0,,Жұлдыздар адамдарының кездейсоқ күлкілерін қорғауды жалғастырыңыз...
Dialogue: 0,0:50:45.08,0:50:47.54,Default,,0,0,0,,Бұл маңызды
Dialogue: 0,0:50:49.37,0:50:52.21,Default,,0,0,0,,Ал мен жүрегімде берік уәде бердім.
Dialogue: 0,0:50:52.34,0:50:55.34,Default,,0,0,0,,Осы күлкіні алып тастауға тырысатын біреу пайда болғанда...
Dialogue: 0,0:50:55.46,0:50:58.05,Default,,0,0,0,,Мен барлығын қорғауға бар күшімді саламын.
Dialogue: 0,0:51:00.30,0:51:02.26,Default,,0,0,0,,Арон – нағыз қаһарман.
Dialogue: 0,0:51:02.39,0:51:05.56,Default,,0,0,0,,Не? Жоқ, мен-
Dialogue: 0,0:51:05.68,0:51:08.56,Default,,0,0,0,,Менде сіздей ерекше күш жоқ...
Dialogue: 0,0:51:09.35,0:51:12.86,Default,,0,0,0,,Галактикалық қорғаныс күштері нағыз қаһармандар!
Dialogue: 0,0:51:12.98,0:51:13.82,Default,,0,0,0,,А...
Dialogue: 0,0:51:15.98,0:51:16.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:51:23.62,0:51:25.58,Default,,0,0,0,,Арон Иә
Dialogue: 0,0:51:26.66,0:51:29.75,Default,,0,0,0,,Білесіз бе, біз...
Dialogue: 0,0:51:30.42,0:51:31.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:32.08,0:51:32.92,Default,,0,0,0,,Хехе
Dialogue: 0,0:51:33.38,0:51:34.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:51:37.13,0:51:38.47,Default,,0,0,0,,Жоқ
Dialogue: 0,0:51:41.13,0:51:44.30,Default,,0,0,0,,Поккуру планетасын міндетті түрде қорғайық!
Dialogue: 0,0:51:44.43,0:51:45.31,Default,,0,0,0,,Хмм
Dialogue: 0,0:51:46.81,0:51:47.81,Default,,0,0,0,,Нобита-сан
Dialogue: 0,0:51:49.18,0:51:50.19,Default,,0,0,0,,Хехе
Dialogue: 0,0:52:28.10,0:52:30.89,Default,,0,0,0,,Ааронның бейбақ көмекшісімен қайтып келді.
Dialogue: 0,0:52:31.10,0:52:33.85,Default,,0,0,0,,Ол тірі болды ма? (Меба) Қыңыр бала
Dialogue: 0,0:52:33.98,0:52:34.90,Default,,0,0,0,,Wahoo
Dialogue: 0,0:52:35.36,0:52:37.57,Default,,0,0,0,,Олай болса, оны жіберіп, сол бөлікті ал?
Dialogue: 0,0:52:37.69,0:52:39.03,Default,,0,0,0,,кешіріңіз
Dialogue: 0,0:52:39.57,0:52:42.28,Default,,0,0,0,,Бастық, мұны қалайсыз?
Dialogue: 0,0:52:48.03,0:52:49.24,Default,,0,0,0,,Уау!
Dialogue: 0,0:52:50.58,0:52:53.92,Default,,0,0,0,,О, көмектесші... (миниондар) Эй!
Dialogue: 0,0:52:56.84,0:52:59.21,Default,,0,0,0,,Иә, пайдасыз.
Dialogue: 0,0:52:59.34,0:53:00.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:01.17,0:53:03.93,Default,,0,0,0,,Бастық, артық кетпегеніңіз дұрыс...
Dialogue: 0,0:53:04.05,0:53:05.18,Default,,0,0,0,,Шулы! Сәлем
Dialogue: 0,0:53:05.51,0:53:07.80,Default,,0,0,0,,Жоспардың орындалатын уақыты жақын
Dialogue: 0,0:53:07.93,0:53:11.18,Default,,0,0,0,,Сіздің жолыңызда тұрған кез келген адамды өлтіріңіз!
Dialogue: 0,0:53:11.64,0:53:12.93,Default,,0,0,0,,Хаха!
Dialogue: 0,0:53:13.85,0:53:14.69,Default,,0,0,0,,Сен тәжірибелер жүргізіп, пулемётпен оқ жаудырып жүрсің — нағыз ақымақсың.
Dialogue: 0,0:53:15.10,0:53:16.69,Default,,0,0,0,,Ол ол ол ол ол ол ол
Dialogue: 0,0:53:29.99,0:53:31.91,Default,,0,0,0,,Бұл планетаның күні ме?
Dialogue: 0,0:53:32.00,0:53:33.96,Default,,0,0,0,,Керемет! Жарқырап тұр
Dialogue: 0,0:53:34.08,0:53:35.42,Default,,0,0,0,,Керемет
Dialogue: 0,0:53:36.17,0:53:38.42,Default,,0,0,0,,Бұл жұлдызды біз «Алмас» деп атаймыз.
Dialogue: 0,0:53:38.84,0:53:41.67,Default,,0,0,0,,Алыстағы жұлдыздың жарығын шағылыстыру —
Dialogue: 0,0:53:41.80,0:53:44.42,Default,,0,0,0,,Поккуру жұлдызына жарық пен жылу береді
Dialogue: 0,0:53:44.76,0:53:47.39,Default,,0,0,0,,Бұл таптырмас шапағат жұлдызы.
Dialogue: 0,0:53:47.51,0:53:50.43,Default,,0,0,0,,Хмм, ғаламның жұмбағы, солай емес пе?
Dialogue: 0,0:53:50.89,0:53:54.43,Default,,0,0,0,,Олай болса, Арон-кун, бүгінгі іс-әрекеттің жоспарын құрайық.
Dialogue: 0,0:53:54.81,0:53:55.69,Default,,0,0,0,,Иә!
Dialogue: 0,0:54:01.48,0:54:03.44,Default,,0,0,0,,Бұл Поккуру жерлерінің бірі.
Dialogue: 0,0:54:03.57,0:54:04.69,Default,,0,0,0,,Ыстық бұлақ аймағы
Dialogue: 0,0:54:05.61,0:54:08.20,Default,,0,0,0,,Бұл біз кеше түнде болған ойын-сауық саябағы.
Dialogue: 0,0:54:09.03,0:54:11.70,Default,,0,0,0,,Бұл шығанақтың ортасында орналасқан мұнара —
Dialogue: 0,0:54:12.12,0:54:15.25,Default,,0,0,0,,Басқа планеталардан жолаушылар тасымалдайтын кемелерді қарсы алу —
Dialogue: 0,0:54:15.37,0:54:18.21,Default,,0,0,0,,Ғарыш әуежайындағы ғарыш мұнарасы
Dialogue: 0,0:54:18.79,0:54:21.46,Default,,0,0,0,,А... Сонда қарақшының мақсаты не?
Dialogue: 0,0:54:21.80,0:54:24.17,Default,,0,0,0,,Иә, мен мұнараға енген кезде —
Dialogue: 0,0:54:24.30,0:54:27.13,Default,,0,0,0,,Мен білетін бір ғана нәрсе бар...
Dialogue: 0,0:54:27.68,0:54:29.43,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:54:29.55,0:54:33.72,Default,,0,0,0,,Біз Поккуру жерінің ашылу күніне бірдеңе жоспарлап жатырмыз...
Dialogue: 0,0:54:33.85,0:54:35.35,Default,,0,0,0,,Тек осы
Dialogue: 0,0:54:35.85,0:54:38.10,Default,,0,0,0,,Қашан? Бұл ашылу күні қандай?
Dialogue: 0,0:54:38.44,0:54:39.98,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:54:40.73,0:54:42.86,Default,,0,0,0,,Бұл ертең! Ертең! ?
Dialogue: 0,0:54:43.32,0:54:45.28,Default,,0,0,0,,Мен мұнымен оңайлықпен айналыса алмаймын.
Dialogue: 0,0:54:45.40,0:54:46.24,Default,,0,0,0,,Иә!
Dialogue: 0,0:54:46.65,0:54:48.45,Default,,0,0,0,,Мен Конгресс мүшелерімен тағы да сөйлестім.
Dialogue: 0,0:54:48.57,0:54:50.82,Default,,0,0,0,,Мен келе жатқан дағдарысқа шағымданамын.
Dialogue: 0,0:54:50.95,0:54:54.49,Default,,0,0,0,,Жалғыз болу қауіпті! Мен де сенімен барамын.
Dialogue: 0,0:54:54.83,0:54:57.54,Default,,0,0,0,,Мен Нобитаның қасымда болғанына көбірек алаңдаймын.
Dialogue: 0,0:54:57.66,0:54:58.75,Default,,0,0,0,,Жарайды! (2 адам) Иә?
Dialogue: 0,0:54:59.42,0:55:01.75,Default,,0,0,0,,Мен сені жақсы қорғаймын!
Dialogue: 0,0:55:01.88,0:55:03.00,Default,,0,0,0,,Нобита-сан!
Dialogue: 0,0:55:03.25,0:55:06.17,Default,,0,0,0,,Нобита... (Сунео) батыл болса да
Dialogue: 0,0:55:06.30,0:55:10.51,Default,,0,0,0,,Қарақшылардың әлі де түсініксіз жоспарларын білейік.
Dialogue: 0,0:55:10.89,0:55:13.26,Default,,0,0,0,,Жақсы! Біз ойын-сауық саябағының аумағындамыз
Dialogue: 0,0:55:13.68,0:55:16.14,Default,,0,0,0,,Кешегідей ойнама
Dialogue: 0,0:55:16.27,0:55:18.02,Default,,0,0,0,,Tsk! Мен білемін
Dialogue: 0,0:55:19.06,0:55:21.15,Default,,0,0,0,,Ыстық бұлақ аймағына барайық!
Dialogue: 0,0:55:21.27,0:55:22.81,Default,,0,0,0,,Түсінді (Директор Бергер) Пуппи.
Dialogue: 0,0:55:23.31,0:55:26.53,Default,,0,0,0,,Сенаторлармен кездескеннен кейін Ғарыш мұнарасына барыңыз.
Dialogue: 0,0:55:26.65,0:55:28.49,Default,,0,0,0,,Иә! Жарайды!
Dialogue: 0,0:55:28.61,0:55:31.87,Default,,0,0,0,,Олай болса, таңғы асты жақсылап ішіп ал да кет!
Dialogue: 0,0:55:31.99,0:55:32.82,Default,,0,0,0,,Иә (Нобита) Иә.
Dialogue: 0,0:55:33.91,0:55:36.87,Default,,0,0,0,,Дастарханға арналған ілгіш!
Dialogue: 0,0:55:37.12,0:55:39.33,Default,,0,0,0,,котлет ыдысының 7 порциясы!
Dialogue: 0,0:55:40.37,0:55:42.54,Default,,0,0,0,,Уау, бұл дәмді көрінеді!
Dialogue: 0,0:55:42.67,0:55:45.17,Default,,0,0,0,,Уау (Сунео) Кацудон таңертең?
Dialogue: 0,0:55:45.30,0:55:47.30,Default,,0,0,0,,«Жауды жеңу» дейсіз бе?
Dialogue: 0,0:55:47.42,0:55:48.84,Default,,0,0,0,,Дәмді! (3 адам) Иә?
Dialogue: 0,0:55:49.17,0:55:51.63,Default,,0,0,0,,Мен мұндай дәмді нәрсені бірінші рет жеп отырмын.
Dialogue: 0,0:55:51.76,0:55:53.34,Default,,0,0,0,,Біз де тез тамақтанып алайық!
Dialogue: 0,0:55:54.10,0:55:57.56,Default,,0,0,0,,Итадакимасу! (Бургер директоры) Пипи
Dialogue: 0,0:56:01.52,0:56:02.85,Default,,0,0,0,,Хехехе
Dialogue: 0,0:56:05.73,0:56:08.86,Default,,0,0,0,,Галактикалық қорғаныс күштерінің костюмі жабдықталған!
Dialogue: 0,0:56:15.20,0:56:16.49,Default,,0,0,0,,Орнату аяқталды!
Dialogue: 0,0:56:16.79,0:56:18.12,Default,,0,0,0,,Жалғасы көрінбейтін жадағай —
Dialogue: 0,0:56:18.24,0:56:20.21,Default,,0,0,0,,Баспропеллер орнатылды!
Dialogue: 0,0:56:23.17,0:56:24.08,Default,,0,0,0,,Хой
Dialogue: 0,0:56:27.30,0:56:30.67,Default,,0,0,0,,Енді барлығының бөлмесі жөнелтуге арналған ұшыру алаңына айналды.
Dialogue: 0,0:56:31.30,0:56:34.14,Default,,0,0,0,,~ Бұл керемет! Ха~
Dialogue: 0,0:56:34.26,0:56:35.80,Default,,0,0,0,,О (2 адам) Уа!
Dialogue: 0,0:56:36.35,0:56:38.47,Default,,0,0,0,,О, ә...
Dialogue: 0,0:56:38.72,0:56:40.06,Default,,0,0,0,,Өйткені бұл үлкен мәселе...
Dialogue: 0,0:56:43.23,0:56:47.15,Default,,0,0,0,,(Топ өнімділігі)
Dialogue: 0,0:56:47.48,0:56:49.65,Default,,0,0,0,,Барған сайын қызықты болып барады.
Dialogue: 0,0:56:50.36,0:56:54.03,Default,,0,0,0,,Галактикалық қорғаныс күштері Дораемон жіберілді!
Dialogue: 0,0:57:04.67,0:57:05.50,Default,,0,0,0,,Хамф!
Dialogue: 0,0:57:05.88,0:57:06.84,Default,,0,0,0,,Джан (Сунео) Сунео
Dialogue: 0,0:57:06.96,0:57:08.13,Default,,0,0,0,,Шизука Бургер-чан
Dialogue: 0,0:57:08.25,0:57:09.38,Default,,0,0,0,,Арон (Нобита) Нобита
Dialogue: 0,0:57:09.84,0:57:11.17,Default,,0,0,0,,Жіберу!
Dialogue: 0,0:57:21.47,0:57:23.64,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:57:23.77,0:57:25.15,Default,,0,0,0,,Мектеп оқушысы үшін ол өзімен бірге таңғаларлықтай 50 000 йен алып жүр
Dialogue: 0,0:57:30.23,0:57:33.28,Default,,0,0,0,,Нобита осында!
Dialogue: 0,0:57:33.40,0:57:34.32,Default,,0,0,0,,Кяах! Иә...
Dialogue: 0,0:57:34.45,0:57:35.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:57:36.45,0:57:39.62,Default,,0,0,0,,Уау! Нобита-сан!
Dialogue: 0,0:57:39.99,0:57:41.37,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:57:41.87,0:57:45.08,Default,,0,0,0,,Оған көмектесу мүмкін емес. Сіз оны жылдам қайтара аласыз ба?
Dialogue: 0,0:57:45.21,0:57:46.12,Default,,0,0,0,,Upip
Dialogue: 0,0:57:46.33,0:57:49.13,Default,,0,0,0,,Жылдам кері айналдыру? Директор... О, жоқ...
Dialogue: 0,0:57:49.25,0:57:52.13,Default,,0,0,0,,Көшбасшылардың ерекше дағдысы бар: жылдам кері айналдыру.
Dialogue: 0,0:57:52.42,0:57:54.63,Default,,0,0,0,,Не істесең де, тез істе.
Dialogue: 0,0:57:54.97,0:57:56.84,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:57:56.97,0:58:00.10,Default,,0,0,0,,ұшыру алаңында тек Нобита-кун тұрған көрініске жылдам алға.
Dialogue: 0,0:58:00.22,0:58:01.85,Default,,0,0,0,,Бастау! (Директор Бергер) Упип
Dialogue: 0,0:58:01.97,0:58:04.52,Default,,0,0,0,,Упипип!
Dialogue: 0,0:58:06.35,0:58:08.27,Default,,0,0,0,,Ах... Нобита...
Dialogue: 0,0:58:08.81,0:58:10.02,Default,,0,0,0,,Мен ерте оралдым!
Dialogue: 0,0:58:13.23,0:58:15.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:58:16.24,0:58:17.36,Default,,0,0,0,,Мен қайтып келдім!
Dialogue: 0,0:58:17.74,0:58:19.82,Default,,0,0,0,,Тынымсыз еңбегіңіз үшін рахмет (Директор Бергер) Упи
Dialogue: 0,0:58:19.95,0:58:22.62,Default,,0,0,0,,(Топ өнімділігі)
Dialogue: 0,0:58:22.95,0:58:26.92,Default,,0,0,0,,Жарайды, келесі жолы! Нобита жіберілді!
Dialogue: 0,0:58:35.26,0:58:36.59,Default,,0,0,0,,(Декү) Кешір мені (Каири) Ах…
Dialogue: 0,0:58:36.72,0:58:38.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:58:38.55,0:58:40.39,Default,,0,0,0,,Қазірдің өзінде! Ахх...
Dialogue: 0,0:58:41.05,0:58:44.39,Default,,0,0,0,,Өйткені, Нобита... Нобита.
Dialogue: 0,0:58:44.81,0:58:49.10,Default,,0,0,0,,Қазірдің өзінде... неге?
Dialogue: 0,0:58:51.69,0:58:54.28,Default,,0,0,0,,үшінңыз, араласпауға тырысыңыз.
Dialogue: 0,0:58:54.40,0:58:55.40,Default,,0,0,0,,Иә!
Dialogue: 0,0:58:56.19,0:58:58.36,Default,,0,0,0,,Бұл парламент мүшелері орналасқан палата.
Dialogue: 0,0:58:59.24,0:59:04.41,Default,,0,0,0,,(Тұрғындардың күлкісі)
Dialogue: 0,0:59:04.54,0:59:05.37,Default,,0,0,0,,Не?
Dialogue: 0,0:59:06.70,0:59:09.08,Default,,0,0,0,,Біз ертеңгі ашылу салтанатына дайындалып жатырмыз.
Dialogue: 0,0:59:09.21,0:59:10.71,Default,,0,0,0,,өтіңіз!
Dialogue: 0,0:59:10.83,0:59:13.25,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:59:16.80,0:59:18.22,Default,,0,0,0,,Не болып жатыр...
Dialogue: 0,0:59:18.34,0:59:19.76,Default,,0,0,0,,Шынымен де осы планетада...
Dialogue: 0,0:59:20.09,0:59:22.89,Default,,0,0,0,,Дағдарыс жақындап қалды ма?
Dialogue: 0,0:59:23.10,0:59:26.93,Default,,0,0,0,,Хмм... Әйтеуір, тергеуді жалғастырайық.
Dialogue: 0,0:59:27.06,0:59:28.18,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:59:32.94,0:59:34.86,Default,,0,0,0,,Қарақшылар жоқ сияқты.
Dialogue: 0,0:59:35.28,0:59:37.61,Default,,0,0,0,,Нобита-сан, осында қалшы.
Dialogue: 0,0:59:37.74,0:59:39.86,Default,,0,0,0,,Сақ болыңыз, иә
Dialogue: 0,0:59:44.37,0:59:45.49,Default,,0,0,0,,Әй, Арон!
Dialogue: 0,0:59:45.62,0:59:47.45,Default,,0,0,0,,Аарон!
Dialogue: 0,0:59:47.58,0:59:50.29,Default,,0,0,0,,Қараңызшы, бұл жақсы, солай емес пе?
Dialogue: 0,0:59:51.12,0:59:52.46,Default,,0,0,0,,Сіз оны жасадыңыз ба?
Dialogue: 0,0:59:52.58,0:59:54.50,Default,,0,0,0,,Бәріміз бірге жасадық.
Dialogue: 0,0:59:54.63,0:59:56.09,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:59:56.21,0:59:58.30,Default,,0,0,0,,Конгрессмен Арон Ха!
Dialogue: 0,0:59:58.76,1:00:01.80,Default,,0,0,0,,Бір секунд үшін кешіріңіз. Ах, Арон...
Dialogue: 0,1:00:02.22,1:00:05.68,Default,,0,0,0,,Не болды? Сен кеше келмедің...
Dialogue: 0,1:00:06.01,1:00:07.43,Default,,0,0,0,,А, мүмкін тағы да...
Dialogue: 0,1:00:07.56,1:00:10.98,Default,,0,0,0,,Ғарыш серіктесі туралы бірдеңе...
Dialogue: 0,1:00:11.60,1:00:15.44,Default,,0,0,0,,Сенатор: Күткендей, бұл балалар шынымен ғарыштық қарақшылар еді!
Dialogue: 0,1:00:15.94,1:00:17.94,Default,,0,0,0,,үшінңыз тыңдаңыздар!
Dialogue: 0,1:00:18.19,1:00:19.74,Default,,0,0,0,,Уақыт өтіп жатыр!
Dialogue: 0,1:00:19.86,1:00:22.70,Default,,0,0,0,,Біз олардың жоспарын тезірек тоқтатуымыз керек!
Dialogue: 0,1:00:23.11,1:00:25.62,Default,,0,0,0,,Бұл жоспар қандай?
Dialogue: 0,1:00:25.74,1:00:27.20,Default,,0,0,0,,Бұл әлі...
Dialogue: 0,1:00:27.70,1:00:28.91,Default,,0,0,0,,Бірақ ертең...
Dialogue: 0,1:00:29.04,1:00:31.66,Default,,0,0,0,,Ол қайтымсыз болуы мүмкін!
Dialogue: 0,1:00:31.79,1:00:34.21,Default,,0,0,0,,Әлі де олай істемеймін...
Dialogue: 0,1:00:34.33,1:00:37.55,Default,,0,0,0,,Олар ауыл жұлдызының дамуы туралы осылай ойлайды.
Dialogue: 0,1:00:37.67,1:00:40.17,Default,,0,0,0,,Олар мейірімді адамдар емес пе? (Тұрғындар) Иә, иә.
Dialogue: 0,1:00:40.80,1:00:44.18,Default,,0,0,0,,Бұл олардың маған сену үшін жасаған айласы!
Dialogue: 0,1:00:44.30,1:00:46.26,Default,,0,0,0,,Шамасы, Аарон бала кезінен...
Dialogue: 0,1:00:46.39,1:00:48.68,Default,,0,0,0,,Өйткені менің болжамдарым күшті.
Dialogue: 0,1:00:48.81,1:00:49.93,Default,,0,0,0,,Иә, Арон...
Dialogue: 0,1:00:50.06,1:00:51.48,Default,,0,0,0,,Ахахаха…
Dialogue: 0,1:00:51.89,1:00:54.56,Default,,0,0,0,,Бұл планетаның адамдары жақсы адамдар.
Dialogue: 0,1:00:54.69,1:00:57.73,Default,,0,0,0,,Ал сендер қарақшылар! иә?
Dialogue: 0,1:00:58.69,1:00:59.53,Default,,0,0,0,,Міне!
Dialogue: 0,1:01:02.86,1:01:05.37,Default,,0,0,0,,Бұл жақсы емес! Аронға қауіп төніп тұр!
Dialogue: 0,1:01:05.99,1:01:07.41,Default,,0,0,0,,Иә!
Dialogue: 0,1:01:08.99,1:01:11.20,Default,,0,0,0,,Ei (күзетші) Оророро...
Dialogue: 0,1:01:11.33,1:01:13.50,Default,,0,0,0,,О, не, не? (Нобита) Қарғыс атсын...
Dialogue: 0,1:01:13.83,1:01:16.50,Default,,0,0,0,,Хмм, енді ашуланба.
Dialogue: 0,1:01:16.92,1:01:19.25,Default,,0,0,0,,Эй, күт!
Dialogue: 0,1:01:19.38,1:01:23.88,Default,,0,0,0,,Иә? Апыр-ай! (Күзетші) Уау!
Dialogue: 0,1:01:24.01,1:01:27.18,Default,,0,0,0,,(Екі дүрбелең дауысы)
Dialogue: 0,1:01:29.39,1:01:30.31,Default,,0,0,0,,Уау!
Dialogue: 0,1:01:31.56,1:01:33.56,Default,,0,0,0,,Уау! Гю…
Dialogue: 0,1:01:33.77,1:01:36.60,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,1:01:36.90,1:01:40.02,Default,,0,0,0,,Не! Біреу тоқтат!
Dialogue: 0,1:01:40.53,1:01:42.53,Default,,0,0,0,,(Нобитаның ыңырсыуы)
Dialogue: 0,1:01:42.65,1:01:44.82,Default,,0,0,0,,Ааааа... ау!
Dialogue: 0,1:01:46.91,1:01:49.37,Default,,0,0,0,,Уау!
Dialogue: 0,1:01:49.49,1:01:52.62,Default,,0,0,0,,Уф! Ах...
Dialogue: 0,1:01:52.75,1:01:56.71,Default,,0,0,0,,Маған бұл не деген қызық...
Dialogue: 0,1:02:00.17,1:02:02.63,Default,,0,0,0,,Ертең міндетті түрде келіңіз!
Dialogue: 0,1:02:02.76,1:02:05.26,Default,,0,0,0,,Арон, бұл уәде.
Dialogue: 0,1:02:06.09,1:02:07.09,Default,,0,0,0,,Хмм...
Dialogue: 0,1:02:08.64,1:02:12.27,Default,,0,0,0,,Нобита-сан, бұл біз ғана... Иә?
Dialogue: 0,1:02:12.77,1:02:14.14,Default,,0,0,0,,Нобита-сан?
Dialogue: 0,1:02:14.77,1:02:17.44,Default,,0,0,0,,А, бұл...
Dialogue: 0,1:02:18.77,1:02:20.40,Default,,0,0,0,,Нобита
Dialogue: 0,1:02:25.03,1:02:27.66,Default,,0,0,0,,(Тұрғындардың дауысы)
Dialogue: 0,1:02:27.78,1:02:30.32,Default,,0,0,0,,Бұл туралы күдікті ештеңе жоқ.
Dialogue: 0,1:02:30.45,1:02:32.12,Default,,0,0,0,,Осы мақсатқа жету үшін бәрін қолданамыз — Титан күшін де, сенің қаруларыңды да. ➡
Dialogue: 0,1:02:32.45,1:02:34.79,Default,,0,0,0,,Қандай ұят (3 адам) А?
Dialogue: 0,1:02:35.04,1:02:39.29,Default,,0,0,0,,Соңғы бірнеше күнде ыстық бұлақтың температурасы кенет төмендей бастады.
Dialogue: 0,1:02:39.54,1:02:42.21,Default,,0,0,0,,Ертең саябақтың ашылу күні.
Dialogue: 0,1:02:42.34,1:02:43.30,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,1:02:43.67,1:02:45.59,Default,,0,0,0,,Бірдеңе бар сияқты.
Dialogue: 0,1:02:45.72,1:02:47.43,Default,,0,0,0,,Басқа жерлерді тексерейік
Dialogue: 0,1:02:47.55,1:02:48.43,Default,,0,0,0,,Иә (Директор Бергер) Упип.
Dialogue: 0,1:02:49.43,1:02:53.01,Default,,0,0,0,,Сунео және басқалары дұрыс істеп жатыр ма?
Dialogue: 0,1:02:54.43,1:02:57.31,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,1:02:57.69,1:02:59.23,Default,,0,0,0,,Хаха, бұл керемет.
Dialogue: 0,1:02:59.35,1:03:01.86,Default,,0,0,0,,Хехе, эй!
Dialogue: 0,1:03:01.98,1:03:04.07,Default,,0,0,0,,Уа! Конняро!
Dialogue: 0,1:03:04.61,1:03:07.03,Default,,0,0,0,,Қалай қарасаң да, кәдімгі ойын-сауық саябағы ғой!
Dialogue: 0,1:03:07.15,1:03:09.20,Default,,0,0,0,,Осындай көлік болса не қызық болар еді?
Dialogue: 0,1:03:09.32,1:03:11.16,Default,,0,0,0,,Сізге тек ойнау керек!
Dialogue: 0,1:03:11.95,1:03:14.66,Default,,0,0,0,,Бірақ осылай ерекшелену дұрыс па?
Dialogue: 0,1:03:14.91,1:03:18.66,Default,,0,0,0,,Әлсіз бейбақтарды тағы да қыбырлатамын.
Dialogue: 0,1:03:19.04,1:03:22.71,Default,,0,0,0,,Шық! Ғарыш қарақшысы!
Dialogue: 0,1:03:24.05,1:03:26.63,Default,,0,0,0,,Уа? (2 адам) Нихихихи
Dialogue: 0,1:03:26.76,1:03:29.68,Default,,0,0,0,,Ваа!
Dialogue: 0,1:03:31.84,1:03:33.22,Default,,0,0,0,,Ашық...
Dialogue: 0,1:03:33.35,1:03:35.68,Default,,0,0,0,,Не? Ол дұрыс жұмыс істемеді ме?
Dialogue: 0,1:03:35.81,1:03:37.18,Default,,0,0,0,,Ах! (Сунео) Иә?
Dialogue: 0,1:03:37.81,1:03:40.52,Default,,0,0,0,,Бұл кім? Ол (Сунео) қарақшылар тобының мүшесі ме?
Dialogue: 0,1:03:40.65,1:03:43.19,Default,,0,0,0,,Уау! (Джан Сунео) Ах!
Dialogue: 0,1:03:46.53,1:03:47.90,Default,,0,0,0,,Wach
Dialogue: 0,1:03:48.90,1:03:51.91,Default,,0,0,0,,Маған қарап тұрған сияқтысың.
Dialogue: 0,1:03:52.03,1:03:53.57,Default,,0,0,0,,Көрінбейтін плащ жоқ!
Dialogue: 0,1:03:53.70,1:03:54.99,Default,,0,0,0,,Уау! (Джан Сунео) Ах...
Dialogue: 0,1:03:55.83,1:03:58.33,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,1:03:59.79,1:04:01.04,Default,,0,0,0,,Ау…
Dialogue: 0,1:04:01.17,1:04:04.79,Default,,0,0,0,,Ақырында мен байқап көруге тұрарлық нәрсені таптым. Мінеки біз!
Dialogue: 0,1:04:05.09,1:04:06.67,Default,,0,0,0,,Конняро!
Dialogue: 0,1:04:08.92,1:04:10.17,Default,,0,0,0,,Әй, Джан!
Dialogue: 0,1:04:10.47,1:04:12.01,Default,,0,0,0,,Міне!
Dialogue: 0,1:04:12.34,1:04:15.51,Default,,0,0,0,,Бұрғылау шабуылы...
Dialogue: 0,1:04:15.64,1:04:17.68,Default,,0,0,0,,Вахо (Сунео) Ку…
Dialogue: 0,1:04:17.81,1:04:20.77,Default,,0,0,0,,Ах! Менің қолым!
Dialogue: 0,1:04:21.02,1:04:21.94,Default,,0,0,0,,болды
Dialogue: 0,1:04:22.06,1:04:25.11,Default,,0,0,0,,(Оргонды ырылдау)
Dialogue: 0,1:04:25.23,1:04:27.02,Default,,0,0,0,,(Сунеоның қорқынышты дауысы)
Dialogue: 0,1:04:27.40,1:04:29.99,Default,,0,0,0,,(Оргон айқайы)
Dialogue: 0,1:04:32.78,1:04:34.12,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:04:36.95,1:04:38.12,Default,,0,0,0,,Wach
Dialogue: 0,1:04:38.49,1:04:40.54,Default,,0,0,0,,Менде бір нәрсеге деген жағымсыз сезім бар.
Dialogue: 0,1:04:45.84,1:04:46.79,Default,,0,0,0,,Уау!
Dialogue: 0,1:04:48.34,1:04:49.76,Default,,0,0,0,,Ухххх...
Dialogue: 0,1:04:51.26,1:04:53.76,Default,,0,0,0,,Қалғандары үшін бұл уақыт мәселесі.
Dialogue: 0,1:04:54.30,1:04:57.47,Default,,0,0,0,,Жертөлеге қойыңыз, мен кейін барамын.
Dialogue: 0,1:04:57.60,1:04:58.56,Default,,0,0,0,,Дегенмен, ол шын мәнінде аристократ. Өте сәнді киінген, иә?
Dialogue: 0,1:04:59.97,1:05:01.77,Default,,0,0,0,,О, бұл бәрі
Dialogue: 0,1:05:02.18,1:05:04.15,Default,,0,0,0,,Дайындық жүріп жатқан сияқты.
Dialogue: 0,1:05:04.60,1:05:08.19,Default,,0,0,0,,Ғарыш серіктесіне алғысымды қалай білдіруге болады...
Dialogue: 0,1:05:08.32,1:05:10.99,Default,,0,0,0,,Ертеңгі ашылу салтанатына міндетті түрде келіңіз.
Dialogue: 0,1:05:11.11,1:05:12.53,Default,,0,0,0,,Әрине!
Dialogue: 0,1:05:12.65,1:05:17.37,Default,,0,0,0,,Поккуру планетасының жаңа алғашқы қадамын бірге тойлайық!
Dialogue: 0,1:05:17.49,1:05:20.20,Default,,0,0,0,,Ihi
Dialogue: 0,1:05:23.04,1:05:26.21,Default,,0,0,0,,Хмм...
Dialogue: 0,1:05:27.54,1:05:31.80,Default,,0,0,0,,Ах, ха, сен мұнда неге...
Dialogue: 0,1:05:32.51,1:05:35.80,Default,,0,0,0,,Түсіндім! Мен құдыққа құлап, осында қалдым...
Dialogue: 0,1:05:35.93,1:05:37.22,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:42.68,1:05:44.56,Default,,0,0,0,,Бұл не...
Dialogue: 0,1:05:45.52,1:05:48.44,Default,,0,0,0,,Иә? Аро... тыныш
Dialogue: 0,1:05:49.32,1:05:50.44,Default,,0,0,0,,Аарон
Dialogue: 0,1:05:50.57,1:05:52.40,Default,,0,0,0,,Хмм...
Dialogue: 0,1:05:54.36,1:05:57.11,Default,,0,0,0,,Бұл қарақшы. Нобита-сан күткендей.
Dialogue: 0,1:05:57.24,1:05:59.87,Default,,0,0,0,,Қарақшының құпиясын тез ашқаныма сене алар емеспін.
Dialogue: 0,1:05:59.99,1:06:03.33,Default,,0,0,0,,Жоқ, жоқ, бұл кездейсоқтық... А, бірақ...
Dialogue: 0,1:06:03.45,1:06:05.21,Default,,0,0,0,,Мен неге мұндамын...хехе
Dialogue: 0,1:06:05.54,1:06:07.21,Default,,0,0,0,,Осыны орындаңыз
Dialogue: 0,1:06:07.58,1:06:10.71,Default,,0,0,0,,Ей, бесіктің де пайдасы бар.
Dialogue: 0,1:06:10.84,1:06:12.59,Default,,0,0,0,,Ғарышқа шығарылды? (2 адам) Иә?
Dialogue: 0,1:06:13.21,1:06:16.09,Default,,0,0,0,,Эй, сен бұл туралы тіпті білмедің бе?
Dialogue: 0,1:06:16.88,1:06:20.60,Default,,0,0,0,,Тыңдаңыз, мына ақымақ үлкен құрылғыны пайдаланыңыз.
Dialogue: 0,1:06:20.89,1:06:23.98,Default,,0,0,0,,Осы планетаның ішіндегі жер астынан энергияны сорыңыз—
Dialogue: 0,1:06:24.10,1:06:26.77,Default,,0,0,0,,Ол жиналған жерде, бум! (Миньон) Уф!
Dialogue: 0,1:06:26.89,1:06:29.11,Default,,0,0,0,,Содан кейін ол ғарышқа жіберіледі.
Dialogue: 0,1:06:29.56,1:06:30.73,Default,,0,0,0,,Не үшін?
Dialogue: 0,1:06:30.86,1:06:34.65,Default,,0,0,0,,Ал, бұл не... Мен бұл туралы көп білмеймін...
Dialogue: 0,1:06:34.78,1:06:37.45,Default,,0,0,0,,Бұл планета қурап, жоғалады.
Dialogue: 0,1:06:37.57,1:06:39.12,Default,,0,0,0,,Жою! ?
Dialogue: 0,1:06:39.24,1:06:40.70,Default,,0,0,0,,Бұл кім? Ол кетті!
Dialogue: 0,1:06:40.83,1:06:43.66,Default,,0,0,0,,Уа, ау! (Миньон) О, күте тұрыңыз!
Dialogue: 0,1:06:44.95,1:06:47.87,Default,,0,0,0,,Хаа ха ха... Ах!
Dialogue: 0,1:06:50.17,1:06:52.38,Default,,0,0,0,,Хэхехе Маэба!
Dialogue: 0,1:06:52.75,1:06:54.63,Default,,0,0,0,,Қайда серуендегің келеді?
Dialogue: 0,1:06:54.96,1:06:58.80,Default,,0,0,0,,Ой, сен, осы Галактикалық қорғаныс күштері...
Dialogue: 0,1:06:59.43,1:07:02.56,Default,,0,0,0,,Иә? Костюм ше? Хмм...
Dialogue: 0,1:07:02.68,1:07:04.10,Default,,0,0,0,,Уфуфуфуфу... Иә?
Dialogue: 0,1:07:04.22,1:07:07.52,Default,,0,0,0,,Қаш! О, Нобита-сан! ?
Dialogue: 0,1:07:07.81,1:07:09.90,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:07:12.11,1:07:13.86,Default,,0,0,0,,Уау (Нобита) О...
Dialogue: 0,1:07:13.98,1:07:16.74,Default,,0,0,0,,Бұл өте ауыр...
Dialogue: 0,1:07:17.45,1:07:19.91,Default,,0,0,0,,Мен өз өмірімді тәуекел етпеймін
Dialogue: 0,1:07:20.03,1:07:21.57,Default,,0,0,0,,Сіз үшін бұл планетаның соңы...
Dialogue: 0,1:07:21.70,1:07:24.49,Default,,0,0,0,,Маған терең табынуларыңызды қалаймын.
Dialogue: 0,1:07:24.95,1:07:27.54,Default,,0,0,0,,Жоқ, мен саған ұнайтын нәрсені істеуге рұқсат бермеймін!
Dialogue: 0,1:07:27.66,1:07:30.75,Default,,0,0,0,,Фухахаха... (Нобита/Арон) Ууу
Dialogue: 0,1:07:33.09,1:07:34.46,Default,,0,0,0,,Ақымақ балалар
Dialogue: 0,1:07:34.59,1:07:37.26,Default,,0,0,0,,Маэба-сама
Dialogue: 0,1:07:37.38,1:07:38.67,Default,,0,0,0,,Уау!
Dialogue: 0,1:07:38.80,1:07:40.55,Default,,0,0,0,,Мен сөйлейтін еркектерді жек көремін!
Dialogue: 0,1:07:40.68,1:07:42.26,Default,,0,0,0,,Эй, эй!
Dialogue: 0,1:07:43.26,1:07:45.10,Default,,0,0,0,,Уау! Уф...
Dialogue: 0,1:07:45.22,1:07:47.39,Default,,0,0,0,,Иә! Мен осындамын…
Dialogue: 0,1:07:47.52,1:07:49.94,Default,,0,0,0,,Бұл өрескел, солай емес пе? иә?
Dialogue: 0,1:07:50.39,1:07:51.44,Default,,0,0,0,,Ах! иә?
Dialogue: 0,1:07:53.44,1:07:55.61,Default,,0,0,0,,Екеуің де берік болыңдар!
Dialogue: 0,1:07:55.73,1:07:58.36,Default,,0,0,0,,Сунео-сан Джан-сан!
Dialogue: 0,1:08:02.66,1:08:04.95,Default,,0,0,0,,Геотермиялық жылу тез төмендейді
Dialogue: 0,1:08:05.28,1:08:09.04,Default,,0,0,0,,Бұл қарақшылық схемаларға қатысты болуы мүмкін.
Dialogue: 0,1:08:09.58,1:08:10.46,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:12.17,1:08:14.25,Default,,0,0,0,,Дора-чан, батыр белгісі.
Dialogue: 0,1:08:14.38,1:08:16.80,Default,,0,0,0,,Нобита-кунға бірдеңе болды.
Dialogue: 0,1:08:16.92,1:08:19.22,Default,,0,0,0,,Неліктен Нобита-сан?
Dialogue: 0,1:08:19.34,1:08:21.55,Default,,0,0,0,,Қымбат белгіні жоғалту -
Dialogue: 0,1:08:21.68,1:08:24.89,Default,,0,0,0,,Нобитаның ерекше шеберлігі ретінде мұндай ебедейсіздігі бар жалғыз адам!
Dialogue: 0,1:08:25.01,1:08:26.76,Default,,0,0,0,,Ах... Директор—
Dialogue: 0,1:08:26.89,1:08:28.72,Default,,0,0,0,,Нобита-кунның ағымдағы бейнесі
Dialogue: 0,1:08:29.06,1:08:30.02,Default,,0,0,0,,Upip
Dialogue: 0,1:08:30.52,1:08:31.35,Default,,0,0,0,,Арон деген кім?
Dialogue: 0,1:08:31.48,1:08:32.85,Default,,0,0,0,,Екеуміз біргеміз (2 адам) Ах!
Dialogue: 0,1:08:32.98,1:08:34.23,Default,,0,0,0,,Сунео мен Джан...
Dialogue: 0,1:08:34.52,1:08:36.23,Default,,0,0,0,,Джан! Сунео мырза!
Dialogue: 0,1:08:36.44,1:08:37.44,Default,,0,0,0,,Бұл...
Dialogue: 0,1:08:37.57,1:08:39.74,Default,,0,0,0,,Оны қарақшылар ұстап алған көрінеді.
Dialogue: 0,1:08:40.40,1:08:41.99,Default,,0,0,0,,Камера қайда орналасқан?
Dialogue: 0,1:08:43.53,1:08:45.45,Default,,0,0,0,,Бұл ғарыш мұнарасының жертөлесі.
Dialogue: 0,1:08:45.57,1:08:46.99,Default,,0,0,0,,Асығыңыз және көмектесіңіз!
Dialogue: 0,1:08:49.41,1:08:50.96,Default,,0,0,0,,Директор навигацияны сұрайды
Dialogue: 0,1:08:51.08,1:08:52.58,Default,,0,0,0,,...
Dialogue: 0,1:08:52.71,1:08:55.58,Default,,0,0,0,,(Дораэмонның айқайы)
Dialogue: 0,1:08:55.71,1:08:57.63,Default,,0,0,0,,үшін, күте тұрыңдар!
Dialogue: 0,1:09:00.80,1:09:01.63,Default,,0,0,0,,Ах...
Dialogue: 0,1:09:02.76,1:09:05.93,Default,,0,0,0,,Дораемон және басқалары міндетті түрде келеді.
Dialogue: 0,1:09:06.10,1:09:09.85,Default,,0,0,0,,Иә, мен Галактикалық қорғаныс күштеріне сенемін.
Dialogue: 0,1:09:10.10,1:09:12.10,Default,,0,0,0,,Аа, дұрыс...
Dialogue: 0,1:09:12.23,1:09:15.86,Default,,0,0,0,,Арон бізді нағыз батырлар деп ойлады.
Dialogue: 0,1:09:18.11,1:09:22.03,Default,,0,0,0,,Иә, біз Ааронның сезіміне опасыздық жасай алмаймыз!
Dialogue: 0,1:09:22.15,1:09:24.49,Default,,0,0,0,,Сіз қалай ойлайсыз? Қандай ыңғайлы
Dialogue: 0,1:09:24.61,1:09:25.61,Default,,0,0,0,,Ах
Dialogue: 0,1:09:25.95,1:09:27.62,Default,,0,0,0,,Хайд! (Нобита) Ух...
Dialogue: 0,1:09:27.87,1:09:29.03,Default,,0,0,0,,Нихи (минион) хехе
Dialogue: 0,1:09:29.33,1:09:30.45,Default,,0,0,0,,Иә!
Dialogue: 0,1:09:31.25,1:09:35.79,Default,,0,0,0,,Ихи, бұл жерде Поккуру планетасы ақырын ғана аяқталады.
Dialogue: 0,1:09:36.29,1:09:39.59,Default,,0,0,0,,Ihiihiihiihihihi…
Dialogue: 0,1:09:39.71,1:09:41.17,Default,,0,0,0,,Қарақшылар!
Dialogue: 0,1:09:41.63,1:09:43.17,Default,,0,0,0,,Не істеуім керек...
Dialogue: 0,1:09:43.30,1:09:44.80,Default,,0,0,0,,Дораемон!
Dialogue: 0,1:09:44.93,1:09:47.18,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:47.80,1:09:48.93,Default,,0,0,0,,Бұл қандай дыбыс?
Dialogue: 0,1:09:49.85,1:09:50.68,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:53.23,1:09:54.69,Default,,0,0,0,,Уау!
Dialogue: 0,1:09:55.48,1:09:57.61,Default,,0,0,0,,Бум! Бум!
Dialogue: 0,1:09:57.81,1:09:58.65,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:09:59.61,1:10:00.48,Default,,0,0,0,,Гяа! Эй!
Dialogue: 0,1:10:02.11,1:10:04.78,Default,,0,0,0,,Бум! Бум!
Dialogue: 0,1:10:05.49,1:10:07.70,Default,,0,0,0,,Не болып жатыр!
Dialogue: 0,1:10:08.20,1:10:09.03,Default,,0,0,0,,Әуе зеңбірегі!
Dialogue: 0,1:10:09.78,1:10:10.99,Default,,0,0,0,,Дораемон келді!
Dialogue: 0,1:10:11.12,1:10:11.79,Default,,0,0,0,,Иә!
Dialogue: 0,1:10:12.04,1:10:14.08,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:10:15.54,1:10:18.63,Default,,0,0,0,,Не істеп жатырсың! Мүмкіндігінше атыңыз!
Dialogue: 0,1:10:20.59,1:10:21.50,Default,,0,0,0,,Бум! (Миньон) Уау
Dialogue: 0,1:10:21.63,1:10:22.96,Default,,0,0,0,,Бум! (Минион) Гяаа
Dialogue: 0,1:10:23.09,1:10:24.51,Default,,0,0,0,,Уууу
Dialogue: 0,1:10:25.30,1:10:26.76,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:10:27.68,1:10:30.01,Default,,0,0,0,,Бум! Уау tsk
Dialogue: 0,1:10:30.14,1:10:32.89,Default,,0,0,0,,Ууу...
Dialogue: 0,1:10:33.02,1:10:35.64,Default,,0,0,0,,Ба ба ба ба ба... Ки!
Dialogue: 0,1:10:35.89,1:10:37.65,Default,,0,0,0,,Куу
Dialogue: 0,1:10:37.98,1:10:39.90,Default,,0,0,0,,Ей, сен сондай жамансың!
Dialogue: 0,1:10:40.31,1:10:41.15,Default,,0,0,0,,Ihi
Dialogue: 0,1:10:41.32,1:10:44.40,Default,,0,0,0,,(Дораэмонның мазақ еткен дауысы)
Dialogue: 0,1:10:44.53,1:10:47.74,Default,,0,0,0,,(Дораэмонның ыңырсыуы)
Dialogue: 0,1:10:48.24,1:10:49.16,Default,,0,0,0,,Ақымақ
Dialogue: 0,1:10:49.57,1:10:50.62,Default,,0,0,0,,Аха
Dialogue: 0,1:10:50.74,1:10:51.91,Default,,0,0,0,,...
Dialogue: 0,1:10:52.12,1:10:53.45,Default,,0,0,0,,Не! Уау
Dialogue: 0,1:10:53.58,1:10:57.67,Default,,0,0,0,,(Гайдтың ыңырсыуы)
Dialogue: 0,1:10:58.37,1:11:00.17,Default,,0,0,0,,Дора-чан, барлығын қазір алыңыз!
Dialogue: 0,1:11:00.38,1:11:03.00,Default,,0,0,0,,Ах... Ха! Жарайды!
Dialogue: 0,1:11:03.63,1:11:06.01,Default,,0,0,0,,Супер Айдаһар…
Dialogue: 0,1:11:06.30,1:11:07.84,Default,,0,0,0,,Маған мұны істеуге рұқсат етіңіз!
Dialogue: 0,1:11:09.09,1:11:10.34,Default,,0,0,0,,Уау! Ах!
Dialogue: 0,1:11:10.89,1:11:13.26,Default,,0,0,0,,Уау! Бучаа!
Dialogue: 0,1:11:15.72,1:11:18.48,Default,,0,0,0,,Ууу
Dialogue: 0,1:11:19.27,1:11:20.73,Default,,0,0,0,,Дораемон-сан!
Dialogue: 0,1:11:20.85,1:11:23.07,Default,,0,0,0,,Менің ерекше қабілетім қандай?
Dialogue: 0,1:11:23.52,1:11:25.65,Default,,0,0,0,,Тас басы? (Нобита) Дораемон!
Dialogue: 0,1:11:26.11,1:11:28.15,Default,,0,0,0,,Ақымақ!
Dialogue: 0,1:11:28.49,1:11:30.86,Default,,0,0,0,,Енді оны тастамаңыз.
Dialogue: 0,1:11:30.99,1:11:32.53,Default,,0,0,0,,О, менің төсбелгім!
Dialogue: 0,1:11:32.99,1:11:34.95,Default,,0,0,0,,Тезірек қашып кет!
Dialogue: 0,1:11:35.08,1:11:36.54,Default,,0,0,0,,Кяах! (Дораэмон/Нобита) Ах
Dialogue: 0,1:11:37.20,1:11:40.29,Default,,0,0,0,,Упип упип... бұл ауыртады...
Dialogue: 0,1:11:40.75,1:11:41.79,Default,,0,0,0,,Шизука-чан!
Dialogue: 0,1:11:42.08,1:11:45.80,Default,,0,0,0,,Бұл жігіттің өмірін бағаласаң, момындықпен бер!
Dialogue: 0,1:11:46.46,1:11:48.80,Default,,0,0,0,,Қандай сұмдық.
Dialogue: 0,1:11:49.26,1:11:52.85,Default,,0,0,0,,Қара, қара, асығу керек...
Dialogue: 0,1:11:53.18,1:11:54.05,Default,,0,0,0,,Дыбыстық сигнал?
Dialogue: 0,1:11:54.64,1:11:56.31,Default,,0,0,0,,Дыбыстық сигнал
Dialogue: 0,1:11:56.81,1:11:58.06,Default,,0,0,0,,Дабыл!
Dialogue: 0,1:11:58.35,1:12:00.52,Default,,0,0,0,,Ухх...
Dialogue: 0,1:12:00.64,1:12:02.86,Default,,0,0,0,,О, жақында көресің.
Dialogue: 0,1:12:03.31,1:12:06.07,Default,,0,0,0,,Иә?
Dialogue: 0,1:12:06.78,1:12:10.24,Default,,0,0,0,,(Демекиннің айқайы)
Dialogue: 0,1:12:10.36,1:12:13.45,Default,,0,0,0,,Сәлем! Ах, аа!
Dialogue: 0,1:12:14.74,1:12:15.58,Default,,0,0,0,,Ах...
Dialogue: 0,1:12:15.83,1:12:16.95,Default,,0,0,0,,Сәлем! Бұл...
Dialogue: 0,1:12:18.62,1:12:20.83,Default,,0,0,0,,Бургер-чан (Бургер директоры) Упи
Dialogue: 0,1:12:21.08,1:12:23.58,Default,,0,0,0,,Бұл не?!
Dialogue: 0,1:12:23.83,1:12:25.84,Default,,0,0,0,,Жүр, енді (Нобита) Иә!
Dialogue: 0,1:12:26.30,1:12:28.38,Default,,0,0,0,,Тез, осы жаққа кел (Директор Бергер) Пи
Dialogue: 0,1:12:30.67,1:12:31.93,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:12:32.05,1:12:34.14,Default,,0,0,0,,Сәттілік!
Dialogue: 0,1:12:35.55,1:12:36.93,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:12:37.06,1:12:39.56,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:12:40.23,1:12:42.14,Default,,0,0,0,,Нобита! Тағы да 0 ұпай!
Dialogue: 0,1:12:42.27,1:12:44.81,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,1:12:45.15,1:12:48.73,Default,,0,0,0,,Күте тұрыңыз! а? Янакота~!
Dialogue: 0,1:12:48.86,1:12:50.36,Default,,0,0,0,,Алдымен барыңыз.
Dialogue: 0,1:12:50.49,1:12:51.40,Default,,0,0,0,,Не? Хмм?
Dialogue: 0,1:12:51.53,1:12:55.12,Default,,0,0,0,,(Ұшу дыбысы)
Dialogue: 0,1:12:57.16,1:13:01.33,Default,,0,0,0,,Не? Виртуалды бейне?
Dialogue: 0,1:13:01.66,1:13:03.71,Default,,0,0,0,,Уф!
Dialogue: 0,1:13:03.83,1:13:06.13,Default,,0,0,0,,Кешіріңіз! Куу! (Минион) Ашық
Dialogue: 0,1:13:06.75,1:13:11.47,Default,,0,0,0,,Осы Лорд Хайдты көбелекке айналдыр!
Dialogue: 0,1:13:19.22,1:13:22.14,Default,,0,0,0,,Ертең ерте ме деп ойлаймын
Dialogue: 0,1:13:23.10,1:13:25.81,Default,,0,0,0,,Бұрынғыдай әдемі
Dialogue: 0,1:13:25.94,1:13:28.90,Default,,0,0,0,,Уау, өте әдемі...
Dialogue: 0,1:13:29.02,1:13:32.78,Default,,0,0,0,,Алмас, мәңгі жарқырай бер...
Dialogue: 0,1:13:32.90,1:13:35.99,Default,,0,0,0,,Поккуру планетасына назар аударыңыз.
Dialogue: 0,1:13:38.53,1:13:40.95,Default,,0,0,0,,Сәлем! Ах... хе
Dialogue: 0,1:13:42.91,1:13:45.29,Default,,0,0,0,,Қандай қателік, Хайд.
Dialogue: 0,1:13:45.42,1:13:46.79,Default,,0,0,0,,Хахааа
Dialogue: 0,1:13:46.92,1:13:49.67,Default,,0,0,0,,Ху, сенімсіз адам (оргон) уахо вахо
Dialogue: 0,1:13:49.80,1:13:51.21,Default,,0,0,0,,Шулы!
Dialogue: 0,1:13:51.59,1:13:53.63,Default,,0,0,0,,Бірақ уайымдамаңыз.
Dialogue: 0,1:13:53.76,1:13:57.22,Default,,0,0,0,,Жоспар бойынша барлығы жақсы жүріп жатыр.
Dialogue: 0,1:13:57.43,1:13:58.76,Default,,0,0,0,,Ууух!
Dialogue: 0,1:14:03.14,1:14:03.98,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:04.60,1:14:07.86,Default,,0,0,0,,Энергетикалық от жағу құрылғысы
Dialogue: 0,1:14:08.48,1:14:10.73,Default,,0,0,0,,Поккуру жерінің ашылу уақыты –
Dialogue: 0,1:14:10.86,1:14:13.36,Default,,0,0,0,,Қуатты толтыру аяқталды
Dialogue: 0,1:14:13.49,1:14:16.82,Default,,0,0,0,,Сол кезде лорд Икардың өзі бұл құрылғыны қолданды
Dialogue: 0,1:14:16.95,1:14:19.12,Default,,0,0,0,,Сәлемді көтеріңіз.
Dialogue: 0,1:14:19.24,1:14:21.95,Default,,0,0,0,,Ғұн, сенің өндіріс түрің—
Dialogue: 0,1:14:22.08,1:14:23.66,Default,,0,0,0,,Маған ұнады, Хайд.
Dialogue: 0,1:14:24.04,1:14:25.41,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:14:25.71,1:14:31.21,Default,,0,0,0,,Әй... Қуанышқа толы күлкі үмітсіз жүзге айналады...
Dialogue: 0,1:14:31.34,1:14:33.92,Default,,0,0,0,,Осыны ойлаудың өзі қалтырап кетеді.
Dialogue: 0,1:14:34.55,1:14:35.97,Default,,0,0,0,,Соғыс
Dialogue: 0,1:14:37.01,1:14:39.30,Default,,0,0,0,,Галактикадағы ең жарық —
Dialogue: 0,1:14:39.43,1:14:42.35,Default,,0,0,0,,Алмас жұлдыз Алмас
Dialogue: 0,1:14:42.47,1:14:46.73,Default,,0,0,0,,Жер астында ең жоғары сапалы көміртегі бар графит жатыр
Dialogue: 0,1:14:48.81,1:14:52.48,Default,,0,0,0,,Менің әлсіреген денеме графит қосу —
Dialogue: 0,1:14:52.61,1:14:57.99,Default,,0,0,0,,Біздің шынайы мақсатымыз – бұрынғы билікке қол жеткізу!
Dialogue: 0,1:14:59.20,1:15:03.33,Default,,0,0,0,,Қалған гауһар сынықтарын қосқанда қалағаныңызша беремін.
Dialogue: 0,1:15:03.45,1:15:05.20,Default,,0,0,0,,Фуфу (Икар) Жақсы!
Dialogue: 0,1:15:05.33,1:15:08.37,Default,,0,0,0,,Жоспарыңызды міндетті түрде орындаңыз!
Dialogue: 0,1:15:08.50,1:15:09.79,Default,,0,0,0,,Хаха!
Dialogue: 0,1:15:11.04,1:15:12.79,Default,,0,0,0,,Сондықтан мен айттым!
Dialogue: 0,1:15:13.00,1:15:16.05,Default,,0,0,0,,Бұл ақылсыз! Ғарыш қарақшыларымен күресу!
Dialogue: 0,1:15:16.38,1:15:19.38,Default,,0,0,0,,Негізі мен жаңа ғана кейіпкерлер туралы фильм түсірдім.
Dialogue: 0,1:15:19.51,1:15:22.05,Default,,0,0,0,,Неге мен мұндай нәрсеге араласуым керек!
Dialogue: 0,1:15:22.93,1:15:25.31,Default,,0,0,0,,Батыр фильмі? (Дораэмон/Нобита) Ах
Dialogue: 0,1:15:25.47,1:15:28.69,Default,,0,0,0,,Сунео қарғыс атсын! (Сунео) Бұл дұрыс емес!
Dialogue: 0,1:15:29.10,1:15:31.56,Default,,0,0,0,,Біз нағыз батыр емеспіз!
Dialogue: 0,1:15:31.69,1:15:33.07,Default,,0,0,0,,Не? (Дораэмон/Нобита) Ах...
Dialogue: 0,1:15:33.19,1:15:35.61,Default,,0,0,0,,Кинорежиссер Робоның бургеріне тапсырыс беріңіз.
Dialogue: 0,1:15:35.73,1:15:38.57,Default,,0,0,0,,Мен жаңа ғана қаһармандық фильм түсірдім!
Dialogue: 0,1:15:38.70,1:15:41.20,Default,,0,0,0,,Виртуалды бейнені бұрын көрдіңіз бе?
Dialogue: 0,1:15:41.32,1:15:44.54,Default,,0,0,0,,Біз тек жердің балаларымыз!
Dialogue: 0,1:15:45.08,1:15:46.95,Default,,0,0,0,,Уф...
Dialogue: 0,1:15:48.08,1:15:50.21,Default,,0,0,0,,Солай болды ма?
Dialogue: 0,1:15:52.71,1:15:53.92,Default,,0,0,0,,Арон...
Dialogue: 0,1:15:54.09,1:15:57.34,Default,,0,0,0,,Уф... Қарғыс атсын, бұл өте сергітеді!
Dialogue: 0,1:15:57.46,1:16:00.18,Default,,0,0,0,,Кәне, бәріміз Жерге тез оралайық!
Dialogue: 0,1:16:01.13,1:16:02.30,Default,,0,0,0,,Не болды, бәріңе!
Dialogue: 0,1:16:05.35,1:16:07.81,Default,,0,0,0,,Мен бұлай үйге бара алмаймын.
Dialogue: 0,1:16:08.06,1:16:09.27,Default,,0,0,0,,Ех... (Нобита) Поккуру жұлдызы...
Dialogue: 0,1:16:09.39,1:16:10.94,Default,,0,0,0,,Ол жоғалады!
Dialogue: 0,1:16:11.27,1:16:14.65,Default,,0,0,0,,Қазір бұл планетаны тек біз ғана құтқарамыз!
Dialogue: 0,1:16:14.77,1:16:18.24,Default,,0,0,0,,Біз тіпті нағыз батыр емеспіз...
Dialogue: 0,1:16:18.36,1:16:20.20,Default,,0,0,0,,Маған бұл шын ба, жоқ па бәрібір...
Dialogue: 0,1:16:20.32,1:16:22.41,Default,,0,0,0,,Сен нағызсың! (2 адам) Иә?
Dialogue: 0,1:16:25.12,1:16:26.87,Default,,0,0,0,,Қорқынышты қарақшыларға —
Dialogue: 0,1:16:26.99,1:16:31.29,Default,,0,0,0,,Онымен жалғыз бетпе-бет келу қандай өкінішті...
Dialogue: 0,1:16:31.92,1:16:35.59,Default,,0,0,0,,Сондықтан мен Галактикалық қорғаныс күштерінің мүшелерімен кездесуге мүмкіндік алдым.
Dialogue: 0,1:16:36.30,1:16:39.88,Default,,0,0,0,,Мен үлкен үміт пен сенімділік алдым.
Dialogue: 0,1:16:40.67,1:16:44.39,Default,,0,0,0,,Олар осы планета үшін күреседі, тіпті өздеріне қауіп төндіреді.
Dialogue: 0,1:16:45.01,1:16:49.52,Default,,0,0,0,,Бәрің де осы планета үшінсіңдер, жоқ, мен үшін...
Dialogue: 0,1:16:50.23,1:16:52.44,Default,,0,0,0,,Нағыз батыр!
Dialogue: 0,1:16:54.02,1:16:55.31,Default,,0,0,0,,Аарон…
Dialogue: 0,1:16:55.44,1:16:57.23,Default,,0,0,0,,Мен қаламын
Dialogue: 0,1:16:57.69,1:16:59.82,Default,,0,0,0,,Мен олардан жеңілгенімдей үйге бара жатқаныма сене алар емеспін.
Dialogue: 0,1:16:59.94,1:17:02.07,Default,,0,0,0,,Лорд Джианның есімі ескіреді.
Dialogue: 0,1:17:02.20,1:17:04.03,Default,,0,0,0,,Мен де, осы планетаның адамдары...
Dialogue: 0,1:17:04.16,1:17:05.53,Default,,0,0,0,,Мен сені жалғыз қалдыра алмаймын (Сунео) Иә?
Dialogue: 0,1:17:05.66,1:17:07.20,Default,,0,0,0,,Джан! Шизука-чан
Dialogue: 0,1:17:07.62,1:17:08.87,Default,,0,0,0,,Әрине мен...
Dialogue: 0,1:17:08.95,1:17:12.50,Default,,0,0,0,,Қорғаныс күштерінің жетекшісі ретінде мен қаша алмаймын!
Dialogue: 0,1:17:12.58,1:17:13.21,Default,,0,0,0,,Дыбыстық сигнал!
Dialogue: 0,1:17:13.50,1:17:15.21,Default,,0,0,0,,Қадағалау! Дораемон!
Dialogue: 0,1:17:15.67,1:17:17.50,Default,,0,0,0,,Біз не істеуіміз керек? Сунео
Dialogue: 0,1:17:17.63,1:17:20.71,Default,,0,0,0,,Бұл планетаның адамдары да өте мейірімді, бірақ...
Dialogue: 0,1:17:20.84,1:17:23.47,Default,,0,0,0,,үшінның мейірімділігі сонша, бұл мені күлдіреді!
Dialogue: 0,1:17:23.59,1:17:25.64,Default,,0,0,0,,Сонымен не істеуіміз керек?
Dialogue: 0,1:17:25.76,1:17:29.56,Default,,0,0,0,,Жарайды, көмектесу мүмкін емес, сондықтан мен үйге баруды сәл кешіктіремін.
Dialogue: 0,1:17:29.68,1:17:31.60,Default,,0,0,0,,Сізді батыр ететін де осы!
Dialogue: 0,1:17:31.68,1:17:32.23,Default,,0,0,0,,Сукуна мен қондырғы — табиғи жаулар, түсінесің бе.
Dialogue: 0,1:17:32.85,1:17:33.89,Default,,0,0,0,,Артық емес...
Dialogue: 0,1:17:34.02,1:17:36.73,Default,,0,0,0,,Ахахаха…
Dialogue: 0,1:17:37.23,1:17:38.73,Default,,0,0,0,,Арон Иә
Dialogue: 0,1:17:39.19,1:17:42.19,Default,,0,0,0,,Оны қорғайық! Бұл жұлдыздың күлкісі!
Dialogue: 0,1:17:42.32,1:17:44.99,Default,,0,0,0,,А... иә!
Dialogue: 0,1:17:46.45,1:17:48.37,Default,,0,0,0,,Енді ертеңгі шешуші шайқасқа дайындалыңыз.
Dialogue: 0,1:17:48.66,1:17:51.54,Default,,0,0,0,,Жақсы ұйықтаңыз және күшіңізді қалпына келтіріңіз!
Dialogue: 0,1:17:59.13,1:18:01.63,Default,,0,0,0,,Жақында келеді. (Тұрғын) Бос болма.
Dialogue: 0,1:18:06.13,1:18:08.14,Default,,0,0,0,,Көңіл көтерме (бала) Иә.
Dialogue: 0,1:18:09.35,1:18:10.76,Default,,0,0,0,,Не болды? (Бала) А?
Dialogue: 0,1:18:10.89,1:18:12.64,Default,,0,0,0,,Қызық, Аарон келмей ме?
Dialogue: 0,1:18:13.10,1:18:15.02,Default,,0,0,0,,Мен оның кейінірек келетініне сенімдімін.
Dialogue: 0,1:18:15.14,1:18:16.65,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,1:18:16.98,1:18:18.31,Default,,0,0,0,,Иә... Парламент депутаты—
Dialogue: 0,1:18:18.44,1:18:20.65,Default,,0,0,0,,Көптен күткен күн де келіп жетті.
Dialogue: 0,1:18:21.19,1:18:24.95,Default,,0,0,0,,Мен Поккурландтың табысты болуына шын жүректен үміттенемін.
Dialogue: 0,1:18:25.07,1:18:26.78,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,1:18:26.91,1:18:28.16,Default,,0,0,0,,Сол мүше... (Реп.) Иә?
Dialogue: 0,1:18:28.74,1:18:30.87,Default,,0,0,0,,Саябақ екі сағаттан кейін ашылса да...
Dialogue: 0,1:18:30.99,1:18:34.37,Default,,0,0,0,,Ешқандай келушілер келген жоқ...
Dialogue: 0,1:18:34.50,1:18:37.79,Default,,0,0,0,,Ғарыш мұнарасында бірде-бір жолаушы кемесі жоқ...
Dialogue: 0,1:18:38.17,1:18:40.75,Default,,0,0,0,,Жер бетінде не болды? Мистер Хайд
Dialogue: 0,1:18:40.88,1:18:42.42,Default,,0,0,0,,Сенімді болыңыз
Dialogue: 0,1:18:42.75,1:18:45.92,Default,,0,0,0,,Келушілер саябақтың жұмыс уақытында келуі үшін шаралар жасалды.
Dialogue: 0,1:18:46.05,1:18:47.18,Default,,0,0,0,,...
Dialogue: 0,1:18:47.30,1:18:48.80,Default,,0,0,0,,Кішкене
Dialogue: 0,1:18:49.18,1:18:51.30,Default,,0,0,0,,Жабдық! (мүше/хатшы) Уау!
Dialogue: 0,1:18:51.60,1:18:54.81,Default,,0,0,0,,…Біз бұл жерде өнімді дайындадық.
Dialogue: 0,1:18:54.93,1:18:58.81,Default,,0,0,0,,Келушілер де, барлығы да риза болатынына сенімдімін.
Dialogue: 0,1:18:59.27,1:19:03.32,Default,,0,0,0,,О, түсіндім. Сіздің мейірімділігіңіз үшін рахмет.
Dialogue: 0,1:19:03.44,1:19:04.32,Default,,0,0,0,,Жоқ, жоқ...
Dialogue: 0,1:19:04.99,1:19:06.28,Default,,0,0,0,,Оның келуі мүмкін емес.
Dialogue: 0,1:19:06.40,1:19:08.70,Default,,0,0,0,,Бұл жалған.
Dialogue: 0,1:19:09.20,1:19:11.20,Default,,0,0,0,,Мистер Хайд, уақыт келді.
Dialogue: 0,1:19:11.49,1:19:15.66,Default,,0,0,0,,Дұрыс, мен іске қосқышты соңғы тексеруім керек.
Dialogue: 0,1:19:15.79,1:19:17.71,Default,,0,0,0,,...
Dialogue: 0,1:19:20.17,1:19:21.67,Default,,0,0,0,,үшінң тыңдаңдар.
Dialogue: 0,1:19:21.79,1:19:23.92,Default,,0,0,0,,Уақыт әлі белгісіз, бірақ...
Dialogue: 0,1:19:24.05,1:19:26.21,Default,,0,0,0,,Поккуру жұлдызының энергиясы бөлінетіні анық.
Dialogue: 0,1:19:26.76,1:19:30.09,Default,,0,0,0,,Ғарыш мұнарасының жер асты жабдықтарын тез жойайық.
Dialogue: 0,1:19:30.39,1:19:34.47,Default,,0,0,0,,Дегенмен, сол үш қарақшы басшы міндетті түрде сіздің жолыңызды бөгейді.
Dialogue: 0,1:19:34.64,1:19:35.85,Default,,0,0,0,,Мына жігіттер!
Dialogue: 0,1:19:35.97,1:19:38.98,Default,,0,0,0,,Алтын бейбақ, мен саған шындап қайтарамын.
Dialogue: 0,1:19:39.48,1:19:41.61,Default,,0,0,0,,Менің физикалық күшім тамаша қалпына келді.
Dialogue: 0,1:19:41.90,1:19:43.61,Default,,0,0,0,,Оны бізге қалдырыңыз!
Dialogue: 0,1:19:43.98,1:19:46.11,Default,,0,0,0,,Мен сені міндетті түрде қорғаймын. Уау...
Dialogue: 0,1:19:46.61,1:19:49.65,Default,,0,0,0,,Біз костюмдеріміздің толық қуатын әлі босатқан жоқпыз.
Dialogue: 0,1:19:49.78,1:19:52.53,Default,,0,0,0,,Арнайы дағдыларыңызды барынша пайдалану арқылы күресіңіз!
Dialogue: 0,1:19:52.66,1:19:53.49,Default,,0,0,0,,Иә
Dialogue: 0,1:19:58.75,1:20:00.75,Default,,0,0,0,,Галактикалық қорғаныс күштері (барлығы) жіберілді!
Dialogue: 0,1:20:16.01,1:20:19.60,Default,,0,0,0,,Бірақ бесікте қалай күресесің?
Dialogue: 0,1:20:19.73,1:20:23.10,Default,,0,0,0,,Әзірше мен Нобита-кунға қамқор боламын...
Dialogue: 0,1:20:23.23,1:20:25.48,Default,,0,0,0,,А, Дораемон мұны жақсы біледі.
Dialogue: 0,1:20:25.61,1:20:26.53,Default,,0,0,0,,Ах...
Dialogue: 0,1:20:27.48,1:20:29.78,Default,,0,0,0,,Алдымен мұнараның негізін көздеңіз!
Dialogue: 0,1:20:29.90,1:20:31.32,Default,,0,0,0,,О!
Dialogue: 0,1:20:35.08,1:20:37.29,Default,,0,0,0,,Кішкентай шыбындар қайтадан пайда болды ма?
Dialogue: 0,1:20:38.16,1:20:39.54,Default,,0,0,0,,Оргон Меба!
Dialogue: 0,1:20:42.54,1:20:45.09,Default,,0,0,0,,Маған бұдан былай сенің жолыңа кедергі жасама!
Dialogue: 0,1:20:45.21,1:20:47.00,Default,,0,0,0,,Оны маған қалдырыңыз (Огоне) Ваху
Dialogue: 0,1:20:47.13,1:20:50.92,Default,,0,0,0,,Фуфуфуфуфу... Олар шыдамсыз ұлдар.
Dialogue: 0,1:20:51.59,1:20:53.43,Default,,0,0,0,,Кеттік! (Огон) Уау
Dialogue: 0,1:20:58.06,1:21:01.06,Default,,0,0,0,,Хмм... сен ақымақ.
Dialogue: 0,1:21:01.18,1:21:05.65,Default,,0,0,0,,(Икардың жөтелі)
Dialogue: 0,1:21:06.02,1:21:09.99,Default,,0,0,0,,Графитті тез енгізу керек...
Dialogue: 0,1:21:13.61,1:21:15.95,Default,,0,0,0,,Мұнда жер астында ұшырғыш бар, солай ма?
Dialogue: 0,1:21:16.07,1:21:17.87,Default,,0,0,0,,Иә, кеше Нобита-санмен...
Dialogue: 0,1:21:17.99,1:21:19.41,Default,,0,0,0,,Иә, сөзсіз.
Dialogue: 0,1:21:19.79,1:21:22.29,Default,,0,0,0,,Жарайды, бірден қазып алайық!
Dialogue: 0,1:21:22.96,1:21:26.04,Default,,0,0,0,,Иә? Маэба! Оргон!
Dialogue: 0,1:21:26.33,1:21:29.00,Default,,0,0,0,,Вахохохо… (Меба) Фуфуфуфуфуфу…
Dialogue: 0,1:21:29.13,1:21:31.55,Default,,0,0,0,,Ақыры алтын пиказару пайда болды!
Dialogue: 0,1:21:32.01,1:21:34.68,Default,,0,0,0,,Уау? қарақат~!
Dialogue: 0,1:21:34.80,1:21:37.26,Default,,0,0,0,,Біз қайда барамыз?
Dialogue: 0,1:21:37.39,1:21:38.89,Default,,0,0,0,,Жігіттер!
Dialogue: 0,1:21:39.51,1:21:40.47,Default,,0,0,0,,Уау!
Dialogue: 0,1:21:40.60,1:21:42.31,Default,,0,0,0,,Аарон! Апыр-ай!
Dialogue: 0,1:21:42.43,1:21:44.02,Default,,0,0,0,,Нобита-кун!
Dialogue: 0,1:21:44.52,1:21:46.40,Default,,0,0,0,,Ух... (Меба) Фухахаха...
Dialogue: 0,1:21:46.52,1:21:48.11,Default,,0,0,0,,Уф... (Нобита) Аронды жібер!
Dialogue: 0,1:21:48.23,1:21:50.03,Default,,0,0,0,,Уф, сен не істеп жатырсың, бала?
Dialogue: 0,1:21:50.48,1:21:51.53,Default,,0,0,0,,Вахохохо... (Нобита) Арон!
Dialogue: 0,1:21:51.82,1:21:54.07,Default,,0,0,0,,О! Мен Нобитаға жеңіле алмаймын!
Dialogue: 0,1:21:54.20,1:21:56.28,Default,,0,0,0,,Кеттік, Кинпика! (Сунео) О, Джан!
Dialogue: 0,1:21:56.53,1:21:58.16,Default,,0,0,0,,Конняро!
Dialogue: 0,1:21:58.49,1:22:00.16,Default,,0,0,0,,Уау... Кешегі күн үшін рахмет...
Dialogue: 0,1:22:00.29,1:22:02.16,Default,,0,0,0,,Мен сізге көп нәрсе беремін.
Dialogue: 0,1:22:02.95,1:22:04.92,Default,,0,0,0,,Сәлем! (Огон) Уау!
Dialogue: 0,1:22:05.12,1:22:06.46,Default,,0,0,0,,Не? (Сунео) Керемет!
Dialogue: 0,1:22:06.58,1:22:07.54,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,1:22:08.25,1:22:10.21,Default,,0,0,0,,Бұл әлі алыс!
Dialogue: 0,1:22:10.42,1:22:11.84,Default,,0,0,0,,Уф... мен де!
Dialogue: 0,1:22:12.09,1:22:13.84,Default,,0,0,0,,...
Dialogue: 0,1:22:15.51,1:22:16.68,Default,,0,0,0,,Не? Алақай!
Dialogue: 0,1:22:16.80,1:22:18.68,Default,,0,0,0,,Уау!
Dialogue: 0,1:22:19.10,1:22:21.14,Default,,0,0,0,,Уваа
Dialogue: 0,1:22:21.26,1:22:23.93,Default,,0,0,0,,Уау!
Dialogue: 0,1:22:24.85,1:22:27.98,Default,,0,0,0,,Ха! Кейіпкер қарақшылар белбеуін тағып жүр...
Dialogue: 0,1:22:28.10,1:22:30.44,Default,,0,0,0,,Уф... Мен шыдай алмаймын.
Dialogue: 0,1:22:31.73,1:22:33.40,Default,,0,0,0,,Иә? Апыр-ай!
Dialogue: 0,1:22:33.61,1:22:36.11,Default,,0,0,0,,Дора-чан! Мұны бізге қалдырыңыз -
Dialogue: 0,1:22:36.24,1:22:38.20,Default,,0,0,0,,Іске қосу құралы! Түсіндім!
Dialogue: 0,1:22:38.87,1:22:41.33,Default,,0,0,0,,Жүр, кеттік, иә!
Dialogue: 0,1:22:43.12,1:22:45.46,Default,,0,0,0,,Иә? Мұнда қайда?
Dialogue: 0,1:22:45.58,1:22:46.79,Default,,0,0,0,,Бір кішкентай шыбын—
Dialogue: 0,1:22:46.92,1:22:48.25,Default,,0,0,0,,Сіз адасып қалдыңыз ба (Нобита)?
Dialogue: 0,1:22:51.88,1:22:53.25,Default,,0,0,0,,Ха ха!
Dialogue: 0,1:22:55.55,1:22:58.76,Default,,0,0,0,,Сіз Һарон өзіңізбен бірге алып келген көмекшісіз бе?
Dialogue: 0,1:23:00.01,1:23:02.68,Default,,0,0,0,,Бұл Галактикалық қорғаныс күштерінің Нобита Ноби!
Dialogue: 0,1:23:02.81,1:23:06.27,Default,,0,0,0,,Сонымен, сіз қарақшылардың басшысы Икарсыз, солай ма?
Dialogue: 0,1:23:06.73,1:23:09.27,Default,,0,0,0,,Бұл шындық болса да не істеуіміз керек?
Dialogue: 0,1:23:09.85,1:23:13.27,Default,,0,0,0,,Жоспарды қазір тоқтатып, Поккуру планетасынан кетіңіз!
Dialogue: 0,1:23:14.23,1:23:15.28,Default,,0,0,0,,Мен бас тартсам ше?
Dialogue: 0,1:23:15.82,1:23:20.53,Default,,0,0,0,,Ол кезде біз сені міндетті түрде жеңеміз!
Dialogue: 0,1:23:20.82,1:23:24.79,Default,,0,0,0,,Хмф хахахахаха! Хаа!
Dialogue: 0,1:23:26.12,1:23:29.17,Default,,0,0,0,,Уау! Ой... ой...
Dialogue: 0,1:23:29.29,1:23:33.34,Default,,0,0,0,,Ха ха ха! Ауыздай емес
Dialogue: 0,1:23:37.97,1:23:42.89,Default,,0,0,0,,Қарғыс атсын мына кішкентай қыз...
Dialogue: 0,1:23:43.01,1:23:44.76,Default,,0,0,0,,Кішкентай қыз емес! (Меба) Иә?
Dialogue: 0,1:23:45.18,1:23:47.52,Default,,0,0,0,,Галактикалық қорғаныс күштері Шизукайо Минамото
Dialogue: 0,1:23:47.98,1:23:50.10,Default,,0,0,0,,Мен Поккуру планетасының жоғалып кетуіне жол бермеймін.
Dialogue: 0,1:23:50.23,1:23:52.48,Default,,0,0,0,,Қарғыс атсын... Қандай әдепсіздік!
Dialogue: 0,1:23:52.61,1:23:55.11,Default,,0,0,0,,Ыстық бұлақтардың құдіретін сезін!
Dialogue: 0,1:23:55.23,1:23:58.15,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,1:23:58.45,1:24:04.03,Default,,0,0,0,,Гипер ыстық бұлақ сәулесі!
Dialogue: 0,1:24:05.20,1:24:07.62,Default,,0,0,0,,Ууу
Dialogue: 0,1:24:07.75,1:24:09.29,Default,,0,0,0,,Әй, ыстық!
Dialogue: 0,1:24:09.41,1:24:12.29,Default,,0,0,0,,Немесе менің денем ериді ...
Dialogue: 0,1:24:12.42,1:24:16.46,Default,,0,0,0,,Уаа...
Dialogue: 0,1:24:18.01,1:24:21.05,Default,,0,0,0,,Мукюуу!
Dialogue: 0,1:24:21.76,1:24:24.97,Default,,0,0,0,,Енді ештеңені дұрыс істемеңіз.
Dialogue: 0,1:24:25.10,1:24:26.35,Default,,0,0,0,,Упип (Меба) Кюк
Dialogue: 0,1:24:26.47,1:24:29.77,Default,,0,0,0,,(Мэйбаның үрейленген дауысы)
Dialogue: 0,1:24:30.60,1:24:32.85,Default,,0,0,0,,үшін жақсы деп үміттенемін...
Dialogue: 0,1:24:34.61,1:24:36.86,Default,,0,0,0,,Хехе, бұл жарқыраған алтын.
Dialogue: 0,1:24:36.98,1:24:40.49,Default,,0,0,0,,Бүгінгі Галактикалық қорғаныс күштері Джан-Саманы жеңу мүмкін емес!
Dialogue: 0,1:24:40.61,1:24:42.95,Default,,0,0,0,,(Оргонның дауысы)
Dialogue: 0,1:24:45.33,1:24:46.45,Default,,0,0,0,,Тікелей анамнан...
Dialogue: 0,1:24:46.79,1:24:48.24,Default,,0,0,0,,Ал!
Dialogue: 0,1:24:48.37,1:24:49.91,Default,,0,0,0,,Ерекше өлім
Dialogue: 0,1:24:50.04,1:24:52.96,Default,,0,0,0,,...
Dialogue: 0,1:24:53.88,1:24:56.25,Default,,0,0,0,,Дұрыс, дұрыс, дұрыс...
Dialogue: 0,1:24:56.38,1:24:58.80,Default,,0,0,0,,(Огоненің ыңырсыуы)
Dialogue: 0,1:25:00.17,1:25:02.05,Default,,0,0,0,,Ооо уау...
Dialogue: 0,1:25:03.68,1:25:07.10,Default,,0,0,0,,Оргон-кун, бұл туралы терең ойланып көр.
Dialogue: 0,1:25:07.22,1:25:08.06,Default,,0,0,0,,Wahoo
Dialogue: 0,1:25:08.31,1:25:12.69,Default,,0,0,0,,Өйткені, денеңе сіңіп кеткен, ауыртпайтын әдіс-тәсілдер әртүрлі.
Dialogue: 0,1:25:13.02,1:25:14.85,Default,,0,0,0,,Рахмет, анашым
Dialogue: 0,1:25:14.98,1:25:16.40,Default,,0,0,0,,Қабылдау
Dialogue: 0,1:25:16.90,1:25:19.82,Default,,0,0,0,,(Дораэмонның айқайы)
Dialogue: 0,1:25:20.11,1:25:21.07,Default,,0,0,0,,Тория!
Dialogue: 0,1:25:25.07,1:25:27.08,Default,,0,0,0,,Жақында толтыру аяқталады.
Dialogue: 0,1:25:27.58,1:25:29.70,Default,,0,0,0,,Менің кемеге қайтатын уақытым келді деп ойлаймын.
Dialogue: 0,1:25:29.83,1:25:31.08,Default,,0,0,0,,Гайд мырза! иә?
Dialogue: 0,1:25:31.62,1:25:33.83,Default,,0,0,0,,Сізге бір нәрсе үлкен жылдамдықпен келуі мүмкін.
Dialogue: 0,1:25:34.25,1:25:36.21,Default,,0,0,0,,Хмм, олар болуы керек!
Dialogue: 0,1:25:36.79,1:25:39.30,Default,,0,0,0,,Енді уақыт жоқ! Шабуылға дайын болыңыз!
Dialogue: 0,1:25:39.42,1:25:42.47,Default,,0,0,0,,Эй, эй! Сені қарғаймын!
Dialogue: 0,1:25:45.05,1:25:47.47,Default,,0,0,0,,Уф...
Dialogue: 0,1:25:47.93,1:25:51.27,Default,,0,0,0,,Иә? Сен әлі тірісің бе, балам?
Dialogue: 0,1:25:51.39,1:25:55.77,Default,,0,0,0,,Біз бұл жерде ұтыла алмаймыз.
Dialogue: 0,1:25:58.86,1:26:00.61,Default,,0,0,0,,Мен уәде бердім!
Dialogue: 0,1:26:00.82,1:26:03.07,Default,,0,0,0,,Поккуру планетасын қорғау
Dialogue: 0,1:26:03.57,1:26:05.49,Default,,0,0,0,,Мен Ааронға уәде бердім!
Dialogue: 0,1:26:05.61,1:26:07.87,Default,,0,0,0,,үшінның күлкісін қорғау!
Dialogue: 0,1:26:08.28,1:26:10.29,Default,,0,0,0,,Сіз білесіз бе!
Dialogue: 0,1:26:11.66,1:26:13.00,Default,,0,0,0,,Не? (Нобита) Иә?
Dialogue: 0,1:26:13.12,1:26:14.71,Default,,0,0,0,,Мен қандай да бір жолмен жылдамырақ қозғала аламын.
Dialogue: 0,1:26:14.83,1:26:16.88,Default,,0,0,0,,Хмм, эй, эй
Dialogue: 0,1:26:17.25,1:26:19.54,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,1:26:19.67,1:26:20.88,Default,,0,0,0,,Сәлем
Dialogue: 0,1:26:21.30,1:26:23.55,Default,,0,0,0,,Хэхе! Кез келген жерден алады...
Dialogue: 0,1:26:23.67,1:26:25.88,Default,,0,0,0,,Егер ол 30 минут күтуді айтса, басқа амалым жоқ шығар
Dialogue: 0,1:26:26.01,1:26:29.64,Default,,0,0,0,,(Икардың жөтелі)
Dialogue: 0,1:26:29.76,1:26:32.77,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,1:26:36.02,1:26:37.94,Default,,0,0,0,,Бұл ауырады…
Dialogue: 0,1:26:38.06,1:26:41.98,Default,,0,0,0,,Хаа
Dialogue: 0,1:26:42.11,1:26:45.78,Default,,0,0,0,,Маған графит беріңізші...
Dialogue: 0,1:26:46.20,1:26:48.78,Default,,0,0,0,,Бұл Ұлы қарақшы Икар ма?
Dialogue: 0,1:26:49.32,1:26:52.29,Default,,0,0,0,,Сіз аздап әлсіз сияқтысыз...
Dialogue: 0,1:26:52.41,1:26:53.66,Default,,0,0,0,,Егер сіз Икарды жеңсеңіз -
Dialogue: 0,1:26:53.79,1:26:55.75,Default,,0,0,0,,Энергия бөлінуін тоқтату мүмкін болуы мүмкін.
Dialogue: 0,1:26:55.87,1:26:58.75,Default,,0,0,0,,Әлі графит жоқ...
Dialogue: 0,1:26:58.88,1:27:02.13,Default,,0,0,0,,Гауһар мен жасаймын...
Dialogue: 0,1:27:02.25,1:27:03.55,Default,,0,0,0,,Икар!
Dialogue: 0,1:27:03.76,1:27:06.05,Default,,0,0,0,,Super Нобита...
Dialogue: 0,1:27:06.34,1:27:08.26,Default,,0,0,0,,Сыпыртқы!
Dialogue: 0,1:27:09.47,1:27:10.80,Default,,0,0,0,,(Икардың ыңырануы)
Dialogue: 0,1:27:10.93,1:27:13.81,Default,,0,0,0,,А-а... бұл бесік қана ғой...
Dialogue: 0,1:27:14.14,1:27:17.06,Default,,0,0,0,,Жоқ, берілме. Жарайды!
Dialogue: 0,1:27:17.39,1:27:21.36,Default,,0,0,0,,Супер Нобита~ Чочо!
Dialogue: 0,1:27:21.48,1:27:24.57,Default,,0,0,0,,Фудзи тауы! Жұлдыз!
Dialogue: 0,1:27:26.82,1:27:29.74,Default,,0,0,0,,Тағы бір сыпырғыш!
Dialogue: 0,1:27:40.25,1:27:41.29,Default,,0,0,0,,Естуімше, ол сенің бала кезден бергі досың.
Dialogue: 0,1:27:41.54,1:27:44.55,Default,,0,0,0,,Энергияның бөлінуіне 30 минут қалды
Dialogue: 0,1:27:44.84,1:27:45.76,Default,,0,0,0,,Шынымен де, осы бейнеойынды жақында өшіргенің жөн —
Dialogue: 0,1:27:45.88,1:27:47.84,Default,,0,0,0,,Жақында гауһар тастар жеткілікті болады...
Dialogue: 0,1:27:47.97,1:27:49.26,Default,,0,0,0,,Сіз оны ала аласыз.
Dialogue: 0,1:27:49.38,1:27:51.05,Default,,0,0,0,,Мен оларға жол бермеймін!
Dialogue: 0,1:27:51.39,1:27:52.89,Default,,0,0,0,,(Дораэмон мен Сунеоның айқайы)
Dialogue: 0,1:27:53.01,1:27:55.85,Default,,0,0,0,,Иә? Апыр-ай!
Dialogue: 0,1:27:56.06,1:27:57.06,Default,,0,0,0,,Таптым!
Dialogue: 0,1:27:57.18,1:27:59.60,Default,,0,0,0,,Қара, қара, қара...
Dialogue: 0,1:27:59.85,1:28:01.06,Default,,0,0,0,,Бірдеңе бар ма? Бірдеңе бар ма?
Dialogue: 0,1:28:01.19,1:28:02.61,Default,,0,0,0,,Ухх
Dialogue: 0,1:28:03.06,1:28:05.32,Default,,0,0,0,,Тым~ Қоқысқа толы! иә?
Dialogue: 0,1:28:05.44,1:28:07.82,Default,,0,0,0,,Дораемон, маған көбірек қоқыс беріңіз!
Dialogue: 0,1:28:07.94,1:28:09.03,Default,,0,0,0,,Иә?
Dialogue: 0,1:28:09.53,1:28:10.36,Default,,0,0,0,,Иә
Dialogue: 0,1:28:10.91,1:28:13.49,Default,,0,0,0,,Не? Ах... (Сунео) Міне, солай!
Dialogue: 0,1:28:16.70,1:28:18.37,Default,,0,0,0,,Жүр, тездетіп мін!
Dialogue: 0,1:28:18.50,1:28:20.12,Default,,0,0,0,,Жақсы (Сунео) Міне!
Dialogue: 0,1:28:20.25,1:28:22.21,Default,,0,0,0,,Теня да батыр ма?
Dialogue: 0,1:28:28.42,1:28:30.59,Default,,0,0,0,,Уау... (тұрғын) Не? Бұл
Dialogue: 0,1:28:32.68,1:28:34.05,Default,,0,0,0,,Бұл ұшақ шоуы ма?
Dialogue: 0,1:28:34.60,1:28:38.22,Default,,0,0,0,,Бұл Мистер Хайд айтқан тосын спектакль ме?
Dialogue: 0,1:28:38.35,1:28:39.31,Default,,0,0,0,,Ицумида-сан ба?
Dialogue: 0,1:28:39.68,1:28:41.14,Default,,0,0,0,,Тұрақты!
Dialogue: 0,1:28:41.27,1:28:43.31,Default,,0,0,0,,Aqua Beam! (3 адам) Ах!
Dialogue: 0,1:28:43.77,1:28:44.81,Default,,0,0,0,,Не?
Dialogue: 0,1:28:45.61,1:28:47.28,Default,,0,0,0,,...
Dialogue: 0,1:28:48.90,1:28:50.99,Default,,0,0,0,,Уау!
Dialogue: 0,1:28:51.78,1:28:53.74,Default,,0,0,0,,Иә!
Dialogue: 0,1:28:56.91,1:29:00.37,Default,,0,0,0,,Қабыл ал!
Dialogue: 0,1:29:00.50,1:29:03.71,Default,,0,0,0,,Ха... мүлде жоқ.
Dialogue: 0,1:29:04.54,1:29:06.59,Default,,0,0,0,,Маған бірдеңе беріңізші.
Dialogue: 0,1:29:06.96,1:29:10.34,Default,,0,0,0,,Бұлай жалғаса берсе, Поккуру планетасы жоғалады!
Dialogue: 0,1:29:10.47,1:29:13.97,Default,,0,0,0,,Жоғалу... (Нобита) А...
Dialogue: 0,1:29:14.18,1:29:18.43,Default,,0,0,0,,Мұндай кішкентай жұлдыздың маңыздылығы неде?
Dialogue: 0,1:29:18.56,1:29:20.14,Default,,0,0,0,,Не? (Икар) Бұл жұлдыз...
Dialogue: 0,1:29:20.27,1:29:24.10,Default,,0,0,0,,Егер ол жоғалып кетсе, қандай мәселе туындайды?
Dialogue: 0,1:29:24.23,1:29:29.57,Default,,0,0,0,,Фухахаха...
Dialogue: 0,1:29:29.69,1:29:30.94,Default,,0,0,0,,Мұны сенің мойныңа артып отырғаныма өкінемін, бірақ қорғаныс үшін саған сенемін.
Dialogue: 0,1:29:31.44,1:29:32.78,Default,,0,0,0,,Иә?
Dialogue: 0,1:29:34.41,1:29:36.70,Default,,0,0,0,,Балалар, мүлде...
Dialogue: 0,1:29:37.66,1:29:39.54,Default,,0,0,0,,Мен сені кешірмеймін!
Dialogue: 0,1:29:39.66,1:29:43.29,Default,,0,0,0,,Уау! Уф уау
Dialogue: 0,1:29:43.83,1:29:45.67,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:29:45.79,1:29:49.63,Default,,0,0,0,,Рұқсатсыз маған қарама.
Dialogue: 0,1:29:54.05,1:29:56.80,Default,,0,0,0,,Не? Мен оны жеңдім
Dialogue: 0,1:29:59.01,1:30:03.06,Default,,0,0,0,,Бірақ бұл энергияның шығуын тоқтата ала ма?
Dialogue: 0,1:30:18.41,1:30:21.41,Default,,0,0,0,,Конняро, ұйықтаңыз!
Dialogue: 0,1:30:21.54,1:30:22.75,Default,,0,0,0,,Мен ес-түссіз жатырмын.
Dialogue: 0,1:30:23.16,1:30:25.87,Default,,0,0,0,,Жоспар туралы ақпарат ала аламын ба?
Dialogue: 0,1:30:26.00,1:30:27.92,Default,,0,0,0,,Еш ойланбастан өтірік айтатындар.
Dialogue: 0,1:30:28.04,1:30:29.63,Default,,0,0,0,,Сіз шындықты айтып тұрған жоқсыз деп ойлаймын.
Dialogue: 0,1:30:29.75,1:30:31.00,Default,,0,0,0,,Міне болды! (3 адам) Иә?
Dialogue: 0,1:30:31.71,1:30:34.38,Default,,0,0,0,,Жоспар деректері Хайдтың рюкзактарында болды!
Dialogue: 0,1:30:34.51,1:30:35.51,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,1:30:35.88,1:30:37.97,Default,,0,0,0,,«Поккуру жұлдызының энергия бөлінуіне байланысты—»
Dialogue: 0,1:30:38.09,1:30:40.51,Default,,0,0,0,,«Алмасты жойып, гауһарды қалпына келтір»
Dialogue: 0,1:30:40.85,1:30:42.52,Default,,0,0,0,,Гауһар! ?
Dialogue: 0,1:30:42.81,1:30:46.19,Default,,0,0,0,,Алмас бұл... бұл планетаның күні...
Dialogue: 0,1:30:46.31,1:30:48.02,Default,,0,0,0,,Солай болды ма?
Dialogue: 0,1:30:48.60,1:30:49.90,Default,,0,0,0,,Алмас —
Dialogue: 0,1:30:50.02,1:30:52.53,Default,,0,0,0,,Әлемдегі ең жоғары тазалық пен қаттылық—
Dialogue: 0,1:30:52.65,1:30:55.03,Default,,0,0,0,,Бұл гауһар тастан жасалған жұлдыз.
Dialogue: 0,1:30:55.28,1:30:56.65,Default,,0,0,0,,Осы уақытқа дейін Алмастың алмасы...
Dialogue: 0,1:30:56.78,1:30:58.74,Default,,0,0,0,,Кейбіреулер қолдарынан алуға тырысты, бірақ...
Dialogue: 0,1:30:58.87,1:31:02.91,Default,,0,0,0,,Оның жеңілдігі мен қаттылығы үшін ешкімнің қолынан келмеді.
Dialogue: 0,1:31:03.41,1:31:07.37,Default,,0,0,0,,Сондықтан бізге Поккуру жұлдызының орасан зор энергиясы қажет болды ма?
Dialogue: 0,1:31:07.50,1:31:08.92,Default,,0,0,0,,Бұл қиын! иә?
Dialogue: 0,1:31:09.29,1:31:11.79,Default,,0,0,0,,Қуатты іске қосуды кері санау басталды.
Dialogue: 0,1:31:11.92,1:31:13.17,Default,,0,0,0,,Е! ? (Сунео) Және де...
Dialogue: 0,1:31:13.30,1:31:14.38,Default,,0,0,0,,Бар болғаны 10 минут!
Dialogue: 0,1:31:14.51,1:31:15.92,Default,,0,0,0,,Не? Міне бітті...
Dialogue: 0,1:31:16.30,1:31:18.13,Default,,0,0,0,,Оны қалай тоқтатуға болады?
Dialogue: 0,1:31:18.26,1:31:19.43,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,1:31:19.68,1:31:21.68,Default,,0,0,0,,Іске қосу құралын жою жұмыс істемейтін сияқты!
Dialogue: 0,1:31:21.97,1:31:23.47,Default,,0,0,0,,Сонымен не істеуім керек?
Dialogue: 0,1:31:23.60,1:31:25.18,Default,,0,0,0,,Егер эмиссия тоқтатылған болса да—
Dialogue: 0,1:31:25.31,1:31:28.19,Default,,0,0,0,,Бұлай жалғаса берсе, Поккуру жұлдызы жарылып кетеді!
Dialogue: 0,1:31:28.35,1:31:30.35,Default,,0,0,0,,Қарақшылық кемеде детонаторсыз —
Dialogue: 0,1:31:30.48,1:31:32.69,Default,,0,0,0,,Мен энергияны толтыруды тоқтата алмаймын!
Dialogue: 0,1:31:32.82,1:31:34.57,Default,,0,0,0,,Қарақшы кеме қазір қайда?
Dialogue: 0,1:31:34.78,1:31:36.74,Default,,0,0,0,,Қазір Алмастың қасында
Dialogue: 0,1:31:36.86,1:31:39.20,Default,,0,0,0,,Мен бұл планетадан 350 000 километр қашықтықтамын!
Dialogue: 0,1:31:39.32,1:31:41.62,Default,,0,0,0,,Қазір тым кеш!
Dialogue: 0,1:31:42.87,1:31:45.58,Default,,0,0,0,,Хмм... Мұны қалай пайдаланамын?
Dialogue: 0,1:31:45.87,1:31:48.33,Default,,0,0,0,,үшін да уайымдаса керек, мен қайтуым керек!
Dialogue: 0,1:31:49.54,1:31:51.08,Default,,0,0,0,,Таямай тұр, Йотаро.
Dialogue: 0,1:31:58.22,1:31:59.84,Default,,0,0,0,,...
Dialogue: 0,1:32:00.80,1:32:02.09,Default,,0,0,0,,Хмм...
Dialogue: 0,1:32:02.80,1:32:04.06,Default,,0,0,0,,үшінна! иә?
Dialogue: 0,1:32:04.18,1:32:06.06,Default,,0,0,0,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,1:32:06.18,1:32:08.60,Default,,0,0,0,,Енді ойлап қарасам, Нобита туралы...
Dialogue: 0,1:32:08.73,1:32:10.14,Default,,0,0,0,,Не? Одан гөрі...
Dialogue: 0,1:32:10.27,1:32:12.10,Default,,0,0,0,,Осындай маңызды уақытта қайда бардыңыз?
Dialogue: 0,1:32:12.36,1:32:14.11,Default,,0,0,0,,Қарақшылар кемесінде... Қарақшылар кемесі! ?
Dialogue: 0,1:32:14.23,1:32:15.48,Default,,0,0,0,,Хмм... қалай?
Dialogue: 0,1:32:15.61,1:32:16.69,Default,,0,0,0,,Тез айт!
Dialogue: 0,1:32:16.82,1:32:17.82,Default,,0,0,0,,Жалқау болмаңыз!
Dialogue: 0,1:32:17.94,1:32:20.36,Default,,0,0,0,,А... мына қарақшының белбеуі сені тасымалдайды...
Dialogue: 0,1:32:20.49,1:32:21.74,Default,,0,0,0,,Асығыңыз! өтінемін!
Dialogue: 0,1:32:21.86,1:32:23.20,Default,,0,0,0,,Толығырақ кейінірек!
Dialogue: 0,1:32:23.32,1:32:24.37,Default,,0,0,0,,Нобита-сан (Сунео) Асығыңыз!
Dialogue: 0,1:32:27.33,1:32:28.37,Default,,0,0,0,,Тезірек іздеңіз!
Dialogue: 0,1:32:29.00,1:32:31.67,Default,,0,0,0,,Эй, сен не іздеп жүрсің?
Dialogue: 0,1:32:31.79,1:32:33.79,Default,,0,0,0,,Міне! Міне осы! (Нобита) Не? ол
Dialogue: 0,1:32:33.92,1:32:37.34,Default,,0,0,0,,Бұл энергиямен жұмыс істейтін детонатор. О, 5 минут қалды!
Dialogue: 0,1:32:37.46,1:32:39.38,Default,,0,0,0,,Не? Бұл қиын!
Dialogue: 0,1:32:46.01,1:32:48.22,Default,,0,0,0,,Уф, жоқ! 30 секунд қалды!
Dialogue: 0,1:32:48.35,1:32:51.14,Default,,0,0,0,,Ақымақ! Соңғы минутқа дейін берілмеңіз!
Dialogue: 0,1:32:52.98,1:32:54.48,Default,,0,0,0,,Поккуру және Алмас планетасы!
Dialogue: 0,1:32:54.61,1:32:55.52,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,1:32:57.57,1:32:58.73,Default,,0,0,0,,Гесо
Dialogue: 0,1:33:00.15,1:33:03.03,Default,,0,0,0,,...
Dialogue: 0,1:33:03.20,1:33:05.03,Default,,0,0,0,,10 секунд қалды...
Dialogue: 0,1:33:07.62,1:33:08.54,Default,,0,0,0,,Міне, осында
Dialogue: 0,1:33:08.91,1:33:14.54,Default,,0,0,0,,５ ４ ３ ２ １…
Dialogue: 0,1:33:15.21,1:33:16.54,Default,,0,0,0,,А, мінеки!
Dialogue: 0,1:33:17.46,1:33:21.22,Default,,0,0,0,,Ашылуымен құттықтаймыз!
Dialogue: 0,1:33:21.63,1:33:23.05,Default,,0,0,0,,Уау
Dialogue: 0,1:33:28.22,1:33:29.06,Default,,0,0,0,,<Алғашқы қадамды жасау>
Dialogue: 0,1:33:29.81,1:33:31.06,Default,,0,0,0,,...
Dialogue: 0,1:33:32.18,1:33:33.06,Default,,0,0,0,,Кезек…
Dialogue: 0,1:33:33.31,1:33:36.06,Default,,0,0,0,,үшінна! Ғарыш капсуласын ішіп, кемеден шығыңыз!
Dialogue: 0,1:33:39.61,1:33:43.65,Default,,0,0,0,,Уау!
Dialogue: 0,1:33:43.78,1:33:47.70,Default,,0,0,0,,Керемет әдемі
Dialogue: 0,1:33:48.58,1:33:50.62,Default,,0,0,0,,Бұл күтпеген қойылым ма?
Dialogue: 0,1:33:50.75,1:33:51.70,Default,,0,0,0,,Иә!
Dialogue: 0,1:34:06.09,1:34:08.85,Default,,0,0,0,,Качинкачин жарық!
Dialogue: 0,1:34:09.81,1:34:11.77,Default,,0,0,0,,Үлкен жарық!
Dialogue: 0,1:34:14.35,1:34:17.73,Default,,0,0,0,,(үшін айғайлайды)
Dialogue: 0,1:34:28.74,1:34:31.49,Default,,0,0,0,,А... Мен оны дәл уақытында орындадым.
Dialogue: 0,1:34:31.83,1:34:34.50,Default,,0,0,0,,Әзірше мен оны Качинкачин жарығымен қатайттым.
Dialogue: 0,1:34:34.62,1:34:39.00,Default,,0,0,0,,Мәселе Алмас пен энергияны қалай қалпына келтіруде.
Dialogue: 0,1:34:39.25,1:34:42.00,Default,,0,0,0,,Егер сіз асықпасаңыз, Поккуру планетасы жоғалады!
Dialogue: 0,1:34:42.30,1:34:44.34,Default,,0,0,0,,Иә, шырылдаған шам —
Dialogue: 0,1:34:44.47,1:34:47.01,Default,,0,0,0,,Ол бар болғаны 5 минутқа созылады (Нобита және басқалар) Иә! ?
Dialogue: 0,1:34:49.10,1:34:50.93,Default,,0,0,0,,(Тұрғындар күңкілдейді)
Dialogue: 0,1:34:51.06,1:34:52.52,Default,,0,0,0,,Не болды?
Dialogue: 0,1:34:52.97,1:34:54.52,Default,,0,0,0,,Суық
Dialogue: 0,1:34:55.27,1:34:58.02,Default,,0,0,0,,Һаронның шағымы рас па?
Dialogue: 0,1:34:58.31,1:35:00.52,Default,,0,0,0,,Хмм... (Нобита) Дұрыс!
Dialogue: 0,1:35:01.07,1:35:03.98,Default,,0,0,0,,Директор Бергердің жылдам кері айналдыру функциясын пайдалана алмайсыз ба?
Dialogue: 0,1:35:04.11,1:35:06.53,Default,,0,0,0,,Түсіндім! (Директор Бергер) Упи!
Dialogue: 0,1:35:07.99,1:35:10.78,Default,,0,0,0,,Рахмет сізге, Бергер мырза.
Dialogue: 0,1:35:10.99,1:35:11.53,Default,,0,0,0,,Upip
Dialogue: 0,1:35:11.95,1:35:14.54,Default,,0,0,0,,Тек Алмас пен Поккуру жұлдызының энергиясы —
Dialogue: 0,1:35:14.79,1:35:16.29,Default,,0,0,0,,Жылдам кері айналдыру!
Dialogue: 0,1:35:16.62,1:35:19.54,Default,,0,0,0,,Дыбыстық сигнал сигналы!
Dialogue: 0,1:35:36.93,1:35:39.27,Default,,0,0,0,,(Тұрғындардың күлкілері мен қошеметтері)
Dialogue: 0,1:35:39.40,1:35:41.23,Default,,0,0,0,,Менің ойымша, бұл біраз уақытты алады...
Dialogue: 0,1:35:41.36,1:35:44.90,Default,,0,0,0,,Іске қосу құрылғысы энергияны жұлдызға қайтару үшін өзгертілді.
Dialogue: 0,1:35:45.32,1:35:48.03,Default,,0,0,0,,үшінңызға қалай алғыс айтамын...
Dialogue: 0,1:35:48.15,1:35:51.91,Default,,0,0,0,,Сізге алғысымды айтсам, қарақшылардың жоспарын бірінші болып байқаған Арон-кунға алғысымды білдіргім келеді.
Dialogue: 0,1:35:52.24,1:35:55.12,Default,,0,0,0,,Кешіріңіз, Арон, мені кешіріңіз.
Dialogue: 0,1:35:55.29,1:35:56.41,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:35:56.54,1:35:59.17,Default,,0,0,0,,Осылайша біз бұл планетаны қорғай алдық.
Dialogue: 0,1:35:59.92,1:36:01.63,Default,,0,0,0,,Жалғыз!
Dialogue: 0,1:36:01.75,1:36:03.71,Default,,0,0,0,,Өткеннен… немесе бәлкім басқа болашақтан
Dialogue: 0,1:36:03.84,1:36:05.59,Default,,0,0,0,,Аарон, сен қайда болдың?
Dialogue: 0,1:36:05.71,1:36:07.92,Default,,0,0,0,,Ол қарақшыларды жеңгенін айтты.
Dialogue: 0,1:36:08.05,1:36:11.18,Default,,0,0,0,,үшін әрқашан жақсы жұмыс істейді.
Dialogue: 0,1:36:11.72,1:36:13.14,Default,,0,0,0,,Хехехе
Dialogue: 0,1:36:13.26,1:36:15.18,Default,,0,0,0,,Арон Иә
Dialogue: 0,1:36:15.85,1:36:17.43,Default,,0,0,0,,Сіз оны қорғай алдыңыз, иә?
Dialogue: 0,1:36:17.81,1:36:19.81,Default,,0,0,0,,Біз жақсы көретіндердің барлығына күлкі
Dialogue: 0,1:36:22.65,1:36:23.73,Default,,0,0,0,,Иә
Dialogue: 0,1:36:41.46,1:36:46.59,Default,,0,0,0,,Егер мұны осы жерде орындасақ...
Dialogue: 0,1:36:46.92,1:36:48.26,Default,,0,0,0,,Ммм
Dialogue: 0,1:36:48.38,1:36:51.55,Default,,0,0,0,,Super Нобита~
Dialogue: 0,1:36:51.68,1:36:53.34,Default,,0,0,0,,Сыпыртқы!
Dialogue: 0,1:36:54.35,1:36:56.85,Default,,0,0,0,,Бух ха ха ха...
Dialogue: 0,1:36:57.22,1:36:58.81,Default,,0,0,0,,Ахаха…
Dialogue: 0,1:36:58.93,1:37:01.85,Default,,0,0,0,,(үшін күледі)
Dialogue: 0,1:37:02.69,1:37:05.56,Default,,0,0,0,,Сен күліп тұрсың, Арон!
Dialogue: 0,1:37:06.07,1:37:12.07,Default,,0,0,0,,♪〜
Dialogue: 0,1:39:57.49,1:40:03.49,Default,,0,0,0,,〜♪
Dialogue: 0,1:40:03.62,1:40:05.29,Default,,0,0,0,,Upip
