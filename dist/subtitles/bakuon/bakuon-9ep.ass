Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:08:00.00,0:08:05.00,,,0,0,0,,Бұл субтитр ✿Hanago және Chinatsu FanSubs✿-пен бірлесіп берілген.
Dialogue: 0,0:02:49.54,0:02:53.20,1080,,0,0,0,,Тізбекте жас шектеулері жоқ, сондықтан сіз кез келген жаста лицензиясыз велосипедпен жүре аласыз.
Dialogue: 0,0:07:23.82,0:07:26.70,1080,,0,0,0,,Бір жыл бойы жүргізуші куәлігін алғанша екі адаммен жүруге болмайды деп шешілді.
Dialogue: 0,0:17:27.90,0:17:29.82,1080,,0,0,0,,Велосипед велосипеді
Dialogue: 0,0:17:29.82,0:17:35.02,1080,,0,0,0,,Бәріміз көңілді велосипед мінейік
Dialogue: 0,0:17:35.02,0:17:38.38,1080,,0,0,0,,Тұтқаны ұстап, қараңыз
Dialogue: 0,0:17:38.38,0:17:41.49,1080,,0,0,0,,Мен өзімді аспан сияқты сезінемін
Dialogue: 0,0:17:41.49,0:17:49.92,1080,,0,0,0,,Әзірше уайымдарыңыз бен күмәндеріңізді ұмытыңыз.
Dialogue: 0,0:17:49.92,0:17:51.62,1080,,0,0,0,,Жылдамдату
Dialogue: 0,0:17:51.62,0:17:53.05,1080,,0,0,0,,Муфтаны босатыңыз
Dialogue: 0,0:17:53.05,0:17:56.51,1080,,0,0,0,,Кету уақыты келді.
Dialogue: 0,0:17:56.51,0:18:07.34,1080,,0,0,0,,...
Dialogue: 0,0:18:07.34,0:18:12.65,1080,,0,0,0,,Велосипед Велосипед Велосипед Велосипед...
Dialogue: 0,0:18:12.65,0:18:17.91,1080,,0,0,0,,Біздің жолымыз мәңгілікке жалғасады
Dialogue: 0,0:18:17.91,0:18:21.24,1080,,0,0,0,,Лайдың шашырағанына мән бермеймін
Dialogue: 0,0:18:21.24,0:18:24.16,1080,,0,0,0,,Нөсерде саяхаттау
Dialogue: 0,0:18:25.02,0:18:32.84,1080,,0,0,0,,Орман жолы Ұлттық магистраль Магистраль асуы
Dialogue: 0,0:00:11.88,0:00:14.45,1080,,0,0,0,,Қайырлы таң Чиу Чан
Dialogue: 0,0:00:19.37,0:00:21.66,1080,,0,0,0,,Шындық осында.
Dialogue: 0,0:00:24.96,0:00:27.71,1080,,0,0,0,,Бұл лентаға не болды?
Dialogue: 0,0:00:27.94,0:00:30.48,1080,,0,0,0,,Крам мектебінде бас киімдер таратылды
Dialogue: 0,0:00:30.48,0:00:33.58,1080,,0,0,0,,Юмеге қарағанда мен В деген баға алдым.
Dialogue: 0,0:00:33.58,0:00:35.74,1080,,0,0,0,,Сізге қолайлы шығу тегі болуы керек.
Dialogue: 0,0:02:06.80,0:02:09.54,1080,,0,0,0,,Қайырлы таң
Dialogue: 0,0:02:09.54,0:02:12.57,1080,,0,0,0,,Барлығыңыз, бүгін бар күшіңізді салыңыз.
Dialogue: 0,0:02:12.80,0:02:14.10,1080,,0,0,0,,Көрінгендей, алыптың ұлы мен жоғары шенді командирлер астанаға шақырылып жатыр.
Dialogue: 0,0:02:14.10,0:02:17.42,1080,,0,0,0,,Нұсқаулық
Dialogue: 0,0:02:17.42,0:02:21.10,1080,,0,0,0,,Ойланып қарасам, апаң да солай істеймін деді.
Dialogue: 0,0:02:21.10,0:02:24.36,1080,,0,0,0,,Емтиханды сәтті тапсырғаннан кейін,
Dialogue: 0,0:02:24.36,0:02:27.12,1080,,0,0,0,,Біздің велоклуб туралы ұмытпаңыз
Dialogue: 0,0:02:27.12,0:02:28.58,1080,,0,0,0,,Ұмытпа
Dialogue: 0,0:02:31.54,0:02:32.82,1080,,0,0,0,,Көрінгендей, алыптың ұлы мен жоғары шенді командирлер астанаға шақырылып жатыр.
Dialogue: 0,0:02:32.82,0:02:34.70,1080,,0,0,0,,Ах, Юме.
Dialogue: 0,0:02:39.31,0:02:41.82,1080,,0,0,0,,Бұл менің әпкем.
Dialogue: 0,0:02:45.90,0:02:49.03,1080,,0,0,0,,Бұл қыз менің сыныптасым Чи Накано.
Dialogue: 0,0:02:49.54,0:02:53.20,1080,,0,0,0,,Сіз орта мектептен бастап мотоцикл мініп жүрсіз бе?
Dialogue: 0,0:02:53.20,0:02:55.98,1080,,0,0,0,,Жоқ, бастауыш сыныптан.
Dialogue: 0,0:02:55.98,0:02:59.84,1080,,0,0,0,,Ол ерте жетілген және қатал адам.
Dialogue: 0,0:02:59.84,0:03:02.42,1080,,0,0,0,,Ол болашағынан үміт күттіретін кіші оқушы.
Dialogue: 0,0:03:02.42,0:03:03.36,1080,,0,0,0,,Мен мүлде не болып жатқанын түсінбеймін.
Dialogue: 0,0:03:03.36,0:03:06.46,1080,,0,0,0,,Мотоцикл клубына қосыл, жел мен еркіндікті бірге сезінейік.
Dialogue: 0,0:03:06.46,0:03:09.04,1080,,0,0,0,,Жоқ, мен әлі қабылданған жоқпын.
Dialogue: 0,0:03:09.04,0:03:10.94,1080,,0,0,0,,В бағасы қандай?
Dialogue: 0,0:03:16.08,0:03:18.92,1080,,0,0,0,,Әпке, бұрын не айтып тұрсыз?
Dialogue: 0,0:03:18.92,0:03:20.94,1080,,0,0,0,,Жүрегіңде қалу
Dialogue: 0,0:03:20.94,0:03:24.34,1080,,0,0,0,,Мен сублиминалды мотоцикл дыбыстарын қостым.
Dialogue: 0,0:03:27.40,0:03:29.46,1080,,0,0,0,,Әр сынып үшін түрлі жарыстарға іріктеу кезеңдері өткізіледі—
Dialogue: 0,0:03:31.64,0:03:34.52,1080,,0,0,0,,Юменің әпкесі жақсы ма?
Dialogue: 0,0:03:34.52,0:03:35.68,1080,,0,0,0,,Не?
Dialogue: 0,0:03:37.64,0:03:39.50,1080,,0,0,0,,бастайық
Dialogue: 0,0:03:41.60,0:03:42.94,1080,,0,0,0,,Жарайды, мен оны шеше аламын.
Dialogue: 0,0:03:42.94,0:03:44.40,1080,,0,0,0,,Тізбекке де бармады
Dialogue: 0,0:03:44.40,0:03:47.38,1080,,0,0,0,,Жазғы каникулдан бері оқуға тұрарлық болды.
Dialogue: 0,0:03:52.80,0:03:56.12,1080,,0,0,0,,Емтихан кезінде велосипед неге есімде?
Dialogue: 0,0:03:56.58,0:03:58.98,1080,,0,0,0,,Мотоциклдерге қатысты мектеп ережелері жоқ.
Dialogue: 0,0:03:58.98,0:04:01.04,1080,,0,0,0,,Мен бұл мектепті таңдаған жоқпын.
Dialogue: 0,0:04:01.04,0:04:05.34,1080,,0,0,0,,Біріншіден, маған жалпыға ортақ жолдарда жүрудің қажеті жоқ.
Dialogue: 0,0:04:05.34,0:04:07.98,1080,,0,0,0,,Менің ұрыс алаңым – бұл айналма
Dialogue: 0,0:04:07.98,0:04:10.68,1080,,0,0,0,,Өйткені мен әрқашан кішкентаймын
Dialogue: 0,0:04:10.68,0:04:12.26,1080,,0,0,0,,Жүгіру жарысы қашанда әбігерге түседі.
Dialogue: 0,0:04:12.84,0:04:14.57,1080,,0,0,0,,Доп ойындары да жақсы емес
Dialogue: 0,0:04:14.88,0:04:16.48,1080,,0,0,0,,Тым баяу тамақ ішу
Dialogue: 0,0:04:18.32,0:04:20.95,1080,,0,0,0,,Менің лақап атым Чиме Чиу болатын
Dialogue: 0,0:04:20.95,0:04:25.22,1080,,0,0,0,,Кішкентай болудың жақсылығы жоқ еді.
Dialogue: 0,0:04:25.24,0:04:26.36,1080,,0,0,0,,Оларға қашып кетуге жол бермеңдер
Dialogue: 0,0:04:27.20,0:04:29.46,1080,,0,0,0,,Тек велосипед басқаша болды.
Dialogue: 0,0:04:29.46,0:04:32.70,1080,,0,0,0,,Жеңіл салмақ өте тиімді
Dialogue: 0,0:04:33.14,0:04:35.68,1080,,0,0,0,,Мен Pokebuy жарысында жеңіске жеттім.
Dialogue: 0,0:04:36.06,0:04:40.85,1080,,0,0,0,,Менің кішкентай денем шын мәнінде менің одақтасым болғанына қатты қуандым.
Dialogue: 0,0:04:44.96,0:04:47.54,1080,,0,0,0,,жылдамырақ
Dialogue: 0,0:04:47.54,0:04:50.48,1080,,0,0,0,,Айналада мені ешкім жеңе алмайды
Dialogue: 0,0:04:50.48,0:04:54.53,1080,,0,0,0,,Күн ашық па, бұлтты ма, бүгін жаңбырлы күн.
Dialogue: 0,0:04:57.38,0:05:00.68,1080,,0,0,0,,Әке, мен жаңа велосипед сатып алдым.
Dialogue: 0,0:05:01.04,0:05:02.92,1080,,0,0,0,,Лицензияны алғаннан кейін
Dialogue: 0,0:05:02.92,0:05:05.50,1080,,0,0,0,,Менде де осындай ең жылдам велосипед бар.
Dialogue: 0,0:05:06.26,0:05:08.86,1080,,0,0,0,,...Мінуге болмайды
Dialogue: 0,0:05:10.38,0:05:13.14,1080,,0,0,0,,Егер бұл жарыс болса, оған аяғыңызды қоюдың қажеті жоқ.
Dialogue: 0,0:05:13.14,0:05:14.74,1080,,0,0,0,,Бірақ жалпыға ортақ жолдарда
Dialogue: 0,0:05:14.74,0:05:18.62,1080,,0,0,0,,Сіз қызыл шам деп аталатын нәрсеге тоқтауыңыз керек.
Dialogue: 0,0:05:20.46,0:05:23.94,1080,,0,0,0,,Бұрын менің одақтасым деп ойлайтын дененің өлшемі болды
Dialogue: 0,0:05:23.94,0:05:25.74,1080,,0,0,0,,Олар бір-біріне жау болған.
Dialogue: 0,0:05:27.02,0:05:28.86,1080,,0,0,0,,Соңында аяғым өспей қалды
Dialogue: 0,0:05:28.86,0:05:34.16,1080,,0,0,0,,Мен Жапонияда он мыңдаған бағдаршамнан қаштым.
Dialogue: 0,0:05:34.16,0:05:37.70,1080,,0,0,0,,Күннің соңында мен үшін велосипед нені білдіреді...
Dialogue: 0,0:05:39.16,0:05:41.50,1080,,0,0,0,,Иә, бәрі осы.
Dialogue: 0,0:05:42.36,0:05:45.90,1080,,0,0,0,,Құлап қалсаң, велоклуб кінәлі.
Dialogue: 0,0:05:45.90,0:05:47.74,1080,,0,0,0,,Чисамэ-чан, қалай болды?
Dialogue: 0,0:05:47.74,0:05:50.02,1080,,0,0,0,,Жарайды, мен қолымнан келгеннің бәрін жасадым.
Dialogue: 0,0:05:51.80,0:05:53.04,1080,,0,0,0,,Бұл тест
Dialogue: 0,0:05:56.54,0:05:58.10,1080,,0,0,0,,Сондай-ақ мотоцикл клубы
Dialogue: 0,0:06:00.30,0:06:01.54,1080,,0,0,0,,Барлығына да
Dialogue: 0,0:06:01.54,0:06:06.02,1080,,0,0,0,,Бағдаршамда доңғалақпен жүрген жол талғамайтын велосипедтерді көрген боларсыз.
Dialogue: 0,0:06:06.02,0:06:09.50,1080,,0,0,0,,Егер жол талғамайтындар мұны істемесе, олар өледі.
Dialogue: 0,0:06:09.50,0:06:11.12,1080,,0,0,0,,Солай ма?
Dialogue: 0,0:06:11.12,0:06:12.78,1080,,0,0,0,,Мен білмедім
Dialogue: 0,0:06:12.78,0:06:15.86,1080,,0,0,0,,Жоқ, олар сезімтал ханымдар.
Dialogue: 0,0:06:15.86,0:06:19.26,1080,,0,0,0,,Сіз қалай ойлайсыз? Менің ойымша, сізде велосипедке қызығушылық пайда болды.
Dialogue: 0,0:06:19.26,0:06:21.08,1080,,0,0,0,,Қызығушылық...
Dialogue: 0,0:06:21.08,0:06:24.32,1080,,0,0,0,,...Тіпті емтихан кезінде мен ''Мен бүгін таңертең естідім'' деп айқайлаған дауысты естідім.
Dialogue: 0,0:06:24.32,0:06:26.16,1080,,0,0,0,,Мен оны ойымнан шығара алмаймын
Dialogue: 0,0:06:26.16,0:06:29.00,1080,,0,0,0,,Мен де x3
Dialogue: 0,0:06:29.00,0:06:31.20,1080,,0,0,0,,Басқа құрбандар болды ма?
Dialogue: 0,0:06:31.78,0:06:34.62,1080,,0,0,0,,Міне, емтихан аяқталды.
Dialogue: 0,0:06:34.62,0:06:37.64,1080,,0,0,0,,Мотоциклдердің сүйкімділігі туралы баяу сөйлесейік.
Dialogue: 0,0:06:37.64,0:06:40.26,1080,,0,0,0,,Бізде дәмді шай да бар.
Dialogue: 0,0:06:40.26,0:06:43.96,1080,,0,0,0,,Бірақ велосипедпен жүру мотоцикл мінгеннен гөрі салмақ жоғалтуға көмектеседі.
Dialogue: 0,0:06:45.60,0:06:48.34,1080,,0,0,0,,Қараңдаршы, мына жерде біреу велосипедпен келе жатыр.
Dialogue: 0,0:06:48.34,0:06:50.62,1080,,0,0,0,,Бұл адам велоклубтан емес.
Dialogue: 0,0:06:51.19,0:06:53.36,1080,,0,0,0,,Маған өз оқиғаңызды айтып беріңізші.
Dialogue: 0,0:06:53.36,0:06:55.50,1080,,0,0,0,,Шай ішу
Dialogue: 0,0:06:55.50,0:06:57.02,1080,,0,0,0,,Не?
Dialogue: 0,0:07:00.50,0:07:02.91,1080,,0,0,0,,Күте тұрыңыз, Чиу-чан
Dialogue: 0,0:07:02.91,0:07:06.60,1080,,0,0,0,,Немене, жұртты жинап әуре болды.
Dialogue: 0,0:07:12.92,0:07:16.18,1080,,0,0,0,,Түсіндім, Юмэ Чан емтиханды тапсырды ма?
Dialogue: 0,0:07:16.18,0:07:17.76,1080,,0,0,0,,Сабарудың арқасында болар.
Dialogue: 0,0:07:17.76,0:07:21.26,1080,,0,0,0,,Мен апамның сол орта мектепте оқитынына қуаныштымын.
Dialogue: 0,0:07:21.26,0:07:23.82,1080,,0,0,0,,Хейннің лицензия алғанына бір жыл болды.
Dialogue: 0,0:07:23.82,0:07:26.70,1080,,0,0,0,,Көктемнен бастап сіз оны велосипедіңіздің артқы жағында міне аласыз.
Dialogue: 0,0:07:26.70,0:07:28.93,1080,,0,0,0,,Айя, бұл...
Dialogue: 0,0:07:28.93,0:07:31.46,1080,,0,0,0,,Мен велосипедте жақсымын
Dialogue: 0,0:07:31.46,0:07:34.82,1080,,0,0,0,,Екеуің бортқа мінсең де.
Dialogue: 0,0:07:34.82,0:07:37.52,1080,,0,0,0,,Мәселе мынада, мен оны мінгім келмейді.
Dialogue: 0,0:07:37.52,0:07:39.88,1080,,0,0,0,,Дұрыс, ол қыз да өтті.
Dialogue: 0,0:07:39.88,0:07:42.74,1080,,0,0,0,,Мен қабылдау емтиханында кездескен осындай шашы бар қыз
Dialogue: 0,0:07:42.74,0:07:44.52,1080,,0,0,0,,О, анау жігіт
Dialogue: 0,0:07:44.52,0:07:47.26,1080,,0,0,0,,Бізге екінші жылға таяп қалды, солай емес пе?
Dialogue: 0,0:07:47.26,0:07:50.20,1080,,0,0,0,,Дегенмен көктем кездесулер мезгілі.
Dialogue: 0,0:07:50.20,0:07:52.46,1080,,0,0,0,,Сонымен бірге қоштасу мезгілі де.
Dialogue: 0,0:07:52.46,0:07:54.96,1080,,0,0,0,,Қоштасу бітіруді білдіреді
Dialogue: 0,0:07:56.10,0:07:58.40,1080,,0,0,0,,Райму-сенпай
Dialogue: 0,0:08:05.12,0:08:08.51,1080,,0,0,0,,Райму-сенпай, ол үшінші курс студенті.
Dialogue: 0,0:08:08.51,0:08:12.36,1080,,0,0,0,,Неге екені белгісіз, мен сені әрқашан мотоцикл клубында болатындай сезіндім.
Dialogue: 0,0:08:12.36,0:08:13.96,1080,,0,0,0,,Бұл дұрыс болуы мүмкін емес.
Dialogue: 0,0:08:13.96,0:08:16.18,1080,,0,0,0,,Мен сізді біртүрлі адам деп ойладым.
Dialogue: 0,0:08:16.18,0:08:19.30,1080,,0,0,0,,Жоғалып кеткенін ойласам, аздап қынжыламын.
Dialogue: 0,0:08:19.30,0:08:22.62,1080,,0,0,0,,Ол мен үшін бәрін жасады, соның ішінде май ауыстырды.
Dialogue: 0,0:08:22.62,0:08:26.08,1080,,0,0,0,,Мен білмей тұрып, ол тіпті менің көлігімді де жуып берді.
Dialogue: 0,0:08:26.08,0:08:30.37,1080,,0,0,0,,Менің ойымша, қазірден бастап мен бәрін өзім істей алуым керек.
Dialogue: 0,0:08:30.37,0:08:32.56,1080,,0,0,0,,Бізде кеш болуы керек.
Dialogue: 0,0:08:32.56,0:08:33.90,1080,,0,0,0,,Партия?
Dialogue: 0,0:08:33.90,0:08:35.82,1080,,0,0,0,,Бұл не? Бұтадан таяқшаға дейін
Dialogue: 0,0:08:35.82,0:08:38.46,1080,,0,0,0,,Райму-сенпайға алғыспен
Dialogue: 0,0:08:38.46,0:08:40.36,1080,,0,0,0,,Бұл мектеп бітіру кеші.
Dialogue: 0,0:08:40.36,0:08:43.42,1080,,0,0,0,,Онда бұл туралы үлкендерге айтпа.
Dialogue: 0,0:08:43.42,0:08:45.74,1080,,0,0,0,,Иә, мен сізді таң қалдырғым келеді.
Dialogue: 0,0:08:45.74,0:08:48.14,1080,,0,0,0,,Жарайды.
Dialogue: 0,0:08:48.74,0:08:50.42,1080,,0,0,0,,Сен эмоцияларыңды басқара алмайсың ғана емес, сонымен бірге тәуекелден қорқатын, өзін-өзі сақтауға бағытталған ой-санамен әрекет етесің.
Dialogue: 0,0:08:50.42,0:08:53.28,1080,,0,0,0,,Дегенмен, ағаларымызды шығарып салу үшін
Dialogue: 0,0:08:53.28,0:08:55.68,1080,,0,0,0,,Менің бір ісім бар.
Dialogue: 0,0:08:55.68,0:08:57.10,1080,,0,0,0,,Мен оны… қолданамын деп ойламаған едім
Dialogue: 0,0:08:57.10,0:09:01.07,1080,,0,0,0,,Үлкендеріңізсіз жақсы жұмыс істей алатыныңызды дәлелдеңіз.
Dialogue: 0,0:09:01.07,0:09:04.40,1080,,0,0,0,,Түсіндім, үлкендерді сендіру керек.
Dialogue: 0,0:09:04.40,0:09:06.04,1080,,0,0,0,,Бірақ қалай?
Dialogue: 0,0:09:06.04,0:09:08.80,1080,,0,0,0,,Менде бұл туралы түсінік бар.
Dialogue: 0,0:09:16.87,0:09:20.86,1080,,0,0,0,,Сізді мектеп бітіруіңізбен құттықтаймыз, аға
Dialogue: 0,0:09:34.02,0:09:35.92,1080,,0,0,0,,Иә Директордың кабинеті
Dialogue: 0,0:09:37.28,0:09:41.02,1080,,0,0,0,,Лие Акина ностальгиялық
Dialogue: 0,0:09:41.02,0:09:44.24,1080,,0,0,0,,Бұл баяғыда сыныптың бас қосуында болды.
Dialogue: 0,0:09:44.24,0:09:46.26,1080,,0,0,0,,Тазуко жақсы болды.
Dialogue: 0,0:09:46.26,0:09:47.44,1080,,0,0,0,,Иә
Dialogue: 0,0:09:47.44,0:09:50.28,1080,,0,0,0,,Не керек, кенеттен қоңырау шалды ма?
Dialogue: 0,0:09:50.28,0:09:54.80,1080,,0,0,0,,Дұрыс. Осы көктемнен бастап қызым Окануэге барады.
Dialogue: 0,0:09:54.80,0:09:55.88,1080,,0,0,0,,Иә
Dialogue: 0,0:09:55.88,0:09:59.28,1080,,0,0,0,,Менің қызым біздің орта мектепте оқиды.
Dialogue: 0,0:10:01.00,0:10:04.25,1080,,0,0,0,,Сіз қашан үйлендіңіз?
Dialogue: 0,0:10:07.92,0:10:10.52,1080,,0,0,0,,Чиу Накано
Dialogue: 0,0:10:10.52,0:10:14.04,1080,,0,0,0,,Мен сенен осыншама жаста бала туады деп күткен жоқпын.
Dialogue: 0,0:10:14.04,0:10:16.96,1080,,0,0,0,,Мен мұны жасырғым келмеді.
Dialogue: 0,0:10:16.96,0:10:18.98,1080,,0,0,0,,Бұл өте ауыр
Dialogue: 0,0:10:18.98,0:10:23.86,1080,,0,0,0,,Қараңызшы, сізде әрқашан еркектерді аулақ ұстауға бейім болды.
Dialogue: 0,0:10:23.86,0:10:25.88,1080,,0,0,0,,Міне, солай
Dialogue: 0,0:10:25.88,0:10:28.70,1080,,0,0,0,,Райму-сенпай кінәлі ме?
Dialogue: 0,0:10:31.42,0:10:34.38,1080,,0,0,0,,Менімен бірге келіңізші.
Dialogue: 0,0:10:34.38,0:10:38.50,1080,,0,0,0,,Мен саған былғары костюміңмен бір көргеннен ғашық болдым.
Dialogue: 0,0:10:38.50,0:10:41.50,1080,,0,0,0,,Қоңырау достарынан бастайық
Dialogue: 0,0:10:42.83,0:10:47.72,1080,,0,0,0,,Қараңдар, сен NSRсың, ал мен MVX ата-бабасымын.
Dialogue: 0,0:10:47.72,0:10:50.84,1080,,0,0,0,,Иә, менің саған сыйлығым бар.
Dialogue: 0,0:10:56.14,0:10:58.20,1080,,0,0,0,,Жоқ
Dialogue: 0,0:10:59.68,0:11:03.54,1080,,0,0,0,,Фантастикалық опция Үндеткіш типті керек-жарақ корпусы
Dialogue: 0,0:11:03.54,0:11:05.52,1080,,0,0,0,,Консервіленген кофе, өтінемін.
Dialogue: 0,0:11:05.84,0:11:07.74,1080,,0,0,0,,Өтінемін...
Dialogue: 0,0:11:09.44,0:11:11.00,1080,,0,0,0,,Иә.
Dialogue: 0,0:11:11.00,0:11:13.32,1080,,0,0,0,,Егер сіз мотоцикл жарысында жеңсеңіз
Dialogue: 0,0:11:13.32,0:11:15.16,1080,,0,0,0,,Менімен бірге шығуға болады.
Dialogue: 0,0:11:15.16,0:11:18.16,1080,,0,0,0,,Дегенмен, сіз мұнымен күресіп жатырсыз
Dialogue: 0,0:11:18.16,0:11:21.64,1080,,0,0,0,,Кавасаки Мах Райму-сенпай
Dialogue: 0,0:11:23.10,0:11:25.00,1080,,0,0,0,,Қозғалтқыштың ығысуына байланысты мүгедектік ретінде
Dialogue: 0,0:11:25.00,0:11:27.50,1080,,0,0,0,,Райму-сенпай 30 секундтан кейін басталады.
Dialogue: 0,0:11:27.50,0:11:29.92,1080,,0,0,0,,Ережелер мені қызықтырмайды.
Dialogue: 0,0:11:29.92,0:11:31.94,1080,,0,0,0,,Өйткені нәтиже шешілді
Dialogue: 0,0:11:33.76,0:11:36.10,1080,,0,0,0,,Махаббат жеңеді
Dialogue: 0,0:11:36.10,0:11:38.10,1080,,0,0,0,,Ғажайып мұнай шашырауы
Dialogue: 0,0:11:38.10,0:11:41.54,1080,,0,0,0,,Оның бір жыл ішінде тоқтатылуы таңқаларлық емес.
Dialogue: 0,0:11:42.06,0:11:45.92,1080,,0,0,0,,3 2 1 Бастау
Dialogue: 0,0:11:48.70,0:11:51.36,1080,,0,0,0,,Мен саған сенемін, Райму-сенпай.
Dialogue: 0,0:11:51.94,0:11:54.26,1080,,0,0,0,,Мені соттағандардың бәрі
Dialogue: 0,0:11:54.26,0:11:56.46,1080,,0,0,0,,Райму-сенпай мені өлтіреді.
Dialogue: 0,0:11:59.04,0:12:01.02,1080,,0,0,0,,Бұл көп орын, Тазуко.
Dialogue: 0,0:12:01.02,0:12:04.18,1080,,0,0,0,,Өйткені үлкендер ешқашан жеңілмейді.
Dialogue: 0,0:12:04.18,0:12:06.06,1080,,0,0,0,,Жақсы.
Dialogue: 0,0:12:06.06,0:12:10.30,1080,,0,0,0,,Тазуко үлкенге қатты сенеді, солай емес пе?
Dialogue: 0,0:12:11.58,0:12:14.22,1080,,0,0,0,,Әлгі жігіттер темекіні лақтырып жатыр.
Dialogue: 0,0:12:14.22,0:12:15.74,1080,,0,0,0,,Мен абай болуым керек
Dialogue: 0,0:12:20.22,0:12:22.16,1080,,0,0,0,,Қауіпті Қауіпті
Dialogue: 0,0:12:22.16,0:12:25.77,1080,,0,0,0,,Бұл бұрын-соңды болмаған қорқыту сезімі қандай?
Dialogue: 0,0:12:43.54,0:12:46.86,1080,,0,0,0,,Мен жасадым мен жасадым Мен бірінші рет қыз ала аламын
Dialogue: 0,0:12:46.86,0:12:48.62,1080,,0,0,0,,Мен анама айтуым керек.
Dialogue: 0,0:12:48.62,0:12:51.21,1080,,0,0,0,,Мені қазір сүй
Dialogue: 0,0:12:54.67,0:12:57.12,1080,,0,0,0,,Ақымақ.
Dialogue: 0,0:12:56.20,0:12:58.29,1080,,0,0,0,,Mvx
Dialogue: 0,0:12:58.66,0:13:03.16,1080,,0,0,0,,Райму-сенпай бізді қорғаған емес пе?
Dialogue: 0,0:13:03.16,0:13:05.06,1080,,0,0,0,,Тіпті қазір де
Dialogue: 0,0:13:05.74,0:13:08.44,1080,,0,0,0,,Меніңше, сен әлі барсың, Сенпай.
Dialogue: 0,0:13:08.44,0:13:10.30,1080,,0,0,0,,Сіз қайдан білесіз?
Dialogue: 0,0:13:10.30,0:13:13.14,1080,,0,0,0,,Өйткені жыл сайын жаңа жылдық карталар келеді.
Dialogue: 0,0:13:13.14,0:13:15.26,1080,,0,0,0,,Мотоцикл клубының бөлмесінің мекенжайы бойынша.
Dialogue: 0,0:13:17.24,0:13:19.58,1080,,0,0,0,,Әйтеуір, Райму-сенпай.
Dialogue: 0,0:13:19.58,0:13:21.61,1080,,0,0,0,,Сіз мұнда қанша уақыт болдыңыз деп ойлаймын.
Dialogue: 0,0:13:21.61,0:13:24.00,1080,,0,0,0,,Және ол қанша уақытқа созылады?
Dialogue: 0,0:13:25.24,0:13:29.28,1080,,0,0,0,,Мен кете алмауымның себебі бар екеніне сенімдімін.
Dialogue: 0,0:13:29.28,0:13:33.71,1080,,0,0,0,,Сіз қанша оқушының бітіруін көрдіңіз?
Dialogue: 0,0:13:33.71,0:13:37.88,1080,,0,0,0,,Менің де бітіретін күн келер ме екен, аға буын өкілдері.
Dialogue: 0,0:13:37.88,0:13:40.10,1080,,0,0,0,,Максималды бұрылыс
Dialogue: 0,0:13:50.80,0:13:52.54,1080,,0,0,0,,Міне.
Dialogue: 0,0:13:52.54,0:13:54.34,1080,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:13:54.34,0:13:55.60,1080,,0,0,0,,Шынымен басқа біреуді кінәлағың келе ме?
Dialogue: 0,0:13:55.60,0:13:58.88,1080,,0,0,0,,Қарттарымызға қалай өскенімізді көрсетейік.
Dialogue: 0,0:13:58.88,0:14:02.04,1080,,0,0,0,,Бірақ бұл шынымен де өзіңді қауіпсіз сезіне ала ма?
Dialogue: 0,0:14:02.04,0:14:03.44,1080,,0,0,0,,Әрине
Dialogue: 0,0:14:03.44,0:14:06.56,1080,,0,0,0,,Мектеп бітіру рәсіміне дейін хаттарды жерге жаза алатындарыңды тексеремін.
Dialogue: 0,0:14:06.56,0:14:10.82,1080,,0,0,0,,Ал барлық оқушыларға мотоцикл клубы осында екенін білсін.
Dialogue: 0,0:14:14.58,0:14:16.54,1080,,0,0,0,,Райму-сенпай
Dialogue: 0,0:14:20.74,0:14:22.60,1080,,0,0,0,,Рю жылды қайталайды ма?
Dialogue: 0,0:14:22.60,0:14:25.82,1080,,0,0,0,,Сонымен, келесі жылы да мотоцикл клубында боласыз ба?
Dialogue: 0,0:14:37.86,0:14:41.68,1080,,0,0,0,,Шие гүлінің туннелі сияқты
Dialogue: 0,0:14:45.42,0:14:47.49,1080,,0,0,0,,Юме
Dialogue: 0,0:14:49.06,0:14:50.96,1080,,0,0,0,,Үлкен әпке
Dialogue: 0,0:14:50.96,0:14:52.41,1080,,0,0,0,,О-саки
Dialogue: 0,0:14:53.10,0:14:55.86,1080,,0,0,0,,Honda CB400 Super Four?
Dialogue: 0,0:14:55.86,0:15:00.54,1080,,0,0,0,,Сіз өте білімдісіз. Олардың барлығы маған ұқсайды.
Dialogue: 0,0:15:00.54,0:15:03.32,1080,,0,0,0,,Жаттығу құралы ретінде жиі қолданылатын модель.
Dialogue: 0,0:15:03.32,0:15:05.76,1080,,0,0,0,,Орынның биіктігі 755 мм
Dialogue: 0,0:15:06.26,0:15:09.66,1080,,0,0,0,,Suzuki GSX400S Katana
Dialogue: 0,0:15:09.66,0:15:12.18,1080,,0,0,0,,Орындық биіктігі 750мм
Dialogue: 0,0:15:12.92,0:15:15.24,1080,,0,0,0,,Yamaha Serrow 225
Dialogue: 0,0:15:15.24,0:15:19.18,1080,,0,0,0,,Жол талғамайтын көліктерге арналған орындықтың төмен биіктігі: 810 мм
Dialogue: 0,0:15:19.18,0:15:22.08,1080,,0,0,0,,790 мм
Dialogue: 0,0:15:22.08,0:15:26.08,1080,,0,0,0,,Эй Чиу-чан, неге бұл жай ғана орындық биіктігі?
Dialogue: 0,0:15:26.08,0:15:29.64,1080,,0,0,0,,Велосипедтегі ең маңызды нәрсе - ауырлық центрінің орналасуы.
Dialogue: 0,0:15:29.64,0:15:31.72,1080,,0,0,0,,Басқаша айтқанда, бұл орындық биіктігіне байланысты.
Dialogue: 0,0:15:32.98,0:15:35.58,1080,,0,0,0,,Баршалар оқуларың мен үйірме жұмыстарына көп еңбектеніңдер.
Dialogue: 0,0:15:35.58,0:15:38.38,1080,,0,0,0,,Орта мектептегі өмірді қызықты өткізіңіз
Dialogue: 0,0:15:38.38,0:15:41.48,1080,,0,0,0,,Бағаны қайталамауыңызды өтінемін.
Dialogue: 0,0:15:41.48,0:15:43.48,1080,,0,0,0,,Жоғарыда көрсетілген ресми мекенжай болуы керек.
Dialogue: 0,0:15:43.48,0:15:45.36,1080,,0,0,0,,Сіз жүгіргіңіз келе ме?
Dialogue: 0,0:15:45.36,0:15:47.50,1080,,0,0,0,,Неге біреуді таяқпен ұрмасқа?
Dialogue: 0,0:15:47.50,0:15:49.54,1080,,0,0,0,,Біреуді лақтырғыңыз келмейді ме?
Dialogue: 0,0:15:49.54,0:15:51.76,1080,,0,0,0,,Неліктен дымқыл суға түсуге болмайды?
Dialogue: 0,0:15:50.82,0:15:53.50,1080,,0,0,0,,Менің ойымша, тым кеш.
Dialogue: 0,0:15:53.50,0:15:55.76,1080,,0,0,0,,Барлығы сондай ынталы.
Dialogue: 0,0:15:55.76,0:15:58.40,1080,,0,0,0,,Бұлай алға жылжу мүмкін емес.
Dialogue: 0,0:15:58.40,0:16:01.30,1080,,0,0,0,,Бұл белгіні ешкім көре алмайды.
Dialogue: 0,0:16:01.30,0:16:02.74,1080,,0,0,0,,Менде басқа амал жоқ.
Dialogue: 0,0:16:02.74,0:16:04.10,1080,,0,0,0,,Мұндай жағдайда
Dialogue: 0,0:16:04.10,0:16:07.58,1080,,0,0,0,,Барлығын ертеңгі клуб қызметі туралы брифинг сессиясына салайық
Dialogue: 0,0:16:08.92,0:16:12.64,1080,,0,0,0,,Мотоцикл клубы туралы қандай түсініктеме бересіз?
Dialogue: 0,0:16:12.64,0:16:15.87,1080,,0,0,0,,Мүмкін, мен оны тексергенім жөн болар.
Dialogue: 0,0:16:17.68,0:16:21.92,1080,,0,0,0,,Әй, мектептегі фестивальде Сузуки мотоциклін мінген сенсің ғой?
Dialogue: 0,0:16:21.92,0:16:23.50,1080,,0,0,0,,Иә, бірақ
Dialogue: 0,0:16:24.84,0:16:26.54,1080,,0,0,0,,Курс
Dialogue: 0,0:16:26.54,0:16:30.74,1080,,0,0,0,,Брифинг сессиясында велосипедіңізді сахнаға қоюға болмайды.
Dialogue: 0,0:16:30.74,0:16:35.24,1080,,0,0,0,,Иә, аудитория деп аталса да, күткендей жабық.
Dialogue: 0,0:16:35.24,0:16:38.80,1080,,0,0,0,,Жарайды, мен бұл туралы мотоцикл клубына айтамын.
Dialogue: 0,0:16:38.80,0:16:41.90,1080,,0,0,0,,Өтінемін, мен олай ойламаймын.
Dialogue: 0,0:16:41.90,0:16:45.23,1080,,0,0,0,,Олар сол ниетпен барса, қиын болады.
Dialogue: 0,0:16:45.66,0:16:49.98,1080,,0,0,0,,Бұл мотоцикл клубы осындай нәрсені жасай алады.
Dialogue: 0,0:16:51.36,0:16:53.34,1080,,0,0,0,,Қорқып қалмаңдар
Dialogue: 0,0:16:53.34,0:16:55.88,1080,,0,0,0,,Мен қазір велосипедімді шығара алмайтыныма сенбеймін.
Dialogue: 0,0:16:55.88,0:16:58.74,1080,,0,0,0,,Неліктен сол күні осындай нәрсені білуге ​​болады?
Dialogue: 0,0:16:58.74,0:17:01.68,1080,,0,0,0,,Қозғалтқышты қара түспен жанып, пульсациямен көрсетсеңіз
Dialogue: 0,0:17:01.68,0:17:04.00,1080,,0,0,0,,Мен бұл ең жақсы деп ойладым
Dialogue: 0,0:17:04.00,0:17:07.54,1080,,0,0,0,,Мен не істеуім керек? Бар болғаны бір сағат қалды.
Dialogue: 0,0:17:07.54,0:17:11.66,1080,,0,0,0,,Егер мен мұны кеше білгенімде, мен бұл туралы бірдеңе істей алар едім.
Dialogue: 0,0:17:11.66,0:17:13.56,1080,,0,0,0,,Мен бір нәрсе туралы ойлауым керек
Dialogue: 0,0:17:14.58,0:17:19.62,1080,,0,0,0,,Жоғарыда жеңіл музыка бөлімі «Картоп – негізгі тағам» қойылымы болды.
Dialogue: 0,0:17:20.52,0:17:22.98,1080,,0,0,0,,Келесі кезекте мотоцикл клубы.
Dialogue: 0,0:17:41.49,0:17:43.94,1080,,0,0,0,,Жоқ, не?
Dialogue: 0,0:17:43.94,0:17:46.10,1080,,0,0,0,,Біртүрлі қозғалыстар
Dialogue: 0,0:17:46.10,0:17:48.96,1080,,0,0,0,,Дәлірек айтсақ, ән де біртүрлі.
Dialogue: 0,0:18:04.10,0:18:05.64,1080,,0,0,0,,Қандай ұят.
Dialogue: 0,0:18:05.64,0:18:07.38,1080,,0,0,0,,Рин-сан
Dialogue: 0,0:18:07.38,0:18:11.76,1080,,0,0,0,,Мына ақымақ киімді қарашы, бұл күлкілі.
Dialogue: 0,0:18:18.02,0:18:20.74,1080,,0,0,0,,Бірақ мен жай ғана күліп жатқан жоқпын.
Dialogue: 0,0:18:20.74,0:18:24.40,1080,,0,0,0,,Велосипедпен жүрудің қызық екенін жеткізе аласыз.
Dialogue: 0,0:18:25.66,0:18:26.98,1080,,0,0,0,,Көңілді ме?
Dialogue: 0,0:18:31.28,0:18:32.64,1080,,0,0,0,,Велосипед?
Dialogue: 0,0:18:34.56,0:18:37.55,1080,,0,0,0,,Бәйгеде жеңілмейтін болдым
Dialogue: 0,0:18:37.94,0:18:41.60,1080,,0,0,0,,Мен сіздермен мінбеге шыққаныма қуаныштымын.
Dialogue: 0,0:18:42.24,0:18:45.50,1080,,0,0,0,,Достарымен көңілді болып көрінетін адамдар
Dialogue: 0,0:18:45.50,0:18:47.16,1080,,0,0,0,,Әрқашан тек 2-орын
Dialogue: 0,0:18:47.16,0:18:49.56,1080,,0,0,0,,Мен ешкіммен араласпаймын
Dialogue: 0,0:18:49.56,0:18:51.60,1080,,0,0,0,,Майданда жалғыз жүгірді.
Dialogue: 0,0:18:52.14,0:18:54.16,1080,,0,0,0,,1-орын әрқашан жалғыз
Dialogue: 0,0:18:54.16,0:18:55.62,1080,,0,0,0,,Мен жалғызбын
Dialogue: 0,0:18:55.62,0:18:57.46,1080,,0,0,0,,Сондықтан оның саны 1
Dialogue: 0,0:18:57.46,0:18:58.96,1080,,0,0,0,,Дұрыс, Сенпай.
Dialogue: 0,0:19:05.14,0:19:09.08,1080,,0,0,0,,Сәлеметсіз бе, бұл мотоцикл клубы.
Dialogue: 0,0:19:11.20,0:19:16.56,1080,,0,0,0,,Енді сіз мотоциклдер туралы көп білмейсіз деп ойлаймын.
Dialogue: 0,0:19:16.56,0:19:18.58,1080,,0,0,0,,Мен сізді естімеймін.
Dialogue: 0,0:19:20.18,0:19:21.68,1080,,0,0,0,,Осы жерден...
Dialogue: 0,0:19:21.68,0:19:22.48,1080,,0,0,0,,Өткен жылға дейін
Dialogue: 0,0:19:22.48,0:19:25.32,1080,,0,0,0,,Сакура Хейн мотоциклдегі В әрпін де білмейтін.
Dialogue: 0,0:19:25.32,0:19:27.96,1080,,0,0,0,,Мотоциклдердің тартымдылығы туралы айтады.
Dialogue: 0,0:19:27.96,0:19:29.20,1080,,0,0,0,,Мен?
Dialogue: 0,0:19:32.06,0:19:33.50,1080,,0,0,0,,Ух...мм
Dialogue: 0,0:19:33.50,0:19:38.12,1080,,0,0,0,,Велосипедпен мектебімнің алдындағы еңісте жүргенді ұнатпаймын.
Dialogue: 0,0:19:38.12,0:19:40.70,1080,,0,0,0,,Сіз мотоцикл міну туралы ойладыңыз, солай ма?
Dialogue: 0,0:19:40.70,0:19:43.74,1080,,0,0,0,,Алғашында лицензия керек екенін білмедім.
Dialogue: 0,0:19:43.74,0:19:46.12,1080,,0,0,0,,Лицензия алу қиын.
Dialogue: 0,0:19:46.12,0:19:48.32,1080,,0,0,0,,Иә, қиын туралы айтатын болсақ...
Dialogue: 0,0:19:48.32,0:19:51.08,1080,,0,0,0,,Жазы ыстық, қысы суық.
Dialogue: 0,0:19:51.08,0:19:55.48,1080,,0,0,0,,Мен оны тұрақтан шығарсам, оның ауырлығы сонша, маған ұнамайды.
Dialogue: 0,0:19:55.48,0:19:56.46,1080,,0,0,0,,Бұл не?
Dialogue: 0,0:19:56.46,0:20:00.16,1080,,0,0,0,,Мен неге олай ойлап, мотоцикл айдап жүрмін?
Dialogue: 0,0:20:02.62,0:20:04.96,1080,,0,0,0,,Бірақ.
Dialogue: 0,0:20:04.96,0:20:08.62,1080,,0,0,0,,Не болса да бәрі мені күтіп отырды.
Dialogue: 0,0:20:08.62,0:20:11.92,1080,,0,0,0,,Лицензия алу кезінде және гастрольдік сапарларда
Dialogue: 0,0:20:11.92,0:20:15.30,1080,,0,0,0,,Мотоциклдер бір адамға арналған көлік ретінде қарастырылады.
Dialogue: 0,0:20:15.30,0:20:16.56,1080,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:20:16.56,0:20:19.40,1080,,0,0,0,,Сізді әрқашан біреу күтеді
Dialogue: 0,0:20:19.40,0:20:20.74,1080,,0,0,0,,Рин-чан да
Dialogue: 0,0:20:21.36,0:20:24.96,1080,,0,0,0,,Онса-чан, Сей-чан және Райму-сенпай
Dialogue: 0,0:20:24.96,0:20:26.76,1080,,0,0,0,,Менің әпкем Юме де.
Dialogue: 0,0:20:28.18,0:20:30.50,1080,,0,0,0,,Барлығы мені күтіп отырды.
Dialogue: 0,0:20:30.50,0:20:31.34,1080,,0,0,0,,Сонымен
Dialogue: 0,0:20:31.34,0:20:35.14,1080,,0,0,0,,Араларыңда біреу мотоцикл мінгісі келсе ше?
Dialogue: 0,0:20:35.14,0:20:38.44,1080,,0,0,0,,Біз сізді келесі жолы күтеміз.
Dialogue: 0,0:20:42.08,0:20:43.64,1080,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:20:45.74,0:20:47.32,1080,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:20:48.08,0:20:50.88,1080,,0,0,0,,Мүмкін мен тым алыс кеткен шығармын.
Dialogue: 0,0:20:54.30,0:20:57.44,1080,,0,0,0,,Сондықтан мен мотоцикл клубына қосылдым.
Dialogue: 0,0:21:01.22,0:21:02.60,1080,,0,0,0,,Чисамэ-чан
Dialogue: 0,0:21:03.36,0:21:06.42,1080,,0,0,0,,Мотоцикл күлетін көлік емес.
Dialogue: 0,0:21:07.86,0:21:11.36,1080,,0,0,0,,Қараңдаршы, сен мотоциклді осылай айдайсың.
Dialogue: 0,0:21:12.02,0:21:13.26,1080,,0,0,0,,Ұстау
Dialogue: 0,0:21:13.26,0:21:16.66,1080,,0,0,0,,Және S бұрышында жылдам бұрылу
Dialogue: 0,0:21:16.66,0:21:18.24,1080,,0,0,0,,Қорытынды бұрыш
Dialogue: 0,0:21:18.24,0:21:20.48,1080,,0,0,0,,Доңғалақтарды шегіне дейін итеру
Dialogue: 0,0:21:20.48,0:21:22.44,1080,,0,0,0,,Home Straight
Dialogue: 0,0:21:22.44,0:21:25.64,1080,,0,0,0,,Желге төзімділікті барынша азайту үшін жатыңыз
Dialogue: 0,0:21:25.64,0:21:27.72,1080,,0,0,0,,Соңында
Dialogue: 0,0:21:28.26,0:21:30.68,1080,,0,0,0,,Мақсат
Dialogue: 0,0:21:30.90,0:21:34.23,1080,,0,0,0,,Бес сезім мүшелерін барынша пайдаланатын спорт түрі
Dialogue: 0,0:21:34.23,0:21:36.50,1080,,0,0,0,,Бұл велосипед
Dialogue: 0,0:21:38.76,0:21:42.56,1080,,0,0,0,,Қандай болса да, алдыңғы биден біртүрлі.
Dialogue: 0,0:21:46.68,0:21:50.60,1080,,0,0,0,,Енді мен сіздің сезіміңізді білемін, тұтқаны маған қайтара аласыз ба?
Dialogue: 0,0:21:53.96,0:21:55.12,1080,,0,0,0,,Ұстау
Dialogue: 0,0:21:56.62,0:22:02.62,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
