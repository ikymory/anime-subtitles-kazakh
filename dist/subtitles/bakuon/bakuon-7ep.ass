Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:10.00,0:02:15.00,,,0,0,0,,Бұл субтитр ✿Hanago және Chinatsu FanSubs✿-пен бірлесіп берілген.
Dialogue: 0,0:00:05.84,0:00:08.35,1080,,0,0,0,,Сен мұны жұрттың көзінше киесің бе?
Dialogue: 0,0:00:08.64,0:00:11.75,1080,,0,0,0,,Баршаңызға, жарыс костюмі сізге жарасады.
Dialogue: 0,0:00:11.75,0:00:14.08,1080,,0,0,0,,Бұл шынымен пролетариатқа ұқсайды.
Dialogue: 0,0:00:14.08,0:00:17.44,1080,,0,0,0,,Онса-чан, пролетариат дегеніміз не?
Dialogue: 0,0:00:17.44,0:00:19.20,1080,,0,0,0,,Дұрыс, Ханане.
Dialogue: 0,0:00:19.20,0:00:22.00,1080,,0,0,0,,Өнер – өнер.
Dialogue: 0,0:00:22.00,0:00:24.34,1080,,0,0,0,,Кәсіби көрінеді
Dialogue: 0,0:01:54.89,0:01:56.70,1080,,0,0,0,,Жердің жартысы
Dialogue: 0,0:01:56.70,0:01:59.60,1080,,0,0,0,,Гимназияның алдыңғы жағынан тікелей клуб бөлмесінің алдыңғы жағына дейін
Dialogue: 0,0:01:59.60,0:02:01.89,1080,,0,0,0,,Велосипед тұрағынан мектеп ғимаратына дейін
Dialogue: 0,0:02:01.89,0:02:04.98,1080,,0,0,0,,Ауладан өтіп, жерге оралу
Dialogue: 0,0:02:04.98,0:02:07.12,1080,,0,0,0,,Мұны 10 рет орындаңыз.
Dialogue: 0,0:02:07.12,0:02:09.98,1080,,0,0,0,,Ал міне, біз баспалдақтардың үстіне тақтайшаларды төсейміз.
Dialogue: 0,0:02:09.98,0:02:11.56,1080,,0,0,0,,Бұл мен оны еңіске айналдырған жерім.
Dialogue: 0,0:02:11.56,0:02:14.48,1080,,0,0,0,,Екі орын бар, бірі жоғары, бірі төмен түседі.
Dialogue: 0,0:02:15.46,0:02:19.28,1080,,0,0,0,,Бұл жерде бәріңіз де стильді таңдайсыз деп үміттенемін.
Dialogue: 0,0:02:19.28,0:02:20.35,1080,,0,0,0,,Секіру
Dialogue: 0,0:02:20.35,0:02:23.38,1080,,0,0,0,,Менде үлкен мотоцикл лицензиясы жоқ, сондықтан бұл мүмкін емес.
Dialogue: 0,0:02:23.38,0:02:25.64,1080,,0,0,0,,Үлкені болса да секірмейді.
Dialogue: 0,0:02:26.10,0:02:27.40,1080,,0,0,0,,Бұл не?
Dialogue: 0,0:02:27.40,0:02:28.42,1080,,0,0,0,,Иә
Dialogue: 0,0:02:28.42,0:02:29.66,1080,,0,0,0,,Өтіп бара жатқанда
Dialogue: 0,0:02:29.66,0:02:33.04,1080,,0,0,0,,Бұл қандай да бір себептермен велосипедтің қозғалтқышын суытатын тақта.
Dialogue: 0,0:02:33.04,0:02:36.89,1080,,0,0,0,,Minowa тобының технологияларын біріктіру арқылы әзірленген.
Dialogue: 0,0:02:36.89,0:02:39.84,1080,,0,0,0,,Ақшаны ысырап ету!
Dialogue: 0,0:02:39.84,0:02:42.39,1080,,0,0,0,,Бұл бизнес.
Dialogue: 0,0:02:43.12,0:02:45.52,1080,,0,0,0,,Мені сатып алыңыз
Dialogue: 0,0:02:45.52,0:02:48.58,1080,,0,0,0,,Мені сатып ал
Dialogue: 0,0:02:48.58,0:02:51.11,1080,,0,0,0,,Мені сатып ал
Dialogue: 0,0:02:51.11,0:02:54.86,1080,,0,0,0,,Мені сатып ал
Dialogue: 0,0:02:52.68,0:02:54.78,1080,,0,0,0,,Бұл жиіркенішті айқай.
Dialogue: 0,0:02:55.00,0:02:57.01,1080,,0,0,0,,Бірақ ең жақсы оқиға
Dialogue: 0,0:02:57.01,0:03:00.10,1080,,0,0,0,,Мотоцикл клубында кімге бәс тігу керектігін бәрі білмейді
Dialogue: 0,0:03:00.10,0:03:02.26,1080,,0,0,0,,Қолдау көрсететін ойыншылар болмаса
Dialogue: 0,0:03:02.26,0:03:04.70,1080,,0,0,0,,Мені ешқандай нәсіл қызықтырмайды.
Dialogue: 0,0:03:05.47,0:03:07.88,1080,,0,0,0,,Біріншіден, бұл менің сыныбым.
Dialogue: 0,0:03:14.46,0:03:17.18,1080,,0,0,0,,Мотоцикл клубында дерби өтіп жатыр, менің бәс тігуімді қалайсыз ба?
Dialogue: 0,0:03:17.16,0:03:17.91,1080,,0,0,0,,Иә
Dialogue: 0,0:03:19.53,0:03:21.69,1080,,0,0,0,,Бір адамға бір ғана көлік таңдай аласыз.
Dialogue: 0,0:03:21.69,0:03:24.78,1080,,0,0,0,,Бірақ мен мотоцикл туралы ештеңе түсінбеймін.
Dialogue: 0,0:03:24.78,0:03:26.83,1080,,0,0,0,,Қанша білмеймін десең де
Dialogue: 0,0:03:26.83,0:03:30.11,1080,,0,0,0,,Сіз төрт негізгі отандық өндірушілермен және Катанамен таныс болуыңыз керек.
Dialogue: 0,0:03:30.11,0:03:32.92,1080,,0,0,0,,Төрт негізгі мотоцикл өндірушілері
Dialogue: 0,0:03:33.35,0:03:36.32,1080,,0,0,0,,...
Dialogue: 0,0:03:36.32,0:03:39.50,1080,,0,0,0,,Гарли-Дэвидсон мырзадан кейін
Dialogue: 0,0:03:39.50,0:03:40.70,1080,,0,0,0,,Неліктен?
Dialogue: 0,0:03:40.70,0:03:42.60,1080,,0,0,0,,S әрпінен басталатын өндірушілер
Dialogue: 0,0:03:42.60,0:03:45.61,1080,,0,0,0,,Жарайды, бұл Скутер.
Dialogue: 0,0:03:45.61,0:03:50.06,1080,,0,0,0,,Скутердің велосипеді жақсы жүреді, солай емес пе?
Dialogue: 0,0:03:50.06,0:03:52.34,1080,,0,0,0,,Скутер өндірушінің атауы емес
Dialogue: 0,0:03:52.34,0:03:54.28,1080,,0,0,0,,Сузуки, Сузуки
Dialogue: 0,0:03:55.08,0:03:56.82,1080,,0,0,0,,Әзіл болуы керек
Dialogue: 0,0:03:56.82,0:03:59.32,1080,,0,0,0,,Сузуки мотоциклдер жасайды.
Dialogue: 0,0:03:59.32,0:04:01.51,1080,,0,0,0,,Сіз мұны әдейі айтып тұрсыз ба?
Dialogue: 0,0:04:01.51,0:04:05.12,1080,,0,0,0,,Енді қатысатын мотоциклдермен таныстырып өтейін.
Dialogue: 0,0:04:05.12,0:04:09.67,1080,,0,0,0,,Біріншіден, Honda CB400 Super Four Сакура Hane
Dialogue: 0,0:04:09.67,0:04:13.88,1080,,0,0,0,,18 бұрылыс сигналдары 10 артқы көрініс айнасы 8 дыбыс өшіргіш
Dialogue: 0,0:04:13.88,0:04:15.44,1080,,0,0,0,,Қауіпсіз көлік жүргізу
Dialogue: 0,0:04:16.20,0:04:21.00,1080,,0,0,0,,Келесі Yamaha TZR250 Onsa Amano
Dialogue: 0,0:04:21.00,0:04:23.60,1080,,0,0,0,,20 жыл баптаудың арқасында
Dialogue: 0,0:04:23.60,0:04:26.16,1080,,0,0,0,,3MA 3XV-ден жылдамырақ
Dialogue: 0,0:04:26.61,0:04:29.83,1080,,0,0,0,,Сузуки Катана 400 Рин Сузуноги
Dialogue: 0,0:04:29.83,0:04:32.84,1080,,0,0,0,,Тіпті қалыпты болып көрінсе де, бұл Gun Spark Tune
Dialogue: 0,0:04:32.84,0:04:35.21,1080,,0,0,0,,1200 сезіну
Dialogue: 0,0:04:35.79,0:04:40.52,1080,,0,0,0,,Kawasaki Scooter Epsilon 250 Raimu Senpai құрылғысынан
Dialogue: 0,0:04:40.52,0:04:42.02,1080,,0,0,0,,Мүгедек ретінде
Dialogue: 0,0:04:42.02,0:04:43.98,1080,,0,0,0,,Кәдімгі Ниндзядан ауысу
Dialogue: 0,0:04:43.98,0:04:46.70,1080,,0,0,0,,Nikichi Motors ұсынған
Dialogue: 0,0:04:46.70,0:04:49.68,1080,,0,0,0,,Мүгедектік осыны білдіреді.
Dialogue: 0,0:04:49.68,0:04:51.65,1080,,0,0,0,,Мен осы Хонданы таңдаймын
Dialogue: 0,0:04:51.65,0:04:52.41,1080,,0,0,0,,Алдымен саусақтарыңды найза пішініне келтір.
Dialogue: 0,0:04:52.41,0:04:54.68,1080,,0,0,0,,Мен қатты жүгіремін
Dialogue: 0,0:04:54.68,0:04:58.26,1080,,0,0,0,,Бар болғаны 8 бөліктен тұратын дыбыс өшіргіштің мағынасыздығы
Dialogue: 0,0:04:58.26,0:05:00.60,1080,,0,0,0,,Қауіпсіздікті бірінші орынға қоятын айна
Dialogue: 0,0:05:00.60,0:05:03.90,1080,,0,0,0,,Бұл қазіргі қоғамның сатирасы, мен оны интеллектуалды деп санаймын.
Dialogue: 0,0:05:04.70,0:05:06.14,1080,,0,0,0,,Сатира
Dialogue: 0,0:05:06.14,0:05:08.35,1080,,0,0,0,,Сондықтан мен Yamaha-мен барамын деп ойлаймын.
Dialogue: 0,0:05:08.35,0:05:09.88,1080,,0,0,0,,О, маған
Dialogue: 0,0:05:10.48,0:05:11.98,1080,,0,0,0,,Мен Кавасакимін
Dialogue: 0,0:05:11.98,0:05:12.80,1080,,0,0,0,,Honda
Dialogue: 0,0:05:12.80,0:05:13.82,1080,,0,0,0,,Yamaha
Dialogue: 0,0:05:13.82,0:05:15.83,1080,,0,0,0,,Маған бәрібір
Dialogue: 0,0:05:15.83,0:05:19.66,1080,,0,0,0,,Сузукидің кереметтерін түсіну соншалықты оңай ма?
Dialogue: 0,0:05:19.66,0:05:22.53,1080,,0,0,0,,Мен саған бәс тігемін
Dialogue: 0,0:05:23.51,0:05:28.00,1080,,0,0,0,,Сіз Сузукидің мотоцикл жасағанын білмедіңіз.
Dialogue: 0,0:05:28.00,0:05:30.14,1080,,0,0,0,,Иә, бірақ
Dialogue: 0,0:05:30.14,0:05:31.64,1080,,0,0,0,,Мен білемін
Dialogue: 0,0:05:33.81,0:05:35.98,1080,,0,0,0,,Ханымдар мен мырзалар
Dialogue: 0,0:05:35.98,0:05:38.31,1080,,0,0,0,,және әке анасы
Dialogue: 0,0:05:38.92,0:05:41.98,1080,,0,0,0,,Бүгінгі басты оқиға да келіп жетті.
Dialogue: 0,0:05:41.98,0:05:47.16,1080,,0,0,0,,Өндірушілермен бәсекелесетін орта мектеп қыздары арасындағы тұңғыш мотоцикл дербиі
Dialogue: 0,0:05:47.16,0:05:48.48,1080,,0,0,0,,Модератор
Dialogue: 0,0:05:48.48,0:05:53.04,1080,,0,0,0,,Хиджирян патшайым жіберген зұлым Беде корпусы
Dialogue: 0,0:05:53.97,0:05:56.66,1080,,0,0,0,,Осы сәтте асыл мектеп
Dialogue: 0,0:05:56.66,0:05:59.66,1080,,0,0,0,,Толтырушы контурға айналдырылды
Dialogue: 0,0:05:59.66,0:06:02.25,1080,,0,0,0,,Темір тұлпар мінген дәрмен...
Dialogue: 0,0:06:02.25,0:06:05.90,1080,,0,0,0,,Жарысты көруге қанша адам келеді?
Dialogue: 0,0:06:05.90,0:06:07.09,1080,,0,0,0,,100 адам
Dialogue: 0,0:06:07.09,0:06:08.37,1080,,0,0,0,,Бұл көп
Dialogue: 0,0:06:08.37,0:06:10.14,1080,,0,0,0,,50 адам болуы мүмкін.
Dialogue: 0,0:06:10.14,0:06:12.22,1080,,0,0,0,,Мені көруге ешкім келмеді.
Dialogue: 0,0:06:12.22,0:06:14.94,1080,,0,0,0,,Бүгін түнде мен саған қызмет етемін.
Dialogue: 0,0:06:14.94,0:06:19.45,1080,,0,0,0,,Пролетариаттың таза және сүйкімді жүйріктері.
Dialogue: 0,0:06:35.58,0:06:38.73,1080,,0,0,0,,Қолыңнан келгенін істе, апа.
Dialogue: 0,0:06:38.73,0:06:41.15,1080,,0,0,0,,Бұл велосипед жеңімпаз.
Dialogue: 0,0:06:42.91,0:06:46.10,1080,,0,0,0,,Әй, мұндай жағдай болды ма?
Dialogue: 0,0:06:46.10,0:06:49.18,1080,,0,0,0,,Адамдардың мені велосипедпен жүруі үшін қолдағаны таңқаларлық.
Dialogue: 0,0:06:49.18,0:06:52.90,1080,,0,0,0,,Сіз апатқа байланысты зейнетке шыға алмайсыз
Dialogue: 0,0:06:52.90,0:06:56.78,1080,,0,0,0,,Менің жеңілуге де шамасы келмейді.
Dialogue: 0,0:06:56.78,0:06:59.80,1080,,0,0,0,,Өндірушінің атын да білмейтін балалар
Dialogue: 0,0:06:59.80,0:07:02.81,1080,,0,0,0,,Ақша жұмсалған бойда қолдау көрсету
Dialogue: 0,0:07:02.81,0:07:04.78,1080,,0,0,0,,Қараңыз
Dialogue: 0,0:07:04.78,0:07:08.40,1080,,0,0,0,,Мен сізді Сузукиден басқа нәрсеге бәс тіккеніңізге өкінемін.
Dialogue: 0,0:07:08.47,0:07:10.20,1080,,0,0,0,,Үлкен әпке
Dialogue: 0,0:07:10.20,0:07:12.16,1080,,0,0,0,,Юме
Dialogue: 0,0:07:13.56,0:07:19.32,1080,,0,0,0,,Ойланып қарасам, Раймусенпайдың қолдайтын достары бар ма екен?
Dialogue: 0,0:07:31.67,0:07:33.16,1080,,0,0,0,,мен зұлымдарды әділ сотқа тартуға тырысар ма едім?
Dialogue: 0,0:07:35.26,0:07:36.46,1080,,0,0,0,,Бұл
Dialogue: 0,0:07:36.46,0:07:39.46,1080,,0,0,0,,Патшаны генералға итермелеу
Dialogue: 0,0:07:39.46,0:07:41.28,1080,,0,0,0,,Сіз не қарап тұрсыз?
Dialogue: 0,0:07:41.28,0:07:42.78,1080,,0,0,0,,Маймылдың бетін тесу?
Dialogue: 0,0:07:43.84,0:07:46.76,1080,,0,0,0,,Бұл жапондық орта мектептегі қыздарға арналған жарыс.
Dialogue: 0,0:07:49.98,0:07:52.19,1080,,0,0,0,,КБ Катанадан Бигскуге дейін
Dialogue: 0,0:07:52.19,0:07:55.38,1080,,0,0,0,,Бұл 2 соққылы TZR үшін керемет жеңіс емес пе?
Dialogue: 0,0:07:55.38,0:07:56.88,1080,,0,0,0,,Әдетте
Dialogue: 0,0:07:57.41,0:08:00.16,1080,,0,0,0,,Бірақ кім жеңеді
Dialogue: 0,0:08:02.33,0:08:03.98,1080,,0,0,0,,Бұл скутер
Dialogue: 0,0:08:04.59,0:08:06.02,1080,,0,0,0,,Шынайы ма?
Dialogue: 0,0:08:06.16,0:08:08.61,1080,,0,0,0,,Райму-сенпайды түсініңізші.
Dialogue: 0,0:08:09.32,0:08:14.36,1080,,0,0,0,,Біз оны ешқашан жеңген емеспіз.
Dialogue: 0,0:08:19.92,0:08:23.33,1080,,0,0,0,,Ханымдар мен мырзалар, бәс тігуді ұмыттыңыз ба?
Dialogue: 0,0:08:23.33,0:08:25.84,1080,,0,0,0,,Мерзім аяқталуға жақын қалды.
Dialogue: 0,0:08:28.79,0:08:31.02,1080,,0,0,0,,Сіз қалай ойлайсыз, Саруяма мырза?
Dialogue: 0,0:08:31.02,0:08:32.66,1080,,0,0,0,,Негізгі
Dialogue: 0,0:08:32.66,0:08:34.42,1080,,0,0,0,,Бұл үлкен жетістік.
Dialogue: 0,0:08:34.42,0:08:37.78,1080,,0,0,0,,Студенттер мен келушілердің көпшілігі бәс тігуде.
Dialogue: 0,0:08:37.78,0:08:39.20,1080,,0,0,0,,Мүмкіндіктер
Dialogue: 0,0:08:41.00,0:08:42.96,1080,,0,0,0,,Ең танымалы - Honda
Dialogue: 0,0:08:42.96,0:08:45.11,1080,,0,0,0,,Тек Кавасаки танымал емес.
Dialogue: 0,0:08:47.51,0:08:49.13,1080,,0,0,0,,11 рет
Dialogue: 0,0:08:49.13,0:08:50.86,1080,,0,0,0,,Күтілгендей
Dialogue: 0,0:08:51.34,0:08:53.20,1080,,0,0,0,,Скутердің мүгедектігінен басқа
Dialogue: 0,0:08:53.20,0:08:57.56,1080,,0,0,0,,Мектепте ешкімді танымайтын Райму-сенпайға бәс тіккендер аз.
Dialogue: 0,0:08:58.52,0:09:00.94,1080,,0,0,0,,Мұғалімдер де қатысады.
Dialogue: 0,0:09:00.94,0:09:02.95,1080,,0,0,0,,Директор туралы не деуге болады?
Dialogue: 0,0:09:05.88,0:09:09.15,1080,,0,0,0,,Әмиянымнан ақша түсті.
Dialogue: 0,0:09:09.70,0:09:11.57,1080,,0,0,0,,Кімге бәс тігуім керек?
Dialogue: 0,0:09:11.57,0:09:14.30,1080,,0,0,0,,Көзіңізді жұмып, кездейсоқ таңдау.
Dialogue: 0,0:09:14.30,0:09:17.90,1080,,0,0,0,,Е, мен ең танымал Кавасакиді таңдадым.
Dialogue: 0,0:09:17.90,0:09:20.30,1080,,0,0,0,,Мен ата-анамның зейнетақысын қарызға алдым.
Dialogue: 0,0:09:20.30,0:09:21.78,1080,,0,0,0,,Үйленеміз деп ойлағаныңыз үшін десеңіз
Dialogue: 0,0:09:21.78,0:09:23.38,1080,,0,0,0,,Мен оны шығарып алдым.
Dialogue: 0,0:09:26.71,0:09:28.82,1080,,0,0,0,,Кавасаки қазір ең танымал
Dialogue: 0,0:09:28.82,0:09:30.54,1080,,0,0,0,,1,1 есе?
Dialogue: 0,0:09:31.37,0:09:34.27,1080,,0,0,0,,Енді уақыт бітті.
Dialogue: 0,0:09:34.27,0:09:36.73,1080,,0,0,0,,Әр машинаның қозғалтқыштары жанып тұрады.
Dialogue: 0,0:09:40.94,0:09:45.44,1080,,0,0,0,,Кім мектепті 10 айналып өтіп, ең жылдам атағын алады?
Dialogue: 0,0:09:45.44,0:09:48.14,1080,,0,0,0,,Енді бізде жауап бар.
Dialogue: 0,0:10:19.50,0:10:21.12,1080,,0,0,0,,Сен әлі күнге дейін қылмыскерлердің өлтіріліп жатқанын Цукиге айтпағансың ба?
Dialogue: 0,0:10:21.48,0:10:23.18,1080,,0,0,0,,Неліктен?
Dialogue: 0,0:10:38.99,0:10:42.70,1080,,0,0,0,,Раимудың Кавасаки Эпсилон апаты
Dialogue: 0,0:10:42.70,0:10:47.28,1080,,0,0,0,,Төбедегі әйелдер арасындағы велодерби оқиғаға толы басталды.
Dialogue: 0,0:10:49.70,0:10:52.18,1080,,0,0,0,,Райму-сенпай, амансың ба?
Dialogue: 0,0:10:52.18,0:10:54.82,1080,,0,0,0,,Мен уайымдап тұрмын, бірақ мен ештеңе істей алмаймын.
Dialogue: 0,0:10:54.82,0:10:57.67,1080,,0,0,0,,Біз жарысқа назар аудардық.
Dialogue: 0,0:10:57.67,0:11:00.71,1080,,0,0,0,,Сузуногидің Сузуки Катана көш басында
Dialogue: 0,0:11:00.71,0:11:03.40,1080,,0,0,0,,Үш машина бірінші бұрышқа секіреді
Dialogue: 0,0:11:03.78,0:11:06.01,1080,,0,0,0,,Құлап қалудан қорқасыз ба?
Dialogue: 0,0:11:06.01,0:11:08.96,1080,,0,0,0,,Бұрыштарда барлығы өте баяулайды
Dialogue: 0,0:11:08.96,0:11:11.56,1080,,0,0,0,,Hanon Honda Sufour туралы
Dialogue: 0,0:11:11.56,0:11:14.02,1080,,0,0,0,,Жыпылықтауыштарды қосу арқылы қосу
Dialogue: 0,0:11:14.37,0:11:17.90,1080,,0,0,0,,Содан кейін көрінген нәрсе жоғары қарай еңіс болды.
Dialogue: 0,0:11:17.90,0:11:20.32,1080,,0,0,0,,Мұнда тамаша секіру
Dialogue: 0,0:11:20.32,0:11:22.88,1080,,0,0,0,,Аманоның Yamaha TZR?
Dialogue: 0,0:11:22.89,0:11:25.56,1080,,0,0,0,,Сузуногидің Сузуки Катанасы?
Dialogue: 0,0:11:26.58,0:11:29.62,1080,,0,0,0,,Өйткені, жоғары сынып оқушылары үшін қауіпсіздік бірінші орында.
Dialogue: 0,0:11:33.19,0:11:35.59,1080,,0,0,0,,Жерден мектеп ғимаратының артына дейін жарысу
Dialogue: 0,0:11:35.59,0:11:37.84,1080,,0,0,0,,Ұзын түзуді енгізіңіз
Dialogue: 0,0:11:38.65,0:11:40.05,1080,,0,0,0,,Уууууууу!!
Dialogue: 0,0:11:40.62,0:11:42.00,1080,,0,0,0,,Уууууууу!!
Dialogue: 0,0:11:47.15,0:11:51.04,1080,,0,0,0,,Сузуноги қашып кетті.
Dialogue: 0,0:11:51.04,0:11:52.56,1080,,0,0,0,,Бір жолақ
Dialogue: 0,0:11:58.53,0:12:00.64,1080,,0,0,0,,Рин катанасына өте қолайлы
Dialogue: 0,0:12:00.64,0:12:03.03,1080,,0,0,0,,Сіз оны ең соңында ғана шығара аласыз.
Dialogue: 0,0:12:08.66,0:12:11.40,1080,,0,0,0,,Үш машина жерге оралды
Dialogue: 0,0:12:13.93,0:12:15.91,1080,,0,0,0,,Баяу және қауіпсіз түсу...
Dialogue: 0,0:12:15.91,0:12:19.28,1080,,0,0,0,,Ал еңістен кейін бонус болады
Dialogue: 0,0:12:20.03,0:12:22.60,1080,,0,0,0,,Minowa Group әзірлеген
Dialogue: 0,0:12:22.60,0:12:26.60,1080,,0,0,0,,Оның үстінен өткенде велосипедтің қозғалтқышын салқындатып жіберетін тақтайша бар.
Dialogue: 0,0:12:26.60,0:12:28.62,1080,,0,0,0,,Күту
Dialogue: 0,0:12:31.16,0:12:34.39,1080,,0,0,0,,Сіз осындай түсініксіз нәрсеге еріп кете аласыз ба?
Dialogue: 0,0:12:40.64,0:12:42.20,1080,,0,0,0,,9 айналым қалды
Dialogue: 0,0:12:45.00,0:12:48.28,1080,,0,0,0,,Жылдамдық мен ойлағаннан да баяу.
Dialogue: 0,0:12:48.28,0:12:50.60,1080,,0,0,0,,Қаншалықты елестеттіңіз?
Dialogue: 0,0:12:50.60,0:12:55.03,1080,,0,0,0,,Мені кішкентай кезімде әке-шешем апарған F1 жарысы болса керек.
Dialogue: 0,0:12:55.98,0:12:59.70,1080,,0,0,0,,Бірақ оның баяу екенін көру оңайырақ.
Dialogue: 0,0:13:02.24,0:13:05.45,1080,,0,0,0,,Қалай болғанда да, Онсаның мотоциклі
Dialogue: 0,0:13:05.45,0:13:07.70,1080,,0,0,0,,Ол міндетті түрде сынған
Dialogue: 0,0:13:08.26,0:13:11.16,1080,,0,0,0,,Бұл түтін
Dialogue: 0,0:13:12.06,0:13:13.95,1080,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:14.78,0:13:19.44,1080,,0,0,0,,Мен жетекшілік етсем, бәрі шешіледі.
Dialogue: 0,0:13:29.52,0:13:32.20,1080,,0,0,0,,Қозғалтқыш дыбысы өзгерді ме?
Dialogue: 0,0:13:49.54,0:13:50.76,1080,,0,0,0,,Неліктен?
Dialogue: 0,0:14:08.64,0:14:12.12,1080,,0,0,0,,Құлап кеткен Райму ойыншысы әлі сол жерде.
Dialogue: 0,0:14:12.12,0:14:16.00,1080,,0,0,0,,Сенпай, сен нені қалжыңдап тұрсың?
Dialogue: 0,0:14:16.00,0:14:17.96,1080,,0,0,0,,Тұр!
Dialogue: 0,0:14:17.96,0:14:19.34,1080,,0,0,0,,Аға
Dialogue: 0,0:14:33.45,0:14:34.60,1080,,0,0,0,,Қатерлі ісік...
Dialogue: 0,0:14:36.47,0:14:39.14,1080,,0,0,0,,Тек сол сәтте, бір сәтке ғана…
Dialogue: 0,0:14:43.13,0:14:44.84,1080,,0,0,0,,Сен шынымен де тамаша ФБР агенті болдың.
Dialogue: 0,0:14:44.85,0:14:48.08,1080,,0,0,0,,Райму орнынан тұрды.
Dialogue: 0,0:15:03.76,0:15:05.72,1080,,0,0,0,,Не істеп жатырсың?
Dialogue: 0,0:15:06.09,0:15:11.70,1080,,0,0,0,,Райму-сенпай біздің мотоцикл міну тәсілінен түбегейлі ерекшеленеді.
Dialogue: 0,0:15:11.70,0:15:13.47,1080,,0,0,0,,Оның алдында
Dialogue: 0,0:15:13.47,0:15:16.60,1080,,0,0,0,,Әрбір велосипед өз өмірін құрбан етеді
Dialogue: 0,0:15:16.60,0:15:21.70,1080,,0,0,0,,Оның жеңуге себебі бар сияқты.
Dialogue: 0,0:15:25.44,0:15:27.04,1080,,0,0,0,,Біздің күштеріміздің бұйрығы бойынша, сені ұрлап әкетуге келдім
Dialogue: 0,0:15:27.04,0:15:28.22,1080,,0,0,0,,Қайта тірілу
Dialogue: 0,0:15:28.22,0:15:31.26,1080,,0,0,0,,Райму ойыншысы керемет қайта тірілу
Dialogue: 0,0:15:31.26,0:15:33.62,1080,,0,0,0,,Сенпай Сенпай
Dialogue: 0,0:15:33.62,0:15:34.70,1080,,0,0,0,,Тек сол сәтте, бір сәтке ғана…
Dialogue: 0,0:15:34.70,0:15:39.56,1080,,0,0,0,,Ал мен ата-анама өтірік айтып, мәжбүрлеп берген 3 миллионымды қайтарып ал.
Dialogue: 0,0:15:39.56,0:15:42.38,1080,,0,0,0,,Еңіспен секіру
Dialogue: 0,0:15:52.91,0:15:53.90,1080,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:15:53.90,0:15:55.30,1080,,0,0,0,,жылдам
Dialogue: 0,0:15:55.30,0:15:58.99,1080,,0,0,0,,Raimu ойыншысы лопуханы керемет жылдамдықпен алып тастайды
Dialogue: 0,0:15:58.99,0:16:01.63,1080,,0,0,0,,Бұл 1 Mach туралы ма?
Dialogue: 0,0:16:01.63,0:16:03.23,1080,,0,0,0,,Мүмкін сәл кешіккен шығар
Dialogue: 0,0:16:03.23,0:16:06.12,1080,,0,0,0,,Әзірге оны орнатудың дұрыс уақыты емес.
Dialogue: 0,0:16:06.12,0:16:08.82,1080,,0,0,0,,Бірақ енді мен байсалды болуым керек.
Dialogue: 0,0:16:11.23,0:16:14.10,1080,,0,0,0,,Амано жоғарғы Сузуногиге жақындайды
Dialogue: 0,0:16:14.10,0:16:15.54,1080,,0,0,0,,Мен сені қуып барайын ба?
Dialogue: 0,0:16:15.54,0:16:16.95,1080,,0,0,0,,Ақымақ
Dialogue: 0,0:16:16.95,0:16:20.07,1080,,0,0,0,,Неліктен мен Denormal's Katana 400-ді жеңе алмаймын?
Dialogue: 0,0:16:20.07,0:16:22.52,1080,,0,0,0,,Бұл катана қалыпты емес.
Dialogue: 0,0:16:22.52,0:16:24.62,1080,,0,0,0,,Мылтық ұшқыны және ыстық плазмасы бар
Dialogue: 0,0:16:24.62,0:16:27.69,1080,,0,0,0,,Түпнұсқа өнімділігін көрсету үшін бапталған
Dialogue: 0,0:16:27.69,0:16:29.93,1080,,0,0,0,,Рин жарасы жасырын күй
Dialogue: 0,0:16:30.23,0:16:32.02,1080,,0,0,0,,Мен сенемін
Dialogue: 0,0:16:32.02,0:16:33.92,1080,,0,0,0,,Катананың күші 400
Dialogue: 0,0:16:33.92,0:16:35.76,1080,,0,0,0,,Мен таңдаған велосипед
Dialogue: 0,0:16:35.76,0:16:38.89,1080,,0,0,0,,Мен таңдаған өндіруші ең жақсысы.
Dialogue: 0,0:16:38.89,0:16:42.00,1080,,0,0,0,,Ол әлемдегі ең жақсы велосипедті таңдағанын айтты.
Dialogue: 0,0:16:42.00,0:16:43.70,1080,,0,0,0,,Бұл жарыс
Dialogue: 0,0:16:43.70,0:16:46.82,1080,,0,0,0,,Бұл дәлел.
Dialogue: 0,0:16:51.32,0:16:53.10,1080,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:16:53.10,0:16:56.36,1080,,0,0,0,,Осындай салмақты ойлармен жарысатындар бар ма?
Dialogue: 0,0:16:58.94,0:17:02.17,1080,,0,0,0,,Бірақ бұл керемет емес пе?
Dialogue: 0,0:17:02.96,0:17:05.00,1080,,0,0,0,,Мұны айту қиын.
Dialogue: 0,0:17:05.00,0:17:08.92,1080,,0,0,0,,Бірақ осындай салқын жолдарды айтатын адам
Dialogue: 0,0:17:08.92,0:17:12.12,1080,,0,0,0,,Бұл Рин емес, мен болуым керек.
Dialogue: 0,0:17:17.37,0:17:20.06,1080,,0,0,0,,Алғашқы екі көлік қайтып келді.
Dialogue: 0,0:17:21.66,0:17:24.30,1080,,0,0,0,,Ақырында соңғы айналымға кіру
Dialogue: 0,0:17:24.90,0:17:27.30,1080,,0,0,0,,Менің 3 миллионым қайда?
Dialogue: 0,0:17:27.30,0:17:29.20,1080,,0,0,0,,Қап
Dialogue: 0,0:17:32.62,0:17:35.04,1080,,0,0,0,,Бигск осылай айнала ма?
Dialogue: 0,0:17:35.04,0:17:37.52,1080,,0,0,0,,Әдетте оны өртеу керек.
Dialogue: 0,0:17:40.08,0:17:43.07,1080,,0,0,0,,Велосипед тым қатты тырысқан шығар.
Dialogue: 0,0:17:45.62,0:17:49.91,1080,,0,0,0,,Алғашқы екі машина ақыры соңғы еңістен өтті.
Dialogue: 0,0:17:50.82,0:17:52.70,1080,,0,0,0,,Сакура да келді
Dialogue: 0,0:17:52.70,0:17:56.70,1080,,0,0,0,,Бірақ еңіспен жай ғана төмен түссеңіз, қуып жете алмайсыз.
Dialogue: 0,0:18:01.48,0:18:04.38,1080,,0,0,0,,Сакура ойыншысы, сіз шешім қабылдадыңыз ба?
Dialogue: 0,0:18:04.38,0:18:07.38,1080,,0,0,0,,«Менде бұл еңіспен ұшудан басқа амалым жоқ».
Dialogue: 0,0:18:12.56,0:18:13.92,1080,,0,0,0,,Үлкен әпке
Dialogue: 0,0:18:18.53,0:18:19.78,1080,,0,0,0,,Үлкен әпке
Dialogue: 0,0:18:19.78,0:18:22.73,1080,,0,0,0,,Бұл велосипедтің қанаттары бар.
Dialogue: 0,0:18:32.71,0:18:35.62,1080,,0,0,0,,Соңғы минутта сапқа тұрды
Dialogue: 0,0:18:39.38,0:18:40.54,1080,,0,0,0,,Содан кейін
Dialogue: 0,0:18:41.14,0:18:44.36,1080,,0,0,0,,Райму да секіреді
Dialogue: 0,0:18:46.85,0:18:49.14,1080,,0,0,0,,3 адам шығарылды
Dialogue: 0,0:18:49.83,0:18:53.74,1080,,0,0,0,,Әй, оның алдында, неге екені белгісіз, мотор суып кетеді.
Dialogue: 0,0:18:59.32,0:19:02.18,1080,,0,0,0,,Raimu қозғалтқышы жарылған
Dialogue: 0,0:19:02.18,0:19:04.51,1080,,0,0,0,,Үш көлік тағы да шыңға таласады
Dialogue: 0,0:19:05.11,0:19:08.14,1080,,0,0,0,,Алайда Райму құлаған жер де
Dialogue: 0,0:19:08.14,0:19:09.84,1080,,0,0,0,,Мәре сызығында
Dialogue: 0,0:19:12.08,0:19:16.48,1080,,0,0,0,,Сіз жеңіліске шыдай аласыз ба?
Dialogue: 0,0:19:16.48,0:19:20.14,1080,,0,0,0,,Менің катанам жүр
Dialogue: 0,0:19:20.14,0:19:23.93,1080,,0,0,0,,Осы уақытқа дейін жеткен болсам, жеңгім келеді.
Dialogue: 0,0:19:26.85,0:19:29.74,1080,,0,0,0,,Барлық машиналар мақсатқа бір уақытта жетеді
Dialogue: 0,0:19:29.74,0:19:31.66,1080,,0,0,0,,Бір мезгілде
Dialogue: 0,0:19:31.66,0:19:34.40,1080,,0,0,0,,Бір уақытта дерлік
Dialogue: 0,0:19:34.40,0:19:37.64,1080,,0,0,0,,Бірінші орын кім?
Dialogue: 0,0:19:37.64,0:19:39.94,1080,,0,0,0,,Мен бәс тіккен Yamaha жеңді, солай ма?
Dialogue: 0,0:19:39.94,0:19:42.30,1080,,0,0,0,,Жоқ, Honda жылдамырақ болды.
Dialogue: 0,0:19:42.30,0:19:43.46,1080,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:19:43.46,0:19:46.06,1080,,0,0,0,,Сіз менің Кавасакидегі үмітсіз голымды көрдіңіз.
Dialogue: 0,0:19:46.06,0:19:48.00,1080,,0,0,0,,Бірде-бір Сузуки алда болмады.
Dialogue: 0,0:19:48.88,0:19:50.64,1080,,0,0,0,,Кім жеңді...
Dialogue: 0,0:19:51.12,0:19:53.10,1080,,0,0,0,,Honda велосипедтері ең жақсысы
Dialogue: 0,0:19:53.10,0:19:55.22,1080,,0,0,0,,Yamaha велосипедтері ең жақсысы
Dialogue: 0,0:19:55.22,0:19:57.08,1080,,0,0,0,,Suzuki велосипеді жеңді.
Dialogue: 0,0:19:57.08,0:19:58.62,1080,,0,0,0,,Кавасаки велосипедтері ең жақсысы
Dialogue: 0,0:19:57.08,0:19:58.62,1080,,0,0,0,,Біз ұрысып жатырмыз
Dialogue: 0,0:19:58.62,0:20:01.31,1080,,0,0,0,,Сонымен қатар, қай өндірушінің велосипеді жақсы?
Dialogue: 0,0:20:01.31,0:20:02.66,1080,,0,0,0,,Неліктен?
Dialogue: 0,0:20:02.66,0:20:04.96,1080,,0,0,0,,Бұл керемет
Dialogue: 0,0:20:04.96,0:20:07.94,1080,,0,0,0,,Мотоциклге қызықпаған қыздар
Dialogue: 0,0:20:07.94,0:20:09.77,1080,,0,0,0,,Өте қатты...
Dialogue: 0,0:20:09.77,0:20:13.06,1080,,0,0,0,,Ағымдағы жарыстың фотосуреті енді қолжетімді.
Dialogue: 0,0:20:13.06,0:20:14.44,1080,,0,0,0,,Жеңімпаз
Dialogue: 0,0:20:17.40,0:20:20.86,1080,,0,0,0,,Сузуки Катана 400 Рин Сузуноги
Dialogue: 0,0:20:31.70,0:20:33.54,1080,,0,0,0,,Сузуки жеңді
Dialogue: 0,0:20:33.54,0:20:37.08,1080,,0,0,0,,Сузукиді таңдаған балалар жеңді.
Dialogue: 0,0:20:39.96,0:20:41.06,1080,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:20:41.06,0:20:44.80,1080,,0,0,0,,Ең жақсы өндіруші Suzuki таңдауды жалғастырыңыз
Dialogue: 0,0:20:44.80,0:20:46.60,1080,,0,0,0,,Теңіз басын сатып алыңыз
Dialogue: 0,0:20:46.61,0:20:50.49,1080,,0,0,0,,Жарайды, мен әкеме Вагон R сатып ал деп айтамын.
Dialogue: 0,0:20:50.49,0:20:53.53,1080,,0,0,0,,Мен жігітімнің келесі көлігін Свифт жасаймын.
Dialogue: 0,0:20:53.53,0:20:55.59,1080,,0,0,0,,Suzuki тағы не сатады?
Dialogue: 0,0:20:55.59,0:20:57.83,1080,,0,0,0,,Мунео үйі Сузуки үйі?
Dialogue: 0,0:20:59.07,0:21:00.36,1080,,0,0,0,,Велосипедтер туралы не деуге болады?
Dialogue: 0,0:21:01.85,0:21:04.80,1080,,0,0,0,,Менің әпкем жеңіліп қалды
Dialogue: 0,0:21:04.80,0:21:08.99,1080,,0,0,0,,Сіз айтқандай. Сузуки жеңеді...
Dialogue: 0,0:21:10.02,0:21:11.08,1080,,0,0,0,,Бұл
Dialogue: 0,0:21:11.08,0:21:14.10,1080,,0,0,0,,Сіздің болжамыңыз қате болды, солай емес пе?
Dialogue: 0,0:21:14.10,0:21:15.25,1080,,0,0,0,,Бұл
Dialogue: 0,0:21:17.84,0:21:21.11,1080,,0,0,0,,Енді сіз директордың өкілеттігімен бұл жарысты жеңе аласыз.
Dialogue: 0,0:21:21.11,0:21:23.28,1080,,0,0,0,,Құмар ойындарға рұқсат етілмейді
Dialogue: 0,0:21:23.28,0:21:26.44,1080,,0,0,0,,Мен мұны істедім, мен оны алдым.
Dialogue: 0,0:21:26.44,0:21:30.22,1080,,0,0,0,,Бұл көп емес, бірақ мен оны үйлену үшін жинаймын.
Dialogue: 0,0:21:37.51,0:21:41.34,1080,,0,0,0,,Райму-сенпай, мен саған 3 миллион иен қарызмын.
Dialogue: 0,0:21:42.87,0:21:44.88,1080,,0,0,0,,Эй, ол жерде қалай болды?
Dialogue: 0,0:21:44.88,0:21:45.77,1080,,0,0,0,,бойынша
Dialogue: 0,0:21:45.77,0:21:47.03,1080,,0,0,0,,Жарайды, енді іске кірісейік.
Dialogue: 0,0:21:47.03,0:21:49.17,1080,,0,0,0,,Мен ақша айырбастаймын.
Dialogue: 0,0:21:50.43,0:21:53.86,1080,,0,0,0,,Эй, Чиу-чан, сен келесі жылы осында емтихан тапсыратын шығарсың.
Dialogue: 0,0:21:53.86,0:21:56.58,1080,,0,0,0,,Өйткені, сіз мектепке велосипедпен бара аласыз, солай ма?
Dialogue: 0,0:21:56.58,0:21:58.34,1080,,0,0,0,,Мотоцикл дегеніміз не?
Dialogue: 0,0:21:58.34,0:22:00.96,1080,,0,0,0,,Ол қоғамдық жолдарда жүруге арналмаған.
Dialogue: 0,0:23:31.67,0:23:33.74,1080,,0,0,0,,Келесі жолы Бакуон
Dialogue: 0,0:23:33.74,0:23:35.44,1080,,0,0,0,,Қысқы демалыс
Dialogue: 0,0:23:36.94,0:23:42.94,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
