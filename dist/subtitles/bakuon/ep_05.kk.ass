Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.00,0:00:20.00,,,0,0,0,,Бұл субтитр ✿Hanago және Chinatsu FanSubs✿-пен бірлесіп берілген.
Dialogue: 0,0:04:14.60,0:04:18.01,1080,,0,0,0,,Onsa компаниясының Serow 225 метрі оның 140 км/сағ жылдамдыққа жетуі мүмкін екенін айтады, бірақ оның бар болғаны 20 ат күші бар болғандықтан, менің ойымша, ең жоғары жылдамдық шамамен 120-130 км/сағ.
Dialogue: 0,0:04:35.85,0:04:38.42,1080,,0,0,0,,Katana 400 180 км/сағ жылдамдықпен жүре алмайды.
Dialogue: 0,0:05:11.48,0:05:14.43,1080,,0,0,0,,Менің аға Ninja ZX-12R салмағы 300 кг-нан асады.
Dialogue: 0,0:06:13.97,0:06:16.92,1080,,0,0,0,,Жарыс етіктерінің баулары жоқ, сондықтан тек қана қанаттардың дыбысы ғана алдауға болады.
Dialogue: 0,0:19:20.94,0:19:24.27,1080,,0,0,0,,*Дұрыс айтылуы «Дукати»
Dialogue: 0,0:00:44.60,0:00:48.23,1080,,0,0,0,,1...2...3
Dialogue: 0,0:00:48.51,0:00:52.11,1080,,0,0,0,,Лаванда
Dialogue: 0,0:00:53.46,0:00:54.80,1080,,0,0,0,,Саму
Dialogue: 0,0:00:56.07,0:01:00.06,1080,,0,0,0,,Жаз болса да, Хоккайдода таңертең суық.
Dialogue: 0,0:01:00.06,0:01:01.14,1080,,0,0,0,,Жоқ
Dialogue: 0,0:01:01.43,0:01:03.04,1080,,0,0,0,,бір жерде біреу
Dialogue: 0,0:01:03.04,0:01:05.93,1080,,0,0,0,,Керемет суық нәрсе.
Dialogue: 0,0:01:06.48,0:01:08.58,1080,,0,0,0,,Қайырлы таң, бәрі ояу.
Dialogue: 0,0:01:08.83,0:01:11.11,1080,,0,0,0,,Ханане Бұл өте жылдам.
Dialogue: 0,0:01:11.69,0:01:14.31,1080,,0,0,0,,Жоқ, бұл жай ғана гүл бақшасы...
Dialogue: 0,0:01:14.31,0:01:15.67,1080,,0,0,0,,Дәретхана.
Dialogue: 0,0:02:49.71,0:02:51.23,1080,,0,0,0,,Енді тамақ ішеміз бе?
Dialogue: 0,0:02:51.23,0:02:53.35,1080,,0,0,0,,Біз лагерьде жүрсек те, өзімізге тамақ әзірлемейміз.
Dialogue: 0,0:02:53.35,0:02:55.58,1080,,0,0,0,,Дүкендегі тағамдар туралы не деуге болады?
Dialogue: 0,0:02:55.58,0:02:58.09,1080,,0,0,0,,Ал, теңіз балдырлары көп екен
Dialogue: 0,0:02:58.09,0:03:00.54,1080,,0,0,0,,Бұл керемет механизм.
Dialogue: 0,0:03:00.54,0:03:03.50,1080,,0,0,0,,Мен де бүгін Seicomart-тан сатып алдым.
Dialogue: 0,0:03:03.50,0:03:08.54,1080,,0,0,0,,«Батысқа саяхат» фильміндегі Сон Гоку сияқты Будданың алақанынан қашып құтыла алмады.
Dialogue: 0,0:03:08.54,0:03:12.33,1080,,0,0,0,,Сіз Хоккайдода болсаңыз, Сейкомарттан қашып құтыла алмайсыз.
Dialogue: 0,0:03:13.63,0:03:14.97,1080,,0,0,0,,Осыған ұқсас нәрсе
Dialogue: 0,0:03:14.97,0:03:16.35,1080,,0,0,0,,Соңында ол табысқа жете ме, жетпей ме
Dialogue: 0,0:03:16.35,0:03:18.11,1080,,0,0,0,,Бұл сұмдық.
Dialogue: 0,0:03:18.11,0:03:21.43,1080,,0,0,0,,Онса-чан, бұл біраз ашылады.
Dialogue: 0,0:03:24.42,0:03:28.62,1080,,0,0,0,,Бұл белгілі бір мағынада Хоккайдо тағамдарының көпшілігі.
Dialogue: 0,0:03:28.62,0:03:30.01,1080,,0,0,0,,Енді сіз бұл туралы айтып отырсыз
Dialogue: 0,0:03:30.32,0:03:34.10,1080,,0,0,0,,Хоккайдодағы көліктер жылдам, солай емес пе?
Dialogue: 0,0:03:34.10,0:03:35.57,1080,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:03:35.57,0:03:39.71,1080,,0,0,0,,Әрбір адам материкке қарағанда шамамен 1,25 есе көп төлейді.
Dialogue: 0,0:03:39.71,0:03:44.12,1080,,0,0,0,,Хоккайдо полициясы бізді тікұшақпен қуатын сияқты.
Dialogue: 0,0:03:44.12,0:03:45.18,1080,,0,0,0,,Мүмкін емес
Dialogue: 0,0:03:45.48,0:03:47.17,1080,,0,0,0,,Жылдамдық туралы айту
Dialogue: 0,0:03:47.17,0:03:51.21,1080,,0,0,0,,Балалар, сендер қаншалықты жылдам кеттіңдер?
Dialogue: 0,0:03:51.21,0:03:54.04,1080,,0,0,0,,Жеделдету жақсы сезінеді, солай емес пе?
Dialogue: 0,0:03:54.04,0:03:56.44,1080,,0,0,0,,Өткен күні тас жолда
Dialogue: 0,0:03:56.44,0:04:00.00,1080,,0,0,0,,Мен 100 км, бұрын-соңды болмаған қашықтыққа жеттім
Dialogue: 0,0:04:00.00,0:04:01.50,1080,,0,0,0,,Жақсы, сүйкімді
Dialogue: 0,0:04:01.50,0:04:02.80,1080,,0,0,0,,Онса-чан бұл
Dialogue: 0,0:04:02.80,0:04:04.12,1080,,0,0,0,,Мүлдем
Dialogue: 0,0:04:04.12,0:04:05.98,1080,,0,0,0,,Ең жоғары жылдамдықпен мақтанасыз ба?
Dialogue: 0,0:04:05.98,0:04:07.67,1080,,0,0,0,,Мен бала емеспін.
Dialogue: 0,0:04:07.67,0:04:09.81,1080,,0,0,0,,Бірақ иә, иә.
Dialogue: 0,0:04:09.81,0:04:12.81,1080,,0,0,0,,Егер сіз спидометрден қол бұлғасаңыз...
Dialogue: 0,0:04:14.60,0:04:18.01,1080,,0,0,0,,Серо метрі 140-қа дейін белгі береді.
Dialogue: 0,0:04:18.01,0:04:20.48,1080,,0,0,0,,140 Ғажайып
Dialogue: 0,0:04:20.48,0:04:23.71,1080,,0,0,0,,Бұл жай ғана сынған есептегіш шығар.
Dialogue: 0,0:04:23.71,0:04:26.76,1080,,0,0,0,,Өтірік болса да осылай айтсаң ұтпайсың.
Dialogue: 0,0:04:26.90,0:04:28.30,1080,,0,0,0,,Рин ше?
Dialogue: 0,0:04:28.30,0:04:29.67,1080,,0,0,0,,Сіз неше килограмм салмақ салдыңыз?
Dialogue: 0,0:04:31.31,0:04:32.83,1080,,0,0,0,,Ал...
Dialogue: 0,0:04:33.56,0:04:34.67,1080,,0,0,0,,Хмм...
Dialogue: 0,0:04:35.85,0:04:38.42,1080,,0,0,0,,200 км... мүмкін
Dialogue: 0,0:04:38.79,0:04:40.95,1080,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:04:40.95,0:04:42.90,1080,,0,0,0,,Ол тітіркендіргіш адам.
Dialogue: 0,0:04:43.53,0:04:45.56,1080,,0,0,0,,Өтірік екені анықталмады
Dialogue: 0,0:04:45.56,0:04:48.68,1080,,0,0,0,,Токачидегі Минова Джидошаның сынақ курсында
Dialogue: 0,0:04:48.68,0:04:50.71,1080,,0,0,0,,Оны шынымен шығара алатыныңызды қараңыз...
Dialogue: 0,0:04:50.71,0:04:52.51,1080,,0,0,0,,100 км 100 км
Dialogue: 0,0:04:52.51,0:04:54.94,1080,,0,0,0,,Қарапайым адам сияқты, көлікті қауіпсіз жүргізіңіз.
Dialogue: 0,0:04:55.25,0:04:56.12,1080,,0,0,0,,Қараңыз
Dialogue: 0,0:04:56.40,0:04:59.26,1080,,0,0,0,,Бұл қозғалыс қауіпсіздігі шармының нөмірі
Dialogue: 0,0:04:59.57,0:05:01.37,1080,,0,0,0,,Уау, бұл жиіркенішті
Dialogue: 0,0:05:01.47,0:05:05.84,1080,,0,0,0,,Жоғары сынып оқушыларының жылдамдығымен мақтанғанын көру қызық.
Dialogue: 0,0:05:06.03,0:05:08.90,1080,,0,0,0,,Біз үшін 200 км клуб...
Dialogue: 0,0:05:11.48,0:05:14.43,1080,,0,0,0,,Бұрыш – мотоциклдің қаны.
Dialogue: 0,0:05:14.62,0:05:16.77,1080,,0,0,0,,Сұлулықпен еске алдым
Dialogue: 0,0:05:17.17,0:05:19.58,1080,,0,0,0,,Иә, мен мұны Рин Чанға беремін.
Dialogue: 0,0:05:19.58,0:05:23.16,1080,,0,0,0,,Неліктен Ханеде теңіз басы мінетін қасиетті кесе бар?
Dialogue: 0,0:05:23.16,0:05:26.02,1080,,0,0,0,,Мен оны Аомориде көмектескен адамнан алдым.
Dialogue: 0,0:05:27.20,0:05:29.34,1080,,0,0,0,,Бірақ менде ол бар...
Dialogue: 0,0:05:29.34,0:05:32.36,1080,,0,0,0,,Аа, бұл түпнұсқа нұсқасы.
Dialogue: 0,0:05:32.36,0:05:33.79,1080,,0,0,0,,Қайта басып шығару емес
Dialogue: 0,0:05:33.79,0:05:36.36,1080,,0,0,0,,Ал, ал, істе.
Dialogue: 0,0:05:36.36,0:05:38.29,1080,,0,0,0,,Оны маған берген адам
Dialogue: 0,0:05:38.29,0:05:41.18,1080,,0,0,0,,Бұл өлместің кесе.
Dialogue: 0,0:05:41.18,0:05:43.99,1080,,0,0,0,,Мен оның Рин Чанды қорғайтынына сенімдімін.
Dialogue: 0,0:05:53.33,0:05:55.58,1080,,0,0,0,,Бүгінгі маршрут солтүстікке қарай.
Dialogue: 0,0:05:55.58,0:05:59.31,1080,,0,0,0,,Мен бір түнге 2000 иен тұратын арзан қонақүйге тапсырыс бердім.
Dialogue: 0,0:05:59.31,0:06:01.94,1080,,0,0,0,,Мен оның қандай тұрғын үй екенін асыға күтемін.
Dialogue: 0,0:06:03.34,0:06:06.30,1080,,0,0,0,,Алыс түзу жолмен келді
Dialogue: 0,0:06:07.06,0:06:08.72,1080,,0,0,0,,Тау асуы да жақсы.
Dialogue: 0,0:06:08.72,0:06:12.04,1080,,0,0,0,,Хоккайдоға келсең, бұл жігіт.
Dialogue: 0,0:06:13.97,0:06:16.92,1080,,0,0,0,,Менің аяқ киімімнің бауы шешілді.
Dialogue: 0,0:06:16.92,0:06:19.94,1080,,0,0,0,,Барлығы тоқта, Рин Чан тоқта...
Dialogue: 0,0:06:19.94,0:06:22.41,1080,,0,0,0,,Жақында жетемін, әрі қарай жүр.
Dialogue: 0,0:06:22.41,0:06:23.73,1080,,0,0,0,,Түсіндім
Dialogue: 0,0:06:23.73,0:06:25.64,1080,,0,0,0,,Кеш қалмаңыз
Dialogue: 0,0:06:30.48,0:06:34.14,1080,,0,0,0,,Осындай жол сізді жылдамдатқыңыз келеді.
Dialogue: 0,0:06:34.14,0:06:36.00,1080,,0,0,0,,Бұлай жасамаңыз.
Dialogue: 0,0:06:36.00,0:06:37.62,1080,,0,0,0,,Рин қыңыр.
Dialogue: 0,0:06:37.62,0:06:40.08,1080,,0,0,0,,Әй, бәрің, қараңдаршы.
Dialogue: 0,0:06:40.08,0:06:42.31,1080,,0,0,0,,Мұндай жер...
Dialogue: 0,0:06:43.99,0:06:46.45,1080,,0,0,0,,Ақыры байланыс үзілді.
Dialogue: 0,0:06:46.45,0:06:48.49,1080,,0,0,0,,Бірақ жағдайға байланысты
Dialogue: 0,0:06:49.42,0:06:51.83,1080,,0,0,0,,Можа ақымақ
Dialogue: 0,0:06:54.36,0:06:55.50,1080,,0,0,0,,Жарайды
Dialogue: 0,0:06:55.50,0:06:56.61,1080,,0,0,0,,Артқа
Dialogue: 0,0:06:57.68,0:06:58.54,1080,,0,0,0,,Бұрын
Dialogue: 0,0:06:59.57,0:07:00.52,1080,,0,0,0,,Шығыс Одақпен ешқандай ойынға жол жоқ!
Dialogue: 0,0:07:02.20,0:07:03.48,1080,,0,0,0,,Кішкене ғана
Dialogue: 0,0:07:03.90,0:07:05.19,1080,,0,0,0,,Аз ғана
Dialogue: 0,0:07:06.92,0:07:10.00,1080,,0,0,0,,Кеттік
Dialogue: 0,0:07:11.40,0:07:13.25,1080,,0,0,0,,Ең жылдам тапсырма
Dialogue: 0,0:07:14.66,0:07:16.97,1080,,0,0,0,,Өз күшіңізді көрсетіңіз
Dialogue: 0,0:07:16.97,0:07:18.94,1080,,0,0,0,,Толығырақ...
Dialogue: 0,0:07:18.94,0:07:20.52,1080,,0,0,0,,Көбірек айқайлаңыз
Dialogue: 0,0:07:20.52,0:07:22.94,1080,,0,0,0,,Мен желмін, еркінмін
Dialogue: 0,0:07:22.94,0:07:25.21,1080,,0,0,0,,Мен...
Dialogue: 0,0:07:25.21,0:07:28.27,1080,,0,0,0,,Мен Құдаймын
Dialogue: 0,0:07:30.72,0:07:32.16,1080,,0,0,0,,Солтүстік түлкі
Dialogue: 0,0:07:35.08,0:07:38.26,1080,,0,0,0,,Әкемнің ауруы эхинококкоз.
Dialogue: 0,0:07:38.26,0:07:40.72,1080,,0,0,0,,Мен оны солтүстік түлкіден алдым.
Dialogue: 0,0:07:40.72,0:07:41.71,1080,,0,0,0,,Паразиттер
Dialogue: 0,0:07:42.52,0:07:43.38,1080,,0,0,0,,Рин
Dialogue: 0,0:07:43.61,0:07:45.39,1080,,0,0,0,,Папа папа
Dialogue: 0,0:07:45.39,0:07:49.19,1080,,0,0,0,,Мен солтүстік түлкіні құтқарғандықтан, әкем...
Dialogue: 0,0:07:49.72,0:07:52.38,1080,,0,0,0,,Жолда солтүстік түлкі көрінсе
Dialogue: 0,0:07:52.38,0:07:54.89,1080,,0,0,0,,Еш ойланбаңыз
Dialogue: 0,0:07:56.25,0:07:58.39,1080,,0,0,0,,Солтүстік түлкіден аулақ болуға тырысу
Dialogue: 0,0:07:58.39,0:08:00.56,1080,,0,0,0,,Егер сіз дұрыс тежесеңіз, апатқа ұшырайсыз.
Dialogue: 0,0:08:00.96,0:08:02.87,1080,,0,0,0,,Раковина
Dialogue: 0,0:08:03.31,0:08:07.11,1080,,0,0,0,,шыққаныңыз үшін сіз кінәлісіз
Dialogue: 0,0:08:11.33,0:08:12.28,1080,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:08:12.47,0:08:15.36,1080,,0,0,0,,Тоқта
Dialogue: 0,0:08:23.54,0:08:25.35,1080,,0,0,0,,Қазір қашыңыз.
Dialogue: 0,0:08:25.35,0:08:27.01,1080,,0,0,0,,...
Dialogue: 0,0:08:27.01,0:08:29.77,1080,,0,0,0,,Дос болудан ұялма.
Dialogue: 0,0:08:29.77,0:08:31.98,1080,,0,0,0,,Эхинококкоз жұғады
Dialogue: 0,0:08:45.93,0:08:48.70,1080,,0,0,0,,Жақсы, жақсы
Dialogue: 0,0:08:49.24,0:08:52.44,1080,,0,0,0,,Балалардың аман қалғанына қуаныштымын.
Dialogue: 0,0:08:54.77,0:08:58.17,1080,,0,0,0,,Әлем сызықтары арасында ауысқанда да естеліктерің бүтін қалады,
Dialogue: 0,0:08:59.77,0:09:03.15,1080,,0,0,0,,Йо Рин Ең жылдам тапсырма қалай болды?
Dialogue: 0,0:09:03.80,0:09:06.39,1080,,0,0,0,,Сіз мұны істеу мүмкін емес.
Dialogue: 0,0:09:06.39,0:09:08.08,1080,,0,0,0,,(Ходжинс) Көріп тұрғаныңыздай, базадағы сарбаздар қуыршақтарға сұраныс жоғары.
Dialogue: 0,0:09:08.08,0:09:09.72,1080,,0,0,0,,Бұл тітіркендіргіш
Dialogue: 0,0:09:09.72,0:09:12.55,1080,,0,0,0,,Бұл Хоккайдо.
Dialogue: 0,0:09:12.94,0:09:14.26,1080,,0,0,0,,Хоккайдода
Dialogue: 0,0:09:14.26,0:09:15.48,1080,,0,0,0,,Қанша ұшсаң да
Dialogue: 0,0:09:15.48,0:09:16.85,1080,,0,0,0,,Қанша жүгірсем де
Dialogue: 0,0:09:16.85,0:09:18.67,1080,,0,0,0,,Міне, сіз осы жерде аяқталасыз
Dialogue: 0,0:09:18.95,0:09:20.42,1080,,0,0,0,,Оңай алайық
Dialogue: 0,0:09:23.47,0:09:26.05,1080,,0,0,0,,Соя мүйісі қандай жер?
Dialogue: 0,0:09:26.05,0:09:29.49,1080,,0,0,0,,Биіктігі 100 метр жартас па?
Dialogue: 0,0:09:29.49,0:09:31.27,1080,,0,0,0,,Мен де білмеймін
Dialogue: 0,0:09:31.27,0:09:33.09,1080,,0,0,0,,Жарайды, барғанда білесің.
Dialogue: 0,0:09:33.09,0:09:35.22,1080,,0,0,0,,Мен ол жерге түнге қарай жете аламын ба?
Dialogue: 0,0:09:35.22,0:09:36.89,1080,,0,0,0,,маржа маржа
Dialogue: 0,0:09:36.89,0:09:38.54,1080,,0,0,0,,Соңғы жебеге айналғанша...
Dialogue: 0,0:09:38.54,0:09:40.32,1080,,0,0,0,,Түс болды ма?
Dialogue: 0,0:09:43.16,0:09:44.93,1080,,0,0,0,,Бөксесі ауырады
Dialogue: 0,0:09:44.93,0:09:46.42,1080,,0,0,0,,Содан кейін үзіліс жасаңыз.
Dialogue: 0,0:09:52.15,0:09:53.59,1080,,0,0,0,,Тездетіңіз
Dialogue: 0,0:09:53.59,0:09:55.80,1080,,0,0,0,,Күн батып жатыр.
Dialogue: 0,0:09:56.89,0:09:59.04,1080,,0,0,0,,Себебі мен тым көп демалдым
Dialogue: 0,0:10:00.03,0:10:02.62,1080,,0,0,0,,Күн ақыры таудың артында қалды
Dialogue: 0,0:10:02.62,0:10:05.12,1080,,0,0,0,,Тағы біраз күтіңіз
Dialogue: 0,0:10:11.23,0:10:12.48,1080,,0,0,0,,♪~
Dialogue: 0,0:10:12.48,0:10:14.58,1080,,0,0,0,,Біз Соя мүйісіне келдік.
Dialogue: 0,0:10:18.28,0:10:19.59,1080,,0,0,0,,Егер қаласаңыз, мен оны сіздің атыңыздан жеткізе аламын.
Dialogue: 0,0:10:19.59,0:10:23.65,1080,,0,0,0,,Бұл жай ғана уақыт емес, бұл ең жақсы сәт
Dialogue: 0,0:10:23.65,0:10:26.90,1080,,0,0,0,,Бұл менің Жапон теңізін бірінші рет көруім еді.
Dialogue: 0,0:10:26.90,0:10:31.29,1080,,0,0,0,,Бұл жерден мотоциклмен жүрудің басқа жолы жоқ.
Dialogue: 0,0:10:31.29,0:10:33.60,1080,,0,0,0,,Ах, бұл соңғы нүкте
Dialogue: 0,0:10:33.96,0:10:36.04,1080,,0,0,0,,Үйге қайту жолында ғана қалды.
Dialogue: 0,0:10:36.23,0:10:39.35,1080,,0,0,0,,Күн батар алдында естелік суретке түсірілмеді
Dialogue: 0,0:10:39.35,0:10:41.47,1080,,0,0,0,,Лайк қою Фотоға түсейік Фотоға түсейік
Dialogue: 0,0:10:42.12,0:10:42.91,1080,,0,0,0,,О.
Dialogue: 0,0:10:43.03,0:10:45.51,1080,,0,0,0,,Бірақ ана жақта бір әйел бар
Dialogue: 0,0:10:45.51,0:10:47.36,1080,,0,0,0,,Мен өзімді жалғыз сезінемін
Dialogue: 0,0:10:47.36,0:10:49.40,1080,,0,0,0,,Бір сәт артқа шегінуге болады ма?
Dialogue: 0,0:10:49.40,0:10:50.32,1080,,0,0,0,,Мүмкін емес
Dialogue: 0,0:10:51.02,0:10:54.59,1080,,0,0,0,,Жалғыз әйел ең алыс теңізге қарап, іңірге түседі.
Dialogue: 0,0:10:55.25,0:10:56.43,1080,,0,0,0,,Тым ауыр
Dialogue: 0,0:10:56.73,0:10:58.51,1080,,0,0,0,,Мен саған артқа шегін деп айта алмаймын.
Dialogue: 0,0:11:00.29,0:11:03.50,1080,,0,0,0,,Рин Мен бәріңмен бірге келе алатыныма қуаныштымын.
Dialogue: 0,0:11:03.80,0:11:05.06,1080,,0,0,0,,Кенет не болды?
Dialogue: 0,0:11:05.44,0:11:07.45,1080,,0,0,0,,Басқалар туралы білсеңіз де
Dialogue: 0,0:11:07.45,0:11:09.54,1080,,0,0,0,,Сіз өзіңізді көре алмайсыз
Dialogue: 0,0:11:09.81,0:11:10.73,1080,,0,0,0,,Наннокочо
Dialogue: 0,0:11:11.09,0:11:11.90,1080,,0,0,0,,О.
Dialogue: 0,0:11:12.12,0:11:14.65,1080,,0,0,0,,Бұрынғы әйел жоқ.
Dialogue: 0,0:11:15.99,0:11:16.75,1080,,0,0,0,,«Қиын екен.»
Dialogue: 0,0:11:16.75,0:11:18.96,1080,,0,0,0,,Таккунның ақымақ
Dialogue: 0,0:11:18.96,0:11:20.36,1080,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:11:20.36,0:11:22.01,1080,,0,0,0,,Ер адам тастап кеткен әйел
Dialogue: 0,0:11:22.01,0:11:24.53,1080,,0,0,0,,Соя мүйісінен велосипедпен секіру
Dialogue: 0,0:11:24.53,0:11:25.97,1080,,0,0,0,,Өмірді бағала
Dialogue: 0,0:11:25.97,0:11:27.34,1080,,0,0,0,,Ата-анам жылайды
Dialogue: 0,0:11:27.34,0:11:31.17,1080,,0,0,0,,Оның арғы жағында биіктігі 100 метр жартас...
Dialogue: 0,0:11:32.95,0:11:35.36,1080,,0,0,0,,... солай емес пе?
Dialogue: 0,0:11:35.36,0:11:37.60,1080,,0,0,0,,Матсуда мырза өледі.
Dialogue: 0,0:11:37.60,0:11:40.64,1080,,0,0,0,,Бұл жігітке не керек еді?
Dialogue: 0,0:11:40.03,0:11:42.56,1080,,0,0,0,,Итататата
Dialogue: 0,0:11:40.64,0:11:43.00,1080,,0,0,0,,Амансың ба?
Dialogue: 0,0:11:43.92,0:11:46.14,1080,,0,0,0,,Мүмкін?
Dialogue: 0,0:11:46.17,0:11:47.77,1080,,0,0,0,,Саруяма мырза
Dialogue: 0,0:11:49.39,0:11:50.68,1080,,0,0,0,,Балалар
Dialogue: 0,0:12:02.97,0:12:07.03,1080,,0,0,0,,-да мені 13-ші жігітім тастап кетті.
Dialogue: 0,0:12:07.03,0:12:10.86,1080,,0,0,0,,Күшті күйде мен Хоккайдоға велосипедпен өттім.
Dialogue: 0,0:12:10.86,0:12:13.85,1080,,0,0,0,,Ең солтүстік шетінде романтикалық сезінесіз бе?
Dialogue: 0,0:12:13.85,0:12:18.50,1080,,0,0,0,,Мен Соя мүйісі осындай деп ойладым.
Dialogue: 0,0:12:18.50,0:12:20.28,1080,,0,0,0,,Романтика тым көп
Dialogue: 0,0:12:20.28,0:12:23.09,1080,,0,0,0,,Соның артынан барсам, таяз теңізден таптым.
Dialogue: 0,0:12:23.41,0:12:25.47,1080,,0,0,0,,Әй, бәрі жиналып жатыр.
Dialogue: 0,0:12:25.47,0:12:27.67,1080,,0,0,0,,Бұл мүмкіндік деп ойламайсыз ба?
Dialogue: 0,0:12:27.67,0:12:28.63,1080,,0,0,0,,Мүмкіндік?
Dialogue: 0,0:12:28.63,0:12:29.97,1080,,0,0,0,,Мен кеңесшімін.
Dialogue: 0,0:12:29.97,0:12:32.69,1080,,0,0,0,,Менің ойымша, мотоцикл клубында әлі кеңесші жоқ.
Dialogue: 0,0:12:32.69,0:12:35.75,1080,,0,0,0,,Ешбір мұғалім мені қабылдамады.
Dialogue: 0,0:12:36.15,0:12:37.91,1080,,0,0,0,,Егер Саруяма мырза
Dialogue: 0,0:12:37.91,0:12:40.82,1080,,0,0,0,,Көлемі 50 см болса да, мен мотоцикл мініп жүрмін.
Dialogue: 0,0:12:41.17,0:12:44.62,1080,,0,0,0,,Жүрегі жараланған Саруяма мырзаны жұбатсаңыз,
Dialogue: 0,0:12:44.62,0:12:47.50,1080,,0,0,0,,Мүмкін ол сенің алдыңда қарыздар екенін сезініп, кеңесшіңе айналуы мүмкін.
Dialogue: 0,0:12:47.50,0:12:48.60,1080,,0,0,0,,Бинго
Dialogue: 0,0:12:48.79,0:12:50.72,1080,,0,0,0,,Бұл тағдыр
Dialogue: 0,0:12:50.72,0:12:53.16,1080,,0,0,0,,Мен Соя мүйісіне кешігіп келдім.
Dialogue: 0,0:12:53.16,0:12:55.34,1080,,0,0,0,,Мұның бәрі Құдайдың нұсқауы.
Dialogue: 0,0:12:57.76,0:13:02.65,1080,,0,0,0,,Саруяма мырза, мен сізді бүгін кешке жұбатуға тырысамын.
Dialogue: 0,0:13:02.65,0:13:05.67,1080,,0,0,0,,Мұғалімге шабуыл жасағаны үшін ол жаман адам.
Dialogue: 0,0:13:05.67,0:13:06.90,1080,,0,0,0,,Шынайы ақиқат
Dialogue: 0,0:13:06.90,0:13:09.60,1080,,0,0,0,,Мұғалім, сен сондай сүйкімдісің
Dialogue: 0,0:13:09.60,0:13:11.95,1080,,0,0,0,,Біз сені жақсы көреміз.
Dialogue: 0,0:13:11.95,0:13:14.89,1080,,0,0,0,,Ер адамдар өзімшіл.
Dialogue: 0,0:13:14.89,0:13:17.82,1080,,0,0,0,,Мотоциклдің орын ауыстыруының не екенін білесіз бе?
Dialogue: 0,0:13:17.82,0:13:20.82,1080,,0,0,0,,Бұл оның көлемінің белгісі.
Dialogue: 0,0:13:20.82,0:13:24.06,1080,,0,0,0,,Велосипедіңізге көңіліңіз толса да
Dialogue: 0,0:13:24.06,0:13:28.11,1080,,0,0,0,,Олар әйелдерге үлкенірек велосипедпен жүруге рұқсат бермейді.
Dialogue: 0,0:13:28.11,0:13:30.22,1080,,0,0,0,,Егер адам 90 см болса
Dialogue: 0,0:13:30.22,0:13:33.79,1080,,0,0,0,,Әйелдер бар болғаны 50 кк.
Dialogue: 0,0:13:34.04,0:13:38.55,1080,,0,0,0,,Балалар, сіз 400 cc сияқты үлкен велосипед мінсеңіз ше?
Dialogue: 0,0:13:38.55,0:13:40.79,1080,,0,0,0,,Менің жігітім болмайды.
Dialogue: 0,0:13:40.79,0:13:42.63,1080,,0,0,0,,Жоқ, дұрыс.
Dialogue: 0,0:13:42.87,0:13:45.75,1080,,0,0,0,,Әй, эй, бұл заттың көлемі қанша?
Dialogue: 0,0:13:46.62,0:13:50.11,1080,,0,0,0,,Менің ойымша, бұл сіздің жүрегіңіздің көлеміне байланысты.
Dialogue: 0,0:13:50.11,0:13:51.45,1080,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:51.45,0:13:53.92,1080,,0,0,0,,Төзімді болған дұрыс.
Dialogue: 0,0:13:56.59,0:13:59.29,1080,,0,0,0,,Егер сіз де жоғары сынып оқушысы болсаңыз
Dialogue: 0,0:13:59.29,0:14:02.19,1080,,0,0,0,,Қауіпті велосипедтерге мінбеңіз
Dialogue: 0,0:14:02.19,0:14:05.33,1080,,0,0,0,,Енді сіз жасай алатын нәрселер көп болуы мүмкін.
Dialogue: 0,0:14:05.33,0:14:06.53,1080,,0,0,0,,Өтелетін танысу және т.б.
Dialogue: 0,0:14:06.53,0:14:09.13,1080,,0,0,0,,Мұғалім, бұл туралы өтірік айту дұрыс емес.
Dialogue: 0,0:14:09.13,0:14:10.68,1080,,0,0,0,,Оқу сияқты бірдеңе айтыңыз.
Dialogue: 0,0:14:10.89,0:14:13.55,1080,,0,0,0,,Бірақ сіз ғажапсыз, солай емес пе, мұғалім?
Dialogue: 0,0:14:14.29,0:14:16.21,1080,,0,0,0,,Осындай кішкентай мотоциклмен
Dialogue: 0,0:14:16.21,0:14:18.42,1080,,0,0,0,,Мен осы уақытқа дейін келдім
Dialogue: 0,0:14:18.71,0:14:21.26,1080,,0,0,0,,Мұғалімнен жақсы әсер алдым.
Dialogue: 0,0:14:21.56,0:14:25.50,1080,,0,0,0,,Біз де осындай мұғаліммен жүгіргіміз келеді.
Dialogue: 0,0:14:31.00,0:14:33.30,1080,,0,0,0,,Рахмет, Хане Чан
Dialogue: 0,0:14:33.30,0:14:35.71,1080,,0,0,0,,Мен де ақымақпын.
Dialogue: 0,0:14:35.71,0:14:38.38,1080,,0,0,0,,Еркектерге алаңдама
Dialogue: 0,0:14:38.80,0:14:42.19,1080,,0,0,0,,Менің сондай сүйкімді оқушыларым болса да
Dialogue: 0,0:14:49.68,0:14:52.62,1080,,0,0,0,,Саса, Хане Чан да кездесіп жүр.
Dialogue: 0,0:14:52.62,0:14:54.04,1080,,0,0,0,,Кішкене ғана
Dialogue: 0,0:14:54.04,0:14:56.15,1080,,0,0,0,,Әзіл. Жай ойнам айттым.
Dialogue: 0,0:14:56.15,0:14:57.74,1080,,0,0,0,,Мұғалімдік қызметтегі тұлғалар
Dialogue: 0,0:14:57.74,0:15:03.47,1080,,0,0,0,,Ешкім ешқашан кәмелетке толмаған баланы ішімдік ішуге мәжбүрлемейді.
Dialogue: 0,0:15:04.41,0:15:06.48,1080,,0,0,0,,Тек иіс
Dialogue: 0,0:15:08.01,0:15:09.76,1080,,0,0,0,,Менің басым айналады.
Dialogue: 0,0:15:10.52,0:15:13.28,1080,,0,0,0,,Мен өзімді...
Dialogue: 0,0:15:14.01,0:15:16.50,1080,,0,0,0,,О, Хан Чан ұйықтап қалды.
Dialogue: 0,0:15:17.94,0:15:20.34,1080,,0,0,0,,Ханан қатты шаршады.
Dialogue: 0,0:15:20.34,0:15:23.91,1080,,0,0,0,,Олай болса, алыс қашықтыққа гастрольдік сапарға шығайық.
Dialogue: 0,0:15:23.91,0:15:27.04,1080,,0,0,0,,Бөкседегі әжімдердің саны қаншаға азайды?
Dialogue: 0,0:15:27.04,0:15:28.67,1080,,0,0,0,,Тексерейік.
Dialogue: 0,0:15:28.67,0:15:31.21,1080,,0,0,0,,Мұғалім, сіз не істеп жатырсыз?
Dialogue: 0,0:15:31.21,0:15:34.18,1080,,0,0,0,,Бөкселер - ең жақсы достар бір-біріне көрсететін нәрсе.
Dialogue: 0,0:15:34.18,0:15:35.10,1080,,0,0,0,,Не болды, апа?
Dialogue: 0,0:15:35.10,0:15:37.93,1080,,0,0,0,,Менің ойымша, бұл сендер сүйкімді екенсіңдер.
Dialogue: 0,0:15:37.93,0:15:39.52,1080,,0,0,0,,Сүйкімді болу күнә
Dialogue: 0,0:15:39.52,0:15:41.30,1080,,0,0,0,,Мен қазір жұмыс істеп жатырмын ғой, білесің бе. Мен бос емеспін
Dialogue: 0,0:15:41.30,0:15:45.61,1080,,0,0,0,,Өткенде мені 13 адам тастап кеткені осы болуы мүмкін бе?
Dialogue: 0,0:15:45.61,0:15:48.77,1080,,0,0,0,,Ішімдік ішу қызды ұнатады
Dialogue: 0,0:15:48.77,0:15:51.64,1080,,0,0,0,,Келесі семестрден бастап сабаққа барғым келмейді.
Dialogue: 0,0:15:51.64,0:15:53.60,1080,,0,0,0,,Егер сіз кедергі келтірсеңіз
Dialogue: 0,0:15:53.60,0:15:57.44,1080,,0,0,0,,Алдымен Амано-сан сізді жұбатсын.
Dialogue: 0,0:15:59.02,0:16:01.43,1080,,0,0,0,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:16:01.69,0:16:03.14,1080,,0,0,0,,Мұғалім Сен
Dialogue: 0,0:16:02.80,0:16:04.00,1080,,0,0,0,,Бұл...
Dialogue: 0,0:16:04.00,0:16:08.07,1080,,0,0,0,,Буржуазиялық топ... Жоқ, Мистер Минова Б
Dialogue: 0,0:16:08.07,0:16:11.21,1080,,0,0,0,,Аяғыңызды жалай аламын ба?
Dialogue: 0,0:16:11.21,0:16:14.18,1080,,0,0,0,,Мен лас ересек адам болғым келмейді
Dialogue: 0,0:16:15.12,0:16:18.50,1080,,0,0,0,,Жалаңаш жарыс костюмін киген Рин-чан
Dialogue: 0,0:16:18.50,0:16:20.57,1080,,0,0,0,,Бұл мұғалімге қатысты жанжал.
Dialogue: 0,0:16:20.57,0:16:23.28,1080,,0,0,0,,Фотосуреттер жақсы емес. Бейнелерді түсіріңіз. Бейнелерді түсіріңіз.
Dialogue: 0,0:16:23.42,0:16:25.71,1080,,0,0,0,,Жарайсың ба, Райму-сенпай?
Dialogue: 0,0:16:25.71,0:16:27.68,1080,,0,0,0,,Мотоцикл клубын тану
Dialogue: 0,0:16:27.68,0:16:30.54,1080,,0,0,0,,Маған дұрыс күтім жасауыңызды өтінемін.
Dialogue: 0,0:16:30.83,0:16:32.95,1080,,0,0,0,,Егер сіз апатқа себепкер болсаңыз, бұл жақсы емес.
Dialogue: 0,0:16:32.95,0:16:35.42,1080,,0,0,0,,Дәлірек айтқанда, мотоцикл клубының мүшелеріне бірдеңе болды.
Dialogue: 0,0:16:35.42,0:16:38.55,1080,,0,0,0,,Директор ретіндегі жауапкершілігіме келетін болсақ
Dialogue: 0,0:16:38.73,0:16:40.31,1080,,0,0,0,,Мен сені бірінші өлтіремін
Dialogue: 0,0:16:40.56,0:16:42.13,1080,,0,0,0,,Өлмесең де өлтір
Dialogue: 0,0:16:42.43,0:16:44.11,1080,,0,0,0,,Не болса да өлтіріңіз
Dialogue: 0,0:16:49.87,0:16:53.97,1080,,0,0,0,,Саруяма мырза, сіз велоклубтың кеңесшісі бола аласыз ба?
Dialogue: 0,0:16:53.97,0:16:55.26,1080,,0,0,0,,Бұл болады
Dialogue: 0,0:16:55.26,0:16:56.99,1080,,0,0,0,,Дәлел ретінде суретке түсірдім.
Dialogue: 0,0:16:57.42,0:16:59.37,1080,,0,0,0,,Алкоголь қорқынышты, солай ма?
Dialogue: 0,0:16:59.48,0:17:00.46,1080,,0,0,0,,Шешім
Dialogue: 0,0:17:00.46,0:17:02.34,1080,,0,0,0,,Тіпті ересек адам болса да
Dialogue: 0,0:17:02.34,0:17:03.79,1080,,0,0,0,,Ішімдік ішпеңіз және көлік жүргізбеңіз
Dialogue: 0,0:17:03.79,0:17:05.24,1080,,0,0,0,,Л-Ллойд, қарашы…
Dialogue: 0,0:17:05.24,0:17:06.54,1080,,0,0,0,,Бұл арқан болады
Dialogue: 0,0:17:14.29,0:17:16.96,1080,,0,0,0,,Бұл Хоккайдо турының соңы ма?
Dialogue: 0,0:17:16.96,0:17:20.70,1080,,0,0,0,,Осының соңы деп ойлаудың өзі мұңды.
Dialogue: 0,0:17:24.82,0:17:27.59,1080,,0,0,0,,Эй, сен біраз уақыт жүгіре аласың.
Dialogue: 0,0:17:27.59,0:17:30.33,1080,,0,0,0,,Жарайды. Әлі уақыт бар.
Dialogue: 0,0:17:30.33,0:17:31.77,1080,,0,0,0,,Stop Stop
Dialogue: 0,0:17:31.77,0:17:33.18,1080,,0,0,0,,Сіз қайтып орала алмайсыз.
Dialogue: 0,0:17:33.18,0:17:36.80,1080,,0,0,0,,Ештеңе етпейді, өйткені үлкен ағаң сенімен бірге келеді.
Dialogue: 0,0:17:36.98,0:17:40.19,1080,,0,0,0,,Бұл қайтып оралуға болмайды дегенді білдірмейді.
Dialogue: 0,0:17:41.25,0:17:43.20,1080,,0,0,0,,Жүрегім қайтып оралмайды
Dialogue: 0,0:17:44.84,0:17:48.63,1080,,0,0,0,,Хоккайдо - шабандоздардың арманы.
Dialogue: 0,0:17:49.42,0:17:52.55,1080,,0,0,0,,Мен де көбірек жүгіріп, көп жерге барғым келеді.
Dialogue: 0,0:17:53.16,0:17:56.72,1080,,0,0,0,,Бірақ түстен оянатын кез келді
Dialogue: 0,0:17:57.47,0:18:00.09,1080,,0,0,0,,Ертең бізді шынайы дүние күтіп тұр.
Dialogue: 0,0:18:00.96,0:18:03.26,1080,,0,0,0,,Үйге апарсам да, тым ауыр.
Dialogue: 0,0:18:05.19,0:18:07.58,1080,,0,0,0,,О, үлкен үлкен
Dialogue: 0,0:18:07.58,0:18:11.39,1080,,0,0,0,,Қанат үні арасында Хоккайдоға деген махаббатым артып барады.
Dialogue: 0,0:18:11.39,0:18:12.79,1080,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:18:12.79,0:18:14.86,1080,,0,0,0,,Бұлай үйге бару қиын.
Dialogue: 0,0:18:15.59,0:18:18.54,1080,,0,0,0,,Хоккайдода осы сезімдерді қалдырыңыз.
Dialogue: 0,0:18:19.07,0:18:21.42,1080,,0,0,0,,Үйге тек кәдесыйларды алып кетіңіз.
Dialogue: 0,0:18:35.57,0:18:36.34,1080,,0,0,0,,Пои
Dialogue: 0,0:18:38.40,0:18:41.37,1080,,0,0,0,,Можа Мен оны әрқашан біртүрлі деп ойлайтынмын.
Dialogue: 0,0:18:41.37,0:18:45.09,1080,,0,0,0,,Бүгін алысқа бардың, ұят болды.
Dialogue: 0,0:18:45.09,0:18:46.17,1080,,0,0,0,,(Каишо) Қорықпа—ағамның қаны менікімен бірдей қасиетке ие емес.
Dialogue: 0,0:18:47.06,0:18:49.30,1080,,0,0,0,,Сіз әдетте айта алмайтын ұятсыз жолдар
Dialogue: 0,0:18:49.30,0:18:51.10,1080,,0,0,0,,Бұзық мінез-құлық
Dialogue: 0,0:18:51.10,0:18:53.84,1080,,0,0,0,,Бұл Хоккайдоға ең қолайлы.
Dialogue: 0,0:18:58.98,0:19:01.99,1080,,0,0,0,,Қош бол Хоккайдо
Dialogue: 0,0:19:07.41,0:19:10.96,1080,,0,0,0,,Хоккайдо турында кірді тазалайық
Dialogue: 0,0:19:12.02,0:19:14.81,1080,,0,0,0,,Қалағаныңызша іліңіз, Онса-чан.
Dialogue: 0,0:19:14.81,0:19:16.17,1080,,0,0,0,,Әрине
Dialogue: 0,0:19:16.42,0:19:18.00,1080,,0,0,0,,Бұл Рин Чан
Dialogue: 0,0:19:18.00,0:19:20.64,1080,,0,0,0,,Жоғары қысымды шайғыштарды адамдарға бағыттамаңыз.
Dialogue: 0,0:19:20.94,0:19:24.27,1080,,0,0,0,,Сей-чан Зукачидің бүйірін жумайды.
Dialogue: 0,0:19:24.27,0:19:24.96,1080,,0,0,0,,Иә
Dialogue: 0,0:19:25.26,0:19:28.39,1080,,0,0,0,,Хаякава әрқашан жылтыр.
Dialogue: 0,0:19:30.53,0:19:33.87,1080,,0,0,0,,Онса-чан көптеген көлік жуу құралдарын әкелді.
Dialogue: 0,0:19:33.87,0:19:37.81,1080,,0,0,0,,Мотоциклдердің автомобильдерге қарағанда ашық бөліктері көп.
Dialogue: 0,0:19:37.81,0:19:39.77,1080,,0,0,0,,Оңай ластанады және оңай тот басады
Dialogue: 0,0:19:40.08,0:19:41.99,1080,,0,0,0,,Оны бір-бірлеп нақтылаңыз
Dialogue: 0,0:19:42.33,0:19:45.40,1080,,0,0,0,,Велосипедті жылтырату, яғни...
Dialogue: 0,0:19:45.43,0:19:48.97,1080,,0,0,0,,Бұл сіздің жаныңызды тазарту туралы.
Dialogue: 0,0:19:52.75,0:19:53.69,1080,,0,0,0,,Тоқтатайық
Dialogue: 0,0:19:54.21,0:19:56.78,1080,,0,0,0,,Жол талғамайтын велосипедтердегі сызаттар мен кірлер...
Dialogue: 0,0:19:56.78,0:19:58.93,1080,,0,0,0,,Иә, бұл медаль.
Dialogue: 0,0:19:58.93,0:20:01.94,1080,,0,0,0,,Хаякава: Бірінші айта алмайсың.
Dialogue: 0,0:20:01.94,0:20:03.76,1080,,0,0,0,,Кетіңіз.
Dialogue: 0,0:20:06.49,0:20:08.87,1080,,0,0,0,,Көлікті жуу қолды шаршатады.
Dialogue: 0,0:20:08.87,0:20:11.97,1080,,0,0,0,,Үнемі тұрғаннан аяғым ауырады.
Dialogue: 0,0:20:11.97,0:20:13.13,1080,,0,0,0,,Иә.
Dialogue: 0,0:20:23.43,0:20:25.25,1080,,0,0,0,,Сен не істеп жатырсың?
Dialogue: 0,0:20:25.59,0:20:28.25,1080,,0,0,0,,Егер сіз бүкіл денеңізді осылай пайдалансаңыз
Dialogue: 0,0:20:28.25,0:20:30.26,1080,,0,0,0,,Қызық, оларды бірден жууға болады ма?
Dialogue: 0,0:20:30.26,0:20:33.55,1080,,0,0,0,,Бұл американдық көлік жуу орны.
Dialogue: 0,0:20:33.84,0:20:36.20,1080,,0,0,0,,Губкадан жұмсақ денені қолдану
Dialogue: 0,0:20:36.20,0:20:38.33,1080,,0,0,0,,Велосипедті қастерлеу қозғалысы
Dialogue: 0,0:20:38.33,0:20:40.85,1080,,0,0,0,,Мұқият жуудың көрінісі
Dialogue: 0,0:20:41.46,0:20:44.97,1080,,0,0,0,,Бұл нағыз махаббат, солай емес пе?
Dialogue: 0,0:20:45.95,0:20:48.93,1080,,0,0,0,,Мүмкін мен Онса-чанның алдында шығармын.
Dialogue: 0,0:20:48.93,0:20:50.39,1080,,0,0,0,,Жоқ, тіпті шамалы.
Dialogue: 0,0:20:51.26,0:20:55.07,1080,,0,0,0,,Дегенмен, бұл менің сүйікті көлігім дер едім.
Dialogue: 0,0:20:55.07,0:20:55.89,1080,,0,0,0,,Иә
Dialogue: 0,0:20:56.27,0:21:00.27,1080,,0,0,0,,Велосипедімді қаншалықты жақсы көремін деген сұраққа келсек, Хане Чан бірінші орынды алады.
Dialogue: 0,0:21:01.70,0:21:05.77,1080,,0,0,0,,Мен велосипедімді көбірек жақсы көремін.
Dialogue: 0,0:21:09.17,0:21:10.99,1080,,0,0,0,,Әй, эй, өзіңді қатты итерме.
Dialogue: 0,0:21:10.99,0:21:12.51,1080,,0,0,0,,Мүмкін емес пе?
Dialogue: 0,0:21:12.51,0:21:15.11,1080,,0,0,0,,Егер сіз осындай велосипедтерді жақсы көретін болсаңыз, бұл табиғи нәрсе.
Dialogue: 0,0:21:26.56,0:21:29.01,1080,,0,0,0,,Катана 400 үшін шығар
Dialogue: 0,0:21:29.01,0:21:31.43,1080,,0,0,0,,Рин-чанның махаббаты тым көп болды емес пе?
Dialogue: 0,0:21:31.91,0:21:33.99,1080,,0,0,0,,Менде шай мен сегіз кесе бар.
Dialogue: 0,0:21:33.99,0:21:35.88,1080,,0,0,0,,Клуб бөлмесінде демалайық
Dialogue: 0,0:23:31.59,0:23:33.57,1080,,0,0,0,,Келесі жолы Бакуон
Dialogue: 0,0:23:33.98,0:23:35.19,1080,,0,0,0,,Дайындық
Dialogue: 0,0:23:36.69,0:23:42.69,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
