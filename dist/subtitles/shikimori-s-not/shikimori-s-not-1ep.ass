Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.50,0:00:10.92,Default,,0,0,0,,Ю~
Dialogue: 0,0:00:11.76,0:00:13.55,Default,,0,0,0,,Сіз асығыс емессіз бе?
Dialogue: 0,0:00:14.55,0:00:15.89,Default,,0,0,0,,Yes
Dialogue: 0,0:00:22.73,0:00:23.69,Default,,0,0,0,,Ах
Dialogue: 0,0:00:25.85,0:00:26.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:31.86,0:00:34.20,Default,,0,0,0,,Артқа Ол серпілуде
Dialogue: 0,0:00:34.28,0:00:35.41,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:00:41.95,0:00:43.75,Default,,0,0,0,,Иә, ол түзетілді.
Dialogue: 0,0:00:45.21,0:00:46.79,Default,,0,0,0,,Рахмет, анашым.
Dialogue: 0,0:00:46.88,0:00:48.00,Default,,0,0,0,,Хехе
Dialogue: 0,0:00:48.08,0:00:50.63,Default,,0,0,0,,Бүгін сәл ерте.
Dialogue: 0,0:00:50.71,0:00:52.05,Default,,0,0,0,,Бұл бірінші күн.
Dialogue: 0,0:00:52.13,0:00:53.76,Default,,0,0,0,,Менің кешігіп қалғым келмейді
Dialogue: 0,0:00:53.84,0:00:55.26,Default,,0,0,0,,Мен сені күттіргім келмейді.
Dialogue: 0,0:00:55.80,0:00:57.39,Default,,0,0,0,,Шикимори-санға сәлем
Dialogue: 0,0:00:58.47,0:00:59.39,Default,,0,0,0,,Иә
Dialogue: 0,0:00:59.47,0:01:01.51,Default,,0,0,0,,Жоқ, өмірден үміт үзбе
Dialogue: 0,0:01:01.60,0:01:04.64,Default,,0,0,0,,Тас, машина, қарға, т.б.
Dialogue: 0,0:01:04.73,0:01:06.35,Default,,0,0,0,,Сондай-ақ плиткалар және т.б.
Dialogue: 0,0:01:06.44,0:01:08.19,Default,,0,0,0,,Иә, мен барамын.
Dialogue: 0,0:01:09.94,0:01:12.32,Default,,0,0,0,,Жалғастырыңыз.
Dialogue: 0,0:01:16.32,0:01:17.53,Default,,0,0,0,,Фугия...
Dialogue: 0,0:01:17.61,0:01:18.53,Default,,0,0,0,,Өте беделді адамды әкеліпсің ғой, иә?
Dialogue: 0,0:01:19.57,0:01:21.66,Default,,0,0,0,,Itatatata…
Dialogue: 0,0:01:22.12,0:01:24.00,Default,,0,0,0,,кенеттен?
Dialogue: 0,0:01:32.05,0:01:32.88,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:32.96,0:01:34.51,Default,,0,0,0,,(Жылаған дауыс)
Dialogue: 0,0:01:35.42,0:01:36.88,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:01:36.97,0:01:37.97,Default,,0,0,0,,Ха…
Dialogue: 0,0:01:42.97,0:01:44.02,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:45.56,0:01:48.10,Default,,0,0,0,,Уау...тататтатто...
Dialogue: 0,0:01:48.19,0:01:49.23,Default,,0,0,0,,Даа!
Dialogue: 0,0:01:53.32,0:01:55.49,Default,,0,0,0,,Жылы...
Dialogue: 0,0:01:56.28,0:01:57.24,Default,,0,0,0,,Ах
Dialogue: 0,0:02:02.08,0:02:04.49,Default,,0,0,0,,Әже, жақсысыз ба?
Dialogue: 0,0:02:05.95,0:02:08.04,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:02:08.12,0:02:10.21,Default,,0,0,0,,Сенің басың кіршіксіз.
Dialogue: 0,0:02:10.29,0:02:11.63,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:02:12.21,0:02:14.59,Default,,0,0,0,,Жарайды, мен саған көмектесемін.
Dialogue: 0,0:02:15.59,0:02:18.51,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:02:19.01,0:02:20.68,Default,,0,0,0,,Шашымды сәндесем де...
Dialogue: 0,0:02:20.76,0:02:23.01,Default,,0,0,0,,Ха ха ха... Бұл мағынасыз болды.
Dialogue: 0,0:02:38.15,0:02:40.70,Default,,0,0,0,,Шикимори-сан!
Dialogue: 0,0:02:47.50,0:02:48.91,Default,,0,0,0,,Хаха...
Dialogue: 0,0:02:49.37,0:02:51.00,Default,,0,0,0,,Қайырлы таң Шикимори-сан
Dialogue: 0,0:02:51.67,0:02:54.42,Default,,0,0,0,,Қайырлы таң, Изуми мырза.
Dialogue: 0,0:02:56.96,0:02:59.17,Default,,0,0,0,,Қараңдар, қараңдаршы, сүйкімді~
Dialogue: 0,0:02:59.26,0:03:02.30,Default,,0,0,0,,О, шынында да, пұт сияқты.
Dialogue: 0,0:03:04.93,0:03:07.14,Default,,0,0,0,,Сізді үнемі күткенім үшін кешіріңіз.
Dialogue: 0,0:03:07.22,0:03:08.47,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:08.56,0:03:11.60,Default,,0,0,0,,Изуми-санды күту де қызық.
Dialogue: 0,0:03:12.06,0:03:13.69,Default,,0,0,0,,Қалай болғанда да...
Dialogue: 0,0:03:14.23,0:03:17.90,Default,,0,0,0,,Бүгін таңертеңнен бері қиын болған сияқты.
Dialogue: 0,0:03:17.98,0:03:19.40,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:03:19.49,0:03:22.49,Default,,0,0,0,,Ахаха, өйткені бұл әрқашан солай
Dialogue: 0,0:03:27.20,0:03:29.91,Default,,0,0,0,,Менің құрбым өте сүйкімді
Dialogue: 0,0:03:31.00,0:03:32.54,Default,,0,0,0,,Бірақ кейде...
Dialogue: 0,0:03:33.46,0:03:35.00,Default,,0,0,0,,Бұл сүйкімді емес...
Dialogue: 0,0:03:35.08,0:03:36.04,Default,,0,0,0,,Не!
Dialogue: 0,0:03:36.13,0:03:38.80,Default,,0,0,0,,Егер тойлауға сыйлық бергің келсе, өміріңді аламын.
Dialogue: 0,0:03:38.88,0:03:40.63,Default,,0,0,0,,Бұл сүйкімді емес...
Dialogue: 0,0:03:40.72,0:03:42.34,Default,,0,0,0,,Жаман емес пе?
Dialogue: 0,0:03:42.43,0:03:44.30,Default,,0,0,0,,Кешіріңіз, мен оны қатты айттым.
Dialogue: 0,0:03:44.39,0:03:46.80,Default,,0,0,0,,Хмм, бұл одан да сорақы!
Dialogue: 0,0:03:46.89,0:03:49.39,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:03:49.47,0:03:50.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:53.65,0:03:55.27,Default,,0,0,0,,Изуми мырза! (Изуми) Ах...
Dialogue: 0,0:04:01.32,0:04:04.20,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:04:04.28,0:04:06.28,Default,,0,0,0,,Ах...буна...
Dialogue: 0,0:04:08.33,0:04:09.74,Default,,0,0,0,,Мен әрқашан кешірім сұраймын
Dialogue: 0,0:04:09.83,0:04:11.08,Default,,0,0,0,,Жарақаттар жоқ па?
Dialogue: 0,0:04:12.50,0:04:13.50,Default,,0,0,0,,Е...
Dialogue: 0,0:04:13.58,0:04:15.08,Default,,0,0,0,,Мен өкінбеймін.
Dialogue: 0,0:04:16.46,0:04:19.59,Default,,0,0,0,,Менің дос қызым кейде...
Dialogue: 0,0:04:19.67,0:04:21.46,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:04:21.92,0:04:24.26,Default,,0,0,0,,Мені көп мазаламаңыз
Dialogue: 0,0:04:26.64,0:04:28.93,Default,,0,0,0,,Өте керемет
Dialogue: 0,0:04:32.93,0:04:35.77,Default,,0,0,0,,♪~
Dialogue: 0,0:05:58.06,0:06:01.86,Default,,0,0,0,,~♪
Dialogue: 0,0:06:07.24,0:06:08.91,Default,,0,0,0,,Ол гүлдеді
Dialogue: 0,0:06:08.99,0:06:11.03,Default,,0,0,0,,Бұл әдемі, солай емес пе?
Dialogue: 0,0:06:11.12,0:06:12.12,Default,,0,0,0,,Иә
Dialogue: 0,0:06:14.24,0:06:18.21,Default,,0,0,0,,Былтырғы қабылдау рәсімінде де әдемі көріндің.
Dialogue: 0,0:06:18.29,0:06:20.17,Default,,0,0,0,,Жақсы... бұл дұрыс.
Dialogue: 0,0:06:20.25,0:06:21.63,Default,,0,0,0,,есімде
Dialogue: 0,0:06:21.71,0:06:24.13,Default,,0,0,0,,Сол кезде мен қатты қобалжыдым...
Dialogue: 0,0:06:28.42,0:06:31.59,Default,,0,0,0,,Менің де есімде, Джуми мырза.
Dialogue: 0,0:06:31.68,0:06:33.72,Default,,0,0,0,,Бұл туралы ұмыт!
Dialogue: 0,0:06:33.81,0:06:35.31,Default,,0,0,0,,Уау
Dialogue: 0,0:06:35.97,0:06:37.89,Default,,0,0,0,,Екі қолыңды тербе.
Dialogue: 0,0:06:37.98,0:06:40.44,Default,,0,0,0,,Уау, барлығы қарап отыр.
Dialogue: 0,0:06:40.52,0:06:43.11,Default,,0,0,0,,Бұл өте көп адам.
Dialogue: 0,0:06:45.86,0:06:48.36,Default,,0,0,0,,Изуми мырза, қобалжыдыңыз ба?
Dialogue: 0,0:06:48.82,0:06:50.11,Default,,0,0,0,,Мен мұны істеп жатырмын
Dialogue: 0,0:06:50.20,0:06:52.37,Default,,0,0,0,,Өйткені бұл сынып презентациясы.
Dialogue: 0,0:06:52.95,0:06:54.08,Default,,0,0,0,,God!
Dialogue: 0,0:06:54.16,0:06:58.37,Default,,0,0,0,,Биыл да Шикимори-санмен бір сыныпта оқимын деп үміттенемін!
Dialogue: 0,0:06:58.45,0:07:00.16,Default,,0,0,0,,Не болды...
Dialogue: 0,0:07:00.62,0:07:02.46,Default,,0,0,0,,Не!
Dialogue: 0,0:07:02.54,0:07:06.13,Default,,0,0,0,,Хехе, көп намаз оқудың қажеті жоқ.
Dialogue: 0,0:07:06.80,0:07:10.84,Default,,0,0,0,,Өйткені мен Шикимори-санмен бір сыныпта болғым келеді.
Dialogue: 0,0:07:10.93,0:07:13.09,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:07:13.18,0:07:17.01,Default,,0,0,0,,Әртүрлі сыныпта болсақ та, мен сені әлі де көп көремін.
Dialogue: 0,0:07:17.10,0:07:18.35,Default,,0,0,0,,Сакуражима сенпай саған жек көреді. Мен солай десем, ол міндетті түрде мені ұрып жіберер еді.
Dialogue: 0,0:07:18.43,0:07:21.39,Default,,0,0,0,,Екі қолыңды тербе.
Dialogue: 0,0:07:25.86,0:07:27.53,Default,,0,0,0,,Менің атым...
Dialogue: 0,0:07:29.99,0:07:31.65,Default,,0,0,0,,4 топ болды!
Dialogue: 0,0:07:34.66,0:07:36.66,Default,,0,0,0,,Ол маған айтты
Dialogue: 0,0:07:37.33,0:07:39.29,Default,,0,0,0,,Шикимори-сан...
Dialogue: 0,0:07:45.79,0:07:47.04,Default,,0,0,0,,Ха! (Шикимори) Уау!
Dialogue: 0,0:07:47.13,0:07:49.67,Default,,0,0,0,,Біз бір сыныпта оқимыз, Шикимори мырза.
Dialogue: 0,0:07:49.76,0:07:51.42,Default,,0,0,0,,Қараңдар! Қараңдар!
Dialogue: 0,0:07:52.93,0:07:55.05,Default,,0,0,0,,Аа, бұл рас.
Dialogue: 0,0:07:55.14,0:07:57.56,Default,,0,0,0,,Құдайға шүкір!
Dialogue: 0,0:07:59.39,0:08:01.73,Default,,0,0,0,,Осы жылы қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:08:01.81,0:08:05.06,Default,,0,0,0,,Аа, көп рахмет.
Dialogue: 0,0:08:05.15,0:08:07.57,Default,,0,0,0,,Митчон!
Dialogue: 0,0:08:08.07,0:08:09.15,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:08:09.23,0:08:11.03,Default,,0,0,0,,Уау... мысық
Dialogue: 0,0:08:11.11,0:08:12.61,Default,,0,0,0,,Нхухухуху
Dialogue: 0,0:08:13.07,0:08:15.49,Default,,0,0,0,,Биылғыдай, Яман да!
Dialogue: 0,0:08:15.57,0:08:16.66,Default,,0,0,0,,Йоропи
Dialogue: 0,0:08:17.16,0:08:18.53,Default,,0,0,0,,Уау...
Dialogue: 0,0:08:18.62,0:08:20.12,Default,,0,0,0,,Суретке түсіріңіз!
Dialogue: 0,0:08:21.29,0:08:22.50,Default,,0,0,0,,Изуми!
Dialogue: 0,0:08:22.58,0:08:24.71,Default,,0,0,0,,Тағы да сол сынып.
Dialogue: 0,0:08:24.79,0:08:25.96,Default,,0,0,0,,Инузука-кун!
Dialogue: 0,0:08:26.04,0:08:27.00,Default,,0,0,0,,Хехе
Dialogue: 0,0:08:27.08,0:08:30.55,Default,,0,0,0,,Керемет, Инуцука-кун да 4-сыныпта оқиды.
Dialogue: 0,0:08:30.63,0:08:32.26,Default,,0,0,0,,Тағы бір жыл, рахмет
Dialogue: 0,0:08:32.34,0:08:33.34,Default,,0,0,0,,О
Dialogue: 0,0:08:33.88,0:08:35.38,Default,,0,0,0,,Шикимори да бірдей ме?
Dialogue: 0,0:08:35.47,0:08:37.39,Default,,0,0,0,,Эххе... иә
Dialogue: 0,0:08:38.01,0:08:40.56,Default,,0,0,0,,Шикимори-сан, кездескенше.
Dialogue: 0,0:08:40.64,0:08:41.64,Default,,0,0,0,,Иә
Dialogue: 0,0:08:43.39,0:08:46.35,Default,,0,0,0,,Мен бірге болғанымызға өте қуаныштымын.
Dialogue: 0,0:08:47.27,0:08:50.90,Default,,0,0,0,,Бірақ тым қатты толқыған мен ғана болдым...
Dialogue: 0,0:08:52.44,0:08:53.90,Default,,0,0,0,,Ах (Инузука) Иә?
Dialogue: 0,0:08:54.40,0:08:55.45,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:55.53,0:08:57.78,Default,,0,0,0,,Шикимори-сан, мен бүгін үйге бара жатырмын...
Dialogue: 0,0:08:58.74,0:09:01.79,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:09:01.87,0:09:03.54,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:09:03.62,0:09:04.87,Default,,0,0,0,,Шикимори мырза?
Dialogue: 0,0:09:04.96,0:09:05.79,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:06.54,0:09:09.63,Default,,0,0,0,,Ренжімеуге әлі ерте еді, Митхон.
Dialogue: 0,0:09:09.71,0:09:11.42,Default,,0,0,0,,Мен қатты толқып тұрмын
Dialogue: 0,0:09:16.93,0:09:20.89,Default,,0,0,0,,Бүгіннен бастап сіздердің бәріңіз де аға буын деп атауға лайықсыздар.
Dialogue: 0,0:09:21.64,0:09:24.93,Default,,0,0,0,,Ол мектептегі іс-шараларда да назар аударатын болады.
Dialogue: 0,0:09:25.43,0:09:27.60,Default,,0,0,0,,Жылды көңілді өткізейік
Dialogue: 0,0:09:28.06,0:09:30.23,Default,,0,0,0,,Танысқаныма қуаныштымын, кейбіреулеріңіз осында болуы мүмкін⸺
Dialogue: 0,0:09:30.31,0:09:32.98,Default,,0,0,0,,Өзіңізді қысқаша таныстыра аласыз ба?
Dialogue: 0,0:09:33.65,0:09:36.61,Default,,0,0,0,,Қатысу саны бойынша Изуми-кун
Dialogue: 0,0:09:36.70,0:09:38.11,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:39.82,0:09:41.53,Default,,0,0,0,,Бұл Джуми!
Dialogue: 0,0:09:41.62,0:09:43.87,Default,,0,0,0,,Қарап отырмасаң, байқамайсың.
Dialogue: 0,0:09:42.87,0:09:43.87,Default,,0,0,0,,Қанда!
Dialogue: 0,0:09:43.87,0:09:46.87,Default,,0,0,0,,Қарап отырмасаң, байқамайсың.
Dialogue: 0,0:09:48.25,0:09:51.50,Default,,0,0,0,,Бүгіннен бастап мен орта мектептің екінші курс студентімін.
Dialogue: 0,0:09:52.96,0:09:54.76,Default,,0,0,0,,Не? ше?
Dialogue: 0,0:09:54.84,0:09:57.76,Default,,0,0,0,,А, жоқ, мен...
Dialogue: 0,0:09:58.47,0:10:01.64,Default,,0,0,0,,Шикимори-сан мүлдем ашуланбайды, солай ма?
Dialogue: 0,0:10:02.51,0:10:05.02,Default,,0,0,0,,Сіз мұны қазір айтасыз ба?
Dialogue: 0,0:10:06.39,0:10:07.52,Default,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,0:10:09.19,0:10:10.02,Default,,0,0,0,,Ах
Dialogue: 0,0:10:15.07,0:10:15.90,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:10:15.99,0:10:16.82,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:20.53,0:10:22.87,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:10:22.95,0:10:23.99,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:10:24.08,0:10:25.37,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:10:25.45,0:10:27.16,Default,,0,0,0,,Жарайды
Dialogue: 0,0:10:27.25,0:10:30.00,Default,,0,0,0,,Изуми мырзаның зардап шекпегеніне қуаныштымын.
Dialogue: 0,0:10:33.54,0:10:35.42,Default,,0,0,0,,Мен әрқашан кешірім сұраймын
Dialogue: 0,0:10:39.55,0:10:42.43,Default,,0,0,0,,Эй... Мен оны әжетханаға тастаймын.
Dialogue: 0,0:10:42.93,0:10:44.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:44.22,0:10:45.64,Default,,0,0,0,,Изуми
Dialogue: 0,0:10:46.14,0:10:48.10,Default,,0,0,0,,Маған неге көрсетпейсің?
Dialogue: 0,0:10:48.18,0:10:49.60,Default,,0,0,0,,Мен қызғанамын
Dialogue: 0,0:10:49.69,0:10:52.40,Default,,0,0,0,,Бақытсыз конституцияға ие болу да қиын.
Dialogue: 0,0:10:53.06,0:10:55.15,Default,,0,0,0,,Ең алдымен қайдан пайда болды?
Dialogue: 0,0:10:55.23,0:10:56.44,Default,,0,0,0,,Тақтадағы өшіргіш
Dialogue: 0,0:10:56.53,0:10:57.53,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:10:58.07,0:10:59.57,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:10:59.65,0:11:02.45,Default,,0,0,0,,Сүйкімді қызыңды мазалама
Dialogue: 0,0:11:02.53,0:11:04.49,Default,,0,0,0,,Қиындыққа тап болма
Dialogue: 0,0:11:04.58,0:11:05.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:06.33,0:11:10.58,Default,,0,0,0,,Шикимори-сан, неге Изуми?
Dialogue: 0,0:11:10.66,0:11:12.42,Default,,0,0,0,,Изуми Бұл қарапайым.
Dialogue: 0,0:11:12.50,0:11:14.38,Default,,0,0,0,,Біз де емеспіз.
Dialogue: 0,0:11:14.46,0:11:16.96,Default,,0,0,0,,Қарғыс атқыр, мен қызғанамын.
Dialogue: 0,0:11:17.05,0:11:18.17,Default,,0,0,0,,Ах~
Dialogue: 0,0:11:18.26,0:11:20.13,Default,,0,0,0,,Нені және қалай істеуім керек?
Dialogue: 0,0:11:20.22,0:11:22.72,Default,,0,0,0,,Менің сондай сүйкімді қызым болуы мүмкін~
Dialogue: 0,0:11:21.47,0:11:22.72,Default,,0,0,0,,Аха…
Dialogue: 0,0:11:22.80,0:11:24.05,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:11:24.14,0:11:26.97,Default,,0,0,0,,(Дарио) Хе-хе-хе-хе. Эй, қарашы — бұл апат!
Dialogue: 0,0:11:26.26,0:11:28.47,Default,,0,0,0,,Изуми мырза, күткеніңізге рахмет.
Dialogue: 0,0:11:28.56,0:11:29.85,Default,,0,0,0,,Ұлы соғыс аяқталғаннан бері—
Dialogue: 0,0:11:30.31,0:11:32.06,Default,,0,0,0,,Шикимори-сан, жақсысың ба?
Dialogue: 0,0:11:32.14,0:11:33.15,Default,,0,0,0,,Иә
Dialogue: 0,0:11:33.23,0:11:36.98,Default,,0,0,0,,Изуми мырза, сіз мені бір сәтке кітапханаға ертіп бара аласыз ба?
Dialogue: 0,0:11:37.07,0:11:38.11,Default,,0,0,0,,Иә
Dialogue: 0,0:11:38.19,0:11:40.49,Default,,0,0,0,,Жоқ, сіз мұны естіген жоқсыз ба?
Dialogue: 0,0:11:40.57,0:11:42.24,Default,,0,0,0,,Жоқ... жақсы.
Dialogue: 0,0:11:47.58,0:11:50.00,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:11:50.08,0:11:51.66,Default,,0,0,0,,(есіктің тарс жабылған дыбысы)
Dialogue: 0,0:11:51.75,0:11:52.75,Default,,0,0,0,,Қорқынышты...
Dialogue: 0,0:11:52.83,0:11:53.71,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:11:53.79,0:11:56.04,Default,,0,0,0,,Әй... керемет
Dialogue: 0,0:11:58.96,0:12:02.97,Default,,0,0,0,,Мүмкін менің ойым тар шығар.
Dialogue: 0,0:12:03.05,0:12:06.05,Default,,0,0,0,,Иә? Мен солай ойламаймын.
Dialogue: 0,0:12:07.85,0:12:11.23,Default,,0,0,0,,Менің ойымша, бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:12:11.31,0:12:12.14,Default,,0,0,0,,Е...
Dialogue: 0,0:12:12.94,0:12:13.89,Default,,0,0,0,,Не?
Dialogue: 0,0:12:15.81,0:12:17.90,Default,,0,0,0,,Жоқ, ештеңе...
Dialogue: 0,0:12:19.61,0:12:21.82,Default,,0,0,0,,Менің дос қызым сүйкімді
Dialogue: 0,0:12:21.90,0:12:22.90,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:12:24.24,0:12:28.28,Default,,0,0,0,,Егер Шикимори-сан мен үшін жарақат алса...
Dialogue: 0,0:12:28.74,0:12:30.16,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:12:36.46,0:12:37.71,Default,,0,0,0,,Изуми!
Dialogue: 0,0:12:37.79,0:12:38.75,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:12:38.84,0:12:41.42,Default,,0,0,0,,Бүгін үйге бара жатқанда неге бір жерге тоқтамайсың?
Dialogue: 0,0:12:43.59,0:12:45.51,Default,,0,0,0,,Инузука-кун, сенің бүгін толық емес жұмысың жоқ па?
Dialogue: 0,0:12:46.26,0:12:47.43,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,0:12:47.89,0:12:50.51,Default,,0,0,0,,Демалыңыз! Жаңа оқу жылын атап өтуде.
Dialogue: 0,0:12:50.60,0:12:51.85,Default,,0,0,0,,Кеттік
Dialogue: 0,0:12:51.93,0:12:54.77,Default,,0,0,0,,Күткендей, сыртқы түріне қарамастан, оның көңіл-күйі жақсы!
Dialogue: 0,0:12:55.27,0:12:59.27,Default,,0,0,0,,Себебі мен Инузука-кунмен көбірек араласқым келді.
Dialogue: 0,0:13:00.65,0:13:02.03,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:03.11,0:13:04.90,Default,,0,0,0,,Мен Шикимори-санға айтамын.
Dialogue: 0,0:13:04.99,0:13:06.03,Default,,0,0,0,,О
Dialogue: 0,0:13:06.57,0:13:09.03,Default,,0,0,0,,А, Изуми мен басқалары да ойнай ма?
Dialogue: 0,0:13:09.12,0:13:11.99,Default,,0,0,0,,Аха, онда неге бәріміз бірге ойнамаймыз?
Dialogue: 0,0:13:12.08,0:13:14.08,Default,,0,0,0,,Достығымызды тереңдетеміз бе?
Dialogue: 0,0:13:14.16,0:13:15.66,Default,,0,0,0,,Шикимори-сан, жарай ма?
Dialogue: 0,0:13:15.75,0:13:18.04,Default,,0,0,0,,А... иә, әрине.
Dialogue: 0,0:13:18.54,0:13:20.00,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:13:20.09,0:13:22.51,Default,,0,0,0,,Уақыты келді…
Dialogue: 0,0:13:22.59,0:13:24.47,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:13:26.38,0:13:28.39,Default,,0,0,0,,Кінәсіздік
Dialogue: 0,0:13:28.47,0:13:30.22,Default,,0,0,0,,Бұл бонуспен бірге келеді.
Dialogue: 0,0:13:30.30,0:13:31.31,Default,,0,0,0,,Мен бе!
Dialogue: 0,0:13:31.39,0:13:34.31,Default,,0,0,0,,Әй, сендер де балалар!
Dialogue: 0,0:13:36.89,0:13:40.98,Default,,0,0,0,,Ең көп ұпай жинаған адам ұтылған сыйлықты алады.
Dialogue: 0,0:13:41.07,0:13:42.73,Default,,0,0,0,,Қабылдау және тұру
Dialogue: 0,0:13:42.82,0:13:45.32,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,0:13:45.40,0:13:46.99,Default,,0,0,0,,Мен мінбеймін.
Dialogue: 0,0:13:47.53,0:13:49.03,Default,,0,0,0,,Ұлы рух...
Dialogue: 0,0:13:49.11,0:13:51.12,Default,,0,0,0,,Сіз өте ынталысыз.
Dialogue: 0,0:13:52.03,0:13:54.75,Default,,0,0,0,,Шикимори-сан, сен боулинг ойнадың ба?
Dialogue: 0,0:13:54.83,0:13:56.16,Default,,0,0,0,,Көп емес...
Dialogue: 0,0:13:56.25,0:13:58.25,Default,,0,0,0,,Шамамен 2-3 рет
Dialogue: 0,0:13:58.33,0:14:00.50,Default,,0,0,0,,Мен де ұқсаспын
Dialogue: 0,0:14:01.38,0:14:02.63,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:14:04.96,0:14:07.13,Default,,0,0,0,,Бірақ мен оны асыға күтемін.
Dialogue: 0,0:14:10.97,0:14:14.06,Default,,0,0,0,,Мен... мен допты таңдаймын.
Dialogue: 0,0:14:14.60,0:14:16.06,Default,,0,0,0,,Кеттік, Инузука-кун.
Dialogue: 0,0:14:16.14,0:14:18.27,Default,,0,0,0,,А? кеттік
Dialogue: 0,0:14:18.35,0:14:19.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:20.10,0:14:21.52,Default,,0,0,0,,Митхон
Dialogue: 0,0:14:22.44,0:14:24.98,Default,,0,0,0,,Бұл сіздің мүмкіндігіңіз, Митхон.
Dialogue: 0,0:14:25.07,0:14:26.40,Default,,0,0,0,,Мүмкіндік пе?
Dialogue: 0,0:14:26.49,0:14:27.99,Default,,0,0,0,,Бұл ақылсыз
Dialogue: 0,0:14:28.07,0:14:30.32,Default,,0,0,0,,Боулингте жақсы емес екеніңізді көрсетіңіз
Dialogue: 0,0:14:30.41,0:14:33.12,Default,,0,0,0,,Мен Карепиге гүл сыйлаймын.
Dialogue: 0,0:14:33.20,0:14:35.29,Default,,0,0,0,,Ка… Karepi?
Dialogue: 0,0:14:35.37,0:14:37.54,Default,,0,0,0,,Бірақ мен оны жаман деп көрсете алмаймын...
Dialogue: 0,0:14:37.62,0:14:41.38,Default,,0,0,0,,Әйелдің «жамандығын» «сүйкімді» деп аударуға болады.
Dialogue: 0,0:14:41.46,0:14:43.67,Default,,0,0,0,,Жарайды, бастайық!
Dialogue: 0,0:14:43.75,0:14:45.25,Default,,0,0,0,,Біріншіден, мен.
Dialogue: 0,0:14:45.96,0:14:47.63,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:48.63,0:14:49.88,Default,,0,0,0,,Эй!
Dialogue: 0,0:14:51.97,0:14:53.22,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:14:53.30,0:14:55.76,Default,,0,0,0,,Бірінші рет соғу мүмкін емес пе?
Dialogue: 0,0:14:56.27,0:14:57.77,Default,,0,0,0,,(түйреуіш құлаған дыбыс)
Dialogue: 0,0:14:58.73,0:15:01.02,Default,,0,0,0,,Ой... өте жақсы.
Dialogue: 0,0:15:01.10,0:15:02.40,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:15:03.86,0:15:06.03,Default,,0,0,0,,Ууууууууууууу!
Dialogue: 0,0:15:09.53,0:15:11.16,Default,,0,0,0,,Угах!
Dialogue: 0,0:15:11.24,0:15:12.99,Default,,0,0,0,,Некозаки шулы
Dialogue: 0,0:15:13.07,0:15:14.91,Default,,0,0,0,,Істікті сындырмаңыз
Dialogue: 0,0:15:15.49,0:15:20.37,Default,,0,0,0,,А... у... у... у...
Dialogue: 0,0:15:21.04,0:15:25.21,Default,,0,0,0,,Хе... хе... хе...
Dialogue: 0,0:15:27.30,0:15:28.80,Default,,0,0,0,,Ммм
Dialogue: 0,0:15:29.26,0:15:30.26,Default,,0,0,0,,Сейцу
Dialogue: 0,0:15:35.14,0:15:36.22,Default,,0,0,0,,Баяу…
Dialogue: 0,0:15:42.94,0:15:44.19,Default,,0,0,0,,Не!?
Dialogue: 0,0:15:44.69,0:15:45.69,Default,,0,0,0,,Хмм
Dialogue: 0,0:15:45.77,0:15:47.48,Default,,0,0,0,,Яман мырза керемет!
Dialogue: 0,0:15:50.11,0:15:51.49,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:52.99,0:15:54.11,Default,,0,0,0,,Шикимори-сан?
Dialogue: 0,0:15:54.20,0:15:56.12,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:56.20,0:15:57.37,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:57.45,0:15:58.58,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:15:59.29,0:16:01.91,Default,,0,0,0,,Өйткені, сүйкімді жақсырақ...
Dialogue: 0,0:16:00.45,0:16:02.33,Default,,0,0,0,,Жоқ, Яман...
Dialogue: 0,0:16:02.41,0:16:03.87,Default,,0,0,0,,Не? Не? Тұтқындау!
Dialogue: 0,0:16:04.54,0:16:06.04,Default,,0,0,0,,Келесі Изуми Ике
Dialogue: 0,0:16:06.59,0:16:08.38,Default,,0,0,0,,А, бірақ...
Dialogue: 0,0:16:08.46,0:16:10.30,Default,,0,0,0,,Mr. Izumi, please go.
Dialogue: 0,0:16:11.55,0:16:12.55,Default,,0,0,0,,Иә
Dialogue: 0,0:16:13.47,0:16:14.68,Default,,0,0,0,,Ei
Dialogue: 0,0:16:16.85,0:16:18.43,Default,,0,0,0,,Осылай жалғастыруым керек пе?
Dialogue: 0,0:16:21.73,0:16:23.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:23.89,0:16:25.10,Default,,0,0,0,,Ei
Dialogue: 0,0:16:29.78,0:16:31.94,Default,,0,0,0,,On the contrary, it’s a miracle.
Dialogue: 0,0:16:32.03,0:16:34.78,Default,,0,0,0,,It's just as expected haha...
Dialogue: 0,0:16:34.86,0:16:36.95,Default,,0,0,0,,Доп өздігінен иіледі...
Dialogue: 0,0:16:37.53,0:16:39.20,Default,,0,0,0,,Келесі Шикимори
Dialogue: 0,0:16:39.95,0:16:41.20,Default,,0,0,0,,Михон
Dialogue: 0,0:16:41.66,0:16:43.08,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:16:43.16,0:16:45.96,Default,,0,0,0,,Сіз Карепи сізді сүйкімді деп атағанын қалайсыз, солай ма?
Dialogue: 0,0:16:46.04,0:16:47.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:49.75,0:16:51.05,Default,,0,0,0,,Өте сүйкімді...
Dialogue: 0,0:16:52.42,0:16:53.88,Default,,0,0,0,,I want to be told...
Dialogue: 0,0:16:53.97,0:16:56.55,Default,,0,0,0,,I want to be called cute
Dialogue: 0,0:17:00.06,0:17:01.52,Default,,0,0,0,,Шикимори-сан!
Dialogue: 0,0:17:02.43,0:17:03.89,Default,,0,0,0,,Сәттілік тілеймін!
Dialogue: 0,0:17:23.37,0:17:24.91,Default,,0,0,0,,Эй, бұл...
Dialogue: 0,0:17:25.00,0:17:27.00,Default,,0,0,0,,Тағы бір Қан Құбыжық Өнері ме?
Dialogue: 0,0:17:27.08,0:17:28.79,Default,,0,0,0,,Let's make it perfect
Dialogue: 0,0:17:29.29,0:17:30.67,Default,,0,0,0,,Не, бұл өтірік!
Dialogue: 0,0:17:30.75,0:17:32.55,Default,,0,0,0,,Шынайы ма? Керемет!
Dialogue: 0,0:17:32.63,0:17:33.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:33.67,0:17:35.63,Default,,0,0,0,,– деді Джосукэ Хигасиката. Гү…
Dialogue: 0,0:17:35.72,0:17:38.05,Default,,0,0,0,,Is this guy a monster?
Dialogue: 0,0:17:41.14,0:17:46.06,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:17:50.36,0:17:51.61,Default,,0,0,0,,Фу…
Dialogue: 0,0:17:52.36,0:17:54.49,Default,,0,0,0,,Немесе... тамаша!
Dialogue: 0,0:17:54.57,0:17:55.99,Default,,0,0,0,,Изуми мырзаның қолы
Dialogue: 0,0:17:56.07,0:17:57.20,Default,,0,0,0,,Е...
Dialogue: 0,0:17:57.28,0:17:58.78,Default,,0,0,0,,Бұл... осылай ма?
Dialogue: 0,0:17:58.86,0:18:00.62,Default,,0,0,0,,Мен жасадым!
Dialogue: 0,0:18:01.74,0:18:03.54,Default,,0,0,0,,Уау~
Dialogue: 0,0:18:03.62,0:18:05.91,Default,,0,0,0,,As expected, it's cute!
Dialogue: 0,0:18:06.46,0:18:09.75,Default,,0,0,0,,Күшті адамның қорықпайтын күлкісі сияқты...
Dialogue: 0,0:18:09.83,0:18:11.25,Default,,0,0,0,,Сіз кімсіз...
Dialogue: 0,0:18:11.71,0:18:14.67,Default,,0,0,0,,Сіз сүйкімді емес, салқынды таңдадыңыз ба?
Dialogue: 0,0:18:19.76,0:18:21.35,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:18:21.43,0:18:23.01,Default,,0,0,0,,Биби!
Dialogue: 0,0:18:23.10,0:18:24.68,Default,,0,0,0,,Adieu
Dialogue: 0,0:18:30.27,0:18:31.73,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:18:31.81,0:18:34.86,Default,,0,0,0,,Жеңілген адам тамақты бірінші орындағы адамға береді, солай ма?
Dialogue: 0,0:18:34.94,0:18:37.19,Default,,0,0,0,,Ah... that's fine.
Dialogue: 0,0:18:37.28,0:18:39.03,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:18:39.53,0:18:42.20,Default,,0,0,0,,Then please come home with me.
Dialogue: 0,0:18:42.28,0:18:43.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:43.78,0:18:46.95,Default,,0,0,0,,But that's what I always do...
Dialogue: 0,0:18:47.04,0:18:49.25,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:18:53.50,0:18:56.42,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:18:57.34,0:18:59.84,Default,,0,0,0,,Wow... Wow, it's windy!
Dialogue: 0,0:18:59.93,0:19:02.97,Default,,0,0,0,,Ahaha, your hair looks weird.
Dialogue: 0,0:19:03.05,0:19:04.93,Default,,0,0,0,,Even Shikimori-san
Dialogue: 0,0:19:05.01,0:19:06.22,Default,,0,0,0,,Уау
Dialogue: 0,0:19:06.31,0:19:10.69,Default,,0,0,0,,Бос банкалар мен басқа да заттар біраздан бері маған ұшып жүр.
Dialogue: 0,0:19:10.77,0:19:12.35,Default,,0,0,0,,Изуми мырзаға
Dialogue: 0,0:19:12.44,0:19:13.69,Default,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,0:19:13.77,0:19:17.36,Default,,0,0,0,,(Қатты желдің дыбысы)
Dialogue: 0,0:19:17.94,0:19:18.94,Default,,0,0,0,,Әй, жанымнан кетпе!
Dialogue: 0,0:19:20.90,0:19:22.36,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:19:22.45,0:19:23.87,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:19:24.62,0:19:28.54,Default,,0,0,0,,Қалайша газеттерді көз ілмей қабылдайды екен...
Dialogue: 0,0:19:28.62,0:19:29.87,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:19:31.79,0:19:33.79,Default,,0,0,0,,Thank you Shikimori-san
Dialogue: 0,0:19:33.88,0:19:35.63,Default,,0,0,0,,True, I'm always sorry.
Dialogue: 0,0:19:37.21,0:19:41.13,Default,,0,0,0,,Сіз әрқашан өкінудің қажеті жоқ деп айтасыз.
Dialogue: 0,0:19:41.22,0:19:42.63,Default,,0,0,0,,Ой, кешіріңіз...
Dialogue: 0,0:19:42.72,0:19:43.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:44.14,0:19:45.51,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:19:45.97,0:19:48.18,Default,,0,0,0,,Мұндай жағдай үнемі болып тұрады.
Dialogue: 0,0:19:48.27,0:19:49.85,Default,,0,0,0,,Бірлесіп әрекет етіп жатыр ма?
Dialogue: 0,0:19:51.81,0:19:55.11,Default,,0,0,0,,Бірақ мені әрқашан қорғауды сұрайды...
Dialogue: 0,0:19:55.19,0:19:56.69,Default,,0,0,0,,Бұл аянышты
Dialogue: 0,0:20:01.86,0:20:02.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:04.32,0:20:05.82,Default,,0,0,0,,Шикимори-сан?
Dialogue: 0,0:20:06.87,0:20:09.16,Default,,0,0,0,,Бүгін мені сыныптасым мазақ етті⸺
Dialogue: 0,0:20:09.24,0:20:10.75,Default,,0,0,0,,Саған бәрібір?
Dialogue: 0,0:20:11.50,0:20:13.08,Default,,0,0,0,,Сондықтан олар жауапкершілікті маған жүктеді.
Dialogue: 0,0:20:13.17,0:20:15.25,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:20:15.33,0:20:19.50,Default,,0,0,0,,Мен Шикимори-сан үшін ештеңе істеген жоқпын...
Dialogue: 0,0:20:22.09,0:20:24.76,Default,,0,0,0,,Осы қарқынмен мен...
Dialogue: 0,0:20:26.09,0:20:27.51,Default,,0,0,0,,Ха…
Dialogue: 0,0:20:36.36,0:20:37.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:39.94,0:20:41.61,Default,,0,0,0,,Изуми мырза...
Dialogue: 0,0:20:47.62,0:20:50.45,Default,,0,0,0,,Мәңгілік қасымда бол
Dialogue: 0,0:20:51.16,0:20:55.29,Default,,0,0,0,,Мен үшін адамдардың не айтатыны маңызды емес.
Dialogue: 0,0:20:55.37,0:20:59.42,Default,,0,0,0,,Мен Изуми-санды рұқсатсыз қорғауды жалғастырамын.
Dialogue: 0,0:21:02.84,0:21:06.05,Default,,0,0,0,,Күткендей, менің дос қызым керемет.
Dialogue: 0,0:21:06.55,0:21:08.30,Default,,0,0,0,,Ол...
Dialogue: 0,0:21:08.39,0:21:09.39,Default,,0,0,0,,Ұнады
Dialogue: 0,0:21:09.47,0:21:11.31,Default,,0,0,0,,Не… неге бұл уақыт!?
Dialogue: 0,0:21:15.56,0:21:17.77,Default,,0,0,0,,А-а, сен зардап шеккен жоқсың ба?
Dialogue: 0,0:21:17.85,0:21:19.52,Default,,0,0,0,,Аяқтар жақсы ма?
Dialogue: 0,0:21:19.61,0:21:20.48,Default,,0,0,0,,Иә!?
Dialogue: 0,0:21:20.57,0:21:23.49,Default,,0,0,0,,Ах... ха... Иә, менде бәрі жақсы.
Dialogue: 0,0:21:24.36,0:21:26.24,Default,,0,0,0,,Бұрын бұл таңқаларлық еді.
Dialogue: 0,0:21:26.32,0:21:27.82,Default,,0,0,0,,Не айтайын, бұл...
Dialogue: 0,0:21:27.91,0:21:28.74,Default,,0,0,0,,А...
Dialogue: 0,0:21:28.82,0:21:30.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:30.24,0:21:32.12,Default,,0,0,0,,Кездейсоқ Кездейсоқ!
Dialogue: 0,0:21:32.20,0:21:33.20,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:34.25,0:21:35.25,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:21:35.33,0:21:37.12,Default,,0,0,0,,Эххе... иә
Dialogue: 0,0:21:37.58,0:21:38.50,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:21:38.58,0:21:40.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:40.46,0:21:43.51,Default,,0,0,0,,О... шынымен, шынымен, жарайды!
Dialogue: 0,0:21:43.59,0:21:45.63,Default,,0,0,0,,Изуми-сан жақсы ма?
Dialogue: 0,0:21:45.72,0:21:47.09,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:21:47.18,0:21:48.72,Default,,0,0,0,,Шикимори-санға рахмет.
Dialogue: 0,0:21:48.80,0:21:50.76,Default,,0,0,0,,Күрсін... Жақсы.
Dialogue: 0,0:21:50.85,0:21:52.31,Default,,0,0,0,,Эххе
Dialogue: 0,0:21:55.73,0:22:00.52,Default,,0,0,0,,♪~
Dialogue: 0,0:23:20.39,0:23:24.90,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.40,0:23:31.40,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
