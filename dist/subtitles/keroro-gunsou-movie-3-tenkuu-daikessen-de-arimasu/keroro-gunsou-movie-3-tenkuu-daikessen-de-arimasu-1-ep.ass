Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:39.66,0:00:41.54,Default,,0,0,0,,Керон әскери штабынан хабарландыру
Dialogue: 0,0:00:45.54,0:00:46.83,Default,,0,0,0,,Кероро взводы
Dialogue: 0,0:00:46.92,0:00:50.92,Default,,0,0,0,,Сенгоку Ран Жұлдызын басқаратын Муша Виперді жеңіңіз
Dialogue: 0,0:00:51.00,0:00:52.59,Default,,0,0,0,,Халықты азат ету
Dialogue: 0,0:01:05.19,0:01:06.56,Default,,0,0,0,,Аспазшы~
Dialogue: 0,0:01:14.69,0:01:15.53,Default,,0,0,0,,«Муша Керо»
Dialogue: 0,0:01:15.61,0:01:18.70,Default,,0,0,0,,"Ашылып жатыр! Сенгоку Ран жұлдызды тамаша шайқас!!"
Dialogue: 0,0:01:20.66,0:01:22.49,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:25.87,0:01:27.08,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:01:28.50,0:01:30.71,Default,,0,0,0,,Неліктен мұндай жұлдыз...
Dialogue: 0,0:01:30.79,0:01:33.71,Default,,0,0,0,,Бұл сіз Пекопон шапқыншылығын әлсіреткендіктен болады.
Dialogue: 0,0:01:33.80,0:01:36.01,Default,,0,0,0,,- Капитан! -Хмм?
Dialogue: 0,0:01:37.47,0:01:39.68,Default,,0,0,0,,Мен аймақты зерттеймін.
Dialogue: 0,0:01:39.76,0:01:40.93,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:43.18,0:01:44.72,Default,,0,0,0,,Жанды
Dialogue: 0,0:01:44.81,0:01:47.14,Default,,0,0,0,,Ол бұл планетамен таныс.
Dialogue: 0,0:01:47.23,0:01:50.02,Default,,0,0,0,,Көлеңке қараңғы, Аспаз~!
Dialogue: 0,0:01:50.11,0:01:52.44,Default,,0,0,0,,-Ах! - Құсу?
Dialogue: 0,0:01:52.52,0:01:54.57,Default,,0,0,0,,Бұл данго. Бұл данго.
Dialogue: 0,0:01:54.65,0:01:56.32,Default,,0,0,0,,Данго~!
Dialogue: 0,0:01:56.40,0:01:59.07,Default,,0,0,0,,О, мен де!
Dialogue: 0,0:01:59.16,0:02:01.57,Default,,0,0,0,,Бұл... жанды.
Dialogue: 0,0:02:02.70,0:02:04.58,Default,,0,0,0,,Тоқаш, өтінемін
Dialogue: 0,0:02:04.66,0:02:06.20,Default,,0,0,0,,Иә
Dialogue: 0,0:02:09.08,0:02:10.00,Default,,0,0,0,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:02:10.08,0:02:11.25,Default,,0,0,0,,-Аа? -Гах
Dialogue: 0,0:02:11.33,0:02:13.59,Default,,0,0,0,,-Фуну? - Лорд More?
Dialogue: 0,0:02:14.96,0:02:18.09,Default,,0,0,0,,Моа-доно осында болса, Муша Жылан болмас еді...
Dialogue: 0,0:02:25.77,0:02:27.23,Default,,0,0,0,,Айналмалы
Dialogue: 0,0:02:27.31,0:02:28.98,Default,,0,0,0,,Бақытты
Dialogue: 0,0:02:29.06,0:02:30.31,Default,,0,0,0,,Қанша тұшпара?
Dialogue: 0,0:02:30.40,0:02:32.65,Default,,0,0,0,,- Маған карри беріңіз - Бар ма?
Dialogue: 0,0:02:32.73,0:02:33.40,Default,,0,0,0,,Құсу?
Dialogue: 0,0:02:33.48,0:02:35.69,Default,,0,0,0,,Негізі ауыл қызы А солай істейді.
Dialogue: 0,0:02:35.78,0:02:37.11,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:02:37.19,0:02:40.86,Default,,0,0,0,,Жылан жауынгер ауыл қызын ұрлауға келді!
Dialogue: 0,0:02:40.95,0:02:44.03,Default,,0,0,0,,-Не? - Бұл бір түрлі нобай...
Dialogue: 0,0:02:45.24,0:02:47.20,Default,,0,0,0,,Сен де тез қашу керек!
Dialogue: 0,0:02:47.29,0:02:48.91,Default,,0,0,0,,Ой, Құдай-ай, осы асыл кітаптарды былыққа қалдырып кеткенсіңдер…
Dialogue: 0,0:02:51.12,0:02:52.92,Default,,0,0,0,,​​О?
Dialogue: 0,0:02:54.79,0:02:56.84,Default,,0,0,0,,Муша Жыланның көмекшілері
Dialogue: 0,0:02:56.92,0:02:57.71,Default,,0,0,0,,...
Dialogue: 0,0:02:57.80,0:02:58.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:58.46,0:03:01.43,Default,,0,0,0,,Сол жігіттер, Моа-доно болса ғой.
Dialogue: 0,0:03:01.93,0:03:02.72,Default,,0,0,0,,Хехе
Dialogue: 0,0:03:03.47,0:03:06.81,Default,,0,0,0,,Баршаңызға, бұл шешуші шайқас!
Dialogue: 0,0:03:07.31,0:03:07.97,Default,,0,0,0,,Алу…
Dialogue: 0,0:03:08.06,0:03:09.98,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:03:11.39,0:03:12.85,Default,,0,0,0,,Ол сонда бетінде ақымақтай күлкімен тұрып тұр, бір дюймге де қозғалмайды! Бұл Шинсоның Қвиркі ме?
Dialogue: 0,0:03:13.52,0:03:15.98,Default,,0,0,0,,-Кеттік! -Иә!
Dialogue: 0,0:03:16.07,0:03:17.61,Default,,0,0,0,,Нух...
Dialogue: 0,0:03:19.65,0:03:21.95,Default,,0,0,0,,Нуо... Қарғыс атсын!
Dialogue: 0,0:03:23.28,0:03:24.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:25.58,0:03:26.66,Default,,0,0,0,,Ти!
Dialogue: 0,0:03:27.16,0:03:29.20,Default,,0,0,0,,Тааааа!
Dialogue: 0,0:03:29.29,0:03:30.71,Default,,0,0,0,,Атататата!
Dialogue: 0,0:03:31.50,0:03:32.71,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:33.79,0:03:35.67,Default,,0,0,0,,Ах... хмм!
Dialogue: 0,0:03:35.75,0:03:37.88,Default,,0,0,0,,- (Миньондар) Не! -Ол қалай?
Dialogue: 0,0:03:39.01,0:03:39.71,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:03:40.97,0:03:41.51,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:03:41.59,0:03:42.88,Default,,0,0,0,,Не? Апыр-ай!
Dialogue: 0,0:03:42.97,0:03:45.47,Default,,0,0,0,,-Тамаша! -Жақсы!
Dialogue: 0,0:03:45.55,0:03:46.10,Default,,0,0,0,,Құсу?
Dialogue: 0,0:03:46.18,0:03:48.60,Default,,0,0,0,,-Ой! -иә?
Dialogue: 0,0:03:48.68,0:03:51.43,Default,,0,0,0,,Шегін! Шегіну!
Dialogue: 0,0:03:51.52,0:03:53.02,Default,,0,0,0,,Итататата...
Dialogue: 0,0:03:53.10,0:03:55.56,Default,,0,0,0,,- Түтін экраны? - Алақай!
Dialogue: 0,0:03:55.65,0:03:57.15,Default,,0,0,0,,Бірдеңе келе жатыр
Dialogue: 0,0:03:57.23,0:03:58.69,Default,,0,0,0,,-Хмм? - Құсу?
Dialogue: 0,0:04:02.28,0:04:03.95,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:04:10.04,0:04:12.96,Default,,0,0,0,,-Қяаааа! -Бұл не?
Dialogue: 0,0:04:13.96,0:04:16.42,Default,,0,0,0,,Мен сендерді көруге дағдыланбадым, керондықтар.
Dialogue: 0,0:04:16.50,0:04:17.96,Default,,0,0,0,,кедергі жасау
Dialogue: 0,0:04:19.21,0:04:21.38,Default,,0,0,0,,Муша жылан
Dialogue: 0,0:04:21.46,0:04:24.01,Default,,0,0,0,,А, мен мұндай механизм бар екеніне сене алмаймын...
Dialogue: 0,0:04:24.51,0:04:26.01,Default,,0,0,0,,Мен тыңдамаймын!
Dialogue: 0,0:04:26.09,0:04:27.80,Default,,0,0,0,,Бірақ тек
Dialogue: 0,0:04:28.47,0:04:30.97,Default,,0,0,0,,Апокалипсис шабуылы өтінемін!
Dialogue: 0,0:04:31.56,0:04:33.89,Default,,0,0,0,,Не? Мм... иә
Dialogue: 0,0:04:34.60,0:04:37.40,Default,,0,0,0,,Мынадай, былай...
Dialogue: 0,0:04:38.06,0:04:39.27,Default,,0,0,0,,Бір қадам жоғары!
Dialogue: 0,0:04:39.36,0:04:40.98,Default,,0,0,0,,Ах, рахмет
Dialogue: 0,0:04:41.48,0:04:44.11,Default,,0,0,0,,Бұл не? Бұл
Dialogue: 0,0:04:44.20,0:04:46.41,Default,,0,0,0,,Мен түсінбедім, қария.
Dialogue: 0,0:04:46.49,0:04:49.24,Default,,0,0,0,,Мен оған жүрегімді салдым! Хагемарудон
Dialogue: 0,0:04:49.74,0:04:52.12,Default,,0,0,0,,Бұл... Хагемару-дон ма?
Dialogue: 0,0:04:52.62,0:04:53.91,Default,,0,0,0,,Дәлірек айтсақ, қария ма?
Dialogue: 0,0:04:54.00,0:04:56.21,Default,,0,0,0,,Бұл адам Мо-доно!
Dialogue: 0,0:04:56.29,0:04:58.08,Default,,0,0,0,,Мен мұны ақыры түсіндім, сондықтан солай деп ойлаймын.
Dialogue: 0,0:04:58.17,0:05:01.05,Default,,0,0,0,,Га~рагарагара~ Гала!
Dialogue: 0,0:05:01.13,0:05:03.67,Default,,0,0,0,,Ол өте сүйкімді қыз, солай емес пе?
Dialogue: 0,0:05:03.76,0:05:05.68,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,0:05:05.76,0:05:06.97,Default,,0,0,0,,Гү…
Dialogue: 0,0:05:08.26,0:05:09.47,Default,,0,0,0,,- Уф! -Пото...
Dialogue: 0,0:05:09.97,0:05:10.64,Default,,0,0,0,,-Сәлем! - Гуе!
Dialogue: 0,0:05:10.72,0:05:13.39,Default,,0,0,0,,- (Муша жылан) Чит - (Тамама Кероро) Нувааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:05:13.47,0:05:15.60,Default,,0,0,0,,-Жоқ! - Құсу!
Dialogue: 0,0:05:16.10,0:05:17.44,Default,,0,0,0,,Қария!
Dialogue: 0,0:05:17.52,0:05:18.86,Default,,0,0,0,,Кероро! Тамама!
Dialogue: 0,0:05:18.94,0:05:20.61,Default,,0,0,0,,(Кероро мен Тамаманың айқайы)
Dialogue: 0,0:05:20.69,0:05:22.07,Default,,0,0,0,,-Геротто -Тама!
Dialogue: 0,0:05:22.57,0:05:23.11,Default,,0,0,0,,Құсу?
Dialogue: 0,0:05:26.70,0:05:28.11,Default,,0,0,0,,Міне!
Dialogue: 0,0:05:37.25,0:05:38.50,Default,,0,0,0,,Не? Бұл
Dialogue: 0,0:05:38.58,0:05:39.63,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:39.71,0:05:40.88,Default,,0,0,0,,Ату!
Dialogue: 0,0:05:40.96,0:05:42.00,Default,,0,0,0,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,0:05:47.47,0:05:49.05,Default,,0,0,0,,Га~рагарагара!
Dialogue: 0,0:05:50.47,0:05:53.43,Default,,0,0,0,,Отбасыма…
Dialogue: 0,0:05:57.73,0:05:59.52,Default,,0,0,0,,Уау...
Dialogue: 0,0:05:59.60,0:06:01.15,Default,,0,0,0,,Ға~рағала...
Dialogue: 0,0:06:02.48,0:06:05.03,Default,,0,0,0,,О, бұл…
Dialogue: 0,0:06:06.61,0:06:09.32,Default,,0,0,0,,Не… не болды?
Dialogue: 0,0:06:09.41,0:06:11.28,Default,,0,0,0,,Бұл болмас еді...
Dialogue: 0,0:06:11.37,0:06:12.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:13.12,0:06:14.54,Default,,0,0,0,,Гү…
Dialogue: 0,0:06:14.62,0:06:15.20,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:06:19.83,0:06:20.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:22.84,0:06:25.05,Default,,0,0,0,,Кешіріңіз, кешігіп қалдым... Уф!
Dialogue: 0,0:06:25.13,0:06:27.80,Default,,0,0,0,,До... Дороро, келдің бе?
Dialogue: 0,0:06:29.09,0:06:31.18,Default,,0,0,0,,Бұл қиын...
Dialogue: 0,0:06:31.26,0:06:34.14,Default,,0,0,0,,Ахаха, пухжоб өте сәтті болды!
Dialogue: 0,0:06:34.22,0:06:35.93,Default,,0,0,0,,Бір минут күте тұрыңыз!
Dialogue: 0,0:06:36.02,0:06:38.10,Default,,0,0,0,,Маған қызды беріңіз
Dialogue: 0,0:06:38.18,0:06:41.35,Default,,0,0,0,,Маған бермесең, мына жігіт өледі.
Dialogue: 0,0:06:41.44,0:06:43.56,Default,,0,0,0,,А, мен қамауға алындым.
Dialogue: 0,0:06:44.19,0:06:45.48,Default,,0,0,0,,Сержант Крулл!
Dialogue: 0,0:06:45.57,0:06:46.44,Default,,0,0,0,,А, қазірдің өзінде...
Dialogue: 0,0:06:46.53,0:06:49.95,Default,,0,0,0,,Gara Garaga Garan Star
Dialogue: 0,0:06:50.03,0:06:51.95,Default,,0,0,0,,Бұл менің жеңісім.
Dialogue: 0,0:06:52.03,0:06:53.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:53.41,0:06:55.37,Default,,0,0,0,,Барымта болу – қорқақтық.
Dialogue: 0,0:06:55.45,0:06:57.41,Default,,0,0,0,,Шулы
Dialogue: 0,0:06:57.50,0:06:59.25,Default,,0,0,0,,Қалағаныңызды алыңыз
Dialogue: 0,0:07:00.08,0:07:02.63,Default,,0,0,0,,Мен бәрін істеймін!
Dialogue: 0,0:07:03.50,0:07:04.63,Default,,0,0,0,,Мен...
Dialogue: 0,0:07:04.71,0:07:08.76,Default,,0,0,0,,Енді не болды? қызыңды маған бер
Dialogue: 0,0:07:09.38,0:07:11.47,Default,,0,0,0,,А... Мен көмектесе алмаймын.
Dialogue: 0,0:07:11.55,0:07:15.47,Default,,0,0,0,,-Куруру-дононы кешіріңіз, бірақ -бұл қыз үшін.
Dialogue: 0,0:07:15.56,0:07:17.22,Default,,0,0,0,,Мен сені құрбандыққа шалуыңды сұраймын.
Dialogue: 0,0:07:17.31,0:07:18.72,Default,,0,0,0,,- (Муша жылан) Иә? -Аа, анау...
Dialogue: 0,0:07:18.81,0:07:21.89,Default,,0,0,0,,Әй... Әй, не айтып тұрсың!
Dialogue: 0,0:07:21.98,0:07:23.98,Default,,0,0,0,,Бұл жігітке не болу керек?
Dialogue: 0,0:07:24.06,0:07:25.40,Default,,0,0,0,,хм/сағ с/сағ♪
Dialogue: 0,0:07:25.48,0:07:26.94,Default,,0,0,0,,Гарн
Dialogue: 0,0:07:27.02,0:07:28.23,Default,,0,0,0,,Тітіркендіргіш~
Dialogue: 0,0:07:28.32,0:07:29.07,Default,,0,0,0,,Хмм.
Dialogue: 0,0:07:29.99,0:07:33.32,Default,,0,0,0,,(Кероро мен оның достары ызылдайды)
Dialogue: 0,0:07:34.91,0:07:37.74,Default,,0,0,0,,Түн ортасында әлі де 36 сағат.
Dialogue: 0,0:07:37.83,0:07:41.25,Default,,0,0,0,,Ащы! Ащы ащы ащы!
Dialogue: 0,0:07:41.83,0:07:43.12,Default,,0,0,0,,Хагемарудон?
Dialogue: 0,0:07:43.21,0:07:45.42,Default,,0,0,0,,Жоқ, олар карри жоқ дейді.
Dialogue: 0,0:07:46.09,0:07:48.42,Default,,0,0,0,,Мен өте дәмді карри жасап көрдім.
Dialogue: 0,0:07:48.50,0:07:49.71,Default,,0,0,0,,Қазір!
Dialogue: 0,0:07:49.80,0:07:50.92,Default,,0,0,0,,Ааах— сол сұм!
Dialogue: 0,0:07:51.01,0:07:52.93,Default,,0,0,0,,Шатаспаңыз!
Dialogue: 0,0:07:53.01,0:07:54.43,Default,,0,0,0,,Маған мұны істеуге рұқсат етіңіз!
Dialogue: 0,0:07:54.51,0:07:55.68,Default,,0,0,0,,Гррр…
Dialogue: 0,0:07:57.39,0:07:59.02,Default,,0,0,0,,Кероро взводы
Dialogue: 0,0:08:01.02,0:08:02.52,Default,,0,0,0,,Реактивті шабуыл!
Dialogue: 0,0:08:07.02,0:08:08.94,Default,,0,0,0,,- Шинобу! -Хаа!
Dialogue: 0,0:08:09.03,0:08:10.53,Default,,0,0,0,,Сәттілік немесе сәтсіздік!
Dialogue: 0,0:08:18.03,0:08:22.62,Default,,0,0,0,,Жарайды... Маған бұлай жасайды деп ойламаппын.
Dialogue: 0,0:08:30.09,0:08:31.09,Default,,0,0,0,,-Ах -Кяа!
Dialogue: 0,0:08:33.01,0:08:35.18,Default,,0,0,0,,Мені жұмыс тәжірибесіне тағайындаған Төртінші Түр мырза—
Dialogue: 0,0:08:35.26,0:08:36.72,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:08:36.80,0:08:39.81,Default,,0,0,0,,Мені артта қалдырма!
Dialogue: 0,0:08:40.97,0:08:45.10,Default,,0,0,0,,Енді мәселе шешілді!
Dialogue: 0,0:08:53.15,0:08:55.70,Default,,0,0,0,,Балалар сендер мықтысыңдар.
Dialogue: 0,0:08:55.78,0:09:00.16,Default,,0,0,0,,Бұл соншалықты үлкен мәселе емес.
Dialogue: 0,0:09:01.66,0:09:02.29,Default,,0,0,0,,Құсу?
Dialogue: 0,0:09:08.25,0:09:11.63,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:09:12.38,0:09:15.59,Default,,0,0,0,,Ең жас жауынгер Жыланды жеңгені үшін.
Dialogue: 0,0:09:16.09,0:09:18.43,Default,,0,0,0,,үшін? Ең кенжесі?
Dialogue: 0,0:09:18.93,0:09:19.97,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:09:20.55,0:09:24.48,Default,,0,0,0,,Мен жан-жағыма қарап, Ран планетасынан шыққан бұл жауынгер Жылан екенін білдім...
Dialogue: 0,0:09:24.56,0:09:25.73,Default,,0,0,0,,Жеті ағайынды
Dialogue: 0,0:09:25.81,0:09:28.10,Default,,0,0,0,,Не... Бұл не?
Dialogue: 0,0:09:28.19,0:09:31.36,Default,,0,0,0,,-Бұл дегеніміз... -тағы 6 адам.
Dialogue: 0,0:09:31.44,0:09:33.73,Default,,0,0,0,,Муша Виперді жеңу керек
Dialogue: 0,0:09:34.24,0:09:36.15,Default,,0,0,0,,Сонда сіз Пекопонға қайтып бара алмайсыз ба?
Dialogue: 0,0:09:36.24,0:09:37.36,Default,,0,0,0,,Қош бол
Dialogue: 0,0:09:37.45,0:09:40.28,Default,,0,0,0,,Ги-ро!
Dialogue: 0,0:09:40.37,0:09:42.83,Default,,0,0,0,,Кероро мен оның достарының Сенгоку Ран планетасын өзгертуге сапары
Dialogue: 0,0:09:42.91,0:09:45.66,Default,,0,0,0,,Ол жалғасады... ендеше орындайық.
Dialogue: 0,0:09:45.75,0:09:47.75,Default,,0,0,0,,♪～
Dialogue: 0,0:11:13.79,0:11:15.80,Default,,0,0,0,,～♪
Dialogue: 0,0:11:15.88,0:11:18.67,Default,,0,0,0,,Сәттілік, ағай!
Dialogue: 0,0:11:23.39,0:11:26.39,Default,,0,0,0,,Құрметті Пекопон халқы, бұдан былай...
Dialogue: 0,0:11:27.26,0:11:29.14,Default,,0,0,0,,Жаңа керондықтарды жалдау
Dialogue: 0,0:11:29.23,0:11:32.85,Default,,0,0,0,,Біз Үздік марапатының жеңімпаздарын жариялаймыз!
Dialogue: 0,0:11:35.23,0:11:36.90,Default,,0,0,0,,- Аспазшы ~ - Яня Яня...
Dialogue: 0,0:11:36.98,0:11:39.03,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:12:02.63,0:12:03.47,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:12:03.55,0:12:05.34,Default,,0,0,0,,Жылдамдық көрсетілсе, тере аласың ба?
Dialogue: 0,0:12:05.85,0:12:07.26,Default,,0,0,0,,Және тағы басқа
Dialogue: 0,0:12:08.10,0:12:10.98,Default,,0,0,0,,Бас жүлдені жариялаймыз!
Dialogue: 0,0:12:13.48,0:12:17.57,Default,,0,0,0,,Канагава префектурасы Сасамирайдың Кикака қаласы
Dialogue: 0,0:12:18.65,0:12:22.86,Default,,0,0,0,,Шинносуке Кондоның Сабаба, Ниигата префектурасы
Dialogue: 0,0:12:24.03,0:12:27.74,Default,,0,0,0,,Мисаки Ариматсудың Мерле, Фукуока префектурасы
Dialogue: 0,0:12:28.37,0:12:33.29,Default,,0,0,0,,Үш адам бас жүлденің жеңімпазы болып таңдалды.
Dialogue: 0,0:12:33.79,0:12:36.21,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:12:36.88,0:12:38.84,Default,,0,0,0,,Керон
Dialogue: 0,0:12:40.30,0:12:42.80,Default,,0,0,0,,Мұнда фильмді көруге келгендердің барлығына ғана.
Dialogue: 0,0:12:42.88,0:12:44.22,Default,,0,0,0,,Менің соңғы ойыным⸺
Dialogue: 0,0:12:44.30,0:12:47.97,Default,,0,0,0,,«Супер фильм нұсқасы Кероро Сержант 3: Аспандағы ұлы шытырман оқиға!»
Dialogue: 0,0:12:48.05,0:12:50.93,Default,,0,0,0,,Арнайы ақпарат көпшілікке жарияланады!
Dialogue: 0,0:12:51.02,0:12:53.02,Default,,0,0,0,,Мен өте семіз~
Dialogue: 0,0:12:54.06,0:12:55.90,Default,,0,0,0,,А? Ахх!
Dialogue: 0,0:12:55.98,0:12:56.77,Default,,0,0,0,,Тоуууу
Dialogue: 0,0:12:57.27,0:13:00.90,Default,,0,0,0,,Олай болса, өзіңізді жинағаныңызды қалаймын... Мен сізді жақсы естимін.
Dialogue: 0,0:13:00.98,0:13:02.44,Default,,0,0,0,,Тақырып экраны көрсетілген кезде
Dialogue: 0,0:13:02.53,0:13:05.36,Default,,0,0,0,,Төменгі экранда мені 5 рет түртіңіз.
Dialogue: 0,0:13:05.45,0:13:06.74,Default,,0,0,0,,Se-no
Dialogue: 0,0:13:07.24,0:13:11.29,Default,,0,0,0,,１ ２ ３ ４ ５
Dialogue: 0,0:13:11.37,0:13:12.70,Default,,0,0,0,,Мен осындамын, Коичи.
Dialogue: 0,0:13:13.91,0:13:14.71,Default,,0,0,0,,(Официант) Ж… Жоқ, мырза. Бұл «Неро» деп аталады➡
Dialogue: 0,0:13:14.79,0:13:17.79,Default,,0,0,0,,Сен кімсің?
Dialogue: 0,0:13:18.29,0:13:19.63,Default,,0,0,0,,Тоуууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:13:19.71,0:13:23.26,Default,,0,0,0,,А, сәл күте тұрыңыз... О, жоқ!
Dialogue: 0,0:13:26.93,0:13:28.72,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:13:29.22,0:13:32.47,Default,,0,0,0,,Ой, кино басталғалы тұрған сияқты.
Dialogue: 0,0:13:33.60,0:13:36.14,Default,,0,0,0,,Мен бірден байқап көргіңіз келетінін түсінемін.
Dialogue: 0,0:13:36.23,0:13:40.77,Default,,0,0,0,,Театрда DS ашпаңыз, себебі ол айналаңыздағы адамдарға кедергі келтіреді.
Dialogue: 0,0:13:40.86,0:13:43.32,Default,,0,0,0,,Мен оны фильм аяқталғаннан кейін көремін.
Dialogue: 0,0:13:45.78,0:13:47.74,Default,,0,0,0,,Иә? О, тағы да осында!
Dialogue: 0,0:13:47.82,0:13:49.62,Default,,0,0,0,,Жоооу!
Dialogue: 0,0:13:51.91,0:13:55.20,Default,,0,0,0,,5 түрту 5 түрту!
Dialogue: 0,0:14:22.36,0:14:24.73,Default,,0,0,0,,Перудегі Дүниежүзілік мұра, Оңтүстік Америка
Dialogue: 0,0:14:24.82,0:14:26.65,Default,,0,0,0,,Мачу-Пикчу, қалқымалы қала
Dialogue: 0,0:14:28.28,0:14:31.57,Default,,0,0,0,,Өйткені ол теңіз деңгейінен 2400 метр биіктікте орналасқан.
Dialogue: 0,0:14:31.66,0:14:33.87,Default,,0,0,0,,Ол қалқымалы қала деп аталады.
Dialogue: 0,0:14:33.95,0:14:39.42,Default,,0,0,0,,Оны кім және қандай мақсатпен жасағаны әлі күнге дейін жұмбақ күйде.
Dialogue: 0,0:14:45.92,0:14:46.63,Default,,0,0,0,,Бірақ
Dialogue: 0,0:14:46.71,0:14:50.13,Default,,0,0,0,,Мачу-Пикчу астында осындай қирандылар болған.
Dialogue: 0,0:14:50.22,0:14:51.80,Default,,0,0,0,,Бұл керемет, сержант.
Dialogue: 0,0:14:51.89,0:14:54.05,Default,,0,0,0,,Мені осында әкелгеніңіз үшін көп рахмет!
Dialogue: 0,0:14:54.14,0:14:55.18,Default,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:14:55.26,0:14:59.27,Default,,0,0,0,,Бұл маған күнде қарыздар Фуюки-доноға арналған.
Dialogue: 0,0:14:59.35,0:15:00.81,Default,,0,0,0,,Құсу құсу...
Dialogue: 0,0:15:01.40,0:15:02.98,Default,,0,0,0,,Ол сержант Кероро
Dialogue: 0,0:15:03.06,0:15:04.52,Default,,0,0,0,,Фуюкидің үйінде тұрғанда
Dialogue: 0,0:15:04.61,0:15:07.86,Default,,0,0,0,,Кероро взводын басқаратын басқыншы шетелдік.
Dialogue: 0,0:15:09.53,0:15:11.61,Default,,0,0,0,,-Эй -Ол не? Жироро
Dialogue: 0,0:15:11.70,0:15:13.32,Default,,0,0,0,,Шынымен де осындай жерде
Dialogue: 0,0:15:13.41,0:15:15.58,Default,,0,0,0,,Пекопонды басып алу үшін қолдануға болатын нәрсе бар ма?
Dialogue: 0,0:15:15.66,0:15:16.45,Default,,0,0,0,,Біреуі бар ма?
Dialogue: 0,0:15:16.54,0:15:17.62,Default,,0,0,0,,Қол жетімділік
Dialogue: 0,0:15:17.70,0:15:19.50,Default,,0,0,0,,Сіз оны таппайынша білмейсіз
Dialogue: 0,0:15:20.00,0:15:22.50,Default,,0,0,0,,Бірақ бұл жігіт өте үлкен.
Dialogue: 0,0:15:23.00,0:15:25.75,Default,,0,0,0,,Бұл керемет күшті энергетикалық реакция.
Dialogue: 0,0:15:25.84,0:15:27.25,Default,,0,0,0,,Жеке тұлға анықталса
Dialogue: 0,0:15:27.34,0:15:29.88,Default,,0,0,0,,Біз керемет шабуыл қаруын жасай аламыз.
Dialogue: 0,0:15:29.97,0:15:30.88,Default,,0,0,0,,Аспазшы~
Dialogue: 0,0:15:30.97,0:15:32.55,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:15:32.64,0:15:36.26,Default,,0,0,0,,Бұл жолы әдемі дүниежүзілік мұра Пекопонға саяхат болуы керек.
Dialogue: 0,0:15:36.35,0:15:37.35,Default,,0,0,0,,Басқыншылық туралы сөз жоқ...
Dialogue: 0,0:15:37.43,0:15:38.43,Default,,0,0,0,,Тыншсың Дороро!
Dialogue: 0,0:15:38.52,0:15:40.06,Default,,0,0,0,,Не?
Dialogue: 0,0:15:40.56,0:15:42.73,Default,,0,0,0,,Басқыншылық не болды?
Dialogue: 0,0:15:42.81,0:15:45.48,Default,,0,0,0,,Нанана... Бұл ештеңе емес.
Dialogue: 0,0:15:45.56,0:15:46.36,Default,,0,0,0,,Сәлем Тамама
Dialogue: 0,0:15:46.44,0:15:47.40,Default,,0,0,0,,Тамат?
Dialogue: 0,0:15:47.48,0:15:49.32,Default,,0,0,0,,Ой... ой...
Dialogue: 0,0:15:49.40,0:15:51.82,Default,,0,0,0,,Оның орнына барлау! Бұл барлау ~
Dialogue: 0,0:15:51.90,0:15:56.37,Default,,0,0,0,,Тамама, сәл күте тұрыңыз, жарық болмаса қауіпті!
Dialogue: 0,0:15:57.24,0:15:58.45,Default,,0,0,0,,Аа...
Dialogue: 0,0:15:58.54,0:16:00.96,Default,,0,0,0,,Тамама... Иә?
Dialogue: 0,0:16:06.59,0:16:08.30,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:16:08.38,0:16:09.96,Default,,0,0,0,,Бұл... бұл?
Dialogue: 0,0:16:10.05,0:16:11.92,Default,,0,0,0,,Бұл тұйыққа тірелді ме?
Dialogue: 0,0:16:12.76,0:16:14.09,Default,,0,0,0,,Құсу!
Dialogue: 0,0:16:19.68,0:16:21.81,Default,,0,0,0,,Іші кең.
Dialogue: 0,0:16:21.89,0:16:23.89,Default,,0,0,0,,Еден қисайған, сондықтан абай болыңыз
Dialogue: 0,0:16:23.98,0:16:26.90,Default,,0,0,0,,Заттар бұрынғыдан өзгеше.
Dialogue: 0,0:16:26.98,0:16:28.19,Default,,0,0,0,,Бұл туралы мұқият болыңыз.
Dialogue: 0,0:16:28.77,0:16:31.90,Default,,0,0,0,,Мұндай қирандылар туралы сөз болғанда, тұзақтар міндетті болып табылады.
Dialogue: 0,0:16:31.99,0:16:33.24,Default,,0,0,0,,Құсу?
Dialogue: 0,0:16:33.99,0:16:36.49,Default,,0,0,0,,Мм, сен бірдеңені басып қалдың ба?
Dialogue: 0,0:16:37.07,0:16:37.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:39.99,0:16:41.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:41.08,0:16:44.58,Default,,0,0,0,,Ах... ахх!
Dialogue: 0,0:16:44.67,0:16:45.29,Default,,0,0,0,,(бу)
Dialogue: 0,0:16:46.38,0:16:47.92,Default,,0,0,0,,- (Фуюки) Уау... - Хмф!
Dialogue: 0,0:16:48.00,0:16:48.71,Default,,0,0,0,,(бу)
Dialogue: 0,0:16:50.80,0:16:51.51,Default,,0,0,0,,Чи…
Dialogue: 0,0:16:58.35,0:16:59.05,Default,,0,0,0,,(Boo)
Dialogue: 0,0:17:00.60,0:17:02.10,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,0:17:02.18,0:17:04.77,Default,,0,0,0,,Сіз оны әдейі басып жатқан жоқсыз, солай ма?
Dialogue: 0,0:17:04.85,0:17:06.44,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:17:06.52,0:17:07.10,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:07.90,0:17:08.73,Default,,0,0,0,,Фуюки-доно!
Dialogue: 0,0:17:09.31,0:17:11.44,Default,,0,0,0,,- (Фуюки) Ух... -Ах!
Dialogue: 0,0:17:11.53,0:17:14.57,Default,,0,0,0,,Бұл Керо доптың себебі...
Dialogue: 0,0:17:15.07,0:17:16.07,Default,,0,0,0,,Керо доп
Dialogue: 0,0:17:16.16,0:17:18.74,Default,,0,0,0,,Оған тек Керон әскерінің капитанына ғана иелік етуге рұқсат етілді⸺
Dialogue: 0,0:17:18.82,0:17:22.41,Default,,0,0,0,,Бұл қорқынышты портативті әмбебап шабуыл қаруы.
Dialogue: 0,0:17:22.91,0:17:24.12,Default,,0,0,0,,Тей!
Dialogue: 0,0:17:25.54,0:17:26.21,Default,,0,0,0,,«Барлығын мен үшін» мұрагері…
Dialogue: 0,0:17:26.29,0:17:29.13,Default,,0,0,0,,Түймелерді пайдаланған кезде жеткілікті сақ болу керек.
Dialogue: 0,0:17:29.84,0:17:30.84,Default,,0,0,0,,(Пинг Донг)
Dialogue: 0,0:17:30.92,0:17:32.55,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:35.72,0:17:37.01,Default,,0,0,0,,Айтатата…
Dialogue: 0,0:17:37.09,0:17:39.01,Default,,0,0,0,,Рахмет Тамама Дороро
Dialogue: 0,0:17:39.09,0:17:40.55,Default,,0,0,0,,Барлығы қауіпсіз сияқты.
Dialogue: 0,0:17:40.64,0:17:42.68,Default,,0,0,0,,Құсу... Міне?
Dialogue: 0,0:17:43.18,0:17:45.14,Default,,0,0,0,,Баратын жер сияқты
Dialogue: 0,0:17:45.23,0:17:46.14,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:17:51.90,0:17:53.28,Default,,0,0,0,,О...
Dialogue: 0,0:17:55.19,0:17:56.11,Default,,0,0,0,,Уау~
Dialogue: 0,0:18:01.16,0:18:03.45,Default,,0,0,0,,Бір айла бар сияқты.
Dialogue: 0,0:18:03.54,0:18:05.08,Default,,0,0,0,,Өте сақ болыңыз.
Dialogue: 0,0:18:05.16,0:18:07.50,Default,,0,0,0,,Сен менің қасымда... деп тұрсың!
Dialogue: 0,0:18:08.17,0:18:09.88,Default,,0,0,0,,Бұл бір нәрсе.
Dialogue: 0,0:18:09.96,0:18:12.88,Default,,0,0,0,,Тартсам шыға ма деп...
Dialogue: 0,0:18:12.96,0:18:14.09,Default,,0,0,0,,Құсу!
Dialogue: 0,0:18:15.63,0:18:17.38,Default,,0,0,0,,- (Фуюки) Сержант! -Уау, сержант.
Dialogue: 0,0:18:17.47,0:18:18.63,Default,,0,0,0,,Капитан!
Dialogue: 0,0:18:24.10,0:18:25.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:32.36,0:18:34.73,Default,,0,0,0,,Айтпақшы...
Dialogue: 0,0:18:34.82,0:18:36.49,Default,,0,0,0,,Барлық мүшелер шегінеді!
Dialogue: 0,0:18:42.87,0:18:44.54,Default,,0,0,0,,-Фуюки-доно, асығыңыз! -тез!
Dialogue: 0,0:18:44.62,0:18:46.41,Default,,0,0,0,,Тоқта, ана жақта бір қыз бар...
Dialogue: 0,0:18:47.00,0:18:47.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:47.70,0:18:50.37,Default,,0,0,0,,-Фуюки-доно! -Фукки~!
Dialogue: 0,0:18:53.42,0:18:54.50,Default,,0,0,0,,Уау
Dialogue: 0,0:18:55.00,0:18:55.75,Default,,0,0,0,,(бу)
Dialogue: 0,0:18:55.84,0:18:59.30,Default,,0,0,0,,Уау... Уау!
Dialogue: 0,0:19:01.05,0:19:02.97,Default,,0,0,0,,Tamama Impact!
Dialogue: 0,0:19:04.14,0:19:06.22,Default,,0,0,0,,Уаааааааааааааааааааааааааааааааа...
Dialogue: 0,0:19:10.73,0:19:14.19,Default,,0,0,0,,Оянып қалдым да, бүкіл денем ауырады~!
Dialogue: 0,0:19:17.53,0:19:19.70,Default,,0,0,0,,Құсу? Сержант майор Крулл
Dialogue: 0,0:19:20.28,0:19:22.24,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:19:23.03,0:19:27.04,Default,,0,0,0,,Энергия реакциясы жоғалып кетті, кідірудің қажеті жоқ.
Dialogue: 0,0:19:27.12,0:19:28.00,Default,,0,0,0,,Аспазшы~
Dialogue: 0,0:19:51.35,0:19:54.35,Default,,0,0,0,,(пульсация)
Dialogue: 0,0:19:56.32,0:19:58.32,Default,,0,0,0,,♪～
Dialogue: 0,0:21:24.11,0:21:26.11,Default,,0,0,0,,～♪
Dialogue: 0,0:21:26.82,0:21:27.91,Default,,0,0,0,,Я~
Dialogue: 0,0:21:27.99,0:21:29.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:29.62,0:21:34.25,Default,,0,0,0,,Сонымен, бұл қайтар жолда жоғарыдан алынған Наска сызықтары.
Dialogue: 0,0:21:34.75,0:21:38.92,Default,,0,0,0,,Бұл дүниежүзілік мұра нысаны ма? Біз де сонда барғымыз келді.
Dialogue: 0,0:21:39.00,0:21:40.09,Default,,0,0,0,,Сәлем Коюки-чан
Dialogue: 0,0:21:40.17,0:21:41.29,Default,,0,0,0,,Иә
Dialogue: 0,0:21:41.38,0:21:46.22,Default,,0,0,0,,Ежелгі астана туралы ойлану... бұл романтикалық, солай емес пе?
Dialogue: 0,0:21:46.88,0:21:48.68,Default,,0,0,0,,Ах, итадакамасу
Dialogue: 0,0:21:51.81,0:21:52.47,Default,,0,0,0,,О...
Dialogue: 0,0:21:52.56,0:21:53.47,Default,,0,0,0,,Acchi
Dialogue: 0,0:21:53.56,0:21:55.10,Default,,0,0,0,,Хэхехехе...
Dialogue: 0,0:21:55.18,0:21:56.69,Default,,0,0,0,,Ой… Бұл сәл ағаттық болды.
Dialogue: 0,0:21:56.77,0:21:59.77,Default,,0,0,0,,Хм
Dialogue: 0,0:22:01.69,0:22:03.03,Default,,0,0,0,,Сәлем Кероро
Dialogue: 0,0:22:03.11,0:22:05.57,Default,,0,0,0,,Сайып келгенде, Мачу Пикчу да уақытты босқа кетірді, солай емес пе?
Dialogue: 0,0:22:06.19,0:22:08.82,Default,,0,0,0,,Энергетикалық реакциялардың шынайы табиғаты белгісіз болып қалады.
Dialogue: 0,0:22:08.91,0:22:10.74,Default,,0,0,0,,Керо доптан құтылу деген нені білдіреді?
Dialogue: 0,0:22:10.82,0:22:13.58,Default,,0,0,0,,Ал, ефрейтор Жироро, бұл соншалықты ыстық емес.
Dialogue: 0,0:22:14.29,0:22:17.66,Default,,0,0,0,,Кірді бірге іліп, тынышталайық... Құсу ма?
Dialogue: 0,0:22:18.62,0:22:20.67,Default,,0,0,0,,(Нацумидің гуілдеуі)
Dialogue: 0,0:22:20.75,0:22:22.42,Default,,0,0,0,,Оны ішпе!
Dialogue: 0,0:22:22.50,0:22:23.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:24.09,0:22:26.26,Default,,0,0,0,,Не...не істеп жатырсың, ақымақ бақа?
Dialogue: 0,0:22:26.34,0:22:29.22,Default,,0,0,0,,Бұл жай ғана сусын емес
Dialogue: 0,0:22:29.93,0:22:31.76,Default,,0,0,0,,Нанора әмбебап қарулы сусын
Dialogue: 0,0:22:32.26,0:22:33.85,Default,,0,0,0,,Нанотехнологияларды қолдану арқылы
Dialogue: 0,0:22:33.93,0:22:36.31,Default,,0,0,0,,Сіз кез келген нәрсені себу арқылы қаруландыра аласыз⸺
Dialogue: 0,0:22:36.39,0:22:38.27,Default,,0,0,0,,Өте ыңғайлы тауарлар
Dialogue: 0,0:22:39.81,0:22:42.73,Default,,0,0,0,,Неліктен бұл зат менің тоңазытқышымда?
Dialogue: 0,0:22:42.81,0:22:46.94,Default,,0,0,0,,Жоқ, оны суытқанда әсері екі есе артады, сондықтан қолданып көрейік...
Dialogue: 0,0:22:47.03,0:22:50.45,Default,,0,0,0,,Сондықтан мен саған үйде жасама деп айтып отырмын.
Dialogue: 0,0:22:50.53,0:22:52.45,Default,,0,0,0,,Тек орналасқан жерді біліңіз.
Dialogue: 0,0:22:52.53,0:22:53.08,Default,,0,0,0,,Құсу...
Dialogue: 0,0:22:53.16,0:22:54.91,Default,,0,0,0,,Оның орнына, сержант.
Dialogue: 0,0:22:54.99,0:22:57.66,Default,,0,0,0,,Бүгін жаңа шығарылымдар туралы ештеңе айтпадыңыз ба?
Dialogue: 0,0:22:57.75,0:22:59.96,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:23:00.04,0:23:06.00,Default,,0,0,0,,Бүгін «MG RX-78 Gundam 2 (Екі) Ver.K3 (Кейтли)» шығарылымының күні!
Dialogue: 0,0:23:06.09,0:23:07.80,Default,,0,0,0,,Мен мүлдем ұмытып кеттім.
Dialogue: 0,0:23:07.88,0:23:10.63,Default,,0,0,0,,Мен ойыншықтар дүкеніне тез баруым керек!
Dialogue: 0,0:23:10.72,0:23:13.26,Default,,0,0,0,,Кезекші ваннаны тазалап біткенше істей алмайсың.
Dialogue: 0,0:23:13.35,0:23:14.39,Default,,0,0,0,,Әпке...
Dialogue: 0,0:23:14.47,0:23:17.22,Default,,0,0,0,,Құсу сатылып кетті.
Dialogue: 0,0:23:17.31,0:23:20.60,Default,,0,0,0,,Сержант, егер сіз Гунпла алғыңыз келсе, мен оны сізге сатып аламын.
Dialogue: 0,0:23:20.69,0:23:21.73,Default,,0,0,0,,- Құсу ма? -(Нацуми) А?
Dialogue: 0,0:23:21.81,0:23:24.56,Default,,0,0,0,,Мен кітап дүкеніне баруды ойлап жүр едім.
Dialogue: 0,0:23:25.15,0:23:28.24,Default,,0,0,0,,О, Фуюки-доно, мен тоқтай алмаймын.
Dialogue: 0,0:23:28.32,0:23:30.07,Default,,0,0,0,,Бұл әмиянда ақша бар
Dialogue: 0,0:23:30.15,0:23:31.57,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:23:35.37,0:23:36.99,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:23:37.08,0:23:39.16,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:23:44.75,0:23:46.63,Default,,0,0,0,,Бұлыңғыр бақа?
Dialogue: 0,0:23:46.71,0:23:48.71,Default,,0,0,0,,Бұл кім? Мируру
Dialogue: 0,0:23:48.80,0:23:50.67,Default,,0,0,0,,Маған неге ұқсайсың?
Dialogue: 0,0:23:51.43,0:23:55.43,Default,,0,0,0,,Мүмкін осы планетаның басқыншысы, бірінші патшасы.
Dialogue: 0,0:23:55.51,0:23:58.06,Default,,0,0,0,,Мен билеуші болуға тырыстым, бірақ бола алмадым⸺
Dialogue: 0,0:23:58.14,0:23:59.93,Default,,0,0,0,,Менің ойымша, сіз жеңілген адамсыз.
Dialogue: 0,0:24:00.52,0:24:03.02,Default,,0,0,0,,Ха, мен оның жеңілгеніне сенімдімін.
Dialogue: 0,0:24:03.10,0:24:04.86,Default,,0,0,0,,Бұл билеушілердің ісі емес
Dialogue: 0,0:24:05.36,0:24:06.31,Default,,0,0,0,,Зеңді жою…
Dialogue: 0,0:24:06.40,0:24:07.57,Default,,0,0,0,,Қарауға шыдай алмаймын.
Dialogue: 0,0:24:08.32,0:24:10.40,Default,,0,0,0,,Ол патшаға ұқсайды.
Dialogue: 0,0:24:10.49,0:24:11.28,Default,,0,0,0,,Сондықтан
Dialogue: 0,0:24:11.86,0:24:14.78,Default,,0,0,0,,Сіз бұл планетаның жаңа патшасысыз.
Dialogue: 0,0:24:15.45,0:24:17.24,Default,,0,0,0,,Басқа амал жоқ.
Dialogue: 0,0:24:17.74,0:24:19.54,Default,,0,0,0,,Барлық адамдардың бақыты үшін
Dialogue: 0,0:24:19.62,0:24:22.54,Default,,0,0,0,,Маған осы планетаны дұрыс билеуге рұқсат етіңіз.
Dialogue: 0,0:24:23.79,0:24:25.25,Default,,0,0,0,,Осы екеуінің қайсысы екенін сұрап тұрмын. Сен бе?
Dialogue: 0,0:24:25.33,0:24:26.88,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:24:34.63,0:24:36.51,Default,,0,0,0,,Ағай, асығыңыз, асығыңыз
Dialogue: 0,0:24:36.60,0:24:38.60,Default,,0,0,0,,Иә, иә, рахмет.
Dialogue: 0,0:24:43.56,0:24:44.94,Default,,0,0,0,,Иә.
Dialogue: 0,0:24:45.02,0:24:47.69,Default,,0,0,0,,Мен мұны қалтамдағы ақшаға аламын.
Dialogue: 0,0:24:47.77,0:24:49.77,Default,,0,0,0,,Мені Мачу-Пикчуға апарғаныңыз үшін рахмет.
Dialogue: 0,0:24:49.86,0:24:50.86,Default,,0,0,0,,Менде жоқ.
Dialogue: 0,0:24:58.58,0:24:59.78,Default,,0,0,0,,Батырдың аты: Ол Майт
Dialogue: 0,0:25:05.62,0:25:08.21,Default,,0,0,0,,Бұлттың бағыты күдікті болып көрінеді.
Dialogue: 0,0:25:14.26,0:25:16.18,Default,,0,0,0,,Қорытындылай келе,
Dialogue: 0,0:25:16.26,0:25:18.18,Default,,0,0,0,,Менің Нишизава отбасымның суперкомпьютері
Dialogue: 0,0:25:18.26,0:25:20.31,Default,,0,0,0,,Біреу бұзды
Dialogue: 0,0:25:20.39,0:25:22.27,Default,,0,0,0,,Бұл бақылаудан тыс.
Dialogue: 0,0:25:23.27,0:25:26.69,Default,,0,0,0,,Бұл сонымен қатар Леди Момока ойлап тапқан өте құпия операция.
Dialogue: 0,0:25:26.77,0:25:27.77,Default,,0,0,0,,Код атауы
Dialogue: 0,0:25:27.85,0:25:30.98,Default,,0,0,0,,«Мен кітап дүкенінен Фуюки-кунмен бір кітапты алдым.»
Dialogue: 0,0:25:31.07,0:25:35.95,Default,,0,0,0,,«Саусақтардың ұшынан саусақтың ұшына» стратегиясын іске қосу қарсаңында
Dialogue: 0,0:25:36.45,0:25:37.91,Default,,0,0,0,,Мазмұны түсінікті
Dialogue: 0,0:25:37.99,0:25:42.45,Default,,0,0,0,,Мәселе мынада, бұзуды кім жасады?
Dialogue: 0,0:25:42.54,0:25:43.58,Default,,0,0,0,,Темера
Dialogue: 0,0:25:43.66,0:25:45.87,Default,,0,0,0,,Жауапқа қарай, сіз жай ғана құтыла алмайсыз. Кәне!
Dialogue: 0,0:25:45.96,0:25:49.58,Default,,0,0,0,,Эй Момокчи, мен ештеңе білмеймін.
Dialogue: 0,0:25:49.67,0:25:52.92,Default,,0,0,0,,Бірақ бұл, әрине, біздің Керон әскерінің белгісі.
Dialogue: 0,0:25:53.42,0:25:55.97,Default,,0,0,0,,Куруру Сенің істегеніңе сене алар емеспін...
Dialogue: 0,0:25:56.05,0:25:57.26,Default,,0,0,0,,Аспазшы~
Dialogue: 0,0:25:57.34,0:26:00.51,Default,,0,0,0,,Қалай ойлайсыз, мен осындай ашық бұзақылық жасаймын ба?
Dialogue: 0,0:26:00.60,0:26:01.26,Default,,0,0,0,,Хаа~
Dialogue: 0,0:26:01.35,0:26:02.64,Default,,0,0,0,,Мүлдем!
Dialogue: 0,0:26:02.72,0:26:06.56,Default,,0,0,0,,Бізге барлық нәрседен күмәндануыңыз үлкен мазасыздық.
Dialogue: 0,0:26:07.48,0:26:09.73,Default,,0,0,0,,Мен де бос емеспін.
Dialogue: 0,0:26:09.81,0:26:12.94,Default,,0,0,0,,Кір жуу, ваннаны тазалау, аяқ киімді жылтырату, т.б.
Dialogue: 0,0:26:13.02,0:26:14.23,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:26:15.11,0:26:16.28,Default,,0,0,0,,Йошиокадайра
Dialogue: 0,0:26:16.78,0:26:19.91,Default,,0,0,0,,Нишизава отбасына үлкен нысан жақындап келеді.
Dialogue: 0,0:26:19.99,0:26:20.87,Default,,0,0,0,,(Баяндаушы) Цезарь не болып жатқанын мүлде түсінбеді.
Dialogue: 0,0:26:25.62,0:26:28.33,Default,,0,0,0,,Нацуми-сан, бұл орындалды.
Dialogue: 0,0:26:28.42,0:26:29.12,Default,,0,0,0,,Рахмет
Dialogue: 0,0:26:29.21,0:26:30.33,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:26:30.42,0:26:33.34,Default,,0,0,0,,Маған бұлыңғыр бақадан кейін тазалауға көмектесуге рұқсат етіңіз.
Dialogue: 0,0:26:33.84,0:26:35.13,Default,,0,0,0,,Сәлем Нацуми-чан
Dialogue: 0,0:26:35.21,0:26:37.59,Default,,0,0,0,,Са... Сабуро-сенпай?
Dialogue: 0,0:26:38.80,0:26:40.34,Default,,0,0,0,,Ахаха қош келдіңіз
Dialogue: 0,0:26:42.10,0:26:43.85,Default,,0,0,0,,Мен Куруруды бір сәтке қарызға аламын.
Dialogue: 0,0:26:43.93,0:26:44.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:44.72,0:26:45.93,Default,,0,0,0,,Ах... егер бұл Куруру болса.
Dialogue: 0,0:26:46.02,0:26:49.02,Default,,0,0,0,,Мен жаңа ғана бұлдыр бақалармен Момока-чанның үйіне бардым...
Dialogue: 0,0:26:49.52,0:26:50.65,Default,,0,0,0,,Мен...
Dialogue: 0,0:26:51.15,0:26:52.19,Default,,0,0,0,,Коюки-доно!
Dialogue: 0,0:26:53.06,0:26:54.27,Default,,0,0,0,,Не болды? Дороро
Dialogue: 0,0:26:54.36,0:26:56.65,Default,,0,0,0,,Мен біраз уақыттан бері ерекше қатысуды сезініп жүрмін...
Dialogue: 0,0:26:56.74,0:26:58.78,Default,,0,0,0,,Ха…
Dialogue: 0,0:26:59.57,0:27:01.16,Default,,0,0,0,,-Ах! -(Сабуро) А...
Dialogue: 0,0:27:13.08,0:27:14.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:27:23.64,0:27:24.18,Default,,0,0,0,,Уф!
Dialogue: 0,0:27:25.35,0:27:27.22,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:27:41.95,0:27:44.16,Default,,0,0,0,,Мынаны қарашы, не?
Dialogue: 0,0:27:44.24,0:27:44.78,Default,,0,0,0,,Уау!
Dialogue: 0,0:28:10.02,0:28:11.18,Default,,0,0,0,,Фильм сияқты...
Dialogue: 0,0:28:11.81,0:28:13.90,Default,,0,0,0,,Дәлірек айтқанда, декорацияның таң қалдыратын өзгерісі ме?
Dialogue: 0,0:28:14.52,0:28:16.82,Default,,0,0,0,,Бұл үй күтушіден алыс!
Dialogue: 0,0:28:18.73,0:28:20.36,Default,,0,0,0,,Нишизава отбасы.
Dialogue: 0,0:28:24.57,0:28:25.41,Default,,0,0,0,,Құсу?
Dialogue: 0,0:28:27.33,0:28:28.70,Default,,0,0,0,,Де... Дека!
Dialogue: 0,0:28:28.79,0:28:30.83,Default,,0,0,0,,Бұл дұшпандық шетелдіктердің шабуылы ма?
Dialogue: 0,0:28:31.37,0:28:31.91,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:28:33.58,0:28:34.42,Default,,0,0,0,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:28:35.33,0:28:36.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:36.50,0:28:37.75,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:28:37.84,0:28:39.30,Default,,0,0,0,,Бұл кәдесый ма?
Dialogue: 0,0:28:39.38,0:28:40.17,Default,,0,0,0,,Куруру!
Dialogue: 0,0:28:40.26,0:28:42.55,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:28:42.63,0:28:44.09,Default,,0,0,0,,Си-васива-шива!
Dialogue: 0,0:28:44.84,0:28:47.60,Default,,0,0,0,,Сол ұсқынсыз жігіт сияқты
Dialogue: 0,0:28:48.18,0:28:49.93,Default,,0,0,0,,Usu! Мен сені күтуге мәжбүр еттім
Dialogue: 0,0:28:50.43,0:28:52.31,Default,,0,0,0,,Орачидің аты Шивава
Dialogue: 0,0:28:52.98,0:28:56.77,Default,,0,0,0,,Таңғажайып Ұлы Әулие Шиваваны кім атады!
Dialogue: 0,0:28:56.86,0:28:57.48,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:28:57.56,0:28:58.44,Default,,0,0,0,,Өте қиын болды… Өтінемін, мені жалғыз қалдыр.
Dialogue: 0,0:28:58.52,0:29:01.11,Default,,0,0,0,,Басты кейіпкердің жиіркенішті мінезі неде?
Dialogue: 0,0:29:01.19,0:29:02.53,Default,,0,0,0,,Мәңгі менің қасымда бол.
Dialogue: 0,0:29:04.99,0:29:06.41,Default,,0,0,0,,Құсу~
Dialogue: 0,0:29:09.99,0:29:11.04,Default,,0,0,0,,Кездесу
Dialogue: 0,0:29:12.58,0:29:13.37,Default,,0,0,0,,Ол жігіт...
Dialogue: 0,0:29:13.46,0:29:15.21,Default,,0,0,0,,Не, сен Жироны білесің бе?
Dialogue: 0,0:29:15.29,0:29:16.96,Default,,0,0,0,,Сәлемдесу
Dialogue: 0,0:29:17.92,0:29:19.59,Default,,0,0,0,,Гяааах!
Dialogue: 0,0:29:19.67,0:29:22.01,Default,,0,0,0,,Бұл сөзсіз ол.
Dialogue: 0,0:29:22.09,0:29:24.84,Default,,0,0,0,,Бірақ неге бұл жерде?
Dialogue: 0,0:29:25.93,0:29:28.18,Default,,0,0,0,,Сіз нұсқаушының бұйрығын естімейсіз бе? Доруру!
Dialogue: 0,0:29:28.26,0:29:30.26,Default,,0,0,0,,Джунгли – от теңізі...
Dialogue: 0,0:29:31.26,0:29:34.52,Default,,0,0,0,,Сенің істеп жүргенің бүлінуден басқа ештеңе емес!
Dialogue: 0,0:29:37.10,0:29:40.48,Default,,0,0,0,,Сонан соң көп ұзамай әскерден босатылғанын естідім...
Dialogue: 0,0:29:41.82,0:29:42.65,Default,,0,0,0,,Құсу?
Dialogue: 0,0:29:42.73,0:29:44.24,Default,,0,0,0,,Менің онымен байланысым бар.
Dialogue: 0,0:29:44.32,0:29:48.95,Default,,0,0,0,,Керон армиясының бұрынғы жаттықтырушысы, ауыр брондалған сарбаз Доруру
Dialogue: 0,0:29:49.78,0:29:51.58,Default,,0,0,0,,Do... Doruru?
Dialogue: 0,0:29:51.66,0:29:52.54,Default,,0,0,0,,онда Әйел Титанның ішіндегі адам қазір
Dialogue: 0,0:29:52.62,0:29:55.41,Default,,0,0,0,,Мына жақтағы шулы жігіт де Керон әскерінің солдаты ма?
Dialogue: 0,0:29:56.04,0:29:59.17,Default,,0,0,0,,Керон әскері? Кіші қараңыз Кіші қараңыз
Dialogue: 0,0:29:59.25,0:30:02.75,Default,,0,0,0,,Оратчи мұндай кішкентай ыдысқа сыймайды.
Dialogue: 0,0:30:02.84,0:30:04.17,Default,,0,0,0,,Ши~вашивашива...
Dialogue: 0,0:30:04.26,0:30:05.67,Default,,0,0,0,,Сонымен
Dialogue: 0,0:30:05.76,0:30:09.64,Default,,0,0,0,,Өзіне тым сенімді кейіпкердің тітіркендіргіш қатынасы...
Dialogue: 0,0:30:09.72,0:30:12.06,Default,,0,0,0,,Сізге ұнамайтынын айтыңыз!
Dialogue: 0,0:30:12.14,0:30:13.89,Default,,0,0,0,,Tamama Impact!
Dialogue: 0,0:30:13.97,0:30:17.19,Default,,0,0,0,,Ой, сіз өте жақсы істеп жатырсыз, солай емес пе?
Dialogue: 0,0:30:17.27,0:30:19.52,Default,,0,0,0,,Бірақ мен Оратчиді ондай шеберлікпен жеңе алмаймын.
Dialogue: 0,0:30:19.60,0:30:20.65,Default,,0,0,0,,Миллион жыл, асығыңыз!
Dialogue: 0,0:30:21.23,0:30:21.94,Default,,0,0,0,,Кеттік
Dialogue: 0,0:30:22.44,0:30:24.07,Default,,0,0,0,,Ең жоғарғы Омега\NОны
Dialogue: 0,0:30:24.65,0:30:27.65,Default,,0,0,0,,Shivava Special көмегімен түзетіңіз!
Dialogue: 0,0:30:27.74,0:30:29.20,Default,,0,0,0,,-Керо~! -Ааа...
Dialogue: 0,0:30:29.28,0:30:30.03,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:30:30.11,0:30:32.33,Default,,0,0,0,,-Хяаааааааааааааааааа! -Та... Тамама!
Dialogue: 0,0:30:32.41,0:30:33.24,Default,,0,0,0,,Құт
Dialogue: 0,0:30:37.50,0:30:38.62,Default,,0,0,0,,Хмф!
Dialogue: 0,0:30:44.09,0:30:45.26,Default,,0,0,0,,Мені жеңіл санама!
Dialogue: 0,0:30:48.38,0:30:49.34,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,0:30:49.43,0:30:51.14,Default,,0,0,0,,Құсу? Жироға дейін!
Dialogue: 0,0:30:51.22,0:30:52.60,Default,,0,0,0,,Жарайды, жеткілікті.
Dialogue: 0,0:30:56.43,0:30:57.73,Default,,0,0,0,,Құсу…
Dialogue: 0,0:31:09.32,0:31:10.74,Default,,0,0,0,,-Не? - Құсу...
Dialogue: 0,0:31:10.82,0:31:12.66,Default,,0,0,0,,Екі сержант?
Dialogue: 0,0:31:24.21,0:31:26.92,Default,,0,0,0,,Сондай-ақ... мүмкін сіз
Dialogue: 0,0:31:27.46,0:31:28.80,Default,,0,0,0,,Бөлінген ағайын?
Dialogue: 0,0:31:28.88,0:31:29.42,Default,,0,0,0,,Даха...
Dialogue: 0,0:31:29.51,0:31:31.30,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:31:31.38,0:31:34.55,Default,,0,0,0,,Касваль-ниисан!
Dialogue: 0,0:31:34.64,0:31:35.35,Default,,0,0,0,,Құсу
Dialogue: 0,0:31:36.26,0:31:37.43,Default,,0,0,0,,Менің ағам – жын
Dialogue: 0,0:31:37.52,0:31:39.31,Default,,0,0,0,,Ол үшін уайымдама, ақымақ!
Dialogue: 0,0:31:39.39,0:31:43.27,Default,,0,0,0,,Хмф, сен сияқты біреу бар екеніне сене алар емеспін...
Dialogue: 0,0:31:51.99,0:31:56.53,Default,,0,0,0,,Мен жаңа патшамын, осы планетаның билеушісі, Ұлы сержант Кероромын.
Dialogue: 0,0:31:57.04,0:32:00.00,Default,,0,0,0,,Мен сіздің атыңыздан осы Пекопонды басқарамын.
Dialogue: 0,0:32:00.08,0:32:02.21,Default,,0,0,0,,-Не...? -Иә~
Dialogue: 0,0:32:03.21,0:32:04.08,Default,,0,0,0,,Құсу?
Dialogue: 0,0:32:04.58,0:32:05.96,Default,,0,0,0,,Иә? сурет?
Dialogue: 0,0:32:06.04,0:32:06.96,Default,,0,0,0,,Уууу… Уф!
Dialogue: 0,0:32:07.46,0:32:09.38,Default,,0,0,0,,Әдетте сен сөгіс естуді марапат деп есептеп,
Dialogue: 0,0:32:09.88,0:32:12.01,Default,,0,0,0,,Бұл тамаша
Dialogue: 0,0:32:12.09,0:32:14.68,Default,,0,0,0,,- (Қараңғы Кероро) Екі минут. - Екі минут?
Dialogue: 0,0:32:15.30,0:32:19.18,Default,,0,0,0,,Енді екі минуттан кейін бұл планетаны басып алайық.
Dialogue: 0,0:32:19.27,0:32:23.02,Default,,0,0,0,,Не... Пекопонды басып алған менмін.
Dialogue: 0,0:32:23.60,0:32:25.81,Default,,0,0,0,,Басқа ешкімнің жолыңызға түсуіне жол бермеңіз!
Dialogue: 0,0:32:26.44,0:32:29.94,Default,,0,0,0,,Біз басып алу туралы естігенде, біз үнсіз қала алмаймыз.
Dialogue: 0,0:32:30.61,0:32:33.78,Default,,0,0,0,,Нишизава отбасылық жеке армиясын бар күшіңізбен жойыңыз!
Dialogue: 0,0:32:34.36,0:32:36.12,Default,,0,0,0,,- Мұрын дөңгелегі - (Навигатор) тексеру
Dialogue: 0,0:32:36.20,0:32:37.53,Default,,0,0,0,,- Radome - (Навигатор) Тексеру
Dialogue: 0,0:32:37.62,0:32:38.87,Default,,0,0,0,,Мылтық жарылысын тексеру құралы
Dialogue: 0,0:32:38.95,0:32:39.66,Default,,0,0,0,,Таза
Dialogue: 0,0:32:39.74,0:32:40.54,Default,,0,0,0,,Жарық инъекциясы
Dialogue: 0,0:32:40.62,0:32:41.16,Default,,0,0,0,,Бұл балаларды ойнауға әкелетін орын емес
Dialogue: 0,0:32:41.25,0:32:41.79,Default,,0,0,0,,Сол жақ инъекция
Dialogue: 0,0:32:42.37,0:32:43.12,Default,,0,0,0,,Бұл балаларды ойнауға әкелетін орын емес
Dialogue: 0,0:32:43.21,0:32:45.58,Default,,0,0,0,,Инъекциялық маяк OK тұтқасы
Dialogue: 0,0:32:45.67,0:32:46.92,Default,,0,0,0,,Қара жесірдің шиеленісуі
Dialogue: 0,0:32:47.00,0:32:47.79,Default,,0,0,0,,Күші жойылды
Dialogue: 0,0:32:47.88,0:32:49.25,Default,,0,0,0,,Не? Неліктен?
Dialogue: 0,0:32:49.84,0:32:53.55,Default,,0,0,0,,Пекопон экономикасының 51% бақылайды⸺
Dialogue: 0,0:32:53.63,0:32:56.89,Default,,0,0,0,,Нишизава отбасының суперкомпьютері қазірдің өзінде менің қолымда.
Dialogue: 0,0:32:56.97,0:32:59.51,Default,,0,0,0,,Экономикалық база бағындырылды
Dialogue: 0,0:32:59.60,0:33:02.48,Default,,0,0,0,,Нишизава отбасының жеке әскері де менің бақылауымда.
Dialogue: 0,0:33:02.56,0:33:03.77,Default,,0,0,0,,Не... не?
Dialogue: 0,0:33:03.85,0:33:05.44,Default,,0,0,0,,Сонымен қатар, бұзу арқылы
Dialogue: 0,0:33:05.52,0:33:07.86,Default,,0,0,0,,Дүние жүзіндегі үй компьютерлерінен
Dialogue: 0,0:33:08.61,0:33:11.90,Default,,0,0,0,,Барлығы бақылауда, тіпті әскери компьютерлер де
Dialogue: 0,0:33:11.99,0:33:15.61,Default,,0,0,0,,Көлік, қаржы, байланыс және энергетика
Dialogue: 0,0:33:16.24,0:33:18.37,Default,,0,0,0,,Барлық инфрақұрылымды басқарыңыз
Dialogue: 0,0:33:18.45,0:33:20.20,Default,,0,0,0,,әзірге 1 минут
Dialogue: 0,0:33:22.00,0:33:26.12,Default,,0,0,0,,Әмірші ретінде азаматтықты ұмытпау керек.
Dialogue: 0,0:33:26.21,0:33:29.50,Default,,0,0,0,,Ел басшыларына құттықтау хаттар жіберу
Dialogue: 0,0:33:29.59,0:33:31.25,Default,,0,0,0,,Мәтінді қысқаша мазмұндаңыз
Dialogue: 0,0:33:31.34,0:33:33.84,Default,,0,0,0,,«Бүгіннен бастап мен бұл планетаны басқарамын».
Dialogue: 0,0:33:33.92,0:33:36.26,Default,,0,0,0,,«Барлық қарсылық пайдасыз»
Dialogue: 0,0:33:36.76,0:33:39.14,Default,,0,0,0,,Хабарламаны жіберумен бір мезгілде
Dialogue: 0,0:33:39.22,0:33:42.52,Default,,0,0,0,,Менің шағын Кероро мүсіндерімді бүкіл әлемге таратыңыз
Dialogue: 0,0:33:58.57,0:34:01.49,Default,,0,0,0,,Бүкіл әлем үшін миды жуу радиотолқындары
Dialogue: 0,0:34:01.58,0:34:03.75,Default,,0,0,0,,«Сәжде аурасын» жіберу
Dialogue: 0,0:34:03.83,0:34:08.42,Default,,0,0,0,,Осымен бүкіл Пекопон халқы маған сөзсіз бас иеді.
Dialogue: 0,0:34:08.50,0:34:10.63,Default,,0,0,0,,- (Полиция) Мұздату! -(Қылмыскер) Қиямет!
Dialogue: 0,0:34:10.71,0:34:12.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:34:12.17,0:34:13.76,Default,,0,0,0,,Хаха Кероро-сама!
Dialogue: 0,0:34:13.84,0:34:15.97,Default,,0,0,0,,Namaste…
Dialogue: 0,0:34:16.05,0:34:17.55,Default,,0,0,0,,Хаха!
Dialogue: 0,0:34:18.93,0:34:23.06,Default,,0,0,0,,Құрметті бас сержант, Банзай!
Dialogue: 0,0:34:28.31,0:34:30.19,Default,,0,0,0,,- (Еркек) Кероро-сама - (Әйел) Кероро-сама!
Dialogue: 0,0:34:32.32,0:34:34.36,Default,,0,0,0,,) Ха~хахаха!
Dialogue: 0,0:34:34.44,0:34:36.07,Default,,0,0,0,,Тек ағам ерекшеленетініне өкінемін.
Dialogue: 0,0:34:36.15,0:34:37.57,Default,,0,0,0,,Кероро-сама, кешіріңіз!
Dialogue: 0,0:34:37.65,0:34:40.41,Default,,0,0,0,,Кя! Кероро-сама~!
Dialogue: 0,0:34:40.49,0:34:42.45,Default,,0,0,0,,Хаха!
Dialogue: 0,0:34:42.95,0:34:43.70,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:34:43.79,0:34:45.83,Default,,0,0,0,,Кероро-сама, хаха!
Dialogue: 0,0:34:45.91,0:34:47.83,Default,,0,0,0,,Хаха!
Dialogue: 0,0:34:48.58,0:34:52.50,Default,,0,0,0,,Хаха! Хаха~!
Dialogue: 0,0:34:56.84,0:34:58.97,Default,,0,0,0,,Әзірге 2 минут
Dialogue: 0,0:34:59.05,0:35:01.26,Default,,0,0,0,,немесе одан да көп шабуыл аяқталды
Dialogue: 0,0:35:01.34,0:35:02.85,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:35:03.35,0:35:05.68,Default,,0,0,0,,- (Фуюки) Сержант~! -Ах
Dialogue: 0,0:35:08.10,0:35:10.69,Default,,0,0,0,,Фуюки-доно, сен келе алмайсың!
Dialogue: 0,0:35:10.77,0:35:12.98,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:35:13.06,0:35:16.32,Default,,0,0,0,,Бұл қиын, қаладағы барлық адамдар...
Dialogue: 0,0:35:17.69,0:35:19.78,Default,,0,0,0,,Сіз Пекопон қаласынансыз.
Dialogue: 0,0:35:20.95,0:35:22.41,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:35:24.28,0:35:28.41,Default,,0,0,0,,Мируру Неліктен бұл Пекопонияда садақ аурасы жұмыс істемейді?
Dialogue: 0,0:35:28.50,0:35:29.91,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:35:30.00,0:35:32.54,Default,,0,0,0,,Ол бұрынғы патшамен туысқан сияқты...
Dialogue: 0,0:35:32.63,0:35:34.67,Default,,0,0,0,,Hun Жарайды.
Dialogue: 0,0:35:34.75,0:35:38.97,Default,,0,0,0,,Алып Кероро мүсіні салынып біткен соң, маған ешкім қарсы тұра алмайды.
Dialogue: 0,0:35:39.05,0:35:40.68,Default,,0,0,0,,- Құсу? - (Фуюки) Өте алып Кероро мүсіні?
Dialogue: 0,0:35:40.76,0:35:42.05,Default,,0,0,0,,Иә.
Dialogue: 0,0:35:42.13,0:35:43.55,Default,,0,0,0,,Сіз қозғала бастағанда
Dialogue: 0,0:35:43.64,0:35:46.26,Default,,0,0,0,,Мен жердегінің бәрін өртеп жібермейінше тоқтамаймын⸺
Dialogue: 0,0:35:46.35,0:35:47.93,Default,,0,0,0,,Жоюдың түпкі Құдайы
Dialogue: 0,0:35:49.35,0:35:50.94,Default,,0,0,0,,Ең соңғы құлпытас?
Dialogue: 0,0:35:51.02,0:35:54.06,Default,,0,0,0,,Кероның алып мүсіні қозғала бастағанда
Dialogue: 0,0:35:54.15,0:35:59.03,Default,,0,0,0,,Бүкіл адамзат қорыққаннан дірілдеп, менің алдымда бас игеннен басқа істей алады.
Dialogue: 0,0:35:59.53,0:36:00.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:36:04.66,0:36:06.08,Default,,0,0,0,,…және қатты күл. Содан кейін
Dialogue: 0,0:36:06.16,0:36:10.16,Default,,0,0,0,,Бүгіннен бастап мен сенің орныңа осы Пекопонды басқарамын!
Dialogue: 0,0:36:13.54,0:36:15.59,Default,,0,0,0,,Бұл қауіпті көрінеді.
Dialogue: 0,0:36:15.67,0:36:16.84,Default,,0,0,0,,Уау...
Dialogue: 0,0:36:16.92,0:36:18.71,Default,,0,0,0,,Шашырау! Жүгір!
Dialogue: 0,0:36:18.80,0:36:19.42,Default,,0,0,0,,Иә!
Dialogue: 0,0:36:23.97,0:36:26.30,Default,,0,0,0,,Алдыңғы патшаның енді маған пайдасы жоқ.
Dialogue: 0,0:36:26.39,0:36:26.93,Default,,0,0,0,,«Бұрын ол жетімдер үйін басқарған».
Dialogue: 0,0:36:30.85,0:36:32.35,Default,,0,0,0,,Е... иә!
Dialogue: 0,0:36:32.44,0:36:33.60,Default,,0,0,0,,- Құсу? -Тама!
Dialogue: 0,0:36:33.69,0:36:34.23,Default,,0,0,0,,Не?
Dialogue: 0,0:36:43.45,0:36:45.95,Default,,0,0,0,,Ой, бұл...
Dialogue: 0,0:36:46.03,0:36:47.87,Default,,0,0,0,,Фуюки деп айтпа.
Dialogue: 0,0:36:48.37,0:36:52.62,Default,,0,0,0,,Күндердің күнінде сен де менің ұлылығымды біліп, бас иесің.
Dialogue: 0,0:36:52.71,0:36:54.00,Default,,0,0,0,,Ақыл-ой сынақтарының атымен—
Dialogue: 0,0:37:06.93,0:37:09.60,Default,,0,0,0,,Жоқ, бәрі әлі де...
Dialogue: 0,0:37:09.68,0:37:10.89,Default,,0,0,0,,Сержант~!
Dialogue: 0,0:37:10.97,0:37:13.64,Default,,0,0,0,,Ефрейтор~! Тамама~!
Dialogue: 0,0:37:13.73,0:37:16.02,Default,,0,0,0,,Қайдасың? Сержант!
Dialogue: 0,0:37:16.10,0:37:18.06,Default,,0,0,0,,Фуюки-дононың аяғының астында
Dialogue: 0,0:37:18.15,0:37:21.65,Default,,0,0,0,,Уау! О... күте тұрыңыз, сержант.
Dialogue: 0,0:37:23.61,0:37:27.20,Default,,0,0,0,,Ха ха ха... Кешіріңіз, жақсысыз ба?
Dialogue: 0,0:37:27.28,0:37:29.12,Default,,0,0,0,,Одан гөрі Фуюки-доно
Dialogue: 0,0:37:29.20,0:37:32.37,Default,,0,0,0,,Мен сізден Джироро мен басқаларды құтқару үшін көмек сұрай беремін.
Dialogue: 0,0:37:32.45,0:37:34.12,Default,,0,0,0,,Сержант ше?
Dialogue: 0,0:37:34.21,0:37:36.21,Default,,0,0,0,,Мен оған баруым керек.
Dialogue: 0,0:37:36.29,0:37:38.38,Default,,0,0,0,,Бұл... жалғыз болу қауіпті.
Dialogue: 0,0:37:39.09,0:37:40.63,Default,,0,0,0,,Жарайды
Dialogue: 0,0:37:40.71,0:37:43.97,Default,,0,0,0,,Біз бұл жерде отырып, шегінуге болмайды.
Dialogue: 0,0:37:44.59,0:37:45.38,Default,,0,0,0,,О!
Dialogue: 0,0:37:45.47,0:37:49.10,Default,,0,0,0,,Әй, сержант... Сержант!
Dialogue: 0,0:37:49.60,0:37:50.14,Default,,0,0,0,,Уау
Dialogue: 0,0:37:53.02,0:37:53.56,Default,,0,0,0,,Ах
Dialogue: 0,0:37:55.48,0:37:56.31,Default,,0,0,0,,Бұл...
Dialogue: 0,0:37:56.39,0:37:58.27,Default,,0,0,0,,-Фуюки-сан! -(Фуюки) Моа-чан
Dialogue: 0,0:37:59.44,0:38:01.57,Default,,0,0,0,,Нақты не болды?
Dialogue: 0,0:38:01.65,0:38:03.23,Default,,0,0,0,,Немесе төтенше жағдай ма?
Dialogue: 0,0:38:06.99,0:38:08.20,Default,,0,0,0,,Құсу
Dialogue: 0,0:38:11.28,0:38:13.95,Default,,0,0,0,,... Қашпа!
Dialogue: 0,0:38:14.66,0:38:16.33,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:38:18.04,0:38:19.67,Default,,0,0,0,,Әрқашанғыдай, сенің бұл бейқам мінезің—
Dialogue: 0,0:38:19.75,0:38:22.17,Default,,0,0,0,,Құсу!
Dialogue: 0,0:38:28.88,0:38:32.18,Default,,0,0,0,,Пирошки Тундра Кероро-сама
Dialogue: 0,0:38:32.26,0:38:35.77,Default,,0,0,0,,Дүниежүзілік бас сержанттың құрметі
Dialogue: 0,0:38:36.27,0:38:39.65,Default,,0,0,0,,Матрешка және Кероро-сама
Dialogue: 0,0:38:40.27,0:38:43.23,Default,,0,0,0,,Ашық немесе ашық, ұлы сержант
Dialogue: 0,0:38:46.32,0:38:47.11,Default,,0,0,0,,Хмм…
Dialogue: 0,0:38:47.61,0:38:51.91,Default,,0,0,0,,Алып Кероро мүсінінің құрылысы бірқалыпты жүріп жатқан сияқты.
Dialogue: 0,0:38:51.99,0:38:55.66,Default,,0,0,0,,Иә, Мәскеуде іштің төменгі бөлігі, Римде желке
Dialogue: 0,0:38:56.33,0:38:57.79,Default,,0,0,0,,Афинада бөкселер
Dialogue: 0,0:38:57.87,0:39:01.25,Default,,0,0,0,,Ішкі жақтау Жапонияның Шизуокада құрастырылған.
Dialogue: 0,0:39:01.33,0:39:04.50,Default,,0,0,0,,Міне, Оку-Токио қаласында басшы...
Dialogue: 0,0:39:04.59,0:39:05.13,Default,,0,0,0,,Ах
Dialogue: 0,0:39:05.21,0:39:07.55,Default,,0,0,0,,Мен қаскүнемді ұстадым.
Dialogue: 0,0:39:08.92,0:39:11.01,Default,,0,0,0,,Эй, не істеуіміз керек?
Dialogue: 0,0:39:13.85,0:39:17.48,Default,,0,0,0,,О, мен күдікті адаммын.
Dialogue: 0,0:39:17.56,0:39:20.69,Default,,0,0,0,,Кочирано взвод 2 Мен әскерге қосылғым келеді.
Dialogue: 0,0:39:21.27,0:39:22.19,Default,,0,0,0,,Джеро герори
Dialogue: 0,0:39:22.27,0:39:25.65,Default,,0,0,0,,Біріншіден, өзіңізді бағынышты ретінде енгізу үшін осы тамаша масканы пайдаланыңыз.
Dialogue: 0,0:39:26.15,0:39:30.28,Default,,0,0,0,,Мүмкіндікті пайдаланып, жасырын түрде орын ауыстырыңыз және қуатты өз қалауыңыз бойынша басқарыңыз.
Dialogue: 0,0:39:30.36,0:39:31.20,Default,,0,0,0,,Атаңыз
Dialogue: 0,0:39:31.28,0:39:34.62,Default,,0,0,0,,Біреудің белінде сумомен күресу стратегиясы!
Dialogue: 0,0:39:34.70,0:39:36.91,Default,,0,0,0,,Жоқ, мен оны дауыстап айтпай тұра алмадым.
Dialogue: 0,0:39:37.58,0:39:38.66,Default,,0,0,0,,Сіз не істейсіз?
Dialogue: 0,0:39:39.37,0:39:41.29,Default,,0,0,0,,Бағыныңқыларды таңдауды өзіңізге қалдырыңыз
Dialogue: 0,0:39:41.37,0:39:44.42,Default,,0,0,0,,Сіз Шивава мен Дорулуны да таптыңыз.
Dialogue: 0,0:39:45.17,0:39:46.05,Default,,0,0,0,,Құсу...
Dialogue: 0,0:39:46.13,0:39:48.13,Default,,0,0,0,,Өзімді қысқаша таныстырып өтейін.
Dialogue: 0,0:39:48.84,0:39:51.68,Default,,0,0,0,,О~у Аригато Конничиха
Dialogue: 0,0:39:51.76,0:39:54.72,Default,,0,0,0,,I Мероро Калифорния Икучине
Dialogue: 0,0:39:54.80,0:39:59.35,Default,,0,0,0,,Сүйікті кинамоноха Сукияки Суши Сошит…
Dialogue: 0,0:39:59.43,0:40:00.60,Default,,0,0,0,,Гунпла
Dialogue: 0,0:40:04.19,0:40:06.02,Default,,0,0,0,,Те…темпура?
Dialogue: 0,0:40:06.11,0:40:07.90,Default,,0,0,0,,Гунпла жоқ
Dialogue: 0,0:40:08.40,0:40:09.49,Default,,0,0,0,,Ха... Мен оны лақтырамын.
Dialogue: 0,0:40:09.57,0:40:11.95,Default,,0,0,0,,Не болып жатыр? Міне осы!
Dialogue: 0,0:40:12.03,0:40:13.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:40:13.91,0:40:15.87,Default,,0,0,0,,Тағы біреу жақындап келеді.
Dialogue: 0,0:40:17.87,0:40:19.25,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:40:19.83,0:40:22.62,Default,,0,0,0,,Мен білмеймін. Бұл мүлдем күтпеген жағдай.
Dialogue: 0,0:40:22.71,0:40:23.83,Default,,0,0,0,,Жою
Dialogue: 0,0:40:23.92,0:40:26.38,Default,,0,0,0,,Кеттік! Сіз үшін сынап көргенімді қалайсыз ба?
Dialogue: 0,0:40:26.46,0:40:30.88,Default,,0,0,0,,Жоқ, бәрібір, тек Пекопоннан келген бала.
Dialogue: 0,0:40:30.97,0:40:31.88,Default,,0,0,0,,Чи…
Dialogue: 0,0:40:32.76,0:40:33.72,Default,,0,0,0,,Жоспар
Dialogue: 0,0:40:33.80,0:40:37.10,Default,,0,0,0,,Үлкен Кероро мүсінінің аяқталуын тездету.
Dialogue: 0,0:40:41.18,0:40:42.56,Default,,0,0,0,,Ой... иә!
Dialogue: 0,0:40:44.19,0:40:48.02,Default,,0,0,0,,Айтата... Дәлірек айтқанда, құтқару операциясы ма?
Dialogue: 0,0:40:48.11,0:40:52.70,Default,,0,0,0,,Эй, бұл әйелдің маған көмектесе алатынына сене алар емеспін...
Dialogue: 0,0:40:55.20,0:40:55.99,Default,,0,0,0,,Аа...
Dialogue: 0,0:40:56.07,0:40:58.20,Default,,0,0,0,,Сонымен Керороға не болды?
Dialogue: 0,0:40:58.28,0:40:59.49,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:40:59.58,0:41:01.66,Default,,0,0,0,,Онда ағай жалғыз
Dialogue: 0,0:41:01.75,0:41:05.71,Default,,0,0,0,,Сонымен Фуюки-сан да ағайдың соңынан ерді...
Dialogue: 0,0:41:05.79,0:41:07.63,Default,,0,0,0,,Дұрысы, жалғыз күрес пе?
Dialogue: 0,0:41:07.71,0:41:10.13,Default,,0,0,0,,Барлығына, бұл қиын!
Dialogue: 0,0:41:10.21,0:41:10.96,Default,,0,0,0,,- Иә?
Dialogue: 0,0:41:11.05,0:41:13.13,Default,,0,0,0,,Коюки-доно, Нацуми-доно және т.б.
Dialogue: 0,0:41:16.47,0:41:18.51,Default,,0,0,0,,Жарайды, тағы біраз.
Dialogue: 0,0:41:19.01,0:41:19.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:21.18,0:41:23.43,Default,,0,0,0,,Е... уау уау...
Dialogue: 0,0:41:23.52,0:41:28.02,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:41:29.23,0:41:30.69,Default,,0,0,0,,Уф...
Dialogue: 0,0:41:37.49,0:41:38.03,Default,,0,0,0,,Ах
Dialogue: 0,0:41:56.68,0:42:00.64,Default,,0,0,0,,Мұның бәрі олардың сарайы ма?
Dialogue: 0,0:42:00.72,0:42:02.06,Default,,0,0,0,,Не... Уау!
Dialogue: 0,0:42:03.60,0:42:08.94,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:42:10.15,0:42:12.73,Default,,0,0,0,,Сен оған көп қиындық көрсеттің ғой, иә?
Dialogue: 0,0:42:18.32,0:42:20.91,Default,,0,0,0,,Кенет...
Dialogue: 0,0:42:22.41,0:42:23.04,Default,,0,0,0,,Ах
Dialogue: 0,0:42:27.00,0:42:28.67,Default,,0,0,0,,Сіз...
Dialogue: 0,0:42:30.92,0:42:33.46,Default,,0,0,0,,Менің ойымша, сіз Мачу-Пикчу қирандысында болдыңыз...
Dialogue: 0,0:42:37.09,0:42:38.72,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:42:38.80,0:42:39.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:39.93,0:42:41.43,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:42:41.51,0:42:43.76,Default,,0,0,0,,Сіздің достарыңыз не істеп жатыр?
Dialogue: 0,0:42:44.52,0:42:45.52,Default,,0,0,0,,Сау бол, Джоджо!
Dialogue: 0,0:42:45.60,0:42:48.89,Default,,0,0,0,,Иә, менің досым мұнда жалғыз.
Dialogue: 0,0:42:48.98,0:42:50.94,Default,,0,0,0,,Сондықтан мен де сенің артынан қудым...
Dialogue: 0,0:42:51.44,0:42:54.69,Default,,0,0,0,,Аа, дұрыс, сержант, мұны істей алмаймыз.
Dialogue: 0,0:42:55.86,0:42:59.28,Default,,0,0,0,,А... А, маған көмектескеніңіз үшін рахмет.
Dialogue: 0,0:42:59.36,0:43:01.41,Default,,0,0,0,,Менің атым Фуюки. Сен ше?
Dialogue: 0,0:43:02.99,0:43:04.08,Default,,0,0,0,,Наска
Dialogue: 0,0:43:05.37,0:43:06.62,Default,,0,0,0,,Наска…
Dialogue: 0,0:43:07.66,0:43:08.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:28.73,0:43:31.31,Default,,0,0,0,,Ей Эй О!
Dialogue: 0,0:43:32.65,0:43:33.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:43:35.57,0:43:37.48,Default,,0,0,0,,Бұл не? Бұл үлгі
Dialogue: 0,0:43:38.69,0:43:40.45,Default,,0,0,0,,Уау...
Dialogue: 0,0:43:40.53,0:43:44.83,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:43:46.66,0:43:47.54,Default,,0,0,0,,Пу...
Dialogue: 0,0:43:54.42,0:43:58.30,Default,,0,0,0,,Ха ха ха... Гехо Гехо Гехо
Dialogue: 0,0:43:58.80,0:44:00.92,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:44:07.93,0:44:09.14,Default,,0,0,0,,Бұл...
Dialogue: 0,0:44:09.64,0:44:13.31,Default,,0,0,0,,Мачу-Пикчу маңында көрінген инка үлгісіндегі мумия.
Dialogue: 0,0:44:14.19,0:44:16.07,Default,,0,0,0,,Онда неге сол тікұшақ келді?
Dialogue: 0,0:44:16.15,0:44:17.94,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:44:21.24,0:44:23.28,Default,,0,0,0,,Бұл таңқаларлық берік.
Dialogue: 0,0:44:26.62,0:44:27.16,Default,,0,0,0,,Әй!
Dialogue: 0,0:44:34.42,0:44:36.29,Default,,0,0,0,,Куруру орындалмады
Dialogue: 0,0:44:36.38,0:44:37.50,Default,,0,0,0,,Стратегияны өзгерту
Dialogue: 0,0:44:38.55,0:44:41.01,Default,,0,0,0,,Түсіндім, тым әбігер болма.
Dialogue: 0,0:44:41.09,0:44:42.01,Default,,0,0,0,,Аспазшы~
Dialogue: 0,0:44:47.60,0:44:51.98,Default,,0,0,0,,Кероро-сама үшін! Кероро-сама үшін!
Dialogue: 0,0:44:52.06,0:44:53.94,Default,,0,0,0,,Кероро-сама үшін!
Dialogue: 0,0:44:55.23,0:44:56.81,Default,,0,0,0,,Кероро-сама үшін!
Dialogue: 0,0:44:56.90,0:45:00.98,Default,,0,0,0,,Кероро-сама үшін! Кероро-сама үшін!
Dialogue: 0,0:45:01.07,0:45:02.49,Default,,0,0,0,,Ха~хахаха!
Dialogue: 0,0:45:02.57,0:45:04.32,Default,,0,0,0,,Кешіріңіз, Кероро-сама.
Dialogue: 0,0:45:04.41,0:45:07.49,Default,,0,0,0,,Ағамның бірнеше рет шыққанына қатты қуанғаным үшін кешірім сұраймын.
Dialogue: 0,0:45:07.57,0:45:11.70,Default,,0,0,0,,Fi~ Fi~ Fi~ Fi~…
Dialogue: 0,0:45:12.29,0:45:15.04,Default,,0,0,0,,Хехехехехехехехехехехехехехехехе
Dialogue: 0,0:45:18.25,0:45:19.92,Default,,0,0,0,,Сіз не істеп жатырсыз? Нацуми
Dialogue: 0,0:45:20.00,0:45:21.30,Default,,0,0,0,,Оян!
Dialogue: 0,0:45:21.38,0:45:23.22,Default,,0,0,0,,Кероро-сама үшін
Dialogue: 0,0:45:23.30,0:45:24.30,Default,,0,0,0,,Нацуми…
Dialogue: 0,0:45:24.80,0:45:29.05,Default,,0,0,0,,Бұл пайдасыз. Бұл гипноздық күйдің бір түрі.
Dialogue: 0,0:45:29.14,0:45:29.93,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:45:30.51,0:45:34.44,Default,,0,0,0,,Құруру-сенпай маған біртүрлі радиотолқындар шығып жатқанын айтты.
Dialogue: 0,0:45:34.52,0:45:38.11,Default,,0,0,0,,Бұл бізге, керондықтарға қарсы жұмыс істемейтін сияқты.
Dialogue: 0,0:45:38.69,0:45:40.44,Default,,0,0,0,,Шөп шабатын машиналарда да жұмыс істемейді
Dialogue: 0,0:45:40.94,0:45:43.82,Default,,0,0,0,,Ең бастысы, Фуюки-сан екеуің амансыңдар ма?
Dialogue: 0,0:45:44.70,0:45:47.57,Default,,0,0,0,,Барып көруден басқа амалым жоқ сияқты.
Dialogue: 0,0:45:52.24,0:45:53.16,Default,,0,0,0,,Ха!
Dialogue: 0,0:45:53.25,0:45:56.29,Default,,0,0,0,,Не... бұл егеуқұйрық па?
Dialogue: 0,0:45:56.37,0:45:57.62,Default,,0,0,0,,Мені қорқытпа
Dialogue: 0,0:45:58.38,0:46:01.88,Default,,0,0,0,,Фу... Тірі екенімді білгенде.
Dialogue: 0,0:46:01.96,0:46:04.67,Default,,0,0,0,,Олар қуғыншыларды орнатуы керек.
Dialogue: 0,0:46:04.76,0:46:07.01,Default,,0,0,0,,Бірдеңе болып қалса, осы nanora...
Dialogue: 0,0:46:07.09,0:46:08.59,Default,,0,0,0,,Эй!
Dialogue: 0,0:46:08.68,0:46:12.60,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:46:13.64,0:46:14.77,Default,,0,0,0,,Құсу!
Dialogue: 0,0:46:17.73,0:46:19.56,Default,,0,0,0,,Сержант? Уау
Dialogue: 0,0:46:19.65,0:46:21.73,Default,,0,0,0,,Мама!
Dialogue: 0,0:46:21.82,0:46:24.61,Default,,0,0,0,,Сәлем! Бірдей... Тоқта!
Dialogue: 0,0:46:25.19,0:46:26.99,Default,,0,0,0,,? Қазір дауыс...
Dialogue: 0,0:46:27.49,0:46:29.24,Default,,0,0,0,,Кез келген жағдайда, Фуюки-доно?
Dialogue: 0,0:46:29.32,0:46:32.37,Default,,0,0,0,,Тоқта Тоқта! Шабуыл жойылды!
Dialogue: 0,0:46:32.45,0:46:34.20,Default,,0,0,0,,Мама~?
Dialogue: 0,0:46:34.29,0:46:36.71,Default,,0,0,0,,Айтатата…
Dialogue: 0,0:46:36.79,0:46:39.25,Default,,0,0,0,,Сержант... Ақыры таптым.
Dialogue: 0,0:46:39.33,0:46:42.46,Default,,0,0,0,,Фуюки-доно, сен мұнда не үшін келдің?
Dialogue: 0,0:46:43.21,0:46:45.76,Default,,0,0,0,,Сержант жалғыз барады.
Dialogue: 0,0:46:45.84,0:46:48.34,Default,,0,0,0,,Қауіпті дедім ғой... Уау.
Dialogue: 0,0:46:48.43,0:46:50.22,Default,,0,0,0,,Фуюки-доно!
Dialogue: 0,0:46:50.30,0:46:52.26,Default,,0,0,0,,Сержант...
Dialogue: 0,0:46:52.76,0:46:54.22,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:46:56.60,0:47:00.23,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:47:01.15,0:47:03.61,Default,,0,0,0,,Мұның жақсы екеніне сенімдісіз бе?
Dialogue: 0,0:47:03.69,0:47:04.73,Default,,0,0,0,,Иә
Dialogue: 0,0:47:04.82,0:47:08.07,Default,,0,0,0,,Судың бағытымен жүрсең, міндетті түрде далаға шығасың...
Dialogue: 0,0:47:08.15,0:47:10.16,Default,,0,0,0,,Фуюки-доно күткендей.
Dialogue: 0,0:47:10.24,0:47:10.78,Default,,0,0,0,,Құсу?
Dialogue: 0,0:47:10.86,0:47:12.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:12.16,0:47:14.49,Default,,0,0,0,,Yahoo! Бұл шығу!
Dialogue: 0,0:47:14.58,0:47:16.54,Default,,0,0,0,,О, күте тұрыңыз, сержант.
Dialogue: 0,0:47:16.62,0:47:18.33,Default,,0,0,0,,Абайлаңыз! Әлі де осында...
Dialogue: 0,0:47:19.29,0:47:20.83,Default,,0,0,0,,Сержант!
Dialogue: 0,0:47:20.92,0:47:23.38,Default,,0,0,0,,Ге... құсу!
Dialogue: 0,0:47:23.46,0:47:24.96,Default,,0,0,0,,Geh gerogero...
Dialogue: 0,0:47:29.34,0:47:30.51,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:47:32.09,0:47:33.30,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:47:33.39,0:47:36.64,Default,,0,0,0,,Құсу... Көмегіңе рахмет.
Dialogue: 0,0:47:36.72,0:47:38.52,Default,,0,0,0,,Басқа жерден іздеуім керек пе?
Dialogue: 0,0:47:38.60,0:47:39.89,Default,,0,0,0,,(судың ағып жатқан дыбысы)
Dialogue: 0,0:47:39.98,0:47:40.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:40.94,0:47:42.98,Default,,0,0,0,,-Жоқ! - (Фуюки) Уау!
Dialogue: 0,0:47:50.24,0:47:52.20,Default,,0,0,0,,Сержанттар кеңесі!
Dialogue: 0,0:47:52.28,0:47:53.28,Default,,0,0,0,,Ұшатын тақталар туралы не деуге болады?
Dialogue: 0,0:47:53.37,0:47:54.28,Default,,0,0,0,,Құсу?
Dialogue: 0,0:47:54.37,0:47:56.74,Default,,0,0,0,,Үстінде сержант бар ұшатын тақта!
Dialogue: 0,0:47:56.83,0:47:59.25,Default,,0,0,0,,О, дұрыс.
Dialogue: 0,0:47:59.33,0:48:01.33,Default,,0,0,0,,Қашықтан басқару пульті Қашықтан басқару пульті…
Dialogue: 0,0:48:01.42,0:48:01.96,Default,,0,0,0,,болды
Dialogue: 0,0:48:05.71,0:48:06.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:48:19.85,0:48:20.68,Default,,0,0,0,,Ахаха
Dialogue: 0,0:48:21.64,0:48:22.69,Default,,0,0,0,,Джеро герори
Dialogue: 0,0:48:23.94,0:48:27.19,Default,,0,0,0,,(Кероро мен Фуюкидің күлкісі)
Dialogue: 0,0:48:28.03,0:48:32.20,Default,,0,0,0,,Баланың мақсаты өзінен бұрынғы ағасын құтқару болған сияқты.
Dialogue: 0,0:48:32.86,0:48:35.24,Default,,0,0,0,,Неліктен мұндай сәтсіздікке көмектесуге тырысар едіңіз?
Dialogue: 0,0:48:35.82,0:48:39.29,Default,,0,0,0,,Оларда тек патша мен қызметші қарым-қатынасы жоқ.
Dialogue: 0,0:48:39.37,0:48:42.92,Default,,0,0,0,,Тағы бір ерекше байланыс бар сияқты.
Dialogue: 0,0:48:43.54,0:48:46.25,Default,,0,0,0,,Ерекше байланыс... Иә?
Dialogue: 0,0:48:48.84,0:48:51.13,Default,,0,0,0,,- Ағай! -Тақсыр да!
Dialogue: 0,0:48:51.21,0:48:53.05,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:48:53.13,0:48:56.09,Default,,0,0,0,,Мүлдем елеусіз.
Dialogue: 0,0:48:56.18,0:48:57.47,Default,,0,0,0,,Ағай~!
Dialogue: 0,0:48:57.55,0:48:59.81,Default,,0,0,0,,- Құсу... - (Фуюки) Барлығы
Dialogue: 0,0:48:59.89,0:49:03.39,Default,,0,0,0,,Ой, мына жігіттер әлі тірі ме?
Dialogue: 0,0:49:03.48,0:49:05.06,Default,,0,0,0,,Бұл өте қыңыр, солай емес пе?
Dialogue: 0,0:49:06.06,0:49:07.56,Default,,0,0,0,,Бұл Черониттер де
Dialogue: 0,0:49:07.65,0:49:10.94,Default,,0,0,0,,Бұл Пекопон халқымен ерекше байланыс бар дегенді білдіре ме?
Dialogue: 0,0:49:11.65,0:49:13.15,Default,,0,0,0,,Тәжірибе жасайық
Dialogue: 0,0:49:13.24,0:49:15.32,Default,,0,0,0,,Менің бір қызық ойым бар.
Dialogue: 0,0:49:16.24,0:49:20.33,Default,,0,0,0,,Кероро-сама үшін! Кероро-сама үшін!
Dialogue: 0,0:49:20.41,0:49:21.79,Default,,0,0,0,,Қазірдің өзінде
Dialogue: 0,0:49:21.87,0:49:23.83,Default,,0,0,0,,Барлығы көмекке баяу келеді.
Dialogue: 0,0:49:23.91,0:49:26.92,Default,,0,0,0,,- Бұл сенсің - (Фуюки) Жарайды...
Dialogue: 0,0:49:27.00,0:49:29.25,Default,,0,0,0,,Одан гөрі бұл жерден тез кеткенім жөн...
Dialogue: 0,0:49:29.34,0:49:31.17,Default,,0,0,0,,Сәлем балалар
Dialogue: 0,0:49:31.76,0:49:34.68,Default,,0,0,0,,Осы уақытқа дейін келген болсаң, неге сәлем бермейсің?
Dialogue: 0,0:49:35.26,0:49:38.85,Default,,0,0,0,,Немесе Оракки тым жылы қарсы алды.
Dialogue: 0,0:49:38.93,0:49:40.68,Default,,0,0,0,,Күйіп қаламын дейсің бе?
Dialogue: 0,0:49:40.76,0:49:44.48,Default,,0,0,0,,Хмм, бұл жігіт шынымен де тітіркендіргіш.
Dialogue: 0,0:49:45.23,0:49:47.15,Default,,0,0,0,,Уайымдама, мен осы жерден қайтамын.
Dialogue: 0,0:49:47.23,0:49:48.11,Default,,0,0,0,,Гуну!
Dialogue: 0,0:49:48.19,0:49:49.77,Default,,0,0,0,,Мен саған бұлай істеуге рұқсат бермеймін.
Dialogue: 0,0:49:51.69,0:49:52.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:49:55.86,0:49:57.70,Default,,0,0,0,,Тосқауыл... Тосқауыл
Dialogue: 0,0:49:58.37,0:49:59.03,Default,,0,0,0,,Уф...
Dialogue: 0,0:49:59.12,0:50:01.12,Default,,0,0,0,,Си-васива-шива!
Dialogue: 0,0:50:01.20,0:50:02.37,Default,,0,0,0,,Реванш
Dialogue: 0,0:50:03.04,0:50:04.66,Default,,0,0,0,,Әзірше жоғары көтерілейік.
Dialogue: 0,0:50:06.62,0:50:10.59,Default,,0,0,0,,Ей, сен бізді жерге қайта жібермекшісің бе?
Dialogue: 0,0:50:10.67,0:50:13.42,Default,,0,0,0,,Уф... Куруру, қаруды бер.
Dialogue: 0,0:50:14.38,0:50:15.55,Default,,0,0,0,,Сәлем Куруру!
Dialogue: 0,0:50:16.05,0:50:17.05,Default,,0,0,0,,Бірақ, сендер—
Dialogue: 0,0:50:17.55,0:50:20.85,Default,,0,0,0,,Біреу менің компьютерімді бұзуда.
Dialogue: 0,0:50:22.10,0:50:23.39,Default,,0,0,0,,(Тодороки) Камино… (Камино) Жарайды, алдым.
Dialogue: 0,0:50:23.47,0:50:24.98,Default,,0,0,0,,Бақылау алынып тасталды
Dialogue: 0,0:50:25.06,0:50:28.02,Default,,0,0,0,,Хехе, пайдасыз жүйе
Dialogue: 0,0:50:28.10,0:50:29.06,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:50:29.56,0:50:32.48,Default,,0,0,0,,Сен менімен жарыспақсың ба?
Dialogue: 0,0:50:34.23,0:50:36.57,Default,,0,0,0,,Кук… Кукукукуккук
Dialogue: 0,0:50:40.45,0:50:42.49,Default,,0,0,0,,Қызық болып барады.
Dialogue: 0,0:50:44.04,0:50:46.37,Default,,0,0,0,,Тақта бұдан былай жұмыс істемейді!
Dialogue: 0,0:50:48.46,0:50:49.88,Default,,0,0,0,,Сол жерге түсейік
Dialogue: 0,0:50:49.96,0:50:52.71,Default,,0,0,0,,- Ағай! -Бәрің кетпеңдер!
Dialogue: 0,0:50:52.79,0:50:54.63,Default,,0,0,0,,Жарайды, мен сені қудым!
Dialogue: 0,0:50:54.71,0:50:55.96,Default,,0,0,0,,Ату
Dialogue: 0,0:50:58.68,0:51:00.68,Default,,0,0,0,,Кяаааааааааа!
Dialogue: 0,0:51:01.18,0:51:02.60,Default,,0,0,0,,Мырзалар көбірек!
Dialogue: 0,0:51:02.68,0:51:03.76,Default,,0,0,0,,Сержант...
Dialogue: 0,0:51:03.85,0:51:04.77,Default,,0,0,0,,Шинобу!
Dialogue: 0,0:51:05.77,0:51:06.31,Default,,0,0,0,,Ха!
Dialogue: 0,0:51:06.81,0:51:08.19,Default,,0,0,0,,Ta yo
Dialogue: 0,0:51:08.77,0:51:10.94,Default,,0,0,0,,Уау... уау
Dialogue: 0,0:51:11.02,0:51:12.31,Default,,0,0,0,,Ооо...
Dialogue: 0,0:51:12.40,0:51:16.53,Default,,0,0,0,,Күтілгендей, біз сыйымдылықтан асып кеттік!
Dialogue: 0,0:51:19.78,0:51:20.57,Default,,0,0,0,,Өте беделді адамды әкеліпсің ғой, иә?
Dialogue: 0,0:51:25.70,0:51:27.41,Default,,0,0,0,,Құсу?
Dialogue: 0,0:51:29.08,0:51:31.88,Default,,0,0,0,,Не... неге? Міне
Dialogue: 0,0:51:33.17,0:51:34.29,Default,,0,0,0,,(ысырманың ашылу дыбысы)
Dialogue: 0,0:51:39.76,0:51:42.01,Default,,0,0,0,,Гао!
Dialogue: 0,0:51:42.09,0:51:44.85,Default,,0,0,0,,- Иә? -Коюки-доно сен мұнда неге келдің?
Dialogue: 0,0:51:44.93,0:51:45.47,Default,,0,0,0,,Ах!
Dialogue: 0,0:51:49.94,0:51:51.90,Default,,0,0,0,,Не?!
Dialogue: 0,0:51:51.98,0:51:53.27,Default,,0,0,0,,- (Фуюки) Әпке! - Нацуми?
Dialogue: 0,0:51:53.36,0:51:54.82,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:51:54.90,0:51:56.32,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:51:56.90,0:51:58.36,Default,,0,0,0,,Бұл менің жоспарым
Dialogue: 0,0:51:58.44,0:52:01.24,Default,,0,0,0,,Арнайы орындардан ойынды тамашалаудан ләззат алыңыз.
Dialogue: 0,0:52:01.82,0:52:05.83,Default,,0,0,0,,Енді не істейміз? Маған жақынырақ қарауға рұқсат етіңіз
Dialogue: 0,0:52:09.50,0:52:11.46,Default,,0,0,0,,Екі ағай?
Dialogue: 0,0:52:11.54,0:52:14.33,Default,,0,0,0,,Бәріне де сол жігіт кінәлі ғой.
Dialogue: 0,0:52:14.42,0:52:17.30,Default,,0,0,0,,Бірақ неге оның жүзі капитан-дономен бірдей?
Dialogue: 0,0:52:17.38,0:52:18.84,Default,,0,0,0,,Құсу!
Dialogue: 0,0:52:18.92,0:52:21.88,Default,,0,0,0,,Тіпті мен не болып жатқанын білмеймін.
Dialogue: 0,0:52:21.97,0:52:24.76,Default,,0,0,0,,Сен кімсің?!
Dialogue: 0,0:52:24.85,0:52:26.10,Default,,0,0,0,,Мынау.
Dialogue: 0,0:52:26.18,0:52:26.81,Default,,0,0,0,,Құсу?
Dialogue: 0,0:52:26.89,0:52:29.35,Default,,0,0,0,,Биіктігі Салмағы Моль орны
Dialogue: 0,0:52:29.43,0:52:33.31,Default,,0,0,0,,Ұялы деңгей дәлдігімен бәрі капитанмен бірдей.
Dialogue: 0,0:52:33.40,0:52:36.73,Default,,0,0,0,,Бұл Керороның көшірмесі екенін білдіре ме?
Dialogue: 0,0:52:36.82,0:52:40.74,Default,,0,0,0,,Бірақ анау сержант ақылдырақ сияқты.
Dialogue: 0,0:52:40.82,0:52:41.65,Default,,0,0,0,,Түстен кейін Фудзисаваға қайтасың да, мектепке барасың, иә?
Dialogue: 0,0:52:41.74,0:52:44.82,Default,,0,0,0,,Шамасы, фейктер мәжбүр болады
Dialogue: 0,0:52:44.91,0:52:48.16,Default,,0,0,0,,Ультра-қысқа мерзімді қысып қалудың дәлелі бар.
Dialogue: 0,0:52:48.24,0:52:49.20,Default,,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:52:49.29,0:52:53.67,Default,,0,0,0,,Дарынды оқудан өтуге мәжбүр болған басқа сержантты айтасыз ба?
Dialogue: 0,0:52:53.75,0:52:55.75,Default,,0,0,0,,Тағы мен...
Dialogue: 0,0:52:55.83,0:52:57.34,Default,,0,0,0,,Құсу?
Dialogue: 0,0:52:58.13,0:52:59.67,Default,,0,0,0,,- (Коюки) Гао~! -(Нацуми) Эй!
Dialogue: 0,0:53:04.59,0:53:06.51,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:53:07.10,0:53:09.68,Default,,0,0,0,,Егер жағдай осылай жалғаса берсе, менің әпкем мен Хигашитани-сан...
Dialogue: 0,0:53:09.76,0:53:11.52,Default,,0,0,0,,Эй, мен ана жақта.
Dialogue: 0,0:53:11.60,0:53:14.14,Default,,0,0,0,,Біз мұндай нәрсені дереу тоқтатамыз!
Dialogue: 0,0:53:14.23,0:53:15.44,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:53:15.52,0:53:19.77,Default,,0,0,0,,Егер сіз де өзіңізді басқыншы деп атағыңыз келсе, неге ләззат алмасқа?
Dialogue: 0,0:53:19.86,0:53:20.61,Default,,0,0,0,,Міне
Dialogue: 0,0:53:20.69,0:53:21.57,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:53:22.36,0:53:23.95,Default,,0,0,0,,Олар да көңілді
Dialogue: 0,0:53:24.03,0:53:25.99,Default,,0,0,0,,Мен... Эй!
Dialogue: 0,0:53:26.49,0:53:28.16,Default,,0,0,0,,Хехе ахаха
Dialogue: 0,0:53:28.66,0:53:30.16,Default,,0,0,0,,Хе хе хе хе хе
Dialogue: 0,0:53:30.24,0:53:31.75,Default,,0,0,0,,- Қарғыс атсын - Ах
Dialogue: 0,0:53:31.83,0:53:33.96,Default,,0,0,0,,Джироро-доно, мен күтемін!
Dialogue: 0,0:53:34.04,0:53:34.92,Default,,0,0,0,,Әпке!
Dialogue: 0,0:53:36.04,0:53:37.21,Default,,0,0,0,,Иә.
Dialogue: 0,0:53:37.29,0:53:40.71,Default,,0,0,0,,Олар өмір сүре ме, өле ме, бәрі маған байланысты.
Dialogue: 0,0:53:41.21,0:53:44.42,Default,,0,0,0,,Билеушінің бұйрықтары абсолютті.
Dialogue: 0,0:53:44.51,0:53:46.34,Default,,0,0,0,,Фуфуфуфуфухуху…
Dialogue: 0,0:53:46.43,0:53:48.26,Default,,0,0,0,,Нацумиді ояту
Dialogue: 0,0:53:48.35,0:53:50.43,Default,,0,0,0,,Коюки-доно, тоқтат.
Dialogue: 0,0:53:50.51,0:53:51.64,Default,,0,0,0,,Мәнсіз даулар...
Dialogue: 0,0:53:51.72,0:53:52.43,Default,,0,0,0,,- (Коюки) Хи хи - Уау!
Dialogue: 0,0:53:52.52,0:53:53.60,Default,,0,0,0,,Нацуми...
Dialogue: 0,0:53:53.68,0:53:54.43,Default,,0,0,0,,Нгю!
Dialogue: 0,0:53:54.52,0:53:56.35,Default,,0,0,0,,Фуфу аха... а?
Dialogue: 0,0:53:57.60,0:53:58.52,Default,,0,0,0,,Нацуми...
Dialogue: 0,0:53:59.27,0:54:00.57,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:54:01.07,0:54:03.49,Default,,0,0,0,,-Ко... Коюки-доно! -Тоқта... Тоқта, Нацуми!
Dialogue: 0,0:54:03.57,0:54:04.90,Default,,0,0,0,,Сізді күтуде
Dialogue: 0,0:54:04.99,0:54:06.82,Default,,0,0,0,,- Жироро Даттеба... - Коюки-доно!
Dialogue: 0,0:54:06.91,0:54:09.32,Default,,0,0,0,,-Тоқта... Тоқта, Нацуми! - Коюкидоно...
Dialogue: 0,0:54:09.41,0:54:12.37,Default,,0,0,0,,Не болды? Сіз ештеңе істей алмайсыз ба?
Dialogue: 0,0:54:12.87,0:54:15.83,Default,,0,0,0,,Хахахаха Эксперимент қажет емес
Dialogue: 0,0:54:15.91,0:54:18.58,Default,,0,0,0,,Бұл жігіттер билеушілер құқығынан айырылады.
Dialogue: 0,0:54:18.67,0:54:22.05,Default,,0,0,0,,Өйткені, мен нағыз билеушімін.
Dialogue: 0,0:54:22.13,0:54:25.63,Default,,0,0,0,,Хэхехе... хахахаха...
Dialogue: 0,0:54:26.26,0:54:28.55,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:54:30.68,0:54:33.64,Default,,0,0,0,,Біз бұлай жалғастыра алмаймыз, бірдеңе істеуіміз керек.
Dialogue: 0,0:54:33.72,0:54:36.43,Default,,0,0,0,,Ойланып қарашы, Хуки неге сонша сабырлы?
Dialogue: 0,0:54:36.52,0:54:37.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:37.64,0:54:40.61,Default,,0,0,0,,Біз керондықтардан басқаның бәрі жынды болды.
Dialogue: 0,0:54:41.36,0:54:43.40,Default,,0,0,0,,Ойланып қарасам, неге?
Dialogue: 0,0:54:43.90,0:54:45.94,Default,,0,0,0,,Бірақ мен де жақсымын.
Dialogue: 0,0:54:46.03,0:54:46.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:47.99,0:54:48.74,Default,,0,0,0,,Ах!
Dialogue: 0,0:54:50.82,0:54:52.62,Default,,0,0,0,,Мен бұл білезіктің...
Dialogue: 0,0:54:52.70,0:54:55.37,Default,,0,0,0,,Иә, бұл ағамның сыйы еді.
Dialogue: 0,0:54:55.45,0:54:56.00,Default,,0,0,0,,(Үлкен сағаттың соққы дыбысы)
Dialogue: 0,0:54:56.08,0:54:56.96,Default,,0,0,0,,сержант.
Dialogue: 0,0:54:57.04,0:54:59.79,Default,,0,0,0,,Бұл менде де болған шығар...
Dialogue: 0,0:54:59.87,0:55:01.33,Default,,0,0,0,,Менің әмияным
Dialogue: 0,0:55:01.42,0:55:04.34,Default,,0,0,0,,Басқаша айтқанда, сізде Керон планетасынан бір нәрсе болса.
Dialogue: 0,0:55:04.42,0:55:06.17,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:55:06.26,0:55:07.13,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:55:07.22,0:55:09.22,Default,,0,0,0,,Осыны қолданып көрейік
Dialogue: 0,0:55:09.30,0:55:10.43,Default,,0,0,0,,Иә
Dialogue: 0,0:55:12.93,0:55:16.43,Default,,0,0,0,,Хаха! Кероро-сама~
Dialogue: 0,0:55:16.52,0:55:17.23,Default,,0,0,0,,О...
Dialogue: 0,0:55:18.18,0:55:18.73,Default,,0,0,0,,Жарайды, міне.
Dialogue: 0,0:55:19.48,0:55:21.02,Default,,0,0,0,,Иә? Мен не істеп жатырмын...
Dialogue: 0,0:55:21.10,0:55:22.36,Default,,0,0,0,,О~
Dialogue: 0,0:55:22.44,0:55:24.32,Default,,0,0,0,,-Са - (Фуюки) Хаха~!
Dialogue: 0,0:55:24.40,0:55:26.11,Default,,0,0,0,,-Эй-(Фуюки) Не, сержант?
Dialogue: 0,0:55:26.19,0:55:27.15,Default,,0,0,0,,-Саа - (Фуюки) Хаха~!
Dialogue: 0,0:55:27.24,0:55:28.07,Default,,0,0,0,,-Эй-(Фуюки) Ой?
Dialogue: 0,0:55:28.15,0:55:29.45,Default,,0,0,0,,-Са - (Фуюки) Хаха~!
Dialogue: 0,0:55:29.53,0:55:30.45,Default,,0,0,0,,-Эй-(Фуюки) Иә?
Dialogue: 0,0:55:30.53,0:55:32.70,Default,,0,0,0,,Радиотолқындардың құпиясы шешілді!
Dialogue: 0,0:55:34.12,0:55:34.99,Default,,0,0,0,,Джироро!
Dialogue: 0,0:55:35.79,0:55:36.87,Default,,0,0,0,,Дороро!
Dialogue: 0,0:55:36.95,0:55:38.87,Default,,0,0,0,,Нацуми-доно мен Коюки-доноға
Dialogue: 0,0:55:38.96,0:55:42.00,Default,,0,0,0,,Бәрі жақсы, мен саған Keron Star тауарларын әкелемін!
Dialogue: 0,0:55:42.08,0:55:43.00,Default,,0,0,0,,(Үкідің ұлуы)
Dialogue: 0,0:55:43.08,0:55:45.05,Default,,0,0,0,,Star Keron тауарлары ше?
Dialogue: 0,0:55:45.55,0:55:47.76,Default,,0,0,0,,Сонда да...
Dialogue: 0,0:55:47.84,0:55:48.92,Default,,0,0,0,,Жерде не...
Dialogue: 0,0:55:49.01,0:55:49.97,Default,,0,0,0,,Құсу…
Dialogue: 0,0:55:50.05,0:55:52.64,Default,,0,0,0,,Ефрейторда белбеу, Доророда қылыш бар!
Dialogue: 0,0:55:52.72,0:55:53.89,Default,,0,0,0,,Жарайды
Dialogue: 0,0:55:53.97,0:55:54.93,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:55:56.47,0:55:57.10,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:55:58.73,0:56:00.60,Default,,0,0,0,,Иә? Мен кіммін...
Dialogue: 0,0:56:00.69,0:56:02.98,Default,,0,0,0,,Ой, бұл не балға?
Dialogue: 0,0:56:03.06,0:56:05.11,Default,,0,0,0,,Уау, қандай көрініс!
Dialogue: 0,0:56:05.19,0:56:05.98,Default,,0,0,0,,Нацуми-сан!
Dialogue: 0,0:56:06.57,0:56:08.15,Default,,0,0,0,,Коюки-чан Дороро
Dialogue: 0,0:56:08.23,0:56:09.57,Default,,0,0,0,,Ал Жироро?
Dialogue: 0,0:56:09.65,0:56:10.49,Default,,0,0,0,,Не… Не істеп жатырсың!?
Dialogue: 0,0:56:10.57,0:56:13.82,Default,,0,0,0,,Бұл туралы кейінірек! Әйтеуір, қазір қашып жүрмін.
Dialogue: 0,0:56:13.91,0:56:14.49,Default,,0,0,0,,Кел!
Dialogue: 0,0:56:14.57,0:56:16.45,Default,,0,0,0,,Не?
Dialogue: 0,0:56:16.53,0:56:18.75,Default,,0,0,0,,-Жүр, тезірек - (Нацуми) Эй...күте тұр!
Dialogue: 0,0:56:19.37,0:56:21.00,Default,,0,0,0,,Міне.
Dialogue: 0,0:56:22.58,0:56:25.25,Default,,0,0,0,,- (Қара Кероро) Хун - (Шивава) О, ау!
Dialogue: 0,0:56:25.34,0:56:28.63,Default,,0,0,0,,Кешіріңіз, белбеусіз күш жоқ...
Dialogue: 0,0:56:28.71,0:56:29.76,Default,,0,0,0,,Ах
Dialogue: 0,0:56:31.51,0:56:32.47,Default,,0,0,0,,Ха…
Dialogue: 0,0:56:37.22,0:56:39.60,Default,,0,0,0,,Берілме, құтылу жоқ.
Dialogue: 0,0:56:39.68,0:56:40.43,Default,,0,0,0,,Түсіру
Dialogue: 0,0:56:40.93,0:56:42.77,Default,,0,0,0,,Сіз Фуюкисіз бе?
Dialogue: 0,0:56:43.27,0:56:45.02,Default,,0,0,0,,Мұны істеу өте оңай емес пе?
Dialogue: 0,0:56:45.86,0:56:47.02,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,0:56:47.65,0:56:49.90,Default,,0,0,0,,Тамама, белгі берсем
Dialogue: 0,0:56:49.98,0:56:51.90,Default,,0,0,0,,Осы ысырманы Tamama Impact көмегімен пайдаланыңыз...
Dialogue: 0,0:56:51.99,0:56:52.53,Default,,0,0,0,,Тама?
Dialogue: 0,0:56:52.61,0:56:54.53,Default,,0,0,0,,Нені жасырып тұрсың!
Dialogue: 0,0:56:54.61,0:56:55.28,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:56:55.37,0:56:56.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:56.87,0:57:00.41,Default,,0,0,0,,Егер сізде сержанттың жүрегінде шамалы болса да.
Dialogue: 0,0:57:00.50,0:57:01.20,Default,,0,0,0,,Құсу?
Dialogue: 0,0:57:01.79,0:57:05.08,Default,,0,0,0,,Сіз бұл Гунпланы жалғыз қалдыра алмайсыз!
Dialogue: 0,0:57:07.59,0:57:09.17,Default,,0,0,0,,Тамама қазір.
Dialogue: 0,0:57:09.25,0:57:11.05,Default,,0,0,0,,-Уау! -Бірақ сержант-сан...
Dialogue: 0,0:57:11.13,0:57:13.17,Default,,0,0,0,,Жоқ, сержант жауап береді!
Dialogue: 0,0:57:13.26,0:57:14.80,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:57:14.88,0:57:15.84,Default,,0,0,0,,Шива~!
Dialogue: 0,0:57:15.93,0:57:18.56,Default,,0,0,0,,Бұл шартты рефлекс болды...
Dialogue: 0,0:57:18.64,0:57:21.31,Default,,0,0,0,,Енді, қош бол RX-78!
Dialogue: 0,0:57:21.39,0:57:22.77,Default,,0,0,0,,Өрту
Dialogue: 0,0:57:23.27,0:57:24.98,Default,,0,0,0,,Құсу!
Dialogue: 0,0:57:25.48,0:57:26.31,Default,,0,0,0,,Бугио
Dialogue: 0,0:57:26.81,0:57:27.90,Default,,0,0,0,,Сержант!
Dialogue: 0,0:57:32.40,0:57:33.57,Default,,0,0,0,,Ком-Омбодағы адам да шынайы емес пе еді?
Dialogue: 0,0:57:37.99,0:57:39.78,Default,,0,0,0,,Фуюки Бөке бақа!
Dialogue: 0,0:57:41.33,0:57:43.00,Default,,0,0,0,,Балалар!
Dialogue: 0,0:57:44.25,0:57:46.62,Default,,0,0,0,,Ух... ауырсыну ұстамасы
Dialogue: 0,0:57:47.13,0:57:48.63,Default,,0,0,0,,Мен Оратчидің қашып кетуіне жол бермеймін!
Dialogue: 0,0:57:52.46,0:57:53.21,Default,,0,0,0,,Ах
Dialogue: 0,0:57:55.30,0:57:56.97,Default,,0,0,0,,Барлығы осылай!
Dialogue: 0,0:57:57.05,0:57:59.22,Default,,0,0,0,,Асығыңыз, міне, міне!
Dialogue: 0,0:58:01.72,0:58:03.93,Default,,0,0,0,,- Фуюки-доно, не деген... - (Фуюки) Жарайды.
Dialogue: 0,0:58:04.02,0:58:06.39,Default,,0,0,0,,О, бұл…
Dialogue: 0,0:58:07.60,0:58:08.48,Default,,0,0,0,,Шива?
Dialogue: 0,0:58:08.56,0:58:11.40,Default,,0,0,0,,Уау!
Dialogue: 0,0:58:16.24,0:58:17.03,Default,,0,0,0,,Чикишо~
Dialogue: 0,0:58:17.11,0:58:19.99,Default,,0,0,0,,Сен қайда жасырдың? Бұл ұят болса да!
Dialogue: 0,0:58:20.53,0:58:23.50,Default,,0,0,0,,Мируру Жеткілікті, Колизейдің қуатын өшіріңіз.
Dialogue: 0,0:58:23.58,0:58:24.16,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:58:40.72,0:58:41.47,Default,,0,0,0,,Фу…
Dialogue: 0,0:58:42.26,0:58:44.14,Default,,0,0,0,,Хехе...
Dialogue: 0,0:58:44.93,0:58:46.52,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:58:47.31,0:58:49.48,Default,,0,0,0,,Хахахаха...
Dialogue: 0,0:58:49.56,0:58:52.57,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:58:53.07,0:58:55.99,Default,,0,0,0,,Қайырлы түн Кероро-сама
Dialogue: 0,0:58:56.07,0:58:57.45,Default,,0,0,0,,Кероро-сама
Dialogue: 0,0:58:57.53,0:59:00.11,Default,,0,0,0,,- (Ана/Әке) Қайырлы түн - (Бала) Қайырлы түн
Dialogue: 0,0:59:00.20,0:59:03.49,Default,,0,0,0,,Қайырлы түн Кероро-сама
Dialogue: 0,0:59:04.20,0:59:06.50,Default,,0,0,0,,Хахахаха...
Dialogue: 0,0:59:06.58,0:59:08.04,Default,,0,0,0,,Ағам еңкейсе де
Dialogue: 0,0:59:08.12,0:59:11.21,Default,,0,0,0,,Күлгенім үшін кешіріңіз. Кешіріңіз. кешіріңіз...
Dialogue: 0,0:59:13.17,0:59:18.88,Default,,0,0,0,,Қайырлы түн, Кероро-сама Қайырлы түн, Кероро-сама...
Dialogue: 0,0:59:33.77,0:59:37.40,Default,,0,0,0,,«Кероро-сама, Кероро-сама» өте жақсы емес, солай ма?
Dialogue: 0,0:59:38.61,0:59:39.99,Default,,0,0,0,,Мұнда не болып жатыр? Куруру
Dialogue: 0,0:59:40.07,0:59:42.12,Default,,0,0,0,,Кукуку, ол теңшеуге жарамды.
Dialogue: 0,0:59:42.20,0:59:43.95,Default,,0,0,0,,Мен мүмкіндігінше асығуға тырысамын.
Dialogue: 0,0:59:44.03,0:59:45.66,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:59:45.74,0:59:48.91,Default,,0,0,0,,Кімге алаңдайсыз? Куккукук...
Dialogue: 0,0:59:49.41,0:59:53.04,Default,,0,0,0,,Ху~ Бір кезде мен өлемін деп ойладым.
Dialogue: 0,0:59:53.13,0:59:55.80,Default,,0,0,0,,Бірақ жер астында осындай жер болды ма?
Dialogue: 0,0:59:55.88,0:59:57.67,Default,,0,0,0,,Джироро, жақсысың ба?
Dialogue: 0,0:59:57.76,0:59:59.22,Default,,0,0,0,,Иә? Күрсін...
Dialogue: 0,0:59:59.30,1:00:01.13,Default,,0,0,0,,Мен мұны бәрібір қайтарамын.
Dialogue: 0,1:00:01.22,1:00:04.39,Default,,0,0,0,,Жарайды... күте тұрыңыз, сосын тағы сіз...
Dialogue: 0,1:00:04.47,1:00:07.06,Default,,0,0,0,,Бірақ бұл жылдамдықпен сіз десіз.
Dialogue: 0,1:00:07.14,1:00:07.77,Default,,0,0,0,,Аа...
Dialogue: 0,1:00:08.27,1:00:10.73,Default,,0,0,0,,Сонымен... дұрыс, мынау.
Dialogue: 0,1:00:12.23,1:00:13.65,Default,,0,0,0,,Ух... иә
Dialogue: 0,1:00:14.77,1:00:17.57,Default,,0,0,0,,Енді бәрі жақсы, солай ма?
Dialogue: 0,1:00:20.57,1:00:23.16,Default,,0,0,0,,Wow~ Жоғары жылдамдықты қайталанатын көлденең секіру!
Dialogue: 0,1:00:23.24,1:00:26.95,Default,,0,0,0,,-(Коюки) Сонда біз де -алмасамыз.
Dialogue: 0,1:00:28.16,1:00:30.79,Default,,0,0,0,,Бұл біраз жеңілдеткен сияқты.
Dialogue: 0,1:00:30.87,1:00:32.04,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,1:00:32.12,1:00:34.71,Default,,0,0,0,,Менің қарным ашты...
Dialogue: 0,1:00:34.79,1:00:36.79,Default,,0,0,0,,- Жарайды, ағай - Құсу?
Dialogue: 0,1:00:37.38,1:00:39.67,Default,,0,0,0,,Ұзақ шайқас болатын сияқты...
Dialogue: 0,1:00:39.76,1:00:43.01,Default,,0,0,0,,Жақсы! Мен түскі ас қорабын жасадым
Dialogue: 0,1:00:43.09,1:00:44.76,Default,,0,0,0,,Дәлірек айтсақ, махаббаттың түскі қорабы?
Dialogue: 0,1:00:44.84,1:00:47.60,Default,,0,0,0,,Уау, Моа-чан күткендей
Dialogue: 0,1:00:53.65,1:00:56.15,Default,,0,0,0,,Иә? Эй, Тамама ше?
Dialogue: 0,1:01:01.65,1:01:03.07,Default,,0,0,0,,Момочи...
Dialogue: 0,1:01:04.66,1:01:06.41,Default,,0,0,0,,Си-васива-шива!
Dialogue: 0,1:01:06.49,1:01:08.62,Default,,0,0,0,,Қосалқы рөлдер керемет.
Dialogue: 0,1:01:10.54,1:01:11.87,Default,,0,0,0,,Тамама-сан
Dialogue: 0,1:01:11.95,1:01:14.54,Default,,0,0,0,,Түскі ас алғыңыз келе ме?
Dialogue: 0,1:01:14.62,1:01:16.04,Default,,0,0,0,,Енді ол менікі
Dialogue: 0,1:01:16.13,1:01:19.09,Default,,0,0,0,,Сіз мені, бүйірлік кейіпкерді жалғыз қалдыра аласыз.
Dialogue: 0,1:01:19.17,1:01:20.30,Default,,0,0,0,,Жоқ
Dialogue: 0,1:01:20.38,1:01:22.88,Default,,0,0,0,,Тамама-сан сөзсіз басты кейіпкер.
Dialogue: 0,1:01:22.97,1:01:23.51,Default,,0,0,0,,Е...
Dialogue: 0,1:01:23.59,1:01:26.22,Default,,0,0,0,,Күшті қарсыластың пайда болуынан ренжіді
Dialogue: 0,1:01:26.30,1:01:30.60,Default,,0,0,0,,Бұрынғыдан да күшті болу үшін бұл жеңіліске шыдаңыз және жеңіңіз...
Dialogue: 0,1:01:30.68,1:01:32.43,Default,,0,0,0,,Дәлірек айтсақ, кеш гүлдеуші ме?
Dialogue: 0,1:01:32.52,1:01:36.23,Default,,0,0,0,,Кейіпкер жеңілісті жеңіп, күшейе түседі...
Dialogue: 0,1:01:36.73,1:01:40.65,Default,,0,0,0,,Мен мұны айтпай-ақ білдім!
Dialogue: 0,1:01:40.73,1:01:42.49,Default,,0,0,0,,Мен де жеймін!
Dialogue: 0,1:01:42.57,1:01:44.45,Default,,0,0,0,,А, мен ше?
Dialogue: 0,1:01:44.53,1:01:47.24,Default,,0,0,0,,Құсу, бірінші келгенге бірінші беріледі.
Dialogue: 0,1:01:47.32,1:01:49.37,Default,,0,0,0,,Дәлірек айтқанда, жасарту?
Dialogue: 0,1:01:49.95,1:01:51.37,Default,,0,0,0,,Ас үшін рахмет
Dialogue: 0,1:01:55.12,1:01:56.54,Default,,0,0,0,,Доруру күшті
Dialogue: 0,1:01:57.04,1:02:01.63,Default,,0,0,0,,Келесі жолы мен онымен жекпе-жекке шыққанда, менің жеңіске жету мүмкіндігім бар ма?
Dialogue: 0,1:02:02.80,1:02:04.30,Default,,0,0,0,,Мүмкін емес қалдықтар
Dialogue: 0,1:02:04.38,1:02:06.38,Default,,0,0,0,,Не болды, Жироро?
Dialogue: 0,1:02:06.47,1:02:07.72,Default,,0,0,0,,Сіздің де асқазаныңыз ауырады ма?
Dialogue: 0,1:02:07.80,1:02:08.76,Default,,0,0,0,,(Официант) Ж… Жоқ, мырза. Бұл «Неро» деп аталады➡
Dialogue: 0,1:02:08.85,1:02:11.31,Default,,0,0,0,,Онда дұрыс тамақтану керек.
Dialogue: 0,1:02:11.39,1:02:13.52,Default,,0,0,0,,Ақыр соңында, Моа-чан мен үшін жасады.
Dialogue: 0,1:02:13.60,1:02:15.39,Default,,0,0,0,,Мен... білемін.
Dialogue: 0,1:02:15.48,1:02:16.85,Default,,0,0,0,,Енді оралу
Dialogue: 0,1:02:17.35,1:02:20.15,Default,,0,0,0,,Сіз нақты не ойлап отырсыз?
Dialogue: 0,1:02:20.82,1:02:22.61,Default,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,1:02:23.11,1:02:24.19,Default,,0,0,0,,Уааах! Ол өліп қалды!
Dialogue: 0,1:02:24.28,1:02:28.11,Default,,0,0,0,,Басқа адам кім болса да, менің қорғайтын нәрсем бар.
Dialogue: 0,1:02:28.20,1:02:30.41,Default,,0,0,0,,Бұл жеңіліске жол бере алмайтынымызды білдіреді.
Dialogue: 0,1:02:32.12,1:02:34.37,Default,,0,0,0,,Сәлеметсіз бе, мені естисіз бе? Куруру
Dialogue: 0,1:02:35.08,1:02:37.96,Default,,0,0,0,,Бұл туралы не деуге болады? Сіз бірдеңе білдіңіз бе?
Dialogue: 0,1:02:38.04,1:02:39.38,Default,,0,0,0,,Аспазшы~
Dialogue: 0,1:02:39.46,1:02:42.09,Default,,0,0,0,,Мен қазір жұмыс істеп жатырмын, сондықтан қысқаша айтып беремін.
Dialogue: 0,1:02:42.17,1:02:44.17,Default,,0,0,0,,Бұл жалған капитан.
Dialogue: 0,1:02:44.26,1:02:47.93,Default,,0,0,0,,Анау тәкаппар мінез, ақымақсың, өзіңе мүсін жасап жатырсың.
Dialogue: 0,1:02:48.01,1:02:51.14,Default,,0,0,0,,Мұның бәрі ескіше, ол қалай істейді.
Dialogue: 0,1:02:51.22,1:02:53.01,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,1:02:53.10,1:02:55.89,Default,,0,0,0,,Бұл Жердің ескі билеушілеріне ұқсайды.
Dialogue: 0,1:02:55.98,1:02:57.14,Default,,0,0,0,,Мүлдем
Dialogue: 0,1:02:57.23,1:02:59.94,Default,,0,0,0,,Бұл өте көне басқыншылық стиль.
Dialogue: 0,1:03:00.02,1:03:02.40,Default,,0,0,0,,Иә? Ескі...
Dialogue: 0,1:03:02.90,1:03:03.86,Default,,0,0,0,,Ал егер бұл жігіт...
Dialogue: 0,1:03:05.36,1:03:06.44,Default,,0,0,0,,Міне, осы
Dialogue: 0,1:03:06.53,1:03:09.70,Default,,0,0,0,,Ежелгі Керон әскері Пекопонға жіберген аса құпия
Dialogue: 0,1:03:10.20,1:03:11.74,Default,,0,0,0,,Үшінші Кируру!
Dialogue: 0,1:03:11.82,1:03:13.49,Default,,0,0,0,,Үшінші Кируру?
Dialogue: 0,1:03:22.13,1:03:23.09,Default,,0,0,0,,Сол екеуі
Dialogue: 0,1:03:23.67,1:03:26.21,Default,,0,0,0,,Неліктен біз жақсы араласамыз?
Dialogue: 0,1:03:26.30,1:03:28.67,Default,,0,0,0,,Херониттер мен пекопониттер
Dialogue: 0,1:03:29.26,1:03:31.64,Default,,0,0,0,,Біздің нәсіліміз бен ұстанымымыз мүлде басқа болса да.
Dialogue: 0,1:03:33.47,1:03:35.60,Default,,0,0,0,,А... Хината Юки?
Dialogue: 0,1:03:36.10,1:03:38.52,Default,,0,0,0,,Осындай ұсақ-түйек адамға кімді қызметші етіп ұстауым керек?
Dialogue: 0,1:03:38.60,1:03:39.56,Default,,0,0,0,,Моттайнай
Dialogue: 0,1:03:39.64,1:03:41.56,Default,,0,0,0,,Не болды?
Dialogue: 0,1:03:41.65,1:03:44.15,Default,,0,0,0,,Біз ол адамдардың орналасқан жерін анықтадық.
Dialogue: 0,1:03:44.23,1:03:47.40,Default,,0,0,0,,Жарайды, Super Anti-Barrier пайдаланыңыз.
Dialogue: 0,1:03:47.49,1:03:49.70,Default,,0,0,0,,Ал маған Фуюкиді әкел
Dialogue: 0,1:03:50.36,1:03:51.57,Default,,0,0,0,,Нәсілдері әртүрлі болғанымен
Dialogue: 0,1:03:51.66,1:03:54.03,Default,,0,0,0,,Мен сізді взводымның бесінші мүшесі ретінде қарсы аламын.
Dialogue: 0,1:03:54.12,1:03:56.79,Default,,0,0,0,,Кируру, бізді соғысуға мәжбүр ет.
Dialogue: 0,1:03:56.87,1:03:58.91,Default,,0,0,0,,Сені жұлып алмақ болған жігіт емес пе?
Dialogue: 0,1:03:59.00,1:04:01.08,Default,,0,0,0,,Ежелгі Керон әскерінің теріс мұрасы⸺
Dialogue: 0,1:04:01.17,1:04:02.75,Default,,0,0,0,,Биологиялық қару Кируру
Dialogue: 0,1:04:02.83,1:04:05.92,Default,,0,0,0,,Пекопонда үш мәйіт қалды деген аңыз бар.
Dialogue: 0,1:04:06.00,1:04:09.30,Default,,0,0,0,,Біріншісін сержант екеуміз алып шығуымыз керек еді.
Dialogue: 0,1:04:09.38,1:04:13.26,Default,,0,0,0,,Мер мен Марле екіншісін де алып шығуы керек еді.
Dialogue: 0,1:04:13.34,1:04:15.97,Default,,0,0,0,,Бірінші бағдарлама – жауды оқшаулау.
Dialogue: 0,1:04:16.06,1:04:17.35,Default,,0,0,0,,Екіншісі жойылды.
Dialogue: 0,1:04:17.43,1:04:19.02,Default,,0,0,0,,Ал мына үшінші...
Dialogue: 0,1:04:20.48,1:04:22.19,Default,,0,0,0,,Керемет сызғыш
Dialogue: 0,1:04:22.27,1:04:24.27,Default,,0,0,0,,Толық сызғыш?
Dialogue: 0,1:04:24.36,1:04:24.98,Default,,0,0,0,,Иә
Dialogue: 0,1:04:25.06,1:04:27.86,Default,,0,0,0,,Оның көшірмелерін жасау үшін бағдарламаланған.
Dialogue: 0,1:04:27.94,1:04:30.65,Default,,0,0,0,,Хохо Міне менің көшірмесім...
Dialogue: 0,1:04:30.74,1:04:32.91,Default,,0,0,0,,Сізде қандай керемет!
Dialogue: 0,1:04:32.99,1:04:34.49,Default,,0,0,0,,Өлтіргіш қосқышты қосыңыз.
Dialogue: 0,1:04:34.57,1:04:37.45,Default,,0,0,0,,Осылайша капитан Мачу-Пикчу жертөлесінде итеріп кетті.
Dialogue: 0,1:04:37.54,1:04:38.66,Default,,0,0,0,,Куку куку куку куку
Dialogue: 0,1:04:38.74,1:04:42.08,Default,,0,0,0,,Демек, бәрібір сен кінәлі емессің!
Dialogue: 0,1:04:42.16,1:04:43.46,Default,,0,0,0,,Гегело~!
Dialogue: 0,1:04:43.54,1:04:46.29,Default,,0,0,0,,Кез келген жағдайда, егер сіз үшінші Кируруды жойсаңыз
Dialogue: 0,1:04:46.38,1:04:48.34,Default,,0,0,0,,Капитанның көшірмесі жоғалып кетуі керек.
Dialogue: 0,1:04:48.42,1:04:50.26,Default,,0,0,0,,Ол қайда?
Dialogue: 0,1:04:50.34,1:04:51.55,Default,,0,0,0,,Жер асты Мачу Пикчу?
Dialogue: 0,1:04:51.63,1:04:53.93,Default,,0,0,0,,Жоқ, жоқ, бұл Мачу Пикчу емес.
Dialogue: 0,1:04:54.01,1:04:56.72,Default,,0,0,0,,Үшінші Кирурудың демалатын орны...
Dialogue: 0,1:04:56.80,1:05:00.73,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:01.77,1:05:05.56,Default,,0,0,0,,Жоқ, әпке, сержант істен шыққан сияқты емес.
Dialogue: 0,1:05:05.65,1:05:07.32,Default,,0,0,0,,Мияу!
Dialogue: 0,1:05:07.40,1:05:09.94,Default,,0,0,0,,Хехе, бұл қауіпті жер еді.
Dialogue: 0,1:05:10.03,1:05:13.36,Default,,0,0,0,,Егер бұлай болса, мен сіздің ойыңызды білгім келеді.
Dialogue: 0,1:05:13.95,1:05:17.03,Default,,0,0,0,,Крул қиналған жаудың кім екенін анықтау
Dialogue: 0,1:05:17.12,1:05:21.62,Default,,0,0,0,,Олай болса, Кируру болсын, мен болсын, мына жігітті пайдалан.
Dialogue: 0,1:05:21.70,1:05:23.92,Default,,0,0,0,,Мен оны ұшырып жіберемін!
Dialogue: 0,1:05:24.71,1:05:26.33,Default,,0,0,0,,Нанора әмбебап қаруланған сусын
Dialogue: 0,1:05:26.83,1:05:29.55,Default,,0,0,0,,Сіз кез келген нәрсені себу арқылы қаруландыра аласыз.
Dialogue: 0,1:05:29.63,1:05:30.88,Default,,0,0,0,,Бұл жеткілікті!
Dialogue: 0,1:05:30.96,1:05:34.13,Default,,0,0,0,,Жоқ, бірақ мынаны пайдаланыңыз...
Dialogue: 0,1:05:34.22,1:05:37.22,Default,,0,0,0,,Біз Кируру қайда екенін де білмейміз.
Dialogue: 0,1:05:38.18,1:05:40.97,Default,,0,0,0,,Олай болса, мұндай нәрсе туралы не айтасыз?
Dialogue: 0,1:05:41.06,1:05:44.73,Default,,0,0,0,,Ең дұрысы, бәрі сол патшалық ауаға енуге тырысады.
Dialogue: 0,1:05:44.81,1:05:46.52,Default,,0,0,0,,Барлығы ханшайым кейпінде.
Dialogue: 0,1:05:46.60,1:05:49.36,Default,,0,0,0,,Сен сол тыңдау атын жамылып маған жақындайсың ба?
Dialogue: 0,1:05:49.44,1:05:51.19,Default,,0,0,0,,Мен жүргізушімін
Dialogue: 0,1:05:51.28,1:05:52.74,Default,,0,0,0,,Кім...
Dialogue: 0,1:05:52.82,1:05:54.78,Default,,0,0,0,,Түсіндім! мұнара!
Dialogue: 0,1:05:54.86,1:05:55.57,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:55.66,1:05:58.99,Default,,0,0,0,,Бұлттағы Нинпо ханшайымдарының сайысы!
Dialogue: 0,1:05:59.08,1:06:00.24,Default,,0,0,0,,Күтіңіз...
Dialogue: 0,1:06:04.50,1:06:06.50,Default,,0,0,0,,Ах...
Dialogue: 0,1:06:07.00,1:06:10.46,Default,,0,0,0,,Жарайды, негізгі қоршауға осылай кірейік!
Dialogue: 0,1:06:10.54,1:06:13.17,Default,,0,0,0,,-Ой! - Ақымақ болма!
Dialogue: 0,1:06:13.26,1:06:15.55,Default,,0,0,0,,Өте жақсы, солай емес пе?
Dialogue: 0,1:06:15.63,1:06:17.09,Default,,0,0,0,,-Ой! -Ой!
Dialogue: 0,1:06:19.22,1:06:19.76,Default,,0,0,0,,Құсу
Dialogue: 0,1:06:19.85,1:06:21.64,Default,,0,0,0,,- Иә? -(Коюки) Ах.
Dialogue: 0,1:06:21.72,1:06:24.18,Default,,0,0,0,,Уау... Иә?
Dialogue: 0,1:06:24.27,1:06:25.56,Default,,0,0,0,,Ах...
Dialogue: 0,1:06:26.89,1:06:28.48,Default,,0,0,0,,Бұл білезік...
Dialogue: 0,1:06:28.98,1:06:29.69,Default,,0,0,0,,Уау
Dialogue: 0,1:06:30.19,1:06:33.23,Default,,0,0,0,,Уф...
Dialogue: 0,1:06:34.69,1:06:36.99,Default,,0,0,0,,Ah~re~
Dialogue: 0,1:06:38.99,1:06:41.16,Default,,0,0,0,,Бітім, не деген?
Dialogue: 0,1:06:41.66,1:06:42.49,Default,,0,0,0,,Б-бірақ… сәби аман.
Dialogue: 0,1:06:42.99,1:06:45.50,Default,,0,0,0,,Не болып жатыр? Бұл
Dialogue: 0,1:06:46.00,1:06:49.00,Default,,0,0,0,,Сәлем бәріңе!
Dialogue: 0,1:06:49.08,1:06:50.88,Default,,0,0,0,,Сен қайда бардың?
Dialogue: 0,1:06:50.96,1:06:54.34,Default,,0,0,0,,Сержант! Әпке!
Dialogue: 0,1:06:54.42,1:06:55.84,Default,,0,0,0,,Хахахаха
Dialogue: 0,1:06:55.92,1:06:58.55,Default,,0,0,0,,Сіз супер тосқауылдың күшін көрдіңіз бе?
Dialogue: 0,1:06:59.34,1:07:03.35,Default,,0,0,0,,Енді бір-біріңіздің дауысын немесе сыртқы түрін тани алмайсыз.
Dialogue: 0,1:07:03.43,1:07:06.02,Default,,0,0,0,,Сонда... бәрі қайда?
Dialogue: 0,1:07:06.10,1:07:08.60,Default,,0,0,0,,Шындығында, біз әлі де жақынбыз.
Dialogue: 0,1:07:09.10,1:07:12.19,Default,,0,0,0,,Біз жақсы білетін «ерекше байланыстардың» күші
Dialogue: 0,1:07:12.27,1:07:13.77,Default,,0,0,0,,Бұл пішінсіз бе?
Dialogue: 0,1:07:13.86,1:07:15.99,Default,,0,0,0,,Арнайы байланыс?
Dialogue: 0,1:07:16.07,1:07:17.53,Default,,0,0,0,,Ах
Dialogue: 0,1:07:18.86,1:07:21.03,Default,,0,0,0,,Балалар, енді ешқашан болмайды
Dialogue: 0,1:07:21.12,1:07:23.41,Default,,0,0,0,,Біз бір-бірімізді көру үшін өмір сүре алмаймыз.
Dialogue: 0,1:07:23.49,1:07:25.20,Default,,0,0,0,,Жалғыздықтан азап шегу
Dialogue: 0,1:07:25.29,1:07:28.41,Default,,0,0,0,,Сізді итермелейтін қорқыныштан қашыңыз.
Dialogue: 0,1:07:33.04,1:07:33.84,Default,,0,0,0,,Дороро
Dialogue: 0,1:07:33.92,1:07:37.09,Default,,0,0,0,,Коюки-доно, түсіндім.
Dialogue: 0,1:07:37.59,1:07:41.22,Default,,0,0,0,,Ниндзя болу - жалғыз нәрсе және бұл дағдарыс - бұл мүмкіндік.
Dialogue: 0,1:07:42.14,1:07:46.64,Default,,0,0,0,,Қазір нағыз әлеуетімізді көрсетіп, жаудың қалтасына басатын кез.
Dialogue: 0,1:07:46.72,1:07:47.93,Default,,0,0,0,,Растау
Dialogue: 0,1:07:48.02,1:07:50.64,Default,,0,0,0,,Доророның ойларын көрмесем де түсінемін
Dialogue: 0,1:07:51.23,1:07:53.06,Default,,0,0,0,,- Шинобу - (Коюки) Шинобу!
Dialogue: 0,1:07:59.28,1:08:00.57,Default,,0,0,0,,(Фуюкидің жөтелі)
Dialogue: 0,1:08:03.99,1:08:06.49,Default,,0,0,0,,Иә? Керо доп...
Dialogue: 0,1:08:08.95,1:08:11.25,Default,,0,0,0,,(Мейірбике 1) Ә? Неге бұл кішкентай ит тілім-шайыр шайнап отыр?
Dialogue: 0,1:08:12.29,1:08:13.17,Default,,0,0,0,,Ах...
Dialogue: 0,1:08:18.76,1:08:21.43,Default,,0,0,0,,Бұл Мачу Пикчу жертөлесі...
Dialogue: 0,1:08:21.93,1:08:24.85,Default,,0,0,0,,Мүмкін Мачу Пикчу және мына қалқымалы қала
Dialogue: 0,1:08:24.93,1:08:28.47,Default,,0,0,0,,Олар кеңістікте қандай да бір күшпен байланысқан...
Dialogue: 0,1:08:28.56,1:08:31.81,Default,,0,0,0,,Дұрыс, мен оны өте жақсы байқадым.
Dialogue: 0,1:08:31.89,1:08:32.73,Default,,0,0,0,,Сен…
Dialogue: 0,1:08:32.81,1:08:35.15,Default,,0,0,0,,Бір күн бұрын
Dialogue: 0,1:08:35.23,1:08:39.07,Default,,0,0,0,,Бұл қалқымалы қаланың бір бөлігі құлап, Мачу-Пикчуға құлады.
Dialogue: 0,1:08:39.65,1:08:43.61,Default,,0,0,0,,Ол осы жерге сол гиперкеңістік қақпасы арқылы қосылды.
Dialogue: 0,1:08:44.11,1:08:45.95,Default,,0,0,0,,Гиперғарыш қақпасы?
Dialogue: 0,1:08:46.03,1:08:47.91,Default,,0,0,0,,Гиперғарыш қақпасы бастапқыда болды
Dialogue: 0,1:08:48.41,1:08:50.91,Default,,0,0,0,,Қалқымалы қала ішіндегі алыс жерлер арасындағы
Dialogue: 0,1:08:51.00,1:08:52.75,Default,,0,0,0,,Бұл жарлық болуы керек еді.
Dialogue: 0,1:08:53.33,1:08:55.33,Default,,0,0,0,,Оның осылай болғанына сене алар емеспін.
Dialogue: 0,1:08:55.42,1:08:57.04,Default,,0,0,0,,- (Фуюки) Түсіндім! -сурет?
Dialogue: 0,1:08:57.13,1:08:58.55,Default,,0,0,0,,Әрине, өткенде де
Dialogue: 0,1:08:58.63,1:09:01.17,Default,,0,0,0,,Мұнда қақпадан біреу келді.
Dialogue: 0,1:09:01.26,1:09:03.09,Default,,0,0,0,,Сондықтан мұндай мумия...
Dialogue: 0,1:09:03.18,1:09:06.47,Default,,0,0,0,,Мүмкін бұл қалқымалы қала мен Инка өркениеті арасында.
Dialogue: 0,1:09:06.55,1:09:08.35,Default,,0,0,0,,Қандай да бір өзара әрекеттесу болған болуы керек...
Dialogue: 0,1:09:08.43,1:09:09.85,Default,,0,0,0,,Хехе
Dialogue: 0,1:09:09.93,1:09:12.10,Default,,0,0,0,,Бұл болған болуы мүмкін.
Dialogue: 0,1:09:13.19,1:09:16.27,Default,,0,0,0,,Назка, сен кімсің?
Dialogue: 0,1:09:16.86,1:09:17.86,Default,,0,0,0,,Білгіңіз келе ме?
Dialogue: 0,1:09:18.36,1:09:20.99,Default,,0,0,0,,Олай болса менімен бірге жүр.
Dialogue: 0,1:09:21.07,1:09:22.49,Default,,0,0,0,,Эй, сәл күте тұрыңыз...
Dialogue: 0,1:09:23.20,1:09:24.41,Default,,0,0,0,,Жарайды
Dialogue: 0,1:09:25.61,1:09:27.12,Default,,0,0,0,,Кел, Фуюки...
Dialogue: 0,1:09:36.46,1:09:37.79,Default,,0,0,0,,Уф!Уф!
Dialogue: 0,1:09:38.29,1:09:40.17,Default,,0,0,0,,Уф... Хмф!
Dialogue: 0,1:09:40.25,1:09:42.30,Default,,0,0,0,,Болама, жоқ па?
Dialogue: 0,1:09:42.38,1:09:45.18,Default,,0,0,0,,Фуюки! Бұлыңғыр бақа!
Dialogue: 0,1:09:45.26,1:09:46.26,Default,,0,0,0,,Джироро~!
Dialogue: 0,1:09:46.34,1:09:50.18,Default,,0,0,0,,Барлығы~ Сен қайда бардың?
Dialogue: 0,1:09:50.89,1:09:53.77,Default,,0,0,0,,Маған бәріңізбен қандай да бір жолмен байланысуым керек.
Dialogue: 0,1:09:53.85,1:09:56.98,Default,,0,0,0,,Осы қарқынмен мен олармен бәсекелесе алмаймын.
Dialogue: 0,1:09:57.06,1:09:59.23,Default,,0,0,0,,Тіпті дұрыс қаруымыз болмаса да...
Dialogue: 0,1:09:59.94,1:10:02.11,Default,,0,0,0,,- (Нацуми) Қару? - қару?
Dialogue: 0,1:10:02.19,1:10:04.99,Default,,0,0,0,,- Қару? - қару?
Dialogue: 0,1:10:05.53,1:10:06.41,Default,,0,0,0,,Иә.
Dialogue: 0,1:10:06.49,1:10:07.62,Default,,0,0,0,,Қару туралы айта кетсеңіз!
Dialogue: 0,1:10:07.70,1:10:09.87,Default,,0,0,0,,Осындай кездерде де ұмыта алмаймын
Dialogue: 0,1:10:09.95,1:10:11.70,Default,,0,0,0,,Ол Колизейге құлады!
Dialogue: 0,1:10:11.79,1:10:14.71,Default,,0,0,0,,Бізде әлі күресуге мүмкіндік жоқ...
Dialogue: 0,1:10:16.67,1:10:17.96,Default,,0,0,0,,Мұны қазір жасаңыз!
Dialogue: 0,1:10:21.05,1:10:22.67,Default,,0,0,0,,Оян, Фуюки.
Dialogue: 0,1:10:24.01,1:10:25.17,Default,,0,0,0,,Наска?
Dialogue: 0,1:10:26.09,1:10:27.68,Default,,0,0,0,,Өтінемін, осы.
Dialogue: 0,1:10:29.72,1:10:31.56,Default,,0,0,0,,Ах...
Dialogue: 0,1:10:36.85,1:10:38.35,Default,,0,0,0,,Сізді көргеніме қуаныштымын, Фуюки.
Dialogue: 0,1:10:40.02,1:10:41.32,Default,,0,0,0,,Мені алдадың ба?
Dialogue: 0,1:10:42.02,1:10:43.53,Default,,0,0,0,,Мен сені алдамаймын.
Dialogue: 0,1:10:44.03,1:10:47.20,Default,,0,0,0,,Фуюки менің кім екенімді білгісі келді, солай ма?
Dialogue: 0,1:10:47.70,1:10:48.53,Default,,0,0,0,,Ах...
Dialogue: 0,1:10:53.20,1:10:53.99,Default,,0,0,0,,Хэхе…
Dialogue: 0,1:10:56.37,1:10:58.87,Default,,0,0,0,,Мируру, сен артта қал.
Dialogue: 0,1:10:58.96,1:10:59.96,Default,,0,0,0,,Га
Dialogue: 0,1:11:01.00,1:11:02.67,Default,,0,0,0,,Қорықпа
Dialogue: 0,1:11:03.17,1:11:04.38,Default,,0,0,0,,Тек сөйлесу үшін.
Dialogue: 0,1:11:05.21,1:11:08.80,Default,,0,0,0,,Негізі мен сізді қол астындағы қызметкер ретінде қарсы алуды шештім.
Dialogue: 0,1:11:08.88,1:11:10.01,Default,,0,0,0,,Бағыныңқысы?
Dialogue: 0,1:11:10.89,1:11:13.68,Default,,0,0,0,,Бұл менің патша ретіндегі бұйрығым.
Dialogue: 0,1:11:13.76,1:11:15.31,Default,,0,0,0,,Маған бағынушы бол
Dialogue: 0,1:11:16.31,1:11:20.40,Default,,0,0,0,,Пекопондық ретінде маған кеңес беріңізші.
Dialogue: 0,1:11:20.90,1:11:23.86,Default,,0,0,0,,Әрине, мен саған лайықты мәртебе мен билік беремін.
Dialogue: 0,1:11:23.94,1:11:26.15,Default,,0,0,0,,Кезекшілікте болмаған кезде
Dialogue: 0,1:11:26.24,1:11:30.20,Default,,0,0,0,,Кімге ілессем де, қайда барсам да, не істесем де шағымданбаймын.
Dialogue: 0,1:11:30.82,1:11:33.74,Default,,0,0,0,,Әлемнің жеті кереметі ме, сегіз кереметі ме.
Dialogue: 0,1:11:33.83,1:11:35.66,Default,,0,0,0,,Қанағаттанғанша зерттеңіз.
Dialogue: 0,1:11:36.25,1:11:38.66,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл жаман әңгіме емес.
Dialogue: 0,1:11:39.37,1:11:42.88,Default,,0,0,0,,Қарт патшаны ұмытып, маған ант ет.
Dialogue: 0,1:11:42.96,1:11:44.34,Default,,0,0,0,,Өлемін деп ойлайтын ешқандай жағдайға тап болған емеспін
Dialogue: 0,1:11:44.42,1:11:45.42,Default,,0,0,0,,Не?
Dialogue: 0,1:11:46.01,1:11:47.80,Default,,0,0,0,,Мен саған бағынышты болмаймын.
Dialogue: 0,1:11:47.88,1:11:50.38,Default,,0,0,0,,Сіз маған шабуыл жасамақшысыз ба?
Dialogue: 0,1:11:50.47,1:11:53.30,Default,,0,0,0,,Сізді тізеңізге отырғызу оңай.
Dialogue: 0,1:11:53.80,1:11:56.18,Default,,0,0,0,,Сізде Keron Star тауарлары бар ма?
Dialogue: 0,1:11:56.27,1:11:57.35,Default,,0,0,0,,Егер сіз оны алсаңыз ...
Dialogue: 0,1:11:57.43,1:12:00.81,Default,,0,0,0,,Олай етпесең, ешкім айналып кетпейді.
Dialogue: 0,1:12:00.89,1:12:02.73,Default,,0,0,0,,Бұл нағыз патша емес.
Dialogue: 0,1:12:04.40,1:12:07.07,Default,,0,0,0,,Оның үстіне сержанттар қайда?
Dialogue: 0,1:12:07.57,1:12:08.94,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:12:09.53,1:12:13.03,Default,,0,0,0,,Оны бағынышты болу үшін қиналсам да.
Dialogue: 0,1:12:13.53,1:12:15.91,Default,,0,0,0,,Неліктен ол кішіпейіл жігітті таңдар едіңіз?
Dialogue: 0,1:12:16.58,1:12:20.37,Default,,0,0,0,,Жарайды, онда мен кімнің қолында екенін көрсетемін!
Dialogue: 0,1:12:20.46,1:12:21.75,Default,,0,0,0,,Шивава Доруру
Dialogue: 0,1:12:21.83,1:12:24.63,Default,,0,0,0,,Оларды тауып, ұрып таста!
Dialogue: 0,1:12:24.71,1:12:26.00,Default,,0,0,0,,Шу!
Dialogue: 0,1:12:26.09,1:12:29.26,Default,,0,0,0,,Менің ойымша, сіз оны іздеуде қиналып жатқан шығарсыз, өйткені ол барлық жерде.
Dialogue: 0,1:12:29.34,1:12:31.88,Default,,0,0,0,,Тіпті бұйырмаса да
Dialogue: 0,1:12:31.97,1:12:35.14,Default,,0,0,0,,Егер Оракчиге ұнамаса, Оракки оны үрлеп жібереді!
Dialogue: 0,1:12:35.64,1:12:37.31,Default,,0,0,0,,- Тәуелсіздік - (Шивава) Чи…
Dialogue: 0,1:12:37.89,1:12:39.27,Default,,0,0,0,,О, балалар...
Dialogue: 0,1:12:39.35,1:12:41.10,Default,,0,0,0,,Іздеудің қажеті жоқ сияқты
Dialogue: 0,1:12:41.19,1:12:43.81,Default,,0,0,0,,Олар қашып жатқан жоқ немесе жасырынып жатқан жоқ.
Dialogue: 0,1:12:44.31,1:12:48.44,Default,,0,0,0,,Негізі олар жиналып жатыр.
Dialogue: 0,1:12:48.53,1:12:49.69,Default,,0,0,0,,- (Қараңғы Кероро) Не? -(Фуюки) А...
Dialogue: 0,1:12:51.03,1:12:51.95,Default,,0,0,0,,Бару керек
Dialogue: 0,1:12:52.53,1:12:53.24,Default,,0,0,0,,Мен бар екеніне сенімдімін!
Dialogue: 0,1:12:55.62,1:12:56.83,Default,,0,0,0,,Ағай ана жақта.
Dialogue: 0,1:12:58.37,1:13:00.58,Default,,0,0,0,,Тамама әсері!
Dialogue: 0,1:13:06.17,1:13:07.29,Default,,0,0,0,,болды
Dialogue: 0,1:13:07.38,1:13:11.51,Default,,0,0,0,,1/100 менің 2 RX-78!
Dialogue: 0,1:13:12.01,1:13:14.30,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,1:13:14.39,1:13:17.01,Default,,0,0,0,,Егер сіз оны жинап, оны қаруландыру үшін Nanora-ны қолдансаңыз...
Dialogue: 0,1:13:17.68,1:13:18.43,Default,,0,0,0,,оны міндетті түрде өлтіргісі келер еді.
Dialogue: 0,1:13:19.01,1:13:21.89,Default,,0,0,0,,Мен оны көрмеймін, бірақ Кероро осында екені анық!
Dialogue: 0,1:13:22.64,1:13:23.48,Default,,0,0,0,,Ура
Dialogue: 0,1:13:23.56,1:13:25.15,Default,,0,0,0,,Мен ойлағандай
Dialogue: 0,1:13:25.23,1:13:27.31,Default,,0,0,0,,Дәлірек айтқанда, қарапайым ойлау?
Dialogue: 0,1:13:27.40,1:13:30.36,Default,,0,0,0,,Әзірше мен сия салуға шыдап жүрмін.
Dialogue: 0,1:13:30.44,1:13:31.24,Default,,0,0,0,,Құсу?
Dialogue: 0,1:13:31.74,1:13:35.03,Default,,0,0,0,,Кім екенін білмеймін, бірақ олар келді.
Dialogue: 0,1:13:35.11,1:13:36.66,Default,,0,0,0,,Әй, мұнда да!
Dialogue: 0,1:13:36.74,1:13:38.53,Default,,0,0,0,,Сондай-ақ осында!
Dialogue: 0,1:13:40.24,1:13:41.04,Default,,0,0,0,,Бірақ былай қарасаңыз
Dialogue: 0,1:13:41.12,1:13:42.62,Default,,0,0,0,,Бұл өте қарапайым көрініс.
Dialogue: 0,1:13:43.12,1:13:46.50,Default,,0,0,0,,Ынтымақтастық үшін барлығыңызға рахмет!
Dialogue: 0,1:13:47.63,1:13:50.92,Default,,0,0,0,,Барлығы жасаған Гунпла - ең жақсы!
Dialogue: 0,1:13:51.00,1:13:52.05,Default,,0,0,0,,Құсу!
Dialogue: 0,1:13:52.13,1:13:55.47,Default,,0,0,0,,♪ Әділ ашу
Dialogue: 0,1:13:55.55,1:13:59.26,Default,,0,0,0,,♪ Gundam соққысы
Dialogue: 0,1:13:59.35,1:14:00.85,Default,,0,0,0,,Тек осы ғана қалды...
Dialogue: 0,1:14:00.93,1:14:02.64,Default,,0,0,0,,Нанора себіңіз
Dialogue: 0,1:14:02.72,1:14:04.06,Default,,0,0,0,,Нағыз қару!
Dialogue: 0,1:14:04.56,1:14:06.06,Default,,0,0,0,,Дәлірек айтқанда, мобильді костюм?
Dialogue: 0,1:14:06.15,1:14:08.31,Default,,0,0,0,,Неліктен? Мүмкін емес
Dialogue: 0,1:14:08.81,1:14:11.82,Default,,0,0,0,,Олар әлі күнге дейін бір-бірін мүлдем тани алмайды.
Dialogue: 0,1:14:11.90,1:14:14.74,Default,,0,0,0,,Енді жерде тұру уақыты келді
Dialogue: 0,1:14:15.65,1:14:16.91,Default,,0,0,0,,Уф...
Dialogue: 0,1:14:30.38,1:14:31.30,Default,,0,0,0,,Йомоя...
Dialogue: 0,1:14:31.80,1:14:35.63,Default,,0,0,0,,Менің қолымда 1/1 масштабты Гундам...
Dialogue: 0,1:14:35.72,1:14:36.30,Default,,0,0,0,,Уау
Dialogue: 0,1:14:36.38,1:14:39.60,Default,,0,0,0,,Осындай ойыншықпен сіз Оратчты жеңе аласыз!
Dialogue: 0,1:14:39.68,1:14:40.30,Default,,0,0,0,,Күлуді тоқтатыңыз
Dialogue: 0,1:14:40.39,1:14:43.22,Default,,0,0,0,,Бұл сөздерді ұмытпа
Dialogue: 0,1:14:44.10,1:14:46.10,Default,,0,0,0,,Бұл жай ойыншық емес
Dialogue: 0,1:14:46.19,1:14:49.94,Default,,0,0,0,,Гунпла - Пекопон халқының арманы мен технологиясының жемісі!
Dialogue: 0,1:14:51.52,1:14:54.48,Default,,0,0,0,,Олардың қауіпсіздігін қамтамасыз ететін уақыт жақындап қалды...
Dialogue: 0,1:14:55.44,1:14:57.32,Default,,0,0,0,,Қат! Қол жетпейді
Dialogue: 0,1:14:57.40,1:14:59.66,Default,,0,0,0,,Металзон Чар!
Dialogue: 0,1:15:03.79,1:15:04.54,Default,,0,0,0,,Әй!
Dialogue: 0,1:15:05.79,1:15:07.41,Default,,0,0,0,,Бос емес сияқтысың, Куруру.
Dialogue: 0,1:15:07.50,1:15:09.92,Default,,0,0,0,,Сабуро Сіз кешігіп қалдыңыз, солай емес пе?
Dialogue: 0,1:15:10.00,1:15:12.79,Default,,0,0,0,,Мечакуру мүсіндерін жаппай шығару үшін көп уақыт қажет болды.
Dialogue: 0,1:15:12.88,1:15:14.05,Default,,0,0,0,,Куку~цу
Dialogue: 0,1:15:14.13,1:15:17.34,Default,,0,0,0,,Бұл керемет дизайн. Бұл да сәл артық
Dialogue: 0,1:15:21.35,1:15:24.01,Default,,0,0,0,,Бұл не? Сондай ақымақ...
Dialogue: 0,1:15:24.10,1:15:25.47,Default,,0,0,0,,Алдын алу мүмкін емес!
Dialogue: 0,1:15:25.97,1:15:26.85,Default,,0,0,0,,Қый!
Dialogue: 0,1:15:26.93,1:15:28.85,Default,,0,0,0,,Жарайды, түсіндім!
Dialogue: 0,1:15:28.94,1:15:32.27,Default,,0,0,0,,Бастаманы қайтарыңыз! Меча Куруру мүсіні атылды!
Dialogue: 0,1:15:51.50,1:15:54.50,Default,,0,0,0,,Еңкейме, радиотолқын жібер!
Dialogue: 0,1:16:05.47,1:16:07.14,Default,,0,0,0,,Павел!
Dialogue: 0,1:16:07.22,1:16:09.39,Default,,0,0,0,,Иә, жас ханым~!
Dialogue: 0,1:16:10.35,1:16:12.31,Default,,0,0,0,,Кероро, кеттік!
Dialogue: 0,1:16:12.40,1:16:13.02,Default,,0,0,0,,Құсу?
Dialogue: 0,1:16:16.53,1:16:17.19,Default,,0,0,0,,Құсу!
Dialogue: 0,1:16:17.78,1:16:19.49,Default,,0,0,0,,Тегістеу – бұл...
Dialogue: 0,1:16:19.57,1:16:23.82,Default,,0,0,0,,Ой, мен шетке қарамай, тікелей негізгі қоршауға қарай бет алдым.
Dialogue: 0,1:16:23.91,1:16:25.12,Default,,0,0,0,,-Қызу-(Шивава) Кеттік!
Dialogue: 0,1:16:25.83,1:16:27.83,Default,,0,0,0,,Конняро, тоқта!
Dialogue: 0,1:16:27.91,1:16:30.25,Default,,0,0,0,,Құсу~ Біреу тоқтатсын!
Dialogue: 0,1:16:30.33,1:16:32.29,Default,,0,0,0,,Сіз бұл бағытта келе жатыр деп айтасыз ба?
Dialogue: 0,1:16:32.37,1:16:33.13,Default,,0,0,0,,Үйкелемеңіз
Dialogue: 0,1:16:33.79,1:16:36.13,Default,,0,0,0,,Мируру Оны атып тастаңыз.
Dialogue: 0,1:16:36.63,1:16:37.63,Default,,0,0,0,,Не болды? Мируру
Dialogue: 0,1:16:37.71,1:16:38.55,Default,,0,0,0,,Жауап беріңіз!
Dialogue: 0,1:16:38.63,1:16:41.43,Default,,0,0,0,,Ах... Әуе шабуылына қарсы қорғанысты түсіндім
Dialogue: 0,1:16:44.47,1:16:46.51,Default,,0,0,0,,А... бұл не?
Dialogue: 0,1:16:47.18,1:16:48.27,Default,,0,0,0,,Енді ше?
Dialogue: 0,1:16:48.35,1:16:50.64,Default,,0,0,0,,Зениттік қаруды басқару мүмкін емес
Dialogue: 0,1:16:50.73,1:16:51.31,Default,,0,0,0,,Гех?
Dialogue: 0,1:16:51.39,1:16:53.48,Default,,0,0,0,,Біреу саботаж жасады
Dialogue: 0,1:16:53.56,1:16:54.44,Default,,0,0,0,,…қашып кету…
Dialogue: 0,1:17:01.65,1:17:02.45,Default,,0,0,0,,Хмф!
Dialogue: 0,1:17:04.07,1:17:05.28,Default,,0,0,0,,Сондықтан, жас ханым,
Dialogue: 0,1:17:06.03,1:17:07.74,Default,,0,0,0,,Осыншама қиналғаның үшін рахмет. Рақмет.
Dialogue: 0,1:17:15.29,1:17:17.96,Default,,0,0,0,,-Кероро -Сержант-сан
Dialogue: 0,1:17:18.05,1:17:20.34,Default,,0,0,0,,- Ағай - (Нацуми) Бөке бақа
Dialogue: 0,1:17:20.42,1:17:21.63,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,1:17:23.22,1:17:24.22,Default,,0,0,0,,Тегістеу
Dialogue: 0,1:17:26.47,1:17:27.60,Default,,0,0,0,,Уау!
Dialogue: 0,1:17:28.10,1:17:28.93,Default,,0,0,0,,әріптес сарбаздардың жүрегіне үрей ұялататындай болды
Dialogue: 0,1:17:29.01,1:17:31.27,Default,,0,0,0,,Тек негізгі камера зақымдалған.
Dialogue: 0,1:17:31.35,1:17:31.89,Default,,0,0,0,,Құсу!
Dialogue: 0,1:17:44.11,1:17:46.41,Default,,0,0,0,,Куку куку куку куку!
Dialogue: 0,1:17:46.49,1:17:48.08,Default,,0,0,0,,Сіз күткендей, капитан.
Dialogue: 0,1:17:48.16,1:17:50.29,Default,,0,0,0,,Kururu? Сіз Курурусыз ба?
Dialogue: 0,1:17:50.37,1:17:53.46,Default,,0,0,0,,Одан да әлгі жалған жігіт.
Dialogue: 0,1:17:53.54,1:17:55.25,Default,,0,0,0,,Ол дәл сол жерде.
Dialogue: 0,1:17:55.33,1:17:56.04,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,1:17:56.12,1:17:58.59,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:18:01.88,1:18:03.09,Default,,0,0,0,,Ах...
Dialogue: 0,1:18:07.14,1:18:08.05,Default,,0,0,0,,Құсу!
Dialogue: 0,1:18:20.19,1:18:21.02,Default,,0,0,0,,Жеңіліс
Dialogue: 0,1:18:21.11,1:18:23.78,Default,,0,0,0,,Әй, енді не болады?
Dialogue: 0,1:18:23.86,1:18:25.11,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:18:25.61,1:18:27.03,Default,,0,0,0,,Иә! Ха!
Dialogue: 0,1:18:27.11,1:18:29.45,Default,,0,0,0,,Сержант, солай ма?
Dialogue: 0,1:18:29.53,1:18:30.33,Default,,0,0,0,,Сержант!
Dialogue: 0,1:18:30.41,1:18:33.29,Default,,0,0,0,,Тоқта! Мен мұны бәрібір ысырап деп айтамын.
Dialogue: 0,1:18:33.37,1:18:34.12,Default,,0,0,0,,Неге тоқтамайсың, Фуюки!
Dialogue: 0,1:18:34.71,1:18:37.33,Default,,0,0,0,,Құсу? Фуюки-доно осында ма?
Dialogue: 0,1:18:37.92,1:18:39.46,Default,,0,0,0,,Қарғыс атсын... Сержант?
Dialogue: 0,1:18:39.54,1:18:42.09,Default,,0,0,0,,Фуюки-доно, сен барсың ба?
Dialogue: 0,1:18:42.17,1:18:44.01,Default,,0,0,0,,Қайда? Сержант!
Dialogue: 0,1:18:44.09,1:18:46.17,Default,,0,0,0,,Уф...
Dialogue: 0,1:18:46.68,1:18:47.84,Default,,0,0,0,,Фуюки-доно!
Dialogue: 0,1:18:47.93,1:18:49.09,Default,,0,0,0,,Сержант!
Dialogue: 0,1:18:51.68,1:18:52.85,Default,,0,0,0,,Фуюки-доно!
Dialogue: 0,1:18:52.93,1:18:54.10,Default,,0,0,0,,Сержант!
Dialogue: 0,1:18:54.18,1:18:58.10,Default,,0,0,0,,Балалар!
Dialogue: 0,1:18:58.98,1:19:00.48,Default,,0,0,0,,- (Фуюки) Уау... - Құсу...
Dialogue: 0,1:19:00.56,1:19:03.53,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,1:19:08.07,1:19:13.20,Default,,0,0,0,,Бәрің... бәрің маған қарсы шықтыңдар.
Dialogue: 0,1:19:13.29,1:19:14.75,Default,,0,0,0,,Мен енді шыдай алмаймын!
Dialogue: 0,1:19:21.13,1:19:22.54,Default,,0,0,0,,Бұрау және ұсақтау
Dialogue: 0,1:19:25.30,1:19:26.80,Default,,0,0,0,,- (Фуюки) Уау... - Эй!
Dialogue: 0,1:19:27.42,1:19:28.93,Default,,0,0,0,,Сержант? Сержант!
Dialogue: 0,1:19:29.51,1:19:31.80,Default,,0,0,0,,Сіздің қарсыласыңыз – мен.
Dialogue: 0,1:19:31.89,1:19:34.56,Default,,0,0,0,,Маған айтудың қажеті жоқ!
Dialogue: 0,1:19:34.64,1:19:36.73,Default,,0,0,0,,Сержант~!
Dialogue: 0,1:19:46.15,1:19:47.82,Default,,0,0,0,,Тасымалдау аяқталды
Dialogue: 0,1:19:47.90,1:19:50.07,Default,,0,0,0,,Қашықтан басқару құралының жұмысына шектеулер бар
Dialogue: 0,1:19:50.16,1:19:51.53,Default,,0,0,0,,Тез кабинаға барыңыз
Dialogue: 0,1:19:51.62,1:19:54.24,Default,,0,0,0,,Кешіріңіз, Сабуро мырза.
Dialogue: 0,1:19:58.04,1:19:58.79,Default,,0,0,0,,Бұл…
Dialogue: 0,1:19:58.87,1:20:01.79,Default,,0,0,0,,Енді шарт 5 минут 5 минут
Dialogue: 0,1:20:02.33,1:20:04.75,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,1:20:04.84,1:20:06.21,Default,,0,0,0,,Сержант... Ах.
Dialogue: 0,1:20:07.84,1:20:08.97,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,1:20:26.73,1:20:28.44,Default,,0,0,0,,Сержант~!
Dialogue: 0,1:20:28.53,1:20:29.32,Default,,0,0,0,,Иә!
Dialogue: 0,1:20:29.82,1:20:30.36,Default,,0,0,0,,Уау
Dialogue: 0,1:20:37.62,1:20:38.25,Default,,0,0,0,,Бұл…
Dialogue: 0,1:20:38.83,1:20:39.50,Default,,0,0,0,,Ах
Dialogue: 0,1:20:44.58,1:20:46.29,Default,,0,0,0,,Грр!
Dialogue: 0,1:20:47.84,1:20:49.42,Default,,0,0,0,,Аяқтаңыз!
Dialogue: 0,1:20:51.01,1:20:52.93,Default,,0,0,0,,- (Фуюки) Не? -Фуюки-доно!
Dialogue: 0,1:20:53.01,1:20:54.39,Default,,0,0,0,,Сергітетін әрі көңілді көңіл-күй
Dialogue: 0,1:21:19.91,1:21:22.12,Default,,0,0,0,,(Изуку) Ах! (Гран Торино) Уа!
Dialogue: 0,1:21:26.04,1:21:27.42,Default,,0,0,0,,Шайқас аяқталды
Dialogue: 0,1:21:27.50,1:21:30.42,Default,,0,0,0,,Енді жеңілгенімізді мейіріммен мойындайық.
Dialogue: 0,1:21:31.42,1:21:35.22,Default,,0,0,0,,Шивава Друлу, дереу қайтып, маған қосыл.
Dialogue: 0,1:21:35.72,1:21:38.51,Default,,0,0,0,,Жоқ, Оратчи қазір бос емес.
Dialogue: 0,1:21:38.60,1:21:39.89,Default,,0,0,0,,Не...?
Dialogue: 0,1:21:40.52,1:21:42.52,Default,,0,0,0,,Сен үшін уайымдайтын уақытым жоқ!
Dialogue: 0,1:21:42.60,1:21:43.31,Default,,0,0,0,,бос емес
Dialogue: 0,1:21:43.39,1:21:44.77,Default,,0,0,0,,Гү…
Dialogue: 0,1:21:44.85,1:21:47.06,Default,,0,0,0,,Тама көздің бумасы... аааа
Dialogue: 0,1:21:47.15,1:21:48.11,Default,,0,0,0,,Тама~!
Dialogue: 0,1:21:48.61,1:21:51.48,Default,,0,0,0,,Нацуми және басқалары аман ба?
Dialogue: 0,1:21:51.57,1:21:52.28,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:21:53.53,1:21:55.61,Default,,0,0,0,,- (Байланыс: Крул) Сізді күткенім үшін кешіріңіз - Крул?
Dialogue: 0,1:21:55.70,1:21:59.16,Default,,0,0,0,,Қаруды тапсыру Егер сіз жоғары курста болсаңыз, жеткілікті.
Dialogue: 0,1:21:59.78,1:22:00.49,Default,,0,0,0,,Бұл жабысқақ курс.
Dialogue: 0,1:22:01.54,1:22:02.70,Default,,0,0,0,,Эй!
Dialogue: 0,1:22:04.37,1:22:05.21,Default,,0,0,0,,Уау...
Dialogue: 0,1:22:06.00,1:22:08.46,Default,,0,0,0,,Тамама әсері!
Dialogue: 0,1:22:08.54,1:22:11.59,Default,,0,0,0,,Сәлеметсіз бе, ойын аяқталды!
Dialogue: 0,1:22:12.21,1:22:14.88,Default,,0,0,0,,Себебі сіз сырттан көп сөйлейсіз.
Dialogue: 0,1:22:14.97,1:22:16.01,Default,,0,0,0,,Кедергі
Dialogue: 0,1:22:16.76,1:22:19.35,Default,,0,0,0,,Бұл... тіпті мына жігіттер мен туралы ойлайды...
Dialogue: 0,1:22:19.43,1:22:21.93,Default,,0,0,0,,Фуюки-кун... Фуюки-кун!
Dialogue: 0,1:22:22.56,1:22:23.85,Default,,0,0,0,,Сабуро мырза?
Dialogue: 0,1:22:24.43,1:22:26.35,Default,,0,0,0,,Амансың ба? мұқият тыңда
Dialogue: 0,1:22:26.44,1:22:29.73,Default,,0,0,0,,Бұдан былай сіз менің навигациямды орындап, сол жерден қашып кетесіз.
Dialogue: 0,1:22:29.81,1:22:31.69,Default,,0,0,0,,Бірақ сержант ше?
Dialogue: 0,1:22:31.78,1:22:33.82,Default,,0,0,0,,Ол сізден...
Dialogue: 0,1:22:33.90,1:22:34.44,Default,,0,0,0,,Ах
Dialogue: 0,1:22:38.03,1:22:38.62,Default,,0,0,0,,Сержант!
Dialogue: 0,1:22:38.70,1:22:41.08,Default,,0,0,0,,Тоқта, Фуюки-кун... Фуюки-кун!
Dialogue: 0,1:22:41.16,1:22:45.41,Default,,0,0,0,,Енді бұл туралы ойланыңыз және шабуылды дереу тоқтатыңыз.
Dialogue: 0,1:22:45.50,1:22:48.54,Default,,0,0,0,,Хехе... Бұл мүмкін емес сұрақ.
Dialogue: 0,1:22:49.04,1:22:51.88,Default,,0,0,0,,Өйткені менің бұйрықтарымды ешкім тыңдамайды.
Dialogue: 0,1:22:51.96,1:22:52.84,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,1:22:53.88,1:22:55.42,Default,,0,0,0,,Маған не жетіспейді?
Dialogue: 0,1:22:55.92,1:22:58.01,Default,,0,0,0,,Не жетіспейді?
Dialogue: 0,1:22:58.68,1:23:01.39,Default,,0,0,0,,Егер бұл «арнайы байланыс» болса...
Dialogue: 0,1:23:01.89,1:23:04.22,Default,,0,0,0,,Маған шынайы күшіңді көрсет
Dialogue: 0,1:23:07.69,1:23:08.98,Default,,0,0,0,,А... құсу?
Dialogue: 0,1:23:10.06,1:23:11.94,Default,,0,0,0,,Е, тағы да білезік...
Dialogue: 0,1:23:12.02,1:23:15.32,Default,,0,0,0,,Супер тосқауылға қарсы максималды өнімділік!
Dialogue: 0,1:23:15.90,1:23:17.32,Default,,0,0,0,,Құсу!
Dialogue: 0,1:23:17.40,1:23:20.07,Default,,0,0,0,,Уау! Не... Бұл не!
Dialogue: 0,1:23:20.16,1:23:22.83,Default,,0,0,0,,Фуюки-доно!
Dialogue: 0,1:23:22.91,1:23:24.62,Default,,0,0,0,,Сержант~!
Dialogue: 0,1:23:24.70,1:23:29.50,Default,,0,0,0,,Уф... Сержант!
Dialogue: 0,1:23:37.09,1:23:38.38,Default,,0,0,0,,Ах...
Dialogue: 0,1:23:39.51,1:23:40.05,Default,,0,0,0,,Ha
Dialogue: 0,1:23:41.76,1:23:43.01,Default,,0,0,0,,сержант.
Dialogue: 0,1:23:43.51,1:23:46.06,Default,,0,0,0,,Сержант~!
Dialogue: 0,1:23:46.98,1:23:47.52,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,1:23:52.40,1:23:52.94,Default,,0,0,0,,Уф!
Dialogue: 0,1:23:56.99,1:23:58.49,Default,,0,0,0,,Ге~логергеро...
Dialogue: 0,1:23:59.20,1:24:01.74,Default,,0,0,0,,Осыны түсіндің бе, алаяқ?
Dialogue: 0,1:24:02.32,1:24:04.99,Default,,0,0,0,,Фуюки мен басқалардың өлуіне мүмкіндік беру ғана қалды...
Dialogue: 0,1:24:05.08,1:24:07.62,Default,,0,0,0,,Құсу! Фуюки, мен мұны білмей тұрып...
Dialogue: 0,1:24:07.70,1:24:09.12,Default,,0,0,0,,Сержант?
Dialogue: 0,1:24:09.21,1:24:10.83,Default,,0,0,0,,Оның аты Гран Торино
Dialogue: 0,1:24:10.92,1:24:13.63,Default,,0,0,0,,Бұл қалқымалы қала енді менікі.
Dialogue: 0,1:24:13.71,1:24:15.96,Default,,0,0,0,,Пекопон халқы түгел жойылды.
Dialogue: 0,1:24:16.05,1:24:18.84,Default,,0,0,0,,Еңбегіңіз үшін рахмет, Фуюки Хината.
Dialogue: 0,1:24:18.92,1:24:23.26,Default,,0,0,0,,Бірақ енді маған керегі жоқ. Мен бірінші сенен құтыламын.
Dialogue: 0,1:24:24.35,1:24:25.14,Default,,0,0,0,,Пәтуа жоқ
Dialogue: 0,1:24:25.22,1:24:26.85,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,1:24:26.93,1:24:29.23,Default,,0,0,0,,Бля саған, Фуюки Хината!
Dialogue: 0,1:24:29.31,1:24:31.44,Default,,0,0,0,,Мен алданбаймын!
Dialogue: 0,1:24:34.52,1:24:36.57,Default,,0,0,0,,Гррр... Гррр...
Dialogue: 0,1:24:38.11,1:24:41.24,Default,,0,0,0,,Кет, сен сержант емессің!
Dialogue: 0,1:24:44.16,1:24:45.95,Default,,0,0,0,,Джероро…
Dialogue: 0,1:24:46.58,1:24:47.33,Default,,0,0,0,,Құсу!
Dialogue: 0,1:24:48.58,1:24:49.25,Default,,0,0,0,,Сержант?
Dialogue: 0,1:24:49.33,1:24:51.00,Default,,0,0,0,,Фуюки-доно~!
Dialogue: 0,1:24:51.58,1:24:54.92,Default,,0,0,0,,Сержант! Бұл жолы шын
Dialogue: 0,1:24:55.00,1:24:55.75,Default,,0,0,0,,Сержант!
Dialogue: 0,1:24:55.84,1:24:56.88,Default,,0,0,0,,Фуюки-доно!
Dialogue: 0,1:24:57.46,1:24:58.17,Default,,0,0,0,,Уф...
Dialogue: 0,1:24:59.84,1:25:01.30,Default,,0,0,0,,-(Нацуми) Жироро -На... Нацуми!
Dialogue: 0,1:25:01.38,1:25:02.84,Default,,0,0,0,,Джироро Сенпай!
Dialogue: 0,1:25:02.93,1:25:06.05,Default,,0,0,0,,-Нацуми-сан! -(Нацуми) Тамама Моа-чан!
Dialogue: 0,1:25:08.18,1:25:09.31,Default,,0,0,0,,Уф, білезік...
Dialogue: 0,1:25:09.39,1:25:11.81,Default,,0,0,0,,- (Коюки) Дороро! - О, Коюки-доно!
Dialogue: 0,1:25:11.89,1:25:14.06,Default,,0,0,0,,Бұрын болған оқиғаның бәрі өтірік болды.
Dialogue: 0,1:25:14.15,1:25:18.11,Default,,0,0,0,,Маған жалған Фуюки-дононы да көрсетті.
Dialogue: 0,1:25:21.11,1:25:23.07,Default,,0,0,0,,Бұл ақымақтық
Dialogue: 0,1:25:23.57,1:25:26.49,Default,,0,0,0,,Тосқауылға қарсы әрекетті жояды, т.б.
Dialogue: 0,1:25:28.49,1:25:30.04,Default,,0,0,0,,Мен сені енді кешіре алмаймын
Dialogue: 0,1:25:30.54,1:25:31.12,Default,,0,0,0,,Ах...
Dialogue: 0,1:25:35.67,1:25:40.59,Default,,0,0,0,,Мына ақымақ сондай ақымақ!
Dialogue: 0,1:25:40.67,1:25:42.42,Default,,0,0,0,,Гррр…
Dialogue: 0,1:25:42.92,1:25:44.84,Default,,0,0,0,,Сен сияқты қорқаққа
Dialogue: 0,1:25:44.93,1:25:47.26,Default,,0,0,0,,Менің басқалардан жоғары тұруға құқығым жоқ.
Dialogue: 0,1:25:47.93,1:25:51.85,Default,,0,0,0,,Біліктілік туралы не деуге болады? Бұл маңызды емес
Dialogue: 0,1:25:52.35,1:25:54.73,Default,,0,0,0,,Мен бұл планетаның императорымын.
Dialogue: 0,1:25:54.81,1:25:58.69,Default,,0,0,0,,Мен ешкімнің пікірін тыңдамаймын, ешкімнен көмек сұрамаймын...
Dialogue: 0,1:25:58.77,1:26:02.28,Default,,0,0,0,,Егер бұл орын алса, мен істеуім керек
Dialogue: 0,1:26:02.36,1:26:05.03,Default,,0,0,0,,Мен бүкіл Пекопон халқын бас иемін!
Dialogue: 0,1:26:05.11,1:26:07.16,Default,,0,0,0,,құсу құсу құсу құсу құсу құсу құсу құсу құсу құсу құсу құсу құсу құсу құсу құсу құсу құсу құсу құсу құсу
Dialogue: 0,1:26:07.24,1:26:08.66,Default,,0,0,0,,Джерогеро Джерогеро Джерогеро Джерогеро
Dialogue: 0,1:26:08.74,1:26:09.49,Default,,0,0,0,,Героро…
Dialogue: 0,1:26:09.58,1:26:12.66,Default,,0,0,0,,Мен не істесем де, бұл онсыз да ысырап.
Dialogue: 0,1:26:12.75,1:26:14.33,Default,,0,0,0,,- (Қара кероро) Құсу! - Сәлем...
Dialogue: 0,1:26:14.41,1:26:16.79,Default,,0,0,0,,құсу құсу құсу құсу құсу құсу құсу құсу құсу құсу құсу құсу
Dialogue: 0,1:26:16.88,1:26:18.00,Default,,0,0,0,,Дженгеро~!
Dialogue: 0,1:26:18.08,1:26:18.96,Default,,0,0,0,,Уау...
Dialogue: 0,1:26:22.42,1:26:23.34,Default,,0,0,0,,Уау!
Dialogue: 0,1:26:24.05,1:26:27.51,Default,,0,0,0,,Уф... ақыры осындасың!
Dialogue: 0,1:26:27.59,1:26:28.14,Default,,0,0,0,,Іске қосу
Dialogue: 0,1:26:54.75,1:26:55.75,Default,,0,0,0,,Уау!
Dialogue: 0,1:26:55.83,1:26:58.63,Default,,0,0,0,,Құсу... Әй, не істеп жатырсың!
Dialogue: 0,1:26:58.71,1:27:02.30,Default,,0,0,0,,Фухахаха соңғы қару іске қосылды.
Dialogue: 0,1:27:02.38,1:27:03.88,Default,,0,0,0,,Соңғы қару?
Dialogue: 0,1:27:03.96,1:27:07.59,Default,,0,0,0,,Бұл мені қабылдай алмайтын ақымақтардың сыйы.
Dialogue: 0,1:27:08.09,1:27:10.89,Default,,0,0,0,,Мен жердегінің бәрін өртеп жіберемін!
Dialogue: 0,1:27:52.18,1:27:54.31,Default,,0,0,0,,... жер!
Dialogue: 0,1:27:54.39,1:27:55.22,Default,,0,0,0,,Құсу?
Dialogue: 0,1:27:57.31,1:27:58.98,Default,,0,0,0,,- (Фуюки) Уау... - Джеро...
Dialogue: 0,1:28:01.73,1:28:03.27,Default,,0,0,0,,- (Фуюки) Ух... - Құсу!
Dialogue: 0,1:28:03.36,1:28:03.90,Default,,0,0,0,,Ах
Dialogue: 0,1:28:04.73,1:28:05.65,Default,,0,0,0,,Сержант!
Dialogue: 0,1:28:08.19,1:28:10.70,Default,,0,0,0,,Сержант!
Dialogue: 0,1:28:12.57,1:28:14.03,Default,,0,0,0,,Бұл...
Dialogue: 0,1:28:19.00,1:28:20.83,Default,,0,0,0,,Гү…
Dialogue: 0,1:28:22.96,1:28:24.38,Default,,0,0,0,,Нацуми-сан!
Dialogue: 0,1:28:25.30,1:28:26.50,Default,,0,0,0,,Коюки-чан!
Dialogue: 0,1:28:26.59,1:28:28.63,Default,,0,0,0,,Дороро, біз бірдеңе істей алмаймыз ба?
Dialogue: 0,1:28:28.72,1:28:31.01,Default,,0,0,0,,Тіпті ниндзюцу да панацея емес.
Dialogue: 0,1:28:31.09,1:28:32.05,Default,,0,0,0,,Ах
Dialogue: 0,1:28:32.14,1:28:33.47,Default,,0,0,0,,Ағай!
Dialogue: 0,1:28:35.05,1:28:36.22,Default,,0,0,0,,Ах...
Dialogue: 0,1:28:36.31,1:28:38.56,Default,,0,0,0,,Жоқ! Дегозару ес-түссіз жатыр
Dialogue: 0,1:28:38.64,1:28:39.27,Default,,0,0,0,,Шинобу!
Dialogue: 0,1:28:39.77,1:28:41.64,Default,,0,0,0,,Ағай~!
Dialogue: 0,1:28:47.40,1:28:50.86,Default,,0,0,0,,Бұл... Бұл жолы мен мұны істей алмауым мүмкін.
Dialogue: 0,1:28:50.95,1:28:53.16,Default,,0,0,0,,Момочи~!
Dialogue: 0,1:28:53.66,1:28:55.37,Default,,0,0,0,,Лорд Тама~!
Dialogue: 0,1:28:55.95,1:28:57.37,Default,,0,0,0,,Хошу оқиғасынан екі күн өткен соң
Dialogue: 0,1:28:57.45,1:29:00.50,Default,,0,0,0,,Жартылай ұйықтап қалған уақытымның орнын толтырамын.
Dialogue: 0,1:29:01.75,1:29:02.29,Default,,0,0,0,,Тоуууу
Dialogue: 0,1:29:05.21,1:29:07.88,Default,,0,0,0,,Момочи! Барлығы әлі де...
Dialogue: 0,1:29:07.96,1:29:09.13,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,1:29:15.30,1:29:16.39,Default,,0,0,0,,Ораора ораора~!
Dialogue: 0,1:29:16.47,1:29:17.93,Default,,0,0,0,,- Уф - (Нацуми) Уау...
Dialogue: 0,1:29:18.51,1:29:19.56,Default,,0,0,0,,- Нува - (Нацуми) Ах...
Dialogue: 0,1:29:19.64,1:29:20.39,Default,,0,0,0,,- Уф - (Коюки) Уа
Dialogue: 0,1:29:22.48,1:29:24.02,Default,,0,0,0,,-Сабуро - (Сабуро) Мен білемін.
Dialogue: 0,1:29:24.10,1:29:25.27,Default,,0,0,0,,Гү…
Dialogue: 0,1:29:26.77,1:29:27.77,Default,,0,0,0,,Нгё!
Dialogue: 0,1:29:36.28,1:29:37.20,Default,,0,0,0,,Құсу
Dialogue: 0,1:29:37.28,1:29:39.08,Default,,0,0,0,,- Ағай - (Нацуми) Бөке бақа
Dialogue: 0,1:29:39.58,1:29:41.33,Default,,0,0,0,,Бұл жақын қоңырау болды.
Dialogue: 0,1:29:41.41,1:29:44.17,Default,,0,0,0,,Балалар, бақытты болсаңдар ше?
Dialogue: 0,1:29:44.25,1:29:45.25,Default,,0,0,0,,Мынаны қараңыз
Dialogue: 0,1:29:45.33,1:29:46.29,Default,,0,0,0,,Ах...
Dialogue: 0,1:30:27.79,1:30:29.71,Default,,0,0,0,,Тамама 2-сынып Момокаден
Dialogue: 0,1:30:29.79,1:30:30.96,Default,,0,0,0,,Сержант мырза!
Dialogue: 0,1:30:31.05,1:30:33.84,Default,,0,0,0,,Адамдардың бақшасына рұқсатсыз оғаш заттарды қоясың.
Dialogue: 0,1:30:33.92,1:30:37.05,Default,,0,0,0,,Бұл жер бетіндегінің бәрін өртеп жіберетін ең басты қару.
Dialogue: 0,1:30:37.14,1:30:37.93,Default,,0,0,0,,Иә?
Dialogue: 0,1:30:38.43,1:30:40.22,Default,,0,0,0,,Бүкіл жер? Немесе...
Dialogue: 0,1:30:40.30,1:30:41.18,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:30:51.94,1:30:54.07,Default,,0,0,0,,I... Біздің үй
Dialogue: 0,1:30:54.15,1:30:57.28,Default,,0,0,0,,Жоқ...жақсы, барлығы эвакуацияланды.
Dialogue: 0,1:30:57.36,1:30:58.20,Default,,0,0,0,,Момочи…
Dialogue: 0,1:31:11.50,1:31:13.84,Default,,0,0,0,,Нашар Сіз қалаға баруды жоспарлап отырсыз ба?
Dialogue: 0,1:31:14.59,1:31:18.26,Default,,0,0,0,,Барлық Шабдалы эскадрильяларына, алып Кероро мүсініне шабуылды тоқтатыңыз!
Dialogue: 0,1:31:18.84,1:31:19.72,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:31:31.90,1:31:32.69,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:31:33.44,1:31:35.03,Default,,0,0,0,,Фуюки әлі сонда ма?
Dialogue: 0,1:31:35.53,1:31:37.70,Default,,0,0,0,,Денім сау емес сияқты...
Dialogue: 0,1:31:37.78,1:31:38.86,Default,,0,0,0,,Негізінен, біз қашамыз.
Dialogue: 0,1:31:39.36,1:31:40.11,Default,,0,0,0,,Қандай жағымсыз!
Dialogue: 0,1:31:41.32,1:31:42.87,Default,,0,0,0,,- (Нацуми) Иә - Құсу
Dialogue: 0,1:31:42.95,1:31:44.08,Default,,0,0,0,,Менің мұны істеуден басқа амалым жоқ.
Dialogue: 0,1:31:44.16,1:31:45.04,Default,,0,0,0,,Иә
Dialogue: 0,1:31:45.12,1:31:46.00,Default,,0,0,0,,-Иә - (Ура Момока) Әй
Dialogue: 0,1:31:46.50,1:31:47.83,Default,,0,0,0,,Бұл анық.
Dialogue: 0,1:31:48.41,1:31:51.58,Default,,0,0,0,,Моа-чан, кешіріңіз, бірақ сіз маған көмектесе аласыз ба?
Dialogue: 0,1:31:51.67,1:31:52.21,Default,,0,0,0,,Жарайды
Dialogue: 0,1:31:53.29,1:31:53.96,Default,,0,0,0,,Польнарефф?
Dialogue: 0,1:31:54.46,1:31:57.22,Default,,0,0,0,,Балалар, такосуке, мынаны пайдаланыңыз.
Dialogue: 0,1:31:57.30,1:31:59.97,Default,,0,0,0,,Сол үлкен жігіттің аяқтарын тоқтатамыз.
Dialogue: 0,1:32:00.68,1:32:02.35,Default,,0,0,0,,Күте тұрыңыз, Фуюки.
Dialogue: 0,1:32:02.85,1:32:03.55,Default,,0,0,0,,Айқай?
Dialogue: 0,1:32:10.44,1:32:13.15,Default,,0,0,0,,-Жүр де кеттік -Ей!
Dialogue: 0,1:32:16.61,1:32:17.44,Default,,0,0,0,,Не?
Dialogue: 0,1:32:18.03,1:32:18.99,Default,,0,0,0,,Жақсарту
Dialogue: 0,1:32:24.37,1:32:25.37,Default,,0,0,0,,Шешуші шайқас
Dialogue: 0,1:32:26.41,1:32:28.37,Default,,0,0,0,,Бұл ақыры аяқталды.
Dialogue: 0,1:32:28.45,1:32:29.37,Default,,0,0,0,,Иә? Эй
Dialogue: 0,1:32:29.46,1:32:31.83,Default,,0,0,0,,Аа, солай сияқты.
Dialogue: 0,1:32:45.35,1:32:47.81,Default,,0,0,0,,Олар неге бұлай...
Dialogue: 0,1:32:48.35,1:32:49.23,Default,,0,0,0,,Ах
Dialogue: 0,1:32:49.81,1:32:52.77,Default,,0,0,0,,Сержант әпке бәріңіз!
Dialogue: 0,1:32:53.85,1:32:55.23,Default,,0,0,0,,Жақсы болды.
Dialogue: 0,1:32:55.73,1:32:57.19,Default,,0,0,0,,Неліктен...
Dialogue: 0,1:32:57.28,1:33:00.70,Default,,0,0,0,,Неліктен, неге, неге...
Dialogue: 0,1:33:00.78,1:33:02.20,Default,,0,0,0,,Білсін
Dialogue: 0,1:33:02.70,1:33:06.78,Default,,0,0,0,,Галактикалық Сигма Бір-Тәтті Сивава Арнайы!
Dialogue: 0,1:33:07.62,1:33:09.33,Default,,0,0,0,,Құсу!
Dialogue: 0,1:33:09.41,1:33:12.54,Default,,0,0,0,,Мұны маған қалдырыңыз, сержант мырза.
Dialogue: 0,1:33:12.62,1:33:13.96,Default,,0,0,0,,Бірақ содан кейін...
Dialogue: 0,1:33:14.04,1:33:15.59,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,1:33:15.67,1:33:16.21,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:33:16.29,1:33:18.55,Default,,0,0,0,,Мен... түсіндім.
Dialogue: 0,1:33:19.55,1:33:21.38,Default,,0,0,0,,Шива Шива
Dialogue: 0,1:33:21.47,1:33:23.51,Default,,0,0,0,,Орачиді бір-бірден жеңе алсаңыз да...
Dialogue: 0,1:33:23.59,1:33:24.89,Default,,0,0,0,,- (Ура Момока) Мен де осындамын! - (Шивава) Не?
Dialogue: 0,1:33:24.97,1:33:26.85,Default,,0,0,0,,Momoka Impact!
Dialogue: 0,1:33:27.43,1:33:28.14,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,1:33:28.22,1:33:30.89,Default,,0,0,0,,Қанша ұсақ шабақ жиналса да, бәрібір кішкентай шабақтар.
Dialogue: 0,1:33:30.98,1:33:31.52,Default,,0,0,0,,Оларды осы жаққа жіберіңізші.
Dialogue: 0,1:33:40.48,1:33:41.11,Default,,0,0,0,,Ақымақ
Dialogue: 0,1:33:45.32,1:33:45.87,Default,,0,0,0,,Муда
Dialogue: 0,1:33:46.62,1:33:47.37,Default,,0,0,0,,Джироро…
Dialogue: 0,1:33:47.45,1:33:49.49,Default,,0,0,0,,Кяаааааааааа!
Dialogue: 0,1:33:49.99,1:33:51.37,Default,,0,0,0,,Нацуми!
Dialogue: 0,1:33:54.12,1:33:56.54,Default,,0,0,0,,- (Коюки) Мен тым құрыдым - Болғалы тұр
Dialogue: 0,1:33:56.63,1:33:57.25,Default,,0,0,0,,Әй!
Dialogue: 0,1:34:05.76,1:34:07.68,Default,,0,0,0,,Мен әлі білмеймін
Dialogue: 0,1:34:07.76,1:34:09.35,Default,,0,0,0,,Мұны істеуге не мәжбүр етеді?
Dialogue: 0,1:34:09.89,1:34:12.52,Default,,0,0,0,,Менің өсиеттерімді тыңдамағандар
Dialogue: 0,1:34:12.60,1:34:17.06,Default,,0,0,0,,Ешкімнің бұйрығынсыз соғысып, бірін-бірі қорғау...
Dialogue: 0,1:34:17.56,1:34:20.36,Default,,0,0,0,,Мүмкін емес. Бұған не себеп болады?
Dialogue: 0,1:34:20.86,1:34:24.70,Default,,0,0,0,,Бұл да «ерекше байланысқа» байланысты ма?
Dialogue: 0,1:34:25.78,1:34:26.95,Default,,0,0,0,,Сержант...
Dialogue: 0,1:34:27.03,1:34:28.16,Default,,0,0,0,,Фуюки-доно~!
Dialogue: 0,1:34:28.24,1:34:28.82,Default,,0,0,0,,Ах
Dialogue: 0,1:34:32.62,1:34:33.87,Default,,0,0,0,,- (Фуюки) Сержант! -(Қара Кероро) Қарғыс атсын...
Dialogue: 0,1:34:35.25,1:34:38.38,Default,,0,0,0,,Басқа мен, мен бейқам жүрмін.
Dialogue: 0,1:34:38.46,1:34:39.42,Default,,0,0,0,,Хун
Dialogue: 0,1:34:39.50,1:34:41.21,Default,,0,0,0,,«Арнайы байланыс» дегеніміз не?
Dialogue: 0,1:34:41.30,1:34:41.84,Default,,0,0,0,,Құсу?
Dialogue: 0,1:34:41.92,1:34:45.17,Default,,0,0,0,,Құдіретті Жаратушы ретінде маған ештеңе жетпейді!
Dialogue: 0,1:34:45.26,1:34:46.72,Default,,0,0,0,,Үлкен ақымақ!
Dialogue: 0,1:34:46.80,1:34:48.26,Default,,0,0,0,,Сіз әлі де сенімді емессіз бе?
Dialogue: 0,1:34:48.34,1:34:49.76,Default,,0,0,0,,Не?
Dialogue: 0,1:34:50.47,1:34:53.14,Default,,0,0,0,,Бұл адам ерекше ештеңе емес.
Dialogue: 0,1:34:53.22,1:34:54.18,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:34:54.27,1:34:58.90,Default,,0,0,0,,Достарыңызға деген сезімдеріңіз керондық немесе жерлік екендігіңізге еш қатысы жоқ.
Dialogue: 0,1:34:58.98,1:35:01.86,Default,,0,0,0,,Бұл Пекопонда әдеттегі нәрсе.
Dialogue: 0,1:35:02.57,1:35:05.49,Default,,0,0,0,,Менің достарыма деген сезімім...
Dialogue: 0,1:35:06.15,1:35:07.78,Default,,0,0,0,,Иә, сержант.
Dialogue: 0,1:35:07.86,1:35:09.82,Default,,0,0,0,,Бірақ мен түсінбеймін.
Dialogue: 0,1:35:10.32,1:35:12.03,Default,,0,0,0,,Мен түсінбеймін!
Dialogue: 0,1:35:12.12,1:35:13.79,Default,,0,0,0,,Уау...
Dialogue: 0,1:35:14.87,1:35:16.79,Default,,0,0,0,,- (Қараңғы Кероро) Ах... - (Фуюки) Қарғыс атсын!
Dialogue: 0,1:35:28.43,1:35:29.80,Default,,0,0,0,,Шива Шива Шива Шива ~!
Dialogue: 0,1:35:29.89,1:35:33.06,Default,,0,0,0,,Ах... гофу!
Dialogue: 0,1:35:33.14,1:35:35.14,Default,,0,0,0,,Си-васива-шива!
Dialogue: 0,1:35:35.22,1:35:36.35,Default,,0,0,0,,Лорд Тама!
Dialogue: 0,1:35:36.85,1:35:38.10,Default,,0,0,0,,Хмф! Ах...
Dialogue: 0,1:35:38.77,1:35:40.31,Default,,0,0,0,,Маған көмек керек емес
Dialogue: 0,1:35:40.40,1:35:42.98,Default,,0,0,0,,Басты рөл әділ және шаршы...
Dialogue: 0,1:35:43.07,1:35:44.28,Default,,0,0,0,,Сен ақымақ
Dialogue: 0,1:35:44.36,1:35:45.15,Default,,0,0,0,,Уф...
Dialogue: 0,1:35:45.82,1:35:47.90,Default,,0,0,0,,Лорд Тама, Нишизава отбасының өсиеттері қандай?
Dialogue: 0,1:35:47.99,1:35:50.20,Default,,0,0,0,,Немесе… «Жеңімпаз басты кейіпкер»
Dialogue: 0,1:35:50.28,1:35:50.82,Default,,0,0,0,,Ha
Dialogue: 0,1:35:50.91,1:35:54.79,Default,,0,0,0,,Жарайды, зұлымдарды жоюда жақсы немесе жаман ештеңе жоқ.
Dialogue: 0,1:35:55.41,1:35:56.41,Default,,0,0,0,,Бәрібір жеңіңіз!
Dialogue: 0,1:35:56.50,1:35:59.00,Default,,0,0,0,,Ха... Жарайды!
Dialogue: 0,1:35:59.50,1:36:02.00,Default,,0,0,0,,Иккиееее!
Dialogue: 0,1:36:02.50,1:36:03.46,Default,,0,0,0,,Жарайсың ба?
Dialogue: 0,1:36:03.54,1:36:04.96,Default,,0,0,0,,Қараңдар!
Dialogue: 0,1:36:05.05,1:36:06.34,Default,,0,0,0,,Ng...
Dialogue: 0,1:36:06.42,1:36:07.47,Default,,0,0,0,,(ысқыру дыбысы)
Dialogue: 0,1:36:07.55,1:36:10.18,Default,,0,0,0,,Гухо! Мен жансыз сезінемін...
Dialogue: 0,1:36:10.26,1:36:10.93,Default,,0,0,0,,Ура!
Dialogue: 0,1:36:11.01,1:36:14.72,Default,,0,0,0,,- Қараңдар! - (Ура Момока) Ораора!
Dialogue: 0,1:36:14.81,1:36:16.02,Default,,0,0,0,,Ғрр! Б-бұл жігіт…
Dialogue: 0,1:36:17.22,1:36:20.06,Default,,0,0,0,,Сіз Оратчиді қатты ашуландырдыңыз.
Dialogue: 0,1:36:20.56,1:36:23.94,Default,,0,0,0,,Енді мен сізге аңызға айналған соңғы құпияны көрсетемін
Dialogue: 0,1:36:24.02,1:36:24.82,Default,,0,0,0,,Бұл кішкентай вакуумдық торнадоның соңғы әсері!
Dialogue: 0,1:36:25.32,1:36:27.69,Default,,0,0,0,,Барлығының энергиясын Orachi-мен бөлісіңіз...
Dialogue: 0,1:36:27.78,1:36:31.03,Default,,0,0,0,,Grand Cosmos Omicron, бұл жолы тозаққа...
Dialogue: 0,1:36:31.11,1:36:33.03,Default,,0,0,0,,Tamapact~!
Dialogue: 0,1:36:33.12,1:36:36.79,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,1:36:38.50,1:36:41.17,Default,,0,0,0,,Көп уақыт өткен сияқты.
Dialogue: 0,1:36:41.25,1:36:42.83,Default,,0,0,0,,Жарайсың Тамако
Dialogue: 0,1:36:42.92,1:36:45.54,Default,,0,0,0,,Қараңғы батыр Тамама осында
Dialogue: 0,1:36:47.05,1:36:49.67,Default,,0,0,0,,Жарайды, бұл өте жақсы жұмыс істеді.
Dialogue: 0,1:36:49.76,1:36:50.63,Default,,0,0,0,,Оратчидің шәкірті болғың келе ме?
Dialogue: 0,1:36:50.72,1:36:52.38,Default,,0,0,0,,Кет, жеңілген!
Dialogue: 0,1:36:53.09,1:36:56.06,Default,,0,0,0,,Нацуми Сен шынымен жақсысың ба?
Dialogue: 0,1:36:56.14,1:36:58.31,Default,,0,0,0,,Сіз бұл сызат деп айтасыз.
Dialogue: 0,1:36:58.39,1:36:59.31,Default,,0,0,0,,Осы балаға не болған екен…
Dialogue: 0,1:37:01.39,1:37:02.77,Default,,0,0,0,,Осы екеуінің қайсысы екенін сұрап тұрмын. Сен бе?
Dialogue: 0,1:37:02.85,1:37:04.69,Default,,0,0,0,,Сіз алыс болыңыз.
Dialogue: 0,1:37:04.77,1:37:06.07,Default,,0,0,0,,Не? Гироро!
Dialogue: 0,1:37:06.65,1:37:10.32,Default,,0,0,0,,Мен кешіре алмаймын, ешқашан кешіре алмаймын.
Dialogue: 0,1:37:11.32,1:37:15.24,Default,,0,0,0,,Мен Нацумиді қорғай алмадым, пайдасыз болдым
Dialogue: 0,1:37:27.38,1:37:27.92,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,1:37:37.01,1:37:38.18,Default,,0,0,0,,Джироро!
Dialogue: 0,1:37:38.26,1:37:38.93,Default,,0,0,0,,Иә!
Dialogue: 0,1:37:43.23,1:37:44.56,Default,,0,0,0,,Өзін-өзі жою!
Dialogue: 0,1:37:47.02,1:37:47.57,Default,,0,0,0,,Аа...
Dialogue: 0,1:37:48.07,1:37:49.32,Default,,0,0,0,,Джироро, жақсысың ба?
Dialogue: 0,1:37:49.40,1:37:52.40,Default,,0,0,0,,Нацуми, мен саған аулақ жүр дедім.
Dialogue: 0,1:37:52.49,1:37:53.90,Default,,0,0,0,,Өйткені...
Dialogue: 0,1:37:53.99,1:37:55.03,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,1:37:55.53,1:37:57.83,Default,,0,0,0,,Менің құтқарылғаным рас.
Dialogue: 0,1:37:57.91,1:37:59.08,Default,,0,0,0,,Біз бұны Ятоға да қолдана аламыз—
Dialogue: 0,1:37:59.58,1:38:00.12,Default,,0,0,0,,Уф...
Dialogue: 0,1:38:00.20,1:38:02.66,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,1:38:02.75,1:38:05.37,Default,,0,0,0,,Жарайды... Мен әлі қоныстанған жоқпын.
Dialogue: 0,1:38:05.46,1:38:06.33,Default,,0,0,0,,Кеттік
Dialogue: 0,1:38:06.42,1:38:07.38,Default,,0,0,0,,Иә.
Dialogue: 0,1:38:07.88,1:38:09.09,Default,,0,0,0,,Қайғылы жеңіліс...
Dialogue: 0,1:38:10.34,1:38:13.59,Default,,0,0,0,,Мен... қателестім бе?
Dialogue: 0,1:38:14.26,1:38:15.97,Default,,0,0,0,,Абсолюттік сызғыш және
Dialogue: 0,1:38:16.05,1:38:19.89,Default,,0,0,0,,Ол жерде бас иетін мойынсұнғыш халықтың бірлігі.
Dialogue: 0,1:38:19.97,1:38:22.27,Default,,0,0,0,,Әлем қандай болуы керек
Dialogue: 0,1:38:22.35,1:38:25.35,Default,,0,0,0,,Егер бұл агрессияның дұрыс түрі болса...
Dialogue: 0,1:38:26.10,1:38:28.40,Default,,0,0,0,,Мұндай басып алу бос сөз.
Dialogue: 0,1:38:28.48,1:38:29.48,Default,,0,0,0,,Бірақ бұл
Dialogue: 0,1:38:29.57,1:38:33.15,Default,,0,0,0,,Мен Кируру жұмысына байланысты сенуге мәжбүр болдым.
Dialogue: 0,1:38:33.24,1:38:35.53,Default,,0,0,0,,Ал... дұрыс.
Dialogue: 0,1:38:39.33,1:38:40.37,Default,,0,0,0,,- (Фуюки) А - Құсу ма?
Dialogue: 0,1:38:41.83,1:38:44.33,Default,,0,0,0,,Қайда... бара жатырсың?
Dialogue: 0,1:38:44.83,1:38:48.29,Default,,0,0,0,,Мына жігіт... Мен Кируруды тоқтатамын.
Dialogue: 0,1:38:48.38,1:38:51.05,Default,,0,0,0,,- А... - (Фуюки) Үшінші Кируру келді ме?
Dialogue: 0,1:38:51.13,1:38:51.96,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,1:38:52.05,1:38:56.76,Default,,0,0,0,,Дәлірек айтсақ, осы мүсіннің артқы жағындағы аспан қаланың өзі.
Dialogue: 0,1:38:56.84,1:38:58.43,Default,,0,0,0,,Бұл үшінші Кируру.
Dialogue: 0,1:38:58.51,1:39:01.43,Default,,0,0,0,,Аспан қаласы үшінші Кируру...
Dialogue: 0,1:39:01.51,1:39:07.27,Default,,0,0,0,,Алайда Кируру тоқтаса, патшаның бар болуы да жойылады.
Dialogue: 0,1:39:07.35,1:39:08.85,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,1:39:09.81,1:39:10.36,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,1:39:11.52,1:39:15.19,Default,,0,0,0,,Бұл да менің патшалық міндетім.
Dialogue: 0,1:39:16.24,1:39:17.57,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:39:18.24,1:39:19.03,Default,,0,0,0,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,1:39:28.42,1:39:29.12,Default,,0,0,0,,Сен…
Dialogue: 0,1:39:29.83,1:39:33.55,Default,,0,0,0,,Иә, мен үшінші Кируру басқару құрылғысымын.
Dialogue: 0,1:39:34.05,1:39:37.97,Default,,0,0,0,,Менің рөлім Кируру жасаған императорды анықтау.
Dialogue: 0,1:39:44.22,1:39:46.77,Default,,0,0,0,,Күте тұрыңыз! Мен де барамын
Dialogue: 0,1:39:46.85,1:39:47.69,Default,,0,0,0,,Фуюки-доно?
Dialogue: 0,1:39:49.40,1:39:50.06,Default,,0,0,0,,Фуюки…
Dialogue: 0,1:39:51.02,1:39:52.82,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:39:57.32,1:39:58.95,Default,,0,0,0,,Көп күтпеңіз
Dialogue: 0,1:39:59.03,1:39:59.66,Default,,0,0,0,,Ах...
Dialogue: 0,1:39:59.74,1:40:02.57,Default,,0,0,0,,Келме. Бұл менің жұмысым.
Dialogue: 0,1:40:02.66,1:40:05.24,Default,,0,0,0,,Сіз ешқашан жоғалмайсыз
Dialogue: 0,1:40:05.33,1:40:07.33,Default,,0,0,0,,Басқа жол болуы керек.
Dialogue: 0,1:40:08.25,1:40:11.83,Default,,0,0,0,,Сен... күшіңді бересің бе?
Dialogue: 0,1:40:12.42,1:40:14.84,Default,,0,0,0,,Иә, әлі де кеш емес.
Dialogue: 0,1:40:14.92,1:40:17.55,Default,,0,0,0,,Дос бола алатынымызға сенімдімін.
Dialogue: 0,1:40:17.63,1:40:19.84,Default,,0,0,0,,Өйткені біз бір сержантпыз.
Dialogue: 0,1:40:19.93,1:40:23.22,Default,,0,0,0,,Бірақ мен досымның кім екенін әлі білмеймін...
Dialogue: 0,1:40:23.72,1:40:25.81,Default,,0,0,0,,Сіз оны қазір анықтап алуыңыз керек.
Dialogue: 0,1:40:26.39,1:40:29.02,Default,,0,0,0,,Ештеңе емес, бұл сізге арналғанына сенімдімін...
Dialogue: 0,1:40:29.60,1:40:30.60,Default,,0,0,0,,Фуюки…
Dialogue: 0,1:40:33.61,1:40:35.27,Default,,0,0,0,,Басқа мен
Dialogue: 0,1:40:35.36,1:40:37.82,Default,,0,0,0,,Мен Фуюкиді сұрадым
Dialogue: 0,1:40:38.78,1:40:39.53,Default,,0,0,0,,Фуюки
Dialogue: 0,1:40:41.03,1:40:42.20,Default,,0,0,0,,Рахмет
Dialogue: 0,1:40:44.03,1:40:46.37,Default,,0,0,0,,- (Фуюки) Сержант! -Фуюки-доно!
Dialogue: 0,1:40:47.16,1:40:50.79,Default,,0,0,0,,Міне... Сержант~!
Dialogue: 0,1:41:00.80,1:41:02.30,Default,,0,0,0,,Қарт патшаны ұмыт
Dialogue: 0,1:41:02.38,1:41:04.30,Default,,0,0,0,,Маған адал болуға ант ет.
Dialogue: 0,1:41:04.39,1:41:05.76,Default,,0,0,0,,Өлемін деп ойлайтын ешқандай жағдайға тап болған емеспін
Dialogue: 0,1:41:05.85,1:41:06.85,Default,,0,0,0,,Не?
Dialogue: 0,1:41:07.56,1:41:11.39,Default,,0,0,0,,А... Бұл сөз маған жауап берді.
Dialogue: 0,1:41:12.44,1:41:18.82,Default,,0,0,0,,Сержант? Сержант сержант! Сержант~!
Dialogue: 0,1:41:18.90,1:41:20.40,Default,,0,0,0,,Қош бол!
Dialogue: 0,1:41:33.79,1:41:35.75,Default,,0,0,0,,Геро... Геро
Dialogue: 0,1:41:36.29,1:41:39.13,Default,,0,0,0,,Құсу!
Dialogue: 0,1:42:06.45,1:42:07.20,Default,,0,0,0,,Сержант...
Dialogue: 0,1:42:08.33,1:42:10.12,Default,,0,0,0,,-Фуюки-доно! - (Фуюки) Уау!
Dialogue: 0,1:42:16.29,1:42:18.34,Default,,0,0,0,,Kururu Сіз мұны естігеніңізге сенімдісіз бе?
Dialogue: 0,1:42:18.42,1:42:22.21,Default,,0,0,0,,А, мен капитаннан күтуімді өтінген хабарлама алдым.
Dialogue: 0,1:42:22.71,1:42:23.26,Default,,0,0,0,,Иә?
Dialogue: 0,1:42:27.05,1:42:29.60,Default,,0,0,0,,Фуюки! Бұлыңғыр бақа!
Dialogue: 0,1:42:32.18,1:42:34.23,Default,,0,0,0,,Әпке! барлығы!
Dialogue: 0,1:43:19.98,1:43:20.90,Default,,0,0,0,,Ах...
Dialogue: 0,1:43:31.33,1:43:32.53,Default,,0,0,0,,Сержант...
Dialogue: 0,1:44:05.19,1:44:07.15,Default,,0,0,0,,Кируру толығымен тоқтады
Dialogue: 0,1:44:07.24,1:44:09.11,Default,,0,0,0,,Содан кейін ол...
Dialogue: 0,1:44:09.78,1:44:13.03,Default,,0,0,0,,Біз ештеңе істемей қалдық...
Dialogue: 0,1:44:13.95,1:44:19.08,Default,,0,0,0,,Сержант~!
Dialogue: 0,1:44:19.16,1:44:21.17,Default,,0,0,0,,А... Мен өлемін деп ойладым.
Dialogue: 0,1:44:22.17,1:44:23.59,Default,,0,0,0,,- Құсу? -(Фуюки) Аа...
Dialogue: 0,1:44:26.21,1:44:27.63,Default,,0,0,0,,Жақсы болды.
Dialogue: 0,1:44:27.71,1:44:29.51,Default,,0,0,0,,Бірақ бәрі...
Dialogue: 0,1:44:29.59,1:44:31.18,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:44:31.26,1:44:34.68,Default,,0,0,0,,Егер мен Кируруны жойсам, мен де жоқ болуым керек...
Dialogue: 0,1:44:34.76,1:44:36.22,Default,,0,0,0,,Мен өтірік айтпаймын
Dialogue: 0,1:44:36.31,1:44:37.10,Default,,0,0,0,,Мируру
Dialogue: 0,1:44:37.68,1:44:40.64,Default,,0,0,0,,Сіз патша ретінде өмір сүруді тоқтаттыңыз.
Dialogue: 0,1:44:40.73,1:44:43.15,Default,,0,0,0,,Және бар
Dialogue: 0,1:44:44.15,1:44:45.98,Default,,0,0,0,,Бұл сіз доссыз.
Dialogue: 0,1:44:50.78,1:44:51.32,Default,,0,0,0,,Ах
Dialogue: 0,1:44:52.70,1:44:53.57,Default,,0,0,0,,Уау
Dialogue: 0,1:44:54.57,1:44:56.33,Default,,0,0,0,,"Ол жағдайды өз әдісімен шешуге тырысты."
Dialogue: 0,1:45:03.17,1:45:04.17,Default,,0,0,0,,Ахахаха
Dialogue: 0,1:45:17.22,1:45:20.56,Default,,0,0,0,,Көрдім, түсіндім деп ойлаймын.
Dialogue: 0,1:45:21.31,1:45:23.81,Default,,0,0,0,,Мен мұндай жақсылықты бірінші рет сезініп тұрмын.
Dialogue: 0,1:45:27.90,1:45:29.69,Default,,0,0,0,,Енді ол патша емес
Dialogue: 0,1:45:29.78,1:45:32.40,Default,,0,0,0,,Бұл планета енді мен тиесілі жер емес.
Dialogue: 0,1:45:32.90,1:45:35.32,Default,,0,0,0,,Мен бір планетаға кетіп бара жатырмын
Dialogue: 0,1:45:35.41,1:45:37.53,Default,,0,0,0,,Бұл Пекопонда емес, басқа жерде
Dialogue: 0,1:45:37.62,1:45:40.41,Default,,0,0,0,,Мен сонда көп нәрсені көремін.
Dialogue: 0,1:45:40.91,1:45:43.54,Default,,0,0,0,,Пекопон үшін алаңдайтын ештеңе жоқ.
Dialogue: 0,1:45:44.12,1:45:45.21,Default,,0,0,0,,Бұдан былай, И
Dialogue: 0,1:45:45.29,1:45:47.92,Default,,0,0,0,,Гатцу Гатцу Бұл басып алу~
Dialogue: 0,1:45:48.00,1:45:50.30,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:45:51.05,1:45:53.43,Default,,0,0,0,,Ал... Достарыңды бағала.
Dialogue: 0,1:45:53.51,1:45:55.59,Default,,0,0,0,,-Эй -Сержант-сан~
Dialogue: 0,1:45:55.68,1:45:57.10,Default,,0,0,0,,Фуюки-кун!
Dialogue: 0,1:46:00.18,1:46:01.77,Default,,0,0,0,,Капитан!
Dialogue: 0,1:46:02.31,1:46:03.85,Default,,0,0,0,,Уау!
Dialogue: 0,1:46:04.98,1:46:07.56,Default,,0,0,0,,Хаха, жарайды, Куруру.
Dialogue: 0,1:46:09.73,1:46:10.40,Default,,0,0,0,,О
Dialogue: 0,1:46:10.48,1:46:12.69,Default,,0,0,0,,Жақыннан дәл солай көрінеді
Dialogue: 0,1:46:12.78,1:46:17.87,Default,,0,0,0,,(Барлығының шулы әңгімесі)
Dialogue: 0,1:46:18.87,1:46:22.33,Default,,0,0,0,,Келесі жолы мен мұны істесем, сіз шынымен бейберекет боласыз ...
Dialogue: 0,1:46:23.33,1:46:26.25,Default,,0,0,0,,Түсіндім, сіздің шабуылыңыз
Dialogue: 0,1:46:26.92,1:46:30.30,Default,,0,0,0,,Ол әлдеқашан аяқталған болуы мүмкін.
Dialogue: 0,1:46:30.96,1:46:32.96,Default,,0,0,0,,♪～
Dialogue: 0,1:49:36.56,1:49:38.57,Default,,0,0,0,,～♪
Dialogue: 0,1:49:40.07,1:49:46.07,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory