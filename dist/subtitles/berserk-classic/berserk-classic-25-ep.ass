Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:07.44,Default,,0,0,0,,Бұл дүниеде Адамдардың тағдырын басқару
Dialogue: 0,0:00:07.44,0:00:11.12,Default,,0,0,0,,Кейбір трансценденттік заң
Dialogue: 0,0:00:11.12,0:00:15.09,Default,,0,0,0,,Құдайдың қолы
Dialogue: 0,0:00:15.09,0:00:17.39,Default,,0,0,0,,Кем дегенде адамдар
Dialogue: 0,0:00:17.39,0:00:21.10,Default,,0,0,0,,Тіпті өз еркімен
Dialogue: 0,0:00:29.06,0:00:31.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:31.36,0:00:33.56,Default,,0,0,0,,Вау Уау
Dialogue: 0,0:00:45.92,0:00:48.63,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:48.63,0:00:50.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:52.60,0:00:54.73,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:00:54.73,0:00:58.41,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:00:58.41,0:01:00.35,Default,,0,0,0,,Неге...
Dialogue: 0,0:01:00.35,0:01:02.85,Default,,0,0,0,,Біз не үшін келдік?
Dialogue: 0,0:02:23.35,0:02:27.72,Default,,0,0,0,,Денеңде ойылған нәрсе – құрбандықтың белгісі.
Dialogue: 0,0:02:27.72,0:02:30.63,Default,,0,0,0,,Бұл брендті алып жүргендердің өмірі
Dialogue: 0,0:02:30.63,0:02:32.57,Default,,0,0,0,,Біз шайтанның құрбандығымыз
Dialogue: 0,0:02:32.57,0:02:35.20,Default,,0,0,0,,Сол қанның соңғы тамшысы
Dialogue: 0,0:02:35.20,0:02:40.85,Default,,0,0,0,,Соңғы сәттердің өзі қараңғылықтың жаңа баласына өмір азығына айналады.
Dialogue: 0,0:02:40.85,0:02:44.79,Default,,0,0,0,,Күтіңіз, күтіңіз.
Dialogue: 0,0:02:44.79,0:02:48.53,Default,,0,0,0,,Көп емес екен, иә?
Dialogue: 0,0:02:48.53,0:02:52.41,Default,,0,0,0,,Адам күшінен пайда жоқ.
Dialogue: 0,0:02:52.41,0:02:55.78,Default,,0,0,0,,Ал көмектесу үшін?
Dialogue: 0,0:02:55.78,0:02:58.42,Default,,0,0,0,,Адамның қалағаны осы болды
Dialogue: 0,0:02:58.42,0:03:02.16,Default,,0,0,0,,Аузыңды жап! сен де естіген шығарсың
Dialogue: 0,0:03:02.16,0:03:06.36,Default,,0,0,0,,Әрине ол
Dialogue: 0,0:03:10.34,0:03:12.84,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:03:34.62,0:03:36.79,Default,,0,0,0,,Сіз
Dialogue: 0,0:03:36.79,0:03:38.80,Default,,0,0,0,,Сіз мұны қалайсыз ба?
Dialogue: 0,0:03:47.28,0:03:51.72,Default,,0,0,0,,Гю
Dialogue: 0,0:03:51.72,0:03:53.72,Default,,0,0,0,,Гюу
Dialogue: 0,0:03:58.61,0:04:00.81,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:17.80,0:04:22.08,Default,,0,0,0,,Гяааах!
Dialogue: 0,0:04:22.08,0:04:25.96,Default,,0,0,0,,Пипин, қаш.
Dialogue: 0,0:04:25.96,0:04:28.63,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:04:28.63,0:04:32.34,Default,,0,0,0,,Қашыңыз
Dialogue: 0,0:04:32.34,0:04:34.34,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:04:36.21,0:04:38.62,Default,,0,0,0,,Сіз не істеп жатырсыз? Жіберу.
Dialogue: 0,0:04:42.02,0:04:44.46,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:04:44.46,0:04:47.93,Default,,0,0,0,,Пиппин! қайту
Dialogue: 0,0:04:47.93,0:04:51.84,Default,,0,0,0,,Жоқ, қазір емес.
Dialogue: 0,0:04:51.84,0:04:54.15,Default,,0,0,0,,Генерал аман болғанша аман бол.
Dialogue: 0,0:04:54.15,0:04:56.08,Default,,0,0,0,,«Сұңқар тобы» аяқталмады
Dialogue: 0,0:04:56.08,0:04:58.16,Default,,0,0,0,,Бл…ээ…!!
Dialogue: 0,0:04:58.16,0:05:00.36,Default,,0,0,0,,Бұл біздің соңымыз болуы мүмкін бе?
Dialogue: 0,0:05:08.71,0:05:11.92,Default,,0,0,0,,Хехехехе...
Dialogue: 0,0:05:11.92,0:05:14.72,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:05:19.60,0:05:22.47,Default,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:05:22.47,0:05:27.31,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:27.31,0:05:31.86,Default,,0,0,0,,Уау! Келме
Dialogue: 0,0:05:31.86,0:05:35.46,Default,,0,0,0,,Иә! Ахх...
Dialogue: 0,0:05:38.17,0:05:40.54,Default,,0,0,0,,Уф
Dialogue: 0,0:05:40.54,0:05:42.94,Default,,0,0,0,,Иә
Dialogue: 0,0:05:45.08,0:05:47.08,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:49.06,0:05:52.20,Default,,0,0,0,,Уф…
Dialogue: 0,0:05:52.20,0:05:54.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:02.48,0:06:06.36,Default,,0,0,0,,ол маған шексіз артықшылық беретін қаруға айналады.
Dialogue: 0,0:06:06.36,0:06:08.37,Default,,0,0,0,,Бұл арман болса керек
Dialogue: 0,0:06:10.27,0:06:13.54,Default,,0,0,0,,Мидленд де
Dialogue: 0,0:06:13.54,0:06:16.51,Default,,0,0,0,,Мұның бәрі арман болды
Dialogue: 0,0:06:16.51,0:06:18.89,Default,,0,0,0,,Ойлан
Dialogue: 0,0:06:18.89,0:06:22.76,Default,,0,0,0,,Бұл оқиға шындық болу үшін тым жақсы болды.
Dialogue: 0,0:06:22.76,0:06:25.56,Default,,0,0,0,,Мисс Бекки қамалда тұрады
Dialogue: 0,0:06:25.56,0:06:27.83,Default,,0,0,0,,Бұл арман
Dialogue: 0,0:06:27.83,0:06:30.74,Default,,0,0,0,,Оянсаң бәрі бітті
Dialogue: 0,0:06:30.74,0:06:34.28,Default,,0,0,0,,Бұл енді ештеңе емес, мен осындамын.
Dialogue: 0,0:06:34.28,0:06:36.98,Default,,0,0,0,,Мен бұған ешқашан жол бере алмаймын.
Dialogue: 0,0:06:44.90,0:06:49.75,Default,,0,0,0,,Хехехе қарашы!
Dialogue: 0,0:06:49.75,0:06:53.62,Default,,0,0,0,,Бұл арман ғой
Dialogue: 0,0:06:53.62,0:06:58.23,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:06:58.23,0:07:00.43,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:07:03.87,0:07:05.87,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:07:16.16,0:07:20.01,Default,,0,0,0,,Яһудея
Dialogue: 0,0:07:20.01,0:07:23.81,Default,,0,0,0,,Уау, Иуда!
Dialogue: 0,0:07:23.81,0:07:26.48,Default,,0,0,0,,Эйгуо...
Dialogue: 0,0:07:26.48,0:07:30.39,Default,,0,0,0,,Амансың ба? О
Dialogue: 0,0:07:32.63,0:07:35.27,Default,,0,0,0,,Яһудея…
Dialogue: 0,0:07:35.27,0:07:37.80,Default,,0,0,0,,Жетеді
Dialogue: 0,0:07:37.80,0:07:41.72,Default,,0,0,0,,Қайда жүгірсең де, артыңнан келеді.
Dialogue: 0,0:07:41.72,0:07:46.15,Default,,0,0,0,,Кем дегенде...
Dialogue: 0,0:07:46.15,0:07:48.87,Default,,0,0,0,,Акселераторға да қолым жетпейді – орындық тым үлкен.
Dialogue: 0,0:07:48.87,0:07:55.37,Default,,0,0,0,,Күрес
Dialogue: 0,0:07:55.37,0:08:00.86,Default,,0,0,0,,Өлгенше күрескенім үшін кешірім сұраймын...
Dialogue: 0,0:08:00.86,0:08:03.76,Default,,0,0,0,,Егер ішектер
Dialogue: 0,0:08:03.76,0:08:05.86,Default,,0,0,0,,Уау
Dialogue: 0,0:08:09.91,0:08:12.71,Default,,0,0,0,,Иуда Ух...
Dialogue: 0,0:08:19.59,0:08:21.59,Default,,0,0,0,,Яһудея
Dialogue: 0,0:08:23.90,0:08:26.13,Default,,0,0,0,,Ақымақ.
Dialogue: 0,0:08:26.13,0:08:28.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:28.95,0:08:30.95,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:08:30.95,0:08:33.75,Default,,0,0,0,,Жетеді
Dialogue: 0,0:08:35.82,0:08:37.82,Default,,0,0,0,,Уф…
Dialogue: 0,0:08:40.70,0:08:42.70,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:47.38,0:08:50.99,Default,,0,0,0,,Уф
Dialogue: 0,0:08:50.99,0:08:53.29,Default,,0,0,0,,Уау...
Dialogue: 0,0:08:55.49,0:08:57.43,Default,,0,0,0,,Яһудея
Dialogue: 0,0:08:57.43,0:09:01.61,Default,,0,0,0,,Бұл менің соңғы пышағым болды ма?
Dialogue: 0,0:09:01.61,0:09:05.11,Default,,0,0,0,,О
Dialogue: 0,0:09:05.11,0:09:07.65,Default,,0,0,0,,Не істеу керек?
Dialogue: 0,0:09:07.65,0:09:11.40,Default,,0,0,0,,Соңына дейін
Dialogue: 0,0:09:11.40,0:09:14.50,Default,,0,0,0,,Тұр, сүйретсең де апарамын.
Dialogue: 0,0:09:16.54,0:09:21.38,Default,,0,0,0,,Түсіндім, мен сенімен бірге барамын.
Dialogue: 0,0:09:21.38,0:09:24.29,Default,,0,0,0,,О
Dialogue: 0,0:09:24.29,0:09:27.06,Default,,0,0,0,,Мен ақымақ нәрсе айттым.
Dialogue: 0,0:09:27.06,0:09:29.73,Default,,0,0,0,,Сөздеріңізге жауапты болыңыздар
Dialogue: 0,0:09:29.73,0:09:32.60,Default,,0,0,0,,Бұл сіздің аузыңыз ғана.
Dialogue: 0,0:09:32.60,0:09:36.58,Default,,0,0,0,,Ерніңізді кемітпей шапалақтауға күшіңіз болса, қараңыз.
Dialogue: 0,0:09:36.58,0:09:41.06,Default,,0,0,0,,Алдымен саусақтарыңды найза пішініне келтір.
Dialogue: 0,0:09:41.06,0:09:44.63,Default,,0,0,0,,Ақыры айтуды ұмытып кетіппін.
Dialogue: 0,0:09:44.63,0:09:46.63,Default,,0,0,0,,Маңызды сөз
Dialogue: 0,0:09:49.34,0:09:53.04,Default,,0,0,0,,Сіз жиі жылайсыз.
Dialogue: 0,0:09:53.04,0:09:58.04,Default,,0,0,0,,Иә? Бұл соңғы жол ...
Dialogue: 0,0:10:04.67,0:10:06.67,Default,,0,0,0,,Яһудея?
Dialogue: 0,0:10:25.64,0:10:28.65,Default,,0,0,0,,Құт
Dialogue: 0,0:10:28.65,0:10:31.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:43.81,0:10:47.08,Default,,0,0,0,,Ей... міне...
Dialogue: 0,0:10:47.08,0:10:49.03,Default,,0,0,0,,Әйел…
Dialogue: 0,0:10:49.03,0:10:53.63,Default,,0,0,0,,Әйелдің иісі...
Dialogue: 0,0:10:53.63,0:10:59.05,Default,,0,0,0,,Сіз оны жейсіз бе? Жақсы иіс шығады...
Dialogue: 0,0:10:59.05,0:11:02.98,Default,,0,0,0,,Оған дейін... Оған дейін...
Dialogue: 0,0:11:02.98,0:11:04.98,Default,,0,0,0,,Ішек
Dialogue: 0,0:11:13.17,0:11:15.84,Default,,0,0,0,,Уф, оқ-дәрі астында қалып қоюдың өзі бір әлем екен
Dialogue: 0,0:11:15.84,0:11:18.22,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:11:18.22,0:11:23.59,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:11:23.59,0:11:28.31,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:28.31,0:11:32.61,Default,,0,0,0,,Уфуфуфу Мен бар күшімді саламын.
Dialogue: 0,0:11:32.61,0:11:36.01,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:36.01,0:11:40.80,Default,,0,0,0,,Ирония, баланың өмірлік күші неғұрлым күшті болса, соғұрлым күшті болады.
Dialogue: 0,0:11:40.80,0:11:44.33,Default,,0,0,0,,Сол баланың күресі
Dialogue: 0,0:11:44.33,0:11:46.27,Default,,0,0,0,,Жаңа қараңғы өмір
Dialogue: 0,0:11:46.27,0:11:49.21,Default,,0,0,0,,Өйткені ол алмастырылмайтын тағамға айналады.
Dialogue: 0,0:11:49.21,0:11:51.31,Default,,0,0,0,,Тәтті армандар
Dialogue: 0,0:11:53.55,0:11:56.25,Default,,0,0,0,,Осы уақытқа дейін сіз Гриффит болуды армандадыңыз.
Dialogue: 0,0:11:58.80,0:12:00.74,Default,,0,0,0,,Арман біткен кезде
Dialogue: 0,0:12:00.74,0:12:03.44,Default,,0,0,0,,Сіз оянасыз
Dialogue: 0,0:12:03.44,0:12:05.94,Default,,0,0,0,,Ешқашан
Dialogue: 0,0:12:13.26,0:12:18.03,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:12:18.03,0:12:20.78,Default,,0,0,0,,Менің денем
Dialogue: 0,0:12:20.78,0:12:23.68,Default,,0,0,0,,Батып кету
Dialogue: 0,0:12:23.68,0:12:25.68,Default,,0,0,0,,терең
Dialogue: 0,0:12:38.91,0:12:44.29,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:12:44.29,0:12:46.29,Default,,0,0,0,,«Донэван мырза, сіз мүлде дұрыс айтасыз» де.
Dialogue: 0,0:12:46.29,0:12:48.30,Default,,0,0,0,,Уау! Гува!
Dialogue: 0,0:12:59.49,0:13:01.96,Default,,0,0,0,,Барлығының өлімі
Dialogue: 0,0:13:01.96,0:13:04.16,Default,,0,0,0,,Жарып өту
Dialogue: 0,0:13:06.36,0:13:09.01,Default,,0,0,0,,Мен оны өлтірдім
Dialogue: 0,0:13:09.01,0:13:11.68,Default,,0,0,0,,Мен мұны қаладым
Dialogue: 0,0:13:11.68,0:13:14.98,Default,,0,0,0,,Біртүрлі, мен ештеңе сезбеймін.
Dialogue: 0,0:13:17.02,0:13:19.03,Default,,0,0,0,,Батып кету
Dialogue: 0,0:13:24.53,0:13:29.64,Default,,0,0,0,,Бұл не? сенің соңғы төккен көз жасың
Dialogue: 0,0:13:34.19,0:13:39.37,Default,,0,0,0,,Адамдар
Dialogue: 0,0:13:39.37,0:13:41.47,Default,,0,0,0,,Жүрек
Dialogue: 0,0:13:45.04,0:13:46.98,Default,,0,0,0,,Бехелит
Dialogue: 0,0:13:46.98,0:13:49.69,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:13:49.69,0:13:53.46,Default,,0,0,0,,Осы теңізден мәңгілік теңізге дейін
Dialogue: 0,0:13:53.46,0:13:55.96,Default,,0,0,0,,Нен тамшысы
Dialogue: 0,0:13:55.96,0:13:58.17,Default,,0,0,0,,Басқа әлемге шақыру
Dialogue: 0,0:14:03.81,0:14:08.63,Default,,0,0,0,,Ei
Dialogue: 0,0:14:08.63,0:14:10.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:10.76,0:14:12.76,Default,,0,0,0,,Енді бұл – қабілетке қарсы қабілет, техникаға қарсы техника, рухқа қарсы рух!
Dialogue: 0,0:14:17.57,0:14:19.58,Default,,0,0,0,,Уф
Dialogue: 0,0:14:25.05,0:14:27.96,Default,,0,0,0,,Уф Гехо
Dialogue: 0,0:14:27.96,0:14:30.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:30.50,0:14:32.50,Default,,0,0,0,,Қан?
Dialogue: 0,0:14:39.35,0:14:43.09,Default,,0,0,0,,Ой, тірі адам жоқ па?
Dialogue: 0,0:14:43.09,0:14:46.79,Default,,0,0,0,,Яһудея
Dialogue: 0,0:14:49.44,0:14:52.28,Default,,0,0,0,,Каска
Dialogue: 0,0:14:52.28,0:14:54.58,Default,,0,0,0,,Капитан... Ха!
Dialogue: 0,0:14:56.82,0:15:00.13,Default,,0,0,0,,Гастон, сен жақсы ма?
Dialogue: 0,0:15:00.13,0:15:02.06,Default,,0,0,0,,Хехехе
Dialogue: 0,0:15:02.06,0:15:05.43,Default,,0,0,0,,Менің ойымша, бұл қауіпсіз емес...
Dialogue: 0,0:15:05.43,0:15:08.75,Default,,0,0,0,,Кесушілер тобы туралы не деуге болады? Тағы кім аман қалды?
Dialogue: 0,0:15:08.75,0:15:13.49,Default,,0,0,0,,Мен түсінбеймін. Мен де жынды сияқты қашып жүрмін.
Dialogue: 0,0:15:13.49,0:15:16.42,Default,,0,0,0,,Байқасаңыз
Dialogue: 0,0:15:16.42,0:15:19.53,Default,,0,0,0,,Кесінділер отрядындағы жігіттерге не болды?
Dialogue: 0,0:15:21.74,0:15:26.01,Default,,0,0,0,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,0:15:26.01,0:15:28.92,Default,,0,0,0,,Түс көргендей
Dialogue: 0,0:15:28.92,0:15:31.29,Default,,0,0,0,,Уф
Dialogue: 0,0:15:31.29,0:15:33.29,Default,,0,0,0,,Гастон Ух...
Dialogue: 0,0:15:33.29,0:15:35.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:35.29,0:15:38.06,Default,,0,0,0,,Кяхаха...
Dialogue: 0,0:15:38.06,0:15:41.97,Default,,0,0,0,,Кяахаха…
Dialogue: 0,0:15:47.62,0:15:51.23,Default,,0,0,0,,Пиппин
Dialogue: 0,0:15:51.23,0:15:53.17,Default,,0,0,0,,Пипин!
Dialogue: 0,0:15:53.17,0:15:55.27,Default,,0,0,0,,Га
Dialogue: 0,0:15:57.37,0:15:59.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:05.12,0:16:07.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:12.04,0:16:14.04,Default,,0,0,0,,Уф
Dialogue: 0,0:16:31.01,0:16:34.88,Default,,0,0,0,,Ки…
Dialogue: 0,0:16:34.88,0:16:37.92,Default,,0,0,0,,Балалар!
Dialogue: 0,0:16:37.92,0:16:39.93,Default,,0,0,0,,Га
Dialogue: 0,0:16:47.50,0:16:52.08,Default,,0,0,0,,Уау! Уф
Dialogue: 0,0:16:52.08,0:16:55.95,Default,,0,0,0,,(Игги) Ұф-ұф! (Джозеф Джоэстар) Міне, міне, міне
Dialogue: 0,0:16:55.95,0:16:57.95,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:17:00.77,0:17:04.47,Default,,0,0,0,,Ах
Dialogue: 0,0:17:10.36,0:17:12.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:35.47,0:17:39.71,Default,,0,0,0,,Туылу
Dialogue: 0,0:17:39.71,0:17:43.39,Default,,0,0,0,,Жаңа жын иесінің дүниеге келуі
Dialogue: 0,0:17:43.39,0:17:45.32,Default,,0,0,0,,Бізбен байланысты
Dialogue: 0,0:17:45.32,0:17:49.67,Default,,0,0,0,,Жын аты бар жаңа Кензоку
Dialogue: 0,0:17:49.67,0:17:52.87,Default,,0,0,0,,Қараңғылық қанаттары
Dialogue: 0,0:18:23.57,0:18:25.67,Default,,0,0,0,,Жасыл…
Dialogue: 0,0:18:29.51,0:18:31.91,Default,,0,0,0,,Га
Dialogue: 0,0:18:40.14,0:18:43.84,Default,,0,0,0,,Ах
Dialogue: 0,0:18:43.84,0:18:45.84,Default,,0,0,0,,Енді бұл – қабілетке қарсы қабілет, техникаға қарсы техника, рухқа қарсы рух!
Dialogue: 0,0:18:49.05,0:18:51.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:53.89,0:18:56.09,Default,,0,0,0,,Гриффит
Dialogue: 0,0:19:05.08,0:19:07.82,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:19:07.82,0:19:11.60,Default,,0,0,0,,Куу... уф
Dialogue: 0,0:19:11.60,0:19:16.43,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:19:16.43,0:19:18.78,Default,,0,0,0,,Га
Dialogue: 0,0:19:18.78,0:19:23.59,Default,,0,0,0,,Уф
Dialogue: 0,0:19:23.59,0:19:26.12,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:19:28.06,0:19:30.17,Default,,0,0,0,,О! Ах...
Dialogue: 0,0:19:32.97,0:19:36.17,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:36.17,0:19:38.88,Default,,0,0,0,,Ах
Dialogue: 0,0:19:41.09,0:19:50.17,Default,,0,0,0,,Уф
Dialogue: 0,0:19:53.58,0:19:56.08,Default,,0,0,0,,Гриффит!
Dialogue: 0,0:20:00.80,0:20:04.10,Default,,0,0,0,,Уф
Dialogue: 0,0:20:13.45,0:20:16.35,Default,,0,0,0,,Құт
Dialogue: 0,0:20:16.35,0:20:21.00,Default,,0,0,0,,Буси!
Dialogue: 0,0:20:21.00,0:20:24.37,Default,,0,0,0,,Махаббат
Dialogue: 0,0:20:24.37,0:20:28.09,Default,,0,0,0,,Ләззат
Dialogue: 0,0:20:28.09,0:20:32.29,Default,,0,0,0,,Барлығы осында
Dialogue: 0,0:20:32.29,0:20:34.29,Default,,0,0,0,,Міне
Dialogue: 0,0:20:42.88,0:20:45.38,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:49.66,0:20:51.66,Default,,0,0,0,,Куку…
Dialogue: 0,0:20:55.47,0:21:00.98,Default,,0,0,0,,Уф
Dialogue: 0,0:21:00.98,0:21:04.08,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:38.95,0:22:42.75,Default,,0,0,0,,Сіз барасыз ба?
Dialogue: 0,0:22:42.75,0:22:44.75,Default,,0,0,0,,Өлме
Dialogue: 0,0:22:46.25,0:22:51.25,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
