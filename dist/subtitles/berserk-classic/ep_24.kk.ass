Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:07.51,Default,,0,0,0,,Бұл дүниеде Адамдардың тағдырын басқару
Dialogue: 0,0:00:07.51,0:00:11.16,Default,,0,0,0,,Кейбір трансценденттік заң
Dialogue: 0,0:00:11.16,0:00:15.13,Default,,0,0,0,,Құдайдың қолы бар ма?
Dialogue: 0,0:00:15.13,0:00:19.30,Default,,0,0,0,,Ең болмағанда адамдардың өз еркі бар
Dialogue: 0,0:00:19.30,0:00:21.31,Default,,0,0,0,,Еркін орындауға болмайды
Dialogue: 0,0:00:33.80,0:00:35.77,Default,,0,0,0,,На
Dialogue: 0,0:00:35.77,0:00:38.47,Default,,0,0,0,,Уф
Dialogue: 0,0:00:42.25,0:00:45.75,Default,,0,0,0,,Уф
Dialogue: 0,0:02:01.18,0:02:05.85,Default,,0,0,0,,Уф
Dialogue: 0,0:02:05.85,0:02:08.45,Default,,0,0,0,,Уаааааааааааааааааааааааа
Dialogue: 0,0:02:08.45,0:02:10.76,Default,,0,0,0,,Ой, бұл не?
Dialogue: 0,0:02:10.76,0:02:13.13,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:02:13.13,0:02:17.00,Default,,0,0,0,,Қазір де, қазір де біз шабындықпыз
Dialogue: 0,0:02:17.00,0:02:20.78,Default,,0,0,0,,Біз жүгіріп жүріп армандаймыз ба?
Dialogue: 0,0:02:20.78,0:02:23.75,Default,,0,0,0,,Әлде…
Dialogue: 0,0:02:26.46,0:02:28.72,Default,,0,0,0,,Тынышталыңыз Тынышсыз ба?
Dialogue: 0,0:02:28.72,0:02:31.07,Default,,0,0,0,,Тыныштану үшін не істеуім керек?
Dialogue: 0,0:02:31.07,0:02:33.94,Default,,0,0,0,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,0:02:33.94,0:02:37.54,Default,,0,0,0,,Сабырлы болыңыз, түсінбейтін нәрсені ойламаңыз.
Dialogue: 0,0:02:37.54,0:02:41.42,Default,,0,0,0,,Қолыңнан келгенін істе, әркім.
Dialogue: 0,0:02:41.42,0:02:45.06,Default,,0,0,0,,Ешкімнің бөлініп кетуіне жол берме
Dialogue: 0,0:02:45.06,0:02:48.26,Default,,0,0,0,,О
Dialogue: 0,0:02:48.26,0:02:51.14,Default,,0,0,0,,Сол жерде
Dialogue: 0,0:02:51.14,0:02:55.58,Default,,0,0,0,,Бұл жағдайда
Dialogue: 0,0:02:55.58,0:02:57.58,Default,,0,0,0,,Кеттік
Dialogue: 0,0:02:59.75,0:03:02.66,Default,,0,0,0,,Неге қазір?
Dialogue: 0,0:03:02.66,0:03:05.86,Default,,0,0,0,,Мен Гриффитті құтқарған кезде оның қасымда болмағанына сенімдімін.
Dialogue: 0,0:03:08.00,0:03:10.28,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:03:10.28,0:03:14.08,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:16.09,0:03:18.02,Default,,0,0,0,,Гриффит
Dialogue: 0,0:03:18.02,0:03:20.77,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:03:20.77,0:03:23.67,Default,,0,0,0,,Бұл ұлы түн мерекесінің елі.
Dialogue: 0,0:03:26.27,0:03:31.56,Default,,0,0,0,,216 Жыл сайынғы банкет
Dialogue: 0,0:03:31.56,0:03:33.93,Default,,0,0,0,,Тұтылу!
Dialogue: 0,0:03:33.93,0:03:35.96,Default,,0,0,0,,Юкине, сонда ісіңді бітірген соң дүкенге қара.
Dialogue: 0,0:03:35.96,0:03:38.66,Default,,0,0,0,,Содан кейін басты оқиға енді басталғалы тұрғандай сезіледі… Яаах~♡
Dialogue: 0,0:03:38.66,0:03:42.44,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:03:42.44,0:03:46.05,Default,,0,0,0,,Біздің
Dialogue: 0,0:03:46.05,0:03:50.06,Default,,0,0,0,,Төрт қорғаушы періштенің келуі.
Dialogue: 0,0:04:03.19,0:04:05.69,Default,,0,0,0,,Уау
Dialogue: 0,0:04:38.78,0:04:43.03,Default,,0,0,0,,Не?
Dialogue: 0,0:04:43.03,0:04:45.03,Default,,0,0,0,,Уау
Dialogue: 0,0:04:50.28,0:04:52.22,Default,,0,0,0,,Бұл не? Сен... неге мені қуалап жүрсің?
Dialogue: 0,0:04:52.22,0:04:54.82,Default,,0,0,0,,Дегенмен, патшаңыздың қазір есінен адасқаны анық.
Dialogue: 0,0:04:57.66,0:05:03.77,Default,,0,0,0,,Уау хихихихи
Dialogue: 0,0:05:06.84,0:05:09.44,Default,,0,0,0,,Увааааааааааааааааааа
Dialogue: 0,0:05:17.90,0:05:20.81,Default,,0,0,0,,Мен жақсы сакэ әкелдім, сондықтан бүгін мені кешіріңіздер
Dialogue: 0,0:05:20.81,0:05:23.81,Default,,0,0,0,,Бұл сөзсіз арман Уау!
Dialogue: 0,0:05:23.81,0:05:26.01,Default,,0,0,0,,Бұл уақыт қанша?
Dialogue: 0,0:05:59.44,0:06:02.05,Default,,0,0,0,,Ууууууу
Dialogue: 0,0:06:07.96,0:06:10.24,Default,,0,0,0,,29-шы эпизод: Мақсат – Рим! Колизей
Dialogue: 0,0:06:10.24,0:06:13.24,Default,,0,0,0,,Үлкен бата уақыты
Dialogue: 0,0:06:13.24,0:06:17.02,Default,,0,0,0,,Уау, бұл өте уақыт болды.
Dialogue: 0,0:06:17.02,0:06:20.90,Default,,0,0,0,,Анаришика жеріне
Dialogue: 0,0:06:20.90,0:06:23.43,Default,,0,0,0,,Адам жасаған
Dialogue: 0,0:06:23.43,0:06:28.24,Default,,0,0,0,,Құдайдың тоқтылары
Dialogue: 0,0:06:28.24,0:06:30.65,Default,,0,0,0,,Оны барынша дәм татыңыз.
Dialogue: 0,0:06:32.85,0:06:36.62,Default,,0,0,0,,Себеп-салдар заңы бойынша таңдалған ұл
Dialogue: 0,0:06:36.62,0:06:39.46,Default,,0,0,0,,Сіз таңдалған адамсыз
Dialogue: 0,0:06:39.46,0:06:42.50,Default,,0,0,0,,Осы уақытта
Dialogue: 0,0:06:42.50,0:06:46.84,Default,,0,0,0,,Ұлы Құдайдың қолымен тағайындалғандар
Dialogue: 0,0:06:46.84,0:06:51.25,Default,,0,0,0,,Біздің
Dialogue: 0,0:06:54.26,0:06:56.96,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:06:56.96,0:07:00.28,Default,,0,0,0,,Гриффит Кензоку
Dialogue: 0,0:07:00.28,0:07:03.71,Default,,0,0,0,,Гриффит...
Dialogue: 0,0:07:03.71,0:07:06.71,Default,,0,0,0,,Адамдармен араласпа.
Dialogue: 0,0:07:06.71,0:07:08.85,Default,,0,0,0,,Сізді бір жерге апару үшін
Dialogue: 0,0:07:08.85,0:07:11.20,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:07:11.20,0:07:15.10,Default,,0,0,0,,Бұл Ұлы.
Dialogue: 0,0:07:15.10,0:07:18.60,Default,,0,0,0,,Бұл жігіттің құйрығы да өспейді.
Dialogue: 0,0:07:18.60,0:07:22.95,Default,,0,0,0,,Темера
Dialogue: 0,0:07:22.95,0:07:25.85,Default,,0,0,0,,Хохохохо
Dialogue: 0,0:07:25.85,0:07:27.89,Default,,0,0,0,,Нфуфуфуфуфу Ихихихихи
Dialogue: 0,0:07:27.89,0:07:32.47,Default,,0,0,0,,Ахахахха Қандай әдемі достық
Dialogue: 0,0:07:32.47,0:07:34.41,Default,,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,0:07:34.41,0:07:37.71,Default,,0,0,0,,Бұл жақсы құрбандық болар еді.
Dialogue: 0,0:07:37.71,0:07:41.16,Default,,0,0,0,,Құрбан шалу
Dialogue: 0,0:07:41.16,0:07:46.29,Default,,0,0,0,,Иә
Dialogue: 0,0:07:46.29,0:07:49.10,Default,,0,0,0,,Жын патшасы
Dialogue: 0,0:07:49.10,0:07:51.58,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:07:51.58,0:07:55.25,Default,,0,0,0,,Мен сол қып-қызыл бехелитке ие болған сәттен бастап
Dialogue: 0,0:07:55.25,0:07:59.96,Default,,0,0,0,,Сіз жын патшасы болуға лайықсыз.
Dialogue: 0,0:07:59.96,0:08:03.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:08:03.00,0:08:05.77,Default,,0,0,0,,Мен оны алдым деп айтуым керек пе?
Dialogue: 0,0:08:05.77,0:08:10.68,Default,,0,0,0,,Бізді шақыру үшін Бехеритті пайдаланғаныңыздың өзі
Dialogue: 0,0:08:10.68,0:08:15.02,Default,,0,0,0,,Біздің
Dialogue: 0,0:08:15.02,0:08:19.86,Default,,0,0,0,,Өйткені мұнда барлық адамдар жиналды
Dialogue: 0,0:08:19.86,0:08:24.34,Default,,0,0,0,,Өйткені Бехелит маған қандай болу керектігін берді.
Dialogue: 0,0:08:24.34,0:08:27.58,Default,,0,0,0,,Олай болса
Dialogue: 0,0:08:27.58,0:08:29.54,Default,,0,0,0,,Осы жігіттердің барлығы
Dialogue: 0,0:08:29.54,0:08:32.56,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:08:32.56,0:08:34.89,Default,,0,0,0,,Кез келген бехелит емес
Dialogue: 0,0:08:34.89,0:08:38.50,Default,,0,0,0,,Біз қорғаншы періштелер Құдайдың қолы ретінде реинкарнацияланамыз.
Dialogue: 0,0:08:38.50,0:08:40.74,Default,,0,0,0,,Тек оны ала алатындар
Dialogue: 0,0:08:40.74,0:08:43.51,Default,,0,0,0,,Қып-қызыл Бехелит
Dialogue: 0,0:08:43.51,0:08:45.61,Default,,0,0,0,,Бұл қожайынның жұмыртқасы.
Dialogue: 0,0:08:48.18,0:08:53.59,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:09:29.26,0:09:31.91,Default,,0,0,0,,Мұндай құбыжық үшін Гриффит
Dialogue: 0,0:09:31.91,0:09:33.85,Default,,0,0,0,,Егер сіз оны өзгертсеңіз
Dialogue: 0,0:09:33.85,0:09:36.28,Default,,0,0,0,,Біздің өмірімізге айырбас ретінде
Dialogue: 0,0:09:36.28,0:09:38.28,Default,,0,0,0,,Бұл сәл басқаша.
Dialogue: 0,0:09:38.28,0:09:40.86,Default,,0,0,0,,Мұны істеу оның еркі
Dialogue: 0,0:09:40.86,0:09:43.83,Default,,0,0,0,,Ол сені құрбан етеді
Dialogue: 0,0:09:43.83,0:09:45.83,Default,,0,0,0,,Га
Dialogue: 0,0:09:48.00,0:09:51.88,Default,,0,0,0,,Бұл шындық болуы мүмкін емес, солай емес пе?
Dialogue: 0,0:09:51.88,0:09:55.49,Default,,0,0,0,,Барлығы себеп-салдар ағымында
Dialogue: 0,0:09:55.49,0:09:57.79,Default,,0,0,0,,Барлығы тағайындалды
Dialogue: 0,0:09:57.79,0:10:00.84,Default,,0,0,0,,Сіздің өміріңіз - бұл қасиетті торап
Dialogue: 0,0:10:00.84,0:10:03.30,Default,,0,0,0,,Тұтылу үшін айналдырылды
Dialogue: 0,0:10:03.30,0:10:07.51,Default,,0,0,0,,Енді жын шығару рәсімі өтеді.
Dialogue: 0,0:10:07.51,0:10:09.99,Default,,0,0,0,,Ұлын құрбандық үстеліне апару
Dialogue: 0,0:10:09.99,0:10:12.89,Default,,0,0,0,,Увааааааааааааааааааааааааа
Dialogue: 0,0:10:12.89,0:10:14.89,Default,,0,0,0,,Не?
Dialogue: 0,0:10:17.36,0:10:20.58,Default,,0,0,0,,Алдау екенін біліп тұрып, не болып жатқанын маған неге айтпадың?
Dialogue: 0,0:10:20.58,0:10:22.88,Default,,0,0,0,,Ахххх...
Dialogue: 0,0:10:28.05,0:10:30.46,Default,,0,0,0,,Ішім! Гриффит!
Dialogue: 0,0:10:35.70,0:10:38.67,Default,,0,0,0,,Ууууууу...
Dialogue: 0,0:10:38.67,0:10:41.92,Default,,0,0,0,,Уф
Dialogue: 0,0:10:41.92,0:10:44.75,Default,,0,0,0,,Га
Dialogue: 0,0:10:44.75,0:10:46.85,Default,,0,0,0,,Ei
Dialogue: 0,0:10:50.47,0:10:52.47,Default,,0,0,0,,Га
Dialogue: 0,0:10:54.37,0:10:56.64,Default,,0,0,0,,Ei
Dialogue: 0,0:10:56.64,0:10:59.55,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:10:59.55,0:11:03.36,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:11:03.36,0:11:05.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:16.82,0:11:19.05,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:11:19.05,0:11:27.10,Default,,0,0,0,,Жын шығару рәсімі
Dialogue: 0,0:11:27.10,0:11:29.70,Default,,0,0,0,,Иә
Dialogue: 0,0:11:41.34,0:11:45.57,Default,,0,0,0,,Қорқынышты ма?
Dialogue: 0,0:11:45.57,0:11:48.54,Default,,0,0,0,,Жоғарыдағылар ретінде біз кімбіз?
Dialogue: 0,0:11:48.54,0:11:53.33,Default,,0,0,0,,Әлде…
Dialogue: 0,0:11:53.33,0:11:57.76,Default,,0,0,0,,Болашаққа жеткенше тағы да
Dialogue: 0,0:11:57.76,0:12:02.28,Default,,0,0,0,,Бастапқы пейзажыңызға
Dialogue: 0,0:12:02.28,0:12:04.88,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:12:09.05,0:12:11.56,Default,,0,0,0,,Га
Dialogue: 0,0:12:11.56,0:12:14.27,Default,,0,0,0,,Барлығы
Dialogue: 0,0:12:14.27,0:12:16.57,Default,,0,0,0,,Он соққылы қарғыс техникасы: Тайл құлау, Тайл құлау!
Dialogue: 0,0:12:18.67,0:12:20.78,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:12:30.17,0:12:32.54,Default,,0,0,0,,Міне
Dialogue: 0,0:12:32.54,0:12:34.51,Default,,0,0,0,,Мен адасып қалдым.
Dialogue: 0,0:12:34.51,0:12:37.11,Default,,0,0,0,,Эй
Dialogue: 0,0:12:40.19,0:12:42.26,Default,,0,0,0,,Мелло
Dialogue: 0,0:12:42.26,0:12:44.43,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:44.43,0:12:47.03,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:12:47.03,0:12:49.43,Default,,0,0,0,,Мен алға барып, күтемін.
Dialogue: 0,0:13:01.46,0:13:05.23,Default,,0,0,0,,Га
Dialogue: 0,0:13:05.23,0:13:09.20,Default,,0,0,0,,Мен бейтаныс жерге келдім.
Dialogue: 0,0:13:09.20,0:13:12.21,Default,,0,0,0,,Эй
Dialogue: 0,0:13:14.52,0:13:18.99,Default,,0,0,0,,Дегенмен, патшаңыздың қазір есінен адасқаны анық.
Dialogue: 0,0:13:18.99,0:13:24.61,Default,,0,0,0,,Ах
Dialogue: 0,0:13:24.61,0:13:27.91,Default,,0,0,0,,Ол шулы бала.
Dialogue: 0,0:13:27.91,0:13:30.22,Default,,0,0,0,,Әже
Dialogue: 0,0:13:30.22,0:13:33.49,Default,,0,0,0,,Көптеген адамдар
Dialogue: 0,0:13:33.49,0:13:37.06,Default,,0,0,0,,Білгенің өте қорқынышты.
Dialogue: 0,0:13:37.06,0:13:39.13,Default,,0,0,0,,Бұл өтірік пе?
Dialogue: 0,0:13:39.13,0:13:42.98,Default,,0,0,0,,Бл…ээ…!!
Dialogue: 0,0:13:42.98,0:13:45.91,Default,,0,0,0,,Мынау... сол қамалға қарай бет алған адам.
Dialogue: 0,0:13:45.91,0:13:49.72,Default,,0,0,0,,Осында жатқан адамды басайын ба?
Dialogue: 0,0:13:49.72,0:13:54.50,Default,,0,0,0,,Әйтпесе
Dialogue: 0,0:13:54.50,0:13:57.10,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:14:04.22,0:14:06.22,Default,,0,0,0,,'Ол да сондай.'
Dialogue: 0,0:14:06.22,0:14:10.37,Default,,0,0,0,,Сен
Dialogue: 0,0:14:10.37,0:14:14.54,Default,,0,0,0,,Бұл керемет, мен рыцарь болғым келеді.
Dialogue: 0,0:14:14.54,0:14:17.88,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:14:17.88,0:14:19.91,Default,,0,0,0,,Мені де өзіңмен бірге ала кет.
Dialogue: 0,0:14:19.91,0:14:22.52,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:14:22.52,0:14:26.90,Default,,0,0,0,,Эй
Dialogue: 0,0:14:26.90,0:14:28.83,Default,,0,0,0,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:14:28.83,0:14:31.51,Default,,0,0,0,,Иә
Dialogue: 0,0:14:31.51,0:14:34.45,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:14:34.45,0:14:39.25,Default,,0,0,0,,Өйткені сен
Dialogue: 0,0:14:39.25,0:14:42.66,Default,,0,0,0,,Бізді де өзіңізбен бірге алып кетіңіз.
Dialogue: 0,0:14:42.66,0:14:45.57,Default,,0,0,0,,Біз
Dialogue: 0,0:14:45.57,0:14:48.47,Default,,0,0,0,,Егер сіз
Dialogue: 0,0:14:48.47,0:14:51.92,Default,,0,0,0,,Мен оны көргім келеді
Dialogue: 0,0:14:51.92,0:14:55.92,Default,,0,0,0,,Туыңыздың астында күресуге рұқсат етіңіз
Dialogue: 0,0:14:55.92,0:14:58.19,Default,,0,0,0,,Миссия аяқталған соң маған үйлен.
Dialogue: 0,0:14:58.19,0:15:00.14,Default,,0,0,0,,Мен сені өзіммен бірге ала алмаймын.
Dialogue: 0,0:15:00.14,0:15:02.17,Default,,0,0,0,,(Саяма) Ой! (Джунпей) Уф...
Dialogue: 0,0:15:02.17,0:15:04.44,Default,,0,0,0,,Өйткені ол енді тірі емес
Dialogue: 0,0:15:04.44,0:15:06.98,Default,,0,0,0,,Сонымен
Dialogue: 0,0:15:06.98,0:15:10.62,Default,,0,0,0,,Мен сені өзіммен бірге ала алмаймын.
Dialogue: 0,0:15:10.62,0:15:13.32,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:13.32,0:15:16.23,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:15:16.23,0:15:19.13,Default,,0,0,0,,Жалпы
Dialogue: 0,0:15:19.13,0:15:21.14,Default,,0,0,0,,Бұл сенсің, солай емес пе?
Dialogue: 0,0:15:21.14,0:15:24.51,Default,,0,0,0,,Өйткені
Dialogue: 0,0:15:24.51,0:15:27.55,Default,,0,0,0,,Бұл сіздің басыңыздан өтті.
Dialogue: 0,0:15:27.55,0:15:32.00,Default,,0,0,0,,Мен мұны айтуым керек
Dialogue: 0,0:15:32.00,0:15:36.37,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:36.37,0:15:38.64,Default,,0,0,0,,Жақсы
Dialogue: 0,0:15:38.64,0:15:43.05,Default,,0,0,0,,Осы уақытқа дейін жету үшін кімге қарыздар деп ойлайсың?
Dialogue: 0,0:15:43.05,0:15:45.95,Default,,0,0,0,,Тыңдаңыз
Dialogue: 0,0:15:45.95,0:15:49.52,Default,,0,0,0,,Ол сол балалардың мәйіттерінен жасалған.
Dialogue: 0,0:15:49.52,0:15:53.44,Default,,0,0,0,,Бұл ғана емес, әлгі балалар
Dialogue: 0,0:15:53.44,0:15:56.11,Default,,0,0,0,,Мәйіттердің санын көбейткеніңізге рахмет.
Dialogue: 0,0:15:56.11,0:15:59.51,Default,,0,0,0,,Мен осы уақытқа дейін келе алдым.
Dialogue: 0,0:15:59.51,0:16:01.92,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:16:01.92,0:16:05.36,Default,,0,0,0,,Бұдан басқа
Dialogue: 0,0:16:05.36,0:16:10.61,Default,,0,0,0,,Бізге көбірек мәйіттерді үйіп тастау керек.
Dialogue: 0,0:16:10.61,0:16:13.95,Default,,0,0,0,,Не болды?
Dialogue: 0,0:16:13.95,0:16:16.68,Default,,0,0,0,,Артқа бұрылғыңыз келді ме?
Dialogue: 0,0:16:16.68,0:16:19.25,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:16:19.25,0:16:21.30,Default,,0,0,0,,Егер сіз мұны істесеңіз, қазір сіз
Dialogue: 0,0:16:21.30,0:16:25.07,Default,,0,0,0,,Осы мәйіттердің қатарына қосыласың.
Dialogue: 0,0:16:25.07,0:16:30.25,Default,,0,0,0,,Ха, қараңызшы.
Dialogue: 0,0:16:30.25,0:16:34.49,Default,,0,0,0,,Га
Dialogue: 0,0:16:34.49,0:16:38.42,Default,,0,0,0,,Қолдар
Dialogue: 0,0:16:38.42,0:16:41.27,Default,,0,0,0,,Мен өкінгенше, басынан бастағанды ​​жақсы көремін.
Dialogue: 0,0:16:41.27,0:16:43.20,Default,,0,0,0,,Келме
Dialogue: 0,0:16:43.20,0:16:46.54,Default,,0,0,0,,Бұл
Dialogue: 0,0:16:46.54,0:16:48.88,Default,,0,0,0,,Ууууууууууу неге артқы аллеядан?
Dialogue: 0,0:16:48.88,0:16:52.39,Default,,0,0,0,,Мен қамалға қарап қана ризамын
Dialogue: 0,0:16:58.33,0:17:01.94,Default,,0,0,0,,Мен мұны түсінбеймін!
Dialogue: 0,0:17:01.94,0:17:04.75,Default,,0,0,0,,Одамари Сіз білуіңіз керек еді
Dialogue: 0,0:17:04.75,0:17:06.75,Default,,0,0,0,,Мұнда
Dialogue: 0,0:17:12.03,0:17:14.93,Default,,0,0,0,,білген
Dialogue: 0,0:17:14.93,0:17:18.43,Default,,0,0,0,,Барлығынан жоғары жүру
Dialogue: 0,0:17:20.58,0:17:22.78,Default,,0,0,0,,«Кугисаки, одан да жылдам жүгіресің бе?»
Dialogue: 0,0:17:25.42,0:17:29.39,Default,,0,0,0,,Бұл сіздің арманыңызға апаратын жол, солай ма?
Dialogue: 0,0:17:29.39,0:17:31.77,Default,,0,0,0,,Иә
Dialogue: 0,0:17:31.77,0:17:35.21,Default,,0,0,0,,Көтерілген жеріміз – құлайтын жеріміз.
Dialogue: 0,0:17:35.21,0:17:39.08,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:17:39.08,0:17:41.52,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:17:41.52,0:17:45.03,Default,,0,0,0,,Басыңа түспес бұрын оны жинап ал.
Dialogue: 0,0:17:45.03,0:17:47.03,Default,,0,0,0,,Мәйіт
Dialogue: 0,0:17:50.74,0:17:56.38,Default,,0,0,0,,Иә
Dialogue: 0,0:17:56.38,0:17:58.68,Default,,0,0,0,,Күнәларың үшін өкінгеннің мәні неде?
Dialogue: 0,0:18:01.03,0:18:04.23,Default,,0,0,0,,Өлгендерге
Dialogue: 0,0:18:04.23,0:18:07.14,Default,,0,0,0,,Мен кешірім сұрай алмаймын
Dialogue: 0,0:18:07.14,0:18:11.92,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:18:11.92,0:18:15.42,Default,,0,0,0,,Кешірім сұрасаң, өкінсең,
Dialogue: 0,0:18:15.42,0:18:18.36,Default,,0,0,0,,Өйткені бәрі бітеді
Dialogue: 0,0:18:18.36,0:18:22.07,Default,,0,0,0,,Онда
Dialogue: 0,0:18:24.27,0:18:27.37,Default,,0,0,0,,Иә
Dialogue: 0,0:18:29.54,0:18:32.59,Default,,0,0,0,,Иллюзия... Бұл елес емес.
Dialogue: 0,0:18:32.59,0:18:35.99,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:18:35.99,0:18:39.66,Default,,0,0,0,,Аспандағы қамалды көздеп, төбесіне мәйіттерді үйіп тастауды жалғастыру
Dialogue: 0,0:18:39.66,0:18:42.58,Default,,0,0,0,,Мацуда! Бұл бала ойыны емес
Dialogue: 0,0:18:42.58,0:18:44.81,Default,,0,0,0,,Мың серік мәйіт үстінде
Dialogue: 0,0:18:44.81,0:18:49.62,Default,,0,0,0,,Мың жолдас құрған, Он мың жаудың өлігінен.
Dialogue: 0,0:18:49.62,0:18:52.53,Default,,0,0,0,,Ешбір, атаусыз
Dialogue: 0,0:18:52.53,0:18:55.00,Default,,0,0,0,,Сіз қадам бастыңыз
Dialogue: 0,0:18:55.00,0:18:58.27,Default,,0,0,0,,Бір ойдың арқасында
Dialogue: 0,0:18:58.27,0:19:03.12,Default,,0,0,0,,Ал қазір
Dialogue: 0,0:19:03.12,0:19:05.95,Default,,0,0,0,,Бірақ қараңыз
Dialogue: 0,0:19:05.95,0:19:11.20,Default,,0,0,0,,Қанды сапарыңыздың соңында сізге соңғы нәрсе қалды
Dialogue: 0,0:19:11.20,0:19:14.11,Default,,0,0,0,,Бірге ұша берген сұңқардың қанаттары
Dialogue: 0,0:19:14.11,0:19:16.51,Default,,0,0,0,,Әрбір бөлік
Dialogue: 0,0:19:16.51,0:19:19.48,Default,,0,0,0,,Олар
Dialogue: 0,0:19:19.48,0:19:22.89,Default,,0,0,0,,Мен қазір түңілсем де
Dialogue: 0,0:19:22.89,0:19:26.79,Default,,0,0,0,,Олар сізді жылы қарсы алады.
Dialogue: 0,0:19:26.79,0:19:30.17,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:19:30.17,0:19:33.74,Default,,0,0,0,,Оларға жаралы денеңді сеніп тапсыр
Dialogue: 0,0:19:33.74,0:19:37.21,Default,,0,0,0,,Барлығын өткенге өзгерту
Dialogue: 0,0:19:37.21,0:19:39.61,Default,,0,0,0,,Қиялдың қалдықтарына көмілген
Dialogue: 0,0:19:42.10,0:19:44.97,Default,,0,0,0,,Арман
Dialogue: 0,0:19:44.97,0:19:49.17,Default,,0,0,0,,Бұл адам жасаған Құдайдың жазасы.
Dialogue: 0,0:19:51.25,0:19:54.12,Default,,0,0,0,,Бірақ
Dialogue: 0,0:19:54.12,0:19:56.72,Default,,0,0,0,,Сіздің көзіңізде
Dialogue: 0,0:19:56.72,0:20:01.04,Default,,0,0,0,,Егер ол көзді жаудырса
Dialogue: 0,0:20:01.04,0:20:03.94,Default,,0,0,0,,Сізден қалғанның бәрі
Dialogue: 0,0:20:03.94,0:20:08.54,Default,,0,0,0,,Сөзді айт және оны ұсын.
Dialogue: 0,0:20:08.54,0:20:10.92,Default,,0,0,0,,Егер орындасаңыз
Dialogue: 0,0:20:10.92,0:20:14.66,Default,,0,0,0,,Мен саған қара қанатты бермеймін.
Dialogue: 0,0:20:14.66,0:20:17.16,Default,,0,0,0,,Тағдыр адам даналығынан асып түседі
Dialogue: 0,0:20:17.16,0:20:19.66,Default,,0,0,0,,Адам баласымен ойнау заң болса
Dialogue: 0,0:20:19.66,0:20:22.24,Default,,0,0,0,,Адам Ұлын жындар құртады
Dialogue: 0,0:20:22.24,0:20:24.28,Default,,0,0,0,,Қарама-қарсы - себеп пен салдар
Dialogue: 0,0:20:24.28,0:20:26.41,Default,,0,0,0,,Гриффит!
Dialogue: 0,0:20:26.41,0:20:35.76,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:20:37.87,0:20:41.52,Default,,0,0,0,,Иә
Dialogue: 0,0:20:41.52,0:20:45.02,Default,,0,0,0,,Он мыңдаған жаулардың арасында
Dialogue: 0,0:20:47.09,0:20:49.59,Default,,0,0,0,,Бір ғана адам
Dialogue: 0,0:20:55.14,0:20:57.34,Default,,0,0,0,,Маған армандарымды ұмыттырды
Dialogue: 0,0:20:59.54,0:21:01.85,Default,,0,0,0,,Арнау
Dialogue: 0,0:21:04.89,0:21:08.26,Default,,0,0,0,,Уау
Dialogue: 0,0:21:08.26,0:21:12.94,Default,,0,0,0,,Гриффит! Себеп-салдар заңы арқылы бір-бірімен байланысқан жіптер
Dialogue: 0,0:21:12.94,0:21:17.44,Default,,0,0,0,,Көп емес екен, иә?
Dialogue: 0,0:21:21.73,0:21:24.60,Default,,0,0,0,,Ахх уау
Dialogue: 0,0:21:24.60,0:21:26.87,Default,,0,0,0,,Ах, оо
Dialogue: 0,0:21:26.87,0:21:29.77,Default,,0,0,0,,Уф
Dialogue: 0,0:21:31.27,0:21:36.27,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
