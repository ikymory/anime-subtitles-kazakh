Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:25.60,0:00:26.52,Default,,0,0,0,,(ит үреді)
Dialogue: 0,0:00:28.73,0:00:30.78,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:00:28.73,0:00:30.78,Default,,0,0,0,,(Гармоника орындауы)
Dialogue: 0,0:00:30.78,0:00:34.40,Default,,0,0,0,,(гармоникалық өнімділік)
Dialogue: 0,0:00:43.87,0:00:46.96,Default,,0,0,0,,(Ер адамның қатты тыныс алуы)
Dialogue: 0,0:00:47.04,0:00:48.38,Default,,0,0,0,,Инумаки-сенпай оны тоқтатады. Қорқпа—баста!
Dialogue: 0,0:00:48.46,0:00:49.25,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,0:00:49.25,0:00:50.96,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:00:52.71,0:00:57.09,Default,,0,0,0,,(Репортердің ағылшын тілі)
Dialogue: 0,0:01:07.56,0:01:09.61,Default,,0,0,0,,Ах… Уф…
Dialogue: 0,0:01:12.90,0:01:13.74,Default,,0,0,0,,Сен кереметсің, Кёко. Ол қандай? Сымбатты ма?
Dialogue: 0,0:01:14.90,0:01:17.03,Default,,0,0,0,,-(Ер) Ух... -(Әйел) Ой...
Dialogue: 0,0:01:18.36,0:01:19.53,Default,,0,0,0,,(Ерлер ағылшын)
Dialogue: 0,0:01:21.20,0:01:22.87,Default,,0,0,0,,Ах... уау
Dialogue: 0,0:01:25.46,0:01:27.21,Default,,0,0,0,,Уф... аааа
Dialogue: 0,0:01:30.29,0:01:31.34,Default,,0,0,0,,Я...
Dialogue: 0,0:01:34.17,0:01:35.84,Default,,0,0,0,,(Орындау аяқталады)
Dialogue: 0,0:01:35.92,0:01:39.51,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:01:39.59,0:01:44.22,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:01:47.10,0:01:52.73,Default,,0,0,0,,(Шығу қоңырауы)
Dialogue: 0,0:02:11.25,0:02:14.30,Default,,0,0,0,,Бұл вакуумдық асқын өткізгіш сызықтық лайнер болып табылады
Dialogue: 0,0:02:14.38,0:02:18.13,Default,,0,0,0,,Максималды жылдамдық – 1000км/сағ!
Dialogue: 0,0:02:22.05,0:02:23.14,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:02:23.22,0:02:24.72,Default,,0,0,0,,Уау, бұл бір сәт болды.
Dialogue: 0,0:02:24.81,0:02:26.31,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:02:26.39,0:02:27.85,Default,,0,0,0,,Мен жақында мінгім келеді.
Dialogue: 0,0:02:27.93,0:02:32.36,Default,,0,0,0,,Баршаңызға, қошемет көрсеткендеріңіз үшін көп рахмет.
Dialogue: 0,0:02:33.48,0:02:37.36,Default,,0,0,0,,Бұл жаңадан жасалған вакуумдық асқын өткізгіш маглев
Dialogue: 0,0:02:37.44,0:02:41.49,Default,,0,0,0,,Токиодағы Шин-Нагоя станциясы мен Шибахама станциясының арасы...
Dialogue: 0,0:02:41.57,0:02:44.12,Default,,0,0,0,,Мен оны 25 минутта өтемін! Хехе
Dialogue: 0,0:02:44.12,0:02:45.74,Default,,0,0,0,,Біз оны 25 минутта орындаймыз! Хехе
Dialogue: 0,0:02:44.12,0:02:45.74,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:02:45.83,0:02:47.50,Default,,0,0,0,,Керемет!
Dialogue: 0,0:02:48.87,0:02:51.29,Default,,0,0,0,,Бірақ Шибахама станциясы қайда?
Dialogue: 0,0:02:51.37,0:02:53.71,Default,,0,0,0,,Не, сен білмейсің бе? Гента-кун
Dialogue: 0,0:02:53.79,0:02:54.63,Default,,0,0,0,,Иә
Dialogue: 0,0:02:54.71,0:02:57.26,Default,,0,0,0,,Әпкем маған қазір түсіндіремін дейді.
Dialogue: 0,0:02:57.34,0:02:58.72,Default,,0,0,0,,О, бұл дұрыс болды.
Dialogue: 0,0:02:58.72,0:02:59.67,Default,,0,0,0,,О, бұл дұрыс болды.
Dialogue: 0,0:02:58.72,0:02:59.67,Default,,0,0,0,,ең алдымен
Dialogue: 0,0:03:00.34,0:03:04.14,Default,,0,0,0,,Шибахама станциясы Кавасина станциясы мен Окамацучо станциясы арасында салынды.
Dialogue: 0,0:03:04.22,0:03:06.81,Default,,0,0,0,,Тек кету және келу үшін вакуумдық асқын өткізгіш маглев
Dialogue: 0,0:03:06.89,0:03:07.93,Default,,0,0,0,,Құрылған
Dialogue: 0,0:03:08.64,0:03:10.89,Default,,0,0,0,,Ал бүгінгі өтетін орын да...
Dialogue: 0,0:03:10.98,0:03:14.52,Default,,0,0,0,,Shibahama View қонақ үйі мен вокзал жерасты өткелімен байланысты.
Dialogue: 0,0:03:14.61,0:03:18.65,Default,,0,0,0,,WSG Tokyo ашылу салтанаты келесі айда өтеді.
Dialogue: 0,0:03:18.74,0:03:21.82,Default,,0,0,0,,Шибахама стадионына тікелей қосылған.
Dialogue: 0,0:03:22.57,0:03:26.08,Default,,0,0,0,,Шибахаманың айналасы WSG Tokyo ашылғаннан кейін де жалғасады.
Dialogue: 0,0:03:26.16,0:03:31.33,Default,,0,0,0,,Вакуумдық асқын өткізгіш сызықтың бастапқы станциясы ретінде ол адамдар үшін негіз болады.
Dialogue: 0,0:03:31.96,0:03:34.79,Default,,0,0,0,,«WSG» нені білдіреді?
Dialogue: 0,0:03:34.88,0:03:36.75,Default,,0,0,0,,Аюми мен түсінбедім
Dialogue: 0,0:03:36.84,0:03:38.46,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,0:03:38.55,0:03:40.34,Default,,0,0,0,,-Не уайымдап тұрсың? -(3 адам) А?
Dialogue: 0,0:03:41.01,0:03:43.22,Default,,0,0,0,,Ах, Конан-кун, Ай-чан.
Dialogue: 0,0:03:43.30,0:03:45.72,Default,,0,0,0,,Дәретхана ұзаққа созылды.
Dialogue: 0,0:03:45.80,0:03:47.81,Default,,0,0,0,,Мен оны іздеп адасып қалдым.
Dialogue: 0,0:03:47.89,0:03:50.06,Default,,0,0,0,,Барлығын күткенім үшін кешіріңіз.
Dialogue: 0,0:03:50.14,0:03:51.48,Default,,0,0,0,,- (Гента) Эй, Конан - А?
Dialogue: 0,0:03:51.56,0:03:53.73,Default,,0,0,0,,Сіз «WSG» білесіз бе?
Dialogue: 0,0:03:53.81,0:03:54.85,Default,,0,0,0,,О, әрине
Dialogue: 0,0:03:55.73,0:03:57.94,Default,,0,0,0,,Дүниежүзілік спорт ойындары
Dialogue: 0,0:03:58.02,0:04:00.99,Default,,0,0,0,,қысқаша «WSG».
Dialogue: 0,0:04:01.07,0:04:03.74,Default,,0,0,0,,Бұл төрт жылда бір рет өтетін спорттық турнир.
Dialogue: 0,0:04:03.82,0:04:07.83,Default,,0,0,0,,Әлемнің түкпір-түкпірінен келген спортшылар өз елдерінің беделі үшін жарысады.
Dialogue: 0,0:04:07.91,0:04:10.95,Default,,0,0,0,,Ху~ (адамдар қолдайды)
Dialogue: 0,0:04:11.04,0:04:11.87,Default,,0,0,0,,- (Хайбара) А? - Ах...
Dialogue: 0,0:04:12.46,0:04:15.33,Default,,0,0,0,,Оны мінгендер бүгін бар
Dialogue: 0,0:04:15.42,0:04:18.34,Default,,0,0,0,,Құрметті WSG Tokyo демеушілері
Dialogue: 0,0:04:18.42,0:04:22.42,Default,,0,0,0,,Әр елдегі барлық WSG қауымдастықтарына.
Dialogue: 0,0:04:24.13,0:04:26.14,Default,,0,0,0,,Сондай-ақ, бүгінде өкіл ретінде
Dialogue: 0,0:04:26.22,0:04:28.51,Default,,0,0,0,,Халықаралық WSG қауымдастығының төрағасы
Dialogue: 0,0:04:28.60,0:04:29.89,Default,,0,0,0,,Алан Маккензиден
Dialogue: 0,0:04:29.97,0:04:30.77,Default,,0,0,0,,Түсініктемелер алынды
Dialogue: 0,0:04:30.77,0:04:32.27,Default,,0,0,0,,Түсініктемелер алынды
Dialogue: 0,0:04:30.77,0:04:32.27,Default,,0,0,0,,ФБР директоры?
Dialogue: 0,0:04:33.14,0:04:36.27,Default,,0,0,0,,Ниппон жоқ Минасан Конничиха
Dialogue: 0,0:04:36.35,0:04:42.24,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,0:04:47.37,0:04:50.12,Default,,0,0,0,,Рахмет Алан
Dialogue: 0,0:04:47.37,0:04:50.12,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:04:50.20,0:04:51.58,Default,,0,0,0,,Міне, барлығыңызға
Dialogue: 0,0:04:51.58,0:04:52.04,Default,,0,0,0,,Міне, сізге:
Dialogue: 0,0:04:51.58,0:04:52.04,Default,,0,0,0,,Керемет~ Мен де мінемін.
Dialogue: 0,0:04:52.04,0:04:52.12,Default,,0,0,0,,Керемет~ Мен де мінемін.
Dialogue: 0,0:04:52.12,0:04:54.12,Default,,0,0,0,,Керемет~ Мен де мінемін.
Dialogue: 0,0:04:52.12,0:04:54.12,Default,,0,0,0,,Менің саған айтар сөзім бар.
Dialogue: 0,0:04:54.12,0:04:54.21,Default,,0,0,0,,Өте тамаша~ Мен де мінемін.
Dialogue: 0,0:04:54.21,0:04:55.25,Default,,0,0,0,,Керемет~ Мен де мінемін.
Dialogue: 0,0:04:54.21,0:04:55.25,Default,,0,0,0,,Қаншалықты сызықтық
Dialogue: 0,0:04:55.25,0:04:55.33,Default,,0,0,0,,Қаншалықты сызықтық
Dialogue: 0,0:04:55.33,0:04:55.96,Default,,0,0,0,,Қаншалықты сызықтық
Dialogue: 0,0:04:55.33,0:04:55.96,Default,,0,0,0,,- (Мицухико) Қарапайым адамдар үшін бұл мүмкін емес - (Аюми) Иә, иә.
Dialogue: 0,0:04:55.96,0:04:56.04,Default,,0,0,0,,- (Мицухико) Қарапайым адамдар үшін бұл мүмкін емес - (Аюми) Иә, иә.
Dialogue: 0,0:04:56.04,0:04:58.04,Default,,0,0,0,,- (Мицухико) Қарапайым адамдар үшін бұл мүмкін емес - (Аюми) Иә, иә.
Dialogue: 0,0:04:56.04,0:04:58.04,Default,,0,0,0,,Жалпы жұртшылық лотерея арқылы да міне алады.
Dialogue: 0,0:04:58.04,0:04:58.96,Default,,0,0,0,,Жалпы жұртшылық лотерея арқылы да міне алады.
Dialogue: 0,0:04:59.04,0:05:01.17,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:04:59.04,0:05:01.17,Default,,0,0,0,,Шешім қабылданды!
Dialogue: 0,0:05:01.25,0:05:02.34,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:02.92,0:05:03.97,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:05:04.05,0:05:06.22,Default,,0,0,0,,Бұл балалар оны жек көреді, өйткені олар оны әлдеқашан алған деп ойлайды.
Dialogue: 0,0:05:06.30,0:05:09.26,Default,,0,0,0,,Бірақ қуануға әлі ерте емес пе?
Dialogue: 0,0:05:09.35,0:05:11.10,Default,,0,0,0,,- (Мицухико) Эх - (Аюми) Е, неге?
Dialogue: 0,0:05:11.18,0:05:13.06,Default,,0,0,0,,Сіз бұл лотерея деп айттыңыз.
Dialogue: 0,0:05:13.14,0:05:15.39,Default,,0,0,0,,Үлкейту қаншалықты жоғары деп ойлайсыз?
Dialogue: 0,0:05:15.48,0:05:17.52,Default,,0,0,0,,Бұл не, сараң жын патша?
Dialogue: 0,0:05:17.60,0:05:20.23,Default,,0,0,0,,Жоқ, әлі де жол бар.
Dialogue: 0,0:05:20.31,0:05:23.07,Default,,0,0,0,,Менің ойымша, кейбір компаниялар Suzuki Zaibatsu
Dialogue: 0,0:05:23.15,0:05:25.86,Default,,0,0,0,,WSG Tokyo демеушісі болуы керек еді
Dialogue: 0,0:05:25.95,0:05:29.24,Default,,0,0,0,,Түсіндім! Соноко-оне-саннан сұрау керек.
Dialogue: 0,0:05:29.32,0:05:31.28,Default,,0,0,0,,Бұл «Жарайды» емес.
Dialogue: 0,0:05:31.37,0:05:35.83,Default,,0,0,0,,Платина билетін бұлай оңай алу мүмкін емес.
Dialogue: 0,0:05:35.91,0:05:38.29,Default,,0,0,0,,Дүние ондай емес.
Dialogue: 0,0:05:38.37,0:05:42.17,Default,,0,0,0,,Соноко, сенен бірдеңе сұрауым керек пе?
Dialogue: 0,0:05:42.25,0:05:45.30,Default,,0,0,0,,Егер бұл тек балаларға арналған болса...
Dialogue: 0,0:05:45.38,0:05:47.18,Default,,0,0,0,,Ооо!
Dialogue: 0,0:05:47.26,0:05:48.43,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,0:05:48.51,0:05:51.05,Default,,0,0,0,,Балаларды тым құртып жатқан жоқсың ба?
Dialogue: 0,0:05:51.14,0:05:53.26,Default,,0,0,0,,Бөлмеңіз
Dialogue: 0,0:05:53.35,0:05:55.06,Default,,0,0,0,,Бұл жақсы болды.
Dialogue: 0,0:05:55.14,0:05:56.35,Default,,0,0,0,,Маған кедергі жасама
Dialogue: 0,0:05:56.43,0:05:57.73,Default,,0,0,0,,(Үкідің ұлуы)
Dialogue: 0,0:05:57.81,0:05:59.31,Default,,0,0,0,,Балалар
Dialogue: 0,0:05:59.40,0:06:02.32,Default,,0,0,0,,Осы жерде болғаныңыз үшін риза болыңыз!
Dialogue: 0,0:06:02.40,0:06:03.94,Default,,0,0,0,,Иә
Dialogue: 0,0:06:04.03,0:06:05.49,Default,,0,0,0,,Кешіріңіз, бос емес.
Dialogue: 0,0:06:05.57,0:06:06.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:06.49,0:06:07.32,Default,,0,0,0,,Енді осында
Dialogue: 0,0:06:07.40,0:06:10.11,Default,,0,0,0,,Азық-түлік вагондарын тізуге бола ма?
Dialogue: 0,0:06:10.20,0:06:11.74,Default,,0,0,0,,А... иә.
Dialogue: 0,0:06:11.82,0:06:13.99,Default,,0,0,0,,Мен бірден келемін
Dialogue: 0,0:06:20.21,0:06:22.04,Default,,0,0,0,,- (Гента) Дәмді ~ - (Мицухико/Аюми) Дәмді ~
Dialogue: 0,0:06:22.13,0:06:24.09,Default,,0,0,0,,Барлығы тамақтанып болған соң
Dialogue: 0,0:06:24.17,0:06:25.76,Default,,0,0,0,,Есіктің алдында кездесейік.
Dialogue: 0,0:06:25.84,0:06:26.96,Default,,0,0,0,,Уа!
Dialogue: 0,0:06:27.05,0:06:28.55,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:06:28.63,0:06:29.63,Default,,0,0,0,,- (Мицухико) Иә! -(Аюми) Ой!
Dialogue: 0,0:06:29.72,0:06:32.05,Default,,0,0,0,,Мен көп жеп, ақшамды қайтарамын.
Dialogue: 0,0:06:32.14,0:06:33.72,Default,,0,0,0,,Гента-кун, солай.
Dialogue: 0,0:06:33.81,0:06:36.02,Default,,0,0,0,,Тым ерте ауысу
Dialogue: 0,0:06:33.81,0:06:36.02,Default,,0,0,0,,Бұл ақшаны төлеген адам айтқан жол.
Dialogue: 0,0:06:36.10,0:06:39.14,Default,,0,0,0,,Иә, бізден жас.
Dialogue: 0,0:06:39.23,0:06:42.69,Default,,0,0,0,,Жас... Сіз бен біз әлі жасөспірімміз.
Dialogue: 0,0:06:42.77,0:06:44.86,Default,,0,0,0,,Олай болса, икемді болыңыз.
Dialogue: 0,0:06:44.94,0:06:47.44,Default,,0,0,0,,Бейкүнә сәбилерге сәлем
Dialogue: 0,0:06:49.36,0:06:51.03,Default,,0,0,0,,Иә? Электр қуатының үзілуі?
Dialogue: 0,0:06:51.11,0:06:52.12,Default,,0,0,0,,- (Гента) Не? - (Мицухико/Аюми) Иә?
Dialogue: 0,0:06:52.20,0:06:54.12,Default,,0,0,0,,(Нанами) Менің шабуылдарым оған әсер етпейді.
Dialogue: 0,0:06:54.20,0:06:55.28,Default,,0,0,0,,Shibahama View қонақүйінен
Dialogue: 0,0:06:55.37,0:06:56.62,Default,,0,0,0,,Біз сізге хабарлаймыз
Dialogue: 0,0:06:56.70,0:06:57.20,Default,,0,0,0,,Ах
Dialogue: 0,0:06:57.20,0:06:57.95,Default,,0,0,0,,Ах
Dialogue: 0,0:06:57.20,0:06:57.95,Default,,0,0,0,,Қазіргі уақытта тақ санды қабаттарда электр қуаты үзілуде.
Dialogue: 0,0:06:57.95,0:06:58.04,Default,,0,0,0,,Қазіргі уақытта тақ санды қабаттарда электр қуаты үзілуде.
Dialogue: 0,0:06:58.04,0:06:59.37,Default,,0,0,0,,Қазіргі уақытта тақ санды қабаттарда электр қуаты үзілуде.
Dialogue: 0,0:06:58.04,0:06:59.37,Default,,0,0,0,,Бұл не жарық...
Dialogue: 0,0:06:59.37,0:06:59.46,Default,,0,0,0,,Қазіргі уақытта тақ санды қабаттарда электр қуаты үзілуде.
Dialogue: 0,0:06:59.46,0:07:00.67,Default,,0,0,0,,Қазіргі уақытта тақ санды қабаттарда электр қуаты үзілуде.
Dialogue: 0,0:06:59.46,0:07:00.67,Default,,0,0,0,,- Жаман Хайбара - (Хайбара) Иә?
Dialogue: 0,0:07:00.67,0:07:00.75,Default,,0,0,0,,Қазіргі уақытта тақ санды қабаттарда электр қуаты үзілуде.
Dialogue: 0,0:07:00.75,0:07:01.29,Default,,0,0,0,,Қазіргі уақытта тақ санды қабаттарда электр қуаты үзілуде.
Dialogue: 0,0:07:00.75,0:07:01.29,Default,,0,0,0,,Маған стақан әкеле аласыз ба?
Dialogue: 0,0:07:01.29,0:07:01.37,Default,,0,0,0,,Маған стақан әкеле аласыз ба?
Dialogue: 0,0:07:01.37,0:07:01.83,Default,,0,0,0,,Маған стақан әкеле аласыз ба?
Dialogue: 0,0:07:01.37,0:07:01.83,Default,,0,0,0,,Төтенше қуат жақын арада қосылады.
Dialogue: 0,0:07:01.83,0:07:01.92,Default,,0,0,0,,Төтенше қуат жақын арада қосылады.
Dialogue: 0,0:07:01.92,0:07:03.67,Default,,0,0,0,,Төтенше қуат жақын арада қосылады.
Dialogue: 0,0:07:01.92,0:07:03.67,Default,,0,0,0,,А... сәл күте тұрыңыз, Эдогава-кун!
Dialogue: 0,0:07:03.67,0:07:04.38,Default,,0,0,0,,А... сәл күте тұрыңыз, Эдогава-кун!
Dialogue: 0,0:07:04.38,0:07:05.04,Default,,0,0,0,,А... сәл күте тұрыңыз, Эдогава-кун!
Dialogue: 0,0:07:04.38,0:07:05.04,Default,,0,0,0,,Оған дейін сол жерде
Dialogue: 0,0:07:05.04,0:07:05.88,Default,,0,0,0,,Оған дейін сол жерде
Dialogue: 0,0:07:05.96,0:07:08.09,Default,,0,0,0,,Сабыр сақтаңыз және күтіңіз.
Dialogue: 0,0:07:05.96,0:07:08.09,Default,,0,0,0,,Дәл... Хмф
Dialogue: 0,0:07:08.09,0:07:08.17,Default,,0,0,0,,Дәл... Хмф
Dialogue: 0,0:07:08.17,0:07:08.63,Default,,0,0,0,,Мүлдем... Хмф
Dialogue: 0,0:07:08.17,0:07:08.63,Default,,0,0,0,,Қайталау…
Dialogue: 0,0:07:08.63,0:07:09.47,Default,,0,0,0,,Қайталау…
Dialogue: 0,0:07:09.55,0:07:11.76,Default,,0,0,0,,Бұл жерде жарық бар екеніне сенімдімін...
Dialogue: 0,0:07:12.51,0:07:13.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:13.85,0:07:14.68,Default,,0,0,0,,Ha
Dialogue: 0,0:07:14.76,0:07:17.10,Default,,0,0,0,,Конан-кун, жақсысың ба?
Dialogue: 0,0:07:17.18,0:07:19.52,Default,,0,0,0,,Жүгіріп келді... Әпке
Dialogue: 0,0:07:19.60,0:07:21.81,Default,,0,0,0,,А... иә
Dialogue: 0,0:07:21.89,0:07:23.40,Default,,0,0,0,,Ыстық болды.
Dialogue: 0,0:07:23.48,0:07:24.44,Default,,0,0,0,,Shibahama View қонақүйінен
Dialogue: 0,0:07:24.52,0:07:25.65,Default,,0,0,0,,Біз сізге хабарлаймыз
Dialogue: 0,0:07:26.44,0:07:28.61,Default,,0,0,0,,Енді мен балаларды іздеуім керек.
Dialogue: 0,0:07:28.69,0:07:30.53,Default,,0,0,0,,Әке? Әке!
Dialogue: 0,0:07:30.61,0:07:32.61,Default,,0,0,0,,Бар болса, жауап беріңіз!
Dialogue: 0,0:07:32.70,0:07:34.20,Default,,0,0,0,,Соноко! не болды?
Dialogue: 0,0:07:34.28,0:07:37.41,Default,,0,0,0,,Әй, Ран! Негізі әкем кетті.
Dialogue: 0,0:07:37.49,0:07:39.20,Default,,0,0,0,,Мен телефон арқылы да қол жеткізе алмаймын.
Dialogue: 0,0:07:39.29,0:07:41.37,Default,,0,0,0,,Біраз бұрын бірге болдық.
Dialogue: 0,0:07:41.46,0:07:43.12,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:07:43.21,0:07:45.59,Default,,0,0,0,,Апаттық шам жанғанда, ол жоқ болып шықты...
Dialogue: 0,0:07:46.21,0:07:48.13,Default,,0,0,0,,Шынымен, қызық, қайда бардың?
Dialogue: 0,0:07:48.21,0:07:49.76,Default,,0,0,0,,Ах! Бұл Джон
Dialogue: 0,0:07:49.84,0:07:51.30,Default,,0,0,0,,- (Соноко) Джон! -иә?
Dialogue: 0,0:07:49.84,0:07:51.30,Default,,0,0,0,,Бұл бөлім үшін рахмет.
Dialogue: 0,0:07:51.38,0:07:53.01,Default,,0,0,0,,Сөйлесіп жатқанда кешіріңіз.
Dialogue: 0,0:07:53.09,0:07:53.63,Default,,0,0,0,,Маған біраз уақыт бере аласыз ба?
Dialogue: 0,0:07:53.63,0:07:55.26,Default,,0,0,0,,Маған біраз уақыт бере аласыз ба? Қайтадан кешіріңіз.
Dialogue: 0,0:07:55.26,0:07:55.85,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:07:55.93,0:07:58.39,Default,,0,0,0,,О, Соноко-сан, не болды?
Dialogue: 0,0:07:58.47,0:08:01.93,Default,,0,0,0,,Мм... бұл менің қасымда болған әкем.
Dialogue: 0,0:08:02.02,0:08:03.39,Default,,0,0,0,,Сіз қайда кеткеніңізді білмейсіз бе?
Dialogue: 0,0:08:04.44,0:08:07.15,Default,,0,0,0,,Ой... ой...
Dialogue: 0,0:08:07.23,0:08:09.15,Default,,0,0,0,,А... бұл Джон?
Dialogue: 0,0:08:09.23,0:08:10.07,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:10.65,0:08:11.74,Default,,0,0,0,,О, Джон! (Джонның ағылшыншасы)
Dialogue: 0,0:08:11.82,0:08:13.74,Default,,0,0,0,,- (Әйел) Не? -(Ер) Уау.
Dialogue: 0,0:08:11.82,0:08:13.74,Default,,0,0,0,,Тұтынушылар, жүгірмеңіздер!
Dialogue: 0,0:08:13.82,0:08:15.49,Default,,0,0,0,,-Уф! -(Еркек) Бұл қауіпті.
Dialogue: 0,0:08:16.32,0:08:18.53,Default,,0,0,0,,Жүгіру Мен біртүрлі айттым ба?
Dialogue: 0,0:08:18.53,0:08:19.74,Default,,0,0,0,,Жүгір Мен біртүрлі айттым ба?
Dialogue: 0,0:08:18.53,0:08:19.74,Default,,0,0,0,,- (Хайбара) Эдогава-кун - А?
Dialogue: 0,0:08:20.37,0:08:23.16,Default,,0,0,0,,Электр қуатының үзілуі шамамен 30 секундқа созылды, солай ма?
Dialogue: 0,0:08:23.25,0:08:24.08,Default,,0,0,0,,О
Dialogue: 0,0:08:24.17,0:08:28.25,Default,,0,0,0,,Осынау кең алаңнан қысқа мерзімде жоғалып кету...
Dialogue: 0,0:08:28.34,0:08:30.63,Default,,0,0,0,,Сонымен, біздің кезегіміз.
Dialogue: 0,0:08:30.71,0:08:32.63,Default,,0,0,0,,- (Мицухико) Біраз уақыт өтті. - (Аюми) Дұрыс.
Dialogue: 0,0:08:33.55,0:08:34.84,Default,,0,0,0,,Біз
Dialogue: 0,0:08:35.68,0:08:37.14,Default,,0,0,0,,Біз
Dialogue: 0,0:08:37.22,0:08:38.51,Default,,0,0,0,,Уф! Аах!
Dialogue: 0,0:08:38.60,0:08:39.81,Default,,0,0,0,,Хун
Dialogue: 0,0:08:39.89,0:08:43.48,Default,,0,0,0,,Бұл детективтер тобы!
Dialogue: 0,0:08:46.77,0:08:48.19,Default,,0,0,0,,- Ха... - (Жүгіріп) А...
Dialogue: 0,0:08:48.81,0:08:52.19,Default,,0,0,0,,Соноко апа, сізді қонақүй қызметкерлері іздесін.
Dialogue: 0,0:08:53.74,0:08:55.20,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:08:55.28,0:08:56.99,Default,,0,0,0,,Инспектор Мегур!
Dialogue: 0,0:08:57.07,0:08:58.07,Default,,0,0,0,,Жағдай қалай?
Dialogue: 0,0:08:58.16,0:09:00.70,Default,,0,0,0,,Төраға Сузуки әлі табылған жоқ.
Dialogue: 0,0:09:00.79,0:09:01.83,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:01.91,0:09:04.46,Default,,0,0,0,,Ғимарат ішінен қоңыраулар жауапсыз қалады.
Dialogue: 0,0:09:05.33,0:09:06.29,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:06.37,0:09:09.96,Default,,0,0,0,,Бұл төлем үшін адам ұрлау ісі болуы мүмкін.
Dialogue: 0,0:09:10.04,0:09:13.38,Default,,0,0,0,,Сонымен қатар Конан мен оның достары кешке келді.
Dialogue: 0,0:09:13.46,0:09:14.80,Default,,0,0,0,,Электр қуаты үзілгеннен кейін бірден
Dialogue: 0,0:09:14.88,0:09:17.72,Default,,0,0,0,,Ол ұшқынға ұқсайтын бозғылт жарықты көргенін айтады.
Dialogue: 0,0:09:17.80,0:09:19.97,Default,,0,0,0,,Тыңдап көрейік
Dialogue: 0,0:09:20.60,0:09:20.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:20.93,0:09:21.81,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:20.93,0:09:21.81,Default,,0,0,0,,Менің ойымша, бұл солай шығар.
Dialogue: 0,0:09:21.81,0:09:21.89,Default,,0,0,0,,Менің ойымша, бұл солай шығар.
Dialogue: 0,0:09:21.89,0:09:22.72,Default,,0,0,0,,Менің ойымша, бұл солай шығар.
Dialogue: 0,0:09:21.89,0:09:22.72,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:09:22.81,0:09:24.89,Default,,0,0,0,,Қараңыз, телесериалда немесе бірдеңеде.
Dialogue: 0,0:09:24.98,0:09:28.15,Default,,0,0,0,,Жаман адамның есінен танып, есінен танып қалуы.
Dialogue: 0,0:09:28.23,0:09:29.98,Default,,0,0,0,,- (Такаги/Сато) Таңқаларлық мылтық! - (Мегур) Олай емес.
Dialogue: 0,0:09:30.06,0:09:32.90,Default,,0,0,0,,Сонымен, төраға Сузуки де дыбыс шығаратын мылтықпен ұрланған?
Dialogue: 0,0:09:32.98,0:09:34.94,Default,,0,0,0,,«Төраға Сузуки де»?
Dialogue: 0,0:09:35.03,0:09:38.11,Default,,0,0,0,,Бірақ ес-түссіз жатқан адамды бұл жерден қалай алып шығуға болады?
Dialogue: 0,0:09:38.20,0:09:39.91,Default,,0,0,0,,30 секунд мүмкін емес.
Dialogue: 0,0:09:39.99,0:09:43.04,Default,,0,0,0,,Сіз қауіпсіздік камераларын тексердіңіз бе?
Dialogue: 0,0:09:43.12,0:09:45.91,Default,,0,0,0,,Иә, төтенше қуат қосылғаннан кейін.
Dialogue: 0,0:09:46.00,0:09:48.17,Default,,0,0,0,,Ешкім күдікті әрекет етпеді.
Dialogue: 0,0:09:49.13,0:09:50.13,Default,,0,0,0,,Әрине
Dialogue: 0,0:09:50.21,0:09:53.80,Default,,0,0,0,,Есі жоқ адамды көпшілік алдына қалай шығардыңыз?
Dialogue: 0,0:09:53.88,0:09:55.72,Default,,0,0,0,,Ал оның мақсаты қандай...
Dialogue: 0,0:09:55.80,0:09:57.05,Default,,0,0,0,,Күтілгендей!
Dialogue: 0,0:09:57.13,0:09:58.22,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:09:58.30,0:09:59.84,Default,,0,0,0,,Сіз бірдеңе таптыңыз ба? (иіскеу дыбысы)
Dialogue: 0,0:10:00.55,0:10:01.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:01.68,0:10:03.85,Default,,0,0,0,,Осы жерден жыланбалықтың иісі шығады.
Dialogue: 0,0:10:03.93,0:10:07.52,Default,,0,0,0,,Ол балалар сіздің артыңыздан бөлмеден шықты ма?
Dialogue: 0,0:10:07.60,0:10:09.23,Default,,0,0,0,,Дереу оралыңыз.
Dialogue: 0,0:10:09.98,0:10:12.98,Default,,0,0,0,,Жыланбалықтың иісі қалады...
Dialogue: 0,0:10:13.07,0:10:15.57,Default,,0,0,0,,Бірақ неге жыланбалық жоқ!
Dialogue: 0,0:10:15.65,0:10:16.99,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:17.07,0:10:19.07,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:10:23.03,0:10:23.87,Default,,0,0,0,,Сәлем, мұнда
Dialogue: 0,0:10:23.95,0:10:25.70,Default,,0,0,0,,Дәл бір вагон бос.
Dialogue: 0,0:10:25.79,0:10:28.46,Default,,0,0,0,,Мұнда да тамақ бар емес пе?
Dialogue: 0,0:10:28.54,0:10:30.71,Default,,0,0,0,,Ал...
Dialogue: 0,0:10:30.79,0:10:32.88,Default,,0,0,0,,Грильде пісірілген жыланбалық болды және
Dialogue: 0,0:10:32.96,0:10:34.59,Default,,0,0,0,,Тұздықпен буға пісірілген күріш болуы керек.
Dialogue: 0,0:10:34.59,0:10:35.50,Default,,0,0,0,,Тұздықпен буға пісірілген күріш болуы керек.
Dialogue: 0,0:10:34.59,0:10:35.50,Default,,0,0,0,,Не, өте дәмді көрінеді?
Dialogue: 0,0:10:35.50,0:10:37.97,Default,,0,0,0,,Бұл өте дәмді көрінеді ме?
Dialogue: 0,0:10:38.47,0:10:39.51,Default,,0,0,0,,Бірақ бұл біртүрлі.
Dialogue: 0,0:10:40.18,0:10:43.76,Default,,0,0,0,,Мен жаңа ғана тамақты алып шықтым, сонда неге жоқ?
Dialogue: 0,0:10:43.85,0:10:45.31,Default,,0,0,0,,Өйткені бұл өте дәмді және танымал
Dialogue: 0,0:10:45.39,0:10:48.10,Default,,0,0,0,,Ол бірден жоғалып кетті ме?
Dialogue: 0,0:10:48.18,0:10:49.39,Default,,0,0,0,,Жоқ, қара
Dialogue: 0,0:10:50.27,0:10:52.61,Default,,0,0,0,,Мұнда адамдар міне алады.
Dialogue: 0,0:10:52.69,0:10:56.11,Default,,0,0,0,,Төраға Сузукиді осылай көтердіңіз бе?
Dialogue: 0,0:10:56.19,0:10:59.95,Default,,0,0,0,,Мұны байқамай орындауға болатыны рас.
Dialogue: 0,0:11:00.03,0:11:02.91,Default,,0,0,0,,Олай болса, кінәлі қонақүй адамы ма?
Dialogue: 0,0:11:02.99,0:11:05.74,Default,,0,0,0,,Оның осылай киіну мүмкіндігі жоғары емес пе?
Dialogue: 0,0:11:05.83,0:11:06.79,Default,,0,0,0,,Иә
Dialogue: 0,0:11:06.87,0:11:09.66,Default,,0,0,0,,Мұнда вагонды итеріп кеткен қонақүй адамы болды ма?
Dialogue: 0,0:11:09.75,0:11:11.04,Default,,0,0,0,,Куәгерлерді табыңыз
Dialogue: 0,0:11:11.12,0:11:13.38,Default,,0,0,0,,Қонақ үйдегі қауіпсіздік камераларын екі рет тексеріңіз.
Dialogue: 0,0:11:13.46,0:11:15.04,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:15.13,0:11:17.51,Default,,0,0,0,,Балалар, бірден бөлмелеріңе қайтыңдар.
Dialogue: 0,0:11:17.59,0:11:20.01,Default,,0,0,0,,Иә
Dialogue: 0,0:11:20.09,0:11:21.05,Default,,0,0,0,,Хи хи хи...
Dialogue: 0,0:11:21.72,0:11:24.89,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:11:24.97,0:11:25.81,Default,,0,0,0,,«бір жылдық төтенше көмек заттарын қамтамасыз етеді»
Dialogue: 0,0:11:25.89,0:11:28.77,Default,,0,0,0,,Жыланбалықтың иісі осы жерден шығады.
Dialogue: 0,0:11:28.85,0:11:31.27,Default,,0,0,0,,Гента-кун ғажап, полицияның итіне ұқсайды
Dialogue: 0,0:11:31.35,0:11:33.44,Default,,0,0,0,,Менде мұндай талант бар екеніне сене алмадым!
Dialogue: 0,0:11:33.52,0:11:36.57,Default,,0,0,0,,Хехехе, сендер білмедіңдер ме?
Dialogue: 0,0:11:36.65,0:11:38.23,Default,,0,0,0,,Мен білетін сияқтымын...
Dialogue: 0,0:11:38.32,0:11:39.32,Default,,0,0,0,,Міне таяп қалды
Dialogue: 0,0:11:39.40,0:11:41.86,Default,,0,0,0,,Иісі барған сайын күшейе түседі.
Dialogue: 0,0:11:47.62,0:11:49.58,Default,,0,0,0,,Онда ешкім жоқ.
Dialogue: 0,0:11:49.66,0:11:51.91,Default,,0,0,0,,Қызметкерден сұрақ қойылады, солай ма?
Dialogue: 0,0:11:52.00,0:11:54.29,Default,,0,0,0,,Сен қалай ойлайсың, Гента-кун?
Dialogue: 0,0:11:54.38,0:11:57.84,Default,,0,0,0,,Хмм, бұл бөлмеде екеніне сенімдімін.
Dialogue: 0,0:11:57.92,0:11:59.09,Default,,0,0,0,,- (Хайбара) Мен таптым - (Гента және басқалар) Иә?
Dialogue: 0,0:11:59.17,0:12:01.47,Default,,0,0,0,,Бұл рас па, Хайбара мырза?
Dialogue: 0,0:12:01.55,0:12:02.97,Default,,0,0,0,,Артқы жағындағы вагон
Dialogue: 0,0:12:03.59,0:12:06.35,Default,,0,0,0,,Кеш өтетін жердегімен бірдей ме деп ойлаймын.
Dialogue: 0,0:12:06.43,0:12:09.18,Default,,0,0,0,,- (Мицухико) О! -(Гента) А~ мен таптым!
Dialogue: 0,0:12:09.27,0:12:10.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:10.18,0:12:11.56,Default,,0,0,0,,Я...
Dialogue: 0,0:12:14.73,0:12:15.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:15.81,0:12:19.19,Default,,0,0,0,,Неліктен мұндай жерде ерлердің формасы бар...
Dialogue: 0,0:12:19.28,0:12:20.48,Default,,0,0,0,,Эдогава-кун
Dialogue: 0,0:12:20.57,0:12:23.11,Default,,0,0,0,,Төраға Сузуки вагонда жоқ.
Dialogue: 0,0:12:23.20,0:12:24.28,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:12:24.36,0:12:25.45,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:12:25.53,0:12:27.16,Default,,0,0,0,,Уау! Дәмді көрінеді!
Dialogue: 0,0:12:27.24,0:12:29.74,Default,,0,0,0,,Бұл дәлел, сондықтан оны жеме.
Dialogue: 0,0:12:29.83,0:12:30.91,Default,,0,0,0,,Не!
Dialogue: 0,0:12:31.00,0:12:32.46,Default,,0,0,0,,Кабаяки соусы?
Dialogue: 0,0:12:35.25,0:12:36.42,Default,,0,0,0,,Ха…
Dialogue: 0,0:12:39.75,0:12:41.09,Default,,0,0,0,,Табылды
Dialogue: 0,0:12:44.84,0:12:46.80,Default,,0,0,0,,Сонымен, кінәлі қандай көрінеді?
Dialogue: 0,0:12:46.89,0:12:49.18,Default,,0,0,0,,Әй... Мен көрген жоқпын.
Dialogue: 0,0:12:49.26,0:12:53.98,Default,,0,0,0,,Электр қуаты өшіп қалды... мен оянсам, мына балалар...
Dialogue: 0,0:12:54.06,0:12:56.60,Default,,0,0,0,,Мұның бәрі детектив жігіттердің арқасында.
Dialogue: 0,0:12:56.69,0:12:58.06,Default,,0,0,0,,- (Мицухико) - (Аюми) Иә, иә.
Dialogue: 0,0:12:58.15,0:13:01.07,Default,,0,0,0,,Инспектор: Президент Мицзука сияқты мәлімдеме.
Dialogue: 0,0:13:01.15,0:13:02.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:02.82,0:13:06.95,Default,,0,0,0,,Басқаша айтқанда, президент Мицзука да дәл осындай жағдайға тап болды...
Dialogue: 0,0:13:07.03,0:13:09.95,Default,,0,0,0,,Сонымен, бұл оқиға болды ма?
Dialogue: 0,0:13:10.03,0:13:12.83,Default,,0,0,0,,Әй әке, сен не айтып тұрсың?
Dialogue: 0,0:13:12.91,0:13:15.92,Default,,0,0,0,,Өткен аптада кездескен досым кенет жоғалып кетті.
Dialogue: 0,0:13:16.00,0:13:17.00,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:13:17.08,0:13:20.59,Default,,0,0,0,,Әкем соңғы кездері менімен гольф алаңында жиі ойнайтын болды.
Dialogue: 0,0:13:20.67,0:13:21.96,Default,,0,0,0,,Әйел президент, солай ма?
Dialogue: 0,0:13:22.05,0:13:23.71,Default,,0,0,0,,Солай ма? әке
Dialogue: 0,0:13:23.80,0:13:26.22,Default,,0,0,0,,А, жоқ... бұл екеуміз ғана емес.
Dialogue: 0,0:13:26.88,0:13:28.84,Default,,0,0,0,,Бірақ полиция келген бойда
Dialogue: 0,0:13:28.93,0:13:31.22,Default,,0,0,0,,Ол гольф алаңындағы дәретханадан табылды, солай ма?
Dialogue: 0,0:13:31.31,0:13:32.60,Default,,0,0,0,,Иә
Dialogue: 0,0:13:32.68,0:13:37.60,Default,,0,0,0,,Бірақ ол сол кез туралы бізге ештеңе айтқан жоқ.
Dialogue: 0,0:13:37.69,0:13:39.73,Default,,0,0,0,,Бүгін кешке де келмедің.
Dialogue: 0,0:13:39.81,0:13:41.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:41.15,0:13:43.94,Default,,0,0,0,,Сосын Мицузука есімді әйел президент бар.
Dialogue: 0,0:13:44.03,0:13:46.36,Default,,0,0,0,,WSG Tokyo демеушісі ме?
Dialogue: 0,0:13:46.45,0:13:48.11,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:13:55.37,0:13:57.00,Default,,0,0,0,,Эйко Мицука
Dialogue: 0,0:13:57.08,0:13:59.33,Default,,0,0,0,,Ол Mitsuka Seika компаниясының президенті.
Dialogue: 0,0:13:59.42,0:14:01.38,Default,,0,0,0,,Эй, мен бұл белгіні білемін.
Dialogue: 0,0:14:01.46,0:14:05.38,Default,,0,0,0,,Kamen Yaiba шоколадында осындай белгі бар.
Dialogue: 0,0:14:05.46,0:14:06.34,Default,,0,0,0,,Мүмкін, мен кенеттен үйленуге ұсыныс жасағандықтан шығар—
Dialogue: 0,0:14:06.42,0:14:08.01,Default,,0,0,0,,Мені көбірек алаңдататын нәрсе...
Dialogue: 0,0:14:08.09,0:14:10.89,Default,,0,0,0,,Қараңдаршы! Тіпті Камен Яйба шоуы
Dialogue: 0,0:14:10.97,0:14:11.93,Default,,0,0,0,,Уау
Dialogue: 0,0:14:12.01,0:14:13.56,Default,,0,0,0,,Бірінші күні желілік пойыз жүрді
Dialogue: 0,0:14:13.64,0:14:15.64,Default,,0,0,0,,Шибахама станциясында өтетін сияқты.
Dialogue: 0,0:14:15.72,0:14:17.77,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:17.85,0:14:18.69,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:14:18.77,0:14:19.90,Default,,0,0,0,,Өкінішке орай
Dialogue: 0,0:14:19.98,0:14:22.73,Default,,0,0,0,,Көруге арналған қолданба әлдеқашан біткен сияқты.
Dialogue: 0,0:14:22.82,0:14:23.69,Default,,0,0,0,,Е...
Dialogue: 0,0:14:23.77,0:14:25.40,Default,,0,0,0,,- (Гента) Бұл не? - (Мицухико) Мен таң қалдым~
Dialogue: 0,0:14:25.48,0:14:28.70,Default,,0,0,0,,Сізді одан да көбірек алаңдататын нәрсе...
Dialogue: 0,0:14:30.61,0:14:31.45,Default,,0,0,0,,Міне.
Dialogue: 0,0:14:31.53,0:14:32.78,Default,,0,0,0,,О
Dialogue: 0,0:14:32.87,0:14:37.45,Default,,0,0,0,,Бұл компания да, Төраға Сузуки компаниясы да WSG Tokyo демеушілері болып табылады.
Dialogue: 0,0:14:38.12,0:14:41.46,Default,,0,0,0,,Компанияның екі топ-менеджері бірінен соң бірін ұрлап әкетті.
Dialogue: 0,0:14:41.54,0:14:43.42,Default,,0,0,0,,Бұл кездейсоқтық па?
Dialogue: 0,0:14:44.96,0:14:49.88,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:14:49.97,0:14:50.88,Default,,0,0,0,,Иә
Dialogue: 0,0:14:50.97,0:14:51.93,Default,,0,0,0,,Екі күн бұрын банк тонаған жігіт енді автобусты ұрлап кетті.
Dialogue: 0,0:14:52.01,0:14:57.22,Default,,0,0,0,,Бұл кенеттен болды, бірақ сіз 15 жыл бұрын WSG сериялық ұрлау оқиғасы туралы білесіз бе?
Dialogue: 0,0:14:57.31,0:14:58.77,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:14:58.85,0:15:00.48,Default,,0,0,0,,Сол жиіркенішті оқиға
Dialogue: 0,0:15:00.56,0:15:03.15,Default,,0,0,0,,Бұл жолы Токиода болған болуы мүмкін
Dialogue: 0,0:15:07.19,0:15:08.61,Default,,0,0,0,,Иә
Dialogue: 0,0:15:09.24,0:15:10.99,Default,,0,0,0,,Солай көрінеді.
Dialogue: 0,0:15:11.57,0:15:16.58,Default,,0,0,0,,♪～
Dialogue: 0,0:15:30.67,0:15:33.97,Default,,0,0,0,,Мен орта мектептің детективімін, Шиничи Кудо
Dialogue: 0,0:15:34.05,0:15:36.18,Default,,0,0,0,,Бала күнгі досы және сыныптасы Ран Моримен
Dialogue: 0,0:15:36.26,0:15:37.97,Default,,0,0,0,,Ойын-сауық саябағына барыңыз
Dialogue: 0,0:15:38.06,0:15:39.48,Default,,0,0,0,,Қара киінген адам
Dialogue: 0,0:15:39.56,0:15:42.31,Default,,0,0,0,,Мен күдікті транзакцияның куәсі болдым.
Dialogue: 0,0:15:44.27,0:15:46.36,Default,,0,0,0,,Мен мәмілені қарауға берілгенмін.
Dialogue: 0,0:15:46.44,0:15:48.44,Default,,0,0,0,,Артынан келе жатқан басқа серікке.
Dialogue: 0,0:15:48.53,0:15:49.82,Default,,0,0,0,,Байқамадым
Dialogue: 0,0:15:51.99,0:15:54.74,Default,,0,0,0,,Ол кісі маған у ішті.
Dialogue: 0,0:15:54.82,0:15:56.24,Default,,0,0,0,,Мен оянғанда...
Dialogue: 0,0:16:00.33,0:16:02.62,Default,,0,0,0,,Менің денем кішірейіп кетті.
Dialogue: 0,0:16:04.46,0:16:07.25,Default,,0,0,0,,Егер олар Шиничи Кудоның тірі екенін білсе ше?
Dialogue: 0,0:16:07.34,0:16:08.75,Default,,0,0,0,,Менің өмірімдегі тағы бір әрекет
Dialogue: 0,0:16:08.84,0:16:11.22,Default,,0,0,0,,Айналаңыздағы адамдарға да қауіп төніп тұр.
Dialogue: 0,0:16:12.97,0:16:14.13,Default,,0,0,0,,Доктор Агасаның кеңесі бойынша
Dialogue: 0,0:16:14.22,0:16:16.14,Default,,0,0,0,,Мен өзімнің шынайы тұлғамды жасыруды шештім.
Dialogue: 0,0:16:16.22,0:16:18.47,Default,,0,0,0,,Ран менің атымды сұрағанда, мен бірден айттым
Dialogue: 0,0:16:18.56,0:16:20.52,Default,,0,0,0,,Конан Эдогава деп аталады
Dialogue: 0,0:16:20.60,0:16:22.31,Default,,0,0,0,,Олар туралы мәлімет алу
Dialogue: 0,0:16:22.39,0:16:25.81,Default,,0,0,0,,Ранның үйіне көшіп келді, оның әкесі детектив болып жұмыс істейді.
Dialogue: 0,0:16:27.77,0:16:29.57,Default,,0,0,0,,Сіз менің жақсы әріптесімсіз.
Dialogue: 0,0:16:29.65,0:16:31.82,Default,,0,0,0,,Сондай-ақ қара киінген ұйымды қуу -
Dialogue: 0,0:16:31.90,0:16:34.11,Default,,0,0,0,,Федералдық тергеу бюросы ФБР
Dialogue: 0,0:16:34.20,0:16:35.45,Default,,0,0,0,,Джеймс Блэк
Dialogue: 0,0:16:35.53,0:16:36.70,Default,,0,0,0,,Андре Камел
Dialogue: 0,0:16:36.78,0:16:38.28,Default,,0,0,0,,Джоди Стерлинг
Dialogue: 0,0:16:38.37,0:16:41.08,Default,,0,0,0,,Және Шуйчи Акай
Dialogue: 0,0:16:41.16,0:16:43.87,Default,,0,0,0,,Ол ФБР-нің ең жақсы мергені.
Dialogue: 0,0:16:43.96,0:16:47.50,Default,,0,0,0,,Қазіргі уақытта Субару Окия есімді аспирант ретінде жасырынған.
Dialogue: 0,0:16:47.58,0:16:51.17,Default,,0,0,0,,Кудо резиденциясы, басқаша айтқанда, менің үйімде жасырыну.
Dialogue: 0,0:16:51.76,0:16:54.55,Default,,0,0,0,,Оның қарындасы Масуми Сера
Dialogue: 0,0:16:54.63,0:16:56.51,Default,,0,0,0,,Мен Ранның сыныбына ауыстым.
Dialogue: 0,0:16:56.59,0:16:58.18,Default,,0,0,0,,Орта мектептегі детектив қыз
Dialogue: 0,0:16:58.26,0:17:00.68,Default,,0,0,0,,Ол жұмбақ қызбен қонақүйде тұрады.
Dialogue: 0,0:17:00.76,0:17:02.56,Default,,0,0,0,,Қыз солай шығар
Dialogue: 0,0:17:02.64,0:17:06.44,Default,,0,0,0,,Ол Ақайдың анасы Мәрияммен бірдей адам.
Dialogue: 0,0:17:06.52,0:17:08.81,Default,,0,0,0,,Егер ол мен сияқты дәрі ішсе
Dialogue: 0,0:17:08.90,0:17:11.36,Default,,0,0,0,,Денеңіз кішірейіп кетсе ше...
Dialogue: 0,0:17:13.82,0:17:14.70,Default,,0,0,0,,Мұндай қыз
Dialogue: 0,0:17:14.78,0:17:16.36,Default,,0,0,0,,Ол мені Мәриям ана деп атады.
Dialogue: 0,0:17:16.45,0:17:20.16,Default,,0,0,0,,Сераның басқа ағасы Хидейоши Хада
Dialogue: 0,0:17:20.24,0:17:23.37,Default,,0,0,0,,Қазіргі уақытта ол алты тәжі бар шоги патшасы.
Dialogue: 0,0:17:23.45,0:17:26.25,Default,,0,0,0,,Басқаша айтқанда, бұл төрт адам бір отбасы.
Dialogue: 0,0:17:26.33,0:17:28.25,Default,,0,0,0,,Бұл жағдайда осы отбасы
Dialogue: 0,0:17:28.33,0:17:30.38,Default,,0,0,0,,Бұл терең байланысты...
Dialogue: 0,0:17:31.63,0:17:33.67,Default,,0,0,0,,Кішірейсек те, миымыз бірдей
Dialogue: 0,0:17:34.30,0:17:36.09,Default,,0,0,0,,Лабиринті жоқ детектив
Dialogue: 0,0:17:36.76,0:17:37.01,Default,,0,0,0,,～♪
Dialogue: 0,0:17:37.01,0:17:40.47,Default,,0,0,0,,～♪ Әрқашан бір шындық бар!
Dialogue: 0,0:17:40.47,0:17:41.76,Default,,0,0,0,,～♪
Dialogue: 0,0:17:44.27,0:17:45.39,Default,,0,0,0,,Соноко апа
Dialogue: 0,0:17:45.48,0:17:48.85,Default,,0,0,0,,Мен осы Yaiba тауарларының барлығын шынымен ала аламын ба?
Dialogue: 0,0:17:48.94,0:17:51.06,Default,,0,0,0,,Яйбаның орамалы да болды.
Dialogue: 0,0:17:51.15,0:17:52.48,Default,,0,0,0,,Сонымен қатар сандар бар.
Dialogue: 0,0:17:52.57,0:17:54.65,Default,,0,0,0,,Барлығына сыйлық.
Dialogue: 0,0:17:54.74,0:17:57.24,Default,,0,0,0,,Әкемді тапқаныңыз үшін рахмет.
Dialogue: 0,0:17:57.32,0:17:58.41,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:58.49,0:18:00.03,Default,,0,0,0,,Керемет, барлығына.
Dialogue: 0,0:17:58.49,0:18:00.03,Default,,0,0,0,,(Гента мен оның достарының қуанышты дауыстары)
Dialogue: 0,0:18:00.03,0:18:00.12,Default,,0,0,0,,(Гента мен оның достарының қуанышты дауыстары)
Dialogue: 0,0:18:00.12,0:18:01.66,Default,,0,0,0,,(Гента мен оның достарының қуанышты дауыстары)
Dialogue: 0,0:18:00.12,0:18:01.66,Default,,0,0,0,,Мен олай істемеймін.
Dialogue: 0,0:18:01.66,0:18:01.74,Default,,0,0,0,,(Гента мен оның достарының қуанышты дауыстары)
Dialogue: 0,0:18:01.74,0:18:02.58,Default,,0,0,0,,(Гента мен оның достарының қуанышты дауыстары)
Dialogue: 0,0:18:01.74,0:18:02.58,Default,,0,0,0,,Мен де
Dialogue: 0,0:18:02.66,0:18:05.66,Default,,0,0,0,,Негізі тағы бір нәрсе бар.
Dialogue: 0,0:18:05.75,0:18:09.29,Default,,0,0,0,,Джаджаан! Бұл не?
Dialogue: 0,0:18:09.37,0:18:10.67,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,0:18:10.75,0:18:12.50,Default,,0,0,0,,Бұл біреудің хаты ма?
Dialogue: 0,0:18:12.59,0:18:13.80,Default,,0,0,0,,№.
Dialogue: 0,0:18:13.88,0:18:15.76,Default,,0,0,0,,Бұл не? Айтыңызшы.
Dialogue: 0,0:18:15.84,0:18:17.93,Default,,0,0,0,,Хехехе, міне осы~
Dialogue: 0,0:18:18.01,0:18:22.43,Default,,0,0,0,,Дәл қазір бүкіл елде вакуумдық суперөткізгіш Маглевке міну үшін лотерея жүріп жатыр.
Dialogue: 0,0:18:23.39,0:18:25.93,Default,,0,0,0,,Менде платина билеті бар.
Dialogue: 0,0:18:26.02,0:18:27.27,Default,,0,0,0,,- (Аюми) Керемет! - (Гента/Мицухико) О!
Dialogue: 0,0:18:27.35,0:18:28.69,Default,,0,0,0,,Жаса, Соноко-сама
Dialogue: 0,0:18:28.77,0:18:30.19,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:18:30.27,0:18:32.69,Default,,0,0,0,,Бақытты болуға әлі ерте.
Dialogue: 0,0:18:32.77,0:18:35.86,Default,,0,0,0,,Соноко-самадан күткендей, бұл билет
Dialogue: 0,0:18:35.94,0:18:38.15,Default,,0,0,0,,Мен тек 6 дана алдым.
Dialogue: 0,0:18:38.24,0:18:40.53,Default,,0,0,0,,Тек 6 дана ма?
Dialogue: 0,0:18:40.61,0:18:41.78,Default,,0,0,0,,...Бұл дегеніміз
Dialogue: 0,0:18:41.87,0:18:42.91,Default,,0,0,0,,１
Dialogue: 0,0:18:42.99,0:18:44.66,Default,,0,0,0,,- (Гента) 2 - (Аюми) 3
Dialogue: 0,0:18:44.74,0:18:48.46,Default,,0,0,0,,４ ５ ６ ７！
Dialogue: 0,0:18:48.54,0:18:49.62,Default,,0,0,0,,Жеті адам?
Dialogue: 0,0:18:49.71,0:18:52.17,Default,,0,0,0,,Жоқ, жоқ, мені қосқанда 8 адам бар.
Dialogue: 0,0:18:52.25,0:18:55.05,Default,,0,0,0,,Аа, дәрігер ересек адам, сондықтан ол бас тартуды шешті.
Dialogue: 0,0:18:55.13,0:18:57.01,Default,,0,0,0,,Мен мұны білмей тұрып
Dialogue: 0,0:18:57.09,0:18:59.55,Default,,0,0,0,,Сонымен тағы бір адам кетті.
Dialogue: 0,0:18:59.63,0:19:01.93,Default,,0,0,0,,Кім міне алмайтынын шешіңіз
Dialogue: 0,0:19:02.01,0:19:03.64,Default,,0,0,0,,Эх!
Dialogue: 0,0:19:03.72,0:19:05.39,Default,,0,0,0,,Сіз қалай шешесіз?
Dialogue: 0,0:19:05.47,0:19:07.68,Default,,0,0,0,,Әрине, бұл дәрігердің сүйікті викторинасы.
Dialogue: 0,0:19:07.77,0:19:08.60,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:19:08.68,0:19:11.40,Default,,0,0,0,,Өйткені бұл ең әділ нәрсе.
Dialogue: 0,0:19:11.48,0:19:12.44,Default,,0,0,0,,Балалар
Dialogue: 0,0:19:12.52,0:19:15.44,Default,,0,0,0,,Барлығын тегін аламын деп ойламаңыз
Dialogue: 0,0:19:15.52,0:19:16.90,Default,,0,0,0,,- (Гента) Сараң - (Соноко) Hmph
Dialogue: 0,0:19:16.98,0:19:19.44,Default,,0,0,0,,Жарайды... Менің де барғым келді.
Dialogue: 0,0:19:19.53,0:19:21.36,Default,,0,0,0,,Мұнда таңдау жоқ
Dialogue: 0,0:19:21.45,0:19:23.37,Default,,0,0,0,,Барлығына...
Dialogue: 0,0:19:23.45,0:19:25.24,Default,,0,0,0,,Жарайды, викторина!
Dialogue: 0,0:19:25.33,0:19:27.37,Default,,0,0,0,,(поезд мүйізі)
Dialogue: 0,0:19:27.45,0:19:32.17,Default,,0,0,0,,Әрбір адам әлемде бірінші рет вакуумдық асқын өткізгіш маглевке мінеді
Dialogue: 0,0:19:32.25,0:19:34.96,Default,,0,0,0,,Кейбір адамдар бортта әлдеқашан бар.
Dialogue: 0,0:19:36.25,0:19:39.92,Default,,0,0,0,,Енді мына үш адамның қайсысы бұл?
Dialogue: 0,0:19:50.81,0:19:52.94,Default,,0,0,0,,Мәселе тым оңай.
Dialogue: 0,0:19:53.02,0:19:53.85,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:19:53.94,0:19:55.61,Default,,0,0,0,,Неліктен жылдам емес?
Dialogue: 0,0:19:55.69,0:19:57.44,Default,,0,0,0,,Ал, мен сызықты пойызға мінгім келеді.
Dialogue: 0,0:19:57.52,0:19:58.36,Default,,0,0,0,,Иә...
Dialogue: 0,0:19:58.44,0:19:59.78,Default,,0,0,0,,Соноко, түсіндің бе?
Dialogue: 0,0:19:59.86,0:20:00.90,Default,,0,0,0,,Сергіту
Dialogue: 0,0:20:00.99,0:20:02.28,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:20:02.36,0:20:04.82,Default,,0,0,0,,Бұл есеп қиын.
Dialogue: 0,0:20:04.91,0:20:06.53,Default,,0,0,0,,Эй, маған кеңес беріңізші.
Dialogue: 0,0:20:06.62,0:20:08.41,Default,,0,0,0,,Ал өлтірілген басқа балалар
Dialogue: 0,0:20:08.49,0:20:10.20,Default,,0,0,0,,Сонымен, кеңес беріңіз.
Dialogue: 0,0:20:10.29,0:20:13.58,Default,,0,0,0,,Асқын өткізгіш маглев автомобильдің шанағын жүзу үшін қолданылады.
Dialogue: 0,0:20:13.67,0:20:15.42,Default,,0,0,0,,Өте күшті магнит
Dialogue: 0,0:20:15.50,0:20:18.13,Default,,0,0,0,,Оның үстінде асқын өткізгіш магнит бар.
Dialogue: 0,0:20:18.21,0:20:22.47,Default,,0,0,0,,Басқаша айтқанда, заңгерлер, дәрігерлер және миссионерлер.
Dialogue: 0,0:20:22.55,0:20:25.68,Default,,0,0,0,,Сіз заңгер, дәрігер немесе уағызшы боласыз ба?
Dialogue: 0,0:20:25.76,0:20:28.22,Default,,0,0,0,,А, мен түсіндім! дәрігер
Dialogue: 0,0:20:28.31,0:20:29.51,Default,,0,0,0,,Иә? қайсысы
Dialogue: 0,0:20:29.60,0:20:31.27,Default,,0,0,0,,- (Жүгіріп) Жауабы... - (Агаса) Иә.
Dialogue: 0,0:20:32.39,0:20:34.56,Default,,0,0,0,,- (Ағаса) Дұрыс - (Жүгіріп) Хехе, ия!
Dialogue: 0,0:20:34.65,0:20:35.73,Default,,0,0,0,,Орхидея?
Dialogue: 0,0:20:35.81,0:20:37.94,Default,,0,0,0,,Ах... Кешіріңіз, Соноко.
Dialogue: 0,0:20:38.02,0:20:40.94,Default,,0,0,0,,Жүр, тек үш билет қалды.
Dialogue: 0,0:20:41.03,0:20:42.69,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:42.78,0:20:45.24,Default,,0,0,0,,Мен жеңілмеймін, бәйбішелер.
Dialogue: 0,0:20:45.32,0:20:49.24,Default,,0,0,0,,Соноко - суперөткізгіш Маглевке мінетін адам!
Dialogue: 0,0:20:49.33,0:20:50.37,Default,,0,0,0,,Хмм!
Dialogue: 0,0:20:51.29,0:20:53.46,Default,,0,0,0,,Бірақ бұл қиын.
Dialogue: 0,0:20:53.54,0:20:57.58,Default,,0,0,0,,Миссионерлер – миссионерлер Миссионерлер – миссионерлер
Dialogue: 0,0:20:57.67,0:20:58.75,Default,,0,0,0,,Миссионерлер туралы не деуге болады?
Dialogue: 0,0:20:58.84,0:21:01.30,Default,,0,0,0,,Миссионерлер туралы не деуге болады?
Dialogue: 0,0:21:01.38,0:21:03.13,Default,,0,0,0,,Евангелист…
Dialogue: 0,0:21:03.22,0:21:05.01,Default,,0,0,0,,Асқын өткізгіштік?
Dialogue: 0,0:21:05.09,0:21:06.89,Default,,0,0,0,,- (Гента) А, түсіндім! -(Аюми) А, түсіндім!
Dialogue: 0,0:21:05.09,0:21:06.89,Default,,0,0,0,,А, мен түсіндім!
Dialogue: 0,0:21:07.51,0:21:09.26,Default,,0,0,0,,Дұрыс жауап – евангелист! Басқаша айтқанда...
Dialogue: 0,0:21:09.93,0:21:11.52,Default,,0,0,0,,№3 миссионер!
Dialogue: 0,0:21:11.60,0:21:13.31,Default,,0,0,0,,Бұл дұрыс жауап.
Dialogue: 0,0:21:13.39,0:21:15.14,Default,,0,0,0,,- (Гента және басқалар) Иә! -(Хайбара/Соноко) Иә
Dialogue: 0,0:21:15.94,0:21:17.60,Default,,0,0,0,,Сіз шынымен бақыттысыз, солай емес пе?
Dialogue: 0,0:21:17.69,0:21:18.52,Default,,0,0,0,,Иә
Dialogue: 0,0:21:18.61,0:21:21.27,Default,,0,0,0,,Маглев пойызына міну керемет.
Dialogue: 0,0:21:21.36,0:21:23.44,Default,,0,0,0,,Яйба тауарлары өте көп.
Dialogue: 0,0:21:23.44,0:21:23.74,Default,,0,0,0,,Яйба тауарлары өте көп.
Dialogue: 0,0:21:23.82,0:21:25.24,Default,,0,0,0,,Тез үйге барып, әке-шешеңе мақтан.
Dialogue: 0,0:21:25.24,0:21:26.70,Default,,0,0,0,,Тез үйге барып, әке-шешеңе мақтан.
Dialogue: 0,0:21:26.78,0:21:27.95,Default,,0,0,0,,О, тозақ!
Dialogue: 0,0:21:28.03,0:21:30.28,Default,,0,0,0,,Смартфонымды дәрігердің қабылдауында ұмытып кеткен сияқтымын.
Dialogue: 0,0:21:30.37,0:21:33.91,Default,,0,0,0,,Мен оны қайда қалдырғанымды білмеймін, сондықтан алдымен үйге қайтыңыз.
Dialogue: 0,0:21:34.00,0:21:35.75,Default,,0,0,0,,Сонда кездескенше.
Dialogue: 0,0:21:35.83,0:21:36.79,Default,,0,0,0,,- (Аюми) Тағы кездескенше - (Гента) Тағы да кездескенше
Dialogue: 0,0:21:36.79,0:21:37.87,Default,,0,0,0,,- (Аюми) Тағы да кездескенше - (Гента) Тағы да кездескенше
Dialogue: 0,0:21:36.79,0:21:37.87,Default,,0,0,0,,О
Dialogue: 0,0:21:37.96,0:21:40.17,Default,,0,0,0,,Сера-чанға да уәдеміз бар.
Dialogue: 0,0:21:40.25,0:21:41.09,Default,,0,0,0,,Иә
Dialogue: 0,0:21:41.17,0:21:42.59,Default,,0,0,0,,Алда~
Dialogue: 0,0:21:42.67,0:21:43.92,Default,,0,0,0,,Эй, сен де бүгін тапиға барасың ба?
Dialogue: 0,0:21:44.01,0:21:45.30,Default,,0,0,0,,Керемет
Dialogue: 0,0:21:46.47,0:21:47.30,Default,,0,0,0,,Бір нәрсе үшін бе?
Dialogue: 0,0:21:47.38,0:21:50.55,Default,,0,0,0,,Мен сенімен көлікке барғым келеді.
Dialogue: 0,0:21:50.64,0:21:53.56,Default,,0,0,0,,Менімен барасың ба, балам?
Dialogue: 0,0:21:54.22,0:21:55.14,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:56.02,0:21:59.69,Default,,0,0,0,,Рақмет. Кешіріңіз.
Dialogue: 0,0:21:59.77,0:22:01.57,Default,,0,0,0,,- шығару - сұрау
Dialogue: 0,0:22:01.65,0:22:03.23,Default,,0,0,0,,Рақмет. Кешіріңіз.
Dialogue: 0,0:22:03.32,0:22:05.44,Default,,0,0,0,,WSG Tokyo демеушісі
Dialogue: 0,0:22:05.53,0:22:07.86,Default,,0,0,0,,Бұл ортақ мәселе, солай емес пе?
Dialogue: 0,0:22:07.95,0:22:10.82,Default,,0,0,0,,Президент Мицука гольф ойнап жүріп жоғалып кетті.
Dialogue: 0,0:22:10.91,0:22:13.74,Default,,0,0,0,,Төраға Сузуки кеште ұрланған.
Dialogue: 0,0:22:13.83,0:22:14.70,Default,,0,0,0,,Хо
Dialogue: 0,0:22:14.79,0:22:19.33,Default,,0,0,0,,15 жыл бұрын Америкада осындай оқиға болған, солай ма?
Dialogue: 0,0:22:19.42,0:22:21.46,Default,,0,0,0,,Менің ойымша, солай.
Dialogue: 0,0:22:21.54,0:22:24.71,Default,,0,0,0,,ФБР осылай әрекет етті.
Dialogue: 0,0:22:24.80,0:22:26.42,Default,,0,0,0,,Бұл оның әдеті.
Dialogue: 0,0:22:26.51,0:22:28.22,Default,,0,0,0,,Мен оны интернеттен қарадым.
Dialogue: 0,0:22:28.30,0:22:32.47,Default,,0,0,0,,15 жыл бұрын Америкада WSG Boston өткенге дейін
Dialogue: 0,0:22:32.55,0:22:35.68,Default,,0,0,0,,Сол демеушілердің топ-менеджерлері бірінен соң бірі ұрланып жатыр.
Dialogue: 0,0:22:36.81,0:22:41.52,Default,,0,0,0,,Бірінші адам - ​​Атлантадағы жапондық кондитерлік өндірушінің басшысы.
Dialogue: 0,0:22:41.61,0:22:45.48,Default,,0,0,0,,Екінші адам Чикагодағы конгломераттың басшысы.
Dialogue: 0,0:22:45.57,0:22:49.78,Default,,0,0,0,,Үшінші адам Детройттағы автомобиль өндірушісінің басшысы.
Dialogue: 0,0:22:49.86,0:22:54.58,Default,,0,0,0,,Оқиға бірнеше штатта орын алғандықтан, тергеуді ФБР басқарды.
Dialogue: 0,0:22:54.66,0:22:58.58,Default,,0,0,0,,Алайда қылмыскерден өз бетімен қашып үлгерген үшінші жәбірленуші
Dialogue: 0,0:22:58.66,0:22:59.71,Default,,0,0,0,,Станцияда атып өлтірілді
Dialogue: 0,0:23:01.21,0:23:02.25,Default,,0,0,0,,Мен темекі шегуді тастадым
Dialogue: 0,0:23:02.33,0:23:06.13,Default,,0,0,0,,Бірінші және екінші жәбірленушілер аман-есен босатылды.
Dialogue: 0,0:23:06.21,0:23:09.51,Default,,0,0,0,,Неге екені белгісіз, олар кінәлі туралы үнсіз қалды.
Dialogue: 0,0:23:09.59,0:23:11.47,Default,,0,0,0,,Тергеумен ынтымақтастықтан бас тарту
Dialogue: 0,0:23:12.14,0:23:13.93,Default,,0,0,0,,Кінәлі жапондық па?
Dialogue: 0,0:23:14.01,0:23:14.85,Default,,0,0,0,,Хмм
Dialogue: 0,0:23:14.93,0:23:19.73,Default,,0,0,0,,Макото Ишихара есімді адам Бостонда суши аспазшысы болып жұмыс істеген.
Dialogue: 0,0:23:19.81,0:23:24.23,Default,,0,0,0,,Ол жәбірленуші қатысқан WSG Boston кешінде болды.
Dialogue: 0,0:23:24.31,0:23:29.11,Default,,0,0,0,,Үшінші жәбірленуші оққа ұшқан кезде де ол жақын жерде болған.
Dialogue: 0,0:23:29.19,0:23:32.36,Default,,0,0,0,,Кейінірек кісі өлтіру қаруы ретінде табылған мылтықтан.
Dialogue: 0,0:23:32.99,0:23:35.45,Default,,0,0,0,,Оның саусақ іздері анықталды
Dialogue: 0,0:23:36.45,0:23:40.75,Default,,0,0,0,,Алайда ФБР қамауға алған Ишихара қылмыс жасағанын жоққа шығарған сияқты.
Dialogue: 0,0:23:40.83,0:23:42.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:42.21,0:23:45.38,Default,,0,0,0,,Қылмыстың себебі WSG коммерциялануына наразылық білдіру болды.
Dialogue: 0,0:23:45.46,0:23:47.00,Default,,0,0,0,,Мен бұл теракт деп естідім.
Dialogue: 0,0:23:47.09,0:23:50.13,Default,,0,0,0,,Көп ұзамай топ-менеджменті ұрланған компания.
Dialogue: 0,0:23:50.22,0:23:53.89,Default,,0,0,0,,Адамдар осылай ойлайды, өйткені олар WSG демеушілігінен бас тартты.
Dialogue: 0,0:23:54.43,0:23:58.39,Default,,0,0,0,,Демеушіліктен бас тартқан компания бүкіл Америкада сынға ұшырады.
Dialogue: 0,0:23:59.10,0:24:02.89,Default,,0,0,0,,Терроризмге көнгендерге қиын болады.
Dialogue: 0,0:24:02.98,0:24:06.61,Default,,0,0,0,,Сондай-ақ, егер сіз сол кездегі ФБР директорын іздесеңіз,
Dialogue: 0,0:24:06.69,0:24:07.90,Default,,0,0,0,,Бұл адам болды.
Dialogue: 0,0:24:07.98,0:24:10.15,Default,,0,0,0,,Субару-сан біледі, солай ма?
Dialogue: 0,0:24:11.32,0:24:13.03,Default,,0,0,0,,Алан Маккензи
Dialogue: 0,0:24:13.11,0:24:15.78,Default,,0,0,0,,Ол келесі президенттікке кандидат деп айтылады.
Dialogue: 0,0:24:16.41,0:24:17.70,Default,,0,0,0,,Иә
Dialogue: 0,0:24:17.78,0:24:22.50,Default,,0,0,0,,Ол қазір WSG қауымдастығының президенті және жақын арада Жапонияға келеді.
Dialogue: 0,0:24:22.58,0:24:23.67,Default,,0,0,0,,Саған бәрібір?
Dialogue: 0,0:24:23.75,0:24:25.21,Default,,0,0,0,,Иә, өйткені
Dialogue: 0,0:24:25.29,0:24:28.80,Default,,0,0,0,,11 жыл бұрын Америкада ұқсас нәрсе болды, солай ма?
Dialogue: 0,0:24:29.55,0:24:32.55,Default,,0,0,0,,Бұл 15 жыл бұрынғы оқиғаның көшірмесі.
Dialogue: 0,0:24:32.63,0:24:34.18,Default,,0,0,0,,Егер сіз оны қарастырсаңыз, бұл да.
Dialogue: 0,0:24:34.26,0:24:37.68,Default,,0,0,0,,Ол кезде Алан ФБР директоры болды.
Dialogue: 0,0:24:37.76,0:24:43.31,Default,,0,0,0,,Бірақ ФБР қылмыскерді ешкім өлмес бұрын қамауға алды.
Dialogue: 0,0:24:43.39,0:24:46.52,Default,,0,0,0,,Ол өзінің көшірмеші қылмыскер екенін мойындады.
Dialogue: 0,0:24:46.61,0:24:49.23,Default,,0,0,0,,Ол өзінің сыбайласына да кінәсін мойындады.
Dialogue: 0,0:24:49.32,0:24:52.57,Default,,0,0,0,,ФБР қылмыскерлерді одан әрі көшіретінін айтты
Dialogue: 0,0:24:52.65,0:24:55.82,Default,,0,0,0,,Мен Токиода қайтадан пайда болдым деп ойлаймын.
Dialogue: 0,0:24:56.53,0:25:00.91,Default,,0,0,0,,Бұл жолы да бірінші құрбан болған кәмпит өндірушінің басшысы болды.
Dialogue: 0,0:25:00.99,0:25:04.50,Default,,0,0,0,,Екінші құрбан chaebol компаниясының басшысы болды.
Dialogue: 0,0:25:04.58,0:25:06.29,Default,,0,0,0,,15 жыл бұрынғыдай
Dialogue: 0,0:25:06.37,0:25:09.50,Default,,0,0,0,,Олай болса, үшінші мақсат
Dialogue: 0,0:25:09.59,0:25:12.30,Default,,0,0,0,,Бұл оның автомобиль өндірушісінің басшысы екенін білдіре ме?
Dialogue: 0,0:25:12.92,0:25:14.84,Default,,0,0,0,,Рахмет, балам.
Dialogue: 0,0:25:25.02,0:25:25.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:26.94,0:25:28.81,Default,,0,0,0,,Сіздің әкеңіз тұтынушы ма?
Dialogue: 0,0:25:26.94,0:25:28.81,Default,,0,0,0,,Мен сені ешқашан кешірмеймін!
Dialogue: 0,0:25:28.90,0:25:31.73,Default,,0,0,0,,Иә? Қазіргі адам қайда...
Dialogue: 0,0:25:28.90,0:25:31.73,Default,,0,0,0,,Рақмет. Кешіріңіз.
Dialogue: 0,0:25:32.69,0:25:37.11,Default,,0,0,0,,Джон Бойд Жапония кодексінің президенті және бас директоры.
Dialogue: 0,0:25:37.74,0:25:41.24,Default,,0,0,0,,Жақында бұқаралық ақпарат құралдарында жарияланған атақты адам.
Dialogue: 0,0:25:41.33,0:25:42.54,Default,,0,0,0,,Я~
Dialogue: 0,0:25:42.62,0:25:44.87,Default,,0,0,0,,Әке, сіз керемет адамдарды кездестірдіңіз.
Dialogue: 0,0:25:44.96,0:25:46.29,Default,,0,0,0,,Бірақ осындай шағын кабинетте
Dialogue: 0,0:25:46.29,0:25:47.54,Default,,0,0,0,,Бірақ осындай шағын кабинетте
Dialogue: 0,0:25:46.29,0:25:47.54,Default,,0,0,0,,Жапон коды дегеніміз не?
Dialogue: 0,0:25:47.54,0:25:47.62,Default,,0,0,0,,Жапон коды дегеніміз не?
Dialogue: 0,0:25:47.62,0:25:48.17,Default,,0,0,0,,Жапон коды дегеніміз не?
Dialogue: 0,0:25:47.62,0:25:48.17,Default,,0,0,0,,Сен не үшін келдің?
Dialogue: 0,0:25:48.17,0:25:48.25,Default,,0,0,0,,Сен не үшін келдің?
Dialogue: 0,0:25:48.25,0:25:50.13,Default,,0,0,0,,Сен не үшін келдің?
Dialogue: 0,0:25:48.25,0:25:50.13,Default,,0,0,0,,Бұрын Takara Motors банкротқа ұшырау алдында тұрған.
Dialogue: 0,0:25:50.13,0:25:51.00,Default,,0,0,0,,Бұрын Takara Motors банкроттықтың алдында тұрған.
Dialogue: 0,0:25:51.09,0:25:54.97,Default,,0,0,0,,Компания британдық автокөлік өндіруші Code компаниясымен аффилиирленген...
Dialogue: 0,0:25:55.05,0:25:56.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:57.38,0:26:00.35,Default,,0,0,0,,Бұл адам келесі нысана ма?
Dialogue: 0,0:26:01.76,0:26:03.27,Default,,0,0,0,,(Мэридің жөтелі)
Dialogue: 0,0:26:03.35,0:26:04.72,Default,,0,0,0,,Хмм...
Dialogue: 0,0:26:05.89,0:26:07.02,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:26:07.10,0:26:09.35,Default,,0,0,0,,- (Мэри) Масуми келді - (Сера) Не?
Dialogue: 0,0:26:10.27,0:26:12.11,Default,,0,0,0,,Нысана мінетін сызықтық пойыз.
Dialogue: 0,0:26:12.82,0:26:14.57,Default,,0,0,0,,Күткендей, мама
Dialogue: 0,0:26:14.65,0:26:17.11,Default,,0,0,0,,Негізі мен Ранкуннан сұрадым.
Dialogue: 0,0:26:17.20,0:26:19.49,Default,,0,0,0,,Мұны Конан да мінетін сияқты.
Dialogue: 0,0:26:20.12,0:26:21.49,Default,,0,0,0,,Мына бала?
Dialogue: 0,0:26:21.57,0:26:25.04,Default,,0,0,0,,Иә? Ах, Йоши-ни.
Dialogue: 0,0:26:25.12,0:26:27.62,Default,,0,0,0,,Сәлеметсіз бе, Йоши-ни? не болды?
Dialogue: 0,0:26:27.71,0:26:32.13,Default,,0,0,0,,Мен 24 шілдеде Нагояға жұмысқа барамын.
Dialogue: 0,0:26:32.21,0:26:34.88,Default,,0,0,0,,Мен қандай жақсы кәдесый болады деп ойладым.
Dialogue: 0,0:26:34.96,0:26:37.76,Default,,0,0,0,,Е, Йоши-ни де сол күні Нагояда болады ма?
Dialogue: 0,0:26:37.84,0:26:39.43,Default,,0,0,0,,Масуми де?
Dialogue: 0,0:26:39.51,0:26:42.10,Default,,0,0,0,,Олай болса сайтта кездесейік.
Dialogue: 0,0:26:42.18,0:26:43.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:43.10,0:26:43.60,Default,,0,0,0,,Жарайды, күні келгенде хабарласамын.
Dialogue: 0,0:26:43.60,0:26:45.02,Default,,0,0,0,,Жарайды, мен сол күні келгенде хабарласамын.
Dialogue: 0,0:26:43.60,0:26:45.02,Default,,0,0,0,,А, сәл күте тұрыңыз, Йоши-ни.
Dialogue: 0,0:26:45.10,0:26:45.60,Default,,0,0,0,,Нагояда сенімен кездесуге уақытым жоқ.
Dialogue: 0,0:26:45.60,0:26:46.85,Default,,0,0,0,,Нагояда сенімен кездесуге уақытым жоқ.
Dialogue: 0,0:26:45.60,0:26:46.85,Default,,0,0,0,,Олай болса
Dialogue: 0,0:26:46.85,0:26:46.93,Default,,0,0,0,,Нагояда сенімен кездесуге уақытым жоқ.
Dialogue: 0,0:26:46.93,0:26:47.52,Default,,0,0,0,,Нагояда сенімен кездесуге уақытым жоқ.
Dialogue: 0,0:26:46.93,0:26:47.52,Default,,0,0,0,,Цубаки қыз.
Dialogue: 0,0:26:47.52,0:26:48.31,Default,,0,0,0,,Цубаки қыз.
Dialogue: 0,0:26:48.31,0:26:49.39,Default,,0,0,0,,Цубаки қыз.
Dialogue: 0,0:26:48.31,0:26:49.39,Default,,0,0,0,,О, Құдай-ай…
Dialogue: 0,0:26:49.48,0:26:51.69,Default,,0,0,0,,- (Сера) Йоши-нии... - (Мэри) Ху...
Dialogue: 0,0:26:55.32,0:26:57.03,Default,,0,0,0,,Бұл жерде көлік қоюға тыйым салынады.
Dialogue: 0,0:26:57.11,0:26:57.94,Default,,0,0,0,,Бұрыш... Ах!
Dialogue: 0,0:26:58.03,0:26:59.20,Default,,0,0,0,,Юми... Гугугу...
Dialogue: 0,0:26:59.78,0:27:02.03,Default,,0,0,0,,Тайко шеберінен күткендей
Dialogue: 0,0:27:02.12,0:27:05.08,Default,,0,0,0,,Хидэйоши сияқты, бұл жаңа әйелге алаяқтық телефон қоңырауы ма?
Dialogue: 0,0:27:05.16,0:27:06.29,Default,,0,0,0,,Таз егеуқұйрық!
Dialogue: 0,0:27:06.37,0:27:07.70,Default,,0,0,0,,Жоқ... жоқ.
Dialogue: 0,0:27:07.79,0:27:09.16,Default,,0,0,0,,Сонда сен кімсің?
Dialogue: 0,0:27:09.25,0:27:11.88,Default,,0,0,0,,Телефонның арғы жағындағы адам мені байқап қалды да, асығыс тұтқаны қойды!
Dialogue: 0,0:27:11.96,0:27:13.25,Default,,0,0,0,,Хмм...
Dialogue: 0,0:27:13.34,0:27:15.09,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:27:15.17,0:27:17.51,Default,,0,0,0,,Мен сені Юмитанмен де таныстырамын.
Dialogue: 0,0:27:17.59,0:27:19.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:21.38,0:27:23.43,Default,,0,0,0,,Кешкі ас дайын.
Dialogue: 0,0:27:23.51,0:27:24.39,Default,,0,0,0,,-Иә - (Когоро) О
