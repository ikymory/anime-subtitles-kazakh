Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:08.46,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:01:07.40,0:01:09.61,Default,,0,0,0,,Сиқырлы айнаны қолдануға бола ма?
Dialogue: 0,0:01:10.02,0:01:13.90,Default,,0,0,0,,Бұл дұрыс, бірақ мен оны дәл қазір түзете алмаймын.
Dialogue: 0,0:01:14.44,0:01:18.57,Default,,0,0,0,,Мен әдебиеттерді де оқи аламын және айналармен жұмыс істей аламын.
Dialogue: 0,0:01:18.87,0:01:20.33,Default,,0,0,0,,Сіз қайсысын орындайсыз?
Dialogue: 0,0:01:24.62,0:01:25.91,Default,,0,0,0,,Мен мұны істей алмаймын
Dialogue: 0,0:01:26.79,0:01:29.25,Default,,0,0,0,,Белмонт жауабы.
Dialogue: 0,0:01:29.88,0:01:34.51,Default,,0,0,0,,Сіз жауынгерлер руынан шыққансыз ба? Сіз жай ғана ішетін адамсыз ба?
Dialogue: 0,0:01:44.02,0:01:46.56,Default,,0,0,0,,Алукард айнаны пайдаланады...
Dialogue: 0,0:01:46.64,0:01:49.81,Default,,0,0,0,,Жаулардың санын және құбыжықтардың сыртқы түрін тексеріңіз.
Dialogue: 0,0:01:49.90,0:01:52.36,Default,,0,0,0,,Сифер заклинанияны аяқтаңыз.
Dialogue: 0,0:01:52.82,0:01:54.61,Default,,0,0,0,,Мен кіруді жауып тастаймын
Dialogue: 0,0:02:04.45,0:02:09.87,Default,,0,0,0,,Айнаға қарамай тұрып, алдыңнан құбыжық шығады.
Dialogue: 0,0:02:10.13,0:02:13.55,Default,,0,0,0,,Иә, басқа ойларыңыз бар ма?
Dialogue: 0,0:02:13.63,0:02:15.46,Default,,0,0,0,,Менің кеңесімді қалайсыз ба?
Dialogue: 0,0:02:15.55,0:02:17.42,Default,,0,0,0,,Біз доспыз, солай ма?
Dialogue: 0,0:02:17.84,0:02:19.38,Default,,0,0,0,,Оған ұнамайды.
Dialogue: 0,0:02:19.51,0:02:22.80,Default,,0,0,0,,Бірақ біз бірге күресеміз деп шештік.
Dialogue: 0,0:02:23.14,0:02:25.01,Default,,0,0,0,,Осыған көңіліңіз толмай ма?
Dialogue: 0,0:02:27.31,0:02:28.48,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:02:28.69,0:02:30.23,Default,,0,0,0,,Пікірлерді тыңдайық
Dialogue: 0,0:02:31.48,0:02:34.19,Default,,0,0,0,,Дракула сарайын табу үшін осы айнаны пайдаланыңыз
Dialogue: 0,0:02:35.82,0:02:39.20,Default,,0,0,0,,Жау келсе, мұнда қашып құтылу жоқ.
Dialogue: 0,0:02:40.28,0:02:42.37,Default,,0,0,0,,Кестелерді айналдырайық
Dialogue: 0,0:02:43.91,0:02:44.87,Default,,0,0,0,,Меніңше… біз істеп қойған сияқтымыз, иә?
Dialogue: 0,0:02:45.08,0:02:46.08,Default,,0,0,0,,Шифр
Dialogue: 0,0:02:46.58,0:02:48.12,Default,,0,0,0,,Жақында білетін боласыз
Dialogue: 0,0:02:48.20,0:02:50.25,Default,,0,0,0,,Мүмкіндігінше көп уақытты ұтыңыз
Dialogue: 0,0:02:50.37,0:02:51.46,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:04:29.18,0:04:30.47,Default,,0,0,0,,♬ Мен бара жатқан жер — әлі көрінбеген тағдыр
Dialogue: 0,0:04:54.83,0:04:56.21,Default,,0,0,0,,Брейра?
Dialogue: 0,0:04:57.75,0:05:00.96,Default,,0,0,0,,Мен бәрібір бір жылдың ішінде аштан өлемін.
Dialogue: 0,0:05:01.05,0:05:04.38,Default,,0,0,0,,Шулы адамдардың үнін өшіру.
Dialogue: 0,0:05:07.22,0:05:08.43,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:05:09.60,0:05:12.14,Default,,0,0,0,,Тыныштық болғанша қарсы емеспін.
Dialogue: 0,0:05:20.23,0:05:21.65,Default,,0,0,0,,Брайлаға өтіңіз
Dialogue: 0,0:06:22.04,0:06:23.54,Default,,0,0,0,,Бұл жерде!
Dialogue: 0,0:08:33.76,0:08:36.01,Default,,0,0,0,,Епископ, өзенді тазалаңыз
Dialogue: 0,0:08:36.39,0:08:38.43,Default,,0,0,0,,Қасиетті суға айналу
Dialogue: 0,0:11:02.70,0:11:07.20,Default,,0,0,0,,Кітап толы жертөледе от шашатын айдаһар пайда болды?
Dialogue: 0,0:11:21.01,0:11:23.97,Default,,0,0,0,,Шынжырмен ойнау қауіпті.
Dialogue: 0,0:11:45.07,0:11:48.95,Default,,0,0,0,,Жағымсыз жер асты әлеміне оралу...
Dialogue: 0,0:11:49.37,0:11:53.04,Default,,0,0,0,,Достарыңызға Белмонттың тірі және жақсы екенін айтыңыз.
Dialogue: 0,0:13:18.33,0:13:20.67,Default,,0,0,0,,Ол өте ұсқынсыз бейбақ.
Dialogue: 0,0:13:22.67,0:13:24.84,Default,,0,0,0,,Бұл қару...
Dialogue: 0,0:13:25.67,0:13:26.88,Default,,0,0,0,,Бұл таяқ.
Dialogue: 0,0:13:28.22,0:13:32.14,Default,,0,0,0,,Сіз қорқып, қашып кеткіңіз келді.
Dialogue: 0,0:14:17.60,0:14:18.44,Default,,0,0,0,,Барайық
Dialogue: 0,0:14:20.65,0:14:21.77,Default,,0,0,0,,Менімен бірге жүр
Dialogue: 0,0:14:22.27,0:14:23.15,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:14:23.61,0:14:25.65,Default,,0,0,0,,Сіз шешім қабылдаған болуыңыз керек.
Dialogue: 0,0:14:25.78,0:14:30.16,Default,,0,0,0,,Мен қожайыныма опасыздық жасадым, сарайға қайта алмаймын.
Dialogue: 0,0:14:30.91,0:14:32.78,Default,,0,0,0,,Мен... жай ғана...
Dialogue: 0,0:14:33.16,0:14:34.66,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:14:34.87,0:14:39.00,Default,,0,0,0,,Мен бала кезімдегідей мал өлексесін жинайтынмын.
Dialogue: 0,0:14:39.08,0:14:42.13,Default,,0,0,0,,Ысқақ жаралы бала.
Dialogue: 0,0:14:42.59,0:14:45.75,Default,,0,0,0,,Дракула үй жануарының өлтірілгеніне ашуланады...
Dialogue: 0,0:14:45.84,0:14:48.01,Default,,0,0,0,,Мен әлемді ұрып жатырмын
Dialogue: 0,0:14:48.17,0:14:51.34,Default,,0,0,0,,Сіз жай ғана адам баласысыз
Dialogue: 0,0:14:51.93,0:14:53.85,Default,,0,0,0,,Көпірден өту
Dialogue: 0,0:14:54.60,0:14:56.93,Default,,0,0,0,,Менің артымнан жүр
Dialogue: 0,0:14:59.10,0:15:01.52,Default,,0,0,0,,Сене алатын жалғыз адам – мен
Dialogue: 0,0:15:36.14,0:15:37.10,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:16:02.58,0:16:04.08,Default,,0,0,0,,Сіз қамалды көрдіңіз бе?
Dialogue: 0,0:16:04.75,0:16:05.96,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:16:08.34,0:16:10.34,Default,,0,0,0,,Мен мұны сұрадым.
Dialogue: 0,0:16:10.42,0:16:13.30,Default,,0,0,0,,Мен сиқырға назар аударамын
Dialogue: 0,0:16:13.38,0:16:14.59,Default,,0,0,0,,Сана?
Dialogue: 0,0:16:14.80,0:16:19.35,Default,,0,0,0,,Сиқыр - сіз ойлаған нәрсені жүзеге асыратын нәрсе.
Dialogue: 0,0:16:19.56,0:16:23.56,Default,,0,0,0,,Мен әлгі ұсқынсыз сарайды осында сүйреп шығарамын.
Dialogue: 0,0:18:17.17,0:18:18.18,Default,,0,0,0,,Лорд Дракула
Dialogue: 0,0:18:18.26,0:18:20.05,Default,,0,0,0,,Адамның қарсылығы?
Dialogue: 0,0:18:20.34,0:18:21.93,Default,,0,0,0,,Отанға опасыздық
Dialogue: 0,0:18:22.10,0:18:25.60,Default,,0,0,0,,Вампирлер әскері шабуыл жасады.
Dialogue: 0,0:18:26.18,0:18:27.60,Default,,0,0,0,,Әскери киімнің түсі қандай?
Dialogue: 0,0:18:27.89,0:18:29.65,Default,,0,0,0,,Ақ жиегі бар қара
Dialogue: 0,0:18:29.90,0:18:32.31,Default,,0,0,0,,Штирия әскері.
Dialogue: 0,0:18:32.69,0:18:34.61,Default,,0,0,0,,Бұл Кармилланың жұмысы болды ма?
Dialogue: 0,0:18:36.07,0:18:37.24,Default,,0,0,0,,Қазір қалай естіледі?
Dialogue: 0,0:18:37.49,0:18:38.32,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:18:39.15,0:18:40.82,Default,,0,0,0,,Ә? Әйтеуір, ол Мисаға қатты ғашық қой.
Dialogue: 0,0:18:41.07,0:18:42.83,Default,,0,0,0,,Адал азаматтар ше?
Dialogue: 0,0:18:43.12,0:18:45.54,Default,,0,0,0,,Қаһарлы шайқастан-
Dialogue: 0,0:18:45.62,0:18:49.29,Default,,0,0,0,,Мен он шақты адамды жинап, өзіммен бірге алып келдім.
Dialogue: 0,0:18:49.37,0:18:51.33,Default,,0,0,0,,Енді төменге түсейік.
Dialogue: 0,0:18:51.42,0:18:53.50,Default,,0,0,0,,Бұл қамалды ешкімге беруге болмайды.
Dialogue: 0,0:19:15.15,0:19:17.40,Default,,0,0,0,,Менің күшіме қарсы
Dialogue: 0,0:19:17.53,0:19:20.24,Default,,0,0,0,,Ол якорьмен бекітілген сияқты.
Dialogue: 0,0:19:20.36,0:19:22.78,Default,,0,0,0,,Мені тартып жатыр
Dialogue: 0,0:19:23.45,0:19:27.20,Default,,0,0,0,,Қамалды жылжытатын машиналар қарсылық көрсетеді.
Dialogue: 0,0:19:35.04,0:19:36.04,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:19:58.78,0:19:59.74,Default,,0,0,0,,Тоқта
Dialogue: 0,0:20:05.53,0:20:06.58,Default,,0,0,0,,Бұл сиқыр.
Dialogue: 0,0:20:15.38,0:20:18.17,Default,,0,0,0,,Менің айтқанымды істе.
Dialogue: 0,0:21:48.89,0:21:51.51,Default,,0,0,0,,Не болды?
Dialogue: 0,0:22:25.71,0:22:26.97,Default,,0,0,0,,Сәтті
Dialogue: 0,0:22:33.39,0:22:35.68,Default,,0,0,0,,Құлып қазір қайда?
Dialogue: 0,0:22:35.93,0:22:37.73,Default,,0,0,0,,Біздің үстімізде
Dialogue: 0,0:22:42.81,0:22:46.74,Default,,0,0,0,,Жертөленің үстінде тек ағаш пен топырақтан...
Dialogue: 0,0:22:46.82,0:22:49.57,Default,,0,0,0,,Бұл аздап қауіпті болды ма?
Dialogue: 0,0:22:51.57,0:22:52.57,Default,,0,0,0,,Тезірек барайық
Dialogue: 0,0:24:37.68,0:24:40.47,Default,,0,0,0,,Жапон субтитрлері Канако Миядзаки
Dialogue: 0,0:24:41.97,0:24:47.97,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory