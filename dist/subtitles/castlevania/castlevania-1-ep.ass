Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.84,0:00:13.09,Default,,0,0,0,,1455 Уоллахия
Dialogue: 0,0:01:45.56,0:01:46.64,Default,,0,0,0,,Мен Лизамын
Dialogue: 0,0:01:47.27,0:01:48.98,Default,,0,0,0,,Мен Лупу ауылынанмын.
Dialogue: 0,0:01:49.06,0:01:50.81,Default,,0,0,0,,Мен дәрігер болғым келеді
Dialogue: 0,0:01:54.32,0:01:58.78,Default,,0,0,0,,Сіз фермерлерді тауықтың қанымен емдеуді үйренуге келдіңіз бе?
Dialogue: 0,0:01:59.16,0:02:03.49,Default,,0,0,0,,Мен бақсы емеспін, бұл тозған ырым
Dialogue: 0,0:02:03.70,0:02:05.04,Default,,0,0,0,,Ғылыми медицина...
Dialogue: 0,0:02:06.50,0:02:08.04,Default,,0,0,0,,Менің үйренгім келеді
Dialogue: 0,0:02:08.71,0:02:14.88,Default,,0,0,0,,Мен сізде жасырын білім бар деп естідім.
Dialogue: 0,0:02:15.76,0:02:17.84,Default,,0,0,0,,Мен Дракула Влад Тепеспін
Dialogue: 0,0:02:18.17,0:02:20.93,Default,,0,0,0,,Қонақтарды қабылдау әдеттен тыс.
Dialogue: 0,0:02:21.55,0:02:24.35,Default,,0,0,0,,Егер мен өз білімімді берсем, оның орнына не аламын?
Dialogue: 0,0:02:24.72,0:02:26.18,Default,,0,0,0,,Лупу ауылынан келген Лиза.
Dialogue: 0,0:02:29.52,0:02:31.94,Default,,0,0,0,,Әдептілік сабағы туралы не айтасыз?
Dialogue: 0,0:02:32.86,0:02:37.65,Default,,0,0,0,,Сіз тіпті тұтынушыларға сусын ұсынбайсыз.
Dialogue: 0,0:02:37.86,0:02:39.65,Default,,0,0,0,,Сіз ішетін адам болуыңыз мүмкін.
Dialogue: 0,0:02:40.45,0:02:44.58,Default,,0,0,0,,Сіз өзіңізді күміспен немесе крестпен қорғайсыз ба?
Dialogue: 0,0:02:45.16,0:02:47.62,Default,,0,0,0,,Әлде сарымсақ па?
Dialogue: 0,0:02:48.08,0:02:53.67,Default,,0,0,0,,Мен сен келгенше тамақтандым. Бұл дөрекі болды ма?
Dialogue: 0,0:02:53.88,0:02:56.13,Default,,0,0,0,,Мен ырымдарға қызықпаймын
Dialogue: 0,0:02:56.21,0:03:00.22,Default,,0,0,0,,Бұқтырылған шөппен адамдарды алдама
Dialogue: 0,0:03:00.30,0:03:02.39,Default,,0,0,0,,Мен емделгім келеді.
Dialogue: 0,0:03:02.72,0:03:05.56,Default,,0,0,0,,Маған үйренуге көмектесе аласыз ба?
Dialogue: 0,0:03:05.89,0:03:11.48,Default,,0,0,0,,Сіз бұл күндері қарапайым адамдардан ерекшеленетін сияқтысыз.
Dialogue: 0,0:03:11.56,0:03:13.94,Default,,0,0,0,,Әлеуметтенуді үйретейін бе?
Dialogue: 0,0:03:14.23,0:03:18.90,Default,,0,0,0,,Тым болмаса шыдаймын...
Dialogue: 0,0:03:20.65,0:03:22.91,Default,,0,0,0,,Мен баяғыда берілдім.
Dialogue: 0,0:03:23.74,0:03:26.28,Default,,0,0,0,,Лупу ауылы қай жерде?
Dialogue: 0,0:03:27.08,0:03:28.45,Default,,0,0,0,,Сіз сыртқа шықпайсыз.
Dialogue: 0,0:03:28.54,0:03:32.67,Default,,0,0,0,,Егер сізде бұл сарай болса, кез келген уақытта саяхаттауға болады.
Dialogue: 0,0:03:33.58,0:03:36.75,Default,,0,0,0,,Бірақ сіз бармайсыз, солай ма?
Dialogue: 0,0:03:37.42,0:03:40.30,Default,,0,0,0,,Әлем өзгеруде
Dialogue: 0,0:03:40.59,0:03:43.09,Default,,0,0,0,,Серуендеу қызық болуы мүмкін
Dialogue: 0,0:03:44.80,0:03:50.64,Default,,0,0,0,,Менің ақымақ шаруа сияқты жер кезгенімді қалайсың ба?
Dialogue: 0,0:03:50.89,0:03:53.44,Default,,0,0,0,,Менің білімімнің орнына?
Dialogue: 0,0:03:53.98,0:03:55.65,Default,,0,0,0,,Бұл нағыз ғылым.
Dialogue: 0,0:04:07.78,0:04:08.62,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:04:09.33,0:04:12.21,Default,,0,0,0,,Әркімге білім бер
Dialogue: 0,0:04:12.54,0:04:16.38,Default,,0,0,0,,Нағыз медицина арқылы өлім қорқынышы жеңілдейді.
Dialogue: 0,0:04:16.67,0:04:19.88,Default,,0,0,0,,Дүниенің қалай жұмыс істейтінін білсең, ырымдар жойылады.
Dialogue: 0,0:04:19.96,0:04:21.55,Default,,0,0,0,,​​Не үшін?
Dialogue: 0,0:04:22.01,0:04:23.59,Default,,0,0,0,,Әлемді жақсырақ орынға айналдыр
Dialogue: 0,0:04:24.13,0:04:27.55,Default,,0,0,0,,Біз бір-бірімізден үйрене аламыз
Dialogue: 0,0:04:31.43,0:04:33.31,Default,,0,0,0,,Сізге ұнады
Dialogue: 0,0:04:46.91,0:04:50.45,Default,,0,0,0,,1475 Валахия Турговиште
Dialogue: 0,0:05:14.73,0:05:17.56,Default,,0,0,0,,Әйелдің үйінде шайтандық машина бар ма?
Dialogue: 0,0:05:18.10,0:05:20.19,Default,,0,0,0,,Мен оны өз көзіммен көрдім
Dialogue: 0,0:05:21.07,0:05:25.36,Default,,0,0,0,,Мен бұрын-соңды көрмеген пішіндегі қағаз жұқа шыны...
Dialogue: 0,0:05:25.74,0:05:29.45,Default,,0,0,0,,Найзағай, қорқытатын шөп және құралдар
Dialogue: 0,0:05:30.12,0:05:31.83,Default,,0,0,0,,Бақсылықтың дәлелі
Dialogue: 0,0:05:32.70,0:05:37.37,Default,,0,0,0,,Бұл мен аң аулаған ең жақсысы.
Dialogue: 0,0:05:37.87,0:05:39.83,Default,,0,0,0,,Өртеніп кетті ме?
Dialogue: 0,0:05:40.25,0:05:42.88,Default,,0,0,0,,Ол «ғылым» деп мәлімдегенімен
Dialogue: 0,0:05:43.05,0:05:46.55,Default,,0,0,0,,Лиза Тепес үшін тым кеш
Dialogue: 0,0:05:46.72,0:05:50.39,Default,,0,0,0,,Жын патшасының басшылығына соқыр сену
Dialogue: 0,0:05:51.14,0:05:55.35,Default,,0,0,0,,Менің де фармацевтика ғылымынан аздап білімім бар...
Dialogue: 0,0:05:57.39,0:06:02.57,Default,,0,0,0,,Әрине, біз тәжірибені емес, теорияны ғана үйренеміз.
Dialogue: 0,0:06:02.94,0:06:08.07,Default,,0,0,0,,Архиепископ өмірдің табиғи ағынын да сақтағысы келеді.
Dialogue: 0,0:06:10.87,0:06:15.24,Default,,0,0,0,,Табиғи және таза өмір жақсы.
Dialogue: 0,0:06:20.37,0:06:23.17,Default,,0,0,0,,Оларды ренжітпеңіз
Dialogue: 0,0:06:23.63,0:06:25.63,Default,,0,0,0,,Сіз кіммен сөйлесесіз?
Dialogue: 0,0:06:25.71,0:06:29.59,Default,,0,0,0,,Біз жын патшаға бізден кек алмауын өтінеміз.
Dialogue: 0,0:06:29.84,0:06:33.85,Default,,0,0,0,,Сиқыршы үшін ол жоғары қарады деп айтуға болады.
Dialogue: 0,0:06:35.01,0:06:38.73,Default,,0,0,0,,Кейінірек кішкене дұға оқуға болады.
Dialogue: 0,0:06:43.73,0:06:45.94,Default,,0,0,0,,Бұл қатыгез өтініш болуы мүмкін.
Dialogue: 0,0:06:46.48,0:06:50.70,Default,,0,0,0,,Бірақ олар не істеп жатқандарын білмейді
Dialogue: 0,0:06:51.45,0:06:55.12,Default,,0,0,0,,Кек алу үшін өзіңізді құрбан етпеңіз
Dialogue: 0,0:07:02.83,0:07:05.21,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:08:02.89,0:08:08.23,Default,,0,0,0,,Кастлевания
Dialogue: 0,0:09:20.64,0:09:22.68,Default,,0,0,0,,Тепес мырза?
Dialogue: 0,0:09:23.43,0:09:24.81,Default,,0,0,0,,Мен Лизадан сұрадым
Dialogue: 0,0:09:25.35,0:09:26.52,Default,,0,0,0,,Не болды?
Dialogue: 0,0:09:26.60,0:09:28.52,Default,,0,0,0,,Менің әйелім қайда?
Dialogue: 0,0:09:28.85,0:09:33.78,Default,,0,0,0,,Ведьма деп күдіктеніп, епископ тұтқындаған
Dialogue: 0,0:09:34.49,0:09:36.78,Default,,0,0,0,,Өртену
Dialogue: 0,0:09:37.99,0:09:39.78,Default,,0,0,0,,Мейірімді адам еді.
Dialogue: 0,0:09:40.62,0:09:42.08,Default,,0,0,0,,Жақсы дәрігер
Dialogue: 0,0:09:42.16,0:09:44.33,Default,,0,0,0,,Бұл дұрыс емес
Dialogue: 0,0:09:44.83,0:09:46.96,Default,,0,0,0,,Ол соборда ма?
Dialogue: 0,0:09:47.29,0:09:49.92,Default,,0,0,0,,Кешіріңіз, сэр.
Dialogue: 0,0:09:50.46,0:09:52.30,Default,,0,0,0,,Ол әлдеқашан өлген болуы керек еді.
Dialogue: 0,0:09:53.50,0:09:54.38,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:09:55.42,0:09:57.01,Default,,0,0,0,,Біз бірге кешкі ас ішіп, түнгі көріністі тамашалаймыз.
Dialogue: 0,0:09:57.17,0:10:02.05,Default,,0,0,0,,Мен отқа өртенгеннен ләззат ала алмаймын.
Dialogue: 0,0:10:02.47,0:10:04.97,Default,,0,0,0,,Мен оны осы жерде есіме түсірдім.
Dialogue: 0,0:10:13.32,0:10:14.57,Default,,0,0,0,,Маған әйелім айтты
Dialogue: 0,0:10:14.82,0:10:18.32,Default,,0,0,0,,«Мені сүйсең, адам сияқты өмір сүр».
Dialogue: 0,0:10:18.95,0:10:20.53,Default,,0,0,0,,«Саяхат»
Dialogue: 0,0:10:20.99,0:10:22.95,Default,,0,0,0,,Мен сені саяхаттағаныңды естідім.
Dialogue: 0,0:10:23.74,0:10:24.79,Default,,0,0,0,,Иә.
Dialogue: 0,0:10:25.58,0:10:28.08,Default,,0,0,0,,Адамдар сияқты -
Dialogue: 0,0:10:28.46,0:10:30.08,Default,,0,0,0,,Уақытыңызды алыңыз
Dialogue: 0,0:10:30.92,0:10:32.08,Default,,0,0,0,,Бітті
Dialogue: 0,0:10:34.67,0:10:38.01,Default,,0,0,0,,Әйелімді соңғы рет мейіріммен аяйық.
Dialogue: 0,0:10:38.26,0:10:42.35,Default,,0,0,0,,Ол адамдарды жақсы көрді және олардың ауруларын емдеуге тырысты.
Dialogue: 0,0:10:42.72,0:10:47.06,Default,,0,0,0,,Отбасыңызды алып, бүгін түнде Уоллахиядан кетіңіз.
Dialogue: 0,0:10:47.52,0:10:52.10,Default,,0,0,0,,Сөмкелеріңізді жинап, кетіңіз, ешқашан артыңызға қарамаңыз.
Dialogue: 0,0:10:55.44,0:10:58.53,Default,,0,0,0,,Мен енді адамдар сияқты саяхаттамаймын
Dialogue: 0,0:12:00.71,0:12:03.43,Default,,0,0,0,,Бұл керемет көрініс болды.
Dialogue: 0,0:12:03.63,0:12:04.59,Default,,0,0,0,,Тіпті сусын бар ма?
Dialogue: 0,0:12:05.09,0:12:07.68,Default,,0,0,0,,Архиепископтың қамқорлығында
Dialogue: 0,0:12:07.81,0:12:11.52,Default,,0,0,0,,Шынымды айтсам, көп уақыт қалған жоқ сияқты.
Dialogue: 0,0:12:11.85,0:12:13.73,Default,,0,0,0,,Дін қызметкерінің шын тілегі қандай?
Dialogue: 0,0:12:13.85,0:12:17.15,Default,,0,0,0,,Сізді архиепископпен бірге көкке апарады ма?
Dialogue: 0,0:12:17.61,0:12:20.40,Default,,0,0,0,,Құдайдың алдында қызмет етесің, солай ма?
Dialogue: 0,0:12:20.65,0:12:23.78,Default,,0,0,0,,Мен оны өте тартымды деп санамаймын.
Dialogue: 0,0:12:23.90,0:12:24.82,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:12:24.99,0:12:27.87,Default,,0,0,0,,Бұл дүниеде көптеген мәселелер бар.
Dialogue: 0,0:12:28.28,0:12:31.45,Default,,0,0,0,,Уоллахия Құдайдың патшалығына айналуы мүмкін
Dialogue: 0,0:12:31.58,0:12:37.46,Default,,0,0,0,,Бірақ менің зұлымдықты жоюға уақытым бар ма?
Dialogue: 0,0:12:49.72,0:12:51.14,Default,,0,0,0,,Қалай болғанда да, әдеттегідей—
Dialogue: 0,0:12:52.10,0:12:53.14,Default,,0,0,0,,Бұл жын патшасы.
Dialogue: 0,0:12:55.27,0:12:57.44,Default,,0,0,0,,Әйеліңізге не істедіңіз?
Dialogue: 0,0:12:58.02,0:13:00.65,Default,,0,0,0,,〈Әкенің, Ұлдың және Киелі Рухтың атымен...〉
Dialogue: 0,0:13:00.86,0:13:03.15,Default,,0,0,0,,Мен Дракула Влад Тепеспін
Dialogue: 0,0:13:03.28,0:13:06.82,Default,,0,0,0,,Әйеліңізді не үшін өлтіргеніңізді түсіндіріңіз.
Dialogue: 0,0:13:06.99,0:13:08.87,Default,,0,0,0,,Сенгісіз
Dialogue: 0,0:13:09.41,0:13:10.49,Default,,0,0,0,,Дракула ше?
Dialogue: 0,0:13:10.99,0:13:14.66,Default,,0,0,0,,Бұл бидғатшылардың ойдан шығарылған әңгімесі емес пе?
Dialogue: 0,0:13:14.75,0:13:17.17,Default,,0,0,0,,Бұл әйел бақсы
Dialogue: 0,0:13:17.42,0:13:20.21,Default,,0,0,0,,Лиза – ғылым адамы...
Dialogue: 0,0:13:20.50,0:13:25.47,Default,,0,0,0,,Ол адамзаттың ар-ожданы деп атауға болатын санаулылардың бірі болды.
Dialogue: 0,0:13:26.18,0:13:28.51,Default,,0,0,0,,Сіз жоқсыз
Dialogue: 0,0:13:29.22,0:13:31.89,Default,,0,0,0,,Қиялдағы болмыс-
Dialogue: 0,0:13:32.01,0:13:36.06,Default,,0,0,0,,Бұл жай ғана қара магияның көрінісі.
Dialogue: 0,0:13:36.19,0:13:37.31,Default,,0,0,0,,Бұл қиял ма?
Dialogue: 0,0:13:37.85,0:13:41.65,Default,,0,0,0,,Әйеліңді өлтіріп қана қоймай, менің бар екенімді жоққа шығардың?
Dialogue: 0,0:13:43.36,0:13:46.11,Default,,0,0,0,,Бір жылдық жеңілдікті кезең берейік.
Dialogue: 0,0:13:46.61,0:13:52.70,Default,,0,0,0,,Осы арада істеген істеріңе өкініп, бұл жерді тастап кет.
Dialogue: 0,0:13:52.91,0:13:57.79,Default,,0,0,0,,Бір жылдан кейін қалған адамдар Уоллахиядан жойылады.
Dialogue: 0,0:13:58.42,0:14:00.71,Default,,0,0,0,,Сүйікті адамды алып кетті
Dialogue: 0,0:14:01.54,0:14:06.92,Default,,0,0,0,,Керісінше мен сенен бәрін аламын.
Dialogue: 0,0:14:08.72,0:14:09.72,Default,,0,0,0,,Бір жыл.
Dialogue: 0,0:15:00.19,0:15:01.15,Default,,0,0,0,,Бір жыл.
Dialogue: 0,0:15:01.44,0:15:06.61,Default,,0,0,0,,Бір жылдың ішінде тозақтың түбінен әскер шақыруға болады.
Dialogue: 0,0:15:08.40,0:15:09.24,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:15:12.91,0:15:14.62,Default,,0,0,0,,Келісім жасасамыз ба?
Dialogue: 0,0:15:15.28,0:15:18.91,Default,,0,0,0,,Адам өмірі нені бастан кешірді?
Dialogue: 0,0:15:19.00,0:15:21.96,Default,,0,0,0,,Лизаның болуы жалғыз себеп болды
Dialogue: 0,0:15:22.12,0:15:24.17,Default,,0,0,0,,Тек топ басшысын жазалаңыз
Dialogue: 0,0:15:24.75,0:15:29.01,Default,,0,0,0,,Түнгі әскерді босатсаң, артқа жол жоқ.
Dialogue: 0,0:15:29.63,0:15:33.68,Default,,0,0,0,,Мыңдаған жазықсыз адамдар өледі
Dialogue: 0,0:15:34.47,0:15:37.81,Default,,0,0,0,,Ешкім кінәсіз емес
Dialogue: 0,0:15:38.06,0:15:41.77,Default,,0,0,0,,Орныңыздан тұрып, қарсылық білдіріңіз
Dialogue: 0,0:15:41.85,0:15:44.36,Default,,0,0,0,,Мұны кез келген адам жасай алар еді.
Dialogue: 0,0:15:44.86,0:15:46.44,Default,,0,0,0,,Келісудің мүмкін еместігі
Dialogue: 0,0:15:47.57,0:15:51.61,Default,,0,0,0,,Мен де мұңдымын, бірақ жаппай кісі өлтіруге жол бермеймін.
Dialogue: 0,0:16:04.38,0:16:08.50,Default,,0,0,0,,1476 Валахия Турговиште
Dialogue: 0,0:16:35.24,0:16:39.79,Default,,0,0,0,,20 жыл бойы сен үшін және Құдай үшін...
Dialogue: 0,0:16:39.87,0:16:43.96,Default,,0,0,0,,Соборда архиепископ қызметін атқарған.
Dialogue: 0,0:16:44.42,0:16:46.00,Default,,0,0,0,,Қазіргідей терең...
Dialogue: 0,0:16:46.08,0:16:51.55,Default,,0,0,0,,Мен бұл қалаға Құдайдың сүйіспеншілігінің төгілгенін ешқашан сезінген емеспін.
Dialogue: 0,0:16:51.88,0:16:56.72,Default,,0,0,0,,Бір жылдан сәл астам уақыт бұрын көптеген адамдар аян көрді.
Dialogue: 0,0:16:56.89,0:17:01.97,Default,,0,0,0,,Бұл Құдайдың қалауымен бақсы өлтіріп жатқанда болды.
Dialogue: 0,0:17:02.35,0:17:04.73,Default,,0,0,0,,Шайтан пайда болады...
Dialogue: 0,0:17:04.81,0:17:08.65,Default,,0,0,0,,Бір жылдан кейін адамзатты жойып жіберемін деп қорқытты.
Dialogue: 0,0:17:09.27,0:17:11.98,Default,,0,0,0,,Бірақ біз тірі және жақсымыз.
Dialogue: 0,0:17:12.40,0:17:16.11,Default,,0,0,0,,Шайтанның өтірік айтуы таңқаларлық емес.
Dialogue: 0,0:17:16.57,0:17:22.91,Default,,0,0,0,,Өтірік пен алдау олардың үйреншікті тактикасы емес пе?
Dialogue: 0,0:17:23.75,0:17:25.41,Default,,0,0,0,,Барлығы біледі
Dialogue: 0,0:17:25.79,0:17:30.09,Default,,0,0,0,,Бізде елес пен өтіріктен қорқатын ештеңе жоқ.
Dialogue: 0,0:17:30.34,0:17:34.01,Default,,0,0,0,,Турговиште адамдары асыл.
Dialogue: 0,0:17:34.17,0:17:39.30,Default,,0,0,0,,Құдайдың сүйіспеншілігіне бөленіп, мен бейбіт өмір сүремін.
Dialogue: 0,0:18:37.11,0:18:39.07,Default,,0,0,0,,Бір жыл өтті.
Dialogue: 0,0:18:40.07,0:18:44.95,Default,,0,0,0,,Құдайға кешірім сұрауға уақыт беру керек еді.
Dialogue: 0,0:18:45.54,0:18:46.70,Default,,0,0,0,,Бірақ не?
Dialogue: 0,0:18:47.41,0:18:51.08,Default,,0,0,0,,Әйелімді өлтірген күнді тойлау
Dialogue: 0,0:18:52.17,0:18:53.96,Default,,0,0,0,,Бір жылдық жеңілдік кезеңі берілді
Dialogue: 0,0:18:54.29,0:18:57.17,Default,,0,0,0,,Осы арада мен әскер жинадым.
Dialogue: 0,0:18:57.26,0:19:02.14,Default,,0,0,0,,Мен қазір сенің өліміңді әкелуге келдім.
Dialogue: 0,0:19:03.30,0:19:05.43,Default,,0,0,0,,Сіз өз мүмкіндігіңізді босқа жібердіңіз.
Dialogue: 0,0:20:19.17,0:20:20.67,Default,,0,0,0,,Олардың барлығын өлтіріңіз
Dialogue: 0,0:20:21.34,0:20:22.59,Default,,0,0,0,,Олардың бәрін өлтіріңіз
Dialogue: 0,0:20:23.09,0:20:27.22,Default,,0,0,0,,Турговиштені әйеліме ұсынсам...
Dialogue: 0,0:20:27.30,0:20:29.31,Default,,0,0,0,,Елге тереңірек барыңыз
Dialogue: 0,0:20:29.77,0:20:30.60,Default,,0,0,0,,Жүр!
Dialogue: 0,0:20:31.06,0:20:33.44,Default,,0,0,0,,Уоллахия қалаларын қирату
Dialogue: 0,0:20:33.73,0:20:35.69,Default,,0,0,0,,Арджес Северин
Dialogue: 0,0:20:35.77,0:20:38.65,Default,,0,0,0,,Грешит Киллиа Энисара
Dialogue: 0,0:20:38.77,0:20:40.78,Default,,0,0,0,,Қазір барып мені өлтір.
Dialogue: 0,0:20:41.24,0:20:43.78,Default,,0,0,0,,Мен жақсы көретіндер үшін
Dialogue: 0,0:20:44.32,0:20:48.12,Default,,0,0,0,,Мен шын сүйген жалғыз адам үшін
Dialogue: 0,0:20:48.41,0:20:52.91,Default,,0,0,0,,Бұл өшпенділік ешқашан жойылмайды
Dialogue: 0,0:21:05.26,0:21:06.51,Default,,0,0,0,,«Мурдену» «Гресит 24 км қашықтықта»
Dialogue: 0,0:21:05.26,0:21:06.51,Default,,0,0,0,,...
Dialogue: 0,0:21:06.51,0:21:06.64,Default,,0,0,0,,«Мурдену» «Гресит 24 км қашықтықта»
Dialogue: 0,0:21:06.64,0:21:08.76,Default,,0,0,0,,«Мурдену» «Гресит 24 км қашықтықта»
Dialogue: 0,0:21:06.64,0:21:08.76,Default,,0,0,0,,«Ол менің ешкім. Мен оны 4 жасынан бастап бағып келемін».
Dialogue: 0,0:21:08.76,0:21:08.85,Default,,0,0,0,,«Бұл менің ешкі, мен оны 4 жасынан бастап бағып келемін».
Dialogue: 0,0:21:08.85,0:21:10.76,Default,,0,0,0,,«Ол менің ешкім. Мен оны 4 жасынан бастап бағып келемін».
Dialogue: 0,0:21:08.85,0:21:10.76,Default,,0,0,0,,"Турговиште 113 км қашықтықта"
Dialogue: 0,0:21:10.97,0:21:12.22,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:12.31,0:21:15.35,Default,,0,0,0,,Ешкінің кімге ұнайтынын бір қарағанда білуге болады
Dialogue: 0,0:21:15.60,0:21:16.90,Default,,0,0,0,,Мазарлардағы барлық ескі суреттер
Dialogue: 0,0:21:16.98,0:21:18.31,Default,,0,0,0,,дейді
Dialogue: 0,0:21:18.65,0:21:21.15,Default,,0,0,0,,«Сенің ешкің мені жақсы көреді»
Dialogue: 0,0:21:21.36,0:21:23.53,Default,,0,0,0,,Неліктен олай ойлайсың?
Dialogue: 0,0:21:23.78,0:21:28.95,Default,,0,0,0,,«Себебі ешкі мені тастап, жыныстық қатынасқа түсуге рұқсат берді».
Dialogue: 0,0:21:29.32,0:21:31.08,Default,,0,0,0,,Сен мені неге ұрдың?
Dialogue: 0,0:21:31.58,0:21:33.66,Default,,0,0,0,,Бетке күрек
Dialogue: 0,0:21:34.16,0:21:36.00,Default,,0,0,0,,Шебер былай дейді:
Dialogue: 0,0:21:36.16,0:21:40.25,Default,,0,0,0,,Оның көзі көрмей қалды, мен оған ақша төлеймін дедім.
Dialogue: 0,0:21:40.42,0:21:41.50,Default,,0,0,0,,Бұл әділ емес.
Dialogue: 0,0:21:41.67,0:21:43.05,Default,,0,0,0,,Соқыр деген не?
Dialogue: 0,0:21:43.59,0:21:48.09,Default,,0,0,0,,Себебі мен ешкімен жыныстық қатынастан ауырдым.
Dialogue: 0,0:21:48.39,0:21:50.10,Default,,0,0,0,,Бұл сіздің жауапкершілігіңіз.
Dialogue: 0,0:21:50.39,0:21:52.14,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:21:52.68,0:21:54.27,Default,,0,0,0,,Мен оны тапқанда-
Dialogue: 0,0:21:54.35,0:21:59.56,Default,,0,0,0,,Ешкіні зорлап, жартысын өлімге қалдырды.
Dialogue: 0,0:21:59.69,0:22:03.86,Default,,0,0,0,,Ер адамның мүшесі сабан мен қанға боялған.
Dialogue: 0,0:22:03.98,0:22:05.36,Default,,0,0,0,,Күрекпен ұру
Dialogue: 0,0:22:05.53,0:22:07.70,Default,,0,0,0,,Бұл жалғыз нұсқа.
Dialogue: 0,0:22:07.78,0:22:10.24,Default,,0,0,0,,Менің немере ағама сусын беріңіз
Dialogue: 0,0:22:10.45,0:22:11.28,Default,,0,0,0,,Ағайындылар
Dialogue: 0,0:22:12.37,0:22:14.91,Default,,0,0,0,,Біздің әкеміз бір болуы мүмкін...
Dialogue: 0,0:22:15.20,0:22:17.08,Default,,0,0,0,,Менің анам менің нағашым.
Dialogue: 0,0:22:17.87,0:22:19.88,Default,,0,0,0,,Келесіде бұлай айтсаң, мен сені жұдырықтаймын.
Dialogue: 0,0:22:20.13,0:22:21.79,Default,,0,0,0,,Тағы кім ішуді қалайды?
Dialogue: 0,0:22:22.09,0:22:23.38,Default,,0,0,0,,Мен де толтырғым келеді.
Dialogue: 0,0:22:25.09,0:22:26.76,Default,,0,0,0,,Әй, бұл қиын.
Dialogue: 0,0:22:27.84,0:22:28.93,Default,,0,0,0,,Петр?
Dialogue: 0,0:22:29.93,0:22:34.47,Default,,0,0,0,,Сіз азғырушы қой таптыңыз ба?
Dialogue: 0,0:22:35.10,0:22:36.43,Default,,0,0,0,,Не болды?
Dialogue: 0,0:22:41.27,0:22:43.82,Default,,0,0,0,,Батыста құбыжықтар ордасы дүр сілкінді.
Dialogue: 0,0:22:44.23,0:22:46.32,Default,,0,0,0,,Осы уақытқа дейін келе жатырсың ба?
Dialogue: 0,0:22:46.57,0:22:49.24,Default,,0,0,0,,Бұл өтпеуі мүмкін.
Dialogue: 0,0:22:49.36,0:22:52.49,Default,,0,0,0,,Олар Грешитке бара жатқан сияқты.
Dialogue: 0,0:22:52.66,0:22:56.08,Default,,0,0,0,,Міне, намысшылдар лайық.
Dialogue: 0,0:22:56.33,0:22:57.58,Default,,0,0,0,,Бұл асыра сілтеу
Dialogue: 0,0:22:57.75,0:23:02.25,Default,,0,0,0,,Сайып келгенде, себепші болып отырған ұлы ақсүйектер.
Dialogue: 0,0:23:02.96,0:23:04.96,Default,,0,0,0,,Бұл әйгілі Грешиттер отбасы.
Dialogue: 0,0:23:05.92,0:23:10.68,Default,,0,0,0,,Дәл солай Дракула Владқа және астаналықтардың барлығына қатысты.
Dialogue: 0,0:23:11.01,0:23:14.89,Default,,0,0,0,,Олардың бәрі асылдар, бірақ ең сорақысы...
Dialogue: 0,0:23:15.26,0:23:16.72,Default,,0,0,0,,Белмонт отбасы.
Dialogue: 0,0:23:17.68,0:23:20.14,Default,,0,0,0,,Бәрімізді құрту керек.
Dialogue: 0,0:23:21.56,0:23:23.02,Default,,0,0,0,,Алайда сол кезде теледидар станциясына асығып барған Учида мырзаның өлтірілуі,
Dialogue: 0,0:24:22.62,0:24:24.29,Default,,0,0,0,,Жапон субтитрлері Харука Игучи
Dialogue: 0,0:24:25.79,0:24:31.79,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory