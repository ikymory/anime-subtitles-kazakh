Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:24.06,0:00:25.56,Default,,0,0,0,,Жетпейді
Dialogue: 0,0:00:25.65,0:00:29.69,Default,,0,0,0,,Бұл деңгейде мен өлемін деген қорқыныштан арыла алмаймын.
Dialogue: 0,0:00:32.40,0:00:37.16,Default,,0,0,0,,♪~
Dialogue: 0,0:01:56.53,0:02:00.95,Default,,0,0,0,,~♪
Dialogue: 0,0:02:04.24,0:02:05.83,Default,,0,0,0,,Менің әкем...
Dialogue: 0,0:02:06.33,0:02:07.75,Default,,0,0,0,,Қайтып әкелгеніңіз —
Dialogue: 0,0:02:07.83,0:02:08.96,Default,,0,0,0,,Дәл осы
Dialogue: 0,0:02:10.12,0:02:11.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:18.80,0:02:19.97,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:36.15,0:02:37.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:37.65,0:02:41.36,Default,,0,0,0,,Картаны сала аласыз ба? О Дурака
Dialogue: 0,0:02:41.45,0:02:42.66,Default,,0,0,0,,Ауыл басшысы
Dialogue: 0,0:02:43.95,0:02:46.62,Default,,0,0,0,,Иә, бұл негізінен дұрыс деп ойлаймын.
Dialogue: 0,0:02:46.70,0:02:50.83,Default,,0,0,0,,О, бұл керемет! Әдеттегідей рахмет
Dialogue: 0,0:02:50.92,0:02:53.04,Default,,0,0,0,,Ал, менің әңгімем.
Dialogue: 0,0:02:53.13,0:02:54.17,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:54.67,0:02:58.72,Default,,0,0,0,,«Келесі жолы...» десем де, сен мені тыңдамайсың, солай ма?
Dialogue: 0,0:02:58.80,0:03:03.47,Default,,0,0,0,,Иә, бұл тапсырмамды орындасам, мені тыңдайсың деген уәде.
Dialogue: 0,0:03:03.55,0:03:06.47,Default,,0,0,0,,Ммм, түсіндім.
Dialogue: 0,0:03:07.60,0:03:11.73,Default,,0,0,0,,Біз үшін ақша табудың жақсы жолы болуы керек.
Dialogue: 0,0:03:11.81,0:03:15.44,Default,,0,0,0,,Енді біз пайданы бірге бөлісеміз.
Dialogue: 0,0:03:15.52,0:03:17.82,Default,,0,0,0,,Сонда кейбір адамдар жалқау болады.
Dialogue: 0,0:03:17.90,0:03:22.66,Default,,0,0,0,,Бұған жол бермеу үшін біз көбірек істегендерді марапаттауымыз керек.
Dialogue: 0,0:03:22.74,0:03:24.99,Default,,0,0,0,,Дұрысы, монополия болғаны дұрыс.
Dialogue: 0,0:03:25.58,0:03:29.12,Default,,0,0,0,,Бөлу азайса, дағдарыс сезіміне байланысты бәсекелестік үдей түседі.
Dialogue: 0,0:03:29.20,0:03:31.79,Default,,0,0,0,,Егер біз мұны жасасақ, жалпы топ жақсы нәтижеге ие болады...
Dialogue: 0,0:03:31.87,0:03:32.79,Default,,0,0,0,,Дурака
Dialogue: 0,0:03:32.87,0:03:34.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:34.25,0:03:37.38,Default,,0,0,0,,Мен саған әрқашан ризамын
Dialogue: 0,0:03:37.46,0:03:41.59,Default,,0,0,0,,Бұл ауылдың болашағын сенен артық ойлайтын ешкім жоқ.
Dialogue: 0,0:03:43.13,0:03:45.22,Default,,0,0,0,,Сіз тез үйренушісіз.
Dialogue: 0,0:03:45.80,0:03:48.97,Default,,0,0,0,,Сіз тек бір рет барған қараусыз қалған ауылдың картасын сала аласыз.
Dialogue: 0,0:03:50.68,0:03:52.69,Default,,0,0,0,,Сол картаға сүйену
Dialogue: 0,0:03:52.77,0:03:56.61,Default,,0,0,0,,Біз қолдануға болатын матаның қалдықтарын қауіпсіз жинаймыз.
Dialogue: 0,0:03:57.36,0:04:02.61,Default,,0,0,0,,Арнайы процесс арқылы жаңа өнімге қайта туды
Dialogue: 0,0:04:02.70,0:04:05.91,Default,,0,0,0,,Әр адам өз бетінше жұмыс істегеннен гөрі
Dialogue: 0,0:04:05.99,0:04:11.87,Default,,0,0,0,,Мамандандырылған рөлдер арқылы тиімділік пен сапаны арттырыңыз
Dialogue: 0,0:04:11.96,0:04:14.33,Default,,0,0,0,,Бұл сіздің ұсынысыңыз болды.
Dialogue: 0,0:04:14.42,0:04:19.46,Default,,0,0,0,,Осының арқасында мен бұрынғыдай қауіпті ұрлық пен аңшылықпен айналысудың қажеті жоқ.
Dialogue: 0,0:04:19.55,0:04:22.47,Default,,0,0,0,,Ауыл жеткілікті түрде байыды.
Dialogue: 0,0:04:22.55,0:04:25.13,Default,,0,0,0,,Барлығы сізге риза
Dialogue: 0,0:04:25.22,0:04:27.76,Default,,0,0,0,,Бірақ бұл бәрібір мағынасыз.
Dialogue: 0,0:04:27.85,0:04:32.43,Default,,0,0,0,,Жеке айырмашылықтарсыз біркелкі өндіруге болатын технология мен өнімдер болуы керек.
Dialogue: 0,0:04:32.52,0:04:34.14,Default,,0,0,0,,Мен оны тапқым келеді!
Dialogue: 0,0:04:34.23,0:04:35.94,Default,,0,0,0,,Дурака
Dialogue: 0,0:04:36.02,0:04:39.52,Default,,0,0,0,,Мен бай болдым дедім.
Dialogue: 0,0:04:40.53,0:04:42.28,Default,,0,0,0,,Ашкөздік жақсы емес
Dialogue: 0,0:04:42.36,0:04:44.78,Default,,0,0,0,,Бұдан көп табыс тапсаңыз, не істер едіңіз?
Dialogue: 0,0:04:44.86,0:04:45.99,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:46.07,0:04:49.41,Default,,0,0,0,,Пайда – Құдайдың сыйы.
Dialogue: 0,0:04:49.49,0:04:52.45,Default,,0,0,0,,Бірдей бөлісу заңдылық.
Dialogue: 0,0:04:52.54,0:04:54.37,Default,,0,0,0,,Жақыныңды көбірек жақсы көр
Dialogue: 0,0:04:55.92,0:04:57.13,Default,,0,0,0,,Бұл жаман емес.
Dialogue: 0,0:04:57.71,0:05:00.63,Default,,0,0,0,,Өйткені бұл Құдайдың ілімі.
Dialogue: 0,0:05:01.25,0:05:03.21,Default,,0,0,0,,Бұл жеткіліксіз
Dialogue: 0,0:05:03.30,0:05:05.51,Default,,0,0,0,,Иә?Не?
Dialogue: 0,0:05:05.59,0:05:07.09,Default,,0,0,0,,Ақшаңыз жетпей ме?
Dialogue: 0,0:05:12.06,0:05:14.52,Default,,0,0,0,,Сіз еңбек сіңірген адамсыз.
Dialogue: 0,0:05:14.60,0:05:17.85,Default,,0,0,0,,Мен саған ауылымның жинаған ақшасын кез келген уақытта берем.
Dialogue: 0,0:05:17.94,0:05:22.44,Default,,0,0,0,,Мен мұндай ақшаның бізге не үшін керек екенін білмеймін...
Dialogue: 0,0:05:23.07,0:05:24.94,Default,,0,0,0,,Жан тыныштығы үшін
Dialogue: 0,0:05:25.03,0:05:27.32,Default,,0,0,0,,ше? жан тыныштығы?
Dialogue: 0,0:05:27.41,0:05:29.32,Default,,0,0,0,,Жоқ, ештеңе.
Dialogue: 0,0:05:29.41,0:05:31.33,Default,,0,0,0,,Қарыз өте жақсы.
Dialogue: 0,0:05:31.41,0:05:32.66,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:37.67,0:05:40.50,Default,,0,0,0,,Ағай, мен сізге тамақ әкелдім.
Dialogue: 0,0:05:40.59,0:05:41.96,Default,,0,0,0,,О, Дурака
Dialogue: 0,0:05:43.00,0:05:46.97,Default,,0,0,0,,Осы бейшара науқас үшін сізге көп рахмет.
Dialogue: 0,0:05:50.05,0:05:52.81,Default,,0,0,0,,Не? Сіз тағы да алкогольді ұрладыңыз ба?
Dialogue: 0,0:05:52.89,0:05:55.89,Default,,0,0,0,,Әй, адамдар еститін жаман сөз.
Dialogue: 0,0:05:55.98,0:05:58.27,Default,,0,0,0,,Бұл ортақ меншік емес пе?
Dialogue: 0,0:05:58.35,0:05:59.52,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:05:59.60,0:06:02.11,Default,,0,0,0,,Өтінемін, мені қорламаңыз
Dialogue: 0,0:06:02.19,0:06:04.40,Default,,0,0,0,,Ауруға шалдыққан адам
Dialogue: 0,0:06:04.48,0:06:06.44,Default,,0,0,0,,Мен жақында кетемін
Dialogue: 0,0:06:06.94,0:06:09.78,Default,,0,0,0,,Сіз алкогольге шыдай аласыз ба?
Dialogue: 0,0:06:11.07,0:06:12.91,Default,,0,0,0,,Мен мұны бірнеше жылдан бері айтып келемін.
Dialogue: 0,0:06:12.99,0:06:14.16,Default,,0,0,0,,Сіз мүлде өлмейсіз.
Dialogue: 0,0:06:14.24,0:06:16.45,Default,,0,0,0,,О, бұл...
Dialogue: 0,0:06:17.12,0:06:20.00,Default,,0,0,0,,Өткенде шыншыл болғанымды қалаймын.
Dialogue: 0,0:06:20.08,0:06:22.00,Default,,0,0,0,,Неліктен бұлай...
Dialogue: 0,0:06:22.50,0:06:24.71,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:06:24.80,0:06:27.84,Default,,0,0,0,,Ағаңның пікірін білгім келеді.
Dialogue: 0,0:06:27.92,0:06:29.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:29.68,0:06:31.80,Default,,0,0,0,,Жеке тұлғалардың еркін бәсекесінде
Dialogue: 0,0:06:31.89,0:06:35.81,Default,,0,0,0,,Мен жалпы топтың пайдасын арттыруға болады деп ойладым.
Dialogue: 0,0:06:35.89,0:06:36.72,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:06:37.81,0:06:39.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:39.10,0:06:41.65,Default,,0,0,0,,Бұл мүмкін.
Dialogue: 0,0:06:41.73,0:06:42.81,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:06:42.90,0:06:45.15,Default,,0,0,0,,Бірақ мен келіспеймін.
Dialogue: 0,0:06:45.23,0:06:46.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:46.57,0:06:49.65,Default,,0,0,0,,Құдайдың іліміне қайшы келетіндіктен емес.
Dialogue: 0,0:06:49.74,0:06:52.57,Default,,0,0,0,,Өйткені қауым жойылады.
Dialogue: 0,0:06:53.37,0:06:57.91,Default,,0,0,0,,Біз бәсекелестікті ынталандыру үшін тым кішкентаймыз
Dialogue: 0,0:06:58.41,0:07:01.25,Default,,0,0,0,,Оның үстіне көбейсе де жарайды.
Dialogue: 0,0:07:01.83,0:07:05.84,Default,,0,0,0,,Адам саны көбейген сайын бәсекелестік күшейетіні рас.
Dialogue: 0,0:07:05.92,0:07:08.38,Default,,0,0,0,,Нәтижесінде диспропорция одан да нашарлайды.
Dialogue: 0,0:07:08.46,0:07:10.80,Default,,0,0,0,,Және ол қақтығыс тудырады
Dialogue: 0,0:07:11.34,0:07:16.06,Default,,0,0,0,,Бұл идеяның әлсіздерге көмектесетін тетігі жоқ.
Dialogue: 0,0:07:16.14,0:07:19.48,Default,,0,0,0,,Этикасыз еркіндік – бұл жай ғана хаос.
Dialogue: 0,0:07:20.81,0:07:23.60,Default,,0,0,0,,О... жоқ па?
Dialogue: 0,0:07:23.69,0:07:27.15,Default,,0,0,0,,Ал, көңілсіз болатын ештеңе жоқ.
Dialogue: 0,0:07:27.23,0:07:30.24,Default,,0,0,0,,Ақылдысың, болашағың бар.
Dialogue: 0,0:07:31.24,0:07:34.62,Default,,0,0,0,,Осыны айтып, мен кейде уайымдаймын.
Dialogue: 0,0:07:34.70,0:07:36.91,Default,,0,0,0,,Мүмкін менің бүкіл өмірім
Dialogue: 0,0:07:36.99,0:07:40.66,Default,,0,0,0,,Менің ойымша, бұл жерде аяқталады, дәл осылай.
Dialogue: 0,0:07:41.16,0:07:42.87,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:07:43.37,0:07:45.75,Default,,0,0,0,,Сенімдерің бар
Dialogue: 0,0:07:46.25,0:07:49.76,Default,,0,0,0,,Бір күні сол сенім сені жетелейді
Dialogue: 0,0:07:49.84,0:07:52.59,Default,,0,0,0,,Қазір уақыт емес
Dialogue: 0,0:07:52.68,0:07:55.18,Default,,0,0,0,,Иә, мен сенемін.
Dialogue: 0,0:08:04.90,0:08:06.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:24.58,0:08:26.83,Default,,0,0,0,,Сіз осында үнемі жылайсыз ба?
Dialogue: 0,0:08:27.96,0:08:30.42,Default,,0,0,0,,Аға аға
Dialogue: 0,0:08:30.92,0:08:32.38,Default,,0,0,0,,Қайтып кел
Dialogue: 0,0:08:32.47,0:08:36.55,Default,,0,0,0,,Әр адам үнемі уайымдайды, өйткені сен күнде таңертең жоқсың.
Dialogue: 0,0:08:36.64,0:08:39.10,Default,,0,0,0,,Топтық өмірде өз қалауыңыз бойынша жасаңыз
Dialogue: 0,0:08:40.39,0:08:43.10,Default,,0,0,0,,Сен маған айттың ба?
Dialogue: 0,0:08:43.68,0:08:46.23,Default,,0,0,0,,Өйткені мен сіздің жалғыз қандасыңызмын.
Dialogue: 0,0:08:46.90,0:08:48.48,Default,,0,0,0,,Содан кейін үйге бара аласыз.
Dialogue: 0,0:08:48.56,0:08:50.57,Default,,0,0,0,,Мен де бірден қайтамын.
Dialogue: 0,0:08:50.65,0:08:52.65,Default,,0,0,0,,Бұлай болуы мүмкін емес.
Dialogue: 0,0:08:52.74,0:08:55.53,Default,,0,0,0,,Бәрібір ертең қайталайтын шығармын
Dialogue: 0,0:08:55.61,0:08:58.24,Default,,0,0,0,,Мен неге күнде таңертең жылаймын?
Dialogue: 0,0:08:59.08,0:09:01.49,Default,,0,0,0,,Сіз мұны түсінбейсіз бе?
Dialogue: 0,0:09:02.20,0:09:04.75,Default,,0,0,0,,Себебі әкем таңертең қайтыс болды.
Dialogue: 0,0:09:04.83,0:09:07.71,Default,,0,0,0,,Солай болса да, сен мұнда не үшін келдің?
Dialogue: 0,0:09:07.79,0:09:09.75,Default,,0,0,0,,Сіз шатырыңызда жылай аласыз.
Dialogue: 0,0:09:09.84,0:09:12.88,Default,,0,0,0,,Сонда сіз мұны түсінбейсіз бе?
Dialogue: 0,0:09:12.96,0:09:15.47,Default,,0,0,0,,Бұл сіз үшін маңызды болғандықтан шешілді.
Dialogue: 0,0:09:16.09,0:09:17.22,Default,,0,0,0,,Менде қандай да бір дарын бар адам сияқты көрінемін бе?
Dialogue: 0,0:09:17.30,0:09:18.80,Default,,0,0,0,,Барлығы үшін!
Dialogue: 0,0:09:18.89,0:09:21.89,Default,,0,0,0,,Барлығы әкемнің жәннатқа кеткенін айтады.
Dialogue: 0,0:09:21.97,0:09:23.72,Default,,0,0,0,,Күнде таңертең жылайтын болсам
Dialogue: 0,0:09:23.81,0:09:26.73,Default,,0,0,0,,Құдайдың шақыруы өтірік сияқты!
Dialogue: 0,0:09:28.56,0:09:31.36,Default,,0,0,0,,Хмм, түсіндім.
Dialogue: 0,0:09:33.94,0:09:36.70,Default,,0,0,0,,Енді мәселеңізді шешейік.
Dialogue: 0,0:09:36.78,0:09:38.95,Default,,0,0,0,,Үш сиқырды сыйлайық
Dialogue: 0,0:09:39.45,0:09:41.37,Default,,0,0,0,,Бірақ ешкімге айтпа
Dialogue: 0,0:09:41.45,0:09:45.87,Default,,0,0,0,,ше? Бұл Құдайдың іліміне қайшы...
Dialogue: 0,0:09:46.83,0:09:48.12,Default,,0,0,0,,Бірінші
Dialogue: 0,0:09:48.87,0:09:50.71,Default,,0,0,0,,Құдай жоқ
Dialogue: 0,0:09:52.92,0:09:53.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:53.84,0:09:57.51,Default,,0,0,0,,Шын мәнінде, Құдайдың бар екеніне ешқандай дәлел жоқ.
Dialogue: 0,0:09:57.59,0:10:02.56,Default,,0,0,0,,Шындықты білмегендіктен сенетіндер бар.
Dialogue: 0,0:10:02.64,0:10:07.27,Default,,0,0,0,,Егер сіз Құдайға сенбесеңіз, сізде көбірек мүмкіндіктер бар және тиімдірек.
Dialogue: 0,0:10:08.64,0:10:12.52,Default,,0,0,0,,Қалай болғанда да, қазірден бастап Құдай үшін уайымдаудың қажеті жоқ.
Dialogue: 0,0:10:12.61,0:10:15.57,Default,,0,0,0,,Құдай оны алып тастағанша
Dialogue: 0,0:10:15.65,0:10:19.07,Default,,0,0,0,,Эмоциялық көшбасшылық және өмірдің мәні
Dialogue: 0,0:10:19.16,0:10:23.78,Default,,0,0,0,,Ендеше, сенің дертің дүниенің азабымен тең.
Dialogue: 0,0:10:23.87,0:10:27.66,Default,,0,0,0,,Ертең жұрттың алдында күйзеліске түсуден қорықпа.
Dialogue: 0,0:10:28.16,0:10:31.13,Default,,0,0,0,,Мұны түсінгеннен кейін, екінші нәрсе
Dialogue: 0,0:10:31.21,0:10:32.59,Default,,0,0,0,,Ойлан
Dialogue: 0,0:10:32.67,0:10:36.30,Default,,0,0,0,,Ол үшін әріптерді үйрен, кітап оқы.
Dialogue: 0,0:10:36.38,0:10:40.34,Default,,0,0,0,,Білуші болу емес, ойлану.
Dialogue: 0,0:10:40.43,0:10:46.31,Default,,0,0,0,,Бір-бірімен байланыссыз болып көрінетін ақпарат бөліктері арасындағы байланыстарды табыңыз
Dialogue: 0,0:10:46.39,0:10:49.85,Default,,0,0,0,,Жай ақпаратты қолдануға болатын білімге айналдырыңыз
Dialogue: 0,0:10:50.48,0:10:52.86,Default,,0,0,0,,Интеллект процесте орналасады
Dialogue: 0,0:10:53.48,0:10:54.69,Default,,0,0,0,,Интеллект?
Dialogue: 0,0:10:54.77,0:10:55.94,Default,,0,0,0,,Иә.
Dialogue: 0,0:10:56.03,0:11:00.49,Default,,0,0,0,,Бұл сізге қалуға және шығуға батылдық береді.
Dialogue: 0,0:11:01.61,0:11:04.95,Default,,0,0,0,,Құдайсыз әлем туралы ойлау
Dialogue: 0,0:11:05.03,0:11:08.79,Default,,0,0,0,,Сіз білмей тұрып, үшінші сиқыр табиғи түрде туады.
Dialogue: 0,0:11:08.87,0:11:10.46,Default,,0,0,0,,Сенім дегеніміз не?
Dialogue: 0,0:11:10.54,0:11:11.50,Default,,0,0,0,,Сенім?
Dialogue: 0,0:11:11.58,0:11:13.21,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:13.29,0:11:17.30,Default,,0,0,0,,Осы арқылы сіз өз уайымыңызды жеңіп, жылауыңызды тоқтата аласыз.
Dialogue: 0,0:11:17.38,0:11:19.51,Default,,0,0,0,,Мысалы, менің сенімім
Dialogue: 0,0:11:20.84,0:11:23.68,Default,,0,0,0,,«Сенімдеріңнен бас тартсаң да аман қал»
Dialogue: 0,0:11:24.35,0:11:27.14,Default,,0,0,0,,Бұл біртүрлі...
Dialogue: 0,0:11:27.22,0:11:30.06,Default,,0,0,0,,Аа, бұл қайшылық.
Dialogue: 0,0:11:30.14,0:11:33.10,Default,,0,0,0,,Міне, сиқыр деген осы.
Dialogue: 0,0:11:34.15,0:11:37.48,Default,,0,0,0,,Жарайды, түсінсең ертең шатырда қал.
Dialogue: 0,0:11:37.98,0:11:39.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:50.00,0:11:52.83,Default,,0,0,0,,Құдай жоқ
Dialogue: 0,0:11:52.92,0:11:54.46,Default,,0,0,0,,Ойлан
Dialogue: 0,0:11:54.54,0:11:56.84,Default,,0,0,0,,Содан кейін сенім пайда болады.
Dialogue: 0,0:11:58.21,0:12:01.09,Default,,0,0,0,,Әкем талан-таражға түсіп, қайтыс болды.
Dialogue: 0,0:12:01.17,0:12:03.43,Default,,0,0,0,,Осы ақша ғана қалды.
Dialogue: 0,0:12:05.76,0:12:09.27,Default,,0,0,0,,Ойлан, әкең неліктен өлді?
Dialogue: 0,0:12:09.35,0:12:12.39,Default,,0,0,0,,Бұл ақша маған не дейді?
Dialogue: 0,0:12:12.48,0:12:14.06,Default,,0,0,0,,Сіз нені үйретесіз?
Dialogue: 0,0:12:14.77,0:12:17.82,Default,,0,0,0,,Әкем тонауға баруға мәжбүр болды.
Dialogue: 0,0:12:17.90,0:12:20.57,Default,,0,0,0,,Өйткені олай етпесең, өмір сүре алмайсың.
Dialogue: 0,0:12:20.65,0:12:25.16,Default,,0,0,0,,Егер менің ақшам көп болса, мен мұндай қауіпті іс жасамас едім.
Dialogue: 0,0:12:25.24,0:12:28.70,Default,,0,0,0,,Ақшам көп болса, әкем тірі болар еді.
Dialogue: 0,0:12:29.20,0:12:31.58,Default,,0,0,0,,Ақшаң жоқ болса, бақытсызсың.
Dialogue: 0,0:12:31.66,0:12:33.08,Default,,0,0,0,,Ақшаң жоқ болса, сен әлсізсің.
Dialogue: 0,0:12:34.58,0:12:36.00,Default,,0,0,0,,Иә.
Dialogue: 0,0:12:38.42,0:12:40.50,Default,,0,0,0,,Маған ақша табу керек
Dialogue: 0,0:12:41.01,0:12:43.51,Default,,0,0,0,,Мазасыздық жүрегімнен кеткенше
Dialogue: 0,0:12:43.59,0:12:46.51,Default,,0,0,0,,Бұл сенің әкеңнің хабары.
Dialogue: 0,0:12:46.59,0:12:48.76,Default,,0,0,0,,Бұл менің сенімім
Dialogue: 0,0:12:52.89,0:12:54.77,Default,,0,0,0,,Мен ойлануым керек
Dialogue: 0,0:12:55.27,0:12:57.10,Default,,0,0,0,,Ақшаны қалай табуға болады
Dialogue: 0,0:13:48.91,0:13:52.08,Default,,0,0,0,,Хахаха Бұл бақытты уақыт
Dialogue: 0,0:13:52.16,0:13:53.54,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:13:53.54,0:13:55.16,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:13:53.54,0:13:55.16,Default,,0,0,0,,- (Друв) Иә? -(Рыцарлар) Осылай.
Dialogue: 0,0:13:55.25,0:13:58.04,Default,,0,0,0,,Мен көптен бері тоқтамадым.
Dialogue: 0,0:13:58.12,0:13:59.29,Default,,0,0,0,,Сіз шынымен де осындасыз ба?
Dialogue: 0,0:13:59.38,0:14:01.04,Default,,0,0,0,,Жарайды, абайлайық.
Dialogue: 0,0:14:01.13,0:14:04.17,Default,,0,0,0,,Соңғы рет патрульде жүргенімде жертөле таптым.
Dialogue: 0,0:14:04.26,0:14:06.59,Default,,0,0,0,,Сонда сапалы саке көп болды.
Dialogue: 0,0:14:06.67,0:14:08.68,Default,,0,0,0,,Бұл туралы епископқа хабарлаңыз.
Dialogue: 0,0:14:10.51,0:14:12.81,Default,,0,0,0,,Эй, сен кімсің?
Dialogue: 0,0:14:13.43,0:14:15.06,Default,,0,0,0,,Мен... мен...
Dialogue: 0,0:14:15.64,0:14:18.64,Default,,0,0,0,,Оның сыртқы түрі көшпелі тайпаға жатады ма?
Dialogue: 0,0:14:18.73,0:14:20.94,Default,,0,0,0,,Бұл менің аумағым.
Dialogue: 0,0:14:21.44,0:14:23.27,Default,,0,0,0,,Сен арам пиғыл.
Dialogue: 0,0:14:23.77,0:14:24.86,Default,,0,0,0,,Мені алып кетіңіз
Dialogue: 0,0:14:24.94,0:14:26.61,Default,,0,0,0,,(Пак) Небәрі бірнеше онжылдық қана өмір сүрген адам—
Dialogue: 0,0:14:26.69,0:14:28.86,Default,,0,0,0,,Осының бәрін саған беремін.
Dialogue: 0,0:14:28.95,0:14:33.20,Default,,0,0,0,,Бұл менің жылдар бойы жинаған нәрсем, бірақ мен оған көмектесе алмаймын.
Dialogue: 0,0:14:34.12,0:14:36.25,Default,,0,0,0,,Сондықтан жіберіп алмаңыз.
Dialogue: 0,0:14:39.33,0:14:41.83,Default,,0,0,0,,Хмм, жарайды, алайық.
Dialogue: 0,0:14:42.50,0:14:43.38,Default,,0,0,0,,Олай болса мені алып кет.
Dialogue: 0,0:14:43.46,0:14:46.34,Default,,0,0,0,,Не? Күте тұрыңыз... бір сәт
Dialogue: 0,0:14:46.42,0:14:49.43,Default,,0,0,0,,Епископ, мен сыртта күдікті адамды таптым.
Dialogue: 0,0:14:49.51,0:14:51.14,Default,,0,0,0,,Мен үш адамды қуып келемін.
Dialogue: 0,0:14:51.76,0:14:53.43,Default,,0,0,0,,Сіз не жоспарлап отырсыз...
Dialogue: 0,0:14:53.51,0:14:56.35,Default,,0,0,0,,Жоқ... жоқ, мен жалғызбын.
Dialogue: 0,0:14:56.43,0:14:58.98,Default,,0,0,0,,Бұны ауыл адамдары білсе жаман болар еді...
Dialogue: 0,0:14:59.06,0:15:01.98,Default,,0,0,0,,Ұстап, жазалаушыға тапсыру.
Dialogue: 0,0:15:02.06,0:15:03.02,Default,,0,0,0,,Маюри үшін сол сәт келгенде қасында болғым келеді… яғни…
Dialogue: 0,0:15:05.19,0:15:06.03,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:15:06.65,0:15:07.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:08.11,0:15:11.45,Default,,0,0,0,,Мені түрмеге отырғызсаң да...
Dialogue: 0,0:15:11.53,0:15:14.28,Default,,0,0,0,,Сізге ештеңе жоқ, солай ма?
Dialogue: 0,0:15:14.78,0:15:18.33,Default,,0,0,0,,Оның орнына мен сізге коммерциялық құндырақ нәрсе беремін.
Dialogue: 0,0:15:18.95,0:15:20.21,Default,,0,0,0,,Не?
Dialogue: 0,0:15:21.25,0:15:23.42,Default,,0,0,0,,Жас әйел
Dialogue: 0,0:15:23.50,0:15:26.05,Default,,0,0,0,,Сондықтан мен сағындым
Dialogue: 0,0:15:28.13,0:15:29.80,Default,,0,0,0,,Жарайды, жақсы.
Dialogue: 0,0:15:35.80,0:15:37.72,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:37.81,0:15:40.10,Default,,0,0,0,,Мен саған әлі сенген жоқпын.
Dialogue: 0,0:15:40.18,0:15:42.52,Default,,0,0,0,,Ауылдың орналасқан жерін айт.
Dialogue: 0,0:15:42.60,0:15:46.32,Default,,0,0,0,,Уәдеде тұрсаң, ауыл қалмайды.
Dialogue: 0,0:15:46.40,0:15:49.49,Default,,0,0,0,,Жарайды, мен сені міндетті түрде әкелемін.
Dialogue: 0,0:15:49.57,0:15:50.95,Default,,0,0,0,,（）
Dialogue: 0,0:15:51.03,0:15:51.86,Default,,0,0,0,,Ах
Dialogue: 0,0:15:52.74,0:15:56.49,Default,,0,0,0,,Мен... Мен бұзушының қашып кетуіне жол бердім.
Dialogue: 0,0:15:57.20,0:15:58.58,Default,,0,0,0,,Епископ Антони
Dialogue: 0,0:15:59.08,0:16:00.04,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:16:00.12,0:16:02.83,Default,,0,0,0,,Аа, мен енді бұл мәселеге мән бермеймін.
Dialogue: 0,0:16:02.92,0:16:03.96,Default,,0,0,0,,Содан кейін олар жоғалады
Dialogue: 0,0:16:06.84,0:16:10.88,Default,,0,0,0,,Менің ойымша, біз бұдан да жақсы әңгіме шығарамыз.
Dialogue: 0,0:16:10.97,0:16:12.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:19.89,0:16:22.89,Default,,0,0,0,,Дурака, саған айтарым маңызды.
Dialogue: 0,0:16:23.52,0:16:26.86,Default,,0,0,0,,Мен көптен бері уайымдап жүрмін.
Dialogue: 0,0:16:26.94,0:16:28.61,Default,,0,0,0,,Сеніп тапсыру керек пе, жоқ па
Dialogue: 0,0:16:28.69,0:16:29.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:29.61,0:16:34.41,Default,,0,0,0,,Бірақ соңғы кездері өзімді жақсы сезінбей жүрмін.
Dialogue: 0,0:16:34.49,0:16:36.82,Default,,0,0,0,,Сенбейтін шығарсың, бірақ
Dialogue: 0,0:16:36.91,0:16:40.04,Default,,0,0,0,,Бұл уақыт өте жақын сияқты.
Dialogue: 0,0:16:40.12,0:16:41.33,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:41.41,0:16:43.41,Default,,0,0,0,,Сондықтан мен көп нәрсені ойладым.
Dialogue: 0,0:16:43.50,0:16:45.92,Default,,0,0,0,,Өйткені, мен оны саған сеніп тапсыруым керек.
Dialogue: 0,0:16:46.00,0:16:48.00,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:16:48.09,0:16:50.13,Default,,0,0,0,,Мен мұнда егжей-тегжейлі айта алмаймын.
Dialogue: 0,0:16:50.21,0:16:52.80,Default,,0,0,0,,Бірақ мен бір нәрсені айта аламын, бұл
Dialogue: 0,0:16:53.55,0:16:56.80,Default,,0,0,0,,Бұл сіздің тағдырыңызды өзгертетін нәрсе.
Dialogue: 0,0:16:56.89,0:16:58.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:58.85,0:17:01.39,Default,,0,0,0,,Тұзақтар барған сайын қиындап барады
Dialogue: 0,0:17:01.47,0:17:03.27,Default,,0,0,0,,Сізге ойша дайындалу қажет болуы мүмкін.
Dialogue: 0,0:17:04.60,0:17:07.23,Default,,0,0,0,,Мен дайынмын, маған көрсет.
Dialogue: 0,0:17:23.00,0:17:24.66,Default,,0,0,0,,Сіз әлі барсыз ба?
Dialogue: 0,0:17:24.75,0:17:25.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:25.66,0:17:29.46,Default,,0,0,0,,Жарайды, ана жақтағы үйде күтуге болады.
Dialogue: 0,0:17:30.25,0:17:34.42,Default,,0,0,0,,Мен келе жатқан уақытты күтуім керек.
Dialogue: 0,0:17:34.51,0:17:37.55,Default,,0,0,0,,Хмм… Түсіндім.
Dialogue: 0,0:17:41.89,0:17:44.27,Default,,0,0,0,,Иә? қан?
Dialogue: 0,0:17:44.35,0:17:45.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:01.53,0:18:02.66,Default,,0,0,0,,Я...
Dialogue: 0,0:18:05.16,0:18:06.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:06.71,0:18:07.83,Default,,0,0,0,,(Суырманы ашу дыбысы)
Dialogue: 0,0:18:10.88,0:18:12.00,Default,,0,0,0,,Кітап?
Dialogue: 0,0:18:19.97,0:18:23.10,Default,,0,0,0,,«Аспан мен жердің арасында иерархия жоқ».
Dialogue: 0,0:18:23.93,0:18:27.68,Default,,0,0,0,,«Барлығы бір тәртіпте»?
Dialogue: 0,0:18:28.31,0:18:33.15,Default,,0,0,0,,«Адамдар түпкілікті өмірден құтылды».
Dialogue: 0,0:18:33.23,0:18:36.90,Default,,0,0,0,,«Гелиоцентрлік теория бойынша бұл жердің қозғалысы»
Dialogue: 0,0:18:44.08,0:18:47.20,Default,,0,0,0,,Не... Бұл не кітап?
Dialogue: 0,0:18:48.54,0:18:49.96,Default,,0,0,0,,Күмән жоқ
Dialogue: 0,0:18:50.46,0:18:54.04,Default,,0,0,0,,Мен жаңа ғана керемет нәрсені көрдім.
Dialogue: 0,0:18:55.42,0:18:57.71,Default,,0,0,0,,А, бірақ...
Dialogue: 0,0:18:57.80,0:19:02.22,Default,,0,0,0,,Тақырыпқа қарамастан, жазылған нәрсе өте қарапайым.
Dialogue: 0,0:19:02.30,0:19:04.60,Default,,0,0,0,,Теориялық емес
Dialogue: 0,0:19:04.68,0:19:08.77,Default,,0,0,0,,Гелиоцентрлік теорияның мәдени әсері
Dialogue: 0,0:19:08.85,0:19:12.86,Default,,0,0,0,,Кітаптарға келетін болсақ, олардың көпшілігі діни немесе академиялық.
Dialogue: 0,0:19:12.94,0:19:15.48,Default,,0,0,0,,Бұл олардың кез келгенінен ерекшеленеді.
Dialogue: 0,0:19:15.57,0:19:17.94,Default,,0,0,0,,Бұл жеке пікір сияқты.
Dialogue: 0,0:19:18.03,0:19:22.07,Default,,0,0,0,,Бұл жерді жаратқан Құдайға құлшылық етумен аяқталады.
Dialogue: 0,0:19:23.20,0:19:25.41,Default,,0,0,0,,Бұл қызықты мазмұн.
Dialogue: 0,0:19:25.49,0:19:29.75,Default,,0,0,0,,Бірақ менің ренжігенім тек ішіндегі нәрсеге байланысты емес.
Dialogue: 0,0:19:30.91,0:19:35.50,Default,,0,0,0,,Бұл сезім үлкенірек нәрсені сұрайды.
Dialogue: 0,0:19:36.17,0:19:39.38,Default,,0,0,0,,өзін әлсіз сезінеді
Dialogue: 0,0:19:40.01,0:19:43.39,Default,,0,0,0,,Мен бұл кітап арқылы көп ақша табуға болатындай сезінемін.
Dialogue: 0,0:19:45.43,0:19:46.64,Default,,0,0,0,,Ойлан
Dialogue: 0,0:19:50.98,0:19:53.10,Default,,0,0,0,,Негіздерден бастайық
Dialogue: 0,0:19:53.19,0:19:57.73,Default,,0,0,0,,Көп ақша табу үшін сіз халық арасында кең қабылдануыңыз керек.
Dialogue: 0,0:19:58.73,0:20:02.40,Default,,0,0,0,,Қабылдау деген нені білдіреді?
Dialogue: 0,0:20:02.49,0:20:05.91,Default,,0,0,0,,Тарихта ең көп қабылданған адам... болды.
Dialogue: 0,0:20:07.03,0:20:09.29,Default,,0,0,0,,Құдай шығар
Dialogue: 0,0:20:09.91,0:20:13.04,Default,,0,0,0,,Құдай неге сонша көп алады?
Dialogue: 0,0:20:14.04,0:20:17.54,Default,,0,0,0,,Бұл бәрінің мазасыздануынан болса керек.
Dialogue: 0,0:20:18.21,0:20:19.96,Default,,0,0,0,,Болашақта немесе өлгеннен кейін не болады?
Dialogue: 0,0:20:20.05,0:20:23.05,Default,,0,0,0,,Адамдар белгісіз және белгісіздіктен қорқады
Dialogue: 0,0:20:23.13,0:20:28.47,Default,,0,0,0,,Құтқарушы ретінде абсолютті және айнымайтын Құдай бар.
Dialogue: 0,0:20:29.26,0:20:32.31,Default,,0,0,0,,Бірақ бір кезде ағам:
Dialogue: 0,0:20:33.60,0:20:35.15,Default,,0,0,0,,«Құдай жоқ»
Dialogue: 0,0:20:35.65,0:20:37.73,Default,,0,0,0,,Егер бұл рас болса
Dialogue: 0,0:20:37.81,0:20:41.49,Default,,0,0,0,,Енді Құдайдан басқа таңдау жоқ.
Dialogue: 0,0:20:41.57,0:20:45.74,Default,,0,0,0,,Мазасыздықты жоюдың балама жолы бар шығар?
Dialogue: 0,0:20:46.37,0:20:49.03,Default,,0,0,0,,Орындалатынын білмейтін дұғадан
Dialogue: 0,0:20:49.12,0:20:53.37,Default,,0,0,0,,Егер сіз ойын-сауық арқылы өзіңізді алаңдаушылықтан алшақтата алсаңыз ше?
Dialogue: 0,0:20:54.54,0:20:59.13,Default,,0,0,0,,Адамдар түсінуге оңай нәрселерді жақсы көруі керек.
Dialogue: 0,0:20:59.21,0:21:02.46,Default,,0,0,0,,Бір күні ойын-сауық таныс әрі қызықты нәрсеге айналады...
Dialogue: 0,0:21:03.26,0:21:04.72,Default,,0,0,0,,Ал егер...
Dialogue: 0,0:21:06.89,0:21:09.81,Default,,0,0,0,,Оқырмандар бұл ойын-сауыққа айналса ше?
Dialogue: 0,0:21:11.93,0:21:14.81,Default,,0,0,0,,Бұл кітап арқылы сіз көп ақша таба аласыз
Dialogue: 0,0:21:18.61,0:21:20.57,Default,,0,0,0,,Дәл қазір
Dialogue: 0,0:21:20.65,0:21:23.40,Default,,0,0,0,,Жоқ, мен туғаннан бері.
Dialogue: 0,0:21:23.49,0:21:27.20,Default,,0,0,0,,Адамдардың өмірін қинайтын қауымға сенімсіздік күшейеді.
Dialogue: 0,0:21:27.28,0:21:30.99,Default,,0,0,0,,Бұл кітап адамдардың ойлауын түбегейлі өзгертеді.
Dialogue: 0,0:21:31.66,0:21:33.66,Default,,0,0,0,,қабылдануы мүмкін
Dialogue: 0,0:21:34.87,0:21:38.58,Default,,0,0,0,,Кітап мазмұны Шіркеу билігі шайқалған кез
Dialogue: 0,0:21:38.67,0:21:40.17,Default,,0,0,0,,Екі бар
Dialogue: 0,0:21:40.25,0:21:41.59,Default,,0,0,0,,Дегенмен, енді ғана не болды?
Dialogue: 0,0:21:42.80,0:21:44.80,Default,,0,0,0,,Өндіріс туралы не айтасыз?
Dialogue: 0,0:21:47.05,0:21:48.76,Default,,0,0,0,,Қолжазба?
Dialogue: 0,0:21:49.26,0:21:52.18,Default,,0,0,0,,Жоқ, бұл тым көп уақытты алады.
Dialogue: 0,0:21:52.26,0:21:54.60,Default,,0,0,0,,Тағы бірдеңе...
Dialogue: 0,0:21:54.68,0:21:58.19,Default,,0,0,0,,Бір нәрсе Өндіріс құралдарының технологиясы болса
Dialogue: 0,0:21:58.94,0:21:59.98,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:22:01.27,0:22:04.07,Default,,0,0,0,,Дәлірек айтсақ, бұл...
Dialogue: 0,0:22:04.15,0:22:06.32,Default,,0,0,0,,Бұл кітап бұрыннан танымал емес пе?
Dialogue: 0,0:22:09.41,0:22:12.91,Default,,0,0,0,,Егер сіз бұл туралы қалыпты түрде ойласаңыз, бұл дұрыс.
Dialogue: 0,0:22:12.99,0:22:15.04,Default,,0,0,0,,Мен жай ғана білмеймін
Dialogue: 0,0:22:16.12,0:22:18.96,Default,,0,0,0,,Ха... Қандай толқу?
Dialogue: 0,0:22:20.67,0:22:24.30,Default,,0,0,0,,Бұл автор кім?
Dialogue: 0,0:22:24.38,0:22:26.30,Default,,0,0,0,,Бұл кітап қай дәуірге жатады?
Dialogue: 0,0:22:26.88,0:22:28.55,Default,,0,0,0,,Жазбаған
Dialogue: 0,0:22:32.01,0:22:36.56,Default,,0,0,0,,Оның үстіне бұл атау мәтінде де кездеспейді, бұл өте рас.
Dialogue: 0,0:22:36.64,0:22:38.23,Default,,0,0,0,,Мазмұн қауіпті болғандықтан ба?
Dialogue: 0,0:22:38.31,0:22:41.27,Default,,0,0,0,,Алайда соңында былай делінген:
Dialogue: 0,0:22:41.35,0:22:43.23,Default,,0,0,0,,«Қауіпсіз болғанда...»
Dialogue: 0,0:22:43.32,0:22:46.86,Default,,0,0,0,,«Табысыңыздың 10% Потоцукиге аударыңыз»
Dialogue: 0,0:22:46.94,0:22:49.15,Default,,0,0,0,,Мұқият хабарласыңыз
Dialogue: 0,0:22:49.65,0:22:51.20,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:22:51.28,0:22:53.70,Default,,0,0,0,,Ол автор емес сияқты...
Dialogue: 0,0:22:53.78,0:22:55.66,Default,,0,0,0,,Дурака, кел.
Dialogue: 0,0:22:55.74,0:22:57.00,Default,,0,0,0,,Ах
Dialogue: 0,0:22:57.08,0:23:00.08,Default,,0,0,0,,Ағай, бір қызық тыңдаңыз...
Dialogue: 0,0:23:00.17,0:23:01.00,Default,,0,0,0,,Әй?
Dialogue: 0,0:23:04.84,0:23:07.51,Default,,0,0,0,,Білемін, бірақ шынымен сабырымды сақтай аламын ба?
Dialogue: 0,0:23:08.09,0:23:09.01,Default,,0,0,0,,Бұл сен бе?
Dialogue: 0,0:23:09.09,0:23:10.22,Default,,0,0,0,,Иә
Dialogue: 0,0:23:11.55,0:23:14.26,Default,,0,0,0,,Бұл жақсы бағаға ие болуы мүмкін.
Dialogue: 0,0:23:16.81,0:23:17.77,Default,,0,0,0,,Иә
Dialogue: 0,0:23:18.85,0:23:22.02,Default,,0,0,0,,Тағдырыңды өзгерту деген осы ма?
Dialogue: 0,0:23:23.11,0:23:24.56,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:23:25.11,0:23:28.57,Default,,0,0,0,,Мен аман қалу үшін бәрін жасаймын
Dialogue: 0,0:23:30.99,0:23:35.99,Default,,0,0,0,,♪~
Dialogue: 0,0:24:54.15,0:24:59.16,Default,,0,0,0,,~♪
Dialogue: 0,0:25:00.66,0:25:06.66,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory