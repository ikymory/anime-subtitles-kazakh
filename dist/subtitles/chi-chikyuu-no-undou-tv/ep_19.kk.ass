Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.00,0:00:08.96,Default,,0,0,0,,Бұл біз, еретиктерді азат ету майданының жетекшісі.
Dialogue: 0,0:00:10.34,0:00:11.97,Default,,0,0,0,,Бұл Йолента.
Dialogue: 0,0:00:13.34,0:00:15.89,Default,,0,0,0,,Барлығының қауіпсіз екеніне қуаныштымын.
Dialogue: 0,0:00:19.85,0:00:23.35,Default,,0,0,0,,Мен бұл қыздың кім екенін білгім келеді.
Dialogue: 0,0:00:24.64,0:00:27.36,Default,,0,0,0,,Бұған дейін кітаптар ше?
Dialogue: 0,0:00:28.69,0:00:30.28,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:00:30.36,0:00:34.32,Default,,0,0,0,,Менің кемшілігім үшін ол мені өртеп жіберді.
Dialogue: 0,0:00:34.90,0:00:38.83,Default,,0,0,0,,Бірақ ол кітаптың мазмұнын жаттап алды.
Dialogue: 0,0:00:38.91,0:00:40.70,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:00:40.79,0:00:43.66,Default,,0,0,0,,Мен Дуракамын, маған қамқор болыңыз.
Dialogue: 0,0:00:46.42,0:00:47.83,Default,,0,0,0,,Иә
Dialogue: 0,0:00:47.92,0:00:51.59,Default,,0,0,0,,Жарайды, Дурака мырза, бір сәт осында келіңіз.
Dialogue: 0,0:00:53.80,0:00:54.72,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:57.43,0:01:02.18,Default,,0,0,0,,♪~
Dialogue: 0,0:02:21.55,0:02:25.93,Default,,0,0,0,,~♪
Dialogue: 0,0:02:40.32,0:02:41.82,Default,,0,0,0,,Эй
Dialogue: 0,0:02:43.28,0:02:48.20,Default,,0,0,0,,Бұл өте қиын. Мен бұл деңгейде ес-түссіз кете алмаймын.
Dialogue: 0,0:02:48.29,0:02:49.62,Default,,0,0,0,,Әй, Аш!
Dialogue: 0,0:02:49.71,0:02:50.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:50.62,0:02:52.13,Default,,0,0,0,,Саған бір нәрсе сұрасам бола ма?
Dialogue: 0,0:02:52.21,0:02:54.75,Default,,0,0,0,,Бұл дұрыс болды. Мен де сенімен сөйлестім.
Dialogue: 0,0:02:55.34,0:02:56.80,Default,,0,0,0,,Епископ Дамиан
Dialogue: 0,0:02:57.34,0:03:00.88,Default,,0,0,0,,Сіз мені тағы да өртеп жіберуге үкім шығардыңыз.
Dialogue: 0,0:03:00.97,0:03:03.14,Default,,0,0,0,,Қазірдің өзінде мұндай азаптау
Dialogue: 0,0:03:03.22,0:03:04.51,Default,,0,0,0,,Өте рахмет. Енді барамын.
Dialogue: 0,0:03:05.64,0:03:08.27,Default,,0,0,0,,Мен Папаға тікелей есеп беремін.
Dialogue: 0,0:03:08.35,0:03:11.90,Default,,0,0,0,,Маған бұл жұмыс үшін епископ ретінде сіздің рұқсатыңыз қажет емес.
Dialogue: 0,0:03:11.98,0:03:14.81,Default,,0,0,0,,Иә... иә.
Dialogue: 0,0:03:14.90,0:03:17.78,Default,,0,0,0,,Бірақ сіз тым радикалсыз.
Dialogue: 0,0:03:17.86,0:03:22.45,Default,,0,0,0,,Шешім жұмсақ жауап беру арқылы өкінуге ынталандыру болуы керек.
Dialogue: 0,0:03:23.24,0:03:25.66,Default,,0,0,0,,Ха... Мен көп жұмыс жасадым.
Dialogue: 0,0:03:26.24,0:03:27.54,Default,,0,0,0,,Бірақ бекер
Dialogue: 0,0:03:27.62,0:03:28.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:28.58,0:03:30.29,Default,,0,0,0,,Ал сіз тарихты ұмыттыңыз ба?
Dialogue: 0,0:03:31.00,0:03:35.84,Default,,0,0,0,,200 жыл бұрын құлшынысты монах тура жолды уағыздаған кезде.
Dialogue: 0,0:03:35.92,0:03:38.38,Default,,0,0,0,,Олар бидғатшылар тас лақтырды.
Dialogue: 0,0:03:38.46,0:03:42.80,Default,,0,0,0,,Шамамен сол уақытта папаның елшісі өлтірілген оқиға орын алды.
Dialogue: 0,0:03:43.38,0:03:46.55,Default,,0,0,0,,Мен оларға мейірімді жүзді көрсеткен бойда солай болады.
Dialogue: 0,0:03:47.10,0:03:49.31,Default,,0,0,0,,Тарихқа қарау керек
Dialogue: 0,0:03:49.39,0:03:50.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:50.52,0:03:53.65,Default,,0,0,0,,Бұл небәрі 200 жыл бұрын болған.
Dialogue: 0,0:03:53.73,0:03:56.77,Default,,0,0,0,,Баяғыда, 500 жыл бұрын
Dialogue: 0,0:03:56.86,0:03:59.86,Default,,0,0,0,,Архиепископ бақсылықпен айыпталғандарды емдейді.
Dialogue: 0,0:03:59.94,0:04:02.20,Default,,0,0,0,,Адамдарды топтық зорлық-зомбылықтан құтқару
Dialogue: 0,0:04:02.28,0:04:03.70,Default,,0,0,0,,400 жыл бұрын
Dialogue: 0,0:04:03.78,0:04:07.45,Default,,0,0,0,,Сиқыршы бола тұра Рим папасы қызметін атқарған адамдар бар.
Dialogue: 0,0:04:08.49,0:04:09.95,Default,,0,0,0,,Ескі шіркеу
Dialogue: 0,0:04:10.04,0:04:14.58,Default,,0,0,0,,Ол кейде бақсылық немесе бидғатқа күдікті адамдарға жұмсақ болды.
Dialogue: 0,0:04:15.08,0:04:18.46,Default,,0,0,0,,Сен неге сонша әлсізсің?
Dialogue: 0,0:04:18.54,0:04:19.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:19.67,0:04:23.68,Default,,0,0,0,,Дәл қазір реформаторлардың бидғатшылары мен олардың мұрагерлері
Dialogue: 0,0:04:23.76,0:04:26.01,Default,,0,0,0,,Православиеге шабуыл жасау
Dialogue: 0,0:04:26.09,0:04:28.05,Default,,0,0,0,,Барлық сенушілер алаңдайды.
Dialogue: 0,0:04:28.14,0:04:31.60,Default,,0,0,0,,Бұл жерде біз өз сенімімізді қорғай алмаймыз.
Dialogue: 0,0:04:31.68,0:04:33.48,Default,,0,0,0,,Дін қызметкері дегеніміз не?
Dialogue: 0,0:04:35.69,0:04:37.02,Default,,0,0,0,,Мен де...
Dialogue: 0,0:04:37.11,0:04:37.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:38.56,0:04:43.82,Default,,0,0,0,,Жас кезімде мен де сен сияқты миссияға құмар едім.
Dialogue: 0,0:04:44.49,0:04:48.20,Default,,0,0,0,,Бірақ ол ұзақ өмір сүрді, көп нәрсені көрді.
Dialogue: 0,0:04:48.28,0:04:49.83,Default,,0,0,0,,Мен түсіндім
Dialogue: 0,0:04:51.12,0:04:55.37,Default,,0,0,0,,Менің ойымша, әлем бұл жолмен жақсарып жатқан жоқ.
Dialogue: 0,0:04:56.50,0:04:58.17,Default,,0,0,0,,Дұрыс айтасыз.
Dialogue: 0,0:04:58.25,0:05:02.46,Default,,0,0,0,,Шіркеу православиесінің күші қазір күрт төмендеді.
Dialogue: 0,0:05:03.01,0:05:04.72,Default,,0,0,0,,Бірақ төбелес туралы не деуге болады?
Dialogue: 0,0:05:06.09,0:05:10.72,Default,,0,0,0,,Өзгелерді өлтірме, өзің өліп шіркеуді қорға
Dialogue: 0,0:05:11.51,0:05:15.14,Default,,0,0,0,,Азаптау мен қорқынышқа негізделген құтқару жоқ.
Dialogue: 0,0:05:15.23,0:05:17.60,Default,,0,0,0,,Басқаша ойлайтындарды жақсы көр Ах...
Dialogue: 0,0:05:18.77,0:05:19.98,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:05:21.27,0:05:22.53,Default,,0,0,0,,Оны батырыңыз
Dialogue: 0,0:05:24.65,0:05:26.40,Default,,0,0,0,,Бар болғаны осы ма?
Dialogue: 0,0:05:27.41,0:05:29.12,Default,,0,0,0,,Енді менің кезегім.
Dialogue: 0,0:05:29.74,0:05:33.37,Default,,0,0,0,,Өткен күні біздің инквизицияға шабуыл жасалды.
Dialogue: 0,0:05:33.45,0:05:36.87,Default,,0,0,0,,Он күзетші мен инквизитор өлтірілді.
Dialogue: 0,0:05:36.96,0:05:38.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:38.12,0:05:41.54,Default,,0,0,0,,Модус операндына қарағанда, кінәлі ереттерді азат ету майданы болуы керек.
Dialogue: 0,0:05:42.17,0:05:44.76,Default,,0,0,0,,Дегенмен, алаңдататын нәрсе бар.
Dialogue: 0,0:05:45.51,0:05:49.14,Default,,0,0,0,,Олар тәркіленген кітаптарды ұрлады.
Dialogue: 0,0:05:49.22,0:05:51.39,Default,,0,0,0,,Кітап? Не?
Dialogue: 0,0:05:52.18,0:05:54.39,Default,,0,0,0,,Бұл «гелиоцентрлік теория» деп аталады.
Dialogue: 0,0:05:54.47,0:05:55.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:55.73,0:05:59.06,Default,,0,0,0,,Кітаптың өзі бір жылдай бұрын тәркіленген.
Dialogue: 0,0:05:59.15,0:06:01.65,Default,,0,0,0,,Қараусыз қалған ауылдағы шіркеуден табылған
Dialogue: 0,0:06:02.19,0:06:04.32,Default,,0,0,0,,Бұл өте ескі сияқты.
Dialogue: 0,0:06:04.40,0:06:07.78,Default,,0,0,0,,Оның қашан және кім жазғаны туралы мәлімет болған жоқ.
Dialogue: 0,0:06:07.86,0:06:12.24,Default,,0,0,0,,Жалғыз түйін – сөйлем соңындағы сөйлем мен мекен.
Dialogue: 0,0:06:13.03,0:06:15.12,Default,,0,0,0,,«Потоцкиге қайырымдылық жасау»
Dialogue: 0,0:06:15.20,0:06:16.62,Default,,0,0,0,,Ах
Dialogue: 0,0:06:16.70,0:06:18.21,Default,,0,0,0,,Дегенмен, зерттегеннен кейін
Dialogue: 0,0:06:18.29,0:06:21.50,Default,,0,0,0,,Потоцуки есімді адам баяғыда қайтыс болды.
Dialogue: 0,0:06:21.58,0:06:22.96,Default,,0,0,0,,Қазіргі уақытта мекенжай
Dialogue: 0,0:06:23.04,0:06:26.67,Default,,0,0,0,,Онда бір-біріне мүлдем қатысы жоқ азаматтар тұрады.
Dialogue: 0,0:06:27.38,0:06:28.84,Default,,0,0,0,,Жұмбақ сияқты
Dialogue: 0,0:06:30.26,0:06:35.10,Default,,0,0,0,,Потоцкий гелиоцентрлік теорияны зерттеп, қолға түсті.
Dialogue: 0,0:06:35.18,0:06:36.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:36.31,0:06:42.27,Default,,0,0,0,,Кейінірек оның шәкірті мен асырап алған ұлы да гелиоцентризмнен қайтыс болды.
Dialogue: 0,0:06:42.36,0:06:45.98,Default,,0,0,0,,Бұл мен де 35 жыл бұрын қараған іс.
Dialogue: 0,0:06:46.07,0:06:47.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:47.28,0:06:49.86,Default,,0,0,0,,Бірақ неге қазір?
Dialogue: 0,0:06:49.95,0:06:51.49,Default,,0,0,0,,Оны кім жазды?
Dialogue: 0,0:06:51.57,0:06:52.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:52.62,0:06:54.58,Default,,0,0,0,,Мен бұл ауылдың екі жігіті...
Dialogue: 0,0:06:55.28,0:06:58.79,Default,,0,0,0,,Жоқ, олар 25 жыл бұрын қайтыс болуы керек еді.
Dialogue: 0,0:06:58.87,0:07:02.17,Default,,0,0,0,,Менің сұрайын дегенім осы болды
Dialogue: 0,0:07:02.25,0:07:05.59,Default,,0,0,0,,Тергеу жүргізген кезде бізге космологиядан хабары бар адам керек.
Dialogue: 0,0:07:05.67,0:07:06.96,Default,,0,0,0,,А...
Dialogue: 0,0:07:07.05,0:07:09.34,Default,,0,0,0,,Біреу біледі ме?
Dialogue: 0,0:07:11.59,0:07:13.59,Default,,0,0,0,,Космология...
Dialogue: 0,0:07:18.60,0:07:23.35,Default,,0,0,0,,Қаланың шетіндегі барда бұрынғы инквизитор бар.
Dialogue: 0,0:07:24.19,0:07:26.48,Default,,0,0,0,,Мм... кешіріңіз.
Dialogue: 0,0:07:27.07,0:07:29.40,Default,,0,0,0,,Маған епископ Дэмиен айтты
Dialogue: 0,0:07:33.07,0:07:35.49,Default,,0,0,0,,Сіз Новак мырзасыз ба?
Dialogue: 0,0:07:36.33,0:07:37.99,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:07:40.62,0:07:44.54,Default,,0,0,0,,Не? О, менің атым Аш, мен инквизитормын.
Dialogue: 0,0:07:44.63,0:07:45.88,Default,,0,0,0,,
Dialogue: 0,0:07:46.75,0:07:48.71,Default,,0,0,0,,- (Новак) ликер -?
Dialogue: 0,0:07:48.80,0:07:51.30,Default,,0,0,0,,Маған алкоголь сатып ала аласыз ба?
Dialogue: 0,0:07:51.88,0:07:55.30,Default,,0,0,0,,Е, жоқ, біз жұмыс туралы айтып жатырмыз, сондықтан мен арақ іше алмаймын.
Dialogue: 0,0:07:55.39,0:07:58.26,Default,,0,0,0,,(Новактың қорылдауы)
Dialogue: 0,0:07:58.35,0:07:59.39,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:00.06,0:08:00.89,Default,,0,0,0,,Уау
Dialogue: 0,0:08:00.98,0:08:02.89,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:08:02.98,0:08:04.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:04.90,0:08:06.40,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:08:09.15,0:08:11.78,Default,,0,0,0,,Мен инквизитор Эшмін
Dialogue: 0,0:08:11.86,0:08:15.45,Default,,0,0,0,,Жақында болған оқиғаға қатысты сізден ынтымақтастық сұраймыз.
Dialogue: 0,0:08:15.53,0:08:20.91,Default,,0,0,0,,Иә? Инквизитор? Сіз?
Dialogue: 0,0:08:21.00,0:08:22.00,Default,,0,0,0,,Иә
Dialogue: 0,0:08:22.08,0:08:23.41,Default,,0,0,0,,Уау
Dialogue: 0,0:08:23.50,0:08:25.88,Default,,0,0,0,,Не, сен инквизиторсың ба?
Dialogue: 0,0:08:25.96,0:08:27.59,Default,,0,0,0,,Ол кіші.
Dialogue: 0,0:08:28.17,0:08:30.09,Default,,0,0,0,,Сіз жассыз, солай ма?
Dialogue: 0,0:08:31.01,0:08:33.72,Default,,0,0,0,,Ал, мен саған ерекше бір нәрсе айтайын.
Dialogue: 0,0:08:34.22,0:08:37.60,Default,,0,0,0,,Енді епископ Дэмиан бар.
Dialogue: 0,0:08:38.18,0:08:41.35,Default,,0,0,0,,Бұл менің бағыныштым.
Dialogue: 0,0:08:42.02,0:08:45.48,Default,,0,0,0,,Өйткені маған бұрыннан қамқор болғаныңыз үшін сізге қарыздармын.
Dialogue: 0,0:08:45.56,0:08:50.02,Default,,0,0,0,,Енді ол мені жеке жұмысқа алады.
Dialogue: 0,0:08:50.11,0:08:55.40,Default,,0,0,0,,Осылайша мен жұмыс істемей-ақ жалақы алатын лауазымға ие болдым.
Dialogue: 0,0:08:55.49,0:08:58.99,Default,,0,0,0,,Түсіндің бе? Маған жұмыс істеудің қажеті жоқ
Dialogue: 0,0:09:00.70,0:09:03.37,Default,,0,0,0,,Сондықтан жұмыс туралы сөз жоқ.
Dialogue: 0,0:09:03.96,0:09:05.54,Default,,0,0,0,,Қайта оралыңыз.
Dialogue: 0,0:09:05.62,0:09:08.63,Default,,0,0,0,,Алкогольді сатып алмайтын адамдарға пайда жоқ.
Dialogue: 0,0:09:09.21,0:09:12.09,Default,,0,0,0,,Мен мұнда Дэмиан мырза өтінгендіктен келдім.
Dialogue: 0,0:09:12.17,0:09:14.92,Default,,0,0,0,,Иә, үйге қайт
Dialogue: 0,0:09:16.72,0:09:19.22,Default,,0,0,0,,Адамдардың тарихы бар
Dialogue: 0,0:09:19.30,0:09:23.10,Default,,0,0,0,,Ол сондай-ақ гелиоцентрлік теорияның жетегінде кеткен адам болды.
Dialogue: 0,0:09:24.43,0:09:28.48,Default,,0,0,0,,35 жыл бұрын сіз гелиоцентризм ісін басқардыңыз.
Dialogue: 0,0:09:32.48,0:09:33.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:33.57,0:09:36.70,Default,,0,0,0,,Сіз космологияның маманысыз, солай ма?
Dialogue: 0,0:09:36.78,0:09:40.24,Default,,0,0,0,,Бір күні инквизициядан кітап ұрланды.
Dialogue: 0,0:09:41.24,0:09:45.91,Default,,0,0,0,,Бұл сіз бұрын қараған іске қатысты болуы мүмкін.
Dialogue: 0,0:09:47.04,0:09:48.50,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:09:49.29,0:09:51.13,Default,,0,0,0,,Бірақ бұл шындық
Dialogue: 0,0:09:52.17,0:09:53.50,Default,,0,0,0,,...
Dialogue: 0,0:09:53.59,0:09:55.26,Default,,0,0,0,,-Бірақ... -(Новак) Үйге қайт!
Dialogue: 0,0:10:00.09,0:10:02.26,Default,,0,0,0,,(Экхарт) Кторигалга басып кірген бейбітшілікке қарсы күштер—
Dialogue: 0,0:10:03.56,0:10:06.14,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:10:12.27,0:10:13.65,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:10:14.98,0:10:16.65,Default,,0,0,0,,Бұл қазірге дейін аяқталуы керек.
Dialogue: 0,0:10:22.91,0:10:26.95,Default,,0,0,0,,Мен оны баяғыда бітірдім
Dialogue: 0,0:10:28.16,0:10:32.71,Default,,0,0,0,,Бірақ енді ол өмірге қайтады дейсіз бе?
Dialogue: 0,0:10:34.21,0:10:35.34,Default,,0,0,0,,Менің...
Dialogue: 0,0:10:36.80,0:10:40.18,Default,,0,0,0,,Қызымды алып кет
Dialogue: 0,0:10:41.84,0:10:43.97,Default,,0,0,0,,Жау – айбатты.
Dialogue: 0,0:10:47.06,0:10:48.64,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:10:50.98,0:10:53.90,Default,,0,0,0,,Не? Бұл жай ғана мас емес пе?
Dialogue: 0,0:10:55.94,0:10:57.07,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:10:57.15,0:10:57.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:00.45,0:11:03.24,Default,,0,0,0,,Не? Аа... сәлем
Dialogue: 0,0:11:03.32,0:11:05.41,Default,,0,0,0,,Сіз күдіктілерді қысқарттыңыз ба?
Dialogue: 0,0:11:05.91,0:11:08.29,Default,,0,0,0,,ше? Е... иә
Dialogue: 0,0:11:08.37,0:11:11.50,Default,,0,0,0,,Қылмысты еретиктерді азат ету майданы жасаған болуы мүмкін.
Dialogue: 0,0:11:12.38,0:11:14.88,Default,,0,0,0,,Маған тергеумен ынтымақтасуға рұқсат етіңіз.
Dialogue: 0,0:11:14.96,0:11:16.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:16.71,0:11:20.09,Default,,0,0,0,,Мен сол азаттық майданы туралы ақпарат алғым келеді.
Dialogue: 0,0:11:20.17,0:11:22.39,Default,,0,0,0,,Ұйым басшысы белгілі ме?
Dialogue: 0,0:11:22.47,0:11:27.14,Default,,0,0,0,,Иә, ақпарат қарама-қайшы, бірақ әйел адам шығар.
Dialogue: 0,0:11:27.22,0:11:30.43,Default,,0,0,0,,А... бұл қайғылы.
Dialogue: 0,0:11:30.52,0:11:34.06,Default,,0,0,0,,Ол қауіпсіз өмір сүре алар еді.
Dialogue: 0,0:11:35.31,0:11:37.11,Default,,0,0,0,,Бетті кім көрді?
Dialogue: 0,0:11:37.19,0:11:38.57,Default,,0,0,0,,Неше адам бар?
Dialogue: 0,0:11:38.65,0:11:41.61,Default,,0,0,0,,Айғақ бойынша тістері жоқ.
Dialogue: 0,0:11:41.70,0:11:44.32,Default,,0,0,0,,Әй, сен ақымақсың.
Dialogue: 0,0:11:44.41,0:11:47.37,Default,,0,0,0,,Бірақ олардың қайда қашқанын білмейміз.
Dialogue: 0,0:11:47.45,0:11:48.87,Default,,0,0,0,,Мақсаты да белгісіз
Dialogue: 0,0:11:48.95,0:11:51.08,Default,,0,0,0,,Олар бидғатшыларды азат етеді
Dialogue: 0,0:11:51.16,0:11:54.38,Default,,0,0,0,,Неліктен бұл жолы кітапты мақсат еттіңіз?
Dialogue: 0,0:11:55.04,0:11:56.17,Default,,0,0,0,,Хмм…
Dialogue: 0,0:11:56.67,0:12:00.38,Default,,0,0,0,,Қиындыққа тап болған кезде, алдымен өз болжамдарыңызға күмән келтіріңіз.
Dialogue: 0,0:12:01.05,0:12:02.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:02.13,0:12:05.14,Default,,0,0,0,,Мақсат – бидғатты босату емес
Dialogue: 0,0:12:05.22,0:12:07.51,Default,,0,0,0,,Оны құрал деп есептейік.
Dialogue: 0,0:12:08.31,0:12:10.27,Default,,0,0,0,,Олардың шынайы мақсаты
Dialogue: 0,0:12:10.35,0:12:14.27,Default,,0,0,0,,Шіркеу православиелігін жою болса
Dialogue: 0,0:12:14.85,0:12:17.90,Default,,0,0,0,,Ол үшін кітаптарды тиімді пайдалануға болады.
Dialogue: 0,0:12:17.98,0:12:23.70,Default,,0,0,0,,Өйткені кітаптар адамдардың ойын тиімді өзгерте алады.
Dialogue: 0,0:12:24.20,0:12:27.03,Default,,0,0,0,,Уағыз айтудан әлдеқайда жақсы
Dialogue: 0,0:12:27.12,0:12:29.66,Default,,0,0,0,,Бірақ қолжазбалар қиындық туғызбайды ма?
Dialogue: 0,0:12:29.74,0:12:35.17,Default,,0,0,0,,Эш мырза, егер сіз инквизитор болсаңыз, соңғы технологияға мұқият назар аударуыңыз керек.
Dialogue: 0,0:12:35.25,0:12:36.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:36.38,0:12:40.46,Default,,0,0,0,,Ең жаңа технология алдымен зұлымдық үшін қолданылады.
Dialogue: 0,0:12:40.55,0:12:46.93,Default,,0,0,0,,Бұл жағдайда кітаптарды оңай жаппай шығара алатын әріптік басып шығару тартылуы мүмкін.
Dialogue: 0,0:12:47.64,0:12:51.56,Default,,0,0,0,,Яғни, сол гипотезаларды біріктіретін болсақ,
Dialogue: 0,0:12:52.18,0:12:56.56,Default,,0,0,0,,Олар бұл жолы кітап шығаруы мүмкін.
Dialogue: 0,0:12:56.65,0:12:57.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:57.81,0:13:02.94,Default,,0,0,0,,Қарсылығыңыз болмаса, дереу принтерден және жазу машинкасынан сұраңыз.
Dialogue: 0,0:13:03.03,0:13:07.95,Default,,0,0,0,,Олар кептеліп қалмас үшін құрал-жабдықтарын өздері жасаған болуы мүмкін.
Dialogue: 0,0:13:08.03,0:13:10.70,Default,,0,0,0,,Соңғы кезде жүзім сығымдары т.б.
Dialogue: 0,0:13:10.78,0:13:14.91,Default,,0,0,0,,Қорғасынның көп мөлшерін алған адамның бар-жоғын табыңыз.
Dialogue: 0,0:13:15.00,0:13:16.42,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:13:17.42,0:13:20.84,Default,,0,0,0,,Ах... Ынтымақтастық үшін рахмет.
Dialogue: 0,0:13:20.92,0:13:21.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:22.05,0:13:26.34,Default,,0,0,0,,Мен егжей-тегжейлі білмеймін, бірақ өткенде әртүрлі оқиғалар болғанын естідім.
Dialogue: 0,0:13:27.05,0:13:29.89,Default,,0,0,0,,Шынымды айтсам, мен сізді төмен бағаладым.
Dialogue: 0,0:13:29.97,0:13:33.35,Default,,0,0,0,,Бірақ бидғатты жеңу үшін осылай тұру үшін.
Dialogue: 0,0:13:33.43,0:13:35.23,Default,,0,0,0,,Өте сенімді
Dialogue: 0,0:13:36.44,0:13:39.02,Default,,0,0,0,,Олар жай ғана айла-шарғы жасауда
Dialogue: 0,0:13:39.10,0:13:41.23,Default,,0,0,0,,Құрбанның бір түрі.
Dialogue: 0,0:13:41.73,0:13:44.19,Default,,0,0,0,,Олар нағыз жау емес
Dialogue: 0,0:13:44.28,0:13:45.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:46.03,0:13:49.24,Default,,0,0,0,,Бұл менің миссиям
Dialogue: 0,0:13:49.32,0:13:51.24,Default,,0,0,0,,Бұл менің тағдырым
Dialogue: 0,0:13:52.54,0:13:56.83,Default,,0,0,0,,Бұл өмір біткенше, қайда барсаң да қуамын.
Dialogue: 0,0:13:56.91,0:13:59.00,Default,,0,0,0,,Барлық зұлымдықтың тамыры
Dialogue: 0,0:14:00.25,0:14:03.96,Default,,0,0,0,,Гелиоцентрлік теорияны жойыңыз!
Dialogue: 0,0:14:11.72,0:14:13.22,Default,,0,0,0,,Қозғалмаңыз
Dialogue: 0,0:14:13.89,0:14:15.52,Default,,0,0,0,,Себебі мен саған сенбеймін
Dialogue: 0,0:14:18.77,0:14:20.77,Default,,0,0,0,,Кітапты не үшін өртеп жібердің?
Dialogue: 0,0:14:23.98,0:14:27.15,Default,,0,0,0,,Мен бұл кітаптың артында не жатқанын білгім келді.
Dialogue: 0,0:14:27.86,0:14:30.16,Default,,0,0,0,,Оны күйдірмей жүре алмадым.
Dialogue: 0,0:14:30.99,0:14:32.91,Default,,0,0,0,,Бұл кітап не үшін қажет?
Dialogue: 0,0:14:32.99,0:14:36.54,Default,,0,0,0,,Мен мұны пайдаланып көп ақша табамын деп ойладым.
Dialogue: 0,0:14:37.12,0:14:41.13,Default,,0,0,0,,Балалар, тіпті баспа машиналары да бар.
Dialogue: 0,0:14:41.21,0:14:43.13,Default,,0,0,0,,Сіз бұл мүмкіндікті жіберіп алмайсыз
Dialogue: 0,0:14:43.63,0:14:45.55,Default,,0,0,0,,-Иә -иә?
Dialogue: 0,0:14:45.63,0:14:50.01,Default,,0,0,0,,Кітаптың мазмұнына айырбас ретінде мен осы кітаптан түсетін пайданың 20% алғым келеді.
Dialogue: 0,0:14:50.09,0:14:51.80,Default,,0,0,0,,Сіз оны қарастырасыз ба?
Dialogue: 0,0:14:53.39,0:14:54.56,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:55.26,0:14:57.73,Default,,0,0,0,,Сізді сыпайы деп жиі айтпайсыз ба?
Dialogue: 0,0:14:58.43,0:15:00.60,Default,,0,0,0,,Ақша шынымен де соншалықты маңызды ма?
Dialogue: 0,0:15:02.31,0:15:03.36,Default,,0,0,0,,Иә
Dialogue: 0,0:15:04.57,0:15:05.77,Default,,0,0,0,,Иә
Dialogue: 0,0:15:05.86,0:15:08.44,Default,,0,0,0,,Олай болса, мен де маңызды нәрсе айтайын.
Dialogue: 0,0:15:09.11,0:15:11.20,Default,,0,0,0,,Нені өртеп жібердің
Dialogue: 0,0:15:11.28,0:15:14.66,Default,,0,0,0,,Оны менің ескі досым жазған шығар.
Dialogue: 0,0:15:16.54,0:15:21.33,Default,,0,0,0,,Егер солай болса, бұл мен үшін өте маңызды.
Dialogue: 0,0:15:21.42,0:15:25.96,Default,,0,0,0,,Оның бар екенін білгенде, қатты таңғалғаным сонша, қызуым көтерілді.
Dialogue: 0,0:15:29.42,0:15:33.89,Default,,0,0,0,,Сондықтан мен оның ақша табу құралы болғанын қаламаймын.
Dialogue: 0,0:15:33.97,0:15:36.35,Default,,0,0,0,,Бұл ысырап
Dialogue: 0,0:15:37.26,0:15:38.35,Default,,0,0,0,,Келіңіз
Dialogue: 0,0:15:43.15,0:15:45.98,Default,,0,0,0,,Осы уақытта әлі де жұлдыздар қалды.
Dialogue: 0,0:15:47.07,0:15:48.65,Default,,0,0,0,,Сіз планеталарды тани аласыз ба?
Dialogue: 0,0:15:49.53,0:15:51.74,Default,,0,0,0,,Иә, жақсы
Dialogue: 0,0:15:52.53,0:15:54.82,Default,,0,0,0,,Сатурнды сол жерден көруге болады.
Dialogue: 0,0:15:55.70,0:15:56.62,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:15:56.70,0:16:00.66,Default,,0,0,0,,Әрбір планетаның алға жылжу жылдамдығы әртүрлі.
Dialogue: 0,0:16:00.75,0:16:03.58,Default,,0,0,0,,Сол Сатурн сол жерде болған күйде болды.
Dialogue: 0,0:16:03.67,0:16:05.46,Default,,0,0,0,,Бұл қанша уақыт бұрын болды деп ойлайсыз?
Dialogue: 0,0:16:06.54,0:16:07.38,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:16:08.71,0:16:10.34,Default,,0,0,0,,30 жыл бұрын
Dialogue: 0,0:16:11.59,0:16:15.72,Default,,0,0,0,,Ол жұлдыз болған кезде мен 9 жаста едім
Dialogue: 0,0:16:15.80,0:16:17.72,Default,,0,0,0,,Мен геометрияға құмар болдым.
Dialogue: 0,0:16:19.43,0:16:23.64,Default,,0,0,0,,5 жылдан кейін мен гелиоцентристік теориямен 14 жасымда кездестім.
Dialogue: 0,0:16:25.23,0:16:29.98,Default,,0,0,0,,Алты жылдан кейін 20 жасында ол өзінің бірінші адамын өлтірді.
Dialogue: 0,0:16:30.82,0:16:34.99,Default,,0,0,0,,Ал қазір 39 жасымда мен сені кездестірдім.
Dialogue: 0,0:16:35.07,0:16:37.45,Default,,0,0,0,,Сатурн аспанды бір рет айналып өтті
Dialogue: 0,0:16:40.16,0:16:43.41,Default,,0,0,0,,Сатурн – планеталардың ішіндегі ең баяуы
Dialogue: 0,0:16:43.50,0:16:47.92,Default,,0,0,0,,Оның себебі күннен ең алыс орналасқандықтан болса керек.
Dialogue: 0,0:16:48.59,0:16:51.26,Default,,0,0,0,,Жылдамдық қашықтыққа байланысты өзгереді
Dialogue: 0,0:16:51.34,0:16:57.68,Default,,0,0,0,,Әлем реттелген және дәл және логикалық түрде алға жылжуда.
Dialogue: 0,0:16:58.51,0:17:01.52,Default,,0,0,0,,Оқыған гелиоцентрлік теорияны қарастыру
Dialogue: 0,0:17:01.60,0:17:04.35,Default,,0,0,0,,Құдайдың ұлы істері көрінеді
Dialogue: 0,0:17:06.56,0:17:07.90,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:17:08.94,0:17:10.73,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:17:11.32,0:17:14.70,Default,,0,0,0,,Кешіріңіз, бірақ сіз не туралы айтып отырсыз?
Dialogue: 0,0:17:17.45,0:17:18.70,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:17:19.20,0:17:20.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:21.33,0:17:25.33,Default,,0,0,0,,Менің «әсерімді» үмітсіз жеткізу
Dialogue: 0,0:17:27.46,0:17:31.38,Default,,0,0,0,,А-а... Ендеше, маған мұны неге айтып тұрсың?
Dialogue: 0,0:17:32.63,0:17:35.22,Default,,0,0,0,,Менің білуімше, сізді
Dialogue: 0,0:17:35.30,0:17:38.89,Default,,0,0,0,,Ол кітапты мен ғана оқығанмын
Dialogue: 0,0:17:38.97,0:17:42.77,Default,,0,0,0,,Мен гелиоцентрлік теория туралы білетін санаулы адамдардың бірімін.
Dialogue: 0,0:17:42.85,0:17:46.27,Default,,0,0,0,,Қарапайым тілмен айтқанда, қандай да бір себептермен қазір...
Dialogue: 0,0:17:47.19,0:17:49.69,Default,,0,0,0,,Өйткені сен екеуміз кездестік
Dialogue: 0,0:17:52.40,0:17:55.49,Default,,0,0,0,,Мен сезінген құндылықты айтайын.
Dialogue: 0,0:17:56.20,0:17:58.16,Default,,0,0,0,,Ақша табудан басқа.
Dialogue: 0,0:17:59.28,0:18:02.49,Default,,0,0,0,,Бұл өте жақсы.
Dialogue: 0,0:18:03.04,0:18:05.62,Default,,0,0,0,,Олай болса, мен де сізге сұрақ қоя аламын ба?
Dialogue: 0,0:18:05.70,0:18:09.92,Default,,0,0,0,,Сіз ақша табуды жек көретін сияқтысыз, бірақ сіз не істейсіз?
Dialogue: 0,0:18:11.25,0:18:15.42,Default,,0,0,0,,Адамдарды өлтіру, бидғатшыларды босату және қоғамды бұзу
Dialogue: 0,0:18:15.51,0:18:17.55,Default,,0,0,0,,Бұл комплимент пе?
Dialogue: 0,0:18:18.47,0:18:19.59,Default,,0,0,0,,Жоқ
Dialogue: 0,0:18:20.18,0:18:21.93,Default,,0,0,0,,Бірақ тартынбаңыз.
Dialogue: 0,0:18:22.68,0:18:24.89,Default,,0,0,0,,Мен оны қайтарып жатырмын
Dialogue: 0,0:18:25.52,0:18:28.77,Default,,0,0,0,,Шіркеу тартып алған бостандық пен өмір
Dialogue: 0,0:18:30.40,0:18:32.82,Default,,0,0,0,,Әке мен дос
Dialogue: 0,0:18:33.77,0:18:37.57,Default,,0,0,0,,Жеке бас бостандығын шектейтін билікті құлату керек
Dialogue: 0,0:18:38.57,0:18:41.07,Default,,0,0,0,,Бірақ сіз үшін де солай емес пе?
Dialogue: 0,0:18:42.41,0:18:45.58,Default,,0,0,0,,Басқаша айтқанда, билікте пайда болатын ойлауды тоқтату
Dialogue: 0,0:18:45.66,0:18:47.83,Default,,0,0,0,,Дін ғана емес
Dialogue: 0,0:18:47.91,0:18:51.13,Default,,0,0,0,,Бұл да академияда болатын нәрсе емес пе?
Dialogue: 0,0:18:52.79,0:18:53.63,Default,,0,0,0,,Жоқ
Dialogue: 0,0:18:54.50,0:18:57.76,Default,,0,0,0,,Мен айтқым келеді... бірақ бұл рас шығар.
Dialogue: 0,0:18:59.55,0:19:02.59,Default,,0,0,0,,Мен де талай рет адамдарды өлтірдім.
Dialogue: 0,0:19:02.68,0:19:06.31,Default,,0,0,0,,Шындықты қалқан ретінде пайдаланып, зорлық-зомбылық үдей түсетіні рас.
Dialogue: 0,0:19:06.85,0:19:11.52,Default,,0,0,0,,Мүмкін мен гелиоцентристік теорияның беделіне сенетін шығармын.
Dialogue: 0,0:19:11.60,0:19:14.65,Default,,0,0,0,,Сіздің бағынышты адамыңыз ойланбай-ақ соңынан еруі мүмкін.
Dialogue: 0,0:19:16.44,0:19:20.74,Default,,0,0,0,,Одан да өкініштісі, бұл сөзсіз.
Dialogue: 0,0:19:20.82,0:19:25.03,Default,,0,0,0,,Басқаша айтқанда, сіз бірдеңені болжамайынша логика жасай алмайсыз.
Dialogue: 0,0:19:25.12,0:19:28.37,Default,,0,0,0,,Адам парасатының маңызды шегі ретінде
Dialogue: 0,0:19:28.45,0:19:32.17,Default,,0,0,0,,Сіз ойлаған кезде қандай да бір алғышарттар әрқашан шындыққа сәйкес келеді.
Dialogue: 0,0:19:32.25,0:19:34.79,Default,,0,0,0,,Ол сіз білмей тұрып, билікке айналады.
Dialogue: 0,0:19:35.84,0:19:39.13,Default,,0,0,0,,Мүмкін бұл шеңберден ешкім шыға алмайды.
Dialogue: 0,0:19:40.22,0:19:43.55,Default,,0,0,0,,Осындай жағдайда туындаған құмарлық
Dialogue: 0,0:19:43.64,0:19:46.31,Default,,0,0,0,,Қашқын деп атауға болатын траекториядан кейін
Dialogue: 0,0:19:46.39,0:19:51.31,Default,,0,0,0,,Кейде әдемі ерлік, кейде шіркін трагедия.
Dialogue: 0,0:19:52.48,0:19:55.27,Default,,0,0,0,,Бұл трагедия емес деп ойлауға қандай негіз бар?
Dialogue: 0,0:19:56.15,0:20:00.03,Default,,0,0,0,,Өйткені барар жерім – еркіндік деп есептеймін.
Dialogue: 0,0:20:00.11,0:20:01.78,Default,,0,0,0,,Еркіндікке қандай анықтама берілген?
Dialogue: 0,0:20:02.65,0:20:04.49,Default,,0,0,0,,Сол сұрақты қоя білу
Dialogue: 0,0:20:07.03,0:20:09.24,Default,,0,0,0,,Мүмкін мен көп сөйлеген шығармын.
Dialogue: 0,0:20:09.75,0:20:11.37,Default,,0,0,0,,Жақында қайтайық.
Dialogue: 0,0:20:14.63,0:20:16.54,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:20:16.63,0:20:17.84,Default,,0,0,0,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,0:20:17.92,0:20:18.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:18.88,0:20:21.55,Default,,0,0,0,,Қазір басып шығарғыңыз келе ме?
Dialogue: 0,0:20:22.22,0:20:25.89,Default,,0,0,0,,Жоқ, мен мұнда түрді жинау үшін келдім.
Dialogue: 0,0:20:25.97,0:20:28.39,Default,,0,0,0,,Келесіде баспа машинасы.
Dialogue: 0,0:20:28.47,0:20:30.18,Default,,0,0,0,,Қауіптің таралуы
Dialogue: 0,0:20:30.85,0:20:35.94,Default,,0,0,0,,Енді осы ең маңызды миссияның соңғы орны.
Dialogue: 0,0:20:36.69,0:20:37.56,Default,,0,0,0,,Хмм
Dialogue: 0,0:20:38.27,0:20:40.07,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:20:40.65,0:20:43.32,Default,,0,0,0,,Енді қайда барамыз...
Dialogue: 0,0:20:44.11,0:20:45.57,Default,,0,0,0,,Сіздің шарттарыңыз бойынша.
Dialogue: 0,0:20:46.49,0:20:48.74,Default,,0,0,0,,Сіз пайданың 20% бере алмайсыз.
Dialogue: 0,0:20:49.28,0:20:52.45,Default,,0,0,0,,Менің бұл кітаппен ақша табу ойым жоқ.
Dialogue: 0,0:20:54.33,0:20:57.54,Default,,0,0,0,,Бірақ егер бұл баспа машинасы болса, мен оны сізге бере аламын.
Dialogue: 0,0:20:57.63,0:20:58.46,Default,,0,0,0,,Ах
Dialogue: 0,0:20:59.75,0:21:02.97,Default,,0,0,0,,Нені сататыныңыз жаңа ашқандарыңызға байланысты.
Dialogue: 0,0:21:03.80,0:21:08.22,Default,,0,0,0,,Жағдайы жаман емес деп ойлаймын, бірақ сіз қалай ойлайсыз?
Dialogue: 0,0:21:11.47,0:21:14.23,Default,,0,0,0,,Иә, өтінемін.
Dialogue: 0,0:21:14.85,0:21:15.81,Default,,0,0,0,,Иә
Dialogue: 0,0:21:18.48,0:21:19.31,Default,,0,0,0,,♪ Ка-та-на
Dialogue: 0,0:21:20.07,0:21:22.07,Default,,0,0,0,,Кітап не туралы екенін айтыңыз.
Dialogue: 0,0:21:22.94,0:21:27.28,Default,,0,0,0,,Мен де ұзақ уақыттан кейін ескі досымды қайта жолағым келеді.
Dialogue: 0,0:21:28.78,0:21:29.70,Default,,0,0,0,,Иә
Dialogue: 0,0:21:32.04,0:21:34.00,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:21:35.54,0:21:37.29,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:22:06.53,0:22:07.99,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:22:13.74,0:22:17.75,Default,,0,0,0,,Өйткені, әріптер – ғажайып.
Dialogue: 0,0:22:17.83,0:22:19.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:20.00,0:22:22.04,Default,,0,0,0,,Ойланып қарасам, естімеппін.
Dialogue: 0,0:22:22.13,0:22:23.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:24.34,0:22:26.63,Default,,0,0,0,,Неліктен сонша көп ақша тапқыңыз келеді?
Dialogue: 0,0:22:29.18,0:22:33.10,Default,,0,0,0,,Өйткені бұл менің сенімім.
Dialogue: 0,0:22:34.43,0:22:36.14,Default,,0,0,0,,маңызды.
Dialogue: 0,0:22:36.81,0:22:41.56,Default,,0,0,0,,Бірақ мен кейде өз сенімдерімді ұмыттыратын нәрсеге тап боламын.
Dialogue: 0,0:22:42.06,0:22:44.86,Default,,0,0,0,,Сол сезімдерді де бағалау керек
Dialogue: 0,0:22:44.94,0:22:45.78,Default,,0,0,0,,Егер біз оны қусақ, біз…
Dialogue: 0,0:22:48.32,0:22:49.53,Default,,0,0,0,,болмаса?
Dialogue: 0,0:22:51.03,0:22:52.78,Default,,0,0,0,,Мен сияқты бол
Dialogue: 0,0:22:55.99,0:22:58.71,Default,,0,0,0,,Сенім тез қарғысқа айналады
Dialogue: 0,0:22:58.79,0:23:02.54,Default,,0,0,0,,Бұл менің күшім және менің шегім.
Dialogue: 0,0:23:03.34,0:23:06.80,Default,,0,0,0,,Бірақ сеніміңді ұмытсаң, адамдар адасып кетеді.
Dialogue: 0,0:23:09.05,0:23:10.18,Default,,0,0,0,,Жоғалған
Dialogue: 0,0:23:10.26,0:23:11.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:12.39,0:23:15.14,Default,,0,0,0,,Шатасуда этика бар екені сөзсіз
Dialogue: 0,0:23:30.99,0:23:35.99,Default,,0,0,0,,♪~
Dialogue: 0,0:24:54.03,0:24:59.03,Default,,0,0,0,,~♪
Dialogue: 0,0:25:00.53,0:25:06.53,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory