Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.01,0:00:15.43,Default,,0,0,0,,Хигучи расталды.
Dialogue: 0,0:00:16.05,0:00:17.51,Default,,0,0,0,,Балалар сендер кімсіңдер?
Dialogue: 0,0:00:17.60,0:00:19.35,Default,,0,0,0,,Өтінемін, Ятоны құтқарыңдар!
Dialogue: 0,0:00:24.64,0:00:26.52,Default,,0,0,0,,Мен құю цехының шеберімін.
Dialogue: 0,0:00:26.60,0:00:27.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:28.69,0:00:30.90,Default,,0,0,0,,Менің жасым мен қолөнерші әйел.
Dialogue: 0,0:00:30.98,0:00:33.65,Default,,0,0,0,,Мен оны саяхатта жариялау үшін жіберемін.
Dialogue: 0,0:00:34.82,0:00:36.82,Default,,0,0,0,,Бұл сертификат
Dialogue: 0,0:00:37.74,0:00:39.20,Default,,0,0,0,,Хмм…
Dialogue: 0,0:00:44.25,0:00:46.04,Default,,0,0,0,,Неліктен қаруланған?
Dialogue: 0,0:00:46.12,0:00:48.29,Default,,0,0,0,,Қарақшыларға қарсы шаралар
Dialogue: 0,0:00:48.38,0:00:50.42,Default,,0,0,0,,Бұл аздап ыңғайсыздық туғызады.
Dialogue: 0,0:00:51.25,0:00:52.26,Default,,0,0,0,,Хо
Dialogue: 0,0:00:53.97,0:00:55.76,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:00:57.93,0:00:59.05,Default,,0,0,0,,Сәлем
Dialogue: 0,0:01:00.81,0:01:03.14,Default,,0,0,0,,Енді әрі қарай жүрейік.
Dialogue: 0,0:01:03.22,0:01:04.68,Default,,0,0,0,,Келесі шайқас үшін!
Dialogue: 0,0:01:06.64,0:01:09.27,Default,,0,0,0,,Сізде қажет емес мата бар ма?
Dialogue: 0,0:01:09.36,0:01:11.61,Default,,0,0,0,,Мен оны шыраққа орап алғым келеді
Dialogue: 0,0:01:12.19,0:01:14.03,Default,,0,0,0,,Сонымен мына жадағай
Dialogue: 0,0:01:14.11,0:01:17.03,Default,,0,0,0,,Жоқ, жоқ, мен онша сапалы нәрсе ала алмаймын.
Dialogue: 0,0:01:17.61,0:01:18.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:18.57,0:01:22.54,Default,,0,0,0,,А, мына жерде қолайлы нәрсе жоқ па?
Dialogue: 0,0:01:23.62,0:01:25.16,Default,,0,0,0,,-Мм... -(Рыцарлар) Иә?
Dialogue: 0,0:01:25.87,0:01:27.54,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:01:27.62,0:01:29.79,Default,,0,0,0,,Иә?Бірақ...
Dialogue: 0,0:01:29.88,0:01:32.05,Default,,0,0,0,,Көріп отырғаныңыздай, ол тоз-тоз болып қалды.
Dialogue: 0,0:01:32.13,0:01:34.71,Default,,0,0,0,,Мен оны лақтырып тастауды ойлап отырмын
Dialogue: 0,0:01:36.88,0:01:39.30,Default,,0,0,0,,Жоқ, тіпті қазір де, егер рұқсат етсеңіз…
Dialogue: 0,0:01:39.39,0:01:41.01,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:01:41.10,0:01:42.68,Default,,0,0,0,,Алла разы болсын
Dialogue: 0,0:01:42.76,0:01:44.27,Default,,0,0,0,,(арбаның кетіп бара жатқан дыбысы)
Dialogue: 0,0:01:44.35,0:01:46.81,Default,,0,0,0,,
Dialogue: 0,0:01:54.73,0:01:56.57,Default,,0,0,0,,Мен ертерек құтқарылдым.
Dialogue: 0,0:01:57.15,0:01:58.32,Default,,0,0,0,,Кишибе Рохан секілді күші бар біреу!
Dialogue: 0,0:01:59.45,0:02:01.07,Default,,0,0,0,,Жарайды, проблема жоқ.
Dialogue: 0,0:02:02.16,0:02:05.08,Default,,0,0,0,,Осымен бітсе, мен де жеңілемін.
Dialogue: 0,0:02:07.91,0:02:10.54,Default,,0,0,0,,Сенім үшін баға керек, солай ма?
Dialogue: 0,0:02:11.54,0:02:12.71,Default,,0,0,0,,О
Dialogue: 0,0:02:16.67,0:02:19.47,Default,,0,0,0,,Сенім тез қарғысқа айналады
Dialogue: 0,0:02:20.34,0:02:21.55,Default,,0,0,0,,Жоғалған
Dialogue: 0,0:02:30.40,0:02:31.94,Default,,0,0,0,,-Ал... -Мм?
Dialogue: 0,0:02:32.61,0:02:37.28,Default,,0,0,0,,Осымен бітсе, Иолентаның да толқуы өледі.
Dialogue: 0,0:02:38.32,0:02:39.32,Default,,0,0,0,,Әсер етті ме?
Dialogue: 0,0:02:39.40,0:02:41.11,Default,,0,0,0,,Иә
Dialogue: 0,0:02:41.20,0:02:44.91,Default,,0,0,0,,Сіз оны махаббат деп қабылдамайсыз, бірақ
Dialogue: 0,0:02:46.24,0:02:48.29,Default,,0,0,0,,Олай болса, мен оны аламын.
Dialogue: 0,0:02:50.67,0:02:54.50,Default,,0,0,0,,Әңгімені тыңдап, қол жеткізер болашақ
Dialogue: 0,0:02:55.30,0:02:59.09,Default,,0,0,0,,Йолентаның мақсаты болса да, оның есінде жоқ.
Dialogue: 0,0:03:00.43,0:03:02.51,Default,,0,0,0,,Кінә және өкініш
Dialogue: 0,0:03:03.72,0:03:05.51,Default,,0,0,0,,Сөз жоқ
Dialogue: 0,0:03:08.31,0:03:11.77,Default,,0,0,0,,Балалар, Йолентаның жоспарын қолға алсаңдар.
Dialogue: 0,0:03:12.44,0:03:15.40,Default,,0,0,0,,Мен Йолентаның ойын мұраға аламын.
Dialogue: 0,0:03:18.74,0:03:20.24,Default,,0,0,0,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:03:21.61,0:03:25.07,Default,,0,0,0,,Ұйым басшысына қашан сонша бауыр басып қалдыңыз?
Dialogue: 0,0:03:26.74,0:03:27.87,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:03:28.95,0:03:32.37,Default,,0,0,0,,Бірақ ол кездескен адам өлгендіктен емес пе?
Dialogue: 0,0:03:34.38,0:03:35.38,Default,,0,0,0,,Және
Dialogue: 0,0:03:35.96,0:03:38.84,Default,,0,0,0,,Мен сізге хат жіберуге уәде бердім.
Dialogue: 0,0:03:44.01,0:03:45.72,Default,,0,0,0,,(Баспалдақ дыбысы)
Dialogue: 0,0:03:54.10,0:03:57.27,Default,,0,0,0,,О, мен күтуден шаршадым, Шмидт.
Dialogue: 0,0:03:58.11,0:04:01.03,Default,,0,0,0,,Мен сені өлді деп ойладым, өйткені ол өте баяу болды.
Dialogue: 0,0:04:01.11,0:04:05.03,Default,,0,0,0,,Ол уақыт әлі келмеген сияқты, Болко.
Dialogue: 0,0:04:05.82,0:04:09.16,Default,,0,0,0,,Ал жас ханым ше? Сіз адасып қалдыңыз ба?
Dialogue: 0,0:04:09.24,0:04:12.29,Default,,0,0,0,,Ах, у... мен...
Dialogue: 0,0:04:12.37,0:04:14.29,Default,,0,0,0,,Бірлескен жұмысшы
Dialogue: 0,0:04:15.75,0:04:18.29,Default,,0,0,0,,Менің атым Дурака. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:04:18.38,0:04:21.21,Default,,0,0,0,,Ол түпнұсқаны өртеп жіберді
Dialogue: 0,0:04:21.30,0:04:24.51,Default,,0,0,0,,Сондықтан қазір кітаптың мазмұнын тек ол ғана біледі.
Dialogue: 0,0:04:25.01,0:04:26.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:26.22,0:04:27.47,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:27.55,0:04:30.43,Default,,0,0,0,,Және сізге мазмұнды үйрету үшін.
Dialogue: 0,0:04:30.52,0:04:32.89,Default,,0,0,0,,Мен сізге баспахананы несиеге беруге уәде бердім.
Dialogue: 0,0:04:32.98,0:04:34.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:34.23,0:04:38.52,Default,,0,0,0,,Ол да мені кешегі қиын жағдайдан құтқарды.
Dialogue: 0,0:04:39.11,0:04:41.28,Default,,0,0,0,,Бұл оның қысқаша мазмұны.
Dialogue: 0,0:04:41.36,0:04:42.74,Default,,0,0,0,,Фу…
Dialogue: 0,0:04:43.74,0:04:45.66,Default,,0,0,0,,Оған сенуге бола ма?
Dialogue: 0,0:04:46.49,0:04:49.49,Default,,0,0,0,,Қазіргі жағдай Менің сенуден басқа амалым жоқ
Dialogue: 0,0:04:56.71,0:05:00.00,Default,,0,0,0,,Қазынамен бетпе-бет кел.
Dialogue: 0,0:05:00.09,0:05:01.63,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:02.13,0:05:06.01,Default,,0,0,0,,Ах, тозған көрінеді, бірақ бұл сөзсіз.
Dialogue: 0,0:05:06.84,0:05:08.55,Default,,0,0,0,,Бұл баспа машинасы.
Dialogue: 0,0:05:10.60,0:05:12.47,Default,,0,0,0,,Ұйым басшысы кім?
Dialogue: 0,0:05:15.31,0:05:16.60,Default,,0,0,0,,Ол қайтыс болды.
Dialogue: 0,0:05:17.10,0:05:20.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:26.11,0:05:27.49,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:27.57,0:05:28.66,Default,,0,0,0,,О
Dialogue: 0,0:05:29.62,0:05:32.33,Default,,0,0,0,,Барлығы осы миссия үшін.
Dialogue: 0,0:05:38.46,0:05:42.67,Default,,0,0,0,,Біздің ұйымдық философиямыз қандай?
Dialogue: 0,0:05:42.75,0:05:46.17,Default,,0,0,0,,Осы дүниенің желдетуін жақсарту
Dialogue: 0,0:05:50.64,0:05:55.77,Default,,0,0,0,,Бар тәртіпке қарсы тұру және келесі ұрпаққа жаңа көкжиектерді кеңейту
Dialogue: 0,0:05:57.60,0:06:00.19,Default,,0,0,0,,Ол үшін не істеу керек
Dialogue: 0,0:06:01.06,0:06:05.49,Default,,0,0,0,,Қанша шешен болсаң да, сөзіңді тоқтатсаң даусың өшеді.
Dialogue: 0,0:06:05.57,0:06:09.61,Default,,0,0,0,,Кез келген тірек уақыт өте келе ыдырайды.
Dialogue: 0,0:06:10.20,0:06:11.78,Default,,0,0,0,,Барлығы өледі
Dialogue: 0,0:06:11.87,0:06:14.20,Default,,0,0,0,,Барлық заттар өзгереді
Dialogue: 0,0:06:14.91,0:06:18.33,Default,,0,0,0,,Бірақ біз енді қалай екенін білеміз
Dialogue: 0,0:06:18.41,0:06:24.46,Default,,0,0,0,,Сенімдеріңізді түзетіңіз, ойларыңызды елестетіңіз және сәтті мәңгілік етіңіз
Dialogue: 0,0:06:25.25,0:06:29.68,Default,,0,0,0,,«Қазір» алыс жерге, алыс болашаққа
Dialogue: 0,0:06:29.76,0:06:32.22,Default,,0,0,0,,немесе басқа біреуге—
Dialogue: 0,0:06:32.30,0:06:35.56,Default,,0,0,0,,Оны қалай жеткізуге болады
Dialogue: 0,0:06:37.39,0:06:40.06,Default,,0,0,0,,Бұл әдіс қарқынды
Dialogue: 0,0:06:40.14,0:06:44.98,Default,,0,0,0,,Қолданыстағы тәртіпті бұзатын және таптарды тарататын күші бар.
Dialogue: 0,0:06:46.86,0:06:50.49,Default,,0,0,0,,Біз мұны істейміз
Dialogue: 0,0:06:52.28,0:06:56.04,Default,,0,0,0,,Біз енді жариялау әрекеттерін бастаймыз.
Dialogue: 0,0:06:58.37,0:07:03.13,Default,,0,0,0,,♪~
Dialogue: 0,0:08:22.50,0:08:26.88,Default,,0,0,0,,~♪
Dialogue: 0,0:08:32.72,0:08:34.01,Default,,0,0,0,,Флай мырза
Dialogue: 0,0:08:37.01,0:08:39.18,Default,,0,0,0,,Бұл түпнұсқа және түрі
Dialogue: 0,0:08:39.72,0:08:43.89,Default,,0,0,0,,Жарайды, олай болса бірден баспа қағазын жасауға кірісейік.
Dialogue: 0,0:08:46.60,0:08:50.19,Default,,0,0,0,,Есте қалатын бірінші бет Кітаптың аты қандай?
Dialogue: 0,0:08:52.19,0:08:54.82,Default,,0,0,0,,«Жер қозғалысы туралы»
Dialogue: 0,0:08:55.74,0:08:57.62,Default,,0,0,0,,Жарайды, онда...
Dialogue: 0,0:08:57.70,0:08:59.66,Default,,0,0,0,,-Бір минут күте тұрыңыз-(Борко Шмидт) Иә?
Dialogue: 0,0:09:00.37,0:09:02.25,Default,,0,0,0,,Йолента...
Dialogue: 0,0:09:02.75,0:09:07.17,Default,,0,0,0,,Азаттық майданының жетекшісі ретінде сіздің есіміңіз белгісіз.
Dialogue: 0,0:09:07.25,0:09:08.38,Default,,0,0,0,,О
Dialogue: 0,0:09:08.46,0:09:10.13,Default,,0,0,0,,Қауіпсіз болуы керек
Dialogue: 0,0:09:10.21,0:09:11.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:11.25,0:09:15.13,Default,,0,0,0,,Баспагер ретінде мұқабаға атыңызды жазсаңыз қалай болады?
Dialogue: 0,0:09:15.22,0:09:17.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:17.18,0:09:19.14,Default,,0,0,0,,Хмм, жарайды.
Dialogue: 0,0:09:19.22,0:09:20.14,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:09:22.64,0:09:23.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:24.02,0:09:27.69,Default,,0,0,0,,Қарғыс атсын, кейбір әріптер бұзылған.
Dialogue: 0,0:09:27.77,0:09:29.06,Default,,0,0,0,,(Жауынгерлік айқай)
Dialogue: 0,0:09:32.65,0:09:34.11,Default,,0,0,0,,Сол кезде?
Dialogue: 0,0:09:34.19,0:09:35.57,Default,,0,0,0,,Фу…
Dialogue: 0,0:09:35.65,0:09:38.95,Default,,0,0,0,,Ал, типті бұзу оңай.
Dialogue: 0,0:09:40.12,0:09:43.83,Default,,0,0,0,,Боқ, N жойылады.
Dialogue: 0,0:09:43.91,0:09:47.54,Default,,0,0,0,,Оған көмектесу мүмкін емес, ол уақытша тоқтатылды.
Dialogue: 0,0:09:48.12,0:09:50.08,Default,,0,0,0,,Қалада қорғасын алу
Dialogue: 0,0:09:50.17,0:09:51.42,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:50.17,0:09:51.42,Default,,0,0,0,,(Жауынгерліктердің шуы)
Dialogue: 0,0:09:51.42,0:09:54.46,Default,,0,0,0,,(Жауынгерліктердің шуы)
Dialogue: 0,0:10:03.06,0:10:04.27,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:04.35,0:10:05.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:06.23,0:10:09.60,Default,,0,0,0,,Бұл қорғасын тиын болғандықтан, оны ерітсем пайдалана аламын ба?
Dialogue: 0,0:10:09.69,0:10:11.11,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:11.19,0:10:14.11,Default,,0,0,0,,Бұл сома аздап қосылады.
Dialogue: 0,0:10:14.19,0:10:16.32,Default,,0,0,0,,Бірақ бұл...
Dialogue: 0,0:10:16.40,0:10:17.24,Default,,0,0,0,,Оны маған бір сәтке бересіз бе?
Dialogue: 0,0:10:17.82,0:10:20.16,Default,,0,0,0,,Мен баспаны тезірек көргім келеді
Dialogue: 0,0:10:24.24,0:10:26.12,Default,,0,0,0,,Ханым, мен сізге қарыздармын.
Dialogue: 0,0:10:27.08,0:10:28.50,Default,,0,0,0,,Олай болса бастайық
Dialogue: 0,0:10:57.74,0:11:00.15,Default,,0,0,0,,О...
Dialogue: 0,0:11:01.07,0:11:02.53,Default,,0,0,0,,Бұл...
Dialogue: 0,0:11:03.37,0:11:05.20,Default,,0,0,0,,Баспаға басып шығару
Dialogue: 0,0:11:07.87,0:11:10.66,Default,,0,0,0,,Жарайды, қағазды әкел.
Dialogue: 0,0:11:10.75,0:11:12.50,Default,,0,0,0,,Қолымнан келгенше басып шығарамын.
Dialogue: 0,0:11:13.04,0:11:16.46,Default,,0,0,0,,Қалада жетекші бола алатыныңызды қараңыз.
Dialogue: 0,0:11:16.55,0:11:18.34,Default,,0,0,0,,Күдікті болмаңыз
Dialogue: 0,0:11:19.05,0:11:22.43,Default,,0,0,0,,Қалғандарымыз қолымыздан келгенше теруді орындауымыз керек.
Dialogue: 0,0:11:22.51,0:11:23.43,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:24.51,0:11:27.52,Default,,0,0,0,,Мырзалар, бастайық.
Dialogue: 0,0:11:49.75,0:11:51.08,Default,,0,0,0,,Іс жақсы жүріп жатыр.
Dialogue: 0,0:11:51.66,0:11:55.04,Default,,0,0,0,,Бірнеше күннен кейін тасымалдауға көшеміз бе?
Dialogue: 0,0:11:55.13,0:11:57.96,Default,,0,0,0,,А, бұл тамаша басып шығару техникасы.
Dialogue: 0,0:11:58.05,0:11:59.59,Default,,0,0,0,,Сіз соғұрлым тезірек бастасаңыз
Dialogue: 0,0:12:00.38,0:12:04.84,Default,,0,0,0,,Егер бұл сәтті болса, болашақта көбірек опциялар болады.
Dialogue: 0,0:12:06.43,0:12:08.89,Default,,0,0,0,,Болашақта...?
Dialogue: 0,0:12:10.89,0:12:13.85,Default,,0,0,0,,Жылқы іздеу Мен барамын
Dialogue: 0,0:12:13.94,0:12:15.10,Default,,0,0,0,,О
Dialogue: 0,0:12:17.11,0:12:18.36,Default,,0,0,0,,Фу…
Dialogue: 0,0:12:19.53,0:12:21.74,Default,,0,0,0,,Бұл ақырғы кезең
Dialogue: 0,0:12:21.82,0:12:25.11,Default,,0,0,0,,Бұл бізді мақсатымызға бір қадам жақындатады
Dialogue: 0,0:12:25.20,0:12:27.41,Default,,0,0,0,,Барлығы жоспар бойынша.
Dialogue: 0,0:12:27.49,0:12:29.62,Default,,0,0,0,,Ах! Міне, тап болдың!
Dialogue: 0,0:12:31.00,0:12:34.87,Default,,0,0,0,,Әңгімені тыңдап, жететін болашақ...
Dialogue: 0,0:12:35.96,0:12:39.88,Default,,0,0,0,,Йолентаның мақсаты болса да, оның есінде жоқ.
Dialogue: 0,0:12:41.26,0:12:44.18,Default,,0,0,0,,Мен Йолентаның ойын мұраға аламын.
Dialogue: 0,0:12:48.64,0:12:51.64,Default,,0,0,0,,Жоқ, бәрі Құдайдың жоспары бойынша.
Dialogue: 0,0:12:52.64,0:12:54.98,Default,,0,0,0,,Сезіміңізге алаңдаудың қажеті жоқ.
Dialogue: 0,0:12:58.52,0:13:02.65,Default,,0,0,0,,Мен бұл жерде шатассам, мен мақсатыма жете алмаймын.
Dialogue: 0,0:13:08.53,0:13:12.16,Default,,0,0,0,,Иә, жоспар сәтті болды.
Dialogue: 0,0:13:16.21,0:13:17.17,Default,,0,0,0,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,0:13:17.25,0:13:18.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:18.25,0:13:19.46,Default,,0,0,0,,Не!
Dialogue: 0,0:13:21.80,0:13:26.55,Default,,0,0,0,,Бұл тұрақты болып көрінеді, бірақ оны тағы бір рет растауға рұқсат етіңіз.
Dialogue: 0,0:13:28.01,0:13:30.80,Default,,0,0,0,,Бұл миссия біздің ұйымға арналған.
Dialogue: 0,0:13:30.89,0:13:34.68,Default,,0,0,0,,Сіз бұл ең маңызды жоспар деп айта аласыз, солай ма?
Dialogue: 0,0:13:34.77,0:13:36.10,Default,,0,0,0,,О
Dialogue: 0,0:13:36.19,0:13:41.40,Default,,0,0,0,,Ұйым басшысы өз өмірін өтеу үшін бұл жерді жасырған.
Dialogue: 0,0:13:41.48,0:13:43.07,Default,,0,0,0,,О
Dialogue: 0,0:13:43.15,0:13:46.90,Default,,0,0,0,,Сондықтан бұл анықталса, бұл апат болады.
Dialogue: 0,0:13:48.82,0:13:50.03,Default,,0,0,0,,О
Dialogue: 0,0:13:51.03,0:13:54.41,Default,,0,0,0,,Ал осында болған аттар
Dialogue: 0,0:13:54.50,0:13:57.29,Default,,0,0,0,,Бұл жалғыз көлік болды, солай ма?
Dialogue: 0,0:14:01.38,0:14:02.38,Default,,0,0,0,,О
Dialogue: 0,0:14:02.88,0:14:04.55,Default,,0,0,0,,Жақсы
Dialogue: 0,0:14:04.63,0:14:08.01,Default,,0,0,0,,Олай болса, бұл томның дұрыс аяқталуы.
Dialogue: 0,0:14:08.51,0:14:10.55,Default,,0,0,0,,Есеп аяқталды ма?
Dialogue: 0,0:14:10.64,0:14:14.43,Default,,0,0,0,,Иә, бұрын мен қалаға түскенімде.
Dialogue: 0,0:14:25.03,0:14:26.19,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:26.28,0:14:28.20,Default,,0,0,0,,Дәл солай. Мектеп формасындағы — маған күш берген сол адам.
Dialogue: 0,0:14:30.03,0:14:31.07,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:31.16,0:14:32.45,Default,,0,0,0,,Ой… Бұл сәл ағаттық болды.
Dialogue: 0,0:14:33.16,0:14:34.20,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:35.54,0:14:36.45,Default,,0,0,0,,Хмф!
Dialogue: 0,0:14:37.66,0:14:39.21,Default,,0,0,0,,-Мм! -Аа...
Dialogue: 0,0:14:39.87,0:14:41.21,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:41.79,0:14:43.17,Default,,0,0,0,,Уф
Dialogue: 0,0:14:48.88,0:14:50.30,Default,,0,0,0,,Оны аяқтаңыз.
Dialogue: 0,0:14:50.38,0:14:51.22,Default,,0,0,0,,Хмм…
Dialogue: 0,0:14:51.30,0:14:54.81,Default,,0,0,0,,Рыцарлар бірнеше минуттан кейін келеді.
Dialogue: 0,0:14:54.89,0:14:57.73,Default,,0,0,0,,Баспа машинасын жылжытуға уақыт жоқ
Dialogue: 0,0:14:58.73,0:15:01.85,Default,,0,0,0,,Біздің жеңісіміз анық.
Dialogue: 0,0:15:03.06,0:15:05.11,Default,,0,0,0,,Маған неге опасыздық жасадың?
Dialogue: 0,0:15:05.19,0:15:06.86,Default,,0,0,0,,Кімнің бұйрығы?
Dialogue: 0,0:15:06.94,0:15:08.61,Default,,0,0,0,,Сіз қайда қызмет етесіз?
Dialogue: 0,0:15:08.69,0:15:11.91,Default,,0,0,0,,Хехехе еш жерде
Dialogue: 0,0:15:11.99,0:15:14.83,Default,,0,0,0,,Таңдау керек болса, Құдай мен әділдік дер едім.
Dialogue: 0,0:15:17.45,0:15:21.58,Default,,0,0,0,,Мен сені әрқашан жек көретінмін.
Dialogue: 0,0:15:21.67,0:15:25.34,Default,,0,0,0,,Сен сияқты еретик маскүнем!
Dialogue: 0,0:15:26.55,0:15:30.76,Default,,0,0,0,,Сен екеуміз көптеген рыцарьларды өлтірдік.
Dialogue: 0,0:15:30.84,0:15:31.97,Default,,0,0,0,,Бұл сыбайлас.
Dialogue: 0,0:15:33.30,0:15:36.47,Default,,0,0,0,,Бұл сіздің сенімдеріңіз үшін қажет құрбандық.
Dialogue: 0,0:15:37.14,0:15:39.43,Default,,0,0,0,,Балалар, өшіріңдер
Dialogue: 0,0:15:39.52,0:15:43.15,Default,,0,0,0,,Бұл менің есімде қалғаннан бері менің сенімім.
Dialogue: 0,0:15:43.23,0:15:44.73,Default,,0,0,0,,Күмән жоқ
Dialogue: 0,0:15:46.82,0:15:50.74,Default,,0,0,0,,Сенімдеріңізге жету үшін тым көп жоспарлаған жоқсыз.
Dialogue: 0,0:15:51.78,0:15:55.24,Default,,0,0,0,,Мойындауға әлі ерте емес пе?
Dialogue: 0,0:15:55.32,0:16:00.45,Default,,0,0,0,,Біз рыцарьлар келгеннен кейін ғана құтыла аламыз.
Dialogue: 0,0:16:00.54,0:16:02.87,Default,,0,0,0,,Сен мені өлтіре алмайсың.
Dialogue: 0,0:16:04.25,0:16:07.75,Default,,0,0,0,,Хехехе, сен түсінбейсің.
Dialogue: 0,0:16:07.84,0:16:09.46,Default,,0,0,0,,Бұл мейірімділік
Dialogue: 0,0:16:09.55,0:16:10.51,Default,,0,0,0,,Мейірімділік?
Dialogue: 0,0:16:10.59,0:16:13.55,Default,,0,0,0,,О, мен саған уақыт беремін.
Dialogue: 0,0:16:14.05,0:16:17.39,Default,,0,0,0,,Сіздің таяздығыңызды түсіну уақыты
Dialogue: 0,0:16:17.89,0:16:20.02,Default,,0,0,0,,Үмітсіздік уақыты
Dialogue: 0,0:16:20.93,0:16:24.19,Default,,0,0,0,,Ал реформалау уақыты
Dialogue: 0,0:16:26.19,0:16:29.23,Default,,0,0,0,,Ал, құтқарылу әлі бар.
Dialogue: 0,0:16:29.32,0:16:33.15,Default,,0,0,0,,Үлгілі сенуші ретінде мен арнайы тыңдаймын.
Dialogue: 0,0:16:34.74,0:16:36.03,Default,,0,0,0,,Сонымен айтыңыз
Dialogue: 0,0:16:36.87,0:16:41.29,Default,,0,0,0,,Сіздердің мазақ етіп отырған шіркеу православие дұрыс емес.
Dialogue: 0,0:16:41.37,0:16:43.04,Default,,0,0,0,,Айтыңызшы!
Dialogue: 0,0:16:43.12,0:16:45.21,Default,,0,0,0,,Айт! Уф...
Dialogue: 0,0:16:47.25,0:16:48.38,Default,,0,0,0,,Гах…
Dialogue: 0,0:16:53.51,0:16:57.05,Default,,0,0,0,,(Шыбынның ыңырсыуы)
Dialogue: 0,0:17:20.16,0:17:21.20,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:17:36.63,0:17:37.47,Default,,0,0,0,,Иә
Dialogue: 0,0:17:37.55,0:17:38.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:38.84,0:17:42.10,Default,,0,0,0,,Сіз оны көре алмайсыз...
Dialogue: 0,0:17:43.64,0:17:49.35,Default,,0,0,0,,Бұл қымбат крест... бұл...
Dialogue: 0,0:17:55.86,0:17:56.99,Default,,0,0,0,,Қайдан бастарын білмеймін.
Dialogue: 0,0:17:57.07,0:17:59.53,Default,,0,0,0,,Мұнда бірнеше күдікті вагон бар...
Dialogue: 0,0:18:00.41,0:18:01.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:03.41,0:18:06.25,Default,,0,0,0,,Флай мырза маған опасыздық жасады.
Dialogue: 0,0:18:06.33,0:18:07.58,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:18:13.42,0:18:15.01,Default,,0,0,0,,Жағдай...
Dialogue: 0,0:18:15.09,0:18:17.01,Default,,0,0,0,,
Dialogue: 0,0:18:20.72,0:18:23.47,Default,,0,0,0,,Қалып пен түпнұсқа көміліп, жасырылған.
Dialogue: 0,0:18:23.56,0:18:26.52,Default,,0,0,0,,Мәселе баспа машинасымен не істеу керек...
Dialogue: 0,0:18:26.60,0:18:28.89,Default,,0,0,0,,Ойлау - уақытты босқа өткізу
Dialogue: 0,0:18:29.77,0:18:33.86,Default,,0,0,0,,Жау дәл сол жерде, бізде ат жоқ.
Dialogue: 0,0:18:34.86,0:18:36.24,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:36.32,0:18:39.28,Default,,0,0,0,,Ендеше, осы уақытқа дейін келдіңіз бе, баспахананы лақтырып жібересіз бе?
Dialogue: 0,0:18:39.36,0:18:40.74,Default,,0,0,0,,Егер бұл сізге қажет болса, бұл жақсы.
Dialogue: 0,0:18:40.82,0:18:41.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:41.74,0:18:44.03,Default,,0,0,0,,Бұл жерде көрініс ашық.
Dialogue: 0,0:18:44.62,0:18:46.91,Default,,0,0,0,,Қашсаң да жұрт біледі
Dialogue: 0,0:18:47.00,0:18:49.29,Default,,0,0,0,,Ең сорақысы бәрі өледі
Dialogue: 0,0:18:49.87,0:18:51.79,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:51.88,0:18:53.84,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:18:53.92,0:18:57.34,Default,,0,0,0,,Бірақ мұның бәрі сіздің қолыңыздан келеді.
Dialogue: 0,0:18:57.42,0:18:59.68,Default,,0,0,0,,Барлығы бөлшектеп қашады.
Dialogue: 0,0:19:00.18,0:19:03.97,Default,,0,0,0,,Қашып кету бақытына ие болғандар қайтадан бастау керек.
Dialogue: 0,0:19:04.51,0:19:09.43,Default,,0,0,0,,Шынайы ойлау, бұл аман қалудың жалғыз жолы.
Dialogue: 0,0:19:09.52,0:19:12.02,Default,,0,0,0,,Бір ғана таңдау бар
Dialogue: 0,0:19:12.52,0:19:14.40,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:20.53,0:19:21.45,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:21.53,0:19:22.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:22.78,0:19:23.95,Default,,0,0,0,,Екі.
Dialogue: 0,0:19:25.28,0:19:29.20,Default,,0,0,0,,Жариялаудың тағы бір мүмкіндігі бар.
Dialogue: 0,0:19:29.29,0:19:30.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:31.04,0:19:32.33,Default,,0,0,0,,Не?
Dialogue: 0,0:19:35.25,0:19:39.72,Default,,0,0,0,,Барлығы ынтымақтасады және маған қашып кетуге рұқсат береді.
Dialogue: 0,0:19:39.80,0:19:41.55,Default,,0,0,0,,(Жауынгерліктердің шуы)
Dialogue: 0,0:19:43.39,0:19:44.80,Default,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:19:46.64,0:19:48.68,Default,,0,0,0,,Стратегияны түсіндіріңіз
Dialogue: 0,0:19:51.27,0:19:53.69,Default,,0,0,0,,Не...қандай ақымақтық айтып тұрсың?
Dialogue: 0,0:19:53.77,0:19:55.77,Default,,0,0,0,,Ешқандай мүмкіндік жоқ!
Dialogue: 0,0:19:55.86,0:19:58.36,Default,,0,0,0,,Енді кіммен төбелесемін деп ойлайсың?
Dialogue: 0,0:19:58.44,0:20:00.28,Default,,0,0,0,,Бұл шіркеу!
Dialogue: 0,0:20:00.36,0:20:01.82,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:20:01.90,0:20:07.66,Default,,0,0,0,,Бірақ мен онымен шіркеумен емес, жеке сөйлесемін.
Dialogue: 0,0:20:07.74,0:20:10.12,Default,,0,0,0,,Егер сіз жылқы ұрласаңыз, онда сіз бірнеше сағатта бола аласыз.
Dialogue: 0,0:20:10.20,0:20:11.12,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:20:11.21,0:20:13.33,Default,,0,0,0,,Мүмкін емес ештеңе жоқ!
Dialogue: 0,0:20:14.12,0:20:16.59,Default,,0,0,0,,Әсіресе адам жүрегіне келгенде
Dialogue: 0,0:20:16.67,0:20:17.92,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:19.05,0:20:21.72,Default,,0,0,0,,Мен Құдайға сенбеймін
Dialogue: 0,0:20:21.80,0:20:25.22,Default,,0,0,0,,Сіз одан бас тарта аласыз, бірақ
Dialogue: 0,0:20:25.30,0:20:28.06,Default,,0,0,0,,Сондықтан сіз көруге болатын табиғат көріністері бар.
Dialogue: 0,0:20:28.14,0:20:29.26,Default,,0,0,0,,Хмм…
Dialogue: 0,0:20:30.64,0:20:32.56,Default,,0,0,0,,Уақыт өзгеруде
Dialogue: 0,0:20:32.64,0:20:35.35,Default,,0,0,0,,Жоқ, өзгертуден басқа амалымыз жоқ.
Dialogue: 0,0:20:35.44,0:20:37.02,Default,,0,0,0,,Мен болсам, мен бұл нүктеге жететін едім.
Dialogue: 0,0:20:37.86,0:20:39.73,Default,,0,0,0,,Сіз оны көндіре аласыз
Dialogue: 0,0:20:40.98,0:20:45.53,Default,,0,0,0,,Әрине, бұл саналы ұсыныс.
Dialogue: 0,0:20:46.87,0:20:49.62,Default,,0,0,0,,Расында да, күш біріктірсек
Dialogue: 0,0:20:49.70,0:20:52.75,Default,,0,0,0,,Бір немесе екі адам қашып кетуі мүмкін.
Dialogue: 0,0:20:54.12,0:20:58.34,Default,,0,0,0,,Бірақ оның орнына сізден басқаның бәрі өледі.
Dialogue: 0,0:20:59.00,0:21:01.34,Default,,0,0,0,,Иә, әрине.
Dialogue: 0,0:21:01.42,0:21:03.42,Default,,0,0,0,,Сондай-ақ жарияланған
Dialogue: 0,0:21:03.51,0:21:05.68,Default,,0,0,0,,Бұл ұйымның мақсаты, солай емес пе?
Dialogue: 0,0:21:06.80,0:21:09.01,Default,,0,0,0,,Сонымен екі нұсқа бар.
Dialogue: 0,0:21:10.06,0:21:14.06,Default,,0,0,0,,Бірнеше адам кездейсоқ па әлде бір адам таңдалған ба?
Dialogue: 0,0:21:17.15,0:21:19.06,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:21:19.15,0:21:24.57,Default,,0,0,0,,Қашып кетуге рұқсат етсем де, мен сені көндіре алмаймын деп ойлаймын.
Dialogue: 0,0:21:25.15,0:21:28.07,Default,,0,0,0,,Табысқа жету үшін тым аз негіз
Dialogue: 0,0:21:29.57,0:21:33.33,Default,,0,0,0,,Сізден басқа бірнеше адам қашып үлгерсе де...
Dialogue: 0,0:21:33.91,0:21:36.46,Default,,0,0,0,,Баспа машинасын сол жерден алыңыз
Dialogue: 0,0:21:36.54,0:21:40.34,Default,,0,0,0,,Жариялануға және таратуға жету мүмкіндігі де бар.
Dialogue: 0,0:21:40.42,0:21:42.34,Default,,0,0,0,,де өте төмен болады
Dialogue: 0,0:21:45.97,0:21:47.47,Default,,0,0,0,,Не істеу керек? капитан
Dialogue: 0,0:21:52.26,0:21:53.56,Default,,0,0,0,,Мен—
Dialogue: 0,0:21:53.64,0:21:56.35,Default,,0,0,0,,Сен осылай тығырыққа тірелгенде мен жақсы әдісті білемін.
Dialogue: 0,0:22:00.23,0:22:01.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:02.69,0:22:04.40,Default,,0,0,0,,Құдайдан сұра
Dialogue: 0,0:22:04.94,0:22:06.74,Default,,0,0,0,,(Жауынгерліктердің шуы)
Dialogue: 0,0:22:06.82,0:22:08.86,Default,,0,0,0,,Бас болса, бәріміз қашамыз
Dialogue: 0,0:22:10.16,0:22:12.49,Default,,0,0,0,,Сахна артында болса, қашып кетейін.
Dialogue: 0,0:22:14.58,0:22:16.12,Default,,0,0,0,,Ой, мен… қазірдің өзінде кеш болып қалыпты
Dialogue: 0,0:22:17.62,0:22:18.71,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:22:19.21,0:22:23.63,Default,,0,0,0,,Сіз осылай шеше аласыз ба?
Dialogue: 0,0:22:26.17,0:22:27.13,Default,,0,0,0,,Иә
Dialogue: 0,0:22:40.19,0:22:41.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:42.69,0:22:43.98,Default,,0,0,0,,Кесте
Dialogue: 0,0:22:47.74,0:22:49.28,Default,,0,0,0,,Бәріміз қашайық
Dialogue: 0,0:22:56.83,0:22:59.00,Default,,0,0,0,,Жарайды, бәріміз асығайық.
Dialogue: 0,0:22:59.08,0:23:00.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:08.88,0:23:09.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:11.89,0:23:15.14,Default,,0,0,0,,Сен қаш, біз сені қорғаймыз.
Dialogue: 0,0:23:15.89,0:23:17.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:19.27,0:23:20.94,Default,,0,0,0,,Мұны бәріңіз естідіңіз бе?
Dialogue: 0,0:23:21.81,0:23:24.82,Default,,0,0,0,,Капитан, бұл ұсыныс па?
Dialogue: 0,0:23:25.94,0:23:27.32,Default,,0,0,0,,Бұл тапсырыс.
Dialogue: 0,0:23:28.94,0:23:30.15,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:23:30.99,0:23:35.99,Default,,0,0,0,,♪~
Dialogue: 0,0:24:54.03,0:24:59.03,Default,,0,0,0,,~♪
Dialogue: 0,0:25:00.53,0:25:06.53,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory