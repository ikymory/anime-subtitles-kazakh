Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.41,0:00:05.42,Default,,0,0,0,,Мен сені аяймын, бірақ оны қабылдаудан басқа амалым жоқ сияқты.
Dialogue: 0,0:00:06.46,0:00:09.92,Default,,0,0,0,,Сіз және сіз басқарған бидғатшылар
Dialogue: 0,0:00:10.01,0:00:14.05,Default,,0,0,0,,Сіз тарихи кейіпкер емессіз.
Dialogue: 0,0:00:14.84,0:00:16.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:16.89,0:00:17.93,Default,,0,0,0,,Жарайсың ба?
Dialogue: 0,0:00:18.60,0:00:19.93,Default,,0,0,0,,Бұдан былай
Dialogue: 0,0:00:20.02,0:00:23.69,Default,,0,0,0,,Гелиоцентрлік теорияға ұқсас идеясы бар кітап шығарылса да
Dialogue: 0,0:00:24.27,0:00:26.31,Default,,0,0,0,,Шу шығармаңыз.
Dialogue: 0,0:00:26.40,0:00:27.86,Default,,0,0,0,,Өйткені бұл мағынасыз
Dialogue: 0,0:00:29.36,0:00:31.03,Default,,0,0,0,,Антони мырза
Dialogue: 0,0:00:31.90,0:00:34.78,Default,,0,0,0,,Тіпті мен оны бірден анықтай аламын.
Dialogue: 0,0:00:36.16,0:00:39.91,Default,,0,0,0,,Сенім десең де, бәрі ақшада, солай емес пе?
Dialogue: 0,0:00:43.54,0:00:46.04,Default,,0,0,0,,Сіз көптен бері солайсыз.
Dialogue: 0,0:00:47.50,0:00:50.17,Default,,0,0,0,,Оған ұйытқы болған сен болдың.
Dialogue: 0,0:00:50.25,0:00:51.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:51.96,0:00:55.38,Default,,0,0,0,,Дінбасыларға пара беру – ақырзаман.
Dialogue: 0,0:00:55.47,0:00:57.30,Default,,0,0,0,,Сіз қанша жұмсадыңыз?
Dialogue: 0,0:00:58.05,0:00:59.60,Default,,0,0,0,,Сол жігіт пен оның адамдарының бәрі Стэнд қолданушылары сияқты
Dialogue: 0,0:00:59.68,0:01:02.93,Default,,0,0,0,,Мен ерекше шағымдар айтқым келмейді.
Dialogue: 0,0:01:03.02,0:01:07.98,Default,,0,0,0,,Басқалар бара жатқан жерден бір қадам алда болуға тырысу.
Dialogue: 0,0:01:09.15,0:01:12.03,Default,,0,0,0,,Ақшаның келе жатқан дәуірінде
Dialogue: 0,0:01:14.24,0:01:15.20,Default,,0,0,0,,Ақша…
Dialogue: 0,0:01:15.99,0:01:18.45,Default,,0,0,0,,Ақша үшін Құдайдан бас тарту?
Dialogue: 0,0:01:19.07,0:01:22.45,Default,,0,0,0,,Ақша табуға болатын болса, бәрі бекітіледі.
Dialogue: 0,0:01:23.24,0:01:26.21,Default,,0,0,0,,Мұндай дәуір жақсы деп ойлайсың ба?
Dialogue: 0,0:01:28.04,0:01:33.71,Default,,0,0,0,,Мен азат ету майданының жетекшісінің мылтық қолданып өзін жарып жібергенін көрдім.
Dialogue: 0,0:01:34.84,0:01:36.34,Default,,0,0,0,,Мына көріністі қараңыз
Dialogue: 0,0:01:36.93,0:01:39.84,Default,,0,0,0,,Кім мұны қайғылы деп санамайды?
Dialogue: 0,0:01:41.64,0:01:46.52,Default,,0,0,0,,Бұл жарылыс интеллект пен технологияның дамыған жері.
Dialogue: 0,0:01:46.60,0:01:49.23,Default,,0,0,0,,Өркениет пен парасат атынан
Dialogue: 0,0:01:49.31,0:01:52.32,Default,,0,0,0,,Алланың атымен теңдесі жоқ таразы.
Dialogue: 0,0:01:52.40,0:01:54.11,Default,,0,0,0,,Қанды қырғын болуы мүмкін
Dialogue: 0,0:01:54.82,0:01:56.15,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:01:56.24,0:02:01.16,Default,,0,0,0,,Құдайға ендігі жол берілмейтін адамдардың тағдыры
Dialogue: 0,0:02:01.95,0:02:06.00,Default,,0,0,0,,Адамдар Құдайдан айырылса, олар жоғала береді.
Dialogue: 0,0:02:07.79,0:02:08.87,Default,,0,0,0,,Иә
Dialogue: 0,0:02:10.63,0:02:14.75,Default,,0,0,0,,Бірақ, әрине, шатасуда этика бар
Dialogue: 0,0:02:16.26,0:02:18.13,Default,,0,0,0,,Бұл ұйым жетекшісінің сөзі.
Dialogue: 0,0:02:18.80,0:02:22.51,Default,,0,0,0,,Мен ешқашан тыныштық болмайды деп ойлаймын.
Dialogue: 0,0:02:23.14,0:02:27.52,Default,,0,0,0,,Дұрыс айтасыз. Бұдан кейінгі жағдай жаппай өлім дәуірі болуы мүмкін.
Dialogue: 0,0:02:28.10,0:02:32.52,Default,,0,0,0,,Бірақ бұл өлімге Құдай емес, адам жауапты.
Dialogue: 0,0:02:33.19,0:02:36.40,Default,,0,0,0,,Демек, онда «күнә мен құтқарылу» сөзсіз.
Dialogue: 0,0:02:37.15,0:02:39.24,Default,,0,0,0,,«Рефлексия және тәуелсіздік»
Dialogue: 0,0:02:41.11,0:02:44.83,Default,,0,0,0,,Осылай жапа шеккен зиялылық
Dialogue: 0,0:02:44.91,0:02:47.79,Default,,0,0,0,,Ақырында адасып кететіндей ақылды боласың.
Dialogue: 0,0:02:48.58,0:02:51.17,Default,,0,0,0,,Бақылаудан шығып кеткен өркениетті тежеу
Dialogue: 0,0:02:51.25,0:02:53.92,Default,,0,0,0,,Қалыпты емес технологияны меңгере алатын интеллектке айналу
Dialogue: 0,0:02:56.63,0:02:58.92,Default,,0,0,0,,Таңқаларлық оптимистік
Dialogue: 0,0:02:59.72,0:03:00.68,Default,,0,0,0,,Иә
Dialogue: 0,0:03:00.76,0:03:05.89,Default,,0,0,0,,Бірақ бірде маған бұл туралы мені сатқындық жасаған қайырымды адам айтты.
Dialogue: 0,0:03:07.22,0:03:09.93,Default,,0,0,0,,Құдайсыз әлемде ойлан
Dialogue: 0,0:03:10.73,0:03:14.56,Default,,0,0,0,,Жол ашылатынына сенгім келеді.
Dialogue: 0,0:03:16.32,0:03:20.95,Default,,0,0,0,,Ал сіз ең маңызды нәрсені ұмытып бара жатырсыз.
Dialogue: 0,0:03:21.99,0:03:22.82,Default,,0,0,0,,(Ватару) Ой, расымен бе? Мен ойлағаннан кіші екен.
Dialogue: 0,0:03:27.16,0:03:30.16,Default,,0,0,0,,Құдай қоғамнан жойылса да сенімдімін
Dialogue: 0,0:03:30.25,0:03:33.00,Default,,0,0,0,,Құдайды адам жанынан өшіру мүмкін емес.
Dialogue: 0,0:03:35.79,0:03:38.13,Default,,0,0,0,,Ол балаға ұқсайды.
Dialogue: 0,0:03:39.01,0:03:41.88,Default,,0,0,0,,Алаңсыз, сау және өзімшіл
Dialogue: 0,0:03:42.76,0:03:45.18,Default,,0,0,0,,Ол сенімен сөйлесе алмайтын бала.
Dialogue: 0,0:03:45.76,0:03:47.10,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:47.18,0:03:49.68,Default,,0,0,0,,Осымен әңгіме аяқталды.
Dialogue: 0,0:03:49.77,0:03:52.10,Default,,0,0,0,,Сіз өз жұмысыңызды орындадыңыз
Dialogue: 0,0:03:52.64,0:03:55.31,Default,,0,0,0,,Бірақ бұл «қазірге» сәйкес келмейді
Dialogue: 0,0:03:55.40,0:03:58.32,Default,,0,0,0,,Желдің бағыты өзгерді.
Dialogue: 0,0:04:02.03,0:04:04.82,Default,,0,0,0,,Еңбегіңіз үшін рахмет. Үзіліс жасаңыз.
Dialogue: 0,0:04:05.41,0:04:06.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:07.53,0:04:09.74,Default,,0,0,0,,Бұл біздің соңғы кездесуіміз болады
Dialogue: 0,0:04:09.83,0:04:12.25,Default,,0,0,0,,Айтпаған нәрсеңіз болса, сұраймын.
Dialogue: 0,0:04:14.46,0:04:17.29,Default,,0,0,0,,Мен бұған сенгім келмейді.
Dialogue: 0,0:04:17.38,0:04:18.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:18.29,0:04:22.84,Default,,0,0,0,,Мұндай ең нашар болжам қалай шындыққа айналады?
Dialogue: 0,0:04:22.92,0:04:24.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:24.18,0:04:26.43,Default,,0,0,0,,Ең нашар жағдай?
Dialogue: 0,0:04:27.05,0:04:29.01,Default,,0,0,0,,Хмф... иә?
Dialogue: 0,0:04:29.10,0:04:30.31,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:04:30.39,0:04:32.85,Default,,0,0,0,,Не? Оның иісі алкоголь сияқты
Dialogue: 0,0:04:33.89,0:04:35.23,Default,,0,0,0,,Сіз байқадыңыз ба?
Dialogue: 0,0:04:35.31,0:04:38.40,Default,,0,0,0,,Себебі мен сыртқа көп егіп қойдым.
Dialogue: 0,0:04:39.02,0:04:42.24,Default,,0,0,0,,Мен де оған сіңген сабан қалдырдым.
Dialogue: 0,0:04:42.32,0:04:43.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:44.03,0:04:44.86,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:45.45,0:04:48.87,Default,,0,0,0,,Желдің бағыты өзгерген болуы мүмкін.
Dialogue: 0,0:04:49.45,0:04:54.62,Default,,0,0,0,,Бірақ бүгін түнде бәріміз осында өлсек ше?
Dialogue: 0,0:04:55.25,0:05:01.00,Default,,0,0,0,,Ал егер бұл шіркеу отқа оранса ше?
Dialogue: 0,0:05:01.09,0:05:02.84,Default,,0,0,0,,Сонымен қатар, егер
Dialogue: 0,0:05:02.92,0:05:06.51,Default,,0,0,0,,Егер мен қақпашыға осындай хабарлама қалдырсам ше?
Dialogue: 0,0:05:07.09,0:05:10.35,Default,,0,0,0,,«Шіркеуге еретиктер туралы тергеуге бару»
Dialogue: 0,0:05:10.43,0:05:13.81,Default,,0,0,0,,«Күдікті гелиоцентрист».
Dialogue: 0,0:05:14.43,0:05:15.27,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:05:16.69,0:05:21.02,Default,,0,0,0,,Сонда азаматтар кінәлі кім деп есептейді?
Dialogue: 0,0:05:21.11,0:05:22.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:22.19,0:05:23.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:25.03,0:05:27.49,Default,,0,0,0,,Адамдар қате түсінеді, солай ма?
Dialogue: 0,0:05:27.57,0:05:29.24,Default,,0,0,0,,Сіз мұны ойлайсыз, солай ма?
Dialogue: 0,0:05:29.32,0:05:31.20,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:05:31.28,0:05:34.29,Default,,0,0,0,,Желдің бағыты қайтадан өзгерді ме?
Dialogue: 0,0:05:34.91,0:05:35.75,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:05:41.59,0:05:44.51,Default,,0,0,0,,Не...не?
Dialogue: 0,0:05:45.09,0:05:49.76,Default,,0,0,0,,Әйелдің шіркеуге бара жатқанын естігенде, көңілім нашарлады.
Dialogue: 0,0:05:50.89,0:05:52.18,Default,,0,0,0,,Жағдайда
Dialogue: 0,0:05:52.26,0:05:56.77,Default,,0,0,0,,Гелиоцентрлік теорияға қолайлы баға берілсе, не істеуіміз керек?
Dialogue: 0,0:05:57.89,0:06:00.02,Default,,0,0,0,,Мен оның бұрынғы мәлімдемесінен бас тартады деп ешқашан ойламадым.
Dialogue: 0,0:06:00.10,0:06:03.27,Default,,0,0,0,,Маған көрсетемін деп ойламадым.
Dialogue: 0,0:06:04.32,0:06:07.40,Default,,0,0,0,,Қуаныштымын жеңгем бар.
Dialogue: 0,0:06:08.20,0:06:10.57,Default,,0,0,0,,Енді гелиоцентрлік теорияға сенетіндер
Dialogue: 0,0:06:10.66,0:06:13.58,Default,,0,0,0,,Қауіпті деген қауесет тарата алады
Dialogue: 0,0:06:14.49,0:06:17.16,Default,,0,0,0,,Сіз мұны істей аламын деп шынымен ойлайсыз ба?
Dialogue: 0,0:06:17.91,0:06:20.42,Default,,0,0,0,,Сіз тырыспайынша білмейсіз
Dialogue: 0,0:06:22.54,0:06:24.00,Default,,0,0,0,,Мені де өлтіргің келе ме?
Dialogue: 0,0:06:28.30,0:06:31.01,Default,,0,0,0,,Шынымды айтсам, енді бірі маңызды емес.
Dialogue: 0,0:06:31.93,0:06:35.72,Default,,0,0,0,,Бұл жерден қашып, шындықты айтсаң да.
Dialogue: 0,0:06:35.81,0:06:38.52,Default,,0,0,0,,Саған ешкім сенбейді
Dialogue: 0,0:06:39.23,0:06:41.15,Default,,0,0,0,,Жақсы, бірақ...
Dialogue: 0,0:06:42.73,0:06:45.78,Default,,0,0,0,,Оны өлтіру қауіпсіз бе?
Dialogue: 0,0:06:50.11,0:06:52.03,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:07:00.12,0:07:01.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:01.75,0:07:02.75,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:07:04.25,0:07:05.34,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:07:05.42,0:07:06.50,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:07:09.05,0:07:10.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:20.14,0:07:21.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:40.16,0:07:41.00,Default,,0,0,0,,Ах
Dialogue: 0,0:07:50.76,0:07:52.26,Default,,0,0,0,,Сәлем
Dialogue: 0,0:07:54.39,0:07:59.14,Default,,0,0,0,,♪~
Dialogue: 0,0:09:18.51,0:09:22.89,Default,,0,0,0,,~♪
Dialogue: 0,0:09:30.40,0:09:32.02,Default,,0,0,0,,Жақсы қыз бол және барынша тырыс, жарай ма?
Dialogue: 0,0:09:32.11,0:09:34.99,Default,,0,0,0,,Мынаны маған көрсетіп тұрсың...
Dialogue: 0,0:09:35.07,0:09:36.86,Default,,0,0,0,,Бұл пайғамбарлық немесе басқа нәрсе ме?
Dialogue: 0,0:09:37.36,0:09:38.36,Default,,0,0,0,,Жоқ
Dialogue: 0,0:09:39.37,0:09:42.16,Default,,0,0,0,,Бәлкім, өліп бара жатқан шығар.
Dialogue: 0,0:09:42.24,0:09:44.79,Default,,0,0,0,,Бұл өз бетінше көретін елес.
Dialogue: 0,0:09:45.37,0:09:48.29,Default,,0,0,0,,А... Солай ма?
Dialogue: 0,0:09:48.37,0:09:51.17,Default,,0,0,0,,Иә, бұл солай.
Dialogue: 0,0:09:52.71,0:09:55.55,Default,,0,0,0,,Әйтеуір, біраз уақыт өтті.
Dialogue: 0,0:09:56.13,0:09:58.18,Default,,0,0,0,,Қалай болды? Содан бері
Dialogue: 0,0:09:59.72,0:10:02.05,Default,,0,0,0,,Бұл өте көп болды.
Dialogue: 0,0:10:02.64,0:10:04.18,Default,,0,0,0,,Сіз үшін
Dialogue: 0,0:10:04.81,0:10:06.85,Default,,0,0,0,,Мен жалғыз емеспін
Dialogue: 0,0:10:06.93,0:10:11.06,Default,,0,0,0,,Тас сандық талай адамның өмірін құртты.
Dialogue: 0,0:10:11.15,0:10:13.32,Default,,0,0,0,,Мен адамдарды нашар естимін.
Dialogue: 0,0:10:13.40,0:10:17.57,Default,,0,0,0,,Соның кесірінен нұрлы болашағына нұқсан келгендердің бірі мен едім.
Dialogue: 0,0:10:17.65,0:10:20.53,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:10:21.20,0:10:24.16,Default,,0,0,0,,Бірақ соңы күлкілі болды.
Dialogue: 0,0:10:25.95,0:10:30.67,Default,,0,0,0,,Гелиоцентризм еретикалық идеология емес.
Dialogue: 0,0:10:31.42,0:10:34.30,Default,,0,0,0,,Бұл өте күлкілі.
Dialogue: 0,0:10:35.21,0:10:37.26,Default,,0,0,0,,Иә
Dialogue: 0,0:10:38.38,0:10:40.80,Default,,0,0,0,,Менде бұл болды.
Dialogue: 0,0:10:40.89,0:10:42.68,Default,,0,0,0,,Қайтару
Dialogue: 0,0:10:42.76,0:10:45.31,Default,,0,0,0,,Маған бұл енді керек емес
Dialogue: 0,0:10:45.39,0:10:48.18,Default,,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,0:10:49.19,0:10:50.19,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:10:50.27,0:10:53.61,Default,,0,0,0,,Мен оны қабылдай алмаймын, өйткені мен иллюзиямын.
Dialogue: 0,0:10:53.69,0:10:54.69,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:10:55.61,0:10:58.32,Default,,0,0,0,,Бұл енді мен үшін ғана емес
Dialogue: 0,0:11:00.99,0:11:02.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:03.45,0:11:08.54,Default,,0,0,0,,Қарғыс атсын, бұл болып жатқанына сене алар емеспін.
Dialogue: 0,0:11:09.58,0:11:11.08,Default,,0,0,0,,Мен...
Dialogue: 0,0:11:12.08,0:11:14.46,Default,,0,0,0,,Мен осы уақытқа дейін не істедім?
Dialogue: 0,0:11:15.92,0:11:18.01,Default,,0,0,0,,Жарайды, оған көмектесу мүмкін емес.
Dialogue: 0,0:11:18.51,0:11:21.93,Default,,0,0,0,,Біз әр жағдайда қолдан келгенді жасадық.
Dialogue: 0,0:11:22.01,0:11:23.05,Default,,0,0,0,,Бір-біріне
Dialogue: 0,0:11:23.76,0:11:25.85,Default,,0,0,0,,Бір-бірін емес
Dialogue: 0,0:11:26.60,0:11:29.39,Default,,0,0,0,,Сіз бен біз мүлдем басқамыз.
Dialogue: 0,0:11:29.48,0:11:31.44,Default,,0,0,0,,Бір қалпында емес
Dialogue: 0,0:11:33.19,0:11:37.44,Default,,0,0,0,,Мен гелиоцентрлік теорияның бидғат емес екенін түсіндім.
Dialogue: 0,0:11:38.65,0:11:41.70,Default,,0,0,0,,Бұл мүлдем күтпеген жағдай болды.
Dialogue: 0,0:11:43.20,0:11:44.66,Default,,0,0,0,,Мен...
Dialogue: 0,0:11:46.20,0:11:51.21,Default,,0,0,0,,Мен бұл оқиғаның қаскөйі болдым.
Dialogue: 0,0:11:54.54,0:11:58.63,Default,,0,0,0,,Тәтті, бұл күтпеген жағдай.
Dialogue: 0,0:12:00.26,0:12:01.47,Default,,0,0,0,,Әрине
Dialogue: 0,0:12:02.68,0:12:06.35,Default,,0,0,0,,Қарсыластық қарым-қатынаста болғанымыз рас.
Dialogue: 0,0:12:07.76,0:12:10.52,Default,,0,0,0,,Бұл дүниеде неше түрлі адамдар бар.
Dialogue: 0,0:12:10.60,0:12:16.23,Default,,0,0,0,,Адалдар, өтірікшілер, аяныштылар, батылдар.
Dialogue: 0,0:12:17.11,0:12:18.94,Default,,0,0,0,,Одан да таңғаларлық
Dialogue: 0,0:12:19.02,0:12:23.07,Default,,0,0,0,,Бұл элементтердің барлығы бір адамда болуы мүмкін.
Dialogue: 0,0:12:23.15,0:12:26.20,Default,,0,0,0,,Олар күн сайын өзгеруі мүмкін
Dialogue: 0,0:12:26.78,0:12:30.87,Default,,0,0,0,,Адам көп болса да, ешкім бірдей емес.
Dialogue: 0,0:12:31.62,0:12:34.87,Default,,0,0,0,,Сонда даудың соңы болмайды.
Dialogue: 0,0:12:36.13,0:12:38.63,Default,,0,0,0,,Бірақ.
Dialogue: 0,0:12:38.71,0:12:40.30,Default,,0,0,0,,Өткен және болашақ
Dialogue: 0,0:12:40.38,0:12:43.51,Default,,0,0,0,,Ұзақ уақыттан кейін «олардың» көзқарасы бойынша
Dialogue: 0,0:12:43.59,0:12:45.38,Default,,0,0,0,,Біз қазір қандаймыз, бәрібір.
Dialogue: 0,0:12:45.47,0:12:49.14,Default,,0,0,0,,Барлығымыз «15 ғасыр адамдарымыз»
Dialogue: 0,0:12:50.14,0:12:52.98,Default,,0,0,0,,Біз білмей тұрып, біз осы дәуірде болдық.
Dialogue: 0,0:12:53.06,0:12:56.10,Default,,0,0,0,,Бұл басқа дәуір болуы мүмкін еді, бірақ бұл осы болды.
Dialogue: 0,0:12:56.19,0:12:59.77,Default,,0,0,0,,Бұл жай ғана кездейсоқтық
Dialogue: 0,0:13:00.36,0:13:03.78,Default,,0,0,0,,Бұл ғажайып және тағдырлы
Dialogue: 0,0:13:03.86,0:13:06.74,Default,,0,0,0,,Бір идеологиямен туылғаннан гөрі
Dialogue: 0,0:13:06.82,0:13:10.78,Default,,0,0,0,,Менің ойымша, бұл бір дәуірде дүниеге келу әлдеқайда жақын болар еді.
Dialogue: 0,0:13:11.70,0:13:15.25,Default,,0,0,0,,Сондықтан да, мен бұлай емес деп ойлаймын,
Dialogue: 0,0:13:15.33,0:13:19.13,Default,,0,0,0,,Менің сезімдерім мен логикасым оны жоққа шығарса да, мен сенгім келеді
Dialogue: 0,0:13:20.13,0:13:23.30,Default,,0,0,0,,Қазір мұнда кездейсоқ өмір сүргендердің бәрі
Dialogue: 0,0:13:24.01,0:13:26.38,Default,,0,0,0,,Бір-бірімізді өлтіретіндей жек көрсек те
Dialogue: 0,0:13:26.47,0:13:29.30,Default,,0,0,0,,Мен бір дәуірді жасаған доспыз сияқты сезінемін.
Dialogue: 0,0:13:33.14,0:13:36.60,Default,,0,0,0,,Бір дәуірді жасаған достар...
Dialogue: 0,0:13:38.19,0:13:42.65,Default,,0,0,0,,Бұл мені жұбатады ма?
Dialogue: 0,0:13:44.24,0:13:45.65,Default,,0,0,0,,Әрине
Dialogue: 0,0:13:45.74,0:13:49.28,Default,,0,0,0,,Мен сен жасаған иллюзиямын.
Dialogue: 0,0:13:49.37,0:13:52.45,Default,,0,0,0,,Аа... сәлем
Dialogue: 0,0:13:53.58,0:13:56.33,Default,,0,0,0,,Бірақ бұған тоқмейілсуге болмайды.
Dialogue: 0,0:13:56.83,0:13:58.29,Default,,0,0,0,,Мен...
Dialogue: 0,0:13:58.37,0:14:02.50,Default,,0,0,0,,Менің саған деген сезімім болды.
Dialogue: 0,0:14:04.09,0:14:09.43,Default,,0,0,0,,Бірақ бұл сезімді еретиктер сезбеу керек.
Dialogue: 0,0:14:10.26,0:14:13.35,Default,,0,0,0,,Сондықтан мен ұмытып қалдым деп өмір сүріп келемін.
Dialogue: 0,0:14:14.68,0:14:15.98,Default,,0,0,0,,Не ол?
Dialogue: 0,0:14:19.35,0:14:20.98,Default,,0,0,0,,Бұл ауырсыну.
Dialogue: 0,0:14:22.02,0:14:26.19,Default,,0,0,0,,Сол кезде сенің таңдауыңа өкіндім.
Dialogue: 0,0:14:27.57,0:14:29.41,Default,,0,0,0,,Өлімді таңдама
Dialogue: 0,0:14:29.49,0:14:34.83,Default,,0,0,0,,Өз наным-сеніміңіз немесе басқалардың сенімі арқылы өлтіру үшін тым жас
Dialogue: 0,0:14:34.91,0:14:36.45,Default,,0,0,0,,Мен осылай ойладым
Dialogue: 0,0:14:37.71,0:14:39.25,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:14:39.33,0:14:41.75,Default,,0,0,0,,Менің ойымша, олай емес.
Dialogue: 0,0:14:42.63,0:14:46.26,Default,,0,0,0,,Сондықтан мен оны есімде сақтаймын.
Dialogue: 0,0:14:47.17,0:14:49.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:50.26,0:14:53.14,Default,,0,0,0,,Оны Құдай берген —
Dialogue: 0,0:14:53.22,0:14:56.72,Default,,0,0,0,,Бұл менің бірінші және соңғы мүмкіндігім болуы мүмкін.
Dialogue: 0,0:14:57.35,0:15:01.27,Default,,0,0,0,,Бірақ мен бұл сезімдерді елемеуге тым жалқау болдым.
Dialogue: 0,0:15:02.19,0:15:04.98,Default,,0,0,0,,Міне, мен солаймын
Dialogue: 0,0:15:06.23,0:15:07.78,Default,,0,0,0,,Ол зұлым адам.
Dialogue: 0,0:15:10.36,0:15:13.03,Default,,0,0,0,,(ағаштың құлаған дыбысы)
Dialogue: 0,0:15:16.16,0:15:19.08,Default,,0,0,0,,Тағы бірдеңе айтқыңыз келеді ме?
Dialogue: 0,0:15:20.12,0:15:24.42,Default,,0,0,0,,Бұл жер құлап, сен де өлесің.
Dialogue: 0,0:15:27.09,0:15:29.88,Default,,0,0,0,,Сіз білімдісіз бе?
Dialogue: 0,0:15:29.97,0:15:34.18,Default,,0,0,0,,Олай болса, соңында айтыңыз.
Dialogue: 0,0:15:35.89,0:15:40.56,Default,,0,0,0,,Менің қызым жәннатқа кетті ме?
Dialogue: 0,0:15:42.69,0:15:44.06,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:15:44.15,0:15:46.65,Default,,0,0,0,,Мен мұны сізге баяғыда айттым.
Dialogue: 0,0:15:46.73,0:15:49.32,Default,,0,0,0,,Өлгеннен кейін не болатынын ешкім білмейді.
Dialogue: 0,0:15:49.99,0:15:53.07,Default,,0,0,0,,Бірақ мұның болғанын қаласаңыз
Dialogue: 0,0:15:53.16,0:15:58.45,Default,,0,0,0,,Өзіңіз тірі кезінде істеу керек деп ойлайтын нәрсені жасаңыз.
Dialogue: 0,0:15:59.66,0:16:01.46,Default,,0,0,0,,Аяқталмаған іс
Dialogue: 0,0:16:03.17,0:16:04.96,Default,,0,0,0,,Қош бол
Dialogue: 0,0:16:09.92,0:16:12.84,Default,,0,0,0,,(жану дыбысы)
Dialogue: 0,0:16:40.87,0:16:42.71,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:43.21,0:16:45.62,Default,,0,0,0,,Сіз де таптыңыз.
Dialogue: 0,0:16:46.92,0:16:51.63,Default,,0,0,0,,Сол себепті мен тозаққа баруға дайын едім.
Dialogue: 0,0:16:57.22,0:16:58.47,Default,,0,0,0,,Жақсы қыз бол және барынша тырыс, жарай ма?
Dialogue: 0,0:17:00.85,0:17:02.39,Default,,0,0,0,,Жақсы қыз бол және барынша тырыс, жарай ма?
Dialogue: 0,0:17:03.18,0:17:08.19,Default,,0,0,0,,Қызымның барлық қателіктері менің түсінбеуімнен.
Dialogue: 0,0:17:08.27,0:17:11.02,Default,,0,0,0,,Бәріне менің кінәм.
Dialogue: 0,0:17:12.99,0:17:16.49,Default,,0,0,0,,Егер гелиоцентрлік теория сізге қарсы болмаса
Dialogue: 0,0:17:17.24,0:17:18.07,Default,,0,0,0,,(Жыйрау дыбысы)
Dialogue: 0,0:17:18.07,0:17:18.95,Default,,0,0,0,,(Жыйрау дыбысы)
Dialogue: 0,0:17:18.07,0:17:18.95,Default,,0,0,0,,Өтінемін... өтінемін
Dialogue: 0,0:17:18.95,0:17:20.99,Default,,0,0,0,,Өтінемін... өтінемін
Dialogue: 0,0:17:22.49,0:17:23.70,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:17:25.96,0:17:29.96,Default,,0,0,0,,Өтінемін, қызым жәннатқа барсын.
Dialogue: 0,0:17:35.30,0:17:38.55,Default,,0,0,0,,Аспанға...
Dialogue: 0,0:17:39.64,0:17:41.31,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:18:01.16,0:18:03.87,Default,,0,0,0,,(Жыйрау дыбысы)
Dialogue: 0,0:18:06.04,0:18:11.13,Default,,0,0,0,,(Дураканың ауыр тыныс алуы)
Dialogue: 0,0:18:18.38,0:18:19.64,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:37.49,0:18:41.16,Default,,0,0,0,,Ақымақ болма, қарғыс атсын.
Dialogue: 0,0:18:41.24,0:18:42.53,Default,,0,0,0,,пышақталған
Dialogue: 0,0:18:49.50,0:18:50.96,Default,,0,0,0,,Я...
Dialogue: 0,0:18:52.33,0:18:53.25,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:04.26,0:19:05.97,Default,,0,0,0,,Я...
Dialogue: 0,0:19:07.68,0:19:10.06,Default,,0,0,0,,Өлме.
Dialogue: 0,0:19:12.06,0:19:12.90,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:19:16.98,0:19:18.78,Default,,0,0,0,,Қате жіберді
Dialogue: 0,0:19:19.49,0:19:22.57,Default,,0,0,0,,Өлген соң бәрі бітеді.
Dialogue: 0,0:19:22.66,0:19:24.78,Default,,0,0,0,,Құдай жоқ және ақырет жоқ.
Dialogue: 0,0:19:24.87,0:19:30.12,Default,,0,0,0,,Тапқан ақшам, алған білімім, болашақты көремін.
Dialogue: 0,0:19:30.21,0:19:31.67,Default,,0,0,0,,Мұның бәрі бекер
Dialogue: 0,0:19:32.46,0:19:36.92,Default,,0,0,0,,Бұл жерде аяқталады.
Dialogue: 0,0:19:38.01,0:19:43.43,Default,,0,0,0,,Менің өмірім не үшін қажет?
Dialogue: 0,0:19:44.60,0:19:45.43,Default,,0,0,0,,Ах
Dialogue: 0,0:19:59.40,0:20:00.69,Default,,0,0,0,,Ах
Dialogue: 0,0:20:04.78,0:20:09.79,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:20:48.87,0:20:51.95,Default,,0,0,0,,Иә, кезекке тұрыңыз.
Dialogue: 0,0:20:52.54,0:20:57.13,Default,,0,0,0,,Мен мұнда бірінші рет келіп тұрмын және бұл қауесет сияқты танымал.
Dialogue: 0,0:20:57.21,0:20:58.59,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:20:59.38,0:21:01.17,Default,,0,0,0,,Тапсырысыңызбен не істегіңіз келеді?
Dialogue: 0,0:21:01.67,0:21:04.05,Default,,0,0,0,,Әй, сен менің ұлымсың ба?
Dialogue: 0,0:21:04.13,0:21:07.97,Default,,0,0,0,,Не? О, жоқ, маған осында қамқор болғаныңызға рахмет.
Dialogue: 0,0:21:08.05,0:21:09.47,Default,,0,0,0,,Иә
Dialogue: 0,0:21:09.55,0:21:10.97,Default,,0,0,0,,Сонымен, сен қайдансың?
Dialogue: 0,0:21:12.81,0:21:14.10,Default,,0,0,0,,осы портта бір жерде жасырынып, бізді бақылап отыр.
Dialogue: 0,0:21:16.60,0:21:17.52,Default,,0,0,0,,(тақтаға соғылған дыбыс)
Dialogue: 0,0:21:17.52,0:21:18.36,Default,,0,0,0,,(тақтаға соғылған дыбыс)
Dialogue: 0,0:21:17.52,0:21:18.36,Default,,0,0,0,,Ах
Dialogue: 0,0:21:18.94,0:21:22.36,Default,,0,0,0,,Иә, иә, күткеніңізге рахмет. Ол пісірілген.
Dialogue: 0,0:21:22.44,0:21:24.78,Default,,0,0,0,,- (Қонақтар) О! -(Ұстаз) Жарайды, мен сатып алдым. Мен оны сатып алдым.
Dialogue: 0,0:21:27.74,0:21:30.49,Default,,0,0,0,,Жоқ, сен де бүгін қиналып жүрсің.
Dialogue: 0,0:21:30.58,0:21:32.49,Default,,0,0,0,,Сіздерге де рахмет, еңбектеріңіз үшін, ата-аналар.
Dialogue: 0,0:21:33.12,0:21:35.12,Default,,0,0,0,,Хмм... аа
Dialogue: 0,0:21:36.16,0:21:40.09,Default,,0,0,0,,Иә, Альберто, саған айтар сөзім бар.
Dialogue: 0,0:21:40.17,0:21:41.00,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:21:43.09,0:21:45.55,Default,,0,0,0,,Нақтырақ айтыңыз
Dialogue: 0,0:21:47.38,0:21:49.01,Default,,0,0,0,,Сіз университетке түсе аласыз!
Dialogue: 0,0:21:50.14,0:21:51.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:51.35,0:21:54.85,Default,,0,0,0,,Хехехе, таң қалуың керек.
Dialogue: 0,0:21:54.93,0:21:56.52,Default,,0,0,0,,Бірақ уайымдамаңыз
Dialogue: 0,0:21:56.60,0:21:57.77,Default,,0,0,0,,Ал, тыңда.
Dialogue: 0,0:21:57.85,0:22:00.94,Default,,0,0,0,,Өздеріңіз білетіндей, біз наубайшылармыз.
Dialogue: 0,0:22:01.02,0:22:03.48,Default,,0,0,0,,Билік сатып алған бидай мөлшеріне байланысты
Dialogue: 0,0:22:03.57,0:22:07.45,Default,,0,0,0,,Біз нанды лайықты баға мен мөлшерде ұсынуымыз керек.
Dialogue: 0,0:22:07.53,0:22:09.53,Default,,0,0,0,,Сен ақылдысың
Dialogue: 0,0:22:09.61,0:22:14.04,Default,,0,0,0,,Нарықтық бағаларды болжау және дөрекі бағалаулар жасау үшін ақпарат жинаңыз
Dialogue: 0,0:22:14.12,0:22:18.58,Default,,0,0,0,,Осы сан арқылы мен нанның тамаша қоспасы мен мөлшерін жасай аламын.
Dialogue: 0,0:22:18.67,0:22:21.13,Default,,0,0,0,,Сізге рахмет, дүкен қауіпсіз.
Dialogue: 0,0:22:21.21,0:22:23.71,Default,,0,0,0,,Сіз осы дүкеннің несиесісіз.
Dialogue: 0,0:22:25.55,0:22:27.38,Default,,0,0,0,,Сонымен
Dialogue: 0,0:22:27.47,0:22:29.80,Default,,0,0,0,,Университетке бару үшін барлық шығындарды төлеймін.
Dialogue: 0,0:22:29.89,0:22:31.30,Default,,0,0,0,,Рахмет
Dialogue: 0,0:22:31.39,0:22:33.56,Default,,0,0,0,,Сұрауыңызды қабылдамаймыз.
Dialogue: 0,0:22:33.64,0:22:34.47,Default,,0,0,0,,Әй?
Dialogue: 0,0:22:35.81,0:22:39.10,Default,,0,0,0,,Мен университетке түскім келеді дедім бе?
Dialogue: 0,0:22:39.19,0:22:44.36,Default,,0,0,0,,Жоқ, сен ақылды екенсің, оқуды ұнатамын деуші едің.
Dialogue: 0,0:22:44.44,0:22:46.53,Default,,0,0,0,,Академиктерге қатысты ештеңе істей алмаймын.
Dialogue: 0,0:22:46.61,0:22:48.11,Default,,0,0,0,,- (Ұстаз) А... - Бұл мағынасыз.
Dialogue: 0,0:22:48.20,0:22:51.11,Default,,0,0,0,,Жоқ, бұл одан да зиянды.
Dialogue: 0,0:22:51.78,0:22:53.58,Default,,0,0,0,,Қызығушылық адамды жейді
Dialogue: 0,0:22:54.08,0:22:58.25,Default,,0,0,0,,Зерттеу ақырында жеке мақсатқа айналады және бақылаудан шығады.
Dialogue: 0,0:22:59.00,0:23:02.25,Default,,0,0,0,,Ұзын сөздің қысқасы, араласпаған дұрыс.
Dialogue: 0,0:23:02.88,0:23:04.17,Default,,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,0:23:04.25,0:23:07.63,Default,,0,0,0,,Мен сіздің өткен қиындықтарыңызды түсінбеймін.
Dialogue: 0,0:23:07.71,0:23:10.34,Default,,0,0,0,,Мен мұқият болуым керек еді.
Dialogue: 0,0:23:10.43,0:23:13.14,Default,,0,0,0,,Иә, мен сіздің сезімдеріңізді бағалаймын.
Dialogue: 0,0:23:13.22,0:23:15.76,Default,,0,0,0,,Өткенді ұмытқым келеді.
Dialogue: 0,0:23:16.35,0:23:19.89,Default,,0,0,0,,Қанша тірлік жасай алсам, көңілім толады.
Dialogue: 0,0:23:19.98,0:23:22.27,Default,,0,0,0,,Мен басқа ештеңе қаламаймын
Dialogue: 0,0:23:22.77,0:23:24.31,Default,,0,0,0,,Оның мойны… кесіліп қалған жоқ па?
Dialogue: 0,0:23:26.07,0:23:29.90,Default,,0,0,0,,Онда неге астролябыңды тастамайсың?
Dialogue: 0,0:23:30.99,0:23:35.99,Default,,0,0,0,,♪~
Dialogue: 0,0:24:54.03,0:24:59.03,Default,,0,0,0,,~♪
Dialogue: 0,0:25:00.53,0:25:06.53,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory