Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.17,0:00:08.38,Default,,0000,0000,0000,,Олар сен үшін қатты уайымдады.
Dialogue: 0,0:00:03.17,0:00:08.38,Default,,0000,0000,0000,,<Тиын ұсынсаң, нан аласың. ➡
Dialogue: 0,0:00:08.38,0:00:13.21,Default,,0000,0000,0000,,Салық берсеңіз, құқық аласыз. ➡
Dialogue: 0,0:00:13.21,0:00:16.92,Default,,0000,0000,0000,,Еңбегіңді арнасаң, сый аласың＞
Dialogue: 0,0:00:26.86,0:00:30.50,Default,,0000,0000,0000,,＜Онда мен не ұсына аламын➡
Dialogue: 0,0:00:30.50,0:00:33.60,Default,,0000,0000,0000,,Сіз бұл дүние туралы бәрін біле аласыз ба? ＞
Dialogue: 0,0:00:42.74,0:01:39.73,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:01:39.73,0:01:43.14,Default,,0000,0000,0000,,Витик 3 дана. ➡
Dialogue: 0,0:01:43.14,0:01:46.04,Default,,0000,0000,0000,,Мазуру-сан 2 дана. ➡
Dialogue: 0,0:01:46.04,0:01:49.64,Default,,0000,0000,0000,,Болански мырза 4 дана.
Dialogue: 0,0:01:51.91,0:01:55.42,Default,,0000,0000,0000,,Мен мұны осы жұмысты алған соң түсіндім➡
Dialogue: 0,0:01:55.42,0:02:00.89,Default,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:01:55.42,0:02:00.89,Default,,0000,0000,0000,,Тырнақтарыңыз түскенде сізді не мазалайды?
Dialogue: 0,0:02:00.89,0:02:04.09,Default,,0000,0000,0000,,Ха….
Dialogue: 0,0:02:04.09,0:02:07.69,Default,,0000,0000,0000,,Сондай-ақ... заттарды ұстай алмау...
Dialogue: 0,0:02:07.69,0:02:11.30,Default,,0000,0000,0000,,Шегесіз ұстайтын күш жоқ.
Dialogue: 0,0:02:11.30,0:02:15.24,Default,,0000,0000,0000,,О! Ғалым күткендей! ➡
Dialogue: 0,0:02:15.24,0:02:18.51,Default,,0000,0000,0000,,да дұрыс емес.
Dialogue: 0,0:02:15.24,0:02:18.51,Default,,0000,0000,0000,,Иә!?
Dialogue: 0,0:02:18.51,0:02:21.41,Default,,0000,0000,0000,,Жауабы «қатты ауырсыну». ➡
Dialogue: 0,0:02:21.41,0:02:25.71,Default,,0000,0000,0000,,Өйткені, бәрі қарапайым.
Dialogue: 0,0:02:21.41,0:02:25.71,Default,,0000,0000,0000,,Бұл ең қиыны сияқты. ➡
Dialogue: 0,0:02:25.71,0:02:29.12,Default,,0000,0000,0000,,Ха ха ха ха ха ха….
Dialogue: 0,0:02:34.05,0:02:36.29,Default,,0000,0000,0000,,Ах, а...
Dialogue: 0,0:02:36.29,0:02:38.22,Default,,0000,0000,0000,,Қазір➡
Dialogue: 0,0:02:38.22,0:02:44.43,Default,,0000,0000,0000,,Шіркеуді бұзатын еретикалық идеялар деп саналатын зерттеу материалдары
Dialogue: 0,0:02:38.22,0:02:44.43,Default,,0000,0000,0000,,Оны қайда жасырдың?
Dialogue: 0,0:02:48.23,0:02:50.54,Default,,0000,0000,0000,,Қайда?
Dialogue: 0,0:02:48.23,0:02:50.54,Default,,0000,0000,0000,,Фалкооо!! Қайдасыңңң!!
Dialogue: 0,0:02:52.64,0:02:56.01,Default,,0000,0000,0000,,Ааааа! ! А... Қуа...! ➡
Dialogue: 0,0:02:56.01,0:02:58.75,Default,,0000,0000,0000,,Ууууу... ку...!
Dialogue: 0,0:02:58.75,0:03:01.08,Default,,0000,0000,0000,,Материалдар қайда?
Dialogue: 0,0:03:01.08,0:03:03.55,Default,,0000,0000,0000,,Қарғыс атсын... О ➡
Dialogue: 0,0:03:03.55,0:03:08.12,Default,,0000,0000,0000,,бойынша
Dialogue: 0,0:03:03.55,0:03:08.12,Default,,0000,0000,0000,,Шындықты сен сияқты адамдар басқара алмайды! !
Dialogue: 0,0:03:08.12,0:03:13.26,Default,,0000,0000,0000,,Не? Мүмкін
Dialogue: 0,0:03:08.12,0:03:13.26,Default,,0000,0000,0000,,Сіз психикалық күштісіз бе?
Dialogue: 0,0:03:13.26,0:03:17.70,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:03:13.26,0:03:17.70,Default,,0000,0000,0000,,Оны алу үшін уақыт қажет...
Dialogue: 0,0:03:17.70,0:03:20.13,Default,,0000,0000,0000,,Мен үйге кеш келемін...
Dialogue: 0,0:03:20.13,0:03:23.47,Default,,0000,0000,0000,,Бұл... бар болғаны 10 дана...
Dialogue: 0,0:03:23.47,0:03:25.47,Default,,0000,0000,0000,,Тез аяқтаңыз! !
Dialogue: 0,0:03:29.28,0:03:31.48,Default,,0000,0000,0000,,(үстелге шашылған шегелердің дыбысы)
Dialogue: 0,0:03:29.28,0:03:31.48,Default,,0000,0000,0000,,⁉
Dialogue: 0,0:03:36.62,0:03:40.15,Default,,0000,0000,0000,,Негри мырза 68 дана.
Dialogue: 0,0:03:40.15,0:03:44.96,Default,,0000,0000,0000,,А…?
Dialogue: 0,0:03:40.15,0:03:44.96,Default,,0000,0000,0000,,Тырнақтар қайта өседі.
Dialogue: 0,0:03:44.96,0:03:47.46,Default,,0000,0000,0000,,А... аа...!
Dialogue: 0,0:03:49.40,0:03:51.93,Default,,0000,0000,0000,,Бәріңе сәлем! Бұл проблема!
Dialogue: 0,0:03:51.93,0:03:55.27,Default,,0000,0000,0000,,Әлемнің орталығында не бар?
Dialogue: 0,0:03:55.27,0:03:57.20,Default,,0000,0000,0000,,Ха! Мұғалім Иә!
Dialogue: 0,0:03:57.20,0:04:00.44,Default,,0000,0000,0000,,О! Олай болса, Кохански!
Dialogue: 0,0:04:00.44,0:04:02.38,Default,,0000,0000,0000,,Бұл «махаббат»!
Dialogue: 0,0:04:02.38,0:04:07.11,Default,,0000,0000,0000,,Әлемнің орталығы – Құдайдың сүйіспеншілігі
Dialogue: 0,0:04:02.38,0:04:07.11,Default,,0000,0000,0000,,Толып жатыр деп ойлаймын!
Dialogue: 0,0:04:07.11,0:04:10.05,Default,,0000,0000,0000,,Хахахаха! бұл дұрыс!
Dialogue: 0,0:04:10.05,0:04:13.05,Default,,0000,0000,0000,,Бірақ бұл аздап дерексіз деп ойлаймын.
Dialogue: 0,0:04:13.05,0:04:15.82,Default,,0000,0000,0000,,Тағы не...? о! ➡
Dialogue: 0,0:04:15.82,0:04:18.42,Default,,0000,0000,0000,,Жарайсың Рафау!
Dialogue: 0,0:04:15.82,0:04:18.42,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:04:21.13,0:04:25.80,Default,,0000,0000,0000,,Әлемнің орталығы, әрине, Жер.
Dialogue: 0,0:04:25.80,0:04:29.67,Default,,0000,0000,0000,,Бірнеше негіздер бар
Dialogue: 0,0:04:25.80,0:04:29.67,Default,,0000,0000,0000,,Жартас
Dialogue: 0,0:04:25.80,0:04:29.67,Default,,0000,0000,0000,,Аристотель➡ дейді
Dialogue: 0,0:04:29.67,0:04:34.17,Default,,0000,0000,0000,,«Ауыр заттар түбіне түседі».
Dialogue: 0,0:04:34.17,0:04:37.71,Default,,0000,0000,0000,,Заттардың үнемі жерге түсуінің себебі – жер➡
Dialogue: 0,0:04:37.71,0:04:42.22,Default,,0000,0000,0000,,Әлемдегі ең төменгі нүкте
Dialogue: 0,0:04:37.71,0:04:42.22,Default,,0000,0000,0000,,Өйткені ол «орталықта».
Dialogue: 0,0:04:42.22,0:04:45.49,Default,,0000,0000,0000,,Дұрыс!
Dialogue: 0,0:04:42.22,0:04:45.49,Default,,0000,0000,0000,,О!
Dialogue: 0,0:04:45.49,0:04:48.69,Default,,0000,0000,0000,,Ұлы
Dialogue: 0,0:04:45.49,0:04:48.69,Default,,0000,0000,0000,,Күтілгендей! Менің өгей балам!
Dialogue: 0,0:04:48.69,0:04:50.69,Default,,0000,0000,0000,,Бұл құрмет! Потоцки мырза!
Dialogue: 0,0:04:50.69,0:04:54.83,Default,,0000,0000,0000,,Қарап отырмасаң, байқамайсың.
Dialogue: 0,0:04:50.69,0:04:54.83,Default,,0000,0000,0000,,Сіз аздап мақтанасыз ба?
Dialogue: 0,0:04:54.83,0:04:59.50,Default,,0000,0000,0000,,Жоқ, бұл шектен шыққан.
Dialogue: 0,0:04:54.83,0:04:59.50,Default,,0000,0000,0000,,Мақтану осы жерден басталады.
Dialogue: 0,0:04:59.50,0:05:02.20,Default,,0000,0000,0000,,Бір қызығы, бұл жолы Рафау➡
Dialogue: 0,0:05:02.20,0:05:05.24,Default,,0000,0000,0000,,Мен университетке барамын!
Dialogue: 0,0:05:02.20,0:05:05.24,Default,,0000,0000,0000,,Иә! !
Dialogue: 0,0:05:05.24,0:05:08.54,Default,,0000,0000,0000,,Қазіргі заманда
Dialogue: 0,0:05:05.24,0:05:08.54,Default,,0000,0000,0000,,Университетке санаулы адам ғана түсе алады➡
Dialogue: 0,0:05:08.54,0:05:14.35,Default,,0000,0000,0000,,Сонымен қатар, 12 жаста жоғары оқу орындарында не болып жатыр?
Dialogue: 0,0:05:08.54,0:05:14.35,Default,,0000,0000,0000,,Бірдеңе дұрыс емес, сондықтан тойлайық!
Dialogue: 0,0:05:14.35,0:05:18.22,Default,,0000,0000,0000,,⚟Уау!
Dialogue: 0,0:05:14.35,0:05:18.22,Default,,0000,0000,0000,,⚟Шынымен!
Dialogue: 0,0:05:14.35,0:05:18.22,Default,,0000,0000,0000,,⚟Тамаша!
Dialogue: 0,0:05:18.22,0:05:22.96,Default,,0000,0000,0000,,Рафау университетінде не оқисыз?
Dialogue: 0,0:05:18.22,0:05:22.96,Default,,0000,0000,0000,,Сіздің ойыңызша, бұл қолайлы ма?
Dialogue: 0,0:05:22.96,0:05:25.86,Default,,0000,0000,0000,,⚟Математика?
Dialogue: 0,0:05:22.96,0:05:25.86,Default,,0000,0000,0000,,⚟Медициналық техника?
Dialogue: 0,0:05:22.96,0:05:25.86,Default,,0000,0000,0000,,⚟География?
Dialogue: 0,0:05:25.86,0:05:27.79,Default,,0000,0000,0000,,N….
Dialogue: 0,0:05:27.79,0:05:33.60,Default,,0000,0000,0000,,Әрине! Мен «теологияны» оқығым келеді.
Dialogue: 0,0:05:27.79,0:05:33.60,Default,,0000,0000,0000,,О! !
Dialogue: 0,0:05:33.60,0:05:38.27,Default,,0000,0000,0000,,Ани туралы маңызды ақпаратқа
Dialogue: 0,0:05:33.60,0:05:38.27,Default,,0000,0000,0000,,Теология – барлық ғылымның шыңы.
Dialogue: 0,0:05:38.27,0:05:42.14,Default,,0000,0000,0000,,Тірі қалғанымыз Аллаға шүкір.
Dialogue: 0,0:05:42.14,0:05:45.48,Default,,0000,0000,0000,,Киелі кітаптағы сөздерді логикалық түрде түсіндіріңіз➡
Dialogue: 0,0:05:45.48,0:05:49.48,Default,,0000,0000,0000,,Дінтану – адамның сенімін тереңдететін ілім.
Dialogue: 0,0:05:49.48,0:05:53.62,Default,,0000,0000,0000,,Менің қабілетім басқа адамдарға қарағанда көбірек.
Dialogue: 0,0:05:49.48,0:05:53.62,Default,,0000,0000,0000,,Мен олай ойламаймын.
Dialogue: 0,0:05:53.62,0:05:56.12,Default,,0000,0000,0000,,Менің жолым болды.
Dialogue: 0,0:05:56.12,0:06:03.93,Default,,0000,0000,0000,,Сондықтан мен бұл жақсылығымды аз да болса өтей аламын деп үміттенемін.
Dialogue: 0,0:05:56.12,0:06:03.93,Default,,0000,0000,0000,,Мен сенушілерге пайдалы болатын пәнді таңдағым келеді.
Dialogue: 0,0:06:03.93,0:06:07.53,Default,,0000,0000,0000,,Суба
Dialogue: 0,0:06:03.93,0:06:07.53,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:06:03.93,0:06:07.53,Default,,0000,0000,0000,,Қандай тамаша!
Dialogue: 0,0:06:07.53,0:06:10.64,Default,,0000,0000,0000,,(қол шапалақтау және леп айту)
Dialogue: 0,0:06:07.53,0:06:10.64,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:06:13.91,0:06:17.01,Default,,0000,0000,0000,,<Әлемдік холе~~! ! ＞
Dialogue: 0,0:06:21.65,0:06:26.79,Default,,0000,0000,0000,,<Кешіріңіз, бірақ
Dialogue: 0,0:06:21.65,0:06:26.79,Default,,0000,0000,0000,,Бұл дүние ақымақтарға толы. ➡
Dialogue: 0,0:06:26.79,0:06:29.56,Default,,0000,0000,0000,,Мен де жетім болып туылғанмын➡
Dialogue: 0,0:06:29.56,0:06:33.36,Default,,0000,0000,0000,,Маған келетін болсақ
Dialogue: 0,0:06:29.56,0:06:33.36,Default,,0000,0000,0000,,Фубин
Dialogue: 0,0:06:29.56,0:06:33.36,Default,,0000,0000,0000,,Сән-салтанат
Dialogue: 0,0:06:29.56,0:06:33.36,Default,,0000,0000,0000,,«Кедейлік», «бейшара», «өкінішті» және «осал»➡
Dialogue: 0,0:06:33.36,0:06:36.06,Default,,0000,0000,0000,,Ол оралған элементтермен оралған. ➡
Dialogue: 0,0:06:36.06,0:06:40.37,Default,,0000,0000,0000,,Жауап беріңіз…
Dialogue: 0,0:06:36.06,0:06:40.37,Default,,0000,0000,0000,,бұған дейін жақсы өмір сүрген. ➡
Dialogue: 0,0:06:40.37,0:06:43.60,Default,,0000,0000,0000,,(Реинер) Гү!
Dialogue: 0,0:06:40.37,0:06:43.60,Default,,0000,0000,0000,,Бұл да керемет. ➡
Dialogue: 0,0:06:43.60,0:06:47.47,Default,,0000,0000,0000,,Менің кредом – «рационалды өмір сүру». ➡
Dialogue: 0,0:06:47.47,0:06:52.81,Default,,0000,0000,0000,,«махаббат» сияқты бос эмоциялар
Dialogue: 0,0:06:47.47,0:06:52.81,Default,,0000,0000,0000,,Пайдасыз қалауларға алданып қалмаңыз➡
Dialogue: 0,0:06:52.81,0:06:57.02,Default,,0000,0000,0000,,Ақылға қонымды таңдау жасасаңыз
Dialogue: 0,0:06:52.81,0:06:57.02,Default,,0000,0000,0000,,Сіз бұл әлемде жайлы өмір сүре аласыз＞
Dialogue: 0,0:07:00.35,0:07:04.99,Default,,0000,0000,0000,,<Рационалды нәрсе әрқашан әдемі. ➡
Dialogue: 0,0:07:04.99,0:07:08.23,Default,,0000,0000,0000,,Мен сол сеніммен жүрдім, енді ➡
Dialogue: 0,0:07:08.23,0:07:13.03,Default,,0000,0000,0000,,Олар Тайбар әулетінің күзетшілері…
Dialogue: 0,0:07:08.23,0:07:13.03,Default,,0000,0000,0000,,«Кінәсіз» және «ақылды»
Dialogue: 0,0:07:08.23,0:07:13.03,Default,,0000,0000,0000,,«Кішіпейіл» және «ықпалды» деп саналады>
Dialogue: 0,0:07:15.33,0:07:18.30,Default,,0000,0000,0000,,Біз оқиға орнына бірінші жетеміз.
Dialogue: 0,0:07:15.33,0:07:18.30,Default,,0000,0000,0000,,Университет керемет, Рафау-кун!
Dialogue: 0,0:07:18.30,0:07:20.31,Default,,0000,0000,0000,,Сіз мұны мақтан ете аласыз!
Dialogue: 0,0:07:20.31,0:07:23.54,Default,,0000,0000,0000,,Жоқ, жоқ, мен емес.
Dialogue: 0,0:07:23.54,0:07:26.85,Default,,0000,0000,0000,,
Dialogue: 0,0:07:23.54,0:07:26.85,Default,,0000,0000,0000,,＜Осындай қарапайым адам Кохански мырза➡
Dialogue: 0,0:07:26.85,0:07:30.58,Default,,0000,0000,0000,,Сіз мені бірден сыйлайсыз.
Dialogue: 0,0:07:26.85,0:07:30.58,Default,,0000,0000,0000,,Өте қолайлы>
Dialogue: 0,0:07:30.58,0:07:34.25,Default,,0000,0000,0000,,Абсолютті данышпан!
Dialogue: 0,0:07:30.58,0:07:34.25,Default,,0000,0000,0000,,Жоқ, жоқ.
Dialogue: 0,0:07:34.25,0:07:37.22,Default,,0000,0000,0000,,Дана адам!
Dialogue: 0,0:07:34.25,0:07:37.22,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:07:37.22,0:07:40.13,Default,,0000,0000,0000,,Дәлірек айтқанда, Құдай!
Dialogue: 0,0:07:37.22,0:07:40.13,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:07:44.66,0:07:48.17,Default,,0000,0000,0000,,Құдай? Сен не туралы айтып тұрсың?
Dialogue: 0,0:07:48.17,0:07:50.77,Default,,0000,0000,0000,,Адам Құдай бола алмайды.
Dialogue: 0,0:07:50.77,0:07:54.11,Default,,0000,0000,0000,,Өтінішіңізді қайтарып алыңыз.
Dialogue: 0,0:07:54.11,0:07:56.51,Default,,0000,0000,0000,,бұл….
Dialogue: 0,0:07:56.51,0:08:01.41,Default,,0000,0000,0000,,Мен өз мәлімдемемнен бас тартамын. Кешіріңіз...
Dialogue: 0,0:08:01.41,0:08:04.55,Default,,0000,0000,0000,,Бұдан былай сақ болыңыз.
Dialogue: 0,0:08:04.55,0:08:07.95,Default,,0000,0000,0000,,<ақымақ
Dialogue: 0,0:08:04.55,0:08:07.95,Default,,0000,0000,0000,,Айтуға болмайтын нәрселер бар...＞
Dialogue: 0,0:08:09.99,0:08:14.39,Default,,0000,0000,0000,,Осымен бүгінгі лекция аяқталды.
Dialogue: 0,0:08:09.99,0:08:14.39,Default,,0000,0000,0000,,Алла разы болсын!
Dialogue: 0,0:08:17.23,0:08:21.10,Default,,0000,0000,0000,,Иә, Рафау.
Dialogue: 0,0:08:17.23,0:08:21.10,Default,,0000,0000,0000,,Менің сізден сұрайын дегенім бар.
Dialogue: 0,0:08:17.23,0:08:21.10,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:08:21.10,0:08:24.97,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:08:21.10,0:08:24.97,Default,,0000,0000,0000,,Бұл... иә?
Dialogue: 0,0:08:24.97,0:08:27.87,Default,,0000,0000,0000,,Сейхё
Dialogue: 0,0:08:24.97,0:08:27.87,Default,,0000,0000,0000,,Бұл жұлдыздар каталогы ма?
Dialogue: 0,0:08:24.97,0:08:27.87,Default,,0000,0000,0000,,А... иә!
Dialogue: 0,0:08:27.87,0:08:33.38,Default,,0000,0000,0000,,Кеше мен бірінші рет 6-шы жұлдызды байқадым.
Dialogue: 0,0:08:27.87,0:08:33.38,Default,,0000,0000,0000,,Мен қатты толқып кеттім!
Dialogue: 0,0:08:33.38,0:08:36.28,Default,,0000,0000,0000,,Мен көремін. Енді бұлай істеуді доғар.
Dialogue: 0,0:08:36.28,0:08:38.25,Default,,0000,0000,0000,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,0:08:38.25,0:08:43.26,Default,,0000,0000,0000,,Бұдан былай мен барлық уақытымды теологияға арнаймын.
Dialogue: 0,0:08:38.25,0:08:43.26,Default,,0000,0000,0000,,Астрономиямен айналысуды тоқтатыңыз.
Dialogue: 0,0:08:44.99,0:08:48.66,Default,,0000,0000,0000,,Тек жалаңаш, бос жер учаскесін қалдырады…
Dialogue: 0,0:08:48.66,0:08:51.63,Default,,0000,0000,0000,,Жарайды... Керемет.
Dialogue: 0,0:08:51.63,0:08:55.07,Default,,0000,0000,0000,,Жақсы! Сұрайын дегенім бар➡
Dialogue: 0,0:08:55.07,0:09:00.21,Default,,0000,0000,0000,,Ертең менің танысым
Dialogue: 0,0:08:55.07,0:09:00.21,Default,,0000,0000,0000,,Мен Губерттің қамқорлығын алуыңызды қалаймын.
Dialogue: 0,0:09:00.21,0:09:04.64,Default,,0000,0000,0000,,Губерт мырза еретик ретінде
Dialogue: 0,0:09:00.21,0:09:04.64,Default,,0000,0000,0000,,Ол қамауға алынды, солай ма?
Dialogue: 0,0:09:04.64,0:09:07.68,Default,,0000,0000,0000,,«Тыйым салынған зерттеулер» т.б.
Dialogue: 0,0:09:07.68,0:09:09.98,Default,,0000,0000,0000,,Оны қайтарып алғыңыз келетініне сенімдісіз бе?
Dialogue: 0,0:09:09.98,0:09:14.42,Default,,0000,0000,0000,,О, жарайды.
Dialogue: 0,0:09:09.98,0:09:14.42,Default,,0000,0000,0000,,Ол санасын түзегендіктен босатылады.
Dialogue: 0,0:09:14.42,0:09:18.66,Default,,0000,0000,0000,,Кейкен
Dialogue: 0,0:09:14.42,0:09:18.66,Default,,0000,0000,0000,,Күнәларды кешіре білу де тақуа мүміндердің белгісі.
Dialogue: 0,0:09:18.66,0:09:21.59,Default,,0000,0000,0000,,Тұрғын үйге келетін болсақ, мен жеке үйімді жалға беремін.
Dialogue: 0,0:09:21.59,0:09:24.26,Default,,0000,0000,0000,,Жарайды, мен оны сұрадым.
Dialogue: 0,0:09:24.26,0:09:28.00,Default,,0000,0000,0000,,(аяқ дыбысы)
Dialogue: 0,0:09:28.00,0:09:30.10,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:09:40.35,0:09:45.55,Default,,0000,0000,0000,,Бұдан былай мен барлық уақытымды теологияға арнаймын.
Dialogue: 0,0:09:40.35,0:09:45.55,Default,,0000,0000,0000,,Астрономиямен айналысуды тоқтатыңыз.
Dialogue: 0,0:09:47.12,0:09:52.86,Default,,0000,0000,0000,,<Әрине.
Dialogue: 0,0:09:47.12,0:09:52.86,Default,,0000,0000,0000,,Менің астрономиямен айналысуға уақытым жоқ...＞
Dialogue: 0,0:09:52.86,0:09:54.86,Default,,0000,0000,0000,,Фалько…
Dialogue: 0,0:10:00.17,0:10:02.17,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:10:04.50,0:10:07.17,Default,,0000,0000,0000,,Мм! Қарғыс атқыр...
Dialogue: 0,0:10:07.17,0:10:12.41,Default,,0000,0000,0000,,<Жоқ, жоқ, аспанды ұмыт.
Dialogue: 0,0:10:07.17,0:10:12.41,Default,,0000,0000,0000,,Маған бұл маңызды емес. ➡
Dialogue: 0,0:10:12.41,0:10:18.22,Default,,0000,0000,0000,,Біраз уақыт жұлдыздар тұрақты түрде қозғалды
Dialogue: 0,0:10:12.41,0:10:18.22,Default,,0000,0000,0000,,Мен оның ұтымды сұлулығы бар деп ойладым, бірақ...➡
Dialogue: 0,0:10:18.22,0:10:25.12,Default,,0000,0000,0000,,Га, егер сіз қақпақты ашсаңыз, күрделі орбиталық есептеулерді табасыз.
Dialogue: 0,0:10:18.22,0:10:25.12,Default,,0000,0000,0000,,Шашыраған жұлдыздар жинағы... ➡
Dialogue: 0,0:10:25.12,0:10:28.89,Default,,0000,0000,0000,,Астрономиямен айналысуды жалғастыру ұтымды емес. ➡
Dialogue: 0,0:10:28.89,0:10:33.70,Default,,0000,0000,0000,,Ал бұл алыстағы әлем туралы. ➡
Dialogue: 0,0:10:33.70,0:10:38.20,Default,,0000,0000,0000,,Бойым қанша болса да
Dialogue: 0,0:10:33.70,0:10:38.20,Default,,0000,0000,0000,,Адамдар > жақындай алмайды
Dialogue: 0,0:10:50.52,0:10:54.92,Default,,0000,0000,0000,,<мырза Хуберт, бұрынғы ғалым және бидғатшы...➡
Dialogue: 0,0:10:54.92,0:10:57.29,Default,,0000,0000,0000,,Сіз қандай адамсыз? ➡
Dialogue: 0,0:10:57.29,0:11:00.89,Default,,0000,0000,0000,,Қалай болғанда да, мен жақсы өмір сүрмеймін...＞
Dialogue: 0,0:10:57.29,0:11:00.89,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:05.03,0:11:10.24,Default,,0000,0000,0000,,<Егер өсек болса...дәл бүгін
Dialogue: 0,0:11:05.03,0:11:10.24,Default,,0000,0000,0000,,Бұл бидғатшы өлім жазасына кесілген күн болды ма?
Dialogue: 0,0:11:20.21,0:11:22.15,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:11:22.15,0:11:24.38,Default,,0000,0000,0000,,Үлкен ағам сені қорғап қалар еді,
Dialogue: 0,0:11:22.15,0:11:24.38,Default,,0000,0000,0000,,<Ия Олар Құдайға қарсы шықты. ➡
Dialogue: 0,0:11:24.38,0:11:26.82,Default,,0000,0000,0000,,Жүректі өзгертуге мүмкіндік болар еді. ➡
Dialogue: 0,0:11:26.82,0:11:29.39,Default,,0000,0000,0000,,Өзі жасаған, өзі жасаған, өзі жасаған...＞
Dialogue: 0,0:11:29.39,0:11:32.73,Default,,0000,0000,0000,,Burn quickly.
Dialogue: 0,0:11:29.39,0:11:32.73,Default,,0000,0000,0000,,Фалько…
Dialogue: 0,0:11:32.73,0:11:35.63,Default,,0000,0000,0000,,Fah...ah.
Dialogue: 0,0:11:35.63,0:11:37.90,Default,,0000,0000,0000,,Наге~~.
Dialogue: 0,0:11:37.90,0:11:41.33,Default,,0000,0000,0000,,<Ол қандай адам...? ➡
Dialogue: 0,0:11:41.33,0:11:43.84,Default,,0000,0000,0000,,Тез кетейік＞
Dialogue: 0,0:11:47.07,0:11:49.31,Default,,0000,0000,0000,,Sorry.
Dialogue: 0,0:11:49.31,0:11:53.95,Default,,0000,0000,0000,,Бұл Потоцкидің күйеу баласы Рафаль.
Dialogue: 0,0:11:49.31,0:11:53.95,Default,,0000,0000,0000,,Pick up Hubert.
Dialogue: 0,0:11:53.95,0:11:57.45,Default,,0000,0000,0000,,Ah. ...Иә, иә.
Dialogue: 0,0:12:10.86,0:12:14.97,Default,,0000,0000,0000,,(Есіктің жабылу дыбысы)
Dialogue: 0,0:12:17.94,0:12:21.27,Default,,0000,0000,0000,,<Уф! Wow, so big! О, жоқ! ➡
Dialogue: 0,0:12:21.27,0:12:24.98,Default,,0000,0000,0000,,Бұл күдікті қандай адам?
Dialogue: 0,0:12:24.98,0:12:28.91,Default,,0000,0000,0000,,Танысқаныма қуаныштымын!
Dialogue: 0,0:12:24.98,0:12:28.91,Default,,0000,0000,0000,,Бұл Потоцкидің ұлы Рафаль!
Dialogue: 0,0:12:28.91,0:12:30.92,Default,,0000,0000,0000,,Мен Изуку Мидориямын!
Dialogue: 0,0:12:34.65,0:12:38.99,Default,,0000,0000,0000,,Huh...? А, бұл...
Dialogue: 0,0:12:38.99,0:12:42.29,Default,,0000,0000,0000,,Мен саған ешқандай пайда бермеймін.
Dialogue: 0,0:12:42.29,0:12:46.07,Default,,0000,0000,0000,,To be liked
Dialogue: 0,0:12:42.29,0:12:46.07,Default,,0000,0000,0000,,Өтірік күлудің қажеті жоқ.
Dialogue: 0,0:12:46.07,0:12:48.83,Default,,0000,0000,0000,,Иә? No, no…
Dialogue: 0,0:12:48.83,0:12:51.34,Default,,0000,0000,0000,,Олай болса мен басшылық сұраймын.
Dialogue: 0,0:12:53.14,0:12:55.07,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:12:55.07,0:13:11.29,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:13:16.03,0:13:18.70,Default,,0000,0000,0000,,Мен оны естідім.
Dialogue: 0,0:13:16.03,0:13:18.70,Default,,0000,0000,0000,,Мен саған осылай үнсіз өлуді айта алмаймын!!
Dialogue: 0,0:13:18.70,0:13:20.73,Default,,0000,0000,0000,,Сіз университетке барасыз ба?
Dialogue: 0,0:13:20.73,0:13:23.27,Default,,0000,0000,0000,,Иә! What an honor!
Dialogue: 0,0:13:23.27,0:13:26.04,Default,,0000,0000,0000,,Мені қолдағандардың барлығымен
Dialogue: 0,0:13:23.27,0:13:26.04,Default,,0000,0000,0000,,Thanks to God...
Dialogue: 0,0:13:26.04,0:13:28.77,Default,,0000,0000,0000,,Сіз астрономияны үйренесіз бе?
Dialogue: 0,0:13:26.04,0:13:28.77,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:13:28.77,0:13:32.95,Default,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:13:28.77,0:13:32.95,Default,,0000,0000,0000,,Жұлдыздарға қарап тұрсың ба?
Dialogue: 0,0:13:28.77,0:13:32.95,Default,,0000,0000,0000,,Астролябты алып жүру.
Dialogue: 0,0:13:32.95,0:13:36.62,Default,,0000,0000,0000,,Ah. No, this is...
Dialogue: 0,0:13:36.62,0:13:41.92,Default,,0000,0000,0000,,Tashina
Dialogue: 0,0:13:36.62,0:13:41.92,Default,,0000,0000,0000,,Бұл жай ғана талғамға байланысты.
Dialogue: 0,0:13:36.62,0:13:41.92,Default,,0000,0000,0000,,Менің ойымша, тоқтайтын уақыт келді ...
Dialogue: 0,0:13:41.92,0:13:43.89,Default,,0000,0000,0000,,Университеттегі теология.
Dialogue: 0,0:13:43.89,0:13:46.19,Default,,0000,0000,0000,,Hmph. Ол таза емес.
Dialogue: 0,0:13:46.19,0:13:48.19,Default,,0000,0000,0000,,Е...
Dialogue: 0,0:13:55.50,0:13:57.50,Default,,0000,0000,0000,,…Ах.
Dialogue: 0,0:14:04.98,0:14:08.48,Default,,0000,0000,0000,,Губерт мырза, сіз бұрын қандай зерттеу жүргіздіңіз?
Dialogue: 0,0:14:13.69,0:14:16.66,Default,,0000,0000,0000,,Лубан
Dialogue: 0,0:14:13.69,0:14:16.66,Default,,0000,0000,0000,,Балауыз пластина. Бұл бақылау жазбасы ма?
Dialogue: 0,0:14:16.66,0:14:20.56,Default,,0000,0000,0000,,Ах... Иә.
Dialogue: 0,0:14:20.56,0:14:23.03,Default,,0000,0000,0000,,Қолымнан келгенше...
Dialogue: 0,0:14:20.56,0:14:23.03,Default,,0000,0000,0000,,Маған көрсет.
Dialogue: 0,0:14:23.03,0:14:25.13,Default,,0000,0000,0000,,Не? Эй, бір сәт...
Dialogue: 0,0:14:32.07,0:14:34.07,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:14:35.71,0:14:37.68,Default,,0000,0000,0000,,...Тамаша.
Dialogue: 0,0:14:37.68,0:14:41.88,Default,,0000,0000,0000,,Е.
Dialogue: 0,0:14:37.68,0:14:41.88,Default,,0000,0000,0000,,6-шы жұлдызға дейінгі жұлдыздарды көре алатыныңызға сене алмаймын.
Dialogue: 0,0:14:41.88,0:14:44.48,Default,,0000,0000,0000,,Анасы: Йор Форджер, жергілікті кеңсенің қызметкері
Dialogue: 0,0:14:41.88,0:14:44.48,Default,,0000,0000,0000,,Оның көздері жақсы.
Dialogue: 0,0:14:41.88,0:14:44.48,Default,,0000,0000,0000,,Е.
Dialogue: 0,0:14:44.48,0:14:47.82,Default,,0000,0000,0000,,А... Бірақ мен осылай жаздым...
Dialogue: 0,0:14:47.82,0:14:51.69,Default,,0000,0000,0000,,Үйде көбірек
Dialogue: 0,0:14:47.82,0:14:51.69,Default,,0000,0000,0000,,Нақты көшірме бар!
Dialogue: 0,0:14:51.69,0:14:56.60,Default,,0000,0000,0000,,Бұл рас па? Мен оны міндетті түрде көргім келеді.
Dialogue: 0,0:14:51.69,0:14:56.60,Default,,0000,0000,0000,,Енді сіз зерттеуіңізді жалғастыра аласыз!
Dialogue: 0,0:14:56.60,0:14:59.50,Default,,0000,0000,0000,,Иә! Әрине…➡
Dialogue: 0,0:14:59.50,0:15:01.77,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:15:01.77,0:15:04.24,Default,,0000,0000,0000,,Не? зерттеуі?
Dialogue: 0,0:15:04.24,0:15:07.64,Default,,0000,0000,0000,,Сіз зерттеуді доғардыңыз, солай ма?
Dialogue: 0,0:15:07.64,0:15:09.58,Default,,0000,0000,0000,,Мен ғалыммын.
Dialogue: 0,0:15:09.58,0:15:13.91,Default,,0000,0000,0000,,Кім не айтса да
Dialogue: 0,0:15:09.58,0:15:13.91,Default,,0000,0000,0000,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,0:15:09.58,0:15:13.91,Default,,0000,0000,0000,,Менің зерттеуден бас тартайын деген ниетім жоқ.
Dialogue: 0,0:15:13.91,0:15:18.38,Default,,0000,0000,0000,,ше? Әлде сен өзгермегенсің бе?
Dialogue: 0,0:15:18.38,0:15:22.25,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:15:18.38,0:15:22.25,Default,,0000,0000,0000,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,0:15:18.38,0:15:22.25,Default,,0000,0000,0000,,Әрине. Мен өтірікпен шықтым.
Dialogue: 0,0:15:22.25,0:15:26.89,Default,,0000,0000,0000,,Жарайды, бұдан былай білмеймін деп үміттенемін.
Dialogue: 0,0:15:22.25,0:15:26.89,Default,,0000,0000,0000,,Мен шатасып кете беремін.
Dialogue: 0,0:15:26.89,0:15:29.80,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:15:29.80,0:15:34.40,Default,,0000,0000,0000,,Неліктен сен қазір бәріне шыншылсың?
Dialogue: 0,0:15:34.40,0:15:38.00,Default,,0000,0000,0000,,Себебі мен сені бопсалайын деп жатырмын.
Dialogue: 0,0:15:38.00,0:15:39.94,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:39.94,0:15:42.27,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:15:42.27,0:15:44.81,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:44.81,0:15:48.58,Default,,0000,0000,0000,,Жарайсың ба? Зерттеу бақылауды қажет етеді.
Dialogue: 0,0:15:48.58,0:15:51.48,Default,,0000,0000,0000,,Бірақ менің көзім әлсіреп қалды.
Dialogue: 0,0:15:51.48,0:15:54.15,Default,,0000,0000,0000,,Сондықтан мен сізді пайдаланамын.
Dialogue: 0,0:15:54.15,0:15:57.72,Default,,0000,0000,0000,,Егер бидғатшы екі рет ұсталса, дереу өлім жазасына кесіледі.
Dialogue: 0,0:15:57.72,0:16:00.03,Default,,0000,0000,0000,,Келесі жоқ.
Dialogue: 0,0:15:57.72,0:16:00.03,Default,,0000,0000,0000,,Гу Гу Гу….
Dialogue: 0,0:16:00.03,0:16:03.76,Default,,0000,0000,0000,,Ол сондай адам.
Dialogue: 0,0:16:00.03,0:16:03.76,Default,,0000,0000,0000,,Мен аяқталмаған ісім болғандықтан қайтып келдім.
Dialogue: 0,0:16:03.76,0:16:06.53,Default,,0000,0000,0000,,Ол үшін тіпті отқа секіріңіз.
Dialogue: 0,0:16:06.53,0:16:11.24,Default,,0000,0000,0000,,Кешіріңіз, егер бас тартсаңыз, мен сізді өлтіремін.
Dialogue: 0,0:16:06.53,0:16:11.24,Default,,0000,0000,0000,,Егер сіз аралассаңыз, мен сізді өлтіремін➡
Dialogue: 0,0:16:11.24,0:16:15.54,Default,,0000,0000,0000,,Әйтеуір, айтқанымды орындамасаң, өлтіремін.
Dialogue: 0,0:16:11.24,0:16:15.54,Default,,0000,0000,0000,,Бұл өтірік болғандықтан ба?>
Dialogue: 0,0:16:15.54,0:16:19.41,Default,,0000,0000,0000,,Астрономиямен де айналысыңыз! мен үшін!
Dialogue: 0,0:16:19.41,0:16:22.45,Default,,0000,0000,0000,,Бұл тапсырыс! Керемет!?
Dialogue: 0,0:16:22.45,0:16:27.59,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:16:22.45,0:16:27.59,Default,,0000,0000,0000,,Мен мұны істеймін! Мен мұны көп жасаймын! !
Dialogue: 0,0:16:27.59,0:16:30.79,Default,,0000,0000,0000,,Уф...! Гехогехо! Кахаха….
Dialogue: 0,0:16:30.79,0:16:34.36,Default,,0000,0000,0000,,Ха ха ха….
Dialogue: 0,0:16:30.79,0:16:34.36,Default,,0000,0000,0000,,Уайымдамаңыз, мен тым қисынсыз болмаймын.
Dialogue: 0,0:16:34.36,0:16:38.06,Default,,0000,0000,0000,,Бұл өте
Dialogue: 0,0:16:34.36,0:16:38.06,Default,,0000,0000,0000,,Сенуге болатын сөздер....
Dialogue: 0,0:16:38.06,0:16:40.70,Default,,0000,0000,0000,,Сіз әдетте қай жерде байқайсыз?
Dialogue: 0,0:16:40.70,0:16:44.57,Default,,0000,0000,0000,,N...? Бұл оңтүстік-шығыс төбе...
Dialogue: 0,0:16:44.57,0:16:47.54,Default,,0000,0000,0000,,Жақсырақ бақылау орындары бар.
Dialogue: 0,0:16:47.54,0:16:51.18,Default,,0000,0000,0000,,Ертең
Dialogue: 0,0:16:47.54,0:16:51.18,Default,,0000,0000,0000,,Сіз таң қаласыз. Мен саған ертең айтамын.
Dialogue: 0,0:16:51.18,0:16:53.58,Default,,0000,0000,0000,,Иә... Иә.
Dialogue: 0,0:16:53.58,0:16:55.88,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:17:02.29,0:17:05.32,Default,,0000,0000,0000,,~~! Не, не! !
Dialogue: 0,0:17:05.32,0:17:07.76,Default,,0000,0000,0000,,Иида-кун мен Яо-санды да құттықтаймыз.
Dialogue: 0,0:17:07.76,0:17:12.13,Default,,0000,0000,0000,,<Осындай нәрсе неге бақылаусыз қалды?
Dialogue: 0,0:17:07.76,0:17:12.13,Default,,0000,0000,0000,,Өртеп жіберіңдер! Өртеп жіберіңдер! ➡
Dialogue: 0,0:17:12.13,0:17:15.53,Default,,0000,0000,0000,,Қайтып келгенде дереу хабарлаңыз! Ертең кім барады? ＞
Dialogue: 0,0:17:17.10,0:17:21.01,Default,,0000,0000,0000,,(Хуберттің дауысы)
Dialogue: 0,0:17:17.10,0:17:21.01,Default,,0000,0000,0000,,Жақсырақ бақылау орындары бар. Сіз таң қаласыз.
Dialogue: 0,0:17:27.45,0:17:32.32,Default,,0000,0000,0000,,<…Жоқ, жоқ!
Dialogue: 0,0:17:27.45,0:17:32.32,Default,,0000,0000,0000,,Қалай қарасаң да қауіпті! ➡
Dialogue: 0,0:17:32.32,0:17:35.82,Default,,0000,0000,0000,,Менің баратын жолым жоқ!
Dialogue: 0,0:17:32.32,0:17:35.82,Default,,0000,0000,0000,,Онда барудың пайдасы жоқ! ＞
Dialogue: 0,0:17:41.69,0:17:44.60,Default,,0000,0000,0000,,Керемет! Мен сенің келгеніңе қуаныштымын! !
Dialogue: 0,0:17:44.60,0:17:48.03,Default,,0000,0000,0000,,Бұл өте айқын көрінеді!
Dialogue: 0,0:17:48.03,0:17:50.27,Default,,0000,0000,0000,,Иә... түсіндім.
Dialogue: 0,0:17:50.27,0:17:56.48,Default,,0000,0000,0000,,Мұндағы биіктік жоғары және көру мүмкіндігі кең.
Dialogue: 0,0:17:50.27,0:17:56.48,Default,,0000,0000,0000,,Өйткені ауа таза.
Dialogue: 0,0:17:56.48,0:17:59.98,Default,,0000,0000,0000,,Бақылау үшін өте қолайлы.
Dialogue: 0,0:17:59.98,0:18:02.21,Default,,0000,0000,0000,,Сондай-ақ.
Dialogue: 0,0:18:02.21,0:18:08.02,Default,,0000,0000,0000,,Сол тастар мен таулардың орны Орион белдеуі.
Dialogue: 0,0:18:02.21,0:18:08.02,Default,,0000,0000,0000,,Маған олардың қаншалықты ұқсас екені де ұнайды.
Dialogue: 0,0:18:08.02,0:18:11.46,Default,,0000,0000,0000,,Хаха….
Dialogue: 0,0:18:11.46,0:18:14.06,Default,,0000,0000,0000,,Ай шыққаннан кейін оны байқау қиын.
Dialogue: 0,0:18:14.06,0:18:18.56,Default,,0000,0000,0000,,Уақыт a posteriori есептеледі
Dialogue: 0,0:18:14.06,0:18:18.56,Default,,0000,0000,0000,,Қазір жазып алыңыз.
Dialogue: 0,0:18:18.56,0:18:20.57,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:18:23.17,0:18:35.15,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:18:35.15,0:18:37.58,Default,,0000,0000,0000,,Мынадай нәрсе ме?
Dialogue: 0,0:18:37.58,0:18:50.03,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:18:50.03,0:18:53.30,Default,,0000,0000,0000,,Керемет! Қысқа уақыт ішінде соншалықты көп.
Dialogue: 0,0:18:53.30,0:18:56.40,Default,,0000,0000,0000,,Эй... Сәлем.
Dialogue: 0,0:19:00.41,0:19:03.18,Default,,0000,0000,0000,,...Мм.
Dialogue: 0,0:19:00.41,0:19:03.18,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:03.18,0:19:08.61,Default,,0000,0000,0000,,Бұл жазбалар не үшін пайдаланылады?
Dialogue: 0,0:19:08.61,0:19:13.15,Default,,0000,0000,0000,,Тыйым салынған зерттеулер...➡
Dialogue: 0,0:19:13.15,0:19:15.85,Default,,0000,0000,0000,,Бұл не деген сұмдық?
Dialogue: 0,0:19:20.23,0:19:23.13,Default,,0000,0000,0000,,Сіз Аристархты білесіз бе?
Dialogue: 0,0:19:23.13,0:19:25.76,Default,,0000,0000,0000,,Хмм...? Бұл не?
Dialogue: 0,0:19:25.76,0:19:32.54,Default,,0000,0000,0000,,…Сонымен ғаламның пішіні қандай?
Dialogue: 0,0:19:25.76,0:19:32.54,Default,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:19:32.54,0:19:34.84,Default,,0000,0000,0000,,Хмм...? иә.
Dialogue: 0,0:19:34.84,0:19:41.21,Default,,0000,0000,0000,,Жер центрі, ал барлық аспан денелері
Dialogue: 0,0:19:34.84,0:19:41.21,Default,,0000,0000,0000,,Мауах
Dialogue: 0,0:19:34.84,0:19:41.21,Default,,0000,0000,0000,,Оның айналасында күрделі түрде айналады.
Dialogue: 0,0:19:41.21,0:19:43.92,Default,,0000,0000,0000,,Енді сызыңыз.
Dialogue: 0,0:19:41.21,0:19:43.92,Default,,0000,0000,0000,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,0:19:47.12,0:19:49.66,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:19:49.66,0:19:53.16,Default,,0000,0000,0000,,(Жердегі сурет дыбысы)
Dialogue: 0,0:19:53.16,0:19:55.93,Default,,0000,0000,0000,,Бұл осындай нәрсе ме?
Dialogue: 0,0:19:55.93,0:20:01.73,Default,,0000,0000,0000,,Мұны түсіну қиын, бірақ бұл мыңнан астам жыл бұрын болған.
Dialogue: 0,0:19:55.93,0:20:01.73,Default,,0000,0000,0000,,Птолемей шындықты ашады.
Dialogue: 0,0:20:01.73,0:20:07.04,Default,,0000,0000,0000,,Жарайды, парасаттылықпен ойласаң да, жер ерекше ➡
Dialogue: 0,0:20:07.04,0:20:10.91,Default,,0000,0000,0000,,Цуку
Dialogue: 0,0:20:07.04,0:20:10.91,Default,,0000,0000,0000,,Менің ойымша, Құдай әлемді орталықта жасайды.
Dialogue: 0,0:20:10.91,0:20:13.58,Default,,0000,0000,0000,,…Иә.
Dialogue: 0,0:20:13.58,0:20:18.15,Default,,0000,0000,0000,,Сонымен, бұл шындық әдемі ме?
Dialogue: 0,0:20:18.15,0:20:22.85,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:18.15,0:20:22.85,Default,,0000,0000,0000,,Бұл ғалам әдемі ме?
Dialogue: 0,0:20:28.43,0:20:32.83,Default,,0000,0000,0000,,Уау, қандай әдемі
Dialogue: 0,0:20:28.43,0:20:32.83,Default,,0000,0000,0000,,Бұл жеке адамның сенсорлық реакциясы.
Dialogue: 0,0:20:32.83,0:20:35.80,Default,,0000,0000,0000,,Оның академиялық шындыққа еш қатысы жоқ.
Dialogue: 0,0:20:35.80,0:20:39.14,Default,,0000,0000,0000,,Сіз жауаптан жалтарып жатырсыз.
Dialogue: 0,0:20:35.80,0:20:39.14,Default,,0000,0000,0000,,…!
Dialogue: 0,0:20:39.14,0:20:42.44,Default,,0000,0000,0000,,Өзіңді әдемімін деп ойладың ба?
Dialogue: 0,0:20:52.28,0:20:57.12,Default,,0000,0000,0000,,Маған бұл тым күрделі сияқты.
Dialogue: 0,0:20:57.12,0:21:02.36,Default,,0000,0000,0000,,Бұл космологиялық суретте
Dialogue: 0,0:20:57.12,0:21:02.36,Default,,0000,0000,0000,,Әрбір планета жеке есептеледі.
Dialogue: 0,0:21:02.36,0:21:08.17,Default,,0000,0000,0000,,Жалпы «тәртіп» жоқ
Dialogue: 0,0:21:02.36,0:21:08.17,Default,,0000,0000,0000,,Дискретті қозғалыстар...➡
Dialogue: 0,0:21:08.17,0:21:10.90,Default,,0000,0000,0000,,Ақылға қонымды емес сияқты.
Dialogue: 0,0:21:10.90,0:21:14.27,Default,,0000,0000,0000,,Осы тұрғыдан➡
Dialogue: 0,0:21:14.27,0:21:16.58,Default,,0000,0000,0000,,Өте әдемі емес.
Тіпті
Dialogue: 0,0:21:18.51,0:21:22.45,Default,,0000,0000,0000,,дейін.
Dialogue: 0,0:21:18.51,0:21:22.45,Default,,0000,0000,0000,,Әдемі болмағаны ұят➡
Dialogue: 0,0:21:22.45,0:21:27.79,Default,,0000,0000,0000,,Біріншіден, ол бүкіл ғаламды бейнелей алады
Dialogue: 0,0:21:22.45,0:21:27.79,Default,,0000,0000,0000,,Бірыңғай тәртіп жоқ.
Dialogue: 0,0:21:27.79,0:21:30.62,Default,,0000,0000,0000,,Сондықтан
Dialogue: 0,0:21:27.79,0:21:30.62,Default,,0000,0000,0000,,Оны проблемаға айналдырудың қажеті жоқ.
Dialogue: 0,0:21:30.62,0:21:34.06,Default,,0000,0000,0000,,Жоқ, бұл үлкен мәселе.
Dialogue: 0,0:21:30.62,0:21:34.06,Default,,0000,0000,0000,,А...?
Dialogue: 0,0:21:34.06,0:21:37.76,Default,,0000,0000,0000,,Мен әдемі емес ғаламда өмір сүргім келмейді.
Dialogue: 0,0:21:39.40,0:21:45.70,Default,,0000,0000,0000,,Айтсаң да, «сұлулық»
Dialogue: 0,0:21:39.40,0:21:45.70,Default,,0000,0000,0000,,Найгаши
Dialogue: 0,0:21:39.40,0:21:45.70,Default,,0000,0000,0000,,«Себепті» елемесеңіз, арбаны аттың алдына қоясыз.
Dialogue: 0,0:21:45.70,0:21:49.51,Default,,0000,0000,0000,,Күрделі болса да, сол «себептің» дәлдігі жоғары.
Dialogue: 0,0:21:49.51,0:21:53.38,Default,,0000,0000,0000,,Жұлдыздар қозғалып, күн шыққанша.
Dialogue: 0,0:21:53.38,0:21:58.22,Default,,0000,0000,0000,,Сонда күн мен жұлдыздар қозғалмаса ше?
Dialogue: 0,0:21:58.22,0:22:02.85,Default,,0000,0000,0000,,Хахахаха жоқ жоқ
Dialogue: 0,0:21:58.22,0:22:02.85,Default,,0000,0000,0000,,Күтілгендей, бұл дұрыс емес.
Dialogue: 0,0:22:02.85,0:22:04.89,Default,,0000,0000,0000,,Құрылды.
Dialogue: 0,0:22:04.89,0:22:09.66,Default,,0000,0000,0000,,Сора
Dialogue: 0,0:22:04.89,0:22:09.66,Default,,0000,0000,0000,,Сонымен, дәл қазір ғарышта не қозғалып жатыр?
Dialogue: 0,0:22:04.89,0:22:09.66,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:22:09.66,0:22:11.66,Default,,0000,0000,0000,,Жер.
Dialogue: 0,0:22:11.66,0:22:14.97,Default,,0000,0000,0000,,Жер дегеніміз не?
Dialogue: 0,0:22:11.66,0:22:14.97,Default,,0000,0000,0000,,Сондықтан...
Dialogue: 0,0:22:17.70,0:22:20.21,Default,,0000,0000,0000,,А... Жер?
Dialogue: 0,0:22:23.51,0:22:28.71,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:22:23.51,0:22:28.71,Default,,0000,0000,0000,,Жеміс
Dialogue: 0,0:22:23.51,0:22:28.71,Default,,0000,0000,0000,,Күн шықпайды, бірақ біз құлаймыз.
Dialogue: 0,0:22:30.35,0:22:38.02,Default,,0000,0000,0000,,
Dialogue: 0,0:22:30.35,0:22:38.02,Default,,0000,0000,0000,,Жер өз осінде айналатындықтан күн сайын таң келеді.
Dialogue: 0,0:22:30.35,0:22:38.02,Default,,0000,0000,0000,,Өйткені ол «айнайды».
Dialogue: 0,0:22:38.02,0:22:42.86,Default,,0000,0000,0000,,Сонымен қатар, жыл мезгілдері өзгереді
Dialogue: 0,0:22:38.02,0:22:42.86,Default,,0000,0000,0000,,Жер күнді айналады➡
Dialogue: 0,0:22:42.86,0:22:45.70,Default,,0000,0000,0000,,Бұл «айналмалы» болғандықтан.
Dialogue: 0,0:22:45.70,0:22:50.30,Default,,0000,0000,0000,,Менің ғаламымда
Dialogue: 0,0:22:45.70,0:22:50.30,Default,,0000,0000,0000,,Жердің екі қозғалысы бар.
Dialogue: 0,0:22:53.57,0:23:00.21,Default,,0000,0000,0000,,Онда күн тоқтап тұр
Dialogue: 0,0:22:53.57,0:23:00.21,Default,,0000,0000,0000,,Бір кездері бөлінген планеталар тізбекте қозғалады➡
Dialogue: 0,0:23:00.21,0:23:03.22,Default,,0000,0000,0000,,Әлем бір тәртіпке біріктірілген➡
Dialogue: 0,0:23:03.22,0:23:07.69,Default,,0000,0000,0000,,Ақылға қонымды ойлар төңкерілді
Dialogue: 0,0:23:03.22,0:23:07.69,Default,,0000,0000,0000,,Шіркеу ашуланды➡
Dialogue: 0,0:23:07.69,0:23:12.29,Default,,0000,0000,0000,,«Сұлулық» пен «ақыл» кездеседі.
Dialogue: 0,0:23:12.29,0:23:15.19,Default,,0000,0000,0000,,Бұл менің зерттеуім.
Dialogue: 0,0:23:16.90,0:23:20.10,Default,,0000,0000,0000,,Дұрыс. Бұл...
Dialogue: 0,0:23:24.17,0:23:27.77,Default,,0000,0000,0000,,Оны «гелиоцентрлік теория» деп атаймыз.
Dialogue: 0,0:23:30.08,0:23:34.78,Default,,0000,0000,0000,,♬ «Қайта-қайта айқайлау»
Dialogue: 0,0:23:34.78,0:23:43.49,Default,,0000,0000,0000,,♬ «Осы қараңғы түнде құбыжық болып кетсем де».
Dialogue: 0,0:23:43.49,0:23:49.29,Default,,0000,0000,0000,,♬ «Мен оны осында қалдырғым келеді».
Dialogue: 0,0:23:49.29,0:23:53.30,Default,,0000,0000,0000,,♬ «Бұл құпия»
Dialogue: 0,0:23:53.30,0:23:57.40,Default,,0000,0000,0000,,♬ «Біртіндеп тамақтаныңыз»
Dialogue: 0,0:23:57.40,0:24:04.14,Default,,0000,0000,0000,,♬ «Қызыл және көк жұлдыздар, болашақтан өткенге»
Dialogue: 0,0:24:04.14,0:24:08.01,Default,,0000,0000,0000,,♬ «Тәртіппен тамақтаныңыз».
Dialogue: 0,0:24:08.01,0:24:16.09,Default,,0000,0000,0000,,♬ «Оны ондаған рет шайнаңыз, еріген кезде ішіңіз».
Dialogue: 0,0:24:16.09,0:24:26.73,Default,,0000,0000,0000,,♬«Төбеде
Dialogue: 0,0:24:16.09,0:24:26.73,Default,,0000,0000,0000,,Бұл жалғыздықты мен жұлдыздарға қараған кезде сезінемін».
Dialogue: 0,0:24:26.73,0:24:36.17,Default,,0000,0000,0000,,♬ «Таңертең қолдарым боялғанша жарқырайды
Dialogue: 0,0:24:26.73,0:24:36.17,Default,,0000,0000,0000,,Мен ұмытып кетіппін».
Dialogue: 0,0:24:36.17,0:24:43.48,Default,,0000,0000,0000,,♬ «Бұл әлем ыңғайлы аяқталмаған».
Dialogue: 0,0:24:43.48,0:24:46.38,Default,,0000,0000,0000,,♬ «Сондықтан мен білгім келеді».
Dialogue: 0,0:24:46.38,0:24:54.06,Default,,0000,0000,0000,,♬ «Бірақ мен құбыжық сияқты алысқа айқайласам да»
Dialogue: 0,0:24:54.06,0:24:57.26,Default,,0000,0000,0000,,♬ «Ол қайтадан жоғалады».
Dialogue: 0,0:25:02.50,0:25:07.61,Default,,0000,0000,0000,,Жердің қозғалысы арқылы
Dialogue: 0,0:25:02.50,0:25:07.61,Default,,0000,0000,0000,,Сұлулық пен логика тоғысады.
Dialogue: 0,0:25:09.71,0:25:14.98,Default,,0000,0000,0000,,Әлем бар
Dialogue: 0,0:25:09.71,0:25:14.98,Default,,0000,0000,0000,,Бір тәртіпке біріктірілу.
Dialogue: 0,0:25:14.98,0:25:20.15,Default,,0000,0000,0000,,Шіркеу бекіткен геоцентристік теорияға қарсы――…➡
Dialogue: 0,0:25:20.15,0:25:23.72,Default,,0000,0000,0000,,Оны «гелиоцентрлік теория» деп атаймыз.
Dialogue: 0,0:25:23.72,0:25:25.66,Default,,0000,0000,0000,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,0:25:25.66,0:25:29.13,Default,,0000,0000,0000,,Жер қозғалысы теориясы?
Dialogue: 0,0:25:29.13,0:25:32.63,Default,,0000,0000,0000,,Бұл идея! !
Dialogue: 0,0:25:32.63,0:25:35.83,Default,,0000,0000,0000,,А... бірақ...?
Dialogue: 0,0:25:35.83,0:25:38.50,Default,,0000,0000,0000,,Жоқ….
Dialogue: 0,0:25:38.50,0:25:41.21,Default,,0000,0000,0000,,Менің ойымша, бұл әдетте дұрыс емес.
Dialogue: 0,0:25:43.31,0:25:45.71,Default,,0000,0000,0000,,Үш себеп бар.
Dialogue: 0,0:25:47.31,0:25:50.75,Default,,0000,0000,0000,,Ең алдымен. Қарама-қайшылықтар тым көп.
Dialogue: 0,0:25:50.75,0:25:53.65,Default,,0000,0000,0000,,Мысалы, жер қозғалса...
Dialogue: 0,0:25:56.45,0:26:01.09,Default,,0000,0000,0000,,Бұл сенсің ғой, иә?
Dialogue: 0,0:25:56.45,0:26:01.09,Default,,0000,0000,0000,,Неліктен секіру керек?
Dialogue: 0,0:25:56.45,0:26:01.09,Default,,0000,0000,0000,,Олар бір қалыпта қонады ма?
Dialogue: 0,0:26:01.09,0:26:04.96,Default,,0000,0000,0000,,Екінші. Жер қозғалса➡
Dialogue: 0,0:26:04.96,0:26:07.37,Default,,0000,0000,0000,,Оны кім қолдайды?
Dialogue: 0,0:26:07.37,0:26:09.87,Default,,0000,0000,0000,,Жер ғаламның орталығында➡
Dialogue: 0,0:26:09.87,0:26:14.27,Default,,0000,0000,0000,,Құдай адамдар мекендейтін планетаны жаратты.
Dialogue: 0,0:26:09.87,0:26:14.27,Default,,0000,0000,0000,,Себебі сіз оны ерекше жасадыңыз.
Dialogue: 0,0:26:14.27,0:26:18.14,Default,,0000,0000,0000,,Мұны жоққа шығару тым қауіпті болар еді.
Үшіншісі
Dialogue: 0,0:26:18.14,0:26:20.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:26:20.58,0:26:23.48,Default,,0000,0000,0000,,Өз өміріңізді осындай интуицияға сену➡
Dialogue: 0,0:26:23.48,0:26:26.38,Default,,0000,0000,0000,,Бұл ақымақтық.
Dialogue: 0,0:26:26.38,0:26:30.99,Default,,0000,0000,0000,,Бұл дұрыс. Бірақ мен үшінші тармақпен келіспеймін.
Dialogue: 0,0:26:30.99,0:26:33.33,Default,,0000,0000,0000,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,0:26:33.33,0:26:37.83,Default,,0000,0000,0000,,Мен өз өміріме қауіп төнгенде ғана өз түйсігіме сенемін.
Dialogue: 0,0:26:39.76,0:26:43.70,Default,,0000,0000,0000,,Бұны дұрыс емес деп есептесеңіз не істейсіз?
Dialogue: 0,0:26:43.70,0:26:48.51,Default,,0000,0000,0000,,Мәселе жоқ. Дұрыс емес жауап мағынасыз дегенді білдірмейді.
Dialogue: 0,0:26:48.51,0:26:52.28,Default,,0000,0000,0000,,Дұрыс емес мағынасыз... дегенді білдірмейді?
Dialogue: 0,0:26:52.28,0:26:54.28,Default,,0000,0000,0000,,​​Есіңіз дұрыс па?
Dialogue: 0,0:26:54.28,0:26:58.08,Default,,0000,0000,0000,,Мен гелиоцентрлік теорияға сенбеймін.
Dialogue: 0,0:26:54.28,0:26:58.08,Default,,0000,0000,0000,,Менің ойымша әдемі емес➡
Dialogue: 0,0:26:58.08,0:27:02.69,Default,,0000,0000,0000,,Дәлелдеу үшін отқа секірмеңіз.
Dialogue: 0,0:27:02.69,0:27:05.26,Default,,0000,0000,0000,,Ертең
Dialogue: 0,0:27:02.69,0:27:05.26,Default,,0000,0000,0000,,Мен ертең келгім келмейді.
Dialogue: 0,0:27:05.26,0:27:07.59,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:27:05.26,0:27:07.59,Default,,0000,0000,0000,,(Жүру дыбысы)
Dialogue: 0,0:27:07.59,0:27:12.16,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:27:07.59,0:27:12.16,Default,,0000,0000,0000,,Ертең
Dialogue: 0,0:27:07.59,0:27:12.16,Default,,0000,0000,0000,,Жарайды, ертең тағы келуіңді өтіндім.
Dialogue: 0,0:27:12.16,0:27:14.17,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:27:21.21,0:27:25.08,Default,,0000,0000,0000,,<Аспан мен жер қозғалды ма? ➡
Dialogue: 0,0:27:25.08,0:27:29.81,Default,,0000,0000,0000,,Сонымен қатар екі түрі бар: айналу және айналу? ➡
Dialogue: 0,0:27:29.81,0:27:33.82,Default,,0000,0000,0000,,Ха, осындай ақымақ әңгіме бар ма＞
Dialogue: 0,0:27:35.62,0:27:40.99,Default,,0000,0000,0000,,<Қараңыз, бұл аз ғана, бірақ қазір де
Dialogue: 0,0:27:35.62,0:27:40.99,Default,,0000,0000,0000,,Сора
Dialogue: 0,0:27:35.62,0:27:40.99,Default,,0000,0000,0000,,Бұл жұлдызды аспан міндетті түрде қозғалады. ➡
Dialogue: 0,0:27:40.99,0:27:44.40,Default,,0000,0000,0000,,Бір сағаттан кейін анық түсінесіз. ➡
Dialogue: 0,0:27:44.40,0:27:47.00,Default,,0000,0000,0000,,«Айналу» мүмкін емес＞
Dialogue: 0,0:27:56.31,0:27:58.61,Default,,0000,0000,0000,,Цутти! !
Dialogue: 0,0:27:58.61,0:28:01.25,Default,,0000,0000,0000,,Маған не болды...
Dialogue: 0,0:28:01.25,0:28:04.55,Default,,0000,0000,0000,,Тау кенет аударылып кеткендей болды.
Dialogue: 0,0:28:08.02,0:28:11.12,Default,,0000,0000,0000,,...Тау айналар ма?
Dialogue: 0,0:28:12.79,0:28:16.96,Default,,0000,0000,0000,,Сонымен...бірақ бұл менің көшкенім үшін➡
Dialogue: 0,0:28:16.96,0:28:20.57,Default,,0000,0000,0000,,Бұл тау шынымен қозғалғандықтан емес...
Dialogue: 0,0:28:20.57,0:28:23.80,Default,,0000,0000,0000,,<Бұл анық... ➡
Dialogue: 0,0:28:23.80,0:28:27.11,Default,,0000,0000,0000,,Бірақ егер біз осы жалпы мағынаны кеңейтсек ше? ＞
Dialogue: 0,0:28:31.04,0:28:35.61,Default,,0000,0000,0000,,<Жер мен тау болсам күн болса ше? ➡
Dialogue: 0,0:28:35.61,0:28:39.48,Default,,0000,0000,0000,,Егер бақылаушы ➡ қозғалса
Dialogue: 0,0:28:39.48,0:28:43.59,Default,,0000,0000,0000,,Қозғалмайтын объектілерді көре аласыз ба? ＞
Dialogue: 0,0:28:50.06,0:28:53.40,Default,,0000,0000,0000,,Ол айналуы мүмкін...
Dialogue: 0,0:28:53.40,0:28:55.73,Default,,0000,0000,0000,,Жоқ… жоқ➡
Dialogue: 0,0:28:55.73,0:28:58.74,Default,,0000,0000,0000,,Ол жүз қадамға айналады делік...
Dialogue: 0,0:29:00.57,0:29:03.48,Default,,0000,0000,0000,,Оның айналуы мүмкін емес...
Dialogue: 0,0:29:03.48,0:29:07.11,Default,,0000,0000,0000,,Жер қозғалды делік➡
Dialogue: 0,0:29:07.11,0:29:10.92,Default,,0000,0000,0000,,Птолемей әлемі
Dialogue: 0,0:29:07.11,0:29:10.92,Default,,0000,0000,0000,,Гелиоцентрлік теорияға қолданғанда...➡
Dialogue: 0,0:29:10.92,0:29:14.22,Default,,0000,0000,0000,,Тұрғылықты
Dialogue: 0,0:29:10.92,0:29:14.22,Default,,0000,0000,0000,,Күннен тыс орналасқан планеталар ➡
Dialogue: 0,0:29:14.22,0:29:17.69,Default,,0000,0000,0000,,Эпициклдің радиусы тең
Dialogue: 0,0:29:14.22,0:29:17.69,Default,,0000,0000,0000,,Күннің орбиталық радиусына сәйкес келгенше➡
Dialogue: 0,0:29:17.69,0:29:20.16,Default,,0000,0000,0000,,Оны үлкейту немесе кішірейту ғана...➡
Dialogue: 0,0:29:20.16,0:29:25.13,Default,,0000,0000,0000,,Күннің ішінде орналасқан планеталар үшін эпициклдің центрі
Dialogue: 0,0:29:20.16,0:29:25.13,Default,,0000,0000,0000,,Күнге сәйкес келгенше кеңейтіңіз...➡
Dialogue: 0,0:29:25.13,0:29:28.37,Default,,0000,0000,0000,,Басқаша айтқанда, бағыттаушы шеңбер Күннің орбитасымен бірдей...➡
Dialogue: 0,0:29:28.37,0:29:33.97,Default,,0000,0000,0000,,Жер сол бағыттаушы шеңберлерді жүргізеді
Dialogue: 0,0:29:28.37,0:29:33.97,Default,,0000,0000,0000,,Мауах
Dialogue: 0,0:29:28.37,0:29:33.97,Default,,0000,0000,0000,,Күнді айналатынын ескерсек...
Dialogue: 0,0:29:33.97,0:29:35.97,Default,,0000,0000,0000,,(Қаламмен жазу дыбысы)
Dialogue: 0,0:29:35.97,0:29:41.31,Default,,0000,0000,0000,,<Бұл күлкілі адасушылық идеология.
Dialogue: 0,0:29:35.97,0:29:41.31,Default,,0000,0000,0000,,Бұл жай ғана дұрыс емес. ➡
Dialogue: 0,0:29:41.31,0:29:45.22,Default,,0000,0000,0000,,Тіпті ұсталып қалу қаупі де бар.
Dialogue: 0,0:29:41.31,0:29:45.22,Default,,0000,0000,0000,,Іздеуге ешқандай себеп жоқ
Dialogue: 0,0:29:46.89,0:29:50.32,Default,,0000,0000,0000,,(Гюберттің дауысы)
Dialogue: 0,0:29:46.89,0:29:50.32,Default,,0000,0000,0000,,Бір кездері бөлінген планеталар тізбекте қозғалады➡
Dialogue: 0,0:29:50.32,0:29:53.26,Default,,0000,0000,0000,,Әлем бір тәртіпке біріктірілген...
Dialogue: 0,0:29:53.26,0:29:56.83,Default,,0000,0000,0000,,<Барлығы бір-бірімен байланысты және үйлесімді ме? ➡
Dialogue: 0,0:29:56.83,0:30:00.73,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:29:56.83,0:30:00.73,Default,,0000,0000,0000,,Бүкіл ғалам бір ретпен қозғала ма? ＞
Dialogue: 0,0:30:00.73,0:30:03.54,Default,,0000,0000,0000,,(қағаздың жыртылып, оралған дыбысы)
Dialogue: 0,0:30:03.54,0:30:07.34,Default,,0000,0000,0000,,<Оның бәрі өтірік. Планеталар шашыраңқы
Dialogue: 0,0:30:09.34,0:30:11.54,Default,,0000,0000,0000,,<Иә. Әйтпесе>
Dialogue: 0,0:30:14.08,0:30:18.02,Default,,0000,0000,0000,,＜Осындай алып аспан бір идеядан жаралған➡
Dialogue: 0,0:30:18.02,0:30:20.42,Default,,0000,0000,0000,,Егер ол соншалықты ұтымды қозғалса>
Dialogue: 0,0:30:22.79,0:30:25.69,Default,,0000,0000,0000,,<Бұл теория➡
Dialogue: 0,0:30:25.69,0:30:28.89,Default,,0000,0000,0000,,Менің ойымша, бұл әдемі! ! ＞
Dialogue: 0,0:30:36.17,0:30:38.87,Default,,0000,0000,0000,,<Дұрыс. ...мүмкін>
Dialogue: 0,0:30:41.61,0:30:46.28,Default,,0000,0000,0000,,♬ «Қайта-қайта айқайлау»
Dialogue: 0,0:30:46.28,0:30:54.62,Default,,0000,0000,0000,,♬ «Осы қараңғы түнде құбыжық болып кетсем де».
Dialogue: 0,0:30:54.62,0:31:00.23,Default,,0000,0000,0000,,♬ «Мен оны осында қалдырғым келеді».
Dialogue: 0,0:31:00.23,0:31:02.23,Default,,0000,0000,0000,,♬ «Бұл құпия»
Dialogue: 0,0:31:05.00,0:31:08.87,Default,,0000,0000,0000,,♬ «Біртіндеп тамақтаныңыз»
Dialogue: 0,0:31:08.87,0:31:15.64,Default,,0000,0000,0000,,♬ «Қызыл және көк жұлдыздар, болашақтан өткенге»
Dialogue: 0,0:31:15.64,0:31:19.51,Default,,0000,0000,0000,,♬ «Тәртіппен тамақтаныңыз»
Dialogue: 0,0:31:19.51,0:31:27.59,Default,,0000,0000,0000,,♬ «Оны ондаған рет шайнаңыз, еріген кезде ішіңіз».
Dialogue: 0,0:31:27.59,0:31:32.19,Default,,0000,0000,0000,,♬ «Төбедегі жұлдыздарды көргенде»
Dialogue: 0,0:31:32.19,0:31:38.13,Default,,0000,0000,0000,,♬ «Бұл жалғыздықты мен де сезінемін»
Dialogue: 0,0:31:38.13,0:31:40.90,Default,,0000,0000,0000,,♬ «Күн шыққанда»
Dialogue: 0,0:31:40.90,0:31:47.67,Default,,0000,0000,0000,,♬ «Қолдарым боялған кезде мен ұмытып кеттім».
Dialogue: 0,0:31:47.67,0:31:54.98,Default,,0000,0000,0000,,♬ «Бұл әлем ыңғайлы аяқталмаған».
Dialogue: 0,0:31:54.98,0:31:57.88,Default,,0000,0000,0000,,♬ «Сондықтан мен білгім келеді».
Dialogue: 0,0:31:57.88,0:32:05.46,Default,,0000,0000,0000,,♬ «Бірақ мен құбыжық сияқты алысқа айқайласам да»
Dialogue: 0,0:32:05.46,0:32:09.26,Default,,0000,0000,0000,,♬ «Ол қайтадан жоғалады».
Dialogue: 0,0:32:13.20,0:32:17.57,Default,,0000,0000,0000,,Мм. соңғы бірнеше күн
Dialogue: 0,0:32:13.20,0:32:17.57,Default,,0000,0000,0000,,Дәлдік одан әрі жақсарды.
Dialogue: 0,0:32:17.57,0:32:20.27,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:32:17.57,0:32:20.27,Default,,0000,0000,0000,,Бірдеңе болды ма?
Dialogue: 0,0:32:25.91,0:32:29.35,Default,,0000,0000,0000,,Ум...
Dialogue: 0,0:32:29.35,0:32:33.69,Default,,0000,0000,0000,,Неліктен Губерт тәуекелге барды...➡
Dialogue: 0,0:32:33.69,0:32:37.46,Default,,0000,0000,0000,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,0:32:33.69,0:32:37.46,Default,,0000,0000,0000,,Мен аспаннан бас тартқанша
Dialogue: 0,0:32:33.69,0:32:37.46,Default,,0000,0000,0000,,Сіз мұны істеп жатырсыз ба?
Dialogue: 0,0:32:37.46,0:32:40.86,Default,,0000,0000,0000,,Құдайды жоққа шығарғыңыз келе ме?
Dialogue: 0,0:32:40.86,0:32:45.40,Default,,0000,0000,0000,,Бұл керісінше. Мен мұны Құдайға сенгендіктен жасаймын.
Dialogue: 0,0:32:45.40,0:32:48.33,Default,,0000,0000,0000,,Не...?
Dialogue: 0,0:32:48.33,0:32:56.71,Default,,0000,0000,0000,,Алдағы Эльдий әскері
Dialogue: 0,0:32:48.33,0:32:56.71,Default,,0000,0000,0000,,Бұл дүние шіркін, сараң, арам дүние.
Dialogue: 0,0:32:48.33,0:32:56.71,Default,,0000,0000,0000,,О дүние таза, әдемі дейді.
Dialogue: 0,0:32:56.71,0:33:01.45,Default,,0000,0000,0000,,Бірақ мен мұны қабылдамаймын.
Dialogue: 0,0:33:01.45,0:33:06.65,Default,,0000,0000,0000,,Құдай жаратқан бұл әлем
Dialogue: 0,0:33:01.45,0:33:06.65,Default,,0000,0000,0000,,Оның бәрінен де әдемі екеніне сенімдімін.
Dialogue: 0,0:33:10.19,0:33:15.63,Default,,0000,0000,0000,,Мұны білу
Dialogue: 0,0:33:10.19,0:33:15.63,Default,,0000,0000,0000,,Сізге соқыр сенім, ақша немесе мәртебе қажет емес.
Dialogue: 0,0:33:15.63,0:33:20.53,Default,,0000,0000,0000,,Тек өзіңіздің ақыл-парасатыңызды алып жүріңіз
Dialogue: 0,0:33:15.63,0:33:20.53,Default,,0000,0000,0000,,Шайнау
Dialogue: 0,0:33:15.63,0:33:20.53,Default,,0000,0000,0000,,Менің мына кішкентай бас сүйегімнің ішінде➡
Dialogue: 0,0:33:20.53,0:33:24.64,Default,,0000,0000,0000,,Құдайдың ұлы істерін түсіну.
Dialogue: 0,0:33:24.64,0:33:29.44,Default,,0000,0000,0000,,Сондықтан мен Киелі кітапты емес, табиғатты оқимын.
Dialogue: 0,0:33:31.21,0:33:35.58,Default,,0000,0000,0000,,Сонымен, мұндай өмір...➡
Dialogue: 0,0:33:35.58,0:33:37.92,Default,,0000,0000,0000,,Сіз қорықпайсыз ба?
Dialogue: 0,0:33:37.92,0:33:39.85,Default,,0000,0000,0000,,Қорқынышты.
Dialogue: 0,0:33:39.85,0:33:41.89,Default,,0000,0000,0000,,Е...⁉
Dialogue: 0,0:33:41.89,0:33:47.46,Default,,0000,0000,0000,,Бірақ қорқынышсыз өмір жоқ.
Dialogue: 0,0:33:41.89,0:33:47.46,Default,,0000,0000,0000,,Оның мәні жоқ.
Dialogue: 0,0:33:47.46,0:33:49.56,Default,,0000,0000,0000,,бұл...!
Dialogue: 0,0:33:51.30,0:33:54.03,Default,,0000,0000,0000,,О, және ➡
Dialogue: 0,0:33:54.03,0:33:57.44,Default,,0000,0000,0000,,Бақылау бүгін аяқталады.
Dialogue: 0,0:33:54.03,0:33:57.44,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:33:59.60,0:34:02.87,Default,,0000,0000,0000,,Жалғыз жалғастырудың жолын таптым.
Dialogue: 0,0:34:02.87,0:34:08.35,Default,,0000,0000,0000,,Ертең
Dialogue: 0,0:34:02.87,0:34:08.35,Default,,0000,0000,0000,,Сонымен, мен ертеңнен бастап не істеймін?
Dialogue: 0,0:34:08.35,0:34:11.98,Default,,0000,0000,0000,,Келіңіздер. Бұл сіздің еркіндігіңіз.
Dialogue: 0,0:34:11.98,0:34:13.92,Default,,0000,0000,0000,,Бірақ…➡
Dialogue: 0,0:34:13.92,0:34:18.19,Default,,0000,0000,0000,,Астрономиямен айналысыңыз. Өзім үшін.
Dialogue: 0,0:34:18.19,0:34:20.46,Default,,0000,0000,0000,,бұл….
Dialogue: 0,0:34:20.46,0:34:24.33,Default,,0000,0000,0000,,Бұл ұсыныс.
Dialogue: 0,0:34:24.33,0:34:27.43,Default,,0000,0000,0000,,Ал, барлығы үшін рахмет.
Dialogue: 0,0:34:30.13,0:34:32.14,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:34:35.67,0:34:38.88,Default,,0000,0000,0000,,<Бітті... тез... ➡
Dialogue: 0,0:34:38.88,0:34:40.88,Default,,0000,0000,0000,,Бұл не болды? ➡
Dialogue: 0,0:34:40.88,0:34:45.25,Default,,0000,0000,0000,,Астрономиямен қалай айналысуға болады?>
Dialogue: 0,0:34:45.25,0:34:47.19,Default,,0000,0000,0000,,Фалько…
Dialogue: 0,0:34:47.19,0:34:49.12,Default,,0000,0000,0000,,Ах...⁉
Dialogue: 0,0:34:49.12,0:34:52.79,Default,,0000,0000,0000,,Потоцки мырза? Неге үйдің алдында?
Dialogue: 0,0:34:52.79,0:34:54.73,Default,,0000,0000,0000,,Эй...?
Dialogue: 0,0:34:54.73,0:34:56.73,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:34:54.73,0:34:56.73,Default,,0000,0000,0000,,Фалько…
Dialogue: 0,0:34:58.46,0:35:00.47,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,0:35:02.47,0:35:04.60,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:35:04.60,0:35:09.94,Default,,0000,0000,0000,,Сіз Рафаусыз ба?
Dialogue: 0,0:35:04.60,0:35:09.94,Default,,0000,0000,0000,,Мен инквизитор Новакпын.
Dialogue: 0,0:35:09.94,0:35:13.95,Default,,0000,0000,0000,,Губерт мырза дінге кіргеннен кейін не болды?
Dialogue: 0,0:35:09.94,0:35:13.95,Default,,0000,0000,0000,,Тыңдаңыз.
Dialogue: 0,0:35:13.95,0:35:16.41,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:35:16.41,0:35:20.95,Default,,0000,0000,0000,,Хуберт мырза өзін сәтті қалпына келтірді.
Dialogue: 0,0:35:16.41,0:35:20.95,Default,,0000,0000,0000,,Цуцу
Dialogue: 0,0:35:16.41,0:35:20.95,Default,,0000,0000,0000,,Мен қарапайым өмір сүремін.
Dialogue: 0,0:35:20.95,0:35:23.52,Default,,0000,0000,0000,,...
Dialogue: 0,0:35:23.52,0:35:28.09,Default,,0000,0000,0000,,Қараңызшы, екі рет адасушы ретінде ұсталсаңыз.
Dialogue: 0,0:35:23.52,0:35:28.09,Default,,0000,0000,0000,,Бұл абсолютті өлім жазасы.
Dialogue: 0,0:35:28.09,0:35:31.53,Default,,0000,0000,0000,,N….
Dialogue: 0,0:35:28.09,0:35:31.53,Default,,0000,0000,0000,,...
Dialogue: 0,0:35:28.09,0:35:31.53,Default,,0000,0000,0000,,Оны жасырған кооператор да ауыр қылмыс. ➡
Dialogue: 0,0:35:31.53,0:35:35.03,Default,,0000,0000,0000,,...
Dialogue: 0,0:35:35.03,0:35:39.40,Default,,0000,0000,0000,,Бұл қиын.
Dialogue: 0,0:35:35.03,0:35:39.40,Default,,0000,0000,0000,,Мен де ақымақ бидғатқа шыдай алмаймын.
Dialogue: 0,0:35:39.40,0:35:41.71,Default,,0000,0000,0000,,О, бұл сендіреді!
Dialogue: 0,0:35:39.40,0:35:41.71,Default,,0000,0000,0000,,…
Dialogue: 0,0:35:43.27,0:35:45.74,Default,,0000,0000,0000,,...
Dialogue: 0,0:35:45.74,0:35:48.55,Default,,0000,0000,0000,,...
Dialogue: 0,0:35:48.55,0:35:50.48,Default,,0000,0000,0000,,О! !
Dialogue: 0,0:35:50.48,0:35:53.42,Default,,0000,0000,0000,,Оны кітап сөресінен таптым.
Dialogue: 0,0:35:53.42,0:35:56.32,Default,,0000,0000,0000,,Мен Потоцки мырзаға әлі айтқан жоқпын.
Dialogue: 0,0:35:56.32,0:36:01.89,Default,,0000,0000,0000,,Еретистік зерттеулерге қатысты
Dialogue: 0,0:35:56.32,0:36:01.89,Default,,0000,0000,0000,,➡
Dialogue: 0,0:36:01.89,0:36:05.70,Default,,0000,0000,0000,,...
Dialogue: 0,0:36:01.89,0:36:05.70,Default,,0000,0000,0000,,… …
Dialogue: 0,0:36:05.70,0:36:08.00,Default,,0000,0000,0000,,...
Dialogue: 0,0:36:10.57,0:36:13.47,Default,,0000,0000,0000,,Бұл менікі.
Dialogue: 0,0:36:10.57,0:36:13.47,Default,,0000,0000,0000,,Мен саған осылай үнсіз өлуді айта алмаймын!!
Dialogue: 0,0:36:13.47,0:36:16.47,Default,,0000,0000,0000,,Хуберт-сан⁉
Dialogue: 0,0:36:16.47,0:36:21.18,Default,,0000,0000,0000,,Егер сіз оны баланың бөлмесіне жасырсаңыз
Dialogue: 0,0:36:16.47,0:36:21.18,Default,,0000,0000,0000,,Мен оны табу қиын болар деп ойладым...
Dialogue: 0,0:36:21.18,0:36:23.61,Default,,0000,0000,0000,,Ол анықталса, көмектесу мүмкін емес.
Dialogue: 0,0:36:23.61,0:36:27.59,Default,,0000,0000,0000,,Ах. Жоқ, солай ма?
Dialogue: 0,0:36:27.59,0:36:31.36,Default,,0000,0000,0000,,Бірақ Губерт мырза
Dialogue: 0,0:36:27.59,0:36:31.36,Default,,0000,0000,0000,,Тынышталыңыз.
Dialogue: 0,0:36:31.36,0:36:36.26,Default,,0000,0000,0000,,...
Dialogue: 0,0:36:31.36,0:36:36.26,Default,,0000,0000,0000,,...
Dialogue: 0,0:36:39.43,0:36:42.83,Default,,0000,0000,0000,,Ол сондай адам.
Dialogue: 0,0:36:39.43,0:36:42.83,Default,,0000,0000,0000,,...
Dialogue: 0,0:36:44.74,0:36:46.70,Default,,0000,0000,0000,,Адал бол.
Dialogue: 0,0:36:46.70,0:36:51.08,Default,,0000,0000,0000,,Бұл шынымен сенікі ме?
Dialogue: 0,0:36:51.08,0:36:53.84,Default,,0000,0000,0000,,Әрине менікі.
Dialogue: 0,0:36:53.84,0:36:57.42,Default,,0000,0000,0000,,Мен сенің сабырлы болғаныңды қалаймын.
Dialogue: 0,0:36:57.42,0:37:01.52,Default,,0000,0000,0000,,Менің зерттеуім мұндай балаға көмектеседі деп ойлайсыз ба?
Dialogue: 0,0:37:03.22,0:37:06.09,Default,,0000,0000,0000,,Бұл рас!
Dialogue: 0,0:37:06.09,0:37:08.29,Default,,0000,0000,0000,,Кешіріңіз, Рафау-кун!
Dialogue: 0,0:37:10.29,0:37:12.56,Default,,0000,0000,0000,,Енді Хубертті алып кетіңіз.
Dialogue: 0,0:37:12.56,0:37:15.37,Default,,0000,0000,0000,,Иә! Е, күте тұрыңыз...➡
Dialogue: 0,0:37:15.37,0:37:18.80,Default,,0000,0000,0000,,Сәлем! Сонымен кенеттен!?
Dialogue: 0,0:37:18.80,0:37:21.84,Default,,0000,0000,0000,,Аа, дұрыс.
Dialogue: 0,0:37:21.84,0:37:24.64,Default,,0000,0000,0000,,Мұны сізге беріңіз
Dialogue: 0,0:37:21.84,0:37:24.64,Default,,0000,0000,0000,,Мен оны саған беруге келдім.
Dialogue: 0,0:37:29.38,0:37:32.12,Default,,0000,0000,0000,,Сонда кездескенше.
Dialogue: 0,0:37:29.38,0:37:32.12,Default,,0000,0000,0000,,Е.
Dialogue: 0,0:37:32.12,0:37:34.52,Default,,0000,0000,0000,,Хуберт мырза! !
Dialogue: 0,0:37:34.52,0:37:38.92,Default,,0000,0000,0000,,Хо, сен шынымен барасың ба?
Dialogue: 0,0:37:34.52,0:37:38.92,Default,,0000,0000,0000,,Аяқталмаған не қалды?
Dialogue: 0,0:37:40.63,0:37:42.56,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:37:42.56,0:37:46.00,Default,,0000,0000,0000,,Мен мұны жасадым.
Dialogue: 0,0:37:46.00,0:37:48.10,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:37:52.30,0:37:56.31,Default,,0000,0000,0000,,
Dialogue: 0,0:37:52.30,0:37:56.31,Default,,0000,0000,0000,,<Ал мистер Губерт өртеніп өлді>
Dialogue: 0,0:38:11.19,0:38:15.13,Default,,0000,0000,0000,,'Жануар Титаны'!!
Dialogue: 0,0:38:11.19,0:38:15.13,Default,,0000,0000,0000,,<Өлі. Мені қорғаңыз... ➡
Dialogue: 0,0:38:15.13,0:38:21.57,Default,,0000,0000,0000,,Қарсы тарап бидғатшы болса да...
Dialogue: 0,0:38:15.13,0:38:21.57,Default,,0000,0000,0000,,Мен үшін не істегенім дұрыс болды? ➡
Dialogue: 0,0:38:21.57,0:38:24.80,Default,,0000,0000,0000,,Не істеу керек...＞
Dialogue: 0,0:38:24.80,0:38:27.71,Default,,0000,0000,0000,,Үш жұлдыз….
Dialogue: 0,0:38:27.71,0:38:30.24,Default,,0000,0000,0000,,Орионның белбеуі?
Dialogue: 0,0:38:30.24,0:38:33.74,Default,,0000,0000,0000,,Неліктен тек орталық алнылам қара...?
Dialogue: 0,0:38:35.48,0:38:38.38,Default,,0000,0000,0000,,Ал сол тас пен таудың орны➡
Dialogue: 0,0:38:38.38,0:38:42.25,Default,,0000,0000,0000,,Орионның белдеуіне де ұқсас
Dialogue: 0,0:38:38.38,0:38:42.25,Default,,0000,0000,0000,,Маған ұнайды.
Dialogue: 0,0:38:42.25,0:38:44.26,Default,,0000,0000,0000,,…Ах.
Dialogue: 0,0:38:47.63,0:38:50.43,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,0:38:50.43,0:38:54.83,Default,,0000,0000,0000,,Ха ха ха ха....
Dialogue: 0,0:38:54.83,0:38:57.74,Default,,0000,0000,0000,,Ааа...
Dialogue: 0,0:38:57.74,0:38:59.84,Default,,0000,0000,0000,,А...
Dialogue: 0,0:39:04.91,0:39:09.78,Default,,0000,0000,0000,,Әлниламды белгілейтін тауға келсем де,
Dialogue: 0,0:39:04.91,0:39:09.78,Default,,0000,0000,0000,,Ештеңе….
Dialogue: 0,0:39:09.78,0:39:11.78,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:39:11.78,0:39:21.36,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:39:21.36,0:39:23.36,Default,,0000,0000,0000,,Ха...!
Dialogue: 0,0:39:27.57,0:39:30.97,Default,,0000,0000,0000,,Бұл... хат па?
Dialogue: 0,0:39:32.54,0:39:36.27,Default,,0000,0000,0000,,Не керек, Крюгер мырза?
Dialogue: 0,0:39:32.54,0:39:36.27,Default,,0000,0000,0000,,«Осы хатты оқып отырған сізге.»
Dialogue: 0,0:39:36.27,0:39:42.71,Default,,0000,0000,0000,,Қылқалам
Dialogue: 0,0:39:36.27,0:39:42.71,Default,,0000,0000,0000,,«Елсіз кіріспе үшін кешірім сұраймын.
Dialogue: 0,0:39:36.27,0:39:42.71,Default,,0000,0000,0000,,Мен сенің кім екеніңді білмеймін. ➡
Dialogue: 0,0:39:42.71,0:39:49.79,Default,,0000,0000,0000,,Бірақ ең сенімділерге
Dialogue: 0,0:39:42.71,0:39:49.79,Default,,0000,0000,0000,,Мен сізге алқаны сеніп тапсырамын. ➡
Dialogue: 0,0:39:49.79,0:39:52.39,Default,,0000,0000,0000,,Негізгі тақырыпқа көшейік. ➡
Dialogue: 0,0:39:52.39,0:39:58.93,Default,,0000,0000,0000,,Олар сен үшін қатты уайымдады.
Dialogue: 0,0:39:52.39,0:39:58.93,Default,,0000,0000,0000,,Төмендегі кітаптар мен өмірімді арнадым.
Dialogue: 0,0:39:52.39,0:39:58.93,Default,,0000,0000,0000,,Мұның бәрі гелиоцентрлік теория туралы. ➡
Dialogue: 0,0:39:58.93,0:40:02.23,Default,,0000,0000,0000,,Сондықтан мен сізге толықтай сенемін➡
Dialogue: 0,0:40:02.23,0:40:05.97,Default,,0000,0000,0000,,Мен аяқтамай қалдырған ісімді орындауыңызды өтінемін. ➡
Dialogue: 0,0:40:05.97,0:40:09.24,Default,,0000,0000,0000,,Осының бәрін өртеп жіберіңіз.''
Dialogue: 0,0:40:09.24,0:40:11.18,Default,,0000,0000,0000,,⁉
Dialogue: 0,0:40:11.18,0:40:15.68,Default,,0000,0000,0000,,「
Dialogue: 0,0:40:11.18,0:40:15.68,Default,,0000,0000,0000,,Біз гелиоцентрлік теорияға жақындап келе жатқанымызға сенімдіміз. ➡
Dialogue: 0,0:40:15.68,0:40:21.25,Default,,0000,0000,0000,,➡
Dialogue: 0,0:40:21.25,0:40:25.09,Default,,0000,0000,0000,,Гелиоцентрлік теорияны дәлелдеу мүмкін емес шығар. ➡
Dialogue: 0,0:40:25.09,0:40:28.36,Default,,0000,0000,0000,,Тым көп белгісіздік. ➡
Dialogue: 0,0:40:28.36,0:40:32.36,Default,,0000,0000,0000,,➡
Dialogue: 0,0:40:32.36,0:40:38.57,Default,,0000,0000,0000,,Егер
Dialogue: 0,0:40:32.36,0:40:38.57,Default,,0000,0000,0000,,➡
Dialogue: 0,0:40:38.57,0:40:43.07,Default,,0000,0000,0000,,Бірақ мен өзімді өкінбеймін
Dialogue: 0,0:40:38.57,0:40:43.07,Default,,0000,0000,0000,,Оны өртеп жіберуге батылдық танытпау➡
Dialogue: 0,0:40:43.07,0:40:50.82,Default,,0000,0000,0000,,...
Dialogue: 0,0:40:43.07,0:40:50.82,Default,,0000,0000,0000,,Өртену керек. ➡
Dialogue: 0,0:40:50.82,0:40:56.05,Default,,0000,0000,0000,,Бұл сенсің. Сіз оны өртеп аласыз. ➡
Dialogue: 0,0:40:56.05,0:41:00.76,Default,,0000,0000,0000,,Сіздің “себепіңіз”
Dialogue: 0,0:40:56.05,0:41:00.76,Default,,0000,0000,0000,,“”➡
Dialogue: 0,0:41:00.76,0:41:03.43,Default,,0000,0000,0000,,Сіз мұны істей аласыз. ➡
Dialogue: 0,0:41:03.43,0:41:08.63,Default,,0000,0000,0000,,Сұраныс сыйлығы қорапқа салынған.
Dialogue: 0,0:41:03.43,0:41:08.63,Default,,0000,0000,0000,,Бұл жеткілікті шығар. ➡
Dialogue: 0,0:41:08.63,0:41:12.14,Default,,0000,0000,0000,,--Олай болса мен сізге қалдырамын.''
Dialogue: 0,0:41:16.14,0:41:19.11,Default,,0000,0000,0000,,<Жарайды, көмектесу мүмкін емес... ➡
Dialogue: 0,0:41:19.11,0:41:23.35,Default,,0000,0000,0000,,➡
Dialogue: 0,0:41:23.35,0:41:26.68,Default,,0000,0000,0000,,(Реинер) Гү!
Dialogue: 0,0:41:23.35,0:41:26.68,Default,,0000,0000,0000,,➡
Dialogue: 0,0:41:26.68,0:41:30.89,Default,,0000,0000,0000,,…➡
Dialogue: 0,0:41:30.89,0:41:33.86,Default,,0000,0000,0000,,Ең бастысы, бұл белгісіз. ➡
Dialogue: 0,0:41:33.86,0:41:37.46,Default,,0000,0000,0000,,➡
Dialogue: 0,0:41:37.46,0:41:40.70,Default,,0000,0000,0000,,Бұны өртеуден басқа амалымыз жоқ. ➡
Dialogue: 0,0:41:40.70,0:41:44.13,Default,,0000,0000,0000,,Хуберт мырза айтқандай➡
Dialogue: 0,0:41:44.13,0:41:48.14,Default,,0000,0000,0000,,Менің ойым кітаптарды өртеп жіберді>
Dialogue: 0,0:41:57.01,0:41:59.12,Default,,0000,0000,0000,,<Бірақ...>
Dialogue: 0,0:42:03.79,0:42:07.02,Default,,0000,0000,0000,,Ахх! ! Арх! Ха!
Dialogue: 0,0:42:07.02,0:42:08.96,Default,,0000,0000,0000,,Жану логикасына қарағанда! !
Dialogue: 0,0:42:08.96,0:42:12.26,Default,,0000,0000,0000,,Менің түйсігім! Мен гелиоцентрлік теорияға сенгім келеді! !
Dialogue: 0,0:42:16.47,0:42:18.40,Default,,0000,0000,0000,,Бәріңіз тыңдаңыздар!
Dialogue: 0,0:42:18.40,0:42:23.14,Default,,0000,0000,0000,,Артында қалғаным ұят
Dialogue: 0,0:42:18.40,0:42:23.14,Default,,0000,0000,0000,,...
Dialogue: 0,0:42:23.14,0:42:27.44,Default,,0000,0000,0000,,...
Dialogue: 0,0:42:27.44,0:42:33.78,Default,,0000,0000,0000,,...
Dialogue: 0,0:42:27.44,0:42:33.78,Default,,0000,0000,0000,,Есіңде ме?
Dialogue: 0,0:42:33.78,0:42:37.49,Default,,0000,0000,0000,,...
Dialogue: 0,0:42:33.78,0:42:37.49,Default,,0000,0000,0000,,Дұрыс! !
Dialogue: 0,0:42:37.49,0:42:40.46,Default,,0000,0000,0000,,
Dialogue: 0,0:42:37.49,0:42:40.46,Default,,0000,0000,0000,,Рафау. Барлығымен қоштасу.
Dialogue: 0,0:42:40.46,0:42:42.46,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:42:45.06,0:42:47.70,Default,,0000,0000,0000,,Осы уақытқа дейін көрсеткен көмегіңіз үшін рахмет.
Dialogue: 0,0:42:47.70,0:42:54.07,Default,,0000,0000,0000,,Мен сені енді көре алмаймын, бірақ бәріне.
Dialogue: 0,0:42:47.70,0:42:54.07,Default,,0000,0000,0000,,Алла разы болсын деп дұға етемін.
Dialogue: 0,0:42:54.07,0:42:56.07,Default,,0000,0000,0000,,О, және...
Dialogue: 0,0:42:58.01,0:43:00.41,Default,,0000,0000,0000,,Мен астрономияны оқимын.
Dialogue: 0,0:43:04.45,0:43:08.92,Default,,0000,0000,0000,,<Кешіріңіз, бірақ
Dialogue: 0,0:43:04.45,0:43:08.92,Default,,0000,0000,0000,,Бұл дүние ақымақтарға толы. ➡
Dialogue: 0,0:43:08.92,0:43:13.02,Default,,0000,0000,0000,,Бірақ мен білмей тұрып, мен алдыңғы жағында тұрдым.＞
Dialogue: 0,0:43:16.23,0:43:21.97,Default,,0000,0000,0000,,Олар Тайбар әулетінің күзетшілері…
Dialogue: 0,0:43:16.23,0:43:21.97,Default,,0000,0000,0000,,<Нағыз мен «адал» да, «ақылды» да емес
Dialogue: 0,0:43:16.23,0:43:21.97,Default,,0000,0000,0000,,«Кішіпейіл» де, «күшті» де емес➡
Dialogue: 0,0:43:21.97,0:43:26.80,Default,,0000,0000,0000,,«Тәкаппар», «менмен», «бейқам» және «дәрменсіз»――➡
Dialogue: 0,0:43:26.80,0:43:30.47,Default,,0000,0000,0000,,Ал қазірден бастап жерді жылжытыңыз＞
Dialogue: 0,0:43:30.47,0:43:36.78,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:43:38.78,0:43:41.55,Default,,0000,0000,0000,,Қиналғанда үлкендерден сұра...
Dialogue: 0,0:43:41.55,0:43:44.79,Default,,0000,0000,0000,,Ой... Қараңызшы! Дәл осылай!
Dialogue: 0,0:43:44.79,0:43:46.79,Default,,0000,0000,0000,,Йотто.
Dialogue: 0,0:43:48.49,0:43:51.26,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:43:48.49,0:43:51.26,Default,,0000,0000,0000,,Рахмет!
Dialogue: 0,0:43:51.26,0:43:54.77,Default,,0000,0000,0000,,Жол жиегінде жылап тұрған бала
Dialogue: 0,0:43:51.26,0:43:54.77,Default,,0000,0000,0000,,Оны елемеуге болмайды.
Dialogue: 0,0:43:54.77,0:43:56.83,Default,,0000,0000,0000,,Отбасыңды қадірле.
Dialogue: 0,0:43:56.83,0:43:59.30,Default,,0000,0000,0000,,А... иә!
Dialogue: 0,0:43:59.30,0:44:01.74,Default,,0000,0000,0000,,Аа, Новак мырза, уақыт келді...
Dialogue: 0,0:44:01.74,0:44:03.94,Default,,0000,0000,0000,,О.
Dialogue: 0,0:44:07.98,0:44:11.42,Default,,0000,0000,0000,,Тосын сапар
Dialogue: 0,0:44:07.98,0:44:11.42,Default,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:44:11.42,0:44:14.08,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:44:14.08,0:44:19.06,Default,,0000,0000,0000,,Сіз не істемексіз?
Dialogue: 0,0:44:14.08,0:44:19.06,Default,,0000,0000,0000,,Менің балам бар...
Dialogue: 0,0:44:19.06,0:44:23.66,Default,,0000,0000,0000,,Шынымен! Негізі менің де қызым бар!
Dialogue: 0,0:44:23.66,0:44:27.97,Default,,0000,0000,0000,,Жақында 4 жасқа толды
Dialogue: 0,0:44:23.66,0:44:27.97,Default,,0000,0000,0000,,Бұл өте сүйкімді!
Dialogue: 0,0:44:29.77,0:44:35.04,Default,,0000,0000,0000,,Мынаны қара! Қызымнан хат!
Dialogue: 0,0:44:29.77,0:44:35.04,Default,,0000,0000,0000,,Мен оны үнемі өзіммен бірге алып жүремін.
Dialogue: 0,0:44:35.04,0:44:37.07,Default,,0000,0000,0000,,Ха...!
Dialogue: 0,0:44:37.07,0:44:40.38,Default,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:44:37.07,0:44:40.38,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:44:37.07,0:44:40.38,Default,,0000,0000,0000,,Мен бұл қызды ойлаған сайын сезінемін.
Dialogue: 0,0:44:40.38,0:44:44.85,Default,,0000,0000,0000,,Емдік пен қуат және...➡
Dialogue: 0,0:44:44.85,0:44:47.35,Default,,0000,0000,0000,,Мазасыздық.
Dialogue: 0,0:44:47.35,0:44:51.22,Default,,0000,0000,0000,,Балаға деген сүйіспеншілік – өмір сүру себебім.
Dialogue: 0,0:44:51.22,0:44:55.06,Default,,0000,0000,0000,,Ауыр.
Dialogue: 0,0:44:51.22,0:44:55.06,Default,,0000,0000,0000,,Мен ол балада ауыр сезім болғанын қаламаймын.
Dialogue: 0,0:44:55.06,0:44:59.76,Default,,0000,0000,0000,,Демек, бұл дүниенің тыныштығын бұзатын кез келген нәрсе
Dialogue: 0,0:44:55.06,0:44:59.76,Default,,0000,0000,0000,,Зерттеуді назардан тыс қалдыруға болмайды.
Dialogue: 0,0:45:01.37,0:45:06.87,Default,,0000,0000,0000,,Шынымды айтсам, мен әлемді де, адамзатты да қорғағым келмейді.
Dialogue: 0,0:45:01.37,0:45:06.87,Default,,0000,0000,0000,,Мен мұны үлкен мәселе деп ойламадым.
Dialogue: 0,0:45:06.87,0:45:13.94,Default,,0000,0000,0000,,Бірақ отбасы мен достары
Dialogue: 0,0:45:06.87,0:45:13.94,Default,,0000,0000,0000,,Күнделікті «сеніміңізді» және «өміріңізді» қорғау үшін➡
Dialogue: 0,0:45:13.94,0:45:16.25,Default,,0000,0000,0000,,Мен бәрін істеймін.
Dialogue: 0,0:45:13.94,0:45:16.25,Default,,0000,0000,0000,,О! !
Dialogue: 0,0:45:18.45,0:45:21.19,Default,,0000,0000,0000,,Мен үйдемін...
Dialogue: 0,0:45:21.19,0:45:23.12,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:45:23.12,0:45:27.12,Default,,0000,0000,0000,,Ачааа
Dialogue: 0,0:45:23.12,0:45:27.12,Default,,0000,0000,0000,,Сіз мұнда бала болдыңыз...
Dialogue: 0,0:45:29.43,0:45:31.43,Default,,0000,0000,0000,,(есіктің ашылған дыбысы)
Dialogue: 0,0:45:29.43,0:45:31.43,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:45:35.73,0:45:38.67,Default,,0000,0000,0000,,Иә Жындардың кездесу орны.
Dialogue: 0,0:45:38.67,0:45:43.04,Default,,0000,0000,0000,,Қалғанын саған қалдырамын. Мен отбасыммен кешкі ас ішемін.
Dialogue: 0,0:45:43.04,0:45:46.74,Default,,0000,0000,0000,,Иә? Инквизитор бойдақ болуы керек...
Dialogue: 0,0:45:46.74,0:45:47.18,Default,,0000,0000,0000,,Сіз білмейсіз бе? Новак мырза
Dialogue: 0,0:45:46.74,0:45:47.18,Default,,0000,0000,0000,,Ол монах болмайды және қарапайым адам.
Dialogue: 0,0:45:48.68,0:45:54.68,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory