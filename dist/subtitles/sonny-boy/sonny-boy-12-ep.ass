Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:36.40,0:00:45.57,Default,,0,0,0,,Жаңбыр қашан жауа бастады?
Dialogue: 0,0:00:47.08,0:00:57.95,Default,,0,0,0,,Бір адам үйіне қайтып бара жатқанда құтқарылған қолшатырдың ішінде
Dialogue: 0,0:00:57.95,0:01:03.49,Default,,0,0,0,,Бұл қаншалықты жалғасады?
Dialogue: 0,0:01:04.64,0:01:06.50,Default,,0,0,0,,Әй, сен жазғы демалыста қайда бардың?
Dialogue: 0,0:01:07.04,0:01:09.54,Default,,0,0,0,,Мен барлық жерде толық емес жұмыс күнімен айналысатынмын.
Dialogue: 0,0:01:08.77,0:01:17.92,Default,,0,0,0,,Менің қолымда қалған жалғыз нәрсе - уақыт
Dialogue: 0,0:01:09.54,0:01:11.09,Default,,0,0,0,,Эй, бұл жақсы.
Dialogue: 0,0:01:11.09,0:01:12.63,Default,,0,0,0,,Сіз көп ақша жинадыңыз, солай ма?
Dialogue: 0,0:01:14.80,0:01:16.87,Default,,0,0,0,,Біз Гавайиге бардық.
Dialogue: 0,0:01:19.53,0:01:30.30,Default,,0,0,0,,Мүмкін болса, артқа айналдырыңыз, егер ол бірдей болса, жақсы
Dialogue: 0,0:01:23.24,0:01:25.39,Default,,0,0,0,,Хатено аралы... солай емес пе?
Dialogue: 0,0:01:25.39,0:01:27.89,Default,,0,0,0,,А? Сен не туралы айтып тұрсың? Сіз
Dialogue: 0,0:01:27.89,0:01:29.90,Default,,0,0,0,,Теңіз өте әдемі.
Dialogue: 0,0:01:29.90,0:01:32.40,Default,,0,0,0,,Мен суға сүңгіп жатқанда, балықтардың көп болғаны сонша, мені таң қалдырды.
Dialogue: 0,0:01:30.30,0:01:41.26,Default,,0,0,0,,Біз кездескенше маған ештеңе керек емес еді
Dialogue: 0,0:01:45.10,0:01:55.68,Default,,0,0,0,,Жаңбырда қатты жел бұлттарды басып кетті
Dialogue: 0,0:01:55.68,0:02:02.93,Default,,0,0,0,,Мен сені ойладым
Dialogue: 0,0:02:29.58,0:02:38.80,Default,,0,0,0,,Жүрегімдегі шуақты күндей ойық
Dialogue: 0,0:02:40.44,0:02:51.20,Default,,0,0,0,,Ересек бола алмадық, Екі адам бола алмадық.
Dialogue: 0,0:02:51.20,0:03:02.05,Default,,0,0,0,,Ештеңе айтпай-ақ менің басымда
Dialogue: 0,0:02:58.50,0:02:59.76,Default,,0,0,0,,Сәлем Мизухо...
Dialogue: 0,0:03:01.25,0:03:03.24,Default,,0,0,0,,Иә? ДДСҰ?
Dialogue: 0,0:03:06.05,0:03:16.62,Default,,0,0,0,,Күлкі және боялған көк карта
Dialogue: 0,0:03:06.59,0:03:07.48,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:08.34,0:03:09.52,Default,,0,0,0,,Бұл қате адам болды.
Dialogue: 0,0:03:16.62,0:03:34.74,Default,,0,0,0,,Қалдырған ізі Сөзбен жеткізе алсам
Dialogue: 0,0:03:31.49,0:03:33.69,Default,,0,0,0,,Жаяу жүргенде алға қара
Dialogue: 0,0:03:33.69,0:03:35.15,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:36.41,0:03:37.26,Default,,0,0,0,,Таку
Dialogue: 0,0:03:46.97,0:03:50.52,Default,,0,0,0,,Шынымен дрейф деген нәрсе болды ма?
Dialogue: 0,0:05:32.11,0:05:34.89,Default,,0,0,0,,Кеш болды, күттім.
Dialogue: 0,0:05:34.89,0:05:38.94,Default,,0,0,0,,Жоқ, баскетбол клубының жігіттері маған тағы да көмектесуімді өтінді.
Dialogue: 0,0:05:38.94,0:05:41.09,Default,,0,0,0,,Бұл балалар шынымен қолма-қол ақшаны пайдаланады.
Dialogue: 0,0:06:23.41,0:06:24.32,Default,,0,0,0,,Бірақ
Dialogue: 0,0:06:25.21,0:06:26.86,Default,,0,0,0,,Мен болғанына сенімдімін
Dialogue: 0,0:06:31.30,0:06:33.95,Default,,0,0,0,,Сол екі жыл дрейф
Dialogue: 0,0:06:59.87,0:07:01.81,Default,,0,0,0,,Бірдеңе шығып кетті, бірақ жақсысың ба?
Dialogue: 0,0:07:02.65,0:07:04.31,Default,,0,0,0,,Бұл жоспарға сәйкес.
Dialogue: 0,0:07:04.31,0:07:06.44,Default,,0,0,0,,Ол жарық жылдамдығынан асып кеткен сияқты.
Dialogue: 0,0:07:07.54,0:07:10.19,Default,,0,0,0,,Біз басқа өлшемнің кіреберісінде тұрмыз.
Dialogue: 0,0:07:12.63,0:07:14.32,Default,,0,0,0,,Қазір дайындалайық па?
Dialogue: 0,0:08:30.65,0:08:34.90,Default,,0,0,0,,Мұның салдары қандай болатынын шынымен түсінесіз бе?
Dialogue: 0,0:08:35.49,0:08:38.28,Default,,0,0,0,,Біз бастапқыда басқа адамдар едік.
Dialogue: 0,0:08:39.51,0:08:41.79,Default,,0,0,0,,Бірақ мен бұл жерде жоқ деп ойладым.
Dialogue: 0,0:08:42.76,0:08:44.56,Default,,0,0,0,,Балалар сендерге не болды?
Dialogue: 0,0:08:45.51,0:08:46.36,Default,,0,0,0,,Әлгі жігіт...
Dialogue: 0,0:08:48.18,0:08:50.88,Default,,0,0,0,,Білмесеңіз, жақсы.
Dialogue: 0,0:08:50.88,0:08:53.55,Default,,0,0,0,,Бізге берілген нәрсе жеткілікті емес пе?
Dialogue: 0,0:08:53.55,0:08:56.13,Default,,0,0,0,,Бұл дүние де, бастапқы дүние де өзгермейді.
Dialogue: 0,0:08:56.13,0:08:57.76,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:08:58.90,0:09:01.43,Default,,0,0,0,,Оны өзіміз алғымыз келеді.
Dialogue: 0,0:09:01.43,0:09:03.93,Default,,0,0,0,,Нозоми оның жүрегін аңдыды
Dialogue: 0,0:09:04.39,0:09:06.75,Default,,0,0,0,,Ол жауапкершілік те сенікі.
Dialogue: 0,0:09:25.76,0:09:27.06,Default,,0,0,0,,Барлығы кетті
Dialogue: 0,0:09:27.93,0:09:29.04,Default,,0,0,0,,Аки Сенсей де
Dialogue: 0,0:09:29.73,0:09:32.21,Default,,0,0,0,,Сынық Миоджоға түсті
Dialogue: 0,0:09:32.21,0:09:36.55,Default,,0,0,0,,Радждхани орманға айналады және жануарлармен бірге тұрады.
Dialogue: 0,0:09:37.44,0:09:40.34,Default,,0,0,0,,Хатено аралы батып кетті.
Dialogue: 0,0:09:40.34,0:09:41.18,Default,,0,0,0,,Соңында...
Dialogue: 0,0:09:42.28,0:09:44.12,Default,,0,0,0,,Маған ештеңе қалмады.
Dialogue: 0,0:09:55.08,0:09:55.80,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:09:55.92,0:10:00.61,Default,,0,0,0,,Біз бұған дейін тоқталғанбыз. Танысайық.
Dialogue: 0,0:09:58.21,0:09:58.72,Default,,0,0,0,,Иә
Dialogue: 0,0:10:02.17,0:10:03.20,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:10:04.09,0:10:09.52,Default,,0,0,0,,Махаббат белгісінен кейін мен сізді қосуға рұқсат етіңіз
Dialogue: 0,0:10:09.95,0:10:12.60,Default,,0,0,0,,Қуған сурет Қолды жабу
Dialogue: 0,0:10:13.96,0:10:16.75,Default,,0,0,0,,Мен көлеңкеге қарыздармын
Dialogue: 0,0:10:20.01,0:10:24.70,Default,,0,0,0,,Біз бұл туралы айттық, танысайық.
Dialogue: 0,0:10:28.01,0:10:29.62,Default,,0,0,0,,Махаббат белгісі
Dialogue: 0,0:10:29.99,0:10:32.54,Default,,0,0,0,,Қуған сурет Қолды жабу
Dialogue: 0,0:10:33.36,0:10:35.90,Default,,0,0,0,,Бұл жерден кетпеңіз
Dialogue: 0,0:10:34.06,0:10:36.65,Default,,0,0,0,,Мен көлеңкеге қарыздармын
Dialogue: 0,0:10:38.17,0:10:39.78,Default,,0,0,0,,Сіз шыға алмаймын деп айтқан жоқсыз.
Dialogue: 0,0:10:42.72,0:10:45.06,Default,,0,0,0,,Бұл жолы жақсы, кеттік.
Dialogue: 0,0:10:45.84,0:10:46.54,Default,,0,0,0,,Иә
Dialogue: 0,0:10:46.03,0:10:48.66,Default,,0,0,0,,Жабу суреті, қол қуу
Dialogue: 0,0:11:10.08,0:11:12.31,Default,,0,0,0,,Оны қалай қайтаруға болады?
Dialogue: 0,0:11:32.05,0:11:36.74,Default,,0,0,0,,Біз бұл туралы айттық, танысайық.
Dialogue: 0,0:11:38.04,0:11:40.57,Default,,0,0,0,,Қуған сурет Қолды жабу
Dialogue: 0,0:11:42.55,0:11:44.68,Default,,0,0,0,,Танысайық
Dialogue: 0,0:11:47.97,0:11:53.48,Default,,0,0,0,,Осыдан кейін мен сізді қосуға рұқсат етіңіз
Dialogue: 0,0:11:54.04,0:11:56.61,Default,,0,0,0,,Сурет қуу Қолды жабу
Dialogue: 0,0:11:58.06,0:12:00.64,Default,,0,0,0,,Мен көлеңкеге қарыздармын
Dialogue: 0,0:12:02.57,0:12:04.75,Default,,0,0,0,,Танысайық
Dialogue: 0,0:12:10.03,0:12:12.62,Default,,0,0,0,,Қуған сурет Қолды жауып
Dialogue: 0,0:12:14.11,0:12:16.63,Default,,0,0,0,,Мен көлеңкеге қарыздармын
Dialogue: 0,0:12:19.60,0:12:23.13,Default,,0,0,0,,Онда барсаң да Нозомидің тірі екенін білмейсің, солай ма?
Dialogue: 0,0:12:22.01,0:12:24.71,Default,,0,0,0,,Қуған сурет Қолды жабу
Dialogue: 0,0:12:23.86,0:12:25.76,Default,,0,0,0,,Сондықтан біз «компасты» қолданамыз.
Dialogue: 0,0:12:26.13,0:12:26.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:27.53,0:12:30.26,Default,,0,0,0,,Нәтижені ештеңе өзгертпейді.
Dialogue: 0,0:12:30.12,0:12:32.85,Default,,0,0,0,,Мен көлеңкеге қарыздармын
Dialogue: 0,0:12:30.60,0:12:33.27,Default,,0,0,0,,Өйткені бұл тек не болуы мүмкін дүние.
Dialogue: 0,0:12:34.91,0:12:37.90,Default,,0,0,0,,Мүмкіндіктер... Қайтадан айналдырыңыз
Dialogue: 0,0:12:38.52,0:12:43.56,Default,,0,0,0,,Белгілі бір жүректен алыс
Dialogue: 0,0:12:46.44,0:12:51.71,Default,,0,0,0,,Қалай? «Жауап беру және сұрау» ақымақтығы
Dialogue: 0,0:12:50.47,0:12:54.04,Default,,0,0,0,,Неліктен үйге баруды шештіңіз?
Dialogue: 0,0:12:54.03,0:12:56.11,Default,,0,0,0,,Қате болу
Dialogue: 0,0:12:56.11,0:12:59.10,Default,,0,0,0,,Біз бір жақтамыз...?
Dialogue: 0,0:13:00.48,0:13:01.67,Default,,0,0,0,,Бұл...
Dialogue: 0,0:13:01.94,0:13:06.85,Default,,0,0,0,,Біз бұл туралы айттық, танысайық.
Dialogue: 0,0:13:02.52,0:13:04.11,Default,,0,0,0,,Өйткені бұл Нозоми көрген жарық
Dialogue: 0,0:13:10.01,0:13:15.47,Default,,0,0,0,,Осыдан кейін мен сізді қосуға рұқсат етіңіз
Dialogue: 0,0:13:18.01,0:13:22.78,Default,,0,0,0,,Біз бұл туралы айттық, танысайық.
Dialogue: 0,0:13:24.24,0:13:26.30,Default,,0,0,0,,Мен көлеңкеге қарыздармын
Dialogue: 0,0:14:07.78,0:14:10.41,Default,,0,0,0,,Бұл жерді пәтерге айналдыратын сияқты.
Dialogue: 0,0:14:10.41,0:14:11.99,Default,,0,0,0,,Я~
Dialogue: 0,0:14:11.99,0:14:12.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:15.47,0:14:17.60,Default,,0,0,0,,Әжесінің мысығы жақсы ма?
Dialogue: 0,0:14:18.60,0:14:20.21,Default,,0,0,0,,Жолбарыс өлді дейді.
Dialogue: 0,0:14:21.68,0:14:23.71,Default,,0,0,0,,Иә...
Dialogue: 0,0:14:24.35,0:14:26.71,Default,,0,0,0,,Ол бала 13 жаста еді.
Dialogue: 0,0:14:27.38,0:14:29.47,Default,,0,0,0,,Мен жеткілікті ұзақ өмір сүрдім.
Dialogue: 0,0:14:29.88,0:14:31.72,Default,,0,0,0,,Бірақ бұл қымбат.
Dialogue: 0,0:14:31.72,0:14:35.47,Default,,0,0,0,,Бір жануардың құны 400 000 иен болды. Алып алу қызметі
Dialogue: 0,0:14:35.47,0:14:37.89,Default,,0,0,0,,Үш жануар үшін 1,2 млн.
Dialogue: 0,0:14:37.89,0:14:40.84,Default,,0,0,0,,Бірақ менің ойымша, бұл әлдеқайда берік ...
Dialogue: 0,0:14:39.12,0:14:41.35,Default,,0,0,0,,Мұның бәрі жойылды.
Dialogue: 0,0:15:02.18,0:15:04.00,Default,,0,0,0,,Сәлем Мизухо
Dialogue: 0,0:15:04.89,0:15:06.75,Default,,0,0,0,,Иә? ДДСҰ?
Dialogue: 0,0:15:10.27,0:15:10.91,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:11.78,0:15:12.99,Default,,0,0,0,,Бұл қате адам болды.
Dialogue: 0,0:16:42.07,0:16:43.50,Default,,0,0,0,,Сәлем Нагара
Dialogue: 0,0:16:46.37,0:16:48.48,Default,,0,0,0,,«Раджданидің тотықұсы күледі»
Dialogue: 0,0:16:56.51,0:16:58.24,Default,,0,0,0,,есіме түсті
Dialogue: 0,0:16:58.24,0:16:58.77,Default,,0,0,0,,Иә
Dialogue: 0,0:17:06.18,0:17:07.23,Default,,0,0,0,,Толық емес жұмыс күнімен жұмыс істеу қиын ба?
Dialogue: 0,0:17:08.93,0:17:10.96,Default,,0,0,0,,Өте орынды
Dialogue: 0,0:17:10.96,0:17:13.05,Default,,0,0,0,,Мүмкін мен де толық емес жұмысқа орналасуым керек шығар.
Dialogue: 0,0:17:13.05,0:17:16.34,Default,,0,0,0,,Мен пәтер жалдап, мысық асырап алуым керек пе?
Dialogue: 0,0:17:16.34,0:17:19.39,Default,,0,0,0,,Егер сіз мұны істеуден аулақ бола алсаңыз, оны жасамағаныңыз жақсы.
Dialogue: 0,0:17:19.39,0:17:22.35,Default,,0,0,0,,Басқа да көптеген нәрселерді орындау керек.
Dialogue: 0,0:17:25.03,0:17:27.50,Default,,0,0,0,,Мен ештеңе өзгермейтінін білдім.
Dialogue: 0,0:17:28.65,0:17:31.36,Default,,0,0,0,,Мен мұны өз басымнан білемін деп ойладым.
Dialogue: 0,0:17:33.25,0:17:36.11,Default,,0,0,0,,Бұл Нагара таңдаған болашақ, солай ма?
Dialogue: 0,0:17:40.13,0:17:43.49,Default,,0,0,0,,«Біз бәрібір әлемді өзгерте алмаймыз»
Dialogue: 0,0:17:43.49,0:17:45.50,Default,,0,0,0,,«Ендеше, бәрі жақсы».
Dialogue: 0,0:17:45.50,0:17:48.23,Default,,0,0,0,,Маған бұрын айтқан сөздеріңіз есіңізде ме?
Dialogue: 0,0:17:50.98,0:17:52.38,Default,,0,0,0,,Сіз әлі де солай ойлайсыз ба?
Dialogue: 0,0:17:54.77,0:17:55.28,Default,,0,0,0,,Иә
Dialogue: 0,0:17:56.65,0:17:58.88,Default,,0,0,0,,Өйткені, әлемді өзгерту мүмкін емес
Dialogue: 0,0:18:00.36,0:18:03.75,Default,,0,0,0,,Бірақ бұл... мен таңдаған дүние.
Dialogue: 0,0:18:09.45,0:18:12.19,Default,,0,0,0,,Егер мен қазір осында тұрып, артыма қарасам,
Dialogue: 0,0:18:12.19,0:18:15.03,Default,,0,0,0,,Тек ықтималдық элементі бар
Dialogue: 0,0:18:15.03,0:18:18.78,Default,,0,0,0,,Біраз уақыттан кейін ажыратылмайтын болады.
Dialogue: 0,0:18:20.46,0:18:23.03,Default,,0,0,0,,Бір күні мен де ұмытармын бұл сезімді
Dialogue: 0,0:18:23.03,0:18:25.29,Default,,0,0,0,,Сіз бір нәрсені қайталай бересіз.
Dialogue: 0,0:18:27.01,0:18:30.44,Default,,0,0,0,,Нозоми де... Мен білетін Нозоми екенін білмеймін.
Dialogue: 0,0:18:31.27,0:18:34.24,Default,,0,0,0,,Бірақ бұл... оның көрген болашағы
Dialogue: 0,0:18:35.15,0:18:36.28,Default,,0,0,0,,Сіз Нозомимен кездестіңіз бе?
Dialogue: 0,0:18:37.19,0:18:39.41,Default,,0,0,0,,Жоқ, мен оны жаңа ғана көрдім.
Dialogue: 0,0:18:40.23,0:18:42.93,Default,,0,0,0,,Дрифтпен жүргенім есімде жоқ
Dialogue: 0,0:18:42.93,0:18:44.18,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:18:44.18,0:18:45.83,Default,,0,0,0,,Бұл басқа адам ма?
Dialogue: 0,0:18:48.70,0:18:49.81,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:18:51.16,0:18:52.44,Default,,0,0,0,,Нагара толық емес жұмыс күні, солай ма?
Dialogue: 0,0:18:53.16,0:18:54.42,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:19:06.76,0:19:08.81,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:19:10.26,0:19:14.19,Default,,0,0,0,,Егер сол аралда сіздің кім болғаныңыз туралы әлі де болса
Dialogue: 0,0:19:15.06,0:19:15.94,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:19:20.27,0:19:20.77,Default,,0,0,0,,Иә
Dialogue: 0,0:21:07.05,0:21:08.57,Default,,0,0,0,,Сізді де қызықтырды ма?
Dialogue: 0,0:21:10.30,0:21:12.74,Default,,0,0,0,,Түнде жылап тұрды.
Dialogue: 0,0:21:12.74,0:21:16.94,Default,,0,0,0,,Станция жұмысшысының ағасы ата-ана құсты қарға өлтірген болуы мүмкін деді.
Dialogue: 0,0:21:17.60,0:21:19.58,Default,,0,0,0,,Қалған балалардың бәрі өлді.
Dialogue: 0,0:21:20.50,0:21:22.03,Default,,0,0,0,,Осы бала ғана тірі болған.
Dialogue: 0,0:21:24.19,0:21:25.59,Default,,0,0,0,,Маған қамқор боласың ба?
Dialogue: 0,0:21:26.27,0:21:26.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:28.03,0:21:30.87,Default,,0,0,0,,Жоқ, үй жануарларына рұқсат бермейміз...
Dialogue: 0,0:21:33.66,0:21:35.88,Default,,0,0,0,,Сіз сол орта мектепте оқыдыңыз, солай ма?
Dialogue: 0,0:21:38.60,0:21:42.94,Default,,0,0,0,,Иә, сіз орта мектептің үшінші курсының екінші семестрінде мектепке ауыстыңыз, солай ма?
Dialogue: 0,0:21:42.94,0:21:43.84,Default,,0,0,0,,Сирек
Dialogue: 0,0:21:44.67,0:21:48.32,Default,,0,0,0,,Ата-ана құс үйге келмеген екен.
Dialogue: 0,0:21:48.71,0:21:50.47,Default,,0,0,0,,Осы бала ғана тірі еді.
Dialogue: 0,0:21:51.76,0:21:53.08,Default,,0,0,0,,Біз не істеуіміз керек? Бұл жігіт
Dialogue: 0,0:21:54.26,0:21:57.21,Default,,0,0,0,,Сен ұшқанша мен саған қамқорлық жасайын ба?
Dialogue: 0,0:22:19.04,0:22:20.71,Default,,0,0,0,,Өмір әлі алда.
Dialogue: 0,0:22:21.66,0:22:25.23,Default,,0,0,0,,Алдағы жол сәл ұзағырақ.
Dialogue: 0,0:22:25.93,0:22:33.55,Default,,0,0,0,,Енді көзіміз түйіскен сәттен бастап
Dialogue: 0,0:22:33.55,0:22:39.65,Default,,0,0,0,,барлық рұқсат етілген жүктеп алынған
Dialogue: 0,0:22:40.34,0:22:45.10,Default,,0,0,0,,«Сіз осында қала аласыз.»
Dialogue: 0,0:22:45.10,0:22:52.44,Default,,0,0,0,,Ұзын дәліз, Құдай ЖОҚ
Dialogue: 0,0:22:53.01,0:22:58.68,Default,,0,0,0,,Жеті түсті қолшатыр, естілген сөздер
Dialogue: 0,0:22:59.21,0:23:03.25,Default,,0,0,0,,«Сіз осында қала аласыз.»
Dialogue: 0,0:23:03.25,0:23:08.30,Default,,0,0,0,,Мен сені қатты жақсы көремін, жек көремін
Dialogue: 0,0:23:08.30,0:23:15.25,Default,,0,0,0,,Махаббаттың мәнін білмей
Dialogue: 0,0:23:15.25,0:23:21.70,Default,,0,0,0,,Батқан күнге шомылған дүниенің шетінде
Dialogue: 0,0:23:21.70,0:23:28.12,Default,,0,0,0,,Қол ұстасып
Dialogue: 0,0:23:30.54,0:23:35.83,Default,,0,0,0,,Егер сіз 2000 жарық жылы пойызда қайғыны жеңсеңіз
Dialogue: 0,0:23:35.83,0:23:42.20,Default,,0,0,0,,Бала қызбен танысады
Dialogue: 0,0:23:42.20,0:23:47.55,Default,,0,0,0,,Жақсысы мен жаманы бар әдемі жалғызбастылар
Dialogue: 0,0:23:47.55,0:23:54.10,Default,,0,0,0,,Бала қызбен танысады
Dialogue: 0,0:23:54.10,0:23:59.40,Default,,0,0,0,,Бұрмаланған бұрмалау естіледі, аспан әлдеқашан алыс.
Dialogue: 0,0:23:59.40,0:24:05.45,Default,,0,0,0,,Бала қызбен танысады
Dialogue: 0,0:24:05.45,0:24:14.67,Default,,0,0,0,,ҚОШТАСТЫРМА
Dialogue: 0,0:24:23.34,0:24:26.92,Default,,0,0,0,,ҚОШТАСТЫРМА
Dialogue: 0,0:24:28.42,0:24:33.42,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
