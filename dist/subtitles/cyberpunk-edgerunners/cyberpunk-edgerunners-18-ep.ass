Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:21:30.43,0:21:32.01,Staff,,0,0,0,,： ：Dysonsphere ：astrayveller ：MIR
Dialogue: 1,0:00:05.25,0:00:06.37,Dial-JP,,0,0,0,,Директор Эванс
Dialogue: 1,0:00:06.74,0:00:09.62,Dial-JP,,0,0,0,,Не? Неге үндемей кірдің?
Dialogue: 1,0:00:09.89,0:00:13.15,Dial-JP,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 1,0:00:13.66,0:00:16.20,Dial-JP,,0,0,0,,Ал, сенің ісің не?
Dialogue: 1,0:00:16.97,0:00:17.63,Dial-JP,,0,0,0,,Бұл
Dialogue: 1,0:00:18.27,0:00:20.79,Dial-JP,,0,0,0,,Алдымен кешірім сұраймын ба?
Dialogue: 1,0:00:22.95,0:00:26.10,Dial-JP,,0,0,0,,Кешіріңіз, менде бүгін жоспарлар бар.
Dialogue: 1,0:00:26.42,0:00:30.34,Dial-JP,,0,0,0,,Мен сіздің кестеңізді басқаруым керек пе?
Dialogue: 1,0:00:30.34,0:00:32.75,Dial-JP,,0,0,0,,Жоқ, кешіріңіз.
Dialogue: 1,0:00:33.11,0:00:36.93,Dial-JP,,0,0,0,,Бірақ бүгін мен ұлымның академияға кіруін тойлап жатырмын.
Dialogue: 1,0:00:36.93,0:00:39.07,Dial-JP,,0,0,0,,Құттықтаймыз.
Dialogue: 1,0:00:39.38,0:00:41.46,Dial-JP,,0,0,0,,Бұл Арасаканың болашақ жұлдызы.
Dialogue: 1,0:00:41.93,0:00:45.55,Dial-JP,,0,0,0,,Содан кейін біреуге UG2 үлгісін әкелсін.
Dialogue: 1,0:00:45.80,0:00:48.62,Dial-JP,,0,0,0,,Басқа қызметкерлер үйге уақытында оралды.
Dialogue: 1,0:00:51.00,0:00:52.85,Dial-JP,,0,0,0,,Мен үлгіні әкелемін.
Dialogue: 1,0:00:53.58,0:00:54.60,Dial-JP,,0,0,0,,Сонымен
Dialogue: 1,0:00:54.60,0:00:56.90,Dial-JP,,0,0,0,,Бұл жақсы ұсыныс.
Dialogue: 1,0:00:57.26,0:00:59.69,Dial-JP,,0,0,0,,Тез әкеліп, үйге тез қайт.
Dialogue: 1,0:01:11.74,0:01:13.05,Dial-JP,,0,0,0,,Директор Эванс
Dialogue: 1,0:01:22.87,0:01:23.65,Dial-JP,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 1,0:01:32.45,0:01:34.26,Dial-JP,,0,0,0,,Бұрын бұл не туралы болды?
Dialogue: 1,0:01:34.97,0:01:36.69,Dial-JP,,0,0,0,,Бір сәтке есту қиын болды.
Dialogue: 1,0:01:37.10,0:01:37.92,Dial-JP,,0,0,0,,Кептелу?
Dialogue: 1,0:01:38.28,0:01:40.24,Dial-JP,,0,0,0,,Дегенмен байланыс үзілген жоқ.
Dialogue: 1,0:01:41.20,0:01:41.96,Dial-JP,,0,0,0,,Мен көремін.
Dialogue: 1,0:01:44.79,0:01:46.92,Dial-JP,,0,0,0,,Бұл қызықсыз жұмыс болды.
Dialogue: 1,0:03:20.87,0:03:23.10,Dial-JP,,0,0,0,,Нысандағы қастандық?
Dialogue: 1,0:03:23.56,0:03:25.48,Dial-JP,,0,0,0,,Арасака да сынға ұшырады.
Dialogue: 1,0:03:25.88,0:03:29.31,Dial-JP,,0,0,0,,MILITECH қарсы шаралар зертханасы нысанаға алынған сияқты.
Dialogue: 1,0:03:29.90,0:03:31.55,Dial-JP,,0,0,0,,Джейми мен Маркусты өлтірді
Dialogue: 1,0:03:31.55,0:03:32.87,Dial-JP,,0,0,0,,Жүгірушімен қарым-қатынас
Dialogue: 1,0:03:33.19,0:03:35.55,Dial-JP,,0,0,0,,Директор Эванс атып өлтірілді.
Dialogue: 1,0:03:35.55,0:03:40.14,Dial-JP,,0,0,0,,Іздерді өшіру жолы да аздап өрескел болды, сондықтан жүгірушіден басқа сызықта тұрған сияқты.
Dialogue: 1,0:03:40.47,0:03:42.53,Dial-JP,,0,0,0,,Жүгірушіні анықтау - басты міндет
Dialogue: 1,0:03:42.92,0:03:44.55,Dial-JP,,0,0,0,,Бұл жігіт тым қауіпті.
Dialogue: 1,0:03:44.91,0:03:47.86,Dial-JP,,0,0,0,,Алайда оның себебі мен мақсаты белгісіз.
Dialogue: 1,0:03:47.86,0:03:49.91,Dial-JP,,0,0,0,,Құйрықты ұстай алмайтын сияқтымын.
Dialogue: 1,0:03:49.91,0:03:52.63,Dial-JP,,0,0,0,,Жабайы жүйріктің деңгейінде емес.
Dialogue: 1,0:03:52.63,0:03:55.23,Dial-JP,,0,0,0,,Біз, Қарсы барлау департаменті, мұны істеуге қалай батылы барамыз?
Dialogue: 1,0:03:55.76,0:03:58.77,Dial-JP,,0,0,0,,Жүгірушінің ізімен жүру үшін айналма жол қажет пе?
Dialogue: 1,0:03:59.09,0:04:01.79,Dial-JP,,0,0,0,,Сіз Эвансты іздеп жүрсіз бе?
Dialogue: 1,0:04:02.19,0:04:03.53,Dial-JP,,0,0,0,,Жеке істер
Dialogue: 1,0:04:03.53,0:04:05.80,Dial-JP,,0,0,0,,Кейде күтпеген тұғырға айналады.
Dialogue: 1,0:04:06.82,0:04:10.04,Dial-JP,,0,0,0,,Мақсатыңызды өзгерту Орналастырылған түзеткішті іздеңіз
Dialogue: 1,0:04:10.59,0:04:13.92,Dial-JP,,0,0,0,,MILITECH-пен терең байланысы бар адамдардың тізімін қысқарту қиын емес.
Dialogue: 1,0:04:14.34,0:04:18.15,Dial-JP,,0,0,0,,Бірақ егер Fixer және runner арасында байланыс болса
Dialogue: 1,0:04:18.51,0:04:23.85,Dial-JP,,0,0,0,,Қарастырылып отырған өнімге қатысты ақпаратты MILITECH компаниясына сату мүмкіндігі бар ма?
Dialogue: 1,0:04:24.30,0:04:27.28,Dial-JP,,0,0,0,,Егер сен қулық пен өзін-өзі сақтауда шебер болмасаң.
Dialogue: 1,0:04:27.28,0:04:29.27,Dial-JP,,0,0,0,,Fixer түнгі қалада өзін атай алмайды
Dialogue: 1,0:04:29.72,0:04:33.55,Dial-JP,,0,0,0,,Әйтсе де, шағын компанияның олжасын алатын гиена.
Dialogue: 1,0:04:34.38,0:04:36.38,Dial-JP,,0,0,0,,Бұл қалада корпорациялар басым
Dialogue: 1,0:04:36.38,0:04:39.71,Dial-JP,,0,0,0,,Мен сізге тек сіздің итіңіз ғана аман қала алатынын көрсетемін.
Dialogue: 1,0:04:40.26,0:04:41.95,Dial-JP,,0,0,0,,Кез келген жолмен
Dialogue: 1,0:04:43.70,0:04:46.56,Dial-JP,,0,0,0,,Түнгі қала әдісімен жасайық.
Dialogue: 1,0:04:56.50,0:04:57.03,Dial-JP,,0,0,0,,Эй
Dialogue: 1,0:05:04.11,0:05:05.74,Dial-JP,,0,0,0,,Бекіткішті өлтірмеңіз
Dialogue: 1,0:05:05.74,0:05:07.05,Dial-JP,,0,0,0,,Сіз басқаларды өлтіре аласыз.
Dialogue: 1,0:05:09.08,0:05:10.27,Dial-JP,,0,0,0,,Бұл граната.
Dialogue: 1,0:05:10.27,0:05:11.91,Dial-JP,,0,0,0,,Оны кері лақтырыңыз
Dialogue: 1,0:05:30.35,0:05:31.77,Dial-JP,,0,0,0,,Ол өліп қала жаздады.
Dialogue: 1,0:05:32.11,0:05:34.88,Dial-JP,,0,0,0,,Бұл тек Арасака ақшасы емес.
Dialogue: 1,0:05:34.88,0:05:37.49,Dial-JP,,0,0,0,,Ақымақ, мені тағы кім көздеп отыр?
Dialogue: 1,0:05:37.81,0:05:41.00,Dial-JP,,0,0,0,,Бұл қосымша қаражат беріледі дегенді білдірмейді.
Dialogue: 1,0:05:41.00,0:05:43.52,Dial-JP,,0,0,0,,Айыптаудан иммунитет мәселесі де қиын.
Dialogue: 1,0:05:43.52,0:05:44.66,Dial-JP,,0,0,0,,Сіз қалжыңдап тұрсыз ба?
Dialogue: 1,0:05:44.66,0:05:48.26,Dial-JP,,0,0,0,,Танаканың ісімен айналысу қанша тұрады деп ойлайсыз?
Dialogue: 1,0:05:48.67,0:05:50.45,Dial-JP,,0,0,0,,Және ешқандай нәтиже жоқ.
Dialogue: 1,0:05:50.86,0:05:53.49,Dial-JP,,0,0,0,,Қосымша инвестиция қажет болса
Dialogue: 1,0:05:53.49,0:05:55.57,Dial-JP,,0,0,0,,Біріншіден, мен нәтижелерді көруім керек.
Dialogue: 1,0:05:56.22,0:05:59.25,Dial-JP,,0,0,0,,Осы уақытқа дейін атқарған жұмыстарыңызға көңіліңіз толмай отыр дейсіз бе?
Dialogue: 1,0:05:59.25,0:06:01.57,Dial-JP,,0,0,0,,Мен онша көп айтпаймын.
Dialogue: 1,0:06:01.57,0:06:04.45,Dial-JP,,0,0,0,,Менің ойымша, бұл тым көп уақытты алады.
Dialogue: 1,0:06:04.94,0:06:07.95,Dial-JP,,0,0,0,,Өйткені Арасаканың күзетшісі ерекше.
Dialogue: 1,0:06:08.25,0:06:13.04,Dial-JP,,0,0,0,,Бұл кибер қаңқаның Арасака үшін маңызды екендігінің дәлелі.
Dialogue: 1,0:06:13.04,0:06:14.16,Dial-JP,,0,0,0,,Түсінбейсіз бе?
Dialogue: 1,0:06:14.16,0:06:17.49,Dial-JP,,0,0,0,,Мен соған сонша ақша жұмсағанымды білемін.
Dialogue: 1,0:06:17.49,0:06:19.00,Dial-JP,,0,0,0,,Маған нәтижелерді беріңіз.
Dialogue: 1,0:06:19.52,0:06:21.59,Dial-JP,,0,0,0,,Нәтижесіз соманы көбейте алмайсыз.
Dialogue: 1,0:06:22.02,0:06:23.06,Dial-JP,,0,0,0,,Әзірге осымен бітті.
Dialogue: 1,0:06:28.54,0:06:30.37,Dial-JP,,0,0,0,,Соңғы жас жігіт
Dialogue: 1,0:06:40.67,0:06:43.50,Dial-JP,,0,0,0,,Бекіткіш маған хабарласты.
Dialogue: 1,0:06:44.08,0:06:45.38,Dial-JP,,0,0,0,,Мақсатқа тура келдіңіз.
Dialogue: 1,0:06:46.01,0:06:47.63,Dial-JP,,0,0,0,,Бұл жеңіл гиена.
Dialogue: 1,0:06:56.47,0:06:57.30,Dial-JP,,0,0,0,,Дәуіт
Dialogue: 1,0:07:00.05,0:07:02.46,Dial-JP,,0,0,0,,Жаңадан шыққан батыр Mt. Lady –
Dialogue: 1,0:07:02.82,0:07:03.88,Dial-JP,,0,0,0,,Мен сені ояттым ба?
Dialogue: 1,0:07:04.38,0:07:05.43,Dial-JP,,0,0,0,,Мен ұйықтай алмаймын
Dialogue: 1,0:07:05.82,0:07:07.51,Dial-JP,,0,0,0,,Әйтеуір көзім қарайып кетті
Dialogue: 1,0:07:08.07,0:07:09.20,Dial-JP,,0,0,0,,Иә
Dialogue: 1,0:07:09.20,0:07:09.98,Dial-JP,,0,0,0,,Мен оны өшіремін.
Dialogue: 1,0:07:10.48,0:07:11.78,Dial-JP,,0,0,0,,Сіз қарап отырсыз ба?
Dialogue: 1,0:07:11.78,0:07:13.37,Dial-JP,,0,0,0,,Мен оны жай ғана киіп жүрмін...
Dialogue: 1,0:07:15.59,0:07:16.46,Dial-JP,,0,0,0,,Ай
Dialogue: 1,0:07:17.18,0:07:20.66,Dial-JP,,0,0,0,,Менің ойымша, 250 000 иенге бару таңқаларлық арзан емес.
Dialogue: 1,0:07:20.66,0:07:22.49,Dial-JP,,0,0,0,,Барсаң
Dialogue: 1,0:07:22.49,0:07:24.37,Dial-JP,,0,0,0,,Бұл рас.
Dialogue: 1,0:07:25.74,0:07:26.73,Dial-JP,,0,0,0,,Есте сақта
Dialogue: 1,0:07:28.11,0:07:29.91,Dial-JP,,0,0,0,,Жоқ, мен қазір ұйықтаймын.
Dialogue: 1,0:07:30.99,0:07:32.76,Dial-JP,,0,0,0,,​​Иә, қайырлы түн.
Dialogue: 1,0:07:40.68,0:07:45.06,Dial-JP,,0,0,0,,Әлемдегі ең үлкен жапондық компанияның қарсы барлау бөлімі осындай жерде жасырын жинала ма?
Dialogue: 1,0:07:45.50,0:07:48.49,Dial-JP,,0,0,0,,Бұл сіздің стиліңізге сәйкес келеді деп ойлаймын.
Dialogue: 1,0:07:48.85,0:07:51.16,Dial-JP,,0,0,0,,Жарайды, жауабын тыңдайық.
Dialogue: 1,0:07:51.57,0:07:54.14,Dial-JP,,0,0,0,,Кибер қаңқа да менің Арасакам
Dialogue: 1,0:07:54.14,0:07:56.09,Dial-JP,,0,0,0,,Бұл нәзік өнім.
Dialogue: 1,0:07:56.45,0:07:59.40,Dial-JP,,0,0,0,,Танакада тым көп ақпарат шоғырланған
Dialogue: 1,0:07:59.40,0:08:00.95,Dial-JP,,0,0,0,,Бұл да кері әсер етті.
Dialogue: 1,0:08:00.95,0:08:03.09,Dial-JP,,0,0,0,,MILITECH қаншалықты біледі?
Dialogue: 1,0:08:03.52,0:08:05.52,Dial-JP,,0,0,0,,Ақпарат – өмірлік арқау
Dialogue: 1,0:08:05.52,0:08:07.82,Dial-JP,,0,0,0,,Мен алдымен кепілдік алғым келеді.
Dialogue: 1,0:08:08.23,0:08:12.16,Dial-JP,,0,0,0,,Біз сіздей Fixer жоқ екенін түсінеміз.
Dialogue: 1,0:08:12.47,0:08:16.54,Dial-JP,,0,0,0,,MILITECH бас тартқан шарттарыңыз енді жарамсыз.
Dialogue: 1,0:08:16.94,0:08:19.58,Dial-JP,,0,0,0,,Бұл Танаканың ұрланғаны үшін кешірімге де қатысты.
Dialogue: 1,0:08:19.92,0:08:21.01,Dial-JP,,0,0,0,,Wonderful
Dialogue: 1,0:08:21.56,0:08:24.61,Dial-JP,,0,0,0,,Бірақ бұл жерде де шарттар бар.
Dialogue: 1,0:08:25.53,0:08:26.32,Dial-JP,,0,0,0,,Тыңдап көрейік
Dialogue: 1,0:08:26.64,0:08:29.63,Dial-JP,,0,0,0,,Кибер қаңқаның бар екенін білетін кез келген адам
Dialogue: 1,0:08:29.63,0:08:31.65,Dial-JP,,0,0,0,,Барлығынан құтылу
Dialogue: 1,0:08:31.90,0:08:33.06,Dial-JP,,0,0,0,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 1,0:08:33.63,0:08:35.15,Dial-JP,,0,0,0,,Мен сізден тағы бір нәрсе сұрағым келеді.
Dialogue: 1,0:08:35.49,0:08:36.16,Dial-JP,,0,0,0,,Не?
Dialogue: 1,0:08:36.55,0:08:38.13,Dial-JP,,0,0,0,,Танака өлгеннен кейін
Dialogue: 1,0:08:38.13,0:08:43.57,Dial-JP,,0,0,0,,Бүлінген кибер қаңқаларға қатысты деректерді қалпына келтіруге жол бермейтін жүгіруші бар.
Dialogue: 1,0:08:43.57,0:08:46.01,Dial-JP,,0,0,0,,Бұл туралы ақпарат бар ма?
Dialogue: 1,0:08:46.77,0:08:48.12,Dial-JP,,0,0,0,,Білмеймін.
Dialogue: 1,0:08:48.12,0:08:49.12,Dial-JP,,0,0,0,,Мен көремін.
Dialogue: 1,0:08:49.12,0:08:51.97,Dial-JP,,0,0,0,,Бұған қатысты көптеген жұмбақтар бар.
Dialogue: 1,0:08:51.97,0:08:54.86,Dial-JP,,0,0,0,,Бұл бірінші кезекте MILITECH тапсырысы болса да
Dialogue: 1,0:08:54.86,0:08:57.25,Dial-JP,,0,0,0,,Мақсаты не екенін білмеймін.
Dialogue: 1,0:08:57.96,0:09:01.56,Dial-JP,,0,0,0,,Танака кибер қаңқаға қатысы бар деп есептеледі.
Dialogue: 1,0:09:01.56,0:09:04.35,Dial-JP,,0,0,0,,Менен басқа ешкім ойламайды
Dialogue: 1,0:09:04.35,0:09:05.34,Dial-JP,,0,0,0,,Ішінде
Dialogue: 1,0:09:05.34,0:09:06.36,Dial-JP,,0,0,0,,Мүмкін емес.
Dialogue: 1,0:09:06.72,0:09:10.43,Dial-JP,,0,0,0,,Ішінен із қалдырмай қозғалу мүмкін емес.
Dialogue: 1,0:09:10.77,0:09:16.31,Dial-JP,,0,0,0,,Білікті жүгіруші киберпанк әлемінде жасырынып жүр деп ойлау табиғирақ.
Dialogue: 1,0:09:16.68,0:09:19.02,Dial-JP,,0,0,0,,Бұл Fixer ретінде сіздің өрісіңіз болуы мүмкін.
Dialogue: 1,0:09:20.03,0:09:21.87,Dial-JP,,0,0,0,,Бұл қосымша сұрау.
Dialogue: 1,0:09:22.42,0:09:25.36,Dial-JP,,0,0,0,,1 миллион иен, егер мені тірідей тапсырсаң.
Dialogue: 1,0:09:25.36,0:09:27.35,Dial-JP,,0,0,0,,Тіпті мәйіттің құны 500 000 иен болады.
Dialogue: 1,0:09:28.85,0:09:30.07,Dial-JP,,0,0,0,,Оны қабылдап алайық
Dialogue: 1,0:09:31.42,0:09:34.39,Dial-JP,,0,0,0,,Маған хабарласатындарыңыз сирек.
Dialogue: 1,0:09:34.75,0:09:35.79,Dial-JP,,0,0,0,,Көптен бері көрмеген
Dialogue: 1,0:09:36.27,0:09:37.22,Dial-JP,,0,0,0,,Не болды?
Dialogue: 1,0:09:37.77,0:09:40.59,Dial-JP,,0,0,0,,Иә, мен сізден бір нәрсе сұрағым келеді.
Dialogue: 1,0:09:41.04,0:09:42.26,Dial-JP,,0,0,0,,Бірдеңе
Dialogue: 1,0:09:42.58,0:09:43.99,Dial-JP,,0,0,0,,Бұл үлкен мәселе емес.
Dialogue: 1,0:09:44.41,0:09:47.35,Dial-JP,,0,0,0,,Дэвид жақсы жүр ме деп ойлаймын.
Dialogue: 1,0:09:47.76,0:09:49.82,Dial-JP,,0,0,0,,Менің ойымша, сіз жақсы жұмыс істеп жатырсыз.
Dialogue: 1,0:09:50.32,0:09:53.57,Dial-JP,,0,0,0,,Алғашында мен сені қолдаймын деген ниетпен топ құрдым.
Dialogue: 1,0:09:53.57,0:09:55.87,Dial-JP,,0,0,0,,Мен қазір өзімді кәдімгі көшбасшы сияқты сезінемін.
Dialogue: 1,0:09:56.60,0:09:59.24,Dial-JP,,0,0,0,,Маған Фарадейден жұмыс туралы өтініштер түсе бастады.
Dialogue: 1,0:09:59.66,0:10:00.42,Dial-JP,,0,0,0,,ұқсайды
Dialogue: 1,0:10:00.95,0:10:04.27,Dial-JP,,0,0,0,,Егер Мэн Дэвидті қазір көрсе, ол таң қалар еді.
Dialogue: 1,0:10:07.03,0:10:08.88,Dial-JP,,0,0,0,,Сізді мазалайтын нәрсе бар ма?
Dialogue: 1,0:10:09.34,0:10:11.23,Dial-JP,,0,0,0,,Олай емес.
Dialogue: 1,0:10:11.88,0:10:13.28,Dial-JP,,0,0,0,,Егер дұрыс істеп жатсаңыз
Dialogue: 1,0:10:14.12,0:10:15.95,Dial-JP,,0,0,0,,Бірлесіп жұмыс жасасақ
Dialogue: 1,0:10:17.23,0:10:20.78,Dial-JP,,0,0,0,,Менің ойымша, Дэвид сізге ұнағанша күтеді.
Dialogue: 1,0:10:20.78,0:10:23.23,Dial-JP,,0,0,0,,Тезірек оралуыңызға шын жүректен үміттенемін.
Dialogue: 1,0:10:23.96,0:10:24.98,Dial-JP,,0,0,0,,Мен білемін
Dialogue: 1,0:10:25.47,0:10:26.45,Dial-JP,,0,0,0,,Бұл әлі мүмкін емес.
Dialogue: 1,0:10:26.84,0:10:28.69,Dial-JP,,0,0,0,,Әлі жоқ.
Dialogue: 1,0:10:29.22,0:10:31.81,Dial-JP,,0,0,0,,Бірақ бұл жақында бітетін сияқты
Dialogue: 1,0:10:33.98,0:10:35.76,Dial-JP,,0,0,0,,Жарайды, мен ұрмаймын.
Dialogue: 1,0:10:36.41,0:10:38.90,Dial-JP,,0,0,0,,Түнгі қалада ешкімге сенбе
Dialogue: 1,0:10:38.90,0:10:41.42,Dial-JP,,0,0,0,,Сеніп, алданып қалу одан да жаман.
Dialogue: 1,0:10:41.42,0:10:42.72,Dial-JP,,0,0,0,,Мен саған мұны баяғыда үйреткенмін.
Dialogue: 1,0:10:44.23,0:10:45.15,Dial-JP,,0,0,0,,Сіз мұны айттыңыз.
Dialogue: 1,0:10:45.81,0:10:48.79,Dial-JP,,0,0,0,,Жарайды, мен сенің жақында оралуыңды күтемін.
Dialogue: 1,0:10:49.40,0:10:51.73,Dial-JP,,0,0,0,,Дэвид, сен мені мүлде тыңдамайсың.
Dialogue: 1,0:10:52.08,0:10:53.26,Dial-JP,,0,0,0,,Бұл не?
Dialogue: 1,0:10:54.40,0:10:55.43,Dial-JP,,0,0,0,,Тағы кездескенше
Dialogue: 1,0:11:00.46,0:11:01.64,Dial-JP,,0,0,0,,Екі күн бұрын банк тонаған жігіт енді автобусты ұрлап кетті.
Dialogue: 1,0:11:09.76,0:11:12.14,Dial-JP,,0,0,0,,Бұл тартылған ет.
Dialogue: 1,0:11:13.08,0:11:13.95,Dial-JP,,0,0,0,,Оқ-дәрі жоқ
Dialogue: 1,0:11:14.17,0:11:14.58,Dial-JP,,0,0,0,,Түсінікті
Dialogue: 1,0:11:25.56,0:11:26.52,Dial-JP,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 1,0:11:34.98,0:11:36.15,Dial-JP,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 1,0:11:37.14,0:11:38.97,Dial-JP,,0,0,0,,Сендер-ай, шіркін!
Dialogue: 1,0:11:40.52,0:11:41.75,Dial-JP,,0,0,0,,Кездескенше, Дэвид
Dialogue: 1,0:11:48.60,0:11:50.11,Dial-JP,,0,0,0,,Фалько Ашимо түседі
Dialogue: 1,0:11:54.14,0:11:56.32,Dial-JP,,0,0,0,,Ей, бірге ішейік.
Dialogue: 1,0:11:57.04,0:11:59.85,Dial-JP,,0,0,0,,Фалько, мен де мені тастап кетуіңді қалаймын.
Dialogue: 1,0:12:00.10,0:12:01.34,Dial-JP,,0,0,0,,Иә
Dialogue: 1,0:12:01.34,0:12:03.40,Dial-JP,,0,0,0,,Олар жаман адамдар.
Dialogue: 1,0:12:04.67,0:12:05.84,Dial-JP,,0,0,0,,Дәуіт
Dialogue: 1,0:12:08.16,0:12:09.51,Dial-JP,,0,0,0,,Сусын ішуге шығамыз ба?
Dialogue: 1,0:12:09.91,0:12:12.28,Dial-JP,,0,0,0,,Қартпен ішу қызықсыз
Dialogue: 1,0:12:12.70,0:12:14.87,Dial-JP,,0,0,0,,Мен осында болсам қызық болмас еді.
Dialogue: 1,0:12:15.13,0:12:16.64,Dial-JP,,0,0,0,,Уайымдамаңыз
Dialogue: 1,0:12:17.64,0:12:19.23,Dial-JP,,0,0,0,,Ей, тез серуендейміз.
Dialogue: 1,0:12:21.51,0:12:22.35,Dial-JP,,0,0,0,,Жарайды.
Dialogue: 1,0:12:22.35,0:12:23.28,Dial-JP,,0,0,0,,Уша
Dialogue: 1,0:12:28.73,0:12:29.85,Dial-JP,,0,0,0,,Амансың ба?
Dialogue: 1,0:12:30.34,0:12:31.26,Dial-JP,,0,0,0,,Не
Dialogue: 1,0:12:31.57,0:12:33.25,Dial-JP,,0,0,0,,Бүгін бұл не болды?
Dialogue: 1,0:12:34.16,0:12:34.99,Dial-JP,,0,0,0,,Не?
Dialogue: 1,0:12:35.34,0:12:36.70,Dial-JP,,0,0,0,,Мұның қажеті жоқ.
Dialogue: 1,0:12:37.59,0:12:38.49,Dial-JP,,0,0,0,,Пыс, пыс… Э?
Dialogue: 1,0:12:38.78,0:12:40.51,Dial-JP,,0,0,0,,Бүгін бірінші рет емес.
Dialogue: 1,0:12:41.77,0:12:43.31,Dial-JP,,0,0,0,,Мен сізді байқамады деп ойладым.
Dialogue: 1,0:12:44.48,0:12:45.32,Dial-JP,,0,0,0,,Жақсы
Dialogue: 1,0:12:45.65,0:12:47.74,Dial-JP,,0,0,0,,Әйелдерді кемітпе
Dialogue: 1,0:12:47.74,0:12:48.38,Dial-JP,,0,0,0,,Әйел
Dialogue: 1,0:12:48.74,0:12:49.95,Dial-JP,,0,0,0,,Мен сені өлтіремін
Dialogue: 1,0:12:52.15,0:12:55.97,Dial-JP,,0,0,0,,Бұл мен саған қарап тұрмын дегенді білдірмейді.
Dialogue: 1,0:12:57.18,0:12:58.29,Dial-JP,,0,0,0,,Сәлем Дэвид
Dialogue: 1,0:12:59.57,0:13:00.66,Dial-JP,,0,0,0,,Бірдеңе болды.
Dialogue: 1,0:13:01.78,0:13:02.51,Dial-JP,,0,0,0,,және үшінші (Three) фильмде алғашқы болып өлген адамның немересі, және т.б.—
Dialogue: 1,0:13:02.92,0:13:04.34,Dial-JP,,0,0,0,,Оны әлі де жасыруға тырысуда
Dialogue: 1,0:13:04.34,0:13:05.99,Dial-JP,,0,0,0,,Ребеккаға қатысы жоқ
Dialogue: 1,0:13:06.39,0:13:08.26,Dial-JP,,0,0,0,,Маңызды емес нәрсе бар ма?
Dialogue: 1,0:13:08.67,0:13:10.53,Dial-JP,,0,0,0,,Өмірімді саған сеніп тапсырдым.
Dialogue: 1,0:13:11.82,0:13:12.62,Dial-JP,,0,0,0,,Кешіріңіз
Dialogue: 1,0:13:15.44,0:13:16.77,Dial-JP,,0,0,0,,Сәлем, Дэвид.
Dialogue: 1,0:13:18.94,0:13:20.89,Dial-JP,,0,0,0,,ИМПЛАНТты біраз уақытқа қолданбаңыз
Dialogue: 1,0:13:22.13,0:13:23.86,Dial-JP,,0,0,0,,Мен бәрін қамтыдым.
Dialogue: 1,0:13:24.93,0:13:25.93,Dial-JP,,0,0,0,,Сіз
Dialogue: 1,0:13:25.93,0:13:27.40,Dial-JP,,0,0,0,,Мен байсалдымын.
Dialogue: 1,0:13:29.00,0:13:32.19,Dial-JP,,0,0,0,,Аникиді өлтірген Киберпсихо жігіті есімде.
Dialogue: 1,0:13:32.95,0:13:33.46,Dial-JP,,0,0,0,,О
Dialogue: 1,0:13:34.38,0:13:37.97,Dial-JP,,0,0,0,,Сенің бұлай болғаныңды қаламаймын.
Dialogue: 1,0:13:40.16,0:13:40.83,Dial-JP,,0,0,0,,О
Dialogue: 1,0:14:13.80,0:14:16.20,Dial-JP,,0,0,0,,Мен іздеп жүрген жүйрік әлі бар.
Dialogue: 1,0:14:36.35,0:14:38.43,Dial-JP,,0,0,0,,Тек нысана ғана қалады.
Dialogue: 1,0:14:39.00,0:14:40.18,Dial-JP,,0,0,0,,Ақпаратқа сәйкес.
Dialogue: 1,0:14:42.42,0:14:43.32,Dial-JP,,0,0,0,,ашылды
Dialogue: 1,0:14:44.03,0:14:45.71,Dial-JP,,0,0,0,,Қауіпсіз кіру жолы
Dialogue: 1,0:14:49.99,0:14:50.54,Dial-JP,,0,0,0,,Эрен сияқты түрлендіруден өткен адам деп саналатын Әйел Титанмен бетпе-бет келді—
Dialogue: 1,0:14:50.81,0:14:52.01,Dial-JP,,0,0,0,,Сталкер мырза, келіңізші.
Dialogue: 1,0:15:09.94,0:15:11.45,Dial-JP,,0,0,0,,Дэвид, мен оны өлтірдім.
Dialogue: 1,0:15:11.97,0:15:13.65,Dial-JP,,0,0,0,,Ішінде тағы бір адам қалды.
Dialogue: 1,0:15:14.19,0:15:15.22,Dial-JP,,0,0,0,,Осы бағытта
Dialogue: 1,0:15:15.94,0:15:19.55,Dial-JP,,0,0,0,,Бұл жаман. Сіз бөлмеге келесіз. Мен тыңдаймын.
Dialogue: 1,0:15:23.64,0:15:24.48,Dial-JP,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 1,0:15:36.39,0:15:38.23,Dial-JP,,0,0,0,,Эй, мен сені естимін, Дэвид.
Dialogue: 1,0:15:40.30,0:15:40.82,Dial-JP,,0,0,0,,О
Dialogue: 1,0:15:41.17,0:15:42.91,Dial-JP,,0,0,0,,Мен сізге біраз уақыт бұрын телефон соғып едім.
Dialogue: 1,0:15:43.36,0:15:45.19,Dial-JP,,0,0,0,,Бір адам сонда қайтып кетті.
Dialogue: 1,0:15:46.38,0:15:47.42,Dial-JP,,0,0,0,,Өңделген
Dialogue: 1,0:15:51.80,0:15:52.91,Dial-JP,,0,0,0,,Жақында
Dialogue: 1,0:16:07.37,0:16:08.15,Dial-JP,,0,0,0,,Дәуіт
Dialogue: 1,0:16:15.80,0:16:17.38,Dial-JP,,0,0,0,,Сіз ояусыз ба?
Dialogue: 1,0:16:18.23,0:16:18.95,Dial-JP,,0,0,0,,құжат
Dialogue: 1,0:16:19.34,0:16:21.12,Dial-JP,,0,0,0,,Аздап тынышталдыңыз ба?
Dialogue: 1,0:16:21.82,0:16:22.54,Dial-JP,,0,0,0,,О
Dialogue: 1,0:16:26.87,0:16:28.16,Dial-JP,,0,0,0,,Қашаннан бері?
Dialogue: 1,0:16:28.53,0:16:29.60,Dial-JP,,0,0,0,,Қашан?
Dialogue: 1,0:16:29.60,0:16:33.19,Dial-JP,,0,0,0,,Қолдың треморы, бас айналуы, жүрек айну белгілері.
Dialogue: 1,0:16:33.67,0:16:35.76,Dial-JP,,0,0,0,,Біраз бұрын.
Dialogue: 1,0:16:36.04,0:16:37.89,Dial-JP,,0,0,0,,Неге маған бірден айтпадың?
Dialogue: 1,0:16:38.51,0:16:40.10,Dial-JP,,0,0,0,,Бұл уақытша.
Dialogue: 1,0:16:40.42,0:16:43.10,Dial-JP,,0,0,0,,Ақырында, сізде де жанама әсерлер бар ма?
Dialogue: 1,0:16:43.47,0:16:47.56,Dial-JP,,0,0,0,,Дегенмен, менің осы уақытқа дейін жақсы болғаным әдеттен тыс болды.
Dialogue: 1,0:16:48.63,0:16:50.26,Dial-JP,,0,0,0,,Неге қазір?
Dialogue: 1,0:16:50.26,0:16:54.01,Dial-JP,,0,0,0,,Біраз уақытқа ИМПЛАНТты бастаудан аулақ болыңыз.
Dialogue: 1,0:16:54.01,0:16:57.46,Dial-JP,,0,0,0,,Біз киберпсихоздан бір қадам алыспыз
Dialogue: 1,0:16:57.46,0:17:00.32,Dial-JP,,0,0,0,,Олай болса маған күштірек дәрі беріңізші.
Dialogue: 1,0:17:00.32,0:17:01.50,Dial-JP,,0,0,0,,Әй, қойшы енді.
Dialogue: 1,0:17:01.50,0:17:05.11,Dial-JP,,0,0,0,,Сіз киберпсихозға айналдыңыз ба?
Dialogue: 1,0:17:05.38,0:17:07.97,Dial-JP,,0,0,0,,Осындай қолайлы дәрі болса ғой.
Dialogue: 1,0:17:09.32,0:17:10.70,Dial-JP,,0,0,0,,Оны маған бір сәтке бересіз бе?
Dialogue: 1,0:17:10.70,0:17:12.02,Dial-JP,,0,0,0,,Маған беріңіз
Dialogue: 1,0:17:12.55,0:17:14.54,Dial-JP,,0,0,0,,Араласпаңыз
Dialogue: 1,0:17:15.55,0:17:18.22,Dial-JP,,0,0,0,,Сіз жай ғана ақшаны алыңыз.
Dialogue: 1,0:17:18.22,0:17:19.15,Dial-JP,,0,0,0,,Дәуіт
Dialogue: 1,0:17:28.43,0:17:30.68,Dial-JP,,0,0,0,,Бұл соңғы рецепт.
Dialogue: 1,0:17:31.46,0:17:37.03,Dial-JP,,0,0,0,,9x резервуардың шетінен өту үшін 9 күн жеткілікті.
Dialogue: 1,0:17:37.03,0:17:38.60,Dial-JP,,0,0,0,,Тура тозаққа
Dialogue: 1,0:17:39.38,0:17:42.08,Dial-JP,,0,0,0,,Бұл жаман болды, мен оны енді қайталамаймын.
Dialogue: 1,0:17:42.58,0:17:46.14,Dial-JP,,0,0,0,,​​Жарайды, мен саған ол дәріні беремін.
Dialogue: 1,0:17:46.14,0:17:48.93,Dial-JP,,0,0,0,,Сіз бұл жерге енді қайтып оралмайсыз.
Dialogue: 1,0:17:50.14,0:17:53.87,Dial-JP,,0,0,0,,Бұрын БД сататын бала соншалықты өзгереді деп ойламаппын.
Dialogue: 1,0:17:54.70,0:17:59.30,Dial-JP,,0,0,0,,Бұл өте қарапайым, ең жақсы жағдайда бұл аңыз.
Dialogue: 1,0:18:07.65,0:18:09.47,Dial-JP,,0,0,0,,Мен оқиғаны айтып беремін.
Dialogue: 1,0:18:10.62,0:18:12.27,Dial-JP,,0,0,0,,Дэвид, күте тұрыңыз.
Dialogue: 1,0:18:12.94,0:18:14.21,Dial-JP,,0,0,0,,Бұл бұрын не болды?
Dialogue: 1,0:18:14.84,0:18:16.04,Dial-JP,,0,0,0,,Барлығына айтпа
Dialogue: 1,0:18:17.32,0:18:18.22,Dial-JP,,0,0,0,,Оны өз бетінше қалдыр
Dialogue: 1,0:18:22.29,0:18:23.03,Dial-JP,,0,0,0,,Эй
Dialogue: 1,0:18:28.69,0:18:31.83,Dial-JP,,0,0,0,,Егер сіз ИМПЛАНТты тым көп пайдалансаңыз, сіз бір күні шектеуге жетесіз.
Dialogue: 1,0:18:32.34,0:18:34.69,Dial-JP,,0,0,0,,Оны енді қарапайым ингибиторлармен басу мүмкін емес.
Dialogue: 1,0:18:35.83,0:18:37.01,Dial-JP,,0,0,0,,Жетеді, солай ма?
Dialogue: 1,0:18:38.23,0:18:40.15,Dial-JP,,0,0,0,,Мен сенің өзгергеніңді көре алмаймын.
Dialogue: 1,0:18:41.01,0:18:42.69,Dial-JP,,0,0,0,,ИМПЛАНТТЫ алып тастаңыз
Dialogue: 1,0:18:43.65,0:18:45.25,Dial-JP,,0,0,0,,Сіз мұны істей алмайсыз.
Dialogue: 1,0:18:45.25,0:18:45.97,Dial-JP,,0,0,0,,Неліктен?
Dialogue: 1,0:18:47.11,0:18:51.12,Dial-JP,,0,0,0,,Анам да, Мэн де маған бір нәрсені сеніп тапсырып өлді.
Dialogue: 1,0:18:52.33,0:18:54.03,Dial-JP,,0,0,0,,Мен әлі ештеңе істеген жоқпын.
Dialogue: 1,0:18:54.40,0:18:55.56,Dial-JP,,0,0,0,,Мұндай нәрсе
Dialogue: 1,0:18:56.23,0:18:58.08,Dial-JP,,0,0,0,,Өйткені бұл одан да көп.
Dialogue: 1,0:18:58.08,0:18:59.71,Dial-JP,,0,0,0,,Мен үшін жақсы
Dialogue: 1,0:19:00.08,0:19:04.32,Dial-JP,,0,0,0,,Неліктен сіз өзіңізді ерекшемін деп ойлайсыз?
Dialogue: 1,0:19:05.44,0:19:07.62,Dial-JP,,0,0,0,,Сандевистанға төтеп бере алдым.
Dialogue: 1,0:19:08.28,0:19:09.81,Dial-JP,,0,0,0,,Қалыпты нәрсе жоқ.
Dialogue: 1,0:19:11.57,0:19:14.62,Dial-JP,,0,0,0,,Адамдарға қарағанда біршама төзімді болуы мүмкін
Dialogue: 1,0:19:15.18,0:19:17.10,Dial-JP,,0,0,0,,Бірақ сіз қарапайым адамсыз.
Dialogue: 1,0:19:20.20,0:19:21.64,Dial-JP,,0,0,0,,Әйелді атып тастады
Dialogue: 1,0:19:24.20,0:19:26.74,Dial-JP,,0,0,0,,Мен анаммен жастамын.
Dialogue: 1,0:19:27.88,0:19:29.86,Dial-JP,,0,0,0,,Менің өлшемімде балалар да болды.
Dialogue: 1,0:19:31.89,0:19:34.41,Dial-JP,,0,0,0,,Ол қылмыскер емес, қарапайым адам болды.
Dialogue: 1,0:19:35.81,0:19:39.27,Dial-JP,,0,0,0,,Осы уақытқа дейін қанша адамды өлтіргенімді де білмеймін.
Dialogue: 1,0:19:40.53,0:19:42.88,Dial-JP,,0,0,0,,Мен адамдарды өлтіру туралы ештеңе ойламаймын.
Dialogue: 1,0:19:44.44,0:19:47.84,Dial-JP,,0,0,0,,Мүмкін мен жындымын
Dialogue: 1,0:19:48.61,0:19:49.54,Dial-JP,,0,0,0,,Дәуіт
Dialogue: 1,0:19:50.45,0:19:53.98,Dial-JP,,0,0,0,,Мен қалыпты емеспін, мен сенен басқамын
Dialogue: 1,0:19:54.42,0:19:55.67,Dial-JP,,0,0,0,,Айырмашылығы жоқ.
Dialogue: 1,0:19:55.67,0:19:56.74,Dial-JP,,0,0,0,,Бұл басқаша.
Dialogue: 1,0:19:57.69,0:19:58.87,Dial-JP,,0,0,0,,Айырмашылығы жоқ.
Dialogue: 1,0:19:59.46,0:20:00.91,Dial-JP,,0,0,0,,Сіз мұны істей алмайсыз.
Dialogue: 1,0:20:02.61,0:20:06.02,Dial-JP,,0,0,0,,Сіз негізгі қайтыс болғаннан кейін командаға қосылмадыңыз.
Dialogue: 1,0:20:06.02,0:20:06.92,Dial-JP,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 1,0:20:07.57,0:20:08.79,Dial-JP,,0,0,0,,Бұл жақсы.
Dialogue: 1,0:20:09.46,0:20:10.26,Dial-JP,,0,0,0,,Неліктен?
Dialogue: 1,0:20:10.52,0:20:13.01,Dial-JP,,0,0,0,,Сен мен сияқты болмайсың
Dialogue: 1,0:20:13.53,0:20:16.56,Dial-JP,,0,0,0,,Жоқ, Дэвид, мен.
Dialogue: 1,0:20:17.04,0:20:19.26,Dial-JP,,0,0,0,,Егер солай болса, мен командаға орала аламын ба?
Dialogue: 1,0:20:20.24,0:20:23.31,Dial-JP,,0,0,0,,Бұрынғыдай бірге жасайық.
Dialogue: 1,0:20:27.36,0:20:30.46,Dial-JP,,0,0,0,,Мен мұны қазір істей алмаймын. Тағы біраз күтіңіз.
Dialogue: 1,0:20:30.92,0:20:31.47,Dial-JP,,0,0,0,,Бұл сенсің ғой, иә?
Dialogue: 1,0:20:32.70,0:20:35.43,Dial-JP,,0,0,0,,Маған шынымен де істеу керек нәрсе бар ма?
Dialogue: 1,0:20:35.43,0:20:36.54,Dial-JP,,0,0,0,,Бұл не?
Dialogue: 1,0:20:37.26,0:20:38.54,Dial-JP,,0,0,0,,Толығырақ айта алмаймын.
Dialogue: 1,0:20:39.42,0:20:40.09,Dial-JP,,0,0,0,,Неліктен?
Dialogue: 1,0:20:40.64,0:20:41.18,Dial-JP,,0,0,0,,Кешіріңіз
Dialogue: 1,0:20:42.14,0:20:43.88,Dial-JP,,0,0,0,,Маған тіпті айта алмайсың
Dialogue: 1,0:20:44.74,0:20:45.67,Dial-JP,,0,0,0,,Кешіріңіз
Dialogue: 1,0:20:47.20,0:20:49.99,Dial-JP,,0,0,0,,Жарайды, енді сенен сұрамаймын.
Dialogue: 1,0:20:52.69,0:20:56.79,Dial-JP,,0,0,0,,Бәлкім, өз жолымызбен кеткеніміз дұрыс шығар.
Dialogue: 1,0:20:57.17,0:20:59.48,Dial-JP,,0,0,0,,Жоқ, бұл дұрыс емес, Дэвид.
Dialogue: 1,0:21:07.11,0:21:08.32,Dial-JP,,0,0,0,,Кешіріңіз, Дэвид
Dialogue: 1,0:21:09.03,0:21:10.65,Dial-JP,,0,0,0,,Менің кетуім керек
Dialogue: 1,0:21:11.25,0:21:13.37,Dial-JP,,0,0,0,,Қайда?
Dialogue: 1,0:21:14.97,0:21:15.84,Dial-JP,,0,0,0,,Менің кетуім керек
Dialogue: 1,0:21:18.37,0:21:19.12,Dial-JP,,0,0,0,,Түсіндім
Dialogue: 1,0:21:19.92,0:21:21.38,Dial-JP,,0,0,0,,Қайтып келгенде дұрыстап сөйлесейік.
Dialogue: 1,0:21:22.16,0:21:23.54,Dial-JP,,0,0,0,,Сондықтан күтіңіз.
Dialogue: 1,0:21:37.97,0:21:40.42,Dial-JP,,0,0,0,,Осы уақыт ішінде жүгіруші идентификаторымен бірдей
Dialogue: 1,0:21:41.95,0:21:42.96,Dial-JP,,0,0,0,,Хокс та керемет болды.
Dialogue: 1,0:22:08.29,0:22:11.15,Dial-JP,,0,0,0,,Мен оны оңай аласың деп ойламаппын.
Dialogue: 1,0:22:15.31,0:22:18.47,Dial-JP,,0,0,0,,Бұл сувенир Арасакаға төлқұжатыңыз болады.
Dialogue: 1,0:22:18.99,0:22:20.93,Dial-JP,,0,0,0,,Жарайсың киви
Dialogue: 1,0:02:02.45,0:02:05.57,OP-EN_EP02,,0,0,0,,Менің жолымды өртеп жіберу
Dialogue: 1,0:02:08.83,0:02:11.52,OP-EN_EP02,,0,0,0,,Сондай тәтті қирату
Dialogue: 1,0:02:15.57,0:02:18.28,OP-EN_EP02,,0,0,0,,Менің ішімде от бар
Dialogue: 1,0:02:18.59,0:02:26.33,OP-EN_EP02,,0,0,0,,Жанып тұрған от
Dialogue: 1,0:02:52.72,0:02:55.10,OP-EN_EP02,,0,0,0,,Бұл өрт бақылаудан шықты
Dialogue: 1,0:02:55.34,0:02:56.02,OP-EN_EP02,,0,0,0,,Мен оны өртеп жіберемін
Dialogue: 1,0:02:56.02,0:02:57.03,OP-EN_EP02,,0,0,0,,Мен оны өртеп жіберемін
Dialogue: 1,0:02:57.03,0:02:58.02,OP-EN_EP02,,0,0,0,,Мен оны өртеп жіберемін
Dialogue: 1,0:02:58.02,0:02:59.35,OP-EN_EP02,,0,0,0,,Мен оны өртеп жіберемін
Dialogue: 1,0:03:08.53,0:03:09.36,OP-EN_EP02,,0,0,0,,Мен оны өртеп жіберемін
Dialogue: 1,0:03:09.36,0:03:10.46,OP-EN_EP02,,0,0,0,,Мен оны өртеп жіберемін
Dialogue: 1,0:03:10.46,0:03:11.32,OP-EN_EP02,,0,0,0,,Мен оны өртеп жіберемін
Dialogue: 1,0:03:11.32,0:03:12.37,OP-EN_EP02,,0,0,0,,Мен оны өртеп жіберемін
Dialogue: 0,0:02:02.45,0:02:05.57,OP-CH_EP02,,0,0,0,,Қатты көрініс
Dialogue: 0,0:02:08.83,0:02:11.52,OP-CH_EP02,,0,0,0,,Тәтті жер шірік
Dialogue: 0,0:02:15.57,0:02:18.28,OP-CH_EP02,,0,0,0,,Гаму Кирецуэн
Dialogue: 0,0:02:52.72,0:02:55.10,OP-CH_EP02,,0,0,0,,Жалынды сөндіруден босату жүйесі
Dialogue: 1,0:22:42.82,0:22:46.99,ED-JP_EP02,,0,0,0,,Олар ақырында жалынды сезінеді
Dialogue: 1,0:22:47.17,0:22:51.36,ED-JP_EP02,,0,0,0,,Тамырымда ағып жатқан жалын
Dialogue: 1,0:22:51.70,0:22:55.71,ED-JP_EP02,,0,0,0,,Мен бұл қаланы өртеп жіберемін
Dialogue: 1,0:22:55.92,0:23:00.07,ED-JP_EP02,,0,0,0,,Біз қайтуды жоспарламаймыз
Dialogue: 1,0:23:00.92,0:23:04.75,ED-JP_EP02,,0,0,0,,Еркін болуға тырысу
Dialogue: 1,0:23:05.09,0:23:08.35,ED-JP_EP02,,0,0,0,,Менің көргенімді сендерге көрсету үшін
Dialogue: 1,0:23:09.75,0:23:13.59,ED-JP_EP02,,0,0,0,,Өз тілектеріңізді ұстаныңыз
Dialogue: 1,0:23:13.59,0:23:17.24,ED-JP_EP02,,0,0,0,,Егер сіз мені ұстай алмасаңыз
Dialogue: 1,0:23:17.58,0:23:20.36,ED-JP_EP02,,0,0,0,,Көңіліңізді түсіргенім үшін кешіріңіз
Dialogue: 1,0:23:22.11,0:23:26.02,ED-JP_EP02,,0,0,0,,Сізді тағы да ренжіткенім үшін кешіріңіз
Dialogue: 1,0:23:26.36,0:23:29.44,ED-JP_EP02,,0,0,0,,Менің күшім жеткіліксіз деп ойлаймын
Dialogue: 1,0:23:31.15,0:23:32.87,ED-JP_EP02,,0,0,0,,Дәл қазір
Dialogue: 1,0:23:33.29,0:23:34.37,ED-JP_EP02,,0,0,0,,Сізді ренжітіңіз
Dialogue: 1,0:23:34.37,0:23:40.38,ED-JP_EP02,,0,0,0,,О, менің махаббатым
Dialogue: 1,0:23:48.63,0:23:51.34,ED-JP_EP02,,0,0,0,,Ой, көңіліңді қалдыр
Dialogue: 0,0:22:42.82,0:22:46.99,ED-CH_EP02,,0,0,0,,Адамзаттың ақыры жалынмен сезіледі
Dialogue: 0,0:22:47.17,0:22:51.36,ED-CH_EP02,,0,0,0,,Тамырымда күйіп
Dialogue: 0,0:22:51.70,0:22:55.71,ED-CH_EP02,,0,0,0,,От жарық қаласы
Dialogue: 0,0:22:55.92,0:23:00.07,ED-CH_EP02,,0,0,0,,Қайтару
Dialogue: 0,0:23:00.92,0:23:04.75,ED-CH_EP02,,0,0,0,,Тегін және тегін
Dialogue: 0,0:23:05.09,0:23:08.35,ED-CH_EP02,,0,0,0,,Менің не істей алатынымды көргің келсе
Dialogue: 0,0:23:09.75,0:23:13.59,ED-CH_EP02,,0,0,0,,Меншік иесінің қалауы
Dialogue: 0,0:23:13.59,0:23:17.24,ED-CH_EP02,,0,0,0,,Нәтиже қайталанбайды деп үміттенемін
Dialogue: 0,0:23:17.58,0:23:20.36,ED-CH_EP02,,0,0,0,,Көңілсіздік
Dialogue: 0,0:23:22.11,0:23:26.02,ED-CH_EP02,,0,0,0,,Көңілсіздік
Dialogue: 0,0:23:26.36,0:23:29.44,ED-CH_EP02,,0,0,0,,Менің өзімді тануым күшті
