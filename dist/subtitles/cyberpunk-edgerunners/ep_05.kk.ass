Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.46,0:00:08.71,Top,,0000,0000,0000,,‎NETFLIX аниме сериясы
Dialogue: 0,0:00:11.01,0:00:16.01,Top,,0000,0000,0000,,♪~
Dialogue: 0,0:01:34.13,0:01:39.14,Top,,0000,0000,0000,,~♪
Dialogue: 0,0:01:42.10,0:01:42.93,Top,,0000,0000,0000,,(Түсіндім!)
Dialogue: 0,0:01:46.35,0:01:47.94,Bottom,,0000,0000,0000,,Оларды киіп көргіңіз келе ме?
Dialogue: 0,0:01:46.43,0:01:47.94,Top,,0000,0000,0000,,‎Оны киіп көргіңіз келе ме?
Dialogue: 0,0:01:48.52,0:01:50.19,Bottom,,0000,0000,0000,,Менің мүмкіндігім жоқ.
Dialogue: 0,0:01:48.56,0:01:50.36,Top,,0000,0000,0000,,‎Мұндай ақша әлі де...
Dialogue: 0,0:01:50.27,0:01:53.19,Bottom,,0000,0000,0000,,Бекка басын изеді. Барлығы сенікі, жолдар жоқ.
Dialogue: 0,0:01:50.44,0:01:53.36,Top,,0000,0000,0000,,‎Ребекка мұны сізге тегін жасайтынын айтты.
Dialogue: 0,0:01:53.98,0:01:55.53,Top,,0000,0000,0000,,‎Жоқ, мен оны тоқтатамын.
Dialogue: 0,0:01:54.03,0:01:55.49,Bottom,,0000,0000,0000,,Жоқ рахмет.
Dialogue: 0,0:01:55.57,0:01:59.95,Bottom,,0000,0000,0000,,Сэнди киген кезде сізді мазаламады.
Dialogue: 0,0:01:55.61,0:01:58.15,Top,,0000,0000,0000,,Иә? Өйткені бұл өлген адамның имплантаты
Dialogue: 0,0:01:58.24,0:02:00.12,Top,,0000,0000,0000,,Сізде бұл туралы алаңдайтын шарлар жоқ.
Dialogue: 0,0:02:00.03,0:02:03.12,Bottom,,0000,0000,0000,,Өзіңіз білетін адамнан құтыла алмайсыз ба?
Dialogue: 0,0:02:00.20,0:02:03.08,Top,,0000,0000,0000,,Әлде сіз білетін адам үшін бұл қиын ба?
Dialogue: 0,0:02:03.16,0:02:04.99,Top,,0000,0000,0000,,‎Бұл Течиге арналған, солай ма?
Dialogue: 0,0:02:03.20,0:02:05.04,Bottom,,0000,0000,0000,,Олар бәрібір техникалық қолғаптар.
Dialogue: 0,0:02:05.08,0:02:07.12,Top,,0000,0000,0000,,‎Не, сен бұған соншалықты ерекшесің бе?
Dialogue: 0,0:02:05.12,0:02:07.12,Bottom,,0000,0000,0000,,Сіз жай ғана таңдайсыз.
Dialogue: 0,0:02:07.21,0:02:09.46,Top,,0000,0000,0000,,‎Мен не қалайтынымды шештім.
Dialogue: 0,0:02:07.21,0:02:09.50,Bottom,,0000,0000,0000,,Мен басқа нәрсеге назар аудардым.
Dialogue: 0,0:02:09.54,0:02:10.88,Top,,0000,0000,0000,,Сіз не шештіңіз?
Dialogue: 0,0:02:09.58,0:02:10.88,Bottom,,0000,0000,0000,,Нені көрдіңіз?
Dialogue: 0,0:02:12.38,0:02:14.38,Bottom,,0000,0000,0000,,О! Бұл?
Dialogue: 0,0:02:12.42,0:02:14.38,Top,,0000,0000,0000,,‎Эй, бұл жігіт
Dialogue: 0,0:02:14.96,0:02:16.84,Bottom,,0000,0000,0000,,Сіз үшін үлкен, солай емес пе?
Dialogue: 0,0:02:15.05,0:02:16.88,Top,,0000,0000,0000,,Бұл сіздің денеңізден қалың
Dialogue: 0,0:02:16.92,0:02:18.63,Bottom,,0000,0000,0000,,Менің қолымнан келеді.
Dialogue: 0,0:02:16.97,0:02:18.63,Top,,0000,0000,0000,,‎Онша емес, солай ма?
Dialogue: 0,0:02:18.72,0:02:21.47,Top,,0000,0000,0000,,Егер мен өлсем, оны маған бере аласыз.
Dialogue: 0,0:02:19.22,0:02:21.72,Bottom,,0000,0000,0000,,Әрине, егер мен тегіс болсам, бәрі сенікі.
Dialogue: 0,0:02:22.22,0:02:24.93,Top,,0000,0000,0000,,Бұған дейін бір тонна хром қосыңыз.
Dialogue: 0,0:02:22.22,0:02:25.27,Bottom,,0000,0000,0000,,Сізге көптеп, өсуге уақыт береді.
Dialogue: 0,0:02:25.01,0:02:28.23,Top,,0000,0000,0000,,‎Иә, бұл уәде, солай ма?
Dialogue: 0,0:02:26.06,0:02:28.64,Bottom,,0000,0000,0000,,«Кей. Мәміле.
Dialogue: 0,0:02:28.73,0:02:29.39,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:02:30.19,0:02:32.73,Bottom,,0000,0000,0000,,Білесіз бе, сізде бір нәрсе басқаша...
Dialogue: 0,0:02:30.27,0:02:32.86,Top,,0000,0000,0000,,Бүгін сізде басқа нәрсе бар.
Dialogue: 0,0:02:32.81,0:02:33.65,Bottom,,0000,0000,0000,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:02:32.94,0:02:33.65,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:02:34.23,0:02:37.78,Bottom,,0000,0000,0000,,Сіз әдетте діріл түсіріп, сүртіп жатырсыз…
Dialogue: 0,0:02:34.23,0:02:38.99,Top,,0000,0000,0000,,‎Әдетте көбірек ‎Мұңды... немесе мұңды.
Dialogue: 0,0:02:37.86,0:02:39.40,Bottom,,0000,0000,0000,,Резиденттің шулылығы.
Dialogue: 0,0:02:39.49,0:02:42.45,Bottom,,0000,0000,0000,,Мен емес! Ал мен кешегіден еш айырмашылығым жоқ!
Dialogue: 0,0:02:39.49,0:02:42.49,Top,,0000,0000,0000,,‎Hideo, әдеттегідей.
Dialogue: 0,0:02:42.53,0:02:43.91,Bottom,,0000,0000,0000,,Жоқ. Бірдеңе істен шықты.
Dialogue: 0,0:02:42.57,0:02:43.91,Top,,0000,0000,0000,,‎Жоқ, жоқ.
Dialogue: 0,0:02:44.49,0:02:45.95,Top,,0000,0000,0000,,Сіз мұны істедіңіз бе?
Dialogue: 0,0:02:44.49,0:02:46.12,Bottom,,0000,0000,0000,,Сіз төсектес болдыңыз ба?
Dialogue: 0,0:02:46.04,0:02:47.37,Top,,0000,0000,0000,,Ух...
Dialogue: 0,0:02:47.79,0:02:48.71,Bottom,,0000,0000,0000,,Сіз жасадыңыз.
Dialogue: 0,0:02:47.87,0:02:48.58,Top,,0000,0000,0000,,Дұрыс?
Dialogue: 0,0:02:48.66,0:02:49.41,Top,,0000,0000,0000,,Ух...
Dialogue: 0,0:02:49.50,0:02:52.67,Bottom,,0000,0000,0000,,Мына покер бетінде жұмыс істеу керек, ұлым!
Dialogue: 0,0:02:49.50,0:02:52.67,Top,,0000,0000,0000,,‎Аа, мұны түсіну оңай!
Dialogue: 0,0:02:52.75,0:02:55.42,Bottom,,0000,0000,0000,,Киви! Қандай да бір прогресс?
Dialogue: 0,0:02:52.75,0:02:55.42,Top,,0000,0000,0000,,‎Киви Сіз бірдеңе білдіңіз бе?
Dialogue: 0,0:02:55.50,0:02:57.26,Top,,0000,0000,0000,,‎(Киви) Мүлдем
Dialogue: 0,0:02:55.50,0:02:57.76,Bottom,,0000,0000,0000,,Мүлде жоқ.
Dialogue: 0,0:02:59.26,0:03:03.18,Bottom,,0000,0000,0000,,Соңғы концерттен бері Танака қорғанысын күшейтті.
Dialogue: 0,0:02:59.26,0:03:03.18,Top,,0000,0000,0000,,(Киви) Содан бері Арасаканың күзетшісі тым күшті~
Dialogue: 0,0:03:03.85,0:03:06.85,Bottom,,0000,0000,0000,,Айнала тесуге тырыстым, бірақ бұл мүмкін болмады.
Dialogue: 0,0:03:03.93,0:03:06.93,Top,,0000,0000,0000,,Мен оған бірнеше рет шабуыл жасауға тырыстым, бірақ мүмкіндік болмады.
Dialogue: 0,0:03:06.93,0:03:11.19,Bottom,,0000,0000,0000,,Мен саған не айттым? Фарадей бізді тамақтандырмайынша ешқайда жете алмаймыз.
Dialogue: 0,0:03:07.02,0:03:11.19,Top,,0000,0000,0000,,Мен сізге айттым, біз Фарадейден Танака туралы ақпаратты күтуіміз керек.
Dialogue: 0,0:03:11.27,0:03:13.15,Top,,0000,0000,0000,,‎Танака...
Dialogue: 0,0:03:11.77,0:03:13.15,Bottom,,0000,0000,0000,,Танака?
Dialogue: 0,0:03:13.23,0:03:15.94,Bottom,,0000,0000,0000,,Сіздің алғашқы ұрлық автокөлігіңіз есіңізде ме?
Dialogue: 0,0:03:13.23,0:03:17.32,Top,,0000,0000,0000,,Сіз бірінші жұмысыңызда көлік ұрладыңыз, солай ма? Иесі
Dialogue: 0,0:03:16.02,0:03:17.44,Bottom,,0000,0000,0000,,Ол лимузиннің иесі.
Dialogue: 0,0:03:19.03,0:03:20.19,Bottom,,0000,0000,0000,,Мәселе?
Dialogue: 0,0:03:19.11,0:03:20.20,Top,,0000,0000,0000,,Не болды?
Dialogue: 0,0:03:20.28,0:03:21.99,Bottom,,0000,0000,0000,,Жоқ, бұл ештеңе емес...
Dialogue: 0,0:03:20.28,0:03:22.03,Top,,0000,0000,0000,,Жоқ, олай емес
Dialogue: 0,0:03:22.07,0:03:23.45,Bottom,,0000,0000,0000,,Сіз бұған қарайсыз ба?
Dialogue: 0,0:03:22.11,0:03:23.53,Top,,0000,0000,0000,,‎(Киви) О, сен
Dialogue: 0,0:03:23.53,0:03:25.95,Bottom,,0000,0000,0000,,Танаканың баласымен бірге сыныптас болдың.
Dialogue: 0,0:03:23.62,0:03:25.95,Top,,0000,0000,0000,,Танаканың ұлымен сыныптас болдың, солай ма?
Dialogue: 0,0:03:27.54,0:03:28.75,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:27.54,0:03:32.67,Bottom,,0000,0000,0000,,Не?! Сіз біздің баламызды тығырыққа тірелген корпус мектебіне барды деп айыптайсыз ба?
Dialogue: 0,0:03:28.83,0:03:32.71,Top,,0000,0000,0000,,Бұл жігіт Арасакадағы басшының баласымен бір мектепте оқиды ма?
Dialogue: 0,0:03:32.75,0:03:36.71,Bottom,,0000,0000,0000,,Шынайы Арасака академиясын тастап кету. Тікелей студент.
Dialogue: 0,0:03:32.79,0:03:34.67,Top,,0000,0000,0000,,‎(Киви) ‎Арасака академиясын тастау
Dialogue: 0,0:03:34.75,0:03:36.75,Top,,0000,0000,0000,,Ең үздік бомбардир емес
Dialogue: 0,0:03:36.79,0:03:38.71,Bottom,,0000,0000,0000,,Мен қарғысқа ұшыраймын!
Dialogue: 0,0:03:36.84,0:03:38.71,Top,,0000,0000,0000,,Бұл керемет.
Dialogue: 0,0:03:38.80,0:03:39.88,Top,,0000,0000,0000,,Мен түсінемін.
Dialogue: 0,0:03:38.80,0:03:43.80,Bottom,,0000,0000,0000,,Глорияның неге әрқашан қолма-қол ақшаға байланғанын енді білеміз.
Dialogue: 0,0:03:39.96,0:03:43.68,Top,,0000,0000,0000,,Глорияның зейнеткерлік зейнетақысы оқу ақысына байланысты ма?
Dialogue: 0,0:03:43.76,0:03:47.47,Top,,0000,0000,0000,,Хаа... Рұқсатсыз біреудің өткенін іздемейсіз бе?
Dialogue: 0,0:03:44.43,0:03:47.47,Bottom,,0000,0000,0000,,Бұл жерде жеке өмір сүру үшін жігіт не істеуі керек?
Dialogue: 0,0:03:47.56,0:03:49.14,Top,,0000,0000,0000,,‎(киви) және т.б
Dialogue: 0,0:03:48.26,0:03:53.19,Bottom,,0000,0000,0000,,Мен Танаканың жеке файлынан басқа көп нәрсе таба алмадым. Қалғаны қоқыс.
Dialogue: 0,0:03:49.22,0:03:53.19,Top,,0000,0000,0000,,Мен Танаканың соңғы жеке ақпаратын таба алдым, бірақ бұл қоқыс.
Dialogue: 0,0:03:53.27,0:03:55.98,Bottom,,0000,0000,0000,,-Ұнады ма? -XBD оның көру журналында.
Dialogue: 0,0:03:53.27,0:03:55.98,Top,,0000,0000,0000,,Мысалы? (Киви) Артқа BD (Bee Dee) тарихы т.б.
Dialogue: 0,0:03:56.06,0:03:59.53,Bottom,,0000,0000,0000,,Бұл жақсы. Біз оны левередж үшін пайдалана аламыз.
Dialogue: 0,0:03:56.06,0:03:59.53,Top,,0000,0000,0000,,Бұл жақсы. Мен сені бұл оқиғамен қорқытуға тырысамын.
Dialogue: 0,0:03:59.61,0:04:01.74,Bottom,,0000,0000,0000,,Нағыз кинкстер. Порноға қарағанда көбірек қасірет.
Dialogue: 0,0:03:59.61,0:04:01.74,Top,,0000,0000,0000,,‎(Киви) ‎Порнодан да көп
Dialogue: 0,0:04:01.82,0:04:04.03,Top,,0000,0000,0000,,Киберпсихоз
Dialogue: 0,0:04:01.82,0:04:04.07,Bottom,,0000,0000,0000,,Кейбір киберпсихо боктары да.
Dialogue: 0,0:04:04.11,0:04:06.99,Top,,0000,0000,0000,,Эй, Корпо жігіттері де еркін ғашықтар, солай емес пе?
Dialogue: 0,0:04:04.66,0:04:06.99,Bottom,,0000,0000,0000,,Костюмнің терең, қараңғы фетиштері.
Dialogue: 0,0:04:08.12,0:04:11.00,Bottom,,0000,0000,0000,,Дж.К. жүретін гонктың көптеген бейнелері.
Dialogue: 0,0:04:08.24,0:04:11.00,Top,,0000,0000,0000,,Киви, Дж.К. сияқты авторлар көп болды деп ойлаймын.
Dialogue: 0,0:04:11.08,0:04:11.87,Top,,0000,0000,0000,,‎JK?
Dialogue: 0,0:04:11.08,0:04:11.91,Bottom,,0000,0000,0000,,JK?
Dialogue: 0,0:04:13.46,0:04:14.62,Bottom,,0000,0000,0000,,Ол туралы естідіңіз бе?
Dialogue: 0,0:04:13.46,0:04:14.62,Top,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:04:14.71,0:04:16.50,Top,,0000,0000,0000,,Джимми Куросаки
Dialogue: 0,0:04:14.71,0:04:19.38,Bottom,,0000,0000,0000,,Әрине. Джимми Куросаки. Ізбасарлары бар брейнденс директоры.
Dialogue: 0,0:04:16.58,0:04:19.38,Top,,0000,0000,0000,,Әйгілі Cult BD директоры.
Dialogue: 0,0:04:19.46,0:04:23.17,Top,,0000,0000,0000,,Оқиғадан кейін 24 сағат ішінде шығарылатын материалдың жаңалығы
Dialogue: 0,0:04:19.46,0:04:24.76,Bottom,,0000,0000,0000,,Ол оқиға болғаннан кейін 24 сағат ішінде иіскеулерді қоюмен танымал.
Dialogue: 0,0:04:23.26,0:04:24.84,Top,,0000,0000,0000,,‎Радикалды редакциялау - сату нүктесі
Dialogue: 0,0:04:24.84,0:04:29.14,Bottom,,0000,0000,0000,,Режиссердің өзі жасайтын өңдеулерді жасағанын ешқашан көрген емеспін.
Dialogue: 0,0:04:24.93,0:04:27.51,Top,,0000,0000,0000,,Шынымды айтсам, бұл ақылсыз. Басқа BD директорлары қандай?
Dialogue: 0,0:04:27.60,0:04:29.22,Top,,0000,0000,0000,,‎Әртүрлі деңгейлер
Dialogue: 0,0:04:29.22,0:04:32.02,Bottom,,0000,0000,0000,,Оның жанкүйерлерінің көп болуы таңқаларлық емес.
Dialogue: 0,0:04:29.31,0:04:32.02,Top,,0000,0000,0000,,Сондықтан қатты жанкүйерлер көп.
Dialogue: 0,0:04:32.10,0:04:35.06,Bottom,,0000,0000,0000,,Сіздің суперфрак екеніңізді білмедім.
Dialogue: 0,0:04:32.10,0:04:35.10,Top,,0000,0000,0000,,Мен сенің мұндай бұзық BD отаку екеніңді білмедім.
Dialogue: 0,0:04:35.14,0:04:36.02,Bottom,,0000,0000,0000,,О, жақсы...
Dialogue: 0,0:04:35.19,0:04:36.02,Top,,0000,0000,0000,,О, жоқ...
Dialogue: 0,0:04:36.10,0:04:39.65,Bottom,,0000,0000,0000,,Жай ғана таңдаулыға акциясын жылжытуға көмектесті.
Dialogue: 0,0:04:36.10,0:04:39.65,Top,,0000,0000,0000,,Мен бір танысыма құпия БД сатуға көмектестім.
Dialogue: 0,0:04:39.73,0:04:43.99,Top,,0000,0000,0000,,‎(Киви) Маған бәрібір, бірақ сізде басқа пайдалы ақпарат жоқ па?
Dialogue: 0,0:04:39.73,0:04:44.32,Bottom,,0000,0000,0000,,Бұл жақсы, бірақ сізде біз пайдалана алатын қандай да бір ақпарат бар ма?
Dialogue: 0,0:04:44.40,0:04:45.61,Bottom,,0000,0000,0000,,Олар тапсырыс бойынша жасалған.
Dialogue: 0,0:04:44.49,0:04:45.66,Top,,0000,0000,0000,,‎Тапсырыс бойынша жасалған…
Dialogue: 0,0:04:45.70,0:04:46.53,Bottom,,0000,0000,0000,,Жер
Dialogue: 0,0:04:45.74,0:04:46.53,Top,,0000,0000,0000,,‎(Киви) Не?
Dialogue: 0,0:04:46.61,0:04:48.78,Top,,0000,0000,0000,,‎VIP‎ үшін тапсырыс бойынша жасалған
Dialogue: 0,0:04:47.12,0:04:51.08,Bottom,,0000,0000,0000,,Ол кейде VIP-лер үшін тапсырыс бойынша түсірілген кадрларды баптайды деп естідім.
Dialogue: 0,0:04:48.87,0:04:51.12,Top,,0000,0000,0000,,‎Мен сіздің баптап жатқаныңызды естідім.
Dialogue: 0,0:04:51.16,0:04:53.12,Bottom,,0000,0000,0000,,Сіз ауырсынуды шектейтін заттарды алып тастауды білесіз бе?
Dialogue: 0,0:04:51.20,0:04:53.20,Top,,0000,0000,0000,,‎Ауыруды шектегішті алып тастаңыз...
Dialogue: 0,0:04:53.20,0:04:54.54,Bottom,,0000,0000,0000,,Сонда не?
Dialogue: 0,0:04:53.29,0:04:54.58,Top,,0000,0000,0000,,Сонда не болды?
Dialogue: 0,0:04:54.62,0:04:58.88,Bottom,,0000,0000,0000,,Егер ол кадрларды баптап жатса, Танака да сонда болуы керек.
Dialogue: 0,0:04:54.66,0:04:56.58,Top,,0000,0000,0000,,‎Тюнинг деген нені білдіреді?
Dialogue: 0,0:04:56.67,0:05:00.17,Top,,0000,0000,0000,,Адамның өзі де жалғыз болуы керек.
Dialogue: 0,0:04:58.96,0:05:00.17,Bottom,,0000,0000,0000,,Және жалғыз шығар.
Dialogue: 0,0:05:00.25,0:05:02.05,Bottom,,0000,0000,0000,,Жалғыз ба? Сіз қалай түсінесіз?
Dialogue: 0,0:05:00.25,0:05:02.05,Top,,0000,0000,0000,,‎(Киви) ‎Сен жалғыз екеніңді қайдан білесің?
Dialogue: 0,0:05:02.13,0:05:05.55,Bottom,,0000,0000,0000,,Фетиш BD баптау үшін оққағар әкелесіз бе?
Dialogue: 0,0:05:02.13,0:05:05.55,Top,,0000,0000,0000,,Олар құпия DVD сатып алу үшін күзетші әкеледі деп ойлайсыз ба?
Dialogue: 0,0:05:07.89,0:05:08.93,Bottom,,0000,0000,0000,,Баланың ұпайы бар.
Dialogue: 0,0:05:07.93,0:05:08.93,Top,,0000,0000,0000,,‎(Киви) Әрине
Dialogue: 0,0:05:09.01,0:05:11.18,Bottom,,0000,0000,0000,,Өткір, балақай!
Dialogue: 0,0:05:09.01,0:05:11.26,Top,,0000,0000,0000,,Бұл пайдалы емес пе?
Dialogue: 0,0:05:11.26,0:05:14.35,Bottom,,0000,0000,0000,,Енді сен еркексің!
Dialogue: 0,0:05:11.35,0:05:13.89,Top,,0000,0000,0000,,‎Күтілгендей, терісі жұлынған адам қателеседі. Эй!
Dialogue: 0,0:05:13.98,0:05:14.81,Top,,0000,0000,0000,,‎(тықылдаған дыбыс)
Dialogue: 0,0:05:14.85,0:05:17.44,Bottom,,0000,0000,0000,,Не? Бірдеңе болды ма?
Dialogue: 0,0:05:14.89,0:05:18.44,Top,,0000,0000,0000,,‎(Киви) Сіз не туралы айтып тұрсыз? былғары? Кез келген нәрсе...
Dialogue: 0,0:05:17.52,0:05:18.69,Bottom,,0000,0000,0000,,Ештеңе!
Dialogue: 0,0:05:19.31,0:05:22.44,Bottom,,0000,0000,0000,,Фарадей Танаканы жеңіп шықты.
Dialogue: 0,0:05:19.40,0:05:22.53,Top,,0000,0000,0000,,Фарадей Танаканың әрекетінен айласын асырды.
Dialogue: 0,0:05:22.53,0:05:25.82,Bottom,,0000,0000,0000,,Біздің сүйікті костюміміз әлсін-әлсін бас тартатын сияқты
Dialogue: 0,0:05:22.61,0:05:25.95,Top,,0000,0000,0000,,Оның кей кездері күзетсіз шығып тұратыны даусыз.
Dialogue: 0,0:05:25.90,0:05:28.07,Bottom,,0000,0000,0000,,және Деламанға арналған әдеттегі сапар.
Dialogue: 0,0:05:26.03,0:05:28.07,Top,,0000,0000,0000,,‎Сіз Деламанның қызметін пайдаланып жатқан сияқтысыз.
Dialogue: 0,0:05:28.16,0:05:29.99,Bottom,,0000,0000,0000,,Радардан тыс бару, иә?
Dialogue: 0,0:05:28.16,0:05:30.03,Top,,0000,0000,0000,,Инкогнито, солай ма?
Dialogue: 0,0:05:30.07,0:05:33.79,Bottom,,0000,0000,0000,,Бірақ Деламан оны толығымен қамтыды. Баратын жерін әлі анықтай алмай отыр.
Dialogue: 0,0:05:30.12,0:05:32.08,Top,,0000,0000,0000,,Деламанның күзетшісі мықты.
Dialogue: 0,0:05:32.16,0:05:33.83,Top,,0000,0000,0000,,Мен қайда бара жатқанымды білмеймін
Dialogue: 0,0:05:33.87,0:05:37.71,Bottom,,0000,0000,0000,,Мен сондай-ақ BD үшін баптау қызметтерін қарастырдым.
Dialogue: 0,0:05:33.91,0:05:37.37,Top,,0000,0000,0000,,‎(Киви) BD тюнингі Мен де қызметті қарап шықтым.
Dialogue: 0,0:05:37.79,0:05:42.30,Bottom,,0000,0000,0000,,Негізгі сатып алушылар - семіз мысықтар, корпус басшылары, атақты адамдар, банда бастықтары ...
Dialogue: 0,0:05:37.87,0:05:42.38,Top,,0000,0000,0000,,Тапсырыс беруші - корпорацияның атқарушы директоры, Celebrity Gang басшысы
Dialogue: 0,0:05:42.38,0:05:45.05,Bottom,,0000,0000,0000,,Сіз жолдама арқылы кіресіз және орналасқан жері белгісіз.
Dialogue: 0,0:05:42.46,0:05:45.13,Top,,0000,0000,0000,,‎Таныстыру жүйесі, студияның орналасқан жері жарияланбады
Dialogue: 0,0:05:45.13,0:05:48.26,Bottom,,0000,0000,0000,,Егер біз көбірек білгіміз келсе, ол адамның өзімен сөйлесуіміз керек.
Dialogue: 0,0:05:45.21,0:05:48.34,Top,,0000,0000,0000,,Толығырақ мәлімет алу үшін сіз JK-тің өзінен сұрауыңыз керек.
Dialogue: 0,0:05:48.34,0:05:49.64,Bottom,,0000,0000,0000,,Қалай?
Dialogue: 0,0:05:48.43,0:05:49.68,Top,,0000,0000,0000,,Қалай?
Dialogue: 0,0:05:49.72,0:05:51.35,Bottom,,0000,0000,0000,,Оны жеке ұстау керек.
Dialogue: 0,0:05:49.76,0:05:51.35,Top,,0000,0000,0000,,‎Жеке кездесіп, сөйлесіңіз
Dialogue: 0,0:05:51.43,0:05:52.68,Top,,0000,0000,0000,,‎(Киви) Жақсы уақыт
Dialogue: 0,0:05:51.93,0:05:57.44,Bottom,,0000,0000,0000,,Бақытымызға орай, оның ертең Эмберсте тапсырысы бар. Ол жалғыз болады.
Dialogue: 0,0:05:52.76,0:05:55.27,Top,,0000,0000,0000,,Менде ертең Эмберс деген клубқа тапсырыс бар.
Dialogue: 0,0:05:55.77,0:05:57.52,Top,,0000,0000,0000,,‎Тек бір адам
Dialogue: 0,0:05:57.52,0:05:59.35,Bottom,,0000,0000,0000,,Осындай ырықты жерде ме? Қайғылы.
Dialogue: 0,0:05:57.60,0:05:58.94,Top,,0000,0000,0000,,Мен сені сағындым.
Dialogue: 0,0:05:59.44,0:06:02.86,Bottom,,0000,0000,0000,,Керемет. Ол кеткенде, оны осында түнгі шайға шақырайық.
Dialogue: 0,0:05:59.44,0:06:02.86,Top,,0000,0000,0000,,‎Онда мен сені үйге қайтар жолда осында шақырамын.
Dialogue: 0,0:06:03.44,0:06:05.28,Bottom,,0000,0000,0000,,Вент одан әрі ашылмауына қол жеткіздік.
Dialogue: 0,0:06:03.57,0:06:05.11,Top,,0000,0000,0000,,Әдепті болыңыз
Dialogue: 0,0:06:09.20,0:06:10.95,Top,,0000,0000,0000,,‎(Holo Communication: Люси) Мен дүкеннен жаңа ғана шықтым.
Dialogue: 0,0:06:11.03,0:06:12.16,Top,,0000,0000,0000,,Түсінді
Dialogue: 0,0:06:22.21,0:06:24.63,Top,,0000,0000,0000,,‎(көліктің жүгіру дыбысы)
Dialogue: 0,0:06:30.93,0:06:33.01,Top,,0000,0000,0000,,Иә? Ах... Ах!
Dialogue: 0,0:06:33.72,0:06:37.52,Bottom,,0000,0000,0000,,Сәлем! Сіз Джимми Куросаки болмас едіңіз, солай ма?
Dialogue: 0,0:06:33.81,0:06:35.47,Top,,0000,0000,0000,,Бұл! Мүмкін
Dialogue: 0,0:06:35.56,0:06:37.52,Top,,0000,0000,0000,,Бұл Джимми Куросаки емес пе?
Dialogue: 0,0:06:38.98,0:06:39.94,Bottom,,0000,0000,0000,,Кім сұрап жатыр?
Dialogue: 0,0:06:39.10,0:06:40.02,Top,,0000,0000,0000,,‎(JK) Сіз ше?
Dialogue: 0,0:06:40.02,0:06:42.44,Bottom,,0000,0000,0000,,Мен оны білдім! Мен үлкен жанкүйермін, сэр!
Dialogue: 0,0:06:40.10,0:06:42.56,Top,,0000,0000,0000,,‎Күтілгендей! Мүлдем!
Dialogue: 0,0:06:42.52,0:06:46.90,Bottom,,0000,0000,0000,,Арройодағы XBD құрылғыларын итеретін рипердокты білесіз бе?
Dialogue: 0,0:06:42.65,0:06:43.82,Top,,0000,0000,0000,,Мен үлкен жанкүйермін
Dialogue: 0,0:06:43.90,0:06:46.90,Top,,0000,0000,0000,,Мен Арройодағы артқы BD-мен жұмыс істеп жатырмын. Липпардок бар.
Dialogue: 0,0:06:46.98,0:06:50.28,Bottom,,0000,0000,0000,,Мен оған заттарыңды сатуға көмектестім!
Dialogue: 0,0:06:46.98,0:06:50.36,Top,,0000,0000,0000,,Осы көмектің көмегімен мен сіздің BD-леріңізді саттым.
Dialogue: 0,0:06:50.36,0:06:51.28,Bottom,,0000,0000,0000,,Шынымен.
Dialogue: 0,0:06:50.45,0:06:51.28,Top,,0000,0000,0000,,Иә
Dialogue: 0,0:06:51.36,0:06:53.66,Bottom,,0000,0000,0000,,Қолыңды қыссам болады ма?
Dialogue: 0,0:06:51.36,0:06:54.53,Top,,0000,0000,0000,,‎Қолымды қысыңыз...
Dialogue: 0,0:06:53.74,0:06:58.66,Bottom,,0000,0000,0000,,Ой, кешіріңіз... Мен біраз жұлдызды болдым.
Dialogue: 0,0:06:54.62,0:06:58.75,Top,,0000,0000,0000,,‎Аа... Ахаха! Мен қатты толқып тұрмын
Dialogue: 0,0:06:58.75,0:07:00.54,Bottom,,0000,0000,0000,,Иә, менде болатын жерлер бар.
Dialogue: 0,0:06:58.83,0:07:00.54,Top,,0000,0000,0000,,Кешіріңіз, бірақ мен қазір кетемін.
Dialogue: 0,0:07:00.62,0:07:02.29,Top,,0000,0000,0000,,Иә...
Dialogue: 0,0:07:00.62,0:07:03.04,Bottom,,0000,0000,0000,,Дұрыс... Мен сені ұстамаймын.
Dialogue: 0,0:07:02.38,0:07:04.63,Top,,0000,0000,0000,,‎Танысқаныма қуаныштымын.
Dialogue: 0,0:07:03.13,0:07:05.00,Bottom,,0000,0000,0000,,Сізбен кездесу құрметті болды…
Dialogue: 0,0:07:05.71,0:07:06.88,Top,,0000,0000,0000,,‎(теру айналдыру дыбысы)
Dialogue: 0,0:07:14.47,0:07:15.97,Top,,0000,0000,0000,,‎Ух... күте тұрыңыз, не?
Dialogue: 0,0:07:14.85,0:07:16.31,Bottom,,0000,0000,0000,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:07:16.06,0:07:16.93,Top,,0000,0000,0000,,‎(қозғалтқыштың іске қосылу дыбысы)
Dialogue: 0,0:07:16.93,0:07:17.68,Top,,0000,0000,0000,,‎(қозғалтқыштың іске қосу дыбысы) (киви)
Dialogue: 0,0:07:17.77,0:07:19.93,Top,,0000,0000,0000,,‎(Көліктің жүгірген дыбысы) Иә!
Dialogue: 0,0:07:20.02,0:07:21.19,Bottom,,0000,0000,0000,,Бля!
Dialogue: 0,0:07:20.02,0:07:21.19,Top,,0000,0000,0000,,Жаман!
Dialogue: 0,0:07:22.10,0:07:23.23,Bottom,,0000,0000,0000,,Сабаққа қатыса алмайтыны үшін оған ерекше қарайды...
Dialogue: 0,0:07:22.10,0:07:23.23,Top,,0000,0000,0000,,‎(Люси) Иә?
Dialogue: 0,0:07:23.81,0:07:25.31,Top,,0000,0000,0000,,‎Негізгі!
Dialogue: 0,0:07:23.81,0:07:25.73,Bottom,,0000,0000,0000,,Мэн!
Dialogue: 0,0:07:25.82,0:07:27.48,Top,,0000,0000,0000,,‎(Киви) Дэвид ше?
Dialogue: 0,0:07:26.32,0:07:27.44,Bottom,,0000,0000,0000,,Дэвид қайда?
Dialogue: 0,0:07:27.53,0:07:28.99,Bottom,,0000,0000,0000,,Оны табыңыз!
Dialogue: 0,0:07:27.57,0:07:28.65,Top,,0000,0000,0000,,Оны іздеңіз!
Dialogue: 0,0:07:29.07,0:07:30.61,Bottom,,0000,0000,0000,,Одан құтыл!
Dialogue: 0,0:07:29.15,0:07:30.24,Top,,0000,0000,0000,,Кішкене негізгі
Dialogue: 0,0:07:33.95,0:07:34.74,Top,,0000,0000,0000,,О!
Dialogue: 0,0:07:35.83,0:07:37.16,Bottom,,0000,0000,0000,,Амансың ба?
Dialogue: 0,0:07:35.83,0:07:37.16,Top,,0000,0000,0000,,Амансың ба?
Dialogue: 0,0:07:37.24,0:07:40.20,Top,,0000,0000,0000,,Мына бейбақ не істеді?
Dialogue: 0,0:07:37.24,0:07:40.25,Bottom,,0000,0000,0000,,Қаншық баласы бізді бірдеңе тартты.
Dialogue: 0,0:07:41.00,0:07:42.50,Bottom,,0000,0000,0000,,Не болды?
Dialogue: 0,0:07:41.08,0:07:42.46,Top,,0000,0000,0000,,Не болды?
Dialogue: 0,0:07:42.54,0:07:45.25,Top,,0000,0000,0000,,‎(Киви) Күткендей ол жоқ. (Люси) солай емес пе?
Dialogue: 0,0:07:42.58,0:07:44.33,Bottom,,0000,0000,0000,,Олар кетті.
Dialogue: 0,0:07:44.42,0:07:45.25,Bottom,,0000,0000,0000,,кетті ме?
Dialogue: 0,0:07:45.88,0:07:48.00,Bottom,,0000,0000,0000,,Ол Дәуітті ұстап алды.
Dialogue: 0,0:07:45.88,0:07:48.00,Top,,0000,0000,0000,,‎Дэвидті алып кеткен сияқты.
Dialogue: 0,0:07:49.17,0:07:51.80,Bottom,,0000,0000,0000,,Киви! Сен Мэнді алып шығып кет.
Dialogue: 0,0:07:49.26,0:07:51.88,Top,,0000,0000,0000,,‎Киви Мейнді өзіңізбен бірге алыңыз. Оны бір рет тартыңыз
Dialogue: 0,0:07:51.88,0:07:53.01,Bottom,,0000,0000,0000,,Алдымен, ортаңғы және көрсеткі саусақтарыңызды осылайша қосыңыз,
Dialogue: 0,0:07:51.97,0:07:53.01,Top,,0000,0000,0000,,‎(Киви) Түсіндім.
Dialogue: 0,0:07:53.09,0:07:54.34,Top,,0000,0000,0000,,Менде бәрі жақсы...
Dialogue: 0,0:07:53.09,0:07:54.72,Bottom,,0000,0000,0000,,Менде бәрі жақсы...
Dialogue: 0,0:07:54.43,0:07:56.76,Top,,0000,0000,0000,,‎Жарайды, сенің де қайтуың керек!
Dialogue: 0,0:07:54.80,0:07:56.76,Bottom,,0000,0000,0000,,Жақсы бала бол, қал!
Dialogue: 0,0:07:56.85,0:07:58.81,Top,,0000,0000,0000,,Люси, менімен бірге жүр.
Dialogue: 0,0:07:56.85,0:07:59.02,Bottom,,0000,0000,0000,,Люси! Сен менімен біргесің.
Dialogue: 0,0:07:58.89,0:07:59.56,Top,,0000,0000,0000,,Иә
Dialogue: 0,0:08:07.65,0:08:09.90,Top,,0000,0000,0000,,‎(Люси) Мен сонда болдым, 2 шақырым жерде.
Dialogue: 0,0:08:07.65,0:08:11.32,Bottom,,0000,0000,0000,,Оны түсіндім. Миль және өзгеріңіз, тура алға.
Dialogue: 0,0:08:09.98,0:08:11.32,Top,,0000,0000,0000,,Жалғастырыңыз
Dialogue: 0,0:08:11.40,0:08:13.99,Bottom,,0000,0000,0000,,Әлгі ессіз сол жерде не пайдаланды?
Dialogue: 0,0:08:11.40,0:08:14.03,Top,,0000,0000,0000,,‎Ол бұрын не пайдаланды?
Dialogue: 0,0:08:14.07,0:08:15.91,Bottom,,0000,0000,0000,,Бір ҚОҚБ сияқты көрінді.
Dialogue: 0,0:08:14.11,0:08:15.91,Top,,0000,0000,0000,,Мүмкін ҚОҚБ.
Dialogue: 0,0:08:15.99,0:08:17.62,Top,,0000,0000,0000,,‎Киви де құсып жатты
Dialogue: 0,0:08:15.99,0:08:20.83,Bottom,,0000,0000,0000,,Бұл кивиге қатты әсер етті. Мені сәл ғана сілкіндірді.
Dialogue: 0,0:08:17.70,0:08:20.83,Top,,0000,0000,0000,,Менің денем аздап қыши бастады.
Dialogue: 0,0:08:20.91,0:08:23.66,Top,,0000,0000,0000,,Бұл нейрондық имплантқа әсер етті.
Dialogue: 0,0:08:20.91,0:08:26.08,Bottom,,0000,0000,0000,,Нейрондық импланттың мақсаттылығы. Жүгірушілерді бейтараптандыру үшін, анық.
Dialogue: 0,0:08:24.21,0:08:26.08,Top,,0000,0000,0000,,Жүгіруші көбірек зиян келтіреді
Dialogue: 0,0:08:26.17,0:08:27.50,Top,,0000,0000,0000,,Сіз ше?
Dialogue: 0,0:08:26.67,0:08:27.63,Bottom,,0000,0000,0000,,Сіз жақсы сияқтысыз.
Dialogue: 0,0:08:27.59,0:08:31.46,Top,,0000,0000,0000,,‎(Люси) Біз бөлек болғаннан бері... Мен қазір Дэвид үшін көбірек уайымдап жүрмін.
Dialogue: 0,0:08:27.71,0:08:28.71,Bottom,,0000,0000,0000,,Мен аумақта болмадым.
Dialogue: 0,0:08:29.42,0:08:31.46,Bottom,,0000,0000,0000,,Дэвид нағыз боқта болуы мүмкін.
Dialogue: 0,0:08:31.55,0:08:33.84,Bottom,,0000,0000,0000,,Егер ол оны қайта пайдаланса, бұл мәселе болады.
Dialogue: 0,0:08:31.55,0:08:33.84,Top,,0000,0000,0000,,Бірақ егер сіз оны пайдалансаңыз, бұл қиын болар еді.
Dialogue: 0,0:08:33.93,0:08:36.22,Bottom,,0000,0000,0000,,Оны бірінші өлтірсек емес.
Dialogue: 0,0:08:33.93,0:08:36.22,Top,,0000,0000,0000,,Оны қолданбас бұрын орындаңыз
Dialogue: 0,0:08:37.72,0:08:39.22,Top,,0000,0000,0000,,Сіз ашулысыз ба?
Dialogue: 0,0:08:37.76,0:08:39.22,Bottom,,0000,0000,0000,,Сен ашулысың, солай ма?
Dialogue: 0,0:08:39.81,0:08:41.10,Top,,0000,0000,0000,,‎(Люси) Кішкене.
Dialogue: 0,0:08:39.81,0:08:41.27,Bottom,,0000,0000,0000,,Аз.
Dialogue: 0,0:08:46.40,0:08:48.15,Top,,0000,0000,0000,,‎Мм... Уф...
Dialogue: 0,0:08:51.53,0:08:52.24,Top,,0000,0000,0000,,А...
Dialogue: 0,0:08:53.19,0:08:54.11,Top,,0000,0000,0000,,Ух...
Dialogue: 0,0:08:55.66,0:08:57.53,Top,,0000,0000,0000,,‎(Шыбындардың дыбысы)
Dialogue: 0,0:08:57.62,0:08:58.32,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:59.08,0:09:01.29,Top,,0000,0000,0000,,Уау! О!
Dialogue: 0,0:09:02.58,0:09:03.25,Top,,0000,0000,0000,,Е...
Dialogue: 0,0:09:08.29,0:09:09.92,Top,,0000,0000,0000,,А, ха!
Dialogue: 0,0:09:09.96,0:09:11.50,Bottom,,0000,0000,0000,,А, бля.
Dialogue: 0,0:09:10.00,0:09:13.88,Top,,0000,0000,0000,,(Полиция қызметкері А) Бұл қорқынышты. Бұл киберпсихоның жұмысы ғой.
Dialogue: 0,0:09:11.59,0:09:13.71,Bottom,,0000,0000,0000,,Бұл киберпсихо деп ойлайсыз ба?
Dialogue: 0,0:09:13.80,0:09:18.34,Bottom,,0000,0000,0000,,Ештеңе жоқ, сыртқа шығайық. Қазірдің өзінде MaxTac құттықтады.
Dialogue: 0,0:09:13.97,0:09:18.22,Top,,0000,0000,0000,,(Полиция қызметкері В) Ой, қалғанын MaxTac()-ға қалдырып, кері қайтайық.
Dialogue: 0,0:09:19.97,0:09:21.51,Top,,0000,0000,0000,,(Полиция қызметкері А) Эй, мұнда да өлі дене бар.
Dialogue: 0,0:09:20.10,0:09:21.51,Bottom,,0000,0000,0000,,Эй, тағы бір дене бар.
Dialogue: 0,0:09:21.60,0:09:22.93,Top,,0000,0000,0000,,‎(Полиция қызметкері В) Барма.
Dialogue: 0,0:09:22.18,0:09:25.02,Bottom,,0000,0000,0000,,Кетпе, адам. Егер сіз оларға тап болсаңыз ше?
Dialogue: 0,0:09:23.02,0:09:25.02,Top,,0000,0000,0000,,Психомен кездессеңіз не істеу керек?
Dialogue: 0,0:09:25.10,0:09:25.81,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:25.60,0:09:28.06,Bottom,,0000,0000,0000,,Уайымдамаңыз. Олар енді жоқ.
Dialogue: 0,0:09:28.15,0:09:29.65,Top,,0000,0000,0000,,‎Хаа… Кук
Dialogue: 0,0:09:29.61,0:09:31.52,Bottom,,0000,0000,0000,,Хм? Кім бар?!
Dialogue: 0,0:09:29.73,0:09:31.52,Top,,0000,0000,0000,,‎(Полиция қызметкері А) Иә? Ол кім?
Dialogue: 0,0:09:31.61,0:09:32.86,Bottom,,0000,0000,0000,,Киберпсихо!
Dialogue: 0,0:09:31.61,0:09:34.03,Top,,0000,0000,0000,,‎(Полиция қызметкері В) Киберпсихо! (Полиция қызметкері А) Оның мылтығы бар.
Dialogue: 0,0:09:32.94,0:09:34.03,Bottom,,0000,0000,0000,,Оның мылтығы бар!
Dialogue: 0,0:09:34.11,0:09:34.86,Top,,0000,0000,0000,,Мен емес
Dialogue: 0,0:09:34.11,0:09:35.61,Bottom,,0000,0000,0000,,-Мен емес едім... -Мылтықты таста!
Dialogue: 0,0:09:34.94,0:09:36.70,Top,,0000,0000,0000,,‎(Полиция қызметкері А) Мылтығыңызды лақтырыңыз ‎(Полиция қызметкері В) Қозғалмаңыз!
Dialogue: 0,0:09:35.70,0:09:36.82,Bottom,,0000,0000,0000,,Қозғалмаңыз!
Dialogue: 0,0:09:36.78,0:09:37.53,Top,,0000,0000,0000,,Мен осында екенімді білгенде...
Dialogue: 0,0:09:36.90,0:09:39.78,Bottom,,0000,0000,0000,,-Мен оянып кеттім, мен жай ғана... -Таста оны, психо!
Dialogue: 0,0:09:37.53,0:09:38.36,Top,,0000,0000,0000,,‎Мен осында екенімді түсінгенде... (Полиция қызметкері) Қарғыс атқыр киберпсихо!
Dialogue: 0,0:09:38.36,0:09:38.57,Top,,0000,0000,0000,,Қарғыс атқыр киберпсихо!
Dialogue: 0,0:09:38.66,0:09:39.78,Top,,0000,0000,0000,,‎(Мылтық дыбысы) ‎Уау!
Dialogue: 0,0:09:39.87,0:09:42.79,Top,,0000,0000,0000,,‎(Полиция қызметкері А/Б) Уф! (Полиция қызметкерінің құлаған дыбысы)
Dialogue: 0,0:09:43.62,0:09:44.91,Bottom,,0000,0000,0000,,Кім бар?!
Dialogue: 0,0:09:43.66,0:09:46.41,Top,,0000,0000,0000,,‎(Полиция қызметкері) Бұл кім? (Полиция қызметкері) Эй, кім болды?
Dialogue: 0,0:09:45.00,0:09:46.41,Bottom,,0000,0000,0000,,Сәлем! Не болды?!
Dialogue: 0,0:09:46.50,0:09:47.42,Top,,0000,0000,0000,,‎Ха ха…
Dialogue: 0,0:09:48.12,0:09:48.87,Top,,0000,0000,0000,,Ах!
Dialogue: 0,0:09:53.00,0:09:54.59,Bottom,,0000,0000,0000,,Киберпсихо болды!
Dialogue: 0,0:09:53.00,0:09:55.92,Top,,0000,0000,0000,,‎(Полиция қызметкері) Кибер психоз! (Полиция қызметкері) MaxTac-қа қоңырау шалыңыз!
Dialogue: 0,0:09:54.67,0:09:55.63,Bottom,,0000,0000,0000,,MaxTac-ты қазір көтеріңіз!
Dialogue: 0,0:09:59.14,0:10:01.80,Top,,0000,0000,0000,,Уау! Ах!
Dialogue: 0,0:10:01.89,0:10:04.06,Top,,0000,0000,0000,,‎Хаа һаа һаа…
Dialogue: 0,0:10:08.81,0:10:09.44,Top,,0000,0000,0000,,А...
Dialogue: 0,0:10:09.52,0:10:11.19,Top,,0000,0000,0000,,‎Grrrr…
Dialogue: 0,0:10:11.77,0:10:13.40,Top,,0000,0000,0000,,‎Ах... а
Dialogue: 0,0:10:15.11,0:10:16.69,Top,,0000,0000,0000,,‎(Полиция қызметкері) Саған тағы оқ тиді!
Dialogue: 0,0:10:15.19,0:10:16.99,Bottom,,0000,0000,0000,,Сол жерде оқ атылды!
Dialogue: 0,0:10:17.65,0:10:18.70,Top,,0000,0000,0000,,Өл, психо!
Dialogue: 0,0:10:17.65,0:10:19.45,Bottom,,0000,0000,0000,,Өл, бейбақ!
Dialogue: 0,0:10:18.78,0:10:19.45,Top,,0000,0000,0000,,‎(шу дыбысы)
Dialogue: 0,0:10:26.87,0:10:27.58,Top,,0000,0000,0000,,‎Блан…
Dialogue: 0,0:10:29.67,0:10:30.29,Top,,0000,0000,0000,,Уф!
Dialogue: 0,0:10:32.29,0:10:33.71,Top,,0000,0000,0000,,‎(Жакин!)
Dialogue: 0,0:10:33.79,0:10:34.55,Top,,0000,0000,0000,,А...
Dialogue: 0,0:10:40.26,0:10:41.01,Top,,0000,0000,0000,,‎Га
Dialogue: 0,0:10:42.30,0:10:44.51,Top,,0000,0000,0000,,Уау аа
Dialogue: 0,0:10:46.85,0:10:47.68,Top,,0000,0000,0000,,А...
Dialogue: 0,0:10:54.52,0:10:56.15,Top,,0000,0000,0000,,(AV ұшу дыбысы)
Dialogue: 0,0:10:57.03,0:10:58.19,Bottom,,0000,0000,0000,,MaxTac?!
Dialogue: 0,0:10:57.03,0:10:58.19,Top,,0000,0000,0000,,‎MaxTac
Dialogue: 0,0:11:01.78,0:11:02.62,Top,,0000,0000,0000,,Ах!
Dialogue: 0,0:11:05.45,0:11:06.37,Top,,0000,0000,0000,,Уф...
Dialogue: 0,0:11:06.45,0:11:08.08,Top,,0000,0000,0000,,‎(мылтық ату дыбысы)
Dialogue: 0,0:11:12.79,0:11:14.71,Top,,0000,0000,0000,,Гах! а?
Dialogue: 0,0:11:16.30,0:11:17.34,Top,,0000,0000,0000,,Уф...
Dialogue: 0,0:11:20.47,0:11:21.72,Bottom,,0000,0000,0000,,Құбыжық.
Dialogue: 0,0:11:20.51,0:11:21.72,Top,,0000,0000,0000,,Құбыжық
Dialogue: 0,0:11:21.80,0:11:23.97,Bottom,,0000,0000,0000,,Жоқ! Бұл мен емес едім!
Dialogue: 0,0:11:21.80,0:11:23.97,Top,,0000,0000,0000,,‎Жоқ, балалар!
Dialogue: 0,0:11:24.05,0:11:25.97,Top,,0000,0000,0000,,(Дыбыс жүктелуде)
Dialogue: 0,0:11:26.06,0:11:27.06,Top,,0000,0000,0000,,‎(мылтық дыбысы)
Dialogue: 0,0:11:27.14,0:11:28.06,Top,,0000,0000,0000,,Kah!
Dialogue: 0,0:11:28.14,0:11:32.31,Top,,0000,0000,0000,,‎Хаа ха ха ха ха ха...
Dialogue: 0,0:11:39.44,0:11:41.07,Bottom,,0000,0000,0000,,Керемет, солай емес пе?
Dialogue: 0,0:11:39.44,0:11:41.15,Top,,0000,0000,0000,,‎(JK) Керемет емес пе?
Dialogue: 0,0:11:41.15,0:11:44.82,Bottom,,0000,0000,0000,,Өзгенің өлімінің орнына өз өліміңді бастан кешіру.
Dialogue: 0,0:11:41.24,0:11:44.82,Top,,0000,0000,0000,,Біреудің өлімінен гөрі өз өліміңді бастан кешіру
Dialogue: 0,0:11:44.91,0:11:46.70,Top,,0000,0000,0000,,‎Иә... жай ғана әзіл.
Dialogue: 0,0:11:45.49,0:11:47.33,Bottom,,0000,0000,0000,,Сен мені қалжыңдап тұрсың ба?!
Dialogue: 0,0:11:47.91,0:11:49.12,Top,,0000,0000,0000,,Ең жақсысы?
Dialogue: 0,0:11:47.91,0:11:51.75,Bottom,,0000,0000,0000,,Керемет? Сен пысық психопат...
Dialogue: 0,0:11:49.87,0:11:51.29,Top,,0000,0000,0000,,Бұл... ең нашар.
Dialogue: 0,0:11:51.91,0:11:55.75,Top,,0000,0000,0000,,‎(JK) Хун, менің жанкүйерлерімнің арасында қауіпті адамдар көп.
Dialogue: 0,0:11:52.79,0:11:55.71,Bottom,,0000,0000,0000,,Эй, мен сені жанкүйер деп ойладым!
Dialogue: 0,0:11:55.79,0:11:58.09,Bottom,,0000,0000,0000,,Менің жанкүйерлерімнің көпшілігі керемет жұмыс істейді.
Dialogue: 0,0:11:55.84,0:11:58.09,Top,,0000,0000,0000,,Мен сені де солай деп ойладым.
Dialogue: 0,0:11:58.67,0:12:01.34,Bottom,,0000,0000,0000,,Сіз киберпанксыз, солай емес пе?
Dialogue: 0,0:11:58.67,0:12:01.34,Top,,0000,0000,0000,,‎Сендер киберпанктарға ұқсайсыңдар.
Dialogue: 0,0:12:01.92,0:12:03.18,Bottom,,0000,0000,0000,,Сіз не іздеп жүрсіз?
Dialogue: 0,0:12:01.92,0:12:05.76,Top,,0000,0000,0000,,Мақсаты не? Осындай жерде күту
Dialogue: 0,0:12:03.26,0:12:05.72,Bottom,,0000,0000,0000,,Мені осындай жерде тұтқындау...
Dialogue: 0,0:12:06.43,0:12:10.60,Bottom,,0000,0000,0000,,Үй тапсырмасын орындадыңдар. Сіз менің басқа жұмыстарымды көрдіңіз бе?
Dialogue: 0,0:12:06.55,0:12:08.31,Top,,0000,0000,0000,,Сіз маған қарадыңыз, солай ма?
Dialogue: 0,0:12:08.85,0:12:10.60,Top,,0000,0000,0000,,Сіз BD көрмедіңіз бе?
Dialogue: 0,0:12:10.68,0:12:12.94,Top,,0000,0000,0000,,Edge Runner сериясы және т.б.
Dialogue: 0,0:12:10.68,0:12:13.23,Bottom,,0000,0000,0000,,Эдгеруннер сериясы?
Dialogue: 0,0:12:14.02,0:12:15.10,Bottom,,0000,0000,0000,,Оқу, оқу
Dialogue: 0,0:12:14.15,0:12:15.10,Top,,0000,0000,0000,,О
Dialogue: 0,0:12:15.19,0:12:15.98,Top,,0000,0000,0000,,‎(JK) Иә?
Dialogue: 0,0:12:16.02,0:12:18.61,Bottom,,0000,0000,0000,,Мен сіздің заттарыңыздың көбін көрдім.
Dialogue: 0,0:12:16.06,0:12:18.61,Top,,0000,0000,0000,,Мен сіздің шығармаларыңызды көп көремін.
Dialogue: 0,0:12:19.32,0:12:21.61,Bottom,,0000,0000,0000,,Уау. Мен мақтандым!
Dialogue: 0,0:12:19.48,0:12:21.49,Top,,0000,0000,0000,,‎(JK) О, мен өте қуаныштымын.
Dialogue: 0,0:12:23.90,0:12:29.49,Bottom,,0000,0000,0000,,Айтыңызшы, сіз мен бұл киберпсихика шиыршықтарын қайдан аламын деп ойладыңыз ба?
Dialogue: 0,0:12:23.99,0:12:25.66,Top,,0000,0000,0000,,‎(JK) Неге мен?
Dialogue: 0,0:12:25.74,0:12:29.49,Top,,0000,0000,0000,,Сіз киберпсихоздың BD жасай алатыныңызды білесіз бе?
Dialogue: 0,0:12:29.58,0:12:30.79,Bottom,,0000,0000,0000,,Жер
Dialogue: 0,0:12:29.58,0:12:30.79,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:30.87,0:12:32.87,Top,,0000,0000,0000,,‎(JK) әскери прототипі имплантанттар
Dialogue: 0,0:12:30.87,0:12:36.75,Bottom,,0000,0000,0000,,Барлық әскери прототиптер кіріктірілген брейнденс айналдыруымен бірге келеді.
Dialogue: 0,0:12:32.96,0:12:36.75,Top,,0000,0000,0000,,‎Деректерді жинау үшін ‎Ол BD жазғышымен бірге жеткізіледі.
Dialogue: 0,0:12:36.83,0:12:38.63,Top,,0000,0000,0000,,‎Ақшаң болғанша
Dialogue: 0,0:12:37.33,0:12:42.01,Bottom,,0000,0000,0000,,Кейбір адамдар мұндай нәрселер үшін мұрын арқылы төлеуге дайын.
Dialogue: 0,0:12:38.71,0:12:42.01,Top,,0000,0000,0000,,‎Осындай деректерді де бере алатын біреу бар.
Dialogue: 0,0:12:45.22,0:12:48.26,Bottom,,0000,0000,0000,,Сіз бұл Сэндидің кімге тиесілі екенін білесіз бе?
Dialogue: 0,0:12:45.30,0:12:48.26,Top,,0000,0000,0000,,‎Сіз мұның бұрынғы иесін білесіз бе?
Dialogue: 0,0:12:48.85,0:12:53.14,Top,,0000,0000,0000,,Джеймс Норрис корпоративтік ғимаратта 27 адамды өлтірді.
Dialogue: 0,0:12:48.85,0:12:53.18,Bottom,,0000,0000,0000,,Джеймс Норрис. Соңында ол қанша адамды өлтірді? 27?
Dialogue: 0,0:12:53.23,0:12:56.77,Top,,0000,0000,0000,,‎Соңында MaxTac-пен қиян-кескі шайқас болыңыз.
Dialogue: 0,0:12:53.27,0:12:56.77,Bottom,,0000,0000,0000,,Соңында MaxTac-пен төбелес болды.
Dialogue: 0,0:12:57.40,0:12:59.40,Top,,0000,0000,0000,,‎Ал, MaxTac арқылы——
Dialogue: 0,0:12:57.44,0:13:02.90,Bottom,,0000,0000,0000,,Олармен аяғына дейін баратын жігіт жиі бола бермейді.
Dialogue: 0,0:12:59.48,0:13:02.90,Top,,0000,0000,0000,,‎Мұны жақсы жасай алатын адамдар өте аз.
Dialogue: 0,0:13:02.99,0:13:04.70,Top,,0000,0000,0000,,‎Бұл жақсы болды~
Dialogue: 0,0:13:02.99,0:13:07.62,Bottom,,0000,0000,0000,,Бұл өте жақсы болды… Мен біраз уақыттан бері көрген ең жақсылардың бірі.
Dialogue: 0,0:13:04.78,0:13:07.57,Top,,0000,0000,0000,,Жақында ол ең жақсы болды.
Dialogue: 0,0:13:10.24,0:13:13.62,Bottom,,0000,0000,0000,,Мен де сенен үлкен үміт күтемін.
Dialogue: 0,0:13:10.37,0:13:13.20,Top,,0000,0000,0000,,‎Мен де саған үлкен үміт артамын~
Dialogue: 0,0:13:13.70,0:13:17.75,Bottom,,0000,0000,0000,,Осыны кигеннен кейін әлі де есі дұрыс екеніне таң қалдым.
Dialogue: 0,0:13:13.70,0:13:17.75,Top,,0000,0000,0000,,‎Мен сіздің әлі де есі дұрыс екеніне таң қалдым.
Dialogue: 0,0:13:17.83,0:13:21.38,Bottom,,0000,0000,0000,,Жанама әсерлер, сайып келгенде, сізді ақылсыз етеді.
Dialogue: 0,0:13:17.83,0:13:21.38,Top,,0000,0000,0000,,‎Реакция сізді есінен тануы мүмкін.
Dialogue: 0,0:13:21.46,0:13:23.84,Bottom,,0000,0000,0000,,Оны көруді шыдамаймын.
Dialogue: 0,0:13:21.46,0:13:23.84,Top,,0000,0000,0000,,Мен не болатынын асыға күтемін.
Dialogue: 0,0:13:23.92,0:13:26.38,Bottom,,0000,0000,0000,,Мен психикаға бармаймын!
Dialogue: 0,0:13:23.92,0:13:26.38,Top,,0000,0000,0000,,Мен киберпсихо болмаймын!
Dialogue: 0,0:13:26.47,0:13:30.64,Bottom,,0000,0000,0000,,Барлық хромерлер осылай дейді.
Dialogue: 0,0:13:26.47,0:13:30.64,Top,,0000,0000,0000,,Мен киберпсихо болғанға дейін бәрі осылай айтқан.
Dialogue: 0,0:13:30.72,0:13:33.89,Bottom,,0000,0000,0000,,Олар ақыл-есі дұрыс емес деп санайды.
Dialogue: 0,0:13:30.72,0:13:33.89,Top,,0000,0000,0000,,Мен өзіммен жақсымын.
Dialogue: 0,0:13:33.97,0:13:34.89,Bottom,,0000,0000,0000,,Мен емес!
Dialogue: 0,0:13:33.97,0:13:34.89,Top,,0000,0000,0000,,Мен басқамын!
Dialogue: 0,0:13:34.98,0:13:36.39,Bottom,,0000,0000,0000,,Иә, сіз.
Dialogue: 0,0:13:34.98,0:13:36.39,Top,,0000,0000,0000,,‎Жынды қоян
Dialogue: 0,0:13:36.98,0:13:39.86,Top,,0000,0000,0000,,Тағы бірнеше рет ‎Егер MaxTac мені өлтірсе
Dialogue: 0,0:13:36.98,0:13:42.15,Bottom,,0000,0000,0000,,MaxTac-пен тағы бір жұп айналады және сіздің миыңыз шар сияқты жарылады.
Dialogue: 0,0:13:39.94,0:13:41.61,Top,,0000,0000,0000,,Сіз сындырасыз
Dialogue: 0,0:13:42.23,0:13:43.73,Top,,0000,0000,0000,,(JK ызылдап)
Dialogue: 0,0:13:43.73,0:13:47.49,Top,,0000,0000,0000,,Сәлем, күте тұрыңыз. Сіз мені тағы да солай істеуді жоспарлап отырсыз ба?
Dialogue: 0,0:13:43.73,0:13:47.74,Bottom,,0000,0000,0000,,Күтіңіз. Сіз мені бұлай бастан өткере алмайсыз...
Dialogue: 0,0:13:47.49,0:13:48.91,Top,,0000,0000,0000,,(JK ызылдап)
Dialogue: 0,0:13:48.99,0:13:50.78,Bottom,,0000,0000,0000,,Эй, тоқта!
Dialogue: 0,0:13:48.99,0:13:51.91,Top,,0000,0000,0000,,Ей, тоқта! Күте тұрыңыз!
Dialogue: 0,0:13:50.87,0:13:51.91,Bottom,,0000,0000,0000,,Оны кесіп тастаңыз!
Dialogue: 0,0:13:51.99,0:13:53.91,Bottom,,0000,0000,0000,,Юкине-кун
Dialogue: 0,0:13:51.99,0:13:53.91,Top,,0000,0000,0000,,Тоқта!
Dialogue: 0,0:13:56.16,0:13:56.79,Top,,0000,0000,0000,,Әй?
Dialogue: 0,0:13:58.54,0:13:59.46,Top,,0000,0000,0000,,Қозғалмаңыз!
Dialogue: 0,0:13:58.58,0:13:59.46,Bottom,,0000,0000,0000,,Қозғалмаңыз!
Dialogue: 0,0:14:02.13,0:14:03.21,Top,,0000,0000,0000,,‎(мылтық дыбысы)
Dialogue: 0,0:14:03.96,0:14:05.05,Top,,0000,0000,0000,,‎(Люси) Қолыңызды көтеріңіз.
Dialogue: 0,0:14:04.05,0:14:05.46,Bottom,,0000,0000,0000,,Қолдарыңызды жоғары қойыңыз...
Dialogue: 0,0:14:06.05,0:14:06.84,Top,,0000,0000,0000,,Мен сені өлтіремін
Dialogue: 0,0:14:06.05,0:14:07.22,Bottom,,0000,0000,0000,,Немесе сен өлдің.
Dialogue: 0,0:14:07.93,0:14:08.97,Top,,0000,0000,0000,,Беру
Dialogue: 0,0:14:07.93,0:14:09.47,Bottom,,0000,0000,0000,,Сіз мені түсіндіңіз!
Dialogue: 0,0:14:10.05,0:14:12.47,Top,,0000,0000,0000,,‎Хааааааааааааааааааааааа
Dialogue: 0,0:14:12.56,0:14:13.56,Top,,0000,0000,0000,,Ха!
Dialogue: 0,0:14:14.18,0:14:15.22,Top,,0000,0000,0000,,‎Дэвид туралы не деуге болады?
Dialogue: 0,0:14:14.39,0:14:15.22,Bottom,,0000,0000,0000,,Дэвидтің жағдайы қалай?
Dialogue: 0,0:14:15.31,0:14:17.02,Bottom,,0000,0000,0000,,Ол BD немесе басқа нәрседе.
Dialogue: 0,0:14:15.31,0:14:17.23,Top,,0000,0000,0000,,‎(Люси) Олар маған BD немесе бір нәрсе көрсетіп жатыр.
Dialogue: 0,0:14:17.10,0:14:18.98,Bottom,,0000,0000,0000,,-Сіз оны шығара аласыз ба? -Мен тырысамын.
Dialogue: 0,0:14:17.31,0:14:18.98,Top,,0000,0000,0000,,‎Оны тоқтатуға болады деп ойлайсыз ба? (Люси) Мүмкін
Dialogue: 0,0:14:19.56,0:14:20.65,Bottom,,0000,0000,0000,,Қол керек пе?
Dialogue: 0,0:14:19.60,0:14:21.77,Top,,0000,0000,0000,,‎(JK) Сізге көмектесе аламын ба? Тыныш!
Dialogue: 0,0:14:20.73,0:14:21.73,Bottom,,0000,0000,0000,,Жабыңыз!
Dialogue: 0,0:14:21.81,0:14:23.07,Bottom,,0000,0000,0000,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:14:21.86,0:14:22.98,Top,,0000,0000,0000,,‎(Люси) Икета
Dialogue: 0,0:14:23.07,0:14:24.48,Top,,0000,0000,0000,,‎Хааааа!
Dialogue: 0,0:14:25.03,0:14:26.49,Top,,0000,0000,0000,,‎Гух... Гух...
Dialogue: 0,0:14:26.57,0:14:27.44,Top,,0000,0000,0000,,Дэвид, жақсысың ба?
Dialogue: 0,0:14:26.99,0:14:29.45,Bottom,,0000,0000,0000,,Дэвид! Сіз жақсы ма?
Dialogue: 0,0:14:27.44,0:14:28.78,Top,,0000,0000,0000,,Дэвид, жақсысың ба? (жөтел)
Dialogue: 0,0:14:28.78,0:14:29.61,Top,,0000,0000,0000,,(жөтел)
Dialogue: 0,0:14:29.53,0:14:31.53,Bottom,,0000,0000,0000,,Ой, не деген ұят.
Dialogue: 0,0:14:29.61,0:14:30.28,Top,,0000,0000,0000,,‎Аа~ Өте жаман
Dialogue: 0,0:14:30.28,0:14:31.57,Top,,0000,0000,0000,,‎Аа~ Өте жаман
Dialogue: 0,0:14:32.37,0:14:34.99,Bottom,,0000,0000,0000,,Сонымен? Балалар сендерге не керек?
Dialogue: 0,0:14:32.49,0:14:34.99,Top,,0000,0000,0000,,Сіздің мақсатыңыз қандай?
Dialogue: 0,0:14:35.08,0:14:37.62,Bottom,,0000,0000,0000,,Сіз мені өлтіру үшін келген жоқсыз деп ойлаймын.
Dialogue: 0,0:14:35.08,0:14:37.62,Top,,0000,0000,0000,,‎Сен мені өлтірмек емессің ғой, солай ма?
Dialogue: 0,0:14:37.71,0:14:39.37,Bottom,,0000,0000,0000,,Бұл әлі қазылар алқасының қарауында.
Dialogue: 0,0:14:37.71,0:14:39.46,Top,,0000,0000,0000,,Бұл сізге байланысты.
Dialogue: 0,0:14:39.46,0:14:42.13,Bottom,,0000,0000,0000,,Келіңіздер. Мен ынтымақтасамын.
Dialogue: 0,0:14:39.54,0:14:42.17,Top,,0000,0000,0000,,Мен қолымнан келгенін істеймін
Dialogue: 0,0:14:42.21,0:14:43.75,Bottom,,0000,0000,0000,,Сіз тез жетесіз.
Dialogue: 0,0:14:42.25,0:14:43.38,Top,,0000,0000,0000,,Тез сөйлейді
Dialogue: 0,0:14:43.46,0:14:44.38,Top,,0000,0000,0000,,‎(винт дыбысы)
Dialogue: 0,0:14:44.46,0:14:45.13,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:45.21,0:14:46.01,Top,,0000,0000,0000,,А...
Dialogue: 0,0:14:47.46,0:14:48.55,Top,,0000,0000,0000,,Фу
Dialogue: 0,0:14:50.22,0:14:51.59,Top,,0000,0000,0000,,Бұл дыбыс...
Dialogue: 0,0:14:50.22,0:14:52.01,Bottom,,0000,0000,0000,,Олай болмағаны дұрыс...
Dialogue: 0,0:14:53.97,0:14:55.56,Top,,0000,0000,0000,,Әскери ұшқышсыз ұшақ!
Dialogue: 0,0:14:53.97,0:14:55.64,Bottom,,0000,0000,0000,,Қарулы ұшқышсыз ұшақтар!
Dialogue: 0,0:14:55.64,0:14:56.64,Top,,0000,0000,0000,,‎(JK) Дұрыс!
Dialogue: 0,0:14:55.72,0:14:56.64,Bottom,,0000,0000,0000,,барлық мәселелеріңді!!
Dialogue: 0,0:14:57.39,0:14:58.43,Bottom,,0000,0000,0000,,Оларды шақырыңыз!
Dialogue: 0,0:14:57.56,0:15:00.48,Top,,0000,0000,0000,,Оны тоқтат! (Дж.К.) Әрине, бас тартамын.
Dialogue: 0,0:14:58.52,0:15:00.23,Bottom,,0000,0000,0000,,Жоқ істей алмаймын.
Dialogue: 0,0:15:00.31,0:15:04.65,Bottom,,0000,0000,0000,,Жалғастырыңыз, оларға бір толқын беріңіз. Олар менің ең жақсы ойыншықтарым. Оқ өткізбейтін және барлығы.
Dialogue: 0,0:15:00.56,0:15:04.65,Top,,0000,0000,0000,,‎Өйткені бұл біз мақтан тұтатын оқ өткізбейтін спецификациясы бар тапсырыс беруші өнім.
Dialogue: 0,0:15:04.73,0:15:08.40,Bottom,,0000,0000,0000,,Сәттілік, оларды осы кішкентай бангерлермен түсіру.
Dialogue: 0,0:15:04.73,0:15:08.53,Top,,0000,0000,0000,,Мылтықпен қанша қашықтыққа баруға болады? Сәттілік
Dialogue: 0,0:15:08.49,0:15:10.45,Bottom,,0000,0000,0000,,Мен бірінші сенің миыңды жарып жіберемін!
Dialogue: 0,0:15:08.61,0:15:10.65,Top,,0000,0000,0000,,Мен оны сенің басыңнан жұлып аламын!
Dialogue: 0,0:15:10.53,0:15:12.28,Bottom,,0000,0000,0000,,Бұл өте ақылды болмас еді.
Dialogue: 0,0:15:10.74,0:15:12.28,Top,,0000,0000,0000,,‎(JK) Бұл ақылды емес.
Dialogue: 0,0:15:12.36,0:15:16.54,Bottom,,0000,0000,0000,,Бұл олардың сені менің еденімдегі қан даққа айналдыруына кедергі болмайды.
Dialogue: 0,0:15:12.36,0:15:16.54,Top,,0000,0000,0000,,Мені өлтірсең, ол сені ара ұясына айналдырудан тартынбайды.
Dialogue: 0,0:15:16.62,0:15:20.37,Top,,0000,0000,0000,,Сондықтан сіз оларды қалқан ретінде пайдаланып жатқанда, олар сізді атпайды.
Dialogue: 0,0:15:16.62,0:15:20.66,Bottom,,0000,0000,0000,,Иә? Мен сені қалқан ретінде пайдаланғанша олар атпайды.
Dialogue: 0,0:15:21.46,0:15:22.54,Top,,0000,0000,0000,,‎(Жұлдыз дыбысы)
Dialogue: 0,0:15:24.04,0:15:26.50,Bottom,,0000,0000,0000,,Екі болу ақылды екенін білдім.
Dialogue: 0,0:15:24.46,0:15:27.55,Top,,0000,0000,0000,,‎(JK) Бірақ олардың екеуі бар. Қарғыс атсын.
Dialogue: 0,0:15:26.59,0:15:27.55,Bottom,,0000,0000,0000,,Қат!
Dialogue: 0,0:15:28.13,0:15:30.22,Bottom,,0000,0000,0000,,Жоқ! Сізді қоршап алған сияқтысыз.
Dialogue: 0,0:15:28.13,0:15:31.88,Top,,0000,0000,0000,,‎Жоқ~ Мен қоршап қалдым. Егер мен бас тартып, берілсем ше?
Dialogue: 0,0:15:30.30,0:15:31.84,Bottom,,0000,0000,0000,,Бас тартуға дайынсыз ба?
Dialogue: 0,0:15:31.93,0:15:33.14,Bottom,,0000,0000,0000,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,0:15:31.97,0:15:34.05,Top,,0000,0000,0000,,Тыныш! Люси
Dialogue: 0,0:15:33.22,0:15:34.05,Bottom,,0000,0000,0000,,Люси!
Dialogue: 0,0:15:34.14,0:15:35.43,Top,,0000,0000,0000,,Қазір орындалуда
Dialogue: 0,0:15:34.14,0:15:35.80,Bottom,,0000,0000,0000,,Бұл туралы…
Dialogue: 0,0:15:38.56,0:15:39.68,Bottom,,0000,0000,0000,,Маған көбірек уақыт керек...
Dialogue: 0,0:15:38.72,0:15:39.81,Top,,0000,0000,0000,,Уақытында емес
Dialogue: 0,0:15:41.39,0:15:42.27,Top,,0000,0000,0000,,‎Пісіру…
Dialogue: 0,0:15:45.77,0:15:46.61,Bottom,,0000,0000,0000,,Давид!
Dialogue: 0,0:15:45.77,0:15:46.61,Top,,0000,0000,0000,,Дэвид!
Dialogue: 0,0:15:46.69,0:15:48.19,Bottom,,0000,0000,0000,,Мен олардың назарын аударамын!
Dialogue: 0,0:15:46.69,0:15:48.19,Top,,0000,0000,0000,,Мен сізге уақыт сатып аламын!
Dialogue: 0,0:15:48.78,0:15:50.15,Top,,0000,0000,0000,,‎(Имплантты белсендіру дыбысы)
Dialogue: 0,0:15:51.40,0:15:52.32,Top,,0000,0000,0000,,‎(мылтық дыбысы)
Dialogue: 0,0:15:54.16,0:15:55.32,Bottom,,0000,0000,0000,,Тезірек, Люси!
Dialogue: 0,0:15:54.16,0:15:55.32,Top,,0000,0000,0000,,‎Люси, асығыңыз!
Dialogue: 0,0:16:07.25,0:16:08.75,Top,,0000,0000,0000,,Ах!
Dialogue: 0,0:16:11.34,0:16:12.09,Top,,0000,0000,0000,,Ах!
Dialogue: 0,0:16:14.18,0:16:16.05,Top,,0000,0000,0000,,‎Ах... а...
Dialogue: 0,0:16:19.10,0:16:20.10,Top,,0000,0000,0000,,‎(ұшқын дыбысы)
Dialogue: 0,0:16:23.35,0:16:25.19,Bottom,,0000,0000,0000,,Уау! Бұл әсерлі болды!
Dialogue: 0,0:16:23.35,0:16:25.44,Top,,0000,0000,0000,,‎Эй, мұны істей аласың.
Dialogue: 0,0:16:25.27,0:16:26.90,Bottom,,0000,0000,0000,,-Анашым... -Қырсық!
Dialogue: 0,0:16:25.52,0:16:26.15,Top,,0000,0000,0000,,Бұл…
Dialogue: 0,0:16:26.23,0:16:27.69,Top,,0000,0000,0000,,Бейбақ!
Dialogue: 0,0:16:27.65,0:16:31.03,Bottom,,0000,0000,0000,,Ақ жалау! Ақ жалау! Жарайды, мен бұл жолы шынымен берілемін!
Dialogue: 0,0:16:27.77,0:16:31.19,Top,,0000,0000,0000,,‎Бағыну, берілу~ ‎Бұл жолы шынымен бас тартыңыз
Dialogue: 0,0:16:31.11,0:16:32.82,Bottom,,0000,0000,0000,,Ақ жалау менің құлағым!
Dialogue: 0,0:16:31.28,0:16:35.36,Top,,0000,0000,0000,,Сіз мені қалжыңдап тұрсыз! Мен сізге шындап миымды беремін!
Dialogue: 0,0:16:32.90,0:16:35.41,Bottom,,0000,0000,0000,,Сен әлдеқашан өлдің, боқ дақ!
Dialogue: 0,0:16:35.45,0:16:38.41,Top,,0000,0000,0000,,Жарайды, бірақ сен маған жақсылық бересің, солай ма?
Dialogue: 0,0:16:35.49,0:16:38.41,Bottom,,0000,0000,0000,,Айтайын дегенім, жарайды, бірақ мен сен менен бірдеңе сұрағың келеді деп ойладым ба?
Dialogue: 0,0:16:38.49,0:16:39.66,Bottom,,0000,0000,0000,,Құдай қарғыс атсын!
Dialogue: 0,0:16:38.49,0:16:39.66,Top,,0000,0000,0000,,‎Темее!
Dialogue: 0,0:16:39.74,0:16:42.71,Top,,0000,0000,0000,,‎(JK) ‎Сен сонда, бұрын айтқаның керемет болды.
Dialogue: 0,0:16:39.74,0:16:45.33,Bottom,,0000,0000,0000,,Әй, қыз! Хакты тез жою үшін нағыз талант керек.
Dialogue: 0,0:16:42.79,0:16:45.33,Top,,0000,0000,0000,,‎Оны қысқа уақыт ішінде қалай бұзуға болады?
Dialogue: 0,0:16:46.00,0:16:49.50,Top,,0000,0000,0000,,Мен қазір тұра аламын ба? Әңгімені тыңдайық
Dialogue: 0,0:16:46.50,0:16:49.92,Bottom,,0000,0000,0000,,Мен сенің айтқандарыңды тыңдаймын, бірақ мен тұра аламын ба, өтінемін?
Dialogue: 0,0:16:50.00,0:16:52.76,Bottom,,0000,0000,0000,,Күлкілі іс жоқ, әйтпесе сені өзім өлтіремін.
Dialogue: 0,0:16:50.00,0:16:52.76,Top,,0000,0000,0000,,‎Келесі Егер сіз біртүрлі нәрсе жасасаңыз, мен сізді өлтіремін.
Dialogue: 0,0:16:52.84,0:16:54.88,Bottom,,0000,0000,0000,,Мен алмаймын. Pinky ант.
Dialogue: 0,0:16:52.84,0:16:54.88,Top,,0000,0000,0000,,‎(JK) Мен алмаймын. Мен сөз беремін.
Dialogue: 0,0:16:56.22,0:16:59.18,Bottom,,0000,0000,0000,,Жарайды. Барлығының жоспары бар ма?
Dialogue: 0,0:16:56.39,0:16:58.72,Top,,0000,0000,0000,,‎Жарайды, сіз қадамдарды түсіндіңіз бе?
Dialogue: 0,0:16:58.72,0:16:59.18,Top,,0000,0000,0000,,‎Жарайды, сіз қадамдарды түсіндіңіз бе? (инъекция дыбысы)
Dialogue: 0,0:16:59.18,0:16:59.26,Top,,0000,0000,0000,,(Инъекция дыбысы)
Dialogue: 0,0:16:59.26,0:17:00.72,Top,,0000,0000,0000,,‎(JK) А, мен түсіндім.
Dialogue: 0,0:16:59.26,0:17:01.60,Bottom,,0000,0000,0000,,Иә, капитан.
Dialogue: 0,0:17:00.72,0:17:01.60,Top,,0000,0000,0000,,‎(JK) А, мен түсіндім.
Dialogue: 0,0:17:01.68,0:17:04.69,Bottom,,0000,0000,0000,,Мен сізге кейінірек қоңырау шаламын. Оған дейін осында бол.
Dialogue: 0,0:17:01.68,0:17:04.69,Top,,0000,0000,0000,,Мен сізге кейінірек қоңырау шаламын. Оған дейін осында бол.
Dialogue: 0,0:17:05.35,0:17:08.48,Bottom,,0000,0000,0000,,Оны бақылаңыз. Оның көзіңізден кетуіне жол бермеңіз.
Dialogue: 0,0:17:05.44,0:17:08.27,Top,,0000,0000,0000,,Мені бақылаңыз. Менен көзіңді алма.
Dialogue: 0,0:17:08.36,0:17:09.11,Top,,0000,0000,0000,,Иә
Dialogue: 0,0:17:11.44,0:17:12.69,Top,,0000,0000,0000,,‎(есік жабылған дыбыс)
Dialogue: 0,0:17:16.28,0:17:18.20,Bottom,,0000,0000,0000,,Бұрынғы үшін кешіріңіз.
Dialogue: 0,0:17:16.28,0:17:18.20,Top,,0000,0000,0000,,Ертерек кешіріңіз.
Dialogue: 0,0:17:18.28,0:17:19.70,Top,,0000,0000,0000,,Бөлек
Dialogue: 0,0:17:18.82,0:17:19.70,Bottom,,0000,0000,0000,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 0,0:17:20.37,0:17:23.04,Bottom,,0000,0000,0000,,Бізге оңайлықпен көмектесуге келісесіз деп ойламадым.
Dialogue: 0,0:17:20.45,0:17:23.00,Top,,0000,0000,0000,,Оны қабылдау таңқаларлық оңай.
Dialogue: 0,0:17:23.54,0:17:27.25,Top,,0000,0000,0000,,‎(JK) Балалар, сендер Cyberpunk әдісімен жақсы таныссыңдар.
Dialogue: 0,0:17:23.54,0:17:29.42,Bottom,,0000,0000,0000,,Мен киберпанктардың қалай жұмыс істейтінін білемін. Менің таңдауым жоқ, солай ма?
Dialogue: 0,0:17:27.33,0:17:30.96,Top,,0000,0000,0000,,‎(JK) Менің таңдауым жоқ, солай ма? Жақсы
Dialogue: 0,0:17:30.00,0:17:30.96,Bottom,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:17:32.17,0:17:34.97,Top,,0000,0000,0000,,‎(JK) Сіз де көрдіңіз бе? Ах
Dialogue: 0,0:17:32.21,0:17:34.05,Bottom,,0000,0000,0000,,Сіз оны да көрдіңіз бе?
Dialogue: 0,0:17:34.13,0:17:34.97,Bottom,,0000,0000,0000,,Оқу, оқу
Dialogue: 0,0:17:35.05,0:17:37.93,Bottom,,0000,0000,0000,,Сіз оны көрдіңіз және әлі күнге дейін Sandy орнаттыңыз ба?
Dialogue: 0,0:17:35.05,0:17:37.93,Top,,0000,0000,0000,,Сіз оны білесіз бе және орнатасыз ба?
Dialogue: 0,0:17:38.01,0:17:39.72,Bottom,,0000,0000,0000,,Сіз ақылсыз жігітсіз.
Dialogue: 0,0:17:38.01,0:17:39.72,Top,,0000,0000,0000,,Ол жынды.
Dialogue: 0,0:17:39.80,0:17:42.47,Bottom,,0000,0000,0000,,Мен ол сияқты болмаймын.
Dialogue: 0,0:17:39.80,0:17:42.47,Top,,0000,0000,0000,,Мен бұл жігіт сияқты болмаймын
Dialogue: 0,0:17:42.56,0:17:46.35,Bottom,,0000,0000,0000,,Джеймс Норрис импланттарды қалай білетін сарбаз болды.
Dialogue: 0,0:17:42.56,0:17:46.44,Top,,0000,0000,0000,,‎(JK) Ол мықты сарбаз болды, тіпті Джеймс Норрис
Dialogue: 0,0:17:46.44,0:17:49.06,Bottom,,0000,0000,0000,,Бірақ оның өзі де шыдай алмай, психозға түсті.
Dialogue: 0,0:17:46.52,0:17:49.52,Top,,0000,0000,0000,,Мен шыдай алмай киберпсихо болдым ба?
Dialogue: 0,0:17:49.61,0:17:52.44,Top,,0000,0000,0000,,Неліктен олай болмайды деп ойлайсыз?
Dialogue: 0,0:17:49.65,0:17:52.44,Bottom,,0000,0000,0000,,Сізді басқаша деп санайтын не?
Dialogue: 0,0:17:53.19,0:17:56.70,Bottom,,0000,0000,0000,,Мен білмеймін. Бұл жай ғана... дұрыс сияқты.
Dialogue: 0,0:17:53.23,0:17:56.78,Top,,0000,0000,0000,,Ешқандай негіз жоқ, бұл біртүрлі емес.
Dialogue: 0,0:17:57.24,0:17:59.82,Bottom,,0000,0000,0000,,Имплант әрқашан менің бір бөлігім болған сияқты.
Dialogue: 0,0:17:57.28,0:17:59.78,Top,,0000,0000,0000,,‎Бұл менің бұрынғы бір бөлігім сияқты.
Dialogue: 0,0:18:00.66,0:18:03.95,Bottom,,0000,0000,0000,,Менің ойымша... Мен басқаша құрылғанмын.
Dialogue: 0,0:18:00.78,0:18:03.91,Top,,0000,0000,0000,,‎Менде бірдеңе дұрыс емес болуы керек.
Dialogue: 0,0:18:04.54,0:18:06.79,Bottom,,0000,0000,0000,,Сіз өзіңізді ерекшемін деп ойлайсыз ба?
Dialogue: 0,0:18:04.54,0:18:07.71,Top,,0000,0000,0000,,‎(JK) Сіз өзіңізді ерекшемін деп ойлайсыз ба? Ах
Dialogue: 0,0:18:06.87,0:18:07.71,Bottom,,0000,0000,0000,,Ф-Фатирлеу ештеңе әкелмейді.
Dialogue: 0,0:18:08.37,0:18:09.21,Top,,0000,0000,0000,,‎(JK) Аяқ
Dialogue: 0,0:18:10.79,0:18:12.67,Top,,0000,0000,0000,,Киберпсихо болған адам
Dialogue: 0,0:18:10.79,0:18:14.42,Bottom,,0000,0000,0000,,Мен көптеген хромдокстардың психо-ға түскенін көрдім.
Dialogue: 0,0:18:12.75,0:18:14.46,Top,,0000,0000,0000,,Мен көп адамдарды көрдім.
Dialogue: 0,0:18:14.51,0:18:17.63,Bottom,,0000,0000,0000,,Кейбір металдар етпен араласуға арналмаған.
Dialogue: 0,0:18:14.55,0:18:17.59,Top,,0000,0000,0000,,Күшті имплантаттар тірі денеден келеді——
Dialogue: 0,0:18:17.67,0:18:19.26,Top,,0000,0000,0000,,Жаннан жаңа машинаға
Dialogue: 0,0:18:17.72,0:18:23.72,Bottom,,0000,0000,0000,,Сіздің органикалық денеңіз, сіздің жаныңыз шетке итеріледі. Жағалауда.
Dialogue: 0,0:18:19.34,0:18:20.84,Top,,0000,0000,0000,,айдап кетіңіз
Dialogue: 0,0:18:20.93,0:18:23.64,Top,,0000,0000,0000,,Шеті жоқ жардың шетіне
Dialogue: 0,0:18:24.31,0:18:26.73,Bottom,,0000,0000,0000,,Ол әрқашан екі нәрсенің біріне түседі.
Dialogue: 0,0:18:24.31,0:18:26.73,Top,,0000,0000,0000,,‎Екі жалғаудың біреуі
Dialogue: 0,0:18:26.81,0:18:29.23,Bottom,,0000,0000,0000,,Не есіңді жоғалтасың...
Dialogue: 0,0:18:26.81,0:18:29.23,Top,,0000,0000,0000,,‎Мен бір күні есімнен айырылып қаламын ба?
Dialogue: 0,0:18:29.81,0:18:31.98,Bottom,,0000,0000,0000,,Немесе өл... Арасында жоқ.
Dialogue: 0,0:18:29.85,0:18:31.98,Top,,0000,0000,0000,,Мен оған дейін өлемін.
Dialogue: 0,0:18:34.73,0:18:35.98,Top,,0000,0000,0000,,(көліктің жүгіру дыбысы)
Dialogue: 0,0:18:40.07,0:18:43.08,Top,,0000,0000,0000,,‎Сіз жақында баратын жеріңізге жетесіз
Dialogue: 0,0:18:40.07,0:18:43.24,Bottom,,0000,0000,0000,,Біз жақын арада межелі жерге жетеміз.
Dialogue: 0,0:18:43.16,0:18:43.99,Top,,0000,0000,0000,,‎Хмм
Dialogue: 0,0:18:44.95,0:18:48.71,Bottom,,0000,0000,0000,,Сұралғандай, бүгінгі сапарыңыздың жазбасы жойылды.
Dialogue: 0,0:18:44.95,0:18:48.79,Top,,0000,0000,0000,,Сұралғандай, бүгінгі жүру жазбасы сақталмайды.
Dialogue: 0,0:18:48.79,0:18:50.96,Bottom,,0000,0000,0000,,Мен сізге қайтадан қызмет көрсетуді асыға күтемін.
Dialogue: 0,0:18:48.87,0:18:51.04,Top,,0000,0000,0000,,Біз сізді тағы да күтеміз... (есіктің ашылуы мен жабылу дыбысы)
Dialogue: 0,0:18:53.21,0:18:55.84,Top,,0000,0000,0000,,(Домофон: Ж.К.) Қош келдіңіз Танака мырза
Dialogue: 0,0:18:53.21,0:18:57.46,Bottom,,0000,0000,0000,,Сәлем, Танака мырза. Кіріңіз.
Dialogue: 0,0:18:55.92,0:18:57.51,Top,,0000,0000,0000,,Кіріңіз.
Dialogue: 0,0:18:59.26,0:19:01.43,Bottom,,0000,0000,0000,,Сіз ертесіз.
Dialogue: 0,0:18:59.34,0:19:01.59,Top,,0000,0000,0000,,‎Бұл жолы ерте болды, солай емес пе?
Dialogue: 0,0:19:01.51,0:19:04.26,Bottom,,0000,0000,0000,,Жаңа шығарылымға әдетте айлар қажет.
Dialogue: 0,0:19:01.68,0:19:04.26,Top,,0000,0000,0000,,‎Мен әрқашан жаңа шығарылымдарды күтуім керек.
Dialogue: 0,0:19:04.35,0:19:08.77,Bottom,,0000,0000,0000,,Жақсы материалды табу қиын, көріп тұрсыңдар.
Dialogue: 0,0:19:04.35,0:19:08.77,Top,,0000,0000,0000,,‎(JK) Кешіріңіз. Біз жақсы әңгімелерді мұқият таңдаймыз.
Dialogue: 0,0:19:08.85,0:19:12.23,Bottom,,0000,0000,0000,,Бірақ бұл келесісі сіздің уақытыңызға тұрарлық.
Dialogue: 0,0:19:08.85,0:19:12.27,Top,,0000,0000,0000,,‎Бірақ бұл өте ұсынылады.
Dialogue: 0,0:19:12.31,0:19:15.27,Bottom,,0000,0000,0000,,Оны бірден реттегіңіз келе ме?
Dialogue: 0,0:19:12.35,0:19:15.27,Top,,0000,0000,0000,,‎Қазір баптауды бастаңыз. Сіз сенімдісіз бе?
Dialogue: 0,0:19:15.36,0:19:18.28,Bottom,,0000,0000,0000,,Менің ұлым бүгін түнде ауруханадан шығарылады.
Dialogue: 0,0:19:15.36,0:19:18.28,Top,,0000,0000,0000,,‎Бүгінгі кеш ұлымның сауығып кетуін тойлау.
Dialogue: 0,0:19:18.36,0:19:20.61,Top,,0000,0000,0000,,Маған жай ғана заттар беріңіз.
Dialogue: 0,0:19:18.36,0:19:20.74,Bottom,,0000,0000,0000,,Мен тек чипті аламын.
Dialogue: 0,0:19:21.53,0:19:23.03,Bottom,,0000,0000,0000,,Б... бір сызық
Dialogue: 0,0:19:21.57,0:19:23.03,Top,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:19:23.70,0:19:26.66,Bottom,,0000,0000,0000,,Бұл өкінішті. Мен мұның қалай болғанын мақтан тұтамын.
Dialogue: 0,0:19:23.74,0:19:26.70,Top,,0000,0000,0000,,Бұл жолы мен мақтан тұтатын жұмыс.
Dialogue: 0,0:19:26.74,0:19:29.79,Bottom,,0000,0000,0000,,Оны баптамау үлкен шығын болар еді.
Dialogue: 0,0:19:26.79,0:19:29.79,Top,,0000,0000,0000,,Оны баптамай тапсыру ысырап болар еді.
Dialogue: 0,0:19:29.87,0:19:32.04,Bottom,,0000,0000,0000,,Сезімталдық диаграммадан тыс болар еді.
Dialogue: 0,0:19:29.87,0:19:32.04,Top,,0000,0000,0000,,‎Сезімталдық мүлдем басқа.
Dialogue: 0,0:19:32.12,0:19:33.54,Bottom,,0000,0000,0000,,Куросаки мырза.
Dialogue: 0,0:19:32.12,0:19:33.54,Top,,0000,0000,0000,,‎Куросаки-кун
Dialogue: 0,0:19:33.63,0:19:35.50,Bottom,,0000,0000,0000,,Мен баяу еркектерді әзілдемеймін.
Dialogue: 0,0:19:33.63,0:19:35.50,Top,,0000,0000,0000,,Мен қоқыстарды жек көремін.
Dialogue: 0,0:19:35.59,0:19:37.30,Bottom,,0000,0000,0000,,Бақытсыздың бір ауыз сөзі.
Dialogue: 0,0:19:35.59,0:19:37.92,Top,,0000,0000,0000,,‎Бұл ұят ‎(Кача!)
Dialogue: 0,0:19:37.92,0:19:42.80,Bottom,,0000,0000,0000,,Егер сіз осы BD-де болсаңыз, біздің жұмысымызды әлдеқайда жеңілдетер едіңіз.
Dialogue: 0,0:19:38.01,0:19:42.80,Top,,0000,0000,0000,,‎Егер мен өзімді BD-ге арнасам, жұмысым оңайырақ болар еді.
Dialogue: 0,0:19:43.39,0:19:44.39,Bottom,,0000,0000,0000,,М-мен бұған енді маңызды емес дедім!
Dialogue: 0,0:19:43.39,0:19:44.55,Top,,0000,0000,0000,,Бұл кім?
Dialogue: 0,0:19:44.47,0:19:45.85,Bottom,,0000,0000,0000,,Ештеңеге тырыспаңыз.
Dialogue: 0,0:19:44.64,0:19:45.85,Top,,0000,0000,0000,,Қозғалмаңыз
Dialogue: 0,0:19:47.51,0:19:49.06,Bottom,,0000,0000,0000,,Жүйке...
Dialogue: 0,0:19:47.60,0:19:49.06,Top,,0000,0000,0000,,‎Сендер...
Dialogue: 0,0:19:49.14,0:19:52.31,Bottom,,0000,0000,0000,,Кешіріңіз, сэр. Олар мені доптармен ұстайды.
Dialogue: 0,0:19:49.14,0:19:52.31,Top,,0000,0000,0000,,Мені қорқытқаны үшін кешіріңіз.
Dialogue: 0,0:19:52.39,0:19:55.48,Top,,0000,0000,0000,,Менің кім екенімді білесің бе?
Dialogue: 0,0:19:52.39,0:19:55.52,Bottom,,0000,0000,0000,,Сізде кіммен айналысып жатқаныңыз туралы ойыңыз бар ма?
Dialogue: 0,0:19:55.56,0:19:57.15,Top,,0000,0000,0000,,‎(Голокольдық үн)
Dialogue: 0,0:19:57.65,0:19:58.32,Top,,0000,0000,0000,,‎Nu?
Dialogue: 0,0:19:58.40,0:20:02.07,Bottom,,0000,0000,0000,,Дүрбелең түймесін ұмытыңыз. Бізде кептеліс бар.
Dialogue: 0,0:19:58.40,0:20:02.07,Top,,0000,0000,0000,,‎Достар кептеліп жатыр ‎Байланыс мүмкін емес
Dialogue: 0,0:20:05.03,0:20:06.83,Bottom,,0000,0000,0000,,Жоспарлағандай, мен түсінемін.
Dialogue: 0,0:20:05.12,0:20:06.74,Top,,0000,0000,0000,,Жоспарланған ба?
Dialogue: 0,0:20:10.25,0:20:11.41,Top,,0000,0000,0000,,‎(Өрт дыбысы)
Dialogue: 0,0:20:14.67,0:20:16.67,Top,,0000,0000,0000,,‎(Ұшқындаған дыбыс) ‎Уһ, осындай уақытта!
Dialogue: 0,0:20:15.54,0:20:16.67,Bottom,,0000,0000,0000,,Енді бұзбаймын!
Dialogue: 0,0:20:21.97,0:20:23.72,Top,,0000,0000,0000,,‎(созылу)
Dialogue: 0,0:20:25.97,0:20:26.80,Top,,0000,0000,0000,,Негізгі!
Dialogue: 0,0:20:25.97,0:20:26.93,Bottom,,0000,0000,0000,,Мэн!
Dialogue: 0,0:20:30.43,0:20:31.35,Bottom,,0000,0000,0000,,Сіз…
Dialogue: 0,0:20:30.43,0:20:31.35,Top,,0000,0000,0000,,Сіз...
Dialogue: 0,0:20:31.43,0:20:32.85,Top,,0000,0000,0000,,Гах!
Dialogue: 0,0:20:33.89,0:20:35.40,Top,,0000,0000,0000,,Қалай!
Dialogue: 0,0:20:37.65,0:20:39.82,Bottom,,0000,0000,0000,,Менің ішім ауырды.
Dialogue: 0,0:20:37.77,0:20:39.40,Top,,0000,0000,0000,,‎Сен мені қиналып жатырсың
Dialogue: 0,0:20:39.48,0:20:40.86,Top,,0000,0000,0000,,‎(JK) Гуг... Гугг...
Dialogue: 0,0:20:40.94,0:20:42.74,Top,,0000,0000,0000,,‎(JK-ның мұңды дауысы)
Dialogue: 0,0:20:45.24,0:20:46.11,Top,,0000,0000,0000,,‎( құлаған дыбыс)
Dialogue: 0,0:20:46.66,0:20:48.08,Top,,0000,0000,0000,,Бұл бұрынғы ине.
Dialogue: 0,0:20:46.70,0:20:48.08,Bottom,,0000,0000,0000,,Инелер болуы керек.
Dialogue: 0,0:20:48.16,0:20:49.33,Bottom,,0000,0000,0000,,Оны мойнына алды.
Dialogue: 0,0:20:48.16,0:20:49.45,Top,,0000,0000,0000,,Оның мойыны зақымдалған
Dialogue: 0,0:20:49.41,0:20:50.87,Bottom,,0000,0000,0000,,Шүкір, ол шынымен баяу болды.
Dialogue: 0,0:20:49.53,0:20:50.87,Top,,0000,0000,0000,,‎Сен шынымен қоқыссың!
Dialogue: 0,0:20:50.95,0:20:52.87,Bottom,,0000,0000,0000,,Ол тұншығып жатыр.
Dialogue: 0,0:20:50.95,0:20:52.87,Top,,0000,0000,0000,,Мен дем ала алмаймын.
Dialogue: 0,0:20:52.96,0:20:54.62,Bottom,,0000,0000,0000,,А... Ол үшін жаман.
Dialogue: 0,0:20:52.96,0:20:54.62,Top,,0000,0000,0000,,Әй, Хиди
Dialogue: 0,0:20:54.71,0:20:56.17,Top,,0000,0000,0000,,Бұл жақсы емес.
Dialogue: 0,0:20:54.71,0:20:58.88,Bottom,,0000,0000,0000,,Ол өзінің өлім шиыршығын өңдеуге келмейтін сияқты.
Dialogue: 0,0:20:56.25,0:20:58.92,Top,,0000,0000,0000,,Мен өлсем де, маған бағыт-бағдар беруіңізді қалаймын.
Dialogue: 0,0:20:59.00,0:21:00.50,Top,,0000,0000,0000,,‎(JK) Гугугу…
Dialogue: 0,0:21:04.76,0:21:05.63,Top,,0000,0000,0000,,‎Хаха
Dialogue: 0,0:21:06.34,0:21:07.05,Top,,0000,0000,0000,,А...
Dialogue: 0,0:21:08.05,0:21:09.14,Bottom,,0000,0000,0000,,Тегістелген.
Dialogue: 0,0:21:08.05,0:21:09.22,Top,,0000,0000,0000,,Өлді ме?
Dialogue: 0,0:21:10.22,0:21:12.39,Bottom,,0000,0000,0000,,Боқ. Травматология тобы келеді.
Dialogue: 0,0:21:10.22,0:21:12.47,Top,,0000,0000,0000,,‎(Киви) ‎Жаман, жарақат тобы келе жатыр.
Dialogue: 0,0:21:12.47,0:21:15.02,Bottom,,0000,0000,0000,,Не? Бұл қаншық травматикалық қамтыды ма?
Dialogue: 0,0:21:12.56,0:21:15.10,Top,,0000,0000,0000,,Не! Бұл жігіт травма мүшесі ме?
Dialogue: 0,0:21:15.10,0:21:17.77,Bottom,,0000,0000,0000,,Иә. Платина және бәрі.
Dialogue: 0,0:21:15.19,0:21:17.69,Top,,0000,0000,0000,,(Киви) Иә, бұл VIP келісімшарт болған сияқты.
Dialogue: 0,0:21:17.77,0:21:18.69,Top,,0000,0000,0000,,‎Цк
Dialogue: 0,0:21:17.85,0:21:18.90,Bottom,,0000,0000,0000,,Бля.
Dialogue: 0,0:21:20.82,0:21:22.65,Bottom,,0000,0000,0000,,Балам, біз құтыламыз!
Dialogue: 0,0:21:20.86,0:21:22.65,Top,,0000,0000,0000,,‎Дэвид, сырғып барады.
Dialogue: 0,0:21:22.73,0:21:25.40,Bottom,,0000,0000,0000,,Қазір. Олар бізді тауып алды, ал біз ренжіп қалдық.
Dialogue: 0,0:21:22.73,0:21:25.40,Top,,0000,0000,0000,,‎Асығыңыз, олар келсе қиын болады.
Dialogue: 0,0:21:29.49,0:21:31.95,Top,,0000,0000,0000,,‎(Қашып кеткен аяқ дыбысы)
Dialogue: 0,0:21:53.56,0:21:58.56,Top,,0000,0000,0000,,♪~
Dialogue: 0,0:23:18.56,0:23:23.56,Top,,0000,0000,0000,,~♪
