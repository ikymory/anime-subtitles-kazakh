Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.46,0:00:08.63,Top,,0000,0000,0000,,‎NETFLIX аниме сериясы
Dialogue: 0,0:00:11.01,0:00:16.01,Top,,0000,0000,0000,,♪~
Dialogue: 0,0:01:34.13,0:01:39.14,Top,,0000,0000,0000,,~♪
Dialogue: 0,0:01:45.06,0:01:45.73,Top,,0000,0000,0000,,Хаа һаа һаа һаа…
Dialogue: 0,0:01:45.68,0:01:51.98,Bottom,,0000,0000,0000,,Қайырлы таң, Түнгі қала! Армандар қаласында жаңа күнге көтеріліп, жарқыраңыз...
Dialogue: 0,0:01:45.73,0:01:47.85,Top,,0000,0000,0000,,Ха ха ха ха ха ха... ‎(Радио: DJ) ‎Сәлем Түнгі қала!
Dialogue: 0,0:01:47.85,0:01:47.94,Top,,0000,0000,0000,,Хаа һаа һаа һаа…
Dialogue: 0,0:01:47.94,0:01:51.48,Top,,0000,0000,0000,,Ха ха ха ха ха... ‎Бүгін де армандар қаласында жаңа күн басталды!
Dialogue: 0,0:01:51.48,0:01:51.98,Top,,0000,0000,0000,,Хаа һаа һаа һаа…
Dialogue: 0,0:01:52.52,0:01:54.57,Top,,0000,0000,0000,,Мен де бүгін жұмысқа кешігіп қалдым.
Dialogue: 0,0:01:52.57,0:01:54.53,Bottom,,0000,0000,0000,,Хейвуд тас жолында үйінді туралы хабарлар түсті.
Dialogue: 0,0:01:54.61,0:01:58.36,Bottom,,0000,0000,0000,,Бізде келесі Вейланд Боа Боа болуды армандайтын адамдар бар
Dialogue: 0,0:01:54.65,0:01:58.40,Top,,0000,0000,0000,,Вейланд Боа Боа сияқты аңызға сүйсінетін ақымақ
Dialogue: 0,0:01:58.45,0:02:01.37,Bottom,,0000,0000,0000,,қалғанымыз үшін көлік кептелісі!
Dialogue: 0,0:01:58.49,0:02:00.95,Top,,0000,0000,0000,,Өйткені олар тас жолда кезекке тұруды ұнатпайды.
Dialogue: 0,0:02:01.45,0:02:02.16,Top,,0000,0000,0000,,Екеуміз жабысып қалғандықтан—
Dialogue: 0,0:02:02.03,0:02:07.58,Bottom,,0000,0000,0000,,…шыбындар сияқты гангундар! Бұл қаланың несімен қызықтырады…
Dialogue: 0,0:02:02.16,0:02:05.16,Top,,0000,0000,0000,,Ха ха ха ха ха ха ‎Эй, эй, Түнгі қала неге көп адамды тартады?
Dialogue: 0,0:02:05.16,0:02:05.25,Top,,0000,0000,0000,,‎Қане, түнгі қала неге сонша көп адамды тартады?
Dialogue: 0,0:02:05.25,0:02:07.08,Top,,0000,0000,0000,,‎Эй, Түнгі қала неге көп адамды тартады? Ха ха ха ха...
Dialogue: 0,0:02:07.08,0:02:07.83,Top,,0000,0000,0000,,Хаа һаа һаа…
Dialogue: 0,0:02:09.00,0:02:10.75,Bottom,,0000,0000,0000,,Ешқашан тәуекелден қорықпа!
Dialogue: 0,0:02:09.12,0:02:10.00,Top,,0000,0000,0000,,‎Тәуекелдерден қорықпа ‎Егер сіз жарқыраған армандарыңызға қол жеткізгіңіз келсе
Dialogue: 0,0:02:10.00,0:02:12.96,Top,,0000,0000,0000,,‎Тәуекелдерден қорықпа ‎Егер сіз жарқын армандарыңызға қол жеткізгіңіз келсе, Хаха Хаха Хаа
Dialogue: 0,0:02:10.83,0:02:15.96,Bottom,,0000,0000,0000,,Сіз оны ешқашан үлкен армандамайсыз, тыныштықта, кішкентай арманда.
Dialogue: 0,0:02:12.96,0:02:13.04,Top,,0000,0000,0000,,Сен тәжірибелер жүргізіп, пулемётпен оқ жаудырып жүрсің — нағыз ақымақсың.
Dialogue: 0,0:02:13.04,0:02:14.75,Top,,0000,0000,0000,,Ха ха ха ха ха маған тек үлкен табыс алу керек
Dialogue: 0,0:02:14.75,0:02:15.92,Top,,0000,0000,0000,,‎Сіз тек үлкен табыс алуыңыз керек.
Dialogue: 0,0:02:16.46,0:02:17.42,Top,,0000,0000,0000,,Сен тәжірибелер жүргізіп, пулемётпен оқ жаудырып жүрсің — нағыз ақымақсың.
Dialogue: 0,0:02:17.30,0:02:22.80,Bottom,,0000,0000,0000,,Түнгі қаланың барлық аңыздарының қайда ойнайтынын білгіңіз келе ме?
Dialogue: 0,0:02:17.42,0:02:21.80,Top,,0000,0000,0000,,Ха ха ха ха ха Түнгі қаланың барлық аңыздары қайда жиналатынын білесіз бе?
Dialogue: 0,0:02:21.80,0:02:22.64,Top,,0000,0000,0000,,Түнгі қаланың барлық аңыздары қайда жиналатынын білесіз бе?
Dialogue: 0,0:02:24.39,0:02:25.22,Bottom,,0000,0000,0000,,Бұл…
Dialogue: 0,0:02:24.56,0:02:25.39,Top,,0000,0000,0000,,Бұл…
Dialogue: 0,0:02:25.31,0:02:26.14,Bottom,,0000,0000,0000,,Мэн.
Dialogue: 0,0:02:25.47,0:02:26.72,Top,,0000,0000,0000,,Негізгі
Dialogue: 0,0:02:27.14,0:02:29.64,Bottom,,0000,0000,0000,,Сіз соңғы рет қашан тамақтандыңыз?
Dialogue: 0,0:02:27.23,0:02:29.14,Top,,0000,0000,0000,,Сіз тамақ жеген жоқсыз, солай ма?
Dialogue: 0,0:02:34.07,0:02:34.86,Top,,0000,0000,0000,,‎Цк
Dialogue: 0,0:02:36.11,0:02:39.82,Top,,0000,0000,0000,,Қолдың дірілдегені Жүйкелерің зақымдана бастады, солай ма?
Dialogue: 0,0:02:36.11,0:02:40.32,Bottom,,0000,0000,0000,,Сіз дірілдеп тұрсыз. Бұл хромның бәрі сіздің жүйкеңізді бұзады.
Dialogue: 0,0:02:40.41,0:02:44.28,Bottom,,0000,0000,0000,,Бұл аяқталғанда, қайта орнату керек. Lightspec-ке өтіңіз, жүктемеңізді азайтыңыз.
Dialogue: 0,0:02:40.45,0:02:41.74,Top,,0000,0000,0000,,‎Бұл аяқталған кезде
Dialogue: 0,0:02:41.82,0:02:44.28,Top,,0000,0000,0000,,‎Хромға ауыстырған дұрыс, бұл ауыртпалық азырақ.
Dialogue: 0,0:02:44.37,0:02:45.58,Top,,0000,0000,0000,,Сіз асыра айтып жатырсыз. Маған дірілдеген қолдарыңызды беріңіз.
Dialogue: 0,0:02:44.37,0:02:47.54,Bottom,,0000,0000,0000,,Біраз діріл. Мұны үлкен мәселеге айналдырмаңыз.
Dialogue: 0,0:02:45.58,0:02:47.12,Top,,0000,0000,0000,,Сіз асыра айтып жатырсыз. Маған дірілдеген қолдарыңды бер. (Инъекция дыбысы)
Dialogue: 0,0:02:47.12,0:02:47.54,Top,,0000,0000,0000,,Сіз асыра айтып жатырсыз. Маған дірілдеген қолдарыңызды беріңіз.
Dialogue: 0,0:02:48.66,0:02:50.33,Top,,0000,0000,0000,,‎Сен осылай тұрасың...
Dialogue: 0,0:02:48.75,0:02:50.37,Bottom,,0000,0000,0000,,Тәтті, осылайша…
Dialogue: 0,0:02:50.42,0:02:53.67,Top,,0000,0000,0000,,‎Tch импланттары 10 және 20!
Dialogue: 0,0:02:51.42,0:02:53.63,Bottom,,0000,0000,0000,,Ашық металл болмайды...
Dialogue: 0,0:02:53.75,0:02:54.46,Top,,0000,0000,0000,,‎Хмм!
Dialogue: 0,0:02:55.34,0:02:56.55,Bottom,,0000,0000,0000,,Мэн?
Dialogue: 0,0:02:55.46,0:02:56.55,Top,,0000,0000,0000,,Негізгі?
Dialogue: 0,0:02:56.63,0:02:58.59,Top,,0000,0000,0000,,‎Na… ‎Oi Main
Dialogue: 0,0:02:57.46,0:02:58.97,Bottom,,0000,0000,0000,,Сәлем! Мэн!
Dialogue: 0,0:02:59.05,0:03:02.55,Bottom,,0000,0000,0000,,Жоқ! Менің шектеуімді өзімнен басқа ешкім белгілемейді!
Dialogue: 0,0:02:59.09,0:02:59.92,Top,,0000,0000,0000,,Шу!
Dialogue: 0,0:03:00.01,0:03:02.55,Top,,0000,0000,0000,,‎Мен өз денем туралы жақсы білемін!
Dialogue: 0,0:03:02.64,0:03:05.56,Bottom,,0000,0000,0000,,Осы уақытқа дейін еш қиындықсыз жеттім.
Dialogue: 0,0:03:02.64,0:03:05.56,Top,,0000,0000,0000,,Бұл жұмыс ақыры осы уақытқа дейін жетті.
Dialogue: 0,0:03:05.64,0:03:07.93,Bottom,,0000,0000,0000,,Мен енді қайтып оралмаймын!
Dialogue: 0,0:03:05.64,0:03:07.93,Top,,0000,0000,0000,,Сіз орта жолда кете аласыз ба?
Dialogue: 0,0:03:08.02,0:03:09.43,Bottom,,0000,0000,0000,,Блять деректер қайда?!
Dialogue: 0,0:03:08.02,0:03:09.48,Top,,0000,0000,0000,,Әзірге деректер жоқ!
Dialogue: 0,0:03:09.52,0:03:11.94,Bottom,,0000,0000,0000,,Сіз Кивидің бұл үшін сүңгуін білесіз!
Dialogue: 0,0:03:09.56,0:03:11.90,Top,,0000,0000,0000,,Кивилер дәл қазір хакерлікпен айналысатын шығар!
Dialogue: 0,0:03:12.73,0:03:15.69,Top,,0000,0000,0000,,‎(Кивидің ауыр тыныс алуы)
Dialogue: 0,0:03:17.19,0:03:20.03,Bottom,,0000,0000,0000,,ICE мен күткеннен қалыңырақ...
Dialogue: 0,0:03:17.32,0:03:20.20,Top,,0000,0000,0000,,(Киви) Бұл мен күткеннен де қалың мұз.
Dialogue: 0,0:03:20.28,0:03:21.07,Top,,0000,0000,0000,,‎(созылу)
Dialogue: 0,0:03:23.82,0:03:25.33,Top,,0000,0000,0000,,‎(созылу)
Dialogue: 0,0:03:25.99,0:03:26.99,Top,,0000,0000,0000,,‎(Зуш!)
Dialogue: 0,0:03:28.58,0:03:29.54,Top,,0000,0000,0000,,‎(соққы дыбысы)
Dialogue: 0,0:03:30.96,0:03:31.92,Top,,0000,0000,0000,,‎ (құлап жатқан дыбыс)
Dialogue: 0,0:03:32.00,0:03:34.33,Top,,0000,0000,0000,,‎Хаа ха… ‎Негізі тоқтатыңыз!
Dialogue: 0,0:03:33.42,0:03:36.38,Bottom,,0000,0000,0000,,Мэн! Тоқта! Сіз не…
Dialogue: 0,0:03:34.42,0:03:35.25,Top,,0000,0000,0000,,‎(соққы дыбысы)
Dialogue: 0,0:03:35.34,0:03:36.96,Top,,0000,0000,0000,,Сіз не істеп жатырсыз? Эй!
Dialogue: 0,0:03:36.46,0:03:37.30,Bottom,,0000,0000,0000,,Бір сәт те жоғалтуға болмайды.
Dialogue: 0,0:03:37.05,0:03:41.34,Top,,0000,0000,0000,,‎Хаа һаа…
Dialogue: 0,0:03:41.84,0:03:44.51,Bottom,,0000,0000,0000,,Киви? Falco?
Dialogue: 0,0:03:42.13,0:03:44.43,Top,,0000,0000,0000,,‎Киви? Falco?
Dialogue: 0,0:03:45.43,0:03:48.10,Top,,0000,0000,0000,,‎‎Ха... Сен тынышталдың ба? Боқ.
Dialogue: 0,0:03:46.39,0:03:48.31,Bottom,,0000,0000,0000,,Сіз бізбен қайтасыз ба? Боқ...
Dialogue: 0,0:03:48.85,0:03:49.81,Top,,0000,0000,0000,,Дрио
Dialogue: 0,0:03:48.93,0:03:49.81,Bottom,,0000,0000,0000,,Дорио?
Dialogue: 0,0:03:50.31,0:03:52.14,Top,,0000,0000,0000,,Не? Не болды?
Dialogue: 0,0:03:50.31,0:03:53.69,Bottom,,0000,0000,0000,,Не береді? Біз секіреміз бе?
Dialogue: 0,0:03:52.77,0:03:53.60,Top,,0000,0000,0000,,Шабуыл?
Dialogue: 0,0:03:54.73,0:03:56.73,Top,,0000,0000,0000,,‎Не болды, Киви... Эй!
Dialogue: 0,0:03:54.77,0:03:56.11,Bottom,,0000,0000,0000,,Кивиге не болды...
Dialogue: 0,0:03:58.90,0:04:02.11,Bottom,,0000,0000,0000,,…жағалауда қатты жауын-шашын болжамы.
Dialogue: 0,0:03:58.94,0:04:02.24,Top,,0000,0000,0000,,‎(Radio: Weathercaster) ‎Жағалаудағы кей жерлерде жаңбыр жауады
Dialogue: 0,0:04:02.20,0:04:04.70,Bottom,,0000,0000,0000,,Санто-Доминго және Вестбрук сияқты аудандар,
Dialogue: 0,0:04:02.32,0:04:04.86,Top,,0000,0000,0000,,‎Санто Доминго ‎Вестбруктағы
Dialogue: 0,0:04:04.78,0:04:10.25,Bottom,,0000,0000,0000,,түн ортасынан күн шыққанға дейін жаңбыр жауады...
Dialogue: 0,0:04:04.95,0:04:06.87,Top,,0000,0000,0000,,Түн ортасынан таң атқанға дейін
Dialogue: 0,0:04:06.95,0:04:07.91,Top,,0000,0000,0000,,Қатты жаңбыр кезеңі болуы ықтимал.
Dialogue: 0,0:04:07.91,0:04:09.95,Top,,0000,0000,0000,,Қатты жаңбыр жауатын сияқты (күрсініп)
Dialogue: 0,0:04:10.45,0:04:12.62,Top,,0000,0000,0000,,‎(Holocall рингтоны) ‎Хмм?
Dialogue: 0,0:04:13.21,0:04:15.71,Bottom,,0000,0000,0000,,Не болды, Фалько?!
Dialogue: 0,0:04:13.21,0:04:15.75,Top,,0000,0000,0000,,‎Фалько, бұл не деген сұмдық?
Dialogue: 0,0:04:16.75,0:04:19.71,Bottom,,0000,0000,0000,,Мэннен сұраңыз ба? Айтыңызшы...
Dialogue: 0,0:04:16.83,0:04:19.59,Top,,0000,0000,0000,,Не? Басты адамнан сұрау дегенді қалай түсінесіңдер?
Dialogue: 0,0:04:19.67,0:04:20.67,Top,,0000,0000,0000,,Әй!
Dialogue: 0,0:04:19.80,0:04:21.13,Bottom,,0000,0000,0000,,Иә!
Dialogue: 0,0:04:21.21,0:04:22.34,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:21.21,0:04:22.42,Bottom,,0000,0000,0000,,А...?
Dialogue: 0,0:04:27.60,0:04:29.06,Top,,0000,0000,0000,,‎(Люси) Мен мұны істей алмаймын.
Dialogue: 0,0:04:27.60,0:04:29.51,Bottom,,0000,0000,0000,,Мен мұны істемеймін.
Dialogue: 0,0:04:29.14,0:04:32.85,Top,,0000,0000,0000,,А... Киви жедел жәрдем бөлмесіне жіберілді...
Dialogue: 0,0:04:30.14,0:04:32.73,Bottom,,0000,0000,0000,,Киви операция үстеліне қалай қонды?
Dialogue: 0,0:04:32.81,0:04:34.85,Bottom,,0000,0000,0000,,Ол Танаканың ісі бойынша болды, солай ма?
Dialogue: 0,0:04:32.93,0:04:36.40,Top,,0000,0000,0000,,‎Танака бұзды, солай ма? Не болды?
Dialogue: 0,0:04:34.94,0:04:36.40,Bottom,,0000,0000,0000,,Не болды?
Dialogue: 0,0:04:36.48,0:04:38.11,Top,,0000,0000,0000,,Мына ақымақтан сұра.
Dialogue: 0,0:04:36.48,0:04:38.15,Bottom,,0000,0000,0000,,Менің жанымдағы гонктан сұра.
Dialogue: 0,0:04:38.19,0:04:39.15,Top,,0000,0000,0000,,Шулы
Dialogue: 0,0:04:38.23,0:04:39.15,Bottom,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:04:40.40,0:04:44.49,Bottom,,0000,0000,0000,,Мэн оны жұдырықпен қуып жіберді. Ол өзін ұстап алған ICE-ге соқтығысқан кезде салқынқандылығын жоғалтты ...
Dialogue: 0,0:04:40.44,0:04:42.24,Top,,0000,0000,0000,,Негізгі соққы
Dialogue: 0,0:04:42.32,0:04:44.70,Top,,0000,0000,0000,,Қақпанға түскен кивиге ашуланыңыз.
Dialogue: 0,0:04:44.57,0:04:45.41,Bottom,,0000,0000,0000,,Не!?
Dialogue: 0,0:04:44.78,0:04:45.49,Top,,0000,0000,0000,,Ех!
Dialogue: 0,0:04:45.49,0:04:47.53,Bottom,,0000,0000,0000,,Мэн. Басыңызды тексертсеңіз қалай болады?
Dialogue: 0,0:04:45.57,0:04:47.53,Top,,0000,0000,0000,,‎(Люси) ‎Бастысы, егер сіз ауруханаға барсаңыз ше?
Dialogue: 0,0:04:47.62,0:04:48.37,Top,,0000,0000,0000,,Не?
Dialogue: 0,0:04:48.37,0:04:51.04,Bottom,,0000,0000,0000,,Мэн, келесі жолы оны жоғалта бастағанда...
Dialogue: 0,0:04:48.45,0:04:50.79,Top,,0000,0000,0000,,‎Негізгі Симптомдар келесі жолы пайда болса...
Dialogue: 0,0:04:50.87,0:04:51.87,Top,,0000,0000,0000,,‎Tsk!
Dialogue: 0,0:04:52.50,0:04:53.45,Top,,0000,0000,0000,,‎(Түр!)
Dialogue: 0,0:04:53.54,0:04:56.37,Top,,0000,0000,0000,,‎(Алысқан аяқ дыбысы)
Dialogue: 0,0:04:56.21,0:04:57.04,Bottom,,0000,0000,0000,,Сәлем…
Dialogue: 0,0:04:56.46,0:04:58.75,Top,,0000,0000,0000,,Әй, қандай белгілер бар?
Dialogue: 0,0:04:57.63,0:04:59.04,Bottom,,0000,0000,0000,,«Оны жоғалту»…?
Dialogue: 0,0:04:58.84,0:04:59.59,Top,,0000,0000,0000,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:04:59.59,0:05:01.05,Top,,0000,0000,0000,,Киберпсихоз.
Dialogue: 0,0:04:59.63,0:05:01.05,Bottom,,0000,0000,0000,,Киберпсихоз.
Dialogue: 0,0:05:01.05,0:05:01.88,Top,,0000,0000,0000,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:05:05.38,0:05:07.05,Top,,0000,0000,0000,,‎(инъекция дыбысы)
Dialogue: 0,0:05:07.14,0:05:08.43,Top,,0000,0000,0000,,‎(шприцтің құлаған дыбысы)
Dialogue: 0,0:05:10.64,0:05:11.43,Top,,0000,0000,0000,,Негізгі!
Dialogue: 0,0:05:10.64,0:05:11.68,Bottom,,0000,0000,0000,,Мэн!
Dialogue: 0,0:05:12.60,0:05:14.31,Bottom,,0000,0000,0000,,Ух... Эй.
Dialogue: 0,0:05:12.64,0:05:14.31,Top,,0000,0000,0000,,Мм...
Dialogue: 0,0:05:14.39,0:05:17.44,Bottom,,0000,0000,0000,,Дорио маған жаңа ғана айтты. Сіз…
Dialogue: 0,0:05:14.39,0:05:17.44,Top,,0000,0000,0000,,Дрио былай деді...
Dialogue: 0,0:05:17.52,0:05:20.61,Top,,0000,0000,0000,,‎Жарайды, бастысы! Бұл...
Dialogue: 0,0:05:18.02,0:05:20.52,Bottom,,0000,0000,0000,,Сіз жақсы боласыз, солай ма? Сіз бұл сияқты болмайсыз ...
Dialogue: 0,0:05:20.61,0:05:21.65,Bottom,,0000,0000,0000,,Жақсы ма?
Dialogue: 0,0:05:20.69,0:05:21.86,Top,,0000,0000,0000,,Амансың ба?
Dialogue: 0,0:05:22.36,0:05:25.24,Bottom,,0000,0000,0000,,«Жақсы» дегенді қалай түсінесіңдер? Бала.
Dialogue: 0,0:05:22.40,0:05:25.07,Top,,0000,0000,0000,,‎Бұл не деп тұрсың? Дэвид
Dialogue: 0,0:05:25.86,0:05:27.57,Bottom,,0000,0000,0000,,Сіз мені психологқа барамын ба деп сұрайсыз ба?
Dialogue: 0,0:05:25.95,0:05:27.57,Top,,0000,0000,0000,,Киберпсихо?
Dialogue: 0,0:05:28.91,0:05:31.20,Bottom,,0000,0000,0000,,Мен оны жоғалтып жатырмын деп ойлайсың ба?
Dialogue: 0,0:05:28.91,0:05:31.20,Top,,0000,0000,0000,,Менің осындай болуым мүмкін бе?
Dialogue: 0,0:05:31.28,0:05:32.58,Bottom,,0000,0000,0000,,Мэн, мен айтқан жоқпын...
Dialogue: 0,0:05:31.28,0:05:32.58,Top,,0000,0000,0000,,‎Негізгі I...
Dialogue: 0,0:05:32.66,0:05:34.83,Top,,0000,0000,0000,,‎Маған ерме, Дэвид
Dialogue: 0,0:05:33.16,0:05:34.75,Bottom,,0000,0000,0000,,Жұмыстан кет, балақай.
Dialogue: 0,0:05:35.37,0:05:37.58,Top,,0000,0000,0000,,Баяу жүгіру ренжітеді.
Dialogue: 0,0:05:35.37,0:05:38.29,Bottom,,0000,0000,0000,,Сенің айналаңды аңдуың менің жүйкеме тиюде.
Dialogue: 0,0:05:37.67,0:05:38.29,Top,,0000,0000,0000,,Е...
Dialogue: 0,0:05:41.04,0:05:45.97,Bottom,,0000,0000,0000,,Сіз меннен жылдамырақ болғандықтан, өзіңізді қызық деп ойлайсыз ба?
Dialogue: 0,0:05:41.09,0:05:44.09,Top,,0000,0000,0000,,‎Сан-Девистанда, өйткені сіз басқа адамдарға қарағанда жылдам жүгіре аласыз
Dialogue: 0,0:05:44.17,0:05:45.97,Top,,0000,0000,0000,,‎Алдында басқа адам бар ма?
Dialogue: 0,0:05:46.55,0:05:48.72,Bottom,,0000,0000,0000,,Бұл Сэнди менікі болуы керек еді.
Dialogue: 0,0:05:46.59,0:05:48.43,Top,,0000,0000,0000,,Бұл бастапқыда мен болдым.
Dialogue: 0,0:05:50.05,0:05:51.89,Top,,0000,0000,0000,,‎(әйнек сынған дыбыс)
Dialogue: 0,0:05:54.22,0:05:56.48,Bottom,,0000,0000,0000,,Мен осы уақытқа дейін жеттім.
Dialogue: 0,0:05:54.27,0:05:56.48,Top,,0000,0000,0000,,Біз осы уақытқа дейін жеттік
Dialogue: 0,0:05:56.56,0:06:00.98,Bottom,,0000,0000,0000,,Мен енді рейтингті төмендете алмаймын…
Dialogue: 0,0:05:56.56,0:06:00.98,Top,,0000,0000,0000,,‎Мұнда келіп, хромды төмендетудің мәні неде?
Dialogue: 0,0:06:02.11,0:06:04.61,Bottom,,0000,0000,0000,,Қазір жүгіруді тоқтату мүмкін емес…
Dialogue: 0,0:06:02.19,0:06:04.61,Top,,0000,0000,0000,,‎Сен неге осы жерге дейін жүгірдің?
Dialogue: 0,0:06:05.61,0:06:08.03,Top,,0000,0000,0000,,‎Іздеу әлдеқашан басталып кеткен болуы мүмкін.
Dialogue: 0,0:06:05.65,0:06:08.36,Bottom,,0000,0000,0000,,Шошқаларда біздің ізіміз бар шығар.
Dialogue: 0,0:06:08.45,0:06:10.87,Bottom,,0000,0000,0000,,Бізде таңға дейін ғана уақыт бар.
Dialogue: 0,0:06:08.57,0:06:09.36,Top,,0000,0000,0000,,Таң атқанша шайқас болатынын білесің.
Dialogue: 0,0:06:09.36,0:06:10.45,Top,,0000,0000,0000,,‎Таңға дейін шайқас болатынын білесіз (есіктің ашылған дыбысы)
Dialogue: 0,0:06:10.45,0:06:10.87,Top,,0000,0000,0000,,Таң атқанша шайқас болатынын білесің.
Dialogue: 0,0:06:10.95,0:06:11.99,Bottom,,0000,0000,0000,,Сіз мені тыңдап тұрсыз ба?
Dialogue: 0,0:06:10.95,0:06:13.24,Top,,0000,0000,0000,,Менің мұны істеуден басқа амалым жоқ. (Люси) Мен мұны істей алмаймын!
Dialogue: 0,0:06:12.08,0:06:13.24,Bottom,,0000,0000,0000,,Мен жоқ дедім!
Dialogue: 0,0:06:13.33,0:06:15.66,Top,,0000,0000,0000,,Сіз шынымен білесіз бе?
Dialogue: 0,0:06:13.33,0:06:15.75,Bottom,,0000,0000,0000,,Тыңдамайтын сенсің!
Dialogue: 0,0:06:15.83,0:06:17.79,Bottom,,0000,0000,0000,,Ол Арасака...
Dialogue: 0,0:06:16.16,0:06:17.25,Top,,0000,0000,0000,,‎Арасака…
Dialogue: 0,0:06:20.42,0:06:22.25,Bottom,,0000,0000,0000,,Оны тоқтатайық.
Dialogue: 0,0:06:20.50,0:06:22.25,Top,,0000,0000,0000,,Тоқтатайық
Dialogue: 0,0:06:22.34,0:06:24.46,Bottom,,0000,0000,0000,,Кел, Люси.
Dialogue: 0,0:06:22.34,0:06:26.13,Top,,0000,0000,0000,,‎Қазір үйге қайтайық, Люси. Өзіңізді мұны істеуге мәжбүрлемеңіз.
Dialogue: 0,0:06:24.55,0:06:26.13,Bottom,,0000,0000,0000,,Мұны істеудің қажеті жоқ.
Dialogue: 0,0:06:26.21,0:06:27.55,Bottom,,0000,0000,0000,,Жап, Дэвид!
Dialogue: 0,0:06:26.21,0:06:27.59,Top,,0000,0000,0000,,Тыныш, Дэвид.
Dialogue: 0,0:06:27.63,0:06:31.30,Bottom,,0000,0000,0000,,Біз Танаканы апарған жерге түсіре аламыз. Бұның ешқайсысы болмаған сияқты.
Dialogue: 0,0:06:27.67,0:06:29.93,Top,,0000,0000,0000,,‎Танаканы бастапқы орнына қойыңыз.
Dialogue: 0,0:06:30.01,0:06:31.43,Top,,0000,0000,0000,,‎Бәрі ешқашан болмағандай...
Dialogue: 0,0:06:31.39,0:06:33.26,Bottom,,0000,0000,0000,,Сізде жүйкеңіз көп!
Dialogue: 0,0:06:31.51,0:06:33.30,Top,,0000,0000,0000,,Сіз жалқаусыз!
Dialogue: 0,0:06:33.39,0:06:35.18,Top,,0000,0000,0000,,Сәлем! Қашқаннан пайда жоқ!
Dialogue: 0,0:06:33.81,0:06:35.18,Bottom,,0000,0000,0000,,Мен сенімен жұмысым біткен жоқ!
Dialogue: 0,0:06:36.52,0:06:39.06,Bottom,,0000,0000,0000,,Дэвид... Мен мұны істей аламын деп айтыңыз.
Dialogue: 0,0:06:36.52,0:06:39.19,Top,,0000,0000,0000,,(Люси) Дэвид, мұны істей алатыныңызды айтыңыз.
Dialogue: 0,0:06:39.14,0:06:40.77,Bottom,,0000,0000,0000,,Не... Мен ойладым...
Dialogue: 0,0:06:39.27,0:06:40.81,Top,,0000,0000,0000,,Бірақ ертерек...
Dialogue: 0,0:06:40.85,0:06:41.98,Bottom,,0000,0000,0000,,Айтыңызшы!
Dialogue: 0,0:06:40.90,0:06:42.11,Top,,0000,0000,0000,,‎(Люси) Айтыңызшы!
Dialogue: 0,0:06:43.06,0:06:46.48,Bottom,,0000,0000,0000,,Сіз Арасаканың қандай екенін мүлде түсінбейсіз.
Dialogue: 0,0:06:43.11,0:06:46.48,Top,,0000,0000,0000,,Арасаканың қандай екенін білмейсің.
Dialogue: 0,0:06:46.57,0:06:47.57,Top,,0000,0000,0000,,‎Сіз бақылануда!
Dialogue: 0,0:06:46.57,0:06:50.95,Bottom,,0000,0000,0000,,Олар бізді үнемі бақылап отырады. сен... мен...
Dialogue: 0,0:06:48.40,0:06:50.36,Top,,0000,0000,0000,,Мен де, сен де...
Dialogue: 0,0:06:51.03,0:06:52.82,Bottom,,0000,0000,0000,,Біз оны жай ғана тоқтата алмаймыз.
Dialogue: 0,0:06:51.11,0:06:52.82,Top,,0000,0000,0000,,‎Оны істе немесе жасама.
Dialogue: 0,0:06:53.37,0:06:54.66,Top,,0000,0000,0000,,Менің мұны істеуден басқа амалым жоқ.
Dialogue: 0,0:06:53.41,0:06:54.91,Bottom,,0000,0000,0000,,Бізде таңдау жоқ.
Dialogue: 0,0:06:55.45,0:06:56.99,Bottom,,0000,0000,0000,,Мен мұны білемін.
Dialogue: 0,0:06:55.54,0:06:56.74,Top,,0000,0000,0000,,Мен білемін.
Dialogue: 0,0:06:58.20,0:07:00.79,Bottom,,0000,0000,0000,,Бірақ... мүмкін болатынымды айтуыңыз керек.
Dialogue: 0,0:06:58.33,0:07:00.67,Top,,0000,0000,0000,,‎Бірақ сен айтсаң, мен...
Dialogue: 0,0:07:01.46,0:07:02.79,Bottom,,0000,0000,0000,,Өтінемін…
Dialogue: 0,0:07:01.58,0:07:02.50,Top,,0000,0000,0000,,Мен сенімдімін...
Dialogue: 0,0:07:05.71,0:07:08.51,Bottom,,0000,0000,0000,,Кешіріңіз, Люси. мен…
Dialogue: 0,0:07:05.80,0:07:08.38,Top,,0000,0000,0000,,‎Кешіріңіз, Люси, мен...
Dialogue: 0,0:07:10.13,0:07:12.22,Bottom,,0000,0000,0000,,Мен сенің мұны істей алатыныңды білемін.
Dialogue: 0,0:07:10.30,0:07:13.22,Top,,0000,0000,0000,,Мен мұны істей аламын. Егер бұл сен болсаң... Жоқ.
Dialogue: 0,0:07:12.30,0:07:15.30,Bottom,,0000,0000,0000,,Мен саған сенемін, Люси.
Dialogue: 0,0:07:13.30,0:07:15.05,Top,,0000,0000,0000,,Жасай бер Люси
Dialogue: 0,0:07:17.27,0:07:18.43,Bottom,,0000,0000,0000,,Мен мұны істеймін.
Dialogue: 0,0:07:17.27,0:07:18.43,Top,,0000,0000,0000,,Мен мұны істеймін
Dialogue: 0,0:07:18.52,0:07:19.56,Bottom,,0000,0000,0000,,Жер
Dialogue: 0,0:07:18.52,0:07:19.56,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:19.64,0:07:21.94,Top,,0000,0000,0000,,(Люси) Бірақ тек Дэвидпен.
Dialogue: 0,0:07:19.64,0:07:23.69,Bottom,,0000,0000,0000,,Бірақ Дэвид те келеді. Ал Мэнді қуып жіберіңіз.
Dialogue: 0,0:07:22.02,0:07:25.48,Top,,0000,0000,0000,,Басты кіргізбеңіз, әйтпесе мен мұны істемеймін.
Dialogue: 0,0:07:23.77,0:07:25.40,Bottom,,0000,0000,0000,,Бұл менің шарттарым.
Dialogue: 0,0:07:27.28,0:07:28.03,Top,,0000,0000,0000,,А...
Dialogue: 0,0:07:29.03,0:07:30.24,Bottom,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:07:29.11,0:07:30.32,Top,,0000,0000,0000,,Түсінді
Dialogue: 0,0:07:30.32,0:07:34.07,Bottom,,0000,0000,0000,,Бірақ сіз бізді бақылауда ұстайсыз. Ширек сағат сайын пингтер.
Dialogue: 0,0:07:30.40,0:07:34.07,Top,,0000,0000,0000,,‎Бірақ маған әр 15 минут сайын хабарласыңыз.
Dialogue: 0,0:07:34.16,0:07:36.78,Bottom,,0000,0000,0000,,Таң атқанша уақытыңыз бар. Бұны бұзба!
Dialogue: 0,0:07:34.16,0:07:36.78,Top,,0000,0000,0000,,Таң атқанша тазалаңыз, жарайды.
Dialogue: 0,0:07:37.29,0:07:38.20,Top,,0000,0000,0000,,‎Ха
Dialogue: 0,0:07:38.20,0:07:40.62,Bottom,,0000,0000,0000,,Дэвид! Мэн қайда?
Dialogue: 0,0:07:38.29,0:07:40.46,Top,,0000,0000,0000,,‎Дэвид Мейн ше?
Dialogue: 0,0:07:41.66,0:07:42.58,Top,,0000,0000,0000,,‎Ха…
Dialogue: 0,0:07:42.67,0:07:44.17,Top,,0000,0000,0000,,‎Мен білмеймін (Holocall рингтоны)
Dialogue: 0,0:07:42.67,0:07:44.38,Bottom,,0000,0000,0000,,Білсем тозақ!
Dialogue: 0,0:07:44.17,0:07:44.92,Top,,0000,0000,0000,,(Голоколь қоңырау үні)
Dialogue: 0,0:07:44.92,0:07:47.04,Top,,0000,0000,0000,,‎(шу дыбысы)
Dialogue: 0,0:07:47.04,0:07:48.09,Top,,0000,0000,0000,,(Голоколь қоңырау үні)
Dialogue: 0,0:07:48.17,0:07:51.09,Top,,0000,0000,0000,,‎(Негізгі қадамдар)
Dialogue: 0,0:07:52.55,0:07:53.47,Top,,0000,0000,0000,,Бастысы!
Dialogue: 0,0:07:52.63,0:07:53.47,Bottom,,0000,0000,0000,,Мэн!
Dialogue: 0,0:07:56.97,0:07:59.35,Top,,0000,0000,0000,,А... Дорио?
Dialogue: 0,0:07:58.35,0:07:59.35,Bottom,,0000,0000,0000,,Дорио…
Dialogue: 0,0:08:00.56,0:08:03.60,Top,,0000,0000,0000,,Эй, Дорионың болғаны дұрыс шығар...
Dialogue: 0,0:08:00.60,0:08:03.60,Bottom,,0000,0000,0000,,Ей, бізге сақтық көшірме жасау үшін Дорио қажет емес екеніне сенімдісің бе?
Dialogue: 0,0:08:03.69,0:08:05.19,Bottom,,0000,0000,0000,,Омыртқаны өсір.
Dialogue: 0,0:08:03.69,0:08:05.19,Top,,0000,0000,0000,,‎(Люси) Шешім қабылда.
Dialogue: 0,0:08:05.27,0:08:06.31,Bottom,,0000,0000,0000,,Неге...
Dialogue: 0,0:08:05.27,0:08:06.31,Top,,0000,0000,0000,,Ең алдымен...
Dialogue: 0,0:08:08.23,0:08:09.44,Top,,0000,0000,0000,,Алдымен айтыңыз
Dialogue: 0,0:08:08.27,0:08:09.78,Bottom,,0000,0000,0000,,Сіз маған айтуыңыз керек еді.
Dialogue: 0,0:08:09.86,0:08:12.15,Bottom,,0000,0000,0000,,Неліктен бұл екеуміз ғана болуымыз керек?
Dialogue: 0,0:08:09.98,0:08:12.20,Top,,0000,0000,0000,,Неліктен біз мұны екі адаммен істеуіміз керек?
Dialogue: 0,0:08:12.24,0:08:13.28,Bottom,,0000,0000,0000,,Давид.
Dialogue: 0,0:08:12.28,0:08:13.28,Top,,0000,0000,0000,,‎(Люси) Дэвид
Dialogue: 0,0:08:21.95,0:08:23.96,Bottom,,0000,0000,0000,,H-Эй…
Dialogue: 0,0:08:22.08,0:08:23.83,Top,,0000,0000,0000,,Мм...
Dialogue: 0,0:08:25.04,0:08:25.75,Top,,0000,0000,0000,,А...
Dialogue: 0,0:08:26.13,0:08:30.21,Bottom,,0000,0000,0000,,Неліктен терең сүңгуір портыңызды жасырдыңыз?
Dialogue: 0,0:08:26.33,0:08:30.21,Top,,0000,0000,0000,,Неліктен терең сүңгуір портын жасырдыңыз?
Dialogue: 0,0:08:35.13,0:08:36.39,Bottom,,0000,0000,0000,,Қазір қосылуда…
Dialogue: 0,0:08:35.22,0:08:37.22,Top,,0000,0000,0000,,‎Мен оны саламын (орнату дыбысы)
Dialogue: 0,0:08:40.18,0:08:41.47,Bottom,,0000,0000,0000,,Дэвид…
Dialogue: 0,0:08:40.22,0:08:41.47,Top,,0000,0000,0000,,‎(Люси) Дэвид
Dialogue: 0,0:08:41.56,0:08:42.56,Top,,0000,0000,0000,,Не?
Dialogue: 0,0:08:41.56,0:08:42.64,Bottom,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:43.81,0:08:46.23,Top,,0000,0000,0000,,‎Аа... мен барамын.
Dialogue: 0,0:08:45.06,0:08:46.23,Bottom,,0000,0000,0000,,Мен кіремін.
Dialogue: 0,0:08:50.02,0:08:54.61,Bottom,,0000,0000,0000,,Тұзақ бар жерде кіреберіс болуы керек.
Dialogue: 0,0:08:50.11,0:08:52.44,Top,,0000,0000,0000,,(Люси) Бұл тұзақ болғанын білдіреді.
Dialogue: 0,0:08:52.53,0:08:54.61,Top,,0000,0000,0000,,Бұл кіреберіс екеніне күмән жоқ.
Dialogue: 0,0:08:56.03,0:08:57.20,Top,,0000,0000,0000,,Уф...
Dialogue: 0,0:08:58.37,0:08:59.33,Top,,0000,0000,0000,,‎Фуу
Dialogue: 0,0:09:05.41,0:09:08.13,Top,,0000,0000,0000,,‎(Holo Communication: David) ‎Иә, дұрыс Ең бастысы не?
Dialogue: 0,0:09:08.21,0:09:09.84,Top,,0000,0000,0000,,Мен қазір тынышпын.
Dialogue: 0,0:09:10.71,0:09:13.63,Top,,0000,0000,0000,,‎Эй Дорио, мына жігіт...
Dialogue: 0,0:09:13.71,0:09:16.18,Top,,0000,0000,0000,,‎‎Не? А, жоқ, бұл ештеңе емес.
Dialogue: 0,0:09:19.76,0:09:21.22,Bottom,,0000,0000,0000,,Біз оны өлтіреміз бе?
Dialogue: 0,0:09:19.89,0:09:21.22,Top,,0000,0000,0000,,‎Мен сені өлтіремін бе?
Dialogue: 0,0:09:22.93,0:09:25.06,Bottom,,0000,0000,0000,,Ол орындамаған жағдайда бізге жоспар керек.
Dialogue: 0,0:09:22.97,0:09:25.06,Top,,0000,0000,0000,,‎Сіз уақыт таусылуына дайын болуыңыз керек.
Dialogue: 0,0:09:26.19,0:09:30.06,Bottom,,0000,0000,0000,,Егер сіз өзіңізді жаман сезінбесеңіз, мұның қажеті жоқ еді.
Dialogue: 0,0:09:26.31,0:09:30.06,Top,,0000,0000,0000,,Егер сіз өзіңізді жақсы сезінсеңіз, сізге қажет емес.
Dialogue: 0,0:09:31.15,0:09:33.32,Top,,0000,0000,0000,,‎(Holocall рингтоны) ‎Хмм?
Dialogue: 0,0:09:33.90,0:09:35.19,Top,,0000,0000,0000,,‎Бұл не үшін?
Dialogue: 0,0:09:35.28,0:09:38.32,Top,,0000,0000,0000,,(Фарадей) Деректер әлі бар ма? Қазір істеп жатыр
Dialogue: 0,0:09:38.41,0:09:41.45,Top,,0000,0000,0000,,(Фарадей) Бұл көп уақытты алады. Кім істеп жатыр?
Dialogue: 0,0:09:41.53,0:09:43.29,Top,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:09:43.79,0:09:46.46,Top,,0000,0000,0000,,Негізгі Сіз бірдеңені жасырып жатырсыз, солай ма?
Dialogue: 0,0:09:46.54,0:09:47.71,Top,,0000,0000,0000,,Әй?
Dialogue: 0,0:09:47.79,0:09:49.96,Top,,0000,0000,0000,,‎(Фарадей) ‎Оны кивисіз жасауға болады ма?
Dialogue: 0,0:09:50.04,0:09:52.80,Top,,0000,0000,0000,,‎Неге... Чит, Фалько?
Dialogue: 0,0:09:53.30,0:09:54.88,Top,,0000,0000,0000,,‎(Фарадей) ‎Сақтық көшірмешілер үшін
Dialogue: 0,0:09:53.30,0:09:56.42,Bottom,,0000,0000,0000,,Сіз резервтік жүгірушіге бәрін тігуге дайынсыз ба?
Dialogue: 0,0:09:54.96,0:09:56.34,Top,,0000,0000,0000,,Жүк ауыр емес пе?
Dialogue: 0,0:09:56.42,0:09:57.76,Top,,0000,0000,0000,,Мәселе жоқ
Dialogue: 0,0:09:56.51,0:09:57.84,Bottom,,0000,0000,0000,,Мүлдем.
Dialogue: 0,0:09:57.84,0:09:59.30,Top,,0000,0000,0000,,(Фарадей) Тек асығыңыз!
Dialogue: 0,0:09:57.93,0:09:59.26,Bottom,,0000,0000,0000,,Тик, Мэн.
Dialogue: 0,0:09:59.34,0:10:02.47,Bottom,,0000,0000,0000,,Арасака әлі қысқа бір басшы.
Dialogue: 0,0:09:59.39,0:10:02.14,Top,,0000,0000,0000,,Мен тікелей Арасака басшыларына хабарластым.
Dialogue: 0,0:10:02.56,0:10:04.77,Bottom,,0000,0000,0000,,Қатеге орын жоқ екенін түсінетініңізге сенемін.
Dialogue: 0,0:10:02.76,0:10:04.68,Top,,0000,0000,0000,,‎Бұл жолы сәтсіздікке жол берілмейді
Dialogue: 0,0:10:04.77,0:10:05.93,Top,,0000,0000,0000,,Мен білемін
Dialogue: 0,0:10:04.85,0:10:05.93,Bottom,,0000,0000,0000,,Мұны анық көрсетті.
Dialogue: 0,0:10:07.77,0:10:08.98,Bottom,,0000,0000,0000,,Сабаққа қатыса алмайтыны үшін оған ерекше қарайды...
Dialogue: 0,0:10:07.77,0:10:08.98,Top,,0000,0000,0000,,Не!
Dialogue: 0,0:10:09.90,0:10:11.65,Bottom,,0000,0000,0000,,Фарадей, сен қарап тұрсың ба?
Dialogue: 0,0:10:09.90,0:10:12.23,Top,,0000,0000,0000,,‎Не қарап тұрсың, Фарах... ‎(құлап кеткен дыбыс)
Dialogue: 0,0:10:12.32,0:10:14.98,Top,,0000,0000,0000,,‎(Жаңбыр дыбысы)
Dialogue: 0,0:10:16.99,0:10:18.36,Top,,0000,0000,0000,,‎(Танаканың жөтелі)
Dialogue: 0,0:10:19.07,0:10:20.28,Top,,0000,0000,0000,,‎(шу дыбысы)
Dialogue: 0,0:10:20.74,0:10:22.16,Bottom,,0000,0000,0000,,Ақау...?
Dialogue: 0,0:10:20.82,0:10:22.16,Top,,0000,0000,0000,,‎(Люси) ‎Тұрақты емес пе?
Dialogue: 0,0:10:22.24,0:10:22.87,Top,,0000,0000,0000,,(Танака жөтеледі)
Dialogue: 0,0:10:22.87,0:10:25.16,Top,,0000,0000,0000,,Қарғыс атқыр, кенеттен не болды?
Dialogue: 0,0:10:23.03,0:10:25.16,Bottom,,0000,0000,0000,,Қарғыс атсын... Енді барлық уақытта!
Dialogue: 0,0:10:25.95,0:10:27.29,Top,,0000,0000,0000,,‎(орындықтың сықырлаған дыбысы)
Dialogue: 0,0:10:29.12,0:10:30.46,Bottom,,0000,0000,0000,,Күту…
Dialogue: 0,0:10:29.17,0:10:31.58,Top,,0000,0000,0000,,‎Ал... күте тұрыңыз, күтіңіз.
Dialogue: 0,0:10:30.54,0:10:31.54,Bottom,,0000,0000,0000,,Күте тұрыңыз, өтінемін!
Dialogue: 0,0:10:31.63,0:10:32.88,Bottom,,0000,0000,0000,,Давид!
Dialogue: 0,0:10:31.67,0:10:32.88,Top,,0000,0000,0000,,Дэвид!
Dialogue: 0,0:10:33.38,0:10:34.59,Top,,0000,0000,0000,,‎(инъекция дыбысы)
Dialogue: 0,0:10:35.38,0:10:38.80,Top,,0000,0000,0000,,‎Тамаша... Ей Басты ‎Мықты бол!
Dialogue: 0,0:10:36.76,0:10:38.80,Bottom,,0000,0000,0000,,Мэн! Одан құтыл!
Dialogue: 0,0:10:38.88,0:10:39.63,Top,,0000,0000,0000,,‎Эй!
Dialogue: 0,0:10:38.88,0:10:40.05,Bottom,,0000,0000,0000,,Бір сәт те жоғалтуға болмайды.
Dialogue: 0,0:10:40.72,0:10:43.35,Bottom,,0000,0000,0000,,Қарғыс атсын! Ол неге оянып жатыр?!
Dialogue: 0,0:10:40.80,0:10:43.60,Top,,0000,0000,0000,,(Люси) Қарғыс атсын, анестезия бітті.
Dialogue: 0,0:10:44.10,0:10:45.77,Bottom,,0000,0000,0000,,Не істеп жатырсың, Дэвид?!
Dialogue: 0,0:10:44.18,0:10:45.77,Top,,0000,0000,0000,,‎Сен не істеп жатырсың, Дэвид?
Dialogue: 0,0:10:47.64,0:10:50.69,Top,,0000,0000,0000,,‎(Танаканың ауыр тыныс алуы)
Dialogue: 0,0:10:51.31,0:10:54.52,Bottom,,0000,0000,0000,,Мен мұны білдім... Сіз Дэвидсіз...
Dialogue: 0,0:10:51.40,0:10:54.40,Top,,0000,0000,0000,,Бұл сенсің, Дэвид.
Dialogue: 0,0:10:55.52,0:10:56.65,Bottom,,0000,0000,0000,,Қалайсыз?
Dialogue: 0,0:10:55.57,0:10:56.53,Top,,0000,0000,0000,,Неліктен...
Dialogue: 0,0:10:57.69,0:11:00.91,Bottom,,0000,0000,0000,,Мен сен туралы көп естідім.
Dialogue: 0,0:10:57.78,0:11:00.95,Top,,0000,0000,0000,,‎Сіз туралы мен түрлі хабарламалар алдым.
Dialogue: 0,0:11:00.99,0:11:05.24,Bottom,,0000,0000,0000,,Академияда менің баламмен болған оқиғаңыз...
Dialogue: 0,0:11:01.03,0:11:04.70,Top,,0000,0000,0000,,Катсуо екеуіңнің араларыңда мәселе болғанын да білемін.
Dialogue: 0,0:11:04.78,0:11:06.83,Top,,0000,0000,0000,,‎Geho geho haa…
Dialogue: 0,0:11:06.91,0:11:11.17,Top,,0000,0000,0000,,Сонымен қатар, мен саған мектепке қайтуды бұйырдым.
Dialogue: 0,0:11:06.91,0:11:11.29,Bottom,,0000,0000,0000,,Соған қарамастан мен сізді Академияға қайта қабылдауға бұйрық бердім.
Dialogue: 0,0:11:11.25,0:11:12.58,Top,,0000,0000,0000,,Сіз?
Dialogue: 0,0:11:11.37,0:11:12.58,Bottom,,0000,0000,0000,,Сіз?
Dialogue: 0,0:11:12.67,0:11:15.96,Top,,0000,0000,0000,,‎Өтінемін, Дэвид, маған көмектесші.
Dialogue: 0,0:11:12.67,0:11:16.00,Bottom,,0000,0000,0000,,Өтінемін, Дэвид. Сіз мұны тоқтата аласыз.
Dialogue: 0,0:11:16.92,0:11:19.59,Bottom,,0000,0000,0000,,Менің өлгім келмейді.
Dialogue: 0,0:11:17.00,0:11:19.22,Top,,0000,0000,0000,,Менің әлі өлгім келмейді
Dialogue: 0,0:11:19.67,0:11:21.84,Bottom,,0000,0000,0000,,Бізге тек деректер керек. Сіз...
Dialogue: 0,0:11:19.72,0:11:21.84,Top,,0000,0000,0000,,Тек деректерді шығарып алыңыз, Өлтіріңіз...
Dialogue: 0,0:11:21.93,0:11:23.72,Bottom,,0000,0000,0000,,Сонша аңғал болма!
Dialogue: 0,0:11:21.93,0:11:23.80,Top,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:11:23.89,0:11:26.85,Top,,0000,0000,0000,,‎Ха... Мен олардың жүздерін көрдім.
Dialogue: 0,0:11:25.14,0:11:26.85,Bottom,,0000,0000,0000,,Мен олардың жүздерін көрдім!
Dialogue: 0,0:11:26.93,0:11:29.60,Bottom,,0000,0000,0000,,Арасака оларды ауламайды деп сенесіз бе?
Dialogue: 0,0:11:26.93,0:11:29.60,Top,,0000,0000,0000,,‎Ол әлі де жойылмаса ше?
Dialogue: 0,0:11:30.52,0:11:34.98,Bottom,,0000,0000,0000,,Мені тыңда. Неліктен мен сіздің шығарылымыңызды алып тастадым деп ойлайсыз?
Dialogue: 0,0:11:30.64,0:11:34.40,Top,,0000,0000,0000,,‎Тыңдаңыз, олар сізді неге қайта қалпына келтірді деп ойлайсыз?
Dialogue: 0,0:11:35.06,0:11:38.40,Bottom,,0000,0000,0000,,Сізде ерекше қабілеттер бар.
Dialogue: 0,0:11:35.27,0:11:37.98,Top,,0000,0000,0000,,‎Себебі сіз құнды ресурссыз.
Dialogue: 0,0:11:38.48,0:11:41.61,Bottom,,0000,0000,0000,,Менің ойымша, сіз Арасака үшін құнды байлық бола аласыз!
Dialogue: 0,0:11:38.61,0:11:41.61,Top,,0000,0000,0000,,‎Бұл Арасакаға пайдалы болады деп ойлаймын.
Dialogue: 0,0:11:42.28,0:11:45.87,Bottom,,0000,0000,0000,,Біз саған үлкен болашақ сыйлай аламыз, Дэвид!
Dialogue: 0,0:11:42.32,0:11:45.87,Top,,0000,0000,0000,,Болашақ уәде етілген, Дэвид
Dialogue: 0,0:11:45.95,0:11:47.99,Bottom,,0000,0000,0000,,Өміріңді босқа өткізбе!
Dialogue: 0,0:11:45.95,0:11:47.99,Top,,0000,0000,0000,,‎Өміріңді босқа өткізбе!
Dialogue: 0,0:11:48.49,0:11:50.75,Top,,0000,0000,0000,,‎(шу дыбысы)
Dialogue: 0,0:11:58.84,0:11:59.76,Bottom,,0000,0000,0000,,Сен шынымен де мазаңды аларсың, иә?
Dialogue: 0,0:11:58.84,0:11:59.76,Top,,0000,0000,0000,,(Люси) Бұл ма?
Dialogue: 0,0:12:00.72,0:12:01.72,Top,,0000,0000,0000,,‎Ха!
Dialogue: 0,0:12:07.93,0:12:09.93,Top,,0000,0000,0000,,‎(Деректерді тасымалдау дыбысы)
Dialogue: 0,0:12:11.23,0:12:13.39,Bottom,,0000,0000,0000,,Мен сені жібере алмаймын.
Dialogue: 0,0:12:11.27,0:12:13.39,Top,,0000,0000,0000,,Мен сенің қашып кетуіңе жол бере алмаймын.
Dialogue: 0,0:12:13.48,0:12:15.56,Bottom,,0000,0000,0000,,Содан кейін Арасакамен байланысыңыз.
Dialogue: 0,0:12:13.48,0:12:15.60,Top,,0000,0000,0000,,Арасака есеп беру
Dialogue: 0,0:12:15.65,0:12:19.19,Bottom,,0000,0000,0000,,Барлығы бес минутқа жетпей бітеді.
Dialogue: 0,0:12:15.69,0:12:19.02,Top,,0000,0000,0000,,Басқа ештеңе істеудің қажеті жоқ. Ол 5 минутта дайын болады.
Dialogue: 0,0:12:19.11,0:12:22.28,Top,,0000,0000,0000,,‎Менің айтқым келгені бұл емес еді. Мен достарыма опасыздық жасай алмаймын.
Dialogue: 0,0:12:19.28,0:12:20.90,Bottom,,0000,0000,0000,,Менің айтайын дегенім бұл емес!
Dialogue: 0,0:12:20.99,0:12:22.28,Bottom,,0000,0000,0000,,Мен экипажыма опасыздық жасай алмаймын.
Dialogue: 0,0:12:22.36,0:12:26.28,Bottom,,0000,0000,0000,,Ақымақ бала. Сізді пайдаланып жатқаныңызды көрмейсіз бе?
Dialogue: 0,0:12:22.36,0:12:26.28,Top,,0000,0000,0000,,Сен ақымақ! Пунч сызығы бір реттік болуы керек.
Dialogue: 0,0:12:26.37,0:12:28.78,Bottom,,0000,0000,0000,,Ал Арасака емес пе?
Dialogue: 0,0:12:26.37,0:12:28.78,Top,,0000,0000,0000,,‎Арасакаға қосылсаң да солай.
Dialogue: 0,0:12:28.87,0:12:31.08,Bottom,,0000,0000,0000,,Жоқ. Сіз соқырсыз.
Dialogue: 0,0:12:28.87,0:12:31.33,Top,,0000,0000,0000,,‎Жоқ, түсінбедіңіз бе?
Dialogue: 0,0:12:31.16,0:12:34.67,Bottom,,0000,0000,0000,,Бұл трюк үшін кім төлейді деп ойлайсыз?
Dialogue: 0,0:12:31.41,0:12:34.71,Top,,0000,0000,0000,,Милитех бәрібір ақша төлейтін шығар.
Dialogue: 0,0:12:34.75,0:12:38.54,Bottom,,0000,0000,0000,,Оның барлық жағында Militech деп жазылған. Барлық жолдар корпорацияларға апарады.
Dialogue: 0,0:12:34.79,0:12:38.54,Top,,0000,0000,0000,,‎Сендер компания атынан қолдарыңды былғап жатырсыңдар.
Dialogue: 0,0:12:38.63,0:12:41.38,Bottom,,0000,0000,0000,,Бұл дүниеде қанша биікке көтерілсең де,
Dialogue: 0,0:12:38.63,0:12:44.18,Top,,0000,0000,0000,,‎Ол әлемде қаншалықты биікке көтерілсеңіз де, сіз әлі де корпоративтік корпорацияның ең төменгі деңгейінен төменсіз.
Dialogue: 0,0:12:41.46,0:12:44.59,Bottom,,0000,0000,0000,,сіз ешқашан ең төменгі корпусты құра алмайсыз.
Dialogue: 0,0:12:44.68,0:12:46.05,Bottom,,0000,0000,0000,,Бұл емес…
Dialogue: 0,0:12:44.72,0:12:46.05,Top,,0000,0000,0000,,Мұндай нәрсе...
Dialogue: 0,0:12:54.27,0:12:55.81,Top,,0000,0000,0000,,‎(шу дыбысы)
Dialogue: 0,0:12:56.40,0:12:57.69,Top,,0000,0000,0000,,Ға!
Dialogue: 0,0:12:57.77,0:13:00.82,Top,,0000,0000,0000,,‎(негізгі жөтел)
Dialogue: 0,0:13:01.53,0:13:04.95,Top,,0000,0000,0000,,‎(Голокольдық үн)
Dialogue: 0,0:13:05.61,0:13:06.45,Bottom,,0000,0000,0000,,Дэвид?
Dialogue: 0,0:13:05.61,0:13:06.45,Top,,0000,0000,0000,,Дэвид?
Dialogue: 0,0:13:06.53,0:13:07.57,Top,,0000,0000,0000,,(Голоколь қоңырау үні)
Dialogue: 0,0:13:07.57,0:13:10.70,Top,,0000,0000,0000,,‎Эй, Дэвид, сен...
Dialogue: 0,0:13:07.57,0:13:10.74,Bottom,,0000,0000,0000,,Дэвид… Не…
Dialogue: 0,0:13:10.79,0:13:13.50,Top,,0000,0000,0000,,Сіз шынымен не істегіңіз келеді?
Dialogue: 0,0:13:10.83,0:13:13.79,Bottom,,0000,0000,0000,,Сізге не керек?
Dialogue: 0,0:13:13.58,0:13:14.21,Top,,0000,0000,0000,,А...
Dialogue: 0,0:13:15.41,0:13:16.25,Top,,0000,0000,0000,,Не...
Dialogue: 0,0:13:15.50,0:13:17.33,Bottom,,0000,0000,0000,,Маған не керек...?
Dialogue: 0,0:13:16.25,0:13:17.21,Top,,0000,0000,0000,,‎Не… (рингтонды тоқтатады)
Dialogue: 0,0:13:17.29,0:13:18.50,Top,,0000,0000,0000,,‎(есіктің тарсылдаған дыбысы)
Dialogue: 0,0:13:19.08,0:13:21.38,Top,,0000,0000,0000,,‎(Есіктің сынған дыбысы) ‎Дэвид, не істеп жатырсың!
Dialogue: 0,0:13:19.75,0:13:21.17,Bottom,,0000,0000,0000,,Дэвид! Не болды?!
Dialogue: 0,0:13:21.25,0:13:22.09,Bottom,,0000,0000,0000,,Ол ояу!
Dialogue: 0,0:13:21.46,0:13:23.63,Top,,0000,0000,0000,,Сіз ояусыз. Дэвид, сізде дәрі бар ма?
Dialogue: 0,0:13:22.17,0:13:24.97,Bottom,,0000,0000,0000,,Оның тыныштығы қайда... Беріңіз!
Dialogue: 0,0:13:24.13,0:13:24.97,Top,,0000,0000,0000,,Қарыз бер!
Dialogue: 0,0:13:25.05,0:13:25.93,Top,,0000,0000,0000,,Уау!
Dialogue: 0,0:13:26.01,0:13:26.72,Top,,0000,0000,0000,,‎(ұшқын дыбысы)
Dialogue: 0,0:13:26.80,0:13:28.72,Bottom,,0000,0000,0000,,Бля! Жаңа ғана не болды?!
Dialogue: 0,0:13:26.80,0:13:28.72,Top,,0000,0000,0000,,‎(Дабыл дыбысы) ‎Бәрекелді, не болды?
Dialogue: 0,0:13:29.30,0:13:32.10,Bottom,,0000,0000,0000,,Қат! Егер ол тегіс болса, бәрі бітеді!
Dialogue: 0,0:13:29.43,0:13:32.06,Top,,0000,0000,0000,,Жаман! Қазір өлсем, бітті!
Dialogue: 0,0:13:32.14,0:13:33.02,Top,,0000,0000,0000,,Дэвид!
Dialogue: 0,0:13:32.18,0:13:33.02,Bottom,,0000,0000,0000,,Давид!
Dialogue: 0,0:13:33.10,0:13:37.10,Top,,0000,0000,0000,,Мықты бол, Дэвид. Сіз оны орнаттыңыз!
Dialogue: 0,0:13:33.10,0:13:37.14,Bottom,,0000,0000,0000,,Одан құтыл, Дэвид! Сіз оны кіргіздіңіз, солай ма?!
Dialogue: 0,0:13:37.19,0:13:38.35,Top,,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:13:37.23,0:13:38.35,Bottom,,0000,0000,0000,,Енді оны шығарыңыз!
Dialogue: 0,0:13:38.94,0:13:41.23,Bottom,,0000,0000,0000,,Дорио! Люси әлі де терең суға түсуде!
Dialogue: 0,0:13:38.94,0:13:41.23,Top,,0000,0000,0000,,Долио Люси терең сүңгумен айналысады
Dialogue: 0,0:13:41.32,0:13:41.98,Top,,0000,0000,0000,,Не!
Dialogue: 0,0:13:41.32,0:13:43.98,Bottom,,0000,0000,0000,,-Не?! -Асығыңыз! Оны ажыратыңыз!
Dialogue: 0,0:13:42.07,0:13:43.98,Top,,0000,0000,0000,,‎Тез ажыратыңыз!
Dialogue: 0,0:13:44.07,0:13:45.07,Top,,0000,0000,0000,,‎Пісіру…
Dialogue: 0,0:13:45.90,0:13:46.61,Top,,0000,0000,0000,,Жарайды
Dialogue: 0,0:13:46.07,0:13:47.74,Bottom,,0000,0000,0000,,Жарайды! Оны шығарыңыз!
Dialogue: 0,0:13:46.70,0:13:47.74,Top,,0000,0000,0000,,Оны тартып алыңыз!
Dialogue: 0,0:13:48.53,0:13:49.20,Top,,0000,0000,0000,,‎ (инъекция дыбысы)
Dialogue: 0,0:13:49.28,0:13:49.95,Top,,0000,0000,0000,,‎(Боху!)
Dialogue: 0,0:13:58.54,0:13:59.21,Top,,0000,0000,0000,,‎Ха…
Dialogue: 0,0:14:00.29,0:14:02.59,Top,,0000,0000,0000,,‎(Люси) Фу... Деректер дұрыс па?
Dialogue: 0,0:14:01.21,0:14:02.59,Bottom,,0000,0000,0000,,Деректер?
Dialogue: 0,0:14:02.67,0:14:05.63,Top,,0000,0000,0000,,Бәлкім, оның жүрегі тоқтап, дереу емделді.
Dialogue: 0,0:14:02.67,0:14:05.76,Bottom,,0000,0000,0000,,Жүрегі тоқтаған соң оны ұрды... жақсы шығар.
Dialogue: 0,0:14:06.59,0:14:07.97,Bottom,,0000,0000,0000,,Дэвид!
Dialogue: 0,0:14:06.67,0:14:07.97,Top,,0000,0000,0000,,Дэвид!
Dialogue: 0,0:14:08.05,0:14:10.09,Bottom,,0000,0000,0000,,Иә, Люсидікі...
Dialogue: 0,0:14:08.05,0:14:10.43,Top,,0000,0000,0000,,О, Люси де жақсы...
Dialogue: 0,0:14:12.30,0:14:15.14,Top,,0000,0000,0000,,‎Дэвид, сен не істеп жүрсің!
Dialogue: 0,0:14:12.30,0:14:15.35,Bottom,,0000,0000,0000,,Дэвид! Не істеп жүр едің?
Dialogue: 0,0:14:16.18,0:14:17.85,Bottom,,0000,0000,0000,,Дегенмен, мақсат-мұратыңа жету қаншалықты бос әрі мағынасыз екенін сездіреді.
Dialogue: 0,0:14:16.31,0:14:17.85,Top,,0000,0000,0000,,‎Сен жалғызсың
Dialogue: 0,0:14:17.94,0:14:20.35,Bottom,,0000,0000,0000,,Сен не істеп жүрсің?
Dialogue: 0,0:14:17.94,0:14:20.35,Top,,0000,0000,0000,,‎Сен не істеп жүрсің!
Dialogue: 0,0:14:20.44,0:14:21.86,Bottom,,0000,0000,0000,,Сіз не айттыңыз?
Dialogue: 0,0:14:20.44,0:14:21.90,Top,,0000,0000,0000,,Не?
Dialogue: 0,0:14:21.94,0:14:25.73,Bottom,,0000,0000,0000,,Кивиді нокаутқа түсіру... Мұның бәрін Люсидің тізесіне тастау.
Dialogue: 0,0:14:21.98,0:14:25.82,Top,,0000,0000,0000,,‎Кивиді басыңыз, Люсиге бәрін басыңыз.
Dialogue: 0,0:14:25.82,0:14:28.07,Bottom,,0000,0000,0000,,Саған не болды?!
Dialogue: 0,0:14:25.90,0:14:28.11,Top,,0000,0000,0000,,Мен сенен не істеп жатқаныңды сұрадым!
Dialogue: 0,0:14:28.15,0:14:29.86,Bottom,,0000,0000,0000,,Бала, бастама...
Dialogue: 0,0:14:28.20,0:14:29.86,Top,,0000,0000,0000,,Дэвид...
Dialogue: 0,0:14:29.95,0:14:31.37,Bottom,,0000,0000,0000,,Мэн! Дэвид!
Dialogue: 0,0:14:29.95,0:14:31.37,Top,,0000,0000,0000,,Бас Дэвид!
Dialogue: 0,0:14:31.45,0:14:32.12,Top,,0000,0000,0000,,А?
Dialogue: 0,0:14:32.03,0:14:36.58,Bottom,,0000,0000,0000,,Танака тегістелгенде Джаммер қуырып қалды! Жарақат тобы сигналды ұстады!
Dialogue: 0,0:14:32.20,0:14:36.16,Top,,0000,0000,0000,,Бұрынғы жалған чипке шабуыл жасалды. Травматологтар тобы сигнал жіберіп жатыр.
Dialogue: 0,0:14:36.66,0:14:37.87,Bottom,,0000,0000,0000,,Анашым!
Dialogue: 0,0:14:36.66,0:14:37.87,Top,,0000,0000,0000,,Қат!
Dialogue: 0,0:14:38.96,0:14:40.25,Top,,0000,0000,0000,,‎(мылтық дыбысы)
Dialogue: 0,0:14:40.33,0:14:42.46,Bottom,,0000,0000,0000,,Дэвид, біз әлі біткен жоқпыз!
Dialogue: 0,0:14:40.33,0:14:42.46,Top,,0000,0000,0000,,‎Дэвид, кейінірек сөйлес.
Dialogue: 0,0:14:42.54,0:14:43.79,Top,,0000,0000,0000,,Көлікті дайындаңыз!
Dialogue: 0,0:14:42.54,0:14:44.50,Bottom,,0000,0000,0000,,Бірақ доңғалақтарымызды дайында, тез!
Dialogue: 0,0:14:43.88,0:14:45.05,Top,,0000,0000,0000,,‎(мылтық дыбысы)
Dialogue: 0,0:14:45.13,0:14:46.09,Top,,0000,0000,0000,,‎(соққы дыбысы)
Dialogue: 0,0:14:46.05,0:14:47.72,Bottom,,0000,0000,0000,,Оны жина, Дэвид!
Dialogue: 0,0:14:46.17,0:14:47.72,Top,,0000,0000,0000,,‎Мықты бол, Дэвид!
Dialogue: 0,0:14:47.80,0:14:49.93,Top,,0000,0000,0000,,Жасай бер! Жаса!
Dialogue: 0,0:14:47.80,0:14:50.34,Bottom,,0000,0000,0000,,Сіз бұл үшін ерікті болдыңыз, солай істеңіз!
Dialogue: 0,0:14:51.55,0:14:53.76,Top,,0000,0000,0000,,Мен бірден келемін, төменде күтіңіз.
Dialogue: 0,0:14:51.72,0:14:53.72,Bottom,,0000,0000,0000,,Жолда күтіңіз. Біз жетеміз.
Dialogue: 0,0:14:53.80,0:14:54.97,Bottom,,0000,0000,0000,,Жүріңдер, асығыңдар, жігіттер
Dialogue: 0,0:14:53.85,0:14:55.47,Top,,0000,0000,0000,,‎Мен білемін ‎(имплантантты белсендіру дыбысы)
Dialogue: 0,0:14:57.31,0:14:59.35,Top,,0000,0000,0000,,‎Ол платинамен үйлесімді ме?
Dialogue: 0,0:14:57.31,0:14:59.56,Bottom,,0000,0000,0000,,"Платина" премиум жоспары қызметі...
Dialogue: 0,0:14:59.44,0:15:00.39,Top,,0000,0000,0000,,Дорио!
Dialogue: 0,0:14:59.64,0:15:00.60,Bottom,,0000,0000,0000,,Дорио!
Dialogue: 0,0:15:05.36,0:15:08.40,Bottom,,0000,0000,0000,,Қызмет көрсету аймағында атыстарды тіркеу.
Dialogue: 0,0:15:05.44,0:15:08.11,Top,,0000,0000,0000,,‎(жарақат мүшесі) ‎Нисана нүктеге жақын жерде атыс дыбысы естілді.
Dialogue: 0,0:15:08.49,0:15:13.57,Bottom,,0000,0000,0000,,Бар болуы мүмкін дұшпандық. NCPD сақтық көшірмесін сұрау күшінде.
Dialogue: 0,0:15:08.61,0:15:13.57,Top,,0000,0000,0000,,Қарулы кедергінің болуы мүмкін. NCPD-ден қолдау сұраңыз.
Dialogue: 0,0:15:16.37,0:15:17.29,Top,,0000,0000,0000,,‎(есік жабылған дыбыс)
Dialogue: 0,0:15:18.37,0:15:19.66,Top,,0000,0000,0000,,(қатты радио музыка)
Dialogue: 0,0:15:19.66,0:15:20.41,Top,,0000,0000,0000,,Уф...
Dialogue: 0,0:15:20.41,0:15:21.17,Top,,0000,0000,0000,,(қатты радио музыка)
Dialogue: 0,0:15:22.83,0:15:23.79,Top,,0000,0000,0000,,‎(радио аялдама)
Dialogue: 0,0:15:23.88,0:15:25.54,Top,,0000,0000,0000,,‎(Люси) Дэвид…
Dialogue: 0,0:15:24.38,0:15:25.92,Bottom,,0000,0000,0000,,Дэвид?
Dialogue: 0,0:15:25.63,0:15:27.67,Top,,0000,0000,0000,,А... Люси! Сенімен бәрі жақсы ма?
Dialogue: 0,0:15:26.00,0:15:27.67,Bottom,,0000,0000,0000,,Люси! Сіз жақсы ма?
Dialogue: 0,0:15:28.26,0:15:30.42,Bottom,,0000,0000,0000,,Не болып жатыр?
Dialogue: 0,0:15:28.26,0:15:30.51,Top,,0000,0000,0000,,‎(Люси) Не болып жатыр?
Dialogue: 0,0:15:30.51,0:15:34.39,Bottom,,0000,0000,0000,,Танака оянып кетті, бірақ оның миы неге екені белгісіз кенет қуырып кетті.
Dialogue: 0,0:15:30.59,0:15:34.18,Top,,0000,0000,0000,,Мен Танака оянды деп ойласам, оның миы қуырылған...
Dialogue: 0,0:15:35.76,0:15:37.77,Bottom,,0000,0000,0000,,Онда бірдеңе болды ма?
Dialogue: 0,0:15:35.80,0:15:37.39,Top,,0000,0000,0000,,Ішінде бірдеңе болды ма?
Dialogue: 0,0:15:37.85,0:15:39.60,Bottom,,0000,0000,0000,,Мэн мен Дорио қайда?
Dialogue: 0,0:15:37.89,0:15:39.56,Top,,0000,0000,0000,,‎(Люси) Мейн мен Дорио ше?
Dialogue: 0,0:15:39.64,0:15:41.60,Top,,0000,0000,0000,,‎Танаканы алғаннан кейін...
Dialogue: 0,0:15:39.68,0:15:41.81,Bottom,,0000,0000,0000,,Олар Танаканың денесін әкеліп жатыр...
Dialogue: 0,0:15:41.69,0:15:43.31,Top,,0000,0000,0000,,‎(Люси) Иә? Ол өлді...
Dialogue: 0,0:15:42.35,0:15:43.31,Bottom,,0000,0000,0000,,Бірақ ол өлді.
Dialogue: 0,0:15:43.40,0:15:44.77,Top,,0000,0000,0000,,Реанимация
Dialogue: 0,0:15:43.40,0:15:44.98,Bottom,,0000,0000,0000,,Біз оны құтқардық.
Dialogue: 0,0:15:44.86,0:15:46.36,Top,,0000,0000,0000,,‎Ха... неге!
Dialogue: 0,0:15:45.52,0:15:46.65,Bottom,,0000,0000,0000,,Неге?!
Dialogue: 0,0:15:46.73,0:15:49.11,Bottom,,0000,0000,0000,,Сіз нені айтасыз? Бізге әлі де деректер қажет.
Dialogue: 0,0:15:46.86,0:15:49.11,Top,,0000,0000,0000,,Неліктен әлі күнге дейін деректер жоқ?
Dialogue: 0,0:15:49.19,0:15:51.20,Bottom,,0000,0000,0000,,Оны әкелудің қажеті жоқ.
Dialogue: 0,0:15:49.19,0:15:51.20,Top,,0000,0000,0000,,‎Танаканы әкелудің қажеті жоқ.
Dialogue: 0,0:15:52.20,0:15:53.66,Top,,0000,0000,0000,,Деректер болған жоқ
Dialogue: 0,0:15:52.20,0:15:53.86,Bottom,,0000,0000,0000,,Деректер болған жоқ.
Dialogue: 0,0:15:53.74,0:15:54.95,Top,,0000,0000,0000,,Е...
Dialogue: 0,0:15:55.70,0:15:57.20,Bottom,,0000,0000,0000,,Мүмкін емес...
Dialogue: 0,0:15:55.87,0:15:56.78,Top,,0000,0000,0000,,Бұл өтірік, солай ма?
Dialogue: 0,0:15:57.79,0:16:00.79,Bottom,,0000,0000,0000,,Бля. Біз қазір міндетті түрде Сақа радарындамыз.
Dialogue: 0,0:15:57.87,0:15:58.91,Top,,0000,0000,0000,,Қарғыс атсын енді Арасака да білді.
Dialogue: 0,0:15:58.91,0:16:00.58,Top,,0000,0000,0000,,Қарғыс атсын, енді Арасака да білді (инъекция дыбысы)
Dialogue: 0,0:16:00.66,0:16:03.83,Top,,0000,0000,0000,,Негізгі ингибитор Ұмытпаңыз
Dialogue: 0,0:16:00.87,0:16:03.83,Bottom,,0000,0000,0000,,Мэн! Дәрілеріңізді қабылдауды ұмытпаңыз!
Dialogue: 0,0:16:04.42,0:16:05.63,Bottom,,0000,0000,0000,,Жай ғана сурет түсірдім!
Dialogue: 0,0:16:04.42,0:16:06.29,Top,,0000,0000,0000,,‎Енді соқтыңыз! (Травма мүшесі) Қозғалмаңыз!
Dialogue: 0,0:16:05.71,0:16:06.54,Bottom,,0000,0000,0000,,Қозғалмаңыз!
Dialogue: 0,0:16:06.38,0:16:07.75,Top,,0000,0000,0000,,‎(мылтық дыбысы)
Dialogue: 0,0:16:11.09,0:16:13.84,Top,,0000,0000,0000,,‎(қашықтан ату)
Dialogue: 0,0:16:14.68,0:16:19.60,Bottom,,0000,0000,0000,,Бля! Неліктен NCPD бізге келгенде әрқашан жылдам?
Dialogue: 0,0:16:14.80,0:16:17.39,Top,,0000,0000,0000,,Осы NCPD жігіттеріне қарғыс атсын.
Dialogue: 0,0:16:17.47,0:16:21.60,Top,,0000,0000,0000,,‎Осындай кезде маған тек тез жұмыс істеу керек. Артқы жағына барыңыз! Артқы жағына барыңыз!
Dialogue: 0,0:16:19.68,0:16:21.60,Bottom,,0000,0000,0000,,Сақтық көшірме жасау! Артқы жағына барыңыз!
Dialogue: 0,0:16:21.68,0:16:23.10,Top,,0000,0000,0000,,‎(шу дыбысы)
Dialogue: 0,0:16:23.19,0:16:25.35,Bottom,,0000,0000,0000,,Бля! Олар көтермейді!
Dialogue: 0,0:16:23.69,0:16:25.19,Top,,0000,0000,0000,,Қарғыс атсын, мен қосыла алмаймын.
Dialogue: 0,0:16:25.27,0:16:26.11,Top,,0000,0000,0000,,‎(есіктің ашылған дыбысы)
Dialogue: 0,0:16:26.19,0:16:27.11,Bottom,,0000,0000,0000,,Дэвид!
Dialogue: 0,0:16:26.19,0:16:28.40,Top,,0000,0000,0000,,(Люси) Дэвид, қайда бара жатырсың?
Dialogue: 0,0:16:27.19,0:16:28.40,Bottom,,0000,0000,0000,,Қайда бара жатырсың?
Dialogue: 0,0:16:28.48,0:16:29.32,Bottom,,0000,0000,0000,,Көмекке барамын.
Dialogue: 0,0:16:28.48,0:16:29.44,Top,,0000,0000,0000,,Көмекке барыңыз
Dialogue: 0,0:16:29.40,0:16:31.99,Bottom,,0000,0000,0000,,Жоқ! Егер олар басқа жолмен кетіп қалса ше?
Dialogue: 0,0:16:29.53,0:16:31.99,Top,,0000,0000,0000,,Идиот! Мен қате алсам не істеуім керек?
Dialogue: 0,0:16:32.07,0:16:33.24,Bottom,,0000,0000,0000,,Біз күтеміз!
Dialogue: 0,0:16:32.07,0:16:33.24,Top,,0000,0000,0000,,Күтіңіз.
Dialogue: 0,0:16:41.66,0:16:42.62,Bottom,,0000,0000,0000,,Мен барамын.
Dialogue: 0,0:16:41.83,0:16:43.66,Top,,0000,0000,0000,,Мен міндетті түрде барамын ‎(Люси) Дэвид!
Dialogue: 0,0:16:42.71,0:16:43.62,Bottom,,0000,0000,0000,,Давид!
Dialogue: 0,0:16:43.71,0:16:47.08,Bottom,,0000,0000,0000,,Неден сонша қорқасың?! Бұл оларды ұзаққа созбауы керек!
Dialogue: 0,0:16:43.75,0:16:45.33,Top,,0000,0000,0000,,‎Сен неден қорқасың?
Dialogue: 0,0:16:45.42,0:16:47.33,Top,,0000,0000,0000,,‎Бұл соншалықты ұзаққа созылды!
Dialogue: 0,0:16:47.17,0:16:48.00,Bottom,,0000,0000,0000,,Шынымен
Dialogue: 0,0:16:47.42,0:16:49.71,Top,,0000,0000,0000,,‎(Люси) Күте тұрыңыз, мен радионы алдым.
Dialogue: 0,0:16:48.09,0:16:53.01,Bottom,,0000,0000,0000,,Мен сигнал алдым. Жарақат осында... ҰҚК жанында.
Dialogue: 0,0:16:50.21,0:16:53.01,Top,,0000,0000,0000,,‎NCPD де жарақатқа терең енеді
Dialogue: 0,0:16:53.59,0:16:55.01,Top,,0000,0000,0000,,Мен қоршаудамын.
Dialogue: 0,0:16:53.67,0:16:55.01,Bottom,,0000,0000,0000,,Олар қоршалған.
Dialogue: 0,0:16:55.09,0:16:56.09,Bottom,,0000,0000,0000,,Олай болса көмектесуіміз керек.
Dialogue: 0,0:16:55.09,0:16:56.18,Top,,0000,0000,0000,,Мен әлі баруым керек
Dialogue: 0,0:16:56.18,0:16:58.26,Bottom,,0000,0000,0000,,Жоқ! Өлгің келе ме?!
Dialogue: 0,0:16:56.26,0:16:58.26,Top,,0000,0000,0000,,(Люси) Жоқ. Өлгің келе ме?
Dialogue: 0,0:16:58.35,0:17:00.97,Top,,0000,0000,0000,,‎(Алыстағы атыс дыбысы)
Dialogue: 0,0:17:06.35,0:17:09.23,Bottom,,0000,0000,0000,,Мен өлмеймін. Мен саған қайтамын.
Dialogue: 0,0:17:06.35,0:17:09.27,Top,,0000,0000,0000,,Мен өлмеймін, өйткені Люси осында.
Dialogue: 0,0:17:09.31,0:17:10.61,Bottom,,0000,0000,0000,,Дэвид…
Dialogue: 0,0:17:09.36,0:17:10.61,Top,,0000,0000,0000,,‎(Люси) Дэвид
Dialogue: 0,0:17:10.69,0:17:13.74,Top,,0000,0000,0000,,‎Олардың ешқайсысы да құтқарылмайтын шығар.
Dialogue: 0,0:17:10.69,0:17:15.07,Bottom,,0000,0000,0000,,Олар үлгермеуі мүмкін. Біз шығынды азайтып, жүгіруіміз керек.
Dialogue: 0,0:17:13.82,0:17:15.15,Top,,0000,0000,0000,,‎Қашып кеткен дұрыс...
Dialogue: 0,0:17:15.15,0:17:18.28,Bottom,,0000,0000,0000,,Олардың ұрысқаны әлі де естіледі! Олар әлі тірі!
Dialogue: 0,0:17:15.24,0:17:18.28,Top,,0000,0000,0000,,‎Дыбысты естіп тұрсаңыз да? әлі тірі
Dialogue: 0,0:17:19.74,0:17:21.70,Bottom,,0000,0000,0000,,Сен бүгін біртүрлі әрекет етіп тұрсың, Люси.
Dialogue: 0,0:17:19.91,0:17:21.91,Top,,0000,0000,0000,,‎Сен бүгін біртүрлі әрекет етесің, Люси.
Dialogue: 0,0:17:22.58,0:17:25.54,Bottom,,0000,0000,0000,,Сіз бірдеңе көрдіңіз, солай емес пе? Танаканың нейрондық желісінде…
Dialogue: 0,0:17:22.66,0:17:25.62,Top,,0000,0000,0000,,Мен Танаканың ішінен бірдеңе көрдім.
Dialogue: 0,0:17:25.62,0:17:28.42,Bottom,,0000,0000,0000,,Мен… тек…
Dialogue: 0,0:17:25.71,0:17:28.13,Top,,0000,0000,0000,,‎(Люси) Мен... саған...
Dialogue: 0,0:17:30.04,0:17:31.50,Bottom,,0000,0000,0000,,Люси?
Dialogue: 0,0:17:30.13,0:17:33.46,Top,,0000,0000,0000,,Эй Люси, сен маған айтпайсың.
Dialogue: 0,0:17:31.59,0:17:33.59,Bottom,,0000,0000,0000,,Маған айтпайсың ба?
Dialogue: 0,0:17:33.55,0:17:34.30,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:34.38,0:17:35.92,Top,,0000,0000,0000,,«Мен мұны істей аламын»
Dialogue: 0,0:17:34.38,0:17:36.22,Bottom,,0000,0000,0000,,сіз де маған сенесіз бе?
Dialogue: 0,0:17:42.97,0:17:43.52,Top,,0000,0000,0000,,‎Фу…
Dialogue: 0,0:17:44.10,0:17:45.31,Top,,0000,0000,0000,,Көкек!
Dialogue: 0,0:17:48.44,0:17:50.31,Top,,0000,0000,0000,,‎Ааааа!
Dialogue: 0,0:17:55.61,0:17:57.28,Top,,0000,0000,0000,,Қарғыс атқыр, не істеп жатырсың? Бастысы! Тәртіпсіз болып көрінбеңіз...
Dialogue: 0,0:17:56.28,0:17:57.20,Bottom,,0000,0000,0000,,Блять, Мэн?!
Dialogue: 0,0:17:57.28,0:17:58.86,Top,,0000,0000,0000,,Сіз не істеп жатырсыз? Бастысы! Бұл тәртіпсіз... (шу дыбысы)
Dialogue: 0,0:17:57.78,0:17:58.86,Bottom,,0000,0000,0000,,Оны жинаңыз...
Dialogue: 0,0:17:59.49,0:18:00.20,Top,,0000,0000,0000,,‎(мылтық дыбысы)
Dialogue: 0,0:18:00.28,0:18:03.04,Top,,0000,0000,0000,,‎(Негізгі айқай)
Dialogue: 0,0:18:04.54,0:18:06.71,Bottom,,0000,0000,0000,,Қат! Блять гонк…
Dialogue: 0,0:18:04.54,0:18:06.71,Top,,0000,0000,0000,,Қарғыс атсын бұл ақымақ!
Dialogue: 0,0:18:07.29,0:18:10.71,Top,,0000,0000,0000,,‎(негізгі ауыр тыныс)
Dialogue: 0,0:18:10.79,0:18:12.42,Top,,0000,0000,0000,,‎(мылтық дыбысы)
Dialogue: 0,0:18:12.34,0:18:13.34,Bottom,,0000,0000,0000,,Атпа!
Dialogue: 0,0:18:12.50,0:18:14.34,Top,,0000,0000,0000,,‎(Травматолог) ‎Жоқ, атпаңыз ‎(Полиция қызметкері) ‎Неге!
Dialogue: 0,0:18:13.42,0:18:14.34,Bottom,,0000,0000,0000,,Неге болмайды?!
Dialogue: 0,0:18:14.42,0:18:16.09,Top,,0000,0000,0000,,‎(Жарақат мүшесі) ‎Платина мүшелерін қалқан ретінде пайдаланады.
Dialogue: 0,0:18:14.42,0:18:16.30,Bottom,,0000,0000,0000,,Ол платина клиентін кепілде ұстайды!
Dialogue: 0,0:18:16.17,0:18:17.80,Top,,0000,0000,0000,,(Полиция қызметкері) Сіз мұны білесіз бе?
Dialogue: 0,0:18:16.38,0:18:17.22,Bottom,,0000,0000,0000,,Біздің мәселе емес!
Dialogue: 0,0:18:18.34,0:18:19.26,Top,,0000,0000,0000,,Уау!
Dialogue: 0,0:18:23.01,0:18:24.18,Top,,0000,0000,0000,,‎(мылтық дыбысы)
Dialogue: 0,0:18:25.64,0:18:27.68,Top,,0000,0000,0000,,‎(Жаңбыр дыбысы)
Dialogue: 0,0:18:33.98,0:18:34.86,Top,,0000,0000,0000,,‎(мылтық дыбысы)
Dialogue: 0,0:18:36.36,0:18:37.28,Top,,0000,0000,0000,,Уф...
Dialogue: 0,0:18:38.24,0:18:39.95,Top,,0000,0000,0000,,‎(мылтық дыбысы)
Dialogue: 0,0:18:42.66,0:18:43.70,Top,,0000,0000,0000,,‎(құлап жатқан дыбыс)
Dialogue: 0,0:18:45.79,0:18:46.83,Bottom,,0000,0000,0000,,Дорио…
Dialogue: 0,0:18:45.79,0:18:46.83,Top,,0000,0000,0000,,Дорио?
Dialogue: 0,0:18:46.91,0:18:50.08,Bottom,,0000,0000,0000,,Мэн... Күте тұрыңыз, мен келе жатырмын.
Dialogue: 0,0:18:46.91,0:18:50.08,Top,,0000,0000,0000,,Негізгі Мен қазір сенің үйіңе барамын.
Dialogue: 0,0:18:50.17,0:18:51.29,Top,,0000,0000,0000,,‎(айқай)
Dialogue: 0,0:18:51.38,0:18:52.50,Bottom,,0000,0000,0000,,Маған керек…
Dialogue: 0,0:18:51.38,0:18:52.50,Top,,0000,0000,0000,,Сіз
Dialogue: 0,0:18:53.42,0:18:55.59,Bottom,,0000,0000,0000,,Маған мұны істей алатынымды айтуыңыз керек.
Dialogue: 0,0:18:53.42,0:18:55.59,Top,,0000,0000,0000,,‎Егер сен маған мұны істе десең, мен...
Dialogue: 0,0:19:07.35,0:19:08.60,Bottom,,0000,0000,0000,,Бұл…
Dialogue: 0,0:19:07.39,0:19:10.69,Top,,0000,0000,0000,,Мен? Менің кінәм бар ма?
Dialogue: 0,0:19:09.18,0:19:10.81,Bottom,,0000,0000,0000,,Бұл менің кінәм болды ма?
Dialogue: 0,0:19:18.78,0:19:22.61,Bottom,,0000,0000,0000,,Мұздату! Қарулар төмен, қолдар бастың артында!
Dialogue: 0,0:19:18.90,0:19:22.61,Top,,0000,0000,0000,,‎(Полиция қызметкері) Қозғалмаңыз! Қаруыңызды қойып, қолыңызды басыңыздан жоғары көтеріңіз.
Dialogue: 0,0:19:23.24,0:19:24.62,Bottom,,0000,0000,0000,,Соңғы ескерту!
Dialogue: 0,0:19:23.28,0:19:25.12,Top,,0000,0000,0000,,‎(Полиция қызметкері) Тыңдап тұрсың ба! (дірілдеген дауыс)
Dialogue: 0,0:19:25.20,0:19:26.20,Top,,0000,0000,0000,,‎(тізбекті кесу дыбысы)
Dialogue: 0,0:19:26.29,0:19:27.83,Top,,0000,0000,0000,,‎(Танаканы лақтыру дыбысы)
Dialogue: 0,0:19:33.71,0:19:36.00,Bottom,,0000,0000,0000,,Platinum клиентінің қайтыс болғаны расталды.
Dialogue: 0,0:19:33.79,0:19:35.92,Top,,0000,0000,0000,,‎(Жарақаттанушы) ‎Мердігердің қайтыс болуын растады.
Dialogue: 0,0:19:36.00,0:19:36.96,Top,,0000,0000,0000,,Сәлем
Dialogue: 0,0:19:36.09,0:19:36.96,Bottom,,0000,0000,0000,,Та-да!
Dialogue: 0,0:19:37.05,0:19:37.63,Top,,0000,0000,0000,,Ух...
Dialogue: 0,0:19:38.21,0:19:39.34,Top,,0000,0000,0000,,Бұл менің кінәм бе?
Dialogue: 0,0:19:38.21,0:19:39.38,Bottom,,0000,0000,0000,,Бұл менің кінәм бе?
Dialogue: 0,0:19:39.42,0:19:40.42,Top,,0000,0000,0000,,‎(Гуша!)
Dialogue: 0,0:19:41.09,0:19:43.09,Top,,0000,0000,0000,,‎(Мылтық) ‎(Травма отряды) Бұл киберпсихо.
Dialogue: 0,0:19:42.13,0:19:43.14,Bottom,,0000,0000,0000,,Бұл киберпсихоз!
Dialogue: 0,0:19:43.18,0:19:45.68,Top,,0000,0000,0000,,(Полиция қызметкері) MaxTac-қа хабарласыңыз... Аххх.
Dialogue: 0,0:19:43.22,0:19:44.89,Bottom,,0000,0000,0000,,Қазір MaxTac жалаушасы...
Dialogue: 0,0:19:44.97,0:19:46.14,Bottom,,0000,0000,0000,,Киберпси бар...
Dialogue: 0,0:19:46.22,0:19:48.64,Top,,0000,0000,0000,,‎(Голокольдық үн)
Dialogue: 0,0:19:49.22,0:19:51.44,Bottom,,0000,0000,0000,,Клиент тегістелді. Эвакуацияланамын!
Dialogue: 0,0:19:49.22,0:19:51.48,Top,,0000,0000,0000,,(Жарақаттанушы) Мердігердің қайтыс болғанын растау Retreat!
Dialogue: 0,0:19:51.52,0:19:53.02,Bottom,,0000,0000,0000,,Әй, қайда барасың?!
Dialogue: 0,0:19:51.56,0:19:53.02,Top,,0000,0000,0000,,‎(Полиция қызметкері) Әй, қайда барасың!
Dialogue: 0,0:19:53.10,0:19:55.56,Bottom,,0000,0000,0000,,Клиенттік саясат жарамсыз! Бұл енді сіздің проблемаңыз!
Dialogue: 0,0:19:53.10,0:19:55.65,Top,,0000,0000,0000,,‎(Жарақаттанушы) ‎Келісімшарт жойылды. Қалағаныңызша түсіре аласыз.
Dialogue: 0,0:19:55.65,0:19:56.52,Bottom,,0000,0000,0000,,Білсін!
Dialogue: 0,0:19:55.73,0:19:56.52,Top,,0000,0000,0000,,‎(Полиция қызметкері) Ақымақ болма.
Dialogue: 0,0:19:56.61,0:19:57.40,Top,,0000,0000,0000,,‎(оқ ату)
Dialogue: 0,0:19:57.32,0:19:59.32,Bottom,,0000,0000,0000,,Ол осында! Бізді шығарыңыз!
Dialogue: 0,0:19:57.48,0:19:58.78,Top,,0000,0000,0000,,‎Ол осында. Тез шығарыңыз.
Dialogue: 0,0:20:01.11,0:20:02.40,Top,,0000,0000,0000,,‎Ал сәлем!
Dialogue: 0,0:20:04.20,0:20:05.20,Top,,0000,0000,0000,,‎(Жарылыс дыбысы)
Dialogue: 0,0:20:05.28,0:20:06.45,Top,,0000,0000,0000,,‎(Травма мүшесі) Ах!
Dialogue: 0,0:20:06.53,0:20:08.29,Top,,0000,0000,0000,,Уау!
Dialogue: 0,0:20:18.13,0:20:19.05,Bottom,,0000,0000,0000,,Қат!
Dialogue: 0,0:20:18.13,0:20:19.13,Top,,0000,0000,0000,,‎(Полиция қызметкері) Қат!
Dialogue: 0,0:20:23.01,0:20:25.51,Top,,0000,0000,0000,,‎(мылтық жарқылы) ‎(полиция қызметкері айғайлайды)
Dialogue: 0,0:20:25.59,0:20:26.47,Top,,0000,0000,0000,,‎(Гуша!)
Dialogue: 0,0:20:29.14,0:20:31.10,Top,,0000,0000,0000,,‎(Голо-беру: Люси) ‎Дэвид, сен мені естисің бе?
Dialogue: 0,0:20:29.22,0:20:31.10,Bottom,,0000,0000,0000,,Дэвид... Сіз мені естисіз бе?
Dialogue: 0,0:20:31.18,0:20:33.10,Bottom,,0000,0000,0000,,Мэн психо болып кетті.
Dialogue: 0,0:20:31.18,0:20:33.10,Top,,0000,0000,0000,,‎Басты кейіпкер - Киберпсихо...
Dialogue: 0,0:20:33.69,0:20:37.48,Bottom,,0000,0000,0000,,Олар MaxTac-қа қоңырау шалды. Айнал, қайтып кел...
Dialogue: 0,0:20:33.73,0:20:37.11,Top,,0000,0000,0000,,‎MaxTac да шақырылды... Тезірек оралыңыз.
Dialogue: 0,0:20:38.73,0:20:39.98,Top,,0000,0000,0000,,Негізгі!
Dialogue: 0,0:20:38.77,0:20:39.98,Bottom,,0000,0000,0000,,Мэн…
Dialogue: 0,0:20:41.07,0:20:43.24,Bottom,,0000,0000,0000,,О. Эй, балам.
Dialogue: 0,0:20:41.15,0:20:43.24,Top,,0000,0000,0000,,‎Бұл не, Дэвид?
Dialogue: 0,0:20:43.32,0:20:44.86,Top,,0000,0000,0000,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:20:43.32,0:20:45.11,Bottom,,0000,0000,0000,,Амансың ба?
Dialogue: 0,0:20:45.20,0:20:47.62,Bottom,,0000,0000,0000,,Мэн, мен саған қолдау көрсету үшін келдім...
Dialogue: 0,0:20:45.36,0:20:47.53,Top,,0000,0000,0000,,‎ Негізгі Маған көмек керек... жоқ...
Dialogue: 0,0:20:47.53,0:20:49.16,Top,,0000,0000,0000,,‎Main Me Help... Жоқ... (Цилиндрлерді лақтыру дыбысы)
Dialogue: 0,0:20:48.20,0:20:49.03,Bottom,,0000,0000,0000,,Уф…
Dialogue: 0,0:20:49.12,0:20:51.83,Bottom,,0000,0000,0000,,Дорио қайтыс болды.
Dialogue: 0,0:20:49.24,0:20:51.83,Top,,0000,0000,0000,,Долио қайтыс болды.
Dialogue: 0,0:20:52.41,0:20:53.25,Bottom,,0000,0000,0000,,Жер
Dialogue: 0,0:20:52.66,0:20:56.50,Top,,0000,0000,0000,,Иә? Бұл не?
Dialogue: 0,0:20:54.46,0:20:56.50,Bottom,,0000,0000,0000,,Сіз не істеп жатырсыз...?
Dialogue: 0,0:20:56.58,0:20:59.00,Bottom,,0000,0000,0000,,Мен ол үшін жасай алатын соңғы нәрсе.
Dialogue: 0,0:20:56.58,0:20:59.00,Top,,0000,0000,0000,,Менің қолымнан келетіні осы.
Dialogue: 0,0:21:01.09,0:21:02.59,Bottom,,0000,0000,0000,,Жүгірейік, Мэн.
Dialogue: 0,0:21:01.17,0:21:04.17,Top,,0000,0000,0000,,Қашайық Негізгі Сіз де өлесіз.
Dialogue: 0,0:21:02.67,0:21:04.13,Bottom,,0000,0000,0000,,Сен өлесің.
Dialogue: 0,0:21:05.93,0:21:10.14,Bottom,,0000,0000,0000,,Енді жүгіру жоқ. Орақшы менің атымды шақырып жатыр.
Dialogue: 0,0:21:06.01,0:21:10.14,Top,,0000,0000,0000,,Мен қаша алмаймын. Өлім құдайы осы жолмен келе жатыр.
Dialogue: 0,0:21:10.22,0:21:12.64,Top,,0000,0000,0000,,(АВ ұшқан дыбыс) Не айтып тұрсыз?
Dialogue: 0,0:21:11.06,0:21:12.64,Bottom,,0000,0000,0000,,Сіз не айтып тұрсыз?
Dialogue: 0,0:21:16.23,0:21:17.23,Top,,0000,0000,0000,,‎(Кача!)
Dialogue: 0,0:21:17.27,0:21:19.86,Bottom,,0000,0000,0000,,Жақсы. Мен де күресемін.
Dialogue: 0,0:21:17.31,0:21:19.94,Top,,0000,0000,0000,,‎Жарайды, мен де ұрысамын.
Dialogue: 0,0:21:19.94,0:21:21.36,Bottom,,0000,0000,0000,,Бала…
Dialogue: 0,0:21:20.02,0:21:21.48,Top,,0000,0000,0000,,Дэвид
Dialogue: 0,0:21:21.44,0:21:25.53,Bottom,,0000,0000,0000,,Мен шешім қабылдадым. Мен жасаймын! Мен сені құтқарамын.
Dialogue: 0,0:21:21.57,0:21:25.53,Top,,0000,0000,0000,,Мен мұны істеуді шештім. Мен басты кейіпкерге көмектесемін.
Dialogue: 0,0:21:27.28,0:21:29.78,Bottom,,0000,0000,0000,,Қарғыс атсын! Шайқауды тоқтатыңыз!
Dialogue: 0,0:21:27.45,0:21:29.32,Top,,0000,0000,0000,,‎Қарғыс атсын... ашуланба!
Dialogue: 0,0:21:29.87,0:21:33.41,Top,,0000,0000,0000,,‎MaxTac-пен араласпаңыз! Келіңіз және көріңіз!
Dialogue: 0,0:21:29.87,0:21:33.75,Bottom,,0000,0000,0000,,Бля саған, MaxTac! Келіңіз және бізді алыңыз!
Dialogue: 0,0:21:33.83,0:21:36.50,Bottom,,0000,0000,0000,,Мэн, біз мұны бірге жеңе аламыз.
Dialogue: 0,0:21:33.95,0:21:36.50,Top,,0000,0000,0000,,‎Негізгі екі адам бірдеңе істей алады
Dialogue: 0,0:21:36.58,0:21:40.54,Bottom,,0000,0000,0000,,Біз мұны еңсереміз. Сосын… сосын…
Dialogue: 0,0:21:36.58,0:21:40.54,Top,,0000,0000,0000,,‎Бірдеңе істе... ‎Егер бірдеңе дұрыс болса, онда...
Dialogue: 0,0:21:40.63,0:21:42.55,Top,,0000,0000,0000,,‎(AV ұшу дыбысы)
Dialogue: 0,0:21:42.63,0:21:46.93,Top,,0000,0000,0000,,‎(Дэвидтің ауыр тыныс алуы)
Dialogue: 0,0:21:47.01,0:21:49.85,Top,,0000,0000,0000,,‎(AV қону дыбысы)
Dialogue: 0,0:21:50.85,0:21:52.93,Top,,0000,0000,0000,,‎(есіктің ашылған дыбысы)
Dialogue: 0,0:21:53.02,0:21:56.31,Top,,0000,0000,0000,,‎(Сарбаздардың ізі)
Dialogue: 0,0:21:56.39,0:22:01.48,Top,,0000,0000,0000,,‎(Дэвидтің ауыр тыныс алуы)
Dialogue: 0,0:22:01.48,0:22:02.82,Bottom,,0000,0000,0000,,Дэвид.
Dialogue: 0,0:22:01.57,0:22:03.03,Top,,0000,0000,0000,,Дэвид
Dialogue: 0,0:22:05.86,0:22:07.82,Bottom,,0000,0000,0000,,Сіз мұны істей алмайсыз.
Dialogue: 0,0:22:05.94,0:22:07.82,Top,,0000,0000,0000,,‎Сіз мұны әлі істей алмайсыз.
Dialogue: 0,0:22:10.87,0:22:13.08,Bottom,,0000,0000,0000,,Неліктен… Мэн…
Dialogue: 0,0:22:10.91,0:22:13.08,Top,,0000,0000,0000,,Неліктен негізгі...
Dialogue: 0,0:22:13.95,0:22:15.16,Bottom,,0000,0000,0000,,Неліктен…
Dialogue: 0,0:22:14.24,0:22:15.12,Top,,0000,0000,0000,,Неліктен...
Dialogue: 0,0:22:25.38,0:22:26.63,Bottom,,0000,0000,0000,,Давид.
Dialogue: 0,0:22:25.46,0:22:26.72,Top,,0000,0000,0000,,Дэвид
Dialogue: 0,0:22:28.34,0:22:29.13,Top,,0000,0000,0000,,‎(Пеш!)
Dialogue: 0,0:22:29.93,0:22:31.76,Bottom,,0000,0000,0000,,Бұл мен үшін жолдың соңы.
Dialogue: 0,0:22:29.93,0:22:31.80,Top,,0000,0000,0000,,Мен осында өлемін
Dialogue: 0,0:22:32.93,0:22:34.18,Top,,0000,0000,0000,,Сіз өмір сүруіңіз керек.
Dialogue: 0,0:22:32.93,0:22:37.60,Bottom,,0000,0000,0000,,Бірақ сіз үшін емес. Сіз не істейсіз, есіңізде ме?
Dialogue: 0,0:22:35.02,0:22:37.14,Top,,0000,0000,0000,,Сіз басқа адамдарға қарағанда жылдам жүгіре аласыз, солай ма?
Dialogue: 0,0:22:38.69,0:22:40.10,Bottom,,0000,0000,0000,,Жүгіруді жалғастырыңыз.
Dialogue: 0,0:22:38.77,0:22:40.10,Top,,0000,0000,0000,,Жүгіру
Dialogue: 0,0:22:42.69,0:22:43.82,Top,,0000,0000,0000,,‎(мылтық дыбысы)
Dialogue: 0,0:23:00.92,0:23:07.09,Top,,0000,0000,0000,,‎Аа... аааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:23:10.88,0:23:11.84,Top,,0000,0000,0000,,Уау...
Dialogue: 0,0:23:17.43,0:23:18.89,Top,,0000,0000,0000,,‎(Жарылыс дыбысы)
Dialogue: 0,0:23:18.98,0:23:23.65,Top,,0000,0000,0000,,(Голоколл үні)
Dialogue: 0,0:23:23.73,0:23:25.32,Top,,0000,0000,0000,,(Люсидің дірілдеген тынысы)
Dialogue: 0,0:23:34.45,0:23:35.58,Top,,0000,0000,0000,,(Башун!)
Dialogue: 0,0:23:36.91,0:23:37.83,Top,,0000,0000,0000,,Ха!
Dialogue: 0,0:23:40.46,0:23:42.54,Top,,0000,0000,0000,,‎(көліктің жүгіру дыбысы)
Dialogue: 0,0:24:09.07,0:24:14.07,Top,,0000,0000,0000,,♪~
Dialogue: 0,0:25:34.07,0:25:39.07,Top,,0000,0000,0000,,~♪
