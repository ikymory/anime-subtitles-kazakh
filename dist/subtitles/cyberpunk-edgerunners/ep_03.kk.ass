Dialogue: 0,0:15:04.69,0:15:06.07,Bottom,,0000,0000,0000,,Тұйықталған сияқты.
Dialogue: 0,0:15:06.11,0:15:07.74,Top,,0000,0000,0000,,Альдо ішінде болуы керек.
Dialogue: 0,0:15:06.15,0:15:07.78,Bottom,,0000,0000,0000,,Альдо ішінде болуы керек.
Dialogue: 0,0:15:07.82,0:15:10.57,Top,,0000,0000,0000,,Кем дегенде, кептеліс әлі де тұрақты жұмыс істейді.
Dialogue: 0,0:15:07.86,0:15:10.61,Bottom,,0000,0000,0000,,Кем дегенде, кептеліс әлі де тұрақты жұмыс істейді.
Dialogue: 0,0:15:12.41,0:15:13.57,Top,,0000,0000,0000,,[Дэвид] Есіктер құлыпталмаған ба?
Dialogue: 0,0:15:12.45,0:15:13.62,Bottom,,0000,0000,0000,,Есіктер құлыпталмаған ба?
Dialogue: 0,0:15:13.66,0:15:16.20,Top,,0000,0000,0000,,-[Люси күлді] Біраз уақыт құлпы ашылды. -[Дэвид күрсінді]
Dialogue: 0,0:15:13.70,0:15:16.24,Bottom,,0000,0000,0000,,Содан кейін біраз уақытқа құлпы ашылды.
Dialogue: 0,0:15:16.29,0:15:18.29,Top,,0000,0000,0000,,Осы жерде болыңыз. Мен оның ауқымын ашамын.
Dialogue: 0,0:15:16.33,0:15:18.33,Bottom,,0000,0000,0000,,Осы жерде болыңыз. Мен оны жұлып аламын.
Dialogue: 0,0:15:19.04,0:15:20.08,Top,,0000,0000,0000,,[ырылдады]
Dialogue: 0,0:15:20.16,0:15:22.33,Top,,0000,0000,0000,,[қозғалтқыштың қашықтан айналуы]
Dialogue: 0,0:15:24.17,0:15:25.25,Top,,0000,0000,0000,,[айқайлайды]
Dialogue: 0,0:15:26.13,0:15:29.59,Top,,0000,0000,0000,,-[кернеу музыка ойнайды] -[еңіреді]
Dialogue: 0,0:15:30.30,0:15:32.76,Top,,0000,0000,0000,,[жапон тілінде] Өзіңізді қызық деп ойлауыңыз керек.
Dialogue: 0,0:15:30.34,0:15:32.80,Bottom,,0000,0000,0000,,Жүр, қашпа.
Dialogue: 0,0:15:32.84,0:15:35.35,Top,,0000,0000,0000,,осындай трюкты тартады.
Dialogue: 0,0:15:32.89,0:15:35.39,Bottom,,0000,0000,0000,,Тағы біраз ойнайық!
