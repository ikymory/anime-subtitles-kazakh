Dialogue: 0,0:00:08.75,0:00:09.96,Top,,0000,0000,0000,,[электр дыбыстары]
Dialogue: 0,0:00:11.63,0:00:14.47,Top,,0000,0000,0000,,[«Бұл Фффайр» кіріспе ойнату]
Dialogue: 0,0:00:14.55,0:00:17.72,Top,,0000,0000,0000,,[«Бұл Fffire» кіріспе жалғасы]
Dialogue: 0,0:00:21.22,0:00:27.73,Top,,0000,0000,0000,,♪ Көздер, мені жарып өткен жол ♪
Dialogue: 0,0:00:27.81,0:00:33.11,Top,,0000,0000,0000,,♪ Көздер, сондай тәтті қиратып ♪
Dialogue: 0,0:00:34.15,0:00:39.87,Top,,0000,0000,0000,,♪ Енді менде от бар ♪
Dialogue: 0,0:00:39.95,0:00:45.37,Top,,0000,0000,0000,,♪ Жанып тұрған от ♪
Dialogue: 0,0:01:13.99,0:01:16.82,Top,,0000,0000,0000,,♪ Бұл өрт бақылаудан шықты ♪
Dialogue: 0,0:01:16.91,0:01:20.99,Top,,0000,0000,0000,,♪ Мен оны өртеп жіберемін! Мен оны өртеп жіберемін! ♪
Dialogue: 0,0:01:30.00,0:01:34.05,Top,,0000,0000,0000,,♪ Мен оны өртеп жіберемін! Мен оны өртеп жіберемін! ♪
Dialogue: 0,0:01:36.42,0:01:38.05,Top,,0000,0000,0000,,[музыка өшеді]
Dialogue: 0,0:01:40.97,0:01:43.64,Top,,0000,0000,0000,,[электрлік дыбыстар]
Dialogue: 0,0:01:43.72,0:01:45.06,Top,,0000,0000,0000,,[Дорио] Сонымен, біз онымен солай істейміз бе?
Dialogue: 0,0:01:43.77,0:01:45.02,Bottom,,0000,0000,0000,,Онымен не істейміз, иә?
Dialogue: 0,0:01:45.10,0:01:47.48,Bottom,,0000,0000,0000,,О, мына Сэнди менікі. Әрқашан болды.
Dialogue: 0,0:01:45.14,0:01:47.44,Top,,0000,0000,0000,,Сэнди кеніші әрқашан болды.
Dialogue: 0,0:01:47.52,0:01:49.19,Top,,0000,0000,0000,,Неліктен бұл тырнақшаны кесіп тастады?
Dialogue: 0,0:01:47.56,0:01:49.23,Bottom,,0000,0000,0000,,Бұл неліктен чиптей бастады?
Dialogue: 0,0:01:49.27,0:01:52.11,Top,,0000,0000,0000,,[Пилар күлді] Жою бізге өте қымбат болады.
Dialogue: 0,0:01:49.31,0:01:52.15,Bottom,,0000,0000,0000,,Оны жою бізге қымбатқа түседі, сондықтан дайынсыз ба?
Dialogue: 0,0:01:52.19,0:01:56.32,Top,,0000,0000,0000,,[Мэн] Уф. Lil' spikey shit менің есегімді ауыртады.
Dialogue: 0,0:01:52.23,0:01:54.03,Bottom,,0000,0000,0000,,Уф. Бұл бізді әбігерге салады.
Dialogue: 0,0:01:54.11,0:01:56.36,Bottom,,0000,0000,0000,,Ол менің құлағымды ауыртады.
Dialogue: 0,0:01:56.40,0:01:58.28,Top,,0000,0000,0000,,Біз оны тегістейміз бе?
Dialogue: 0,0:01:56.44,0:01:58.32,Bottom,,0000,0000,0000,,Оларды тегіс сызу туралы не айтасыз?
Dialogue: 0,0:01:58.36,0:02:01.66,Top,,0000,0000,0000,,Бес саусақты скваждық жеңілдік оның суық, өлі денесінде жақсы жұмыс істейді.
Dialogue: 0,0:01:58.40,0:02:01.70,Bottom,,0000,0000,0000,,Бес саусақ оның суық өлі денесінде жасалған жұмысына жеңілдік жасай алады.
Dialogue: 0,0:02:01.74,0:02:03.16,Top,,0000,0000,0000,,Ол үшін бізге әлі де жыртқыш қажет.
Dialogue: 0,0:02:01.78,0:02:03.20,Bottom,,0000,0000,0000,,Ол үшін бізге әлі орақ керек.
Dialogue: 0,0:02:03.24,0:02:04.99,Top,,0000,0000,0000,,Бірақ біз теңесетін едік, солай емес пе?
Dialogue: 0,0:02:03.28,0:02:05.04,Bottom,,0000,0000,0000,,Бірақ біз жеңетін едік, солай емес пе?
Dialogue: 0,0:02:05.08,0:02:06.45,Top,,0000,0000,0000,,Әрине, әрең. Менің ойымша.
Dialogue: 0,0:02:05.12,0:02:06.50,Bottom,,0000,0000,0000,,Әрине, әрең. Менің ойымша.
Dialogue: 0,0:02:06.54,0:02:10.33,Top,,0000,0000,0000,,Сіз мұны естідіңіз бе? Мен қарғыс атқыр нәрсені өзім жұлып алуым керек.
Dialogue: 0,0:02:06.58,0:02:10.38,Bottom,,0000,0000,0000,,Сіз мұны естідіңіз бе? Мен қарғыс атқыр нәрсені өзім жұлып алуым керек.
Dialogue: 0,0:02:10.42,0:02:14.25,Top,,0000,0000,0000,,Мүмкін сонда сен өзіңдікі емес нәрсені айтпауды үйренерсің, иісшіл.
Dialogue: 0,0:02:10.46,0:02:14.30,Bottom,,0000,0000,0000,,Бәлкім, сонда сен өзіңдікі емес, қол шапалақтамауды үйренерсің.
Dialogue: 0,0:02:14.84,0:02:16.51,Top,,0000,0000,0000,,Менің бөлмеме қан кетпесін,
Dialogue: 0,0:02:14.88,0:02:16.55,Bottom,,0000,0000,0000,,Менің бөлмеме қан кетпесін,
Dialogue: 0,0:02:16.59,0:02:17.63,Top,,0000,0000,0000,,-жарай ма? -[Мэн] Бұдан аулақ бол!
Dialogue: 0,0:02:16.63,0:02:17.67,Bottom,,0000,0000,0000,,-жарай ма? -Одан аулақ бол!
Dialogue: 0,0:02:17.72,0:02:20.47,Top,,0000,0000,0000,,Мм, кешіріңіз? Оны тапқан мен болдым.
Dialogue: 0,0:02:17.76,0:02:20.51,Bottom,,0000,0000,0000,,Мм, кешіріңіз? Оны тапқан мен болдым.
Dialogue: 0,0:02:20.55,0:02:21.64,Top,,0000,0000,0000,,[Мэн айқайлайды]
Dialogue: 0,0:02:20.59,0:02:21.68,Bottom,,0000,0000,0000,,Grr.
Dialogue: 0,0:02:21.72,0:02:23.10,Top,,0000,0000,0000,,[енеді]
Dialogue: 0,0:02:23.18,0:02:25.31,Top,,0000,0000,0000,,-Сен маған өтірік айттың ба? -[Мэн] Тыныш!
Dialogue: 0,0:02:23.22,0:02:25.35,Bottom,,0000,0000,0000,,-Сен маған өтірік айттың ба? -Ауызыңды жап!
Dialogue: 0,0:02:25.39,0:02:28.69,Top,,0000,0000,0000,,Енді түкіріңіз. Менің хромда серуендеп жүргенің бе?
Dialogue: 0,0:02:25.43,0:02:28.73,Bottom,,0000,0000,0000,,Енді төгіңіз. Сен не істеп жүрсің, менің тағыда серуендеп жүрсің?
Dialogue: 0,0:02:28.77,0:02:30.15,Top,,0000,0000,0000,,[Дэвид ыңыранды] Сіздікі?
Dialogue: 0,0:02:28.81,0:02:30.19,Bottom,,0000,0000,0000,,Сіздікі?
Dialogue: 0,0:02:30.23,0:02:32.31,Top,,0000,0000,0000,,[Мэн] Сіз есекке бәс тігесіз. Бұл дұрыс.
Dialogue: 0,0:02:30.27,0:02:32.36,Bottom,,0000,0000,0000,,Сіз есекке бәс тігесіз. Бұл дұрыс.
Dialogue: 0,0:02:32.40,0:02:35.78,Top,,0000,0000,0000,,Сатып алды және төледі. Мен қойғаннан кейін менің жеткізушім елес болды.
Dialogue: 0,0:02:32.44,0:02:35.82,Bottom,,0000,0000,0000,,Сатып алған және төлеген. Мен қойғаннан кейін менің жеткізушім елес болды.
Dialogue: 0,0:02:35.86,0:02:37.90,Top,,0000,0000,0000,,'Алдын ала төлеу үшін не аласыз'.
Dialogue: 0,0:02:35.90,0:02:37.94,Bottom,,0000,0000,0000,,Сонымен, алдын ала төлегеніңіз үшін не алдыңыз?
Dialogue: 0,0:02:37.99,0:02:39.90,Top,,0000,0000,0000,,-[Пилар] Гонк қозғалысы. -[Мэн] Жабыңыз!
Dialogue: 0,0:02:38.03,0:02:39.95,Bottom,,0000,0000,0000,,-Мен қозғала алмаймын. - Жабыңыз!
Dialogue: 0,0:02:39.99,0:02:44.37,Top,,0000,0000,0000,,Ол жақсы адамдар, өзіміздің адамдарымыз. Тек жылдам сызат жасауды іздеп жатырмын.
Dialogue: 0,0:02:40.03,0:02:44.41,Bottom,,0000,0000,0000,,Оның адамдары бар. Өзіміздің бірі. Тек жылдам сызат жасауды көздеп отыр.
Dialogue: 0,0:02:44.45,0:02:46.16,Top,,0000,0000,0000,,Ол да осы уақытқа дейін жақсы болды.
Dialogue: 0,0:02:44.49,0:02:46.20,Bottom,,0000,0000,0000,,Ол үшін де қисық болды. Осы уақытқа дейін.
Dialogue: 0,0:02:46.24,0:02:47.16,Top,,0000,0000,0000,,Мен сені таңдадым, себебі маған асталы дүниеде ауыр қару-жарақ қажет болады.
Dialogue: 0,0:02:46.29,0:02:47.20,Bottom,,0000,0000,0000,,Мен сені таңдадым, себебі маған асталы дүниеде ауыр қару-жарақ қажет болады.
Dialogue: 0,0:02:47.25,0:02:49.66,Top,,0000,0000,0000,,- Иә? - Сіздің жеткізушіңіз. Сіз айтасыз…
Dialogue: 0,0:02:47.29,0:02:49.71,Bottom,,0000,0000,0000,,- Иә? - Сіздің жеткізушіңіз. Сіз айтасыз…
Dialogue: 0,0:02:49.75,0:02:53.46,Top,,0000,0000,0000,,[Мэн] Глория Мартинес. Бұл қоңырау?
Dialogue: 0,0:02:49.79,0:02:53.50,Bottom,,0000,0000,0000,,Глория Мартинес. Бұл қоңырау?
Dialogue: 0,0:02:53.54,0:02:55.17,Top,,0000,0000,0000,,Иә, ол менің анам.
Dialogue: 0,0:02:53.59,0:02:55.21,Bottom,,0000,0000,0000,,О, иә. Ол менің анам.
Dialogue: 0,0:02:55.25,0:02:56.38,Top,,0000,0000,0000,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:02:55.30,0:02:56.42,Bottom,,0000,0000,0000,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:02:56.46,0:02:58.34,Top,,0000,0000,0000,,Сонымен, сен Глорияның бәйбішесісің бе?
Dialogue: 0,0:02:56.50,0:02:58.38,Bottom,,0000,0000,0000,,Сонымен, сен Глорияның братанысың ба?
Dialogue: 0,0:02:58.42,0:03:00.30,Top,,0000,0000,0000,,Ол оны саған тапсырып жатыр деп ойлады ма?
Dialogue: 0,0:02:58.46,0:03:00.34,Bottom,,0000,0000,0000,,Неліктен ол сізбен ұсынысты шеше аламын деп ойлады?
Dialogue: 0,0:03:00.38,0:03:01.80,Top,,0000,0000,0000,,Ол болмады. Ол қайтыс болды.
Dialogue: 0,0:03:00.43,0:03:01.84,Bottom,,0000,0000,0000,,Ол болмады. Ол қайтыс болды.
Dialogue: 0,0:03:01.89,0:03:03.34,Top,,0000,0000,0000,,-[Мэн ыңырсыды] -Иә?
Dialogue: 0,0:03:01.93,0:03:03.39,Bottom,,0000,0000,0000,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:03:03.43,0:03:04.39,Top,,0000,0000,0000,,Кеше.
Dialogue: 0,0:03:03.47,0:03:04.43,Bottom,,0000,0000,0000,,Кеше.
Dialogue: 0,0:03:04.47,0:03:08.18,Top,,0000,0000,0000,,Не болды? Бірақ мен онымен екі күн бұрын ғана сөйлестім.
Dialogue: 0,0:03:04.51,0:03:08.22,Bottom,,0000,0000,0000,,Не болды? Бірақ мен онымен екі күн бұрын ғана сөйлестім.
Dialogue: 0,0:03:08.27,0:03:10.69,Top,,0000,0000,0000,,Не болды? Белгілер алынады ма? Немесе...
Dialogue: 0,0:03:08.31,0:03:10.73,Bottom,,0000,0000,0000,,Не болды? Жаман адам оны өлтіреді, немесе...
Dialogue: 0,0:03:10.77,0:03:12.52,Top,,0000,0000,0000,,Бұл көлік апаты болды.
Dialogue: 0,0:03:10.81,0:03:12.56,Bottom,,0000,0000,0000,,Бұл көлік апаты болды.
Dialogue: 0,0:03:12.60,0:03:16.19,Top,,0000,0000,0000,,гангунның бір түрінен... Айқас отқа түсіп қалды.
Dialogue: 0,0:03:12.65,0:03:16.23,Bottom,,0000,0000,0000,,Бандалық топтың бір түрінен көлікпен келе жатқан... Айқас оқтың ортасында қалды.
Dialogue: 0,0:03:16.27,0:03:18.78,Top,,0000,0000,0000,,Сандестанға еш қатысы жоқ.
Dialogue: 0,0:03:16.32,0:03:18.82,Bottom,,0000,0000,0000,,Сандестанға еш қатысы жоқ.
Dialogue: 0,0:03:20.28,0:03:21.49,Top,,0000,0000,0000,,Хмм.
Dialogue: 0,0:03:20.32,0:03:21.53,Bottom,,0000,0000,0000,,Хмм.
Dialogue: 0,0:03:22.28,0:03:23.45,Top,,0000,0000,0000,,-[Дэвид Грунтс] -[Мэн] Ммм.
Dialogue: 0,0:03:22.32,0:03:23.49,Bottom,,0000,0000,0000,,Хмм.
Dialogue: 0,0:03:24.03,0:03:26.66,Top,,0000,0000,0000,,Неліктен ол бізді ешқашан шақырмағанын бақылайды.
Dialogue: 0,0:03:24.07,0:03:26.70,Bottom,,0000,0000,0000,,Неліктен ол бізді ешқашан сатып алмағанын бақылайды.
Dialogue: 0,0:03:26.74,0:03:29.45,Top,,0000,0000,0000,,Көңіл айтамын, балам. Бұл қиын, бірақ бәрібір…
Dialogue: 0,0:03:26.78,0:03:29.50,Bottom,,0000,0000,0000,,Көңіл айтамын, балақай. Бұл қиын, бірақ бәрібір…
Dialogue: 0,0:03:29.54,0:03:30.37,Top,,0000,0000,0000,,[енеді]
Dialogue: 0,0:03:30.46,0:03:33.71,Top,,0000,0000,0000,,[Мэн] Сізге нәрселерді жеңілдететінін бір секунд ойламаңыз.
Dialogue: 0,0:03:30.50,0:03:33.75,Bottom,,0000,0000,0000,,Сізге заттарды тегін және оңай ететін жиынтық үшін төлем жасамаңыз.
Dialogue: 0,0:03:33.79,0:03:35.96,Top,,0000,0000,0000,,Тыңдау. Мен сенікі екенін білмедім.
Dialogue: 0,0:03:33.83,0:03:36.00,Bottom,,0000,0000,0000,,Тыңдаңыз. Мен сенікі екенін білмедім.
Dialogue: 0,0:03:36.04,0:03:37.67,Top,,0000,0000,0000,,Иә, мен сквирттің мүшесімін.
Dialogue: 0,0:03:36.09,0:03:37.71,Bottom,,0000,0000,0000,,Иә, мен ешқашан эскорт болған емеспін
Dialogue: 0,0:03:37.75,0:03:40.22,Top,,0000,0000,0000,,Анам қалдырған барлық миль-спекромды чиптеп жатыр.
Dialogue: 0,0:03:37.80,0:03:40.26,Bottom,,0000,0000,0000,,Анам жатып қалдырған хаттардың барлығын қиып тастады.
Dialogue: 0,0:03:40.30,0:03:41.88,Top,,0000,0000,0000,,Жақсы кездер, жақсы кездер.
Dialogue: 0,0:03:40.34,0:03:41.93,Bottom,,0000,0000,0000,,Жақсы кездер, жақсы кездер.
Dialogue: 0,0:03:41.97,0:03:44.18,Top,,0000,0000,0000,,Мәсіх! Бұл тверптің айналуы анық!
Dialogue: 0,0:03:42.01,0:03:44.22,Bottom,,0000,0000,0000,,Мәсіх! Бұл тверптің жеңіліске ұшырағаны анық!
Dialogue: 0,0:03:44.26,0:03:46.47,Top,,0000,0000,0000,,Өшіру. Ол не істеп жатқанын білмеді.
Dialogue: 0,0:03:44.30,0:03:46.51,Bottom,,0000,0000,0000,,Өшіру. Ол не істеп жатқанын білмеді.
Dialogue: 0,0:03:46.55,0:03:47.64,Top,,0000,0000,0000,,[Мэн мазақ етеді]
Dialogue: 0,0:03:47.72,0:03:50.48,Top,,0000,0000,0000,,Сонымен, сендер... киберпанксыңдар, солай емес пе?
Dialogue: 0,0:03:47.76,0:03:50.52,Bottom,,0000,0000,0000,,Балалар... сендер киберпанксыңдар, солай емес пе?
Dialogue: 0,0:03:55.69,0:03:57.11,Top,,0000,0000,0000,,Сізге не болды?
Dialogue: 0,0:03:55.73,0:03:57.15,Bottom,,0000,0000,0000,,Сізге не болды?
Dialogue: 0,0:03:58.23,0:03:59.53,Top,,0000,0000,0000,,[Дэвид] Маған Құмды қалдыруға рұқсат етіңіз.
Dialogue: 0,0:03:58.27,0:03:59.57,Bottom,,0000,0000,0000,,Маған Құмды қалдыруға рұқсат етіңіз.
Dialogue: 0,0:03:59.61,0:04:02.07,Top,,0000,0000,0000,,Сізге дәл қазір қайтара алмаймын, бірақ мен оны шешемін.
Dialogue: 0,0:03:59.65,0:04:02.11,Bottom,,0000,0000,0000,,Сізге дәл қазір төлей алмаймын, бірақ мен оны шешемін.
Dialogue: 0,0:04:02.15,0:04:04.74,Top,,0000,0000,0000,,Бір уақытта бір концерт, қанша уақыт қажет болса.
Dialogue: 0,0:04:02.20,0:04:04.78,Bottom,,0000,0000,0000,,Бір уақытта бір концерт, қанша уақыт қажет болса.
Dialogue: 0,0:04:04.82,0:04:07.83,Top,,0000,0000,0000,,[Мэн] жеткіліксіз. Шит әскери дәрежелі.
Dialogue: 0,0:04:04.86,0:04:07.87,Bottom,,0000,0000,0000,,Жеткілікті емес. Бұл әскери дәреже.
Dialogue: 0,0:04:07.91,0:04:10.33,Top,,0000,0000,0000,,Сөреден басқасын сатып алу мүмкін емес.
Dialogue: 0,0:04:07.95,0:04:10.37,Bottom,,0000,0000,0000,,Сөреден басқасын сатып ала алмайсыз.
Dialogue: 0,0:04:10.41,0:04:12.66,Top,,0000,0000,0000,,[Дэвид] Анама не төлесең де, мен оны қайтарамын.
Dialogue: 0,0:04:10.45,0:04:12.71,Bottom,,0000,0000,0000,,Анама не төлесең де, мен оны қайтарамын.
Dialogue: 0,0:04:12.75,0:04:14.00,Top,,0000,0000,0000,,[Мэн] Мәміле жоқ.
Dialogue: 0,0:04:12.79,0:04:14.04,Bottom,,0000,0000,0000,,Мәміле жоқ.
Dialogue: 0,0:04:14.08,0:04:15.92,Top,,0000,0000,0000,,Мен өлтіруге болмайды дедім.
Dialogue: 0,0:04:14.12,0:04:15.96,Bottom,,0000,0000,0000,,Мен өлтіруге болмайды дедім.
Dialogue: 0,0:04:16.00,0:04:17.46,Top,,0000,0000,0000,,-[Дэвид] Жүр! Тым болмаса маған мүмкіндік беріңіз!
Dialogue: 0,0:04:16.04,0:04:18.42,Bottom,,0000,0000,0000,,Келіңіздер! Тек маған мүмкіндік беріңіз!
Dialogue: 0,0:04:17.54,0:04:18.38,Top,,0000,0000,0000,,-[Мэн келекелейді]
Dialogue: 0,0:04:18.46,0:04:21.42,Top,,0000,0000,0000,,Бұл күлкілі. Мен сізге мектепке дейінгі мекемені басқаратын сияқтымын ба?
Dialogue: 0,0:04:18.50,0:04:21.46,Bottom,,0000,0000,0000,,Бұл күлкілі. Мен сізге мектепке дейінгі мекемені басқаратын сияқтымын?
Dialogue: 0,0:04:21.51,0:04:23.38,Top,,0000,0000,0000,,Мен Сандестанды оттаймын.
Dialogue: 0,0:04:21.55,0:04:23.42,Bottom,,0000,0000,0000,,Мен Сандестанды оттаймын.
Dialogue: 0,0:04:23.47,0:04:27.47,Top,,0000,0000,0000,,Боқтық. Сіз сияқты кішкентай бала оны қиналмай жүктей алмайды.
Dialogue: 0,0:04:23.51,0:04:27.51,Bottom,,0000,0000,0000,,Боқтық. Төмен қалмай, оны жүктеу мүмкін емес сияқты.
Dialogue: 0,0:04:27.55,0:04:29.39,Top,,0000,0000,0000,,Бұл бала тосын сыйларға толы.
Dialogue: 0,0:04:27.60,0:04:29.43,Bottom,,0000,0000,0000,,Бұл бала тосын сыйларға толы.
Dialogue: 0,0:04:29.47,0:04:30.77,Top,,0000,0000,0000,,-Мм? -Хмм? Жоқ.
Dialogue: 0,0:04:29.51,0:04:30.81,Bottom,,0000,0000,0000,,-Мм? -Хмм? Жоқ.
Dialogue: 0,0:04:30.85,0:04:33.14,Top,,0000,0000,0000,,Оның денесі екі соққыдан кейін дірілдеп кетті.
Dialogue: 0,0:04:30.89,0:04:33.18,Bottom,,0000,0000,0000,,Оның денесі екі соққыдан кейін дірілдейді.
Dialogue: 0,0:04:33.23,0:04:34.77,Top,,0000,0000,0000,,Сегізді қолданып көріңіз. Қытырлақ жоқ.
Dialogue: 0,0:04:33.27,0:04:34.81,Bottom,,0000,0000,0000,,Сегізді сынап көрді. Қытырлақ жоқ.
Dialogue: 0,0:04:34.85,0:04:36.06,Top,,0000,0000,0000,,-Мм? -Хмм?
Dialogue: 0,0:04:34.89,0:04:36.10,Bottom,,0000,0000,0000,,-Мм? -Хмм?
Dialogue: 0,0:04:36.15,0:04:38.90,Top,,0000,0000,0000,,Келіңіздер. Бұл үлкен төсек және оны бәріміз білеміз.
Dialogue: 0,0:04:36.19,0:04:38.94,Bottom,,0000,0000,0000,,Келіңіздер. Бұл өте көп және оны бәріміз білеміз.
Dialogue: 0,0:04:38.98,0:04:42.53,Top,,0000,0000,0000,,Иә? Жақсы. Сонда мен оны дәлелдеймін бе?
Dialogue: 0,0:04:39.02,0:04:42.57,Bottom,,0000,0000,0000,,Иә? Жақсы. Сонда мен оны дәлелдеймін бе?
Dialogue: 0,0:04:43.11,0:04:45.53,Top,,0000,0000,0000,,-[Дорио мен Пилар ыңырсыды] -Ооо. Есегіңізді төмен түсіріңіз.
Dialogue: 0,0:04:43.15,0:04:45.57,Bottom,,0000,0000,0000,,Уа. Есегіңізді төмен түсіріңіз.
Dialogue: 0,0:04:45.61,0:04:48.49,Top,,0000,0000,0000,,Иә! Босаңса. Темекіні тез шегемін.
Dialogue: 0,0:04:45.66,0:04:48.53,Bottom,,0000,0000,0000,,Иә! Босаңса. Бұл темекіні тез шапалақтаймын.
Dialogue: 0,0:04:48.57,0:04:50.54,Top,,0000,0000,0000,,Ештеңе емес... Көрдіңіз бе?
Dialogue: 0,0:04:48.62,0:04:50.58,Bottom,,0000,0000,0000,,Бұл менің қолымнан келеді... Көрдіңіз бе?
Dialogue: 0,0:04:50.62,0:04:51.58,Top,,0000,0000,0000,,Не--? иә?
Dialogue: 0,0:04:50.66,0:04:51.62,Bottom,,0000,0000,0000,,Не--? иә?
Dialogue: 0,0:04:53.50,0:04:55.87,Top,,0000,0000,0000,,-Ааа! -Бұл бүгін тоғызды құрайды...
Dialogue: 0,0:04:53.54,0:04:55.92,Bottom,,0000,0000,0000,,-Ааа! -Бұл бүгін тоғызды құрайды...
Dialogue: 0,0:04:55.96,0:04:57.92,Top,,0000,0000,0000,,Күтуге болмайды. Шын мәнінде он.
Dialogue: 0,0:04:56.00,0:04:57.96,Bottom,,0000,0000,0000,,Жоқ. Шын мәнінде он.
Dialogue: 0,0:04:58.00,0:05:01.00,Top,,0000,0000,0000,,[Пилар] Қасиетті! Бұл не болды?
Dialogue: 0,0:04:58.04,0:05:01.05,Bottom,,0000,0000,0000,,Қасиетті! Бұл не болды?
Dialogue: 0,0:05:01.09,0:05:02.21,Top,,0000,0000,0000,,Маған мүмкіндік беріңіз.
Dialogue: 0,0:05:01.13,0:05:02.26,Bottom,,0000,0000,0000,,Маған мүмкіндік беріңіз.
Dialogue: 0,0:05:02.30,0:05:04.92,Top,,0000,0000,0000,,[Мэн] Мүмкіндік, иә? Қандай түрі?
Dialogue: 0,0:05:02.34,0:05:04.97,Bottom,,0000,0000,0000,,Мүмкіндік, иә? Қандай түрі?
Dialogue: 0,0:05:05.55,0:05:07.55,Top,,0000,0000,0000,,Жеңіл. Сіз мені жұмысқа шығарасыз.
Dialogue: 0,0:05:05.59,0:05:07.59,Bottom,,0000,0000,0000,,Жеңіл. Сіз мені жұмысқа шығарасыз.
Dialogue: 0,0:05:08.39,0:05:09.68,Top,,0000,0000,0000,,[Дэвид] Бұны бұзбайды.
Dialogue: 0,0:05:08.43,0:05:09.72,Bottom,,0000,0000,0000,,Оны бұзбаймын.
Dialogue: 0,0:05:10.89,0:05:13.43,Top,,0000,0000,0000,,[қарқынды музыка ойнау]
Dialogue: 0,0:05:21.77,0:05:23.90,Top,,0000,0000,0000,,Сізде өте жұп бар, мен оны беремін.
Dialogue: 0,0:05:21.82,0:05:23.94,Bottom,,0000,0000,0000,,Сізге айтарлықтай ақша төленді. Мен саған соны беремін.
Dialogue: 0,0:05:23.99,0:05:25.86,Top,,0000,0000,0000,,Жарайды, балақай. Сізге бір мүмкіндік беріледі.
Dialogue: 0,0:05:24.03,0:05:25.90,Bottom,,0000,0000,0000,,Жарайды, балақай. Сізге бір мүмкіндік беріледі.
Dialogue: 0,0:05:25.95,0:05:27.53,Top,,0000,0000,0000,,-[Пилар дірілдейді] -О, тамаша. Мінеки тағы біз.
Dialogue: 0,0:05:25.99,0:05:27.57,Bottom,,0000,0000,0000,,О, тамаша. Мінеки тағы біз.
Dialogue: 0,0:05:27.61,0:05:31.33,Top,,0000,0000,0000,,Мен Глорияға қарыздармын, мүмкін алма алысқа түспеді. Хмм?
Dialogue: 0,0:05:27.66,0:05:31.37,Bottom,,0000,0000,0000,,Мен Глорияға қарыздармын, мүмкін алма алысқа түспеді. Хмм?
Dialogue: 0,0:05:31.41,0:05:32.54,Top,,0000,0000,0000,,Сіз өкінбейсіз.
Dialogue: 0,0:05:31.45,0:05:32.58,Bottom,,0000,0000,0000,,Сіз өкінбейсіз.
Dialogue: 0,0:05:32.62,0:05:34.91,Top,,0000,0000,0000,,- Иә? Ол... Эй! -[Мэн] Салқын.
Dialogue: 0,0:05:32.66,0:05:34.95,Bottom,,0000,0000,0000,,- Иә? Ол... Эй! - Салқындатыңыз.
Dialogue: 0,0:05:35.00,0:05:36.50,Top,,0000,0000,0000,,-Тресерді саңылау. -[механизм ызылдайды]
Dialogue: 0,0:05:35.04,0:05:36.54,Bottom,,0000,0000,0000,,Тек трекерді орнату.
Dialogue: 0,0:05:36.58,0:05:39.13,Top,,0000,0000,0000,,Бізден AWOL болғаныңызды қаламайсыз ба.
Dialogue: 0,0:05:36.62,0:05:39.17,Bottom,,0000,0000,0000,,Бізден AWOL барғаныңызды қаламайсыз ба.
Dialogue: 0,0:05:39.21,0:05:40.50,Top,,0000,0000,0000,,Мен жүгірмеймін.
Dialogue: 0,0:05:39.25,0:05:40.54,Bottom,,0000,0000,0000,,Мен жүгірмеймін.
Dialogue: 0,0:05:40.59,0:05:44.13,Top,,0000,0000,0000,,[Мэн] Иә, иә. Мен мұны бұрын естідім. Көп рет.
Dialogue: 0,0:05:40.63,0:05:44.17,Bottom,,0000,0000,0000,,Иә, иә. Мен мұны бұрын естідім. Көп рет.
Dialogue: 0,0:05:44.21,0:05:46.22,Top,,0000,0000,0000,,Ертең мені тыңдаңыз.
Dialogue: 0,0:05:44.26,0:05:46.26,Bottom,,0000,0000,0000,,Ертең мені тыңдаңыз.
Dialogue: 0,0:05:51.76,0:05:55.52,Top,,0000,0000,0000,,[Дэвид] Сонымен, киберпанктар. Бұл сіз итермелейтін пиптердің түрі еді.
Dialogue: 0,0:05:51.80,0:05:55.56,Bottom,,0000,0000,0000,,Сонымен, киберпанктар. Бұл сіз итермелейтін пиптердің түрі еді.
Dialogue: 0,0:05:57.56,0:05:58.56,Top,,0000,0000,0000,,[Люси] Мм-хм.
Dialogue: 0,0:05:57.60,0:05:58.60,Bottom,,0000,0000,0000,,мм-мм.
Dialogue: 0,0:05:59.77,0:06:01.56,Top,,0000,0000,0000,,-[Дэвид] Біраз айта алар едім... -[Люси] Не сияқты?
Dialogue: 0,0:05:59.81,0:06:01.61,Bottom,,0000,0000,0000,,-Біраз айта алар едім-- -Не сияқты?
Dialogue: 0,0:06:01.65,0:06:04.15,Top,,0000,0000,0000,,Мен мұны басынан бастап жоспарлаған сияқты емеспін.
Dialogue: 0,0:06:01.69,0:06:04.19,Bottom,,0000,0000,0000,,Басынан жоспар сияқты.
Dialogue: 0,0:06:04.23,0:06:07.03,Top,,0000,0000,0000,,Мэн өзінің бағалы Сэнди жоғалып кеткені туралы аузын ашпайды
Dialogue: 0,0:06:04.28,0:06:07.07,Bottom,,0000,0000,0000,,Мэн бұл қымбат Сэндидің жоғалып кеткені туралы аузын ашпайды
Dialogue: 0,0:06:07.11,0:06:09.95,Top,,0000,0000,0000,,және мен сізді пойызда дәл солай пайдаланғаныңызды көрдім.
Dialogue: 0,0:06:07.15,0:06:09.99,Bottom,,0000,0000,0000,,және мен сізді осы пойызда дәл солай пайдаланғаныңызды көрдім.
Dialogue: 0,0:06:10.03,0:06:12.99,Top,,0000,0000,0000,,Сіздің риперге барғаннан кейін сізде оның бар екеніне сенімді болдыңыз.
Dialogue: 0,0:06:10.07,0:06:13.03,Bottom,,0000,0000,0000,,Орақшыға барғаннан кейін оның бар екенін білдім.
Dialogue: 0,0:06:13.08,0:06:16.04,Top,,0000,0000,0000,,[Дэвид] Сосын олар көрсеткенше маған көздеріңді соғады деп ойладым.
Dialogue: 0,0:06:13.12,0:06:16.08,Bottom,,0000,0000,0000,,Сосын олар көрсеткенше маған көздеріңді соғады деп ойладым.
Dialogue: 0,0:06:16.87,0:06:18.62,Top,,0000,0000,0000,,…Өтірік айтты.
Dialogue: 0,0:06:16.91,0:06:18.66,Bottom,,0000,0000,0000,,Сіз барлық уақытта өтірік айтасыз.
Dialogue: 0,0:06:18.71,0:06:20.46,Top,,0000,0000,0000,,Үйге бар.
Dialogue: 0,0:06:18.75,0:06:20.50,Bottom,,0000,0000,0000,,Үйге бар.
Dialogue: 0,0:06:21.08,0:06:22.13,Top,,0000,0000,0000,,[Дэвид] Иә.
Dialogue: 0,0:06:21.13,0:06:22.17,Bottom,,0000,0000,0000,,Оқу, оқу
Dialogue: 0,0:06:25.51,0:06:27.55,Top,,0000,0000,0000,,[есік ашылады]
Dialogue: 0,0:06:27.63,0:06:28.51,Top,,0000,0000,0000,,Анаңыз туралы…
Dialogue: 0,0:06:27.67,0:06:28.55,Bottom,,0000,0000,0000,,Анаңыз туралы…
Dialogue: 0,0:06:29.18,0:06:30.76,Top,,0000,0000,0000,,Жоғалтқаныңыз үшін кешірім сұраймыз.
Dialogue: 0,0:06:29.22,0:06:30.80,Bottom,,0000,0000,0000,,Жоғалтқаныңыз үшін кешірім сұраймыз.
Dialogue: 0,0:06:57.95,0:06:59.41,Top,,0000,0000,0000,,[қоңырау]
Dialogue: 0,0:07:00.25,0:07:01.62,Top,,0000,0000,0000,,Мартинес мырза,
Dialogue: 0,0:07:00.29,0:07:01.67,Bottom,,0000,0000,0000,,Мартинес мырза,
Dialogue: 0,0:07:01.71,0:07:06.42,Top,,0000,0000,0000,,тамаша жаңалық. Сіздің үлгілі оқу үлгеріміңізге сүйене отырып,
Dialogue: 0,0:07:01.75,0:07:06.46,Bottom,,0000,0000,0000,,тамаша жаңалық. Сіздің үлгілі оқу үлгеріміңізге сүйене отырып,
Dialogue: 0,0:07:06.50,0:07:09.42,Top,,0000,0000,0000,,Арасака корпорациясы сізге стипендия тағайындады
Dialogue: 0,0:07:06.55,0:07:09.47,Bottom,,0000,0000,0000,,Арасака корпорациясы сізге стипендия тағайындады
Dialogue: 0,0:07:09.51,0:07:12.55,Top,,0000,0000,0000,,оқуыңызға қайта оралуыңыз үшін.
Dialogue: 0,0:07:09.55,0:07:12.59,Bottom,,0000,0000,0000,,оқуыңызға қайта оралуыңыз үшін.
Dialogue: 0,0:07:12.64,0:07:16.68,Top,,0000,0000,0000,,Бұл өте сирек мүмкіндік
Dialogue: 0,0:07:12.68,0:07:16.72,Bottom,,0000,0000,0000,,Бұл өте сирек мүмкіндік
Dialogue: 0,0:07:16.76,0:07:19.18,Top,,0000,0000,0000,,және үлкен құрмет. Құттықтаймыз.
Dialogue: 0,0:07:16.81,0:07:19.23,Bottom,,0000,0000,0000,,және үлкен құрмет. Құттықтаймыз.
Dialogue: 0,0:07:19.27,0:07:20.64,Top,,0000,0000,0000,,Алайда,
Dialogue: 0,0:07:19.31,0:07:20.69,Bottom,,0000,0000,0000,,Алайда,
Dialogue: 0,0:07:20.73,0:07:23.52,Top,,0000,0000,0000,,сіздің жақында болған зорлық-зомбылық туралы мәселе әлі де бар
Dialogue: 0,0:07:20.77,0:07:23.56,Bottom,,0000,0000,0000,,сіздің жақында болған зорлық-зомбылық туралы мәселе әлі де бар
Dialogue: 0,0:07:23.60,0:07:26.65,Top,,0000,0000,0000,,Академия негізінде Танака мырзаға қатысты.
Dialogue: 0,0:07:23.65,0:07:26.69,Bottom,,0000,0000,0000,,Академия негізінде Танака мырзаға қатысты.
Dialogue: 0,0:07:26.73,0:07:28.82,Top,,0000,0000,0000,,-Енді мен Танака мырзамен сөйлестім -[күрсініп]
Dialogue: 0,0:07:26.77,0:07:28.86,Bottom,,0000,0000,0000,,Енді мен Танака мырзамен сөйлестім
Dialogue: 0,0:07:28.90,0:07:31.53,Top,,0000,0000,0000,,және ол мейірімділікпен келісті
Dialogue: 0,0:07:28.94,0:07:31.57,Bottom,,0000,0000,0000,,және ол мейірімділікпен келісті
Dialogue: 0,0:07:31.61,0:07:34.41,Top,,0000,0000,0000,,тұрақты жазбаңыздан бірнеше кемшіліктерді жою
Dialogue: 0,0:07:31.65,0:07:34.45,Bottom,,0000,0000,0000,,тұрақты жазбаңыздан бірнеше кемшіліктерді жою
Dialogue: 0,0:07:34.49,0:07:36.62,Top,,0000,0000,0000,,-кешірім сұрау керек пе. -[күледі]
Dialogue: 0,0:07:34.53,0:07:36.66,Bottom,,0000,0000,0000,,кешірім сұрау керек пе?
Dialogue: 0,0:07:36.70,0:07:38.37,Top,,0000,0000,0000,,-Толығырақ білу үшін, өтінемін-- -[ырылдады]
Dialogue: 0,0:07:36.74,0:07:38.41,Bottom,,0000,0000,0000,,Толық ақпаратты мына жерден қараңыз:
Dialogue: 0,0:07:39.58,0:07:40.66,Top,,0000,0000,0000,,[қоңырау]
Dialogue: 0,0:07:41.79,0:07:42.83,Top,,0000,0000,0000,,Хмм?
Dialogue: 0,0:07:41.83,0:07:42.87,Bottom,,0000,0000,0000,,Хмм?
Dialogue: 0,0:07:42.92,0:07:44.71,Top,,0000,0000,0000,,[Мэн] Бала, сен тұрдың.
Dialogue: 0,0:07:42.96,0:07:44.75,Bottom,,0000,0000,0000,,Бала, сен тұрдың.
Dialogue: 0,0:07:45.25,0:07:47.38,Top,,0000,0000,0000,,[енеді]
Dialogue: 0,0:07:47.46,0:07:51.09,Top,,0000,0000,0000,,[рок музыка ойнайды]
Dialogue: 0,0:07:54.93,0:07:57.26,Top,,0000,0000,0000,,Сәлем! Міне, балам.
Dialogue: 0,0:07:54.97,0:07:57.31,Bottom,,0000,0000,0000,,Сәлем! Міне, балам.
Dialogue: 0,0:08:00.56,0:08:02.27,Top,,0000,0000,0000,,Таң, күн шуағы. Сіз дайынсыз ба?
Dialogue: 0,0:08:00.60,0:08:02.31,Bottom,,0000,0000,0000,,Таң, күн шуағы. Сіз дайынсыз ба?
Dialogue: 0,0:08:02.35,0:08:04.65,Top,,0000,0000,0000,,[Киви] Деректер өтірік емес. Ол жай ғана бала.
Dialogue: 0,0:08:02.39,0:08:04.69,Bottom,,0000,0000,0000,,Деректер өтірік емес. Ол жай ғана бала.
Dialogue: 0,0:08:04.73,0:08:06.86,Top,,0000,0000,0000,,-Ол ілесе ала ма? - Көрерміз ғой.
Dialogue: 0,0:08:04.77,0:08:06.90,Bottom,,0000,0000,0000,,-Ол ілесе ала ма? - Көрерміз ғой.
Dialogue: 0,0:08:06.94,0:08:09.78,Top,,0000,0000,0000,,Қазір, қазір. Мен оның тәтті кішкентай екенін білемін,
Dialogue: 0,0:08:06.98,0:08:09.82,Bottom,,0000,0000,0000,,Енді мен білемін. Мен оның тәтті кішкентай екенін білемін,
Dialogue: 0,0:08:09.86,0:08:11.90,Top,,0000,0000,0000,,бірақ бұл лас қолғаптарды өзіңізге қалдырыңыз.
Dialogue: 0,0:08:09.90,0:08:11.94,Bottom,,0000,0000,0000,,, бірақ бұл мифтерді өзіңізге қалдырыңыз.
Dialogue: 0,0:08:11.99,0:08:14.53,Top,,0000,0000,0000,,[Киви] Неге біз саған шыдаймыз?
Dialogue: 0,0:08:12.03,0:08:14.57,Bottom,,0000,0000,0000,,Неге біз саған шыдаймыз?
Dialogue: 0,0:08:15.20,0:08:19.08,Top,,0000,0000,0000,,Бұл киви. Ал Дорио мен Пилар, сіз кездестірдіңіз.
Dialogue: 0,0:08:15.24,0:08:19.12,Bottom,,0000,0000,0000,,Бұл киви. Ал Дорио мен Пилар, сіз кездестірдіңіз.
Dialogue: 0,0:08:19.16,0:08:20.50,Top,,0000,0000,0000,,Өзіңізді жайлы етіңіз.
Dialogue: 0,0:08:19.20,0:08:20.54,Bottom,,0000,0000,0000,,Өзіңізді жайлы етіңіз.
Dialogue: 0,0:08:21.83,0:08:23.62,Top,,0000,0000,0000,,-Менің атым Дэвид-- [күреді] -[Мэн] Кім сұрады?
Dialogue: 0,0:08:21.87,0:08:23.66,Bottom,,0000,0000,0000,,-Менің атым Давид-- -Тым жылдам.
Dialogue: 0,0:08:23.71,0:08:25.96,Top,,0000,0000,0000,,Бізге кірісейік, балақай.
Dialogue: 0,0:08:23.75,0:08:26.00,Bottom,,0000,0000,0000,,Бізге кірісейік, балам.
Dialogue: 0,0:08:26.50,0:08:27.84,Top,,0000,0000,0000,,Бөлшекті ұяшыққа салыңыз.
Dialogue: 0,0:08:26.54,0:08:27.88,Bottom,,0000,0000,0000,,Бөлшекті ұяшыққа салыңыз.
Dialogue: 0,0:08:27.92,0:08:29.55,Top,,0000,0000,0000,,[механизм ызылдайды]
Dialogue: 0,0:08:29.63,0:08:33.05,Top,,0000,0000,0000,,[көпшілік қолдау көрсету]
Dialogue: 0,0:08:33.13,0:08:36.26,Top,,0000,0000,0000,,[Мэн] Арасака корпусының жүргізушісіне және оққағарына сәлем айтыңыз…
Dialogue: 0,0:08:33.17,0:08:36.30,Bottom,,0000,0000,0000,,Арасака корпорациясының жүргізушісі мен күзетшісіне сәлем айтыңыз…
Dialogue: 0,0:08:36.34,0:08:37.97,Top,,0000,0000,0000,,-Максим. -[Максим қолдайды]
Dialogue: 0,0:08:36.39,0:08:38.01,Bottom,,0000,0000,0000,,-Максим. -Иә!
Dialogue: 0,0:08:38.05,0:08:41.60,Top,,0000,0000,0000,,[Мэн] Біз ол айналатын лимузиндегі навигация деректерін сырғытамыз.
Dialogue: 0,0:08:38.10,0:08:41.64,Bottom,,0000,0000,0000,,Біз ол айналатын лимузиндегі навигация деректерін сырғытамыз.
Dialogue: 0,0:08:41.68,0:08:44.14,Top,,0000,0000,0000,,[Дэвид] Тек деректер ме? Көлік емес пе?
Dialogue: 0,0:08:41.72,0:08:44.19,Bottom,,0000,0000,0000,,Тек деректер ме? Көлік емес пе?
Dialogue: 0,0:08:44.23,0:08:45.31,Top,,0000,0000,0000,,[Мэн] Біз сапарды аяқтаймыз
Dialogue: 0,0:08:44.27,0:08:45.35,Bottom,,0000,0000,0000,,Біз аттракционды шапалақтаймыз
Dialogue: 0,0:08:45.39,0:08:48.23,Top,,0000,0000,0000,,және «Сақтардың ниндзялары бізді шыбын-шіркейдей қуып жібереді.
Dialogue: 0,0:08:45.44,0:08:48.27,Bottom,,0000,0000,0000,,және Арасаканың ниндзялары бізді шыбын-шіркейдей қуып жібереді.
Dialogue: 0,0:08:48.31,0:08:50.44,Top,,0000,0000,0000,,Сонымен, иә, тек деректер.
Dialogue: 0,0:08:48.36,0:08:50.48,Bottom,,0000,0000,0000,,Сонымен, иә, тек деректер.
Dialogue: 0,0:08:50.53,0:08:51.65,Top,,0000,0000,0000,,[Дэвид] Қалай?
Dialogue: 0,0:08:50.57,0:08:51.69,Bottom,,0000,0000,0000,,Қалай?
Dialogue: 0,0:08:51.73,0:08:55.15,Top,,0000,0000,0000,,[Мэн] Жекпе-жекке бәс тігу - бұл жетекшінің өмірдегі жалғыз қуанышы.
Dialogue: 0,0:08:51.78,0:08:55.20,Bottom,,0000,0000,0000,,Төбелеске бәс тігу – бұл жігіттің өмірдегі жалғыз қуанышы.
Dialogue: 0,0:08:55.24,0:08:57.70,Top,,0000,0000,0000,,Оның есегі әр демалыс сайын сол орындардың біреуін толтырады.
Dialogue: 0,0:08:55.28,0:08:57.74,Bottom,,0000,0000,0000,,Ол әр демалыс сайын сол орындардың бірінде отырады.
Dialogue: 0,0:08:57.78,0:08:58.91,Top,,0000,0000,0000,,[ырылдады]
Dialogue: 0,0:08:58.99,0:09:01.54,Top,,0000,0000,0000,,[Мэн] Ол әрқашан қасапшыға май жинайды,
Dialogue: 0,0:08:59.03,0:09:01.58,Bottom,,0000,0000,0000,,Ол әрқашан қасапшының үстіне сөмке қояды,
Dialogue: 0,0:09:01.62,0:09:04.12,Top,,0000,0000,0000,,бас сүйегінің үстінен банкин ', апперкут o' hers.
Dialogue: 0,0:09:01.66,0:09:04.16,Bottom,,0000,0000,0000,,Оларды суық, жарғыш, үстіңгі кескіштерге орналастырыңыз.
Dialogue: 0,0:09:04.21,0:09:05.04,Top,,0000,0000,0000,,[ырылдады]
Dialogue: 0,0:09:06.25,0:09:09.54,Top,,0000,0000,0000,,Ол жалғыз емес. Көпшілік оны көру үшін келеді
Dialogue: 0,0:09:06.29,0:09:09.59,Bottom,,0000,0000,0000,,Жалғыз естігеннен-ақ, көпшілік оны көру үшін келеді
Dialogue: 0,0:09:09.63,0:09:12.71,Top,,0000,0000,0000,,торды бейшара гонктың қанымен қызыл түске боя.
Dialogue: 0,0:09:09.67,0:09:12.76,Bottom,,0000,0000,0000,,торды нашар ішектің қанымен қызыл түске боя.
Dialogue: 0,0:09:13.55,0:09:14.55,Top,,0000,0000,0000,,қоспағанда...
Dialogue: 0,0:09:13.59,0:09:14.59,Bottom,,0000,0000,0000,,қоспағанда...
Dialogue: 0,0:09:14.63,0:09:16.30,Top,,0000,0000,0000,,[ырылдады]
Dialogue: 0,0:09:16.38,0:09:18.14,Top,,0000,0000,0000,,[ырылдады]
Dialogue: 0,0:09:19.97,0:09:22.64,Top,,0000,0000,0000,,осы демалыс күндері олай төмендемейді,
Dialogue: 0,0:09:20.01,0:09:22.68,Bottom,,0000,0000,0000,,осы демалыс күндері олай төмендемейді,
Dialogue: 0,0:09:22.72,0:09:27.27,Top,,0000,0000,0000,,Қасапшыны мұңды қап ет сияқты бірінші айналымда сойып жатыр.
Dialogue: 0,0:09:22.77,0:09:27.31,Bottom,,0000,0000,0000,,Қасапшыны мұңды қап ет сияқты бірінші айналымда сойып жатыр.
Dialogue: 0,0:09:28.60,0:09:31.02,Top,,0000,0000,0000,,-[қоңырау соғылды] -[халықтың қошеметі]
Dialogue: 0,0:09:34.36,0:09:35.65,Top,,0000,0000,0000,,[Дэвид] Сізді соншалықты сенімді ететін не?
Dialogue: 0,0:09:34.40,0:09:35.70,Bottom,,0000,0000,0000,,Сізді соншалықты сенімді ететін не?
Dialogue: 0,0:09:35.74,0:09:38.16,Top,,0000,0000,0000,,-[Мэн] Бұл үшін маған сеніңіз. -[мысқылдап]
Dialogue: 0,0:09:35.78,0:09:38.20,Bottom,,0000,0000,0000,,Маған сеніңіз.
Dialogue: 0,0:09:38.24,0:09:41.78,Top,,0000,0000,0000,,[ырылдады]
Dialogue: 0,0:09:41.87,0:09:43.08,Top,,0000,0000,0000,,[Мэн] Қалай болғанда да,
Dialogue: 0,0:09:41.91,0:09:43.12,Bottom,,0000,0000,0000,,Қалай болғанда да,
Dialogue: 0,0:09:43.16,0:09:46.29,Top,,0000,0000,0000,,Ол өзінің қайғы-қасіретін осы бір тесікке батып кететін әдеті бар.
Dialogue: 0,0:09:43.20,0:09:46.33,Bottom,,0000,0000,0000,,оның қайғы-қасіретті қабырғадағы бір шұңқырға батыратын әдеті бар еді.
Dialogue: 0,0:09:46.37,0:09:50.79,Top,,0000,0000,0000,,Міне, сіз өзіңіздің қозғалысыңызды жасайсыз. Ол жақсы майланған кезде аз ішеді.
Dialogue: 0,0:09:46.41,0:09:50.84,Bottom,,0000,0000,0000,,Міне, сіз қимыл-қозғалысыңызды жасайсыз, ол майланған кезде аз ішеді.
Dialogue: 0,0:09:51.88,0:09:55.34,Top,,0000,0000,0000,,[көңілді музыка ойналады]
Dialogue: 0,0:09:57.13,0:09:59.59,Top,,0000,0000,0000,,Сіз кілтті алып, Дориоға бересіз.
Dialogue: 0,0:09:57.17,0:09:59.64,Bottom,,0000,0000,0000,,Сіз кілтті алып, Дориоға бересіз.
Dialogue: 0,0:10:00.14,0:10:02.43,Top,,0000,0000,0000,,Құлыпты ашу үшін ол көшірме жасайды.
Dialogue: 0,0:10:00.18,0:10:02.47,Bottom,,0000,0000,0000,,Ол қалқымалы блоктың көшірмесін жасайды.
Dialogue: 0,0:10:02.51,0:10:07.10,Top,,0000,0000,0000,,Содан кейін біз «Сақ бұлшықеті Максимнің беті ашылып, сыртқа шыққанда» біз шолу деректерін аламыз.
Dialogue: 0,0:10:02.56,0:10:07.14,Bottom,,0000,0000,0000,,Содан кейін біз бұлшық ет қапшығы Макстың беті әлі боқ болып тұрғанда, біз шолу деректерін шапалақтаймыз.
Dialogue: 0,0:10:07.18,0:10:08.19,Top,,0000,0000,0000,,[құрылғы сигналы]
Dialogue: 0,0:10:08.27,0:10:09.90,Top,,0000,0000,0000,,Бірақ мұны бізге қалдырыңыз,
Dialogue: 0,0:10:08.31,0:10:09.94,Bottom,,0000,0000,0000,,Бірақ мұны бізге қалдырыңыз,
Dialogue: 0,0:10:09.98,0:10:13.11,Top,,0000,0000,0000,,Ол ұстап алмас бұрын кілтті оның розеткасына салып қою керек.
Dialogue: 0,0:10:10.02,0:10:13.15,Bottom,,0000,0000,0000,,ол ілінбес бұрын кілтті ұяға қайта сырғыту керек.
Dialogue: 0,0:10:13.77,0:10:15.78,Top,,0000,0000,0000,,Міне. Қарапайым.
Dialogue: 0,0:10:13.82,0:10:15.82,Bottom,,0000,0000,0000,,Міне. Қарапайым.
Dialogue: 0,0:10:17.03,0:10:17.90,Top,,0000,0000,0000,,-[Киви] Күте тұрыңыз... -[Мэн ыңырсыды]
Dialogue: 0,0:10:17.07,0:10:17.95,Bottom,,0000,0000,0000,,Күте тұрыңыз…
Dialogue: 0,0:10:17.99,0:10:19.78,Top,,0000,0000,0000,,[Киви] Оның қожайынының шақыруы.
Dialogue: 0,0:10:18.03,0:10:19.82,Bottom,,0000,0000,0000,,Қожайынның шақыруы.
Dialogue: 0,0:10:19.86,0:10:24.20,Top,,0000,0000,0000,,[Мэн] Шиш, бейбақ тыныға алмайды. Зұлымдарға тыныштық жоқ.
Dialogue: 0,0:10:19.91,0:10:24.24,Bottom,,0000,0000,0000,,Шиш, бейбақ үзіліс ұстай алмайды. Зұлымдарға тыныштық жоқ.
Dialogue: 0,0:10:24.29,0:10:25.62,Top,,0000,0000,0000,,-[Максим күрсінді] -[Киви] Жақсы емес.
Dialogue: 0,0:10:24.33,0:10:25.66,Bottom,,0000,0000,0000,,Жақсы емес.
Dialogue: 0,0:10:25.70,0:10:28.21,Top,,0000,0000,0000,,-Ол сол жерде бастыққа керек. -[Мэн] Бота, демалыс күні ме?
Dialogue: 0,0:10:25.75,0:10:28.25,Bottom,,0000,0000,0000,,-Ол жерде бастығына керек. -Бақыт, демалыс күні ме?
Dialogue: 0,0:10:28.29,0:10:29.71,Top,,0000,0000,0000,,[Дорио] Деректер әлі көшірілген жоқ!
Dialogue: 0,0:10:28.33,0:10:29.75,Bottom,,0000,0000,0000,,Деректер әлі көшірілген жоқ!
Dialogue: 0,0:10:29.79,0:10:32.42,Top,,0000,0000,0000,,[Мэн] Бля! Жоспарларды өзгерту, балам.
Dialogue: 0,0:10:29.83,0:10:32.46,Bottom,,0000,0000,0000,,Бля! Жоспарларды өзгерту, балам.
Dialogue: 0,0:10:32.50,0:10:34.34,Top,,0000,0000,0000,,-Көліктің кілті. Ұстап ал. -[пернені басу]
Dialogue: 0,0:10:32.54,0:10:34.38,Bottom,,0000,0000,0000,,Көліктің кілті. Ұстап ал.
Dialogue: 0,0:10:35.00,0:10:37.09,Top,,0000,0000,0000,,Бекка, оны жұлып ал.
Dialogue: 0,0:10:35.05,0:10:37.13,Bottom,,0000,0000,0000,,Бекка, оны жұлып ал.
Dialogue: 0,0:10:37.17,0:10:39.38,Top,,0000,0000,0000,,- Иә? -[Дорио] Кет, жүр!
Dialogue: 0,0:10:37.21,0:10:39.43,Bottom,,0000,0000,0000,,- Иә? - Кет, жүр!
Dialogue: 0,0:10:42.09,0:10:44.14,Top,,0000,0000,0000,,-Ааа! -[Қырсыды] Эй! Не болды?
Dialogue: 0,0:10:42.14,0:10:44.18,Bottom,,0000,0000,0000,,-Ааа! -Эй! Не болды?
Dialogue: 0,0:10:44.22,0:10:47.85,Top,,0000,0000,0000,,-Мен өте ебедеймін. Кешіріңіз! [күледі] -Қара, қаншық! Ой!
Dialogue: 0,0:10:44.26,0:10:47.89,Bottom,,0000,0000,0000,,-Мен өте ебедеймін. Кешіріңіз! -Қара, балақай! Ой!
Dialogue: 0,0:10:49.19,0:10:51.98,Top,,0000,0000,0000,,[Мэн] Кіріңіз. Ол көрсетпес бұрын деректерді алыңыз.
Dialogue: 0,0:10:49.23,0:10:52.02,Bottom,,0000,0000,0000,,Кіріңіз. Ол көрсетпес бұрын деректерді алыңыз.
Dialogue: 0,0:10:52.81,0:10:53.81,Top,,0000,0000,0000,,Тозақта қалай?
Dialogue: 0,0:10:52.86,0:10:53.86,Bottom,,0000,0000,0000,,Тозақта қалай?
Dialogue: 0,0:10:53.90,0:10:55.73,Top,,0000,0000,0000,,-[Люси] Мен мұны істеймін. -[күледі]
Dialogue: 0,0:10:53.94,0:10:55.78,Bottom,,0000,0000,0000,,Мен мұны істеймін.
Dialogue: 0,0:10:56.36,0:10:57.23,Top,,0000,0000,0000,,Сіз кіресіз.
Dialogue: 0,0:10:56.40,0:10:57.28,Bottom,,0000,0000,0000,,Сіз кіресіз.
Dialogue: 0,0:10:57.32,0:10:58.74,Top,,0000,0000,0000,,[күрсініп]
Dialogue: 0,0:11:00.03,0:11:02.24,Top,,0000,0000,0000,,Ах...
Dialogue: 0,0:11:00.07,0:11:02.28,Bottom,,0000,0000,0000,,Ах...
Dialogue: 0,0:11:05.49,0:11:07.70,Top,,0000,0000,0000,,Адам…
Dialogue: 0,0:11:05.53,0:11:07.75,Bottom,,0000,0000,0000,,Адам…
Dialogue: 0,0:11:08.45,0:11:09.37,Top,,0000,0000,0000,,-[Дэвид] Жақсысың ба? -[құрылғы сигналы]
Dialogue: 0,0:11:08.50,0:11:09.41,Bottom,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:11:09.46,0:11:10.62,Top,,0000,0000,0000,,Сөйлеме. Фокустау.
Dialogue: 0,0:11:09.50,0:11:10.67,Bottom,,0000,0000,0000,,Сөйлеме. Фокустау.
Dialogue: 0,0:11:11.37,0:11:14.63,Top,,0000,0000,0000,,Арасака ICE қабырғалары - бұл есектегі үлкен ауырсыну.
Dialogue: 0,0:11:11.42,0:11:14.67,Bottom,,0000,0000,0000,,Арасака көздің мұң-мұқтажы сондай еді.
Dialogue: 0,0:11:15.46,0:11:17.09,Top,,0000,0000,0000,,Кешіріңіз, сұлу!
Dialogue: 0,0:11:15.50,0:11:17.13,Bottom,,0000,0000,0000,,Кешіріңіз, сұлу!
Dialogue: 0,0:11:17.17,0:11:20.01,Top,,0000,0000,0000,,Жоқ. Мәселе емес, жаным.
Dialogue: 0,0:11:17.21,0:11:20.05,Bottom,,0000,0000,0000,,Жоқ. Мәселе емес, жаным.
Dialogue: 0,0:11:20.09,0:11:22.05,Top,,0000,0000,0000,,Мен келесі жолы сізге өтемін. Жақсы?
Dialogue: 0,0:11:20.13,0:11:22.09,Bottom,,0000,0000,0000,,Келесі жолы өтемін. Жақсы?
Dialogue: 0,0:11:22.13,0:11:24.43,Top,,0000,0000,0000,,О? [ырылдады]
Dialogue: 0,0:11:22.18,0:11:24.47,Bottom,,0000,0000,0000,,Біздің руға шабуыл жасаған Маскалылар Эбису-саманың…
Dialogue: 0,0:11:24.51,0:11:26.56,Top,,0000,0000,0000,,-Сен, қаншық! -Неге маған айқайлайсың?
Dialogue: 0,0:11:24.55,0:11:26.60,Bottom,,0000,0000,0000,,-Сен, қаншық! -Неге маған айқайлайсың?
Dialogue: 0,0:11:26.64,0:11:28.89,Top,,0000,0000,0000,,-[еңіреді] -Мен сезімталмын, білесің бе!
Dialogue: 0,0:11:26.68,0:11:28.93,Bottom,,0000,0000,0000,,Сен өте сезімталсың, білесің бе!
Dialogue: 0,0:11:28.97,0:11:30.85,Top,,0000,0000,0000,,[Киви] Біз таң қалдық. Мақсат қызып келеді.
Dialogue: 0,0:11:29.02,0:11:30.89,Bottom,,0000,0000,0000,,Біз таң қалдық. Мақсат қызып келеді.
Dialogue: 0,0:11:30.94,0:11:32.77,Top,,0000,0000,0000,,-[Мэн] Күйі? - Біраз ғана.
Dialogue: 0,0:11:30.98,0:11:32.81,Bottom,,0000,0000,0000,,-Статистика? -Кішкене ғана.
Dialogue: 0,0:11:32.85,0:11:34.19,Top,,0000,0000,0000,,[Киви] Уақыт аяқталды. Кет!
Dialogue: 0,0:11:32.90,0:11:34.23,Bottom,,0000,0000,0000,,Уақыт аяқталды. Кет!
Dialogue: 0,0:11:34.27,0:11:36.02,Top,,0000,0000,0000,,-Дерлік… -[құрылғы сигналы]
Dialogue: 0,0:11:34.31,0:11:36.07,Bottom,,0000,0000,0000,,Дерлік…
Dialogue: 0,0:11:36.11,0:11:37.53,Top,,0000,0000,0000,,Орындалды.
Dialogue: 0,0:11:36.15,0:11:37.57,Bottom,,0000,0000,0000,,Ах. Дайын.
Dialogue: 0,0:11:37.61,0:11:39.15,Top,,0000,0000,0000,,[Дэвид Грунтс] Ол ашылмайды!
Dialogue: 0,0:11:37.65,0:11:39.19,Bottom,,0000,0000,0000,,Ол ашылмайды!
Dialogue: 0,0:11:39.24,0:11:41.07,Top,,0000,0000,0000,,-[Люси] Қауіпсіздік қайта қосылды ма? -[Дэвид күңіренеді]
Dialogue: 0,0:11:39.28,0:11:41.11,Bottom,,0000,0000,0000,,Қауіпсіздік қайта қосылды ма?
Dialogue: 0,0:11:41.15,0:11:43.16,Top,,0000,0000,0000,,-[Киви] Айттым ғой, уақыт бітті. -[терезені соғу]
Dialogue: 0,0:11:41.20,0:11:43.20,Bottom,,0000,0000,0000,,Мен айтқанымдай, уақыт бітті.
Dialogue: 0,0:11:43.24,0:11:46.12,Top,,0000,0000,0000,,-Ашыңыз! Қазір! Сен, бля! -[ дүрбелең]
Dialogue: 0,0:11:43.28,0:11:46.16,Bottom,,0000,0000,0000,,Ашыңыз! Қазір! Сен, бля!
Dialogue: 0,0:11:46.78,0:11:49.25,Top,,0000,0000,0000,,-Ой, шіркін. Артқа жол жоқ. -[Максим айғайлайды]
Dialogue: 0,0:11:46.83,0:11:49.29,Bottom,,0000,0000,0000,,Әй, әттең. Артқа жол жоқ.
Dialogue: 0,0:11:49.33,0:11:50.45,Top,,0000,0000,0000,,-Оны іске қосыңыз. -[Дэвид] Не?
Dialogue: 0,0:11:49.37,0:11:50.50,Bottom,,0000,0000,0000,,-Оны іске қосыңыз. -Не?
Dialogue: 0,0:11:50.54,0:11:51.71,Top,,0000,0000,0000,,-[Максим есікті соғады] -[Мэн] Соқ, балақай.
Dialogue: 0,0:11:50.58,0:11:51.75,Bottom,,0000,0000,0000,,Соқ, балам.
Dialogue: 0,0:11:51.79,0:11:53.71,Top,,0000,0000,0000,,-[соққылау жалғасуда] -[Дэвид] Мен көлік жүргізуді білмеймін!
Dialogue: 0,0:11:51.83,0:11:53.75,Bottom,,0000,0000,0000,,Мен көлік жүргізуді білмеймін!
Dialogue: 0,0:11:53.79,0:11:55.84,Top,,0000,0000,0000,,-[Максим айқайлайды] -[Мэн] Үйренетін уақыт.
Dialogue: 0,0:11:53.83,0:11:55.88,Bottom,,0000,0000,0000,,Жұмыс уақыты.
Dialogue: 0,0:11:55.92,0:11:58.34,Top,,0000,0000,0000,,Сәлем! Эй!
Dialogue: 0,0:11:55.96,0:11:58.38,Bottom,,0000,0000,0000,,Сәлем! Эй!
Dialogue: 0,0:11:58.42,0:12:00.67,Top,,0000,0000,0000,,[соғу жалғасуда] Шық! Дәл қазір!
Dialogue: 0,0:11:58.46,0:12:00.72,Bottom,,0000,0000,0000,,Шық! Мен айттым!
Dialogue: 0,0:12:00.76,0:12:02.72,Top,,0000,0000,0000,,-[Мэн] Маған көрсетші... -Сен өлдің, қаншық!
Dialogue: 0,0:12:00.80,0:12:02.76,Bottom,,0000,0000,0000,,-Маған көрсетші... -Сен өлі етсің!
Dialogue: 0,0:12:02.80,0:12:04.26,Top,,0000,0000,0000,,…қажет нәрсені алдыңыз.
Dialogue: 0,0:12:02.84,0:12:04.30,Bottom,,0000,0000,0000,,…қажет нәрсені алдыңыз.
Dialogue: 0,0:12:04.34,0:12:05.93,Top,,0000,0000,0000,,-[Максим] Осыған өкінесің! -[күледі]
Dialogue: 0,0:12:04.39,0:12:05.97,Bottom,,0000,0000,0000,,Сіз мені естіп тұрсыз ба?
Dialogue: 0,0:12:06.01,0:12:10.35,Top,,0000,0000,0000,,-Мен сені және бүкіл отбасыңды төлеймін! -[күледі]
Dialogue: 0,0:12:06.05,0:12:10.39,Bottom,,0000,0000,0000,,Мен сені және бүкіл отбасыңды төлеймін!
Dialogue: 0,0:12:11.52,0:12:13.64,Top,,0000,0000,0000,,Сәлем! Тоқта! Менің көлігім!
Dialogue: 0,0:12:11.56,0:12:13.69,Bottom,,0000,0000,0000,,Сәлем! Тоқта! Менің көлігім!
Dialogue: 0,0:12:13.73,0:12:16.86,Top,,0000,0000,0000,,[жылау]
Dialogue: 0,0:12:17.44,0:12:20.03,Top,,0000,0000,0000,,[бұзу]
Dialogue: 0,0:12:20.11,0:12:23.53,Top,,0000,0000,0000,,Күте тұрыңыз! Бұл менің көлігім!
Dialogue: 0,0:12:20.15,0:12:23.57,Bottom,,0000,0000,0000,,Күте тұрыңыз! Мен айттым, күт!
Dialogue: 0,0:12:23.61,0:12:25.91,Top,,0000,0000,0000,,[Мэн күледі]
Dialogue: 0,0:12:25.99,0:12:28.20,Top,,0000,0000,0000,,-Олар менің дөңгелектерім емес екеніне қуаныштымын. -[Люси күледі]
Dialogue: 0,0:12:26.03,0:12:28.24,Bottom,,0000,0000,0000,,Әрине, олар менің дөңгелектерім емес.
Dialogue: 0,0:12:28.28,0:12:31.75,Top,,0000,0000,0000,,[Мэн] Оны тікелей Альдоға апарыңыз. Сіз GPS-ті хэштейсіз бе?
Dialogue: 0,0:12:28.33,0:12:31.79,Bottom,,0000,0000,0000,,Оны тікелей Альдоға апарыңыз. Сіз GPS-ті хэштейсіз бе?
Dialogue: 0,0:12:31.83,0:12:34.25,Top,,0000,0000,0000,,Ішінен мүмкін емес. Жаммер бар,
Dialogue: 0,0:12:31.87,0:12:34.29,Bottom,,0000,0000,0000,,Ішінен мүмкін емес. Жаммер бар,
Dialogue: 0,0:12:34.33,0:12:37.59,Top,,0000,0000,0000,,бірақ шифрлау дірілдейді. Жақында олар біздің позициямызды тартып алады,
Dialogue: 0,0:12:34.37,0:12:37.63,Bottom,,0000,0000,0000,,бірақ шифрлау дірілдейді. Жақында олар біздің позициямызды тартып алады,
Dialogue: 0,0:12:37.67,0:12:39.50,Top,,0000,0000,0000,,егер біз қатты жабынды таппасақ.
Dialogue: 0,0:12:37.71,0:12:39.55,Bottom,,0000,0000,0000,,егер біз қатты қақпақ таппайынша.
Dialogue: 0,0:12:39.59,0:12:43.30,Top,,0000,0000,0000,,[Мэн] Сонда бұл Альдодікі. Онда қауіпсіз болу керек. Біздің жолда.
Dialogue: 0,0:12:39.63,0:12:43.34,Bottom,,0000,0000,0000,,Сонда бұл Альдодікі. Онда қауіпсіз болу керек. Біздің жолда.
Dialogue: 0,0:12:43.38,0:12:45.34,Top,,0000,0000,0000,,А-а, блять, комм үзіліп жатыр.
Dialogue: 0,0:12:43.42,0:12:45.38,Bottom,,0000,0000,0000,,А-а, блять, байланыс үзілді.
Dialogue: 0,0:12:45.43,0:12:46.47,Top,,0000,0000,0000,,-Мен тартыламын ба? -[Мэн] Жоқ!
Dialogue: 0,0:12:45.47,0:12:46.51,Bottom,,0000,0000,0000,,-Мен тартыламын ба? -Жоқ!
Dialogue: 0,0:12:46.55,0:12:50.14,Top,,0000,0000,0000,,Гео статистикасы сізді ренжітеді, олар сіздің есегіңізге соққы түсіреді.
Dialogue: 0,0:12:46.59,0:12:50.18,Bottom,,0000,0000,0000,,Гео статистикасы сізді ренжітеді, олар сіздің есегіңізге соққы түсіреді.
Dialogue: 0,0:12:50.22,0:12:51.43,Top,,0000,0000,0000,,Тозақ сияқты жүріңіз!
Dialogue: 0,0:12:50.26,0:12:51.47,Bottom,,0000,0000,0000,,Тозақ сияқты жүріңіз!
Dialogue: 0,0:12:51.52,0:12:52.73,Top,,0000,0000,0000,,-[құрылғы дыбыстық сигналы] -[Дэвид ырылдады]
Dialogue: 0,0:12:52.81,0:12:54.81,Top,,0000,0000,0000,,-Маршрутты жіберу. -Рақмет сізге.
Dialogue: 0,0:12:52.85,0:12:54.85,Bottom,,0000,0000,0000,,-Маршрутты қорытындылау. -Рақмет сізге.
Dialogue: 0,0:12:54.89,0:12:55.98,Top,,0000,0000,0000,,[ырылдады]
Dialogue: 0,0:12:56.06,0:12:59.40,Top,,0000,0000,0000,,-Сіз біз мұны істей аламыз деп ойлайсыз ба? -Енді өзіңе байланысты.
Dialogue: 0,0:12:56.10,0:12:59.44,Bottom,,0000,0000,0000,,-Сіз біз мұны істей аламыз деп ойлайсыз ба? -Енді өзіңе байланысты.
Dialogue: 0,0:12:59.48,0:13:01.73,Top,,0000,0000,0000,,[ырылдады]
Dialogue: 0,0:13:01.82,0:13:04.53,Top,,0000,0000,0000,,-Саған қараңдар. Сіз іс жүзінде кәсіпқойсыз. -[мысқылдап]
Dialogue: 0,0:13:01.86,0:13:04.57,Bottom,,0000,0000,0000,,Саған қара. Сіз іс жүзінде кәсіпқойсыз.
Dialogue: 0,0:13:04.61,0:13:05.65,Top,,0000,0000,0000,,Сіз солай ойлайсыз ба?
Dialogue: 0,0:13:04.65,0:13:05.70,Bottom,,0000,0000,0000,,Сіз солай ойлайсыз ба?
Dialogue: 0,0:13:05.74,0:13:08.07,Top,,0000,0000,0000,,Менің айтайын дегенім, егер автопилот қосылмаған болса.
Dialogue: 0,0:13:05.78,0:13:08.12,Bottom,,0000,0000,0000,,Менің айтайын дегенім, егер автопилот қосылмаған болса.
Dialogue: 0,0:13:08.16,0:13:09.78,Top,,0000,0000,0000,,[мысқылдап] Не болса да.
Dialogue: 0,0:13:08.20,0:13:09.83,Bottom,,0000,0000,0000,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 0,0:13:09.87,0:13:10.99,Top,,0000,0000,0000,,[Люси] Бізде серіктестік бар.
Dialogue: 0,0:13:09.91,0:13:11.04,Bottom,,0000,0000,0000,,Бізде серіктестік бар.
Dialogue: 0,0:13:11.54,0:13:12.58,Top,,0000,0000,0000,,[Дэвид] Иә?
Dialogue: 0,0:13:11.58,0:13:12.62,Bottom,,0000,0000,0000,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:13:12.66,0:13:14.79,Top,,0000,0000,0000,,-[жаман күлкі] -[Дэвид] Тайгер тырнақтары?
Dialogue: 0,0:13:12.70,0:13:14.83,Bottom,,0000,0000,0000,,Тайгер тырнақтары?
Dialogue: 0,0:13:16.17,0:13:19.46,Top,,0000,0000,0000,,[Люси мазақ етеді] Максим Муста біздің жаңа сапарымызға сыйлық берді.
Dialogue: 0,0:13:16.21,0:13:19.50,Bottom,,0000,0000,0000,,Максим оларға жаңа көлік сыйлаған болуы керек.
Dialogue: 0,0:13:19.54,0:13:22.05,Top,,0000,0000,0000,,-Бұл тез? -Сондықтан біз корпуспен ұрыспаймыз.
Dialogue: 0,0:13:19.59,0:13:22.09,Bottom,,0000,0000,0000,,-Бұл тез? -Егер біз корпуспен ұрыспасақ жақсы.
Dialogue: 0,0:13:22.13,0:13:24.34,Top,,0000,0000,0000,,-Олардың велосипедте артықшылығы бар.
Dialogue: 0,0:13:22.17,0:13:24.38,Bottom,,0000,0000,0000,,Велосипедтердің артықшылығын жасаңыз.
Dialogue: 0,0:13:24.42,0:13:25.84,Top,,0000,0000,0000,,[Люси] Осы жерден тас жолды ұстаңыз.
Dialogue: 0,0:13:24.47,0:13:25.88,Bottom,,0000,0000,0000,,Тас жолды осы жерден алыңыз.
Dialogue: 0,0:13:25.93,0:13:27.59,Top,,0000,0000,0000,,[Тайгер тырнақтары айғайлайды]
Dialogue: 0,0:13:27.68,0:13:29.64,Top,,0000,0000,0000,,[Тайгер тырнақтары 1 жапон тіліндегі] Тұйық жол, таңда!
Dialogue: 0,0:13:27.72,0:13:29.68,Bottom,,0000,0000,0000,,Неге жүгіресің?
Dialogue: 0,0:13:29.72,0:13:30.80,Top,,0000,0000,0000,,[Тайгер тырнақтары 2 жапон тіліндегі] Қорқақтар!
Dialogue: 0,0:13:29.76,0:13:30.85,Bottom,,0000,0000,0000,,Қайтіңдер, төбелесіңдер, қорқақтар!
Dialogue: 0,0:13:30.89,0:13:34.60,Top,,0000,0000,0000,,-Тоқта және күрес! -[анықсыз айқайлау]
Dialogue: 0,0:13:30.93,0:13:34.64,Bottom,,0000,0000,0000,,Қайда бара жатырсың?
Dialogue: 0,0:13:34.68,0:13:36.52,Top,,0000,0000,0000,,[Дэвид] Бұл жігіттерді жоғалтуым керек.
Dialogue: 0,0:13:34.73,0:13:36.56,Bottom,,0000,0000,0000,,Мына жігіттерді жоғалтуым керек.
Dialogue: 0,0:13:37.10,0:13:38.60,Top,,0000,0000,0000,,Боқ. Жол қозғалысы?
Dialogue: 0,0:13:37.14,0:13:38.65,Bottom,,0000,0000,0000,,Боқ. Жол қозғалысы?
Dialogue: 0,0:13:38.69,0:13:40.06,Top,,0000,0000,0000,,[Люси] О, менің, менің…
Dialogue: 0,0:13:38.73,0:13:40.11,Bottom,,0000,0000,0000,,О, менің, менің…
Dialogue: 0,0:13:40.69,0:13:42.36,Top,,0000,0000,0000,,Жақсы емес.
Dialogue: 0,0:13:40.73,0:13:42.40,Bottom,,0000,0000,0000,,Жақсы емес.
Dialogue: 0,0:13:44.44,0:13:45.86,Top,,0000,0000,0000,,[Дэвид Грунтс]
Dialogue: 0,0:13:46.49,0:13:50.91,Top,,0000,0000,0000,,[өткір дем шығарады]
Dialogue: 0,0:13:57.21,0:13:59.12,Top,,0000,0000,0000,,Ух... Бізге жақындады.
Dialogue: 0,0:13:57.25,0:13:59.17,Bottom,,0000,0000,0000,,Ух... Бізге жақындау.
Dialogue: 0,0:13:59.21,0:14:00.63,Top,,0000,0000,0000,,[жапон тілінде] Ақырын!
Dialogue: 0,0:13:59.25,0:14:00.67,Bottom,,0000,0000,0000,,Ақырын!
