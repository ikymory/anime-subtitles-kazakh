Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.21,0:00:03.04,Default,,0,0,0,,Забун
Dialogue: 0,0:00:03.16,0:00:04.17,Default,,0,0,0,,Я-Ха!
Dialogue: 0,0:00:04.33,0:00:06.17,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:00:10.05,0:00:11.01,Default,,0,0,0,,Уки!
Dialogue: 0,0:00:11.13,0:00:12.38,Default,,0,0,0,,Күтілгендей, бұл сәйкестік
Dialogue: 0,0:00:12.47,0:00:14.59,Default,,0,0,0,,Сүлік жын кілтті ұстайды
Dialogue: 0,0:00:14.72,0:00:16.97,Default,,0,0,0,,Хирума Юичи, ол жігіт...
Dialogue: 0,0:00:20.89,0:00:23.73,Default,,0,0,0,,Бұл Deimon Devil Bats-тің артқы эйсі.
Dialogue: 0,0:00:24.39,0:00:26.60,Default,,0,0,0,,Я-Ха! (ысқырық дыбысы)
Dialogue: 0,0:00:26.73,0:00:28.44,Default,,0,0,0,,Қозғалыс!
Dialogue: 0,0:00:28.57,0:00:31.69,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:00:31.82,0:00:33.82,Default,,0,0,0,,Ушишиши... хахаха...
Dialogue: 0,0:00:33.95,0:00:36.28,Default,,0,0,0,,Урья~
Dialogue: 0,0:00:39.16,0:00:42.08,Default,,0,0,0,,Ағынды бірден тартуды жалғастырыңыз.
Dialogue: 0,0:00:42.20,0:00:43.58,Default,,0,0,0,,Сіз келесіге барасыз.
Dialogue: 0,0:00:44.75,0:00:45.75,Default,,0,0,0,,Иә
Dialogue: 0,0:00:47.04,0:00:48.79,Default,,0,0,0,,Теме - бұл кілт
Dialogue: 0,0:00:49.29,0:00:51.92,Default,,0,0,0,,Мен кілтпін...
Dialogue: 0,0:00:52.67,0:00:54.47,Default,,0,0,0,,Бұл анық.
Dialogue: 0,0:00:54.76,0:00:57.18,Default,,0,0,0,,Сіз балшық қақпасының ацысысыз.
Dialogue: 0,0:00:57.55,0:01:00.97,Default,,0,0,0,,Аа... мен эйспін...
Dialogue: 0,0:01:02.06,0:01:07.06,Default,,0,0,0,,♪~
Dialogue: 0,0:02:19.30,0:02:24.31,Default,,0,0,0,,~♪
Dialogue: 0,0:02:31.02,0:02:35.73,Default,,0,0,0,,Ібіліс жарғанақтар Ібіліс жарғанаттар Ібіліс жарғанаттар...
Dialogue: 0,0:02:35.86,0:02:36.86,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:02:41.20,0:02:42.45,Default,,0,0,0,,Қалпақ киіңіз!
Dialogue: 0,0:02:45.54,0:02:47.04,Default,,0,0,0,,Мені ұр!
Dialogue: 0,0:02:47.50,0:02:50.00,Default,,0,0,0,,Хмф! (Комусуби) Фуго!
Dialogue: 0,0:02:50.12,0:02:52.00,Default,,0,0,0,,Фуннураба!
Dialogue: 0,0:02:52.13,0:02:55.75,Default,,0,0,0,,Гаххаха... Бұл өте оңай.
Dialogue: 0,0:03:03.14,0:03:04.35,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:04.47,0:03:07.47,Default,,0,0,0,,Көз қалқанын тоқтатыңыз! Охира Ониши!
Dialogue: 0,0:03:07.60,0:03:09.31,Default,,0,0,0,,♬~
Dialogue: 0,0:03:09.43,0:03:11.06,Default,,0,0,0,,Мені жалап қойсаң, мәселе болар еді.
Dialogue: 0,0:03:11.19,0:03:14.02,Default,,0,0,0,,Біз Жапонияның ең үлкен терең қорғанысымыз
Dialogue: 0,0:03:14.15,0:03:15.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:15.61,0:03:18.44,Default,,0,0,0,,Курита мырза мен Комусуби мырза ашқан жол
Dialogue: 0,0:03:18.99,0:03:19.74,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:19.86,0:03:21.40,Default,,0,0,0,,Уау~
Dialogue: 0,0:03:21.99,0:03:24.49,Default,,0,0,0,,Екі қарсылас болса да...
Dialogue: 0,0:03:24.62,0:03:26.45,Default,,0,0,0,,Уау~
Dialogue: 0,0:03:35.59,0:03:37.42,Default,,0,0,0,,Уау~
Dialogue: 0,0:03:42.51,0:03:45.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:52.77,0:03:54.94,Default,,0,0,0,,Ах... бұл жүгіру...
Dialogue: 0,0:03:55.48,0:03:59.28,Default,,0,0,0,,Иә! Ол шықты!
Dialogue: 0,0:03:59.40,0:04:00.90,Default,,0,0,0,,Ібілістің елесі!
Dialogue: 0,0:04:01.03,0:04:02.90,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:04:03.03,0:04:04.74,Default,,0,0,0,,Мен шештім!
Dialogue: 0,0:04:04.86,0:04:07.87,Default,,0,0,0,,Айсшилд 21 Тамаша соққы!
Dialogue: 0,0:04:07.99,0:04:10.25,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:04:10.37,0:04:12.66,Default,,0,0,0,,Ах~ Бірінші тайм аяқталды.
Dialogue: 0,0:04:12.79,0:04:14.62,Default,,0,0,0,,Жаман аяқталмайды.
Dialogue: 0,0:04:14.75,0:04:18.63,Default,,0,0,0,,Осылай жалғастырып, екінші таймға кірсек, жеңіске жету мүмкіндігіміз жоғары.
Dialogue: 0,0:04:19.59,0:04:21.26,Default,,0,0,0,,Сіз оны міндетті түрде кері қайтара аласыз.
Dialogue: 0,0:04:21.38,0:04:25.18,Default,,0,0,0,,Ей, 2 ұпай айырма, бірден барайық!
Dialogue: 0,0:04:25.30,0:04:28.10,Default,,0,0,0,,Иә, иә, біз оны міндетті түрде итермелеп жатырмыз.
Dialogue: 0,0:04:28.22,0:04:29.76,Default,,0,0,0,,Сена-кун, сен істедің!
Dialogue: 0,0:04:29.89,0:04:32.48,Default,,0,0,0,,Иә, осылай жүре берейік.
Dialogue: 0,0:04:32.60,0:04:33.85,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:04:33.98,0:04:37.48,Default,,0,0,0,,Мәселе мынада: тілеуішті қанша жерге итеруге болады?
Dialogue: 0,0:04:37.61,0:04:39.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:39.61,0:04:41.07,Default,,0,0,0,,Мына қарғыс атқан көздер⸺
Dialogue: 0,0:04:41.19,0:04:43.95,Default,,0,0,0,,Саусақтарымды осылай айқастырып, үндемей қалатынымды елестете алмаймын.
Dialogue: 0,0:04:46.61,0:04:49.53,Default,,0,0,0,,Бұл Айсшилд 21...
Dialogue: 0,0:04:49.66,0:04:52.25,Default,,0,0,0,,Бірден болған соң, бітеді.
Dialogue: 0,0:04:52.37,0:04:53.91,Default,,0,0,0,,Оның тоқтап қалуы мүмкін емес
Dialogue: 0,0:04:54.91,0:04:56.87,Default,,0,0,0,,Бірден тоқтатыңыз
Dialogue: 0,0:04:57.00,0:04:57.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:57.75,0:05:00.46,Default,,0,0,0,,Иә? Тілек сүйегінің шешімі бар ма?
Dialogue: 0,0:05:00.59,0:05:03.13,Default,,0,0,0,,Жоқ, әрине менің де бір ойым бар.
Dialogue: 0,0:05:03.26,0:05:06.59,Default,,0,0,0,,Маған кіші сынып оқушыларым айтқаны дұрыс па деп ойлаймын...
Dialogue: 0,0:05:07.47,0:05:09.01,Default,,0,0,0,,Балшық қақпасының тілегі⸺
Dialogue: 0,0:05:09.14,0:05:11.76,Default,,0,0,0,,Осы қорғаныс жүйесін бір сәтте анықтаңыз
Dialogue: 0,0:05:11.89,0:05:14.93,Default,,0,0,0,,Менің күштілігім - ең үлкен алшақтық бар жерде жүгіре аламын.
Dialogue: 0,0:05:15.06,0:05:16.69,Default,,0,0,0,,Нару Ходо
Dialogue: 0,0:05:16.81,0:05:19.69,Default,,0,0,0,,Алшақтықты қай жерден ашу керектігін шешсек
Dialogue: 0,0:05:19.81,0:05:23.40,Default,,0,0,0,,Бұл Деймонның жүгіруін қалауыңызша басқара алатыныңызды білдіре ме?
Dialogue: 0,0:05:25.86,0:05:29.45,Default,,0,0,0,,Олай болса, мүмкіндігінше кішкене қуырып алайық.
Dialogue: 0,0:05:29.57,0:05:32.37,Default,,0,0,0,,Кәкей күткендей, өте дұрыс айтасыз!
Dialogue: 0,0:05:32.49,0:05:37.29,Default,,0,0,0,,Дәл мен ойлаған нәрсе! Сонда мен кімге жүгіруім керек?
Dialogue: 0,0:05:37.58,0:05:39.25,Default,,0,0,0,,Қабақ 21
Dialogue: 0,0:05:39.38,0:05:40.75,Default,,0,0,0,,Иә! (Мидзумачи) Пух!
Dialogue: 0,0:05:41.25,0:05:45.17,Default,,0,0,0,,Барлық Mizumachi және басқалары Eyeshield-тен басқа жүгірулерді блоктайды.
Dialogue: 0,0:05:45.30,0:05:47.26,Default,,0,0,0,,Бұл қиын емес.
Dialogue: 0,0:05:47.38,0:05:49.22,Default,,0,0,0,,Жоқ, бұл дұрыс, бірақ...
Dialogue: 0,0:05:49.43,0:05:53.93,Default,,0,0,0,,Басқаша айтқанда... Мен бұрынғы әдістемені қолданамын.
Dialogue: 0,0:05:57.02,0:05:59.65,Default,,0,0,0,,Қарастырылып отырған техника дегенді қалай түсінесіңдер?
Dialogue: 0,0:05:59.77,0:06:00.98,Default,,0,0,0,,Жарайды, түсіндім.
Dialogue: 0,0:06:01.11,0:06:04.86,Default,,0,0,0,,Олай болса, қалғанымызды тоқтату туралы ойлануымыз керек.
Dialogue: 0,0:06:05.32,0:06:07.82,Default,,0,0,0,,Егер мен Eyeshield көмегімен жеке жеңіске жетсем⸺
Dialogue: 0,0:06:08.40,0:06:10.66,Default,,0,0,0,,Мудгейттің тілегі енді жұмыс істемейді.
Dialogue: 0,0:06:10.95,0:06:14.49,Default,,0,0,0,,Алып Посейдонның басымдығы небәрі 2 ұпай.
Dialogue: 0,0:06:14.74,0:06:16.16,Default,,0,0,0,,Бірінші таймның соңына таман⸺
Dialogue: 0,0:06:16.29,0:06:17.25,Default,,0,0,0,,Деймон Ібіліс Жарғанаттар қатты итеріп жатты
Dialogue: 0,0:06:17.25,0:06:19.33,Default,,0,0,0,,Деймон Ібіліс Жарғанаттар қатты итеріп жатты
Dialogue: 0,0:06:17.25,0:06:19.33,Default,,0,0,0,,Ібіліс жарғанақтар Ібіліс жарғанақтар...
Dialogue: 0,0:06:19.33,0:06:19.46,Default,,0,0,0,,Ібіліс жарғанақтар Ібіліс жарғанақтар...
Dialogue: 0,0:06:19.46,0:06:21.08,Default,,0,0,0,,Ібіліс жарғанақтар Ібіліс жарғанақтар...
Dialogue: 0,0:06:19.46,0:06:21.08,Default,,0,0,0,,Посейдон Ібіліс жарғанаттарының тілегінен қалай қорғайды?
Dialogue: 0,0:06:21.08,0:06:22.84,Default,,0,0,0,,Посейдон Ібіліс жарғанаттарының тілегінен қалай қорғайды?
Dialogue: 0,0:06:22.96,0:06:24.92,Default,,0,0,0,,Ойын аяқталды⸺
Dialogue: 0,0:06:25.05,0:06:28.55,Default,,0,0,0,,Екі команданың тағдыры қыл үстінде тұрған ойынның екінші жартысына аяқ басып жатырмыз!
Dialogue: 0,0:06:28.93,0:06:30.72,Default,,0,0,0,,Иә? Сәлем~
Dialogue: 0,0:06:30.84,0:06:35.14,Default,,0,0,0,,Ии~ Хихи... Хии~
Dialogue: 0,0:06:35.97,0:06:38.02,Default,,0,0,0,,Ал... тізіліп...
Dialogue: 0,0:06:38.14,0:06:41.60,Default,,0,0,0,,Ал қатарынан 3 адам, бұл қалыпты жағдай
Dialogue: 0,0:06:42.65,0:06:44.61,Default,,0,0,0,,О, түсіндім. Ол жер жергілікті көрікті жерге айналған екен, иә?
Dialogue: 0,0:06:44.73,0:06:49.07,Default,,0,0,0,,Комусуби-кун дененің маңызды емес екенін дәлелдеді.
Dialogue: 0,0:06:50.03,0:06:52.82,Default,,0,0,0,,Барлығы мені блоктаса, ол бір-бірден болады.
Dialogue: 0,0:06:52.95,0:06:55.08,Default,,0,0,0,,Ібіліс жарғанат елесі арқылы қалай да құтылыңыз
Dialogue: 0,0:06:55.20,0:06:56.08,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:06:56.20,0:06:57.79,Default,,0,0,0,,Мен оны тартып алуым керек!
Dialogue: 0,0:06:57.91,0:07:00.42,Default,,0,0,0,,Енді екінші таймда бар күшімізді салайық!
Dialogue: 0,0:07:00.54,0:07:02.00,Default,,0,0,0,,Барлығы күреседі!
Dialogue: 0,0:07:07.34,0:07:11.72,Default,,0,0,0,,Екінші таймға 30 минут қалды, біз міндетті түрде кестені бұрып, жартылай финалға өтеміз!
Dialogue: 0,0:07:11.84,0:07:13.72,Default,,0,0,0,,Көз қалқанынан басқа сені тоқтатпаймын!
Dialogue: 0,0:07:13.85,0:07:14.93,Default,,0,0,0,,О!
Dialogue: 0,0:07:15.05,0:07:16.43,Default,,0,0,0,,♬~
Dialogue: 0,0:07:18.22,0:07:20.10,Default,,0,0,0,,Осыны бірден айналдырайық!
Dialogue: 0,0:07:20.23,0:07:21.52,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:07:21.64,0:07:23.40,Default,,0,0,0,,Қабақ қалқаны!
Dialogue: 0,0:07:23.52,0:07:25.57,Default,,0,0,0,,Уа... жоқ, сәл күте тұрыңыз.
Dialogue: 0,0:07:31.82,0:07:33.70,Default,,0,0,0,,Әдейі азғырған Көз қалқаны
Dialogue: 0,0:07:33.82,0:07:34.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:34.87,0:07:38.41,Default,,0,0,0,,Кәкейден бір адам кетсе, төбелес болады...
Dialogue: 0,0:07:40.79,0:07:43.75,Default,,0,0,0,,Ібілістің елесі кенеттен қайтады.
Dialogue: 0,0:07:57.56,0:08:00.77,Default,,0,0,0,,Какей шынайы американдық мектепте қалай жеңілді⸺
Dialogue: 0,0:08:00.89,0:08:03.90,Default,,0,0,0,,Ойынға қатыса алатын басқа жапондықтар бар ма?
Dialogue: 0,0:08:04.44,0:08:06.69,Default,,0,0,0,,Бұл жүгіру, әрине, таңқаларлық.
Dialogue: 0,0:08:06.81,0:08:09.23,Default,,0,0,0,,Өте жылдамдықты тікелей жарылыстан⸺
Dialogue: 0,0:08:09.36,0:08:12.20,Default,,0,0,0,,Ол 0 секундта күрт қисық жасап, сізге соғылады.
Dialogue: 0,0:08:12.32,0:08:14.36,Default,,0,0,0,,Бірақ егер сіз дәл сол 0 секундта аралықты жапсаңыз...
Dialogue: 0,0:08:15.36,0:08:17.03,Default,,0,0,0,,Мен саған айтамын, жалған.
Dialogue: 0,0:08:17.16,0:08:20.33,Default,,0,0,0,,Кішкентай бұрылыстар сізді нақты деңгейге жеткізе алмайды!
Dialogue: 0,0:08:21.00,0:08:23.29,Default,,0,0,0,,Алға~ Көз қалқаны!
Dialogue: 0,0:08:25.83,0:08:26.54,Default,,0,0,0,,Уф… Ах…
Dialogue: 0,0:08:29.13,0:08:30.42,Default,,0,0,0,,Уау, ол қазірдің өзінде осында.
Dialogue: 0,0:08:30.55,0:08:33.26,Default,,0,0,0,,Бұл қысым... Енді иілуім керек!
Dialogue: 0,0:08:40.72,0:08:41.64,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:42.73,0:08:44.64,Default,,0,0,0,,♬~
Dialogue: 0,0:08:53.65,0:08:55.49,Default,,0,0,0,,Уа!
Dialogue: 0,0:09:02.79,0:09:03.62,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:03.75,0:09:05.41,Default,,0,0,0,,Ақымақ...
Dialogue: 0,0:09:05.92,0:09:08.96,Default,,0,0,0,,Ібіліс... Ібіліс жарғанатының елесі
Dialogue: 0,0:09:09.09,0:09:11.38,Default,,0,0,0,,Ол бұзылады!
Dialogue: 0,0:09:11.50,0:09:13.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:14.05,0:09:17.89,Default,,0,0,0,,Кәкей Кәкей Кәкей…
Dialogue: 0,0:09:18.39,0:09:20.43,Default,,0,0,0,,Ібіліс жарғанатының елесі...
Dialogue: 0,0:09:20.55,0:09:22.10,Default,,0,0,0,,Өте алмадым...
Dialogue: 0,0:09:22.22,0:09:23.47,Default,,0,0,0,,Мен оған сенбеймін…
Dialogue: 0,0:09:23.60,0:09:25.85,Default,,0,0,0,,Мынау Шун Кәкей...
Dialogue: 0,0:09:25.98,0:09:27.69,Default,,0,0,0,,Мен мұндай адам бар деп ойламаппын...
Dialogue: 0,0:09:27.81,0:09:32.65,Default,,0,0,0,,Кәкейдің өлімге әкеліп соқтырған соққысы жарылды! Бірақ бұл техника дегеніміз не?
Dialogue: 0,0:09:32.78,0:09:35.07,Default,,0,0,0,,Өйткені, Кәкейдің Моби Дик якорьі
Dialogue: 0,0:09:35.19,0:09:37.03,Default,,0,0,0,,Ол күшті ме, әлде күшті ме?
Dialogue: 0,0:09:37.15,0:09:38.61,Default,,0,0,0,,Керемет!
Dialogue: 0,0:09:38.74,0:09:42.87,Default,,0,0,0,,Түсіндің бе? Ешқандай алаяқ мені алдай алмайды.
Dialogue: 0,0:09:44.04,0:09:47.79,Default,,0,0,0,,Бұл матчтың жеңімпазы анықталды.
Dialogue: 0,0:09:48.71,0:09:51.75,Default,,0,0,0,,Ібіліс жарғанатының елесі тоқтатылды...
Dialogue: 0,0:09:56.59,0:09:59.22,Default,,0,0,0,,Мен құбыжықтың терісін толығымен жұлып аламын.
Dialogue: 0,0:10:00.60,0:10:03.18,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:10:04.27,0:10:08.02,Default,,0,0,0,,Қанша уақыттан бері аңырап жүрсің! Ойын әлі аяқталған жоқ!
Dialogue: 0,0:10:04.27,0:10:08.02,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:10:08.02,0:10:08.14,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:10:08.14,0:10:09.60,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:10:08.14,0:10:09.60,Default,,0,0,0,,Иә
Dialogue: 0,0:10:09.73,0:10:15.44,Default,,0,0,0,,Цк, әлгі қарғыс атқыр көздер, сен бұл техниканы шынымен жасырдың ба?
Dialogue: 0,0:10:15.86,0:10:19.16,Default,,0,0,0,,Әлі жоқ! Бұдан былай, қазірден бастап!
Dialogue: 0,0:10:21.28,0:10:22.83,Default,,0,0,0,,Мен оны осы жолы шығарып алуым керек...
Dialogue: 0,0:10:22.95,0:10:24.12,Default,,0,0,0,,Қалпақ киіңіз!
Dialogue: 0,0:10:24.45,0:10:27.33,Default,,0,0,0,,Артымнан жамылғы керек емес, қатты итеріп жібер!
Dialogue: 0,0:10:27.46,0:10:29.12,Default,,0,0,0,,Eyeshield-тен басқаның бәрін тоқтатыңыз!
Dialogue: 0,0:10:29.25,0:10:31.88,Default,,0,0,0,,Уау! (Курита) Эй!
Dialogue: 0,0:10:33.21,0:10:33.84,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:38.67,0:10:41.01,Default,,0,0,0,,Уишбоунның әлсіздігі көрінеді...
Dialogue: 0,0:10:41.14,0:10:41.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:42.05,0:10:44.26,Default,,0,0,0,,Монта мен Eyeshield комбинациясы⸺
Dialogue: 0,0:10:44.39,0:10:46.89,Default,,0,0,0,,Ол тыныс алады, бірақ ол, әрине, күшті.
Dialogue: 0,0:10:47.02,0:10:49.64,Default,,0,0,0,,Нәтижесінде пас не болса да әлсіз болады.
Dialogue: 0,0:10:50.06,0:10:51.27,Default,,0,0,0,,Өйткені мен мұны білемін
Dialogue: 0,0:10:51.40,0:10:53.44,Default,,0,0,0,,Тіпті жау да жүгіруді тоқтатуға батылы жетеді⸺
Dialogue: 0,0:10:53.56,0:10:55.44,Default,,0,0,0,,Мен асығыс кіріп, мұны істеймін.
Dialogue: 0,0:10:55.57,0:10:59.11,Default,,0,0,0,,Сонымен қатар, тіпті Ібіліс жарғанатының елесі де тоқтатылды...
Dialogue: 0,0:11:01.49,0:11:03.74,Default,,0,0,0,,Ібіліс жарғанатының елесі өте алмайды...
Dialogue: 0,0:11:06.70,0:11:10.04,Default,,0,0,0,,♬~
Dialogue: 0,0:11:10.33,0:11:12.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:12.46,0:11:13.79,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:11:13.92,0:11:18.76,Default,,0,0,0,,Посейдон Посейдон...
Dialogue: 0,0:11:19.17,0:11:20.01,Default,,0,0,0,,Тағы да
Dialogue: 0,0:11:20.13,0:11:22.72,Default,,0,0,0,,Ібіліс жарғанатының елесі тоқтатылды!
Dialogue: 0,0:11:25.51,0:11:27.85,Default,,0,0,0,,Қанша талпынсам да, бәрібір
Dialogue: 0,0:11:30.39,0:11:31.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:31.52,0:11:32.77,Default,,0,0,0,,Дөңмай Дөңмай
Dialogue: 0,0:11:32.90,0:11:35.15,Default,,0,0,0,,Жарайды, келесі жолы шығамын.
Dialogue: 0,0:11:36.32,0:11:37.65,Default,,0,0,0,,Негізінен, біз қашамыз.
Dialogue: 0,0:11:37.78,0:11:42.11,Default,,0,0,0,,Егер мен Кәкей-күннен өтпесем, Ібіліс жарғанаттарының жеңу мүмкіндігі жоқ...
Dialogue: 0,0:11:42.24,0:11:43.95,Default,,0,0,0,,Келіңіздер, шайтан шайтан жарғанақтар
Dialogue: 0,0:11:44.07,0:11:47.08,Default,,0,0,0,,Айсшилд 21 қамтылған болса, ештеңе істеуге болмайды!
Dialogue: 0,0:11:52.37,0:11:53.71,Default,,0,0,0,,Бұл алаңдатады.
Dialogue: 0,0:11:53.83,0:11:55.46,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:12:01.84,0:12:04.84,Default,,0,0,0,,Е, бұл мен емес...
Dialogue: 0,0:12:04.97,0:12:07.30,Default,,0,0,0,,Сызықшалар!
Dialogue: 0,0:12:07.64,0:12:10.81,Default,,0,0,0,,Сенің келетініңді білдім, Ониши!
Dialogue: 0,0:12:10.93,0:12:11.77,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:12:11.89,0:12:12.94,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:12:13.06,0:12:16.73,Default,,0,0,0,,Deimon Жоқ бірінші төмен!
Dialogue: 0,0:12:17.11,0:12:19.19,Default,,0,0,0,,Монта-кун да тоқтатылды...
Dialogue: 0,0:12:19.32,0:12:20.94,Default,,0,0,0,,Әлі де ұрыс!
Dialogue: 0,0:12:21.07,0:12:23.15,Default,,0,0,0,,Посейдон Посейдон...
Dialogue: 0,0:12:23.15,0:12:25.45,Default,,0,0,0,,Посейдон Посейдон...
Dialogue: 0,0:12:23.15,0:12:25.45,Default,,0,0,0,,Сіз тіпті допты айналдыра алмайсыз⸺
Dialogue: 0,0:12:25.57,0:12:27.91,Default,,0,0,0,,Ақырында достарыңыз сізді тастап кеткен сияқты.
Dialogue: 0,0:12:25.57,0:12:27.91,Default,,0,0,0,,Посейдон Посейдон...
Dialogue: 0,0:12:31.58,0:12:32.25,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:12:32.37,0:12:33.79,Default,,0,0,0,,Шешілді!
Dialogue: 0,0:12:33.91,0:12:38.17,Default,,0,0,0,,Доп соғылып, есеп 17-12!
Dialogue: 0,0:12:38.29,0:12:41.67,Default,,0,0,0,,(Кёшин мүшелерінің қуаныш дауыстары)
Dialogue: 0,0:12:42.34,0:12:45.01,Default,,0,0,0,,Посейдон басым.
Dialogue: 0,0:12:45.13,0:12:46.80,Default,,0,0,0,,Посейдон Посейдон…
Dialogue: 0,0:12:47.18,0:12:49.97,Default,,0,0,0,,Деймон Ібіліс Жарғанаттар Қазір бәрі осы ма?
Dialogue: 0,0:12:50.60,0:12:54.52,Default,,0,0,0,,Мен шарасыз жағдайға мәжбүр болдым!
Dialogue: 0,0:12:58.56,0:13:00.36,Default,,0,0,0,,Оны маған енді бермейді...
Dialogue: 0,0:13:00.48,0:13:02.32,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:13:02.44,0:13:04.28,Default,,0,0,0,,Фуго!
Dialogue: 0,0:13:04.40,0:13:07.11,Default,,0,0,0,,Мукья!
Dialogue: 0,0:13:07.24,0:13:10.78,Default,,0,0,0,,Жоқ... ниетім толығымен оқылды.
Dialogue: 0,0:13:10.91,0:13:12.16,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:13:12.29,0:13:14.33,Default,,0,0,0,,Менің енді уақытым жоқ
Dialogue: 0,0:13:16.08,0:13:16.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:17.33,0:13:18.17,Default,,0,0,0,,Уф…
Dialogue: 0,0:13:18.29,0:13:20.88,Default,,0,0,0,,Мен мүлде алға жылжи алмаймын.
Dialogue: 0,0:13:21.00,0:13:22.67,Default,,0,0,0,,Фуго
Dialogue: 0,0:13:25.63,0:13:27.05,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:13:27.30,0:13:29.72,Default,,0,0,0,,Түсіндіңіз бе? Жалған көз қалқаны
Dialogue: 0,0:13:30.22,0:13:31.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:31.47,0:13:35.35,Default,,0,0,0,,Егер сіз көздің қалқанын бұзсаңыз, солай болады.
Dialogue: 0,0:13:35.48,0:13:39.19,Default,,0,0,0,,Кешіріңіз, бірақ сіз бұл матчта жоғалып кетуіңіз керек.
Dialogue: 0,0:13:39.31,0:13:41.52,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:13:41.65,0:13:43.65,Default,,0,0,0,,!! Райнер…
Dialogue: 0,0:13:47.45,0:13:48.16,Default,,0,0,0,,Тұру
Dialogue: 0,0:13:48.28,0:13:49.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:50.16,0:13:51.62,Default,,0,0,0,,Тұр!
Dialogue: 0,0:13:52.20,0:13:57.12,Default,,0,0,0,,Тұр, тұр! Орныңыздан тұрыңыз, батылдығыңызды көрсетіңіз!
Dialogue: 0,0:13:57.96,0:14:00.13,Default,,0,0,0,,«Жеңіске жете бер» деп айтпадың ба?
Dialogue: 0,0:14:00.50,0:14:02.34,Default,,0,0,0,,«Күзгі турнир аяқталмайды»!
Dialogue: 0,0:14:02.71,0:14:07.34,Default,,0,0,0,,«Біз барлық шайтан шайтан жарғанаттары бірге болатын күнге дейін ешқашан жеңілмейміз»⸺
Dialogue: 0,0:14:07.47,0:14:09.01,Default,,0,0,0,,Сіз маған айттыңыз!
Dialogue: 0,0:14:09.26,0:14:10.93,Default,,0,0,0,,Юки-сан…
Dialogue: 0,0:14:11.68,0:14:16.48,Default,,0,0,0,,(Юкимицудың айқайы)
Dialogue: 0,0:14:21.94,0:14:24.82,Default,,0,0,0,,1-тур Амино орта мектебі
Dialogue: 0,0:14:25.28,0:14:28.90,Default,,0,0,0,,Егер сіз Аминоны жеңсеңіз, турнир жалғасады, Монта!
Dialogue: 0,0:14:29.49,0:14:30.45,Default,,0,0,0,,Лорд Тенген…
Dialogue: 0,0:14:30.57,0:14:33.95,Default,,0,0,0,,Біз жеңіске жеткенше, күзгі турнир ешқашан аяқталмайды, Сена!
Dialogue: 0,0:14:37.00,0:14:40.12,Default,,0,0,0,,Барлық шайтан шайтандары жиналған күнге дейін!
Dialogue: 0,0:14:45.13,0:14:46.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:47.30,0:14:48.80,Default,,0,0,0,,Қабақ қалқаны!
Dialogue: 0,0:14:49.09,0:14:50.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:50.97,0:14:54.01,Default,,0,0,0,,Америка футболын жалғыз ойнамаңыз!
Dialogue: 0,0:14:54.14,0:14:57.77,Default,,0,0,0,,Ібіліс жарғанақтары жалғыз сіздің команда емес!
Dialogue: 0,0:14:58.06,0:14:59.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:01.56,0:15:05.02,Default,,0,0,0,,Сена, бәріміз оларды жеңейік.
Dialogue: 0,0:15:05.15,0:15:06.36,Default,,0,0,0,,Монта…
Dialogue: 0,0:15:07.23,0:15:09.28,Default,,0,0,0,,Барлығымыз қолымыздан келгеннің бәрін жасайық!
Dialogue: 0,0:15:09.40,0:15:10.32,Default,,0,0,0,,Фуго
Dialogue: 0,0:15:10.78,0:15:14.28,Default,,0,0,0,,Дұрыс... Мен жалғыз емеспін
Dialogue: 0,0:15:15.28,0:15:17.12,Default,,0,0,0,,Юки-сан дұрыс айтады.
Dialogue: 0,0:15:17.24,0:15:22.50,Default,,0,0,0,,Менің Кәкейден жеңілгенім Ібіліс жарғанаттарының жеңілгенін білдірмейді.
Dialogue: 0,0:15:23.13,0:15:25.46,Default,,0,0,0,,Барлығы менің соңымнан ереді
Dialogue: 0,0:15:28.46,0:15:31.47,Default,,0,0,0,,Дұрыс, мен де Юки-санға уәде бердім.
Dialogue: 0,0:15:31.88,0:15:35.30,Default,,0,0,0,,Ешқашан жеңілмеу керек, ешқашан берілмеу керек!
Dialogue: 0,0:15:35.43,0:15:37.26,Default,,0,0,0,,Әрине.
Dialogue: 0,0:15:37.39,0:15:38.93,Default,,0,0,0,,(Танжиро) Бірақ құбыжықтар жалғыз жүруі керек еді ғой?
Dialogue: 0,0:15:39.31,0:15:42.39,Default,,0,0,0,,Деймон Ібіліс жарғанақтар шайқасы!
Dialogue: 0,0:15:44.10,0:15:45.40,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:47.98,0:15:50.32,Default,,0,0,0,,Ах... мен ойладым...
Dialogue: 0,0:15:50.44,0:15:53.91,Default,,0,0,0,,Қараңыз, жүгіргеннен кейін үшінші орында.
Dialogue: 0,0:15:54.03,0:15:56.78,Default,,0,0,0,,Үлкен қауіпсіздік әрқашан өзгереді.
Dialogue: 0,0:15:56.91,0:15:59.54,Default,,0,0,0,,Не? Терминнің мағынасы түсінікті...
Dialogue: 0,0:15:59.66,0:16:03.67,Default,,0,0,0,,Дұрыс. Басқаша айтқанда, терең адамдар қазір
Dialogue: 0,0:16:03.79,0:16:06.92,Default,,0,0,0,,Ұзын пастар анық, сондықтан сақ болмаңыз.
Dialogue: 0,0:16:07.04,0:16:08.80,Default,,0,0,0,,Мен бәріне айтуым керек...
Dialogue: 0,0:16:08.92,0:16:12.01,Default,,0,0,0,,Бірақ бұл жерде күту уақытын енді пайдалану мүмкін емес...
Dialogue: 0,0:16:12.42,0:16:13.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:13.51,0:16:14.72,Default,,0,0,0,,Мамори-неечан
Dialogue: 0,0:16:14.84,0:16:17.39,Default,,0,0,0,,Жүгіруден кейін үшінші төмен
Dialogue: 0,0:16:17.51,0:16:18.72,Default,,0,0,0,,Қауіпсіздік...
Dialogue: 0,0:16:18.85,0:16:20.72,Default,,0,0,0,,Жоқ, жоқ, жоқ... Мен барамын...
Dialogue: 0,0:16:20.85,0:16:24.48,Default,,0,0,0,,Күрделі стратегияларды мұндай қимылдармен жеткізе алмайсыз...
Dialogue: 0,0:16:24.60,0:16:24.98,Default,,0,0,0,,Не? (Курита) Менің ойымша, бұл көңілді би.
Dialogue: 0,0:16:24.98,0:16:27.27,Default,,0,0,0,,Не? (Курита) Менің ойымша, бұл көңілді би.
Dialogue: 0,0:16:24.98,0:16:27.27,Default,,0,0,0,,Ахаха
Dialogue: 0,0:16:27.40,0:16:29.86,Default,,0,0,0,,Фуго (Монта) Сәттілік Макс
Dialogue: 0,0:16:27.40,0:16:29.86,Default,,0,0,0,,Би болса, мен де ұтылмас едім.
Dialogue: 0,0:16:29.98,0:16:31.74,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:16:31.82,0:16:34.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:35.11,0:16:37.70,Default,,0,0,0,,Ешқандай жол жоқ, қарғыс атқыр.
Dialogue: 0,0:16:37.83,0:16:39.49,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:40.87,0:16:41.87,Default,,0,0,0,,Темера!
Dialogue: 0,0:16:42.71,0:16:46.42,Default,,0,0,0,,Бұрышта тұрған команда өзінің ең күшті шабуылын жасайды.
Dialogue: 0,0:16:46.54,0:16:51.34,Default,,0,0,0,,Сондықтан олар міндетті түрде көз қалқанымен оралады.
Dialogue: 0,0:16:51.59,0:16:54.30,Default,,0,0,0,,Келіңіздер, Деймон Ібіліс жарғанаттарының төртінші құлауы
Dialogue: 0,0:16:54.43,0:16:57.76,Default,,0,0,0,,Егер бұл орындалмаса, шабуыл жасау құқығы Посейдонға өтеді.
Dialogue: 0,0:17:03.06,0:17:04.44,Default,,0,0,0,,Қабақ?
Dialogue: 0,0:17:04.56,0:17:07.52,Default,,0,0,0,,Уайымдама, Кәкей сені жібермейді!
Dialogue: 0,0:17:07.65,0:17:10.40,Default,,0,0,0,,Есіңізде қалған бір нәрсені қараңыз, ол бірдей үлгі ме?
Dialogue: 0,0:17:10.52,0:17:12.36,Default,,0,0,0,,Ягами-сан қазір тапаншасын алып жүрген жоқ
Dialogue: 0,0:17:12.78,0:17:14.36,Default,,0,0,0,,Мен оны міндетті түрде тоқтатамын
Dialogue: 0,0:17:18.37,0:17:19.62,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:17:20.28,0:17:21.12,Default,,0,0,0,,Не!
Dialogue: 0,0:17:21.41,0:17:25.58,Default,,0,0,0,,Бір ақымақтан басқа бір ойын.
Dialogue: 0,0:17:27.50,0:17:29.00,Default,,0,0,0,,Ақымақтарды айтсақ...
Dialogue: 0,0:17:29.59,0:17:32.30,Default,,0,0,0,,Қалай есіңізде қалғаны қызық...
Dialogue: 0,0:17:33.26,0:17:35.51,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:17:38.68,0:17:39.72,Default,,0,0,0,,Бос!
Dialogue: 0,0:17:39.85,0:17:40.68,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:17:40.80,0:17:43.14,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:17:44.14,0:17:46.69,Default,,0,0,0,,Мен сіздерді күтуге мәжбүр еттім, жанкүйерлер.
Dialogue: 0,0:17:46.81,0:17:49.15,Default,,0,0,0,,Ұзақ өту шешілді!
Dialogue: 0,0:17:49.27,0:17:54.90,Default,,0,0,0,,Бірден 7 ярд қалды, Ібіліс жарғанақтары, жақындап қалды!
Dialogue: 0,0:17:55.40,0:17:58.95,Default,,0,0,0,,Жоқ, тіпті мұндай асу бар ма?
Dialogue: 0,0:17:59.07,0:18:01.58,Default,,0,0,0,,Мен де жолды тілек сүйегімен біріктіруім керек пе...
Dialogue: 0,0:18:02.08,0:18:04.91,Default,,0,0,0,,Хехехе... шіркін көздер
Dialogue: 0,0:18:05.04,0:18:08.29,Default,,0,0,0,,Eyeshield жүгірісін тоқтатып қана қоймай, өзіңізді қауіпсіз сезініңіз.
Dialogue: 0,0:18:08.75,0:18:11.75,Default,,0,0,0,,Қазір балшық қақпасында мотивациясыз миннус жоқ.
Dialogue: 0,0:18:12.17,0:18:14.80,Default,,0,0,0,,Бір немесе екі данышпан басқаратын ұжым дегеніміз не?
Dialogue: 0,0:18:14.92,0:18:16.47,Default,,0,0,0,,Аудармасы басқаша.
Dialogue: 0,0:18:16.59,0:18:17.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:18.55,0:18:19.97,Default,,0,0,0,,Сүлік жын...
Dialogue: 0,0:18:25.39,0:18:28.10,Default,,0,0,0,,Енді қайсысына баруым керек...
Dialogue: 0,0:18:28.31,0:18:29.52,Default,,0,0,0,,Бір мүйізбен осындай күш.
Dialogue: 0,0:18:30.06,0:18:32.06,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:18:37.95,0:18:39.82,Default,,0,0,0,,Бұл 80 саны. 80 нөмірін тоқтатыңыз!
Dialogue: 0,0:18:39.95,0:18:41.45,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:18:50.96,0:18:52.71,Default,,0,0,0,,О!
Dialogue: 0,0:18:54.88,0:18:55.80,Default,,0,0,0,,(Танжиро) Бірақ құбыжықтар жалғыз жүруі керек еді ғой?
Dialogue: 0,0:18:56.26,0:18:57.76,Default,,0,0,0,,Доп... (Ониши) Менде жоқ.
Dialogue: 0,0:18:58.22,0:19:01.47,Default,,0,0,0,,Қабақ қалқаны Қалғанын саған қалдырамын!
Dialogue: 0,0:19:07.14,0:19:09.85,Default,,0,0,0,,Алға~ Көз қалқаны!
Dialogue: 0,0:19:09.98,0:19:11.81,Default,,0,0,0,,Қабақ қалқаны!
Dialogue: 0,0:19:13.15,0:19:15.52,Default,,0,0,0,,Барлығы осында болғандықтан, мен осындамын!
Dialogue: 0,0:19:15.65,0:19:16.65,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:19:16.78,0:19:18.74,Default,,0,0,0,,Қозғалыс!
Dialogue: 0,0:19:19.36,0:19:24.45,Default,,0,0,0,,18 және 17 Деймон Ібіліс Жарғанақтар Ақырында, кері қайтару!
Dialogue: 0,0:19:24.58,0:19:25.41,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:19:26.37,0:19:28.08,Default,,0,0,0,,Достарыңызға сеніңіз⸺
Dialogue: 0,0:19:28.20,0:19:31.42,Default,,0,0,0,,Достарың саған сенгенде ғана нағыз эйс болады!
Dialogue: 0,0:19:31.54,0:19:33.04,Default,,0,0,0,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:19:33.08,0:19:34.92,Default,,0,0,0,,Ібіліс жарғанақтар Ібіліс жарғанақтар...
Dialogue: 0,0:19:34.92,0:19:36.42,Default,,0,0,0,,Ібіліс жарғанақтар Ібіліс жарғанақтар...
Dialogue: 0,0:19:34.92,0:19:36.42,Default,,0,0,0,,Түсіндім бе, ақымақ?
Dialogue: 0,0:19:36.55,0:19:37.75,Default,,0,0,0,,Ібіліс жарғанақтар Ібіліс жарғанақтар...
Dialogue: 0,0:19:37.75,0:19:39.09,Default,,0,0,0,,Ібіліс жарғанақтар Ібіліс жарғанақтар...
Dialogue: 0,0:19:37.75,0:19:39.09,Default,,0,0,0,,Иә
Dialogue: 0,0:19:39.09,0:19:42.43,Default,,0,0,0,,Ібіліс жарғанақтар Ібіліс жарғанақтар...
Dialogue: 0,0:19:44.01,0:19:49.02,Default,,0,0,0,,♪~
Dialogue: 0,0:20:51.58,0:20:56.58,Default,,0,0,0,,~♪
Dialogue: 0,0:20:59.88,0:21:01.88,Default,,0,0,0,,Ақыры, Деймон бұрылды!
Dialogue: 0,0:21:02.01,0:21:04.76,Default,,0,0,0,,Бірақ Посейдон жігіттері де байсалды.
Dialogue: 0,0:21:04.88,0:21:09.55,Default,,0,0,0,,Иә! Ойын осы жерден басталады. Мизумачи деген адам кім?
Dialogue: 0,0:21:09.68,0:21:12.60,Default,,0,0,0,,Сенна Соңына дейін сақтығыңды түсірме.
Dialogue: 0,0:21:12.72,0:21:16.73,Default,,0,0,0,,Келесі жолы «Көз қалқаны 21» «Жеңіске деген құрмет!»
Dialogue: 0,0:21:16.85,0:21:18.69,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:21:20.19,0:21:26.19,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
