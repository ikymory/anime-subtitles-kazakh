Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.08,0:00:07.21,Default,,0,0,0,,Кішкентай жігітті жаншып таста!
Dialogue: 0,0:00:07.34,0:00:08.67,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:00:30.11,0:00:30.73,Default,,0,0,0,,Қишар!
Dialogue: 0,0:00:35.86,0:00:38.28,Default,,0,0,0,,Қишар!
Dialogue: 0,0:00:41.91,0:00:43.25,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:00:43.37,0:00:45.62,Default,,0,0,0,,Қозғалыс!
Dialogue: 0,0:00:45.75,0:00:48.21,Default,,0,0,0,,Үздіксіз Ібіліс жарғанағы елес үзіліс!
Dialogue: 0,0:00:48.33,0:00:51.46,Default,,0,0,0,,Енді ешкім қуып жете алмайды!
Dialogue: 0,0:00:52.17,0:00:54.22,Default,,0,0,0,,Күрсін, мен істеймін.
Dialogue: 0,0:00:54.34,0:00:57.68,Default,,0,0,0,,Ей, Кәкей, анау жасанды көз қалқан.
Dialogue: 0,0:00:57.80,0:00:59.30,Default,,0,0,0,,Бірақ... (Мидзумачи) А?
Dialogue: 0,0:01:00.22,0:01:02.18,Default,,0,0,0,,Бұл жалған.
Dialogue: 0,0:01:02.72,0:01:06.19,Default,,0,0,0,,Нихихихи... Я-Ха-!
Dialogue: 0,0:01:06.56,0:01:09.69,Default,,0,0,0,,Ойын аяқталды Деймон жеңіліспен жеңеді!
Dialogue: 0,0:01:09.98,0:01:12.44,Default,,0,0,0,,Үздік 8-ге өту!
Dialogue: 0,0:01:12.78,0:01:14.15,Default,,0,0,0,,Фуго!
Dialogue: 0,0:01:15.95,0:01:17.11,Default,,0,0,0,,Хмм.
Dialogue: 0,0:01:17.61,0:01:20.08,Default,,0,0,0,,Мен Деймонның матчын бірінші рет тікелей эфирде көрдім⸺
Dialogue: 0,0:01:20.87,0:01:23.54,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:01:24.00,0:01:26.66,Default,,0,0,0,,Ей, Кәкей, мен бірінші турды көргім келеді⸺
Dialogue: 0,0:01:26.79,0:01:29.54,Default,,0,0,0,,Біз орындықта жарты жолда отыра алмаймыз ба?
Dialogue: 0,0:01:29.67,0:01:33.05,Default,,0,0,0,,Мазалама, енді оны жасырудың қажеті жоқ.
Dialogue: 0,0:01:33.17,0:01:34.76,Default,,0,0,0,,Толық қатысумен шыдаңыз
Dialogue: 0,0:01:34.88,0:01:36.38,Default,,0,0,0,,Мен...
Dialogue: 0,0:01:37.34,0:01:40.30,Default,,0,0,0,,Бірақ, түсінікті болу үшін...
Dialogue: 0,0:01:40.43,0:01:41.43,Default,,0,0,0,,Фугофуго!
Dialogue: 0,0:01:41.55,0:01:43.97,Default,,0,0,0,,Демек, ол менің жауым емес.
Dialogue: 0,0:01:44.10,0:01:49.10,Default,,0,0,0,,♪~
Dialogue: 0,0:03:01.34,0:03:06.35,Default,,0,0,0,,~♪
Dialogue: 0,0:03:13.23,0:03:14.90,Default,,0,0,0,,Біз үздік 8-дікпіз.
Dialogue: 0,0:03:15.40,0:03:20.61,Default,,0,0,0,,Келесі үшінші раунд, Посейдонға қарсы шайқас. Қобалжымаңыз.
Dialogue: 0,0:03:20.74,0:03:24.07,Default,,0,0,0,,Жарайды! Осылай жүре берейік
Dialogue: 0,0:03:24.20,0:03:25.78,Default,,0,0,0,,Фуго
Dialogue: 0,0:03:25.91,0:03:26.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:26.66,0:03:28.75,Default,,0,0,0,,О~ Деймон, солай ма?
Dialogue: 0,0:03:28.87,0:03:30.37,Default,,0,0,0,,Уау... шықты!
Dialogue: 0,0:03:30.50,0:03:33.00,Default,,0,0,0,,Көрсең де, елес емессің.
Dialogue: 0,0:03:33.50,0:03:36.63,Default,,0,0,0,,Бірақ біздің матчты көріп отырғаныңыз⸺
Dialogue: 0,0:03:36.75,0:03:39.96,Default,,0,0,0,,Мүмкін сен бізге барлау үшін келген шығарсың?
Dialogue: 0,0:03:40.26,0:03:41.76,Default,,0,0,0,,А? шпион?
Dialogue: 0,0:03:41.88,0:03:44.22,Default,,0,0,0,,Поо… Ахаха…
Dialogue: 0,0:03:44.93,0:03:46.18,Default,,0,0,0,,(Дүкенші) Мен бейтаныс адамның қиындықтарына араласқым келмейді.
Dialogue: 0,0:03:46.43,0:03:49.06,Default,,0,0,0,,Балалар біздің бірінші раундта ойнағанымызды көргілерің келеді⸺
Dialogue: 0,0:03:49.18,0:03:51.39,Default,,0,0,0,,Мен орындықта отырсам да, мен саған жау емеспін.
Dialogue: 0,0:03:51.52,0:03:52.89,Default,,0,0,0,,Не~!
Dialogue: 0,0:03:53.52,0:03:57.48,Default,,0,0,0,,Кешіріңіз, бірақ мен сізге жеңуге рұқсат етемін. Ол жақта кішкентай жігіттер көп.
Dialogue: 0,0:03:57.61,0:04:00.86,Default,,0,0,0,,Менің ойымша, биіктік айырмашылығына байланысты бізде басымдық бар.
Dialogue: 0,0:04:00.99,0:04:02.32,Default,,0,0,0,,Ах! (Монта) Әй!
Dialogue: 0,0:04:02.45,0:04:03.95,Default,,0,0,0,,Фуго!
Dialogue: 0,0:04:05.70,0:04:08.49,Default,,0,0,0,,О, иә, мен сізге бір нәрсе айтайын.
Dialogue: 0,0:04:08.62,0:04:11.25,Default,,0,0,0,,Бұл қатарда бір кішкентай адам бар.
Dialogue: 0,0:04:11.37,0:04:13.79,Default,,0,0,0,,Бұл не... бұл күріш шары немесе басқасы деп аталады?
Dialogue: 0,0:04:13.92,0:04:17.96,Default,,0,0,0,,Омусуби Фуго Комусуби жоқ!
Dialogue: 0,0:04:18.09,0:04:20.92,Default,,0,0,0,,О, мен болдым. Мен оны мүлдем көре алмадым.
Dialogue: 0,0:04:21.21,0:04:22.26,Default,,0,0,0,,Фуго…
Dialogue: 0,0:04:22.38,0:04:25.01,Default,,0,0,0,,Өйткені, әлгі кішкентай жігіт қауіпті.
Dialogue: 0,0:04:25.13,0:04:27.22,Default,,0,0,0,,Мүшеліктен өзіңізді алып тастаған дұрыс.
Dialogue: 0,0:04:27.35,0:04:28.26,Default,,0,0,0,,Фуго!
Dialogue: 0,0:04:28.39,0:04:29.60,Default,,0,0,0,,Сіз осылай айтасыз...
Dialogue: 0,0:04:29.72,0:04:31.47,Default,,0,0,0,,Оның сізге қатысы жоқ!
Dialogue: 0,0:04:31.60,0:04:35.69,Default,,0,0,0,,Егер сіз оны алып тастамасаңыз, кешіріңіз, бірақ мен сәйкестендіремін.
Dialogue: 0,0:04:35.81,0:04:39.15,Default,,0,0,0,,Бойдың айырмашылығына байланысты мен сені жаншып алуымды сұрағандай.
Dialogue: 0,0:04:39.27,0:04:43.19,Default,,0,0,0,,Позиция: Сенің дәл менің алдымда болуың мүмкін емес.
Dialogue: 0,0:04:43.61,0:04:45.74,Default,,0,0,0,,Фуго…
Dialogue: 0,0:04:47.49,0:04:49.12,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:04:52.75,0:04:53.50,Default,,0,0,0,,Бұл!
Dialogue: 0,0:04:54.16,0:04:55.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:55.37,0:04:57.63,Default,,0,0,0,,Көз қалқаны да осылай деді.
Dialogue: 0,0:04:57.75,0:05:01.21,Default,,0,0,0,,Комусуби-кун екеуміз Посейдонды жеңгенімізді дәлелдейміз.
Dialogue: 0,0:05:02.26,0:05:04.47,Default,,0,0,0,,Кішкентай адам да ең күшті бола алады!
Dialogue: 0,0:05:04.59,0:05:07.68,Default,,0,0,0,,Хмм, қызық.
Dialogue: 0,0:05:08.43,0:05:10.18,Default,,0,0,0,,Ешқашан қашпа...
Dialogue: 0,0:05:11.01,0:05:12.56,Default,,0,0,0,,Мен оларды дәл қазір толықтай сіңіріп алдым.
Dialogue: 0,0:05:16.39,0:05:19.36,Default,,0,0,0,,(Монтаның есінеу)
Dialogue: 0,0:05:19.65,0:05:21.11,Default,,0,0,0,,Сіз өте ұйықтап жатқан сияқтысыз.
Dialogue: 0,0:05:21.48,0:05:23.28,Default,,0,0,0,,Ой... кеше түн⸺
Dialogue: 0,0:05:23.40,0:05:26.82,Default,,0,0,0,,Мизумачидің айтқанын ойлап ұйықтай алмадым.
Dialogue: 0,0:05:26.95,0:05:28.32,Default,,0,0,0,,Иә...
Dialogue: 0,0:05:28.74,0:05:31.95,Default,,0,0,0,,Осылай анық айтсаң, көңілім қалады.
Dialogue: 0,0:05:32.08,0:05:33.08,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:33.20,0:05:34.70,Default,,0,0,0,,Бірақ... иә?
Dialogue: 0,0:05:34.83,0:05:36.87,Default,,0,0,0,,Соңында бұрынғыдай.
Dialogue: 0,0:05:37.00,0:05:40.25,Default,,0,0,0,,Бойың тез өсетіндей емес.
Dialogue: 0,0:05:40.38,0:05:42.46,Default,,0,0,0,,Өлу үшін бар күшімізді салудың қажеті жоқ.
Dialogue: 0,0:05:43.00,0:05:44.46,Default,,0,0,0,,Монта!
Dialogue: 0,0:05:45.26,0:05:46.92,Default,,0,0,0,,Сенна кеше жақсы болды
Dialogue: 0,0:05:47.47,0:05:49.43,Default,,0,0,0,,«Мен Посейдонды жеңгенімді дәлелдеймін».
Dialogue: 0,0:05:49.55,0:05:52.64,Default,,0,0,0,,«Кішкентай адам да ең күшті бола алады!»
Dialogue: 0,0:05:53.31,0:05:56.48,Default,,0,0,0,,Посейдонға қарсы күресте оларды таң қалдырайық.
Dialogue: 0,0:05:56.60,0:05:57.48,Default,,0,0,0,,Иә
Dialogue: 0,0:05:57.60,0:05:59.35,Default,,0,0,0,,Не болды? Комусуби-кун
Dialogue: 0,0:05:59.48,0:06:00.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:00.44,0:06:03.23,Default,,0,0,0,,Комусуби, сенің де ішің ауырып тұр ма?
Dialogue: 0,0:06:03.36,0:06:04.07,Default,,0,0,0,,Фуго…
Dialogue: 0,0:06:04.19,0:06:07.24,Default,,0,0,0,,Әй, мұны істегің келмесе, бір жерге бар!
Dialogue: 0,0:06:07.36,0:06:08.78,Default,,0,0,0,,Джу… Джумонджи-кун
Dialogue: 0,0:06:09.20,0:06:10.74,Default,,0,0,0,,Сәлем! (Комусуби) Фуго…
Dialogue: 0,0:06:11.07,0:06:13.12,Default,,0,0,0,,Посейдонмен шайқасқа аз уақыт қалды⸺
Dialogue: 0,0:06:13.24,0:06:14.62,Default,,0,0,0,,Сіз бейберекетсіз!
Dialogue: 0,0:06:14.74,0:06:16.45,Default,,0,0,0,,Ра... Зорлық жасау жақсы емес.
Dialogue: 0,0:06:17.00,0:06:18.21,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:06:18.33,0:06:19.67,Default,,0,0,0,,Сабырлан, Джумонжи
Dialogue: 0,0:06:19.79,0:06:23.63,Default,,0,0,0,,Жоқ, жаттығуды ұнатпайтын адамдар жай ғана алаңдаушылық тудырады.
Dialogue: 0,0:06:23.75,0:06:26.05,Default,,0,0,0,,Фу… Фуго
Dialogue: 0,0:06:26.71,0:06:28.80,Default,,0,0,0,,Әй, Комусуби-кун! (кіші түйін) Фуго
Dialogue: 0,0:06:29.09,0:06:30.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:30.72,0:06:31.93,Default,,0,0,0,,Жергілікті тұрғындарды эвакуациялауға шақырдық.
Dialogue: 0,0:06:32.05,0:06:34.22,Default,,0,0,0,,Сіз мұны істегіңіз келмейтініне сенімдісіз бе?
Dialogue: 0,0:06:34.68,0:06:36.06,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:36.18,0:06:41.23,Default,,0,0,0,,Не болды? Сена-кун, Монта-кун, сен бірдеңе білесің бе?
Dialogue: 0,0:06:41.69,0:06:43.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:43.48,0:06:44.48,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:06:44.61,0:06:45.86,Default,,0,0,0,,Негізі кеше...
Dialogue: 0,0:06:46.44,0:06:49.20,Default,,0,0,0,,Өйткені, әлгі кішкентай жігіт қауіпті.
Dialogue: 0,0:06:49.32,0:06:51.24,Default,,0,0,0,,Мүшеліктен өзіңізді алып тастаған дұрыс.
Dialogue: 0,0:06:52.37,0:06:53.95,Default,,0,0,0,,Сондықтан
Dialogue: 0,0:06:54.08,0:06:55.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:55.16,0:06:57.04,Default,,0,0,0,,Ке, мен оны сағындым.
Dialogue: 0,0:06:57.16,0:06:58.04,Default,,0,0,0,,Эх!
Dialogue: 0,0:06:58.16,0:07:00.62,Default,,0,0,0,,Егер сіз шынымен кішкентай жігіт үшін қатты уайымдасаңыз.
Dialogue: 0,0:07:00.75,0:07:03.67,Default,,0,0,0,,Мүмкін мен американдық футбол ойнамауым керек шығар.
Dialogue: 0,0:07:03.79,0:07:05.34,Default,,0,0,0,,Сол ақымақ жігітпен⸺
Dialogue: 0,0:07:05.46,0:07:06.92,Default,,0,0,0,,Осы уақытқа дейін келдің бе?
Dialogue: 0,0:07:07.05,0:07:08.51,Default,,0,0,0,,Бұл көңіл көншітеді...
Dialogue: 0,0:07:08.63,0:07:10.88,Default,,0,0,0,,Муки Бір минут күтіңіз!
Dialogue: 0,0:07:11.01,0:07:13.22,Default,,0,0,0,,Қанша айтсаң да, олай айта алмайсың!
Dialogue: 0,0:07:13.64,0:07:15.47,Default,,0,0,0,,Ха? (Джумонджи) Иә?
Dialogue: 0,0:07:15.60,0:07:16.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:20.81,0:07:22.02,Default,,0,0,0,,Баршаңызға~!
Dialogue: 0,0:07:22.52,0:07:24.48,Default,,0,0,0,,Ұрысты доғарыңыз!
Dialogue: 0,0:07:24.61,0:07:26.57,Default,,0,0,0,,Ауыр~
Dialogue: 0,0:07:27.23,0:07:28.78,Default,,0,0,0,,(Сеннаның күрсінуі)
Dialogue: 0,0:07:31.36,0:07:32.82,Default,,0,0,0,,Комусуби-кун…
Dialogue: 0,0:07:44.71,0:07:45.42,Default,,0,0,0,,Фуго…
Dialogue: 0,0:07:58.51,0:07:59.77,Default,,0,0,0,,Фуго…
Dialogue: 0,0:08:03.98,0:08:05.40,Default,,0,0,0,,Кешегі шағын түйін болды ғой.
Dialogue: 0,0:08:05.40,0:08:06.40,Default,,0,0,0,,Кешегі шағын түйін болды ғой.
Dialogue: 0,0:08:05.40,0:08:06.40,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:08:06.40,0:08:06.52,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:08:06.52,0:08:08.69,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:08:06.52,0:08:08.69,Default,,0,0,0,,Сіз жаттығуға қайтып келген жоқсыз.
Dialogue: 0,0:08:08.69,0:08:08.82,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:08:08.82,0:08:10.11,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:08:08.82,0:08:10.11,Default,,0,0,0,,Иә...
Dialogue: 0,0:08:10.23,0:08:11.78,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:08:12.57,0:08:14.28,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:14.53,0:08:17.37,Default,,0,0,0,,Комусуби-кун... Комусуби-кун...
Dialogue: 0,0:08:17.49,0:08:19.99,Default,,0,0,0,,Мен үйден қашып кеттім!
Dialogue: 0,0:08:20.12,0:08:21.45,Default,,0,0,0,,Қашқын ба?
Dialogue: 0,0:08:22.00,0:08:25.67,Default,,0,0,0,,Иә, бүгін таңертең маған мынадай хат келді...
Dialogue: 0,0:08:26.38,0:08:27.46,Default,,0,0,0,,«Кенеттен»?
Dialogue: 0,0:08:27.59,0:08:28.34,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:29.55,0:08:31.71,Default,,0,0,0,,«Құрметті мырза, көмегіңіз үшін рахмет».
Dialogue: 0,0:08:31.84,0:08:34.05,Default,,0,0,0,,«Кенеттен кеткеніме кешірім өтінемін».
Dialogue: 0,0:08:34.18,0:08:35.38,Default,,0,0,0,,Өйткені ол жазылмаған!
Dialogue: 0,0:08:35.89,0:08:37.89,Default,,0,0,0,,Әріптер де күшті сөздер.
Dialogue: 0,0:08:38.39,0:08:40.14,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:08:40.60,0:08:45.02,Default,,0,0,0,,Күшті сөздерді Комусуби қолданады және оны тек күшті адамдар түсінеді⸺
Dialogue: 0,0:08:45.14,0:08:46.73,Default,,0,0,0,,Бұл жанның тілі.
Dialogue: 0,0:08:46.85,0:08:47.86,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:08:48.69,0:08:50.86,Default,,0,0,0,,«Мен командада болмағанды ​​қалаймын.»
Dialogue: 0,0:08:50.98,0:08:51.82,Default,,0,0,0,,Эх!
Dialogue: 0,0:08:52.86,0:08:56.57,Default,,0,0,0,,«Мен бұл пайдасыз адамға бұдан былай қиындық туғыза алмаймын».
Dialogue: 0,0:08:56.70,0:08:58.99,Default,,0,0,0,,Комусуби-кун!
Dialogue: 0,0:08:59.12,0:08:59.99,Default,,0,0,0,,Мизумачи жігіті⸺
Dialogue: 0,0:09:00.12,0:09:01.54,Default,,0,0,0,,Сіз осындай қажетсіз сөздер айтқаныңыз үшін...
Dialogue: 0,0:09:01.91,0:09:04.04,Default,,0,0,0,,Аа, болмайды, бұл шағын қорытынды
Dialogue: 0,0:09:04.16,0:09:06.21,Default,,0,0,0,,Мен американдық футболды доғарамын!
Dialogue: 0,0:09:06.33,0:09:07.33,Default,,0,0,0,,Уф… Ах…
Dialogue: 0,0:09:07.46,0:09:09.34,Default,,0,0,0,,Әйтеуір, клуб бөлмесіне барайық.
Dialogue: 0,0:09:09.46,0:09:10.96,Default,,0,0,0,,Ух... Иә (Монта) О!
Dialogue: 0,0:09:12.05,0:09:12.67,Default,,0,0,0,,(Ұялы телефонның өшірілген дыбысы)
Dialogue: 0,0:09:13.63,0:09:16.30,Default,,0,0,0,,Сабақта достарына бармаған сияқты...
Dialogue: 0,0:09:16.76,0:09:18.30,Default,,0,0,0,,Сен қайда жүрсің?
Dialogue: 0,0:09:18.43,0:09:19.68,Default,,0,0,0,,Бутаман кіші
Dialogue: 0,0:09:19.80,0:09:20.43,Default,,0,0,0,,(Ұялы телефонның өшіп тұрған дыбысы)
Dialogue: 0,0:09:20.55,0:09:22.64,Default,,0,0,0,,Мен ұялы телефоныма да қосыла алмаймын.
Dialogue: 0,0:09:22.77,0:09:25.39,Default,,0,0,0,,Өйткені, бұл кішкентай жігіт қауіпті.
Dialogue: 0,0:09:25.52,0:09:27.94,Default,,0,0,0,,Мүшеліктен өзіңізді шығарғаныңыз дұрыс.
Dialogue: 0,0:09:31.61,0:09:33.44,Default,,0,0,0,,Мен төңіректі іздеймін.
Dialogue: 0,0:09:33.57,0:09:34.69,Default,,0,0,0,,Ой, мен де!
Dialogue: 0,0:09:34.82,0:09:35.65,Default,,0,0,0,,Мен де!
Dialogue: 0,0:09:36.32,0:09:38.07,Default,,0,0,0,,Әрине мен де~
Dialogue: 0,0:09:38.82,0:09:40.03,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:09:40.16,0:09:43.04,Default,,0,0,0,,Ха, мына қызыл мұрын ақымақ емес.
Dialogue: 0,0:09:43.16,0:09:46.41,Default,,0,0,0,,Бұл күш, тіпті Посейдонмен шайқасқа дейін.
Dialogue: 0,0:09:46.54,0:09:47.79,Default,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,0:09:48.37,0:09:50.50,Default,,0,0,0,,Сіз уайымдамайсыз ба?
Dialogue: 0,0:09:50.63,0:09:53.17,Default,,0,0,0,,Цк, біз үйге барамыз.
Dialogue: 0,0:09:53.30,0:09:53.96,Default,,0,0,0,,О
Dialogue: 0,0:09:54.09,0:09:55.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:01.35,0:10:03.81,Default,,0,0,0,,Сол суық адамдарды жайына қалдыр.
Dialogue: 0,0:10:03.93,0:10:06.31,Default,,0,0,0,,Бөлініп, ізденейік.
Dialogue: 0,0:10:06.43,0:10:07.48,Default,,0,0,0,,Иә
Dialogue: 0,0:10:07.60,0:10:08.94,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:10:09.98,0:10:12.69,Default,,0,0,0,,Біз бәріміз көп жұмыс жасасақ та...
Dialogue: 0,0:10:12.82,0:10:14.69,Default,,0,0,0,,Бұл бұзылады
Dialogue: 0,0:10:14.82,0:10:17.90,Default,,0,0,0,,Комусуби-кун, сен қазір қайдасың...
Dialogue: 0,0:10:28.16,0:10:29.54,Default,,0,0,0,,Бұл ағаш
Dialogue: 0,0:10:29.67,0:10:32.96,Default,,0,0,0,,Әкемнің арғы атасы туылғанда еккен.
Dialogue: 0,0:10:34.25,0:10:37.80,Default,,0,0,0,,Комусуби отбасының барлық ер адамдары арқаларын осы ағашқа ойып тұр⸺
Dialogue: 0,0:10:37.92,0:10:39.76,Default,,0,0,0,,Ол үлкейді.
Dialogue: 0,0:10:40.18,0:10:41.97,Default,,0,0,0,,Қараңызшы, ол тез өсіп жатыр.
Dialogue: 0,0:10:42.09,0:10:42.72,Default,,0,0,0,,Фуго!
Dialogue: 0,0:10:43.10,0:10:47.18,Default,,0,0,0,,Өйткені, ол менің ұлым ғой. Ол үлкен, күшті адамға айналады.
Dialogue: 0,0:10:47.31,0:10:49.31,Default,,0,0,0,,Бірақ егер сол адам—
Dialogue: 0,0:10:49.44,0:10:50.39,Default,,0,0,0,,Фуго!
Dialogue: 0,0:10:53.86,0:10:55.69,Default,,0,0,0,,Эй, күте тұрыңыз.
Dialogue: 0,0:10:55.82,0:10:57.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:57.78,0:10:59.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:05.79,0:11:07.20,Default,,0,0,0,,Фуго!
Dialogue: 0,0:11:07.50,0:11:08.79,Default,,0,0,0,,Фуго!
Dialogue: 0,0:11:14.96,0:11:17.34,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:22.68,0:11:25.22,Default,,0,0,0,,Дәл сол Фуго...
Dialogue: 0,0:11:30.89,0:11:34.90,Default,,0,0,0,,Позиция: Сенің дәл менің алдымда болуың мүмкін емес.
Dialogue: 0,0:11:35.02,0:11:36.36,Default,,0,0,0,,Фуго
Dialogue: 0,0:11:37.94,0:11:40.28,Default,,0,0,0,,Бұл кішкентай жігіт қауіпті.
Dialogue: 0,0:11:41.49,0:11:42.78,Default,,0,0,0,,Фуго…
Dialogue: 0,0:11:45.87,0:11:47.66,Default,,0,0,0,,Бұл кішкентай, бірақ...
Dialogue: 0,0:11:47.79,0:11:49.29,Default,,0,0,0,,Менде бір нәрсе бар
Dialogue: 0,0:11:49.41,0:11:51.25,Default,,0,0,0,,Мен ең жылдам адаммын
Dialogue: 0,0:11:51.37,0:11:55.21,Default,,0,0,0,,Комусубиге не бар? Ахаха
Dialogue: 0,0:11:55.33,0:11:57.38,Default,,0,0,0,,Мен оны пайдалана алмаймын.
Dialogue: 0,0:11:57.50,0:11:58.59,Default,,0,0,0,,Эй
Dialogue: 0,0:11:59.96,0:12:01.42,Default,,0,0,0,,Фуго…
Dialogue: 0,0:12:07.68,0:12:08.39,Default,,0,0,0,,Ум...
Dialogue: 0,0:12:08.51,0:12:11.48,Default,,0,0,0,,Ол күріш шарына ұқсайтын бала...
Dialogue: 0,0:12:14.94,0:12:15.94,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:12:18.65,0:12:21.19,Default,,0,0,0,,Сіз бұл адамды көрдіңіз бе?
Dialogue: 0,0:12:21.53,0:12:22.74,Default,,0,0,0,,Оны тапқан адамға⸺
Dialogue: 0,0:12:22.86,0:12:25.61,Default,,0,0,0,,Мен саған қолтаңбам қойылған түрлі-түсті қағаз беремін!
Dialogue: 0,0:12:25.74,0:12:27.07,Default,,0,0,0,,Сіз оны көре алмайсыз.
Dialogue: 0,0:12:27.62,0:12:32.71,Default,,0,0,0,,Біз жаңа ғана жасаған өлшемдер бойынша тиімді радиус шамамен 300 метр...
Dialogue: 0,0:12:35.12,0:12:37.00,Default,,0,0,0,,Жарайды, Курита-кун, келесі жолы осында.
Dialogue: 0,0:12:37.13,0:12:37.75,Default,,0,0,0,,Иә
Dialogue: 0,0:12:38.92,0:12:42.26,Default,,0,0,0,,(Куританың тыныс алу дыбысы)
Dialogue: 0,0:12:42.38,0:12:45.26,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:12:45.38,0:12:48.43,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:12:48.55,0:12:51.43,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:12:51.56,0:12:53.60,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:12:53.73,0:12:54.89,Default,,0,0,0,,Ол мұнда жоқ сияқты.
Dialogue: 0,0:12:55.02,0:12:57.94,Default,,0,0,0,,Ах... с... кешіріңіз.
Dialogue: 0,0:12:59.48,0:13:00.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:04.28,0:13:05.28,Default,,0,0,0,,(Ишимарудың айқайы)
Dialogue: 0,0:13:05.49,0:13:08.99,Default,,0,0,0,,Иһ хи хи... Әй, еңбегіңе рахмет, Ишимару-сенпай
Dialogue: 0,0:13:09.37,0:13:11.66,Default,,0,0,0,,Мо... Монта-кун... не?
Dialogue: 0,0:13:12.04,0:13:16.54,Default,,0,0,0,,Жоғары жерден іздеу және іздеу тиімдірек.
Dialogue: 0,0:13:16.67,0:13:20.63,Default,,0,0,0,,Олар бұл жерде жоқ сияқты. Жарайды, Укие.
Dialogue: 0,0:13:21.59,0:13:23.59,Default,,0,0,0,,Жарайды... жабайы болып барады...
Dialogue: 0,0:13:25.05,0:13:25.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:26.51,0:13:29.97,Default,,0,0,0,,Өзіңізді өлтіру үшін аяқтарыңызды пайдаланыңыз, жай ғана қозғалыңыз.
Dialogue: 0,0:13:30.10,0:13:31.56,Default,,0,0,0,,Комусуби-кун...
Dialogue: 0,0:13:31.68,0:13:34.93,Default,,0,0,0,,Бойың аласа болса да, қолыңнан келетін істер көп.
Dialogue: 0,0:13:40.82,0:13:42.23,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:13:43.15,0:13:43.94,Default,,0,0,0,,Фуго…
Dialogue: 0,0:13:50.45,0:13:53.58,Default,,0,0,0,,Жеңдер, бұл менің балам, ол үлкен болады!
Dialogue: 0,0:13:53.70,0:13:54.33,Default,,0,0,0,,Фуго!
Dialogue: 0,0:13:55.00,0:13:57.33,Default,,0,0,0,,(сыныптасының күлкісі)
Dialogue: 0,0:13:57.46,0:13:59.54,Default,,0,0,0,,Фуго
Dialogue: 0,0:14:04.76,0:14:06.34,Default,,0,0,0,,Фуго…
Dialogue: 0,0:14:08.05,0:14:09.80,Default,,0,0,0,,Мен әртүрлі нәрселерді қолданып көремін.
Dialogue: 0,0:14:09.93,0:14:12.26,Default,,0,0,0,,Қанша күн өтсе де мен сені іздеймін.
Dialogue: 0,0:14:12.39,0:14:14.89,Default,,0,0,0,,Енді барлығымыз үйге қайтайық, жаттығу жасайық.
Dialogue: 0,0:14:15.02,0:14:15.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:19.90,0:14:24.65,Default,,0,0,0,,Добуроку Сенсей? А-а... мен саған кейінірек тағы хабарласамын.
Dialogue: 0,0:14:26.32,0:14:27.86,Default,,0,0,0,,Комусубидің анасы!
Dialogue: 0,0:14:28.20,0:14:31.49,Default,,0,0,0,,О, сәлем Кобаякава-кун.
Dialogue: 0,0:14:31.62,0:14:34.87,Default,,0,0,0,,Білесің бе, сен біздің Дайкичиді көрмедің бе?
Dialogue: 0,0:14:34.99,0:14:38.08,Default,,0,0,0,,А... біз де іздейміз...
Dialogue: 0,0:14:38.21,0:14:42.75,Default,,0,0,0,,Иә... әлгі бала кешеден бері біртүрлі әрекет жасап жүр.
Dialogue: 0,0:14:42.88,0:14:45.71,Default,,0,0,0,,Бүгін таңертең ол менің үйімнен қашып кетті.
Dialogue: 0,0:14:46.17,0:14:48.22,Default,,0,0,0,,Не болды, Дайкичи!
Dialogue: 0,0:14:48.34,0:14:51.05,Default,,0,0,0,,Не болса да қожайынның соңынан еруді шештің.
Dialogue: 0,0:14:53.89,0:14:56.68,Default,,0,0,0,,Ер адам шешім қабылдағаннан кейін, оны соңына дейін ұстаныңыз!
Dialogue: 0,0:14:56.81,0:14:59.69,Default,,0,0,0,,Не болғанын білмеймін, бірақ жақсы!
Dialogue: 0,0:14:59.81,0:15:01.98,Default,,0,0,0,,Тамақты жеп, күш жина.
Dialogue: 0,0:15:15.03,0:15:18.33,Default,,0,0,0,,Иә, кел, ақ күріш жей бер.
Dialogue: 0,0:15:18.45,0:15:20.75,Default,,0,0,0,,Таңғы асты өткізіп алсаң, есеймейсің.
Dialogue: 0,0:15:20.87,0:15:21.96,Default,,0,0,0,,Фуго (Комусубидің анасы) Ах!
Dialogue: 0,0:15:23.04,0:15:24.13,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:15:24.67,0:15:26.05,Default,,0,0,0,,Фуго
Dialogue: 0,0:15:26.17,0:15:27.92,Default,,0,0,0,,Сен кімсің, Дайкичи?
Dialogue: 0,0:15:28.05,0:15:30.42,Default,,0,0,0,,Диқандар тер төккен ана
Dialogue: 0,0:15:30.55,0:15:33.05,Default,,0,0,0,,Күрішке қол көтерме дедім!
Dialogue: 0,0:15:33.18,0:15:35.55,Default,,0,0,0,,Мен... не айтқыңыз келгенін түсіндім.
Dialogue: 0,0:15:35.68,0:15:37.56,Default,,0,0,0,,Бірдеңе араласып кетті.
Dialogue: 0,0:15:38.06,0:15:40.39,Default,,0,0,0,,Бұл Фуго (Комусубидің анасы)... Дайкичи!
Dialogue: 0,0:15:42.06,0:15:43.90,Default,,0,0,0,,Солай болды ма?
Dialogue: 0,0:15:44.02,0:15:46.23,Default,,0,0,0,,Мектепте бірдеңе болды ма?
Dialogue: 0,0:15:47.98,0:15:50.11,Default,,0,0,0,,Біз оны міндетті түрде іздейміз!
Dialogue: 0,0:15:50.24,0:15:52.86,Default,,0,0,0,,Сіз танитын жер бар ма?
Dialogue: 0,0:15:57.24,0:15:58.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:01.66,0:16:03.33,Default,,0,0,0,,Бұл туралы айтатын болсақ!
Dialogue: 0,0:16:12.68,0:16:16.93,Default,,0,0,0,,Фуго... Мен кедергі келтіремін...
Dialogue: 0,0:16:20.56,0:16:22.48,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:16:22.60,0:16:23.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:23.56,0:16:25.40,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:16:25.52,0:16:27.86,Default,,0,0,0,,Иә! Комусуби-кун!
Dialogue: 0,0:16:27.98,0:16:29.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:29.57,0:16:30.94,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:16:31.07,0:16:32.40,Default,,0,0,0,,Фуго!
Dialogue: 0,0:16:34.36,0:16:35.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:37.16,0:16:39.95,Default,,0,0,0,,Бұл қауіпті, Фуго!
Dialogue: 0,0:16:40.08,0:16:42.12,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:16:42.25,0:16:43.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:43.21,0:16:45.37,Default,,0,0,0,,Мен бар күшіммен күрессем де...
Dialogue: 0,0:16:45.50,0:16:49.55,Default,,0,0,0,,Біздің итеруге жаттықтыру тәсілі Bucs-тен мүлде басқаша.
Dialogue: 0,0:16:49.84,0:16:51.63,Default,,0,0,0,,Әрқашан Комусуби-кун⸺
Dialogue: 0,0:16:51.76,0:16:54.68,Default,,0,0,0,,Сіз сондай керемет қалқан болдыңыз, солай емес пе?
Dialogue: 0,0:16:55.05,0:16:56.51,Default,,0,0,0,,Фуго…
Dialogue: 0,0:16:56.64,0:16:59.26,Default,,0,0,0,,Комусуби-кун~ А, жақсы!
Dialogue: 0,0:16:59.56,0:17:00.64,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:17:00.76,0:17:02.43,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:17:02.56,0:17:03.85,Default,,0,0,0,,Себебі мен оны іздедім!
Dialogue: 0,0:17:04.64,0:17:05.81,Default,,0,0,0,,Шағын қорытынды!
Dialogue: 0,0:17:05.94,0:17:07.23,Default,,0,0,0,,Комусуби-кун! (Ишимару) Комусуби!
Dialogue: 0,0:17:12.44,0:17:13.53,Default,,0,0,0,,Комусуби-кун
Dialogue: 0,0:17:13.65,0:17:15.40,Default,,0,0,0,,Комусубиге қайтайық
Dialogue: 0,0:17:15.61,0:17:19.91,Default,,0,0,0,,Комусуби-кун – бірінші рет біздің Ібіліс жарғанақтарымыз.
Dialogue: 0,0:17:21.03,0:17:22.37,Default,,0,0,0,,Фуго!
Dialogue: 0,0:17:22.49,0:17:24.37,Default,,0,0,0,,Комусуби…
Dialogue: 0,0:17:24.96,0:17:26.37,Default,,0,0,0,,Комусуби…
Dialogue: 0,0:17:28.38,0:17:31.46,Default,,0,0,0,,(Мотоцикл тежегішінің дыбысы)
Dialogue: 0,0:17:32.92,0:17:33.84,Default,,0,0,0,,(Балға ату дыбысы)
Dialogue: 0,0:17:40.30,0:17:41.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:42.10,0:17:45.68,Default,,0,0,0,,Бұл үшеуі мектепке велосипедпен бармады.
Dialogue: 0,0:17:46.10,0:17:48.15,Default,,0,0,0,,Мен оны алу үшін қайтып кеттім...
Dialogue: 0,0:17:48.69,0:17:52.73,Default,,0,0,0,,«Мен үйге бара жатырмын» деді де, оны мотоциклімен іздеді.
Dialogue: 0,0:18:04.95,0:18:05.58,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:07.21,0:18:08.50,Default,,0,0,0,,Фуго!
Dialogue: 0,0:18:09.17,0:18:10.04,Default,,0,0,0,,Ах... Джумонджи-кун!
Dialogue: 0,0:18:10.17,0:18:11.50,Default,,0,0,0,,О... тоқта!
Dialogue: 0,0:18:11.88,0:18:14.46,Default,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,0:18:15.05,0:18:17.47,Default,,0,0,0,,Тітіркендіргіш Фуго, тоқтат!
Dialogue: 0,0:18:17.59,0:18:18.59,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:18:20.26,0:18:21.35,Default,,0,0,0,,Әзілдеме!
Dialogue: 0,0:18:21.47,0:18:22.64,Default,,0,0,0,,Семіз кішкентай жігіт!
Dialogue: 0,0:18:22.76,0:18:26.39,Default,,0,0,0,,Тоқта десең де, мені кім тоқтатады?
Dialogue: 0,0:18:26.64,0:18:27.52,Default,,0,0,0,,Фуго
Dialogue: 0,0:18:27.64,0:18:30.98,Default,,0,0,0,,Біз бәріміз Ібіліс жарғанаттарының бір бөлігіміз!
Dialogue: 0,0:18:31.10,0:18:32.94,Default,,0,0,0,,Оны бәрі қорғайды деп ойлаймын!
Dialogue: 0,0:18:33.07,0:18:34.40,Default,,0,0,0,,Темесіз⸺
Dialogue: 0,0:18:34.53,0:18:37.44,Default,,0,0,0,,Посейдонды жеңе аламыз деп ойлайсың ба?
Dialogue: 0,0:18:38.24,0:18:40.82,Default,,0,0,0,,Ол маған айтты
Dialogue: 0,0:18:45.95,0:18:47.50,Default,,0,0,0,,Комусуби-кун!
Dialogue: 0,0:18:47.62,0:18:50.83,Default,,0,0,0,,Жарайды, мені қалдыршы, бәрі жақсы болып жатыр емес пе?
Dialogue: 0,0:18:52.13,0:18:54.84,Default,,0,0,0,,Шу... Тренинг~!
Dialogue: 0,0:18:54.96,0:18:56.55,Default,,0,0,0,,Фуго!
Dialogue: 0,0:18:56.67,0:18:59.01,Default,,0,0,0,,Ах~ (Монта) О, қайтып келдің!
Dialogue: 0,0:19:00.09,0:19:01.51,Default,,0,0,0,,Комусуби-кун
Dialogue: 0,0:19:09.85,0:19:10.48,Default,,0,0,0,,Фугоцу
Dialogue: 0,0:19:11.15,0:19:14.44,Default,,0,0,0,,Мен қуаныштымын~ Комусуби-кунның жағдайы жақсарып келеді...
Dialogue: 0,0:19:15.15,0:19:16.48,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:19:16.61,0:19:18.40,Default,,0,0,0,,«Жаңбыр жауып, жер қатаяды».
Dialogue: 0,0:19:18.53,0:19:20.28,Default,,0,0,0,,Керемет!
Dialogue: 0,0:19:20.40,0:19:21.49,Default,,0,0,0,,Иә
Dialogue: 0,0:19:28.58,0:19:31.42,Default,,0,0,0,,Ауырды... А?
Dialogue: 0,0:19:37.92,0:19:38.88,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:19:39.01,0:19:40.22,Default,,0,0,0,,Ха? (Джумонджи) Иә?
Dialogue: 0,0:19:40.34,0:19:41.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:42.05,0:19:43.01,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:43.14,0:19:45.43,Default,,0,0,0,,(Сеннаның күлкісі)
Dialogue: 0,0:19:45.55,0:19:50.60,Default,,0,0,0,,(Сеннаның күлкісі)
Dialogue: 0,0:19:52.02,0:19:57.02,Default,,0,0,0,,♪~
Dialogue: 0,0:20:59.50,0:21:04.51,Default,,0,0,0,,~♪
Dialogue: 0,0:21:07.72,0:21:10.31,Default,,0,0,0,,Досукоитте қалпақ жиынтығы
Dialogue: 0,0:21:10.93,0:21:12.72,Default,,0,0,0,,Неліктен сумо ойнайсыз?
Dialogue: 0,0:21:12.85,0:21:13.89,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:21:14.02,0:21:16.73,Default,,0,0,0,,Бұл Посейдонға қарсы шайқасқа арналған құпия жаттығу.
Dialogue: 0,0:21:17.02,0:21:18.19,Default,,0,0,0,,Жақсы уақытпен⸺
Dialogue: 0,0:21:18.31,0:21:20.65,Default,,0,0,0,,Сумо турнирі жоқ па?
Dialogue: 0,0:21:20.77,0:21:25.07,Default,,0,0,0,,Келесі жолы «Айсшилд 21» «Ucchare Komusubi!»
Dialogue: 0,0:21:25.20,0:21:26.86,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:21:28.36,0:21:34.36,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
