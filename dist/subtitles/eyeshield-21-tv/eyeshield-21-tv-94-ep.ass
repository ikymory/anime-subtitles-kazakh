Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.25,0:00:03.62,Default,,0,0,0,,(тұмар дауысы)
Dialogue: 0,0:00:04.17,0:00:06.58,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:00:07.00,0:00:08.55,Default,,0,0,0,,Қолымды жазып бергенімдегі жақсылығымды ұмытып қалдың ба…
Dialogue: 0,0:00:08.63,0:00:09.75,Default,,0,0,0,,Жылдамдық!
Dialogue: 0,0:00:09.84,0:00:11.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:13.17,0:00:14.05,Default,,0,0,0,,(Танжиро) Бірақ құбыжықтар жалғыз жүруі керек еді ғой?
Dialogue: 0,0:00:14.13,0:00:15.01,Default,,0,0,0,,Келесі мен!
Dialogue: 0,0:00:15.59,0:00:16.89,Default,,0,0,0,,Ннн!
Dialogue: 0,0:00:16.97,0:00:19.10,Default,,0,0,0,,Күш!
Dialogue: 0,0:00:20.22,0:00:21.43,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:00:21.52,0:00:24.35,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:24.44,0:00:25.85,Default,,0,0,0,,Аяқтау...
Dialogue: 0,0:00:26.69,0:00:28.31,Default,,0,0,0,,Техника!
Dialogue: 0,0:00:28.40,0:00:29.77,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:34.03,0:00:35.66,Default,,0,0,0,,Оны жіберме!
Dialogue: 0,0:00:35.74,0:00:37.03,Default,,0,0,0,,Ннн…
Dialogue: 0,0:00:38.24,0:00:39.08,Default,,0,0,0,,Не! ?
Dialogue: 0,0:00:43.87,0:00:47.00,Default,,0,0,0,,Бұл шықты! Үздіксіз шайтанның елесі!
Dialogue: 0,0:00:48.59,0:00:49.75,Default,,0,0,0,,
Dialogue: 0,0:00:49.84,0:00:51.71,Default,,0,0,0,,Қозғалыс!
Dialogue: 0,0:00:52.13,0:00:54.88,Default,,0,0,0,,Ойын аяқталды!
Dialogue: 0,0:00:57.43,0:01:01.51,Default,,0,0,0,,Енді финалдың уақыты келді! Жеңгені...
Dialogue: 0,0:01:01.60,0:01:03.06,Default,,0,0,0,,Азияның аймақтық өкілі
Dialogue: 0,0:01:03.14,0:01:05.85,Default,,0,0,0,,Ібілістердің патшасы
Dialogue: 0,0:01:05.94,0:01:07.98,Default,,0,0,0,,Деймон Ібіліс жарғанақтар!
Dialogue: 0,0:01:08.61,0:01:11.19,Default,,0,0,0,,Кейіннен Ресей мен Еуропаның өкілі
Dialogue: 0,0:01:11.27,0:01:14.94,Default,,0,0,0,,Күміс мамонт армиясының солтүстік жарық борандары!
Dialogue: 0,0:01:15.03,0:01:18.95,Default,,0,0,0,,Хехехе... Мен чемпионатты жеңдім.
Dialogue: 0,0:01:19.03,0:01:21.49,Default,,0,0,0,,Тағы да айтайын.
Dialogue: 0,0:01:21.58,0:01:23.91,Default,,0,0,0,,Талант – бұл дүниеде бәрі
Dialogue: 0,0:01:24.00,0:01:28.54,Default,,0,0,0,,Бұдан былай бәріңіз мұны түсінетін боласыз, сондықтан оны жек көресіз.
Dialogue: 0,0:01:28.63,0:01:30.21,Default,,0,0,0,,Кекеке…
Dialogue: 0,0:01:30.29,0:01:32.50,Default,,0,0,0,,Сізге бір нәрсе жетіспейді, қарғыс атқыр афро.
Dialogue: 0,0:01:36.47,0:01:41.43,Default,,0,0,0,,Дарындылықтың шегі бар, күштің шегі жоқ.
Dialogue: 0,0:01:41.51,0:01:45.23,Default,,0,0,0,,Енді мына балалар дәлелдейді.
Dialogue: 0,0:01:54.03,0:01:59.03,Default,,0,0,0,,♪~
Dialogue: 0,0:03:09.02,0:03:14.02,Default,,0,0,0,,~♪
Dialogue: 0,0:03:23.87,0:03:26.83,Default,,0,0,0,,Орта мектептегі американдық футбол бойынша аймақтық ұсыныс халықаралық жолдастық ойындар
Dialogue: 0,0:03:27.29,0:03:29.83,Default,,0,0,0,,1-ші Крем Пуф кубогының финалы!
Dialogue: 0,0:03:29.91,0:03:32.79,Default,,0,0,0,,Деймон Ібіліс жарғанақтарға қарсы Солтүстік жарық борандары
Dialogue: 0,0:03:32.87,0:03:35.42,Default,,0,0,0,,Ойын ақыры басталып жатыр!
Dialogue: 0,0:03:35.50,0:03:37.25,Default,,0,0,0,,Қызықты! толқып кетті!
Dialogue: 0,0:03:37.63,0:03:40.30,Default,,0,0,0,,Go Go! Ібіліс жарғанақтар!
Dialogue: 0,0:03:40.38,0:03:41.72,Default,,0,0,0,,Оны қатайтыңыз!
Dialogue: 0,0:03:42.84,0:03:44.89,Default,,0,0,0,,Сәттілік Сена!
Dialogue: 0,0:03:45.72,0:03:46.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:53.02,0:03:54.60,Default,,0,0,0,,Директор
Dialogue: 0,0:03:54.98,0:03:56.15,Default,,0,0,0,,Хмм! (Гомер Уотт) Ах...
Dialogue: 0,0:03:56.56,0:03:59.15,Default,,0,0,0,,Директор Сіз келдіңіз!
Dialogue: 0,0:04:01.11,0:04:01.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:02.65,0:04:04.66,Default,,0,0,0,,О, бұл Аполлон.
Dialogue: 0,0:04:05.20,0:04:07.99,Default,,0,0,0,,А... Бұл сенің депозитің бе?
Dialogue: 0,0:04:08.08,0:04:10.70,Default,,0,0,0,,А... Жүр.
Dialogue: 0,0:04:10.79,0:04:14.67,Default,,0,0,0,,Бәріміз Шаттлдарды тағы бір рет қайта құрастырайық!
Dialogue: 0,0:04:15.46,0:04:18.17,Default,,0,0,0,,Біз американдық футбол ойнағымыз келеді!
Dialogue: 0,0:04:18.25,0:04:20.63,Default,,0,0,0,,Осы мүшемен және директормен!
Dialogue: 0,0:04:21.09,0:04:22.67,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:04:23.51,0:04:25.59,Default,,0,0,0,,Біз берілмейміз!
Dialogue: 0,0:04:25.89,0:04:30.01,Default,,0,0,0,,Кедергі қанша биік болса да, мен оны міндетті түрде жеңемін!
Dialogue: 0,0:04:30.10,0:04:33.81,Default,,0,0,0,,Иә! Барлығының сезімі сол қалпында қалады!
Dialogue: 0,0:04:33.89,0:04:35.31,Default,,0,0,0,,Бірге жасайық!
Dialogue: 0,0:04:35.40,0:04:40.27,Default,,0,0,0,,Жеңілген адам не десе де, жеңілгеннің айқайлаған дауысы ғана естіледі.
Dialogue: 0,0:04:40.36,0:04:41.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:41.61,0:04:42.78,Default,,0,0,0,,Ах…
Dialogue: 0,0:04:45.57,0:04:47.45,Default,,0,0,0,,Ібіліс жарғанақтар... Иә?
Dialogue: 0,0:04:47.91,0:04:50.95,Default,,0,0,0,,Олардың шайқасын қараңыз
Dialogue: 0,0:04:52.20,0:04:56.42,Default,,0,0,0,,Сонда сіз жақсы досыңыздан көмек сұрайсыз ба?
Dialogue: 0,0:04:56.50,0:04:58.58,Default,,0,0,0,,Олар не істей алады?
Dialogue: 0,0:04:59.00,0:05:01.13,Default,,0,0,0,,Күте тұрыңыз, иә?
Dialogue: 0,0:05:03.55,0:05:05.72,Default,,0,0,0,,Шынында да, әрқайсымыз⸺
Dialogue: 0,0:05:05.80,0:05:09.35,Default,,0,0,0,,Blizzard ойыншыларынан төмен болуы мүмкін
Dialogue: 0,0:05:09.85,0:05:13.52,Default,,0,0,0,,Бірақ біз... жалғыз емеспіз
Dialogue: 0,0:05:13.60,0:05:15.56,Default,,0,0,0,,Барлығы менің айналамда
Dialogue: 0,0:05:15.64,0:05:18.81,Default,,0,0,0,,Осы уақытқа дейін жау қанша күшті болса да, күресе білдім⸺
Dialogue: 0,0:05:18.90,0:05:20.90,Default,,0,0,0,,Өйткені барлығы сонда болды
Dialogue: 0,0:05:21.57,0:05:24.03,Default,,0,0,0,,Біз бәріміз бірге күресеміз.
Dialogue: 0,0:05:24.49,0:05:29.53,Default,,0,0,0,,Мен өзім үшін және өз командам үшін күресемін.
Dialogue: 0,0:05:29.62,0:05:34.29,Default,,0,0,0,,Ал Пантер мырзаға, Гомер мырзаға және Уотт мырзаға.
Dialogue: 0,0:05:35.37,0:05:37.08,Default,,0,0,0,,Мен мұны осы матчта дәлелдеймін!
Dialogue: 0,0:05:37.17,0:05:38.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:38.79,0:05:40.63,Default,,0,0,0,,Біз жұмсалатын заттар емеспіз!
Dialogue: 0,0:05:40.71,0:05:42.59,Default,,0,0,0,,Күш пен табандылықты бағалама!
Dialogue: 0,0:05:42.67,0:05:44.63,Default,,0,0,0,,Тек әділдік жеңетінін біл!
Dialogue: 0,0:05:44.71,0:05:46.09,Default,,0,0,0,,Фугофугофуго!
Dialogue: 0,0:05:46.47,0:05:47.80,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:05:47.88,0:05:49.18,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:05:49.68,0:05:51.55,Default,,0,0,0,,Бір адамның қашып кетуіне жол берме.
Dialogue: 0,0:05:52.97,0:05:54.10,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:55.02,0:05:56.56,Default,,0,0,0,,Балалар...
Dialogue: 0,0:05:57.44,0:05:59.52,Default,,0,0,0,,Ақылды сөйлеме
Dialogue: 0,0:05:59.60,0:06:01.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:04.36,0:06:06.11,Default,,0,0,0,,Жарайды, иә?
Dialogue: 0,0:06:06.19,0:06:07.24,Default,,0,0,0,,Мен оны көремін
Dialogue: 0,0:06:08.11,0:06:11.37,Default,,0,0,0,,Маған қызық, балалар сендер қандай жынды ойын ойнайсыңдар.
Dialogue: 0,0:06:16.29,0:06:17.50,Default,,0,0,0,,Ұстаудың қажеті жоқ
Dialogue: 0,0:06:17.58,0:06:20.21,Default,,0,0,0,,Оны толығымен құлатыңыз!
Dialogue: 0,0:06:20.29,0:06:21.33,Default,,0,0,0,,Мен ол жігітке ештеңе істей алмаймын
Dialogue: 0,0:06:23.92,0:06:25.92,Default,,0,0,0,,Солтүстік жердің мақтанышы үшін!
Dialogue: 0,0:06:26.34,0:06:29.05,Default,,0,0,0,,Шабуыл қатты боран сияқты!
Dialogue: 0,0:06:29.38,0:06:32.10,Default,,0,0,0,,Қорғаныс тундраның қатты жеріндей!
Dialogue: 0,0:06:32.89,0:06:35.81,Default,,0,0,0,,Біз солтүстік жарық борандарымыз!
Dialogue: 0,0:06:36.43,0:06:39.23,Default,,0,0,0,,Аврора, мәңгі өмір сүр!
Dialogue: 0,0:06:39.77,0:06:41.23,Default,,0,0,0,,Жақсы ма? Темера!
Dialogue: 0,0:06:41.31,0:06:44.40,Default,,0,0,0,,Мен бірде-бір затты жоғалтпай, Рождестволық ыдысқа дейін барамын!
Dialogue: 0,0:06:45.40,0:06:47.15,Default,,0,0,0,,Макс!
Dialogue: 0,0:06:48.03,0:06:50.49,Default,,0,0,0,,Сол жігіттерден жеңіліп қалсам ғой!
Dialogue: 0,0:06:50.57,0:06:54.58,Default,,0,0,0,,О! Бұл жерде жеңілсем, манга оқуды доғарамын!
Dialogue: 0,0:06:54.66,0:06:58.20,Default,,0,0,0,,Сіз ұтыласыз ба? Мен жеңетініме сенімдімін!
Dialogue: 0,0:06:58.29,0:07:01.96,Default,,0,0,0,,Уау! Мен жанып тұрмын!
Dialogue: 0,0:07:02.04,0:07:03.17,Default,,0,0,0,,Фугофуго!
Dialogue: 0,0:07:03.84,0:07:07.34,Default,,0,0,0,,Дұрыс... Жаттығуға мені ертіп келген Пантер-кун⸺
Dialogue: 0,0:07:07.42,0:07:09.63,Default,,0,0,0,,Shuttles-тегі барлығы үшін!
Dialogue: 0,0:07:10.22,0:07:11.05,Default,,0,0,0,,Және…
Dialogue: 0,0:07:11.93,0:07:13.68,Default,,0,0,0,,Сусуму және Рику⸺
Dialogue: 0,0:07:13.76,0:07:17.06,Default,,0,0,0,,Көптеген суперадамдарға жақындау үшін
Dialogue: 0,0:07:17.14,0:07:19.93,Default,,0,0,0,,Мен бұл матчта міндетті түрде жеңемін!
Dialogue: 0,0:07:22.40,0:07:23.48,Default,,0,0,0,,Оны ұсақтаңыз!
Dialogue: 0,0:07:24.15,0:07:25.94,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:07:27.78,0:07:29.69,Default,,0,0,0,,(тұмар дауысы)
Dialogue: 0,0:07:33.41,0:07:34.95,Default,,0,0,0,,Бұл үлкен!
Dialogue: 0,0:07:35.53,0:07:37.91,Default,,0,0,0,,Шынымен арктикалық дауыл!
Dialogue: 0,0:07:37.99,0:07:41.75,Default,,0,0,0,,Боран соғып кеткендей созылып жатыр!
Dialogue: 0,0:07:47.42,0:07:48.80,Default,,0,0,0,,(Польнарефф) Ә? Бұл не? Бұл жабысқақ не?
Dialogue: 0,0:07:50.63,0:07:52.59,Default,,0,0,0,,Бұзыңыз!
Dialogue: 0,0:07:57.76,0:07:59.31,Default,,0,0,0,,Жоқ! тез!
Dialogue: 0,0:08:01.98,0:08:03.60,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:08:04.02,0:08:06.06,Default,,0,0,0,,Мына кішкентай жігітті басып таста!
Dialogue: 0,0:08:06.56,0:08:08.73,Default,,0,0,0,,Бораннан қорғаныс бірінен соң бірі
Dialogue: 0,0:08:08.82,0:08:10.53,Default,,0,0,0,,Жолда тұр!
Dialogue: 0,0:08:11.15,0:08:11.99,Default,,0,0,0,,Жеңіс!
Dialogue: 0,0:08:16.87,0:08:18.33,Default,,0,0,0,,Ахх...
Dialogue: 0,0:08:21.12,0:08:22.96,Default,,0,0,0,,шықты! Жарық жылдамдығымен жүгіру!
Dialogue: 0,0:08:23.33,0:08:24.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:27.42,0:08:29.34,Default,,0,0,0,,Қозғалыс!
Dialogue: 0,0:08:29.42,0:08:31.55,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:08:31.63,0:08:34.51,Default,,0,0,0,,О, құдай! көз қалқаны 21
Dialogue: 0,0:08:34.59,0:08:38.47,Default,,0,0,0,,Бастапқыда күтпеген жерден соққы!
Dialogue: 0,0:08:42.31,0:08:44.35,Default,,0,0,0,,Бұл керемет, Сена!
Dialogue: 0,0:08:45.81,0:08:46.65,Default,,0,0,0,,Сен екеуің алда барыңдар!
Dialogue: 0,0:08:46.73,0:08:50.69,Default,,0,0,0,,Ұпай үшін әрекет әрқашан 7-0
Dialogue: 0,0:08:50.78,0:08:53.57,Default,,0,0,0,,Ібіліс жарғанақтары Жақсы бастама!
Dialogue: 0,0:08:55.07,0:08:58.95,Default,,0,0,0,,Айсшилд 21 жүгіруінің айқындығы өте өткір!
Dialogue: 0,0:08:59.41,0:09:04.41,Default,,0,0,0,,Енді жарық жылдамдығын тоқтату өте қиын емес пе?
Dialogue: 0,0:09:04.50,0:09:06.54,Default,,0,0,0,,Ннн…
Dialogue: 0,0:09:07.04,0:09:08.08,Default,,0,0,0,,Хмм…
Dialogue: 0,0:09:08.96,0:09:12.84,Default,,0,0,0,,Міне, мұндай кемістікпен бұл дұрыс.
Dialogue: 0,0:09:14.26,0:09:18.68,Default,,0,0,0,,Енді Blizzards күміс мамонт армиясы қарсы шабуылға шығады! ?
Dialogue: 0,0:09:19.89,0:09:21.18,Default,,0,0,0,,Міне, келдің, қарғыс атқыр маймыл!
Dialogue: 0,0:09:21.26,0:09:22.89,Default,,0,0,0,,Муккья!
Dialogue: 0,0:09:23.39,0:09:25.77,Default,,0,0,0,,О...
Dialogue: 0,0:09:25.85,0:09:27.85,Default,,0,0,0,,Бұл шықты!
Dialogue: 0,0:09:28.90,0:09:31.94,Default,,0,0,0,,Николайдың «Союз» асуы!
Dialogue: 0,0:09:32.02,0:09:35.11,Default,,0,0,0,,Сіз мұны ала аласыз ба, жоқ па - бұл Деймондағы жеңістің кілті!
Dialogue: 0,0:09:35.19,0:09:38.95,Default,,0,0,0,,Монта арнайы баскетбол жаттығулары кезінде өлім қылмысына қарсы жасалған!
Dialogue: 0,0:09:39.03,0:09:41.08,Default,,0,0,0,,Енді оны көрсететін уақыт келді!
Dialogue: 0,0:09:41.74,0:09:42.87,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:42.95,0:09:44.91,Default,,0,0,0,,Ой! Маймыл... Дұрыс емес.
Dialogue: 0,0:09:45.00,0:09:47.42,Default,,0,0,0,,Сергей Монтаников та ереді!
Dialogue: 0,0:09:47.50,0:09:49.67,Default,,0,0,0,,Кейіпкер бас киімі.
Dialogue: 0,0:09:49.75,0:09:50.92,Default,,0,0,0,,Ұлы маймыл және кішкентай маймыл
Dialogue: 0,0:09:51.00,0:09:54.38,Default,,0,0,0,,Жоқ, бұл Юкио мен жапон маймылының арасындағы жекпе-жек!
Dialogue: 0,0:09:55.01,0:09:57.63,Default,,0,0,0,,Кішкентай болсаң да, жеңілмейсің!
Dialogue: 0,0:09:58.55,0:10:02.60,Default,,0,0,0,,Муки!
Dialogue: 0,0:10:03.60,0:10:04.47,Default,,0,0,0,,Монта!
Dialogue: 0,0:10:06.89,0:10:09.65,Default,,0,0,0,,Мен жеңіліп қалдым деп ойлаймын!
Dialogue: 0,0:10:10.65,0:10:12.52,Default,,0,0,0,,Деймон Ібіліс Жарғанаттар Раймон Таро!
Dialogue: 0,0:10:12.61,0:10:15.03,Default,,0,0,0,,«Союз» асуын кесіп алыңыз!
Dialogue: 0,0:10:15.86,0:10:16.99,Default,,0,0,0,,Монта!
Dialogue: 0,0:10:17.07,0:10:19.49,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:20.70,0:10:21.82,Default,,0,0,0,,Хмф!
Dialogue: 0,0:10:22.62,0:10:24.70,Default,,0,0,0,,Ммм... Хмф!
Dialogue: 0,0:10:25.49,0:10:26.91,Default,,0,0,0,,Уши!
Dialogue: 0,0:10:27.33,0:10:30.46,Default,,0,0,0,,Хм... Не істеп жатырсың?
Dialogue: 0,0:10:30.54,0:10:34.00,Default,,0,0,0,,Мені кешіріңіздер, бейбақтар!
Dialogue: 0,0:10:34.09,0:10:37.01,Default,,0,0,0,,Енді шабуыл жасау құқығы қайтадан Ібіліс жарғанақтарына беріледі!
Dialogue: 0,0:10:37.55,0:10:40.93,Default,,0,0,0,,Әлі шамамен 50 ярд қалды.
Dialogue: 0,0:10:44.10,0:10:45.93,Default,,0,0,0,,Орнату! қалпақ!
Dialogue: 0,0:10:49.10,0:10:51.94,Default,,0,0,0,,Міне! Қабақ қалқаны 21!
Dialogue: 0,0:10:52.02,0:10:53.36,Default,,0,0,0,,Мен мұны енді қайталамаймын!
Dialogue: 0,0:10:53.44,0:10:56.82,Default,,0,0,0,,Оны орыс рулеткасының көмегімен ұсақтаңыз!
Dialogue: 0,0:10:58.74,0:11:01.32,Default,,0,0,0,,Атты әскер осында!
Dialogue: 0,0:11:03.82,0:11:05.16,Default,,0,0,0,,Ең алдымен, жылдамдық!
Dialogue: 0,0:11:05.79,0:11:06.66,Default,,0,0,0,,Ннн!
Dialogue: 0,0:11:06.74,0:11:08.37,Default,,0,0,0,,Келесі - қуат!
Dialogue: 0,0:11:08.75,0:11:09.66,Default,,0,0,0,,тіпті «костюмнің ашықтығын реттейтін заң жобасы» дайындалған болатын—
Dialogue: 0,0:11:09.75,0:11:12.67,Default,,0,0,0,,Ал техникамен аяқтаңыз!
Dialogue: 0,0:11:14.63,0:11:16.00,Default,,0,0,0,,Оны ұсақтаңыз!
Dialogue: 0,0:11:21.01,0:11:23.89,Default,,0,0,0,,Бұл жанасу болады ма? ?
Dialogue: 0,0:11:23.97,0:11:26.35,Default,,0,0,0,,Тоқта, Иван!
Dialogue: 0,0:11:26.43,0:11:28.85,Default,,0,0,0,,(Мамонт айқайы)
Dialogue: 0,0:11:29.89,0:11:30.85,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:11:31.69,0:11:34.31,Default,,0,0,0,,Мамонт шабуылы!
Dialogue: 0,0:11:34.40,0:11:36.27,Default,,0,0,0,,және оларды туған жерім Италияның асханасына енгіздім.
Dialogue: 0,0:11:38.32,0:11:40.86,Default,,0,0,0,,Ой! Көз қалқаны Менде доп жоқ!
Dialogue: 0,0:11:40.95,0:11:43.11,Default,,0,0,0,,Хилл Демон-кун, мен оны саған беремін деп кейіптеуге шебермін!
Dialogue: 0,0:11:43.20,0:11:44.37,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:47.08,0:11:48.74,Default,,0,0,0,,Не! ?
Dialogue: 0,0:11:48.83,0:11:52.92,Default,,0,0,0,,Деймонның мақсаты – Мусашидің алаңдағы қақпаға соғуы!
Dialogue: 0,0:11:53.00,0:11:56.00,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:02.17,0:12:03.43,Default,,0,0,0,,
Dialogue: 0,0:12:03.80,0:12:05.59,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:12:05.68,0:12:09.10,Default,,0,0,0,,Мусаши-кун, біз 50 ярд қашықтықты шештік!
Dialogue: 0,0:12:09.18,0:12:10.64,Default,,0,0,0,,О! таңқаларлық!
Dialogue: 0,0:12:10.73,0:12:12.39,Default,,0,0,0,,Я-Ха-! (мылтық дыбысы)
Dialogue: 0,0:12:12.48,0:12:13.31,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:13.39,0:12:15.81,Default,,0,0,0,,(көңілді дауыс)
Dialogue: 0,0:12:16.31,0:12:19.28,Default,,0,0,0,,Deimon Devil Bats 3 ұпай қосылды!
Dialogue: 0,0:12:19.36,0:12:20.19,Default,,0,0,0,,Танжиро мен Незуко Қандыперделерді жоюшылар корпусының мүшелері ретінде шайқаса алатынын,
Dialogue: 0,0:12:20.28,0:12:23.74,Default,,0,0,0,,Әлі де өрескел соққы.
Dialogue: 0,0:12:24.74,0:12:26.53,Default,,0,0,0,,Бұл қашықтық.
Dialogue: 0,0:12:26.62,0:12:29.03,Default,,0,0,0,,Егер сіз шешсеңіз, сізде ешқандай шағым болмайды.
Dialogue: 0,0:12:29.12,0:12:29.95,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:12:32.96,0:12:36.13,Default,,0,0,0,,Екінші тоқсанда Деймонның қорғанысы жарылады!
Dialogue: 0,0:12:36.21,0:12:39.80,Default,,0,0,0,,Біз Blizzard шабуылдарының барлығын жеңеміз!
Dialogue: 0,0:12:40.21,0:12:43.42,Default,,0,0,0,,Ой! Бүгін үшінші үзіліс!
Dialogue: 0,0:12:43.92,0:12:46.22,Default,,0,0,0,,Боран қайтадан бірінші жерге түсе алмайды⸺
Dialogue: 0,0:12:46.30,0:12:47.80,Default,,0,0,0,,Бірінші тайм 30 секунд қалды!
Dialogue: 0,0:12:47.89,0:12:50.22,Default,,0,0,0,,Шабуыл құқығы тағы да балшық қақпа!
Dialogue: 0,0:12:50.47,0:12:54.19,Default,,0,0,0,,Мына жігіттерге не істеп жатырсың?
Dialogue: 0,0:12:54.27,0:12:58.61,Default,,0,0,0,,Баршаңызды мұзбен бірге алып кетесіз бе?
Dialogue: 0,0:13:05.65,0:13:06.53,Default,,0,0,0,,бірақ соғыс бишісі Вараби-химе маған берген бұл белдемше
Dialogue: 0,0:13:06.61,0:13:09.53,Default,,0,0,0,,Ей, боқ, а... иә?
Dialogue: 0,0:13:09.62,0:13:12.16,Default,,0,0,0,,Бұл жолы мен тікелей шабуыл әдісімен барамын.
Dialogue: 0,0:13:12.24,0:13:15.50,Default,,0,0,0,,Ұят мамонт бейбақ.
Dialogue: 0,0:13:16.71,0:13:17.63,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:21.25,0:13:22.38,Default,,0,0,0,,Бұл Сенна!
Dialogue: 0,0:13:22.46,0:13:24.38,Default,,0,0,0,,Міне, Иванның мамонт шабуылы!
Dialogue: 0,0:13:27.89,0:13:30.05,Default,,0,0,0,,Жалтару туралы ойламаңыз
Dialogue: 0,0:13:30.47,0:13:32.35,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:33.18,0:13:34.93,Default,,0,0,0,,Қарсыласыңыздың тізесіне қараңыз...
Dialogue: 0,0:13:37.35,0:13:39.81,Default,,0,0,0,,Мен осы жерден асығамын!
Dialogue: 0,0:13:39.90,0:13:42.82,Default,,0,0,0,,Иванды ұр!
Dialogue: 0,0:13:42.90,0:13:46.53,Default,,0,0,0,,Мына мамонт жігітті бұраңыз!
Dialogue: 0,0:13:51.28,0:13:55.70,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:00.71,0:14:01.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:01.67,0:14:03.05,Default,,0,0,0,,Ааа... (Сілік жын) Кеке...
Dialogue: 0,0:14:03.71,0:14:04.76,Default,,0,0,0,,Ах…
Dialogue: 0,0:14:05.55,0:14:07.76,Default,,0,0,0,,Қозғалыс!
Dialogue: 0,0:14:08.34,0:14:11.22,Default,,0,0,0,,Жеңілген мамонттың шабуылы Деймон Ібіліс жарғанақтары
Dialogue: 0,0:14:11.30,0:14:15.18,Default,,0,0,0,,Бірінші тайм 17 ұпай айырмашылығымен аяқталды!
Dialogue: 0,0:14:16.14,0:14:17.02,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:17.52,0:14:19.52,Default,,0,0,0,,Жасай бер!
Dialogue: 0,0:14:19.60,0:14:21.98,Default,,0,0,0,,Жарайды, айырмашылық 17 ұпай!
Dialogue: 0,0:14:22.06,0:14:25.44,Default,,0,0,0,,Сенна шешсе, біздікі.
Dialogue: 0,0:14:25.53,0:14:29.15,Default,,0,0,0,,Ах! Осы қарқынмен біз жеңеміз!
Dialogue: 0,0:14:29.24,0:14:30.66,Default,,0,0,0,,Сіз мұны істей аласыз!
Dialogue: 0,0:14:30.74,0:14:33.16,Default,,0,0,0,,Біз кете аламыз! Эй?
Dialogue: 0,0:14:34.03,0:14:36.45,Default,,0,0,0,,Бұл жігіттер, мүмкін емес...
Dialogue: 0,0:14:37.20,0:14:38.83,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:14:39.21,0:14:45.21,Default,,0,0,0,,Хахахахахаха...
Dialogue: 0,0:14:45.30,0:14:47.38,Default,,0,0,0,,Ннн…
Dialogue: 0,0:14:47.46,0:14:52.26,Default,,0,0,0,,Бұлай бәрі жақсы болады деп ойламаңыз.
Dialogue: 0,0:14:54.22,0:14:56.14,Default,,0,0,0,,Бөлшектерді ауыстырыңыз!
Dialogue: 0,0:14:57.22,0:15:01.60,Default,,0,0,0,,Ой, Blizzards екінші таймда ойыншыларды ауыстырды!
Dialogue: 0,0:15:01.69,0:15:04.27,Default,,0,0,0,,Бұл кім? Сол ойыншы? Иә?
Dialogue: 0,0:15:04.36,0:15:05.57,Default,,0,0,0,,Ум...
Dialogue: 0,0:15:06.23,0:15:09.03,Default,,0,0,0,,Боран туралы көп ақпарат жоқ.
Dialogue: 0,0:15:09.11,0:15:11.24,Default,,0,0,0,,Ум, мм... мм...
Dialogue: 0,0:15:11.32,0:15:12.95,Default,,0,0,0,,Ах! сонда болды!
Dialogue: 0,0:15:13.53,0:15:17.70,Default,,0,0,0,,Бұл Иванның егіз ағасы Ован Иванов!
Dialogue: 0,0:15:18.00,0:15:20.37,Default,,0,0,0,,А... егіздер ме?
Dialogue: 0,0:15:21.00,0:15:24.08,Default,,0,0,0,,Олардың денелері мүлдем басқа сияқты.
Dialogue: 0,0:15:24.17,0:15:26.55,Default,,0,0,0,,Олар туысқан егіздер.
Dialogue: 0,0:15:26.63,0:15:29.42,Default,,0,0,0,,Шұжық! ? Қайда қайда?
Dialogue: 0,0:15:29.51,0:15:30.88,Default,,0,0,0,,Тым көп уәде
Dialogue: 0,0:15:30.97,0:15:32.97,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:15:33.05,0:15:37.22,Default,,0,0,0,,Маған біздің құпия қаруымыздың күшін көрсетіңіз.
Dialogue: 0,0:15:37.72,0:15:40.31,Default,,0,0,0,,Сонымен, сіз бөліктерді ауыстырдыңыз ба?
Dialogue: 0,0:15:40.39,0:15:43.31,Default,,0,0,0,,Сіз нені мақсат етесіз? морган
Dialogue: 0,0:15:44.02,0:15:45.61,Default,,0,0,0,,Ол қандай ойыншы?
Dialogue: 0,0:15:45.69,0:15:47.52,Default,,0,0,0,,Келіңіздер ме? (Гомер) Иә?
Dialogue: 0,0:15:47.61,0:15:49.86,Default,,0,0,0,,Ух... Уууу...
Dialogue: 0,0:15:49.94,0:15:53.45,Default,,0,0,0,,Иванның бейбақ ұрғанынан оң иығым ауырып тұр.
Dialogue: 0,0:15:53.53,0:15:56.53,Default,,0,0,0,,Менде бұл туралы жағымсыз сезім бар.
Dialogue: 0,0:15:56.62,0:16:00.20,Default,,0,0,0,,Екінші жартысында да Деймонның импульсі өзгеріссіз қалады⸺
Dialogue: 0,0:16:00.29,0:16:03.50,Default,,0,0,0,,Біз қарсыластың аумағына тұрақты түрде ілгерілеп келеміз!
Dialogue: 0,0:16:03.58,0:16:06.92,Default,,0,0,0,,Хе! Кімнің шыққаны маңызды емес
Dialogue: 0,0:16:07.00,0:16:08.75,Default,,0,0,0,,Иә, мен істей аламын!
Dialogue: 0,0:16:09.25,0:16:12.63,Default,,0,0,0,,Сәлем! Ағын өзгермейді!
Dialogue: 0,0:16:12.72,0:16:13.97,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:14.51,0:16:15.43,Default,,0,0,0,,Орнату! қалпақ!
Dialogue: 0,0:16:19.93,0:16:22.81,Default,,0,0,0,,Тағы да Айсшилд 21 жарылады!
Dialogue: 0,0:16:22.89,0:16:25.81,Default,,0,0,0,,Бұл жолы Сенаны тоқтата аласың ба? ?
Dialogue: 0,0:16:25.90,0:16:26.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:29.23,0:16:32.74,Default,,0,0,0,,Уақыт дұрыс болды! Бұл жолы да
Dialogue: 0,0:16:33.15,0:16:33.99,Default,,0,0,0,,Фу…
Dialogue: 0,0:16:34.82,0:16:36.32,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:16:36.41,0:16:38.66,Default,,0,0,0,,Сақтанба, Сена!
Dialogue: 0,0:16:38.74,0:16:43.21,Default,,0,0,0,,О!
Dialogue: 0,0:16:43.29,0:16:46.79,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:46.88,0:16:47.75,Default,,0,0,0,,Ннн!
Dialogue: 0,0:16:51.63,0:16:52.84,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:53.34,0:16:54.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:57.80,0:16:58.64,Default,,0,0,0,,Не! ?
Dialogue: 0,0:16:58.72,0:17:02.85,Default,,0,0,0,,Бұрандалы шабуыл!
Dialogue: 0,0:17:03.48,0:17:04.31,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:07.44,0:17:08.90,Default,,0,0,0,,Ах…
Dialogue: 0,0:17:09.94,0:17:12.23,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:22.12,0:17:22.95,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:34.34,0:17:36.84,Default,,0,0,0,,Сенар!
Dialogue: 0,0:17:37.80,0:17:40.93,Default,,0,0,0,,Зембіл! Зембілді әкел!
Dialogue: 0,0:17:41.43,0:17:42.68,Default,,0,0,0,,Сенна!
Dialogue: 0,0:17:42.77,0:17:44.43,Default,,0,0,0,,
Dialogue: 0,0:17:50.48,0:17:53.03,Default,,0,0,0,,Сена, мықты бол!
Dialogue: 0,0:17:53.11,0:17:54.86,Default,,0,0,0,,Сена Сәлем!
Dialogue: 0,0:17:54.94,0:17:59.03,Default,,0,0,0,,Сіз мені естисіз бе? Жауап беріңіз! Эй, Сена!
Dialogue: 0,0:17:59.49,0:18:01.74,Default,,0,0,0,,Оян, Сена!
Dialogue: 0,0:18:01.83,0:18:05.70,Default,,0,0,0,,(Сүзүнэнің айқайы)
Dialogue: 0,0:18:06.33,0:18:10.54,Default,,0,0,0,,Оның миы шайқалған сияқты. Мен мұны бірден істей алмаймын.
Dialogue: 0,0:18:10.63,0:18:13.67,Default,,0,0,0,,Иә! ? Міне бітті!
Dialogue: 0,0:18:13.75,0:18:15.71,Default,,0,0,0,,Сенасыз...
Dialogue: 0,0:18:15.80,0:18:16.63,Default,,0,0,0,,Ай жарығы қайтадан жарқыраған сәтте дейік
Dialogue: 0,0:18:17.42,0:18:19.34,Default,,0,0,0,,Хм... қалай?
Dialogue: 0,0:18:19.43,0:18:22.35,Default,,0,0,0,,Оуэннің бұрандалы шабуылының күші
Dialogue: 0,0:18:22.43,0:18:25.85,Default,,0,0,0,,(Морганның күлкісі)
Dialogue: 0,0:18:25.93,0:18:28.81,Default,,0,0,0,,Ауыстырылатын бөлшектер бар ма?
Dialogue: 0,0:18:29.19,0:18:30.48,Default,,0,0,0,,Біз шымшып қалдық!
Dialogue: 0,0:18:30.56,0:18:34.78,Default,,0,0,0,,Деймонда Айсшилд 21-ді алмастыратын ойыншы жоқ!
Dialogue: 0,0:18:34.86,0:18:37.49,Default,,0,0,0,,Төбе жын! Төбе жын!
Dialogue: 0,0:18:38.40,0:18:39.95,Default,,0,0,0,,Ах…
Dialogue: 0,0:18:40.03,0:18:42.45,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:18:44.20,0:18:47.41,Default,,0,0,0,,Осы уақытқа дейін болған сияқты.
Dialogue: 0,0:18:48.08,0:18:52.38,Default,,0,0,0,,Көз қалқансыз қалай күресесің? шайтан жарғанақтар
Dialogue: 0,0:18:52.79,0:18:54.38,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:54.46,0:18:57.09,Default,,0,0,0,,Бұл үлкен мәселе!
Dialogue: 0,0:18:57.92,0:19:02.01,Default,,0,0,0,,Сена Кобаякава, aka Айсшилд 21, Ace of Light Speed
Dialogue: 0,0:19:02.09,0:19:05.26,Default,,0,0,0,,Миым шайқалып, орындыққа шықтым!
Dialogue: 0,0:19:05.35,0:19:06.47,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:19:08.73,0:19:13.56,Default,,0,0,0,,Не істеу керек? Ібіліс жарғанақтар!
Dialogue: 0,0:19:16.57,0:19:21.57,Default,,0,0,0,,♪~
Dialogue: 0,0:20:26.51,0:20:31.52,Default,,0,0,0,,~♪
Dialogue: 0,0:20:32.27,0:20:33.89,Default,,0,0,0,,Сенна құлады⸺
Dialogue: 0,0:20:33.98,0:20:35.85,Default,,0,0,0,,Бұл матчта не болады?
Dialogue: 0,0:20:35.94,0:20:38.82,Default,,0,0,0,,Сена-кун қайтып келгенше барымызды саламыз!
Dialogue: 0,0:20:38.90,0:20:40.94,Default,,0,0,0,,Бұл матчта міндетті түрде жеңіске жетейік!
Dialogue: 0,0:20:41.03,0:20:44.82,Default,,0,0,0,,Жақсы көңіл! Сена: Бұл ұйықтайтын уақыт емес!
Dialogue: 0,0:20:44.91,0:20:46.91,Default,,0,0,0,,Келесі жолы «Көз қалқаны 21»
Dialogue: 0,0:20:49.74,0:20:51.29,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:20:52.79,0:20:58.79,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
