Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.92,0:00:10.42,Default,,0,0,0,,Сондықтан 11 адам болғанымыз жақсы болар еді.
Dialogue: 0,0:00:10.51,0:00:11.92,Default,,0,0,0,,Бұл күшті!
Dialogue: 0,0:00:12.01,0:00:14.26,Default,,0,0,0,,Ол өмір энергиясына толы—
Dialogue: 0,0:00:15.18,0:00:17.35,Default,,0,0,0,,Ахх...
Dialogue: 0,0:00:17.43,0:00:20.31,Default,,0,0,0,,Tsk! Бұл тәтті емес пе?
Dialogue: 0,0:00:20.97,0:00:23.73,Default,,0,0,0,,Мен бірдеңе істеуім керек... әйтеуір.
Dialogue: 0,0:00:24.31,0:00:25.15,Default,,0,0,0,,Қарғыс атсын саған!
Dialogue: 0,0:00:25.98,0:00:26.86,Default,,0,0,0,,Иә
Dialogue: 0,0:00:26.94,0:00:31.53,Default,,0,0,0,,Бұдан былай әр ойында Агонның блиці өте жоғары жылдамдықта.
Dialogue: 0,0:00:31.61,0:00:34.86,Default,,0,0,0,,Агонда доп бар ма, жоқ па бәрібір.
Dialogue: 0,0:00:34.95,0:00:37.66,Default,,0,0,0,,Түсіндің бе? сеннаның аяғы
Dialogue: 0,0:00:37.74,0:00:42.33,Default,,0,0,0,,Егер сіз оны соншалықты қорғаныста қолдансаңыз, ол бірнеше минут ішінде міндетті түрде құлап кетеді.
Dialogue: 0,0:00:42.41,0:00:45.37,Default,,0,0,0,,Түсінбейтін жері жоқ, қарғыс атқыр қария.
Dialogue: 0,0:00:45.46,0:00:49.29,Default,,0,0,0,,Бірақ мұнда бір ұпай болса да, ойын аяқталды.
Dialogue: 0,0:00:49.38,0:00:51.50,Default,,0,0,0,,Менің кетуден басқа амалым жоқ.
Dialogue: 0,0:00:53.63,0:00:54.76,Default,,0,0,0,,Хмм
Dialogue: 0,0:00:55.84,0:00:57.43,Default,,0,0,0,,Орнату!
Dialogue: 0,0:00:57.51,0:01:01.93,Default,,0,0,0,,Бұл сіздің аяқтарыңыз. Сіз жақсы білесіз.
Dialogue: 0,0:01:02.27,0:01:05.94,Default,,0,0,0,,Егер сіз максималды жылдамдықпен жүре берсеңіз, бұл не болғанына қарамастан бірнеше минутты алады.
Dialogue: 0,0:01:06.73,0:01:09.56,Default,,0,0,0,,Бірақ сәл болса да баяулатыңыз⸺
Dialogue: 0,0:01:10.94,0:01:13.07,Default,,0,0,0,,Агон мырза ешқашан тоқтамайды!
Dialogue: 0,0:01:15.15,0:01:16.03,Default,,0,0,0,,Шляпа!
Dialogue: 0,0:01:16.11,0:01:19.99,Default,,0,0,0,,Ах~ Мені ұрып жібересіз бе?
Dialogue: 0,0:01:20.62,0:01:22.79,Default,,0,0,0,,Агон үшін ешқандай трюк жұмыс істемейді.
Dialogue: 0,0:01:22.87,0:01:25.96,Default,,0,0,0,,Өйткені ол бәрін көріп, әрекет жасай алады.
Dialogue: 0,0:01:31.04,0:01:35.63,Default,,0,0,0,,♪~
Dialogue: 0,0:02:50.92,0:02:55.92,Default,,0,0,0,,~♪
Dialogue: 0,0:03:03.01,0:03:04.76,Default,,0,0,0,,Орнату! қалпақ!
Dialogue: 0,0:03:08.52,0:03:12.65,Default,,0,0,0,,Соңына дейін менімен жеке-жеке істеу керек сияқты.
Dialogue: 0,0:03:15.19,0:03:17.07,Default,,0,0,0,,Менің кетуден басқа амалым жоқ.
Dialogue: 0,0:03:17.15,0:03:19.11,Default,,0,0,0,,Өте жылдам блиц!
Dialogue: 0,0:03:19.19,0:03:21.07,Default,,0,0,0,,Хаха, тез кел!
Dialogue: 0,0:03:23.16,0:03:24.03,Default,,0,0,0,,Ммм
Dialogue: 0,0:03:28.04,0:03:29.50,Default,,0,0,0,,Не болды?
Dialogue: 0,0:03:30.00,0:03:31.37,Default,,0,0,0,,Сенна!
Dialogue: 0,0:03:34.25,0:03:35.25,Default,,0,0,0,,
Dialogue: 0,0:03:35.34,0:03:37.84,Default,,0,0,0,,Сәтті өту! 12 ярд алға!
Dialogue: 0,0:03:38.42,0:03:40.51,Default,,0,0,0,,Ago-kun Айсшилд 21⸺
Dialogue: 0,0:03:40.59,0:03:43.09,Default,,0,0,0,,Жоғары жылдамдықты зарядтарды супер реакциямен қайтарыңыз
Dialogue: 0,0:03:43.18,0:03:45.30,Default,,0,0,0,,Ағып жатқан жол!
Dialogue: 0,0:03:45.39,0:03:49.22,Default,,0,0,0,,25 ұпай айырмашылығы, 18 минут қалды!
Dialogue: 0,0:03:49.93,0:03:51.85,Default,,0,0,0,,Бұл шешуші блиц пе?
Dialogue: 0,0:03:51.94,0:03:55.23,Default,,0,0,0,,Агонды басу үшін Eyeshield супер жылдамдығын пайдаланыңыз
Dialogue: 0,0:03:55.31,0:03:57.19,Default,,0,0,0,,Мақсат жаман емес, бірақ...
Dialogue: 0,0:03:57.94,0:04:01.28,Default,,0,0,0,,Бұл мұндай тосын шабуылды жеңе алатын өлшемді қарсылас емес.
Dialogue: 0,0:04:01.36,0:04:03.03,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:04:03.11,0:04:07.08,Default,,0,0,0,,Агон да, Сена да ғажап, ғажап.
Dialogue: 0,0:04:07.16,0:04:08.74,Default,,0,0,0,,Егер бұл мен болсам,
Dialogue: 0,0:04:08.83,0:04:13.00,Default,,0,0,0,,Қанша тез қашсаң да, допты лақтырмай тұрып, жаншып кетесің.
Dialogue: 0,0:04:13.67,0:04:16.88,Default,,0,0,0,,Сол жақ қолыңдағы ырғақ артта қалып жатыр
Dialogue: 0,0:04:16.96,0:04:18.96,Default,,0,0,0,,Қат! Бұл мүлдем жұмыс істемейді
Dialogue: 0,0:04:19.05,0:04:21.46,Default,,0,0,0,,Өйткені сіз кейінгі шығарылыммен өте жақсы әрекет ете аласыз.
Dialogue: 0,0:04:21.55,0:04:25.18,Default,,0,0,0,,Бұл қорқынышты адам жылдамдықты ойламайды.
Dialogue: 0,0:04:26.14,0:04:28.05,Default,,0,0,0,,Қалайша біреуді бір оқпен өлтіруге болады?
Dialogue: 0,0:04:28.14,0:04:29.01,Default,,0,0,0,,Бұл туралы ойламаңыз
Dialogue: 0,0:04:29.10,0:04:29.93,Default,,0,0,0,,Ах
Dialogue: 0,0:04:30.64,0:04:32.14,Default,,0,0,0,,Сол қорқыныштың сенімділігі
Dialogue: 0,0:04:32.23,0:04:34.56,Default,,0,0,0,,Шамадан тыс немесе құрметсіз емес
Dialogue: 0,0:04:34.94,0:04:37.90,Default,,0,0,0,,Конго Агон - даусыз данышпан.
Dialogue: 0,0:04:37.98,0:04:40.82,Default,,0,0,0,,Өйткені, бұл менмін...
Dialogue: 0,0:04:40.90,0:04:42.40,Default,,0,0,0,,Әлі де... Иә?
Dialogue: 0,0:04:42.49,0:04:45.36,Default,,0,0,0,,Бір-бірден қысым жасау
Dialogue: 0,0:04:46.07,0:04:47.32,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:47.41,0:04:50.95,Default,,0,0,0,,Бар назарыңызды бір адамға аударыңыз.
Dialogue: 0,0:04:51.04,0:04:53.29,Default,,0,0,0,,Бар күшіңізді аяқтарыңызға құйыңыз
Dialogue: 0,0:04:54.04,0:04:57.75,Default,,0,0,0,,Сіз жасай алатын көп нәрсе бар.
Dialogue: 0,0:04:57.83,0:04:58.96,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:00.63,0:05:01.71,Default,,0,0,0,,Орнату!
Dialogue: 0,0:05:01.80,0:05:03.67,Default,,0,0,0,,Көп ойланба⸺
Dialogue: 0,0:05:03.76,0:05:06.84,Default,,0,0,0,,Агон-санның қимылдарына ғана назар аударыңыз.
Dialogue: 0,0:05:06.93,0:05:09.26,Default,,0,0,0,,Көп ойланба...
Dialogue: 0,0:05:09.97,0:05:12.68,Default,,0,0,0,,Көп ойланба...
Dialogue: 0,0:05:13.81,0:05:15.14,Default,,0,0,0,,Керемет
Dialogue: 0,0:05:13.81,0:05:15.14,Default,,0,0,0,,Бірақ оның аяқтары бар ма?
Dialogue: 0,0:05:15.14,0:05:16.19,Default,,0,0,0,,Бірақ сіздің аяқтарыңыз бар ма?
Dialogue: 0,0:05:16.27,0:05:17.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:16.27,0:05:17.60,Default,,0,0,0,,Бұл өте жоғары жылдамдық.
Dialogue: 0,0:05:17.60,0:05:18.73,Default,,0,0,0,,Бұл өте жоғары жылдамдық.
Dialogue: 0,0:05:18.81,0:05:20.06,Default,,0,0,0,,Ол бұзылады!
Dialogue: 0,0:05:20.15,0:05:21.90,Default,,0,0,0,,Бұл шектеу емес пе?
Dialogue: 0,0:05:21.98,0:05:23.90,Default,,0,0,0,,Соңына дейін созылады ма?
Dialogue: 0,0:05:23.99,0:05:25.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:25.15,0:05:29.87,Default,,0,0,0,,Мен бұл туралы ойламауға тырысқан сайын, менде біртүрлі адасулар бар... а...
Dialogue: 0,0:05:29.95,0:05:31.24,Default,,0,0,0,,Ойлауды тоқтату
Dialogue: 0,0:05:31.33,0:05:32.83,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:05:34.83,0:05:35.79,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:35.87,0:05:38.04,Default,,0,0,0,,Концентрат
Dialogue: 0,0:05:38.12,0:05:41.59,Default,,0,0,0,,Барлық жүйкелеріңізді және барлық аяқтарыңызды қолданыңыз!
Dialogue: 0,0:05:41.67,0:05:42.50,Default,,0,0,0,,Шляпа!
Dialogue: 0,0:05:47.76,0:05:49.93,Default,,0,0,0,,ДжоДжо қарсы Вамуу—
Dialogue: 0,0:05:50.01,0:05:51.60,Default,,0,0,0,,Хехехе
Dialogue: 0,0:05:52.68,0:05:55.56,Default,,0,0,0,,Сондықтан сіз бұл жұмыс істемейді деп отырсыз.
Dialogue: 0,0:05:55.64,0:05:57.23,Default,,0,0,0,,Хмм!
Dialogue: 0,0:05:57.69,0:05:59.27,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:06:00.06,0:06:03.94,Default,,0,0,0,,Қоқыстардың күзгі турнирі аяқталды.
Dialogue: 0,0:06:04.03,0:06:05.36,Default,,0,0,0,,Хмм
Dialogue: 0,0:06:06.65,0:06:08.28,Default,,0,0,0,,Сәлем, Рождестволық ыдыс?
Dialogue: 0,0:06:08.36,0:06:12.78,Default,,0,0,0,,Төрт жыл армандап, ойын аяқталды.
Dialogue: 0,0:06:12.87,0:06:14.12,Default,,0,0,0,,Ммм
Dialogue: 0,0:06:16.66,0:06:18.87,Default,,0,0,0,,Хмм... уф
Dialogue: 0,0:06:20.17,0:06:21.38,Default,,0,0,0,,Хмм
Dialogue: 0,0:06:21.46,0:06:22.67,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:06:23.29,0:06:24.13,Default,,0,0,0,,Хмм
Dialogue: 0,0:06:25.46,0:06:27.51,Default,,0,0,0,,Бұл қысқа жол!
Dialogue: 0,0:06:27.59,0:06:29.09,Default,,0,0,0,,4 ярд алға!
Dialogue: 0,0:06:29.18,0:06:32.55,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:37.56,0:06:40.44,Default,,0,0,0,,Ол жігітке не болды?
Dialogue: 0,0:06:41.19,0:06:45.40,Default,,0,0,0,,О? Бұл ерекше ештеңе емес.
Dialogue: 0,0:06:45.48,0:06:49.40,Default,,0,0,0,,Сол жақ қолыңдағы ырғақ артта қалып жатыр
Dialogue: 0,0:06:51.11,0:06:52.20,Default,,0,0,0,,Хмм
Dialogue: 0,0:06:53.91,0:06:55.45,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:06:55.54,0:06:56.37,Default,,0,0,0,,О
Dialogue: 0,0:06:57.16,0:06:58.33,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:06:59.75,0:07:00.79,Default,,0,0,0,,Джумонджи-кун
Dialogue: 0,0:07:01.42,0:07:02.46,Default,,0,0,0,,Иә
Dialogue: 0,0:07:02.96,0:07:04.75,Default,,0,0,0,,Сәл сүрініп қалдым.
Dialogue: 0,0:07:05.38,0:07:07.34,Default,,0,0,0,,Мен мұны істеуге рұқсат бермеймін.
Dialogue: 0,0:07:07.42,0:07:09.05,Default,,0,0,0,,Егер сіз соққыға жығылған болсаңыз...
Dialogue: 0,0:07:09.13,0:07:10.76,Default,,0,0,0,,Бұл хобби емес.
Dialogue: 0,0:07:10.84,0:07:14.14,Default,,0,0,0,,Мен де енді жеңілуге ​​шамасы жоқ.
Dialogue: 0,0:07:14.22,0:07:15.60,Default,,0,0,0,,Ол… қауіпті болар ма?
Dialogue: 0,0:07:15.68,0:07:16.72,Default,,0,0,0,,Жаса!
Dialogue: 0,0:07:16.81,0:07:18.52,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:07:18.93,0:07:20.52,Default,,0,0,0,,Сол кезде мен—
Dialogue: 0,0:07:20.60,0:07:21.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:21.52,0:07:23.56,Default,,0,0,0,,Жаман блиц эффектісімен
Dialogue: 0,0:07:23.65,0:07:26.69,Default,,0,0,0,,Shit Dread үшін мақсатты жолды табу үшін жеңілдік кезеңі⸺
Dialogue: 0,0:07:26.77,0:07:29.32,Default,,0,0,0,,30% қырылған
Dialogue: 0,0:07:29.40,0:07:30.82,Default,,0,0,0,,Блицке барайық!
Dialogue: 0,0:07:31.40,0:07:33.07,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:07:33.70,0:07:35.32,Default,,0,0,0,,Сіз қалай ойлайсыз? Сусуму
Dialogue: 0,0:07:35.41,0:07:38.54,Default,,0,0,0,,Eyeshield-тің бүкіл пьесасы Агонға асығуды жоспарлап отырсыз ба?
Dialogue: 0,0:07:39.37,0:07:41.29,Default,,0,0,0,,Қорғаныс үшін қарсыласыңыздың қимылдарын оқыңыз⸺
Dialogue: 0,0:07:41.37,0:07:43.50,Default,,0,0,0,,Жануарлар инстинкті қажет
Dialogue: 0,0:07:44.42,0:07:45.67,Default,,0,0,0,,Орнату!
Dialogue: 0,0:07:46.63,0:07:49.51,Default,,0,0,0,,Ол сияқты тәжірибесіз ойыншыларда ондай болмайды.
Dialogue: 0,0:07:50.09,0:07:52.34,Default,,0,0,0,,Бірақ мақсатты
Dialogue: 0,0:07:52.43,0:07:55.60,Default,,0,0,0,,Егер сіз концентрацияңызды максималды деңгейге дейін арттырсаңыз немесе...
Dialogue: 0,0:07:55.68,0:07:56.85,Default,,0,0,0,,Шляпа!
Dialogue: 0,0:07:57.56,0:08:00.14,Default,,0,0,0,,Бұл оңай емес, Деймон!
Dialogue: 0,0:08:00.22,0:08:01.98,Default,,0,0,0,,Инелік өзгермелі.
Dialogue: 0,0:08:02.06,0:08:04.19,Default,,0,0,0,,Агон немесе Унсуи?
Dialogue: 0,0:08:04.94,0:08:06.73,Default,,0,0,0,,Қоян арыстан!
Dialogue: 0,0:08:10.57,0:08:11.82,Default,,0,0,0,,Ешқандай!
Dialogue: 0,0:08:12.45,0:08:15.78,Default,,0,0,0,,Артқа жүгіріп келе жатқан Санцо орталықты жарып өтті!
Dialogue: 0,0:08:15.87,0:08:19.62,Default,,0,0,0,,Ха ха ха, тіпті бұл джанджуцудың бір бөлігі.
Dialogue: 0,0:08:23.21,0:08:26.29,Default,,0,0,0,,Жүгіріп келе жатқан Аго-кунға кері пас.
Dialogue: 0,0:08:28.96,0:08:32.22,Default,,0,0,0,,Тек Агон-санға қара, тек Агон-сан...
Dialogue: 0,0:08:32.30,0:08:33.67,Default,,0,0,0,,Ммм
Dialogue: 0,0:08:37.68,0:08:39.18,Default,,0,0,0,,Tsk! Шөгінділер
Dialogue: 0,0:08:41.43,0:08:42.89,Default,,0,0,0,,Тек Агон мырзаға қараңыз
Dialogue: 0,0:08:44.44,0:08:45.44,Default,,0,0,0,,Уф
Dialogue: 0,0:08:47.86,0:08:48.90,Default,,0,0,0,,Ах
Dialogue: 0,0:08:48.98,0:08:50.36,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:50.73,0:08:51.86,Default,,0,0,0,,Сенна!
Dialogue: 0,0:08:51.94,0:08:55.32,Default,,0,0,0,,Санзоның Агонға лақтырған пасы кері бұрылды!
Dialogue: 0,0:08:55.40,0:08:58.78,Default,,0,0,0,,Бұл аймақ көз қалқанынан соқыр жер болуы керек...
Dialogue: 0,0:09:00.83,0:09:03.45,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:03.54,0:09:05.71,Default,,0,0,0,,Адам қозғалысы емес!
Dialogue: 0,0:09:06.46,0:09:09.00,Default,,0,0,0,,Мен доп туралы ойлаған жоқпын.
Dialogue: 0,0:09:09.09,0:09:12.42,Default,,0,0,0,,Eyeshield концентрациясы максималды деңгейге дейін көтерілді.
Dialogue: 0,0:09:12.51,0:09:15.22,Default,,0,0,0,,Айна сияқты Агонның қимылдарына жауап берді.
Dialogue: 0,0:09:17.26,0:09:19.39,Default,,0,0,0,,Мені ұстаңыз!
Dialogue: 0,0:09:20.51,0:09:21.39,Default,,0,0,0,,Куаааааааааааааааааа
Dialogue: 0,0:09:23.93,0:09:26.60,Default,,0,0,0,,Сәлем! Шинрюжи храмының реакциясы жылдам!
Dialogue: 0,0:09:26.69,0:09:28.81,Default,,0,0,0,,Олар балға жиналып қалды!
Dialogue: 0,0:09:29.61,0:09:30.86,Default,,0,0,0,,Мені ұстама!
Dialogue: 0,0:09:30.94,0:09:31.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:31.86,0:09:34.53,Default,,0,0,0,,Уау (Ямабуши) Уау! Мен білмей тұрып!
Dialogue: 0,0:09:34.61,0:09:36.53,Default,,0,0,0,,Ол өмір энергиясына толы—
Dialogue: 0,0:09:36.61,0:09:37.99,Default,,0,0,0,,Монта!
Dialogue: 0,0:09:38.07,0:09:39.20,Default,,0,0,0,,Не?
Dialogue: 0,0:09:39.28,0:09:41.74,Default,,0,0,0,,Монта неге артта қалды?
Dialogue: 0,0:09:41.83,0:09:43.20,Default,,0,0,0,,Басталуы ерте болды.
Dialogue: 0,0:09:43.29,0:09:47.92,Default,,0,0,0,,Айсшилд 21 адам жан-жағына қарай ұша бастаған сәт⸺
Dialogue: 0,0:09:48.58,0:09:51.38,Default,,0,0,0,,Ол бос допты қуып алу үшін келе жатыр еді.
Dialogue: 0,0:09:51.46,0:09:53.67,Default,,0,0,0,,Ха ха ха... Мен саған сендім.
Dialogue: 0,0:09:53.75,0:09:56.34,Default,,0,0,0,,Сенна міндетті түрде кедергі жасайды!
Dialogue: 0,0:09:56.42,0:09:59.30,Default,,0,0,0,,Ши... Маған сеніңіз!
Dialogue: 0,0:09:59.39,0:10:03.06,Default,,0,0,0,,Сіз мені оптимистік деп айтуыңыз мүмкін, бірақ бұл дұрыс емес!
Dialogue: 0,0:10:04.35,0:10:05.52,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:10:05.60,0:10:09.98,Default,,0,0,0,,Біз допты Сеннамен және менің комбинациялық ойынмен алдық!
Dialogue: 0,0:10:10.06,0:10:11.44,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:12.02,0:10:13.19,Default,,0,0,0,,Не!?
Dialogue: 0,0:10:13.27,0:10:15.32,Default,,0,0,0,,Сондықтан бұл мүмкін емес
Dialogue: 0,0:10:15.40,0:10:17.40,Default,,0,0,0,,Өйткені мен әуе шайқасындамын
Dialogue: 0,0:10:17.49,0:10:20.16,Default,,0,0,0,,Маймыл, сен ешқашан бірінші болмайсың.
Dialogue: 0,0:10:20.24,0:10:25.37,Default,,0,0,0,,Ей, менікі ерте басталды емес пе?
Dialogue: 0,0:10:25.45,0:10:28.21,Default,,0,0,0,,Жарайды, жарайды, Иккю.
Dialogue: 0,0:10:28.29,0:10:29.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:29.21,0:10:31.00,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:10:31.08,0:10:32.79,Default,,0,0,0,,Фуннура... (Үш ағайынды) А?
Dialogue: 0,0:10:32.88,0:10:35.80,Default,,0,0,0,,Бааааа
Dialogue: 0,0:10:35.88,0:10:37.47,Default,,0,0,0,,Сол кезде мен—
Dialogue: 0,0:10:37.55,0:10:40.80,Default,,0,0,0,,Адамдар жиналған жерде жиналайық!
Dialogue: 0,0:10:40.89,0:10:41.76,Default,,0,0,0,,Hissatsu…
Dialogue: 0,0:10:41.84,0:10:44.35,Default,,0,0,0,,Уууоооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооо(Хилл жын) Каштан балға!
Dialogue: 0,0:10:46.81,0:10:48.68,Default,,0,0,0,,Бұл керемет күш!
Dialogue: 0,0:10:48.77,0:10:52.61,Default,,0,0,0,,Енді доссың ба, дұшпансың ба бәрібір!
Dialogue: 0,0:10:52.69,0:10:54.65,Default,,0,0,0,,Tsk! Бұл...
Dialogue: 0,0:10:54.73,0:10:56.73,Default,,0,0,0,,Геееее (Агон) Хмм
Dialogue: 0,0:10:58.36,0:10:59.20,Default,,0,0,0,,Ммм
Dialogue: 0,0:11:01.82,0:11:02.78,Default,,0,0,0,,Сіңлім!
Dialogue: 0,0:11:02.87,0:11:05.24,Default,,0,0,0,,Ол өмір энергиясына толы—
Dialogue: 0,0:11:05.95,0:11:07.70,Default,,0,0,0,,Pugii…
Dialogue: 0,0:11:07.79,0:11:09.50,Default,,0,0,0,,Джумонжи!
Dialogue: 0,0:11:09.58,0:11:10.66,Default,,0,0,0,,Құқық бұзушыларды өлтіру!
Dialogue: 0,0:11:10.75,0:11:14.46,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:11:15.13,0:11:16.46,Default,,0,0,0,,Ұстадым!
Dialogue: 0,0:11:16.55,0:11:18.26,Default,,0,0,0,,Сенна ұстап алған доп
Dialogue: 0,0:11:18.34,0:11:19.92,Default,,0,0,0,,Джумонджи-кун түсінді!
Dialogue: 0,0:11:20.63,0:11:24.39,Default,,0,0,0,,Мақсат сызығына жалғыз жүгіріңіз!
Dialogue: 0,0:11:24.47,0:11:27.35,Default,,0,0,0,,Уф, жарайды, менің артымнан ешкім келмейді.
Dialogue: 0,0:11:27.43,0:11:28.85,Default,,0,0,0,,Барлығы әлі де қатысады...
Dialogue: 0,0:11:28.93,0:11:30.85,Default,,0,0,0,,«Донэван мырза, сіз мүлде дұрыс айтасыз» де.
Dialogue: 0,0:11:32.90,0:11:34.02,Default,,0,0,0,,Не!?
Dialogue: 0,0:11:34.73,0:11:35.98,Default,,0,0,0,,Бұл Агон-кун!
Dialogue: 0,0:11:36.07,0:11:40.40,Default,,0,0,0,,Сол құлаған позициядан мен сені қуып жетемін!
Dialogue: 0,0:11:40.49,0:11:42.36,Default,,0,0,0,,Джумонжи!
Dialogue: 0,0:11:46.24,0:11:47.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:48.74,0:11:50.54,Default,,0,0,0,,А, жоқ!
Dialogue: 0,0:11:50.62,0:11:54.96,Default,,0,0,0,,Мені соңғы минутта қақпа сызығында тоқтатты!
Dialogue: 0,0:11:57.67,0:12:00.34,Default,,0,0,0,,Қарғыс атсын... ауырады.
Dialogue: 0,0:12:00.88,0:12:04.39,Default,,0,0,0,,Қандай жылдам, қандай күшті!
Dialogue: 0,0:12:05.93,0:12:08.39,Default,,0,0,0,,Сен осылай ұрысып қалдың ба, Сена?
Dialogue: 0,0:12:08.47,0:12:10.22,Default,,0,0,0,,Теме...
Dialogue: 0,0:12:11.93,0:12:13.23,Default,,0,0,0,,Ха…
Dialogue: 0,0:12:13.81,0:12:17.36,Default,,0,0,0,,Біз жай ғана отыра алмаймыз және бұған жол бере алмаймыз.
Dialogue: 0,0:12:17.98,0:12:20.32,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:12:20.40,0:12:23.57,Default,,0,0,0,,Сенна... Темиге ұқсамайды.
Dialogue: 0,0:12:23.65,0:12:26.28,Default,,0,0,0,,Мен аяғымды жаттықтыра бермедім.
Dialogue: 0,0:12:27.49,0:12:28.74,Default,,0,0,0,,Біреуді ұру
Dialogue: 0,0:12:29.54,0:12:31.25,Default,,0,0,0,,Тапсырма
Dialogue: 0,0:12:31.33,0:12:36.21,Default,,0,0,0,,Мен орта мектептен бері көп төбелестім.
Dialogue: 0,0:12:36.29,0:12:38.17,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:38.25,0:12:39.67,Default,,0,0,0,,Сен қорқасың бейбақ!
Dialogue: 0,0:12:40.96,0:12:44.63,Default,,0,0,0,,Мен сізге соңғы қадамды орындауға рұқсат етемін!
Dialogue: 0,0:12:44.72,0:12:46.14,Default,,0,0,0,,Ах
Dialogue: 0,0:12:54.27,0:12:55.64,Default,,0,0,0,,
Dialogue: 0,0:12:55.73,0:12:58.15,Default,,0,0,0,,Та... түртіңіз!
Dialogue: 0,0:12:58.23,0:13:01.15,Default,,0,0,0,,Хааа~
Dialogue: 0,0:13:01.23,0:13:04.11,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:04.20,0:13:06.07,Default,,0,0,0,,Джумонджи-кунның тиюі
Dialogue: 0,0:13:06.16,0:13:08.24,Default,,0,0,0,,Мүмкін бұл бірінші рет болуы мүмкін бе?
Dialogue: 0,0:13:08.32,0:13:11.58,Default,,0,0,0,,Негізі, мен ресми ойында бірінші рет допты ұстадым!
Dialogue: 0,0:13:11.66,0:13:12.95,Default,,0,0,0,,Рико-чан Рико-чан!
Dialogue: 0,0:13:13.04,0:13:14.12,Default,,0,0,0,,Ха! Ах...
Dialogue: 0,0:13:14.21,0:13:15.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:16.08,0:13:18.92,Default,,0,0,0,,Джумонджи-кун әдетте допқа тимейтін күйде.
Dialogue: 0,0:13:19.00,0:13:22.42,Default,,0,0,0,,Төзімділікке қол жеткізу керемет! Өтінемін
Dialogue: 0,0:13:22.51,0:13:24.59,Default,,0,0,0,,О, а... иә.
Dialogue: 0,0:13:24.67,0:13:27.09,Default,,0,0,0,,Деймон Ібіліс жарғанақтары, шынында да біртұтас!
Dialogue: 0,0:13:27.18,0:13:28.72,Default,,0,0,0,,Эй, сен істедің!
Dialogue: 0,0:13:28.80,0:13:30.51,Default,,0,0,0,,Керемет, Макс!
Dialogue: 0,0:13:30.60,0:13:31.68,Default,,0,0,0,,Яру Фуго!
Dialogue: 0,0:13:31.76,0:13:33.56,Default,,0,0,0,,Кадзу-чан ең жақсы!
Dialogue: 0,0:13:33.64,0:13:34.48,Default,,0,0,0,,Ахаха
Dialogue: 0,0:13:35.23,0:13:37.06,Default,,0,0,0,,Жеке күшпен итерілген болса да
Dialogue: 0,0:13:37.14,0:13:39.44,Default,,0,0,0,,Бұл бәріміздің қолымыздан келген ізденіс нүктесі!
Dialogue: 0,0:13:40.06,0:13:43.65,Default,,0,0,0,,Деймон Ібіліс Жарғанаттар Үмітсіз жағдайдан 32-0
Dialogue: 0,0:13:44.40,0:13:48.86,Default,,0,0,0,,Олар мені 32-14-ке дейін қуып жіберді!
Dialogue: 0,0:13:48.95,0:13:50.41,Default,,0,0,0,,Сәлем Сена
Dialogue: 0,0:13:51.74,0:13:54.70,Default,,0,0,0,,Біз бәріміз қоқыс пен басқа нәрселерге ашуланамыз.
Dialogue: 0,0:13:54.79,0:13:56.16,Default,,0,0,0,,Сол қорқынышты бастың үстінде
Dialogue: 0,0:13:56.25,0:13:58.21,Default,,0,0,0,,Жоғалтып алмаңыз!
Dialogue: 0,0:14:00.21,0:14:01.25,Default,,0,0,0,,Иә
Dialogue: 0,0:14:02.88,0:14:04.30,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:14:05.63,0:14:08.26,Default,,0,0,0,,Жаман... Менің аяғым...
Dialogue: 0,0:14:09.68,0:14:11.22,Default,,0,0,0,,Кү…
Dialogue: 0,0:14:12.56,0:14:16.14,Default,,0,0,0,,Енді... қуып жетуге мүмкіндік бар.
Dialogue: 0,0:14:16.23,0:14:17.18,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:14:18.64,0:14:20.73,Default,,0,0,0,,Сена, не болды?
Dialogue: 0,0:14:20.81,0:14:21.69,Default,,0,0,0,,Хмм
Dialogue: 0,0:14:22.52,0:14:25.11,Default,,0,0,0,,Жоқ... сен
Dialogue: 0,0:14:25.19,0:14:28.65,Default,,0,0,0,,Үзіліске баруды ұмыттыңыз ба?
Dialogue: 0,0:14:28.74,0:14:30.20,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ...
Dialogue: 0,0:14:30.28,0:14:31.12,Default,,0,0,0,,​​О?
Dialogue: 0,0:14:32.62,0:14:34.08,Default,,0,0,0,,Бұл аяқ...
Dialogue: 0,0:14:36.37,0:14:38.04,Default,,0,0,0,,Уақыт бітті
Dialogue: 0,0:14:38.75,0:14:41.54,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:14:50.09,0:14:51.93,Default,,0,0,0,,Буындарда қатты қызба
Dialogue: 0,0:14:52.64,0:14:54.51,Default,,0,0,0,,Бұл мен күткеннен жылдамырақ болды.
Dialogue: 0,0:14:54.60,0:14:58.02,Default,,0,0,0,,Ауырса да, осыдан кейін Шинрюджиге тағы бір шабуыл болады.
Dialogue: 0,0:14:58.10,0:14:59.39,Default,,0,0,0,,Тіпті бір ұпай алынса
Dialogue: 0,0:15:00.64,0:15:01.85,Default,,0,0,0,,Ойын аяқталады
Dialogue: 0,0:15:01.94,0:15:03.65,Default,,0,0,0,,(Оқушылар) Э-э… Мүмкін емес! Мүмкін емес!
Dialogue: 0,0:15:03.73,0:15:04.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:05.02,0:15:05.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:06.82,0:15:09.11,Default,,0,0,0,,Егер мен осы қарғыс атқыр кішкентай нәрсені дәл осы жерде және қазір тартсам.
Dialogue: 0,0:15:09.19,0:15:12.07,Default,,0,0,0,,Агонды ешкім тоқтата алмайды.
Dialogue: 0,0:15:12.16,0:15:14.16,Default,,0,0,0,,Төбе жын!
Dialogue: 0,0:15:14.24,0:15:17.95,Default,,0,0,0,,Жоқ... Иә, білемін.
Dialogue: 0,0:15:18.41,0:15:21.00,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:15:21.08,0:15:22.58,Default,,0,0,0,,Хаха...
Dialogue: 0,0:15:34.60,0:15:36.93,Default,,0,0,0,,Қандай тыныш өлтіру ниеті!
Dialogue: 0,0:15:37.01,0:15:41.48,Default,,0,0,0,,Агон үшін біздің күшіміз жол бойындағы жәндіктерден басқа ештеңе емес.
Dialogue: 0,0:15:42.10,0:15:43.90,Default,,0,0,0,,Оның көзінде, қазір⸺
Dialogue: 0,0:15:44.65,0:15:46.86,Default,,0,0,0,,Тек Сена Кобаякава көрсетілген
Dialogue: 0,0:15:46.94,0:15:52.36,Default,,0,0,0,,Өткен жылдан бері, Мистер Аго бірінші курс студенті кезінде Сусумумен төбелескеннен бері көздер бұрынғыдай емес.
Dialogue: 0,0:15:52.45,0:15:53.91,Default,,0,0,0,,Енді Л тергеу мәліметтерінің маған тарағанын түсінгеннен кейін,
Dialogue: 0,0:15:54.82,0:15:55.82,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:15:56.91,0:16:00.75,Default,,0,0,0,,Сізге тек көзіңізде не бейнеленгенін көру керек.
Dialogue: 0,0:16:02.04,0:16:05.04,Default,,0,0,0,,Сіздің зорлық-зомбылық күшіңіз
Dialogue: 0,0:16:05.13,0:16:08.00,Default,,0,0,0,,Артта қалған орта таланттарға қарап
Dialogue: 0,0:16:08.09,0:16:09.80,Default,,0,0,0,,ешқашан туылмаған
Dialogue: 0,0:16:09.88,0:16:13.22,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:14.13,0:16:17.18,Default,,0,0,0,,Добуроку арнайы тез салқындатылған глазурь қарын орамасы
Dialogue: 0,0:16:18.01,0:16:21.81,Default,,0,0,0,,Мұны салқындату және байламдардың созылуын қиындату үшін пайдаланыңыз.
Dialogue: 0,0:16:22.43,0:16:24.40,Default,,0,0,0,,Бұл жеңілдетеді, бірақ оны мүлдем істемегеннен жақсы.
Dialogue: 0,0:16:25.60,0:16:26.90,Default,,0,0,0,,Әй, керемет
Dialogue: 0,0:16:27.73,0:16:29.48,Default,,0,0,0,,Кенет жеңілдей түсті
Dialogue: 0,0:16:29.57,0:16:31.57,Default,,0,0,0,,Сауықты, Макс!
Dialogue: 0,0:16:31.65,0:16:33.86,Default,,0,0,0,,Бұл шынымен қалпына келтірудің керемет сиқыры!
Dialogue: 0,0:16:33.95,0:16:35.70,Default,,0,0,0,,Ақымақ.
Dialogue: 0,0:16:35.78,0:16:39.87,Default,,0,0,0,,Бұл суық ауа ауруды уақытша ғана парализациялайды.
Dialogue: 0,0:16:40.54,0:16:42.96,Default,,0,0,0,,Салқындату күту уақыты қандай?
Dialogue: 0,0:16:43.04,0:16:45.33,Default,,0,0,0,,Екінші тайм Тағы екі эпизод қалды
Dialogue: 0,0:16:45.75,0:16:47.96,Default,,0,0,0,,Ол мәңгілікке жалғасады...
Dialogue: 0,0:16:48.04,0:16:50.92,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:51.00,0:16:52.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:58.60,0:16:59.85,Default,,0,0,0,,Мен тоқтағым келеді...
Dialogue: 0,0:16:59.93,0:17:01.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:03.98,0:17:06.56,Default,,0,0,0,,Сена... өтінемін
Dialogue: 0,0:17:09.69,0:17:11.82,Default,,0,0,0,,Мамори-неечан...
Dialogue: 0,0:17:13.44,0:17:14.28,Default,,0,0,0,,Сенна!
Dialogue: 0,0:17:14.36,0:17:15.74,Default,,0,0,0,,Ах
Dialogue: 0,0:17:17.66,0:17:18.95,Default,,0,0,0,,Демді ішке тартып тамашалаңыздар
Dialogue: 0,0:17:19.91,0:17:20.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:23.04,0:17:24.16,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:26.12,0:17:27.67,Default,,0,0,0,,Ол қалай шығады? балшық қақпасы
Dialogue: 0,0:17:28.75,0:17:32.21,Default,,0,0,0,,Бұл әлгі сүлгі шайтан болғандықтан, ол бір айла ойлап тапса да...
Dialogue: 0,0:17:32.21,0:17:33.38,Default,,0,0,0,,Бұл әлгі сүлгі шайтан болғандықтан, ол бір айла ойлап тапса да...
Dialogue: 0,0:17:32.21,0:17:33.38,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:33.46,0:17:34.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:34.55,0:17:37.63,Default,,0,0,0,,Оны Инелікпен толығымен жойған дұрыс болар еді.
Dialogue: 0,0:17:38.89,0:17:41.85,Default,,0,0,0,,Жарайды, Инелікпен барайық.
Dialogue: 0,0:17:41.93,0:17:45.27,Default,,0,0,0,,Ұшып бара жатқан көз қалқаны демалмауы үшін
Dialogue: 0,0:17:46.02,0:17:47.94,Default,,0,0,0,,Орнату!
Dialogue: 0,0:17:48.69,0:17:50.40,Default,,0,0,0,,Бұл тағы да Инелік.
Dialogue: 0,0:17:50.48,0:17:53.40,Default,,0,0,0,,Сіз соңғы соққыны жасаймын дейсіз бе?
Dialogue: 0,0:17:56.61,0:17:59.28,Default,,0,0,0,,Агон мұны мойындады.
Dialogue: 0,0:17:59.70,0:18:00.53,Default,,0,0,0,,Шляпа!
Dialogue: 0,0:18:03.87,0:18:04.95,Default,,0,0,0,,Сена Кобаякава
Dialogue: 0,0:18:07.16,0:18:12.25,Default,,0,0,0,,Сіз үздік ойыншылар әлеміне бір қадам жасадыңыз!
Dialogue: 0,0:18:13.00,0:18:15.88,Default,,0,0,0,,Бірақ сен ең күштісің, Агон!
Dialogue: 0,0:18:15.96,0:18:18.47,Default,,0,0,0,,Мен сені міндетті түрде ең күшті етемін
Dialogue: 0,0:18:18.55,0:18:20.51,Default,,0,0,0,,Мына инелікпен!
Dialogue: 0,0:18:25.47,0:18:26.31,Default,,0,0,0,,Демді ішке тартып тамашалаңыздар
Dialogue: 0,0:18:26.39,0:18:27.77,Default,,0,0,0,,Жеңіске жет!
Dialogue: 0,0:18:29.81,0:18:30.94,Default,,0,0,0,,Келе жатыр!
Dialogue: 0,0:18:31.02,0:18:32.44,Default,,0,0,0,,Қиындық!
Dialogue: 0,0:18:32.52,0:18:33.82,Default,,0,0,0,,Әй!
Dialogue: 0,0:18:33.90,0:18:34.90,Default,,0,0,0,,Уф
Dialogue: 0,0:18:34.98,0:18:38.90,Default,,0,0,0,,Уф... Уау.
Dialogue: 0,0:18:38.99,0:18:40.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:40.91,0:18:42.57,Default,,0,0,0,,Я...
Dialogue: 0,0:18:42.66,0:18:43.83,Default,,0,0,0,,
Dialogue: 0,0:18:43.91,0:18:45.83,Default,,0,0,0,,Ago-kun, жай ғана кіріңіз⸺
Dialogue: 0,0:18:45.91,0:18:47.29,Default,,0,0,0,,7 ярд алға!
Dialogue: 0,0:18:47.37,0:18:49.04,Default,,0,0,0,,Сеннаның бейбақ...
Dialogue: 0,0:18:49.12,0:18:52.88,Default,,0,0,0,,Ол бірден сол Агон қылышын қолымен жауып тастады!
Dialogue: 0,0:18:52.96,0:18:55.75,Default,,0,0,0,,Иә! Бірақ бүкіл күзетші есін жиды.
Dialogue: 0,0:18:55.84,0:18:58.72,Default,,0,0,0,,Уау (Монта) Бұл керемет, Макс!
Dialogue: 0,0:18:58.80,0:19:00.47,Default,,0,0,0,,Сен істедің, Сена!
Dialogue: 0,0:19:00.55,0:19:01.51,Default,,0,0,0,,Гюго!
Dialogue: 0,0:19:01.59,0:19:03.68,Default,,0,0,0,,Мен таң қалдым, бірақ
Dialogue: 0,0:19:03.76,0:19:07.02,Default,,0,0,0,,Қол техникасын қолмен қалай бөгеуге болады?
Dialogue: 0,0:19:07.10,0:19:09.98,Default,,0,0,0,,Жекпе-жек өнерінің таңғажайып шайқасын қараңыз.
Dialogue: 0,0:19:10.06,0:19:13.40,Default,,0,0,0,,Жоқ, бұл таңқаларлық емес.
Dialogue: 0,0:19:13.48,0:19:16.53,Default,,0,0,0,,Мен жаңа ғана Аго-санның қимылын бақылап отырдым.
Dialogue: 0,0:19:16.61,0:19:18.36,Default,,0,0,0,,Себебі мен үнемі ауырғым келмейді
Dialogue: 0,0:19:18.44,0:19:20.90,Default,,0,0,0,,Менің қолым әйтеуір тұрып қалды.
Dialogue: 0,0:19:20.99,0:19:22.91,Default,,0,0,0,,Бірақ бұл керемет!
Dialogue: 0,0:19:24.03,0:19:24.87,Default,,0,0,0,,Хмф!
Dialogue: 0,0:19:26.74,0:19:28.83,Default,,0,0,0,,Жарайсыңдар, кішкентай бәйбішелер.
Dialogue: 0,0:19:29.75,0:19:31.83,Default,,0,0,0,,Берілме!
Dialogue: 0,0:19:33.17,0:19:35.54,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:19:37.42,0:19:42.43,Default,,0,0,0,,♪~
Dialogue: 0,0:20:47.37,0:20:52.37,Default,,0,0,0,,~♪
Dialogue: 0,0:20:53.29,0:20:55.79,Default,,0,0,0,,Эй, Сеннаның аяқтары шегінде.
Dialogue: 0,0:20:55.87,0:20:59.34,Default,,0,0,0,,Қарғыс атқыр маймыл! Бұл жолы Теми бірдеңе істеуі керек.
Dialogue: 0,0:20:59.42,0:21:00.67,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:21:01.21,0:21:03.97,Default,,0,0,0,,Не болса да, Иккю-сенпайды жеңуім керек!
Dialogue: 0,0:21:04.05,0:21:05.97,Default,,0,0,0,,Ол өмір энергиясына толы—
Dialogue: 0,0:21:06.05,0:21:08.43,Default,,0,0,0,,Келесі жолы «Көз қалқаны 21»
Dialogue: 0,0:21:08.51,0:21:10.72,Default,,0,0,0,,«Бірінші болу»
Dialogue: 0,0:21:10.81,0:21:12.39,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:21:13.89,0:21:19.89,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
