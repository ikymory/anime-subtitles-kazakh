Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.13,0:00:08.25,Default,,0,0,0,,Бұрын
Dialogue: 0,0:00:08.34,0:00:10.92,Default,,0,0,0,,Сусуму-сан тоқтатты. Бұл шайтанның елесі емес!
Dialogue: 0,0:00:11.59,0:00:13.68,Default,,0,0,0,,Кел, Айсшилд 21!
Dialogue: 0,0:00:18.93,0:00:20.85,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:00:20.93,0:00:24.60,Default,,0,0,0,,Уф, Ібіліс жарғанатының елес қадамдары
Dialogue: 0,0:00:28.94,0:00:31.57,Default,,0,0,0,,Nuuuuu...
Dialogue: 0,0:00:31.65,0:00:33.36,Default,,0,0,0,,Бұл... тез!
Dialogue: 0,0:00:39.37,0:00:41.66,Default,,0,0,0,,Гах... Аһ...
Dialogue: 0,0:00:42.54,0:00:44.62,Default,,0,0,0,,Ук ку ух... аа
Dialogue: 0,0:00:45.54,0:00:49.09,Default,,0,0,0,,Devil Bat Ghost іске қосылмас бұрын.
Dialogue: 0,0:00:49.17,0:00:52.09,Default,,0,0,0,,Үшаяқ сынды!
Dialogue: 0,0:00:52.92,0:00:55.51,Default,,0,0,0,,Бұл Сусумуның күші...
Dialogue: 0,0:00:55.59,0:00:56.80,Default,,0,0,0,,Ha
Dialogue: 0,0:01:00.31,0:01:01.68,Default,,0,0,0,,Өте жаман
Dialogue: 0,0:01:01.77,0:01:04.18,Default,,0,0,0,,Доймон бірінші төмен түскенше 3 ярд қалды
Dialogue: 0,0:01:04.27,0:01:07.15,Default,,0,0,0,,Бірақ қамалдың алынбайтын қорғанысы алдында
Dialogue: 0,0:01:07.23,0:01:11.69,Default,,0,0,0,,Бұл үш аула енді алыста көрінеді!
Dialogue: 0,0:01:11.78,0:01:13.19,Default,,0,0,0,,Қарғыс атсын... (шу)
Dialogue: 0,0:01:13.28,0:01:14.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:19.28,0:01:20.12,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:23.20,0:01:27.08,Default,,0,0,0,,(көліктің жүгіру дыбысы)
Dialogue: 0,0:01:36.05,0:01:40.97,Default,,0,0,0,,♪~
Dialogue: 0,0:02:55.55,0:03:00.88,Default,,0,0,0,,~♪
Dialogue: 0,0:03:07.93,0:03:09.23,Default,,0,0,0,,Ммм... Деймон
Dialogue: 0,0:03:09.31,0:03:11.73,Default,,0,0,0,,Егер сіз мұнда бірінші бола алмасаңыз
Dialogue: 0,0:03:11.81,0:03:14.06,Default,,0,0,0,,Шабуыл жасау құқығын король сарайы тартып алды, бірақ
Dialogue: 0,0:03:14.15,0:03:19.03,Default,,0,0,0,,Сіз қазіргі Оджоға қарсы қалған үш ярдты басып өту қиын болады деп ойладыңыз ба?
Dialogue: 0,0:03:19.11,0:03:21.57,Default,,0,0,0,,Құмар ойындарсыз соңғы мүмкіндігіңізді пайдаланыңыз
Dialogue: 0,0:03:21.65,0:03:23.24,Default,,0,0,0,,Тепкіш Мусашиді шығарыңыз
Dialogue: 0,0:03:23.32,0:03:25.24,Default,,0,0,0,,Пант-кикке ауысқан сияқтысыз.
Dialogue: 0,0:03:25.33,0:03:27.79,Default,,0,0,0,,Пунт немесе бәрібір⸺
Dialogue: 0,0:03:27.87,0:03:31.00,Default,,0,0,0,,Бұл соққы. Сен тепкенше мен сені жаншып аламын.
Dialogue: 0,0:03:37.30,0:03:38.21,Default,,0,0,0,,Хмм
Dialogue: 0,0:03:38.30,0:03:40.72,Default,,0,0,0,,Орнату! Қалпақ қалпақ!
Dialogue: 0,0:03:41.30,0:03:42.51,Default,,0,0,0,,Хмм
Dialogue: 0,0:03:45.89,0:03:47.76,Default,,0,0,0,,Осы қашықтықта
Dialogue: 0,0:03:49.85,0:03:51.60,Default,,0,0,0,,Тебу алдында жаншылады
Dialogue: 0,0:03:54.94,0:03:55.77,Default,,0,0,0,,Не!?
Dialogue: 0,0:03:57.32,0:03:58.52,Default,,0,0,0,,Хун
Dialogue: 0,0:03:59.53,0:04:00.36,Default,,0,0,0,,Тұзақ!
Dialogue: 0,0:04:02.53,0:04:03.91,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:04.53,0:04:05.91,Default,,0,0,0,,Кет, кішкентайым!
Dialogue: 0,0:04:05.99,0:04:07.87,Default,,0,0,0,,Жарайды, келесі жолы.
Dialogue: 0,0:04:07.95,0:04:10.91,Default,,0,0,0,,Мен тебуді жем ретінде пайдаланып, құмар ойынға баруға батылдық жасадым.
Dialogue: 0,0:04:11.00,0:04:12.46,Default,,0,0,0,,Сенна!
Dialogue: 0,0:04:12.54,0:04:13.37,Default,,0,0,0,,Жүр!
Dialogue: 0,0:04:15.08,0:04:17.79,Default,,0,0,0,,Біразырақ. Бірінші рет дерлік
Dialogue: 0,0:04:17.88,0:04:18.88,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:18.96,0:04:19.80,Default,,0,0,0,,Ах
Dialogue: 0,0:04:22.30,0:04:24.68,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:04:24.76,0:04:27.14,Default,,0,0,0,,Ораора Ораора Ораора…
Dialogue: 0,0:04:27.22,0:04:28.72,Default,,0,0,0,,Взвод мүшелерінің бір-бірімен шайқасуына болмайды!
Dialogue: 0,0:04:28.81,0:04:30.72,Default,,0,0,0,,О! О, жоқ!
Dialogue: 0,0:04:31.35,0:04:32.68,Default,,0,0,0,,Уф... д...
Dialogue: 0,0:04:32.77,0:04:33.73,Default,,0,0,0,,Сенна!
Dialogue: 0,0:04:36.02,0:04:37.69,Default,,0,0,0,,
Dialogue: 0,0:04:37.77,0:04:39.57,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:39.65,0:04:40.65,Default,,0,0,0,,Уау! иә?
Dialogue: 0,0:04:40.73,0:04:43.28,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:43.36,0:04:44.74,Default,,0,0,0,,Ах (Таками) Күте тұрыңыз, Игари!
Dialogue: 0,0:04:44.82,0:04:46.66,Default,,0,0,0,,Мен сенің ойнауды тоқтатқаныңды байқамадым!
Dialogue: 0,0:04:46.74,0:04:49.12,Default,,0,0,0,,Ах, а...хии
Dialogue: 0,0:04:53.04,0:04:56.42,Default,,0,0,0,,Уф, пьеса тоқтады деп ойлаймын!
Dialogue: 0,0:04:56.50,0:04:59.38,Default,,0,0,0,,Ора доп!
Dialogue: 0,0:04:59.46,0:05:01.34,Default,,0,0,0,,Не... бұл не?
Dialogue: 0,0:05:01.42,0:05:03.80,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:03.88,0:05:05.17,Default,,0,0,0,,Ой... о (джумонджи) Иә?
Dialogue: 0,0:05:05.26,0:05:06.88,Default,,0,0,0,,Ах
Dialogue: 0,0:05:06.97,0:05:10.35,Default,,0,0,0,,Ва~хахаха Міне, Игари
Dialogue: 0,0:05:06.97,0:05:10.35,Default,,0,0,0,,(Игаридің ыңырсыуы)
Dialogue: 0,0:05:10.35,0:05:10.97,Default,,0,0,0,,(Игаридің ыңырсыуы)
Dialogue: 0,0:05:10.97,0:05:11.97,Default,,0,0,0,,(Игаридің ыңырсыуы)
Dialogue: 0,0:05:10.97,0:05:11.97,Default,,0,0,0,,Кешіріңіз, бұл жігіт айналаны көре алмайды.
Dialogue: 0,0:05:11.97,0:05:13.52,Default,,0,0,0,,Кешіріңіз, бұл жігіт айналаны көре алмайды.
Dialogue: 0,0:05:13.60,0:05:15.56,Default,,0,0,0,,Ми – бұлшық ет.
Dialogue: 0,0:05:15.64,0:05:19.52,Default,,0,0,0,,Деймон жеңіліске ұшыраса да, бірінші орынға ие болды
Dialogue: 0,0:05:20.15,0:05:23.78,Default,,0,0,0,,Менің қолым ұйып қалды
Dialogue: 0,0:05:24.32,0:05:25.78,Default,,0,0,0,,Бірақ Рико-чан
Dialogue: 0,0:05:25.86,0:05:28.87,Default,,0,0,0,,Оджо сызығында керемет ойыншы пайда болды.
Dialogue: 0,0:05:28.95,0:05:30.70,Default,,0,0,0,,Ал... болды.
Dialogue: 0,0:05:31.33,0:05:35.75,Default,,0,0,0,,Бұл ойын Икаридің 66 нөмірімен бірінші рет шығуы.
Dialogue: 0,0:05:35.83,0:05:38.67,Default,,0,0,0,,Қуат пен жылдамдықты біріктіретін міндетті түрде көруге болатын қор
Dialogue: 0,0:05:38.75,0:05:40.84,Default,,0,0,0,,А... қабан аулау ма?
Dialogue: 0,0:05:41.71,0:05:45.38,Default,,0,0,0,,«Түрмедегі» қабан аулап жүр ме?
Dialogue: 0,0:05:45.47,0:05:46.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:46.38,0:05:47.63,Default,,0,0,0,,Түрме тізбегі?
Dialogue: 0,0:05:48.26,0:05:50.76,Default,,0,0,0,,Мен орта мектепте оқып жүргенімде туған жерімде атақты болдым.
Dialogue: 0,0:05:50.85,0:05:53.85,Default,,0,0,0,,Түрмеде өте күшті жігіт бар.
Dialogue: 0,0:05:53.93,0:05:57.31,Default,,0,0,0,,Хахахаха Жарайды, жақсы, Игари
Dialogue: 0,0:05:53.93,0:05:57.31,Default,,0,0,0,,Шынжырлар әрқашан шырылдап, бірден үзіледі.
Dialogue: 0,0:05:57.31,0:05:57.39,Default,,0,0,0,,Шынжырлар әрқашан шырылдап, бірден үзіледі.
Dialogue: 0,0:05:57.39,0:05:57.64,Default,,0,0,0,,Шынжырлар әрқашан шырылдап, тез үзіледі.
Dialogue: 0,0:05:57.39,0:05:57.64,Default,,0,0,0,,Олар Суттоны ертіп әкелді.
Dialogue: 0,0:05:57.64,0:05:57.73,Default,,0,0,0,,Олар Суттоны ертіп әкелді.
Dialogue: 0,0:05:57.73,0:05:59.35,Default,,0,0,0,,Олар Суттоны ертіп әкелді.
Dialogue: 0,0:05:57.73,0:05:59.35,Default,,0,0,0,,Барлығы қорқып кетті
Dialogue: 0,0:05:59.44,0:06:00.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:00.61,0:06:03.69,Default,,0,0,0,,Неліктен мұндай жексұрын қылмыскерлер американдық футбол ойнайды?
Dialogue: 0,0:06:03.78,0:06:06.36,Default,,0,0,0,,Мен неге жаман адамдар американдық футбол ойнайтынын түсінбеймін.
Dialogue: 0,0:06:06.44,0:06:07.90,Default,,0,0,0,,Жоқ, сіз адамдар туралы айта алмайсыз.
Dialogue: 0,0:06:07.99,0:06:09.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:13.83,0:06:15.66,Default,,0,0,0,,Мен бұл түрме тізбегі болады деп ойламадым.
Dialogue: 0,0:06:15.75,0:06:17.54,Default,,0,0,0,,Осындай жерде кездесу
Dialogue: 0,0:06:18.33,0:06:21.54,Default,,0,0,0,,Джумонжи Ол...
Dialogue: 0,0:06:21.63,0:06:25.51,Default,,0,0,0,,Игари, сен Джумонджиді мұқият белгілеу керек.
Dialogue: 0,0:06:25.59,0:06:27.59,Default,,0,0,0,,Қабақты Сусумуға қалдырыңыз.
Dialogue: 0,0:06:27.67,0:06:29.51,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:06:32.05,0:06:35.93,Default,,0,0,0,,Қабан аңшы ақыры затқа айналды.
Dialogue: 0,0:06:36.02,0:06:38.10,Default,,0,0,0,,Иә, мен қазір Ojo White Knights тобының мүшесімін.
Dialogue: 0,0:06:38.10,0:06:39.98,Default,,0,0,0,,Иә, мен қазір Ojo White Knights тобының мүшесімін.
Dialogue: 0,0:06:38.10,0:06:39.98,Default,,0,0,0,,Жүр, қағып-қағып алайық.
Dialogue: 0,0:06:39.98,0:06:40.06,Default,,0,0,0,,Иә, мен қазір Ojo White Knights тобының мүшесімін.
Dialogue: 0,0:06:40.06,0:06:41.02,Default,,0,0,0,,Иә, мен қазір Ojo White Knights тобының мүшесімін.
Dialogue: 0,0:06:40.06,0:06:41.02,Default,,0,0,0,,Үйсу
Dialogue: 0,0:06:41.65,0:06:47.44,Default,,0,0,0,,Иә, ол орта мектепте ұстанбайтын, қатыгез жігіт болатын.
Dialogue: 0,0:06:48.49,0:06:50.74,Default,,0,0,0,,Ке... Оджу не болды?
Dialogue: 0,0:06:50.82,0:06:53.37,Default,,0,0,0,,Бұл монахтарға арналған сыпайы мектеп емес пе?
Dialogue: 0,0:06:53.45,0:06:55.41,Default,,0,0,0,,Патша сарайындағы қоқыс қайда?
Dialogue: 0,0:06:55.49,0:06:57.08,Default,,0,0,0,,О! Уф
Dialogue: 0,0:06:57.16,0:06:58.70,Default,,0,0,0,,О! Апыр-ай!
Dialogue: 0,0:06:58.79,0:07:00.87,Default,,0,0,0,,О! О, жоқ!
Dialogue: 0,0:07:00.96,0:07:03.17,Default,,0,0,0,,Мені қоқыс деп атама
Dialogue: 0,0:07:03.25,0:07:04.84,Default,,0,0,0,,Не... сен кімсің?
Dialogue: 0,0:07:05.46,0:07:09.09,Default,,0,0,0,,Мен патша сарайын мазақ еткен адамды кешірмеймін.
Dialogue: 0,0:07:09.17,0:07:10.30,Default,,0,0,0,,Gyaa!
Dialogue: 0,0:07:11.80,0:07:14.30,Default,,0,0,0,,Уф~ Мен жедім мен жедім
Dialogue: 0,0:07:14.39,0:07:17.47,Default,,0,0,0,,60 порция гиоза тым көп.
Dialogue: 0,0:07:17.56,0:07:19.48,Default,,0,0,0,,Оджода тәбетіңіз жақсы.
Dialogue: 0,0:07:19.56,0:07:24.02,Default,,0,0,0,,Га~хахаха мен номер бірінші Ожо ақымақ жегішпін!
Dialogue: 0,0:07:24.11,0:07:27.48,Default,,0,0,0,,Хмм... Ожо? ақымақ? Нууууу...
Dialogue: 0,0:07:28.28,0:07:32.03,Default,,0,0,0,,О! Король сарайының несі соншалықты ақымақтық?
Dialogue: 0,0:07:32.11,0:07:32.95,Default,,0,0,0,,​​О?
Dialogue: 0,0:07:33.03,0:07:35.91,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:36.62,0:07:37.79,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:37.87,0:07:39.58,Default,,0,0,0,,Біз қауіпсіз жердеміз, сондықтан…
Dialogue: 0,0:07:39.66,0:07:42.04,Default,,0,0,0,,Гууууууууууу!
Dialogue: 0,0:07:42.12,0:07:46.75,Default,,0,0,0,,Хохо, бұл жақсы соққы және оның жылдамдығы да бар.
Dialogue: 0,0:07:46.84,0:07:48.50,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:49.13,0:07:49.96,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:50.05,0:07:52.63,Default,,0,0,0,,Бірақ ұрыс-керіс жоқ.
Dialogue: 0,0:07:52.72,0:07:56.22,Default,,0,0,0,,Егер сіз сондай қатыгез болғыңыз келсе, американдық футбол ойнаңыз!
Dialogue: 0,0:07:56.30,0:07:57.64,Default,,0,0,0,,Америка футболы?
Dialogue: 0,0:07:57.72,0:08:00.68,Default,,0,0,0,,Гах ха ха Америка футболы жақсы.
Dialogue: 0,0:08:00.77,0:08:02.60,Default,,0,0,0,,Сіз далада жабайы жүре аласыз
Dialogue: 0,0:08:02.69,0:08:06.61,Default,,0,0,0,,Оның үстіне сіз қаншалықты қатыгез болсаңыз, достарыңыз соғұрлым бақытты болады.
Dialogue: 0,0:08:06.69,0:08:10.15,Default,,0,0,0,,Ахахха... Әйтеуір сәл басқаша.
Dialogue: 0,0:08:10.23,0:08:16.12,Default,,0,0,0,,Ал Игари Ojo White Knights ойыншысы болды.
Dialogue: 0,0:08:17.62,0:08:21.16,Default,,0,0,0,,Игариге айналасындағылар тек қатыгез қылмыскер ретінде қарады.
Dialogue: 0,0:08:21.25,0:08:23.83,Default,,0,0,0,,Мен оны алғаш рет Отаварада таныдым.
Dialogue: 0,0:08:23.92,0:08:25.50,Default,,0,0,0,,Хехе
Dialogue: 0,0:08:25.58,0:08:26.63,Default,,0,0,0,,Сенпай Отавара
Dialogue: 0,0:08:26.71,0:08:27.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:27.63,0:08:32.80,Default,,0,0,0,,Мені американдық футболға бағыттағаны үшін Отавара-сенпайға алғыс айтамын.
Dialogue: 0,0:08:32.88,0:08:35.93,Default,,0,0,0,,Бұл сізді американдық футболға жетеледі ме? Осындай нәрсе болды ма?
Dialogue: 0,0:08:36.01,0:08:38.51,Default,,0,0,0,,Міне! Ал мен...
Dialogue: 0,0:08:39.97,0:08:42.52,Default,,0,0,0,,Мен патша сарайы үшін өз өмірімді қатерге тігемін.
Dialogue: 0,0:08:45.14,0:08:45.98,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:46.06,0:08:49.94,Default,,0,0,0,,Ал, егжей-тегжейге алаңдамай, жабайы жүр!
Dialogue: 0,0:08:50.02,0:08:50.94,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:51.03,0:08:55.07,Default,,0,0,0,,Хмм, оны Отавараға қалдыру дұрыс шешім болды.
Dialogue: 0,0:08:55.15,0:08:56.03,Default,,0,0,0,,Иә
Dialogue: 0,0:08:56.11,0:08:57.82,Default,,0,0,0,,Орнату!
Dialogue: 0,0:08:57.91,0:09:00.28,Default,,0,0,0,,Қарғыс атсын... Мен де.
Dialogue: 0,0:09:01.16,0:09:03.33,Default,,0,0,0,,Мен бұрынғыдай емеспін.
Dialogue: 0,0:09:03.41,0:09:04.25,Default,,0,0,0,,Шляпа!
Dialogue: 0,0:09:05.67,0:09:07.79,Default,,0,0,0,,Күрессең жеңіліске болмайды!
Dialogue: 0,0:09:07.88,0:09:09.54,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:09:09.63,0:09:12.30,Default,,0,0,0,,Менде патша сарайы мен Отавара-сенпай бар.
Dialogue: 0,0:09:12.38,0:09:15.26,Default,,0,0,0,,Мен сені міндетті түрде Рождестволық ыдысқа апарамын!
Dialogue: 0,0:09:15.34,0:09:16.22,Default,,0,0,0,,Уф
Dialogue: 0,0:09:16.30,0:09:19.22,Default,,0,0,0,,Ораора Ораора Ораора…
Dialogue: 0,0:09:19.30,0:09:20.89,Default,,0,0,0,,Уф
Dialogue: 0,0:09:20.97,0:09:23.27,Default,,0,0,0,,О! (Джумонжи) Ууууууууууууууууууууууу
Dialogue: 0,0:09:23.35,0:09:24.56,Default,,0,0,0,,Чи…
Dialogue: 0,0:09:24.64,0:09:27.06,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:27.14,0:09:28.44,Default,,0,0,0,,
Dialogue: 0,0:09:28.52,0:09:31.02,Default,,0,0,0,,Хилл Демон пас бергенде бас тартып, допты лақтырып жіберді!
Dialogue: 0,0:09:31.11,0:09:33.99,Default,,0,0,0,,Доп! О!
Dialogue: 0,0:09:34.07,0:09:35.86,Default,,0,0,0,,Доп... Доп...
Dialogue: 0,0:09:35.95,0:09:37.20,Default,,0,0,0,,Ол жарылып кетті!
Dialogue: 0,0:09:37.28,0:09:41.70,Default,,0,0,0,,Икари допқа секіріп, оны жойды.
Dialogue: 0,0:09:41.78,0:09:43.66,Default,,0,0,0,,Оны ессіз күш деп қалай атайсыз?
Dialogue: 0,0:09:44.37,0:09:47.12,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:09:47.21,0:09:48.79,Default,,0,0,0,,Уф
Dialogue: 0,0:09:49.67,0:09:52.09,Default,,0,0,0,,Джу… Джумонджи-кун
Dialogue: 0,0:09:54.17,0:09:57.05,Default,,0,0,0,,Неден сонша қорқасың?
Dialogue: 0,0:09:57.13,0:09:58.51,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:09.02,0:10:10.86,Default,,0,0,0,,Сен не істеп жатырсың, Джумонжи?
Dialogue: 0,0:10:10.94,0:10:12.90,Default,,0,0,0,,Икки тез орнынан тұрады
Dialogue: 0,0:10:12.98,0:10:14.86,Default,,0,0,0,,Уф
Dialogue: 0,0:10:15.53,0:10:16.69,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:18.70,0:10:19.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:22.28,0:10:24.54,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:10:24.62,0:10:26.16,Default,,0,0,0,,Ах
Dialogue: 0,0:10:26.25,0:10:27.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:27.41,0:10:29.12,Default,,0,0,0,,Сіз қалай қарайсыз
Dialogue: 0,0:10:29.21,0:10:30.96,Default,,0,0,0,,Бұған дейін оған бірдеңе болған жоқ па?
Dialogue: 0,0:10:31.04,0:10:31.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:32.96,0:10:34.34,Default,,0,0,0,,Джумонджи-кун
Dialogue: 0,0:10:34.42,0:10:35.55,Default,,0,0,0,,(Қолдың жұдырықталғаны естіледі)
Dialogue: 0,0:10:36.26,0:10:39.30,Default,,0,0,0,,Мен оны бірінші рет көрдім
Dialogue: 0,0:10:40.18,0:10:43.30,Default,,0,0,0,,Мен орта мектепте оқып жүрген кезім
Dialogue: 0,0:10:44.43,0:10:47.68,Default,,0,0,0,,Сіз патша сарайындағы қауесет түрме тізбегісіз бе?
Dialogue: 0,0:10:47.77,0:10:51.90,Default,,0,0,0,,Бір рет болса да жеңіліссіз келесі қалада No1
Dialogue: 0,0:10:51.98,0:10:54.69,Default,,0,0,0,,⸺-де бірінші нөмірді жеңіңіз
Dialogue: 0,0:10:54.77,0:10:57.82,Default,,0,0,0,,Мен бұл тақырыпты аламын.
Dialogue: 0,0:10:57.90,0:10:59.78,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:11:00.45,0:11:02.07,Default,,0,0,0,,Мені жайына қалдыр
Dialogue: 0,0:11:02.16,0:11:05.74,Default,,0,0,0,,Отавара-сенпай маған соғысуды доғар деді.
Dialogue: 0,0:11:05.83,0:11:08.62,Default,,0,0,0,,Хмф, сен керемет жалқаусың.
Dialogue: 0,0:11:08.70,0:11:11.21,Default,,0,0,0,,Король сарайындағы жігіттер бәрібір.
Dialogue: 0,0:11:11.29,0:11:12.17,Default,,0,0,0,,Ммм
Dialogue: 0,0:11:12.25,0:11:13.29,Default,,0,0,0,,Ах
Dialogue: 0,0:11:13.38,0:11:16.05,Default,,0,0,0,,Патша сарайындағы қоқыс қайда?
Dialogue: 0,0:11:16.67,0:11:19.01,Default,,0,0,0,,Арх! Ууууууууууу...
Dialogue: 0,0:11:19.09,0:11:21.34,Default,,0,0,0,,тым кеш!
Dialogue: 0,0:11:21.43,0:11:23.01,Default,,0,0,0,,Уау! (Джумонджи) Ух...
Dialogue: 0,0:11:23.09,0:11:25.47,Default,,0,0,0,,Ора, ора (құқық бұзушы) Уф, көмектесші
Dialogue: 0,0:11:25.55,0:11:26.97,Default,,0,0,0,,Мені кешіріңіз!
Dialogue: 0,0:11:27.06,0:11:30.94,Default,,0,0,0,,Ора, ора, ора... (Құқық бұзушылар еңіреп)
Dialogue: 0,0:11:31.56,0:11:33.77,Default,,0,0,0,,Ах… Ах…
Dialogue: 0,0:11:38.03,0:11:40.15,Default,,0,0,0,,Бұл болды.
Dialogue: 0,0:11:40.82,0:11:42.24,Default,,0,0,0,,Уф
Dialogue: 0,0:11:42.32,0:11:43.66,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:11:43.74,0:11:46.95,Default,,0,0,0,,Кіші мектеп оқушысы кезімде болған оқиғаны еске алып, шошып кететін уақыт емес!
Dialogue: 0,0:11:47.03,0:11:49.79,Default,,0,0,0,,Даиичи, біз бұрынғыдай емеспіз.
Dialogue: 0,0:11:49.87,0:11:51.54,Default,,0,0,0,,Ол керемет қуаттандырылған.
Dialogue: 0,0:11:51.62,0:11:55.54,Default,,0,0,0,,Оның үстіне бұл төбелес емес, футбол ойыны.
Dialogue: 0,0:11:55.63,0:11:57.50,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:11:57.59,0:11:59.26,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:12:00.42,0:12:01.51,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:12:01.59,0:12:03.05,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:12:03.13,0:12:05.97,Default,,0,0,0,,Бұл жолы сен бірінші орындасың, Кадзу-чан.
Dialogue: 0,0:12:07.60,0:12:08.93,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:12:09.01,0:12:10.56,Default,,0,0,0,,Орнату!
Dialogue: 0,0:12:11.48,0:12:12.39,Default,,0,0,0,,Шляпа!
Dialogue: 0,0:12:12.48,0:12:13.81,Default,,0,0,0,,Уф
Dialogue: 0,0:12:18.15,0:12:19.65,Default,,0,0,0,,Ку…ку…қарғыс атсын
Dialogue: 0,0:12:19.73,0:12:20.57,Default,,0,0,0,,Шляпа!
Dialogue: 0,0:12:21.90,0:12:23.40,Default,,0,0,0,,Нуааах!
Dialogue: 0,0:12:23.49,0:12:25.99,Default,,0,0,0,,О! Ораора, орора…
Dialogue: 0,0:12:26.07,0:12:27.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:28.03,0:12:29.74,Default,,0,0,0,,О! (Джумонджи) Гуа
Dialogue: 0,0:12:29.83,0:12:31.75,Default,,0,0,0,,Нуораааах!
Dialogue: 0,0:12:31.83,0:12:33.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:33.25,0:12:34.92,Default,,0,0,0,,Доя! (Сілік жын) Уф
Dialogue: 0,0:12:35.00,0:12:37.75,Default,,0,0,0,,Я~...сен-нии! Әй, сүлік жын!
Dialogue: 0,0:12:37.84,0:12:40.21,Default,,0,0,0,,Хмм, доп... иә?
Dialogue: 0,0:12:42.26,0:12:43.88,Default,,0,0,0,,Сол кезде мен—
Dialogue: 0,0:12:45.22,0:12:48.10,Default,,0,0,0,,О? Хм... (Санада) Уа, не айтып тұрсың?
Dialogue: 0,0:12:48.85,0:12:51.10,Default,,0,0,0,,Хилл Демонның ерекше трюк ойыны!
Dialogue: 0,0:12:51.18,0:12:53.43,Default,,0,0,0,,Бұл жақсы Hill Demon ойыншысы
Dialogue: 0,0:12:53.52,0:12:56.35,Default,,0,0,0,,Допты Икаридің асығынан қорғайтындай кейіп көрсету
Dialogue: 0,0:12:56.44,0:12:58.90,Default,,0,0,0,,Артыңызға қарамай артқа лақтырыңыз
Dialogue: 0,0:12:58.98,0:13:02.86,Default,,0,0,0,,Ал доп тікелей артындағы Eyeshield ойыншысына барады.
Dialogue: 0,0:13:02.94,0:13:07.28,Default,,0,0,0,,Енді жүгір, жүгір, Айсшилд 21!
Dialogue: 0,0:13:07.36,0:13:08.82,Default,,0,0,0,,Жарайды
Dialogue: 0,0:13:08.91,0:13:09.99,Default,,0,0,0,,Ах
Dialogue: 0,0:13:10.08,0:13:11.74,Default,,0,0,0,,Сен жай ғана... отты қайта тұтаттың, иә?
Dialogue: 0,0:13:11.83,0:13:15.79,Default,,0,0,0,,Хмм... Ооо!
Dialogue: 0,0:13:15.87,0:13:17.54,Default,,0,0,0,,Уау... Уау!
Dialogue: 0,0:13:17.63,0:13:20.00,Default,,0,0,0,,Трайдентпен күресу шешілді!
Dialogue: 0,0:13:20.09,0:13:23.46,Default,,0,0,0,,Балшық қақпаны қамалдың қорғанысы тағы да жауып тастады!
Dialogue: 0,0:13:23.55,0:13:24.76,Default,,0,0,0,,Сенна!
Dialogue: 0,0:13:24.84,0:13:26.88,Default,,0,0,0,,Жарайды, мен дереу барамын.
Dialogue: 0,0:13:26.97,0:13:28.72,Default,,0,0,0,,Қарғыс атсын... Жақсысың ба, Сена?
Dialogue: 0,0:13:28.80,0:13:31.18,Default,,0,0,0,,Ой... жарайды.
Dialogue: 0,0:13:34.06,0:13:36.14,Default,,0,0,0,,Уф, неге?
Dialogue: 0,0:13:37.39,0:13:41.86,Default,,0,0,0,,Неге... неге менің денем қозғалмайды?
Dialogue: 0,0:13:41.94,0:13:45.15,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:13:45.24,0:13:46.99,Default,,0,0,0,,Джумонжи! (Джумонджи) Ха
Dialogue: 0,0:13:47.07,0:13:48.36,Default,,0,0,0,,Уф
Dialogue: 0,0:13:48.45,0:13:50.12,Default,,0,0,0,,Жұмысымды енді ғана жоғалттым, ақшам да жоқ.
Dialogue: 0,0:13:50.20,0:13:52.87,Default,,0,0,0,,Неге қарсы шықпайсың, бейбақ?
Dialogue: 0,0:13:52.95,0:13:54.08,Default,,0,0,0,,Ах
Dialogue: 0,0:13:54.16,0:13:55.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:55.75,0:13:57.04,Default,,0,0,0,,Бірдеңе айт!
Dialogue: 0,0:13:57.67,0:13:58.50,Default,,0,0,0,,Ахх...
Dialogue: 0,0:13:59.29,0:14:01.50,Default,,0,0,0,,Джумонджиге не болды?
Dialogue: 0,0:14:01.59,0:14:03.46,Default,,0,0,0,,Өзіңе ұқсама!
Dialogue: 0,0:14:03.55,0:14:05.55,Default,,0,0,0,,Шапшаң болма, Деймон линиясы!
Dialogue: 0,0:14:05.63,0:14:07.09,Default,,0,0,0,,Қашпа
Dialogue: 0,0:14:07.17,0:14:08.30,Default,,0,0,0,,Оған жоғары баға қояды!
Dialogue: 0,0:14:08.93,0:14:12.43,Default,,0,0,0,,Мен тағы да қашамын ба?
Dialogue: 0,0:14:13.39,0:14:14.39,Default,,0,0,0,,Ikki
Dialogue: 0,0:14:14.47,0:14:16.89,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:14:19.56,0:14:24.19,Default,,0,0,0,,О... қария! Не... неге мұндасың?
Dialogue: 0,0:14:27.57,0:14:30.95,Default,,0,0,0,,Қарғыс атқыр... Сен мені мазақ ету үшін келдің!
Dialogue: 0,0:14:32.45,0:14:34.08,Default,,0,0,0,,Пайдасыз қоқысты кесіңіз
Dialogue: 0,0:14:34.95,0:14:37.16,Default,,0,0,0,,Бұл – қоғамдағы парасаттылық.
Dialogue: 0,0:14:37.25,0:14:39.50,Default,,0,0,0,,Сен нені қалайсың?
Dialogue: 0,0:14:39.58,0:14:41.29,Default,,0,0,0,,А...
Dialogue: 0,0:14:43.88,0:14:47.21,Default,,0,0,0,,Қарғыс атсын, мен...
Dialogue: 0,0:14:47.92,0:14:49.97,Default,,0,0,0,,Қашпа, Икки
Dialogue: 0,0:14:50.05,0:14:51.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:51.51,0:14:55.68,Default,,0,0,0,,Қашпа, сен сұмдық емес едің.
Dialogue: 0,0:14:56.47,0:14:57.47,Default,,0,0,0,,Қария
Dialogue: 0,0:14:57.56,0:15:01.40,Default,,0,0,0,,Сіз өз жолыңызды таптыңыз.
Dialogue: 0,0:15:02.48,0:15:07.11,Default,,0,0,0,,Мен сенің ойнағаныңды бірінші рет көрдім, үмітсіз күйіңді бірінші рет көрдім.
Dialogue: 0,0:15:07.78,0:15:10.99,Default,,0,0,0,,Мен сенен соны көргім келді.
Dialogue: 0,0:15:11.99,0:15:14.53,Default,,0,0,0,,Қорқынышты, ұсқынсыз болу дұрыс
Dialogue: 0,0:15:14.62,0:15:15.95,Default,,0,0,0,,Сонымен... у...
Dialogue: 0,0:15:16.62,0:15:18.62,Default,,0,0,0,,Сонымен... уф...
Dialogue: 0,0:15:19.87,0:15:22.75,Default,,0,0,0,,То... Қашпа!
Dialogue: 0,0:15:26.80,0:15:29.05,Default,,0,0,0,,Қария... қарт
Dialogue: 0,0:15:32.47,0:15:34.68,Default,,0,0,0,,Ей, күлдірші мені.
Dialogue: 0,0:15:35.72,0:15:38.64,Default,,0,0,0,,Сонда сен маған 16 жылыңды босқа кетірмексің бе?
Dialogue: 0,0:15:39.56,0:15:42.94,Default,,0,0,0,,Мен жай ғана бұрыштарды кесіп, көңілді болдым!
Dialogue: 0,0:15:44.23,0:15:47.11,Default,,0,0,0,,Мен енді қаша алмаймын!
Dialogue: 0,0:15:49.40,0:15:53.45,Default,,0,0,0,,Хмф, Джумонджи ақыры қайтып келді.
Dialogue: 0,0:15:53.99,0:15:56.53,Default,,0,0,0,,Каззу-чан тым кеш
Dialogue: 0,0:15:57.74,0:15:58.74,Default,,0,0,0,,Иә
Dialogue: 0,0:15:58.83,0:16:01.41,Default,,0,0,0,,Хаха үш ағайынды Максты тірілтті!
Dialogue: 0,0:16:01.50,0:16:04.12,Default,,0,0,0,,О? Сондықтан біз ағайынды емеспіз!
Dialogue: 0,0:16:04.21,0:16:05.21,Default,,0,0,0,,Мүмкін бір күні сонда бірге ішеміз
Dialogue: 0,0:16:07.96,0:16:10.09,Default,,0,0,0,,Сен мені уайымдадың, Сена.
Dialogue: 0,0:16:10.92,0:16:13.55,Default,,0,0,0,,Бірақ қазір бәрі жақсы.
Dialogue: 0,0:16:14.72,0:16:15.64,Default,,0,0,0,,Иә
Dialogue: 0,0:16:17.10,0:16:18.35,Default,,0,0,0,,Иә
Dialogue: 0,0:16:19.01,0:16:20.06,Default,,0,0,0,,Кел, Деймон
Dialogue: 0,0:16:20.14,0:16:24.31,Default,,0,0,0,,Сіз патша сарайының қалың қорғаныс қабырғаларын бұза аласыз ба?
Dialogue: 0,0:16:24.94,0:16:28.02,Default,,0,0,0,,Мұнда екі команданың сызықтарының күші маңызды.
Dialogue: 0,0:16:28.11,0:16:29.86,Default,,0,0,0,,Орнату!
Dialogue: 0,0:16:29.94,0:16:31.94,Default,,0,0,0,,Түрме тізбегі
Dialogue: 0,0:16:32.03,0:16:34.86,Default,,0,0,0,,Достарыңды арқаңда көтеріп жүрген жалғыз сен емессің!
Dialogue: 0,0:16:34.95,0:16:36.66,Default,,0,0,0,,Түн ортасында әлі де 36 сағат.
Dialogue: 0,0:16:36.74,0:16:37.57,Default,,0,0,0,,Шляпа!
Dialogue: 0,0:16:38.95,0:16:40.83,Default,,0,0,0,,Нуааах!
Dialogue: 0,0:16:40.91,0:16:42.83,Default,,0,0,0,,Ораора Ораора Ораора…
Dialogue: 0,0:16:42.91,0:16:44.50,Default,,0,0,0,,О! (Джумонджи) Уф
Dialogue: 0,0:16:44.58,0:16:47.46,Default,,0,0,0,,Қарғыс атсын... Кеттік!
Dialogue: 0,0:16:48.04,0:16:49.42,Default,,0,0,0,,О! (джумонжи)...
Dialogue: 0,0:16:49.50,0:16:51.38,Default,,0,0,0,,Міне, әмияның. Қуып жет!
Dialogue: 0,0:16:51.46,0:16:54.34,Default,,0,0,0,,Ораора, ораора… (Джумонджи) Уккуууууу
Dialogue: 0,0:16:54.43,0:16:56.34,Default,,0,0,0,,Ууууууууууууууууууууууу (қабан аулау) Ора ора ора ора ора ора!
Dialogue: 0,0:16:56.43,0:16:59.30,Default,,0,0,0,,Ораора Ораора… (Джумонжи) Ууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:16:59.39,0:17:02.27,Default,,0,0,0,,Ууууууууууууууууууууууууууу (қабан аулау) Ора, ора ора!
Dialogue: 0,0:17:02.35,0:17:04.23,Default,,0,0,0,,Икки, бар күшіңді сал!
Dialogue: 0,0:17:04.31,0:17:07.69,Default,,0,0,0,,Уф... бұл жақсы емес!
Dialogue: 0,0:17:07.77,0:17:09.77,Default,,0,0,0,,Уф... уау
Dialogue: 0,0:17:09.86,0:17:13.57,Default,,0,0,0,,Nuo...
Dialogue: 0,0:17:13.65,0:17:14.74,Default,,0,0,0,,Уау (джумонжи) Уау!
Dialogue: 0,0:17:16.78,0:17:19.70,Default,,0,0,0,,Нуууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:17:19.78,0:17:22.66,Default,,0,0,0,,(Екі адам еңіреп)
Dialogue: 0,0:17:22.75,0:17:24.08,Default,,0,0,0,,Ha
Dialogue: 0,0:17:24.16,0:17:25.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:25.58,0:17:27.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:27.21,0:17:31.09,Default,,0,0,0,,Менің ойымша, сіз үнемі жоғалту хобби емес деп айтып отырсыз!
Dialogue: 0,0:17:31.17,0:17:32.46,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:17:32.55,0:17:34.97,Default,,0,0,0,,Нуааах!
Dialogue: 0,0:17:35.05,0:17:37.34,Default,,0,0,0,,Ол сәл қорқынышты емес пе?
Dialogue: 0,0:17:37.43,0:17:40.22,Default,,0,0,0,,Мен... Игари... (Сакураба) А... мен оны жойдым!
Dialogue: 0,0:17:40.30,0:17:42.01,Default,,0,0,0,,Джумонджи-кун
Dialogue: 0,0:17:52.44,0:17:53.61,Default,,0,0,0,,Сенна
Dialogue: 0,0:17:55.07,0:17:56.36,Default,,0,0,0,,Джумонджи-кун
Dialogue: 0,0:17:58.03,0:18:00.16,Default,,0,0,0,,Ой, Икаридің жаншылған жері.
Dialogue: 0,0:18:00.24,0:18:03.99,Default,,0,0,0,,Ace of Mudgate, Айсшилд 21, өтті!
Dialogue: 0,0:18:04.08,0:18:06.58,Default,,0,0,0,,Тікелей қақпа сызығына!
Dialogue: 0,0:18:07.33,0:18:08.58,Default,,0,0,0,,Мені жіберме
Dialogue: 0,0:18:10.71,0:18:11.54,Default,,0,0,0,,Не!?
Dialogue: 0,0:18:11.63,0:18:13.84,Default,,0,0,0,,Қабақ 21...
Dialogue: 0,0:18:13.92,0:18:14.76,Default,,0,0,0,,Бұл алдау ма?
Dialogue: 0,0:18:14.84,0:18:18.09,Default,,0,0,0,,Кекекеке, кеш болды.
Dialogue: 0,0:18:18.76,0:18:21.76,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:18:22.81,0:18:24.18,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:18:25.72,0:18:27.60,Default,,0,0,0,,Жоқ жерде!
Dialogue: 0,0:18:27.68,0:18:30.48,Default,,0,0,0,,Әй, қалғанын маған қалдыр!
Dialogue: 0,0:18:30.56,0:18:32.65,Default,,0,0,0,,Ұстауға келгенде, сені ешкім жеңе алмайды!
Dialogue: 0,0:18:33.27,0:18:34.11,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:18:34.82,0:18:36.94,Default,,0,0,0,,Ұстау белгілері!
Dialogue: 0,0:18:37.03,0:18:40.11,Default,,0,0,0,,өтті! Деймон бірінші болып құлады!
Dialogue: 0,0:18:40.20,0:18:41.57,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:18:41.66,0:18:42.66,Default,,0,0,0,,Ммм
Dialogue: 0,0:18:42.74,0:18:43.62,Default,,0,0,0,,Ах
Dialogue: 0,0:18:45.70,0:18:46.54,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:47.66,0:18:50.50,Default,,0,0,0,,Жаса, Деймон Лин
Dialogue: 0,0:18:51.54,0:18:54.46,Default,,0,0,0,,Хмм... сіз де.
Dialogue: 0,0:18:54.55,0:18:55.71,Default,,0,0,0,,Хун
Dialogue: 0,0:18:58.51,0:18:59.34,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:19:10.81,0:19:12.06,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:19:13.65,0:19:14.57,Default,,0,0,0,,Иә
Dialogue: 0,0:19:15.48,0:19:17.53,Default,,0,0,0,,Оши! Қатты жүрейік!
Dialogue: 0,0:19:17.61,0:19:19.65,Default,,0,0,0,,О!
Dialogue: 0,0:19:21.57,0:19:26.58,Default,,0,0,0,,♪~
Dialogue: 0,0:20:31.14,0:20:36.52,Default,,0,0,0,,~♪
Dialogue: 0,0:20:37.15,0:20:40.65,Default,,0,0,0,,Сен мұны істедің, Монта, оны осы екпінмен ұста, Макс!
Dialogue: 0,0:20:40.73,0:20:43.36,Default,,0,0,0,,Нағыз шайқас Сакурба-сенпай пайда болғаннан кейін басталады.
Dialogue: 0,0:20:43.45,0:20:44.36,Default,,0,0,0,,Аяғымның ұзындығынан жеңілсем де
Dialogue: 0,0:20:44.45,0:20:46.24,Default,,0,0,0,,Мені ұстасаң, мен ешқашан жеңілмеймін, ақымақ!
Dialogue: 0,0:20:46.32,0:20:48.53,Default,,0,0,0,,Келесі жолы «Көз қалқаны 21»
Dialogue: 0,0:20:48.62,0:20:50.54,Default,,0,0,0,,«Аспанды басқаратын рыцарь»
Dialogue: 0,0:20:50.62,0:20:51.54,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:20:53.04,0:20:59.04,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
