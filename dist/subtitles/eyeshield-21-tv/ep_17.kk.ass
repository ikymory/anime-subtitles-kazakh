Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.50,0:00:03.12,Default,,0,0,0,,♪ Барбекю
Dialogue: 0,0:00:03.25,0:00:05.83,Default,,0,0,0,,♪ Маморимен көңіл көтеру...
Dialogue: 0,0:00:06.38,0:00:07.79,Default,,0,0,0,,Керемет.
Dialogue: 0,0:00:08.17,0:00:09.63,Default,,0,0,0,,Таңдау жоқ.
Dialogue: 0,0:00:09.75,0:00:11.38,Default,,0,0,0,,Оған Hill Demon демеушілік жасайды.
Dialogue: 0,0:00:11.51,0:00:13.51,Default,,0,0,0,,♪ Мамори-санмен көңіл көтеріңіз~
Dialogue: 0,0:00:14.13,0:00:15.97,Default,,0,0,0,,Я~! Сіз мұны білесіз бе?
Dialogue: 0,0:00:16.09,0:00:16.93,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:00:17.05,0:00:17.97,Default,,0,0,0,,Жаңа өнім сағызы
Dialogue: 0,0:00:18.10,0:00:19.85,Default,,0,0,0,,Иә, кәдімгі ше?
Dialogue: 0,0:00:20.22,0:00:22.18,Default,,0,0,0,,Ол енді өндірілмейді.
Dialogue: 0,0:00:22.31,0:00:24.10,Default,,0,0,0,,Эй, маған ұнады.
Dialogue: 0,0:00:24.23,0:00:25.81,Default,,0,0,0,,Қайта оралыңыз.
Dialogue: 0,0:00:26.31,0:00:27.52,Default,,0,0,0,,Қайта оралу!
Dialogue: 0,0:00:29.27,0:00:30.69,Default,,0,0,0,,Мм!
Dialogue: 0,0:00:32.61,0:00:33.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:33.90,0:00:35.03,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:37.57,0:00:39.24,Default,,0,0,0,,Иә? (3-бала) Иә?
Dialogue: 0,0:00:39.49,0:00:40.45,Default,,0,0,0,,Әй?
Dialogue: 0,0:00:44.04,0:00:46.25,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:46.37,0:00:48.71,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:00:49.96,0:00:51.55,Default,,0,0,0,,Әй?
Dialogue: 0,0:00:55.84,0:00:56.68,Default,,0,0,0,,Эй
Dialogue: 0,0:00:56.80,0:00:58.30,Default,,0,0,0,,Бұл (3-бала) қайтыс болуы мүмкін бе?
Dialogue: 0,0:00:58.43,0:00:59.30,Default,,0,0,0,,(ет грильдегі дыбыс)
Dialogue: 0,0:01:01.89,0:01:02.89,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:03.02,0:01:03.85,Default,,0,0,0,,Хмф!
Dialogue: 0,0:01:07.81,0:01:08.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:11.07,0:01:12.94,Default,,0,0,0,,Ніл өзенінің батыс жағалауындағы қиын өткелі бар шатқалдың тереңінде —
Dialogue: 0,0:01:15.07,0:01:16.49,Default,,0,0,0,,Осындай кездерде
Dialogue: 0,0:01:16.61,0:01:18.41,Default,,0,0,0,,Қайда кетті?
Dialogue: 0,0:01:21.83,0:01:23.50,Default,,0,0,0,,Темір тұлпар
Dialogue: 0,0:01:24.00,0:01:30.00,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:37.90,0:02:43.91,Default,,0,0,0,,~♪
Dialogue: 0,0:02:50.46,0:02:53.88,Default,,0,0,0,,♪ Бірге барбекю жасау қызық
Dialogue: 0,0:02:55.09,0:02:57.34,Default,,0,0,0,,Әй, бәрі, міне, міне!
Dialogue: 0,0:02:57.76,0:02:59.80,Default,,0,0,0,,Алжапқыштағы мамори
Dialogue: 0,0:02:59.92,0:03:01.30,Default,,0,0,0,,Керемет Макс!
Dialogue: 0,0:03:03.97,0:03:06.81,Default,,0,0,0,,Иә, Монта-кун, өтінемін
Dialogue: 0,0:03:06.93,0:03:08.27,Default,,0,0,0,,Ахх
Dialogue: 0,0:03:08.89,0:03:10.98,Default,,0,0,0,,Бұл дәмді Мамори-сан
Dialogue: 0,0:03:11.10,0:03:12.06,Default,,0,0,0,,Не болды!
Dialogue: 0,0:03:12.19,0:03:13.94,Default,,0,0,0,,Ауырды, Монта!
Dialogue: 0,0:03:14.06,0:03:16.23,Default,,0,0,0,,Мукки~ Бірінші Макс!
Dialogue: 0,0:03:16.73,0:03:17.73,Default,,0,0,0,,Мамори-сан!
Dialogue: 0,0:03:18.19,0:03:19.28,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:03:19.40,0:03:20.70,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:03:20.82,0:03:22.66,Default,,0,0,0,,Иә, мүмкін бе?
Dialogue: 0,0:03:22.78,0:03:24.70,Default,,0,0,0,,Хиру-сан да Мамори-санды нысанаға ала ма?
Dialogue: 0,0:03:24.82,0:03:25.70,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:03:26.24,0:03:27.29,Default,,0,0,0,,Мына жігітке қараңдаршы
Dialogue: 0,0:03:27.37,0:03:30.66,Default,,0,0,0,,Ех... жоғары сөніп қалыңыз
Dialogue: 0,0:03:31.08,0:03:33.04,Default,,0,0,0,,Ах, түбір.
Dialogue: 0,0:03:33.17,0:03:34.04,Default,,0,0,0,,Түбір?
Dialogue: 0,0:03:34.33,0:03:35.50,Default,,0,0,0,,Мм... солай ма?
Dialogue: 0,0:03:35.71,0:03:38.25,Default,,0,0,0,,Америка футболының негізгі стратегияларының бірі
Dialogue: 0,0:03:38.38,0:03:42.34,Default,,0,0,0,,Бұл рұқсаттаманы өту үшін жүгіру жолын нұсқау кезінде қолданылатын термин.
Dialogue: 0,0:03:42.76,0:03:45.26,Default,,0,0,0,,Иә, мен қанша қашықтыққа жүгіру керектігін шешуім керек.
Dialogue: 0,0:03:45.39,0:03:46.89,Default,,0,0,0,,Өйткені сіз өте алмайсыз.
Dialogue: 0,0:03:47.01,0:03:48.51,Default,,0,0,0,,Бұл керемет, Юкимицу-сан.
Dialogue: 0,0:03:48.64,0:03:50.10,Default,,0,0,0,,Біз әлі Кира туралы бірде-бір із тапқан жоқпыз,
Dialogue: 0,0:03:50.23,0:03:51.85,Default,,0,0,0,,Бірақ жол қиын!
Dialogue: 0,0:03:52.39,0:03:54.31,Default,,0,0,0,,Бірақ тамыр және барбекю
Dialogue: 0,0:03:54.44,0:03:56.23,Default,,0,0,0,,Мәміле қандай?
Dialogue: 0,0:03:56.90,0:03:58.52,Default,,0,0,0,,Мен сендерге сұрақ-жауап берейін деп жатырмын.
Dialogue: 0,0:03:58.65,0:03:59.90,Default,,0,0,0,,Викторина?
Dialogue: 0,0:04:00.03,0:04:01.40,Default,,0,0,0,,Көрсетілген маршрут бойынша жүріңіз
Dialogue: 0,0:04:01.53,0:04:04.78,Default,,0,0,0,,Ереже: жүгіре алатындар ғана ет жей алады.
Dialogue: 0,0:04:05.28,0:04:06.24,Default,,0,0,0,,
Dialogue: 0,0:04:06.45,0:04:07.66,Default,,0,0,0,,Мм...
Dialogue: 0,0:04:08.83,0:04:10.20,Default,,0,0,0,,Куа~ Уми!
Dialogue: 0,0:04:10.50,0:04:11.87,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:12.21,0:04:13.29,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:13.41,0:04:14.67,Default,,0,0,0,,Маршрутты есіне түсіре алмайтындар
Dialogue: 0,0:04:14.79,0:04:16.08,Default,,0,0,0,,Ет жеуге болмайды
Dialogue: 0,0:04:16.29,0:04:17.92,Default,,0,0,0,,Бұл викторина емес!
Dialogue: 0,0:04:18.54,0:04:21.55,Default,,0,0,0,,Оның күрделілігі сонша, мен оны бірден есіме түсіре алмаймын.
Dialogue: 0,0:04:21.67,0:04:23.09,Default,,0,0,0,,Сіздің есте сақтау қабілетіңіз соншалықты нашар ма?
Dialogue: 0,0:04:23.22,0:04:25.18,Default,,0,0,0,,Бұл қосымша емтихан болмайды.
Dialogue: 0,0:04:25.76,0:04:27.89,Default,,0,0,0,,Барлығын есте сақтаудың қажеті жоқ.
Dialogue: 0,0:04:28.05,0:04:30.14,Default,,0,0,0,,Өзіңіз жақсы білетін 2-3 бағытты жаттықтырыңыз.
Dialogue: 0,0:04:30.56,0:04:32.64,Default,,0,0,0,,Не айтып тұрсың, шошқа?
Dialogue: 0,0:04:32.93,0:04:34.56,Default,,0,0,0,,Барлығын есте сақта!
Dialogue: 0,0:04:34.69,0:04:37.73,Default,,0,0,0,,Менің қолымнан онша көп келмейді, сонда Рождестволық тостаған қандай?
Dialogue: 0,0:04:37.86,0:04:40.15,Default,,0,0,0,,Иә? Сіз қайда баруды жоспарлап отырсыз?
Dialogue: 0,0:04:40.28,0:04:41.11,Default,,0,0,0,,Гику!
Dialogue: 0,0:04:41.44,0:04:42.99,Default,,0,0,0,,Бұл фото...
Dialogue: 0,0:04:43.11,0:04:43.95,Default,,0,0,0,,Оянып қалдым да, бүкіл денем ауырады~!
Dialogue: 0,0:04:44.07,0:04:44.99,Default,,0,0,0,,Оны айналаға таратпа!
Dialogue: 0,0:04:45.11,0:04:46.11,Default,,0,0,0,,Түбір немесе басқасы
Dialogue: 0,0:04:46.24,0:04:47.07,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:04:47.53,0:04:50.03,Default,,0,0,0,,Неліктен Сенна? Мен жауапты болсам да
Dialogue: 0,0:04:50.41,0:04:54.33,Default,,0,0,0,,Бірақ... бұл викторина, мен де ет жегім келеді.
Dialogue: 0,0:04:54.46,0:04:56.08,Default,,0,0,0,,Ммм, түсіндім.
Dialogue: 0,0:04:56.21,0:04:57.04,Default,,0,0,0,,Хаа…
Dialogue: 0,0:05:00.38,0:05:01.96,Default,,0,0,0,,1-сұрақ.
Dialogue: 0,0:05:02.09,0:05:03.84,Default,,0,0,0,,Ет келсе, жүгір.
Dialogue: 0,0:05:03.97,0:05:04.97,Default,,0,0,0,,Қазір мен сөйлесіп тұрған адам – басқа емес,
Dialogue: 0,0:05:05.26,0:05:07.01,Default,,0,0,0,,Ет макс. Ет макс…
Dialogue: 0,0:05:08.55,0:05:09.39,Default,,0,0,0,,Көлбеу
Dialogue: 0,0:05:10.18,0:05:11.14,Default,,0,0,0,,Міне, уақыты!
Dialogue: 0,0:05:12.02,0:05:13.31,Default,,0,0,0,,Оңай жеңіс!
Dialogue: 0,0:05:13.43,0:05:14.27,Default,,0,0,0,,Итадакима...
Dialogue: 0,0:05:16.19,0:05:18.06,Default,,0,0,0,,Әй, менің етім!
Dialogue: 0,0:05:18.19,0:05:19.48,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:05:19.65,0:05:20.69,Default,,0,0,0,,Бұл ештеңе емес Иә.
Dialogue: 0,0:05:22.07,0:05:23.65,Default,,0,0,0,,Келесі қайтару!
Dialogue: 0,0:05:24.24,0:05:27.24,Default,,0,0,0,,Ол қайтып оралғысы келді ме?
Dialogue: 0,0:05:28.03,0:05:29.62,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:30.45,0:05:31.66,Default,,0,0,0,,Келесіде!
Dialogue: 0,0:05:33.33,0:05:34.16,Default,,0,0,0,,Өшіру!
Dialogue: 0,0:05:34.29,0:05:36.08,Default,,0,0,0,,Unu~
Dialogue: 0,0:05:36.66,0:05:37.58,Default,,0,0,0,,Хабарлама!
Dialogue: 0,0:05:37.71,0:05:39.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:39.54,0:05:42.50,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:05:42.67,0:05:45.92,Default,,0,0,0,,Ача~ Әркім тіпті біреуін жасай алмайды ма?
Dialogue: 0,0:05:46.05,0:05:48.26,Default,,0,0,0,,Бұны ешкім жей алмайды.
Dialogue: 0,0:05:48.38,0:05:49.97,Default,,0,0,0,,Сіз білесіз бе? Ұзын пост!
Dialogue: 0,0:05:50.30,0:05:51.76,Default,,0,0,0,,Жарайды, келесі жолы!
Dialogue: 0,0:05:51.89,0:05:53.35,Default,,0,0,0,,Ет жейміз!
Dialogue: 0,0:05:53.89,0:05:54.97,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:57.02,0:05:57.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:57.98,0:05:58.94,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:59.73,0:06:01.44,Default,,0,0,0,,Тецуума тоқтаңыз!
Dialogue: 0,0:06:01.86,0:06:02.69,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:03.52,0:06:04.44,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:05.32,0:06:06.44,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:06:06.69,0:06:07.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:11.41,0:06:13.66,Default,,0,0,0,,Мен сені осындай жерден іздедім.
Dialogue: 0,0:06:14.12,0:06:14.99,Default,,0,0,0,,Қанша адам келдіңдер? Төртеу ме?
Dialogue: 0,0:06:17.08,0:06:18.96,Default,,0,0,0,,Бұл туралы айтудың қажеті жоқ.
Dialogue: 0,0:06:19.54,0:06:20.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:21.25,0:06:22.21,Default,,0,0,0,,Сіз, мүмкін емес
Dialogue: 0,0:06:22.34,0:06:25.21,Default,,0,0,0,,Жаттықтырушы ойын алдында көп тамақ ішпеуімді айтқан соң.
Dialogue: 0,0:06:25.34,0:06:27.42,Default,,0,0,0,,Сіз көптен бері тамақ ішпеген шығарсыз.
Dialogue: 0,0:06:27.55,0:06:29.13,Default,,0,0,0,,Жоқ! темір тұлпар
Dialogue: 0,0:06:29.26,0:06:33.18,Default,,0,0,0,,Сен неге сонша түсініксізсің?
Dialogue: 0,0:06:33.68,0:06:36.10,Default,,0,0,0,,Әй, эй, темір тұлпар бар шығар?
Dialogue: 0,0:06:36.22,0:06:38.64,Default,,0,0,0,,Әй, әлгі темір тұлпар.
Dialogue: 0,0:06:38.77,0:06:40.56,Default,,0,0,0,,Сонда ол Бала ма?
Dialogue: 0,0:06:40.94,0:06:42.81,Default,,0,0,0,,Әйтеуір бірдеңе жеп алайық.
Dialogue: 0,0:06:43.11,0:06:43.94,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:06:44.07,0:06:44.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:47.40,0:06:50.03,Default,,0,0,0,,Бәрібір осы жерден тамақтаныңыз.
Dialogue: 0,0:06:50.15,0:06:53.16,Default,,0,0,0,,Етті жеуге бола ма, жоқ па, өз еркің.
Dialogue: 0,0:06:53.28,0:06:55.16,Default,,0,0,0,,Әлі уақыт бар, солай ма?
Dialogue: 0,0:06:56.20,0:06:57.04,Default,,0,0,0,,Әй!
Dialogue: 0,0:06:57.16,0:06:59.66,Default,,0,0,0,,Әй, өкінетінімді білмеймін.
Dialogue: 0,0:07:01.83,0:07:02.75,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:07:04.42,0:07:05.25,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:07:06.46,0:07:07.30,Default,,0,0,0,,Әй!
Dialogue: 0,0:07:08.59,0:07:10.09,Default,,0,0,0,,Біздің ет!
Dialogue: 0,0:07:10.22,0:07:12.72,Default,,0,0,0,,Мен мұндай жігіттің жегеніне шыдамайтыныма сенімдімін, иә, Сена?
Dialogue: 0,0:07:12.84,0:07:14.14,Default,,0,0,0,,Ух... иә!
Dialogue: 0,0:07:16.01,0:07:17.06,Default,,0,0,0,,Енді
Dialogue: 0,0:07:17.35,0:07:18.98,Default,,0,0,0,,Не болады?
Dialogue: 0,0:07:19.27,0:07:21.02,Default,,0,0,0,,Жарайды, кесіңіз!
Dialogue: 0,0:07:21.19,0:07:22.77,Default,,0,0,0,,Жақсы, кесу
Dialogue: 0,0:07:22.90,0:07:23.73,Default,,0,0,0,,(Барабан соғу дыбысы)
Dialogue: 0,0:07:24.06,0:07:25.40,Default,,0,0,0,,Мен Иносукэні құтқарамын
Dialogue: 0,0:07:25.82,0:07:27.98,Default,,0,0,0,,Хохохохохохо...
Dialogue: 0,0:07:28.11,0:07:28.94,Default,,0,0,0,,Хо-хо!
Dialogue: 0,0:07:29.78,0:07:30.61,Default,,0,0,0,,…Тоқта, қайда барасың, Зура?
Dialogue: 0,0:07:33.45,0:07:35.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:37.70,0:07:38.54,Default,,0,0,0,,(Балалар ысқырығы)
Dialogue: 0,0:07:38.91,0:07:40.87,Default,,0,0,0,,Келесі тез орындалады!
Dialogue: 0,0:07:41.66,0:07:43.88,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:44.00,0:07:44.83,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:47.59,0:07:50.42,Default,,0,0,0,,Ет макс. Ет макс…
Dialogue: 0,0:07:50.76,0:07:53.22,Default,,0,0,0,,Шаршы сыртқа шығарыңыз! (Барлығы) Уау!
Dialogue: 0,0:07:53.34,0:07:55.39,Default,,0,0,0,,Ах~
Dialogue: 0,0:07:55.68,0:07:58.06,Default,,0,0,0,,Шығу! (Барлығы) Уау!
Dialogue: 0,0:07:58.18,0:08:00.64,Default,,0,0,0,,Ах~
Dialogue: 0,0:08:00.77,0:08:02.48,Default,,0,0,0,,Бүгінгі күн өте жақсы
Dialogue: 0,0:08:02.60,0:08:05.44,Default,,0,0,0,,Тым жақсы күндерде жаман ештеңе болмайды.
Dialogue: 0,0:08:05.56,0:08:08.52,Default,,0,0,0,,Муки~ Келесі жолы міндетті түрде!
Dialogue: 0,0:08:08.65,0:08:09.82,Default,,0,0,0,,Жоғары!
Dialogue: 0,0:08:10.57,0:08:13.15,Default,,0,0,0,,Бұны маған қалдырыңыз, ол тікелей алға!
Dialogue: 0,0:08:14.07,0:08:16.03,Default,,0,0,0,,Максималды ұстау
Dialogue: 0,0:08:16.62,0:08:18.78,Default,,0,0,0,,Муджиги! Мен жасыл бұрышты жек көремін!
Dialogue: 0,0:08:19.08,0:08:20.95,Default,,0,0,0,,Ет бітті
Dialogue: 0,0:08:21.50,0:08:23.71,Default,,0,0,0,,Сонымен... міне, солай!
Dialogue: 0,0:08:25.12,0:08:26.08,Default,,0,0,0,,Иә...
Dialogue: 0,0:08:26.58,0:08:29.46,Default,,0,0,0,,Сол үшін айттым ғой, өкінесің.
Dialogue: 0,0:08:29.71,0:08:32.13,Default,,0,0,0,,Тецуума Баратын уақыт та қалды.
Dialogue: 0,0:08:32.59,0:08:33.72,Default,,0,0,0,,Техникамды қолдансам да кесіп өте алмаймын.
Dialogue: 0,0:08:33.84,0:08:36.59,Default,,0,0,0,,Ет ұры! Маған етті қайтар!
Dialogue: 0,0:08:36.84,0:08:37.97,Default,,0,0,0,,Менің таңдауым жоқ
Dialogue: 0,0:08:38.10,0:08:40.85,Default,,0,0,0,,Біз бір маршрутты да жасай алмадық.
Dialogue: 0,0:08:40.97,0:08:43.10,Default,,0,0,0,,Көкөністер де өте дәмді.
Dialogue: 0,0:08:43.23,0:08:45.56,Default,,0,0,0,,Мен ет жегім келді!
Dialogue: 0,0:08:45.94,0:08:47.77,Default,,0,0,0,,Маршрут қандай?
Dialogue: 0,0:08:47.90,0:08:49.61,Default,,0,0,0,,Бұл жай ғана қорлау емес пе?
Dialogue: 0,0:08:49.73,0:08:51.19,Default,,0,0,0,,Мен саған бірнеше қосымша киім мен бір күрте дайындап қоямын.
Dialogue: 0,0:08:51.32,0:08:53.07,Default,,0,0,0,,Мен бұл қажет екеніне сенімдімін.
Dialogue: 0,0:08:53.19,0:08:55.07,Default,,0,0,0,,Сүлік шайтанның да ойы болуы керек.
Dialogue: 0,0:08:55.20,0:08:56.28,Default,,0,0,0,,Ой дегеніміз не?
Dialogue: 0,0:08:56.78,0:08:57.99,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:58.12,0:08:58.95,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:08:59.20,0:09:02.45,Default,,0,0,0,,Қарашы, Сенна да түсінбейді.
Dialogue: 0,0:09:04.96,0:09:06.92,Default,,0,0,0,,Американдық футболда сіз майданға шығуыңыз керек, солай ма?
Dialogue: 0,0:09:07.33,0:09:08.92,Default,,0,0,0,,Көз қалқаны жүгіреді
Dialogue: 0,0:09:09.04,0:09:10.92,Default,,0,0,0,,Мен тек рұқсатты алуым керек!
Dialogue: 0,0:09:11.13,0:09:12.67,Default,,0,0,0,,Оңға Барыңыз, артқа және айналаңыз
Dialogue: 0,0:09:12.80,0:09:15.47,Default,,0,0,0,,Мұның мәні неде? Мукики!
Dialogue: 0,0:09:15.59,0:09:18.47,Default,,0,0,0,,Сізге маршрут кестесі қажет емес!
Dialogue: 0,0:09:20.10,0:09:22.93,Default,,0,0,0,,Ах... Монта-кун Сена-кун
Dialogue: 0,0:09:23.06,0:09:25.06,Default,,0,0,0,,О, тоқтат! Тоқта!
Dialogue: 0,0:09:25.64,0:09:27.10,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:09:27.23,0:09:29.36,Default,,0,0,0,,Салқын рамен жейміз.
Dialogue: 0,0:09:29.48,0:09:30.90,Default,,0,0,0,,Ал... күте тұрыңыз!
Dialogue: 0,0:09:31.19,0:09:34.53,Default,,0,0,0,,Көрдіңіз бе, маршрут сөзінің мағынасы бар.
Dialogue: 0,0:09:34.65,0:09:36.11,Default,,0,0,0,,Тоқта, шошқашы.
Dialogue: 0,0:09:36.24,0:09:37.07,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:09:37.28,0:09:38.11,Default,,0,0,0,,Балалар!
Dialogue: 0,0:09:38.24,0:09:41.03,Default,,0,0,0,,Мағынасын шынымен білгің келсе, көрсетемін.
Dialogue: 0,0:09:41.24,0:09:42.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:43.45,0:09:44.75,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:45.91,0:09:46.75,Default,,0,0,0,,Хмф!
Dialogue: 0,0:09:47.71,0:09:49.71,Default,,0,0,0,,Я-! Ха-!
Dialogue: 0,0:09:55.84,0:09:59.43,Default,,0,0,0,,Токио турнирінің финалы қандай?
Dialogue: 0,0:10:00.09,0:10:02.01,Default,,0,0,0,,Бүгін финал өтті.
Dialogue: 0,0:10:02.14,0:10:04.47,Default,,0,0,0,,Сәйкестік картасы
Dialogue: 0,0:10:05.06,0:10:08.73,Default,,0,0,0,,Оджо Уайт Рыцарлары және Батыс жабайы зеңбірекшілер
Dialogue: 0,0:10:08.98,0:10:10.06,Default,,0,0,0,,Король сарайы!
Dialogue: 0,0:10:10.73,0:10:11.86,Default,,0,0,0,,Сусуму-сан
Dialogue: 0,0:10:14.86,0:10:15.69,Default,,0,0,0,,Уа, бұл шын!
Dialogue: 0,0:10:16.44,0:10:19.36,Default,,0,0,0,,О, Курита, қалайсың?
Dialogue: 0,0:10:19.61,0:10:20.91,Default,,0,0,0,,Құрметті Ібіліс жарғанақтары
Dialogue: 0,0:10:21.12,0:10:22.41,Default,,0,0,0,,Бұл жаудың жағдайын тексеру ме?
Dialogue: 0,0:10:22.78,0:10:24.37,Default,,0,0,0,,Жоқ, бұл
Dialogue: 0,0:10:24.62,0:10:27.79,Default,,0,0,0,,Қараңдаршы, біздің қорғанысымыз өтпейтін.
Dialogue: 0,0:10:27.91,0:10:30.00,Default,,0,0,0,,Мен Ганманға бір жұмбақ бермеймін.
Dialogue: 0,0:10:30.12,0:10:31.58,Default,,0,0,0,,Хунга~!
Dialogue: 0,0:10:32.04,0:10:33.34,Default,,0,0,0,,Біз сақтықты төмендете алмаймыз
Dialogue: 0,0:10:33.71,0:10:36.21,Default,,0,0,0,,Қарсылас – финалға өткен команда
Dialogue: 0,0:10:37.38,0:10:39.30,Default,,0,0,0,,Бар күшіңізбен соғыңыз.
Dialogue: 0,0:10:39.84,0:10:42.68,Default,,0,0,0,,Біреуін алып кетті, хаха...
Dialogue: 0,0:10:42.80,0:10:44.56,Default,,0,0,0,,Сусуму-сан күткендей.
Dialogue: 0,0:10:44.68,0:10:48.27,Default,,0,0,0,,Сусуму Оджода орналасқан. Жеңімпаз - Оджо!
Dialogue: 0,0:10:48.39,0:10:49.64,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:10:49.77,0:10:51.06,Default,,0,0,0,,Қарулы адамдар!
Dialogue: 0,0:10:51.31,0:10:52.90,Default,,0,0,0,,Зукюн Зукюн Зукюн!
Dialogue: 0,0:10:53.02,0:10:55.07,Default,,0,0,0,,Зукюн Зукюн…
Dialogue: 0,0:10:55.44,0:10:57.07,Default,,0,0,0,,Керемет қолдау!
Dialogue: 0,0:10:57.19,0:10:59.74,Default,,0,0,0,,Мұның бәрі сол режиссердің хоббиі сияқты.
Dialogue: 0,0:10:59.86,0:11:01.11,Default,,0,0,0,,Жарқыраған!
Dialogue: 0,0:11:01.45,0:11:02.28,Default,,0,0,0,,Хмф!
Dialogue: 0,0:11:02.41,0:11:04.95,Default,,0,0,0,,Жабайы жабайы қаруластар!
Dialogue: 0,0:11:05.08,0:11:06.79,Default,,0,0,0,,Тецуума оралуы!
Dialogue: 0,0:11:10.67,0:11:11.50,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:20.01,0:11:20.84,Default,,0,0,0,,Уф… Ах…
Dialogue: 0,0:11:20.97,0:11:24.39,Default,,0,0,0,,Бұл балалар Western Wild Gunmans ойыншылары ма?
Dialogue: 0,0:11:25.68,0:11:28.52,Default,,0,0,0,,Темір тұлпардың ұзындығы 40 ярд сызығы 5 секунд 0
Dialogue: 0,0:11:28.64,0:11:30.06,Default,,0,0,0,,Стендтік прес 115 кг
Dialogue: 0,0:11:30.35,0:11:32.31,Default,,0,0,0,,Сәлем! Керемет!
Dialogue: 0,0:11:32.44,0:11:35.02,Default,,0,0,0,,Бұл жігіттің таңғаларлығы жай сандар емес.
Dialogue: 0,0:11:35.36,0:11:36.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:36.32,0:11:37.27,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:11:38.23,0:11:40.32,Default,,0,0,0,,Тецубаджо теңдесі жоқ дәлдікпен жүгіреді.
Dialogue: 0,0:11:40.44,0:11:41.28,Default,,0,0,0,,«Темір тұлпар»
Dialogue: 0,0:11:41.40,0:11:42.99,Default,,0,0,0,,«Темір тұлпар» деп аталады.
Dialogue: 0,0:11:43.36,0:11:46.74,Default,,0,0,0,,Торакичи-кун Сакураба-санға! Келдің бе?
Dialogue: 0,0:11:47.08,0:11:49.95,Default,,0,0,0,,Аа, мен ауруханадан шығуға рұқсат алдым.
Dialogue: 0,0:11:50.08,0:11:52.71,Default,,0,0,0,,Бұл король сарайының финалдық матчы, әрине!
Dialogue: 0,0:11:53.08,0:11:55.50,Default,,0,0,0,,Бұл әлі де күлкілі әңгіме.
Dialogue: 0,0:11:56.09,0:11:59.09,Default,,0,0,0,,Тецууманың маршрутты ең жақсысы деп қанша айтылса да.
Dialogue: 0,0:11:59.21,0:12:00.67,Default,,0,0,0,,Король сарайы ешқашан жеңілмейді!
Dialogue: 0,0:12:01.63,0:12:03.13,Default,,0,0,0,,Түбір?
Dialogue: 0,0:12:04.34,0:12:07.10,Default,,0,0,0,,Не, балалар, сендер маршрутты да білмейсіңдер ме?
Dialogue: 0,0:12:07.43,0:12:09.85,Default,,0,0,0,,Жоқ, мен жолды білемін.
Dialogue: 0,0:12:10.22,0:12:13.27,Default,,0,0,0,,Мағынасын шынымен білгің келсе, көрсетемін.
Dialogue: 0,0:12:14.06,0:12:15.31,Default,,0,0,0,,Түбірдің мағынасы
Dialogue: 0,0:12:15.44,0:12:18.32,Default,,0,0,0,,Сіз бұл матчты көру арқылы айта аласыз ба?
Dialogue: 0,0:12:21.53,0:12:23.24,Default,,0,0,0,,О? (Монта) Бұл не?
Dialogue: 0,0:12:23.61,0:12:24.91,Default,,0,0,0,,Бұл шолақ мылтық.
Dialogue: 0,0:12:25.03,0:12:26.41,Default,,0,0,0,,шолақ мылтық?
Dialogue: 0,0:12:26.53,0:12:28.20,Default,,0,0,0,,Бұл шабуыл құрылымдарының бірі.
Dialogue: 0,0:12:28.78,0:12:30.70,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:12:32.08,0:12:33.66,Default,,0,0,0,,Хо хо хо хо хо...
Dialogue: 0,0:12:35.25,0:12:36.58,Default,,0,0,0,,Қиғаш темір тұлпар
Dialogue: 0,0:12:38.92,0:12:40.05,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:40.42,0:12:41.55,Default,,0,0,0,,Осымен.
Dialogue: 0,0:12:42.09,0:12:43.55,Default,,0,0,0,,Жол жүру құжатын қабылдайтын қабылдаушы
Dialogue: 0,0:12:43.67,0:12:46.14,Default,,0,0,0,,Мылтықтан атқан оқтай үзілсін
Dialogue: 0,0:12:46.26,0:12:48.76,Default,,0,0,0,,Керемет, бұл өтуге бағытталған стратегия.
Dialogue: 0,0:12:49.22,0:12:50.85,Default,,0,0,0,,Бұл ең жақсы!
Dialogue: 0,0:12:50.97,0:12:53.39,Default,,0,0,0,,Ақыр аяғында бұл рұқсат. Маршрут емес, өту!
Dialogue: 0,0:12:57.27,0:12:58.11,Default,,0,0,0,,Жалғыз Сусуму
Dialogue: 0,0:12:58.23,0:13:00.98,Default,,0,0,0,,Бұл қабылдағыштардың саны барлығын қамти алмайды
Dialogue: 0,0:13:03.24,0:13:05.03,Default,,0,0,0,,Хунга! Хунга~!
Dialogue: 0,0:13:05.28,0:13:06.28,Default,,0,0,0,,Егер ол қамтылмаған болса
Dialogue: 0,0:13:06.41,0:13:08.99,Default,,0,0,0,,Мен сені лақтырмас бұрын жаншып аламын! Хунга!
Dialogue: 0,0:13:09.37,0:13:11.41,Default,,0,0,0,,Үш адам қажет!
Dialogue: 0,0:13:11.74,0:13:12.83,Default,,0,0,0,,Ой!
Dialogue: 0,0:13:14.21,0:13:15.75,Default,,0,0,0,,Суге! (Куроки) Біздің ұстанымымыз
Dialogue: 0,0:13:15.87,0:13:16.83,Default,,0,0,0,,Мына жерде.
Dialogue: 0,0:13:17.75,0:13:18.75,Default,,0,0,0,,Мотивация бермеңіз!
Dialogue: 0,0:13:19.08,0:13:21.25,Default,,0,0,0,,Жол да әбден толық.
Dialogue: 0,0:13:21.38,0:13:22.21,Default,,0,0,0,,Фуго!
Dialogue: 0,0:13:23.76,0:13:25.72,Default,,0,0,0,,Эй, бұл да стратегия!
Dialogue: 0,0:13:33.35,0:13:34.48,Default,,0,0,0,,Керемет, Сусуму!
Dialogue: 0,0:13:34.60,0:13:36.94,Default,,0,0,0,,Жүр! Найзамен күресу!
Dialogue: 0,0:13:37.31,0:13:39.94,Default,,0,0,0,,Сусуму-сан күткендей, сіздің жылдамдығыңыз керемет.
Dialogue: 0,0:13:40.06,0:13:40.90,Default,,0,0,0,,Хмф!
Dialogue: 0,0:13:41.07,0:13:42.65,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:13:42.86,0:13:44.86,Default,,0,0,0,,Мақсатты табуға уақытыңыз жоқ.
Dialogue: 0,0:13:47.86,0:13:50.62,Default,,0,0,0,,Өкінішке орай, бүгінгі күн тым жақсы.
Dialogue: 0,0:13:51.53,0:13:52.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:52.49,0:13:53.41,Default,,0,0,0,,Не!
Dialogue: 0,0:13:53.54,0:13:54.54,Default,,0,0,0,,Мен көзімді жұмдым!
Dialogue: 0,0:13:57.04,0:13:59.29,Default,,0,0,0,,Көзімді жұмсам да, қайда екенімді көрмеймін
Dialogue: 0,0:14:02.21,0:14:05.38,Default,,0,0,0,,Маған ресивер іздеуге уақыт керек емес!
Dialogue: 0,0:14:15.68,0:14:16.52,Default,,0,0,0,,Хмф!
Dialogue: 0,0:14:19.40,0:14:20.52,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:20.65,0:14:21.73,Default,,0,0,0,,Қозғалыс жылдам!
Dialogue: 0,0:14:24.69,0:14:27.40,Default,,0,0,0,,Бірақ допты мұндай жерге лақтыру үлкен қателік болар еді.
Dialogue: 0,0:14:27.70,0:14:29.07,Default,,0,0,0,,Жоқ! Бұл Slant!
Dialogue: 0,0:14:34.70,0:14:36.58,Default,,0,0,0,,Қозғалыс!
Dialogue: 0,0:14:36.70,0:14:39.04,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:14:43.17,0:14:44.09,Default,,0,0,0,,Хаха
Dialogue: 0,0:14:45.09,0:14:46.67,Default,,0,0,0,,Балаға жақсы билет!
Dialogue: 0,0:14:46.80,0:14:47.97,Default,,0,0,0,,Темір тұлпар жақсы ұстады!
Dialogue: 0,0:14:48.30,0:14:50.05,Default,,0,0,0,,Бұл... Сусуму-сан ба?
Dialogue: 0,0:14:50.18,0:14:51.76,Default,,0,0,0,,Мен бұл көлбеу екеніне сенімдімін.
Dialogue: 0,0:14:51.89,0:14:52.89,Default,,0,0,0,,Түбір
Dialogue: 0,0:14:53.01,0:14:56.77,Default,,0,0,0,,Сол темір тұлпар белгіленген рельсте 10 сантиметрге қалыспай жүгіреді.
Dialogue: 0,0:14:56.89,0:14:59.94,Default,,0,0,0,,Басқаша айтқанда, сіз алыс емессіз, мақсатқа тура келдіңіз.
Dialogue: 0,0:15:00.35,0:15:02.23,Default,,0,0,0,,Оджо, қолыңнан келгеннің бәрін істе!
Dialogue: 0,0:15:03.44,0:15:04.86,Default,,0,0,0,,Зукюн Зукюн Зукюн!
Dialogue: 0,0:15:05.40,0:15:06.44,Default,,0,0,0,,Фу~
Dialogue: 0,0:15:07.61,0:15:09.32,Default,,0,0,0,,Жылдам атушы баланы сынамаңыз
Dialogue: 0,0:15:14.07,0:15:14.95,Default,,0,0,0,,Ұзын пост
Dialogue: 0,0:15:15.83,0:15:17.41,Default,,0,0,0,,
Dialogue: 0,0:15:17.54,0:15:18.66,Default,,0,0,0,,Төртбұрыштан шығарыңыз!
Dialogue: 0,0:15:19.08,0:15:20.71,Default,,0,0,0,,
Dialogue: 0,0:15:23.63,0:15:25.00,Default,,0,0,0,,Сену қиын
Dialogue: 0,0:15:25.42,0:15:27.34,Default,,0,0,0,,Мен патша сарайының жеңіліп жатқанына сене алар емеспін.
Dialogue: 0,0:15:27.46,0:15:29.01,Default,,0,0,0,,Егер сіз маршрутты дәл жүргізе алсаңыз
Dialogue: 0,0:15:29.51,0:15:34.47,Default,,0,0,0,,Отавара-кун немесе Сусуму-кун бар ма, асу өтеді, солай ма?
Dialogue: 0,0:15:34.68,0:15:36.93,Default,,0,0,0,,Жол жүру рұқсаты шексіз екені рас.
Dialogue: 0,0:15:37.22,0:15:38.47,Default,,0,0,0,,Мұқият қараңыз
Dialogue: 0,0:15:38.60,0:15:41.39,Default,,0,0,0,,«Мылтықшылар» финалға дейін жетті.
Dialogue: 0,0:15:42.31,0:15:45.36,Default,,0,0,0,,Хиру-сан айтып отырған жолдың мағынасы осы.
Dialogue: 0,0:15:45.69,0:15:47.69,Default,,0,0,0,,Бірақ бұл екінші жартысы сияқты.
Dialogue: 0,0:15:47.82,0:15:49.53,Default,,0,0,0,,Мен бұлай болатынын сеземін.
Dialogue: 0,0:15:49.65,0:15:52.36,Default,,0,0,0,,Не айтып тұрсың! Екінші таймда қатты шабуыл жасаймыз!
Dialogue: 0,0:15:52.91,0:15:53.99,Default,,0,0,0,,Өйткені, бізде бар
Dialogue: 0,0:15:54.11,0:15:56.33,Default,,0,0,0,,Жылдам атылатын бала мен темір тұлпар бар!
Dialogue: 0,0:15:56.62,0:15:58.41,Default,,0,0,0,,Темір тұлпар Теме – кілт!
Dialogue: 0,0:15:58.54,0:16:00.79,Default,,0,0,0,,Ылғалдылықты сақтаңыз!
Dialogue: 0,0:16:01.12,0:16:02.08,Default,,0,0,0,,Крест!
Dialogue: 0,0:16:02.79,0:16:03.87,Default,,0,0,0,,Хо хо хо...
Dialogue: 0,0:16:04.63,0:16:07.13,Default,,0,0,0,,Гяхаха! Нағыз темір тұлпар!
Dialogue: 0,0:16:07.25,0:16:09.42,Default,,0,0,0,,Пойыздың бағытын ешкім өзгерте алмайды!
Dialogue: 0,0:16:09.84,0:16:12.42,Default,,0,0,0,,Бірақ тым жақсы болса, жақсы болмайды.
Dialogue: 0,0:16:13.88,0:16:16.35,Default,,0,0,0,,Ал, өткен жылдың сұмдық болғаны рас.
Dialogue: 0,0:16:16.68,0:16:19.93,Default,,0,0,0,,«Кіріңіз!» – дедім, ол үш күн бойы жүгіре берді.
Dialogue: 0,0:16:20.06,0:16:23.44,Default,,0,0,0,,Мен пайдасыз болып, бірінші айналымда шығып қалдым.
Dialogue: 0,0:16:23.64,0:16:28.15,Default,,0,0,0,,Ол өз бұйрығын адал орындайды, сондықтан биылғы жыл да қауіпті болды.
Dialogue: 0,0:16:28.27,0:16:30.57,Default,,0,0,0,,Жарайды, мен етті көп жедім.
Dialogue: 0,0:16:30.86,0:16:31.69,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:31.82,0:16:34.41,Default,,0,0,0,,Жарайды, егер бірінші жартысы сияқты болса, алаңдаудың қажеті жоқ.
Dialogue: 0,0:16:34.53,0:16:36.95,Default,,0,0,0,,Мен сізге өзіңізді ылғалды ұстаңыз дедім.
Dialogue: 0,0:16:37.07,0:16:37.91,Default,,0,0,0,,Ганган?
Dialogue: 0,0:16:39.66,0:16:40.54,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:41.66,0:16:44.58,Default,,0,0,0,,Әй, жақсысың ба?
Dialogue: 0,0:16:44.96,0:16:47.46,Default,,0,0,0,,Жақында екінші жартысы басталады.
Dialogue: 0,0:16:52.72,0:16:54.26,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:16:54.88,0:16:55.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:55.88,0:16:58.76,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:16:59.47,0:17:00.43,Default,,0,0,0,,Хмм~
Dialogue: 0,0:17:00.56,0:17:02.35,Default,,0,0,0,,Та... Уақыт бітті!
Dialogue: 0,0:17:02.77,0:17:04.64,Default,,0,0,0,,(Дәретхананың ағу дыбысы)
Dialogue: 0,0:17:04.77,0:17:07.23,Default,,0,0,0,,Тецуума Бүгін мүмкін емес пе?
Dialogue: 0,0:17:07.35,0:17:08.65,Default,,0,0,0,,Бұл мүмкін емес сияқты.
Dialogue: 0,0:17:09.44,0:17:11.23,Default,,0,0,0,,Темір тұлпар болмаса не істер едің?
Dialogue: 0,0:17:11.36,0:17:12.23,Default,,0,0,0,,Не айтып тұрсың!
Dialogue: 0,0:17:12.36,0:17:13.65,Default,,0,0,0,,Сіз жетекшісіз!
Dialogue: 0,0:17:13.78,0:17:14.74,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:17:14.86,0:17:16.57,Default,,0,0,0,,Қараңдар, мен айттым ғой.
Dialogue: 0,0:17:16.70,0:17:18.57,Default,,0,0,0,,Тым жақсы болса, жақсы болмайды.
Dialogue: 0,0:17:18.74,0:17:20.37,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:17:24.58,0:17:25.91,Default,,0,0,0,,
Dialogue: 0,0:17:27.29,0:17:28.63,Default,,0,0,0,,Ойын аяқталды!
Dialogue: 0,0:17:28.75,0:17:30.79,Default,,0,0,0,,Көктемгі Токио турнирінің жеңімпазы
Dialogue: 0,0:17:30.92,0:17:32.88,Default,,0,0,0,,Оджо Ақ түндер!
Dialogue: 0,0:17:33.38,0:17:35.05,Default,,0,0,0,,Тецуума-кун қалса
Dialogue: 0,0:17:35.17,0:17:37.47,Default,,0,0,0,,Жабайы мылтықшылар жеңген болуы мүмкін.
Dialogue: 0,0:17:37.72,0:17:39.89,Default,,0,0,0,,Мұндай мықтылар күзгі турнирде де болады
Dialogue: 0,0:17:40.01,0:17:42.93,Default,,0,0,0,,Жеңіске жету үшін осы жігіттердің барлығын жеңу керек пе?
Dialogue: 0,0:17:43.06,0:17:44.85,Default,,0,0,0,,Батыр болу жолы қиын.
Dialogue: 0,0:17:45.14,0:17:46.52,Default,,0,0,0,,Батыр кім?
Dialogue: 0,0:17:46.64,0:17:48.31,Default,,0,0,0,,Хирохиро ең жақсы жағдайда жиіркенішті
Dialogue: 0,0:17:48.52,0:17:50.06,Default,,0,0,0,,Ммм... Кики!
Dialogue: 0,0:17:50.65,0:17:52.48,Default,,0,0,0,,Күтілгендей, Сакураба жоқ.
Dialogue: 0,0:17:52.61,0:17:55.32,Default,,0,0,0,,Тіпті патша сарайы да түтіккен сидрге ұқсайды.
Dialogue: 0,0:17:55.90,0:17:57.11,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:57.78,0:18:00.20,Default,,0,0,0,,Күзгі турнирге дейін бәрін өз орнына қойыңыз.
Dialogue: 0,0:18:00.87,0:18:02.16,Default,,0,0,0,,Финалда күту
Dialogue: 0,0:18:02.41,0:18:03.24,Default,,0,0,0,,Сусуму-сан!
Dialogue: 0,0:18:03.49,0:18:04.79,Default,,0,0,0,,Тарундуру!
Dialogue: 0,0:18:04.91,0:18:06.87,Default,,0,0,0,,20 ұпай алу қандай ұят!
Dialogue: 0,0:18:07.41,0:18:10.00,Default,,0,0,0,,Психикалық немқұрайлылық осындай нәтижеге әкелді.
Dialogue: 0,0:18:10.13,0:18:12.88,Default,,0,0,0,,Мен осындай нәрсемен Рождестволық ыдысқа бара аламын ба?
Dialogue: 0,0:18:13.09,0:18:14.88,Default,,0,0,0,,Иә (Шодзи) Даусыңыз кішкентай!
Dialogue: 0,0:18:15.01,0:18:15.84,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:17.63,0:18:19.34,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:18:19.47,0:18:21.30,Default,,0,0,0,,Мұндай дөрекі сәйкестік
Dialogue: 0,0:18:22.55,0:18:23.76,Default,,0,0,0,,Сусуму Жақсы жұмыс
Dialogue: 0,0:18:28.35,0:18:30.98,Default,,0,0,0,,Сол патша сарайы осылайша бұрышта болды.
Dialogue: 0,0:18:33.19,0:18:34.94,Default,,0,0,0,,Сусумуға не болды?
Dialogue: 0,0:18:35.07,0:18:36.69,Default,,0,0,0,,Ой, мен үйге жүгіріп келе жатырмын.
Dialogue: 0,0:18:37.07,0:18:37.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:38.03,0:18:39.78,Default,,0,0,0,,Ол неше килограмм деп ойлайсың?
Dialogue: 0,0:18:39.91,0:18:42.16,Default,,0,0,0,,Мен оған мүлдем ұқсамаймын.
Dialogue: 0,0:18:42.28,0:18:43.70,Default,,0,0,0,,Жоқ! Ол кетті!
Dialogue: 0,0:18:48.66,0:18:51.29,Default,,0,0,0,,Иә? Мүмкін Сусуму-сан?
Dialogue: 0,0:18:52.25,0:18:53.29,Default,,0,0,0,,Не болды, Сена?
Dialogue: 0,0:18:53.46,0:18:54.84,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:18:54.96,0:18:57.13,Default,,0,0,0,,Бұл түстен кейінгі жаттығуға тамаша мүмкіндік.
Dialogue: 0,0:18:57.26,0:18:59.01,Default,,0,0,0,,Үйге жүгіру керек пе?
Dialogue: 0,0:18:59.88,0:19:01.59,Default,,0,0,0,,Сіз өте ынталысыз.
Dialogue: 0,0:19:01.72,0:19:04.97,Default,,0,0,0,,Сен Сенна болсаң, бұл ақылсыз. Сіз шаршайсыз, солай ма?
Dialogue: 0,0:19:05.39,0:19:06.22,Default,,0,0,0,,Е...
Dialogue: 0,0:19:07.47,0:19:08.77,Default,,0,0,0,,Бұл көлбеу ме?
Dialogue: 0,0:19:09.39,0:19:11.48,Default,,0,0,0,,Демек, бұл түбір! Түбір!
Dialogue: 0,0:19:11.60,0:19:13.19,Default,,0,0,0,,Керемет болды
Dialogue: 0,0:19:13.31,0:19:16.53,Default,,0,0,0,,Өтпелі жол сілкіп өтті.
Dialogue: 0,0:19:16.65,0:19:18.32,Default,,0,0,0,,Мен оны салқын түрде ұстауым үшін
Dialogue: 0,0:19:18.49,0:19:20.28,Default,,0,0,0,,Маған түбір керек екенін білемін.
Dialogue: 0,0:19:20.40,0:19:21.95,Default,,0,0,0,,Бұдан былай максималды маршрут!
Dialogue: 0,0:19:22.36,0:19:23.53,Default,,0,0,0,,Монта
Dialogue: 0,0:19:24.74,0:19:27.08,Default,,0,0,0,,Ей, кеттік! иә!
Dialogue: 0,0:19:28.37,0:19:29.45,Default,,0,0,0,,Көлбеу!
Dialogue: 0,0:19:29.62,0:19:30.46,Default,,0,0,0,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,0:19:31.04,0:19:31.92,Default,,0,0,0,,Тетте
Dialogue: 0,0:19:32.04,0:19:33.17,Default,,0,0,0,,Екеуің де жақсысыңдар ма?
Dialogue: 0,0:19:33.46,0:19:34.50,Default,,0,0,0,,Көлбеу
Dialogue: 0,0:19:34.63,0:19:36.63,Default,,0,0,0,,Түзу жүріп, бұрыл!
Dialogue: 0,0:19:36.75,0:19:38.17,Default,,0,0,0,,Бұл бір тілім
Dialogue: 0,0:19:38.34,0:19:40.22,Default,,0,0,0,,Өйткені көлбеу түзу және солға
Dialogue: 0,0:19:40.34,0:19:41.55,Default,,0,0,0,,Монта-кун дұрыс емес!
Dialogue: 0,0:19:41.68,0:19:43.18,Default,,0,0,0,,Кешіріңіз Макс
Dialogue: 0,0:19:43.30,0:19:45.47,Default,,0,0,0,,Осындай нәрсе жақсы.
Dialogue: 0,0:19:45.60,0:19:46.89,Default,,0,0,0,,Бұл жай ғана солай емес пе?
Dialogue: 0,0:19:47.01,0:19:49.52,Default,,0,0,0,,Сенна, міндетті түрде жең! Иә
Dialogue: 0,0:19:49.64,0:19:51.39,Default,,0,0,0,,Мен Рождестволық ыдысқа барамын.
Dialogue: 0,0:19:51.52,0:19:52.52,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:54.02,0:20:00.03,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:21:02.84,0:21:08.85,Default,,0,0,0,,~♪
Dialogue: 0,0:21:09.85,0:21:11.14,Default,,0,0,0,,Уау, бұл керемет!
Dialogue: 0,0:21:11.43,0:21:12.93,Default,,0,0,0,,Бұл қандай балалар?
Dialogue: 0,0:21:13.06,0:21:14.27,Default,,0,0,0,,Күн сфинксі
Dialogue: 0,0:21:14.64,0:21:16.14,Default,,0,0,0,,Сүлік шайтанның айласымен
Dialogue: 0,0:21:16.27,0:21:19.77,Default,,0,0,0,,Жапония өкілін анықтау үшін матчта бізге қарсы ойнайтыныңызды естідім.
Dialogue: 0,0:21:19.90,0:21:23.07,Default,,0,0,0,,Эй Джумонжи, мотивация бер!
Dialogue: 0,0:21:23.36,0:21:25.61,Default,,0,0,0,,Келесі жолы «Көз қалқаны 21»
Dialogue: 0,0:21:27.45,0:21:28.74,Default,,0,0,0,,Я-! Ха-!
Dialogue: 0,0:21:30.24,0:21:36.24,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory