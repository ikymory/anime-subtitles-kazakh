Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.83,0:00:06.25,Default,,0,0,0,,Енді матч ақыры шарықтау шегіне жетті.
Dialogue: 0,0:00:06.33,0:00:10.51,Default,,0,0,0,,Синрюжи Temple 35 ұпаймен және Деймон 28 ұпаймен көш бастады
Dialogue: 0,0:00:10.59,0:00:12.05,Default,,0,0,0,,Егер сіз допқа қол жеткізсеңіз
Dialogue: 0,0:00:12.13,0:00:15.34,Default,,0,0,0,,Deimon Devil Bats-тің есепті теңестіру мүмкіндігі бар
Dialogue: 0,0:00:15.43,0:00:17.39,Default,,0,0,0,,Бізде көп уақыт қалмады.
Dialogue: 0,0:00:17.47,0:00:18.43,Default,,0,0,0,,Қалғаны...
Dialogue: 0,0:00:18.51,0:00:19.35,Default,,0,0,0,,Һм? Ой!
Dialogue: 0,0:00:19.43,0:00:21.10,Default,,0,0,0,,Бар болғаны 58 секунд!
Dialogue: 0,0:00:21.18,0:00:23.23,Default,,0,0,0,,Бүгінгі Рико-чан әйтеуір әдемі
Dialogue: 0,0:00:23.31,0:00:25.65,Default,,0,0,0,,58 секунд қалды ма?
Dialogue: 0,0:00:25.73,0:00:28.73,Default,,0,0,0,,97 ярд қалды
Dialogue: 0,0:00:28.82,0:00:31.82,Default,,0,0,0,,Бірақ мен ешқашан берілмеймін
Dialogue: 0,0:00:31.90,0:00:34.03,Default,,0,0,0,,Шинрюджи храмында жеңіске жет!
Dialogue: 0,0:00:35.03,0:00:39.62,Default,,0,0,0,,♪~
Dialogue: 0,0:01:54.94,0:01:59.95,Default,,0,0,0,,~♪
Dialogue: 0,0:02:07.46,0:02:08.96,Default,,0,0,0,,Сіз түсінбейсіз.
Dialogue: 0,0:02:09.58,0:02:10.96,Default,,0,0,0,,Допты қолында ұстаған адам
Dialogue: 0,0:02:11.04,0:02:13.46,Default,,0,0,0,,Өлетін болса да, жаншылғанша шық!
Dialogue: 0,0:02:14.17,0:02:17.17,Default,,0,0,0,,Алаңның сыртына шықсаңыз, сағат тілі тоқтайды.
Dialogue: 0,0:02:17.26,0:02:18.09,Default,,0,0,0,,Хмм
Dialogue: 0,0:02:18.17,0:02:20.09,Default,,0,0,0,,Бар болғаны 58 секунд қалды
Dialogue: 0,0:02:20.18,0:02:23.22,Default,,0,0,0,,97 ярд Оны итермелеу ақымақтық.
Dialogue: 0,0:02:23.30,0:02:26.35,Default,,0,0,0,,Қалай болғанда да сағатты бірінен соң бірі тоқтатқаннан басқа амалым жоқ.
Dialogue: 0,0:02:28.35,0:02:31.15,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:02:31.23,0:02:32.52,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:02:34.11,0:02:35.44,Default,,0,0,0,,Орнату! қалпақ!
Dialogue: 0,0:02:35.53,0:02:37.86,Default,,0,0,0,,(барлық күш айқайлары)
Dialogue: 0,0:02:38.40,0:02:41.82,Default,,0,0,0,,Енді, Деймон Ібіліс Жарғанаттар, тағдырдың соңғы шабуылы
Dialogue: 0,0:02:41.91,0:02:45.29,Default,,0,0,0,,Бұл Eyeshield 21 жүгіруінен басталды!
Dialogue: 0,0:02:50.08,0:02:52.50,Default,,0,0,0,,Тек жүгіре бер және даладан шық!
Dialogue: 0,0:02:53.17,0:02:54.21,Default,,0,0,0,,Мен саған бұлай істеуге рұқсат бермеймін.
Dialogue: 0,0:02:56.00,0:02:58.88,Default,,0,0,0,,Синрюджи ойыншылары алаңның шетінде!
Dialogue: 0,0:02:59.76,0:03:00.59,Default,,0,0,0,,Жолдан кет! (Ойыншы) Сонымен...
Dialogue: 0,0:03:00.68,0:03:02.97,Default,,0,0,0,,Ішінде өл!
Dialogue: 0,0:03:03.05,0:03:04.30,Default,,0,0,0,,Даа!
Dialogue: 0,0:03:04.39,0:03:05.47,Default,,0,0,0,,
Dialogue: 0,0:03:05.56,0:03:06.81,Default,,0,0,0,,Әй, Сена-кун!
Dialogue: 0,0:03:06.89,0:03:07.93,Default,,0,0,0,,Сенна!
Dialogue: 0,0:03:08.02,0:03:11.39,Default,,0,0,0,,Ол далада жеңілді... Демек!
Dialogue: 0,0:03:15.15,0:03:16.94,Default,,0,0,0,,Сағат тоқтамайды!
Dialogue: 0,0:03:17.03,0:03:18.86,Default,,0,0,0,,Жаман, жаман, жаман!
Dialogue: 0,0:03:18.94,0:03:20.82,Default,,0,0,0,,Сағатты тез тоқтатыңыз!
Dialogue: 0,0:03:20.90,0:03:23.70,Default,,0,0,0,,Сәлем! Бірақ енді тайм-аут жоқ!
Dialogue: 0,0:03:24.28,0:03:25.66,Default,,0,0,0,,Спайк!
Dialogue: 0,0:03:25.74,0:03:26.87,Default,,0,0,0,,Ha
Dialogue: 0,0:03:26.95,0:03:29.16,Default,,0,0,0,,Ха... аааааааа
Dialogue: 0,0:03:29.70,0:03:32.04,Default,,0,0,0,,Ух... С... Масақ туралы айтсақ.
Dialogue: 0,0:03:32.12,0:03:33.58,Default,,0,0,0,,Жоқ... жоқ! Уф
Dialogue: 0,0:03:33.67,0:03:35.63,Default,,0,0,0,,Еріншек болмаңдар, бейбақтар!
Dialogue: 0,0:03:35.71,0:03:36.54,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:03:36.63,0:03:38.71,Default,,0,0,0,,Орнату! қалпақ!
Dialogue: 0,0:03:40.97,0:03:41.80,Default,,0,0,0,,Уф!
Dialogue: 0,0:03:41.88,0:03:45.51,Default,,0,0,0,,Хилл Демон кенет допты аяғыма лақтырды!
Dialogue: 0,0:03:45.60,0:03:47.60,Default,,0,0,0,,Иә? Не істеп жатырсың, аға?
Dialogue: 0,0:03:47.68,0:03:50.14,Default,,0,0,0,,Деймон Ібіліс жарғанаттарының өту сәтсіздігі
Dialogue: 0,0:03:50.22,0:03:52.56,Default,,0,0,0,,Осы жерде сағат тілі тоқтайды.
Dialogue: 0,0:03:53.69,0:03:54.52,Default,,0,0,0,,Я...
Dialogue: 0,0:03:54.60,0:03:55.69,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:55.77,0:03:59.32,Default,,0,0,0,,Егер өту сәтсіз болса, сағат әзірше тоқтайды.
Dialogue: 0,0:03:59.40,0:04:02.74,Default,,0,0,0,,Спайк пасты әдейі өткізіп алды.
Dialogue: 0,0:04:02.82,0:04:05.28,Default,,0,0,0,,Бір құнды шабуыл құқығынан бас тарту үшін
Dialogue: 0,0:04:05.37,0:04:06.95,Default,,0,0,0,,Сағатты тоқтату техникасы
Dialogue: 0,0:04:07.03,0:04:09.04,Default,,0,0,0,,Бұл шынында да екі жүзді қылыш.
Dialogue: 0,0:04:09.12,0:04:11.29,Default,,0,0,0,,Күту уақытын қазір пайдалану мүмкін емес
Dialogue: 0,0:04:11.37,0:04:16.33,Default,,0,0,0,,Бұл Деймонның өз стратегиясын жоспарлаудың жалғыз жолы.
Dialogue: 0,0:04:16.42,0:04:17.25,Default,,0,0,0,,Құт
Dialogue: 0,0:04:18.09,0:04:20.84,Default,,0,0,0,,Менің уақытым жоқ, бірақ тізем...
Dialogue: 0,0:04:20.92,0:04:22.97,Default,,0,0,0,,2 шабуыл сәтсіз аяқталды ма?
Dialogue: 0,0:04:23.05,0:04:26.43,Default,,0,0,0,,Шіркін, бұл анық, бірақ мен айтарлықтай алға жылжымадым.
Dialogue: 0,0:04:26.51,0:04:30.39,Default,,0,0,0,,Бар болғаны 49 секунд қалды.
Dialogue: 0,0:04:30.97,0:04:33.64,Default,,0,0,0,,Сіздің тізеңіз жақсы ма? Сена-кун аа...
Dialogue: 0,0:04:34.94,0:04:35.90,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:36.52,0:04:39.61,Default,,0,0,0,,Мен қазір тізем туралы ештеңе айта алмаймын.
Dialogue: 0,0:04:39.69,0:04:41.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:42.32,0:04:44.53,Default,,0,0,0,,Мен үшін жақсы
Dialogue: 0,0:04:44.61,0:04:46.41,Default,,0,0,0,,Аха~ха
Dialogue: 0,0:04:46.49,0:04:47.66,Default,,0,0,0,,Сенна
Dialogue: 0,0:04:47.74,0:04:49.58,Default,,0,0,0,,Sena-kun
Dialogue: 0,0:04:49.66,0:04:51.24,Default,,0,0,0,,Барлығы (Монта және басқалар) Иә?
Dialogue: 0,0:04:51.33,0:04:53.33,Default,,0,0,0,,Сенаны бар күшімізбен қорғайық!
Dialogue: 0,0:04:53.41,0:04:54.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:54.71,0:04:56.79,Default,,0,0,0,,Маған үнемі Сена-кун көмектеседі.
Dialogue: 0,0:04:57.67,0:05:01.00,Default,,0,0,0,,Енді Сенаға көмектесу кезегі бізде!
Dialogue: 0,0:05:01.63,0:05:02.59,Default,,0,0,0,,Курита мырза
Dialogue: 0,0:05:02.67,0:05:05.84,Default,,0,0,0,,Кеттік! Уайымдама, Сенна.
Dialogue: 0,0:05:06.47,0:05:07.97,Default,,0,0,0,,Әрине, Сена.
Dialogue: 0,0:05:08.05,0:05:10.18,Default,,0,0,0,,Біз сол үшін келдік пе?
Dialogue: 0,0:05:10.26,0:05:12.52,Default,,0,0,0,,Үлкен тесік ашсаң!
Dialogue: 0,0:05:12.60,0:05:13.85,Default,,0,0,0,,Аха~ха~!
Dialogue: 0,0:05:13.93,0:05:15.77,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:05:15.85,0:05:19.44,Default,,0,0,0,,Иә, жалғыз мен ғана қиналған жоқпын.
Dialogue: 0,0:05:19.52,0:05:21.27,Default,,0,0,0,,Мен шағымдана алмаймын
Dialogue: 0,0:05:21.36,0:05:22.65,Default,,0,0,0,,Иә
Dialogue: 0,0:05:22.73,0:05:24.61,Default,,0,0,0,,Қазіргі пьеса босқа кетті.
Dialogue: 0,0:05:24.69,0:05:27.32,Default,,0,0,0,,Олардың қорғаныс жүйесін тексеру.
Dialogue: 0,0:05:27.41,0:05:28.99,Default,,0,0,0,,Келесі…
Dialogue: 0,0:05:30.95,0:05:36.25,Default,,0,0,0,,Шинрюджидің қорғанысы сыртқы аймақта толығымен бекітілді.
Dialogue: 0,0:05:39.29,0:05:40.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:40.33,0:05:41.92,Default,,0,0,0,,Уау (төбе шайтан) Қарғыс атқыр деко!
Dialogue: 0,0:05:42.67,0:05:45.17,Default,,0,0,0,,Келесі ойында қатарда болыңыз!
Dialogue: 0,0:05:45.26,0:05:46.92,Default,,0,0,0,,Хе-хе-хе
Dialogue: 0,0:05:47.01,0:05:49.09,Default,,0,0,0,,Не, Юки-сан?
Dialogue: 0,0:05:49.18,0:05:50.51,Default,,0,0,0,,Жол!?
Dialogue: 0,0:05:51.85,0:05:52.97,Default,,0,0,0,,Орнату!
Dialogue: 0,0:05:53.06,0:05:54.52,Default,,0,0,0,,Әлгі сүлгі жын
Dialogue: 0,0:05:54.60,0:05:58.02,Default,,0,0,0,,Мен олардың осылайша шабуылын жалғастыратынына сенбеймін.
Dialogue: 0,0:05:58.10,0:05:59.98,Default,,0,0,0,,Мен олардың бірдеңе істейтініне сенімдімін.
Dialogue: 0,0:06:01.27,0:06:02.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:02.52,0:06:07.61,Default,,0,0,0,,Шляпа! қалпақ! қалпақ! қалпақ!
Dialogue: 0,0:06:08.70,0:06:10.11,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:06:11.62,0:06:13.03,Default,,0,0,0,,Ах (Агон) А?
Dialogue: 0,0:06:13.12,0:06:16.83,Default,,0,0,0,,Ой, Юкимицу-кун, Курита-кун мен ортадағы басқалардың артына өт.
Dialogue: 0,0:06:17.66,0:06:20.21,Default,,0,0,0,,Ережелер кітабы 7-бөлім 1-тарау 3-бап
Dialogue: 0,0:06:20.29,0:06:23.34,Default,,0,0,0,,Алдыңғы шептегі 7 адамнан басқа кез келген адам бір адам пайдалана алады.
Dialogue: 0,0:06:23.42,0:06:24.55,Default,,0,0,0,,Ол қозғалыстағы деп аталады.
Dialogue: 0,0:06:24.63,0:06:27.59,Default,,0,0,0,,Қозғалыс кезінде ойнауды бастауға болады
Dialogue: 0,0:06:28.22,0:06:29.55,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:06:30.18,0:06:33.18,Default,,0,0,0,,Олардың міндеті - Eyeshield жүгіруіне дайындалу.
Dialogue: 0,0:06:33.26,0:06:35.31,Default,,0,0,0,,Сыртқы аймақты қорғау
Dialogue: 0,0:06:35.39,0:06:39.77,Default,,0,0,0,,Сонымен, Юкимицу орталыққа жылжыса да, оны ешкім аңдый алмайды.
Dialogue: 0,0:06:39.85,0:06:43.23,Default,,0,0,0,,Шляпа! қалпақ! қалпақ!
Dialogue: 0,0:06:44.52,0:06:45.78,Default,,0,0,0,,(барлық күш айқайлары)
Dialogue: 0,0:06:45.86,0:06:48.78,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:06:48.86,0:06:50.74,Default,,0,0,0,,Тек бір Юки-санды қосқанда...
Dialogue: 0,0:06:50.82,0:06:54.20,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:06:54.99,0:06:56.99,Default,,0,0,0,,Орталықтан өтетін адам санының артықшылығы!
Dialogue: 0,0:06:57.08,0:06:58.41,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:59.33,0:07:01.71,Default,,0,0,0,,Гвааах!
Dialogue: 0,0:07:02.33,0:07:05.92,Default,,0,0,0,,Ібіліс жарғанаттары Қарсылас жұқа болған ортаға адамдарды жинады
Dialogue: 0,0:07:06.00,0:07:09.88,Default,,0,0,0,,Күш шайқасының кілті ретінде ең әлсіз Юкимицуды қолданғыңыз келе ме?
Dialogue: 0,0:07:09.97,0:07:12.64,Default,,0,0,0,,Оны дәл ортасынан сындырыңыз!
Dialogue: 0,0:07:12.72,0:07:14.97,Default,,0,0,0,,Сенаға жол аш!
Dialogue: 0,0:07:15.05,0:07:15.89,Default,,0,0,0,,Фугоцу
Dialogue: 0,0:07:16.72,0:07:20.31,Default,,0,0,0,,Көп адам, аз болса да, үлкен қысым
Dialogue: 0,0:07:20.39,0:07:23.60,Default,,0,0,0,,Бірақ аз болса да, Сенаға күшіңді беремін.
Dialogue: 0,0:07:23.69,0:07:25.86,Default,,0,0,0,,Корпус бұрандасы...
Dialogue: 0,0:07:25.94,0:07:27.02,Default,,0,0,0,,Қуатпен…
Dialogue: 0,0:07:27.11,0:07:28.11,Default,,0,0,0,,Бұзыңыз!
Dialogue: 0,0:07:28.19,0:07:29.32,Default,,0,0,0,,Сенна!
Dialogue: 0,0:07:29.99,0:07:32.28,Default,,0,0,0,,Оооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооуу
Dialogue: 0,0:07:32.99,0:07:35.62,Default,,0,0,0,,Сызық қабырғасы сынған!
Dialogue: 0,0:07:36.28,0:07:37.58,Default,,0,0,0,,Уф... уф!
Dialogue: 0,0:07:39.20,0:07:40.50,Default,,0,0,0,,Tsk...heh!
Dialogue: 0,0:07:41.25,0:07:42.12,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:42.21,0:07:44.13,Default,,0,0,0,,О! Гррр...
Dialogue: 0,0:07:44.21,0:07:45.79,Default,,0,0,0,,Хаха…
Dialogue: 0,0:07:45.88,0:07:47.09,Default,,0,0,0,,Ha
Dialogue: 0,0:07:47.84,0:07:49.84,Default,,0,0,0,,Балшық қақпасы 8 ярд алға
Dialogue: 0,0:07:49.92,0:07:51.80,Default,,0,0,0,,Бірінші төмен түсу (Агон)
Dialogue: 0,0:07:51.88,0:07:52.97,Default,,0,0,0,,Жарайды, а!
Dialogue: 0,0:07:53.05,0:07:54.30,Default,,0,0,0,,Сен, жансыз құрал—
Dialogue: 0,0:07:55.14,0:07:56.72,Default,,0,0,0,,Хааа~
Dialogue: 0,0:07:56.80,0:07:58.01,Default,,0,0,0,,Сена-кун!
Dialogue: 0,0:07:58.64,0:07:59.97,Default,,0,0,0,,Хмм... хаха
Dialogue: 0,0:08:00.60,0:08:02.06,Default,,0,0,0,,Бірінші төмен түсу үшін.
Dialogue: 0,0:08:02.14,0:08:03.73,Default,,0,0,0,,Сағат бір рет тоқтайды.
Dialogue: 0,0:08:03.81,0:08:08.27,Default,,0,0,0,,45 секунд қалды, мақсатқа 87 ярд.
Dialogue: 0,0:08:09.19,0:08:11.19,Default,,0,0,0,,Тайм-аутты пайдаланбай осыны ұнатыңыз
Dialogue: 0,0:08:11.28,0:08:14.24,Default,,0,0,0,,Сағатты тоқтатып, бірте-бірте алға жылжу
Dialogue: 0,0:08:14.32,0:08:17.20,Default,,0,0,0,,Сіз оны мәреге жеткізуді жоспарлап отырсыз ба?
Dialogue: 0,0:08:18.08,0:08:20.16,Default,,0,0,0,,45 секунд қалды
Dialogue: 0,0:08:20.79,0:08:22.16,Default,,0,0,0,,Орнату! қалпақ!
Dialogue: 0,0:08:25.00,0:08:25.83,Default,,0,0,0,,(Жедел жүзген қайықтың дыбысы)
Dialogue: 0,0:08:25.92,0:08:29.09,Default,,0,0,0,,Юкимицу-кун, бұл жолы қарама-қарсы жаққа қозғалды
Dialogue: 0,0:08:29.71,0:08:31.34,Default,,0,0,0,,Қас - (төбе жын) қалпақ!
Dialogue: 0,0:08:37.60,0:08:40.43,Default,,0,0,0,,Нууууууууууууууууууу... Шт~
Dialogue: 0,0:08:40.51,0:08:42.18,Default,,0,0,0,,Ууууах!
Dialogue: 0,0:08:42.27,0:08:43.73,Default,,0,0,0,,Уф (Юкимицу) Гуг...
Dialogue: 0,0:08:43.81,0:08:45.94,Default,,0,0,0,,Юкимицу... Сенпай!
Dialogue: 0,0:08:46.02,0:08:47.81,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:08:47.90,0:08:50.78,Default,,0,0,0,,Жарайды, Юки-санның орнына барайық!
Dialogue: 0,0:08:50.86,0:08:53.24,Default,,0,0,0,,(барлық күш айқайлары)
Dialogue: 0,0:08:53.32,0:08:54.28,Default,,0,0,0,,Уф
Dialogue: 0,0:08:54.36,0:08:55.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:56.57,0:08:58.45,Default,,0,0,0,,Балшық қақпасы 5 ярд алға
Dialogue: 0,0:08:59.28,0:09:00.24,Default,,0,0,0,,Жарайсыңдар! (Юкимицу) Ах
Dialogue: 0,0:09:00.33,0:09:01.95,Default,,0,0,0,,Керемет Юки-сан (Юкимицу) Иә?
Dialogue: 0,0:09:02.04,0:09:02.91,Default,,0,0,0,,Жақсы жұмыс (Юкимицу) Аха...
Dialogue: 0,0:09:03.00,0:09:05.58,Default,,0,0,0,,Сіз не істеп жатырсыз? Оны тез орнатыңыз!
Dialogue: 0,0:09:05.67,0:09:07.67,Default,,0,0,0,,Сағат тоқтаған жоқ!
Dialogue: 0,0:09:08.38,0:09:09.63,Default,,0,0,0,,Спайк!
Dialogue: 0,0:09:09.71,0:09:11.09,Default,,0,0,0,,Уф!
Dialogue: 0,0:09:12.67,0:09:16.38,Default,,0,0,0,,Сағатты тоқтату үшін 38 секунд қалды.
Dialogue: 0,0:09:16.47,0:09:19.85,Default,,0,0,0,,Бірақ біз мақсатқа әлі 82 ярд қалдық.
Dialogue: 0,0:09:20.47,0:09:23.56,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:09:23.64,0:09:27.10,Default,,0,0,0,,Сіз қалай ойлайсыз? Сенна, жақсысың ба? Аяқтар.
Dialogue: 0,0:09:27.19,0:09:28.06,Default,,0,0,0,,Sena-kun
Dialogue: 0,0:09:28.15,0:09:32.07,Default,,0,0,0,,Иә, мен сағатты тоқтатып жатырмын, әйтеуір...
Dialogue: 0,0:09:32.90,0:09:36.11,Default,,0,0,0,,Сол себепті, сіз оны әр уақытта көбейтуіңіз керек.
Dialogue: 0,0:09:36.99,0:09:40.07,Default,,0,0,0,,Ойнатуды аяқтаған кезде оны дереу орнатыңыз.
Dialogue: 0,0:09:40.16,0:09:41.78,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:09:44.66,0:09:46.33,Default,,0,0,0,,Шляпа!
Dialogue: 0,0:09:50.84,0:09:53.75,Default,,0,0,0,,(барлық күш айқайлары)
Dialogue: 0,0:09:53.84,0:09:56.76,Default,,0,0,0,,абсолютті абсолютті
Dialogue: 0,0:09:56.84,0:09:58.22,Default,,0,0,0,,Жоғалтпа!
Dialogue: 0,0:10:01.01,0:10:04.64,Default,,0,0,0,,Тар болса да, міндетті түрде жарып өтеміз!
Dialogue: 0,0:10:05.52,0:10:07.10,Default,,0,0,0,,Ууууах!
Dialogue: 0,0:10:07.18,0:10:08.60,Default,,0,0,0,,
Dialogue: 0,0:10:08.69,0:10:10.61,Default,,0,0,0,,Балшық қақпасы 6 ярд өседі
Dialogue: 0,0:10:11.36,0:10:12.57,Default,,0,0,0,,Спайк!
Dialogue: 0,0:10:12.65,0:10:14.03,Default,,0,0,0,,Уф
Dialogue: 0,0:10:15.61,0:10:18.36,Default,,0,0,0,,73 ярд қалды
Dialogue: 0,0:10:18.45,0:10:19.49,Default,,0,0,0,,Орнату! қалпақ!
Dialogue: 0,0:10:23.20,0:10:24.37,Default,,0,0,0,,Иә! (Монта) Ах!
Dialogue: 0,0:10:24.45,0:10:26.08,Default,,0,0,0,,Deimon Pass сәтсіздігі!
Dialogue: 0,0:10:27.50,0:10:31.04,Default,,0,0,0,,Сағат қайтадан тоқтайды, 27 секунд қалды.
Dialogue: 0,0:10:31.92,0:10:34.21,Default,,0,0,0,,Біз әлі жарты жолға да жеткен жоқпыз
Dialogue: 0,0:10:34.80,0:10:38.72,Default,,0,0,0,,(Барлығы ауыр тыныс алады)
Dialogue: 0,0:10:38.80,0:10:40.68,Default,,0,0,0,,Жақсы көрінеді.
Dialogue: 0,0:10:40.76,0:10:41.68,Default,,0,0,0,,О
Dialogue: 0,0:10:41.76,0:10:45.14,Default,,0,0,0,,Бұл қарқынмен жақсы.
Dialogue: 0,0:10:45.22,0:10:46.93,Default,,0,0,0,,Иә
Dialogue: 0,0:10:47.02,0:10:49.64,Default,,0,0,0,,Бұл қарқынмен Деймон уақытында үлгермейді.
Dialogue: 0,0:10:50.77,0:10:54.61,Default,,0,0,0,,Мен бұл азғынды орта мектептен бері білемін.
Dialogue: 0,0:10:55.32,0:10:59.36,Default,,0,0,0,,«Жеңіске жетпесем де, соңына дейін бар күшімді саламын» Бұл мен қалаған нәрсе емес.
Dialogue: 0,0:10:59.45,0:11:03.32,Default,,0,0,0,,Қанша тітіркендіргіш сағатты тоқтатса да...
Dialogue: 0,0:11:03.87,0:11:05.12,Default,,0,0,0,,Ha
Dialogue: 0,0:11:05.74,0:11:07.75,Default,,0,0,0,,А... хахаха...
Dialogue: 0,0:11:07.83,0:11:10.16,Default,,0,0,0,,Не болды? Агон
Dialogue: 0,0:11:10.25,0:11:13.88,Default,,0,0,0,,О? Жарайды, мен ғана байқаймын.
Dialogue: 0,0:11:13.96,0:11:17.09,Default,,0,0,0,,Қой, шіркін, аузыңды жап, алаяқ сияқты әрекет ет.
Dialogue: 0,0:11:17.17,0:11:18.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:18.09,0:11:22.01,Default,,0,0,0,,Хахахаха…
Dialogue: 0,0:11:22.09,0:11:23.64,Default,,0,0,0,,Ууууах!
Dialogue: 0,0:11:23.72,0:11:25.35,Default,,0,0,0,,
Dialogue: 0,0:11:25.43,0:11:27.56,Default,,0,0,0,,Алынған алдымен балшық
Dialogue: 0,0:11:27.64,0:11:28.60,Default,,0,0,0,,Өмірдің өткелін белгілейтін ессіз сағат
Dialogue: 0,0:11:28.68,0:11:29.60,Default,,0,0,0,,Сен, жансыз құрал—
Dialogue: 0,0:11:29.68,0:11:31.10,Default,,0,0,0,,Бірақ уақыт келді...
Dialogue: 0,0:11:31.19,0:11:34.73,Default,,0,0,0,,Келіңіздер, бар болғаны 23 секунд қалды.
Dialogue: 0,0:11:34.81,0:11:38.07,Default,,0,0,0,,Бірақ балшық қақпасына әлі 68 ярд қалды.
Dialogue: 0,0:11:38.15,0:11:42.28,Default,,0,0,0,,Мен уақыт өткізгім келетін Шинрюджи храмы қатты қорғалған.
Dialogue: 0,0:11:42.36,0:11:45.53,Default,,0,0,0,,Мен қысқа қашықтыққа жүре аламын, бірақ...
Dialogue: 0,0:11:46.62,0:11:49.54,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:11:49.62,0:11:52.50,Default,,0,0,0,,Мақсат алыс
Dialogue: 0,0:11:53.75,0:11:56.21,Default,,0,0,0,,Шүкір, менің уақытым жоқ.
Dialogue: 0,0:11:56.84,0:11:59.55,Default,,0,0,0,,Сеннаның аяғы дерлік шегінде.
Dialogue: 0,0:11:59.63,0:12:01.47,Default,,0,0,0,,Қарғыс атсын, егер осылай қала берсе...
Dialogue: 0,0:12:01.55,0:12:02.84,Default,,0,0,0,,Мұқият
Dialogue: 0,0:12:03.51,0:12:05.26,Default,,0,0,0,,Гррр... Не?
Dialogue: 0,0:12:05.34,0:12:06.18,Default,,0,0,0,,Ах
Dialogue: 0,0:12:09.22,0:12:11.23,Default,,0,0,0,,Хмм... Ах.
Dialogue: 0,0:12:12.52,0:12:13.39,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:14.69,0:12:16.36,Default,,0,0,0,,Орнату! қалпақ!
Dialogue: 0,0:12:16.44,0:12:19.23,Default,,0,0,0,,Аха~ха~ Маған қалдырыңыз~
Dialogue: 0,0:12:19.32,0:12:21.69,Default,,0,0,0,,Ахахаха~ (Төреші) Доймон 8 ярд ұтады
Dialogue: 0,0:12:21.78,0:12:23.82,Default,,0,0,0,,Сәлем! Бауырым!
Dialogue: 0,0:12:23.90,0:12:25.45,Default,,0,0,0,,Тезірек және келесісін орнатыңыз!
Dialogue: 0,0:12:25.53,0:12:27.37,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:12:28.08,0:12:30.75,Default,,0,0,0,,Спайк! Қазір сағатты тоқтатыңыз!
Dialogue: 0,0:12:30.83,0:12:31.87,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:34.21,0:12:36.63,Default,,0,0,0,,Хм... Қандай ақымақ!
Dialogue: 0,0:12:36.71,0:12:38.84,Default,,0,0,0,,Қарғыс атқыр маймыл! (Монта) Иә?
Dialogue: 0,0:12:38.92,0:12:43.09,Default,,0,0,0,,Әрбір секунд босқа кетеді! Белгіленген позицияға тез жетіңіз!
Dialogue: 0,0:12:43.17,0:12:45.30,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:12:47.34,0:12:49.85,Default,,0,0,0,,Сіз не істеп жатырсыз? Ақымақ!
Dialogue: 0,0:12:49.93,0:12:51.35,Default,,0,0,0,,15 секунд қалды
Dialogue: 0,0:12:51.43,0:12:53.31,Default,,0,0,0,,Кууууууу
Dialogue: 0,0:12:53.93,0:12:55.35,Default,,0,0,0,,Ол адамзат үшін баға жетпес мүмкіндік
Dialogue: 0,0:12:55.44,0:12:56.27,Default,,0,0,0,,​​О?
Dialogue: 0,0:12:56.94,0:12:57.77,Default,,0,0,0,,Ішек
Dialogue: 0,0:12:58.86,0:13:00.23,Default,,0,0,0,,Ах (Унсуи) Ах?
Dialogue: 0,0:13:04.11,0:13:06.86,Default,,0,0,0,,Сенің кесіріңнен мен мәңгілік бастай алмаймын!
Dialogue: 0,0:13:06.95,0:13:08.82,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:08.91,0:13:10.78,Default,,0,0,0,,"Оған қанша төлейсің?"
Dialogue: 0,0:13:11.70,0:13:12.75,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:13:12.83,0:13:17.00,Default,,0,0,0,,Мен мұны білмей тұрып, Юкимицу алдыңғы қатардағы жеті адамға қосылды.
Dialogue: 0,0:13:17.08,0:13:18.63,Default,,0,0,0,,Қозғалыс!
Dialogue: 0,0:13:18.71,0:13:22.25,Default,,0,0,0,,Каминаримон белгіленген позицияға түсуге асықпады.
Dialogue: 0,0:13:22.34,0:13:24.59,Default,,0,0,0,,Жүгіруден бастаңыз
Dialogue: 0,0:13:24.67,0:13:27.51,Default,,0,0,0,,Мен тіпті Иккю-сенпайдың жылдамдығын да жеңе аламын!
Dialogue: 0,0:13:27.59,0:13:30.60,Default,,0,0,0,,О! Тез позицияға кел, қарғыс атқыр маймыл!
Dialogue: 0,0:13:31.22,0:13:33.56,Default,,0,0,0,,Біз ойынның басталуын күттік!
Dialogue: 0,0:13:33.64,0:13:37.52,Default,,0,0,0,,Сүлік жындарына алданба! Ойын қазірдің өзінде басталды!
Dialogue: 0,0:13:37.60,0:13:39.77,Default,,0,0,0,,Ой, доп жоқ (ойыншылар айқайлайды)
Dialogue: 0,0:13:39.86,0:13:42.23,Default,,0,0,0,,Барлығыңыз, қозғалыңыз! Асығыңыз!
Dialogue: 0,0:13:42.32,0:13:44.69,Default,,0,0,0,,Қарғыс атқыр... әзіл!
Dialogue: 0,0:13:45.32,0:13:46.82,Default,,0,0,0,,Бұл басынан бері
Dialogue: 0,0:13:46.90,0:13:50.32,Default,,0,0,0,,Бұл сағатты тоқтататын ұшқыр емес еді.
Dialogue: 0,0:13:50.41,0:13:52.28,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:13:52.37,0:13:54.25,Default,,0,0,0,,Ұзын өту!
Dialogue: 0,0:13:58.75,0:14:00.67,Default,,0,0,0,,Ууууах!
Dialogue: 0,0:14:00.75,0:14:02.21,Default,,0,0,0,,12 секунд қалды
Dialogue: 0,0:14:02.29,0:14:05.26,Default,,0,0,0,,Деймон Ібіліс жарғанақтары тар бір рет тию айырмашылығын қуып келеді
Dialogue: 0,0:14:05.34,0:14:10.22,Default,,0,0,0,,Шинрюджидің бос жерін тесіп өткен тағдыр жолы енді босатылды!
Dialogue: 0,0:14:10.30,0:14:13.47,Default,,0,0,0,,Егер бұл өту өтсе, сіз бірден контур аласыз.
Dialogue: 0,0:14:13.56,0:14:17.43,Default,,0,0,0,,Сондықтан Хилл Демон ақырындап қашықтыққа ие болды.
Dialogue: 0,0:14:18.06,0:14:21.69,Default,,0,0,0,,Сена Кобаякаваны алға жылжыту стратегиясы осыған дайындық болып табылады.
Dialogue: 0,0:14:21.77,0:14:23.73,Default,,0,0,0,,Ха ха ха... Эй!
Dialogue: 0,0:14:24.57,0:14:26.44,Default,,0,0,0,,Максималды ұстаңыз!
Dialogue: 0,0:14:26.53,0:14:30.70,Default,,0,0,0,,Мен өтуім керек пе? Мен әуедегі шайқаста біріншімін!
Dialogue: 0,0:14:30.78,0:14:31.66,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:31.74,0:14:32.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:34.45,0:14:37.29,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:14:37.37,0:14:38.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:38.33,0:14:39.29,Default,,0,0,0,,Бұл жақтастық! Бұл жақтастық~!
Dialogue: 0,0:14:39.96,0:14:41.96,Default,,0,0,0,,Ууууууу...
Dialogue: 0,0:14:42.04,0:14:43.09,Default,,0,0,0,,Құт
Dialogue: 0,0:14:43.17,0:14:44.38,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:14:46.51,0:14:47.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:47.55,0:14:48.59,Default,,0,0,0,,әлсіз
Dialogue: 0,0:14:48.67,0:14:51.68,Default,,0,0,0,,Мынау... осындай алыстан жетуге болады.
Dialogue: 0,0:14:52.39,0:14:55.22,Default,,0,0,0,,Иккю-кун, асудың траекториясы ауыстырылды!
Dialogue: 0,0:14:55.31,0:14:57.35,Default,,0,0,0,,Мұның бәрі жақсы ма?
Dialogue: 0,0:14:57.43,0:14:58.27,Default,,0,0,0,,Ах
Dialogue: 0,0:15:02.61,0:15:06.73,Default,,0,0,0,,Не... Неліктен траекторияны ауыстырдыңыз, ол сізге соққымен соқты...
Dialogue: 0,0:15:07.48,0:15:09.07,Default,,0,0,0,,Иккю Сенпай
Dialogue: 0,0:15:09.15,0:15:12.62,Default,,0,0,0,,Мен сенің қандай керемет екеніңді жақсы білемін.
Dialogue: 0,0:15:12.70,0:15:16.20,Default,,0,0,0,,Өткізілетін жерде барлығы мүмкін емес деп ойлауы мүмкін, бірақ мен ғана.
Dialogue: 0,0:15:16.29,0:15:19.83,Default,,0,0,0,,Саусақтарымды жая алатыныңа сендім!
Dialogue: 0,0:15:19.91,0:15:23.29,Default,,0,0,0,,Қарғыс атсын... бұл...
Dialogue: 0,0:15:23.38,0:15:24.46,Default,,0,0,0,,Уф
Dialogue: 0,0:15:24.54,0:15:26.38,Default,,0,0,0,,Уф... бейбақ!
Dialogue: 0,0:15:26.46,0:15:28.30,Default,,0,0,0,,Уау (Санада) Монта-кун қандай!
Dialogue: 0,0:15:28.38,0:15:29.72,Default,,0,0,0,,Допты қағып алу
Dialogue: 0,0:15:29.80,0:15:31.76,Default,,0,0,0,,Мақсатқа тіке бас!
Dialogue: 0,0:15:31.84,0:15:33.01,Default,,0,0,0,,Сен, жансыз құрал—
Dialogue: 0,0:15:33.09,0:15:34.39,Default,,0,0,0,,Тапсырыс берілді!
Dialogue: 0,0:15:34.47,0:15:37.47,Default,,0,0,0,,Монтаның бейбақ Иккю пьесасын оқыдың ба?
Dialogue: 0,0:15:38.10,0:15:39.43,Default,,0,0,0,,Жүр!
Dialogue: 0,0:15:39.52,0:15:40.77,Default,,0,0,0,,Дәл солай...
Dialogue: 0,0:15:40.85,0:15:42.39,Default,,0,0,0,,Тасу!
Dialogue: 0,0:15:42.48,0:15:44.40,Default,,0,0,0,,О!
Dialogue: 0,0:15:45.69,0:15:46.69,Default,,0,0,0,,Ха ха ха... уф
Dialogue: 0,0:15:46.77,0:15:50.65,Default,,0,0,0,,А, соңғы қорғаныс Монта-кунның алдында тұр.
Dialogue: 0,0:15:50.74,0:15:53.82,Default,,0,0,0,,Қарғыс атсын... қарғыс атсын, осындай жерде
Dialogue: 0,0:15:53.91,0:15:54.74,Default,,0,0,0,,Ha
Dialogue: 0,0:15:55.53,0:15:56.70,Default,,0,0,0,,Сенна!
Dialogue: 0,0:15:56.78,0:15:58.95,Default,,0,0,0,,Бұл бәріміз біріктірген шар.
Dialogue: 0,0:15:59.04,0:16:00.45,Default,,0,0,0,,Ешқашан берме
Dialogue: 0,0:16:00.54,0:16:02.92,Default,,0,0,0,,Ауырды деп айта алмаймын!
Dialogue: 0,0:16:03.00,0:16:05.38,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:16:05.46,0:16:06.46,Default,,0,0,0,,Даа!
Dialogue: 0,0:16:06.54,0:16:07.63,Default,,0,0,0,,Уф
Dialogue: 0,0:16:07.71,0:16:09.17,Default,,0,0,0,,Сенна!
Dialogue: 0,0:16:09.92,0:16:12.42,Default,,0,0,0,,Сена-кунның өте жылдам блогы
Dialogue: 0,0:16:12.51,0:16:15.72,Default,,0,0,0,,Шинрюджи храмы Соңғы бекініс те жойылды!
Dialogue: 0,0:16:15.80,0:16:17.18,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:17.26,0:16:18.18,Default,,0,0,0,,Фуго~
Dialogue: 0,0:16:18.85,0:16:22.06,Default,,0,0,0,,Монта-кун, тура бос Шинрюджи қақпасына
Dialogue: 0,0:16:23.14,0:16:25.56,Default,,0,0,0,,Жарайды (Таки) Аха~ха~
Dialogue: 0,0:16:25.65,0:16:26.86,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:26.94,0:16:28.02,Default,,0,0,0,,Өмірдің өткелін белгілейтін ессіз сағат
Dialogue: 0,0:16:28.11,0:16:29.53,Default,,0,0,0,,Хаха...
Dialogue: 0,0:16:30.57,0:16:32.24,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:16:32.32,0:16:33.49,Default,,0,0,0,,Фу…
Dialogue: 0,0:16:33.57,0:16:35.95,Default,,0,0,0,,Хаха...
Dialogue: 0,0:16:36.70,0:16:37.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:40.24,0:16:42.79,Default,,0,0,0,,«Батырларды өлтірушіні» жеңгені үшін атағы шыққан сол жігіт—
Dialogue: 0,0:16:43.91,0:16:48.25,Default,,0,0,0,,Қайда... Қайдан байқадың?
Dialogue: 0,0:16:48.34,0:16:51.51,Default,,0,0,0,,Қанша қиын болса да, екінші жағынан, сол тереңде.
Dialogue: 0,0:16:52.30,0:16:54.22,Default,,0,0,0,,Кенеттен бұрылып кетуге мүмкіндік жоқ.
Dialogue: 0,0:16:55.51,0:16:57.01,Default,,0,0,0,,Мен оны оқыдым.
Dialogue: 0,0:16:58.85,0:17:00.68,Default,,0,0,0,,(Киришима) Сенпай Амагири жақсы жүр ме екен?
Dialogue: 0,0:17:00.76,0:17:02.93,Default,,0,0,0,,Уг!?
Dialogue: 0,0:17:11.94,0:17:14.11,Default,,0,0,0,,А... ха...
Dialogue: 0,0:17:14.19,0:17:17.66,Default,,0,0,0,,Ештеңені байқамағандай кейіп танытып, жүзіңіз.
Dialogue: 0,0:17:17.74,0:17:20.28,Default,,0,0,0,,Мен ғана озып шықтым.
Dialogue: 0,0:17:20.37,0:17:25.37,Default,,0,0,0,,Ах~ах~ Менің сезімсіз бейбақтарым жақсы жем жасады.
Dialogue: 0,0:17:26.83,0:17:28.08,Default,,0,0,0,,Өл
Dialogue: 0,0:17:28.79,0:17:30.54,Default,,0,0,0,,О, бұл…
Dialogue: 0,0:17:34.63,0:17:35.51,Default,,0,0,0,,Монта!
Dialogue: 0,0:17:36.09,0:17:38.97,Default,,0,0,0,,Дааа! Онда жеңілсең, бітті!
Dialogue: 0,0:17:39.05,0:17:44.06,Default,,0,0,0,,Қарғыс атқыр допты көздеме.
Dialogue: 0,0:17:44.14,0:17:48.40,Default,,0,0,0,,Егер сіз оны далада жай ғана жеңсеңіз, сіздің уақытыңыз таусылады.
Dialogue: 0,0:17:49.81,0:17:52.52,Default,,0,0,0,,Соңында Агон оқуы...
Dialogue: 0,0:17:52.61,0:17:54.90,Default,,0,0,0,,Сүлік шайтанның айласынан асып түсті
Dialogue: 0,0:17:54.99,0:17:58.45,Default,,0,0,0,,Жоғалтпа... Максты ұста!
Dialogue: 0,0:17:58.53,0:18:02.24,Default,,0,0,0,,О~о~ Оның ұстауға қатысы жоқ, солай ма?
Dialogue: 0,0:18:02.33,0:18:04.33,Default,,0,0,0,,Барка
Dialogue: 0,0:18:04.41,0:18:05.79,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:18:10.33,0:18:14.51,Default,,0,0,0,,Ах, қақпа сызығына 20 ярд қалды.
Dialogue: 0,0:18:14.59,0:18:18.01,Default,,0,0,0,,Монта-кун далада жеңілді!
Dialogue: 0,0:18:18.09,0:18:19.97,Default,,0,0,0,,(Иккю мен оның достары қуанады)
Dialogue: 0,0:18:20.05,0:18:22.93,Default,,0,0,0,,Қарғыс атсын... Қазір ойнауға дайын!
Dialogue: 0,0:18:23.01,0:18:25.68,Default,,0,0,0,,Сағатты тез орнатыңыз және оны тоқтатыңыз!
Dialogue: 0,0:18:25.77,0:18:27.64,Default,,0,0,0,,Спайк!
Dialogue: 0,0:18:27.73,0:18:30.02,Default,,0,0,0,,Ах... (Тоно) О, жоқ.
Dialogue: 0,0:18:30.10,0:18:31.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:31.65,0:18:34.32,Default,,0,0,0,,Боқ, Монта көп жетістіктерге жетті.
Dialogue: 0,0:18:34.40,0:18:36.74,Default,,0,0,0,,Орнату орны тым алыс
Dialogue: 0,0:18:36.82,0:18:40.99,Default,,0,0,0,,Хехехе... Сондықтан мен оны терең тоқтаттым.
Dialogue: 0,0:18:44.33,0:18:47.83,Default,,0,0,0,,Мен жеңілгім келмейді.
Dialogue: 0,0:18:47.91,0:18:51.54,Default,,0,0,0,,Мынадай жерде... Мынадай жерде...
Dialogue: 0,0:18:52.25,0:18:58.67,Default,,0,0,0,,Жоқ, бәріміз осылай ант еттік.
Dialogue: 0,0:18:58.76,0:19:01.34,Default,,0,0,0,,Бірақ екі секунд қана қалды.
Dialogue: 0,0:19:01.43,0:19:06.10,Default,,0,0,0,,Бәрі... бәрі бітеді
Dialogue: 0,0:19:06.89,0:19:08.10,Default,,0,0,0,,Взвод мүшелерінің бір-бірімен шайқасуына болмайды!
Dialogue: 0,0:19:08.18,0:19:14.02,Default,,0,0,0,,Уааааааа!
Dialogue: 0,0:19:17.15,0:19:18.36,Default,,0,0,0,,Уф
Dialogue: 0,0:19:19.74,0:19:22.11,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:19:23.03,0:19:24.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:24.49,0:19:31.12,Default,,0,0,0,,Мұнда Шинрюджи Деймонға қарсы 35 пен 28 болып қалады.
Dialogue: 0,0:19:31.67,0:19:34.67,Default,,0,0,0,,Матчтың аяқталуын жүрексіздер хабарлайды...
Dialogue: 0,0:19:35.71,0:19:38.17,Default,,0,0,0,,Танысқаныма қуаныштымын!
Dialogue: 0,0:19:47.01,0:19:52.02,Default,,0,0,0,,♪~
Dialogue: 0,0:20:56.79,0:21:01.96,Default,,0,0,0,,~♪
Dialogue: 0,0:21:02.80,0:21:06.13,Default,,0,0,0,,Иә... Уақыт бітті ме? Деймон жеңіліп қалды ма?
Dialogue: 0,0:21:06.80,0:21:09.26,Default,,0,0,0,,Бұл... соңы ма?
Dialogue: 0,0:21:09.35,0:21:12.56,Default,,0,0,0,,Бұл шынымен ойын аяқталды ма?
Dialogue: 0,0:21:12.64,0:21:14.43,Default,,0,0,0,,Шынымен!
Dialogue: 0,0:21:14.52,0:21:17.35,Default,,0,0,0,,Келесі жолы «Көз қалқаны 21»
Dialogue: 0,0:21:17.44,0:21:19.61,Default,,0,0,0,,«Жауапсыз жиналу»
Dialogue: 0,0:21:19.69,0:21:21.98,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:21:23.48,0:21:29.48,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory