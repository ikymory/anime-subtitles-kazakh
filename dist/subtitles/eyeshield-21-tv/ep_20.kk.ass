Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.42,0:00:09.05,Default,,0,0,0,,Тасу
Dialogue: 0,0:00:09.63,0:00:11.34,Default,,0,0,0,,Мен Деймонды жасаймын.
Dialogue: 0,0:00:11.46,0:00:13.22,Default,,0,0,0,,Қазір қызық болып барады.
Dialogue: 0,0:00:13.72,0:00:16.34,Default,,0,0,0,,Бұл кездейсоқтық болса керек
Dialogue: 0,0:00:17.89,0:00:20.14,Default,,0,0,0,,Әлгі бейбақ сүлік жын деп аталды.
Dialogue: 0,0:00:20.60,0:00:23.81,Default,,0,0,0,,Мен олардың командасы жеңеді деп үміттенемін.
Dialogue: 0,0:00:25.27,0:00:27.73,Default,,0,0,0,,Деймон сияқты біреу сіздің өкіліңіз болсын.
Dialogue: 0,0:00:27.86,0:00:29.77,Default,,0,0,0,,Бұл Жапонияның ұяты.
Dialogue: 0,0:00:30.53,0:00:31.82,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:00:31.94,0:00:34.11,Default,,0,0,0,,Айналаңның бәрі жауға толы.
Dialogue: 0,0:00:34.28,0:00:36.78,Default,,0,0,0,,Барлығы Деймон жеңе алмайды деп ойлайды.
Dialogue: 0,0:00:36.91,0:00:37.87,Default,,0,0,0,,Осылай жеңіліп қалсақ
Dialogue: 0,0:00:37.99,0:00:41.75,Default,,0,0,0,,Тек аудитория мен бас редактордың көңілінен шығу үшін.
Dialogue: 0,0:00:41.87,0:00:43.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:43.46,0:00:45.92,Default,,0,0,0,,Олардың мұрындарын ашыңыз!
Dialogue: 0,0:00:46.58,0:00:47.79,Default,,0,0,0,,Я- ха-!
Dialogue: 0,0:00:47.92,0:00:49.84,Default,,0,0,0,,Я- ха-!
Dialogue: 0,0:00:50.04,0:00:56.05,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:03.87,0:02:09.87,Default,,0,0,0,,~♪
Dialogue: 0,0:02:16.63,0:02:18.63,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:02:20.22,0:02:22.64,Default,,0,0,0,,Жарайды, алдымнан жол аш.
Dialogue: 0,0:02:22.97,0:02:24.64,Default,,0,0,0,,Бұл сіздің жұмысыңыз!
Dialogue: 0,0:02:24.81,0:02:26.98,Default,,0,0,0,,Пирамида сызығын жойыңыз!
Dialogue: 0,0:02:28.89,0:02:32.23,Default,,0,0,0,,Сызық жолының қабырғасы әдетте 3-4 секундқа созылады.
Dialogue: 0,0:02:32.36,0:02:36.44,Default,,0,0,0,,Қарсыласыңызды тауып, допты дәл беру үшін небәрі 3 секундыңыз бар.
Dialogue: 0,0:02:36.86,0:02:39.28,Default,,0,0,0,,Бірақ пирамида сызығы басқаша.
Dialogue: 0,0:02:40.11,0:02:41.82,Default,,0,0,0,,Қорғаушы Харао
Dialogue: 0,0:02:42.45,0:02:46.20,Default,,0,0,0,,Маған бар болғаны ресивердің ашылуын шыдамдылықпен күту керек.
Dialogue: 0,0:02:47.20,0:02:48.20,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:48.33,0:02:49.16,Default,,0,0,0,,Не!
Dialogue: 0,0:02:49.58,0:02:51.08,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:53.17,0:02:55.00,Default,,0,0,0,,Бұл шықты! (Юкимицу) Құқық бұзушы өлтіру әдісі!
Dialogue: 0,0:02:55.50,0:02:57.30,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:02:57.67,0:02:59.47,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:04.10,0:03:06.89,Default,,0,0,0,,А... (Кумабукуро) Харао лақтыруға асықты!
Dialogue: 0,0:03:09.43,0:03:11.23,Default,,0,0,0,,Комусуби сен кереметсің
Dialogue: 0,0:03:11.35,0:03:12.77,Default,,0,0,0,,Ұстаз... Ах!
Dialogue: 0,0:03:13.23,0:03:14.48,Default,,0,0,0,,Ууууах!
Dialogue: 0,0:03:16.65,0:03:18.23,Default,,0,0,0,,Мынаны жібер!
Dialogue: 0,0:03:18.36,0:03:19.90,Default,,0,0,0,,Гюго! (Ойыншылар) Уа!
Dialogue: 0,0:03:20.07,0:03:21.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:24.70,0:03:26.20,Default,,0,0,0,,Доп қайда?
Dialogue: 0,0:03:28.95,0:03:30.87,Default,,0,0,0,,Жоқ... бұл әбігер.
Dialogue: 0,0:03:31.00,0:03:32.75,Default,,0,0,0,,Бұл биылғы сирек қойылым.
Dialogue: 0,0:03:33.25,0:03:34.25,Default,,0,0,0,,Оны алыңыз!
Dialogue: 0,0:03:37.09,0:03:40.92,Default,,0,0,0,,Енді айнымас күн бұзу хаоста.
Dialogue: 0,0:03:41.42,0:03:45.68,Default,,0,0,0,,Перғауынға қарсы шыққан халық сияқты.
Dialogue: 0,0:03:46.43,0:03:49.02,Default,,0,0,0,,Таййоны тек желілік команда деп ойламаңыз!
Dialogue: 0,0:03:49.31,0:03:51.68,Default,,0,0,0,,Егер бұл жылдамдық болса... Ах!
Dialogue: 0,0:03:53.90,0:03:54.73,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:55.81,0:03:57.36,Default,,0,0,0,,Жақсы, мен оны ұстадым!
Dialogue: 0,0:03:58.65,0:03:59.61,Default,,0,0,0,,Оны жойыңыз!
Dialogue: 0,0:03:59.73,0:04:00.78,Default,,0,0,0,,Хехе
Dialogue: 0,0:04:01.07,0:04:02.20,Default,,0,0,0,,Ух (сүлік жын) Ух...
Dialogue: 0,0:04:05.28,0:04:06.57,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,0:04:06.70,0:04:07.87,Default,,0,0,0,,Мен сені бұл жолы тастамаймын!
Dialogue: 0,0:04:09.04,0:04:10.08,Default,,0,0,0,,Оны тартып алыңыз!
Dialogue: 0,0:04:13.62,0:04:14.75,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:16.92,0:04:17.75,Default,,0,0,0,,Уау
Dialogue: 0,0:04:18.29,0:04:19.42,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:22.01,0:04:25.13,Default,,0,0,0,,Уф... Ха!
Dialogue: 0,0:04:25.93,0:04:27.10,Default,,0,0,0,,Бұл не өзі?!
Dialogue: 0,0:04:27.47,0:04:28.68,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:31.89,0:04:33.14,Default,,0,0,0,,Уау...
Dialogue: 0,0:04:33.27,0:04:34.52,Default,,0,0,0,,Мен жеңілдім!
Dialogue: 0,0:04:35.85,0:04:38.40,Default,,0,0,0,,Доп... Кобосанка?
Dialogue: 0,0:04:42.32,0:04:45.78,Default,,0,0,0,,Жарайсың кішкентай боқ
Dialogue: 0,0:04:47.53,0:04:48.41,Default,,0,0,0,,Иә
Dialogue: 0,0:04:50.62,0:04:52.45,Default,,0,0,0,,Мұны істеме
Dialogue: 0,0:04:52.58,0:04:53.41,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:04:53.83,0:04:55.16,Default,,0,0,0,,Барлығы керемет!
Dialogue: 0,0:04:55.29,0:04:57.00,Default,,0,0,0,,Бұл матч тамаша!
Dialogue: 0,0:04:57.83,0:04:59.00,Default,,0,0,0,,Не деген сұмдық!
Dialogue: 0,0:04:59.13,0:05:00.92,Default,,0,0,0,,Мен саған жол аш деп айттым!
Dialogue: 0,0:05:01.63,0:05:02.76,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:05:02.88,0:05:06.22,Default,,0,0,0,,Алаңдамаңыз! Келесі жолы мен оны міндетті түрде бұзамын!
Dialogue: 0,0:05:13.02,0:05:14.52,Default,,0,0,0,,Сіз Курита айттыңыз.
Dialogue: 0,0:05:14.93,0:05:16.73,Default,,0,0,0,,Жеңілмейтін пирамида сызығы
Dialogue: 0,0:05:17.15,0:05:19.81,Default,,0,0,0,,Оның шын мағынасын айтып берейін.
Dialogue: 0,0:05:21.36,0:05:22.19,Default,,0,0,0,,(Түкіру дыбысы)
Dialogue: 0,0:05:24.69,0:05:25.78,Default,,0,0,0,,Фуннура...
Dialogue: 0,0:05:25.90,0:05:26.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:27.03,0:05:27.95,Default,,0,0,0,,Хмф!
Dialogue: 0,0:05:29.07,0:05:30.33,Default,,0,0,0,,Уау...
Dialogue: 0,0:05:30.95,0:05:32.83,Default,,0,0,0,,О, бұл…
Dialogue: 0,0:05:34.12,0:05:35.00,Default,,0,0,0,,
Dialogue: 0,0:05:35.50,0:05:36.37,Default,,0,0,0,,Қап!
Dialogue: 0,0:05:36.71,0:05:38.50,Default,,0,0,0,,О... не?
Dialogue: 0,0:05:38.62,0:05:40.29,Default,,0,0,0,,Я- ха-!
Dialogue: 0,0:05:40.42,0:05:41.38,Default,,0,0,0,,Қап дегеніміз не?
Dialogue: 0,0:05:41.50,0:05:44.01,Default,,0,0,0,,Допты лақтырмас бұрын қорғаушыны басу
Dialogue: 0,0:05:44.13,0:05:45.59,Default,,0,0,0,,Сызықтың үлкен айласы!
Dialogue: 0,0:05:45.72,0:05:47.47,Default,,0,0,0,,Мұны мұқият есте сақтаңыз!
Dialogue: 0,0:05:48.68,0:05:49.51,Default,,0,0,0,,Я- ха-!
Dialogue: 0,0:05:50.18,0:05:52.85,Default,,0,0,0,,Жарайсың, менің жолымнан күткендей.
Dialogue: 0,0:05:53.26,0:05:54.77,Default,,0,0,0,,Осылай жүре беріңіз.
Dialogue: 0,0:05:55.10,0:05:58.69,Default,,0,0,0,,Сен мені қатты ұрдың. Мен тіпті пас тастай да алмаймын.
Dialogue: 0,0:05:58.81,0:06:00.98,Default,,0,0,0,,Деймон мен Бакс әуесқой ма? Вахаха...
Dialogue: 0,0:06:01.11,0:06:02.82,Default,,0,0,0,,Солай ма? (Бас редактор) А?
Dialogue: 0,0:06:03.36,0:06:06.07,Default,,0,0,0,,Дұрыс жауап - лақтыруды мәжбүрлеу емес.
Dialogue: 0,0:06:06.36,0:06:09.53,Default,,0,0,0,,Ең бастысы допты бекіту.
Dialogue: 0,0:06:09.82,0:06:11.74,Default,,0,0,0,,Сіз осылай айтасыз.
Dialogue: 0,0:06:12.16,0:06:14.20,Default,,0,0,0,,Харао мырза, т.б., өмірінде бір рет те болмаған
Dialogue: 0,0:06:14.33,0:06:16.20,Default,,0,0,0,,Мен ешқашан сорып көрген емеспін.
Dialogue: 0,0:06:17.00,0:06:19.87,Default,,0,0,0,,Күн пирамидасының сызығы мінсіз.
Dialogue: 0,0:06:20.12,0:06:22.17,Default,,0,0,0,,Бұл қызық.
Dialogue: 0,0:06:22.42,0:06:27.59,Default,,0,0,0,,Жылыжайда өскен және күшті желімен қорғалған төртінші Харао.
Dialogue: 0,0:06:28.01,0:06:32.01,Default,,0,0,0,,Қатты суықта шыдамдылықпен өмір сүрген ширек төбе жын.
Dialogue: 0,0:06:33.97,0:06:34.89,Default,,0,0,0,,Басқа жолда
Dialogue: 0,0:06:35.01,0:06:37.89,Default,,0,0,0,,Мені еш нәрсеге көндірсін!
Dialogue: 0,0:06:38.48,0:06:39.94,Default,,0,0,0,,Хехехе
Dialogue: 0,0:06:42.52,0:06:44.52,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:06:52.78,0:06:54.45,Default,,0,0,0,,О, ә...
Dialogue: 0,0:06:54.78,0:06:56.66,Default,,0,0,0,,Уайымдама, менде жоқ!
Dialogue: 0,0:06:59.08,0:07:00.16,Default,,0,0,0,,Мукки!
Dialogue: 0,0:07:00.71,0:07:03.63,Default,,0,0,0,,Бос саңылауға өтетін жолдың қисаюы!
Dialogue: 0,0:07:04.09,0:07:06.30,Default,,0,0,0,,Лақтырар алдында қап
Dialogue: 0,0:07:06.42,0:07:07.92,Default,,0,0,0,,Мәселеге!
Dialogue: 0,0:07:08.30,0:07:09.88,Default,,0,0,0,,Тынш!
Dialogue: 0,0:07:12.22,0:07:14.76,Default,,0,0,0,,Ух...хехехе
Dialogue: 0,0:07:14.89,0:07:15.72,Default,,0,0,0,,Е...
Dialogue: 0,0:07:19.02,0:07:21.23,Default,,0,0,0,,Эхехе Ухехехе
Dialogue: 0,0:07:21.35,0:07:24.06,Default,,0,0,0,,Деймонның желісін әрқашан әуесқой орындайтын.
Dialogue: 0,0:07:24.48,0:07:27.02,Default,,0,0,0,,Сүлік жын әрқашан Сакке қарсы соғысқан.
Dialogue: 0,0:07:28.48,0:07:30.28,Default,,0,0,0,,Сондықтан біз бірден жауап бере аламыз
Dialogue: 0,0:07:30.99,0:07:33.70,Default,,0,0,0,,Допты қорғау кезінде Жалтару және лақтыру кезінде
Dialogue: 0,0:07:39.08,0:07:39.91,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:42.04,0:07:42.96,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:07:45.29,0:07:48.09,Default,,0,0,0,,Қиын ортада жасалған қозғалатын мұнара!
Dialogue: 0,0:07:48.67,0:07:50.42,Default,,0,0,0,,Ол мобильді квартербек!
Dialogue: 0,0:07:51.38,0:07:53.09,Default,,0,0,0,,Уау~
Dialogue: 0,0:07:53.55,0:07:55.18,Default,,0,0,0,,Керемет!
Dialogue: 0,0:07:55.68,0:07:58.06,Default,,0,0,0,,Муки Кики~! Батыр Макс!
Dialogue: 0,0:07:58.18,0:07:59.72,Default,,0,0,0,,Бұл қорғаушы керемет!
Dialogue: 0,0:07:59.85,0:08:00.89,Default,,0,0,0,,Оны сүлік жын деп атаған.
Dialogue: 0,0:08:01.02,0:08:02.02,Default,,0,0,0,,Керемет!
Dialogue: 0,0:08:02.31,0:08:04.98,Default,,0,0,0,,Курукурукуру Гуи-н-дун!
Dialogue: 0,0:08:05.10,0:08:05.94,Default,,0,0,0,,Муки!
Dialogue: 0,0:08:06.27,0:08:07.15,Default,,0,0,0,,Тей!
Dialogue: 0,0:08:09.15,0:08:11.11,Default,,0,0,0,,Нуах!
Dialogue: 0,0:08:11.57,0:08:14.16,Default,,0,0,0,,Күн шары
Dialogue: 0,0:08:14.28,0:08:15.62,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:08:15.82,0:08:19.08,Default,,0,0,0,,Қарғыс атқыр маймыл! Сақтығыңызды төмендетпеңіз!
Dialogue: 0,0:08:19.70,0:08:21.58,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:08:25.96,0:08:28.71,Default,,0,0,0,,Мен өткенше, жеңіс көз алдында.
Dialogue: 0,0:08:29.17,0:08:30.34,Default,,0,0,0,,Хмф!
Dialogue: 0,0:08:35.55,0:08:37.80,Default,,0,0,0,,Өтетін орын жоқ...
Dialogue: 0,0:08:38.47,0:08:39.35,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:41.31,0:08:42.60,Default,,0,0,0,,
Dialogue: 0,0:08:42.73,0:08:43.89,Default,,0,0,0,,Мудгейт добы
Dialogue: 0,0:08:44.14,0:08:45.19,Default,,0,0,0,,Жоқ... Жоқ!
Dialogue: 0,0:08:45.31,0:08:47.36,Default,,0,0,0,,Харао-кун жұмыстан босатылды!
Dialogue: 0,0:08:47.61,0:08:51.28,Default,,0,0,0,,Не істеп жатырсың! Мен бірінші рет осылай ұялып тұрмын!
Dialogue: 0,0:08:51.40,0:08:53.15,Default,,0,0,0,,Мен сені қайта шығаруға рұқсат етпеймін!
Dialogue: 0,0:08:53.28,0:08:55.57,Default,,0,0,0,,Біздің жолымызға сеніңіз~
Dialogue: 0,0:08:57.49,0:08:59.03,Default,,0,0,0,,Тыңда, Жолдар.
Dialogue: 0,0:08:59.16,0:09:01.16,Default,,0,0,0,,Бетпе-бет ұрыс жаман.
Dialogue: 0,0:09:01.29,0:09:03.50,Default,,0,0,0,,Блок тапсырмаларын ауыстырайық.
Dialogue: 0,0:09:03.96,0:09:05.00,Default,,0,0,0,,Онда!
Dialogue: 0,0:09:05.96,0:09:07.21,Default,,0,0,0,,Үш ағайынды, үлкен ұл!
Dialogue: 0,0:09:07.33,0:09:08.67,Default,,0,0,0,,Үлкен ұлы кім!
Dialogue: 0,0:09:08.79,0:09:10.09,Default,,0,0,0,,Және (Тоноха) біз
Dialogue: 0,0:09:10.21,0:09:11.38,Default,,0,0,0,,Бауырлар емес!
Dialogue: 0,0:09:12.38,0:09:15.93,Default,,0,0,0,,Әлгі қарғыс атқыр Гаппаны одан сайын арандата бер!
Dialogue: 0,0:09:20.30,0:09:22.01,Default,,0,0,0,,Хмф, бұл оңай.
Dialogue: 0,0:09:22.14,0:09:24.43,Default,,0,0,0,,Жаман сөз айтып, ренжіту дұрыс емес пе?
Dialogue: 0,0:09:25.14,0:09:26.23,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:09:26.56,0:09:27.44,Default,,0,0,0,,Мына пальто!
Dialogue: 0,0:09:27.56,0:09:28.81,Default,,0,0,0,,Шошқа! (Тоноха) Горилла!
Dialogue: 0,0:09:28.94,0:09:30.98,Default,,0,0,0,,Шо... Бастауыш сынып оқушысы сияқты.
Dialogue: 0,0:09:31.32,0:09:33.32,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:09:33.44,0:09:36.78,Default,,0,0,0,,Piyo Piyo тілі? үш пиё пиё ағайынды
Dialogue: 0,0:09:36.90,0:09:38.11,Default,,0,0,0,,Бауырлар емес!
Dialogue: 0,0:09:38.24,0:09:40.41,Default,,0,0,0,,Егер сізді арандатқан жағдайда не істеу керек?
Dialogue: 0,0:09:40.53,0:09:41.70,Default,,0,0,0,,Өйткені!
Dialogue: 0,0:09:42.03,0:09:44.08,Default,,0,0,0,,Хмм? (мұрын дыбысы)
Dialogue: 0,0:09:44.20,0:09:46.29,Default,,0,0,0,,Бұл сүттің иісі сияқты.
Dialogue: 0,0:09:46.41,0:09:48.54,Default,,0,0,0,,Ах~ Не деген!
Dialogue: 0,0:09:48.67,0:09:51.13,Default,,0,0,0,,Мен мектеп оқушысы болғанша «ni~ni~» дедім.
Dialogue: 0,0:09:51.25,0:09:53.92,Default,,0,0,0,,Ананың кеудесін сорма!
Dialogue: 0,0:09:54.05,0:09:54.88,Default,,0,0,0,,Бұл шайтан.
Dialogue: 0,0:09:55.01,0:09:56.13,Default,,0,0,0,,Не болды? Сен ашулысың ба?
Dialogue: 0,0:09:56.26,0:09:59.64,Default,,0,0,0,,Жүр, жылдамдығы нөлдік ақымақ семіз жігіт!
Dialogue: 0,0:09:59.93,0:10:02.60,Default,,0,0,0,,Қалпақ киіңіз!
Dialogue: 0,0:10:05.98,0:10:07.06,Default,,0,0,0,,Анау қызыл мұрын жоқ.
Dialogue: 0,0:10:07.48,0:10:09.02,Default,,0,0,0,,Тынш!
Dialogue: 0,0:10:09.90,0:10:11.73,Default,,0,0,0,,Кімнің жылдамдығы нөлдік!
Dialogue: 0,0:10:12.06,0:10:14.03,Default,,0,0,0,,Сызық бұзылды! (Көрермендер) Бұл қап! Оны құрт!
Dialogue: 0,0:10:14.15,0:10:15.07,Default,,0,0,0,,Бұл қақпан, Касамацу!
Dialogue: 0,0:10:15.78,0:10:16.65,Default,,0,0,0,,Көлденең!
Dialogue: 0,0:10:18.03,0:10:19.86,Default,,0,0,0,,Нува!
Dialogue: 0,0:10:20.16,0:10:22.37,Default,,0,0,0,,Үлкен жігіт міндетті түрде жеңе алмайды.
Dialogue: 0,0:10:22.49,0:10:24.91,Default,,0,0,0,,Адамдарға бүйірден жақындасаңыз қауіпті.
Dialogue: 0,0:10:26.29,0:10:27.62,Default,,0,0,0,,О!
Dialogue: 0,0:10:28.62,0:10:31.08,Default,,0,0,0,,Бұл бірлескен ойын. Барлығы керемет!
Dialogue: 0,0:10:31.21,0:10:34.21,Default,,0,0,0,,Mudgate 12 Yard Gain
Dialogue: 0,0:10:34.88,0:10:36.21,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:36.55,0:10:38.47,Default,,0,0,0,,Не... не!
Dialogue: 0,0:10:39.76,0:10:40.93,Default,,0,0,0,,4 ярд өсімі
Dialogue: 0,0:10:41.64,0:10:42.47,Default,,0,0,0,,Муккки~!
Dialogue: 0,0:10:42.60,0:10:43.43,Default,,0,0,0,,8 ярд өсімі
Dialogue: 0,0:10:43.85,0:10:45.06,Default,,0,0,0,,Мен Муккимін~!
Dialogue: 0,0:10:45.18,0:10:46.39,Default,,0,0,0,,14 ярд өсімі
Dialogue: 0,0:10:47.35,0:10:49.27,Default,,0,0,0,,Қандай дөрекі
Dialogue: 0,0:10:49.44,0:10:50.44,Default,,0,0,0,,
Dialogue: 0,0:10:50.56,0:10:52.52,Default,,0,0,0,,Doimon Touchdown
Dialogue: 0,0:10:52.98,0:10:54.27,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:10:54.40,0:10:56.73,Default,,0,0,0,,Неліктен сіз Деймонды жақтайсыз?
Dialogue: 0,0:10:56.86,0:11:00.07,Default,,0,0,0,,А... жоқ, бізде жаттығу немесе бірдеңе болды, сондықтан...
Dialogue: 0,0:11:00.20,0:11:01.03,Default,,0,0,0,,Иә
Dialogue: 0,0:11:02.62,0:11:04.78,Default,,0,0,0,,Менің күн сфинксін не деп атауға болады
Dialogue: 0,0:11:04.91,0:11:06.20,Default,,0,0,0,,Қандай жексұрын!
Dialogue: 0,0:11:06.33,0:11:07.70,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:08.37,0:11:11.25,Default,,0,0,0,,Үлкен мәселе емес, пирамида сызығы да.
Dialogue: 0,0:11:11.37,0:11:13.42,Default,,0,0,0,,Әй, кішкентай бала!
Dialogue: 0,0:11:13.92,0:11:15.88,Default,,0,0,0,,Менің атым «Мен» емес!
Dialogue: 0,0:11:16.59,0:11:18.05,Default,,0,0,0,,Ғажайып ғажайып!
Dialogue: 0,0:11:18.17,0:11:21.59,Default,,0,0,0,,Бірінші тайм бір ұпай айырмашылығымен аяқталды! Екінші таймда жағдайды өзгерту үшін барымызды салайық!
Dialogue: 0,0:11:21.97,0:11:23.84,Default,,0,0,0,,А, Монта-кун?
Dialogue: 0,0:11:24.22,0:11:27.43,Default,,0,0,0,,Бірінші жарты мен сендерге ұсқынсыз жерін көрсеттім.
Dialogue: 0,0:11:28.18,0:11:30.85,Default,,0,0,0,,Төгілген допты өзім қайтарамын.
Dialogue: 0,0:11:31.23,0:11:32.06,Default,,0,0,0,,Екінші жарты...
Dialogue: 0,0:11:33.19,0:11:34.77,Default,,0,0,0,,Coolness Max Super Catch
Dialogue: 0,0:11:34.90,0:11:37.53,Default,,0,0,0,,Біз өз стигмамызды міндетті түрде қалпына келтіреміз!
Dialogue: 0,0:11:37.86,0:11:40.07,Default,,0,0,0,,Керемет!
Dialogue: 0,0:11:40.19,0:11:42.53,Default,,0,0,0,,Ух... иә, сәттілік!
Dialogue: 0,0:11:43.28,0:11:44.91,Default,,0,0,0,,Стигманы өтеу керек
Dialogue: 0,0:11:45.03,0:11:46.16,Default,,0,0,0,,Уайымдама...
Dialogue: 0,0:11:47.58,0:11:51.62,Default,,0,0,0,,Бұл стигманы қайтару емес, беделді қалпына келтіру.
Dialogue: 0,0:11:51.75,0:11:54.21,Default,,0,0,0,,Аа... Жарайды, мен қолымнан келгенін істеп жатырмын.
Dialogue: 0,0:11:54.33,0:11:55.58,Default,,0,0,0,,Мәліметтер...
Dialogue: 0,0:11:55.71,0:11:57.71,Default,,0,0,0,,Ия... Салқынсыз (Монта) Ия...
Dialogue: 0,0:11:59.30,0:12:00.71,Default,,0,0,0,,7:3?
Dialogue: 0,0:12:00.84,0:12:01.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:01.97,0:12:04.34,Default,,0,0,0,,Жоқ, бұл желінің күші.
Dialogue: 0,0:12:04.51,0:12:07.05,Default,,0,0,0,,Деймон тістеп жатса да
Dialogue: 0,0:12:07.18,0:12:08.81,Default,,0,0,0,,7:3 шамасында
Dialogue: 0,0:12:08.93,0:12:10.68,Default,,0,0,0,,Менің ойымша, оны күн итермелейді.
Dialogue: 0,0:12:10.98,0:12:12.18,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:12:12.31,0:12:15.56,Default,,0,0,0,,Бұл Жапониядағы ең ауыр сызық. Біздің жеңілетініміз жоқ.
Dialogue: 0,0:12:15.69,0:12:17.48,Default,,0,0,0,,Бірақ Бакс керісінше.
Dialogue: 0,0:12:17.61,0:12:20.11,Default,,0,0,0,,Күн 3:7-де итеріледі
Dialogue: 0,0:12:20.69,0:12:23.40,Default,,0,0,0,,Маған әсіресе төртінші Хилл Демонның қозғалысы ұнайды!
Dialogue: 0,0:12:23.53,0:12:24.74,Default,,0,0,0,,Өтінемін, мұндай істерді қойшы.
Dialogue: 0,0:12:26.24,0:12:29.24,Default,,0,0,0,,Неліктен сіз Деймонды жақсы көресіз?
Dialogue: 0,0:12:29.37,0:12:31.95,Default,,0,0,0,,Сіздің түсіндірмеңіз өте жағымсыз!
Dialogue: 0,0:12:32.08,0:12:34.83,Default,,0,0,0,,Жоқ, мен тек объективті айтып отырмын...
Dialogue: 0,0:12:36.83,0:12:38.09,Default,,0,0,0,,Бұл қызықты, бірақ мога!
Dialogue: 0,0:12:38.34,0:12:39.42,Default,,0,0,0,,Эй... Уф
Dialogue: 0,0:12:39.55,0:12:41.80,Default,,0,0,0,,Осындай әлсіз сызыққа мәжбүр болу
Dialogue: 0,0:12:42.01,0:12:43.92,Default,,0,0,0,,Бұл Деймон сияқты бір ұпайлық айырмашылық!
Dialogue: 0,0:12:44.05,0:12:45.55,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:12:45.68,0:12:47.76,Default,,0,0,0,,Сізге қанағат ету үшін менде қанша ұят бар?
Dialogue: 0,0:12:48.18,0:12:49.85,Default,,0,0,0,,Менің бетімді құртпақшысың ба?
Dialogue: 0,0:12:50.85,0:12:52.56,Default,,0,0,0,,Харао тынышталсын
Dialogue: 0,0:12:53.10,0:12:55.10,Default,,0,0,0,,Бұл сізді тыныштандыра ала ма?
Dialogue: 0,0:12:55.23,0:12:56.85,Default,,0,0,0,,Жарайды, үндемеңіз.
Dialogue: 0,0:12:56.98,0:12:58.94,Default,,0,0,0,,Жалпы, мені қорғайтын сендерсіңдер...
Dialogue: 0,0:12:59.52,0:13:00.61,Default,,0,0,0,,Мен саған аузыңды жабуды айтып тұрмын!
Dialogue: 0,0:13:01.03,0:13:02.61,Default,,0,0,0,,Ой, жоқ…
Dialogue: 0,0:13:03.32,0:13:06.53,Default,,0,0,0,,Сызық, әрине, американдық футболдың кілті.
Dialogue: 0,0:13:06.95,0:13:09.20,Default,,0,0,0,,Бірақ сіз тек сызықтармен жеңе алмайсыз.
Dialogue: 0,0:13:10.16,0:13:14.04,Default,,0,0,0,,Харао: Сіз де ойлануыңыз керек нәрселер бар, солай ма?
Dialogue: 0,0:13:14.58,0:13:18.00,Default,,0,0,0,,Допты беру кезінде абайсызда тым жоғары көтеру
Dialogue: 0,0:13:18.25,0:13:20.09,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:13:21.17,0:13:24.01,Default,,0,0,0,,Осылай жасасаңыз, доп бірден ұрланады.
Dialogue: 0,0:13:24.51,0:13:27.34,Default,,0,0,0,,Сызық үзілсе де өту
Dialogue: 0,0:13:27.47,0:13:30.14,Default,,0,0,0,,Жоғары дәрежелі қорғаушы.
Dialogue: 0,0:13:33.89,0:13:36.23,Default,,0,0,0,,Не? Сіз ұрысып жатырсыз ба?
Dialogue: 0,0:13:36.35,0:13:37.48,Default,,0,0,0,,Ішкі жанжал?
Dialogue: 0,0:13:38.35,0:13:40.94,Default,,0,0,0,,Төмен ұстап, допты жіберіңіз
Dialogue: 0,0:13:41.07,0:13:43.61,Default,,0,0,0,,Бұл сіз оңай жасай алатын нәрсе.
Dialogue: 0,0:13:43.73,0:13:44.99,Default,,0,0,0,,Біріккен Араб Әмірліктеріне кірді
Dialogue: 0,0:13:45.36,0:13:48.41,Default,,0,0,0,,Tsk, лақтыру тәсілін өзгерте аласыз ба...
Dialogue: 0,0:13:48.91,0:13:52.37,Default,,0,0,0,,Енді оны құлатып, допты төгуге мәжбүрлеу мүмкін емес.
Dialogue: 0,0:13:52.49,0:13:55.66,Default,,0,0,0,,Өйткені, Бамба мырза команданың кілті.
Dialogue: 0,0:13:56.33,0:13:58.00,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:13:58.42,0:14:02.00,Default,,0,0,0,,Бұдан былай Хараоның пасын ұстап алу керек.
Dialogue: 0,0:14:02.42,0:14:05.17,Default,,0,0,0,,Қалай болғанда да шабуыл! Қорғаныс кезінде де шабуыл жасаңыз!
Dialogue: 0,0:14:05.67,0:14:08.38,Default,,0,0,0,,Тек шабуылдар!
Dialogue: 0,0:14:08.84,0:14:09.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:10.01,0:14:11.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:11.43,0:14:14.18,Default,,0,0,0,,Муки~! Өзіңді дайында, Сфинкс!
Dialogue: 0,0:14:14.31,0:14:16.02,Default,,0,0,0,,Мамори-сан, қараңызшы!
Dialogue: 0,0:14:16.14,0:14:17.89,Default,,0,0,0,,Ұстау, ұстау
Dialogue: 0,0:14:18.02,0:14:20.65,Default,,0,0,0,,Ұста, ұста, ұста... Мен ұстай беремін!
Dialogue: 0,0:14:20.77,0:14:23.32,Default,,0,0,0,,Ух... иә, сәттілік Монта-кун
Dialogue: 0,0:14:23.44,0:14:24.82,Default,,0,0,0,,Техникамды қолдансам да кесіп өте алмаймын.
Dialogue: 0,0:14:25.23,0:14:27.53,Default,,0,0,0,,♪ Мукья, Мамори-сан үшін
Dialogue: 0,0:14:27.65,0:14:30.41,Default,,0,0,0,,Әр адамның түсінуге оңай мінезі бар.
Dialogue: 0,0:14:30.82,0:14:32.45,Default,,0,0,0,,Басшының баяндамасы
Dialogue: 0,0:14:32.70,0:14:35.62,Default,,0,0,0,,Eyeshield жүгірісі біршама сенімсіз.
Dialogue: 0,0:14:35.95,0:14:37.29,Default,,0,0,0,,Тіпті сызықты да жеңу керек
Dialogue: 0,0:14:37.41,0:14:39.67,Default,,0,0,0,,Дұрыс, алыс қашықтықта ұрылмайды.
Dialogue: 0,0:14:41.42,0:14:43.50,Default,,0,0,0,,Одан да 80 қабылдағыш саны.
Dialogue: 0,0:14:43.88,0:14:47.05,Default,,0,0,0,,Егер сіз оны ұстап алсаңыз, Деймонға жол берілмейді.
Dialogue: 0,0:14:49.51,0:14:51.05,Default,,0,0,0,,Орақ вагонды шығарыңыз
Dialogue: 0,0:14:51.39,0:14:55.18,Default,,0,0,0,,Орақ арба? Оның монах болғанына бір жыл ғана болды, иә?
Dialogue: 0,0:14:55.31,0:14:58.31,Default,,0,0,0,,Жоқ, оны жақын арада нақты ұрыста қолдануға болады.
Dialogue: 0,0:14:58.68,0:15:00.81,Default,,0,0,0,,Мен Бамбаның пікірімен келісемін.
Dialogue: 0,0:15:01.77,0:15:02.69,Default,,0,0,0,,Орақ арба!
Dialogue: 0,0:15:07.07,0:15:09.19,Default,,0,0,0,,Менің кезегім келді ме?
Dialogue: 0,0:15:16.37,0:15:18.08,Default,,0,0,0,,Екінші жартысы басталады
Dialogue: 0,0:15:19.37,0:15:22.63,Default,,0,0,0,,Уау~ Тағы бір үлкен адам кіріп келді.
Dialogue: 0,0:15:24.46,0:15:25.50,Default,,0,0,0,,Хуу~
Dialogue: 0,0:15:26.05,0:15:27.76,Default,,0,0,0,,Сәлем
Dialogue: 0,0:15:27.88,0:15:31.47,Default,,0,0,0,,Сіз Таййоны тек пирамида сызықтарынан тұратын команда деп ойлайсыз, солай ма?
Dialogue: 0,0:15:32.05,0:15:34.80,Default,,0,0,0,,Егер үлкендер пирамида сызығында болса
Dialogue: 0,0:15:34.97,0:15:37.89,Default,,0,0,0,,Мен танктің бұрышшысымын!
Dialogue: 0,0:15:38.06,0:15:42.23,Default,,0,0,0,,Ежелгі Египет күйме өркениетіне тең
Dialogue: 0,0:15:42.35,0:15:44.52,Default,,0,0,0,,Оқулықта жазылған!
Dialogue: 0,0:15:45.61,0:15:46.73,Default,,0,0,0,,Резервуар?
Dialogue: 0,0:15:46.86,0:15:49.07,Default,,0,0,0,,Ах! Бұл дұрыс емес!
Dialogue: 0,0:15:49.19,0:15:52.15,Default,,0,0,0,,Сол заманауи қару! Менікі - ежелгі қару!
Dialogue: 0,0:15:52.86,0:15:54.28,Default,,0,0,0,,Жақсы, орақ арба
Dialogue: 0,0:15:54.66,0:15:57.12,Default,,0,0,0,,Күйдегі айырмашылықты еске салайын!
Dialogue: 0,0:15:57.33,0:16:00.70,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:02.46,0:16:05.21,Default,,0,0,0,,О...
Dialogue: 0,0:16:06.00,0:16:07.42,Default,,0,0,0,,Бұрыш
Dialogue: 0,0:16:07.54,0:16:09.92,Default,,0,0,0,,Бұл өтуді ұстауға кедергі келтіретін позиция.
Dialogue: 0,0:16:10.05,0:16:12.55,Default,,0,0,0,,Кішкентай, жүйрік адам жасамайды ма?
Dialogue: 0,0:16:12.68,0:16:15.97,Default,,0,0,0,,Күннің салмағы қанша?
Dialogue: 0,0:16:16.10,0:16:18.47,Default,,0,0,0,,Ей, үрейленбе!
Dialogue: 0,0:16:20.60,0:16:21.98,Default,,0,0,0,,Осындай үлкен денемен
Dialogue: 0,0:16:22.10,0:16:24.27,Default,,0,0,0,,Жылдамдыққа жете алмаймын!
Dialogue: 0,0:16:24.73,0:16:26.31,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:16:26.44,0:16:30.94,Default,,0,0,0,,Мен дәл қазір оның неліктен танк екенін көрсетемін.
Dialogue: 0,0:16:31.32,0:16:32.90,Default,,0,0,0,,Ху~ Хе хе хе...
Dialogue: 0,0:16:33.03,0:16:35.11,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:16:36.45,0:16:39.95,Default,,0,0,0,,Муки~!
Dialogue: 0,0:16:40.95,0:16:43.08,Default,,0,0,0,,Иә? (Банба) Kamaguruma Go!
Dialogue: 0,0:16:43.46,0:16:45.33,Default,,0,0,0,,Танк соққысы!
Dialogue: 0,0:16:45.46,0:16:46.58,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:48.34,0:16:49.17,Default,,0,0,0,,Tsk
Dialogue: 0,0:16:49.42,0:16:50.67,Default,,0,0,0,,Өту уақыты!
Dialogue: 0,0:16:50.80,0:16:51.88,Default,,0,0,0,,Сәйкес келмейді!
Dialogue: 0,0:16:54.63,0:16:57.80,Default,,0,0,0,,Танк соққысы Танк соққысы♪
Dialogue: 0,0:16:57.93,0:16:59.64,Default,,0,0,0,,Монта, жақсысың ба?
Dialogue: 0,0:17:00.43,0:17:04.85,Default,,0,0,0,,Ха ха ха... Мен жүгіре бастаған сәт...
Dialogue: 0,0:17:05.35,0:17:08.81,Default,,0,0,0,,Жүрегім дүрсілдеп, бір сәт тынысым тоқтады.
Dialogue: 0,0:17:09.19,0:17:10.94,Default,,0,0,0,,Дөңгелек – бұл техника
Dialogue: 0,0:17:11.07,0:17:13.65,Default,,0,0,0,,Менің өту уақытым сәйкес келмейді.
Dialogue: 0,0:17:14.15,0:17:18.24,Default,,0,0,0,,Түсіндім... Бұл бірінші таймдағыдай пас өтпейді деген сөз.
Dialogue: 0,0:17:18.37,0:17:21.95,Default,,0,0,0,,Танк соққысы Танк соққысы♪
Dialogue: 0,0:17:22.08,0:17:23.54,Default,,0,0,0,,Set hat!
Dialogue: 0,0:17:24.62,0:17:26.62,Default,,0,0,0,,Соққы!
Dialogue: 0,0:17:26.75,0:17:28.21,Default,,0,0,0,,Тағы да…
Dialogue: 0,0:17:28.79,0:17:30.92,Default,,0,0,0,,Ах (Юкимицу) Мен рұқсат ала алмаймын.
Dialogue: 0,0:17:31.05,0:17:33.80,Default,,0,0,0,,Я~ Керемет!
Dialogue: 0,0:17:34.34,0:17:35.84,Default,,0,0,0,,Камагурума-кунның қосылуымен
Dialogue: 0,0:17:35.97,0:17:39.22,Default,,0,0,0,,Антагонистік тепе-теңдік кенет бұзылды.
Dialogue: 0,0:17:39.47,0:17:42.18,Default,,0,0,0,,Бакс енді 3:7 емес.
Dialogue: 0,0:17:42.31,0:17:45.43,Default,,0,0,0,,Ең көбі 4:6... Жоқ, мүмкін 5 минут.
Dialogue: 0,0:17:45.85,0:17:47.19,Default,,0,0,0,,Соққы!
Dialogue: 0,0:17:47.52,0:17:49.02,Default,,0,0,0,,Соққы!
Dialogue: 0,0:17:49.40,0:17:51.23,Default,,0,0,0,,Тоқ!
Dialogue: 0,0:17:51.94,0:17:56.28,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:17:56.40,0:17:57.57,Default,,0,0,0,,Монта!
Dialogue: 0,0:17:57.78,0:17:59.32,Default,,0,0,0,,Жағдайың қалай? Тұра аласың ба?
Dialogue: 0,0:17:59.45,0:18:01.99,Default,,0,0,0,,Уф... әйтеуір
Dialogue: 0,0:18:03.83,0:18:06.50,Default,,0,0,0,,Төбе жын... (Сілік жын) Жалғастыр, қарғыс атқыр маймыл.
Dialogue: 0,0:18:07.12,0:18:08.54,Default,,0,0,0,,Е...
Dialogue: 0,0:18:12.29,0:18:14.80,Default,,0,0,0,,Қыңылдауды доғар, қарғыс атқыр маймыл!
Dialogue: 0,0:18:15.34,0:18:17.01,Default,,0,0,0,,Хе, о...
Dialogue: 0,0:18:19.05,0:18:20.22,Default,,0,0,0,,Монта…
Dialogue: 0,0:18:20.39,0:18:22.55,Default,,0,0,0,,Гррр... Хэхехехе...
Dialogue: 0,0:18:22.68,0:18:24.47,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:18:25.60,0:18:27.98,Default,,0,0,0,,Мен бұл жолы рұқсат қағазын аламын.
Dialogue: 0,0:18:31.27,0:18:33.86,Default,,0,0,0,,Уф... Jump Mac...
Dialogue: 0,0:18:33.98,0:18:34.82,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:18:35.94,0:18:38.70,Default,,0,0,0,,Ху~ Асуларды ұстау әлемі де
Dialogue: 0,0:18:38.82,0:18:40.28,Default,,0,0,0,,Құдірет аман болсын!
Dialogue: 0,0:18:40.91,0:18:43.24,Default,,0,0,0,,Увааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:18:43.53,0:18:44.45,Default,,0,0,0,,Хехе
Dialogue: 0,0:18:44.87,0:18:48.79,Default,,0,0,0,,Менің танкім соқтығысқанша ештеңе істей алмайсың!
Dialogue: 0,0:18:49.83,0:18:51.50,Default,,0,0,0,,Егер Бакс жұп болса
Dialogue: 0,0:18:52.29,0:18:54.75,Default,,0,0,0,,Күн сызығы 7:3 итеріп тұрғандықтан
Dialogue: 0,0:18:55.71,0:18:57.92,Default,,0,0,0,,Бір күні Деймон жеңіледі...
Dialogue: 0,0:18:58.97,0:19:01.34,Default,,0,0,0,,Сіз не істеп жатырсыз? Мен ғана.
Dialogue: 0,0:19:02.30,0:19:05.56,Default,,0,0,0,,Мен тіпті Мамори-санға уәде бердім.
Dialogue: 0,0:19:08.10,0:19:10.81,Default,,0,0,0,,Мен Сенна сияқты жалтаруға шебер емеспін.
Dialogue: 0,0:19:12.06,0:19:16.07,Default,,0,0,0,,Курита мырза сияқты күшпен жеңу мүмкін емес.
Dialogue: 0,0:19:17.73,0:19:19.15,Default,,0,0,0,,Америка футболы да?
Dialogue: 0,0:19:23.82,0:19:25.20,Default,,0,0,0,,Америка футболы да...
Dialogue: 0,0:19:25.91,0:19:27.74,Default,,0,0,0,,Тек аулау жеткілікті емес пе?
Dialogue: 0,0:19:31.42,0:19:35.38,Default,,0,0,0,,Мен бұл жерде де істей алмаймын!
Dialogue: 0,0:19:36.25,0:19:37.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:39.84,0:19:40.88,Default,,0,0,0,,Монта…
Dialogue: 0,0:19:43.97,0:19:49.98,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:20:52.91,0:20:58.92,Default,,0,0,0,,~♪
Dialogue: 0,0:20:59.88,0:21:03.38,Default,,0,0,0,,Жапония құрамасының шешуші матчы да шарықтау шегі!
Dialogue: 0,0:21:03.59,0:21:05.84,Default,,0,0,0,,Сфинкс ақыры шыдамсыздығын көрсетеді.
Dialogue: 0,0:21:06.22,0:21:09.47,Default,,0,0,0,,Барыңыз~ Ібіліс жарғанақтар! Барлығына сәттілік!
Dialogue: 0,0:21:09.64,0:21:12.98,Default,,0,0,0,,Бар, жүр, Сена, жүгір, ұш!
Dialogue: 0,0:21:13.10,0:21:15.44,Default,,0,0,0,,Келесі жолы «Көз қалқаны 21»
Dialogue: 0,0:21:17.15,0:21:18.90,Default,,0,0,0,,Я-! Ха-!
Dialogue: 0,0:21:20.40,0:21:26.40,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory