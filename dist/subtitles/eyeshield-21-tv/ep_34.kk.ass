Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.96,0:00:12.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:13.68,0:00:14.68,Default,,0,0,0,,Ах... Таки-сан!
Dialogue: 0,0:00:16.43,0:00:17.26,Default,,0,0,0,,Хехехе
Dialogue: 0,0:00:17.39,0:00:19.60,Default,,0,0,0,,Сәлем...Сәлем
Dialogue: 0,0:00:20.52,0:00:21.47,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:00:21.73,0:00:23.60,Default,,0,0,0,,Мен оны асыға күтемін, балам.
Dialogue: 0,0:00:23.73,0:00:27.06,Default,,0,0,0,,Мен сіздің денеңізді шатастырып аламын деп ойладым.
Dialogue: 0,0:00:27.19,0:00:29.57,Default,,0,0,0,,Боқ жігітке сәлем айт
Dialogue: 0,0:00:29.82,0:00:31.23,Default,,0,0,0,,Ухахахаха
Dialogue: 0,0:00:31.36,0:00:33.53,Default,,0,0,0,,Уф... Мен толығымен нысанаға алдым.
Dialogue: 0,0:00:35.32,0:00:36.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:36.61,0:00:40.08,Default,,0,0,0,,Мен Сузунэге сондай керемет сөздер айттым.
Dialogue: 0,0:00:40.62,0:00:41.83,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:00:42.08,0:00:44.33,Default,,0,0,0,,Не болды? көк жүзімен
Dialogue: 0,0:00:44.46,0:00:45.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:45.50,0:00:47.25,Default,,0,0,0,,А... жоқ
Dialogue: 0,0:00:47.38,0:00:49.96,Default,,0,0,0,,Бұл жұмсақ Ахаха
Dialogue: 0,0:00:50.09,0:00:51.17,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:00:51.76,0:00:55.68,Default,,0,0,0,,Осы икемді денемен мен бәрін істей аламын.
Dialogue: 0,0:00:56.18,0:00:57.05,Default,,0,0,0,,Ум...
Dialogue: 0,0:00:57.30,0:01:00.06,Default,,0,0,0,,Таки-санның ұстанымы қандай?
Dialogue: 0,0:01:00.18,0:01:01.64,Default,,0,0,0,,Позиция? иә
Dialogue: 0,0:01:03.48,0:01:06.44,Default,,0,0,0,,Маған күрделі позициялар қажет емес.
Dialogue: 0,0:01:06.69,0:01:08.86,Default,,0,0,0,,Мен бәрібір мұны істей аламын.
Dialogue: 0,0:01:12.82,0:01:14.44,Default,,0,0,0,,Жер
Dialogue: 0,0:01:15.20,0:01:16.78,Default,,0,0,0,,Ережелерді білмейсің бе?
Dialogue: 0,0:01:17.07,0:01:19.95,Default,,0,0,0,,Дұрыс, мен ешқашан матчқа қатысқан емеспін.
Dialogue: 0,0:01:20.08,0:01:22.74,Default,,0,0,0,,Ережелерді немесе позицияларды білу мүмкін емес.
Dialogue: 0,0:01:23.66,0:01:26.04,Default,,0,0,0,,Сөйтсе де, кәсіби қабылдау сынағы?
Dialogue: 0,0:01:26.25,0:01:27.54,Default,,0,0,0,,Тым үлкен!
Dialogue: 0,0:01:27.67,0:01:29.54,Default,,0,0,0,,Сондықтан сен ақымақсың
Dialogue: 0,0:01:29.67,0:01:30.71,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:01:31.13,0:01:33.80,Default,,0,0,0,,A… Ахаха…
Dialogue: 0,0:01:34.01,0:01:40.01,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:47.91,0:02:53.92,Default,,0,0,0,,~♪
Dialogue: 0,0:03:00.34,0:03:01.93,Default,,0,0,0,,Бұл соңғы сынақ
Dialogue: 0,0:03:02.05,0:03:04.89,Default,,0,0,0,,Мектептер арасындағы матчтың нәтижесі – табыс пен сәтсіздіктің айырмашылығы.
Dialogue: 0,0:03:05.01,0:03:06.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:06.22,0:03:09.02,Default,,0,0,0,,Бұл адам біреуге ұқсайды...
Dialogue: 0,0:03:09.14,0:03:11.52,Default,,0,0,0,,Біздің В тобы шабуылдаушы жағында
Dialogue: 0,0:03:11.64,0:03:14.15,Default,,0,0,0,,Көбірек жанасулар жинау арқылы
Dialogue: 0,0:03:14.27,0:03:16.23,Default,,0,0,0,,Сіз өзіңіздің шабуыл күшіңізді көрсете аласыз
Dialogue: 0,0:03:16.36,0:03:19.49,Default,,0,0,0,,Бұл өту жылдамдығы сәйкесінше артады дегенді білдіреді.
Dialogue: 0,0:03:19.78,0:03:23.41,Default,,0,0,0,,Басқаша айтқанда, В тобында барлығының тағдыры ортақ.
Dialogue: 0,0:03:23.66,0:03:25.20,Default,,0,0,0,,Сөзсіз жеңіңіз!
Dialogue: 0,0:03:25.33,0:03:27.99,Default,,0,0,0,,Мен ширек қорғаушы ойнаймын.
Dialogue: 0,0:03:28.12,0:03:30.41,Default,,0,0,0,,Құрметпен, Джимми Симард
Dialogue: 0,0:03:30.54,0:03:32.54,Default,,0,0,0,,Джимми Симар?
Dialogue: 0,0:03:33.37,0:03:34.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:34.92,0:03:36.13,Default,,0,0,0,,Бұл Исимару мырза!
Dialogue: 0,0:03:36.88,0:03:37.75,Default,,0,0,0,,Не?
Dialogue: 0,0:03:38.09,0:03:39.76,Default,,0,0,0,,Сіз мені танисыз ба?
Dialogue: 0,0:03:39.88,0:03:42.09,Default,,0,0,0,,А... жоқ, шынымен емес... ахаха
Dialogue: 0,0:03:42.51,0:03:45.22,Default,,0,0,0,,Екі команда да дайын!
Dialogue: 0,0:03:45.80,0:03:47.35,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:03:47.72,0:03:49.02,Default,,0,0,0,,Ережені де білмеймін
Dialogue: 0,0:03:49.14,0:03:51.18,Default,,0,0,0,,Мен ешқашан матчқа бармағаныма қарамастан
Dialogue: 0,0:03:51.31,0:03:52.85,Default,,0,0,0,,Неліктен сізде сонша еркіндік бар?
Dialogue: 0,0:03:52.98,0:03:53.81,Default,,0,0,0,,Сол адам...
Dialogue: 0,0:03:54.40,0:03:57.07,Default,,0,0,0,,Хмм~ Не деген сұмдық бала~
Dialogue: 0,0:03:57.65,0:03:59.48,Default,,0,0,0,,Мені нысанаға алып жатыр.
Dialogue: 0,0:03:59.61,0:04:00.53,Default,,0,0,0,,
Dialogue: 0,0:04:00.90,0:04:03.49,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:04:05.20,0:04:06.16,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:04:06.49,0:04:07.91,Default,,0,0,0,,Мен өте алмаймын.
Dialogue: 0,0:04:09.58,0:04:11.16,Default,,0,0,0,,Ахаха! Міне!
Dialogue: 0,0:04:12.04,0:04:12.87,Default,,0,0,0,,Да!
Dialogue: 0,0:04:13.75,0:04:15.58,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:04:15.71,0:04:17.17,Default,,0,0,0,,Мен ең жақсымын~
Dialogue: 0,0:04:17.29,0:04:19.59,Default,,0,0,0,,Сәтті өту!
Dialogue: 0,0:04:19.80,0:04:22.22,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,0:04:22.34,0:04:23.93,Default,,0,0,0,,Айтуынша, кеше ол мөлдір сәбиді немесе сондай бір нәрсені тапқан екен—
Dialogue: 0,0:04:24.05,0:04:26.34,Default,,0,0,0,,Мен ережелерді немесе позицияларды білмесем де
Dialogue: 0,0:04:26.47,0:04:27.55,Default,,0,0,0,,Мен билет ала аламын ба?
Dialogue: 0,0:04:28.97,0:04:30.77,Default,,0,0,0,,Ммммм
Dialogue: 0,0:04:31.27,0:04:32.31,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:32.43,0:04:33.94,Default,,0,0,0,,
Dialogue: 0,0:04:34.06,0:04:35.23,Default,,0,0,0,,Қалпақ киіңіз!
Dialogue: 0,0:04:37.65,0:04:38.77,Default,,0,0,0,,Егер ағам мен әпкем әлі тірі болса…
Dialogue: 0,0:04:38.90,0:04:39.73,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:40.73,0:04:42.40,Default,,0,0,0,,Макс бомбалаушы!
Dialogue: 0,0:04:42.53,0:04:43.49,Default,,0,0,0,,Дова~
Dialogue: 0,0:04:45.07,0:04:46.32,Default,,0,0,0,,
Dialogue: 0,0:04:46.61,0:04:48.83,Default,,0,0,0,,Гехо! Ой жаман жаман
Dialogue: 0,0:04:48.95,0:04:50.74,Default,,0,0,0,,Менің қолым есінен танып қалды~
Dialogue: 0,0:04:50.87,0:04:52.04,Default,,0,0,0,,Ахаха (қадам дыбысы)
Dialogue: 0,0:04:52.16,0:04:53.33,Default,,0,0,0,,Гяаааааааааааааааааааааааааа
Dialogue: 0,0:04:53.45,0:04:56.46,Default,,0,0,0,,Ой, кешіріңіз, мен аяғымнан тұрып қалдым.
Dialogue: 0,0:04:57.13,0:04:59.88,Default,,0,0,0,,Қорқынышты! Әдейі ұшудан басқа
Dialogue: 0,0:05:00.17,0:05:02.38,Default,,0,0,0,,Онымен лайықты пас беру мүмкін емес.
Dialogue: 0,0:05:02.63,0:05:05.55,Default,,0,0,0,,Эй, бұл да стратегияның бір бөлігі.
Dialogue: 0,0:05:05.68,0:05:09.05,Default,,0,0,0,,Жарайды, олар келесіде. Мен оларды бөлшектеймін!
Dialogue: 0,0:05:09.18,0:05:11.72,Default,,0,0,0,,Уау, ғажайып кісі өлтіру ниеті
Dialogue: 0,0:05:12.02,0:05:13.14,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:05:13.60,0:05:16.10,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:05:18.40,0:05:19.27,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:19.52,0:05:20.82,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:05:22.28,0:05:23.11,Default,,0,0,0,,Ha
Dialogue: 0,0:05:24.19,0:05:25.90,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:05:26.61,0:05:27.66,Default,,0,0,0,,Тамаша!
Dialogue: 0,0:05:28.20,0:05:30.03,Default,,0,0,0,,Бұл жанасу.
Dialogue: 0,0:05:31.16,0:05:31.99,Default,,0,0,0,,Жарайды, мен оны қазір суға толтырамын.
Dialogue: 0,0:05:32.49,0:05:34.50,Default,,0,0,0,,Алаңдамаңыз!
Dialogue: 0,0:05:36.75,0:05:37.58,Default,,0,0,0,,О!
Dialogue: 0,0:05:37.71,0:05:39.54,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:05:41.71,0:05:43.42,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:05:45.21,0:05:46.05,Default,,0,0,0,,Жарайды
Dialogue: 0,0:05:49.14,0:05:50.39,Default,,0,0,0,,Ahhh!
Dialogue: 0,0:05:50.51,0:05:53.89,Default,,0,0,0,,Ұят болды~ Енді Хахан!
Dialogue: 0,0:05:54.27,0:05:55.52,Default,,0,0,0,,Керемет
Dialogue: 0,0:05:55.85,0:05:59.27,Default,,0,0,0,,Ол кісінің денесінің жұмсақтығы шын!
Dialogue: 0,0:05:59.48,0:06:00.56,Default,,0,0,0,,Куу~
Dialogue: 0,0:06:01.02,0:06:04.73,Default,,0,0,0,,Куу~ Қандай жұмсақ денелі бейбақ!
Dialogue: 0,0:06:04.86,0:06:06.90,Default,,0,0,0,,Мен оны міндетті түрде жоямын!
Dialogue: 0,0:06:07.07,0:06:08.40,Default,,0,0,0,,Куу…
Dialogue: 0,0:06:09.95,0:06:11.87,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:06:14.04,0:06:14.87,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:06:17.46,0:06:18.33,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:06:18.46,0:06:19.83,Default,,0,0,0,,Раковина!
Dialogue: 0,0:06:19.96,0:06:21.58,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:06:21.79,0:06:22.88,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:23.42,0:06:25.55,Default,,0,0,0,,Уф
Dialogue: 0,0:06:25.67,0:06:28.93,Default,,0,0,0,,Эй... Эй! Сіз мұнда не істеп жүрсіз?
Dialogue: 0,0:06:29.05,0:06:31.01,Default,,0,0,0,,Айта...
Dialogue: 0,0:06:32.93,0:06:34.10,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:06:34.51,0:06:36.85,Default,,0,0,0,,Не... сен не айтып тұрсың?
Dialogue: 0,0:06:37.02,0:06:39.31,Default,,0,0,0,,Осындай өрескел ойынмен И
Dialogue: 0,0:06:39.44,0:06:40.56,Default,,0,0,0,,Аха…
Dialogue: 0,0:06:40.81,0:06:42.23,Default,,0,0,0,,Бұл туралы
Dialogue: 0,0:06:42.36,0:06:44.23,Default,,0,0,0,,Бұл аяқталады деп ойлайсыз ба?
Dialogue: 0,0:06:44.90,0:06:47.57,Default,,0,0,0,,Таки-сан... сіз толығымен нысанаға алынғансыз.
Dialogue: 0,0:06:47.90,0:06:48.95,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:06:49.53,0:06:50.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:51.20,0:06:52.95,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:06:53.41,0:06:54.78,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:55.03,0:06:57.33,Default,,0,0,0,,Ахаха жақсы аулау!
Dialogue: 0,0:06:57.79,0:06:58.91,Default,,0,0,0,,Мінекей!
Dialogue: 0,0:06:59.66,0:07:00.50,Default,,0,0,0,,Уге~
Dialogue: 0,0:07:01.00,0:07:02.17,Default,,0,0,0,,Не!
Dialogue: 0,0:07:02.29,0:07:03.25,Default,,0,0,0,,Уф
Dialogue: 0,0:07:04.09,0:07:07.13,Default,,0,0,0,,Кешіріңіз, мен тым көп күш қолдандым.
Dialogue: 0,0:07:07.26,0:07:08.88,Default,,0,0,0,,Ойын қазір басталады
Dialogue: 0,0:07:09.01,0:07:12.18,Default,,0,0,0,,Амансың ба, ақымақ жігіт? Ухехе
Dialogue: 0,0:07:12.47,0:07:13.59,Default,,0,0,0,,Ununu...
Dialogue: 0,0:07:13.72,0:07:15.22,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:07:15.35,0:07:18.31,Default,,0,0,0,,Сондай-ақ... Әрине, жақсы Ахаха
Dialogue: 0,0:07:18.56,0:07:20.81,Default,,0,0,0,,Жақында кездескенше! қазірдің өзінде~!
Dialogue: 0,0:07:21.48,0:07:24.27,Default,,0,0,0,,Екеуің тыныш жүріңдер!
Dialogue: 0,0:07:24.65,0:07:27.82,Default,,0,0,0,,Бұл жаман. Бұлай жалғаса берсе не істеуім керек...
Dialogue: 0,0:07:27.94,0:07:29.28,Default,,0,0,0,,Мен не істеуім керек!
Dialogue: 0,0:07:29.40,0:07:31.03,Default,,0,0,0,,
Dialogue: 0,0:07:31.28,0:07:32.74,Default,,0,0,0,,Қалпақ киіңіз!
Dialogue: 0,0:07:32.86,0:07:33.70,Default,,0,0,0,,(Дыбыс)
Dialogue: 0,0:07:33.82,0:07:35.24,Default,,0,0,0,,Не!
Dialogue: 0,0:07:35.37,0:07:36.33,Default,,0,0,0,,(Дыбыс)
Dialogue: 0,0:07:36.45,0:07:37.62,Default,,0,0,0,,Әлі жоқ~
Dialogue: 0,0:07:37.83,0:07:39.29,Default,,0,0,0,,(Дыбыс)
Dialogue: 0,0:07:39.58,0:07:40.62,Default,,0,0,0,,Сонша...
Dialogue: 0,0:07:40.87,0:07:41.87,Default,,0,0,0,,Сәлем... Бұл қорқынышты!
Dialogue: 0,0:07:42.00,0:07:43.79,Default,,0,0,0,,Бұл тым көп!
Dialogue: 0,0:07:44.17,0:07:45.88,Default,,0,0,0,,Ахаха
Dialogue: 0,0:07:46.00,0:07:48.63,Default,,0,0,0,,Бұл мүлде ауырмайды...
Dialogue: 0,0:07:49.42,0:07:50.76,Default,,0,0,0,,Ах... Таки-сан!
Dialogue: 0,0:07:50.88,0:07:52.43,Default,,0,0,0,,Эй, ақымақ.
Dialogue: 0,0:07:52.55,0:07:54.93,Default,,0,0,0,,Тез бас тарту керек.
Dialogue: 0,0:07:55.05,0:07:57.68,Default,,0,0,0,,Бұл екі жағдайда да оңай жеңіс.
Dialogue: 0,0:07:58.06,0:08:00.77,Default,,0,0,0,,Осылай жүре берсең, шіркін. Оны тастаңыз.
Dialogue: 0,0:08:00.89,0:08:04.98,Default,,0,0,0,,Әрине, сіз апелляцияға бере алмайсыз...
Dialogue: 0,0:08:05.86,0:08:07.73,Default,,0,0,0,,Осы қарқынмен... сіз сәтсіздікке ұшырайсыз!
Dialogue: 0,0:08:08.11,0:08:11.61,Default,,0,0,0,,Сондай-ақ... енді жоқ... қазірдің өзінде тоқтатыңыз.
Dialogue: 0,0:08:11.74,0:08:12.61,Default,,0,0,0,,Ақымақ аға!
Dialogue: 0,0:08:12.74,0:08:15.20,Default,,0,0,0,,Егер сіз одан да көп жасасаңыз, сіз жарақат аласыз!
Dialogue: 0,0:08:15.91,0:08:17.33,Default,,0,0,0,,Америка футболы...
Dialogue: 0,0:08:17.58,0:08:19.87,Default,,0,0,0,,Америка футболын ойнауды доғар!
Dialogue: 0,0:08:22.37,0:08:25.04,Default,,0,0,0,,Ал... Мен олай істей алмаймын.
Dialogue: 0,0:08:25.17,0:08:26.25,Default,,0,0,0,,Өйткені I
Dialogue: 0,0:08:26.38,0:08:30.71,Default,,0,0,0,,Мен американдық футболдың жұлдызы боламын деп шештім Ахаха
Dialogue: 0,0:08:30.96,0:08:33.47,Default,,0,0,0,,(Бакуго) Ха! Ал бері кел, шалғайлар! Қатты жарысуға шақырамын!
Dialogue: 0,0:08:33.59,0:08:34.63,Default,,0,0,0,,Таки мырза
Dialogue: 0,0:08:35.01,0:08:37.97,Default,,0,0,0,,Иә, бәріміз де сондаймыз.
Dialogue: 0,0:08:38.10,0:08:39.85,Default,,0,0,0,,Сондықтан мен мұндамын!
Dialogue: 0,0:08:43.85,0:08:45.52,Default,,0,0,0,,Бақа... Ақымақ аға
Dialogue: 0,0:08:45.94,0:08:47.06,Default,,0,0,0,,Сузуне
Dialogue: 0,0:08:47.98,0:08:50.57,Default,,0,0,0,,Мен оны жүзеге асырғым келеді. Бұл анық емес!
Dialogue: 0,0:08:51.28,0:08:54.36,Default,,0,0,0,,Олай болса, Сүзүнэ мұнда сенің ағаң туралы айтып тұр.
Dialogue: 0,0:08:54.49,0:08:56.36,Default,,0,0,0,,Маған қатты қолдау көрсетіңіз
Dialogue: 0,0:08:56.66,0:08:59.16,Default,,0,0,0,,Мен де қолымнан келгенін жасауға тырысамын.
Dialogue: 0,0:09:00.66,0:09:02.83,Default,,0,0,0,,Мен не істей аламын
Dialogue: 0,0:09:03.37,0:09:04.21,Default,,0,0,0,,Гухехе
Dialogue: 0,0:09:04.33,0:09:07.29,Default,,0,0,0,,Бұл мүлдем...
Dialogue: 0,0:09:07.88,0:09:08.92,Default,,0,0,0,,Сенна?
Dialogue: 0,0:09:09.17,0:09:10.71,Default,,0,0,0,,Қалпақ киіңіз!
Dialogue: 0,0:09:12.26,0:09:13.30,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:09:13.42,0:09:14.30,Default,,0,0,0,,Нуу (Жолбарыс) Нуу
Dialogue: 0,0:09:14.42,0:09:15.26,Default,,0,0,0,,Ах
Dialogue: 0,0:09:17.55,0:09:18.97,Default,,0,0,0,,Жоғалтпа!
Dialogue: 0,0:09:21.31,0:09:22.56,Default,,0,0,0,,толығымен бұғатталған
Dialogue: 0,0:09:22.77,0:09:24.68,Default,,0,0,0,,Оның үстіне мен бұл қолмен өте алмаймын.
Dialogue: 0,0:09:24.93,0:09:26.64,Default,,0,0,0,,Міне! иә? орхидея?
Dialogue: 0,0:09:34.61,0:09:35.44,Default,,0,0,0,,(тыныс алу)
Dialogue: 0,0:09:35.65,0:09:37.41,Default,,0,0,0,,Ора (Жолбарыс) Нуу
Dialogue: 0,0:09:38.07,0:09:39.53,Default,,0,0,0,,Қандай қысым!
Dialogue: 0,0:09:39.91,0:09:40.91,Default,,0,0,0,,Қауіпті сенна!
Dialogue: 0,0:09:41.28,0:09:43.41,Default,,0,0,0,,Бұзыңыз!
Dialogue: 0,0:09:43.54,0:09:45.37,Default,,0,0,0,,Жоғал, бұршақ өскіндері!
Dialogue: 0,0:09:46.50,0:09:47.33,Default,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:09:47.46,0:09:49.08,Default,,0,0,0,,Уау~
Dialogue: 0,0:09:49.50,0:09:50.92,Default,,0,0,0,,Мен жеңіле алмаймын!
Dialogue: 0,0:09:56.09,0:09:56.92,Default,,0,0,0,,А...?
Dialogue: 0,0:09:57.30,0:09:58.47,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:59.34,0:10:00.76,Default,,0,0,0,,Неге...
Dialogue: 0,0:10:00.89,0:10:03.60,Default,,0,0,0,,Неліктен ол баяу қозғалатын сияқты?
Dialogue: 0,0:10:04.22,0:10:05.98,Default,,0,0,0,,Ах~
Dialogue: 0,0:10:06.10,0:10:07.94,Default,,0,0,0,,Нуа~
Dialogue: 0,0:10:10.69,0:10:12.32,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:12.82,0:10:14.44,Default,,0,0,0,,Өлім шеруінің нәтижелері?
Dialogue: 0,0:10:14.90,0:10:15.74,Default,,0,0,0,,Оны ұсақтаңыз!
Dialogue: 0,0:10:15.86,0:10:17.15,Default,,0,0,0,,О!
Dialogue: 0,0:10:23.78,0:10:24.99,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:29.37,0:10:32.08,Default,,0,0,0,,Қабақ... 21?
Dialogue: 0,0:10:35.05,0:10:37.63,Default,,0,0,0,,Не? Күткендей...
Dialogue: 0,0:10:37.76,0:10:39.97,Default,,0,0,0,,Сенна - Eyeshield 21?
Dialogue: 0,0:10:43.76,0:10:45.39,Default,,0,0,0,,Ух~ (Жолбарыс) Уау~
Dialogue: 0,0:10:47.02,0:10:48.60,Default,,0,0,0,,Ооо~
Dialogue: 0,0:10:49.14,0:10:50.77,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:52.23,0:10:54.69,Default,,0,0,0,,Ta... Touchdown!
Dialogue: 0,0:10:55.82,0:10:58.94,Default,,0,0,0,,Не... бұл не? ағымдағы сезім
Dialogue: 0,0:11:01.24,0:11:03.87,Default,,0,0,0,,Ой, бұл қызық.
Dialogue: 0,0:11:03.99,0:11:05.45,Default,,0,0,0,,Қалпақ киіңіз!
Dialogue: 0,0:11:07.50,0:11:10.58,Default,,0,0,0,,Басқалармен жеткілікті! Бұршақ өскініне кіріңіз!
Dialogue: 0,0:11:10.71,0:11:12.63,Default,,0,0,0,,Мені ұр! Мені ұр!
Dialogue: 0,0:11:14.13,0:11:16.30,Default,,0,0,0,,Сен өте жақсы істеп жатырсың, Eyeshield-kun.
Dialogue: 0,0:11:16.42,0:11:19.09,Default,,0,0,0,,Қане, бәрің, мені тоқтатыңдар!
Dialogue: 0,0:11:19.22,0:11:20.55,Default,,0,0,0,,Мына қызметші!
Dialogue: 0,0:11:21.01,0:11:23.01,Default,,0,0,0,,Мен... елемеу?
Dialogue: 0,0:11:24.30,0:11:27.97,Default,,0,0,0,,Кішкентай Сена-кунды мұқият белгіле
Dialogue: 0,0:11:28.10,0:11:29.52,Default,,0,0,0,,Ариенаи
Dialogue: 0,0:11:31.56,0:11:33.48,Default,,0,0,0,,Ариенаи!
Dialogue: 0,0:11:35.27,0:11:36.94,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:11:40.40,0:11:41.36,Default,,0,0,0,,Блок!
Dialogue: 0,0:11:41.49,0:11:43.36,Default,,0,0,0,,Мен керемет жұмыс жасадым!
Dialogue: 0,0:11:43.99,0:11:47.08,Default,,0,0,0,,Ой, не! Ауызыңды жап!
Dialogue: 0,0:11:47.70,0:11:50.66,Default,,0,0,0,,Сіз шегінетін адамсыз
Dialogue: 0,0:11:51.16,0:11:52.21,Default,,0,0,0,,Ух... уау~
Dialogue: 0,0:11:52.33,0:11:55.04,Default,,0,0,0,,Өтірік! Сіз де блоктай аласыз ба?
Dialogue: 0,0:11:55.33,0:11:56.17,Default,,0,0,0,,О!
Dialogue: 0,0:11:58.50,0:11:59.34,Default,,0,0,0,,Оның өтуіне жол бермеңіз!
Dialogue: 0,0:11:59.46,0:12:00.92,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:01.30,0:12:02.13,Default,,0,0,0,,Тек араласып жүрсің...
Dialogue: 0,0:12:02.26,0:12:04.68,Default,,0,0,0,,Қандай жағдай болмасын, ұстайсың!
Dialogue: 0,0:12:04.89,0:12:05.72,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:06.26,0:12:08.31,Default,,0,0,0,,Мен блоктаймын!
Dialogue: 0,0:12:09.64,0:12:11.31,Default,,0,0,0,,Уау! Бұл соқтығыс!
Dialogue: 0,0:12:11.43,0:12:12.27,Default,,0,0,0,,Құт
Dialogue: 0,0:12:16.56,0:12:18.69,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:19.28,0:12:20.11,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:21.94,0:12:24.32,Default,,0,0,0,,Мен білмей тұрып... Мен оны суырып алдым.
Dialogue: 0,0:12:24.99,0:12:26.07,Default,,0,0,0,,Білемін, білемін!
Dialogue: 0,0:12:26.32,0:12:28.91,Default,,0,0,0,,Жоқ, бұрынғыдан мүлдем басқаша.
Dialogue: 0,0:12:30.41,0:12:33.79,Default,,0,0,0,,Жылдамдықты төмендетпей тежегішті басыңыз
Dialogue: 0,0:12:35.33,0:12:37.04,Default,,0,0,0,,Иә! Міне осы!
Dialogue: 0,0:12:37.17,0:12:39.30,Default,,0,0,0,,Жылдамдықты төмендетпей тежегішті басыңыз!
Dialogue: 0,0:12:40.71,0:12:41.55,Default,,0,0,0,,Ой
Dialogue: 0,0:12:41.92,0:12:42.76,Default,,0,0,0,,Уау
Dialogue: 0,0:12:44.59,0:12:45.97,Default,,0,0,0,,Әлі жоқ!
Dialogue: 0,0:12:46.09,0:12:49.05,Default,,0,0,0,,Бұл жолы мен сені аяғыңа басып тастаймын!
Dialogue: 0,0:12:50.06,0:12:52.18,Default,,0,0,0,,Жақсы! Байқап көрейік!
Dialogue: 0,0:12:55.81,0:12:59.73,Default,,0,0,0,,Міне, келдім~!
Dialogue: 0,0:13:01.15,0:13:02.99,Default,,0,0,0,,Қадам ұзындығының кенет өзгеруі
Dialogue: 0,0:13:03.11,0:13:04.78,Default,,0,0,0,,Сізді бәсеңдетпейтін тежегіштер!
Dialogue: 0,0:13:10.91,0:13:13.16,Default,,0,0,0,,На~хахаха
Dialogue: 0,0:13:13.79,0:13:14.71,Default,,0,0,0,,А~?
Dialogue: 0,0:13:19.79,0:13:21.96,Default,,0,0,0,,Еееее~!
Dialogue: 0,0:13:26.26,0:13:28.97,Default,,0,0,0,,В... бұлыңғыр~
Dialogue: 0,0:13:36.64,0:13:37.73,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:13:43.40,0:13:45.69,Default,,0,0,0,,Қозғалыс!
Dialogue: 0,0:13:45.82,0:13:49.11,Default,,0,0,0,,Ойын аяқталды! B командасы жеңеді!
Dialogue: 0,0:13:50.03,0:13:52.20,Default,,0,0,0,,О... Иә!
Dialogue: 0,0:13:52.33,0:13:54.25,Default,,0,0,0,,Иә~ Мен жеңдім!
Dialogue: 0,0:13:56.04,0:13:57.58,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,0:13:57.71,0:13:59.96,Default,,0,0,0,,Мен шабуылда да, қорғаныста да өте белсендімін!
Dialogue: 0,0:14:00.63,0:14:02.13,Default,,0,0,0,,Ахаха
Dialogue: 0,0:14:02.25,0:14:03.13,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:14:03.25,0:14:08.93,Default,,0,0,0,,(Сенаның ауыр тыныс алуы)
Dialogue: 0,0:14:09.55,0:14:13.60,Default,,0,0,0,,Абай бол, ДжоДжо!
Dialogue: 0,0:14:15.31,0:14:16.77,Default,,0,0,0,,Әй, бітті.
Dialogue: 0,0:14:16.89,0:14:18.35,Default,,0,0,0,,Сен неге тұрсың?
Dialogue: 0,0:14:18.73,0:14:19.90,Default,,0,0,0,,Елес…
Dialogue: 0,0:14:21.65,0:14:23.65,Default,,0,0,0,,Елес пайда болды
Dialogue: 0,0:14:24.98,0:14:27.15,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:29.57,0:14:30.49,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:31.78,0:14:33.28,Default,,0,0,0,,Міне кеттік!
Dialogue: 0,0:14:33.41,0:14:35.33,Default,,0,0,0,,Неліктен біз үнемі бір-бірімізге соқтығысамыз...
Dialogue: 0,0:14:35.91,0:14:37.45,Default,,0,0,0,,Олар – Құдайдың үкімі еді.
Dialogue: 0,0:14:37.58,0:14:40.50,Default,,0,0,0,,Сіз Eyeshield 21 болдыңыз!
Dialogue: 0,0:14:41.29,0:14:43.59,Default,,0,0,0,,Е, а, жоқ~ бұл...
Dialogue: 0,0:14:43.71,0:14:46.63,Default,,0,0,0,,Эхехе Құпия болсын
Dialogue: 0,0:14:46.76,0:14:48.72,Default,,0,0,0,,A… Ахаха кешіріңіз
Dialogue: 0,0:14:49.01,0:14:51.68,Default,,0,0,0,,Ендеше... неге кешірім сұрайсың?
Dialogue: 0,0:14:52.18,0:14:53.85,Default,,0,0,0,,А... түсіндім.
Dialogue: 0,0:14:54.56,0:14:55.64,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:55.81,0:14:56.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:58.31,0:15:00.23,Default,,0,0,0,,Рахмет айтамын!
Dialogue: 0,0:15:01.27,0:15:04.11,Default,,0,0,0,,А... жоқ... иә?
Dialogue: 0,0:15:07.94,0:15:10.15,Default,,0,0,0,,Енді, Армадильостың қосылу сынағы.
Dialogue: 0,0:15:10.28,0:15:12.53,Default,,0,0,0,,Бірінші көрсетілімнен өткендерді хабарландыру
Dialogue: 0,0:15:15.66,0:15:17.54,Default,,0,0,0,,Энтони Ривз
Dialogue: 0,0:15:18.16,0:15:19.54,Default,,0,0,0,,Уау~хохо~!
Dialogue: 0,0:15:19.96,0:15:21.21,Default,,0,0,0,,Брайан Адамс
Dialogue: 0,0:15:21.33,0:15:22.42,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:22.88,0:15:24.92,Default,,0,0,0,,Хабарландырулар алфавиттік тәртіпте.
Dialogue: 0,0:15:25.04,0:15:26.21,Default,,0,0,0,,ұқсайды
Dialogue: 0,0:15:27.00,0:15:28.51,Default,,0,0,0,,Джимми Симар
Dialogue: 0,0:15:28.63,0:15:31.47,Default,,0,0,0,,Уау! Алақай!
Dialogue: 0,0:15:32.34,0:15:33.22,Default,,0,0,0,,Натан Смит
Dialogue: 0,0:15:33.34,0:15:35.10,Default,,0,0,0,,Ооо!
Dialogue: 0,0:15:35.80,0:15:39.81,Default,,0,0,0,,Өйткені Нацухико Такидің Нацухикосы... Келесі?
Dialogue: 0,0:15:41.85,0:15:42.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:42.81,0:15:43.65,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:44.86,0:15:48.82,Default,,0,0,0,,Енді мені кәсіпқой боламын деген фанфарға шақырды.
Dialogue: 0,0:15:49.15,0:15:49.99,Default,,0,0,0,,Фалько…
Dialogue: 0,0:15:51.20,0:15:52.70,Default,,0,0,0,,Оскар Уайлдер
Dialogue: 0,0:15:52.82,0:15:54.07,Default,,0,0,0,,Джо!
Dialogue: 0,0:15:55.53,0:15:57.99,Default,,0,0,0,,Аты өткізіп жіберілді ме? Сәтсіз қалды ма?
Dialogue: 0,0:15:58.12,0:15:59.79,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:15:59.91,0:16:02.33,Default,,0,0,0,,Ережені де білмедім, бірақ емтиханды тапсырдым.
Dialogue: 0,0:16:02.46,0:16:04.88,Default,,0,0,0,,А... Ариена!
Dialogue: 0,0:16:05.00,0:16:06.79,Default,,0,0,0,,Әй, мен тағы ашуландым.
Dialogue: 0,0:16:06.92,0:16:08.63,Default,,0,0,0,,Угья!
Dialogue: 0,0:16:09.46,0:16:11.72,Default,,0,0,0,,Нацухико... Таки-кун, солай ма?
Dialogue: 0,0:16:11.84,0:16:14.13,Default,,0,0,0,,Алиена... Иә?
Dialogue: 0,0:16:14.30,0:16:16.18,Default,,0,0,0,,Сіздің күшіңіз бен жылдамдығыңыз
Dialogue: 0,0:16:16.30,0:16:19.93,Default,,0,0,0,,Әлі де кәсіпқой ретінде пайдалануға болатын деңгейде емес
Dialogue: 0,0:16:20.77,0:16:22.89,Default,,0,0,0,,Бірақ сол икемді денемен
Dialogue: 0,0:16:23.10,0:16:25.85,Default,,0,0,0,,Жұмсақ қабылдауға арналған жұмсақ блок
Dialogue: 0,0:16:25.98,0:16:28.48,Default,,0,0,0,,Оның өте қызықты қасиеттері бар.
Dialogue: 0,0:16:28.61,0:16:30.69,Default,,0,0,0,,О... Қызықты қасиеттер?
Dialogue: 0,0:16:31.44,0:16:35.66,Default,,0,0,0,,Жапон орта мектебінде үш жыл бойы жақсы тәжірибе жинаңыз.
Dialogue: 0,0:16:35.99,0:16:38.62,Default,,0,0,0,,Сенің болашақта жақсы ойыншы болатыныңа сенімдімін
Dialogue: 0,0:16:39.08,0:16:43.12,Default,,0,0,0,,Сан-Антонио Армадильостары сіздің өсуіңізді күтуде.
Dialogue: 0,0:16:43.37,0:16:44.58,Default,,0,0,0,,Керемет... ғажап
Dialogue: 0,0:16:44.71,0:16:47.50,Default,,0,0,0,,Ағамды кәсіби режиссер мақтады.
Dialogue: 0,0:16:47.63,0:16:48.59,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:16:48.96,0:16:51.26,Default,,0,0,0,,Сізде талант бар жақсы!
Dialogue: 0,0:16:51.38,0:16:53.26,Default,,0,0,0,,Фу… фуфуфу…
Dialogue: 0,0:16:53.38,0:16:54.84,Default,,0,0,0,,О (Таки) Ахах
Dialogue: 0,0:16:54.97,0:16:56.64,Default,,0,0,0,,Жоқ, әрине.
Dialogue: 0,0:16:56.76,0:16:59.72,Default,,0,0,0,,Менің бірден жұмысқа қабылданатын қабілетім бар, бірақ жас шектеулерім бар.
Dialogue: 0,0:16:59.85,0:17:02.52,Default,,0,0,0,,Мен мектепті бітірген соң үйірмеге қатысуымды сұрап тұрсың ғой, солай ма?
Dialogue: 0,0:17:03.10,0:17:05.52,Default,,0,0,0,,Сәл... басқаша сияқты.
Dialogue: 0,0:17:05.64,0:17:08.61,Default,,0,0,0,,Жарайды... Қалай болғанда да, қазір біттіңіз.
Dialogue: 0,0:17:08.73,0:17:09.77,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:17:09.90,0:17:12.23,Default,,0,0,0,,Себебі анаң уайымдап жатыр.
Dialogue: 0,0:17:12.53,0:17:15.20,Default,,0,0,0,,Жарайды... жас шектеулері туралы ештеңе істей алмаймыз.
Dialogue: 0,0:17:15.61,0:17:19.58,Default,,0,0,0,,Менімен Жапонияға оралыңыз және келесі жылы қайтадан орта мектепке түсу емтиханын тапсырыңыз.
Dialogue: 0,0:17:19.70,0:17:20.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:20.66,0:17:22.62,Default,,0,0,0,,Сонымен, егер сізде тығыз болса ...
Dialogue: 0,0:17:22.75,0:17:24.33,Default,,0,0,0,,Мұнда жазылғандай
Dialogue: 0,0:17:24.46,0:17:26.29,Default,,0,0,0,,Осылайша сіз керемет стратегияларды ойлап таба аласыз!
Dialogue: 0,0:17:26.42,0:17:28.71,Default,,0,0,0,,Жолы бар блок
Dialogue: 0,0:17:28.83,0:17:30.96,Default,,0,0,0,,Сіз бәрін жасай алатын адам бола алмайсыз!
Dialogue: 0,0:17:31.80,0:17:34.26,Default,,0,0,0,,Мм, қарсы болмасаңыз.
Dialogue: 0,0:17:34.38,0:17:37.01,Default,,0,0,0,,Менің орта мектебімде менімен американдық футбол ойнағың келе ме?
Dialogue: 0,0:17:37.68,0:17:38.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:39.14,0:17:41.01,Default,,0,0,0,,Қалай... шынымен бе?
Dialogue: 0,0:17:41.76,0:17:45.02,Default,,0,0,0,,Бұл жақсы, бұл жақсы! Маған кіруге рұқсат етіңіз
Dialogue: 0,0:17:45.48,0:17:46.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:48.23,0:17:49.81,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:17:49.94,0:17:51.86,Default,,0,0,0,,Не айтып тұрсың, Сюзунэ?
Dialogue: 0,0:17:51.98,0:17:53.36,Default,,0,0,0,,Мен бір командада жүрген сияқтымын
Dialogue: 0,0:17:53.48,0:17:55.86,Default,,0,0,0,,Сіз жай ғана қосылғыңыз келетін сияқты.
Dialogue: 0,0:17:55.99,0:17:56.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:57.86,0:18:00.78,Default,,0,0,0,,Әйтеуір, мен сені барлығымен таныстырамын, ендеше кеттік.
Dialogue: 0,0:18:01.08,0:18:02.58,Default,,0,0,0,,Сонымен… келісім-шарт ақысы туралы не деуге болады?
Dialogue: 0,0:18:02.70,0:18:04.29,Default,,0,0,0,,Бұл мүмкін емес!
Dialogue: 0,0:18:04.62,0:18:06.00,Default,,0,0,0,,Сэмюэл О'Брайен
Dialogue: 0,0:18:06.12,0:18:07.41,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:08.25,0:18:09.58,Default,,0,0,0,,Сена Кобаякава
Dialogue: 0,0:18:14.88,0:18:16.22,Default,,0,0,0,,Сена Кобаякава
Dialogue: 0,0:18:16.34,0:18:18.80,Default,,0,0,0,,Жек көру? Сена-кун
Dialogue: 0,0:18:25.43,0:18:26.77,Default,,0,0,0,,Nk…
Dialogue: 0,0:18:26.89,0:18:27.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:28.77,0:18:31.19,Default,,0,0,0,,Сенна мені неге артымнан қуып жүр?
Dialogue: 0,0:18:31.77,0:18:33.90,Default,,0,0,0,,Жылдамдықты төмендетпейтін тежегіштер
Dialogue: 0,0:18:34.53,0:18:37.95,Default,,0,0,0,,Қадамыңды бәсеңдетпей, кенет өзгерт!
Dialogue: 0,0:18:41.62,0:18:42.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:47.58,0:18:50.42,Default,,0,0,0,,Бар... Елес!
Dialogue: 0,0:18:50.54,0:18:53.17,Default,,0,0,0,,Бұл кішкентай жігітте мен күткеннен де көп доп болуы мүмкін!
Dialogue: 0,0:18:53.54,0:18:56.59,Default,,0,0,0,,Хаа... Ажырасқанымыз үшін кешіріңіз.
Dialogue: 0,0:18:56.96,0:19:00.68,Default,,0,0,0,,Эй, Сена, келесі деңгей ертең басталады.
Dialogue: 0,0:19:00.84,0:19:03.01,Default,,0,0,0,,Қозғалтқыштарды ирек қимылмен соғу
Dialogue: 0,0:19:03.72,0:19:05.06,Default,,0,0,0,,Зигзаг?
Dialogue: 0,0:19:07.43,0:19:09.77,Default,,0,0,0,,Егер сіз оны Лас-Вегасқа жеткізсеңіз
Dialogue: 0,0:19:09.89,0:19:12.06,Default,,0,0,0,,Шайтанның жүгіруі аяқталды
Dialogue: 0,0:19:12.27,0:19:14.02,Default,,0,0,0,,А... шайтан ба?
Dialogue: 0,0:19:14.36,0:19:16.48,Default,,0,0,0,,Дұрыс айтасың...
Dialogue: 0,0:19:16.69,0:19:18.61,Default,,0,0,0,,«Ібіліс жарғанатының елесі»!
Dialogue: 0,0:19:18.74,0:19:20.95,Default,,0,0,0,,
Dialogue: 0,0:19:22.78,0:19:24.99,Default,,0,0,0,,Ібіліс жарғанат елесі?
Dialogue: 0,0:19:25.16,0:19:31.17,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:20:33.23,0:20:39.23,Default,,0,0,0,,~♪
Dialogue: 0,0:20:40.48,0:20:42.36,Default,,0,0,0,,А, а, а~
Dialogue: 0,0:20:42.49,0:20:43.90,Default,,0,0,0,,Ақырында, ол аяқталды!
Dialogue: 0,0:20:44.03,0:20:46.20,Default,,0,0,0,,Юкимицу құлап қалды.
Dialogue: 0,0:20:46.57,0:20:49.12,Default,,0,0,0,,Мен де Мен
Dialogue: 0,0:20:49.24,0:20:51.58,Default,,0,0,0,,Мақсатқа барлығымен бірге жет!
Dialogue: 0,0:20:51.95,0:20:54.16,Default,,0,0,0,,Өзіңді көрсет, қарғыс атқыр Деко!
Dialogue: 0,0:20:54.29,0:20:56.38,Default,,0,0,0,,Келесі жолы «Көз қалқаны 21»
Dialogue: 0,0:20:58.25,0:20:59.84,Default,,0,0,0,,Я-! Ха-!
Dialogue: 0,0:21:01.34,0:21:07.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory