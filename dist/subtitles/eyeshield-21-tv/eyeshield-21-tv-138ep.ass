Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.67,0:00:07.54,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:11.05,0:00:14.38,Default,,0,0,0,,Біз патша сарайында міндетті түрде жеңеміз!
Dialogue: 0,0:00:18.72,0:00:20.43,Default,,0,0,0,,Бариста!
Dialogue: 0,0:00:22.18,0:00:23.60,Default,,0,0,0,,Не... Бұл не!
Dialogue: 0,0:00:23.69,0:00:26.40,Default,,0,0,0,,Басталу сәтінен бастап Баллистаның қалыптасуы!
Dialogue: 0,0:00:26.48,0:00:27.69,Default,,0,0,0,,Сусуму келмейді!
Dialogue: 0,0:00:27.77,0:00:29.69,Default,,0,0,0,,Отавара-кун мен Икари-кун да!
Dialogue: 0,0:00:29.77,0:00:32.15,Default,,0,0,0,,Сәлем! Сақ болыңыз!
Dialogue: 0,0:00:32.40,0:00:35.03,Default,,0,0,0,,Мен оны тоқтатамын!
Dialogue: 0,0:00:35.32,0:00:36.87,Default,,0,0,0,,Гррррр
Dialogue: 0,0:00:36.95,0:00:40.41,Default,,0,0,0,,Гахахаха! Мен жеңілмеймін, Курита!
Dialogue: 0,0:00:40.49,0:00:43.20,Default,,0,0,0,,Мен де! Фуннураба!
Dialogue: 0,0:00:43.29,0:00:46.17,Default,,0,0,0,,Ораора Ораора! Жолды босат!
Dialogue: 0,0:00:46.25,0:00:48.46,Default,,0,0,0,,Осы жерден жабылайық!
Dialogue: 0,0:00:48.54,0:00:50.17,Default,,0,0,0,,Ораора Ораора!
Dialogue: 0,0:00:52.88,0:00:54.51,Default,,0,0,0,,Фуго қашпайды
Dialogue: 0,0:00:54.59,0:00:55.63,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:00:55.72,0:00:57.72,Default,,0,0,0,,Егер сіз Шингоны бірден басып алсаңыз!
Dialogue: 0,0:00:58.85,0:00:59.68,Default,,0,0,0,,Хмм
Dialogue: 0,0:00:59.76,0:01:01.39,Default,,0,0,0,,Хмф! (Тоноха) Уау
Dialogue: 0,0:01:01.47,0:01:02.52,Default,,0,0,0,,Хунгу
Dialogue: 0,0:01:02.60,0:01:03.56,Default,,0,0,0,,Мүлдем емес...
Dialogue: 0,0:01:03.64,0:01:05.10,Default,,0,0,0,,Мен өте алмаймын...
Dialogue: 0,0:01:05.94,0:01:09.11,Default,,0,0,0,,Жеңілмейтін Сусуму жетекші блокпен жүгіреді!
Dialogue: 0,0:01:09.81,0:01:14.03,Default,,0,0,0,,Біз өз территориямыздың тереңінен бірден Деймонның тамағына жақындаймыз!
Dialogue: 0,0:01:14.44,0:01:17.32,Default,,0,0,0,,Сен мені осылай жібересің бе, Оджо!
Dialogue: 0,0:01:17.41,0:01:18.24,Default,,0,0,0,,Ах
Dialogue: 0,0:01:18.32,0:01:21.12,Default,,0,0,0,,Бүйірден көз қалқан ойыншысы!
Dialogue: 0,0:01:21.20,0:01:23.29,Default,,0,0,0,,Міне!
Dialogue: 0,0:01:23.37,0:01:25.25,Default,,0,0,0,,Көз қалқанын бұзыңыз!
Dialogue: 0,0:01:26.12,0:01:27.33,Default,,0,0,0,,Ммм
Dialogue: 0,0:01:27.87,0:01:29.75,Default,,0,0,0,,Дааааааааааааааааааааааааааааа
Dialogue: 0,0:01:29.83,0:01:32.25,Default,,0,0,0,,Мен сені ешқашан жібермеймін!
Dialogue: 0,0:01:36.47,0:01:38.68,Default,,0,0,0,,Түсінікті. Шынында да, мен осы жұқа тақтайға қатты қызығамын, бірақ
Dialogue: 0,0:01:38.76,0:01:40.39,Default,,0,0,0,,Ой…
Dialogue: 0,0:01:42.76,0:01:43.72,Default,,0,0,0,,Сенна!
Dialogue: 0,0:01:43.81,0:01:45.39,Default,,0,0,0,,Жарайды, мен оны тоқтаттым!
Dialogue: 0,0:01:45.48,0:01:47.64,Default,,0,0,0,,Сәлем! Тамаша жекпе-жек
Dialogue: 0,0:01:48.23,0:01:50.31,Default,,0,0,0,,Eyeshield-kun, Dodge Vatanabe-kun⸺
Dialogue: 0,0:01:50.40,0:01:52.73,Default,,0,0,0,,Дәл солай мен Некоама-кунды басып қалдым!
Dialogue: 0,0:01:52.82,0:01:54.61,Default,,0,0,0,,Рухқа толы спектакль!
Dialogue: 0,0:01:54.69,0:01:56.49,Default,,0,0,0,,Сен істедің, Сена!
Dialogue: 0,0:01:56.57,0:01:58.28,Default,,0,0,0,,Фугоның толық жаңғыруы
Dialogue: 0,0:01:58.36,0:02:00.07,Default,,0,0,0,,Мен сені күттім, Сена!
Dialogue: 0,0:02:01.16,0:02:03.41,Default,,0,0,0,,Бұл... Жақсысың ба?
Dialogue: 0,0:02:03.49,0:02:05.58,Default,,0,0,0,,А... жақсы жекпе-жек
Dialogue: 0,0:02:05.66,0:02:06.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:06.83,0:02:08.12,Default,,0,0,0,,Сена~!
Dialogue: 0,0:02:08.21,0:02:09.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:09.12,0:02:11.00,Default,,0,0,0,,Таңбалардың қайта тірілуі!
Dialogue: 0,0:02:11.08,0:02:13.00,Default,,0,0,0,,Бұл ғажап Уау... Уау!
Dialogue: 0,0:02:13.09,0:02:15.00,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:02:15.09,0:02:16.26,Default,,0,0,0,,Оған жоғары баға қояды!
Dialogue: 0,0:02:16.34,0:02:18.01,Default,,0,0,0,,Салқын болуға тырыспаңыз!
Dialogue: 0,0:02:18.09,0:02:20.01,Default,,0,0,0,,Сен оны ұрдың, Сена.
Dialogue: 0,0:02:20.09,0:02:20.93,Default,,0,0,0,,Хаха
Dialogue: 0,0:02:21.01,0:02:23.93,Default,,0,0,0,,Сенна! Сенна! Сенна!
Dialogue: 0,0:02:24.01,0:02:28.89,Default,,0,0,0,,Ой! Трибунадан қайта жаңғырған Сенаға үлкен қуаныш!
Dialogue: 0,0:02:28.98,0:02:32.81,Default,,0,0,0,,Сенна! Сенна! Сенна!
Dialogue: 0,0:02:32.90,0:02:33.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:33.94,0:02:34.65,Default,,0,0,0,,А, сәлем, сәлем, сәлем, сәлем...
Dialogue: 0,0:02:34.65,0:02:36.65,Default,,0,0,0,,А, сәлем, сәлем, сәлем, сәлем...
Dialogue: 0,0:02:34.65,0:02:36.65,Default,,0,0,0,,шықты! Пекопеко еш себепсіз
Dialogue: 0,0:02:36.73,0:02:38.82,Default,,0,0,0,,Шынында да, бұл әлі де солай...
Dialogue: 0,0:02:36.73,0:02:38.82,Default,,0,0,0,,Сәлем, сәлем, сәлем...
Dialogue: 0,0:02:39.40,0:02:41.70,Default,,0,0,0,,Сусуму дұрыс айтты.
Dialogue: 0,0:02:41.78,0:02:42.78,Default,,0,0,0,,Иә
Dialogue: 0,0:02:43.41,0:02:46.87,Default,,0,0,0,,Айсшилд 21 өлген жоқ.
Dialogue: 0,0:02:46.95,0:02:49.29,Default,,0,0,0,,Сақтықты бір сәтке де түсірмеңіз
Dialogue: 0,0:02:49.37,0:02:50.62,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:51.37,0:02:52.96,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:02:53.04,0:02:57.96,Default,,0,0,0,,♪~
Dialogue: 0,0:04:12.54,0:04:17.88,Default,,0,0,0,,~♪
Dialogue: 0,0:04:24.68,0:04:28.01,Default,,0,0,0,,Енді Оджу шабуылда 7 ұпаймен алға шықты.
Dialogue: 0,0:04:29.18,0:04:31.60,Default,,0,0,0,,Бариста тағы да позиция!
Dialogue: 0,0:04:37.19,0:04:40.53,Default,,0,0,0,,Сусуму-санды жеңудің бір ғана жолы бар.
Dialogue: 0,0:04:41.82,0:04:42.94,Default,,0,0,0,,Не!?
Dialogue: 0,0:04:43.03,0:04:44.95,Default,,0,0,0,,Күшті Сусуму?
Dialogue: 0,0:04:45.03,0:04:46.49,Default,,0,0,0,,Сіз оны ұшырып жібересіз бе?
Dialogue: 0,0:04:47.16,0:04:48.20,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:48.95,0:04:53.83,Default,,0,0,0,,Susumu-ның стендтік прессі... 140 кг!
Dialogue: 0,0:04:53.91,0:04:57.83,Default,,0,0,0,,Ә!? Сеннаның стендтік прессі 40 кг.
Dialogue: 0,0:04:58.58,0:05:00.80,Default,,0,0,0,,Айырмашылық 100 км...
Dialogue: 0,0:05:00.88,0:05:04.72,Default,,0,0,0,,Ах, де, де... Бірақ бір-бірін итеру бұлшық ет күшіне ғана қатысты емес.
Dialogue: 0,0:05:04.80,0:05:06.30,Default,,0,0,0,,Салмақ та маңызды!
Dialogue: 0,0:05:06.38,0:05:09.22,Default,,0,0,0,,Сусуму өте бұлшықетті.
Dialogue: 0,0:05:09.30,0:05:11.76,Default,,0,0,0,,Ол жұқа, сондықтан ауыр емес.
Dialogue: 0,0:05:11.85,0:05:13.60,Default,,0,0,0,,71 км…
Dialogue: 0,0:05:13.68,0:05:16.44,Default,,0,0,0,,Сеннаның салмағы 48 кг...
Dialogue: 0,0:05:16.52,0:05:19.44,Default,,0,0,0,,Айырмашылық 23 км.
Dialogue: 0,0:05:19.98,0:05:21.27,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:21.36,0:05:23.99,Default,,0,0,0,,Күш сайысы деп айтып отырғаным жекпе-жектен бөлек.
Dialogue: 0,0:05:24.07,0:05:24.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:24.99,0:05:28.91,Default,,0,0,0,,Өз күшін жинап, Сусуму тридентпен күресуді іске қосады.
Dialogue: 0,0:05:28.99,0:05:30.87,Default,,0,0,0,,Өте жеделдету алдында
Dialogue: 0,0:05:31.87,0:05:35.33,Default,,0,0,0,,Керісінше, мен сенің одан да жылдамырақ болғаныңды қалаймын.
Dialogue: 0,0:05:35.96,0:05:37.42,Default,,0,0,0,,Сіз түсінбейсіз.
Dialogue: 0,0:05:38.46,0:05:39.63,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:41.17,0:05:42.42,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:42.50,0:05:44.42,Default,,0,0,0,,Орнату! қалпақ!
Dialogue: 0,0:05:45.72,0:05:46.97,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:05:47.80,0:05:51.43,Default,,0,0,0,,Доп Сусумуның жетекші блогы Некоамаға барады!
Dialogue: 0,0:05:51.51,0:05:53.60,Default,,0,0,0,,Жоғалтпа!
Dialogue: 0,0:05:53.68,0:05:55.81,Default,,0,0,0,,Фуннураба!
Dialogue: 0,0:05:55.89,0:05:58.19,Default,,0,0,0,,Жүр! Қарғыс атсын саған кішкентай жігіт!
Dialogue: 0,0:05:58.27,0:05:59.40,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:02.15,0:06:04.53,Default,,0,0,0,,Енді Eyeshield зарядталып жатыр!
Dialogue: 0,0:06:05.32,0:06:08.99,Default,,0,0,0,,Кел! Сондықтан мен оны ең мықты қарсылас деп санаймын.
Dialogue: 0,0:06:09.91,0:06:12.62,Default,,0,0,0,,Маған Рику мен Сусуму сияқты
Dialogue: 0,0:06:12.70,0:06:16.04,Default,,0,0,0,,Rodeo Drive-та жылдам үдеу сияқты техника жоқ.
Dialogue: 0,0:06:16.12,0:06:16.95,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:06:19.00,0:06:21.13,Default,,0,0,0,,Аяғыңызды сақтаңыз...
Dialogue: 0,0:06:21.63,0:06:22.88,Default,,0,0,0,,әріптес сарбаздардың жүрегіне үрей ұялататындай болды
Dialogue: 0,0:06:22.96,0:06:25.38,Default,,0,0,0,,Сақтау... Сақтау...
Dialogue: 0,0:06:26.05,0:06:27.55,Default,,0,0,0,,Барлығы бірден!
Dialogue: 0,0:06:29.84,0:06:32.47,Default,,0,0,0,,Не!? Бұл жеделдету...
Dialogue: 0,0:06:33.18,0:06:36.43,Default,,0,0,0,,Сусумумен билік үшін шайқас!?
Dialogue: 0,0:06:36.52,0:06:38.89,Default,,0,0,0,,Нахаха! Есіңіз дұрыс па?
Dialogue: 0,0:06:38.98,0:06:40.90,Default,,0,0,0,,Жеңіске жету мүмкін емес
Dialogue: 0,0:06:46.23,0:06:49.40,Default,,0,0,0,,Мен Сусумуға қарсы күш шайқаста жеңемін!
Dialogue: 0,0:06:50.11,0:06:52.37,Default,,0,0,0,,Осы уақытқа дейін үйренгенімнің бәрі...
Dialogue: 0,0:06:52.95,0:06:55.33,Default,,0,0,0,,Бәрін маған лақтыр!
Dialogue: 0,0:06:58.45,0:06:59.50,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:59.58,0:07:03.42,Default,,0,0,0,,Ууууууууууу
Dialogue: 0,0:07:03.50,0:07:07.00,Default,,0,0,0,,Super жеделдетеді және 4 секундта жарық жылдамдығымен қалады 2...
Dialogue: 0,0:07:07.09,0:07:07.92,Default,,0,0,0,,Тоқ!
Dialogue: 0,0:07:08.01,0:07:11.22,Default,,0,0,0,,Ууууууууууу
Dialogue: 0,0:07:12.43,0:07:13.30,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:17.14,0:07:18.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:18.89,0:07:21.77,Default,,0,0,0,,Ууууууууууу
Dialogue: 0,0:07:21.85,0:07:23.44,Default,,0,0,0,,Охххх
Dialogue: 0,0:07:23.52,0:07:26.73,Default,,0,0,0,,Гуаааааааааааааааааааааааааааааааааааааааа...
Dialogue: 0,0:07:26.82,0:07:27.94,Default,,0,0,0,,Сенна!
Dialogue: 0,0:07:28.03,0:07:29.69,Default,,0,0,0,,Сәлем! Ұшты!
Dialogue: 0,0:07:33.87,0:07:34.87,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:34.95,0:07:35.95,Default,,0,0,0,,О, иә (Некояма) О
Dialogue: 0,0:07:36.03,0:07:37.87,Default,,0,0,0,,
Dialogue: 0,0:07:37.95,0:07:39.33,Default,,0,0,0,,Төбе жын!
Dialogue: 0,0:07:39.41,0:07:41.87,Default,,0,0,0,,Сәлем! Сен оны тоқтаттың!
Dialogue: 0,0:07:41.96,0:07:43.46,Default,,0,0,0,,Керемет!
Dialogue: 0,0:07:43.54,0:07:44.88,Default,,0,0,0,,Қабақ қалқаны!
Dialogue: 0,0:07:46.13,0:07:47.84,Default,,0,0,0,,Төбе жын... Ах.
Dialogue: 0,0:07:48.63,0:07:51.30,Default,,0,0,0,,Жарайсың, ақымақ.
Dialogue: 0,0:07:51.88,0:07:52.97,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:54.26,0:07:55.80,Default,,0,0,0,,Бірақ сүлгі жын мені тоқтатты⸺
Dialogue: 0,0:07:55.89,0:07:59.14,Default,,0,0,0,,Оджо Уайт Рыцарлары бірінші жеңіске жетті!
Dialogue: 0,0:07:59.22,0:08:02.02,Default,,0,0,0,,Гахахахаха! Ол қандай нәрсе?
Dialogue: 0,0:08:02.10,0:08:04.48,Default,,0,0,0,,О! Сусуму-сенпай күткендей!
Dialogue: 0,0:08:04.56,0:08:06.69,Default,,0,0,0,,Үлкен шабуыл
Dialogue: 0,0:08:06.77,0:08:09.98,Default,,0,0,0,,Король сарайы енді жеңілмейтін бекініс емес.
Dialogue: 0,0:08:10.65,0:08:13.61,Default,,0,0,0,,Ешкім тоқтата алмайтын шабуыл күшімен жабдықталған⸺
Dialogue: 0,0:08:13.70,0:08:15.95,Default,,0,0,0,,Олар да Musou Knights мүшелері!
Dialogue: 0,0:08:16.62,0:08:19.29,Default,,0,0,0,,Я... жақсы блок Сусуму
Dialogue: 0,0:08:19.99,0:08:22.87,Default,,0,0,0,,Ах... Сусуму
Dialogue: 0,0:08:27.71,0:08:32.47,Default,,0,0,0,,Мен сабырлы Сусумуның осындай жауынгерлік рух танытып жатқанына сене алар емеспін...
Dialogue: 0,0:08:33.05,0:08:34.30,Default,,0,0,0,,Ол да⸺
Dialogue: 0,0:08:34.38,0:08:37.93,Default,,0,0,0,,Күшті жаумен бетпе-бет келіп, билігі жарылған адам.
Dialogue: 0,0:08:38.68,0:08:42.89,Default,,0,0,0,,Иә, дәл сол Айсшилд 21 сияқты.
Dialogue: 0,0:08:42.98,0:08:46.02,Default,,0,0,0,,Хахаха... Анау екеуі қызық екен.
Dialogue: 0,0:08:46.10,0:08:49.90,Default,,0,0,0,,Біз бір-бірімізді көтеріп, мәңгілікке күшейеміз.
Dialogue: 0,0:08:50.65,0:08:53.36,Default,,0,0,0,,Bump Susumu-да да жұмыс істемейді.
Dialogue: 0,0:08:54.65,0:08:56.82,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:08:58.57,0:09:00.41,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:09:02.16,0:09:04.41,Default,,0,0,0,,Қуатты жинақтау арқылы супер үдеу
Dialogue: 0,0:09:04.50,0:09:07.75,Default,,0,0,0,,Бұл тиімді, бірақ аяқтарыңызға көп салмақ түсіреді...
Dialogue: 0,0:09:08.38,0:09:10.88,Default,,0,0,0,,Бірақ қазір...
Dialogue: 0,0:09:14.76,0:09:16.09,Default,,0,0,0,,Сусуму-сан
Dialogue: 0,0:09:17.13,0:09:19.43,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:09:19.89,0:09:22.68,Default,,0,0,0,,С... Сена-кун, сен не істейсің?
Dialogue: 0,0:09:22.77,0:09:24.98,Default,,0,0,0,,Bump да жұмыс істемейді Фуго...
Dialogue: 0,0:09:25.06,0:09:25.89,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:26.77,0:09:28.85,Default,,0,0,0,,Содан кейін...
Dialogue: 0,0:09:29.56,0:09:31.82,Default,,0,0,0,,Содан кейін не болады?
Dialogue: 0,0:09:34.19,0:09:36.15,Default,,0,0,0,,Содан кейін...
Dialogue: 0,0:09:36.24,0:09:38.11,Default,,0,0,0,,Екі рет екі рет айттым...
Dialogue: 0,0:09:38.20,0:09:41.08,Default,,0,0,0,,Маған шынын айт, ештеңені ойлама.
Dialogue: 0,0:09:41.16,0:09:42.79,Default,,0,0,0,,Жоқ, бірақ бәрібір...
Dialogue: 0,0:09:42.87,0:09:45.91,Default,,0,0,0,,А, мен мұны бәрібір істеуім керек.
Dialogue: 0,0:09:46.00,0:09:48.08,Default,,0,0,0,,Біз де саған бәрін лақтырып жібереміз.
Dialogue: 0,0:09:48.17,0:09:50.54,Default,,0,0,0,,Құқық бұзушыларды өлтіру үшін кез келген әдісті қолданыңыз.
Dialogue: 0,0:09:50.63,0:09:54.38,Default,,0,0,0,,Мінсіз ойыншы Сусуму Сейжуроға күшпен
Dialogue: 0,0:09:54.46,0:09:57.51,Default,,0,0,0,,Мен сені бір секундқа да тоқтатамын!
Dialogue: 0,0:09:58.09,0:09:59.22,Default,,0,0,0,,Иә
Dialogue: 0,0:09:59.30,0:10:00.80,Default,,0,0,0,,Иә
Dialogue: 0,0:10:01.60,0:10:05.43,Default,,0,0,0,,Аха~ха~ Барлығы керемет емес пе?
Dialogue: 0,0:10:05.52,0:10:07.06,Default,,0,0,0,,Сонда бұл қызметші де
Dialogue: 0,0:10:07.14,0:10:12.57,Default,,0,0,0,,Эй, мен сенің жүзіңді Бандо шайқасында аздаған рөлді ойнағаннан бері көрдім.
Dialogue: 0,0:10:13.27,0:10:17.86,Default,,0,0,0,,Мен Синджуро Сейді айналдыру үшін кез келген нәрсені қолданамын, тіпті бұл мысықтың айласы болса да.
Dialogue: 0,0:10:17.95,0:10:18.90,Default,,0,0,0,,Бұл сумо емес!
Dialogue: 0,0:10:18.99,0:10:20.53,Default,,0,0,0,,Киёши: Бұл Синджуро емес! (Таки) Оны жіберіп алмаңыз!
Dialogue: 0,0:10:21.70,0:10:22.74,Default,,0,0,0,,Ақымақ аға...
Dialogue: 0,0:10:22.83,0:10:23.99,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:10:24.62,0:10:28.46,Default,,0,0,0,,Бірақ бұл жаман көңіл-күй емес, менің сезімім берілмейді.
Dialogue: 0,0:10:30.08,0:10:33.92,Default,,0,0,0,,Қалай болғанда да, мен Сусуму-санды қазір тоқтату үшін бар күшімді салуым керек!
Dialogue: 0,0:10:34.00,0:10:36.21,Default,,0,0,0,,Енді, Оджо, қонуға дейін⸺
Dialogue: 0,0:10:36.30,0:10:37.92,Default,,0,0,0,,25 ярд қалды!
Dialogue: 0,0:10:38.01,0:10:40.84,Default,,0,0,0,,Осы жерден шешсеңіз, сізде 14 ұпай басым болады.
Dialogue: 0,0:10:40.93,0:10:43.39,Default,,0,0,0,,Бұл екі жанасудың арасындағы айырмашылық!
Dialogue: 0,0:10:43.47,0:10:44.81,Default,,0,0,0,,Деймон үшін, яғни⸺
Dialogue: 0,0:10:44.89,0:10:48.85,Default,,0,0,0,,Ұпай айырмашылығы сізді тозақтың шетіне апарады деп айтуға болады.
Dialogue: 0,0:10:48.93,0:10:50.81,Default,,0,0,0,,Орнату! қалпақ!
Dialogue: 0,0:10:52.73,0:10:54.69,Default,,0,0,0,,Сусуму-кун осында!
Dialogue: 0,0:10:54.77,0:10:57.15,Default,,0,0,0,,Жарайды, аяғыңызды сақтаңыз...
Dialogue: 0,0:10:59.53,0:11:00.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:01.36,0:11:04.08,Default,,0,0,0,,Менің аяғым... қозғалмайды.
Dialogue: 0,0:11:04.16,0:11:05.95,Default,,0,0,0,,Аххххх
Dialogue: 0,0:11:06.04,0:11:07.54,Default,,0,0,0,,Сенна!
Dialogue: 0,0:11:07.62,0:11:11.00,Default,,0,0,0,,Ммм... Кууууууу...
Dialogue: 0,0:11:11.62,0:11:13.50,Default,,0,0,0,,Енді өту уақыты келді!
Dialogue: 0,0:11:13.58,0:11:14.59,Default,,0,0,0,,Құт
Dialogue: 0,0:11:14.67,0:11:16.21,Default,,0,0,0,,Енді бұл – қабілетке қарсы қабілет, техникаға қарсы техника, рухқа қарсы рух!
Dialogue: 0,0:11:16.30,0:11:17.55,Default,,0,0,0,,Сәтті өту!
Dialogue: 0,0:11:17.63,0:11:21.13,Default,,0,0,0,,Боқ... Аяғыңның ұзындығына тең жалпы қадам...
Dialogue: 0,0:11:21.22,0:11:23.51,Default,,0,0,0,,Жоқ, мен оған жарты қадам да жете алмаймын!
Dialogue: 0,0:11:23.59,0:11:25.35,Default,,0,0,0,,Жасайық
Dialogue: 0,0:11:25.43,0:11:27.01,Default,,0,0,0,,Ojo First Down!
Dialogue: 0,0:11:27.10,0:11:30.52,Default,,0,0,0,,Сәлем! Сенар!
Dialogue: 0,0:11:31.19,0:11:32.48,Default,,0,0,0,,Құт ах
Dialogue: 0,0:11:32.56,0:11:34.98,Default,,0,0,0,,Уақыт бітті!
Dialogue: 0,0:11:42.41,0:11:45.62,Default,,0,0,0,,Менің аяғымда күш жоқ...
Dialogue: 0,0:11:45.70,0:11:48.45,Default,,0,0,0,,Аяғыңыз ауырды ма?
Dialogue: 0,0:11:48.54,0:11:50.45,Default,,0,0,0,,Осы лайдың нашар жағдайында
Dialogue: 0,0:11:50.54,0:11:53.25,Default,,0,0,0,,Бірінші жартысынан бастап, бұл шайтан жарғанаттарының елестері.
Dialogue: 0,0:11:53.33,0:11:56.38,Default,,0,0,0,,Ақылға қонымсыз, қисынсыз емес.
Dialogue: 0,0:11:56.46,0:12:00.13,Default,,0,0,0,,Бұл менің аяғыма айтарлықтай салмақ түсіріп жатыр.
Dialogue: 0,0:12:01.42,0:12:03.30,Default,,0,0,0,,Осы қарқынмен мен уақытымды үнемдеймін⸺
Dialogue: 0,0:12:03.38,0:12:06.05,Default,,0,0,0,,Сіз қатты жылдамдықпен жүре алмайсыз.
Dialogue: 0,0:12:06.14,0:12:09.01,Default,,0,0,0,,Жарайды! Мен әлі де істей аламын!
Dialogue: 0,0:12:09.60,0:12:11.31,Default,,0,0,0,,Жоқ, мәжбүрлемеңіз.
Dialogue: 0,0:12:11.39,0:12:13.27,Default,,0,0,0,,Маған орындауға рұқсат етіңіз!
Dialogue: 0,0:12:13.35,0:12:15.19,Default,,0,0,0,,Сенна…
Dialogue: 0,0:12:15.86,0:12:17.36,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:17.44,0:12:19.40,Default,,0,0,0,,Төбе шайтан!
Dialogue: 0,0:12:19.48,0:12:21.07,Default,,0,0,0,,Тариме!
Dialogue: 0,0:12:21.15,0:12:23.40,Default,,0,0,0,,Мен сізге бас тартуға рұқсат бере алмаймын.
Dialogue: 0,0:12:23.49,0:12:24.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:24.86,0:12:25.74,Default,,0,0,0,,Ең үздік батыр болу үшін
Dialogue: 0,0:12:25.82,0:12:26.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:28.49,0:12:29.83,Default,,0,0,0,,Жүгірмеңіз
Dialogue: 0,0:12:30.45,0:12:31.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:31.66,0:12:33.66,Default,,0,0,0,,Сіз не айттыңыз!?
Dialogue: 0,0:12:33.75,0:12:35.88,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:12:35.96,0:12:37.00,Default,,0,0,0,,Фуго
Dialogue: 0,0:12:37.08,0:12:38.96,Default,,0,0,0,,Жүгірме...
Dialogue: 0,0:12:39.04,0:12:40.96,Default,,0,0,0,,Жай ғана жүгіру позасы жеткілікті
Dialogue: 0,0:12:41.05,0:12:44.13,Default,,0,0,0,,Көп қозғалма, аяғыңды демалдыр.
Dialogue: 0,0:12:44.22,0:12:45.97,Default,,0,0,0,,Бірақ содан кейін ...
Dialogue: 0,0:12:46.05,0:12:48.93,Default,,0,0,0,,Бұл жұмысты маған қалдырыңыз.
Dialogue: 0,0:12:49.89,0:12:51.43,Default,,0,0,0,,Мұсаши мырза...
Dialogue: 0,0:12:52.18,0:12:54.56,Default,,0,0,0,,Мен сен сияқты жылдам емеспін, бірақ⸺
Dialogue: 0,0:12:55.10,0:12:59.52,Default,,0,0,0,,Менде ағаш ұстасы арқылы жаттықтырған осы күш пен күш бар.
Dialogue: 0,0:12:59.61,0:13:00.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:01.69,0:13:03.78,Default,,0,0,0,,Қазір сіз жасай алатын ең жақсы нәрсе
Dialogue: 0,0:13:04.36,0:13:08.24,Default,,0,0,0,,Прогрессіңізді бақылауда ұстай отырып, аяқтарыңызды демалыңыз.
Dialogue: 0,0:13:08.32,0:13:09.62,Default,,0,0,0,,Ах
Dialogue: 0,0:13:10.41,0:13:14.12,Default,,0,0,0,,Ке! Екінші таймға 10 минут қалды дедім.
Dialogue: 0,0:13:14.21,0:13:16.29,Default,,0,0,0,,Тағы 8 минут ұстасаңыз, солай⸺
Dialogue: 0,0:13:16.37,0:13:19.75,Default,,0,0,0,,Сіз нақты жолмен жүгіре аласыз
Dialogue: 0,0:13:25.76,0:13:27.80,Default,,0,0,0,,Амансың ба, Сена...
Dialogue: 0,0:13:27.89,0:13:29.18,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:13:29.76,0:13:30.80,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:32.26,0:13:36.02,Default,,0,0,0,,Көз қалқанының аяқтары шегінде болуы керек...
Dialogue: 0,0:13:36.10,0:13:37.65,Default,,0,0,0,,Сіз әлі де жүгіре аласыз ба?
Dialogue: 0,0:13:40.40,0:13:41.57,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:42.53,0:13:44.40,Default,,0,0,0,,Орнату! қалпақ!
Dialogue: 0,0:13:44.90,0:13:45.74,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:13:45.82,0:13:49.28,Default,,0,0,0,,Ой, бұл Мусашидің блиці!
Dialogue: 0,0:13:50.12,0:13:52.24,Default,,0,0,0,,О! Мені жіберме!
Dialogue: 0,0:13:52.33,0:13:53.62,Default,,0,0,0,,Ол өмір энергиясына толы—
Dialogue: 0,0:13:53.70,0:13:54.95,Default,,0,0,0,,Он үшінші өлім!
Dialogue: 0,0:13:55.54,0:13:58.46,Default,,0,0,0,,Хмм... (Игари) Уаааа
Dialogue: 0,0:13:58.54,0:14:01.25,Default,,0,0,0,,Хмм... (Игари) Уаааа
Dialogue: 0,0:14:01.34,0:14:03.13,Default,,0,0,0,,Ноаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа аңшылыққа шыққан жоқ.
Dialogue: 0,0:14:03.21,0:14:06.88,Default,,0,0,0,,Мусаши-кун өз күшімен патша сарайының қорғанысын жойды!
Dialogue: 0,0:14:07.63,0:14:08.84,Default,,0,0,0,,Уф
Dialogue: 0,0:14:09.51,0:14:10.51,Default,,0,0,0,,Таками лақтыра алмайды, сәтсіздікке ұшырады!
Dialogue: 0,0:14:10.51,0:14:12.85,Default,,0,0,0,,Таками-кун лақтыра алмайды, сәтсіздікке ұшырады!
Dialogue: 0,0:14:10.51,0:14:12.85,Default,,0,0,0,,
Dialogue: 0,0:14:12.93,0:14:17.43,Default,,0,0,0,,Сәлем! Мұсашан – төтенше жағдайда арқа сүйейтін адам!
Dialogue: 0,0:14:17.52,0:14:20.02,Default,,0,0,0,,Мұсаши 100 км жерге пресс!
Dialogue: 0,0:14:20.10,0:14:22.31,Default,,0,0,0,,Деймонда мен Курита-куннан кейінгі екінші орындамын.
Dialogue: 0,0:14:23.73,0:14:26.99,Default,,0,0,0,,Енді осыдан артық емес пе, қарғыс атқыр қария?
Dialogue: 0,0:14:27.07,0:14:28.20,Default,,0,0,0,,Бұл шынымен де…
Dialogue: 0,0:14:28.28,0:14:30.24,Default,,0,0,0,,Бірақ балшық қақпасында
Dialogue: 0,0:14:30.32,0:14:33.91,Default,,0,0,0,,Соңғы бірнеше айда есеймеген бірде-бір адам жоқ.
Dialogue: 0,0:14:33.99,0:14:35.37,Default,,0,0,0,,Иә
Dialogue: 0,0:14:36.00,0:14:37.33,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:14:40.33,0:14:44.30,Default,,0,0,0,,Бір рет бұғатталу жеңіске де, жеңіліске де әсер етпейді.
Dialogue: 0,0:14:45.13,0:14:48.51,Default,,0,0,0,,Келесі шабуылмен Деймонға соңғы соққы беріңіз.
Dialogue: 0,0:14:48.59,0:14:50.01,Default,,0,0,0,,Король сарайының баллистасымен⸺
Dialogue: 0,0:14:52.30,0:14:53.51,Default,,0,0,0,,Шингана
Dialogue: 0,0:14:53.60,0:14:57.47,Default,,0,0,0,,Ке! Болар ма деп ойлаймын, қарғыс атқыр көзілдірік
Dialogue: 0,0:14:58.39,0:15:00.98,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:05.36,0:15:07.36,Default,,0,0,0,,Мусашидің шарасыз блиці
Dialogue: 0,0:15:07.44,0:15:09.90,Default,,0,0,0,,Мудмон еш пайдасыз тоқтай алды
Dialogue: 0,0:15:09.99,0:15:13.32,Default,,0,0,0,,Бірақ патша сарайына шабуыл жалғасуда!
Dialogue: 0,0:15:13.41,0:15:15.24,Default,,0,0,0,,Деймон қақпа сызығына дейін
Dialogue: 0,0:15:15.33,0:15:18.29,Default,,0,0,0,,Қорғауға небәрі 15 ярд қалды!
Dialogue: 0,0:15:19.04,0:15:22.75,Default,,0,0,0,,Бұл прогресті тоқтатудың сенімді жолы жоқ.
Dialogue: 0,0:15:24.46,0:15:25.71,Default,,0,0,0,,Не істеу керек...
Dialogue: 0,0:15:26.67,0:15:29.72,Default,,0,0,0,,Мен жүгіре алмасам да, Сусуму-санға қалай да көмектесе аламын...
Dialogue: 0,0:15:29.80,0:15:34.30,Default,,0,0,0,,Мен осы уақытқа дейін үйренгенімнің бәрін Шин-кунға тастаймын!
Dialogue: 0,0:15:34.39,0:15:37.77,Default,,0,0,0,,Сусуму-санға... ерінге...
Dialogue: 0,0:15:37.85,0:15:41.48,Default,,0,0,0,,Жамбастың жарылуы
Dialogue: 0,0:15:41.56,0:15:44.98,Default,,0,0,0,,Нацухико Сусуму-санға жұмсақ Спин
Dialogue: 0,0:15:46.23,0:15:47.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:47.32,0:15:48.86,Default,,0,0,0,,Ах
Dialogue: 0,0:15:48.94,0:15:52.32,Default,,0,0,0,,Сәлем! Мен оған асығамын
Dialogue: 0,0:15:52.40,0:15:55.37,Default,,0,0,0,,Мен Сусумуны мүлде талқандаймын.
Dialogue: 0,0:15:55.45,0:15:58.70,Default,,0,0,0,,Мен Сусумуды талқандаймын! Қараңдар!
Dialogue: 0,0:15:59.91,0:16:03.25,Default,,0,0,0,,Мен жүгіре алмаймын, бірақ қозғала алмаймын
Dialogue: 0,0:16:03.33,0:16:05.92,Default,,0,0,0,,Әйтеуір, Сусуму-сан белді!
Dialogue: 0,0:16:06.00,0:16:09.17,Default,,0,0,0,,Уау... ол жігіттерді түсінуге оңай.
Dialogue: 0,0:16:09.25,0:16:12.01,Default,,0,0,0,,Мен алға ұмтылуды тоқтату үшін асығуға дайынмын.
Dialogue: 0,0:16:12.09,0:16:12.93,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:13.97,0:16:16.39,Default,,0,0,0,,Ба... Бұл анық емес пе?
Dialogue: 0,0:16:18.26,0:16:21.56,Default,,0,0,0,,Қарғыс атқыр балалар...
Dialogue: 0,0:16:21.64,0:16:23.60,Default,,0,0,0,,Уақыт аяқталды...
Dialogue: 0,0:16:25.19,0:16:28.61,Default,,0,0,0,,Ол маған айтты
Dialogue: 0,0:16:30.15,0:16:31.07,Default,,0,0,0,,Хмм
Dialogue: 0,0:16:31.86,0:16:34.03,Default,,0,0,0,,Жарайды ма? Күту уақытын алмаңыз
Dialogue: 0,0:16:34.11,0:16:35.24,Default,,0,0,0,,Хехе...
Dialogue: 0,0:16:35.32,0:16:39.74,Default,,0,0,0,,Ақылға қонбайтын нәрселер қисынды болып қалатын кездер болады.
Dialogue: 0,0:16:40.37,0:16:42.20,Default,,0,0,0,,Әзірге сол күйінде қалдырыңыз.
Dialogue: 0,0:16:42.29,0:16:45.71,Default,,0,0,0,,Бұл қарғыс атқыр балалардың екпінін тоқтату мүмкін емес.
Dialogue: 0,0:16:46.79,0:16:47.67,Default,,0,0,0,,Қалпақ киіңіз!
Dialogue: 0,0:16:49.59,0:16:51.96,Default,,0,0,0,,Сусуму тағы да жетекші блок!
Dialogue: 0,0:16:52.05,0:16:55.13,Default,,0,0,0,,Сусумуды жойыңыз!
Dialogue: 0,0:16:55.22,0:16:58.10,Default,,0,0,0,,Маған рұқсат етіңіз!
Dialogue: 0,0:16:58.18,0:17:03.06,Default,,0,0,0,,(Бірін-бірі итеріп жатқан адамдардың дауыстары)
Dialogue: 0,0:17:06.10,0:17:09.98,Default,,0,0,0,,Кеттік! Таками және Сакураба Эверест асуы!
Dialogue: 0,0:17:10.07,0:17:12.94,Default,,0,0,0,,Таками-кун, мен Деймонның қорғанысын оқып жатырмын!
Dialogue: 0,0:17:14.03,0:17:16.86,Default,,0,0,0,,Сүлік жын неге оны жалғыз қалдырды?
Dialogue: 0,0:17:16.95,0:17:19.91,Default,,0,0,0,,Оның мұндай қисынсыз ойынды ойнайтын жігіт емес екеніне сенімдімін.
Dialogue: 0,0:17:19.99,0:17:21.91,Default,,0,0,0,,ДжоДжо қарсы Вамуу—
Dialogue: 0,0:17:21.99,0:17:23.16,Default,,0,0,0,,Не!?
Dialogue: 0,0:17:23.25,0:17:26.87,Default,,0,0,0,,Кекекеке... қарғыс атқыр маймылдар тек Сакурабаға қарайды
Dialogue: 0,0:17:27.50,0:17:28.33,Default,,0,0,0,,Монта
Dialogue: 0,0:17:28.42,0:17:30.79,Default,,0,0,0,,Ааааааааааааааааааааааааа
Dialogue: 0,0:17:30.88,0:17:34.76,Default,,0,0,0,,Сакураба-сенпай! Сена есіме түсірді!
Dialogue: 0,0:17:35.34,0:17:36.72,Default,,0,0,0,,Хаха...
Dialogue: 0,0:17:36.80,0:17:40.18,Default,,0,0,0,,Егер сіз тек биіктікте жарыссаңыз, жеңу мүмкіндігі жоқ.
Dialogue: 0,0:17:40.26,0:17:44.73,Default,,0,0,0,,Осы уақытқа дейін менің қолымнан келгеннің бәрі маған денеммен лақтыру!
Dialogue: 0,0:17:44.81,0:17:47.19,Default,,0,0,0,,Burnp!
Dialogue: 0,0:17:47.27,0:17:49.81,Default,,0,0,0,,Ах ха! Қарғыс атқыр...
Dialogue: 0,0:17:49.90,0:17:51.02,Default,,0,0,0,,На
Dialogue: 0,0:17:51.11,0:17:54.36,Default,,0,0,0,,Жарайсыңдар! Мен соққыдан құтылдым!
Dialogue: 0,0:17:55.07,0:17:58.07,Default,,0,0,0,,Эйс Сакураба күткендей!
Dialogue: 0,0:17:58.91,0:18:00.62,Default,,0,0,0,,Уф!
Dialogue: 0,0:18:00.70,0:18:01.99,Default,,0,0,0,,Жаман!
Dialogue: 0,0:18:02.08,0:18:03.70,Default,,0,0,0,,Ах
Dialogue: 0,0:18:03.79,0:18:06.66,Default,,0,0,0,,Сакураба-кун, жүгір! Монта-кун, қу!
Dialogue: 0,0:18:07.46,0:18:09.42,Default,,0,0,0,,Таками мырза, бұл тию.
Dialogue: 0,0:18:09.50,0:18:10.88,Default,,0,0,0,,Сіз Деймонға соңғы соққыны бере аласыз!
Dialogue: 0,0:18:13.42,0:18:14.63,Default,,0,0,0,,Ах
Dialogue: 0,0:18:15.59,0:18:17.80,Default,,0,0,0,,Не? Қазіргі салқын...
Dialogue: 0,0:18:19.64,0:18:21.26,Default,,0,0,0,,Каминаримон күтпеген жерден болды...
Dialogue: 0,0:18:22.93,0:18:23.76,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:18:24.52,0:18:27.23,Default,,0,0,0,,Бұл шындық болуы мүмкін емес. Еш ойланбаңыз.
Dialogue: 0,0:18:27.98,0:18:30.69,Default,,0,0,0,,Сакураба екеуміздің Эверест асуы болса, өте аламыз!
Dialogue: 0,0:18:31.65,0:18:34.15,Default,,0,0,0,,Ешкім жете алмайтын биіктік
Dialogue: 0,0:18:34.23,0:18:37.11,Default,,0,0,0,,Бұл Эверест асуы!
Dialogue: 0,0:18:37.19,0:18:38.61,Default,,0,0,0,,Эй!
Dialogue: 0,0:18:41.16,0:18:44.03,Default,,0,0,0,,шықты! Эверест асуы!
Dialogue: 0,0:18:44.12,0:18:45.54,Default,,0,0,0,,О (Сузунэ/Мамори) Ах.
Dialogue: 0,0:18:47.50,0:18:48.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:50.37,0:18:53.96,Default,,0,0,0,,Тағы бір қадам! Тек бір қадам аздық етеді!
Dialogue: 0,0:18:54.04,0:18:55.50,Default,,0,0,0,,Бұл қадамды қысқарту
Dialogue: 0,0:18:55.59,0:18:58.47,Default,,0,0,0,,Маған денеңмен соқтығысудан тартынба!
Dialogue: 0,0:19:00.51,0:19:04.01,Default,,0,0,0,,Мен допқа қарап тұрғанда, мен бұл қадамға жете алмадым.
Dialogue: 0,0:19:04.10,0:19:05.39,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,0:19:08.43,0:19:09.73,Default,,0,0,0,,Монта!
Dialogue: 0,0:19:10.44,0:19:11.52,Default,,0,0,0,,Қандай ақымақ!
Dialogue: 0,0:19:11.60,0:19:12.60,Default,,0,0,0,,Монта-кун!
Dialogue: 0,0:19:12.69,0:19:13.52,Default,,0,0,0,,Сен, жансыз құрал—
Dialogue: 0,0:19:13.61,0:19:16.73,Default,,0,0,0,,Әлгі жігіттің... допты қағып алу үшін айналатын күші бар.
Dialogue: 0,0:19:16.82,0:19:18.99,Default,,0,0,0,,Бәрін аяғыма төктім!
Dialogue: 0,0:19:19.61,0:19:22.45,Default,,0,0,0,,Допқа арқамен жоғарыдан ұстау
Dialogue: 0,0:19:22.53,0:19:25.16,Default,,0,0,0,,Қымбат... жоқ, тез!
Dialogue: 0,0:19:25.24,0:19:26.54,Default,,0,0,0,,Мен осында ұшып кетсем⸺
Dialogue: 0,0:19:26.62,0:19:29.91,Default,,0,0,0,,Аса жылдамдықпен ауада құлау!
Dialogue: 0,0:19:30.00,0:19:35.88,Default,,0,0,0,,Егер бұл аулау ойыны болса, сіз жеңіле алмайсыз!
Dialogue: 0,0:19:35.96,0:19:40.97,Default,,0,0,0,,♪~
Dialogue: 0,0:20:45.53,0:20:50.91,Default,,0,0,0,,~♪
Dialogue: 0,0:20:51.66,0:20:54.46,Default,,0,0,0,,Бұл Монтаның аулауы қандай?
Dialogue: 0,0:20:54.54,0:20:56.38,Default,,0,0,0,,Допты көрмесең де, Хилл Девилдің пасы болса⸺
Dialogue: 0,0:20:56.46,0:20:58.42,Default,,0,0,0,,Мен санаудан да көп алдым!
Dialogue: 0,0:20:58.50,0:20:59.71,Default,,0,0,0,,Жүр! Монта!
Dialogue: 0,0:21:00.25,0:21:01.92,Default,,0,0,0,,Келесі жолы «Көз қалқаны 21»
Dialogue: 0,0:21:02.01,0:21:04.80,Default,,0,0,0,,«9999 аулау»
Dialogue: 0,0:21:04.88,0:21:05.93,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:21:07.43,0:21:13.43,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
