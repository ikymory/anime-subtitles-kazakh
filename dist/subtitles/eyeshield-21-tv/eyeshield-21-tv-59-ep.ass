Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.25,0:00:02.91,Default,,0,0,0,,Забун
Dialogue: 0,0:00:03.04,0:00:04.54,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:00:08.21,0:00:08.92,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:00:09.05,0:00:11.55,Default,,0,0,0,,Кішкентай балалардың бәрі бірдей ойлайды.
Dialogue: 0,0:00:12.67,0:00:13.80,Default,,0,0,0,,Комусуби-кун!
Dialogue: 0,0:00:13.93,0:00:15.01,Default,,0,0,0,,Шағын қорытынды!
Dialogue: 0,0:00:15.14,0:00:17.89,Default,,0,0,0,,Немесе… жеңіңіз…
Dialogue: 0,0:00:18.64,0:00:19.51,Default,,0,0,0,,Фуго!
Dialogue: 0,0:00:21.81,0:00:24.19,Default,,0,0,0,,Фуго!
Dialogue: 0,0:00:25.73,0:00:26.35,Default,,0,0,0,,Фуго!
Dialogue: 0,0:00:27.36,0:00:29.82,Default,,0,0,0,,Доп төгілді!
Dialogue: 0,0:00:35.66,0:00:36.61,Default,,0,0,0,,(Спидвагон) Ол сөйледі! Демек, ол соңында бәрін түсінеді екен
Dialogue: 0,0:00:37.03,0:00:39.74,Default,,0,0,0,,Ұстау белгілері!
Dialogue: 0,0:00:40.74,0:00:42.83,Default,,0,0,0,,Дәл қонуға жақын
Dialogue: 0,0:00:43.20,0:00:45.92,Default,,0,0,0,,Қуат, жылдамдық және ұстау үштігі⸺
Dialogue: 0,0:00:46.04,0:00:48.00,Default,,0,0,0,,Деймон Чиби допты ұрлады
Dialogue: 0,0:00:48.96,0:00:50.75,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:52.09,0:00:57.09,Default,,0,0,0,,♪~
Dialogue: 0,0:02:09.33,0:02:14.34,Default,,0,0,0,,~♪
Dialogue: 0,0:02:22.89,0:02:24.93,Default,,0,0,0,,Деймон шынымен де күшті.
Dialogue: 0,0:02:25.06,0:02:27.93,Default,,0,0,0,,Кәкейдің айтқанын ақыры түсіндім.
Dialogue: 0,0:02:28.10,0:02:29.89,Default,,0,0,0,,Бұл 50-50 сайысы болуы мүмкін.
Dialogue: 0,0:02:30.02,0:02:34.36,Default,,0,0,0,,Сонымен, мен не істеуім керек ...
Dialogue: 0,0:02:36.11,0:02:39.82,Default,,0,0,0,,Сүлік жындары басқаратын Деймонның тактикасы бәрібір агрессивті.
Dialogue: 0,0:02:40.74,0:02:44.87,Default,,0,0,0,,Көптеген олқылықтар болса да, ол күтпеген жойқын күшпен соқтығысады.
Dialogue: 0,0:02:45.16,0:02:47.91,Default,,0,0,0,,Осы уақытқа дейін менің қарсыластарым оның жойқын күшінен қорқатын.
Dialogue: 0,0:02:48.04,0:02:50.92,Default,,0,0,0,,Тым сақтықтан мен өз бейітімді қазып алдым.
Dialogue: 0,0:02:51.88,0:02:53.96,Default,,0,0,0,,Алып Посейдон басқа.
Dialogue: 0,0:02:54.59,0:02:56.88,Default,,0,0,0,,Шабуыл тактикасын ұстанайық.
Dialogue: 0,0:02:57.26,0:02:58.92,Default,,0,0,0,,Дұрыс... Дұрыс.
Dialogue: 0,0:02:59.05,0:03:01.63,Default,,0,0,0,,Мен де Кәкейдің сөзін айтайын деп едім.
Dialogue: 0,0:03:01.76,0:03:04.26,Default,,0,0,0,,Агрессивті болыңыз
Dialogue: 0,0:03:04.39,0:03:05.18,Default,,0,0,0,,О-ши
Dialogue: 0,0:03:05.31,0:03:06.01,Default,,0,0,0,,Еркек!
Dialogue: 0,0:03:06.14,0:03:06.85,Default,,0,0,0,,О
Dialogue: 0,0:03:07.35,0:03:09.43,Default,,0,0,0,,Шабуыл Деймонға ауысады
Dialogue: 0,0:03:09.56,0:03:11.85,Default,,0,0,0,,Бірақ бұл жерде сақ болу керек.
Dialogue: 0,0:03:12.48,0:03:15.61,Default,,0,0,0,,Доп қайтарылса да, өз қақпасының алдында
Dialogue: 0,0:03:15.73,0:03:17.40,Default,,0,0,0,,Егер шабуыл сәтсіз аяқталса...
Dialogue: 0,0:03:17.78,0:03:22.11,Default,,0,0,0,,Суицид ұпайлары үшін Посейдонға 2 ұпай беріңіз.
Dialogue: 0,0:03:22.24,0:03:22.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:23.36,0:03:26.37,Default,,0,0,0,,Иә! Барлығына сәттілік!
Dialogue: 0,0:03:29.33,0:03:33.25,Default,,0,0,0,,Келесі жолы мен жүзу арқылы келемін. Мен Мизумачиді не болса да құртамын.
Dialogue: 0,0:03:33.37,0:03:34.79,Default,,0,0,0,,Фу… Фуго
Dialogue: 0,0:03:34.92,0:03:36.25,Default,,0,0,0,,Дайкичи
Dialogue: 0,0:03:36.38,0:03:37.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:37.42,0:03:41.01,Default,,0,0,0,,Қолдарыңызды қолданыңыз. Қару-жарақ.
Dialogue: 0,0:03:41.13,0:03:43.38,Default,,0,0,0,,Оны өзіңіз ойлап тапқан жоқсыз ба?
Dialogue: 0,0:03:43.51,0:03:44.97,Default,,0,0,0,,Дұрыс, Дайкичи.
Dialogue: 0,0:03:45.76,0:03:47.64,Default,,0,0,0,,Егер сіз де тасымалдаушының ұлы болсаңыз⸺
Dialogue: 0,0:03:47.76,0:03:50.98,Default,,0,0,0,,Артыңызда тұрған досыңызды майданға апарыңыз.
Dialogue: 0,0:03:51.56,0:03:52.64,Default,,0,0,0,,Бұл...
Dialogue: 0,0:03:52.77,0:03:53.73,Default,,0,0,0,,Фуго
Dialogue: 0,0:03:53.85,0:03:56.44,Default,,0,0,0,,Олай болса осы жерден жүгіруді бастайық.
Dialogue: 0,0:03:56.81,0:03:57.65,Default,,0,0,0,,Фуго?
Dialogue: 0,0:03:59.15,0:04:00.86,Default,,0,0,0,,Мизумачи қабырғасын үрлеңіз⸺
Dialogue: 0,0:04:00.99,0:04:04.07,Default,,0,0,0,,Сіз Eyeshield өтетін жолды көре аласыз ба?
Dialogue: 0,0:04:08.91,0:04:09.74,Default,,0,0,0,,Фуго!
Dialogue: 0,0:04:09.99,0:04:11.20,Default,,0,0,0,,Жыл бойы шорт киетін ұрғашы горилла ма!?
Dialogue: 0,0:04:11.33,0:04:13.92,Default,,0,0,0,,Сен сенімдісің, Комусуби-кун.
Dialogue: 0,0:04:14.04,0:04:14.96,Default,,0,0,0,,Комусуби…
Dialogue: 0,0:04:15.42,0:04:18.67,Default,,0,0,0,,Комусуби-кун тіпті Мизумачи-кунды жеңе алады
Dialogue: 0,0:04:18.80,0:04:21.59,Default,,0,0,0,,Сондықтан мен қабырға ашық деп ойладым⸺
Dialogue: 0,0:04:21.71,0:04:23.42,Default,,0,0,0,,Мен бар жылдамдықпен ішке кіремін.
Dialogue: 0,0:04:24.26,0:04:25.18,Default,,0,0,0,,Фуго
Dialogue: 0,0:04:26.01,0:04:27.10,Default,,0,0,0,,Жарайды
Dialogue: 0,0:04:27.35,0:04:32.10,Default,,0,0,0,,Физика қабырғасын Чибилермен бірге бұзайық! Оу!
Dialogue: 0,0:04:35.60,0:04:38.69,Default,,0,0,0,,Бұл сәйкестіктің кілті⸺
Dialogue: 0,0:04:38.82,0:04:40.36,Default,,0,0,0,,Ол ширек сүлік.
Dialogue: 0,0:04:40.48,0:04:43.28,Default,,0,0,0,,Сызық емес, не?
Dialogue: 0,0:04:43.74,0:04:48.45,Default,,0,0,0,,Кәне, Деймон, сен төрт шабуылмен бірінші болып жеңе аласың ба?
Dialogue: 0,0:04:48.62,0:04:51.16,Default,,0,0,0,,Мен бұл жолы Омсубиччиден жеңілмеймін
Dialogue: 0,0:04:51.29,0:04:52.20,Default,,0,0,0,,Фуго
Dialogue: 0,0:04:52.66,0:04:55.12,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:04:55.75,0:04:57.42,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:05:06.43,0:05:07.30,Default,,0,0,0,,Келе жатыр!
Dialogue: 0,0:05:07.43,0:05:08.09,Default,,0,0,0,,Жүзу
Dialogue: 0,0:05:08.34,0:05:12.10,Default,,0,0,0,,Комусубидің күшімен жеңіске жететініне сенімдімін.
Dialogue: 0,0:05:15.44,0:05:17.44,Default,,0,0,0,,А... қол...
Dialogue: 0,0:05:17.90,0:05:19.02,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:19.15,0:05:21.82,Default,,0,0,0,,Жүзу тек қолды көтергенде бір сәтке ғана⸺
Dialogue: 0,0:05:22.11,0:05:24.32,Default,,0,0,0,,Кеуде нысанаға айналады
Dialogue: 0,0:05:24.65,0:05:25.86,Default,,0,0,0,,Фуго!
Dialogue: 0,0:05:28.11,0:05:30.53,Default,,0,0,0,,Ой, не?
Dialogue: 0,0:05:31.70,0:05:34.87,Default,,0,0,0,,Екі сатылы зымыран ұшыру жылдамдығы мен қуаты
Dialogue: 0,0:05:35.16,0:05:38.88,Default,,0,0,0,,Комусуби-кун Мизумачи-кунды ұшырып жіберді~!
Dialogue: 0,0:05:41.92,0:05:44.30,Default,,0,0,0,,Толық жылдамдықпен ашыңыз!
Dialogue: 0,0:05:46.51,0:05:47.68,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:05:47.88,0:05:49.89,Default,,0,0,0,,Көз қалқаны 21 түсіп қалды
Dialogue: 0,0:05:50.01,0:05:50.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:56.35,0:05:58.69,Default,,0,0,0,,Уау, керемет екен, Кәкей.
Dialogue: 0,0:05:58.94,0:06:00.86,Default,,0,0,0,,Бұл... (Монта) Ах...
Dialogue: 0,0:06:01.81,0:06:04.03,Default,,0,0,0,,Бұл Кәкей-күн.
Dialogue: 0,0:06:04.15,0:06:06.78,Default,,0,0,0,,Мизумачи-кунның тесігінен өткендей көрінетін көз қалқаны⸺
Dialogue: 0,0:06:06.90,0:06:09.70,Default,,0,0,0,,Мен оны бірден ұстадым!
Dialogue: 0,0:06:09.99,0:06:12.08,Default,,0,0,0,,А... а...
Dialogue: 0,0:06:12.20,0:06:15.33,Default,,0,0,0,,Сіз өттім деп ойладыңыз ба? жалған көз қалқаны
Dialogue: 0,0:06:15.62,0:06:17.66,Default,,0,0,0,,Бұл тәтті. Бәрі артта...
Dialogue: 0,0:06:18.04,0:06:19.54,Default,,0,0,0,,Мен оны тоқтатамын
Dialogue: 0,0:06:21.67,0:06:23.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:24.75,0:06:26.71,Default,,0,0,0,,Кәкей мырза ғана емес
Dialogue: 0,0:06:26.84,0:06:27.80,Default,,0,0,0,,Біз де сондамыз
Dialogue: 0,0:06:28.38,0:06:30.55,Default,,0,0,0,,Егер сіз оны тартып алсаңыз, шығарып көріңіз.
Dialogue: 0,0:06:31.09,0:06:32.80,Default,,0,0,0,,Тас жолмен жүріңіз
Dialogue: 0,0:06:35.01,0:06:36.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:37.64,0:06:39.73,Default,,0,0,0,,Дауылды теңіздің биік толқындары сияқты
Dialogue: 0,0:06:39.85,0:06:44.44,Default,,0,0,0,,А, олар біздің барлық шабуылдарымызды тоқтатты.
Dialogue: 0,0:06:44.77,0:06:46.69,Default,,0,0,0,,Ең жақсы қорғаныс үштігі
Dialogue: 0,0:06:49.65,0:06:52.12,Default,,0,0,0,,Ол қалай шығады? сүлік шайтан
Dialogue: 0,0:06:52.99,0:06:56.45,Default,,0,0,0,,Деймон Ібіліс Жарғанаттар Өз қақпасының алдында
Dialogue: 0,0:06:56.58,0:06:59.79,Default,,0,0,0,,Бұл өте қауіпті аймақтан түсетін күш.
Dialogue: 0,0:07:00.33,0:07:02.63,Default,,0,0,0,,Бұл сіздің соңғы мүмкіндігіңіз Бұл теория сияқты
Dialogue: 0,0:07:02.75,0:07:05.25,Default,,0,0,0,,Пунтпен соққыны қайтара аласыз ба?
Dialogue: 0,0:07:05.38,0:07:06.59,Default,,0,0,0,,Немесе тәуекелге барыңыз⸺
Dialogue: 0,0:07:06.71,0:07:09.22,Default,,0,0,0,,Сіз бірінші рет түсуді мақсат етесіз бе?
Dialogue: 0,0:07:09.80,0:07:12.43,Default,,0,0,0,,Барыңыз~ Сіз ағайын!
Dialogue: 0,0:07:14.43,0:07:17.47,Default,,0,0,0,,Ой, Hill Demon, бірінші төмен нысананы таңдаңыз.
Dialogue: 0,0:07:17.60,0:07:19.35,Default,,0,0,0,,Мен құмар ойынға бардым!
Dialogue: 0,0:07:21.60,0:07:24.11,Default,,0,0,0,,Pass Pass Pass Max
Dialogue: 0,0:07:25.19,0:07:26.23,Default,,0,0,0,,Ei
Dialogue: 0,0:07:26.82,0:07:27.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:27.98,0:07:30.07,Default,,0,0,0,,Міне кеттік!
Dialogue: 0,0:07:31.15,0:07:32.78,Default,,0,0,0,,Жол курсы бұғатталды
Dialogue: 0,0:07:36.08,0:07:40.87,Default,,0,0,0,,Атлантика, жоқ, Мотой, Хироши Онишидің үлкен асығы
Dialogue: 0,0:07:42.04,0:07:43.83,Default,,0,0,0,,Сүлік жынына шабуыл!
Dialogue: 0,0:07:44.13,0:07:45.79,Default,,0,0,0,,Ах! (Сүзүне) Бұл қауіпті!
Dialogue: 0,0:07:45.92,0:07:48.05,Default,,0,0,0,,Уау~
Dialogue: 0,0:07:49.17,0:07:50.01,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:07:52.84,0:07:54.64,Default,,0,0,0,,Міне... доп осында...
Dialogue: 0,0:07:58.89,0:08:01.02,Default,,0,0,0,,Уау, уау!
Dialogue: 0,0:08:01.39,0:08:02.98,Default,,0,0,0,,Жолдарды ауыстыру...
Dialogue: 0,0:08:03.10,0:08:04.98,Default,,0,0,0,,Бүйірлік көз қалқанына тігілген
Dialogue: 0,0:08:09.48,0:08:12.70,Default,,0,0,0,,Екі жау – Кәкей-күн мен Охира-кун.
Dialogue: 0,0:08:13.03,0:08:15.95,Default,,0,0,0,,Барлығың жолды босатыңдар.
Dialogue: 0,0:08:17.24,0:08:18.24,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:08:18.37,0:08:21.91,Default,,0,0,0,,Ахаха блок Мен өте сәттімін
Dialogue: 0,0:08:22.71,0:08:26.17,Default,,0,0,0,,Егер Ишимару-сан мен Таки-кун бір-біріне тосқауыл қойса...
Dialogue: 0,0:08:29.00,0:08:29.63,Default,,0,0,0,,Аха?
Dialogue: 0,0:08:29.88,0:08:30.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:36.59,0:08:37.97,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:38.30,0:08:41.14,Default,,0,0,0,,Мені қолымнан итеріп жіберді, тіпті тигізбедім.
Dialogue: 0,0:08:41.27,0:08:43.43,Default,,0,0,0,,Мүмкін емес~
Dialogue: 0,0:08:45.85,0:08:46.90,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:08:47.06,0:08:48.11,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:49.98,0:08:50.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:51.53,0:08:52.78,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:53.74,0:08:54.57,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:54.70,0:08:55.74,Default,,0,0,0,,Тас жолы
Dialogue: 0,0:08:56.16,0:08:57.99,Default,,0,0,0,,Раковинаға арналған көз қалқаны
Dialogue: 0,0:08:58.12,0:08:59.99,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:01.37,0:09:03.75,Default,,0,0,0,,Қалайсың, кішкентай балық?
Dialogue: 0,0:09:04.04,0:09:07.25,Default,,0,0,0,,Кәкей мырза тікелей үйреткен қол техникасы!
Dialogue: 0,0:09:07.38,0:09:10.75,Default,,0,0,0,,Мені Кәкей мырзаның тамаша техникасымен шатастырмаңыз.
Dialogue: 0,0:09:11.25,0:09:12.88,Default,,0,0,0,,Сіздікі әлі өрескел
Dialogue: 0,0:09:13.01,0:09:13.88,Default,,0,0,0,,Не!
Dialogue: 0,0:09:14.17,0:09:17.89,Default,,0,0,0,,Биік денесін пайдаланатын ұзын қолмен ол тіпті жаудың блокаторларына да тимейді.
Dialogue: 0,0:09:18.47,0:09:23.52,Default,,0,0,0,,Оның шеберлігі тым тамаша. Шүн Кәкей деген кісінің шын құдіреті осы ма?
Dialogue: 0,0:09:25.23,0:09:28.56,Default,,0,0,0,,Мен осы ойынды қорғағанша
Dialogue: 0,0:09:29.31,0:09:32.32,Default,,0,0,0,,Мен сізге бір рет гол соғуға рұқсат бермеймін.
Dialogue: 0,0:09:33.36,0:09:35.99,Default,,0,0,0,,Егер сіз оны тартып алсаңыз, шығарып көріңіз.
Dialogue: 0,0:09:38.32,0:09:41.41,Default,,0,0,0,,Сүлік шайтан күткендей, біз бұл туралы ештеңе істей алмаймыз.
Dialogue: 0,0:09:41.66,0:09:46.50,Default,,0,0,0,,Посейдон Посейдон Посейдон...
Dialogue: 0,0:09:47.12,0:09:49.46,Default,,0,0,0,,Посейдон Посейдон Посейдон...
Dialogue: 0,0:09:52.80,0:09:54.09,Default,,0,0,0,,Мистер Хилл Демон
Dialogue: 0,0:09:54.21,0:09:55.42,Default,,0,0,0,,Сүлік жын
Dialogue: 0,0:09:56.17,0:09:57.97,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:59.05,0:10:00.97,Default,,0,0,0,,Деймон: Бірінші түсу мүмкін емес
Dialogue: 0,0:10:01.14,0:10:03.81,Default,,0,0,0,,Шабуыл Гигант Посейдонға жылжиды
Dialogue: 0,0:10:03.93,0:10:04.60,Default,,0,0,0,,Орнату!
Dialogue: 0,0:10:04.72,0:10:07.48,Default,,0,0,0,,(Посейдонды қолдау)
Dialogue: 0,0:10:10.94,0:10:15.11,Default,,0,0,0,,Уф... Жоғалтпай одан да жақсырақ етемін.
Dialogue: 0,0:10:15.23,0:10:18.95,Default,,0,0,0,,Go Go Devil Go Go Butts
Dialogue: 0,0:10:19.07,0:10:20.16,Default,,0,0,0,,Шляпа!
Dialogue: 0,0:10:23.87,0:10:24.49,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:24.62,0:10:25.66,Default,,0,0,0,,Қобансаме Сенпай
Dialogue: 0,0:10:25.87,0:10:26.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:26.70,0:10:28.46,Default,,0,0,0,,Мұнда…
Dialogue: 0,0:10:28.96,0:10:31.38,Default,,0,0,0,,Менің қасымнан өтуге болады.
Dialogue: 0,0:10:31.63,0:10:33.50,Default,,0,0,0,,Ууу~ Шынайы ма?
Dialogue: 0,0:10:33.63,0:10:34.38,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:34.71,0:10:35.88,Default,,0,0,0,,Фуго
Dialogue: 0,0:10:36.01,0:10:37.84,Default,,0,0,0,,Сукедачи
Dialogue: 0,0:10:38.80,0:10:41.30,Default,,0,0,0,,Ой, мен сені жібере алмаймын.
Dialogue: 0,0:10:41.72,0:10:44.31,Default,,0,0,0,,Омсубиччидің серіктесі менмін.
Dialogue: 0,0:10:44.43,0:10:45.51,Default,,0,0,0,,Фуго
Dialogue: 0,0:10:45.97,0:10:50.10,Default,,0,0,0,,Маған енді артқа шегінуімді айтпа. Мен сені тоқтату үшін қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,0:10:50.23,0:10:51.69,Default,,0,0,0,,Соңына дейін бар жақсылықты тілеймін.
Dialogue: 0,0:10:52.44,0:10:54.40,Default,,0,0,0,,Фуго
Dialogue: 0,0:10:54.69,0:10:58.36,Default,,0,0,0,,Қобансаме-кун ақырғы аймаққа ессіз сызық жасайды.
Dialogue: 0,0:11:00.57,0:11:01.49,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:11:01.61,0:11:02.32,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:11:02.45,0:11:04.08,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:11:05.53,0:11:07.79,Default,,0,0,0,,Тасу
Dialogue: 0,0:11:07.91,0:11:10.79,Default,,0,0,0,,Бірінші жүріс – алып Посейдон.
Dialogue: 0,0:11:10.92,0:11:12.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:13.00,0:11:14.00,Default,,0,0,0,,Бұл...
Dialogue: 0,0:11:14.13,0:11:14.75,Default,,0,0,0,,Ай жарығы қайтадан жарқыраған сәтте дейік
Dialogue: 0,0:11:14.88,0:11:15.75,Default,,0,0,0,,Алғашқыда сүйкімді көрінгенімен,
Dialogue: 0,0:11:15.88,0:11:17.09,Default,,0,0,0,,Иә~
Dialogue: 0,0:11:17.21,0:11:18.71,Default,,0,0,0,,Ухё~
Dialogue: 0,0:11:18.88,0:11:19.72,Default,,0,0,0,,Нуу…
Dialogue: 0,0:11:19.84,0:11:20.55,Default,,0,0,0,,Tsk
Dialogue: 0,0:11:20.67,0:11:22.43,Default,,0,0,0,,Боқ (Монта) Муки
Dialogue: 0,0:11:23.39,0:11:25.68,Default,,0,0,0,,Төрт ұпайлық доп те шешілді.
Dialogue: 0,0:11:25.81,0:11:27.89,Default,,0,0,0,,Посейдон 7 ұпай алда
Dialogue: 0,0:11:28.02,0:11:30.89,Default,,0,0,0,,Посейдон Посейдон Посейдон...
Dialogue: 0,0:11:32.02,0:11:35.36,Default,,0,0,0,,Мен оны қайтарамын~ Мен оны бірден қайтарамын~
Dialogue: 0,0:11:35.48,0:11:37.32,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:11:40.40,0:11:42.74,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:11:45.53,0:11:46.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:48.29,0:11:49.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:50.16,0:11:51.41,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:11:52.37,0:11:55.42,Default,,0,0,0,,Көз қалқаны 21 Кәкейдің тағы да езгені
Dialogue: 0,0:11:56.34,0:11:58.50,Default,,0,0,0,,Балшық қақпасының шабуылының сәтсіздігі
Dialogue: 0,0:11:58.63,0:12:00.42,Default,,0,0,0,,Үлкен терең шарға өзгереді
Dialogue: 0,0:12:00.63,0:12:03.30,Default,,0,0,0,,Күтілгендей, үлкен тереңдік тиімді...
Dialogue: 0,0:12:03.43,0:12:04.59,Default,,0,0,0,,Қалпақ киіңіз!
Dialogue: 0,0:12:08.72,0:12:09.43,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:12:09.56,0:12:10.73,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:12:10.85,0:12:12.02,Default,,0,0,0,,Тасу
Dialogue: 0,0:12:12.39,0:12:13.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:13.14,0:12:14.77,Default,,0,0,0,,Бұл қайтадан жасалды
Dialogue: 0,0:12:14.90,0:12:15.98,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:12:16.11,0:12:17.73,Default,,0,0,0,,Хаха...
Dialogue: 0,0:12:17.86,0:12:19.94,Default,,0,0,0,,Посейдонның соққысы да шешілді⸺
Dialogue: 0,0:12:20.07,0:12:22.95,Default,,0,0,0,,Есеп 14-0-ге дейін көтерілді.
Dialogue: 0,0:12:23.07,0:12:24.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:25.07,0:12:27.03,Default,,0,0,0,,Тек бұғаттаңыз.
Dialogue: 0,0:12:27.16,0:12:28.95,Default,,0,0,0,,Мына қарғыс атқыр жолдар!
Dialogue: 0,0:12:29.12,0:12:29.91,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:12:30.58,0:12:34.08,Default,,0,0,0,,Біз жинала алсақ, Фугофатқа ұқсайтын адамдармен бәсекелесе аламыз.
Dialogue: 0,0:12:34.21,0:12:37.63,Default,,0,0,0,,Биік денелерін пайдаланатын қолды итеру әдістерімен⸺
Dialogue: 0,0:12:37.75,0:12:39.38,Default,,0,0,0,,Маған тиіскеніңді қаламаймын
Dialogue: 0,0:12:39.50,0:12:41.38,Default,,0,0,0,,Бұл сәйкес келмейді.
Dialogue: 0,0:12:42.05,0:12:44.01,Default,,0,0,0,,Хехе...
Dialogue: 0,0:12:44.13,0:12:47.60,Default,,0,0,0,,Кішкентай балықтарды биік толқындар жұтып қояды.
Dialogue: 0,0:12:47.72,0:12:51.18,Default,,0,0,0,,Кәкей-сені мен тас жолдарым жеңілмес.
Dialogue: 0,0:12:51.31,0:12:53.73,Default,,0,0,0,,Әй... Әй, бір адам жоқ. Эй!
Dialogue: 0,0:12:54.94,0:12:58.44,Default,,0,0,0,,Ақыр аяғында бұл солай ма? Жасанды көз қалқаны
Dialogue: 0,0:12:58.69,0:13:00.32,Default,,0,0,0,,Бұлай жалғаса берсе не істеуім керек...
Dialogue: 0,0:13:00.44,0:13:01.69,Default,,0,0,0,,Жасанды көз қалқаны 21
Dialogue: 0,0:13:01.98,0:13:05.61,Default,,0,0,0,,Сіз бұл атауды осы сәйкестікте пайдалана алмайсыз.
Dialogue: 0,0:13:05.74,0:13:07.49,Default,,0,0,0,,Дәлелдеуге рұқсат етіңіз.
Dialogue: 0,0:13:09.62,0:13:11.04,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:11.16,0:13:12.58,Default,,0,0,0,,Эй, Сена, не?
Dialogue: 0,0:13:13.58,0:13:15.96,Default,,0,0,0,,Сізге бұл маңызды емес.
Dialogue: 0,0:13:17.25,0:13:19.79,Default,,0,0,0,,Кәкей алаяқты не істерімді сұрады...
Dialogue: 0,0:13:20.46,0:13:21.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:22.71,0:13:23.80,Default,,0,0,0,,Бұл! Аде?
Dialogue: 0,0:13:24.26,0:13:25.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:25.38,0:13:27.68,Default,,0,0,0,,Мәселе сізде, кішкентай денеңізбен⸺
Dialogue: 0,0:13:27.80,0:13:31.01,Default,,0,0,0,,Бакадека Кәкейді жеңсең, шағымың болмайды.
Dialogue: 0,0:13:31.68,0:13:34.23,Default,,0,0,0,,Охира мен Онишидің айналасындағы жайсыздықтар кімдер?
Dialogue: 0,0:13:34.35,0:13:36.81,Default,,0,0,0,,Біз бұл туралы бірдеңе жасаймыз.
Dialogue: 0,0:13:36.94,0:13:38.73,Default,,0,0,0,,Кел, Кәкейді жең.
Dialogue: 0,0:13:39.81,0:13:41.23,Default,,0,0,0,,Монта…
Dialogue: 0,0:13:43.36,0:13:46.24,Default,,0,0,0,,Кекеке Қызықты
Dialogue: 0,0:13:46.36,0:13:48.49,Default,,0,0,0,,Сонда бұл бірінші рет екі адамға⸺
Dialogue: 0,0:13:48.61,0:13:50.70,Default,,0,0,0,,Chibizaru Combi Play қолданбасын қолданып көрдіңіз бе?
Dialogue: 0,0:13:51.08,0:13:52.08,Default,,0,0,0,,Чиби?
Dialogue: 0,0:13:52.20,0:13:53.20,Default,,0,0,0,,Маймыл?
Dialogue: 0,0:13:53.33,0:13:57.41,Default,,0,0,0,,Бұл алдыңғы Доймоннан мүлдем өзгеше шабуылдағы революция.
Dialogue: 0,0:13:57.87,0:14:00.38,Default,,0,0,0,,Құс болсаң, биік толқын жұтпайды.
Dialogue: 0,0:14:01.59,0:14:03.13,Default,,0,0,0,,Құс?
Dialogue: 0,0:14:05.80,0:14:06.84,Default,,0,0,0,,Тілектер
Dialogue: 0,0:14:07.55,0:14:09.93,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:14:10.68,0:14:12.35,Default,,0,0,0,,Қалаулым?
Dialogue: 0,0:14:12.60,0:14:14.47,Default,,0,0,0,,Құс сүйегі?
Dialogue: 0,0:14:14.72,0:14:18.69,Default,,0,0,0,,Иә, жоғарыдан қарағанда құстың сүйегіне ұқсайды⸺
Dialogue: 0,0:14:18.81,0:14:20.19,Default,,0,0,0,,Бұл формация.
Dialogue: 0,0:14:20.65,0:14:24.07,Default,,0,0,0,,Енді, Деймонның шабуылы, қарсы шабуыл болады ма?
Dialogue: 0,0:14:24.48,0:14:25.69,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:25.90,0:14:26.78,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:14:31.41,0:14:34.87,Default,,0,0,0,,Уа, қандай білім!
Dialogue: 0,0:14:34.99,0:14:38.04,Default,,0,0,0,,«Қажет болса», – дейді Джосуке. «Жарайды».
Dialogue: 0,0:14:40.87,0:14:41.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:42.79,0:14:46.59,Default,,0,0,0,,Артыңызда допты ұстап жүгіріп келе жатқан үш жүгіруші бар ма?
Dialogue: 0,0:14:46.71,0:14:49.47,Default,,0,0,0,,Таками мырза, бұл формация дегеніміз не?
Dialogue: 0,0:14:49.59,0:14:51.72,Default,,0,0,0,,Ах Вакана
Dialogue: 0,0:14:52.34,0:14:53.68,Default,,0,0,0,,Иә
Dialogue: 0,0:14:54.26,0:14:58.43,Default,,0,0,0,,Деймон ойыны қазір басталады, әр қадам⸺
Dialogue: 0,0:14:58.56,0:15:00.60,Default,,0,0,0,,Масштабтау арқылы суретке түсіре аласыз ба?
Dialogue: 0,0:15:00.73,0:15:01.44,Default,,0,0,0,,Иә
Dialogue: 0,0:15:01.73,0:15:03.94,Default,,0,0,0,,Мүмкін бұл формация бір⸺
Dialogue: 0,0:15:04.06,0:15:05.40,Default,,0,0,0,,Оның шынайы құны
Dialogue: 0,0:15:06.69,0:15:09.36,Default,,0,0,0,,Бұл Хирума Юичидің ерекше қозғалысы.
Dialogue: 0,0:15:09.95,0:15:13.24,Default,,0,0,0,,Мен аралас ойынмен ешқашан айналысқан емеспін, бірақ...
Dialogue: 0,0:15:13.37,0:15:15.08,Default,,0,0,0,,Әйтеуір тынысым тарылды.
Dialogue: 0,0:15:15.49,0:15:18.25,Default,,0,0,0,,Мизумачи Мен аяқталуын сұрадым.
Dialogue: 0,0:15:18.37,0:15:21.04,Default,,0,0,0,,Жарайды, оны маған қалдырыңыз, топтүйін
Dialogue: 0,0:15:22.63,0:15:23.71,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:15:23.83,0:15:26.00,Default,,0,0,0,,Дон Брако
Dialogue: 0,0:15:26.30,0:15:30.88,Default,,0,0,0,,Ібіліс жарғанатының Wishbone-ді жалмау
Dialogue: 0,0:15:31.01,0:15:33.18,Default,,0,0,0,,Қалпақ киіңіз!
Dialogue: 0,0:15:36.39,0:15:38.39,Default,,0,0,0,,Деймон Бұл жүгіру пьесасы.
Dialogue: 0,0:15:40.68,0:15:42.81,Default,,0,0,0,,Ишимару-кун кіріп келеді
Dialogue: 0,0:15:43.31,0:15:45.31,Default,,0,0,0,,Ұсақтау
Dialogue: 0,0:15:48.11,0:15:48.73,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:15:55.99,0:15:57.91,Default,,0,0,0,,Жоқ, мен оны саған берген жоқпын.
Dialogue: 0,0:15:58.04,0:16:00.33,Default,,0,0,0,,Доппен жүгіріп келе жатқан - сүлгі жын.
Dialogue: 0,0:16:02.75,0:16:04.08,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:16:04.38,0:16:06.54,Default,,0,0,0,,Уау~
Dialogue: 0,0:16:08.71,0:16:10.46,Default,,0,0,0,,Жыртылу~
Dialogue: 0,0:16:10.80,0:16:11.92,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:12.88,0:16:13.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:16.60,0:16:19.89,Default,,0,0,0,,Бұл доппен жүгіріп келе жатқандай кейіп таныту.
Dialogue: 0,0:16:20.22,0:16:21.85,Default,,0,0,0,,Ишимару-кун – Мизумачи-кун
Dialogue: 0,0:16:22.06,0:16:25.31,Default,,0,0,0,,Төбедегі жын Охираны бөгеп тастайды!
Dialogue: 0,0:16:26.02,0:16:27.31,Default,,0,0,0,,Кеттік, Сена.
Dialogue: 0,0:16:28.27,0:16:29.57,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:16:29.69,0:16:31.32,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:16:34.86,0:16:35.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:35.70,0:16:36.95,Default,,0,0,0,,Уау~
Dialogue: 0,0:16:37.87,0:16:39.16,Default,,0,0,0,,блоктау...
Dialogue: 0,0:16:39.37,0:16:39.99,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:40.12,0:16:40.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:41.62,0:16:43.04,Default,,0,0,0,,Шай
Dialogue: 0,0:16:44.08,0:16:44.71,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:16:44.83,0:16:48.13,Default,,0,0,0,,Бұл Eyeshield мен Каминаримон-кун арасындағы аралас жүгіру.
Dialogue: 0,0:16:48.79,0:16:50.09,Default,,0,0,0,,Блок
Dialogue: 0,0:16:50.38,0:16:51.17,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:16:51.42,0:16:54.05,Default,,0,0,0,,Иә! Ол тыныс алады
Dialogue: 0,0:16:55.59,0:16:58.01,Default,,0,0,0,,20 ярд бірінші төмен
Dialogue: 0,0:16:58.22,0:16:59.05,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:59.18,0:17:00.51,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:00.64,0:17:01.64,Default,,0,0,0,,Иә
Dialogue: 0,0:17:01.77,0:17:02.56,Default,,0,0,0,,Хаха...
Dialogue: 0,0:17:02.68,0:17:05.27,Default,,0,0,0,,Кекеке... Кенет үйлесім тамаша, солай емес пе?
Dialogue: 0,0:17:05.39,0:17:07.98,Default,,0,0,0,,Иә, бұл таңқаларлық, сіз мұны жасадыңыз.
Dialogue: 0,0:17:14.15,0:17:17.61,Default,,0,0,0,,Жарайды, әрі қарай жүрейік, Wishbone.
Dialogue: 0,0:17:17.74,0:17:18.78,Default,,0,0,0,,Жиын
Dialogue: 0,0:17:18.91,0:17:19.83,Default,,0,0,0,,Шляпа!
Dialogue: 0,0:17:22.62,0:17:24.29,Default,,0,0,0,,Міне, тағы барамыз!
Dialogue: 0,0:17:24.41,0:17:25.62,Default,,0,0,0,,Тілектер
Dialogue: 0,0:17:29.00,0:17:31.30,Default,,0,0,0,,Өйткені, Деймон - Көз қалқаны.
Dialogue: 0,0:17:31.42,0:17:34.09,Default,,0,0,0,,Жоқ, мен ол жігітті тоқтатуым керек.
Dialogue: 0,0:17:36.97,0:17:39.34,Default,,0,0,0,,Кекеке... онда тез сөйлесейік.
Dialogue: 0,0:17:39.47,0:17:42.51,Default,,0,0,0,,Ишимару, егер мені тоқтатуға келмесең, мен жүре беремін.
Dialogue: 0,0:17:43.81,0:17:45.18,Default,,0,0,0,,Уау Ачо
Dialogue: 0,0:17:46.02,0:17:48.27,Default,,0,0,0,,Мизумачи-кун, мен оны тоқтата алдым.
Dialogue: 0,0:17:48.40,0:17:51.15,Default,,0,0,0,,Бірақ балшық, тағы 6 ярд алға жылжыңыз.
Dialogue: 0,0:17:51.44,0:17:55.78,Default,,0,0,0,,Ишимару-кун, сен оны қарапайым жолмен жұлып алдың, бұл таңқаларлық, бұл таңқаларлық, керемет.
Dialogue: 0,0:17:55.90,0:17:56.95,Default,,0,0,0,,Хехе...
Dialogue: 0,0:17:57.57,0:17:59.28,Default,,0,0,0,,Хаха...
Dialogue: 0,0:17:59.41,0:18:01.37,Default,,0,0,0,,Хилл жын-шайтан, мен оны екі жылдан бері көрмедім⸺
Dialogue: 0,0:18:01.49,0:18:04.08,Default,,0,0,0,,Сіз тіпті тілек тілегін де меңгердіңіз бе?
Dialogue: 0,0:18:04.41,0:18:09.79,Default,,0,0,0,,Қарсылас Ишимару-кунды тоқтатуға келгенде, Хилл Демон-кун допты алып қашып кетеді.
Dialogue: 0,0:18:09.96,0:18:11.96,Default,,0,0,0,,Сол сүлік жынды тоқтауға келсең
Dialogue: 0,0:18:12.09,0:18:15.59,Default,,0,0,0,,Көз қалқаны мен Каминаримонның алтын дуэті жүгіреді.
Dialogue: 0,0:18:16.13,0:18:17.76,Default,,0,0,0,,Хахаха... Болды...
Dialogue: 0,0:18:17.88,0:18:21.55,Default,,0,0,0,,Бір уақытта жүгірудің барлық үш үлгісінің алдын алудың жолы жоқ.
Dialogue: 0,0:18:21.97,0:18:26.98,Default,,0,0,0,,Кёшин қайда қорғанға келеді? Кім қашып құтыла алады?
Dialogue: 0,0:18:27.10,0:18:30.10,Default,,0,0,0,,Сүлік шайтан ойнаған сайын оны бірден таниды⸺
Dialogue: 0,0:18:30.23,0:18:31.52,Default,,0,0,0,,Допты беру
Dialogue: 0,0:18:31.77,0:18:33.48,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:18:37.07,0:18:39.11,Default,,0,0,0,,Вуки Уау!
Dialogue: 0,0:18:39.24,0:18:42.28,Default,,0,0,0,,Ой, бұл жолы Каминаримон-кун!
Dialogue: 0,0:18:42.66,0:18:45.29,Default,,0,0,0,,Қат! Кімді белгілеуім керек?
Dialogue: 0,0:18:45.66,0:18:49.00,Default,,0,0,0,,Өйткені, бұл сіріңкенің кілтін сүлгі жын ұстайды.
Dialogue: 0,0:18:49.12,0:18:51.25,Default,,0,0,0,,Хирума Юичи, ол жігіт...
Dialogue: 0,0:18:55.30,0:18:57.67,Default,,0,0,0,,О~
Dialogue: 0,0:18:58.01,0:18:58.63,Default,,0,0,0,,Сен, жыртқыш—!
Dialogue: 0,0:18:59.42,0:19:00.09,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:19:00.34,0:19:02.05,Default,,0,0,0,,Гррр…
Dialogue: 0,0:19:02.39,0:19:05.01,Default,,0,0,0,,Бұл Deimon Devil Bats-тің артқы эйсі.
Dialogue: 0,0:19:07.77,0:19:09.69,Default,,0,0,0,,Я-Ха-! (ысқырық дыбысы)
Dialogue: 0,0:19:09.81,0:19:12.06,Default,,0,0,0,,Тасу
Dialogue: 0,0:19:13.11,0:19:14.94,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:15.07,0:19:18.86,Default,,0,0,0,,14-6 ұпай Деймонның қарсы шабуылы басталады
Dialogue: 0,0:19:19.53,0:19:21.86,Default,,0,0,0,,Иә! Сен бауырым! (Юкимицу) Ия! Мистер Хилл Демон
Dialogue: 0,0:19:22.95,0:19:24.07,Default,,0,0,0,,Хехе...
Dialogue: 0,0:19:24.95,0:19:26.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:27.20,0:19:28.75,Default,,0,0,0,,Бұл жолы менмін...
Dialogue: 0,0:19:36.30,0:19:41.55,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:19:41.68,0:19:43.34,Default,,0,0,0,,Менің кезегім
Dialogue: 0,0:19:44.01,0:19:45.55,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:19:46.01,0:19:51.02,Default,,0,0,0,,♪~
Dialogue: 0,0:20:53.71,0:20:58.71,Default,,0,0,0,,~♪
Dialogue: 0,0:21:01.92,0:21:04.88,Default,,0,0,0,,Яй тілеулестің жарылуы
Dialogue: 0,0:21:05.01,0:21:06.43,Default,,0,0,0,,Бұл қызықты бола бастады
Dialogue: 0,0:21:06.55,0:21:09.01,Default,,0,0,0,,14-6 Сіз мұны істей аласыз.
Dialogue: 0,0:21:09.14,0:21:11.26,Default,,0,0,0,,Енді мен Кәкей-санды жеңуім керек.
Dialogue: 0,0:21:11.43,0:21:13.56,Default,,0,0,0,,Оны жойыңыз!
Dialogue: 0,0:21:13.68,0:21:17.69,Default,,0,0,0,,Келесі жолы «Көз қалқаны 21» «Дала уәдесі!»
Dialogue: 0,0:21:17.81,0:21:20.90,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:21:22.40,0:21:28.40,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory