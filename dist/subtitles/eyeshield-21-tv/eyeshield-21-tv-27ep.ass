Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.45,0:00:03.08,Default,,0,0,0,,Ал сендер ше, балалар!
Dialogue: 0,0:00:03.21,0:00:04.96,Default,,0,0,0,,Сіз бірден Жапониядан кетпейсіз бе?
Dialogue: 0,0:00:05.38,0:00:07.00,Default,,0,0,0,,Иә
Dialogue: 0,0:00:07.13,0:00:10.30,Default,,0,0,0,,Бізге бұдан былай үйге ұшудың қажеті жоқ.
Dialogue: 0,0:00:10.55,0:00:12.26,Default,,0,0,0,,Абай бол, ДжоДжо!
Dialogue: 0,0:00:12.76,0:00:16.39,Default,,0,0,0,,Я-! Ха-! Америкада арнайы дайындық!
Dialogue: 0,0:00:16.51,0:00:20.52,Default,,0,0,0,,«Сіз түсінетін боларсыз, бұл бейбітшілік келісіміне қол қою рәсімі —»
Dialogue: 0,0:00:27.94,0:00:28.77,Default,,0,0,0,,О~
Dialogue: 0,0:00:28.90,0:00:30.15,Default,,0,0,0,,Ммм~ (Монта) О~!
Dialogue: 0,0:00:30.28,0:00:31.78,Default,,0,0,0,,Ах~ (Куроки) О~
Dialogue: 0,0:00:32.94,0:00:35.28,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:35.41,0:00:36.24,Default,,0,0,0,,​​О?
Dialogue: 0,0:00:38.03,0:00:39.70,Default,,0,0,0,,Бұл тұлып.
Dialogue: 0,0:00:39.87,0:00:41.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:42.37,0:00:43.71,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:00:43.96,0:00:45.42,Default,,0,0,0,,Бұл тұлып
Dialogue: 0,0:00:45.83,0:00:46.67,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:00:47.08,0:00:49.50,Default,,0,0,0,,Сіз маған қамқорлық жасауымды сұрайсыз ба?
Dialogue: 0,0:00:49.63,0:00:51.63,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:52.05,0:00:55.59,Default,,0,0,0,,Каютаға жануарларды кіргізбейтіні рас.
Dialogue: 0,0:00:57.55,0:00:59.22,Default,,0,0,0,,Сабыр етіңіз, тұтынушы!
Dialogue: 0,0:00:59.35,0:01:00.68,Default,,0,0,0,,Шыу!
Dialogue: 0,0:01:01.18,0:01:05.64,Default,,0,0,0,,Әй... Мен ұша алмаймын!
Dialogue: 0,0:01:06.19,0:01:07.48,Default,,0,0,0,,Үйге қайт!
Dialogue: 0,0:01:09.65,0:01:10.48,Default,,0,0,0,,Ха?
Dialogue: 0,0:01:10.61,0:01:11.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:11.57,0:01:12.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:12.61,0:01:14.36,Default,,0,0,0,,Ээээх!
Dialogue: 0,0:01:14.74,0:01:15.61,Default,,0,0,0,,Не!
Dialogue: 0,0:01:15.86,0:01:19.37,Default,,0,0,0,,Үйге қайтқыңыз келсе, кез келген уақытта секіре аласыз.
Dialogue: 0,0:01:19.74,0:01:20.99,Default,,0,0,0,,Мен үйге бара жатырмын
Dialogue: 0,0:01:21.12,0:01:21.95,Default,,0,0,0,,Гюго!
Dialogue: 0,0:01:22.08,0:01:23.37,Default,,0,0,0,,Мен де үйге барамын!
Dialogue: 0,0:01:23.50,0:01:24.33,Default,,0,0,0,,Сосын мен де
Dialogue: 0,0:01:24.58,0:01:26.25,Default,,0,0,0,,Уау~
Dialogue: 0,0:01:26.37,0:01:27.29,Default,,0,0,0,,Фуго~
Dialogue: 0,0:01:27.42,0:01:28.29,Default,,0,0,0,,Ах~
Dialogue: 0,0:01:28.42,0:01:29.29,Default,,0,0,0,,Уау~
Dialogue: 0,0:01:29.71,0:01:30.92,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:31.50,0:01:33.09,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:01:33.34,0:01:35.38,Default,,0,0,0,,Мен... Мен...
Dialogue: 0,0:01:35.63,0:01:36.80,Default,,0,0,0,,Түсінікті болыңыз! Тамаша
Dialogue: 0,0:01:38.97,0:01:42.72,Default,,0,0,0,,Гах!
Dialogue: 0,0:01:43.68,0:01:44.72,Default,,0,0,0,,Уау~
Dialogue: 0,0:01:44.85,0:01:45.68,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:01:48.56,0:01:49.94,Default,,0,0,0,,Сена~! (Монта және басқалар) Сена~
Dialogue: 0,0:01:50.06,0:01:52.02,Default,,0,0,0,,Парашют қолданыңыз!
Dialogue: 0,0:01:52.27,0:01:53.11,Default,,0,0,0,,Иә
Dialogue: 0,0:01:53.23,0:01:55.99,Default,,0,0,0,,А-а, ашылмайды!
Dialogue: 0,0:01:56.36,0:01:58.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:59.07,0:02:05.08,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:03:12.85,0:03:18.86,Default,,0,0,0,,~♪
Dialogue: 0,0:03:25.24,0:03:26.12,Default,,0,0,0,,Иә
Dialogue: 0,0:03:26.24,0:03:28.83,Default,,0,0,0,,А-а, ашылмайды!
Dialogue: 0,0:03:28.95,0:03:30.41,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:31.00,0:03:33.46,Default,,0,0,0,,Ауырды.
Dialogue: 0,0:03:33.58,0:03:34.92,Default,,0,0,0,,Жақсысың ба? Сенна
Dialogue: 0,0:03:35.21,0:03:37.00,Default,,0,0,0,,Ұлы соғыс аяқталғаннан бері—
Dialogue: 0,0:03:37.34,0:03:39.13,Default,,0,0,0,,Сіз жалықтырдыңыз.
Dialogue: 0,0:03:39.26,0:03:41.97,Default,,0,0,0,,Мен қорқынышты түс көрдім.
Dialogue: 0,0:03:42.84,0:03:44.80,Default,,0,0,0,,Кенеттен ұшаққа отырыңыз
Dialogue: 0,0:03:44.93,0:03:47.56,Default,,0,0,0,,Егер біреу: «Мен қазір Америкаға барамын» десе.
Dialogue: 0,0:03:47.68,0:03:49.47,Default,,0,0,0,,Мұны кез келген адам жасай алады.
Dialogue: 0,0:03:49.60,0:03:50.81,Default,,0,0,0,,Оның үстіне Хилл Демон мырзаға
Dialogue: 0,0:03:50.93,0:03:53.44,Default,,0,0,0,,Тіпті Серберге қамқорлық жасауға мәжбүр болу
Dialogue: 0,0:03:54.02,0:03:55.27,Default,,0,0,0,,Сәлем, Керберус!
Dialogue: 0,0:03:55.40,0:03:56.81,Default,,0,0,0,,Рэм де көмектеседі.
Dialogue: 0,0:03:56.94,0:03:58.73,Default,,0,0,0,,Ол қазір тыныш ұйықтап жатыр.
Dialogue: 0,0:03:58.86,0:03:59.73,Default,,0,0,0,,(Сеннаның күрсінуі)
Dialogue: 0,0:04:00.40,0:04:02.74,Default,,0,0,0,,(Куританың қорылдауы)
Dialogue: 0,0:04:03.32,0:04:06.66,Default,,0,0,0,,Бірақ мен Cerberus-те бір адамға орын брондасам дұрыс па?
Dialogue: 0,0:04:07.24,0:04:09.87,Default,,0,0,0,,Шетелдік ойыншылар көптеп келді.
Dialogue: 0,0:04:09.99,0:04:11.16,Default,,0,0,0,,Орындар қалды.
Dialogue: 0,0:04:11.75,0:04:12.87,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:04:13.58,0:04:16.13,Default,,0,0,0,,Бұдан былай бізге не болады?
Dialogue: 0,0:04:19.30,0:04:21.63,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:21.76,0:04:25.30,Default,,0,0,0,,Иә? ше? Сен бозарған сияқтысың, Джумонжи.
Dialogue: 0,0:04:25.43,0:04:28.22,Default,,0,0,0,,А... менің аяғым жерге тимейді.
Dialogue: 0,0:04:28.68,0:04:31.27,Default,,0,0,0,,Әрине, бұл ұшақта.
Dialogue: 0,0:04:31.39,0:04:32.81,Default,,0,0,0,,Мен сене алмаймын.
Dialogue: 0,0:04:33.18,0:04:34.56,Default,,0,0,0,,What... what?
Dialogue: 0,0:04:34.69,0:04:36.19,Default,,0,0,0,,Сіз биіктіктен қорқасыз ба?
Dialogue: 0,0:04:36.31,0:04:37.65,Default,,0,0,0,,О... бұл өте жаман!
Dialogue: 0,0:04:37.77,0:04:41.82,Default,,0,0,0,,Иә! Қылмыскер биіктіктен қорқады екен шіркін...
Dialogue: 0,0:04:41.94,0:04:42.78,Default,,0,0,0,,Оны жай қалдырыңыз!
Dialogue: 0,0:04:42.90,0:04:47.53,Default,,0,0,0,,
Dialogue: 0,0:04:53.79,0:04:55.62,Default,,0,0,0,,Джим, мынаны қарашы.
Dialogue: 0,0:04:55.75,0:04:57.46,Default,,0,0,0,,Не? не? не?
Dialogue: 0,0:04:57.96,0:04:59.46,Default,,0,0,0,,Осы мүмкіндікті пайдаланыңыз.
Dialogue: 0,0:04:59.59,0:05:00.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:01.05,0:05:03.30,Default,,0,0,0,,Өте сүйкімді! Ол сүйкімді қыз
Dialogue: 0,0:05:03.42,0:05:06.88,Default,,0,0,0,,Ақымақ, сенің қызың емес, ұстағаның.
Dialogue: 0,0:05:07.43,0:05:11.39,Default,,0,0,0,,Хе~ шіркін ұсқынсыз тұлып!
Dialogue: 0,0:05:11.68,0:05:14.31,Default,,0,0,0,,Шулы! Бұл бейбақ, бір рет айтсаңыз, түсінесіз!
Dialogue: 0,0:05:14.73,0:05:17.69,Default,,0,0,0,,-мен не істейсіз? Не істеуім керек? Не істеуім керек?
Dialogue: 0,0:05:18.02,0:05:20.61,Default,,0,0,0,,Сіз менің не айтып тұрғанымды түсінбейсіз бе?
Dialogue: 0,0:05:20.73,0:05:21.82,Default,,0,0,0,,Не? не? не?
Dialogue: 0,0:05:22.11,0:05:22.94,Default,,0,0,0,,Хмф!
Dialogue: 0,0:05:23.19,0:05:26.78,Default,,0,0,0,,Сол үшін айтарым бір нәрсені қайталап қайталама!
Dialogue: 0,0:05:26.90,0:05:29.32,Default,,0,0,0,,Түсіндім, түсіндім, а...
Dialogue: 0,0:05:29.45,0:05:30.41,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,0:05:30.53,0:05:32.33,Default,,0,0,0,,Жарайды, ана тұлыпты алып кел.
Dialogue: 0,0:05:32.45,0:05:33.29,Default,,0,0,0,,Ммм
Dialogue: 0,0:05:34.95,0:05:38.00,Default,,0,0,0,,Хмм Майкл
Dialogue: 0,0:05:38.54,0:05:41.46,Default,,0,0,0,,Кішкентай қыз, сен жақсы қызсың, қолыңды жібер.
Dialogue: 0,0:05:41.59,0:05:42.55,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:05:43.05,0:05:43.96,Default,,0,0,0,,Уф
Dialogue: 0,0:05:44.46,0:05:45.92,Default,,0,0,0,,Не! Теми
Dialogue: 0,0:05:46.05,0:05:48.84,Default,,0,0,0,,Әй, жиіркенішті, құсқым келеді.
Dialogue: 0,0:05:48.97,0:05:51.93,Default,,0,0,0,,Е, ақымақ, әжетхана ана жақта.
Dialogue: 0,0:05:52.14,0:05:54.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:56.73,0:05:58.64,Default,,0,0,0,,Бауырым, енді не істейсің?
Dialogue: 0,0:05:58.77,0:05:59.85,Default,,0,0,0,,Ал, қараңдаршы.
Dialogue: 0,0:06:02.40,0:06:05.19,Default,,0,0,0,,Түсіндім! Үлкен аға, жылы болу жақсы~
Dialogue: 0,0:06:05.32,0:06:07.36,Default,,0,0,0,,Жарайды, қайтарыңыз.
Dialogue: 0,0:06:07.49,0:06:08.32,Default,,0,0,0,,Мұндай жағдай болса деп, астымда бронежилет киіп жүрмін.
Dialogue: 0,0:06:11.57,0:06:12.41,Default,,0,0,0,,О
Dialogue: 0,0:06:16.79,0:06:18.21,Default,,0,0,0,,Ах Кербер
Dialogue: 0,0:06:19.00,0:06:21.54,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:06:25.30,0:06:27.97,Default,,0,0,0,,Аа, солай~
Dialogue: 0,0:06:29.26,0:06:32.14,Default,,0,0,0,,Сәлем, бастық! сен қамқоршысың
Dialogue: 0,0:06:32.26,0:06:34.72,Default,,0,0,0,,Иә? Хмм...
Dialogue: 0,0:06:36.56,0:06:39.56,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:06:45.07,0:06:47.57,Default,,0,0,0,,Иә? Майкл...
Dialogue: 0,0:06:48.28,0:06:50.53,Default,,0,0,0,,Майкл? Майкл?
Dialogue: 0,0:06:50.86,0:06:53.53,Default,,0,0,0,,Майкл? Майкл?
Dialogue: 0,0:06:54.24,0:06:55.54,Default,,0,0,0,,Сіз Майклды білмейсіз бе?
Dialogue: 0,0:06:55.66,0:06:56.49,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:06:56.83,0:06:57.91,Default,,0,0,0,,Хмм?
Dialogue: 0,0:06:58.04,0:07:00.62,Default,,0,0,0,,Майкл! Мен осындай жерде болдым
Dialogue: 0,0:07:00.75,0:07:02.96,Default,,0,0,0,,Бұл жақсы емес, сен аузыңды жауып, жоқ болуың керек.
Dialogue: 0,0:07:03.88,0:07:06.92,Default,,0,0,0,,Ол кенет ауырлап барады.
Dialogue: 0,0:07:07.38,0:07:09.92,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:14.10,0:07:15.14,Default,,0,0,0,,Уау~
Dialogue: 0,0:07:16.81,0:07:18.06,Default,,0,0,0,,Қайта толтырыңыз!
Dialogue: 0,0:07:18.93,0:07:19.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:20.52,0:07:22.27,Default,,0,0,0,,3 порция беріңізші
Dialogue: 0,0:07:22.40,0:07:23.23,Default,,0,0,0,,Иә...
Dialogue: 0,0:07:25.36,0:07:26.44,Default,,0,0,0,,Үлкен Үштікті айтпағанда, олар одан да мықты—
Dialogue: 0,0:07:26.57,0:07:28.23,Default,,0,0,0,,Бұл жиіркенішті, мен оны жей алмаймын.
Dialogue: 0,0:07:29.36,0:07:30.32,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:07:31.36,0:07:32.78,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:07:32.91,0:07:34.24,Default,,0,0,0,,О? Майкл
Dialogue: 0,0:07:34.37,0:07:36.08,Default,,0,0,0,,Сіз қазір сөйлей аласыз ба?
Dialogue: 0,0:07:36.37,0:07:37.66,Default,,0,0,0,,(Кербер айқайлайды)
Dialogue: 0,0:07:37.79,0:07:40.04,Default,,0,0,0,,Өте тамаша~ Сіз өте өстіңіз.
Dialogue: 0,0:07:40.58,0:07:43.42,Default,,0,0,0,,Майкл енді сөйлей алады.
Dialogue: 0,0:07:43.54,0:07:45.00,Default,,0,0,0,,Иә, бұл жақсы.
Dialogue: 0,0:07:45.29,0:07:47.42,Default,,0,0,0,,Майкл анам да мені мақтады.
Dialogue: 0,0:07:47.55,0:07:48.96,Default,,0,0,0,,Иә Сыйақы
Dialogue: 0,0:07:50.09,0:07:53.68,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:07:53.80,0:07:57.01,Default,,0,0,0,,Үлкен аға! Бұл біртүрлі, біртүрлі, біртүрлі
Dialogue: 0,0:07:57.14,0:07:59.10,Default,,0,0,0,,Хмф! Бұл ауырады
Dialogue: 0,0:07:59.27,0:08:01.35,Default,,0,0,0,,Сіз әлі ұмыттыңыз ба?
Dialogue: 0,0:08:01.48,0:08:05.23,Default,,0,0,0,,Өйткені әлгі тұлып сиыр етін жеп жатыр.
Dialogue: 0,0:08:05.35,0:08:06.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:09.11,0:08:10.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:10.44,0:08:11.57,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:11.69,0:08:13.49,Default,,0,0,0,,Бұл, сөзсіз, қоңырау шалған жігіт сияқты. Ол «Юхамон» қолданушысы да, жау да емес.
Dialogue: 0,0:08:13.61,0:08:14.45,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:08:14.57,0:08:16.24,Default,,0,0,0,,Тұлып сиыр етіндей.
Dialogue: 0,0:08:16.37,0:08:17.99,Default,,0,0,0,,Мен оны жемейді деп ойлаймын.
Dialogue: 0,0:08:18.12,0:08:19.87,Default,,0,0,0,,Мен сенің тамақтанып жатқаныңды естідім...
Dialogue: 0,0:08:21.25,0:08:24.83,Default,,0,0,0,,Ұшақ жақында Хьюстон әуежайына келеді.
Dialogue: 0,0:08:27.21,0:08:28.17,Default,,0,0,0,,О!
Dialogue: 0,0:08:28.29,0:08:29.13,Default,,0,0,0,,Фугок Фугок
Dialogue: 0,0:08:29.25,0:08:30.30,Default,,0,0,0,,Бұл Америка!
Dialogue: 0,0:08:30.84,0:08:34.26,Default,,0,0,0,,Біз келдік. Ақыры... біз түсе аламыз.
Dialogue: 0,0:08:34.55,0:08:38.39,Default,,0,0,0,,Хе, не десең де, бәлкім, көңілді жүрген шығарсың.
Dialogue: 0,0:08:38.51,0:08:39.72,Default,,0,0,0,,Ей, ақымақ балалар.
Dialogue: 0,0:08:40.35,0:08:41.68,Default,,0,0,0,,О, Майкл!
Dialogue: 0,0:08:41.81,0:08:42.68,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:08:45.65,0:08:48.65,Default,,0,0,0,,Майкл! Менің сүйікті сиыр еті
Dialogue: 0,0:08:50.94,0:08:52.82,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:08:53.40,0:08:54.24,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:08:54.99,0:08:55.86,Default,,0,0,0,,О!
Dialogue: 0,0:08:55.99,0:08:57.66,Default,,0,0,0,,Бауырым, жаңа көргеніңді көрдің бе? Сіз оны көрдіңіз бе?
Dialogue: 0,0:08:57.78,0:08:58.99,Default,,0,0,0,,Не?
Dialogue: 0,0:08:59.12,0:09:00.87,Default,,0,0,0,,Тұлып жүгіріп келеді
Dialogue: 0,0:09:00.99,0:09:02.29,Default,,0,0,0,,Хмф! Бұл ауырады
Dialogue: 0,0:09:12.51,0:09:14.42,Default,,0,0,0,,Баршаңызға сапарыңыз сәтті өтсін.
Dialogue: 0,0:09:15.09,0:09:17.64,Default,,0,0,0,,Біз сізді тағы да күтеміз.
Dialogue: 0,0:09:18.18,0:09:19.89,Default,,0,0,0,,Ештеңені ұмытпа
Dialogue: 0,0:09:20.47,0:09:23.35,Default,,0,0,0,,Төбе шайтан, сен бүгін қайда тұрсың?
Dialogue: 0,0:09:23.47,0:09:24.31,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:09:24.68,0:09:25.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:26.60,0:09:29.27,Default,,0,0,0,,Қарғыс атсын! Менде түндейтін бір тиын жоқ.
Dialogue: 0,0:09:29.40,0:09:31.23,Default,,0,0,0,,Барлығы жергілікті жерден алынған
Dialogue: 0,0:09:31.65,0:09:32.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:32.94,0:09:33.78,Default,,0,0,0,,Міне!
Dialogue: 0,0:09:33.90,0:09:37.11,Default,,0,0,0,,Бізді осылай жат жерге тастап кетті.
Dialogue: 0,0:09:37.24,0:09:38.28,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:09:38.78,0:09:39.87,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:09:39.99,0:09:41.24,Default,,0,0,0,,Менің бір ісім бар.
Dialogue: 0,0:09:41.53,0:09:44.20,Default,,0,0,0,,Сіз кенеттен осындай бірдеңе айтса да
Dialogue: 0,0:09:46.75,0:09:48.67,Default,,0,0,0,,Мен шынымен де мықты энергияны сезіп тұрмын!
Dialogue: 0,0:09:48.79,0:09:50.25,Default,,0,0,0,,Не болды? Сенна
Dialogue: 0,0:09:50.50,0:09:52.17,Default,,0,0,0,,Мен Керберді ұмытып кетіппін!
Dialogue: 0,0:09:52.30,0:09:54.30,Default,,0,0,0,,Хилл Демон өлтірді
Dialogue: 0,0:09:54.42,0:09:55.59,Default,,0,0,0,,(Сілік шайтанның күлкісі)
Dialogue: 0,0:09:56.13,0:09:58.05,Default,,0,0,0,,Ах! Мен бір нәрсені ұмыттым
Dialogue: 0,0:09:58.34,0:09:59.47,Default,,0,0,0,,Не!
Dialogue: 0,0:10:02.81,0:10:04.93,Default,,0,0,0,,Бұл тұлып емес пе?
Dialogue: 0,0:10:05.73,0:10:07.81,Default,,0,0,0,,Иә, тұлып жақсы, солай ма?
Dialogue: 0,0:10:07.94,0:10:10.23,Default,,0,0,0,,Е, жоқ, бұл емес.
Dialogue: 0,0:10:10.35,0:10:12.32,Default,,0,0,0,,Мен мұны қалай айта аламын...
Dialogue: 0,0:10:12.44,0:10:15.44,Default,,0,0,0,,Дұрыс, ұсқынсыз және жауыз.
Dialogue: 0,0:10:15.61,0:10:16.82,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:10:16.94,0:10:19.07,Default,,0,0,0,,Менде дәл осыған ұқсас тұлып бар еді.
Dialogue: 0,0:10:19.20,0:10:20.66,Default,,0,0,0,,Бір кішкентай қыз болды.
Dialogue: 0,0:10:21.03,0:10:22.62,Default,,0,0,0,,Міне! (Монта) Иә!
Dialogue: 0,0:10:28.66,0:10:29.58,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:10:30.12,0:10:31.54,Default,,0,0,0,,А... Хилл Демон ше?
Dialogue: 0,0:10:32.13,0:10:35.38,Default,,0,0,0,,«Менімен американдық футбол стадионында кешкі сағат 6-да кездесіңіз» деңіз.
Dialogue: 0,0:10:35.50,0:10:37.51,Default,,0,0,0,,Мен өзім бір жаққа тез кеттім.
Dialogue: 0,0:10:37.97,0:10:39.13,Default,,0,0,0,,Сағат 6.
Dialogue: 0,0:10:39.51,0:10:41.59,Default,,0,0,0,,Мен оны сол уақытқа дейін табуым керек.
Dialogue: 0,0:10:42.01,0:10:43.93,Default,,0,0,0,,Цербер!
Dialogue: 0,0:10:44.60,0:10:46.43,Default,,0,0,0,,Цербер!
Dialogue: 0,0:10:47.39,0:10:49.31,Default,,0,0,0,,Цербер!
Dialogue: 0,0:10:49.69,0:10:52.06,Default,,0,0,0,,Бөлініп, ізденейік.
Dialogue: 0,0:10:52.19,0:10:53.56,Default,,0,0,0,,Біріншіден, бұл қыз.
Dialogue: 0,0:10:53.98,0:10:56.36,Default,,0,0,0,,Олай болса, Курита-кун мен Комусуби-кун.
Dialogue: 0,0:10:56.48,0:10:57.53,Default,,0,0,0,,Мен және Мамори-сан
Dialogue: 0,0:10:58.28,0:10:59.24,Default,,0,0,0,,Мурата мырза!
Dialogue: 0,0:10:59.36,0:11:01.20,Default,,0,0,0,,О...
Dialogue: 0,0:11:01.70,0:11:03.24,Default,,0,0,0,,Біз өтеміз
Dialogue: 0,0:11:03.49,0:11:06.54,Default,,0,0,0,,Джумонджи Мен өзімді жақсы сезінбеймін, сондықтан маған еріп жүруің керек.
Dialogue: 0,0:11:07.04,0:11:09.83,Default,,0,0,0,,А... онда, жүктеріңді күтіңдер.
Dialogue: 0,0:11:10.62,0:11:14.04,Default,,0,0,0,,Америкаға келудің несі қайғылы?
Dialogue: 0,0:11:14.17,0:11:16.63,Default,,0,0,0,,Мен қарғыс атқан итті табуым керек пе?
Dialogue: 0,0:11:16.75,0:11:17.71,Default,,0,0,0,,Бұл жерде тақды шарлатанға тапсыратын орын да емес қой, иә?
Dialogue: 0,0:11:18.13,0:11:19.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:25.14,0:11:27.43,Default,,0,0,0,,Хмм... мм
Dialogue: 0,0:11:28.56,0:11:29.73,Default,,0,0,0,,Дегенмен—
Dialogue: 0,0:11:29.85,0:11:31.14,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:31.52,0:11:33.19,Default,,0,0,0,,Әйтеуір, Хилл Демон мырза
Dialogue: 0,0:11:33.31,0:11:36.15,Default,,0,0,0,,Неліктен Серберді Америкаға әкелдің?
Dialogue: 0,0:11:36.86,0:11:38.48,Default,,0,0,0,,Цербер
Dialogue: 0,0:11:39.03,0:11:41.36,Default,,0,0,0,,Мен және Хилл Демон орта мектепте оқып жүргенде...
Dialogue: 0,0:11:41.49,0:11:44.82,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:11:45.91,0:11:46.83,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:11:51.54,0:11:55.54,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:11:58.50,0:12:02.51,Default,,0,0,0,,(Цербердің ізі)
Dialogue: 0,0:12:04.05,0:12:06.60,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:12:13.64,0:12:15.19,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:12:17.98,0:12:22.36,Default,,0,0,0,,Қаңғыбас ит болсаң керек, көзің сүйкімді.
Dialogue: 0,0:12:31.75,0:12:34.33,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:12:34.46,0:12:36.25,Default,,0,0,0,,Хехе...
Dialogue: 0,0:12:49.72,0:12:50.56,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:12:52.22,0:12:53.10,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:13:07.62,0:13:09.33,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:13:16.67,0:13:17.79,Default,,0,0,0,,Ой… ой, жоқ
Dialogue: 0,0:13:18.33,0:13:21.30,Default,,0,0,0,,Бүгіннен бастап сіз Керберссіз!
Dialogue: 0,0:13:22.92,0:13:26.80,Default,,0,0,0,,Содан бері сүлік жындары Церберге ерекше назар аудара бастады.
Dialogue: 0,0:13:26.93,0:13:30.30,Default,,0,0,0,,Кербер сүлік жындарды да тыңдай бастаған сияқты.
Dialogue: 0,0:13:30.43,0:13:31.81,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:13:32.52,0:13:36.73,Default,,0,0,0,,Бірақ Сербер де Ібіліс жарғанаттарының мүшесі.
Dialogue: 0,0:13:36.94,0:13:39.77,Default,,0,0,0,,Әйтеуір, бөлініп, қайта іздейік.
Dialogue: 0,0:13:40.23,0:13:41.23,Default,,0,0,0,,О!
Dialogue: 0,0:13:42.07,0:13:44.94,Default,,0,0,0,,Осындай ұсқынсыз тұлыппен
Dialogue: 0,0:13:45.07,0:13:47.03,Default,,0,0,0,,Барлығы шу шығарды
Dialogue: 0,0:13:48.91,0:13:50.70,Default,,0,0,0,,О? Не... не?
Dialogue: 0,0:13:51.41,0:13:54.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:56.87,0:13:58.37,Default,,0,0,0,,Сәлем! Бұл не?
Dialogue: 0,0:13:58.96,0:14:01.84,Default,,0,0,0,,Бұл не екенін сұрасаң да, түсінбеймін.
Dialogue: 0,0:14:02.17,0:14:03.71,Default,,0,0,0,,Бұл контрабанда.
Dialogue: 0,0:14:04.21,0:14:05.30,Default,,0,0,0,,Қамау!
Dialogue: 0,0:14:05.76,0:14:06.63,Default,,0,0,0,,Ха?
Dialogue: 0,0:14:06.92,0:14:08.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:08.22,0:14:09.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:10.18,0:14:11.30,Default,,0,0,0,,Эй, бұл...
Dialogue: 0,0:14:11.43,0:14:12.26,Default,,0,0,0,,Бұл сүлік жын!
Dialogue: 0,0:14:12.85,0:14:14.72,Default,,0,0,0,,Эй, Хилл Демон!
Dialogue: 0,0:14:15.39,0:14:16.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:16.93,0:14:19.40,Default,,0,0,0,,Сіз осы адамдардың бірісіз бе?
Dialogue: 0,0:14:19.65,0:14:21.02,Default,,0,0,0,,Бірақ қызығы сол, 5-ші және 6-шы бөлімдерде…
Dialogue: 0,0:14:21.15,0:14:23.15,Default,,0,0,0,,Не? (Джумонджи) Эй, сүлік жын!
Dialogue: 0,0:14:23.27,0:14:24.44,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:14:24.82,0:14:25.69,Default,,0,0,0,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:14:26.07,0:14:29.41,Default,,0,0,0,,Ақымақ! жын! шайтан!
Dialogue: 0,0:14:31.95,0:14:33.70,Default,,0,0,0,,Кеденнен аман-есен өттіңіз.
Dialogue: 0,0:14:33.83,0:14:38.62,Default,,0,0,0,,Әй, қызымнан сол тұлыпты алу ғана қалды.
Dialogue: 0,0:14:38.75,0:14:39.58,Default,,0,0,0,,Иә
Dialogue: 0,0:14:39.71,0:14:41.33,Default,,0,0,0,,Сөмкеңде не бар?
Dialogue: 0,0:14:41.46,0:14:42.71,Default,,0,0,0,,Майкл
Dialogue: 0,0:14:42.84,0:14:44.34,Default,,0,0,0,,Тұлыптың қозғалуы мүмкін емес, солай ма?
Dialogue: 0,0:14:44.88,0:14:46.88,Default,,0,0,0,,Сол үшін өстім
Dialogue: 0,0:14:47.01,0:14:49.55,Default,,0,0,0,,Ол да сыпайы сөйлейді.
Dialogue: 0,0:14:49.68,0:14:50.51,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:14:50.63,0:14:51.59,Default,,0,0,0,,(Цербер айқайлайды)
Dialogue: 0,0:14:51.72,0:14:53.97,Default,,0,0,0,,Жарайды, қарныңыз ашты.
Dialogue: 0,0:14:54.10,0:14:55.10,Default,,0,0,0,,Күте тұрыңыз, Майкл.
Dialogue: 0,0:14:56.47,0:14:58.27,Default,,0,0,0,,Арнайы Хьюстон Бургері.
Dialogue: 0,0:14:58.39,0:14:59.56,Default,,0,0,0,,(Цербер айқайлайды)
Dialogue: 0,0:15:00.23,0:15:02.52,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:15:02.65,0:15:03.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:04.19,0:15:06.48,Default,,0,0,0,,К... Сол жерде Цербер болды!
Dialogue: 0,0:15:07.07,0:15:09.99,Default,,0,0,0,,Майкл, іште тыныш тамақтан.
Dialogue: 0,0:15:11.16,0:15:11.99,Default,,0,0,0,,Эй
Dialogue: 0,0:15:12.11,0:15:12.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:14.78,0:15:15.74,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:16.16,0:15:18.00,Default,,0,0,0,,Ұры!
Dialogue: 0,0:15:20.12,0:15:21.00,Default,,0,0,0,,Мен сені қуамын! Сенна
Dialogue: 0,0:15:21.12,0:15:21.96,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:24.46,0:15:25.92,Default,,0,0,0,,Бізге Керберусты қайтару керек.
Dialogue: 0,0:15:26.05,0:15:26.88,Default,,0,0,0,,Ах
Dialogue: 0,0:15:29.97,0:15:30.97,Default,,0,0,0,,Курита мырза!
Dialogue: 0,0:15:31.09,0:15:33.59,Default,,0,0,0,,Бұл сөмкеде Кербер бар!
Dialogue: 0,0:15:34.09,0:15:36.06,Default,,0,0,0,,Иә? Әй, ә!
Dialogue: 0,0:15:36.31,0:15:37.77,Default,,0,0,0,,Соқтығыс!
Dialogue: 0,0:15:39.35,0:15:43.19,Default,,0,0,0,,(Екі адам айғайлайды)
Dialogue: 0,0:15:44.31,0:15:45.15,Default,,0,0,0,,Гау?
Dialogue: 0,0:15:45.65,0:15:46.86,Default,,0,0,0,,Цербер!
Dialogue: 0,0:15:48.61,0:15:50.78,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:15:50.95,0:15:51.78,Default,,0,0,0,,Ei
Dialogue: 0,0:15:51.90,0:15:53.32,Default,,0,0,0,,Ау, ауырып тұр...
Dialogue: 0,0:15:53.45,0:15:54.28,Default,,0,0,0,,Ei...
Dialogue: 0,0:15:54.41,0:15:56.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:56.53,0:16:00.29,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:16:03.79,0:16:04.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:04.75,0:16:06.79,Default,,0,0,0,,(Адамдар сөйлейді)
Dialogue: 0,0:16:06.92,0:16:08.59,Default,,0,0,0,,Уау~ қаншама адам
Dialogue: 0,0:16:08.71,0:16:09.71,Default,,0,0,0,,Бұрышта!
Dialogue: 0,0:16:09.92,0:16:10.76,Default,,0,0,0,,Хмм!
Dialogue: 0,0:16:12.93,0:16:15.80,Default,,0,0,0,,Иә (Тони) Ммм...
Dialogue: 0,0:16:16.26,0:16:17.55,Default,,0,0,0,,Ой
Dialogue: 0,0:16:20.60,0:16:22.06,Default,,0,0,0,,Не?
Dialogue: 0,0:16:23.02,0:16:24.02,Default,,0,0,0,,Гя гя...
Dialogue: 0,0:16:24.65,0:16:26.48,Default,,0,0,0,,Үлкен аға, болды (Тони).
Dialogue: 0,0:16:27.94,0:16:28.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:29.11,0:16:29.94,Default,,0,0,0,,Уау! (Тони) Иә.
Dialogue: 0,0:16:30.23,0:16:31.07,Default,,0,0,0,,Уф
Dialogue: 0,0:16:31.19,0:16:32.90,Default,,0,0,0,,Сенна! Өтіңіз! О?
Dialogue: 0,0:16:33.15,0:16:34.53,Default,,0,0,0,,Міне, міне!
Dialogue: 0,0:16:35.24,0:16:36.07,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:16:37.70,0:16:39.54,Default,,0,0,0,,Максималды ұстаңыз!
Dialogue: 0,0:16:40.49,0:16:42.20,Default,,0,0,0,,Маған сөмкеңізді беріңіз!
Dialogue: 0,0:16:42.33,0:16:43.21,Default,,0,0,0,,Яббе~
Dialogue: 0,0:16:43.33,0:16:44.54,Default,,0,0,0,,Сенна алыңыз!
Dialogue: 0,0:16:44.92,0:16:47.33,Default,,0,0,0,,Е, Монта! Жол жүру жақсы емес
Dialogue: 0,0:16:49.00,0:16:49.84,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:49.96,0:16:50.80,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,0:16:53.38,0:16:54.22,Default,,0,0,0,,А, сәттілік
Dialogue: 0,0:16:54.55,0:16:57.18,Default,,0,0,0,,Tsk, әдеттегідей конкурс жоқ!
Dialogue: 0,0:16:57.47,0:17:00.18,Default,,0,0,0,,Ихихихи…
Dialogue: 0,0:17:00.76,0:17:01.60,Default,,0,0,0,,Хмм
Dialogue: 0,0:17:02.06,0:17:04.39,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:17:04.77,0:17:05.89,Default,,0,0,0,,Цербер!
Dialogue: 0,0:17:06.02,0:17:08.06,Default,,0,0,0,,(Жынның жаңғырық дауысы)
Dialogue: 0,0:17:09.57,0:17:11.03,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:11.78,0:17:13.65,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:17:13.90,0:17:15.28,Default,,0,0,0,,Не!
Dialogue: 0,0:17:16.28,0:17:17.24,Default,,0,0,0,,Гах!
Dialogue: 0,0:17:17.95,0:17:18.78,Default,,0,0,0,,Уф
Dialogue: 0,0:17:21.54,0:17:22.75,Default,,0,0,0,,Не? Гуаааа
Dialogue: 0,0:17:25.87,0:17:27.21,Default,,0,0,0,,Қозғалыс!
Dialogue: 0,0:17:27.33,0:17:28.38,Default,,0,0,0,,Я-! Ха-!
Dialogue: 0,0:17:28.75,0:17:31.00,Default,,0,0,0,,Сәлем… Мистер Хилл Демон
Dialogue: 0,0:17:31.38,0:17:36.01,Default,,0,0,0,,Менің сөмкемдегі нағыз ит... неге? неге? неге?
Dialogue: 0,0:17:36.13,0:17:36.97,Default,,0,0,0,,Шулы~
Dialogue: 0,0:17:43.06,0:17:44.43,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:17:44.56,0:17:47.94,Default,,0,0,0,,Зергерлік бұйымдарды заңсыз алып өтпек болғандар сендер болдыңдар.
Dialogue: 0,0:17:48.06,0:17:48.90,Default,,0,0,0,,Қамау!
Dialogue: 0,0:17:49.06,0:17:49.90,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:50.02,0:17:52.36,Default,,0,0,0,,Біз заттарды жасырған тұлып!
Dialogue: 0,0:17:52.48,0:17:54.23,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:17:54.36,0:17:56.32,Default,,0,0,0,,Несие! церберус
Dialogue: 0,0:17:56.82,0:18:00.45,Default,,0,0,0,,Бұл жігіттер іздеуде жүрген, жүлдесі бар адамдар.
Dialogue: 0,0:18:01.62,0:18:03.58,Default,,0,0,0,,Уау, олар өте ұқсас
Dialogue: 0,0:18:03.70,0:18:04.79,Default,,0,0,0,,Олардың екеуі.
Dialogue: 0,0:18:05.04,0:18:07.25,Default,,0,0,0,,Әй, менің Майклым
Dialogue: 0,0:18:12.21,0:18:14.76,Default,,0,0,0,,Әйтеуір әбігер болып шықты.
Dialogue: 0,0:18:14.88,0:18:17.34,Default,,0,0,0,,Қалай болғанда да, мен Серберустың оралғанына қуаныштымын.
Dialogue: 0,0:18:17.47,0:18:20.14,Default,,0,0,0,,Сізді сүлгі жын өлтірген жоқ.
Dialogue: 0,0:18:20.76,0:18:21.72,Default,,0,0,0,,Хаа
Dialogue: 0,0:18:27.77,0:18:32.77,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:11.81,0:19:12.65,Default,,0,0,0,,О!
Dialogue: 0,0:19:21.20,0:19:22.53,Default,,0,0,0,,
Dialogue: 0,0:19:22.66,0:19:23.49,Default,,0,0,0,,Хмм!
Dialogue: 0,0:19:23.62,0:19:27.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:35.00,0:19:41.01,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:20:43.57,0:20:49.58,Default,,0,0,0,,~♪
Dialogue: 0,0:20:50.99,0:20:52.37,Default,,0,0,0,,Эй, эй, Сена!
Dialogue: 0,0:20:52.50,0:20:55.12,Default,,0,0,0,,Монтамен бұл жолы адасып қалдым ба деп ойлаймын.
Dialogue: 0,0:20:55.62,0:20:57.79,Default,,0,0,0,,Ух~ Бұл қайда?
Dialogue: 0,0:20:57.92,0:20:59.59,Default,,0,0,0,,Біреу маған айтып беріңізші~
Dialogue: 0,0:20:59.71,0:21:01.84,Default,,0,0,0,,Эй, олар мына жерде бірдеңе істеп жатыр.
Dialogue: 0,0:21:01.96,0:21:04.17,Default,,0,0,0,,Бұл американдық футбол емес пе?
Dialogue: 0,0:21:04.30,0:21:06.51,Default,,0,0,0,,Келесі жолы «Көз қалқаны 21»
Dialogue: 0,0:21:08.22,0:21:09.85,Default,,0,0,0,,Я-! Ха-!
Dialogue: 0,0:21:11.35,0:21:17.35,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory