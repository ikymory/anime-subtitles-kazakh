Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.50,0:00:04.87,Default,,0,0,0,,Ха? (Джумонджи) Иә?
Dialogue: 0,0:00:05.00,0:00:07.34,Default,,0,0,0,,Иә? Оны жалама!
Dialogue: 0,0:00:08.46,0:00:11.59,Default,,0,0,0,,(Ойын машинасының электронды дыбысы)
Dialogue: 0,0:00:12.05,0:00:13.55,Default,,0,0,0,,О, бұл керемет.
Dialogue: 0,0:00:13.68,0:00:16.30,Default,,0,0,0,,Хехе, мен американдық футбол ойнаған жоқпын.
Dialogue: 0,0:00:17.14,0:00:18.18,Default,,0,0,0,,Америка футболы?
Dialogue: 0,0:00:18.76,0:00:19.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:20.77,0:00:23.27,Default,,0,0,0,,Жүрек айнуды тудыратын сөздерді қолданбаңыз!
Dialogue: 0,0:00:23.73,0:00:24.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:25.19,0:00:26.40,Default,,0,0,0,,Пошта (операция дыбысы)
Dialogue: 0,0:00:26.60,0:00:29.23,Default,,0,0,0,,Иә! Ха! Хаха, үш ағайынды
Dialogue: 0,0:00:29.36,0:00:31.07,Default,,0,0,0,,Олар мұнайды қайда сатады?
Dialogue: 0,0:00:31.19,0:00:32.90,Default,,0,0,0,,дереу клуб бөлмесіне келіңіз.
Dialogue: 0,0:00:33.03,0:00:34.49,Default,,0,0,0,,Егер мысал фотосурет...
Dialogue: 0,0:00:34.57,0:00:36.70,Default,,0,0,0,,Ол көрсетіледі, бірақ жақсы ма?
Dialogue: 0,0:00:36.82,0:00:38.91,Default,,0,0,0,,Уф... (Куроки) Грррр... Төбе жын сволоч!
Dialogue: 0,0:00:41.54,0:00:42.87,Default,,0,0,0,,Не... бұл не?
Dialogue: 0,0:00:43.75,0:00:45.58,Default,,0,0,0,,О~
Dialogue: 0,0:00:46.67,0:00:48.67,Default,,0,0,0,,Жақсылап қараңыз!
Dialogue: 0,0:00:49.04,0:00:50.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:50.42,0:00:52.51,Default,,0,0,0,,Жаңа клуб бөлмесімен таныстыру!
Dialogue: 0,0:00:52.63,0:00:54.26,Default,,0,0,0,,Я-! Ха-! (мылтық дыбысы)
Dialogue: 0,0:00:57.84,0:00:59.18,Default,,0,0,0,,О!
Dialogue: 0,0:00:59.55,0:01:00.64,Default,,0,0,0,,Клуб бөлмесі...
Dialogue: 0,0:01:00.89,0:01:02.14,Default,,0,0,0,,Тағы бір нәрсе!
Dialogue: 0,0:01:02.56,0:01:03.89,Default,,0,0,0,,Я-! Ха-!
Dialogue: 0,0:01:05.77,0:01:06.60,Default,,0,0,0,,Tsk
Dialogue: 0,0:01:06.98,0:01:12.98,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:20.84,0:02:26.85,Default,,0,0,0,,~♪
Dialogue: 0,0:02:33.90,0:02:34.73,Default,,0,0,0,,Фуго!
Dialogue: 0,0:02:34.86,0:02:35.78,Default,,0,0,0,,Уау~
Dialogue: 0,0:02:35.90,0:02:36.90,Default,,0,0,0,,Сонымен... керемет!
Dialogue: 0,0:02:37.03,0:02:38.70,Default,,0,0,0,,Барлығы жылтыр!
Dialogue: 0,0:02:38.95,0:02:41.95,Default,,0,0,0,,Уау~ Әр адамға бір шкаф бар!
Dialogue: 0,0:02:42.12,0:02:44.20,Default,,0,0,0,,Бұл тіпті менікі.
Dialogue: 0,0:02:44.53,0:02:47.25,Default,,0,0,0,,Көрші үйде танысқаныма қуаныштымын, Комусуби-кун.
Dialogue: 0,0:02:47.37,0:02:48.20,Default,,0,0,0,,Фуго!
Dialogue: 0,0:02:49.83,0:02:51.96,Default,,0,0,0,,Ой...балалар соншалықты бейқамсыңдар...
Dialogue: 0,0:02:52.08,0:02:56.42,Default,,0,0,0,,Мукки! Тыңдаңыздар, осы сәтте менің барлығына айтар сөзім бар.
Dialogue: 0,0:02:57.13,0:02:59.72,Default,,0,0,0,,Менің атым «Каминаримон Таро»
Dialogue: 0,0:02:59.84,0:03:00.68,Default,,0,0,0,,Енді біз адамдар туралы айтатын боламыз.
Dialogue: 0,0:03:00.80,0:03:02.84,Default,,0,0,0,,Мені «Монта» сияқты ақымақ деп атамаңыз...
Dialogue: 0,0:03:02.97,0:03:04.39,Default,,0,0,0,,«Джо Монтанадан» алынды
Dialogue: 0,0:03:04.51,0:03:05.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:05.60,0:03:08.27,Default,,0,0,0,,NFL тарихындағы ең үлкен супер жұлдыз
Dialogue: 0,0:03:08.39,0:03:10.23,Default,,0,0,0,,Құдайға ең жақын адам
Dialogue: 0,0:03:10.35,0:03:11.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:11.31,0:03:14.56,Default,,0,0,0,,Оның шеберлігінің арқасында көптеген үлкен өзгерістер болды.
Dialogue: 0,0:03:14.69,0:03:17.19,Default,,0,0,0,,Адамдар оны «Монтана сиқыры» деп атады.
Dialogue: 0,0:03:17.36,0:03:18.19,Default,,0,0,0,,Сен асырап алатын балалар санын көбейту керек дедің, бірақ бұл – басты себеп емес шығар?
Dialogue: 0,0:03:18.32,0:03:19.15,Default,,0,0,0,,Мектеп оқушысы үшін ол өзімен бірге таңғаларлықтай 50 000 йен алып жүр
Dialogue: 0,0:03:19.78,0:03:20.65,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:03:23.45,0:03:24.78,Default,,0,0,0,,Керемет!
Dialogue: 0,0:03:25.24,0:03:26.78,Default,,0,0,0,,Құттықтаймыз! (Монта) Танта ~ Катан~н
Dialogue: 0,0:03:28.08,0:03:29.54,Default,,0,0,0,,Мукки!
Dialogue: 0,0:03:29.66,0:03:32.67,Default,,0,0,0,,Барлығына! Өтінемін, бұдан былай мені «Монта» деп атаңыз!
Dialogue: 0,0:03:32.79,0:03:33.75,Default,,0,0,0,,Мұны тіпті ақымақ та түсінетіндей етіп түсіндірейін.
Dialogue: 0,0:03:35.29,0:03:37.88,Default,,0,0,0,,Неліктен біз үшеуміз?
Dialogue: 0,0:03:38.00,0:03:40.76,Default,,0,0,0,,Айтайын дегенім, біз ағайынды емеспіз.
Dialogue: 0,0:03:41.13,0:03:42.72,Default,,0,0,0,,Ха... а?
Dialogue: 0,0:03:43.84,0:03:44.68,Default,,0,0,0,,Не?
Dialogue: 0,0:03:46.14,0:03:46.97,Default,,0,0,0,,Хун
Dialogue: 0,0:03:47.31,0:03:48.81,Default,,0,0,0,,мен жіпті көремін.
Dialogue: 0,0:03:48.93,0:03:51.23,Default,,0,0,0,,Мені қалдыршы, маған бәрібір.
Dialogue: 0,0:03:51.85,0:03:55.06,Default,,0,0,0,,Біз мұндай жерде ұзақ тұру ниетіміз жоқ.
Dialogue: 0,0:03:55.23,0:03:56.19,Default,,0,0,0,,Ах
Dialogue: 0,0:03:56.86,0:03:57.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:58.69,0:04:00.28,Default,,0,0,0,,(Цербердің тамақ ішкен дыбысы)
Dialogue: 0,0:04:00.40,0:04:02.32,Default,,0,0,0,,Енді тез орындаңдар.
Dialogue: 0,0:04:02.45,0:04:05.49,Default,,0,0,0,,Бүгін жаңа клуб бөлмесінің аяқталуын тойлау.
Dialogue: 0,0:04:05.62,0:04:06.53,Default,,0,0,0,,Фуго Фуго!
Dialogue: 0,0:04:06.74,0:04:09.91,Default,,0,0,0,,Дұрыс, мен кикугаку шайқасында бар күшімді салдым.
Dialogue: 0,0:04:10.04,0:04:12.00,Default,,0,0,0,,Мен де көп жаттығамын.
Dialogue: 0,0:04:12.50,0:04:15.92,Default,,0,0,0,,Біз, көмекшілер, американдық футбол клубына да көмектесеміз бе?
Dialogue: 0,0:04:16.04,0:04:17.17,Default,,0,0,0,,Әрине.
Dialogue: 0,0:04:17.29,0:04:20.46,Default,,0,0,0,,Мұның бәрі Ібіліс жарғанаттарының ойнай алатынының арқасында.
Dialogue: 0,0:04:20.59,0:04:24.01,Default,,0,0,0,,Жоқ, Мамори-сан маған айтты.
Dialogue: 0,0:04:24.13,0:04:25.93,Default,,0,0,0,,Мен жеймін! иә?
Dialogue: 0,0:04:32.64,0:04:33.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:36.19,0:04:37.56,Default,,0,0,0,,Сол адамдар...
Dialogue: 0,0:04:37.81,0:04:39.90,Default,,0,0,0,,О, мен жедім, жедім
Dialogue: 0,0:04:40.02,0:04:41.61,Default,,0,0,0,,Мен енді тамақ жей алмаймын
Dialogue: 0,0:04:42.36,0:04:44.86,Default,,0,0,0,,Уф, мен аздап көп жедім деп ойлаймын.
Dialogue: 0,0:04:45.86,0:04:47.95,Default,,0,0,0,,Боқ бастық, иә? Ах!
Dialogue: 0,0:04:48.20,0:04:50.83,Default,,0,0,0,,А, бұл «Ай сайынғы американдық футбол»
Dialogue: 0,0:04:50.95,0:04:52.70,Default,,0,0,0,,Бет қай жерде бүктелгенін оқыңыз.
Dialogue: 0,0:04:52.95,0:04:54.25,Default,,0,0,0,,Иә
Dialogue: 0,0:04:55.33,0:04:58.54,Default,,0,0,0,,«Американдық X жоғары шетелдіктер Жапонияға барады»
Dialogue: 0,0:04:58.67,0:05:01.92,Default,,0,0,0,,«Қарсы ойнайтын жапондық орта мектеп командаларын іздеу»
Dialogue: 0,0:05:02.26,0:05:06.84,Default,,0,0,0,,X High американдық футболдың отаны Американың мықты командасы емес пе?
Dialogue: 0,0:05:06.97,0:05:10.64,Default,,0,0,0,,Иә? Бұл Канто турнирінің ортасы емес пе?
Dialogue: 0,0:05:10.76,0:05:13.22,Default,,0,0,0,,Кез келген команданың аман қалуы мүмкін емес.
Dialogue: 0,0:05:13.35,0:05:16.85,Default,,0,0,0,,Сонда Америкаға тек әлсіз командалар қарсы шыға алады ма?
Dialogue: 0,0:05:16.98,0:05:19.77,Default,,0,0,0,,Бірақ мұндай абайсыз команда жоқ емес пе?
Dialogue: 0,0:05:20.44,0:05:22.40,Default,,0,0,0,,Біз екі күн бұрын өтініш бердік.
Dialogue: 0,0:05:22.53,0:05:23.53,Default,,0,0,0,,Эээ!
Dialogue: 0,0:05:23.65,0:05:24.78,Default,,0,0,0,,Мм... Абайсыз!
Dialogue: 0,0:05:24.90,0:05:26.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:26.40,0:05:28.03,Default,,0,0,0,,Әй?
Dialogue: 0,0:05:28.16,0:05:29.24,Default,,0,0,0,,Мен үшін алғаш рет!
Dialogue: 0,0:05:30.74,0:05:31.58,Default,,0,0,0,,О
Dialogue: 0,0:05:32.04,0:05:33.91,Default,,0,0,0,,«Ай сайынғы американдық футболдан» емес пе?
Dialogue: 0,0:05:34.04,0:05:36.50,Default,,0,0,0,,«Өтінішіңізге рахмет»
Dialogue: 0,0:05:36.62,0:05:38.88,Default,,0,0,0,,«Қатаң лотереяның нәтижелері»
Dialogue: 0,0:05:39.00,0:05:42.17,Default,,0,0,0,,«Өкіл күн сфинксі болып шешілді».
Dialogue: 0,0:05:42.30,0:05:44.46,Default,,0,0,0,,О, не деген ұят! Ол шықты
Dialogue: 0,0:05:44.67,0:05:47.76,Default,,0,0,0,,Бірақ мен өзімді жеңілдеп, өкінемін.
Dialogue: 0,0:05:47.88,0:05:48.72,Default,,0,0,0,,Иә
Dialogue: 0,0:05:49.30,0:05:51.93,Default,,0,0,0,,Қатаң лотереяға айналдырайық. Әлі ерте.
Dialogue: 0,0:05:52.35,0:05:53.18,Default,,0,0,0,,Әй, бұтаман
Dialogue: 0,0:05:53.97,0:05:55.85,Default,,0,0,0,,Ертең мен «Ай сайынғы американдық футболға» барамын
Dialogue: 0,0:05:55.98,0:05:56.93,Default,,0,0,0,,Эээ!
Dialogue: 0,0:06:01.19,0:06:02.86,Default,,0,0,0,,Ух... (Сілік жын) Хэхе~
Dialogue: 0,0:06:03.02,0:06:05.82,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:06:06.32,0:06:07.15,Default,,0,0,0,,Фугоцу
Dialogue: 0,0:06:07.53,0:06:08.49,Default,,0,0,0,,Фугоцу
Dialogue: 0,0:06:08.78,0:06:09.70,Default,,0,0,0,,Фугоцу
Dialogue: 0,0:06:09.99,0:06:13.16,Default,,0,0,0,,〜
Dialogue: 0,0:06:13.28,0:06:14.12,Default,,0,0,0,,Эй (Монта) Хо
Dialogue: 0,0:06:14.24,0:06:16.16,Default,,0,0,0,,Эй... (Монта) Иә...
Dialogue: 0,0:06:17.29,0:06:18.12,Default,,0,0,0,,​​О?
Dialogue: 0,0:06:20.42,0:06:22.59,Default,,0,0,0,,Олар ынталы ма?
Dialogue: 0,0:06:22.96,0:06:25.59,Default,,0,0,0,,Сүлік жын болмаса, бірден солай болар еді.
Dialogue: 0,0:06:25.71,0:06:26.55,Default,,0,0,0,,Иә
Dialogue: 0,0:06:26.88,0:06:28.05,Default,,0,0,0,,Фугоцу
Dialogue: 0,0:06:29.38,0:06:31.26,Default,,0,0,0,,Амансың ба? сызық шашырауы
Dialogue: 0,0:06:31.84,0:06:32.80,Default,,0,0,0,,Жүгіру кезінде
Dialogue: 0,0:06:32.93,0:06:34.93,Default,,0,0,0,,Алға қадам басып, жолды босатыңыз.
Dialogue: 0,0:06:35.06,0:06:36.81,Default,,0,0,0,,Өтіп бара жатқанда артқа тұрыңыз
Dialogue: 0,0:06:36.93,0:06:38.23,Default,,0,0,0,,Қорғаушыны қорғаңыз
Dialogue: 0,0:06:38.35,0:06:39.19,Default,,0,0,0,,Гюго!
Dialogue: 0,0:06:39.52,0:06:43.19,Default,,0,0,0,,Иә, өйткені сызық сирек болса, сіз ештеңе істей алмайсыз.
Dialogue: 0,0:06:43.31,0:06:44.15,Default,,0,0,0,,Фуго!
Dialogue: 0,0:06:44.94,0:06:48.11,Default,,0,0,0,,Осы уақытқа дейін өз бетімше ештеңе істей алмадым.
Dialogue: 0,0:06:48.28,0:06:51.36,Default,,0,0,0,,Ақыры бес досымыз бар.
Dialogue: 0,0:06:52.53,0:06:53.37,Default,,0,0,0,,Эххе
Dialogue: 0,0:06:55.41,0:06:56.70,Default,,0,0,0,,(Шырылдаған дыбыс)
Dialogue: 0,0:06:57.25,0:06:59.66,Default,,0,0,0,,Эхехе... Барлығымыз қолымыздан келгенін жасасақ
Dialogue: 0,0:06:59.79,0:07:02.88,Default,,0,0,0,,Күзде мықты сызық болатынына сенімдімін.
Dialogue: 0,0:07:05.00,0:07:05.84,Default,,0,0,0,,Гюго!
Dialogue: 0,0:07:06.21,0:07:07.05,Default,,0,0,0,,Гюго!
Dialogue: 0,0:07:08.38,0:07:12.18,Default,,0,0,0,,Ой, енді ойлап қарасам, екі пәлекет шығып жатыр екен.
Dialogue: 0,0:07:12.30,0:07:14.18,Default,,0,0,0,,Бұл негативтерді іздеуге мүмкіндік.
Dialogue: 0,0:07:14.30,0:07:15.30,Default,,0,0,0,,Керемет идея!
Dialogue: 0,0:07:15.43,0:07:16.26,Default,,0,0,0,,Біз барамыз ба?
Dialogue: 0,0:07:16.81,0:07:17.77,Default,,0,0,0,,Фуго!
Dialogue: 0,0:07:17.89,0:07:18.72,Default,,0,0,0,,Фуго?
Dialogue: 0,0:07:21.85,0:07:23.56,Default,,0,0,0,,Бөгде планетаның қарсыластары кімдер?
Dialogue: 0,0:07:24.40,0:07:27.32,Default,,0,0,0,,Күн сфинксі лотерея арқылы таңдалды.
Dialogue: 0,0:07:27.90,0:07:31.74,Default,,0,0,0,,Бірақ біз осындай электрондық хат алдық, Бас редактор.
Dialogue: 0,0:07:32.11,0:07:32.99,Default,,0,0,0,,Не ол?
Dialogue: 0,0:07:33.11,0:07:36.49,Default,,0,0,0,,«Қатаң лотереяның нәтижелері: X High-тің қарсыласы кім?»
Dialogue: 0,0:07:36.62,0:07:39.87,Default,,0,0,0,,«Ол Деймон Ібіліс Жарғанақтары ретінде керемет таңдалды».
Dialogue: 0,0:07:40.00,0:07:42.29,Default,,0,0,0,,«Құттықтаймыз Я-! Ха-!»
Dialogue: 0,0:07:42.42,0:07:44.88,Default,,0,0,0,,««Ай сайынғы американдық футбол» бас редакторы»
Dialogue: 0,0:07:45.00,0:07:47.21,Default,,0,0,0,,Мен... Мен ешқашан мұндай хат жіберген емеспін!
Dialogue: 0,0:07:47.34,0:07:50.47,Default,,0,0,0,,Мұны кім жариялады?
Dialogue: 0,0:07:50.59,0:07:53.05,Default,,0,0,0,,Мен бұл жерге сүлік шайтан кіріп кетеді деп ешқашан күтпедім...
Dialogue: 0,0:07:53.18,0:07:54.72,Default,,0,0,0,,Ауырды!
Dialogue: 0,0:07:54.84,0:07:57.18,Default,,0,0,0,,Бірақ, әрине, бізден
Dialogue: 0,0:07:57.31,0:07:59.02,Default,,0,0,0,,Мм... Бас редактор (Бас редактор) А?
Dialogue: 0,0:07:59.60,0:08:01.85,Default,,0,0,0,,Саған жібергенім рас.
Dialogue: 0,0:08:01.98,0:08:03.69,Default,,0,0,0,,Шақыру жазбасына жазылды.
Dialogue: 0,0:08:03.81,0:08:06.81,Default,,0,0,0,,Не... не! Не болып жатыр?
Dialogue: 0,0:08:07.82,0:08:08.73,Default,,0,0,0,,Ақымақ...
Dialogue: 0,0:08:08.86,0:08:11.74,Default,,0,0,0,,Мен Таййоны серіктес мектебім ретінде басынан бастап шештім.
Dialogue: 0,0:08:11.86,0:08:13.74,Default,,0,0,0,,Жарайды, мен басынан шештім.
Dialogue: 0,0:08:13.86,0:08:14.70,Default,,0,0,0,,Қатынасты үзу ме? Қатынасты үзу... Хе-хе-хе-хе.
Dialogue: 0,0:08:15.16,0:08:16.41,Default,,0,0,0,,Күтілгендей.
Dialogue: 0,0:08:16.53,0:08:19.29,Default,,0,0,0,,Қатаң лотерея жалған болды ма?
Dialogue: 0,0:08:19.41,0:08:20.24,Default,,0,0,0,,Осы шөлдеген таулардың тереңінде—
Dialogue: 0,0:08:22.87,0:08:23.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:23.87,0:08:24.92,Default,,0,0,0,,Бас редактор
Dialogue: 0,0:08:25.04,0:08:26.17,Default,,0,0,0,,Уф, Харао-кун!
Dialogue: 0,0:08:26.83,0:08:29.92,Default,,0,0,0,,Мен шетелдіктермен ойынды талқылауға келдім.
Dialogue: 0,0:08:30.05,0:08:31.17,Default,,0,0,0,,Уф аа
Dialogue: 0,0:08:31.76,0:08:33.34,Default,,0,0,0,,Иә? (Курита) А... бұл...
Dialogue: 0,0:08:33.72,0:08:35.80,Default,,0,0,0,,Күн сфинксінің Бамба мырзасы!
Dialogue: 0,0:08:39.97,0:08:41.68,Default,,0,0,0,,Уф, жоқ, бұл...
Dialogue: 0,0:08:41.81,0:08:43.77,Default,,0,0,0,,Бұл жат планеталықтардың қарсыласы.
Dialogue: 0,0:08:43.89,0:08:46.19,Default,,0,0,0,,Біз Deimon Devil Bats болуды шештік.
Dialogue: 0,0:08:46.31,0:08:47.65,Default,,0,0,0,,Уау... (сүлік жын)
Dialogue: 0,0:08:47.77,0:08:49.40,Default,,0,0,0,,Үйге қайтыңыз.
Dialogue: 0,0:08:49.82,0:08:52.36,Default,,0,0,0,,Не? (Касаматсу) Не? Сәлем
Dialogue: 0,0:08:52.69,0:08:53.53,Default,,0,0,0,,Хун
Dialogue: 0,0:08:53.95,0:08:55.28,Default,,0,0,0,,Уау~ (Сілік жын) Хэхехе~
Dialogue: 0,0:08:55.99,0:08:58.57,Default,,0,0,0,,Шындығында, қандай да бір себептермен, Deimon Devil Bats
Dialogue: 0,0:08:58.70,0:09:01.54,Default,,0,0,0,,Маған бәсекелес мектеп ретінде таңдалғаным туралы электрондық хат келді.
Dialogue: 0,0:09:01.87,0:09:03.79,Default,,0,0,0,,Мұны елемеңіз.
Dialogue: 0,0:09:03.91,0:09:06.79,Default,,0,0,0,,Қарсыласымыз біз боламыз деп әу бастан шешілді.
Dialogue: 0,0:09:06.92,0:09:08.75,Default,,0,0,0,,Уау~ Тынш~ Тынш~
Dialogue: 0,0:09:09.92,0:09:12.09,Default,,0,0,0,,Қатысушы - Деймон.
Dialogue: 0,0:09:12.21,0:09:15.47,Default,,0,0,0,,Туған жеріңе қайтып, күнге қыздырын.
Dialogue: 0,0:09:15.80,0:09:17.47,Default,,0,0,0,,Сәлем... сүлгі жын
Dialogue: 0,0:09:17.76,0:09:21.76,Default,,0,0,0,,Балшық қақпасының қоқысы! Жеңіске жетуге ешқандай мүмкіндік жоқ
Dialogue: 0,0:09:21.89,0:09:23.10,Default,,0,0,0,,Жапонияға ұят!
Dialogue: 0,0:09:23.39,0:09:24.56,Default,,0,0,0,,Хаха~
Dialogue: 0,0:09:24.68,0:09:27.19,Default,,0,0,0,,Бұл сенің бізден күшті екеніңді білдіре ме?
Dialogue: 0,0:09:27.48,0:09:28.77,Default,,0,0,0,,Бұл хит!
Dialogue: 0,0:09:28.90,0:09:31.32,Default,,0,0,0,,Сіз менің командамды жеңе аласыз деп ойлайсыз ба?
Dialogue: 0,0:09:31.73,0:09:34.28,Default,,0,0,0,,Олай болса, жасап көрейік.
Dialogue: 0,0:09:34.65,0:09:36.61,Default,,0,0,0,,Жапония өкілі шешуші матчта!
Dialogue: 0,0:09:44.37,0:09:46.25,Default,,0,0,0,,Боқ~ Мен оны таба алмаймын.
Dialogue: 0,0:09:46.37,0:09:48.08,Default,,0,0,0,,Оны қайда жасырдың?
Dialogue: 0,0:09:48.96,0:09:49.79,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:49.92,0:09:51.25,Default,,0,0,0,,Фуго! (3 адам) Уау
Dialogue: 0,0:09:51.67,0:09:52.63,Default,,0,0,0,,(Көрермен) Мен оны мінген күйдегі шайқасқа дейін қызықты жігіт деп ойладым…
Dialogue: 0,0:09:52.75,0:09:54.80,Default,,0,0,0,,Фугор... Жаттығу!
Dialogue: 0,0:09:55.05,0:09:57.47,Default,,0,0,0,,Уф!
Dialogue: 0,0:09:57.88,0:09:59.43,Default,,0,0,0,,Оны жалама! (Куроки) Уау!
Dialogue: 0,0:09:59.55,0:10:00.39,Default,,0,0,0,,Гюго!
Dialogue: 0,0:10:00.85,0:10:01.85,Default,,0,0,0,,Ой... уф
Dialogue: 0,0:10:01.97,0:10:04.02,Default,,0,0,0,,Фугок тәжірибесі!
Dialogue: 0,0:10:04.14,0:10:07.64,Default,,0,0,0,,Сен бейбақ! Kuroki Help (Komusubi) Fugo Fugo...
Dialogue: 0,0:10:08.52,0:10:10.77,Default,,0,0,0,,Джумонджи қазір! Оны қағып алыңыз
Dialogue: 0,0:10:13.82,0:10:16.15,Default,,0,0,0,,Боқ~ Бұл ақымақ күш...
Dialogue: 0,0:10:17.99,0:10:19.53,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:20.11,0:10:23.33,Default,,0,0,0,,Мені талай рет мазақ еттің.
Dialogue: 0,0:10:24.20,0:10:25.79,Default,,0,0,0,,Куу…
Dialogue: 0,0:10:26.37,0:10:27.50,Default,,0,0,0,,Фуго…
Dialogue: 0,0:10:28.21,0:10:31.50,Default,,0,0,0,,Үш адам болмаса жеңе алмайсың... Фуго!
Dialogue: 0,0:10:31.63,0:10:32.46,Default,,0,0,0,,Не!
Dialogue: 0,0:10:33.42,0:10:35.00,Default,,0,0,0,,Комусуби, кешігіп қалдың.
Dialogue: 0,0:10:35.13,0:10:38.22,Default,,0,0,0,,Хмм, қарап көрейін.
Dialogue: 0,0:10:41.26,0:10:42.09,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:10:42.22,0:10:43.35,Default,,0,0,0,,Һм. Менің немерем сәл қатал сыншы екен, иә?
Dialogue: 0,0:10:50.60,0:10:52.52,Default,,0,0,0,,Әй, не болды? (Тоноха) Джумонжи!
Dialogue: 0,0:10:53.77,0:10:55.02,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:10:55.15,0:10:56.28,Default,,0,0,0,,Енді ұрыспауға тырысайық.
Dialogue: 0,0:10:57.53,0:10:58.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:58.78,0:11:00.61,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:11:01.57,0:11:02.66,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:11:02.78,0:11:03.99,Default,,0,0,0,,Қайтару (Тоно) Е...
Dialogue: 0,0:11:04.37,0:11:05.45,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:05.58,0:11:07.45,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:11:07.75,0:11:09.29,Default,,0,0,0,,Фотосуретпен не істеуім керек?
Dialogue: 0,0:11:09.41,0:11:11.42,Default,,0,0,0,,Сіз білесіз бе! (Тоноха) Сіз білесіз бе? Эй...
Dialogue: 0,0:11:11.96,0:11:13.96,Default,,0,0,0,,(Сена мен Монтаның ауыр тыныс алуы)
Dialogue: 0,0:11:14.09,0:11:16.67,Default,,0,0,0,,Ах, а... (Монта) О... және
Dialogue: 0,0:11:18.76,0:11:20.38,Default,,0,0,0,,А... у... қайда?
Dialogue: 0,0:11:21.05,0:11:22.47,Default,,0,0,0,,Отставкаға кету (Сена Монта) Иә!
Dialogue: 0,0:11:22.59,0:11:23.84,Default,,0,0,0,,Мен жұмыстан шығамын.
Dialogue: 0,0:11:23.97,0:11:25.81,Default,,0,0,0,,Жаттығу дегеніміз не?
Dialogue: 0,0:11:25.93,0:11:28.81,Default,,0,0,0,,Жалпы айтқанда, мен басынан бастап ынталы емеспін.
Dialogue: 0,0:11:28.93,0:11:30.23,Default,,0,0,0,,Сүлік жынға айтар сөзің болса, айт.
Dialogue: 0,0:11:30.48,0:11:32.10,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:11:36.65,0:11:37.53,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:43.70,0:11:46.91,Default,,0,0,0,,Егер сіз мотивацияны сезінсеңіз, қайтер едіңіз?
Dialogue: 0,0:11:48.33,0:11:50.20,Default,,0,0,0,,Барлығы мәңгілік күтті
Dialogue: 0,0:11:50.75,0:11:52.62,Default,,0,0,0,,Әсіресе Курита...
Dialogue: 0,0:11:55.17,0:11:56.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:56.42,0:11:58.21,Default,,0,0,0,,
Dialogue: 0,0:12:03.38,0:12:04.22,Default,,0,0,0,,Хаха…
Dialogue: 0,0:12:04.59,0:12:05.85,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:12:05.97,0:12:08.56,Default,,0,0,0,,Ол жігіттер өз бетімен жұмысты тастады.
Dialogue: 0,0:12:08.81,0:12:13.02,Default,,0,0,0,,Қараңызшы, мен сізге әу бастан мотивация болмағанымды айттым.
Dialogue: 0,0:12:13.27,0:12:14.52,Default,,0,0,0,,Бұл шынымен рас па?
Dialogue: 0,0:12:14.65,0:12:15.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:15.60,0:12:17.48,Default,,0,0,0,,Өйткені қарақшылар соғысы кезінде
Dialogue: 0,0:12:18.19,0:12:20.53,Default,,0,0,0,,Ол кезде бәрі көңілді болған сияқты.
Dialogue: 0,0:12:20.65,0:12:23.20,Default,,0,0,0,,Ал... Жарайды, ол кезде мен сенімдімін...
Dialogue: 0,0:12:23.78,0:12:25.53,Default,,0,0,0,,Америка футболы қызық.
Dialogue: 0,0:12:25.87,0:12:27.95,Default,,0,0,0,,Тіпті сол адамдар жүре берсе
Dialogue: 0,0:12:28.08,0:12:30.33,Default,,0,0,0,,Америка футболының тартымдылығын түсіне алатыныңызға сенімдімін.
Dialogue: 0,0:12:30.45,0:12:31.29,Default,,0,0,0,,Жақсы
Dialogue: 0,0:12:31.58,0:12:34.46,Default,,0,0,0,,Мен де американдық футболды қызық көрдім.
Dialogue: 0,0:12:34.58,0:12:36.00,Default,,0,0,0,,Енді түсіндім
Dialogue: 0,0:12:37.17,0:12:38.00,Default,,0,0,0,,Сенна!
Dialogue: 0,0:12:39.13,0:12:41.55,Default,,0,0,0,,Фуго Менің жауапкершілігім
Dialogue: 0,0:12:43.05,0:12:43.92,Default,,0,0,0,,Фугоцу
Dialogue: 0,0:12:44.05,0:12:46.68,Default,,0,0,0,,А, Комусуби-кун, жақсысың ба?
Dialogue: 0,0:12:47.80,0:12:49.64,Default,,0,0,0,,Ах... уау~
Dialogue: 0,0:12:50.01,0:12:52.43,Default,,0,0,0,,Жапония өкілінің кездесуі анықталды!
Dialogue: 0,0:12:52.77,0:12:55.39,Default,,0,0,0,,Жапония құрамасы шешуші матч?
Dialogue: 0,0:13:02.23,0:13:04.15,Default,,0,0,0,,Жау – күн сфинксі.
Dialogue: 0,0:13:04.70,0:13:06.03,Default,,0,0,0,,Сфинкс
Dialogue: 0,0:13:06.16,0:13:08.82,Default,,0,0,0,,Олар күшті команда, олардың сату нүктесі сызық болып табылады.
Dialogue: 0,0:13:09.16,0:13:10.91,Default,,0,0,0,,Бізді жеңе аласың ба...
Dialogue: 0,0:13:11.24,0:13:13.66,Default,,0,0,0,,Әй, қорықпа, шошқа.
Dialogue: 0,0:13:13.83,0:13:14.87,Default,,0,0,0,,Уау~
Dialogue: 0,0:13:15.00,0:13:17.58,Default,,0,0,0,,Сондай-ақ сызықты ақылмен пайдалануға болады.
Dialogue: 0,0:13:17.71,0:13:19.08,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:13:19.50,0:13:20.79,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:13:20.92,0:13:23.88,Default,,0,0,0,,Мұнда да қатардағы бес мүше ақыры бірге.
Dialogue: 0,0:13:24.13,0:13:27.51,Default,,0,0,0,,Хмм? Айтпақшы, үш ағайынды не болды?
Dialogue: 0,0:13:27.64,0:13:28.47,Default,,0,0,0,,Уау~
Dialogue: 0,0:13:28.72,0:13:31.47,Default,,0,0,0,,Жарайды... болды...
Dialogue: 0,0:13:31.60,0:13:34.68,Default,,0,0,0,,Мм, мен бүгін жаттығуға келген жоқпын.
Dialogue: 0,0:13:35.89,0:13:36.94,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:39.02,0:13:39.86,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:13:39.98,0:13:42.11,Default,,0,0,0,,Олар ертең шықпайды.
Dialogue: 0,0:13:42.69,0:13:44.32,Default,,0,0,0,,Мен сізді қандай да бір жолмен сендіруге тырысамын.
Dialogue: 0,0:13:44.44,0:13:45.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:45.44,0:13:47.07,Default,,0,0,0,,Сена Жақсысың ба?
Dialogue: 0,0:13:47.61,0:13:50.95,Default,,0,0,0,,Хэхе... Мамори-нечан, уайымдама.
Dialogue: 0,0:13:51.41,0:13:53.66,Default,,0,0,0,,Бұл да менің бақылаушы ретіндегі жұмысым.
Dialogue: 0,0:13:53.79,0:13:54.83,Default,,0,0,0,,Сенна…
Dialogue: 0,0:13:56.50,0:14:00.08,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:14:05.30,0:14:07.93,Default,,0,0,0,,
Dialogue: 0,0:14:08.55,0:14:09.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:10.05,0:14:11.05,Default,,0,0,0,,(Цубаки мен Ватару) Оның мойын арты! Қандай аппақ тері! (Медбике) Есікті алдымен қағып ал!
Dialogue: 0,0:14:13.35,0:14:14.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:15.06,0:14:16.85,Default,,0,0,0,,Фугот, клубқа қайта кел!
Dialogue: 0,0:14:16.98,0:14:18.56,Default,,0,0,0,,Иә? (Тоноха) Эй!
Dialogue: 0,0:14:21.52,0:14:22.73,Default,,0,0,0,,Комусуби-кун
Dialogue: 0,0:14:23.07,0:14:24.48,Default,,0,0,0,,Жартылай ұйықтап қалмаңыз
Dialogue: 0,0:14:24.61,0:14:27.24,Default,,0,0,0,,Біз клубтан шықтық! Біз клубтан кеттік!
Dialogue: 0,0:14:28.65,0:14:30.70,Default,,0,0,0,,Гугот... өтінемін!
Dialogue: 0,0:14:30.82,0:14:32.07,Default,,0,0,0,,Тәртіпке бер, мені жібер!
Dialogue: 0,0:14:33.28,0:14:34.12,Default,,0,0,0,,Фуго…
Dialogue: 0,0:14:34.24,0:14:36.29,Default,,0,0,0,,Комусуби-кун, жақсысың ба?
Dialogue: 0,0:14:36.66,0:14:40.29,Default,,0,0,0,,А... клубтан кетуді қайта қарастыра аласыз ба?
Dialogue: 0,0:14:40.54,0:14:43.13,Default,,0,0,0,,Не? Ол Чибидебудан кейін жауапты ма?
Dialogue: 0,0:14:44.04,0:14:47.88,Default,,0,0,0,,Жапония құрамасының Күн Сфинксіне қарсы шешуші ойыны анықталды.
Dialogue: 0,0:14:48.26,0:14:51.39,Default,,0,0,0,,Ібіліс жарғанақтарына мықты сызық керек.
Dialogue: 0,0:14:51.64,0:14:54.85,Default,,0,0,0,,Тағы бірге американдық футбол ойнаймыз
Dialogue: 0,0:14:55.31,0:14:58.81,Default,,0,0,0,,Сізге ыңғайлы болу үшін бізді қайтадан американдық футбол ойнауға мәжбүрлейсіз бе?
Dialogue: 0,0:14:59.27,0:15:01.31,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:15:01.44,0:15:04.19,Default,,0,0,0,,Жоқ, мүмкін, балалар.
Dialogue: 0,0:15:04.32,0:15:05.94,Default,,0,0,0,,Менің ойымша, сізге американдық футбол ұнайды...
Dialogue: 0,0:15:06.19,0:15:09.07,Default,,0,0,0,,Иә? Бізге американдық футбол ұнайды ма?
Dialogue: 0,0:15:09.19,0:15:11.66,Default,,0,0,0,,Ахахах... бұл мені күлдіреді
Dialogue: 0,0:15:12.11,0:15:16.12,Default,,0,0,0,,Өйткені балалар Кикугакусен кезінде өте көңілді болған сияқты болдыңдар.
Dialogue: 0,0:15:16.41,0:15:17.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:28.30,0:15:29.51,Default,,0,0,0,,Кеттік (Тоноха/Куроки) Ия...
Dialogue: 0,0:15:30.09,0:15:31.09,Default,,0,0,0,,Ба-ка
Dialogue: 0,0:15:31.34,0:15:33.14,Default,,0,0,0,,Ешқашан бетіңізді көрсетпеңіз
Dialogue: 0,0:15:41.64,0:15:42.52,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз... (Бэмба) Иә?
Dialogue: 0,0:15:42.65,0:15:43.48,Default,,0,0,0,,Кя~
Dialogue: 0,0:15:43.94,0:15:47.02,Default,,0,0,0,,Бірақ сол бас редактордың бөлімдері нашар.
Dialogue: 0,0:15:47.48,0:15:48.98,Default,,0,0,0,,Бұл рас~
Dialogue: 0,0:15:49.11,0:15:51.90,Default,,0,0,0,,Мен ойнауға міндетті емес ойынды ойнау керек болды.
Dialogue: 0,0:15:52.03,0:15:54.74,Default,,0,0,0,,Ал, қарсылас Деймон, жеңіл жеңіс.
Dialogue: 0,0:15:54.87,0:15:56.99,Default,,0,0,0,,Дұрыс, Шишиши...
Dialogue: 0,0:15:57.62,0:15:59.08,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:16:02.62,0:16:05.00,Default,,0,0,0,,Уау, бұл үлкен сумо балуаны ма?
Dialogue: 0,0:16:05.13,0:16:06.38,Default,,0,0,0,,Куритаға ұқсайды
Dialogue: 0,0:16:10.71,0:16:13.18,Default,,0,0,0,,Өкіл Хабашира мен менің компаниям бір-бірімен тығыз байланысты емес.
Dialogue: 0,0:16:13.30,0:16:14.13,Default,,0,0,0,,Жапырақ стилі?
Dialogue: 0,0:16:14.80,0:16:17.85,Default,,0,0,0,,Бір күні сол жерде ұлы Деймонмен матч болды...
Dialogue: 0,0:16:18.51,0:16:23.14,Default,,0,0,0,,Ібіліс жарғанаттарының 51 52 53 жолдары ақымақ сияқты.
Dialogue: 0,0:16:23.27,0:16:24.10,Default,,0,0,0,,Ха? (Джумонджи) Иә?
Dialogue: 0,0:16:24.23,0:16:25.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:25.19,0:16:29.32,Default,,0,0,0,,Ссссссссссссссссссссссссссссс.
Dialogue: 0,0:16:29.86,0:16:33.20,Default,,0,0,0,,Ештеңе етпейді, біз өз мүмкіндігімізбен жеңеміз.
Dialogue: 0,0:16:34.07,0:16:34.91,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:35.11,0:16:38.91,Default,,0,0,0,,Бос емес. Кешіріңіз, бірақ 51 саны мен.
Dialogue: 0,0:16:39.03,0:16:41.25,Default,,0,0,0,,Қоқыс кім? Мына қара гаппа!
Dialogue: 0,0:16:46.38,0:16:48.38,Default,,0,0,0,,Сіз маған маскаңызды бере аласыз ба?
Dialogue: 0,0:16:49.34,0:16:50.59,Default,,0,0,0,,Маған жарқанат керек емес (Куроки) Ух...
Dialogue: 0,0:16:51.30,0:16:53.55,Default,,0,0,0,,Мен бұл жігіттерді күшпен түсіремін.
Dialogue: 0,0:16:55.30,0:16:57.76,Default,,0,0,0,,Бамба Оны 1 минутта тазалаңыз.
Dialogue: 0,0:16:58.14,0:17:00.85,Default,,0,0,0,,Хмф, бір минут тым ұзақ.
Dialogue: 0,0:17:03.39,0:17:06.10,Default,,0,0,0,,Ертең сізді тағы да сендіруге тырысайық.
Dialogue: 0,0:17:06.56,0:17:07.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:11.32,0:17:12.36,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:12.94,0:17:13.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:13.99,0:17:17.03,Default,,0,0,0,,(Шыны сынып жатқан дыбыс)
Dialogue: 0,0:17:17.91,0:17:20.78,Default,,0,0,0,,Өте жаман. Ол жігіт шынымен ақылынан адасып бара жатыр.
Dialogue: 0,0:17:21.16,0:17:22.75,Default,,0,0,0,,Дәл 10 секунд?
Dialogue: 0,0:17:23.16,0:17:25.71,Default,,0,0,0,,Уф... Шіркін...
Dialogue: 0,0:17:25.96,0:17:29.29,Default,,0,0,0,,Сен тым кішкентайсың, қымбаттым. Бұл әлі де сызық па?
Dialogue: 0,0:17:29.42,0:17:30.79,Default,,0,0,0,,Сіз мұны әлі де жасайсыз ба?
Dialogue: 0,0:17:30.96,0:17:33.67,Default,,0,0,0,,Мен сізге нағыз блокатордың не екенін көрсетемін.
Dialogue: 0,0:17:34.63,0:17:35.80,Default,,0,0,0,,Блокатор?
Dialogue: 0,0:17:36.68,0:17:41.39,Default,,0,0,0,,Блокаторды итергенде, қарсыластың бүйірін жоғары итеріңіз.
Dialogue: 0,0:17:41.51,0:17:43.60,Default,,0,0,0,,Фуннураба! (3 адам) Уау!
Dialogue: 0,0:17:45.14,0:17:47.27,Default,,0,0,0,,Ооо!
Dialogue: 0,0:17:48.35,0:17:49.40,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:49.52,0:17:50.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:50.77,0:17:51.65,Default,,0,0,0,,Уф
Dialogue: 0,0:17:51.77,0:17:53.03,Default,,0,0,0,,Хмф! (Джумонжи) Уау...
Dialogue: 0,0:17:53.65,0:17:55.90,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:17:56.32,0:17:57.61,Default,,0,0,0,,Шишиши…
Dialogue: 0,0:17:57.74,0:18:00.49,Default,,0,0,0,,Баршаңдар, мынаны есте сақтаңдар.
Dialogue: 0,0:18:00.62,0:18:02.66,Default,,0,0,0,,Бұл менің Сфинксімнің күші.
Dialogue: 0,0:18:04.33,0:18:06.62,Default,,0,0,0,,Бір сәт менің күшім күшейе түсті.
Dialogue: 0,0:18:07.12,0:18:08.08,Default,,0,0,0,,Міне, кеттік
Dialogue: 0,0:18:08.21,0:18:11.59,Default,,0,0,0,,Қоқыс тым-тырыс.
Dialogue: 0,0:18:14.59,0:18:15.63,Default,,0,0,0,,Хмм... Ах!
Dialogue: 0,0:18:16.09,0:18:17.97,Default,,0,0,0,,Бұл... Жақсысың ба?
Dialogue: 0,0:18:18.51,0:18:19.47,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:18:19.59,0:18:20.43,Default,,0,0,0,,Ах
Dialogue: 0,0:18:20.80,0:18:23.81,Default,,0,0,0,,Сонда сен қорқынышты тү көріпсің ғой.
Dialogue: 0,0:18:24.77,0:18:26.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:27.10,0:18:28.44,Default,,0,0,0,,Сонымен... бірақ бұл жарақат
Dialogue: 0,0:18:28.56,0:18:29.69,Default,,0,0,0,,Шу!
Dialogue: 0,0:18:29.94,0:18:32.77,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:18:39.45,0:18:41.70,Default,,0,0,0,,Біз аяныштымыз.
Dialogue: 0,0:18:41.95,0:18:43.03,Default,,0,0,0,,Шулы
Dialogue: 0,0:18:46.29,0:18:48.16,Default,,0,0,0,,Сена Қалай болды?
Dialogue: 0,0:18:48.33,0:18:49.16,Default,,0,0,0,,Иә...
Dialogue: 0,0:18:49.58,0:18:50.71,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:50.83,0:18:53.75,Default,,0,0,0,,Мен бізде барлық лайнерлер бар деп ойладым.
Dialogue: 0,0:18:53.88,0:18:55.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:55.50,0:18:56.34,Default,,0,0,0,,Хаа…
Dialogue: 0,0:18:56.46,0:18:57.76,Default,,0,0,0,,Ой
Dialogue: 0,0:18:57.88,0:18:59.63,Default,,0,0,0,,Қайтып келмейтін жігіт ше?
Dialogue: 0,0:18:59.76,0:19:01.64,Default,,0,0,0,,Шағымданбаңыз!
Dialogue: 0,0:19:01.76,0:19:02.59,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:02.72,0:19:04.81,Default,,0,0,0,,Жаттығу! Сора, жүгір!
Dialogue: 0,0:19:04.93,0:19:05.97,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:06.56,0:19:07.39,Default,,0,0,0,,Tsk
Dialogue: 0,0:19:07.93,0:19:09.39,Default,,0,0,0,,Фуго Фуго
Dialogue: 0,0:19:09.64,0:19:10.77,Default,,0,0,0,,Фуго!
Dialogue: 0,0:19:12.52,0:19:13.44,Default,,0,0,0,,Фугоцу
Dialogue: 0,0:19:15.23,0:19:16.32,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:19:16.69,0:19:18.65,Default,,0,0,0,,Саптық шайқаста қалай жеңуге болады?
Dialogue: 0,0:19:18.78,0:19:19.74,Default,,0,0,0,,Фуго?
Dialogue: 0,0:19:28.95,0:19:29.91,Default,,0,0,0,,Фуго~
Dialogue: 0,0:19:30.21,0:19:32.17,Default,,0,0,0,,Гугу... Сен қайтып келдің...
Dialogue: 0,0:19:32.29,0:19:33.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:33.92,0:19:34.88,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:35.50,0:19:38.01,Default,,0,0,0,,Әрдайым жоғалту хобби емес!
Dialogue: 0,0:19:39.88,0:19:45.89,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:20:48.87,0:20:54.87,Default,,0,0,0,,~♪
Dialogue: 0,0:20:55.71,0:20:58.59,Default,,0,0,0,,Жеңілуді жалғастыра беру хобби емес.
Dialogue: 0,0:20:58.71,0:21:01.51,Default,,0,0,0,,Шешім қабылдағаныма қуаныштымын, бірақ қарсылас – мықты қарсылас!
Dialogue: 0,0:21:01.63,0:21:04.01,Default,,0,0,0,,Курита мырзаға, Сфинкстің пирамида сызығында
Dialogue: 0,0:21:04.13,0:21:05.47,Default,,0,0,0,,Төңкерілу үшін...
Dialogue: 0,0:21:05.59,0:21:08.26,Default,,0,0,0,,Бұл жерде сіз өз шешіміңізді көрсетесіз.
Dialogue: 0,0:21:08.39,0:21:10.72,Default,,0,0,0,,Келесі жолы «Көз қалқаны 21»
Dialogue: 0,0:21:13.23,0:21:14.69,Default,,0,0,0,,Я-! Ха-!
Dialogue: 0,0:21:16.19,0:21:22.19,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory