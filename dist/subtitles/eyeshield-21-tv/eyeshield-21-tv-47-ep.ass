Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.29,0:00:08.88,Default,,0,0,0,,Жарайды, 2-тур
Dialogue: 0,0:00:09.00,0:00:11.59,Default,,0,0,0,,Бұл Юухи Гуцқа қарсы кездесу.
Dialogue: 0,0:00:11.97,0:00:16.39,Default,,0,0,0,,Мм, сен неге мұндай жерде бұлай істеп жүрсің?
Dialogue: 0,0:00:18.51,0:00:20.43,Default,,0,0,0,,Керемет, күннің батуы
Dialogue: 0,0:00:20.56,0:00:21.81,Default,,0,0,0,,Фуго
Dialogue: 0,0:00:22.06,0:00:22.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:22.89,0:00:24.44,Default,,0,0,0,,Күш-жігер, шыдамдылық, шыдамдылық...
Dialogue: 0,0:00:24.56,0:00:27.31,Default,,0,0,0,,Ах... (Монта) Иә? Не?
Dialogue: 0,0:00:27.81,0:00:28.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:29.19,0:00:30.32,Default,,0,0,0,,А, бұл
Dialogue: 0,0:00:30.57,0:00:31.61,Default,,0,0,0,,Еңбек, шыдам, шыдамдылық!
Dialogue: 0,0:00:31.74,0:00:32.36,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:00:32.49,0:00:33.49,Default,,0,0,0,,Еңбек, шыдам, шыдамдылық!
Dialogue: 0,0:00:33.61,0:00:34.28,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:00:34.40,0:00:35.49,Default,,0,0,0,,Еңбек, шыдам, шыдамдылық!
Dialogue: 0,0:00:35.61,0:00:36.24,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:00:36.36,0:00:37.49,Default,,0,0,0,,Еңбек, шыдам, шыдамдылық!
Dialogue: 0,0:00:37.62,0:00:38.24,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:00:39.78,0:00:41.29,Default,,0,0,0,,Қазіргі уақытта...
Dialogue: 0,0:00:41.41,0:00:42.70,Default,,0,0,0,,Белдік...
Dialogue: 0,0:00:43.25,0:00:44.08,Default,,0,0,0,,Яғни
Dialogue: 0,0:00:44.21,0:00:46.62,Default,,0,0,0,,Е, Сатаке-кун, сен бірдеңе білесің бе?
Dialogue: 0,0:00:46.75,0:00:50.63,Default,,0,0,0,,О, құдай-ау... бұл гүлдену.
Dialogue: 0,0:00:50.75,0:00:54.51,Default,,0,0,0,,Жапонияда мұндай орта мектептер әлі де бар.
Dialogue: 0,0:00:54.63,0:00:55.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:56.43,0:00:59.35,Default,,0,0,0,,Алдыңғы жағында жүгіріп келе жатқан басты адам.
Dialogue: 0,0:01:00.01,0:01:01.18,Default,,0,0,0,,Кеймен?
Dialogue: 0,0:01:02.52,0:01:03.14,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:01:03.27,0:01:04.27,Default,,0,0,0,,Еңбек, шыдам, шыдамдылық!
Dialogue: 0,0:01:04.39,0:01:05.02,Default,,0,0,0,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,0:01:05.14,0:01:06.19,Default,,0,0,0,,Еңбек, шыдам, шыдамдылық!
Dialogue: 0,0:01:06.31,0:01:06.94,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:01:08.15,0:01:09.48,Default,,0,0,0,,Юхи Гуц
Dialogue: 0,0:01:10.15,0:01:12.36,Default,,0,0,0,,Екінші раундтағы қарсыласымыз
Dialogue: 0,0:01:13.07,0:01:18.07,Default,,0,0,0,,♪~
Dialogue: 0,0:02:30.31,0:02:35.32,Default,,0,0,0,,~♪
Dialogue: 0,0:02:42.07,0:02:44.33,Default,,0,0,0,,Жүр! Күннің батуы Гатс!
Dialogue: 0,0:02:44.45,0:02:45.66,Default,,0,0,0,,Еңбек, шыдам, шыдамдылық!
Dialogue: 0,0:02:45.79,0:02:46.41,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:02:46.54,0:02:47.66,Default,,0,0,0,,Еңбек, шыдам, сабыр!
Dialogue: 0,0:02:47.79,0:02:48.75,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:02:49.83,0:02:52.33,Default,,0,0,0,,Бұл адамдар сіздің екінші раундтағы қарсыластарыңыз ба?
Dialogue: 0,0:02:52.54,0:02:54.59,Default,,0,0,0,,Жағажайда марафон жүгіру?
Dialogue: 0,0:02:54.71,0:02:55.88,Default,,0,0,0,,Ооооо
Dialogue: 0,0:02:56.00,0:02:59.09,Default,,0,0,0,,Құмарсың, жассың.
Dialogue: 0,0:02:59.51,0:03:02.05,Default,,0,0,0,,Бұл менің аяғым мен жамбасымды ауыртатын сияқты.
Dialogue: 0,0:03:03.14,0:03:06.31,Default,,0,0,0,,Юхи Гуц қаншалықты күшті?
Dialogue: 0,0:03:06.85,0:03:10.27,Default,,0,0,0,,«Ай сайынғы американдық футбол» бұл D дәрежелі екенін айтты.
Dialogue: 0,0:03:10.89,0:03:14.15,Default,,0,0,0,,Юхидің әскери күшіне объективті қарау
Dialogue: 0,0:03:14.27,0:03:17.23,Default,,0,0,0,,Деймонның ұту көрсеткіші 99%.
Dialogue: 0,0:03:17.78,0:03:18.99,Default,,0,0,0,,Жақсы
Dialogue: 0,0:03:19.11,0:03:20.03,Default,,0,0,0,,Фуго
Dialogue: 0,0:03:20.15,0:03:22.11,Default,,0,0,0,,Бұл сіздің бірінші қарсыласыңыз ба?
Dialogue: 0,0:03:22.24,0:03:23.45,Default,,0,0,0,,Бұл жеткілікті.
Dialogue: 0,0:03:27.33,0:03:30.33,Default,,0,0,0,,Сіз 1% жоғалтасыз.
Dialogue: 0,0:03:30.66,0:03:35.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:36.38,0:03:39.59,Default,,0,0,0,,Олар үш жыл бойы американдық футбол ойнады.
Dialogue: 0,0:03:40.22,0:03:43.26,Default,,0,0,0,,Егер бұл негізгі дайындықтың тығыздығы болса, сіз де жоғалта алмайсыз.
Dialogue: 0,0:03:43.38,0:03:45.80,Default,,0,0,0,,3 жылдық тәжірибе өте үлкен
Dialogue: 0,0:03:45.93,0:03:47.18,Default,,0,0,0,,Демалмаңыз!
Dialogue: 0,0:03:49.06,0:03:52.10,Default,,0,0,0,,Екеуің тұрасыңдар, жақын жерде емессіңдер ме?
Dialogue: 0,0:03:52.23,0:03:55.61,Default,,0,0,0,,Мен енді мұны істей алмаймын. Мен өз шегімдемін.
Dialogue: 0,0:03:55.73,0:03:59.07,Default,,0,0,0,,Бізді артта қалдырыңыз...
Dialogue: 0,0:04:00.82,0:04:03.40,Default,,0,0,0,,Балалар, ұмыттыңдар ма?
Dialogue: 0,0:04:03.61,0:04:06.53,Default,,0,0,0,,Менің арманым - Рождестволық ыдыста ойнау.
Dialogue: 0,0:04:07.33,0:04:08.99,Default,,0,0,0,,Мен ештеңені ұмытқан жоқпын.
Dialogue: 0,0:04:09.12,0:04:12.50,Default,,0,0,0,,Бірақ біз әрқашан аяғымызды сүйретеміз
Dialogue: 0,0:04:13.16,0:04:16.67,Default,,0,0,0,,Біз болмасақ жақсы болар еді...
Dialogue: 0,0:04:16.79,0:04:18.13,Default,,0,0,0,,А, осы ма?
Dialogue: 0,0:04:18.25,0:04:20.96,Default,,0,0,0,,Осы уақытқа дейін барлығы аянбай еңбек етті.
Dialogue: 0,0:04:27.97,0:04:30.06,Default,,0,0,0,,Капитан (жарлау дыбысы)
Dialogue: 0,0:04:30.18,0:04:30.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:31.31,0:04:33.89,Default,,0,0,0,,(тістің қысылған дыбысы)
Dialogue: 0,0:04:34.02,0:04:37.77,Default,,0,0,0,,Күннің батқанына бәрімізде батыл бар.
Dialogue: 0,0:04:38.98,0:04:42.03,Default,,0,0,0,,Біреусіз жақсы өмір сүретін бірде-бір адам жоқ!
Dialogue: 0,0:04:43.28,0:04:44.99,Default,,0,0,0,,Не! Гваааах!
Dialogue: 0,0:04:45.45,0:04:47.03,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:47.16,0:04:49.20,Default,,0,0,0,,Біз қателестік.
Dialogue: 0,0:04:49.33,0:04:50.87,Default,,0,0,0,,Түсінсеңіз...
Dialogue: 0,0:04:51.62,0:04:52.66,Default,,0,0,0,,Сонымен бірге Rohan деген жігіт те—
Dialogue: 0,0:04:52.79,0:04:54.00,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:04:54.12,0:04:55.25,Default,,0,0,0,,Сабыр!
Dialogue: 0,0:04:55.37,0:04:56.46,Default,,0,0,0,,Сабыр!
Dialogue: 0,0:04:59.25,0:05:03.01,Default,,0,0,0,,Кеттік! Барлығына арналған Рождестволық ыдыс
Dialogue: 0,0:05:03.13,0:05:04.17,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:04.38,0:05:06.05,Default,,0,0,0,,А... ыстық
Dialogue: 0,0:05:07.59,0:05:08.97,Default,,0,0,0,,Балалар...
Dialogue: 0,0:05:09.47,0:05:12.02,Default,,0,0,0,,Бұл Деймон орта мектебінің формасы ма?
Dialogue: 0,0:05:12.14,0:05:13.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:15.10,0:05:17.44,Default,,0,0,0,,Жоқ... жоқ, біз ештеңе емеспіз.
Dialogue: 0,0:05:17.56,0:05:19.81,Default,,0,0,0,,Сонымен... мен саған тыңшылық жасадым немесе сол сияқты.
Dialogue: 0,0:05:20.77,0:05:21.61,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:05:22.23,0:05:23.78,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:05:24.11,0:05:24.90,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:05:25.61,0:05:27.66,Default,,0,0,0,,Бұл Юухи Гуцтың капитаны Атами.
Dialogue: 0,0:05:28.24,0:05:32.24,Default,,0,0,0,,Соңғы кездері қызу талқыға түскен Деймон Ібіліс жарғанақтарымен күресу үлкен мәртебе.
Dialogue: 0,0:05:32.37,0:05:35.75,Default,,0,0,0,,Өкінбей, әділ, шаршы алаңға шығайық.
Dialogue: 0,0:05:35.87,0:05:37.37,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:05:38.00,0:05:41.13,Default,,0,0,0,,Күн батуы! (Юхи мүшелері) Ішінара!
Dialogue: 0,0:05:41.29,0:05:43.21,Default,,0,0,0,,Күш-жігер! (Юхи мүшелері) О!
Dialogue: 0,0:05:43.34,0:05:45.17,Default,,0,0,0,,Сабыр! (Юхи мүшелері) О!
Dialogue: 0,0:05:45.30,0:05:46.38,Default,,0,0,0,,Сабыр! О!
Dialogue: 0,0:05:46.51,0:05:50.05,Default,,0,0,0,,Керемет, бұл ыстық үш жылға созылды.
Dialogue: 0,0:05:50.18,0:05:53.43,Default,,0,0,0,,Бірақ егер үшінші курс студенті болса, істейтін ештеңе қалмады ма?
Dialogue: 0,0:05:53.60,0:05:57.23,Default,,0,0,0,,Түсіндім, бұл жыл сенің соңғы мүмкіндігің.
Dialogue: 0,0:06:03.94,0:06:05.78,Default,,0,0,0,,Ол керемет адам.
Dialogue: 0,0:06:05.90,0:06:08.70,Default,,0,0,0,,Өйткені, екінші ойынның бірінші күні.
Dialogue: 0,0:06:09.91,0:06:12.33,Default,,0,0,0,,Ең бастысы - патша сарайындағы шайқас.
Dialogue: 0,0:06:12.45,0:06:13.12,Default,,0,0,0,,Иә
Dialogue: 0,0:06:13.41,0:06:14.95,Default,,0,0,0,,Санкаку панктары⸺
Dialogue: 0,0:06:15.08,0:06:18.58,Default,,0,0,0,,Көктемгі турнирде біз Оджодан бір ұпай ғана қалып отырмыз.
Dialogue: 0,0:06:19.25,0:06:22.92,Default,,0,0,0,,Оджо қашып құтыла ма? Санкаку панктары кек қайтара ала ма?
Dialogue: 0,0:06:23.04,0:06:24.55,Default,,0,0,0,,Бұл назар аударарлық карта.
Dialogue: 0,0:06:27.13,0:06:30.26,Default,,0,0,0,,Мұны бәрі патша сарайын ескере отырып жасайды.
Dialogue: 0,0:06:30.80,0:06:31.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:33.14,0:06:35.97,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:06:36.81,0:06:39.39,Default,,0,0,0,,Батыс жабайы қарулы адамдар
Dialogue: 0,0:06:40.65,0:06:41.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:41.90,0:06:43.94,Default,,0,0,0,,Әй, Атами-сан
Dialogue: 0,0:06:44.48,0:06:45.82,Default,,0,0,0,,Балалар сендер де келдіңдер ме?
Dialogue: 0,0:06:46.15,0:06:51.53,Default,,0,0,0,,Кешіріңіз, бірақ Юхи жеңіп, қамалға қарсы күреседі, сондықтан бәрі.
Dialogue: 0,0:06:51.66,0:06:52.57,Default,,0,0,0,,О!
Dialogue: 0,0:06:52.70,0:06:55.70,Default,,0,0,0,,Жақында бірінші ойын басталады.
Dialogue: 0,0:06:56.66,0:07:00.29,Default,,0,0,0,,Король сарайы! Корольдік сарай! Корольдік сарай!
Dialogue: 0,0:07:00.42,0:07:03.58,Default,,0,0,0,,Король сарайы! Корольдік сарай! Корольдік сарай!
Dialogue: 0,0:07:04.34,0:07:05.42,Default,,0,0,0,,Сусумуға⸺
Dialogue: 0,0:07:05.55,0:07:08.09,Default,,0,0,0,,Ібіліс жарғанатының елесі жұмыс істемеді.
Dialogue: 0,0:07:16.81,0:07:21.10,Default,,0,0,0,,Оджо Ақ Рыцарлары қаншалықты дамыған?
Dialogue: 0,0:07:22.44,0:07:26.90,Default,,0,0,0,,Көктемгі турнирден бері болды. Сізге көп рахмет.
Dialogue: 0,0:07:27.02,0:07:27.98,Default,,0,0,0,,Мен де солай.
Dialogue: 0,0:07:28.19,0:07:30.95,Default,,0,0,0,,Бұл бір ұпайлық айырмашылық әлі де күмәнді.
Dialogue: 0,0:07:31.36,0:07:35.03,Default,,0,0,0,,Менің ойымша, сіз Сот Корольдік сарайын ұнатасыз.
Dialogue: 0,0:07:35.87,0:07:37.91,Default,,0,0,0,,Үкім әрқашан әділ болады
Dialogue: 0,0:07:38.16,0:07:42.12,Default,,0,0,0,,Ойыншылардың бәрі де кек алуға құмар.
Dialogue: 0,0:07:42.25,0:07:43.67,Default,,0,0,0,,Көктемгі Санкаку Панкс және⸺
Dialogue: 0,0:07:43.79,0:07:46.92,Default,,0,0,0,,Сіз оны дәл осылай ойламайсыз деп үміттенемін.
Dialogue: 0,0:07:47.04,0:07:47.84,Default,,0,0,0,,Панк?
Dialogue: 0,0:07:47.96,0:07:48.59,Default,,0,0,0,,Қорқынышты!
Dialogue: 0,0:07:54.01,0:07:56.68,Default,,0,0,0,,Сакураба: Артынан келе жатқан қуу⸺
Dialogue: 0,0:07:57.60,0:07:59.31,Default,,0,0,0,,Ол өте кішкентай болып қалды.
Dialogue: 0,0:07:59.47,0:08:02.31,Default,,0,0,0,,Кя Сакураба-кун
Dialogue: 0,0:08:03.77,0:08:05.73,Default,,0,0,0,,Джарипро Сакураба?
Dialogue: 0,0:08:05.86,0:08:08.02,Default,,0,0,0,,Осындай жарамсыз қабылдағышты өшіру керек пе?
Dialogue: 0,0:08:08.15,0:08:09.78,Default,,0,0,0,,Патша сарайы да тәтті.
Dialogue: 0,0:08:10.36,0:08:13.53,Default,,0,0,0,,Бір өту нысанасы кем қалған сияқты.
Dialogue: 0,0:08:13.65,0:08:15.24,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:08:15.62,0:08:16.95,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:17.07,0:08:19.16,Default,,0,0,0,,Мен кенеттен JariPro-дан шықтым.
Dialogue: 0,0:08:19.91,0:08:23.58,Default,,0,0,0,,Мен өзімді жанкүйерлерім болған адамдарға жамандық жасағандай сезінемін.
Dialogue: 0,0:08:23.83,0:08:26.79,Default,,0,0,0,,Бірақ әлі де көруге келгендер үшін.
Dialogue: 0,0:08:27.59,0:08:29.96,Default,,0,0,0,,Әрқашан ойынмен оралыңыз
Dialogue: 0,0:08:31.63,0:08:33.17,Default,,0,0,0,,Сакураба!
Dialogue: 0,0:08:33.55,0:08:37.14,Default,,0,0,0,,Уррай Сакураба Уррай Сакураба
Dialogue: 0,0:08:38.05,0:08:38.80,Default,,0,0,0,,Торакичи
Dialogue: 0,0:08:38.93,0:08:40.56,Default,,0,0,0,,Гахаха!
Dialogue: 0,0:08:40.68,0:08:41.81,Default,,0,0,0,,Қырылған бас болғаннан кейін⸺
Dialogue: 0,0:08:41.93,0:08:45.14,Default,,0,0,0,,Бұл кішкентай балалар арасында өте танымал болды.
Dialogue: 0,0:08:49.36,0:08:50.23,Default,,0,0,0,,Ах
Dialogue: 0,0:08:56.70,0:09:00.70,Default,,0,0,0,,Сакураба мырза, оның денесі Харудың денесінен мүлде басқаша.
Dialogue: 0,0:09:01.95,0:09:03.54,Default,,0,0,0,,Жалғыз біз емеспіз
Dialogue: 0,0:09:04.00,0:09:07.04,Default,,0,0,0,,Король сарайының да жаз жақсы өткеніне сенімдімін.
Dialogue: 0,0:09:09.00,0:09:10.25,Default,,0,0,0,,Сусуму-сан…
Dialogue: 0,0:09:28.60,0:09:29.81,Default,,0,0,0,,Бұл басталды
Dialogue: 0,0:09:30.52,0:09:32.90,Default,,0,0,0,,Royal Castle Royal Castle…
Dialogue: 0,0:09:33.03,0:09:35.90,Default,,0,0,0,,Панкс Панкс Панкс…
Dialogue: 0,0:09:37.03,0:09:38.24,Default,,0,0,0,,Қалпақ киіңіз!
Dialogue: 0,0:09:41.91,0:09:42.91,Default,,0,0,0,,Саңырауқұлақ
Dialogue: 0,0:09:43.04,0:09:44.29,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:09:44.41,0:09:45.54,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:09:45.66,0:09:47.67,Default,,0,0,0,,Қатты жол қабырғасы
Dialogue: 0,0:09:49.96,0:09:51.84,Default,,0,0,0,,Сакураба белгіленген
Dialogue: 0,0:09:52.59,0:09:53.21,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:09:57.13,0:09:59.76,Default,,0,0,0,,Сәлем! (Атами) Мен қателестім.
Dialogue: 0,0:09:59.93,0:10:03.43,Default,,0,0,0,,Хехе, рұқсатты қайда лақтырып жатырсың? Таками
Dialogue: 0,0:10:03.56,0:10:06.52,Default,,0,0,0,,Дәлдік – мендегі жалғыз қасиет
Dialogue: 0,0:10:11.90,0:10:15.44,Default,,0,0,0,,Гахаха Сакураба, сен оны монах қылдың ба?
Dialogue: 0,0:10:15.57,0:10:17.36,Default,,0,0,0,,Атмосфера кенет өзгерді.
Dialogue: 0,0:10:17.95,0:10:19.16,Default,,0,0,0,,Ол өзгерді ме?
Dialogue: 0,0:10:19.74,0:10:21.91,Default,,0,0,0,,Бетке емес, бұлшықетке қарап баға беру керек пе?
Dialogue: 0,0:10:22.03,0:10:23.33,Default,,0,0,0,,Хаха...
Dialogue: 0,0:10:23.83,0:10:27.04,Default,,0,0,0,,Айтпақшы, көңіл күйіңізде қандай өзгеріс бар?
Dialogue: 0,0:10:28.75,0:10:30.12,Default,,0,0,0,,Таками мырза
Dialogue: 0,0:10:30.25,0:10:34.55,Default,,0,0,0,,Мен әдеттегі жаттығуларыма қосымша арнайы өту мәзірін жасағым келеді.
Dialogue: 0,0:10:40.63,0:10:42.05,Default,,0,0,0,,(Сакурабаның тыныс алуы)
Dialogue: 0,0:10:46.18,0:10:47.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:47.77,0:10:49.73,Default,,0,0,0,,Бұл қандай биіктік?
Dialogue: 0,0:10:58.07,0:11:00.91,Default,,0,0,0,,Доп тым жоғары, оны ұстау мүмкін емес
Dialogue: 0,0:11:07.66,0:11:09.41,Default,,0,0,0,,О!
Dialogue: 0,0:11:10.71,0:11:11.92,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:12.04,0:11:13.46,Default,,0,0,0,,Сакураба!
Dialogue: 0,0:11:13.58,0:11:14.46,Default,,0,0,0,,Иә
Dialogue: 0,0:11:15.09,0:11:16.13,Default,,0,0,0,,О
Dialogue: 0,0:11:16.34,0:11:18.09,Default,,0,0,0,,Уау
Dialogue: 0,0:11:18.30,0:11:20.30,Default,,0,0,0,,Қымбат
Dialogue: 0,0:11:25.51,0:11:26.89,Default,,0,0,0,,(Iris) Ол жұмысы барын айтып, бүгін таңертең кетті.
Dialogue: 0,0:11:28.06,0:11:29.18,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:11:29.31,0:11:32.94,Default,,0,0,0,,Өйткені, Сакураба-кун сондай керемет.
Dialogue: 0,0:11:34.44,0:11:36.11,Default,,0,0,0,,Тынш!
Dialogue: 0,0:11:37.48,0:11:39.69,Default,,0,0,0,,I... Ағымдағы рұқсат дегеніміз не?
Dialogue: 0,0:11:39.82,0:11:41.07,Default,,0,0,0,,Фуго
Dialogue: 0,0:11:45.32,0:11:48.87,Default,,0,0,0,,Қанша талпынсам да ол биікке жете алмаймын.
Dialogue: 0,0:11:48.99,0:11:51.04,Default,,0,0,0,,Ғажайып Сакураба-сан
Dialogue: 0,0:11:51.66,0:11:52.79,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:11:52.92,0:11:55.71,Default,,0,0,0,,Бұл қайта туылған Харуто Сакураба.
Dialogue: 0,0:11:56.04,0:11:58.75,Default,,0,0,0,,Әлі де тәкаппар бейбақ.
Dialogue: 0,0:11:58.88,0:11:59.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:05.26,0:12:06.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:06.72,0:12:08.31,Default,,0,0,0,,Қалпақ киіңіз!
Dialogue: 0,0:12:13.89,0:12:16.27,Default,,0,0,0,,Сакурба қайтадан ортасына кесілді.
Dialogue: 0,0:12:16.86,0:12:17.48,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:12:17.61,0:12:19.78,Default,,0,0,0,,Мен доптың қай жерден келетінін білсем де.
Dialogue: 0,0:12:21.82,0:12:22.65,Default,,0,0,0,,Мен келе жатырмын
Dialogue: 0,0:12:22.78,0:12:24.03,Default,,0,0,0,,Шашырату
Dialogue: 0,0:12:30.24,0:12:33.04,Default,,0,0,0,,Уау, міне, тағы барамыз!
Dialogue: 0,0:12:33.29,0:12:37.59,Default,,0,0,0,,Такамидің бойының артықшылығын пайдаланатын өте биік ұшыру алаңынан.
Dialogue: 0,0:12:37.71,0:12:42.30,Default,,0,0,0,,Сакурабаның ұзын аяқтарын супер биіктікке жету үшін пайдалану
Dialogue: 0,0:12:42.42,0:12:46.22,Default,,0,0,0,,Жапонияның ең биік Фудзи асуы
Dialogue: 0,0:12:48.43,0:12:50.56,Default,,0,0,0,,Осы жолды білсем де
Dialogue: 0,0:12:50.68,0:12:51.97,Default,,0,0,0,,Тоқтатайық
Dialogue: 0,0:12:54.35,0:12:56.23,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:12:56.40,0:12:58.19,Default,,0,0,0,,Тасу
Dialogue: 0,0:12:58.31,0:13:00.02,Default,,0,0,0,,Оджо: Бірінші нүкте!
Dialogue: 0,0:13:00.15,0:13:03.24,Default,,0,0,0,,Король сарайында 6 ұпай алды.
Dialogue: 0,0:13:03.86,0:13:05.11,Default,,0,0,0,,Таками! (Көрермен В) Жақсы!
Dialogue: 0,0:13:05.24,0:13:06.61,Default,,0,0,0,,Жақсы, Сакураба.
Dialogue: 0,0:13:07.11,0:13:10.08,Default,,0,0,0,,Сакураба Бұл бастама.
Dialogue: 0,0:13:11.91,0:13:12.75,Default,,0,0,0,,Иә
Dialogue: 0,0:13:13.33,0:13:14.58,Default,,0,0,0,,Алдын алу нүктесі
Dialogue: 0,0:13:14.71,0:13:16.54,Default,,0,0,0,,Тынш!
Dialogue: 0,0:13:16.67,0:13:18.96,Default,,0,0,0,,Король сарайы қолдау көрсететін нәрсе ме?
Dialogue: 0,0:13:19.08,0:13:21.17,Default,,0,0,0,,Иә? жау?
Dialogue: 0,0:13:21.30,0:13:25.51,Default,,0,0,0,,Жоқ, біз финалда бірге күресеміз деп уәде бердік.
Dialogue: 0,0:13:25.63,0:13:27.93,Default,,0,0,0,,Сонымен қатар, таңғажайып нәрселер таң қалдырады.
Dialogue: 0,0:13:28.18,0:13:33.64,Default,,0,0,0,,Хмм, бұл күш пен табандылықпен жасалған мұқият есептелген ойын.
Dialogue: 0,0:13:34.43,0:13:39.19,Default,,0,0,0,,Фудзи тауы былай тұрсын, әлемдегі ең биік асу, Эверест асуы
Dialogue: 0,0:13:39.56,0:13:42.11,Default,,0,0,0,,Эверест… өту
Dialogue: 0,0:13:42.23,0:13:43.69,Default,,0,0,0,,Мен бұл туралы ойладым.
Dialogue: 0,0:13:43.82,0:13:46.86,Default,,0,0,0,,Оның бойын қару ретінде пайдаланып, осыншама жерге барады деп күтпедім.
Dialogue: 0,0:13:47.36,0:13:48.82,Default,,0,0,0,,Сіз дәл қазір суретке түстіңіз бе?
Dialogue: 0,0:13:48.95,0:13:50.12,Default,,0,0,0,,Мен суретке түсірдім
Dialogue: 0,0:13:50.24,0:13:52.49,Default,,0,0,0,,Ешқандай деректер ағып кетпей жазылған.
Dialogue: 0,0:13:52.62,0:13:53.37,Default,,0,0,0,,Жарайды
Dialogue: 0,0:13:53.74,0:13:57.96,Default,,0,0,0,,Атами-сан... Жоқ, бұл жай ғана Атами-сан емес.
Dialogue: 0,0:13:58.08,0:14:00.46,Default,,0,0,0,,Барлығы өте көп жұмыс істейді.
Dialogue: 0,0:14:00.58,0:14:02.46,Default,,0,0,0,,Иә? Сена не болды?
Dialogue: 0,0:14:02.59,0:14:03.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:05.63,0:14:06.80,Default,,0,0,0,,Иә
Dialogue: 0,0:14:10.14,0:14:13.76,Default,,0,0,0,,Юхи Гуц Сіз соншалықты байсалды болсаңыз да
Dialogue: 0,0:14:14.18,0:14:18.64,Default,,0,0,0,,Бұл соңғы жыл болса да, жеңіліп қалсақ, өкінетін едім.
Dialogue: 0,0:14:18.94,0:14:20.73,Default,,0,0,0,,Сена, сен не ойлап тұрсың...
Dialogue: 0,0:14:20.86,0:14:22.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:27.70,0:14:32.20,Default,,0,0,0,,Шин! Шин! Шин!
Dialogue: 0,0:14:32.66,0:14:33.83,Default,,0,0,0,,Сусуму-сан
Dialogue: 0,0:14:34.87,0:14:36.04,Default,,0,0,0,,Қалпақ киіңіз!
Dialogue: 0,0:14:38.50,0:14:40.33,Default,,0,0,0,,Ой, шықты ма?
Dialogue: 0,0:14:40.79,0:14:41.79,Default,,0,0,0,,Ах
Dialogue: 0,0:14:52.72,0:14:53.93,Default,,0,0,0,,Аһ!
Dialogue: 0,0:14:57.68,0:14:58.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:06.57,0:15:10.53,Default,,0,0,0,,О
Dialogue: 0,0:15:11.53,0:15:13.07,Default,,0,0,0,,Саңырауқұлақ
Dialogue: 0,0:15:13.20,0:15:14.74,Default,,0,0,0,,Күшті найзадан
Dialogue: 0,0:15:14.87,0:15:16.41,Default,,0,0,0,,Қалпына келтіру
Dialogue: 0,0:15:16.54,0:15:17.62,Default,,0,0,0,,(Реинер) Гү!
Dialogue: 0,0:15:17.75,0:15:20.91,Default,,0,0,0,,Керемет! Король сарайынан күткендей
Dialogue: 0,0:15:21.04,0:15:21.87,Default,,0,0,0,,Иә
Dialogue: 0,0:15:23.29,0:15:26.00,Default,,0,0,0,,Эй, допты бекітіп алғаныңызға көз жеткізіңіз...
Dialogue: 0,0:15:26.13,0:15:27.96,Default,,0,0,0,,Қазірдің өзінде... (Директор Санкаку) Иә?
Dialogue: 0,0:15:29.42,0:15:31.34,Default,,0,0,0,,Маған енді ұнамайды
Dialogue: 0,0:15:32.18,0:15:34.43,Default,,0,0,0,,Менде доп жоқ.
Dialogue: 0,0:15:35.10,0:15:37.89,Default,,0,0,0,,Мен төбелескеннен кейін білдім.
Dialogue: 0,0:15:38.14,0:15:39.43,Default,,0,0,0,,Жаздан тыс⸺
Dialogue: 0,0:15:39.56,0:15:42.44,Default,,0,0,0,,Сусумуның жылдамдығы мен күші артты.
Dialogue: 0,0:15:42.77,0:15:44.40,Default,,0,0,0,,О (Атами) Әрине
Dialogue: 0,0:15:44.98,0:15:49.23,Default,,0,0,0,,Ол Харудан басқа адам сияқты. Оның әрекеті басқаша.
Dialogue: 0,0:15:49.49,0:15:52.66,Default,,0,0,0,,Сіз қанша дайындықтан өттіңіз?
Dialogue: 0,0:15:52.95,0:15:57.16,Default,,0,0,0,,А, көктемгі турнирде де солай істедің бе?
Dialogue: 0,0:16:02.46,0:16:04.08,Default,,0,0,0,,Ішек күткендей.
Dialogue: 0,0:16:11.84,0:16:13.22,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:13.63,0:16:15.51,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:16:18.10,0:16:19.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:27.02,0:16:28.86,Default,,0,0,0,,Саңырауқұлақ
Dialogue: 0,0:16:32.90,0:16:36.24,Default,,0,0,0,,Міне, бұл американдық футбол
Dialogue: 0,0:16:36.91,0:16:38.74,Default,,0,0,0,,For what we all aim for
Dialogue: 0,0:16:38.87,0:16:41.00,Default,,0,0,0,,Жауға тура соқтығысу
Dialogue: 0,0:16:41.12,0:16:43.33,Default,,0,0,0,,Сол сәт жанады
Dialogue: 0,0:16:53.05,0:16:55.72,Default,,0,0,0,,Сакураба мырза да, Отавара мырза да
Dialogue: 0,0:16:55.84,0:17:00.01,Default,,0,0,0,,Таками-сан, Сусуму-сан және Атами-сан да.
Dialogue: 0,0:17:00.89,0:17:03.52,Default,,0,0,0,,Барлығы бар күшімен күресіп, жеңіске жетеді
Dialogue: 0,0:17:04.06,0:17:06.15,Default,,0,0,0,,Рождестволық ыдысқа ұмтылу
Dialogue: 0,0:17:08.02,0:17:09.94,Default,,0,0,0,,Біз бәріміз күресуге келдік
Dialogue: 0,0:17:10.52,0:17:13.19,Default,,0,0,0,,Оны аяған дұрыс болар еді.
Dialogue: 0,0:17:17.49,0:17:20.58,Default,,0,0,0,,Сіз 1% жоғалтасыз.
Dialogue: 0,0:17:21.66,0:17:24.08,Default,,0,0,0,,Мен бірінші раундта ғана жеңіске жеттім.
Dialogue: 0,0:17:24.33,0:17:26.04,Default,,0,0,0,,Тіпті 1%
Dialogue: 0,0:17:26.17,0:17:28.67,Default,,0,0,0,,Юхи Гуцтан жеңіліп қалсаңыз, бәрі сол кезде бітеді.
Dialogue: 0,0:17:28.79,0:17:30.63,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:17:34.21,0:17:36.09,Default,,0,0,0,,Даңқ
Dialogue: 0,0:17:36.72,0:17:38.80,Default,,0,0,0,,Ойын аяқталды
Dialogue: 0,0:17:40.05,0:17:42.77,Default,,0,0,0,,Оджо Уайт Рыцарларының жеңісі
Dialogue: 0,0:17:42.89,0:17:47.69,Default,,0,0,0,,Ең күшті патшалық енді толықтай жанданды!
Dialogue: 0,0:17:47.81,0:17:50.48,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:50.61,0:17:53.94,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:57.53,0:17:59.20,Default,,0,0,0,,Атами-сан (Атами) Иә?
Dialogue: 0,0:18:01.45,0:18:03.41,Default,,0,0,0,,Біз бұрыштарды кеспейміз
Dialogue: 0,0:18:03.54,0:18:07.16,Default,,0,0,0,,Мен Юхи Гуцты бар күшіммен жеңемін.
Dialogue: 0,0:18:07.75,0:18:09.08,Default,,0,0,0,,Се... Сена
Dialogue: 0,0:18:09.21,0:18:11.13,Default,,0,0,0,,Сенна үшін қалың
Dialogue: 0,0:18:17.51,0:18:19.05,Default,,0,0,0,,Сол қылмыскер... қайтыс болды ма?
Dialogue: 0,0:18:33.02,0:18:35.78,Default,,0,0,0,,Күн батуы! (Юхи мүшелері) Ішінара!
Dialogue: 0,0:18:35.90,0:18:36.90,Default,,0,0,0,,Еңбек, шыдам, шыдамдылық!
Dialogue: 0,0:18:37.03,0:18:37.65,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:18:37.78,0:18:38.82,Default,,0,0,0,,Еңбек, шыдам, шыдамдылық!
Dialogue: 0,0:18:38.95,0:18:39.57,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:18:39.70,0:18:40.70,Default,,0,0,0,,Еңбек, шыдам, шыдамдылық!
Dialogue: 0,0:18:40.82,0:18:41.45,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:18:44.99,0:18:47.58,Default,,0,0,0,,Юхи Гуцты бар күшімізбен жеңейік
Dialogue: 0,0:18:47.70,0:18:48.79,Default,,0,0,0,,О
Dialogue: 0,0:18:51.00,0:18:56.00,Default,,0,0,0,,♪~
Dialogue: 0,0:19:58.73,0:20:03.74,Default,,0,0,0,,~♪
Dialogue: 0,0:20:06.91,0:20:10.37,Default,,0,0,0,,Не? Юхи Гуцтың бастапқы құрамы
Dialogue: 0,0:20:10.50,0:20:12.08,Default,,0,0,0,,Американдық футбол клубының тұрақты мүшелерін алып тастаңыз
Dialogue: 0,0:20:12.21,0:20:13.17,Default,,0,0,0,,Бейсбол немесе футбол клубы⸺
Dialogue: 0,0:20:13.29,0:20:15.04,Default,,0,0,0,,Мен барлық жұлдыздарды жинадым.
Dialogue: 0,0:20:15.17,0:20:19.05,Default,,0,0,0,,Әй, тездетіп мына жігіттерді қуып жібер.
Dialogue: 0,0:20:19.17,0:20:21.05,Default,,0,0,0,,Келесі жолы «Көз қалқаны 21»
Dialogue: 0,0:20:21.17,0:20:23.88,Default,,0,0,0,,«Күш-жігер!
Dialogue: 0,0:20:24.01,0:20:25.76,Default,,0,0,0,,Я-Ха-!
