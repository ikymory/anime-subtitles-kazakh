Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:21.85,0:00:26.02,Default,,0,0,0,,(Мэрибеллдің күлкісі)
Dialogue: 0,0:00:26.15,0:00:28.73,Default,,0,0,0,,Мидгард Диананы шығарған шығар.
Dialogue: 0,0:00:28.94,0:00:29.65,Default,,0,0,0,,Хаха
Dialogue: 0,0:00:29.77,0:00:32.53,Default,,0,0,0,,Сондықтан ғарышқа ұшқаннан кейін қашып құтыла алдың.
Dialogue: 0,0:00:33.86,0:00:34.53,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:36.70,0:00:39.58,Default,,0,0,0,,СС-тегі Гарри жердегілермен бірдей емес пе?
Dialogue: 0,0:00:39.74,0:00:41.58,Default,,0,0,0,,Бұл да мен түсінбейтін нәрсе.
Dialogue: 0,0:00:41.79,0:00:43.16,Default,,0,0,0,,Мидгард шықты
Dialogue: 0,0:00:43.33,0:00:44.25,Default,,0,0,0,,О
Dialogue: 0,0:00:44.41,0:00:47.75,Default,,0,0,0,,Солей консулы Миланның басшылығымен
Dialogue: 0,0:00:47.88,0:00:49.50,Default,,0,0,0,,Мен Диана ханымды алып шықтым, бірақ...
Dialogue: 0,0:00:49.88,0:00:51.80,Default,,0,0,0,,Мен осындай хабарды естідім.
Dialogue: 0,0:00:52.01,0:00:54.67,Default,,0,0,0,,Неліктен біз Жерде жүздеген жылдар бойы өмір сүрдік?
Dialogue: 0,0:00:54.80,0:00:56.84,Default,,0,0,0,,Мен Мунврейтті әкелдім.
Dialogue: 0,0:00:56.97,0:00:58.14,Default,,0,0,0,,Қатерлі ісік және Мурон
Dialogue: 0,0:00:58.26,0:01:00.97,Default,,0,0,0,,Ата-бабасынан Сорелдер әулетіне адал болуға ант берген...
Dialogue: 0,0:01:01.10,0:01:04.35,Default,,0,0,0,,Сіз біздің стратегиямызды сездіңіз.
Dialogue: 0,0:01:04.56,0:01:06.64,Default,,0,0,0,,Музыкалық кодты талдау аяқталды
Dialogue: 0,0:01:07.02,0:01:08.31,Default,,0,0,0,,Оны картаға түсіре аласыз ба?
Dialogue: 0,0:01:08.48,0:01:09.44,Default,,0,0,0,,Га
Dialogue: 0,0:01:11.11,0:01:12.11,Default,,0,0,0,,Қайда?
Dialogue: 0,0:01:13.36,0:01:14.78,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:01:15.40,0:01:18.16,Default,,0,0,0,,Иә, бұл Мистлету.
Dialogue: 0,0:01:18.41,0:01:21.99,Default,,0,0,0,,Мунврейт ауыл шаруашылығының отаны болып табылатын астероид.
Dialogue: 0,0:01:22.12,0:01:23.04,Default,,0,0,0,,Сәлем, капитан
Dialogue: 0,0:01:23.58,0:01:24.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:24.79,0:01:28.71,Default,,0,0,0,,Жер тұрғындары қараңғы тарихтың қирандыларынан қазып алған ғарыш кемесі...
Dialogue: 0,0:01:28.83,0:01:30.00,Default,,0,0,0,,Бұл әскери кеме болды, солай ма?
Dialogue: 0,0:01:30.38,0:01:31.63,Default,,0,0,0,,Шамасы...
Dialogue: 0,0:01:31.88,0:01:33.67,Default,,0,0,0,,Вилгем үшін деректер жоқ
Dialogue: 0,0:01:34.05,0:01:36.22,Default,,0,0,0,,Ақ түсті жылжымалы костюмдер де бар.
Dialogue: 0,0:01:36.42,0:01:37.63,Default,,0,0,0,,Қызықты
Dialogue: 0,0:01:37.84,0:01:38.80,Default,,0,0,0,,Мидгард
Dialogue: 0,0:01:38.93,0:01:39.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:40.30,0:01:45.02,Default,,0,0,0,,Менің басшылығыммен Гинганум флоты алғаш рет нақты ұрысқа қатыса алады.
Dialogue: 0,0:01:45.31,0:01:46.98,Default,,0,0,0,,Теяаа
Dialogue: 0,0:01:47.14,0:01:53.15,Default,,0,0,0,,♪~
Dialogue: 0,0:02:09.87,0:02:15.88,Default,,0,0,0,,~♪
Dialogue: 0,0:02:21.01,0:02:22.22,Default,,0,0,0,,Әй?
Dialogue: 0,0:02:25.18,0:02:27.27,Default,,0,0,0,,Классикалық әуен
Dialogue: 0,0:02:27.39,0:02:28.60,Default,,0,0,0,,Бұл дәл өткен жолымен бірдей, кішкентай сорлы!
Dialogue: 0,0:02:28.73,0:02:31.02,Default,,0,0,0,,Менің декодтау кодыммен мүмкін емес пе?
Dialogue: 0,0:02:31.15,0:02:33.02,Default,,0,0,0,,Жоқ, болды, мен көрсетемін.
Dialogue: 0,0:02:33.15,0:02:34.90,Default,,0,0,0,,Иә, көрсетіңізші.
Dialogue: 0,0:02:36.15,0:02:37.99,Default,,0,0,0,,Уау, шықты.
Dialogue: 0,0:02:38.11,0:02:39.15,Default,,0,0,0,,Бұл қандай сурет?
Dialogue: 0,0:02:39.32,0:02:41.03,Default,,0,0,0,,Бұл Айдың айналасындағы карта.
Dialogue: 0,0:02:41.16,0:02:42.57,Default,,0,0,0,,Бірақ мен әрқашан айға жақынмын.
Dialogue: 0,0:02:42.99,0:02:45.66,Default,,0,0,0,,AC нөмірі D 02-3
Dialogue: 0,0:02:45.79,0:02:46.54,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:02:46.66,0:02:47.41,Default,,0,0,0,,Мистлету
Dialogue: 0,0:02:47.95,0:02:49.04,Default,,0,0,0,,Отыр. О…
Dialogue: 0,0:02:49.21,0:02:51.50,Default,,0,0,0,,Тастанды астероид колониясы сияқты нәрсе.
Dialogue: 0,0:02:52.17,0:02:55.96,Default,,0,0,0,,Бұл аймақ ядролық бомба лақтырылған жер болды...
Dialogue: 0,0:02:56.42,0:02:59.13,Default,,0,0,0,,Диана ханым сол колонияға қашып кетті.
Dialogue: 0,0:02:59.26,0:03:00.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:00.51,0:03:02.43,Default,,0,0,0,,Сізде дәлел бар ма?
Dialogue: 0,0:03:02.72,0:03:06.18,Default,,0,0,0,,Бұл қазіргі уақытта пайдаланылмайтын колония, сондықтан сіз оған әдетте назар аудармайсыз...
Dialogue: 0,0:03:14.40,0:03:16.44,Default,,0,0,0,,Сыртқы люкті жабыңыз
Dialogue: 0,0:03:18.28,0:03:19.86,Default,,0,0,0,,Ежелгі әмбебап ғасырдан кейін-
Dialogue: 0,0:03:20.11,0:03:24.12,Default,,0,0,0,,Дәл осы жерде Сорелдер отбасы ауыл шаруашылығын жандандыру тәжірибесін жасады.
Dialogue: 0,0:03:25.45,0:03:27.99,Default,,0,0,0,,Осы жерде ішіндегі люкті ашыңыз
Dialogue: 0,0:03:30.54,0:03:31.83,Default,,0,0,0,,Ағаш тірі
Dialogue: 0,0:03:32.92,0:03:35.42,Default,,0,0,0,,Жандарды қайтардым делік.
Dialogue: 0,0:03:35.88,0:03:36.54,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:03:36.67,0:03:38.46,Default,,0,0,0,,1-эскадрильяның найзасы дайын.
Dialogue: 0,0:03:38.59,0:03:41.84,Default,,0,0,0,,2-ші эскадрилья дайын қалқанмен Мисурутуға шабуыл жасайды.
Dialogue: 0,0:03:42.13,0:03:42.84,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:03:43.30,0:03:45.09,Default,,0,0,0,,Күтуден шаршадым, генерал.
Dialogue: 0,0:03:57.23,0:03:59.53,Default,,0,0,0,,Махиро отряды бұрынғысынша дұрыс емес әрекет етеді.
Dialogue: 0,0:04:05.95,0:04:06.62,Default,,0,0,0,,Сәлем Роланд
Dialogue: 0,0:04:07.58,0:04:09.62,Default,,0,0,0,,Ядролық бомбаны осы жерге тастауымыз керек пе?
Dialogue: 0,0:04:09.74,0:04:10.62,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:04:10.75,0:04:12.62,Default,,0,0,0,,Бұл ғарыш кемесі курсы.
Dialogue: 0,0:04:13.00,0:04:15.83,Default,,0,0,0,,Мен Диана ханыммен кездескеннен кейін бұл туралы бірдеңе істеймін.
Dialogue: 0,0:04:16.08,0:04:18.00,Default,,0,0,0,,Бұл тас жұлдыз ма?
Dialogue: 0,0:04:18.13,0:04:18.92,Default,,0,0,0,,Не болды, мырза Мокки!
Dialogue: 0,0:04:22.63,0:04:23.51,Default,,0,0,0,,Уф
Dialogue: 0,0:04:26.43,0:04:27.26,Default,,0,0,0,,Хмм
Dialogue: 0,0:04:28.81,0:04:29.39,Default,,0,0,0,,Уау
Dialogue: 0,0:04:30.81,0:04:31.72,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:04:33.14,0:04:36.23,Default,,0,0,0,,Диана-сама - жауапкершілікті сезінетін адам.
Dialogue: 0,0:04:36.52,0:04:38.69,Default,,0,0,0,,Осылай әдемі екенін білдім.
Dialogue: 0,0:04:38.90,0:04:41.82,Default,,0,0,0,,Сен осылай сөйлейтіндей сұлусың.
Dialogue: 0,0:04:42.19,0:04:43.49,Default,,0,0,0,,Өйткені сен сондайсың...
Dialogue: 0,0:04:45.32,0:04:48.03,Default,,0,0,0,,Мен Мисурутудан сенімен бірге жүруін өтінгім келеді.
Dialogue: 0,0:04:48.32,0:04:49.20,Default,,0,0,0,,Ха…
Dialogue: 0,0:04:50.20,0:04:51.58,Default,,0,0,0,,Қалауыңызша
Dialogue: 0,0:04:51.83,0:04:52.41,Default,,0,0,0,,Капитан!
Dialogue: 0,0:04:53.16,0:04:54.08,Default,,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,0:04:54.58,0:04:55.67,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:04:58.04,0:04:59.67,Default,,0,0,0,,Кешір мені Уау
Dialogue: 0,0:05:10.10,0:05:11.35,Default,,0,0,0,,Сонда капитан да сонда болады ма?
Dialogue: 0,0:05:11.56,0:05:12.64,Default,,0,0,0,,Кильді өзімен бірге алып кеткен сияқты.
Dialogue: 0,0:05:12.77,0:05:13.68,Default,,0,0,0,,Уау
Dialogue: 0,0:05:13.81,0:05:14.48,Default,,0,0,0,,Артқа тұру (оқ ату)
Dialogue: 0,0:05:15.44,0:05:17.44,Default,,0,0,0,,Ангарды кім ашты?
Dialogue: 0,0:05:17.65,0:05:20.36,Default,,0,0,0,,Ақ сақалдылар хабардар етіңіздерші.
Dialogue: 0,0:05:20.52,0:05:21.90,Default,,0,0,0,,Сумо (Бруно) Иә?
Dialogue: 0,0:05:22.03,0:05:23.69,Default,,0,0,0,,Міне Гарри келеді.
Dialogue: 0,0:05:23.82,0:05:24.44,Default,,0,0,0,,Иә...
Dialogue: 0,0:05:24.57,0:05:27.49,Default,,0,0,0,,Ол Киль мен Диананы қолданғысы келеді.
Dialogue: 0,0:05:29.91,0:05:30.66,Default,,0,0,0,,Уау
Dialogue: 0,0:05:31.20,0:05:32.20,Default,,0,0,0,,1 4 0 0
Dialogue: 0,0:05:32.37,0:05:34.08,Default,,0,0,0,,Диана Counter мобильді костюмі?
Dialogue: 0,0:05:34.20,0:05:36.37,Default,,0,0,0,,Бұл байланыс тұзақ емес пе еді?
Dialogue: 0,0:05:36.54,0:05:38.29,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:05:42.13,0:05:46.51,Default,,0,0,0,,Бұл ғарышкерлерді қинаған шайтанның мобильді костюміне ұқсайды.
Dialogue: 0,0:05:46.76,0:05:47.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:48.68,0:05:49.84,Default,,0,0,0,,Бұл жылжымалы костюм
Dialogue: 0,0:05:49.97,0:05:51.64,Default,,0,0,0,,Бұл Диана есептегіші емес.
Dialogue: 0,0:05:56.81,0:05:58.94,Default,,0,0,0,,Мистлетудағы шайқас жойылсын.
Dialogue: 0,0:05:59.06,0:06:00.40,Default,,0,0,0,,Мен Гарри Ордпын
Dialogue: 0,0:06:00.52,0:06:03.57,Default,,0,0,0,,Біз жаңа ғана Милишаның кемесінен Диана ханымды құтқардық.
Dialogue: 0,0:06:06.36,0:06:08.78,Default,,0,0,0,,СС-тегі Гарри туралы не деуге болады?
Dialogue: 0,0:06:14.91,0:06:17.66,Default,,0,0,0,,Бұл Диана есептегіші емес. Не айтқың келеді?
Dialogue: 0,0:06:17.79,0:06:18.62,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:18.75,0:06:19.92,Default,,0,0,0,,Неге кешірім сұрайсыз?
Dialogue: 0,0:06:20.33,0:06:25.05,Default,,0,0,0,,Өйткені Диана ханымды құтқару үшін мен оны осы бастан өткіздім.
Dialogue: 0,0:06:25.34,0:06:27.92,Default,,0,0,0,,Диана мен оның әпкесі бірдей.
Dialogue: 0,0:06:28.13,0:06:29.93,Default,,0,0,0,,Бұл көңілсіз, бірақ мен сені енді жек көре алмаймын.
Dialogue: 0,0:06:31.34,0:06:33.76,Default,,0,0,0,,Уау хахаха сонда болды.
Dialogue: 0,0:06:33.89,0:06:37.14,Default,,0,0,0,,Ханшайым, менің екі қосалқы мобильді костюмім бар.
Dialogue: 0,0:06:37.27,0:06:38.77,Default,,0,0,0,,Мен оны пайдалана аламын ба?
Dialogue: 0,0:06:39.35,0:06:42.27,Default,,0,0,0,,Әй, бұл фермада бұрыннан қолданылған.
Dialogue: 0,0:06:43.02,0:06:44.73,Default,,0,0,0,,Uh, I see.
Dialogue: 0,0:06:44.86,0:06:45.78,Default,,0,0,0,,Иә
Dialogue: 0,0:06:46.07,0:06:48.03,Default,,0,0,0,,Мурон Сіз ханшайымды көтердіңіз, солай ма?
Dialogue: 0,0:06:48.40,0:06:49.20,Default,,0,0,0,,Эй
Dialogue: 0,0:06:49.32,0:06:51.91,Default,,0,0,0,,Оның орнына Ане-сан шықшы ретінде әрекет етеді.
Dialogue: 0,0:06:52.28,0:06:54.08,Default,,0,0,0,,Қалғандар да дәл қазір барын салып еңбек етіп жатқан болар.
Dialogue: 0,0:07:13.47,0:07:15.30,Default,,0,0,0,,Мен олардың көздерінен қашуым керек.
Dialogue: 0,0:07:16.22,0:07:19.27,Default,,0,0,0,,Мен Гинганам тобына хабарласа аламын ба? Мурон-доно
Dialogue: 0,0:07:19.39,0:07:22.69,Default,,0,0,0,,Жоқ, олар Диана ханымды нысанаға алып отыр.
Dialogue: 0,0:07:23.31,0:07:23.90,Default,,0,0,0,,Хаа…
Dialogue: 0,0:07:26.23,0:07:27.44,Default,,0,0,0,,Не, кенеттен?
Dialogue: 0,0:07:27.65,0:07:29.24,Default,,0,0,0,,Жақын жерде ұрыс дыбыстары естілді.
Dialogue: 0,0:07:29.36,0:07:30.78,Default,,0,0,0,,Ғибадатхана қыз-қызметшісінің киімі оған жарасады.
Dialogue: 0,0:07:33.20,0:07:35.07,Default,,0,0,0,,Күте тұрыңыз, биік өкшелі туфлилер де бар.
Dialogue: 0,0:07:35.91,0:07:36.83,Default,,0,0,0,,Сақал болды
Dialogue: 0,0:07:36.95,0:07:37.70,Default,,0,0,0,,Сіз Роландсыз ба?
Dialogue: 0,0:07:41.00,0:07:42.25,Default,,0,0,0,,Сіз Дианасыз ба?
Dialogue: 0,0:07:42.37,0:07:45.04,Default,,0,0,0,,Сіз жарақат алдыңыз ба? Суық емес пе?
Dialogue: 0,0:07:45.84,0:07:48.30,Default,,0,0,0,,Мен оларға сенуім керек пе? капитан
Dialogue: 0,0:07:48.42,0:07:49.17,Default,,0,0,0,,Махаббат та, махаббатсыз неке де
Dialogue: 0,0:07:49.30,0:07:50.59,Default,,0,0,0,,Сақал мен Доп мырза...
Dialogue: 0,0:07:50.72,0:07:53.09,Default,,0,0,0,,Олар да сен сияқты сенімді.
Dialogue: 0,0:07:53.22,0:07:55.55,Default,,0,0,0,,Ах... у-а
Dialogue: 0,0:08:06.02,0:08:07.77,Default,,0,0,0,,Тез қашайық, Роланд
Dialogue: 0,0:08:08.73,0:08:11.28,Default,,0,0,0,,Егер бұл орын алса, бәріміз ядролық бомбадан өлеміз.
Dialogue: 0,0:08:12.03,0:08:13.45,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:08:13.57,0:08:16.74,Default,,0,0,0,,Диана ретінде мен Гим Гуинганумға бардым...
Dialogue: 0,0:08:16.87,0:08:21.04,Default,,0,0,0,,Айға көтеріліп, Агриппаны дұрыс емес жерден пышақтап алсаңыз болғаны.
Dialogue: 0,0:08:21.16,0:08:24.54,Default,,0,0,0,,Гинганум шықты, мен жалғыз істей алмаймын...
Dialogue: 0,0:08:25.29,0:08:28.21,Default,,0,0,0,,Капитан Гарри үшін Киль Хейм...
Dialogue: 0,0:08:28.75,0:08:31.55,Default,,0,0,0,,Ол тіпті Диана-саманың көлеңкелі жауынгері бола алмайтын әйел ме?
Dialogue: 0,0:08:31.88,0:08:35.93,Default,,0,0,0,,ше? Киль-сама Диана-саманы құрметтеп жатыр...
Dialogue: 0,0:08:36.05,0:08:38.85,Default,,0,0,0,,Маған Гарри ұнайды.
Dialogue: 0,0:08:39.51,0:08:40.64,Default,,0,0,0,,Құдайға шүкір
Dialogue: 0,0:08:41.27,0:08:44.69,Default,,0,0,0,,Бұл Гарри Орд емес
Dialogue: 0,0:08:44.81,0:08:47.56,Default,,0,0,0,,Мен СС капитанымын.
Dialogue: 0,0:08:47.69,0:08:48.31,Default,,0,0,0,,Хааа
Dialogue: 0,0:08:52.99,0:08:55.20,Default,,0,0,0,,Мені сүйемін десең...
Dialogue: 0,0:08:55.36,0:08:58.07,Default,,0,0,0,,Агриппаны құрметпен өлтірейік.
Dialogue: 0,0:09:00.58,0:09:01.99,Default,,0,0,0,,Киль Хейм
Dialogue: 0,0:09:02.20,0:09:04.62,Default,,0,0,0,,Сіз мені қалай қаласаңыз, еркелете аласыз.
Dialogue: 0,0:09:05.41,0:09:06.17,Default,,0,0,0,,А...
Dialogue: 0,0:09:10.21,0:09:13.59,Default,,0,0,0,,Мен сенің Диана-саманың қалқаны болғаныңды қалаймын.
Dialogue: 0,0:09:18.14,0:09:22.06,Default,,0,0,0,,Оның орнына сүйген махаббат кедей болар еді.
Dialogue: 0,0:09:32.61,0:09:35.49,Default,,0,0,0,,Айналу осін OK туралаңыз.
Dialogue: 0,0:09:36.15,0:09:36.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:38.16,0:09:40.16,Default,,0,0,0,,Сіз айға жеттіңіз бе?
Dialogue: 0,0:09:40.28,0:09:42.41,Default,,0,0,0,,Жоқ, бұл инерциялық ауырлық.
Dialogue: 0,0:09:42.70,0:09:44.12,Default,,0,0,0,,Бруно (Бруно) корпусы бекітілген
Dialogue: 0,0:09:44.45,0:09:45.75,Default,,0,0,0,,Жарайды, түзетілді.
Dialogue: 0,0:09:45.87,0:09:49.46,Default,,0,0,0,,Armadillo Алдыңыздағы порт люкті тексеріңіз.
Dialogue: 0,0:09:52.17,0:09:54.84,Default,,0,0,0,,Жоқ, жұлдыздар жүгіріп келеді
Dialogue: 0,0:10:07.06,0:10:08.81,Default,,0,0,0,,Перне құлпы көрінісі
Dialogue: 0,0:10:11.81,0:10:13.32,Default,,0,0,0,,Эй, ол ашық.
Dialogue: 0,0:10:20.74,0:10:21.32,Default,,0,0,0,,Босатыңыз
Dialogue: 0,0:10:21.45,0:10:22.95,Default,,0,0,0,,Мен Гарримен кездесіп жатқанда...
Dialogue: 0,0:10:23.08,0:10:26.00,Default,,0,0,0,,Бұл Aspite айналасында күтуге бұйрық.
Dialogue: 0,0:10:26.29,0:10:27.79,Default,,0,0,0,,Мен нақты жауынгерлік дайындықпен айналысамын.
Dialogue: 0,0:10:28.33,0:10:31.38,Default,,0,0,0,,Генералға жеті жұлдызды беру гвардиялық Гарриге байланысты.
Dialogue: 0,0:10:33.42,0:10:35.38,Default,,0,0,0,,Эй, саған Жер ұнады ма?
Dialogue: 0,0:10:35.84,0:10:36.63,Default,,0,0,0,,Га
Dialogue: 0,0:10:37.34,0:10:40.89,Default,,0,0,0,,Мен Мәртебелі Диана Солерге кеме алғым келеді.
Dialogue: 0,0:10:42.47,0:10:44.60,Default,,0,0,0,,Кеме...?
Dialogue: 0,0:10:45.18,0:10:47.27,Default,,0,0,0,,Мен Милишаның кемесінен қашып кеттім.
Dialogue: 0,0:10:47.48,0:10:48.10,Default,,0,0,0,,асығыңыз
Dialogue: 0,0:10:48.52,0:10:50.10,Default,,0,0,0,,Бірақ бұл естеліктер мен үш-төрт жастағы кезімдегі ғой, иә?
Dialogue: 0,0:10:50.39,0:10:53.65,Default,,0,0,0,,Мистлетуды паналаған Милиша бар.
Dialogue: 0,0:10:54.44,0:10:56.44,Default,,0,0,0,,Мистлетуды әзірге жалғыз қалдыра аласыз.
Dialogue: 0,0:10:57.11,0:11:00.99,Default,,0,0,0,,Өйткені сіз Жерді қайтару операциясына қарсы болдыңыз.
Dialogue: 0,0:11:01.11,0:11:03.74,Default,,0,0,0,,Менің дөрекілігіме күлгені дұрыс.
Dialogue: 0,0:11:04.03,0:11:09.33,Default,,0,0,0,,Мен күлмеймін, бірақ Мидгардтан ханшайымның атын айтатын бір қыз болғанда...
Dialogue: 0,0:11:09.46,0:11:10.50,Default,,0,0,0,,Сөздеріңізге келсек... А?
Dialogue: 0,0:11:11.04,0:11:14.00,Default,,0,0,0,,Менің мұндай төмен қызбен айналысуға уақытым жоқ.
Dialogue: 0,0:11:14.13,0:11:15.75,Default,,0,0,0,,Менің Mahiro құрылғым...
Dialogue: 0,0:11:15.88,0:11:18.80,Default,,0,0,0,,Бір қызды ұстау үшін уақыт керек деп ойлайсыз ба?
Dialogue: 0,0:11:19.59,0:11:21.63,Default,,0,0,0,,Жер тұрғындарын артта қалдыруға болады.
Dialogue: 0,0:11:21.76,0:11:24.85,Default,,0,0,0,,Бұл жерде де өзінің жауынгерлік инстинктіне бағынатындар бар...
Dialogue: 0,0:11:24.97,0:11:25.89,Default,,0,0,0,,Қабылданбайды
Dialogue: 0,0:11:26.43,0:11:27.60,Default,,0,0,0,,Хааа
Dialogue: 0,0:11:28.27,0:11:30.02,Default,,0,0,0,,Олай дейтін болсам...
Dialogue: 0,0:11:30.14,0:11:33.15,Default,,0,0,0,,Өйткені олар «Диана санаушысы» атты милиция ұйымдастырды.
Dialogue: 0,0:11:33.27,0:11:36.48,Default,,0,0,0,,Егер сіз кішкентай студент болсаңыз, бір күнде Жерді басып алуға болады.
Dialogue: 0,0:11:37.11,0:11:38.86,Default,,0,0,0,,Қайтадан айтыңыз
Dialogue: 0,0:11:49.12,0:11:51.04,Default,,0,0,0,,Порт жағы түзу көтеріледі
Dialogue: 0,0:11:51.25,0:11:53.92,Default,,0,0,0,,Уақытты ұту жақсы нәрсе деп ойлаймын.
Dialogue: 0,0:11:54.04,0:11:55.46,Default,,0,0,0,,Сіз шыға аласыз ба?
Dialogue: 0,0:11:55.58,0:11:56.75,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:11:56.88,0:11:57.59,Default,,0,0,0,,Иә
Dialogue: 0,0:11:57.71,0:12:00.59,Default,,0,0,0,,Үлкен люктің екі шығуы бар.
Dialogue: 0,0:12:00.71,0:12:02.34,Default,,0,0,0,,Егер ол сізде болмаса, не істер едіңіз?
Dialogue: 0,0:12:07.89,0:12:09.89,Default,,0,0,0,,Мен тым алыс кеткенімді білемін.
Dialogue: 0,0:12:10.18,0:12:14.65,Default,,0,0,0,,Сонымен, мен шешім қабылдадым, сондықтан маған бір нәрсеге уәде беріңіз.
Dialogue: 0,0:12:14.77,0:12:16.15,Default,,0,0,0,,Тіпті ұйықтап қалғаннан кейін де, кем дегенде—
Dialogue: 0,0:12:17.31,0:12:19.28,Default,,0,0,0,,Мен өлгенде -
Dialogue: 0,0:12:19.40,0:12:22.36,Default,,0,0,0,,Өтінемін, мені құшағыңа алшы
Dialogue: 0,0:12:24.91,0:12:26.66,Default,,0,0,0,,Біз бұл уәдені бере алмаймыз.
Dialogue: 0,0:12:26.78,0:12:27.74,Default,,0,0,0,,Captain
Dialogue: 0,0:12:27.87,0:12:30.41,Default,,0,0,0,,Кейде мен бірінші өлемін.
Dialogue: 0,0:12:30.54,0:12:31.29,Default,,0,0,0,,Captain
Dialogue: 0,0:12:33.33,0:12:35.96,Default,,0,0,0,,Люк қозғалып жатыр, Диана.
Dialogue: 0,0:12:38.67,0:12:41.01,Default,,0,0,0,,Апаттық ысырманы жабуды бастау
Dialogue: 0,0:12:41.13,0:12:43.34,Default,,0,0,0,,...Дұшпан жасап жатыр деген сөз.
Dialogue: 0,0:12:43.59,0:12:45.26,Default,,0,0,0,,Мен солай деп үміттенемін ...
Dialogue: 0,0:12:45.38,0:12:48.14,Default,,0,0,0,,Тура Вилгемге барыңыз... Ах.
Dialogue: 0,0:12:48.97,0:12:50.31,Default,,0,0,0,,Бұл люк те
Dialogue: 0,0:13:07.57,0:13:09.37,Default,,0,0,0,,Хмм... міне.
Dialogue: 0,0:13:18.17,0:13:19.84,Default,,0,0,0,,Қандай бомбалау
Dialogue: 0,0:13:24.01,0:13:26.51,Default,,0,0,0,,Диана ханымға өкпем бар сияқты.
Dialogue: 0,0:13:26.63,0:13:31.01,Default,,0,0,0,,Хэхехе хахахаха Жер басып алу отшашуы.
Dialogue: 0,0:13:31.93,0:13:35.56,Default,,0,0,0,,Мен Диана ханымның Жерге барғаннан кейін күшейгенін көремін.
Dialogue: 0,0:13:35.77,0:13:38.48,Default,,0,0,0,,Егер солай болса, онда сіз біздің қалай күресетінімізді түсінесіз.
Dialogue: 0,0:13:49.53,0:13:51.24,Default,,0,0,0,,Иә? Кішкентай зымыран?
Dialogue: 0,0:13:51.53,0:13:53.29,Default,,0,0,0,,Бұл ақылсыз, ханшайым.
Dialogue: 0,0:13:53.41,0:13:55.96,Default,,0,0,0,,Өйткені сен мені қорғайсың
Dialogue: 0,0:13:59.25,0:14:00.75,Default,,0,0,0,,Лоран ісігі
Dialogue: 0,0:14:00.88,0:14:01.71,Default,,0,0,0,,Иә
Dialogue: 0,0:14:14.52,0:14:17.56,Default,,0,0,0,,Ха, Диана...
Dialogue: 0,0:14:19.56,0:14:25.40,Default,,0,0,0,,Ди... Диана ханым, мен тым күшті болдым ба?
Dialogue: 0,0:14:26.61,0:14:27.19,Default,,0,0,0,,Хаа…
Dialogue: 0,0:14:37.12,0:14:39.42,Default,,0,0,0,,Ақ қуыршақ пен жұпты ұстау
Dialogue: 0,0:14:39.54,0:14:41.04,Default,,0,0,0,,Сіз қуып жете аласыз ба? (Бруно) Иә.
Dialogue: 0,0:14:41.17,0:14:44.38,Default,,0,0,0,,Барлық милиция сарбаздары жаудың механикалық қуыршақтарын бақылайды
Dialogue: 0,0:14:54.64,0:14:57.06,Default,,0,0,0,,Террористік жасақ – Солтүстік жұлдыздың жеті жұлдызы
Dialogue: 0,0:15:00.35,0:15:03.77,Default,,0,0,0,,Ааааааааааааааааааааа
Dialogue: 0,0:15:05.27,0:15:06.90,Default,,0,0,0,,Сіз мені естисіз бе? Құрметті Диана
Dialogue: 0,0:15:07.03,0:15:08.24,Default,,0,0,0,,Иә, бұл не? Роланд
Dialogue: 0,0:15:08.94,0:15:12.41,Default,,0,0,0,,Сіз шаттлды шынымен басқарып жатырсыз ба?
Dialogue: 0,0:15:12.53,0:15:14.24,Default,,0,0,0,,Осы дәрежеде...
Dialogue: 0,0:15:14.45,0:15:16.37,Default,,0,0,0,,Мен Киль-сан үшін көбірек уайымдаймын.
Dialogue: 0,0:15:17.08,0:15:17.95,Default,,0,0,0,,Уф
Dialogue: 0,0:15:19.79,0:15:22.17,Default,,0,0,0,,Сенің әпкең ана жақта, солай ма?
Dialogue: 0,0:15:26.59,0:15:28.13,Default,,0,0,0,,Ханым, артта қалыңыз.
Dialogue: 0,0:15:28.30,0:15:31.13,Default,,0,0,0,,The same aircraft are more compatible with each other.
Dialogue: 0,0:15:38.35,0:15:39.27,Default,,0,0,0,,Не?
Dialogue: 0,0:15:40.14,0:15:41.56,Default,,0,0,0,,Вилгем қашып кетті.
Dialogue: 0,0:15:45.69,0:15:47.32,Default,,0,0,0,,Мақсатты дұрыс қою
Dialogue: 0,0:15:47.44,0:15:49.28,Default,,0,0,0,,Identifying the difference between a rock and a machine.
Dialogue: 0,0:15:49.40,0:15:51.86,Default,,0,0,0,,Мен сізге дәл шабуыл жасауды айттым.
Dialogue: 0,0:15:51.99,0:15:52.61,Default,,0,0,0,,Хмм…
Dialogue: 0,0:15:53.41,0:15:57.83,Default,,0,0,0,,It is not possible just to do diagram exercises on a designated battlefield.
Dialogue: 0,0:15:59.33,0:16:01.00,Default,,0,0,0,,Колония қалдықтарын қалқан ретінде пайдаланыңыз
Dialogue: 0,0:16:05.96,0:16:08.05,Default,,0,0,0,,If it's an enemy call, it would be nice to answer.
Dialogue: 0,0:16:08.88,0:16:12.05,Default,,0,0,0,,What are you doing in the universe, Milisha people?
Dialogue: 0,0:16:12.17,0:16:13.55,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:16:14.01,0:16:17.97,Default,,0,0,0,,He locked them in a cellar and tried to kill them.
Dialogue: 0,0:16:18.60,0:16:19.64,Default,,0,0,0,,Маған келетін болсақ
Dialogue: 0,0:16:19.77,0:16:23.02,Default,,0,0,0,,I just want to retrieve the Gendarme shuttle.
Dialogue: 0,0:16:23.14,0:16:25.02,Default,,0,0,0,,Қандай себеп болмасын -
Dialogue: 0,0:16:25.15,0:16:28.44,Default,,0,0,0,,Attacking a peace negotiation team would be the work of barbarians.
Dialogue: 0,0:16:28.77,0:16:30.11,Default,,0,0,0,,Варварлар?
Dialogue: 0,0:16:30.86,0:16:32.90,Default,,0,0,0,,Мұны Агриппаға айт.
Dialogue: 0,0:16:33.40,0:16:35.86,Default,,0,0,0,,There will be as many wars as you like from now on.
Dialogue: 0,0:16:36.03,0:16:38.03,Default,,0,0,0,,Келіссөздер жүргізу үшін үстелді орнату
Dialogue: 0,0:16:38.16,0:16:39.91,Default,,0,0,0,,Екінші кеме ойына келгенін істесін.
Dialogue: 0,0:16:43.50,0:16:45.04,Default,,0,0,0,,Бұлай жалғаса берсе, ештеңе істей алмайсыз.
Dialogue: 0,0:16:45.17,0:16:46.71,Default,,0,0,0,,Тек айналып өтіп, орындаңыз.
Dialogue: 0,0:16:46.83,0:16:49.88,Default,,0,0,0,,But that rock is pulled by the moon's gravity.
Dialogue: 0,0:16:50.21,0:16:51.17,Default,,0,0,0,,Бұл курс
Dialogue: 0,0:16:51.67,0:16:53.42,Default,,0,0,0,,Сіз Phone City-ге барасыз ба?
Dialogue: 0,0:16:54.01,0:16:55.97,Default,,0,0,0,,X-TOP дайындаңыз
Dialogue: 0,0:16:56.09,0:16:57.89,Default,,0,0,0,,X-TOP нөміріне қоңырау шалыңыз
Dialogue: 0,0:16:58.01,0:16:59.72,Default,,0,0,0,,Сіз не істеуді жоспарлайсыз?
Dialogue: 0,0:16:59.85,0:17:01.81,Default,,0,0,0,,Қазылған машиналарды сынау
Dialogue: 0,0:17:02.31,0:17:03.98,Default,,0,0,0,,Жерден шығарылған... машина?
Dialogue: 0,0:17:07.06,0:17:11.36,Default,,0,0,0,,Сол жігіттер мен үшін жасады... Уф.
Dialogue: 0,0:17:11.48,0:17:12.48,Default,,0,0,0,,Күте тұрыңыз, Ане-сан.
Dialogue: 0,0:17:12.74,0:17:16.20,Default,,0,0,0,,If we take their battleship and smash it against this rock...
Dialogue: 0,0:17:17.41,0:17:18.70,Default,,0,0,0,,Шықпа
Dialogue: 0,0:17:19.03,0:17:21.33,Default,,0,0,0,,If we shatter the rocks, the earth will be safe.
Dialogue: 0,0:17:21.62,0:17:23.41,Default,,0,0,0,,Дөрекі болмаңыз
Dialogue: 0,0:17:23.87,0:17:28.38,Default,,0,0,0,,Lady Diana's planet has been destroyed and they are trying to crush the city of the moon.
Dialogue: 0,0:17:28.88,0:17:29.79,Default,,0,0,0,,Таңертең ерте тұрып-ақ қазірден-ақ қажырлы еңбек етіп жатырсың ғой.
Dialogue: 0,0:17:30.25,0:17:32.63,Default,,0,0,0,,Күте тұрыңыз, мен бірдеңе істеймін.
Dialogue: 0,0:17:32.96,0:17:33.67,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:17:34.34,0:17:37.18,Default,,0,0,0,,Менің қолымда ядролық оқтұмсық бар.
Dialogue: 0,0:17:37.34,0:17:39.05,Default,,0,0,0,,Ядролық оқтұмсық?
Dialogue: 0,0:17:39.18,0:17:40.85,Default,,0,0,0,,Неліктен сізде мұндай нәрсе бар?
Dialogue: 0,0:17:41.18,0:17:43.81,Default,,0,0,0,,Бұл Жердегі Жоғалған тауда қалды.
Dialogue: 0,0:17:48.98,0:17:50.11,Default,,0,0,0,,Оны жең!
Dialogue: 0,0:17:50.61,0:17:53.03,Default,,0,0,0,,Жас ханым, басқалармен бірге қашыңыз.
Dialogue: 0,0:17:55.28,0:17:57.24,Default,,0,0,0,,Біз жылжымалы костюмдерден қорғаймыз
Dialogue: 0,0:17:58.03,0:17:58.99,Default,,0,0,0,,Жоқ, мен әйеліммен ұрсысып қалдым.
Dialogue: 0,0:17:59.11,0:18:00.24,Default,,0,0,0,,Лоран Сіз мұны істей аласыз, солай ма?
Dialogue: 0,0:18:00.66,0:18:02.33,Default,,0,0,0,,Өтінемін, жас ханым.
Dialogue: 0,0:18:02.45,0:18:04.20,Default,,0,0,0,,Сақалды Лаура
Dialogue: 0,0:18:04.70,0:18:06.71,Default,,0,0,0,,Сіз нағыз айшысыз...
Dialogue: 0,0:18:06.83,0:18:09.63,Default,,0,0,0,,Мен ханшайымды жақсы көретінімді білемін.
Dialogue: 0,0:18:09.92,0:18:11.17,Default,,0,0,0,,Қалғанын сізге қалдырдым.
Dialogue: 0,0:18:11.29,0:18:12.13,Default,,0,0,0,,Мурон
Dialogue: 0,0:18:12.59,0:18:13.80,Default,,0,0,0,,Айо
Dialogue: 0,0:18:14.13,0:18:15.01,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:18:15.13,0:18:18.47,Default,,0,0,0,,Ай жағындағы ядроны қолданыңыз. Басқа жағына бұрылыңыз.
Dialogue: 0,0:18:19.18,0:18:20.47,Default,,0,0,0,,Бұл жауға байланысты
Dialogue: 0,0:18:24.93,0:18:27.06,Default,,0,0,0,,Менің артымнан келе аласыз ба? Гарри
Dialogue: 0,0:18:27.18,0:18:28.39,Default,,0,0,0,,Әрине
Dialogue: 0,0:18:36.15,0:18:38.11,Default,,0,0,0,,Бірінші жазықтықты алыңыз
Dialogue: 0,0:18:39.15,0:18:40.36,Default,,0,0,0,,Не
Dialogue: 0,0:18:49.92,0:18:51.00,Default,,0,0,0,,Екі ядролық қару
Dialogue: 0,0:19:00.13,0:19:01.55,Default,,0,0,0,,Барлығың тыңдаңдар.
Dialogue: 0,0:19:01.89,0:19:05.22,Default,,0,0,0,,Мына Ақ қуыршақтың қолында аспанды өртеп жіберетін қылыш.
Dialogue: 0,0:19:05.35,0:19:08.10,Default,,0,0,0,,Мистлету қалдықтарының айға түсуіне жол бермеу.
Dialogue: 0,0:19:08.23,0:19:09.56,Default,,0,0,0,,Мұны пайдаланыңыз
Dialogue: 0,0:19:09.69,0:19:12.69,Default,,0,0,0,,Осы әуе кеңістігіндегі барлық адамдар эвакуациялануы керек.
Dialogue: 0,0:19:13.40,0:19:16.28,Default,,0,0,0,,Бұл байланыс нені білдіреді?
Dialogue: 0,0:19:16.94,0:19:20.74,Default,,0,0,0,,Ол Жоғалған таудың өзегін жасырды ма?
Dialogue: 0,0:19:21.20,0:19:22.53,Default,,0,0,0,,Иә
Dialogue: 0,0:19:23.07,0:19:25.49,Default,,0,0,0,,Сен сол күлкілі бомбаны қолданасың ба?
Dialogue: 0,0:19:25.91,0:19:27.79,Default,,0,0,0,,Роландтың шешімі дұрыс.
Dialogue: 0,0:19:27.91,0:19:29.41,Default,,0,0,0,,Иә, шегініңіз.
Dialogue: 0,0:19:29.75,0:19:30.79,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:19:30.91,0:19:33.21,Default,,0,0,0,,Мұртты, тастар мен өсиеттерді түзу сызықтарға айналдыр
Dialogue: 0,0:19:33.54,0:19:34.29,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:19:35.00,0:19:35.92,Default,,0,0,0,,Ақ қуыршақ...
Dialogue: 0,0:19:36.04,0:19:39.21,Default,,0,0,0,,Оларда ядролық оқтұмсық бар деген ақпарат рас.
Dialogue: 0,0:19:43.47,0:19:46.31,Default,,0,0,0,,Неліктен Роландтың ядролық бомбасы болды?
Dialogue: 0,0:19:46.56,0:19:48.10,Default,,0,0,0,,Диана Counter-тің офицерінен
Dialogue: 0,0:19:48.22,0:19:50.48,Default,,0,0,0,,Бұл маған лақтыруды өтінді.
Dialogue: 0,0:19:51.19,0:19:54.61,Default,,0,0,0,,Сондықтан сіз оны бүгінге дейін ұстадыңыз.
Dialogue: 0,0:19:54.81,0:19:55.44,Default,,0,0,0,,Хаа…
Dialogue: 0,0:19:56.27,0:19:57.73,Default,,0,0,0,,Максималды телефото
Dialogue: 0,0:19:58.07,0:19:58.78,Default,,0,0,0,,Не?
Dialogue: 0,0:19:59.44,0:20:00.24,Default,,0,0,0,,Уф
Dialogue: 0,0:20:01.07,0:20:03.41,Default,,0,0,0,,Не? Бұл батпан
Dialogue: 0,0:20:03.53,0:20:05.41,Default,,0,0,0,,Әрекет еттіңіз бе, бауырым?
Dialogue: 0,0:20:06.20,0:20:07.03,Default,,0,0,0,,Бауырлар?
Dialogue: 0,0:20:07.16,0:20:09.62,Default,,0,0,0,,Өйткені бұл X бұрылысы мен А бұрылысы.
Dialogue: 0,0:20:09.75,0:20:12.08,Default,,0,0,0,,Гим Гинганам... Диана ханым ше?
Dialogue: 0,0:20:12.41,0:20:16.59,Default,,0,0,0,,Біздің флотта біз қарсы алатын ханымдар біздің қожайынымыз ретінде қарастырылады.
Dialogue: 0,0:20:17.13,0:20:18.13,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:20:18.25,0:20:20.96,Default,,0,0,0,,Олай болмаса, не істеу керек А бұрылысы
Dialogue: 0,0:20:21.09,0:20:21.84,Default,,0,0,0,,Егер...
Dialogue: 0,0:20:24.59,0:20:26.93,Default,,0,0,0,,Аспанды күйдіретін екі қылыш бар.
Dialogue: 0,0:20:27.05,0:20:29.93,Default,,0,0,0,,Сіз оны Гингем отбасында аласыз.
Dialogue: 0,0:20:30.22,0:20:32.68,Default,,0,0,0,,(Гинганумның күлкісі)
Dialogue: 0,0:20:33.27,0:20:36.48,Default,,0,0,0,,Ол кезде не қаласаң, соны істе.
Dialogue: 0,0:20:36.94,0:20:38.94,Default,,0,0,0,,Мен бұл сөздерге сенемін.
Dialogue: 0,0:20:40.19,0:20:42.24,Default,,0,0,0,,Адам даналығының жемісі болса...
Dialogue: 0,0:20:42.95,0:20:45.07,Default,,0,0,0,,Адамдарды құтқарайық!
Dialogue: 0,0:20:56.00,0:20:57.29,Default,,0,0,0,,Әне-сан
Dialogue: 0,0:20:59.00,0:21:00.09,Default,,0,0,0,,Уау
Dialogue: 0,0:21:02.09,0:21:03.76,Default,,0,0,0,,Анесан (рак) Мурон
Dialogue: 0,0:21:06.97,0:21:09.76,Default,,0,0,0,,Барлығына, біз ядролық қаруды қолданамыз.
Dialogue: 0,0:21:17.48,0:21:20.52,Default,,0,0,0,,Дұрыс емес пе? Детонация...
Dialogue: 0,0:21:30.49,0:21:32.83,Default,,0,0,0,,Не... не? Бұл кедергі
Dialogue: 0,0:21:32.95,0:21:35.16,Default,,0,0,0,,Лоран, сіз ядролық қаруды іске қостыңыз.
Dialogue: 0,0:21:36.50,0:21:38.04,Default,,0,0,0,,Не? Мынау
Dialogue: 0,0:21:42.17,0:21:45.30,Default,,0,0,0,,Бұл Жоғалған таудың жарығы...
Dialogue: 0,0:21:45.97,0:21:47.38,Default,,0,0,0,,Бұл ғаламның таңы
Dialogue: 0,0:21:48.01,0:21:52.51,Default,,0,0,0,,Уф, Гаван... Гаван өлгендегідей жарық.
Dialogue: 0,0:21:54.68,0:21:59.44,Default,,0,0,0,,Мега бөлшектердің зеңбірегі диффузды сәулеленуге дайын тастар жойылады.
Dialogue: 0,0:21:59.77,0:22:03.69,Default,,0,0,0,,Тастарды тазалап болған соң, Махиро отрядын ұстаңыз.
Dialogue: 0,0:22:04.19,0:22:05.57,Default,,0,0,0,,Диана ше?
Dialogue: 0,0:22:05.69,0:22:09.74,Default,,0,0,0,,Иә, мен іздеп жүрген сақалды код жоғалып кетті.
Dialogue: 0,0:22:09.87,0:22:11.99,Default,,0,0,0,,Олар осы бағытта қозғалуы керек еді...
Dialogue: 0,0:22:12.66,0:22:14.29,Default,,0,0,0,,Жоқ, Роланд
Dialogue: 0,0:22:14.41,0:22:17.71,Default,,0,0,0,,Тағы да сол жарылыста біреу адасып қала ма деп ойлаймын.
Dialogue: 0,0:22:18.12,0:22:19.17,Default,,0,0,0,,Ха…
Dialogue: 0,0:22:19.58,0:22:20.83,Default,,0,0,0,,Ақ қуыршақ
Dialogue: 0,0:22:20.96,0:22:22.71,Default,,0,0,0,,А, мен оны растай алдым.
Dialogue: 0,0:22:23.38,0:22:24.59,Default,,0,0,0,,Маған еріңіз
Dialogue: 0,0:22:24.71,0:22:25.92,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:22:26.05,0:22:27.92,Default,,0,0,0,,Қатерлі ісік және Мурон...
Dialogue: 0,0:22:28.05,0:22:31.18,Default,,0,0,0,,Тым көп қоқыс... анықтау мүмкін емес.
Dialogue: 0,0:22:31.72,0:22:33.89,Default,,0,0,0,,Вилгем және Аспит...
Dialogue: 0,0:22:34.47,0:22:35.43,Default,,0,0,0,,Хаа…
Dialogue: 0,0:22:40.94,0:22:45.78,Default,,0,0,0,,А, мен қоңырауды естідім...
Dialogue: 0,0:22:45.90,0:22:47.49,Default,,0,0,0,,Уф... уф.
Dialogue: 0,0:22:56.75,0:22:58.71,Default,,0,0,0,,Лоран, бәрібір.
Dialogue: 0,0:22:58.83,0:22:59.54,Default,,0,0,0,,Иә
Dialogue: 0,0:23:00.04,0:23:01.46,Default,,0,0,0,,(Виолет) Мен теремін. (Роданс) Жарай бер.
Dialogue: 0,0:23:01.58,0:23:04.75,Default,,0,0,0,,Роланд 200 000 азаматты құтқарды.
Dialogue: 0,0:23:04.92,0:23:07.92,Default,,0,0,0,,Ай ханшайымы ретінде мен сізге шын жүректен алғыс айтқым келеді.
Dialogue: 0,0:23:08.30,0:23:13.43,Default,,0,0,0,,Не... не айтып тұрсың? Мен жай ғана досыма көмектестім.
Dialogue: 0,0:23:16.01,0:23:16.81,Default,,0,0,0,,Рахмет
Dialogue: 0,0:23:16.93,0:23:17.93,Default,,0,0,0,,Не
Dialogue: 0,0:23:18.68,0:23:22.19,Default,,0,0,0,,Хаха, неғұрлым кең болса, соғұрлым жақсы.
Dialogue: 0,0:23:22.69,0:23:27.78,Default,,0,0,0,,Жарайды, егер бұл кең болса, Ане-санмен 4-5 күн тұруға болады.
Dialogue: 0,0:23:28.11,0:23:30.65,Default,,0,0,0,,Тамақ та бар. Саке мен тұшпара ше?
Dialogue: 0,0:23:31.07,0:23:33.45,Default,,0,0,0,,Бұл Ретт командасымен болады.
Dialogue: 0,0:23:33.57,0:23:35.87,Default,,0,0,0,,Жарайды, ёши, ёкоши, ёкоши
Dialogue: 0,0:23:35.99,0:23:36.95,Default,,0,0,0,,Иә, жақсы
Dialogue: 0,0:23:38.16,0:23:41.33,Default,,0,0,0,,Диана Солердің айға оралуын тойлау
Dialogue: 0,0:23:41.46,0:23:44.29,Default,,0,0,0,,♪~ («Айдың жаны»)
Dialogue: 0,0:23:44.42,0:23:47.30,Default,,0,0,0,,Ішейін, ханшайым.
Dialogue: 0,0:24:16.87,0:24:22.87,Default,,0,0,0,,~♪
Dialogue: 0,0:24:29.42,0:24:30.88,Default,,0,0,0,,Лоран Қалай болды?
Dialogue: 0,0:24:31.34,0:24:34.89,Default,,0,0,0,,Оның да Жердің әуе кеңістігіне ағып жатқанының белгісі жоқ.
Dialogue: 0,0:24:35.01,0:24:36.05,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:24:36.18,0:24:38.43,Default,,0,0,0,,Құрметті Диана Роланд
Dialogue: 0,0:24:38.64,0:24:40.56,Default,,0,0,0,,Донна су астында күтіп тұр.
Dialogue: 0,0:24:40.68,0:24:43.44,Default,,0,0,0,,Лоран мен Сосьер мырза, теңіз астындағы портқа барыңыз.
Dialogue: 0,0:24:43.85,0:24:45.19,Default,,0,0,0,,Рахмет сізге Хамметт
Dialogue: 0,0:24:45.31,0:24:47.19,Default,,0,0,0,,Бұл Роланд үшін емес.
Dialogue: 0,0:24:51.53,0:24:54.24,Default,,0,0,0,,Умида балық шаруашылығы қауымдастығы дегеніміз не?
Dialogue: 0,0:24:54.36,0:24:57.87,Default,,0,0,0,,Бұл канал, бірақ Мунврейт бұл мұхит дейді.
Dialogue: 0,0:25:04.29,0:25:07.79,Default,,0,0,0,,Су? Айда су бар ма?
Dialogue: 0,0:25:07.92,0:25:11.09,Default,,0,0,0,,Сусыз адам өмір сүре алмайды.
Dialogue: 0,0:25:23.06,0:25:24.43,Default,,0,0,0,,Донна апа
Dialogue: 0,0:25:24.56,0:25:27.90,Default,,0,0,0,,Ханшайыммен бірге болу деген нені білдіреді?
Dialogue: 0,0:25:31.52,0:25:32.44,Default,,0,0,0,,(Дельфин дыбысы)
Dialogue: 0,0:25:45.54,0:25:46.25,Default,,0,0,0,,Ха…
Dialogue: 0,0:25:46.37,0:25:48.29,Default,,0,0,0,,Мен келдім, Лоран, жас ханым.
Dialogue: 0,0:25:48.83,0:25:49.71,Default,,0,0,0,,Бұл топ туралы не деуге болады?
Dialogue: 0,0:25:49.83,0:25:52.05,Default,,0,0,0,,Ол бізді жасырады
Dialogue: 0,0:25:55.88,0:25:59.05,Default,,0,0,0,,Донна апа, сіз киттердің әдеттерін жақсы білесіз.
Dialogue: 0,0:26:07.52,0:26:10.31,Default,,0,0,0,,Киттің ұшқыны жақсы нәрсе емес пе?
Dialogue: 0,0:26:10.44,0:26:12.15,Default,,0,0,0,,(Еркектер есінеу)
Dialogue: 0,0:26:21.28,0:26:23.16,Default,,0,0,0,,Ах, Генганам.
Dialogue: 0,0:26:23.29,0:26:24.41,Default,,0,0,0,,Genganum?
Dialogue: 0,0:26:24.70,0:26:26.04,Default,,0,0,0,,Бұл менің қалам
Dialogue: 0,0:26:30.58,0:26:33.42,Default,,0,0,0,,Диананың астанасы түсте ме?
Dialogue: 0,0:26:40.97,0:26:43.68,Default,,0,0,0,,Мече, оны мүмкіндігінше тез орындаңыз
Dialogue: 0,0:26:44.06,0:26:46.52,Default,,0,0,0,,Дәрілерге ұқсайтын заттарды ұмытпаңыз.
Dialogue: 0,0:26:46.64,0:26:50.90,Default,,0,0,0,,Ұрлық жасап жатырмыз, неге тынышырақ жасамасқа?
Dialogue: 0,0:26:51.77,0:26:53.27,Default,,0,0,0,,Механикалық қуыршақ
Dialogue: 0,0:26:54.27,0:26:56.23,Default,,0,0,0,,Патруль Бұл әдеттегіден жылдамырақ.
Dialogue: 0,0:26:56.36,0:26:58.11,Default,,0,0,0,,Менің ойымша, сіз бізге күдіктенесіз.
Dialogue: 0,0:27:02.16,0:27:02.95,Default,,0,0,0,,Не?
Dialogue: 0,0:27:03.07,0:27:03.99,Default,,0,0,0,,Бұл ақ қуыршақ емес пе?
Dialogue: 0,0:27:04.78,0:27:06.54,Default,,0,0,0,,Бұл тіпті жұп емес.
Dialogue: 0,0:27:07.16,0:27:09.91,Default,,0,0,0,,О, Вилгем портта болды ма?
Dialogue: 0,0:27:10.17,0:27:11.21,Default,,0,0,0,,Лоран
Dialogue: 0,0:27:11.37,0:27:12.88,Default,,0,0,0,,Мен сені мұндай жерде кездестіремін деп ойламадым.
Dialogue: 0,0:27:13.54,0:27:14.29,Default,,0,0,0,,Société
Dialogue: 0,0:27:14.42,0:27:15.38,Default,,0,0,0,,Меше
Dialogue: 0,0:27:15.50,0:27:17.71,Default,,0,0,0,,Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:27:19.05,0:27:20.34,Default,,0,0,0,,Ал, екінші лейтенанттың да айырмашылығы жоқ.
Dialogue: 0,0:27:20.72,0:27:23.22,Default,,0,0,0,,Мм, Диана да солай ма?
Dialogue: 0,0:27:23.35,0:27:25.39,Default,,0,0,0,,Иә, рахмет
Dialogue: 0,0:27:25.51,0:27:28.77,Default,,0,0,0,,Бәрің осындай жерде не істеп жүрсіңдер?
Dialogue: 0,0:27:29.10,0:27:33.65,Default,,0,0,0,,Не... Бізде ғарышты жеткізу өте тапшы.
Dialogue: 0,0:27:33.94,0:27:35.86,Default,,0,0,0,,Ха... ұрлап жатырсың ба?
Dialogue: 0,0:27:36.32,0:27:37.69,Default,,0,0,0,,Кешір, бірақ мен мүлде ақшам жоқ.
Dialogue: 0,0:27:37.82,0:27:40.45,Default,,0,0,0,,Кешіріңіз, Мәртебелі.
Dialogue: 0,0:27:41.53,0:27:43.95,Default,,0,0,0,,Мәртебелі Диана Солерді алуға бола ма?
Dialogue: 0,0:27:44.07,0:27:45.37,Default,,0,0,0,,Бұл Диана.
Dialogue: 0,0:27:45.49,0:27:46.70,Default,,0,0,0,,Көмегің үшін тағы да рахмет.
Dialogue: 0,0:27:46.83,0:27:47.70,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:27:47.87,0:27:50.37,Default,,0,0,0,,Уау... Оның шын болғанына қатты әсер еттім.
Dialogue: 0,0:27:50.71,0:27:52.83,Default,,0,0,0,,Мисс Киль қазір қайда?
Dialogue: 0,0:27:52.96,0:27:55.00,Default,,0,0,0,,Сіз капитан Гарримен бірге болуыңыз керек, солай ма?
Dialogue: 0,0:27:55.13,0:27:57.88,Default,,0,0,0,,Сондықтан уайымдамаңыз, Гвен мырза.
Dialogue: 0,0:27:58.38,0:28:02.13,Default,,0,0,0,,Ақ сарайға баруға кешігіп қаласыз.
Dialogue: 0,0:28:02.63,0:28:05.76,Default,,0,0,0,,Не, сізге Agrippa Maintainer қызметіне кіруге рұқсат берілді ме?
Dialogue: 0,0:28:06.43,0:28:09.93,Default,,0,0,0,,Иә, мен Лили ханымның дипломатиялық шеберлігіне таң қалдым.
Dialogue: 0,0:28:10.73,0:28:12.77,Default,,0,0,0,,Асыл қыз күткендей
Dialogue: 0,0:28:12.89,0:28:16.77,Default,,0,0,0,,Ақ сарай шенеуніктерінің қалтасын жиі аштыңыз.
Dialogue: 0,0:28:16.90,0:28:19.69,Default,,0,0,0,,Асыл адамдардың арасында туысқандық рух бар емес пе?
Dialogue: 0,0:28:20.40,0:28:21.65,Default,,0,0,0,,Хмм...
Dialogue: 0,0:28:22.74,0:28:23.91,Default,,0,0,0,,Бірге жиналайық
Dialogue: 0,0:28:24.03,0:28:24.99,Default,,0,0,0,,Маған?
Dialogue: 0,0:28:25.12,0:28:28.28,Default,,0,0,0,,Менің бетімде онымен танысқым келеді деп жазылған.
Dialogue: 0,0:28:28.41,0:28:29.24,Default,,0,0,0,,О
Dialogue: 0,0:28:41.09,0:28:42.84,Default,,0,0,0,,Маған стереоға баруға рұқсат етіңіз.
Dialogue: 0,0:28:42.97,0:28:44.59,Default,,0,0,0,,Айға қонамын деді.
Dialogue: 0,0:28:49.10,0:28:50.64,Default,,0,0,0,,Нгуен мырза, еңбегіңіз үшін рахмет.
Dialogue: 0,0:28:50.77,0:28:51.52,Default,,0,0,0,,Жоқ
Dialogue: 0,0:28:51.98,0:28:53.85,Default,,0,0,0,,Бұл да Цурунцурун.
Dialogue: 0,0:28:53.98,0:28:54.94,Default,,0,0,0,,Сен жақсы тұрдың.
Dialogue: 0,0:28:58.02,0:28:58.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:59.86,0:29:03.82,Default,,0,0,0,,Лили Борджиано ханым, біз сізді күттік.
Dialogue: 0,0:29:04.36,0:29:07.03,Default,,0,0,0,,Сәлеметсіз бе, Агриппа Жетекшісі
Dialogue: 0,0:29:07.16,0:29:08.99,Default,,0,0,0,,Бұл Гвен Үшінші Рейнфорд.
Dialogue: 0,0:29:09.12,0:29:11.62,Default,,0,0,0,,Сізбен кездесуге мүмкіндік бергеніңіз үшін рахмет.
Dialogue: 0,0:29:11.75,0:29:12.75,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:29:13.08,0:29:14.16,Default,,0,0,0,,Хмм?
Dialogue: 0,0:29:14.29,0:29:17.00,Default,,0,0,0,,Хмм... Ал сіз ше?
Dialogue: 0,0:29:17.17,0:29:21.38,Default,,0,0,0,,Иә, бұл менің хатшысым Мисс Киль Хейм.
Dialogue: 0,0:29:21.88,0:29:25.05,Default,,0,0,0,,Мәртебелі патшайымды көргенде...
Dialogue: 0,0:29:25.18,0:29:28.85,Default,,0,0,0,,Мен шынымен таң қалдым, өйткені олардың екеуі болды.
Dialogue: 0,0:29:30.01,0:29:31.77,Default,,0,0,0,,Хохохохохо
Dialogue: 0,0:29:31.89,0:29:35.81,Default,,0,0,0,,Лили-дононың терісі бүгінде одан да жарқырайды.
Dialogue: 0,0:29:36.31,0:29:38.23,Default,,0,0,0,,Қуаныштымын, Мәртебелі.
Dialogue: 0,0:29:43.32,0:29:44.69,Default,,0,0,0,,Тамаша жұмыс
Dialogue: 0,0:29:44.82,0:29:46.74,Default,,0,0,0,,Нгуен мырза да осында жеке хат жолдады.
Dialogue: 0,0:29:47.03,0:29:47.78,Default,,0,0,0,,Иә
Dialogue: 0,0:29:50.91,0:29:52.41,Default,,0,0,0,,Бұл жаудың механикалық қуыршағы.
Dialogue: 0,0:29:53.12,0:29:55.62,Default,,0,0,0,,Механикалық қуыршақ? Біртүрлі емес пе?
Dialogue: 0,0:29:55.87,0:29:59.33,Default,,0,0,0,,Бұл порт, солай ма? Мұндай жерге қалай шабуыл жасай аласыз?
Dialogue: 0,0:29:59.50,0:30:02.09,Default,,0,0,0,,Жоқ, бұл Махиро бірлігімен мүмкін.
Dialogue: 0,0:30:02.21,0:30:03.84,Default,,0,0,0,,Неліктен бұл болып жатыр?
Dialogue: 0,0:30:07.43,0:30:08.64,Default,,0,0,0,,Адамдар!
Dialogue: 0,0:30:08.76,0:30:11.93,Default,,0,0,0,,Генганам портындағы жер тұрғындарын кальмарға айналдыр.
Dialogue: 0,0:30:12.43,0:30:13.43,Default,,0,0,0,,Уф...
Dialogue: 0,0:30:22.44,0:30:23.40,Default,,0,0,0,,Сарайға барайық
Dialogue: 0,0:30:23.53,0:30:24.36,Default,,0,0,0,,Сарайға?
Dialogue: 0,0:30:24.48,0:30:25.49,Default,,0,0,0,,Оны қалқан ретінде пайдаланыңыз
Dialogue: 0,0:30:25.82,0:30:27.15,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:30:33.70,0:30:35.08,Default,,0,0,0,,Махиро қаланы аралап жүр
Dialogue: 0,0:30:35.20,0:30:36.70,Default,,0,0,0,,Қандай ғарыш кемесі
Dialogue: 0,0:30:38.25,0:30:39.50,Default,,0,0,0,,Біреу мені ауыстыра ала ма?
Dialogue: 0,0:30:40.96,0:30:42.59,Default,,0,0,0,,Төмендегі қалада шабуыл...
Dialogue: 0,0:30:45.80,0:30:47.30,Default,,0,0,0,,Сіз алға қарай жалғастыра аласыз.
Dialogue: 0,0:30:47.72,0:30:49.13,Default,,0,0,0,,Кетіңіз.
Dialogue: 0,0:30:49.30,0:30:51.30,Default,,0,0,0,,Мен Ай патшасының генералын қалқан ретінде қолданамын.
Dialogue: 0,0:30:51.59,0:30:53.30,Default,,0,0,0,,Ғарыш кемесі келе жатыр (Чемберлен) Бұл қай кеме?
Dialogue: 0,0:30:53.43,0:30:54.51,Default,,0,0,0,,Махиро отряды қосылды ма?
Dialogue: 0,0:30:58.35,0:31:00.35,Default,,0,0,0,,Сіз оны осы жерден алдыңыз ба? Мұнда?
Dialogue: 0,0:31:00.52,0:31:01.90,Default,,0,0,0,,Вилгем қашуға тырысты.
Dialogue: 0,0:31:03.73,0:31:08.07,Default,,0,0,0,,Менің сарайымда... Соғыс қалай жақын болды?
Dialogue: 0,0:31:08.19,0:31:09.45,Default,,0,0,0,,О, мен қорқамын
Dialogue: 0,0:31:11.87,0:31:13.07,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:31:13.20,0:31:16.24,Default,,0,0,0,,Гинганам отбасының мүшелерін жылжытсаңыз, осылай болады.
Dialogue: 0,0:31:16.37,0:31:18.58,Default,,0,0,0,,Ол мұны түсінбеді.
Dialogue: 0,0:31:18.71,0:31:20.42,Default,,0,0,0,,О, сен мұны меңзеп тұрсың ба?
Dialogue: 0,0:31:20.87,0:31:23.71,Default,,0,0,0,,Гингемге айт, бұл қамалды қорғасын.
Dialogue: 0,0:31:23.84,0:31:25.30,Default,,0,0,0,,Сіз оны пайдалана аласыз ба?
Dialogue: 0,0:31:25.42,0:31:27.59,Default,,0,0,0,,Бұл сіздің тым адал болғаныңыз үшін.
Dialogue: 0,0:31:32.51,0:31:35.14,Default,,0,0,0,,Сарайға күзет көлігін сатып алыңыз.
Dialogue: 0,0:31:35.26,0:31:36.35,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:31:36.47,0:31:39.23,Default,,0,0,0,,Біз әлі жеңілген жоқпыз, солай ма?
Dialogue: 0,0:31:40.52,0:31:43.35,Default,,0,0,0,,А бұрылысының бар екенін білсеңіз де...
Dialogue: 0,0:31:43.48,0:31:45.82,Default,,0,0,0,,Неліктен Махиро блогын жылжыттыңыз?
Dialogue: 0,0:31:45.94,0:31:49.74,Default,,0,0,0,,О, Агриппа, сіз А бұрылысын көрдіңіз бе?
Dialogue: 0,0:31:49.86,0:31:52.36,Default,,0,0,0,,Мен оны Махироның тобына тексеруді тапсырдым.
Dialogue: 0,0:31:52.49,0:31:54.53,Default,,0,0,0,,Сонымен не істеуіміз керек?
Dialogue: 0,0:31:54.66,0:31:56.70,Default,,0,0,0,,Маған түсініктеме беріңіз (Гинганум отряды) ха!
Dialogue: 0,0:31:56.83,0:31:59.62,Default,,0,0,0,,№3 ауа құлпы ашылады. Голдсмо шығады.
Dialogue: 0,0:32:00.37,0:32:03.17,Default,,0,0,0,,Гарри...қалағаныңды істе.
Dialogue: 0,0:32:11.67,0:32:12.43,Default,,0,0,0,,Не?
Dialogue: 0,0:32:12.55,0:32:14.22,Default,,0,0,0,,Айналма жолмен жүру-
Dialogue: 0,0:32:14.34,0:32:16.55,Default,,0,0,0,,Мен Генганамға қосылуды ойладым.
Dialogue: 0,0:32:16.76,0:32:18.47,Default,,0,0,0,,Мен бұл аймақта ешқашан болған емеспін.
Dialogue: 0,0:32:27.40,0:32:28.90,Default,,0,0,0,,Не болды?
Dialogue: 0,0:32:29.11,0:32:30.61,Default,,0,0,0,,Мен осындай жердемін...
Dialogue: 0,0:32:30.74,0:32:33.03,Default,,0,0,0,,Мен мобильді костюмдер тобын білмеймін.
Dialogue: 0,0:32:33.15,0:32:34.28,Default,,0,0,0,,Иә
Dialogue: 0,0:32:43.21,0:32:44.87,Default,,0,0,0,,Мен де ол мобильді костюм туралы білмеймін.
Dialogue: 0,0:32:45.00,0:32:47.63,Default,,0,0,0,,Бұл тау циклі сияқты.
Dialogue: 0,0:32:47.75,0:32:48.71,Default,,0,0,0,,Таудағы велосипед тебу?
Dialogue: 0,0:32:52.26,0:32:54.18,Default,,0,0,0,,Мұқият тыңда, Жер.
Dialogue: 0,0:32:54.63,0:32:56.47,Default,,0,0,0,,Маған ақ сақалды берші.
Dialogue: 0,0:32:56.59,0:33:00.68,Default,,0,0,0,,Олай болмаса, сарайдағы үш досыңды өлтіремін.
Dialogue: 0,0:33:01.27,0:33:04.19,Default,,0,0,0,,Не... неге мұндай нәрсені ойлап табасың?
Dialogue: 0,0:33:07.61,0:33:10.02,Default,,0,0,0,,Айдың тау циклі...
Dialogue: 0,0:33:10.19,0:33:12.74,Default,,0,0,0,,Соны соққан дұрыс емес пе еді?
Dialogue: 0,0:33:13.24,0:33:17.12,Default,,0,0,0,,Жоқ, Диананың қауіпсіз екеніне көз жеткізген дұрыс.
Dialogue: 0,0:33:17.24,0:33:18.16,Default,,0,0,0,,Хаа…
Dialogue: 0,0:33:19.87,0:33:24.37,Default,,0,0,0,,Барымтада отырған біз емес, мына сарай.
Dialogue: 0,0:33:24.50,0:33:26.92,Default,,0,0,0,,Өтінемін, ашуланбаңыз.
Dialogue: 0,0:33:27.04,0:33:29.59,Default,,0,0,0,,Дипломатиялық келіссөздер басталғалы жатыр.
Dialogue: 0,0:33:30.25,0:33:31.92,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,0:33:32.59,0:33:33.55,Default,,0,0,0,,Мен бөлшектерді көре алмаймын
Dialogue: 0,0:33:33.84,0:33:35.72,Default,,0,0,0,,О, солай ма?
Dialogue: 0,0:33:35.84,0:33:38.93,Default,,0,0,0,,Агриппа немесе Гим Гуинганум болсын.
Dialogue: 0,0:33:39.05,0:33:40.43,Default,,0,0,0,,Менің ойымша, сізге сақал керек.
Dialogue: 0,0:33:41.18,0:33:45.06,Default,,0,0,0,,Бірақ егер біз Роландқа оны оған бер деп айтпасақ...
Dialogue: 0,0:33:45.77,0:33:46.69,Default,,0,0,0,,Мен оны саған бермеймін.
Dialogue: 0,0:33:47.10,0:33:47.81,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:33:48.35,0:33:51.44,Default,,0,0,0,,А бұрылысы мен Х бұрылысы нені білдіреді?
Dialogue: 0,0:33:52.40,0:33:54.15,Default,,0,0,0,,Бұл маған да қатысты...
Dialogue: 0,0:33:54.28,0:33:55.61,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:33:55.74,0:33:56.45,Default,,0,0,0,,Мидгард
Dialogue: 0,0:34:00.66,0:34:05.37,Default,,0,0,0,,Өйткені, Миришаның жүгері еті айда жесең де дәмді болады.
Dialogue: 0,0:34:05.50,0:34:06.62,Default,,0,0,0,,Мені есіңде бар ғой, иә?
Dialogue: 0,0:34:06.83,0:34:09.63,Default,,0,0,0,,Сиыр мен қой шынымен бар ма? мұнда
Dialogue: 0,0:34:09.75,0:34:10.71,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:34:11.54,0:34:13.59,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:34:14.42,0:34:16.38,Default,,0,0,0,,Осындай нәрселер мені қуантады.
Dialogue: 0,0:34:16.51,0:34:17.42,Default,,0,0,0,,Өтірік
Dialogue: 0,0:34:17.55,0:34:18.68,Default,,0,0,0,,О, бұл рас.
Dialogue: 0,0:34:19.22,0:34:20.55,Default,,0,0,0,,Сіз айтқан сәтте...
Dialogue: 0,0:34:21.55,0:34:24.06,Default,,0,0,0,,Егер сіздің әпкеңіз немесе Диана ханым болса...
Dialogue: 0,0:34:24.18,0:34:27.14,Default,,0,0,0,,Сіз өзіңізді бақыттымын деп ойладыңыз.
Dialogue: 0,0:34:27.27,0:34:30.31,Default,,0,0,0,,(Меченің күлкісі)
Dialogue: 0,0:34:33.94,0:34:35.61,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:34:35.73,0:34:38.95,Default,,0,0,0,,Ах, Мондблюмнің иісі.
Dialogue: 0,0:34:40.74,0:34:42.28,Default,,0,0,0,,Бұл жердің жері ме?\NЕгер бұл
Dialogue: 0,0:34:42.41,0:34:45.12,Default,,0,0,0,,болса, какао да күтуге болады.
Dialogue: 0,0:34:45.66,0:34:46.54,Default,,0,0,0,,Иә
Dialogue: 0,0:34:47.29,0:34:50.54,Default,,0,0,0,,Бүкіл Америкадан келген Милишаның біріккен күштері...
Dialogue: 0,0:34:50.67,0:34:53.75,Default,,0,0,0,,Толық жабдықталған осында жиналды.
Dialogue: 0,0:34:53.92,0:34:58.13,Default,,0,0,0,,Moonwraith Күн белдеуі республикасын құрғысы келеді...
Dialogue: 0,0:34:58.30,0:35:00.68,Default,,0,0,0,,Сізге мұнымен не істеуге болатынын көрсетуге рұқсат етіңіз.
Dialogue: 0,0:35:00.97,0:35:03.14,Default,,0,0,0,,Үлкен D операциясының басталуы
Dialogue: 0,0:35:03.43,0:35:04.35,Default,,0,0,0,,Қасық алыңыз
Dialogue: 0,0:35:04.64,0:35:06.22,Default,,0,0,0,,Даусыңды естігім келді. Сені көргім келді.
Dialogue: 0,0:35:06.89,0:35:08.02,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:35:08.14,0:35:08.81,Default,,0,0,0,,Менің алдымда тұр
Dialogue: 0,0:35:09.31,0:35:12.44,Default,,0,0,0,,Кит Лужананың Милишасы тамақ іше бастады.
Dialogue: 0,0:35:12.65,0:35:13.77,Default,,0,0,0,,Өйткені бұл соңғы рет
Dialogue: 0,0:35:14.36,0:35:16.61,Default,,0,0,0,,Неліктен бұл стратегия?
Dialogue: 0,0:35:16.82,0:35:17.69,Default,,0,0,0,,Лорд Борджиано -
Dialogue: 0,0:35:17.82,0:35:19.90,Default,,0,0,0,,Сіздің талғамыңыз жақсы.
Dialogue: 0,0:35:20.15,0:35:22.37,Default,,0,0,0,,Полковник Филдің жеке басын қарастыру.
Dialogue: 0,0:35:22.49,0:35:24.70,Default,,0,0,0,,Ружанадан, Ингресса Милиядан да асып түспеу керек
Dialogue: 0,0:35:24.83,0:35:26.12,Default,,0,0,0,,Тыныш тамақтаныңыз
Dialogue: 0,0:35:26.83,0:35:29.83,Default,,0,0,0,,Онда! Шу шығаратын сорпаны жемеңіз
Dialogue: 0,0:35:30.16,0:35:32.00,Default,,0,0,0,,Әдепсіз адам сенсің.
Dialogue: 0,0:35:32.63,0:35:35.21,Default,,0,0,0,,Маллиган Маған тәрелкені ұстауға рұқсат етіңіз.
Dialogue: 0,0:35:35.75,0:35:37.05,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:35:37.17,0:35:41.18,Default,,0,0,0,,Шарасыз кешкі ас кезінде сыпайы болу керек.
Dialogue: 0,0:35:46.18,0:35:48.98,Default,,0,0,0,,Оң қанатта төрт милиция легиондары бар.
Dialogue: 0,0:35:49.31,0:35:53.06,Default,,0,0,0,,Сіз милицияның біріккен күштері біздің флотты қоршап жатыр деп айтасыз.
Dialogue: 0,0:35:53.19,0:35:55.90,Default,,0,0,0,,Партия сол қанат армиясынан басталады.
Dialogue: 0,0:35:56.02,0:35:57.44,Default,,0,0,0,,Неліктен партия?
Dialogue: 0,0:35:58.11,0:35:59.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:01.95,0:36:02.99,Default,,0,0,0,,Жалаңаш билеу?
Dialogue: 0,0:36:03.61,0:36:05.24,Default,,0,0,0,,Кел... (Милиша солдат) Аумин
Dialogue: 0,0:36:05.37,0:36:06.53,Default,,0,0,0,,Намами дабутсу
Dialogue: 0,0:36:06.66,0:36:08.45,Default,,0,0,0,,Ет ұры! (Милиша солдат) А?
Dialogue: 0,0:36:09.00,0:36:12.75,Default,,0,0,0,,Ооооо... біздің ет
Dialogue: 0,0:36:13.83,0:36:14.83,Default,,0,0,0,,Мен сені екеуіңді де жақсы көремін, сондықтан оны өзім бергім келеді.
Dialogue: 0,0:36:14.96,0:36:18.67,Default,,0,0,0,,Бұл шайқасқа көнсек, Генганам жойылады.
Dialogue: 0,0:36:18.84,0:36:21.09,Default,,0,0,0,,Менің ата-бабам салған қала қандай?
Dialogue: 0,0:36:21.47,0:36:22.22,Default,,0,0,0,,Иә.
Dialogue: 0,0:36:22.34,0:36:27.05,Default,,0,0,0,,Ал мен А бұрылысымен күресіп, көбелекке айнала алмаймын.
Dialogue: 0,0:36:27.47,0:36:29.18,Default,,0,0,0,,А... көбелек?
Dialogue: 0,0:36:29.64,0:36:32.14,Default,,0,0,0,,X бұрылысы деректері әлі талданбаған.
Dialogue: 0,0:36:32.48,0:36:35.61,Default,,0,0,0,,Көбелектердің арқасында айға қарсы адамдар жойылады...
Dialogue: 0,0:36:35.98,0:36:37.57,Default,,0,0,0,,Маған айтудың қажеті жоқ
Dialogue: 0,0:36:37.82,0:36:38.94,Default,,0,0,0,,Га
Dialogue: 0,0:36:39.07,0:36:41.32,Default,,0,0,0,,Mountain Cycle's Marybell-ге қосылыңыз
Dialogue: 0,0:36:41.49,0:36:43.11,Default,,0,0,0,,О... тынышталыңыз.
Dialogue: 0,0:36:43.24,0:36:45.24,Default,,0,0,0,,Барлығын бірден басайық.
Dialogue: 0,0:36:51.25,0:36:54.08,Default,,0,0,0,,Мен сонда бара жатырмын, бірақ бұл шұғыл.
Dialogue: 0,0:36:54.29,0:36:56.25,Default,,0,0,0,,Сіз мұны істей аласыз ба? (Мэрибелл) Хехехе
Dialogue: 0,0:36:56.38,0:36:59.17,Default,,0,0,0,,Өйткені Қарақшылар мен X бұрылысы бірдей сезінеді.
Dialogue: 0,0:36:59.34,0:37:00.13,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:37:02.76,0:37:05.43,Default,,0,0,0,,Бөренелер жоқ. Ақ сарайдың алдында.
Dialogue: 0,0:37:05.55,0:37:06.59,Default,,0,0,0,,Хмм?
Dialogue: 0,0:37:07.39,0:37:11.06,Default,,0,0,0,,Полковник Роланд Майкл да соғысатынын айтты.
Dialogue: 0,0:37:13.73,0:37:16.65,Default,,0,0,0,,Ай бетінен 100 метр қашықтықта ма?
Dialogue: 0,0:37:16.90,0:37:20.19,Default,,0,0,0,,Дұрыс. Ол тікелей Ақ сарайға барады.
Dialogue: 0,0:37:20.61,0:37:21.61,Default,,0,0,0,,Ах
Dialogue: 0,0:37:24.20,0:37:26.41,Default,,0,0,0,,Жер астында орман бар.
Dialogue: 0,0:37:26.61,0:37:30.99,Default,,0,0,0,,Гиганум, Махироны дәл Ақ сарайдың алдына әкел.
Dialogue: 0,0:37:31.16,0:37:33.33,Default,,0,0,0,,Бұл Диана ханымның сарайы ма?
Dialogue: 0,0:37:33.54,0:37:34.25,Default,,0,0,0,,Иә
Dialogue: 0,0:37:34.41,0:37:36.00,Default,,0,0,0,,Бірақ әзірге...
Dialogue: 0,0:37:36.12,0:37:38.08,Default,,0,0,0,,Жаудың қорғаны ма?
Dialogue: 0,0:37:38.58,0:37:40.29,Default,,0,0,0,,Лоран шын айтасыз ба?
Dialogue: 0,0:37:40.59,0:37:42.30,Default,,0,0,0,,Ақ қуыршақты беріңіз
Dialogue: 0,0:37:42.42,0:37:44.09,Default,,0,0,0,,Олай десеңіз, мен...
Dialogue: 0,0:37:44.22,0:37:44.80,Default,,0,0,0,,Мен темекі шегуді тастадым
Dialogue: 0,0:37:44.92,0:37:46.88,Default,,0,0,0,,А бұрылысындағы ұшқыш.
Dialogue: 0,0:37:47.01,0:37:47.80,Default,,0,0,0,,А, не?
Dialogue: 0,0:37:49.18,0:37:50.76,Default,,0,0,0,,Құрметті Агриппа күтімшісі
Dialogue: 0,0:37:50.89,0:37:53.98,Default,,0,0,0,,Егер А бұрылысы X бұрылысын жеңе алса...
Dialogue: 0,0:37:54.10,0:37:56.48,Default,,0,0,0,,Барлық жердегілерді азат етейік.
Dialogue: 0,0:37:56.77,0:37:58.19,Default,,0,0,0,,X бұрылысы?
Dialogue: 0,0:37:58.44,0:38:00.94,Default,,0,0,0,,Бірақ айда? Не?
Dialogue: 0,0:38:01.27,0:38:02.78,Default,,0,0,0,,Егер сіз X бұрылысын жеңсеңіз
Dialogue: 0,0:38:02.90,0:38:05.99,Default,,0,0,0,,Мен де бұл сарайды Диана ханымға тапсырамын.
Dialogue: 0,0:38:08.74,0:38:10.78,Default,,0,0,0,,Мен Ақ қуыршаққа мінемін
Dialogue: 0,0:38:11.20,0:38:13.41,Default,,0,0,0,,Мылтықты қойыңыз, Мидгард
Dialogue: 0,0:38:13.54,0:38:14.20,Default,,0,0,0,,Га
Dialogue: 0,0:38:15.00,0:38:16.83,Default,,0,0,0,,Мен X бұрылысын айттым...
Dialogue: 0,0:38:16.96,0:38:20.08,Default,,0,0,0,,Сіз Гинганам отрядындағы ең күшті механикалық қуыршақсыз ба?
Dialogue: 0,0:38:20.33,0:38:22.67,Default,,0,0,0,,Сенің солай ойлағаныңа қуаныштымын.
Dialogue: 0,0:38:22.80,0:38:24.34,Default,,0,0,0,,Иә? Хаа...
Dialogue: 0,0:38:25.63,0:38:28.30,Default,,0,0,0,,Мен сізге жағымсыз сұрақ қойғым келеді.
Dialogue: 0,0:38:28.47,0:38:30.80,Default,,0,0,0,,Өтінемін, жас ханым.
Dialogue: 0,0:38:30.93,0:38:33.56,Default,,0,0,0,,Неліктен Диананы өлтірмек болдыңыз?
Dialogue: 0,0:38:34.06,0:38:35.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:35.18,0:38:37.31,Default,,0,0,0,,Жердің тыныштығына қауіп төндіретіндер -
Dialogue: 0,0:38:37.44,0:38:39.94,Default,,0,0,0,,Жазалағысы келетіндер бар.
Dialogue: 0,0:38:40.19,0:38:43.48,Default,,0,0,0,,Жерді қайтару операциясында, Moonwraith...
Dialogue: 0,0:38:43.61,0:38:46.40,Default,,0,0,0,,Ежелгі жауынгерлік инстинкт қайта оралды.
Dialogue: 0,0:38:47.19,0:38:50.41,Default,,0,0,0,,Олай болса, Диананы өлтіретін адамдар бар.
Dialogue: 0,0:38:50.95,0:38:52.37,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:38:53.74,0:38:55.75,Default,,0,0,0,,Мені люктен шығаруыңызды өтінемін.
Dialogue: 0,0:38:55.87,0:38:56.66,Default,,0,0,0,,Уау
Dialogue: 0,0:38:58.04,0:39:00.33,Default,,0,0,0,,Сіз... Агриппадансыз.
Dialogue: 0,0:39:01.13,0:39:02.42,Default,,0,0,0,,Электр қуатын өшіру?
Dialogue: 0,0:39:04.42,0:39:05.46,Default,,0,0,0,,Әлі күндіз.
Dialogue: 0,0:39:17.73,0:39:19.94,Default,,0,0,0,,Электр қуатының үзілуі сирек кездеседі ме?
Dialogue: 0,0:39:20.10,0:39:22.31,Default,,0,0,0,,Бұл менің Генганамға бірінші рет келуім.
Dialogue: 0,0:39:24.36,0:39:27.44,Default,,0,0,0,,Бұл жерден күшпен кетеміз бе?
Dialogue: 0,0:39:27.57,0:39:29.03,Default,,0,0,0,,Иә, ә...
Dialogue: 0,0:39:34.33,0:39:36.12,Default,,0,0,0,,Мұнда да электр жарығы бар.
Dialogue: 0,0:39:36.24,0:39:38.08,Default,,0,0,0,,Мен бұл туралы білмеймін.
Dialogue: 0,0:39:53.76,0:39:56.51,Default,,0,0,0,,(Мэрибеллдің күлкісі)
Dialogue: 0,0:39:57.06,0:40:00.10,Default,,0,0,0,,Gim Ginganum X бұрылысы жылжытылды.
Dialogue: 0,0:40:00.48,0:40:04.11,Default,,0,0,0,,Мен Генганамның барлық электр қуатын алып, оны стартерге айналдырдым.
Dialogue: 0,0:40:05.15,0:40:08.78,Default,,0,0,0,,Үлкен қуыршаққа ұқсайды... оны Гимге қолдануға болады ма? Бұл
Dialogue: 0,0:40:09.86,0:40:12.86,Default,,0,0,0,,Мен оны қазбадан бері зерттеп келемін. Маған қалдырыңыз.
Dialogue: 0,0:40:13.61,0:40:16.37,Default,,0,0,0,,Электр қуатының үзілуі түзетілгенде... Иә? ау
Dialogue: 0,0:40:16.99,0:40:18.49,Default,,0,0,0,,Артқы рельеф қозғалды.
Dialogue: 0,0:40:18.62,0:40:20.16,Default,,0,0,0,,Гвен мырза, не болып жатыр?
Dialogue: 0,0:40:20.29,0:40:21.83,Default,,0,0,0,,Өтінемін... тұрыңыз.
Dialogue: 0,0:40:22.21,0:40:23.87,Default,,0,0,0,,Кейсан, түс.
Dialogue: 0,0:40:31.13,0:40:33.51,Default,,0,0,0,,Алтын түрі осындай жерде...
Dialogue: 0,0:40:33.63,0:40:35.18,Default,,0,0,0,,Капитан Гарри Орд?
Dialogue: 0,0:40:35.30,0:40:36.47,Default,,0,0,0,,Тіпті Мистер Киль
Dialogue: 0,0:40:39.18,0:40:41.60,Default,,0,0,0,,Сіз өзіңізбен Диана Сорел ханымды әкелдіңіз бе?
Dialogue: 0,0:40:45.35,0:40:47.19,Default,,0,0,0,,Құрметті Гарри, қазір бұл туралы.
Dialogue: 0,0:40:47.31,0:40:50.19,Default,,0,0,0,,Тоқта, Мидгард, мен Дианамын.
Dialogue: 0,0:40:50.65,0:40:52.45,Default,,0,0,0,,Мидгард Диана - мен
Dialogue: 0,0:40:52.57,0:40:54.66,Default,,0,0,0,,２…
Dialogue: 0,0:40:54.78,0:40:55.41,Default,,0,0,0,,Уф...
Dialogue: 0,0:40:57.24,0:40:59.62,Default,,0,0,0,,Командалық билік патшайымға қайтарылуы керек.
Dialogue: 0,0:40:59.79,0:41:02.33,Default,,0,0,0,,Жердегілердің нұсқауларын орындай аласыз ба?
Dialogue: 0,0:41:03.04,0:41:04.67,Default,,0,0,0,,Не істегеніңіз туралы ойланыңыз
Dialogue: 0,0:41:05.21,0:41:08.34,Default,,0,0,0,,Moonwraith инстинкттермен күресудің қажеті жоқ.
Dialogue: 0,0:41:08.46,0:41:10.59,Default,,0,0,0,,Неліктен жекпе-жек шебері Гим Гуинганум...
Dialogue: 0,0:41:10.71,0:41:11.59,Default,,0,0,0,,Екеуміз қол ұстастық.
Dialogue: 0,0:41:11.96,0:41:14.76,Default,,0,0,0,,Қазылған X бұрылысын талдау
Dialogue: 0,0:41:14.88,0:41:18.43,Default,,0,0,0,,Бізге олардың көмегі қажет болды.
Dialogue: 0,0:41:18.68,0:41:20.18,Default,,0,0,0,,X бұрылысы дегеніміз не?
Dialogue: 0,0:41:20.31,0:41:21.93,Default,,0,0,0,,А бұрылысымен бірдей
Dialogue: 0,0:41:22.14,0:41:23.73,Default,,0,0,0,,Ай және жер өркениеті...
Dialogue: 0,0:41:23.85,0:41:26.52,Default,,0,0,0,,Бұл жойылуы мүмкін нәрсе.
Dialogue: 0,0:41:26.94,0:41:27.69,Default,,0,0,0,,«Біз оның әйелі мен балаларын қауіпсіз жерге жеткіздік»
Dialogue: 0,0:41:30.19,0:41:31.98,Default,,0,0,0,,Бақылаудың қажеті жоқ
Dialogue: 0,0:41:32.28,0:41:33.61,Default,,0,0,0,,Жоғарыда айтылған электр қуатының үзілуі
Dialogue: 0,0:41:33.94,0:41:36.99,Default,,0,0,0,,Айда да тау циклі болған сияқты.
Dialogue: 0,0:41:37.62,0:41:39.83,Default,,0,0,0,,Мен Қысқы сарайдың қауіпсіздігіне алаңдаймын.
Dialogue: 0,0:41:39.95,0:41:42.41,Default,,0,0,0,,Қысқы сарай...? иә
Dialogue: 0,0:41:42.75,0:41:43.83,Default,,0,0,0,,Гарри, міне келдік.
Dialogue: 0,0:41:44.00,0:41:45.08,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:41:45.29,0:41:45.96,Default,,0,0,0,,Биік өкшелі туфли?
Dialogue: 0,0:41:48.29,0:41:49.79,Default,,0,0,0,,Маған осында қалдырыңыз.
Dialogue: 0,0:41:51.13,0:41:52.21,Default,,0,0,0,,Киль-сан Лили-сама
Dialogue: 0,0:42:08.77,0:42:10.90,Default,,0,0,0,,Не?
Dialogue: 0,0:42:14.61,0:42:17.95,Default,,0,0,0,,Ол X бұрылыс деп аталады. Бұл балалар бір-бірін шақырып жатыр ма?
Dialogue: 0,0:42:45.43,0:42:46.73,Default,,0,0,0,,Ақ қуыршақ -
Dialogue: 0,0:42:46.85,0:42:49.31,Default,,0,0,0,,Мен бұл жылжымалы костюм туралы білемін.
Dialogue: 0,0:42:49.48,0:42:50.56,Default,,0,0,0,,X бұрылысы…
Dialogue: 0,0:42:57.36,0:43:00.20,Default,,0,0,0,,Қараңғы тарихты білмейтін ақымақтарға лезде өлім беріледі.
Dialogue: 0,0:43:10.46,0:43:12.42,Default,,0,0,0,,А бұрылысы мен X бұрылысы
Dialogue: 0,0:43:12.54,0:43:14.46,Default,,0,0,0,,Сізге ұшақты қатар тексеру қажет.
Dialogue: 0,0:43:15.17,0:43:17.05,Default,,0,0,0,,Мен сенің не айтып тұрғаныңды білемін.
Dialogue: 0,0:43:17.17,0:43:20.30,Default,,0,0,0,,Сондықтан біз деректерді жинап жатырмыз, уайымдамаңыз.
Dialogue: 0,0:43:20.51,0:43:21.68,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:43:25.39,0:43:26.39,Default,,0,0,0,,Гингем отбасы -
Dialogue: 0,0:43:26.52,0:43:29.02,Default,,0,0,0,,Менің міндетім - Мунврейтті басқаратын Сорел отбасын қорғау.
Dialogue: 0,0:43:29.60,0:43:33.31,Default,,0,0,0,,Ａ
Dialogue: 0,0:43:33.86,0:43:37.40,Default,,0,0,0,,...
Dialogue: 0,0:43:37.90,0:43:40.03,Default,,0,0,0,,Қызықты оқиға
Dialogue: 0,0:43:40.32,0:43:43.87,Default,,0,0,0,,Көп уақыт бұрын, X бұрылысы сізді жеңе алмады.
Dialogue: 0,0:43:43.99,0:43:44.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:44.99,0:43:46.16,Default,,0,0,0,,Хехехе
Dialogue: 0,0:43:46.33,0:43:51.21,Default,,0,0,0,,Сол себепті X Turn-тің кеуде жарақаты ауырады.
Dialogue: 0,0:43:51.62,0:43:53.13,Default,,0,0,0,,Жараның X бұрылысы?
Dialogue: 0,0:43:54.13,0:43:55.63,Default,,0,0,0,,Не дедің!
Dialogue: 0,0:43:55.79,0:43:58.96,Default,,0,0,0,,...
Dialogue: 0,0:43:59.80,0:44:01.51,Default,,0,0,0,,Бұл адам адасып қалды
Dialogue: 0,0:44:02.18,0:44:04.05,Default,,0,0,0,,Лола Лола!
Dialogue: 0,0:44:06.81,0:44:09.31,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,0:44:12.90,0:44:13.69,Default,,0,0,0,,Жалпы
Dialogue: 0,0:44:13.81,0:44:16.73,Default,,0,0,0,,Жер тұрғындары Ақ сарайға басып кірген сияқты.
Dialogue: 0,0:44:17.48,0:44:19.74,Default,,0,0,0,,Не? жай қалдырыңыз
Dialogue: 0,0:44:19.90,0:44:23.57,Default,,0,0,0,,100
Dialogue: 0,0:44:26.45,0:44:29.54,Default,,0,0,0,,...
Dialogue: 0,0:44:29.66,0:44:30.75,Default,,0,0,0,,Жандарм?
Dialogue: 0,0:44:30.87,0:44:31.91,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:44:32.54,0:44:34.29,Default,,0,0,0,,Қара тарих деректерін зерттеу
Dialogue: 0,0:44:34.42,0:44:38.05,Default,,0,0,0,,ＡＸ ―
Dialogue: 0,0:44:38.17,0:44:40.76,Default,,0,0,0,,...
Dialogue: 0,0:44:45.72,0:44:47.68,Default,,0,0,0,,(Мэрибеллдің күлкісі)
Dialogue: 0,0:44:52.81,0:44:53.81,Default,,0,0,0,,Не?
Dialogue: 0,0:44:57.86,0:44:58.90,Default,,0,0,0,,Оқ жаудырыңдар! Бүйіріне нысана ал!
Dialogue: 0,0:45:07.87,0:45:13.75,Default,,0,0,0,,(Механикалық қуыршақтың ізі)
Dialogue: 0,0:45:14.25,0:45:16.96,Default,,0,0,0,,...
Dialogue: 0,0:45:17.21,0:45:18.71,Default,,0,0,0,,Бұл анық.
Dialogue: 0,0:45:18.84,0:45:19.55,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:45:22.51,0:45:23.42,Default,,0,0,0,,Қай жолмен?
Dialogue: 0,0:45:24.09,0:45:26.51,Default,,0,0,0,,...
Dialogue: 0,0:45:26.64,0:45:27.30,Default,,0,0,0,,Иә
Dialogue: 0,0:45:27.43,0:45:28.97,Default,,0,0,0,,Таңбашаларды қолдану
Dialogue: 0,0:45:32.06,0:45:34.39,Default,,0,0,0,,...
Dialogue: 0,0:45:34.73,0:45:37.98,Default,,0,0,0,,Мені көне тарих қызықтырмайды... Ол не?
Dialogue: 0,0:45:38.44,0:45:40.77,Default,,0,0,0,,Болжернон Милицияға кешікпе
Dialogue: 0,0:45:44.32,0:45:46.53,Default,,0,0,0,,Иә? Анау механикалық қуыршақ...
Dialogue: 0,0:45:47.36,0:45:49.20,Default,,0,0,0,,Мисс Лили Борджиано
Dialogue: 0,0:45:50.16,0:45:51.70,Default,,0,0,0,,Джон Эймс ше?
Dialogue: 0,0:45:52.33,0:45:54.96,Default,,0,0,0,,Мен Лужананың жігіттерінен бұрын ішке кірдім.
Dialogue: 0,0:45:55.41,0:45:57.71,Default,,0,0,0,,Бұл бөлмеде ештеңеге қол тигізбеңіз.
Dialogue: 0,0:45:57.83,0:45:59.59,Default,,0,0,0,,Ештеңе болуы мүмкін емес, солай ма?
Dialogue: 0,0:45:59.71,0:46:01.80,Default,,0,0,0,,Балық аулайтын төбедей қақпан бар емес пе?
Dialogue: 0,0:46:02.30,0:46:04.72,Default,,0,0,0,,Бұл бөлмеде қараңғы тарихтың жазбалары бар ма?
Dialogue: 0,0:46:05.30,0:46:08.34,Default,,0,0,0,,Бірақ, бірде-бір кітап қалмаған сияқты.
Dialogue: 0,0:46:08.47,0:46:12.72,Default,,0,0,0,,Кітаптар туралы не деуге болады? Сондықтан мен варварлармен араласқым келмейді.
Dialogue: 0,0:46:12.89,0:46:14.14,Default,,0,0,0,,Алдын ала пікір айту
Dialogue: 0,0:46:14.39,0:46:15.93,Default,,0,0,0,,Мәртебелі Диана Солер?
Dialogue: 0,0:46:16.19,0:46:18.40,Default,,0,0,0,,Менің бар ойым – Айда қалу.
Dialogue: 0,0:46:18.52,0:46:20.15,Default,,0,0,0,,Агриппа күтімшісі
Dialogue: 0,0:46:20.31,0:46:22.02,Default,,0,0,0,,Күшпен ойнау -
Dialogue: 0,0:46:22.32,0:46:25.11,Default,,0,0,0,,Джим Гинганаммен бірге болу үшін...
Dialogue: 0,0:46:25.36,0:46:30.24,Default,,0,0,0,,Неліктен көне тарих қара тарих деп аталды?
Dialogue: 0,0:46:30.37,0:46:32.20,Default,,0,0,0,,Оның мағынасы туралы ойланыңыз.
Dialogue: 0,0:46:32.66,0:46:34.79,Default,,0,0,0,,Қара тарих ашылғанда...
Dialogue: 0,0:46:34.91,0:46:37.96,Default,,0,0,0,,Жердегілер ештеңені түсіне алмайды.
Dialogue: 0,0:46:38.08,0:46:39.79,Default,,0,0,0,,Бұл да теріс пікір
Dialogue: 0,0:46:42.79,0:46:45.80,Default,,0,0,0,,Бұл жай ғана заттарды білу туралы емес.
Dialogue: 0,0:46:45.92,0:46:49.38,Default,,0,0,0,,Кейде білу шатастыруға әкелуі мүмкін.
Dialogue: 0,0:46:49.51,0:46:50.22,Default,,0,0,0,,Уф
Dialogue: 0,0:46:50.34,0:46:51.30,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:46:51.76,0:46:53.43,Default,,0,0,0,,1 миллион адам тұратын үй -
Dialogue: 0,0:46:53.56,0:46:56.23,Default,,0,0,0,,Ғарыштық колония Жерге құлағалы тұр.
Dialogue: 0,0:46:59.44,0:47:02.40,Default,,0,0,0,,Ғарыштық колония? Ол жерге түседі ме?
Dialogue: 0,0:47:02.61,0:47:03.86,Default,,0,0,0,,Бұл фильм емес пе?
Dialogue: 0,0:47:04.40,0:47:05.98,Default,,0,0,0,,Ежелгі тарихтың жазбалары
Dialogue: 0,0:47:06.11,0:47:08.24,Default,,0,0,0,,Ғарышта кемелер ұшады ма?
Dialogue: 0,0:47:08.36,0:47:11.99,Default,,0,0,0,,Бұл Батыс күнтізбесі Дүниежүзілік ғасырға ауысқан кезде орын алған ғарыш соғысы.
Dialogue: 0,0:47:12.70,0:47:14.79,Default,,0,0,0,,Ақ қуыршақ пен Болджернон.
Dialogue: 0,0:47:15.12,0:47:18.33,Default,,0,0,0,,Соғыстың ұзақ тарихы болды.
Dialogue: 0,0:47:18.50,0:47:20.50,Default,,0,0,0,,Адамзаттың соңғы соғысы ретінде
Dialogue: 0,0:47:22.13,0:47:25.92,Default,,0,0,0,,Бауырым, бұл 3D сурет сіз жасаған мазақ қана.
Dialogue: 0,0:47:26.34,0:47:30.09,Default,,0,0,0,,Жоқ, бұл X бұрылысының жұмысы емес пе?
Dialogue: 0,0:47:33.55,0:47:35.51,Default,,0,0,0,,Ол қайдан келеді?
Dialogue: 0,0:47:36.22,0:47:38.06,Default,,0,0,0,,Қысқы сарай?
Dialogue: 0,0:47:41.02,0:47:41.60,Default,,0,0,0,,Ха…
Dialogue: 0,0:47:43.81,0:47:46.11,Default,,0,0,0,,Мэрибелл, сен нені шулатып тұрсың?
Dialogue: 0,0:47:46.23,0:47:47.44,Default,,0,0,0,,А бұрылысы
Dialogue: 0,0:47:49.40,0:47:51.24,Default,,0,0,0,,Ах... X бұрылысы
Dialogue: 0,0:47:54.28,0:47:54.91,Default,,0,0,0,,Қайтадан шықты
Dialogue: 0,0:47:55.41,0:47:56.41,Default,,0,0,0,,Интерференция?
Dialogue: 0,0:47:59.87,0:48:02.54,Default,,0,0,0,,Көрдім, деректер ойнатылып жатыр.
Dialogue: 0,0:48:08.09,0:48:10.67,Default,,0,0,0,,Не? Түтік тәрізді сурет
Dialogue: 0,0:48:15.10,0:48:17.81,Default,,0,0,0,,Бірақ бұл қарапайым әуе мониторы емес.
Dialogue: 0,0:48:17.93,0:48:21.14,Default,,0,0,0,,Дұрыс, Генганамда ондай театр жоқ.
Dialogue: 0,0:48:22.19,0:48:25.23,Default,,0,0,0,,Кадрлар ежелгі Әмбебап ғасырдан алынған.
Dialogue: 0,0:48:25.81,0:48:27.77,Default,,0,0,0,,Әлемдік ғасыр дегеніміз не?
Dialogue: 0,0:48:28.36,0:48:31.28,Default,,0,0,0,,Ақ сарайдан таралатын радиотолқындар ма?
Dialogue: 0,0:48:32.24,0:48:33.24,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:48:33.61,0:48:37.37,Default,,0,0,0,,Диана Сорел жер тұрғындарына қараңғы тарихтың фактілерін көрсетеді.
Dialogue: 0,0:48:37.49,0:48:40.50,Default,,0,0,0,,Жерді қайтарып алудың заңдылығын түсіндіреді.
Dialogue: 0,0:48:40.70,0:48:42.50,Default,,0,0,0,,Бірақ... хахахахахаха
Dialogue: 0,0:48:42.62,0:48:44.58,Default,,0,0,0,,Біздің әлемге көктем келді.
Dialogue: 0,0:48:45.29,0:48:49.05,Default,,0,0,0,,Шынында да, адамдар керемет емес.
Dialogue: 0,0:48:49.17,0:48:50.05,Default,,0,0,0,,(Рион) Егер сұраса, олар әлемнің кез келген түкпіріне барады —
Dialogue: 0,0:48:50.96,0:48:53.26,Default,,0,0,0,,Тау циклі немесе бұрылыс коды
Dialogue: 0,0:48:53.38,0:48:55.93,Default,,0,0,0,,Деректер ешқашан қайтарылмаған
Dialogue: 0,0:48:56.05,0:48:57.64,Default,,0,0,0,,Мүмкін...
Dialogue: 0,0:48:59.22,0:48:59.85,Default,,0,0,0,,Ой
Dialogue: 0,0:48:59.97,0:49:00.77,Default,,0,0,0,,А бұрылысы
Dialogue: 0,0:49:00.89,0:49:03.31,Default,,0,0,0,,Бұл деректерде А бұрылысы...
Dialogue: 0,0:49:03.44,0:49:06.65,Default,,0,0,0,,Бұл жай ғана Жер өркениеті жабылғанын түсіндіреді.
Dialogue: 0,0:49:06.81,0:49:09.86,Default,,0,0,0,,Ай сәулесі көбелек атымен
Dialogue: 0,0:49:19.16,0:49:20.87,Default,,0,0,0,,А бұрылысы -
Dialogue: 0,0:49:20.99,0:49:25.50,Default,,0,0,0,,Наномашиналарды басқаратын бактерияға ұқсас роботтар
Dialogue: 0,0:49:25.71,0:49:28.63,Default,,0,0,0,,Жерді ойран етті
Dialogue: 0,0:49:33.17,0:49:36.72,Default,,0,0,0,,Менен бұрын қара тарихтың шын мәнісін білсең...
Dialogue: 0,0:49:37.34,0:49:40.26,Default,,0,0,0,,Гиганамдарға неліктен көшуге рұқсат бердіңіз?
Dialogue: 0,0:49:40.76,0:49:42.52,Default,,0,0,0,,А бұрылысының функциясы -
Dialogue: 0,0:49:42.64,0:49:47.19,Default,,0,0,0,,Бұл X бұрылыс деректерін алған кезде анықталды.
Dialogue: 0,0:49:47.31,0:49:50.90,Default,,0,0,0,,Механикалық қуыршақтар арасындағы шайқас тек жойылуға әкеледі, солай емес пе?
Dialogue: 0,0:49:51.02,0:49:51.90,Default,,0,0,0,,Сэр Нгуен
Dialogue: 0,0:49:52.03,0:49:55.32,Default,,0,0,0,,Сол нағыз шайқасты шешу менің міндетім.
Dialogue: 0,0:49:55.65,0:49:56.24,Default,,0,0,0,,Құрметті Нгуен
Dialogue: 0,0:49:56.36,0:49:58.57,Default,,0,0,0,,Бұл жаудың аумағы болса да.
Dialogue: 0,0:49:59.49,0:50:02.83,Default,,0,0,0,,Ай билеушісі Диана Сорел бұйрық береді
Dialogue: 0,0:50:03.29,0:50:04.87,Default,,0,0,0,,Сырттағы ұрысты тоқтатыңыз.
Dialogue: 0,0:50:05.00,0:50:06.79,Default,,0,0,0,,Жердегі тыңшыларды алып тастаңыз.
Dialogue: 0,0:50:07.29,0:50:09.38,Default,,0,0,0,,Жердің тартылыс күшімен тартылған -
Dialogue: 0,0:50:09.50,0:50:13.76,Default,,0,0,0,,Жауынгерлік түйсігі оянғандар тыңдасын.
Dialogue: 0,0:50:14.13,0:50:15.17,Default,,0,0,0,,Агриппа
Dialogue: 0,0:50:15.55,0:50:17.05,Default,,0,0,0,,Өлімдік күнәлардың кардиналына тән нәрсе деп айтуға болатын шығар.
Dialogue: 0,0:50:18.80,0:50:21.22,Default,,0,0,0,,Сіз саясаткер ретіндегі міндеттеріңізден бас тартасыз ба?
Dialogue: 0,0:50:21.35,0:50:25.48,Default,,0,0,0,,Жоқ... Сэр Агриппаның айтқаны рас болуы мүмкін.
Dialogue: 0,0:50:28.77,0:50:31.94,Default,,0,0,0,,Айдағы қаланы қиратуыңа жол бере алмаймын.
Dialogue: 0,0:50:38.32,0:50:39.53,Default,,0,0,0,,Бірақ бұл маған ұнамайды
Dialogue: 0,0:50:40.41,0:50:42.41,Default,,0,0,0,,Агриппа қорғасын.
Dialogue: 0,0:50:42.91,0:50:43.83,Default,,0,0,0,,Диана ханым келді.
Dialogue: 0,0:50:43.95,0:50:45.20,Default,,0,0,0,,Мені ондай нәрсе қорқытпайды.
Dialogue: 0,0:50:46.33,0:50:49.21,Default,,0,0,0,,Маған осындай бейнелер көрсетілсе, мен өзімді жайсыз сезінер едім.
Dialogue: 0,0:50:49.75,0:50:50.67,Default,,0,0,0,,Полковник Майкл
Dialogue: 0,0:50:50.79,0:50:52.00,Default,,0,0,0,,Топ басылды
Dialogue: 0,0:50:52.42,0:50:55.42,Default,,0,0,0,,Мен Махироның кемеден портта кетіп бара жатқанын көрдім.
Dialogue: 0,0:50:56.51,0:50:57.76,Default,,0,0,0,,(азаматтардың толқуы)
Dialogue: 0,0:50:57.88,0:50:58.76,Default,,0,0,0,,Құрметті Диана
Dialogue: 0,0:50:59.09,0:51:00.72,Default,,0,0,0,,Шындықты айт
Dialogue: 0,0:51:00.84,0:51:02.26,Default,,0,0,0,,Жерлестерден құтылу
Dialogue: 0,0:51:03.10,0:51:06.43,Default,,0,0,0,,Якоп: Зымыран қозғалтқышын абайсызда іске қоспаңыз.
Dialogue: 0,0:51:06.73,0:51:09.39,Default,,0,0,0,,Көпшілік Вилгемнің құлағында.
Dialogue: 0,0:51:09.52,0:51:12.40,Default,,0,0,0,,Егер Милиша Диананың қамалын қорғап жатса...
Dialogue: 0,0:51:12.52,0:51:14.40,Default,,0,0,0,,Қамалды жаулап алуға болады.
Dialogue: 0,0:51:14.57,0:51:17.11,Default,,0,0,0,,(азаматтардың толқуы)
Dialogue: 0,0:51:17.24,0:51:19.32,Default,,0,0,0,,Соғысқа қарсылық (азамат) Агриппаға тікелей өтініш
Dialogue: 0,0:51:19.45,0:51:20.49,Default,,0,0,0,,(азаматтардың толқуы)
Dialogue: 0,0:51:20.66,0:51:21.53,Default,,0,0,0,,Мен оны жек көремін
Dialogue: 0,0:51:21.66,0:51:22.45,Default,,0,0,0,,Мен оны атып тастадым.
Dialogue: 0,0:51:22.99,0:51:26.16,Default,,0,0,0,,Қараңғы тарихтан қорқу – адамдарды иемдену.
Dialogue: 0,0:51:26.29,0:51:30.46,Default,,0,0,0,,Тіпті азаматтардың да жауынгерлік инстинкті жетелеуі заңды...
Dialogue: 0,0:51:30.62,0:51:33.67,Default,,0,0,0,,Адамдар 2000 жыл бұрынғы тарихқа иланбайды.
Dialogue: 0,0:51:34.29,0:51:37.42,Default,,0,0,0,,Әсіресе бірінші әмбебап ғасырда...
Dialogue: 0,0:51:37.59,0:51:39.63,Default,,0,0,0,,Бұл шын мәнінде 5000 жыл бұрын болуы мүмкін.
Dialogue: 0,0:51:40.05,0:51:41.84,Default,,0,0,0,,Тақырыпты өзгертпеңіз
Dialogue: 0,0:51:41.97,0:51:45.93,Default,,0,0,0,,Жауынгерлік инстинкті оянғандардың оларды жоюдан басқа амалы жоқ.
Dialogue: 0,0:51:46.06,0:51:46.97,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:51:48.23,0:51:48.93,Default,,0,0,0,,Агриппа
Dialogue: 0,0:51:49.06,0:51:52.10,Default,,0,0,0,,Мид Мидгард... Ах...
Dialogue: 0,0:51:52.23,0:51:52.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:51:53.44,0:51:54.02,Default,,0,0,0,,Агриппа
Dialogue: 0,0:51:58.44,0:52:00.65,Default,,0,0,0,,Мәртебелі патшайымның сөзін тыңдасаңыз...
Dialogue: 0,0:52:00.82,0:52:03.03,Default,,0,0,0,,Агриппа әдістерінің кемшіліктерін де көруге болады.
Dialogue: 0,0:52:03.49,0:52:05.66,Default,,0,0,0,,Бірақ ұлы мәртебелі де...
Dialogue: 0,0:52:05.78,0:52:08.95,Default,,0,0,0,,Бұл Агриппа көрсеткендей.
Dialogue: 0,0:52:09.41,0:52:10.54,Default,,0,0,0,,Оны мойындайық
Dialogue: 0,0:52:10.66,0:52:13.67,Default,,0,0,0,,Ай жүйесі үшін сіз бақытсызсыз.
Dialogue: 0,0:52:14.29,0:52:16.71,Default,,0,0,0,,Agrippa Maintainer сияқты
Dialogue: 0,0:52:17.34,0:52:20.34,Default,,0,0,0,,Мен сенің өміріңді осында өткізгеніңді қалаймын.
Dialogue: 0,0:52:20.80,0:52:22.51,Default,,0,0,0,,Айдағы шынайы тұрақтылықты қаласаңыз
Dialogue: 0,0:52:22.93,0:52:24.68,Default,,0,0,0,,Дайын болыңыз! Диана Солер - бұл...
Dialogue: 0,0:52:24.97,0:52:27.01,Default,,0,0,0,,Ооо...
Dialogue: 0,0:52:27.14,0:52:27.85,Default,,0,0,0,,Ұстау
Dialogue: 0,0:52:27.97,0:52:29.43,Default,,0,0,0,,Иә, мен...
Dialogue: 0,0:52:29.68,0:52:32.31,Default,,0,0,0,,Сіздің үкіміңіз жұмсақ болады.
Dialogue: 0,0:52:32.44,0:52:33.52,Default,,0,0,0,,Мидгард және т.б.
Dialogue: 0,0:52:33.69,0:52:34.35,Default,,0,0,0,,Ммм
Dialogue: 0,0:52:34.48,0:52:36.15,Default,,0,0,0,,Лили Борджиано т.б.
Dialogue: 0,0:52:36.27,0:52:37.73,Default,,0,0,0,,Жоқ, ыстық.
Dialogue: 0,0:52:37.86,0:52:39.15,Default,,0,0,0,,Сіз мылтық дыбысын естідіңіз бе?
Dialogue: 0,0:52:39.61,0:52:40.40,Default,,0,0,0,,Босатыңыз
Dialogue: 0,0:52:41.32,0:52:44.95,Default,,0,0,0,,Мен... Агриппадан бас тартқан жоқпын.
Dialogue: 0,0:52:45.07,0:52:46.70,Default,,0,0,0,,Мен солай ойлаймын. Сіз жарақат алдыңыз ба?
Dialogue: 0,0:52:46.83,0:52:48.41,Default,,0,0,0,,А... жоқ.
Dialogue: 0,0:52:48.54,0:52:49.41,Default,,0,0,0,,Жақсы болды.
Dialogue: 0,0:52:50.16,0:52:53.25,Default,,0,0,0,,А... Мен Ай ханшайымына бір нәрсе қарызмын.
Dialogue: 0,0:52:53.62,0:52:55.67,Default,,0,0,0,,Иә, мұны есте сақтаңыз.
Dialogue: 0,0:52:56.33,0:52:56.92,Default,,0,0,0,,Ах!
Dialogue: 0,0:52:57.04,0:52:58.55,Default,,0,0,0,,Жердегілер үйлеріне барады
Dialogue: 0,0:52:58.67,0:53:00.26,Default,,0,0,0,,Диана бортта, солай ма?
Dialogue: 0,0:53:00.38,0:53:02.51,Default,,0,0,0,,Жарайды, ескерту оқын атыңыз.
Dialogue: 0,0:53:02.63,0:53:04.55,Default,,0,0,0,,Әйтеуір, адамның өмірінің соңы—
Dialogue: 0,0:53:04.80,0:53:06.93,Default,,0,0,0,,Жарайды, Қысқы сарайға немесе басқа нәрсеге барыңыз.
Dialogue: 0,0:53:07.05,0:53:07.89,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:53:08.01,0:53:10.43,Default,,0,0,0,,Біз жаман адамдар емеспіз бе?
Dialogue: 0,0:53:15.40,0:53:16.86,Default,,0,0,0,,А бұрылысын ашуландырмаңыз
Dialogue: 0,0:53:16.98,0:53:18.40,Default,,0,0,0,,Ол... бұл не?
Dialogue: 0,0:53:25.07,0:53:26.20,Default,,0,0,0,,Неге тоқтадың?
Dialogue: 0,0:53:26.32,0:53:28.95,Default,,0,0,0,,Бұл нағыз бұрылыс А.
Dialogue: 0,0:53:29.08,0:53:31.41,Default,,0,0,0,,Жігіттен келген деректер...
Dialogue: 0,0:53:31.54,0:53:33.20,Default,,0,0,0,,Мен тексеруім керек
Dialogue: 0,0:53:33.37,0:53:35.75,Default,,0,0,0,,Хахахахаха...
Dialogue: 0,0:53:40.25,0:53:42.30,Default,,0,0,0,,Мен бұл Махироға ешқандай дұшпандық көрмеймін.
Dialogue: 0,0:53:42.42,0:53:44.34,Default,,0,0,0,,Садақты Генганамға бағыттаймын. Ал (Бруно) ше?
Dialogue: 0,0:53:46.09,0:53:46.84,Default,,0,0,0,,Міне келді
Dialogue: 0,0:53:46.97,0:53:48.14,Default,,0,0,0,,Атпаңыз
Dialogue: 0,0:53:48.26,0:53:50.89,Default,,0,0,0,,Ай винасы Қысқы сарайдың мағынасын біледі.
Dialogue: 0,0:53:51.43,0:53:54.06,Default,,0,0,0,,Уф, Мече, атпа.
Dialogue: 0,0:53:54.27,0:53:56.69,Default,,0,0,0,,Вилгемге мінуге дайындал. Кеттік.
Dialogue: 0,0:53:56.81,0:53:57.77,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:53:58.61,0:54:00.07,Default,,0,0,0,,Оу Оу…
Dialogue: 0,0:54:02.94,0:54:05.49,Default,,0,0,0,,Сосиер мырза, сол күмбездің ішінде...
Dialogue: 0,0:54:05.61,0:54:08.28,Default,,0,0,0,,Он миллион Ай Сөйткіштер ұйықтап жатыр.
Dialogue: 0,0:54:08.74,0:54:10.74,Default,,0,0,0,,Жарайсың ба? Бұл жерде ұрысуға болмайды.
Dialogue: 0,0:54:11.33,0:54:14.50,Default,,0,0,0,,Бұл жағдайда екеуі де менің үлкен апаларым.
Dialogue: 0,0:54:15.04,0:54:17.33,Default,,0,0,0,,Бұл энергияның болуы жақсы емес пе?
Dialogue: 0,0:54:17.46,0:54:18.67,Default,,0,0,0,,Сэр Нгуен -
Dialogue: 0,0:54:18.79,0:54:21.63,Default,,0,0,0,,Менімен бірге жол жүрмейтін сияқтысың.
Dialogue: 0,0:54:22.25,0:54:23.38,Default,,0,0,0,,Шынында ма?
Dialogue: 0,0:54:23.51,0:54:29.59,Default,,0,0,0,,Мен жай ғана Айдың таңғажайып технологиясын Жерде бейбіт түрде пайдаланғым келеді.
Dialogue: 0,0:54:34.14,0:54:36.10,Default,,0,0,0,,Жандарм сарайдың алдына кірсін.
Dialogue: 0,0:54:36.23,0:54:36.98,Default,,0,0,0,,Бұл мүмкін емес
Dialogue: 0,0:54:37.39,0:54:39.10,Default,,0,0,0,,Мұны жердегілер жасап жатыр.
Dialogue: 0,0:54:42.15,0:54:44.23,Default,,0,0,0,,Жабу! стерео
Dialogue: 0,0:54:46.15,0:54:47.36,Default,,0,0,0,,Өтеу
Dialogue: 0,0:54:47.49,0:54:48.82,Default,,0,0,0,,Ауылды таптауға болмайды
Dialogue: 0,0:54:51.37,0:54:53.83,Default,,0,0,0,,Әлеумет, сен қайда барасың?
Dialogue: 0,0:54:54.95,0:54:56.45,Default,,0,0,0,,Полковник Майкл ше?
Dialogue: 0,0:54:57.41,0:54:58.54,Default,,0,0,0,,Бұл жерде болуы керек.
Dialogue: 0,0:54:58.67,0:55:00.54,Default,,0,0,0,,Ұрыспа, ұрыспа десем де...
Dialogue: 0,0:55:03.67,0:55:05.01,Default,,0,0,0,,Ха ха болды
Dialogue: 0,0:55:05.34,0:55:07.47,Default,,0,0,0,,Соғыс қалай жүріп жатыр? Генганум ше?
Dialogue: 0,0:55:07.80,0:55:08.38,Default,,0,0,0,,О
Dialogue: 0,0:55:08.51,0:55:11.55,Default,,0,0,0,,Қарсыластар мен одақтастар снарядтарды пайдалана алмай қиналады.
Dialogue: 0,0:55:11.68,0:55:12.68,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:55:13.05,0:55:13.81,Default,,0,0,0,,Отырыңыз.
Dialogue: 0,0:55:14.18,0:55:14.51,Default,,0,0,0,,Тәртіпсіздік қалаға да таралып жатқан көрінеді.
Dialogue: 0,0:55:14.51,0:55:15.64,Default,,0,0,0,,Тәртіпсіздік қалаға да таралып жатқан көрінеді.
Dialogue: 0,0:55:14.51,0:55:15.64,Default,,0,0,0,,Рахмет
Dialogue: 0,0:55:15.64,0:55:16.35,Default,,0,0,0,,Тәртіпсіздік қалаға да таралып жатқан көрінеді.
Dialogue: 0,0:55:16.35,0:55:16.52,Default,,0,0,0,,Тәртіпсіздік қалаға да таралып жатқан көрінеді.
Dialogue: 0,0:55:16.35,0:55:16.52,Default,,0,0,0,,Махаббат та, махаббатсыз неке де
Dialogue: 0,0:55:16.52,0:55:17.39,Default,,0,0,0,,Махаббат та, махаббатсыз неке де
Dialogue: 0,0:55:17.52,0:55:18.48,Default,,0,0,0,,Хигучи расталды.
Dialogue: 0,0:55:18.64,0:55:21.98,Default,,0,0,0,,Бұл капитан Гарри берген киім ауыстыру.
Dialogue: 0,0:55:22.11,0:55:23.11,Default,,0,0,0,,Қарт дене
Dialogue: 0,0:55:23.23,0:55:24.15,Default,,0,0,0,,Сізге қалай ұнайды?
Dialogue: 0,0:55:24.27,0:55:26.07,Default,,0,0,0,,Вилгемді қалаға кіргізе алмайсың ба?
Dialogue: 0,0:55:26.19,0:55:27.32,Default,,0,0,0,,Қазір емес
Dialogue: 0,0:55:28.11,0:55:29.90,Default,,0,0,0,,Қысқы сарайға барыңыз...
Dialogue: 0,0:55:30.03,0:55:32.74,Default,,0,0,0,,Осы деректерді шығара аласыз ба?
Dialogue: 0,0:55:32.91,0:55:35.49,Default,,0,0,0,,Сіз от жағатын орынды тонауды сұрайсыз ба?
Dialogue: 0,0:55:35.70,0:55:36.58,Default,,0,0,0,,Бүкіл жер-
Dialogue: 0,0:55:36.70,0:55:39.29,Default,,0,0,0,,Тағдырдың тағдыры қыл үстінде тұр деп ойламайсың ба?
Dialogue: 0,0:55:43.08,0:55:45.09,Default,,0,0,0,,Бұл жерден кетіңіз, капитан.
Dialogue: 0,0:55:47.21,0:55:48.80,Default,,0,0,0,,Сен ақымақ
Dialogue: 0,0:55:50.05,0:55:52.01,Default,,0,0,0,,Нана... не?
Dialogue: 0,0:55:52.76,0:55:54.51,Default,,0,0,0,,Гуды қайшымен жеңуге мүмкіндік жоқ.
Dialogue: 0,0:55:54.64,0:55:55.60,Default,,0,0,0,,Бар!
Dialogue: 0,0:55:56.26,0:55:57.31,Default,,0,0,0,,О? иә?
Dialogue: 0,0:55:59.23,0:56:00.60,Default,,0,0,0,,Келіңізші, ә
Dialogue: 0,0:56:01.94,0:56:03.19,Default,,0,0,0,,Сақалды жігіт
Dialogue: 0,0:56:05.82,0:56:07.44,Default,,0,0,0,,Сіздің қарсыласыңыз – мен.
Dialogue: 0,0:56:07.65,0:56:09.36,Default,,0,0,0,,Ханым, артқа шегініңіз.
Dialogue: 0,0:56:09.90,0:56:12.07,Default,,0,0,0,,Жерлестер!
Dialogue: 0,0:56:17.58,0:56:18.83,Default,,0,0,0,,А, а... сарайда.
Dialogue: 0,0:56:23.88,0:56:26.00,Default,,0,0,0,,Менің ойымша, бұл жерде бәрі жақсы.
Dialogue: 0,0:56:26.13,0:56:27.34,Default,,0,0,0,,Ай қонағы
Dialogue: 0,0:56:30.26,0:56:31.01,Default,,0,0,0,,Уф
Dialogue: 0,0:56:31.30,0:56:32.97,Default,,0,0,0,,Осы жерге түсіп кетсе, мен оны сағынып қаламын.
Dialogue: 0,0:56:33.55,0:56:34.84,Default,,0,0,0,,Қарсылық көрсетемін десең...
Dialogue: 0,0:56:34.97,0:56:36.85,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:56:38.52,0:56:42.39,Default,,0,0,0,,Мидгард, сіз осындай жерге соғыс кемесі қоясыз ба?
Dialogue: 0,0:56:43.94,0:56:46.48,Default,,0,0,0,,Барлық зеңбірек порттары зымыран ұшыруға дайын
Dialogue: 0,0:56:46.61,0:56:48.53,Default,,0,0,0,,Бұл жерде сарай зақымдалады.
Dialogue: 0,0:56:49.11,0:56:52.86,Default,,0,0,0,,Мен сендерге жасанды қысқы ұйқыдағы күмбездерге шабуыл жасаңдар деп тұрған жоқпын.
Dialogue: 0,0:56:52.99,0:56:55.20,Default,,0,0,0,,Гарри Орд және жердегілер
Dialogue: 0,0:56:55.70,0:56:57.20,Default,,0,0,0,,Жандарм
Dialogue: 0,0:56:57.66,0:57:00.37,Default,,0,0,0,,Роллан Милишаның мобильді костюмін артқа жылжыту керек.
Dialogue: 0,0:57:00.50,0:57:02.25,Default,,0,0,0,,Сіз не істемексіз? капитан
Dialogue: 0,0:57:02.37,0:57:03.08,Default,,0,0,0,,Төмен түсіңіз
Dialogue: 0,0:57:03.67,0:57:04.96,Default,,0,0,0,,Қоғамның шегінуі
Dialogue: 0,0:57:05.13,0:57:07.34,Default,,0,0,0,,Джон Вилгем неге төмен түспейді?
Dialogue: 0,0:57:07.46,0:57:09.30,Default,,0,0,0,,Ол Сид қарт пен басқаларды күтіп тұрғанын айтты.
Dialogue: 0,0:57:09.42,0:57:10.00,Default,,0,0,0,,Иә
Dialogue: 0,0:57:10.30,0:57:11.38,Default,,0,0,0,,Өрт!
Dialogue: 0,0:57:16.80,0:57:18.60,Default,,0,0,0,,Лоран, маған көмектес.
Dialogue: 0,0:57:18.76,0:57:20.10,Default,,0,0,0,,Уау...
Dialogue: 0,0:57:20.22,0:57:21.18,Default,,0,0,0,,Кедергі дегеніміз не?
Dialogue: 0,0:57:21.31,0:57:22.06,Default,,0,0,0,,Сумо ше?
Dialogue: 0,0:57:22.52,0:57:23.56,Default,,0,0,0,,Тосқауыл стилі
Dialogue: 0,0:57:23.69,0:57:24.44,Default,,0,0,0,,Тосқауыл?
Dialogue: 0,0:57:24.56,0:57:25.73,Default,,0,0,0,,Соның салдары болмайды ма?
Dialogue: 0,0:57:26.15,0:57:27.36,Default,,0,0,0,,Жандарм?
Dialogue: 0,0:57:27.48,0:57:28.98,Default,,0,0,0,,Иә, Сумо
Dialogue: 0,0:57:29.69,0:57:31.61,Default,,0,0,0,,Бірақ бұл қандай жарық?
Dialogue: 0,0:57:31.73,0:57:32.69,Default,,0,0,0,,Жарық үлгісі
Dialogue: 0,0:57:39.24,0:57:41.49,Default,,0,0,0,,Сіз жарылысты жұтып жатырсыз ба?
Dialogue: 0,0:57:49.29,0:57:50.21,Default,,0,0,0,,Сақал ұстаған...
Dialogue: 0,0:57:50.34,0:57:51.71,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:57:51.84,0:57:52.55,Default,,0,0,0,,Уа, ау, ау
Dialogue: 0,0:57:52.67,0:57:53.55,Default,,0,0,0,,Оқ атуды тоқтату
Dialogue: 0,0:57:53.67,0:57:54.30,Default,,0,0,0,,Хмм...
Dialogue: 0,0:57:54.67,0:57:57.09,Default,,0,0,0,,Балалар, түсіңдер!
Dialogue: 0,0:58:00.51,0:58:02.47,Default,,0,0,0,,Ақ қуыршақтың жауынгерлік кемесі бар...
Dialogue: 0,0:58:02.60,0:58:04.18,Default,,0,0,0,,Олар бізді артқа итеріп жатыр.
Dialogue: 0,0:58:04.68,0:58:06.35,Default,,0,0,0,,Лорд Гарридің сумосы
Dialogue: 0,0:58:06.48,0:58:07.90,Default,,0,0,0,,Әлгі жігіт қыңыр.
Dialogue: 0,0:58:12.11,0:58:13.32,Default,,0,0,0,,Бұл болды
Dialogue: 0,0:58:13.49,0:58:16.15,Default,,0,0,0,,Сақалды жылжымалы костюм А
Dialogue: 0,0:58:16.28,0:58:18.99,Default,,0,0,0,,Қараңғы тарихтың нышаны болған машина.
Dialogue: 0,0:58:19.12,0:58:21.28,Default,,0,0,0,,Жойылған өркениет...
Dialogue: 0,0:58:21.87,0:58:23.66,Default,,0,0,0,,Мен... мен...
Dialogue: 0,0:58:24.54,0:58:26.75,Default,,0,0,0,,Мен шектен шыққан нәрсе істеп жатырмын.
Dialogue: 0,0:58:26.87,0:58:30.17,Default,,0,0,0,,Қара тарих машинасын ояттым.
Dialogue: 0,0:58:30.29,0:58:31.75,Default,,0,0,0,,Мен не істеймін...
Dialogue: 0,0:58:31.88,0:58:33.38,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:58:33.51,0:58:37.63,Default,,0,0,0,,Құрметті Диана Сорел Диана, кемені портқа жеткізіңіз!
Dialogue: 0,0:58:38.22,0:58:39.14,Default,,0,0,0,,Ах!
Dialogue: 0,0:58:39.26,0:58:40.93,Default,,0,0,0,,А бұрылысын көру мүмкін емес
Dialogue: 0,0:58:41.05,0:58:43.18,Default,,0,0,0,,А бұрылысы қайда орналасқан?
Dialogue: 0,0:58:43.68,0:58:44.27,Default,,0,0,0,,Уау
Dialogue: 0,0:58:46.89,0:58:50.98,Default,,0,0,0,,Капитан Гарри... SS
Dialogue: 0,0:58:51.36,0:58:54.90,Default,,0,0,0,,Диананың әділдігі орындалады.
Dialogue: 0,0:59:03.16,0:59:04.58,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:59:04.91,0:59:07.37,Default,,0,0,0,,Аудиторияға қылыш әкелген адамға -
Dialogue: 0,0:59:07.71,0:59:09.83,Default,,0,0,0,,Мен X бұрылысын сізге қалдыра алмаймын.
Dialogue: 0,0:59:10.00,0:59:11.42,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:59:11.54,0:59:13.55,Default,,0,0,0,,Келіңіз де, рұқсатсыз алыңыз.
Dialogue: 0,0:59:16.76,0:59:18.63,Default,,0,0,0,,Неліктен X бұрылысын беру керек?
Dialogue: 0,0:59:18.76,0:59:20.39,Default,,0,0,0,,Екінші тарап – патшайым
Dialogue: 0,0:59:20.51,0:59:22.10,Default,,0,0,0,,Бұл күштірек.
Dialogue: 0,0:59:22.22,0:59:24.01,Default,,0,0,0,,Мемлекеттік төңкеріс дегеніміз не?
Dialogue: 0,0:59:24.14,0:59:27.06,Default,,0,0,0,,Сіздің тарапыңызда азаматтар болмаса, сіз жетістікке жете алмайсыз.
Dialogue: 0,0:59:27.18,0:59:29.31,Default,,0,0,0,,Ал біздің флоттың техникасы...
Dialogue: 0,0:59:29.44,0:59:32.73,Default,,0,0,0,,Айдағы нәзік және шағын қалаларды жаулап алуға жарамайды.
Dialogue: 0,0:59:32.86,0:59:34.65,Default,,0,0,0,,Олай болса, Диананы ойнайық.
Dialogue: 0,0:59:34.77,0:59:37.28,Default,,0,0,0,,Мен екі Диана екенін түсіндім.
Dialogue: 0,0:59:37.90,0:59:40.36,Default,,0,0,0,,Сол тақ бөлмесіндегі әйел де күдіктенеді.
Dialogue: 0,0:59:40.61,0:59:41.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:41.70,0:59:42.91,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:59:43.03,0:59:44.66,Default,,0,0,0,,Екі адам бір уақытта істесе...
Dialogue: 0,0:59:47.70,0:59:49.12,Default,,0,0,0,,Жер...
Dialogue: 0,0:59:49.37,0:59:51.58,Default,,0,0,0,,Кешіріңіз, Гим Гуинганум мырза.
Dialogue: 0,0:59:51.71,0:59:52.63,Default,,0,0,0,,Мэрибелл?
Dialogue: 0,0:59:52.75,0:59:53.96,Default,,0,0,0,,Гвен Рейнфорд?
Dialogue: 0,0:59:55.13,0:59:58.51,Default,,0,0,0,,Мені есіңе түсіргеніңді мақтан тұтамын, жас ханым.
Dialogue: 0,0:59:58.63,1:00:00.76,Default,,0,0,0,,Жоғары мәртебелі, Ай мырза.
Dialogue: 0,1:00:01.43,1:00:03.85,Default,,0,0,0,,Ай командирін айттыңыз ба?
Dialogue: 0,1:00:03.97,1:00:06.01,Default,,0,0,0,,Мәртебелі Гвен Рейнфорд
Dialogue: 0,1:00:06.14,1:00:07.14,Default,,0,0,0,,Әрине
Dialogue: 0,1:00:08.02,1:00:09.89,Default,,0,0,0,,Әңгімелесейік
Dialogue: 0,1:00:10.98,1:00:12.52,Default,,0,0,0,,Не? ол
Dialogue: 0,1:00:12.65,1:00:14.11,Default,,0,0,0,,Егер сіз SS-ке қосылсаңыз
Dialogue: 0,1:00:14.23,1:00:17.19,Default,,0,0,0,,Өйткені, бұл міндетті зат.
Dialogue: 0,1:00:17.48,1:00:18.48,Default,,0,0,0,,Бейтаныс
Dialogue: 0,1:00:18.90,1:00:19.90,Default,,0,0,0,,Шынында, сол сырғаң өте батыл екен.
Dialogue: 0,1:00:20.15,1:00:23.62,Default,,0,0,0,,Бұл жеңіл салмақты түнде көретін көзілдіріктерді табу қиын.
Dialogue: 0,1:00:23.82,1:00:24.99,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,1:00:25.41,1:00:26.28,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,1:00:26.66,1:00:28.58,Default,,0,0,0,,Балалар Вилгемге жүзуге рұқсат етіңдер.
Dialogue: 0,1:00:29.00,1:00:29.66,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:29.79,1:00:30.71,Default,,0,0,0,,Кету?
Dialogue: 0,1:00:30.83,1:00:31.66,Default,,0,0,0,,Қай жолмен?
Dialogue: 0,1:00:31.83,1:00:33.04,Default,,0,0,0,,Жер
Dialogue: 0,1:00:33.54,1:00:34.33,Default,,0,0,0,,Жер?
Dialogue: 0,1:00:34.83,1:00:37.96,Default,,0,0,0,,Айдың ғылымы мен техникасын алдық.
Dialogue: 0,1:00:38.13,1:00:40.92,Default,,0,0,0,,Енді сіз Moonwraith-пен тең дәрежеде күресе аласыз.
Dialogue: 0,1:00:41.26,1:00:43.84,Default,,0,0,0,,Әй... Балам, соғыс деген...
Dialogue: 0,1:00:44.18,1:00:45.05,Default,,0,0,0,,Не болды, мырза Мокки!
Dialogue: 0,1:00:45.18,1:00:49.93,Default,,0,0,0,,Соғыс лейтенант айтқандай оңай емес.
Dialogue: 0,1:00:50.14,1:00:51.14,Default,,0,0,0,,Хаха
Dialogue: 0,1:00:52.19,1:00:53.73,Default,,0,0,0,,О, және... (Яни) Ха!
Dialogue: 0,1:00:53.85,1:00:55.52,Default,,0,0,0,,Біреу Лаураны шақыруын өтінемін.
Dialogue: 0,1:00:55.90,1:00:58.07,Default,,0,0,0,,Бұл жай ғана Роланд па? Егер сіз ұшқыш болсаңыз...
Dialogue: 0,1:00:58.69,1:01:01.32,Default,,0,0,0,,Жоқ, жай ғана Лаура жақсы.
Dialogue: 0,1:01:01.82,1:01:02.65,Default,,0,0,0,,Бұл ма?
Dialogue: 0,1:01:02.78,1:01:04.86,Default,,0,0,0,,Сид қарт, өтінемін.
Dialogue: 0,1:01:06.41,1:01:08.45,Default,,0,0,0,,Сәлеметсіз бе, Диана ханшайым
Dialogue: 0,1:01:08.66,1:01:10.75,Default,,0,0,0,,Менің де әңгімем бар еді.
Dialogue: 0,1:01:10.91,1:01:11.50,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:11.62,1:01:13.21,Default,,0,0,0,,Роландқа, Ақ қуыршақ-
Dialogue: 0,1:01:13.33,1:01:15.08,Default,,0,0,0,,Мен сіздің Гингем флотына барғаныңызды қалаймын.
Dialogue: 0,1:01:15.54,1:01:17.34,Default,,0,0,0,,Гингэм флотына?
Dialogue: 0,1:01:17.46,1:01:18.46,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,1:01:18.67,1:01:20.59,Default,,0,0,0,,X бұрылысын алу үшін
Dialogue: 0,1:01:20.96,1:01:23.80,Default,,0,0,0,,Роланд болса, мен оны Вильгемде кездестірдім.
Dialogue: 0,1:01:23.93,1:01:26.34,Default,,0,0,0,,Вилгемде бізбен байланыса алмадың ба?
Dialogue: 0,1:01:26.97,1:01:29.85,Default,,0,0,0,,Гвен-доно да сені іздеп жатыр дедің.
Dialogue: 0,1:01:30.35,1:01:31.10,Default,,0,0,0,,Жек көру...
Dialogue: 0,1:01:32.85,1:01:34.60,Default,,0,0,0,,Сәлем, сені көргеніме қуаныштымын, Лаура.
Dialogue: 0,1:01:35.14,1:01:37.19,Default,,0,0,0,,Мен сізді мереке алдындағы кешке ертіп баруыңызды ойладым.
Dialogue: 0,1:01:39.32,1:01:40.86,Default,,0,0,0,,Алдын ала мерекелеу?
Dialogue: 0,1:01:41.65,1:01:42.78,Default,,0,0,0,,А, мен сені таныстырамын.
Dialogue: 0,1:01:42.94,1:01:46.32,Default,,0,0,0,,Ол Мэрибелл, Гиганам кланының мүшесі.
Dialogue: 0,1:01:46.49,1:01:47.91,Default,,0,0,0,,Міне, осылайша-ақ қырылып қалады!
Dialogue: 0,1:01:48.12,1:01:49.66,Default,,0,0,0,,Ха... Нгуен мырза
Dialogue: 0,1:01:49.78,1:01:51.12,Default,,0,0,0,,Вилгем... Ах.
Dialogue: 0,1:01:54.12,1:01:56.71,Default,,0,0,0,,Сіз Диана ханыммен сөйлестіңіз бе?
Dialogue: 0,1:01:56.83,1:01:58.92,Default,,0,0,0,,Барлығы бортта ма?
Dialogue: 0,1:02:04.17,1:02:06.93,Default,,0,0,0,,Менің екі шеберім де бортта жоқ.
Dialogue: 0,1:02:07.43,1:02:09.80,Default,,0,0,0,,Мен лотереяның сәттілігі сияқты нәрселерге де бәс тігуге тырыстым.
Dialogue: 0,1:02:09.93,1:02:11.31,Default,,0,0,0,,Лотереяда сәттілік...
Dialogue: 0,1:02:11.43,1:02:12.10,Default,,0,0,0,,Мен болсам...
Dialogue: 0,1:02:12.93,1:02:14.23,Default,,0,0,0,,Өлемін деп ойлайтын ешқандай жағдайға тап болған емеспін
Dialogue: 0,1:02:14.48,1:02:16.35,Default,,0,0,0,,Уф... аааа
Dialogue: 0,1:02:16.81,1:02:17.56,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,1:02:18.02,1:02:19.81,Default,,0,0,0,,Лаура Жер... Қараңғы тарихтың ең жақсы бөлігі...
Dialogue: 0,1:02:19.94,1:02:20.65,Default,,0,0,0,,Не болды саған, жексұрын? Неге күліп тұрсың!
Dialogue: 0,1:02:20.77,1:02:22.07,Default,,0,0,0,,Мисс Мэрибелл (Мэррибелл) Не?
Dialogue: 0,1:02:23.32,1:02:23.99,Default,,0,0,0,,Уф...
Dialogue: 0,1:02:25.28,1:02:29.12,Default,,0,0,0,,Мен Диана-сама мен Киль-самаға қайтуым керек.
Dialogue: 0,1:02:29.28,1:02:29.91,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:02:30.03,1:02:31.41,Default,,0,0,0,,Жиілікті сәйкестендіріңіз
Dialogue: 0,1:02:31.95,1:02:33.83,Default,,0,0,0,,Бос емес кезде тоқтаңыз.
Dialogue: 0,1:02:33.95,1:02:36.04,Default,,0,0,0,,Мұрагер, сіз нені айтып тұрсыз?
Dialogue: 0,1:02:36.33,1:02:37.92,Default,,0,0,0,,Гим Гуингануммен келісім жасады.
Dialogue: 0,1:02:38.17,1:02:38.83,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:02:38.96,1:02:40.17,Default,,0,0,0,,Бұл Мэрибе... Ах!
Dialogue: 0,1:02:40.29,1:02:42.17,Default,,0,0,0,,А, не? Не...
Dialogue: 0,1:02:42.30,1:02:43.71,Default,,0,0,0,,Не болды? Лоран
Dialogue: 0,1:02:43.84,1:02:46.30,Default,,0,0,0,,Кемені айға қайтару
Dialogue: 0,1:02:46.42,1:02:47.63,Default,,0,0,0,,Әйтпесе мен сені атып тастаймын.
Dialogue: 0,1:02:48.26,1:02:50.85,Default,,0,0,0,,Қолыңнан келмейтін нәрселерді айтпа, Лаура.
Dialogue: 0,1:02:50.97,1:02:51.85,Default,,0,0,0,,Мені ат!
Dialogue: 0,1:02:52.01,1:02:52.97,Default,,0,0,0,,Уф...
Dialogue: 0,1:02:53.26,1:02:55.27,Default,,0,0,0,,Оны жай ғана артқа итеруге болады.
Dialogue: 0,1:03:10.53,1:03:11.82,Default,,0,0,0,,X бұрылысы
Dialogue: 0,1:03:15.91,1:03:19.25,Default,,0,0,0,,Қандай дұрыс емес басқару, Гвен Рейнфорд мырза.
Dialogue: 0,1:03:20.58,1:03:22.04,Default,,0,0,0,,X бұрылысы
Dialogue: 0,1:03:22.17,1:03:24.96,Default,,0,0,0,,Нгуен мырза Гим Гуингануммен бірігіп кетті ме?
Dialogue: 0,1:03:25.63,1:03:28.05,Default,,0,0,0,,Бұл саясат, Лаура.
Dialogue: 0,1:03:28.67,1:03:31.51,Default,,0,0,0,,Мен жоғары мәртебелі Гинганаммен бірге жерге түсемін.
Dialogue: 0,1:03:31.64,1:03:34.89,Default,,0,0,0,,Жерді озық ғылыми өркениет дәуіріне қайтару
Dialogue: 0,1:03:35.43,1:03:37.68,Default,,0,0,0,,Лорд Гвен, сіз не туралы айтып отырсыз?
Dialogue: 0,1:03:39.27,1:03:40.73,Default,,0,0,0,,Диана Сорел бұл...
Dialogue: 0,1:03:40.85,1:03:45.48,Default,,0,0,0,,Мен сені қара тарих деп аталатын оттан қорыққан маймылдан басқа ештеңе көрмедім.
Dialogue: 0,1:03:45.90,1:03:47.07,Default,,0,0,0,,Сіз соншалықты көп айтасыз ба?
Dialogue: 0,1:03:47.57,1:03:50.70,Default,,0,0,0,,Сол жертөледе Мунврейт шайқас туралы ұмытып кетті...
Dialogue: 0,1:03:50.82,1:03:53.41,Default,,0,0,0,,Өлген адам сияқты, тарихты қайталау...
Dialogue: 0,1:03:53.53,1:03:55.99,Default,,0,0,0,,Бұл ешқашан ештеңе шығармаған жарыс.
Dialogue: 0,1:03:56.12,1:03:59.00,Default,,0,0,0,,Ал сэр Нгуен тыйымдарды бұзуға арналғанын айтады...
Dialogue: 0,1:03:59.12,1:03:59.96,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,1:04:00.12,1:04:02.75,Default,,0,0,0,,Мен қараңғы тарихтың деректерін ұрлап алдым...
Dialogue: 0,1:04:03.38,1:04:04.50,Default,,0,0,0,,Хаа…
Dialogue: 0,1:04:04.63,1:04:08.30,Default,,0,0,0,,Қараңғы тарихты тағы қайталап, ақымақтар
Dialogue: 0,1:04:08.71,1:04:15.01,Default,,0,0,0,,Кішкентай баланың сөзін ести алмасаңыз, осында реттейік.
Dialogue: 0,1:04:27.40,1:04:28.57,Default,,0,0,0,,Олар ағайынды болса, олар біркелкі.
Dialogue: 0,1:04:33.16,1:04:36.74,Default,,0,0,0,,Мен саған бұл ағаңның машинасы дедім ғой, балам.
Dialogue: 0,1:04:36.87,1:04:38.33,Default,,0,0,0,,Жоғары мәртебелі Гим Гуинганум
Dialogue: 0,1:04:38.45,1:04:40.29,Default,,0,0,0,,«Лаураны өлтірме»?
Dialogue: 0,1:04:40.71,1:04:41.54,Default,,0,0,0,,Иә.
Dialogue: 0,1:04:41.79,1:04:43.12,Default,,0,0,0,,Бағыну, Лаура.
Dialogue: 0,1:04:43.25,1:04:45.75,Default,,0,0,0,,Олай болса мен Мәртебеңізге араша боламын.
Dialogue: 0,1:04:46.09,1:04:46.79,Default,,0,0,0,,Уф
Dialogue: 0,1:04:47.17,1:04:49.01,Default,,0,0,0,,Қарсыласыңды емес, қарсыласыңды өлтірмей күресуге болады.
Dialogue: 0,1:04:49.34,1:04:51.76,Default,,0,0,0,,Сіз бірдеңе айттыңыз ба? бала
Dialogue: 0,1:04:57.76,1:04:58.93,Default,,0,0,0,,Содан кейін...
Dialogue: 0,1:04:59.97,1:05:00.93,Default,,0,0,0,,(Үкідің ұлуы)
Dialogue: 0,1:05:05.23,1:05:06.52,Default,,0,0,0,,Не?
Dialogue: 0,1:05:09.65,1:05:12.32,Default,,0,0,0,,X барлық бағытта ұшты...
Dialogue: 0,1:05:13.95,1:05:17.78,Default,,0,0,0,,Сондықтан мұрагер моделі жетілдірілді...
Dialogue: 0,1:05:17.95,1:05:20.04,Default,,0,0,0,,Сондай-ақ А бұрылысында күзетші қызметін атқарады.
Dialogue: 0,1:05:24.92,1:05:26.08,Default,,0,0,0,,Уф
Dialogue: 0,1:05:26.21,1:05:27.13,Default,,0,0,0,,Қашу
Dialogue: 0,1:05:29.21,1:05:32.09,Default,,0,0,0,,А бұрылысы Сіздің тапсырмаңыз аяқталды.
Dialogue: 0,1:05:33.30,1:05:34.34,Default,,0,0,0,,Ол адамзаттың жауы емес
Dialogue: 0,1:05:44.14,1:05:46.10,Default,,0,0,0,,Иә, ол…
Dialogue: 0,1:05:46.90,1:05:51.07,Default,,0,0,0,,Ондай нәрсе болмаса, мен оны Turn X-тің інісі деп атамас едім.
Dialogue: 0,1:05:54.03,1:05:56.03,Default,,0,0,0,,Хехехехехехехе
Dialogue: 0,1:05:57.24,1:05:59.03,Default,,0,0,0,,Ақ қуыршақ жиналсын.
Dialogue: 0,1:05:59.16,1:06:00.03,Default,,0,0,0,,Га
Dialogue: 0,1:06:00.33,1:06:02.45,Default,,0,0,0,,...Сосын мен Жерге қайтамын.
Dialogue: 0,1:06:02.58,1:06:03.45,Default,,0,0,0,,Иә.
Dialogue: 0,1:06:03.58,1:06:06.46,Default,,0,0,0,,Лаура сіздің артыңыздан қуады, өйткені ол ақ қуыршақты алғысы келеді.
Dialogue: 0,1:06:06.58,1:06:07.71,Default,,0,0,0,,Хмм?
Dialogue: 0,1:06:37.24,1:06:40.32,Default,,0,0,0,,Бірақ... Ауа кедергісі таңқаларлық үлкен.
Dialogue: 0,1:06:40.45,1:06:41.41,Default,,0,0,0,,Дегенмен
Dialogue: 0,1:06:41.70,1:06:42.49,Default,,0,0,0,,Уф
Dialogue: 0,1:07:00.05,1:07:01.47,Default,,0,0,0,,Ах... (Кейт) Уф.
Dialogue: 0,1:07:03.56,1:07:05.77,Default,,0,0,0,,Бұл жерді бомбалау керек пе?
Dialogue: 0,1:07:06.64,1:07:08.56,Default,,0,0,0,,Тез қашайық, Кит.
Dialogue: 0,1:07:08.81,1:07:10.56,Default,,0,0,0,,Менде аздап алаңдаушылық бар.
Dialogue: 0,1:07:10.69,1:07:11.65,Default,,0,0,0,,Ах...
Dialogue: 0,1:07:11.81,1:07:13.52,Default,,0,0,0,,Кішкентай қыз, қаш!
Dialogue: 0,1:07:14.11,1:07:14.82,Default,,0,0,0,,Міне, келеді!
Dialogue: 0,1:07:14.94,1:07:15.53,Default,,0,0,0,,Ах!
Dialogue: 0,1:07:15.65,1:07:16.57,Default,,0,0,0,,Уф (Верлен) Ах!
Dialogue: 0,1:07:16.69,1:07:17.57,Default,,0,0,0,,Ах...
Dialogue: 0,1:07:17.78,1:07:18.61,Default,,0,0,0,,Хмм...
Dialogue: 0,1:07:19.70,1:07:22.03,Default,,0,0,0,,Әй... Ханым... Амансың ба?
Dialogue: 0,1:07:22.16,1:07:23.12,Default,,0,0,0,,Ауырды...
Dialogue: 0,1:07:23.24,1:07:23.83,Default,,0,0,0,,Ха…
Dialogue: 0,1:07:24.66,1:07:28.83,Default,,0,0,0,,G... Ginganum командасының Махиросы Верленді неге ренжітті?
Dialogue: 0,1:07:31.38,1:07:34.55,Default,,0,0,0,,Бәрің де Жерге келдіңдер
Dialogue: 0,1:07:34.67,1:07:37.34,Default,,0,0,0,,Жер тұрғындарына зиян келтіруге құқығы жоқ.
Dialogue: 0,1:07:37.47,1:07:39.18,Default,,0,0,0,,Бұл еш жерде емес!
Dialogue: 0,1:07:39.88,1:07:41.39,Default,,0,0,0,,Кері анықтау жоқ па?
Dialogue: 0,1:07:41.51,1:07:44.64,Default,,0,0,0,,Гингем халқы Америка континентінде соғыса алады.
Dialogue: 0,1:07:44.76,1:07:46.72,Default,,0,0,0,,Мен саған қарамаймын.
Dialogue: 0,1:07:47.02,1:07:51.31,Default,,0,0,0,,Иә, Оңтүстік Америка материгінің шығыс жағалауымен кірейік.
Dialogue: 0,1:07:51.44,1:07:52.44,Default,,0,0,0,,Иә
Dialogue: 0,1:07:52.61,1:07:54.44,Default,,0,0,0,,Антарктиданың пейзажын суретке түсіріп жатырсыз ба?
Dialogue: 0,1:07:54.94,1:07:56.11,Default,,0,0,0,,Сіздің мақсатыңыз қандай?
Dialogue: 0,1:07:56.23,1:07:59.07,Default,,0,0,0,,А... Мен шынымен түсінбеймін.
Dialogue: 0,1:07:59.20,1:08:01.41,Default,,0,0,0,,Неге тура Америкаға бармайсың?
Dialogue: 0,1:08:01.53,1:08:03.62,Default,,0,0,0,,Сіз сонау төменнен солтүстікке барасыз ба?
Dialogue: 0,1:08:03.95,1:08:06.66,Default,,0,0,0,,Айдан қайтып келе жатырмын...
Dialogue: 0,1:08:06.79,1:08:09.62,Default,,0,0,0,,Қашықтық солтүстік полюсте болсын, оңтүстік полюсте болсын бірдей.
Dialogue: 0,1:08:09.79,1:08:11.50,Default,,0,0,0,,Осы жерден кірсеңіз...
Dialogue: 0,1:08:11.62,1:08:13.83,Default,,0,0,0,,Гинганам әскері сізді табады.
Dialogue: 0,1:08:13.96,1:08:18.01,Default,,0,0,0,,Түсіндім, сондықтан тура жүрудің орнына Антарктидадан солтүстікке қарай жүресің.
Dialogue: 0,1:08:18.34,1:08:19.97,Default,,0,0,0,,Мүмкін, саған кішкене сабақ беруім керек шығар.
Dialogue: 0,1:08:20.09,1:08:21.13,Default,,0,0,0,,Оқыңыз
Dialogue: 0,1:08:21.26,1:08:22.18,Default,,0,0,0,,Иә
Dialogue: 0,1:08:23.68,1:08:25.47,Default,,0,0,0,,Антарктикалық мұхит…
Dialogue: 0,1:08:25.68,1:08:28.64,Default,,0,0,0,,Бұл Солтүстік Американың лордтарына арналған.
Dialogue: 0,1:08:28.77,1:08:30.23,Default,,0,0,0,,Бұл коалиция туралы өтініш хаты.
Dialogue: 0,1:08:30.39,1:08:31.02,Default,,0,0,0,,Иә
Dialogue: 0,1:08:31.14,1:08:34.65,Default,,0,0,0,,Егер Мастер Нгуен Гим Гуингануммен бірігіп кетсе...
Dialogue: 0,1:08:34.85,1:08:37.86,Default,,0,0,0,,Бізге қарсы тұру үшін күш жасау керек, солай ма?
Dialogue: 0,1:08:37.98,1:08:38.57,Default,,0,0,0,,Иә
Dialogue: 0,1:08:38.82,1:08:41.32,Default,,0,0,0,,қатысты менің Киль Хеймнен өтінішім бар.
Dialogue: 0,1:08:41.45,1:08:42.28,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:42.40,1:08:45.70,Default,,0,0,0,,Мен бұл хатқа Диана Солер қол қойғанын қалаймын.
Dialogue: 0,1:08:45.99,1:08:47.62,Default,,0,0,0,,Деректер көшірілді.
Dialogue: 0,1:08:47.74,1:08:48.54,Default,,0,0,0,,Алайда...
Dialogue: 0,1:08:48.66,1:08:51.04,Default,,0,0,0,,А бұрылысы мен X бұрылысы бір-бірімен соғысып шықты.
Dialogue: 0,1:08:51.16,1:08:53.37,Default,,0,0,0,,Деректерді көшіруге болады, солай ма?
Dialogue: 0,1:08:53.50,1:08:54.13,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:54.29,1:08:56.38,Default,,0,0,0,,А бұрылысының көп көшірмелері бар ма?
Dialogue: 0,1:08:56.79,1:08:58.63,Default,,0,0,0,,Жоқ, бұл өте қорқынышты.
Dialogue: 0,1:09:04.51,1:09:05.55,Default,,0,0,0,,Рахмет
Dialogue: 0,1:09:05.68,1:09:07.51,Default,,0,0,0,,Ой, алаңдайтын ештеңе жоқ.
Dialogue: 0,1:09:08.56,1:09:09.89,Default,,0,0,0,,Аня нәжіске батты.
Dialogue: 0,1:09:11.02,1:09:12.23,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,1:09:12.52,1:09:13.31,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:19.02,1:09:21.99,Default,,0,0,0,,Нан зауыты жұмыс істей бастағанымен.
Dialogue: 0,1:09:22.65,1:09:24.74,Default,,0,0,0,,Гинганум флоты төмендеді делік.
Dialogue: 0,1:09:24.86,1:09:26.41,Default,,0,0,0,,Бұл бизнес туралы емес.
Dialogue: 0,1:09:26.66,1:09:28.37,Default,,0,0,0,,Бұл қай дирижабль?
Dialogue: 0,1:09:32.08,1:09:32.79,Default,,0,0,0,,Әй?
Dialogue: 0,1:09:33.87,1:09:34.62,Default,,0,0,0,,Ах
Dialogue: 0,1:09:35.12,1:09:36.58,Default,,0,0,0,,Ол қай Милишадан?
Dialogue: 0,1:09:40.05,1:09:40.88,Default,,0,0,0,,Балалар
Dialogue: 0,1:09:41.59,1:09:43.34,Default,,0,0,0,,Өнеркәсіптік модернизация?
Dialogue: 0,1:09:44.01,1:09:47.51,Default,,0,0,0,,Сондықтан мен Киттің наубайханасында жұмыс істеймін.
Dialogue: 0,1:09:47.68,1:09:50.81,Default,,0,0,0,,Маған Moonwraith инженерлерінің ынтымақтастығы қажет.
Dialogue: 0,1:09:51.27,1:09:52.52,Default,,0,0,0,,Мен сене алар емеспін.
Dialogue: 0,1:09:54.18,1:09:56.85,Default,,0,0,0,,Бұл Диана-сама мақұлдаған нәрсе ме?
Dialogue: 0,1:09:57.90,1:10:00.40,Default,,0,0,0,,Сіз бизнеспен күн көресіз...
Dialogue: 0,1:10:00.52,1:10:02.94,Default,,0,0,0,,Бұл Америка құрлығы екенін ұмытпаңыз.
Dialogue: 0,1:10:03.86,1:10:06.16,Default,,0,0,0,,Гингем армиясы жер бетінде не істеп жатыр...
Dialogue: 0,1:10:06.28,1:10:07.49,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,1:10:07.62,1:10:09.74,Default,,0,0,0,,Мен олардың қимылдарын білемін деп ойлаймын.
Dialogue: 0,1:10:10.78,1:10:13.75,Default,,0,0,0,,Олар әлі де әртүрлі жерлердің астаналарын бақылауы керек.
Dialogue: 0,1:10:22.42,1:10:24.26,Default,,0,0,0,,Герцог Борджианоны көлікке апарыңыз
Dialogue: 0,1:10:24.63,1:10:25.34,Default,,0,0,0,,Уау
Dialogue: 0,1:10:25.63,1:10:27.34,Default,,0,0,0,,Әй... (Батлер) Жақсысың ба?
Dialogue: 0,1:10:31.26,1:10:35.10,Default,,0,0,0,,Менің Руджана Милиша ше? Дұрыс, мен бар күшіммен күресемін.
Dialogue: 0,1:10:36.94,1:10:39.36,Default,,0,0,0,,Айға кенет барып, қайтып келсеңіз...
Dialogue: 0,1:10:39.48,1:10:42.44,Default,,0,0,0,,Сіз тіпті Гиганумды да басқара аламын деп ойлайтын шығарсыз.
Dialogue: 0,1:10:42.57,1:10:45.78,Default,,0,0,0,,Менің ойымша, бұл қайғылы.
Dialogue: 0,1:10:46.49,1:10:47.82,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,1:10:48.03,1:10:50.82,Default,,0,0,0,,Гвен Рейнфорд – лорд.
Dialogue: 0,1:10:50.99,1:10:52.83,Default,,0,0,0,,Мен Мэрибеллмін.
Dialogue: 0,1:10:53.12,1:10:54.16,Default,,0,0,0,,Күштен басқа...
Dialogue: 0,1:10:54.29,1:10:56.50,Default,,0,0,0,,Адамдардың жүрегін біріктіретін жол бар екенін.
Dialogue: 0,1:10:56.79,1:10:58.50,Default,,0,0,0,,Мен генералды оқытқым келеді.
Dialogue: 0,1:10:59.04,1:11:00.29,Default,,0,0,0,,Неге тоқтамайсың?
Dialogue: 0,1:11:00.42,1:11:01.54,Default,,0,0,0,,Сіз түсінесіз.
Dialogue: 0,1:11:01.71,1:11:02.96,Default,,0,0,0,,Гим Гуинганумға барғыңыз келе ме?
Dialogue: 0,1:11:03.09,1:11:04.84,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:11:04.96,1:11:05.84,Default,,0,0,0,,Бір адам...
Dialogue: 0,1:11:05.97,1:11:08.18,Default,,0,0,0,,Сіз қалаған нәрсені жасай алатын шындық жоқ.
Dialogue: 0,1:11:08.30,1:11:09.05,Default,,0,0,0,,Хехе
Dialogue: 0,1:11:09.26,1:11:10.26,Default,,0,0,0,,Бұл бонбон -
Dialogue: 0,1:11:10.39,1:11:12.22,Default,,0,0,0,,Менің ойымша, бұл күлкіге тұрарлық.
Dialogue: 0,1:11:12.39,1:11:13.01,Default,,0,0,0,,Әй?
Dialogue: 0,1:11:15.60,1:11:16.52,Default,,0,0,0,,Бұл қауіпті.
Dialogue: 0,1:11:16.73,1:11:20.60,Default,,0,0,0,,Жаңбырдан кейінгі түнде жер әдемі болады.
Dialogue: 0,1:11:21.11,1:11:24.07,Default,,0,0,0,,Хмм... Милиша да біршама қозғалып жатыр.
Dialogue: 0,1:11:25.40,1:11:28.36,Default,,0,0,0,,Осындай жерде Мунврейт инженері бар ма?
Dialogue: 0,1:11:28.49,1:11:29.70,Default,,0,0,0,,Иә, бар.
Dialogue: 0,1:11:29.82,1:11:32.70,Default,,0,0,0,,Олар ерте заманнан жасырын көшіп келген.
Dialogue: 0,1:11:32.87,1:11:34.29,Default,,0,0,0,,Йо Киттің күйеуі
Dialogue: 0,1:11:35.08,1:11:37.45,Default,,0,0,0,,Сіз механикалық қуыршақ ретінде осындай уақытта келген болсаңыз да.
Dialogue: 0,1:11:37.58,1:11:39.33,Default,,0,0,0,,Қазіргі дирижабль дегеніміз не?
Dialogue: 0,1:11:40.00,1:11:41.88,Default,,0,0,0,,Ол нанмен келді.
Dialogue: 0,1:11:42.71,1:11:44.88,Default,,0,0,0,,Сіз, Гиганум отряды...
Dialogue: 0,1:11:45.00,1:11:46.63,Default,,0,0,0,,Олар қолданатын механикалық қуыршақтар...
Dialogue: 0,1:11:47.13,1:11:48.38,Default,,0,0,0,,Маған бәрін айт
Dialogue: 0,1:11:48.59,1:11:50.68,Default,,0,0,0,,Мунврейт біледі.
Dialogue: 0,1:11:50.84,1:11:53.18,Default,,0,0,0,,Фрэн Кит Легерден тыңдау
Dialogue: 0,1:11:53.80,1:11:55.10,Default,,0,0,0,,франктен? Бұл...
Dialogue: 0,1:11:55.22,1:11:56.14,Default,,0,0,0,,Нобл (Кит) Ах.
Dialogue: 0,1:11:56.89,1:11:58.14,Default,,0,0,0,,Бұл Мунврейт.
Dialogue: 0,1:11:58.27,1:12:01.85,Default,,0,0,0,,Инженердің келбеті бар.
Dialogue: 0,1:12:01.98,1:12:02.69,Default,,0,0,0,,Иә?
Dialogue: 0,1:12:07.44,1:12:08.49,Default,,0,0,0,,Жел жоқ
Dialogue: 0,1:12:08.61,1:12:09.61,Default,,0,0,0,,Жел емес
Dialogue: 0,1:12:10.07,1:12:12.53,Default,,0,0,0,,Хмм... Бұрынғыдан шуылдадым.
Dialogue: 0,1:12:18.16,1:12:20.08,Default,,0,0,0,,Бұл Алмайердің сұлбасы еді.
Dialogue: 0,1:12:20.21,1:12:20.87,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,1:12:26.05,1:12:28.76,Default,,0,0,0,,Ге... Джозеф Ге... Кесу.
Dialogue: 0,1:12:28.96,1:12:29.92,Default,,0,0,0,,Қазір тым көп.
Dialogue: 0,1:12:32.89,1:12:35.01,Default,,0,0,0,,Жау болса, оқ жаудырар едім.
Dialogue: 0,1:12:35.14,1:12:36.22,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:12:44.02,1:12:46.36,Default,,0,0,0,,Ммм...Ай Сұлу Жоқ, бұл Джозеф емес.
Dialogue: 0,1:12:46.52,1:12:47.40,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,1:12:47.52,1:12:48.44,Default,,0,0,0,,F… Франк
Dialogue: 0,1:12:49.32,1:12:50.74,Default,,0,0,0,,Мен сенімен бірінші кездескеніме сене алар емеспін.
Dialogue: 0,1:12:50.86,1:12:52.99,Default,,0,0,0,,Фрэн... Сіз нені айтып тұрсыз?
Dialogue: 0,1:12:53.16,1:12:54.57,Default,,0,0,0,,Ки... сендер балалар.
Dialogue: 0,1:12:55.07,1:12:56.33,Default,,0,0,0,,Полковник Маллиган
Dialogue: 0,1:12:56.45,1:12:58.70,Default,,0,0,0,,Сьюзид бөлімшесінің қызметкері Джон үйіне қайтып келеді.
Dialogue: 0,1:12:58.83,1:12:59.83,Default,,0,0,0,,Сондай-ақ Эймс
Dialogue: 0,1:13:00.45,1:13:04.42,Default,,0,0,0,,Аспанда қалқып тұрған айға шынымен бардың ба?
Dialogue: 0,1:13:05.13,1:13:07.38,Default,,0,0,0,,Бізді қарсы алу үшін осындай жерге келгеніңізге сене алар емеспін.
Dialogue: 0,1:13:07.50,1:13:09.51,Default,,0,0,0,,Маллиган үшін бұл өте ақылды.
Dialogue: 0,1:13:10.05,1:13:12.42,Default,,0,0,0,,Сіз Френмен бірге үйге қайттыңыз ба?
Dialogue: 0,1:13:12.59,1:13:14.72,Default,,0,0,0,,Ашуланба (Кит) Ди... Құрметті Дина
Dialogue: 0,1:13:15.43,1:13:17.47,Default,,0,0,0,,Кит, егер сен де айшы болсаң...
Dialogue: 0,1:13:17.60,1:13:20.52,Default,,0,0,0,,Ханшайым мен Киль ханым әлі кемеден кетпеуі керек.
Dialogue: 0,1:13:20.64,1:13:21.52,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:13:21.68,1:13:24.52,Default,,0,0,0,,Ах... Бұл нағыз Диана Солер емес пе?
Dialogue: 0,1:13:24.69,1:13:27.44,Default,,0,0,0,,Сонымен соғыс жақын арада аяқталады.
Dialogue: 0,1:13:27.56,1:13:28.40,Default,,0,0,0,,О
Dialogue: 0,1:13:34.41,1:13:37.74,Default,,0,0,0,,Диана патшайымның осы жерден кетуін сұрай аласыз ба?
Dialogue: 0,1:13:37.99,1:13:41.75,Default,,0,0,0,,А, сіз сұрай аласыз, өйткені сіз менің не туралы айтып тұрғанымды білесіз.
Dialogue: 0,1:13:42.08,1:13:44.04,Default,,0,0,0,,Бірақ бұл А бұрылысы деп аталса да...
Dialogue: 0,1:13:44.16,1:13:46.75,Default,,0,0,0,,Оны жоюдың зияны жоқ, капитан.
Dialogue: 0,1:13:46.92,1:13:48.71,Default,,0,0,0,,Мәселе жойылуда.
Dialogue: 0,1:13:49.42,1:13:50.96,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,1:13:51.09,1:13:52.42,Default,,0,0,0,,Мен осында тұрдым.
Dialogue: 0,1:13:52.84,1:13:56.30,Default,,0,0,0,,Біздің көзқарасымыз бойынша біз соғысқа қарсымыз.
Dialogue: 0,1:13:56.64,1:13:57.64,Default,,0,0,0,,Бірақ Диана ханым...
Dialogue: 0,1:13:59.51,1:14:01.39,Default,,0,0,0,,Ғажайып жабдықтары бар әскери кеме.
Dialogue: 0,1:14:01.56,1:14:03.27,Default,,0,0,0,,Лужандық Милишамен қол ұстасып...
Dialogue: 0,1:14:03.39,1:14:04.94,Default,,0,0,0,,Неліктен бұл дұрыс емес?
Dialogue: 0,1:14:05.06,1:14:06.60,Default,,0,0,0,,Мәртебелі патшайым?
Dialogue: 0,1:14:07.40,1:14:08.77,Default,,0,0,0,,Біз, инженерлер...
Dialogue: 0,1:14:08.90,1:14:10.94,Default,,0,0,0,,Мен лорд Гвенге бағынамын.
Dialogue: 0,1:14:11.07,1:14:13.28,Default,,0,0,0,,Ал енді олардың қарындарын қазып көрейік.
Dialogue: 0,1:14:13.57,1:14:15.49,Default,,0,0,0,,О, сен тыңшысың.
Dialogue: 0,1:14:15.78,1:14:18.53,Default,,0,0,0,,Лоран да барып, Гвенді Лаура ретінде алып келеді.
Dialogue: 0,1:14:18.66,1:14:19.32,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:19.45,1:14:22.66,Default,,0,0,0,,Ақымақ, мұны істе де, А бұрылысын ұрла.
Dialogue: 0,1:14:22.79,1:14:23.91,Default,,0,0,0,,Мен бұған қарсымын.
Dialogue: 0,1:14:24.62,1:14:25.75,Default,,0,0,0,,Бұл жақсы қадам.
Dialogue: 0,1:14:25.87,1:14:27.42,Default,,0,0,0,,Ай сәулесі көбелектің ұстап алған сигналы
Dialogue: 0,1:14:27.54,1:14:28.17,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:14:41.01,1:14:43.06,Default,,0,0,0,,Ай сәулесінің көбелек жүйесі дегеніміз не?
Dialogue: 0,1:14:43.18,1:14:43.93,Default,,0,0,0,,Ол оны сіңіріп алмаған—
Dialogue: 0,1:14:44.31,1:14:45.56,Default,,0,0,0,,Сіз мұнда келесіз бе?
Dialogue: 0,1:14:45.68,1:14:46.85,Default,,0,0,0,,Дауыл астында қалды ма?
Dialogue: 0,1:14:47.69,1:14:48.90,Default,,0,0,0,,Ахх уау
Dialogue: 0,1:14:52.02,1:14:54.36,Default,,0,0,0,,(Найзағай)
Dialogue: 0,1:14:57.74,1:15:02.28,Default,,0,0,0,,Мен оның не екенін білмеймін, бірақ бұл маған өте жақсы таныс тайфун.
Dialogue: 0,1:15:03.62,1:15:05.66,Default,,0,0,0,,Ионның да иісі бар
Dialogue: 0,1:15:12.46,1:15:14.80,Default,,0,0,0,,Иә, мұрагер, не болды?
Dialogue: 0,1:15:15.01,1:15:16.55,Default,,0,0,0,,Бұл тым көп шығар.
Dialogue: 0,1:15:17.30,1:15:20.30,Default,,0,0,0,,Жер соғысқа арналған зертхана емес
Dialogue: 0,1:15:20.47,1:15:23.39,Default,,0,0,0,,Төбелесте артық нәрсе болмайды.
Dialogue: 0,1:15:23.51,1:15:25.52,Default,,0,0,0,,Бұл хат... Білемін.
Dialogue: 0,1:15:25.81,1:15:28.98,Default,,0,0,0,,Амелия мырзалары маған қарсы тұруды жоспарлап отыр.
Dialogue: 0,1:15:30.02,1:15:32.40,Default,,0,0,0,,Жабдықтау мүмкіндігі де шектеулі.
Dialogue: 0,1:15:33.02,1:15:35.11,Default,,0,0,0,,Бұл мәселе.
Dialogue: 0,1:15:35.23,1:15:36.53,Default,,0,0,0,,Сол кезде мен өзімді жеңілген адам ретінде өмір сүруді бастадым.
Dialogue: 0,1:15:36.65,1:15:37.82,Default,,0,0,0,,Не?
Dialogue: 0,1:15:38.40,1:15:39.95,Default,,0,0,0,,Диана Counter-ді жеңу ниетіңіз бар ма?
Dialogue: 0,1:15:40.53,1:15:43.53,Default,,0,0,0,,Филдің әскері, әрине, көздің жауын алады.
Dialogue: 0,1:15:43.70,1:15:44.58,Default,,0,0,0,,Өлтіру?
Dialogue: 0,1:15:44.83,1:15:45.49,Default,,0,0,0,,О
Dialogue: 0,1:15:45.70,1:15:47.96,Default,,0,0,0,,...Олай болса, маған A бұруын бере аласыз ба?
Dialogue: 0,1:15:48.50,1:15:49.16,Default,,0,0,0,,Не?
Dialogue: 0,1:15:49.58,1:15:53.38,Default,,0,0,0,,Инженер сол затты жаппай шығаруды қолға алмақшы.
Dialogue: 0,1:15:53.96,1:15:56.17,Default,,0,0,0,,А бұрылысының жаппай өндірісі?
Dialogue: 0,1:15:56.42,1:15:57.67,Default,,0,0,0,,Қызық, солай ма?
Dialogue: 0,1:15:57.88,1:15:59.38,Default,,0,0,0,,Бұл қызық
Dialogue: 0,1:16:03.93,1:16:05.72,Default,,0,0,0,,Дөрекі болма, Жүсіп.
Dialogue: 0,1:16:05.85,1:16:07.81,Default,,0,0,0,,Иә, жағдай туралы ойланыңыз.
Dialogue: 0,1:16:08.10,1:16:10.10,Default,,0,0,0,,Гвен мырзаның үйіне өзіңіз барсаңыз...
Dialogue: 0,1:16:10.27,1:16:11.73,Default,,0,0,0,,Өлтіретін жалғыз сенсің.
Dialogue: 0,1:16:12.48,1:16:15.07,Default,,0,0,0,,Сіз А кезегін қайтаратыныңызды айттыңыз.
Dialogue: 0,1:16:15.23,1:16:17.86,Default,,0,0,0,,Роланд ештеңе істей алмайды.
Dialogue: 0,1:16:18.57,1:16:21.15,Default,,0,0,0,,Себебі біз Диана Counter-пен кездесуіміз мүмкін...
Dialogue: 0,1:16:21.28,1:16:23.37,Default,,0,0,0,,Оны қазір орнату дұрыс емес пе?
Dialogue: 0,1:16:23.53,1:16:26.49,Default,,0,0,0,,Moonwraiths арасындағы талқылаулар сенімді ме?
Dialogue: 0,1:16:26.62,1:16:27.41,Default,,0,0,0,,Мен мұны істей аламын.
Dialogue: 0,1:16:28.20,1:16:30.08,Default,,0,0,0,,Жердегілерге қарағанда, Айлылар жақсы.
Dialogue: 0,1:16:30.21,1:16:32.08,Default,,0,0,0,,Мен жерді жойғым келмейді.
Dialogue: 0,1:16:32.21,1:16:33.75,Default,,0,0,0,,Менің әпкем дұрыс айтады.
Dialogue: 0,1:16:34.04,1:16:34.67,Default,,0,0,0,,Әй?
Dialogue: 0,1:16:34.79,1:16:38.67,Default,,0,0,0,,Алмайер келе жатқан сияқты, бірақ ханшайым да келе жатқан болуы керек.
Dialogue: 0,1:16:38.84,1:16:41.68,Default,,0,0,0,,Айдың адамы болсаң да солай киінесің бе?
Dialogue: 0,1:16:42.09,1:16:46.18,Default,,0,0,0,,Жерлік болсаңыз да, сіз мобильді костюмді пайдаланасыз.
Dialogue: 0,1:16:46.31,1:16:47.97,Default,,0,0,0,,Маған ешқандай басшылық қажет емес.
Dialogue: 0,1:16:50.43,1:16:52.56,Default,,0,0,0,,О, тәңірім, тек жол сал.
Dialogue: 0,1:16:53.02,1:16:55.15,Default,,0,0,0,,Пәтердегі балаларға пайдасы жоқ.
Dialogue: 0,1:16:55.52,1:16:58.78,Default,,0,0,0,,Киттер Сіз мені ести аласыз ба? Шпион қайтып келді
Dialogue: 0,1:16:58.98,1:17:00.94,Default,,0,0,0,,Эй, сенің атың кім?
Dialogue: 0,1:17:01.40,1:17:04.91,Default,,0,0,0,,Бұл Корен, сержант Корен Нандер.
Dialogue: 0,1:17:08.49,1:17:10.33,Default,,0,0,0,,Корен? Әлгі жігіт?
Dialogue: 0,1:17:10.50,1:17:11.33,Default,,0,0,0,,А...
Dialogue: 0,1:17:11.54,1:17:12.79,Default,,0,0,0,,Бұл монах?
Dialogue: 0,1:17:15.54,1:17:16.54,Default,,0,0,0,,Эхехе
Dialogue: 0,1:17:17.13,1:17:20.26,Default,,0,0,0,,Мазалағаныңыз үшін рахмет, сержант Коллен.
Dialogue: 0,1:17:20.63,1:17:23.80,Default,,0,0,0,,Ол біртүрлі механикалық қуыршақ...
Dialogue: 0,1:17:23.93,1:17:26.72,Default,,0,0,0,,Дұрыс, Диана ханымға бағытталған...
Dialogue: 0,1:17:26.89,1:17:29.93,Default,,0,0,0,,Ақ қуыршақты Гундам деп атаған ол.
Dialogue: 0,1:17:30.14,1:17:33.31,Default,,0,0,0,,Ионсыз және озонсыз аралас иіс...
Dialogue: 0,1:17:33.44,1:17:35.06,Default,,0,0,0,,Бұл дүниенің ақыры болды
Dialogue: 0,1:17:35.19,1:17:37.69,Default,,0,0,0,,А бұрылысының қалай жұмыс істейтінін көрдіңіз.
Dialogue: 0,1:17:37.81,1:17:38.44,Default,,0,0,0,,Иә
Dialogue: 0,1:17:39.57,1:17:43.40,Default,,0,0,0,,Бірақ, ханшайым, мен куә болған оқиға...
Dialogue: 0,1:17:43.53,1:17:46.41,Default,,0,0,0,,Бұл бұрынғы көлемінің бірнеше жүзден бір бөлігі ғана.
Dialogue: 0,1:17:46.62,1:17:49.03,Default,,0,0,0,,Бұл адам қандай адам?
Dialogue: 0,1:17:49.53,1:17:53.87,Default,,0,0,0,,Мен Диана Counter негізін қалау кезінде болдым.
Dialogue: 0,1:17:54.08,1:17:56.67,Default,,0,0,0,,Өйткені мен тек қаһарлы Коренді ғана білемін.
Dialogue: 0,1:17:56.79,1:17:59.63,Default,,0,0,0,,Мен оның бұрынғы тарихын білмеймін.
Dialogue: 0,1:17:59.96,1:18:03.59,Default,,0,0,0,,Деректерге көптеген жаман нәрселер жазылған болуы мүмкін.
Dialogue: 0,1:18:04.30,1:18:05.51,Default,,0,0,0,,Сержант Коллен
Dialogue: 0,1:18:05.63,1:18:08.05,Default,,0,0,0,,Сіз А бұрылысына қарсы тұруды білесіз бе?
Dialogue: 0,1:18:08.72,1:18:11.72,Default,,0,0,0,,Адамдар соншалықты ыңғайлы болу үшін жаратылған емес.
Dialogue: 0,1:18:11.89,1:18:13.02,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:18:13.81,1:18:17.06,Default,,0,0,0,,Оянғанда ересек болатын ханшайымға...
Dialogue: 0,1:18:17.23,1:18:19.56,Default,,0,0,0,,Маған аудитория берілгенде...
Dialogue: 0,1:18:19.73,1:18:22.32,Default,,0,0,0,,Менің ойымша, киіміңді тағы бір рет шешіп алған дұрыс.
Dialogue: 0,1:18:22.48,1:18:23.78,Default,,0,0,0,,Сержант Коллен
Dialogue: 0,1:18:24.11,1:18:26.57,Default,,0,0,0,,Менің ұрыс сызығыма тағы бір рет оралуыңызды өтінемін.
Dialogue: 0,1:18:27.45,1:18:30.53,Default,,0,0,0,,Хаха, мен ризамын және бақыттымын.
Dialogue: 0,1:18:31.33,1:18:34.08,Default,,0,0,0,,Мен де бақыттымын, Корен.
Dialogue: 0,1:18:35.21,1:18:40.21,Default,,0,0,0,,Адам қайта-қайта қысқы ұйқыға кетіп, оянғаннан кейін осылай көрінеді.
Dialogue: 0,1:18:40.34,1:18:45.01,Default,,0,0,0,,(Кореннің жылаған дауысы)
Dialogue: 0,1:18:47.38,1:18:48.43,Default,,0,0,0,,Жүсіп? иә?
Dialogue: 0,1:18:48.55,1:18:49.34,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,1:18:49.47,1:18:52.31,Default,,0,0,0,,Гвен Рейнфордтың орнына жалғыз бару қауіпті.
Dialogue: 0,1:18:52.68,1:18:56.06,Default,,0,0,0,,Уайымдама, мен Джалапи отрядын да әкелемін.
Dialogue: 0,1:18:59.65,1:19:00.36,Default,,0,0,0,,Мен де
Dialogue: 0,1:19:00.48,1:19:01.61,Default,,0,0,0,,Core Fighter пайда болады
Dialogue: 0,1:19:01.86,1:19:03.15,Default,,0,0,0,,көмектес (Гарри) сұра
Dialogue: 0,1:19:03.28,1:19:05.82,Default,,0,0,0,,Созье Мессиер Тек тоқтатыңыз.
Dialogue: 0,1:19:05.94,1:19:06.78,Default,,0,0,0,,Ммм
Dialogue: 0,1:19:06.90,1:19:07.70,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:19:07.86,1:19:08.95,Default,,0,0,0,,Жүсіп
Dialogue: 0,1:19:12.03,1:19:14.83,Default,,0,0,0,,Бұл соғыс жариялау туралы белгі.
Dialogue: 0,1:19:15.00,1:19:18.92,Default,,0,0,0,,Бірақ мен саған дайындалуға уақыт беремін.
Dialogue: 0,1:19:19.92,1:19:21.54,Default,,0,0,0,,Suesson Stero?
Dialogue: 0,1:19:21.71,1:19:24.34,Default,,0,0,0,,Бұл Гиганум отрядының мейірімділігі.
Dialogue: 0,1:19:24.80,1:19:27.09,Default,,0,0,0,,Бұл Агриппаның жеңілуінің нәтижесі ме?
Dialogue: 0,1:19:27.22,1:19:28.18,Default,,0,0,0,,Полковник Фил
Dialogue: 0,1:19:28.30,1:19:31.55,Default,,0,0,0,,Олардың Махиросын және басқаларын Водомның бір соққысымен жоюға болады.
Dialogue: 0,1:19:32.14,1:19:36.31,Default,,0,0,0,,Иә, тек азамат әскер екенсің деп, ақ туды желбіретпе.
Dialogue: 0,1:19:36.77,1:19:38.14,Default,,0,0,0,,Гинганам бірлігі...
Dialogue: 0,1:19:38.31,1:19:40.94,Default,,0,0,0,,Ол ауыр қылмыс жасап, керемет көріну үшін жерге түсті.
Dialogue: 0,1:19:41.52,1:19:44.98,Default,,0,0,0,,Егер генерал Гинганам да жіберілсе...
Dialogue: 0,1:19:45.57,1:19:48.11,Default,,0,0,0,,Аспит болса да, мен оны жеңемін.
Dialogue: 0,1:19:48.24,1:19:49.36,Default,,0,0,0,,Мм, оны маған қалдырыңыз
Dialogue: 0,1:19:49.49,1:19:50.36,Default,,0,0,0,,Иә
Dialogue: 0,1:19:50.49,1:19:51.20,Default,,0,0,0,,Барьерді дайындау
Dialogue: 0,1:19:51.66,1:19:53.24,Default,,0,0,0,,Сондықтан мен ұсыныс жасадым.
Dialogue: 0,1:19:59.21,1:20:00.54,Default,,0,0,0,,Водом снайпер
Dialogue: 0,1:20:02.46,1:20:03.84,Default,,0,0,0,,Не дедің!
Dialogue: 0,1:20:04.00,1:20:05.42,Default,,0,0,0,,Ноксты астана ету -
Dialogue: 0,1:20:05.63,1:20:08.59,Default,,0,0,0,,Фил патша болып, Солейл патшалығын құрғысы келетінін айтады...
Dialogue: 0,1:20:08.72,1:20:09.80,Default,,0,0,0,,Мен саған бұлай істеуге рұқсат бермеймін.
Dialogue: 0,1:20:19.14,1:20:21.39,Default,,0,0,0,,Нокс ұрыс алаңына айналады.
Dialogue: 0,1:20:21.52,1:20:23.15,Default,,0,0,0,,Солей қозғалады.
Dialogue: 0,1:20:23.27,1:20:26.53,Default,,0,0,0,,Біз жай ғана зауытқа көшсек бола ма?
Dialogue: 0,1:20:26.73,1:20:30.45,Default,,0,0,0,,Инженерге нақты А бұрылысын көрсету керек.
Dialogue: 0,1:20:30.57,1:20:33.57,Default,,0,0,0,,Солай етсең, әлгі қоңырау қыз оны қайтарып алуға келеді...
Dialogue: 0,1:20:33.95,1:20:35.37,Default,,0,0,0,,Мынау.
Dialogue: 0,1:20:35.53,1:20:37.24,Default,,0,0,0,,деп үміттенемін
Dialogue: 0,1:20:37.37,1:20:40.83,Default,,0,0,0,,Неліктен Гингемдік жігіт маған А айналымын берді?
Dialogue: 0,1:20:41.04,1:20:42.92,Default,,0,0,0,,Moonwraith ұшқышсыз...
Dialogue: 0,1:20:43.04,1:20:44.38,Default,,0,0,0,,Мен оны пайдалана алмаймын деп ойлаймын.
Dialogue: 0,1:20:44.71,1:20:49.63,Default,,0,0,0,,Аа, Роланд мұнда емес, Ролан Лаура?
Dialogue: 0,1:20:52.47,1:20:53.34,Default,,0,0,0,,Лоран
Dialogue: 0,1:20:53.64,1:20:55.18,Default,,0,0,0,,Бұл жігіт ұзақ жол жүре алмайды.
Dialogue: 0,1:21:00.73,1:21:03.10,Default,,0,0,0,,Ескертуден бас тартылды Контакт сұралды
Dialogue: 0,1:21:03.23,1:21:03.98,Default,,0,0,0,,Не?
Dialogue: 0,1:21:04.10,1:21:06.15,Default,,0,0,0,,Жылжымалы костюм палубасын ашыңыз.
Dialogue: 0,1:21:10.40,1:21:11.70,Default,,0,0,0,,Ролан қайтып келді!
Dialogue: 0,1:21:11.82,1:21:13.99,Default,,0,0,0,,Егер ол тегіс болса, бұл жалапи бірлігі.
Dialogue: 0,1:21:15.16,1:21:16.95,Default,,0,0,0,,Қосылу тым кеш пе?
Dialogue: 0,1:21:17.28,1:21:19.83,Default,,0,0,0,,Біздің радионы ести алмауыңыз мүмкін емес.
Dialogue: 0,1:21:20.41,1:21:21.91,Default,,0,0,0,,Айға бардың ба?
Dialogue: 0,1:21:22.08,1:21:22.87,Default,,0,0,0,,ол даулы мәлімдемеге айналар еді
Dialogue: 0,1:21:23.37,1:21:25.75,Default,,0,0,0,,Мен де, оның туған қаласы...
Dialogue: 0,1:21:25.88,1:21:27.63,Default,,0,0,0,,Мен оны көргім келді
Dialogue: 0,1:21:28.63,1:21:32.34,Default,,0,0,0,,Сіз ынтымақтасуға дайынсыз ба? Лаура
Dialogue: 0,1:21:32.76,1:21:34.26,Default,,0,0,0,,Жауап беріңізші
Dialogue: 0,1:21:34.59,1:21:37.76,Default,,0,0,0,,Мен тек Жүсіп мырзамен келдім.
Dialogue: 0,1:21:38.10,1:21:39.35,Default,,0,0,0,,Джозеф Яхта мырза?
Dialogue: 0,1:21:40.10,1:21:43.31,Default,,0,0,0,,Неліктен Гим Гуинганум деген адаммен бірігіп кеттіңіз?
Dialogue: 0,1:21:43.77,1:21:46.98,Default,,0,0,0,,Айда өмір сүретін «Айлылар» да өзгерді.
Dialogue: 0,1:21:47.11,1:21:47.94,Default,,0,0,0,,А...
Dialogue: 0,1:21:48.15,1:21:50.65,Default,,0,0,0,,Жерді қайтару операциясы орындалғаннан кейін де...
Dialogue: 0,1:21:51.15,1:21:54.28,Default,,0,0,0,,Гинганум айда соғыс ойнайтын ба еді?
Dialogue: 0,1:21:54.45,1:21:58.28,Default,,0,0,0,,Сіз жауынгерлік инстинкті ынталандырылған Мунврейтті айтасыз ба?
Dialogue: 0,1:21:59.08,1:21:59.99,Default,,0,0,0,,Иә.
Dialogue: 0,1:22:00.12,1:22:01.16,Default,,0,0,0,,Содан кейін қолдарыңызды біріктіріңіз...
Dialogue: 0,1:22:01.29,1:22:04.21,Default,,0,0,0,,Мен де сол самурайлардың мәдениетін көргім келеді деп ойладым.
Dialogue: 0,1:22:04.75,1:22:08.25,Default,,0,0,0,,Яғни, егер Ұстаз Нгуен Гинганумды қолға алса...
Dialogue: 0,1:22:08.38,1:22:09.67,Default,,0,0,0,,...сенің айтып тұрғаның осы емес пе?
Dialogue: 0,1:22:10.13,1:22:10.96,Default,,0,0,0,,Иә?
Dialogue: 0,1:22:11.84,1:22:14.22,Default,,0,0,0,,Мен Амелия мүшесі болғым келді...
Dialogue: 0,1:22:14.42,1:22:15.63,Default,,0,0,0,,Сіз мұны істедіңіз...
Dialogue: 0,1:22:15.76,1:22:16.89,Default,,0,0,0,,Бұл жақсы амбиция емес пе?
Dialogue: 0,1:22:17.01,1:22:17.80,Default,,0,0,0,,Не?
Dialogue: 0,1:22:17.93,1:22:21.06,Default,,0,0,0,,Егер сен сондай болсаң, сен гингем боласың деп үміттенемін.
Dialogue: 0,1:22:21.18,1:22:22.22,Default,,0,0,0,,Иә?
Dialogue: 0,1:22:23.18,1:22:24.77,Default,,0,0,0,,Егер А бұрылысы жаппай өндірілсе...
Dialogue: 0,1:22:24.89,1:22:27.85,Default,,0,0,0,,Сендей жас жігіт қолына алса, солай болады.
Dialogue: 0,1:22:27.98,1:22:28.73,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,1:22:28.86,1:22:30.44,Default,,0,0,0,,Бұл адамның айтқанын тыңдаңыз
Dialogue: 0,1:22:30.94,1:22:32.65,Default,,0,0,0,,Айлы, аузыңды жап!
Dialogue: 0,1:22:33.07,1:22:35.53,Default,,0,0,0,,Мен бақылау оңай деп ойлаған гинхаммен қиындыққа тап болдым.
Dialogue: 0,1:22:35.65,1:22:38.11,Default,,0,0,0,,Сіз мені шақыруды ойлайсыз ба?
Dialogue: 0,1:22:39.32,1:22:40.87,Default,,0,0,0,,Біз жерлік емеспіз бе?
Dialogue: 0,1:22:40.99,1:22:42.04,Default,,0,0,0,,Күйіктің иісі шығады.
Dialogue: 0,1:22:42.16,1:22:43.29,Default,,0,0,0,,Өрт шығып жатыр. Не?
Dialogue: 0,1:22:43.75,1:22:45.29,Default,,0,0,0,,Өртті сөндіру. Дабыл болмайды.
Dialogue: 0,1:22:45.41,1:22:46.04,Default,,0,0,0,,Өртті сөндіру
Dialogue: 0,1:22:46.16,1:22:47.17,Default,,0,0,0,,Бруно мен Якоп ше?
Dialogue: 0,1:22:47.83,1:22:49.42,Default,,0,0,0,,Олар жұмыстан босатылды, солай ма?
Dialogue: 0,1:22:49.54,1:22:51.29,Default,,0,0,0,,Екеуі қашып кетті.
Dialogue: 0,1:22:51.46,1:22:52.80,Default,,0,0,0,,Мен сізбен танысқан сайын...
Dialogue: 0,1:22:52.92,1:22:54.76,Default,,0,0,0,,Мен бұл күлкілі емес екенін білдім.
Dialogue: 0,1:22:55.09,1:22:56.30,Default,,0,0,0,,Не! Противогазды шығарыңыз.
Dialogue: 0,1:22:56.42,1:22:57.72,Default,,0,0,0,,Менің жауабым мынау.
Dialogue: 0,1:23:01.01,1:23:02.06,Default,,0,0,0,,Жарылыс па?
Dialogue: 0,1:23:02.18,1:23:02.89,Default,,0,0,0,,Әдетте мылтық
Dialogue: 0,1:23:03.18,1:23:05.06,Default,,0,0,0,,Біз мүмкіндік жасадық.
Dialogue: 0,1:23:05.31,1:23:07.35,Default,,0,0,0,,Мен олардың өздері қашып кеткендерін қалаймын.
Dialogue: 0,1:23:07.73,1:23:09.35,Default,,0,0,0,,Сіз түтінге оранасыз
Dialogue: 0,1:23:09.98,1:23:12.82,Default,,0,0,0,,Мен күшті мылтық қолданбағаныма ризамын.
Dialogue: 0,1:23:13.15,1:23:15.78,Default,,0,0,0,,Диана-самамен қайтадан қол ұстаса аласыз ба?
Dialogue: 0,1:23:16.15,1:23:18.74,Default,,0,0,0,,Олай жасасаң, Гиганумды өзіңе жау етесің.
Dialogue: 0,1:23:19.36,1:23:21.87,Default,,0,0,0,,Лаура неге менің жанымда болғысы келмейді?
Dialogue: 0,1:23:22.16,1:23:23.28,Default,,0,0,0,,Мен...
Dialogue: 0,1:23:24.95,1:23:25.70,Default,,0,0,0,,Лаура
Dialogue: 0,1:23:26.37,1:23:28.37,Default,,0,0,0,,Жарылыс қай жерде болғанын зерттеңіз.
Dialogue: 0,1:23:28.50,1:23:30.42,Default,,0,0,0,,Жүсіптің пәтеріне берілетін электр қуаты өшірілді.
Dialogue: 0,1:23:30.54,1:23:32.00,Default,,0,0,0,,Ах, Якоп-сан.
Dialogue: 0,1:23:32.13,1:23:33.17,Default,,0,0,0,,Ол бомбаланды ма?
Dialogue: 0,1:23:33.63,1:23:35.21,Default,,0,0,0,,Қозғалтқыш зақымдалды ма?
Dialogue: 0,1:23:35.71,1:23:38.34,Default,,0,0,0,,Мен ондай нәрсе бар-жоғын тексеремін.
Dialogue: 0,1:23:39.63,1:23:41.09,Default,,0,0,0,,Ролан франкін сұраңыз
Dialogue: 0,1:23:41.34,1:23:42.14,Default,,0,0,0,,Жүсіп туралы не деуге болады?
Dialogue: 0,1:23:42.26,1:23:43.97,Default,,0,0,0,,Жақсы, Роландтың соңынан еріңіз.
Dialogue: 0,1:23:44.22,1:23:45.77,Default,,0,0,0,,Жүсіп Ах...
Dialogue: 0,1:23:50.94,1:23:55.98,Default,,0,0,0,,Soleil бағытын 180 градусқа өзгерту Алдыңғы кеменің артына қойыңыз
Dialogue: 0,1:24:10.58,1:24:11.33,Default,,0,0,0,,По
Dialogue: 0,1:24:11.46,1:24:13.59,Default,,0,0,0,,Жылжымалы костюм бөлімшесінің командасы жоспарға сәйкес.
Dialogue: 0,1:24:13.79,1:24:14.50,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:24:14.63,1:24:17.96,Default,,0,0,0,,Мен сізге жауынгерлік тәжірибесі барлардың күшті жақтарын көрсетемін.
Dialogue: 0,1:24:18.13,1:24:20.01,Default,,0,0,0,,Сумо 1 Водом 2 Жауынгерлік командасы
Dialogue: 0,1:24:20.63,1:24:23.05,Default,,0,0,0,,Ал өлімге әкелетін бірінші кеме кесілді
Dialogue: 0,1:24:23.39,1:24:25.51,Default,,0,0,0,,Гиганум сияқты нәрсені бір соққымен өлтіріңіз.
Dialogue: 0,1:24:26.06,1:24:27.77,Default,,0,0,0,,және одан әрі. Радио блокада
Dialogue: 0,1:24:27.97,1:24:29.98,Default,,0,0,0,,Қарсылас Милиша емес.
Dialogue: 0,1:24:30.23,1:24:33.44,Default,,0,0,0,,Әрбір кеменің қозғалысына мұқият назар аударып, икемді түрде күресу.
Dialogue: 0,1:24:33.86,1:24:35.73,Default,,0,0,0,,О, Лоран мырза, Ақ қуыршақ...
Dialogue: 0,1:24:35.86,1:24:37.11,Default,,0,0,0,,Сіз оны жылжытасыз ба?
Dialogue: 0,1:24:37.23,1:24:38.86,Default,,0,0,0,,О, жақсы ма?
Dialogue: 0,1:24:40.20,1:24:41.53,Default,,0,0,0,,Лоран, кеттік.
Dialogue: 0,1:24:41.65,1:24:42.78,Default,,0,0,0,,Джозеф мырза
Dialogue: 0,1:24:42.91,1:24:44.20,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,1:24:44.49,1:24:46.99,Default,,0,0,0,,Ку ох та та а...
Dialogue: 0,1:24:47.41,1:24:48.33,Default,,0,0,0,,Ах...
Dialogue: 0,1:24:48.45,1:24:49.33,Default,,0,0,0,,Джозеф мырза
Dialogue: 0,1:24:49.70,1:24:50.58,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:24:50.83,1:24:52.17,Default,,0,0,0,,Жүсіп, келші?
Dialogue: 0,1:24:52.29,1:24:53.21,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,1:24:54.46,1:24:56.71,Default,,0,0,0,,Болжернон да осында.
Dialogue: 0,1:24:56.84,1:24:57.63,Default,,0,0,0,,Қашу!
Dialogue: 0,1:24:57.84,1:24:58.84,Default,,0,0,0,,Шатаспаңыз
Dialogue: 0,1:24:58.96,1:25:00.51,Default,,0,0,0,,Сіз оң жақтасыз ба?
Dialogue: 0,1:25:03.30,1:25:04.18,Default,,0,0,0,,Атайық!
Dialogue: 0,1:25:05.51,1:25:06.10,Default,,0,0,0,,Хун
Dialogue: 0,1:25:09.81,1:25:11.52,Default,,0,0,0,,Уау... Уау...
Dialogue: 0,1:25:26.87,1:25:30.37,Default,,0,0,0,,Негізгі мылтық көтерілді, содан кейін жағдайға байланысты флот шайқасы
Dialogue: 0,1:25:30.62,1:25:31.33,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,1:25:31.45,1:25:32.87,Default,,0,0,0,,Бұл сізге байланысты
Dialogue: 0,1:25:57.06,1:25:59.19,Default,,0,0,0,,Егер сіз жоғарыдан емес, төменнен шабуыл жасасаңыз ше?
Dialogue: 0,1:25:59.44,1:26:00.19,Default,,0,0,0,,Фил
Dialogue: 0,1:26:00.61,1:26:02.78,Default,,0,0,0,,Биіктікке жету Флотқа қарсы шайқас
Dialogue: 0,1:26:02.90,1:26:04.32,Default,,0,0,0,,Сіз не қарап тұрсыз?
Dialogue: 0,1:26:04.49,1:26:08.16,Default,,0,0,0,,Биіктігіңізді төмендетіңіз. 4-ші кеме, көтерілме.
Dialogue: 0,1:26:08.37,1:26:10.08,Default,,0,0,0,,Gim Bandits-ті шығарамыз ба?
Dialogue: 0,1:26:10.49,1:26:11.54,Default,,0,0,0,,Хмм...
Dialogue: 0,1:26:12.04,1:26:14.54,Default,,0,0,0,,Алғашқы қашықтан басқарылатын кеме келді.
Dialogue: 0,1:26:14.66,1:26:15.83,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,1:26:16.00,1:26:17.75,Default,,0,0,0,,Бұл екі кемені суға батыра ма?
Dialogue: 0,1:26:17.88,1:26:19.13,Default,,0,0,0,,3 кеме болады.
Dialogue: 0,1:26:25.13,1:26:25.88,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:26:30.93,1:26:34.48,Default,,0,0,0,,Корен: Ұялы костюмдер арасындағы шайқас басталғалы тұр, солай ма?
Dialogue: 0,1:26:34.60,1:26:35.31,Default,,0,0,0,,Иә
Dialogue: 0,1:26:35.48,1:26:38.44,Default,,0,0,0,,Осының бәрі арқылы Солейге жете аласыз ба?
Dialogue: 0,1:26:39.69,1:26:41.15,Default,,0,0,0,,Онда жетіңіз
Dialogue: 0,1:26:44.90,1:26:47.24,Default,,0,0,0,,Сумо ұшағы ұшыруға дайын
Dialogue: 0,1:26:47.57,1:26:49.62,Default,,0,0,0,,Қарсылас кемесі оқ атуда
Dialogue: 0,1:26:49.99,1:26:51.03,Default,,0,0,0,,Спорт күні керемет өтті, иә?
Dialogue: 0,1:26:51.53,1:26:52.79,Default,,0,0,0,,Мергендік
Dialogue: 0,1:26:55.91,1:26:57.04,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:26:57.17,1:26:59.46,Default,,0,0,0,,Егер сіз қарақшылар ретінде шықсаңыз, барлығын жеңесіз.
Dialogue: 0,1:26:59.63,1:27:00.75,Default,,0,0,0,,Шегіну
Dialogue: 0,1:27:00.88,1:27:04.42,Default,,0,0,0,,Тосқауыл орнату кезінде Махироның командасына қорғаныс шебін орнатуды тапсырыңыз.
Dialogue: 0,1:27:04.71,1:27:07.01,Default,,0,0,0,,Бір-біріңе тым жақын болмаңдар
Dialogue: 0,1:27:11.26,1:27:12.22,Default,,0,0,0,,Спорт күні керемет өтті, иә?
Dialogue: 0,1:27:14.14,1:27:16.27,Default,,0,0,0,,Махиро Сіз шегініп жатырсыз ба?
Dialogue: 0,1:27:20.27,1:27:21.31,Default,,0,0,0,,Естуімше, ол сенің бала кезден бергі досың.
Dialogue: 0,1:27:44.63,1:27:46.71,Default,,0,0,0,,Осындай жерде маса инелік ұшады ма?
Dialogue: 0,1:27:46.84,1:27:47.67,Default,,0,0,0,,А, бұл...
Dialogue: 0,1:27:50.09,1:27:52.22,Default,,0,0,0,,Сол адам...
Dialogue: 0,1:27:54.47,1:27:56.14,Default,,0,0,0,,Сол адам...
Dialogue: 0,1:27:58.85,1:28:00.44,Default,,0,0,0,,Құрметті Диана
Dialogue: 0,1:28:01.98,1:28:03.56,Default,,0,0,0,,Барлық мүшелерді хабардар етіңіз!
Dialogue: 0,1:28:03.73,1:28:05.78,Default,,0,0,0,,Мм... бұл ұшақ
Dialogue: 0,1:28:08.65,1:28:11.99,Default,,0,0,0,,Барлық мүшелер сапқа тұр! бас киіміңді шеш
Dialogue: 0,1:28:12.16,1:28:17.58,Default,,0,0,0,,(Диана сарбаздарының лебізі)
Dialogue: 0,1:28:22.92,1:28:26.38,Default,,0,0,0,,Сержант Корен, Зеноа корпусына жататын партизан отрядының жетекшісі
Dialogue: 0,1:28:26.75,1:28:29.92,Default,,0,0,0,,Мен Мәртебелі Диана Солерді осында әкелдім.
Dialogue: 0,1:28:30.05,1:28:34.51,Default,,0,0,0,,Майор Фил Гим Гуинганум жерге келді.
Dialogue: 0,1:28:35.93,1:28:39.68,Default,,0,0,0,,Бұл да менің қылмысым.
Dialogue: 0,1:28:40.10,1:28:43.35,Default,,0,0,0,,Оны қуып шығу үшін маған қол ұшын беруіңізді сұраймын.
Dialogue: 0,1:28:43.52,1:28:44.23,Default,,0,0,0,,Милан да
Dialogue: 0,1:28:45.32,1:28:48.69,Default,,0,0,0,,Мәртебелі Диана Солер, өз өмірін қатерге тігіп
Dialogue: 0,1:28:49.07,1:28:51.32,Default,,0,0,0,,Мәртебеліден осындай сөздер...
Dialogue: 0,1:28:51.45,1:28:55.16,Default,,0,0,0,,Мен сіздің тапсырысыңызды алғым келеді, Мәртебелі.
Dialogue: 0,1:28:57.12,1:28:59.29,Default,,0,0,0,,Дайана есептегіш командасы
Dialogue: 0,1:28:59.50,1:29:03.21,Default,,0,0,0,,Тіпті барлық әскерлеріңізбен Гиганум отрядын қуып шығарыңыз.
Dialogue: 0,1:29:03.96,1:29:04.79,Default,,0,0,0,,Хаха
Dialogue: 0,1:29:05.04,1:29:08.46,Default,,0,0,0,,(Диана сарбаздарының қуанышы)
Dialogue: 0,1:29:08.71,1:29:11.30,Default,,0,0,0,,Құрметті Диана, үйге қош келдіңіз.
Dialogue: 0,1:29:11.51,1:29:13.38,Default,,0,0,0,,Мен күттім.
Dialogue: 0,1:29:13.68,1:29:17.10,Default,,0,0,0,,(Диана сарбаздарының қуанышы)
Dialogue: 0,1:29:17.22,1:29:19.22,Default,,0,0,0,,Мен ақымақтарға қызмет еткім келмейді.
Dialogue: 0,1:29:23.73,1:29:27.98,Default,,0,0,0,,Қараңғы тарих болғандықтан, самурайлар үшін де қиындықтар бар.
Dialogue: 0,1:29:32.70,1:29:35.74,Default,,0,0,0,,Оларды ұсақтап тастаңыз, солай ма?
Dialogue: 0,1:29:39.24,1:29:41.00,Default,,0,0,0,,Мен осындамын
Dialogue: 0,1:29:48.13,1:29:49.50,Default,,0,0,0,,Қолдау баяу.
Dialogue: 0,1:29:49.67,1:29:51.96,Default,,0,0,0,,Досыңның өлтірілгенін білесің бе?
Dialogue: 0,1:29:53.34,1:29:56.22,Default,,0,0,0,,Арнайы мобильді костюмдерге арналған жабдықтың болмауы...
Dialogue: 0,1:29:56.34,1:29:57.43,Default,,0,0,0,,Басынан бастап.
Dialogue: 0,1:29:57.60,1:30:00.47,Default,,0,0,0,,Иә, кәсіби әскерлер және біздің азаматтық әскерлер...
Dialogue: 0,1:30:00.60,1:30:02.56,Default,,0,0,0,,Сіз осындай жерде болдыңыз ба?
Dialogue: 0,1:30:02.73,1:30:04.69,Default,,0,0,0,,Бастықпен не істеу керек...
Dialogue: 0,1:30:04.94,1:30:06.90,Default,,0,0,0,,Менің әпкем не дейді?
Dialogue: 0,1:30:07.02,1:30:07.90,Default,,0,0,0,,Корен
Dialogue: 0,1:30:08.02,1:30:09.23,Default,,0,0,0,,Мен оны қарызға аламын.
Dialogue: 0,1:30:09.40,1:30:10.61,Default,,0,0,0,,Жарайды. Ойын басталсын.
Dialogue: 0,1:30:10.78,1:30:11.86,Default,,0,0,0,,Бұл сержант.
Dialogue: 0,1:30:12.65,1:30:14.24,Default,,0,0,0,,Киттер мен Милишаға айт
Dialogue: 0,1:30:14.49,1:30:15.57,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,1:30:15.70,1:30:17.95,Default,,0,0,0,,А бұрылысын тиімдірек жылжытыңыз.
Dialogue: 0,1:30:18.07,1:30:20.03,Default,,0,0,0,,Махироға соққы беріңіз
Dialogue: 0,1:30:20.24,1:30:22.45,Default,,0,0,0,,Милишаның көптеген түрлері бар сияқты.
Dialogue: 0,1:30:22.58,1:30:25.12,Default,,0,0,0,,Себебі Лоран А бұрылысында емес
Dialogue: 0,1:30:25.37,1:30:29.67,Default,,0,0,0,,Балалар, сіз Диана ханымға осындай медиацияны жүргізуге рұқсат бересіз бе?
Dialogue: 0,1:30:29.88,1:30:31.46,Default,,0,0,0,,Мен асығамын.
Dialogue: 0,1:30:31.75,1:30:32.51,Default,,0,0,0,,Тақтаны пайдаланыңыз
Dialogue: 0,1:30:38.47,1:30:39.80,Default,,0,0,0,,Біткен сияқты
Dialogue: 0,1:30:39.93,1:30:40.81,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,1:30:41.26,1:30:42.10,Default,,0,0,0,,Джозеф –
Dialogue: 0,1:30:42.22,1:30:46.06,Default,,0,0,0,,Оның А бұрылысын Роланға қайтаруға ниеті жоқ сияқты.
Dialogue: 0,1:30:46.52,1:30:48.90,Default,,0,0,0,,Мен жердегілердің ниетін түсінемін.
Dialogue: 0,1:30:49.81,1:30:51.82,Default,,0,0,0,,Жүсіп тым қыңыр.
Dialogue: 0,1:30:52.40,1:30:54.99,Default,,0,0,0,,Мен сол кабинаны А бұрылысында пайдалануым керек.
Dialogue: 0,1:30:55.11,1:30:57.61,Default,,0,0,0,,Оның толық мүмкіндігіне жету мүмкін емес пе?
Dialogue: 0,1:30:58.95,1:31:00.07,Default,,0,0,0,,Не болды, мырза Мокки!
Dialogue: 0,1:31:00.20,1:31:01.37,Default,,0,0,0,,Мені түсіріңіз
Dialogue: 0,1:31:02.20,1:31:03.12,Default,,0,0,0,,Жақсы естіледі ме?
Dialogue: 0,1:31:05.00,1:31:07.54,Default,,0,0,0,,Жүсіпке айтайын ба?
Dialogue: 0,1:31:07.71,1:31:08.67,Default,,0,0,0,,Ол мені осы күйімде көрмесін деп, батыл болып көрінуге барынша тырысып жүрмін
Dialogue: 0,1:31:08.92,1:31:11.38,Default,,0,0,0,,Мен Джозеф мырзамен тікелей келіссөз жүргіземін.
Dialogue: 0,1:31:18.59,1:31:20.64,Default,,0,0,0,,А бұрылысын салу үшін
Dialogue: 0,1:31:20.76,1:31:24.31,Default,,0,0,0,,Біз Нокстың солтүстігіндегі өнеркәсіптік ауданды басып алуымыз керек.
Dialogue: 0,1:31:25.31,1:31:26.93,Default,,0,0,0,,Сонымен, біз...
Dialogue: 0,1:31:27.35,1:31:28.14,Default,,0,0,0,,Полковник Майкл
Dialogue: 0,1:31:28.27,1:31:29.23,Default,,0,0,0,,Иә
Dialogue: 0,1:31:29.98,1:31:31.27,Default,,0,0,0,,Жоғары мәртебелі Гингэмге
Dialogue: 0,1:31:31.40,1:31:33.57,Default,,0,0,0,,Нокс Солейді тарту үшін...
Dialogue: 0,1:31:33.69,1:31:36.74,Default,,0,0,0,,Шығыс жағалауға көшіп, сол жерге шабуыл жасағың келе ме?
Dialogue: 0,1:31:37.20,1:31:38.70,Default,,0,0,0,,Иә, иә.
Dialogue: 0,1:31:38.82,1:31:40.20,Default,,0,0,0,,Олай болса, осы жерде...
Dialogue: 0,1:31:40.32,1:31:43.28,Default,,0,0,0,,Бұл жерде Мунврейт алғаш рет қоныстанды.
Dialogue: 0,1:31:44.20,1:31:45.45,Default,,0,0,0,,Сонымен не?
Dialogue: 0,1:31:45.58,1:31:47.87,Default,,0,0,0,,Көтерілісші элементтер қорқынышты.
Dialogue: 0,1:31:48.04,1:31:50.42,Default,,0,0,0,,Полковник, ақымақ ештеңе айтпа.
Dialogue: 0,1:31:50.54,1:31:51.42,Default,,0,0,0,,Ах...
Dialogue: 0,1:31:52.71,1:31:54.25,Default,,0,0,0,,Жер тұрғындары
Dialogue: 0,1:31:55.80,1:31:58.05,Default,,0,0,0,,Жақсы өзгертілген
Dialogue: 0,1:31:58.30,1:32:02.64,Default,,0,0,0,,Осы ұшақтың сәйкестендіру кодын дұрыс енгізгеніңізге көз жеткізіңіз.
Dialogue: 0,1:32:02.93,1:32:04.43,Default,,0,0,0,,Бұл түні бойы болса да
Dialogue: 0,1:32:04.56,1:32:08.06,Default,,0,0,0,,Корен жұп кодын барлық әскерлерге тіркеңіз.
Dialogue: 0,1:32:08.18,1:32:08.89,Default,,0,0,0,,Иә
Dialogue: 0,1:32:09.02,1:32:13.15,Default,,0,0,0,,Керісінше мен жетекшілік етемін, сондықтан шүкіршілік етіңіз.
Dialogue: 0,1:32:13.27,1:32:15.23,Default,,0,0,0,,Мен өте бақыттымын.
Dialogue: 0,1:32:27.41,1:32:29.58,Default,,0,0,0,,Бірінші ұшақ қанаттарын сындырды.
Dialogue: 0,1:32:31.54,1:32:33.79,Default,,0,0,0,,Терезелерге неге перде қоймадың?
Dialogue: 0,1:32:34.25,1:32:36.55,Default,,0,0,0,,Оның ұшуы үшін қолымнан келгеннің бәрі болды.
Dialogue: 0,1:32:36.80,1:32:38.38,Default,,0,0,0,,Қолшатыр болғаны жақсы емес пе?
Dialogue: 0,1:32:39.09,1:32:41.09,Default,,0,0,0,,Өйткені, бұл көліктік ұшақ.
Dialogue: 0,1:32:41.30,1:32:43.89,Default,,0,0,0,,Қанатыңды сындыратындай қонба.
Dialogue: 0,1:32:44.01,1:32:46.10,Default,,0,0,0,,Мен полменде жақсы емеспін.
Dialogue: 0,1:32:55.65,1:32:56.90,Default,,0,0,0,,Уф, мынау!
Dialogue: 0,1:32:57.02,1:32:58.69,Default,,0,0,0,,Бейбақ... Уф
Dialogue: 0,1:32:59.24,1:33:01.74,Default,,0,0,0,,А бұрылысын Роландқа қайтару керек.
Dialogue: 0,1:33:01.99,1:33:02.82,Default,,0,0,0,,Жүсіп
Dialogue: 0,1:33:02.95,1:33:03.78,Default,,0,0,0,,Ақымақ болма.
Dialogue: 0,1:33:04.41,1:33:06.20,Default,,0,0,0,,Бұл ақылсыз, Фрэн...
Dialogue: 0,1:33:06.74,1:33:08.49,Default,,0,0,0,,Фран-санмен бірге шайқас...
Dialogue: 0,1:33:08.91,1:33:09.83,Default,,0,0,0,,Хаа… Хаа…
Dialogue: 0,1:33:10.08,1:33:10.87,Default,,0,0,0,,Ах!
Dialogue: 0,1:33:11.00,1:33:11.87,Default,,0,0,0,,Аха
Dialogue: 0,1:33:12.04,1:33:12.83,Default,,0,0,0,,Мен сіздің нақты денеңізді айтып тұрмын.
Dialogue: 0,1:33:13.00,1:33:14.08,Default,,0,0,0,,Лоран
Dialogue: 0,1:33:14.21,1:33:15.08,Default,,0,0,0,,Уф
Dialogue: 0,1:33:15.71,1:33:16.79,Default,,0,0,0,,Джозеф мырза
Dialogue: 0,1:33:16.92,1:33:19.21,Default,,0,0,0,,X бұрылысы шыққанда теңізге жүгіріңіз.
Dialogue: 0,1:33:19.34,1:33:22.09,Default,,0,0,0,,Джалапи әскерлері қоршау операциясына жетекшілік етеді.
Dialogue: 0,1:33:22.26,1:33:24.68,Default,,0,0,0,,Френді Ролан қорғауы керек.
Dialogue: 0,1:33:25.09,1:33:26.26,Default,,0,0,0,,Жүсіп Ах...
Dialogue: 0,1:33:27.26,1:33:31.98,Default,,0,0,0,,Фрэн менің баламды бағып жатқан сияқты.
Dialogue: 0,1:33:32.35,1:33:33.23,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:33:37.65,1:33:40.19,Default,,0,0,0,,Сен мені сүйіп алсаң жақсы болмай ма?
Dialogue: 0,1:33:41.03,1:33:42.36,Default,,0,0,0,,Ақымақ...
Dialogue: 0,1:33:55.17,1:33:58.38,Default,,0,0,0,,Гинганум флоты шығыс жағалауға тоқтайды.
Dialogue: 0,1:33:58.50,1:34:00.67,Default,,0,0,0,,Берілу белгісі жоқ
Dialogue: 0,1:34:00.84,1:34:01.80,Default,,0,0,0,,Өкінішке орай
Dialogue: 0,1:34:02.30,1:34:05.59,Default,,0,0,0,,Жауап: менің дауысымды естігенде ғана су болады.
Dialogue: 0,1:34:07.30,1:34:10.18,Default,,0,0,0,,Бастапқыда жердегілерге...
Dialogue: 0,1:34:10.31,1:34:12.81,Default,,0,0,0,,Бұл мүлдем байланыссыз болды.
Dialogue: 0,1:34:13.23,1:34:13.98,Default,,0,0,0,,Иә?
Dialogue: 0,1:34:14.14,1:34:15.06,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:34:15.64,1:34:16.56,Default,,0,0,0,,Хмм, ах…
Dialogue: 0,1:34:16.69,1:34:17.69,Default,,0,0,0,,Не?
Dialogue: 0,1:34:17.81,1:34:22.07,Default,,0,0,0,,Жоқ, бұл Арахман тауының оңтүстігіндегі Жоғалған тау.
Dialogue: 0,1:34:22.19,1:34:22.86,Default,,0,0,0,,Ах...
Dialogue: 0,1:34:22.99,1:34:25.24,Default,,0,0,0,,Олар ол жақта ешқандай геологиялық барлау жұмыстарын жүргізген жоқ.
Dialogue: 0,1:34:26.03,1:34:27.82,Default,,0,0,0,,Сол қария
Dialogue: 0,1:34:28.07,1:34:31.74,Default,,0,0,0,,Соғыстан кейінгі ауылшаруашылық саясаты туралы дәл қазір ойлауға да болмайды.
Dialogue: 0,1:34:32.29,1:34:34.16,Default,,0,0,0,,Не керек, Джим Гуинганум...
Dialogue: 0,1:34:34.29,1:34:36.75,Default,,0,0,0,,Менде X бұрылыс бар
Dialogue: 0,1:34:36.87,1:34:37.88,Default,,0,0,0,,Сол себепті
Dialogue: 0,1:34:38.54,1:34:43.59,Default,,0,0,0,,Сид мырза, сіз қазір кемеден түскіңіз келе ме?
Dialogue: 0,1:34:44.17,1:34:47.05,Default,,0,0,0,,Осы шайқас кезінде оны қасыңызда ұстаңыз.
Dialogue: 0,1:34:47.93,1:34:52.10,Default,,0,0,0,,Сенің жүзіңді көрудің өзі мені жасартады.
Dialogue: 0,1:34:52.22,1:34:53.72,Default,,0,0,0,,Айтуға жетпейді
Dialogue: 0,1:34:54.14,1:34:56.52,Default,,0,0,0,,Wodom Squad: Бір ұшақтың санын шешіңіз.
Dialogue: 0,1:35:06.61,1:35:08.99,Default,,0,0,0,,Не? Бұл күміс түрі
Dialogue: 0,1:35:14.29,1:35:15.33,Default,,0,0,0,,Түсіндім
Dialogue: 0,1:35:19.29,1:35:22.75,Default,,0,0,0,,Жерде де сержант Корен дәл осылай шайқаса алады.
Dialogue: 0,1:35:22.92,1:35:25.88,Default,,0,0,0,,Өйткені, ол кісі Қара тарих дәуірінен аман қалған адам.
Dialogue: 0,1:35:26.88,1:35:28.05,Default,,0,0,0,,Вудом!
Dialogue: 0,1:35:34.93,1:35:35.98,Default,,0,0,0,,Оң жақ
Dialogue: 0,1:35:36.27,1:35:38.73,Default,,0,0,0,,Лужана Милиша осылай жасап жатқан жоқ па?
Dialogue: 0,1:35:38.85,1:35:42.23,Default,,0,0,0,,Дұрыс, Гиганумның негізгі күші жақын жерде.
Dialogue: 0,1:35:42.48,1:35:43.86,Default,,0,0,0,,Сол төбеден ары ма?
Dialogue: 0,1:35:43.98,1:35:45.19,Default,,0,0,0,,Ицумида-сан ба?
Dialogue: 0,1:35:45.32,1:35:47.78,Default,,0,0,0,,Бандит Х бұрылысындай қозғалмай ма?
Dialogue: 0,1:35:53.08,1:35:55.24,Default,,0,0,0,,Болжернон алға шыға алмайды.
Dialogue: 0,1:35:55.37,1:35:58.58,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Таудың басынан шабуыл жасасын.
Dialogue: 0,1:36:01.04,1:36:03.67,Default,,0,0,0,,Алға қарай жүріп, жау флотына оқ жаудырамыз!
Dialogue: 0,1:36:03.79,1:36:04.50,Default,,0,0,0,,Уф
Dialogue: 0,1:36:05.13,1:36:06.51,Default,,0,0,0,,Салво от!
Dialogue: 0,1:36:09.59,1:36:12.89,Default,,0,0,0,,Ах... артқа қарай жүгіру
Dialogue: 0,1:36:18.31,1:36:19.48,Default,,0,0,0,,Мүлдем
Dialogue: 0,1:36:19.64,1:36:21.85,Default,,0,0,0,,«Мен нұсқаулықты орындаймын» дегеніміз...
Dialogue: 0,1:36:21.98,1:36:23.23,Default,,0,0,0,,Ақымақ осылай дейді
Dialogue: 0,1:36:24.98,1:36:28.36,Default,,0,0,0,,X бұрылысын іске қосу палубасын растау
Dialogue: 0,1:36:34.95,1:36:38.33,Default,,0,0,0,,Неліктен тұрақты рейстер осындай уақытта ұшады?
Dialogue: 0,1:36:38.45,1:36:40.92,Default,,0,0,0,,Бұл ауа-райына байланысты тұрақты рейс.
Dialogue: 0,1:36:41.92,1:36:43.50,Default,,0,0,0,,Кішкентай балықтар жақсы
Dialogue: 0,1:36:44.59,1:36:46.84,Default,,0,0,0,,Диана Солер есімді кумир...
Dialogue: 0,1:36:46.96,1:36:50.09,Default,,0,0,0,,Басқаша айтқанда, тек бір пұтты өлтіру керек.
Dialogue: 0,1:36:50.38,1:36:52.22,Default,,0,0,0,,Диана, байсалды кумир...
Dialogue: 0,1:36:52.34,1:36:54.14,Default,,0,0,0,,Сөзсіз Солейде
Dialogue: 0,1:36:54.26,1:36:55.80,Default,,0,0,0,,Сондықтан
Dialogue: 0,1:36:55.93,1:36:58.81,Default,,0,0,0,,Тура жүре аламын деп ойламаңыз.
Dialogue: 0,1:37:03.23,1:37:04.27,Default,,0,0,0,,Таааах
Dialogue: 0,1:37:08.86,1:37:10.19,Default,,0,0,0,,Аа, ол қайда?
Dialogue: 0,1:37:13.82,1:37:16.53,Default,,0,0,0,,А бұрылысын әлі де мен ұстадым...
Dialogue: 0,1:37:16.66,1:37:18.08,Default,,0,0,0,,Ол шығып жатыр.
Dialogue: 0,1:37:19.87,1:37:21.12,Default,,0,0,0,,Түсіру
Dialogue: 0,1:37:22.83,1:37:24.58,Default,,0,0,0,,Диана Counter
Dialogue: 0,1:37:27.38,1:37:28.50,Default,,0,0,0,,келді
Dialogue: 0,1:37:29.17,1:37:32.01,Default,,0,0,0,,Қарапайым адамдар тек айда болуы керек.
Dialogue: 0,1:37:32.22,1:37:33.43,Default,,0,0,0,,Диана...
Dialogue: 0,1:37:33.84,1:37:36.18,Default,,0,0,0,,Сізге бұл ұнайды ма?
Dialogue: 0,1:37:40.47,1:37:42.77,Default,,0,0,0,,Биіктігімізді төмендетіп, жылдамдықты арттыруымыз керек.
Dialogue: 0,1:37:42.89,1:37:45.23,Default,,0,0,0,,Водомның сәулесі осында жетуі мүмкін.
Dialogue: 0,1:37:45.85,1:37:49.73,Default,,0,0,0,,Жоқ, мен майданнан кетуге мүлдем қарсы емеспін.
Dialogue: 0,1:37:49.86,1:37:51.57,Default,,0,0,0,,Сәлеметсіз бе...?
Dialogue: 0,1:37:52.11,1:37:54.49,Default,,0,0,0,,Хехе, олай айтпа.
Dialogue: 0,1:37:54.99,1:37:56.70,Default,,0,0,0,,X бұрылысы шықты.
Dialogue: 0,1:37:56.91,1:37:59.58,Default,,0,0,0,,Иә, А бұрылысы байланысқан сияқты...
Dialogue: 0,1:37:59.70,1:38:02.08,Default,,0,0,0,,Негізгі жауынгерлер әлі де жерде жатқан сияқты.
Dialogue: 0,1:38:02.25,1:38:04.33,Default,,0,0,0,,Иә, мен де келемін.
Dialogue: 0,1:38:05.17,1:38:06.17,Default,,0,0,0,,Капитан (Гарри) Иә?
Dialogue: 0,1:38:19.31,1:38:20.10,Default,,0,0,0,,Иә?
Dialogue: 0,1:38:21.81,1:38:26.81,Default,,0,0,0,,Әкем мен шешем есімде ме?
Dialogue: 0,1:38:31.53,1:38:34.49,Default,,0,0,0,,Тағы да осыған ұқсас нәрселер
Dialogue: 0,1:38:34.78,1:38:36.07,Default,,0,0,0,,Не!
Dialogue: 0,1:38:38.99,1:38:42.54,Default,,0,0,0,,Техникалық қызмет көрсетудің арқасында пайдалануды жеңілдеткеніңіз үшін рахмет.
Dialogue: 0,1:38:43.83,1:38:45.75,Default,,0,0,0,,Пайдалануды жеңілдетті ме?
Dialogue: 0,1:38:54.30,1:38:57.55,Default,,0,0,0,,Жарайсың Фрэн хехехе
Dialogue: 0,1:38:57.97,1:39:02.01,Default,,0,0,0,,Аға, дәл қазір оның атын атамадыңыз ба?
Dialogue: 0,1:39:02.26,1:39:04.39,Default,,0,0,0,,X бұрылыстың басшысы?
Dialogue: 0,1:39:06.10,1:39:10.48,Default,,0,0,0,,Ұрыс даласында, Әйелдің атын қашан атайды.
Dialogue: 0,1:39:10.90,1:39:14.07,Default,,0,0,0,,Өлер алдында айтқан жолы.
Dialogue: 0,1:39:14.32,1:39:15.11,Default,,0,0,0,,Гингем!
Dialogue: 0,1:39:16.57,1:39:18.28,Default,,0,0,0,,Сақалды жігітті маған қалдырыңыз.
Dialogue: 0,1:39:18.66,1:39:19.62,Default,,0,0,0,,Ха…
Dialogue: 0,1:39:24.45,1:39:26.87,Default,,0,0,0,,Гингем Бұл менмін, Сьюссон Стеро.
Dialogue: 0,1:39:27.25,1:39:29.71,Default,,0,0,0,,Кім менің ұрысыма кедергі келтірсе, мен кешіремін.
Dialogue: 0,1:39:30.33,1:39:32.46,Default,,0,0,0,,Генерал осылай істей ме?
Dialogue: 0,1:39:36.26,1:39:37.97,Default,,0,0,0,,А бұрылысындағы Жерге бару
Dialogue: 0,1:39:38.51,1:39:41.68,Default,,0,0,0,,Биологиялық реакцияларыңыз туралы мәліметтер жинау кезінде.
Dialogue: 0,1:39:41.85,1:39:44.01,Default,,0,0,0,,Мен сізге нұсқау беремін.
Dialogue: 0,1:39:44.77,1:39:46.56,Default,,0,0,0,,Биологиялық реакция? Уау
Dialogue: 0,1:39:52.73,1:39:57.36,Default,,0,0,0,,Хоу бұрылысы
Dialogue: 0,1:39:57.49,1:39:58.82,Default,,0,0,0,,Бұл күшті емес пе?
Dialogue: 0,1:39:59.11,1:40:02.87,Default,,0,0,0,,Уаааааааааааааааааааааааа! Мен Джозеф Яхтамын!
Dialogue: 0,1:40:03.91,1:40:06.16,Default,,0,0,0,,Бұл А кезегі, солай ма?
Dialogue: 0,1:40:06.29,1:40:07.58,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,1:40:07.79,1:40:11.42,Default,,0,0,0,,X бұрылысы да күшті магнит өрісінің әсерінен қалықтау күйінде?
Dialogue: 0,1:40:11.58,1:40:12.17,Default,,0,0,0,,Ах
Dialogue: 0,1:40:12.29,1:40:12.92,Default,,0,0,0,,Джейкоп мырза
Dialogue: 0,1:40:13.42,1:40:14.63,Default,,0,0,0,,Бруно мырза да сонда ма?
Dialogue: 0,1:40:15.05,1:40:18.51,Default,,0,0,0,,Капитан Гарри де келеді. 1, 2 (Екі), 3 (Үш) үш сатылы шабуыл.
Dialogue: 0,1:40:18.92,1:40:21.80,Default,,0,0,0,,Алдымен біз шығамыз, капитан Гарри, Роланд.
Dialogue: 0,1:40:21.93,1:40:23.55,Default,,0,0,0,,Жарайсың ба? Лоран
Dialogue: 0,1:40:24.22,1:40:26.47,Default,,0,0,0,,Қараңғы тарих шымылдығы жабылды
Dialogue: 0,1:40:28.89,1:40:30.60,Default,,0,0,0,,(Ер адам) Қатты кісі келе жатыр! (Әйел) Көмектесіңіз! Мені өлтірмекші!
Dialogue: 0,1:40:31.48,1:40:36.32,Default,,0,0,0,,А бұрылысы т.б. біздің дәуірімізде қажет емес.
Dialogue: 0,1:40:36.90,1:40:40.32,Default,,0,0,0,,Мен де Нгуеннің баласына мүмкіндік бермеймін.
Dialogue: 0,1:40:41.49,1:40:42.53,Default,,0,0,0,,Ха!
Dialogue: 0,1:40:46.95,1:40:49.37,Default,,0,0,0,,Уау...
Dialogue: 0,1:40:49.87,1:40:50.91,Default,,0,0,0,,Иә?
Dialogue: 0,1:40:51.04,1:40:52.08,Default,,0,0,0,,А бұрылысы
Dialogue: 0,1:40:52.21,1:40:53.54,Default,,0,0,0,,Джозеф Джозеф мырза
Dialogue: 0,1:40:54.25,1:40:55.46,Default,,0,0,0,,Капитан Гарри
Dialogue: 0,1:40:56.30,1:41:01.55,Default,,0,0,0,,Жер тұрғындары А бұрылысын қалпына келтіре алмайды!
Dialogue: 0,1:41:04.18,1:41:05.60,Default,,0,0,0,,Кім (мече) не?
Dialogue: 0,1:41:05.72,1:41:06.89,Default,,0,0,0,,сәуле?
Dialogue: 0,1:41:08.14,1:41:09.60,Default,,0,0,0,,Уа, ау, ау...
Dialogue: 0,1:41:10.31,1:41:11.89,Default,,0,0,0,,Ол жарылып кетпей ме?
Dialogue: 0,1:41:12.02,1:41:13.77,Default,,0,0,0,,Ал... әлі тірі.
Dialogue: 0,1:41:13.90,1:41:15.27,Default,,0,0,0,,Жарайды, солай ма?
Dialogue: 0,1:41:15.40,1:41:16.90,Default,,0,0,0,,Мен прапорщиктің дауысын естимін.
Dialogue: 0,1:41:17.69,1:41:19.44,Default,,0,0,0,,Егер мен осында отырған болсам...
Dialogue: 0,1:41:19.99,1:41:20.69,Default,,0,0,0,,Хмм...
Dialogue: 0,1:41:20.82,1:41:23.20,Default,,0,0,0,,
Dialogue: 0,1:41:25.28,1:41:28.49,Default,,0,0,0,,X бұрылысын бекітіңіз!
Dialogue: 0,1:41:28.62,1:41:29.20,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:41:34.42,1:41:38.00,Default,,0,0,0,,Гим Гинганам Мен бұл өмірді қабылдаймын!
Dialogue: 0,1:41:38.50,1:41:41.59,Default,,0,0,0,,Бұл бұрылыс
Dialogue: 0,1:41:41.72,1:41:43.72,Default,,0,0,0,,Мен тіпті Сумоның энергиясын аламын.
Dialogue: 0,1:41:43.84,1:41:45.76,Default,,0,0,0,,Түсінесің бе, Гарри Орд?
Dialogue: 0,1:41:45.97,1:41:48.10,Default,,0,0,0,,Ғалам!
Dialogue: 0,1:41:50.43,1:41:52.68,Default,,0,0,0,,Бұл ай сәулесіндегі көбелек!
Dialogue: 0,1:41:55.60,1:41:56.77,Default,,0,0,0,,Ах!
Dialogue: 0,1:41:59.32,1:42:00.53,Default,,0,0,0,,Не... не?
Dialogue: 0,1:42:00.65,1:42:01.74,Default,,0,0,0,,Бұл кедергі емес пе?
Dialogue: 0,1:42:02.24,1:42:03.65,Default,,0,0,0,,Лоран Бұл жарық
Dialogue: 0,1:42:03.78,1:42:05.11,Default,,0,0,0,,X бұрылысы
Dialogue: 0,1:42:05.24,1:42:07.62,Default,,0,0,0,,Сіз ұшқыштың негізгі қондырмасын алып тастай алдыңыз ба?
Dialogue: 0,1:42:08.12,1:42:09.95,Default,,0,0,0,,Оны шешуге болады. Өтінемін, түсіріңіз.
Dialogue: 0,1:42:10.58,1:42:11.58,Default,,0,0,0,,Не?
Dialogue: 0,1:42:11.70,1:42:14.92,Default,,0,0,0,,Мен ешкімнің мұндай баннерді пайдаланғаны туралы естіген емеспін.
Dialogue: 0,1:42:18.42,1:42:20.21,Default,,0,0,0,,Бұл гингем.
Dialogue: 0,1:42:20.34,1:42:24.09,Default,,0,0,0,,Ай жұлдыздары аспандағы кез келген нәрсені көрсете алады, солай ма?
Dialogue: 0,1:42:24.22,1:42:26.22,Default,,0,0,0,,Бұл берілудің белгісі емес пе?
Dialogue: 0,1:42:26.34,1:42:28.72,Default,,0,0,0,,Гингемнің соншалықты сүйкімді болуы мүмкін емес.
Dialogue: 0,1:42:31.93,1:42:33.48,Default,,0,0,0,,Бұл ай сәулесіндегі көбелек
Dialogue: 0,1:42:33.60,1:42:35.89,Default,,0,0,0,,Ge... Бұл ай сәулесі көбелек пе?
Dialogue: 0,1:42:36.60,1:42:38.31,Default,,0,0,0,,Мынау... бұл жарық
Dialogue: 0,1:42:38.44,1:42:41.53,Default,,0,0,0,,Бұл жер тарихын қара түске бояған нұр.
Dialogue: 0,1:42:43.57,1:42:45.49,Default,,0,0,0,,Сәлем... жарық, жоғалып кет.
Dialogue: 0,1:42:45.61,1:42:46.82,Default,,0,0,0,,Дереккөзді іздеу
Dialogue: 0,1:42:47.32,1:42:49.37,Default,,0,0,0,,Аврора үшін тым жарқыраған емес пе?
Dialogue: 0,1:42:49.49,1:42:51.54,Default,,0,0,0,,Мұндай полярдың болуы мүмкін емес.
Dialogue: 0,1:42:52.04,1:42:54.33,Default,,0,0,0,,Уф, Гундам!
Dialogue: 0,1:42:55.00,1:42:57.42,Default,,0,0,0,,I капитан Гарри қалғанын сұрадым.
Dialogue: 0,1:42:59.59,1:43:01.80,Default,,0,0,0,,По Асықпа, топпен жұмыс
Dialogue: 0,1:43:04.46,1:43:06.55,Default,,0,0,0,,Құбыжық! (Гарри) Бұл шаршатады.
Dialogue: 0,1:43:06.68,1:43:08.76,Default,,0,0,0,,Онда тіпті X бұрылысы болса да
Dialogue: 0,1:43:09.43,1:43:10.30,Default,,0,0,0,,Орындалды
Dialogue: 0,1:43:10.43,1:43:11.51,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,1:43:11.85,1:43:12.60,Default,,0,0,0,,Иә
Dialogue: 0,1:43:16.23,1:43:17.48,Default,,0,0,0,,Гарри, істе!
Dialogue: 0,1:43:19.35,1:43:21.57,Default,,0,0,0,,Гингем Дайын бол!
Dialogue: 0,1:43:29.62,1:43:30.95,Default,,0,0,0,,Не болды?
Dialogue: 0,1:43:35.41,1:43:39.63,Default,,0,0,0,,Бұрылыс Белсендірілген Фрэн Джозефпен бірге артқа кетеді
Dialogue: 0,1:43:42.46,1:43:43.59,Default,,0,0,0,,Роланд, барасың ба?
Dialogue: 0,1:43:44.13,1:43:46.47,Default,,0,0,0,,Адамдардың тыныш ұйықтауы үшін
Dialogue: 0,1:43:48.30,1:43:49.38,Default,,0,0,0,,А бұрылысы жүреді
Dialogue: 0,1:43:50.01,1:43:51.35,Default,,0,0,0,,Ролан бортта болды ма?
Dialogue: 0,1:43:52.18,1:43:54.68,Default,,0,0,0,,Сен осындасың ба, аға?
Dialogue: 0,1:44:04.07,1:44:05.44,Default,,0,0,0,,Амансың ба? По
Dialogue: 0,1:44:05.69,1:44:08.57,Default,,0,0,0,,Жарайды... Мен әлі қозғала аламын.
Dialogue: 0,1:44:08.70,1:44:10.03,Default,,0,0,0,,Soleil астындағы флот
Dialogue: 0,1:44:10.16,1:44:12.24,Default,,0,0,0,,Гинганам флотын басқарыңыз.
Dialogue: 0,1:44:13.03,1:44:15.79,Default,,0,0,0,,Лоран-кун, Арахман тауындағы X бұрылысы...
Dialogue: 0,1:44:15.91,1:44:17.79,Default,,0,0,0,,Мен сені Жоғалған тауға тартуым керек еді.
Dialogue: 0,1:44:18.16,1:44:21.04,Default,,0,0,0,,Майор Фил Солей Жоғалған тауға барады
Dialogue: 0,1:44:21.17,1:44:23.46,Default,,0,0,0,,Капитан Гарридің пікірін тыңдау керек.
Dialogue: 0,1:44:24.29,1:44:28.17,Default,,0,0,0,,Бұл кезде сізге тек жау флотын басуға шоғырлану қажет.
Dialogue: 0,1:44:28.72,1:44:29.42,Default,,0,0,0,,Хаа…
Dialogue: 0,1:44:29.63,1:44:31.84,Default,,0,0,0,,Мені осы үшін сатқындық жасады деп айыптаса да...
Dialogue: 0,1:44:31.97,1:44:34.97,Default,,0,0,0,,Бұл Мәртебелі Королеваға арналған, сондықтан мен өкінбеймін.
Dialogue: 0,1:44:35.64,1:44:37.89,Default,,0,0,0,,Қыздар, мына жігіт...
Dialogue: 0,1:44:38.02,1:44:41.06,Default,,0,0,0,,Оны алдыңғы саптаманың сол және оң розеткаларына салыңыз.
Dialogue: 0,1:44:41.44,1:44:44.15,Default,,0,0,0,,Алдыңғы саптаманың солға және оңға енгізілуі?
Dialogue: 0,1:44:44.86,1:44:46.73,Default,,0,0,0,,Жақсы, мм...
Dialogue: 0,1:44:46.98,1:44:48.65,Default,,0,0,0,,Иёси
Dialogue: 0,1:44:50.03,1:44:51.70,Default,,0,0,0,,Бар болғаны оны жағу керек.
Dialogue: 0,1:44:51.82,1:44:54.07,Default,,0,0,0,,Иә, міне, Мече келді.
Dialogue: 0,1:44:54.49,1:44:55.28,Default,,0,0,0,,Мен ше?
Dialogue: 0,1:44:55.58,1:44:57.04,Default,,0,0,0,,Жақсы жұмыс
Dialogue: 0,1:44:57.33,1:44:59.33,Default,,0,0,0,,Ал, қыздар, үйге қайтыңдар.
Dialogue: 0,1:44:59.45,1:45:01.00,Default,,0,0,0,,Аздап тамақ дайындаңыз.
Dialogue: 0,1:45:01.54,1:45:03.25,Default,,0,0,0,,Сіз нені айтасыз? Уау
Dialogue: 0,1:45:03.54,1:45:05.50,Default,,0,0,0,,Уау...
Dialogue: 0,1:45:06.00,1:45:06.84,Default,,0,0,0,,Сержант Коллен
Dialogue: 0,1:45:06.96,1:45:08.17,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,1:45:10.30,1:45:13.09,Default,,0,0,0,,Кез келген жағдайда, Корен мырза, сіз жалғыз баруды жоспарлап отырсыз ба?
Dialogue: 0,1:45:13.22,1:45:15.22,Default,,0,0,0,,Мен бұл туралы ойлай алмаймын.
Dialogue: 0,1:45:15.60,1:45:20.73,Default,,0,0,0,,Әйелдер жауынгерлердің өмірін ұрпаққа жеткізуі керек!
Dialogue: 0,1:45:23.56,1:45:25.19,Default,,0,0,0,,(Ер адам) Қатты кісі келе жатыр! (Әйел) Көмектесіңіз! Мені өлтірмекші!
Dialogue: 0,1:45:26.27,1:45:29.74,Default,,0,0,0,,Бруно Якоп, қызды алып, үйге қайт!
Dialogue: 0,1:45:32.03,1:45:33.20,Default,,0,0,0,,Мен орналасқан жерді білемін.
Dialogue: 0,1:45:33.32,1:45:34.36,Default,,0,0,0,,Анықталған
Dialogue: 0,1:45:34.49,1:45:36.20,Default,,0,0,0,,Френ Киттерге баруға болады ма?
Dialogue: 0,1:45:36.45,1:45:37.41,Default,,0,0,0,,Әрине
Dialogue: 0,1:45:37.53,1:45:41.16,Default,,0,0,0,,Мен Жерге түскенде осы пәтерді пайдаландым.
Dialogue: 0,1:45:41.29,1:45:42.37,Default,,0,0,0,,Өтінемін!
Dialogue: 0,1:45:44.12,1:45:47.46,Default,,0,0,0,,Джозеф, сен бәріне үйге бара аласың деп үміттенемін.
Dialogue: 0,1:45:47.59,1:45:49.38,Default,,0,0,0,,Уф, қарғыс атсын...
Dialogue: 0,1:45:49.88,1:45:51.34,Default,,0,0,0,,Мен ес-түссіз жатқан кезде...
Dialogue: 0,1:45:51.47,1:45:53.72,Default,,0,0,0,,Өзіңіздің қызықсыз кемсітушілік сезімін ұмытыңыз.
Dialogue: 0,1:45:55.72,1:45:58.60,Default,,0,0,0,,Джон Махиро сізге жалғыз қоңырау шалады.
Dialogue: 0,1:45:58.72,1:46:01.64,Default,,0,0,0,,Диана санауыштағылар мұны түсінбейді.
Dialogue: 0,1:46:01.98,1:46:02.89,Default,,0,0,0,,Иә?
Dialogue: 0,1:46:03.23,1:46:05.02,Default,,0,0,0,,Киттер шықты ма?
Dialogue: 0,1:46:05.44,1:46:07.40,Default,,0,0,0,,Не, байланысты ма?
Dialogue: 0,1:46:07.52,1:46:09.11,Default,,0,0,0,,Жақын.
Dialogue: 0,1:46:09.23,1:46:13.49,Default,,0,0,0,,Ханшайым, мен киттермен микрофон арқылы қосылдым.
Dialogue: 0,1:46:14.20,1:46:15.45,Default,,0,0,0,,Хмм...
Dialogue: 0,1:46:15.82,1:46:17.57,Default,,0,0,0,,Кжель Хейм, мені естисің бе?
Dialogue: 0,1:46:18.37,1:46:20.87,Default,,0,0,0,,Сіз А бұрылысы мырзаның қайда екенін анықтай алдыңыз ба?
Dialogue: 0,1:46:20.99,1:46:23.58,Default,,0,0,0,,Қандай ақымақ максималды қуатпен таратады?
Dialogue: 0,1:46:23.71,1:46:24.79,Default,,0,0,0,,Сол жерде жүгір
Dialogue: 0,1:46:24.92,1:46:26.88,Default,,0,0,0,,Кім ақымақ? (SS) радиоблокада
Dialogue: 0,1:46:27.04,1:46:28.25,Default,,0,0,0,,Ах...
Dialogue: 0,1:46:28.38,1:46:29.59,Default,,0,0,0,,Жүгіруден тыс
Dialogue: 0,1:46:29.71,1:46:30.38,Default,,0,0,0,,Вилгем?
Dialogue: 0,1:46:33.22,1:46:35.72,Default,,0,0,0,,Прапорщик Ярни, радионы қолданбаңыз.
Dialogue: 0,1:46:35.84,1:46:38.18,Default,,0,0,0,,Көбінесе сіз көпірдегі орындыққа отырмайсыз.
Dialogue: 0,1:46:38.35,1:46:40.76,Default,,0,0,0,,Аа, солай деп үміттенемін, бірақ жұмыс күшінің көмегінсіз.
Dialogue: 0,1:46:40.89,1:46:43.14,Default,,0,0,0,,Не істесең де, зауытқа жет.
Dialogue: 0,1:46:43.27,1:46:45.73,Default,,0,0,0,,Ол жарылмайды, сондықтан тыныш болыңыз.
Dialogue: 0,1:46:45.85,1:46:46.73,Default,,0,0,0,,Кешіріңіз... Кешіріңіз.
Dialogue: 0,1:46:47.15,1:46:49.73,Default,,0,0,0,,Мұрагер Ооо... Кешіріңіз.
Dialogue: 0,1:46:49.86,1:46:50.65,Default,,0,0,0,,Жоқ
Dialogue: 0,1:46:50.77,1:46:53.86,Default,,0,0,0,,Осы күйде механикалық қуыршақ зауытына барсаңыз да...
Dialogue: 0,1:46:54.53,1:46:56.45,Default,,0,0,0,,Судың суығанын күтіңіз
Dialogue: 0,1:46:56.57,1:46:59.07,Default,,0,0,0,,Бірақ бұл гингем әлі күнге дейін ашулана бергенше...
Dialogue: 0,1:46:59.20,1:47:00.83,Default,,0,0,0,,Уа, ау...
Dialogue: 0,1:47:01.99,1:47:05.33,Default,,0,0,0,,Бұл әрдайым бола бермейді, сондықтан дайын болыңыз.
Dialogue: 0,1:47:06.00,1:47:08.42,Default,,0,0,0,,Соғыстан кейін не болатынын ойлайсыз ба?
Dialogue: 0,1:47:08.54,1:47:10.46,Default,,0,0,0,,Саясаткер деген осы.
Dialogue: 0,1:47:10.59,1:47:12.17,Default,,0,0,0,,Енді жоқ, мен құлап жатырмын.
Dialogue: 0,1:47:12.30,1:47:13.34,Default,,0,0,0,,Нуоо
Dialogue: 0,1:47:16.51,1:47:17.88,Default,,0,0,0,,Олар осы жаққа келеді.
Dialogue: 0,1:47:18.01,1:47:19.34,Default,,0,0,0,,Біз соқтығыспаймыз ба?
Dialogue: 0,1:47:19.80,1:47:22.31,Default,,0,0,0,,Ах, уау...
Dialogue: 0,1:47:23.35,1:47:25.35,Default,,0,0,0,,А бұрылысы Ақ қуыршақ деп аталады.
Dialogue: 0,1:47:25.48,1:47:27.77,Default,,0,0,0,,Бұл халық қастерлеген нәрсе.
Dialogue: 0,1:47:27.89,1:47:29.65,Default,,0,0,0,,Дене машина болса -
Dialogue: 0,1:47:29.77,1:47:32.27,Default,,0,0,0,,Оны қалай пайдаланатыныңызға қарай, ол барлығына пайдалы болуы мүмкін.
Dialogue: 0,1:47:32.82,1:47:36.78,Default,,0,0,0,,Тарн А ұйықтап жатқанда жақсы адам болып кетті дейсіз бе?
Dialogue: 0,1:47:37.15,1:47:40.03,Default,,0,0,0,,Қазіргі Жерді жоюдың қажеті жоқ...
Dialogue: 0,1:47:40.32,1:47:44.45,Default,,0,0,0,,Онда неге Диана Жерді қайтару миссиясын бастады?
Dialogue: 0,1:47:44.58,1:47:46.96,Default,,0,0,0,,Жер тұрғындары оны неліктен қабылдамады?
Dialogue: 0,1:47:47.75,1:47:48.33,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,1:47:48.54,1:47:51.25,Default,,0,0,0,,Біздің тарихымыз қате болды.
Dialogue: 0,1:47:51.38,1:47:57.42,Default,,0,0,0,,Адамзат шайқасты ұмыта алмайды, сондықтан мен А бұрылысын ояттым.
Dialogue: 0,1:48:05.02,1:48:07.85,Default,,0,0,0,,Маған кедергі жасама, Мэрибелл!
Dialogue: 0,1:48:08.35,1:48:11.69,Default,,0,0,0,,Мен Гинганамның нашар жекпе-жек шеберлігін көріп, шыдай алмаймын.
Dialogue: 0,1:48:16.11,1:48:16.90,Default,,0,0,0,,Мэрибелл
Dialogue: 0,1:48:19.95,1:48:20.74,Default,,0,0,0,,(Итадори) Ол менің жұдырығымды толық жеделдемей тұрып маңдайына алды!
Dialogue: 0,1:48:22.32,1:48:25.29,Default,,0,0,0,,Мэрибелл, сен Канал адамдарынан төменсің-
Dialogue: 0,1:48:25.41,1:48:29.16,Default,,0,0,0,,Бүгінге дейін өзіңе қамқорлық жасаған жақсылықты ұмыттың ба?
Dialogue: 0,1:48:33.38,1:48:34.34,Default,,0,0,0,,Хаа…
Dialogue: 0,1:48:34.84,1:48:36.09,Default,,0,0,0,,Сәлем Ахахахха
Dialogue: 0,1:48:44.35,1:48:45.51,Default,,0,0,0,,What... what?
Dialogue: 0,1:48:46.01,1:48:46.93,Default,,0,0,0,,Ағайындылар
Dialogue: 0,1:48:47.22,1:48:49.73,Default,,0,0,0,,Ей... Ай сәулесін көбелек деп атама.
Dialogue: 0,1:48:53.02,1:48:55.98,Default,,0,0,0,,Не? Бұл сақалды жігіттің белгісі емес пе?
Dialogue: 0,1:48:56.40,1:48:58.57,Default,,0,0,0,,Гингем мен Роланд кімдер?
Dialogue: 0,1:48:59.03,1:49:03.28,Default,,0,0,0,,Иә, мен тарта алмаймын немесе итермеймін, Мэрибелл, мені қолда.
Dialogue: 0,1:49:03.91,1:49:04.53,Default,,0,0,0,,Ой!
Dialogue: 0,1:49:09.20,1:49:10.66,Default,,0,0,0,,Ол жігіт...
Dialogue: 0,1:49:12.75,1:49:15.13,Default,,0,0,0,,Бұл жылқы шаян
Dialogue: 0,1:49:17.96,1:49:19.59,Default,,0,0,0,,Ааааааааааааааааааааааааааааа
Dialogue: 0,1:49:23.13,1:49:28.06,Default,,0,0,0,,Сол құлдықтан құтылмасақ, қара тарих қайта келеді!
Dialogue: 0,1:49:33.69,1:49:37.94,Default,,0,0,0,,Сандағы зымыран соққысы
Dialogue: 0,1:49:41.78,1:49:45.66,Default,,0,0,0,,А бұрылысы дәуірді ашады!
Dialogue: 0,1:49:48.08,1:49:50.79,Default,,0,0,0,,Коллен сержант Коллен
Dialogue: 0,1:49:52.00,1:49:55.29,Default,,0,0,0,,Ұрыс деген осындай.
Dialogue: 0,1:49:56.13,1:49:57.92,Default,,0,0,0,,Бір нәрсені білетіндей сөйлейді.
Dialogue: 0,1:50:00.84,1:50:04.43,Default,,0,0,0,,Егер біз жауынгерлік инстинктімізге еріп, бар күш-қуатымызды жұмсасақ...
Dialogue: 0,1:50:04.55,1:50:07.64,Default,,0,0,0,,Жер өркениеті жойылмауы мүмкін.
Dialogue: 0,1:50:12.02,1:50:14.69,Default,,0,0,0,,Солей алдыңғы жақта, бұл нені білдіреді?
Dialogue: 0,1:50:14.81,1:50:17.40,Default,,0,0,0,,Сіз X бұрылысынан өткіңіз келеді, солай ма? Диана ханым.
Dialogue: 0,1:50:17.98,1:50:19.15,Default,,0,0,0,,Амансың ба?
Dialogue: 0,1:50:19.27,1:50:20.57,Default,,0,0,0,,Жүсіп күшті.
Dialogue: 0,1:50:20.69,1:50:22.90,Default,,0,0,0,,Сіздің әпкеңіз көпірде жатқан шығар.
Dialogue: 0,1:50:23.82,1:50:26.57,Default,,0,0,0,,Киттер капитан Гарриге және одан төменге қолдау көрсетеді.
Dialogue: 0,1:50:26.70,1:50:28.49,Default,,0,0,0,,Арқаңызды бекітіңіз
Dialogue: 0,1:50:28.62,1:50:32.04,Default,,0,0,0,,Солейл өзінің барлық атыс күшін екі ұшаққа шоғырландырды...
Dialogue: 0,1:50:32.16,1:50:33.83,Default,,0,0,0,,Ай сәулесінің көбелектеріне бөгет қызметін атқарады
Dialogue: 0,1:50:34.54,1:50:36.12,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,1:50:36.25,1:50:38.17,Default,,0,0,0,,Сіздің қолыңыздан келетініне сеніңіз
Dialogue: 0,1:50:38.71,1:50:40.00,Default,,0,0,0,,Сәттілік тілеймін.
Dialogue: 0,1:50:40.55,1:50:42.17,Default,,0,0,0,,Мен үшін дұға ет
Dialogue: 0,1:50:48.76,1:50:51.47,Default,,0,0,0,,Неліктен бір Солей алға шығады?
Dialogue: 0,1:50:51.89,1:50:54.85,Default,,0,0,0,,Диана-саманың ерекше шабуылын ешкім тоқтата алмайды.
Dialogue: 0,1:50:55.39,1:50:58.23,Default,,0,0,0,,Ха... патшайымның өлімі?
Dialogue: 0,1:50:58.36,1:51:01.48,Default,,0,0,0,,Ханшайым дегеніміз не? Ол мұны қалайды ма?
Dialogue: 0,1:51:06.65,1:51:09.12,Default,,0,0,0,,дирижабльге әркім міне алмайды.
Dialogue: 0,1:51:09.24,1:51:12.29,Default,,0,0,0,,Мен оны Лужана Милишада қолданамын, сондықтан оралыңыз.
Dialogue: 0,1:51:12.41,1:51:14.41,Default,,0,0,0,,Ал, олар қандай адамдар?
Dialogue: 0,1:51:14.54,1:51:18.00,Default,,0,0,0,,Ақырында, тіпті полковник Майкл да менен бас тартты.
Dialogue: 0,1:51:18.79,1:51:22.21,Default,,0,0,0,,Лили ханым менің ең төменгі нүктемде болғанда пайда болады.
Dialogue: 0,1:51:22.34,1:51:24.01,Default,,0,0,0,,Күн енді шықпайды.
Dialogue: 0,1:51:25.30,1:51:26.84,Default,,0,0,0,,Мен мұны білмеймін
Dialogue: 0,1:51:26.97,1:51:30.10,Default,,0,0,0,,Өміріңіздің соңында табысқа жету жақсы.
Dialogue: 0,1:51:30.22,1:51:33.14,Default,,0,0,0,,Бұл жетістікке де Амелия себепші болды.
Dialogue: 0,1:51:33.56,1:51:37.35,Default,,0,0,0,,Мен қазір сүйікті Лаураның жеңіске жетуін қалаймын.
Dialogue: 0,1:51:37.77,1:51:39.44,Default,,0,0,0,,Лаура бала
Dialogue: 0,1:51:39.56,1:51:43.23,Default,,0,0,0,,Мені қатты жақсы көрсеңіз, көмектесіңізші...
Dialogue: 0,1:51:43.36,1:51:46.57,Default,,0,0,0,,Өнеркәсіптік революцияны юбка киюден бастау керек
Dialogue: 0,1:51:46.69,1:51:47.86,Default,,0,0,0,,Әлі уақыт бар...
Dialogue: 0,1:51:48.49,1:51:49.49,Default,,0,0,0,,Әй?
Dialogue: 0,1:51:50.24,1:51:51.45,Default,,0,0,0,,Қарақшы
Dialogue: 0,1:51:56.91,1:51:57.71,Default,,0,0,0,,Уф
Dialogue: 0,1:51:58.29,1:51:59.54,Default,,0,0,0,,Маллиган!
Dialogue: 0,1:51:59.87,1:52:00.71,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,1:52:00.83,1:52:01.67,Default,,0,0,0,,Мэрибелл
Dialogue: 0,1:52:01.92,1:52:02.67,Default,,0,0,0,,Полковник
Dialogue: 0,1:52:02.79,1:52:05.00,Default,,0,0,0,,Бізді де алып кетіңізші.
Dialogue: 0,1:52:05.67,1:52:07.05,Default,,0,0,0,,Не болды? Гим ше?
Dialogue: 0,1:52:07.17,1:52:09.09,Default,,0,0,0,,Маған Вилгемнің мега бөлшектерінің зеңбірегін беріңіз.
Dialogue: 0,1:52:09.22,1:52:11.39,Default,,0,0,0,,Жүргізуші кетіп қалды. Бұл мүмкін емес.
Dialogue: 0,1:52:11.89,1:52:12.80,Default,,0,0,0,,А? (Мэрибелл) Бұл не?
Dialogue: 0,1:52:15.27,1:52:16.93,Default,,0,0,0,,Вилгемге келгенде не істеу керек
Dialogue: 0,1:52:17.06,1:52:18.73,Default,,0,0,0,,Желге шағым айтыңыз
Dialogue: 0,1:52:18.85,1:52:20.69,Default,,0,0,0,,Әй... Әй, арқан баспалдағын көтер.
Dialogue: 0,1:52:21.35,1:52:22.36,Default,,0,0,0,,(Стефани) Сол сөзіңді қайтарып ал. (Сора) Ә?
Dialogue: 0,1:52:22.48,1:52:24.23,Default,,0,0,0,,Бұлай болуы мүмкін емес.
Dialogue: 0,1:52:24.36,1:52:26.11,Default,,0,0,0,,Бір-бірлеп көтереміз.
Dialogue: 0,1:52:26.23,1:52:28.03,Default,,0,0,0,,Жоғалған тауға барыңыз
Dialogue: 0,1:52:28.78,1:52:30.07,Default,,0,0,0,,Біз ең әлсіз болғандықтан, сол күшті түсінетіндер бар.
Dialogue: 0,1:52:30.20,1:52:33.49,Default,,0,0,0,,Мен Амелияны оның белдемшесінде басқарамын.
Dialogue: 0,1:52:33.78,1:52:35.03,Default,,0,0,0,,Өлсең де, тірі қалсаң да...
Dialogue: 0,1:52:35.20,1:52:36.41,Default,,0,0,0,,Доуаах
Dialogue: 0,1:52:37.45,1:52:38.83,Default,,0,0,0,,Қараңғы тарих аяқталды
Dialogue: 0,1:52:38.96,1:52:41.21,Default,,0,0,0,,Мен адаммын
Dialogue: 0,1:52:41.33,1:52:42.96,Default,,0,0,0,,Қараңғы тарих мөрленді
Dialogue: 0,1:52:43.33,1:52:46.34,Default,,0,0,0,,Ол жабық күйде қалуы мүмкін емес.
Dialogue: 0,1:52:56.51,1:52:58.06,Default,,0,0,0,,Менің ойымша, сіз қозғалысты анықтай аласыз.
Dialogue: 0,1:52:58.18,1:53:00.31,Default,,0,0,0,,Екі механикалық қуыршақты анықтау мүмкін емес.
Dialogue: 0,1:53:00.44,1:53:01.06,Default,,0,0,0,,Лоран...
Dialogue: 0,1:53:01.19,1:53:02.69,Default,,0,0,0,,Радар пайдасыз, солай емес пе?
Dialogue: 0,1:53:02.81,1:53:04.90,Default,,0,0,0,,Бар болғаны қазіргі әскери кеменің алдына шығу керек.
Dialogue: 0,1:53:10.99,1:53:12.28,Default,,0,0,0,,Капитан Гарри ше?
Dialogue: 0,1:53:12.41,1:53:14.20,Default,,0,0,0,,Бұл жерде де ұшақты анықтау мүмкін емес.
Dialogue: 0,1:53:14.32,1:53:17.66,Default,,0,0,0,,Барлық өлшем бірліктері Ай сәулесі көбелек энергиясы Бұлай емес.
Dialogue: 0,1:53:17.79,1:53:19.79,Default,,0,0,0,,Солейді тікелей ұруға рұқсат бермеймін.
Dialogue: 0,1:53:20.37,1:53:22.75,Default,,0,0,0,,Солей, сонда тоқта!
Dialogue: 0,1:53:24.33,1:53:27.75,Default,,0,0,0,,Soleil құлауы мүмкін Барлық кедергілерді босатыңыз
Dialogue: 0,1:53:27.88,1:53:30.80,Default,,0,0,0,,Ай жарығы көбелектердің таралуын мүмкіндігінше тоқтатайық.
Dialogue: 0,1:53:30.92,1:53:33.38,Default,,0,0,0,,бұл... Иә, мен бастапқыда алмадым.
Dialogue: 0,1:53:43.65,1:53:46.36,Default,,0,0,0,,Сіздің жауынгерлік күшіңізді қорғаған нәрсе...
Dialogue: 0,1:53:46.48,1:53:49.15,Default,,0,0,0,,Диана ханымды қорғағанын мақтан еткендіктен болар.
Dialogue: 0,1:53:49.73,1:53:53.61,Default,,0,0,0,,Сол мақтанышты ұрлаған Диана болды!
Dialogue: 0,1:53:55.20,1:53:58.33,Default,,0,0,0,,Алғыс айтпастан жерге қондым.
Dialogue: 0,1:53:58.79,1:54:00.54,Default,,0,0,0,,Сен адамдарды бұздың!
Dialogue: 0,1:54:02.71,1:54:03.79,Default,,0,0,0,,Уф...
Dialogue: 0,1:54:05.71,1:54:06.58,Default,,0,0,0,,баяу
Dialogue: 0,1:54:08.88,1:54:10.96,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:54:17.51,1:54:20.10,Default,,0,0,0,,Уф хааа ха...
Dialogue: 0,1:54:22.89,1:54:23.98,Default,,0,0,0,,Алдыңғы жағын күшейту
Dialogue: 0,1:54:24.10,1:54:25.14,Default,,0,0,0,,Кондрафт
Dialogue: 0,1:54:25.27,1:54:26.44,Default,,0,0,0,,Soleil апатқа ұшырайды
Dialogue: 0,1:54:26.56,1:54:28.06,Default,,0,0,0,,Ролан, сенің дауысыңды естуге рұқсат ет
Dialogue: 0,1:54:28.69,1:54:30.65,Default,,0,0,0,,Хаа ха...
Dialogue: 0,1:54:30.78,1:54:32.44,Default,,0,0,0,,А... Gim ginganum?
Dialogue: 0,1:54:32.57,1:54:35.11,Default,,0,0,0,,Сіз семсермен соғысып көрдіңіз бе?
Dialogue: 0,1:54:36.16,1:54:36.74,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,1:54:37.20,1:54:39.70,Default,,0,0,0,,Өте жаман.
Dialogue: 0,1:54:40.74,1:54:41.41,Default,,0,0,0,,Шайқас!
Dialogue: 0,1:54:41.74,1:54:42.95,Default,,0,0,0,,Уаааа
Dialogue: 0,1:54:43.08,1:54:44.91,Default,,0,0,0,,Теяаа
Dialogue: 0,1:54:45.04,1:54:46.08,Default,,0,0,0,,Теят
Dialogue: 0,1:54:47.46,1:54:48.88,Default,,0,0,0,,Хмм хаха
Dialogue: 0,1:54:53.76,1:54:54.80,Default,,0,0,0,,Ха…
Dialogue: 0,1:54:56.97,1:54:57.84,Default,,0,0,0,,Уф
Dialogue: 0,1:54:58.64,1:54:59.93,Default,,0,0,0,,Не... у...
Dialogue: 0,1:55:09.19,1:55:11.44,Default,,0,0,0,,(Роландтың ауыр тыныс алуы)
Dialogue: 0,1:55:25.79,1:55:28.21,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:55:28.33,1:55:29.79,Default,,0,0,0,,Уау...
Dialogue: 0,1:55:29.92,1:55:32.55,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:55:38.22,1:55:41.05,Default,,0,0,0,,Сол жерде кокон шары тұрған сияқты.
Dialogue: 0,1:55:57.49,1:56:00.91,Default,,0,0,0,,X бұрылысы және А бұрылысы реакциясы тоқтады
Dialogue: 0,1:56:01.49,1:56:04.54,Default,,0,0,0,,Түсіндім... Роланд ше?
Dialogue: 0,1:56:04.66,1:56:07.00,Default,,0,0,0,,Socie Heim құрамында
Dialogue: 0,1:56:07.12,1:56:08.33,Default,,0,0,0,,О
Dialogue: 0,1:56:13.29,1:56:15.84,Default,,0,0,0,,Сонымен, бұл жолы екеуміз ғана болдық.
Dialogue: 0,1:56:15.96,1:56:18.84,Default,,0,0,0,,Бұл жақсы, хехехе
Dialogue: 0,1:56:18.97,1:56:20.34,Default,,0,0,0,,Барлығына айтпа
Dialogue: 0,1:56:20.59,1:56:26.60,Default,,0,0,0,,♪~ («Ай коконы»)
Dialogue: 0,1:56:29.02,1:56:29.81,Default,,0,0,0,,Лоран
Dialogue: 0,1:56:29.94,1:56:30.77,Default,,0,0,0,,Иә
Dialogue: 0,1:56:35.90,1:56:38.15,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,1:56:39.86,1:56:41.36,Default,,0,0,0,,Жоғарыдағыдай.
Dialogue: 0,1:56:41.49,1:56:42.95,Default,,0,0,0,,Сәлем
Dialogue: 0,1:56:56.21,1:57:02.97,Default,,0,0,0,,(Балалардың толқуы)
Dialogue: 0,1:57:20.65,1:57:23.87,Default,,0,0,0,,(Сошидің жылағаны)
Dialogue: 0,1:57:37.00,1:57:38.80,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:57:47.51,1:57:49.22,Default,,0,0,0,,Жарайды, мен кеттім.
Dialogue: 0,1:57:49.35,1:57:51.81,Default,,0,0,0,,Баршаңызға қайырлы күн
Dialogue: 0,1:57:53.06,1:57:54.69,Default,,0,0,0,,Біз ең әлсіз болғандықтан, сол күшті түсінетіндер бар.
Dialogue: 0,1:57:54.81,1:57:57.48,Default,,0,0,0,,Бейне қоңырау шалыңыз.
Dialogue: 0,1:57:57.61,1:57:59.65,Default,,0,0,0,,Мен тағы барамын.
Dialogue: 0,1:58:07.33,1:58:08.37,Default,,0,0,0,,Ах
Dialogue: 0,1:58:08.49,1:58:10.58,Default,,0,0,0,,Бұл үлкен сан!
Dialogue: 0,1:58:48.37,1:58:49.78,Default,,0,0,0,,Мен кешкі асқа дейін үйде боламын.
Dialogue: 0,1:58:49.91,1:58:51.04,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,1:58:57.13,1:58:58.04,Default,,0,0,0,,Сид қарт
Dialogue: 0,1:58:58.17,1:59:00.38,Default,,0,0,0,,
Dialogue: 0,1:59:01.30,1:59:03.21,Default,,0,0,0,,Мынадай бұрыш болды ма?
Dialogue: 0,1:59:03.34,1:59:04.34,Default,,0,0,0,,Бұл картамен бірдей.
Dialogue: 0,1:59:05.09,1:59:07.34,Default,,0,0,0,,Әже, бұл қауіпті.
Dialogue: 0,1:59:07.47,1:59:09.26,Default,,0,0,0,,Күйеуім, маған жақсы белгі бер.
Dialogue: 0,1:59:17.69,1:59:18.98,Default,,0,0,0,,Диана Солер
Dialogue: 0,1:59:19.11,1:59:23.07,Default,,0,0,0,,Мен оны бәріңізбен бірге осында орналастырғым келеді.
Dialogue: 0,1:59:31.87,1:59:34.00,Default,,0,0,0,,Уау хахаха
Dialogue: 0,1:59:45.51,1:59:49.14,Default,,0,0,0,,Уау...
Dialogue: 0,1:59:57.77,2:00:02.15,Default,,0,0,0,,Уау!
Dialogue: 0,2:00:58.37,2:00:59.71,Default,,0,0,0,,Ақыл-ой сынақтарының атымен—
Dialogue: 0,2:01:24.86,2:01:30.86,Default,,0,0,0,,~♪
Dialogue: 0,2:01:33.11,2:01:35.87,Default,,0,0,0,,О, сен сонда болдың ба?
Dialogue: 0,2:01:35.99,2:01:37.83,Default,,0,0,0,,Бүгінгі кешкі көже дәмді.
Dialogue: 0,2:01:37.95,2:01:39.79,Default,,0,0,0,,Рахмет Роланд
Dialogue: 0,2:01:40.41,2:01:42.50,Default,,0,0,0,,Бұл дәмді болды.
Dialogue: 0,2:01:42.87,2:01:44.67,Default,,0,0,0,,Рахмет
Dialogue: 0,2:01:50.13,2:01:53.26,Default,,0,0,0,,Құрметті Диана, ертең кездескенше.
Dialogue: 0,2:02:10.74,2:02:16.74,Default,,0,0,0,,♪~
Dialogue: 0,2:06:24.99,2:06:31.00,Default,,0,0,0,,~♪
Dialogue: 0,2:06:32.50,2:06:38.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory